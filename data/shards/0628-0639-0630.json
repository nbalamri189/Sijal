{"poems":[[30,"كشفت عن الأبصار كل عشا بها","https://www.aldiwan.net/poem5400.html","الطويل"],[71,"ما يقول المفتون في المفتون","https://www.aldiwan.net/poem28371.html","الخفيف"],[159,"بدر ليل أولا فشمس نهار","https://www.aldiwan.net/poem55704.html","الخفيف"],[199,"شطت بجارتك النوى فتحمل","https://www.aldiwan.net/poem54423.html","الكامل"],[376,"مزيدي أسى ما عندكم أنه يسلي","https://www.aldiwan.net/poem57215.html","الطويل"],[382,"يا إلهي النفوس قد غالهنه","https://www.aldiwan.net/poem59227.html","الخفيف"],[422,"أقول لعبد المحسن اليوم منشدا","https://www.aldiwan.net/poem53986.html","الطويل"],[466,"وزير يفر المحل عن جو أرضه","https://www.aldiwan.net/poem15648.html","الطويل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88603","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38903","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59532","الكامل"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124175","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109415","الرمل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109425","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93927","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58379","الخفيف"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102412","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66558","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77070","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94773","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72468","الخفيف"],[5433,"الطريق المهجور","https://www.poetsgate.com/ViewPoem.aspx?id=36118",""],[5776,"الحكيمُ الرابع","https://www.poetsgate.com/ViewPoem.aspx?id=199327",""],[5783,"إنما \"هند\"إسم كل جميل","https://www.poetsgate.com/ViewPoem.aspx?id=53716",""],[5792,"يحبونه","https://www.poetsgate.com/ViewPoem.aspx?id=180355",""]],"verses":[["بِعَذراءَ لَم تَنكِح حَليلاً وَمَن تَلِج","ذِراعَيهِ تَخذُل ساعِدَيهِ أَنامِلُه",0,"ل",2,0],["بعذارٍ كاللامِ والفمِ كالمي","مِ وتصفيفِ طرّةٍ كالسينِ",1,"ن",1,0],["بِعذارٍ يَقُومُ فيهِ بِعُذري","عندَ مَنْ لامَني بغيرِ اعْتِذارِ",2,"ر",1,0],["بِعُذافِرٍ يُشري الجَديلَ كَأَنَّهُ","عَيرٌ تَصَيَّفَ في نَحائِصِ ذُبَّلِ",3,"ل",1,0],["بعَذلٍ عَصاهُ أو بوَجدٍ أطاعَه","بأيّهما أوجبتَها في الهوى قَتلي",4,"ل",2,0],["بعذابٍ قَبِلتَه بسياطٍ","وهوانٍ أزال إقلالهنه",5,"ن",2,0],["بعذب النَّدى مُرّ العداوة قادر","عَفُوٌّ عن الجاني وإنْ جار واعتدى",6,"د",2,0],["بعذرٍ لبذل الجود والغُرْم ضيِّقٍ","وصدرٍ لغفر الذنب والجرم واسع",7,"ع",1,0],["بعذب اللمى عللت والهاً","درى بلماها شفاء العلل",8,"ل",1,0],["بِعِذارِهِ خدّاهُ لِلحُسنِ أَشبها","مُقَلَ الحَبيبِ وَقَد حَكيْنَ قَواضِبا",9,"ب",2,1],["بعذاره أعذارنا مقبولةٌ","ودلاله يدلى بحسن خطاب",10,"ب",1,0],["بعذيبِ ريقتهِ وبارقِ ثغرهِ","أجدُ الطريقَ إلى المحبّةِ بيننا",11,"ن",2,0],["بعذار قلت في تاريخه","حسنٌ حاز العذار الحسنا",12,"ن",2,0],["بعذاره كملت محاسن ذاته","وتنزهت عن وصمة الخسران",13,"ن",1,0],["بعذاريه والرضا يحيى","فأرى سوسناً وراحاً وروحا",14,"ح",2,0],["بِعذارٍ أقامَ عُذريْ وَمثلي","ليسَ يَلحى عليهِ لو صارَ ألحى",15,"ح",2,0],["بعذاريها أناساً نام حلمهم","عنا وعنك وعنها نومة الفهد",16,"د",1,0],["بِعِذارِكَ الْفَتَّانِ أعذَرْ","يا وَجْنَةَ السَّيْفِ الْمُجَوْهَرْ",17,"ر",1,1],["بِعذب عِلم مِنهُ في الحَياة","قَد حَصَلا مُحمد هبات",18,"ت",1,0],["بعذاره وازداد وجد محبهِ","فالطرس بات وكيدُهُ في نحرهِ",19,"ه",1,0],["بعذار حكته أذ أرَّخوه","هالة أحدقت ببدر سماء",20,"ا",2,0],["بعذر اللي يحبك لو يصير الشاعر المشهور","لأنك تنهمر حلو القصيده في تعابيري",21,"ر",2,0],["بعْ ذراعاً, واستنسخ القلبَ وجهاً","لِمَلاكٍ تجيدُ غَزْلَ التجارهْ",22,"ر",2,0],["بعذاب الحرمان تحلو الليالي","والمحبون دائماً أشقياء!",23,"ا",2,0],["بعذر اللي يحبه يوم حبه","خفيف الدم واحبيب وهادي",24,"د",2,0]]}