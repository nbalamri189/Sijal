{"poems":[[53,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[27,"هاج الشجون برهبى ربع أطلال","https://www.aldiwan.net/poem5956.html","البسيط"],[27,"هل رام أم لم يرم ذو السدر فالثلم","https://www.aldiwan.net/poem5990.html","البسيط"],[95,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[51,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[70,"يا أعز الناس عندي وعلي","https://www.aldiwan.net/poem42387.html","الرمل"],[70,"يا أعز الناس عندي","https://www.aldiwan.net/poem42942.html","مجزوء الرمل"],[43,"واحر قلباه ممن قلبه شبم","https://www.aldiwan.net/poem10521.html","البسيط"],[69,"يا أعدل الناس في القضايا","https://www.aldiwan.net/poem28782.html","مخلع البسيط"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[102,"افدي بروحي غيد اشبيليه","https://www.aldiwan.net/poem33027.html","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54618","المجتث"],[107,"أترى أين حل أم أين أمسى","https://www.aldiwan.net/poem16243.html","الخفيف"],[109,"يا أعرق الناس في نسل اليهود","https://www.aldiwan.net/poem2373.html","البسيط"],[113,"يا رسول الله دارك كرما","https://www.aldiwan.net/poem42174.html","الرمل"],[113,"روحي وأرواح من في الكائنات فدا","https://www.aldiwan.net/poem42177.html","البسيط"],[140,"النجاء النجاء من أرض نجد","https://www.aldiwan.net/poem58420.html","البسيط"],[229,"يا أعظم منيتي وأقصى أملي","https://www.aldiwan.net/poem44547.html","الدوبيت"],[269,"قف بذات السفح من اضم","https://www.aldiwan.net/poem52088.html","المديد"],[362,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[362,"بالكتب طرا كتاب خطه ملك","https://www.aldiwan.net/poem60873.html","البسيط"],[456,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[498,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[513,"يا أعور العين قل لي","https://www.aldiwan.net/poem12298.html","المجتث"],[549,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[551,"واكبدا أحرق الهوى كبدي","https://www.aldiwan.net/poem68369.html","المنسرح"],[560,"لا تبك ميتا ولا تفرح بمولود","https://www.aldiwan.net/poem52979.html","البسيط"]],"verses":[["يا أَعثَرَ اللَهُ أَيدي أَنيُقٍ حَمَلَت","رَحلي إِلى حَيثُ لا ماءٌ وَلا شَجَرُ",0,"ر",1,0],["يا أَعيَنَ الهامِ إِنّي قَد وَسَمتُكُمُ","فَوقَ الأُنوفِ عُلوباً غَيرَ أَغفالِ",1,"ل",1,0],["يا أَعظَمَ الناسِ عِندَ العَفوِ عافِيَةً","وَأَرهَبَ الناسِ صَولاتٍ إِذا اِنتَقَموا",2,"م",3,0],["يا اعتداد الأيتام باليتم كفكف","بعده كل دمعة خرساء",3,"ا",2,0],["يا أعذبَ الماءِ لِمْ أسنتَ على","مَنْ حقُّه أن يُعاذَ من أسنِك",4,"ك",1,0],["يا أَعَزَّ الناسِ عِندي وَعَلَيَّ","وَحَبيباً هُوَ مِنّي وَإِلَيَّ",5,"ي",1,1],["يا أَعَزَّ الناسِ عِندي","كَيفَ خُنتَ اليَومَ عَهدي",6,"د",2,1],["يا أَعدَلَ الناسِ إِلّا في مُعامَلَتي","فيكَ الخِصامُ وَأَنتَ الخَصمُ وَالحَكَمُ",7,"م",1,0],["يا أعدلَ الناسِ في القضايا","وأجودَ الخلقِ في العطايا",8,"ا",3,1],["يا أعدلَ الأقوامِ إن نقضوا الحِبَى","وتدافعوا لخصومةٍ وجدالِ",9,"ل",1,0],["يا أْعصُرَ الأَنْدَلس الخاليات","قد فازَ منْ عاش بتلكِ الربوع",10,"ع",1,0],["يا أعذب الطير موسيقى وأروعَها","من كل رائق أنغام وألحان",11,"ن",1,0],["يَا أَعْدَلَ النَّاسِ هَلاَّ","أَخْبَرْتِنِي مَا ذَنْبِي",12,"ي",1,0],["يا أَعَز الأَنام جاهاً وَأَزكى","في المَعالي فرعاً وَأَكرَم نَفسا",13,"س",2,0],["يا أَعرَق الناس في نَسل اليَهود وَمَن","تَأَبى شَمائِلُهُ التَفصيل للجُمَلِ",14,"ل",1,1],["يا أعز الأنبيا الغراغث","واكشف الكرب الذي قددهما",15,"م",2,0],["يا أعطف الأنبيا قلبا وأكرمهم","كفا لمن جاءه مثلي ومد يدا",16,"د",2,0],["يا أعاديه لو عُدِدتم كيأجو","جَ رماكم من كيدِه خَلفَ سدِّ",17,"د",1,0],["يا أعظم منيتي وأقصى أملي","يا أشهر أدوائي وأخفى عللي",18,"ي",1,1],["يا أَعز الناس مرتبة","عد بفضل الجود وَالكَرَم",19,"م",1,0],["يا أَعدلَ النّاسِ الّذينَ بهمْ","عند الحوادثِ تُكشَفُ الغُمَم",20,"م",1,0],["يا أَعدلَ النّاسِ حَكِّمْ في الورى نظَراً","عَدْلاً وأَحكِمْ بناءً فوقَ آساس",21,"س",1,0],["يا أعيُنَ الناس انظري واعجبي","بذَّ كهولَ المجد هذا الغلامْ",22,"م",1,0],["يا أعزَّ الأنجابِ شرقاً وغرباً","يا أجلَّ الأقطابِ ميتاً وحيّا",23,"ي",2,0],["يا أعور العين قل لي","ويا أشل البنان",24,"ن",1,1],["يا أعزّ الورى نِجاراً وخِيماً","وَمحلّا وجانباً وقبيلا",25,"ل",2,0],["يا أَعدَلَ الناسِ في حُكومَتِها","جُرتِ عَلَينا في الحُبِّ فَاِقتَصِدي",26,"ي",1,0],["يا أعيُنَ الغِيدِ تَسْبينا لواحِظُها","قِفِي انظُري كيفَ تُمسي أعيُنُ الغيِدِ",27,"د",1,0]]}