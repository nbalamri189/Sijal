{"poems":[[55,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[29,"هاج الشجون برهبى ربع أطلال","https://www.aldiwan.net/poem5956.html","البسيط"],[29,"هل رام أم لم يرم ذو السدر فالثلم","https://www.aldiwan.net/poem5990.html","البسيط"],[97,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[53,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[72,"يا أعز الناس عندي وعلي","https://www.aldiwan.net/poem42387.html","الرمل"],[72,"يا أعز الناس عندي","https://www.aldiwan.net/poem42942.html","مجزوء الرمل"],[45,"واحر قلباه ممن قلبه شبم","https://www.aldiwan.net/poem10521.html","البسيط"],[71,"يا أعدل الناس في القضايا","https://www.aldiwan.net/poem28782.html","مخلع البسيط"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[104,"افدي بروحي غيد اشبيليه","https://www.aldiwan.net/poem33027.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54618","المجتث"],[113,"أترى أين حل أم أين أمسى","https://www.aldiwan.net/poem16243.html","الخفيف"],[115,"يا أعرق الناس في نسل اليهود","https://www.aldiwan.net/poem2373.html","البسيط"],[119,"يا رسول الله دارك كرما","https://www.aldiwan.net/poem42174.html","الرمل"],[119,"روحي وأرواح من في الكائنات فدا","https://www.aldiwan.net/poem42177.html","البسيط"],[146,"النجاء النجاء من أرض نجد","https://www.aldiwan.net/poem58420.html","البسيط"],[236,"يا أعظم منيتي وأقصى أملي","https://www.aldiwan.net/poem44547.html","الدوبيت"],[276,"قف بذات السفح من اضم","https://www.aldiwan.net/poem52088.html","المديد"],[369,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[369,"بالكتب طرا كتاب خطه ملك","https://www.aldiwan.net/poem60873.html","البسيط"],[463,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[505,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[520,"يا أعور العين قل لي","https://www.aldiwan.net/poem12298.html","المجتث"],[556,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[558,"واكبدا أحرق الهوى كبدي","https://www.aldiwan.net/poem68369.html","المنسرح"],[567,"لا تبك ميتا ولا تفرح بمولود","https://www.aldiwan.net/poem52979.html","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66839","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120039","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119892","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59418","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96751","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96676","الرمل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61025","البسيط"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115998","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95560","المجتث"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79908","الرجز"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111787","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26425","السريع"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216648",""],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76793","البسيط"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113035","السريع"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123649","الرمل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87789","الكامل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26233","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129851","الخفيف"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128238","البسيط"],[2744,"","https://poetry.dctabudhabi.ae/diwan/poem/130300","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100753","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62919","السريع"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132128","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117990","الرمل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123502","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123486","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83471","المجتث"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33416","البسيط"],[4610,"","https://poetry.dctabudhabi.ae/diwan/poem/199221","الخفيف"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102004","الرمل"],[4717,"أعوج الشوم","https://www.poetsgate.com/ViewPoem.aspx?id=213587",""],[4728,"حضرة الملاح","https://www.poetsgate.com/ViewPoem.aspx?id=176995",""],[4929,"في المولد النبيوي","https://www.poetsgate.com/ViewPoem.aspx?id=199724",""],[4983,"ابحار","https://www.poetsgate.com/ViewPoem.aspx?id=10969",""],[5057,"يا عُمَرُ .","https://www.poetsgate.com/ViewPoem.aspx?id=184030",""],[5064,"قالَتْ: تضوَّعتُ مِنْ نجد","https://www.poetsgate.com/ViewPoem.aspx?id=199137",""],[5183,"طائش المنية","https://www.poetsgate.com/ViewPoem.aspx?id=180259",""],[5358,"فقدان ذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=135",""],[5401,"الشعر والنقد","https://www.poetsgate.com/ViewPoem.aspx?id=85958",""],[5431,"العالم القلق","https://www.poetsgate.com/ViewPoem.aspx?id=182973",""],[5431,"ياطيبَ أفئدةٍ بالحب تغتسلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187259",""],[5470,"معزوفة السرو","https://www.poetsgate.com/ViewPoem.aspx?id=11002",""],[5536,"إلى هوازن من عدنان منتسبي","https://www.poetsgate.com/ViewPoem.aspx?id=37054",""],[5582,"شَرَعَ الحُبُّ لَهُ ما شَرَعا","https://www.poetsgate.com/ViewPoem.aspx?id=63529",""],[5595,"ويبْسُطُ العَدْلَ عُنواناً لدولتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=177507",""],[5685,"في مدح الحبيب المصطفى صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=34734",""],[5690,"بيمن سلطاننا عبد العزيز","https://www.poetsgate.com/ViewPoem.aspx?id=172150",""],[5736,"أرواح","https://www.poetsgate.com/ViewPoem.aspx?id=208398",""],[5848,"طفلة نجديه","https://www.poetsgate.com/ViewPoem.aspx?id=53355",""],[5848,"قطر الندى","https://www.poetsgate.com/ViewPoem.aspx?id=48968",""],[5848,"جتك تكفى","https://www.poetsgate.com/ViewPoem.aspx?id=53101",""],[5848,"عذب السجايا وعوده باول الكنه","https://www.poetsgate.com/ViewPoem.aspx?id=53170",""],[5874,"سَلوَى","https://www.poetsgate.com/ViewPoem.aspx?id=202033",""],[6134,"الغصن مال إلى الثرى واحسرتي","https://www.poetsgate.com/ViewPoem.aspx?id=169582",""]],"verses":[["يا أَعثَرَ اللَهُ أَيدي أَنيُقٍ حَمَلَت","رَحلي إِلى حَيثُ لا ماءٌ وَلا شَجَرُ",0,"ر",1,0],["يا أَعيَنَ الهامِ إِنّي قَد وَسَمتُكُمُ","فَوقَ الأُنوفِ عُلوباً غَيرَ أَغفالِ",1,"ل",1,0],["يا أَعظَمَ الناسِ عِندَ العَفوِ عافِيَةً","وَأَرهَبَ الناسِ صَولاتٍ إِذا اِنتَقَموا",2,"م",3,0],["يا اعتداد الأيتام باليتم كفكف","بعده كل دمعة خرساء",3,"ا",2,0],["يا أعذبَ الماءِ لِمْ أسنتَ على","مَنْ حقُّه أن يُعاذَ من أسنِك",4,"ك",1,0],["يا أَعَزَّ الناسِ عِندي وَعَلَيَّ","وَحَبيباً هُوَ مِنّي وَإِلَيَّ",5,"ي",1,1],["يا أَعَزَّ الناسِ عِندي","كَيفَ خُنتَ اليَومَ عَهدي",6,"د",2,1],["يا أَعدَلَ الناسِ إِلّا في مُعامَلَتي","فيكَ الخِصامُ وَأَنتَ الخَصمُ وَالحَكَمُ",7,"م",1,0],["يا أعدلَ الناسِ في القضايا","وأجودَ الخلقِ في العطايا",8,"ا",3,1],["يا أعدلَ الأقوامِ إن نقضوا الحِبَى","وتدافعوا لخصومةٍ وجدالِ",9,"ل",1,0],["يا أْعصُرَ الأَنْدَلس الخاليات","قد فازَ منْ عاش بتلكِ الربوع",10,"ع",1,0],["يا أعذب الطير موسيقى وأروعَها","من كل رائق أنغام وألحان",11,"ن",1,0],["يَا أَعْدَلَ النَّاسِ هَلاَّ","أَخْبَرْتِنِي مَا ذَنْبِي",12,"ب",2,0],["يا أَعَز الأَنام جاهاً وَأَزكى","في المَعالي فرعاً وَأَكرَم نَفسا",13,"س",2,0],["يا أَعرَق الناس في نَسل اليَهود وَمَن","تَأَبى شَمائِلُهُ التَفصيل للجُمَلِ",14,"ل",1,1],["يا أعز الأنبيا الغراغث","واكشف الكرب الذي قددهما",15,"م",2,0],["يا أعطف الأنبيا قلبا وأكرمهم","كفا لمن جاءه مثلي ومد يدا",16,"د",2,0],["يا أعاديه لو عُدِدتم كيأجو","جَ رماكم من كيدِه خَلفَ سدِّ",17,"د",1,0],["يا أعظم منيتي وأقصى أملي","يا أشهر أدوائي وأخفى عللي",18,"ي",1,1],["يا أَعز الناس مرتبة","عد بفضل الجود وَالكَرَم",19,"م",1,0],["يا أَعدلَ النّاسِ الّذينَ بهمْ","عند الحوادثِ تُكشَفُ الغُمَم",20,"م",1,0],["يا أَعدلَ النّاسِ حَكِّمْ في الورى نظَراً","عَدْلاً وأَحكِمْ بناءً فوقَ آساس",21,"س",1,0],["يا أعيُنَ الناس انظري واعجبي","بذَّ كهولَ المجد هذا الغلامْ",22,"م",1,0],["يا أعزَّ الأنجابِ شرقاً وغرباً","يا أجلَّ الأقطابِ ميتاً وحيّا",23,"ي",2,0],["يا أعور العين قل لي","ويا أشل البنان",24,"ن",1,1],["يا أعزّ الورى نِجاراً وخِيماً","وَمحلّا وجانباً وقبيلا",25,"ل",2,0],["يا أَعدَلَ الناسِ في حُكومَتِها","جُرتِ عَلَينا في الحُبِّ فَاِقتَصِدي",26,"د",2,0],["يا أعيُنَ الغِيدِ تَسْبينا لواحِظُها","قِفِي انظُري كيفَ تُمسي أعيُنُ الغيِدِ",27,"د",1,0],["يا أعظُماً لا زلتِ من","وَطفاءَ ساكبةٍ رويّهْ",28,"ي",2,0],["يا أعف الأنام كم ربع مجد","وعلاء لولا نداك تعفى",29,"ف",2,0],["يا أعف الأنام يا عون دين ال","له يا من غدا ملاذ العافي",30,"ف",2,0],["يا أعدل من حد للغصاة حدودا","يا أفضل من جاد للعفاة بأموال",31,"ل",1,0],["يا أعظم الناس قدراً مشتكي كمد","عدته دونك حاجات مجيحات",32,"ت",1,0],["يا أعظم العظما احسن حال منقلبي","والطف بعبد جنى يا أعظم العظما",33,"م",2,0],["يا أعلم العلما احشرني غدا فرحا","في زمرة العلما يا أعلم العلما",33,"م",2,0],["يا أعزَّ الناسِ نفساً","وأجلّ الناسِ آلا",34,"ل",2,0],["يا أعزَّ الناسِ نفعاً هل ترى","شاعراً غيري إِذا قلت وعا",35,"ع",2,0],["يا أَعظَم الناس قَدراً أَن نهنئه","بِما يَهنأ في حالاته البَشر",36,"ر",1,1],["يا أعادَ اللهُ أياماً مضت","لم تكن إلاَّ خَيالاً أو مناما",37,"م",2,0],["يا أعين الحى سُحِّى","سهًّا وبُزِّي السحابا",38,"ب",2,0],["يا أعينَ الوُفّادِ قُرّي بفتىً","في مطلعِ العلياءِ منه فَرقد",39,"د",1,0],["يا اعين الغادرات اللاَّءِ قد فتكت","في مهجتي هل جراح الحب تندملُ",40,"ل",1,0],["يا أَعظَمَ الناسِ عَلى مُسلِمٍ","حَقّاً وَيا أَشرَفَ مَن يَفخَرُ",41,"ر",1,0],["يَا أعزْ مِنْ فِيْ الأرْض مخْلُوْق","مسْمُوْح لَوْ لِلْقَلْب سراق",42,"ق",1,0],["يا أَعظَمَ الرُّسلِ حاشا أَن أَخيبَ وَإِن","صَغُرتُ قَدراً فَقَد أَمَّلتُ ذا عِظَمَ",43,"م",1,0],["يا أعدل الناس على ظلمه","ويا أحقَّ النَّاس من مُبطلِ",44,"ل",1,0],["يا أعز العرب يا من بابه","قط من سائل رفده ما ارتتج",45,"ج",1,0],["يا أَعظُماً لَم يُبلها","كرُّ العشيّ وَلا اِختِلافه",46,"ف",2,0],["يا أَعدَلَ الناسِ إِسماً كَم تَجورُ عَلى","فُؤادِ مُضناكَ بِالهِجرانِ وَالبَينِ",47,"ن",1,1],["يا أعزّ الأنام نفسا وأعلا","هم محلّا لا زال أمرك راجح",48,"ح",1,0],["يا أعظما وطئت هام السهي شرفاً","سقاك من ديم الوسمي أسماها",49,"ا",3,0],["يا أعظم الناس من حاج ومعتمر","وأكرم الخلق من حاف ومنتعل",50,"ل",1,0],["يا أعف الأنام نفساً وذيلا","وأجل العباد بين العباد",51,"د",1,1],["يا أَعدلَ الامةِ في حكمهِ","ومن نَداهُ شرفُ الطَّالِبِ",52,"ب",1,0],["يا أعذب الناس أخلاقا وكم رجل","فظٍ غليظٍ إذا لامسته قاس",53,"س",1,0],["يا أعز الناس عندي","وسروري والمرام",54,"م",1,0],["يا أعظم العظماء يا من قدره","أعلى وأغلى اذ يعد نفيس",55,"س",1,0],["يا أعظم العظماء يا من خلقه","في الذكر موصوف بخير صفات",56,"ت",1,0],["يا أَعظمَ الناسِ قدراً","وهل لغيرِكَ قدرُ",57,"ر",1,0],["يا أَعظَم الناس فَضلاً","قَولاً وَفِعلاً وَعَقلا",58,"ل",2,0],["يا أعظمَ الناس عندَ القلبِ منزلةً","احفَظ لقلبي وصرفي فيك ما سَلفا",59,"ف",2,0],["يا أعزَّ الملوك جاراً وأندا","هُمْ سماءً لكلّ وَفْدٍ عَرَاهْ",60,"ا",2,1],["يا أعاد الله أياما بها","كنت في أنعم عيش أرغد",61,"د",1,0],["يا أعوج الشومِ والأحداثُ شاهدةٌ","هل تستقيمُ العصا في حُلَّة السيفِ",62,"ف",1,0],["يا اعزّ رعدٍ دوى واعزّ برقٍ لاح","واعزّ صمتٍ على بابه يموت البوح",63,"ح",1,0],["ياأعظمَ الخلقِ أخلاقاً وأكرمَها","وأرفعَ الرسلِ قدراً عند باريها",64,"ي",3,0],["يا أعذب الحبّ كاد الصمت يقتلني","يا أعذب الحبّ قل لي وارفع العتبا",65,"ب",2,0],["يا أعذب الحبّ لن أنساك يا أملي","فهل تضنّ بوصل كان مرتقبا",65,"ب",2,0],["يا أعدلَ الناسِ ضاعَ العدلُ في زمَنٍ .","يقضي بهِ دونَ شرعِ الخالقِ البشرُ .",66,"ر",1,0],["يَا أعذبَ الخلقِ تصويرًا وتهجِئةً","وأطيبَ الوردِ كُلَّ الوَردِ أنفاسَا",67,"س",2,0],["يا أعز الإخوان بالعلم والإيم","ان والحكم لا برحتم أعزا",68,"ز",2,0],["يا أعذبَ الكلماتِ في لغتي","هل تذكرينَ عيونَ شاعرِكِ؟",69,"ك",1,0],["ياأعتذر.ياآخذ اعذار وخطاب","مانيب جاهل يرضع ف بزااازته",70,"ت",2,0],["يا