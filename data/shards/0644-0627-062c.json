367,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[369,"أنى يغير عهدك القدم","https://www.aldiwan.net/poem57113.html","الكامل"],[369,"عجبت من نفسي ومن أنها","https://www.aldiwan.net/poem57168.html","السريع"],[369,"ما يصبح العاذل معذورا","https://www.aldiwan.net/poem57393.html","السريع"],[374,"رأينا من عهودِكم","https://www.aldiwan.net/poem59203.html","مجزوء الوافر"],[399,"سقى العقيق فالديار فاللوى","https://www.aldiwan.net/poem46428.html","الرجز"],[400,"إلام أرى عاذلي في تعب","https://www.aldiwan.net/poem34155.html","المتقارب"],[406,"لا جاد ربعك من ديار أقفرت","https://www.aldiwan.net/poem31688.html","عموديه"],[413,"الله يعلم والأنام شهود","https://www.aldiwan.net/poem53839.html","الكامل"],[413,"طرقت أسماء في جنح الظلام","https://www.aldiwan.net/poem54040.html","الرمل"],[413,"طرف يراعي النجم وهو مؤرق","https://www.aldiwan.net/poem54166.html","الكامل"],[418,"يا قلب زرت وما انطوى ذاك الجوى","https://www.aldiwan.net/poem46393.html","الكامل"],[438,"لا جدد الله فيما بينكم حزنا","https://www.aldiwan.net/poem14483.html","البسيط"],[451,"يا أيها الموتى ويا من خلدوا","https://www.aldiwan.net/poem61635.html","الكامل"],[456,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[456,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[456,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[456,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[459,"نطقت بمدحي ثم أسررت بعده","https://www.aldiwan.net/poem16168.html","الطويل"],[462,"وأمير قوم لا يسر أخاً","https://www.aldiwan.net/poem3146.html","عموديه"],[462,"أضاء ثغر سليمى ليلة العلم","https://www.aldiwan.net/poem3473.html","عموديه"],[462,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[463,"يا صاحب العيدين","https://www.aldiwan.net/poem36542.html","عموديه"],[493,"يا ملك الشرق عمدة الدول","https://www.aldiwan.net/poem10262.html","المنسرح"],[549,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[549,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[549,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[551,"ذهب في ذهب راح","https://www.aldiwan.net/poem68235.html","مجزوء الرمل"],[556,"ربي الذي ليس له ماهيه","https://www.aldiwan.net/poem33561.html","الرجز"],[556,"معرفتي مخلوقة وهي لا","https://www.aldiwan.net/poem34076.html","السريع"],[556,"غير الوجود محال","https://www.aldiwan.net/poem34222.html","المجتث"],[556,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[556,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[556,"يا من غفلتم وجوهكم سود","https://www.aldiwan.net/poem34568.html","المنسرح"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"جلست ببستان الجليس وداره","https://www.aldiwan.net/poem2724.html","الطويل"],[573,"يأيها البستان إن حصلت لي","https://www.aldiwan.net/poem2737.html","الكامل"]],"verses":[["لا جازَ مَغناهُم بِذاتِ النَقا","قَطرُ الغَوادي وَطِلالُ السُمِي",0,"م",2,0],["لا جَعَلتُ الهَوانَ دارَ مُقامٍ","وَعَنِ الضَيمِ مَعدَلٌ وَمَحيصُ",1,"ص",1,0],["لَأَجارَ الزَمانُ مِن كُلِّ بُؤسٍ","ظاهِرَ الجَدِّ طاهِرَ الأَجدادِ",2,"د",1,0],["لا جَزَعي يَنفَعُني عِندَكُم","شَيئاً وَلا أَصبِرُ لِلصَبرِ",3,"ر",1,0],["لا جادَكَ الغيثُ إذا ما سَقى","غيْثُ بِلاد اللهِ يا بُلَّذوذْ",4,"ذ",1,1],["لا جاهَ يَحميني وَلا مَدَدٌ","عَنّي يَرُدُّ الكَيدَ وَالقَذَعا",5,"ع",2,0],["لا جَرى النيلُ في نَواحيكِ يا مِص","رُ وَلا جادَكِ الحَيا حَيثُ جادا",6,"د",2,0],["لاجينَ نَسأَلُ مَيتاً لا حَراكَ بِهِ","مِثلَ النَصارى إِلى الأَصنامِ لاجينا",7,"ن",2,0],["لا جِنْسَ بَلْ لا دِينَ يَفْصِلهَا","وَالخُلْفُ مَمْدُودٌ لَهُ شَطَنُ",8,"ن",1,0],["لأجعلنّ إلى بيروت هُنتَسَبي","لعلّ بيروت بعد اليوم تُؤويني",9,"ي",1,0],["لا جِئتُهُم فَلّاً وَأَترُكَ صُحبَتي","نَهباً وَلَم تَغدُر بِقائِمِهِ يَدي",10,"د",2,0],["لأجعلنَّ لشعرِي عنده ملكاً","على الرواةِ سنيّ الملك والتاج",11,"ج",1,0],["لأجيادنا منه وللطّرس حليةٌ","فأجيادُنا بالجود والطرس بالشّذر",12,"ر",1,0],["لا جور في دهرٍ وفيهِ ممدَّحٌ","وشحت منابته بنبتِ العادل",13,"ل",1,0],["لا جَفَّ واديكَ المُحَلَّلُ إنه","لَمُنَاخُ أطْلاحٍ على أطلاحِ",14,"ح",1,0],["لا جعل الله للزواني","من حِيَلي للزنا مَعاذا",15,"ذ",2,0],["لا جهلَ لي بعده وكيف وقد","كَيَّسني ما وُهبتُ من حذر",16,"ر",1,0],["لا جاهلاً قدْرَ الحياةِ مغمَّراً","بل عارفاً قدْرَ الحياة بسيلا",17,"ل",2,0],["لا جَدوَلٌ لا بُلبُلٌ مُنشِدٌ","بَلى بِها الوَحشَةُ وَالاِكتِئاب",18,"ب",1,0],["لاجَزاكَ اللَهُ خَيراً","وَكَفانا اللَهُ شَرَّك",19,"ك",1,0],["لِأَجلِكِ سَعيِي وَاِجتِهادي وَخِدمَتي","وَيا لَيتَ هَذا كُلُّهُ فيكَ يُثمِرُ",20,"ر",1,1],["لا جدّ إلا الموت والإنسان في","لعب الحياة ولهوها متماد",21,"د",1,0],["لأجلك حين تخرج لحرب","ولا جردت في الهيجا حساما",22,"م",2,0],["لا جَعَلَ اللَهُ لَهُ قَراراً","عاشَ حِماراً وَمَضى حِمارا",23,"ر",2,0],["لِأَجلِكِ سِرتُ في بَرٍّ وَبَحرِ","وَأَنتِ الدَهرَ أَنتِ بِكُلِّ قُطرِ",24,"ر",1,0],["لِأَجلِكِ رُحتُ بِالدُنيا شَقِيّاً","أَصُدُّ الوَجهَ وَالدُنيا أَمامي",25,"م",2,0],["لا جَزَعاً بَل أَنَفاً شابَهُ","أَن يَقدِرَ الدَهرُ عَلى غَصبِهِ",26,"ب",2,0],["لا جَوابُ الكِتابِ بَيَّنَ ما أَن","تَ عَلَيهِ ولا جَوابُ الرَسولِ",27,"ل",1,0],["لاجَديدُ الصِبا وَلا رَيعانُه","راجِعٌ بَعدَ ما تَقَضّى زَمانُه",28,"ن",2,1],["لا جارَ إِلّا اللَهُ مِن أَحَدٍ","أَوفى وَأَبعَدُ مِنكَ مِن غَدرِ",29,"ر",1,0],["لِأَجعَلَ عَبداً باهِلِيّاً لِخِبثَةٍ","إِلى حَسَبي فَوقَ الكَواكِبِ أَو شِعري",30,"ر",2,0],["لا جَعَلَ اللَهُ لي إِلَيكَ وَلا","عِندَكَ ما عِشتُ حاجَةً أَبَدا",31,"د",2,0],["لاجِيَةٌ مِن نَدى يَدَيهِ إِلى","رُكنٍ مَشيدٍ لِعَيَّهِم حَمَلا",32,"ل",2,0],["لِأَجلِ ذا أَنجُمُ العُلى طَلَعَت","بِهِ وَنَجمُ الضَلالِ قَد أَفَلا",32,"ل",2,0],["لا جادَ هَطّالُ السَحائِبِ بُقعَةً","بِالغَورِ أَضحَت وَهيَ شَرُّ بِقاعِهِ",33,"ع",2,1],["لا جَمَدَت أَدمُعي وَلا خَمَدَت","نارُ أَسىً في حَشايَ تَضطَرِمُ",34,"م",1,0],["لَأَجعَلَنَّ مَعقِلي","مُطَهَّماً صُلبَ المَطا",35,"ا",1,0],["لا جورَ في بِلادِهِ وَلا عِداً","إِن عُدَّ في العَدلِ زَبيدٌ وَعَدَن",36,"ن",1,0],["لا جمودُ القَطْرِ في المحل ولا","خُلّبُ البرق بعيْنَيْ مَنْ يَشيم",37,"م",1,0],["لا جارُهُم لِلرَزايا في جِوارِهِم","وَلا عُهودُهُمُ مَذمومَةَ الذِمَمِ",38,"م",1,0],["لا جودَ في الأَقوامِ يُعلَمُ ما خَلا","جوداً حَليفاً في بَني عَتّابِ",39,"ب",1,0],["لا جَاهَ لِي إِلَّا بِطَاعَتِهِ","وَلَنِعْمَ عُقْبَى الطَّاعَةِ الْجَاهُ",40,"ا",2,0],["لَأَجمَعُ بَينَ الماءِ وَالنارِ لَوعَةً","فَمِن مُقلَةٍ رَيّا وَمِن كَبِدٍ هَرّى",41,"ر",2,0],["لا جَفَّ مَثواكَ مِن ناءٍ تحيَّتُه","ما في الفراديسِ مِن وَرْدٍ ومن آسِ",42,"س",1,0],["لأَجلِكَ ما حَيِيتُ أعيش حُرّاً","وفيكَ أموتُ مَوْتَ فتىً نجيبِ",43,"ب",1,0],["لا جرى النّيلُ على الوادي ولا","بُوركَ الشَّعبُ إذا لم يُطلقِ",44,"ق",1,0],["لا جَنبَ مُذ هَلَكَ الرُماةُ لِمُسلِمٍ","إِلّا رَمَتهُ يَدُ العَدُوِّ بِمَصرَعِ",45,"ع",1,0],["لَأَجابَكِ الفاروقُ عَنّا وَاِنبَرى","عَمرٌو يُنَبِّئُكِ اليَقينَ وَيُخبِرُ",46,"ر",1,0],["لأجلك آثروا البُقْيا وقالوا","علينا العهدُ عهدُ الأوفياء",47,"ا",2,0],["لأجفَلَ إجفالاً كنَهورُ مُزْنِهِم","فلم يَبقَ إلاّ زِبْرِجٌ منه أو قِشع",48,"ع",1,0],["لا جادَ غيرَكمُ السحابُ فإنّكُمْ","كنتمْ لذيذَ العيشِ غيرَ مُنغّص",49,"ص",1,0],["لاجفَّ دمعُ الذي بكي على حجَرٍ","ولا شفى قلبَ من يصبو إلى وتَدِ",50,"د",1,0],["لا جارَ إِلّا سُلَيمانٌ وَأُسرَتُهُ","مِنَ العَدُوِّ وَمِن دَهرٍ بِهِ نَكَبُ",51,"ب",1,0],["لأجلكِ يَشقى بلمحِ العيونِ","ويُصرعُ بالنظرةِ العابرهْ",52,"ه",1,0],["لَأَجرهُ لَو صَبَرتُ خَيرٌ","كَم عاضَ بِالصَبرِ كَم أَنالا",53,"ل",2,0],["لَأَجرُكُمُ بِالوَصلِ أَفضَلُ مغنَمٍ","بِعَيشِكُمُ رِفقاً عَلَيهِ قَليلا",54,"ل",2,0],["لا جَلا أَحزاني الجَلدُ","لا خَلا مِن ذِكرِكَ الخَلدُ",55,"د",1,1],["لا جادَهُم غيثٌ، ولا","ساغوا بها العذْبَ المَعين!",56,"ن",1,0],["لأجاده الغيثُ الهتونُ، ولا هفا","ليلاً برقعته النسيمُ عليلا",57,"ل",2,0],["لأجل الحِمَى تُرْخِصُ المُهجاتِ","وتَصْهَرُ في النار أجسادها",58,"د",3,0],["لاجئٌ كان ملجأ. وشريدً","كان يأوي إليه كلُّ شريد",59,"د",1,0],["لا جادك الغيث الهمول إذا سقى","غيث بلاد الله يا بلذوذ",60,"ذ",1,1],["لأَجَابَتْ عَنْ ولادتِها","فمتى أنزلْ بها أقمِ",61,"م",1,0],["لاجيادي تَجول فيها وَلا تَضرب","يَوماً لِلظاعِنين قِبابي",62,"ي",1,0],["لا جحد يلمس ذيل شامخ مجده","فالكون ناطقة لاحمد تشهد",63,"د",1,0],["لاجل عينيك بحر عيني","طغى وفي مهجته لهيب",64,"ب",1,0],["لاجل خديك قد","يعشق ورد الربى",65,"ب",2,0],["لا جارُهُ يُلْقَى المهانةَ دهرَه","أَكْرم بمن في عزّةٍ جيرانُه",66,"ن",2,0],["لا جاره معه يضامُ ولا يرَى","يوماً بذى كمدٍ ولا أحْزانِ",67,"ن",1,0],["لأجلها الأزمان أوقاتُها","مؤرخاتٌ من لياليها",68,"ي",3,0],["لا جميلٌ بمثله يحسُن الذك","رُ ولا عامرٌ خرابُ الكيِس",69,"س",1,0],["لِأَجلِهِم خَلَقَ الدُنيا وَأَسكَنَها","وَذَنبُ آدَمَ لَولاهُم لَما غُفِرا",70,"ر",2,0],["لأَجلِكَ هذا القَلبُ يهفُو مَحَبَّةً","وإن كَنتَ لَم تمطرهُ طَلاًّ ولا وَبلا",71,"ل",2,0],["لأجلِ حقيقةٍ تجلو ضبابي","بحثتُ عن الجوابِ بعينِ \"سيني\"",72,"ن",2,0],["لا جدَّ إلّا وهوَ فرد زمانهِ","متميّزٌ فضلاً على أقرانهِ",73,"ه",1,0],["لا جرحَ يلحقُ مَخلوقاً يعدّله","وَما لِمجروحهِ في الخلق تعديلُ",74,"ل",1,0],["لا جِهاتٌ تَحوي الإله تعالى","ليسَ شَخصاً لذاته أنحاءُ",75,"ا",2,0],["لأجلِكُم قد جُدْتُ بالروحِ للقَنَا","ولو بانَ لي مِنْكُم بِوَصْلِكُم بُخْلُ",76,"ل",1,0],["لاِجلك هجرني منامي","وفيك جفيت كل صاحب",77,"ب",1,0],["لَأَجتَنِبَها أَو لَيَبتَدِرُنَّني","بِبَيضٍ عَلَيها الأَثرُ فُقمٌ كِلامُها",78,"م",3,0],["لا جارُهُم يَرهَبُ الأَحداثَ وَسطَهُمُ","وَلا طَريدُهُمُ ناجٍ إِذا طَرَدوا",79,"د",3,0],["لا جحدت النعمى لأكفر إحسا","نك عندي يا دائم الإحسان",80,"ن",1,0],["لأجلكِ شاقني القرآنُ يُتلى","وتأذينُ الصبائحِ والعشيِّ",81,"ي",1,0],["لأجلِكِ أرعى النَّجمَ ليتَكِ نجمةٌ","من القبَّةِ الزرقاءِ تَطلَعُ لي وحدي",82,"د",2,0],["لأجلِ الغرامِ أحبُّوا الهلاكَ","فهل ينفعُ العاشقينَ الحذر",83,"ر",1,0],["لأجلِهما أهوى بلادي وأُمتي","ولو قابَلت صفحي بشرِّ ذنوب",84,"ب",1,0],["لأجلكِ أهواها وأهوى لأجلها","مُحيَّاكِ إنَّ الحبَّ بَينَهُما انشَطر",85,"ر",1,0],["لأجلِ الهُدى خاض الحروبَ فأصبَحت","مَغارِمُهُ في الناسِ وهي المكارِم",86,"م",1,0],["لأجلِها أهرقوا أزكى دمٍ فلهم","تبقى على رغمِ طمّاعٍ وأفّاك",87,"ك",1,0],["لا جاه للعبد كالخمولِ","فاضرع إلى اللّه في القبول",88,"ل",1,1],["لأجلِها طاشَ هَذا مُزبِدا قَلِقاً","وقَرّ ذاك طويلَ الفِكْرِ مُكْتَئِبا",89,"ب",2,0],["لأَجفانُكَ المَرضى الصِحاحُ القَواتِلُ","فَواتِكُ فينا وَهيَ لِلسِّحرِ بابِلُ",90,"ل",1,1],["لا جادَ عَلَيها مِنَ السَماءِ مُلِثٌّ","يَنهَلُّ بِمُثعَنجِرِ الوَديقَةِ نَقّاع",91,"ع",1,0],["لِأَجلِ ذَلِكَ يَنهى النَفسَ عَنهُ ضِيا","ءُ الدينِ إِنَّ هَوى أَهلِ النُهى عارُ",92,"ر",1,0],["لا جاوزت سوحَك العلياءُ قطُّ ولا","عدت نواحيكَ الأَفراحُ والنِعمُ",93,"م",1,0],["لأَجل صون الحسن كانَت لَهُ","كَالحرز مِن أَعيُنِنا الخادِعَه",94,"ع",2,0],["لاجل ذا طال منا النوح وَانَحدَرَت","منا الدُموع كَسَيل وابل هطل",95,"ل",1,0],["لَأَجلُوَنَّ عَلَيكَ الحُسنَ مِن قَمَري","حَتّى يَتمَّ لِحِبّي أَنَّهُ اِبنُ جَلا",96,"ل",2,0],["لا جَرَمَ أَنّي دافَعتُ بِهِ الغَرام","كَما دافَعَ الدينَ الغَريمُ المُماطِلُ",97,"ل",1,0],["لأجردن من اصطباري عزمةً","ما ربُّها في محفِل بمسفَّه",98,"ه",1,0],["لأُجاذِبَنَّكَ حبلَ ودِّكَ أو","يُوهَى بقُوَّتِهِ فينصَرِمُ",99,"م",1,0],["لأجلِ ذاكَ انتَقضَ الشَّرطُ بي","عَن مَذهَبي واعتَلَّتِ العِلَّه",100,"ل",2,0],["لأَجلدنَّ العَينَ حدّاً عَلى","ما صَنعَت والعين تَعزيزا",101,"ز",2,0],["لأجل محبةٍ ثُلِمت","لنحفظها ونرعاها",102,"ا",3,0],["لأَجْعَلَنّ الصبر لي خُلْقاً ومَنْ","يَصبرْ ينَلْ بصبرهِ أقصى المنَى",103,"ا",1,0],["لأجرى الدموع لها رقة","وكان إلى الوصل أقوى سبب",104,"ب",1,0],["لا جاد ربعك من ديار أقفرت","من أهلها صوب الغمام الماطر",105,"ر",1,1],["لا جاز قَبرَك صَوبُ غادته الحيا","تسقي ثراك بصوبها وتزيد",106,"د",1,0],["لا جزى الله بخيرٍ أينقاً","قَذَفَتْها بالنَّوى أيدي المرامي",107,"م",2,0],["لا جاز أرضك يا منازل مرعد","من عارضٍ يسقي ثراك ومبرق",108,"ق",1,0],["لأجددنَّ نياحتي بياحتي","أسفا على ذاك المقامِ وما حوى",109,"و",2,0],["لا جدد اللَه فيما بينكم حُزناً","من بعد ما الصبر في مجرى الإسار دنا",110,"ن",2,1],["لأجل من معنىً نُمجِّدُ يومَه","وأَعُّز من حُبٍّ لدى أحبابِه",111,"ب",2,0],["لأجيادها من حَلْيها ما تعلَّقتْ","به حلقاً أطواقُها من حمَامِها",112,"م",3,0],["لا جَرَماً وإن ذوَتْ دولتُكم","لترجِعَنَّ غَضَّةً لا جَرَما",113,"م",2,0],["لاجَرَّ بالأنعمَيْن يومٌ","ذيلَ جَنوبٍ ولا شَمالِ",114,"ل",1,0],["لا جار إلا أن تكون ظبيةٌ","ولا ديارَ أو تكون الأبرقا",115,"ق",2,0],["لأجْمَعَ بين الواجبينِ لِماجِدٍ","مَدائحُهُ جَهْرٌ ومعروفُه سِرُّ",116,"ر",1,0],["لا جادَ منزلهُ الغمامُ ولا","جمعَ الإله بشملهِ شملي",117,"ل",2,0],["لا جاهليةَ في الإسلام نعرفها","والعينُ عاكفةٌ منهُ على صنمِ",118,"م",1,0],["لا جرَّ حين خلتْ ملاعبها","ذيلُ النسيم عليها وهون مبلول",119,"ل",1,0],["لأجَبتَهُ بِدَم ِالعراق ِ جَميعِهِ","أنَّ الطَّريقَ إلى الكَرامَة ِأوسَعُ!",120,"ع",1,0],["لأ ُجِلُّ ذِكرَكَ يا عَزيزُ مُروءَ ة ً","عَن أيِّ مُوحِشَة ٍبِها أتَذ َرَّعُ",120,"ع",1,0],["لا جرم اجتبت كل مخترق","فيه وادّخلت كل مدّخَل",121,"ل",1,0],["لا جارُهم يخشى البياتَ ولا","مَن عاقدوه يخاف من هضمِ",122,"م",1,0],["لا جفاك السّعودُ من كلّ يومٍ","وتلقّاك بكرةً وأصيلا",123,"ل",2,0],["لا جِرْسَ فيه غير أنْ صَدَحَتْ","قُمْرِيّةٌ أو قَعْقَعَ الرَّعْدُ",124,"د",1,0],["لا جَرى بَيني وَلا بَي","نَهُما طائِرُ بَينِ",125,"ن",1,0],["لأجل هذا لا مكان لا ولا","زمان يحويه ولا أينيه",126,"ي",2,0],["لأجل ذا في كل وقت بدت","في صورة يطرب منها النديمْ",127,"م",1,0],["لأجل تقريب قوم","في العقل منه خبال",128,"ل",1,0],["لأجل الأنام قد صرت سبطا","وأنا العبد للغني بقربي",129,"ي",1,0],["لأجل عوام الناس حيث تقاصرت","بصائرهم عن علم صاحبة القصر",130,"ر",1,0],["لأجل هذا لنا الوجوه غداً","بيض وأنتم وجوهكم سود",131,"د",1,0],["لأجعل الكتاب في التسهيل","غير مملّ قاريا للطول",132,"ل",1,0],["لأَجلِكَ يا من أَوْحشَ العينَ شَخْصُه","أَنِسْتُ بدمعٍ يَمْنَعُ العينَ أَن تَكْرَى",133,"ر",2,0],["لأُجَلِّينَّك من بَهاءِ جَبينه","ولأَخْلُفَنَّ عَلَيْك مِنْ أَنْفاسِه",134,"ه",1,0]]}