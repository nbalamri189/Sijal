{"poems":[[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[53,"رب مستغمز إبائي وفي الناس","https://www.aldiwan.net/poem30176.html","الخفيف"],[53,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[55,"يا من تمادى قلبه في الهوى","https://www.aldiwan.net/poem26347.html","السريع"],[77,"لا جادك الغيث إذا ما سقى","https://www.aldiwan.net/poem36519.html","السريع"],[86,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[86,"أيها القائمون بالأمر فينا","https://www.aldiwan.net/poem10694.html","الخفيف"],[71,"وراحل سرت في صحب أؤمله","https://www.aldiwan.net/poem3771.html","البسيط"],[93,"يا مصر أنت الأهل والسكن","https://www.aldiwan.net/poem11174.html","أحذ الكامل"],[88,"هي المواطن أدنيها وتقصيني","https://www.aldiwan.net/poem44815.html","البسيط"],[11,"أبلغ بني لأم بأن خيولهم","https://www.aldiwan.net/poem239.html",""],[72,"أقسمت من فرعها المسبول بالداجي","https://www.aldiwan.net/poem18455.html","البسيط"],[72,"وقائع حب حار في كرها فكري","https://www.aldiwan.net/poem18705.html","الطويل"],[72,"قسما بغصن قوامه المتمايل","https://www.aldiwan.net/poem19481.html","الكامل"],[51,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[51,"اطعن بحد القمد قدما","https://www.aldiwan.net/poem61987.html","مخلع البسيط"],[51,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[70,"أيها الجاهل قل لي","https://www.aldiwan.net/poem42873.html","مجزوء الرمل"],[70,"لأجلك سعيي واجتهادي وخدمتي","https://www.aldiwan.net/poem42897.html","الطويل"],[85,"أكذا تقر البيض في الأغماد","https://www.aldiwan.net/poem7131.html","الكامل"],[85,"عرابي كيف أوفيك الملاما","https://www.aldiwan.net/poem7581.html","الوافر"],[85,"لما دعا داعي أبي الأشبال","https://www.aldiwan.net/poem8042.html","الرجز"],[85,"على أي الجنان بنا تمر","https://www.aldiwan.net/poem63714.html","الوافر"],[85,"كبير السابقين من الكرام","https://www.aldiwan.net/poem63748.html","الوافر"],[43,"آخر ما الملك معزى به","https://www.aldiwan.net/poem9512.html","السريع"],[45,"يا خليلي بل لست لي بخليل","https://www.aldiwan.net/poem65615.html","الخفيف"],[45,"لاجديد الصبا ولا ريعانه","https://www.aldiwan.net/poem66799.html","البسيط"],[28,"تبعوا رسولهم بسنته","https://www.aldiwan.net/poem5130.html","الكامل"],[28,"إذا خندف بالليل أسدف سجرها","https://www.aldiwan.net/poem5206.html","الطويل"],[49,"أكل طول الزمان أنت إذا","https://www.aldiwan.net/poem64152.html","المنسرح"],[66,"لا نلت من طيب وصلكم أملا","https://www.aldiwan.net/poem38474.html","المنسرح"],[66,"لا جاد هطال السحائب بقعة","https://www.aldiwan.net/poem38620.html","الكامل"],[66,"أنظر إلى المجد كيف ينهدم","https://www.aldiwan.net/poem40298.html","المنسرح"],[66,"برق المشيب قد أضا","https://www.aldiwan.net/poem40981.html","مجزوء الرجز"],[66,"كم قد أفضنا من دموع ودما","https://www.aldiwan.net/poem41378.html","الرجز"],[80,"أوميض البرق في الليل البهيم","https://www.aldiwan.net/poem31292.html","الرمل"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[44,"لو أن دهرا رد رجع جواب","https://www.aldiwan.net/poem30590.html","الكامل"],[87,"ديني الحنيف وربي الله","https://www.aldiwan.net/poem8200.html","أحذ الكامل"],[74,"أما وشباب قد ترامت به النوى","https://www.aldiwan.net/poem12950.html","الطويل"],[105,"ممالك الشرق ما في الحق من باس","https://www.aldiwan.net/poem42109.html","البسيط"],[105,"أمنك الذكر يعصف بالقلوب","https://www.aldiwan.net/poem42121.html","الوافر"],[105,"جددوا الذكرى لأهل المشرق","https://www.aldiwan.net/poem42122.html","الرمل"],[105,"هو مهرجان الله فانظر واخشع","https://www.aldiwan.net/poem43061.html","الكامل"],[105,"ننسى ويعطفنا الإخاء فنذكر","https://www.aldiwan.net/poem43089.html","الكامل"],[105,"جويرية احمدي عقبى البناء","https://www.aldiwan.net/poem44199.html","الكامل"],[75,"أرقت لبرق يستطير له لمع","https://www.aldiwan.net/poem69066.html","الطويل"],[75,"أحبب به قنصا إلى متقنص","https://www.aldiwan.net/poem69068.html","الكامل"],[48,"راح الشقي على دار يسائلها","https://www.aldiwan.net/poem66592.html","البسيط"],[50,"تأبدت برقة الروحاء فاللبب","https://www.aldiwan.net/poem64839.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43859","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43657","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[106,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[77,"لا جادك الغيث الهمول إذا سقى","https://www.poetsgate.com/ViewPoem.aspx?id=34081",""],[54,"عاذِلي ! لو شئتَ لمْ تلمِ","https://www.poetsgate.com/ViewPoem.aspx?id=14488",""]],"verses":[["لا جازَ مَغناهُم بِذاتِ النَقا","قَطرُ الغَوادي وَطِلالُ السُمِي",0,"م",2,0],["لا جَعَلتُ الهَوانَ دارَ مُقامٍ","وَعَنِ الضَيمِ مَعدَلٌ وَمَحيصُ",1,"ص",1,0],["لَأَجارَ الزَمانُ مِن كُلِّ بُؤسٍ","ظاهِرَ الجَدِّ طاهِرَ الأَجدادِ",2,"د",1,0],["لا جَزَعي يَنفَعُني عِندَكُم","شَيئاً وَلا أَصبِرُ لِلصَبرِ",3,"ر",1,0],["لا جادَكَ الغيثُ إذا ما سَقى","غيْثُ بِلاد اللهِ يا بُلَّذوذْ",4,"ذ",1,1],["لا جاهَ يَحميني وَلا مَدَدٌ","عَنّي يَرُدُّ الكَيدَ وَالقَذَعا",5,"ع",2,0],["لا جَرى النيلُ في نَواحيكِ يا مِص","رُ وَلا جادَكِ الحَيا حَيثُ جادا",6,"د",2,0],["لاجينَ نَسأَلُ مَيتاً لا حَراكَ بِهِ","مِثلَ النَصارى إِلى الأَصنامِ لاجينا",7,"ن",2,0],["لا جِنْسَ بَلْ لا دِينَ يَفْصِلهَا","وَالخُلْفُ مَمْدُودٌ لَهُ شَطَنُ",8,"ن",1,0],["لأجعلنّ إلى بيروت هُنتَسَبي","لعلّ بيروت بعد اليوم تُؤويني",9,"ي",1,0],["لا جِئتُهُم فَلّاً وَأَترُكَ صُحبَتي","نَهباً وَلَم تَغدُر بِقائِمِهِ يَدي",10,"د",2,0],["لأجعلنَّ لشعرِي عنده ملكاً","على الرواةِ سنيّ الملك والتاج",11,"ج",1,0],["لأجيادنا منه وللطّرس حليةٌ","فأجيادُنا بالجود والطرس بالشّذر",12,"ر",1,0],["لا جور في دهرٍ وفيهِ ممدَّحٌ","وشحت منابته بنبتِ العادل",13,"ل",1,0],["لا جَفَّ واديكَ المُحَلَّلُ إنه","لَمُنَاخُ أطْلاحٍ على أطلاحِ",14,"ح",1,0],["لا جعل الله للزواني","من حِيَلي للزنا مَعاذا",15,"ذ",2,0],["لا جهلَ لي بعده وكيف وقد","كَيَّسني ما وُهبتُ من حذر",16,"ر",1,0],["لا جاهلاً قدْرَ الحياةِ مغمَّراً","بل عارفاً قدْرَ الحياة بسيلا",17,"ل",2,0],["لا جَدوَلٌ لا بُلبُلٌ مُنشِدٌ","بَلى بِها الوَحشَةُ وَالاِكتِئاب",18,"ب",1,0],["لاجَزاكَ اللَهُ خَيراً","وَكَفانا اللَهُ شَرَّك",19,"ك",1,0],["لِأَجلِكِ سَعيِي وَاِجتِهادي وَخِدمَتي","وَيا لَيتَ هَذا كُلُّهُ فيكَ يُثمِرُ",20,"ر",1,1],["لا جدّ إلا الموت والإنسان في","لعب الحياة ولهوها متماد",21,"د",1,0],["لأجلك حين تخرج لحرب","ولا جردت في الهيجا حساما",22,"م",2,0],["لا جَعَلَ اللَهُ لَهُ قَراراً","عاشَ حِماراً وَمَضى حِمارا",23,"ر",2,0],["لِأَجلِكِ سِرتُ في بَرٍّ وَبَحرِ","وَأَنتِ الدَهرَ أَنتِ بِكُلِّ قُطرِ",24,"ر",1,0],["لِأَجلِكِ رُحتُ بِالدُنيا شَقِيّاً","أَصُدُّ الوَجهَ وَالدُنيا أَمامي",25,"م",2,0],["لا جَزَعاً بَل أَنَفاً شابَهُ","أَن يَقدِرَ الدَهرُ عَلى غَصبِهِ",26,"ب",2,0],["لا جَوابُ الكِتابِ بَيَّنَ ما أَن","تَ عَلَيهِ ولا جَوابُ الرَسولِ",27,"ل",1,0],["لاجَديدُ الصِبا وَلا رَيعانُه","راجِعٌ بَعدَ ما تَقَضّى زَمانُه",28,"ن",2,1],["لا جارَ إِلّا اللَهُ مِن أَحَدٍ","أَوفى وَأَبعَدُ مِنكَ مِن غَدرِ",29,"ر",1,0],["لِأَجعَلَ عَبداً باهِلِيّاً لِخِبثَةٍ","إِلى حَسَبي فَوقَ الكَواكِبِ أَو شِعري",30,"ر",2,0],["لا جَعَلَ اللَهُ لي إِلَيكَ وَلا","عِندَكَ ما عِشتُ حاجَةً أَبَدا",31,"د",2,0],["لاجِيَةٌ مِن نَدى يَدَيهِ إِلى","رُكنٍ مَشيدٍ لِعَيَّهِم حَمَلا",32,"ل",2,0],["لِأَجلِ ذا أَنجُمُ العُلى طَلَعَت","بِهِ وَنَجمُ الضَلالِ قَد أَفَلا",32,"ل",2,0],["لا جادَ هَطّالُ السَحائِبِ بُقعَةً","بِالغَورِ أَضحَت وَهيَ شَرُّ بِقاعِهِ",33,"ع",2,1],["لا جَمَدَت أَدمُعي وَلا خَمَدَت","نارُ أَسىً في حَشايَ تَضطَرِمُ",34,"م",1,0],["لَأَجعَلَنَّ مَعقِلي","مُطَهَّماً صُلبَ المَطا",35,"ا",1,0],["لا جورَ في بِلادِهِ وَلا عِداً","إِن عُدَّ في العَدلِ زَبيدٌ وَعَدَن",36,"ن",1,0],["لا جمودُ القَطْرِ في المحل ولا","خُلّبُ البرق بعيْنَيْ مَنْ يَشيم",37,"م",1,0],["لا جارُهُم لِلرَزايا في جِوارِهِم","وَلا عُهودُهُمُ مَذمومَةَ الذِمَمِ",38,"م",1,0],["لا جودَ في الأَقوامِ يُعلَمُ ما خَلا","جوداً حَليفاً في بَني عَتّابِ",39,"ب",1,0],["لا جَاهَ لِي إِلَّا بِطَاعَتِهِ","وَلَنِعْمَ عُقْبَى الطَّاعَةِ الْجَاهُ",40,"ا",2,0],["لَأَجمَعُ بَينَ الماءِ وَالنارِ لَوعَةً","فَمِن مُقلَةٍ رَيّا وَمِن كَبِدٍ هَرّى",41,"ر",2,0],["لا جَفَّ مَثواكَ مِن ناءٍ تحيَّتُه","ما في الفراديسِ مِن وَرْدٍ ومن آسِ",42,"س",1,0],["لأَجلِكَ ما حَيِيتُ أعيش حُرّاً","وفيكَ أموتُ مَوْتَ فتىً نجيبِ",43,"ب",1,0],["لا جرى النّيلُ على الوادي ولا","بُوركَ الشَّعبُ إذا لم يُطلقِ",44,"ق",1,0],["لا جَنبَ مُذ هَلَكَ الرُماةُ لِمُسلِمٍ","إِلّا رَمَتهُ يَدُ العَدُوِّ بِمَصرَعِ",45,"ع",1,0],["لَأَجابَكِ الفاروقُ عَنّا وَاِنبَرى","عَمرٌو يُنَبِّئُكِ اليَقينَ وَيُخبِرُ",46,"ر",1,0],["لأجلك آثروا البُقْيا وقالوا","علينا العهدُ عهدُ الأوفياء",47,"ا",2,0],["لأجفَلَ إجفالاً كنَهورُ مُزْنِهِم","فلم يَبقَ إلاّ زِبْرِجٌ منه أو قِشع",48,"ع",1,0],["لا جادَ غيرَكمُ السحابُ فإنّكُمْ","كنتمْ لذيذَ العيشِ غيرَ مُنغّص",49,"ص",1,0],["لاجفَّ دمعُ الذي بكي على حجَرٍ","ولا شفى قلبَ من يصبو إلى وتَدِ",50,"د",1,0],["لا جارَ إِلّا سُلَيمانٌ وَأُسرَتُهُ","مِنَ العَدُوِّ وَمِن دَهرٍ بِهِ نَكَبُ",51,"ب",1,0],["لأجلكِ يَشقى بلمحِ العيونِ","ويُصرعُ بالنظرةِ العابرهْ",52,"ه",1,0],["لَأَجرهُ لَو صَبَرتُ خَيرٌ","كَم عاضَ بِالصَبرِ كَم أَنالا",53,"ل",2,0],["لَأَجرُكُمُ بِالوَصلِ أَفضَلُ مغنَمٍ","بِعَيشِكُمُ رِفقاً عَلَيهِ قَليلا",54,"ل",2,0],["لا جَلا أَحزاني الجَلدُ","لا خَلا مِن ذِكرِكَ الخَلدُ",55,"د",1,1],["لا جادَهُم غيثٌ، ولا","ساغوا بها العذْبَ المَعين!",56,"ن",1,0],["لأجاده الغيثُ الهتونُ، ولا هفا","ليلاً برقعته النسيمُ عليلا",57,"ل",2,0],["لأجل الحِمَى تُرْخِصُ المُهجاتِ","وتَصْهَرُ في النار أجسادها",58,"د",3,0],["لاجئٌ كان ملجأ. وشريدً","كان يأوي إليه كلُّ شريد",59,"د",1,0],["لا جادك الغيث الهمول إذا سقى","غيث بلاد الله يا بلذوذ",60,"ذ",1,1],["لأَجَابَتْ عَنْ ولادتِها","فمتى أنزلْ بها أقمِ",61,"م",1,0]]}