{"poems":[[79,"لمن طلل نائي المزار بعيده","https://www.aldiwan.net/poem36615.html","الطويل"],[37,"أشاقك برق آخر الليل خافق","https://www.aldiwan.net/poem39128.html","الطويل"],[10,"ياصخر من لحوادث الدهر","https://www.aldiwan.net/poem21091.html","الكامل"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[93,"وقفت ضحى في شاطء النيل وقفة","https://www.aldiwan.net/poem8826.html","عموديه"],[40,"ضعيف العصا بادي العروق ترى له","https://www.aldiwan.net/poem7728.html","الطويل"],[87,"على أي الجنان بنا تمر","https://www.aldiwan.net/poem63714.html","الوافر"],[82,"أبا هاشم هشمتني الشفار","https://www.aldiwan.net/poem31300.html","المتقارب"],[83,"أهدى نسيم الصباح","https://www.aldiwan.net/poem61390.html","المجتث"],[50,"يا صاحبي عصيت مصطبحا","https://www.aldiwan.net/poem62500.html","الكامل"],[50,"أحب إلي من وخد المطايا","https://www.aldiwan.net/poem65105.html","الوافر"],[50,"إذا عبا أبو الهيجاء","https://www.aldiwan.net/poem65307.html","الهزج"],[52,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[7,"دعاك الهوى واستجهلتك المنازل","https://www.aldiwan.net/poem1979.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39639","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147492",""],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147507","البسيط"],[93,"أيا نيل","https://www.poetsgate.com/ViewPoem.aspx?id=53039",""],[37,"أَشَاقَكَ بَرْقٌ آخِرَ اللَّيْلِ خَافِقُ","https://www.poetsgate.com/ViewPoem.aspx?id=22054",""],[147,"بإحرازك الفضل الذي بهر الخلقا","https://www.aldiwan.net/poem11786.html","الطويل"],[173,"يا ساهر الطرف من خوف ومن وجل","https://www.aldiwan.net/poem1652.html",""],[236,"أوجهك أم ضوء الصباح تبلجا","https://www.aldiwan.net/poem44571.html","الطويل"],[236,"لمن طلل دون الربا والتنائث","https://www.aldiwan.net/poem44596.html","الطويل"],[369,"وصال الشمس يهدي الاحتراقا","https://www.aldiwan.net/poem60836.html","الوافر"],[376,"سما لك برق أو بدا لك نور","https://www.aldiwan.net/poem57391.html","البسيط"],[382,"ما أحسن الروض في الروابي","https://www.aldiwan.net/poem66927.html","مخلع البسيط"],[415,"أعاتب فيك الدهر لو أعتب الدهر","https://www.aldiwan.net/poem31861.html","الطويل"],[469,"قوامك اللدن لا ما يزعم الغصن","https://www.aldiwan.net/poem3196.html","عموديه"],[580,"أقاموا بالمواخير","https://www.aldiwan.net/poem2950.html","الهزج"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138215",""],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113934","الطويل"],[1743,"","https://poetry.dctabudhabi.ae/diwan/poem/17654","الطويل"],[1884,"","https://poetry.dctabudhabi.ae/diwan/poem/203971","المنسرح"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89527","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111275","الطويل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136980",""],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103440","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65110","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34611","المتقارب"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34601","البسيط"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93774","المنسرح"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94561","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133123","الطويل"],[5183,"الأبيات الحرى","https://www.poetsgate.com/ViewPoem.aspx?id=180266",""],[5855,"بوادر دمعك ما تنزف","https://www.poetsgate.com/ViewPoem.aspx?id=186553",""],[5956,"حكيماً كان سيدنا","https://www.poetsgate.com/ViewPoem.aspx?id=192635",""],[5956,"فاسد يشجع على عقوق الوالدين","https://www.poetsgate.com/ViewPoem.aspx?id=193421",""]],"verses":[["يحُثُّ جَناحَ السّيْرِ حتّى كأنّما","رَجاءُ أميرِ المُسْلِمينَ يَقودُهُ",0,"د",2,0],["يَحُثّونَ صُبحَ الحُمرِ خوصاً كَأَنَّها","بِنَخلَةَ مِن دونِ الوَحيفِ المَطارِقُ",1,"ق",1,0],["يُحثى التُرابُ عَلى مَحاسِنِهِ","وَعَلى غَضارَةِ وَجهِهِ النَضرِ",2,"ر",1,0],["يحثّ مسراه عقاب كاسره","خافضة لحظ الطيور ناصبه",3,"ه",1,0],["يحثُّ غرنوقاً شهيّ المجتلى","مقدَّماً على الغرانيق العلى",3,"ل",2,0],["يَحُثُّ إِلَيَّ الدَهرُ كُلَّ رَزيأَةٍ","عَلى عَجَلٍ حَتّى كَأَنِّيَ واتِرُه",4,"ر",2,0],["يَحُثُّ بِهِنَّ الحادِيانِ كَأَنَّما","يَحُثّانِ جَبّاراً بِعَينَينِ مُكرَعا",5,"ع",2,0],["يَحُثُّ خُطاكَ لُجٌّ بَل لُجَينُ","بَلِ الإِبريزُ بَل أُفقٌ أَغَرُّ",6,"ر",1,0],["يَحُثّونَ للهَيْجاء جُرْداً سلاهباً","وَيُنْضُونَ في البيداءِ بُزلاً صَلادِما",7,"م",2,0],["يَحُثُّها خَندَريسا","مِن خَدِّ ساقيها تُعصَر",8,"ر",1,0],["يَحثو اللُهى لَكَ مِن مَحاسِنِهِ","فَإِذا سَنَحتَ لِوَصلِهِ بَرَحا",9,"ح",2,0],["يُحِثُّ بِها كَخوطِ البانِ ساقٍ","لَهُ مِن قَلبِيَ الحَظُّ الجَسيمُ",10,"م",1,0],["يَحُثُّ الكَأسَ كَي تَلحَ","قَ أُخرانا بِأولانا",11,"ن",2,0],["يَحثي لِهَذا وَذا وَذاكَ وَلا","يَحسِبُ مَعروفَهُ كَمَن حَسَبا",12,"ب",2,0],["يَحُثُّ الحُداةَ جالِزاً بِرِدائِهِ","يَقي حاجِبَيهِ ما تُثيرُ القَنابِلُ",13,"ل",1,0],["يحثَّان في البيداء راحلتَيْهما","إلى جبلٍ يُؤوي الحقيقةَ جانبُهْ",14,"ب",2,0],["يحث بالنعش حاملوه","وشد ما سارت النعوش",15,"ش",1,0],["يحث نفساً عن الإحسان عاجزة","وقد أساء بعلم الواحد العملا",16,"ل",2,0],["يحثّ إليّ الدهر كلّ رزيئة","على عجل حتى كأنّي واتره",17,"ر",2,0],["يَحُثُّونَ صُبْحَ الحُمْرِ خُوصاً كأَنَّها","بنخلة َ من دونِ الوجيفِ المطارقُ",18,"ق",1,0],["يَحُثُّ الجَوادَ الأَعوَجِيَّ وَما وَنى","وَيُسقي الحُسامَ المَشرَفِيَّ وَما اِستَسقى",19,"ق",2,0],["يَحُثُّها مِن عُقَيلٍ كُلُّ ذي أَشَرٍ","مَولى فَوارِسَ لا ميلٍ وَلا عُزَلِ",20,"ل",1,0],["يحثحثها الحادي العجول مهجرا","إليك ويطوي شقة البيد مدلجا",21,"ج",2,0],["يحثحثه حتى ينال مراده","فطالب أسباب العلى ذو حثاحث",22,"ث",1,0],["يَحُثُّ لك الخُطا شَرقاً وغَرْباً","وفيما شِئْتَ يَنْساقُ انْسِياقا",23,"ق",2,0],["يحث بكِ الحادي بَعيراً وهَودجاً","وما البينُ إلا هَودجٌ وبَعيرُ",24,"ر",1,0],["يحثني الفكر في مديحٍ","ليوسف الفاضل المهاب",25,"ب",1,0],["يَحُثُّ على الصّبرِ الجميلِ فإِنَّه","يُنالُ به حُسنُ المعوضَةِ والأجرُ",26,"ر",1,0],["يحثنَّ على طول الدجى أرنٌ","خيرُ الثناء عليك السابق الأرن",27,"ن",1,0],["يحثُّون خبولَ اللَّهْ","وِ منها بالأَشَابِيرْ",28,"ر",1,0],["يحث الدين كل ذوات لب","على استهجان تلك المخزيات",29,"ت",1,0],["يَحُثُّ ضراءً كالِحاتٍ كأنَّها","قِداحُ مفيضٍ بالمَغاليقِ مُفلِجِ",30,"ج",1,0],["يَحُثُّ بِهِم حادٍ سَريعٌ نَجاؤُهُ","وَمُعرىً عَنِ الساقَينِ وَالثَوبُ واسِعُ",31,"ع",1,0],["يحُثُّ عندَ الفتور قائده","ضرباً ويعروه دُونَه النَّصَبُ",32,"ب",1,0],["يَحُثُّ ثِقالَ المُزنِ فيهِ مُجَلجِلٌ","إِذا ما حَدا سَلَّت سُيوفاً لَوامِعُهُ",33,"ع",2,0],["يحث عليه أهله ويلومهم","على تركه لوم الأثيم على الإثم",34,"م",1,0],["يحث الشحيح على البذل ان","تجافى الشحيح طريق الكرم",35,"م",1,0],["يحثُّ جناحيه على حرِّ وجهه","كما فصِّلت فوق الخدود المغافر",36,"ر",1,0],["يحثُّ مطايا الكأس شاد بلحنه","غدا مُعربا عن لحن داوُود بالنّصب",37,"ب",1,0],["يحثُّ كئوسهم مُخطَفٌ","تُجاذِبُ أردافُه المِئزَرا",38,"ر",2,0],["يحثها دالقٌ بالقدس محتنكٌ","من الأساقف مزموراً بمزمار",39,"ر",1,0],["يَحثه عَزمه وَتدفعه","إِلى العُلا نَفسه وَما كَسبا",40,"ب",2,0],["يحثُّ الموالي بالموالات والتقى","ويأمرُ بالمعروف ينهي عن الردى",41,"د",2,0],["يحث عليها الناس كي يتركوا لها","شواغل آمالٍ لهم وأمانيا",42,"ي",2,0],["يحثك القصد للحسنى على شغف","الوصل يبرده والشوق يذكيه",43,"ي",2,0],["يحث به النزع أنفاسه","يجذب له كرب تردف",44,"ف",1,0],["يحثُّ على المحبة والتآخي","ونشرِ العدل والخُلق النبيلِ",45,"ل",1,0],["يَحُثّ المجرمُ الكاسدْ","لكره الأم والوالدْ",46,"د",1,1]]}