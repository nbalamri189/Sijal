{"poems":[[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[47,"نعم تلك بين الواديين الخمايل","https://www.aldiwan.net/poem25205.html","الطويل"],[43,"تذكرت ما بين العذيب وبارق","https://www.aldiwan.net/poem9734.html","الطويل"],[62,"الزئبق الأبيض الرقيق إذا","https://www.aldiwan.net/poem52189.html","المنسرح"],[87,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[390,"مشيب عراه لو يدوم مشيب","https://www.aldiwan.net/poem53654.html","الطويل"],[459,"ذريني وأهوالي نفر ونلتقي","https://www.aldiwan.net/poem15283.html","الطويل"],[459,"يفضله على ماء الغوادي","https://www.aldiwan.net/poem15693.html","الوافر"],[556,"صفا الوجود فلا علم ولا عمل","https://www.aldiwan.net/poem34205.html","البسيط"]],"verses":[["قَشاعِمٌ طارَتِ الجُدودُ بِهِم","مُذ صَعِدوا في العَلاءِ ما نَزَلوا",0,"ل",3,0],["قُشَيرِيَّةٌ قَترِيَّةٌ بَدَوِيَّةٌ","لَها بَينَ أَثناءِ الضُلوعِ مَنازِلُ",1,"ل",1,0],["قُشَيرٌ وَبَلعَجلانِ فيها خَفِيَّةٌ","كَراءَينِ في أَلفاظِ أَلثَغَ ناطِقِ",2,"ق",1,0],["قشورها أفسدت طبائعها","فهو بغير القشور يختارُ",3,"ر",1,0],["قَشِيبُ الصِّبَا كَهْلُ التَّدَابِيرِ جَامِعٌ","صُنُوفَ الْعُلا وَالْمَجْدِ فِي صَدْرِ جَازِمِ",4,"م",1,0],["قَشِيبَةً غَرِيبَةً","عَصْرِيةً نَسْجَ مُضَرْ",5,"ر",1,0],["قَشيبٌ وَلكِن يَخلُقُ المَرءُ عِندَهُ","وَيَلقى ضُروبَ الأُنسِ وَهو مريبُ",6,"ب",1,0],["قشيبُ رداءِ العرض لكنَّ مالهُ","يُمزقُه العافونَ كل مُمزَّقِ",7,"ق",1,0],["قَشيبُ العرْضِ لا يُرْمى بذمٍ","وعِرْضُ عَدوِّهِ سَمَلٌ رثيثُ",8,"ث",1,0],["قَشِّرْ وجودَكَ إنَّ القشرَ تأكُلُهُ","دوابُّنا أنت قشرٌ أيها الرجل",9,"ل",1,0],["قشرٌ هو العدمُ الموهوم ليس له","أصلٌ وما ثم لا سهلٌ ولا جبل",9,"ل",1,0]]}