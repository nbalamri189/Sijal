{"poems":[[55,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[49,"نعم تلك بين الواديين الخمايل","https://www.aldiwan.net/poem25205.html","الطويل"],[45,"تذكرت ما بين العذيب وبارق","https://www.aldiwan.net/poem9734.html","الطويل"],[64,"الزئبق الأبيض الرقيق إذا","https://www.aldiwan.net/poem52189.html","المنسرح"],[89,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[398,"مشيب عراه لو يدوم مشيب","https://www.aldiwan.net/poem53654.html","الطويل"],[466,"ذريني وأهوالي نفر ونلتقي","https://www.aldiwan.net/poem15283.html","الطويل"],[466,"يفضله على ماء الغوادي","https://www.aldiwan.net/poem15693.html","الوافر"],[563,"صفا الوجود فلا علم ولا عمل","https://www.aldiwan.net/poem34205.html","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70866","الخفيف"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96314","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120152","المنسرح"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128070","الكامل"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45470","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88643","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204640","الوافر"],[3949,"","https://poetry.dctabudhabi.ae/diwan/poem/127768","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141675","الطويل"],[5277,"\" من البغداديات \"","https://www.poetsgate.com/ViewPoem.aspx?id=210741",""],[5436,"فجّر الثورة ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35273",""],[5818,"احشر الكون في لهاث المضيقِ","https://www.poetsgate.com/ViewPoem.aspx?id=196652",""],[6134,"بزغت شموس السعد بالشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=169525",""]],"verses":[["قَشاعِمٌ طارَتِ الجُدودُ بِهِم","مُذ صَعِدوا في العَلاءِ ما نَزَلوا",0,"ل",3,0],["قُشَيرِيَّةٌ قَترِيَّةٌ بَدَوِيَّةٌ","لَها بَينَ أَثناءِ الضُلوعِ مَنازِلُ",1,"ل",1,0],["قُشَيرٌ وَبَلعَجلانِ فيها خَفِيَّةٌ","كَراءَينِ في أَلفاظِ أَلثَغَ ناطِقِ",2,"ق",1,0],["قشورها أفسدت طبائعها","فهو بغير القشور يختارُ",3,"ر",1,0],["قَشِيبُ الصِّبَا كَهْلُ التَّدَابِيرِ جَامِعٌ","صُنُوفَ الْعُلا وَالْمَجْدِ فِي صَدْرِ جَازِمِ",4,"م",1,0],["قَشِيبَةً غَرِيبَةً","عَصْرِيةً نَسْجَ مُضَرْ",5,"ر",1,0],["قَشيبٌ وَلكِن يَخلُقُ المَرءُ عِندَهُ","وَيَلقى ضُروبَ الأُنسِ وَهو مريبُ",6,"ب",1,0],["قشيبُ رداءِ العرض لكنَّ مالهُ","يُمزقُه العافونَ كل مُمزَّقِ",7,"ق",1,0],["قَشيبُ العرْضِ لا يُرْمى بذمٍ","وعِرْضُ عَدوِّهِ سَمَلٌ رثيثُ",8,"ث",1,0],["قَشِّرْ وجودَكَ إنَّ القشرَ تأكُلُهُ","دوابُّنا أنت قشرٌ أيها الرجل",9,"ل",1,0],["قشرٌ هو العدمُ الموهوم ليس له","أصلٌ وما ثم لا سهلٌ ولا جبل",9,"ل",1,0],["قشرتْ وجهَ كل وعرٍ وسهلِ","بشآبيب وقعها الحراض",10,"ض",1,0],["قَشعاً ترى الثِبّت من خبابه","فانقضّ كالجلمود إذ علا به",11,"ب",2,0],["قشيلة قد خبرت قصّته","من حذر الشقص منك في ويلِ",12,"ل",1,0],["قشعت دياجى الجهل شمس علومه","والكل في الارعاد والابراق",13,"ق",1,0],["قَشَمت فَجرَّ بِرِجلِها أَصحابُها","وَحَشوا عَلى حَفصٍ لَها وَعِمادِ",14,"د",1,0],["قشع البين منه غيثا ركاما","بل طَوى من اظله العرش ظلا",15,"ل",2,0],["قشور الدين قد حجبته عنا","فهل تسعى الى نزع القشور",16,"ر",1,0],["قشعت نام الجهل والله يا فتى بمد","حه قد ضجَّ العدى منه ترهقُ",17,"ق",1,0],["قشيبِ حظاها ريقّ العيش ملبوس","فبِتْ آمناً فيها وقم باكراً إلى",18,"ل",2,0],["قشورٌ ما تغنى الشعرُ..لكنْ","لبابُ الحسنِ روحٌ لا تجورُ",19,"ر",1,0],["قشعَ الظّلمةَ عنه، والضبابا","فجِّرِ الثورةَ ماءً وترابا",20,"ا",1,0],["قِشرة السطح تستفزّ الحوايا","غاية الخلْق كلّ شيءٍ عميقِ",21,"ق",1,0],["قشعت غيوم الضيم عنها فانجلت","كعروسة تزري ببدر سماء",22,"ا",2,0]]}