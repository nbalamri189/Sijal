{"poems":[[57,"يا رب رد علينا","https://www.aldiwan.net/poem26076.html","المجتث"],[90,"ما للديار تراءى وهي أطلال","https://www.aldiwan.net/poem44390.html","البسيط"],[74,"رأت بناتي حب جسمي الذي","https://www.aldiwan.net/poem20004.html","السريع"],[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[53,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[51,"يا رب رزق قد أتى من سبب","https://www.aldiwan.net/poem10336.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39568","الكامل"],[53,"أما الزمانُ إلى سلمى فقد جَنَحا","https://www.poetsgate.com/ViewPoem.aspx?id=27419",""],[98,"في القرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66357&r=&rc=33",""],[193,"عج بالمدينة تلق ثم كريما","https://www.aldiwan.net/poem35109.html","الكامل"],[201,"جاء الربيع وأنت راقد","https://www.aldiwan.net/poem39867.html","مجزوء الكامل"],[216,"حوادث الدهر فيها البجر والعبر","https://www.aldiwan.net/poem37884.html","البسيط"],[261,"يا ربرب اعبر بنا على ملك","https://www.aldiwan.net/poem48369.html","المنسرح"],[318,"يا رب رأسي ضرني","https://www.aldiwan.net/poem59479.html","مجزوء الرجز"],[408,"يا كعبة الحسن التي","https://www.aldiwan.net/poem46721.html","مجزوء الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39013","البسيط"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34785","الكامل"],[977,"","https://poetry.dctabudhabi.ae/diwan/poem/124596","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61249","البسيط"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124493",""],[2903,"","https://poetry.dctabudhabi.ae/diwan/poem/204535","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201611","السريع"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102430","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136033","الرجز"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76715","البسيط"],[4866,"رباه","https://www.poetsgate.com/ViewPoem.aspx?id=129542",""],[5150,"الخائنة ..!","https://www.poetsgate.com/ViewPoem.aspx?id=202894",""],[5152,"حلب- تنتصر - بحول الله وقوته","https://www.poetsgate.com/ViewPoem.aspx?id=184728",""],[5281,"أخي؛ إلى اللقاء!","https://www.poetsgate.com/ViewPoem.aspx?id=200106",""],[5742,"رثاء الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=206959",""],[5956,"سقوط عداي","https://www.poetsgate.com/ViewPoem.aspx?id=185611",""],[5956,"أمضي وآكلُ من أبيات سيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=192102",""],[5956,"لا عدل في الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=192298",""],[5956,"يا رب رتِّبْ أمره","https://www.poetsgate.com/ViewPoem.aspx?id=193873",""],[5977,"يا رب رحماك","https://www.poetsgate.com/ViewPoem.aspx?id=213292",""]],"verses":[["يا رَبُّ رُدُّ عَلَينا","مَن كانَ أُنساً وَزَينا",0,"ن",2,1],["يا ربّ رحماك إني اليوم عاجزة","عمّادها وبظهري منه أثقال",1,"ل",1,0],["يا ربّ رحماك فمنك الشفا","من كلِّ ما يخفى وما يعلم",2,"م",1,0],["يا رُبَّ رأيٍ فيهمُ","لا تَبلغُ الآراءُ قابهْ",3,"ب",2,0],["يا رُبَّ رأيٍ صوابٍ قد فتحتَ لهم","لولاك يا فاتح الأبواب ما انفتحا",4,"ح",2,0],["يا رُبَّ رِزقٍ قَد أَتى مِن سَبَب","لَو سَلَّمَ العَبدُ إِلَيهِ الطَلَب",5,"ب",1,1],["يا رُبَّ رسمٍ من ربوعك دارسٍ","قَصُرَ الثواءُ به وطال وقوفي",6,"ف",2,0],["يا رُبَّ رأيٍ صوابٍ قد فتحتَ له","لولاك يا فاتح الأبواب ما انفتحا",7,"ح",2,0],["يا ربّ رسم من ربوعك دارس","قصر عن الأحباب غير صدوف",8,"ف",1,0],["يا ربِّ رُبَّ فتىً جَنى فاِستَأمنا","بِمحمَّدٍ قَد قال غاياتِ المُنى",9,"ن",2,0],["يا ربّ ريح طوّحت","بسفينة والبحر راكد",10,"د",1,0],["يا رب روّي ضريحاً ضمَّ جثتَه","بوابلٍ من عيونِ المُزنِ يَنْحَدرُ",11,"ر",1,0],["يا ربربُ اعبر بنا على ملكٍ","توجهُ الله بالمهاباتِ",12,"ت",1,1],["يَا رَبِّ رَأسي ضَرَّني","مِن وَجَعٍ فِيهِ سَكَن",13,"ن",1,1],["يا رَبْرَبَ الحسْنِ الذي","خضَعَتْ له الأسْدُ الضواري",14,"ر",2,0],["يا ربّ رُحماكَ في تَبْليغِ مأربهِ","فَلُطفكَ اللُّطْفُ في تيسيرِ كل عَسِي",15,"س",2,0],["يا رب رب الرائحين عشيةً","بالقوم بين منًى وبين ثبير",16,"ر",1,1],["يا رب راء رأى ما قد رأيت وكم","رأيت من ذاك ما لم يبد للرّائي",17,"ي",1,0],["يا رب راقد نوم حَشو مضجعه","شوك القتاد وَلَكن لا يسهده",18,"د",2,0],["يا رب رحماك للأسلاف والخلفا","بارك لنا فيه بالمختار والخُلفا",19,"ف",2,1],["يا رب رامٍ حسنٍ تعرُّضُهْ","يرمي ولا يشعر أني غرضُهْ",20,"ه",1,1],["يا رَبّ روحي همّني أمرها","وعشت عن جسميَ كالمُعرض",21,"ض",1,1],["يا ربَّ ركبٍ أناخوا بعدما نصبوا","من الكَلالِ وما حَلوا وما رحلوا",22,"ل",3,1],["يا ربِّ ربِّني وربِّ من لي","من المواريد وأصلحْ كلّي",23,"ي",1,1],["يا رب ربة خدرٍ زرت مضجعها","والدجى الغريب معتبر",24,"ر",1,1],["يا ربّ رجّع لذيذ النوم","ورزقٍ وفيرٍ محاصيله",25,"ل",2,0],["يا ربُّ رحماكَ إني ذقتُ لوعَتها","والنارُ شبَّتْ وقد أعيتْ مطافيها",26,"ي",3,0],["ياربِّ ، روحُ جَنَائِنِ الأبطالِ في","حَلَبٍ ونحنُ سجونُنَاالإِرعَادُ",27,"د",1,0],["يَا رَبُّ رحمتكَ التي نَرْجُو لَهُ","كرمًا وفضلًا رَبُّنَا يَجْزِيه",28,"ي",2,0],["يا رب رحماك تهدينا لخاتمةٍ","تحفُنا برحيقِ الذكرِ أنوارُ",29,"ر",1,0],["‏ ‏يا ربّ رفقاً بالأحبة والعدى","فأنا مُفَدِّيهم معاً بدمايا",30,"ا",3,0],["يا ربِّ رغم خَصاصات تَحيقُ بهم","لم يبخلوا مثل بعض الأهل والأمم",31,"م",1,0],["يا رب رفقاً فالشقاء يسودُ","وطناً غزاه المجرمون الهُودُ",32,"د",1,1],["يا رب رتِّبْ أمرَهُ بكُويتهِ","وبِغيرها حتى أعيش ببيتهِ",33,"ت",2,1],["يارب رحماك من ضرٍّ يحيط بنا","نخشى عقابك يا رباه نخشاه",34,"ا",2,1],["يارب رحماك ..لطفاً إننا بشرٌ","نتوب حيناً إلى المولى وننساه",34,"ا",2,0]]}