ps://www.poetsgate.com/ViewPoem.aspx?id=189992",""],[5376,"مال قلبي لهواه فاستهاما","https://www.poetsgate.com/ViewPoem.aspx?id=196642",""],[5525,"البتول","https://www.poetsgate.com/ViewPoem.aspx?id=878",""],[5563,"جنون العشق","https://www.poetsgate.com/ViewPoem.aspx?id=211921",""],[5563,"كَلَّ منِّي الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=212143",""],[5572,"العشق القديم","https://www.poetsgate.com/ViewPoem.aspx?id=53486",""],[5668,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=178829",""],[5749,"القلب الكبير","https://www.poetsgate.com/ViewPoem.aspx?id=129775",""],[5792,"لي حبيب","https://www.poetsgate.com/ViewPoem.aspx?id=180336",""],[5939,"مهلك","https://www.poetsgate.com/ViewPoem.aspx?id=178591",""],[6056,"العنود","https://www.poetsgate.com/ViewPoem.aspx?id=130505",""],[6124,"ما لقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=159899",""],[2220,"ما لقومٍ إذا تفكررتُ فيهمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11249&r=&rc=123",""]],"verses":[["ما لِقَلبي عَنِ السَلو","وِ رَأى النارَ فَاِقتَبَس",0,"س",1,0],["ما لِقائي مِن عَدوّي","كَلِقائي مِن مَشيبِ",1,"ب",1,0],["مَا لِقَلْبِي إِذاَ هَفَا الْبْرقُ حَنَّا","وَصَبَا لِلنَّسِيمِ فِي أَرْضِ لُبْنَى",2,"ن",2,1],["ما لقبي إذا ذكرتك يهفو","ولعيني تُذري الدموع سجاما",3,"م",2,0],["ما لقلبي اليتيم ضلَّ وقد آ","نسَ من جانب السوالف نارا",4,"ر",2,0],["ما لَقينا من ظَرفِ ضرطةِ وهبٍ","صَيَّرت أهلَ دهرِنا شعراءَ",5,"ا",2,1],["ما لقينا مثل البثوق اللواتي","منحت منك بعد برٍّ عقوقا",6,"ق",2,0],["ما لقلبي يُضحي ويُمسي خفيَّاً","منك يا سيدي بغير حَفِيِّ",7,"ف",2,0],["ما لِقَومي لا وَهيَ حَبلُهُمُ","قَنِعوا مِن دَهرِهِم بِالوَشَلِ",8,"ل",1,0],["ما لِقَلبِيَ يَلُجُّ مِنَ الخَفَقانِ","لا أَنا عاشِقٌ وَلا أَنا جانِ",9,"ن",1,1],["ما لِقَلبي مِنكَ يا بَد","رُ سِوى خُفَّي حُنَينِ",10,"ن",1,0],["مَا لقَلبُ إِلّا دارُهُ","ضُرِبَت لَهُ فيها البَشائِر",11,"ر",1,0],["ما لَقِيَ البيضُ مِنَ الحُرقوصِ","مِن مارِدٍ لِصٍّ مِنَ اللُصوصِ",12,"ص",1,1],["ما لقاء المنون منك ببدع","أي انسان لا يلاقي المنونا",13,"ن",2,0],["ما لقوم نسلتهم هلك","في النهايات عن الموت غنى",14,"ن",2,0],["ما لَقينا مِن الحُقوقِ اللَواتي","تَتَشَكّى أَوجاعَهُنَّ القُلوبُ",15,"ب",1,0],["ما لِقَلبي كَأَنَّهُ لَيسَ مِنّىً","وَعِظامي إِخالُ فيهِنَّ فَترا",16,"ر",2,0],["ما لِقومِي مِنْكَ في شكٍّ مُريبْ","غاب لُبُّ الأمرِ عن عِلمِ اللّبيبْ",17,"ب",1,0],["ما لَقِيَ العالَمونَ مِنكَ وَمِن","طَرفِكَ ما إِن يُعَدُّ مِن قُبِرا",18,"ر",2,0],["ما لِقَلبي كأَنَّه بركان","هاجَ بعد الخمود منه وَثارا",19,"ر",2,0],["مَا لِقَلْبِي مِنْ لَوعَةٍ لَيْسَ يَهْدَا","أَوَ لَمْ يَكْفِ أَنَّهُ ذَابَ وَجْدَا",20,"د",2,1],["ما لقلبي إذا هفا البرق حنا","وصبا للنسيم من أرض لبنا",21,"ن",2,1],["ما لقلبي يبعث الحبّ به","عبث الإعصار بالغصن الرطيب",22,"ب",1,0],["ما لقومي لا وهى حبلهم","قنعوا من دوهرهم بالوشل",23,"ل",1,0],["ما لقيَ البيضُ منَ الجرقوصِ","منْ ماردٍ لصٍّ منَ اللّصوصِ",24,"ص",1,1],["ما لقلبي اذا ذكرتك يهفو","ولعيني تُذرِي الدموع سِجاما",25,"م",2,0],["ما لقينَا له عدوّاً من النا","س جميعاً أمثلُ هذا يُعَادَى",26,"د",2,0],["ما لقلب غير قلبي نشوةٌ","إنه يسكر بالماء القراح",27,"ح",1,0],["ما لَقى مَجنونُ لَيلى","بَعضَ ما ذُقتُ جُنون",28,"ن",1,0],["ما لقلبي لا يُبينُ","مُنْزَوٍ باكٍ حزينُ",29,"ن",1,1],["ما لقب العرضي إلا بعدما","عرضت عليه من العلى علياؤه",30,"ا",3,0],["ما لِقَلبي لا يَجوز المُنْحَنَى","خَطْفَة لِلْبَرْقِ إلا اخْتَلَجا",31,"ج",2,0],["ما لقصر الزهور أضحى كئيباً","بعد أن كان بهجة الأزمانِ",32,"ن",1,1],["ما لِقَلبي والحبِّ لَو لَم تُمِله","للتَصابي أَعطافُك الميّاله",33,"ل",2,0],["ما لِقَلبي يَزيدُ فيك غَراماً","كلَّما زِدتَ عن هواه نِفارا",34,"ر",2,0],["ما لِقَلبي والصَبا وَيحَ الصَبا","كُلَّما مرَّت به زادَ اِهتِياجا",35,"ج",2,0],["ما لِقَلبي بِالوَجد عِن","د التَلاقي يَجرَّح",36,"ح",1,0],["ما لِقَومٍ اِذا يقالُ عَلِيٌّ","صارَ في وَردِ خَدِّهِم ياسمينُ",37,"ن",1,1],["ما لقيناه على دَربِ الهوى","بل على دَربِ الهُداةِ المهتدين",38,"ن",1,0],["مال قوم نحوه واتخذوا","شطحات مثل سبحاني أنا",39,"ن",2,0],["ما لقينا بوقوف الرّكب في","ساحةِ النّعمان إلاَّ نصبا",40,"ب",2,0],["ما لقلبي على فراقك صبرٌ","لا ولو كان في حِمى رضوانِ",41,"ن",1,1],["ما لِقَلبي على قِراعِكَ صبرٌ","لا ولو كان في حِمى رضْوانِ",42,"ن",1,0],["ما لقريشٍ ما ذقتك عهدَها","ودامجتك ودَّها على دَخلْ",43,"ل",1,0],["ما لقلوبٍ جُبلتْ لدنَةً","يعطفها العاجمُ والكاسرُ",44,"ر",1,0],["ما لَقيَ الضَّامِرُ منْ جوعِهِ","حَوى له السَّبْقَ بيومِ الرِّهانْ",45,"ن",1,0],["ما لقلبي عن شذا الظبي مناص","يا حمام الأيك أنتم خمس",46,"س",1,0],["ما لقلبي ولهم يوم النوى","إنَّه ضاع بذيّاك اللوي",47,"ي",1,0],["ما لَقَّبُوه بها لأَنْ يَعْلو بِها","أَسماؤه أَغْنَتْه عن أَلْقابِها",48,"ب",3,0],["ما لقينا من أخي تيم","ومن أرجاف قومهِ",49,"م",2,1],["ما لِقلبي لم يفارقه الجَوى","وعُيوني دمعُها لم يتأَنّى",50,"ن",2,0],["ما لقتلى الجهاد باتوا وهم لل","شهوات الكريهة اليوم قتلى",51,"ل",2,0],["ما لقلبي وما تقضَّى شبابي","بعد ذاك الليان صار جموحا",52,"ح",2,0],["ما لقومي الذين قد عنفوني","لا يكادون يفقهون حديثا",53,"ث",2,0],["ما لقلبي لم يُفق إلا إذا","ضاءَ برقُ القربِ أو برقٌ أضَا",54,"ض",2,0],["ما لقطر كَتمته","اعتِناء بَقدره",55,"ر",2,0],["ما لقلبي كلما طال المدى","منك لا ينفك يبدي كمدا",56,"د",2,1],["ما لقلبي على البعاد اصطبار","فإليكم بحقكم واصلوني",57,"ن",2,0],["ما لِقَلبي عَنهُ سَلوه","كَيفَ أَصنَع يا رِجال",58,"ل",1,0],["ما لقينا من جود فضل بن يحيى","ترك الناس كلهم شعراء",59,"ا",2,1],["ما لقينا من جودِ فضل بن يحيى","صير الناسَ كُلهمْ، شُعراءَ",60,"ا",2,1],["ما لقلبي كلما مال غصن","عطفته نسمات الشمال",61,"ل",1,0],["ما لقصر أبيض الوجه غدا","في بلاد الشرق مسودّ الجبين",62,"ن",1,1],["ما لقومي عن حديثي في عما","ثم قالوا نحن فيكم علما",63,"م",2,1],["ما لقومٍ إذا تفكرتُ فيهم","لا يكادون يفقهون حديثا",64,"ث",2,1],["ما لقومي عن وجودي قد عموا","أترى أدركهم فيه صممْ",65,"م",1,1],["ما لقومي عن حديثي في عمى","ما أظنُّ القومَ إلا قدما",66,"م",2,1],["ما لقلبي من هواه مخلصٌ","لا ولا أرجو لهُ مُنقَلَبا",67,"ب",2,0],["ما لِقَلبي هائِماً قَلقاً","كُلَّما سَكَّنتُهُ وَثَبا",68,"ب",2,0],["ما لقلبي يأبى له الشوق والوج","دُ شفاء من هذه الأوصاب",69,"ب",1,0],["ما لقومي عموا عن الجدد اللا","حب واستوبلوا به الإيرادا",70,"د",2,0],["ما لِقَلبي لَيسَ يَشفى داؤهُ","كُلَّما زالَ ضَنىً عادَ ضَنا",71,"ن",2,0],["ما لقرطيك غَير لَطمك ذَنب","فَلذا اِستوجَبا بِهِ التَعليقا",72,"ق",2,0],["ما لقلبي من لوعة البين راق","أتراني أحيا ليوم التلاقي",73,"ق",2,1],["ما لِقَلبي مُقَسَّم الأَفكارِ","وَكَأن قَد حُشِيَ بِجَمرَةِ نارِ",74,"ر",1,1],["ما لِقَلبي غَرَضٌ في أَحَدِ","منذُ بانَت قِطعَةٌ مِن كَبِدي",75,"د",2,1],["ما لقب فاقد توأمه","غير أن يبكي ويمضي في البكاء",76,"ا",2,0],["ما لقلبي والجوى مهما يكن","طالباً للسلم ناداه كفاحا",77,"ح",2,0],["ما لقومي لا سقوا صوب الحيا","إن عهدي بهم الحي اللقاح",78,"ح",1,0],["ما لقلبي عنك اسعادٌ بسعدي","حيث حلَّت ولبانات بلبني",79,"ن",2,0],["ما لقلبي من السوى عنك حظُّ","أنت عندي اللطيف والكل فظُّ",80,"ظ",1,1],["ما لقلبي على التَّقَلُّبِ لا يَسْ","معُ فيكم مَلامةَ العُذَّالِ",81,"ل",1,0],["ما لِقَلْبي وجيرةَ الحيّ لمّا","أتْلَفوهُ وأصْبَحوا سُكّانَهْ",82,"ن",2,0],["ما لقَلبي يصْبو ودمعي يَصوبُ","عندَما بانَ منزِلٌ وحَبيبُ",83,"ب",1,1],["ما لقوم عن حيدرٍ قد تولوا","هل دعاها لذاك غير عماها",84,"ا",3,0],["ما لقلبي من بعد فقد النذير","من سلوٍ على مرور الدور",85,"ر",1,1],["ما لقوم ضلوا عن الرشد ساروا","بين صبح الرشاد والديجور",86,"ر",1,0],["ما لقينا من غدر دنيا فلا كا","نت ولا كان أخذها والعطاء",87,"ا",2,0],["ما لِقُريشٍ لا علا كعبُها","من قدموا اليومَ ومن أخروا",88,"ر",3,0],["ما لقلبي من وَلُوعٍ بالجفا","آخِذِ اللُّبِّ بأطرافِ البَنَان",89,"ن",1,1],["مالقينا من الظباء العواطي","خافقات القرون والأقراط",90,"ط",1,1],["ما لقلبي تهزه الأشواق","خبرينا أهكذا العشاق",91,"ق",1,1],["ما لقي القيسان قيس بن ذريح","ما ألاقيه وقيس العامري",92,"ي",1,0],["ما لقلبي على الجوى من معين","غير سفحي لدمع عين معين",93,"ن",1,1],["ما لقلبي خافقاً في ذا السعير","ما لطرفي مذرفاً دمعاً غزير",94,"ر",1,0],["ما لقلبي فاصلٌ كلّا ولا","ينثني عنهُ بابرام النَذَر",94,"ر",1,0],["ما لقلبي يذوب وجداً وشوقاً","بعد أن صار للحسان حبيسا",95,"س",2,0],["ما لقينا من مرسلات طوال","أسلمتنا إلى ليال طوال",96,"ل",1,0],["ما لِقَلبي أرَقُّ من كلّ قلب","ولحُبّي أشدُّ من كلّ حبّ",97,"ب",1,1],["ما لِقومٍ لقد أُصيبوا بجرحٍ","لم يُرَجّوا لولا الرجاءُ اندمالَهْ",98,"ل",2,0],["ما لقلبي كلما ناح شجواً ؟","أجهشت تبكي نداها حقولُ",99,"ل",1,0],["ما لقومٍ على الهزائم نصرٌ","دون سمعٍ إلى إمامٍ مُطاع",100,"ع",1,0],["ما لقلبي من وداد","عندما جاء الحداد",101,"د",1,0],["مالقيت من الوفاء يااول نديم","كون صدق الحزن وجهه وظهره",102,"ر",2,0],["مالقيت من البشر واحد نديم","كلهم مثل الشهب يمكن امر",103,"ر",1,0],["مالقيت أبها سوى جرحٍ أليم","وطعنتٍ من كف لوثها القدر",103,"ر",1,0],["ما لقينا من شر دنيا فلا كانت","ولا كان جودها والعطاء",104,"ا",2,0],["ما لقومي عِزينَ أحزاب شتى","في شريط يشكو إليهم مقصه",105,"ص",2,0],["ما لقلبي على التغنج صبر","حين هزت بغنجها أعماقه",106,"ق",2,0],["مالَ قلبي في الهوى زمنا","فأضاعَ النفسَ والبدنا",107,"ن",2,1],["مال قلبي لهواه فاستهاما","فبكى الوجد زمانا وتنامى",108,"م",2,1],["مالقيت فوصولي لغير قبري وصول","ولا عرفت فحياتي مثل عرفي الجهل",109,"ل",1,0],["‏ما لقلبي من حياةٍ","إن أبَتْ ليلاي وِرْدَهْ‏",110,"د",2,0],["ما لقلبٍ ضجَّ شوقًا سلوةٌ","كيف يسلو المرءُ عن ذكْرى بنيهْ !",111,"ي",2,0],["مالقى فمّي لصرخاته شدق",".ومالقى حلمي لنجماته عتيم",112,"م",1,0],["ما لقلبي يتمنى","صحبةً منك وذخْرَا",113,"ر",2,0],["ما لقيت بحال قلبك لكبير","ولا فذوقك فنان",114,"ن",1,0],["مالقيت في محبته ارتياح","مانبي فرقاه لكن حدنا",115,"ن",2,0],["ما لِقلبِ الصَّبِّ فَرْحٌ","إنْ رأَي بالعِشقِ جَهلَكْ",116,"ك",1,0],["ما لقت غير أنا من بين كل الحشود","ترسل سهامها اللي ، ماتحاشيتها",117,"ت",3,0],["ما لقلبي كلَّما أشعلتُ نارًا في الجوانحْ","جرَّني مصباحُ ليلٍ أطفأوا منهُ المكابحْ",118,"ح",1,1],["ما لقومٍ إذا تفكررتُ فيهمْ","لا يكادونَ يفقهونَ حديثا",119,"ث",2,1]]}