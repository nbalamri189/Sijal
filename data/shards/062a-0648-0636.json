oetsgate.com/ViewPoem.aspx?id=183045",""],[5431,"أشهد","https://www.poetsgate.com/ViewPoem.aspx?id=185789",""],[5431,"لتعدمه الشفاه بلا رصاص...","https://www.poetsgate.com/ViewPoem.aspx?id=201132",""],[5431,"الى حيّ الميدان الدمشقي...","https://www.poetsgate.com/ViewPoem.aspx?id=202358",""],[5725,"شيخ المتظاهرين","https://www.poetsgate.com/ViewPoem.aspx?id=198883",""],[5736,"شفاه البوح","https://www.poetsgate.com/ViewPoem.aspx?id=208495",""],[5771,"جثامين","https://www.poetsgate.com/ViewPoem.aspx?id=189432",""],[5776,"فراغُ الفهارس","https://www.poetsgate.com/ViewPoem.aspx?id=199333",""],[6187,"آتٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82159&r=&rc=3",""]],"verses":[["تَوَضَّحنَ في قَرنِ الغَزالَةِ بعَدمَا","تَرَشَّفنَ دِرَّاتِ الذِهابِ الرَكائِكِ",0,"ك",1,0],["تَوَضَّحَ في وَجهِ الصِبا مَبسِمٌ","وَأَشرَقَ في لَيلٍ مِنَ الشَيبِ كَوكَبُ",1,"ب",1,0],["تَوَضَّحْنَ في عَلياءِ قَفْرِ كَأَنَّها","مَهاريقُ فَلُّوحٍ يُعَرِّضْنَ تَاليَا",2,"ي",2,0],["توضح للورودِ سبيل عزمي","إِليه فحيث تفرج لي الصفوفُ",3,"ف",1,0],["تَوضَّح في الدَهرِ البَهيم كَأَنَّه","سَنا غُرَّةٍ سالَت عَلى وَجه أَدهَم",4,"م",1,0],["توضَّحوا في دياجيكم بطاعتهِ","فهي الصباحُ ولقياه التباشيرُ",5,"ر",1,0],["توضّح في الدجى طرف ضرير","سناً بلوى الصريمة يستطير",6,"ر",1,1],["توضا على اطرافه ذا مفاده","وها ذاك في الانجيل فابهج بذى الخير",7,"ر",1,0],["توضح من سر الخطوط خفيّها","وينطق قبل اللفظ خطك بالمعنى",8,"ن",2,0],["تَوضأ بِماء الغَيب وَاغسل بسره","عَن القَلب غين العَين أَو درن الرجس",9,"س",1,0],["توضؤا بغيوث النور وانغمسوا","في جدول من شعاع الله واغتسلوا",10,"ل",3,0],["توضح بالميراث كل مشكل","حاربه الآخر مثل الأول",11,"ل",1,0],["تَوَضَّحنَ في عَلياءِ قَفرٍ كَأَنَّها","مَهارِقُ فَلّوجٍ يُعارِضنَ تالِيا",12,"ي",2,1],["توضأ قلبي بماء الهوى","وأدّى لحبّك فرضَ الجوى",13,"ا",1,1],["تَوَضَّأَ زَمْزَمًا عَرَقًا","تَلأْلأَ وَجْهُهُ فَجْرَا",14,"ر",2,0],["تُوَضِّئُ الحَرْفَ مِنْ عِشْقِي تُطَهِّرُهُ","فينطقُ الحرفُ أذكارًا لهَا عَجَبُ",15,"ب",1,0],["تَوَضَّأَ الْحَرْفُ صَلَّى فَي قَدَاسَتِهَا","يَتْلُوا هُنَا ...وَهُنَا تَصْحُو أَفَانِيْنِيْ",16,"ن",2,0],["تَوَضَّأَ النُّورُ مِنْ مِشْكَاةِ مُهْجَتِنَا","للْشعْرِ يتْلُو مَغَ الأسْفَارِ صَدَّاحُ",17,"ح",1,0],["تَوَضَّأَ الْحَرْفُ مِنْ دَمْعِيْ ، وَمِنْ مُهَلِيْ","فِيْ قُدْسِ عَيْنَيْكِ صَلَّى الْحَرْفُ وَالْفِكَرُ",18,"ر",1,0],["تَوَ ضَّأَ شَوْقِيْ مِنْ مَفَاتِنِ سِحْرِهَا","وَرَفَّ سَنَا شَمْسِيْ ، وَرَاحَ يُكَبِِّرُ",19,"ر",1,0],["تَوَضَّأ عِشقِيْ بِنَجَوَى سَنَاهَا","وَصَلَّتْ عُيُونِيْ ليَوْم جَدِيْدَهْ",20,"د",2,0],["تَوضَّأ مِن جُمُوحكِ من عَذَابِي","وصلَّى فِي مَحارِيبِي وَصَاما",21,"م",2,0],["توضَّأ بالصمتِ ليلُ اشتياقي","وأدّى صلاةَ الهوى بالرّسائلْ",22,"ل",1,0],["توضأ بالدماء عراق اهلي","وبالشهداء من فقْدٍ تيمَّمْ",23,"م",1,1],["توضأ بالدماء عراقُ قلبي","وبالشهداء من أهلي تيَّممْ",24,"م",1,1],["توضّأ القلب من ذكراك واتَّشحَتْ","أرض الحروف بلون العزِّ والقُشُبِ",25,"ب",1,0],["توضأ بالدماء وقام صلى","كذات العهر صامت في الجماع",26,"ع",1,1],["توضأتِ المشاعر من رضابٍ","وجئن الحج ..للتطوافِ جئنا",27,"ن",2,0],["توضأ من شفاهك ذات جنْحٍ","وصلى كي يظلّ بلا خلاصِ",28,"ص",1,0],["توضأ من ماء اشتياقي مبّكرا","ورتّل أسفار العشيّات طيره",29,"ر",2,0],["توضأت بالماء الطهور ميمما","بوجهي لدحر الظلم بالصلواتِ",30,"ت",1,0],["توضأت الحروف بماء عيني","وكم رويت قواف من سفوحي",31,"ي",1,0],["توضأ قبل الموتِ بالدّمعِ فرحةً","وصلّى علينا الخِلُّ والجارُ والعدو",32,"د",2,0],["توضّأ بالطّين كي يتخفّى","أطالَ الغيابَ لترقى النجائسْ",33,"س",1,0],["توضأت جنح الليل ثم دخلت فى","صلاتى أدعو الله حتى شدا االفجر",34,"ر",1,0]]}