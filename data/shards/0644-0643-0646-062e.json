{"poems":[[53,"لم أخضب الشيب للغواني","https://www.aldiwan.net/poem61979.html","مخلع البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[147,"ما كان قبلك في الزمان الخالي","https://www.aldiwan.net/poem11802.html","الكامل"],[164,"عيد اعاد الله من بركاته","https://www.aldiwan.net/poem58913.html","الكامل"],[164,"كل يحب ولا تصح مودة","https://www.aldiwan.net/poem58944.html","الكامل"],[226,"الشمس خلف الجبال","https://www.aldiwan.net/poem55254.html","المجتث"],[362,"يا ويح من بالمغرب الأقصى ثوى","https://www.aldiwan.net/poem4157.html","الكامل"],[408,"يا واهب الجرد السلاهب","https://www.aldiwan.net/poem46913.html","مجزوء الكامل"],[484,"قالوا حبست فقلت ليس بضائري","https://www.aldiwan.net/poem37597.html","الكامل"],[520,"لو كان ينفع أن تجود بمائها","https://www.aldiwan.net/poem11998.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86905","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38240","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37999","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77654","المتدارك"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133791","المجتث"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53060","الكامل"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126362","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123473","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60905","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107004","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87332","الرجز"],[398,"","https://poetry.dctabudhabi.ae/diwan/poem/88162","الكامل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146350","الكامل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115809","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87360","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52996","الكامل"],[4702,"عقلي هناك .. مرثية أخوي","https://www.poetsgate.com/ViewPoem.aspx?id=155210",""],[4869,"غريبه بس تتشابه","https://www.poetsgate.com/ViewPoem.aspx?id=137908",""],[5145,"أرأيت من حملوه للتدفين","https://www.poetsgate.com/ViewPoem.aspx?id=108068",""],[5273,"أضغاث معنى","https://www.poetsgate.com/ViewPoem.aspx?id=192312",""],[5277,"يا سيّدَ الناس","https://www.poetsgate.com/ViewPoem.aspx?id=188104",""],[5318,"لا تلبِسوا الحقَ","https://www.poetsgate.com/ViewPoem.aspx?id=207399",""],[5344,"وداع الشتاء ..","https://www.poetsgate.com/ViewPoem.aspx?id=180698",""],[5410,"همسات ناعمة","https://www.poetsgate.com/ViewPoem.aspx?id=152343",""],[5413,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=209108",""],[5431,"العشاء الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=199488",""],[5447,"خطوة","https://www.poetsgate.com/ViewPoem.aspx?id=208320",""],[5574,"هلْ ثَمَّ مِن بلَلِ؟","https://www.poetsgate.com/ViewPoem.aspx?id=206036",""],[5694,"هذا الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=132092",""],[5720,"كَأَنَّهُ النُّوْرُ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=204787",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5842,"دمشق .. بكّاؤوك كاذبون كاذبون ! .","https://www.poetsgate.com/ViewPoem.aspx?id=146614",""],[5862,"لوحة شقاوة حُ ب ... !!","https://www.poetsgate.com/ViewPoem.aspx?id=34637",""],[5975,"الوفاء لمن أحب","https://www.poetsgate.com/ViewPoem.aspx?id=52984",""],[6113,"ابشر ......","https://www.poetsgate.com/ViewPoem.aspx?id=37064",""]],"verses":[["لكن خضابي على شبابي","لَبِسْتُ من بعده حدادا",0,"د",2,0],["لَكِنَّ خَفْضَ الأَكْثَرِينَ جَنَاَحَهُمْ","رَفَعَ المُلُوكَ وَسَوَّدَ الأَبْطَالاَ",1,"ل",2,0],["لَكِنَّ خَيرَ الناسِ بَعدَ مُحَمَّدٍ","وَأَشَدَّهُم بَأساً بِكُلِّ نِزالِ",2,"ل",1,0],["لكن خصصنا بالتهاني منكما","من أوجب الله ابتغا مرضاتهِ",3,"ت",2,0],["لكن خفى أمر أردت وضوحه","لمَّا خفى لتزول عني الظنة",4,"ه",1,0],["لكن خلقنا وفينا","ميل لهذا النضال",5,"ل",1,0],["لَكِن خَشِيتُ عِقَابَ رَبِّي إِن أنَا","أَحرَقتُ أو أغرَقتُ مَن لَم أخلُقِ",6,"ق",1,0],["لكن خشيتُ بأنّني","عَن فكركَ الميمون عازبْ",7,"ب",1,0],["لكن خرجت ولي عليهم حرة","إذ لم يفز في القصر غير الغادر",8,"ر",1,0],["لكن خطب الموت أصبح علة","قصرت خطى الآمال دون شفائها",9,"ا",3,0],["لَكن خديوي مصرنا","بِالشرع ناه آمر",10,"ر",1,0],["لَكِنَّ خَوفي عَلَيها مِنهُمُ سَببٌ","إِلى زِيارَتِها جنحَ الدّجى سِرّاً",11,"ر",2,0],["لَكِن خُلِقت لِقَهرِهِم وَلِذَبحِهم","فَلِقَهرِهم لا شكّ أَنتَ مُرادُ",12,"د",1,0],["لَكن خُد لَك فرع مُساوي","يحمل شَهرين وَيستَلقي",13,"ق",2,0],["لكن خلف ضلوعي","نوراً يغور ويمسي",14,"س",2,0],["لكن خلائق يوسفيّ لم تزل","ألطافها تجري على عاداتها",15,"ت",3,0],["لكن خشيت بأن تقول عواذلي","قد جن هذا الشيخ في هذا الصبي",16,"ب",2,0],["لكن خلاف الأشعري بزعمكم","وكذبتم أنتم على الانسان",17,"ن",1,0],["لكن خرجت لكي تعد الزاد لل","أخرى فجئت بأقبح الخسران",17,"ن",1,0],["لكن خلافٌ سادَ بين حُماتِها","وقفت له حيناً وقوفَ مُفنِّدِ",18,"د",1,0],["لكِنْ خلوتَ وحَشو أرضك نسوةٌ","فوَقعت بين بيوتهم تتغزلُ",19,"ل",1,0],["لكن خفيت على العيون لفرط ما","أبلى الهوى جسمي به وبلاني",20,"ن",2,0],["لَكنَّ خُذ حَذرَكَ مِن سلامَه","وَبَنَاتِهَا فَتَحظَ بالسلامَه",21,"ه",1,0],["لكِن خشيتُ عَلى الرُواةِ سَأمةً","فَقَصَدتُ ايجازاً عَلى اِهذاب",22,"ب",1,0],["لكنْ خُلِقْنا في زمانٍ جاهلٍ","بمواضع الإصلاح والإفساد",23,"د",1,0],["لكنّ خصركَ مثل جسمى ناحلٌ","فكلاهما متخالفان على الضُنى",24,"ن",2,0],["لَكِنَّ خيرهما الَّتي فيها رضى ال","باري فتلك مراحمٌ من قُدسِهِ",25,"س",2,0],["لكن خديو مصرنا","بالشرع ناهٍ آمر",26,"ر",1,0],["لكن خلك وجاوبني وانا اجيب","اعْواي همّ وحزن وعْواك عشاك",27,"ك",1,0],["لكن خذاه الزمان بصحبة غيابه","شفني رميت الغياب ورحت بغيابي",28,"ب",2,0],["لكن خشيت عليه من لوعاته","وكذا يكون فؤاد كلّ حزين",29,"ن",1,0],["لكنَّ خَمرَ الحالمينَ مِزاجُهُ","بعدَ الشّرابِ يزيدُ فيكَ تَفَكُّرا",30,"ر",2,0],["لكنَّ خيرَ غرامٍ ما بهِ اجتمعتْ","عبارةُ الوصلِ دونَ السقمِ والهوسِ",31,"س",1,0],["لكنَّ خالقه يقضي بحكمتهِ","أن ينصرَ الحقَّ والطاغوتَ أفناه",32,"ا",2,0],["لكن خطاي اني أحسّبك شفقان","لمواصلي والوقت جالس يقيدك",33,"ك",1,0],["لكنّ خوفي دائمٌ لتقىً","في نورِ شرعِ الله يأتمر",34,"ر",1,0],["لكن خوفي من غيابكِ كلما","انفلق الحنينُ يمد قلبي\"الشنفرى\"",35,"ر",2,0],["لكنّ خنجر مكرهم يمشي على","حُقب الزمان محاذرا يتربصُ",36,"ص",1,0],["لكنْ خُطفنا وعندَ الخطفِ لا شِعْرٌ","فالأرضُ تُنهَى وراوي الأرضِ يُغتالُ",37,"ل",1,0],["٤- لكنَّ خشْيتَها هجْرٌ بلا أمَدٍ","فيهِ تُدكُّ صَياصي بارقِ الأملِ",38,"ل",1,0],["لكن خل النفس دايم قنوعه","عقب اختلاط الحب دخنه وبره",39,"ر",2,0],["لٰكِنَّ خِلْقَتَهُ فِيْ أَصْلِهَا كَمُلَتْ","كَمَا لِآدَمَ ( طِيْنَا ) هَٰكَذَا فِيْنَا",40,"ن",2,0],["لكن خير الخلق نال محبة","فهو المقرب في السما محمود",41,"د",1,0],["لكنْ خسئتمْ ، شعبنا هذا أَغَرْ","صعبُ المراس ولن يُساق لكم أسيرْ",42,"ر",1,0],["لكن ( خفوقي ) يبقى صاين ( ثمينك )","مادام عهده ف الوفا يرسم : ضْمان",43,"ن",1,0],["لكن خطوبُ الدهرِ صدّت بيننا","وتحكُّمُ الأقدارِ يبقى المجرما",44,"م",2,0],["لكن خساره وش تبيني أسميك","ذبحتني واقفيت عني بسهوله",45,"ل",2,0]]}