{"poems":[[57,"يا كثير الألوان ما أجفاكا","https://www.aldiwan.net/poem26202.html","الخفيف"],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[159,"رب ليل مازلت ألثم فيه","https://www.aldiwan.net/poem55724.html","الخفيف"],[214,"راح يرنو مرنح الاعطاف","https://www.aldiwan.net/poem13327.html","الخفيف"],[287,"يا رفيقي إن كنت نعم الرفيق","https://www.aldiwan.net/poem32689.html","الخفيف"],[287,"أيها الحاديان حثا العيسا","https://www.aldiwan.net/poem32729.html","الخفيف"],[303,"عجبت للبحر يطغى ثم ينقبض","https://www.aldiwan.net/poem36837.html","البسيط"],[303,"ساجع حن إلى ذات جناح","https://www.aldiwan.net/poem36843.html","عموديه"],[310,"ما بدر وجهك كالبدور إذا اتسق","https://www.aldiwan.net/poem56450.html","الطويل"],[382,"أسلاف سلامكم أم خطاب","https://www.aldiwan.net/poem66943.html","الخفيف"],[385,"مسني الضر من صدودك عني","https://www.aldiwan.net/poem49257.html","الخفيف"],[435,"رشف المجد بالمسرة كاسه","https://www.aldiwan.net/poem39875.html","الخفيف"],[438,"لم يطق هواه فباحا","https://www.aldiwan.net/poem12581.html","المديد"],[438,"نعم هو البرق على الأنعم","https://www.aldiwan.net/poem12720.html","السريع"],[505,"كم نشرنا من طامس وطوينا","https://www.aldiwan.net/poem37722.html","الخفيف"],[563,"بدر تم لاح في الغسق","https://www.aldiwan.net/poem34335.html","المديد"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86921","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86615","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87272","الرمل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39072","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64175","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38704","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38338","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38909","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38937","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38992","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38336","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96696","الرمل"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111172","المتدارك"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216709",""],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56625","السريع"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115988","الخفيف"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136783",""],[264,"","https://poetry.dctabudhabi.ae/diwan/poem/83710","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78009","الكامل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101582","الرمل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95381","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114037","الخفيف"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87813","الرمل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87697","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93870","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94276","المديد"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134194","الرمل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48324","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85009","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40065","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90849","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90870","الرمل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35455","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72520","الرمل"],[4760,"في ذمتي ..","https://www.poetsgate.com/ViewPoem.aspx?id=35830",""],[5072,"في قاعة المناقشة","https://www.poetsgate.com/ViewPoem.aspx?id=53674",""],[5136,"ما بدعة أن جر حيني","https://www.poetsgate.com/ViewPoem.aspx?id=121939",""],[5136,"قمر أهل على الغصون من البكور","https://www.poetsgate.com/ViewPoem.aspx?id=121576",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[309,"يا جَميل إِن سرّ اللَه عَلي الخَلق باق","https://www.poetsgate.com/ViewPoem.aspx?id=42834",""],[5582,"شَغَفَ القَلْبَ اشْتِياقاً وَنَهَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=63549",""],[5957,"بائية التعب","https://www.poetsgate.com/ViewPoem.aspx?id=184977",""]],"verses":[["ما بَدا لي شَخصٌ وَلا سَمِعَت أُذُ","نايَ حِسّاً إِلّا حَسِبتُكَ ذاكا",0,"ك",2,0],["ما بدل القوم في دار ولا جمل","وهم على العهد ما حالوه بالغير",1,"ر",1,0],["مَا بَدا لِي بَدْرٌ مِنَ الوَصْلِ إِلا","كَسَفَتْهُ أَيْدي الفِراقِ بِصَدِّ",2,"د",1,0],["ما بدا الروض يانعاً وشدا من","طائر فوق ايكة هتاف",3,"ف",1,0],["ما بَدَت لِلقُسوسِ في الكَأسِ إِلّا","قَدَّسوها وَصَلَّبَ الجاثَليقُ",4,"ق",1,0],["ما بَدَت لِلقِسّيسِ إِلّا وَأَبدى","لِلإِلَهِ التَسبيحَ وَالتَقديسا",5,"س",2,0],["ما بدَّلتْ يَدُ إنسانٍ محاسنَه","وَلا أقام على أثباجِه عرض",6,"ض",1,0],["ما بدتْ غنّى لها مغتبطاً","فإِنِ استخفتْ شجاها بالنواح",7,"ح",1,0],["ما بَدرُ وَجهكَ كالبدورِ إِذا اِتّسق","في لَيلِ طرّتكَ الّتي تَحكي الغَسَق",8,"ق",1,1],["ما بدورٌ لها الكمال جمالٌ","بليالٍ لها الظلام إهاب",9,"ب",1,0],["ما بَدا لي إِلّا بهت إِلَيهِ","بِعُيوني فَلَيسَ بِطَرف جِفني",10,"ن",2,0],["ما بدا شامسٌ من الأمر إلّا","باقل القليل راض شماسه",11,"س",2,0],["ما بدَتْ في الليلِ إلا وأبدَتْ","لك من قبلِ الصّباحِ صَباحا",12,"ح",2,0],["ما بدأ الإحسانَ فاحتاجَ أن","يقولَ راجيهِ له تمّمِ",13,"م",1,0],["ما بَدَتْ للرِّجالِ رُتْبَةُ قُرْبٍ","ودُنُوِّ إِلاَّ وعنْها ارْتَقَيْنَا",14,"ن",2,0],["ما بدا للكون منشئه","خلف ستر أبيض يقق",15,"ق",1,0],["ما بَدا نجم سَعيد في السَما","أَو سَعى ساع إِلى كسب افتِخار",16,"ر",1,0],["ما بَدَت في سَما العَدالة شَمس","وَتَلاها بَدرٌ أَزال الغَياهب",17,"ب",1,0],["ما بَدا في الأُفق فرقدْ","أَو عَلى الأَغصان غرّدْ",18,"د",1,0],["ما بِدَمي غَيْرُ خَدِّ وَرْدٍ","وإنْ دَهى النَّاسَ وَرْدُ خَدِّ",19,"د",1,0],["ما بدت شَعْرَةٌ يخدَّكَ إلا","قلتُ في ناظريَّ أو في فؤادي",20,"د",2,1],["ما بَدا كَوكَبٌ دُجىً أَو نَهاراً","وَبَدا في الخافِقَينِ مِنهُ ضياءُ",21,"ا",2,0],["ما بَدا البدرُ دُجىً","ماحِياً للسَّدفِ",22,"ف",1,0],["ما بَدا كَوكَبٌ وَما لاحَ بَرقٌ","ما بِرَوضٍ هزَّ الغصونَ الهواءُ",23,"ا",2,0],["ما بَدا قائِلاً بِإِخلاصِ قَلبٍ","خَلَّد اللَّه عَدل هَذا الزّمانِ",24,"ن",1,0],["ما بَدا البَرقُ وَما شَمسُ السّما","قَد رَعَت منها عُيون النّرجِس",25,"س",1,0],["ما بُدورٌ قَد بَدَت","وَالغَزال الأغيَدُ",26,"د",1,0],["ما بدا وانثنى لرائبه إلا","أظهر البان يثمر الأزهارا",27,"ر",2,0],["ما بَدا لي شَخصهُ إلّا وَقَد","هرقَ الأدمع منّي وَسَفك",28,"ك",1,0],["ما بدل من حق المفروض","ولا المسنون ولا عوض",29,"ض",1,0],["ما بَدُّوس العنايف","في اللّي لفاك دخيل",30,"ل",1,0],["ما بدلوا والكون قد بدلا","كأنهم من غير هذا الملا",31,"ل",2,0],["ما بدَا لى من بُرده البدرُ إلاَّ","قُلتُ من فرط حُسنِهِ ما بدَا لى",32,"ل",2,0],["ما بدت شمس على الكون وما","هاجت الألباب بالشدو الحمامه",33,"م",2,0],["ما بدا البدرُ بالكمال وأبدى","مطلعَ النجم في الحمى الشرقيّ",34,"ي",1,0],["ما بدلوا لو بدلوا لعلتهم","بالغيرة العلوية اللأواء",35,"ا",2,0],["ما بدت باريس في هذا السنا","قط لولا حب تجميع النشب",36,"ب",1,0],["ما بدا إلا استهلت فرحاً","آكليه وعلا منها السرور",37,"ر",1,0],["ما بدت حكمة لذي العرش","في كل وجودٍ إلاَّ به أبداها",38,"ا",3,0],["ما بَدَا صبح وجهه لليالي الشَّعر","إلا وقَبّلتَ أقدامه",39,"م",2,0],["ما بدَّلوا ما غيَّروا ما طاولَوا","ما أحدَثوا في الشَّرعن قولاً مُفتَرى",40,"ا",1,0],["ما بَدا لِلعَين إِلّا","هَتن الدَمع اِنسِجاما",41,"م",2,0],["ما بَدَّلَ العلمُ أَخلاقاً بِنا سَفُلت","وَلَم يَزل عالياً فينا الَّذي سفُلا",42,"ل",2,0],["ما بدا في السماء نور هلال","وازدهى كاملاً لدى التتميم",43,"م",1,0],["ما بدور التم قد كلمت","وانتهى حادي المطي إلى",44,"ل",2,0],["ما بدت افراحه تاريخها","بختان النجل حلاَّه كمال",45,"ل",1,0],["ما بَدّلَتْ كلِماتِها إذ قوبِلَتْ","بعواطِفٍ من وصْفِها توْكيدُها",46,"د",3,0],["ما بَدا النيرانُ إِلّا وَقُلنا","هَذِهِ أُختُهُ وَهَذاكَ عَبدَه",47,"د",2,0],["ما بدا إِلّا وَنادى","وجهُهُ يا شمسُ غِيبي",48,"ب",2,0],["ما بدء فاتحة ببسملة جرى","وأتم حسن ختامها تاءمين",49,"ن",1,0],["ما بدا إلا وفي بهجته","قطعت أحشاء ربات الخدور",50,"ر",1,0],["ما بَدا قَطّ لِراءٍ وَلهي","بِالسِوى إِذ هُوَ فَردٌ في الظُهور",51,"ر",1,0],["ما بدورت مبتلى كشتيم وهجر","ما على هذا وذا لي قط صبر",52,"ر",1,0],["مابدلك يا بعدْ كوني وناسي","الاول انته والمحطه الاخيره",53,"ر",2,0],["ما بدأنا لِننْتهي يا ابْنة َ الحُسْ","ن ِ .. الطّموح ُ اسْتغلّنا والحياة ُ",54,"ه",1,0],["ما بدعة أن جر حيني","جزعي فأجرى المقلتين",55,"ن",1,1],["ما بدعة شوقي لواضح طلعة","سفرت سفور أهلة وبدور",56,"ر",1,0],["ما بديع بكى داود قبلي","قد بكى شجوه وقد ناح نوح",57,"ح",1,0],["ما بِدالك فَدَيتك في القَضا وَالمهاق","وَاللقالق وَكثر النقنقة وَالعلاق",58,"ق",1,0],["ما بَدا لِي شَخْصُهُ إِلاَّ وَقَدْ","هَرَقَ الأَدْماءَ مِنِّي وَسَفَكْ",59,"ك",1,0],["ما بداري غير نسناسٍ (1) أتوا","شرعوا التضليل من دون سبب",60,"ب",1,0]]}