{"poems":[[3,"عجبت عبيلة من فتى متبذل","https://www.aldiwan.net/poem108.html",""],[55,"ولقد قلت والهموم ركود","https://www.aldiwan.net/poem26421.html","الخفيف"],[57,"لا يكن ظنك إلا سيئاً","https://www.aldiwan.net/poem24625.html","الرمل"],[42,"ليت شعري عن خليلي ما الذي","https://www.aldiwan.net/poem50429.html","الرمل"],[73,"ما على ظني باس","https://www.aldiwan.net/poem11908.html","مجزوء الرمل"],[73,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[93,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[93,"ويح الفقيرات الجميلات من","https://www.aldiwan.net/poem11136.html","السريع"],[93,"يا ابن لبنان عد إلى لبنان","https://www.aldiwan.net/poem11175.html","الخفيف"],[93,"ملك العراق تجلة وسلام","https://www.aldiwan.net/poem11313.html","الكامل"],[88,"وأن أصدق برق أنت شائمه","https://www.aldiwan.net/poem44810.html","البسيط"],[88,"نعمت الدار للنفيض دارا","https://www.aldiwan.net/poem44999.html","الخفيف"],[47,"المجد بالرقة مجموع","https://www.aldiwan.net/poem25233.html","السريع"],[47,"لأيكم أذكر","https://www.aldiwan.net/poem25261.html","مجزوء المتقارب"],[23,"أجمعت عمرة صرما فابتكر","https://www.aldiwan.net/poem21419.html","الرمل"],[51,"أنى تماطلني وأنت جواد","https://www.aldiwan.net/poem61868.html","الكامل"],[51,"يا أبا أحمد ومثلك لا يغفل","https://www.aldiwan.net/poem61894.html","الخفيف"],[51,"أيها الماجد الذي بهر المداح","https://www.aldiwan.net/poem65475.html","الخفيف"],[51,"لا يكشف الله عن وهب بن إسحاق","https://www.aldiwan.net/poem65708.html","البسيط"],[51,"مدرك عاين أمه","https://www.aldiwan.net/poem66348.html","مجزوء الرمل"],[51,"ناشدتك الله أن تستفسد المننا","https://www.aldiwan.net/poem66517.html","البسيط"],[26,"نام الخلي وبت الليل مشتجرا","https://www.aldiwan.net/poem24088.html","البسيط"],[91,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[89,"أيتها النفس اقترب","https://www.aldiwan.net/poem44672.html","مجزوء الرجز"],[89,"في الفن معنى حسنه لا يعرف","https://www.aldiwan.net/poem44754.html","الكامل"],[45,"ياراكبا سنن الطريق اللاحب","https://www.aldiwan.net/poem11431.html","الكامل"],[45,"أطاع عاذله في الحب إذ نصحا","https://www.aldiwan.net/poem62687.html","البسيط"],[45,"لله عهد سويقة ما أنضرا","https://www.aldiwan.net/poem63603.html","الكامل"],[80,"أمطتك همتك الغريمة فاركب","https://www.aldiwan.net/poem31243.html","الكامل"],[44,"إن بكاء في الدار من أربه","https://www.aldiwan.net/poem30574.html","المنسرح"],[31,"إني ومن أحرم الحجيج له","https://www.aldiwan.net/poem41281.html","المنسرح"],[31,"ذكرتني الديار شوقا قديما","https://www.aldiwan.net/poem41805.html","الخفيف"],[31,"ما على الرسم بالبليين لو","https://www.aldiwan.net/poem42636.html","الخفيف"],[39,"أخبرت ضبة تهجوني لأهجوها","https://www.aldiwan.net/poem53786.html","البسيط"],[40,"حور بعثن رسولا في ملاطفة","https://www.aldiwan.net/poem42344.html","البسيط"],[52,"لا يكن للكأس","https://www.aldiwan.net/poem27180.html","مجزوء الرمل"],[67,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[48,"خبر طرفي بالذي أخفي","https://www.aldiwan.net/poem64401.html","السريع"],[46,"قد حجب النور والضياء","https://www.aldiwan.net/poem22000.html","مجزوء البسيط"],[46,"يأتي الردى ويواري إثلب جسدا","https://www.aldiwan.net/poem22199.html","البسيط"],[46,"خف دنيا كما تخاف شريفا","https://www.aldiwan.net/poem22360.html","الخفيف"],[46,"ألصبح أصبح والظلا","https://www.aldiwan.net/poem23107.html","مجزوء الكامل"],[46,"أصبحت منحوسا كأني ابن مس","https://www.aldiwan.net/poem23183.html","السريع"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85597","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85551","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16626","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54812","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142053","المجتث"],[45,"لله عَهْدُ سَوِيقَةٍ ما أنْضَرَا،","https://www.poetsgate.com/ViewPoem.aspx?id=31338",""],[91,"الطين","https://www.poetsgate.com/ViewPoem.aspx?id=53032",""],[31,"ما عَلَى الرَّسْمِ بالبُلَيَّيْن لَوْ بَيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18767&r=&rc=30",""],[3,"عجبتْ عبيلة ُ منْ فتى ً متبذل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10728&r=&rc=82",""],[125,"لا در درك جعفر يا جعفر","https://www.aldiwan.net/poem23739.html","الكامل"],[136,"لله همة ذا الرئيس فإنها","https://www.aldiwan.net/poem49109.html","الكامل"],[186,"لا يكشف المرء في الحمام عورته","https://www.aldiwan.net/poem14683.html","البسيط"],[226,"معشر القبط يا بني مصر في السر","https://www.aldiwan.net/poem55112.html","الخفيف"],[283,"من مبلغ نجدا ومن بنجد","https://www.aldiwan.net/poem32810.html","الرجز"],[298,"سفرت أميمة ليلة النفر","https://www.aldiwan.net/poem33277.html","أحذ الكامل"],[321,"ما تم أمر بلا سبق إلى قدر","https://www.aldiwan.net/poem61657.html","البسيط"],[329,"يا رفيقي وأنت موحى قصيدي","https://www.aldiwan.net/poem54935.html","الخفيف"],[365,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[404,"مولاي قد أحسنتم","https://www.aldiwan.net/poem33347.html","مجزوء الرجز"],[438,"في طول عمرك عمن قد مضى خلف","https://www.aldiwan.net/poem2602.html","البسيط"],[459,"رحِمت قوما وما مالت رقابهم","https://www.aldiwan.net/poem55985.html","البسيط"],[459,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[480,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[576,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"]],"verses":[["لا يَكتَسي إِلّا الحَديدَ إِذا اِكتَسى","وَكَذاكَ كُلُّ مُغاوِرٍ مُستَبسِلِ",0,"ل",1,0],["لا يَكادُ الهَوى يُفارِقُ صَبّاً","بَل أَراهُ في كُلِّ يَومٍ يَزيدُ",1,"د",1,0],["لا يَكُن ظَنُّكَ إِلّا سَيِّئاً","إِنَّ سوءَ الظَنِّ مِن أَقوى الفِطَن",2,"ن",1,1],["لا يَكُن بَرقُكَ بَرقاً خُلَّباً","انَّ خَيرَ البَرقِ ما الغَيثُ مَعهُ",3,"ع",2,0],["لا يَكُن عَهدُكَ وَرداً","إِنَّ عَهدي لَكَ آسُ",4,"س",1,0],["لا يَكُن قَصرُكَ الجَفاءَ فَإِنَّ الوُدَّ","إِن ساعَدَت حَياتي قَصري",5,"ر",2,0],["لأيكم أحسن في رده","جائزة تأتي على ورده",6,"ه",1,0],["لا يَكْبُرُ الدَّهْرُ بِأَحْدَاثِهِ","يَوْماً عَلَى هِمَّتِهِ الكَابِرَهْ",7,"ر",2,0],["لا يَكُنْ بَيْنَكُمْ لِخِدْمَتِهَا غَيْ","رُ الوَفِيِّ السَّمَيْذَعِ المِعْوَانِ",8,"ن",1,0],["لا يَكْذِبُ العِظَمُ المَخِيلُ وهَاشِمٌ","وَبَنُوهُ مِنْ الزَّمَانِ عِظَامُ",9,"م",1,0],["لا يكسب النفس ما ترجوه من شرف","إلا الإباء وإلا العز والشمم",10,"م",1,0],["لا يكن منك في الذي قلت شكٌ","وإذا شئت فانظر الآثارا",11,"ر",2,0],["لا يَكمُلُ السُؤدُدُ في ماجِدٍ","لَيسَ لَهُ عَودٌ وَمَرجوعُ",12,"ع",1,0],["لِأَيِّكُمُ أَذكُرُ","وَفي أَيِّكُم أَفكِرُ",13,"ر",1,1],["لا يَكُن حُبُّكَ هَذا ظاهِراً","لَيسَ هَذا مِنكَ يا عَمرَ بِسِر",14,"ر",1,0],["لا يكبُرَنَّ عليك في جَنْبِ العُلا","ما قد سألتُك فالعلا أطْوادُ",15,"د",1,0],["لا يكوننَّ ما رجَوْتَ من الدِّي","مَة والوبل منه برقاً ورعدا",16,"د",2,0],["لا يكن حسرة نداك على النف","س فأقنى الغنى وأرضى الكفافا",17,"ف",2,0],["لا يكوننَّ ما سمعناه من جو","دك في كل محفل إرجافا",17,"ف",2,0],["لا يكشف الله عن وهب بن إسحاقِ","من البلاء سماء ذات إطباقِ",18,"ق",1,1],["لا يكن أمركَ يا هَ","ذا على قلبكَ غُمَّهْ",19,"م",2,0],["لا يَكتُبَنَّ على وجهي حجابُكمُ","مَنِ اغتدى مُستزيداً راح ممتحَنا",20,"ن",2,0],["لا يُكرَمونَ كَريماتِ المَخاضِ وَأَن","ساهُم عَقائِلَها جوعٌ وَتَرزيحُ",21,"ح",1,0],["لا يَكُن لِلخِصامِ قَلبَكَ مَأوىً","إِنَّ قَلبي لِلحَبيبِ أَصبَحَ مَعبَد",22,"د",1,0],["لا يكذب الصبح الذي","اضواؤه ذات صبب",23,"ب",1,0],["لا يكتفي منك العراق بزورة","فيود لها ثنيتها تستأنف",24,"ف",1,0],["لايَكثُرَنَّ عَلَيكَ أَمري إِنَّني","لا أَجعَلُ الإِفضالَ ضَربَةَ لازِبِ",25,"ب",1,0],["لا يَكفَهِرُّ إِذا اِنحازَ الوَقارُ بِهِ","وَلا تَطيشُ نَواحيهِ إِذا مَزَحا",26,"ح",2,0],["لا يَكمُلُ القَسمُ الَّذي أوتيتَهُ","حَتّى تَلَذَّ العَينُ مِنهُ مَنظَرا",27,"ر",2,0],["لا يكذبُ الإِنسانَ رائدُ عَقلهِ","فامْرُرْ تُمَجّ وكنْ عذوباً تُشْرَبِ",28,"ب",1,0],["لا يُكمِنُ الغَدرَ لِلصَديقِ وَلا","يَخطو اِسمَ ذي وُدِّهِ إِلى لَقَبِه",29,"ب",2,0],["لا يَكُنِ البُخلُ لي وُجودُكُمُ","يَوماً لِغَيري وَأَنتُمُ شَجَني",30,"ن",2,0],["لا يَكونَنَّ آخِرَ العَهدِ هَذا","يا اِبنَ عَمّي وَلا تُطيعَن نَموما",31,"م",2,0],["لا يُكَثِّرنَ في الحَديثِ وَلا يَت","بَعنَ يَنعَقنَ بِالبِهامِ الظِرابا",32,"ب",2,0],["لا يَكثُرونَ وَإِن طالَت حَياتُهُمُ","وَلا تَبيدُ مَخازيهِم إِذا بادوا",33,"د",3,0],["لا يَكسِرُ الطَرفَ نَظّارٌ يُقالُ بِهِ","مِن حِدَّةِ الطَرفِ لاستِيناسِهِ لَمَمُ",34,"م",1,0],["لا يَكُن لِلكَأسِ في كَف","فَيكَ يَومَ الغَيمِ لَبثُ",35,"ث",1,1],["لا يَكْتُبُونَ وُصُولاتٍ عَلَى جِهَةٍ","مُفَصَّلاتٍ بأسمَاءٍ وَنَبِيِينِ",36,"ن",1,0],["لا يَكتُمُ الطَرفُ هَوى عاشِقٍ","لَكِنَّما يُفشيهِ بِالذَرفِ",37,"ف",1,0],["لا يَكذِبَنَّ اِمرُؤٌ جَهولٌ","ما فيكَ لِلَّهِ أَولِياءُ",38,"ي",3,0],["لا يَكتَسونَ قَميصاً في دِيارِهِمُ","كَالأَرضِ لَم تُكسَ مِن نَبتٍ بِأَسلابِ",39,"ب",1,0],["لا يَكادُ الفَتى يُجَهَّزُ إِلّا","عَن بَديلٍ مَكانَهُ مُستَنابِ",40,"ب",1,0],["لا يَكذِبَنَّ مُؤَجَّلٌ","ما سالِمٌ إِلّا كَهالِك",41,"ك",1,0],["لا يَكذِبِ الناسُ عَلى رَبِّهِم","ما حُرِّكَ العَرشُ وَلا زُلزِلا",42,"ل",2,0],["لا يَكُن حُبُّكِ داءً قاتِلاً","لَيسَ هَذا مِنكِ ماوِيَّ بِحُر",43,"ر",1,0],["لا يكبر الشعر مالم تُبق روعتُه","في نفس سامعه شيئاً من الأثر",44,"ر",1,0],["لا يكبر الناس في عصر نعيش به","من لم يجادل ولم ينفع ولم يضر",44,"ر",1,0],["لا يكسب المرء علماً من عمامته","إن الجهول جهول كيفما كانا",45,"ن",2,0],["لا يَكْذِبُ المُقْسِمُ في قولِه","إنّ الغِنى مِن يَدِهِ يُقْسَمُ",46,"م",1,0],["لاَ يَكْرُثُ الرِّئْبَالَ أَنْ يُمْنَى وَقَدْ","مُنِعَ العَرِينُ بِصَرْعَةِ الرِّئْبَالِ",47,"ل",1,0],["لاَ يَكُنْ بَيْنَكُمْ سِوَى مَا عَرِفْنَا","قِدَمَا مِنْ مَحَبَّةٍ وَوَدَادِ",48,"د",1,0],["لاَ يكرُثَنَّكَ أَنَّ وَحْدَتَهُ","صُدِعَتْ وَكَانَ بِرَأْبِهَا أَحْرَى",49,"ر",2,0],["لا يكرِمُ الله شعباً","لا يكرِمُ الآدابا",50,"ب",2,0],["لا يَكْمُلُ القِسْمُ الذي أُوتيتَهُ،","حتّى تَلَذّ العَينُ فيهِ مَنظَرَا",51,"ر",2,0],["لايكن للخصام قلبك مأوى","إنّ قلبي للحبّ أصبح معبد",52,"د",1,0],["لا يكقرنَ في الحديث، ولا يت","بعنَ، ينعقنَ بالبهام، الظرابا",53,"ب",2,0],["لايكتسى الاَّ الحديدَ إذا اكتسى","وكذلكَ كلُّ مغاور مستبسل",54,"ل",1,0],["لا يكذبون ولا تبور فعالهم","ولقلما ظهروا بما لم يضمروا",55,"ر",3,0],["لا يكتفي بسواه معتمد على","خبر فنفس المرء أصدق مخبر",56,"ر",1,0],["لا يكشفُ المرءُ في الحَمّامِ عَوْرتَه","إلا لحالَيْن فَقْدِ العقلِ والدينِ",57,"ن",1,1],["لا يَكُن بَعضُنا لِبَعضٍ عدُوّاً","لعنَ اللَهُ مُستَبيحي العِداءِ",58,"ا",2,0],["لا يَكنِدُ الكِندِيُّ فَضلَ مِثلِها","أَعني اِمرَأَ القَيسِ بنَ حُجرِ الكِندي",59,"د",2,0],["لا يكذبنَّ الحُبُّ أَليقُ بي","وبشيمَتي من سُبَّةٍ الغَدرِ",60,"ر",1,0],["لا يَكرَهُ المَرءُ شَيئاً ساءَهُ فَعَسى","يَكونُ خَياراً لَهُ في زِيِّ ذي ضَرَرِ",61,"ر",1,0],["لا يكن لحنك البديع نواحا","دائما وانطلق بحلو النشيد",62,"د",1,0],["لا يكُ مِن كُلِّ عُلاه قانعاً","فتيً بأنْ قيل كريم المنتَسَب",63,"ب",1,0],["لا يكمل الأنس لنا","بغيركم ولا المنى",64,"ن",2,0],["لا يكمل الدين إلا في محبتكم","وليس يوجد فيما قلت مختلفُ",65,"ف",1,0],["لا يُكسبان بتقليدٍ ولا أدبٍ","ولايفيدهما علمٌ ولا عملُ",66,"ل",1,0],["لا يكن آخِرَ عهدِي بِكُمُ","يا وُلاةَ القلبِ ليلاتُ القليبِ",67,"ب",1,0],["لا يكون المرء فيها رجلا","وهو ذو رأس بها منكس",68,"س",1,0],["لا يُكْسَبُ المجدُ إِلاَّ من مَكارِمه","ويُقْبَس الفضلُ إِلاَّ من سَجيَّته",69,"ت",2,0]]}