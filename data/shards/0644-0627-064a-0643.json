","https://www.poetsgate.com/ViewPoem.aspx?id=182539",""],[5956,"إنْ تَرجعِ الشامَ يا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183700",""],[5956,"بصخرِ العز","https://www.poetsgate.com/ViewPoem.aspx?id=192333",""],[5956,"صور إيمانية","https://www.poetsgate.com/ViewPoem.aspx?id=192502",""],[5956,"من فضائل الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=192552",""],[5956,"يا خادم الله","https://www.poetsgate.com/ViewPoem.aspx?id=194565",""],[5956,"إنْ ترجِعِ الشامَ يا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=196801",""],[5956,"إلى كل بطل مجهول","https://www.poetsgate.com/ViewPoem.aspx?id=202506",""],[5975,"عذّبيني","https://www.poetsgate.com/ViewPoem.aspx?id=53252",""],[6093,"واسِ قصيدي أبا بدرٍ وأسرتَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=176507",""],[6152,"النسيان سلوان","https://www.poetsgate.com/ViewPoem.aspx?id=213177",""],[6191,"ما لن يكتب عنِ المسيحِ الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88108&r=&rc=6",""],[6277,"نَوَرٌ نسميهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64476&r=&rc=39",""]],"verses":[["لا يَكتَسي إِلّا الحَديدَ إِذا اِكتَسى","وَكَذاكَ كُلُّ مُغاوِرٍ مُستَبسِلِ",0,"ل",1,0],["لا يَكادُ الهَوى يُفارِقُ صَبّاً","بَل أَراهُ في كُلِّ يَومٍ يَزيدُ",1,"د",1,0],["لا يَكُن ظَنُّكَ إِلّا سَيِّئاً","إِنَّ سوءَ الظَنِّ مِن أَقوى الفِطَن",2,"ن",1,1],["لا يَكُن بَرقُكَ بَرقاً خُلَّباً","انَّ خَيرَ البَرقِ ما الغَيثُ مَعهُ",3,"ع",2,0],["لا يَكُن عَهدُكَ وَرداً","إِنَّ عَهدي لَكَ آسُ",4,"س",1,0],["لا يَكُن قَصرُكَ الجَفاءَ فَإِنَّ الوُدَّ","إِن ساعَدَت حَياتي قَصري",5,"ر",2,0],["لأيكم أحسن في رده","جائزة تأتي على ورده",6,"ه",1,0],["لا يَكْبُرُ الدَّهْرُ بِأَحْدَاثِهِ","يَوْماً عَلَى هِمَّتِهِ الكَابِرَهْ",7,"ر",2,0],["لا يَكُنْ بَيْنَكُمْ لِخِدْمَتِهَا غَيْ","رُ الوَفِيِّ السَّمَيْذَعِ المِعْوَانِ",8,"ن",1,0],["لا يَكْذِبُ العِظَمُ المَخِيلُ وهَاشِمٌ","وَبَنُوهُ مِنْ الزَّمَانِ عِظَامُ",9,"م",1,0],["لا يكسب النفس ما ترجوه من شرف","إلا الإباء وإلا العز والشمم",10,"م",1,0],["لا يكن منك في الذي قلت شكٌ","وإذا شئت فانظر الآثارا",11,"ر",2,0],["لا يَكمُلُ السُؤدُدُ في ماجِدٍ","لَيسَ لَهُ عَودٌ وَمَرجوعُ",12,"ع",1,0],["لِأَيِّكُمُ أَذكُرُ","وَفي أَيِّكُم أَفكِرُ",13,"ر",1,1],["لا يَكُن حُبُّكَ هَذا ظاهِراً","لَيسَ هَذا مِنكَ يا عَمرَ بِسِر",14,"ر",1,0],["لا يكبُرَنَّ عليك في جَنْبِ العُلا","ما قد سألتُك فالعلا أطْوادُ",15,"د",1,0],["لا يكوننَّ ما رجَوْتَ من الدِّي","مَة والوبل منه برقاً ورعدا",16,"د",2,0],["لا يكن حسرة نداك على النف","س فأقنى الغنى وأرضى الكفافا",17,"ف",2,0],["لا يكوننَّ ما سمعناه من جو","دك في كل محفل إرجافا",17,"ف",2,0],["لا يكشف الله عن وهب بن إسحاقِ","من البلاء سماء ذات إطباقِ",18,"ق",1,1],["لا يكن أمركَ يا هَ","ذا على قلبكَ غُمَّهْ",19,"م",2,0],["لا يَكتُبَنَّ على وجهي حجابُكمُ","مَنِ اغتدى مُستزيداً راح ممتحَنا",20,"ن",2,0],["لا يُكرَمونَ كَريماتِ المَخاضِ وَأَن","ساهُم عَقائِلَها جوعٌ وَتَرزيحُ",21,"ح",1,0],["لا يَكُن لِلخِصامِ قَلبَكَ مَأوىً","إِنَّ قَلبي لِلحَبيبِ أَصبَحَ مَعبَد",22,"د",1,0],["لا يكذب الصبح الذي","اضواؤه ذات صبب",23,"ب",1,0],["لا يكتفي منك العراق بزورة","فيود لها ثنيتها تستأنف",24,"ف",1,0],["لايَكثُرَنَّ عَلَيكَ أَمري إِنَّني","لا أَجعَلُ الإِفضالَ ضَربَةَ لازِبِ",25,"ب",1,0],["لا يَكفَهِرُّ إِذا اِنحازَ الوَقارُ بِهِ","وَلا تَطيشُ نَواحيهِ إِذا مَزَحا",26,"ح",2,0],["لا يَكمُلُ القَسمُ الَّذي أوتيتَهُ","حَتّى تَلَذَّ العَينُ مِنهُ مَنظَرا",27,"ر",2,0],["لا يكذبُ الإِنسانَ رائدُ عَقلهِ","فامْرُرْ تُمَجّ وكنْ عذوباً تُشْرَبِ",28,"ب",1,0],["لا يُكمِنُ الغَدرَ لِلصَديقِ وَلا","يَخطو اِسمَ ذي وُدِّهِ إِلى لَقَبِه",29,"ب",2,0],["لا يَكُنِ البُخلُ لي وُجودُكُمُ","يَوماً لِغَيري وَأَنتُمُ شَجَني",30,"ن",2,0],["لا يَكونَنَّ آخِرَ العَهدِ هَذا","يا اِبنَ عَمّي وَلا تُطيعَن نَموما",31,"م",2,0],["لا يُكَثِّرنَ في الحَديثِ وَلا يَت","بَعنَ يَنعَقنَ بِالبِهامِ الظِرابا",32,"ب",2,0],["لا يَكثُرونَ وَإِن طالَت حَياتُهُمُ","وَلا تَبيدُ مَخازيهِم إِذا بادوا",33,"د",3,0],["لا يَكسِرُ الطَرفَ نَظّارٌ يُقالُ بِهِ","مِن حِدَّةِ الطَرفِ لاستِيناسِهِ لَمَمُ",34,"م",1,0],["لا يَكُن لِلكَأسِ في كَف","فَيكَ يَومَ الغَيمِ لَبثُ",35,"ث",1,1],["لا يَكْتُبُونَ وُصُولاتٍ عَلَى جِهَةٍ","مُفَصَّلاتٍ بأسمَاءٍ وَنَبِيِينِ",36,"ن",1,0],["لا يَكتُمُ الطَرفُ هَوى عاشِقٍ","لَكِنَّما يُفشيهِ بِالذَرفِ",37,"ف",1,0],["لا يَكذِبَنَّ اِمرُؤٌ جَهولٌ","ما فيكَ لِلَّهِ أَولِياءُ",38,"ي",3,0],["لا يَكتَسونَ قَميصاً في دِيارِهِمُ","كَالأَرضِ لَم تُكسَ مِن نَبتٍ بِأَسلابِ",39,"ب",1,0],["لا يَكادُ الفَتى يُجَهَّزُ إِلّا","عَن بَديلٍ مَكانَهُ مُستَنابِ",40,"ب",1,0],["لا يَكذِبَنَّ مُؤَجَّلٌ","ما سالِمٌ إِلّا كَهالِك",41,"ك",1,0],["لا يَكذِبِ الناسُ عَلى رَبِّهِم","ما حُرِّكَ العَرشُ وَلا زُلزِلا",42,"ل",2,0],["لا يَكُن حُبُّكِ داءً قاتِلاً","لَيسَ هَذا مِنكِ ماوِيَّ بِحُر",43,"ر",1,0],["لا يكبر الشعر مالم تُبق روعتُه","في نفس سامعه شيئاً من الأثر",44,"ر",1,0],["لا يكبر الناس في عصر نعيش به","من لم يجادل ولم ينفع ولم يضر",44,"ر",1,0],["لا يكسب المرء علماً من عمامته","إن الجهول جهول كيفما كانا",45,"ن",2,0],["لا يَكْذِبُ المُقْسِمُ في قولِه","إنّ الغِنى مِن يَدِهِ يُقْسَمُ",46,"م",1,0],["لاَ يَكْرُثُ الرِّئْبَالَ أَنْ يُمْنَى وَقَدْ","مُنِعَ العَرِينُ بِصَرْعَةِ الرِّئْبَالِ",47,"ل",1,0],["لاَ يَكُنْ بَيْنَكُمْ سِوَى مَا عَرِفْنَا","قِدَمَا مِنْ مَحَبَّةٍ وَوَدَادِ",48,"د",1,0],["لاَ يكرُثَنَّكَ أَنَّ وَحْدَتَهُ","صُدِعَتْ وَكَانَ بِرَأْبِهَا أَحْرَى",49,"ر",2,0],["لا يكرِمُ الله شعباً","لا يكرِمُ الآدابا",50,"ب",2,0],["لا يَكْمُلُ القِسْمُ الذي أُوتيتَهُ،","حتّى تَلَذّ العَينُ فيهِ مَنظَرَا",51,"ر",2,0],["لايكن للخصام قلبك مأوى","إنّ قلبي للحبّ أصبح معبد",52,"د",1,0],["لا يكقرنَ في الحديث، ولا يت","بعنَ، ينعقنَ بالبهام، الظرابا",53,"ب",2,0],["لايكتسى الاَّ الحديدَ إذا اكتسى","وكذلكَ كلُّ مغاور مستبسل",54,"ل",1,0],["لا يكذبون ولا تبور فعالهم","ولقلما ظهروا بما لم يضمروا",55,"ر",3,0],["لا يكتفي بسواه معتمد على","خبر فنفس المرء أصدق مخبر",56,"ر",1,0],["لا يكشفُ المرءُ في الحَمّامِ عَوْرتَه","إلا لحالَيْن فَقْدِ العقلِ والدينِ",57,"ن",1,1],["لا يَكُن بَعضُنا لِبَعضٍ عدُوّاً","لعنَ اللَهُ مُستَبيحي العِداءِ",58,"ا",2,0],["لا يَكنِدُ الكِندِيُّ فَضلَ مِثلِها","أَعني اِمرَأَ القَيسِ بنَ حُجرِ الكِندي",59,"د",2,0],["لا يكذبنَّ الحُبُّ أَليقُ بي","وبشيمَتي من سُبَّةٍ الغَدرِ",60,"ر",1,0],["لا يَكرَهُ المَرءُ شَيئاً ساءَهُ فَعَسى","يَكونُ خَياراً لَهُ في زِيِّ ذي ضَرَرِ",61,"ر",1,0],["لا يكن لحنك البديع نواحا","دائما وانطلق بحلو النشيد",62,"د",1,0],["لا يكُ مِن كُلِّ عُلاه قانعاً","فتيً بأنْ قيل كريم المنتَسَب",63,"ب",1,0],["لا يكمل الأنس لنا","بغيركم ولا المنى",64,"ن",2,0],["لا يكمل الدين إلا في محبتكم","وليس يوجد فيما قلت مختلفُ",65,"ف",1,0],["لا يُكسبان بتقليدٍ ولا أدبٍ","ولايفيدهما علمٌ ولا عملُ",66,"ل",1,0],["لا يكن آخِرَ عهدِي بِكُمُ","يا وُلاةَ القلبِ ليلاتُ القليبِ",67,"ب",1,0],["لا يكون المرء فيها رجلا","وهو ذو رأس بها منكس",68,"س",1,0],["لا يُكْسَبُ المجدُ إِلاَّ من مَكارِمه","ويُقْبَس الفضلُ إِلاَّ من سَجيَّته",69,"ت",2,0],["لا يكتفي بمديحِ فضلكَ شاعرٌ","لو خطَّ احرفهُ بألفِ مجلَّدِ",70,"د",1,0],["لا يكسر الناس ما شدوا جبائره","وليس يجبر طول الدهر من كسروا",71,"ر",3,0],["لا يكتفي أجراً على صنعه","بربحه الشكر ولا يرتضيهْ",72,"ي",2,0],["لا يكتفي بالود ترعاه له","إلا وأنت له من الزوار",73,"ر",1,0],["لا يكذب القلب الخفوق بكم ولا الْ","جَفنُ الصدوق الفيض في أبنائه",74,"ا",3,0],["لا يكن جودك يا ابن ال","بيض لي بيضة عُقره",75,"ر",2,0],["لا يكادُ الطّويل يبلغُ منه","حيث يثنى من المقصّ العذارُ",76,"ر",1,0],["لا يُكذَبَنَّ فَإِنَّهُ","مَن غابَ غابَ نَصيبُهُ",77,"ب",2,0],["لا يَكْدَحُ الناسُ لَهُنَّ صَفْقا","وَإِنْ هَمَرْنَ بَعْدَ مَعْقٍ مَعْقا",78,"ق",2,0],["لا يَكْدَح الأَعْدَاءُ فِيهِمْ مَكْدَحا","وَلَو أَطاعَا الحاسِدِين انْتَطَحا",79,"ح",2,0],["لا يكن لك مقصد أو مرام","غير ما وجهت إليه ورامت",80,"ت",1,0],["لا يُكثِرونَ وَإِن طالَت حَياتُهُمُ","وَلَو يَبولُ عَلَيهم ثَعلَبٌ غَرِقوا",81,"ق",3,0],["لا يكشف الهمَّ عني حين يطْرقني","إلاّ الدّجى والفلا والبُزَّلُ القُودُ",82,"د",1,0],["لا يَكونُ السَرِيُّ مِثلُ الدَنِيِّ","لا وَلا ذو الذَكاءِ مِثلُ الغَبِيِّ",83,"ي",1,1],["لا يَكونُ الأَلَدُّ ذو المَقولِ المُر","هَفِ عِندَ القِياسِ مِثلُ العَيِيِّ",83,"ي",1,0],["لا يكمل التاج إلا أن يكون له","جيش يشتت شمل الذل تشتيتا",84,"ت",2,0],["لاَ يَكْبُر الذَّنْبُ لَهُمْ","وَلَو غَدَا كَالجَبَلِ",85,"ل",1,0],["لا يُكتَبونَ