https://www.poetsgate.com/ViewPoem.aspx?id=16325",""],[5956,"بسمة ذات إعجاب بموهبتي","https://www.poetsgate.com/ViewPoem.aspx?id=182292",""],[6229,"أمّتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65214&r=&rc=37",""],[6277,"ظلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64482&r=&rc=45",""]],"verses":[["مَا أَظْمَأَ الأَرْضَيْنِ إِنْ لَمْ يَرْوِهَا","مَا تُسْتَدَرُّ شَوَامِخُ الأَعلامِ",0,"م",1,0],["ما أظلت كمثل سؤددك الخض","راء فاسْحب من ذيلِها الفضفاض",1,"ض",1,0],["ما أظهروا عذراً ولا حجبوا قِرىً","إلا رأيتُك تامراً لي لابنا",2,"ن",2,0],["ما أَظُنُّ النَعيمَ فيهِ الَّذي في ال","أَرضِ مِن بَهجَةٍ وَمِن لَألاءِ",3,"ا",2,0],["ما أَظُنُّ المَنونَ تَعلَمُ ماذا","قَصَفَت بَعدَهُ مِنَ الأَصلابِ",4,"ب",1,0],["ما أَظلَمَ الأَهواءَ يَجمَحُ حُكمُها","وَيَرى سَبيلَ العَدلِ شَرَّ سَبيلِ",5,"ل",1,0],["ما أَظلَمَ القَومَ يَجزونَ البِلادَ أَذىً","وَهيَ الحَياةُ وَما تُسدي جَوازيها",6,"ي",3,0],["ما أَظن الميزان يوزن فيه","بعض ما في الحلوى من الأشياء",7,"ا",2,0],["ما أظلم الأيام.. أي غمامة","لا تنجلي ورضيعة لا تُفطم",8,"م",1,0],["ما أَظُنُّ الكَريمَ يَرضى إِذا أَن","عَمَ بَعضي لِبَعضي التَعذيبا",9,"ب",2,0],["ما أظلم الوجود يا عبود","لولا شعاع للمنى يرود",10,"د",1,1],["ما أظهر من شدة وجد شكوى","قد باع لذاذة الكرى بالسهر",11,"ر",1,0],["ما أظمأ الغرسا","في واحة الحب",12,"ب",1,0],["ما أظُنُّ الصَّباحَ حَيًّا فَيُرْجَى","لَكَ يا لَيْلُ في الصَّباحِ البَقاءُ",13,"ا",2,0],["ما أَظهَرَ الشَيبُ إِلّا اللَونَ في كِبَري","كَلَونِ شَيبي وَلَم أَبلُغ إِلى الحُلُمِ",14,"م",1,0],["ما أظن وإن ظنيت ذا صرت مجنون","كيف يرضون من عمرهم مر يعصون",15,"ن",1,0],["ما أَظْهَرَ الباري حقيقةَ فضله","إلاَّ ليظهر قُوَّةَ الإِسلام",16,"م",1,0],["ما أَظُنُّ الزَمانَ يا أُمَّ عَمروٍ","تارِكاً إِن هَلَكتُ مَن يَبكيني",17,"ي",1,1],["ما أَظهرَ اللهُ هذا الفضلَ في بَشَرٍ","إِلاَّ وأُودع سِرّاً في سَريرَته",18,"ت",2,0],["ما أظلم الافق إلا","للدغ سود العقارب",19,"ب",1,0],["ما أَظلمَ الأفق في عيني وَقَد أَفَلَت","شَمسي المنيرةُ عَنّي واِمّحى قَمَري",20,"ر",2,0],["ما أظُنُّ الإلهَ أبْدعَ شخْصاً","مِنْكَ أحلى حالَيْ جَفَاءٍ ولِيْنِ",21,"ن",1,0],["ما أظهروا للبرايا من فَعالِهمُ","إلا المروَّةَ والإنصافَ والكرَما",22,"م",2,0],["ما أظلم الليل البهي","م وضاء للسارين فرقد",23,"د",1,0],["ما أظل الورى بناء سماء","واستقر الورى بأرض مهاد",24,"د",1,0],["ما أظلمت بالنقع غاسقةُ الوغى","إلاَّ تلهَّب سيفهُ فأضاءها",25,"ا",3,0],["ما أظلم الديجور وابيض ال","صباح وخالطا",26,"ط",2,0],["ما أظن المنون تعلم ماذا","دكدكت للعلا من الابراج",27,"ج",1,0],["ما أَظُنُّ النَوى تُسَوِّغُهُ القُر","بَ وَلَم تَمخَضِ المَطِيُّ البِطانا",28,"ن",2,0],["ما أَظهَرَ الرَّأيَ لَدى فكرَةٍ","فيهِ وَما أَكثَرَ جُهّالَه",29,"ل",2,0],["ما أَظلَمَ الدَّهر لَيلي في فِراقِكُمُ","بِلَيلِ وَصلِكُمُ فالطّولُ بِالقِصَرِ",30,"ر",1,0],["ما أظن الأقفاص مهما ادلهمت","تمنع الطير لذة الإنشاد",31,"د",1,0],["ما أظهر للعيون خافي شاني","إلا دمع سكبته من شاني",32,"ي",1,1],["ما أظلمَ الدهرَ المُشِتَّ بأهلِه","لَمْ يرضَ إِلاَّ الأسنةَ مَرْكبا",33,"ب",2,0],["ما أظْمأ الشّوقُ الحَثيثُ بِطاحَها","إلا وغيثُ الدّمْعِ قدْ روّاها",34,"ا",3,0],["ما أظلَم الدَهر في حُكم وَأَعداهُ","عَلى البَرايا كَأَن الناسَ أعداه",35,"ا",2,1],["ما أَظنّ السَير إِلا معرجاً","للسما أَو مهبطاً نحوَ السقرْ",36,"ر",1,0],["ما أظلمت في وجوه الرأي مبهمة","إلا أنار بها من رأيه سرجا",37,"ج",2,0],["ما أظمأ الآمال بعد سميدع","قد كان غوث اللَه للأمل الصدي",38,"د",2,0],["ما أظهرت ريح الصبا","سر الرياض العنبريه",39,"ي",2,0],["ما أظلم الليل من نفع العجاج ضحى","إلا انجلى وجهه كالشمس في الحمل",40,"ل",1,0],["ما أظلم النقع وأسودت غياهبه","إلا وضاءت له فيها شعاعات",41,"ت",1,0],["ما أَظلَمَ النَّاسَ إِن غابُوا وإِن حَضَرُوا","وأَعدَلَ المَوتَ في الحَالَينِ إِن آنا",42,"ن",2,0],["ما أظن تِلقى الإجابة ولا أظن تِلقى المَرام","مُهرتك صارت بِقايا والهوى بَعض الرفيف",43,"ف",1,0],["ما أظلمت بعده الدنيا فعاودها","من نوركم ما به غيم الأسى انقشعا",44,"ع",2,0],["ما اظن يكفيها سوى شوفك بخير","والا عسا ماتشوف من بعدك احباب",45,"ب",1,0],["ما اظن في ليله أنا اتهنيت","خاواني الحرمان من بدري",46,"ر",2,0],["ما أظلمت إلا لتبعث من","ظلماءها الدنيا لك الفجرا",47,"ر",2,0],["ما اظن أنسٍ في الملا","في زينها .. ولا اظن حور",48,"ر",1,0],["ما أظلمَ الشوق والأيامُ سافرةٌ","أهكذا الوجدُ يلهو بي ويضنيني؟",49,"ن",2,0],["ما اظن به حي يسوي سواتي","وحيد بالدنيا وأصارع عفاريت",50,"ت",1,0],["ما أظمأ النّهرينِ للسُّقيَا إذا","جفَّ الغرامُ وعَزَّ ذاكَ المُرتَقَى",51,"ق",2,0],["ما أظمأ الارضينغ لم يروها","ما تستدر شوامخ العلام",52,"م",1,0],["ما أظن الصبح .. يدري iiبالليالي وماأظن الليل يعنيه iiالصباح","وما أظن في يوم قد زارك iiخيالي وماأظنك حاسبٍ عمري اللى iiراح",53,"ح",1,1],["ما أظلمَ الشعرَ كم يجني على شرف","ما كان يَعرِفُ أنَّ الشعرَ يُخْجِلُهُ",54,"ل",2,0],["ما أظلمَ الدارَ تُعشي عينَ ساكنها","عن جلوة الكونِ في إسحاره الجُدُد",55,"د",1,0],["ما أظلم الوجود","ما أظلم الوجود يا عبود",56,"د",1,1]]}