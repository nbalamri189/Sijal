{"poems":[[93,"حيوا الإمام الحق في الإسلام","https://www.aldiwan.net/poem11378.html","الكامل"],[72,"خلع أنشرت زمان الرياض","https://www.aldiwan.net/poem19118.html","الخفيف"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[91,"لو رأى آدم فتاه لزال الحقد","https://www.aldiwan.net/poem8729.html","عموديه"],[66,"يا بدورا تغيب تحت التراب","https://www.aldiwan.net/poem40292.html","الخفيف"],[105,"أبلغ ضيوفك حين يشهد جمعهم","https://www.aldiwan.net/poem43085.html","الكامل"],[105,"هي الحماية هب اليوم داعيها","https://www.aldiwan.net/poem43142.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142033","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[122,"ما أظلم الوجود يا عبود","https://www.aldiwan.net/poem23776.html","الرجز"],[229,"لله فتى مزق ثوب السلوى","https://www.aldiwan.net/poem44550.html","الدوبيت"],[326,"دنياي يا دنياي","https://www.aldiwan.net/poem55040.html","مجزوء الرجز"],[346,"نام من نام وانفردت بهمي","https://www.aldiwan.net/poem19831.html","الخفيف"],[364,"داء ولكنه داء بلا ألم","https://www.aldiwan.net/poem17721.html","البسيط"],[388,"يا علي ماتوا اللي مانباهم يموتون","https://www.aldiwan.net/poem54469.html","عموديه"],[413,"كف الملام فما يفيد ملامي","https://www.aldiwan.net/poem53993.html","الكامل"],[538,"ما أظن الزمان يا أم عمرو","https://www.aldiwan.net/poem56639.html","الطويل"],[573,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"]],"verses":[["مَا أَظْمَأَ الأَرْضَيْنِ إِنْ لَمْ يَرْوِهَا","مَا تُسْتَدَرُّ شَوَامِخُ الأَعلامِ",0,"م",1,0],["ما أظلت كمثل سؤددك الخض","راء فاسْحب من ذيلِها الفضفاض",1,"ض",1,0],["ما أظهروا عذراً ولا حجبوا قِرىً","إلا رأيتُك تامراً لي لابنا",2,"ن",2,0],["ما أَظُنُّ النَعيمَ فيهِ الَّذي في ال","أَرضِ مِن بَهجَةٍ وَمِن لَألاءِ",3,"ا",2,0],["ما أَظُنُّ المَنونَ تَعلَمُ ماذا","قَصَفَت بَعدَهُ مِنَ الأَصلابِ",4,"ب",1,0],["ما أَظلَمَ الأَهواءَ يَجمَحُ حُكمُها","وَيَرى سَبيلَ العَدلِ شَرَّ سَبيلِ",5,"ل",1,0],["ما أَظلَمَ القَومَ يَجزونَ البِلادَ أَذىً","وَهيَ الحَياةُ وَما تُسدي جَوازيها",6,"ي",3,0],["ما أَظن الميزان يوزن فيه","بعض ما في الحلوى من الأشياء",7,"ا",2,0],["ما أظلم الأيام.. أي غمامة","لا تنجلي ورضيعة لا تُفطم",8,"م",1,0],["ما أَظُنُّ الكَريمَ يَرضى إِذا أَن","عَمَ بَعضي لِبَعضي التَعذيبا",9,"ب",2,0],["ما أظلم الوجود يا عبود","لولا شعاع للمنى يرود",10,"د",1,1],["ما أظهر من شدة وجد شكوى","قد باع لذاذة الكرى بالسهر",11,"ر",1,0],["ما أظمأ الغرسا","في واحة الحب",12,"ب",1,0],["ما أظُنُّ الصَّباحَ حَيًّا فَيُرْجَى","لَكَ يا لَيْلُ في الصَّباحِ البَقاءُ",13,"ا",2,0],["ما أَظهَرَ الشَيبُ إِلّا اللَونَ في كِبَري","كَلَونِ شَيبي وَلَم أَبلُغ إِلى الحُلُمِ",14,"م",1,0],["ما أظن وإن ظنيت ذا صرت مجنون","كيف يرضون من عمرهم مر يعصون",15,"ن",1,0],["ما أَظْهَرَ الباري حقيقةَ فضله","إلاَّ ليظهر قُوَّةَ الإِسلام",16,"م",1,0],["ما أَظُنُّ الزَمانَ يا أُمَّ عَمروٍ","تارِكاً إِن هَلَكتُ مَن يَبكيني",17,"ي",1,1],["ما أَظهرَ اللهُ هذا الفضلَ في بَشَرٍ","إِلاَّ وأُودع سِرّاً في سَريرَته",18,"ت",2,0]]}