m/ViewPoem.aspx?id=179206",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"الإقطاع","https://www.poetsgate.com/ViewPoem.aspx?id=179169",""],[90,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[90,"إلى المناضلين","https://www.poetsgate.com/ViewPoem.aspx?id=179212",""],[90,"شباب ضائع","https://www.poetsgate.com/ViewPoem.aspx?id=179161",""],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[45,"لَرَدَدْتُ العِتابَ عَلَيكَ، حتى","https://www.poetsgate.com/ViewPoem.aspx?id=31559",""],[35,"ألمْ يحزُنكَ يومَ غدتْ حُدُوجُ","https://www.poetsgate.com/ViewPoem.aspx?id=21989",""],[86,"أثرتَ بنا مِنَ الشَّوقِ القديمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13053&r=&rc=9",""],[68,"شربنا على ذكرِ الحبيبِ مدامة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15405&r=&rc=11",""]],"verses":[["وَها أَنَذا أَبُثُّكَ كُلَّ بَيتٍ","رَقيقِ النَسجِ رَقراقِ النِظامِ",0,"م",1,0],["وَها أَنا ذا غَرِضٌ بِالزَمانِ","فَلا عَيشَ يَألَفُهُ العاقِلُ",1,"ل",1,0],["وَهاكَ مِن كَفِّيَ مَفروجَةً","فَرجَ القَبا مَوسِيَةَ العائِدِ",2,"د",1,0],["وَها أَنا عُريانُ الجَنانِ مِنَ الَّتي","تَسوءُ وَمَنفوضُ الضُلوعِ مِنَ الوَجدِ",3,"د",1,0],["وَهاجِرَةٍ فَلَّلتُ بِالسَيرِ حَدَّها","وَلا ظِلَّ إِلّا ذابِلٌ وَنَجيبُ",4,"ب",1,0],["وَهابَت جَوانِبَهُ النائِباتُ","زَماناً وَقَد يُقدِمُ الهائِبُ",5,"ب",1,0],["وَهاجِرَةٍ تُلقي شِرارَ وَقودِها","عَلى الرَكبِ أَنعَلنا المَطيَّ ظِرابَها",6,"ب",3,0],["وَها أَنا أَخشى وَالحوادِثُ جَمَّةٌ","إِذا زُرتَها أَن لا تَرى بَعدَها نَجدا",7,"د",2,0],["وَهاتِفَةٍ بَكَت بِالقُربِ مِنّي","فَقالَ لَها سَجيري أَسعِدينا",8,"ن",2,0],["وَهاجَ وَجداً لَم يَزَلْ","تُطوى عَلَيهِ الأَضلُعُ",9,"ع",1,0],["وَها أَنا في الخُطوبِ بِهِ شَحيحٌ","وَلكنْ في الغَرامِ بِهِ سَخِيُّ",10,"ي",1,0],["وَهاتِها فالدِّيكُ مُستَيقظٌ","وَالشُّهْبُ قد هَمَّت بإِغفائِها",11,"ا",3,0],["وَها أَنا أَسْعَى لِلْمعالي فَطالَما","أَجَالَتْ جُدودِي في مَعَدٍّ قِداحَها",12,"ح",3,0],["وها أنا نَهْنَهَ ما أحْذَرُهُ","منْ غُلَوائِي فالنّذيرُ قد أتَى",13,"ا",1,0],["وها أنا أرْجو أن نَعيشَ بغِبْطَةٍ","جَميعاً وأنتَ المُنْعِمُ المتَفَضِّلُ",14,"ل",1,0],["وهاجَتْ تَباريحُ الصّبابةِ والهَوى","بَلابِلَ منْ صَدْرٍ على الوَجْدِ مُشْرَجِ",15,"ج",1,0],["وها أنا أزْمَعْتُ الفِراقَ وفي غَدٍ","نَميلُ بصَدْرِ الأرْحَبيِّ إِلى الفَلا",16,"ل",2,0],["وها أنا أرْجو من زَمانِكَ رُتبَةً","يَقِلُّ المُسامي عِنْدَها والمُساجِلُ",17,"ل",1,0],["وها أنا أرجو منْ زَمانِكَ رُتْبةً","لها غارِبٌ في المَجْدِ لمْ يُتَسَنَّمِ",18,"م",1,0],["وهانَ على حَيَّيْ خُزَيمَةَ أن ثَوى","عُتَيْبَةُ أو ذاقَ الرَّدى صاغِراً حُجْرُ",19,"ر",1,0],["وها أنا مِنهُمُ والعِرْقُ زاكٍ","أشُدُّ لمَنْ يَكيدُهُمُ القِبالا",20,"ل",2,0],["وَها قَد رَحَلتُ اليَومَ عَنهُم وَأَمرُن","إِلى مَن لَهُ في خَلقِهِ النَهيُ وَالأَمرُ",21,"ر",1,0],["وَها أَنا مَيِّتٌ إِن لَم يُعِنّي","عَلى أَسرِ الهَوى الصَبرُ الجَميلُ",22,"ل",1,0],["وَهاتِفَةٌ شَجَت قَلبي بِصَوتٍ","يَلَذُّ بِهِ الفُؤادُ المُستَهامُ",23,"م",1,0],["وَها أَنا مِن بَعدِكُم لَم أَزَل","في دَولَةِ الأَحزَانِ وَالوَجدِ",24,"د",1,0],["وَهانَ عَلَيها ما أُلاقي فَرُبَّما","يَكونُ التَلاقي وَالقُلوبُ تَقَلَّبُ",25,"ب",1,0],["وها نحْنُ قدْ لُذْنا بعِزِّ حِماكُمُ","ونَرْجو منَ اللهِ الإدالَةَ واللُّطْفا",26,"ف",2,0],["وَهَالَهَا مِنْ نُفُوسٍ","قَدْ أَقْبَلَتْ ثُمَّ وَلَّتْ",27,"ت",1,0],["وَهَاجَ ضِرَاماً لِلتَّشَوُّقِ مَا خَبَا","فَيَا لَبَلِيلٍ ثَارَ عَنْهُ غَلِيلُ",28,"ل",1,0],["وهاكَها منْ بَناتِ العُرْبِ ساحِرَةً","هيْفاءَ تَخْتالُ بيْنَ الدّلِّ والغَيَدِ",29,"د",1,0],["وها أنْتَ يا إنسانَ عيْنِ يَقينِه","برَوْضَةِ مَنْ حازَ المَحاسِنَ سارِحُ",30,"ح",1,0],["وَهالِكِ أَهلٍ يُجِنّونَهُ","كَآخَرَ في قَفرَةٍ لَم يُجَن",31,"ن",1,0],["وَهاجِرَةٍ لا تَستَريدُ ظِباؤُها","لِأَعلامِها مِنَ السَرابِ عَمائمُ",32,"م",1,1],["وَها قَد خَطاها وَنِلتَ المُنى","فَهَل في المَماتِ بُلوغُ الوَطَر",33,"ر",1,0],["وَهاجَرَ فيهِ خَيرُ داعٍ إِلى الهُدى","يَحُفُّ بِهِ مِن قُوَّةِ اللَهِ عَسكَرُ",34,"ر",1,0],["وَها أُمَّةُ الصُفرِ قَد مَهَّدَت","لَنا النَهجَ فَاِستَبَقوا المَورِدا",35,"د",2,0],["وَها أَنا بَينَ أَنيابِ المَنايا","وَتَحتَ بَراثِنِ الخَطبِ الجَسيمِ",36,"م",1,0],["وَها هُوَ مُنقادٌ لِحُكمِكَ فَاِحتَكِم","لِتَبلُغَ ماتَهوى وَمُرهُ لِيَصدَعا",37,"ع",2,0],["وهَامٌ وهَمهَامٌ وطَالِعُ أَنجُدٍ","ومُنحَبِكُ الرَّوقَينِ في سَيرِهِ مَيَل",38,"ل",1,0],["وهادية بليل في نهار","ولما تبتغي يداه قوام",39,"م",1,1],["وَهاجَ الهَوى أَظعانُ عَزَّةَ غُدوَةً","وَقَد جَعَلَت أَقرانُهُنَّ تَبينُ",40,"ن",1,0],["وَهاجِرَةٍ يا عَزَّ يَلتَفُّ حَرُّها","بِرُكبانِها مِن حَيثُ لَيُّ العَمائِمِ",41,"م",1,1],["وَهاجَتكَ أَطلالٌ لِعَزَّةَ بِاللَوى","يَلوحُ بِأَطرافِ البِراقِ رُسومُها",42,"م",3,0],["وَهاجَتني بَحَزمِ عُفارِيياتٍ","وَقَد يَهتاجُ ذو الطَرَبِ المُهيجُ",43,"ج",1,0],["وَهاجِرَةٍ حَرُّها صاخِدٌ","جَعَلتَ رِداءَكَ فيها خِمارا",44,"ر",2,0],["وَهادٍ كَجِذعِ الساجِ سامٍ يَقودُهُ","مُعَرَّقُ أَحناءِ الصَبِيَّينِ أَشدَقُ",45,"ق",1,0],["وَهاجِرَةٍ شَهباءَ ذاتِ وَديقَةٍ","يَكادُ الحَصى مِن حَميِها يَتَصَدَّعُ",46,"ع",1,0],["وَهامٍ تَزِلُّ الشَمسُ عَن أُمَّهاتِها","صِلابٍ وَأَلح في المَثاني تَقَعقَعُ",46,"ع",1,0],["وَهاجَت لَهُ مِن مَطلَعِ الشَمسِ حَرجَفٌ","تَوَجَّهُ أَسباطَ الحُقوفِ التَياهِرِ",47,"ر",1,0],["وَهاجَت بَقايا القُلقُلانِ وَعَطَّلَت","حَوالِيَّهُ هوجُ الرِياحِ الحَواصِدُ",48,"د",1,0],["وَهاجِرَةٍ غَرّاءَسامَيتُ حَدَّها","إِلَيكِ وَجَفنُ العَينِ بِالماءِسافِحُ",49,"ح",1,0],["وَهاجِرةٍ مِن دونِ مَيَّةَ لَم تِقل","قَلوصي بِها وَالجُندَبُ الجَونُ يَرمَحُ",50,"ح",1,0],["وها أنا قبل القوم جئتك معلناً","لك الشكر حتى أملأ الأرض بالشكر",51,"ر",1,0],["وهان عليهم حين هانت نساؤهم","تحمُّل جَوْر الساسة الغرباء",52,"ا",2,0],["وها هو ذا يعدو فيبتدر المدى","وينهب أعمارَ الورى في ابتداره",53,"ر",2,0],["وَهاجَ البَرقُ لَيلَةَ أَذرِعاتٍ","هَوىً ما تَستَطيعُ لَهُ طِلابَ",54,"ب",1,0],["وَهاماتِ الجَبابِرِ قَد صَدَعنا","كَأَنَّ عِظامَها فِلَقُ المَحارِ",55,"ر",1,0],["وَهاجِدِ مَوماةٍ بَعَثتُ إِلى السُرى","وَلَلنَومُ أَحلى عِندَهُ مِن جَنى النَحلِ",56,"ل",1,0],["وهَاتِ الثَّنَاءَ لأَهلِ الثَّنَاءِ","بأَصوَبِ قَولِكَ فالأَصوَبِ",57,"ب",1,0],["وهات الثناء لأهلي العلى","بأصوب من قولك الأصوب",58,"ب",1,1],["وَهَاشِمُ مُرَّة للمُفنِي مُلُوكاً","بِلاَ ذَنب إِلَيهِ ومُذنِبِينَا",59,"ن",2,0],["وَها أَنا قَد حَلّى الزَمانُ مَفارِقي","وَتَوَّجَني بِالشَيبِ تاجاً مُرَصَّعا",60,"ع",2,0],["وهاكَ يا ساكناً قلبي كؤوس طلاً","لو مسَّها حجرٌ مسَّته سراء",61,"ا",2,0],["وهائمٌ بالجواري الخودِ قلبيَ من","سمرِ القدود فسمراءٌ ولمياء",62,"ا",2,1],["وها أنا ذا أبلغت عذريَ قاصداً","وأيقنت أن النجح لا يتعذَّر",63,"ر",1,0],["وهاك دَرْجَكَ إنّا نابذون به","كما نَبذتَ بما قلناه من كَثَبِ",64,"ب",1,0],["وهّابُ ما ليس بمستأهَلٍ","مِعطاءُ ما ليس بمستوجَبِ",65,"ب",1,0],["وهان عليك مُنقلَبي كئيباً","وللْحَسراتِ في الأحشاء نار",66,"ر",1,0],["وهاتيك حالُ الباخلين إذا نووا","سَدىً أو ندىً أبدَوا وجوهاً عوابسا",67,"س",2,0],["وهابُ يأس أو إياس مُنفِسٍ","ولرب يأس قد وَفَى بإياس",68,"س",1,0],["وها أنا من ذنبي وعتبيَ تائبٌ","إلى سيدٍ كم غَضَّ عنّي وغمّضا",69,"ض",2,0],["وهائبٍ لك لم يسألك قلت له","دع عنك عجزك لا يعقبك تلهافا",70,"ف",2,0],["وهان عليه أن يطول ثراؤه","على الجانب الغربيِّ من قنص أبسق",71,"ق",1,0],["وهاذرٍ يبلُغني هَدْرُهُ","لو شئتُ عفَّى قطرَه سَيلي",72,"ل",2,1],["وها إنني من بعدها متمثّلٌ","بوَفْقٍ من الأمثال في منطقٍ فصلِ",73,"ل",1,0],["وهاجرة بيضاءَ يُعْدِي بياضُها","سواداً كأن الوجهَ منه مُحمَّمُ",74,"م",1,0],["وهّابُ أمداحٍ لوهَّاب نعمْ","يأمُل أن ترعَى له تلك الحُرَمْ",75,"م",1,0],["وهَّابُ ما يأمنُ العِقبانُ واهبُهُ","طلَّابُ ما للتَّغاضي عنه عقبان",76,"ن",1,0],["وَهاتِفَةٍ قَد أَقلَقَتني بِنَوحِها","فَكُنتُ كَمَخمورٍ أَفاقَ مِنَ السُكرِ",77,"ر",1,0],["وَهامَ فيها تُريهِ الشَمسَ غُرَّتُها","وَالفَجرَ مُرتَصِفاً في ثَغرِها دُرَرا",78,"ر",2,0],["وَها جَيشُكَ الطامي يَضُجُّ مُكَبِّراً","بِما نالَ مِن عَهدٍ لَدَيكَ وَمَوثِقِ",79,"ق",1,0],["وَها نَحنُ وَها أَنتُم","مَتى قَطُّ ذَكَرناها",80,"ا",3,0],["وَها أَنا كَالمَجنونِ فيكُم صَبابَةً","وَحاشاكُمُ تَرضَونَ لي بِجُنوني",81,"ي",1,0],["وَهاهِيَ في بِشرٍ بِقُربِكَ شامِلٍ","قَدِ اِنتَظَمَت دِمياطُ مِنهُ وَأَسوانُ",82,"ن",1,0],["وَها أَنا قَد كَشَفتُ إِلَيكَ سِرّي","وَهَذا شَرحُ حالي وَالسَلامُ",83,"م",1,0],["وَها أَنا وَالواشي وَأَنتَ جَميعُنا","يَكونُ لَنا يَومٌ عَظيمٌ وَمَوقِفُ",84,"ف",1,0],["وَها أَنا ذا أَدعو لَكَ اللَهَ دائِماً","مَعَ الصَلَواتِ الخَمسِ وَالشَفعِ وَالوِترِ",85,"ر",1,0],["وَها أَنا ذا حَتّى إِلى اليَومِ رُبَّما","أُكَذِّبُ عَنهُ بِالصَحيحِ مِنَ الأَمرِ",86,"ر",1,0],["وَها أَنا ذا كَالطَيفِ فيها صَبابَةً","لَعَلّي إِذا نامَت بِلَيلٍ أَزورُها",87,"ر",3,0],["وَها أَنا أُلقيهِ إِلَيكَ مُفَصَّلاً","وَدونَكَ فَاِسمَع ما يَسُرُّكَ وَاِطرَبِ",88,"ب",1,0],["وَها أَنا ذا وَحَقِّكَ في جِهادٍ","عَسى مِن وَصلِكَ الفَتحُ القَريبُ",89,"ب",1,0],["وَهابَ جَنانَ مَسجورٍ تَرَدّى","مِنَ الحَلفاءِ وَاِتَّزَرَ اِتِّزارا",90,"ر",2,0],["وَها هوَ المَجلِس المُعدُّ لَكُم","فاِدخُل إِلَيهِ وَليَدخُل القَومُ",91,"م",1,0],["وَها أَنا ظَمآنٌ لمنهل وردكم","وَحَسبيَ مَوقوفٌ عَلى وردكم حَسبي",92,"ب",2,0],["وهامة اذا زقت","وغاسق اذا وقب",93,"ب",1,0],["وَها قَد جِئتُ أَعرضُها","عَلى أَعتابِ مَولانا",94,"ن",2,0],["وَهانَت عَلَيهِ مَلاهي الشَبابِ","وَلَولا حُقوقُ العُلا لَم تَهُن",95,"ن",1,0],["وَهابَ العِدا فيهِ خِلافَتَكَ الَّتي","لَهُم مَأرَبٌ فيها وَلِلَّهِ مَأرَبُ",96,"ب",1,0],["وَهاجي نَفسِهِ مَن لَم يُمَيِّز","كَلامي مِن كَلامِهِمِ الهُراءِ",97,"ا",2,0],["وَهانَ فَما أُبالي بِالرَزايا","لِأَنّي ما اِنتَفَعتُ بِأَن أُبالي",98,"ل",2,0],["وهاجرةٍ سجراءَ تأكلُ ظِلَّها","ملوَّحَةِ المِعْزاء رمضَى الجَنادبِ",99,"ب",1,0],["وَهانَ عَلَيها ما أُلاقي فَرُبَّما","تَكونُ البَلايا وَالقُلوبُ تَقَلَّبُ",100,"ب",1,0],["وَهابَكُمُ ذو الضِغنِ حينَ وَطِئتُمُ","رِقابَ الأَعادي وَطأَةَ المُتَثاقِلِ",101,"ل",1,0],["وَهاجِرَةٍ كَلَّفتُ نَفسي وَناقَتي","مِنَ المُنضِجاتِ اللَحمِ نَيّاً سُمومُها",102,"م",3,0],["وَهارونُ ماءُ المُزنِ يُشفى بِهِ الصَدى","إِذا ما الصَدِي بِالرِيقِ غَصَّت حَناجِرُه",103,"ر",2,0],["وهان إذا عطفت ولو خيالاً","وأين خيالك المعبود أينا",104,"ن",2,0],["وها أنا لا أورّي عنك سرا","عرفت محبتي ورأيتِ دمعي",105,"ي",1,0],["وهاتي جهامَ السُّحْبِ أملؤها حَياً","بدمعي لسقيا أربُعي ومعالمي",106,"م",2,0],["وها أنا اليومَ أرثيهِ وكنتُ لهُ","أُنَقّحُ المدحَ والدنيا لها غِيَرُ",107,"ر",1,0],["وَهارِبٍ وَدَخيلُ الرَوعِ يَجلُبُهُ","إِلى المَنونِ كَما يُستَجلَبُ النَقَدُ",108,"د",1,0],["وَهاتا ثِيابُ المَدحِ فَاِجرُر ذُيولَها","عَلَيكَ وَهَذا مَركَبُ الحَمدِ فَاِركَبِ",109,"ب",1,0],["وَهانَ عَلى قَلبي الزَمانُ وَأَهلُهُ","وَوِجدانُنا وَالمَوتُ يَطلُبُنا فَقدُ",110,"د",1,0],["وَهَاكَ مَا أَنْتَ أَهْلٌ فِي الْهِجَاءِ لَهُ","فَالْهَجْوُ فِيكَ لِنَقْضِ الْحَقِّ إِبْرَامُ",111,"م",1,0],["وها أنذا اطرحْتُ غبونُ دهري","فدهري للأفاضلِ ذو أطر احِ",112,"ح",1,0],["وها أَنا، ويَدي جِلْدٌ، وسالِفَتي","ثَلْجٌ، ووَجْهيَ عَظْمٌ كادَ أو عُرِقا",113,"ق",2,0],["وها هو عنده فلكٌ يدويِّ","وعِند منعمٍ قصرٌ مشيد",114,"د",1,0],["وَها أَنا مَبلولُ الجَناحِ مِنَ الحَيا","يَصوبُ وَمذعورُ الفِراخِ مِنَ الوَكرِ",115,"ر",1,0],["وَهاتيكَ آدابُهُ لُجَّةٌ","فَمَن لي زَخَرَت بِالعُبورِ",116,"ر",1,0],["وَها أَنا أُقريكَ السَلامَ عَلى النَوى","مَعَ الريحِ تَندى أَو مَعَ الطَيفِ يَطرُقُ",117,"ق",1,0],["وَها هُوَ وَالحِلمُ في طَبعِهِ","هِزبَرٌ إِذا ماحَمى أَو حَمَل",118,"ل",1,0],["وَهابَ فَأَلقى عَلى وَجهِهِ","قِناعَ سَوادِ الدُجى وَاِلتَثَم",119,"م",1,0],["وَها أَنا إِن تَمرَض بِأَرضِكَ حاجَةٌ","فَقَد جِئتُ أَبغي مِنكَ عيسى بنَ مَريَما",120,"م",2,0],["وَها أَنا تَلقاني اللَيالي بِمِلئِها","خُطوباً وَأَلقى بِالعَويلِ اللَيالِيا",121,"ي",2,0],["وَهاروتُ لاقى مِن جَوى الحُبِّ سَطوَةً","وَماروتُ فاجَأهُ البَلاءُ المُصَمِّمُ",122,"م",1,0],["وَهاجَت مِن أُمَيَّةَ في دِمَشقٍ","لَواعِجَ تَبعَثُ الداءَ الدَخيلا",123,"ل",2,0],["وهالت بَني الدُنيا جَوائِحُ جَمَّةٌ","تَغَلغَلنَ في أَقطارِها وَالمَمالِكِ",124,"ك",1,0],["وهاتيك أسلابُه أُطلِقَتْ","وكانت حبائسَ منذُ القِدَمْ",125,"م",1,0],["وهَاجَ همَّ أبي سُفيانَ ما وَجَدوا","فَرَاحَ يَشفعُ فيهم جَازعاً أَسِفا",126,"ف",2,0],["وَها مُغَطّى الأَشجان بِأَدمُعِ","الأَجفان بادٍ صَريح",127,"ح",1,0],["وَهاما هياماً في هَوى مَضرية","كَما اِنقَطَعا دَهراً لَها وَتَجَرَّدا",128,"د",2,0],["وَهاجِرَةٍ يا سَلمَ كَفَّنتُ هامَتي","لَها وَفَمي بِالأَتحَمِيِّ المُسَيَّحِ",129,"ح",1,0],["وَهاجَهُ ذِكرُ قُربى بَعد سَلوَتِهِ","وَراجَعَ القَلبَ ما يَلقى فَقَد نَصَبا",130,"ب",2,0],["وَهاجَ لَهُ حُبُّ البَخيلَةِ حُزنَهُ","وَقِدماً يُحَبُّ الشَيءُ وَهوَ بَخيلُ",131,"ل",1,0],["وَهاجَ لَكَ الصَبابَةَ مِن هَواها","بِحِنوِ قُراقِرٍ طَلَلٌ مُحيلُ",132,"ل",1,0],["وَهاجِرَةٍ يَصُدُّ العَيسَ فيها","حَرورٌ مِن لَوافِحَ كَالضِرامِ",133,"م",1,0],["وَها إنَّ شَمْسَ الدِّينِ لِلْفَضْلِ باهِرٌ","وليسَ بِخَافٍ عنه لِلْفَضْلِ مَخْبَرُ",134,"ر",1,0],["وها فكأنْ قد زارَهُ وتَجانَفَتْ","به عن قصور المُلك طَيْبةُ والسُّرُّ",135,"ر",1,0],["وَهاكَها قَهوَةً صَهباءَ صافِيَةً","مَنسوبَةً لِقُرى هيتٍ وَعاناتِ",136,"ت",1,0],["وَهانَ عَلَيَّ الناسُ فيما إِريدُهُ","بِما جِئتُ فَاستَغنَيتُ عَن طَلَبِ العُذرِ",137,"ر",1,0],["وَهاتِ فَغَنِّني بَيتَي نُصَيبٍ","فَقَد وافانِيَ القَدَحُ المُدارُ",138,"ر",1,0],["وهاجرٌ هاجرَ الخليلُ بها","إلى متيهٍ يتاهُ في سبله",139,"ل",2,0],["وَهاجِرَةٍ نَصَبتُ لَها جَبيني","يُقَطِّعُ ظَهرُها ظَهرَ العَظايَه",140,"ه",1,1],["وَهاوٍ لِيُخرِجَ ماءَ القَليبِ","وَراقٍ لِيَجنِيَ ثَولاً أَرى",141,"ر",2,0],["وَهانَ عَلى سَمَعي إِذا القَبرُ ضَمَّني","هَريرُ ضِباعٍ حَولَهُ وَكَليبِ",142,"ب",1,0],["وَهاجَ حُمَيّاها أَصيلٌ مُذَكِّرٌ","تُغَنّيهِ شَجواً أَو غَداةٌ تَنوحُها",143,"ح",3,0],["وَهاروتُ كَيفَ عَصى رَبَّهُ","بِتَعليمِهِ السِحرَ في بابِلِ",144,"ل",1,0],["وَهانَ عَلى الفَراقِدِ وَالثُرَيّا","شُخوصٌ في مَضاجِعِها دُرِسنَه",145,"ن",2,0],["وهاجَتْهُ الجَنُوبُ لوَصْلِ حَيّ","أقامَ ويَمّموا داراً طَرُوحا",146,"ح",2,0],["وَهاجَت لَكَ الأَحزانَ دارٌ كأَنَّها","بِذي بَقَرٍ أَو بِالعَنانَةِ مَذهَبُ",147,"ب",1,0],["وهامتْ بها روحي بحيثُ تمازَجا اتّ","تِحاداً ولا جِرْمٌ تَخَلّلَه جِرْم",148,"م",1,0],["وَها أَنا ذا ألقى بمصر رعاية","فمنها ليَ النعمى ومني لها الشكر",149,"ر",1,0],["وهائمٍ في الفضاءِ صَبِّ","مُجنّح لا يبينُ طيفا",150,"ف",2,0],["وهاج عطر الصباح فيها","ما هاج في النحلة الرضيعه",151,"ع",2,0],["وهامَتْ على ظمأٍ روحُها","وكم ملأوا الكأسَ من خمرِها",152,"ه",2,0],["وهادنوا ثم بغوا فناهدوا","ونقضوا ما أبرم التعاهد",153,"د",1,0],["وهاشم السّحب سقاة الوفد","الغامرون غيرهم بالرّفد",154,"د",1,0],["وهاكَها بيِّنةً مُصوَّرَهْ","لكُلِّ مَن عاينَها مُفَسَّرَه",155,"ه",1,0],["وَها قَد رَحَلتُ اليَومَ عَنهُم وَأَمرُنا","إِلى مَن لَهُ في خَلقِهِ النَهيُ وَالأَمرُ",156,"ر",1,0],["وَها أَنا قَد بَرَزتُ اليَومَ أَشفي","فُؤادي مِنكُمُ وَغَليلَ صَدري",157,"ي",1,0],["وَهَاكَها تُحْفَةً مِنِّي وَإِنْ صَغُرَتْ","فَالدُرُّ وهْوَ صَغِيرٌ حَلْيُ أَجْيَادِ",158,"د",1,0],["وَهَاكَ عَلَى بُعْدِ الْمَزَارِ قَرِيبَةً","إِلَى النَّفْسِ يَدْعُوهَا الْوَفَاءُ فَتَتْبَعُ",159,"ع",1,0],["وَهَأَنَا مُنْقَادٌ كَمَا حَكَمَ الْهَوَى","لأَمْرِكِ فَاخْشَيْ حُرْمَةَ اللهِ وَالْمَجْدِ",160,"د",1,0],["وَهَامُ بني رَبيعَةَ سَائِلُوهَا","فَفِي أسْيَافِنَا مِنْهَا فُلُولُ",161,"ل",1,0],["وهام في مرافئ الجنون","كسندباد أحمق مأفون",162,"ن",1,0],["وَهاظَكَ السقمُ وَلَو","شاءَ إِلهي جَبَرَك",163,"ك",1,0],["وَهَاذا الذَّكَاءُ العَبْقَرِيُّ مَلِيكُه","وهَذِي الْجُنُودُ الزَّاخِرَاتُ مَواكِبُهْ",164,"ب",2,0],["وَهَالَهَا مِنْكَ عَزْمٌ","لَوْ لاَمَسَ الصخْرَ ذَابَا",165,"ب",2,0],["وهاك رثاءَ محزونٍ مُقِلٍ","وما أوْفَى إذَا بذلَ المُقِلّ",166,"ل",1,0],["وهارب من رضوان","أوقعني في النيران",167,"ن",1,1],["وهامَ المالِكُونَ بكل أرضٍ","وتلك قصورهم بقِيَتْ وراحوا",168,"ح",3,0],["وهاج إلى الصّبابة من هواها","بحنوِ قراقرٍ طللٌ محيلُ",169,"ل",1,0],["وهاتوا لي من الإيمان نور","وقووا بين جنبي اليقينا",170,"ن",2,0],["وهاتيك اقزاعٌ لطافٌ كؤوسُها","وخَمْرَتُها جَوْنُ السَّحاب تذوَّبا",171,"ب",2,0],["وها أنا أرزحُ في كَلكَلً","مُنيخٍ على نَفسَي رائِن",172,"ن",1,0],["وهابِي أن تُمدَّ إليكِ مِنَّا","يدُ المتضارِبين على القِداح",173,"ح",1,0],["وها أنا بالنيّات سوداً معذَّبٌ","تعاودُني فيهنَّ سودُ الخواطر",174,"ر",1,0],["وها إن هذا الشَّعْبَ يَطوي جَناحَهُ","على خَطَرٍ من سَورةِ اليأس داهم",175,"م",1,0],["وها نحن في عصر من النور نشتكي","غَوايةَ دُستور من الغِش مبهم",176,"م",1,0],["وهاتُوا قلوبَكُمُ أُفرِغِتْ","على نَجدةِ الحَقِّ ، أو فاذْهَبوا",177,"ب",3,0],["وها نحن في عصرٍ يَفيضُ صناعةً","نرى كلَّ من حاك الحصيرَ صناعا",178,"ع",2,0],["وهاهو الماءُ موتٌ في زيادته","وفي النقيصةِ مسروقٌ فمُحتَكَر",179,"ر",1,0],["وَهَانَ عَلَيكَ سُخطي حينَ تَغدو","بعِرْضٍ، لَيسَ تقتُلُهُ الكِلابُ",180,"ب",1,0],["وهاجتني بِحَزْمِ عُفَارِيَاتٍ","وقد يهتاجُ ذو الطَّربِ المهيجُ",181,"ج",1,0],["وهأَنا بين أنيابِ المَنايا","وتحت بَراثِنِ الخَطبِ الجَسيمِ",182,"م",1,0],["وهامتْ بها روحي بحيث تمازجا اتّ","حاداً ولا جرمٌ تخلَّلهُ جرمُ",183,"م",1,0]]}