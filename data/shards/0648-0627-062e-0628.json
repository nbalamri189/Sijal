s://poetry.dctabudhabi.ae/diwan/poem/147309","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72570","الطويل"],[4645,"","https://poetry.dctabudhabi.ae/diwan/poem/105489","الخفيف"],[4745,"حسود الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=214704",""],[4767,"العيون السهارى","https://www.poetsgate.com/ViewPoem.aspx?id=213985",""],[4578,"حويت المجد بالهمم العلية","https://www.poetsgate.com/ViewPoem.aspx?id=49616",""],[4862,"ألا ياطير بلغها السلام","https://www.poetsgate.com/ViewPoem.aspx?id=144616",""],[4955,"سمعت القلب يهمس بالبيان","https://www.poetsgate.com/ViewPoem.aspx?id=195412",""],[3591,"لنا الجرأة الكبرى على ذلك القدر","https://www.poetsgate.com/ViewPoem.aspx?id=149436",""],[5277,"حواءُ..ولا تفاحةَ لها..","https://www.poetsgate.com/ViewPoem.aspx?id=204995",""],[5367,"انشرْ ولكَ اﻷجر","https://www.poetsgate.com/ViewPoem.aspx?id=197275",""],[5431,"فيرميه الصباح على سريري","https://www.poetsgate.com/ViewPoem.aspx?id=198702",""],[709,"غَرَبَتْ مِنكمُ شُمُوسُ التَّلاَقِي","https://www.poetsgate.com/ViewPoem.aspx?id=2876",""],[5497,"لوعةً وتحسرا","https://www.poetsgate.com/ViewPoem.aspx?id=206253",""],[5582,"يا صاحِبَيَّ قِفَا يا صاحِبَيَّ قِفَا","https://www.poetsgate.com/ViewPoem.aspx?id=63535",""],[1638,"رشا من بني الأتراك صاد بصاده","https://www.poetsgate.com/ViewPoem.aspx?id=123935",""],[5736,"خبز الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=208238",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5818,"بثامن آيةٍ في العادياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=199689",""],[5975,"مدينة عشقي","https://www.poetsgate.com/ViewPoem.aspx?id=33750",""],[6068,"ورثنا المجد ميراث فرض -15-","https://www.poetsgate.com/ViewPoem.aspx?id=175886",""],[6152,"لا عز لنا إلا بالدين","https://www.poetsgate.com/ViewPoem.aspx?id=204959",""]],"verses":[["وَأَخبَرَني بِأَنَّ العِلمَ نورٌ","وَنورُ اللَهِ لا يُهدى لِعاصي",0,"ي",1,0],["وَأَخْبَرَ شِقٌّ أَنَّ فِي الأَرْضِ عِنْدَهَا","طُلُوعَ نَبِيٍّ طَاهِرِ الأَبِ وَالأُمِّ",1,"م",1,0],["وَأَخْبَث الأَمْرَاضِ تَنْتَابُهُ","مِنْ حَيْثُ لا يَدْرِي وَلا يَفْهَمُ",2,"م",1,0],["وَأُخبِرتُ تَيماً نادِمينَ فَسَرَّني","مَلامَةُ تَيمٍ أَمرَها المُتَعَقَّبا",3,"ب",2,0],["وَأَخٌ بِهِ جَلَتِ البَوارِحُ إِذ جَرَت","أَجبالَ تَدمُرَ مِن دُجىً وَغُبارِ",4,"ر",1,0],["وَأَخبِرتُماني أَنَّ تَيماءَ مَنزِلٌ","لِلَيلى إِذا ما الصَيفُ أَلقى المَراسِيا",5,"ي",2,0],["وَأَخبَثَ الناسِ أَصلاً","في أَخبَثِ الأَرضِ تُربَه",6,"ب",2,0],["وَأُخبِرتُ أَعمامي بَني الفِزرِ أَصبَحوا","يُوَدّونَ لَو رَزجو إِلَيَّ الأَفاعِيا",7,"ي",2,0],["وَأَخبِرُ بِأَنّي وَإِن أَصبَحتُ مُبتَنِياً","مَجداً وَأُغلي قَدري بَعدَ إِرخاصي",8,"ص",2,0],["وَأَخٍ بَشِعتُ بِعُرفِهِ وَمَذاقِهِ","وَمَلِلتُ عُنفَ قِيادِهِ وَسِياقِهِ",9,"ق",2,1],["وَأَخبَرَهُ أَنَّ السَبيلَ ثَنِيَّةٌ","صَعودٌ تُنادي كُلَّ كَهلٍ وَأَمرَدا",10,"د",2,0],["وأَخبَرَ تابِعِيهِ بِغائِباتٍ","وَلَيسَ بِكائِن عنهُ معيبُ",11,"ب",1,0],["وَأَخبَرَني بِأَصنافِ الرَزايا","وَبِالهُجرانِ مِن بَعدِ الوِصالِ",12,"ل",1,0],["وَاخْبُؤْهُ خَبْءَ العَيْنِ فِي","الْجَفْنَيْنِ مَا شَاءَتْ مُناكْ",13,"ك",1,0],["واخبأ وليك للنوا","ئب انها سحب سحاح",14,"ح",1,0],["وأَخبَرَ تابِعِيِه بِغائِباتٍ","وليس بكائن عنه مَغيبُ",15,"ب",1,0],["وَأخُبرْتُ أعمامي بَني الفِزْرِ أصْبحوا","يَوَدّونَ لَوْ أزْجَوْا إليّ الأفَاعِيَا",16,"ي",2,0],["وأُخبرَكم بأنى مُستهامٌ","حزينُ القلبِ منكم يا صِحابي",17,"ب",2,0],["وأخبَرني بِأنَّكَ لاَ تُصَلِّى","وَلَم تَكُ صَائِماً ثِقَةٌ صَدُوقُ",18,"ق",1,0],["وأخبروا عنّى بما شئتُمُ","فإنه دون الجوى الموجِعِ",19,"ع",1,0],["وأخبرتنا عنكم بدين مسفه","وما أنت بالاخبار عنك مكذب",20,"ب",1,0],["وَأَخبَرَني مَن لا أشكُّ بصدقهِ","بأَن قَد رَأى من بالَ منهم بلا اِستِبرا",21,"ر",2,0],["وَأَخبَرني منهم فتىً فرّ هارباً","فَعاشَ زَماناً طال من بعد أن فرّا",22,"ر",2,0],["وأخبرتَنا أنَّ المنجِّم كاهن","بماقال والكهان من شيعة الكفر",23,"ر",1,0],["واخبار عضو الشاة أنى مسمم","فتبا لافعال اليهود الاصاغر",24,"ر",1,0],["وأخبر بحال في اليقين محقق","باظهار ظن لا بحلف وبرهان",25,"ن",1,0],["وأخبر بأنواع المعاصى وشرها","وخوفهمو بالزجر من هول نيران",25,"ن",1,0],["وأخبر عن رب العباد بأن من","غدا عنه في الأخرى بأقبح خيبة",26,"ه",1,0],["وَأَخبارُكُم في طَيِّها وَمَسيرِها","وَتَخليدِها بَينَ البَرِيَّةِ كَالخِضرِ",27,"ر",1,0],["وأخبارٌ سمعناها","لأجلكمُ تركناها",28,"ا",3,0],["وأخبار فادينا المسيح ودينه","وموسى لها في الأولين نَصوص",29,"ص",1,0],["وَأَخبِروني عَن التَجَلُد وَالأَلف","طَوَتهُ الخُطوب كَيفَ يَكون",30,"ن",1,0],["وأخبر فيه عن عواقب من عصى","بأن له بعد الممات جهنما",31,"م",2,0],["وأخبرني ثقات الناس عنه","بأنْ لا زال في كرب وضيق",32,"ق",1,0],["وَأُخبِرُهُ في السِرِّ بَيني وَبَينَهُ","بِأَن لَيسَ شيءٌ عِندَ نَفسي يُقارِبُه",33,"ب",2,0],["واِخْبِرِ الساكنينَ أنّي على ما","علِموهُ لهمْ على العهدِ باقِ",34,"ق",1,0],["وأخبارٍ سرَتْ فبكلِّ أرضٍ","لها عبقٌ يضرُّ بكلِّ شانِ",35,"ن",1,0],["وأخٍ بدا منه القبيح عقيب ما","فعل الجميلَ فضاع منه جميلُهُ",36,"ل",2,0],["وَاِخبُرْ وَلا تَصحَبْ منَ ال","إخوانِ إلّا مَنْ خَبَرْتا",37,"ت",2,0],["واخبر القوم بالذي هو فيها","من تجل يُعيد من مات حيا",38,"ي",2,0],["وأخبرتنا إشارات الصنوج بها","فهيَّم القلبَ منا ذلك الخبر",39,"ر",1,0],["وأخبروا بوقته وصفته","وكل ما دل على معرفته",40,"ه",1,0],["وأَخبارُ سؤدَدِه مِنْ سَنا","ه أَبْهى ومِنْ حُسْنِه أَبْهَر",41,"ر",1,0],["وأخبرنا في وحيه لرسوله","بأن لامرئ ما قد نوى فبه اقتد",42,"د",1,0],["وأخبره الحق الخبير حقيقة","بأن له في الجهل من علمه خبرا",43,"ر",2,0],["وأخبره أنّه مُرْسَلٌ","فقالَ صدقتَ وما فنّدا",44,"د",2,0],["وأخبرنا الإلهُ بما وَقاهمْ","ولقَّاهم هناك من السُّرورِ",45,"ر",1,0],["وَأَخبَروا السُلطان بِالَّذي حَصَل","قالَ اِدفَعوا المالَ فَما جاءَ وَصَل",46,"ل",1,0],["وأخبر مودته بقلبك إنه","حجر الصيارف شدة وسوادا",47,"د",2,0],["وَأَخْبَرَنَا عَمَّا أتَى بِكِتَابِهِ","لَقَدْ فَازَ مِنْ رَبِّ الْعُلاَ بِخِطَابِهِ",48,"ه",1,0],["واخبراني عن الصباح فسعى","ضل فيه ولم يجد من هادي",49,"د",2,0],["وأخبر أهل العير عن كنه حالها","وعن ناقة ضلت بواد متالع",50,"ع",1,0],["واِخبر وقُل إِنّه أَوفى الوَرى ذِمماً","إن كانَ لهم حسباً أعلاهمُ شَرفا",51,"ف",2,0],["وأخبر عذّالي بأنّي وإن جفت","وصدّت لأفديها بروحي ومهجتي",52,"ت",2,0],["وَأُخبِرُ أَنّي رُحتُ في حِلَّةِ الضَنى","لَيالِيَ عَشراً ضامَها اللَهُ مِن عَشرِ",53,"ر",1,1],["وأخْبرُ أن البين هَدَّ لي القوى","وغَادَرَ رأسي في الشَّبيبة شائبا",54,"ب",2,0],["واخبر فاستفاد المؤمنون العلوم","العلوم وأحرزوا فيض السلام",55,"م",1,0],["واْخبر عنهم بأسرارهم","وما حَالف السعد كالمخبر",56,"ر",1,0],["وَأَخبرت بِقصتي حَليلها","وَسَجعت وَرَجعت هَديلها",57,"ه",2,0],["وأخبر الصحبَ عن أشيا مغيّبةً","عنهم وكانت بوحيٍ غير متّهم",58,"م",1,0],["وَأَخْبَرَ يُوسُفْ جَدَّهُ بِظُهُورِهِ","غَدَاةَ أَتَاهُ وَهْوَ فِي رَأسِ غِمْدَانِ",59,"ن",1,0],["وأخباره كم أبرأت من معلل","بمعضل داء غير ذكراه ما شفا",60,"ف",2,0],["وَأَخبريهم ما ألاقي","من طول حزني واِشتياقي",61,"ي",1,0],["وأُخبِرَ أنّا ذاتُ عِلمٍ سُيُوفُنا","بأعناقِ مابين الطُّلَى والكواهلِ",62,"ل",1,0],["وَأَخبطُ بِالسُرى ورقَ الدَياجي","وَوَجه المَوتِ مَحدور القناعِ",63,"ع",1,0],["وأخبر باللقيط بما علمتم","ولم يك غير حق قابلينا",64,"ن",2,0],["وأخبره أن المشاعر أرخت","تقول بحج البيت أنك رابح",65,"ح",1,0],["وَأخبَرَ العُضوُ بالسُّمِّ الَّذِى كَمَنا","فِيهِ شِفاهاً بِحُد يا سَيِّدَ الرُّسُلِ",66,"ل",1,0],["وأخبرهم فيها بما هو بيننا","وأُنهي إليهم كيف نقضي اللياليا",67,"ي",2,0],["واخبره ان الصب بعد","لقاك لم يعرف منامه",68,"م",2,0],["وَأُخبِرُ عَنهُ بِالَّذي لا أُحِبُّهُ","فَيَضحَكُ سِنّي وَالفُؤادُ كَئيبُ",69,"ب",1,0],["وأخبارك تأتينا","على الأعلام منصوبه",70,"ب",2,0],["وأخْبر عنْ الأخدار أخدارِ عامرٍ","مَتى قوّضَتْ عنْ ذلك العلمِ الفردِ",71,"د",1,0],["وأخبار صِدقٍ خبِّرت عن محمد","يُخبّرها عنه إذا غابَ ناصحُ",72,"ح",1,0],["وأخبر أن الفرس قد عرفت له","محلا وقد شادت له عندها ذكرا",73,"ر",2,0],["وَأَخبارُهُم مَنقولَةٌ بِتَواترٍ","وَآحاد النقل الَّذي صحَّ في العَقلِ",74,"ل",1,0],["واخبري منشد التمدين ان ال","عرب ليسوا فيما يحاول عجما",75,"م",2,0],["وأخبار فضلٍ عنك صحَّ ابتداؤها","ومبتدآتٍ عنك صحت بأخبار",76,"ر",1,0],["واخبرهُ عنّي أنني في حالةٍ","فارقتُ منها في الدُّجى طيفَ الكرى",77,"ر",2,0],["وأخبط بين أوهام كأني","أرى حلماً وما أنا في سبات",78,"ت",1,0],["وَأَخبار وَصل فيكَ كانَ ابتِداؤُها","أَتعقل أَخبار وَما ثم مبتدا",79,"د",2,0],["وإخباره بالأمر من قبل كونه","وعند بواديه بما في العواقب",80,"ب",1,0],["واخبب كهاجر يوم خلفت ابنها","ملقى من الظمأ الشديد سقيما",81,"م",2,0],["وأخبر سيف به حدّه","وأكرم مثواه حتى انفصل",82,"ل",1,0],["وأخبار خيبر معلومة","وإني خبير بها إن تسل",82,"ل",1,0],["وأخبرْه مستفهِماً عني سأَنشُده","عسى يرقُّ لقلب صار كالحِمَم",83,"م",1,0],["واخبر متى ما شئت اخلاصي تبن","لك نية المصفي من المتجمل",84,"ل",1,0],["وأخباره تروَى فتروي من الظما","وتعلو على الزُهر الغوالي طوالها",85,"ل",3,0],["وأَخبثنا عند المطاعم مطعماً","وأَوخمنا عند المشاربِ مَشربَا",86,"ب",2,0],["وَأخبَرُوا بِظَرفٍ أو بِحَرفِ جَرّ","ناوِينَ مَعنَى كأنٍ أوِ استَقَرّ",87,"ر",1,0],["وَأخبَرُوا بالثنَينِ أو بِأكثَرَا","عن وَاحِدٍ كهُم سَرَاةٌ شُعَرَا",87,"ر",2,0],["وَأخبَرُ واهُنَا بِأل عَن بَعضِ مَا","يَكُونُ فِيهِ الفِعلُ قَد تَقَدَّمَا",87,"م",2,0],["واخبراه بحديث مسلمٍ","ولا ارى يخفى عليه من نبا",88,"ب",2,0],["واخبراني هل لعيشي سالف","لعبت فيه يد البين وصول",89,"ل",1,0],["واخبُر طِباعَكَ بامتِنا","عِكَ عن هواكَ وعِظم باسِك",90,"ك",1,0],["وأخبث ما ترى قوماً أساءوا","وداء ماله أَبداً دَواءُ",91,"ا",2,0],["وأخبري المقدادَ من بعدهِ","بأنَّ عبداللهِ أضحى سليب",92,"ب",1,0],["وأخبر عن الملكوت كيف رأيته","أن الغريب عن الغرايب يخبر",93,"ر",1,0],["وَأخبَرَ اللهُ بِعَجزِ الإِنسِ","وَالجِنَّ عَن إتيانِهِم بِالجِنسِ",94,"س",1,0],["وَأَخبارُهُ عَن مَحوِ ظُلم صَحيفَة","أَتَتها قُرَيش فيهِ لِلعاقِل الرُشد",95,"د",1,0],["وَأَخبارُهُ بِالغَيبِ لَم تَحصُ كَثرَة","بِما فيهِ عَن إِدراكِ أَهلش الحُجى سَد",95,"د",1,0],["واخبر المولى ابن يحيى انني","فيه قد أصبحت صباً مستهاما",96,"م",2,0],["وأخبارُ هذي الحربِ تَتْرَى جديدة","حروبٌ لعمرُ اللهِ أيُّ حروبِ",97,"ب",1,0],["وأخبار بحسن الذكر سارت","بها الركبان من حَضَرٍوبادي",98,"د",2,0],["واخبر رجال الحيّ عنّي قائلاً","غادرته في البصرة الفيحاء",99,"ا",2,0],["وأخبارهم عين الحياة بعينها","وهيهات ما أدراك يا صاح ماهيه",100,"ي",2,0],["وأخبار أخيار الاحبار كم","بمقدمه شنفت مسمعا",101,"ع",2,0],["وأخبر عن أنباء ما سطر الأولى","وعن محدث يأتي لازناده سقط",102,"ط",1,0],["واخبرهُ كيف اعتدى في جورهِ 