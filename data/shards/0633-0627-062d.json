{"poems":[[53,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[63,"سل الدهر عني أي خطب أمارس","https://www.aldiwan.net/poem46145.html","الطويل"],[3,"ألا من مبلغ أهل الجحود","https://www.aldiwan.net/poem142.html",""],[55,"غضبت لأن جاد الرقاد بنظرة","https://www.aldiwan.net/poem26111.html","الطويل"],[55,"أزين نساء العالمين أجيبي","https://www.aldiwan.net/poem26547.html","الطويل"],[77,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[73,"سأحب أعدائي لأنك منهم","https://www.aldiwan.net/poem11882.html","الكامل"],[10,"ألا ما لعينك أم ما لها","https://www.aldiwan.net/poem21129.html","المتقارب"],[88,"وبيضاء أغناها عن الحلي ثغرها","https://www.aldiwan.net/poem44839.html","الطويل"],[27,"أخالد عاد وعدكم خلابا","https://www.aldiwan.net/poem5685.html","الوافر"],[27,"لمن طلل هاج الفؤاد المتيما","https://www.aldiwan.net/poem6019.html","الطويل"],[51,"سأحمد بعد اللّه في كل مشهد","https://www.aldiwan.net/poem61828.html","الطويل"],[51,"حاجتي أيها الأمير كتاب","https://www.aldiwan.net/poem65437.html","الخفيف"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[91,"سكت خوفا وقلت الصفح من خلقي","https://www.aldiwan.net/poem62725.html","عموديه"],[70,"أجارتنا حق الجوار عظيم","https://www.aldiwan.net/poem42700.html","الكامل"],[70,"أعاتبكم يا أهل ودي وقد بدت","https://www.aldiwan.net/poem42759.html","الطويل"],[85,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[85,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[62,"إن العيون إذا نطقت تخاوصت","https://www.aldiwan.net/poem52341.html","الكامل"],[62,"سأحجب عني أسرتي عند عسرتي","https://www.aldiwan.net/poem52513.html","الطويل"],[45,"سلام عليكم لا وفاء ولا عهد","https://www.aldiwan.net/poem63506.html","الطويل"],[45,"ناهيك من حرق أبيت أقاسي","https://www.aldiwan.net/poem64589.html","الطويل"],[45,"على أي أمر مشكل أتلوم","https://www.aldiwan.net/poem65664.html","الطويل"],[61,"سأحتج للملحي أقوم حجة","https://www.aldiwan.net/poem51743.html","الطويل"],[44,"صرد ونكد وزند أنت معذور","https://www.aldiwan.net/poem30037.html","البسيط"],[44,"أبو علي وسمي منتجعه","https://www.aldiwan.net/poem30461.html","المنسرح"],[44,"أأطلال هند ساء ما اعتضت من هند","https://www.aldiwan.net/poem30544.html","الطويل"],[87,"يا قرير العين بالوسن","https://www.aldiwan.net/poem8234.html","المديد"],[105,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[21,"الحمد لله ممسانا ومصبحنا","https://www.aldiwan.net/poem36147.html","البسيط"],[52,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[75,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[46,"سبح الله طالع مستنير","https://www.aldiwan.net/poem23273.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85435","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85472","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39678","الرمل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9921","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54777","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54565","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43901","الوافر"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5177","الرمل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9997","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[106,"مولد الهادي الأمين","https://www.poetsgate.com/ViewPoem.aspx?id=179620",""],[128,"خليلي إن الهم والحزن خيما","https://www.aldiwan.net/poem50509.html","الطويل"],[132,"جعلت بيننا الرباب النمو ما","https://www.aldiwan.net/poem54747.html","الخفيف"],[142,"من رأى المجد يثير القلاصا","https://www.aldiwan.net/poem58437.html","الخفيف"],[155,"بدر ليل أولا فشمس نهار","https://www.aldiwan.net/poem55704.html","الخفيف"],[167,"واحة الوجه","https://www.aldiwan.net/poem1035.html",""],[204,"أحب فمن ذا الذي أخلفه","https://www.aldiwan.net/poem53251.html","المتقارب"],[211,"جاد بالوعد في زمان بخيل","https://www.aldiwan.net/poem46272.html","الخفيف"],[223,"وشفيت غلواء من آلامها","https://www.aldiwan.net/poem39706.html","الرجز"],[226,"الحب المكروه","https://www.aldiwan.net/poem24229.html","عموديه"],[235,"أترضون يا أهل بغداذ لي","https://www.aldiwan.net/poem32092.html","المتقارب"],[250,"سار والقلب في يديه مقيم","https://www.aldiwan.net/poem15026.html","الخفيف"],[254,"طيف","https://www.aldiwan.net/poem36223.html","مجزوء الرمل"],[261,"ربع أسماء لا عداك عنان","https://www.aldiwan.net/poem38168.html","الخفيف"],[270,"تولى شبابي والشباب هو الشرخ","https://www.aldiwan.net/poem35200.html","الطويل"],[270,"أفيقي فردي بسمة وسلاما","https://www.aldiwan.net/poem35622.html","الطويل"],[270,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[275,"ما للهوى إلا الرصافة مأرب","https://www.aldiwan.net/poem25635.html","الكامل"],[282,"أيها الحاديان حثا العيسا","https://www.aldiwan.net/poem32729.html","الخفيف"],[282,"عد عن العين واليعافير","https://www.aldiwan.net/poem32764.html","المنسرح"],[282,"من لصب لم تخب في الحب ناره","https://www.aldiwan.net/poem32772.html","الخفيف"],[282,"بدر الدجى شمس الضحى","https://www.aldiwan.net/poem32816.html","مجزوء الرجز"],[304,"حي ظبي الرمال والأطلال","https://www.aldiwan.net/poem16833.html","الخفيف"],[305,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[328,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[328,"قبل أن يبصر الظلام الضياء","https://www.aldiwan.net/poem54981.html","الخفيف"],[349,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[364,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[380,"إذا هب علوي تنفس عن جمر","https://www.aldiwan.net/poem49254.html","الطويل"],[416,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[416,"بدا والصبح غار على الظلام","https://www.aldiwan.net/poem54132.html","الوافر"],[429,"جاء يثني عطفه الميد","https://www.aldiwan.net/poem40065.html","المديد"],[429,"جد وحدث عن العيون الكحال","https://www.aldiwan.net/poem41401.html","الخفيف"],[432,"هل لركب العراق بعد نجوده","https://www.aldiwan.net/poem12470.html","الخفيف"],[432,"ألم به طيف الخيال مسلما","https://www.aldiwan.net/poem12475.html","الطويل"],[432,"أعن وسن ترنو عيونك أم سكر","https://www.aldiwan.net/poem12797.html","الطويل"],[437,"صب براه بعدهم طول الأرق","https://www.aldiwan.net/poem2500.html","الرجز"],[453,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[453,"وسائلة هل تقرض الشعر فطر","https://www.aldiwan.net/poem61792.html","الطويل"],[458,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[458,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[468,"ووضيع يقاوم الشرفاء","https://www.aldiwan.net/poem60515.html","الخفيف"],[479,"أطلق الشوق دمعتي","https://www.aldiwan.net/poem37067.html","مجزوء الخفيف"],[479,"سلا تونسا عني وعنها سلانيا","https://www.aldiwan.net/poem37589.html","الطويل"],[515,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[515,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[515,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[551,"هل ليالي بالمنقى رجوع","https://www.aldiwan.net/poem47718.html","الخفيف"],[575,"مدحت السرى وهي الحقيقة بالم","https://www.aldiwan.net/poem3019.html","الطويل"]],"verses":[["سَأَحمَدُ عَيشاً صانَ وَجهي بِمائِهِ","وَإِن كانَ ما أَعطى قَليلاً مُصَرَّدا",0,"د",2,0],["سأحمِلُ أعْباءَ الخُطوبِ فَطالَما","تَماشَتْ على الأيْنِ الجِمالُ القَناعِسُ",1,"س",1,0],["سَأَحمِلُ بِالأُسودِ عَلى أُسودٍ","وَأَخضِبُ ساعِدي بِدَمِ الأُسودِ",2,"د",1,0],["سَأَحجُبُ عَن عَيني الكَرى وَأَذودُهُ","بِذِكرِكِ فَاِرضَي لَستُ ما عِشتُ أَحلَمُ",3,"م",1,0],["سَأَحفَظُ ما قَد كانَ بَيني وَبَينَكُم","وَأَرعاكُمُ في مَشهَدي وَمَغيبي",4,"ب",2,0],["سَاحَ الْبَيَاضُ الْبَحْتُ تَحْتَ جَنَاحِهِ","فَتَراهُ فِي شِيَةِ الْغُرَابِ الأَعْصَمِ",5,"م",1,0],["سَأُحِبُّ أَعدائي لِأَنَّكِ مِنهُمُ","يا مَن يُصِحُّ بِمُقلَتَيهِ وَيُسقِمُ",6,"م",1,1],["سَأَحمِلُ نَفسي عَلى آلَةٍ","فَإِمّا عَلَيها وَإِمّا لَها",7,"ل",3,0],["سأحمل ما قد حَمَّلَتني يد الهوى","من الوجد حتى يحملوني إلى القبر",8,"ر",1,0],["سَأَحفَظُ ما زَعَمتِ لَنا وَأَرعى","إِيابَ الوُدِّ إِنَّ لَهُ إِيابا",9,"ب",2,0],["سَأَحمَدُ يَربوعاً عَلى أَنَّ وِردَها","إِذا ذيدَ لَم يُحبَس وَإِن ذادَ حَكَّما",10,"م",2,0],["سأحمد بعد اللّه في كل مشهدِ","أبا حسن أعني عليَّ بنَ أحمدِ",11,"د",1,1],["ساحرٌ ماهر لو استعطف البي","ض لشيب الرجال جدن بعطف",12,"ف",1,0],["ساحتْ مواردُهُ فليسَ رشاؤهُ","إلا شرائعَ سُهِّلَتْ تسهيلا",13,"ل",2,0],["سَأَحبِسَنَّ لِساني عَنكَ عَن شَمَمٍ","وَحُرمَةً لِءُهَيلِ الوُدِّ وَالذِمَمِ",14,"م",1,0],["سَأَحفَظُ ما بَيني وَبينَكَ في الهَوى","وَلو أَنَّني تَحتَ التُرابِ رَميمُ",15,"م",1,0],["سَأَحمِلُ عَنكُم كُلَّ ما فيهِ كُلفَةٌ","وَأَقنَعُ مِنكُم في الكَرى بِخَيالِ",16,"ل",1,0],["ساحِرٌ فِتنَةَ العُيونِ مُبينٌ","فَصَّلَ الماءَ في الرُبا بِجُمانِه",17,"ن",2,0],["ساحَةُ العَيشِ إِلى اللَهِ الَّذي","جَعَلَ الوِردَ بِإِذنٍ وَالصَدَر",18,"ر",1,0],["ساحتْ على روضٍ سَقاهُ رُضابَه","لُعْسُ الغوادي الغُرْزِ وهي هوامع",19,"ع",1,0],["سأحجُبُ عنّي أُسرتي عند عسرتي","وأبرز فيهم إِنْ أصبت ثراءَ",20,"ا",2,1],["سَأَحمِلُ نَفسي عِندَ كُلِّ مُلِمَّةٍ","عَلى مِثلِ حَدِّ السَيفِ أَخلَصَهُ الهِندُ",21,"د",1,0],["ساحَت مَواهِبُهُ فَلَم تُحوِج إِلى","جَذبِ الدِلاءِ تُمَدُّ بِالأَمراسِ",22,"س",1,0],["سَأَحمِلُ نَفسي عَنكَ حَملَ مُجامِلٍ","وَأُكرِمُها إِن كانَتِ النَفسُ تُكرَمُ",23,"م",1,0],["سأحتجُّ للمِلحيِّ أَقْوَمَ حُجَّةٍ","وإن كانَ شِعْري من ظُباهُ جَريحا",24,"ح",2,1],["ساحاتُ سوءٍ بِحَمدِ اللَهِ مَيِّتَةٌ","فيها العُلا حَيَّةٌ فيها الزَنابيرُ",25,"ر",1,0],["ساحِرِ نَظمٍ سِحرَ البَياضِ مِنَ ال","أَلوانِ سائِبِهِ خَبِّهِ خَدِعِه",26,"ع",2,0],["سَأَحمَدُ نَصراً ما حَيِيتُ وَإِنَّني","لَأَعلَمُ أَن قَد جَلَّ نَصرٌ عَنِ الحَمدِ",27,"د",1,0],["سَاحِرُ الْعَيْنَيْنِ مَا بَرِحَتْ","لَحْظَتَاهُ مَصْدَرَ الْفِتَنِ",28,"ن",1,0],["سأحفظها على نعرات قوم","هم الهدام لو كشف النقاب",29,"ب",1,0],["ساحرٌ آناً وآناً شاعرٌ","ما رأوا من سحرِهِ ماذا قَصَدْ",30,"د",1,0],["ساحي أَياطِلَهُم لَم يَنزَعوا تَفَثاً","وَلَم يَسلُّوا لَهُم قَملاً وصئِباناً",31,"ن",2,0],["ساحِبُ ذَيلٍ جَحفَلٍ يَملَءُ الأَر","ضَ كَما عَمَّ حافَتَيهِ الأَتِيُّ",32,"ي",1,0],["ساحَتْ رجالٌ في القِفَارِ وإنّه","لَيَسِحُ في مَلَكُوتِ طَرْفٍ مُسْهَدِ",33,"د",1,0],["ساحِباً من ذُيولِ مَجْرٍ لُهامٍ","تُؤذِنُ الأرضُ تحْتَهُ باصْطِفاق",34,"ق",1,0],["ساحِلِيّونَ لَم أُرِد ساحِلَ البَح","رِ وَلَكِن نَسباً لِأَقمَرَ ساحِل",35,"ل",1,0],["سأَحبس مني الطرف في أخرياتها","لأعلم هَل للآفلات طلوع",36,"ع",1,0],["سأحث في ظلمات ليل حالك","سَيري إلى عدم بغير دَليل",37,"ل",1,0],["سأحفظ العهد مِنكَ دوما","وأقطع العمر في انتظارِكْ",38,"ك",1,0],["ساحة الباستيل حانَ الملتقى","وتعالت صرخة الفجر الوليد",39,"د",1,0],["سَأَحلُمُ عَن قَومي وَلَو سَفَكوا دَمي","وَأَجرَعُ فيكِ الصَبرَ دونَ المَلا وَحدي",40,"ي",1,0],["سَاحِرٌ بَيْنَ زُرْقَةٍ وَاخْضِرَارٍ","لُبَّ رَائِيهِ بِائْتِلاَفٍ فَرِيدِ",41,"د",1,0],["سَأَحْفَظُ حَقَّهَا المَرْعِيَّ حِفْظاً","يَطُولُ مَدَاهُ مَا طَالَ المَدَى بِي",42,"ب",2,0],["سأحمِلُ من تُرابكَ في رِحالِي","لكي أغني بهِ عن كلِّ طيبِ",43,"ب",1,0],["ساحَةٌ إِن يَعتَمِدها يَعتَرِف","ناشِدُ السُؤدُدِ فيها ما أَضَل",44,"ل",1,0],["ساحَقَت أُمُّهُ وَلاطَ أَبوهُ","لَيتَ شِعري عَنهُ فَمِن أَينَ جاءَ",45,"ا",2,0],["ساحباً ذَيْلَه يَمُرُّ على الزهْرِ","فَتَمْضِي الزُهورُ في الأَذيال",46,"ل",1,0],["ساحرًا لا بحبلِهِ وعصاهُ","بل بِخُلْقٍ سَمْحٍ يَروضُ الأسودا",47,"د",2,0],["سأحنى لها ظَهْري وأحملُ ثقلها","ولو حطمتَ مِنّي قناةً وأعظمَا",48,"م",2,0],["سَأُحَلِّيكَ مِن لآلِىِ القَوافي","سُبَّةً تُفسِدُ الحِجَا والأدِيمَا",49,"م",2,0],["ساحر الألفاظ ولو شاء ظبيا","أسر الوحش بهنَّ اقتناصا",50,"ص",2,0],["سَاحِباً ذَيْلَ فاضِلٍ وهوَ عاري الظ","ظَهْرِ فيهِ من لُبْسِ ثَوْبِ العَارِ",51,"ر",1,0],["ساح