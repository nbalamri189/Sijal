em.aspx?id=185317",""],[5791,"حيود في نسق المحبرة ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208644",""],[5809,"ذنوب","https://www.poetsgate.com/ViewPoem.aspx?id=205568",""],[5829,"الى وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=153240",""],[5923,"في العيد","https://www.poetsgate.com/ViewPoem.aspx?id=146240",""],[5931,"دمعة الفقد !","https://www.poetsgate.com/ViewPoem.aspx?id=181122",""],[5943,"نبضُ القلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=11703",""],[5952,"غنائي ندائي","https://www.poetsgate.com/ViewPoem.aspx?id=205982",""],[5956,"مفكِّر بحبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=181933",""],[5956,"طيف الحبيبة الميّتة","https://www.poetsgate.com/ViewPoem.aspx?id=182160",""],[5956,"سأدخل للقبر قربك أبكي","https://www.poetsgate.com/ViewPoem.aspx?id=192103",""],[5956,"الله علّمنا الكثير لنهتدى","https://www.poetsgate.com/ViewPoem.aspx?id=192648",""],[5956,"أدعو إلهي أن يعيدك هانئاً","https://www.poetsgate.com/ViewPoem.aspx?id=194106",""],[5956,"تتنعمان بجدة حنّانة (والحمد لله)","https://www.poetsgate.com/ViewPoem.aspx?id=205166",""],[5970,"ساحة الأرض ضيقت بي فهاتوا","https://www.poetsgate.com/ViewPoem.aspx?id=130613",""],[6052,"أنت المنار","https://www.poetsgate.com/ViewPoem.aspx?id=49595",""],[6068,"لُبنى -11-","https://www.poetsgate.com/ViewPoem.aspx?id=175839",""],[6093,"سأحمل الكلمات","https://www.poetsgate.com/ViewPoem.aspx?id=192261",""],[6115,"الرخوم اللى تهايط على الفاضي بلاش","https://www.poetsgate.com/ViewPoem.aspx?id=196462",""],[520,"لا وعيون لحظها ساحر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577520",""],[6167,"مطر الشجون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85560&r=&rc=43",""],[231,"النفس الضائعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79122&r=&rc=8",""],[6213,"غياب الأحبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76260&r=&rc=17",""],[5080,"بلالٌ دونَ مئذنةٍ أنايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88134&r=&rc=4",""],[4222,"لائم للمحب غير ملائم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52884&r=&rc=176",""],[5567,"مدار الفراغ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81817&r=&rc=67",""],[6355,"أنثى سجينة القلق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66653&r=&rc=113",""]],"verses":[["سَأَحمَدُ عَيشاً صانَ وَجهي بِمائِهِ","وَإِن كانَ ما أَعطى قَليلاً مُصَرَّدا",0,"د",2,0],["سأحمِلُ أعْباءَ الخُطوبِ فَطالَما","تَماشَتْ على الأيْنِ الجِمالُ القَناعِسُ",1,"س",1,0],["سَأَحمِلُ بِالأُسودِ عَلى أُسودٍ","وَأَخضِبُ ساعِدي بِدَمِ الأُسودِ",2,"د",1,0],["سَأَحجُبُ عَن عَيني الكَرى وَأَذودُهُ","بِذِكرِكِ فَاِرضَي لَستُ ما عِشتُ أَحلَمُ",3,"م",1,0],["سَأَحفَظُ ما قَد كانَ بَيني وَبَينَكُم","وَأَرعاكُمُ في مَشهَدي وَمَغيبي",4,"ب",2,0],["سَاحَ الْبَيَاضُ الْبَحْتُ تَحْتَ جَنَاحِهِ","فَتَراهُ فِي شِيَةِ الْغُرَابِ الأَعْصَمِ",5,"م",1,0],["سَأُحِبُّ أَعدائي لِأَنَّكِ مِنهُمُ","يا مَن يُصِحُّ بِمُقلَتَيهِ وَيُسقِمُ",6,"م",1,1],["سَأَحمِلُ نَفسي عَلى آلَةٍ","فَإِمّا عَلَيها وَإِمّا لَها",7,"ل",3,0],["سأحمل ما قد حَمَّلَتني يد الهوى","من الوجد حتى يحملوني إلى القبر",8,"ر",1,0],["سَأَحفَظُ ما زَعَمتِ لَنا وَأَرعى","إِيابَ الوُدِّ إِنَّ لَهُ إِيابا",9,"ب",2,0],["سَأَحمَدُ يَربوعاً عَلى أَنَّ وِردَها","إِذا ذيدَ لَم يُحبَس وَإِن ذادَ حَكَّما",10,"م",2,0],["سأحمد بعد اللّه في كل مشهدِ","أبا حسن أعني عليَّ بنَ أحمدِ",11,"د",1,1],["ساحرٌ ماهر لو استعطف البي","ض لشيب الرجال جدن بعطف",12,"ف",1,0],["ساحتْ مواردُهُ فليسَ رشاؤهُ","إلا شرائعَ سُهِّلَتْ تسهيلا",13,"ل",2,0],["سَأَحبِسَنَّ لِساني عَنكَ عَن شَمَمٍ","وَحُرمَةً لِءُهَيلِ الوُدِّ وَالذِمَمِ",14,"م",1,0],["سَأَحفَظُ ما بَيني وَبينَكَ في الهَوى","وَلو أَنَّني تَحتَ التُرابِ رَميمُ",15,"م",1,0],["سَأَحمِلُ عَنكُم كُلَّ ما فيهِ كُلفَةٌ","وَأَقنَعُ مِنكُم في الكَرى بِخَيالِ",16,"ل",1,0],["ساحِرٌ فِتنَةَ العُيونِ مُبينٌ","فَصَّلَ الماءَ في الرُبا بِجُمانِه",17,"ن",2,0],["ساحَةُ العَيشِ إِلى اللَهِ الَّذي","جَعَلَ الوِردَ بِإِذنٍ وَالصَدَر",18,"ر",1,0],["ساحتْ على روضٍ سَقاهُ رُضابَه","لُعْسُ الغوادي الغُرْزِ وهي هوامع",19,"ع",1,0],["سأحجُبُ عنّي أُسرتي عند عسرتي","وأبرز فيهم إِنْ أصبت ثراءَ",20,"ا",2,1],["سَأَحمِلُ نَفسي عِندَ كُلِّ مُلِمَّةٍ","عَلى مِثلِ حَدِّ السَيفِ أَخلَصَهُ الهِندُ",21,"د",1,0],["ساحَت مَواهِبُهُ فَلَم تُحوِج إِلى","جَذبِ الدِلاءِ تُمَدُّ بِالأَمراسِ",22,"س",1,0],["سَأَحمِلُ نَفسي عَنكَ حَملَ مُجامِلٍ","وَأُكرِمُها إِن كانَتِ النَفسُ تُكرَمُ",23,"م",1,0],["سأحتجُّ للمِلحيِّ أَقْوَمَ حُجَّةٍ","وإن كانَ شِعْري من ظُباهُ جَريحا",24,"ح",2,1],["ساحاتُ سوءٍ بِحَمدِ اللَهِ مَيِّتَةٌ","فيها العُلا حَيَّةٌ فيها الزَنابيرُ",25,"ر",1,0],["ساحِرِ نَظمٍ سِحرَ البَياضِ مِنَ ال","أَلوانِ سائِبِهِ خَبِّهِ خَدِعِه",26,"ع",2,0],["سَأَحمَدُ نَصراً ما حَيِيتُ وَإِنَّني","لَأَعلَمُ أَن قَد جَلَّ نَصرٌ عَنِ الحَمدِ",27,"د",1,0],["سَاحِرُ الْعَيْنَيْنِ مَا بَرِحَتْ","لَحْظَتَاهُ مَصْدَرَ الْفِتَنِ",28,"ن",1,0],["سأحفظها على نعرات قوم","هم الهدام لو كشف النقاب",29,"ب",1,0],["ساحرٌ آناً وآناً شاعرٌ","ما رأوا من سحرِهِ ماذا قَصَدْ",30,"د",1,0],["ساحي أَياطِلَهُم لَم يَنزَعوا تَفَثاً","وَلَم يَسلُّوا لَهُم قَملاً وصئِباناً",31,"ن",2,0],["ساحِبُ ذَيلٍ جَحفَلٍ يَملَءُ الأَر","ضَ كَما عَمَّ حافَتَيهِ الأَتِيُّ",32,"ي",1,0],["ساحَتْ رجالٌ في القِفَارِ وإنّه","لَيَسِحُ في مَلَكُوتِ طَرْفٍ مُسْهَدِ",33,"د",1,0],["ساحِباً من ذُيولِ مَجْرٍ لُهامٍ","تُؤذِنُ الأرضُ تحْتَهُ باصْطِفاق",34,"ق",1,0],["ساحِلِيّونَ لَم أُرِد ساحِلَ البَح","رِ وَلَكِن نَسباً لِأَقمَرَ ساحِل",35,"ل",1,0],["سأَحبس مني الطرف في أخرياتها","لأعلم هَل للآفلات طلوع",36,"ع",1,0],["سأحث في ظلمات ليل حالك","سَيري إلى عدم بغير دَليل",37,"ل",1,0],["سأحفظ العهد مِنكَ دوما","وأقطع العمر في انتظارِكْ",38,"ك",1,0],["ساحة الباستيل حانَ الملتقى","وتعالت صرخة الفجر الوليد",39,"د",1,0],["سَأَحلُمُ عَن قَومي وَلَو سَفَكوا دَمي","وَأَجرَعُ فيكِ الصَبرَ دونَ المَلا وَحدي",40,"د",2,0],["سَاحِرٌ بَيْنَ زُرْقَةٍ وَاخْضِرَارٍ","لُبَّ رَائِيهِ بِائْتِلاَفٍ فَرِيدِ",41,"د",1,0],["سَأَحْفَظُ حَقَّهَا المَرْعِيَّ حِفْظاً","يَطُولُ مَدَاهُ مَا طَالَ المَدَى بِي",42,"ب",2,0],["سأحمِلُ من تُرابكَ في رِحالِي","لكي أغني بهِ عن كلِّ طيبِ",43,"ب",1,0],["ساحَةٌ إِن يَعتَمِدها يَعتَرِف","ناشِدُ السُؤدُدِ فيها ما أَضَل",44,"ل",1,0],["ساحَقَت أُمُّهُ وَلاطَ أَبوهُ","لَيتَ شِعري عَنهُ فَمِن أَينَ جاءَ",45,"ا",2,0],["ساحباً ذَيْلَه يَمُرُّ على الزهْرِ","فَتَمْضِي الزُهورُ في الأَذيال",46,"ل",1,0],["ساحرًا لا بحبلِهِ وعصاهُ","بل بِخُلْقٍ سَمْحٍ يَروضُ الأسودا",47,"د",2,0],["ساحر الطرف سقيم جفنه","قمري الوجه ليليُّ الشعر",48,"ر",1,1],["سأحنى لها ظَهْري وأحملُ ثقلها","ولو حطمتَ مِنّي قناةً وأعظمَا",49,"م",2,0],["سَأُحَلِّيكَ مِن لآلِىِ القَوافي","سُبَّةً تُفسِدُ الحِجَا والأدِيمَا",50,"م",2,0],["ساحر الألفاظ ولو شاء ظبيا","أسر الوحش بهنَّ اقتناصا",51,"ص",2,0],["سَاحِباً ذَيْلَ فاضِلٍ وهوَ عاري الظ","ظَهْرِ فيهِ من لُبْسِ ثَوْبِ العَارِ",52,"ر",1,0],["ساحة ُ الوجهِ وإبداعُ المحيَّا","كتبا شعراً بأعصابي شجيَّا",53,"ي",2,0],["سأحلم حتى يقولوا شأى","معاويةَ الحلمَ أو أحنَفَه",54,"ف",2,0],["ساحراً أنت يا فؤاد فقل لي","كيف ضاع الفؤاد ضاع الفؤاد",55,"د",1,0],["ساحِبَةً وشاحَها الرَمادي","عَن جَسَدِ الأَعشابِ وَالأَورادِ",56,"د",1,0],["سأحيا خامد الحس","فلا حب ولا أمل",57,"ل",1,0],["سَأَحتَقِبُ الصَبرَ مُستَأنِياً","لَعَلَّ عَواقِبَهُ تُحمَدُ",58,"د",1,0],["ساحرُ المقلتينِ فاعجب لقلب","نفذَ السحرُ فيه وهو الكليمُ",59,"م",1,0],["ساحري بدِّدْ غيوم ال","حزن تُسْتجلى الهمومُ",60,"م",1,0],["ساحب بردتي كمال ولطف","وعفيف ما ضمت القمصان",61,"ن",1,0],["سأحفظ عهدَ الأهلِ والدارِ في النَّوى","وليسَ لهذا العهدِ شرطٌ ولا فسخ",62,"خ",1,0],["سأحيا بذكراكِ التي هي كلُّها","فضائلُ تبقى إن غدوتِ رماما",63,"م",2,0],["سأحملُ عبءَ العيشِ رفقاً بقلبها","فأُحسَبُ من أهلِ الفضيلةِ والفضل",64,"ل",1,0],["ساحاتُ حُسْنٍ طَرّزَتْ أوقَاتَها","ساعاتُ أنسٍ رَدُّها مُسْتَصْعَبُ",65,"ب",1,0],["ساحِراتٍ يَردُدنَ مَن كانَ بِالسِّح","رِ كَما رَدَّ كَيدَ فِرعَونَ موسى",66,"س",2,0],["ساحَ بِها الماءُ بَينَ مُرتفِعٍ","وَذي انتِصابٍ وَبَينَ مَجرورِ",67,"ر",1,0],["ساحِرُ اللَحظِ لَو رَأى نَفثَهُ مو","سَى لأَعيَت عَلى العَصا أَسحارُه",68,"ر",2,0],["ساحِرُ طَرفٍ مِنهُ ها","روتُ اِنثَنى مُفتَضِحا",69,"ح",2,0],["ساحر الطرف وردى الخد باني ال","قد عزيز الوصال صعب المنال",70,"ل",1,0],["ساحباً مِن غضارةِ العيش برداً",