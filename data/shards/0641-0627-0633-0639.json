 مبشّراً فاستبشر","https://www.poetsgate.com/ViewPoem.aspx?id=108052",""],[5145,"ردّ المدامة عني أيها الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=108137",""],[5183,"إلى حادي العزائم","https://www.poetsgate.com/ViewPoem.aspx?id=180221",""],[5186,"\"من \"\"البرج\"\" في كانون والليل خيما","https://www.poetsgate.com/ViewPoem.aspx?id=156441",""],[5295,"إنها مصر","https://www.poetsgate.com/ViewPoem.aspx?id=210866",""],[5419,"أجئ إليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=35287",""],[5582,"هَبَّتْ تُغَرِّدُ مِنْ فَوْقِ الأَمالِيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63490",""],[5644,"مازلت أستعصي على الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=199968",""],[5701,"شيطانة من بنات الأنس لاعبة","https://www.poetsgate.com/ViewPoem.aspx?id=164652",""],[5956,"بم أواجه كل شيئ؟","https://www.poetsgate.com/ViewPoem.aspx?id=192603",""],[6093,"يا مَائِلَ السَّرْح أمْرُ الحبِّ أضناكا","https://www.poetsgate.com/ViewPoem.aspx?id=176438",""],[6093,"مشوار قصير","https://www.poetsgate.com/ViewPoem.aspx?id=181567",""],[5014,"حديث الشمس للقمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76223&r=&rc=19",""],[6259,"وليَّ ولم يقض من أحبابه وطرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59376&r=&rc=24",""]],"verses":[["فَاِسعَد أَبا سَعدٍ بِإِقبالِهِ","فَالهَديُ مَجنوبٌ إِلى النَحرِ",0,"ر",1,0],["فَاِسعَد بِهِ وَبِأَيّامٍ طُرِفنَ بِهِ","إِنَّ العَزيزَ عَلى العِلّاتِ مَسعودُ",1,"د",1,0],["فَاسْعَدْ أَمِيرَ المُسْلِمِيْنَ بِطَالِعِ","يُنْمَى إِلَيْهِ الحَرْبُ وَالْمِحْرَابُ",2,"ب",1,0],["فَأَسعِدنا بِنَشرِ العِلمِ وَاِعلَم","بِأَنَّ النَقصَ يَعقُبُهُ التَمامُ",3,"م",1,0],["فَأَسعَدتُ نَفساً بِالهَوى قَبلَ أَن أَرى","عَوادي نَأيٍ بَينَنا وَشُغولِ",4,"ل",1,0],["فاسعَ إليه بعزمِ ذي جَلَد","مُصمّم الرأي غير مضطربه",5,"ب",2,0],["فاسعدْ بنيروزك المسعودِ طالعهُ","يا ابن الأَكارم في خَفضٍ ونعماءِ",6,"ا",2,0],["فاسْعدْ به وبأعيادٍ تُعمّرها","في ظل عيشٍ ورَيقِ العُود مَيَّادِ",7,"د",1,0],["فاسعدْ بفضل أمانتي وكفايتي","ونصيحتي مع أنَّني بك أسعدُ",8,"د",1,0],["فاسعد بطول حياته أبداً","يفضي به حَرْسٌ إلى حَرس",9,"س",1,0],["فاسع لشكري تجده حينئذ","شكر قدير تعجَّل الخلفا",10,"ف",2,0],["فاسعَدْ بذاك اليُمْنِ واحظَ به","واضمُمْ عليه الكفَّ من أَمَمِ",11,"م",1,0],["فَاِسعوا لِنَشرِ العِلمِ فيهِم إِنَّما","فَضلُ الغَمامِ يُبينُ في الأَمحالِ",12,"ل",1,0],["فاسعَ لعقباك فقد كفيتا","مؤونة الدنيا بما أوتيتا",13,"ت",2,0],["فاسعد بما أوتيتَ من حكمة","واعمر بها عقباك فهي المصير",14,"ر",1,0],["فأسعدُ االناسِ منْ حوتْ يدُه","ما شاء من لُؤلؤٍ إِلى ذهبِ",15,"ب",1,0],["فَأَسعُدُهُ عَلى قَومٍ نُحوسٍ","وَأَنحُسُهُ عَلى قَومٍ سُعودُ",16,"د",1,0],["فَاِسعَد بِمَغفِرَةِ الإِلَهِ فَلَم يَزَل","يَهَبُ الذُنوبَ لِمَن يَشاءُ وَيَغفِرُ",17,"ر",1,0],["فاسعد أبا حسن بمؤنق حسنها","والق الزمان بما تحاول مسعدا",18,"د",2,0],["فآسعَدْ بِعيدٍ أعادَ الَّلهوَ في سَعَةٍ","واليُمْنَ في دَعَةٍ والعيشَ في رَغَدِ",19,"د",1,0],["فاسعَدْ بِدُنْيا بَدَتْ محاسِنُها","منكَ فأعطَتْك عيشةً رَغَدا",20,"د",2,0],["فأسعدَ جُودُه جَدّاً شقيّاً","وأشقى بأْسُه جَدّاً سَعيدا",21,"د",2,0],["فَاسْعَدْ بعيدٍ عادَ كوكبُ سَعْدِه","طَلْقَ الضِّياءِ مؤكَّدَ الأسبابِ",22,"ب",1,0],["فاسعَدْ بعافيةِ الإلهِ فإنها","هِبَةٌ مُقابَلَةٌ بشُكْرٍ واجبِ",23,"ب",1,0],["فَاَسعَد بِأَبكارِهِ لا زِلتَ في نِعَمٍ","تَرى مِنَ اللَهِ إِسعافاً وَإِسعادا",24,"د",2,0],["فَاِسعَد بِعيدٍ أَنتُمُ عيدٌ لَهُ","وَمَواسِمٍ بِكُمُ هَنا ميقاتِها",25,"ت",3,0],["فَاِسعَد بَعيدٍ بِهِ عادَ السُرورُ لَنا","وَعادَ شانيكَ في غَمٍّ وَتَكديرِ",26,"ر",1,0],["فَاسْعَدْ برزقِكَ وَاشْكُرْ مَن حَبَاكَ به","سُبحانَهُ مِن عظيمِ الفَضْلِ رزَّاقِ",27,"ق",1,0],["فاسْعَدْ بمَجْدٍ ويوْمٍ إذ سَلِمتَ لنا","فما يَزيدُ على أيّامِنا الأُخَرِ",28,"ر",1,0],["فأَسعفَ الأميرُ منهُ ما سألْ","وعادَ بالفَضْلِ عليهِ وقَفلْ",29,"ل",1,0],["فَاسْعَدْ وَدُمْ واغْنَم وَجُدْ وانْعَمْ وَسُدْ","وابْدَأْ وَعُدْ وَتَهَنَّ واسْلَمْ وَازْدَدِ",30,"د",1,0],["فَاسْعَدْ بِيَومٍ تَجَلَّى السَّعْدُ فِيهِ عَلَى","نَادِي عُلاكَ بِتَعْظِيمٍ وَتَوْقِيرِ",31,"ر",1,0],["فَاسْعَ لِمَا شِئْتَ غَيْرَ مُتَّئِدٍ","فَلَنْ يَحُوزَ الْكَمَالَ مُتَّئِدُ",32,"د",1,0],["فَأَسعَدنَ أَو أَسعَفنَ حَتّى تَقَوَّضَت","صُفوفُ الدُجى بِالفَجرِ مُنهَزِماتِ",33,"ت",1,0],["فاسْعدْ أميرَ المسلمين بطالع","يُمْنى إليه الحرْبُ والمحرابُ",34,"ب",1,0],["فاسعَدْ، أميرَ المُؤمنينَ، مُمَتَّعاً","بالعِزّ ما عَمَرَ الزّمانُ، وَما بَقي",35,"ق",2,0],["فاسعفني بهم واحلل عقا لي","عساي اعد بين الفائزين",36,"ن",1,0],["فاسعفنا برأفتهم وانعش","جسوما اصبحت مثل التلال",37,"ل",1,0],["فاسعف حماك الله بالقرب مدنفا","متى حضر الحادي وفيك حداغابا",38,"ب",2,0],["فاسعد عليُّ بحسن حظ وابتهج","ببشائر واهنأ بقرة ناظرِ",39,"ر",1,0],["فاسعوا لنا كرماً وطوفوا نحونا","فضلاً وزوروا بيت إسماعيلا",40,"ل",2,0],["فَاِسعَد بِعيدٍ يَتبَعُ النَبَأَ الَّذي","أَطرا لَنا فِعلَ اللَيالي إِذ طَرا",41,"ر",2,0],["فَاِسعَد بِعيدِكَ بَعدَ سابِقِهِ وَلا","نَظَرَت لِذا الظِلِّ العُيونُ زَوالا",42,"ل",2,0],["فَاِسعَد بِها وَبِهِ وَدُمتَ مُسَلَّما","ما طافَ بِالبَيتِ المُحَرَّمِ مُحرِمُ",43,"م",1,0],["فاسعَدْ بها مكسبا وأَنفِقْ","ما شئتَ منها بلا تَجزِّى",44,"ز",2,0],["فاسَعْد بعامِك واستقبلْ بَشائرَه","في نعمةٍ وبقاءٍ غيرِ منُصرِم",45,"م",1,0],["فاسعَدْ بوافدِ عيدِ النحرِ مُقتبِلا","أَمثالَه في سرورٍ ليس يَنصرِم",46,"م",1,0],["فاسعَ في الأرضِ إن عقبانَ هذا","الجوِ لا يرتضينَ منه مكانا",47,"ن",2,0],["فاسعدونا فقد شقينا بجهل","مطبق كالدجى وفقر وبؤس",48,"س",1,0],["فَاِسعَد بِها دَولَةً غَرّاءَ ما اِدَّرَعَت","بِمِثلِها حَميَرٌ قِدَماً وَساسانُ",49,"ن",1,0],["فَاِسعَد عِمادَ الدينِ مُغتَبِطاً بِمَي","مونِ القُدومِ مُبارَكِ الميلادِ",50,"د",1,0],["فَاِسعَد بِشَهرٍ مُؤذِنٍ","بِطائِرِ النَجاحِ",51,"ح",1,0],["فاسعد بيوم العيد واجلس له","في خلوةٍ جلسة مسرور",52,"ر",1,0],["فاسعد بهذا الدهر وأسعدنا به","لنفوز من أيامه بمفاز",53,"ز",1,0],["فَاسْعَدْ بِهِ دائِمَ النَّعْماءِ مُعْتَلِياً","عَلَى الزَّمانِ وَخَيْرُ الْعَيْشِ ما داما",54,"م",2,0],["فَاسْعَدْ وَدامَ لَكَ الْهَناءُ بِماجِدٍ","طالَتْ بِهِ الآمالُ وَهْيَ قِصارُ",55,"ر",1,0],["فاسْعَدْ وَبُشْراكَ بِها عِزَّةً","مَتى تَرُمْ صَهْوَتَها تَرْكَبِ",56,"ب",1,0],["فاسعد هنيئاً واغتنم","فالغانيات لنا لعب",57,"ب",1,0],["فَاِسعَد عَزيزي بِخَيرٍ وَفَوزِ","وَكُلُّ سُرورٍ بِ