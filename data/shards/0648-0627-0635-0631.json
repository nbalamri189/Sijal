,"https://poetry.dctabudhabi.ae/diwan/poem/123467","البسيط"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35092","الكامل"],[4702,"ماخبل من ابن الذيب غير الشبرمي","https://www.poetsgate.com/ViewPoem.aspx?id=155321",""],[4764,"إعدام طفله","https://www.poetsgate.com/ViewPoem.aspx?id=27084",""],[4767,"تجارة خاسرة","https://www.poetsgate.com/ViewPoem.aspx?id=179991",""],[4772,"هيا استفق","https://www.poetsgate.com/ViewPoem.aspx?id=191381",""],[4903,"وأصرَخَ صَلصَالٍ لأخدرَ يَنْتَمِي","https://www.poetsgate.com/ViewPoem.aspx?id=96542",""],[4914,"تموت ولم تبكك البارقات","https://www.poetsgate.com/ViewPoem.aspx?id=170936",""],[4955,"أسرج القلب بالتفاؤل تسعد","https://www.poetsgate.com/ViewPoem.aspx?id=204805",""],[4984,"عِيدِيَّةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204720",""],[5010,"يا رب حقق لي","https://www.poetsgate.com/ViewPoem.aspx?id=189897",""],[5183,"صرخة الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=185636",""],[5183,"كأس الكمي","https://www.poetsgate.com/ViewPoem.aspx?id=180187",""],[5206,"الدُّنيا والنفس","https://www.poetsgate.com/ViewPoem.aspx?id=187386",""],[5431,"هاتِ القصيدة واسكر أيها الثملُ","https://www.poetsgate.com/ViewPoem.aspx?id=189979",""],[5431,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=190113",""],[5431,"وإني انقلابٌ في الفصول وثورة","https://www.poetsgate.com/ViewPoem.aspx?id=197356",""],[5542,"صرخة مرصعة بالإخلاص","https://www.poetsgate.com/ViewPoem.aspx?id=10073",""],[5550,"سكر القلب","https://www.poetsgate.com/ViewPoem.aspx?id=211901",""],[5690,"اللّه يعطي والزمان يجودُ","https://www.poetsgate.com/ViewPoem.aspx?id=172143",""],[6046,"يا ذات الخمار","https://www.poetsgate.com/ViewPoem.aspx?id=35809",""],[6102,"مراهقة ..","https://www.poetsgate.com/ViewPoem.aspx?id=185048",""],[6310,"جمر الشتات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72001&r=&rc=5",""]],"verses":[["وَأَصرِفُ هِمَّتي عَن كُلِّ نِكسٍ","أَمَلَّ عَلى الضَمائِرِ كُلَّ بَرحِ",0,"ح",1,0],["وأصْرَحُهُمْ إذا انْتَسَبوا أصُولاً","وأعظَمُهُمْ إذا وَهَبوا سِجالا",1,"ل",2,0],["وَأَصرِفُ نَفسي إِلى غَيرِها","إِلى مَن يَكونُ بِصَرمي بَخيلا",2,"ل",2,0],["وأصْرَخْتَهُ لمّا دَعاكَ على النّوى","وواصَلَ ترْجيعَ النِّداءِ المَرَدَّدِ",3,"د",1,0],["وأصْرَخَ نصْرُ اللهِ دعْوَةَ صارخٍ","طوَيْتَ لهُ تحْتَ الدُّجى شُقّةَ البُعْدِ",4,"د",1,0],["وَاصْرِفْ بِصِرْفِ الرَّاحِ هَمّاً كَامِناً","وَاحِي السُّرُورَ تَنَعُّماً بِحَيَاتِهَا",5,"ت",3,0],["وأصرف آمالي التي قد تقسَّمت","إلى مرتجى ما باب نعماه مرتجا",6,"ج",2,0],["واصْرِفِ النفس إلى عَدنِيَّةٍ","ذَاتِ غُنْج ودلال ومَرَحْ",7,"ح",1,0],["وَاِصرَع بِها عَقلَ النَديمِ وَلُبَّهُ","ما نَغَّصَ الحاسي كَعَقلِ الحاسي",8,"س",2,0],["وَأَصرَعُ أَيَّ الوَحشِ قَفَّيتُهُ بِهِ","وَأَنزِلُ عَنهُ مِثلَهُ حينَ أَركَبُ",9,"ب",1,0],["وَاصرِف هَواكَ لِخَوفِهِ","فيما تُسِرُّ وَتُعلِنُ",10,"ن",1,0],["واصرفْ إليه الوَجْه عن مَعْشرٍ","قد صرَفوا عنك وُجوهَ القلوب",11,"ب",1,0],["وَأَصرِفُ وَجهي عَن بِلادٍ غَدا بِها","لِسانِيَ مَشكولا وَقَلبِيَ مُقفَلا",12,"ل",2,0],["وَاِصرِفِ المَكروهَ عَنّي وَالأَذى","وَاِكفِني اللَّهُمَّ شَرَّ الفِتَنِ",13,"ن",1,0],["وَأَصرِفُ عَن قَوارِصَ تَجتَديني","وَلَو أَنّي أَشاءُ بِها جَزَيتُ",14,"ت",1,0],["وَاِصرِف مِنَ الهَمِ يَوماً","وَاِطفِر إِلى اللَهوِ طَفرَه",15,"ر",2,0],["واصْرِفْ إلى مَدْحِ النبيِّ مُحَمَّدٍ","قَولاً غَدا عَن غَيرِهِ مَعدُولا",16,"ل",2,0],["واصرِف بِهِ عنَّا عَذابَ جَهَنَّمٍ","كَرَماً وكُفَّ ضِرامَها المَشْعُولا",16,"ل",2,0],["وَاِصرِفَنها عَن أَبي أَي","يوبَ إِذ تاهَ فَخارا",17,"ر",2,0],["وَاِصرِفيها عَن بَخيلٍ","دانَ بِالإِمساكِ دينا",18,"ن",2,0],["وَأُصرَفُ عَن قَصدي وَحِلمِيَ مُبلِغي","وَأُضحي وَما أَعقَبتُ إِلّا التَعَجُّبا",19,"ب",2,0],["واصرف حياتك من بدء لخاتمة","في علم دينك للقرآن متبعا",20,"ع",2,0],["وأصرفته لما دعاك على النوى","وواصل ترجيع النداء المردد",21,"د",1,0],["واصرِفْ بصرَفِ الراح همَّا كامناً","واحيي السُّرور تنعُّماً بحياتِها",22,"ت",3,0],["واصْرِفْ إلى مَدْحِ النبيِّ مُحَمَّدٍ","فيهِ بِحَبْلِ موَدّة ٍ مَوْصولا",23,"ل",2,0],["واصرف به عنا عذابَ جهنمَ","كَرَماً وكُفَّ ضِرامَها المَشْغُولا",23,"ل",2,0],["وأصرخُ : يا أرض الخرافات ِ.. احْبلى","لعلّ مسيحاً ثانياً .. سوف يظهرُ ..",24,"ر",1,0],["واصرف شؤنك والأوقات متثقاً","باللَه وابذل نقود العمر في اللَه",25,"ل",2,0],["وأصرف الفكر عنكم بالمزاح عسى","أفيء يوماً إلى رشدي ورجحاتي",26,"ي",1,0],["واصرفْ هُمومَك للأخرى وكُنْ حذِراً","تَلْق السرورَ بجناتٍ على سُررِ",27,"ر",1,0],["وأصرخ في وجوههمو فتمسي","مفاصلهم لبأسي في انفصالِ",28,"ل",1,0],["وَأُصْرَفُ عن رَأْيي الّذي كُنْتُ أَرْتَئي","وأَنسى الّذي حُدِّثْتُ ثُمَّ تَغيبُ",29,"ب",1,0],["وأصرف عنك قلبا فيه نار","من التذكار مضرمة بنار",30,"ر",1,0],["وأصرف كل ملتفت بغيظ","وأسكن بين ابناء اليهود",31,"د",1,0],["واصرفوا عنّي الندامى","فقد عطّل نادي الغرام والأنغام",32,"م",1,0],["واصرخي يا ريحُ وانحَب وتَر","واعبسي يا كأسُ واغرُب يا قمَر",33,"ر",1,0],["واصرَخي يا جنوبُ في كلّ وجه","كالح واعصِفي بجفنِ الدخيلِ",34,"ل",1,0],["وأَصرِفُ عنها آخَر الدهر أخدعاً","له نحوَ هاتيكَ الرجام تلدُّ",35,"د",1,0],["واصرف الأعداء عنّي","وامحُهم هتكاً وفتكا",36,"ك",2,0],["واصرف عنّي أسواء سوا","ك بكشف الحجب مع السجف",37,"ف",1,0],["واصرموا حَبلي وان شئتم صلوا","لذلى الحبوصالا وانصراما",38,"م",2,0],["وَاصْرِفْ عِنانَكَ عَن مَرَّاكش ثِقَةً","بِالنُّجْحِ فيها إِلى مِصْرٍ وبَغْدانا",39,"ن",2,0],["وَاِصرِف بِصِرفِ الراحِ تَجلو صورَةُ ال","أفراحِ عَنّي سَورَةَ الأَتراحِ",40,"ح",1,0],["واصرف عنايتك التي أوتيتها","لبديع انشاء الامام الراغب",41,"ب",1,0],["وأَصرفُ بالتأنّي صَرفَ دَهري","وأَعلم أَن سيظفرُ من تأَنّى",42,"ن",2,0],["واصرف بقية عمر لإبقاء له","في طاعات اللَه واعص اللائم اللاحي",43,"ح",2,0],["واصرخوا يا شهيدنا","انت خير الطلائع",44,"ع",1,0],["واصْرِفْ إلى أوطانِه منّي فتىً","إلاّ إليكَ نَفْسُه لم تُصْرَف",45,"ف",1,0],["وأصرفُ همِّي عن هواها بهمَّتي","عزوفاً فتَثنيني إذا ما تثنَّتِ",46,"ت",1,0],["وأَصرِفُ عن ذِكْرَاكِ سمعي ومَنْطِقِي","ولو نازَعَتْنِيها حَمامةُ أَيْكِ",47,"ك",1,0],["واصرفا عنّيَ الملامة فيها","لستما تنقُلان باللوم طبعي",48,"ع",2,0],["وَأَصرامُ فَهمٍ قَد قَتَلنا فَلَم نَدَع","سِوى نِسوَةٍ مِثلِ البَلِيّاتِ حُسَّرِ",49,"ر",1,0],["واصرف الهم رب والغم وامحق","ما كرهناه من ثقيل البلاء",50,"ا",2,0],["واصْرِفَنْ قَلبي إلى قُدْسِكَ يا","عالِمَ الأَسْرارِ وامْحَقْ للفِتَنْ",51,"ن",1,0],["واصْرِفِ الوجهَ له عِزًّا به","واتَّخِذْ سِرًّا له جلَّ يَدَا",52,"د",2,0],["وَأَصرِفُ عَن بَعضِ المِياهِ مَطيَّتي","إِذا أَعجَبَت بَعضَ الرِجالِ المَشارِعُ",53,"ع",1,0],["واصريعاً بثوب هيجاه مدرو","جاً وفي درع صبره مقبورا",54,"ر",2,0],["واصرف الهمَّ عن هواهنَّ واذكر","ما تلاقي في يومكَ المعهودِ",55,"د",1,0],["واصرف أذاي ونجني","من حاسد إذا حسد",56,"د",1,0],["واصرف همومي واوف ديني","واكفني الخصم الألد",56,"د",1,0],["وأصرف أعناق المطايا معرجا","إلى أرسم يا حبذا هي ارسم",57,"م",1,0],["وَاِصرف إِلى اللّه كلّ الأمرِ مُعتصماً","وَلا تَبِت في بحارِ الهمّ سبّاحا",58,"ح",2,0],["وَاِصرف لَهم باب الوبالِ ولا تلن","للناسِ ما دامَت حَياتك جانبا",59,"ب",2,0],["واصرف عنه وجهه غير فاكر","وللدهر والآباد لن يتذكرا",60,"ر",2,0],["واصرِفْ مَديحَكَ عن كثيرِ تَطاولٍ","بزَخارفِ الدُّنيا بليلٍ مُطْوِلِ",61,"ل",1,0],["وَأَصرِفُ هِمَّتي بِالكُلِّ عَنها","إِلى دارِ السَعادَةِ وَالنَجاحِ",62,"ح",1,0],["وَاِصرِف إِلى سُبُلِ الحُقوقِ وُجوهُهُ","تُحرِز بِهِ حَسَنَ الثَناءِ الأَفضَلِ",63,"ل",1,0],["واصرفوا صارف السرور براحٍ","صار من نورها الظلام نهارا",64,"ر",2,0],["وأصرخه رزاح في جموع","لعذرة في الحديد مقنَّعينا",65,"ن",2,0],["وأصرخ في بنى قومى هلموا","إلي فإن رأى الترك أهدى",66,"د",2,0],["وأصرُّوا على العِنادِ عُتُوّاً","أنتَ فينا وهُم هُمُ الضُّعفاء",67,"ا",2,0],["واصرف الأوغادَ اهلَ الجهل عن","خِطَطَ الشرع وَأصلح مَا فَسَد",68,"د",1,0],["واصرم حبال من ازورت جوانبه","واقص جانبا م ان انت لم تقص",69,"ص",1,0],["وأصرِف صُروف النائبات عن الوَرى","وانْهَ الحوادثَ عن سُطاها تَنْتهي",70,"ه",2,0],["واصرخ به وانتدب عن قلب والهة","في صوت فاقدة عن وجد مهتضم",71,"م",1,0],["وَاِصرِف مَقالَكَ فيمَن لَو نَظَمتَ لهُ","زُهرَ الكَواكِبِ مَدحاً كانَ مُحتَقَرا",72,"ر",2,0],["وَاِصرِف مَديحَكَ في أَزكى الوَرى نَسَباً","فَرعِ الهُداةِ قَريعِ العُربِ وَالعَجَمِ",73,"م",1,0],["واصْرِفْ لنجلهمُ السّعيدِ محمّدٍ","وجهَ الثنا تَسْعَدْ لكَ الأيّامُ",74,"م",1,0],["وَاِصرِفي الهَمَّ فَفي إِدمانِهِ","ذَبحَةُ الصَدرِ وَحَزُّ المِفصَلِ",75,"ل",1,0],["واصرف 