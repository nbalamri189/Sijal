wPoem.aspx?id=155538",""],[5829,"قالت تعالى أم تعال","https://www.poetsgate.com/ViewPoem.aspx?id=175107",""],[5910,"لو أنَّها تُصغي","https://www.poetsgate.com/ViewPoem.aspx?id=206219",""],[5910,"سلامٌ على تلك الدِّيار","https://www.poetsgate.com/ViewPoem.aspx?id=206229",""],[6019,"إنطفاءة قنديل ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=53041",""],[6069,"سفرت فخلت سواد معجرها","https://www.poetsgate.com/ViewPoem.aspx?id=105666",""],[6102,"بَرزَخُ الأُمنِيات !!","https://www.poetsgate.com/ViewPoem.aspx?id=183167",""],[6102,"رسالة إلى \"موديل\" ...","https://www.poetsgate.com/ViewPoem.aspx?id=184870",""],[6127,"لولاك عدنا في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=188606",""],[6142,"مادت الأرض انقلاباً والسما","https://www.poetsgate.com/ViewPoem.aspx?id=155750",""],[658,"ألست احق من عود البشام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=603980",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""],[119,"ضارعت زفرة الذنوب بكائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55607&r=&rc=4",""],[463,"يا ديارَ الحيِّ منْ جنبِ الحمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60162&r=&rc=218",""],[6260,"البطل الشهيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68318&r=&rc=9",""],[6360,"صَهيلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87606&r=&rc=9",""]],"verses":[["بَرَزَت لِلوَداعِ فاِستَودَعَت قَلْ","بيَ وَجداً وَصَبوَةً وَغَليلا",0,"ل",2,0],["بَرَزتُ بِها دَهراً عَلى كُلِّ حادِثٍ","وَلا كُحلَ إِلّا مِن غُبارِ الكَتائِبِ",1,"ب",1,0],["بَرَزَت في خَرائِدٍ خَفِراتٍ","مُثقَلاتِ الأَكفالِ وَالأَعجازِ",2,"ز",1,0],["برَزْتَ على رجْلِ الجَلالِ الى التي","تُرَفِّعُ منْ مَثْواكَ ما اللهُ رافِعُ",3,"ع",1,0],["بَرَزا عَشِيَّةَ لَيلَةٍ فَتَناظَرا","هَذا بِقَرنَيهِ وَذا بِالحافِرِ",4,"ر",1,0],["بَرَزَت صَحيفَةُ وَجهِ والِدِهِ","وَمَضى عَلى غُلوائِهِ يَجري",5,"ر",2,0],["بَرَزَتْ إلىَ السَّاحَاتِ لاَ يَعْتَاقُهَا","خَفَرٌ وَهَلْ خَفَرٌ بِدَارِ هَوانِ",6,"ن",1,0],["برِزٍّ تُصيخُ الطير منه مخافة","فهنَّ مُصِفَّاتٌ على الأرض جُنّحُ",7,"ح",1,0],["بَرَّزوا في العُلا ونام رجالٌ","برَّزُوا في الكرى على عَبُّودِ",8,"د",1,0],["برزتْ في مها تغصُّ بسِمْطي","بردٍ بُكرةً على المسواك",9,"ك",1,0],["بَرَزنا لِضِبعانَي مَعَدٍّ فَلَم نَدَع","لِبَكرٍ وَلا أَفناءِ تَغلِبَ نادِيا",10,"ي",2,0],["بَرَزنَ نَحوَكَ لِلتَسليمِ خاشِعَةً","أَبصارُهُنَّ حَسراتٍ مَكاسيرا",11,"ر",2,0],["بَرَزنا وَأَصحَرنا لِكُلِّ قَبيلَةٍ","بِأَسيافِنا إِذ يُؤكَلُ المُتَضَعَّفُ",12,"ف",1,0],["برزت حيال الشك سافرة وقد","لعب الجنوب بثوبها الهفهاف",13,"ف",1,0],["برزت بثوب رق فوق قوامها","وانشق عن صدر وعن أكتاف",13,"ف",1,0],["برزت كعابا في وشاح ضيق","عقدته معطوفا ودرع ضافي",13,"ف",2,0],["برزت بوجه باسم وبأعين","وطف وفرع كالسخام غداف",13,"ف",1,0],["بَرَزَ الثَعلَبُ يَوماً","في شِعارِ الواعِظينا",14,"ن",2,1],["بَرَزنَ وَفي نَواحي الأَيكِ نارٌ","وَخَلفَ الأَيكِ أَفراخٌ تُزَقُّ",15,"ق",1,0],["بَرَزَت بِالمَنظَرِ الضاحي لَهُم","فَيلَقٌ كَالزَهرِ حُسناً وَاِلتِهابا",16,"ب",2,0],["برزنَ بألحاظِ العيون نواشِبَاً","وهنّ لأطرافِ المروطِ روامحُ",17,"ح",1,0],["بَرَزَت أَنعُمُهُ في عَدَدٍ","دُفَعَ البَحرِ وَأَدوارَ الفَلَك",18,"ك",1,0],["بَرَزنَ عَشِيّاً فَقُلتُ اِستَعَر","نَ كُثبَ السَراةِ وَقُضبانَها",19,"ن",3,0],["بَرَّزَ في السَبقِ حَتّى مَلَّ حاسِدُهُ","طولَ العَناءِ وَخَلّاهُ مُجاريهِ",20,"ي",2,0],["بَرَّزَ إبراهيمُ في عِلمِه","فراحَ يُدعى وارِثَ العِلمِ",21,"م",1,1],["بَرَزْنَ فمِن بَدْرٍ تَقَنَّعَ بالدُّجَى","يغازلُ ليثاً بالحديدِ مُقَنَّعا",22,"ع",2,0],["برَزتْ لها أُسْدُ الرَّها إذ حُوصِرَتْ","والأُسْدُ تأنَفُ أن يطولَ حِصارُها",23,"ر",3,0],["بَرَزَت بِهِم هَفَواتُ عِلجِهِمُ وَقَد","يُردي الجِمالَ تَعَسُّفُ الجَمّالِ",24,"ل",1,0],["بَرَّزتَ في طَلَبِ المَعالي واحِداً","فيها تَسيرُ مُغَوِّراً أَو مُنجِدا",25,"د",2,0],["بَرَزَت بَينَ ثَلاثٍ","كَالمَها تَقرو الصَريما",26,"م",2,0],["بَرَزَ البَدرُ في جَوارٍ تَهادى","مُخطَفاتِ الخُصورِ مُعتَجِراتِ",27,"ت",1,1],["بَرَزَت تَماثيلُ المَنِيَّةِ كُلُّها","شَتّى الضُروبِ كَثيرَةَ الأَلوانِ",28,"ن",1,0],["بَرزتَ لِمرْحَبٍ بَطلاً مَهيباً","أبى أن يُتَّقَى أو أن يُهابا",29,"ب",2,0],["بَرَزتَ لَهُ مَا بَينَ بَأسٍ وَزِينَةٍ","وَفي الرُّعبِ عَن أن يَنظُرَ الحُسنَ شَاغِلُ",30,"ل",1,0],["بَرَّزتُ في النَظمِ لَكِنّي أُقَصِّرُ عَن","شِعرٍ أُعاتِبُ فيهِ اللَيلَ بِالقِصَرِ",31,"ر",1,0],["بَرْزٌ بصفحَتِهِ لولا تَقَدُّمُهُ","لم يُعرَفِ الليْثُ بينَ الضّبِّ والوَرَل",32,"ل",1,0],["بُرُزُ الأَكُفِّ مِنَ الخِدامِ خَوارِجٌ","مِن فَرجِ كُلِّ وَصيلَةٍ وَإِزارِ",33,"ر",1,0],["برزخ تعبرُ الليالي عليه","بين عبرينِ من بِلىً وحياةِ",34,"ه",1,0],["بَرَزَتْ لَهُمْ مِنْ خِدْرِهَا","مَهْتُوكَةً لَمْ تَلْتَثِمْ",35,"م",1,0],["بَرَزَتْ مِنَ الماءِ الذِي ابْتَرَدَتْ بِهِ","رَيَّا الشَّبَابِ بَدِيعَةَ الإِشْرَاقِ",36,"ق",1,1],["بَرَزَتْ فِي الغَدَاةِ غَادَةُ وَادِي","النِّيلِ تُخْفِي جَمَالَهَا فِي الْحَبِيرِ",37,"ر",1,0],["بَرَزَتْ وَلَمْ يَكُ نَائِياً عَن بَابِهَا","في مَدْرَجِ العَلْيَاءِ أَرْفَعُ بَابِ",38,"ب",1,0],["بَرَزَتْ فِي غِلاَلَةٍ بِيْضَاءِ","ذَاتُ نَسْجٍ مُفَوَّقٍ بِالضِّياءِ",39,"ا",2,1],["بَرَزْتِ يَا آيَةَ الجَمَالِ فِي","سُورَةِ الحِلْي وَالكَمَالِ",40,"ل",1,1],["بَرَزَتْ نَفْسُهُ بِها فَرَأينَا","هُ نَبِيلاً يَنُثُّ قَوْلاً نَبِيلاَ",41,"ل",2,0],["برزت من مضارب الوهب ثكلى","فهي من فقد أهلها في حداد",42,"د",1,0],["برزت من مضارب الحق في افض","ية الأمر فاستباها هواها",43,"ا",3,0],["برزن نحوك للتسليم خاشعةً","عيونهنّ فعاد القلب موتورا",44,"ر",2,0],["برزت تميس كخطرة النشوان","هيفاء مخجلةً غصون البان",45,"ن",1,1],["بَرَزَتْ بالمَخْلَدِيّين لُهىً،","كَجِمَامِ البَحرِ باتَتْ تَصْطَفِقْ",46,"ق",1,0],["برِزٍّ تُصيخُ الطير منه مخافة","فهن مُصِفَّاتٌ إلى الأرض جُنّحُ",47,"ح",1,0],["بَرَزْنَ نَحوَكَ لِلتَسليمِ خاشِعَةً","أَبصارُهُنَّ حَسيراتٍ مَكاسيرا",48,"ر",2,0],["برزت والناس اشتاتا فكنت لهم","ابا رؤفاً بهم يعفو ويقتدر",49,"ر",1,0],["برزت لساحة المجلا يتيماً","بقوم طم قسوتهم جفاء",50,"ا",2,0],["برّزتُ في سحرِ البيا","نِ وشابَ فيه مفرقي",51,"ق",2,1],["بَرَزتَ لَها فَمَضَت كَالنَعامِ","ثَناها الغَضَنفَرُ لَمّا وَثَب",52,"ب",1,0],["برزت لنا ألفاظه مختالة","في كل علق للعلوم مصون",53,"ن",1,0],["برزت مراسيم المليك بمخرج","تدعو له اخوانها الاخوان",54,"ن",1,0],["بَرَزَت لَنا مِثل العَروسِ تَزينُها","حِبَرُ الفَصاحةِ تَحتَ رَقمٍ عَبقَري",55,"ر",2,0],["برزت في خير دَرٍّ","وعليها عِقد دُرِّ",56,"ر",1,0],["بَرَزْن لنا عاطِراتِ الجُيوبْ","بسَفْحِ الكَثِيب بوادي بُوَنَّهْ",57,"ن",2,0],["برزتَ كالشمس يومَ أسعدها","بل زدت نوراً على المنيرَين",58,"ن",1,0],["برزتَ فيه بروزَ الشمسِ طالعةً","وقد أَعاد الضُّحاءَ النَّقْعُ كالطَّفَل",59,"ل",1,0],["برزتَ فيه كبروز الضحى","مجتمعَ الهيئة بادي الوقار",60,"ر",1,0],["برزتَ بروز البدر ليلة تِمَّه","وسِرْت برهبانةٍ ووَقار",61,"ر",1,0],["برزت كبدر التِمّ تَقْدُم جَحْفَلاً","تكاد بن الأرض الفضاء تمور",62,"ر",1,0],["برزتَ فيه بروزَ الشمس كاسفةً","بضوئها لضياء البدر والشُّهُب",63,"ب",1,0],["برزت في نيل المقامات العلى","ولمثل مجدك يثبت التبريز",64,"ز",1,0],["بَرّزتَ سَبقاً فَما داناك في أَمَدٍ","خَلقٌ قَديماً وَلا خَلقٌ يُدانيكا",65,"ك",2,0],["برزت في قلائد وعقود","دونهن الياقوت والمرجان",66,"ن",1,0],["برزت عزمك لا يرضيك منزلة","فأنت من طبق ترقي إلى طبق",67,"ق",1,0],["بَرزتِ لنا من القَصرِ العليّ","كما طلعَ الهلالُ من العشيّ",68,"ي",1,1],["برزت وقد شقّت حجابَ الأعصرِ","بنتُ النبيِّ الهاشميِّ الأكبرِ",69,"ر",1,1],["برزتَ للنّاسِ في قميصٍ","أَكْحَلِ مِنْ طَرْفِكَ الكحيلِ",70,"ل",1,1],["بَرَزت إِلى بُرزيهِ عَزمَتُكَ الَّتي","مَدَّت يَداً عَن مَطلَبٍ لَم يَقصُرِ",71,"ر",1,0],["بَرَزَت مِنَ المَنازِلِ القِباب","فَلَم يَعسِر عَلى أَحَدٍ حِجابي",72,"ب",2,1],["بَرَزَت بزينتِها إليكَ الشامُ","وافترَّ بشراً ثغرُها البسّامُ",73,"م",1,1],["برُزْقٍ جَوارحَ تَشْكو الظَّما","وزُرْقٍ جَوارحَ تَشْكو قَرَم",74,"م",1,0],["بَرَزنا بِالأَميرِ إِلى فَلاةٍ","يَبيتُ طَليقُها عَينَ الأَسيرِ",75,"ر",1,0],["برزوا ينادون الصفوفَ وحولَهم","من كل باغٍ زادَ كفراً عاصبا",76,"ب",2,0],["برَزْن كالبان في الكُثبان حَاملةً","شَمساً أضاءتْ وليلاً راكِداً جَنَحَا",77,"ح",2,0],["بَرَزَتْ أَسماءُ أَو أَترابها","يُوقِرَنَّ السَّمْعَ عذلاً وملاما",78,"م",2,0],["بَرَزَتْ في الظَّلام شمس الحميَّا","فمَحَتْ بالضّياء جُنْحَ الظَّلام",79,"م",1,0],["بَرَزتْ لنا منها السُّقاة بقَرفٍ","قد كلِّلت بالدُّر والمرجان",80,"ن",1,0],["برزتَ مع البرهان في كلِّ موطنٍ","من البحث لا يبقي اللباب مع القشر",81,"ر",1,0],["برزَ الروض بأبهى هيبةٍ","فتهيَّا للسرور اليوم واعتدِ",82,"د",1,0],["برزت فيهم بروز السيف منصلتاً","من غمده وأخذت القوم بالرعب",83,"ب",1,0],["برزت بنوَّار الشقيق فلم يزل","بدر الدجنة عندها يتشقَّق",84,"ق",1,0],["برزت تفاخر بالجبين الأقمر","هيفاء تغزونا بقدّ أسمر",85,"ر",1,1],["برزت وقد اهدت إليّ نفائسا","تنفي أحاديث العذول أخي الكمد",86,"د",1,0],["برزنَ ومن دون النحور أسنّةٌ","فوالكٌ إن صفحتَهُنّ فوالكُ",87,"ك",1,0],["برزت للعيان عارية من","كل ثوب من صنع هذا الإنسان",88,"ن",1,0],["برزَتْ هلالاً واختفَت قمرا","ربَيتُ فيها الحبَّ لليُتْمِ",89,"م",1,0],["برزت تَفهقُ في أبياتهم","كلُّ جوفاءَ من الشِّيزَى عميقَهْ",90,"ق",2,0],["برزنَ يُخيَّلْنَ للناظرين","صوامعَ من حولها أو مَنارا",91,"ر",2,0],["برزتَ في عِقدِهِمُ واسطةً","لها من الأبصار ما يُستلَبُ",92,"ب",1,0],["برَّزْتَ سبْقاً وافترعتَ محِلَّةً","لم يرْقَها منْ قبلكَ الخُلَفاءُ",93,"ا",2,0],["برزتْ مثلَ وجنة الحبِ تزدا","د على اللحظ وقدةً واحمرارا",94,"ر",2,0],["برزت ثلاث ذوائب في ليلها","فاعجب لليل رايع بذواتي",95,"ت",2,0],["برزت بدور السعد في","أفق الدجى بالرقمتان",96,"ن",1,0],["برزتُ من طمس خفائي بكم","ومسك طوري في الورى عابقُ",97,"ق",1,0],["برزْنا لدَى غيمِ العَجاجِ جَحاجِحاً","مَلأْنا الوَرَى عِلماً وذَوقاً وعِرْفَانَا",98,"ن",2,0],["برَزْنا فُروعاً قد تَسامَتْ أُصولُنا","فأَكرِمْ بها فَرعاً وأَكرِمْ بها أَصْلاَ",99,"ل",2,0],["برَزَ السَّاقي وحَيَّى","بعد أن طالَ السَّفرْ",100,"ر",1,0],["برزَتْ فشِمْنا البرقَ لاحَ ملثّماً","والبدرَ بين تقَرطُقٍ وتخمُّرِ",101,"ر",1,0],["بَرزت كما شَاء الهوَى لِذَوي الهوَى","وما شَاءَ قَول الشِّعرِ مِمَّن بكَ انكَوَى",102,"و",2,1],["بَرَزتُ فَما أخفى عليك كأنّني","على ذُروة الأطوادِ توقد ناري",103,"ر",2,0],["برزخٌ بينهما لا يبغيانْ","هي نفس ذات أوصاف حسانْ",104,"ن",1,0],["بَرَزَتْ وأترابٌ لها عُرُبٌ","فَجَعَلْتُ أصْرِفُ نَحْوَهَا النّظَرَا",105,"ر",2,1],["برزقٍ مَزِيدٍ ثمَّ سَعيٍ مُضَاعَفٍ","وَمَن يَدعُ فيهِ لَم يُرَدَّ دُعَاهُ",106,"ا",2,0],["برزتَ إلى الوجودِ فكُنتَ نورا","يُنِيرُ الأُفْق قد كَسفَ البدُورَا",