{"poems":[[88,"أقصر الزعفران لأنت قصر","https://www.aldiwan.net/poem68902.html","الوافر"],[87,"كل حي على المنية غادي","https://www.aldiwan.net/poem62901.html","الخفيف"],[125,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[228,"نحن عدن وهم مكان مريب","https://www.aldiwan.net/poem39718.html","الخفيف"],[350,"وأحنف مسترخي العلابي طوحت","https://www.aldiwan.net/poem4475.html","الطويل"],[438,"يقر لغليلم المليك بن غليلم","https://www.aldiwan.net/poem12345.html","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53054","البسيط"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101700","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65983","الرجز"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118799","المديد"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66110","البسيط"],[5358,"الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=21884",""],[3294,"وإذا ما سألت عني فإني","https://www.poetsgate.com/ViewPoem.aspx?id=173274",""],[5573,"ياقربنا من بعضنا بالكلام الفصيح","https://www.poetsgate.com/ViewPoem.aspx?id=204537",""],[6031,"يا مُنْكِراً هَدْمَ الحُصُونِ إذَا اعْتَصَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=46352",""]],"verses":[["كِلا عَهدَيكَ لِلأَجيالِ فَخرٌ","وَزَهوٌ لِلحَديثِ وَلِلقَديمِ",0,"م",1,0],["كُلُّ أَعوادِ مِنبَرٍ وَسَريرٍ","باطِلٌ غَيرَ هَذِهِ الأَعوادِ",1,"د",1,0],["كل أعد وما يزن بريبة","مما بناد نيل أو متزلما",2,"م",2,0],["كُلُّ أَعراقِنا السَعيدَةِ لِلإي","مانِ مَجرى وَلِلرِّجاءِ دروبُ",3,"ب",1,0],["كِلا عَقبَيه قَد تَشَعَّثَ رَأسُها","مِنَ الضَربِ في جَنبي ثِفالٍ مُباشِرِ",4,"ر",1,0],["كِلاَ عَسْكَرِيْهِ كالسحائِبِ لم تَزَلْ","حواصِبُ في حَرْبٍ صَوَائِبَ في سَلْمِ",5,"م",1,0],["كل اعتمادي عليكم في الخطوب وما","رجوته عندكم من حسن منقلبِ",6,"ب",1,0],["كل أعد من المعارض ما اصطفى","للعرض ثمة جملة تختار",7,"ر",1,0],["كلاّ على كل وكلٌ واصلوا","لا كالرجال الخنس الجثام",8,"م",1,0],["كل أعيان السوى عدم","ولكم معنى الوجود صفي",9,"ف",2,0],["كُلٌّ أَعَدَّ لِهذا اليومِ مِقْوَلَهُ","والبِيضُ تَسْتُرُها الاغْمادُ والخِلَلُ",10,"ل",1,0],["كلُّ أعوامي سوادٌ راعَني","ليسَ لي فيها من السعدِ شهَرْ",11,"ر",1,0],["كل أعمى ومقعد ومريض","وفقير ومبتلى بعيال",12,"ل",1,0],["كلاٍ على مايهمه في زمانه يصيح","وكلاٍ يدور نجاته ماحصل له امان",13,"ن",1,0],["كُلٌّ أَعَارَ الأرْضَ صَفْحةَ مُلْطِمٍ","حُرٍّ يَذِلُّ لَهُ النُّضَارُ عَتيقِ",14,"ق",1,0]]}