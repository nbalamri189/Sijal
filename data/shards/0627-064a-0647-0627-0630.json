{"poems":[[75,"الهوى في طلوع تلك النجوم","https://www.aldiwan.net/poem11917.html","الخفيف"],[63,"قضب الهند والقنا أخدانك","https://www.aldiwan.net/poem51496.html","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141953","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141914","الخفيف"],[102,"مع الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=50153",""],[440,"أيها ذا المدعي لسنا","https://www.aldiwan.net/poem25313.html","المديد"],[469,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75796","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52183","الرمل"],[5388,"شكوى","https://www.poetsgate.com/ViewPoem.aspx?id=206904",""]],"verses":[["أَيُّها ذا الوَزيرُ ها أَنا أَشكو","وَالعَصا بَدءُ قَرعِها لِلحَليمِ",0,"م",1,0],["أيُّها ذا الأميرُ ما رَمِدَتْ عي","ناكَ حاشا لها ولا أجفانُك",1,"ك",1,0],["أيهاذا الجراد زادُكَ مبذولٌ","فأطبِق بالعشبة الخضراء",2,"ا",2,0],["أيهاذا اللواءُ من خضرةِ الأرزِ","كساها دمُ الجهادِ ورودهْ",3,"د",2,0],["أيّهاذي الحياة ما أنت إلاّ","أمل في جوانح اليأس مبهم",4,"م",1,0],["أيُّهَا ذَا المُدَّعِي لَسَنَا","كُفَّ مِن عَذلِي أنَأ وأنَا",5,"ن",2,1],["أيهاذا العهدُ الملثُّ سقى عه","دك لا مخدجٌ ولا مذموم",6,"م",1,0],["أَيُّها ذا الَّذي يجرّ الإِزارا","وَالغبيّ المَفعوم اِستكبارا",7,"ر",2,1],["أيهاذا الجبلُ الملهم سحرا","أهُدًى ترسِلُ أم توقِدُ جمرا",8,"ر",2,1],["أَيُّها ذا الطَّيفُ أَنَّى زُرتَنِي","قَيَّدَ الظُّلْمُ الهوى مُذْ زَرَّده",9,"د",2,0]]}