{"poems":[[53,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[52,"يا عبد زوريني تكن منة","https://www.aldiwan.net/poem62303.html","السريع"],[244,"لمقامك التعظيم والتبجيل","https://www.aldiwan.net/poem23840.html","الكامل"],[443,"أفنيت صبري في الهوى وتجلدي","https://www.aldiwan.net/poem2581.html","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59759","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[4797,"الأمير سلطان","https://www.poetsgate.com/ViewPoem.aspx?id=132241",""],[4829,"ولاد المضا","https://www.poetsgate.com/ViewPoem.aspx?id=36743",""],[4869,"حبك الهندي","https://www.poetsgate.com/ViewPoem.aspx?id=151513",""],[4869,"حرب الحوثيين / وطنيّه","https://www.poetsgate.com/ViewPoem.aspx?id=151651",""],[5122,"واليوم ؟","https://www.poetsgate.com/ViewPoem.aspx?id=18846",""],[6102,"تحاميل","https://www.poetsgate.com/ViewPoem.aspx?id=183310",""]],"verses":[["واللَّهُ ثبّطَهم بذاك فكذَّبوا","فيك اليقينَ وصدّقوا التخييلا",0,"ل",2,0],["وَاللَهِ ثُمَّ اللَهِ فَاِستَيقِني","إِنّي لَأَرجوكِ وَأَخشاكِ",1,"ك",1,0],["والله ثم المسلمون جميعُهم","قد خولوك وحقك التخويل",2,"ل",1,0],["والله ثمّ الله ما لي عندهُ","ذنب سوى حبي لكم وتودّدي",3,"د",2,0],["واللّه ثم اللّه مالي مطمحٌ","إلا طِماحي للجناب الأقدس",4,"س",1,0],["واللهُ ثُمَّ رَسُولُهُ قَد بَيَّنَا","طُرُقَ الهُدَى فِي غَايَةِ التِّبيَانِ",5,"ن",1,0],["والله ثم والله منتوا بضيفان","يقوله اللي عين ربه تهمه",6,"م",2,0],["والله ثم والله حلف(ن) غامس","معقود في قلب الفتى الملهومي",7,"م",2,0],["والله ثم والله من غير تفصيل","ان الجفى نار بلهبها عمتني",8,"ن",2,0],["والله ثم والله والله نحميه","الكون كله لو تبي من عمانا",9,"ن",2,0],["والله ثم والله لو أحترقتي","قلبي عليك أبعيد ما تحرقينه",10,"ن",2,0],["وَ اللَّهِ ؛ ثُمَّتَ وَ اللَّهِ ؛ ازدَرَيتُ يَدِي","مُذِ اكتَفَيتُ بِشِعرِي بِالأَقاوِيلِ",11,"ل",1,0]]}