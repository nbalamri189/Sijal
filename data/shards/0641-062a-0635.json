{"poems":[[71,"جاء الشتاء وليس عندي جبة","https://www.aldiwan.net/poem3793.html","الكامل"],[93,"أهديت والمهدى ثمين","https://www.aldiwan.net/poem11276.html","مجزوء الكامل"],[88,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[72,"أيها البحر نائلا وعلوما","https://www.aldiwan.net/poem18744.html","الخفيف"],[51,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[38,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[92,"كان الربيع الحي روحا حالما","https://www.aldiwan.net/poem38969.html","الكامل"],[85,"كان لبعض الناس نعجتان","https://www.aldiwan.net/poem8026.html","الرجز"],[45,"دموع عليها السكب ضربة لازم","https://www.aldiwan.net/poem65662.html","الطويل"],[58,"حياتك أنفاس تعد فكلما","https://www.aldiwan.net/poem31200.html","الطويل"],[66,"فسد الشرب حين أعوزت الراح","https://www.aldiwan.net/poem39049.html","الخفيف"],[97,"لعينيك احتملنا ما احتملنا","https://www.aldiwan.net/poem24770.html","الوافر"],[80,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[44,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[69,"قصد الشام جراد","https://www.aldiwan.net/poem28001.html","مجزوء الرمل"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[75,"زهر الروض بنت دمع الغمام","https://www.aldiwan.net/poem69020.html","الخفيف"],[48,"وغزال في الدجى لي","https://www.aldiwan.net/poem64326.html","مجزوء الرمل"],[50,"علليني يا عبد أنت الشفاء","https://www.aldiwan.net/poem64888.html","الخفيف"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42709","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[45,"لدارِكِ، يا لَيلى، سَماءٌ تَجودُها","https://www.poetsgate.com/ViewPoem.aspx?id=31695",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[116,"سر الغيوب افاض اللارواح","https://www.aldiwan.net/poem41185.html","عموديه"],[161,"لك خارقات عوائد لن تعرفا","https://www.aldiwan.net/poem58902.html","الكامل"],[196,"ليت شعري هل تخبرني الديار","https://www.aldiwan.net/poem54408.html","الخفيف"],[196,"ما هاج شوقك من مغاني دمنة","https://www.aldiwan.net/poem54420.html","الكامل"],[238,"يا جميل الصبر لب من دعا","https://www.aldiwan.net/poem19492.html","الرمل"],[238,"وقرر ما تحويه منك الأضالع","https://www.aldiwan.net/poem19493.html","الطويل"],[240,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[250,"أطلال مية بالتلاع فمثقب","https://www.aldiwan.net/poem2127.html","الكامل"],[250,"أجد من آل فاطمة اجتنابا","https://www.aldiwan.net/poem2128.html","الوافر"],[260,"أفتاة قلبي رحمة بفتاك","https://www.aldiwan.net/poem35946.html","الكامل"],[271,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[314,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[339,"حياتك أنفاس تعد وكلما","https://www.aldiwan.net/poem68643.html","الطويل"],[365,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[365,"هل في عتاب الحادثات غناء","https://www.aldiwan.net/poem61013.html","الكامل"],[372,"هل مع اليأس رجاء","https://www.aldiwan.net/poem57536.html","مجزوء الرمل"],[378,"مذ حل روح الله قلبك ساكنا","https://www.aldiwan.net/poem59190.html","الكامل"],[394,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[430,"هاجت رياح بالشمال تجول","https://www.aldiwan.net/poem41032.html","الكامل"],[459,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[459,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[462,"ما أنصفت بغداد ناشئها الذي","https://www.aldiwan.net/poem16438.html","الكامل"],[469,"لا صاحب إلا الذي أعضاؤه","https://www.aldiwan.net/poem59578.html","الكامل"],[469,"يابن البخيلة خل عن ذكرى","https://www.aldiwan.net/poem60024.html","أحذ الكامل"],[478,"أذال على بالي الرسوم المدامعا","https://www.aldiwan.net/poem15322.html","الطويل"],[480,"سيقارة لطيفة","https://www.aldiwan.net/poem36886.html","مجزوء الرجز"],[480,"لمتى الوقوف بجانب الأسطول","https://www.aldiwan.net/poem37199.html","الكامل"],[539,"طال مني لذا النهار ارتقابي","https://www.aldiwan.net/poem48296.html","عموديه"],[541,"أتعذر سلمى بالنوى أم تلومها","https://www.aldiwan.net/poem56665.html","الطويل"]],"verses":[["فَتَصَحَّفَت لَمّا فَراها حَبَّةً","فَبَدا يُواصِلُ زَفرَةً بِأَنينِ",0,"ن",1,0],["فَتَصُوغُ أَبْلَغَ حِكْمَةٍ","وَبِهَا التَّنَدُّرُ وَالمَجُونُ",1,"ن",1,0],["فتصدّى لغَيثه كل قوم","قد شكَوْا غُلّةً بهم وأُواما",2,"م",2,0],["فتصدَّق وابْعث بقفةِ فحمٍ","إنَّ فحمي مضى وكيري تغير",3,"ر",1,0],["فتصدعوا ومضوا لطيِّتهم","فعرى الفؤاد لهم تصدُّعه",4,"ع",2,0],["فَتَصَدَّعَت مِن بَعدِ ذاكَ عَصاهُمُ","شِقَقاً وَأَصبَحَ سَيفُهُم مَسلولا",5,"ل",2,0],["فتصيرُ في روحِ الألوهةِ بضعةً","قُدُسِيَّةً خَلُصَتْ من الأوشابِ",6,"ب",1,0],["فَتَصبِرُ الأُختُ عَلى الإِذلالِ","حامِلَةً مَرارَةَ الإِدلالِ",7,"ل",1,0],["فَتَصرِفُ وَجهَ البيضِ أَبيَضَ مُشرِقاً","بِوَجهٍ مِنَ الهَيجاءِ أَغبَرَ قاتِمِ",8,"م",1,0],["فَتُصبِحَ في نَفسٍ وَتَمشي بِغَيرِها","وَمالَكَ مِن عَقلٍ تُحِسُّ بِهِ رُزءا",9,"ز",3,0],["فَتَصَدَّق بِقَهوَةٍ إِن تَجَلَّت","في الأَواني ظَنَنتَ فيها الأَواني",10,"ن",2,0],["فتصطخب العواطف ساخرات","وتطعنني بأطراف الحرابِ",11,"ب",1,0],["فتَصيَّدَتنِي ظبيةٌ إنسِيّةٌ","وَأَنا الَّذي أَتَصَيَّدُ الرّئبالا",12,"ل",2,0],["فَتَصَلّى مُحَمَّدُ بنُ مُعاذٍ","جَمرَةَ الحَربِ وَاِمتَرى الشُؤبوبا",13,"ب",2,0],["فتصالحْنا عليه","وحفرْنا ودفنَّا",14,"ن",2,0],["فتصادمَ الحَقُّ المُبينُ وإفكهُم","فإذا النُّفُوسُ عَلَى الرَّدَى تَتَشَعَّبُ",15,"ب",1,0],["فتصابيت ثم قلت لصحبي","حيّياني بقطرمين وجام",16,"م",1,0],["فَتَصَدّى قائِلاً لي","بِاِبتِهارٍ وَاِنتِعاسِ",17,"س",1,0],["فَتَصَدَّت بَعدَ الصُدودِ وَقالَت","قَتَلَتني أَنفاسُكَ الصُعَداءُ",18,"ا",2,0],["فَتَصوغُ القلوبُ منها أغاريداً","تَهُزُّ الحياةَ هزَّ الخُطوبِ",19,"ب",1,0],["فَتَصَدَّقْ بِنَظْرَةٍ مِنْكَ تَشْفِي","دَاءَ قَلْبٍ مِنَ الْغَرَامِ مُلَقَّى",20,"ق",2,0],["فَتَصَاوَلا حَتَّى إِذَا مَا اسْتَنْفَدَا","مَا كَانَ عِنْدَهُمَا وَضَاقَ خِنَاقُ",21,"ق",1,0],["فَتَصَدَّى لِلذَّوْدِ عَنْهُ جُفَاةٌ","مِنْ شُيُوخٍ بِهَا وَمِنْ أَوْلاَدِ",22,"د",1,0],["فَتَصَاوَلْتُمَا إِلَى أَنْ تَرَدَّيْ","تَ بِسَهْمٍ مُصَمِّمٍ فِي الْوَرِيدِ",23,"د",1,0],["فتُصْبِحُ في أفناءِ سَعدِ بنِ مَالِكٍ","وُجُوهٌ مِنَ المَخزَاةِ سُودٌ خُدودُها",24,"د",3,0],["فَتُصْغِي إِليْهِ وَهْيَ تَحسُو شَرَابَهَا","فَإِنْ مَلأَتْ مِمَّا يَقُولُ وِطَابَهَا",25,"ه",2,0],["فتصاعدت زفرات سادات الحمى","وتعطرت بعبيرها الفياح",26,"ح",1,0],["فتصادموا فإِذا وصفت فلا تصف","إِلا زجاجاً صادماً صمّ الصفا",27,"ف",2,0],["فَتَصَدَّعنَ عَن جَرائِحِ مَرعى","وَاِنجلى عَن مُتونِهِنَّ الغُبارُ",28,"ر",1,0],["فَتَصَيَّفاها يُصبِحانِ كِلاهُما","لِثَقُ الجَحافِلِ مِن وَكيفِ نَداها",29,"ا",3,0],["فَتَصَامَمْنَا وَهَيْهَاتَ فَمَا","يَنْفَعُ الْمُثْكِلَ أَنْ لاَ يَسْمَعَا",30,"ع",2,0],["فَتَصْفُو سَجَايَاهَا وَيُصْبِحُ قَلْبُهَا","وَفِيهِ لِسَرْحِ الْحُبِّ فِيكَ مَرَاتِعُ",31,"ع",1,0],["فتصبح نجد دولة عربية","سيغدو لها نحو الخلافة مأرب",32,"ب",1,0],["فَتَصُكُّ مَحجِرَهُ إِذا ما اِستافَها","وَجَبينَهُ بِحَوافِرٍ لَم تُنكَبِ",33,"ب",1,0],["فَتَصطادُ الرِجالَ إِذا رَمَتهُم","وَأَصطادُ المُخَبَّأَةَ الكَعابا",34,"ب",2,0],["فتصرّفي حكماً بمملوك الهوى","كتصرّف الملّاك في الأملاك",35,"ك",1,0],["فتَصبَّرت حتى تولَّدَ بأسُها","من صَبرِها ولها بهِ استِعصام",36,"م",1,0],["فتصغي بالحادي بأسماعها كما","يكون استماع العاقل المتنصت",37,"ت",1,0],["فَتُصبِحُ في نَقصٍ وَتُمسي بِمِثلِه","وَمالُكَ مَعقولٌ تُحِسُّ بِهِ رُزءا",38,"ز",3,0],["فتُصِبحُ لي طَوراً يداكَ حَمائلاً","وآونةً يُضْحي مناطُكَ لي حِضْنا",39,"ن",2,0],["فَتصرُّمُ ابنِ ذُكاءَ خَطْبٌ هَيّنٌ","ما أشرقَتْ للعالمينَ ذُكاء",40,"ا",2,0],["فتصاريفُ الليالي","فاعلاتٌ ما تشاءُ",41,"ا",2,0],["فتصوَّرت فيها الفضائلُ كلها","فكأنه المرآةُ نَنظرُها بِها",42,"ه",2,0],["فَتَصَدَّت لِبَنيهِ","بِظُباها وَمداها",43,"ا",3,0],["فتصايحت تلك الخلايق بالدعا","للَه فهو الحافظ المسؤول",44,"ل",1,0],["فتصرف الشكّ باليقين إذا","بلوتَ سرّي بالفاحص السابرْ",45,"ر",1,0],["فتصحَبُه بأنفذَ منه أمراً","على الدنيا وأطولَ فيه عُمرا",46,"ر",2,0],["فتصدَّعوا مُتَفرِّقينَ كأنَّهُمْ","مالٌ تُفَرِّقُهُ يَدُ ابن طِرادِ",47,"د",1,0],["فَتَصَفَّحِ الإِخوانَ وَاِختَر مِنهُمُ","مَن إِن أَسَأتَ إِلَيهِ يَوماً أَحسَنا",48,"ن",2,0],["فَتَصُكُّ عِرضَكَ كُلُّ قافِيَةٍ","مِنّي بِما يَحذو لَها فِكري",49,"ر",2,0],["فتصدعُ قلبي حينَ تصدحُ سُحرةً","وقد حلَّ أهلُ الرقمتينِ مُتالعا",50,"ع",2,0],["فتصفها منعم","مشرف مقرب",51,"ب",1,0],["فتصعّب الفتح المحقّق عندهم","فتآمروا عن محق إسلامبول",52,"ل",1,0],["فَتَصَدَّى ومِثلُه مَن تصَدَّى","ولِخَيرِ المُجيبِ خيرُ الجًَوابِ",53,"ب",1,0],["فَتصرِفُ حَتّى تَسجُمَ العَينُ عَبرَةً","بِها وَهيَ مِهمارٌ وَشيكٌ سُجومُها",54,"م",3,0]]}