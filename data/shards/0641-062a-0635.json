//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79065&r=&rc=12",""],[6225,"إزالة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78009&r=&rc=95",""],[6225,"وثيقة ُ العفو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78062&r=&rc=147",""],[6237,"الحب الكاذب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77889&r=&rc=31",""],[6237,"جبل فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77861&r=&rc=3",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[6278,"أمّاه يا فرح العيون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86863&r=&rc=16",""]],"verses":[["فَتَصَحَّفَت لَمّا فَراها حَبَّةً","فَبَدا يُواصِلُ زَفرَةً بِأَنينِ",0,"ن",1,0],["فَتَصُوغُ أَبْلَغَ حِكْمَةٍ","وَبِهَا التَّنَدُّرُ وَالمَجُونُ",1,"ن",1,0],["فتصدّى لغَيثه كل قوم","قد شكَوْا غُلّةً بهم وأُواما",2,"م",2,0],["فتصدَّق وابْعث بقفةِ فحمٍ","إنَّ فحمي مضى وكيري تغير",3,"ر",1,0],["فتصدعوا ومضوا لطيِّتهم","فعرى الفؤاد لهم تصدُّعه",4,"ع",2,0],["فَتَصَدَّعَت مِن بَعدِ ذاكَ عَصاهُمُ","شِقَقاً وَأَصبَحَ سَيفُهُم مَسلولا",5,"ل",2,0],["فتصيرُ في روحِ الألوهةِ بضعةً","قُدُسِيَّةً خَلُصَتْ من الأوشابِ",6,"ب",1,0],["فَتَصبِرُ الأُختُ عَلى الإِذلالِ","حامِلَةً مَرارَةَ الإِدلالِ",7,"ل",1,0],["فَتَصرِفُ وَجهَ البيضِ أَبيَضَ مُشرِقاً","بِوَجهٍ مِنَ الهَيجاءِ أَغبَرَ قاتِمِ",8,"م",1,0],["فَتُصبِحَ في نَفسٍ وَتَمشي بِغَيرِها","وَمالَكَ مِن عَقلٍ تُحِسُّ بِهِ رُزءا",9,"ز",3,0],["فَتَصَدَّق بِقَهوَةٍ إِن تَجَلَّت","في الأَواني ظَنَنتَ فيها الأَواني",10,"ن",2,0],["فتصطخب العواطف ساخرات","وتطعنني بأطراف الحرابِ",11,"ب",1,0],["فتَصيَّدَتنِي ظبيةٌ إنسِيّةٌ","وَأَنا الَّذي أَتَصَيَّدُ الرّئبالا",12,"ل",2,0],["فَتَصَلّى مُحَمَّدُ بنُ مُعاذٍ","جَمرَةَ الحَربِ وَاِمتَرى الشُؤبوبا",13,"ب",2,0],["فتصالحْنا عليه","وحفرْنا ودفنَّا",14,"ن",2,0],["فتصادمَ الحَقُّ المُبينُ وإفكهُم","فإذا النُّفُوسُ عَلَى الرَّدَى تَتَشَعَّبُ",15,"ب",1,0],["فتصابيت ثم قلت لصحبي","حيّياني بقطرمين وجام",16,"م",1,0],["فَتَصَدّى قائِلاً لي","بِاِبتِهارٍ وَاِنتِعاسِ",17,"س",1,0],["فَتَصَدَّت بَعدَ الصُدودِ وَقالَت","قَتَلَتني أَنفاسُكَ الصُعَداءُ",18,"ا",2,0],["فَتَصوغُ القلوبُ منها أغاريداً","تَهُزُّ الحياةَ هزَّ الخُطوبِ",19,"ب",1,0],["فَتَصَدَّقْ بِنَظْرَةٍ مِنْكَ تَشْفِي","دَاءَ قَلْبٍ مِنَ الْغَرَامِ مُلَقَّى",20,"ق",2,0],["فَتَصَاوَلا حَتَّى إِذَا مَا اسْتَنْفَدَا","مَا كَانَ عِنْدَهُمَا وَضَاقَ خِنَاقُ",21,"ق",1,0],["فَتَصَدَّى لِلذَّوْدِ عَنْهُ جُفَاةٌ","مِنْ شُيُوخٍ بِهَا وَمِنْ أَوْلاَدِ",22,"د",1,0],["فَتَصَاوَلْتُمَا إِلَى أَنْ تَرَدَّيْ","تَ بِسَهْمٍ مُصَمِّمٍ فِي الْوَرِيدِ",23,"د",1,0],["فتُصْبِحُ في أفناءِ سَعدِ بنِ مَالِكٍ","وُجُوهٌ مِنَ المَخزَاةِ سُودٌ خُدودُها",24,"د",3,0],["فَتُصْغِي إِليْهِ وَهْيَ تَحسُو شَرَابَهَا","فَإِنْ مَلأَتْ مِمَّا يَقُولُ وِطَابَهَا",25,"ه",2,0],["فتصاعدت زفرات سادات الحمى","وتعطرت بعبيرها الفياح",26,"ح",1,0],["فتصادموا فإِذا وصفت فلا تصف","إِلا زجاجاً صادماً صمّ الصفا",27,"ف",2,0],["فَتَصَدَّعنَ عَن جَرائِحِ مَرعى","وَاِنجلى عَن مُتونِهِنَّ الغُبارُ",28,"ر",1,0],["فَتَصَيَّفاها يُصبِحانِ كِلاهُما","لِثَقُ الجَحافِلِ مِن وَكيفِ نَداها",29,"ا",3,0],["فَتَصَامَمْنَا وَهَيْهَاتَ فَمَا","يَنْفَعُ الْمُثْكِلَ أَنْ لاَ يَسْمَعَا",30,"ع",2,0],["فَتَصْفُو سَجَايَاهَا وَيُصْبِحُ قَلْبُهَا","وَفِيهِ لِسَرْحِ الْحُبِّ فِيكَ مَرَاتِعُ",31,"ع",1,0],["فتصبح نجد دولة عربية","سيغدو لها نحو الخلافة مأرب",32,"ب",1,0],["فَتَصُكُّ مَحجِرَهُ إِذا ما اِستافَها","وَجَبينَهُ بِحَوافِرٍ لَم تُنكَبِ",33,"ب",1,0],["فَتَصطادُ الرِجالَ إِذا رَمَتهُم","وَأَصطادُ المُخَبَّأَةَ الكَعابا",34,"ب",2,0],["فتصرّفي حكماً بمملوك الهوى","كتصرّف الملّاك في الأملاك",35,"ك",1,0],["فتَصبَّرت حتى تولَّدَ بأسُها","من صَبرِها ولها بهِ استِعصام",36,"م",1,0],["فتصغي بالحادي بأسماعها كما","يكون استماع العاقل المتنصت",37,"ت",1,0],["فَتُصبِحُ في نَقصٍ وَتُمسي بِمِثلِه","وَمالُكَ مَعقولٌ تُحِسُّ بِهِ رُزءا",38,"ز",3,0],["فتُصِبحُ لي طَوراً يداكَ حَمائلاً","وآونةً يُضْحي مناطُكَ لي حِضْنا",39,"ن",2,0],["فَتصرُّمُ ابنِ ذُكاءَ خَطْبٌ هَيّنٌ","ما أشرقَتْ للعالمينَ ذُكاء",40,"ا",2,0],["فتصاريفُ الليالي","فاعلاتٌ ما تشاءُ",41,"ا",2,0],["فتصوَّرت فيها الفضائلُ كلها","فكأنه المرآةُ نَنظرُها بِها",42,"ه",2,0],["فَتَصَدَّت لِبَنيهِ","بِظُباها وَمداها",43,"ا",3,0],["فتصايحت تلك الخلايق بالدعا","للَه فهو الحافظ المسؤول",44,"ل",1,0],["فتصرف الشكّ باليقين إذا","بلوتَ سرّي بالفاحص السابرْ",45,"ر",1,0],["فتصحَبُه بأنفذَ منه أمراً","على الدنيا وأطولَ فيه عُمرا",46,"ر",2,0],["فتصدَّعوا مُتَفرِّقينَ كأنَّهُمْ","مالٌ تُفَرِّقُهُ يَدُ ابن طِرادِ",47,"د",1,0],["فَتَصَفَّحِ الإِخوانَ وَاِختَر مِنهُمُ","مَن إِن أَسَأتَ إِلَيهِ يَوماً أَحسَنا",48,"ن",2,0],["فَتَصُكُّ عِرضَكَ كُلُّ قافِيَةٍ","مِنّي بِما يَحذو لَها فِكري",49,"ر",2,0],["فتصدعُ قلبي حينَ تصدحُ سُحرةً","وقد حلَّ أهلُ الرقمتينِ مُتالعا",50,"ع",2,0],["فتصفها منعم","مشرف مقرب",51,"ب",1,0],["فتصعّب الفتح المحقّق عندهم","فتآمروا عن محق إسلامبول",52,"ل",1,0],["فَتَصَدَّى ومِثلُه مَن تصَدَّى","ولِخَيرِ المُجيبِ خيرُ الجًَوابِ",53,"ب",1,0],["فَتصرِفُ حَتّى تَسجُمَ العَينُ عَبرَةً","بِها وَهيَ مِهمارٌ وَشيكٌ سُجومُها",54,"م",3,0],["فتصوروا من كان امس منعما","لم يكترث لطوارئ الايام",55,"م",1,0],["فتصيد غيرك ليس يعرف كنهها","وكم الخبيثة بالدهاء تصيد",56,"د",1,0],["فتصدَّعَتْ عن ناقةٍ فُتنوا بها","وقضاءُ ربّك ليس عنه مَرْحَلُ",57,"ل",1,0],["فتصفَّح أَسفارهم إنَّ فيها","حِكماً تجعلُ الضَّلول رشيدا",58,"د",2,0],["فَتَصدَّى لِخُبْرِ مُضْمَر صَدْري","فإذا بي فِي زَفْرَةٍ وسِياقِ",59,"ق",1,0],["فتصيرون حيارى نادمين","فاحذروا يا قوم خطباً أنذرا",60,"ر",2,0],["فَتَصَعَّدَتْ زَفَرَاتُهَا ثُمَّ انْبَرَتْ","تَشْكُو النوَى بِتَحَرُّقٍ وَتَعَلُّقِ",61,"ق",1,0],["فتصغي الصحارى لأنشودةٍ","مخلّعة الوزن والقافيةْ",62,"ي",2,0],["فتصده وترى الحياة بقربه","ويصدها ويرى النعيمَ بقربها",63,"ب",3,0],["فَتَصَرَّمَ المَشتى وَمَنزِلُهُ","رَحبٌ لَدَيَّ وَعَيشُهُ رَغدُ",64,"د",1,0],["فتصدُّ وجهتنا مراقبة","وكلا هوادينا به وُدُّ",65,"د",1,0],["فتصيب الأرض فتنبتها","خضْراً في القاع وفي الأكمِ",66,"م",1,0],["فتصبحُ داريَ معمورةً","ويربعُ ما كان منها محيلا",67,"ل",2,0],["فتصدقا بقبول زهر حديقةٍ","تمتاح طيب الطيب من رياكما",68,"م",2,0],["فتصرمت أيامه","وكأنها رجع الجفون",69,"ن",1,0],["فتصارعا طودين لا","هذا ولا هي ظا