{"poems":[[93,"وارحمتا لي من صروف زماني","https://www.aldiwan.net/poem11180.html","الكامل"],[51,"وفي ابن عمار عزيرية","https://www.aldiwan.net/poem62009.html","السريع"],[44,"لمكاسر الحسن بن وهب أطيب","https://www.aldiwan.net/poem30585.html","الكامل"],[105,"مضى العام وانبعث المنتظر","https://www.aldiwan.net/poem44049.html","المتقارب"],[105,"أجيبي أم كلثوم أجيبي","https://www.aldiwan.net/poem44064.html","الوافر"],[128,"أنت الحبيب المرتضى ولك الهنا","https://www.aldiwan.net/poem50490.html","الكامل"],[204,"نفسي الفدا لمقارب كمباعد","https://www.aldiwan.net/poem53327.html","الكامل"],[259,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[305,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[349,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[371,"رسم علي لناظري","https://www.aldiwan.net/poem57439.html","مجزوء الكامل"],[434,"لم كره التمام أهل الهوى","https://www.aldiwan.net/poem25697.html","السريع"]],"verses":[["لَمْ كَانَ مَا فِي جِدِّهِ فِي جِدِّهِ","لَعَلَتْ مَكَانَتُهُ إِلَى كِيوَانِ",0,"ن",1,0],["لِمْ كان ما كان ولمْ لَمْ يكن","ما لم يكن فهو وكيل البشرْ",1,"ر",1,0],["لَمَكاسِرُ الحَسَنِ بنِ وَهبٍ أَطيَبُ","وَأَمَرُّ في حَنَكِ الحَسودِ وَأَعذَبُ",2,"ب",1,1],["لِمَكَّةَ حُرمتُها والذمام","وللَّهِ سُبحانَهُ ما أَمَرْ",3,"ر",1,0],["لمَكَّةُ إذ يُضامُ الدِّينُ فيها","أحقٌّ بكلِّ أفَّاكٍ مُريبِ",4,"ب",1,0],["لِمَ كفَّ عني كلُّ خطبِ حادثٍ","وأذلَّ ضدى بالقواضبِ والقَنَا",5,"ن",2,0],["لمكان ألفٍ لا يخلّى واحدٌ","لكنَّ ألفاً يكرَمون لواحدِ",6,"د",1,0],["لمكمّلنا ولسيّدنا","ولناصحنا ولمرشدنا",7,"ن",2,0],["لِمكارِم إِن يَحوِ غَيرُكَ نَزرَها","فَكَما حَوى أَسماءَها المَسطورُ",8,"ر",1,0],["لِم كَيفَ ما كَم أَينَ وَالخَمسُ لِمَن","بِالسِتِّ إِذ حادَ عَنِ الحَدِّ أَسَر",9,"ر",1,0],["لمكلَّفٍ يسمُ الرسو","مَ بدَمعِهِ المتَواتِرِ",10,"ر",1,0],["لِمْ كَرِهَ التَّمَّامَ أَهْلُ الْهَوى","أَساءَ إِخْواني وَما أَحْسَنُوا",11,"ن",3,1]]}