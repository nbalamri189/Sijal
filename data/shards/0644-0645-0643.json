{"poems":[[95,"وارحمتا لي من صروف زماني","https://www.aldiwan.net/poem11180.html","الكامل"],[53,"وفي ابن عمار عزيرية","https://www.aldiwan.net/poem62009.html","السريع"],[46,"لمكاسر الحسن بن وهب أطيب","https://www.aldiwan.net/poem30585.html","الكامل"],[107,"مضى العام وانبعث المنتظر","https://www.aldiwan.net/poem44049.html","المتقارب"],[107,"أجيبي أم كلثوم أجيبي","https://www.aldiwan.net/poem44064.html","الوافر"],[132,"أنت الحبيب المرتضى ولك الهنا","https://www.aldiwan.net/poem50490.html","الكامل"],[208,"نفسي الفدا لمقارب كمباعد","https://www.aldiwan.net/poem53327.html","الكامل"],[264,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[310,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[376,"رسم علي لناظري","https://www.aldiwan.net/poem57439.html","مجزوء الكامل"],[440,"لم كره التمام أهل الهوى","https://www.aldiwan.net/poem25697.html","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64069","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49913","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138450",""],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128893","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133226","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44895","الرمل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36273","الدوبيت"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104538","الكامل"],[4691,"قد نما الحب بقلبي فنما","https://www.poetsgate.com/ViewPoem.aspx?id=60870",""],[4859,"لؤم الجفاء","https://www.poetsgate.com/ViewPoem.aspx?id=186746",""],[4859,"هتاف الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=187963",""],[4968,"أمّاه","https://www.poetsgate.com/ViewPoem.aspx?id=206754",""],[5199,"كلنا لجل الملك والسعوديه فدى","https://www.poetsgate.com/ViewPoem.aspx?id=147704",""],[5273,"عيناك","https://www.poetsgate.com/ViewPoem.aspx?id=178285",""],[5644,"ثوب العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=204444",""],[5720,"رحمةُ العالمينَ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=198917",""],[5770,"الحلم الذي ولَّى","https://www.poetsgate.com/ViewPoem.aspx?id=178680",""],[5956,"أعيش لحبك","https://www.poetsgate.com/ViewPoem.aspx?id=182354",""],[5956,"أكمل صديق","https://www.poetsgate.com/ViewPoem.aspx?id=202393",""],[5957,"قلبي يئن","https://www.poetsgate.com/ViewPoem.aspx?id=213542",""],[6093,"خطََّ البكاءُ على الخدودِ مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=176266",""],[5355,"هو ما طغى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87228&r=&rc=53",""]],"verses":[["لَمْ كَانَ مَا فِي جِدِّهِ فِي جِدِّهِ","لَعَلَتْ مَكَانَتُهُ إِلَى كِيوَانِ",0,"ن",1,0],["لِمْ كان ما كان ولمْ لَمْ يكن","ما لم يكن فهو وكيل البشرْ",1,"ر",1,0],["لَمَكاسِرُ الحَسَنِ بنِ وَهبٍ أَطيَبُ","وَأَمَرُّ في حَنَكِ الحَسودِ وَأَعذَبُ",2,"ب",1,1],["لِمَكَّةَ حُرمتُها والذمام","وللَّهِ سُبحانَهُ ما أَمَرْ",3,"ر",1,0],["لمَكَّةُ إذ يُضامُ الدِّينُ فيها","أحقٌّ بكلِّ أفَّاكٍ مُريبِ",4,"ب",1,0],["لِمَ كفَّ عني كلُّ خطبِ حادثٍ","وأذلَّ ضدى بالقواضبِ والقَنَا",5,"ن",2,0],["لمكان ألفٍ لا يخلّى واحدٌ","لكنَّ ألفاً يكرَمون لواحدِ",6,"د",1,0],["لمكمّلنا ولسيّدنا","ولناصحنا ولمرشدنا",7,"ن",2,0],["لِمكارِم إِن يَحوِ غَيرُكَ نَزرَها","فَكَما حَوى أَسماءَها المَسطورُ",8,"ر",1,0],["لِم كَيفَ ما كَم أَينَ وَالخَمسُ لِمَن","بِالسِتِّ إِذ حادَ عَنِ الحَدِّ أَسَر",9,"ر",1,0],["لمكلَّفٍ يسمُ الرسو","مَ بدَمعِهِ المتَواتِرِ",10,"ر",1,0],["لِمْ كَرِهَ التَّمَّامَ أَهْلُ الْهَوى","أَساءَ إِخْواني وَما أَحْسَنُوا",11,"ن",3,1],["لمكتنفٍ بأسياف ال","أعادي أيّ مكتنف",12,"ف",1,0],["لمكارم الأخلاق منهُ نَوالهُ","وفَعَالُهُ لمَراتبِ العَلْياءِ",13,"ا",2,0],["لم كان نفس خلافنا كفرا وكا","ن خلافكم هو مقتضى الايمان",14,"ن",1,0],["لمكة فاستحث النوق حثا","ولا تَنِ في السُرى وتَوقَ مكثا",15,"ث",2,1],["لمكان فيه استحالت جليدا","ثم غيثا يهمى على الربوات",16,"ت",1,0],["لمكارم الأخلاق جاء متمما","إن المكارم للنفوس دواء",17,"ا",2,0],["لِمَ كانَت لَست أَدري غَيرَ أَن","كُنتُ في وادٍ مِنَ الحُبِّ جَديبِ",18,"ب",1,0],["لِم كاشَفَني الغَيورُ وَالوَقتُ صَفا","لَو شاهَدَ سِرَّ خَلوَتي راقَبَني",19,"ي",1,0],["لمكارم الأخلاق من إضدادها","نسب يقارن جنة بجهنم",20,"م",1,0],["لم َ كافأت َ ودادي جفوة ً","وجدير ٌ مثلنا أن يكرما",21,"م",2,0],["لمَ كلما أقبلت نحوك صدني","منك الغرور ورعشة الأهدابِ",22,"ب",1,1],["‏لمَ كلما دمعتْ عيونُ سمانا","هتف الحنينُ مجدداً ذكرانا",23,"ن",2,1],["لِمَ كَبّلُوا أَصْوَاتَنَا بِدَهَائِهِم","لِمَ صَافَحُوا أَوْجَاعَنَا وَسُكَاتَنَا",24,"ا",1,0],["لمكرمين الضيف للعانى ماتمد الزهيد","مزبنين ادخيلهم من سيوفً جردى",25,"د",2,0],["لِمَ كلّما أرسلتُ نبضي زَوْرَقاً؟","أغْرَقْتِهِ في يَمِّكِ المُتَغَطْرِسِ؟",26,"س",1,0],["لم كلما حاولت وأد صبابتي","ألقى فؤادي في هواك عصيا",27,"ي",2,0],["لِمكارمِ الأخلاقِ .. جِئْتَ مُتَمِمَا","ولِدِينِ ربِ الخلقِ كُنْتَ مُعَظِمَا",28,"م",2,1],["لمَ كلما حان اللقا","ءُ وجدتني دوماً مغادر؟",29,"ر",1,0],["لم كلما امتلأت جرا","رُالزيت أو فاضت بيادر",29,"ر",1,0],["لمكان يُنسيني الذكرى","لا أرضَى العيشةَ مُبتعِدا",30,"د",2,0],["لِمَ كلُّ مجدِ الكون قد أسرى إلى ال","أردنِّ حيث صلاحُ يحيا آمنا؟",31,"ن",2,1],["لمَ كلما هاجت مشاعر لهفتي","تتعثر الأبيات لا تتعطفُ",32,"ف",1,0],["لِمَ كلُّ يومٍ في الحياةِ أرى لنا","خِلاًّ يرُوْحُ مُوَدَّعاً منْقولا",33,"ل",2,0],["لِمَ كُنتَ ذا لهفٍ عليهِ وأدمعٍ","وهو الذي ما هانَ فينا أدمُعَهْ",34,"ع",2,0],["لِمَ كُنتَ تُظهرُ دائماً إرضاءَهُ","لِم كُنتَ تركضُ خلفَهُ كالإمّعَةْ",34,"ع",2,0]]}