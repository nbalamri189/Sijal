{"poems":[[55,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[74,"من منصفي من أناس","https://www.aldiwan.net/poem20306.html","المجتث"],[53,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[87,"تولستوي تجري آية العلم دمعها","https://www.aldiwan.net/poem62870.html","الطويل"],[45,"يا أخت خير أخ يا بنت خير أب","https://www.aldiwan.net/poem9460.html","البسيط"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[70,"أبرق بدا من جانب الغور لامع","https://www.aldiwan.net/poem1506.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/199486","الوافر"],[92,"إلى الشباب السوري","https://www.poetsgate.com/ViewPoem.aspx?id=179164",""],[92,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[146,"قد رجع الحق إلى نصابه","https://www.aldiwan.net/poem58439.html","الرجز"],[164,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[173,"إلى م أرجي ضر عيش منكدا","https://www.aldiwan.net/poem1615.html",""],[173,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[185,"خليلى هل من حيلة تعلمانها","https://www.aldiwan.net/poem58737.html","الطويل"],[185,"قفى يا أميم القلب نقرأ تحية","https://www.aldiwan.net/poem58834.html","الطويل"],[203,"لا زينة المرء تعليله ولا المال","https://www.aldiwan.net/poem45678.html","البسيط"],[214,"بناظريك بقد عامل نظر","https://www.aldiwan.net/poem13378.html","البسيط"],[242,"صبا نجد ألا هبي علينا","https://www.aldiwan.net/poem19274.html","الوافر"],[276,"أهاب سحيرا بالفراق مهيب","https://www.aldiwan.net/poem52070.html","الطويل"],[280,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[287,"انشر حديثا قديما كنت تطويه","https://www.aldiwan.net/poem32303.html","البسيط"],[302,"سرت موهنا والنجم في أذنها قرط","https://www.aldiwan.net/poem33231.html","الطويل"],[309,"إلى متى لا تجف عيني","https://www.aldiwan.net/poem16884.html","مخلع البسيط"],[358,"وافاك نيشان عز أنت جوهره","https://www.aldiwan.net/poem40347.html","البسيط"],[398,"قد ظل يجرح صدري","https://www.aldiwan.net/poem53660.html","المجتث"],[422,"أبو الثناء شهاب الدين ما بلغت","https://www.aldiwan.net/poem53899.html","البسيط"],[438,"بدور الحي مالت للأفول","https://www.aldiwan.net/poem12702.html","الوافر"],[449,"بالله يا نسمات الرند والبان","https://www.aldiwan.net/poem55955.html","عموديه"],[449,"تقول غدا هل تدري ما يلد الغد","https://www.aldiwan.net/poem55970.html","عموديه"],[463,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[463,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[463,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[466,"سل الحي عني هل غشيت لغيره","https://www.aldiwan.net/poem15481.html","الطويل"],[466,"واقسم ما يممت بالعزم وجهة","https://www.aldiwan.net/poem15585.html","الطويل"],[505,"أحيباب قلبي والمحبة دينها","https://www.aldiwan.net/poem37631.html","الطويل"],[519,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[591,"رأى الحسن في العشاق ممتثل الأمر","https://www.aldiwan.net/poem17532.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122610","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122719","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122792","الوافر"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102034","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86717","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48761","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48850","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59255","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59091","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35403","الطويل"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141355","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100951","البسيط"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143780","المتقارب"],[2105,"","https://poetry.dctabudhabi.ae/diwan/poem/101758","الوافر"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21474","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106833","الوافر"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205844","السريع"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146323","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201752","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204917",""],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74161","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65445","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112669","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74096","الوافر"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126940","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86306","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108134","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129398","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129372","المتقارب"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85234","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131017",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59449","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77134","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86360","الوافر"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102743","الطويل"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143044","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139678",""],[4680,"تفجّرْ لظى","https://www.poetsgate.com/ViewPoem.aspx?id=185052",""],[4755,"لَقَد عادُوا .. لِماذا لا نَعُودُ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=184350",""],[4831,"الطبيعة والجمال","https://www.poetsgate.com/ViewPoem.aspx?id=208020",""],[4941,"يا كاظم الغيظِ،لا تكظم حرائقه","https://www.poetsgate.com/ViewPoem.aspx?id=178742",""],[4984,"تبنى من العشق","https://www.poetsgate.com/ViewPoem.aspx?id=215820",""],[3591,"أين اللسان الذي فيه تفاهمنا","https://www.poetsgate.com/ViewPoem.aspx?id=149532",""],[5183,"هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=180231",""],[5277,"جرحُ فاطمة..رحمها الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=191249",""],[5278,"سُلَّم الغربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=202551",""],[5302,"لقاء بعد غياب","https://www.poetsgate.com/ViewPoem.aspx?id=215673",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[5431,"يوتوبيا...","https://www.poetsgate.com/ViewPoem.aspx?id=215433",""],[5582,"قَلْبٌ بِنارِ الهَوَى قَدْ ذابَ وَاحْتَرَقَا","https://www.poetsgate.com/ViewPoem.aspx?id=187203",""],[5587,"أَرْضُ الرِّسَالَاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=196678",""],[5667,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214837",""],[5736,"يا حادي الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=203923",""],[5996,"وما ذاك إلا عارض من طماعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181339",""],[6035,"متى أردتمُ رفعَ الثوب تَمْتَثِلُ !","https://www.poetsgate.com/ViewPoem.aspx?id=177094",""],[6045,"نبضة ألم ،، وومضة أمل","https://www.poetsgate.com/ViewPoem.aspx?id=176833",""],[6078,"ياأيُّها المتعبون","https://www.poetsgate.com/ViewPoem.aspx?id=202779",""],[6167,"حديث النجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85550&r=&rc=33",""],[6357,"ونقعد ُ كالنساء ِ ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78226&r=&rc=20",""],[6366,"ما لم يقله الرّسّام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86676&r=&rc=4",""]],"verses":[["وَهَل سَبَبٌ لِلشَيبِ مِن بَعدِ هَذِه","فَدَأبُكَ يا لَونَ الشَبابِ وَدابُها",0,"ب",3,0],["وهل سمعتم بشعرٍ","يأتي على غير وزنِ",1,"ن",1,0],["وهل ساقطٌ وافتْهُ دولةُ حكمه","وحفظٌ على السلطان إلا مبطَّلُ",2,"ل",1,0],["وَهَل سَلَكوا سُبلَ المَحَبَّةِ بَينَهُم","كَما يَتَصافى أُسرَةٌ وَعَشيرُ",3,"ر",1,0],["وَهَل سَمِعتِ سَلاماً لي أَلَمَّ بِها","فَقَد أَطَلتُ وَما سَلَّمتُ مِن كَثَبِ",4,"ب",1,0],["وَهلْ سَبِيلٌ إلى مَدْحٍ يكونُ بهِ","لأَهْلِ بَيْتِ رَسولِ اللهِ تَأْهِيلُ",5,"ل",1,0],["وهل سَلّمت سَلمَى على الحَجَرِ الذي","بِه العهدُ والتفّت عليِه الأصابع",6,"ع",1,0],["وَهَلْ سَلامٌ إِذَا لَمْ تُنْتَصَفْ أُمَمٌ","أَغْلَى مَرَافِقِهَا نَهْبٌ لِمُنْتَهِبِ",7,"ب",1,0],["وهل سمعَ الفُراتُ وأنت غافٍ","حنينَكَ للضفافِ .. وللرفاقِ؟",8,"ق",1,0],["وهل سوى مُتَعٍ زالتْ ستخلِفُها","مُخَّلداتٍ . حِساناً . خُرَّداً . مُتَع",9,"ع",1,0],["وهل سوى أنهم راحوا وقد نذروا","للحبِّ ما لم يجب منهم وما وَجبا",10,"ب",2,0],["وهل سمعتَ أو رأيت لابسا","ما خلَع الأرقمُ من إهابهِ",11,"ب",2,0],["وهل سبقتم إلى خير بجعلكم","للناس أنفسكم كبشاً من العجب",12,"ب",1,0],["وَهَل سادَ راضٍ مَرتَعَ الذُلِّ مَرتَعاً","وَهَل فازَ راضٍ مَورِدَ الذُلِّ مَورِدا",13,"د",2,0],["وَهَل سالَمَت مَن كانَ يَحمي جَنابَها","وَتَرعى بِهِ في كُلِّ أَرضٍ سَوامُها",14,"م",3,0],["وَهَل سَلوَةٌ تَسلِى المُحِبَّ مِن الهَوَى","وَتَترُكُ مِنهُ ساحَةَ القَلبِ بَلقَعَا",15,"ع",2,0],["وَهَل سَفَحَت عَيناىَ فِى الدّارِ غُدوَةً","بِداراً كًسَحِّ اللُّؤلؤِ المُتَهالِكِ",16,"ك",1,0],["وَهَل سَفحَت عَينَاكِ مِن نَأىِ دَارِنا","كَما سَفَحَت عَيناىَ مِن نَأيِ دارِكِ",16,"ك",1,0],["وهل سوى نفسهِ فد سودتُهُ وهل","تنالُ إلا بشقِّ النفسِ آمالُ",17,"ل",1,0],["وهل سهرت لدجا بعدي فقلت له","سل في الظلام اخاك البدر عن سهري",18,"ر",2,0],["وَهَلْ سُفْتِ النَّوَاسِمَ مِنْ شَذَاهُمْ","فَلاَ تَلْحَيْ فَتىً أَصْلَوْهُ بَيْنَا",19,"ن",2,0],["وَهَل سلوة بعد الفراق لهائم","شج قلبه قبل الفراق كَئيب",20,"ب",1,0],["وَهَل سمرت بعدي لغوب عَلى اللَوى","فأين اللَوى مني وأين لغوب",20,"ب",1,0],["وَهَلْ سَكَنَتْ فَاسٌ وَسَبْتَةٌ بَعْدَهُ","أَم اصطَكَّتَا كالخَافِقِين لهُ خَفْقَا",21,"ق",2,0],["وَهَل سَراب بِبَطنِ القاعِ مُلتَمِعٌ","كَالبَحرِ يَوماً إِذا جاشَت أَواذيهِ",22,"ي",2,0],["وَهَل سِربُها يَرعى بأَكنافِ حاجِرٍ","مُروجاً عليها من نسيج الحَيا بُسطُ",23,"ط",1,0],["وهل سبيل إلى خيام","بي الحجون ومروتين",24,"ن",1,0],["وَهَل سَماء العُلى صينت بِشهب هناً","إِذا تَمَرَّد ضدٌّ فَهيَ تَدحرَهُ",25,"ر",2,0],["وَهَل سَمِعتُم بِخُبرٍ","في جُند رَبَّةِ خِدر",26,"ر",1,0],["وهل سَمِعتَ بفضلٍ عُدَّ في زمنٍ","ولم يكن آخذاً منه بغاربه",27,"ب",2,0],["وهل سُرَّ العواذلُ أن طَرْفي","قصيرُ النومِ في الليلِ الطويلِ",28,"ل",1,0],["وهل سما عرش هارون الرشيد على","ملك بناه على عدل وعمران",29,"ن",1,0],["وهل ساحة الرقص الفسيحة لم تزل","تنظل أهل البيت أشجارها المرد",30,"د",1,0],["وهل سمعتْ لي إلى أن بَعث","تُ في أهل ودِّي لشكوى أنينا",31,"ن",2,0],["وهل سماتُ الحب إل","لا سَهَرٌ وسقَمُ",32,"م",1,0],["وهل سمعوا في اختلاف اللغات","بلجَّة بحرٍ تُسمَّى يدا",33,"د",2,0],["وهل سَنَّ لي مطْلُ الأماني تودُّداً","لذي قدرةٍ لم يُؤْوَ منه إِلى ودِّ",34,"د",1,0],["وهل ساجدٌ في الصين اِلا لكعبةٍ الح","جاز اذا ما كانَ للّهِ مُسْلِما",35,"م",2,0],["وهل سأل المختار أجراً على الهدى","لأُمَّته إلا المودَّة في القربى",36,"ب",2,0],["وهل سُقاةُ الطِّلا تدري إذا اِبتسَمتْ","أيُّ الحَيا بانَ عند الشّرْبِ أشهاها",37,"ا",3,0],["وَهَلْ سَنَحَتْ فِيهِ جَآذِرُهُ الَّتي","تُعوِّضُ بالأَلْبابِ مَرْعىً عَن الزَّهْرِ",38,"ر",1,0],["وهَل سَمَراتُ الجزعِ جِزعُ مَتاعةٍ","به مِن عَذارى الحيِّ بعدي سامر",39,"ر",1,0],["وَهَل سَقَى الغَيثُ حُوذان الشَّقيقَةِ فاخ","ضَرَّت أعاليهِ واخضَرَّت أسافِلُه",40,"ل",2,0],["وَهَل سُبِكَت نُجُومُ اللَّيلِ لَفظاً","وَصيغَ لَها عَمُودُ الصُّبحِ مَعنَى",41,"ن",2,0],["وهل سد مجرى الماء في الغصن يرتوي","به إنه في فرقة ولحاء",42,"ا",2,0],["وَهَل سَوى يُوسف الصَديق يذكرني","إِذا نُسيتُ وَعَني لَم يَسَل أَحَد",43,"د",1,0],["وهل سلمت من أهلها مصر ليلة","فتنجوَ من بطش الغريب وتسلما",44,"م",2,0],["وهل سره تكريمه في محافل","خلت من رسالاتي وطيب فنوني",45,"ن",2,0],["وَهَلْ سُعَادٌ وَسَلْمَى والرَّبَابُ إذَا","عُدَّتْ مَحَاسِنُ حُسْنَاهُنَّ إلاَكِ",46,"ك",1,0],["وَهَلْ سَحَبَتْ أيْدِي النَّسِيم ذُيولَها","عَلَى روضكِ الذَّاكِي الشَّذَا حين هَبَّتِ",47,"ت",1,0],["وَهَل سالَ في بَطنِ المَسيلِ تَشَوُّقاً","نُفوسٌ تَرامَت لِلحِمى قَبلَ جُثمانِ",48,"ن",1,0],["وَهَل سَمِعتَ مَن يُبارِي الحُلَمَا","بِعَثرَةٍ يُقصِي العَتِيقَ الأكرَمَا",49,"م",2,0],["وهل سليمان إلا عالمٌ علمٌ","ومحسن في مجال الخير مفضال",50,"ل",1,1],["وهل سليمان يرضى عن بينه إلذا","شقوا عصا البيت بالعدوان وانشعبوا",51,"ب",3,0],["وهل سنةٌ فيه مأثورةٌ","رواها لأشياخكم علقمه",52,"م",2,0],["وهل سودُ العيونِ سوى أُسودٍ","تَأَمَّلْ كيفَ يَفْتَرِسُ الفُتُورُ",53,"ر",1,0],["وَهَل سَبَقَتنا قَبلَكُم مِن قَبيلَةٍ","بوِترٍ فَتَقتاسوا بإِحدى القَبائِلِ",54,"ل",1,0],["وهل ساد الوفاءُ وماتَ غدرٌ","وزال الشكُّ وانحسر القناع",55,"ع",1,0],["وهل سواه ماسحٌ دمعتي","إذا دعاها للمسيل الكدر",56,"ر",1,0],["وهل سواه سامع أنّتِي","إذا دجا الليل وطال السّهر",56,"ر",1,0],["وهل سالِبُ العُزْيان إِلاّ منبّهٌ","على عَدمِ الأَشياءِ قبْلَ وجودها",57,"د",3,0],["وهل سينفعها العكاز إن زلقت","في سفح وادٍ فلاقت فيه وديانا",58,"ن",2,0],["وهل سترويه في جنان","لشاعر يسكن السماء",59,"ا",2,0],["وَهَل سمعت بشمل في الوجود غَدا","كَشمل أَصحاب كسرى غَير ملتئم",60,"م",1,0],["وهل سمعتم يكونُ يوماً","في الدّهر من صالح فسادُ",61,"د",1,0],["وهَل سمعتَ بحديثِ الأزدي","وكانَ من أهلِ الولا والزُهد",62,"د",1,1],["وَهَل سكن يَضيق بِنا إِذا ما","سَكنّا فَوقَ أَكوار النياقِ",63,"ق",1,0],["وهل سمرات الديس غودرن ذبّلا","أم اخضر لما أدبر الصيف عودها",64,"د",3,0],["وهل سوى حيدر الكرار كهف حمى","تأوي له الناس احياء وامواتا",65,"ت",2,0],["وَهَل سَوى طَيفُكم خلٌّ يُسامِرُنا","اِو قَد حوت غير ذِكراكُم سَرائِرَنا",66,"ن",2,0],["وهل سوى لغة الأعراب تؤنسنا","وهل لآذاننا من غيرها طرب",67,"ب",1,0],["وهل ساد الورى إلا كمي","يرنحه الثنا لا الخندريس",68,"س",1,0],["وهل سفر مؤذن في فتوح","ومالك في وجهه من غرر",69,"ر",1,0],["وهل سن هذا المصطفى في زمانه","أو الخلفا أو بعض من كان يصحب",70,"ب",1,0],["وهل سنة من كان للصحب تابعاً","إذا قام للتأذين يوماً يثوب",70,"ب",1,0],["وهل سيروا فيها الجواري تنجلي","على الماء يذكو ضمن أحشائها الجمر",71,"ر",1,0],["وهل سطعت منها الأشعة بينهم","فأبدين ما تخفي الترائب والصدر",71,"ر",1,0],["وَهل سَمرتْ بعدَ الهدوّ بربعهِ","معَاصرةُ الخُمص الحشَا وكواعُبهْ",72,"ب",2,0],["وَهَل ساغَ أَن يَعتاضَ عَنهُم بِجاهِلٍ","مِنَ النوك أَو فَدَمُ عَديمِ التِأَدُّب",73,"ب",1,0],["وهل سفرت براقع من شقيق","على الوجنات من نار ونور",74,"ر",1,0],["وهل سرها ما ساء عشاق حسنها","وقد نزفوا للبين دما وقد اطوا",75,"ط",3,0],["وهل سمعتَ بشعبٍ غير منصدِعٍ","على الزمان وحبلٍ غير مَبتوتِ؟",76,"ت",1,0],["وهل سيد للفضل بالفضل فائق","سواك وقد سَوَّاك نابغة الدهر",77,"ر",1,0],["وهل سوف يجدي صبركَ اليوم بعدما","هوى الأمس من أعلى معاليكَ وارتمى؟",78,"م",2,0],["وهَل سَنَعُودُ _إنْ عُدنا_ كِرامًا","وكُلُّ سِلاحِنا طَبلٌ وعُودُ؟!",79,"د",1,0],["وهلَّ سَعيداً أَصيلُ غروبٍ","لِيَسْقيَ شَوقاً رُبا رَوْضَتَيْنِ",80,"ن",1,0],["وهل ستعلمُ أنّا دمعُ أجنحةٍ","بلا هواءٍ وخلْفَ الحلمِ صيّادُ",81,"د",1,0],["وهل سيلام إذا اضطرمت","مخاوفه إن حمى أمنه",82,"ن",2,0],["وهل سوى بغة الأعراب تؤنسنا","وهل لآذاننا من غيرها طرب",83,"ب",1,0],["وهل ساعدتني في الظلام جفونه","على النوم أم أدنى سروري ضياؤه",84,"ا",3,0],["وهل ستعرفُ أنَّ الطيفَ أرّقني","وأنّني طولَ هذا الليلِ لم أنمِ",85,"م",1,0],["وهل ستنفع بنت العين مغتصَباً","أم هل نردُّ بشجبٍ بعضَ ما فُقدا",86,"د",2,0],["وهل سنعرفهم لما تغيرت ال","وجوه منهم وثار الشيب والصلع",87,"ع",1,0],["وهل سائل يدعو فأكشف كربه","فإني أنا الوهاب والواسع الأبر",88,"ر",1,0],["وهل ستشكو؟...وأنى للنواح صدى؟؟؟","إني المليكة ..إني الذلّ للعرب",89,"ب",1,0],["[ وَهَلْ سَقَى الغَيْمُ أَطْلالَ الغَمِيمِ وَهَلْ","فِي سَفْحِهِ سَفَحَ الأَجْفانَ وَانْبَعَقا ]",90,"ق",2,0],["وَ هَلْ سَنَغْفُو عَلَى جُرْحٍ نُعَايِشُهُ","وَ لَا يَكُونُ سِوَى التَّنْدِيدُ بِالضَّمَدِ",91,"د",1,0],["وهلْ سيرحلُ يوماً ظلُّ داجيةٌ","سامَ الصباحاتِ منها العيُّ والخَدَرُ",92,"ر",1,0],["وهل ستورق أغصانٌ لذي شَفَةٍ","مصلوبةِ البوح قد مادت بها دارً",93,"ر",1,0],["وهل سرحة بالسفح من أيمن الصفا","رعت من عهودي ما أضاع مضيع؟",94,"ع",1,0],["وهلْ سيَثْبُتُ رُكنٌ لايُدَعِّمُهُ","جُلْمودُ حقّ على الإقْساطِ يَتَكِّلُ !",95,"ل",1,0],["وهل سيذكرني من بتّ أذكرهم","دهري ورحت بهم أسقي حكاياتي ؟",96,"ت",2,0],["وهل ستُختزَلُ الأحداثُ في صورٍ","ويُنتسى القهرُ عند الماءِ والكلأِ؟",97,"ا",1,0],["وهل سيكونُ في الأرضِ التصابى","ونارُ الصَبِّ يُطفؤها اللِقاءُ",98,"ا",2,0],["وهل ْ سيعود حق ٌ ضاع مِنا","إذا قد ْ بات َ يطْلبْهُ الصغار ُ",99,"ر",1,0],["وهل سيرسم أمًّا حضنُها وطنٌ","ينام في دفئه مَنْ أدمَنَ السَّهرا؟",100,"ر",2,0]]}