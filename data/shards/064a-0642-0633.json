{"poems":[[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[32,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[11,"أتعرف أطلالاَ ونؤيا مهدم","https://www.aldiwan.net/poem268.html",""],[74,"يوم صحو فاجعله لي يوم سكر","https://www.aldiwan.net/poem18694.html","الخفيف"],[53,"ومسمع لا عدمت فرقته","https://www.aldiwan.net/poem66043.html","المنسرح"],[31,"بانت سعاد ففي العينين ملمول","https://www.aldiwan.net/poem6024.html","البسيط"],[72,"وأحمق ذي لحية","https://www.aldiwan.net/poem42875.html","مجزوء الرجز"],[45,"جاء نيروزنا وأنت مراده","https://www.aldiwan.net/poem9556.html","الخفيف"],[2,"قف بالديار التي لم يعفها القدم","https://www.aldiwan.net/poem25057.html","البسيط"],[68,"يا هلالا من سلطة العي حيي","https://www.aldiwan.net/poem38473.html","الخفيف"],[109,"كم أظهر العشق من سر","https://www.aldiwan.net/poem58554.html","عموديه"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62233","المتقارب"],[1,"","https://poetry.dctabudhabi.ae/diwan/poem/199405","الطويل"],[136,"ألم يأن أن تجفو الصبا وتحلما","https://www.aldiwan.net/poem54748.html","الطويل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[208,"للدهر ما بين الأنام وزيف","https://www.aldiwan.net/poem53097.html","الكامل"],[208,"للعيد أوعدني من لم يزل عيدا","https://www.aldiwan.net/poem53320.html","البسيط"],[369,"وطالع من مشرق القباء","https://www.aldiwan.net/poem61019.html","الرجز"],[447,"أما من بني حوا خليل محالم","https://www.aldiwan.net/poem14383.html","الطويل"],[463,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[463,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[463,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[463,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[463,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[466,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[469,"ما على الركب من تلافي تلافي","https://www.aldiwan.net/poem3215.html","عموديه"],[520,"طرقتها والليل وحف الجناح","https://www.aldiwan.net/poem12054.html","السريع"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53723","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126683","الطويل"],[881,"","https://poetry.dctabudhabi.ae/diwan/poem/21184","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202071","الخفيف"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6774","السريع"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109073","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69339","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53169","الرجز"],[2543,"","https://poetry.dctabudhabi.ae/diwan/poem/123744","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100897","البسيط"],[3002,"","https://poetry.dctabudhabi.ae/diwan/poem/73580","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132719","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132674","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67982","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75687","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199123","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73158","الوافر"],[4852,"أحلى الهدايا","https://www.poetsgate.com/ViewPoem.aspx?id=214354",""],[5081,"بَعِيدٌ عَنْ عُيُونِي فِي فُؤَادِي","https://www.poetsgate.com/ViewPoem.aspx?id=190827",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5691,"الحبر والورقة","https://www.poetsgate.com/ViewPoem.aspx?id=206386",""],[5926,"حار عقلي","https://www.poetsgate.com/ViewPoem.aspx?id=214302",""],[6112,"تطاول ليلي لم أنمه تقلباً","https://www.poetsgate.com/ViewPoem.aspx?id=186531",""],[6152,"قسوة حنون","https://www.poetsgate.com/ViewPoem.aspx?id=203072",""],[6189,"الريحانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83581&r=&rc=48",""],[433,"لقاء القاهرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87049&r=&rc=2",""]],"verses":[["يُقسِمُ بِاللَهِ لَئِن جائَهُ","عَنّي أَذىً مِن سامِعٍ خابِرِ",0,"ر",1,0],["يُقَسِّمُ فَضلَهُ وَالسِرُّ مِنهُ","جَميعُ لا يُفَرِّقُهُ شِلالا",1,"ل",2,0],["يُقَسِّمُهُ غُنماً وَيَشري كَرامَةً","وَقَد صِرتَ في خَطٍّ مِنَ الأَرضِ أَعظُما",2,"م",2,0],["يقسم الدَّهر من سطاه بليل","ومن المنظر البهيّ بفجر",3,"ر",1,0],["يقسو له القلبُ حين يسمعُه","على أحِبَّائهِ بلا جرَمِ",4,"م",1,0],["يَقسِمُ أَمراً أَبَطنَ الغَيلِ يورِدُها","أَم بَحرَ عانَةَ إِذ نَشفَ البَراغيلُ",5,"ل",1,0],["يُقسَمُ عُشرُ عُشرِها","يَكفي رِجالاً عَشَرَه",6,"ر",2,0],["يَقسِمُ الفارِسَ المُدَجَّجَ لا يَس","لَمُ مِن شَفرَتَيهِ إِلّا بِدادُه",7,"د",2,0],["يَقسِمُ ثُمَّ يُسَوّي القَسمَ بَينَهُمُ","مُعتَدِلُ الحُكمِ لا هارٍ وَلا هَشِمُ",8,"م",1,0],["يُقسِمُ الدولَ بِالسَطا وَالعَطايا","بَينَ يَومَي إِقامَةٍ وَمَطِيِّ",9,"ي",1,0],["يقسو الحبيبان قدر الحب بينهما","حتى لتحسب بين العاشقين دما",10,"م",2,0],["يُقَسَّمُ في الحَيِّ أَبْدَاؤُهَا","وبَعْضُ الحَدِيثِ يَكُونُ انْتِحَالاَ",11,"ل",2,0],["يقسم فيهم ماله وقطينه","قياما عليه بالمآلي حواسرا",12,"ر",2,0],["يُقَسِّمُهُ العَافُونَ والجَارُ بَينِهِم","فَيَحسَبَهُ الرَّاءُونَ نَهباً مُقَسَّمَا",13,"م",2,0],["يَقسِمُ الجودَ بَينَهُم وَمِنَ اللَ","هِ أَتاهُم عَلى يَدَيهِ العَطاءُ",14,"ا",2,0],["يقسو ويعنُفُ في الحروب وشأنُه","في السلم بَرٌّ بالأنام رؤوفُ",15,"ف",1,0],["يقسو ويرحم إملاجاً بذاك وذا","فيبسط العدل تلييناً وتشديدا",16,"د",2,0],["يَقْسِمُ طَرْفَ المُقلةِ الخَوصاء","في اللِّعْبِ بين الأرضِ والسّماء",17,"ا",2,0],["يقسمها الباني فيأخذ بعضها","ويترك منها بعضها وهو قاسم",18,"م",1,0],["يَقسِم بالوافي وبالبخس في ال","ناس وعندي خيبةُ المَقسَمِ",19,"م",1,0],["يُقسم الرُّوَّاضُ أن قد كَرُمَتْ","فارتبطها هكذا تُبلَى الخيولُ",20,"ل",1,0],["يُقسم والصدق قمينٌ به","بما حبا الأرضَ وما نوّرا",21,"ر",2,0],["يقسِمُ الماءَ بباعٍ مطلَقٍ","وفَقارٍ مُرسَلِ الحبلِ سَروبِ",22,"ب",1,0],["يُقسِمُ لا شِيمَ وهو سيفٌ","بعدُ ولا شَمَّ وهو ذيبُ",23,"ب",1,0],["يقسو على طعنِ الكُماةِ فؤادهُ","ويَرِقُّ للمستضعفينَ ويَرْحَمُ",24,"م",1,0],["يقسم الرزق حين يجري المنايا","في القني المثقفات النحاف",25,"ف",1,0],["يقسم مابين الندى والردى","مالاً مباحاً وعدواً مجاح",26,"ح",1,0],["يقسمُ الأيرَ عادلاً","بين حِرهَا وفَقْحَتْه",27,"ه",1,0],["يقسّم أرزاق الخلائق بينهم","وَيوردهم مِن ماء منهله العذبِ",28,"ب",1,0],["يُقَسِّمُها حَتّى يُسيغَ وَلَم يَكُن","كَآخَرَ يُضحي مِن تَحَيُّنِهِ زَجرُ",29,"ر",1,0],["يَقْسِمونَ الِجنانَ والنَّار فيهم","فلكل نصيبه المَوْجُوبُ",30,"ب",1,0],["يَقسِمُهُ طُلّابُهُ بَينَهُم","قِسمَةَ تَعديلٍ بِقَدرِ الفِطَن",31,"ن",1,0],["يقسو إِذا فقد الرجاء من الذي","يأسو ويبسم إن يصادف مأملا",32,"ل",2,0],["يُقسِمُ مَن قالَ لا شَبيهَ لَهُ","يَمينَ بَرِّ اليَمينِ مِن قَسَمِه",33,"م",2,0],["يقسو إذا لنت وإن","وفيتُ بالعهد مَطَل",34,"ل",1,0],["يقسو عليّ فؤادُه","وقوامُه غصناً رطيبُه",35,"ب",2,0],["يَقسِمُهَا من قُطبٍ لقطبِ","قِسمَين ذا شَرقي وهَذا غربي",36,"ي",1,0],["يقسيهمُ التاجُ إِن لاذوا بعزّته","الاَّ الكرام فان لاذوا به رحمِوا",37,"م",3,0],["يقسم الود فيما بيننا قسماً","ميزان صدق بلا بخس ولا عين",38,"ن",1,0],["يقسم السمر والبيض الرقاق لهم","فللصدور القنا والبيض للقمم",39,"م",1,0],["يقسو ويأبى ان يرق لمغرم","دمه بأسياف الغرام اريقا",40,"ق",2,0],["يقسِّم ساعاتِ الحياةِ تفكُّراً","ليَصْدَعَ كيد الملحدين ويَقْصُر",41,"ر",1,0],["يقسم الجَمع مِن أَعداه يَوم وَغا","فَالهام لِلسَيف وَالأَجسام للرجم",42,"م",1,0],["يُقِس بِشَكلٍ بَيِّنِ الإِنتَاجِ","إذ خَلقَهُ مِن نُطفَةٍ أمشَاجِ",43,"ج",1,0],["يقسم وَقتيه فوقت عبادة","وَوقت لبذل العلم يمنحه منحا",44,"ح",2,0],["يقسم من سبع مئين عدا","وبعدها عشرون زدها ردا",45,"د",2,0],["يُقسنِّي الهوَى كمداً وحُزناً","فأمرُهما لِحَتفي مُستَمرُّ",46,"ر",1,0],["يقسو ..على البوحِ الهواءُ .. فهل لنا","أنْ نُرسلَ الأنفاسَ .. حتى تحملَه؟",47,"ل",2,0],["يُقَسَّمُنِي إِلَى قَلْبَيْنِ حُبٌّ","يُجَمِّعُنِي لِيَحْضُرَنِي اغْتِرَابُ !",48,"ب",1,0],["يقسم الجزى في الكفار بعد وغىً","قتلاً وسبياً وتشريداً للمنهزم",49,"م",1,0],["يُقْسِمُ الخالِقُ في القرآنِ بي","رِفْعَةً بالعِلْمِ لا بالخَرَقِ",50,"ق",1,0],["يقسو فؤادي ولكن في تعاملهِ","يحنو إذا حل فيه الخل أو بانا",51,"ن",2,0],["يقسمها حتى تشيع ولم يكن","كآخر يضحى من غبيبته ذخر",52,"ر",1,0],["يقسو فأمنحه الحنان توددا","وتذوذ عنه عيونه وخصاله",53,"ل",2,0],["يُقَسِّم نبضه في كل أرض","ففي كل البقاع له وجيب",54,"ب",1,0],["يُقسّم بهجتَه في النفوسِ","ويُطلق أجنحةَ الشاعر",55,"ر",1,0]]}