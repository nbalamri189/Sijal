{"poems":[[55,"مسيري إلى ليل الشباب ضلال","https://www.aldiwan.net/poem29909.html","الطويل"],[55,"وذي نضد لا يقطع الطرف عرضه","https://www.aldiwan.net/poem30440.html","الطويل"],[53,"يا ابن كسرى كسرى الملوك أنوشر","https://www.aldiwan.net/poem66329.html","الخفيف"],[91,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[136,"كنا إذا مسنا من دهرنا نكد","https://www.aldiwan.net/poem54643.html","البسيط"],[168,"ديار الحي بالرس","https://www.aldiwan.net/poem67584.html","الهزج"],[193,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[333,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[408,"يا دار سلمى بسفح ذي سلم","https://www.aldiwan.net/poem46982.html","المنسرح"],[563,"إن هذا زمن الأمر العسير","https://www.aldiwan.net/poem34490.html","الرمل"],[563,"كفة الغيب كفة الحسنات","https://www.aldiwan.net/poem34721.html","الخفيف"],[563,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"],[567,"بروق قد تخللها رعود","https://www.aldiwan.net/poem52749.html","الوافر"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71027","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46531","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1365,"","https://poetry.dctabudhabi.ae/diwan/poem/202426","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118309","الخفيف"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101722","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85198","الرمل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67627","المتقارب"],[4664,"","https://poetry.dctabudhabi.ae/diwan/poem/101166","الرمل"],[4444,"شردت يا هذا شرود البعير","https://www.poetsgate.com/ViewPoem.aspx?id=85447",""]],"verses":[["وَهَوجاءَ قُدّامَ الرِكابِ مُغِذَّةٍ","لَها مِن جُلودِ الرازِحاتِ نِعالُ",0,"ل",1,0],["وَهَوجاءَ في أَشواطِها عَجرَفِيَّةٌ","تَسوقُ مِنَ الغَورِ الغَمامَ الكَنَهوَرا",1,"ر",2,0],["وهو جزءٌ مما وعدتَ ضئيلٌ","غَرِقٌ في صِلاتك المقسومه",2,"م",2,0],["وهو جريح دمه","يجري على الجوانب",3,"ب",1,0],["وهَو جَلُ يخبط الظلماء متعسفا","لا يستقيم له سهل ولا جلد",4,"د",1,0],["وَهَوجاءَ خَجوجِيٍّ","تَصُلُّ الغَربَ بِالمَشرِق",5,"ق",1,0],["وَهوَ جَذلانُ والمحيّا بسيمُ","فَعليه الصلاة والتسليمُ",6,"م",1,0],["وهو جفنٌ ناعس الأح","لام لا يدري الصباح",7,"ح",1,0],["وهوَ جَوازِي عَلى الصِّراط إذا","زلّتْ بما قَدْ جَنيتُهُ قَدمي",8,"م",2,0],["وهو جزء اختياريٌّ لهم","حققوه وإلى الله المصير",9,"ر",1,0],["وهو جمر على جهنم جهل","هو أغيار حضرة الحضرات",10,"ت",1,0],["وهو جفن من الجفون لعيني","وأنا الجسم منه وهو الشعار",11,"ر",1,0],["وهُوجُ عواصفٍ ثارتْ فكادتْ","جِبالُ الشُّوفِ من قَلَقٍ تَميدُ",12,"د",1,0],["وهو جماع الفقه والعلوم","وموضع الحاجة للخصوم",13,"م",1,0],["وهو جبان حائر بليدُ","يكاد لا يبدى ولا يُعيدُ",14,"د",1,0],["وَهوَ جَدير بِالغَضَب","من عامل إِذا نَهَب",15,"ب",1,0],["وهو جمال خزمه بالجيم","وأول الموزون حرف الميم",16,"م",1,0],["وهو جرم أبو حنيفة قد رخ","ص فيه فما به من جناح",17,"ح",1,0],["وهو جمع له وليس بفرد","فارددوا ما في كتبكم للصواب",18,"ب",1,0],["وهو جاء فتلاء المرافق جسرة","شمردلة عيطاء ذات وسوم",19,"م",1,0],["وهو جدي وارث العلياء عن","جده المختار حالاً ومقاما",20,"م",2,0],["وهو جواد بيَّن الجُود فقل","تعنى السخيّ فاعلمنه يا رجل",21,"ل",1,0],["وهو جمٌ لديك فابعث بدرج","منه إن لم أكنْ تعديت طوري",22,"ر",2,0],["وهو جاث بين ظهرانيهم","يدفع الجلى لدى الخطب الزوام",23,"م",1,0],["وهو جديد عندنا نهجه","أعلامه تحويه منا الصدور",24,"ر",1,0]]}