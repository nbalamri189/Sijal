{"poems":[[53,"رب هيفاء رداح","https://www.aldiwan.net/poem64963.html","مجزوء الرمل"],[53,"يا أبا الصقر زادك الله في المجد","https://www.aldiwan.net/poem65411.html","الخفيف"],[53,"بكعبة الله بل بخالقها","https://www.aldiwan.net/poem65716.html","المنسرح"],[64,"سعدت بطول بقائك الحقب","https://www.aldiwan.net/poem52479.html","أحذ الكامل"],[46,"بدلت عبرة من الإيماض","https://www.aldiwan.net/poem30469.html","الخفيف"],[83,"هاتها كالمنار لاح النهار","https://www.aldiwan.net/poem61524.html","الخفيف"],[48,"بك على الناس بالمزموم والرمل","https://www.aldiwan.net/poem23216.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54717","الخفيف"],[147,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[147,"فت الورى فعلام ذا الإجهاد","https://www.aldiwan.net/poem11754.html","الكامل"],[173,"بمعاديك لا بك الأسواء","https://www.aldiwan.net/poem1596.html",""],[240,"طاف يسعى بها على الجلاس","https://www.aldiwan.net/poem31916.html","الخفيف"],[242,"إلى الخياط عبد الله جئنا","https://www.aldiwan.net/poem19091.html","الوافر"],[264,"يا نبيا بعثت للخلق رحمه","https://www.aldiwan.net/poem35967.html","الخفيف"],[266,"أظهر الروض حلاه كنوزا","https://www.aldiwan.net/poem38260.html","الخفيف"],[305,"حي الديار بسيل فالقهر","https://www.aldiwan.net/poem45482.html","أحذ الكامل"],[369,"فعلت هذه الجفون الضواري","https://www.aldiwan.net/poem60874.html","الخفيف"],[374,"يا جمال الدنيا ولولاك كانت","https://www.aldiwan.net/poem4313.html","الخفيف"],[463,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[469,"لو ألمت فأباحتني لما لها","https://www.aldiwan.net/poem3295.html","عموديه"],[487,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126873","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63855","الرمل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105460","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136162","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79797","الكامل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113885","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87398","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127006","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78310","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90832","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83569","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72503","الخفيف"],[4578,"بغرةٍ تنقضى في حبها حججي","https://www.poetsgate.com/ViewPoem.aspx?id=49370",""],[4578,"فؤادي بإيجاب الوصال وسلبه","https://www.poetsgate.com/ViewPoem.aspx?id=49353",""],[5136,"شرف باذخ رفيع منيف","https://www.poetsgate.com/ViewPoem.aspx?id=121621",""],[5848,"ابعد نافذة","https://www.poetsgate.com/ViewPoem.aspx?id=53450",""],[5848,"فواتير الغلا","https://www.poetsgate.com/ViewPoem.aspx?id=53370",""],[6089,"طافوا وطفتُ سعوا سعيتُ رموا رميتُ","https://www.poetsgate.com/ViewPoem.aspx?id=214664",""]],"verses":[["بكَ عرَّضتُ وإن كن","تَ قليل الامتعاض",0,"ض",1,0],["بك عادت آمالنا وهي آما","ل وقد كُنَّ مرة أطماعا",1,"ع",2,0],["بكعبة الله بل بخالقها","أقسم لو أن خالداً غرقا",2,"ق",2,1],["بكَ عَزَّ دينُ اللّهِ واتَّضَحَتْ","آياتُه وتكشَّفَ الحُجُب",3,"ب",1,0],["بِكَ عادَ النِضالُ دونَ المَساعي","وَاِهتَدَينَ النِبالُ لِلأَغراضِ",4,"ض",1,0],["بِكَ عَزَّت لِما حَوَتكَ وَلَولا السِ","راحُ لَم تُمتَدَح دِنانٌ وَقارُ",5,"ر",1,0],["بَكِّ عَلى الناسِ بِالمَزمومِ وَالرَملِ","فَإِنَّ أَعمالَ دُنياهُم كَلا عَمَلِ",6,"ل",1,1],["بِكَ عَادَ الرَّضِي وَابْنُ العَمِيدِ","وَالعُلَى بَيْنَ مُبْديءٍ وَمُعِيدِ",7,"د",1,1],["بِكَ عاذَ هَذا الدينُ دُمتَ نَصيرَهُ","مِمّا يَخافُ وَنالَ ما يَتَرَقَّبُ",8,"ب",1,0],["بِكَ عادَ دَهري ضاحِكاً مِن بَعدِما","أَلوى بِسَدرِ العُمرِ وَهوَ مُقَطِّبُ",8,"ب",1,0],["بِكَ عادَ سَيفُ الشِركِ مَفلولَ الشَبا","وَغَدَت قُوى الإِسلامِ وَهيَ شِدادُ",9,"د",1,0],["بِكَ عادَ الزَمانُ طِفلاً وَعاشَ ال","جودُ مِن بَعدِ مَوتِهِ وَالوَفاءُ",10,"ا",2,0],["بِكَ عاذَت مِن شَرِّ شَيطانِهِ الوَس","واسِ فيها وَمُكرِهِ الخَنّاسِ",11,"س",1,0],["بِكَعْبَةِ مَجْدِكُمْ لُذْنَا وَطُفْنَا","وَفِي عَرَفَاتِ عُرْفِكُمْ وَقَفْنَا",12,"ن",2,0],["بِكَ عِقدُ الإِسلامِ نُظِّمَ قِدماً","كَيفَ أَيدي اللِئامِ تَنثُرُ نَظمَه",13,"م",2,0],["بك عزت عزاز قدماً وقد","ذلت وأحييت دابقاً والفوزا",14,"ز",2,0],["بِكَ عِترَةُ الضَبِّ الذَليلَةِ تَح","رَنبي عَلى أَرحائِها الخُضرِ",15,"ر",1,0],["بكَ عَيْشي إذا أردْتَ ومَوتي","قد جعَلْناك فيهما بالخِيار",16,"ر",1,0],["بك عزّ الإسلامُ واتّضح الحقُّ","وأعشى الهدى عيونَ الضلال",17,"ل",1,0],["بك عزَّت الآدابُ واثَّأرتْ","من بعد ما نامت على الذحلِ",18,"ل",1,0],["بك عمّ وَدْقُ سحابِها","جوداً وتمّ فخارُها",19,"ر",3,0],["بكَ عزَّ الفضلُ والدهرُ معاً","وبنى العلياءِ واشتد غماها",20,"ا",3,0],["بكعبة أنوار أنخت مطيتي","وأنزلت حاجاتي لأحظى ببغيتي",21,"ت",2,1],["بك عينُ ذي المجد الأثيل قريرةٌ","قرّو العلى في المهد إبراهيمُ",22,"م",1,0],["بك عزَّ النرجسُ المض","عفُ في دارةِ عزَّا",23,"ز",2,0],["بك عاد عود الدهر وهو يميس من","طرب ونبت الأرض وهو نضير",24,"ر",1,0],["بك علم اليقين يبدو عيانا","بمعان تبدي جميل الافاده",25,"د",2,0],["بكَ عنه لُذنا حيثُ لا شَرفٌ","عند الإِلهِ أجلُّ من شرفك",26,"ك",1,0],["بك عاد مسرورا كما بك قد أتى","فرحا قرير الطرف غير مكدر",27,"ر",1,0],["بك عاد مجدهُمُ الأَنيقُ معزَّزاً","وازداد ذكرهم المعطَّرُ طيبا",28,"ب",2,0],["بكعبة نعماه يطوف حجيجه","وفيها مصيف للأماني ومربع",29,"ع",1,0],["بِكَ عَم الوُجود جُودٌ عَميم","نَضَّرت وَجهَها بِهِ الغَبراء",30,"ا",2,0],["بكَعبَة الحُسن اِنسانا أَرى فَلَوا","عَيني الَّتي طالَما ضَلَّت من الغَسق",31,"ق",1,0],["بك عبدالرحمن نجل الحميدى","صار يرجو النجاة يوم الجزاء",32,"ا",2,0],["بك عن مكارمه تعوضت الورى","إذ لم يمت بشر لمثلك خلفا",33,"ف",2,0],["بك عزّي إِذ اِعتززت ورَبّي اِخ","تصَّ بِالعِزِّ أُمَّةً أَحمَدِيَّه",34,"ي",2,0],["بك عبد الرحمن حلَّ فحلت","معه فيك جملة البركات",35,"ت",1,0],["بكعبة الخدتقضى بالصفا عمرٌ","وكم لطايف دمعي فيه من حجج",36,"ج",1,0],["بكعبك وافاني الروس مُرفعاً","مقامي على رغم الحسود وكربه",37,"ب",2,0],["بك عنهم قد فرج الله من الحي","غم يغشاه موج كثيف",38,"ف",1,0],["بك عالمٍ سفلي ولك أقدام ما تتحملك","وفيك القناعات السخيفه وانفعالات الظنون",39,"ن",1,0],["بك عالمٍ يلفني بالروعه","اشرب ولا اهز بيدي فنجالي",40,"ل",2,0],["بكَ عذتُ من ملأٍ عبيدِ نفوسِهم","لمّا رأوني جئتُ بابَكَ أُزْعِجوا",41,"ج",3,0]]}