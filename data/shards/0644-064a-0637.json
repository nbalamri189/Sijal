{"poems":[[53,"لي طيلسان ليس يترك لي","https://www.aldiwan.net/poem8306.html","أحذ الكامل"],[53,"ليطمعك في رجعات الملول","https://www.aldiwan.net/poem65869.html","المتقارب"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[53,"لي طيلسان إن يبده زمانه","https://www.aldiwan.net/poem66439.html","الطويل"],[53,"لي طيلسان أنا في يديه","https://www.aldiwan.net/poem66772.html","الرجز"],[93,"ليطرب من شاء أن يطربا","https://www.aldiwan.net/poem8759.html","عموديه"],[21,"ليطلب الثأر أمثال ابن ذي يزن","https://www.aldiwan.net/poem36166.html","البسيط"],[48,"أمور تستخف بها حلوم","https://www.aldiwan.net/poem22558.html","الوافر"],[164,"خذ الملك يا يحيى إليك بقوة","https://www.aldiwan.net/poem58881.html","الطويل"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[201,"لي طرف لم يدر ما الإغفاء","https://www.aldiwan.net/poem39813.html","الخفيف"],[230,"سفرت فلاح لنا هلال سعود","https://www.aldiwan.net/poem55248.html","الكامل"],[242,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[266,"أنا مضنى نوى الأحبة نضو","https://www.aldiwan.net/poem38109.html","الخفيف"],[280,"أهلا بهن أهلة وكواكبا","https://www.aldiwan.net/poem25628.html","الكامل"],[369,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[438,"قد عصينا النهى فكيف النهاتا","https://www.aldiwan.net/poem12429.html","الخفيف"],[543,"عرفت مقام القوم إذ بت تجهد","https://www.aldiwan.net/poem48236.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48768","البسيط"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44835","الطويل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199808","المسحوب"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144168","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201656","الخفيف"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97996","المتدارك"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99319","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112298","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205488","الهزج"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59503","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86369","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127232","الوافر"],[4191,"","https://poetry.dctabudhabi.ae/diwan/poem/22603","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139554",""],[4709,"إليها وحدها أهدي فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=214802",""],[4767,"الأمل المعلق","https://www.poetsgate.com/ViewPoem.aspx?id=215856",""],[4859,"رأس الكرامة","https://www.poetsgate.com/ViewPoem.aspx?id=197634",""],[4877,"لي قلب","https://www.poetsgate.com/ViewPoem.aspx?id=29455",""],[5121,"طِفْلَتِي","https://www.poetsgate.com/ViewPoem.aspx?id=49544",""],[5307,"يا طير","https://www.poetsgate.com/ViewPoem.aspx?id=10534",""],[5365,"شكراً جزيلا","https://www.poetsgate.com/ViewPoem.aspx?id=191082",""],[5431,"قارورة عطر...","https://www.poetsgate.com/ViewPoem.aspx?id=202545",""],[5483,"ليطف لهيب القلب وليذهب السقم","https://www.poetsgate.com/ViewPoem.aspx?id=186107",""],[5717,"يهدي الى الدين وناهيك به","https://www.poetsgate.com/ViewPoem.aspx?id=170594",""],[5786,"يا بارقاً لاحَ من أكتاف كوفانِ","https://www.poetsgate.com/ViewPoem.aspx?id=50655",""],[5853,"((غيمٌ بلا مخاض))","https://www.poetsgate.com/ViewPoem.aspx?id=175650",""],[5897,"همسات لحظة","https://www.poetsgate.com/ViewPoem.aspx?id=156243",""],[5956,"ما أكثر آلامَ الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=185320",""],[5956,"لعنة الله على رأيِ طبيب بيطريٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=192230",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6160,"مَزَامِيرُ لِلْعِشْقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87086&r=&rc=3",""],[5871,"الجُرحُ مَفتُوحٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74655&r=&rc=35",""]],"verses":[["لي طيلسانٌ ليس يترك لي","رَفْوي له مالاً ولا نَشَبا",0,"ب",2,1],["ليُطمِعْكَ في رَجَعاتِ الملو","ل أن الملولَ يَملُّ المَلالا",1,"ل",2,1],["ليطرقْهُ ضيفٌ أو لتطرقه نوبةٌ","فما للقرى عن طارقيه مُعتَّمُ",2,"م",1,0],["لي طيلسانٌ إنْ يُبده زَمانُهُ","فبحقه وبما أبادَ زمانَهُ",3,"ن",2,1],["لي طيلسانٌ أنا في يديه","مثلُ الأسير خانعٌ لدَيهِ",4,"ي",2,1],["لِيَطرَبَ مَن شاءَ أَن يَطرَبا","فَلَستُ بِمُستَمطِرٍ خُلَّبا",5,"ب",2,1],["ليَطلُبَ الثَأرَ أَمثالُ اِبنِ ذي يَزَنٍ","في البَحرِ خَيَّمَ لِلأَعداءِ أَحوالا",6,"ل",2,1],["لِيَطَّلِعَ المَليكُ عَلَيكَ فيها","وَأَنتَ عَلى نَوائِبِها صَبورُ",7,"ر",1,0],["ليطلعك الباري على كل ما خفى","على من تولى الملك من غير محنة",8,"ه",1,0],["ليطفئ نور الله منهم بأفوه","تساعده بالفخ حينا وتتعب",9,"ب",1,0],["لي طرفٌ لم يدر ما الإغفاء","وفؤاد عاثت به الأدواء",10,"ا",2,1],["لَيَطيبُ لي في حُبِّها ذُلّى كما","في مدح إِسماعيلَ لذَّ نَشيدي",11,"د",2,0],["لِيَطِيبَ ذَا نَفْساً فَيَحْمَدْ","وَيَزِيدَ ذَا رِجْساً فَيَحْرَدْ",12,"د",1,0],["لي طرف جار كلمحة طرف","وعناني إلى الصبابة رخو",13,"و",1,0],["لِيُطَهّر الآفاقِ من ذَنْبِ العدى","حَمَل الصوارِم في الغُمودِ مذانِبا",14,"ب",2,0],["ليُطْلِقَ أرواحاً غَدتْ من جُسومهمْ","مُعذَّبةً في مُظْلماتِ سُجون",15,"ن",1,0],["لِيَ طَبْعٌ لانَتْ لديهِ القوافي","فلوِ اختارَ لم يَدَعْ بَعْدُ هاتا",16,"ت",2,0],["لَيَطوِي ضُلوعا عن يقينٍ برَبِّه","يقينٌ متينٌ سَرمدىٌّ مُؤيُد",17,"د",1,0],["ليطمئن إليه كلُّ معتركٍ","ويستقر عليه كلُّ مضطرب",18,"ب",1,0],["لِيُطلِعَ فِي مُلدِ الغُصُونِ كَوَاكِباً","مِنَ الزهرِ تُعشِي العَينَ لَمعَ شُرُوقِ",19,"ق",1,0],["لي طبوعه ظفو واحساني","دوم عند الناس مشكوره",20,"ر",2,0],["ليَطُلْ مدى يومي القصير فما غداً","إلا ردىً ألقاهُ أو يلقاني",21,"ن",2,0],["ليَ طبعٌ في الشعر يملك حيناً","ثم يُثري فيغتدي ذا سخاء",22,"ا",2,1],["لي طرفٌ لم يلمح حسناً","إلا وغراماً أشرعه",23,"ع",2,0],["لي طعام من داره وشراب","ومقيل في ظله ومبيت",24,"ت",1,0],["ليَ طَرفٌ بالبُكا قد صَفحا","وَلِنَفسي غَيرهُ لم يَرُقِ",25,"ق",1,0],["ليطرق بابها طوعًا","ويدرج فوقها حيَّا",26,"ي",2,0],["لي طَعْمانِ فطَعمٌ سائغٌ","عَذبُ الذَّوْقِ وطعمٌ فيه سُمْ",27,"م",1,0],["ليطبق على أبنائه وبناته","يدينوا ويرتاحوا ارتياح المطابق",28,"ق",1,0],["لي طبع يروض فيك القوافي","طيعات إذا تلوت شماسا",29,"س",2,0],["ليطوي نشره بثي ويطفي","لهيب حوى لي فقد المب",30,"م",2,0],["لِيَطعَنَهُ فَقُلتُ لَهُ خُذَنها","مُسَوَّمَةً يَخِفُّ لَها القَطينُ",31,"ن",1,0],["ليطلب أدنى الرزق من عند طالبٍ","ويسأل بعضَ القوت من كفِّ ساغب",32,"ب",1,0],["ليطرقَ طارقٌ أبوابَ عمري","يذكرني نهايةَ أربعيني",33,"ن",2,0],["لي طاب ثغرُكِ شهدهُ ال","حلوُ الذي يتدفق",34,"ق",1,0],["ليطهّرَ التاريخَ من رجسِ العدا","فالله أكبرُ من فلولِ عداكِ",35,"ك",1,0],["لي طموحات تدفعني لدرب المسير","والعزيمه حياتي وأتحلا بها",36,"ب",3,0],["لِي طِفْلَةٌ بَيْنَ الضُّلُوعِ لِحَافُهَا","نَامَتْ بِرُوحِي فَاسْتَرَاحَ شَغَافُهَا",37,"ف",3,1],["لي طارن الربد المهاريب","لي ذايرات من العوادي",38,"د",2,0],["ليُطفِئَ نارَ عشقٍ في هواها","تلَظّت كلّما أرخَتْ جديلا",39,"ل",2,0],["ليُطلق من قارورة الطيب ماردٌ","يُقيم على النشوى كحبرٍ على الورق!",40,"ق",1,0],["ليطف لهيب القلب وليذهب السقم","فقد أنعمت بالوصل بعد الجفا نعم",41,"م",1,1],["ليطلب الصلاح والاصلاح باخ","تياره شوقا بلا تبرم",42,"م",1,0],["لي طودُ علمٍ سما بي فرعَه فَعلا","حتى بدا مشرقاً منْ فوقِ كيوانِ",43,"ن",1,0],["لي طلولٌ بكيتُ فيها غرامي","كل شبرٍ منَ اللظى يتألمْ",44,"م",1,0],["ليطير قلبي في حدائق لحظتي","ويحط حيث يقرر الهذيان",45,"ن",1,0],["ليطبِّق تشريعَ الأديانْ","ويعيشَ ولو في ظِلِّ أمانْ",46,"ن",1,0],["لي طبيبٌ بيطري قال: طَعْمُ الل","حْمِ أحلَى بعد تجويعِ النَّجيبِ*",47,"ب",1,1],["ليطفي هجير الوَجد وَالشَوق وَالنَوى","بِأَمر الَّذي مداه بدر تَمام",48,"م",1,0],["لي طبعُ أهْلِ العِشْقِ والعُشَّاقِ","طِفْلٌ يَتُوقُ ... لِقُبْلَةٍ وَعِنَاقِ",49,"ق",1,1],["ليَطِيبَ خاطِرُها","تلكَ التي قد أصبحتْ ثَكْلَى",50,"ا",1,0]]}