{"poems":[[51,"لي طيلسان ليس يترك لي","https://www.aldiwan.net/poem8306.html","أحذ الكامل"],[51,"ليطمعك في رجعات الملول","https://www.aldiwan.net/poem65869.html","المتقارب"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"لي طيلسان إن يبده زمانه","https://www.aldiwan.net/poem66439.html","الطويل"],[51,"لي طيلسان أنا في يديه","https://www.aldiwan.net/poem66772.html","الرجز"],[91,"ليطرب من شاء أن يطربا","https://www.aldiwan.net/poem8759.html","عموديه"],[21,"ليطلب الثأر أمثال ابن ذي يزن","https://www.aldiwan.net/poem36166.html","البسيط"],[46,"أمور تستخف بها حلوم","https://www.aldiwan.net/poem22558.html","الوافر"],[158,"خذ الملك يا يحيى إليك بقوة","https://www.aldiwan.net/poem58881.html","الطويل"],[158,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[195,"لي طرف لم يدر ما الإغفاء","https://www.aldiwan.net/poem39813.html","الخفيف"],[223,"سفرت فلاح لنا هلال سعود","https://www.aldiwan.net/poem55248.html","الكامل"],[235,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[259,"أنا مضنى نوى الأحبة نضو","https://www.aldiwan.net/poem38109.html","الخفيف"],[273,"أهلا بهن أهلة وكواكبا","https://www.aldiwan.net/poem25628.html","الكامل"],[362,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[429,"قد عصينا النهى فكيف النهاتا","https://www.aldiwan.net/poem12429.html","الخفيف"],[536,"عرفت مقام القوم إذ بت تجهد","https://www.aldiwan.net/poem48236.html","عموديه"]],"verses":[["لي طيلسانٌ ليس يترك لي","رَفْوي له مالاً ولا نَشَبا",0,"ب",2,1],["ليُطمِعْكَ في رَجَعاتِ الملو","ل أن الملولَ يَملُّ المَلالا",1,"ل",2,1],["ليطرقْهُ ضيفٌ أو لتطرقه نوبةٌ","فما للقرى عن طارقيه مُعتَّمُ",2,"م",1,0],["لي طيلسانٌ إنْ يُبده زَمانُهُ","فبحقه وبما أبادَ زمانَهُ",3,"ن",2,1],["لي طيلسانٌ أنا في يديه","مثلُ الأسير خانعٌ لدَيهِ",4,"ي",2,1],["لِيَطرَبَ مَن شاءَ أَن يَطرَبا","فَلَستُ بِمُستَمطِرٍ خُلَّبا",5,"ب",2,1],["ليَطلُبَ الثَأرَ أَمثالُ اِبنِ ذي يَزَنٍ","في البَحرِ خَيَّمَ لِلأَعداءِ أَحوالا",6,"ل",2,1],["لِيَطَّلِعَ المَليكُ عَلَيكَ فيها","وَأَنتَ عَلى نَوائِبِها صَبورُ",7,"ر",1,0],["ليطلعك الباري على كل ما خفى","على من تولى الملك من غير محنة",8,"ه",1,0],["ليطفئ نور الله منهم بأفوه","تساعده بالفخ حينا وتتعب",9,"ب",1,0],["لي طرفٌ لم يدر ما الإغفاء","وفؤاد عاثت به الأدواء",10,"ا",2,1],["لَيَطيبُ لي في حُبِّها ذُلّى كما","في مدح إِسماعيلَ لذَّ نَشيدي",11,"د",2,0],["لِيَطِيبَ ذَا نَفْساً فَيَحْمَدْ","وَيَزِيدَ ذَا رِجْساً فَيَحْرَدْ",12,"د",1,0],["لي طرف جار كلمحة طرف","وعناني إلى الصبابة رخو",13,"و",1,0],["لِيُطَهّر الآفاقِ من ذَنْبِ العدى","حَمَل الصوارِم في الغُمودِ مذانِبا",14,"ب",2,0],["ليُطْلِقَ أرواحاً غَدتْ من جُسومهمْ","مُعذَّبةً في مُظْلماتِ سُجون",15,"ن",1,0],["لِيَ طَبْعٌ لانَتْ لديهِ القوافي","فلوِ اختارَ لم يَدَعْ بَعْدُ هاتا",16,"ت",2,0],["لَيَطوِي ضُلوعا عن يقينٍ برَبِّه","يقينٌ متينٌ سَرمدىٌّ مُؤيُد",17,"د",1,0]]}