{"poems":[[51,"لي طيلسان ليس يترك لي","https://www.aldiwan.net/poem8306.html","أحذ الكامل"],[51,"ليطمعك في رجعات الملول","https://www.aldiwan.net/poem65869.html","المتقارب"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"لي طيلسان إن يبده زمانه","https://www.aldiwan.net/poem66439.html","الطويل"],[51,"لي طيلسان أنا في يديه","https://www.aldiwan.net/poem66772.html","الرجز"],[91,"ليطرب من شاء أن يطربا","https://www.aldiwan.net/poem8759.html","عموديه"],[21,"ليطلب الثأر أمثال ابن ذي يزن","https://www.aldiwan.net/poem36166.html","البسيط"],[46,"أمور تستخف بها حلوم","https://www.aldiwan.net/poem22558.html","الوافر"]],"verses":[["لي طيلسانٌ ليس يترك لي","رَفْوي له مالاً ولا نَشَبا",0,"ب",2,1],["ليُطمِعْكَ في رَجَعاتِ الملو","ل أن الملولَ يَملُّ المَلالا",1,"ل",2,1],["ليطرقْهُ ضيفٌ أو لتطرقه نوبةٌ","فما للقرى عن طارقيه مُعتَّمُ",2,"م",1,0],["لي طيلسانٌ إنْ يُبده زَمانُهُ","فبحقه وبما أبادَ زمانَهُ",3,"ن",2,1],["لي طيلسانٌ أنا في يديه","مثلُ الأسير خانعٌ لدَيهِ",4,"ي",2,1],["لِيَطرَبَ مَن شاءَ أَن يَطرَبا","فَلَستُ بِمُستَمطِرٍ خُلَّبا",5,"ب",2,1],["ليَطلُبَ الثَأرَ أَمثالُ اِبنِ ذي يَزَنٍ","في البَحرِ خَيَّمَ لِلأَعداءِ أَحوالا",6,"ل",2,1],["لِيَطَّلِعَ المَليكُ عَلَيكَ فيها","وَأَنتَ عَلى نَوائِبِها صَبورُ",7,"ر",1,0]]}