{"poems":[[95,"يا صاحب الدولة","https://www.aldiwan.net/poem9163.html","مجزوء الرجز"],[95,"أبدعت في ديوان شعرك","https://www.aldiwan.net/poem9830.html","مجزوء الكامل"],[87,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55106","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55026","البسيط"],[102,"اعتراف بلا توبة","https://www.poetsgate.com/ViewPoem.aspx?id=50337",""],[119,"يا غزالا قلب مضناه ملك","https://www.aldiwan.net/poem40613.html","عموديه"],[203,"يا ظلة الموج يطغى البحر منتفضاً","https://www.aldiwan.net/poem45135.html","البسيط"],[358,"يا رجائي في شدتي ورخائي","https://www.aldiwan.net/poem40841.html","الخفيف"],[396,"يا لطيف الطف بي فيجميع أحوالي","https://www.aldiwan.net/poem54515.html","عموديه"],[458,"طرفت فلما أغرورقت عيني","https://www.aldiwan.net/poem61681.html","أحذ الكامل"],[580,"تظنني قد بت محموما","https://www.aldiwan.net/poem2803.html","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38258","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88652","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67970","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89056","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66435","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33450","الخفيف"],[4702,"الدم يطلب الثار","https://www.poetsgate.com/ViewPoem.aspx?id=155212",""],[4988,"أقضب لسانك","https://www.poetsgate.com/ViewPoem.aspx?id=196640",""],[5096,"يا لطف يومي","https://www.poetsgate.com/ViewPoem.aspx?id=206821",""],[5121,"طير الحقول","https://www.poetsgate.com/ViewPoem.aspx?id=37478",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5525,"الخل العنيد","https://www.poetsgate.com/ViewPoem.aspx?id=872",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5674,"ياعازف الناي","https://www.poetsgate.com/ViewPoem.aspx?id=185214",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[5309,"ما اختيالي بحسن وجه ومال","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573961",""]],"verses":[["يا لطف ما أبدعت في","سفارة المسافر",0,"ر",1,0],["يا لطف ما أودعت في ال","ألفاظ من نفثات سحرك",1,"ك",1,0],["يا لُطفِ أَنتَ هُوَ الصَدى","مِن ذَلِكَ الصَوتِ الرَخيمِ",2,"م",1,0],["يَا لُطْفَ مِشْيَتِكِ الْعَفِيفَةِ وَزْنُهَا","مُتَدَاركٌ وَالخَطْوُ غَيْرُ وَشِيكِ",3,"ك",1,0],["يَا لُطْفَهَا فِي نِظَامٍ لاَ يُنَافِسُهُ","عِقْدٌ بِهِ نُظِمَتْ شَتَّى مِنَ الطُّرَف",4,"ف",1,0],["يا ( لطف ) مهما لمتني لم أدع","هذا السلوك الشائن الممتعا",5,"ع",2,0],["يا لطيف الذات يا حلو اللمى","جرت لكن قامة ما اعدلك",6,"ك",1,0],["يا لطف نفسي للعشاق تحسبهم","يوم النوى نزعت من قلبهم قطع",7,"ع",1,0],["يا لَطيفاً بخلقِهِ اِلطف بِعَبدٍ","خائِض في الأَهوال وَالأَهواءِ",8,"ا",2,0],["يا لطيف الطف بي فيجميع أحوالي","يا عظيم الفضل يا الكريم الوالي",9,"ي",1,1],["يا لطيف الطف بي","في جميع أحوالي",9,"ي",1,0],["يا لطفها فيما تُبادلني","بمنَّوعٍ من سحرها الفنِّى",10,"ن",2,0],["يا لَطَعامٍ متُّ من أَكْله","لعلَّه قد كان مَسْمُوما",11,"م",2,0],["يا لَطيفاً بِخَلقِهِ","أَنتَ تُعلي وترفَعُ",12,"ع",1,1],["يا لَطيفا رقت شمائله الحسنى","فاوهن شمألا وشمولا",13,"ل",2,0],["يَا لَطود الوفاءِ والحلم صَفْحاً","لَيْسَ عَفْوُ الملوك عنك بعازِب",14,"ب",1,0],["يا لطف هذاك اليرا","ع وبأس ذلك من فرند",15,"د",1,0],["يا لطيف لم تزل ألطافه","للورى في كل باب كامنه",16,"ن",2,1],["يا لِطرفيكَ ما أبلا فؤادي","ما خلا اليوم نلتَهُ فهَناكا",17,"ك",2,0],["يالطاغية يابن الطواغيت الاشرار","من عهد ابوك وشعبكم يشكي الجور",18,"ر",1,0],["يالطّحالب كلّ ابوكم والله عفون","والعفن بالنّاس اللّه لا يقيمه",19,"م",2,0],["يا لُطْف يوْمي إذْ بدتْ لي بِشمْسهِ","ضياءٌ .. ووجْدي أحْرقتْ نارهُ الحشا",20,"ش",2,1],["يَا لِطَيْرٍ صَوْتُهُ ارْتَدَّ ابْتِهَالاً","دَاعِيًا وَالْغَيْثُ رَيْحَانُ الطُّلُولِ",21,"ل",1,0],["يا لطفه من صاحب","يا ظرفه من مصطحب",22,"ب",1,0],["يا لطيف الروح وبحق خلاق العبيد","اكرم المملوك بالوصل والا فاعتقه",23,"ق",2,0],["يا لطرفي ويا لقلبي ويا لي","من هوىً يرسل السلام سهاما",24,"م",2,0],["يا لطفها دارنا .. يا نسمة عبرت","على الأحبة والأحلام .. تأتيني",25,"ن",2,0],["يا لطيف الْألْطاف في كّل حالٍ","صرْت عودًا هشًّا هوى منْ لحاء",26,"ا",2,0],["يا لَطيبٍ مِنَ الأَزاهِرِ يُغني","عَن بَديعِ الأَلوانِ والأَشكالِ",27,"ل",1,0]]}