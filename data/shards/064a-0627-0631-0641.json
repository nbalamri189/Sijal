,"https://www.poetsgate.com/ViewPoem.aspx?id=1149",""],[1117,"رفيق الدرب","https://www.poetsgate.com/ViewPoem.aspx?id=19376",""],[2110,"يا مهاة قد نأت عن مقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=156291",""],[5670,"يَا مَلاذِي !","https://www.poetsgate.com/ViewPoem.aspx?id=211204",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5897,"يوم عالمي للمرأة ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=176830",""],[5993,"يارفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=186544",""],[6056,"الجرح القديم","https://www.poetsgate.com/ViewPoem.aspx?id=130355",""],[6163,"وطئت أقدامنا سطح القمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80802&r=&rc=2",""],[6213,"مغارات السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76300&r=&rc=48",""]],"verses":[["يا رَفيقيَّ قِفا نِضوَيكُما","بَينَ أَعلامِ النَقا وَالمُنحَنى",0,"ن",2,1],["يَا رِفَاقَ الخَيْرِ هَذَا","نَبَأٌ سَرَّ وَأَحْيَا",1,"ي",2,0],["يا رِفاقي حَطِّموا أَقداحَكُم","لَيسَ في دَنِّيَ خَمرٌ لِاِنسِكابِ",2,"ب",1,0],["يا رِفاقي حَطِّموا أَقدَاحَكُم","لَيسَ في الدُنيا رَحيقٌ لِاِنسِكابِ",3,"ب",1,0],["يا رَفيقي ما بَلَغتَ المُنتَهى","لَيسَتِ الحَدَّ الأَخيرَ الحُفَرُ",4,"ر",1,0],["يا رِفاقي يا جُنودي اِحتَشِدوا","عَبَرَ الأَعداءُ في اللَيلِ التُخوم",5,"م",1,0],["يا رفيقي وأَينَ أَنْتَ فَقَدْ","أَعْمَتْ جُفوني عواصِفُ الأَيَّامِ",6,"م",1,1],["يا رفيقي مَا أحسبُ المنبعَ المنشودَ","إلاَّ وراءَ ليلِ الرِّجَامِ",6,"م",1,0],["يا رفيقي أَما تفكَّرْتَ في النَّاسِ","وما يحملونَ مِنْ آلامِ",6,"م",1,0],["يا رفيقي لقد ضَلَلْتُ طريقي","وتَخَطَّتْ مِحَجَّتي أَقدامي",6,"م",2,0],["يا رُفاتاً مِثلَ رَيحانِ الضُحى","كَلَّلَت عَدنٌ بِها هامَ رُباها",7,"ا",3,0],["يا رفاقي هذه السَّاعةُ من حُلمِ الزَّمانِ","إنَّ هذا زَمَنُ الحبِّ فضِجُّوا بالأغاني",8,"ي",1,1],["يا رفاقي قد دعانا زمن الحبِّ فهيَّا","أطْلَعَ الروضُ جنَى الكرمةِ والزَّهرَ النديّا",8,"ي",2,0],["يَا رَفِيقِي إِذَا عَرَانِيَ خَطْبٌ","وَنَصِيرِي إِذَا خَصِيمٌ تَصَدَّى",9,"د",2,0],["يَا رُفْقَتِي هَيْهَاتَ يَشْ","فِي حُرْقَتِي هَذَا الْخِطَابُ",10,"ب",1,0],["يَا رفْقَتِي بَدْءَ الصِّبَا عَجَبٌ","هَذَا المَصِيرُ لِذلِكَ البَادِي",11,"د",2,0],["يا رِفْقَةً كُلُّهُمْ أَدِيبٌ","وَكُلُّهُمْ فاضِلٌ مُهَذَّبْ",12,"ب",1,1],["يا رفيقي في طريق العمر","في ركب الحياة",13,"ه",1,0],["يا رفيقي هات أذنيك","وخذ أشهى رنيني",13,"ي",1,0],["يا رفاقي إن أحزنت أغنياتي","فالمآسي حياتكم وحياتي",14,"ت",2,1],["يا رفاقي في كلّ مكسر غصن","إن توالى الندى ربيع ، مواتي",14,"ت",2,0],["يا رفيقي : ألموت شرّ ... وأدهى","منه ... وأنّا نريده وهو يأبى",15,"ب",2,0],["يا رفيقي هذه ليلتنا","عاقر سكرى بآثام السفاح",16,"ح",1,0],["يا رفيقي في السرى هل للسرى","آخر ؟ هل لظلام الدرب ماحي ؟",16,"ح",2,0],["يا رفاق السرى إلى أين نسري","وإلى أين نحن نجري ونجري ؟",17,"ر",2,1],["يا رفاق السرى إلى كم نوالي","خطونا في الدجى إلى لا مقرّ ؟",17,"ر",1,0],["يا رفاقي لنا مع الفجر وعد","ليت شعري متى يفي ؟ ليت شعري !",17,"ر",2,0],["يا رفاقي تثاءب الشرق وانسلّت","عذاري الصباح من كلّ خدر",17,"ر",1,0],["يارفيقي... لاتواخذني على عزة .. كياني..","وأنخذيتبها.. ف..عذري معي.. قرم أو.. من عبيده..",18,"د",2,1],["يا رفيقاً بعبده ومحيطاً","علمهُ باختلافِ سري وجهري",19,"ر",2,0],["يا رفاقي بكيت فيكم شبابي","كلّ عيش بعد الشباب فضول",20,"ل",1,0],["يا رفيقي ... أنا لولا أنت ما وقّعت لحنا","كنت في سرّي لما كنت وحدي أتغنّى",21,"ن",2,1],["يا رفقتي كأسي حلا","والحب لي قد انجلى",22,"ل",2,1],["يا رفاعي وقعت في أبوابك","فدارك عبدا يلوذ ببابك",23,"ك",1,1],["يا رفاعي يا غوث كل البرايا","لا تضيع طفلا جميل الرجابك",23,"ك",1,0],["يا رفاقي أني لرؤية نور الوج","ه منها أغيب قلباً وأحضر",24,"ر",1,0],["يا رفيع المقام يا ابن الرفاعي","يا ولياً تعاظمت علياه",25,"ا",2,0],["يا رفيقي في الخيالِ","وعَذيري في الضَلالِ",26,"ل",1,1],["يا رَفيقي على طرِيق الحَزاني","سِر فإِنَّ القَضاء أَقصى مَدانا",27,"ن",2,1],["يا رفاق الصبا دعوني فلا يجدي","فتيلاً لومي كفانيَ ما بي",28,"ب",2,0],["يا رفاقي لا تحفروا لي إذا ما","متّ شوقا قبراً بقفر يباب",28,"ب",1,0],["يا رفيقي يا رسول","الحب في دنيا القلوب",29,"ب",1,0],["يا رفاقي أكؤس الصبا المريره","أجَّجَت نار الأسى في أضلُعي",30,"ي",1,0],["يا رَفيقَيَّ هَل لِذاهِبِ أَيّا","مٍ تَقَضَّت حَميدَةً مِن مَرَدِ",31,"د",1,0],["يارفيقي في الأسى كَفْ","كِفْ دموعي لا تعادي",32,"د",2,0],["يارفاقي في الهوى مَهْ","لاً، عداني من جفاني",33,"ن",2,0],["يا رفاقي إنّي عليل التصابي","علّلوني بذكرهم علّلوني",34,"ن",2,0],["يا رفيع المجد اسفرت لنا","عن منيع العرض والوفر المباح",35,"ح",1,0],["يا رفيقي سِر على مَهلٍ وقِف","إنّ دمعي مع شعوري انفَجَرا",36,"ر",2,0],["يا رَفيقي إِن كُنتَ نِعمَ الرَّفيقُ","دَع مَلامي فَالقَلبُ صَبٌّ مَشوقُ",37,"ق",1,1],["يا رفيقي وأنت موحى قصيدي","وإليك العظيم رجاء مجيد",38,"د",1,1],["يا رفيقي وأنت أنت بنفسي","ما تمنيه من رجاء مجيد",38,"د",1,0],["يا رفيقي ونحن ما قلت جرحا","ن سيلان من دم وصديد",38,"د",1,0],["يا رفيقي والشعب يغمره الصم","ت تسمّع لصوته المخمود",38,"د",1,0],["يا رفيقي ونحن ما قلت روحا","ن يضجّان في حديد القيود",38,"د",1,0],["يا رفيقي وليس هذا غريبا","فبعيد الآمال غير بعيد",38,"د",1,0],["يا رفيقي ما مصر ما الشعب ما فر","عون ما عمرو ما كرام الجدود",38,"د",1,0],["يا رفيقي ما مصر وهي من العا","لم كالسيد العريق الطريد",38,"د",1,0],["يا رفيقي ما الشعب وهو بقايا","حلم ضاع من خيال شريد",38,"د",1,0],["يا رفيقي ونحن أبناءُ فرعو","ن وحراس مجده في الوجود",38,"د",1,0],["يا رفيقي ونحن أخلاف عمرو","أين من والدٍ مكان وليد",38,"د",1,0],["يا رفيقي ونحن في القيد سيّا","ن كفانا رضا بنار القيود",38,"د",1,0],["يا رفاقاً بأزال سكنوا","هل أراكم بعد هذا وأراها",39,"ا",3,0],["يا رفاقاً حلواً بأكناف صنعا","ليت شعري بعد التباعد رَجْعَى",40,"ع",2,1],["يا رفيقي وصاحبي وخليلي","قفْ بنا بين دارساتِ الطلول",41,"ل",1,0],["يا رفعةً بقيت لي في رفعةٍ","من دونها انحطَّ السّماك الرَّامح",42,"ح",1,0],["يا رفيع العماد يا ابن عليٍّ","يا ابن عالي الذّرا عليّ المقام",43,"م",1,0],["يا رفيقيّ وهل من مُسْعدٍ","لعليل يشتكي طرفاً عليلا",44,"ل",2,0],["يا رفيقي وأين عهدك بالجزَع","سقاه الغمام صوب عهاد",45,"د",1,0],["يا رَفيقي وأَنتَ خيرُ رَفيقٍ","متْ بحُبِّي واطْرَحْ به من لامَا",46,"م",2,0],["يا رِفاقي ولوعَةُ الحُبِّ نارٌ","عَلِّلوني برِفْقَتي يا رِفاقي",47,"ق",2,0],["يا رِفاقي بحُبِّهِ عَلِّلوني","عَلِّلوني بِحُبِّهِ يا رفاقي",48,"ق",2,0],["يا رِفَاقي انظروا لشحَالِ مُعَنّىً","قَد جرى طَرفُه بِدمَعٍ هَتونِ",49,"ن",1,0],["يا رفيقي والهَوَى مَلمَلَةٌ","يَطرحُ المَلسُوعَ مِن فَوقِ الرّحالِ",50,"ل",1,0],["يا رفيقي مذ كنت طفلاً إلى أن","جلل الشيب مفرقي بالثغام",51,"م",1,0],["يا رفاقي قفُوا بنا","نَقْضِ حقّاً لمعهدِ",52,"د",1,0],["يا رَفِيقِي خَلِّنِي أَرعَى الأَسى","وَأَعِد ذِكرَهُ لَو بِمَلامِ",53,"م",1,0],["يا رِفاقي يا رِفاقي","إنّ قَلبي في وثاقِ",54,"ق",1,0],["يا رفيقي رفقاً علي فما ين","فع ذا الوجد مثل رفق الرفيق",55,"ق",1,0],["يا رفيع القدر يا من شانه","شاع في كل البوادي والحضر",56,"ر",1,0],["يا رفاقي ويا أحبّة عمري","شيّدوا القبر في ظلال الغصون",57,"ن",1,0],["يا رفيقاً كانَ بالناسِ رفيق","وصديقاً كانَ بالقولِ صديق",58,"ق",1,0],["يارفيقى ناشدتك الله قف بى","ننتشق طيب نشره يارفيقى",59,"ق",2,0],["يارفيقى وارفق فديت بقلب","قد أذابته اعين نباله",60,"ل",2,0],["يا رِفقُ رِفقاً رُبَّ فَحلٍ غَرَّةُ","ذا المَشرَبُ الأَهنى وَهَذا المَطعَمُ",61,"م",1,0],["يا رَفيع الذرى وقد كنت طودا","ضعتي ان ترى كثيبا مهيلا",62,"ل",2,0],["يا رفيقيَّ بسلعٍ","ما الهوى إلا عذابي",63,"ب",2,0],["يا رِفاقي عَلى منين وَأَنتُم","سَلوة النَفس وَالمُنى يا رِفاقي",64,"ق",2,1],["يا رفيع الذر أو سامي الأراكي","وعليّ المنار في عليائك",65,"ك",1,0],["يا رفيقيّ الطِّلاءَ ففي","ليلِ منْ نادمتُما طولُ",66,"ل",1,0],["يا رفيق الصبا وخدن التّصابي","أنت علمتني هوى الأحباب",67,"ب",1,1],["يا رفيع الذرى يا ملجأ الفقرا","وأنت عين الورى يا صاحب العين",68,"ن",1,0],["يا رفاق الحرب هيا","نحتسي أكواب راح",69,"ح",1,0],["يا رفيقي بنواحي زامةٍ","وليليها صياماً وقياما",70,"م",2,0],["يا رفيق الثقيل لا تتنصَّلْ","منه بادٍ عليك منه دليلُ",71,"ل",1,1],["يا رفقة العمر مهلا لم يعد لأسى","معنى ولا لسرور في الدنى سبب",72,"ب",1,0],["يا رفيع الجناب حاشاك ترضى","منع سؤلي وأنت كل مرادي",73,"ي",1,0],["يا رفيقي يا شريكي في المآسي","قم تأمل ما أعاني وأقاسي",74,"ي",1,1],["يا رفعة الإسلام حين وضع","ليلة ضوء وجهه المضي",75,"ي",1,0],["يا رفيف الروض يا همس الربا","يا دنى الأحلام يا سحر رؤاها",76,"ا",3,0],["يَا رِفَاعِي بِاللهِ رَبِّكَ رَفعاً","لِعُبَيدٍ فِي رَوضِ فَضلِكَ جَالا",77,"ل",2,0],["يا رفاقي من مجيري","من ذنوبي والعقاب",78,"ب",1,0],["يا رفيقاتٍ يا خيار الرفاق","إن تكونوا حييتم هكطورا",79,"ر",2,0],["يا رفاتَ الأُسودِ","فلتنثني عندكَ الرُكَب",80,"ب",1,0],["يا رفيع الجناب نفحة قرب","تقلب القلب عن شقا لشفاء",81,"ا",2,0],["يا رفيعا عن امتداحي له هي","هات مني ما ليس بالإمكان",82,"ن",1,0],["يا رفيقي بنواحي رامةٍ","عن لي بالأبرق الفرد وراما",83,"م",2,0],["يا رفيقيَّ ارفقا بي فالهوى","عُنْفُهُ يكفي المحِبَّ المُستهاما",84,"م",2,0],["يا رَفيقاً مِن فطنه وَوَميضاً","مِن ذَكاء وَلَمحة مِن زَكانه",85,"ن",2,0],["يا رَفيقي صُن ما اِستَطَعت هَوى بَرَحا","وَغالط ما اِستَطَعت فيهِ وَداره",86,"ر",2,0],["يا رِفاقي أَما بِكُم مِن رَفيقِ","يَحمِلُ الصَبَّ وَهو صَبّ طَريحُ",87,"ح",1,0],["يا رِفْقَةً في حِمَى البَلْقاءِ قَدْ ضَرَبَتْ","طُنْبَ الاقامَةِ في اوْداءِ عَمانِ",88,"ن",1,0],["يا رفاقي أين أنتم؟","يا حبيبي هل تجيب؟",89,"ب",1,0],["يا رفيعاً رفعتَ بالشعرِ معنىً","سوف يبقى لمن سيأتي مثالا",90,"ل",2,0],["يا رفيعَ الصفات والفكر طابتْ","كلما صاغتِ اليمين مقالا",90,"ل",2,0],["يا رفاقي ليس يشفى في الهوى","ألف راق داء ملسوع الفراق",91,"ق",1,0],["يَا رِفَاقَ الشِّعْرِ قُولُوا","أَ حَرَامٌ أمْ مُبَاحْ",92,"ح",1,0],["يَا رَفِيْفَاً أَشْجَارُهُ فيْ عُرُوْقِيْ","وَوَرِيْفَاً أَنًْدَاْؤُهُ فِيْ رَوَاْءِ",93,"ا",1,0],["يا رفيقي قمْ لنطمحْ","في بحارِ الفكرِ نسبحْ",94,"ح",1,1],["يا رفيقي لا تسلني","كيف أهوى لستُ أمزحْ",94,"ح",1,0],["يا رفيقي لا تُسيءْ فهمي","فما للشعرِ مطمحْ",94,"ح",1,0],["يا رفيقي قمْ لنبني نهضةً","بدَّدتْ فينا ملاذَ الطائفيّهْ",95,"ي",2,0],["يا رفيع المقام يا ابن سليما","ن لك الافتخار جهراً وركزا",96,"ز",2,0],["يا رفاقي أين عهدي؟","ها أنا جئت أغني",97,"ن",2,0],["يا رفيج الخير قل لي يا رفيج","كن معايه دايمٍ صافي صدوق",98,"ق",1,0],["يَارفَاق الدّمارِ هلْ منْ جديْد ٍ","ما اعتَلَى غير قُبْحكُمْ أو تَعَمرْ",99,"ر",1,0],["يا رفيفَ القلب بالوجدِ اتَّئِدْ","إنَّني منكَ بحظّي أكتفي",100,"ف",2,0],["يَا رفيقَ الزُّهدِ مَهلاً","شَطْرُ قلبي فِيكَ تاه",101,"ا",2,0],["يارفاقي بشرعة الله نعلو","إنْ أنبنا فكل حرٍّ عليّ",102,"ي",1,0],["يارفاقي اما لنا من شهود","انكر الفعل قد بدا م