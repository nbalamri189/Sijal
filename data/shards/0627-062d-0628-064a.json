.poetsgate.com/ViewPoem.aspx?id=183623",""],[4908,"سَمَرٌ شِتائيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=207420",""],[4955,"مشتاق إني مشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=204027",""],[5147,"أضر بجسمي عرق النسا","https://www.poetsgate.com/ViewPoem.aspx?id=166690",""],[5150,"ما كل ما يعلم يقال ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=202901",""],[5271,"قد خاب ظني","https://www.poetsgate.com/ViewPoem.aspx?id=65380",""],[5273,"إليك وردتي","https://www.poetsgate.com/ViewPoem.aspx?id=162127",""],[5277,"غروز","https://www.poetsgate.com/ViewPoem.aspx?id=185109",""],[5277,"وجدُ بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=187579",""],[5277,"أنتِ..يا أجملَ الأزهار","https://www.poetsgate.com/ViewPoem.aspx?id=187783",""],[5277,"بين شروقها وغروبي","https://www.poetsgate.com/ViewPoem.aspx?id=191011",""],[5365,"خدُّها","https://www.poetsgate.com/ViewPoem.aspx?id=190406",""],[5365,"إلى راحلة لمّا تعُد","https://www.poetsgate.com/ViewPoem.aspx?id=191263",""],[5452,"ضفاف الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=110945",""],[5528,"من مثل أحمد..؟ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200986",""],[5533,"أَحَبِيبةَ قَلْبي المَجْروحِ","https://www.poetsgate.com/ViewPoem.aspx?id=177032",""],[5587,"بخفق فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=196773",""],[5595,"يَا قلبُ صَبْرَاً","https://www.poetsgate.com/ViewPoem.aspx?id=177967",""],[5609,"جازان","https://www.poetsgate.com/ViewPoem.aspx?id=214101",""],[5674,"الليل يعزف للنهار حنينه","https://www.poetsgate.com/ViewPoem.aspx?id=185196",""],[5704,"كَمْ طَالَ لَيْلي","https://www.poetsgate.com/ViewPoem.aspx?id=191157",""],[5725,"أبابيل الهيام","https://www.poetsgate.com/ViewPoem.aspx?id=211444",""],[5939,"أنا فيها","https://www.poetsgate.com/ViewPoem.aspx?id=156540",""],[5939,"رسالة إلى أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=178589",""],[5939,"أحلى مُنجزاتِك","https://www.poetsgate.com/ViewPoem.aspx?id=185498",""],[5956,"الضحيَّةُ والمنقذ","https://www.poetsgate.com/ViewPoem.aspx?id=194198",""],[6106,"تحية للمستشارة : د . نهى الصادق الزيني","https://www.poetsgate.com/ViewPoem.aspx?id=6309",""],[6181,"مسافر ومسافرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87686&r=&rc=1",""],[5355,"إلى غائبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87211&r=&rc=36",""],[6290,"عَدِيمُ الجَمَالِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85511&r=&rc=29",""]],"verses":[["أحبيتُ منك بحيلتي","لك مستَغلَّاً كان قبرا",0,"ر",2,0],["أَحَبيبُ مالَكَ لا تَرُدُّ جَوابَنا","اَنَسيتَ بَعدي خِلَّةَ الأَحبابِ",1,"ب",1,0],["أَحُبّى فيمَ خُلّيتُ","وَفيمَ الحَبلُ مَبتوتُ",2,"ت",1,1],["أَحُبّى لَو دَنَت مِن قَل","بِكِ الرَحمَةُ أُدنيتُ",2,"ت",1,0],["أَحُبّى لَيسَ لي صَبرٌ","وَإِن رَخَّصتِ لي جيتُ",2,"ت",1,0],["أحبيبَ هذا النشءِ","تسقيهِ على ظمَإٍ دماك",3,"ك",1,0],["أحِبِّي كلَّ حيّ؛ لا تخصِّي","بحبِّكِ كلَّ ذي وجه وَسيِم",4,"م",1,0],["أَحِبِّي عَلَيَّ الْحُسْنُ عَلاَّكَ يَا قَمَرْ","فَمَنْ ذَا الذِي أَفْتَاكَ أَنَّ دَمِي هَدَرْ",5,"ر",1,1],["أَحِبِّي يَا شَمْسَ الْمَحَاسِنِ وَالصَّفَا","تَرَفَّقْ بِمَنْ أَمْسَى بِحُبِّكَ مُدْنِفَا",6,"ف",2,1],["أحبيبتي قد فاضَ حسنُكِ والهوى","فمتى أكونُ بمائه ريّانا",7,"ن",2,0],["أحب يا ابن العَواتك صوت عبد","أَسير الذَنب فيه لك الوَلاء",8,"ا",2,0],["أحبيبٌ قدْ غدا في انشغالِ","أم زَنيمٌ في جفاهُ يُغالي",9,"ل",2,0],["أحبيباً نأيته فبكاكا","فهو العارض الذي استباكا",10,"ك",2,0],["أحبيبتي هل بعد بعدك نظرة","ليس الفراق اراه امرا هينا",11,"ا",1,0],["أحبيبَ قلبٍ تنظرُ","فدموعُ عينكَ تُمطِرُ",12,"ر",1,1],["احبيب قَلبي قد قطعت نياطه","ووصلت دَمعي بالثرى المطلول",13,"ل",1,0],["أحبيب اخصب من نداك العام","هيهات تخلق مثلك الايام",14,"م",1,1],["أحبى الشريعة في الآفاق فانبعثت","روح الكمال به في ذلك الجسد",15,"د",1,0],["أحبيب قلبي هل ترى لك مادحاً","غيري وهل أنا مادحٌ لسواكا",16,"ك",2,1],["أحبيب أنت إلى الحسين حبيب","إن لم ينط نسب فأنت نسيب",17,"ب",1,1],["أحبيب سهران والصب مغفٍ","أكذا عندكم هوى الأقمار",18,"ر",1,0],["أحبيّ لي الخيرَ أو أبغضي","كلانا بصاحبه ينتظر",19,"ر",1,0],["أحبيبتي قد طال عهد نواك","فأذاب بينك جسم من يهواك",20,"ك",1,1],["أَحِبْ يا دَيرَ مِزْمارِ","غَرِيْباً نازِحَ الدَّارِ",21,"ر",1,1],["أَحَبيبَتي كَيفَ الرِضا بتشتت","قَد ضَرَّ بِالاِخوان وَالاولاد",22,"د",1,0],["أَحُبِيتَ وحدكَ بالجمالِ المطلقِ","أم قيلَ إذ قُسِمَ الجمالُ لكَ انتَقِ",23,"ق",1,1],["أحبيبة ذهبت وأبقت خافقي","يشكو إلى درب البعاد سنيني",24,"ن",2,0],["أحبيبة ٌ ويداك تكسر قاربي","أصديقةٌ والكأس فاض سموما؟؟",25,"م",2,0],["أحبيبتي ما للهوى","بين القلوب وقلبي",26,"ب",2,0],["أَحَبيبَتِي سَقَطَ الرِّهَانُ, ولَاحَ لِي","شَفَقٌ بخَدِّكِ شَاقَنِي وشَجَانِي",27,"ن",2,0],["أحبيبتي أفشي السلامَ لحُبِّنا","فالشمس يجذبها النهارُ لِتَشْرِقُ",28,"ق",1,0],["أحبيبَ اللهِ أيا بدرًا","كم ذابَ بحبِّكَ خفَّاقُ",29,"ق",1,0],["أحب يراعي عن منطق","ولم يلوني عنه لاح لحا",30,"ا",1,0],["أحبيبتي هذي الحياُة مسيرةٌ","ولحكمةٍ.. رسمَ الإلهُ مسيرَها",31,"ر",3,0],["أحبيبتي لا تحسبيني أنني","آثرتُ عن طولِ الحياةِ قصورَها",31,"ر",3,0],["أَحَبيبَتي ياأَنتِ قولي","أَمْ ابنَةٌ لي بالتَبَنّي ؟!!",32,"ن",2,0],["أَ حبيبتي شَوقي يُصاغُ قصائداً","أرمي بِهِنَّ على حُدودِ شَذاكِ",33,"ك",1,0],["أحبيبَ عمرِ القمحِ إنّ سنابلي","نهبتْ بيادرَها يدُ السيّابِ",34,"ب",1,0],["أحبيبتي..يا بنتَ ضلعي في الورى","إياكِ من ظلمٍ يسوسُ تجبّرا",35,"ر",2,1],["أحبيبتي مازلتِ سرََّ محبتي","كمواجعي في غربتي..أو لوعتي",36,"ت",2,1],["أحبيبتي..ما قدْ عرفتُ من الهوى","إلا بشائرَ تدّعي ما لا يُرى",37,"ر",2,0],["أَحَبيبَتي لا تُبعديهِ فإنّهُ","خَفَقَاتُ قلبي إنّهُ ما أقصده",38,"د",2,1],["أحبيبتي هل من غروبٍ ينجلي","أَوَلَيسَ بعدَ الّليل ِ فجرُُ يطلعُ",39,"ع",1,0],["أحبيبتي السمراء لا تتمنعي","عني فإني أرقب الأياما",40,"م",2,0],["أحَبيبَ منْ سَمكَ السَّماءَ ومدَّها","سبعًا طِباقًا والمَعايشَ صَرّفا",41,"ف",2,0],["أَحَبِيبةَ قَلْبي المَجْروحِ","يا مَرْتعَ حُبِّي المَذْبُوحِ",42,"ح",1,1],["أحُبيَ كُنْتُ نديمَ هَوَاكَ","نَدِيمَ غَرامٍ ' صَدِيقاً وَرَحْمَا",43,"م",2,0],["أحَبيبُ مَا لِي غَيْرُ حُبّكَ مَطْمَعَاً ؟","وَمُنَايَ فيكَ مَرَاكِبٌ ومَرَاسي",44,"س",2,0],["أحبيبتي هذي حروف قصيدتي","أهديكها فخذي القصيدة هاك",45,"ك",1,0],["أحبيب لاترحل وروحك ثائره","خفقاتها بالصدر تبقى هادره",46,"ر",2,1],["أَحَبيبَ قلبي عطفةً وترحُّمًا","إنِّي لعشْقِكَ لا أزولُ وأُفْطَمُ",47,"م",1,0],["أحبيبتي ما كان أقرب عهدنا","حتى تأذن للعواذل مفجعهْ",48,"ع",2,0],["أحبِّي الحياةَ لأنّني فيها","قِفِيها، ضَعِي الأزهارَ في فِيها",49,"ي",3,1],["أحبيني كما أهواكِ دومًا","كأنثَى تَنشُدُ العِشقَ الحلالا",50,"ل",2,0],["أحبيني فهذا كلُّ عَرضي","وضمّيني لأنهلَ مِن فُراتِكْ",51,"ك",1,0],["أحب يزورني العظماءُ طوعاً","ولستُ بفارضٍ لُطْفي كثيرا",52,"ر",2,0],["أ حبيبنا الجلاد زنت صدورنا","وجلدت للمتآمرين ظهورا",53,"ر",2,0],["أحبيبتي هل في غدي يوم","ألاقيك به أم هل تكون نهايتي",54,"ت",2,0],["أحبيبتي أين الحنين لما مضى","روحي على فقدانكم منهارَهْ",55,"ر",2,1],["أَحِبِّينِي بِأثوابِي وخَلْقِي","فَليْسَ لِخَلْقِ رَبِّي أنْ يُحَالَا",56,"ل",2,0]]}