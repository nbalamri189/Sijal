{"poems":[[55,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[53,"وإذا اشتهيت خرا فمثل نتنه","https://www.aldiwan.net/poem8713.html","الكامل"],[53,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[53,"أسألت رسم الدارِ أم لم تسأل","https://www.aldiwan.net/poem65978.html","الكامل"],[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[87,"تقريظ أعيان الكتب","https://www.aldiwan.net/poem7120.html","مجزوء الكامل"],[87,"يتنازع الأرباب فيك نفاسة","https://www.aldiwan.net/poem7252.html","الكامل"],[45,"أتراها لكثرة العشاق","https://www.aldiwan.net/poem9745.html","الخفيف"],[45,"لهوى النفوس سريرة لا تعلم","https://www.aldiwan.net/poem10567.html","الكامل"],[47,"يا عارضا متلفعا ببروده","https://www.aldiwan.net/poem63492.html","الخفيف"],[47,"خير نيليك إن أنلت الجزيل","https://www.aldiwan.net/poem65611.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55301","الخفيف"],[111,"ساحر الطرف","https://www.poetsgate.com/ViewPoem.aspx?id=613",""],[113,"وفد الصباح وزالت الأحلاك","https://www.aldiwan.net/poem16210.html","الكامل"],[133,"يا أخي يا اخي المصاعب شتى","https://www.aldiwan.net/poem67454.html","الخفيف"],[189,"ماذا يقول المادحو","https://www.aldiwan.net/poem14113.html","مجزوء الكامل"],[264,"موقع النجم في الحمى الشرقي","https://www.aldiwan.net/poem35936.html","الخفيف"],[333,"نذر العمر للغرام صبيا","https://www.aldiwan.net/poem55029.html","الخفيف"],[369,"يا أيها المولى الذي","https://www.aldiwan.net/poem60663.html","مجزوء الكامل"],[369,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[376,"أبقى الرسيم من الركاب رسوما","https://www.aldiwan.net/poem57136.html","الكامل"],[408,"حتام أكتم ما الدموع تبيح","https://www.aldiwan.net/poem46754.html","الكامل"],[438,"در علم يلوح في فلك الفضل","https://www.aldiwan.net/poem12460.html","الخفيف"],[563,"اطلب العلم كالذباب إذا ما","https://www.aldiwan.net/poem34227.html","الخفيف"],[567,"قل للوزير إذا وقفت ببابه","https://www.aldiwan.net/poem52800.html","الكامل"],[567,"إن كان يلبس ما أفاد تجملا","https://www.aldiwan.net/poem52963.html","الكامل"],[580,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[580,"شكري لمن أحببته وهويته","https://www.aldiwan.net/poem2916.html","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122310","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63998","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62682","الكامل"],[1264,"","https://poetry.dctabudhabi.ae/diwan/poem/105519","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109182","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127944","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128086","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124731","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118325","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118297","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137093",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137409",""],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58346","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200988","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134016","الكامل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126280","الكامل"],[3271,"","https://poetry.dctabudhabi.ae/diwan/poem/142252","الرمل"],[3290,"","https://poetry.dctabudhabi.ae/diwan/poem/100709","المتدارك"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74043","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126914","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109978","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91504","الرمل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128932","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125823","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73294","الخفيف"],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130288","الكامل"],[4767,"عودة الخير","https://www.poetsgate.com/ViewPoem.aspx?id=88790",""],[5419,"للحبّ غنى الكون","https://www.poetsgate.com/ViewPoem.aspx?id=51997",""],[5459,"دنان الغش","https://www.poetsgate.com/ViewPoem.aspx?id=205796",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5612,"{ صَنْصَفْطُ } سَيِّدَةُ القُرَى","https://www.poetsgate.com/ViewPoem.aspx?id=183746",""],[5616,"غفوة","https://www.poetsgate.com/ViewPoem.aspx?id=207671",""],[5190,"الببغاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78301&r=&rc=14",""]],"verses":[["وَإِذا أَشارَ إِلى قَبائِلِهِ","حَشَدَت إِلَيهِ بِأَوجُهٍ غُرِّ",0,"ر",1,0],["وإذا اشتهيت خَرَا فَمَثِّل نتنَهُ","فعيوبُه تُسليك عن حسناتِهِ",1,"ه",1,1],["وإذا أشارَ أو ارْتأَى في خُطَّةٍ","أبصرتَ حِكْمَةَ صاحِبِ الأَلواحِ",2,"ح",1,0],["وإذا أشاءُ غدوْتُ غيرَ مُنهنهٍ","فأروح مقْتَنِصَ الغزالِ المُطْفلِ",3,"ل",1,0],["وإذا اشنقت القذيفة في أر","ض تصيب المجاورين شظايا",4,"ي",2,0],["وإذا أشار بمدحة","شاد المكارم والحسب",5,"ب",1,0],["وإذا أشاء وضعته وجعلته","كفريد وجدى كاتبا أفاكا",6,"ك",2,0],["وَإِذا أَشفَقَ الفَوارِسُ مِن وَق","عِ القَنا أَشفَقوا مِنَ الإِشفاقِ",7,"ق",1,0],["وَإِذا أَشارَ مُحَدِّثاً فَكَأَنَّهُ","قِردٌ يُقَهقِهُ أَو عَجوزٌ تَلطِمُ",8,"م",1,0],["وَإِذا أَشارَ إِلى الأَعاجِمِ أَعرَبَت","عَن طارِفِ الحَسَبِ الكَريمِ تَليدِهِ",9,"د",2,0],["وَإِذا أَشكَلَ الصَوابُ عَلى ظَنِّ","كَ فَاُنظُر ماذا يَرى إِسماعيلُ",10,"ل",1,0],["وَإِذَا أَشْجَتِ المَسَامِعَ مَيٌّ","بِكَلامٍ فَهَلْ لِمِثْلِي كَلامُ",11,"م",1,0],["واذا أشكو له قرح الهوى","قال لي \"صل على خير البشر",12,"ر",1,0],["وَإِذا أَشارَ مُخاطِباً فَكَلامُهُ","دُرَرٌ لَها أَفهامنا أَسلاكُ",13,"ك",1,0],["واذا اشتدَّت الذئابُ عُواءً","فنُقابِل عُواءَها بالنَشائد",14,"د",1,0],["وإذا أَشرتَ بعَزْمةٍ","ضاقتْ على الدهرِ المذَاهب",15,"ب",1,0],["وإذا أشهدتك لمعة رقّ ال","قرب منها تكون خير سَرِيّ",16,"ي",1,0],["وإذا أشرق الصباح ولم يلق سن","اهُ ظنّ الصباح عشيّا",17,"ي",2,0],["وَإِذا اِشتَرى بِالمالِ حُس","نَ الذِكرِ لَم يَرَهُ غَرامَه",18,"م",2,0],["وإذا أشارَ بعَقْدِ مَوْعدِ مَجْلسٍ","شَوْقاً إليه تُعاوِدُ الأشباحا",19,"ح",2,0],["وإذا اشتِياقُكَ جارَ جرت فقدتَها","مَظلُومَةً أو يُنصِفَ المَظلُوما",20,"م",2,0],["وإذا أشار النّاسُ نحوَ مُسوّدٍ","فهو المشارُ إليه والملْموحُ",21,"ح",1,0],["وإذا أشكل السؤالُ انتَحَتْهُ","لحظةٌ منه بيّنَتْ إشكالَهْ",22,"ل",2,0],["وإذا أشكلت عليك أمور","سل خبيراً ولا تقف في السؤال",23,"ل",1,0],["وإذا اشتكتْ دُنياهُ حادِثَ عِلَّةٍ","فيمينُهُ البِيضاءُ ضامنةُ الشِّفَا",24,"ف",2,0],["وإذا أشارَ إلى الكَتيبةِ أَجفَلتْ","فكأنَّ من سُمرِ الذَوابلِ أُنْمُلا",25,"ل",2,0],["وإِذا اشتكى فقراً أَسا","لَ الدمعَ من عينيْه نَهْرا",26,"ر",2,0],["وإِذا اشْتكَى العُشَّاقُ سكْب دمُوعِهِم","أَصبحتُ أَشْكُرُ مِنْهُ جَيْشَ الأَدْمُع",27,"ع",1,0],["وإذا اشتهت رجعت عليك","فعاد ذاك الحسن حزنا",28,"ن",2,0],["وإذا اشتكى ضيقَ المسالكِ في الوغى","شاكٍ فأضيقُها لديه الأوسع",29,"ع",1,0],["وإذا اشتكى قلب المحب حرارةً","مسح اللمى منه حرارته فبَشّ",30,"ش",1,0],["وإذا اشتكت عنف المسير","تجاب بالضرب العنيف",31,"ف",1,0],["وإذا اشتقت للصبا","وغدا الرأس اشيبا",32,"ب",2,0],["واذا أشاع أشاعت العذال قو","لا منكر أو يضره اعلانه",33,"ن",2,0],["واذا اشرأب الى تناول غاية","بلغ المرام بسعيه المجهود",34,"د",1,0],["وإذا اشترى عبدٌ بنيه","بصحةٍ لا باختداع",35,"ع",1,0],["واذا اشتكى لفح السموم اخ صدى","اجروا من السلسال بحرا مزبدا",36,"د",2,0],["واذا اشار اليهم بمعلب","متضمخ بالرين والاصداء",37,"ا",2,0],["وَإذَا اشتَكَيتُم فَاجعَلُوا الشَّكوَى إلَى ال","وَحيَينِ لاَ القَاضِي وَلاَ السُّلطَانِ",38,"ن",1,0],["واذا اشتكت جدب السنين ومحلها","كانت مواهب راحتيك قطارها",39,"ر",3,0],["وإذا اشتكت نفس المكارم والعلا","سقما بأنت طبيبها ودواؤها",40,"ا",3,0],["وإذا أشارَ إلى الغُلامِ بِطَرفِهِ","أعطِ الحكيمَ فذلكَ الإنعامُ",41,"م",1,0],["وإذا اشترى غيري الصديقَ بنفسه","فأنا بنفسي أشتري الأعداء",42,"ا",2,0],["وإذا اشارت للصفوف بركعة","سجدت لها اعناقهم بالجمجم",43,"م",1,0],["واذا اشتكى عضو بجسمك قلت ها","توالى الطبيب لكى تعالج داكا",44,"ك",2,0],["واذا أشجاك همس من صداه لاتلمنى","ما أنا الا كظل لشعورى فاعف عنى",45,"ن",2,0],["وَإِذا اشتاقَت نَفسٌ وَجَدَت","ألَماً بالشَّوقِ المُعتَلِجِ",46,"ج",1,0],["وَإِذا أَشارَ إِلى القَوا","في أَقبلت طوع الطلب",47,"ب",1,0],["واذا أشكلت عويصة علم","كان بالحل مرجع الفقهاء",48,"ا",2,0],["وإذا اشترعتَ بناءَ سُورِ فضيلةٍ","فاجعَل رُسوخَ الإِتضاعِ بأُسِّهِ",49,"س",2,0],["وَإِذا أَشكو النَوى أَو أَرتجي","عَودَتي يَوماً لتلك الأَربُع",50,"ع",1,0],["واذا اشتقت أن تريني وترتاحي","لرؤياي في الدياجي فنامي",51,"م",2,0],["وإذا اشتقت غير ضرب وطعن","فالبس الخنث واخلع التذكيرا",52,"ر",2,0],["وإذا أشرقت الشمسُ به","فارتَجَى جَلَّلَهُ الرزءُ فخابا",53,"ب",2,0],["وإِذا اشتَقتُكُم فَأَنتُم منَ القَل","بِ نُزولٌ فيهِ مكانَ اشتياقِ",54,"ق",1,0],["وإذا اشتكى سغبا إلي","جعلت هام الصيد رزقه",55,"ق",2,0],["وإذا أشيد بمحفل عمل","لله كانت رأس ما ذكرا",56,"ر",2,0],["وإذا اشتكى تبكي حنايا قلبها","فتصب دمع القلب في خد السهرْ",57,"ر",1,0],["وإذا اشتكى لحِقَتْه منهم تهمةٌ","أو طعنةٌ .. وتجشّم الأوجاعا",58,"ع",2,0],["وإذا أشرق الدلال بخدي","ه هلالاً أغمّه إغماما",59,"م",2,0],["وإذا اشْتَكى ألَمَاً تُداويهِ الرُّقَى","والقلْبُ يحْنو والعيونُ تُطَبْطِبُ",60,"ب",1,0],["وإذا. أشرقت. عيون القوافي","فاطمئي. ستصدق. . الاحلام",61,"م",1,0],["وإذا أشرتُ مُهدداً بأصابعي","مدَّ الجناحَ وأرسلَ التهديدا",62,"د",2,0]]}