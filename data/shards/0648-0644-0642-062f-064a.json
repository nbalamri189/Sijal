//www.aldiwan.net/poem53983.html","الكامل"],[413,"لو كنت حاضر طرفه وفؤاده","https://www.aldiwan.net/poem54051.html","الكامل"],[429,"أعلمت أن من الصدود خدورا","https://www.aldiwan.net/poem12313.html","الكامل"],[429,"نمت بسر غرامه الأجفان","https://www.aldiwan.net/poem12412.html","الكامل"],[429,"مولاي عبدك يشتكي","https://www.aldiwan.net/poem12546.html","مجزوء الكامل"],[429,"شق الكمال عليه جيب سواده","https://www.aldiwan.net/poem12595.html","الكامل"],[429,"أتروم خلا في الوداد صدوقا","https://www.aldiwan.net/poem12679.html","الكامل"],[429,"أسف موثق ودمع طليق","https://www.aldiwan.net/poem12681.html","الخفيف"],[436,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[441,"لله في ذا الخلق أح","https://www.aldiwan.net/poem56058.html","عموديه"],[456,"اليوم أنجز ماطل الآمال","https://www.aldiwan.net/poem56072.html","الكامل"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[456,"الآن إذ برد السلو ظمائي","https://www.aldiwan.net/poem56313.html","الكامل"],[462,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[513,"لو كان ينفع أن تجود بمائها","https://www.aldiwan.net/poem11998.html","الكامل"],[536,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[560,"القلب بين الصحب أعدل شاهد","https://www.aldiwan.net/poem52952.html","البسيط"],[567,"سلب الشباب رداءه","https://www.aldiwan.net/poem52022.html","مجزوء الكامل"]],"verses":[["وَلَقَد يَطولُ عَليكَ أَن أُصغي إِلى","ذِكراكَ أَو يُثني عَليكَ لِساني",0,"ي",1,0],["وَلَقَد يَكونُ وَما لَهُ مِن عاذِلٍ","فَاليَومَ عادَ وَما لَهُ مِن عاذِرِ",1,"ر",1,0],["ولقَدْ يَهونُ على العَشيرَةِ أنّني","أشْكو الغَرامَ فيَرقُدونَ وأسْهَرُ",2,"ر",1,0],["وَلَقَد يُحاوِلُ أَن يَقو","مَ وَقَد مَضَت فيهِ النَواهِل",3,"ل",1,0],["وَلَقَد يُنجيكَ إِغفا","لٌ وَيُرديكَ احتِراسُ",4,"س",1,0],["وَلَقَدْ يُسَاهِرْنَ النًُّجُومَ لَوَاسُجاً","دِفْئاً لِمَقْرُورِ الشَّوَى عُرْيَانِ",5,"ن",1,0],["وَلَقَدْ يَزُفُّ إِلَى المُلُوكِ قَلائِداً","فَتَغَارُ مِنْ إِشْرَاقِهَا التِّيجَانُ",6,"ن",1,0],["وَلَقَد يَقُولُ لِيَ الطَبِيبُ وَما","نَبَّأتُهُ مِن شَأنِنَا حَرفَا",7,"ف",2,0],["ولقد يَبلغ العجول مَداه","بالتأني بلوغ خَضم بقَضم",8,"م",1,0],["وَلَقَد يَرَينَكَ وَالقَناةُ قَويمَةٌ","وَالدَهرُ يَصرِفُ لِلفَتى أَطوارا",9,"ر",2,0],["وَلَقَد يَعلَمُ صَحبي كُلُّهُم","بِعَدانِ السَيفِ صَبري وَنَقَل",10,"ل",1,0],["وَلَقَد يَعلَمُ مَن حارَبَنا","أَنَّنا نَنفَعُ قِدماً وَنَضُرّ",11,"ر",1,0],["ولقد يجدد فيك جرح حشاشتي","طيرٌ على البان المرنَّح صادح",12,"ح",1,0],["ولقد يصبرني على ما ألتقي","حال وها أنا كالقتيل مصبر",13,"ر",1,0],["ولقد يذكرني حنين سواجعٍ","بالقلب كم هاجت على غصن معي",14,"ع",2,0],["ولقد يَقْلبُ الكريمُ من السا","دات نَعماءَ عبدِه بأساءَ",15,"ا",2,0],["ولقد يسلمُ الخسيسُ كما يس","لمُ فوقَ الأسنة اليعسوبُ",16,"ب",1,0],["ولَقَدْ يُوعِدُونَ ثم يَذُوبُو","نَ سَماحاً إلى أوان الجمودِ",17,"د",1,0],["ولقد ينال من القويِّ ضعيفُهُ","ككُليبٍ الطاغي وكالجسّاس",18,"س",1,0],["ولقد يعود السيف مِقدحةً","ويُبدَّلُ الغصنُ الرطيبُ عصا",19,"ص",2,0],["ولقد يرى أوسٌ ويونس من","جناتها صعباً ممنعه",20,"ع",2,0],["ولقد يروقك بارتجاج نبيله","قمر النساء وباهتزاز قضيفِهِ",21,"ف",2,0],["ولقد يُلهِينيَ الطَّي","ر بترجيع الهديلِ",22,"ل",1,0],["ولقد يُعزّينا عليه أنَّهُ","وافى كمالَ العُمرِ منهُ كمالُ",23,"ل",1,0],["ولقد يُؤلفُنا اللقاءُ بليلةٍ","جُعلت لنا حتّى الصباحِ نظاما",24,"م",2,1],["ولقد يظنُّ بي الغُيورُ ظنونه","فيحُوز جُلَّ ظنونه آثاما",25,"م",2,1],["وَلَقَد يَكُنَّ إِلَيَّ صوراً مُرَّةً","أَيّامَ لَونُ غَدائِري يَحمومُ",26,"م",1,0],["وَلَقَد يَكونُ لِيَ السُلُوُّ عَنِ الهَوى","لَكِنَّما خُلِقَ المُحِبُّ وَدودا",27,"د",2,0],["ولقد يكون من الشباب معارض","ولقد يكون من الشيوخ معاضد",28,"د",1,0],["ولقد يدنو البعض منك فلا تد","ري أهذا مسالم أم معاد",29,"د",1,0],["ولقد يهلك الذي يتوقى","ولقد لا يعيش اهل الحياد",30,"د",1,0],["ولقد يكون الفوز حلفا للألى","غمدوا السيوف وجردوا الاقلاما",31,"م",2,0],["ولقد يردك عن غرورك مشهد","يبكي العيون ويحرق الاكبادا",32,"د",2,0],["ولقد يريك من الخيال حقيقة","اوحى اليه بها النبوغ وجادا",32,"د",2,0],["ولقد يطير بمن له هو شاهد","فكأنما هو راكب منطادا",32,"د",2,0],["ولقد يملأ القلوب سرورا","كبيوت يغرقن في الانوار",33,"ر",1,0],["ولقد يقود إلى صلاح امة","فرد باخلاق زكت متخلق",34,"ق",1,0],["ولقد يرسل اللحاظ فلا يبصر","في مطلع الرجاء بريقا",35,"ق",2,0],["ولقد يعاب علي في شيخوختي","اني الى ليلى الحقيقة انزع",36,"ع",1,0],["ولقد يسيء المرء في","اعماله خطأ وعمدا",37,"د",2,0],["ولقد يعوق من الوصو","ل لغاينا الجد العثور",38,"ر",1,0],["ولقد يذكرني بعز آفل","برق لهخلل السحاب خفوق",39,"ق",1,0],["ولقد يأتي الرجس من لا يرى","الرجس وان شنعوا عليه برجس",40,"س",1,0],["ولقد يقول ابناي في نجواهما","ماذا يكابد في النوى ويلاقي",41,"ي",1,1],["ولقد ينال حمى الإله ببعضهم","مالا تنال الأرض بالأسوار",42,"ر",1,0],["ولقد يشينون الشنو","ف إذا تحلوا والأساور",43,"ر",1,0],["وَلَقَد يُداوونَ الجِراحَ بِبِرِّهِم","وَيُقاتِلونَ البُؤسَ وَالإِملاقا",44,"ق",2,0],["وَلَقَد يُشادُ عَلَيهِ مِن شُمِّ العُلا","ما لا يُشادُ عَلى القَنا الخَطّارِ",45,"ر",1,0],["وَلَقَد يُؤسى ذَوو الجَرحى بِها","مِن جِراحِ الدَهرِ أَو يُشفى الحَزانى",46,"ن",2,0],["وَلَقَد يَتَمتَ فَكُنتَ أَعظَمَ رَوعَةً","يا لَيتَ مِن سَعدِ الحِمى لَم تَيتَمِ",47,"م",1,0],["وَلَقَد يُجدي الفَتى أَن يَعلَما","صَهوَةَ الماءِ وَمَتنِ الفَرَسِ",48,"س",1,0],["وَلَقَد يَخُصُّ النافِعينَ بِعَطفِهِ","كَالشَيخِ خَصَّ نَجيبَهُ بِحَنانِهِ",49,"ن",2,0],["وَلَقَد يُقامُ مِنَ السُيوفِ وَلَيسَ مِن","عَثَراتِ أَخلاقِ الشُعوبِ قِيامُ",50,"م",1,0],["وَلَقَد يُداسُ الذِئبُ في فَلَواتِهِ","وَيُهابُ بَينَ قُيودِهِ الضِرغامُ",51,"م",1,0],["ولقد يكونُ الدهرُ أعجمَ صرفهُ","حتى استوى المكروهُ والمحبوبُ",52,"ب",1,0],["وَلَقَد يُساعِفُ ذا الهَوى","بِأَوانِسٍ كَالوَحشِ خُرَّد",53,"د",1,0],["وَلَقَد يَقولُ ذَوُ الحِجى لِسَفيرِهِم","حُثَّ المَطِيِّ بِواضِحٍ مَرّاسِ",54,"س",1,0],["وَلَقَد يَبيتُ اللَيلَ ما يَلقى لَهُ","إِلّا الحُسامَ المَشرَفِيَّ ضَجيعا",55,"ع",2,0],["وَلَقَد يَحُلُّ بِها الجَميعُ وَفيهِمُ","حورُ العُيونِ كَأَنَّهُنَّ صِوارُ",56,"ر",1,0],["ولقد يلطم خده","في حال ترفيه الخدود",57,"د",1,0],["وَلَقَد يَكفيكَ مِنها","أَيُّها الطالِبُ قوتُ",58,"ت",1,0],["وَلَقَد يُكَلِّمُكَ الزَمانُ بِأَلسُنٍ","عَرَبِيَّةٍ وَأَراكَ لَستَ تُجيبُ",59,"ب",1,0],["ولقد يُساء فما يَرى","مِن حُبِّه أحداً أساء",60,"ا",2,0],["ولقد يكون من الضلوع حديثُهُم","في مُعْضِلاتِ تَوَقّعِ الحدثانِ",61,"ن",1,0],["ولقد يخامرُني بها شَغَفٌ","لا يُفْتَدَى منه بسلواني",62,"ن",2,0],["وَلَقَد يَهيجُ لِيَ البُكاءَ صَبابَةً","شادٍ مُطوَّقُ آلةِ التّغريدِ",63,"د",1,0],["ولقد يَنالُ الفردُ في إيمانهِ","ما لا ينالُ الجيشُ وهو لُهامُ",64,"م",1,0],["ولقد يكون وفيه ساعةُ ذِكرهِ","روحُ الحزينِ ورِيُّ قلبِ الصّادي",65,"ي",1,0],["ولقد يُقامُ العرسُ من سَفَهِ الألى","فَرِحُوا وأولى أن يقامَ المأتمُ",66,"م",1,0],["ولقد يَحيدُ عن التُّرابِ إناقةً","مَن لا يَحيدُ عن الضِّرابِ ويَنْكُلُ",67,"ل",1,0],["وَلَقَد يَغنى بِهِ أَصحابُكَ ال","مُمسِكو مِنكَ بِأَسبابِ الوِصالِ",68,"ل",1,0],["ولقدْ يَجِلّ عن اشتياقي ماؤه","شَرَفاً فَوَاظَمِئي لِلامعِ آله",69,"ل",2,0],["ولقد يعطى المرءُ سبعين حورا","ء عليهن سندسٌ وحرير",70,"ر",1,0],["ولقد يسقى الظامئون عصيراً","هو من حنظلٍ وساءَ العصير",70,"ر",1,0],["وَلَقَد يمر عَلى الصَحي","فة فاحصاً مر النسيم",71,"م",1,0],["وَلَقَد يسر بما يرى","في الروض من وجه وَسيم",71,"م",1,0],["وَلَقَد يَموت نبوغه","مَن لا تساعده الظروف",72,"ف",1,0],["ولقد يعقب الظهور خفاء","ثم لا يعقب الخفاء ظهور",73,"ر",1,0],["وَلَقَد يريك الدهر في حدثانه","ما للطَبيعة فيه من سلطان",74,"ن",1,0],["وَلَقَد يثير عواطفاً","من سامعيه وَيسحر",75,"ر",1,0],["وَلَقَد يطيل قصيدَه","فَيجيد أَشعث أَغبَر",75,"ر",1,0],["وَلَقَد يصادف عزه","من بعد ما هُوَ يقبر",75,"ر",1,0],["وَلَقَد يعانى المصلحون مشقة","حتى يتم لأمة إصلاح",76,"ح",1,0],["وَلَقَد يقيم وَلا كلا","مَ كأَنَّما هو لا يراها",77,"ا",3,0],["وَلَقَد يندم الفَتى","يوم لا ينفع الندم",78,"م",1,0],["وَلَقَد يَفور النور في","نجم ضَئيل بانفجارِ",79,"ر",1,0],["وَلَقَد يشيع بيومه","فكأَنَّه مثلٌ شرود",80,"د",1,0],["ولَقَد يُصاحِبُني الشَّبابُ فَلم أَكُن","آتي بهِ إلاَّ الفَعَالَ الأَصوَبَا",81,"ب",2,0],["وَلقد يَجُوبُ الأَرْض لَيْسَ مُبَالِياً","فِي غَامِرٍ تَجْوَابُهُ أَوَّ عَامِرِ",82,"ر",1,0],["وَلَقَدْ يَسْرُدُ الحَديثَ فَيُنْشِي","صَحْبَهُ بِالسَّلافِ مِنْ غَيْرِ وِزْرِ",83,"ر",1,0],["ولقد يردى الفتى بالأمل","فنون الحرب",84,"ب",1,0],["ولقد يأخذه بالحبل","ولقد ينساب في أنفاسه",84,"ه",1,0],["ولقد يتركه ذا شلل","عدد كانت لتشفي عللاً",84,"ل",2,0],["وَلَقَد يسرُّ اللَهُ بِالبأساء في","أَحكامِهِ وَيَضُرُّ بِالنَعماءِ",85,"ا",2,0],["وَلَقَد يَخبِطونَ في ظُلمِ الجَه","لِ وَمِن أَينَ تهتَدي الأَنعامُ",86,"م",1,0],["وَلَقَد يُكثِرُ مِن إِعوازِهِ","رَجُلٌ تَرضاهُ مِن أَلفِ رَجُل",87,"ل",1,0],["ولقد يصوغ الشِّعرَ؛ وهْوَ حماسةٌ","فيريك عَمْرًا في الجِلادِ، وعنترا",88,"ر",2,0],["ولقد يَنامُ وكُتْبُه من حَوْلِهِ","فكأَنه مِنْهُنَّ بين تِلالِ",89,"ل",1,0],["ولقد يروض الأسْدَ رائضُها، ولا","يتغيرُ الطبعُ الغليظ الجافي",90,"ف",2,0],["ولقد يَصِيرُ لناب ليثٍ طُعْمَةً","مَنْ باتَ في غاب الليوثِ نزيلا",91,"ل",2,0],["ولقد يولد النباتُ وَيَفْنَى","ويعاني مثل الأنام سقاما",92,"م",2,0],["ولقد ينام القوم ملء العين في","زمن يُقضُّ مضاجعًا وجنوبا",93,"ب",2,0],["ولقد يَعِزُّ على المليك وشعبِهِ","والمشرقينِ نجيعُك المتدَفِّع",94,"ع",1,0],["ولقد يكون العذرُ أنا طُمَّحٌ","ولقد تكون وأنت غيرُ ملوم",95,"م",1,0],["ولقد يَعِزُّ عليكَ أنَّكَ لا تَرى","في \" الأرْبِعاء \" مواكبَ الزُّوّار",96,"ر",1,0],["ولقد يُذِلُّ مُسوَّداً أعقابُه","ولقد يسودُ عشيرةً حَجّامُ",97,"م",1,0],["ولقد يغضَبون إذ ينزلُ الغيثُ","شحيحاً .والأرضُ عطشى تلوب",98,"ب",1,0],["ولقد يرمزونَ \" عنَّا \" بأنَّا","كلُّ ما في محيطنا مَثلوب",98,"ب",1,0],["ولقد يُرى في نِعمةٍ محسودةٍ","هذا الذي تَرثيِه في الأسمال",99,"ل",1,0],["ولقد يعزُّ على الشُعور وأهلِهِ","مرأى البلادِ بمثل هذي الحال",99,"ل",1,0],["ولقد يَحسُ الشاعرون بأنهم","عبءٌ على أوطانِهِم مطروح",100,"ح",1,0],["ولقد يقول ذوو الحجى لسفيرهم","حث المطي بواضح مراس",101,"س",1,0],["ولقد يخون اخو الوقاحة ماكرا","يهوي بجحد محاسن الاعيان",102,"ن",1,0],["ولقد يرفع الزمان وضيعا","فتراه على الكرام تقدم",103,"م",1,0],["ولقد يتيه وليس ينصف عاشقا","تيه الفخور بحسنه وجماله",104,"ل",2,0],["ولقد يُريد تَشَبُّها بك في الندى","وأقلُّ جودِ يديك مثلُ جَليله",105,"ل",2,0],["وَلَقَد يَخفِضُ المُجاوِرُ فيهِم","غَيرُ مُستَشرِفٍ وَلا مَذمومِ",106,"م",1,0],["ولقد يئست و