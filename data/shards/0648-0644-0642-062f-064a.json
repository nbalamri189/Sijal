",2,0],["ولقد يقي الخز الثمين أذاته","في وقته كف من الشونيز",188,"ز",1,0],["ولقد يخفت النديُّ من الصو","ت ويبقى رنينه في اتصال",189,"ل",1,0],["ولقد يذبل النديُّ من الزه","ر ويبقى عبيره أحيانا",190,"ن",2,0],["ولقد يخفت الرخيم من الصو","ت ويشجو رنينه الآذانا",190,"ن",2,0],["ولقد ينضب الغدير ويبقى","زهرُه فوق شطّه ألوانا",190,"ن",2,0],["ولقد يعز عليك لو شاهدتني","بجوانح ذلّاً خفضن جناحا",191,"ح",2,0],["وَلَقَد يكونُ البُخُل ِشحّاً في الورى","والمفضلونَ على الأنام كرامُ",192,"م",1,0],["ولقد يدخل المسارح حينا","كأمير فيخرجوه اضطرارا",193,"ر",2,0],["ولقد يطردونه من حمى الغر","فة حينا ظلما بلا أسباب",194,"ب",1,0],["ولقد يضربونه دون ذنب","وهو للعض مالك حد ناب",194,"ب",1,0],["ولقد يقول له الصغار بأنه","قد مات عنه أبوه قبل وما يعي",195,"ع",2,0],["ولقد يعز علي أن يغدو وهم","غم الصديق وفرحة الأعداء",196,"ا",2,0],["ولقد يعز أن تغدو بهم","أوطانهم مغبرة الأرجاء",196,"ا",2,0],["ولقد يعز علي أنهمو غدوا","والدارُ قَفْرٌ منهمو ببُعاد",197,"د",1,0],["ولقد يميلُ بناظري عن مسجدٍ","غُصُنٌّ من الرّمانِ أكملَ يُنعَهُ",198,"ع",2,1],["ولقد يرى يوم يذم زمانه","فيزيد بالزفرات والتأويه",199,"ي",2,0],["ولقد يقوي الظن فيه سيرةٌ","مشكورة في الناس قدوةُ مقتدي",200,"د",2,0],["ولقد يصول على العلوم بفهمه","فيذل منها كل ذي استكبار",201,"ر",1,0],["ولقد يرى اخواننا فى حالة","تحتاج للاعوان والأصحاب",202,"ب",1,0],["ولقد يعز على الهدى اهداؤهم","منه الكريم لعابدٍ أصناما",203,"م",2,0],["ولقد يعار عليك أن لا تنتهي","عما تحقق أن سيدركه الفنا",204,"ن",2,0],["وَلَقَد يَردّ الكَأس حَيث يودّه","حَبرٌ دَرى أن سم ضمن شَرابه",205,"ب",2,0],["وَلَقد يَود المرء طُول حَياته","فَتمر حَتّى يَرجو مَوت المبتلي",206,"ل",2,0],["ولقد يُجِيشُ الشَّوْقُ راكد عَبْرَتي","فكأنَّه لَهَبٌ وجَفْني مِرْجَلُ",207,"ل",1,0],["ولقد يكون ريب جدك سابقاً","من قبل أن يفضي إلى الأعقاب",208,"ب",1,0],["ولقد يكون مبيته في خندق","وفراشه تحت السماء جليد",209,"د",1,0],["ولقد يخوضُ بي العَجًا","جَ أقبُّ كالسِّرْحانِ صاهلْ",210,"ل",1,0],["ولقد يَغنى بها قبل النَّوى","وإذ الحيُّ جميع ما افترقْ",211,"ق",1,0],["ولقد يَشُق بي العَجا","جَ مُطهَّمُ نَهدٌ كميتُ"