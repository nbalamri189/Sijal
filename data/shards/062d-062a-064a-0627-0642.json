{"poems":[[57,"حجبت وجهك عن عيني مذ زمن","https://www.aldiwan.net/poem26337.html","البسيط"],[90,"يا عدل طال الانتظار فعجل","https://www.aldiwan.net/poem44798.html","الكامل"],[74,"ما ضر من لم يجد في الحب تعذيبي","https://www.aldiwan.net/poem18226.html","البسيط"],[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[45,"غيري بأكثر هذا الناس ينخدع","https://www.aldiwan.net/poem9719.html","البسيط"],[82,"أي نعيم في الصبا والمقترح","https://www.aldiwan.net/poem31521.html","الرجز"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"قد لامني في خليلتي عمر","https://www.aldiwan.net/poem63825.html","المنسرح"],[136,"بلغ سلامى إذا جئت البتول لها","https://www.aldiwan.net/poem54771.html","البسيط"],[234,"الحر لا يأتي الدنيه","https://www.aldiwan.net/poem50732.html","مجزوء الكامل"],[285,"شرفا لمجدك بانيا ومقوضا","https://www.aldiwan.net/poem60712.html","الكامل"],[302,"ولقد طرقت الحي من سعد","https://www.aldiwan.net/poem33289.html","أحذ الكامل"],[369,"ليس التعجب إلا من بني زمن","https://www.aldiwan.net/poem60664.html","البسيط"],[409,"كم ذا التلعب يا غزال الأجرع","https://www.aldiwan.net/poem33672.html","الكامل"],[438,"بين اللوى فالجزع فالمتثلم","https://www.aldiwan.net/poem12473.html","الكامل"],[445,"منن بأيسر شكرها أعييتني","https://www.aldiwan.net/poem34915.html","الكامل"],[447,"آها لها من غصة النادم","https://www.aldiwan.net/poem14479.html","السريع"],[520,"إن كنت أزمعت على المسير","https://www.aldiwan.net/poem12128.html","الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48654","الرجز"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123394","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64840","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49924","البسيط"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111857","السريع"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49580","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101049","البسيط"],[1831,"","https://poetry.dctabudhabi.ae/diwan/poem/146554","البسيط"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114760","السريع"],[2562,"","https://poetry.dctabudhabi.ae/diwan/poem/123452","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89425","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62750","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138557",""],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46018","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91483","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133296","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35509","الكامل"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111317","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125805","الكامل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78195","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119650","البسيط"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141843","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90816","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81683","الكامل"],[4767,"مركز الماجد","https://www.poetsgate.com/ViewPoem.aspx?id=97448",""],[4984,"أول ماي","https://www.poetsgate.com/ViewPoem.aspx?id=180386",""],[5187,"تاج الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=29254",""],[5455,"بايعها","https://www.poetsgate.com/ViewPoem.aspx?id=35124",""],[5956,"ليت يحالفني التعبير","https://www.poetsgate.com/ViewPoem.aspx?id=183270",""],[5956,"قيسُ بْنُ رضواني أبو الإحسان","https://www.poetsgate.com/ViewPoem.aspx?id=203553",""],[161,"ربيعَا للأمة زَعَمُوا !","https://www.poetsgate.com/ViewPoem.aspx?id=211185",""],[6102,"جرش المداميك ..","https://www.poetsgate.com/ViewPoem.aspx?id=183608",""],[6170,"أجتازُ هِجرَتنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86031&r=&rc=2",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""]],"verses":[["حَتّى أَقولَ لِعَيني عِندَ نَظرَتِها","هذا جَزاءٌ لِطولِ الدَمعِ وَالسَهَرِ",0,"ر",1,0],["حتى أُقيم مُجَسَّماً تمثالها","بين الشعوب على بناءٍ هَيْكل",1,"ل",1,0],["حتى أقمتُ قريرَ العينِ في دعَةٍ","وذكر مدحك في الآفاق يسري بي",2,"ب",2,0],["حتى أقرُّوا وقال قائلُهُمْ","محرَّمُ الحول سابقٌ صَفرَهْ",3,"ر",2,0],["حَتّى أَقامَ عَلى أَرباضِ خَرشَنَةٍ","تَشقى بِهِ الرومُ وَالصُلبانُ وَالبِيَعُ",4,"ع",1,0],["حتى أقولَ زاحفاً من نشوَتي","يَحْسُنُ بالتزحيفِ بيتُ المنسرح",5,"ح",1,0],["حَتّى أُقيمَ في جَحيمِ الهاجِرَه","وَرَأسُهُ كَمِثلِ قِدرٍ فائِرَه",6,"ه",1,0],["حَتّى اِقتَهَرني وَإِخوَتي غَيَبٌ","وَيلي عَلَيهِم لَو أَنَّهُم حَضَروا",7,"ر",3,0],["حَتَّى أُقرِّبَها كَيما أُرَّ بِهَا","عَيني وأنظُرَ عَينَيهَا وأَسأَلَهَا",8,"ل",3,0],["حتى أقوم بثأر آ","بائي من العُصَبِ الشَّقِيّهْ",9,"ي",2,0],["حَتّى أَقَمْتَ الْحَزْمَ أَبْلَغَ خاطِبٍ","فِيها فَحَثَّ عَلَى الصَّلاحِ وَحَضَّضا",10,"ض",2,0],["حتّى اِقتحمتُ الخدرَ مُجتَرئاً","أدلي بِقُربى الحبِّ والودِّ",11,"د",1,0],["حَتّى اِقتَدى بِهِمُ فيهِم فَأَهلَكَهُم","وَقَد يَبُذُّ إِماماً شَأوُ مَأمومِ",12,"م",1,0],["حتى أقام البيِّناتِ بأنه","سحر وأبرز حجة لم تدفع",13,"ع",1,0],["حتى أقبّل راحة الحَبرِ الذي","فاقَ الورى وعلا علوّ الأنجُمِ",14,"م",1,0],["حتى أُقَبِّلَ كُلَّما قابلتُها","كفّاً بجودِ عطائها أَحْيَيْتَنِي",15,"ن",2,0],["حتى أقر الدين في أصله","وعز مظلوماً على الظالم",16,"م",1,0],["حتى أقر عين مستحير","لا بل أذود الضيم عن خفيري",17,"ر",2,0],["حتى أقاموا واليا عليهم","فقام فيهم والنبي فيهم",18,"م",1,0],["حتى أقامو بينهم فَعَلِمُوا","شريعةَ الإسلام ثم أسلموا",19,"م",3,0],["حتى أقول عساه يَخْ","ضِب شَيْبَهُ الدهرُ الوَقاحُ",20,"ح",1,0],["حتى أقام لأهل الدين رسم هدى","عليه للحكم بإيجاب تسجيل",21,"ل",1,0],["حتى أُقضّيَ مِنْ سكْري بِها غَرَضاً","يُنْسي فُؤاديَ ما لم يَقْضِ مِنْ غرضِ",22,"ض",1,0],["حتَّى أَقام ابنُ عبدُ الله كائلَها","عدلاً وأَلّف بين الشاة والذيبِ",23,"ب",1,0],["حتى اقتضى التوفير ما بيننا","قتلَ الكلاب اليوم من غير حد",24,"د",1,0],["حتى أُقبّلَ يُمْنَاكَ التي حَظِيَتْ","بها الظُّبَى قَبْلَ أَنْ نَحْظَى بها القُبَل",25,"ل",1,0],["حتى أقلته في عليا مشارقه","زهراء زهرة ذات الطهر والعصم",26,"م",1,0],["حتى أقول لداري حين تدخلها","هنيت يا جنتي إقبال رضوانك",27,"ك",1,0],["حَتّى اقتسَمنا خُطَّتَي فرقةٍ","لهُ مقامٌ ولِرَحلي عُبور",28,"ر",1,0],["حتى أقر الشرع عند نصابه","وجلا شعاع العلم وهو ظلام",29,"م",1,0],["حتى أقام الفقير الحال منبسطاً","على الركائب والحادي يغنيه",30,"ي",2,0],["حتى أقَمتَ بأرمينيةٍ عجَباً","سوقاً يُعارَضُ فيها العيشُ بالسأمِ",31,"م",1,0],["حتى اقام بمعوج الظبا عوجا","في الدين من معشر ما بارحوا العوجا",32,"ج",2,0],["حَتّى أَقَمتُ وَقَد أَقامَ لي الهَوى","في الخَدِّ مِن نُؤيِ القِبابِ مِثالا",33,"ل",2,0],["حَتّى أَقَمتُ أَدلّتي بمذلّتي","وَبطاعَتي دافعت ظنّ المُنكر",34,"ر",1,0],["حتى أقرّ له العموم","وبعلمه صحّ الخبر",35,"ر",1,0],["حَتّى أَقرّك ذُو العلا بِقَرارِها","وَشَفى بِدولَتِكَ الصُدورَ وَأَثلَجا",36,"ج",2,0],["حتى أقام بسيفه علماً","بطلت به من أهلها النحل",37,"ل",1,0],["حتى أقام على الدسائس دائباً","يشتط بالمعلوم والمجهول",38,"ل",1,0],["حَتّى أَقولَ أَسَفا","يا قَلبُ جَرَعت الرَدى",39,"د",2,0],["حتى أقام على أرباض دارهم","زلّوا وفي القصب الملتفِّ قد حُصروا",40,"ر",3,0],["حتى أقام له المهينُ دينه","وغدت به أهلُ العزائم تحتمي",41,"م",2,0],["حتى أقرت حاسدوه بفضله","والفضل ما شهدت به الأعداء",42,"ا",2,0],["حتَّى اقتضتْ شِيَمُ التنقُّلِ أن ترى","مسترجعاتٍ رِفْدَها وحِباءها",43,"ا",3,0],["حتى اقتفت في دربِها نَهجَه","وشَيَّدَتْ بِجُهدِها الرائد",44,"د",1,0],["حتى أقر لهم من كان ينكر ما","في العدل من حقهم عن صحوة نتجا",45,"ج",2,0],["حتى اقْتنعتُ بأنَّ حسّكَ صادقٌ","وغدوتُ مثلكَ للجمالِ مُبايعا",46,"ع",2,0],["حتى اقبلت تبكي الدمعه وتردعها","ثم قالت..وكن موتي بين اشافيها:",47,"ي",3,0],["حتى أقْدرَ بالأشعارْ","تصويرَ شعوري للأزهارْ",48,"ر",1,0],["حتى أقدِّم آية الشكرانِ","لجميلهِ فهو الذي زكَّاني..",49,"ن",2,0],["حَتَّى أقَارِنَ مَاضِيهَا بِحَاضِرِهَا","كَيْفَ الْتَوَتْ عَبَثًا وانْتابَهَا الوَهَنُ",50,"ن",1,0],["حَتَّى اقتَحَمتُ جَحيمَ الصَّدرِ فانصَهَرَتْ","مِنِ احتِراقِيَ - رُوحي - في أَثافِيكِ",51,"ك",1,0],["حتى أقولَ لنارها اتّحدي","أنا ها أنا الأحياءُ والموتى",52,"ت",2,0],["حتى أقام لدولة","عزت شعوبا أو بِِِنا",53,"ن",2,0]]}