aspx?id=179961",""],[5152,"تأملات","https://www.poetsgate.com/ViewPoem.aspx?id=184394",""],[5277,"شفاه عطشى","https://www.poetsgate.com/ViewPoem.aspx?id=185788",""],[5295,"شذا القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=210634",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[1021,"لا تعذلن فلست أقبل","https://www.poetsgate.com/ViewPoem.aspx?id=47609",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[5409,"أصقر تهامة والأبطحين","https://www.poetsgate.com/ViewPoem.aspx?id=155485",""],[5411,"ناقوس روحي","https://www.poetsgate.com/ViewPoem.aspx?id=185282",""],[5415,"ألآ أيها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=212280",""],[5431,"أعيذك الشوق أن يكبو بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=197544",""],[5431,"رقصة النار ...","https://www.poetsgate.com/ViewPoem.aspx?id=204746",""],[5455,"وحده بوحده","https://www.poetsgate.com/ViewPoem.aspx?id=34435",""],[5561,"قارورة عطر","https://www.poetsgate.com/ViewPoem.aspx?id=192898",""],[5561,"بلاء الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=196888",""],[5616,"حوت","https://www.poetsgate.com/ViewPoem.aspx?id=203472",""],[243,"وحي النيروز","https://www.poetsgate.com/ViewPoem.aspx?id=20962",""],[5674,"أبحث عن خطاك بكل ضلع","https://www.poetsgate.com/ViewPoem.aspx?id=185910",""],[5674,"أبحث عن خطاك","https://www.poetsgate.com/ViewPoem.aspx?id=187322",""],[5768,"سُلُوكُ الْمَحَجَّةِ إلَى عَشْرِ ذِي الْحِجَّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=215594",""],[5956,"جوبي السهول","https://www.poetsgate.com/ViewPoem.aspx?id=184926",""],[5956,"رسالة جوابية منه لي على الوتس أب","https://www.poetsgate.com/ViewPoem.aspx?id=194394",""],[5961,"يسير بك المهيمن","https://www.poetsgate.com/ViewPoem.aspx?id=199772",""],[5975,"فرحماك يا توّابُ","https://www.poetsgate.com/ViewPoem.aspx?id=58781",""],[6239,"من ذاكرة الصقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75978&r=&rc=29",""],[463,"تعالينَ نعالجْ نف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60213&r=&rc=269",""],[6259,"قسماً بوصلك إنَّ بُعد مرامهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59403&r=&rc=51",""],[6262,"اللغةُ لم تكن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80118&r=&rc=16",""],[6310,"السُّبات الدَّامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74588&r=&rc=16",""],[5424,"بنت عم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65429&r=&rc=17",""]],"verses":[["ووحوح في حضن الفتاة ضجيعها","ولم يك في النكد المقاليت مشخب",0,"ب",1,0],["ووحشة بيننا يؤكدها","نحوَ الجفا فهي هكذا وحشه",1,"ش",2,0],["وَوَحشٍ أَرانيها الصِبا فَاِقتَنَصتُها","وَكَأسِ سُلافٍ باكَرَتني شَمولُها",2,"ل",3,0],["وَوَحشَةٍ لِاِبنِ عَبدِ اللَهِ بينَهُما","أَشهى مِنَ الأُنسِ بِالأَحسابِ وَالحَشَمِ",3,"م",1,0],["وَوَحيدَةٍ بِالنَجدِ تَشكو وَحشَةً","وَكَثيرَةِ الأَترابِ بِالأَغوارِ",4,"ر",1,0],["وَوَحشِيَّ المَسامِعِ لَم يُؤَنَّس","بِتَكرارِ المَلامَةِ وَالعِتابِ",5,"ب",1,0],["وَوَحشَتُهُ حَتّى كَأَن لَم يُقِم بِهِ","أَنيسٌ وَلَم تَحسُن لِعَينٍ مَناظِرُه",6,"ر",2,0],["وَوَحَقِّ القَنا عَلَيهِ يَميناً","هِيَ أَمضى مِنَ الحُسامِ الفَتيقِ",7,"ق",1,0],["وَوَحفٍ يُثَنّى في العِقاصِ كَأَنَّهُ","دَواني قَطوفٍ أَو أَنابيبَ عُنصُلِ",8,"ل",1,0],["وَوَحفٌ زانَ مَتنَيكِ","وَزانَتهُ التَقاصيبُ",9,"ب",1,0],["ووحشة لفّت الدّنيا برهبتها","ولفّت الغيب والأحلام والأبدا",10,"د",2,0],["ووحَّدَ بين الناس لا البُعد مُبْعِدٌ","عن الساحةِ الكبرى ولا القُرْب مُقْربُ",11,"ب",1,0],["ووحشة بَيْننَا يحركها","نَحْو الجفا فَهِيَ هَكَذَا وحشه",12,"ه",1,0],["ووحِّدِ الرأيَ، كم أزرى الخلافُ بنا","لا يدركُ المجدَ شعبٌ غيرُ متَّحدِ!",13,"د",1,0],["ووحّد الله والتاريخ بينهما","والحقد والجرح والأحداث والفتن",14,"ن",1,0],["ووحدَّتْ منهُمُ الأديانَ فارقةً","والأمرَ مختلفاً والرأيَ مُقتَسمَا",15,"م",2,0],["ووحش المسامع لم يؤنس","بتكرار الملامة والعتاب",16,"ب",1,0],["وَوَحَّدوا أيضا جُذور الثّانِيه","وَأَفرَدوا أموَالهم في التالِيه",17,"ه",1,0],["ووحدة الصَّمصامِ في غِمْدِه","خَصَّتْه بالعزة في الناس",18,"س",1,0],["ووحق الصلاة والصوم وال","عفة عن صائنٍ وعن مبذول",19,"ل",1,0],["ووحيك تتلوهُ المدافع اذ لها","اصابع من تلك السيوف تشيرُ",20,"ر",1,0],["ووحش الفيافي والغزالة سلمت","عليه ومنه نورها يتقسم",21,"م",1,0],["ووحّد واحداً في اسمٍ وذاتٍ","وفعلٍ منه تشتقّ المصادر",22,"ر",1,0],["وَوَحَقِّ أَصحابِ العَبا خَيرِ الوَرى","ما القَلبُ مُذ فارَقتُ أَحبابي مَعي",23,"ع",2,0],["وَوَحفٌ يُغادى بِالدِهانِ كَأَنَّهُ","مَديدٌ غَداهُ السَيلُ مِن نَبتِ عُنصُلِ",24,"ل",1,0],["ووحيث حُنُوُّ الوالدين مضيَّعٌ","وحيث قلوب أولي المحبة تَغلُظُ",25,"ظ",1,0],["ووحد المولى وبن كل بين","واترك جميع الكذب والمين",26,"ن",1,0],["وَوَحَقَّ وُدِّك فَهوَ أَبعَد غايَةٍ","يَجري إِلَيها البِرُّ في أَقسامِهِ",27,"م",2,0],["ووحقِّ فضلِك إنه","قسَمُ المعاني والمعالي",28,"ل",2,0],["ووحي الشمس وهي تمج حلما","تنوع في النثير وفي النظيم",29,"م",1,0],["ووحَّدناه في العدّ","فما والله ثَنَّيْنا",30,"ن",2,0],["ووحدَّها في الحبّ قلبي فما له","وإن وجدَ الأبدالَ أن يتبدَّلا",31,"ل",2,0],["ووُحّدَ في المناقبِ والمَعالي","فلما استصرخوهُ كان مَجْرا",32,"ر",2,0],["ووحقِّ حبكم يميناً","لم تشب مني بمينِ",33,"ن",1,0],["ووحقّ الغصون تحت نسيمٍ","ساحبٍ ذيله البليل وكمَّهْ",34,"م",2,0],["وَوَحشَة ُالموتِ ، والنَّجوى ، ومَكتَبَتي","وأنتَ مِثْلَ انسِرابِ الضَّوءِ تَنسَرِبُ",35,"ب",1,0],["ووحِّد من جلى هذا وهذا","تديرهما الشؤن برمزتيه",36,"ي",2,0],["ووحِّدْ وخَلِّ الإتِّحادَ وأَهلَهُ","وخُذْها تَماماً تلكَ سبعَةُ أَسْطُرِ",37,"ر",1,0],["ووحقّ ما في قده ولحاظه","من ذابل لدن وبيض صفاح",38,"ح",1,0],["ووحق عيشك لا حلا","لأبيك مر العيش بعدك",39,"ك",1,0],["ووحق رأسك إن حا","لي لو علمت بها رزيه",40,"ي",2,0],["ووحدة شعبنا بمقومات","أتت كالشمس بددت القتاما",41,"م",2,0],["وُوحُ الرُّوحُ لاَ رُوحُ الأوانِي","أنَا في مَسْتوَى عَرْشِي قدِيمُ",42,"م",1,0],["وَوَحَقِّ عِقْدِكَ عِقْدِ ثَغْرِكِ إِنَّني","سأُعِيدُهُ باللَّثْمِ وهْوَ مُفَصّلُ",43,"ل",1,0],["ووحدوا الله حقاً لا شريك له","من بعد ما انهمكوا في الكفر أزمانا",44,"ن",2,0],["وَوَحى إِلى الشَرقِيِّ بِالطُرقِ الَّتي","يَمشي النَجاءُ بِها لِأَجلِ نَجاتِهِ",45,"ت",2,0],["ووحيدُ الدّهرِ في إدراكِه","مِنْ فنونِ العلم فهماً كلّ فنْ",46,"ن",1,0],["وَوَحَّدَتُ صُفْوفَها","كَعِقْدِهَا المُتَّسِقِ",47,"ق",1,0],["ووحّدت فيه الثّناء الجمي","ل علما بأَن الفتى أوحدُ",48,"د",1,0],["ووحق روضتك الشريفة أنني","أبدا أهيم بحب ذاك الهيكل",49,"ل",1,0],["وَوَحَقِّ الهَوَى وَطَاعَةِ جَفْنِي","لِوَلِيّ الدُّمُوعِ وَالتَّسْهِيدِ",50,"د",1,0],["وَوَحْدتي مِنْ صِحابِ صِدْقٍ","ما النَّاسُ بَعْدَهُم بِناسِ",51,"س",1,0],["وَوَحشتِى من بعد بدرٍ قضى","فليس لى فى النّاس من أُنسِ",52,"س",1,1],["ووحيدها وبشيرها ونذيرها","وغياثَها وجوادها المتفضلا",53,"ل",2,0],["وَوَحِّدِ اللَهَ وَاِتبَع","مُحَمَّداً في الهُداةِ",54,"ه",1,0],["ووحَّدَهُ بالعزِّ بين عباده","ليجروا على منهاجه ويُوَحِّدوا",55,"د",3,0],["وَوَحفٍ يُثَنّي في العِقاصِ كَأَنَّهُ","عَلَيها إِذا دَنَّت غَدائِرَها كَرمُ",56,"م",1,0],["ووحي مهند وبيان رمح","وقامة قائد للضيم آبي",57,"ب",2,0],["ووحدة العروض فيه تشترط","فانها مقبوضة الجزء فقط",58,"ط",1,0],["ووحَقِّ الوفا وحفظِ العُهودِ","ما تخلفتُ عنكمُ عن صُدودِ",59,"د",1,1],["ووحّدْتُ المعاني فيك حتى","رأيت الكون خلْواً من شجوني",60,"ن",2,0],["وَوَحقِّ الذي حَبانيَ بالحُسْ","نِ جَمالاً تَحارُ فيه العُيونُ",61,"ن",1,0],["ووحوش الغاب والأن","غام ترعى في قطيع",62,"ع",1,0],["ووحدتي لهفَ نفسي","تعيش بين الضجيج",63,"ج",1,0],["ووحي الشعر من حدس رفيعٍ","وهل يعطيك موت النفس حدسا",64,"س",2,0],["ووحدوا أمرهم في نظم جامعةً","كبرى ليعتصموا فيها إذا اغتصبوا",65,"ب",3,0],["ووَحْدةَ الحُرَّةِ في ليلةٍ","مات بها الزَّوْجُ لَدَى الضَّرَّهْ",66,"ر",2,0],["ووحدةٌ واختلاطٌ كيف شئتَ بِهِ","وانت بالقرب من مدنٍ وبلدانِ",67,"ن",1,0],["وَوَحَقِّ مَن خَتَمَ الرِسالَةَ وَالهُدى","بِمُحَمَّدٍ فَزَها بِهِ الحَرَمانِ",68,"ن",1,0],["وَوَحَّد من غَيرٍ هَواكَ لِأَنَّه","تَيقَّن إِشراكَ الهَوى مُسقِطَ الوَفا",69,"ف",2,0],["وَوَحَقُّ مصر ما بمصر حاجة","إلا إلى شيم ورأي وار",70,"ر",1,0],["ووحدة الموضوع والمكان","والشرط والمحمول والزمان",71,"ن",1,0],["وَوَحِيدُ والِدِهِ لِخَمسِ شَقائِقٍ","أَعداهُمُ جَرياً وَوَجهاً اَشنَعُ",72,"ع",1,0],["ووحشتي ثم تغريبي على كظم","وعبرتي ثم تصبيبي وتذكاري",73,"ر",2,0],["ووحدة تقول إن الجهات","تشير له والبوصلة !",74,"ل",2,0],["ووحدة تقول إن الممات","أرحم من أكبر منزلة..",74,"ل",2,0],["ووحدة تقول إن الشتات","في الحب..كل المشكلة..",74,"ل",2,0],["ووحشةَ تشريدٍ وكربةَ نازحٍ","وذُلَّ عزيزٍ باتَ يتَّسِدُ العَرَا",75,"ر",2,0],["ووحي النحل والأسرى","بأحمد زين الكتبا",76,"ب",2,0],["ووحْدوها المنابع جم.. خلوا راية( النداس)","شعابك مع شعاب القوم خلْف عارمٍ دهديم",77,"م",1,0],["وَ وَحْدَكَ يَا حَبِيبِي فِي ظَلَامٍ","وَ قَلْبُكَ لَمْ يُطِقْهُ،وَ لَنْ يُطِيقَهْ.",78,"ق",2,0],["ووحشةُ الليلِ تغتالُ النهارَكمن","يُنازِعُ النورَ طيبًا في مُحياهُ",79,"ا",2,0],["ووحيدةُ المنفى تعاقرُ عشقَها","بين الفصولِ..تخونُها الأفراحُ",80,"ح",1,0],["ووحيدةً بهواهُ صرتُ لأنَّني","ما كانَ في رَحِمِ القصيدِ سِوايا",81,"ا",3,0],["ووحدة الحب والمحبوب ظاهرة","في كل شيء وللآيات تفصيل",82,"ل",1,0],["ووحتى خال فوق وج","نته وري في المخلخل",83,"ل",1,0],["ووحق من أعطاك ما","أعطاك من كرم وخَوَّل",83,"ل",1,0],["ووحده في أسمائه وصفاته","ولا تتأولها كرأي المفند",84,"د",1,0],["ووحشاً يطارد أمثاله","وبوما تجاوب غربانها",85,"ن",3,0],["وَوَحْدي أصُدُّ الرّيحَ خَلْفَ سَتائِري","وَرُوحي بَقايا مِنْ مَدَى العُمْرِ فرّتِ",86,"ت",1,0],["وَوَحِّدْ وَسَبِّحْ وَكَبِّرْ وَهَلِّلْ","وَدَاوِمْ بِذِكْرٍ لِيَجْلُو عَنَاكَ",87,"ك",1,0],["ووحدها الروح تهمي في حديقته","كي يعبق الزهر حبا حين تلقاه",88,"ا",2,0],["ووحوشٌ حبيسة الوهج تعوي!!","ووعولٌ رشيقة الظلّ تزأر!!!",89,"ر",1,0],["ووحده بوحده كان عندك عداله","اتبّطلي غيبه .. وابطّل زقاير",90,"ر",1,0],["ووحوشُ الصمتِ تمزِّقُه","والغربةُ نارٌ تسعره",91,"ر",2,0],["ووحشُ الرّدى يصطادُهم في بلادهم","مخالبُهُ التشريدُ والخوفُ والبحرُ",92,"ر",1,0],["ووحدك في الطريق تظل تمشي","ووحدك دون نعشك تستميت!",93,"ت",1,0],["ووحد الجوع عزم الجائعين على","أن يوقدوها وألا تخمد النار",94,"ر",1,0],["ووحيُ الشّعرِ يأتيني ذليلاً","أبوحُ.. تُدندِنُ الدنيا ورائي",95,"ا",3,0],["ووحيُ الشّعرِ يأتيني طواعا","أبوحُ.. تُدندِنُ الدنيا ورائي",96,"ا",3,0],["وَوَحِّدْ رَبَّكَ الْبَارِي","لَهُ الْإِنْشاءُ وَالْأَمْرُ",97,"ر",1,0],["وَوَحدة العالم الشمّاءُ يدعمها","كلُّ الوعاة بيوم غيرِ مُنْشعِبِ",98,"ب",1,0],["ووحيدُ موسى مثل نخل بلاده","يهدي لنا الأثمارَ والأطيابا",99,"ب",2,0],["ووحى القلب ينزل كل حين","فيوحى من علوم الاجتباء",100,"ا",2,0],["ووحَّدتُهُ عرفانَ كلِّ موحّدٍ","وناجيتُهُ .. في سرِّه لا أجاهرُ",101,"ر",1,0],["ووحدي استوى فيَّ الصَّقيعُ وعرشُه","تمدّد في الأعضاءِ فوق وقودها",102,"د",3,0],["ووحَّدناه في العدّ","فما والله تثنَّينا",103,"ن",2,0],["ووحق ودّك وهي أبعدُ غاية","يجري إليها البر في أقسامه",104,"م",2,0],["ووَحْيُها معجزاتٌ زنبقةٍ","يضيئُها الشاعرُ الذي لستُ..",105,"ت",1,0],["ووحْشُ الفلاة يداعِبُ فيْنَا","طيورَ الإباء .. ويطفيء غِلّه",106,"ل",2,0],["ووحدي امضغ الصبّار","أنّى رُحتِ ..أو جِئتِ",107,"ت",1,0]]}