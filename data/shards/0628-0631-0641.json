{"poems":[[53,"يا رب عبد مالك سيدا","https://www.aldiwan.net/poem61854.html","الكامل"],[53,"أبا الصقر لا تدعني للبراز","https://www.aldiwan.net/poem65769.html","المتقارب"],[68,"أقسم الحب أن يبالغ في الصد","https://www.aldiwan.net/poem39655.html","الخفيف"],[128,"هلملم هلم نلم شعث قريضنا","https://www.aldiwan.net/poem23771.html","الكامل"],[382,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[466,"أقول وقد ضاقت قوافي مدائحي","https://www.aldiwan.net/poem16433.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38366","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46542","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64442","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27834","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88954","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83368","الكامل"],[4578,"ريم النقا بالله غني سلاه","https://www.poetsgate.com/ViewPoem.aspx?id=49603",""],[4875,"سلامتك","https://www.poetsgate.com/ViewPoem.aspx?id=133837",""],[6120,"يَحِنُّ قَلبِي لِأيَّامٍ مِنَ الغَزَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=213518",""]],"verses":[["بَرَّ فلا أجْحَدُهُ برَّهُ","والبِرُّ لا يَنْمى على الجَحْدِ",0,"د",1,0],["برفْدِك ينهَضُ من يرتجِي","لديْكَ الغِنَى وبِحُملانِكا",1,"ك",2,0],["بَرَّ في حَلفِهِ فَيا لَيتَهُ كا","نَ وَلَو مِن دَمي خَضيبَ البَنانِ",2,"ن",1,0],["برفين يا مولاي لا عثرت بكم","في حلبة النظر السديد عيون",3,"ن",1,0],["برفعه خُفضت كلُّ المراتب في","معنى إضافتها لجنبه السهل",4,"ل",1,0],["برَفْعِ دُعاءٍ لا يَشوبُ صَريحَهُ","رِياءٌ ولا يَثْني الدُّعاءَ حِجابُ",5,"ب",1,0],["بِرفعَةِ قَدرٍ في مَعالي مَكارِمٍ","بِمَنصِبِ جاهٍ مِن شَريفِ المَناصِبِ",6,"ب",1,0],["برفقه يَدين","وَقَتل المَسكين",7,"ن",1,0],["برفعتك ارفعني ارتفاع موحد","محب صفى في المحبة مخبت",8,"ت",1,0],["برفعتك ارفعني مكاناً من الهدى","علياً وايدني بروح الحقيقة",8,"ه",1,0],["برفعتك ارفع هم نفسي من الهوى","وسر بي لما ترضى سواء الطريقة",8,"ه",1,0],["برفعِ غاشية يقول مطّرقاً","هذا خليفتنا في السرّ والعلن",9,"ن",1,0],["برفع جناح الكبرياء لأهلها","وخفض جناحٍ للأفاضل والآل",10,"ل",1,0],["برفيق الحديث يلهيه حيناً","ويداويه كلومه ويداري",11,"ي",1,0],["بِرَفيع جاهك كن لَنا وَاِشفَع بنا","فَذُنوبُها كَالبَحر في الأَمواجِ",12,"ج",1,0],["برفع موضوع المعاني غدا","يصرف المنطق في ما نحاه",13,"ا",2,0],["برفوق جيتي وارحلي عاد برفوق","يا علّة اللي كل صعبٍ يعيقه",14,"ق",2,0],["بِرِفْقَةِ الْحُبِّ مِنْ إِحْسَاسِ غَانِيَةٍ","شَقرَاءُ ، سَابَقَنِي فِي وصلِهَا أجَلِي",15,"ل",2,0]]}