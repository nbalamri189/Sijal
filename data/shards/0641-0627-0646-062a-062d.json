{"poems":[[73,"أيا عالماً فاق الأنام بعلمه","https://www.aldiwan.net/poem3880.html","الطويل"],[32,"خليلي لا ربع بوهبين مخبر","https://www.aldiwan.net/poem29588.html","الطويل"],[85,"لعل الصبا إن صافحت روض نعمان","https://www.aldiwan.net/poem54236.html","الطويل"],[74,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[74,"عدمت محمدا أيام أرجو","https://www.aldiwan.net/poem18748.html","الوافر"],[53,"يا ابن بوران يا جعلت فدائي","https://www.aldiwan.net/poem7967.html","الخفيف"],[53,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[53,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[45,"عواذل ذات الخال في حواسد","https://www.aldiwan.net/poem9528.html","الطويل"],[22,"أرى العير تحدى بين قو وضارج","https://www.aldiwan.net/poem22003.html","الطويل"],[7,"دعاك الهوى واستجهلتك المنازل","https://www.aldiwan.net/poem1979.html","الطويل"],[48,"أجم رحيلي ما أجمت مواردي","https://www.aldiwan.net/poem23359.html","الطويل"],[48,"أفدت بهجران المطاعم صحة","https://www.aldiwan.net/poem23496.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42721","الطويل"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10140","الطويل"],[119,"الى سدة الغوث الرفاعي احمد","https://www.aldiwan.net/poem41131.html","عموديه"],[124,"فتى مزق الحب البرح قلبه","https://www.aldiwan.net/poem49299.html","الطويل"],[173,"أبت لك العزة القعساء والكرم","https://www.aldiwan.net/poem1674.html",""],[185,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[190,"في الزمن الفاسد لا تختلط","https://www.aldiwan.net/poem43808.html","السريع"],[234,"وزنجية الآباء كرخية الجلب","https://www.aldiwan.net/poem51235.html","الطويل"],[259,"كفى عنادا","https://www.aldiwan.net/poem36218.html","مجزوء الرمل"],[276,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[305,"لعمري ما خلفت إلا لما أرى","https://www.aldiwan.net/poem45449.html","الطويل"],[318,"بدا لك طال عنك اكتتامه","https://www.aldiwan.net/poem59484.html","الطويل"],[369,"شفته تحيات العيون العلائل","https://www.aldiwan.net/poem60810.html","الطويل"],[382,"ألا إحذر ملاقاة الرزايا","https://www.aldiwan.net/poem59170.html","الوافر"],[409,"إن كان من يبغضنا كارها","https://www.aldiwan.net/poem33906.html","السريع"],[445,"أخلق الدهر بقاء واستجد","https://www.aldiwan.net/poem34820.html","الرمل"],[475,"ألا نولي قبل الفراق قذور","https://www.aldiwan.net/poem4845.html","الطويل"],[520,"شكا ألم التوديع وهو أليم","https://www.aldiwan.net/poem12252.html","الطويل"],[521,"أراك طموح العين ميالة الهوى","https://www.aldiwan.net/poem48658.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87107","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48571","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37894","الطويل"],[967,"","https://poetry.dctabudhabi.ae/diwan/poem/33105","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62673","الطويل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216866","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59432","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56101","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64668","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64565","الطويل"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82330","الوافر"],[1460,"","https://poetry.dctabudhabi.ae/diwan/poem/1908","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79795","المتقارب"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113977","الخفيف"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49602","الوافر"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26532","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69336","المتقارب"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104760","البسيط"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104756","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110332","الخفيف"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104982","السريع"],[2376,"","https://poetry.dctabudhabi.ae/diwan/poem/115199","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65990","الطويل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104679","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202725",""],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/141718","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65153","البسيط"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142903","السريع"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20553","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103890","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205506","الوافر"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36794","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85249","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136055","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135776","الرجز"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88556","الوافر"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107505","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125875","البسيط"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106737","المتقارب"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/143308","الطويل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116026","الطويل"],[4679,"بذكراك لا ذكرى حبيبٍ ومنزلِ","https://www.poetsgate.com/ViewPoem.aspx?id=142719",""],[4726,"أيا رحمة الدارين والسيد الذي","https://www.poetsgate.com/ViewPoem.aspx?id=146651",""],[4767,"فداء","https://www.poetsgate.com/ViewPoem.aspx?id=87374",""],[4927,"زوجتي ختام الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29603",""],[4943,"القطرة الغيثية والوسيلة الالهية","https://www.poetsgate.com/ViewPoem.aspx?id=125974",""],[5111,"مَعَارِيجُ الرُّؤَى","https://www.poetsgate.com/ViewPoem.aspx?id=212631",""],[5277,"سرُّ المصون","https://www.poetsgate.com/ViewPoem.aspx?id=191106",""],[5320,"تقدم يا رخاء","https://www.poetsgate.com/ViewPoem.aspx?id=43108",""],[5688,"تركتِ العين تغمرها الدّموع","https://www.poetsgate.com/ViewPoem.aspx?id=204213",""],[5707,"الْمسك مِنْك ختام","https://www.poetsgate.com/ViewPoem.aspx?id=189188",""],[5957,"لماذا هجرت فؤادي وعيني ؟","https://www.poetsgate.com/ViewPoem.aspx?id=12043",""],[5309,"ذكرى ليالي الهوى العذري تصبينا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573536",""]],"verses":[["فَإِن تَحذِفِ الحَرفَ الَّذي هُوَ أَوَّلٌ","تُصادِف لَهُ عِشرينَ شبهاً بِجِسمِهِ",0,"م",2,0],["فَإِن تُحدِثِ الأَيَّامُ يا مَيُّ بَينَنا","فلَا ناشِرٌ سِرَّاً وَلا مُتَغيِّرُ",1,"ر",1,0],["فأنتَ حبيبُ الله خاتمُ رُسْلِهِ","وأكرمُ مخصوص بزلفى ورضوانِ",2,"ن",1,0],["فإن تحجب فلهجة كلّ راوٍ","وإن تظهر فنصب يد المشير",3,"ر",1,0],["فإن تحجب محاسنه بلحدٍ","ففي أفقِ السماءِ لها مسير",4,"ر",1,0],["فانتحتْ في الزنا تُكاثر حوا","ءَ عديدَ البنات والأبناءِ",5,"ا",2,0],["فانتحَى منك في عجانٍ كأنْ قد","خَطَّ فيه تلك الغضونَ مَخطُّ",6,"ط",1,0],["فإن تحتجز فالله جمٌّ عطاؤه","وإن تحتجب فالشمس جم طلوعها",7,"ع",3,0],["فَأَنتَ حُسامُ المُلكِ وَاللَهُ ضارِبٌ","وَأَنتَ لِواءُ الدينِ وَاللَهُ عاقِدُ",8,"د",1,0],["فَإِن تَحيَ لا أَملَل حَياتي وَإِن تَمُت","فَما في حَياةٍ بَعدَ مَوتِكَ طائِلُ",9,"ل",1,0],["فَإِن تَحيَ لا أَملَل حَياتي وَإِن تَمُت","فَما في حَياتي بَعدَ مَوتِكَ طائِلُ",10,"ل",1,0],["فَإِن تُحرَمي عَقلاً سَعِدتِ لِغَبطَةٍ","وَإِن تُرزَقيهِ فَهوَ مُبتَعَثُ الهَمِّ",11,"م",1,0],["فَإِن تَحكُمي بِالجَورِ فِيَّ وَفي أَبي","فَلَن تَحكُميهِ في بَناتي وَلا في اِبني",12,"ن",2,0],["فإن تحْكِ ثوْبَ الصِّلّ من بعدِ خَلعِه","فقد كان من فرْسانِها صِلُّ أصْلال",13,"ل",1,0],["فَأَنْتِ حِمَى قَوْمِي وَمَشْعَبُ أُسْرَتِي","وَمَلْعَبُ أَتْرَابِي وَمَجْرَى سَوَابِقِي",14,"ق",2,0],["فَإِن تَحمِلي رِدفَينِ لا أَلَّ فيهِما","فَسيري رُوَيداً لَستِ مِمَّن يُرادِفُ",15,"ف",1,1],["فان تحسب الاقطاب فهو امامهم","وان تعدد السادات فهو ابو اليد",16,"د",1,0],["فإن تحتطب يوماً تول ظلالها","وما إن يزيل الموت إلا الدياجيا",17,"ي",2,0],["فَأَنتَ حِصنٌ لَنا عالٍ نَلُوذُ بِهِ","إِن عَضَّنا الدَهرُ أَو زَلَّت بِنا القَدَمُ",18,"م",1,0],["فإن تَحمِلوا حِقدا عَلَىَّ فإِنَّنِى","لَعَذبِ المِياهِ نَحوَكُم لَشَرُوبُ",19,"ب",1,0],["فإن تحاماك وكانت له","أبهةٌ لا حظك الشزرا",20,"ر",2,0],["فأنتَ حسام الله أُرِهف حدُّه","فصال به جِدُّ الأمور على اللَّعِب",21,"ب",1,0],["فانتحرنا نحن سِرّاً","وبذا نرضي الأعادي",22,"د",2,0],["فأَنتَ حمانا مِنزَمان معاند","به ينكر المَعروف والدين يسلب",23,"ب",1,0],["فَإِن تَحسِما عِرقاً مِنَ الداءِ تَترُكا","إِلى جِنبِهِ عِرقاً مِنَ الداءِ ساقِيا",24,"ي",2,0],["فَأنتَ حِجَابُ القَلبِ عَن سِرِّ غَيبِهِ","وَلَولاكَ لَم يُطبَع عَلَيكَ خِتَامُهُ",25,"م",2,0],["فإن تُحْظِ من نُعماكَ قوماً شَفاعتي","فعُنوانُ عِزّ السّيفِ حَلْيُ الحَمائل",26,"ل",1,0],["فإن تحذر تجد يوماً سعيداً","يريك العمرَ آخرَه المنايا",27,"ا",3,0],["فأنت حسان الزمان الذي","قد ساد في المخبر والمنظر",28,"ر",1,0],["فانْتحى للكُفْرِ حَتَّى لَمْ يَجِدْ","واقتفى آثارَهُ حَتَّى هَمَدْ",29,"د",1,0],["فَإِن تَحُلِ الأَشغالُ دُون نَوالِكم","وَيَنأَى المَزارُ فَالفُؤادُ أَسيرُ",30,"ر",1,0],["فأنت حياة ليس من دونها غنى","وأنت حياً هام ونحن هشيم",31,"م",1,0],["فان تحملي ردفين لا اك مِنهُما","فَحُبّي فَرد لَست مِمَّن يُرادِف",32,"ف",1,0],["فَأَنتَ حَليف لِلمُروءة وَالوَفا","وَأَنتَ بإجماع الأَنام كَريم",33,"م",1,0],["فإن تحكم بظلم أو بعدل","فقد أرضاه حكمك وارتضيت",34,"ت",1,0],["فَإِن تَحْبُها مِنكَ القَبولَ فَما لَها","وَحَقِّك في غَيرِ القَبولِ مآربُ",35,"ب",1,0],["فَاِنتَحى دائِباً يُدَبِّلُ مِنها","قُلتُ إِنَّ الثَريدَ لِلتَدبيلِ",36,"ل",1,0],["فإن تحرق الأحشا مصيبةُ مُصطفى","فمنا ومنكم من تفوق مراتبُهْ",37,"ب",2,0],["فانْتَحَى مثل ما انْتَحَى بَازُ دَجْنٍ","جَوَّعَتْه القُنّاصُ للدُّرّاجِ",38,"ج",1,0],["فأنت حبيب الله والشافع الذي","نعدك ذخرا يوم عرض المآثم",39,"م",1,0],["فانتحى نحو نجدتي رب فضلٍ","سيد في المقام أضحى نبيلا",40,"ل",2,0],["فإنْ تَحْمني أدْنى الوِصالِ فَطالَما","دُعيتُ لأَقْصاهُ ولَمْ يُدْعَ جُنْدَبُ",41,"ب",1,0],["فان تحققها امل شمالا","بلامه وشعر الكمالا",42,"ل",2,0],["فأنت حسيب فوقهم ورقيبهم","شهيد على من ضل منهم وأبطلا",43,"ل",2,0],["فَإِن تُحدِث لَكَ الأَيّامُ سُقماً","يَحولُ جَريضُهُ دونَ القَريضِ",44,"ض",1,0],["فَإِن تَحسَبوها بِالحِجابِ ذَليلَةً","فَما أَنا يَوماً إِن رَكِبتُ ذَليلُ",45,"ل",1,0],["فأنتِ حديقةُ أُنس به","وأخلاقُهُ روضُكِ الناظر",46,"ر",1,0],["فانَتَحَت من رُبى ذي الأوتادِ نجدَي","لَ لمَرعى قصارِها والطوالِ",47,"ل",1,0],["فإن تُحْرِزْ طليطلةَ الليالي","فَسَيْفُكَ يا عليُّ بها ضَمِين",48,"ن",1,0],["فَإِن تَحفَظ أَزِدكَ وَإِن تُضِعهُ","فَإِنّي لا أَحولُ وَلا أَخونُ",49,"ن",1,0],["فَإِن تُحصِها تَلقَ مَعروقَهُ","يَزيدُ المِثالُ عَلى ذِي وَذا",50,"ا",1,0],["فأَنتَ حُزتَ ثَوباً لَيسَ يَحصُرُهُ","غيرُ الَّذِى عَوَّقَ العُشَّاقَ عَن وَطَنِ",51,"ن",1,0],["فأَنتَ حَبِلَى نِعمَ الحَبلُ يا سَبَبى","أَحبابِى فِى اللهِ قَرِّبهُم إِلَيكَ نَبِى",52,"ب",2,0],["فانتحلت القريض من نفح ريا","ها ومن شدوِ طيرها الغريد",53,"د",1,0],["فأنت حصنٌ للهدى شاهق","عاش بك الناس بظلّ ظليل",54,"ل",1,0],["فأنتَ حليمٌ تزجر الناس عن هوى","نفوسهم جهلاً وحلمُكَ عازب",55,"ب",1,0],["فأنت حقيق أن تقوم بثاره","كما أنه حقاً لمثلك عادم",56,"م",1,0],["فأنت حصنٌ لها من كل نائبٍة","وأنت من محنِ الدارين كافيها",57,"ي",3,0],["فإن تحرمني اللقيا","بماذا سوف تعتذر",58,"ر",1,0],["فَإِن تَحرّر مِن أَبناء بجدَتِهِ","يَظَلّ عَبداً لِمَن يَهوى وَيَفتَكِرُ",59,"ر",1,0],["فأنت حليٌ بجيد الدّهر مُنتظمٌ","به وأنت له سمعٌ وأبصارُ",60,"ر",1,0],["فأنت حقا مثل أعلى","حتى ولو في نظرة عجلى",61,"ا",1,0],["فإِن تَحبِسوني تَحبِسوا ذا وَليدَةٍ","وإِن تُطلِقوني تُطلِقوا أَسَداً وَردا",62,"د",2,1],["فإن تحرقوا القرطاس لا تحرقوا الذي","تضمنه القرطاس بل هو في صدري",63,"ر",2,1],["فإن تحمَدْ وسامتَهَا صباحًا","فقد تنعى دمامتَهَا مساءَ",64,"ا",2,0],["فَإِن تَحلُ مِنكَ العَينُ حَقّاً شَهِدتَهُ","وَأَيقَنتَ أَنّ الرَمزَ مِنهُ صَريحُ",65,"ح",1,0],["فأنت حسام الدين واللَه ضارب","بجدك هامات الضلالات والكفر",66,"ر",1,0],["فإن تحقَّقْت العطا والمنَعَا","من ربِّنا إن شئت سل أو فدعا",67,"ع",2,0],["فأنت حسبنا من الذي ظهرْ","وما خفي وغائ