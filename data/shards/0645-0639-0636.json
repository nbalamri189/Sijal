{"poems":[[194,"وان يعمهُم حياً مطبقُ","https://www.aldiwan.net/poem1158.html",""],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65988","الرجز"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138781",""],[5055,"كل السحايب","https://www.poetsgate.com/ViewPoem.aspx?id=104295",""],[6056,"جرح السنين","https://www.poetsgate.com/ViewPoem.aspx?id=130356",""],[6102,"مفعول عكسي !!","https://www.poetsgate.com/ViewPoem.aspx?id=185062",""]],"verses":[["مُعَضِّلاً بِها البَلاطُ الاَخوَقُ","كُلًّ طِمَرٍّ لَحمُهُ مُمَشَّقُ",0,"ق",1,0],["معضل راع هاشماً بعدما أن","أعيت الدهر أن يراع حماها",1,"ا",3,0],["مع ضعفه وأنفه المرغم","وخلقه وخلقه المذمم",2,"م",1,0],["معضلٌ هُدَّ به ركنُ الهدى","وَوَرت في مُهجة الإيمان نار",3,"ر",1,0],["مع ضربة الأبراج خطيت برجا","فنجان وخطوط الرمل منك راجي",4,"ج",2,0],["معضلة مادام،من كل النواحي مربكين","مربكين وعارفين الوضع مااحد ٍ يجهله",5,"ل",2,0],["مُعضِلَتي بِنتٌ أَعشَقُها","بِهَواها قَد زادَ نُحولِي",6,"ل",2,0]]}