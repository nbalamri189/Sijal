{"poems":[[53,"أحدث الصفع في دماغ أبي أحمق","https://www.aldiwan.net/poem65006.html","الخفيف"],[53,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[53,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[53,"يا قاتل السنور والديك","https://www.aldiwan.net/poem65828.html","الطويل"],[53,"قذفك بالفحشاء من لم يكن","https://www.aldiwan.net/poem65969.html","السريع"],[30,"لقد علمت وعلم المرء أصدقه","https://www.aldiwan.net/poem5094.html","البسيط"],[69,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[50,"فاضت دموعك ساكبه","https://www.aldiwan.net/poem62443.html","مجزوء الكامل"],[50,"إن في المكتب خشفا","https://www.aldiwan.net/poem66185.html","مجزوء الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[119,"هذا كتاب منزل وزبور","https://www.aldiwan.net/poem41746.html","الكامل"],[164,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[193,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[230,"أي صوت حيته بالأمس باريس","https://www.aldiwan.net/poem55196.html","الخفيف"],[234,"كأن الراي حين أتى طريا","https://www.aldiwan.net/poem50900.html","الوافر"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[353,"سطرها المملوك وهو أضرمد","https://www.aldiwan.net/poem20076.html","الرجز"],[369,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[371,"لست من صدي ولا رشدي","https://www.aldiwan.net/poem16978.html","المديد"],[382,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[385,"أيها المعرض الذي قد جفاني","https://www.aldiwan.net/poem48750.html","الخفيف"],[409,"حدث البارق عن صنعا وعن","https://www.aldiwan.net/poem33394.html","الرمل"],[422,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[422,"سكب الدمع لها فانسكبا","https://www.aldiwan.net/poem54052.html","الرمل"],[435,"جاء يثني عطفه الميد","https://www.aldiwan.net/poem40065.html","المديد"],[449,"يا جنان الشام يا ذات البها","https://www.aldiwan.net/poem56030.html","عموديه"],[454,"اللغة العربية","https://www.aldiwan.net/poem969.html","عموديه"],[454,"شارون عربد","https://www.aldiwan.net/poem991.html",""],[454,"رّدي علي سؤال كل خطاب","https://www.aldiwan.net/poem1002.html",""],[470,"على سناك سلام الله","https://www.aldiwan.net/poem36230.html","عموديه"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38768","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38325","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77630","الرجز"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124612","الكامل"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138063","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56338","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136171","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112802","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79862","الخفيف"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203760","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113963","البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66287","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124723","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27383","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27740","الرمل"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111149","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93674","الخفيف"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102510","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93946","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109822","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199959",""],[3283,"","https://poetry.dctabudhabi.ae/diwan/poem/26604","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216797",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131260",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111441","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107539","الخفيف"],[4175,"","https://poetry.dctabudhabi.ae/diwan/poem/145983","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90843","الرمل"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143022","الخفيف"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147290","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72551","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72780","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72488","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72637","الرمل"],[4701,"ثلاثون عامًا تمرُّ الظباءْ","https://www.poetsgate.com/ViewPoem.aspx?id=45009",""],[4858,"أمّي من غير زيفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=138779",""],[4908,"عدْ يا ضنايَ","https://www.poetsgate.com/ViewPoem.aspx?id=207337",""],[4921,"بك أستجير فمن يجير سواكا","https://www.poetsgate.com/ViewPoem.aspx?id=3652",""],[4935,"بلسان الشكر نهدي","https://www.poetsgate.com/ViewPoem.aspx?id=129345",""],[4978,"تشعير قطعة لأخناتون","https://www.poetsgate.com/ViewPoem.aspx?id=183244",""],[4981,"وقفة مع الآخرة","https://www.poetsgate.com/ViewPoem.aspx?id=190507",""],[4994,"من قباب الجرح معراجي","https://www.poetsgate.com/ViewPoem.aspx?id=210700",""],[5145,"رجعت صبوته إن خطرا","https://www.poetsgate.com/ViewPoem.aspx?id=108110",""],[5318,"هيَ حُسنيان","https://www.poetsgate.com/ViewPoem.aspx?id=215393",""],[592,"يا طالب العلم الشريف الأقوم","https://www.poetsgate.com/ViewPoem.aspx?id=128811",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5376,"احزمْ متاعَك أيها الرجلُ","https://www.poetsgate.com/ViewPoem.aspx?id=198998",""],[5409,"لم تنجب الأيام إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155495",""],[5411,"في الْقَلْبِ مُتَّسَعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=194859",""],[5431,"ولكَم يُظلم النبيل الأصيلُ...","https://www.poetsgate.com/ViewPoem.aspx?id=196635",""],[5566,"ماض أنا","https://www.poetsgate.com/ViewPoem.aspx?id=192931",""],[5566,"ماض أنا","https://www.poetsgate.com/ViewPoem.aspx?id=194104",""],[5829,"الحب لا يرحم","https://www.poetsgate.com/ViewPoem.aspx?id=152719",""],[5864,"يا أبي","https://www.poetsgate.com/ViewPoem.aspx?id=190488",""],[5906,"غبار أمّة","https://www.poetsgate.com/ViewPoem.aspx?id=188911",""],[5943,"شفاء","https://www.poetsgate.com/ViewPoem.aspx?id=61781",""],[6102,"شَظايا خَزَف ..","https://www.poetsgate.com/ViewPoem.aspx?id=184420",""],[6127,"قد يَصدُقُ السيف!","https://www.poetsgate.com/ViewPoem.aspx?id=188485",""]],"verses":[["بل سُلاحاً فيه الأجنَّةُ والأغ","راسُ تَحكي أمشاجُهُنَّ المخاطا",0,"ط",2,0],["بل سيداً قرنت بالحلم حفظته","فلم تفز قط إلا كان ميقافا",1,"ف",2,0],["بل سبوقا إلى البعيد من الغا","ياتِ عند الجراء لا مسبوقا",2,"ق",2,0],["بل سهمُ تركيٍّ له فضلةٌ","يرمي به بعض التنابيك",3,"ك",1,0],["بل سوءةٌ غابتْ فأحضرتَها","جهلاً وغرَّتك الأباطيلُ",4,"ل",1,0],["بَل سَوفَ يَكفيكَها بازٍ تَغَلَّبَها","لَهُ اِلتَقَت بِالسُعودِ الشَمسُ وَالقَمَرُ",5,"ر",1,0],["بِلِسان عربيٍّ بَليغٍ","أفْحَمَ العُرْبَ فعَيَّتْ جوابا",6,"ب",2,0],["بِلِسانِها وَزَعيمِها","عِندَ الأُمورِ الحازِبَه",7,"ب",2,0],["بِلِسانٍ فَتَراهُ ال","دَهرَ قَد سَوَّدَ فاهُ",8,"ا",2,0],["بَل سَرَّني فيكَ رَبّي","وَساءَني فَحَمِدتُه",9,"ت",2,0],["بلسان حال للخليفة كلها","يدعو وكل حامد وشكور",10,"ر",1,0],["بل سد عن مزمر الراعي مسامعه","صونا لها ولنا عن هذه اللعب",11,"ب",1,0],["بَل سؤتَ بالإفكِ ممّا قد أتيت بهِ","خيرَ الأنامِ وكل المؤمنين بهِ",12,"ب",2,0],["بِلِسانٍ ما اعتادَ من قبلُ أن يخ","ضعَ إِلّا لِأَهلهِ من إباءِ",13,"ا",2,0],["بلسقيات بلّور لطاف","بِأَسْفَلِها بقايا من رحيقِ",14,"ق",1,0],["بِلِسانِهِ نَزلَ القُرانُ وَفي بَني","سَعدٍ نَشأتهُ مَعَ الحضّانِ",15,"ن",1,0],["بَلْ سَئِمُوا السُّخْرَةَ لا كاغِدَةٌ","فِيها من الوَرّاقِ مَا يُنْتَقَدُ",16,"د",1,0],["بلسانٍ إذا جَرى ذي بيانٍ","يَرقُبُ الخَلْقُ وعْدَه والوعيدا",17,"د",2,0],["بِلِساني لَستَ تَملِكُني","وَيَدي لَم تَعلُها بِيَدِ",18,"د",1,0],["بل ساء ظنّاً شامخاً متكبِّراً","متعجرفاً متصلف الأرحام",19,"م",1,0],["بِلِسان مِن الدُموع فَصيح","أَرسَلتُهُ عَينان نَضّاخَتان",20,"ن",1,0],["بل سل الأقطاب مثل المرتضى","وبنيه من حسين وحسن",21,"ن",1,0],["بلسانٍ كانَ بقراط النهى","عِلَلَ النَّفْس بذاك الوعظ أبرا",22,"ر",2,0],["بلسان يفصِلُ الأَمر به","كشبا الصَّمصام أو أمضى شبا",23,"ب",2,0],["بل سما مجداً وطاب ثناً","ولهُ في الجود نعم يدُ",24,"د",1,0],["بل سماء زينها النيرات","وهي سبع مثل هاتيك تدور",25,"ر",1,0],["بلسان عربي، نبعه","ما الفرات العذب أو ما بردى",26,"د",2,0],["بل سوف تنعتهم بما هي أهله","(الإرهاب) أما أنت فابن حفيدها",27,"د",3,0],["بل سيد الأمراء غير منازع","لم يخش من حرس ولا حجاب",28,"ب",1,0],["بَل سَوَّغُوا كلَّ ما يَندى الجَبينُ لَهُ","حتى لقد ماتَ فينا الصِّدقُ والشَّرَفُ!",29,"ف",1,0],["بل سبق الأشياء فابتداها","خلقا كما أراد إذ براها",30,"ه",2,0],["بَل سورُها الأَعظَمُ العالي على أَطمٍ","صيت الهِزَبرِ عَليّ القدرِ وَالرّتَبِ",31,"ب",1,0],["بِلِسانِها تَبدو الحتو","فُ وفي الظُّبى تبدو الحُتوف",32,"ف",1,0],["بَل سَأَل الطَبيب تِلكَ المَسأَلَه","وَمَكَثا يَومين في المُجادَلَه",33,"ه",1,0],["بل سلما للمشتري نفسيهما","وتفانيا في الحب أي تفان",34,"ن",1,0],["بَلْ سائِرُ الشُّرُوطِ مَهْما تَحْصَلُ","مِنْ غَيْرِ مانِعٍ هُناكَ تُفْعَلُ",35,"ل",1,0],["بل سدت في الكل واستعليت عن خللٍ","فبات كل أخي فهم لديك غبي",36,"ب",2,0],["بلسان التعرف المعهود","بين أهل الوجدان وأهل الجمود",37,"د",1,1],["بل سعدها ورشادها وسدادها","في ذاك فاسعفها منحت جوارا",38,"ر",2,0],["بلسانٍ يُريه نَضنَضَةَ الصلِّ","فَيُغضي كيلا يُساورُ صِلاّ",39,"ل",2,0],["بلسان من التلاوة رطبٍ","وهو بالصوم يابس غير رطب",40,"ب",1,0],["بَل سلِّ همِّكَ إذ شطَّت بدَوسَرَةٍ","مثلِ الفنيقِ يُسامي رأسُها الأُفُقا",41,"ق",2,0],["بل سمعنا مقاله إن أولى","فتن العالمين هنّ النساء",42,"ا",2,0],["بلسانها نادى المؤرخ","لي حضور في الجنان",43,"ن",1,0],["بلسعه بين الورى مقبلاً","ومدبراً أنيابه تلمعُ",44,"ع",1,0],["بلسانِ شخصٍ صادقٍ من رسْله","صلُّوا عليه وسلِّموا تسليما",45,"م",2,0],["بلسانٍ ومقالٍ واضحٍ","ورقومٍ بيراعٍ وبنان",46,"ن",1,0],["بل سجود على العلوم ففيها","أصبح اللَه للورى معبودا",47,"د",2,0],["بَل سَرى عشقك المَساعي إِلَيها","وَخَفيف مَن يَقصد المَعشوقا",48,"ق",2,0],["بل سمعت النداء في الذرات","يوم قلتم ألست في النسمات",49,"ت",1,0],["بلسان يعطي الحلاوة لكن","هو مني أردافه رواغه",50,"غ",2,0],["بلسان يجري على عنق الظل","م حساماً وفي فم العدل قطرا",51,"ر",2,0],["بلسان اللظى تناديني","بل تحيي لذا أحييها",52,"ي",3,0],["بلسان لقمان بن عا","دٍ وفصل خطبته الحكيمه",53,"م",2,0],["بل سل الأقدار إن نطقت","ما حياة شأوُها بدن",54,"ن",1,0],["بلسانه يسطو على أسد الوغى","والذم يظهر عجزه المكتوما",55,"م",2,0],["بَل سارَ يَبرَحُ مَتَنَ مَركَبَةٍ زَهَت","بِنَحاسِها لِموَاقِعِ الإِجراءِ",56,"ا",2,0],["بَل سَعى يَجرِي إِلى الإسكندَرِ","حَيثُ وافاهُ بِقَصرٍ أَزهَرِ",57,"ر",1,0],["بَل سَوفَ نُلوى شَتاتاً تاركينَ لَهُم","جُنداً تُمَزِّقُها نيرانُ كَيدِهِمِ",58,"م",1,0],["بل سأحيا للانتقام فإِن","أَقتلهُ يغدُ الحِمامُ أعذبَ مطعم",59,"م",1,0],["بلسان من لهيب لاذعٍ","ببيان كبيان النابغين",60,"ن",1,0],["بلسان قام بالصدق الذي","جاء عن تقوى جنان عامر",61,"ر",1,0],["بل سقاه ندى الوزير فجدوى","راحتيه أهنا وأجدى وأندى",62,"د",2,0],["بلسم الروح سيأتي ربما","عندما ترسو بمينائي الجَواري",63,"ر",2,0],["بل سرَّ حكمة عين علم غامض","في لحده هو والعلا ملحود",64,"د",1,0],["بل سما قدره المديح فكاد","المدح فيه بأن يكون احتقارا",65,"ر",2,0],["بلسانه النضاح في بلسانه","قد راح يجبر قلبي المكسورا",66,"ر",2,0],["بلسان الحال قالت اعيني","إن هذا عارض ممطرنا",67,"ن",2,0],["بلسعة أولِ موجة بحرٍ","بأول تنهيدة للنساء",68,"ا",2,0],["بلسان الحمد والشّكر لنعم","ى الله تبني نشأها والحمدُ غُنمُ",69,"م",1,0],["بَلسِم (جهادَ)...الشوقُ أثخنَ قلبَهُ","يا من لجرحِ الشوقِ كنتَ البلسما",70,"م",2,0],["بل سائل اللبن المصفى كان بين","دم وفرث من الذي صفاكا؟",71,"ك",2,0],["بلسان ا