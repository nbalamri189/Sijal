{"poems":[[53,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[563,"غني به عبد الغني فيبلغ","https://www.aldiwan.net/poem34363.html","الطويل"],[580,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112836","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112816","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113999","الطويل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114032","الوافر"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36752","الرجز"],[5431,"لهذا القلب قد أودعتُ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=185436",""]],"verses":[["بَهَظُوا الأرض بالكنوز وقد أض","حوا وما يملكون من هَلْبسيس",0,"س",1,0],["به ظلمة نور ونور وظلمة","ومبلغه ما مثله قط مبلغ",1,"غ",1,0],["به ظَهَرَتْ في الحالِ منِّي زيادتي","ومذ بان عَنِّي بان للحَالِ نُقْصَاني",2,"ن",2,0],["به ظفروا واستمسكوا بالذي له","من اللَه أوحى فاهتدوا مسلك الحزم",3,"م",1,0],["به ظهر العرفان وهو وسيلة الكرام","ومصباح فيا فوز من شكر",4,"ر",1,0],["به ظلعانٌ ومن يجد","كوجدِيَّ لا يلوي على الظلعانِ",5,"ن",1,0],["به ظَهَرت تباشيرُ التَّهاني","وَفيهِ قد تجمَّعَت الخُيُورُ",6,"ر",1,0],["بِهِ ظَمَأ مُبرِّح","إِلى اِرتِشاف الضَربِ",7,"ب",1,0],["به ظِلَلٌ من الجّناتِ ترقى","بفعلِ الخير موفور السخاء",8,"ا",2,0]]}