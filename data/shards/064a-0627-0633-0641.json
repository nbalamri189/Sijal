{"poems":[[102,"روح شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50166",""],[203,"كان ذاك الصديق فيما رأينا","https://www.aldiwan.net/poem45199.html","الخفيف"],[302,"دع الندامة لا يذهب بك الندم","https://www.aldiwan.net/poem33172.html","البسيط"],[369,"هبني أقصر بالخطا","https://www.aldiwan.net/poem60794.html","مجزوء الكامل"],[484,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[567,"حزن القلوب على الغريب غريب","https://www.aldiwan.net/poem52792.html","الكامل"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216637",""],[2100,"","https://poetry.dctabudhabi.ae/diwan/poem/34955","الرمل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102683","المواليا"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/199183","المواليا"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109826","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203032","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134197","الرمل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87450","البسيط"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128942","الرجز"],[4858,"سفرة وشعر","https://www.poetsgate.com/ViewPoem.aspx?id=155076",""],[5106,"فَتْفُوتَةً قَدْ حَوَتْ حُسْنَاً مِنَ الكَسَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=137199",""],[5187,"من وحي الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=29701",""],[5212,"مولِدُ التأريخ","https://www.poetsgate.com/ViewPoem.aspx?id=212078",""],[5686,"لو ماتت الأشجار ما مات الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=203365",""],[5732,"يامشرف المرقاب","https://www.poetsgate.com/ViewPoem.aspx?id=177886",""],[6355,"قاطرة من ورق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66555&r=&rc=15",""]],"verses":[["يا سفير التضامن الحر غنّت","سعيك الحر أمنياتي الشواعر",0,"ر",1,0],["يا سفيهَ اللسانِ إن أنتَ لم تس","تحِ مني ففي لساني حياءُ",1,"ا",2,0],["يا سفرةً أَسفرت عن كُلِّ بائقةٍ","لا أَنتجت بعدكَ المهريَّةُ الرُسُمُ",2,"م",1,0],["يا سفرةَ الدَّركاةِ جا","دَكِ وابلٌ واهي العَزالي",3,"ل",2,0],["يا سفر سيفر وإن خطوك بالذهب","السيف أصدق أنباء من الكتب",4,"ب",1,1],["يا سَفرةً بَعُدتْ مَسافةُ دارِها","عنَّا وأمَّا يومُها فقريبُ",5,"ب",1,0],["يَا سفر فِيْ ليْلي الحالك","روف بِيْ لا يخدعك ضنك",6,"ك",1,0],["يَأسَفُ المَرءُ عَلى ما فاتَهُ","مِن لباناتٍ إِذا لَم يقضِها",7,"ض",3,1],["يا سفح عيديد يا مأوى الدما الكنس","الساجيات العيون الفتر النعس",8,"س",1,0],["يا سفح عيديد يا مأوى الملاح الحور","الفاتنات الورى الباهيات النور",8,"ر",1,0],["يا سفح قيسون لو كان لكْ عُرى شلناك","على البخاتي وما رحنا وخليناك",9,"ك",1,1],["يا سفح لبنان افتخر مترفعاً","فلقد حويت اجل منه وارفعا",10,"ع",2,0],["يا سفح بقّين وما تلقى به","عين الملاحظ من جمال المشهد",11,"د",1,1],["ياسفين الجفن بالطفوان نو","حي فلم يبق امرؤ إلا وأن",12,"ن",1,0],["يا سفحَ لبنانَ ان قَلبي","جارُكَ وَالجارُ لا يَجور",13,"ر",1,1],["يأسف مما ناله","وناره مستعره",14,"ر",2,0],["يا سفرةً وظلامُ الهمِّ يغشاها","لكنْ برحمة ربّي طاب مَرساها",15,"ا",3,1],["يَا سِفْرَ حُلْمِيْ وَإِمكَانِي وَيَا زَمِنِي","وَيَا جَزَائِي مِنَ الأَسْفَارِ وَالرَّحَلِ",16,"ل",1,0],["يا سفحَ الوادي عانقنا","وامنحنا الحسَّ ورَيّاهُ",17,"ا",2,0],["يا سَفيرَ العِشقِ هَبني","قُربَكُمْ بَعدَ المَنونْ",18,"ن",1,0],["يا سفر ذاكرتي التي لونتها","ألوانها فرس الضياء ِ تجددا",19,"د",2,0],["ياسفلي اللي للهواء مايعرفون","(يانمر) شلاني من الدمع غرقا",20,"ق",2,0],["يا سفيناً لعبَ الموجُ بها","ثم أهداها إلى قالٍ وقيلْ",21,"ل",1,1]]}