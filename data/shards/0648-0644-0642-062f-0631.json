لكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[586,"ما كنت أندب رامة وطويلعا","https://www.aldiwan.net/poem17588.html","الكامل"]],"verses":[["وَلَقَد رَأَيتُ بَديرِ هِندٍ مَنزِلاً","أَلِماً مِنَ الضَرّاءِ وَالحِدثانِ",0,"ن",1,0],["وَلَقَد رَتَقتُ عَلى العَذولِ مَسامِعي","وَصَمَمتُ عَن عَذلٍ وَعَن تَعنيفِ",1,"ف",1,0],["وَلَقَد رَمَيتُ ضَميرَهُ مِن خَشيَتي","بِأَحَدَّ مِن طَرَفِ السِنانِ وَأَعقَرِ",2,"ر",1,0],["وَلَقَد رَأَيتُهُم وَحَيُّهُمُ","مُتَقَعقِعُ الأَطنابِ وَالعَمدِ",3,"د",1,0],["وَلَقد رَأَيتُ مَعاشِراً","قَد جَمَّعوا مالاً وَوُلدا",4,"د",2,0],["وَلَقَد رَفَعتُ لَها الرِداءَ مُوَدِّعاً","بَعدَ البُكاءِ وَبَعدَ طولِ المَوقِفِ",5,"ف",1,0],["ولقدْ روعِيَتْ لدَيْهِ حُقوقٌ","أقْطَعَتْها العِدَى جَنابَ اطِّراحِ",6,"ح",1,0],["ولقد رأيتُ وما رأيت كحسنها","وجهاً أغرَّ ومبسماً وضَّاحا",7,"ح",2,0],["ولقد راعني وزاد فؤادي","ولها ما رأيت تحت المانه",8,"ن",2,0],["وَلَقَد رَمَينَكَ حينَ رُحنَ بِأَعيُنٍ","يَنظُرنَ مِن خَلَلِ السُتورِ سَواجي",9,"ج",2,0],["وَلَقَد رَأَيتُكَ وَالقَناةُ قَويمَةٌ","إِذ لَم يَشِب لَكَ مِسحَلٌ وَعِذارُ",10,"ر",1,0],["وَلَقَد رَحَلتُ إِلَيكُمُ عيدِيَّةً","لا يَرعَوينَ إِلى جَنينٍ مُجهَضِ",11,"ض",1,1],["وَلَقَد رَأَيتُكِ في العَذارى مَرَّةً","وَرَأَيتِ رَأسي وَهوَ داجٍ أَفرَعُ",12,"ع",1,0],["وَلَقَد رَأَيتُ وَلَيسَ شَيءُ باقِياً","يَوماً ظَعائِنَ سَلوَةٍ وَنَعيمِ",13,"م",1,0],["وَلَقَد رَأى صُبحٌ سَوادَ خَليلِهِ","مِن بَينِ قائِمِ سَيفِهِ وَالمِحمَلِ",14,"ل",1,0],["وَلَقَد رَأَيتُ النارَ تَن","تَهِبُ المَنازِلَ وَالقُصورا",15,"ر",2,0],["وَلَقَد رَأَيتُ السَبيَ يُج","لَبُ نَحوَنا حُوّاً وَحورا",15,"ر",2,0],["وَلَقَد رَعَيتُ فَلَيتَ شِعري مَن رَعى","مِنكُم عَلى بُعدِ الدِيارِ إِخائي",16,"ي",1,0],["وَلَقَد رَأَيتُ بِها الحُلولِ يَزينُهُم","بيضُ الوُجوهِ ثَواقِبُ الأَحسابِ",17,"ب",1,0],["ولقد رَعَيْتَ الخِصبَ قبلي برهةً","ورعيتُ من مرعى المعاشِ جديبَهُ",18,"ب",2,0],["ولقد رأيتُك والياً مُستعلياً","ولقد رأيتك في الحديد مُقَيَّدا",19,"د",2,1],["ولقد رأى كلَّ الرياح معاشر","في الوفْر يُهْدَمُ والثناءُ يشادُ",20,"د",1,0],["ولقد رام أن يكون نديداً","فأبى الله أن يكون نديدَكْ",21,"ك",1,0],["ولقد رأيت معاشراً جمحتْ بهم","تلك الطبيعة نحو كل تَبارِ",22,"ر",1,0],["ولقد رمتْه يومَ ذلك قِدْرُهُم","بغُطامطٍ من غَليهما وغُطامِط",23,"ط",1,0],["ولقد ركبْتَ إليه كُلَّ مخوفةٍ","لو زلَّ راكبُها لطاحَ قتيلا",24,"ل",2,0],["ولقد ردعتُ الشعرَ عنك تنزُّهاً","إذ لامني في شتمك الأقوامُ",25,"م",1,0],["ولقد رأيتُ من الرجال معاشراً","ثَقُلت رؤوسهمُ بلا تيجان",26,"ن",1,0],["وَلَقَد رَهَنتُ يَدي المَنِيَّةَ مُعلِماً","وَحَمَلتُ عِندَ تَواكُلِ الحُمّالِ",27,"ل",1,0],["وَلَقَد رَكِبتُ البَحرَ يَزأَرُ هائِجاً","كَاللَيثِ فارَقَ شِبلَهُ بَل أَحنَقا",28,"ق",2,0],["وَلَقَد رَجَوتُ لَهُ البَقاءَ وَإِنَّما","يَدنو الحَمامُ لِمَن يُحِبُّ لَهُ البَقا",29,"ق",2,0],["وَلَقَد رَأَيتُكِ في النِقا","بِ وَذاكَ عُنوانُ الكِتابِ",30,"ب",1,0],["وَلَقَد رَحَلتُ وَإِنَّني","بِالفَضلِ مَنشورُ اللِواءِ",31,"ا",2,0],["وَلَقَد رَأَيتُ مِنَ العَجائِبِ ما كَفى","فَإِذا الَّذي مَنَّيتَ نَفسَكَ أَعجَبُ",32,"ب",1,0],["ولقد راعني رزايا توالت","والرزايا إذا توالت تروع",33,"ع",1,0],["ولقد راعني باخر عهد","منك في زورتي الجبين المقطب",34,"ب",1,0],["وَلَقَد رامَكَ العُداةُ كَما را","مَ فَلَم يَجرَحوا لِشَخصِكَ ظِلّا",35,"ل",2,0],["وَلَقَد رُمتَ بِالسَعادَةِ بَعضاً","مِن نُفوسِ العِدا فَأَدرَكتَ كُلّاً",35,"ل",2,0],["وَلَقَد رَأَيتُ الحادِثاتِ فَلا أَرى","يَقَقاً يُميتُ وَلا سَواداً يَعصِمُ",36,"م",1,0],["ولقد رأيتُ الدهرَ في أفعالهِ","مستعجلاً وتخالُه متمهِّلا",37,"ل",2,0],["وَلَقَد رابَني مِنَ اللَومِ إِصغا","ئي إِلَيهِ وَأَعهَدُ اللَومَ يُغري",38,"ي",1,0],["وَلَقَد رابَني اِبنُ عَمّي","بَعدَ لينٍ مِن جانِبَيهِ وَأُنسِ",39,"س",1,0],["وَلَقَد رَكِبتُ البَحرَ في أَمواجِهِ","وَرَكِبتُ هَولَ اللَيلِ في بَيّاسِ",40,"س",1,0],["وَلَقَد رَأَيتُ وَقَد سَمِعتُ بِمَن مَضى","فَإِذا زُرَيقٌ سَيِّدُ السُوّاسِ",40,"س",1,0],["وَلَقَد رَجَعتُ إِلَيكَ بَعدَ مِلاوَةٍ","فَقَبَلتُ رَجعَةَ وامِقٍ مُستاسِ",40,"س",1,0],["وَلَقَد رَدَدتَ النائِباتِ ذَميمَةً","وَفَسَحتَ مِن كَنفِ الزَمانِ الضَيِّقِ",41,"ق",1,0],["وَلَقَد رَدَدتَ عَلى الأَنامِ عَقولَهُم","بِهَلاكِ سُلطانِ الرَكيكِ الأَحمَقِ",41,"ق",1,0],["وَلَقَد رَضيتُ بِها طَبيباً حاذِقاً","يَشفي الجَوانِحَ مِن جَوىً وَغِلالِ",42,"ل",1,0],["وَلَقَد رَأَيتَ البيضَ تَأخُذُ دِرعَهُ","فَذَكَرتُ عِرضَ مُحَمَّدِ بنِ الهَيثَمِ",43,"م",1,0],["وَلَقَد رَجَعتَ وَإِنَّ فارِسَ كُلَّها","مِن كُردِها لَخَوائِفُ المُرّارِ",44,"ر",1,0],["وَلَقَد رَمَيتِ إِلَيَّ رَميَةَ قاتِلٍ","مِن مُقلَتَيكِ وَعارِضَيكِ بِأَسهُمِ",45,"م",1,0],["وَلَقَد رَأَيتُكِ في المَنامِ ضَجيعَتي","وَلَثَمتُ مِن شَفَتَيكِ أَطيَبَ مَلثَمِ",46,"م",1,0],["وَلَقَد رَأَيتُكَ لِلزَمانِ مُجَرِّباً","لَو كانَ يُحكِمُ رَأيَكَ التَجريبُ",47,"ب",1,0],["وَلَقَد رَأَيتُ المَوتَ يَفرِسُ تارَةً","جُثَثَ المُلوكِ وَتارَةً يَتَخَبَّطُ",48,"ط",1,0],["وَلَقَد رَأَيتُ المَوتَ يَبرُقُ سَيفُهُ","بِيَدِ المَنِيَّةِ حَيثُ كُنتُ حِيالي",49,"ل",2,0],["وَلَقَد رَأَيتُ عُرى الحَياةِ تَخَرَّمَت","وَلَقَد تَصَدّى الوارِثونَ لِمالي",49,"ل",2,0],["وَلَقَد رَأَيتُ عَلى الفَناءِ أَدِلَّةً","فيما تَنَكَّرَ مِن تَصَرُّفِ حالي",49,"ل",2,0],["وَلَقَد رَأَوا غيلانَ رَي","بِ الدَهرِ غولاً بَعدَ غولِ",50,"ل",1,0],["وَلَقَد رَأَيتُ الحادِثاتِ مُلِحَّةً","تَنعى المُنى وَتُقَرِّبُ الآجالا",51,"ل",2,0],["وَلَقَد رَأَيتُ مَساكِناً مَسلوبَةً","سُكّانُها وَمَصانِعاً وَظِلالا",51,"ل",2,0],["وَلَقَد رَأَيتَ مَنِ اِستَطاعَ بجَمعِهِ","وَبَنى فَشَيَّدَ قَصرَهُ وَأَطالا",51,"ل",2,0],["وَلَقَد رَأَيتُ مُسَلَّطاً وَمُمَلَّكاً","وَمُفَوَّهاً قَد قيلَ قالَ وَقالا",51,"ل",2,0],["وَلَقَد رَأَيتُ الدَهرَ كَيفَ يُبيدُهُم","شيباً وَكَيفَ يُبيدُهُم أَطفالا",51,"ل",2,0],["وَلَقَد رَأَيتُ المَوتَ يُسرِعُ فيهِمُ","حَقّاً يَميناً مَرَّةً وَشِمالا",51,"ل",2,0],["وَلَقَد رَأَيتُ الطاعِمينَ لِما اِشتَهَوا","وَهُمُ لِأَطباقِ التُرابِ طَعامُ",52,"م",1,0],["وَلَقَد رُزِقتُ لِظالِمي غِلَظاً","وَرَحِمتُهُ إِذ لَجَّ في ظُلمي",53,"ي",1,0],["وَلَقَد رَضَيتَ بِأَن تَعيشَ مُنَزَّهاً","لا غاضِباً فيها وَلا مَغصوبُ",54,"ب",1,0],["وَلَقَد رَضيتُ عَنِ الصَباحِ وَإِن غَدا","لِلعاشِقينَ غُرابَ بَينٍ يَنعَقُ",55,"ق",1,0],["ولقد رُدَّ ذا الغريب عن","الدنيا إلى أصلِه في الجوزاءِ",56,"ا",2,0],["وَلَقَد رَأَيناها لَهُ بِقُلوبِنا","وَظُهورُ خَطبٍ دونَهُ وَبُطونُ",57,"ن",1,0],["وَلَقَد رَأَيتُ وَما رَأَيتُ كَوارِدٍ","وَالخِمسُ بَينَ لَهاتِهِ وَالمَنهَلِ",58,"ل",1,0],["وَلَقَد رَأَيتَ الناهِضينَ فَهَل تَرى","إِلّا خَلائِقَ سَمحَةٍ وَعُقولا",59,"ل",2,0],["وَلَقَد رَأَيتُ الفاضِلينَ وَما بَنَوا","لِلغابِرينَ مِنَ القُرونِ الأُولى",59,"ل",2,0],["وَلَقَد رَأَيتُ فَما رَأَيتُ كَظالِمٍ","جَمِّ الشَكاةِ وَقاتِلٍ مَنّانِ",60,"ن",1,0],["وَلَقَد رَأَيتُ فَما رَأَيتُ كَمُدَّعٍ","يَرجو بِأَحرارِ الرِجالِ لَحاقا",61,"ق",2,0],["ولقد رَميتَ بني قريظةَ بالتي","سَمِعَ المجيبُ فهالكٌ ومُروَّعُ",62,"ع",1,0],["ولقد رأيتَ حِمَى الجهادِ فَصِفْ لنا","ذاك الحمى القُدسِيَّ كيف تراهُ",63,"ا",2,0],["وَلَقَد رَأَيتُ الفاعلِينَ وفِعلُهُم","فَرَأَيتُ أَكرَمَهُم بَني الدّيانِ",64,"ن",1,1],["وَلَقَد رَأَيتُكِ في النِساءِ فَسُؤتِني","وَأَبا بَنيكِ فَساءَني في المَجلِسِ",65,"س",1,1],["ولقد رأيتُكَ لا بلَحْظٍ عاكِفٍ","فرأيتُ من شِيَمِ النبيّ شُكولا",66,"ل",2,0],["وَلَقَد رَأَيتُ بِها الخَرا","ئِدَ يَتَّصِلنَ إِلى الخَرائِد",67,"د",1,0],["وَلَقَد رَأى أَنَّ الَّذي هُوَ غالَهُم","قَد غالَ حِميَرَ قَيلَها الصَبّاحا",68,"ح",2,0],["ولقد رمتُ شربةً من نمير","فتيممتُه ففرَّ النمير",69,"ر",1,0],["وَلَقَد رسوت أَمام جحفلهم كَما","في صدر مجرى السيل يَرسو الجلمد",70,"د",1,0],["وَلَقَد ركبت عبابه","عمراً فَما نفع الركوب",71,"ب",1,0],["وَلَقَد رأَيت مصيرهم","فعرفت حينئذٍ مَصيري",72,"ر",2,0],["وَلَقَد رأَيتك مَيتاً","فذممت عاقبة الأمور",72,"ر",1,0],["وَلَقَد رأَيتك يا ظلام تعودني","وَتَطوف طول اللَيل حول سَريري",73,"ي",1,0],["وَلَقَد رأَيت الدهر يرهف سيفه","فَعلمت ما يَبغي من الإرهاف",74,"ف",1,0],["ولقد رأيت وما سمعت بمثله","بيناً غرابُ البينِ فيه أبيضُ",75,"ض",1,0],["وَلَقَد رَقيتُكَ بَعدَ أَدوِيَةِ الدَوا","بِاِسمِ الَّذي لَو شاءَ أَبرا الأَبرَصا",76,"ص",2,0],["وَلَقَد راعَ الأَعادي خَبَرٌ","مِن طَلَمجورَ وَقَد قيلَ يَفِد",77,"د",1,0],["ولقد رأيت أشقَّ خْط","وِ المجد خطوة الابتداء",78,"ا",2,0],["ولقد رعيت لديه حقوق","أقطعتها العدا جناب اطراح",79,"ح",1,0],["ولقد رأى أنّ الذين هوَ غالَهُمْ،","قد غالَ حميرَ قيلها الصباحاَ",80,"ح",2,0],["ولقد رأى المستعمِرونَ فرائساً","منَّا ، وألفَوْا كلبَ صيدٍ سائبا!",81,"ب",2,0],["ولقد رأيتُ فُويقَ دجلةَ مَنظراً","الَشِعرُ لا يقوى على تحليله",82,"ل",2,0],["ولقد ركبت البحرَ في أمواجهِ","وركبتُ هَولَ اللَّلِ في بَيَّاس",83,"س",1,0],["ولقد رجعت إليك بعد ملاوة","فقلت رجعة وامق مستاس",83,"س",1,0],["وَلَقَدْ رَابَني نُبُوُّ ابنِ عَمّي،","بَعد لينٍ من جانبَيهِ، وأُنْسِ",84,"س",1,0],["ولقد ركبت البحر يزأر هائجا","كالليث فارق شبله بل أحنفا",85,"ف",2,0],["ولقد رمتْه يومَ ذلك قِدْرُهُم","بغُطامطٍ من غَليها وغُطامِط",86,"ط",1,0],["ولقد راعتني رزايا توالت","والرزايا اذا توالت تروع",87,"ع",1,0],["ولقد رأيت بذا الفتى سفراً فتي","بشراً سوياً لا يرد غشمشما",88,"م",2,0],["ولقد رجعت وما قضيت لجولتي","إن الطعام يقوي أكلاً منهما",88,"م",2,0],["ولقد رضيت من الدهور بمرها","مراً وحلواً للصدور مغمّما",88,"م",2,0],["وَلَقَد رَضيتُ بِعَيشِنا","إِذ نَحنُ بَينَ حَدائِقِ",89,"ق",1,0],["وَلَقَد رُقتَها بِعِلمٍ وَحِلمٍ","يوجِبانِ التَعظيمَ وَالتَبجيلا",90,"ل",2,0],["وَلَقَدْ رَقَتْ هِمَمِي ظُهُورَ عَزائِمي","وَغَدَوْتُ لِلْجَوْزاءِ فِيكَ قَرِينا",91,"ن",2,0],["وَلَقَد رَجَوتُ مَعَ العِذارِ سُلوَّهُ","فَإِذا بِهِ مِن أَبيَنِ الأَعذارِ",92,"ر",1,1],["ولقد رأيتك والصوارم تنتضى","والموت بادٍ قد تسمى واكتنا",93,"ن",2,0],["ولقد رأينا للاله عناية","بك لا تحيج إلى مزيد بيان",94,"ن",1,0],["وَلَقَد رَأَيتُ به القِيانَ وكالدُّمَى","خُرسَ الخَلاخِلِ وَعثَة الأَثقالِ",95,"ل",1,0],["وَلَقَد رَأَيتُ بها أَوانِسَ كالدُّمَى","قُبَّ البُطُونِ رَوَاجِحَ الأَكفَالِ",95,"ل",1,0],["وَلَقد رَأيتُ بِها أَوَانِسَ كالدُّمَى","يَرفُلنَ فى سَرَقِ الحرير فُضُولا",96,"ل",2,0],["وَلَقد رَأَيتُ فَما رَأَيتُ أَشَدّ مِن","مَرأى العَزيزِ عَلى حَسودٍ صاغرِ",97,"ر",1,0],["ولقد رميت من الزمان بنائب","أدمت مواضع عضّه أسنانه",98,"ه",1,1],["ولقد رأيتُ لحاظهم مسلولةً","يومَ انتضتْ أسيافَها الأجيادُ",99,"د",1,0],["ولقد رضِيتُ من الزّمانِ بجَوْرِه","متحمِّلاً وشرِبتُ ما أَسْقاني",100,"ي",1,0],["ولقد رآه لابنتيه محمد","كفؤاً حليماً لم يعب بلجاج",101,"ج",1,0],["وَلَقَد رَأى أَبَوَيهِ آدَمَ ثُمَّ إِب","راهيمَ فَليُبشر بِهِ الأَبَوانِ",102,"ن",1,0],["وَلَقَد رَأى يَحيى وَعيسى ثُمّ ها","رونَ المُحَبَّبَ رُؤيَةَ اليَقظانِ",102,"ن",1,0],["وَلَقَد رَأى رَجُلاً فَأَخبَرَ أَنَّهُ","يَلِدُ الخَوارِجَ شَرَّ ما ولدانِ",102,"ن",1,0],["وَلَقَد رَأى مِن خَلفِهِ كَأَمامِهِ","وَكَذا النَّهارُ وَلَيلهُ سيّانِ",102,"ن",1,0],["وَلَقَد رَوى أَنَسٌ دَعا بِالعُمرِ وال","بَركاتِ وَالأَولادِ لي وَحَباني",102,"ن",2,0],["وَلَقَد رَوى أَنَسٌ فَقالَ خَدَمتُهُ","عَشراً فَلَم يَنقِم عَلَيَّ لِشاني",102,"ن",2,0],["وَلَقَد رَقَدتُ وَلِلزَمانِ قَوارِضٌ","تَعتادُني وَشَوائِبٌ تُصميني",103,"ن",2,0],["وَلَقَد رَدَّ نَضرَةَ العَيشِ لي مُق","تَبِلٌ مِن زَمانِ عَدلٍ نَصيرِ",104,"ر",1,0],["ولقد رآه نَزلَةً أخرى كما","قال الإله بقصة المعراج",105,"ج",1,0],["ولقد رأى آياته الكبرى التي","هي للجهول طلاسمٌ وأحاجي",105,"ج",2,0],["ولقد رأيت على الإدراك حمامة","تبكى فتسعدني على الأحزان",106,"ن",1,1],["ولقد رميت من الزمان بحادث","قد عز لي الاك فيه المسعد",107,"د",1,0],["ولقد رميت بسهم دهر ناكث","ولربما أخطا المراد الطالب",108,"ب",1,0],["ولقد رأيتُكِ في المساءِ تقيّة","عهدَ الصِّبا والحبّ تذَّكرينا",109,"ن",2,0],["ولقد رأوا من بأسكم وفِعالكم","ما شاءَهُ التّصميمُ والإقدام",110,"م",1,0],["ولقد رَعيتُك في تمامكَ طالعاً","فوقَ الربى والذّروةِ الشماء",111,"ا",2,0],["ولقد رعيتُكَ والسماءُ نقيةٌ","في الصيفِ فوقَ المرجةِ الخضراء",111,"ا",2,0],["ولقد رَعيتُكَ ثمّ فوقَ بحيرةٍ","فرأيتُ وجهك في صفيّ الماء",111,"ا",2,0],["ولقد رعيتُك والرياضُ تحوكُها","كفُّ الربيعِ وأنتَ كالوشَّاء",111,"ا",2,0],["وَلَقَدْ رُمْنا رِضاكُم حِقَباً","وَتَحَمّلنا أذاكُمْ حِجَجا",112,"ج",2,0],["وَلَقَدْ رابَنِي شَذاكَ فَبِاللّ","هِ مَتى عَهْدُهُ بِأَطْلالٍ هِنْدِ",113,"د",1,0],["وَلَقَد رَأَيتُ الفاعِلينَ وَفِعلَهُم","وَلِذي الرُقَيبَةِ مالِكٍ فَضلُ",114,"ل",1,0],["ولقد ركبت على البريد فلا تسل","عن حالةٍ أصبحتُ منها ذائبا",115,"ب",2,1],["وَلَقد رَأَيناك الحريَّ بِنيلها","رأيَ الفراسةِ قبلَ فطم المرضعِ",116,"ع",1,0],["ولقد رأينا دينكم","دين المجانة والخيانه",117,"ه",1,0],["وَلَقَد رَوى الإسكندر الحكم الَّتي","لَم يَروها الحُكماء عَن لُقمانِ",118,"ن",1,0],["وَلَقَد راقَ وَجه حُسنِكَ حَتّى","أَسكَر الناظِرينَ من غَيرِ كاس",119,"س",1,0],["ولقَدْرِ مِثْلي فَضْلُ مِثْلِك عارِفٌ","فابْرُزْ فقد خِفْتُ الخُطوبَ وعَجِّل",120,"ل",1,0],["وَلَقَد رَضيتُ بِقَتلَتي","إِن كانَ ذاكَ بِرَايِها",121,"ه",2,0],["وَلَقَد رَأَيت وَما سَمِعتُ بِمِثلِهِ","لِلبَينِ بَينَهُم غُراباً أَعصَما",122,"م",2,1],["ولَقَد رَضيتُ مِن المَعا","صِي في وِصالِكَ بالتُّهَم",123,"م",1,0],["ولقد رأيتُكَ بالذي اس","تَدعى وما استدعيت أُخرى",124,"ر",2,0],["ولقد رأيتُ مجالسَ الر","رُؤساءِ أفنِيةَ الحُفَر",125,"ر",1,0],["ولقد رأيتُ لها وقد طاولتُها","شِيماً تذكِّرني بهنَّ محمَّدا",126,"د",2,0],["ولقد رأى الضرب الدارك مكذباً","ذاك الفتورَ فأتقي بتجلُّدي",127,"ي",1,0],["وَلَقَد رابَني اِبنُ عَمِّيَ كَعبٌ","أَنَّهُ قَد يَرومُ ما لا يُرامُ",128,"م",1,0],["وَلَقَد راموا بِسَعيٍ ناقِصٍ","كَي يُزيلوهُ فَأَعيا وَأَبَر",129,"ر",1,0],["ولقد رسمتم للتّضامن لوحةً","عظمى وشيّدتم له الأبراجا",130,"ج",2,0],["ولقد رأيتُ لسانه مع أنَّه","كالشهد أَمضى من شفير حسام",131,"م",1,0],["ولقد رأيتُ جنانه كلسانه","وكلاهما إذ ذاك كالصّمصام",131,"م",1,0],["ولقد رأيتُ الدار تُدمي أعيناً","غرقى ويحرق دمعها الأكبادا",132,"د",2,0],["ولقد رعيتُ لهم هناك وما رَعوا","وحَفِظْتُ وُدَّهم القديم وضيَّعوا",133,"ع",3,0],["ولقد رأيتُ الدهرَ ألبسَ ثوبَها","ببواكرِ الأنداءِ روضاً مُعشِبا",134,"ب",2,0],["ولقد راضَني الزمانُ ذَلولاً","بعد أن كنتُ أستطيلُ الجِماحا",135,"ح",2,0],["ولقد رأيتُ البدرَ وهوَ كغُرّةٍ","عقدَتْ بناصيةِ الظلامِ الأدهَمِ",136,"م",1,1],["ولقد رايتُ من الزمان عجائباً","إن الزمان وصرفَه دوّارُ",137,"ر",1,0],["ولقد رحت بعدهم بفؤاد","موثق منهم ودمع طليق",138,"ق",1,0],["ولقد رأيتُ الجِدَّ لَيْسَ ببالغٍ","وَالعَجزَ لَيْسَ عن الصِّراطِ بناكِبِ",139,"ب",1,0],["ولقد رأيتك كالسحابة برقها","آض وصيبها فغير الوادق",140,"ق",1,0],["ولقد رأيت الحر ليس له بقا","لكن يبقى ذكره المرفوع",141,"ع",1,0],["ولقد رأيت مياهها لكنها","رؤيا صدٍ عن ذوقها مصدود",142,"د",1,0],["ولقد ركبت إلى المآرب قبلها","ظهرَ الخطار سلمتُ أو لم أسلَمِ",143,"م",1,0],["ولقد رأيتَ فهل رأيتَ كموقفٍ","بالنّعفِ يُلبَسُ حقُّه بالباطلِ",144,"ل",1,0],["ولقد رفعتُ طلائحاً","جُرْدُ البطون قِصارُها",145,"ر",3,0],["ولقد رأيتُ بني الزمان فلم أجِدْ","كذمامه ووفائه وسَخائهِ",146,"ا",3,0],["ولقد رأيت ما رأيت فضيلة","شهدت بها الأمثال من أعدائها",147,"ا",3,0],["ولقد رأيت البدرَ تحت غمامةٍ","يخفى ويبدو حيثما يتقشعُ",148,"ع",1,1],["ولقد رأيتُ فما رأيتُ كسربها","أقمار تمٍّ في ظلامِ غدائر",149,"ر",1,0],["ولقد ركبت البحر وهو كحلبةٍ","والموج تحسبهُ جياداً تركضُ",150,"ض",1,1],["ولقد رأيت وما رأيت كموقفٍ","يبكي القتيل به لحبّ القاتل",151,"ل",1,0],["ولقد رحلنَ العيس يعسفنَ الدجى","وكأنها الإنسان في أرسانها",152,"ن",3,0],["ولقد رأيتك في المنا","م معانقي دون العيان",153,"ن",1,0],["وَلَقَد رَأَيتُ شَبيهَ ما عَيَّرتِني","يَغدو الزَمانُ بِهِ عَلَيكِ وَيَبكُرُ",154,"ر",1,0],["ولَقد رأيتُم منهُ صولَةَ ضَيغَمٍ","في رِقَّةٍ هىَ للزُّلالِ زلاَلُ",155,"ل",1,0],["وَلَقَد رأيتُ بِها أَوانسَ كالدُمى","يَنظُرنَ من حَدقِ الظِباءِ العِيَّطِ",156,"ط",1,1],["ولقد رمى قلبي الرّدى لمّا اِنتَحى","من كان حشوَ ضميره فرماهُ",157,"ا",2,0],["ولقد رأيتُ أخاه في النَّسَبِ الّذي","لا حَمْدَ فيه وما رأيتَ أخاهُ",157,"ا",2,0],["ولقد رأيتُ بخاطري وبناظري","في غابك المرهوب خيرَ شبولِ",158,"ل",1,0],["وَلقد رجوتُ وصالكمْ فكأنَّني","حاولتُ شَحْطاً لا يُرامُ سحيقا",159,"ق",2,1],["وَلَقد رمى الرّحمنُ في أوصالهِ","لمّا أتى بتبدّدٍ وتَذَعْذُعِ",160,"ع",1,0],["وَلَقد رَأيتك مطفئاً من لوعتِي","والحزن يُملي منه ما أنا أسطُرُ",161,"ر",1,0],["ولقد رآه بها الذي","هو فضله فينا العميم",162,"م",1,0],["ولَقد رَوَى تاريخُنا مِن قبلِهِ","بالبرِّ يوسُفُ نالَ حُسنَ خِتامِهِ",163,"ه",1,0],["ولقد رحلتَ بلا وَداعٍ ضارباً","ميعادَ تسليمٍ ليومِ المحَشرِ",164,"ر",1,0],["ولقد رآهُ الدَّهرُ من آحادِهِ","فلِذاكَ لم يُدْخِلْهُ في عَشَراتِهِ",165,"ت",2,0],["ولقد رأيتُ الأُسْدَ أحسَنَ خَلّةً","من جِنسِ هذا الناطقِ المُتَمرِّدِ",166,"د",1,0],["ولقدْ رَكِبتُ الشِعرَ حتى مَلَّني","ومَلِلتُهُ فأسأْتُ فيهِ وأحسَنا",167,"ن",2,0],["وَلَقَد رأَيت الشرّ بين","الحيّ يبدأه صغاره",168,"ر",2,0],["وَلَقَد رَأَيتُ مَخيلةً فَتَبِعتُها","مَطَرَت عَليَّ بحاصِبٍ وَتُرابِ",169,"ب",1,1],["ولقد رأَيتُ الشَّمسَ منها كُوّرت","من بعد أَنْ ركبوا على أَكْوارِهم",170,"م",1,0],["ولقد رحلْتَ وما علم","تَ بأَنَّ قلبي في رحَالِكْ",171,"ك",1,0],["ولَقَد رَأَيْتُ وما رَأَيتُ كَقَادِرٍ","يسعى لخِدمَتهِ القضاءُ مُقَدَّرا",172,"ر",2,0],["وَلَقَدْ رَأَيْتُ بِرَامَةٍ بَيْنَ النَّقَا","فَمَنَعْتُ طَرْفي مِنْهُ أَنْ يتَمتَّعا",173,"ع",2,0]]}