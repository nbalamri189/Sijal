النسمة السكرى","https://www.aldiwan.net/poem55050.html","مجزوء الرمل"],[339,"فكرت في المال وفي جمعه","https://www.aldiwan.net/poem68679.html","السريع"],[367,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[378,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[378,"عج بالحمى يا راكب الوجناء","https://www.aldiwan.net/poem66977.html","الكامل"],[397,"هل بالمنازل إن كلمتها خرسُ","https://www.aldiwan.net/poem587.html",""],[404,"فكرت من أهوى لمن لامني","https://www.aldiwan.net/poem33636.html","السريع"],[435,"فكرت ليلة وصلها في صدها","https://www.aldiwan.net/poem25699.html","الكامل"],[440,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[450,"هو الدين","https://www.aldiwan.net/poem977.html",""],[459,"لله ساع بلغته قدمه","https://www.aldiwan.net/poem55865.html","الرجز"],[459,"بطرفك والمسحور يقسم بالسحر","https://www.aldiwan.net/poem56173.html","الطويل"],[462,"تعنفني في شرب كأسي ضلالة","https://www.aldiwan.net/poem16049.html","الطويل"],[515,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[516,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[530,"فكرت في عملي وفي أعمالي","https://www.aldiwan.net/poem37224.html","الكامل"],[530,"محمد أيها المسكين أقصر","https://www.aldiwan.net/poem37507.html","الوافر"],[538,"ألم تسل الفوارس من سليم","https://www.aldiwan.net/poem69398.html","الوافر"],[539,"أنا من اسمى نعيمه","https://www.aldiwan.net/poem47933.html","عموديه"],[552,"أنجد إذا شئت في الأرزاق أو أغر","https://www.aldiwan.net/poem47787.html","البسيط"],[559,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[563,"طال ميعادنا فخلناه دهرا","https://www.aldiwan.net/poem52935.html","الخفيف"],[565,"لشمس مجدك في الآفاق أضواء","https://www.aldiwan.net/poem820.html",""]],"verses":[["فَكَّرتُ حَتّى لَم أَجِد فِكرَةً","تَقدَحُ إِلّا وَلَها عائِقُ",0,"ق",1,0],["فَكَرَاهُ إِذَا اسْتَجَمَّ غِرَارٌ","وَقِرَاهُ إِذَا أَلَمَّ عُجالَهْ",1,"ل",2,0],["فَكَرَّ ذو حَربَةٍ تَحمي مَقاتِلَهُ","إِذا نَحا لِكُلاها رَوقَهُ صابا",2,"ب",2,0],["فِكرٌ سَريعٌ كَرُّهُ مُتَدَفِّعٌ","كَتَدَفُّعِ الأَمواجِ فَوقَ عُبابِ",3,"ب",1,0],["فَكَرَّ إِلَيهِ بِمِبراتِهِ","كَما خَلَّ ظَهرَ اللِسانِ المُجِر",4,"ر",1,0],["فَكِّرُوا فَكِّرُوا مَلِيّاً مَلِيّاً","وَاسْتَقِلُّوا بِوَحْيِكُمْ رَاشِدِينَا",5,"ن",2,0],["فَكَرَّ يَمشُقُ طَعناً في جَواشِنِها","كَأَنَّهُ الأَجرَ في الإِقبالِ يَحتَسِبُ",6,"ب",1,0],["فَكَرَرتُ مَحمِيَةً وَراءَ ذِمارِكُم","إِنَّ الكَريمَ عَنِ الذِمارِ مُحامي",7,"م",2,0],["فكر بأسحم مثل السنان","سوى ما أصاب به مقتلُ",8,"ل",1,1],["فكَّرتُ في خمسين عاماً خَلَتْ","كانتْ أمامي ثم خلَّفْتُهَا",9,"ت",3,0],["فَكِّرْ لَقيتَ الرشْدَ فيَّ فلم يزل","لك رأيُ صدقٍ في الأمور مسدَّدُ",10,"د",1,0],["فكَّرْ أبا البنت هل تُؤثِّل ما","تجمع إلا لناكحٍ ذَكر",11,"ر",1,0],["فكرَّ على ما قبلها متدبّراً","فثاب له ذِكْرٌ فأمضى مجازها",12,"ز",3,0],["فكِرٌ كمقدار السماءِ إذا انتحى","لم يعصمِ الأوعالَ منه توقُّلُ",13,"ل",1,0],["فكِّر وقل لهُمُ مقالةَ صادقٍ","يحتجُّ عند مقاله ويُبين",14,"ن",1,0],["فَكَرَّ ذو حَربَةٍ يَحمي حَقيقَتَهُ","إِذا نَحا لِكُلاها الرَوقَ يَمتَرِقُ",15,"ق",1,0],["فَكَّرتُ في هِنري وَكَيفَ قَضى","فَوَجَدتُ هِنري واضِحَ العُذرِ",16,"ر",1,0],["فَكَّرتُ في ما نَحنُ فيهِ كَأُمَّةٍ","وَضَرَبتُ أَخماسي إِلى أَسداسي",17,"س",2,0],["فَكَرَّ ذو حَوزَةٍ يَحمي حَقيقَتَهُ","كَصاحِبِ البَزِّ مِن حَورانَ مُنتَصِرِ",18,"ر",1,0],["فِكْرٌ بأَرضِ الشَّكِّ والإِبهامِ","أَو عالَمٌ مَا زالَ يولَدُ في فضا",19,"ض",2,0],["فكِّرْ لِتُدْرِكَ ما أريدُ وإنَّه","أسمى من العيش القَصيرِ النَّابي",20,"ب",2,0],["فكرت في الماضي البعي","يد لي وفي مستقبلي",21,"ي",1,1],["فكرى أذقت اليوم عفو بلاغة","وزففت محضا للنهى ولبابا",22,"ب",2,0],["فكري جهاتك أضلعي","واديك أحشائي رباك",23,"ك",1,0],["فَكَّرتِ في الغَدِ وَالفِك","رُ مُقعِدٌ وَمُقيمُ",24,"م",1,0],["فكَّرْتُ فِي لَبَنِ الجِنانِ وخمرِها","لما رأَيْتُ الماءَ مَسَّ طِلاكِ",25,"ك",1,0],["فَكّرْتُ فيكُمْ وفي المُصَابِ فَما انْ","فَكَ فُؤادي يَعُومُ في عَجَبِ",26,"ب",1,0],["فكرر العمل المذكور إنَّ ترا","كيب الصناعة أمرغير مختصرِ",27,"ر",1,0],["فكرت عشر حجج كواملِ","في سره فلم أفز بطائلِ",28,"ل",1,0],["فَكَرِّما الَّذي اِبتَلاهُ بِها","فَكانَ مِسكاً فَصَيَّرَتهُ خَرا",29,"ر",2,0],["فكَرمةٌ قَطَرَت أغصانُها سَبَجاً","وكرمةٌ قطرَت أغصانُها ذَهَبا",30,"ب",2,0],["فَكَّرتُ فيمَ جَفَوتَني","فَوَجَدتُ ذاكَ لِطولِ نائِك",31,"ك",1,0],["فَكَّرتُ في الدُنيا وَجِدَّتِها","فَإِذا جَميعُ جَديدِها يَبلى",32,"ا",1,0],["فَكَّرتُ فيما نَسعى لَهُ فَإِذا","نَحنُ جَميعاً مِنهُ عَلى غَرَرِ",33,"ر",1,0],["فَكَّرتُ في الدُنيا فَكانَت مَنزِلاً","عِندي كَبَعضِ مَنازِلِ الرُكبانِ",34,"ن",1,0],["فَكَرِّش إِن أَرَدتَ لَنا كَلاماً","وَنَقطَعُ فِحفَ رَأسِكَ بِالقَذالِ",35,"ل",1,0],["فِكرٌ يُدَوِّرُ في أُمورِ زَمانِهِ","طَرفي خَبيرٌ في الزَمانِ عَروفِ",36,"ف",1,0],["فِكرَةٌ تَحتَ مُنتَهى دَرَكِ الأَ","ضِ وَعَزمٌ في ذُروَةِ الأَفلاكِ",37,"ك",1,0],["فِكرٌ إِذا راضَهُ راضَ الأُمورَ بِهِ","رَأيٌ تَفَنَّنَ فيهِ الرَيثُ وَالعَجَلُ",38,"ل",1,0],["فَكَرَعتُ مِن ماءِ الصِبا في مَنهَلٍ","قَد شُقَّ عَنهُ مِنَ القَميصِ سَرابُ",39,"ب",1,0],["فَكَرَّ عليهم كَرَّةَ اللّيثِ ضَارباً","وُجوهَ مَطاياهُم ولمَ يألُهمْ زَأْرا",40,"ر",2,0],["فكَّرْ بموتكَ في أرضٍ نشأتَ بها","واتركْ لقبركَ أرضاً طولها باعُ",41,"ع",1,0],["فَكُردوسٌ لِعَمّارٍ","وَكُردوسٌ لِعَبدوسِ",42,"س",1,0],["فَكَرَّ مَحمِيَّةً مِن أَن يَفِرَّ كَما","كَرَّ المُحامي حِفاظاً خَشيَةَ العارِ",43,"ر",1,0],["فَكُرَّ عَلى الأَبطالِ أَو كُرَّ في الوَغى","لِهَذي اللَيالِيَ حَملَةٌ وَكُرورُ",44,"ر",1,0],["فَكِّري أَنتِ رُبَّما هُديَ الإِن","سانُ لِلمُشكِلاتِ بِالتَفكيرِ",45,"ر",1,0],["فَكِّروا في الأُمورِ يُكشَف لَكُم بَع","ضُ الَّذي تَجهَلونَ بِالتَفكيرِ",46,"ر",1,1],["فِكَرٌ حَسَّنَت لِقَومٍ أُموراً","فَاِستَجازوا التَهويدَ وَالتَمجيسا",47,"س",2,0],["فَكَّرَ يَزدانُ عَلى غِرَّةٍ","فَصيغَ مِن تَفكيرِهِ أَهرُمُن",48,"ن",1,0],["فكرة السبق قد بنت","سؤدداً فوق سؤدُدِ",49,"د",1,1],["فَكَرَرنا صُدورَ عيسٍ عِتاقٍ","مُضمِراتٍ طَوَينَ بِالسَيرِ طَيّا",50,"ي",2,0],["فكَّرتُ فيكَ أَبحرٌ أنتَ أم قمرٌ","فقد تَحيَّرَ فِكْري بينَ هَذينِ",51,"ن",1,1],["فَكَّرتُ في 