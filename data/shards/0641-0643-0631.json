55473",""],[5784,"هدية لشاعر واهم غيبه النسيان ..... !؟","https://www.poetsgate.com/ViewPoem.aspx?id=190687",""],[5794,"عصفور","https://www.poetsgate.com/ViewPoem.aspx?id=80280",""],[5829,"حوار مع زائر الليل","https://www.poetsgate.com/ViewPoem.aspx?id=178324",""],[5830,"كَتبْتُ شِعْرِيَ","https://www.poetsgate.com/ViewPoem.aspx?id=201124",""],[5843,"وصندوق البريد","https://www.poetsgate.com/ViewPoem.aspx?id=51286",""],[5936,"هذاك إبن ناشي","https://www.poetsgate.com/ViewPoem.aspx?id=184773",""],[5943,"نزعنا السَّرجَ","https://www.poetsgate.com/ViewPoem.aspx?id=11091",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[5956,"عساك اْخترتَني؟","https://www.poetsgate.com/ViewPoem.aspx?id=192131",""],[6008,"شفت الخبل","https://www.poetsgate.com/ViewPoem.aspx?id=59161",""],[6019,"ندى الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=186015",""],[6056,"قديمة نديمة","https://www.poetsgate.com/ViewPoem.aspx?id=130512",""],[6093,"أَضْحَى التَّحَدُّثُ بِالفُصْحَى مِنَ العَجَبِ (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=184315",""],[6102,"الأَماسِيُّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=182862",""],[5309,"فكر قليلا قبل عشق المها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573644",""],[5309,"وطني هو الأرض التي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573566",""],[566,"جاري لا تستنكري عذيري","http://www.aldiwanalarabi.com/poemDescription.do?poemId=507626",""],[6164,"صراع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66057&r=&rc=66",""],[6202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""],[6213,"لا لم أيأس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76309&r=&rc=57",""],[463,"بطرفِّكَ والمسحورُ يقسمُ بالسَّحرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60085&r=&rc=141",""],[6271,"أبناء الدروب الضيقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80702&r=&rc=8",""]],"verses":[["فَكَّرتُ حَتّى لَم أَجِد فِكرَةً","تَقدَحُ إِلّا وَلَها عائِقُ",0,"ق",1,0],["فَكَرَاهُ إِذَا اسْتَجَمَّ غِرَارٌ","وَقِرَاهُ إِذَا أَلَمَّ عُجالَهْ",1,"ل",2,0],["فَكَرَّ ذو حَربَةٍ تَحمي مَقاتِلَهُ","إِذا نَحا لِكُلاها رَوقَهُ صابا",2,"ب",2,0],["فِكرٌ سَريعٌ كَرُّهُ مُتَدَفِّعٌ","كَتَدَفُّعِ الأَمواجِ فَوقَ عُبابِ",3,"ب",1,0],["فَكَرَّ إِلَيهِ بِمِبراتِهِ","كَما خَلَّ ظَهرَ اللِسانِ المُجِر",4,"ر",1,0],["فَكِّرُوا فَكِّرُوا مَلِيّاً مَلِيّاً","وَاسْتَقِلُّوا بِوَحْيِكُمْ رَاشِدِينَا",5,"ن",2,0],["فَكَرَّ يَمشُقُ طَعناً في جَواشِنِها","كَأَنَّهُ الأَجرَ في الإِقبالِ يَحتَسِبُ",6,"ب",1,0],["فَكَرَرتُ مَحمِيَةً وَراءَ ذِمارِكُم","إِنَّ الكَريمَ عَنِ الذِمارِ مُحامي",7,"م",2,0],["فكر بأسحم مثل السنان","سوى ما أصاب به مقتلُ",8,"ل",1,1],["فكَّرتُ في خمسين عاماً خَلَتْ","كانتْ أمامي ثم خلَّفْتُهَا",9,"ت",3,0],["فَكِّرْ لَقيتَ الرشْدَ فيَّ فلم يزل","لك رأيُ صدقٍ في الأمور مسدَّدُ",10,"د",1,0],["فكَّرْ أبا البنت هل تُؤثِّل ما","تجمع إلا لناكحٍ ذَكر",11,"ر",1,0],["فكرَّ على ما قبلها متدبّراً","فثاب له ذِكْرٌ فأمضى مجازها",12,"ز",3,0],["فكِرٌ كمقدار السماءِ إذا انتحى","لم يعصمِ الأوعالَ منه توقُّلُ",13,"ل",1,0],["فكِّر وقل لهُمُ مقالةَ صادقٍ","يحتجُّ عند مقاله ويُبين",14,"ن",1,0],["فَكَرَّ ذو حَربَةٍ يَحمي حَقيقَتَهُ","إِذا نَحا لِكُلاها الرَوقَ يَمتَرِقُ",15,"ق",1,0],["فَكَّرتُ في هِنري وَكَيفَ قَضى","فَوَجَدتُ هِنري واضِحَ العُذرِ",16,"ر",1,0],["فَكَّرتُ في ما نَحنُ فيهِ كَأُمَّةٍ","وَضَرَبتُ أَخماسي إِلى أَسداسي",17,"س",2,0],["فَكَرَّ ذو حَوزَةٍ يَحمي حَقيقَتَهُ","كَصاحِبِ البَزِّ مِن حَورانَ مُنتَصِرِ",18,"ر",1,0],["فِكْرٌ بأَرضِ الشَّكِّ والإِبهامِ","أَو عالَمٌ مَا زالَ يولَدُ في فضا",19,"ض",2,0],["فكِّرْ لِتُدْرِكَ ما أريدُ وإنَّه","أسمى من العيش القَصيرِ النَّابي",20,"ب",2,0],["فكرت في الماضي البعي","يد لي وفي مستقبلي",21,"ي",1,1],["فكرى أذقت اليوم عفو بلاغة","وزففت محضا للنهى ولبابا",22,"ب",2,0],["فكري جهاتك أضلعي","واديك أحشائي رباك",23,"ك",1,0],["فَكَّرتِ في الغَدِ وَالفِك","رُ مُقعِدٌ وَمُقيمُ",24,"م",1,0],["فكَّرْتُ فِي لَبَنِ الجِنانِ وخمرِها","لما رأَيْتُ الماءَ مَسَّ طِلاكِ",25,"ك",1,0],["فَكّرْتُ فيكُمْ وفي المُصَابِ فَما انْ","فَكَ فُؤادي يَعُومُ في عَجَبِ",26,"ب",1,0],["فكرر العمل المذكور إنَّ ترا","كيب الصناعة أمرغير مختصرِ",27,"ر",1,0],["فكرت عشر حجج كواملِ","في سره فلم أفز بطائلِ",28,"ل",1,0],["فَكَرِّما الَّذي اِبتَلاهُ بِها","فَكانَ مِسكاً فَصَيَّرَتهُ خَرا",29,"ر",2,0],["فكَرمةٌ قَطَرَت أغصانُها سَبَجاً","وكرمةٌ قطرَت أغصانُها ذَهَبا",30,"ب",2,0],["فَكَّرتُ فيمَ جَفَوتَني","فَوَجَدتُ ذاكَ لِطولِ نائِك",31,"ك",1,0],["فَكَّرتُ في الدُنيا وَجِدَّتِها","فَإِذا جَميعُ جَديدِها يَبلى",32,"ا",1,0],["فَكَّرتُ فيما نَسعى لَهُ فَإِذا","نَحنُ جَميعاً مِنهُ عَلى غَرَرِ",33,"ر",1,0],["فَكَّرتُ في الدُنيا فَكانَت مَنزِلاً","عِندي كَبَعضِ مَنازِلِ الرُكبانِ",34,"ن",1,0],["فَكَرِّش إِن أَرَدتَ لَنا كَلاماً","وَنَقطَعُ فِحفَ رَأسِكَ بِالقَذالِ",35,"ل",1,0],["فِكرٌ يُدَوِّرُ في أُمورِ زَمانِهِ","طَرفي خَبيرٌ في الزَمانِ عَروفِ",36,"ف",1,0],["فِكرَةٌ تَحتَ مُنتَهى دَرَكِ الأَ","ضِ وَعَزمٌ في ذُروَةِ الأَفلاكِ",37,"ك",1,0],["فِكرٌ إِذا راضَهُ راضَ الأُمورَ بِهِ","رَأيٌ تَفَنَّنَ فيهِ الرَيثُ وَالعَجَلُ",38,"ل",1,0],["فَكَرَعتُ مِن ماءِ الصِبا في مَنهَلٍ","قَد شُقَّ عَنهُ مِنَ القَميصِ سَرابُ",39,"ب",1,0],["فَكَرَّ عليهم كَرَّةَ اللّيثِ ضَارباً","وُجوهَ مَطاياهُم ولمَ يألُهمْ زَأْرا",40,"ر",2,0],["فكَّرْ بموتكَ في أرضٍ نشأتَ بها","واتركْ لقبركَ أرضاً طولها باعُ",41,"ع",1,0],["فَكُردوسٌ لِعَمّارٍ","وَكُردوسٌ لِعَبدوسِ",42,"س",1,0],["فَكَرَّ مَحمِيَّةً مِن أَن يَفِرَّ كَما","كَرَّ المُحامي حِفاظاً خَشيَةَ العارِ",43,"ر",1,0],["فَكُرَّ عَلى الأَبطالِ أَو كُرَّ في الوَغى","لِهَذي اللَيالِيَ حَملَةٌ وَكُرورُ",44,"ر",1,0],["فَكِّري أَنتِ رُبَّما هُديَ الإِن","سانُ لِلمُشكِلاتِ بِالتَفكيرِ",45,"ر",1,0],["فَكِّروا في الأُمورِ يُكشَف لَكُم بَع","ضُ الَّذي تَجهَلونَ بِالتَفكيرِ",46,"ر",1,1],["فِكَرٌ حَسَّنَت لِقَومٍ أُموراً","فَاِستَجازوا التَهويدَ وَالتَمجيسا",47,"س",2,0],["فَكَّرَ يَزدانُ عَلى غِرَّةٍ","فَصيغَ مِن تَفكيرِهِ أَهرُمُن",48,"ن",1,0],["فكرة السبق قد بنت","سؤدداً فوق سؤدُدِ",49,"د",1,1],["فَكَرَرنا صُدورَ عيسٍ عِتاقٍ","مُضمِراتٍ طَوَينَ بِالسَيرِ طَيّا",50,"ي",2,0],["فكَّرتُ فيكَ أَبحرٌ أنتَ أم قمرٌ","فقد تَحيَّرَ فِكْري بينَ هَذينِ",51,"ن",1,1],["فَكَّرتُ في خَلقِ الوَرى فَاِستَوى","عِندي عَبيدٌ وَسَلاطينُ",52,"ن",1,1],["فكرِهنَا حتى النعيمَ لأنَّا","قد رأينا اجتماعَه لشتَاتِهْ",53,"ت",2,0],["فكرت ولا رأي في ردها","ولا فاتها مهرب الشارده",54,"د",2,0],["فَكّرْتُ فيما جَفَوْتَني،","فوَجدتُ ذاكَ لطولِ نايِك",55,"ك",1,0],["فكرامةٌ يُهزَى بها ، وكرامةٌ","يُرثى لها ، وكرامةٌ تُستام",56,"م",1,0],["فكرما الذي ابتلاه بها","وكان مسكا فصيرته خرا",57,"ر",2,0],["فكرّ ذو حربة ٍ تحمي مقاتلهُ،","إذا نحا لكلاهما روقهُ صابا",58,"ب",2,0],["فَكَريم الطِباع يَزداد حُلماً","وَلَئيم مَدَحتَهُ اِستكبارا",59,"ر",2,0],["فكر العقل بكم حينا وقد","عرض اليأس لنفسي فثناها",60,"ا",3,0],["فكري به كفاني","عن الربا البسام",61,"م",1,0],["فكري بلطف جميل ذا","تك يا رقيق الخصر حائر",62,"ر",1,0],["فَكرِها كلَّ حالٍ","طَمَعاً في غير حالِ",63,"ل",1,0],["فكرر درسه ليلا وصبحا","وجرد فيه عزمك ما استطعتا",64,"ت",2,0],["فكرَةٌ من خِلالِ عَينَيهِ تَبدو","غَلَّفَتها لهُ وَميضُ خيالِ",65,"ل",1,0],["فِكره في الحياة وهيْ ضلال","إنّ في الموت يحسنُ التفكيرُ",66,"ر",1,0],["فَكَّرتَ في إِنجازِ وَعدِكَ لي وَقُل","تَ التَمرُ أَنفَعُ لي مِنَ الإِخوانِ",67,"ن",1,0],["فَكَرَّ عَلَيهِمُ حَتّى اِلتَقَينا","بِمَصقولٍ عَوارِضُها صَباحِ",68,"ح",1,0],["فكرَّت بعد أن فرَّت وجاءَت","تُقابلُني وتبسُمُ عن جمان",69,"ن",1,0],["فَكَرَّت بِهِ حَرَجٌ ضامِرٌ","فَآبَت بِهِ صُلبُها أَحدَبُ",70,"ب",1,0],["فكرَّةٌ وفرَّةٌ","وعطفة وقهقره",71,"ر",2,0],["فكر على جيش الخيانة عائدا","بمنجرد قيد الأوابد هيكل",72,"ل",1,0],["فِكري نِعمَ كانَ قَد أَجرى سَوانِحُهُ","إِنَّ التَخَلُّصَ لَم أَشمُم رائِحُهُ",73,"ه",1,0],["فكرة للَه لا يع","لمها أحكمنا",74,"ن",2,0],["فكرةٌ من فكر الحسن","تجلّت في وشاح",75,"ح",1,0],["فَكَّرتُ في المالِ وَفي جَمعِهِ","فَكانَ ما يَبقى هُوَ الفاني",76,"ن",2,1],["فِكرٌ عَلى رَصَدِ الأَخطارِ مُرتَقِبٌ","لَكُلِّ واقِعِ أَمرٍ غَيرِ مُرتَقَبِ",77,"ب",1,0],["فكرٌ وفهمٌ بعد ذاك إرادةٌ","هذي قُوَى نفسٍ بها الجسم اكتمل",78,"ل",1,0],["فِكري بمدحكِ صائغٌ لِقَصائدي","والنُطقُ يَسبِكُها بِنارِ ذَكائي",79,"ي",1,0],["فكرَّ يَحمي برَوقيه حقيقتَهُ","به عليهنّ إذ أدركنهُ شمسُ",80,"س",1,0],["فكرت من أهوى لمن لامني","فقال صفه علني أعرف",81,"ف",1,1],["فَكَّرْتُ لَيْلَةٍ وَصْلِها في صَدِّها","فَجَرَتْ بَقايا أَدْمُعي كالْعَنْدَمِ",82,"م",1,1],["فَكَرُّوا يُعِيدُونَ السَّلامَ عَلَى الَّذِي","يُعَاوِدُ عَنْهُمْ فِي العِدى صادِقَ الكَرِّ",83,"ر",1,0],["فكرمت قبل الدين من هو دونه","وما كنت يوماً يا أخا الجود معضلا",84,"ل",2,0],["فكرم فيه الدين والعلم والحجى","فجاءت له بيض الأيادي حفلا",84,"ل",2,0],["فكَّرَ فاستكثرَ لي دينارَهُ","محاسباً ولم يسعْني درهمُهْ",85,"م",2,0],["فكرَّمتني لما قبلتَ نكاحَها","وزيَّدتَ في فضلي وضاعفتَ من قدري",86,"ر",2,0],["فكرِّي عليَّ الكأس يا مَيُّ واعلمي","بأنَّ تَصاريفَ الحياةِ خَيالُ",87,"ل",1,0],["فكري يصوّرُها ولم ترَ غيرَها","عَيني ورسْمُ جَمالِها بخَيالي",88,"ل",2,0],["فكر خواطره كراحتك التي","من صوبها صوب الحيا يمتار",89,"ر",1,0],["فَكَّرْتُ في عَمَلي وفي أَعْمالي","وَنَظَرْتُ في قَوْلي وَفي أفعَالي",90,"ل",2,1],["فَكَرِّرْ شُكْرَ مَنْ أَبْدَى جَمِيلاً","وأَخْفَى عَنْ أعادِيكَ الْعُيُوبا",91,"ب",2,0],["فكرَّ عليهمُ بالسيف صَلتاً","كما عضَّ الشَّبا الفرسُ الجموعُ",92,"ع",1,0],["فِكرتي والحمدُ لل","ه عَلَى النُّعمى سَليمه",93,"م",2,0],["فَكّرْ بِقَلبكَ فيما أَنت تُبصرُهُ","فَالأرضِ مَملوءةُ الأقطار بالعِبَرِ",94,"ر",1,0],["فكري وتطريزه للمدح مبتسم","في وجه مبتسم في وجه مبتسم",95,"م",1,0],["فِكرُهُ أعجَلَ اليَراعَ ففاضتْ","أسطُرٌ منهُ كُلَّما خَطَّ سَطْرا",96,"ر",2,0],["فكري صحيح وعقلي في رزانته","والذهن واع وما بالنطق إعياء",97,"ا",2,0],["فِكرةٌ تَعلَم الخَفيَّ من الأم","رِ وقلبٌ لمشكِلِ الأمرِ قَيدُ",98,"د",1,0],["فِكرٌ وَحزنٌ بِقَلبي في الحشا سَكَنا","وَغربَةٌ ظَلتُ فيها أَيَّ منكسِرِ",99,"ر",1,0],["فكرِّرْ على أُذْنِي لذيذَ حديثِهِ","وصرِّحْ بقولِ الحقِّ غيرَ مُذَمَّمِ",100,"م",1,0],["فكرتُ ليلةَ وصلهِ في هجرهِ","فجرت سوابقُ عبرتي كالعَندم",101,"م",1,0],["فِكَرٌ غَدَتْ أقفالَ فكرٍ كلُّها","لكنَّهنَّ مفاتحُ استنباط",102,"ط",1,0],["فِكرَةٌ قَد خالَطَت كُلَّ الفِكَر","صورَةٌ قَد مازَجَت كُلًّ الصُوَرْ",103,"ر",1,0],["فكرَّت عند فيقتها اليه","فألفَت عندَ مَربض