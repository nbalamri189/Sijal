{"poems":[[91,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[91,"يا موطنا قد ذبت فيه غراما","https://www.aldiwan.net/poem44748.html","الكامل"],[87,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[82,"قل لمن ضاهت الغزالة نورا","https://www.aldiwan.net/poem31353.html","الخفيف"],[46,"حسنت عبرتي وطاب نحيبي","https://www.aldiwan.net/poem30277.html","الخفيف"],[70,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202649","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55418","الخفيف"],[119,"صلى الآله على أبي الزهراء","https://www.aldiwan.net/poem41474.html","عموديه"],[133,"يا رفيقي على طريق الحزاني","https://www.aldiwan.net/poem67450.html","الخفيف"],[505,"أجتلى نور وجهه فأذب","https://www.aldiwan.net/poem37636.html","الخفيف"],[563,"لك قد رمت وجودا فأبى","https://www.aldiwan.net/poem34921.html","الرمل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138357",""],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70975","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72265","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64863","الخفيف"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128698","الخفيف"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128775","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109308","الرمل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88664","الرمل"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111157","الخفيف"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70332","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205074","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89146","الرمل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46020","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131253",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135225","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86368","الخفيف"],[4125,"","https://poetry.dctabudhabi.ae/diwan/poem/203227","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81264","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73096","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73118","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33676","الخفيف"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76738","الكامل"],[4830,"يالِقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=213988",""],[5005,"بوح عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=208157",""],[5121,"بَيْرُوتُ الْحُبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=215332",""],[5232,"إلى شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=213608",""],[5302,"جعلت فداكا","https://www.poetsgate.com/ViewPoem.aspx?id=205728",""],[5344,"للحين غايب ..!","https://www.poetsgate.com/ViewPoem.aspx?id=180705",""],[5409,"لم تنجب الأيام إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155495",""],[5409,"ما لها قد شفعت أيدي الردى","https://www.poetsgate.com/ViewPoem.aspx?id=155456",""],[5418,"قَالَ لي سَاحر اللواحظ صف لي","https://www.poetsgate.com/ViewPoem.aspx?id=189139",""],[5431,"أنا ألف ملحمة وقلبٌ أخضرُ","https://www.poetsgate.com/ViewPoem.aspx?id=192158",""],[5431,"ثورة الشعب العربي..كانت وماتزال..","https://www.poetsgate.com/ViewPoem.aspx?id=195277",""],[5431,"دجلة الحب-للعراق الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=198264",""],[5491,"أحبك فوق ما تتصور","https://www.poetsgate.com/ViewPoem.aspx?id=215087",""],[5691,"بحر عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=207064",""]],"verses":[["لك قد ذابت القلوب اسى ثم جرت","ادمعاً من الآماق",0,"ق",1,0],["لك قد غضبت وفي رضاك حملت ان","تنتابني نوب الزمان جساما",1,"م",2,0],["لك قدّ سجد البان له","وتمنت لو أقلّته الربى",2,"ب",2,0],["لكِ قلبي صَفَا فلا غشّ فيه","وهو للهجرِ منك في نارِ سَبْكِ",3,"ك",1,0],["لَكَ قَدٌّ أَدَقُّ مِن أَن يُحاكى","بِقَضيبٍ في الحُسنِ أَو بِكَثيبِ",4,"ب",1,0],["لكَ قُرْبٌ منّي بِبُعْدِكَ عنّي","وحُنُوٌّ وجَدْتُه في جَفاكا",5,"ك",2,0],["لك قلب فسله يا","قيس ينبئك بالخبر",6,"ر",1,0],["لَكِ قِسْطٌ مِنَ المَعَارِفِ مَوْفُو","رٌ وَقِسْطٌ مِنْ رَاقِيَاتِ الفُنُونِ",7,"ن",1,0],["لك قد لجأت بذلتي وبزلتي","وبعبإ اوزاري وهم عنائي",8,"ا",2,0],["لكَ قَلبٌ مثلُ قلبي","طامحٌ يَسمو ويَهوَى",9,"ه",3,0],["لك قلبي يا يوسف الحسن خفا","قٌ ترفَّق فإنني يعقوب",10,"ب",1,0],["لك قد رمت وجوداً فأبى","وحوى رسمك أما وأبا",11,"ب",2,1],["لك قد سألت الله توفيقا وأن","يرعاك في حل وفي ترحال",12,"ل",1,0],["لك قلب أزاغه جمُعك الما","لَ ونفسٌ رسَتْك قعر المهالكْ",13,"ك",1,0],["لك قلب أقسى علينا من الصخر","وما هكذا تكون القلوب",14,"ب",1,0],["لك قَلْبي ومُقْلَتا","يَ مَصِيفٌ ومَرْبعُ",15,"ع",1,0],["لك قد جئت زائرا وتوسل","ت بجدوى يديك والآلاء",16,"ا",2,0],["لك قامة تدعي بصعده","وحسام لحظ ما أحده",17,"د",2,1],["لك قد آه يا ما غَرَّدت","فوق عطفيه حمامات الحلي",18,"ل",2,0],["لك قد يخجل الغصن النضير","وجفون ما لها قط نظير",19,"ر",1,0],["لك قد اشكلت غوامض علم","اوقفت عن مسيرها الأوهاما",20,"م",2,0],["لك قلبي تملكا فاحتكم في","ه على أنني بحكمك أرضى",21,"ض",2,0],["لك قمنا بمهرجات شعر","ما سمعنا فيها لشعرك نغمه",22,"م",2,0],["لك قال العز بشرى أرخوا","لقدوم بالتهاني سر مصرا",23,"ر",2,0],["لَكِ قَد وَقَّعَ رَبّي","بِالكَمالاتِ وَثيقَه",24,"ق",2,0],["لك قلب من الحمية قد لا","ن ولو لم يلن لكان حديدا",25,"د",2,0],["لك قلبي لك حبي","يا حبيبي في حياتي",26,"ت",2,1],["لك قلبٌ مثل الحديد الصليب","فانهض اجلس ولنبق طي القلوب",27,"ب",1,0],["لك قامت فوق أركان العماد","فإلى سترتها هي بنا",28,"ن",2,0],["لك قد وناظر ثعلي","أكثرا في النفوس طعناً وذبحا",29,"ح",2,0],["لك قدٌ لولا جوارح عيني","ك لغنت عليه وُرْق الحمام",30,"م",1,0],["لَكَ قَلب مِن النضار وَفي صَد","رك جَناته وَدُنيا قُصوره",31,"ر",2,0],["لكَ قامةٌ عسَّالُها تحمي بهِ","ما قد حواهُ الثَّغرُ مِن معسولهِ",32,"ل",2,0],["لكَ قدٌّ بغيرهِ لم تكن تَع","رِفُ في خَوضِك الحُروبَ الطِّعانا",33,"ن",2,0],["لكَ قلبٌ ما إن يَلينُ وَجسمٌ","كقَضيبٍ من لينهِ يتَثنَّى",34,"ن",2,0],["لك قدّ ذابله الوشيح ولونها","لكن سنانك أكحلٌ لا أزق",35,"ق",1,0],["لكِ قلبي لكِ روحي قُربةً","فدمائي تلكَ لي صارَتْ كَفَنْ",36,"ن",1,0],["لكَ قصرُ تحْنانٍ، وتاجُ مودّةٍ","وسِوارُ حبكَ يشتهيه المِعْصمُ",37,"م",1,0],["لَكِ قَلْبٌ مِنْ لُؤْلُؤٍ بَيْرُوتُ","سَاطِعٌ بِالْحَيَاةِ لَيْسَ يَمُوتُ",38,"ت",1,1],["لك ِقلبٌ مثلُ قلبي يانعٌ","كلُّ ما في العيشِ من جمرٍ كواهْ",39,"ا",2,0],["لك قلب من جامد الصخر أقسى","وغرور عن صحبتي أغناكا",40,"ك",2,0],["لك قلب متسامح ولا يعرف المّن","ولك خاطرن من قبل نرضيه طايب",41,"ب",1,0],["لك قد فزعن صوادياً","فسقيتهن الخير علا",42,"ل",2,0],["لك قد عاد كما فارقته","نضراً كالزهر رواه الندى",43,"د",2,0],["لَك قد لَوْلَا جوارح جفني","ك تغنت عَلَيْهِ ورق الْحمام",44,"م",1,0],["لك قبّتاي وفي السهول سنابلٌ","أنا ألف ملحمة وقلبٌ أخضرُ",45,"ر",1,0],["لك قد وهبت الكون نور محبتي","كي تهتدي بطريقه إذْ تحلمُ",46,"م",1,0],["لك قلبي ودمعه من فراتٍ","بك يجري بشوقه اللانهائي",47,"ا",2,0],["لك قد فرشت الورد بين أضالعي","فهناك يدعوك المسا والمَسمَرُ",48,"ر",1,0],["لكِ قَدٌّ كأنَّهُ البانُ ليناً","يتَلوّى كأنَّهُ ثُعْبانُ",49,"ن",1,0]]}