{"poems":[[89,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[89,"يا موطنا قد ذبت فيه غراما","https://www.aldiwan.net/poem44748.html","الكامل"],[85,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[80,"قل لمن ضاهت الغزالة نورا","https://www.aldiwan.net/poem31353.html","الخفيف"],[44,"حسنت عبرتي وطاب نحيبي","https://www.aldiwan.net/poem30277.html","الخفيف"],[68,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202649","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55418","الخفيف"],[116,"صلى الآله على أبي الزهراء","https://www.aldiwan.net/poem41474.html","عموديه"],[130,"يا رفيقي على طريق الحزاني","https://www.aldiwan.net/poem67450.html","الخفيف"],[501,"أجتلى نور وجهه فأذب","https://www.aldiwan.net/poem37636.html","الخفيف"],[559,"لك قد رمت وجودا فأبى","https://www.aldiwan.net/poem34921.html","الرمل"]],"verses":[["لك قد ذابت القلوب اسى ثم جرت","ادمعاً من الآماق",0,"ق",1,0],["لك قد غضبت وفي رضاك حملت ان","تنتابني نوب الزمان جساما",1,"م",2,0],["لك قدّ سجد البان له","وتمنت لو أقلّته الربى",2,"ب",2,0],["لكِ قلبي صَفَا فلا غشّ فيه","وهو للهجرِ منك في نارِ سَبْكِ",3,"ك",1,0],["لَكَ قَدٌّ أَدَقُّ مِن أَن يُحاكى","بِقَضيبٍ في الحُسنِ أَو بِكَثيبِ",4,"ب",1,0],["لكَ قُرْبٌ منّي بِبُعْدِكَ عنّي","وحُنُوٌّ وجَدْتُه في جَفاكا",5,"ك",2,0],["لك قلب فسله يا","قيس ينبئك بالخبر",6,"ر",1,0],["لَكِ قِسْطٌ مِنَ المَعَارِفِ مَوْفُو","رٌ وَقِسْطٌ مِنْ رَاقِيَاتِ الفُنُونِ",7,"ن",1,0],["لك قد لجأت بذلتي وبزلتي","وبعبإ اوزاري وهم عنائي",8,"ا",2,0],["لكَ قَلبٌ مثلُ قلبي","طامحٌ يَسمو ويَهوَى",9,"ه",3,0],["لك قلبي يا يوسف الحسن خفا","قٌ ترفَّق فإنني يعقوب",10,"ب",1,0],["لك قد رمت وجوداً فأبى","وحوى رسمك أما وأبا",11,"ب",2,1]]}