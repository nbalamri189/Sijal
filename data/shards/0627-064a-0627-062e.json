{"poems":[[55,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[65,"أعد نظرا هل شارف الحي ثهمدا","https://www.aldiwan.net/poem45830.html","الطويل"],[65,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[65,"هو الطيف تهديه إلى الصب أشجان","https://www.aldiwan.net/poem46203.html","الطويل"],[79,"كن من صروف الردى على حذر","https://www.aldiwan.net/poem36441.html","المنسرح"],[79,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[53,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[45,"أيا خدد الله ورد الخدود","https://www.aldiwan.net/poem9535.html","المتقارب"],[82,"أيا خلج المدامع لا تغيضي","https://www.aldiwan.net/poem31397.html","الوافر"],[77,"تظلم منا الحب والحب ظالم","https://www.aldiwan.net/poem69037.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9991","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54837","الكامل"],[79,"دعاكَ بأقصى المغربينِ غريبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33820",""],[53,"أشدْ بأيامنا لتَشهرَها","https://www.poetsgate.com/ViewPoem.aspx?id=29178",""],[164,"أيرجو أن يزور وأن يزارا","https://www.aldiwan.net/poem58952.html","الوافر"],[193,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[234,"كل حي إلى الفناء يصير","https://www.aldiwan.net/poem51107.html","الخفيف"],[275,"الكون بالطيب والأنوار حياك","https://www.aldiwan.net/poem35436.html","البسيط"],[295,"هند عذراء أسلمتها المقادير","https://www.aldiwan.net/poem11680.html","الخفيف"],[325,"أيا خير من رقى العزيز لرتبة","https://www.aldiwan.net/poem67160.html","الطويل"],[353,"أيا خاضب الشيب حتى متى","https://www.aldiwan.net/poem20144.html","المتقارب"],[406,"أسد الشيشان","https://www.aldiwan.net/poem6792.html","عموديه"],[447,"ألا فانظروني بعين الصفا","https://www.aldiwan.net/poem14312.html","المتقارب"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104027","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34403","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59190","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59432","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59424","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35403","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35355","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61251","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79878","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108535","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102067","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102070","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132259","الطويل"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106702","الطويل"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106703","الطويل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114038","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118314","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102138","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27667","الطويل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105666","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204873","الطويل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82835","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88998","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74059","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52977","الرجز"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45904","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129372","المتقارب"],[3643,"","https://poetry.dctabudhabi.ae/diwan/poem/145185","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110059","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109945","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85073","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85154","الوافر"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130560","السريع"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102997","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40124","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111404","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94772","الوافر"],[4269,"","https://poetry.dctabudhabi.ae/diwan/poem/199862","السريع"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117272","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117271","الطويل"],[4429,"","https://poetry.dctabudhabi.ae/diwan/poem/138861",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139627",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139540",""],[4721,"أيا خير مبعوث إلى خير أمة","https://www.poetsgate.com/ViewPoem.aspx?id=181284",""],[4830,"أبا الفضل","https://www.poetsgate.com/ViewPoem.aspx?id=206564",""],[4852,"خِضر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215938",""],[4908,"سلامي دون الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=209092",""],[5121,"يا دمعي","https://www.poetsgate.com/ViewPoem.aspx?id=33667",""],[5135,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=201800",""],[5322,"فما لسناء النور لاح بقبلة","https://www.poetsgate.com/ViewPoem.aspx?id=120394",""],[5408,"ظلان أنت","https://www.poetsgate.com/ViewPoem.aspx?id=190583",""],[5431,"أنا المذبوح والشعر الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=186338",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5459,"بعثة الرحمة المهداة","https://www.poetsgate.com/ViewPoem.aspx?id=190905",""],[5704,"هديل الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=191083",""],[5847,"مولد الهادي عليه الصلاة والسلام 1436ه","https://www.poetsgate.com/ViewPoem.aspx?id=176762",""],[5956,"وأسعى إلى الغمض عنك وأعيا","https://www.poetsgate.com/ViewPoem.aspx?id=194597",""],[5956,"لقاءُ القلوبِ الطيبة","https://www.poetsgate.com/ViewPoem.aspx?id=207912",""],[5977,"منهل الحب","https://www.poetsgate.com/ViewPoem.aspx?id=213084",""],[6106,"إلى رحمات الله ، يا أبا فيصل","https://www.poetsgate.com/ViewPoem.aspx?id=7000",""],[6213,"دنان العشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85492&r=&rc=95",""]],"verses":[["أَيا خاطِباً وُدّي عَلى النَأيِ إِنَّني","صَديقُكَ إِن كُنتَ الحُسامَ المُهَنَّدا",0,"د",2,0],["أَيا خَيرَ مَن يُهدى إِلَيهِ مَدائِحٌ","يَضُمُّ قوافيها الثَّناءَ المُخَلَّدا",1,"د",2,0],["أيا خَيْرَ مَنْ لاذَ القَريضُ بسَيْبِهِ","وأعْنَقَ مَدحي في ذَراهُ وأوْضَعا",2,"ع",2,0],["أيا خَيرَ مَنْ يَتلوهُ في غَزَواتِهِ","على ثِقَةٍ بالشَّبْعِ نَسْرٌ وسِرْحانُ",3,"ن",1,0],["أيُّ اخْتبارٍ لمْ يألُ نصْبَتَهُ","في جسَدٍ للنّحوسِ أو نظَرِ",4,"ر",1,0],["أَيَا خَاتِمَ الرُّسْلِ الْمَكِينِ مَكَانُهُ","حَدِيثُ غَرِيبِ الدَّارِ فِيكَ غَرِيبُ",5,"ب",1,0],["أَيا خلالاً كَمُلْنَ فيه لقد","حسَّنها اللَه ثم كثَّرها",6,"ر",3,0],["أَيا خَدَّدَ اللَهُ وَردَ الخُدودِ","وَقَدَّ قُدودَ الحِسانِ القُدودِ",7,"د",1,1],["أيا خُلُجَ المدامعِ لا تغيضي","وَذُوبي غَيْرَ جامدةٍ وَفيضي",8,"ض",2,1],["أيأخُذُ منه الفَجرُ والفَجرُ ساطِعٌ","ويثبُتُ فيهِ الليلُ والليلُ فاحم",9,"م",1,0],["أَيَأخُذُ عَبلَةً وَغدٌ ذَميمٌ","وَيَحظى بِالغِنى وَالمالِ دوني",10,"ن",2,0],["أَيْ إِخْوَتِي هَذَا مُرَبِّينا الّذي","لِهُدَاهُ فِي أَعْيَانِنا آثَارُ",11,"ر",1,0],["أيا خاتِمَ الرُّسْل المكين مكانُهُ","حديثُ الغريبِ الدار فيك غريبُ",12,"ب",1,0],["أيا خلال كَمُلْنَ فيه لقد","حسَّنها الله ثم كثَّرها",13,"ر",3,0],["أَيا خير الملوك ولا أُحاشي","إِذا قلت الجميع ولا أُمارا",14,"ر",2,0],["أَيا خيرَ الأنام بكلّ خيرٍ","وَخيرَ خيارهم نَسباً ونسلا",15,"ل",2,0],["أيُّ أخلاقك الرضيَّة يُرْثَى","رأيك العَضْب أم سناك المنير",16,"ر",1,0],["أيأخُذُ النورَ والأطيابَ منكِ لنا","أم مِنهُ نورُكِ يا ليلى وريّاك",17,"ك",1,0],["أي أخي لا تني ومزق جناني","أنا بالقتل والمنية أحرى",18,"ر",2,0],["أَيا خَيرَ مَن رَقى العَزيزَ لِرُتبَةٍ","وَيا خَيرَ مَن حازَت سَناهُ المَحاكِمُ",19,"م",1,1],["أَيّا خَاضِبَ الشَّيْبِ حَتَّى مَتَى","تُسَوّدُهُ وَهْوَ يَسْتَعْبِدُكْ",20,"ك",1,1],["أيا خطاب أمتنا التقين","على حُلم المجاهد والأديب",21,"ب",1,0],["أيا خاطر أنت في خاطري","مقيمٌ على عهد صدق الوفا",22,"ف",2,0],["أَيأخذُ دمعي حُرَّ خدّى بما جنى","فؤادي لقد أخطأ مكانَ انتصارهِ",23,"ه",1,0],["أَيا خَيرَ خَلقِ اللَه دَعوَةُ مُذنب","تَخوّف مِن نار الجَحيم توقّدا",24,"د",2,0],["أيَا خَالَهَا الشُّحْرُورَ فِي رَوْضِ خَدّهَا","عَلَى قَدّهَا نَاغِ وَغَنّ وَغَرّدِ",25,"د",1,1],["أيا خاتم الإرسال يا خير خاتم","ويا فاتح العلياء من قبل آدم",26,"م",1,1],["ايا خاتم الأرسال يا فاتح العلا","حنانيك قد وافيت بابك مجرما",27,"م",2,0],["أَيا خَيرَ أَهلِ الأَرضِ بَيتاً وَمَحتِداً","وَأَكرَمَ كُلِّ الخَلقِ عُجمٍ وَعُربانِ",28,"ن",1,0],["أَيا خَيرَ مَن زَمَّ الرِكابُ مَطِيَّهُم","إِلَيهِ وَحَثّ اليَعملاتِ حَجيجُ",29,"ج",1,0],["أَيا خَير من مد العفاة أَكفهم","إِلَيهِ وَيا أَهل الندى وَالتكَرم",30,"م",1,1],["أيا خير مَن يرتادُه أملُ الورى","فمبصرُه في روضةٍ منه يُحبر",31,"ر",1,1],["أيا خدَّ كساب الذي طاب ورده","تلاف تلافي فالفؤاد مصاب",32,"ب",1,1],["أيا خاتم الارسال أحمدنا الذي","سما مجده فوقا على ذي الخليقة",33,"ه",1,0],["أيا خير مخلوق ويا سيد الورى","وأحمدنا المرجو لحسن العوائد",34,"د",1,0],["أيا خاتم الرسل الكرام وصحبه","أضفت لكم نفسي وإني على خطر",35,"ر",1,0],["أيا خيرَ مَن أمَّ القَرِيضُ فِنَاءَهُ","وأُعمِلَ في إطرَاءِ أوصَافِهِ الفِكرُ",36,"ر",1,0],["أيا خيرَ مَن تَفتَرُّ عَن مَكرُمَاتِهِ","إذَا شَقشَقَ النادي الأحاديثُ والذكرُ",37,"ر",1,0],["أيا خَتّانُ ما اقساك قَلباً","وما اقصاك عن سمة الحنان",38,"ن",1,0],["أيا خير من يحمي ويا خير من يهب","لذي الرغب الراجي الجدى ولذي الر",39,"ر",1,1],["أيا خير الوجود متّى أراكا","متى يُروى فؤادي من حلاكا",40,"ك",2,0],["أيا خير مصحوبٍ ويا خير صاحب","عليكَ اتكالي في جميعِ مطالبي",41,"ب",2,1],["أيأخذ كله غصباً ومنه","يكال إليك بالصاع الطفيف",42,"ف",1,0],["أيا خبراً غذّى فؤادي مصبّحاً","غنيت به عن سكرة وصبوح",43,"ح",1,1],["أَيا خَيرَ جَرّاح بمصرَ وَغيرها","وَمَن هُوَ بِالفَضلِ الغَزير شَهيرُ",44,"ر",1,0],["أيا خجلي وقد قالوا علام","أيا درويش قد مدح الشهابُ",45,"ب",1,1],["أَيا خَليليّ خلّياني","وَيا عَذوليّ لا تَلوما",46,"م",2,0],["أيا خليليّ دعَا","ذِكْرَ السِّوَى واستمعا",47,"ع",2,1],["أَيا خَير مَن جَلا شُموس هُدى إِذا","ضَلَلنا وَيا تاج الفَخار وَمَن جَلا",48,"ل",2,1],["أيا خير غاز غزا فانتصر","ويا خير عاف عفا مذ قدر",49,"ر",1,1],["أيا خير خلق الله أنهيت قصتي","إليك فإن الجسم بالقسم يرزأ",50,"ا",1,0],["أَيا خيرَ خَلقِ اللَهِ اني لقَائلٌ","بكِ الحقَّ مِصداقاً وما انا زاعمُ",51,"م",1,0],["أَيا خيرَ حِبٍ مات بالحُبِّ شاهداً","بتاريخ يا حِبّاً قضى مستشهدا",52,"د",2,0],["أيا خير بحر ما له من سواحل","لوراده منه حلا الورد والصدر",53,"ر",1,0],["أيا خلا سما خلقاً وخلفاً","ويا صنوا علا فعلاً ونطقا",54,"ق",2,1],["أيا خليليّ وحسبي ضنى","قولي شوقا يا خليلان",55,"ن",1,0],["أيا خير منعيّ إلى الناس كلّهم","أصمّ بك الناعي وإن كان أسمعا",56,"ع",2,1],["أيا خيرَ الملوكِ أباً وجَدّاً","وأَنقعهم حيّاً لغليلِ صادِ",57,"د",1,1],["أَيا خَرِيسُ اَغامَمنُونُ أَرسَلَنِي","لِرَدِّ بِنتكَ واستدراكِ ما حَصلا",58,"ل",2,0],["أيا خير ربٍّ جاءني الآن يسأل","فمن أنت قل هل كنت أمري تجهل",59,"ل",1,0],["أيا خدنا ودوداً اصطفيهِ","أيغدرني الزمان وأنت فيهِ",60,"ه",1,0],["أَيَّ أَخٍ أَنْتَ لَدَي وَجِدْهِ","تَرَكْتَهُ بالعَرِّ فِي جَحْفَلِ",61,"ل",1,0],["أيا خير خلق اللَه أدعوك راجيا","وما كان من يرجوك يرجع خائبا",62,"ب",2,0],["أيا خير خلق اللَه كن لي مؤمّلا","فلم أتخذ ركنا سواك ولا كهفا",63,"ف",2,0],["أيا خير مأمول ويا خير من به","يلوذ نزيل في الورى ودخيل",64,"ل",1,0],["أيا خير مَن لاذت بساحته العلى","وراق لها فيه من العيش ناكده",65,"د",2,0],["أيّ أختٍ رأت اخاها جديلاً","جلببته الرياح في جلباب",66,"ب",1,0],["أى اختٍ سارت ورأس اخيها","فوق رمحٍ أمامها كالشهاب",66,"ب",1,0],["أيا خير مبعوث إلى خير أمة","نصحت وبلغت الرسالة والوحيا",67,"ي",2,1],["أيأخذُ منكَ الصدى مِرفَقا","ومن راحتيكَ الغَمامُ استقى",68,"ق",2,1],["أيا(خِضرَ)الهوى مااسطعتُ صبرا","أكان هواك كنزا؟ أم جدارا؟",69,"ر",2,0],["آيا خلاه رفقا في سقامي","تعيش النفس في حالة سقاما",70,"م",2,0],["أيا خوفي على قلبي إذا ينهيكْ","سيصلى نارَ أشواقي عسى يفديكْ",71,"ك",1,0],["أيَا خِلّاً سَكَنْتَ الْقَلْبَ مَهْلاً","تَجَاوَزْتَ الْجَفَاءَ إلَى التَّجَنِّي",72,"ن",2,1],["أيا خير من يأتيه أهل خصاصة","ويا خير من يدعى لدفع ملمة",73,"ه",1,0],["أيّ اختلافٍ وجيشُ النمْلِ يلحَقني","فضيّعَ الدّربَ في وادي النوى النّمْلُ",74,"ل",1,0],["أيا خمري ويالذات عمري","كأنك في تهجدي السجودُ",75,"د",1,0],["ايا خير البلاد هوئً","فغيرك لانرئ احدا",76,"د",2,0],["أَيَا خَيْرَ البَرِيئَةِ يَا رَسُولاً","مِنَ الرحمان أبْعَدَ كُلَّ وَهْمِ..",77,"م",1,0],["أيا خمريَّةَ الشفتين عطفًا","بهذا الخِلِّ هطَّالِ الجفون",78,"ن",1,0],["10- ايا خير العباد قد اجتمعنا","بحبك والصلاة عليك طيبُ",79,"ب",1,0],["أيا خير مقدورِ ربي أ تَكفي","صلاتي وصومي لأغدو وفيا؟",80,"ي",2,0],["أيا خادمَ الناس من دون مَنٍّ","ولا طمعٍ باكتسابِ الثَّناءِ",81,"ا",2,0],["أيا خير النساء فدتك روحي","ونبض القلب يا عذب السجايا",82,"ا",3,0],["أيا خادم الحرمين أكرمت ضيفه","ومُكرِم ضيف الله لا شك مُكْرَم",83,"م",1,0],["أيأخذني إلى بحرٍ","بلا إنس ولا جان !",84,"ن",1,0]]}