لغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"],[577,"إن الحبيبة حبها لم ينفد","https://www.aldiwan.net/poem1785.html","الكامل"],[580,"نفسي تميل إِلى الهوى فأَردها","https://www.aldiwan.net/poem56776.html","الكامل"]],"verses":[["قَد طالَ في ثَوبِ الهُمومِ تَزَمُّلي","فَلَآخُذَنَّ لِنَهضَتي مِن مَقعَدي",0,"د",2,0],["قَد طالَما لَبِسَ الحَديدَ فَإِنَّم","صَدَأُ الحَديدِ بِجِلدِهِ لَم يُغسَلِ",1,"ل",1,0],["قَد طالَ عِزَّكُم وَذُلّي في الهَوى","وَمِنَ العَجائِبِ عِزَّكُم وَتَذَلَّلي",2,"ل",2,0],["قَد طُفتُ ما بَينَ بانِقيا إِلى عَدَنٍ","وَطالَ في العُجمِ تِرحالي وَتَسياري",3,"ر",2,0],["قَد طَواهُ الرَدى وَلَو كانَ حَيّاً","لَمَشى في رِكابِكِ الثَقَلانِ",4,"ن",1,0],["قَد طالَ ما تَجَرَّمَ الذُنوبا","وَلَم يَدَع في العُذرِ لي نَصيبا",5,"ب",2,0],["قد طالت السفرا","واوحشن صحب الدار",6,"ر",1,0],["قد طال شكواي من دهر أكابده","أما أصادف حرّاً فيه يُشكيني",7,"ن",2,0],["قَد طالَ قَرعُكَ قَبلَ ذاكَ صَفاتَنا","حَتّى صَمِمتَ وَفُلِّلَ المِنقارُ",8,"ر",1,0],["قَد طالَ قَولي إِذا ما قُمتُ مُبتَهِلاً","يا رَبِّ أَصلِح قِوامَ الدينِ وَالبَشَرِ",9,"ر",1,0],["قَد طالَ حُبُّكَ لَو يُساعِفُكَ الهَوى","نَجداً وَأَنتَ بِنَخلَتَينِ تُهامي",10,"م",2,0],["قَد طالَما وَأَبيكَ ذُدنا عامِراً","بِالخَيلِ وَالرُؤَساءِ مِن هَمّامِ",10,"م",1,0],["قَد طالَ ياقَلبُ ماتُلاقي","إِن ماتَ ذو صَبوَةٍ فَكُنهُ",11,"ن",2,0],["قَد طَلَعَ العيدُ عَلى أَهلِهِ","بِوَجهِ لاحُسنٍ وَلا طيبِ",12,"ب",1,0],["قد طيروني وإن أخَّرت مطلبهم","طاروا إليكَ ذرافاتٍ ووحدانا",13,"ن",2,0],["قد طالَ إصغائي إلى مخبر","عن راتبي فامْنن جزيت الجنان",14,"ن",1,0],["قد طبخت بالشوقِ أكبادهم","فيا لها طبخة قمحيَّه",15,"ه",1,0],["قد طلع البدر مع الزُّهرهْ","في دولة مونقةِ الزّهرهْ",16,"ر",2,1],["قد طَوى قَرناً فقرناً","وأناساً فأناسا",17,"س",2,0],["قد طال تأميلي غداً وقد انقضى","عُمري وعمرُ المطل باقٍ ما انقضى",18,"ض",2,0],["قد طال ما غلب الكثي","رَ من العديد بها الأقلُّ",19,"ل",1,0],["قَدْ طَحَنَّاه واعتصرناه يا بي","نُ فكُلْ كسبَه وأسرِجْ بدهنه",20,"ن",2,0],["قد طال بسطُك آمالي وقد ملأتْ","عرضَ الفضاءِ فخلِّ الرِّفدَ يطويها",21,"ه",2,1],["قَد طُفتُمُ الدُنيا فَهَل شاهَدتُمُ","جَبَلاً عَلَيهِ مَهابَتي وَسُكوني",22,"ن",2,0],["قَد طُبِعَ السَيفُ لِحَزِّ الرِقاب","وَهَذِهِ رَقبَةُ ثَرثارِ",23,"ر",1,0],["قَد طالَ في الوَعدِ الأَمَد","وَالحُرُّ يُنجِزُ ماوَعَد",24,"د",1,1],["قَد طالَ لَيلُ الهَجرِ فاِجعَل لَنا","بالوَصلِ في آخرِهِ فَجرا",25,"ر",2,0],["قَد طلعتُم بِها شُموساَ صَباحاً","فاِطلَعوا عِندَنا بُدورا مَساءَ",26,"ا",2,0],["قد طمى في غرام مصر جنانك","وبه قد مضى يفيض لسانك",27,"ك",1,0],["قد طلبنا التحرير للشعر حتى","كثرت في الطلاب منا الضحايا",28,"ي",2,0],["قد طلعت في موكب","من افخم المواكب",29,"ب",1,0],["قد طلبت الفرار من فتنة تة","شك بالقوم نارها ان تحيقا",30,"ق",2,0],["قد طلبت الماء اع","دو واذا الماء سراب",31,"ب",1,0],["قد طال للغرب فوق الارض سلطان","وطال في الشرق اقرار واذعان",32,"ن",1,1],["قد طحا بالفلاح يقسو الفرات","وله كانت منه تأتي الحياة",33,"ه",1,1],["قد طغى يطفح الفرات وعبا","يملأ الانفس الجريئة رعبا",34,"ب",2,1],["قد طلب النسل بأكثاره","وطء عذارى مالها بعلُ",35,"ل",1,0],["قَد طابَ مُغتَبَقُ الزَمانِ وَنُشِّرَت","حُلَلُ الرَبيعِ كَأَنَّهُنَّ السُندُسُ",36,"س",1,0],["قَد طَلَبنا فَلَم نَجِد لَكَ في السُؤ","دُدِ وَالمَجدِ وَالمَكارِمِ مِثلا",37,"ل",2,0],["قَد طالَ بي عَهدٌ وَهَزَّ جوانِحي","شَوقٌ فَجِئتُ مِنَ الشَآمِ مُسَلِّما",38,"م",2,0],["قَد طَواهُنَّ طَيُّهُنَّ الفَيافي","وَإِكتَسَينَ الوَجيفَ حَتّى عَرينا",39,"ن",2,0],["قَد طالَ لَيلي وَأَجفاني بِهِ قَصُرَت","عَنِ الرُقادِ فَلَم أُصبِح وَلَم أَنَمِ",40,"م",1,0],["قد طَرَقَ البابَ فتىً متعبُ","طالَ به السيرُ وكلَّت خطاه",41,"ا",2,0],["قد طواه اليوم في بردته","وأتى الليل عليه فانفجر",42,"ر",1,0],["قد طال عتبي على الليالي","وطال للراحم انتظاري",43,"ر",2,0],["قد طَيّبَ الآفاقَ طيبُ ثنائِهِ","حتى كأنّ الشمسَ تذكي المَندلا",44,"ل",2,1],["قَدْ طَالَمَا زَجَرْتُهُ","يَا لَيْتَهُ كَانَ ارْعَوَى",45,"و",2,0],["قَدْ طَالَمَا عَزَّ بِهِ مَعْشَرٌ","وَرُبَّمَا أَزْرَى بِأَقْوَامِ",46,"م",1,0],["قدْ طبَّقَ الأرضَ الوبا","وقدْ بدا في حَلَبا",47,"ب",2,1],["قَد طالَ مَطلي لَوَ أَنَّ اليَأسَ يَنفَعُني","أَو أَن أُصادِفَ مِن تِلقائِها جودا",48,"د",2,0],["قَد طَنَّبَ المَجدُ بَيتاً","فيهِ وَعَرَّسَ وَفدا",49,"د",2,0],["قَد طَبَعَ الحُسنُ بِهِ دِرهَماً","تَسبُكُ مِنهُ العَينُ دينارا",50,"ر",2,0],["قَد طابَ ذِكرُكَ حَتّى الشَهدُ مُطَّرَحٌ","وَفاحَ حَتّى اِستُبينَ المِسكُ وَالبانُ",51,"ن",1,0],["قَد طَواها التَسويقُ وَالشَدُّ حَتّى","هُنَّ قُبٌّ كَأَنَّهُنَّ الرَكِيُّ",52,"ي",1,0],["قَد طالَ عَهدي بِالإِمامِ وَأُخلِفَت","أَسبابُ وَعدٍ كادَ يُدرَسُ ذِكرُهُ",53,"ر",2,0],["قد طالَ ما طُرِدُوا عنها وما انْطَرَدُوا","إلاَّ وَقَومٌ عليها كالذَّبابينِ",54,"ن",1,0],["قد طيّبَ الأفواهَ طِيبُ ثنائِهِ","فَمِنَ اجلِ ذا نجدُ الثّغورَ عِذابا",55,"ب",2,0],["قَد طَوى بَطنَها عَلى سَعَةِ العَي","شِ ضُمورٌ في حَقوِها وَاِنطِواءُ",56,"ا",2,0],["قَد طالَما أَوطَنَ بِالأَحرازِ","عُلِّقَهُ بِالجَدجَدِ البَرازِ",57,"ز",1,0],["قَد طالَما أَفلَتَّ يا ثُعالا","وَطالَما وَطالَما وَطالا",58,"ل",2,1],["قَد طَبَّقَ الغَورَ وَأَعلى نَجدِ","يَستَنُّ فيهِ كَالنَعامِ الرُبدِ",59,"د",1,0],["قَد طالَ في العيشِ تَقيِيدي وَإِرسالي","مَنِ اِتَّقى اللَهَ فَهوَ السالِمُ السالي",60,"ل",2,1],["قَد طالَ سَيري في الحَيا","ةِ وَلي بِبَطنِ الأَرضِ مَنزِلِ",61,"ل",1,0],["قَد طالَ عُمرِيَ طولَ الظُفرِ فَاِتَّصَلَت","بِهِ الأَذاةُ وَكانَ الحَظُّ لَو قُلِما",62,"م",2,0],["قَد طَرِبنا إِلى المَهاري تَبارى","بِالأَصاحيبِ غَدوَةً وَعَشِيَّه",63,"ش",3,0],["قد طالَ حتى خلت أن نجومه","مربوطة في جوفه بعروقي",64,"ق",2,0],["قد طالَ عهد شقائها","فَبَكَت فَلَم يَنفَع بكاها",65,"ا",3,0],["قد طَلعت في خيلعِ","فَيا لحسن المطلعِ",66,"ع",1,1],["قد طلعت من غير در","عٍ ساتر أَو مقنع",66,"ع",1,0],["قد طلعت ككوكبٍ","بالغ في التلمُّع",66,"ع",1,0],["قد طواها الليلُ حتى أوشكتْ","من عميقِ الصمتِ فيه أنْ تُراعا",67,"ع",2,0],["قد طواها النسيانُ إلَّا شعاعاً","غمر الرُّوحَ في بقيةِ نورِ",68,"ر",1,0],["قَد طالَما لَبِسَ الحَديدَ فَإِنَّما","صَدَأُ الحَديدِ بِجِلدِهِ لَم يُغسَلِ",69,"ل",1,0],["قَدْ طَالَمَا يَا قَلْبُ قُلْتُ لَكَ احْتَرِسْ","أَرَأَيْتَ كَيْفَ يَخِيبُ مَنْ لَمْ يَسْمَعِ",70,"ع",1,0],["قَدْ طافَ نِلْسُنْ حَوْلَ أُسْطُولكُمْ","مُسْتَصْرِخاً غَضْبَانَ مُسْتَفْزِعا