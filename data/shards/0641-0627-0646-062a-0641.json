3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102343","الوافر"],[3012,"","https://poetry.dctabudhabi.ae/diwan/poem/147545","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74261","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100763","المتقارب"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112669","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112642","الرجز"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28857","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145148","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108173","الطويل"],[3777,"","https://poetry.dctabudhabi.ae/diwan/poem/145653","المجتث"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114654","الطويل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88556","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111467","الطويل"],[4683,"عصر شبابي في الهوى عذبا صفا","https://www.poetsgate.com/ViewPoem.aspx?id=166757",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4983,"انسكاب","https://www.poetsgate.com/ViewPoem.aspx?id=10973",""],[4984,"\" ليس الأدل \" 2","https://www.poetsgate.com/ViewPoem.aspx?id=175833",""],[4984,"دوامة الفتن","https://www.poetsgate.com/ViewPoem.aspx?id=180639",""],[5065,"سبحة الإنطواء","https://www.poetsgate.com/ViewPoem.aspx?id=205183",""],[585,"أهلاً بيوم هو الأحقاب والسير","https://www.poetsgate.com/ViewPoem.aspx?id=161900",""],[585,"ذكرت له أيامنا فتنهدا","https://www.poetsgate.com/ViewPoem.aspx?id=161845",""],[5136,"عاد عليك العيد عام فعام","https://www.poetsgate.com/ViewPoem.aspx?id=121722",""],[4045,"أحاجيكم ماقوس لحم سهامها","https://www.poetsgate.com/ViewPoem.aspx?id=200267",""],[5853,"((رسالة الى بياض الثلج ))","https://www.poetsgate.com/ViewPoem.aspx?id=175648",""],[5853,"رؤى الحب","https://www.poetsgate.com/ViewPoem.aspx?id=175649",""],[5879,"ما رام قلبي حقلا لست جدوله","https://www.poetsgate.com/ViewPoem.aspx?id=215461",""],[5974,"مُلْهِمَتِي","https://www.poetsgate.com/ViewPoem.aspx?id=201158",""],[6031,"أهْدِي إليْكُمْ علَى بُعْدِ الدِّيَارِ لَكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=46390",""],[523,"هل لُغْزِي هذا مَفْهُومٌ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=100021",""],[6355,"الناصحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66568&r=&rc=28",""],[6355,"تغليف الجراح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66646&r=&rc=106",""]],"verses":[["فَاِنتَفِق في الوِجارِ وَاُقعُد ذَليلاً","قَد كَفاكَ الجُلّى رِجالٌ قِيامُ",0,"م",1,0],["فَاِنتَفِضي أَيُّها الرُؤوسُ لَها","وَاِستَوثِقي لِلقِيادِ يا إِبِلُ",1,"ل",1,0],["فَإِن تَفعَلا خَيراً وَتَرتَدِيا بِهِ","فَإِنَّكُما أَهلٌ لِذاكَ كِلاكُما",2,"م",2,0],["فَأَنتَ فَخرُ النَصارى","وَصاحِبُ المُسلِمينا",3,"ن",2,0],["فأنتَ في زَمَن المُختارِ مُنجِدُها","وأنتَ في زَمَنِ الصِّدِّيقِ مُنْجِيها",4,"ي",3,0],["فَإِن تَفتَدوني تَفتَدوا شَرَفَ العُلا","وَأَسرَعَ عَوّادٍ إِلَيها مُعَوَّدِ",5,"د",1,0],["فأنتَ في رتب العليا وما وسعت","بحرٌ تحدَّث عنه البحر بالعجب",6,"ب",1,0],["فَأَنتَ في سِرِّ غَيب هَمّي","أَخفى مِنَ الوَهمِ في ضَميري",7,"ر",2,0],["فأنتِ في الفقحة مجروحةٌ","وأنت في الكَعْثَبِ مَعْفُوجَهْ",8,"ج",2,0],["فإن تفعل الحُسنَى فشكريَ راهنٌ","وإن تكنِ الأُخرى فعُذْريَ واسع",9,"ع",1,0],["فإن تفعلْ فأنتَ لِذاكَ أهلٌ","وإن تمنع فلستُ ألومُ عدلك",10,"ك",1,0],["فأَنتفُ ما أهوى بغير إرادتي","وأَتْركُ ما أَقْلى وأنفيَ راغمُ",11,"م",1,0],["فَأَنتَ في أَلسُنِ الأَشياخِ إِن نَطَقوا","وَأَنتَ في هِمَمِ الشُبّانِ إِن وَثَبوا",12,"ب",3,0],["فأنت في غفلتك الغبيه","أشبه بالبهائم الوحشيه",13,"ي",2,0],["فَإِن تَفَضَّلتَ بِاِنصِرافي","عَدَدتُهُ مِن لَدُنكَ رِفداً",14,"د",2,0],["فَإِن تَفُقِ الأَنامَ وَأَنتَ مِنهُم","فَإِنَّ المِسكَ بَعضُ دَمِ الغَزالِ",15,"ل",1,0],["فإِن تفطنت فلا تبده","إلا تكن تبغي به الآخره",16,"ر",2,0],["فَإِن تَفخَر بِنا فَلَرُبَّ قَومٍ","رَفَعنا جَدَّهُم بَعدَ السَفالِ",17,"ل",1,1],["فَإِن تَفخَر بِحَمزَةَ حينَ وَلّى","مَعَ الشُهَداءِ مُحتَسِباً شَهيداً",18,"د",2,0],["فَإِنْ تَفَضَّلْتِ فَاقْبَلِي بَدَلاً","تَهْنِئَةً صَغْتُهَا مِنَ الشِّعْرِ",19,"ر",1,0],["فأنت في ألسن الأشباح إن","نطقوا وأنت في همم الشّبان إن وثبوا",20,"ب",3,0],["فإن تفخر الشهباء فالكون منصت","وحقّ بسيفي دولتيها لها الفخر",21,"ر",1,0],["فأنت فطيمة هزلاء قامت","تناطح رغم صبغتها الكباشا",22,"ش",2,0],["فانت في ذا البيت شيخ عصبة","كبارها تحنو الى صغارها",23,"ر",3,0],["فإن تفاخر كان الفخر عن أدب","وإن تذلل كان الذل عن سبب",24,"ب",1,0],["فانتفى الإنصاف والعدل عفا","وأسف الحكم فاستجبل سفح",25,"ح",1,0],["فإن تُفُرِّس بي ظنٌّ فموجِبُه","خَليفتاك علىَّ الدمعُ والسَّقَم",26,"م",1,0],["فأنت في الوحدة مستروح","من عيب ما قيل ومن قال",27,"ل",1,0],["فأنتِ في نظرِ الراقينَ سائمةٌ","وفي نواظرِ فلاحيهمُ وتدُ",28,"د",1,0],["فأنتَ في الخَلق لا وجهٌ ولا بدنٌ","وأنتَ في الخُلق لا عقلٌ ولا أدَبُ",29,"ب",1,1],["فَاِنتَفَضَت غَلواءُ من ذُعرِها","وَثارَت الأَنفاسُ في صَدرِها",30,"ه",2,0],["فأنت فيه رُشْد من لم يرشُد","ورِفْدُ مَنْ أكدى ولم يسترفِد",31,"د",1,0],["فأنت في الصدر أحلى","من المنى جوف صدري",32,"ر",2,0],["فَأَنتَ في دَهرِكَ يا ذا العُلى","أَفضَلُ مَن صامَ وَمَن عَيَّدا",33,"د",2,0],["فانتفتِ الفوضى وقرَّ","الأمرُ بعد الشغب",34,"ب",1,0],["فإن تفعل أكونن يا خليلي","أخا لك ما تآخى الفرقدان",35,"ن",1,0],["فانَ تفه بِبَديع","فَهو البَديع المُتمم",36,"م",1,0],["فأنت في إيصالِ سَيْبِ كفِّه","مُستَخلِفٌ للقائمِ المُستَخَلف",37,"ف",1,0],["فَأَنتَ في عُذرٍ إِذا لَم تَكُن","طَريقُكَ اليَومَ عَلى ناظِري",38,"ر",2,0],["فأنت في جيد العلى والدُّنا","طوق به هذا وذا طوقا",39,"ق",2,0],["فأنتَ فُدِيتَ للإِسلام حصنٌ","وسُورٌ للشريعة أَيُّ سور",40,"ر",1,0],["فإنْ تفضلتَ فالفض","لُ شيمةُ المِفْضالِ",41,"ل",1,0],["فإن تفتها فما الإسلام ملتها","وكل مدح لها نوح وتعديد",42,"د",1,0],["فأنتَ في الميراثِ في قُعدُدٍ","منها بحقٍّ عنه لم تُزحَمِ",43,"م",1,0],["فأنت في الخطْبِ الفَظيعِ الحِمى","وأنت في الجدْب الشَّنيعِ الغَمامْ",44,"م",1,0],["فانتَفَضْنا.. كانَ العراقُ يُنادي","هائِلَ الجُرح ِ، مُستَفَزَّ الجَلال ِ",45,"ل",1,0],["فَإِن تَفَضَّلتَ عَلَينا بِها","فَهِمَّةٌ حُسنى وَرَأيٌ جَميل",46,"ل",1,0],["فأنتَ في رُكْبانهمْ","بِساحةِ اللُّطْفِ الخَفي",47,"ف",2,0],["فإن تفتخر بأبيك الرّشيد","ملأتَ لنا الخافقين اِفتخارا",48,"ر",2,0],["فأنت في القول بذاك أعلم","فاحكم إذا شئت بما قد تحكم",49,"م",1,0],["فأنت في حادث كل أمر","سيفي ودرعي وأخي وصهري",49,"ي",1,0],["فأَنت في القبر حيٌّ مُدْرِكٌ فَرحٌ","ما كلُ من ماتَ معدوداً من الرِّمَمِ",50,"م",1,0],["فأَنت في التُّرْبِ حَيٌّ مُدْرِكٌ فرِحٌ","ترْنُو لشخْصِي بَلْ تُصغِي لإِنْشادِي",51,"د",2,0],["فأَنتَ فتاها ونعِمْ الفَتى","وأَيُّ فتىً كان إِلاَّ عَلي",52,"ل",2,0],["فأنت في جنة الفردوس راتعة","تنعمين وأبراراً بآلاء",53,"ا",2,0],["فإن تَفُدِ وهّاساً يداهُ فَهَينٌ","فدايةُ رأسِ القومش بالرِّجلِ واليد",54,"د",1,0],["فأنت في الكون بالأفلاك منحرف","وأنت بالرب في الإنسان معتدل",55,"ل",1,0],["فأنت في النفسِ في منامي","وفي قيامي وفي جلوسي",56,"س",2,0],["فَاِنتَفَخَت لَوقتها فَاِنفَقَعَت","وَحملتها أُختها وَرَجَعَت",57,"ت",1,0],["فإن تفخروا بابن الشريد فإنني","تركت بوج مأتماً بعد مأتم",58,"م",1,0],["فإنْ تَفَطَّنْتَ فيه","رأيتَ قولى صوابا",59,"ب",2,0],["فإن تفاخرْ أو تباهى بها","فهْي ابنْةُ الماءِ وبنتُ التراب",60,"ب",1,0],["فإن تفضلت ونفذتها","فما على المحسن يوما ضرر",61,"ر",1,0],["فأنت في استكانتي","وأنت في تمرّدي",62,"د",2,0],["فَإِنْ تُفِقْ راحِلَتِي وَرَحْلِي","فَقَدْ أَرانِي وَالصِبَا مِنْ شُغْلِ",63,"ل",1,0],["فإن تفوه في شيء وجدت له","نطقاً ثقيلا يحاكي الضرب بالحجر",64,"ر",1,0],["فَإِن تَفخَري يا جُملُ أَو تَتَجَمّلي","فَلا فَخرَ إِلّا فَوقه الدين وَالعَقل",65,"ل",1,0],["فانت فرع كرام طالما ضربوا","في قنة المجد بيتا ارضه حرم",66,"م",1,0],["فانتفى الوهم حين لاح من ال","سر لديه شواهد التمكين",67,"ن",1,0],["فَأَنتَ في القَلبِ في السُوَيدا","وَأَنتَ في العَينِ في السَوادِ",68,"د",1,1],["فَأَنتَ في نِزار رَأياً وَهَوى","لَم تَر في جوارِها ما يَجتوي",69,"ي",1,0],["فإن تفعل أمنت على التوالي","مغبات الهياج وطبت عِشره",70,"ه",1,0],["فانتفا لحيتي وجزا سبالي","وبنعل الكنيف فاستقبلاني",71,"ن",2,0],["فأنت في سلك عقد المجد واسطة","منه الممالك قد باهت بتقليد",72,"د",1,0],["فإن تفهم المعنى سلمت وما على","مصحح معناه الغباوة في البقر",73,"ر",1,0],["فَإِن تَفعَلِ المَعروفَ فيهِم فَقَد مَضَت","مَواهِبُ لا أَجرٌ عَلَيها وَلا حَمدُ",74,"د",1,0],["فأن تفخروا بما مضى من قديمكم","فقد هدمت مدائن وقصور",75,"ر",1,0],["فَأنتَ في أولِ قَفَاصي سَاير","على الحِمَارينِ فَخُذ أشَايِر",76,"ر",1,0],["فَإن تَفُل رَاسَ الحَمَامِ جَارِ","لِزَنجِبَارٍ وَهيَ في اليَسَارِ",77,"ر",1,0],["فان تفز بصالح الأساتذه","فلذ به وكن من التلامذه",78,"ه",1,0],["فإن تفخر بأمك من قريش","فقد ينزو على الفرس الحمارُ",79,"ر",1,0],["فأنت في سعة إن كنت تنسخه","وأنت من حبسه في ضيق الحرج",80,"ج",1,0],["فَأَنتَ فَتى لا يَنقض الكَرب حبلَه","وَهَضبة حلم لا يُزلزلها الخَطب",81,"ب",1,0],["فإن تفخروا بي فمثل افتخار ال","نبيّ بحسانه الأوحد",82,"د",1,0],["فانتَفَخَت من غَضَبٍ أوداجُهُ","وزادَ من مَقالِه هياجُهُ",83,"ه",1,0],["فإن تفضّلتَ علي يطبِ","ريحي ويَعلو في البرايا حسبي",84,"ي",1,0],["فَإِن تَفعَلا أَحمدْكُما وَلَقَدْ أَرى","بِأَنَّكُما لا يَنْبَغي لَكُما شُكْري",85,"ر",2,0],["فأنت في الدنيا أبو جهل الأدبْ","وسوف في الأخرى تُرى أبا لهبْ",86,"ب",1,0],["فإن تفعل فإنك سوف تحظى","بما ترجو وعقباك الخلود",87,"د",1,0],["فأنت فراديسَ الجنان مؤمم","ونحن أسى نبقى على جمراتِ",88,"ت",1,0],["فإن تفاءلت صحّف","تجد حبيبك لانا",89,"ن",2,0],["فان تفقدوا لا يؤلم الناس فقدكم","وان تذكروا لا يحسنوا لكم الذكرى",90,"ر",2,0],["فإن تفخر بقومِك من تميمٍ","فإنّ الأكمَ من صُمِّ الجبال",91,"ل",1,0],["فإن تفضض بها من بحر نجدٍ","فكم عضَبا وسارا بالرجال",91,"ل",1,0],["فإن تفعل فما في الخل","د ربٌّ خلته شكرا",92,"ر",2,0],["فَأَنتَ فَتًى لَو قِيسَ عُمرُكَ لَم يَكُن","لأَحدَثِ أَبنائِي الصِّغارِ مُساوِيا",93,"ي",2,0],["فأنت في نطق وحسن منظر","وحسن خلق كالنبي المصطفى",94,"ف",2,0],["فأنت فريد الدهر يا قطب عصرها","لك الدهر عبد خاضع خاشع عاني",95,"ن",2,0],["فأنت في القلب نبض لاحدود له","وفي الحكايات حبّ أنت أغربُهُ",96,"ب",2,0],["فانتفضت مفزوعة وارتضت","جهلى كما لو أنني من جهل",97,"ل",1,0],["فأنت في حلك الأحداث أكبر من","أن تنثني كدرا بالهم والشجن",98,"ن",1,0],["فَأَنتَ فِي العَالَمِ السُّفلِيِّ مَحضُ خُطىً","والقلبُ أصبحَ في العُلوِيِّ عُصفُورَا",99,"ر",2,0],["فأنت في الشرق روحٌ كله هممٌ","وأنت في الغرب آيٌ كلها غرر",100,"ر",1,0],["فإن تفعلوا خيراً فللشرق كله","وإلا هدمتم فيه ملكاً مشيدا",101,"د",2,0],["فأنت فرد الدهر إنسان عين","الفخر أنت الليث أنت الهمام",102,"م",1,0],["فان تفتخر يوما تميم بحاجب","وبالقوس مضمونا لكسري بها العرب",103,"ب",1,0],["فأنتِ في داخلي الغيداءُ ملهمةٌ","قصيدةٌ عذبةٌ يجري بها القلمُ",104,"م",1,0],["فأنتِ في شامنا زيتونةٌ حلفتْ","أن تنزع الأمرَ مما جار ..إذْ حلفا!",105,"ف",2,0],["فأنت في وهج الأقمار ساطعة","وعتمة الدرب شعّت في ثنايانا",106,"ن",2,0],["فَأَنْتِ فِي الْهَوَى لُغَتِي","وَخَمْرِي بَلْ وَمُؤْنِسَتِي",107,"ت",2,0],["فإنْ تَفَرَّقَ في النَّاسِ الأسَى فَغَدَا","سَهْمٌ لهَذا وهَذَا فَهوَ أجْمَعُ في",108,"ي",1,0],["فانتفضَ المالكُ إعصاراً","وانفجرُ البركانُ وثار",109,"ر",1,0],["فأنتَ فارسُنا في كلِّ نائِبَةٍ","تُوري مشاعرنا إنْ مسَّها الكَلَلُ",110,"ل",1,0],["فأنتِ في عالَمِ التَّزييف بارعةٌ","تُغَلِّفينَ جراحَ الذَّمِّ بالقُبَلِ",111,"ل",1,0]]}