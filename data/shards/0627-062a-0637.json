{"poems":[[53,"أتطمع أن ألقي إليك مقادتي","https://www.aldiwan.net/poem29791.html","الطويل"],[53,"أقول وقد جاز الرفاق بذي النقا","https://www.aldiwan.net/poem30530.html","الطويل"],[55,"قل لفوز ردي علي السلاما","https://www.aldiwan.net/poem26109.html","الخفيف"],[55,"أتطمع يا عباس في غير مطمع","https://www.aldiwan.net/poem26259.html","الطويل"],[88,"أما آن أن يغشى البلاد سعودها","https://www.aldiwan.net/poem44836.html","الطويل"],[27,"أتطرب حين لاح بك المشيب","https://www.aldiwan.net/poem5666.html","الوافر"],[27,"لقد نادى أميرك بابتكار","https://www.aldiwan.net/poem5777.html","الوافر"],[47,"دع العبرات تنهمر انهمارا","https://www.aldiwan.net/poem25286.html","الوافر"],[64,"إلى كم أنت في بحر الخطايا","https://www.aldiwan.net/poem67674.html","الوافر"],[29,"دعاني امرؤ أحمى على الناس عرضه","https://www.aldiwan.net/poem6058.html","الطويل"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[62,"أتطمع في المزاج وما تهيا","https://www.aldiwan.net/poem52186.html","الوافر"],[62,"ولما تراءى السرب قلت لصاحبي","https://www.aldiwan.net/poem52350.html","الطويل"],[62,"أقول له وأنضاء المهار","https://www.aldiwan.net/poem52411.html","الوافر"],[28,"ولست بنائل قمر الثريا","https://www.aldiwan.net/poem4950.html","الوافر"],[28,"لعمرك ما معن بتارك حقه","https://www.aldiwan.net/poem5185.html","الطويل"],[28,"ومنا الذي لا ينطق الناس عنده","https://www.aldiwan.net/poem5341.html","البسيط"],[58,"أتطلب رزق الله من عند غيره","https://www.aldiwan.net/poem30821.html","الطويل"],[49,"ألا لله أنت متى تتوب","https://www.aldiwan.net/poem10330.html","الوافر"],[49,"ما يرتجى بالشيء ليس بنافع","https://www.aldiwan.net/poem62159.html","الكامل"],[49,"ليبك على نفسه من بكى","https://www.aldiwan.net/poem62211.html","المتقارب"],[49,"أتطمع أن تخلد لا أبا لك","https://www.aldiwan.net/poem63044.html","الوافر"],[66,"أتطلب من أخ خلقا جليلا","https://www.aldiwan.net/poem38529.html","الخفيف"],[80,"ألا كم تسمع الزمن العتابا","https://www.aldiwan.net/poem31566.html","الوافر"],[44,"أتدري أي بارقة تشيم","https://www.aldiwan.net/poem30002.html","الوافر"],[33,"نهاري نهار الناس حتى إذا بدا","https://www.aldiwan.net/poem25887.html","الطويل"],[105,"أكانوا كلهم داء عياء","https://www.aldiwan.net/poem44053.html","الوافر"],[105,"ما الكيد ما الغدر ما هذي الأباطيل","https://www.aldiwan.net/poem44204.html","البسيط"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[7,"بخالة أو ماء الذنابة أو سوى","https://www.aldiwan.net/poem1987.html","الطويل"],[77,"أجِلُّك أن يلمَّ بك العتابُ","https://www.poetsgate.com/ViewPoem.aspx?id=33200",""],[64,"فيا من بات يخلو بالمعاصي","https://www.poetsgate.com/ViewPoem.aspx?id=8504",""],[28,"أنا ابن العاصمين بني تميم","https://www.poetsgate.com/ViewPoem.aspx?id=21512",""],[92,"أَتَفنى ابتساماتُ تَلك الجفونِ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14571&r=&rc=16",""],[130,"أبرق لاح من خلل الغمام","https://www.aldiwan.net/poem54734.html","الوافر"],[133,"أتطمع أن تذوق الغمض ليلا","https://www.aldiwan.net/poem49144.html","الوافر"],[158,"لا تأخذنك رأفة أو رحمة","https://www.aldiwan.net/poem58804.html","الكامل"],[158,"ولعت به كبدر التم يبدو","https://www.aldiwan.net/poem58989.html","الطويل"],[183,"هي الدنيا فلا يحزنك منها","https://www.aldiwan.net/poem14692.html","الوافر"],[184,"إذا عاقبت شريرا فكحلا","https://www.aldiwan.net/poem43272.html","الوافر"],[196,"وشهر أدرنا لارتقاب هلاله","https://www.aldiwan.net/poem51902.html","الطويل"],[268,"أتطمع كالضليل بالوطر العالي","https://www.aldiwan.net/poem35625.html","الطويل"],[278,"أتطمع في الود من زاهد","https://www.aldiwan.net/poem60686.html","المتقارب"],[280,"إلى الملك المهيمن نستغيث","https://www.aldiwan.net/poem32839.html","الوافر"],[303,"كذبتك نفس غالبت بك كاذبا","https://www.aldiwan.net/poem56598.html","الكامل"],[340,"رقادك قلبي شجاك الألم","https://www.aldiwan.net/poem55386.html","المتقارب"],[364,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[364,"أتطمع أن تسالمني وقلبي","https://www.aldiwan.net/poem17947.html","الطويل"],[377,"فؤاد كما يهوى هواك معذب","https://www.aldiwan.net/poem48814.html","الطويل"],[399,"زمان على الأحرار قد جار في الحكم","https://www.aldiwan.net/poem46420.html","الطويل"],[400,"إلى كم أداري عاذلي ومفندي","https://www.aldiwan.net/poem33969.html","الطويل"],[406,"أمهذب الذين استمع من عاتب","https://www.aldiwan.net/poem31727.html","عموديه"],[413,"لفقدان عبد الواحد الدمع قد جرى","https://www.aldiwan.net/poem54022.html","الطويل"],[466,"لأحسن من مصافحة الصفاح","https://www.aldiwan.net/poem60291.html","الوافر"],[527,"أتطلب الحقيقه","https://www.aldiwan.net/poem37289.html","منهوك المنسرح"],[542,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[556,"عليك بروحك السر الإلهي","https://www.aldiwan.net/poem33652.html","الوافر"],[573,"أتطلب من زمانك ذا وفاء","https://www.aldiwan.net/poem2792.html","الوافر"],[583,"أتطمع في عقالك أن يحلا","https://www.aldiwan.net/poem1564.html",""]],"verses":[["أَتَطمَعُ أَن أُلقي إِلَيكَ مَقادَتي","وَلي مارِنٌ ما مَرَّنَتهُ الخَزائِمُ",0,"م",1,1],["أَتَطلُبُ في قَلبي العِراقَ مِنَ الحِمى","لِيَهنَكَ مِن مَرمىً عَلَيكَ بَعيدُ",1,"د",1,0],["أَتَطمَعُ أَن تَسلو عَلى البُعدِ وَالنَوى","وَأَنتَ عَلى قُربِ المَزارِ عَميدُ",1,"د",1,0],["أَتُطيقينَ ذاكَ إِن كانَ يا فَو","زُ لَقَد رُمتِ مِن هَلاكي المَراما",2,"م",2,0],["أَتَطمَعُ يا عَبّاسُ في غَيرِ مَطمَعِ","بَعُدتَ دَعِ التَطلابَ مِن كَثَبٍ دَعِ",3,"ع",1,1],["أتطمع هذي الناس أن تبلغ المُنى","ولم تُورَ في يوم الصدام زُنودها",4,"د",3,0],["أَتَطرَبُ حينَ لاحَ بِكَ المَشيبُ","وَذَلِكَ إِن عَجِبتَ هَوىً عَجيبُ",5,"ب",1,1],["أَتَطلُبُ سابِقَ الحَلَباتِ تَيمٌ","تَقَدَّمَ في المَواطِنِ إِذ يُجاري",6,"ر",2,0],["أَتُطفَأُ حَسرَتي وَتَقَرُّ عَيني","وَلَم أوقِد مَعَ الغازينَ نارا",7,"ر",2,0],["أَتَطمَعُ أَن تَنالَ العَفوَ مِمَّن","عَصَيتَ وَأَنتَ لم تَطلُب رِضاهُ",8,"ا",2,0],["أَتَطلُبُ عادِياً بَنى اللَهُ بَيتَهُ","عَزيزاً وَلَم يَجعَل لَكَ اللَهُ بانِيا",9,"ي",2,0],["أتُطوَى سَمواتُ هذا الوجود","ويذهبُ هذا الفضاءُ البعيدْ",10,"د",1,0],["أتطمع في المزاج وما تهيّا","دواؤك حين تخلطه بسحق",11,"ق",1,1],["أتطمعُ أن تحظَى بهنّ وإِنني","بواحدةٍ إِن ساعفتْ لقَنُوعُ",12,"ع",1,0],["أتطمعُ في شَميمِ عَرارِ نجدٍ","وهل بعدَ العشيّةِ من عَرارِ",13,"ر",1,0],["أَتَطلُبُ يا حِمارَ بَني كُلَيبٍ","بِعانَتِكَ اللَهاميمَ الرِغابا",14,"ب",2,0],["أَتَطلُبُ يا عورانُ فَضلَ نَبيذِهِم","وَعِندَكَ يا عورانُ زِقٌّ مُوَكَّرُ",15,"ر",1,0],["أَتَطلُبُ مِن عِندَ النُجومِ وَفَوقَها","بِرِبقٍ وَعَيرٍ ظَهرُهُ مُتَقَرِّفُ",16,"ف",1,0],["أَتَطلُبُ رِزقَ اللَهِ مِن عِندِ غَيرِهِ","وَتُصبِحُ مِن خَوفِ العَواقِبِ آمِنا",17,"ن",2,1],["أَتَطلُبُ صاحِباً لا عَيبَ فيهِ","وَأَيُّ الناسِ لَيسَ لَهُ عُيوبُ",18,"ب",1,0],["أَتُطالِعُ الآمالَ مُنتَظِراً وَلا","تَدري لَعَلَّ المَوتَ أَوَّلُ طالِعِ",19,"ع",1,0],["أَتَطمَعُ في الخُلدِ بَعدَ الَّذينَ","رَأَيتَهُمُ قَد مَضَوا قَبلَكا",20,"ك",2,0],["أَتَطمَعُ أَن تُخَلِّدَ لا أَبا لَك","أَمِنتَ مِنَ المَنِيَّةِ أَن تَبالَك",21,"ك",1,1],["أَتَطلُبُ مِن أَخٍ خُلُقاً جَليلاً","وَخَلقُ الناسِ مِن ماءٍ مَهينِ",22,"ن",1,1],["أتطمعُ أن يردّ عليك إلفاً","ويُبْقي ما حييتَ لك الشبابا",23,"ب",2,0],["أَتَطمَعُ أَن تُعَدَّ كَريمَ قَومٍ","وَبابُكَ لا يُطيفُ بِهِ كَريمُ",24,"م",1,0],["أَتَطمَعُ مِن لَيلى بِوَصلٍ وَإِنَّما","تُضَرِّبُ أَعناقَ الرِجالِ المَطامِعُ",25,"ع",1,0],["أَتَطمعُ زَينبٌ بذراعِ شاةٍ","يُسمَّمُ أن يُضَرَّ وأن يُساءَ",26,"ا",2,0],["أتطلبون دمَ الإسلامِ لا حَكَمٌ","إلا السُّيوف ويقضِي الأمرَ عزريل",27,"ل",1,0],["أَتُطْلِقُ بامِكِيَّاتٍ لِنَومٍ","وتُنْفِقُ فَيء قَوْمٍ آخِرِينا",28,"ن",2,0],["أَتَطمَعُ في وادي القُرى وَجِنابِهِ","وَقَد مَنَعوا مِنهُ جَميعَ المَعاشِرِ",29,"ر",1,0],["أتطنِبُ في معانيها المعالي","بربعكُمُ ويختصرُ الكتابُ",30,"ب",1,0],["أتطمع أن تنال العفو ممّا","عصمتَ وأنت لم تطلب رضاه",31,"ا",2,0],["أتَطْلُبُ يَا حِمَارَ بَني كُلَيْبٍ","بَهانَتِكَ اللّهامِيمَ الرِّغَابَا",32,"ب",2,0],["أتُطوَى سماواتُ هذا الوجودِ؟","ويذهبُ هذا الفَضاءُ البعيدْ؟",33,"د",1,0],["أتَطمَعُ في المَكَارِمِ بَعدَ هَذَا","تَقَاصَر لَستَ بالنَّدُسِ الهُمَامِ",34,"م",1,0],["أتطمع أن تذوق الغمضَ ليلاً","وقد سلبت حشاكَ عيونُ ليلى",35,"ل",2,1],["اتطيعه في الله جل ولا تط","يع الله فيه إنها لكبيرة",36,"ه",1,0],["اتطلب سيفه والموت عد","وتترك سوحه والعيش رغد",37,"د",1,0],["أتطلبُ جيفةً وتنال منها","وتنكرُ أنْ تُهارشَك الكلاب",38,"ب",1,0],["أتطمع أن تطرّف بالمصّلي","كما كانت وهل تلد العقيم",39,"م",1,0],["أتطلبكَ الأبصارُ في الجو ناقصاً","وأنت كذا تمشي على الأرض كاملا",40,"ل",2,0],["أتطمَعُ كالضلّيلِ بالوطرِ العالي","وأنتَ قليلُ الحظّ والصبرِ والمال",41,"ل",1,1],["أَتَطْمَعُ فِي الْوُدِّ مِنْ زاهِدِ","وَأَيْنَ الْخَلِيُّ مِنَ الْواجِدِ",42,"د",1,1],["أَتَطمَعُ في البَقاءِ وَهَل بَقاءٌ","وَآدَمُ قَبلَنا أَودى وَشيثُ",43,"ث",1,0],["أتطفّلاً وتوغّلاً وتصدّراً","ثمَّ الرقيُّ لأن تُساجل آدبا",44,"ب",2,0],["اتطمح قلبي إلى أن تصير","أمير القلوب وليث الاجم",45,"م",1,0],["أَتَطلُبُ بِالبَيانِ غَريقَ بَحرٍ","مَتى طُلِبَ الغَريقُ بِجَلبِ دُرِّ",46,"ر",1,0],["أَتَطمَعُ أَن تُسالِمَني وَقَلبي","بِعِلمِكَ مِنكَ مَكلومُ النَواحي",47,"ي",1,1],["أَتَطلُب في الدُنيا الدَنية راحَةً","وَأَنتَ كَريم النَفس حُرٌّ مُهَذَب",48,"ب",1,0],["أتطمعُ جهْلاً أن تُجَاريني العِدا","وقد نَزَل الدهرُ الحَزُونُ عَلَى حكمي",49,"ي",1,0],["أتطلب غوثاً من غريب وإنه","كمثلك يبغي الغيث في كل مقصد",50,"د",1,0],["أتطيع في الدهر وهو كما ترى","يقضي علي بفرقة الأحباب",51,"ب",1,0],["أتُطْمِعُنا آمالُنا ببقائنا","بكلّ حديثٍ ما هنالك مفترى",52,"ر",2,0],["أَتَطمَعُ بَعدَ شَيبِكَ في سُرورٍ","مُحالٌ اَن تَطيرَ بِلا جَناحِ",53,"ح",1,0],["أَتَطْلُبُ الْحَقِيقَهْ","وتَسْلُكُ الطَّرِيقَهْ",54,"ه",1,1],["أتطيبُ نفسكَ حين يورِقُ مجمرٌ","بالمدح فيك وينتشي فنجانُ؟!",55,"ن",1,0],["أتطلبه وروحك أمره قد","أتاك عن السوى لك منك ناهي",56,"ي",1,0],["أَتطلب من زمانك ذا وفاءَ","وتأْمُلُ ذاك جَهْلاً من بنيه",57,"ه",1,1],["أَتطمعُ في عِقالك أَن يُحلاّ","وتُدرك في ظلام الصُّدغ مَحْلا",58,"ل",2,1]]}