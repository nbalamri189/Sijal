/diwan/poem/97075","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94567","الطويل"],[4306,"","https://poetry.dctabudhabi.ae/diwan/poem/121967","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117258","الوافر"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120529","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139700",""],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124660","الطويل"],[4809,"هل في القوم من عمر ؟","https://www.poetsgate.com/ViewPoem.aspx?id=201476",""],[4858,"هنيئاً ذا التّخرّجُ يا صُهيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=156818",""],[4939,"أتطمعُ في ودِّ امرئٍ وهو قاطع","https://www.poetsgate.com/ViewPoem.aspx?id=135269",""],[4955,"أتطلق سهمك المسموم نحوي","https://www.poetsgate.com/ViewPoem.aspx?id=202864",""],[585,"نثلت لك الكنانة في العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=161849",""],[585,"أتطوي الليل تهتف بالنشيد","https://www.poetsgate.com/ViewPoem.aspx?id=161881",""],[5187,"للصبر حدرد","https://www.poetsgate.com/ViewPoem.aspx?id=29248",""],[5246,"نصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=187036",""],[5431,"وبالخيبات قد رجع البريدُ","https://www.poetsgate.com/ViewPoem.aspx?id=191824",""],[5431,"من شعر الحكمة ...","https://www.poetsgate.com/ViewPoem.aspx?id=211087",""],[3294,"أين الوفاء وللوفاء دلايل","https://www.poetsgate.com/ViewPoem.aspx?id=173271",""],[5442,"نسم آن أن تسري الرفاق إلى الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=114747",""],[5497,"أتطيقُ عيشا","https://www.poetsgate.com/ViewPoem.aspx?id=206603",""],[5542,"قالوا تطرف جيلنا","https://www.poetsgate.com/ViewPoem.aspx?id=10190",""],[1680,"أتطلب أن تكون كثير مال","https://www.poetsgate.com/ViewPoem.aspx?id=108878",""],[5740,"ألاَ اخْرَسْ فَهذاَ مِنْك أعْلا وأكبَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=211476",""],[5781,"هاتها نصفَ وسادةٍ وقلب","https://www.poetsgate.com/ViewPoem.aspx?id=202834",""],[5829,"البنت اللعوب","https://www.poetsgate.com/ViewPoem.aspx?id=152563",""],[5956,"أ تطيق بُعداً عن محبِّك خالدٍ؟","https://www.poetsgate.com/ViewPoem.aspx?id=193347",""],[6093,"ولا كل ّ طير ٍ بالجناحِ يَطيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=190513",""],[5724,"رسول العلى والفضل والخير والهدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55159&r=&rc=26",""],[6247,"من أوراق امرأة مطلقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80295&r=&rc=34",""],[6355,"شقيق روحي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66693&r=&rc=153",""]],"verses":[["أَتَطمَعُ أَن أُلقي إِلَيكَ مَقادَتي","وَلي مارِنٌ ما مَرَّنَتهُ الخَزائِمُ",0,"م",1,1],["أَتَطلُبُ في قَلبي العِراقَ مِنَ الحِمى","لِيَهنَكَ مِن مَرمىً عَلَيكَ بَعيدُ",1,"د",1,0],["أَتَطمَعُ أَن تَسلو عَلى البُعدِ وَالنَوى","وَأَنتَ عَلى قُربِ المَزارِ عَميدُ",1,"د",1,0],["أَتُطيقينَ ذاكَ إِن كانَ يا فَو","زُ لَقَد رُمتِ مِن هَلاكي المَراما",2,"م",2,0],["أَتَطمَعُ يا عَبّاسُ في غَيرِ مَطمَعِ","بَعُدتَ دَعِ التَطلابَ مِن كَثَبٍ دَعِ",3,"ع",1,1],["أتطمع هذي الناس أن تبلغ المُنى","ولم تُورَ في يوم الصدام زُنودها",4,"د",3,0],["أَتَطرَبُ حينَ لاحَ بِكَ المَشيبُ","وَذَلِكَ إِن عَجِبتَ هَوىً عَجيبُ",5,"ب",1,1],["أَتَطلُبُ سابِقَ الحَلَباتِ تَيمٌ","تَقَدَّمَ في المَواطِنِ إِذ يُجاري",6,"ر",2,0],["أَتُطفَأُ حَسرَتي وَتَقَرُّ عَيني","وَلَم أوقِد مَعَ الغازينَ نارا",7,"ر",2,0],["أَتَطمَعُ أَن تَنالَ العَفوَ مِمَّن","عَصَيتَ وَأَنتَ لم تَطلُب رِضاهُ",8,"ا",2,0],["أَتَطلُبُ عادِياً بَنى اللَهُ بَيتَهُ","عَزيزاً وَلَم يَجعَل لَكَ اللَهُ بانِيا",9,"ي",2,0],["أتُطوَى سَمواتُ هذا الوجود","ويذهبُ هذا الفضاءُ البعيدْ",10,"د",1,0],["أتطمع في المزاج وما تهيّا","دواؤك حين تخلطه بسحق",11,"ق",1,1],["أتطمعُ أن تحظَى بهنّ وإِنني","بواحدةٍ إِن ساعفتْ لقَنُوعُ",12,"ع",1,0],["أتطمعُ في شَميمِ عَرارِ نجدٍ","وهل بعدَ العشيّةِ من عَرارِ",13,"ر",1,0],["أَتَطلُبُ يا حِمارَ بَني كُلَيبٍ","بِعانَتِكَ اللَهاميمَ الرِغابا",14,"ب",2,0],["أَتَطلُبُ يا عورانُ فَضلَ نَبيذِهِم","وَعِندَكَ يا عورانُ زِقٌّ مُوَكَّرُ",15,"ر",1,0],["أَتَطلُبُ مِن عِندَ النُجومِ وَفَوقَها","بِرِبقٍ وَعَيرٍ ظَهرُهُ مُتَقَرِّفُ",16,"ف",1,0],["أَتَطلُبُ رِزقَ اللَهِ مِن عِندِ غَيرِهِ","وَتُصبِحُ مِن خَوفِ العَواقِبِ آمِنا",17,"ن",2,1],["أَتَطلُبُ صاحِباً لا عَيبَ فيهِ","وَأَيُّ الناسِ لَيسَ لَهُ عُيوبُ",18,"ب",1,0],["أَتُطالِعُ الآمالَ مُنتَظِراً وَلا","تَدري لَعَلَّ المَوتَ أَوَّلُ طالِعِ",19,"ع",1,0],["أَتَطمَعُ في الخُلدِ بَعدَ الَّذينَ","رَأَيتَهُمُ قَد مَضَوا قَبلَكا",20,"ك",2,0],["أَتَطمَعُ أَن تُخَلِّدَ لا أَبا لَك","أَمِنتَ مِنَ المَنِيَّةِ أَن تَبالَك",21,"ك",1,1],["أَتَطلُبُ مِن أَخٍ خُلُقاً جَليلاً","وَخَلقُ الناسِ مِن ماءٍ مَهينِ",22,"ن",1,1],["أتطمعُ أن يردّ عليك إلفاً","ويُبْقي ما حييتَ لك الشبابا",23,"ب",2,0],["أَتَطمَعُ أَن تُعَدَّ كَريمَ قَومٍ","وَبابُكَ لا يُطيفُ بِهِ كَريمُ",24,"م",1,0],["أَتَطمَعُ مِن لَيلى بِوَصلٍ وَإِنَّما","تُضَرِّبُ أَعناقَ الرِجالِ المَطامِعُ",25,"ع",1,0],["أَتَطمعُ زَينبٌ بذراعِ شاةٍ","يُسمَّمُ أن يُضَرَّ وأن يُساءَ",26,"ا",2,0],["أتطلبون دمَ الإسلامِ لا حَكَمٌ","إلا السُّيوف ويقضِي الأمرَ عزريل",27,"ل",1,0],["أَتُطْلِقُ بامِكِيَّاتٍ لِنَومٍ","وتُنْفِقُ فَيء قَوْمٍ آخِرِينا",28,"ن",2,0],["أَتَطمَعُ في وادي القُرى وَجِنابِهِ","وَقَد مَنَعوا مِنهُ جَميعَ المَعاشِرِ",29,"ر",1,0],["أتطنِبُ في معانيها المعالي","بربعكُمُ ويختصرُ الكتابُ",30,"ب",1,0],["أتطمع أن تنال العفو ممّا","عصمتَ وأنت لم تطلب رضاه",31,"ا",2,0],["أتَطْلُبُ يَا حِمَارَ بَني كُلَيْبٍ","بَهانَتِكَ اللّهامِيمَ الرِّغَابَا",32,"ب",2,0],["أتُطوَى سماواتُ هذا الوجودِ؟","ويذهبُ هذا الفَضاءُ البعيدْ؟",33,"د",1,0],["أتَطمَعُ في المَكَارِمِ بَعدَ هَذَا","تَقَاصَر لَستَ بالنَّدُسِ الهُمَامِ",34,"م",1,0],["أتطمع أن تذوق الغمضَ ليلاً","وقد سلبت حشاكَ عيونُ ليلى",35,"ل",2,1],["اتطيعه في الله جل ولا تط","يع الله فيه إنها لكبيرة",36,"ه",1,0],["اتطلب سيفه والموت عد","وتترك سوحه والعيش رغد",37,"د",1,0],["أتطلبُ جيفةً وتنال منها","وتنكرُ أنْ تُهارشَك الكلاب",38,"ب",1,0],["أتطمع أن تطرّف بالمصّلي","كما كانت وهل تلد العقيم",39,"م",1,0],["أتطلبكَ الأبصارُ في الجو ناقصاً","وأنت كذا تمشي على الأرض كاملا",40,"ل",2,0],["أتطمَعُ كالضلّيلِ بالوطرِ العالي","وأنتَ قليلُ الحظّ والصبرِ والمال",41,"ل",1,1],["أَتَطْمَعُ فِي الْوُدِّ مِنْ زاهِدِ","وَأَيْنَ الْخَلِيُّ مِنَ الْواجِدِ",42,"د",1,1],["أَتَطمَعُ في البَقاءِ وَهَل بَقاءٌ","وَآدَمُ قَبلَنا أَودى وَشيثُ",43,"ث",1,0],["أتطفّلاً وتوغّلاً وتصدّراً","ثمَّ الرقيُّ لأن تُساجل آدبا",44,"ب",2,0],["اتطمح قلبي إلى أن تصير","أمير القلوب وليث الاجم",45,"م",1,0],["أَتَطلُبُ بِالبَيانِ غَريقَ بَحرٍ","مَتى طُلِبَ الغَريقُ بِجَلبِ دُرِّ",46,"ر",1,0],["أَتَطمَعُ أَن تُسالِمَني وَقَلبي","بِعِلمِكَ مِنكَ مَكلومُ النَواحي",47,"ي",1,1],["أَتَطلُب في الدُنيا الدَنية راحَةً","وَأَنتَ كَريم النَفس حُرٌّ مُهَذَب",48,"ب",1,0],["أتطمعُ جهْلاً أن تُجَاريني العِدا","وقد نَزَل الدهرُ الحَزُونُ عَلَى حكمي",49,"م",2,0],["أتطلب غوثاً من غريب وإنه","كمثلك يبغي الغيث في كل مقصد",50,"د",1,0],["أتطيع في الدهر وهو كما ترى","يقضي علي بفرقة الأحباب",51,"ب",1,0],["أتُطْمِعُنا آمالُنا ببقائنا","بكلّ حديثٍ ما هنالك مفترى",52,"ر",2,0],["أَتَطمَعُ بَعدَ شَيبِكَ في سُرورٍ","مُحالٌ اَن تَطيرَ بِلا جَناحِ",53,"ح",1,0],["أَتَطْلُبُ الْحَقِيقَهْ","وتَسْلُكُ الطَّرِيقَهْ",54,"ه",1,1],["أتطيبُ نفسكَ حين يورِقُ مجمرٌ","بالمدح فيك وينتشي فنجانُ؟!",55,"ن",1,0],["أتطلبه وروحك أمره قد","أتاك عن السوى لك منك ناهي",56,"ي",1,0],["أَتطلب من زمانك ذا وفاءَ","وتأْمُلُ ذاك جَهْلاً من بنيه",57,"ه",1,1],["أَتطمعُ في عِقالك أَن يُحلاّ","وتُدرك في ظلام الصُّدغ مَحْلا",58,"ل",2,1],["أتَطرَبُ مِن طَيفِ الخَيالِ المُسَلّم","وَتَبكي لِضِحكِ البارِقِ المُتَبَسِّمِ",59,"م",1,1],["أتطرد قربي أحمد عن مكانه","بنو الوزغ المطرود طرد الغرائب",60,"ب",1,0],["أتطيب الحياة والشيخ أمسى","غيّبته مغيّبات اللحود",61,"د",1,0],["أتطيل بينهم مقامك جاهداً","وتقول لما يتعلموا ويهذبوا",62,"ب",3,0],["أتطيعون يا رفاق دخيلاً","في المعاصي يا مطمح الدخلاء",63,"ا",2,0],["أتطلبُ أبكارَ المعاني وعُونها","لدى جسدٍ قد سارَ عنه فؤادُهُ",64,"د",2,0],["أَتَطمَع أَن تَلقى مُلوكاً ثَلاثةً","لِبَعضهمُ تَعنو المُلوك القَماقمُ",65,"م",1,0],["أتطمَعُ أن تنال المجدَ قبلي","وأنّى تَسْبِقُ النُّجْبَ الهلالُ",66,"ل",1,0],["أتطلع في الأفاق شمساً مُنيرة","وقلبيَ بالهجران جُنح على جنح",67,"ح",1,0],["أتَطْمَعُ أنْ أجيبَ نِدَاكَ فيهَا","وكيفَ وقد غَدتْ شيا فَرِيَّا",68,"ي",2,0],["أَتَطلُعُ مِنها في دِياري طَوالِعٌ","بِسوءٍ وَهِمّاتي عَلَيها طَلائِعُ",69,"ع",1,0],["اتطلب سلوةً مني رجالٌ","أقلُ الناسِ علماً باليقين",70,"ن",1,0],["أَتَطعَنُ في ديني غَداةَ أَتَيتُكُم","وَلِلدينِ تُدني الباهِلِيَّ وَحَشرَجا",71,"ج",2,0],["أَتَطلُبُ ثَأراً لَستُ مِنهُ وَلا لَهُ","وَأَينَ اِبنُ ذَكوانَ الصَفورِيُّ مِن عَمرِو",72,"ر",2,1],["أَتُطْمِعُني لَيْلَى بِتَقْبيلِ خالِها","غُروراً وقد ضَنَّتْ بِطَيْفِ خيالها",73,"ل",3,1],["أَتَطمَعُ بِالعَيشِ بَعدَ الفِراقِ","فَبِئسَ لَعَمرُكَ ما تَطمَعُ",74,"ع",1,0],["أتطامنت للذلّ هامةُ عِزّكم","أم منكم الأَيدي الطوالُ قِصارُ",75,"ر",1,0],["أَتَطمَع في الصلاة من الإِلَه","عليك وَأَنتَ تَسعى في المناهي",76,"ا",3,1],["أتطلب دنياً بعد فقدك جعفرا","وتطمع فيها أن تكون معمرا",77,"ر",2,1],["أتطيب للصب الكئيب عقاره","ولها إذا غاب الحبيب يُسار",78,"ر",1,0],["أَتَطيب نفسا وَالفَريق بزينب","من ذي الاراكة يهبطون وَيَصعَدوا",79,"د",3,0],["أَتُطِيقُ هَوىً وَتَرُوحُ نَوىً","فَأَجَبتُ طَلَبتُ فَلَم أُطِقِ",80,"ق",1,0],["أتطمع لا أبالك في علي","وقد قرع الحديد على الحديد",81,"د",1,0],["أتطمع في معاوية بن حربٍ","وعمرو إن ذا منا قبيح",82,"ح",1,0],["أَتُطْرِدُنِي عن باب فضلك سيّدي","وروضك للعافي الفقيرِ مَريعُ",83,"ع",1,0],["أَتَطمَع نَفسي أَن أَلمَّ بِحيكم","وَهَيهات إن الحَي مِن دُونه الحَتف",84,"ف",1,0],["أَتَطلُب سلوة منى عذولي","وَقَلبي لا يَميل الى مرآء",85,"ا",2,0],["أتطمعُ فى ملكي ودونَ نواله","نوالُك فوق النّطع حشرجة الصدر",86,"ر",1,0],["أتطاق حين ضممتَ أقبح صورة","في الكون أجمعه لأقبحِ روح",87,"ح",1,0],["أتطمع أنني أسلو وقلبي","مقيم ماله عنه انتقال",88,"ل",1,0],["أتطمع في الذي أعيا علياً","على ما قد طمعت به العفاء",89,"ا",2,0],["أتطلبونَني بمال لَكُمُ","أو بقصاصِ أو قتيل منكُمُ",90,"م",1,0],["أتَطلُبُ منّي قلبَ كلِّ مُدَجَّجٍ","وقد كنتَ من قلبِ المُدجّجِ تأنَفُ",91,"ف",1,0],["أتطلُبُ أمْلاكَ الزّمانِ منالَها","وقد أذْعَنَتْ سامٌ وحامٌ ويافِثُ",92,"ث",1,0],["أتطمِعُني في الوصل والأمرُ مدبرٌ","وما نلتُ منك الودَّ والعُمرُ مقبلُ",93,"ل",1,1],["أَتطلب 