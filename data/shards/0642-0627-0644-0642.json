{"poems":[[93,"ذنبها أنها رأت","https://www.aldiwan.net/poem9153.html","مجزوء الخفيف"],[93,"زارني صبحاً وحيى","https://www.aldiwan.net/poem11100.html","مجزوء الرمل"],[88,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[91,"ما لقلبي يلج من الخفقان","https://www.aldiwan.net/poem62761.html","عموديه"],[91,"رب ليل نجومه ضاحكات","https://www.aldiwan.net/poem62801.html","عموديه"],[69,"إنما أهرام مصر مهلك","https://www.aldiwan.net/poem28564.html","الرمل"],[105,"يا أبا العاص أي أرض تريد","https://www.aldiwan.net/poem43996.html","الخفيف"],[67,"ما أكلنا في ذا الصيام كنافه","https://www.aldiwan.net/poem18075.html","الخفيف"],[46,"قال قوم ولا أدين بما قالوه","https://www.aldiwan.net/poem22851.html","الخفيف"],[106,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[106,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179448",""],[129,"أنت يا مقلتي أسقمت حالي","https://www.aldiwan.net/poem50549.html","الخفيف"],[212,"ليلة بتها سقيما وقيدا","https://www.aldiwan.net/poem46618.html","الخفيف"],[212,"ما على الغادرين نسكب دمعا إن","https://www.aldiwan.net/poem46763.html","الخفيف"],[257,"قال قوم لزمت حضرة حمد","https://www.aldiwan.net/poem48329.html","الخفيف"],[343,"ومليح جاء صبحا","https://www.aldiwan.net/poem55351.html","مجزوء الرمل"],[354,"لمت من أبدل العمامة بالطر","https://www.aldiwan.net/poem40216.html","الخفيف"],[372,"أنكروها غواية من رشيد","https://www.aldiwan.net/poem57504.html","الخفيف"],[404,"وعلى نظم وقفنا رائق","https://www.aldiwan.net/poem33596.html","الرمل"],[480,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[501,"أجتلى نور وجهه فأذب","https://www.aldiwan.net/poem37636.html","الخفيف"],[559,"كان فرعون قاصدا تحقيقه","https://www.aldiwan.net/poem34290.html","الخفيف"],[576,"قال قلبي إذ قلت يا قلب أبشر","https://www.aldiwan.net/poem2986.html","الخفيف"]],"verses":[["قال قاضي الهوى أما","لك يا قلب مرعوى",0,"و",2,0],["قَالَ قَدْ أَسْدَى عَزيزُ","القطْرِ إِنْعاماً سنِيَّا",1,"ي",2,0],["قال قولاً به استحقّ احتراماً","وتهدّاه فاستحق ملاما",2,"م",2,1],["قالَ قَومٌ وَحيٌ يُنَزِّلُهُ اللَ","هُ وَقَومٌ نَفَثٌ مِنَ الشَيطانِ",3,"ن",1,0],["قالَ قَومٌ إِنَّ المَحَبَّةَ إِثمٌ","وَيحَ بَعضِ النُفوسِ ما أَغباها",4,"ا",3,0],["قالَ قومٌ ما هوَ الشرُّ الذي","يتمناهُ الفتى قلتُ الهرمْ",5,"م",1,0],["قالَ قومٌ أَسْلِمْ يا أبا العاصِ تَغْنَمْ","مَالَ قومٍ هُمُ العَدُوُّ اللَّدُودُ",6,"د",1,0],["قالَ قَوْمٌ إنَّ العِمَادَ كَرِيمٌ","قُلْتُ هذا عندي حَدِيثُ خُرافَه",7,"ف",2,0],["قالَ قَومٌ وَلا أَدينُ بِما قالوهُ","إِنَّ اِبنَ آدَمٍ كَاِبنِ عِرسِ",8,"س",1,1],["قال قومٌ، فأرجفُوا في المقالِ:","عَقِمت دارهم من الأنجالِ",9,"ل",1,1],["قال قوم: هلا شهدنا ذبابًا","في الحياة ارتقى فصار حماما؟",10,"م",2,0],["قالَ قلْبي الآذانُ قد أعلمْتنِي","بسماعٍ منها إلى إيصالِ",11,"ل",1,0],["قال قومٌ والطبّ طوع يديهم","إن برئى يرام بالبنسلين",12,"ن",1,0],["قال قومٌ وقلت أنت سلاما","فعليكم تحيتي وسلامي",13,"ي",1,0],["قال قوم لزمت حضرة حمد","وتجنبت سائر الرؤساء",14,"ا",2,1],["قال قلي لي ما الذي","تبغيه قلهُ باختصار",15,"ر",1,0],["قالَ قَدّر بِأَنَّ رأسيَ فجلٌ","قشَّروه فَقُلت هَذا مقدَّر",16,"ر",1,0],["قال قومٌ بالعلم فيك وقومٌ","تبِعوهم في القول بالتقليدِ",17,"د",1,0],["قال قلِّد كل آل المصطفى","تَنْجُ قطعاً عن مهاوي الزلل",18,"ل",1,0],["قالقٌ شطرين أبحره","لو تعاصت لي قوافيه",19,"ي",2,0],["قال قومٌ في رؤية الغير ذنبٌ","قلت لا والإخلاص فيها ذنوب",20,"ب",1,0],["قال قولاً له على القرب مكراً","منه حتى في البحر ذاق غريقه",21,"ق",2,0],["قال قلبي إِذ قلت يا قلبُ أَبْشِرْ","قد سَلا الخلقُ كلُّهمُ عن حَبيبي",22,"ي",1,1]]}