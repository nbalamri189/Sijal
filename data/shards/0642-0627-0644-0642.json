://poetry.dctabudhabi.ae/diwan/poem/202073","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46517","الرجز"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11975","الخفيف"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104467","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124718","الرمل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130788",""],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141193","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93966","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93916","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127365","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202918","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204497","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204661","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199939","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132620","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112630","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48348","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205484","الرمل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44912","الخفيف"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107505","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125869","الخفيف"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35058","الخفيف"],[5061,"قصيدة المواد","https://www.poetsgate.com/ViewPoem.aspx?id=147164",""],[5136,"قمت ليل الوداع إلا قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=121943",""],[5277,"معارضةُ يائيةِ ابن الفارض(1)","https://www.poetsgate.com/ViewPoem.aspx?id=198943",""],[5409,"كلما اجتاز بعدك الدهر ميلا","https://www.poetsgate.com/ViewPoem.aspx?id=155494",""],[5512,"أنا السُّوري","https://www.poetsgate.com/ViewPoem.aspx?id=205024",""]],"verses":[["قال قاضي الهوى أما","لك يا قلب مرعوى",0,"و",2,0],["قَالَ قَدْ أَسْدَى عَزيزُ","القطْرِ إِنْعاماً سنِيَّا",1,"ي",2,0],["قال قولاً به استحقّ احتراماً","وتهدّاه فاستحق ملاما",2,"م",2,1],["قالَ قَومٌ وَحيٌ يُنَزِّلُهُ اللَ","هُ وَقَومٌ نَفَثٌ مِنَ الشَيطانِ",3,"ن",1,0],["قالَ قَومٌ إِنَّ المَحَبَّةَ إِثمٌ","وَيحَ بَعضِ النُفوسِ ما أَغباها",4,"ا",3,0],["قالَ قومٌ ما هوَ الشرُّ الذي","يتمناهُ الفتى قلتُ الهرمْ",5,"م",1,0],["قالَ قومٌ أَسْلِمْ يا أبا العاصِ تَغْنَمْ","مَالَ قومٍ هُمُ العَدُوُّ اللَّدُودُ",6,"د",1,0],["قالَ قَوْمٌ إنَّ العِمَادَ كَرِيمٌ","قُلْتُ هذا عندي حَدِيثُ خُرافَه",7,"ف",2,0],["قالَ قَومٌ وَلا أَدينُ بِما قالوهُ","إِنَّ اِبنَ آدَمٍ كَاِبنِ عِرسِ",8,"س",1,1],["قال قومٌ، فأرجفُوا في المقالِ:","عَقِمت دارهم من الأنجالِ",9,"ل",1,1],["قال قوم: هلا شهدنا ذبابًا","في الحياة ارتقى فصار حماما؟",10,"م",2,0],["قالَ قلْبي الآذانُ قد أعلمْتنِي","بسماعٍ منها إلى إيصالِ",11,"ل",1,0],["قال قومٌ والطبّ طوع يديهم","إن برئى يرام بالبنسلين",12,"ن",1,0],["قال قومٌ وقلت أنت سلاما","فعليكم تحيتي وسلامي",13,"ي",1,0],["قال قوم لزمت حضرة حمد","وتجنبت سائر الرؤساء",14,"ا",2,1],["قال قلي لي ما الذي","تبغيه قلهُ باختصار",15,"ر",1,0],["قالَ قَدّر بِأَنَّ رأسيَ فجلٌ","قشَّروه فَقُلت هَذا مقدَّر",16,"ر",1,0],["قال قومٌ بالعلم فيك وقومٌ","تبِعوهم في القول بالتقليدِ",17,"د",1,0],["قال قلِّد كل آل المصطفى","تَنْجُ قطعاً عن مهاوي الزلل",18,"ل",1,0],["قالقٌ شطرين أبحره","لو تعاصت لي قوافيه",19,"ي",2,0],["قال قومٌ في رؤية الغير ذنبٌ","قلت لا والإخلاص فيها ذنوب",20,"ب",1,0],["قال قولاً له على القرب مكراً","منه حتى في البحر ذاق غريقه",21,"ق",2,0],["قال قلبي إِذ قلت يا قلبُ أَبْشِرْ","قد سَلا الخلقُ كلُّهمُ عن حَبيبي",22,"ي",1,1],["قالَ قَد خِفتُ وَلَكِنَّ الهَوى","آخِذٌ بِالرَوحِ مِنّي وَالنَفَس",23,"س",1,0],["قال: قل للملك الصا","لح أعلى الله شأنه",24,"ن",2,0],["قال قَدْ مَرَّ ذَا فهَلْ مِنْ مقاٍم","عِنْدَنا قلتُ ما إليْهِ سَبيلُ",25,"ل",1,0],["قال قوْمٌ قُصْرَي الجميعُ التَلاشي","فِئةٌ مُنْتَهاهمُ التَّعْطيلُ",25,"ل",1,0],["قال قوْمُ وَهْم ذَوو العَدَدِ الَج","مِّ لنَا الزَّنْجَبيلُ والسَّلْسَبيلُ",25,"ل",1,0],["قالَ قَبيح أَن تَقول العَرب","إِني مِن المَوت حذاراً أهرب",26,"ب",1,0],["قال ققم فأتنا بخبز ولحم","ونبيذ في حمرة الأرجوان",27,"ن",1,0],["قالَ قَومٌ بَدا عِذارُ وُهَيبٍ","فَاِسلُ عَنهُ فَقُلتُ لا كَيفَ أَسلو",28,"و",1,1],["قال قرأت النحو والأصولا","والفقه والمعقول والمنقولا",29,"ل",2,0],["قال قال الله لم أجعل لكم","من بحيرٍ ووصيلٍ في البَقَر",30,"ر",1,0],["قال قال الله يا عيسى وإذ","تخلقُ الطينَ طيوراً والمَدَر",30,"ر",1,0],["قال قل ربي إليك المشتكى","فاحكمن بالحق إني منتصر",30,"ر",1,0],["قال قال الله ما كلفتكم","غير وسعِ النفس في آي الزبر",30,"ر",1,0],["قال قوم ان العلا في سفور","كابنة الغرب فالحجاب ادلهماً",31,"م",2,0],["قال قتل المرء أولى يا فتى","إن قتل الأم شيء ما أتى",32,"ت",2,0],["قال قل لي بمن شغفت غراماً","قلت دعني يا عاذلي بمحمد",33,"د",1,0],["قال قوم شميم رياه ضاعت","قلت ضاعت منكم أتم ضياع",34,"ع",1,0],["قال قد جاء أمير","حازم يحمي الربوع",35,"ع",1,0],["قال قم نحضر معاً في منتدى","أدباءٍ فيه نلقى كل شي",36,"ي",1,0],["قال قوم ألشعر فاكهةٌ تؤكل","عن لذة وفيها غذاءُ",37,"ا",2,1],["قال قوم سموا الشوارع اسما","ء بها تبتنون اسمى كيان",38,"ن",1,1],["قال قوم الجار قبل الدار","ولذا قد ألفت سكنى القفار",39,"ر",1,1],["قال قوم بأن شبلي شميل","ليث غاب فقلت صادف بشرا",40,"ر",2,0],["قالَ قد احتَسَبتُهُ ونَفسي","عند إلهي إذ أحُلُّ رَمَسي",41,"ي",1,0],["قال قد عذّبَتْكَ هجْراً وصدّاً","قلتُ فيها يُسْتَعْذَبُ التعْذيبُ",42,"ب",1,0],["قال قوم زينة الدنيا خداعْ","قلت خَيْراً بالذي نَشْري نبيعْ",43,"ع",1,0],["قالَ قَلبي وَلِلقُلوبِ اِزدِهاءُ","وَلَها حكمةٌ وَفيها مَضاءُ",44,"ا",2,0],["قال قد كان إبرهيم بنُ سل","مان بغانا بالظلم والاعتداءِ",45,"ا",2,0],["قال قومٌ هذا سبيلٌ قويمٌ","كلُّ نفسٍ محتومةٌ بكتاب",46,"ب",1,0],["قالَ قومُ أَعياننا باقيات","قالَ قومٌ بل إِنّنا فانونا",47,"ن",2,0],["قال قلبي للكتاب أركد فديتك","ماحفطنا لك ولا حتى قرينا",48,"ن",2,0],["قال قالوا كان قالوا هو الوح","ي تلقى هداه عن جبريلا",49,"ل",2,0],["قالَ: \"قدْ ماتوا وقدْ ماتَ الهوى\"","فجرتْ عينايَ منْ نبعٍ عَلَيْ",50,"ي",1,0],["قال قومٌ ما قام دينك لو لم","تتخذ دونه الحسام الصقيلا",51,"ل",2,0],["قالقهرُ في كفي يصيرُ ألىً","ومن الأناملِ يُشرقُ الزَّهرُ",52,"ر",1,0]]}