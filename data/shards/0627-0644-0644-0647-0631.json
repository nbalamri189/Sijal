{"poems":[[95,"يا من لها القصر المنيف","https://www.aldiwan.net/poem11092.html","مجزوء الكامل"],[93,"لو أستطيع كتبت بالنيران","https://www.aldiwan.net/poem62773.html","عموديه"],[107,"إرفع كتابك يا سرا","https://www.aldiwan.net/poem44031.html","مجزوء الكامل"],[107,"قم ودع الأوثان والأصناما","https://www.aldiwan.net/poem44047.html","الكامل"],[93,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[244,"الله ربي والحنيفةُ ديني","https://www.aldiwan.net/poem1095.html","الكامل"],[275,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[409,"الحمد لله على كل حال","https://www.aldiwan.net/poem33479.html","السريع"],[427,"الله ربي لا أريد سواه","https://www.aldiwan.net/poem46404.html","الكامل"],[563,"يا شرفي بأنه يعلمني","https://www.aldiwan.net/poem33732.html","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38925","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62469","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72326","الكامل"],[1313,"","https://poetry.dctabudhabi.ae/diwan/poem/147082","البسيط"],[1715,"","https://poetry.dctabudhabi.ae/diwan/poem/17550","الكامل"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203542","المجتث"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86298","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109930","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36772","البسيط"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83428","السريع"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58011","الكامل"],[4875,"شرح وكتاب","https://www.poetsgate.com/ViewPoem.aspx?id=133360",""],[5389,"اشتياق الغدير","https://www.poetsgate.com/ViewPoem.aspx?id=215191",""],[5411,"مِنْ هَمْسِ ضارِعَةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=187706",""],[5688,"لعنة المنّ","https://www.poetsgate.com/ViewPoem.aspx?id=211080",""],[5830,"يَا صَاحِبَ الكَلِمَاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=200769",""],[5869,"اعذب الألفاظ","https://www.poetsgate.com/ViewPoem.aspx?id=57075",""],[5956,"كانت مجلتها روحاً لجثتنا","https://www.poetsgate.com/ViewPoem.aspx?id=193112",""],[5956,"ابنتاي آن وناي البعيدتان عني","https://www.poetsgate.com/ViewPoem.aspx?id=200103",""],[5956,"لماذا سُمِّي الصِّهرُ صهرا؟","https://www.poetsgate.com/ViewPoem.aspx?id=204009",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""]],"verses":[["ألله رَاضٍ عَنْكِ يَا فَخْ","رَ الغَوَانِي وَالنَّبِيّ",0,"ي",1,0],["اللَهُ رَبُّ الشَرعَتَينِ وَرَبُّكُم","فَإِلى مَتى في الدينِ تَختَصِمانِ",1,"ن",1,0],["اللَّهُ ربُّ العالَمِي","نَ فما اتّباعُ التُّرَّهاتِ",2,"ت",1,0],["اللَّهُ ربُّ العالمينَ ودينُهُ","دِينُ السّلامِ لمن أراد سلاما",3,"م",2,0],["اللّه ربّ الشّرعتين وربّكم","فإلى متى الدّين تختصمان",4,"ن",1,0],["الله ربي والحنيفةُ ديني","فيه اعتقادي راسخٌ ويقيني",5,"ن",2,1],["اللهُ راضٍ عن شِهادةِ فِتَيةٍ","بعُيونِهم وقُلوبهم حَجَبوك",6,"ك",1,0],["اللّه ربي ثم لي أحمد","نبي صدق لا أقول المحال",7,"ل",1,0],["الِلّه ربي لا أريدُ سواهُ","هل في الوجودِ الحي إلّا اللَه",8,"ه",1,1],["الله ربي لا سواه عنده","لا عندنا فافهمه فهم الفطن",9,"ن",1,0],["اللَّهُ ربّي قَد حَباكَ بِنِعمَةٍ","كلّ المَواهِبِ في يَديْ مَنّانِها",10,"ن",3,0],["الله ربي إن هذا الناس ما","عرفوا الإله حقيقة وهو الأجلّ",11,"ل",1,0],["اللّه ربي ما عبدت سواه","في عصر الصبا ومحمدَّ رباني",12,"ن",2,0],["الله ربّي وليُّ نفسي","في كل بوسٍ وكلّ نعمى",13,"م",2,0],["اللَهُ رَبّي وَالنَبِيُّ مُحَمَّدٌ","حَيِّيا الرِسالَةَ بَينَ الأَسبابِ",14,"ب",1,0],["الله رَبِّي وحسبي","الله أَرْجُو وَأحمد",15,"د",1,1],["اللَهُ رَبّي أَيا مَن شَأنَهُ اِرتَفَعا","وَمن اِلى اِمره كُل الوَرى خَضعا",16,"ع",2,1],["اللَه ربي من نِضالٍ ما لهُ","لَجَبٌ ولا عَدَدٌ يليهِ ولا عُدَد",17,"د",1,0],["اللَهُ راضٍ عَلى أُناسٍ","وَلَّيتَهُم ناهِياً وَآمِر",18,"ر",1,0],["الله ربي وهو حسبي وكفى","لما بني الحب على أصل الجفا",19,"ف",2,0],["اللَهُ رَبّي وهو حَسبي لما","يَكون أَو قد كان من نكبَةِ",20,"ه",1,1],["الله رَبِّي ما إلهٌ يُرْتَجَى","إلاَّ هُوَ الرحمنُ غايَةُ مقصدي",21,"د",2,0],["الله رفعني عن دنافيس وأذناب","كلّي قيَم كلّي مواثيق مبداي",22,"ا",2,0],["الله راد تشرف البيت العتيق","واقتراحك بالغدير اعظم درس",23,"س",1,0],["الله رَبَي وَدينُ الله أتْبَعهُ","وَلَيسَ عَنْ مِلَّة الإسْلامِ تَبْديلُ",24,"ل",1,0],["الله ربي وقد أوصى بسترهمُ","فما لكم قد فضحتم كل ذي ستر",25,"ر",1,0],["اللهُ رَبُّ الكَوْنِ دَمَّرَ مُلْكَهُمْ","أَعْلَى الكَلِيمَ وَ خَابَ صَوْتٌ مُرْعِبُ",26,"ب",1,0],["اللهُ روحِي, طُمُوحِي, رَاحَتِي, سَكَنِي","لَا أَجْتَنِي الأُنْسَ إِلَّا مِنْ مَغَانِيهَا",27,"ي",3,0],["الله رفّع نحو المجد نجْلتنا ال","عُظمى هنادي وناياً دون أن تَلِجا",28,"ج",2,1],["الله رافع رايتي وكرامتي","بملائكٍ قد خُصصتْ لرعايتي",29,"ي",1,1],["الله رازقه بزوجته التي","آتته معجزتين في الإفصاحِ",30,"ح",1,0],["اللهُ رَاْزقُ كُلَّ حَيٍّ جُوْدَهُ","في دُوْدَةٍ عَمْيَاْ بجوفِ جَمَاْدِ .",31,"د",1,0]]}