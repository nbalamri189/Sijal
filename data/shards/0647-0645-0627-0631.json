{"poems":[[64,"فديتك أقوال الوشاة كثيرة","https://www.aldiwan.net/poem52260.html","الطويل"],[30,"كيف تقول وجد بني تميم","https://www.aldiwan.net/poem5626.html","الوافر"],[68,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[107,"بني الإسلام إقداما","https://www.aldiwan.net/poem42106.html","مجزوء الوافر"],[302,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[302,"ما على حاديهم لو كان عاجا","https://www.aldiwan.net/poem33310.html","الرمل"],[406,"فجر في دجى الأحداث","https://www.aldiwan.net/poem10239.html","عموديه"],[411,"زيادة المرء في دنياه نقصان","https://www.aldiwan.net/poem49713.html","البسيط"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97007","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48674","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35392","الكامل"],[1138,"","https://poetry.dctabudhabi.ae/diwan/poem/100662","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87818","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87833","الخفيف"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89529","البسيط"],[2162,"","https://poetry.dctabudhabi.ae/diwan/poem/96058","الوافر"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60829","البسيط"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107170","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65937","الطويل"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106684","السريع"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100188","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89266","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74057","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205589","السريع"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125823","الرمل"],[4113,"","https://poetry.dctabudhabi.ae/diwan/poem/145508","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73260","الكامل"],[4439,"","https://poetry.dctabudhabi.ae/diwan/poem/105893","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120457","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139490",""],[4439,"إنِّي أمرؤُ لا يَطَّبِي","https://www.poetsgate.com/ViewPoem.aspx?id=112510",""],[5190,"لن تهوني يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=153356",""],[5213,"أين العذيب وآرام بواديه","https://www.poetsgate.com/ViewPoem.aspx?id=170569",""],[5725,"جحر ضب","https://www.poetsgate.com/ViewPoem.aspx?id=187234",""],[6167,"حديث الغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85540&r=&rc=23",""]],"verses":[["همُ أرجفوا بالوصلِ بيني وبينكمْ","وظُنَّ بنا فيما حكوهُ ظنونُ",0,"ن",1,0],["هُمُ أَربابُكُم وَلَهُم عَلَيكُم","فُضولُ السابِقاتِ مِنَ الرِهانِ",1,"ن",1,0],["هُم أَرضَعوني ثُدِيَّ الوَصلِ حافِلَةً","فَكَيفَ يَحسُنُ مِنها حالُ مُنفَطِمِ",2,"م",1,0],["هُما رَمْزُ الحَياةِ معا","فإنْ ذَهَبا مَضَتْ تَبَعا",3,"ا",1,0],["هم أَردَفوا عَذَب الخَطّي جائلةً","حيث الوشاحُ بضرب الصَارم الخذمِ",4,"م",1,0],["هم أَراقوا بِنَواهم أَدمُعي","وأَهاجوا لاعجَ الوَجدِ فَهاجا",5,"ج",2,0],["هم أراقوا دَمَ العدالة لمَّا","واجهوا أمتي بحقد دفين",6,"ن",1,0],["هُما رضيعا لِبانٍ حِكَمةٌ وتُقىً","وساكِنا وَطَنٍ مالٌ وطُغْيانُ",7,"ن",1,0],["هما رقيا في المجد ما ليس يرتقي","بأجنحة نسر وما حله النسر",8,"ر",1,0],["هم أرجفوا بالحرب يبتدرونها","وتوقعوا التدمير والتقتيلا",9,"ل",2,0],["هُم أَرضَعوا ثَديَي صَفِيٍّ فيهِم","وَحَلا الرَضاعُ فَما أَمَرَّ فِطاما",10,"م",2,0],["هما رضيعا لبان في الوغي وهما","لمصطلى الحرب مثل السمع والبصر",11,"ر",1,0],["هُم أَرغَموكِ عَلى الفُجورِ وَما اِهتَدَوا","يَوماً إِلى إِصلاحِكِ المُتَعَذِّرِ",12,"ر",1,0],["هُم أَرادوكِ أَن تَكوني بَغِيّاً","وَهُمُ أَقلَعوكِ ثَوبَ الفَضيلَه",13,"ل",2,0],["هُم أَرخَصوا في اِحتِدامِ البَأسِ أَنفُسَهُم","لا يَخشَعونَ إِذا ما حادِثٌ فَدَحا",14,"ح",2,0],["هم أرض لأرجلكم وأنتم","لأيديهم وأعينهم سماء",15,"ا",2,0],["هُمْ أرسلوا الطيفَ حتى زارني سحراً","فمرحباً بمزارِ الطيفِ في الحُلُمِ",16,"م",1,0],["هُم أَرسَلُوني شافِعاً وَمُقدِّماً","جاهِي وَأَنتَ المَقصِدُ المُختارُ",17,"ر",1,0],["هما رسيا فيها فقرت بأهلها","كما قرت الغبرا بصمّ الشناخب",18,"ب",1,0],["هُم أركَبُوا المَلكَ النُّجُومَ ووش","شَحُوهُ بالجوزاءِ أيِّ اتشاح",19,"ح",1,0],["هما رضيعا لبان الفخر قد جبلا","على الهدى وعلى حب العلى طبعا",20,"ع",2,0],["هما رضيعا لبانِ الغيثِ مذ نشآ","ما بال ذا صار محمرّاً وذا يَقِقا",21,"ق",2,0],["هم أَراقوا دم العِباد وَراحوا","يَسألونَ العِباد من ذا أَراقا",22,"ق",2,0],["هما رضيعا رحمة ثديها","لا يفطم الأبناء فطم السنينْ",23,"ن",1,0],["هم أروه العسفَ ألواناً فما","لانَ مما ناله ظلما وهابا",24,"ب",2,0],["هم أرشدوا الأقلام للجري سالفاً","كما أرشدوا السيف المهند للضرب",25,"ب",1,0],["هُم أَرسلوهُ وقد أتاهُ مبُشِّراً","من بعد ما غضروا زماناً بالرِّضا",26,"ض",2,0],["هم أرى في يثه","ذُلاً وملءُ فَمي لِجَام",27,"م",1,0],["هما ركنان للمجد استعزا","بسؤدده فذاك المستعان",28,"ن",1,0],["هم أربع في المجد أركان العلا","وبهم أقيمت كعبة العلياء",29,"ا",2,0],["هم أرى في بَثِّه","ذُلاً وملءُ فَمي لِجَام",30,"م",1,0],["هُم أَرَادوا لكِ الهلاكَ وظَنُوا","بِكِ يَا مِصرُ كُلَّ كُلَّ الظُّنُونِ",31,"ن",1,0],["هم اركبوني العلى خيلا مسومة","فرحت عنهم ومنهم حيث ارويه",32,"ي",2,0],["هم ارادوا ومااراد سوانا","انْ يدوس على الجباه حذاءُ",33,"ا",2,0],["هم ارادوا فمالنا لا نشاءُ","ان يسود بارضنا الدخلاءُ",33,"ا",2,0],["هم أَرعشوا هذى الديارَ فارعَدتْ","هم أَيقظُوا فِتناً غَفَتْ في السرَمدِ",34,"د",1,0]]}