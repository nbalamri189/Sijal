غدادي","https://www.poetsgate.com/ViewPoem.aspx?id=175230",""],[5861,"زبد الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=194448",""],[5877,"الكيف","https://www.poetsgate.com/ViewPoem.aspx?id=52287",""],[5956,"أنا نار","https://www.poetsgate.com/ViewPoem.aspx?id=182598",""],[6052,"كواكب أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=34627",""],[6089,"نهر البصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=212970",""],[6115,"رثاء للشاعر سعد بن جدلان","https://www.poetsgate.com/ViewPoem.aspx?id=180459",""],[5355,"عن الحبّ الذي ولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87125&r=&rc=20",""],[2914,"لِمَن طَلَلٌ ، مِثلُ الكِتابِ المُنمَّقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24236&r=&rc=2",""]],"verses":[["لَهُ بِجَنوبِ القادِسِيَّةِ فَالشَرى","مَواطِنُ لا يَمشي بِهِنَّ الأَراجِلُ",0,"ل",1,0],["لَهُ بَسطَتا مَجدٍ فَكَفٌّ مُفيدَةٌ","وَأُخرى بِأَطرافِ القَناةِ شُقورُها",1,"ر",3,0],["لَهُ باذِخاتٌ مِن لُؤَيِّ بنِ غالِبٍ","يُقَصِّرُ عَنها المُدَّعي وَالمُخالِفُ",2,"ف",1,0],["لَهُ بَطشُ قاسٍ تَحتَهُ قَلبُ راحِمٍ","وَمَنعُ بَخيلٍ تَحتَهُ بَذلُ مُفضِلِ",3,"ل",1,0],["لَهُ بِسُلَيمٍ وَقعَةٌ جاهِلِيَّةٌ","تُقِرُّ بِها فَيدٌ وَتَشهَدُ حاجِرُ",4,"ر",1,0],["لَهُ بِالهُمامِ اِبنِ المُعَمَّرِ فَتكَةٌ","وَفي السَيفُ فيها وَالرِماحُ غَوادِرُ",4,"ر",1,0],["له بدائع لفظ صاحبت كرماً","كأنَّهنَّ نجومٌ ذاتُ أنواء",5,"ا",2,0],["له بركاتٌ تلوهنَّ مكارمٌ","فيا لمعالٍ أُيِّدت بمعالي",6,"ل",2,0],["له بشعريَ إمساكٌ بمعرفةٍ","وفي البسيطة تسريحٌ بإحسانِ",7,"ن",1,0],["له بنا خلواتٌ يا للذتها","تشفي القلوب وتجلوها من الرَّين",8,"ن",1,0],["له بالقضايا الفلسفية خبرة","يشاركني في البحث عنها وفي النقب",9,"ب",1,0],["لَهُ بِالشامِ أَعلامٌ وَعُرسٌ","بَشائِرُهُ بِأَندَلُسٍ تَدُقُّ",10,"ق",1,0],["لَهُ بِدَعٌ في الجودِ تَدعو عَذولَهُ","عَلَيهِ إِلى اِستِحسانِها فَيُساعِدُه",11,"د",2,0],["لَهُ بَينَ جوذَرزٍ وَبيبٍ مَناقِبٌ","شَراوى لِأَعلامِ الدُجى وَشُكولُ",12,"ل",1,0],["لَهُ بَسطَةٌ لا يَملُكُ الناسُ رَدَّها","يَدينُ لَهُ أَهلُ البِلادِ وَيُحجَبوا",13,"ب",3,0],["له بتَشييدِ مَجْدِهِ شُغُلٌ","وللقَوافي بذكْرِهِ شُغُلُ",14,"ل",1,0],["لَهُ بَيتانِ بيتٌ تُبَّعِيٌّ","وَبَيتٌ حَلَّ بِالبَلَدِ الحَرامِ",15,"م",1,0],["لَهِبَت وَقَد رَأتِ الظَلامَ وَلَم تَكُن","تَاللَهِ لاهِيَةً لِضُعفِ جَنانِها",16,"ن",3,0],["لهبٌ تُضاعِفُه الريا","حُ فكلما بِنتِ استمر",17,"ر",1,0],["له بَصَرٌ مستخرِجٌ خبء ليلةٍ","إذا الحسّ أهداه إلى قلبه السّمعُ",18,"ع",1,0],["له بيعةٌ ما زال فيها مُحَلِّلاً","حرامَ الرِّبا في بيعهِ التِّبرِ بالتِّبرِ",19,"ر",1,0],["لَهُ بَيْتُ مَجْدٍ رَفْرَفَتْ دُونَ سَقْفِهِ","حَمَامُ الدَّرَارِي مُشْمَخِرُّ الدَّعَائِمِ",20,"م",1,0],["لَهَبّوا سِراعاً إِلى الصالِحاتِ","وَساروا عَلى السَنَنِ الأَقوَمِ",21,"م",1,0],["لَهُ بَكَيتُ كَما يَبكي النَوى رَجُلٌ","عَلى المَعالِمِ وَالأَطلالِ بَكّاءُ",22,"ا",2,0],["لَهُ بَحرٌ يُقَمِّصُ بِالعَدَولي","وَبِالخُلُجِ المُحَمَّلَةِ الثِقالِ",23,"ل",1,0],["لَهُ بِفَناءِ البَيتِ سَوداءُ فَخمَةٌ","تُلَقَّمُ أَوصالَ الجَزورِ العَراعِرِ",24,"ر",1,0],["له ببغداد عشّ لا يفارقه","بناه في دوحها بين الأفانين",25,"ن",1,0],["له بأسُ مانا وإيحاؤه","إذا اضطربتْ رُوحهُ بالألمْ",26,"م",1,0],["لَهُ بَيْنَ مَجْرَى الْقَوْلِ آيَاتُ حِكْمَةٍ","يَدُورُ عَلَى آدَابِهَا الْجِدُّ وَالْهَزْلُ",27,"ل",1,0],["لَهُ بَدَهَاتٌ لا تَغبُّ وَعَزْمَةٌ","مُؤَيَّدَةٌ تَعْنُو إِلَيْهَا الْجَحَافِلُ",28,"ل",1,0],["لَهُ بِالْفَلا شُغْلٌ عَنِ الْمُدْنِ وَالْقُرَى","وَفِي رَائِدَاتِ الْخَيْلِ شُغْلٌ عَنِ الأَهْلِ",29,"ل",1,0],["لَهُ بِمَوَدَّةِ السُّودَانِ عَهْدٌ","وَثِيقٌ لاَ تَرِثُّ لَهُ حِبَالُ",30,"ل",1,0],["لَهُ بَينَ جُوذَرْزٍَ مَنَاقِبٌ شَرَاوَى","لأعْلامِ الدّجَى، وَشُكُولُ",31,"ل",1,0],["له بكيتُ ، كما يبكي النَّولى رجلٌ","على المَعالمِ والأطلال بكّاءُ",32,"ا",2,0],["لهُ بيتُ مجدِ ، زفرفتْ دونَ سقفهِ","حَمَامُ الدَّرَارِي، مُشْمَخِرُّ الدَّعَائِمِ",33,"م",1,0],["لَهُ بِشُفوفِ القَدرِ في العالَمِ العُلوي","فَكَم مِن غَويٍّ في بَطالَةِ مُفسِدٍ",34,"د",1,0],["له بهم فخر ولكن فخرهم","بأحمد من كل الفخار يزيدُ",35,"د",1,0],["لَهَبٌ يَكونُ إِذا تَلَبَّسَ بِالحَشا","قَيظاً وَيَظهَرُ في الجُفونِ رَبيعا",36,"ع",2,0],["له بالسيف والقلم افتخارٌ","تَعاظمَ في الكَتيبة وَالكِتاب",37,"ب",1,0],["له بياضٌ يغُضّ الطَّرْفَ لامعُه","فالعينُ تَلْحَظ منه الْحُسنَ في المَلَحِ",38,"ح",1,0],["له باطن في ظاهر قد تكافيا","فباطنه ملء القلوب وقاهرُه",39,"ر",2,0],["له بقية روح في أصابعه","ينازع الموت فيها وهي تنتزع",40,"ع",1,0],["لهب في مائه يضرمه","ذهب في صفحة الأفق يذوب",41,"ب",1,0],["له باليد البيضاء أعظمُ آيةٍ","إذا اسودَّتِ الأيام من نُوَبِ الدَّهرِ",42,"ر",1,0],["له بصيرة كاف في بديهته","تعطيك ما قال بصري وكوفي",43,"ي",1,0],["له بِفاطِمة الزَهرا وَحيدرة","وَأَحمد شرف يَسمو وَبنيان",44,"ن",1,0],["لَهُ بَسْطَةٌ في العِلمِ والحلْمِ زَانَها","بِقَبْضِ الخُطَى إلا لِكَفِّ المَظَالِمِ",45,"م",1,0],["لَهُ بَشَرٌ أَنيقٌ ناعِمٌ كَال","حَريرِ يَشِفُّ لَمّاعَ الصِّقالِ",46,"ل",1,0],["لَه بِوالدهِ المحفوظ نجل أبي ال","مَكارمِ العربيّ المنزل الشممُ",47,"م",1,0],["له بِبابك حاجاتٌ سَيَبلغها","إِليه ضامنة إِنجاحها الكتبُ",48,"ب",1,0],["لَهُ بُروقٌ تَهيجُ الرَعدُ آوِنَةً","كَما تَضَرَّمَ في حافاتِها الشُعَلُ",49,"ل",1,0],["لَهُ بُلْغَةٌ في الرِزْقِ أُغْلِقَ بَابُّها","فَيَممَّ بَابَ الفَتْحِ في طَلَبِ الفَتْحِ",50,"ح",1,0],["لَهُ بِهِم فِيَّ عَلَيَّ شاهِدٌ","غادَرَني في مَأَمَني عَلى حَذَر",51,"ر",1,0],["له بأَوصافِك عِطرِيّةٌ","تَعبَقُ بالسّامعِ والقائل",52,"ل",1,0],["لَهُ بِمِثلٍ عاقِرُ وَلّادُهُ","مَعما يُرى مِن كَثرَةٍ في العَدَدِ",53,"د",1,0],["له بسطتاكف ببأس ونائل","وسجلا معال من لُها وَدِماء",54,"ا",2,0],["لَهَبانٌ وَقَدَت حِزَّانُهُ","يَرمَضُ الجُندُبُ مِنهُ فَيَصِرّْ",55,"ر",1,0],["لهُ بهام الأدوا صَخُّ","وهو مع القدم الغبي فَرخُ",56,"خ",1,0],["لهب لا يصطليه أحد","في فؤاد مسه النصب",57,"ب",1,0],["له بارق الغيث المُلِثّ وما له","لعمر أبيك الخير جلجلة الرَّعد",58,"د",1,0],["لَهَبَّ العويلُ هبوبَ الرِّياحِ","فَعفَّى السُّلُوَّ عَفاءَ الرُّبوعِ",59,"ع",1,0],["له بِدَعُ المكارم لو رآها","لآخرَ قبلَه قلنا حكاها",60,"ا",3,0],["له بين أثناء الجبالِ وأهلها","مَزَارٌ حَبيبٌ دونه طُرُقٌ عِدَا",61,"د",2,0],["له بالعزْم أقْطى البُعْدِ دانٍ","ووعْرُ المجدِ مُنتَهَباً كسَهْلِ",62,"ل",1,0],["لهُ بالحمدِ أُنْسٌ وامتزاجٌ","وعن عار الرجال به نُف