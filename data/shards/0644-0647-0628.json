{"poems":[[35,"عفا ميث كلفى بعدنا فالأجاول","https://www.aldiwan.net/poem39113.html","الطويل"],[10,"ألا ابكي على صخر وصخر ثمالنا","https://www.aldiwan.net/poem21099.html","الطويل"],[27,"طربت وما هذا الصبا والتكالف","https://www.aldiwan.net/poem5926.html","الطويل"],[47,"إباء إباء البكر غير مذلل","https://www.aldiwan.net/poem25207.html","الطويل"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[72,"أودت فعالك يا أسما بأحشائي","https://www.aldiwan.net/poem18168.html","البسيط"],[72,"سرى بشبيه البدر آل هلال","https://www.aldiwan.net/poem19482.html","الطويل"],[72,"العيد أنت وهذا عيدنا الثاني","https://www.aldiwan.net/poem20159.html","البسيط"],[51,"نحب كل غلام فيه ميعته","https://www.aldiwan.net/poem66510.html","البسيط"],[89,"كتاب رثاء يحمل البث من قلبي","https://www.aldiwan.net/poem44958.html","الطويل"],[85,"سلام من صبا بردى أرق","https://www.aldiwan.net/poem24321.html","عموديه"],[45,"دنا السرب إلا أن هجرا يباعده","https://www.aldiwan.net/poem63461.html","الطويل"],[45,"لها الله عني ضامن وكفيل","https://www.aldiwan.net/poem65604.html","الطويل"],[28,"ألم يك جهلاً بعد سبعين حجة","https://www.aldiwan.net/poem1285.html",""],[61,"لا يعرف العدل وهو معتدل","https://www.aldiwan.net/poem51483.html","السريع"],[49,"سقيت الغيث يا قصر السلام","https://www.aldiwan.net/poem64905.html","الوافر"],[66,"أهلا بها كالقضب في كثبانها","https://www.aldiwan.net/poem41343.html","الكامل"],[97,"قل تمهل واصطبر","https://www.aldiwan.net/poem24411.html","مجزوء الرمل"],[80,"أيا جزعي بالدار إذ عن لي الجزع","https://www.aldiwan.net/poem31387.html","الطويل"],[80,"تغنت قيان الورق في الورق الخضر","https://www.aldiwan.net/poem31443.html","الطويل"],[87,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[105,"أرى الأرض ترجف بالعالمين","https://www.aldiwan.net/poem43143.html","المتقارب"],[48,"بين المدام وبين الماء شحناء","https://www.aldiwan.net/poem10402.html","البسيط"],[7,"أمن ظلامة الدمن البوالي","https://www.aldiwan.net/poem1977.html","الوافر"],[7,"بخالة أو ماء الذنابة أو سوى","https://www.aldiwan.net/poem1987.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85507","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42728","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42732","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42730","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55161","الوافر"],[45,"لَهَا الله عَنّي ضَامِنٌ وَكَفِيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32127",""],[48,"بَينَ المُدام، وبَينَ الماء شَحناءُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24842&r=&rc=12",""],[87,"لعزة ِ هذي اللاهياتِ النواعمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23774&r=&rc=36",""],[151,"تركنا زهيرا للبقيع فثهمد","https://www.aldiwan.net/poem68579.html","الطويل"],[161,"عليك برأي السيف فهو سديد","https://www.aldiwan.net/poem58940.html","الطويل"],[165,"قلب تقطع فاستحال نجيعا","https://www.aldiwan.net/poem67883.html","الكامل"],[186,"عسى يبلى العذول ببعض ما بي","https://www.aldiwan.net/poem14126.html","الوافر"],[186,"انظر إلى المجلس الأعلى وما جمعت","https://www.aldiwan.net/poem14138.html","البسيط"],[187,"تأدى رجال في التمام وأهله","https://www.aldiwan.net/poem43819.html","الطويل"],[200,"يا ظلة الموج يطغى البحر منتفضاً","https://www.aldiwan.net/poem45135.html","البسيط"],[222,"ذهب اليوم وقد آن الغروب","https://www.aldiwan.net/poem55262.html","الرمل"],[251,"نقلت لقلبي ما بجفنك من كسر","https://www.aldiwan.net/poem14968.html","الطويل"],[262,"قد أحرز السبق مولانا الحريزي","https://www.aldiwan.net/poem38108.html","البسيط"],[272,"يا جيرة الحي في ذا الاثل والبان","https://www.aldiwan.net/poem52066.html","البسيط"],[276,"لعل قسيم الفضل من آل قاسم","https://www.aldiwan.net/poem25521.html","الطويل"],[283,"عذولي لا تلمني في هلالي","https://www.aldiwan.net/poem32663.html","الوافر"],[306,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[306,"ينهي إليك سلاما جارك الجنب","https://www.aldiwan.net/poem56608.html","البسيط"],[323,"بانت سليمى وأقوى بعدها تبل","https://www.aldiwan.net/poem56346.html","البسيط"],[349,"أمولاي فتح الدين دعوة خادم","https://www.aldiwan.net/poem19947.html","الطويل"],[350,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[365,"قل لسديد الحضرة المرتجى","https://www.aldiwan.net/poem60793.html","السريع"],[365,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[365,"سواء تدان منهم وتناء","https://www.aldiwan.net/poem61015.html","الطويل"],[368,"مثل عداء بروضات القطا","https://www.aldiwan.net/poem4617.html","الرمل"],[381,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[404,"هل ينال القلب ما طلبا","https://www.aldiwan.net/poem34147.html","المديد"],[417,"لمن أينق يا سعد ترقل أو تخدي","https://www.aldiwan.net/poem53991.html","الطويل"],[440,"عزاء وأنت عزاء الجميع","https://www.aldiwan.net/poem34774.html","المتقارب"],[459,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[459,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[462,"أداري المرء ذا خلق نكير","https://www.aldiwan.net/poem15478.html","الوافر"],[462,"يقحمه ويمسكه قديرا","https://www.aldiwan.net/poem15484.html","الوافر"],[462,"له بالمجد أنس مطمئن","https://www.aldiwan.net/poem16135.html","الوافر"],[469,"وستر له منظر مونق","https://www.aldiwan.net/poem59805.html","المتقارب"],[501,"رآني بمرط الإنكسار أخو الهوى","https://www.aldiwan.net/poem37972.html","الطويل"],[515,"يلوح فتستدعي الفراش وتبسم","https://www.aldiwan.net/poem20798.html","الطويل"],[515,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[516,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[544,"أقيدوا القوم إن الظلم لايرضاه ديان","https://www.aldiwan.net/poem1761.html","الهزج"],[554,"سرت بملام حين هوم عذلي","https://www.aldiwan.net/poem68431.html","الطويل"],[559,"لهب النار في الفتيلة كالرو","https://www.aldiwan.net/poem34711.html","الخفيف"],[563,"تقلص ظل للشباب وريف","https://www.aldiwan.net/poem52757.html","الطويل"]],"verses":[["لَهُ بِجَنوبِ القادِسِيَّةِ فَالشَرى","مَواطِنُ لا يَمشي بِهِنَّ الأَراجِلُ",0,"ل",1,0],["لَهُ بَسطَتا مَجدٍ فَكَفٌّ مُفيدَةٌ","وَأُخرى بِأَطرافِ القَناةِ شُقورُها",1,"ر",3,0],["لَهُ باذِخاتٌ مِن لُؤَيِّ بنِ غالِبٍ","يُقَصِّرُ عَنها المُدَّعي وَالمُخالِفُ",2,"ف",1,0],["لَهُ بَطشُ قاسٍ تَحتَهُ قَلبُ راحِمٍ","وَمَنعُ بَخيلٍ تَحتَهُ بَذلُ مُفضِلِ",3,"ل",1,0],["لَهُ بِسُلَيمٍ وَقعَةٌ جاهِلِيَّةٌ","تُقِرُّ بِها فَيدٌ وَتَشهَدُ حاجِرُ",4,"ر",1,0],["لَهُ بِالهُمامِ اِبنِ المُعَمَّرِ فَتكَةٌ","وَفي السَيفُ فيها وَالرِماحُ غَوادِرُ",4,"ر",1,0],["له بدائع لفظ صاحبت كرماً","كأنَّهنَّ نجومٌ ذاتُ أنواء",5,"ا",2,0],["له بركاتٌ تلوهنَّ مكارمٌ","فيا لمعالٍ أُيِّدت بمعالي",6,"ل",2,0],["له بشعريَ إمساكٌ بمعرفةٍ","وفي البسيطة تسريحٌ بإحسانِ",7,"ن",1,0],["له بنا خلواتٌ يا للذتها","تشفي القلوب وتجلوها من الرَّين",8,"ن",1,0],["له بالقضايا الفلسفية خبرة","يشاركني في البحث عنها وفي النقب",9,"ب",1,0],["لَهُ بِالشامِ أَعلامٌ وَعُرسٌ","بَشائِرُهُ بِأَندَلُسٍ تَدُقُّ",10,"ق",1,0],["لَهُ بِدَعٌ في الجودِ تَدعو عَذولَهُ","عَلَيهِ إِلى اِستِحسانِها فَيُساعِدُه",11,"د",2,0],["لَهُ بَينَ جوذَرزٍ وَبيبٍ مَناقِبٌ","شَراوى لِأَعلامِ الدُجى وَشُكولُ",12,"ل",1,0],["لَهُ بَسطَةٌ لا يَملُكُ الناسُ رَدَّها","يَدينُ لَهُ أَهلُ البِلادِ وَيُحجَبوا",13,"ب",3,0],["له بتَشييدِ مَجْدِهِ شُغُلٌ","وللقَوافي بذكْرِهِ شُغُلُ",14,"ل",1,0],["لَهُ بَيتانِ بيتٌ تُبَّعِيٌّ","وَبَيتٌ حَلَّ بِالبَلَدِ الحَرامِ",15,"م",1,0],["لَهِبَت وَقَد رَأتِ الظَلامَ وَلَم تَكُن","تَاللَهِ لاهِيَةً لِضُعفِ جَنانِها",16,"ن",3,0],["لهبٌ تُضاعِفُه الريا","حُ فكلما بِنتِ استمر",17,"ر",1,0],["له بَصَرٌ مستخرِجٌ خبء ليلةٍ","إذا الحسّ أهداه إلى قلبه السّمعُ",18,"ع",1,0],["له بيعةٌ ما زال فيها مُحَلِّلاً","حرامَ الرِّبا في بيعهِ التِّبرِ بالتِّبرِ",19,"ر",1,0],["لَهُ بَيْتُ مَجْدٍ رَفْرَفَتْ دُونَ سَقْفِهِ","حَمَامُ الدَّرَارِي مُشْمَخِرُّ الدَّعَائِمِ",20,"م",1,0],["لَهَبّوا سِراعاً إِلى الصالِحاتِ","وَساروا عَلى السَنَنِ الأَقوَمِ",21,"م",1,0],["لَهُ بَكَيتُ كَما يَبكي النَوى رَجُلٌ","عَلى المَعالِمِ وَالأَطلالِ بَكّاءُ",22,"ا",2,0],["لَهُ بَحرٌ يُقَمِّصُ بِالعَدَولي","وَبِالخُلُجِ المُحَمَّلَةِ الثِقالِ",23,"ل",1,0],["لَهُ بِفَناءِ البَيتِ سَوداءُ فَخمَةٌ","تُلَقَّمُ أَوصالَ الجَزورِ العَراعِرِ",24,"ر",1,0],["له ببغداد عشّ لا يفارقه","بناه في دوحها بين الأفانين",25,"ن",1,0],["له بأسُ مانا وإيحاؤه","إذا اضطربتْ رُوحهُ بالألمْ",26,"م",1,0],["لَهُ بَيْنَ مَجْرَى الْقَوْلِ آيَاتُ حِكْمَةٍ","يَدُورُ عَلَى آدَابِهَا الْجِدُّ وَالْهَزْلُ",27,"ل",1,0],["لَهُ بَدَهَاتٌ لا تَغبُّ وَعَزْمَةٌ","مُؤَيَّدَةٌ تَعْنُو إِلَيْهَا الْجَحَافِلُ",28,"ل",1,0],["لَهُ بِالْفَلا شُغْلٌ عَنِ الْمُدْنِ وَالْقُرَى","وَفِي رَائِدَاتِ الْخَيْلِ شُغْلٌ عَنِ الأَهْلِ",29,"ل",1,0],["لَهُ بِمَوَدَّةِ السُّودَانِ عَهْدٌ","وَثِيقٌ لاَ تَرِثُّ لَهُ حِبَالُ",30,"ل",1,0],["لَهُ بَينَ جُوذَرْزٍَ مَنَاقِبٌ شَرَاوَى","لأعْلامِ الدّجَى، وَشُكُولُ",31,"ل",1,0],["له بكيتُ ، كما يبكي النَّولى رجلٌ","على المَعالمِ والأطلال بكّاءُ",32,"ا",2,0],["لهُ بيتُ مجدِ ، زفرفتْ دونَ سقفهِ","حَمَامُ الدَّرَارِي، مُشْمَخِرُّ الدَّعَائِمِ",33,"م",1,0],["لَهُ بِشُفوفِ القَدرِ في العالَمِ العُلوي","فَكَم مِن غَويٍّ في بَطالَةِ مُفسِدٍ",34,"د",1,0],["له بهم فخر ولكن فخرهم","بأحمد من كل الفخار يزيدُ",35,"د",1,0],["لَهَبٌ يَكونُ إِذا تَلَبَّسَ بِالحَشا","قَيظاً وَيَظهَرُ في الجُفونِ رَبيعا",36,"ع",2,0],["له بالسيف والقلم افتخارٌ","تَعاظمَ في الكَتيبة وَالكِتاب",37,"ب",1,0],["له بياضٌ يغُضّ الطَّرْفَ لامعُه","فالعينُ تَلْحَظ منه الْحُسنَ في المَلَحِ",38,"ح",1,0],["له باطن في ظاهر قد تكافيا","فباطنه ملء القلوب وقاهرُه",39,"ر",2,0],["له بقية روح في أصابعه","ينازع الموت فيها وهي تنتزع",40,"ع",1,0],["لهب في مائه يضرمه","ذهب في صفحة الأفق يذوب",41,"ب",1,0],["له باليد البيضاء أعظمُ آيةٍ","إذا اسودَّتِ الأيام من نُوَبِ الدَّهرِ",42,"ر",1,0],["له بصيرة كاف في بديهته","تعطيك ما قال بصري وكوفي",43,"ي",1,0],["له بِفاطِمة الزَهرا وَحيدرة","وَأَحمد شرف يَسمو وَبنيان",44,"ن",1,0],["لَهُ بَسْطَةٌ في العِلمِ والحلْمِ زَانَها","بِقَبْضِ الخُطَى إلا لِكَفِّ المَظَالِمِ",45,"م",1,0],["لَهُ بَشَرٌ أَنيقٌ ناعِمٌ كَال","حَريرِ يَشِفُّ لَمّاعَ الصِّقالِ",46,"ل",1,0],["لَه بِوالدهِ المحفوظ نجل أبي ال","مَكارمِ العربيّ المنزل الشممُ",47,"م",1,0],["له بِبابك حاجاتٌ سَيَبلغها","إِليه ضامنة إِنجاحها الكتبُ",48,"ب",1,0],["لَهُ بُروقٌ تَهيجُ الرَعدُ آوِنَةً","كَما تَضَرَّمَ في حافاتِها الشُعَلُ",49,"ل",1,0],["لَهُ بُلْغَةٌ في الرِزْقِ أُغْلِقَ بَابُّها","فَيَممَّ بَابَ الفَتْحِ في طَلَبِ الفَتْحِ",50,"ح",1,0],["لَهُ بِهِم فِيَّ عَلَيَّ شاهِدٌ","غادَرَني في مَأَمَني عَلى حَذَر",51,"ر",1,0],["له بأَوصافِك عِطرِيّةٌ","تَعبَقُ بالسّامعِ والقائل",52,"ل",1,0],["لَهُ بِمِثلٍ عاقِرُ وَلّادُهُ","مَعما يُرى مِن كَثرَةٍ في العَدَدِ",53,"د",1,0],["له بسطتاكف ببأس ونائل","وسجلا معال من لُها وَدِماء",54,"ا",2,0],["لَهَبانٌ وَقَدَت حِزَّانُهُ","يَرمَضُ الجُندُبُ مِنهُ فَيَصِرّْ",55,"ر",1,0],["لهُ بهام الأدوا صَخُّ","وهو مع القدم الغبي فَرخُ",56,"خ",1,0],["لهب لا يصطليه أحد","في فؤاد مسه النصب",57,"ب",1,0],["له بارق الغيث المُلِثّ وما له","لعمر أبيك الخير جلجلة الرَّعد",58,"د",1,0],["لَهَبَّ العويلُ هبوبَ الرِّياحِ","فَعفَّى السُّلُوَّ عَفاءَ الرُّبوعِ",59,"ع",1,0],["له بِدَعُ المكارم لو رآها","لآخرَ قبلَه قلنا حكاها",60,"ا",3,0],["له بين أثناء الجبالِ وأهلها","مَزَارٌ حَبيبٌ دونه طُرُقٌ عِدَا",61,"د",2,0],["له بالعزْم أقْطى البُعْدِ دانٍ","ووعْرُ المجدِ مُنتَهَباً كسَهْلِ",62,"ل",1,0],["لهُ بالحمدِ أُنْسٌ وامتزاجٌ","وعن عار الرجال به نُفورُ",63,"ر",1,0],["لهُ بالمجْدِ أنْسٌ مُطْمئَنٌّ","وعنْ عارٍ يُدَنِّسهُ نِفارُ",64,"ر",1,1],["لَهُ بَينَ أَزهارِهِ أَغصُنٌ","فَمِنها المُنَوِّرِ وَالمورِقُ",65,"ق",1,0],["له بحرُ قلبٍ هاشِمِيٍّ نِجارُهُ","تَسيلُ بُحورُ الكَوْنِ من أَصلِ نبْعِهِ",66,"ع",2,0],["له بَيتُ مجدٍ شامخٌ في صعيدِه","تعفَّرُ آنافُ المُلوكِ وتُرغَمُ",67,"م",1,0],["له بصرٌ يرنو به عن بَصيرةٍ","يجوزُ حُدودَ الغيبِ وهو حَديدُ",68,"د",1,0],["له بشر يهش إلى المصافي","وأخلاق تصد عن المصاد",69,"د",1,0],["له بادِرَةٌ من","أحمرِ الجَوفِ وثُعبانُ",70,"ن",1,0],["لَهُ بَدَهاتٌ مِن فِعالٍ وَقَولُهُ","هُوَ الفِعلُ إِلّا رَيثَ وَعدٍ مُعَجَّلِ",71,"ل",1,0],["لهب النار في الفتيلة كالرو","ح لدى الجسم والغذا كالزيت",72,"ت",1,1],["لهُ بينَ أكبادِ الرِّجالِ مَخالبٌ","نَشِبنَ وَفِي الأَعناقِ مِنهُ سُيوفُ",73,"ف",1,0]]}