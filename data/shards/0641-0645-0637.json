{"poems":[[63,"لمعت كناصية الحصان الأشقر","https://www.aldiwan.net/poem46196.html","الكامل"],[86,"يا جاك إنك في زمانك واحد","https://www.aldiwan.net/poem10951.html","الكامل"],[47,"كيف أرجو الصلاح من أمر قوم","https://www.aldiwan.net/poem25236.html","الخفيف"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[303,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[362,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[436,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[459,"يذل الجحفل الجرار بأسا","https://www.aldiwan.net/poem15440.html","الوافر"]],"verses":[["فمَطالعُ البَيداءِ تَعلَمُ أنّني","أسْري وأَعنُفُ بالمَهارَى الحُسَّرِ",0,"ر",1,0],["فَمُطالِبٌ بِإِعادَةٍ وَمَطالِبٌ","بِزِيادَةٍ وَمُهَلِّلٌ وَمُصَفِّقُ",1,"ق",1,0],["فَمُطاعُ المَقالِ غَيرُ سَديدٍ","وَسَديدُ المَقالِ غَيرُ مُطاعِ",2,"ع",1,0],["فَمُطَّرِفٌ مِمَّا تَكَسَّبَ مُحْدَثٌ","وآخَرُ قُدْمُوسٌ على الدَّهْر مُلْتَدُ",3,"د",1,0],["فَمطمحُ ربّ التجرِ نفعٌ معمّمٌ","وذي الصنعِ آثارٌ حسانٌ يجيدها",4,"د",3,0],["فمطَرْتَها هاماً متى ماتُحصِها","معَ قَطْرِ ذاك اليومِ تُوفِ وتَزددَ",5,"د",1,0],["فمطعَمُها لحمي وَمَشْرَبُها دَمي","وتَرْتَعُ فِي جِسْمي وتَأْوي إِلَى قلبي",6,"ب",2,0],["فمطعانٌ إذا اشْتجرَ العوالي","ومِطعامٌ إذا هَرَّ الشتاءُ",7,"ا",2,0]]}