{"poems":[[65,"لمعت كناصية الحصان الأشقر","https://www.aldiwan.net/poem46196.html","الكامل"],[88,"يا جاك إنك في زمانك واحد","https://www.aldiwan.net/poem10951.html","الكامل"],[49,"كيف أرجو الصلاح من أمر قوم","https://www.aldiwan.net/poem25236.html","الخفيف"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[310,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[369,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[445,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[466,"يذل الجحفل الجرار بأسا","https://www.aldiwan.net/poem15440.html","الوافر"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146223","الكامل"],[967,"","https://poetry.dctabudhabi.ae/diwan/poem/33108","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62646","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62503","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120028","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79997","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27983","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102534","الوافر"],[4652,"","https://poetry.dctabudhabi.ae/diwan/poem/123764","الوافر"],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""]],"verses":[["فمَطالعُ البَيداءِ تَعلَمُ أنّني","أسْري وأَعنُفُ بالمَهارَى الحُسَّرِ",0,"ر",1,0],["فَمُطالِبٌ بِإِعادَةٍ وَمَطالِبٌ","بِزِيادَةٍ وَمُهَلِّلٌ وَمُصَفِّقُ",1,"ق",1,0],["فَمُطاعُ المَقالِ غَيرُ سَديدٍ","وَسَديدُ المَقالِ غَيرُ مُطاعِ",2,"ع",1,0],["فَمُطَّرِفٌ مِمَّا تَكَسَّبَ مُحْدَثٌ","وآخَرُ قُدْمُوسٌ على الدَّهْر مُلْتَدُ",3,"د",1,0],["فَمطمحُ ربّ التجرِ نفعٌ معمّمٌ","وذي الصنعِ آثارٌ حسانٌ يجيدها",4,"د",3,0],["فمطَرْتَها هاماً متى ماتُحصِها","معَ قَطْرِ ذاك اليومِ تُوفِ وتَزددَ",5,"د",1,0],["فمطعَمُها لحمي وَمَشْرَبُها دَمي","وتَرْتَعُ فِي جِسْمي وتَأْوي إِلَى قلبي",6,"ب",2,0],["فمطعانٌ إذا اشْتجرَ العوالي","ومِطعامٌ إذا هَرَّ الشتاءُ",7,"ا",2,0],["فمطوتُ منكبَ صاحبي فأنافَ بي","وجذبنَ بالأسبابِ بعدَ تشاورِ",8,"ر",1,0],["فَمُطَّرَحٌ وَمَتروكٌ كَلامي","وَتَجفوني الأَقارِبُ وَالمَوالي",9,"ل",2,0],["فمطلقةٌ منها خلت من قرينةٍ","كليثٍ بدا أي مثلهُ في الشجاعةِ",10,"ه",1,0],["فمطلِعها سواد العَيْ","نِ والأحشا لها مرعى",11,"ع",2,0],["فمطعام إذا ما الجار أكدى","وجب المحل أسنمة السوامِ",12,"م",1,0],["فمطلعه في مشرق المجد مظلمٌ","ومغربه في موضع اللحد واضح",13,"ح",1,0],["فمطعمها للحسِّ شهدٌ لذائق","وملمسها للعقلِ كالحية الرقشا",14,"ش",2,0],["فمطل النفس أولى من غريم","تماطله إذا طالبك غرما",15,"م",2,0],["فمطلع شمسها الصدّيق جدّ","لمغرب بدرها الحسن التمام",16,"م",1,0],["فمطلبي أنت أوفى بالنجاح له","وأنت أدرى منه يا مسبغ النعم",17,"م",1,0]]}