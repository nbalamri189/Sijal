{"poems":[[65,"وقفت على ربعي سليمى بعالج","https://www.aldiwan.net/poem45728.html","الطويل"],[65,"خليلي بئس الرأي ما تريان","https://www.aldiwan.net/poem45933.html","الطويل"],[65,"بكت شجوها وهنا وكدت أهيم","https://www.aldiwan.net/poem46131.html","الطويل"],[65,"أهاجك شوق بعدما هجع الركب","https://www.aldiwan.net/poem46205.html","الطويل"],[95,"عاش هذا الفتى محبا شقيا","https://www.aldiwan.net/poem11096.html","الخفيف"],[94,"ليت شعري","https://www.aldiwan.net/poem38945.html","الخفيف"],[46,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[48,"لئن سقتك الليالي مرة ضربا","https://www.aldiwan.net/poem22736.html","البسيط"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[275,"واها وهل تجديك نفعا واها","https://www.aldiwan.net/poem35227.html","الكامل"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[303,"مهوى الفؤاد على ما هجت من ضرم","https://www.aldiwan.net/poem36277.html","عموديه"],[369,"هم منعوا مني الخيال المسلما","https://www.aldiwan.net/poem60668.html","الطويل"],[1001,"","https://poetry.dctabudhabi.ae/diwan/poem/100566","الرجز"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16969","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109225","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109057","الوافر"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201718","الرمل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89232","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85028","الطويل"],[4303,"","https://poetry.dctabudhabi.ae/diwan/poem/110655","البسيط"],[4717,"عمران","https://www.poetsgate.com/ViewPoem.aspx?id=199681",""],[4830,"اِبتداءُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214929",""],[5238,"لقد هاج لي الْبَين حزنا طَويلا","https://www.poetsgate.com/ViewPoem.aspx?id=188702",""],[5324,"كن أبي النفس.","https://www.poetsgate.com/ViewPoem.aspx?id=211647",""],[5736,"هانت دماؤنا","https://www.poetsgate.com/ViewPoem.aspx?id=208210",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[6164,"بطرت .. فزلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66039&r=&rc=49",""]],"verses":[["فَأَذرَيتُ مِن عَينيَّ ما رَويا بِهِ","وَلَم يُروِ مِنّي غُلَّةً وَشَلاهُما",0,"م",2,0],["فَأَذْرَتْ دُموعَاً كَالجُمانِ تُفِيضُها","على خَدِّ مِقْلاقِ الوِشَاحِ رَزانِ",1,"ن",1,0],["فأذْرَيْتُ أسْرابَ الدّموعِ وشفّني","جوىً بينَ أثناءِ الضّلوعِ أليمُ",2,"م",1,0],["فأَذْرَيْتَ دَمْعاً ما يَجِفُّ غُروبُهُ","وقَلَّ غَناءً عَنْكَ وابِلُهُ السَّكْبُ",3,"ب",1,0],["فَاذْرِفي دَمْعَةً عَلَيْهِ تُعِيدِي","وَرَقَ الطِّرْسِ بِالحَيَاةِ نَدِيَّا",4,"ي",2,0],["فَاذْرُفي يا مُقْلَةَ اللَّيلِ","الدَّراري عَبَرَاتْ",5,"ت",1,0],["فَأَذرَت جُماناً مِن دُموعٍ نِظامُها","عَلى الصَدرِ إِلّا أَنَّ صائِغَها الشَفرُ",6,"ر",1,0],["فَأَذرِ دَمعَكَ إِن جُهّالُها اِبتَسَموا","مِن جَهلِهِم وَإِذا خَفَّ الأَنامُ فِقر",7,"ر",1,0],["فإِذْ رأى الكلبُ الذي رآهُ","من عَزْمهِ في قَطْع مُنْتواهُ",8,"ه",1,0],["فاذرف دموعَكَ علَّ نفسَكَ تشتفي","إنّ البكاءَ مبرِّدٌ لجواها",9,"ا",3,0],["فإذ رأيت أموراً كلُّها تلف","فررت لله كيما آمن التلفا",10,"ف",2,0],["فَاْذْرِ الدموعَ عَلَى ما لا يرد وَمَن","ضاقتْ به الحالُ أَجرى دمعه بدم",11,"م",1,0],["فأُذْري لهمْ دُرَّ البكاء مُبَدَّداً","وأُهدي لهمْ دُرَّ الثّناء مُنظَّما",12,"م",2,0],["فإذ رقى المختار فيه منبر الأك","وار يلقي في ذراها الخطبا",13,"ب",2,0],["فَأَذرَيتَ دَمعاً بِالدِماءِ مُصَبَّغاً","كَما يَتَواهى عَقدُ عِقدٍ مُنَسَّقِ",14,"ق",1,1],["فاذرى وما أذوت رياض به ارتوت","فمن روحه اشتقت فانبتت الهدى",15,"د",2,0],["فاذرت فوق خديه دموعاً","كما قطر الندى فوق الزهور",16,"ر",1,0],["فاذرفنَّ الدمع يا جفن على","أمة عضت بنان الندم",17,"م",1,0],["فأذرع يمنى من يحاكيه أصبعٌ","وأصبعُ ما توليه يسراه أذرع",18,"ع",1,0],["فَأَذرَت عَلى الخَدَّينِ دُرَّ مَدامِعٍ","كَساهُ اِحمِراراً تَبِرُّ وَجنَتَها الحَمرا",19,"ر",2,0],["فاذر المدامع واستفرغ حقائبها","لمثل هذا أعد الدمع داخره",20,"ر",2,0],["فاذرفْ دموعَك فوقَ خَدِّك لؤلؤا","إني رأيتُكَ حين تبكِي أضْحكا",21,"ك",2,0],["فأذرِفُ الدمعَ فرْطَ الحَبّ مؤتزراً","جِنْحَ الظلامِ اتقاءً لَمْحةَ الرَصَدِ",22,"د",1,0],["فأذريت دمعي لَعَلَّ الدُّمُوع","تبل غليلاً وتروي عليلا",23,"ل",2,0],["فاذرف الدّمع هياما وخشوعا","فبحبّ اللّه ما أحلى الخشوعْ",24,"ع",1,0],["فاذرُ الترابَ على العيونِ فلم يعدْ","في ارض يعربَ نخوةٌ ومدافعُ",25,"ع",1,0],["فأذرف دمعا يفوق القصيدَ","وألحانَ (باخٍ) يفوقُ المقالا..",26,"ل",2,0],["فاذْرِفيها.. إنَّها قَنْطَرَةٌ","لحياةٍ طَهُرَتْ بعد انحِلالْ!",27,"ل",1,0]]}