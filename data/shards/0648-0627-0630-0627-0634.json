{"poems":[[55,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[65,"وعليلة اللحظات يشكو قرطها","https://www.aldiwan.net/poem46100.html","الكامل"],[73,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[90,"اليوم قري يا مواطن أعينا","https://www.aldiwan.net/poem44458.html","الكامل"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[74,"والذي زاد مقليك اقتدارا","https://www.aldiwan.net/poem18699.html","الخفيف"],[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[53,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[53,"قد كنت أبكي من صريمة خلة","https://www.aldiwan.net/poem65924.html","الكامل"],[53,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[93,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[93,"هجرت القوافي ما بنفسي ملالة","https://www.aldiwan.net/poem9055.html","عموديه"],[87,"لِيعِنا كل معبود معين","https://www.aldiwan.net/poem7767.html","الرمل"],[58,"وغرير يقضي بحكين في الراح","https://www.aldiwan.net/poem58529.html","الخفيف"],[64,"خفق الطبول وزمرة الندمان","https://www.aldiwan.net/poem52250.html","الكامل"],[82,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[54,"حدثونا عن بدعة فأبينا","https://www.aldiwan.net/poem26801.html","الخفيف"],[77,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[77,"قد مررنا على مغانيك تلك","https://www.aldiwan.net/poem69052.html","الطويل"],[77,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[50,"أنت يا ابن الربيع ألزمتني النسك","https://www.aldiwan.net/poem62603.html","الخفيف"],[50,"خلق الشباب وشرتي لم تخلق","https://www.aldiwan.net/poem64445.html","الكامل"],[50,"لا تذهلن عن ابنة الكرم","https://www.aldiwan.net/poem65117.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85532","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[108,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[108,"مشاعر الآباء!","https://www.poetsgate.com/ViewPoem.aspx?id=179320",""],[111,"جرد النفس وانهها عن هواها","https://www.poetsgate.com/ViewPoem.aspx?id=530",""],[92,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[92,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[96,"فلسفة الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=15614",""],[113,"متمرض مرض الزمان لأجله","https://www.aldiwan.net/poem16320.html","الكامل"],[113,"شمس الضحى وأهلة الأعياد","https://www.aldiwan.net/poem16500.html","الكامل"],[113,"وإذا شئت أن تعيش سعيدا","https://www.aldiwan.net/poem16727.html","الخفيف"],[119,"يا غزال الشعب الجفول كفاني","https://www.aldiwan.net/poem41687.html","الخفيف"],[132,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[132,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[136,"لمعان البروق هاج الهموما","https://www.aldiwan.net/poem54745.html","الخفيف"],[146,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[170,"غر الأعادي منه رونق بشره","https://www.aldiwan.net/poem47097.html","الكامل"],[230,"رقية الحب","https://www.aldiwan.net/poem24235.html","عموديه"],[239,"بأبي وجه هلال","https://www.aldiwan.net/poem31976.html","مجزوء الرمل"],[239,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[266,"هاتيك والدتي عجوز همة","https://www.aldiwan.net/poem68226.html","الكامل"],[274,"من كان في تاريخه بحاثا","https://www.aldiwan.net/poem35001.html","الكامل"],[286,"حل أزرار جنة الزبداني","https://www.aldiwan.net/poem32320.html","الخفيف"],[286,"أسلمتني لأذى الصدود ونمت عن","https://www.aldiwan.net/poem32467.html","الكامل"],[309,"لذ بالغرام ولذة الأشواق","https://www.aldiwan.net/poem56443.html","الكامل"],[324,"دع لتيه الدلال واسمح برشفه","https://www.aldiwan.net/poem61700.html","البسيط"],[324,"أي شكر به يقوم لساني","https://www.aldiwan.net/poem67146.html","الخفيف"],[332,"أطرقي أطرقي فقد ضمك","https://www.aldiwan.net/poem54948.html","الخفيف"],[332,"أخت أحلامي الذواهب مرحى","https://www.aldiwan.net/poem54958.html","الخفيف"],[332,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[332,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[346,"يا عروسا في ثياب الرقص","https://www.aldiwan.net/poem55341.html","مجزوء الرمل"],[353,"لم ينل سائق الركائب رشدا","https://www.aldiwan.net/poem15627.html","الخفيف"],[368,"عوجوا عليها أيها الركب","https://www.aldiwan.net/poem60987.html","أحذ الكامل"],[375,"أبقى الرسيم من الركاب رسوما","https://www.aldiwan.net/poem57136.html","الكامل"],[375,"مثل القضيب على اعتدال","https://www.aldiwan.net/poem57222.html","مجزوء الكامل"],[375,"إن جيشا أصبحت تدعى أباه","https://www.aldiwan.net/poem57223.html","الطويل"],[407,"إن الهوى العذري فنى","https://www.aldiwan.net/poem33385.html","مجزوء الكامل"],[407,"كم أقاسي في الهوى من شغل","https://www.aldiwan.net/poem33482.html","الرمل"],[407,"أحلى الهوى ما كان جهرا","https://www.aldiwan.net/poem33914.html","مجزوء الكامل"],[410,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[413,"أصبحت في زمن يشيب لجوره","https://www.aldiwan.net/poem32047.html","الكامل"],[420,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[456,"يا ابن الخصاصة حين تحسب عزة","https://www.aldiwan.net/poem61389.html","الكامل"],[456,"شعراء مصر ولا أقول جميعكم","https://www.aldiwan.net/poem61607.html","الكامل"],[461,"لعدو حسنك ما لسمع العاذل","https://www.aldiwan.net/poem56068.html","الكامل"],[461,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[461,"لمن الحمول بجو ضاحي","https://www.aldiwan.net/poem56255.html","مجزوء الكامل"],[464,"لمن الخيل كأمثال السعالي","https://www.aldiwan.net/poem15101.html","الرمل"],[467,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[471,"لك عندي دستيجة مختومه","https://www.aldiwan.net/poem59675.html","الخفيف"],[473,"أسلام إنك قد ملكت فأسجحي","https://www.aldiwan.net/poem4655.html","الكامل"],[482,"كيف الصنيع وهم نشاوى بالذي","https://www.aldiwan.net/poem36979.html","الكامل"],[503,"أيها المستحلف الليل أفق","https://www.aldiwan.net/poem38032.html","الرمل"],[518,"أيها السيد الذي أنا عبده","https://www.aldiwan.net/poem12085.html","الخفيف"],[532,"أهديل ورقاء الأراك أراكا","https://www.aldiwan.net/poem37282.html","الكامل"],[554,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[554,"هل ليالي بالمنقى رجوع","https://www.aldiwan.net/poem47718.html","الخفيف"],[561,"ليت لو كنت إذا قلت أنا","https://www.aldiwan.net/poem33848.html","الرمل"],[561,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[561,"قلم يجري له النور يد","https://www.aldiwan.net/poem34651.html","الرمل"],[561,"فرحي يا فرحي يا فرحي","https://www.aldiwan.net/poem34662.html","الرمل"],[561,"ليت شعري مذ كررت نظراتي","https://www.aldiwan.net/poem34727.html","الخفيف"],[565,"للشوق عندك مقعد ومقيم","https://www.aldiwan.net/poem52948.html","الكامل"],[578,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[973,"","https://poetry.dctabudhabi.ae/diwan/poem/29530","الكامل"]],"verses":[["وَإِذا شِئتُ زاحَموا","بِالقَنا مِن وَرائِيا",0,"ي",2,0],["وَإِذا شَكَوْتُ نَسَبْتُ في شِعْري بِها","شَكْوى الحَمامِ تَنوحُ في تَغْريدِها",1,"د",3,0],["وَإِذا شَحَّتِ السَحائِبُ سَحَّت","راحَتاهُ فَعَمَّتِ الأَرضَ رِقدا",2,"د",2,0],["وإذا شممت بناشِقَيْك طباعهم","أعطتك طينتهم شميماً مُنتِنا",3,"ن",2,0],["وَإِذا شَتَوا عادَت عَلى جِيرانِهِم","رُجُحٌ تُوَفّيها مَرابِعُ كومُ",4,"م",1,0],["وإذا شبتِ الوغى فكأنَّ الس","يف من بأسه استعارَ استعارا",5,"ر",2,0],["وإذا شتاءٌ أخلفتْ","أنواؤه خَلفوا سَحابهْ",6,"ب",2,0],["وإذا شكوت إليه طول عذابه","فأقلُّ قاسٍ رحمةً لمُقاسي",7,"س",2,0],["وإذا شبابُك بتَّ منك حِبالَهُ","بتَّت له منك النساء حبالَها",8,"ل",3,0],["وإذا شكرنا البدءَ منك فعائدٌ","ومتى شكونا جفوةً فرحيمُ",9,"م",1,0],["وَإِذا شَيخٌ في صَحراءِ","كَالزَورَقِ في عَرضِ البَحرِ",10,"ر",1,0],["وَإِذا شَبَحٌ يَستَعجِلُ الخَطوَ نَحَُهُ","وَصَوتٌ لَطيفٌ في الظَلامِ يَقولُ",11,"ل",1,0],["وإذا شئتم رَدَى أهل الشرور","أتقنوا الحرب علوما وفنون",12,"ن",1,0],["وإذا شِئْتَ أَنْ تَرى الموتَ في صُو","رَةِ لَيْثٍ في لِبْدَتَيْ رِئْبالِ",13,"ل",1,0],["وإِذا شِرِبْتُ من المعتَّقِ أربعاً","أعرضت عن ذِكْرِ النجيعِ القاني",14,"ن",2,0],["وإذا شدا في الهام خلتَ صليلَهُ","عمَلاً وَهَزّ غِرارِهِ استِهلالا",15,"ل",2,0],["وَإِذا شَوكَةٍ تَقَصَّفُ يُبساً","فَوقَها رَأسُ فارَةٍ مَحلوقُ",16,"ق",1,0],["وإذا شَكَا ظَمَأ إليكَ سَقَيْتَهُ","كأساً يُقَشَّبُ سَمُّها ويُثَمَّل",17,"ل",1,0],["وإذا شاءَ قَلّدَتْهُ جُذامٌ","شَرَفَ البيتِ من أواخٍ وسَمْك",18,"ك",1,0],["وإذا شاءَ زمانٌ رابَنَا","برقيبٍ أو حَسودٍ أو مُعاد",19,"د",1,0],["وَإِذا شِئتَ أَن تَرى طُرفَةً تَع","جَبُ مِنها مَليحَةً مُستَفادَه",20,"د",2,0],["وَإِذا شَهِدتَ بِهِ الوَقيعَةَ أَقلَعَت","عَنهُ الغَيابَةُ وَهوَ حُرُّ المِصدَقِ",21,"ق",1,0],["وَإِذا شَهِدتَ عَدُوَّها في مَحفَلٍ","فَاِقصِد إِلَيهِ بِأَقبَحِ الذَمِّ",22,"م",1,0],["وَإِذا شَرِبتَ فَكُن لَها مُتَمَطِّقاً","حَتّى تَبَيَّنَ طَيِّبَ الطَعمِ",22,"م",1,0],["وإذا شرعت بنظمه","للذهن فيه أحصر",23,"ر",1,0],["وإذا شئت فاسقِني","هِ على نغْمَةِ المطَرْ",24,"ر",1,0],["وَإذَا شِيمَ مُوقَداً","فَهْوَ كَالنَّجْمِ ذِي الذَّنَبْ",25,"ب",1,0],["وَإِذا شَيَّدَ بَيت مَجدٍ أَثيل","فَعِمادٌ عَبدُ الغنيّ وَسمكُ",26,"ك",1,0],["وَإِذَا شَدَا الْكَوْنُ الْمَفَا","خِرَ كُنْتِ عُنْوَانَ النَشِيدِ",27,"د",1,0],["وإذا شاد يُغنِّي مَرِحٌ","لُؤلؤيُّ الصوتِ حُلْوُ المذهب",28,"ب",1,0],["وإذا شاب، لم يزل عودُه كالنَّ","بْع فيهِ بقيَّةٌ من صَلابة",29,"ب",2,0],["وإذا شَحَّ الزادُ، والماءُ يومًا","فلهمْ مِنْ هَوَايَ: زادٌ، وماءُ",30,"ا",2,0],["واذا شقت المسالك طالت","قصر الشوق للحبيب مداها",31,"ا",3,0],["وإذا شَدَوا فكما تغنَّى طائرٌ","أثرُ النعيمِ يَبينُ في تهليله",32,"ل",2,0],["وإذا شِئتُم صَبغْناها دماً","صبغةً تُؤْذِنُ بالحال \" انتقالا \"",33,"ل",2,0],["وإذا شكا العافي فسوطك واسمعي","نغم الألوهة زفرة وعويلا",34,"ل",2,0],["وَإِذا شَكى أَلم السقام تَود لَو","وَضَعتُهُ عَين الغيد في الأَجفان",35,"ن",1,0],["وَإِذا شَدا بِكَ مُطرب في مَجلس","رَقَصت لَكَ الأَرواح في الأَجساد",36,"د",1,0],["وَإِذا شئت أَن تَعيش سَعيداً","زُر مَكان الكِبار تَرقى مَكانا",37,"ن",2,1],["وإذا شفها الهوى وتدلت","في خدودي خذهما عقود جمان",38,"ن",1,0],["وإذا شئتَ شِرَاءَ أشياءَ من","سرقِ أهل العدل عنها لا تَسَلْ",39,"ل",1,0],["وإذا شئتَ أو بدَا لك أمرٌ","فعلينا القضاءُ بالتيسيرِ",40,"ر",1,0],["وِإذَا شِئتُ أن أُهَوِّمَ في الدَّو","وِ أبَى لِى إدِّكَارُها التَّهوِيمَا",41,"م",2,0],["وإذَا شِئتُ أن أُزَفِّفَ شِعراً","لِلزَّنَيمِ الذي تَقفي الزَّنِيمَا",41,"م",2,0],["وإذَا شَواةُ الرأس صوَّحَ نبتُها","فعلى قضاءِ مآربٍ من شانِ",42,"ن",1,0],["وإذا شياطينُ الضّلال تَمرَّدوا","خَلاّهُمُ قُرَناءَ في الأصفاد",43,"د",1,0],["وإذا شئت فعوّذ","نيَ من فرط هيامي",44,"م",2,0],["وَإِذا شَبَّ ضِرامُ ال","جَدبِ وَاِشتَدَّ اِستِعارُه",45,"ر",2,0],["وَإِذا شَكَت قَصراً مُتونُ سُيوفِهِ","كَفِلَت بِأَن سَتُطيلُها خَطَواتُهُ",46,"ت",2,0],["وإذا شَبِيهٌ بالأفَاعي رُقِّشَت","يُوعِدنَني بِتَلَمُّظٍ وَتَثَوُّبِ",47,"ب",1,0],["وإذا شَكونا قيلَ تلكَ جنايةٌ","هل نُحرم الشَّكوى أو الإبثاثا",48,"ث",2,0],["وَإِذا شِئتَ أَن تَرى البَحرَ وَالسا","حِلَ فَاِصعَد يَفاعَ مَريونانِ",49,"ن",1,0],["وَإِذا شَدا الشادي فَأَطرَبَ شَدوُهُ","عِندي فَوَجدي مُقعِدي وَمُقيمي",50,"م",2,0],["وَإِذا شربتَ الصرفَ مِن خمرِ الهوى","إِيّاكَ تغفَل عَن جمالِ الساقي",51,"ق",2,0],["وَإِذا شِئتَ فَالرِياضُ كَثيرٌ","كَم بِها مِن خَمائِلٍ مُلتَفَّه",52,"ف",2,0],["وَإِذا شِئتَ وَصفَ تِلكَ السَجايا","أَيُّ شَيءٍ يُحيطُهُ تِبياني",53,"ن",2,0],["وإذا شئت أن تعيشي على الوه","م فغنّى قبل انطفاء الشموع",54,"ع",1,0],["وإذا شئت أن نكون حبيبي","ن فلا تجعلي شبابك ربّا",55,"ب",2,0],["وإذا شئت أن تكوني ابنة الطي","ن فلا تطفىء سراج وجودي",55,"ي",1,0],["وإذا شئت أن ت