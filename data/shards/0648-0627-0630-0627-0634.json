oem.aspx?id=181062",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5756,"صح النوم","https://www.poetsgate.com/ViewPoem.aspx?id=5437",""],[5835,"صار العتاب يزيدني بعدا","https://www.poetsgate.com/ViewPoem.aspx?id=90748",""],[5948,"عَجَباً لأحمدَ والعجائبُ جمَّةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=100609",""],[6018,"أشبه البدر في السنا والسناء","https://www.poetsgate.com/ViewPoem.aspx?id=181191",""],[5309,"يحسب المرء في ربيع شبابه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573878",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[6339,"مناجاة قلب..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87891&r=&rc=3",""]],"verses":[["وَإِذا شِئتُ زاحَموا","بِالقَنا مِن وَرائِيا",0,"ي",2,0],["وَإِذا شَكَوْتُ نَسَبْتُ في شِعْري بِها","شَكْوى الحَمامِ تَنوحُ في تَغْريدِها",1,"د",3,0],["وَإِذا شَحَّتِ السَحائِبُ سَحَّت","راحَتاهُ فَعَمَّتِ الأَرضَ رِقدا",2,"د",2,0],["وإذا شممت بناشِقَيْك طباعهم","أعطتك طينتهم شميماً مُنتِنا",3,"ن",2,0],["وَإِذا شَتَوا عادَت عَلى جِيرانِهِم","رُجُحٌ تُوَفّيها مَرابِعُ كومُ",4,"م",1,0],["وإذا شبتِ الوغى فكأنَّ الس","يف من بأسه استعارَ استعارا",5,"ر",2,0],["وإذا شتاءٌ أخلفتْ","أنواؤه خَلفوا سَحابهْ",6,"ب",2,0],["وإذا شكوت إليه طول عذابه","فأقلُّ قاسٍ رحمةً لمُقاسي",7,"س",2,0],["وإذا شبابُك بتَّ منك حِبالَهُ","بتَّت له منك النساء حبالَها",8,"ل",3,0],["وإذا شكرنا البدءَ منك فعائدٌ","ومتى شكونا جفوةً فرحيمُ",9,"م",1,0],["وَإِذا شَيخٌ في صَحراءِ","كَالزَورَقِ في عَرضِ البَحرِ",10,"ر",1,0],["وَإِذا شَبَحٌ يَستَعجِلُ الخَطوَ نَحَُهُ","وَصَوتٌ لَطيفٌ في الظَلامِ يَقولُ",11,"ل",1,0],["وإذا شئتم رَدَى أهل الشرور","أتقنوا الحرب علوما وفنون",12,"ن",1,0],["وإذا شِئْتَ أَنْ تَرى الموتَ في صُو","رَةِ لَيْثٍ في لِبْدَتَيْ رِئْبالِ",13,"ل",1,0],["وإِذا شِرِبْتُ من المعتَّقِ أربعاً","أعرضت عن ذِكْرِ النجيعِ القاني",14,"ن",2,0],["وإذا شدا في الهام خلتَ صليلَهُ","عمَلاً وَهَزّ غِرارِهِ استِهلالا",15,"ل",2,0],["وَإِذا شَوكَةٍ تَقَصَّفُ يُبساً","فَوقَها رَأسُ فارَةٍ مَحلوقُ",16,"ق",1,0],["وإذا شَكَا ظَمَأ إليكَ سَقَيْتَهُ","كأساً يُقَشَّبُ سَمُّها ويُثَمَّل",17,"ل",1,0],["وإذا شاءَ قَلّدَتْهُ جُذامٌ","شَرَفَ البيتِ من أواخٍ وسَمْك",18,"ك",1,0],["وإذا شاءَ زمانٌ رابَنَا","برقيبٍ أو حَسودٍ أو مُعاد",19,"د",1,0],["وَإِذا شِئتَ أَن تَرى طُرفَةً تَع","جَبُ مِنها مَليحَةً مُستَفادَه",20,"د",2,0],["وَإِذا شَهِدتَ بِهِ الوَقيعَةَ أَقلَعَت","عَنهُ الغَيابَةُ وَهوَ حُرُّ المِصدَقِ",21,"ق",1,0],["وَإِذا شَهِدتَ عَدُوَّها في مَحفَلٍ","فَاِقصِد إِلَيهِ بِأَقبَحِ الذَمِّ",22,"م",1,0],["وَإِذا شَرِبتَ فَكُن لَها مُتَمَطِّقاً","حَتّى تَبَيَّنَ طَيِّبَ الطَعمِ",22,"م",1,0],["وإذا شرعت بنظمه","للذهن فيه أحصر",23,"ر",1,0],["وإذا شئت فاسقِني","هِ على نغْمَةِ المطَرْ",24,"ر",1,0],["وَإذَا شِيمَ مُوقَداً","فَهْوَ كَالنَّجْمِ ذِي الذَّنَبْ",25,"ب",1,0],["وَإِذا شَيَّدَ بَيت مَجدٍ أَثيل","فَعِمادٌ عَبدُ الغنيّ وَسمكُ",26,"ك",1,0],["وَإِذَا شَدَا الْكَوْنُ الْمَفَا","خِرَ كُنْتِ عُنْوَانَ النَشِيدِ",27,"د",1,0],["وإذا شاد يُغنِّي مَرِحٌ","لُؤلؤيُّ الصوتِ حُلْوُ المذهب",28,"ب",1,0],["وإذا شاب، لم يزل عودُه كالنَّ","بْع فيهِ بقيَّةٌ من صَلابة",29,"ب",2,0],["وإذا شَحَّ الزادُ، والماءُ يومًا","فلهمْ مِنْ هَوَايَ: زادٌ، وماءُ",30,"ا",2,0],["واذا شقت المسالك طالت","قصر الشوق للحبيب مداها",31,"ا",3,0],["وإذا شَدَوا فكما تغنَّى طائرٌ","أثرُ النعيمِ يَبينُ في تهليله",32,"ل",2,0],["وإذا شِئتُم صَبغْناها دماً","صبغةً تُؤْذِنُ بالحال \" انتقالا \"",33,"ل",2,0],["وإذا شكا العافي فسوطك واسمعي","نغم الألوهة زفرة وعويلا",34,"ل",2,0],["وَإِذا شَكى أَلم السقام تَود لَو","وَضَعتُهُ عَين الغيد في الأَجفان",35,"ن",1,0],["وَإِذا شَدا بِكَ مُطرب في مَجلس","رَقَصت لَكَ الأَرواح في الأَجساد",36,"د",1,0],["وَإِذا شئت أَن تَعيش سَعيداً","زُر مَكان الكِبار تَرقى مَكانا",37,"ن",2,1],["وإذا شفها الهوى وتدلت","في خدودي خذهما عقود جمان",38,"ن",1,0],["وإذا شئتَ شِرَاءَ أشياءَ من","سرقِ أهل العدل عنها لا تَسَلْ",39,"ل",1,0],["وإذا شئتَ أو بدَا لك أمرٌ","فعلينا القضاءُ بالتيسيرِ",40,"ر",1,0],["وِإذَا شِئتُ أن أُهَوِّمَ في الدَّو","وِ أبَى لِى إدِّكَارُها التَّهوِيمَا",41,"م",2,0],["وإذَا شِئتُ أن أُزَفِّفَ شِعراً","لِلزَّنَيمِ الذي تَقفي الزَّنِيمَا",41,"م",2,0],["وإذَا شَواةُ الرأس صوَّحَ نبتُها","فعلى قضاءِ مآربٍ من شانِ",42,"ن",1,0],["وإذا شياطينُ الضّلال تَمرَّدوا","خَلاّهُمُ قُرَناءَ في الأصفاد",43,"د",1,0],["وإذا شئت فعوّذ","نيَ من فرط هيامي",44,"م",2,0],["وَإِذا شَبَّ ضِرامُ ال","جَدبِ وَاِشتَدَّ اِستِعارُه",45,"ر",2,0],["وَإِذا شَكَت قَصراً مُتونُ سُيوفِهِ","كَفِلَت بِأَن سَتُطيلُها خَطَواتُهُ",46,"ت",2,0],["وإذا شَبِيهٌ بالأفَاعي رُقِّشَت","يُوعِدنَني بِتَلَمُّظٍ وَتَثَوُّبِ",47,"ب",1,0],["وإذا شَكونا قيلَ تلكَ جنايةٌ","هل نُحرم الشَّكوى أو الإبثاثا",48,"ث",2,0],["وَإِذا شِئتَ أَن تَرى البَحرَ وَالسا","حِلَ فَاِصعَد يَفاعَ مَريونانِ",49,"ن",1,0],["وَإِذا شَدا الشادي فَأَطرَبَ شَدوُهُ","عِندي فَوَجدي مُقعِدي وَمُقيمي",50,"م",2,0],["وَإِذا شربتَ الصرفَ مِن خمرِ الهوى","إِيّاكَ تغفَل عَن جمالِ الساقي",51,"ق",2,0],["وَإِذا شِئتَ فَالرِياضُ كَثيرٌ","كَم بِها مِن خَمائِلٍ مُلتَفَّه",52,"ف",2,0],["وَإِذا شِئتَ وَصفَ تِلكَ السَجايا","أَيُّ شَيءٍ يُحيطُهُ تِبياني",53,"ن",2,0],["وإذا شئت أن تعيشي على الوه","م فغنّى قبل انطفاء الشموع",54,"ع",1,0],["وإذا شئت أن نكون حبيبي","ن فلا تجعلي شبابك ربّا",55,"ب",2,0],["وإذا شئت أن تكوني ابنة الطي","ن فلا تطفىء سراج وجودي",55,"ي",1,0],["وإذا شئت أن تكوني كما أه","وى فغنّى معى نشيد الخلود",55,"د",1,0],["وإذا شئت أن نعيش سعيدي","ن فلا تجعلى شبابك ربّا",55,"ب",2,0],["وإذا شئت أن تعيش سعيدا","فاصحب الدهر جاهلا غفلانا",56,"ن",2,0],["وإذا شاقها المنام دهاها","من وراء الحجاب صوتٌ غضوب",57,"ب",1,0],["واذا شئت فزرق","واذا شئت فجونِ",58,"ن",1,0],["وَإِذا شارَلَت شَرافَ المُصَلّى","فَأَقِمها هَدياً لَعَلوَةَ تُهدى",59,"د",2,0],["وإذا شَحذْتَ العزْمَ مُؤتنِفاً","نَصْري فحِزْبُ اللهِ لي حِزب",60,"ب",1,0],["وإِذا شَكوتُ إلى امرِىءٍ ما حَلَّ بي","وأَقولُ يغضَبُ أن أراهُ حَلِيما",61,"م",2,0],["وَإِذا شَكَوتُ فَما أَوَد","دُ معَ الشَّكيَّة لو رَثى لي",62,"ل",2,0],["وَإِذا شارَكوكَ فيها بِطَعنٍ","أَو بِضَربٍ نَفَلتَهم بِالمالِ",63,"ل",1,0],["وإذا شربت من الهوى","خمراً فخذ من خمردَنِّي",64,"ن",2,0],["وإذا شاهدته 