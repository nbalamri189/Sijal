{"poems":[[53,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[63,"وعليلة اللحظات يشكو قرطها","https://www.aldiwan.net/poem46100.html","الكامل"],[71,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[88,"اليوم قري يا مواطن أعينا","https://www.aldiwan.net/poem44458.html","الكامل"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[72,"والذي زاد مقليك اقتدارا","https://www.aldiwan.net/poem18699.html","الخفيف"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"قد كنت أبكي من صريمة خلة","https://www.aldiwan.net/poem65924.html","الكامل"],[51,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[91,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[91,"هجرت القوافي ما بنفسي ملالة","https://www.aldiwan.net/poem9055.html","عموديه"],[85,"لِيعِنا كل معبود معين","https://www.aldiwan.net/poem7767.html","الرمل"],[56,"وغرير يقضي بحكين في الراح","https://www.aldiwan.net/poem58529.html","الخفيف"],[62,"خفق الطبول وزمرة الندمان","https://www.aldiwan.net/poem52250.html","الكامل"],[80,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[52,"حدثونا عن بدعة فأبينا","https://www.aldiwan.net/poem26801.html","الخفيف"],[75,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[75,"قد مررنا على مغانيك تلك","https://www.aldiwan.net/poem69052.html","الطويل"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[48,"أنت يا ابن الربيع ألزمتني النسك","https://www.aldiwan.net/poem62603.html","الخفيف"],[48,"خلق الشباب وشرتي لم تخلق","https://www.aldiwan.net/poem64445.html","الكامل"],[48,"لا تذهلن عن ابنة الكرم","https://www.aldiwan.net/poem65117.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85532","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[106,"مشاعر الآباء!","https://www.poetsgate.com/ViewPoem.aspx?id=179320",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[94,"فلسفة الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=15614",""],[109,"متمرض مرض الزمان لأجله","https://www.aldiwan.net/poem16320.html","الكامل"],[109,"شمس الضحى وأهلة الأعياد","https://www.aldiwan.net/poem16500.html","الكامل"],[109,"وإذا شئت أن تعيش سعيدا","https://www.aldiwan.net/poem16727.html","الخفيف"],[115,"يا غزال الشعب الجفول كفاني","https://www.aldiwan.net/poem41687.html","الخفيف"],[128,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[128,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[132,"لمعان البروق هاج الهموما","https://www.aldiwan.net/poem54745.html","الخفيف"],[142,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[166,"غر الأعادي منه رونق بشره","https://www.aldiwan.net/poem47097.html","الكامل"],[226,"رقية الحب","https://www.aldiwan.net/poem24235.html","عموديه"],[235,"بأبي وجه هلال","https://www.aldiwan.net/poem31976.html","مجزوء الرمل"],[235,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[262,"هاتيك والدتي عجوز همة","https://www.aldiwan.net/poem68226.html","الكامل"],[270,"من كان في تاريخه بحاثا","https://www.aldiwan.net/poem35001.html","الكامل"],[282,"حل أزرار جنة الزبداني","https://www.aldiwan.net/poem32320.html","الخفيف"],[282,"أسلمتني لأذى الصدود ونمت عن","https://www.aldiwan.net/poem32467.html","الكامل"],[305,"لذ بالغرام ولذة الأشواق","https://www.aldiwan.net/poem56443.html","الكامل"],[320,"دع لتيه الدلال واسمح برشفه","https://www.aldiwan.net/poem61700.html","البسيط"],[320,"أي شكر به يقوم لساني","https://www.aldiwan.net/poem67146.html","الخفيف"],[328,"أطرقي أطرقي فقد ضمك","https://www.aldiwan.net/poem54948.html","الخفيف"],[328,"أخت أحلامي الذواهب مرحى","https://www.aldiwan.net/poem54958.html","الخفيف"],[328,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[328,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[342,"يا عروسا في ثياب الرقص","https://www.aldiwan.net/poem55341.html","مجزوء الرمل"],[349,"لم ينل سائق الركائب رشدا","https://www.aldiwan.net/poem15627.html","الخفيف"],[364,"عوجوا عليها أيها الركب","https://www.aldiwan.net/poem60987.html","أحذ الكامل"],[371,"أبقى الرسيم من الركاب رسوما","https://www.aldiwan.net/poem57136.html","الكامل"],[371,"مثل القضيب على اعتدال","https://www.aldiwan.net/poem57222.html","مجزوء الكامل"],[371,"إن جيشا أصبحت تدعى أباه","https://www.aldiwan.net/poem57223.html","الطويل"],[403,"إن الهوى العذري فنى","https://www.aldiwan.net/poem33385.html","مجزوء الكامل"],[403,"كم أقاسي في الهوى من شغل","https://www.aldiwan.net/poem33482.html","الرمل"],[403,"أحلى الهوى ما كان جهرا","https://www.aldiwan.net/poem33914.html","مجزوء الكامل"],[406,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[409,"أصبحت في زمن يشيب لجوره","https://www.aldiwan.net/poem32047.html","الكامل"],[416,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[453,"يا ابن الخصاصة حين تحسب عزة","https://www.aldiwan.net/poem61389.html","الكامل"],[453,"شعراء مصر ولا أقول جميعكم","https://www.aldiwan.net/poem61607.html","الكامل"],[458,"لعدو حسنك ما لسمع العاذل","https://www.aldiwan.net/poem56068.html","الكامل"],[458,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[458,"لمن الحمول بجو ضاحي","https://www.aldiwan.net/poem56255.html","مجزوء الكامل"],[461,"لمن الخيل كأمثال السعالي","https://www.aldiwan.net/poem15101.html","الرمل"],[464,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[468,"لك عندي دستيجة مختومه","https://www.aldiwan.net/poem59675.html","الخفيف"],[470,"أسلام إنك قد ملكت فأسجحي","https://www.aldiwan.net/poem4655.html","الكامل"],[479,"كيف الصنيع وهم نشاوى بالذي","https://www.aldiwan.net/poem36979.html","الكامل"],[500,"أيها المستحلف الليل أفق","https://www.aldiwan.net/poem38032.html","الرمل"],[515,"أيها السيد الذي أنا عبده","https://www.aldiwan.net/poem12085.html","الخفيف"],[529,"أهديل ورقاء الأراك أراكا","https://www.aldiwan.net/poem37282.html","الكامل"],[551,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[551,"هل ليالي بالمنقى رجوع","https://www.aldiwan.net/poem47718.html","الخفيف"],[558,"ليت لو كنت إذا قلت أنا","https://www.aldiwan.net/poem33848.html","الرمل"],[558,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[558,"قلم يجري له النور يد","https://www.aldiwan.net/poem34651.html","الرمل"],[558,"فرحي يا فرحي يا فرحي","https://www.aldiwan.net/poem34662.html","الرمل"],[558,"ليت شعري مذ كررت نظراتي","https://www.aldiwan.net/poem34727.html","الخفيف"],[562,"للشوق عندك مقعد ومقيم","https://www.aldiwan.net/poem52948.html","الكامل"],[575,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"]],"verses":[["وَإِذا شِئتُ زاحَموا","بِالقَنا مِن وَرائِيا",0,"ي",2,0],["وَإِذا شَكَوْتُ نَسَبْتُ في شِعْري بِها","شَكْوى الحَمامِ تَنوحُ في تَغْريدِها",1,"د",3,0],["وَإِذا شَحَّتِ السَحائِبُ سَحَّت","راحَتاهُ فَعَمَّتِ الأَرضَ رِقدا",2,"د",2,0],["وإذا شممت بناشِقَيْك طباعهم","أعطتك طينتهم شميماً مُنتِنا",3,"ن",2,0],["وَإِذا شَتَوا عادَت عَلى جِيرانِهِم","رُجُحٌ تُوَفّيها مَرابِعُ كومُ",4,"م",1,0],["وإذا شبتِ الوغى فكأنَّ الس","يف من بأسه استعارَ استعارا",5,"ر",2,0],["وإذا شتاءٌ أخلفتْ","أنواؤه خَلفوا سَحابهْ",6,"ب",2,0],["وإذا شكوت إليه طول عذابه","فأقلُّ قاسٍ رحمةً لمُقاسي",7,"س",2,0],["وإذا شبابُك بتَّ منك حِبالَهُ","بتَّت له منك النساء حبالَها",8,"ل",3,0],["وإذا شكرنا البدءَ منك فعائدٌ","ومتى شكونا جفوةً فرحيمُ",9,"م",1,0],["وَإِذا شَيخٌ في صَحراءِ","كَالزَورَقِ في عَرضِ البَحرِ",10,"ر",1,0],["وَإِذا شَبَحٌ يَستَعجِلُ الخَطوَ نَحَُهُ","وَصَوتٌ لَطيفٌ في الظَلامِ يَقولُ",11,"ل",1,0],["وإذا شئتم رَدَى أهل الشرور","أتقنوا الحرب علوما وفنون",12,"ن",1,0],["وإذا شِئْتَ أَنْ تَرى الموتَ في صُو","رَةِ لَيْثٍ في لِبْدَتَيْ رِئْبالِ",13,"ل",1,0],["وإِذا شِرِبْتُ من المعتَّقِ أربعاً","أعرضت عن ذِكْرِ النجيعِ القاني",14,"ن",2,0],["وإذا شدا في الهام خلتَ صليلَهُ","عمَلاً وَهَزّ غِرارِهِ استِهلالا",15,"ل",2,0],["وَإِذا شَوكَةٍ تَقَصَّفُ يُبساً","فَوقَها رَأسُ فارَةٍ مَحلوقُ",16,"ق",1,0],["وإذا شَكَا ظَمَأ إليكَ سَقَيْتَهُ","كأساً يُقَشَّبُ سَمُّها ويُثَمَّل",17,"ل",1,0],["وإذا شاءَ قَلّدَتْهُ جُذامٌ","شَرَفَ البيتِ من أواخٍ وسَمْك",18,"ك",1,0],["وإذا شاءَ زمانٌ رابَنَا","برقيبٍ أو حَسودٍ أو مُعاد",19,"د",1,0],["وَإِذا شِئتَ أَن تَرى طُرفَةً تَع","جَبُ مِنها مَليحَةً مُستَفادَه",20,"د",2,0],["وَإِذا شَهِدتَ بِهِ الوَقيعَةَ أَقلَعَت","عَنهُ الغَيابَةُ وَهوَ حُرُّ المِصدَقِ",21,"ق",1,0],["وَإِذا شَهِدتَ عَدُوَّها في مَحفَلٍ","فَاِقصِد إِلَيهِ بِأَقبَحِ الذَمِّ",22,"م",1,0],["وَإِذا شَرِبتَ فَكُن لَها مُتَمَطِّقاً","حَتّى تَبَيَّنَ طَيِّبَ الطَعمِ",22,"م",1,0],["وإذا شرعت بنظمه","للذهن فيه أحصر",23,"ر",1,0],["وإذا شئت فاسقِني","هِ على نغْمَةِ المطَرْ",24,"ر",1,0],["وَإذَا شِيمَ مُوقَداً","فَهْوَ كَالنَّجْمِ ذِي الذَّنَبْ",25,"ب",1,0],["وَإِذا شَيَّدَ بَيت مَجدٍ أَثيل","فَعِمادٌ عَبدُ الغنيّ وَسمكُ",26,"ك",1,0],["وَإِذَا شَدَا الْكَوْنُ الْمَفَا","خِرَ كُنْتِ عُنْوَانَ النَشِيدِ",27,"د",1,0],["وإذا شاد يُغنِّي مَرِحٌ","لُؤلؤيُّ الصوتِ حُلْوُ المذهب",28,"ب",1,0],["وإذا شاب، لم يزل عودُه كالنَّ","بْع فيهِ بقيَّةٌ من صَلابة",29,"ب",2,0],["وإذا شَحَّ الزادُ، والماءُ يومًا","فلهمْ مِنْ هَوَايَ: زادٌ، وماءُ",30,"ا",2,0],["وإذا شَدَوا فكما تغنَّى طائرٌ","أثرُ النعيمِ يَبينُ في تهليله",31,"ل",2,0],["وإذا شِئتُم صَبغْناها دماً","صبغةً تُؤْذِنُ بالحال \" انتقالا \"",32,"ل",2,0],["وإذا شكا العافي فسوطك واسمعي","نغم الألوهة زفرة وعويلا",33,"ل",2,0],["وَإِذا شَكى أَلم السقام تَود لَو","وَضَعتُهُ عَين الغيد في الأَجفان",34,"ن",1,0],["وَإِذا شَدا بِكَ مُطرب في مَجلس","رَقَصت لَكَ الأَرواح في الأَجساد",35,"د",1,0],["وَإِذا شئت أَن تَعيش سَعيداً","زُر مَكان الكِبار تَرقى مَكانا",36,"ن",2,1],["وإذا شفها الهوى وتدلت","في خدودي خذهما عقود جمان",37,"ن",1,0],["وإذا شئتَ شِرَاءَ أشياءَ من","سرقِ أهل العدل عنها لا تَسَلْ",38,"ل",1,0],["وإذا شئتَ أو بدَا لك أمرٌ","فعلينا القضاءُ بالتيسيرِ",39,"ر",1,0],["وِإذَا شِئتُ أن أُهَوِّمَ في الدَّو","وِ أبَى لِى إدِّكَارُها التَّهوِيمَا",40,"م",2,0],["وإذَا شِئتُ أن أُزَفِّفَ شِعراً","لِلزَّنَيمِ الذي تَقفي الزَّنِيمَا",40,"م",2,0],["وإذَا شَواةُ الرأس صوَّحَ نبتُها","فعلى قضاءِ مآربٍ من شانِ",41,"ن",1,0],["وإذا شياطينُ الضّلال تَمرَّدوا","خَلاّهُمُ قُرَناءَ في الأصفاد",42,"د",1,0],["وإذا شئت فعوّذ","نيَ من فرط هيامي",43,"ي",1,0],["وَإِذا شَبَّ ضِرامُ ال","جَدبِ وَاِشتَدَّ اِستِعارُه",44,"ر",2,0],["وَإِذا شَكَت قَصراً مُتونُ سُيوفِهِ","كَفِلَت بِأَن سَتُطيلُها خَطَواتُهُ",45,"ت",2,0],["وإذا شَبِيهٌ بالأفَاعي رُقِّشَت","يُوعِدنَني بِتَلَمُّظٍ وَتَثَوُّبِ",46,"ب",1,0],["وإذا شَكونا قيلَ تلكَ جنايةٌ","هل نُحرم الشَّكوى أو الإبثاثا",47,"ث",2,0],["وَإِذا شِئتَ أَن تَرى البَحرَ وَالسا","حِلَ فَاِصعَد يَفاعَ مَريونانِ",48,"ن",1,0],["وَإِذا شَدا الشادي فَأَطرَبَ شَدوُهُ","عِندي فَوَجدي مُقعِدي وَمُقيمي",49,"ي",1,0],["وَإِذا شربتَ الصرفَ مِن خمرِ الهوى","إِيّاكَ تغفَل عَن جمالِ الساقي",50,"ي",1,0],["وَإِذا شِئتَ فَالرِياضُ كَثيرٌ","كَم بِها مِن خَمائِلٍ مُلتَفَّه",51,"ف",2,0],["وَإِذا شِئتَ وَصفَ تِلكَ السَجايا","أَيُّ شَيءٍ يُحيطُهُ تِبياني",52,"ي",1,0],["وإذا شئت أن تعيشي على الوه","م فغنّى قبل انطفاء الشموع",53,"ع",1,0],["وإذا شئت أن نكون حبيبي","ن فلا تجعلي شبابك ربّا",54,"ب",2,0],["وإذا شئت أن تكوني ابنة الطي","ن فلا تطفىء سراج وجودي",54,"ي",1,0],["وإذا شئت أن تكوني كما أه","وى فغنّى معى نشيد الخلود",54,"د",1,0],["وإذا شئت أن نعيش سعيدي","ن فلا تجعلى شبابك ربّا",54,"ب",2,0],["وإذا شئت أن تعيش سعيدا","فاصحب الدهر جاهلا غفلانا",55,"ن",2,0],["وإذا شاقها المنام دهاها","من وراء