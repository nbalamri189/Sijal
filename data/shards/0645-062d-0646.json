{"poems":[[59,"محن الزمان كثيرة لا تنقضي","https://www.aldiwan.net/poem24710.html","الكامل"],[95,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[56,"إذا رأيت بني وهب بمنزلة","https://www.aldiwan.net/poem29359.html","البسيط"],[74,"رب راح بت أشربها","https://www.aldiwan.net/poem18445.html","المديد"],[53,"شهر نسك قرينه يوم لهو","https://www.aldiwan.net/poem66715.html","الخفيف"],[93,"والسنا حولي وروحي في ضباب","https://www.aldiwan.net/poem8749.html","عموديه"],[51,"خير الرجال رفيقها","https://www.aldiwan.net/poem62197.html","مجزوء الكامل"],[46,"أنت في حل فزدني سقما","https://www.aldiwan.net/poem30101.html","الرمل"],[107,"أقبل عليك من الشعوب سلام","https://www.aldiwan.net/poem42067.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54770","الرجز"],[102,"محنة الفن","https://www.poetsgate.com/ViewPoem.aspx?id=50162",""],[102,"مأساة حارس الملك","https://www.poetsgate.com/ViewPoem.aspx?id=50435",""],[186,"أمنازل الأحباب ما فعل الألى","https://www.aldiwan.net/poem67039.html","الكامل"],[190,"دمع تحدر في انسيابه","https://www.aldiwan.net/poem44153.html","مجزوء الكامل"],[215,"أين قلبي وأين آثار قلبي","https://www.aldiwan.net/poem46575.html","الخفيف"],[215,"أقريب أنت مني أم بعيد","https://www.aldiwan.net/poem46631.html","الرمل"],[215,"ما على الغادرين نسكب دمعا إن","https://www.aldiwan.net/poem46763.html","الخفيف"],[240,"يا جلال الدين يا ملكا","https://www.aldiwan.net/poem31800.html","المديد"],[310,"يهنأ بمولد طه خاتم الرسل","https://www.aldiwan.net/poem56438.html","البسيط"],[382,"قالت إليك فقلت طرفي أرمد","https://www.aldiwan.net/poem66873.html","الكامل"],[412,"طرقت خيالا بعد طول صدودها","https://www.aldiwan.net/poem50186.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138261",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63866","المنسرح"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63826","الكامل"],[982,"","https://poetry.dctabudhabi.ae/diwan/poem/199798","الكامل"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122897","الكامل"],[1420,"","https://poetry.dctabudhabi.ae/diwan/poem/100690","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95548","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202148","الرمل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202140","الرمل"],[358,"","https://poetry.dctabudhabi.ae/diwan/poem/84072","الكامل"],[2414,"","https://poetry.dctabudhabi.ae/diwan/poem/72982","الطويل"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111679","الخفيف"],[2539,"","https://poetry.dctabudhabi.ae/diwan/poem/113617","الكامل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118830","المديد"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112518","الكامل"],[3322,"","https://poetry.dctabudhabi.ae/diwan/poem/142925","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112296","الكامل"],[3531,"","https://poetry.dctabudhabi.ae/diwan/poem/145732","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138703",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138607",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109996","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91054","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216433","الرمل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34580","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86580","البسيط"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147201","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91046","الكامل"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103256","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89589","المتدارك"],[4557,"","https://poetry.dctabudhabi.ae/diwan/poem/178159","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35108","البسيط"],[3271,"زفرة على فلسطين الدامية","https://www.poetsgate.com/ViewPoem.aspx?id=131018",""],[5186,"اليسر في العسرى على مقدارها","https://www.poetsgate.com/ViewPoem.aspx?id=156462",""],[5213,"حي ربوعا بالعذيب درسا","https://www.poetsgate.com/ViewPoem.aspx?id=170491",""],[5431,"سنة الله نصره والتلاقي","https://www.poetsgate.com/ViewPoem.aspx?id=198541",""],[5480,"متغنّم الشاره","https://www.poetsgate.com/ViewPoem.aspx?id=29630",""],[5565,"إني أبثّكَ سيّدي","https://www.poetsgate.com/ViewPoem.aspx?id=110221",""],[243,"حقائق كالخيال","https://www.poetsgate.com/ViewPoem.aspx?id=50559",""],[5873,"خدم الأعادي","https://www.poetsgate.com/ViewPoem.aspx?id=215352",""],[5956,"حدثٌ أليم","https://www.poetsgate.com/ViewPoem.aspx?id=193104",""],[5970,"محنة تأتي وأخرى في رواح","https://www.poetsgate.com/ViewPoem.aspx?id=130629",""],[6300,"على لسان الكره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82874&r=&rc=45",""],[5126,"مُوجز حياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87813&r=&rc=28",""],[572,"إنَّ دينارنا الذي فَضَح المخل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9431&r=&rc=288",""]],"verses":[["مِحَنُ الزَمانِ كَثيرَةٌ لا تَنقَضي","وَسُرورُهُ يَأتيكَ كالأَعيادِ",0,"د",1,1],["مِحَنٌ تَنْسِفُ العَزَائِمَ فِي الأبْ","طَالِ نَسْفاً لَوْ أَنَّهُنَّ حُصُونُ",1,"ن",1,0],["مُحَنَّكونَ عَلى الفَحشاءِ في صِغَرٍ","مُحَنَّكونَ عَلى الفَحشاءِ في كِبَرٍ",2,"ر",1,0],["مُحَنَّكونَ وَلَم تُقطَع سَرائِرُهُم","بَينَ الحَواضِنِ وَالداياتِ بِالكَمَدِ",2,"د",1,0],["محَنٌ تأتي على عجلٍ","وأمانٍ جمّة اللبث",3,"ث",1,0],["محنةٌ ضاعَفتْ له الأجرَ في الصو","م ويا رُبَّ خِيرةٍ في كريه",4,"ي",2,0],["مِحنَةٌ لَيسَ لَها مِثلٌ سِوى","مِحنَةِ الزَورَقِ في طاغي العُبابِ",5,"ب",1,0],["مِحَنُ الرِجالِ إِذا سَمَت","سَعَةُ الصُدورِ وَضيقُها",6,"ق",3,0],["مِحنَةُ العاشِقِ في ذُلِّ الهَوى","وَإِذا اِستُودِعَ سِرّاً كَتَما",7,"م",2,0],["مِحَنُ الحياةِ على النُّفوسِ كثيرةٌ","وأشدُّها الأهواءُ والأوهامُ",8,"م",1,0],["مِحْنَةٌ إِنْ تَكُ المَنِيَّةُ مَنْجَا","ةً فَمِنْهَا وَالفَوْزُ لِلسَّبِّاقِ",9,"ق",1,0],["مَحْنِيَّةً ظُهُورُهُمْ خُرْسَ الْخُطَى","كَالنَّمْلِ دَبَّ مُسْتَكِيناً مُخْلِدَا",10,"د",2,0],["\" محنة الفن \" محنة تتعب ال","فنّان والخلد من معانيه يهنا",11,"ن",2,0],["محنتي أنّي كما كنت لمن","هزّني ، مأساة عمري مزمنه",12,"ن",2,0],["مِحنٌ أرِقتُ بِها فَلَم أَنفكّ في","لَيلٍ مِن الغَمراتِ أَدهَمَ أَليَلا",13,"ل",2,0],["محن قد اجتمعت على","حر تحيّر في اغترابه",14,"ب",2,0],["محنتي فيك أفقدتني شعوري","بعذابي وفرحتي وهمومي",15,"ي",1,0],["محنتي إن غبت عني محنتك","وشقائي بالتجافي شقوتك",16,"ك",1,0],["محنتي فيك والجروح قصاصٌ","لم تُسَدّد ديونها السود بعد",17,"د",1,0],["مِحنَةٌ لَم يُرمَ قَطُّ بِها","سوقَةٌ قَبلي وَلا مَلِكُ",18,"ك",1,0],["مُحنّكٌ حلبَ الأيّامَ أَشطُرها","مُسدّد بالّذي اِستكفيتموه ملي",19,"ل",2,0],["محنٌ كست جسمي الضناءَ وزادها","حزناً شقاها والعداةُ الحُسَّدُ",20,"د",1,0],["مَحنٌ قَد احتَشَدَت وَقَلبٌ واثِقٌ","باللَهِ وَالزَيديُّ في تَبديدِها",21,"د",3,0],["محن علي تتابعت من عالم","لا يعرف المنجود فيه ناجدا",22,"د",2,0],["مُحنَّكُ الجهلِ بل محكَّكه","قارحُه منذ كان كُرَّزُه",23,"ز",2,0],["مِحَنُ الفتى يُخْبِرْنَ عن فضلِ الفتى","كالنارِ مخبرةٌ بفضلِ العنبر",24,"ر",1,0],["مِحنُ الزمان وإن تولت تنقضي","بدوام عمرِ والحوادثُ تقلعُ",25,"ع",1,1],["محن أبا ايوب أنت محلها","فاذا جزعت من الخطوب فمن لها",26,"ل",3,1],["محن اليّ توجهت فكأنني","قد صرت مغناطيس وهي حديد",27,"د",1,1],["محنةٌ فُوَّقت لمأمن مصرٍ","أفقدتها أحدّ ظُفرٍ ونابِ",28,"ب",1,0],["محنة القدس كحبل زدته","عقدا فاحش على حبل الوتين",29,"ن",1,0],["محن في محن هذا الورى","والاغرّاء هم الممتحنون",30,"ن",1,0],["مِحَن الهَوى منح لَدي","يَ وَعزّ مِثلي مَن مُنِح",31,"ح",1,0],["مُحنَّبةِ الرّجلَينِ حَرفٍ كأنَّها","قطاةٌ متَى يُتْمَم لها الخِمسُ تَقْرَبِ",32,"ب",1,0],["محنتي فيك أنَّني","لا أُبالي بمحنتي",33,"ت",2,0],["محن الهوى جمعت عليَّ","فلست أحصيها بِعَدِّ",34,"د",1,0],["مِحَني في عشقه مِنَحي","لم يلمني فيه غير غبي",35,"ب",2,0],["محنٌ لها عزم الجرىء وصبره","والصبر أجمل ما يفرج ضيقي",36,"ق",2,0],["مِحَنُ النفوسِ نصائحٌ منبوذةٌ","ومن العناء نصيحةُ المُتحيِّن",37,"ن",1,0],["مِحَنٌ تَشُقّ من الجُسو","مِ قلوبَهُم قبل الصّدورِ",38,"ر",1,0],["مَحنٌ لا يفيد ذا ال","نون منها التَبرصُص",39,"ص",1,0],["محنية الأضلاع دامية الحشى","تسعى كعالمةٍ لدار الكاظم",40,"م",1,0],["محنية الأضلاع بين ضلوعها","نارٌ وادمعها كغيثٍ ساجم",40,"م",1,0],["محن كابدها في كربلا","واستمرت لا ترى فيهن فصلا",41,"ل",2,0],["مِحَنٌ كَسَت جِسمي السَقامَ ونكَّرَت","تعريفَ شخصي فَهوَ لا يتعرَّفُ",42,"ف",1,0],["محنةٌ طالَت وَسقمٌ جائلٌ","في خلال الرُوح مني وَالجَسَد",43,"د",1,0],["محنةٌ تبلغ في يوم مداها","ما تراني صانعًا، أو ما تراها",44,"ا",1,0],["محنأة الأطراف رُؤدٌ شبابها","معقربة الصدغين كاذبة الوعد",45,"د",1,0],["محنك أحوذي من حداثته","ما ضيع الحزم في ورد ولا صدر",46,"ر",1,0],["محنة تلك، والحياة امتحانٌ","ويميناً نبقى جوادَ الرّهانِ",47,"ن",1,0],["محن وأعظمها أذى وأشدها","نكدا مصادقة العدا أجبارا",48,"ر",2,0],["محن تنوء الراسيات بحملها","ومن العجائب أن تنوء جبالُ",49,"ل",1,0],["مِحَنٌ إِحَنٌ أَشجانُ سُدىً","مِنها مُنجاةٌ مَركَبُها",50,"ب",3,0],["محَنُ الزمان لها عواقبُ تنقضِي","لا بد فاصبر لانقضاء أوانها",51,"ه",2,1],["مُحَنَّكٌ حَلَبَ الأَيّامَ أَشطُرَها","وَساقَها سَوقَ حادي العِيرِ لِلعيرِ",52,"ر",1,0],["محنٌ مرزّئةٌ وموتٌ عاصفٌ","لم يبق شيخا في الحمى أو أمردا",53,"د",2,0],["محن تذل الأسد في آجامها","وتقصر الأوطان عن أوطارها",54,"ر",3,0],["محنية الضلوع شفها السرى","كأن جسمها به تقوسا",55,"س",2,0],["محنة إثر محنةٍ باغترابٍ","دامع الظلّ موغلٌ في الشّقاقِ",56,"ق",1,0],["محنتني في مطلبك وإن دارت الدوره","عليّي أجدد للبحر غزره وتياره",57,"ر",2,0],["محَن كتِبنَ بمَفرِقي","وافى بهنّ ليَ القدر",58,"ر",1,0],["محنية تتفرى كل شاهدة","من كل قبر كما لو كان طفلاها",59,"ا",1,0],["محنٌ فيها توالى وقعها","ملأت أوطاننا بالنقمِ",60,"م",1,0],["مِحنٌ تلاحقهم بدون هوادة","لم يأتِ عنهم ما يَسُرُّ ولو خبَرْ",61,"ر",1,0],["محنة تأتي وأخرى في رواح","أقبلت ليلاً وولت في الصباح",62,"ح",1,1],["مِحَنُ المحبّة لا تعوقُ مطامعي","والحبُ ليس يزيدُني تشويقا",63,"ق",2,0],["محنطاً آوياً في كل مرزئة","إلى خراب.. عليه العقل يندثر",64,"ر",1,0],["محنقٌ مَنْ أحبّهُ ومريدُ","مَنْ أباهُ ومَانعٌ لِمُنيلِهْ",65,"ل",2,0]]}