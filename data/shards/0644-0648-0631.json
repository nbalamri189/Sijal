{"poems":[[53,"أكبح النفس إن جمحت","https://www.aldiwan.net/poem29629.html","مجزوء الخفيف"],[53,"ملك الملوك نداء ذي شجن","https://www.aldiwan.net/poem29742.html","الكامل"],[53,"قمر غاض ضوؤه في المحاق","https://www.aldiwan.net/poem29935.html","الخفيف"],[53,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[53,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[53,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[63,"من رام عزا بغير السيف لم ينل","https://www.aldiwan.net/poem46207.html","البسيط"],[77,"عهد الشباب سقى أيامك الأولا","https://www.aldiwan.net/poem35728.html","البسيط"],[77,"أنت للمسلمين خير عماد","https://www.aldiwan.net/poem36396.html","الخفيف"],[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[71,"لله قاضي ديندوز فإنه","https://www.aldiwan.net/poem3928.html","الكامل"],[71,"هل وفت للطلول عيني فأغنت","https://www.aldiwan.net/poem3950.html","الخفيف"],[93,"ألقى الدجى الستر فقم طائفا","https://www.aldiwan.net/poem11062.html","السريع"],[93,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[93,"راعنا خطبهم وكان جسيماً","https://www.aldiwan.net/poem11370.html","الخفيف"],[83,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[88,"هذي بلودان وذا نزلها","https://www.aldiwan.net/poem44394.html","الخفيف"],[88,"نكب الشارع الكبير ببغداد","https://www.aldiwan.net/poem44426.html","الخفيف"],[88,"هي عيني ودمعها نضاح","https://www.aldiwan.net/poem44461.html","الخفيف"],[88,"وضح الحق واستاقم السبيل","https://www.aldiwan.net/poem45025.html","الطويل"],[4,"ألم تلمم على الدمن الخوالي","https://www.aldiwan.net/poem21182.html","الوافر"],[72,"سهرت عليك لواحظ الرقباء","https://www.aldiwan.net/poem18175.html","الكامل"],[72,"قف بالحمى بعد البدور وناد","https://www.aldiwan.net/poem18572.html","الكامل"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[51,"عاقب الله كل من قال إني مخنث","https://www.aldiwan.net/poem9227.html","مجزوء الخفيف"],[51,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[51,"إن تطل لحية عليك وتعرض","https://www.aldiwan.net/poem62843.html","الخفيف"],[51,"بين أجفانه عقار تدور","https://www.aldiwan.net/poem64026.html","الخفيف"],[51,"حان كلام المعاتب الخرس","https://www.aldiwan.net/poem64655.html","المنسرح"],[51,"أيعيب مشيي جاهل لو أنه","https://www.aldiwan.net/poem64670.html","الكامل"],[51,"إذا تغنت شنطف مرة","https://www.aldiwan.net/poem65930.html","السريع"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"أين من قال بأن ليس","https://www.aldiwan.net/poem66310.html","مجزوء الرمل"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[51,"يا نبي الله في الشعر","https://www.aldiwan.net/poem66356.html","مجزوء الرمل"],[51,"إن إسماعيل قرد مجرم","https://www.aldiwan.net/poem66398.html","الرمل"],[51,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[51,"يا فؤادي غلبتني عصيانا","https://www.aldiwan.net/poem66699.html","الخفيف"],[91,"لو رأى آدم فتاه لزال الحقد","https://www.aldiwan.net/poem8729.html","عموديه"],[91,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[85,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[45,"أريحيات صبوة ومشيب","https://www.aldiwan.net/poem62638.html","الخفيف"],[45,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[45,"أكثر هذي الخطوب أشكال","https://www.aldiwan.net/poem65601.html","المنسرح"],[45,"أيما خلة ووصل قديم","https://www.aldiwan.net/poem66652.html","الخفيف"],[45,"ما تقضى لبانة عند لبنى","https://www.aldiwan.net/poem66658.html","الخفيف"],[61,"قد أظلتك يا أبا إسحاق","https://www.aldiwan.net/poem51509.html","الخفيف"],[61,"إلف الخيال أراك إلفا شاسعا","https://www.aldiwan.net/poem51575.html","الكامل"],[61,"لو رحبت كاس بذي أوبة","https://www.aldiwan.net/poem51653.html","السريع"],[61,"للخالديين جمال منظر","https://www.aldiwan.net/poem51665.html","الرجز"],[58,"علمي غزير وأخلاقي مهذبة","https://www.aldiwan.net/poem31168.html","البسيط"],[49,"يسلم المرء أخوه","https://www.aldiwan.net/poem63192.html","مجزوء الرمل"],[49,"عتب ما للخيال","https://www.aldiwan.net/poem64292.html","مجزوء الخفيف"],[49,"حجبوها عن الرياح لأني","https://www.aldiwan.net/poem64897.html","الخفيف"],[66,"بك من حادث الزمان نعوذ","https://www.aldiwan.net/poem39050.html","الخفيف"],[66,"خذ من الدهر لي نصيب","https://www.aldiwan.net/poem41371.html","مجزوء الخفيف"],[66,"جمعت في صفاتك الأضداد","https://www.aldiwan.net/poem41389.html","الخفيف"],[97,"عش مديدا وجدد","https://www.aldiwan.net/poem24978.html","مجزوء الخفيف"],[80,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[44,"دمن ألم بها فقال سلام","https://www.aldiwan.net/poem30368.html","الكامل"],[44,"أيها البرق بت بأعلى البراق","https://www.aldiwan.net/poem30394.html","الخفيف"],[44,"أجفان خوط البانة الأملود","https://www.aldiwan.net/poem30531.html","الكامل"],[44,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[44,"أي مرعى عين ووادي نسيب","https://www.aldiwan.net/poem30586.html","الخفيف"],[69,"يا أمير المؤمنين اعطف ولا","https://www.aldiwan.net/poem28332.html","الرمل"],[105,"بني حنيفة ما أشقى مسيلمة","https://www.aldiwan.net/poem44011.html","البسيط"],[105,"صاحب السيفين ماذا صنعا","https://www.aldiwan.net/poem44212.html","الرمل"],[81,"رع بجيش اللذات سرب الشجون","https://www.aldiwan.net/poem61479.html","الخفيف"],[81,"يلحى الزمان وما عليه ملام","https://www.aldiwan.net/poem61489.html","الكامل"],[52,"أسر القلب فأمسى لديه","https://www.aldiwan.net/poem26580.html","المديد"],[52,"قف خليلي نسأل لشرة دارا","https://www.aldiwan.net/poem27045.html","الخفيف"],[75,"لا تلمني عاذلي حين ترى","https://www.aldiwan.net/poem68993.html","الرمل"],[75,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[48,"أنت يا ابن الربيع ألزمتني النسك","https://www.aldiwan.net/poem62603.html","الخفيف"],[48,"أيها الناس ارحموني","https://www.aldiwan.net/poem66186.html","مجزوء الرمل"],[48,"إن لي أيرا خبيثا","https://www.aldiwan.net/poem66216.html","مجزوء الرمل"],[68,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39591","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39581","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54667","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54644","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54308","الخفيف"],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[90,"وفى الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179021",""],[45,"نَفّسَتْ قُرْبَها عَلَيناَ كَنُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=32955",""],[51,"يافؤادي غلبتني عصيانا","https://www.poetsgate.com/ViewPoem.aspx?id=30763",""],[51,"بين أجفانه عُقارٌ تدورُ","https://www.poetsgate.com/ViewPoem.aspx?id=29133",""],[51,"خلياني عند اصطكاك الخصوم","https://www.poetsgate.com/ViewPoem.aspx?id=25876",""],[51,"يا خَلِيلَيَّ تَيَّمَتْني وَحيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=25883",""]],"verses":[["لَو رَأى المُستَغِرُّ ما","ضَرَرُ اللَهوِ ما لَها",0,"ه",2,0],["لَو رُمتُ لَيَّ الجيدِ عَنكَ لَقَد","عَطَفَتهُ أَطواقٌ مِنَ المِنَنِ",1,"ن",1,0],["لَو رَآنا العَدوُّ أَضمَرنا ما","بَينَ أَحشائِهِ وَبَينَ التَراقي",2,"ق",2,0],["لَو رَأَيتُ الغَرامَ يَبلُغُ عُذرا","قُلتُ حُزناً وَلَم أَقُل لَكَ صَبرا",3,"ر",2,1],["لَو رَجَعنا إِلى العُقولِ يَقيناً","لَرَأَينا المَماتَ في الميلادِ",4,"د",1,0],["لَو رَدَّ عَنكِ المَنايا ال","عِجالَ طَعنٌ وَضَربُ",5,"ب",1,0],["لَو رَسولُ اللَهِ يَحيا بَعدَهُ","قَعَدَ اليَومَ عَلَيهِ لِلعَزا",6,"ا",1,0],["لوْ رُمْتُ بابْنِ أبي الفِتْيانِ رَجعَتَهُ","لَعادَتِ البيضُ مِنْ أيَّامِهِ الأُوَلِ",7,"ل",1,0],["لوْ رامَتْ الشُّهبَ في أقصى مَراكِزِها","لمْ تُبْقِ في الجَوِّ بَهْراماً ولا زُحَلا",8,"ل",2,0],["لَوْ رَأَى مَا شَرَعْتَ لِلْخَلْقِ فِيهِ","عُمَرُ الْفَاضِلُ ابْنُ عَبْدِ الْعَزِيزِ",9,"ز",1,0],["لوْ رامَ يقتَنِصُ النّجوم لنالَها","حتّى يحُطَّ عُلُوّها استِقْدارُه",10,"ر",2,0],["لَو رامَ نَشرَ صَنائِعٍ أَسدَيتَها","فيما مَضى بَشَرٌ لَضاقَ بِهِ الفَضا",11,"ض",2,0],["لَو رَآني العَذولُ يَومَ اِستَقَلّوا","لَرَثى لي في مَوقِفِ التَوديعِ",12,"ع",1,0],["لو رقدت أوشكت أعداؤها","أن يبصروا أحلامها والرؤى",13,"ا",1,0],["لَوْ رُعْتَ يَا طَيْفُ مِنْ غَيْبٍ مَسَامِعِهِمْ","بِزَأْرَةٍ حِينَ جَدَّ لانْهَزَمُوا",14,"م",3,0],["لَوْ رَعَتْهُمْ حُكُومَةٌ لَوَقَاهُمْ","عِلْمُهُمْ ذَلِكَ المُصَابَ الأَلِيمَا",15,"م",2,0],["لو رصَع البدر منها تاج مفرقه","لم يرضَ درَّ الدراري أن تحُلّيها",16,"ي",3,0],["لو رآها كسرى الملوك لخلّى","ملكه تاركاً لها إيوانه",17,"ن",2,0],["لو رآه العنّين يوماً لأمسى","مبرأً من رخاوة وعنانه",17,"ن",2,0],["لو ركبت البراق فيه أو البر","ق نهاراً لما أمنت العثارا",18,"ر",2,0],["لو رأوني سبياً بأيدي الأعادي","لبكَوا مثلما بكَيت وناحوا",19,"ح",3,0],["لو رآنا والشر فينا كثير","مستفيض والخير نزر قليل",20,"ل",1,0],["لِوِردٍ تَقلِصُ الغيطانُ عَنهُ","يَبُذُّ مَفازَةَ الخِمسِ الكَمالِ",21,"ل",1,0],["لو رامت الأيَّامُ سلوةَ بعضنا","لم تدرِ من فينا أخو الأهواء",22,"ا",2,0],["لو رمت أن أفدِي الحبيب بمهجتي","وهو الأصحّ وفاد كنت الفادِي",23,"ي",1,0],["لو رأى كلُّ عالمٍ مجلسَ السَّي","يِدِ يوماً لقلَّ منه الدُؤُوبُ",24,"ب",1,0],["لو رأى الدهرُ جَدّكم في تَعَالي","ه لأضحى كأنه مبهوتُ",25,"ت",1,0],["لو رأى ثَمَّ ويحَهُ","أرضَها كيف تُحرَثُ",26,"ث",1,0],["لو رُمْتَ صالحةً لغالك دونها","سجنٌ وقيدٌ منه بل أَقيادُ",27,"د",1,0],["لو رأى من يلُوم فيه لأضحى","وهو المسْتَريثُ والمسْتَزيدُ",28,"د",1,0],["لو رأى مثلها النبيُّ لأجرى","في لحى الناس سُنَّة التقصيرِ",29,"ر",1,0],["لو رأته حور الجنان لحَارت","منه في خالص الجمال الحورُ",30,"ر",1,0],["لو راضت الفحل من بني عُدُسٍ","لأذعنَ الفحل من بني عُدُس",31,"س",1,0],["لو رُمتها لنثرتَ فَرْثَكَ دُونَها","من ضيقِ صدرٍ واتساع مَفاسي",32,"ي",1,0],["لو رامت التوبةَ لم تستطعْ","لسُنَّةِ الشيطانِ تبديلا",33,"ل",2,0],["لو رأى اللَّه أن في البُدنِ فضلاً","ما زَوى الفضلَ عن عليِّ المعالي",34,"ل",2,0],["لو رأى قَرْنَ الحرْيثيْ","يِ استحى أن يَتَكَلَّمْ",35,"م",1,0],["لو رآك الرجالُ شيئاً نفيساً","كثُرتْ فيك هثهثات الخصوم",36,"م",1,0],["لو رأى قرْنَ الحُرَيْثيْ","يِ استحى أن يترممْ",37,"م",1,0],["لو رأى آدمُ جهلي لَمْحةً","يوم شاورتُ اليهوديَّ نفاني",38,"ن",2,0],["لو رآها في الجاهلِّية قومٌ","عَبُدوها وجانَبُوا الأوثانا",39,"ن",2,0],["لو رآه النعمان أو مَلِكُ النعْ","مان ما استنكفا من الإذعانِ",40,"ن",1,0],["لو رقا المُخبتين أصغوا إليه","ولجرُّوا له ذيول افتتانِ",40,"ن",1,0],["لو رأى البدرُ بعضَهُنَّ أو الشمْ","سُ لَذلَّا لوجهها واستكانا",41,"ن",2,0],["لَو رَأى آدَمٌ فَتاهُ لَزالَ ال","حِقدُ مِن قَلبِهِ عَلى حَوّاءِ",42,"ا",2,1],["لَو رَآها لائِمي فيها لَما","لامَني في هُبِّها بَل عَذَرا",43,"ر",2,0],["لو رأونا والهوى ثالثنا","والدجى يرخى علينا الحجبا",44,"ب",2,0],["لَو رُدَّ فِرعَونُ الغَداةَ لَراعَهُ","أَنَّ الغَرانيقَ العُلى لا تَنطِقُ",45,"ق",1,0],["لَو رَأَت عَينُهُ حَيا كَفِّ يَحيى","لَم تَرُقهُ الغُيوثُ وَهِيَ تَصوبُ",46,"ب",1,0],["لَو رَأَينا اليَهودَ أَدَّت نَفيساً","لَعَجِبنا أَن خَسَّتكَ اليَهودُ",47,"د",1,0],["لَو رَدَّتِ الحادِثاتُ ما أَخَذَت","عادَ ثَراءٌ وَراحَ إِقلالُ",48,"ل",1,0],["لَو رَآها المُعَنِّفونَ عَلَيها","لَغَدا بِالصَحيحِ ما بِالسَقيمِ",49,"م",1,0],["لَو رَأَت حادِثَ الخِضابِ لَأَنَّت","وَأَرَنَّت مِن إِحمِرارِ اليَرَنّا",50,"ن",2,0],["لو رَأَيْتَ القَريضَ يَرعُدُ منها","بينَ ذاكَ الإرْعادِ والإبراقِ",51,"ق",1,0],["لو رُمْنَ تَضييعَ العُهودِ ونقضَها","لَحَفَظْنَ دُرّاً في المحاجرِ ضائِعا",52,"ع",2,0],["لو رَحَّبَتْ كاسٌ بذي أوبةٍ","لرحَّبَتْ بالوردِ إذ زارَها",53,"ر",3,1],["لو رَضَّهُ الحافِرُ لم يُؤَثِّرِ","خُلَّةُ بَعلَينِ وخُلٍّ مُضْمَرِ",54,"ر",1,0],["لَو رُمتُ أَلفَ عَدُوٍّ كُنتُ واجِدَهُم","وَلَو طَلَبتُ صَديقاً ما ظَفَرتُ بِهِ",55,"ه",1,0],["لَو رَأى الناسُ نَبِيّاً","سائِلاً ما وَصَلوهُ",56,"و",2,0],["لَو رَآني صَديقي","رَقَّ لي أَو رَثى لي",57,"ل",2,0],["لَو رَضوا بِالحِجابِ هانَ وَلَكِن","مَنَعوها يَومَ الرَحيلِ الكَلاما",58,"م",2,0],["لَو رَأى لَفظَهُ الرَئيسُ اِبنُ سي","نا سَرَّهُ أَنَّهُ لَهُ تِلميذُ",59,"ذ",1,0],["لَو رَأَينا يا اِبنَ الكِرام","مِثلَ عُلياكَ في الدُوَل",60,"ل",1,0],["لَو رَأى غَيرَكَ النَبِيُّ لَآخا","هُ وَإِلّا فَأَخطَأَ الإِنتِقادُ",61,"د",1,0],["لو رأى الحق عبده","وهو بالحق يهتدي",62,"د",2,0],["لو رَكَنَ الباغي إلى عزّهِ","ما قَعَدَ الذلّ عليه وقام",63,"م",1,0],["لَوَرَيتَ زَندَ عَزائِمٍ تَحتَ الدُجى","أَسرَجنَ فِكرَكَ وَالبِلادُ ظَلامُ",64,"م",1,0],["لَو رَأَوا كَوكَبَ المَنايا لَظَلّوا","نَحوَها مُهطِعينَ بِالأَعناقِ",65,"ق",1,0],["لَو رامَ جُلموداً بِجانِبِ صَخرَةٍ","يَوماً لَرَضَّضَ جانِبَ الجُلمودِ",66,"د",1,0],["لَو رَأى اللَهُ أَنَّ لِلشَيبِ فَضلاً","جاوَرَتهُ الأَبرارُ في الخُلدِ شيبا",67,"ب",2,0],["لَو رَأَينا التَوكيدَ خُطَّةَ عَجزٍ","ما شَفَعنا الآذانَ بِالتَثويبِ",68,"ب",1,0],["لو رفعتَ السترَ قبَّلْنا الثّرى","وترحَمنا على مَنْ خلَّفَكْ",69,"ك",1,0],["لَو راحَ صاحِبُه يرمي به جَبَلاً","يَعلو الجِبالَ مِنَ الأخلاقِ لانْصَدَعا",70,"ع",2,0],["لو رآه يتحدَّى نفسَهُ","لرآها كيف تَهوِي قِطعَا",71,"ع",2,0],["لَو رَقاني بِريقِهِ لَشَفى مَك","نونَ هَمّي بِلُؤلُؤٍ مَكنونِ",72,"ن",1,0],["لَو رامَها غَيرُ القَضاءِ لَكانَ في","أُسدِ الهَياجِ تَخَمُّطٌ وَعُرامُ",73,"م",1,0],["لَو رَأى العُذّالُ ما بِقَلبِيَ لَم","يَجِدوا وَاللَهِ غَيرَكَ فيهِ",74,"ي",2,0],["لَو رَأى مَطلَعاً مِنَ الأَرضِ سَهلاً","دَبَّ في الناسِ يَنفُثُ الأَسرارا",75,"ر",2,0],["لو رأى وجهَ حبيبي عاذلي","لتفارقنا على وجهٍ جميل",76,"ل",1,0],["لو رأى ما رأيتَ منْها إلى أنْ","تَتَوارى شمسٌ بسِجْفِ الغَساق",77,"ق",1,0],["لَو رَآها بَعضُ المُرائينَ يَوماً","لَاِشتَراها يُعِدُّها لِلشَهادَه",78,"د",2,0],["لَو رَأَيتُم حينَ يَمشي","كاسِراً مِن حاجِبَيهِ",79,"ي",2,0],["لو رأى في الجوّ صدعاً","لنزا حتى يموتا",80,"ت",2,0],["لو رأيتَ الذي سَبَانيَ فيه","مِنْ جَمالٍ ولن تراهُ سبَاكا",81,"ك",2,0],["لو رماهُ فَمُ القضاءِ بسمعي","خِلْتُهُ بعضَ لهوه ومزاحِهْ",82,"ح",2,0],["لو رُدَّ فرعونٌ وسِحْرُ دعاتهِ","وتساءلوا بكَ مُجمعينَ وأحدقوا",83,"ق",3,0],["لُوريسُ إِنِّي هَانئٌ","جَذَلٌ بِأَنْ أَصْبَحْتِ بِنْتي",84,"ي",1,1],["لَوْ رَابَهُمْ زَهْرُ الدَّيَاجِي فَمَا","فِي نُورِ ذَاكَ الْغَوْثِ مِنْ مُسْتَرِيبْ",85,"ب",1,0],["لَو رَعى فيهِ الرعافُ ذِمامي","لَم يَشقني لِلشَّقيقِ الجَنيِّ",86,"ي",1,0],["لَوْ رُفَائِيلُ راءها غَالَهُ الْبَهْرُ","وَأَلْقَى ألْوَاحَهُ وَدِهَانَه",87,"ن",2,0],["لوْ رأيتَ الأشباحَ مِنْ ساكنيه","لرَأيْتَ الأطْلالَ في الأطْلالِ",88,"ل",1,0],["لَوْ رَآها جِبْرِيلُ أسْتَغْفِرُ اللّهَ","لأَلْهَتْ عَنْ وَحْيِهِ جِبْرِيلاَ",89,"ل",2,0],["لو رأوني أُمسي حماراً لنادَوا","خبراءً يترجمون نهيقي",90,"ق",2,0],["لو رام يمحو البخل عنه مُدافعٌ","عكفت طبيعتُه على تعنيفه",91,"ف",2,0],["لَوْ رَأيْنَا اليَهُودَ أدّتْ نِفِيساً،","لَعَجِبْنا إنْ خَسْسَتْكَ اليَهودُ",92,"د",1,0],["لو رأى الدرُ بعضهُنَّ أو الشمْ","سُ لَذلاَّ لوجهها واستكانا",93,"ن",2,0],["لو رأته حور الحنان لحَارت","منه في خالص الجمال الحورُ",94,"ر",1,0],["لو رآك الرجالُ شيئاً نفيساً","كثرت فيك هنبثات الخصوم",95,"م",1,0],["لو رأى من يلُوم فيه لأضحى","وهو لي المستريثُ والمستزيد",96,"د",1,0]]}