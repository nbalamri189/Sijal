,1,0],["لو رقَّ من برح السّقام لنضوه","المضني لكان من السقام يعوده",200,"د",2,0],["لَو رَأَتهُ الشَمسُ لَاِنكَسَفَت","حَسَداً مِنها لِطَلعَتِهِ",201,"ت",2,0],["لو رفرف الخطاف حول مقركم","متطلبّا خلف النوافذ مجثما",202,"م",2,0],["لو رمت احداث القلاقل عندها","لجعلت سيدك الأمير خديما",203,"م",2,0],["لو رَآهُ لحَماهُ","نورُهُ من طَمْسِ لومِهْ",204,"م",2,0],["لو رأيتَ إشفاقَ إبليسِ مِنْهمْ","لسَألتَ ألفاً: أهَذا الظّلومُ؟",205,"م",1,0],["لو رامَ ذو القَرنين بعضَ سَدادِه","لم يَمضِ ياجوجٌ غَداً من سَدِّهِ",206,"د",2,0],["لو رأى ما نَبَيْتَ عنه اِبنُ عادٍ","جلَّ في عينِه وهانَتْ جِنانُه",207,"ن",2,0],["لو رأت عينه فعالك قرت","واستقرت بساكنيها القبور",208,"ر",1,0],["لو رام تعبيساً وحاشا وجهه","منعته شيمة وجهه المستبشر",209,"ر",1,0],["لو راهنت خطراتها طيف الكرى","لا عتاق في المضمار دون عتاقها",210,"ق",3,0],["لو رام ابن مقلة","قالت له أنت أقل",211,"ل",1,0],["لو رآني العدو رق لما بي","وبكى لي الصديق مما دهاني",212,"ن",2,0],["لَوْ رُمْتَ في كَرَمِ الطّباعِ شَهادَةً","شَهِدَ الْوَرَى طُرّاً بِغَيْرِ تَوَقُّفِ",213,"ف",1,0],["لو رُمتَ مِن غُرََر المحَاسن والمَكَا","رمِ أن تزيدَه ما استَطعتَ مَزَادا",214,"د",2,0],["لَو راهَنَت هاشِمٌ عَن خيرِها رجُلاً","كان أَبوكَ الَّذي يُختَصُّ بالرَهَنِ",215,"ن",1,0],["لَو رَأَيتَ الطَعنَ دَيناً لَم تَجِد","إِذ دِماءُ القَومِ بِالطَعنِ تُمارُ",216,"ر",1,0],["لو رامها منِّي سوا","كَ لبات منها مُنفِضا",217,"ض",2,0],["لَو رامَ قَلبي عَن هَواكِ تَصَبُّراً","ما كانَ لي طولَ الحَياةِ بِصاحِبِ",218,"ب",1,0],["لو رأى الحق ما أبى عن سجود","منع العين علمه معناها",219,"ا",3,0],["لورآه البدر ما بان ولو","سمع الظبي به لم يقف",220,"ف",1,0],["لَو رَأَتْ عَيْنَاكَ مِنْ صَا","حِبِهِ طَرْفَاً غَضِيْضَا",221,"ض",2,0],["لو رَامت الشَّمْس المنيرةُ شأْوَه","يومَ الفَخَار لعاقَها العيُّوق",222,"ق",1,0],["لو رامَها الدَّهرُ لم يظفَرْ بِبُغْيَتهِ","ولَوْ رماهَا بِقوسِ الأُفْقِِ لم يصُب",223,"ب",1,0],["لَوْ رُمْتُ أَسْحَبُ أَذْيالي على فَلَكٍ","لَمدَّ لي سَببٌ مِنْ جُودهِ سَبَبا",224,"ب",2,0],["لَوْ رُمْتَ إِبْقَاءَ الوِدَادِ بِحالِهِ","لَمْ تُغْرِ طَرْفَكَ بِارْتِيادِ نِبَالِهِ",225,"ل",2,1],["لَوْ رَقَّ فُؤادهُ على مُغْرَمِهْ","ما ضَنَّ بِنَظْمِ الدُّرِّ مِنْ مَبْسَمِه",226,"ه",1,1],["لَوْ رَآكَ الغُصْنُ لَمْ يَمِسِ","أَوْ رَآكَ البَدْرُ لاسْتَتَرا",227,"ر",2,0]]}