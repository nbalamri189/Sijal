tps://www.aldiwan.net/poem54102.html","الرمل"],[417,"لله در أبي داود من رجل","https://www.aldiwan.net/poem54143.html","البسيط"],[430,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[430,"خود من الترك قد صالت على العرب","https://www.aldiwan.net/poem40050.html","البسيط"],[430,"لو رأى تغلب وبكر بزاة","https://www.aldiwan.net/poem40812.html","الخفيف"],[438,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[438,"يا حادياً هلا وقفت قليلا","https://www.aldiwan.net/poem2575.html","الكامل"],[440,"ثم أقدمتهن شعث النواصي","https://www.aldiwan.net/poem34764.html","الخفيف"],[442,"عرج على وادي العقيق","https://www.aldiwan.net/poem14319.html","مجزوء الكامل"],[444,"يا عشير الصبا الكريم السجيه","https://www.aldiwan.net/poem56046.html","عموديه"],[449,"هل إلى برد الثنايا من سبيل","https://www.aldiwan.net/poem53767.html","الرمل"],[450,"إلى ربيع العمر","https://www.aldiwan.net/poem1006.html",""],[453,"لو رحت أبكي بكت لأجلي القلوب القسي","https://www.aldiwan.net/poem13974.html","المواليا"],[459,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[459,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[459,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[459,"يا مستضيم الملك أين الحامي","https://www.aldiwan.net/poem55873.html","الكامل"],[459,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[459,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[459,"للنقص من أعمارنا ما يكمل","https://www.aldiwan.net/poem56077.html","الكامل"],[459,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[459,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[459,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[462,"كبت جفان الحي من دارم","https://www.aldiwan.net/poem15098.html","السريع"],[465,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[465,"بك طالت يد الزمان القصيرِ","https://www.aldiwan.net/poem3316.html","عموديه"],[465,"أما النسيم فما يغب وروده","https://www.aldiwan.net/poem3545.html","عموديه"],[469,"صار فظا بعد رقته","https://www.aldiwan.net/poem60338.html","المديد"],[480,"وافى لصنوه شاعر يوما فما","https://www.aldiwan.net/poem37005.html","الكامل"],[480,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[501,"طلع الفجر لعمري","https://www.aldiwan.net/poem37776.html","مجزوء الرمل"],[506,"رجعة الأنبياء","https://www.aldiwan.net/poem42461.html","الخفيف"],[515,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[515,"أيها المصقع المهذب طبعا","https://www.aldiwan.net/poem20837.html","الخفيف"],[516,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[516,"يا دار عليك سعد المشتري","https://www.aldiwan.net/poem12135.html","الكامل"],[516,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[516,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[516,"خطبتني الخطوب بالهم لما","https://www.aldiwan.net/poem12295.html","الخفيف"],[530,"وافت إلي من المقام الأشرف","https://www.aldiwan.net/poem37320.html","الكامل"],[539,"خطب جسيم فتت الأكبادا","https://www.aldiwan.net/poem48242.html","عموديه"],[541,"ياذا المنوه تدعوني لتسمعني","https://www.aldiwan.net/poem56644.html","البسيط"],[544,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[552,"أترى يؤوب زماننا","https://www.aldiwan.net/poem47734.html","مجزوء الكامل"],[554,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[559,"فنحت عندنا المليح فاها","https://www.aldiwan.net/poem33654.html","الخفيف"],[559,"شرفي يا شرفي يا شرفي","https://www.aldiwan.net/poem34339.html","الرمل"],[568,"بأبي أنت تباغضت","https://www.aldiwan.net/poem69622.html","مجزوء الرمل"],[576,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[576,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[587,"صبا وهزته أيدي شوقه طربا","https://www.aldiwan.net/poem17425.html","البسيط"],[587,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"],[587,"لو رق فؤاده على مغرمه","https://www.aldiwan.net/poem17768.html","الدوبيت"],[587,"قمر يجلو دجى الغلس","https://www.aldiwan.net/poem17971.html","المديد"]],"verses":[["لَو رَأى المُستَغِرُّ ما","ضَرَرُ اللَهوِ ما لَها",0,"ه",2,0],["لَو رُمتُ لَيَّ الجيدِ عَنكَ لَقَد","عَطَفَتهُ أَطواقٌ مِنَ المِنَنِ",1,"ن",1,0],["لَو رَآنا العَدوُّ أَضمَرنا ما","بَينَ أَحشائِهِ وَبَينَ التَراقي",2,"ق",2,0],["لَو رَأَيتُ الغَرامَ يَبلُغُ عُذرا","قُلتُ حُزناً وَلَم أَقُل لَكَ صَبرا",3,"ر",2,1],["لَو رَجَعنا إِلى العُقولِ يَقيناً","لَرَأَينا المَماتَ في الميلادِ",4,"د",1,0],["لَو رَدَّ عَنكِ المَنايا ال","عِجالَ طَعنٌ وَضَربُ",5,"ب",1,0],["لَو رَسولُ اللَهِ يَحيا بَعدَهُ","قَعَدَ اليَومَ عَلَيهِ لِلعَزا",6,"ا",1,0],["لوْ رُمْتُ بابْنِ أبي الفِتْيانِ رَجعَتَهُ","لَعادَتِ البيضُ مِنْ أيَّامِهِ الأُوَلِ",7,"ل",1,0],["لوْ رامَتْ الشُّهبَ في أقصى مَراكِزِها","لمْ تُبْقِ في الجَوِّ بَهْراماً ولا زُحَلا",8,"ل",2,0],["لَوْ رَأَى مَا شَرَعْتَ لِلْخَلْقِ فِيهِ","عُمَرُ الْفَاضِلُ ابْنُ عَبْدِ الْعَزِيزِ",9,"ز",1,0],["لوْ رامَ يقتَنِصُ النّجوم لنالَها","حتّى يحُطَّ عُلُوّها استِقْدارُه",10,"ر",2,0],["لَو رامَ نَشرَ صَنائِعٍ أَسدَيتَها","فيما مَضى بَشَرٌ لَضاقَ بِهِ الفَضا",11,"ض",2,0],["لَو رَآني العَذولُ يَومَ اِستَقَلّوا","لَرَثى لي في مَوقِفِ التَوديعِ",12,"ع",1,0],["لو رقدت أوشكت أعداؤها","أن يبصروا أحلامها والرؤى",13,"ا",1,0],["لَوْ رُعْتَ يَا طَيْفُ مِنْ غَيْبٍ مَسَامِعِهِمْ","بِزَأْرَةٍ حِينَ جَدَّ لانْهَزَمُوا",14,"م",3,0],["لَوْ رَعَتْهُمْ حُكُومَةٌ لَوَقَاهُمْ","عِلْمُهُمْ ذَلِكَ المُصَابَ الأَلِيمَا",15,"م",2,0],["لو رصَع البدر منها تاج مفرقه","لم يرضَ درَّ الدراري أن تحُلّيها",16,"ي",3,0],["لو رآها كسرى الملوك لخلّى","ملكه تاركاً لها إيوانه",17,"ن",2,0],["لو رآه العنّين يوماً لأمسى","مبرأً من رخاوة وعنانه",17,"ن",2,0],["لو ركبت البراق فيه أو البر","ق نهاراً لما أمنت العثارا",18,"ر",2,0],["لو رأوني سبياً بأيدي الأعادي","لبكَوا مثلما بكَيت وناحوا",19,"ح",3,0],["لو رآنا والشر فينا كثير","مستفيض والخير نزر قليل",20,"ل",1,0],["لِوِردٍ تَقلِصُ الغيطانُ عَنهُ","يَبُذُّ مَفازَةَ الخِمسِ الكَمالِ",21,"ل",1,0],["لو رامت الأيَّامُ سلوةَ بعضنا","لم تدرِ من فينا أخو الأهواء",22,"ا",2,0],["لو رمت أن أفدِي الحبيب بمهجتي","وهو الأصحّ وفاد كنت الفادِي",23,"د",2,0],["لو رأى كلُّ عالمٍ مجلسَ السَّي","يِدِ يوماً لقلَّ منه الدُؤُوبُ",24,"ب",1,0],["لو رأى الدهرُ جَدّكم في تَعَالي","ه لأضحى كأنه مبهوتُ",25,"ت",1,0],["لو رأى ثَمَّ ويحَهُ","أرضَها كيف تُحرَثُ",26,"ث",1,0],["لو رُمْتَ صالحةً لغالك دونها","سجنٌ وقيدٌ منه بل أَقيادُ",27,"د",1,0],["لو رأى من يلُوم فيه لأضحى","وهو المسْتَريثُ والمسْتَزيدُ",28,"د",1,0],["لو رأى مثلها النبيُّ لأجرى","في لحى الناس سُنَّة التقصيرِ",29,"ر",1,0],["لو رأته حور الجنان لحَارت","منه في خالص الجمال الحورُ",30,"ر",1,0],["لو راضت الفحل من بني عُدُسٍ","لأذعنَ الفحل من بني عُدُس",31,"س",1,0],["لو رُمتها لنثرتَ فَرْثَكَ دُونَها","من ضيقِ صدرٍ واتساع مَفاسي",32,"س",2,0],["لو رامت التوبةَ لم تستطعْ","لسُنَّةِ الشيطانِ تبديلا",33,"ل",2,0],["لو رأى اللَّه أن في البُدنِ فضلاً","ما زَوى الفضلَ عن عليِّ المعالي",34,"ل",2,0],["لو رأى قَرْنَ الحرْيثيْ","يِ استحى أن يَتَكَلَّمْ",35,"م",1,0],["لو رآك الرجالُ شيئاً نفيساً","كثُرتْ فيك هثهثات الخصوم",36,"م",1,0],["لو رأى قرْنَ الحُرَيْثيْ","يِ استحى أن يترممْ",37,"م",1,0],["لو رأى آدمُ جهلي لَمْحةً","يوم شاورتُ اليهوديَّ نفاني",38,"ن",2,0],["لو رآها في الجاهلِّية قومٌ","عَبُدوها وجانَبُوا الأوثانا",39,"ن",2,0],["لو رآه النعمان أو مَلِكُ النعْ","مان ما استنكفا من الإذعانِ",40,"ن",1,0],["لو رقا المُخبتين أصغوا إليه","ولجرُّوا له ذيول افتتانِ",40,"ن",1,0],["لو رأى البدرُ بعضَهُنَّ أو الشمْ","سُ لَذلَّا لوجهها واستكانا",41,"ن",2,0],["لَو رَأى آدَمٌ فَتاهُ لَزالَ ال","حِقدُ مِن قَلبِهِ عَلى حَوّاءِ",42,"ا",2,1],["لَو رَآها لائِمي فيها لَما","لامَني في هُبِّها بَل عَذَرا",43,"ر",2,0],["لو رأونا والهوى ثالثنا","والدجى يرخى علينا الحجبا",44,"ب",2,0],["لَو رُدَّ فِرعَونُ الغَداةَ لَراعَهُ","أَنَّ الغَرانيقَ العُلى لا تَنطِقُ",45,"ق",1,0],["لَو رَأَت عَينُهُ حَيا كَفِّ يَحيى","لَم تَرُقهُ الغُيوثُ وَهِيَ تَصوبُ",46,"ب",1,0],["لَو رَأَينا اليَهودَ أَدَّت نَفيساً","لَعَجِبنا أَن خَسَّتكَ اليَهودُ",47,"د",1,0],["لَو رَدَّتِ الحادِثاتُ ما أَخَذَت","عادَ ثَراءٌ وَراحَ إِقلالُ",48,"ل",1,0],["لَو رَآها المُعَنِّفونَ عَلَيها","لَغَدا بِالصَحيحِ ما بِالسَقيمِ",49,"م",1,0],["لَو رَأَت حادِثَ الخِضابِ لَأَنَّت","وَأَرَنَّت مِن إِحمِرارِ اليَرَنّا",50,"ن",2,0],["لو رَأَيْتَ القَريضَ يَرعُدُ منها","بينَ ذاكَ الإرْعادِ والإبراقِ",51,"ق",1,0],["لو رُمْنَ تَضييعَ العُهودِ ونقضَها","لَحَفَظْنَ دُرّاً في المحاجرِ ضائِعا",52,"ع",2,0],["لو رَحَّبَتْ كاسٌ بذي أوبةٍ","لرحَّبَتْ بالوردِ إذ زارَها",53,"ر",3,1],["لو رَضَّهُ الحافِرُ لم يُؤَثِّرِ","خُلَّةُ بَعلَينِ وخُلٍّ مُضْمَرِ",54,"ر",1,0],["لَو رُمتُ أَلفَ عَدُوٍّ كُنتُ واجِدَهُم","وَلَو طَلَبتُ صَديقاً ما ظَفَرتُ بِهِ",55,"ه",1,0],["لَو رَأى الناسُ نَبِيّاً","سائِلاً ما وَصَلوهُ",56,"و",2,0],["لَو رَآني صَديقي","رَقَّ لي أَو رَثى لي",57,"ل",2,0],["لَو رَضوا بِالحِجابِ هانَ وَلَكِن","مَنَعوها يَومَ الرَحيلِ الكَلاما",58,"م",2,0],["لَو رَأى لَفظَهُ الرَئيسُ اِبنُ سي","نا سَرَّهُ أَنَّهُ لَهُ تِلميذُ",59,"ذ",1,0],["لَو رَأَينا يا اِبنَ الكِرام","مِثلَ عُلياكَ في الدُوَل",60,"ل",1,0],["لَو رَأى غَيرَكَ النَبِيُّ لَآخا","هُ وَإِلّا فَأَخطَأَ الإِنتِقادُ",61,"د",1,0],["لو رأى الحق عبده","وهو بالحق يهتدي",62,"د",2,0],["لو رَكَنَ الباغي إلى عزّهِ","ما قَعَدَ الذلّ عليه وقام",63,"م",1,0],["لَوَرَيتَ زَندَ عَزائِمٍ تَحتَ الدُجى","أَسرَجنَ فِكرَكَ وَالبِلادُ ظَلامُ",64,"م",1,0],["لَو رَأَوا كَوكَبَ المَنايا لَظَلّوا","نَحوَها مُهطِعينَ بِالأَعناقِ",65,"ق",1,0],["لَو رامَ جُلموداً بِجانِبِ صَخرَةٍ","يَوماً لَرَضَّضَ جانِبَ الجُلمودِ",66,"د",1,0],["لَو رَأى اللَهُ أَنَّ لِلشَيبِ فَضلاً","جاوَرَتهُ الأَبرارُ في الخُلدِ شيبا",67,"ب",2,0],["لَو رَأَينا التَوكيدَ خُطَّةَ عَجزٍ","ما شَفَعنا الآذانَ بِالتَثويبِ",68,"ب",1,0],["لو رفعتَ السترَ قبَّلْنا الثّرى","وترحَمنا على مَنْ خلَّفَكْ",69,"ك",1,0],["لَو راحَ صاحِبُه يرمي به جَبَلاً","يَعلو الجِبالَ مِنَ الأخلاقِ لانْصَدَعا",70,"ع",2,0],["لو رآه يتحدَّى نفسَهُ","لرآها كيف تَهوِي قِطعَا",71,"ع",2,0],["لَو رَقاني بِريقِهِ لَشَفى مَك","نونَ هَمّي بِلُؤلُؤٍ مَكنونِ",72,"ن",1,0],["لَو رامَها غَيرُ القَضاءِ لَكانَ في","أُسدِ الهَياجِ تَخَمُّطٌ وَعُرامُ",73,"م",1,0],["لَو رَأى العُذّالُ ما بِقَلبِيَ لَم","يَجِدوا وَاللَهِ غَيرَكَ فيهِ",74,"ي",2,0],["لَو رَأى مَطلَعاً مِنَ الأَرضِ سَهلاً","دَبَّ في الناسِ يَنفُثُ الأَسرارا",75,"ر",2,0],["لو رأى وجهَ حبيبي عاذلي","لتفارقنا على وجهٍ جميل",76,"ل",1,0],["لو رأى ما رأيتَ منْها إلى أنْ","تَتَوارى شمسٌ بسِجْفِ الغَساق",77,"ق",1,0],["لَو رَآها بَعضُ المُرائينَ يَوماً","لَاِشتَراها يُعِدُّها لِلشَهادَه",78,"د",2,0],["لَو رَأَيتُم حينَ يَمشي","كاسِراً مِن حاجِبَيهِ",79,"ي",2,0],["لو رأى في الجوّ صدعاً","لنزا حتى يموتا",80,"ت",2,0],["لو رأيتَ الذي سَبَانيَ فيه","مِنْ جَمالٍ ولن تراهُ سبَاكا",81,"ك",2,0],["لو رماهُ فَمُ القضاءِ بسمعي","خِلْتُهُ بعضَ لهوه ومزاحِهْ",82,"ح",2,0],["لو رُدَّ فرعونٌ وسِحْرُ دعاتهِ","وتساءلوا بكَ مُجمعينَ وأحدقوا",83,"ق",3,0],["لُوريسُ إِنِّي هَانئٌ","جَذَلٌ بِأَنْ أَصْبَحْتِ بِنْتي",84,"ي",1,1],["لَوْ رَابَهُمْ زَهْرُ الدَّيَاجِي فَمَا","فِي نُورِ ذَاكَ الْغَوْثِ مِنْ مُسْتَرِيبْ",85,"ب",1,0],["لَو رَعى فيهِ الرعافُ ذِمامي","لَم يَشقني لِلشَّقيقِ الجَنيِّ",86,"ي",1,0],["لَوْ رُفَائِيلُ راءها غَالَهُ الْبَهْرُ","وَأَلْقَى ألْوَاحَهُ وَدِهَانَه",87,"ن",2,0],["لوْ رأيتَ الأشباحَ مِنْ ساكنيه","لرَأيْتَ الأطْلالَ في الأطْلالِ",88,"ل",1,0],["لَوْ رَآها جِبْرِيلُ أسْتَغْفِرُ اللّهَ","لأَلْهَتْ عَنْ وَحْيِهِ جِبْرِيلاَ",89,"ل",2,0],["لو رأى \" شهريار \" طيف صباها","باع فيها سلطانه وسريره",90,"ر",2,0],["لو رأوني أُمسي حماراً لنادَوا","خبراءً يترجمون نهيقي",91,"ق",2,0],["لو رُدَّ فرعونٌ وسِحْرُ دعاتِهِ","وتساءَلوا بكَ مُجْمِعِينَ وأح",92,"ح",1,0],["لو رام يمحو البخل عنه مُدافعٌ","عكفت طبيعتُه على تعنيفه",93,"ف",2,0],["لَوْ رَأيْنَا اليَهُودَ أدّتْ نِفِيساً،","لَعَجِبْنا إنْ خَسْسَتْكَ اليَهودُ",94,"د",1,0],["لو رفّ حبك في بيداء لاهبة","على الظماء رحيقا ما وردناه",95,"ا",2,0],["لو رأى الدرُ بعضهُنَّ أو الشمْ","سُ لَذلاَّ لوجهها واستكانا",96,"ن",2,0],["لو رأته حور الحنان لحَارت","منه في خالص الجمال الحورُ",97,"ر",1,0],["لو رآك الرجالُ شيئاً نفيساً","كثرت فيك هنبثات الخصوم",98,"م",1,0],["لو رأى من يلُوم فيه لأضحى","وهو لي المستريثُ والمستزيد",99,"د",1,0],["لو رأى هذه الدّموع الغوالي","لبكى رحمة وحيّا وفدّى",100,"د",2,0],["لو ردّ فرعون وسحر دعاته","وتسائلوا بك مجمعين وأحدقوا",101,"ق",3,0],["لَو رَوَتهُ الرُواة في الحَي يَوماً","لِلمَصونات هَتَكَت أَستارا",102,"ر",2,0],["لَو رَآهُ شَقيقهُ","وَتَبَدى لَهُ هَوى",103,"و",2,0],["لو رأك البدر في برج العلى","قال يا هذا الفتى ما اجملك",104,"ك",1,0],["لو رأتها حورُ الجنانِ لقالتْ","فوّضونا فلا نريد سِوَاهَا",105,"ا",3,0],["لو رُوحه تسألُ أعطَاكَهَا","فليتق الرحمنَ مَنْ يَسْألُ",106,"ل",1,0],["لو رُمتُ يوماً لكنتُ أجني","من ثَمَر الحُسنِ ما أشاء",107,"ا",2,0],["لَو رَأى الرائِى سريرتَه","لازدَرَتهُ مُقلَةُ الرائِى",108,"ا",2,0],["لو راءَ مُوسى ما فعلتَ وطارِقٌ","زريا بما لهما من الآثارِ",109,"ر",1,0],["لَو رَأَينا لِسُلَيمى أَثَراً","لَسَجَدنا أَلفَ أَلفٍ لِلأَثَر",110,"ر",1,0],["لو رجَعنا إلأى اليقين علِمنا","أنّنا في الدُّنا نُشيِّدُ سجنا",111,"ن",2,0],["لَو راءَ ما يَأتي أَوائِلُ وائِلٍ","بِمَحضِ الفَخرِ مِنكَ لُبابِ",112,"ب",1,0],["لَو رُمتُ نَيلَكَ عِندَهُم لَعَدِمتُهُ","أَو رُمتُ مِثلَكَ فيهِمُ لَتَعَذَّرا",113,"ر",2,0],["لو رأيت الذنب منصرما","لم أعدَّ العمر منصرما",114,"م",2,0],["لَوْ رَمى اللَهُ بِالفِراقِ المَنايا","شُغِلَت عَنْ طِلابِها لِلنُّفُوسِ",115,"س",1,0],["لَوْ رَأَتْهُ العِيدانُ وَهْيَ سَكُوتٌ","كَلَّمَتْهُ سِرّاً بِلا أَوْتارِ",116,"ر",1,0],["لوردٍ من الخدِ أُضحِي أشمُّ","ومسكٍ منَ الصدغِ أُمسي أَجرّ",117,"ر",1,0],["لَو رامَ أَحداثَ الزَّمانِ بِفَتكَةٍ","لاِستَعصمَت مِن سُخطِهِ بِرِضائِهِ",118,"ا",3,0],["لَو رُدَّ مَحتُومُ القَضاءِ لَقابَلَت","بِالرَدِّ مَحتُومَ القَضاءِ المُنزَلِ",119,"ل",1,0],["لَو رادَكَ الثَورِيُّ أَعلَنَ قائِلاً","أَنتَ الغَمامُ وَمَن سَواكَ جَهامُ",120,"م",1,0],["لو رأى فرعونُها وجهَك ما","عَلق الدعوى بقولِ الكذب",121,"ب",1,0],["لو رام ذلك منه أمرُ مُغتصِبٍ","في السوق بال