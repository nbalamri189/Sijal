4335.html","المديد"],[565,"كأنما الراووق وانتصابه","https://www.aldiwan.net/poem69791.html","الرجز"]],"verses":[["فَاِلبَس جَلابيبَهُ البيضَ الَّتي شَرُفَت","وَاِخرُج عَنِ الصَومِ مِن أَثوابِهِ الجَونِ",0,"ن",1,0],["فَأُلبِسُ عِطفَيَّ ذاكَ الجَلالَ","وَأورِدُ عَينَيَّ ذاكَ الهُماما",1,"م",2,0],["فَالبيضُ تَعلَقُ إِن سارَت مُهَجِّرَةً","مِنَ الشُحوبِ بِما لاتَعلَقُ السُمُرُ",2,"ر",1,0],["فألْبَستموني ظِلَّ نُعْمى كأنني","أُجاوِرُ رِبْعياً من الرّوضِ أغْيَدا",3,"د",2,0],["فَالْبَسْ نَسِيجَةَ مَا قَدَّمْتَ مَعْلَمَةً","مِنْ صَنْعَةِ الْيُمْنِ تُنْسِي صَنْعَةَ الْيَمَنِ",4,"ن",1,0],["فألْبَسْتَ هذا حُلّةَ المُلْكِ والغِنى","وألْبَسْتَ هذا شَمْلَةَ النُّسْكِ والزُّهْدِ",5,"د",1,0],["فَالبَدرُ في أَعلى مَداراتِهِ","لِلعَينِ يَبدو وَجهُهُ في الغَدير",6,"ر",1,0],["فَالبيضُ تَصدَأُ في الجُفونِ إِذا ثَوَت","وَالماءُ يَأسُنُ إِن أَقامَ طَويلا",7,"ل",2,0],["فَاِلبَسِ الصَنعَ مُلاءً","وَاسحَبِ السَعدَ رِداءَ",8,"ا",2,0],["فالبدر دونك في عُلاّ وإنارةٍ","والبحر دونك في ندى وتكرمِ",9,"م",1,0],["فالبغض يُبدي كُدُوراً في الصفاء كما","أن المحبة تبدي الصفوَ في الكدر",10,"ر",1,0],["فالبيتُ يدعى عامِراً والمجدُ يد","عى ثابِتاً والمالُ يدعى السائِبا",11,"ب",2,0],["فألبسني ثوبَ الولاءَ معتَّقاً","وألبسته ثوبَ الثناءِ محرَّرا",12,"ر",2,0],["فالبرّ والبحر ذا بالأمن منبسطٌ","وذاك من خجلٍ بالجودِ مرجوف",13,"ف",1,0],["فالبحر يزبد من غيظٍ يخامره","والبرق يضحك من عجز الحيا الهامي",14,"م",2,0],["فالبس العفو والمُعافاة ثوباً","وعلى الكارهينَ ذاكَ العَفاءُ",15,"ف",3,0],["فالْبَرُّ يَهْلِكُ في مضيقِ فنائه","والبحرُ يغرَقُ منه في الضَّحْضَاحِ",16,"ح",1,0],["فالباكرون على ثَنائِك إنَّما","بَكَرُوا وما شَعَرُوا على مِسْبَاحِ",16,"ح",1,0],["فالبَس العيد وانْضُه سالم النف","سِ وإن لم تسلم ثراءً ووَفْرا",17,"ر",2,0],["فالبسوها وامنحونا فضلها","يا بني كل رئيس لرئيس",18,"س",1,0],["فالبسوا خِلعتي تملَّيْتُموها","في اعتلاءٍ وضِدُّكم في انخفاض",19,"ض",1,0],["فالبس العمر سابغاً ومُعادي","ك حضيض وأنت عالٍ حظيظ",20,"ظ",1,0],["فالبَسه ما لبس الحمام حليَّه","في الأيك من وشح ومن أطواق",21,"ق",1,0],["فالبس اليأس من الرج","عى وطالب بالصَداق",22,"ق",1,0],["فالبخلُ جُبنٌ والسماحُ شجاعةٌ","لا شكَّ حين تُصحِّحُ التحصيلا",23,"ل",2,0],["فالْبَسِ العيدَ سعيداً","وأعاديك رِغامُ",24,"م",1,0],["فالبَسْ وألبِسْ فإنَّ الثوبَ تلبِسُهُ","زَيْنٌ على النفسِ لا ثِقلٌ على البدنِ",25,"ن",1,0],["فالبشرُ بالبدء الهنِيِّ مبشِّرٌ","والبدء بالعَود السنِيِّ رهين",26,"ن",1,0],["فَاِلبِس لَها ماءَ الحَديدِ مَطارِقاً","وَاِجعَل لِسانَكَ مَخلِباً أَو نابا",27,"ب",2,0],["فَالبيضُ تَأخُذُ مِنهُم كَيفَما اِنفَتَلَت","وَالذُعرُ يُمعِنُ فيهِم كَيفَما اِنفَتَلوا",28,"ل",3,0],["فَالبَحرُ يَعظُمُ وَهوَ مُجتَمِعٌ","وَتَراهُ أَهوَنَ ما يُرى دِيَما",29,"م",2,0],["فَاِلبَس خَليعَكَ فَهوَ خَي","رٌ مِن جَديدِ العارِيَه",30,"ي",2,0],["فَالبَرُّ مَشدودُ الزَواحِلِ مُحدَجٌ","وَالبَحرُ مَمدودُ الشِراعِ مُوَسَّقُ",31,"ق",1,0],["فَالبَدرُ يَنظُرُ مِن نَوافِذِ مَنزِلٍ","وَالشَمسُ ثَمَّ مُطِلَّةٌ مِن دارِ",32,"ر",1,0],["فأَلبسَ القِدحَ وحفَاً من قوادِمِهِ","لمَّا تطايرَ رامٍ من بني ثُعَلِ",33,"ل",1,0],["فالبيضُ لولا رأيُهُ زُبَرٌ","والسُّمْرُ لولا عَزْمُه قَصَبُ",34,"ب",1,0],["فَالبِرُّ أَجمَعُ في ابتِهالِكَ داعِياً","لِلمُسلِمينَ وَنُسكِكَ المُتَقَبَّلِ",35,"ل",1,0],["فألبس منها جنة حين انتشى","وأخلعها بالكره حين أفيق",36,"ق",1,0],["فأَلبسَني جِزعاه حُلَّةَ جازِعٍ","وجَرَّعَني ماءَ الغَرامِ أجارِعُه",37,"ع",2,0],["فأَلبَسْتَ الخِلافةَ ثَوْبَ عِزٍّ","غداةَ لَبِستَ قَسْطَلَةَ الجِيادِ",38,"د",1,0],["فأُلِبسُ خيلَ الوغَى راحةً","وأُتعِبُ في اللَّهوِ خيلَ المِراحِ",39,"ح",1,0],["فالبَسِ البُردَ الذي منه ضَفا","وادخلِ البابَ الذي منه انفَتح",40,"ح",1,0],["فَاِلبَسِ الناسَ ما اِستَطَعتَ عَلى الصَب","رِ وَإِلّا لَم تَستَقِم لَكَ خُلَّه",41,"ل",2,0],["فَالبيضُ لَو لا زَمَت أَغمادَها صَدِئَت","وَالشَمسُ لَو لَم تَسِر ما حَلَّتِ الحَمَلا",42,"ل",2,0],["فَالبَحرُ تَنشَأُ مِنهُ كُلُّ سَحابَةٍ","صَدرَت وَيَقبَلُ فاضِلَ الغُدرانِ",43,"ن",1,0],["فَالبَحرُ أَولى في القِياسِ مِنَ الثَرى","بِجِوارِ تِلكَ الدُرَّةِ الغَرّاءِ",44,"ا",2,0],["فَأَلبَسَ عِرضَهُ دِرعاً حَصيناً","وَصَيَّرَ جِسمَهُ غَرَضَ النِبالِ",45,"ل",1,0],["فَاِلبَس ثِيابَ فَضائِحٍ أَسدَيتَها","أَشراً وَأَلحَمَها أَخوكَ البارِدُ",46,"د",1,0],["فَالبَذُّ أَغبَرُ دارِسُ الأَطلالِ","لِيَدِ الرَدى أُكُلٌ مِنَ الآكالِ",47,"ل",1,0],["فَاِلبَس بِهِ مِثلَها لِمِثلِكَ مِن","فَضفاضِ ثَوبِ القَريضِ مُتَّسَعِه",48,"ع",2,0],["فَأَلبَسَني مِن أُمَّهاتِ تِلادِهِ","وَأَلبَستُهُ مِن أُمَّهاتِ قَلائِدي",49,"د",2,0],["فَالْبُخْلُ وَالْجُبْنُ فِي الإِنْسَانِ مَنْقَصَةٌ","لَمْ يَجْنِهَا غَيْرُ سُوءِ الظَّنِّ بِاللَّهِ",50,"ه",1,0],["فَالْبَدْرُ أَكْدَرُ وَالسَّمَاءُ مَرِيضَةٌ","وَالْبَحْرُ أَشْكَلُ وَالرِّمَاحُ دَوَانِي",51,"ي",1,0],["فَأَلْبَسَتْ يَاسَمِينَ الْخَدِّ خَجْلَتُهُ","وَرْدَاً جَنِيَّاً جَنَاهُ رَائِدُ الْمُقَلِ",52,"ل",1,0],["فالبيتُ محتاجٌ إلى حائطٍ","والمالُ محتاجٌ إلى حائطهْ",53,"ه",1,0],["فَاِلبَس بِها خِلعَةً لِلمَجدِ ضافِيَةٍ","طَويلَ باعِ العُلى وَالعَمِّ وَالخالِ",54,"ل",1,0],["فَاِلبَس رِداءَ اِمتِداحِ","وَجَرِّرِ الذَيلَ وَاِفخَر",55,"ر",1,0],["فَالبَحرُ لا يُروي بِكَثرَةِ مائِهِ","ظَمَأً وَرُبَّ غَمامَةٍ تُحيِي الثَرى",56,"ر",2,0],["فَالبَحرُ لا يُروي بِكَثرَةِ مائِهِ","ظَمَأً وَرُبَّ غَمامَةٍ تَروي الثَرى",57,"ر",2,0],["فَالبئرُ مُوحِشَةٌ فَسِدرَتُها","فَهِضابَها الشَرقيَّةُ الحُمرُ",58,"ر",1,0],["فالبَتيَّاتِ فالحِرازِ فَتُبتي","ت َفشُبْرا البَيُّومِ فالخَمَّارَهْ",59,"ر",2,0],["فالبأس في حَمْس الوغى لكُماتها","والكبرياءُ لهُنّ والخُيلاء",60,"ا",2,0],["فَالبَحرُ أَصبَحَ هَمّي","وَالبَحرُ أَشهى وَأَطيَب",61,"ب",1,0],["فَالبَهوُ مُشتَمِلٌ بِبَدرِ خِلافَةٍ","لَبِسَ الشَبابَ بِنورِهِ الإِسلامُ",62,"م",1,0],["فَاِلبِسِ الناسَ عَلى الصِح","حَةِ مِنهُم وَالسَقامِ",63,"م",1,0],["فالبحرُ أصبحَ شأني","والبحرُ أشهى وأطيب",64,"ب",1,0],["فَاِلبَث وَحيداً لا وَصي","فَةَ في ذَراكَ وَلا وَصيفُ",65,"ف",1,0],["فَالبُعدُ للعَيشِ أَدّاني إِلى تَلَفٍ","وَلِلشَبيبَةِ قادَتني إِلى الهَرَمِ",66,"م",1,0],["فَأَلْبَسَتْ حُلَلَ المَوشِيِّ زَهْرَتها","وَجَلَّلتْها بِأَنْماطِ الدَّيابِيجِ",67,"ج",1,0],["فأَلبسونيَ عزاً","والعز خير لباس",68,"س",1,0],["فالبَحر يطغى لمد","والمد يعقب جزرا",69,"ر",2,0],["فَاِلبَسي اليَومَ مِن ثَنائِيَ عِقداً","تَشتَهيهِ مِنَ الحِسانِ النُ