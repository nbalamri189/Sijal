{"poems":[[63,"لك ما يروقه الغمام الهاطل","https://www.aldiwan.net/poem46192.html","الكامل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[86,"لمحت من مصر ذاك التاج والقمرا","https://www.aldiwan.net/poem68954.html","البسيط"],[93,"ألشعر من مبدأ الخلق","https://www.aldiwan.net/poem11098.html","المجتث"],[93,"سلام باك أسيف","https://www.aldiwan.net/poem11362.html","المجتث"],[93,"أمات أولئك الجند الكرام","https://www.aldiwan.net/poem11420.html","الوافر"],[88,"هي المواطن أدنيها وتقصيني","https://www.aldiwan.net/poem44815.html","البسيط"],[23,"هل تعرف الدار عفا رسمها","https://www.aldiwan.net/poem21428.html","السريع"],[64,"وكان فؤادي خاليا قبل حبكم","https://www.aldiwan.net/poem67569.html","الطويل"],[51,"ما مدمعي حذر النوى بقريح","https://www.aldiwan.net/poem9403.html","الكامل"],[51,"فطر توسط يومه الأسبوعا","https://www.aldiwan.net/poem65383.html","الكامل"],[91,"أروي لكمعن شاعر ساحير","https://www.aldiwan.net/poem62815.html","عموديه"],[78,"وعدت وأخلفتني الموعدا","https://www.aldiwan.net/poem14175.html","المتقارب"],[89,"في الفن معنى حسنه لا يعرف","https://www.aldiwan.net/poem44754.html","الكامل"],[89,"البحر يغلى كان البحر بركان","https://www.aldiwan.net/poem44779.html","البسيط"],[89,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[89,"كذب الرجاء فما نجيب يرجع","https://www.aldiwan.net/poem44935.html","الكامل"],[85,"بيتكمو أبا لهب","https://www.aldiwan.net/poem7133.html","مجزوء الرجز"],[85,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[85,"خليفة ما جاء حتى ذهبا","https://www.aldiwan.net/poem7913.html","الرجز"],[85,"كان لبعض الناس ببغاء","https://www.aldiwan.net/poem8011.html","الرجز"],[85,"أتى نبي الله يوما ثعلب","https://www.aldiwan.net/poem8019.html","الرجز"],[85,"الدب معروف بسوء الظن","https://www.aldiwan.net/poem8022.html","الرجز"],[85,"يحكون أن أمة الأرانب","https://www.aldiwan.net/poem8038.html","الرجز"],[85,"يقال كانت فأرة الغيطان","https://www.aldiwan.net/poem8045.html","الرجز"],[45,"طفقت تلوم ولات حين ملامه","https://www.aldiwan.net/poem65666.html","الطويل"],[45,"عن أي ثغر تبتسم","https://www.aldiwan.net/poem65669.html","مجزوء الكامل"],[28,"وبواضح رتل تشف غروبه","https://www.aldiwan.net/poem5543.html","الكامل"],[61,"من ذم إدريس في قيادته","https://www.aldiwan.net/poem51594.html","المنسرح"],[61,"هات التي هي يوم البعث أوزار","https://www.aldiwan.net/poem51637.html","البسيط"],[44,"يا برق طالع منزلا بالأبرق","https://www.aldiwan.net/poem30397.html","الكامل"],[69,"يا بن أخينا أقمتنا أبدا","https://www.aldiwan.net/poem28602.html","المنسرح"],[31,"ضاق الغداة بحاجتي صدري","https://www.aldiwan.net/poem42515.html","الكامل"],[105,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"إن الفراق دعا الخليط فزالا","https://www.aldiwan.net/poem26731.html","الكامل"],[52,"ولقد غدوت على طمر","https://www.aldiwan.net/poem27191.html","مجزوء الكامل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[48,"يا صاحبي عصيت مصطبحا","https://www.aldiwan.net/poem62500.html","الكامل"],[48,"يا قلب ويحك جد منك ذا الكلف","https://www.aldiwan.net/poem64400.html","البسيط"],[46,"عجبت للمرء إذ يسقي حليلته","https://www.aldiwan.net/poem22296.html","البسيط"],[46,"أفطر وصم وأفطر خائفا","https://www.aldiwan.net/poem22569.html","الكامل"],[46,"هذي القضايا فمن يطاولها","https://www.aldiwan.net/poem23461.html","المنسرح"],[8,"وكأن فاها بات مغتبقا","https://www.aldiwan.net/poem21792.html","أحذ الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54879","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54636","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43720","السريع"],[100,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[46,"عجِبتُ للمرْءِ، إذ يَسْقي حليلَتَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=18286",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[94,"جمرة الدنيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66291&r=&rc=9",""],[132,"أدينك أن تذمى الخيزرانا","https://www.aldiwan.net/poem54721.html","الوافر"],[132,"دمن الأحبة لو عصيت العاذلا","https://www.aldiwan.net/poem54777.html","الكامل"],[167,"تغير الفتح","https://www.aldiwan.net/poem1071.html",""],[199,"بليت بهذا الحب أحمله وحدي","https://www.aldiwan.net/poem45224.html","الطويل"],[199,"كفى صدودا فما أبقى تجافينا","https://www.aldiwan.net/poem45565.html","البسيط"],[223,"غلواء ما أحلى المعطارا","https://www.aldiwan.net/poem39711.html","الرجز"],[223,"وما سرى في مقاصير اللظى خبر","https://www.aldiwan.net/poem41466.html","البسيط"],[271,"بالابرق الفرد اطلال قديمات","https://www.aldiwan.net/poem52092.html","البسيط"],[287,"وكأن فاها كلما نبهتها","https://www.aldiwan.net/poem1898.html","الكامل"],[304,"يا سعد راح الوفى واهل وراح الجميل","https://www.aldiwan.net/poem16843.html","البسيط"],[371,"قال أبوك ما فعل","https://www.aldiwan.net/poem57182.html","مجزوء الرجز"],[380,"منع القرار متيم","https://www.aldiwan.net/poem49236.html","مجزوء الكامل"],[403,"تبين ثغر الفجر لما تبسما","https://www.aldiwan.net/poem33450.html","الطويل"],[422,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[432,"أبعد شيبي لشبابي إياب","https://www.aldiwan.net/poem12559.html","السريع"],[439,"إقبال جدك للإسلام إقبال","https://www.aldiwan.net/poem34829.html","البسيط"],[443,"وذات حسن وقدر","https://www.aldiwan.net/poem56001.html","عموديه"],[458,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[458,"أَستنجِد الصبر فيكم وهو مغلوب","https://www.aldiwan.net/poem56300.html","البسيط"],[464,"ومشمر للحرب عن أذياله","https://www.aldiwan.net/poem3448.html","عموديه"],[477,"برق على الجزع بدا يلمع","https://www.aldiwan.net/poem15226.html","السريع"],[477,"خاطبت بعدكم الأطلال والدمنا","https://www.aldiwan.net/poem15328.html","البسيط"],[500,"طراز سر له في سمك قبته","https://www.aldiwan.net/poem38081.html","البسيط"],[513,"وقد كان يسبي القلب في كل ليلة","https://www.aldiwan.net/poem67769.html","الطويل"],[551,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[551,"ناد امرءا غيب خلف النقا","https://www.aldiwan.net/poem48119.html","السريع"],[558,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"تظنني قد بت محموما","https://www.aldiwan.net/poem2803.html","السريع"],[575,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"]],"verses":[["وكأنّ فاها بعدَما نَشَرَ الدُّجى","فَرْعاً يَلوحُ بهِ الخِضابُ النّاصِلُ",0,"ل",1,0],["وَكَأَنَّ فارَةَ تاجِرٍ بِقَسيمَةٍ","سَبَقَت عَوارِضَها إِلَيكَ مِنَ الفَمِ",1,"م",1,0],["وَكانَ فارِسُهُم في الحَربِ صاعِقَةً","وَذو السِياسَةِ مِنهُم طائِراً حَذِرا",2,"ر",2,0],["وَكَانَ فِي كُلِّ جِيلٍ","مقَامُهُ مَرْعِيَّا",3,"ي",2,0],["وَكَانَ فِي التَّجْر","حَيِّ الضَّمِيرِ غَيْرَ مُلِيمِ",4,"م",1,0],["وَكَانَ فَتىً لَهُ سِيمَا زَعِيمٍ","يُنْكِّرُهُ التَّفَرُّدُ وَالظَّلاَمُ",5,"م",1,0],["وكان فيها ابن جبر لا يُقصر في","جبر انكسار غريب الدار محزون",6,"ن",1,0],["وَكانَ في الإِسلامِ ذا تُدرَءٍ","لَم يَكُ بِالواني وَلا الخاذِلِ",7,"ل",1,0],["وَكانَ فُؤادي خالِياً قَبلَ حُبِّكُم","وَكانَ بِذِكرِ الخَلقِ يَلهو وَيَمزحُ",8,"ح",1,1],["وكأنَّ فيهِ أرْيَحِيَّةَ نَشْوَةٍ","من قهْوَةٍ تُرْخي الإِزارَ قَدِيحِ",9,"ح",1,0],["وكأن فيه من فعالك سندساً","وكأن فيه من الرياض قطوعا",10,"ع",2,0],["وَكانَ في الشَربِ فَتىً باسِلٌ","طَلعَتُهُ تُسحِرُ رائيها",11,"ي",3,0],["وَكانَ فِعالُكَ قَبلَ المَقال","فَماذا عَدا الآن فيما بَدا",12,"د",2,0],["وكأن في الشيخ الرقاد طريدة","وكأن فيه الهم جيش يزحف",13,"ف",1,0],["وكان في ساحل الدأماء منتصباً","شخص تبين في عينيه اشجان",14,"ن",1,0],["وكأن في القوم النفا","ق الى بلوغ الجاه جسر",15,"ر",1,0],["وكان في لحمي وجلدي والحشا","والعظم يا أمي أراقمَ تلسع",16,"ع",1,0],["وكان في ليلته","مقرِّبا من اقترب",17,"ب",1,0],["وَكانَ في أَولِها لِلطالب","عَلى قَنا المَنصور عِزُّ الغالِبِ",18,"ب",1,0],["وَكانَ في الشَرع شِراعَ الأَمّه","وَفي الحَديث مُستَقى الأَئمّه",19,"ه",1,0],["وَكانَ في المَنزِلِ كَلبٌ عالي","أَرخَصَهُ وُجودُ هَذا الغالي",20,"ي",1,0],["وَكانَ في المَجلِسِ ذاكَ الأَرنَبُ","يَسمَعُ ما يُبدي هُناكَ الثَعلَبُ",21,"ب",1,0],["وَكانَ في صاحِبِنا بَعضُ الرَمَق","إِذ جاءَهُ المَوتُ بَطيئاً في الغَرَق",22,"ق",1,0],["وَكانَ فيهِم أَرنَبٌ لَبيبُ","أَذهَبَ جُلَّ صوفِهِ التَجريبُ",23,"ب",1,0],["وَكانَ في الثالِثَةِ اِبنُ الفارَه","قَد أَخلَفَ العادَةَ في الزِيارَه",24,"ه",1,0],["وَكَأَنَّ فارِسَهُ وَراءَ قَذالِهِ","رِدفٌ فَلَستَ تَراهُ مِن قُدّامِهِ",25,"م",2,0],["وَكَأَنَّ في جِسمي الَّذي","في ناظِرَيهِ مِنَ السَقَم",26,"م",1,0],["وَكَأَنَّ فَأرَةَ تاجِرٍ هِندِيَّةً","سَبَقَت إِلَيَّ حَديثِ فيكِ مِنَ الفَمِ",27,"م",1,0],["وكانَ في سِرعَةِ المَجئ بهِ","آصفَ في حَمْلِ عَرشِ بَلقيسِ",28,"س",1,0],["وكانَ في خِلَعٍ خُضْرٍ فقد خُلِعَت","إلا عُرىً أُغْفِلَتْ منه وأزرارُ",29,"ر",1,0],["وَكَأَنَّ فارِسَهُ يُصَرِّفُ إِذ بَدا","في مَتنِهِ اِبناً لِلصَباحِ الأَبلَقِ",30,"ق",1,0],["وكان في نيَّتي أجهزها","بنسخةٍ لا يعيبُها الناقدْ",31,"د",1,0],["وَكَأَنَّ فاهاً عِندَ رَقَدَتِها","تَجري عَلَيهِ سُلافَةُ الخَمرِ",32,"ر",1,0],["وكأنّ في كَبِدِي وبين جَوانِحي","ناراً مُؤجَّجَةً تجيشُ وتَهْدِرُ",33,"ر",1,0],["وَكانَ في دِجلَةَ أَلفُ ماخِر","لَم يَعنِها إِلّا جَناحُ طائِر",34,"ر",1,0],["وَكَأَنَّ في الحَداجِ يَومَ تَرَحَّلوا","آرامَ سِدرٍ قَد لَبِسنَ ظِلالا",35,"ل",2,0],["وَكَأَنَّ في أَخلاقِهِ","خُلُقاً مِنَ الكَرَماتِ",36,"ت",1,0],["وكان في الغرْبِ داءٌ فاتّقَاكَ لَهُ","برأسِ كلِّ فلانٍ في العِدى وفُل",37,"ل",1,0],["وَكَأَنَّ فيها مِن جَنادِبِها","فَرَساً إِذا سَكَّنتَهُ رَمَحا",38,"ح",2,0],["وَكانَ في الحَقِّ أَن يَهواكَ مُجتَهِداً","كَذاكَ خَبَّرَ مِنّا الغابِرُ السَلَفُ",39,"ف",1,0],["وَكانَ في لَفظِها عَيٌّ فَأَيَّدَهُ","فَلَم تُخَبِّرهُ عَن شَيٍّ بِإِفصاحِ",40,"ح",1,0],["وَكَأَنَّ في كَفِّ الزَمانِ بِنَورِهِ","قُطُراً تُعَمُّ بِنَشرِهِ الأَقطارُ",41,"ر",1,0],["وَكانَ في طَيِّئٍ وَإِخوَتِها","مَطاعِمٌ لا يُرَدُّ راشِنُها",42,"ن",3,0],["وَكَأَنَّ فاهاً باتَ مُغتَبِقاً","بَعدَ الكَرى مِن طيِّبِ الخَمرِ",43,"ر",1,1],["وكانَ في آخِرِ هذا العامِ","نَكْبُ أَبي العبَّاسِ بالإسلامِ",44,"م",1,0],["وكانَ فيها لك النا","س في أليم انتظار",45,"ر",1,0],["وكان في جُرح الهوى بلسما","وكان عندي منحة من إله",46,"ه",1,0],["وكان فيها للرسول شيعهْ","وعصبةٌ سامعةٌ مطيعهْ",47,"ه",1,0],["وكان في دين الجدود صلبا","لا يأتلي الدين الجديد ثلبا",48,"ب",2,0],["وكان في الإسكندرية الملا","أملك في سلطانهم وأكملا",49,"ل",2,0],["وكان في فروق سلطان البيع","تعنوا له في سائر الأرض الشّيع",49,"ع",1,0],["وَكانَ فِي إِحْدَى الكُوَى طَائِرٌ","قَدْ أَوْدَعُوهُ قَفَصاً مُقْفِرا",50,"ر",2,0],["وَكَانَ فِي آجَرِ الأَيَّامِ مَطْمَعُهُ","أنْ تَسْتَدِيمَ لَهُ فِي قَوْمِهِ عَقَبَا",51,"ب",2,0],["وَكَانَ فِي أَوْلِيَاءِ العَدْلِ مَفْخَرةً","لا يَلْتَوِي رُغْباً أَوْ يَنْثَنِي رَهَبَا",51,"ب",2,0],["وَكَانَ فِي مَوْقِفِ الفَخْرِ الجَدِيرِ بِهِ","مَا يَدَّعِي حَسَباً أَوْ يَدَّعِي نَسَبَا",51,"ب",2,0],["وَكانَ فيهِ عَجَبُ أَنَّهُ","عَلَّمَ مَن أَدَّبَهُ الضَبطا",52,"ط",2,0],["وكان فيه كمولود على رغد","أنهى رضاعته التشريد والشطف",53,"ف",1,0],["وكان في لفظِها عَيٌّ فأيّده","، فلم تُخبّره عن شيءٍ بإفصاح",54,"ح",1,0],["وَكَانَ فَتىً طَلْقُ المُحَيَّا جَمِيلُهُ","وَلَكِنَّهُ نَذْلُ الفُؤَادِ ذَلِيلُه",55,"ه",1,0],["وكأنّ فتحا من فتوح أميّة","حملت بشائره الجياد السبّق",56,"ق",1,0],["وَكانُ فُلاَنُ أحسَنُ قَبلُ صَوتاً","من القَينَاتِ تَجتَذِبُ الكِرَانَا",57,"ن",2,0],["وَكَأنَّ في أنيَابِهِنَّ عَلَى الكَرَى","عَسَلاً وفي نَكَهَاتِهِنّ