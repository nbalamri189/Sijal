https://poetry.dctabudhabi.ae/diwan/poem/81947","البسيط"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62099","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141655","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120510","المجتث"],[4679,"أيدري الدهر ما فعلت يداه","https://www.poetsgate.com/ViewPoem.aspx?id=142734",""],[4814,"إلى والدي","https://www.poetsgate.com/ViewPoem.aspx?id=196634",""],[5038,"دعي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=189377",""],[5038,"النحر الخضيب","https://www.poetsgate.com/ViewPoem.aspx?id=196698",""],[585,"يا أيها القلم انهض إن سواك كبا","https://www.poetsgate.com/ViewPoem.aspx?id=161888",""],[5145,"رحلوا بقلبك عرّجوا أم ساروا","https://www.poetsgate.com/ViewPoem.aspx?id=108063",""],[5268,"رصيفُ الجامِعَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=206995",""],[5312,"الحكمُ للهِ كلٌّ غيرُه فاني","https://www.poetsgate.com/ViewPoem.aspx?id=128473",""],[5376,"قولوا لها .....يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=188269",""],[5376,"ويل الذي عن قدسنا أقصانا","https://www.poetsgate.com/ViewPoem.aspx?id=191876",""],[5409,"للحر بطن الأرض أجدى","https://www.poetsgate.com/ViewPoem.aspx?id=155492",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5431,"وكأنّ في العينين حانته...","https://www.poetsgate.com/ViewPoem.aspx?id=199679",""],[709,"وردت عن تراقيها العقودُ عنِ النّحرِ","https://www.poetsgate.com/ViewPoem.aspx?id=2900",""],[5497,"ألفة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=211698",""],[5582,"ما بالُ قَلْبِكَ زادَ فِي وَلْوالِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63554",""],[5582,"زُرْ مَنْزِلاً قاضَكَ البُرْحا وَأَوْلاكَا","https://www.poetsgate.com/ViewPoem.aspx?id=63548",""],[5582,"قِفْ بِالدِّيارِ دِيارِ الحَيِّ مِنْ إِضَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=63571",""],[5616,"شيخوخة","https://www.poetsgate.com/ViewPoem.aspx?id=203235",""],[5725,"يا ليل شعري","https://www.poetsgate.com/ViewPoem.aspx?id=214904",""],[402,"ماذا أصاب أباك الشيخ واحربا","https://www.poetsgate.com/ViewPoem.aspx?id=35348",""],[5786,"بريقٌ أضا بالغَضَا مُوهِن","https://www.poetsgate.com/ViewPoem.aspx?id=50653",""],[3512,"جرى الحبُّ منّي مجرى النَّفس","https://www.poetsgate.com/ViewPoem.aspx?id=12591",""],[6124,"ما لقلبك","https://www.poetsgate.com/ViewPoem.aspx?id=201228",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[469,"من لي بقاسي القلب ليس يزول من","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574795",""],[6178,"مرافي محطمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85529&r=&rc=5",""],[6337,"واهاً لسحركِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81412&r=&rc=24",""],[6341,"طواف الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87287&r=&rc=16",""],[6366,"ما لم يقله الرّسّام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86676&r=&rc=4",""]],"verses":[["وكأنّ فاها بعدَما نَشَرَ الدُّجى","فَرْعاً يَلوحُ بهِ الخِضابُ النّاصِلُ",0,"ل",1,0],["وَكَأَنَّ فارَةَ تاجِرٍ بِقَسيمَةٍ","سَبَقَت عَوارِضَها إِلَيكَ مِنَ الفَمِ",1,"م",1,0],["وَكانَ فارِسُهُم في الحَربِ صاعِقَةً","وَذو السِياسَةِ مِنهُم طائِراً حَذِرا",2,"ر",2,0],["وَكَانَ فِي كُلِّ جِيلٍ","مقَامُهُ مَرْعِيَّا",3,"ي",2,0],["وَكَانَ فِي التَّجْر","حَيِّ الضَّمِيرِ غَيْرَ مُلِيمِ",4,"م",1,0],["وَكَانَ فَتىً لَهُ سِيمَا زَعِيمٍ","يُنْكِّرُهُ التَّفَرُّدُ وَالظَّلاَمُ",5,"م",1,0],["وكان فيها ابن جبر لا يُقصر في","جبر انكسار غريب الدار محزون",6,"ن",1,0],["وَكانَ في الإِسلامِ ذا تُدرَءٍ","لَم يَكُ بِالواني وَلا الخاذِلِ",7,"ل",1,0],["وَكانَ فُؤادي خالِياً قَبلَ حُبِّكُم","وَكانَ بِذِكرِ الخَلقِ يَلهو وَيَمزحُ",8,"ح",1,1],["وكأنَّ فيهِ أرْيَحِيَّةَ نَشْوَةٍ","من قهْوَةٍ تُرْخي الإِزارَ قَدِيحِ",9,"ح",1,0],["وكأن فيه من فعالك سندساً","وكأن فيه من الرياض قطوعا",10,"ع",2,0],["وَكانَ في الشَربِ فَتىً باسِلٌ","طَلعَتُهُ تُسحِرُ رائيها",11,"ي",3,0],["وَكانَ فِعالُكَ قَبلَ المَقال","فَماذا عَدا الآن فيما بَدا",12,"د",2,0],["وكأن في الشيخ الرقاد طريدة","وكأن فيه الهم جيش يزحف",13,"ف",1,0],["وكان في ساحل الدأماء منتصباً","شخص تبين في عينيه اشجان",14,"ن",1,0],["وكأن في القوم النفا","ق الى بلوغ الجاه جسر",15,"ر",1,0],["وكان في لحمي وجلدي والحشا","والعظم يا أمي أراقمَ تلسع",16,"ع",1,0],["وكان في ليلته","مقرِّبا من اقترب",17,"ب",1,0],["وَكانَ في أَولِها لِلطالب","عَلى قَنا المَنصور عِزُّ الغالِبِ",18,"ب",1,0],["وَكانَ في الشَرع شِراعَ الأَمّه","وَفي الحَديث مُستَقى الأَئمّه",19,"ه",1,0],["وَكانَ في المَنزِلِ كَلبٌ عالي","أَرخَصَهُ وُجودُ هَذا الغالي",20,"ي",1,0],["وَكانَ في المَجلِسِ ذاكَ الأَرنَبُ","يَسمَعُ ما يُبدي هُناكَ الثَعلَبُ",21,"ب",1,0],["وَكانَ في صاحِبِنا بَعضُ الرَمَق","إِذ جاءَهُ المَوتُ بَطيئاً في الغَرَق",22,"ق",1,0],["وَكانَ فيهِم أَرنَبٌ لَبيبُ","أَذهَبَ جُلَّ صوفِهِ التَجريبُ",23,"ب",1,0],["وَكانَ في الثالِثَةِ اِبنُ الفارَه","قَد أَخلَفَ العادَةَ في الزِيارَه",24,"ه",1,0],["وَكَأَنَّ فارِسَهُ وَراءَ قَذالِهِ","رِدفٌ فَلَستَ تَراهُ مِن قُدّامِهِ",25,"م",2,0],["وَكَأَنَّ في جِسمي الَّذي","في ناظِرَيهِ مِنَ السَقَم",26,"م",1,0],["وَكَأَنَّ فَأرَةَ تاجِرٍ هِندِيَّةً","سَبَقَت إِلَيَّ حَديثِ فيكِ مِنَ الفَمِ",27,"م",1,0],["وكانَ في سِرعَةِ المَجئ بهِ","آصفَ في حَمْلِ عَرشِ بَلقيسِ",28,"س",1,0],["وكانَ في خِلَعٍ خُضْرٍ فقد خُلِعَت","إلا عُرىً أُغْفِلَتْ منه وأزرارُ",29,"ر",1,0],["وَكَأَنَّ فارِسَهُ يُصَرِّفُ إِذ بَدا","في مَتنِهِ اِبناً لِلصَباحِ الأَبلَقِ",30,"ق",1,0],["وكان في نيَّتي أجهزها","بنسخةٍ لا يعيبُها الناقدْ",31,"د",1,0],["وَكَأَنَّ فاهاً عِندَ رَقَدَتِها","تَجري عَلَيهِ سُلافَةُ الخَمرِ",32,"ر",1,0],["وكأنّ في كَبِدِي وبين جَوانِحي","ناراً مُؤجَّجَةً تجيشُ وتَهْدِرُ",33,"ر",1,0],["وَكانَ في دِجلَةَ أَلفُ ماخِر","لَم يَعنِها إِلّا جَناحُ طائِر",34,"ر",1,0],["وَكَأَنَّ في الحَداجِ يَومَ تَرَحَّلوا","آرامَ سِدرٍ قَد لَبِسنَ ظِلالا",35,"ل",2,0],["وَكَأَنَّ في أَخلاقِهِ","خُلُقاً مِنَ الكَرَماتِ",36,"ت",1,0],["وكان في الغرْبِ داءٌ فاتّقَاكَ لَهُ","برأسِ كلِّ فلانٍ في العِدى وفُل",37,"ل",1,0],["وَكَأَنَّ فيها مِن جَنادِبِها","فَرَساً إِذا سَكَّنتَهُ رَمَحا",38,"ح",2,0],["وَكانَ في الحَقِّ أَن يَهواكَ مُجتَهِداً","كَذاكَ خَبَّرَ مِنّا الغابِرُ السَلَفُ",39,"ف",1,0],["وَكانَ في لَفظِها عَيٌّ فَأَيَّدَهُ","فَلَم تُخَبِّرهُ عَن شَيٍّ بِإِفصاحِ",40,"ح",1,0],["وَكَأَنَّ في كَفِّ الزَمانِ بِنَورِهِ","قُطُراً تُعَمُّ بِنَشرِهِ الأَقطارُ",41,"ر",1,0],["وَكانَ في طَيِّئٍ وَإِخوَتِها","مَطاعِمٌ لا يُرَدُّ راشِنُها",42,"ن",3,0],["وَكَأَنَّ فاهاً باتَ مُغتَبِقاً","بَعدَ الكَرى مِن طيِّبِ الخَمرِ",43,"ر",1,1],["وكانَ في آخِرِ هذا العامِ","نَكْبُ أَبي العبَّاسِ بالإسلامِ",44,"م",1,0],["وكانَ فيها لك النا","س في أليم انتظار",45,"ر",1,0],["وكان في جُرح الهوى بلسما","وكان عندي منحة من إله",46,"ه",1,0],["وكان فيها للرسول شيعهْ","وعصبةٌ سامعةٌ مطيعهْ",47,"ه",1,0],["وكان في دين الجدود صلبا","لا يأتلي الدين الجديد ثلبا",48,"ب",2,0],["وكان في الإسكندرية الملا","أملك في سلطانهم وأكملا",49,"ل",2,0],["وكان في فروق سلطان البيع","تعنوا له في سائر الأرض الشّيع",49,"ع",1,0],["وَكانَ فِي إِحْدَى الكُوَى طَائِرٌ","قَدْ أَوْدَعُوهُ قَفَصاً مُقْفِرا",50,"ر",2,0],["وَكَانَ فِي آجَرِ الأَيَّامِ مَطْمَعُهُ","أنْ تَسْتَدِيمَ لَهُ فِي قَوْمِهِ عَقَبَا",51,"ب",2,0],["وَكَانَ فِي أَوْلِيَاءِ العَدْلِ مَفْخَرةً","لا يَلْتَوِي رُغْباً أَوْ يَنْثَنِي رَهَبَا",51,"ب",2,0],["وَكَانَ فِي مَوْقِفِ الفَخْرِ الجَدِيرِ بِهِ","مَا يَدَّعِي حَسَباً أَوْ يَدَّعِي نَسَبَا",51,"ب",2,0],["وَكانَ فيهِ عَجَبُ أَنَّهُ","عَلَّمَ مَن أَدَّبَهُ الضَبطا",52,"ط",2,0],["وكان فيه كمولود على رغد","أنهى رضاعته التشريد والشطف",53,"ف",1,0],["وكان في لفظِها عَيٌّ فأيّده","، فلم تُخبّره عن شيءٍ بإفصاح",54,"ح",1,0],["وَكَانَ فَتىً طَلْقُ المُحَيَّا جَمِيلُهُ","وَلَكِنَّهُ نَذْلُ الفُؤَادِ ذَلِيلُه",55,"ه",1,0],["وكأنّ فتحا من فتوح أميّة","حملت بشائره الجياد السبّق",56,"ق",1,0],["وَكانُ فُلاَنُ أحسَنُ قَبلُ صَوتاً","من القَينَاتِ تَجتَذِبُ الكِرَانَا",57,"ن",2,0],["وَكَأنَّ في أنيَابِهِنَّ عَلَى الكَرَى","عَسَلاً وفي نَكَهَاتِهِنَّ خَمَائِلا",58,"ل",2,0],["وكَأنَّ في قَلبي غَضاً مُتَضَرِّماً","يغلي زَفِيرِي عَالِياً أو سَافِلا",58,"ل",2,0],["وكان فتحكِ مجدا ً قبل أندلس ٍ","تغيرَ الفتحُ يا مسلوبةَ الغضب ِ",59,"ب",1,0],["وكانَ فمي 