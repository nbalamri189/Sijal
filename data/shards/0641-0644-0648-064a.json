{"poems":[[55,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[88,"منى نلتها يا لابس المجد معلما","https://www.aldiwan.net/poem68939.html","الطويل"],[23,"سألت قريشا فلم يكذبوا","https://www.aldiwan.net/poem21386.html","المتقارب"],[23,"قد تعفى بعدنا عاذب","https://www.aldiwan.net/poem21403.html","المديد"],[97,"ملحمة النبي","https://www.aldiwan.net/poem60153.html","عموديه"],[53,"يقتر عيسى على نفسه","https://www.aldiwan.net/poem10873.html","المتقارب"],[53,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[93,"أيار يا شاعر الشهور","https://www.aldiwan.net/poem8836.html","عموديه"],[99,"هم أناخ فما انجلى","https://www.aldiwan.net/poem24903.html","مجزوء الكامل"],[46,"كشف الغطاء فأوقدي أو أخمدي","https://www.aldiwan.net/poem30545.html","الكامل"],[76,"ورداء ليل بات فيه معانقي","https://www.aldiwan.net/poem12817.html","الكامل"],[76,"طاف الظلام به فأسرج أدهما","https://www.aldiwan.net/poem13248.html","الكامل"],[77,"تنبأ المتنبي فيكم عصرا","https://www.aldiwan.net/poem69075.html","البسيط"],[77,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[50,"قد أغتدي والصبح في دجاه","https://www.aldiwan.net/poem66201.html","الرجز"],[48,"متى تشرك مع امرأة سواها","https://www.aldiwan.net/poem23101.html","الوافر"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12466","الهزج"],[111,"أبلغ إليك رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=536",""],[92,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[173,"أبت لك العزة القعساء والكرم","https://www.aldiwan.net/poem1674.html",""],[266,"عللوا قلبي بتذكار اللقاء","https://www.aldiwan.net/poem38376.html","الرمل"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[409,"أمثلك يرضى بارتكاب العظائم","https://www.aldiwan.net/poem33427.html","الطويل"],[422,"شفيت بطرد صالح كل صدر","https://www.aldiwan.net/poem53900.html","الوافر"],[431,"ومد من رحل العطاط وردنه","https://www.aldiwan.net/poem1925.html","الكامل"],[457,"مالي أطارح نحو أسود صادح","https://www.aldiwan.net/poem13692.html","الكامل"],[463,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[466,"أقم يا حسامي في صوانك واهجم","https://www.aldiwan.net/poem15092.html","الطويل"],[469,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[498,"خيالك منك أعرف بالغرام","https://www.aldiwan.net/poem67316.html","الوافر"],[520,"تهن بأعياد غدا بك فخرها","https://www.aldiwan.net/poem12125.html","الطويل"],[572,"يا قاتل الله كتاب الدواوين","https://www.aldiwan.net/poem69488.html","البسيط"],[572,"يا صبو حبك في الأحشاء قد قدحا","https://www.aldiwan.net/poem69753.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112453","السريع"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112462","المجتث"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48507","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122316","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145798","المتقارب"],[1610,"","https://poetry.dctabudhabi.ae/diwan/poem/115023","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118348","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27983","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27631","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100246","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202392","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100725","البسيط"],[3156,"","https://poetry.dctabudhabi.ae/diwan/poem/34722","المتقارب"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71313","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89152","البسيط"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103818","الطويل"],[3564,"","https://poetry.dctabudhabi.ae/diwan/poem/127814","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109894","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131261",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136567",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136515",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58060","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72787","الكامل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116051","البسيط"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113831","الطويل"],[4852,"صباحك المأمول","https://www.poetsgate.com/ViewPoem.aspx?id=215992",""],[5074,"الحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=175382",""],[5081,"أَعْلَنْتُ حُبِّى","https://www.poetsgate.com/ViewPoem.aspx?id=185577",""],[5186,"تالله ما أنا واقف في الباب","https://www.poetsgate.com/ViewPoem.aspx?id=156550",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[5348,"الخطب الجليل","https://www.poetsgate.com/ViewPoem.aspx?id=59566",""],[5369,"مفتتح","https://www.poetsgate.com/ViewPoem.aspx?id=177441",""],[5638,"لا مَثَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=198251",""],[5956,"عصفور هطلَ على ماء بجانبي","https://www.poetsgate.com/ViewPoem.aspx?id=183461",""],[572,"يا ضوءُ حُبُّكَ في اَحشاءَ قد قدّحَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9207&r=&rc=64",""]],"verses":[["فَلَو يَستَطيعُ الدَهرُ مِن بَعدِ هَذِهِ","لَأَلبَسَكَ اليَومَ التَميمَ المُعَقَّدا",0,"د",2,0],["فَلَو يَستَطيعُ الرُكنُ أَمسَكَ راحَةً","مَسَحتَ بِها يا أَكرَمَ الناسِ مُنتَمى",1,"م",2,0],["فَلَو يَصدُقونَ لَأَنبَوكُمُ","بِأَنّا ذَوُو الحَسَبِ القاهِرِ",2,"ر",1,0],["فَلِوى الخُربَةِ إِذ أَهلُنا","كُلَّ مُمسىً سامِرٌ لاعِبُ",3,"ب",1,0],["فلوى جيده وسار وئيدا","ثابت العزم مثقل الأعباء",4,"ا",2,0],["فلو يستطيع لتقتيره","تَنفَّس من منخرٍ واحدِ",5,"د",1,0],["فلو يرى هديه النبي أو ال","عباس قالا بوركت من خلف",6,"ف",1,0],["فَلَو يَزورُ الصُدورَ حُلمٌ","عَرَّجَ مِنها عَلى قُبورِ",7,"ر",1,0],["فلوى عناني فالتفت","تُ فلم أجد لي مَوئِلا",8,"ل",2,0],["فَلَوَيتَ بِالمَوعودِ أَعناقَ الوَرى","وَحَطَمتَ بِالإِنجازِ ظَهرَ المَوعِدِ",9,"د",1,0],["فَلَوَيتُ مَعطِفَها اِعتِناقاً حَسبُها","فيهِ بِقَطرِ الدَمعِ مِن أَنواءِ",10,"ا",2,0],["فَلَوَيتُ أَعناقَ المَطِيِّ مُعَرِّجاً","وَنَزَلتُ أَعتَنِقُ الأَراكَ مُسَلِّما",11,"م",2,0],["فلو يُصِيخُ إليكم سمْعُ قائِلِهِ","ما باتَ يعمَلُ في تحبيرِه الفِكَرا",12,"ر",2,0],["فلو يجدُ البحرُ نَهجاً إليك","لجاءكَ مُستَسقياً من ظما",13,"ا",1,0],["فَلَو يَرى القانِصُ ما يَراهُ","فَدّاهُ بِالأُمِّ وَقَد فَدّاهُ",14,"ا",2,0],["فَلَو يُرجى مَعَ الشُرَكاءِ خَيرٌ","لَما كانَ الإِلَّهُ بِلا شَريكِ",15,"ك",1,0],["فَلَو يَعلَمُ ما في الحُ","بِّ مَن عابَ لَما عابا",16,"ب",2,0],["فلويت عنك شكيمتي","وتركت جدك للمزاح",17,"ح",1,0],["فلو يُطيق القريضُ النُطقَ قابلةُ","بالشكرِ عن حُسن ما أسدى فأطراه",18,"ا",2,0],["فَلَو يَشاءُ لَزَجّاها مُلَملَمَةً","لا مَعقلٌ عاصِمٌ مِنها وَلا أُطُمُ",19,"م",1,0],["فلوى عن لمسها أبدى العدا","وأخو البأساء منصور اللواء",20,"ا",2,0],["فلوى ذيله احتجاجا وقال الي","وم ضاعت شريعة الإنصاف",21,"ف",1,0],["فلو يعبد الدينار صلوا لأجله","وصاموا وقالوا أنت رب العوالم",22,"م",1,0],["فلو يُرمى بلجّ البحر يوماً","لنَجَّسَ شيبُه ماءَ البحور",23,"ر",1,0],["فَلَوى الرَشاءَ وَطَرَت فَوقَ شَمَلَّةٍ","وَجناءَ دانِيَةِ المِراحِ تَلَذَّعُ",24,"ع",1,0],["فلوى بعهدي واستقل به النوى","عني وغادرني بدمع سافح",25,"ح",1,0],["فلو يسامُ حبّ شي","ءٍ معَكم لم يسعِ",26,"ع",1,0],["فلو يستقل الرمحُ منك بسطوةٍ","إلى القوم عن سُرىً وتجشم",27,"م",1,0],["فلو يدعي المسك الفتيق صفاتهم","لطمن لدعواه خدود اللطائم",28,"م",1,0],["فَلَو يَستَطيعُ حينَ حَظَرتَ نَومي","عَلَيَّ لَزارَ في غَيرِ المَنامِ",29,"م",1,0],["فلو يستطيع الدهر جاء مهنئاً","بأيام سعد أعقب الصوم فطرها",30,"ر",3,0],["فَلَو يَرُدُّ فِدَاءٌ مَا فُجِعْتُ بِهِ","مِنْهَا فَدَيْنَاهُ بِالدُّنْيَا وَبِالدِّيْنِ",31,"ن",1,0],["فلو يَكُونُ بإحدى كِفَّتَيْنِ وَلاَ","شيْءَ يُوَزِيْهِ في الأُخرى لَمَا رَجَحَا",32,"ح",2,0],["فلو يكن قال كما قد قلتم","لم يجب الفضل الذي أوجبتم",33,"م",1,0],["فلو يوافيها ربيع الغرام","ويقطع الأحباب حبل الصدود",34,"د",1,0],["فلو يرق قليلا","لشقوتي وبلائي",35,"ي",1,0],["فلو يعلم القوم الذين تقدموا","زمانَك ودوا لو إليه تأخروا",36,"ر",3,0],["فلو يشتكي العشاق من طول ليلهم","لما كان خوفا منك يطغى ويظلم",37,"م",1,0],["فلو يُوْسِع ُالأفقُ من أفقِهِ","ولوْ ينبتُ الريشُ في أذرُعِي",38,"ع",2,0],["فلو يَسألُ ابنُ الحرِّ أُخبرَ أنّها","يمانية لا تُشترى بالمَغازل",39,"ل",1,0],["فلو ينطقن قلن لقد شبعنا","بلحم الخندفينَ كما روينا",40,"ن",2,0],["فلوى قارح فجمهور نصف","فالميامين فالنقا من انارا",41,"ر",2,0],["فلو يدري أنَّ النور يستر ليله","وأنَّ وجودَ السلخِ صيَّره نشا",42,"ش",2,0],["فلو يقول جهولٌ قد جهلت وما","بالله جهلٌ فما كوني هو الله",43,"ل",2,0],["فلوى يديه عليَّ طوقاً مذهباً","ولويت فضل يدي عليه وشاحا",44,"ح",2,0],["فلو يعبد الانسان كنت عبدته","وما كنت في هذا الضلال ملوما",45,"م",2,0],["فلو يعدون ما أوفى بهم عدد","كصيب القطر لا يحصى بمقدار",46,"ر",1,0],["فَلَو يَستَعينانِ هَذا بِذاكَ","لَكانا بِعُرضَةِ أَمرٍ سَتير",47,"ر",1,0],["فَلَوْ يَكُونُ السُّلُوِّ حَياً","مَا مَاتَ مِنْ هَجْرِهِ المُحِبُّ",48,"ب",1,0],["فلو يرى بينهم توفيق صاحبه","لودَّ لو أن رآه وهو محتَضَر",49,"ر",1,0],["فلو يتفذى المرء بالسم قاته","وقام منه غذاء مجرب",50,"ب",1,0],["فلو يُفدى لكنت لهُ فداءً","ولو يُجدي البكا لَبكيتُ دهرا",51,"ر",2,0],["فلو يُفدَى لكُنتُ لهُ فِداءً","ولكِن لا يُخالُ لهُ فِداءُ",52,"ا",2,0],["فلويت عنهن العذار ومن يهم","بعد المشيب فإنه لأفين",53,"ن",1,0],["فَلوى بجيد الريم عَني وانثنَى","يشدو ويضحكُ مذ بكيت سرورا",54,"ر",2,0],["فلويتُ جيدي والدموعُ طَليقةٌ","ومضى الفؤادُ كما عهدت أسيرا",54,"ر",2,0],["فلوى بجيد الريم عني","وانثنى يحَكي القضيبا",55,"ب",2,0],["فلو يتفكرُ الإنسان في خلْق نفسه","لذلَّ ولا يخلو قليلاً من الفكرِ",56,"ر",1,0],["فلوى وقد عزمَ الرحيلَ عن اللوى","روحي تروحُ له الفدا من عازم",57,"م",1,0],["فلو يكونُ لهم أمثالُهُ عَضُداً","فيما مضَى ما غَدَت مغصوبةً فَدَكُ",58,"ك",1,0],["فلو يدعنى كسرى إلى ملكة فقد","جعلت حيائي في حياتي ديدني",59,"ن",2,0],["فلو يا صبح قد آنستَ عيني","لأُبدي وحشةَ الأيام وحدي",60,"د",2,0],["فَلَوْ يَعلَمُ العُشَّاقُ مَا فَعلَةُ الهَوَى","فَطَعمُ الهَوَى حُلْوٌ وآخِرُهُ مُرُّ",61,"ر",1,0],["فَلَوْ يُرْضِيكَ بُعْدَاً سَوْفَ أَرْضَى","وَإِنْ صَارَ الْفُؤَادُ بِهِ مُعَذَّبْ",62,"ب",1,0],["\"فلوى بموفور \"\"الأمانة\"\" و\"\"التقى\"\"\"","أدبا إلى الإرقاص والإطراب",63,"ب",1,0],["فَلَوْ يُكُونُ ِبهَا فَرْداً لمَا سَجَدَتْ","لَهُ الجِبَاهُ خُضُوعاً عِنْدَ نَادِيهِ",64,"ي",2,0],["فلَو يُكتبُ التَّخْلِيدُ للمجدِ والتُّقَى","لكنتَ بهِ يا أعدلَ النَّاسِ أَجْدَرُ",65,"ر",1,0],["فلو يُهدى به رجلٌ","فهذا غاية المطلب",66,"ب",1,0],["فَلَوْ يَوْمًا تَبَاعَدْنَا","فِرَاقُكِ كَيْفَ أَحْتَمِلُ",67,"ل",1,0],["فلو يدري بما قلبي","لبَشَّ إليّ ما استاءا",68,"ا",3,0],["فلو يَكُونُ بأحدَى كفَّتينِ وَلاَ","شَيءٌ يوازيهِ في الأُخرَى لَمَا رَجَحَا",69,"ح",2,0]]}