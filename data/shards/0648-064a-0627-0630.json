{"poems":[[147,"شفاء الهدى يا سيفه العضب أن تشفا","https://www.aldiwan.net/poem11779.html","الطويل"],[147,"دعوا القول فيمن جاد منا ومن ضنا","https://www.aldiwan.net/poem11826.html","الطويل"],[151,"يا سيدي يا رسول الله يا سندي","https://www.aldiwan.net/poem47642.html","البسيط"],[164,"يزداد هجرا كل ما كلما","https://www.aldiwan.net/poem58866.html","السريع"],[186,"تصبر وإن لم تملك الصبر فاجزع","https://www.aldiwan.net/poem67051.html","الطويل"],[369,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[371,"أبا قرب النعي من البشير","https://www.aldiwan.net/poem17345.html","الوافر"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[445,"تسليت حتى أنسي الهائم الهما","https://www.aldiwan.net/poem34792.html","الطويل"],[520,"يا أكرم الحاضر والبادي","https://www.aldiwan.net/poem12096.html","السريع"],[563,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[592,"يا تاركاً لمراضي الله أوطاناً","https://www.aldiwan.net/poem11514.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83331","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122759","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38926","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59438","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59432","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59408","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64560","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64504","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128719","الطويل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123177","الوافر"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110273","السريع"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113736","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77304","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130066","الوافر"],[3361,"","https://poetry.dctabudhabi.ae/diwan/poem/202181","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135230","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95318","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77026","الوافر"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4767,"تاج الكمال","https://www.poetsgate.com/ViewPoem.aspx?id=179616",""],[5019,"يا أيها العارف المحكول ناظره","https://www.poetsgate.com/ViewPoem.aspx?id=157050",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[6102,"هوان هوى","https://www.poetsgate.com/ViewPoem.aspx?id=185303",""],[520,"يا اكرم الحاضر والبادي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577500",""]],"verses":[["وَياذا المَعالي لا يُعَدِّدُ فَضلَها","مَقالٌ أَيُفني البَحرَ وارِدُهُ غَرفا",0,"ف",2,0],["وَياذا العَطايا تَستَقِلُّ جَزيلَها","فَما تُتبِعُ المَنَّ اِعتِداداً وَلا مَنّا",1,"ن",2,0],["ويا ذخيرة فقري يا عياذي يا","غوثي ويا عدتي للخطب والنكد",2,"د",1,0],["ويا ذوي الإِفساد توبوا فما","أفلح بان رض ما رضما",3,"م",2,0],["وَيا ذوبَ أَكبادٍ تَسيلُ كآبةً","عَلى جَمرِ حُزنٍ حَيثُما مسَّ يَلذَعِ",4,"ع",1,0],["ويا ذِروةَ الخُطّابِ عزّاً وقد سعَتْ","إليك هوىً فاطْرَبْ لغانيةٍ بِكْر",5,"ر",1,0],["وَيا ذِكراً وَيا ذَكَراً تَوَلّى","مُقيماً لِلإِناثِ وَلِلذُكورِ",6,"ر",1,0],["ويا ذا الفضل والجو","دذي عم البريات",7,"ت",1,0],["ويا ذَا الرِّياساتِ افْتَتِحْ فَقَدِ انْجَلَتْ","فواتِحُكَ اللاتِي ضَمِنَّ لَكَ الحَتْما",8,"م",2,0],["ويا ذباب الأبيض المنتضي","عزماً ونصل الصعدة الصادي",9,"د",2,0],["ويا ذا الجلالِ ارفع حجاب بصيرتي","والإكرامِ أكرمني وكن بي مباهيا",10,"ي",2,0],["ويا ذل الجد في تحصيله زمناً","ولم يكن نال بعد الجد عرفانا",11,"ن",2,0],["وَيا ذاكَ الفَقيدُ اِذهَب فَحاشا","مَقامُكَ أَن يَقومَ بِهِ الرِثاءُ",12,"ا",2,0],["وَيا ذلَّةَ المِخلافِ مِن بَعدِ عِزَّةٍ","تَسَلطَنَ مِنها نَجدُهُ وَ تَهائِمُه",13,"م",2,0],["وَيا ذا الصِّفاتِ الغرِّ لَو رُمت عَدَّها","مُجرّدُ تعدادٍ عَجزتُ عَنِ العدِّ",14,"د",1,0],["ويا ذا الجلال المحض والعز والبقا","ويا ذا النوال الجم والجود والكرم",15,"م",1,0],["ويا ذا الصراط المستقيم وصاحب","الوسيلة والحوض الذكي النواسم",16,"م",1,0],["ويا ذا الجود والجبروت جد لي","بما أرجوه من جبر انكساري",17,"ر",2,0],["ويا ذا المن والرحموت قابل","برحماك اغترابي واغتراري",17,"ر",2,0],["ويا ذا الجلال ارفع مقامي واكسني","باكرامك العزين والنور والعلى",18,"ل",2,0],["ويا ذا الجلال القائم الدائم العلا","وذا البر والاكرام يا ذا العطية",19,"ه",1,1],["ويا ذا الجلال الغالب الباهري السطى","وذا البر في إكرامه للبرية",19,"ه",1,0],["ويا ذا الجلال العاصم المانع الحمى","وذا المن والاكرام قبل الوسيلة",19,"ه",1,0],["ويا ذا الجلال القاسر الخلق حوله","وذا البسط والاكرام والمددية",19,"ه",1,0],["ويا ذا الجلال المطلق الشأن والذي","تقدس في إكرامه عن غرضية",19,"ه",1,0],["ويا ذا الجلال الكانف الخلق أمره","بقهر وإكرام وعدل ومنة",19,"ه",1,0],["ويا ذا الندى والجود والفضل والثنا","وأهل الوفا والحمد والمجد والعلا",20,"ل",2,0],["ويا ذا الموز فيها طبتَ طعماً","أحبك أي ولو لم يطعموني",21,"ن",2,0],["ويا ذوي الأموال لا تقبضوا","راحاتكم عن بائس يستعين",22,"ن",1,0],["ويا ذا الكَراماتِ العظامِ التي لها","بوادي البَرايا أذعَنَت والحواضرُ",23,"ر",1,0],["وَيا ذَلِكَ الشَيطانُ واقِع جَهَنَّما","جَزاءً بِما وَسوَستَ يا أَخبَثَ الجانِ",24,"ن",1,0],["ويا ذاك الفقيد حباكَ ربّي","منَ الرَحَمات والفضل المزيدا",25,"د",2,0],["ويأذى به الأدنى ويرضى به العدا","إذا صار مثل الرأي أحدب أخضعا",26,"ع",2,0],["ويا ذا الجلال المُكرم العبد إذا دعا","بذلك والإكرام أكرم بلا سبر",27,"ر",1,0],["وَيا ذا المَعالي الغُرّ والبَعضُ مُحسَب","دَليلٌ على كُلٍّ فما الكُلُّ محسُوبُ",28,"ب",1,0],["وَيا ذا الفَضلِ يا جَم الأَيادي","وَمِن إِحسانِهِ لِلعَبدِ يُغني",29,"ن",2,0],["وَيا ذاتِيَ المَعدومَ هَل لَكَ بَعثَةٌ","وَيا صَبرِيَ المَهزومَ هَل أَنتَ راجِعُ",30,"ع",1,0],["ويا ذِكراً يضوع الدهرَ مسكاً","له نشتاق في كل احتفال",31,"ل",1,0],["ويا ذخيرة آمالي ومعتمدي","يا روح روحي ويا اصلاً لاحياء",32,"ا",2,0],["ويا ذا الجلال الكبرياء رداؤك","الممنع والإكرام أنت ترداه",33,"ا",2,0],["وَ يَا ذَاكَ المُؤَمَّلُ فِي غَرامٍ","تَحَرَّ العَقلَ , قَدْ ضَيَّعتَ وَقتَا",34,"ت",2,0],["ويا ذباب الأبيض المتضى","عزماً ونصل الصعدة الصادي",35,"د",2,0]]}