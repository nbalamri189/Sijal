{"poems":[[53,"غزال ماطل ديني","https://www.aldiwan.net/poem29739.html","الهزج"],[53,"عجزنا عن مراغمة الحمام","https://www.aldiwan.net/poem29763.html","الوافر"],[53,"أبا نزار تفسد القوم النعم","https://www.aldiwan.net/poem29802.html","الرجز"],[53,"بود الرذايا أنها في السوابق","https://www.aldiwan.net/poem29954.html","الطويل"],[53,"تمنى رجال نيلها وهي شامس","https://www.aldiwan.net/poem30198.html","الطويل"],[53,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[53,"أغدرا يا زمان ويا شباب","https://www.aldiwan.net/poem30744.html","الوافر"],[53,"ألا حيها رب العلى من غوارب","https://www.aldiwan.net/poem30755.html","الطويل"],[53,"تعيرني فتاة الحي أني","https://www.aldiwan.net/poem30774.html","الوافر"],[55,"وما جئت جهلا إنني بك عالم","https://www.aldiwan.net/poem26269.html","الطويل"],[55,"تجافى مرفقاي عن الوساد","https://www.aldiwan.net/poem26422.html","الوافر"],[9,"ألا قل لتيا قبل مرتها اسلمي","https://www.aldiwan.net/poem21979.html","الطويل"],[86,"بنادي الجزيرة قف ساعة","https://www.aldiwan.net/poem10950.html","المتقارب"],[0,"سما لك شوق بعدما كان أقصر","https://www.aldiwan.net/poem53.html","الطويل"],[35,"عفت غيقة من أهلها فحريمها","https://www.aldiwan.net/poem38833.html","الطويل"],[93,"وفاء كهذا العهد فليكن العهد","https://www.aldiwan.net/poem9845.html","الطويل"],[88,"هو النصر معقود برايتنا الحمرا","https://www.aldiwan.net/poem44470.html","الطويل"],[88,"ألا ما لأهل الشرق في برحاء","https://www.aldiwan.net/poem44973.html","الطويل"],[88,"بني الأرض هل من سامع فأبثه","https://www.aldiwan.net/poem45068.html","الطويل"],[27,"أصبح حبل وصلكم رماما","https://www.aldiwan.net/poem5987.html","الوافر"],[27,"ألم يك لا أبا لك شتم تيم","https://www.aldiwan.net/poem6008.html","الوافر"],[47,"قلبي يحن إليه","https://www.aldiwan.net/poem24814.html","المجتث"],[23,"فلا والله ما تدري معيص","https://www.aldiwan.net/poem21324.html","الوافر"],[72,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[51,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[51,"أناديك يا من ليس في سمعه وقر","https://www.aldiwan.net/poem64064.html","الطويل"],[51,"ترحل من هويت وكل شمس","https://www.aldiwan.net/poem64565.html","الوافر"],[51,"بكيت فلم تترك لعينك مدمعا","https://www.aldiwan.net/poem65076.html","الطويل"],[51,"رأيت التقاط جنى نخلة","https://www.aldiwan.net/poem65521.html","المتقارب"],[51,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[29,"إذا ما قلت قد صالحت بكرا","https://www.aldiwan.net/poem6098.html","الوافر"],[85,"أحق أنهم دفنوا عليا","https://www.aldiwan.net/poem7117.html","الوافر"],[85,"أفي هذا الشباب تعف نفس","https://www.aldiwan.net/poem7776.html","الوافر"],[85,"رضاكم بالعلاقة لي كفيل","https://www.aldiwan.net/poem7893.html","الوافر"],[56,"بانوا فصار الجسم من بعدهم","https://www.aldiwan.net/poem58480.html","السريع"],[43,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[62,"ولما حللنا جميع الرموز","https://www.aldiwan.net/poem52148.html","المتقارب"],[45,"عهدي بربعك مأنوسا ملاعبه","https://www.aldiwan.net/poem10906.html","البسيط"],[45,"دع الشيء لا تطلبه من نحو وجهه","https://www.aldiwan.net/poem62679.html","الطويل"],[45,"أقصر حميد لا عزاء لمغرم","https://www.aldiwan.net/poem65656.html","الطويل"],[28,"إن تذعر الوحش من رأسي ولمته","https://www.aldiwan.net/poem5221.html","البسيط"],[28,"ومسجونة قالت وقد سد زوجها","https://www.aldiwan.net/poem5259.html","الطويل"],[28,"رأتني معد مصحرا فتناذرت","https://www.aldiwan.net/poem5527.html","الطويل"],[28,"ومطروفة العينين قد قدت للصبا","https://www.aldiwan.net/poem5565.html","الطويل"],[61,"وأجرد يسعى ليله ونهاره","https://www.aldiwan.net/poem51662.html","الطويل"],[69,"يا من أفارق قلبي عند فرقتهم","https://www.aldiwan.net/poem28432.html","البسيط"],[69,"أتهزأ بي لما أجد وتلعب","https://www.aldiwan.net/poem28601.html","الطويل"],[31,"يا ليتني قد أجزت الحبل نحوكم","https://www.aldiwan.net/poem42540.html","البسيط"],[33,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[105,"أمن عرش الشآم إلى أثينا","https://www.aldiwan.net/poem43065.html","الوافر"],[105,"تغلغل في القلب حتى وقر","https://www.aldiwan.net/poem43073.html","المتقارب"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[52,"جفاني النميري فيمن جفا","https://www.aldiwan.net/poem27311.html","المتقارب"],[75,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[75,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[75,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[48,"إن الذي ضن بقرطاسه","https://www.aldiwan.net/poem63426.html","السريع"],[48,"أنا أبصرت صاح الشمس","https://www.aldiwan.net/poem64383.html","الطويل"],[50,"أجارتنا لا تجزعي وأنيبي","https://www.aldiwan.net/poem64831.html","الطويل"],[46,"إلى ما أجر قيود الحياة","https://www.aldiwan.net/poem22734.html","المتقارب"],[46,"لعمري لقد طال هذا السفر","https://www.aldiwan.net/poem22748.html","المتقارب"],[46,"غدت أم دفر وهي غير حميدة","https://www.aldiwan.net/poem22823.html","الطويل"],[46,"أشد عقابا من صلاة أضعتها","https://www.aldiwan.net/poem23363.html","الطويل"],[46,"أريد ليان العيش في دار شقوة","https://www.aldiwan.net/poem23499.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39592","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39611","المنسرح"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16623","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16626","السريع"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30459","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67312","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142341","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54279","الطويل"],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[53,"سئمت الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=11431",""],[84,"ولم أر مثلي ما له من معاصر","https://www.poetsgate.com/ViewPoem.aspx?id=26325",""],[43,"حُشاشَةُ نَفسٍ وَدَّعَت يَومَ وَدَّعوا","https://www.poetsgate.com/ViewPoem.aspx?id=10880",""],[90,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[105,"تغلغل في القلب حتى وقر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54985&r=&rc=155",""],[75,"كَذبَ السلوُّ، العِشقُ أيسَرُ مركبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10785&r=&rc=5",""]],"verses":[["وَما جُزتُ الثَلاثينَ","بِعامٍ أَو بِعامَينِ",0,"ن",1,0],["وَما جَزَعُ الجَزوعِ وَإِن تَناهى","بِمُنتَصِفٍ مِنَ الداءِ العُقامِ",1,"م",1,0],["وَما جَرى بِالخَيفِ مِن دَمعٍ وَدَم","يَومَ يَطيرُ الناسُ غِربانَ الجُمَم",2,"م",1,0],["وَما جَمعِيَ الأَموالَ إِلّا غَنيمَةً","لِمَن عاشَ بَعدي وَاِتِّهاماً لِرازِقي",3,"ق",2,0],["وَما جَزَعي إِن حالَ لَونٌ وَإِنَّما","أَرى الشَيبَ عَضباً قاطِعاً حَبلَ عاتِقي",3,"ق",2,0],["وَما جالَسوا إِلّا السُيوفَ مُعَدَّةً","لِيَومِ الوَغى وَالمَرءُ مِمَّن يُجالِسُ",4,"س",1,0],["وَما جالَتِ الأَلحاظُ إِلّا بِقاطِرٍ","وَلا اِمتَدَّتِ الأَنفاسُ إِلّا بِحاصِبٍ",5,"ب",1,0],["وَما جَزَعي لِأَن غَرُبَ التَصابي","وَحَلَّقَ عَن مَفارِقِيَ الغُرابُ",6,"ب",1,0],["وَما جَرَّ ذُلّاً مِثلُ نَفسٍ جَزوعَةٍ","وَلا عاقَ عَزماً مِثلُ خَوفِ العَواقِبِ",7,"ب",1,0],["وَما جودُ الزَفيرِ عَلَيكَ جوداً","وَلَكِن ذاكَ مِن لُؤمِ العَزاءِ",8,"ا",2,0],["وَما جِئتُ جَهلاً إِنَّني بِكِ عالِمٌ","وَلَكِن لِأُبلي فيكِ عُذراً إِلى نَفسي",9,"ي",1,1],["وَما جَهلاً تَرَكتُ البَحرَ خَلفي","وَجِئتُكُمُ إِلى مَصِّ الثِمادِ",10,"د",1,0],["وَما جَعَلَ الرَحمَنُ بَيتَكَ في العُلى","بِأَجيادِ غَربِيِّ الصَفا وَالمُحَرَّمِ",11,"م",1,0],["وَماجَ بِزُوّارِهِ المولَعينَ","وَأَضحى بِعَرشِ المُلوكِ اِزدَهى",12,"ا",1,0],["وَما جَبُنَت خَيلي وَلَكِن تَذَكَّرَت","مَرابِطَها في بَربَعيصَ وَمَيسَرا",13,"ر",2,0],["وَما جابَةُ المِدرى خَذولٌ خَلا لَها","أَراكٌ بِذي الرَيّانِ دانٍ صَريمُها",14,"م",3,0],["وما جمع اللَه النظيرين مرةً","كجمعكما والند أولى به الند",15,"د",1,0],["وما جزعي للحرب يَحمَى وطيسها","ولكن لأرواح بها أزهقت صبرا",16,"ر",2,0],["وما جعلوا الأديان إلاّ ذريعة","إلى كل شَغْب بينهم وعداء",17,"ا",2,0],["وما جاء فيهم عادل يستعيلهم","إلى الحق إلا صدّه ألف ظالم",18,"م",1,0],["وَما جَعَلَ الكَواكِبَ أَو سُهَيلاً","كَضَوءِ البَدرِ يَجتابُ الظَلاما",19,"م",2,0],["وَما جُعِلَ القَوادِمُ كَالذُنابى","وَماجُعِلَ المَوالي كَالصَميمِ",20,"م",1,0],["وَما جَنى أَو تَجَنّى","إِلّا اِعتَذَرتُ إِلَيهِ",21,"ي",2,0],["وَما جُمَحٌ وَلَو ذُكِرَت بِشَيءٍ","وَلا تَيمٌ فَذَلِكُمُ الرِعاعُ",22,"ع",1,0],["وماجدٌ حثَّ ركاب السرى","حثّ الرجا الساري إلى قصده",23,"د",2,0],["وما جهلُ الحليمِ لَهُ بجهلٍ","ولكنْ حدُّ أُظفورٍ ونابِ",24,"ب",1,0],["وما جزره إلا استفاضةُ فضله","على ساكني بدو وفي قاطني حَضْر",25,"ر",1,0],["وما جاش مدٌّ مثلُ مدحيَ فيكُمُ","فلِمْ كسبُهم مَدٌّ ولمْ مكسبي جَزْر",26,"ر",1,0],["وما جَربتُهم إلا بغيري","وما استخشنتُ جانبهم بلمسي",27,"س",2,0],["وما جشمتني الطير ما أنا جاشمٌ","بأسبابها إلا ليجشمن مُضلِعا",28,"ع",2,0],["وما جشمت كفه شوكها","ولا جشمت رجله سُحقها",29,"ق",3,0],["وما جُلَّنارٍ بالمُقَصِّر شأوُها","ولا المتعدِّي قصد أهدى المسالك",30,"ك",1,0],["وما جاوزوا إذْ أطنبوا فيك أنْ دَعَوْا","بأسمائك اللائي بها كنتَ تُوسَمُ",31,"م",1,0],["وما جلجل الوجناءَ بين قتودِها","كغضبةِ حُرٍّ شيَّعتْها عزائمُ",32,"م",1,0],["وَما جَرَحَت يَدي بِبَني سُلَيمٍ","وَلا شِعري فَيَهجوني الشَريدُ",33,"د",1,0],["وما جهل العتيق الحر منها","ولا غبى المقلد والدعيا",34,"ي",2,0],["وما جهلوا فوائد ما أضاعوا","ولكن ربما نسى العليم",35,"م",1,0],["وما جاملتموا أهلا ولكن","ذهبتم مذهبا وهو الجميل",36,"ل",1,0],["وما جوابي إِذْ تَقولُ العِدَا","ما صَنَعَ البَيْنُ بِهِ شَيّا",37,"ي",2,0],["وَما جَهِلَت أَيادِيَكَ البَوادي","وَلَكِن رُبَّما خَفِيَ الصَوابُ",38,"ب",1,0],["وما جاء في حكم الأولين","ووافقه المحكم المنزلُ",39,"ل",1,0],["وَما جَهِلتَ فَلا تَجهَل مُحاجَزَتي","لِصاحِبِ البابِ يَرمي عَنهُ حاجِبُهُ",40,"ب",2,0],["وَما جَهِلَ اِبنُ الجَرجَرائِيُّ واجِبي","عَلَيهِ وَلَكِن كانَ أَلأَمَهُم عِلجا",41,"ج",2,0],["وَما جَدَثٌ فيهِ اِبتِسامُكَ لِلنَدى","إِذا أَظلَمَت أَجداثُ قَومٍ بِمُظلِمِ",42,"م",1,0],["وَما جَلَونَ لَنا عَيناً فَنُطعِمَها","بِالنَومِ إِلّا مَعَ الإِصباحِ إِذ حَشَرا",43,"ر",2,0],["وَما جَبَرَت إِلّا عَلى عَتَبٍ بِها","عَراقيبُها مُذ عُقِّرَت يَومَ صَوأَرِ",44,"ر",1,0],["وَما جَرَّبَ الأَقوامُ مِنّي أَناثَةً","لَدُن عَجَموني بِالضُروسِ العَواجِمِ",45,"م",1,0],["وَما جُشَّمُ الأَظهارَ مِثلُ شِمِلَّةٍ","وَحامِلَةٍ لِلهَمِّ ماضٍ صَريمُها",46,"م",3,0],["وما جارَ فيما سارَ قَدرَ قُلامَةٍ","ولكنَّهُ يَشقَى ويَستُرُ غيرَه",47,"ه",1,0],["وما جهلتُ أياديكمْ وفضلكُم","ولوْ جهلتُ أليسَ اللهُ قدْ عَلِمَا",48,"م",2,0],["وما جهلتْ نفسي المعالي وطيبَها","ولكنْ رأتْ أنَّ السلامةَ أطيبُ",49,"ب",1,0],["وَما جَذِلتُ لِشَيءٍ كانَ بَعدَكُمُ","وَلا مَنَحتُ سِواكِ الحُبَّ مِن بَشَرِ",50,"ر",1,0],["وَما جِئتَها أَبغي شِفائي بِنَظرَةٍ","فَأُبصِرُها إِلّا اِنصَرَفتُ بِدائِيا",51,"ي",2,0],["وَما جَهِلَت مَكانَكَ حينَ تُزجي","جُيوشَكَ في المَمالِكِ فاتِحينا",52,"ن",2,0],["وَما جُعِلَت عَفَواتُ الثَنا","ءِ إِلّا لِذي الجُرأَةِ المُبتَدِرْ",53,"ر",1,0],["وَما جَلسُ أَبكارٍ أَطاعَ لِسَرحِها","جَنى ثَمَرٍ بِالوادِيَينِ وَشوعُ",54,"ع",1,0],["وَما جَمَعَ اللَهُ حُبَّ اِمرِئٍ","وَحُبَّكَ أَعدائَهُ في حَشا",55,"ا",1,0],["وما جِهلتْ مِصرٌ وقد قيل مَن لها","بأنّكَ ذاك الهِبْرِزِيُّ السَّمَيذَع",56,"ع",1,0],["وما جهِلَ المنصورُ في المهدِ فضلَهُ","وقد لاحتِ الأعلامُ والسِّمَةُ البَهر",57,"ر",1,0],["وما جادَه المزْنُ من غُلّةٍ","ولكنْ ليبْكِ النَّدى بالنَّدى",58,"ا",1,0],["وَماجِدٍ في الفَرعِ مِن هاشِمٍ","إِذا اِنتَمى طارَ بِعَبّاسِهِ",59,"س",2,0],["وَماجوا أَن رَأَوا شَمساً","بِلَيلٍ يا لَها فَزعَه",60,"ع",2,0],["وَما جَزَعي مِن زائِلٍ عَمَّ فَجعُهُ","وَمِن وِردِ آباري وَقَصدِ شَعيبي",61,"ب",2,0],["وَما جَهِلَ الحَيُّ مِن عامِرٍ","سُرورَ النُسورِ بِقَتلى النِسارِ",62,"ر",1,0],["وَما جُعِلَت لِأُسودِ العَرينِ","أَظافيرُ إِلّا اِبتِغاءَ الظَفَر",63,"ر",1,0],["وَما جاوَزَت خَيلٌ خَوائِلَ أُلَساً","إِلى الرومِ إِلّا بِالشُرورِ الأَوالِسِ",64,"س",1,0],["وَما جَدَلُ الأَقوامِ إِلّا تَعِلَّةٌ","مُصَوَّرَةٌ مِن باطِلٍ مُتَوَهَّمِ",65,"م",1,0],["وَما جَبَلُ الرَيّانِ عِندي بِطائِلٍ","وَلا أَنا مِن خودِ الحِسانِ بِرَيّانِ",66,"ن",1,0],["وما جلَّاَهُ من سوَّا","هُ إلَّا توأمَ النورِ",67,"ر",1,0],["وما جَنَتْ كفّاكْ","يا غارسَ الكرْمِ",68,"م",1,0],["وما جَهَرْنا ولم يَصْدَحْ مُؤذّنُنا","من خوْفِ كلّ طويلِ الرّمحِ خَدّاعِ",69,"ع",1,0],["وماجَ بعضُ الوحش في بعضها","يَسألُ ما الشأنُ ويَسْتَفْهِمُ",70,"م",1,0],["وما جَرَّ أَذْيالَ الغِنى نَحْوَ بَيْتِهِ","كأَرْوَعَ مُعْرَوْرٍ ظُهُورَ الجَرائِرِ",71,"ر",1,0],["وما جَعَلُوا من دُونِ رَسُولِهِمْ","لَدُنْ آزَرُوهُ مِنْ وُرُودٍ ولا صَدْرِ",72,"ر",1,0],["وما ج فيها رعشة","حرى وشوقا منزلا",73,"ل",2,0],["وما جاشَت الصَّهْبَاءُ إلاّ لأنّها","وقَدْ صَفَّقُوا مَشْمُولَها لا تُناظِرُه",74,"ر",2,0],["وماج الناس حولَ النعشِ مَوْجًا","كأن الحزن ذَؤَبهُمْ؛ فسالوا!",75,"ل",3,0],["وما جر ذلا مثل نفس جزوع","ولا عاقَ عزمًا مثل خوف العواقبِ",76,"ب",1,0],["وما جر أذيال الغنى نحو بيته","كأروع معرور ظهور الجرائد",77,"د",1,0],["وما جَلَسَت حَتّى انثَنَت توسِعُ الخُطا","كَفاطِمَةٍ عَن دَرِّها قَبلَ تُرضِعُ",78,"ع",1,0],["وما جِثتُ أهجوهُ فلمْ يبقَ مَوضعٌ","نَزيهٌ له بالهجو يُؤتى فيُثْلَب",79,"ب",1,0],["وما جعلت عفوات الثناء","إلا لذي الجرأة المتبدر",80,"ر",1,0],["وما جادَه المزْنُ من غُلّة ٍ","بيديّ أمضى منْ لساني مضربا",81,"ب",2,0],["وما جادَه المزْنُ من غُلّة ٍ","حتى يعدّ له الحصى َ والأثلَبا",81,"ب",2,0]]}