ازل","https://www.aldiwan.net/poem3164.html","عموديه"],[464,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[464,"أمالك ودي وهو ملك مخيس","https://www.aldiwan.net/poem3367.html","عموديه"],[464,"رسوم ديار باللوى وربوع","https://www.aldiwan.net/poem3499.html","عموديه"],[464,"سقيت حياً جفني يا بانة الحمى","https://www.aldiwan.net/poem3501.html","عموديه"],[464,"دعاني من ذكر العذيب وعهده","https://www.aldiwan.net/poem3609.html","عموديه"],[466,"بأكناف الحجاز هوى دفين","https://www.aldiwan.net/poem50375.html","الوافر"],[477,"لمن دمن بالرقمتين وأطلال","https://www.aldiwan.net/poem15250.html","الطويل"],[495,"لعمر المعالي إن مطلبها سهل","https://www.aldiwan.net/poem10261.html","الطويل"],[514,"يا من به الجمع في يوم الوغا مشهود","https://www.aldiwan.net/poem20867.html","المواليا"],[514,"يا من بسيف النوال أباد نفس المال","https://www.aldiwan.net/poem20884.html","المواليا"],[515,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[515,"ياليك من بشر تهش وتبسم","https://www.aldiwan.net/poem12259.html","الطويل"],[515,"ولي حرمة الضيف الغريب وحرمة","https://www.aldiwan.net/poem12270.html","الطويل"],[529,"نظام هو الدر الثمين منضدا","https://www.aldiwan.net/poem37444.html","الطويل"],[551,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[551,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[551,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[551,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[551,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[551,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[567,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"],[573,"رضى بقضاء الله فهو مصيب","https://www.aldiwan.net/poem3660.html","الطويل"],[575,"ليل الحمى بات بدري فيك معتنقي","https://www.aldiwan.net/poem3047.html","البسيط"],[575,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[587,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["وَما جُزتُ الثَلاثينَ","بِعامٍ أَو بِعامَينِ",0,"ن",1,0],["وَما جَزَعُ الجَزوعِ وَإِن تَناهى","بِمُنتَصِفٍ مِنَ الداءِ العُقامِ",1,"م",1,0],["وَما جَرى بِالخَيفِ مِن دَمعٍ وَدَم","يَومَ يَطيرُ الناسُ غِربانَ الجُمَم",2,"م",1,0],["وَما جَمعِيَ الأَموالَ إِلّا غَنيمَةً","لِمَن عاشَ بَعدي وَاِتِّهاماً لِرازِقي",3,"ق",2,0],["وَما جَزَعي إِن حالَ لَونٌ وَإِنَّما","أَرى الشَيبَ عَضباً قاطِعاً حَبلَ عاتِقي",3,"ق",2,0],["وَما جالَسوا إِلّا السُيوفَ مُعَدَّةً","لِيَومِ الوَغى وَالمَرءُ مِمَّن يُجالِسُ",4,"س",1,0],["وَما جالَتِ الأَلحاظُ إِلّا بِقاطِرٍ","وَلا اِمتَدَّتِ الأَنفاسُ إِلّا بِحاصِبٍ",5,"ب",1,0],["وَما جَزَعي لِأَن غَرُبَ التَصابي","وَحَلَّقَ عَن مَفارِقِيَ الغُرابُ",6,"ب",1,0],["وَما جَرَّ ذُلّاً مِثلُ نَفسٍ جَزوعَةٍ","وَلا عاقَ عَزماً مِثلُ خَوفِ العَواقِبِ",7,"ب",1,0],["وَما جودُ الزَفيرِ عَلَيكَ جوداً","وَلَكِن ذاكَ مِن لُؤمِ العَزاءِ",8,"ا",2,0],["وَما جِئتُ جَهلاً إِنَّني بِكِ عالِمٌ","وَلَكِن لِأُبلي فيكِ عُذراً إِلى نَفسي",9,"ي",1,1],["وَما جَهلاً تَرَكتُ البَحرَ خَلفي","وَجِئتُكُمُ إِلى مَصِّ الثِمادِ",10,"د",1,0],["وَما جَعَلَ الرَحمَنُ بَيتَكَ في العُلى","بِأَجيادِ غَربِيِّ الصَفا وَالمُحَرَّمِ",11,"م",1,0],["وَماجَ بِزُوّارِهِ المولَعينَ","وَأَضحى بِعَرشِ المُلوكِ اِزدَهى",12,"ا",1,0],["وَما جَبُنَت خَيلي وَلَكِن تَذَكَّرَت","مَرابِطَها في بَربَعيصَ وَمَيسَرا",13,"ر",2,0],["وَما جابَةُ المِدرى خَذولٌ خَلا لَها","أَراكٌ بِذي الرَيّانِ دانٍ صَريمُها",14,"م",3,0],["وما جمع اللَه النظيرين مرةً","كجمعكما والند أولى به الند",15,"د",1,0],["وما جزعي للحرب يَحمَى وطيسها","ولكن لأرواح بها أزهقت صبرا",16,"ر",2,0],["وما جعلوا الأديان إلاّ ذريعة","إلى كل شَغْب بينهم وعداء",17,"ا",2,0],["وما جاء فيهم عادل يستعيلهم","إلى الحق إلا صدّه ألف ظالم",18,"م",1,0],["وَما جَعَلَ الكَواكِبَ أَو سُهَيلاً","كَضَوءِ البَدرِ يَجتابُ الظَلاما",19,"م",2,0],["وَما جُعِلَ القَوادِمُ كَالذُنابى","وَماجُعِلَ المَوالي كَالصَميمِ",20,"م",1,0],["وَما جَنى أَو تَجَنّى","إِلّا اِعتَذَرتُ إِلَيهِ",21,"ي",2,0],["وَما جُمَحٌ وَلَو ذُكِرَت بِشَيءٍ","وَلا تَيمٌ فَذَلِكُمُ الرِعاعُ",22,"ع",1,0],["وماجدٌ حثَّ ركاب السرى","حثّ الرجا الساري إلى قصده",23,"د",2,0],["وما جهلُ الحليمِ لَهُ بجهلٍ","ولكنْ حدُّ أُظفورٍ ونابِ",24,"ب",1,0],["وما جزره إلا استفاضةُ فضله","على ساكني بدو وفي قاطني حَضْر",25,"ر",1,0],["وما جاش مدٌّ مثلُ مدحيَ فيكُمُ","فلِمْ كسبُهم مَدٌّ ولمْ مكسبي جَزْر",26,"ر",1,0],["وما جَربتُهم إلا بغيري","وما استخشنتُ جانبهم بلمسي",27,"س",2,0],["وما جشمتني الطير ما أنا جاشمٌ","بأسبابها إلا ليجشمن مُضلِعا",28,"ع",2,0],["وما جشمت كفه شوكها","ولا جشمت رجله سُحقها",29,"ق",3,0],["وما جُلَّنارٍ بالمُقَصِّر شأوُها","ولا المتعدِّي قصد أهدى المسالك",30,"ك",1,0],["وما جاوزوا إذْ أطنبوا فيك أنْ دَعَوْا","بأسمائك اللائي بها كنتَ تُوسَمُ",31,"م",1,0],["وما جلجل الوجناءَ بين قتودِها","كغضبةِ حُرٍّ شيَّعتْها عزائمُ",32,"م",1,0],["وَما جَرَحَت يَدي بِبَني سُلَيمٍ","وَلا شِعري فَيَهجوني الشَريدُ",33,"د",1,0],["وما جهل العتيق الحر منها","ولا غبى المقلد والدعيا",34,"ي",2,0],["وما جهلوا فوائد ما أضاعوا","ولكن ربما نسى العليم",35,"م",1,0],["وما جاملتموا أهلا ولكن","ذهبتم مذهبا وهو الجميل",36,"ل",1,0],["وما جوابي إِذْ تَقولُ العِدَا","ما صَنَعَ البَيْنُ بِهِ شَيّا",37,"ي",2,0],["وَما جَهِلَت أَيادِيَكَ البَوادي","وَلَكِن رُبَّما خَفِيَ الصَوابُ",38,"ب",1,0],["وما جاء في حكم الأولين","ووافقه المحكم المنزلُ",39,"ل",1,0],["وَما جَهِلتَ فَلا تَجهَل مُحاجَزَتي","لِصاحِبِ البابِ يَرمي عَنهُ حاجِبُهُ",40,"ب",2,0],["وَما جَهِلَ اِبنُ الجَرجَرائِيُّ واجِبي","عَلَيهِ وَلَكِن كانَ أَلأَمَهُم عِلجا",41,"ج",2,0],["وَما جَدَثٌ فيهِ اِبتِسامُكَ لِلنَدى","إِذا أَظلَمَت أَجداثُ قَومٍ بِمُظلِمِ",42,"م",1,0],["وَما جَلَونَ لَنا عَيناً فَنُطعِمَها","بِالنَومِ إِلّا مَعَ الإِصباحِ إِذ حَشَرا",43,"ر",2,0],["وَما جَبَرَت إِلّا عَلى عَتَبٍ بِها","عَراقيبُها مُذ عُقِّرَت يَومَ صَوأَرِ",44,"ر",1,0],["وَما جَرَّبَ الأَقوامُ مِنّي أَناثَةً","لَدُن عَجَموني بِالضُروسِ العَواجِمِ",45,"م",1,0],["وَما جُشَّمُ الأَظهارَ مِثلُ شِمِلَّةٍ","وَحامِلَةٍ لِلهَمِّ ماضٍ صَريمُها",46,"م",3,0],["وما جارَ فيما سارَ قَدرَ قُلامَةٍ","ولكنَّهُ يَشقَى ويَستُرُ غيرَه",47,"ه",1,0],["وما جهلتُ أياديكمْ وفضلكُم","ولوْ جهلتُ أليسَ اللهُ قدْ عَلِمَا",48,"م",2,0],["وما جهلتْ نفسي المعالي وطيبَها","ولكنْ رأتْ أنَّ السلامةَ أطيبُ",49,"ب",1,0],["وَما جَذِلتُ لِشَيءٍ كانَ بَعدَكُمُ","وَلا مَنَحتُ سِواكِ الحُبَّ مِن بَشَرِ",50,"ر",1,0],["وَما جِئتَها أَبغي شِفائي بِنَظرَةٍ","فَأُبصِرُها إِلّا اِنصَرَفتُ بِدائِيا",51,"ي",2,0],["وَما جَهِلَت مَكانَكَ حينَ تُزجي","جُيوشَكَ في المَمالِكِ فاتِحينا",52,"ن",2,0],["وَما جُعِلَت عَفَواتُ الثَنا","ءِ إِلّا لِذي الجُرأَةِ المُبتَدِرْ",53,"ر",1,0],["وَما جَلسُ أَبكارٍ أَطاعَ لِسَرحِها","جَنى ثَمَرٍ بِالوادِيَينِ وَشوعُ",54,"ع",1,0],["وَما جَمَعَ اللَهُ حُبَّ اِمرِئٍ","وَحُبَّكَ أَعدائَهُ في حَشا",55,"ا",1,0],["وما جِهلتْ مِصرٌ وقد قيل مَن لها","بأنّكَ ذاك الهِبْرِزِيُّ السَّمَيذَع",56,"ع",1,0],["وما جهِلَ المنصورُ في المهدِ فضلَهُ","وقد لاحتِ الأعلامُ والسِّمَةُ البَهر",57,"ر",1,0],["وما جادَه المزْنُ من غُلّةٍ","ولكنْ ليبْكِ النَّدى بالنَّدى",58,"ا",1,0],["وَماجِدٍ في الفَرعِ مِن هاشِمٍ","إِذا اِنتَمى طارَ بِعَبّاسِهِ",59,"س",2,0],["وَماجوا أَن رَأَوا شَمساً","بِلَيلٍ يا لَها فَزعَه",60,"ع",2,0],["وَما جَزَعي مِن زائِلٍ عَمَّ فَجعُهُ","وَمِن وِردِ آباري وَقَصدِ شَعيبي",61,"ب",2,0],["وَما جَهِلَ الحَيُّ مِن عامِرٍ","سُرورَ النُسورِ بِقَتلى النِسارِ",62,"ر",1,0],["وَما جُعِلَت لِأُسودِ العَرينِ","أَظافيرُ إِلّا اِبتِغاءَ الظَفَر",63,"ر",1,0],["وَما جاوَزَت خَيلٌ خَوائِلَ أُلَساً","إِلى الرومِ إِلّا بِالشُرورِ الأَوالِسِ",64,"س",1,0],["وَما جَدَلُ الأَقوامِ إِلّا تَعِلَّةٌ","مُصَوَّرَةٌ مِن باطِلٍ مُتَوَهَّمِ",65,"م",1,0],["وَما جَبَلُ الرَيّانِ عِندي بِطائِلٍ","وَلا أَنا مِن خودِ الحِسانِ بِرَيّانِ",66,"ن",1,0],["وما جلَّاَهُ من سوَّا","هُ إلَّا توأمَ النورِ",67,"ر",1,0],["وما جَنَتْ كفّاكْ","يا غارسَ الكرْمِ",68,"م",1,0],["وما جَهَرْنا ولم يَصْدَحْ مُؤذّنُنا","من خوْفِ كلّ طويلِ الرّمحِ خَدّاعِ",69,"ع",1,0],["وماجَ بعضُ الوحش في بعضها","يَسألُ ما الشأنُ ويَسْتَفْهِمُ",70,"م",1,0],["وما جَرَّ أَذْيالَ الغِنى نَحْوَ بَيْتِهِ","كأَرْوَعَ مُعْرَوْرٍ ظُهُورَ الجَرائِرِ",71,"ر",1,0],["وما جَعَلُوا من دُونِ رَسُولِهِمْ","لَدُنْ آزَرُوهُ مِنْ وُرُودٍ ولا صَدْرِ",72,"ر",1,0],["وما ج فيها رعشة","حرى وشوقا منزلا",73,"ل",2,0],["وما جاشَت الصَّهْبَاءُ إلاّ لأنّها","وقَدْ صَفَّقُوا مَشْمُولَها لا تُناظِرُه",74,"ر",2,0],["وماج الناس حولَ النعشِ مَوْجًا","كأن الحزن ذَؤَبهُمْ؛ فسالوا!",75,"ل",3,0],["وما جر ذلا مثل نفس جزوع","ولا عاقَ عزمًا مثل خوف العواقبِ",76,"ب",1,0],["وما جر أذيال الغنى نحو بيته","كأروع معرور ظهور الجرائد",77,"د",1,0],["وما جَلَسَت حَتّى انثَنَت توسِعُ الخُطا","كَفاطِمَةٍ عَن دَرِّها قَبلَ تُرضِعُ",78,"ع",1,0],["وما جِثتُ أهجوهُ فلمْ يبقَ مَوضعٌ","نَزيهٌ له بالهجو يُؤتى فيُثْلَب",79,"ب",1,0],["وما جعلت عفوات الثناء","إلا لذي الجرأة المتبدر",80,"ر",1,0],["وما جادَه المزْنُ من غُلّة ٍ","بيديّ أمضى منْ لساني مضربا",81,"ب",2,0],["وما جادَه المزْنُ من غُلّة ٍ","حتى يعدّ له الحصى َ والأثلَبا",81,"ب",2,0],["وما جهلته انفس وهو كالضحى","وقد تتعامى مقلة المتجاهل",82,"ل",1,0],["وما جهل الاخيار زهر مناقبي","ولي شرف في جبهة الفجر يزهر",83,"ر",1,0],["وما جهلوا مني جليل مناقبي","ولا حبل اتعابي وعسر كروبي",84,"ب",2,0],["وماج على الخدين بحر دم من الد","موع فافنى قوة الصب بالصب",85,"ب",1,0],["وَمَا جَمَعَتهُ مِن حِلمٍ وعِلمٍ","ومِن أدَبٍ ومِن قَدرٍ فَخِيمِ",86,"م",1,0],["ومَا جَلَبَتهُ مِن عِزٍّ وَجَاهٍ","ومَا جَمَعَتهُ مِن وَجهٍ وِسيمِ",86,"م",1,0],["وَما جِئتُ كَيما طالباً منصباً بِه","وَلا حسباًَ يَعلو بِه قدرُ منصِبي",87,"ب",2,0],["وما جئتُ في دين امرِئ متكلما","ولا امرَاةٍ بل جئتُه للتكسبِ",87,"ب",1,0],["وما جاذبوه الفخرَ إلا وحازه","بأيدٍ إلى نَيل العلاء طِوالِ",88,"ل",1,0],["وَماجِدٌ لِسِوى العَلياءِ ما خُلِقَت","أَخلاقُهُ وَلِغَيرِ الفَضلِ ما وُلِدا",89,"د",2,0],["وَما جُحِدَت عَلياؤُهُم غَيرَ أَنَّهُ","أَتى حادِثٌ أَنسى القَديمَ وَأَذهَلا",90,"ل",2,0],["وَما جِئتُ مَحموداً وَنَصراً بِمِثلِها","لَعَمرُكَ إِلّا فَضَّلاها وَأَفضَلا",90,"ل",2,0],["وَما جادَتِ الخَضراءُ إِلّاتَغَيَّمَت","فَلِلَّهِ نَوءٌ لا يَغيمُ إِذا هَما",91,"م",2,0],["وَما جازَيتُ مِن نُعماكَ يَوماً","عَلى أَنّي أَفوتُ القائِلينا",92,"ن",2,0],["وما جرت بركاتُ الله فيه فما","يكون للصرف في تنقيصه أَثرُ",93,"ر",1,0],["وماجوا كموجِ البحر يركب بعضُهم","على بعضهم في ضمن عسكرك اللجب",94,"ب",1,0],["وما جهلوا قدما سطاك وأخذها","وإنك للخشيتي في القرب والبعد",95,"د",1,0],["وَماجِدٌ كانَ نِعمَ المُستغاثُ إِذا","دَعا إِلى الحَربِ داعِيها فَلم يُجَبِ",96,"ب",1,0],["وَما جَفَّ دَمعي بَعدَهُ غَيرَ أَنَّهُ","يُدبِّجُ خَضراءَ الرُبَى حينَ يَسجمُ",97,"م",1,0],["وما جُبتُ في نارِ الأسى غيرَ عالم","ولا خُضْتُ في بحرِ الهوى غير عارف",98,"ف",1,0],["وَما جوّزوا لِلمُسلمين رَحيلهم","لِزورةِ خير الخلقِ في طيبة الغرّا",99,"ر",2,0],["وما جَزَعي إلاّ لأبلجَ إن سرى","مع البدرِ وَهْنَاً قيلَ أيُّهما البدر",100,"ر",1,0],["وما جَمَدَتْ عَيْنُ امرئٍ يومَ بَيْنِهِ","ولكنَّ عيناً لم تجُدْكَ جَمُود",101,"د",1,0],["وما جَنَّت الظّلماءُ إلا لبستُها","دثاراً على ضافي شعور الذوائبِ",102,"ب",1,0],["وما جفاني مَن كان لي أُنُساً","أنستُ شوقاً ببعض أسبابهْ",103,"ب",2,1],["وما جازَ ما جاوزتماه ولم يكن","ليذهب تلبيسٌ على معدن اللُّبسِ",104,"س",1,0],["وما جناه رقيبي","وما جناه عذولي",105,"ي",1,0],["وما جاد لي يوماً بسهم من اللقا","على أن لي من لحظ عينيه سهمان",106,"ن",1,0],["وما جَحدوا الحقَّ الذي لك فضلهُ","ولكنْ بهم عنه عمىً وهُروب",107,"ب",1,0],["وَمَا جَرَى نَهَرٌ وَمَا ذَكَى زَهَرٌ","وَمَا تَرَبَّعَ مِنْ صَوْبِ الْحَيَا كَلَأُ",108,"ا",1,0],["وما جئت أهديه على الورد والوفا","عروس تحيّاتٍ من الحسن تنجلي",109,"ل",2,0],["وما جهد من يبغي اللحاق لشأوهم","ولو ركب النكباء في سيرها شهرا",110,"ر",2,0],["وما جُرُحُ القلبِ الشريفِ كلقمةٍ","إذا نزلت في الحلقِ تُصبحُ عَلقما",111,"م",2,0],["وَما جسمي عَلى الحدثان صخر","وَلا قَلبي عَلى البَلوى حَديد",112,"د",1,0],["وما جارَ الغَرامُ عليَّ حتَّى","تأكّد بَيْننا سَبَبُ الجِوارِ",113,"ر",1,0],["وَما جَارَتْ خُطُوبُ الدَّهْرِ إِلاَّ","وَجَدْتُكَ مِنْ حَوَادِثِها أَمانا",114,"ن",2,0],["وَما جُحِدَتْ مَحاسِنُ فَخْرِ قَوْمٍ","خَلائِقُكَ الْحِسانُ بِها شُهُودُ",115,"د",1,0],["وَما جَوْهَرُ الأَشْياءِ وَالْخَلْقِ خافِياً","إِذا ما طِباعٌ مُيِّزَتْ وَخِلالُ",116,"ل",1,0],["وَما جاراكَ فِي فَضْلٍ فَخارٌ","فَلَمْ تَجْتَزْ مَدى الْفَضْلِ اجْتِيازا",117,"ز",2,0],["وما جَهِلَتْ نُعْماهُ عِنْدَكَ قَدْرَها","وَقَدْ كَشَفَتْ عَمّا طَوى فِي الْضّمائِرِ",118,"ر",1,0],["وَماجَ كالغُصنِ فَوقَ الدعصِ قامَتُهُ","ولاحَ نَورُ أَقاحٍ من ثَناياهُ",119,"ا",2,0],["وَما جَداهُ غَيرُ إِحضارِهِ","لَدَيكَ وَالقَهوَةُ تروي الصَدا",120,"د",2,0],["وَما جَوابُ العَذولِ عِندي","حَتّى نَهاني إِلّا الصُماتُ",121,"ت",1,0],["وَما جلهَت نَفسي بأَنَّ شرابَه","سَرابٌ وَبَرد العيش منه شُواظُ",122,"ظ",1,0],["وَما جزعُ الإنسانِ في موقفِ النوى","عجيباً وَلكن السلوَّ عجيب",123,"ب",1,0],["وما جزع الإنسان في حالة البلا","سوى تعب في الحال يذهب بالأجر",124,"ر",1,0],["وما جمعنا بعد افتراق بمعجز","وهل آخر يخلو عن الأولية",125,"ه",1,0],["وَما جُعِلَت أَرزاقُنا بِيَدِ اِمرِئٍ","حَمى بابَهُ مِن أَن يُنالَ دُخولا",126,"ل",2,0],["وما جنوني إلا أنني بشر","أسير بين قذارات وأوحال",127,"ل",1,0],["وَما جادَ غَيث أَرّخوا بِسَحابه","بِخَير نَجيب لِلسَعيد أَمينهُ",128,"ن",2,0],["وَما جزت حَتّى حزت كُلّ فَضيلَةٍ","وَفَضلٍ وَعاه مِن ذَوي اللُبِّ مَن وَعى",129,"ع",2,0],["وَما جاوَزَت إِلّا أَشَمَّ مُعاوِداً","كِفايَةَ ما قيلَ اِكفِ غَيرَ مُذَمَّمِ",130,"م",1,0],["وما جعل الدّهْرَ صَعْبَ الإباءِ","سوى أنَّه بذُراكَ احتمى",131,"ا",1,0],["وما جاد بالطّبعِ كفُّ السحا","بِ بلْ بمِثالِ يدَيْكَ احتذى",131,"ا",1,0],["وَما جِئتُهُ يَوماً بِنَشطَةِ مَطمَعٍ","فَأَرجَعَني إِلّا بِفَترَةِ ياسِ",132,"س",1,0],["وَما جَمَعَت إِلّا العِيادَةُ بَينَنا","فَلَيتَكَ لا قَد كُنتَ أَنَّكَ تَمرَضُ",133,"ض",1,1],["وَما جَهِلتُ وَلَيسَ الجَهلُ مِن شِيَمي","أَن لا قَرابَةَ بَينَ الحَظِّ وَالأَدَبِ",134,"ب",1,0],["وَما جَرى في الحَديثِ مُغضَبَةٌ","بِكُلِّ شَيءٍ مِنكُم وَلا الغَضَبُ",135,"ب",1,0],["وما جارَتِ الأيامُ إِذ كانَ عدلُها","مِن الجَورِ لكِن جارَ من سامَها العَدلا",136,"ل",2,0],["وما جَسَرَت لولاكَ أن تَضمن الغِنى","ولَكن علَى جَدوى يَديكَ اتِّكالُها",137,"ل",3,0],["وماجداً كدتُ أن أكونَ بما","وصفتُه من خلالِه ماجِد",138,"د",1,0],["وما جَرَت عادةُ الزَّمانِ بِأَن","يَأتي بِخيرٍ فَما لَهُ نَشَطا",139,"ط",2,0],["وما جاهد سوى من","قهر أهوى غويات",140,"ت",1,0],["وما جَهلوا قدري لديهم ورفعتي","وأنّ زماني فيهمُ زمن الوردِ",141,"د",1,0],["وما جفّ دمعي يومَ الوداع","سلوّاً ولا قلّ فيك اشتياقي",142,"ي",1,0],["وما جَهِلَتْ أن العراقَ معيشةٌ","وروضٌ تُربِّيهِ صَباً وقَبولُ",143,"ل",1,0],["وما جَنَى قطُّ إلاّ جئتُ مُعتَذِراً","إِليهِ لكنَّ عُذري غيرُ مقبولِ",144,"ل",1,0],["وما جود الرَّوائح والغوادي","فإنَّ الجودَ جودُك والسَّلام",145,"م",1,0],["وما جاءنا سيّد المرسلين","وقام الدليل ببرهانها",146,"ن",3,0],["وما جُذامٌ سوى أُسْدٍ براثِنُها","يفنى بهنَّ أَديمُ الهمِّ والحَزَنِ",147,"ن",1,0],["وما جالَ جيشُ الحُبِّ إِلا استباحَنِي","فؤادي ولو أَصْبَحْتُ من آل مازِن",148,"ن",1,0],["وما جُسَيْماتُ المعالي سوى","لُعابُ ذاك الأصفرِ الضامرِ",149,"ر",1,0],["وما جاء يبقي جود كفّيك قاصد","يروم الفنى إلا وتمت وسائله",150,"ل",2,0],["وما جمعوا لها مالاً طريفاً","وما حنقوا على وفر التراث",151,"ث",1,0],["وما جازع منا من الموت سالم","وما هارب منا لنهج بمهتد",152,"د",1,0],["وماج البحر بالاسطو","ل فالحيتان لا تروى",153,"ا",1,0],["وما جزعى لشيء غير أني","أخاف من العدو على الحبيب",154,"ب",1,0],["وما جرى من دمعه الاّ الذي","ضاقت عن اكتنافه ضلوعه",155,"ع",2,1],["وما جرير ونداه إذ احتدمو","في ساحة الشعر للفصحى ذوي حسد",156,"د",1,0],["وما جزعت لنفسي مثلما جزعت","نفسي لغيري وقد هانوا وما جزعوا",157,"ع",3,0],["وما جَلَبت ثلاثُ منىً","على العشّاق من فتنِ",158,"ن",1,0],["وما جَهِلتْ أنّ الحِجاز معيشةٌ","وروضٌ يربّيه الحيا وقَبولُ",159,"ل",1,0],["وماجد الآباء في منصب","تأوي إليه درجات المعال",160,"ل",1,0],["وما جنت خيبةً كرِجلِ فتىً","يمشي على النار غيرَ مشتعِلِ",161,"ل",1,0],["وما جنت الفرسُ أُولى الزمانِ","على الروم فاقتصَّني بالأُولْ",162,"ل",1,0],["وما جرى الدمُ في الوادي وقد نحروا","وسُربِلَ البيتُ من حُجْبٍ وأستارِ",163,"ر",1,0],["وما جرى الصومُ وجا","ء الفطرُ يحدو الأضحى",164,"ح",2,0],["وما جنتِ الذي يجنيه قلبي","على جسمي العُداةُ ولا الخُطوبُ",165,"ب",1,0],["وما جنحت سادات بكر بن وائل","إلى السلم حتى أقبلوها المذاكيا",166,"ي",2,0],["وما جزعتُ لخطبٍ عاثَ في شرفي","فالشمس تشرق أحياناً وتنكسفُ",167,"ف",1,0],["وما جَمُّ الغَواربِ ذو زَهاءٍ","يحطُّ صَفا الشَّوامِخ والسِّلاما",168,"م",2,0],["وما جلوتَ الوغى سوداً ملابسها","إلاَّ انثنت وعليها من دمٍ حُلل",169,"ل",1,0],["وما جادها الوسمي حتى تصاهلت","فأسقط للخوف السحاب الحوامل",170,"ل",1,0],["وما جاده الغيث عن فاقة","ولكنه جاءه مستفيدا",171,"د",2,0],["وما جاش من آذيهِ قط زاخرٌ","كعلمك إلاَّ والسَّماحُ طلائعه",172,"ع",2,0],["وما جهلتْ لمياءُ أن ضجيعها","إذا خيفتِ الأدناس خيرُ ضجيع",173,"ع",1,0],["وما جلَّقٌ في المدن إلاّ كغيرها","إذا لم يحطها ظاعناً ومخيّما",174,"م",2,0],["وما جزعي للبرق سلَّ حسامهُ","بنانُ الحيا حتى قتلتُ بحدِّه",175,"د",2,0],["وَما جارانِ مُؤتَلِفانِ إِلّا","سَيَفرِقُ بَينَ جَمعِهِما المَنونُ",176,"ن",1,0],["وما جالَ ذكرُ البينِ والوصلُ مكثبٌ","حِذارَ النوى إلا عرتنَي أوجالُ",177,"ل",1,0],["وما جلّ هذا الناس إن تبلهم أبو","عليّ حسين أو أبو طيب سهل",178,"ل",1,0],["وماجد بعد خلّاقي عليهِ اِحتسب","لما عشقت المدح وأنا عشقت الكسب",179,"ب",1,0],["وماجد مذ نشا نحو المكارم مال","ومن بسيفهِ عروش المعتدين أمال",180,"ل",1,0],["وما جهلت قط الوزارة أنه","يكون بلا شك إليك مصيرها",181,"ر",3,0],["وما جهلت أيام إسنى وطنبد","وساحل هروط بأنك ضيغم",182,"م",1,0],["وما جاءني من قلة الحزم حادث","وإني لمدلول على طرق الحزم",183,"م",1,0],["وَمَا جَاءَ للتَّعْلِيمِ فيما عَلِمْتُهُ","خُصُوصٌ وَلا الإطْلاقُ مِنْها مُقَيّدا",184,"د",2,0],["وَما جاءنا إلّا بِأَسعدِ طالعٍ","وَلا زارَنا إِلّا بأفضلِ عامِ",185,"م",1,0],["وما جذلتُ لشيء في الزّمان وقدْ","أَسحبتني باِجتبائي حُلَّةَ الجَذَلِ",186,"ل",1,0],["وما جاد جَفنِي وقد كان لا","يجودك إلّا على الأجودِ",187,"د",1,0],["وَما جِئتُه وَالرشدُ عنّي بمعزِلٍ","فَأَطلعنِي إلّا عَلى ذرْوَةِ الرّشدِ",188,"د",1,0],["وما جرى في النّاس شيءٌ لهمْ","مَجرى سَوادِ العينِ والقلبِ",189,"ب",1,0],["وَما جانَبوك عَن قِلاهمْ وإنّما","تَناءَوْا جَميعاً عن بعيدٍ مجانِبِ",190,"ب",1,0],["وَمَا جَمَّعْتَ مِنْ غَرْسٍ","وَمِنْ حَرْثٍ وَمِنْ بَذْرِ",191,"ر",1,0],["وَما جَزَعي لِلحادِثاتِ اِستِكانَةً","وَلَكِنَّهُ لِلهالِكينَ نَصيبُ",192,"ب",1,0],["وما جفونك تلْويها على سَهري","ولا ضلوعُك تطْويها على حُرَقي",193,"ق",2,0],["وما جاهروني بالنَّصالِ وإِنَّما","عقاربهم في السِّر تسْرى وتحْتدُّ",194,"د",1,0],["وما جاء نص في الكراهة أن تدر","إلى القمرين الفرج غير خير مرشد",195,"د",1,0]]}