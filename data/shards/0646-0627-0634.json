,""],[5956,"الجنة العظمَى","https://www.poetsgate.com/ViewPoem.aspx?id=194703",""],[5956,"عاشت مضحيةً","https://www.poetsgate.com/ViewPoem.aspx?id=203447",""],[5956,"لله درُّك يا ابنَ الفيصل الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=204197",""],[5956,"الرضيع أرتين يساعد جَدّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=205173",""],[5956,"نجْلي فراس الطاهرُ الرُّوحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215496",""],[6093,"دَعِ التماسَ الهوى مِنْ ظبية الآس (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176196",""],[6152,"إلى متى ؟","https://www.poetsgate.com/ViewPoem.aspx?id=202594",""],[6072,"أرَقٌ وغَرَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82190&r=&rc=22",""]],"verses":[["ناشِئاً تُسلِمُهُ الأُم","مُ إِلى الظِئرِ الشَفيقَه",0,"ق",2,0],["ناشدتكم عهدَ المودة بيننا","والعهد فينا لم يَزَلْ مسؤولا",1,"ل",2,0],["ناشدْتكَ الله في ودٍّ عنيت به","شطراً من العمرِ لا يألوه مجهود",2,"د",1,0],["ناش على الحرِّ وتقليب المنن","كأنما مزجته من اللَّبن",3,"ن",1,0],["ناشدتك اللَّه في قَدري ومنزلتي","لديك لا يتطرَّقْ منهما العبثُ",4,"ث",1,1],["ناشدتك اللّه والحفاظَ وإحْ","سانك بي أن تَفُتَّ في عَضُدي",5,"د",2,0],["ناشر ذكر إذا التقت عُصَبٌ","حالت به المسكُ في مناشقها",6,"ق",3,0],["ناشدْتُك اللَّه والمودّة في ال","لَهِ فإني أعُدُّها رَحِما",7,"م",2,0],["ناشدتُكَ اللهَ في أشياءَ مُسْلفةٍ","لا يَمْحُها من كتابي عندكَ القِدَمُ",8,"م",1,0],["ناشدتُكَ اللَّه يا أبا حسن","في حرمة لم تُذَل ولم تهُن",9,"ن",1,0],["ناشدتُك الله أن تستفسِدَ المننا","يا ابنَ الوزيرين أو تستشهد الظِّننا",10,"ن",2,1],["ناشدت شيخاً قد تقو","وس ما تفتش في الترابِ",11,"ب",1,1],["ناشَدتُكُم تِلكَ الدِماءَ زَكِيَّةً","لا تَبعَثوا لِلبَرلَمانِ جَهولا",12,"ل",2,0],["ناشِئٌ في الوَردِ مِن أَيّامِهِ","حَسبُهُ اللَهُ أَبِالوَردِ عَثَر",13,"ر",1,1],["ناشوا الرِماحَ وَكانَت غَيرَ ناطِقَةٍ","فَعَلَّموها صِياحَ الطَيرِ في البُهَمِ",14,"م",1,0],["ناشَدتَهُم بِاللَهِ يَومَ لَقيتَهُم","وَالخَيلُ تَحتَ عَجاجَةٍ كَالنيمِ",15,"م",1,0],["ناشدْتُهُ أنتَ نحوي","فشدَّدَ الياءَ عامدْ",16,"د",1,1],["ناشَدَتنا العَهدَ المَصونَ فَكُنّا","أُمَّةً بَرَّةً وَشَعباً أَمينا",17,"ن",2,0],["ناشدتُك الإسلامَ لا تقتلي","أخاك في دينِكِ يا قاسيهْ",18,"ي",2,0],["ناشدوه القُرْبَى التي من قُرَيْش","قطعَتْهَا التِّراتُ والشَّحْناءُ",19,"ا",2,0],["ناشدتُكَ اللهَ إن جُزْتَ العَقِيقَ ضُحىً","فاقْرَ السّلاَمَ عليهِمْ غيرَ مُحْتَشِم",20,"م",1,0],["ناشراتٍ وشَى الربيع عليها","ساكباتٍ في لجّهِ ألوانَه",21,"ن",2,0],["ناشدْتُكِ الحبَّ فإنْ تؤثري","جدّدتِ أسماركِ في مخدعي",22,"ي",1,0],["ناشراً فوق عُرضِهِ من جنا","حيَّ ظِلالَ الهمومِ والحسراتِ",23,"ت",1,0],["ناشَدتُكَ اللَهَ يا طَيرَ الحَمامِ إِذا","رَأَيتَ يَوماً حُمولَ القَومِ فَاِنعاني",24,"ن",2,0],["ناشَدتَنا بِكتَابِ اللهِ حُرمَتَنا","ولَم تَكُن بِكتَابِ اللهِ تَرتَفِعُ",25,"ع",1,1],["ناشِقاً مَا حَوْلَهُ مُلْتَفِتاً","فِعْلَ مَنْ أَوْجَسَ كَيْداً فَاقْشَعَرَّا",26,"ر",2,0],["ناشدتُك العَدْل فيه، والعروبةَ، بل","ناشدتك الله، والإسلامَ، والحَسبا",27,"ب",2,0],["ناشِرًا من فوقه أعلامَه","تفزَعُ العِقْبانُ منها والبُزَاة",28,"ا",2,0],["ناشدتُهُمْ وقد اعْتْلَيتُ حَفيره","أأبو علي وَسْطَ هذا مُودَع",29,"ع",1,0],["ناشدتُ جندكَ جندَ الشعبِ والحرسا","أن لا تَعودَ فلسطينٌ كأندلُسا",30,"س",2,1],["ناشدْتُك الله أن تسقي الدماءُ غداً","غَرْساً لجَدِك في أرجائِها غُرسا",30,"س",2,0],["ناشدْتُك اللهَ والظلماءُ مطبقةٌ","على فلسطينَ أن تُهدي لها قَبَسا",30,"س",2,0],["ناشدتُكم بالحَمِيّات التي دفعت","بكم لذكرِيَ والإِعلاءُ من شاني",31,"ن",2,0],["ناشدتك اللّه وأيامنا","ونشوة الحب بوادي الصبا",32,"ب",2,0],["ناشدتك اللّه والأردن هل قبسا","خداك لونهما من لونه القاني",33,"ن",2,0],["ناشدتكَ الله اسقينَّ رُبى الحمى","سُحُباً تطرِّزها بنوءِ المِرْزَم",34,"م",1,0],["ناشدتكَ اللهَ نسيمَ الصَّبا","أين استقرَّتْ بعدَنا زينبُ",35,"ب",1,0],["ناشدتِك اللهَ في ظُلْمي فما قَتلتْ","عيناك أَنصفَ مِنّي في المحِبِّينَا",36,"ن",2,1],["ناشِفَةِ الأَلوانِ مِن","ماءِ الحَياءِ مُكدِيَه",37,"ي",2,0],["ناشَدتُها وَلِأَدمُعي","في الخَدِّ سَحٌّ وَاِنسِكابُ",38,"ب",1,0],["نَاشَدْتُكَ اللهَ دَعْنَا وَصَبَابَتَنَا","يَا مَنْ غَدَا بِنِبَالِ اللَّوْمِ يَصْمِينَا",39,"ن",2,0],["ناشَد