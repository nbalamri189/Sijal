حبرٍ من العطر",124,"ر",1,0],["وانا كثر اللجاجه في خيالي","يورّدني بحور الهائمينا",125,"ن",2,0],["وأنا كما قد كنْتِ قلبٌ عاشقٌ","إنْ تطلبي لقياهُ جاء مُهَرْولا",126,"ل",2,0],["وأنا كلي فدا روحك .. حبيبي والجفى حراق","الى منّك .. هجرتيني .. يزيد الشوق .. نيرانه",127,"ن",2,0],["وأنا كل ماعدلت حوضن تمايل حوض","اطردك ياحضن مقفي ومناحشي",128,"ش",2,0],["وإنَّ اكثركَمْ في فتنتي سقطوا","وإنَّ معظمَكُمْ في عالمي تاهوا",129,"ا",1,0],["وأنا كيومٍ مرَّ منهُ كثيرُهُ","والشمسُ آيلةٌ بهِ لِغُروبِ",130,"ب",1,0],["وانا كل ماتليم واناديه بحتيرام","اضيع ودورني ليا قال لي \" لبيه \"",131,"ي",2,0],["وانا كلي بعد لك يا حبيبي","عطيه في كرمها وايليه",132,"ل",3,0],["وأنا كما الطير الأسير بمعزل","والقيد يا نجوااي يحكم أسري",133,"ر",2,0],["وأنا ك (رُميو) أنتِ عزفُ ربابتي","تَشتاقُ شُرْفاتُ اللِّقا تَلحيني",134,"ن",2,0],["وأنا كما ترني أعيش مذبذباً","ما بين حقد أسود وشقاق",135,"ق",1,0],["وأنا كنت من سمائك شمساً","ونخيلاً ونرجساً وخزامى",136,"م",2,0],["وأنا كنت فوق رأسكَ تاجاً","وأنا كنت للحقول غَماما",136,"م",2,0],["وإِنْ أَكُ مّنباً فَعَفَوْتَ عنِّي","فإنَّ اللّه يعفو عَنْ عَبَادِهْ",137,"د",2,0]]}