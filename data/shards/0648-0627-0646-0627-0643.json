,"","https://poetry.dctabudhabi.ae/diwan/poem/75854","الوافر"],[4675,"المرجان في وصف الخلان","https://www.poetsgate.com/ViewPoem.aspx?id=201394",""],[4755,"حَجْر الله\" الصحي","https://www.poetsgate.com/ViewPoem.aspx?id=211332",""],[4778,"إذا لم ينقضي الأَرَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=188275",""],[4927,"فرحة الاعياد","https://www.poetsgate.com/ViewPoem.aspx?id=4589",""],[4927,"أهلا وسهلا","https://www.poetsgate.com/ViewPoem.aspx?id=29615",""],[5038,"سكت الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=189980",""],[5057,"ياخاله","https://www.poetsgate.com/ViewPoem.aspx?id=203632",""],[3591,"لا زاهدٌ في الدنيا كلٌّ لقد كذبا","https://www.poetsgate.com/ViewPoem.aspx?id=149398",""],[5128,"لَبَّيكْ","https://www.poetsgate.com/ViewPoem.aspx?id=214000",""],[5136,"أسموط در فصلت بالعسجد","https://www.poetsgate.com/ViewPoem.aspx?id=121799",""],[5232,"تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=213462",""],[5277,"عذراً حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=187573",""],[5277,"وجهُها والشوقُ","https://www.poetsgate.com/ViewPoem.aspx?id=191630",""],[5277,"الحمامةُ الزاجلةُ","https://www.poetsgate.com/ViewPoem.aspx?id=206029",""],[308,"أروضة تَبَسم عَن زهر","https://www.poetsgate.com/ViewPoem.aspx?id=189193",""],[5349,"ألم تعلمي يا عَمرِك الله أنني","https://www.poetsgate.com/ViewPoem.aspx?id=52704",""],[5480,"من هموم ِ","https://www.poetsgate.com/ViewPoem.aspx?id=9868",""],[5558,"أردْتُ قطاف النجم من جانب البدْر","https://www.poetsgate.com/ViewPoem.aspx?id=211688",""],[5573,"الا هُبي بغيثكِ فامطرينا","https://www.poetsgate.com/ViewPoem.aspx?id=215491",""],[5628,"الحب الدائم","https://www.poetsgate.com/ViewPoem.aspx?id=178530",""],[5652,"كيان الروح","https://www.poetsgate.com/ViewPoem.aspx?id=192065",""],[5694,"مدير الحب","https://www.poetsgate.com/ViewPoem.aspx?id=132094",""],[5804,"حوار معا الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=191224",""],[5809,"إبحار","https://www.poetsgate.com/ViewPoem.aspx?id=205094",""],[5843,"\" تيب \" اضحي بحرف \" الطاء\" علشانها واللغيه","https://www.poetsgate.com/ViewPoem.aspx?id=51301",""],[5848,"الدعيع والشلية","https://www.poetsgate.com/ViewPoem.aspx?id=49006",""],[5853,"سطو الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=178346",""],[5939,"حرّيّتي عيناك","https://www.poetsgate.com/ViewPoem.aspx?id=180002",""],[454,"النكسة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82662&r=&rc=26",""],[6321,"نحن من علَّم الغرامَ الغراما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63419&r=&rc=2",""],[572,"أخٌ لي كُنتُ أُغبَطُ باعتقادِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9249&r=&rc=106",""]],"verses":[["وأنا كالراغب المحروم في","موكب الغيد المثير السافر",0,"ر",1,0],["وَإِن أَكُ قَصراً في الرَجالِ فَإِنّني","إِذا حَلَّ أَمرٌ ساحَتي لَطَويلُ",1,"ل",1,0],["وأن أكُ قد شكوت فما شَكاتي","إلى ذي خلّة شيء مَعيب",2,"ب",1,0],["وَإِن أَكُ ذا مالٍ كَثيرٍ أَجُد بِهِ","وَإِن يُعتَصَر عودي عَلى الجَهدِ يُحمَدِ",3,"د",1,0],["وإن أكُ من نداهُ على صعودٍ","فإني من نداك على انصبابِ",4,"ب",1,0],["وإن أك قد أحسنت فيه فإنه","بما أحسنت قبلي يداك الصنائعا",5,"ع",2,0],["وإن أكن فيه ساقطاً زَمِناً","فليعطني الحقُّ حصةَ الزَمِنِ",6,"ن",1,0],["وَأَنا كَالسَدمِ مِن أَسماءَ إِذ ظَعَنَت","أَوهَت مِنَ القَلبِ ما لا يَشعَبُ الصَنَعُ",7,"ع",1,0],["وَأَنا كَذَلِكَ لا يُفارِقُني الضَجَر","حَتّى تُداعِبَ لِمَّتي بِيَدَيها",8,"ا",1,0],["وَإِن أَكُن قَصّرت عَن وَصفِها","فَحُسنُها عَن وَصفِها شاغِلي",9,"ل",2,0],["وان اكبر شيء فيك يعجبني","سخرية بتقاليد وعصيان",10,"ن",1,0],["وأن أكون نادماً","ولات حين مندم",11,"م",1,0],["وإِن أكُ قد فارقتُ بابكَ طائعاً","فللدهرِ في الشملِ الجميع عَرَامُ",12,"م",1,0],["وَإِن أَكُ قَد عاتَبتُ بَكراً فَإِنَّني","رَهينٌ لِبَكرٍ بِالرِضا وَالتَكَرُّمِ",13,"م",1,0],["وَإِن أَكسَبَتني بِالخُطوبِ تَجارِباً","فَقَد وَهَبَت أَضعافَ ما أَخَذَت مِنّي",14,"ن",2,0],["وأنا كطيرٍ في الروابي صادح","أشجته أفنانُ الربيع الزاهرِ",15,"ر",1,0],["وإن اكتسابَ الغنى بالمديحِ","مهينٌ له مؤلمٌ موجعُ",16,"ع",1,0],["وإن أكلَتْه عوادي الذّئاب","ففي عِرضِه وَقعَ الآكلُ",17,"ل",1,0],["وَأَنا كاِبنِ هانِىءٍ","في الصِبا حِلفُ سَكرَتَين",18,"ن",1,0],["وإن أكفر النعمى وألقاك مثقلا","بأعبائها إني إذن لسروق",19,"ق",1,0],["وَإِنَّ أَكلَ الأَمرَ موبِقُها","وَمُطلِقٌ مِن لِسانِ عائِبِها",20,"ب",3,0],["وَإِن أَكبَروا الإِفطارَ أَو شَنَّعوا بِهِ","أَعَدنا لَهُم يَوماً جَديداً عَلى الراسِ",21,"س",1,0],["وَإِن أَكُ بَصرِيّاً فَإِنَّ مُهاجَري","دِمَشقُ وَلَكِنَّ الحَديثَ شُجونُ",22,"ن",1,0],["وَإِن أَكُ قَد صَحَوتُ فَرُبَّ يَومٍ","يَهُزُّ الكَأسُ رَأسي وَالغِناءُ",23,"ا",2,0],["وإن اكتفى غَيري بطَيفِ خيالِهِ","فأنا الّذي بوِصالِهِ لا أكتَفي",24,"ف",2,0],["وَإِن أَكُ عَن لَيلى سَلَوتُ فَإِنَّما","تَسَلَّيتُ عَن يَأسٍ وَلَم أَسلُ عَن صَبرِ",25,"ر",1,0],["وَإِنْ أَكنْ فِي الَّذِينَ أَهْدُوا","لَمْ أُهْدِ إِلاَّ خَطِّي وَطِرْسِي",26,"س",2,0],["وإن أكُ قصراً في الرِّجال فإنّني","إذا حَلَّ أمْزٌ سَاحَتِي لَطِوِيلُ",27,"ل",1,0],["وإن أكن غبت جسماً عن ملاحظتي","فإن قلبي بفضل اللَه لم يغيب",28,"ب",1,0],["وأنا كأهل الكهف نصون وما نعى","قتيلاً ولو أن الرقاد قرون",29,"ن",1,0],["وَإِن أَكدى فَتامِكَةٌ تُؤَدّي","وَإِن أَربى فَإِنّي غَيرُ نِكسِ",30,"س",1,0],["وإن أك مفردا بين الأعادي","فقد تحمي البنانة بالقلامه",31,"م",2,0],["وإن أكُ بينَ الواجدينَ ابنَ ساعتي","فما أحدٌ بعدَ القنوعِ فقيرُ",32,"ر",1,0],["وأنا كمن لا يبتغي أبداً","من بعد لذة روحه نفعا",33,"ع",2,0],["وإن أكُ بدراً فالبدور اقتباسها","من الشمس يبدو نورها في دجى العتم",34,"م",1,0],["وأنا كأسيَ تعميني","فأنسى صبحى",35,"ح",2,0],["وانا كذاك أرى الحياة حقيرة","فجزيتها الاعراض والتقطيبا",36,"ب",2,0],["وَإِن أَكُن عَبدَ هَواها فيهِ","رُحتُ لِأَربابِ الغَرامِ سَيِّدا",37,"د",2,0],["وأنا كأني ساهرٌ في راقدٍ","ولسان فكري فوق قلبي يخطب",38,"ب",1,0],["وَإِن أَكتُم الشَكوى يَقل فَيض عبرَتي","عَلى كُل حال أَنتِ لا بُدَّ لي مِنك",39,"ك",1,0],["وإن أكُنْ كزُهيرٍ في الثّناء فقَد","علوتَ مجداً وجُوداً عن مدَى هَرِمِ",40,"م",1,0],["وإِن أَكن كنت منهم عشت دهرهم","إِن التراب نما من أَصله الذهب",41,"ب",1,0],["وأنا كما ترني أعيش مذبذب","ما بين حقد أسود وشقاق",42,"ق",1,0],["وأنا كأنيّ لم أَخصَّ بها","شعري ولم يزخر بها زمني",43,"ن",2,0],["وأن أكون الشريكَ في جمّة ال","ماءِ كما قد شُركتُ في الوشَلِ",44,"ل",1,0],["وإن أك من كِسْرَى وأنت لغيره","فإنيَ في حبّ الوصيّ نسيبُ",45,"ب",1,0],["وإنْ أكن مادحاً من غير قارضةٍ","فربما كنتُ يوماً حيَّةَ الوادي",46,"د",2,0],["وإنْ أكُنْ مادحاً نفسي ومفتخراً","فآفة الظرف للمستظرف الصَّلَفُ",47,"ف",1,0],["وإنْ أكُ محسناً في مدح خلق","فمنكَ ومن صفاتك مستعار",48,"ر",1,0],["وإن أكبر غبن أن تقاس بهم","ما كل غبن من الدنيا بمحتمل",49,"ل",1,0],["وَإِن أك حالِكاً لَوني فَإنّي","لِعَقل غَيرِ ذي سَقَط وِعاءُ",50,"ا",2,1],["وإنْ أكُنْ مُقَصِّراً","فَطَوْلُهُ طَوَّلَني",51,"ن",2,0],["وأنا كَمِرآةٍ لأعمالِ الأنا","مِ أرى المَليحَ وضدَّه للرَّائي",52,"ا",2,0],["وإنْ أكُ في دار الهوى وسْطَ عَقْرِها","فإنّك عن دار الصّبابةِ رائغُ",53,"غ",1,0],["وإن أَكُ مُذْنِباً وَعَفوْتَ عنَّي","فإن اللَّهَ يعفو عن عبادِهْ",54,"د",2,0],["وَأَنا كَفاني مِنكَ ما لاقَيتُهُ","وَاللَهُ حَسبي وَالنَبيّ المُصطَفى",55,"ف",2,0],["وإن أكثر من يبكي عليك أسى","متيَّمٌ تُكْبِرُ العشاقُ لوعتَهُ",56,"ت",2,0],["وأن أكون صادقاً","فيما به أعتذر",57,"ر",1,0],["وأن أكون آمناً","كيداً لها يستتر",57,"ر",1,0],["وان اكن بمديحي فيه منفردا","فإن مجد صلاح الدين منفرد",58,"د",1,0],["وَإِنّا كَماءِ المُزنِ ما في ضبابنا","سِوى هامِل بِالوَبلِ وَهوَ هطولُ",59,"ل",1,0],["وَإِنّا كِرامٌ لَيسَ في سُحبِ جورنا","جَهامٌ وَلا فينا يُعَدّ بَخيلُ",59,"ل",1,0],["وَأَن أَكونَ مِنْ أَعزِّ خاطرِ","لَدى شَريفِ البالِ ثمّ الخاطرِ",60,"ر",1,0],["وَإِن أَكُن أَكثَرت في كِتابي","مِن قِصَص النِعاج وَالذِئاب",61,"ب",1,0],["وأن أك قد أدللت فالعذر واضح","إذا كثر الإحسان ساء التأدب",62,"ب",1,0],["وإن أكن مطرقا حياء","فإن عيني إلى الطريقِ",63,"ق",1,0],["وإن أكدى الكريم أولى","من أن أكدى من البخيلِ",64,"ل",1,0],["وإن أك قد أجدت فإن جيدي","خلي من حلي الرفد عاطلُ",65,"ل",1,0],["وإن أك قد جئت العظائم كلها","فعفوك عن تلك العظائم أعظم",66,"م",1,0],["وَإن أَكُ مَفجُوعاً حَزِيناً مُرَزَّأً","يُؤَرِّقُنِى طَيفُ الهُمُومِ الطَّوَارِقِ",67,"ق",1,0],["وَأَنا كلف بِذاكَ أرى","حُبه من أَوجب السنن",68,"ن",1,0],["وإِنْ أَكْسُهُ ما ليس يَبْلَي جَديدُهُ","فكمْ حُلَّةٍ أَبْلَيْتُها فكَساني",69,"ن",2,0],["وإن أكن ممنّ غوى","يوماً فكُن مِمَّن رشد",70,"د",1,0],["وإن أكلت هنديَّةُ البيض شلوَه","فلحمُ كريم القومِ طعم المهنّد",71,"د",1,0],["وإن اكتفى غيري بطيف خياله","أو قد رضي بتماطل وتسوف",72,"ف",1,0],["وإن أكلت شاةٌ طعاماً فما لهم","على أهلها غرمٌ ولا متقولُ",73,"ل",1,0],["وإن أكره الدمى فالقتل حدهُ","مصليةً مع عقرها حين ينكحُ",74,"ح",1,0],["وَأَن أَكونَ بهِ فِى السِّلكِ مُنحَرِطُ","فَهوَ الَّذِى خَصَّهُ مَولاَهُ فِى القِدَمِ",75,"م",1,0],["وأن أكون ولي مالٌ ينقلني","في الصيف ما بين جزين وصنين",76,"ن",1,0],["وأنا كباقي الناس لي قلب","لكن أميلُ إلى الجمالِ به",77,"ه",1,0],["وانا كذاك سررت في ميلاده","فنظمت فيه لك التهاني عسجدا",78,"د",2,0],["وان أك من دواك صحوت اني","بحبك قد سكرت فلست اصحو",79,"ح",2,0],["وان اكتفى بالقرب يا هند عاشق","فأنا والنبي عن قربكم قط ما اكتفى",80,"ف",2,0],["وإن أكُن مغرِبِيّا","فلي معان غراب",81,"ب",1,0],["وإن أكن مذنباً فعفوا","والعفو من شيمة الكرام",82,"م",1,0],["وإن أكن جانياً طالت جنايته","فكم بروضك من جان قد اقتطفا",83,"ف",2,0],["وَإن أَكدَت لِنَائِبَةٍ كِرَامٌ","سَمَّاهاَ مِن نَدَى كَفّيهُ جُودُ",84,"د",1,0],["وَإِنّا كَالحَصى عَدَداً وَإِنّا","بَنو الحَربِ الَّتي فيها عُرامُ",85,"م",1,1],["وان اكون عليلاً","وفوق ذاك ثقيلا",86,"ل",2,0],["وإن اكتهل أو أشب فالفؤاد","صبي وطفل الهوى ما اكتهل",87,"ل",1,0],["وأنا كالنبيّ أنقل وحيا","ثم يجري كالدر من فوق طرسي",88,"س",2,0],["وان اكلت لذي نتن كفومهم","نيئافلا توذ قوما عند جمعهم",89,"م",1,0],["وإن أكن فضلت يوماً معشراً","عليكم فلا عرفت الفضلا",90,"ل",2,0],["وإنا كالجراد أذى وشرا","كلانا قد أغار على البلاد",91,"د",1,0],["وإن أكن مقصراً","عما له القلب يحن",92,"ن",1,0],["وأنا كما تدري البرية شاعر","فتكت به القامات والأعناق",93,"ق",1,0],["وَإنّا كَوكبَا هَذي المَعاني","كِلانا في مطالعه يَجول",94,"ل",1,0],["وَإِن أَك صاحبتُ الرِجال فَلَم أَجد","صَديقاً فَقَد آخاهم قَبليَ الدَهرُ",95,"ر",1,0],["وَإِن أَكبر ما يَهوى الرِجال عُلاً","وَتِلكَ بِالجد أَو بِالعلم وَالأَدَب",96,"ب",1,0],["وإن أكن حاوي الضدين فيه فلي","عذر بخديه يرضى سائر الفرق",97,"ق",1,0],["وأن