{"poems":[[85,"يهني زمانك أعياد مجددة","https://www.aldiwan.net/poem54232.html","البسيط"],[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[91,"لاقى اسامة وهو الضيغم الضاري","https://www.aldiwan.net/poem44740.html","البسيط"],[91,"ذهبت ايام الشباب سراعا","https://www.aldiwan.net/poem44894.html","الخفيف"],[68,"لا أوحش الله ممن حل في خلدي","https://www.aldiwan.net/poem38449.html","البسيط"],[68,"لا أوحش الله ممن لا أفارقه","https://www.aldiwan.net/poem38450.html","البسيط"],[68,"في مثل حبكم لا يحسن العذل","https://www.aldiwan.net/poem39928.html","البسيط"],[68,"البيض دون لحاظ الأعين السود","https://www.aldiwan.net/poem39930.html","البسيط"],[68,"أشكو إليك اشتياقا لست تنكره","https://www.aldiwan.net/poem40313.html","البسيط"],[48,"صنعة عزت الأنام بلطف","https://www.aldiwan.net/poem22771.html","الخفيف"],[48,"أحسن بالواجد من وجده","https://www.aldiwan.net/poem23628.html","السريع"],[113,"لا العيد من بعد سكان الحمى عيد","https://www.aldiwan.net/poem16189.html","البسيط"],[119,"لي نحو من ازمعوا السير التفاتات","https://www.aldiwan.net/poem41201.html","عموديه"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[234,"أيها الماجد الذي لم يقصر","https://www.aldiwan.net/poem51050.html","الخفيف"],[237,"أحباب قلبي بنتم","https://www.aldiwan.net/poem14823.html","مجزوء الرجز"],[240,"لا أوحش الله ممن","https://www.aldiwan.net/poem31995.html","المجتث"],[255,"لا أوحش الله ممن لم أزل أبدا","https://www.aldiwan.net/poem14955.html","البسيط"],[259,"كفى عنادا","https://www.aldiwan.net/poem36218.html","مجزوء الرمل"],[266,"رمقن ما بي فعفن الحب من رمقي","https://www.aldiwan.net/poem38225.html","البسيط"],[280,"أسرف الدهر فهلا قصدا","https://www.aldiwan.net/poem25585.html","الرمل"],[302,"يا راحلين وهم في القلب سكان","https://www.aldiwan.net/poem33146.html","البسيط"],[309,"يا قل لأحبابنا يا قل لجيران","https://www.aldiwan.net/poem16882.html","البسيط"],[354,"لا أوحش الله منك مغنانا","https://www.aldiwan.net/poem15960.html","المنسرح"],[427,"تحيا بكم كل أرض تنزلون بها","https://www.aldiwan.net/poem46356.html","الكامل"],[466,"لا أوحش الله طرفي من تشرفه","https://www.aldiwan.net/poem15393.html","البسيط"],[466,"يا فارس الهولين عم رداهما","https://www.aldiwan.net/poem15443.html","الكامل"],[466,"لا أوحش الله من أنوار منقبة","https://www.aldiwan.net/poem16142.html","البسيط"],[466,"لا أوحش الله من جود أسر به","https://www.aldiwan.net/poem16426.html","البسيط"],[478,"يا من به أنا مغرم","https://www.aldiwan.net/poem4119.html","مجزوء الكامل"],[519,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[556,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[558,"قد اطلعت على سري وإعلاني","https://www.aldiwan.net/poem68419.html","البسيط"],[567,"لما رأيتك ترعى ذمة العرب","https://www.aldiwan.net/poem52875.html","البسيط"],[567,"من كان منك أميرا أيها الرمم","https://www.aldiwan.net/poem52895.html","البسيط"],[591,"أحلى الهوى أن يطول الوجد والسقم","https://www.aldiwan.net/poem17711.html","البسيط"],[591,"من للخلاف وللوفاق مسائلا","https://www.aldiwan.net/poem17726.html","الكامل"],[592,"سبحان من كون الأشياء تكوينا","https://www.aldiwan.net/poem11513.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122635","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86655","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70962","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62564","الكامل"],[1008,"","https://poetry.dctabudhabi.ae/diwan/poem/95759","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120054","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84488","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11914","البسيط"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114699","البسيط"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104823","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53233","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53062","الكامل"],[2233,"","https://poetry.dctabudhabi.ae/diwan/poem/98185","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60895","الكامل"],[2575,"","https://poetry.dctabudhabi.ae/diwan/poem/142561","السريع"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118779","البسيط"],[3109,"","https://poetry.dctabudhabi.ae/diwan/poem/102847","البسيط"],[3444,"","https://poetry.dctabudhabi.ae/diwan/poem/130736","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89360","المتدارك"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48434","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216474","السريع"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119615","السريع"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54454","المنسرح"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94823","البسيط"],[4750,"ون ابن جدلان","https://www.poetsgate.com/ViewPoem.aspx?id=180423",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5213,"يا دار يومك بالغميم محجل","https://www.poetsgate.com/ViewPoem.aspx?id=170533",""],[5282,"قلوب من نور","https://www.poetsgate.com/ViewPoem.aspx?id=214082",""],[5431,"لاأبعدَ الله من في حبهم صدقوا","https://www.poetsgate.com/ViewPoem.aspx?id=197622",""],[5739,"قلبي وكر ...!","https://www.poetsgate.com/ViewPoem.aspx?id=155476",""],[5790,"لا أوحشت منكم للربع آثار","https://www.poetsgate.com/ViewPoem.aspx?id=112040",""],[5977,"القلوب مشتاقة","https://www.poetsgate.com/ViewPoem.aspx?id=214084",""]],"verses":[["لا أوحش الله قطراً أنت ملكه","وآنس الله بالألطاف مَغناهُ",0,"ا",2,0],["لا أوحش المجدُ يا بني عمر","منكم فأنتمُ أجَلُّ من عَمَرَهْ",1,"ر",2,0],["لا اوثر القتل حباً في محاسنه","بل ان في حاجتي بعثا لا يثارى",2,"ر",2,0],["لا اود المقلدين سواهم","ولقد تنكر الطباع الطباعا",3,"ع",2,0],["لا أوحش الله ممن حل في خلدي","فليس يؤنسني إلا تذكره",4,"ه",1,1],["لا أوحش الله ممن لا أفارقه","إلا وتدنيه أحلامي وأفكاري",5,"ي",1,1],["لا أَوحَشَ اللَهُ مِن قَومٍ لِبُعدِهِمُ","أَمسَيتُ أَحسُدُ مَن بِالغَمضِ يَكتَحِلُ",6,"ل",1,0],["لا أَوحَشَ اللَهُ مِن قَومٍ مَكارِمُهُم","وَفَضلُ جودِهِمُ كَالطَوقِ في جيدي",7,"د",2,0],["لا أوحِشَ اللَهُ مِمَّن لا أَرى أَحَداً","مِنَ الأَنامِ إِذا ما غابَ يَخلُفُهُ",8,"ف",2,0],["لا أُواريكَ في طِلابِ المَعالي","وَهِيَ في الغَدرِ كَالظِلالِ الأَوازي",9,"ز",2,0],["لا أُوحشَتْ دارُك من شَمسِها","ولا خلا غابُكَ مِنْ أُسْدِهِ",10,"د",2,0],["لا أَوحش اللَه مِن قَوم صَغيرَهُم","مِن أَكبَر الناس بِالإِحسان مَعدودُ",11,"د",1,0],["لا اوحش الله ممن عيسهم نفرت","قبل الغروب وللحادين اصوات",12,"ت",1,0],["لا أُواليهمُ الزمانَ ولا هم","ليَ ما ذرّ شارقٌ أولياءُ",13,"ا",2,0],["لا أُؤَدِّي حقوقَه وهْو فردٌ","كيف لمَّا شفعتُه بالجِوار",14,"ر",1,0],["لا أَوحَشَ اللَهُ الحِمى","وَلا العَقيق مِنكُمُ",15,"م",1,0],["لا أَوحَشَ اللَهُ مِمَّن","بِهِ يَتِمُّ السُرورُ",16,"ر",1,1],["لا أوحشَ اللَه ممن لم أزل أبداً","أراه عندي وإن شَطَّت به الدارُ",17,"ر",1,1],["لا أواري عنك شيئا","في الهوى رغم السّهادِ",18,"د",1,1],["لا أوهن اللَه عنسى كم قطعت بها","في الوهن بهماء قطع النجم في الأفق",19,"ق",1,0],["لا أَوَدّ العُمْرَ أَلْقاهُ إذا","عزّ فيه ما يُقيمُ الأَوَدا",20,"د",2,0],["لا أَوحشَ اللّهُ من ناءٍ تؤرِّقُني","ذكراه وهو خليُّ البال وَسنانُ",21,"ن",1,0],["لا أوحش اللَه منكم يا أحبتنا","فإنكم أنسنا منوا بإيناس",22,"س",1,0],["لا أَوحَشَ اللَهُ مِنكَ مَغنانا","يا حُسنَنا في الوَرى وَمَعنانا",23,"ن",2,1],["لا أوحشَ اللَه ربعا من زيارتكُم","يا من لهم في الحشا والقلب تذكارُ",24,"ر",1,0],["لا أوحش اللّهُ طرفي من تشرُّفه","بأبلجِ الوجه تحلو عندهُ النِّعَمُ",25,"م",1,1],["لا أوحشت منك الدسوت ولا خلت","منكَ السروجُ بغيبةٍ وبمحضرِ",26,"ر",1,0],["لا أوحش اللّهُ من أنوارِ منْقَبةٍ","هي الجَلاءُ لِتَهْمامٍ وإِظْلامِ",27,"م",1,1],["لا أوْحَشَ اللّهُ من جُودٍ أسَرُّ بهِ","مَسَرَّةَ الأرضِ عند المَحْلِ بالمَطَرِ",28,"ر",1,1],["لا أوحش اللَه الحِمى","بِأُهَيل وُدّي مِنكُم",29,"م",1,0],["لا أوحشَ الرحمنُ منكَ رُبوعَهُ","أبداً ولا برحَتْ لمجدِكَ موطِنا",30,"ن",2,0],["لا أَوحشَ اللّهُ منّي كلَّ مُضطَجَعٍ","منَ الفخارِ ولا رَحْلي ولا عِيسي",31,"س",2,0],["لا أُوحِشُ الخِدرَ مِن شَخصي وَبَيضَتَهُ","وَلا أُوَحِّدُ بِالصَهباءِ نُدماني",32,"ن",2,0],["لا أوحشَ اللهُ مِمَّن ظَلَّ يُؤْنسُني","طُولَ المدَى بورُودِ الرُسْلِ والكُتُبِ",33,"ب",1,0],["لا أوحَشَ اللهُ داراً مِن أحبَّتنا","كانت معَاهِدُها بالأُنس تَبتَسِمُ",34,"م",1,0],["لا أَوْحَشَتْ مِنْكُمُ دارٌ بِكُمْ شَرُفَتْ","ولا خَلَتْ مِنْ مَغَانِي حُسْنِكُمْ خِيَمُ",35,"م",1,0],["لا أوْحَشَتْ شَمْسُ الشَّرِيعَةِ مِنْكُمُ","فَبقاؤُها مُتعلِّقٌ بِبقاكُمُ",36,"م",1,0],["لا أوحش الله نجداً منكمو أبداً","إذا أنتمو فرع حبر أظهر الدنيا",37,"ن",3,0],["لا أواري عَنِ الضَّغينَةِ والحِق","دِ مَوَّةَ الخَئُونُ المَورّي",38,"ر",2,0],["لا أَوحش اللَه بَعد الأُنس أَندية","كانَت مَصابيحها مِنهُ مُنيرات",39,"ت",1,0],["لا أُواخى إلا وقد قال لي الظن","ن حِذاراً أُخَيَّ ممَّنْ تُواخى",40,"خ",2,1],["لا أوحش الرحمن منكم إنكم","قد كنتم الأرواحَ للأبدانِ",41,"ن",1,0],["لا أوحش اللَه الحِمى","مِن كلِّ ظَبي نافِر",42,"ر",1,0],["لا أوحشت دار السلا","م من ارتياحك والسلامُ",43,"م",1,0],["لا أوحشَ اللهُ الكريم بفضله","من كعبةٍ أرجاؤها تتضوّعُ",44,"ع",1,0],["لا أوحشَ اللهُ الكريم بفضله","من بلدةٍ فيها الغوير ولعلعُ",44,"ع",1,0],["لا أَوحَشَ الشامَ مِن تِصهالِ خَيلِكُم","وَلا أَباعِرَكُم مِن دِمنَةِ الدارِ",45,"ر",1,0],["لا أَوحشَت منكُم المَعالي","ولا خلَت منكمُ الصُّدورُ",46,"ر",1,0],["لاَ أَوحَشَ اللهُ رَبعاً كانض يَألَفُهُم","قَلبى دَوَاماً بأَجيادٍ وَبالحَجرِ",47,"ر",1,0],["لا أوحشت منك الجزيرة إنها","حرم يجير من الزمان حماها",48,"ا",3,0],["لا أوحشتك سعادة ونستها","إن المجدَّ مجابة دعواته",49,"ت",2,0],["لا أوحش الله من قومٍ نأوا فنأى","عن النواظر أقمار وأغصان",50,"ن",1,0],["لا أوحش اللهُ المنازل منك ما","طرق النسيم بشيحه وبرَنْده",51,"د",2,0],["لا أوحش الله خيالي من الحب","لا تلك الليالي الأخر",52,"ر",1,0],["لا أوحش الله ممن لست أذكرهم","إِلا وصرت كمثل الشارب الثَّمِل",53,"ل",1,0],["لا أوحش اللَه من ظبيٍ أنست به","في ليلةٍ راقبت لي غفلة الزمن",54,"ن",1,1],["لا أوحشَ اللَه مِنكَ الخَلقَ يا أملاً","ما عنهُ بَعدَ النوى صَبرٌ لأجلادِ",55,"د",1,0],["لا أوحشنا منه اللَه","لا فارقنا بالحرمان",56,"ن",1,0],["لا أوفّي بعضَ الذي رُمْتُ من وص","فِ حُلاها رويّتي وارْتِجالي",57,"ل",2,0],["لا أوثر القمراء في حسنها","على الدجى، والطرف فيه يحوم",58,"م",1,1],["لا أوحش اللَه ربوعا بها","منك ولا أوحش سكانا",59,"ن",2,0],["لا أَوحش الله من أُنسي بقربكمُ","ولا أَراني فيكم غير إيثاري",60,"ر",2,0],["لا أَوحشَ اللّهُ منك يا علم الدِّ","ين نَدِيَّ الكرام والفُضلا",61,"ل",2,1],["لا أوحش اللَهُ من خلٍّ يُبارحني","وشخصهُ في فُؤادي كيفما صارا",62,"ر",2,0],["لا أونس البنزين عجلٍ تفرقاعه","مخطرٍ من سرعته يقلع أقلاعي",63,"ع",2,0],["لا أوقظ الفتنة من مضجعها","وإن ترامت لا أولَّيها القفا",64,"ا",1,0],["لا أوحشت منك الظباء محلة","وثراك حال بالظباء مؤهل",65,"ل",1,0],["لا أوحَشَ اللهُ النفُوسَ وأهْلهَا","وأفَاضَها مِنْ كلِ خَيرٍ وَابِلُ",66,"ل",1,0],["لاأوجع الله أرواحا مؤلفةً","نورٌ بمنبعها والنجمَ تلتحقُ",67,"ق",1,0],["لا اوقفت هيبة شموخ الاحتلال.","ولا اقبلت للخوخ واعنابه مقر.",68,"ر",1,0],["لا أوحشت منكم للربع آثار","ولا خلا منكم نادٍ ولا دارُ",69,"ر",1,1],["\"لا أوحش الله القلوب وأهلها \"","فقلوبنا لقلوبهم تشتاق",70,"ق",1,0]]}