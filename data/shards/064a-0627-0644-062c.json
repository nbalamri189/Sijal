{"poems":[[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[108,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[78,"شَادِنٌ يَسْحبُ أَذْيَالَ الْطَّرَبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17873&r=&rc=10",""],[242,"يا لجة علما وديمة نائل","https://www.aldiwan.net/poem19062.html","الكامل"],[290,"للغرب أنت وللمشارق مرجع","https://www.aldiwan.net/poem39407.html","الكامل"],[382,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48723","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62546","السريع"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136183","الرمل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145062","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86392","الرمل"],[4047,"","https://poetry.dctabudhabi.ae/diwan/poem/144068","المقتضب"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83122","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139714",""],[4829,"الجابريّة","https://www.poetsgate.com/ViewPoem.aspx?id=35605",""],[4869,"حفل التخرج من جامعة مؤته / الاردن","https://www.poetsgate.com/ViewPoem.aspx?id=137916",""],[5092,"لا موعدٌ لنا","https://www.poetsgate.com/ViewPoem.aspx?id=178713",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5431,"صنعاء_خذلته الأبوة الغرّاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=198199",""],[5431,"قلب قدسي","https://www.poetsgate.com/ViewPoem.aspx?id=213919",""],[5431,"ليس لي في الأمر يد!!...","https://www.poetsgate.com/ViewPoem.aspx?id=214123",""],[5628,"استغاثات حواء","https://www.poetsgate.com/ViewPoem.aspx?id=178521",""],[5694,"بلشة القلب","https://www.poetsgate.com/ViewPoem.aspx?id=132102",""],[5725,"صبريني","https://www.poetsgate.com/ViewPoem.aspx?id=202933",""],[5975,"عذّبيني","https://www.poetsgate.com/ViewPoem.aspx?id=53252",""],[6008,"يالله يلي معتلي في سماكا","https://www.poetsgate.com/ViewPoem.aspx?id=60805",""],[6068,"خير اللغات جلالة وفخامة -16-","https://www.poetsgate.com/ViewPoem.aspx?id=175972",""]],"verses":[["يا لجَهلِ اثنين أقدارَهما","آه يا ليتهما قد عَرَفَا",0,"ف",2,0],["يا لُجةً كلٌّ إليها ظمي","قد جاز طوفانُكِ شمَّ القنانْ",1,"ن",1,0],["يالجَمَال المنظر الخلاَّب!","عند التقاءَ الأُفقِ بالغياب!",2,"ب",1,1],["يا لَجَهْلي مَا أَرَاهُ ذاهِباً!","وسوادُ الرأس منِّي قدْ ذهبْ",3,"ب",1,0],["يَا لُجَّةً عِلْماً وَدِيمَةَ نَائِلِ","كِلْتَاهُمَا مَدَدُ الْعُلاَ قَدْ عَلَّهَا",4,"ل",3,1],["يا لجد نلت وبالتواضع والتقى","علما حقيقيا فصح المذهب",5,"ب",1,0],["يا لجة الجود الإلهيِّ الذي","أغنى الورى بسوابغ الإعطاء",6,"ا",2,0],["يا لجة البحر إن يممت ساحلهم","وخامرتك لدى البوغاز أرواح",7,"ح",1,0],["يا لجة الصادر والوارد","وبهجة الآمل والقاصدِ",8,"د",1,1],["يا لجا اللاجين يا خير نبي","ورسول جاء حقا بالسور",9,"ر",1,0],["يا لجنة التقسيم حدت عن الهدى","وسخرت منه فبؤت بالإنكار",10,"ر",1,0],["يا لجيران الحمى قد أكسبوا","كبدي صدعاً وساموها حريقا",11,"ق",2,0],["يا لجآذرِ العِينِ","فِتنتي وتَحْييني",12,"ن",2,1],["يا لَجهد قَد كانَ يَذكُو التِهاباً","أَخمَد الغَبنُ وَالعُقوقُ التِهابَه",13,"ب",2,0],["يا لجودٍ تمسى المكارمُ أهلاً","لأياديه والملا أضيافا",14,"ف",2,0],["يالجابريّة كم راسن بجدع","كم عايلن يقفي عن الايتامي",15,"م",2,0],["يالجابريّة والله اني لاضرب","بمصقل شواظن حديد حامي",15,"م",2,0],["يالجابريّة والله انّي لاطغى","بالكافر المرتد عن اسلامي",15,"م",2,0],["يالجابريّة والله انّي والله","لادهدم الخالي بهذا العامي",15,"م",2,0],["يالجابريّة فوق قبرك لاحرق","سبعن تغذّو رامم العظامي",15,"م",2,0],["يالجآمعه شكراً لحسن الضيآفه","وهذي لكم مع كل الاغرآب عآده",16,"د",2,0],["يالَجفنٍ خِلتني تحتهُ","كيف أبقى تحتهُ عازبا ؟",17,"ب",2,0],["يَا لَجَهْلِ القَوْمِ قَدْ حَسِبوا","حَجْبَ نُورَ الشَّمْسِ بِالْبُرَدِ(١٧)",18,"د",1,0],["يالجرحٍ من الأحبة مدمى","يالأهلٍ لذاتهم قد أساؤوا !!",19,"ا",1,0],["يالجرحٍ ينزّ ماانفك يجري","زاد نزفا مابين طعنٍ ودهسِ",20,"س",1,0],["يالجوعٍ قد تعرّى","في اشتهاءٍ من مسدْ",21,"د",1,0],["يا لجْهلي عندما صدّقتُ ما","قلتَ في حفظك للعهْدِ الوثيقِ",22,"ق",1,0],["يالجتي من اهجوسي يوم لجنا","لجة اسباع القرى لعطت مفاهيقه",23,"ق",2,0],["يا لجيناً مهراقة بالكؤوس","وجهك البدر هازئا بالشموسِ",24,"س",1,1],["يا لجهلي .. ويا لشقوةِ عمري","لم يفدْني العناءُ لا .. والعطاءُ",25,"ا",2,0],["يالجوف طبت وتو ذعذع هواكا","تبشري بقدومهم يوم جوكا",26,"ك",2,0],["يالجوف زنى وأرتفع مستوكا","يوم السعود المكرمين أنهضوكا",26,"ك",2,0],["يا لجنة هاك سلاما طيّبا","من إبنة وقفت وقالتْ: مرحبا",27,"ب",2,1]]}