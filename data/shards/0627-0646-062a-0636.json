{"poems":[[85,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[66,"أنت ضدي إذا تيقنت قربي","https://www.aldiwan.net/poem38766.html","الخفيف"],[44,"أنا ميت ولئن مت","https://www.aldiwan.net/poem30273.html","مجزوء الرمل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9497","الرمل"],[106,"كرموه","https://www.poetsgate.com/ViewPoem.aspx?id=179708",""],[116,"لمعاليك جئت أعرض حالي","https://www.aldiwan.net/poem42171.html","الخفيف"],[121,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[394,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[501,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[552,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"],[552,"يا سائلي عن ذنوب الدهر آونة","https://www.aldiwan.net/poem47821.html","البسيط"]],"verses":[["أَنتَضيهِ اِنتِضاءَ موسى عَصاهُ","يَفرَقُ المُستَبِدُّ مِن ثُعبانِه",0,"ن",2,0],["أَنتَ ضِدّي إِذا تَيَقَّنتَ قُربي","وَالصَديقُ الشَقيقُ عِندَ فِراقي",1,"ق",2,1],["إِن تَضَرَّعتُ بِنُطقٍ","فَحُماداهُ السُكوتُ",2,"ت",1,0],["اِنتَضوا لي قِسِيّاً","وَأَحَدّوا سِهاما",3,"م",2,0],["إنْ تضِق بالأنام كلِّهم الأر","ضُ، فلن يعدم الأديبُ مكانا",4,"ن",2,0],["أنت ضئضيئ كل أصل وعليا","باب نعماك غاية الآمال",5,"ل",1,0],["أنت ضاغنتنا وخشنت صدرا","كان يحنو عليك في البأساء",6,"ا",2,0],["اِنتَضاها ثُمَّ اَمضا","ها عَلَيهِم فَاِرتَضاها",7,"ا",3,0],["أَنْتَ ضمنَ الحَضيضِ تزعُمُ وَهْماً","وشُؤُنُ الوَلِيِّ في العيُّوق",8,"ق",1,0],["أنتَضِيهِمْ على صُروفِ ليالي","يَ فأُغنى عن المواضي الرِّقاقِ",9,"ق",1,0],["إنْ تُضح دارِيَ في عمّانَ نائيةً","يوماً عليَّ فبالخُلصاءِ لِي دارُ",10,"ر",1,0]]}