{"poems":[[87,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[68,"أنت ضدي إذا تيقنت قربي","https://www.aldiwan.net/poem38766.html","الخفيف"],[46,"أنا ميت ولئن مت","https://www.aldiwan.net/poem30273.html","مجزوء الرمل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9497","الرمل"],[108,"كرموه","https://www.poetsgate.com/ViewPoem.aspx?id=179708",""],[119,"لمعاليك جئت أعرض حالي","https://www.aldiwan.net/poem42171.html","الخفيف"],[124,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[398,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[505,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[556,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"],[556,"يا سائلي عن ذنوب الدهر آونة","https://www.aldiwan.net/poem47821.html","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120093","المديد"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44979","الخفيف"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126587","الخفيف"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73951","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109047","الخفيف"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104815","البسيط"],[2214,"","https://poetry.dctabudhabi.ae/diwan/poem/113910","الخفيف"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104982","السريع"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205793","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118827","الخفيف"],[3136,"","https://poetry.dctabudhabi.ae/diwan/poem/204089","الطويل"],[4691,"ما أحيلى ريم إذا تتمشّى","https://www.poetsgate.com/ViewPoem.aspx?id=216050",""],[3591,"من التلاقي قضيت السؤل والطلبا","https://www.poetsgate.com/ViewPoem.aspx?id=149403",""],[5219,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=194939",""],[5939,"دستور العشق","https://www.poetsgate.com/ViewPoem.aspx?id=186983",""],[5970,"كن مع الناس تر الناس معك","https://www.poetsgate.com/ViewPoem.aspx?id=130589",""]],"verses":[["أَنتَضيهِ اِنتِضاءَ موسى عَصاهُ","يَفرَقُ المُستَبِدُّ مِن ثُعبانِه",0,"ن",2,0],["أَنتَ ضِدّي إِذا تَيَقَّنتَ قُربي","وَالصَديقُ الشَقيقُ عِندَ فِراقي",1,"ق",2,1],["إِن تَضَرَّعتُ بِنُطقٍ","فَحُماداهُ السُكوتُ",2,"ت",1,0],["اِنتَضوا لي قِسِيّاً","وَأَحَدّوا سِهاما",3,"م",2,0],["إنْ تضِق بالأنام كلِّهم الأر","ضُ، فلن يعدم الأديبُ مكانا",4,"ن",2,0],["أنت ضئضيئ كل أصل وعليا","باب نعماك غاية الآمال",5,"ل",1,0],["أنت ضاغنتنا وخشنت صدرا","كان يحنو عليك في البأساء",6,"ا",2,0],["اِنتَضاها ثُمَّ اَمضا","ها عَلَيهِم فَاِرتَضاها",7,"ا",3,0],["أَنْتَ ضمنَ الحَضيضِ تزعُمُ وَهْماً","وشُؤُنُ الوَلِيِّ في العيُّوق",8,"ق",1,0],["أنتَضِيهِمْ على صُروفِ ليالي","يَ فأُغنى عن المواضي الرِّقاقِ",9,"ق",1,0],["إنْ تُضح دارِيَ في عمّانَ نائيةً","يوماً عليَّ فبالخُلصاءِ لِي دارُ",10,"ر",1,0],["إن تضق أعذاره فبما","عنده الآمال تنفسحُ",11,"ح",1,0],["أَنتَ ضَيفٌ وَكُلُّ ضَيفٍ وَإِن طا","لَت لَياليهِ مُؤذَن بِاِرتِحال",12,"ل",1,0],["أنت ضيعت جل قلبي بالهج","ر فصوني بالوصل ما قد تبقى",13,"ق",2,0],["أنت ضيفٌ في الأهل فارتقب الرح","لة والصيف لا يدوم سحابه",14,"ب",2,0],["إن تضق مصر عن تماثيل أهل","الفضل من قومها وعن تمثالك",15,"ك",1,0],["أَنتض المَلاَذُ وَأنتَ حِصنٌ","أَنتض الرَّحِيمُ إِذا القُلُوبُ",16,"ب",1,0],["أنت ضحيت نفسك اليوم كيما","تسعدي الناس ثم أنت شقية",17,"ي",2,0],["إن تضرم النيران في أضلعي","وتحرق القلب بوجد دخيل",18,"ل",1,0],["أنت ضنّى ولا أضنّ على النا","س بمرأي جمالك الفتان",19,"ن",1,0],["أنت ضيعت من سباك هواهم","إنَّ رَعيَ الوداد تركُ الملالِ",20,"ل",1,0],["إن تضربوا سلمان نضرب حبيبكم","وإن ترحلوا نحو ابن عفان نرحل",21,"ل",1,1],["إن تضنّي تكنْ حياتي هلاكا","وأصارعْ في الليل بالهمّ وحشا",22,"ش",2,0],["أن تضفري لي أكليل الممات فمن","ورد الخدود ولَّا من ورد روض رُبى",23,"ب",2,0],["إن تضحك كن حذرا فلها","شتى الألوان من الحيل",24,"ل",1,0],["إنْ تُضْحِ عبلةَ في الهوى","أناْ في افتتاني عنترةْ",25,"ر",2,0],["إن تضق أنت بقوم ساعة","فلقد أقلقت حقاً مضجعك",26,"ك",1,0]]}