{"poems":[[46,"كشف الغطاء فأوقدي أو أخمدي","https://www.aldiwan.net/poem30545.html","الكامل"],[108,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[119,"دعنا من الاضغاث والاحلام","https://www.aldiwan.net/poem40482.html","عموديه"],[208,"صار التغزل في هواه عتابا","https://www.aldiwan.net/poem53367.html","الكامل"],[242,"قل للذي لا ينتهي عن فحشه","https://www.aldiwan.net/poem19722.html","الكامل"],[261,"جميع ما لي صدقه","https://www.aldiwan.net/poem48524.html","مجزوء الرجز"],[264,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[287,"إن الهوى إن كنت عنه تسأل","https://www.aldiwan.net/poem32675.html","الكامل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[325,"يا عابد الرحمن أبشر وابتهج","https://www.aldiwan.net/poem67209.html","الكامل"],[369,"أوجست من جمر بخدك ساطع","https://www.aldiwan.net/poem60852.html","الكامل"],[435,"وظبية حسن تيمتني بحبها","https://www.aldiwan.net/poem40520.html","الطويل"],[445,"تسليت حتى أنسي الهائم الهما","https://www.aldiwan.net/poem34792.html","الطويل"],[445,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[563,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138246",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138263",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86687","الخفيف"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66971","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38389","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37761","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59244","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80240","الكامل"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124025","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108760","الكامل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102724","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104688","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104689","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75939","الرمل"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33139","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135626","الكامل"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138827",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72840","الخفيف"],[4734,"فجر القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=50227",""],[4767,"القدح المكسور","https://www.poetsgate.com/ViewPoem.aspx?id=209028",""],[4859,"عش للجمال","https://www.poetsgate.com/ViewPoem.aspx?id=190838",""],[5054,"سيفُ الصدق","https://www.poetsgate.com/ViewPoem.aspx?id=215054",""],[5431,"وعلمت أنك بالجياع مُسائَل","https://www.poetsgate.com/ViewPoem.aspx?id=187833",""]],"verses":[["فَبَسَطتَ أَزهَرَها بِوَجهٍ أَزهَرٍ","وَقَبَضتَ أَربَدَها بِوَجهٍ أَربَدِ",0,"د",1,0],["فبساقَي العَدَّاء يفتخرُ الحمى","كفَخَاره بذراعَي السَّبَّاحِ",1,"ح",1,0],["فبسرهم اعلو واقهر حسدي","ولعمري الارحام للارحام",2,"م",1,0],["فبسطتَ للحاجات نفساً رحبةً","لو قُسِّمت خِطَطاً لَكُنَّ رِحابا",3,"ب",2,0],["فَبِسَيْرِهِمْ سِرْ سَاحِباً بُرْدَ التُّقَى","إِنْ شِئْتَ تُوقَى مِنْ عَنَاكَ وَكَدْشِهِ",4,"ش",2,0],["فبس كم تهذين يا","سندية مطلقه",5,"ق",2,0],["فبسرّ الذات وذات السر","ر وما أنزلتَ من الصحف",6,"ف",1,0],["فَبِسَيفِهِ مَجَّ الفِرَنجُ دِماءهُم","في البَحرِ حَتّى الماءُ مِنهُ أَشكَلُ",7,"ل",1,0],["فَبِسائرِ المتجلّياتِ مشيّعاً","في كلِّ وجهٍ والفؤادُ مشيّعُ",8,"ع",1,0],["فَبِسورَةِ الرَحمَنِ عوذُ ذاتِها","وَبِقَلَ أَعوذُ وَسورَةُ الصَمَدِيَّه",9,"ي",2,0],["فبسابعِ الأفلاكِ لم يَحلُلْ سوى","زُحَلٍ ومَجْرَى الشمسِ وَسْطَ الرّابع",10,"ع",1,0],["فبسبست ما حنت وحركت للهوى","حواراً فما درّت وعزّ وصالها",11,"ه",2,0],["فَبَسْطَةُ باعٍ جازَتِ الوَهْمَ والمدى","ورَحْبُ ذِراعٍ حازَتِ العُرْبَ والعُجْما",12,"م",2,0],["فَبِسَلْمِها أَصْفى السلامَ أَبيُّها","وبأمنِها أَلِفَ العُيونَ هُجودُها",13,"د",3,0],["فبسملة الإسلام أسماء ربنا","تبارك في القرآن جاءت عن الطهر",14,"ر",1,0],["فبسملة الإسلام نور مضيئة","وبسملة الكفر اعتقاد أولي الكفر",14,"ر",1,0],["فبسملة الأسماء تلك إذا بدت","تكون بآثار المؤثر في الأثر",14,"ر",1,0],["فبسفرك الوضاح قد سفرت لنا","غر الوجه وخُلدت تخليدا",15,"د",2,0],["فبسفرك الوضاح ضاء هلاله","لك تم سعد في ختام وابتدا",16,"د",2,0],["فَبِسَعد المَنصور صَهرِ الخديوي","في لَياليه بُلبلُ الأُنس غرّد",17,"د",1,0],["فَبِسِحْرِهِ مَهْمَا دَعَوتُ إجَابةٌ","ولِفِكْرِهِ مَهْمَا اجْتَلَيْتُ تَوَضُّحُ",18,"ح",1,0],["فَبَسمَلَ عندَ الغَسلِ أَسمَعَ حاضراً","وَعِندَ نُزولِ القبرِ وَالنقلُ صادِقُ",19,"ق",1,0],["فَبِسَيفٍ بِمُقلَتَيْكَ تَبَدَّى","حينَ أَدمى القُلوبَ مِنّا جِراحا",20,"ح",2,0],["فَبِسُحْبِ دَمُعِي وَالْتِهَابِ جَوَانِحِي","أنْذِرْتُ بِالإغْرَاقِ وَالإحْرَاقِ",21,"ق",1,0],["فَبِسَيف دَرويش السَلامُ موطِدٌ","وَيَراع راشد لِلسَعود مَديرُ",22,"ر",1,0],["فبسعيه جمع المجمع قومه","وبباعه طلب العلى عمرو العلى",23,"ل",2,0],["فبسيف سيف اللَه مولانا الغنا","عن كل سلطان يسل سيوفا",24,"ف",2,0],["فبسرِّهِ وبحزبهِ وبأصلهِ","أرقى الفلاح وينتفى نُقصاني",25,"ن",2,0],["فَبِسَردِهِ سَمعِى أُمَتِّعُ وَالبَصَر","وَأُشَنَّفُ الاسماعَ مِمَّن قَد حَضَر",26,"ر",1,1],["فَبِساعَةٍ بالسَّعدِ أَسفَرَ نُورُها","مِن لَيلَةٍ قَدرِيَّةٍ أَبدَت بُشَر",27,"ر",1,0],["فَبِسَمعِي صَمَمٌ إِن حُدِّثُوا","وَبِعَيني نَبوَةٌ أَن تَنظُرا",28,"ر",2,0],["فبسر اسمك القهار سترتها","لك الحمد أنعمت بأعظم منة",29,"ه",1,0],["فبسرهم دار الفلك لحكمة","وحرك أقطار الوجود في لمحة",29,"ه",1,0],["فَبِسَلوانَ رَيُّهُ لا سِواهُ","وَهوَ يَنفي عَنهُ كُلوماً تَحَزُّ",30,"ز",1,0],["فبسائرٍ وبقائمٍ وبقاعدِ","وبواقفٍ وبركَّعٍ وبسُجَّدِ",31,"د",1,0],["فبسيفه وبنور غرة وجهه","يشف الغليل ويُدركنَّ الثار",32,"ر",1,0],["فبسوقِ الهوى فؤاديَ بيعوا","ما بوعدي وحقكمُ من عكاظِ",33,"ظ",1,0],["فبسمِ الله ينتشرونَ نوراً:","وبسمِ الله يطوونَ الصعابا",34,"ب",2,0],["فبستان الهوى أسفاً","بغير الرفض لم يبُحِ",35,"ح",1,0],["فبسمةٌ زينتْ روحَ الرّضا ألقاً","من ثغرِ أمّكَ تجلو الحزنَ والرهقا",36,"ق",2,0],["فَبِسيف الصدق يعلو دينكم","وبِلهو النفس يغدو كالكسيحُ",37,"ح",1,0],["فبسطتَ قلبك للجياع طعامهم","وعلمت أنك بالجياع مُسائَل",38,"ل",1,0]]}