/www.poetsgate.com/ViewPoem.aspx?id=121561",""],[5183,"السِّمَات","https://www.poetsgate.com/ViewPoem.aspx?id=186460",""],[5434,"الشاور غشاني","https://www.poetsgate.com/ViewPoem.aspx?id=37612",""],[5455,"سحابه","https://www.poetsgate.com/ViewPoem.aspx?id=34425",""],[5455,"بسم الله عليك","https://www.poetsgate.com/ViewPoem.aspx?id=34699",""],[5525,"وسيم الناس","https://www.poetsgate.com/ViewPoem.aspx?id=7253",""],[5537,"نقاش أمن قومي","https://www.poetsgate.com/ViewPoem.aspx?id=207782",""],[5573,"فاز بالخير بادي يوم يقري سلام","https://www.poetsgate.com/ViewPoem.aspx?id=202543",""],[5606,"مرحبا يالغالي","https://www.poetsgate.com/ViewPoem.aspx?id=197407",""],[5792,"حبيبتي ماني معلّم باسمها","https://www.poetsgate.com/ViewPoem.aspx?id=180361",""],[5848,"أبها","https://www.poetsgate.com/ViewPoem.aspx?id=48909",""],[5848,"اللهم إني عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=48895",""],[5874,"مَوْقفُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=212191",""],[5936,"ليت حلمي","https://www.poetsgate.com/ViewPoem.aspx?id=184774",""],[5948,"يا حَمَويه اسمع ثَناء صادقاً","https://www.poetsgate.com/ViewPoem.aspx?id=100581",""],[5948,"قلتُ ونفسي جَمُّ تأوُّهُها","https://www.poetsgate.com/ViewPoem.aspx?id=100621",""],[5957,"يا حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=25885",""],[5957,"أوراق حزني","https://www.poetsgate.com/ViewPoem.aspx?id=53846",""],[6056,"كل عصر له رجال ودولة","https://www.poetsgate.com/ViewPoem.aspx?id=130133",""],[6056,"عشراء الركاب","https://www.poetsgate.com/ViewPoem.aspx?id=130349",""],[6056,"نايض البرق","https://www.poetsgate.com/ViewPoem.aspx?id=130383",""],[6056,"المعاناة الشديدة","https://www.poetsgate.com/ViewPoem.aspx?id=130508",""],[6093,"حياد الشعر والنثر","https://www.poetsgate.com/ViewPoem.aspx?id=192352",""],[6093,"لَا يَرَاكَ اللهُ إلَا مُحْسِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=199912",""],[5567,"وصل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81770&r=&rc=38",""]],"verses":[["قُلْتُ وَقَدْ أَلْبَسَ جِسْمِي الضَّنَا","صِبْغَةَ سُقْمٍ أَبَداً لاَ تَحولْ",0,"ل",1,1],["قلتُ وللنّاقوسِ في مَرْتُشٍ","والليْلُ قد مدّ عَلَيْنا الجَناحْ",1,"ح",1,1],["قُلتُ وَالآلامُ تَفري مُهجَتي","وَيكِ ما تَصنَعُ في الحَربِ الظِبا",2,"ب",2,0],["قلتُ وقلبي في الصدغِ منتشبٌ","ألثمُ قلبي قالت فذي نَشبه",3,"ب",2,0],["قلتُ وقد أقبل في أحمر","وشعره المسبل كالحندس",4,"س",1,1],["قلتُ ولي في هوى حبيبي","قلبٌ رقيق عليه يدهش",5,"ش",1,1],["قلت والرّدف أريني فانثنت","ثم قالت هكذا الإنسان يطغى",6,"غ",2,0],["قلت وقد نوعت يداه على","حالي أنواعها من الكرم",7,"م",1,0],["قلتُ والقلب إليهِ ينتمي","لكَ قلبي عبدُ ودٍّ وأنا",8,"ن",2,0],["قلتُ واهاً بجُرعةٍ","ذقتُها ما أمرَّها",9,"ر",3,0],["قلتُ وخُبِّرْتُكَ واصلتَها","حاشَ له من هذه الغلطهْ",10,"ط",2,0],["قلت وقد لام في القناعة بال","مجد وحلف المعاش ذي الشظف",11,"ف",1,0],["قلتُ وما تهوَيْنَ من عاجزٍ","لم يمشِ من صحرائِكم ميلا",12,"ل",2,0],["قُلت وَالشَكُّ رائِحٌ","في ضَميري وَمُغتَدِ",13,"د",1,0],["قَلَّت وَإِن حَلَّت صَنائِعَ لَفظِها","لَكُم وَإِن نَطَقَت بِسِحرِ بَيانِ",14,"ن",1,0],["قلتُ والعمرُ بعيني كالكرى","وأنا في حُلُمٍ أقطعه",15,"ه",1,0],["قلتُ والله فيه أحسنُ تقوي","مٍ فهذا في الوصفِ مبلغُ علمي",16,"م",2,0],["قلتُ والنّاس يرقبون هلالاً","يشبه الصبّ من نحافةِ جِسْمِه",17,"ه",1,1],["قلتُ وقدْ عانقتُهُ","عندي منَ الصبحِ قلقْ",18,"ق",1,1],["قُلتُ وَعَيني مُسبَلٌ دَمعُها","كَالدُرِّ مِن أَرجائِها هامِلُ",19,"ل",1,0],["قُلتُ وَجدي بِها كَوَجدِكَ بِالما","ءِ إِذا ما مُنِعتَ بَردَ الشَرابِ",20,"ب",1,0],["قلتُ والليلُ بأعقابِ النهار","ألكِ الليلةَ في لحنٍ وجامِ",21,"م",1,0],["قلتُ والفجرُ سنى ياقوتةٍ","لألأت خلفَ السحاب الماطرِ",22,"ر",1,0],["قُلتُ وَاللَهُ حَفِيٌّ بِهِ بَل","تَلّهُ المَوتُ بِطَعنٍ خَفِيِّ",23,"ي",1,0],["قلتُ -والموجُ راقصٌ ومُغنٍّ-:","ليت شعري أذاكَ حفلُ قران؟",24,"ن",1,0],["قلت والناقوس في مرتش","والليل قد مد علينا الجناح",25,"ح",1,1],["قلتُ وخُبِّرتُكَ وصلتَها","حاشَ له من هذه الغلطهْ",26,"ط",2,0],["قلت والالام تفرى مهجتى","ويك ما تفعل فى الحرب الظبا",27,"ب",2,0],["قلتُ وهم من نَشواتِ الكرى","موائلٌ كالسُّجَّد الرّكَّعِ",28,"ع",1,0],["قلتُ وأطرافُ القنا شُخَّصٌ","ترمقنى عن زُرق أحداقِ",29,"ق",1,0],["قُلْتُ: وَيْلاَهُ، إِنَّ كَأْسَكَ سُمٌّ","وَحَرَامٌ عَلَيَّ رَشْفُ الْمُدَامِ",30,"م",1,0],["قلتُ وقد تهتُ في هَواهُ","يا ليتَني متُّ قبلَ هذا",31,"ذ",2,0],["قلتُ وقد أقبل يختالُ في","بُرْدَتِهِ يَسْبِي نُهى الناظرين",32,"ن",1,0],["قلت وذاك الخد لما استحى","فقال مثل الفجر فيه الشفق",33,"ق",1,0],["قلت وذاك الثغر ما أمره","فقال لما ذكرتك انطبق",33,"ق",1,0],["قلتُ وقد أنكرتُه لخَتلِهِ","مَن لك يوماً بأخيك كلِّهِ",34,"ه",1,0],["قلت وصبري عليه فان","يطيل رب السما بقاه",35,"ا",2,0],["قلت وقد جاء حر شاذا","لأي معنى قد جاء هذا",36,"ذ",2,1],["قلت وقد لج بي أذاه","وزاد ما بينه وبيني",37,"ن",2,0],["قلتُ والدمعُ على وَجنتِها","كالنَّدى في ثمرٍ قد نضَجا",38,"ج",2,0],["قلتُ والقلبُ عليها حائمٌ","مثلَ عصفورٍ من الحَبِّ التقَط",39,"ط",1,0],["قلت وخد الحب في شانه","نبت عذارٍ فيه لم يحسن",40,"ن",1,1],["قلتُ والواقع المرير فقالت","ذاك داء يطَبُّ بالنسيان",41,"ن",1,0],["قُلْتُ وَلِلقَاضِي فَنَادَى إذاً","مَا بَيْننَا لِلْوُدِّ مِن عَاقِدِ",42,"د",1,0],["قُلتُ وَفي الطَيرِ أَبي","مِنهُ وَعَمّي في الشَجَر",43,"ر",1,0],["قلتُ والرّكْبُ بأجوازِ الفَلا","عيسُهمُ مُنتعلاتٌ بالنَّجاء",44,"ا",2,0],["قلتُ وقَد أولعَ بي مُقلةً","نَجلاءَ في صَنعَتِها حاذِقَه",45,"ق",2,1],["قلتُ وقد أوردَني حبُّه","موارِداً ليسَ لَها مَصدرُ",46,"ر",1,1],["قُلت وَالرُوح في التَراقي مِن الوَج","د وَدَمعي خُيولَهُ في اِستِباق",47,"ق",1,0],["قُلتُ وَقد تَيَّمني طَرفُهُ","هذا هُوَ السِحرُ وَإِلّا فَلا",48,"ل",2,0],["قُلتُ وَقد قيلَ بَدا شِعرُهُ","بِمِثلِ ذاكَ الشِعرِ لا يُشعَرُ",49,"ر",1,1],["قلت ولا ينكره جاهل","فلا تسمتي خلق الأغلف",50,"ف",1,0],["قلتُ وقد كشّف عن صفحتَيْ","خدٍّ عليه الحُسْن مزْرورُ",51,"ر",1,0],["قلتُ وزهْوُ الزَهْرِ مستغرِقٌ","بعارضٍ من صُبحه ماطِرِ",52,"ر",1,0],["قلت واويلاه عزت حيلتي","ليتني يا منيتي كنت يشوع",53,"ع",1,0],["قلتُ والطيبُ قال طَشٌّ من الم","اورد يزجي سحاب ندٍّ وعود",54,"د",1,0],["قلت والنَقْلُ قال تقبيلُ خدٍّ","من حبيب ورشْفِ ثَغْر بَرُود",54,"د",1,0],["قلت وقد تنفست","هذا خرا أم بخر",55,"ر",1,0],["قلت وما قصدي رياء بما","أقول في الناس ولا سمعة",56,"ع",2,1],["قلت ومن يضمن لي مهجتي","بأنها تبقى إلى قابل",57,"ل",1,0],["قلت وقد أعرضت عن عرضه","إذ ليس للذم بمستاهل",57,"ل",1,0],["قُلتُ والقلبُ منَ الغَي","ظ يُعاني ما يُعاني",58,"ن",2,0],["قلتُ وقد لاح بريقُ الدُّجى","مَنْ رَصّع الظّلماءَ بالعسجدِ",59,"د",1,1],["قلت وأعوادنا مدانيةٌ","يا وتراً حركته غانيةٌ",60,"ه",1,0],["قُلْتُ وَقَدْ أَبْصَرْتُهَا حَاسِرَاً","عَنْ سَاقِهَا فَاضِلَ أَذْيَالِهَا",61,"ل",3,0],["قُلْت وقد لَجَّ في مُعاتَبَتي","وظَن أَنَّ الملاَلَ من قِبَلي",62,"ل",2,1],["قلتُ ولِمْ يا قاتِلي قالَ لِي","لا يَدْخلُ الجَنَّةَ قتَّاتُ",63,"ت",1,0],["قُلْتُ وقَدْ أَقْبَلَ فِي حُلّةٍ","سَوْداء مِن حَلٍّ بأحشَائِي",64,"ي",1,1],["قُلْتُ وَقَدْ أُبْرِزَتْ بِنَعْشٍ","فَوْقَ رِقَابِ الأَنامِ تَمْشِي",65,"ي",1,1],["قُلْتُ وَقَدْ أَقْبَلَ يَسْعَى بِهَا","صَفْراءَ تَحْكي فِعْلَ عَيْنَيهْ",66,"ه",1,1],["قلت وقد اخبرتهم معلناً","لو انهم اصغوا لقول الخَبير",67,"ر",1,0],["قلت وصول الخطافي","وملاقاة النسم",68,"م",1,0],["قُلتُ وَاللَّه باد مِن حَيث أَضحى","بَينَ غُصنَينِ ناشِراً لَحمَ عالِم",69,"م",1,0],["قُلتُ وَمَن يَخلُصُ مِن قَيدِهِ","أَيَنثَني يَطلُبُ ذُلَّ القُيودْ",70,"د",1,0],["قُلتُ وَالراحُ في أَكُفِّ النَدامى","كَنُجومٍ تَلوحُ في أَبراجِ",71,"ج",1,1],["قُلْتَ والقَلْبَ حَسْرَةَ يَتقَّلى","وعلى الَخدِّ دَمْعُ عَيني يَسيلُ",72,"ل",1,0],["قلت والليل له ال","ويل مقيم غير ساري",73,"ر",2,1],["قُلْتُ وَنَسْجِي مُسْتَجِدٌّ حَوْكا","لَبَّيْكَ إِذْ دَعَوْتَنِي لَبَّيْكا",74,"ك",2,1],["قُلْتُ وَجَدَّ الوِرْدُ بِالفُرّاطِ","لا بُدَّ مِنْ جَبِيهَةِ الخِلاطِ",75,"ط",1,0],["قُلْتُ وَقَد أَقْصَرَ جَهْل الأَصْوَرِ","لَيْتَ الشَبابَ يُشْتَرَى فَنَشْتَرِي",76,"ر",2,1],["قُلْتُ وَأَقْوَالِي يَسُؤْنَ الكُشَّحَا","لَها إِذا حاوَلْتُ نَحْواً مُنْتَحا",77,"ح",2,1],["قلت وقد ماس في الكسا رشاً","يخجل بدر التمام حين بدا",78,"د",2,1],["قُلْتُ وقَدْ عَقْرَبَ صُدْغاً لَهُ","عَنْ مَشْقِهِ الْحاجِبُ لمْ يُحْجَبِ",79,"ب",1,1],["قُلت وَمَن ذاكَ فَقالَ تاجر","ذو ثَروة كانَت لَهُ جَواهِر",80,"ر",1,1],["قُلت وَمَن جابر قالَ رَجُل","مِن مازن قصته لا تجهل",81,"ل",1,1],["قلتُ وفصلُ الربيعِ قد رَقم ال","أرضَ بنَورٍ من نَبتِه الغضِّ",82,"ض",1,1],["قُلتُ وَأَومَأتُ بِكَفّي إِلى","صَدري مُشيراً أَنتِ مِنّي هُنا",83,"ن",2,0],["قُلتُ وَقَد أَقبَلَت بِخالٍ","يَسبي عَلى خَدِّها اليَسارِ",84,"ر",1,1],["قُلتُ وَقَد أَقبَلَ ياقوتُ","في فَمِهِ دُرٌّ وَياقوتُ",85,"ت",1,1],["قلتُ ومن منكم استحلى لَهُ سقِماً","وهنَّ فيهِ اقتحمنَ الموت في طربِ",86,"ب",1,0],["قلت واللَه لا طربت بعيش","في زمان أنا غدوت خبيره",87,"ر",2,0],["قلت والحين ممسك بشجاه:","إنها حرب تغلب الغلباء",88,"ا",2,0],["قلت وقالوا بان أحبابه","وبدَّلوهُ البعدَ بالقربِ",89,"ب",1,1],["قلت ومنه الشمس قد اشرقت","تباركت قدرة خلافه",90,"ه",1,0],["قُلتُ وَالمَوتُ يا أُمامُ كَرِيهٌ","لَيتَني مُتُّ يَومَ ماتَ الرَّسولُ",91,"ل",1,0],["قلت وسع النفس من تحليله","ليس مما جاز تحريم الأثر",92,"ر",1,0],["قلت والدمع حميما","قد جرى يا صاح رفقا",93,"ق",2,0],["قلت والطرف إليها باهت","هكذا حسن الليالي المقمرات",94,"ت",1,0],["قُلتُ وَقَد عَانَقتُهُ","والبَدرُ مَزَّقَ الحَلَك",95,"ك",1,1],["قلتُ وأيّ الكلامِ أولى","أذكر والذاكرون هِيْمُ",96,"م",1,0],["قلت وقد تيّمني حُبُّه","وأهْلُه عني لا يشعرون",97,"ن",1,0],["قلت وقلبي لبرد فيه","كابد وقد الضما وحره",98,"ر",2,0],["قلت وقفه تجودي بها جنح الظلام","شر في بالتلاقي محلى",99,"ل",2,0],["قلت وآغارة الله وهذا الدمع سال","وافرق اهلي وهو لا يجوز لي",99,"ل",2,0],["قُلتُ وَاللَهِ لاَأَطعتُكَ فيما","هِيَ روحي فَكَيفَ أَترُكُ روحي",100,"ح",2,0],["قلت والإسلام ديني","ليتني كنت ترابا",101,"ب",2,0],["قُلتُ وَاللَيلُ مُطبِقٌ بِعُراهُ","لَيتَني مِتُّ قَبلَ تَركِ سَعيدِ",102,"د",1,0],["قلت ولي ذنب فما حيلتي","وما اعتذاري يوم ألقاهم",103,"م",1,0],["قلت وإني أحمد مؤرخاً","قرة عين لي من الدنيا علي",104,"ي",1,0],["قلت والحبُّ مسرعٌ بالرواح","يا مليحاً تفديك كلُّ الملاح",105,"ح",1,1],["قلت وهل تقلُّ في ذوقكم","حلاوة التفاح إذ يكبر",106,"ر",1,0],["قلت وما تبغي بها قال لي","أريد أن أبقيها عندي",107,"د",2,0],["قلت ولّوا الى سواي فإني","لا أرى الشعر قاضي الحاجات",108,"ت",1,0],["قلت والضرب له أح","سست منه أقتله",109,"ل",2,0],["قلت وقع فكلانا مثله","قطعت أوتارنا كف القدر",110,"ر",1