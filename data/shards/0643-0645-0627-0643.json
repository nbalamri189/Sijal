{"poems":[[65,"خليلي إن السيل قد بلغ الزبى","https://www.aldiwan.net/poem45713.html","الطويل"],[44,"رأيت زيادا يجتويني بشره","https://www.aldiwan.net/poem50454.html","الطويل"],[37,"لقد كنت للمظلوم عزا وناصرا","https://www.aldiwan.net/poem38820.html","الطويل"],[32,"أللأربع الدهم اللواتي كأنها","https://www.aldiwan.net/poem29555.html","الطويل"],[32,"ألا لا أرى كالدار بالزرق موقفا","https://www.aldiwan.net/poem29595.html","الطويل"],[74,"شجون نحوها العشاق فاؤا","https://www.aldiwan.net/poem18162.html","الوافر"],[53,"راجعت بعد الجهل حجرا","https://www.aldiwan.net/poem64034.html","مجزوء الكامل"],[53,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[53,"شربت وقد كان الشباب محللا","https://www.aldiwan.net/poem66057.html","الطويل"],[93,"شوق يروح مع الزمان ويغتدي","https://www.aldiwan.net/poem8800.html","عموديه"],[30,"لعمري لقد أوفى وزاد وفاؤه","https://www.aldiwan.net/poem1239.html",""],[30,"رأيت بني مروان يرفع ملكهم","https://www.aldiwan.net/poem1276.html",""],[30,"يقول الأطباء المداوون إذ خشوا","https://www.aldiwan.net/poem1281.html",""],[30,"جزى الله عني في الأمور مجاشعا","https://www.aldiwan.net/poem5285.html","الطويل"],[54,"أبى آبي الهوى أن لا تفيقا","https://www.aldiwan.net/poem26799.html","الوافر"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72210","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55168","الطويل"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/199480","المتقارب"],[38,"جَزَى اللُه خَيْراً وَالجزاءُ بكفِه","https://www.poetsgate.com/ViewPoem.aspx?id=15877",""],[97,"النسر","https://www.poetsgate.com/ViewPoem.aspx?id=706",""],[53,"شربتُ وقد كان الشبابُ مُحلِّلا","https://www.poetsgate.com/ViewPoem.aspx?id=30388",""],[113,"كم أكتب ما جرى ودمعي يملي","https://www.aldiwan.net/poem16664.html","الدوبيت"],[138,"أمن أجل حبل ذي رمام علوته","https://www.aldiwan.net/poem21024.html","الطويل"],[141,"سرى طيف ذا الظبي بالعاقدان","https://www.aldiwan.net/poem67914.html","الكامل"],[164,"كما كان إسماعيل يحيى به يحيا","https://www.aldiwan.net/poem58823.html","الطويل"],[211,"كما كان يبغيها كليب بظلمه","https://www.aldiwan.net/poem27910.html","الطويل"],[274,"أبا الأطول طولت","https://www.aldiwan.net/poem26458.html","الهزج"],[280,"سقى الله وردا شاقني زهره الغض","https://www.aldiwan.net/poem25490.html","الطويل"],[285,"أدنى اشتياقي أن أبيت عليلا","https://www.aldiwan.net/poem60594.html","الكامل"],[287,"زار الحبيب وحياني فأحياني","https://www.aldiwan.net/poem32354.html","البسيط"],[303,"معيني على نفس شتيت جميعها","https://www.aldiwan.net/poem36313.html","عموديه"],[310,"لا والذي بثناكم منطقي فتقا","https://www.aldiwan.net/poem56463.html","البسيط"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[369,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[369,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60851.html","الرجز"],[371,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[382,"جلا مذ تجلى أعينا فيك تدمع","https://www.aldiwan.net/poem59341.html","الطويل"],[382,"قالت إليك فقلت طرفي أرمد","https://www.aldiwan.net/poem66873.html","الكامل"],[408,"كم أكتم لوعتي وكم أخفيها","https://www.aldiwan.net/poem46665.html","الدوبيت"],[422,"تبين حق للعباد وباطل","https://www.aldiwan.net/poem53998.html","الطويل"],[435,"كم اكتم الوجد والأجفان تعلنه","https://www.aldiwan.net/poem40510.html","البسيط"],[438,"خذوا لقلبي أمانا من تجنيه","https://www.aldiwan.net/poem12768.html","البسيط"],[469,"أضاء ثغر سليمى ليلة العلم","https://www.aldiwan.net/poem3473.html","عموديه"],[519,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[534,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[563,"خذوا علمكم بالله لا تتأخروا","https://www.aldiwan.net/poem34489.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48768","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70828","المنسرح"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145828","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62485","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120077","السريع"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96464","الوافر"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18251","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56237","الوافر"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47439","المتقارب"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67370","المتقارب"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11189","الطويل"],[1954,"","https://poetry.dctabudhabi.ae/diwan/poem/188166","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27791","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116519","الطويل"],[2769,"","https://poetry.dctabudhabi.ae/diwan/poem/98163","المنسرح"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65951","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58438","الطويل"],[2927,"","https://poetry.dctabudhabi.ae/diwan/poem/33034","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202572","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134025","الكامل"],[3170,"","https://poetry.dctabudhabi.ae/diwan/poem/115120","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26112","الطويل"],[3482,"","https://poetry.dctabudhabi.ae/diwan/poem/140167","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138589",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92369","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94594","الطويل"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117175","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72515","البسيط"],[4869,"ما على المجنون ديّه","https://www.poetsgate.com/ViewPoem.aspx?id=151579",""],[5183,"عبرات الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=180253",""],[5314,"أحدث غيما","https://www.poetsgate.com/ViewPoem.aspx?id=214822",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[592,"ألا قل لرب البيت من كان ناظماً","https://www.poetsgate.com/ViewPoem.aspx?id=128888",""],[5389,"شقيق الندى","https://www.poetsgate.com/ViewPoem.aspx?id=205376",""],[5818,"حنانيك يا أماه","https://www.poetsgate.com/ViewPoem.aspx?id=182576",""],[5923,"سورية الميساء","https://www.poetsgate.com/ViewPoem.aspx?id=150626",""],[5953,"بإسماعيل تهتم يا رعاء","https://www.poetsgate.com/ViewPoem.aspx?id=93799",""],[6070,"القاضي والذئب","https://www.poetsgate.com/ViewPoem.aspx?id=188079",""],[6101,"مبتور عدوك / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120280",""],[6152,"الصبر على البلاء","https://www.poetsgate.com/ViewPoem.aspx?id=204603",""],[6164,"صراع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66057&r=&rc=66",""],[6185,"نرجّيْكَ للجُلَى !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86943&r=&rc=3",""],[6225,"رؤية المصطفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78023&r=&rc=108",""],[2220,"إذا ما ذكرتَ اللهَ في غسق الدجى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11296&r=&rc=170",""]],"verses":[["كَما كُنتُ أَلقى مَن يُبيحُ حِماكُما","بِأَسمَرَ عَسّالٍ وَأَبيَضَ باتِكِ",0,"ك",1,0],["كَما كُنتَ لَو آخَيتَني لَوَجَدتَني","أُكارِمُ مَن آخَيتُهُ وَأُباذِلُه",1,"ل",2,0],["كَما كانَ حِصناً لا يُرامُ مُمَنَّعاً","بأَشبالِ أُسدٍ لا يُرامُ عَرينُها",2,"ن",3,0],["كَما كُنتَ تَلقى قَبلُ في كُلِّ مَنزِلِ","عَهِدتَ بِهِ مَيّاً فَتِيٍ وَشارِفِ",3,"ف",1,0],["كَما كُنتُ أَطوي النَفسَ عَن أُمِّ سالِمٍ","وَجاراتِها حَتّى كَأَن لا أُهيدُها",4,"د",3,0],["كما كان الغمامُ عليه ظلاًّ","عليهِ الآنَ يسفحُ ما يشاء",5,"ا",2,0],["كم أكسباني قبل شع","رك وُزَّناً بيضاً وصُفرا",6,"ر",2,0],["كم أكلَ البيهقيُّ أجْرتها","في بطن زوشٍ سليل أزْواش",7,"ش",1,0],["كما كان قبل الدين في الشيب زاجرٌ","لمن كان من شُرَّابها متكرِّما",8,"م",2,0],["كَم آكِلٍ ثَمَراً سَقاهُ غَيرُهُ","دَمَه وَكَم مِن زارِعٍ لَم يَحصُدِ",9,"د",1,0],["كَما كانَ أَوفى إِذ يُنادي اِبنُ دَيهَثٍ","وَصِرمَتُهُ كَالمَغنَمِ المُتَنَهَّبِ",10,"ب",1,0],["كَما كانَ أَروى إِذ أَتاهُم بِأَهلِهِ","حُطَيئَةُ عَبسٍ مِن قُرَيعٍ ذَنوبُها",11,"ب",3,0],["كَما كانَ يَستَحيِي أَبوهُ إِذا دَعا","لَهُ مُستَغيثٌ حينَ هَرَّ كَليبُها",12,"ب",3,0],["كَما كانَ يَلقى الزِبرِقانُ وَلَم يَزَل","يُعالِجُ مَولىً يَستَقيمُ وَيَظلَعُ",13,"ع",1,0],["كَما كَذَبوا عَلَيهِ وَهوَ حَيٌّ","فَأَطعَمَ نارَهُ مِنهُم فَريقا",14,"ق",2,0],["كَما كُنْتَ إذ كنتَ المُنَحَّى من الرّدَى","إذا الخَيْلُ جالَتْ بالقَنا المتقصِّفِ",15,"ف",1,0],["كَمَا كُنْتَ يَا يَعْقوبُ فَلْيَكُنِ الَّذِي","يَجِدُّ فَلاَ يُلْوِي بِلَهْوٍ وَلا هَزْلِ",16,"ل",1,0],["كما كان قبل غبيا بليدا","ففيم العناء؟ ففيم العناء؟",17,"ا",2,0],["كما كنت إذ كنت المنحى من الردى","غذا الخيل جالت بالقنا المتقصفِ",18,"ف",1,0],["كم اكبت عليه وهي تندي","فوقه قبلة الضحى المخمور",19,"ر",1,0],["كما كان قبل الذين في الشيب زاجرٌ","لمن كان من شُرابها متكرما",20,"م",2,0],["كَم أَكتُب ما جَرى وَدَمعي يُملي","ما أَضمر مِن اليُم فَقد الأَهل",21,"ل",1,1],["كَما كانَ يَقضي في أُمورٍ تَنوبُنا","فَيَعمدُ لِلأَمرِ الجَميلِ وَيَفصِلُ",22,"ل",1,0],["كَما كانَ إِذ كانَ في مُلكِهِ","يَزيدُ يُرجي لِتِلكَ الوَليدا",23,"د",2,0],["كما كان إسماعيل يحيى به يحيا","تراه بيحيي اليوم في قبره يحيا",24,"ي",2,1],["كَما كانَ يَبغيها كُلَيبٌ بِظُلمِهِ","مِن العِزَّ حَتّى طاحَ وَهوَ قَتيلُها",25,"ل",3,1],["كَما كانَ وَقَد كانَ","بِهِ القُرحَةُ مَكحولُ",26,"ل",1,0],["كَما كَرَعَ النَّدْمَانُ في كَأْسِ فِضَّةٍ","بِنادٍ لِخَيْلِ الأُنْسِ أثْنَاءَهُ رَكْضُ",27,"ض",1,0],["كَمْ أَكْتُمُ الشُّوْقَ الْمُبَرِّحَ وَالْهَوى","وَكَفى بِدَمْعِي وَالسَّقامِ دَلِيلا",28,"ل",2,0],["كَم أَكتُمُ الوَجدَ وَالأَجفانُ تُعلِنهُ","فَالدَمعُ في كُلِّ عَينٍ مِنهُ عَينانِ",29,"ن",1,0],["كما كنت لا أَرضى ببذلِ ليانها","حذاراً وبقيا أَنْ يراضَ منيعها",30,"ع",3,0],["كَم أَكذبَ اللّه في خَفضي أَمانِيَهُم","وَردّهم بِصدورٍ تَلتظي حَنَقا",31,"ق",2,0],["كما كان آباؤهم في الحياة","يكونون والفرخ للطائر",32,"ر",1,0],["كَما كَساهُ قَلبُهُ سواده","من فبل أن يكسٌوَه أبراده",33,"ه",1,0],["كما كَساهُ قَلْبُه سَوادهَُ","من قَبل أن يَكْسُوَهُ أبْرادَهُ",34,"ه",1,0],["كَما كانَ نوحٌ إِذ طَغى الماءُ راكِباً","عَلى ذاتِ أَلواحٍ بِتَدبيرِهِ تَجري",35,"ر",2,0],["كما كان في يوم العِماد حمامةً","فقد كان في ذا اليوم ضوءاً يُشعشع",36,"ع",1,0],["كم أكمهٍ وافى وأبرَتهُ يدٌ","علويَّةٌ مذ كلَّ عنه الإثمد",37,"د",1,0],["كم أكتُمُ لَوعتي وكم أخْفِيها","والدمعُ إذا جرى دماً يُبْديها",38,"ه",2,1],["كما كانَ ما قد كانَ منه وغَرَّهُ","نصيحُ مداجٍ أو عدوٌّ مناضل",39,"ل",1,0],["كم اكتم الوجد والأجفان تعلنه","بغادةٍ كلما تلقاه تفتنه",40,"ه",1,1],["كم أكتمُ الحبَّ والأشجانُ تُظْهِرُهُ","وأنشُرُ الصّبْر والتّبريحُ يَطويهِ",41,"ي",2,0],["كم أكظمُ الوجد لا سعدى بكاظمةٍ","مع الشباب ولا سلمى بذي سلمِ",42,"م",1,0],["كمْ أكْمَهٍ بَرِئَتْ عَيناهُ إذْ مُسِحَتْ","من كفّهِ ولَكَمْ بالسّيفِ قدَّ كَمي",43,"م",2,0],["كَما كانَ الْخَوارِجُ في ابْتِداعٍ","يَشِيبُ لَها مِنَ الإسْلامِ فَودُ",44,"د",1,0],["كما كل أمر ربنا آمر به","لنا هو فينا خالق ومدبر",45,"ر",1,0],["كما كان في إثبات نفي المعية","يمينك بالوعد الكذوب مماطل",46,"ل",1,0],["كم أكرهوك وتأبى أن تعاملهم","إلا معاملة الإخوان والصحب",47,"ب",1,0],["كم أكلتْ مال زوجها مرحا","وأفشت المدحَ في مُطلّقها",48,"ق",3,0],["كمْ أكرَه ُالمِرآة َحينَ أرَى بهَا","طِفلاً يَجرُ بهِ المشيبُ لِيَفتكا",49,"ك",2,0],["كما كانت لوالده","ثويني غير منكورِ",50,"ر",1,0],["كم أكتم الوجد عليه وكم","يذيعه شأني إلى الشاني",51,"ن",2,0],["كَمَا كانَت جُمُوعُكُمُ تَوَلَّى","إِذا مَا أَبصَرَت لَجِباً لُهَامَا",52,"م",2,0],["كما كنست عين بوجرة لم تخف","قنيصاً لوم تفزع لصوت المكلب",53,"ب",1,0],["كما كرك البلاد بك استجارت","فعزَّت وازدهت بعد الاهانَهْ",54,"ن",2,0],["كَما كَسَفَ الشَّمْسَ بَدْرُ الدُّجَى","وَإنْ كانَ مِنْ نُورِها نُورُهُ",55,"ر",2,0],["كَمَا كَأنَ يَفْعَلُ فِي مِثلِهَا","إذا نَابَ مُعْصَوَصِبٌ مُنْكَرُ",56,"ر",1,0],["كَما كانَ لاقى في العُصورِ الَّتي مَضَت","عُرَيَّةٌ مِن شَحطِ النَوى وَجَميلُ",57,"ل",1,0],["كم أكبر الكون والتاريخ موقفكم","وأنت أنت فؤاد مشرق حدب",58,"ب",1,0],["كما كان فيما نال منه موعدا","فأصبح فيما نيل من