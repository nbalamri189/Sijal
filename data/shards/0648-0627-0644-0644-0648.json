{"poems":[[55,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[88,"لا والأسى وتلهب الأحشاء","https://www.aldiwan.net/poem10498.html","الكامل"],[90,"ظلموك أيتها الفتاة بجهلهم","https://www.aldiwan.net/poem44971.html","الكامل"],[29,"هاج الهوى وضمير الحاجة الذكر","https://www.aldiwan.net/poem5773.html","البسيط"],[29,"ما هاج شوقك من رسوم ديار","https://www.aldiwan.net/poem5785.html","الكامل"],[23,"يا حار إن كنت امرأ متوسعا","https://www.aldiwan.net/poem21444.html","الكامل"],[53,"أبو سليمان لا ترضى طريقته","https://www.aldiwan.net/poem66494.html","البسيط"],[31,"بئس الفوارس عند معترك القنا","https://www.aldiwan.net/poem6062.html","الكامل"],[47,"وواعظ منه لولا أنه حجر","https://www.aldiwan.net/poem63596.html","البسيط"],[101,"رسالة حب صغيرة","https://www.aldiwan.net/poem6320.html","عموديه"],[68,"من لم تضم الضيوف ساحته","https://www.aldiwan.net/poem38549.html","المنسرح"],[68,"برق المشيب قد أضا","https://www.aldiwan.net/poem40981.html","مجزوء الرجز"],[99,"أنت حي برغمِ عاد الفناء","https://www.aldiwan.net/poem24382.html","الخفيف"],[102,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[101,"رسالة حب صغيرة","https://www.poetsgate.com/ViewPoem.aspx?id=15749",""],[132,"أيها العاقل الذي شاء تزو","https://www.aldiwan.net/poem50678.html","الخفيف"],[147,"يا للرجال لنظرة سفكت دما","https://www.aldiwan.net/poem11808.html","الكامل"],[152,"اللؤم أكرم من وبر ووالده","https://www.aldiwan.net/poem761.html",""],[168,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[173,"العز ما خضعت لهيبته العدى","https://www.aldiwan.net/poem1618.html",""],[173,"قالوا الدبيثي ذو قواف","https://www.aldiwan.net/poem1671.html",""],[261,"واللوزة المرة يا سيدي","https://www.aldiwan.net/poem48399.html","السريع"],[274,"لما رأيت البز والشاره","https://www.aldiwan.net/poem26749.html","الرجز"],[287,"أشكو إلى أقوش عكس اسمه","https://www.aldiwan.net/poem32626.html","السريع"],[287,"يا نجم كم أدنو إليك وتبعد","https://www.aldiwan.net/poem32806.html","الكامل"],[287,"أدار ليلا قمر شمس راح","https://www.aldiwan.net/poem32831.html","السريع"],[302,"يا كوكبا لم تحوه الأفلاك","https://www.aldiwan.net/poem33205.html","الكامل"],[358,"من لصب لم ينل أربا","https://www.aldiwan.net/poem40782.html","المديد"],[358,"مستهل الدمع هاطله","https://www.aldiwan.net/poem40785.html","المديد"],[358,"مستهل الدمع ساكبه","https://www.aldiwan.net/poem40788.html","المديد"],[358,"مستهام رق وانتحبا","https://www.aldiwan.net/poem40811.html","المديد"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[376,"أين مكان السلو من عذلي","https://www.aldiwan.net/poem57231.html","المنسرح"],[409,"الحمد كل الحمد للخلاق","https://www.aldiwan.net/poem33620.html","الكامل"],[409,"يا فاضلا وافى إلينا شعره","https://www.aldiwan.net/poem33763.html","الرجز"],[409,"يا عالما قد شاع فينا ذكره","https://www.aldiwan.net/poem33765.html","الرجز"],[463,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[484,"راحة النهى الطرب","https://www.aldiwan.net/poem37059.html","المقتضب"],[520,"ما هاج مزنة دمعه المترقرق","https://www.aldiwan.net/poem12188.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122788","الخفيف"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130200","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38933","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59428","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133816","الخفيف"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143130","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64818","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90647","المنسرح"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93835","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94321","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140094",""],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138922",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132637","السريع"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112619","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138540",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102947","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44729","الكامل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105114","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81716","البسيط"],[4702,"حب الزبيب","https://www.poetsgate.com/ViewPoem.aspx?id=155198",""],[4702,"وردة الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=155328",""],[4767,"زورق الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215314",""],[4888,"زف الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=207759",""],[4914,"طاف بكأس المدام أغيد","https://www.poetsgate.com/ViewPoem.aspx?id=170939",""],[5043,"أجمل الأزهار","https://www.poetsgate.com/ViewPoem.aspx?id=204369",""],[5106,"سَاْجَ الهَوَىْ وًرِشَاً ..","https://www.poetsgate.com/ViewPoem.aspx?id=137169",""],[5136,"إن الكريم يلين عند عتابه","https://www.poetsgate.com/ViewPoem.aspx?id=121629",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5225,"أذهلتني","https://www.poetsgate.com/ViewPoem.aspx?id=24310",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5781,"ألْتذُّ منه بالرحيق!","https://www.poetsgate.com/ViewPoem.aspx?id=208761",""],[5829,"رياضُ الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=212095",""],[5956,"أ وَلم تضِق ذرعاً بعَون الناس؟","https://www.poetsgate.com/ViewPoem.aspx?id=215974",""],[6019,"يا أقسى من ليلٍ أسودْ","https://www.poetsgate.com/ViewPoem.aspx?id=202307",""],[6068,"الغدر مبنى أنت معناهُ -09-","https://www.poetsgate.com/ViewPoem.aspx?id=175840",""],[5051,"وفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87707&r=&rc=1",""]],"verses":[["وَاللُؤلُؤُ الرَطبُ في قَلائِدِهِ","ما كانَ لَولا الجَلالُ مَثقوبا",0,"ب",2,0],["وَاللُؤلُؤُ اِستَعصى عَلَينا نَظمُهُ","بِسُموطِ مَدحٍ أَو سُموطِ هَناءِ",1,"ا",2,0],["واللؤم أجمع أن تكون نساؤنا","مثل النعاج وأن نكون الأذْؤبا",2,"ب",2,0],["وَاللُؤمُ حالَفَ تَيماً في دِيارِهِمُ","وَاللُؤمُ صُيِّرَ في تَيمٍ إِذا حَضَروا",3,"ر",3,0],["وَاللُؤمُ قَد خَطَمَ البَعيثَ وَأَرزَمَت","أُمُّ الفَرَزدَقَ عِندَ شَرِّ حُوارِ",4,"ر",1,0],["وَاللُؤمُ مِنكَ وِراثَةٌ مَعلومَةٌ","هَيهاتَ مِنكَ مَكارِمُ الأَنسابِ",5,"ب",1,0],["واللوزُ لا فارقته لوزتا ورمٍ","فشرطه منه عند الشَّرْب ريعان",6,"ن",1,0],["وَاللُؤمُ حالَفَ بَيتَهُم وَفِناءَهُم","أَبَداً فَما فيما يَزولُ يَزولُ",7,"ل",1,0],["وَاللَومُ أَن تَدخُلوا في حَدِّ سَخطَتِهِ","عِلماً بِأَن سَوفَ يَعفو حينَ يَقتَدِرُ",8,"ر",1,0],["واللوز .. والتوليب حتى أن","تسير بي الدنيا إذا ما أسير",9,"ر",1,0],["وَاللُؤمُ يُذري مِن قَدرِ صاحِبِهِ","حَتّى لَقَد كادَ يَقتَضي كُفرَه",10,"ر",2,0],["وَاللَومُ لِلحُرِّ مُقي","مٌ رادِعٌ وَالبُعدُ لا",11,"ا",1,0],["واللواءُ الخصيبُ كم زادَ حبَّا","فانثنَى ظافراً عزيزَ اللواءِ",12,"ا",2,0],["واللواتي يزرنني (أم زيدٍ)","و(منى المعفري) و(سلوى العذيقي)",13,"ق",2,0],["واللّوزَ .. والتوليبَ حتى أنا","تسيرُ بِيَ الدنيا إذا ما أسيرْ",14,"ر",1,0],["واللواتي يأْوين كل بيتٍ","كل حينٍ من غير ما اسِتحياءِ",15,"ا",2,0],["واللواتي يقُلْنَ كل صباحٍ","هات ما تشتهي بلا إبطاءِ",15,"ا",2,0],["وَاللَومُ مِثلُ الريحِ يَذهَبُ ضَلَّةً","وَيَزيدُ نيرانَ المُحِبِّ تَضَرُّما",16,"م",2,0],["وَاللُؤمُ داءٌ لِوَبَرٍ يُقتَلونَ بِهِ","لا يُقتَلونَ بِداءٍ غَيرِهِ أَبَدا",17,"د",2,0],["وَاللَومُ لِلحُرِّ مُقيمٌ رادِعٌ","وَالعَبدُ لا تَردَعُهُ إِلّا العَصا",18,"ا",1,0],["واللُّؤمُ إِكرامُ اللَّئيمِ لِأَنَّهُ","كَالذِئبِ لَم يَرَ عَدوَةً إِلّا عدا",19,"د",2,0],["وَاللُؤمُ وَالشُؤمُ مِنهُ جُزءٌ","وَالغَدرُ وَالإِفكُ وَالنَميمَه",20,"م",2,0],["واللوزة المرة يا سيدي","يفسد في الطعم بها السكر",21,"ر",1,1],["وَاللَوزَ وَالسُكَّرَ يُرمى بِهِ","مِن فَوقِ ذي الدارِ وَذي الدارَه",22,"ر",2,0],["وَاللُّؤلُؤُ الرَّطبُ مَتى يَبتَسِم","يُلغَ فَما يُرغَبُ في نَظمِهِ",23,"م",2,0],["وَاللَونُ مِنها في الكُؤوسِ مُوَرَّدٌ","وَكَذاكَ دَمعي في الجُفونِ مُوَرَّدُ",24,"د",1,0],["واللُؤلُؤُ المَنظومُ حَسبي بِهِ","في الحُسنِ لا مَكنون بيضِ الأَداح",25,"ح",1,0],["وَاللوذعيُّ إذا تَسامَت رُتبةٌ","قَعساءُ فهو لنيلها دَرّاكُ",26,"ك",1,0],["وَاللواحي حمّلته عَنا","لَم يَزَل دَوماً يساهرُه",27,"ر",2,0],["وَاللواحي حمّلته عَنا","لَم يَزَل دَوماً يَواصلُه",28,"ل",2,0],["وَاللواحي حمّلته عَنا","لَم يَزَل دَوماً يصاحبُه",29,"ب",2,0],["وَاللَواحي حمّلته عَنا","لاعجٌ مِن وَجدِهِ اِلتَهَبا",30,"ب",2,0],["واللّونُ منه سافِرُ أضدادُه","من السّنا كَجَمرةٍ والجَمَد",31,"د",1,0],["واللَّومُ لُؤمٌ إِذا التَمستَ بهِ","مِن سُنَّةِ الجُودِ سُنَّةَ البخلِ",32,"ل",1,0],["واللؤلؤ المعروف أضحى زينة","للغانيات يُرَى على الأعناق",33,"ق",1,0],["واللوح فيه ذكره وطيه","يجوز للثالي كذاك نشره",34,"ر",2,0],["واللوح والقلم فيه ظاهر","وقد أبيح طَيُّه ونشره",35,"ر",2,0],["واللؤم دون مَذقةٍ","عُلّ بها وأُنهلا",36,"ل",2,0],["واللواحظ اتجهت","راش سهمها الهدب",37,"ب",1,0],["واللوم يفرق أن يلم بمسمعي","برق متى ما لم يلاطف يبرق",38,"ق",1,0],["وَاللِّوَى هَل هُوَ اللِّوَى وَهَلِ الريَّ","انُ مِن بَعدِنا هُوَ الرَّيانُ",39,"ن",1,0],["واللؤلؤ الرطب لما لحت مبتسما","في عزة بات يشكو ذلة اليتم",40,"م",1,0],["وَاللّؤم وَاللَّهِ لا يَخفى تَفاوتهُ","وَأَلأمُ النّاسِ مَن عادى مَشايِخَهُ",41,"ه",1,0],["واللوح والقلم المبين بخطّه","اسرار وضع الحرف في القرطاس",42,"س",1,0],["واللون هل هو إلا","ما تَحسَب الأبصار",43,"ر",1,0],["واللون غير معين أيا يكن","بعد الفراهة لونه لم يسمج",44,"ج",1,0],["واللَّومُ لا شكَّ فيهِ لُؤْمٌ","لمُقْتَضَى حِكْمةِ الجِناسِ",45,"س",1,0],["واللون كالعاهة في التعجب","والفعل أشدد أو أشد فاجتبى",46,"ب",2,0],["وَاللَّومُ لِلحُرِّ مُقِيمٌ رَادِعُ","وَالعَبدُ لا يَردَعُهُ إِلا العَصَا",47,"ص",2,0],["واللؤمُ والذُّلُ والضَّراعةُ وال","فاقةُ في أصلِ أُذنِ من طمعا",48,"ع",2,0],["واللَّومُ لا يعدُوه إذ هُوَ فَاعِلٌ","بإرَادةٍ وَبِقَدرَةِ الحَيوَانِ",49,"ن",1,0],["واللوز لا يؤكل إلا أن غدا","مكسراً وقلبه سليب",50,"ب",1,0],["واللوح ثم الكاتبون والقلم","والعرش والكرسى فافهم الحكم",51,"م",1,0],["واللوز الأخضر جآ لابس جبة","خضرآ مزغبة كمثل الجوخة",52,"ه",1,0],["واللوز قد بث حياة في الورى","كانت ملاكا لحياة الخضر",53,"ر",1,0],["واللوم والعتب على صرفه","وما على الأحرار من باس",54,"س",1,0],["واللومُ والعارُ لتلك الأمّه","كيف اغتَدَت بمثله مؤتَمه",55,"ه",1,0],["واللؤلؤ المكنون من ملتقى","البحرين بحري عصمة أو رشاد",56,"د",1,0],["واللؤم في الطبع اللئيم مركب","كالزند في طرفيه نار توقد",57,"د",1,0],["واللَّوحُ وَالقَلُم وَالكُرسِىُّ","وَالعَرشُ ذُو الجَسَامَةِ القُدَسِى",58,"س",2,0],["وَاللوفَرُ المَشهورُ قَد وَضِعَت بِهِ","تُحفٌ بِمثِلِ جَمالِها لَن تَحلُما",59,"م",2,0],["واللؤلؤ المنضود في ياقوته","يعنو إليه اللؤلؤ المنضود",60,"د",1,0],["واللَّوحُ والقلمُ العلويُّ سبَّحَهُ","واللَّوحُ والعرشُ والكرسيُّ والملكُ",61,"ك",1,0],["واللول الاخر زان من فرعة الجيد","اليا نثرتي من وراه الجديله",62,"ل",2,0],["واللول يلمع لابدا ثغرك وحلو المبسما","واليا ضحكتي ينثره وتْلملمه لك شفّتيك",63,"ك",1,0],["واللَّومُ ما استَسهَلهُ لائمٌ","مِن بعدِه الأمرُ له أصعب",64,"ب",1,0],["واللونُ مطموسٌ يشكِّكُ بعضُه","في الصبحِ يسكبُ في الشوارعِ أحمَرَه",65,"ر",2,0],["واللوم داء إذا تعدى","للذات من أصلها تشدد",66,"د",1,0],["واللوزُ وزهرُ الليمونِ","والخَوْخُ وزهرُ الرمّانِ",67,"ن",1,0],["وَالْلَّوْزُ فِيْ هَاْذِهِ الْعَيْنَيْنِ قَدْ عَرَشَتْ","وَالْخَالُ فِيْ خَدِّهَاْ بِالْمَاْسِ قَدْ نَبَسَا",68,"س",2,0],["واللؤم يأتي للئيم بطبعه","رغما وإن بالغت في ألطافه",69,"ه",1,0],["واللوم، كل اللوم،","فيه عليك، من أم وأب",70,"ب",1,0],["واللواحظ كالسيوف مسّلله","كنّ يلعب بالهدب موج الشلال",71,"ل",1,0],["واللون في كمدٍ والعقل في خمدٍ","والرأس في ألمٍ والأهل في وجمِ",72,"م",1,0],["واللُّؤْلؤُ المَكْنونُ حينَ تَخَلَّفَتْ","شَفَةٌ عنِ الإِطْباقِ لمْ يَتَوَجَّسِ",73,"س",1,0],["واللّوز ما أشهى المذاقَ لمُطعَمٍ","هو أولُ الثماراتِ للخلّانِ",74,"ن",1,0],["واللؤم في العُهَّار شرُّ طبيعةٍ","أمّا الوفاء فقط لدى الأقداسِ",75,"س",1,0],["واللَّونُ البائسُ في عيني","إذ يَرسِمُ غُولاً في المَشهَدْ",76,"د",1,0],["واللوم لومٌ في محبتكم","كنت الغبيّ إذا تلقّاهُ",77,"ا",2,0],["واللّوْحُ مَحْضُ جمادٍ قُدَّ مِنْ خَشبٍ","وهلْ رأيتَ جماداً علَّمَ النُّطَفَا ؟",78,"ف",2,0]]}