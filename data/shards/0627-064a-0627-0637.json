{"poems":[[52,"أيا طلحة قد كنت","https://www.aldiwan.net/poem63798.html","الهزج"],[48,"أيا طفل الشفيقة إن ربي","https://www.aldiwan.net/poem22155.html","الوافر"],[136,"آمنت من الخطوب أتيت طوبى","https://www.aldiwan.net/poem54892.html","الطويل"],[136,"آي أطلال الأوداء","https://www.aldiwan.net/poem54896.html","المديد"],[273,"أيا طالب الدنيا وتارك الاخرى","https://www.aldiwan.net/poem69127.html","عموديه"],[408,"أيا طلعة القمر الزاهر","https://www.aldiwan.net/poem46692.html","المتقارب"],[412,"أرى الشعب فانظر دونه هل هو الشعب","https://www.aldiwan.net/poem50205.html","الطويل"],[580,"أيا طربي من غنيتي إذ تغنت","https://www.aldiwan.net/poem2979.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63962","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59699","الطويل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79379","المتقارب"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78143","البسيط"],[1600,"","https://poetry.dctabudhabi.ae/diwan/poem/146092","الطويل"],[1695,"","https://poetry.dctabudhabi.ae/diwan/poem/144208","المتقارب"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101416","الطويل"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84875","الطويل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107171","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75871","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202863","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199998","المتقارب"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65124","الطويل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71344","المتقارب"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71349","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138599",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110059","الطويل"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32626","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135153","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44712","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45993","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45933","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95069","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83625","الطويل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104539","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33599","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33261","المتقارب"],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130289","الطويل"],[4884,"غَدْرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202179",""],[5015,"طب القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=206130",""],[5111,"أرجُ اللقاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=212130",""],[5121,"لذيذ الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=33869",""],[5135,"طيفَ الأحبةِ","https://www.poetsgate.com/ViewPoem.aspx?id=201973",""],[5219,"أشجان عربي","https://www.poetsgate.com/ViewPoem.aspx?id=194935",""],[5277,"نخلةُ (الصوبين)","https://www.poetsgate.com/ViewPoem.aspx?id=185564",""],[5277,"نورس الصوبين","https://www.poetsgate.com/ViewPoem.aspx?id=186441",""],[5431,"أياطفلي...","https://www.poetsgate.com/ViewPoem.aspx?id=183070",""],[5431,"تعِزّ...الحبية تعزّ...حماها الله","https://www.poetsgate.com/ViewPoem.aspx?id=190354",""],[5573,"ملامح روح","https://www.poetsgate.com/ViewPoem.aspx?id=200350",""],[5657,"أيا طالبا نظم الفرائد في عقد","https://www.poetsgate.com/ViewPoem.aspx?id=122917",""],[5956,"بوساطة محمد عصفور","https://www.poetsgate.com/ViewPoem.aspx?id=205162",""],[6068,"يعذبني التذكار رائعة البسم -14-","https://www.poetsgate.com/ViewPoem.aspx?id=177649",""],[6120,"أَيَا طَالِبَ الْبُعْد","https://www.poetsgate.com/ViewPoem.aspx?id=216032",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6239,"نُور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75986&r=&rc=37",""]],"verses":[["أَيا طَلحَةُ قَد كُنتَ","عَلى خَيرٍ مِنَ الخيرِ",0,"ر",1,1],["أَيا طَلحَةُ قَصَّرتَ","وَلا أَرضى بِتَقصيرِ",0,"ر",1,0],["أَيا طِفلَ الشَفيقَةِ إِنَّ رَبّي","عَلى ما شاءَ مِن أَمرٍ مُقيتُ",1,"ت",1,1],["آيَا طُوبَآ أتَيتُكِ مُستَجِيراً","أسِيرَ مَآثِمٍ فَلِقاً حَرِيبَا",2,"ب",2,0],["آي أطلاَلِ الأوِدَاءِ","هَيَّجت لاَعِجَ الدَّاءِ",3,"ا",2,1],["أيا طالب الدنيا وتارك الاخرى","ستعلم بعد الموت أيهما أحرى",4,"ر",2,1],["أيا طلعةَ القمرِ الزّاهرِ","ويا قامةَ الغُصنِ النّاضرِ",5,"ر",1,1],["أَيا طيباً غَوث العُفاة دعاكَ مَن","مَوارده رتقٌ وَأَيَّامُهُ إِلبُ",6,"ب",1,0],["أَيا طربي من غُنْيَتي إِذ تَغَنَّتِ","وَيا حَزَني من جَنَّتي إِذ تَجنَّتِ",7,"ت",1,1],["أيا طيرَ الغُصونِ اصغي لِنَوْحي","ورُوضي مثلَهُ إِنْ شيتِ رُوضي",8,"ض",2,0],["أيا طالباً برّي بتقبيل أكمام","ومُلتقياً أمْري ببشر وإنعام",9,"م",1,1],["أيا طيبَ عيشي أرى بركةً","تسوق إلى روضِها ماءها",10,"ه",2,1],["أَيّا طَفقت لَدى اللُقيا أَقول لَها","وَالقَلب في وَجَل وَالجِسمُ في عِلل",11,"ل",1,0],["أيا طارقي أحججْ ويا رائدي ابتهجْ","ويا سابقي عرّج ويا صاحبي عجِ",12,"ج",1,0],["أيا طالب المذهب المجتبى","تعلم من النحلة المذهبا",13,"ب",2,1],["أَيَا طَيفَهُ زُرْني لِيسكُنَ مَضْجَعِي","وَيَا شَخصَهُ عُدْني لِتُطفِى لَظَى كَرْبي",14,"ب",2,0],["أَيا طَلعة العليا لَنا بِالصفا جُودي","فَقَد هَلَ مَولود المَكارم وَالجُود",15,"د",1,1],["أَيا طالِبَ الفَضلِ الَّذي كُنتَ نِلتَهُ","بِسَعي أَغَرٍّ لَم يَكُن بِمُذَمَّمِ",16,"م",1,0],["أَيا طالِباً أَن يَنالَ الأَرَب","قَريباً عَلَيكَ لِسانُ العَرَب",17,"ب",1,1],["أيا طير استمع مني حديثاً","ولا تقطع حديثي بالغناء",18,"ا",2,1],["أيا طير من ريشكم فانسلوا","وطيروا هنيئين أو حوّموا",19,"م",3,1],["أيا طالبا علم الكنوز أجد له","مديحا تجد في طيّ أمداحه كنزا",20,"ز",2,0],["أَيَا طَلْعَةَ القَمَرِ المُبْهِجِ","وَيَا فِتْنَةَ المُسْتَهَامِ الشَّجِي",21,"ج",2,1],["أَيا طَارِحاُ تِلْكَ الحَبَائِلَ صَائِداً","هِيَ الصَّيْدُ فَاطْرَحْ طَرْحُهَا غَيْرُ طَارِحِ",22,"ح",1,0],["ايا طيبة قد طبت لكن دهرنا","لنا نغص العيش الهني وكدرا",23,"ر",2,0],["ايا طُورَ تابورَ الذي حلَّ سَفحَهُ","الهٌ لهُ كلُّ البرايا خوادمُ",24,"م",1,0],["أَيا طَيلَسانِيَ أَعيَبتَ طِبّي","أَسِلٌّ بِجِسمِكَ أَم داءُ حُبِّ",25,"ب",1,1],["أيا طالب الوصل الفصال تواصل","ويا طالب الفصل الوصال تفاصل",26,"ل",1,1],["أَيا طَيّباً طابَت سَجاياهُ بَينَنا","وَقَد نوَّرَ الأَوطانَ تَحريرهُ العالي",27,"ل",2,1],["أَيا طالِباً يَبغي دَواءً لِذَنبِهِ","إِذا أُثقِلتَ مِن حَملِ أَوزارِهِ الظَهرُ",28,"ر",1,0],["أَيا طالِباً لِلعِلمِ إِن رُمتَ تَجتَني","ثِمارَ عُلومٍ مِن رِياضٍ أَنيقَةِ",29,"ه",1,0],["أيا طامعاً بالتُرهات فخذ لها","نموذج حالات توارت عصورُها",30,"ر",3,0],["أَيا طيبَة طابَت بأَطيب رَوضَةٍ","سقاك الحيا لا نابك الجذبُ وَالقَحطُ",31,"ط",1,0],["أيا طيور القلوب ميلي","فليس بعد الورود راحم",32,"م",1,0],["أيا طعمَ الرقادِ أقِم هنيئاً","بمقلةِ مَن يَنامُ ولا أنامُ",33,"م",1,0],["أيا طرفُ مالك لا ترقد","وما لدموعِك لا تجمدُ",34,"د",1,1],["أيا طائر السمّان مالك مفردا","تأسيت بي أم عاق الفك عائق",35,"ق",1,1],["أيا طعنةً من كفِّ غدرٍ خسيسةٍ","أراقت دمَ الحامي، وما هو خانعُ",36,"ع",1,0],["‏أيا طب القلوب كفاك عودي","فإن العظم من فرقاك رقا",37,"ق",2,1],["أَيَا طَيْفًا غدَا نُورًا وَلاحَا","وَيَا عِشْقًا بَسَطْتُ لَهُ الْجَنَاحَا",38,"ح",2,1],["أيا طيفًا إذا استوحى","غدا الإحساسُ رقراقا",39,"ق",2,0],["أيا طيفَ الأحبةِ زادَ همي","أصابَ الجسمَ بعدهمُ النُّحولُ",40,"ل",1,1],["أيا طائرا طف بكل البلاد","وناد لبيبا وعى فاعتبر",41,"ر",1,0],["أيا طوقها والماس يبدو بجيدها","تنائي جمال الجيد ادنى مدانيا",42,"ي",2,0],["أيا طيفها في الليل لو زرت زورة","شفيت بمر الليل مني خياليا",42,"ي",2,0],["أيا طوْقَها والماسُ يبدو بِجيدِها","يُنائي جمالُ الجيدِ من ذا لحانيا",43,"ي",2,0],["أيا طيفَها في الليلِ لو زُرتَ زورةً","لتشفي بِمرِّ الليلِ منّي خياليا",43,"ي",2,0],["أيا طفلي..أياكبدي","كفى بالبعد تُضنيني",44,"ن",2,0],["أيا طفلي ..أيا عمري","عيونك من ستحييني",44,"ن",2,0],["أيا طفلة الأحلام همّك قاتلي","جراحٌ لها تلوى قلوب الفوارسِ",45,"س",1,0],["ايا طيفها العابر على قلبي المجروح","بقالك مع اجروحي خفايا وجوه اشباح",46,"ح",1,0],["أيا طالبا نظم الفرائد في عقد","مواطن فيها شق صدر لذي رشد",47,"د",1,1],["أيا طارقَ الخير والحب قل لي","لأن دعائي له ناطقُ",48,"ق",1,0],["أيا طالب التعليم كن متعودا","على الجول دوما في مطالعة الكوم",49,"م",1,0],["أَيَا طَالِبَ الْبُعْدِ مَاذَا عَلَيْك","إِذَا قُلْتُ خُذْنِي رَفِيقًا لَدَيْك",50,"ك",1,1],["أَيا طارشي بَعد أَن تبلغ تحيتي","وَتبين وَجدي المربع وَشجان",51,"ن",1,0],["أيا طلَلَ الأرواح فاسلَمْ لشاعر","من الحَجَرِ المنسيِّ يستنطقُ الفنّا",52,"ن",2,0]]}