x?id=182114",""],[5956,"أين قصيدُهُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=182156",""],[5956,"أشتاق أن ألقاك في فردوسه","https://www.poetsgate.com/ViewPoem.aspx?id=192017",""],[5956,"قصة صديق","https://www.poetsgate.com/ViewPoem.aspx?id=192417",""],[5970,"ذرة ما بين أرض وسماء","https://www.poetsgate.com/ViewPoem.aspx?id=130581",""],[6023,"افعل جميلاً أنت تحصده","https://www.poetsgate.com/ViewPoem.aspx?id=123929",""],[6127,"جرحي العراق","https://www.poetsgate.com/ViewPoem.aspx?id=198168",""],[5075,"ماذا جنى الأحرار ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82761&r=&rc=7",""],[6222,"عام مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1932&r=&rc=3",""],[406,"صرخة في زمن الهمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63267&r=&rc=78",""]],"verses":[["أفعالُنا غُرَرٌ فوقَ الجِباهِ لَها","وللحُجولِ دمُ الأعداءِ مَورودُ",0,"د",1,0],["أفعالهم دون أن يُغرَى الرجاء بها","لكنّ أقوالهم أقوال أقيال",1,"ل",1,0],["أفعالهم لم تكن جدّاً ولا لعباً","لكن تراوغ بين الجد واللعب",2,"ب",1,0],["أفعاله ومقاله ونواله","للمجتلي والمجتني والمجتدي",3,"د",2,0],["أفعالُك الأنجاسُ غيرَ مُدافعٍ","عنها كما أقوالُك الأرفاثُ",4,"ث",1,0],["أَفعالُ مَن تَلِدُ الكِرامُ كَريمَةٌ","وَفَعالُ مَن تَلِدُ الأَعاجِمُ أَعجَمُ",5,"م",1,0],["أَفعالُهُ نَسَبٌ لَو لَم يَقُل مَعَها","جَدّي الخَصيبُ عَرَفنا العِرقَ بِالغُصُنِ",6,"ن",1,0],["أفعِنْدَنا شكٌّ بأنهما هما","في الفَتْكِ لا في صِحَّةِ الأنسابِ",7,"ب",1,0],["أَفٍّ عَلى الدُنيا وَأَسبابِها","فَإِنَّها لِلحُزنِ مَخلوقَة",8,"ه",1,1],["أَفَعِشتَ حَتّى عِبتَهُم قُل لي مَتى","فُرزِنتَ سُرعَةَ ما أَرى يا بَيدَقُ",9,"ق",1,0],["أفعالُهُ تكسرني ذا عجبُ","وكلُّ فعلٍ متعدٍّ ينصبُ",10,"ب",1,0],["اِفعَلي بِالأَسيرِ إِحدى ثَلاثٍ","فَاِفهَميهِنَّ ثُمَّ رُدّي جَوابي",11,"ب",2,0],["أفعَالَ مُعتَمَدٍ سَوَّى النَّجَاحُ لَهُ","فِي حَالَةِ الرَّأيِ بَينَ الرَّيثِ وَالعَجَلِ",12,"ل",1,0],["أُفعِمَ الأَردافُ مِنهُ","وَاِنطَوى الكَشحُ وَدَقّا",13,"ق",2,0],["أَفعم الرزء كلَّ قلب غَليلا","وَأَبى أَن يَكون إلا جَليلا",14,"ل",2,1],["افعَل بغيرك ما تُريد ليفعَلوا","بك مثله وَكما تُدينُ تُدان",15,"ن",1,0],["أُفْعُوَانٌ إِذَا الْتَوَى","في صُعُودٍ أَوْ في صَبَبْ",16,"ب",1,0],["أفعارٌ أن يقنصَ الذئبُ سخَلا","واقتناصُ البعير ليس بعار؟",17,"ر",1,0],["أفعى على الباغين تنفث سُمَّهَا","وعلى جراح النيل تقطر بلسما",18,"م",2,0],["افعالهم دون ان يُعرى الرجاء بها","لكنّ أقوالهمَ أقوال أقيال",19,"ل",1,0],["أَفعالُنا أَفعى لَنا ما بَينَنا","تَسعى لِمهلكنا وَنَحنُ نِيام",20,"م",1,0],["أَفَعيناً حَفَرتَ أَم هُوَ بَحرٌ","بانَ لَمّا كَشَفتَ عَنهُ الغِطاءَ",21,"ا",2,0],["أُفٍّ عَلى النَحوِ وَأَربابِهِ","قَد صارَ مِن أَربابِهِ نِفطَوَيه",22,"ي",2,0],["أَفعالُهُ لِلّهِ خالِصَةٌ فَما","تَلقى لِمُعتَقدِ الرِياءِ مَثيلا",23,"ل",2,0],["أَفعالُ آبائِهِم يَومَ الرُكَينِ وَمَن","يُشبِه أَبَاهُ فَلا وَاللَهِ ما ظَلَما",24,"م",2,0],["أَفعى أُصيبَت بِحمّى المَجدِ فَاِنقَلَبَت","مِن كَهفِها مِزَقاً سَكرى عَلى الغارِ",25,"ر",1,0],["أَفعمَ الكَون بِالعَذابِ حَياتي","فَلِهذا تاقَت إِلى أَكفانِه",26,"ن",2,0],["أَفعُوانٌ ما لِما يَن","فِثُهُ مِن فيهِ راقي",27,"ق",2,0],["افعل معي ما أنت أَهلُه","يا مَن لديه الفضلُ كلُّه",28,"ل",2,1],["أفٍ على منزل به نفر","فصيحنا خادم لأعجمه",29,"م",2,0],["أَفعاله سير في المجدأَيسرها","محيى المحامد بين السهل وَالجبل",30,"ل",1,0],["أَفعالهُ مَوجودةٌ معدومةٌ","بِمفازةِ التوحيد آلٌ يلمعُ",31,"ع",1,0],["أَفَعَن رِضاً كانَت قَطيعَتُكُم","فَبِأَيِّ شَيءٍ يَعرِضُ الغَضَبُ",32,"ب",1,0],["أفعى وفي لفظها سمٌّ لسامعها","يخاله في الهوى ضرباً من الضَّرَبِ",33,"ب",1,0],["افعل الخير تحمد في مقامك وفي السير","فاعل الخير ما يخشى لمكروه أو ضير",34,"ر",1,0],["أفعالُهُ غُرَرٌ أقوالُهُ سُوَرٌ","أقلامُهُ قُضُبٌ آراؤُهُ شُهُبُ",35,"ب",1,0],["أفعالُه البيضُ وأقوالُهُ","تفيضُ للواردِ والصادر",36,"ر",1,0],["افعم العمق بمهراق الدماء","كم له من وقعة كان يجيد",37,"د",1,0],["أفعاله تحكي حظوظَ الورى","فرائح هَذا وذا خاسرُ",38,"ر",1,0],["أفعالهُ في مارقٍ أو مأزقٍ","كندى يديهِ يبذُّ حصر الحاكي",39,"ك",2,0],["أفعالها ناطقةٌ بفخرها","تعنو ملوك الطير خوف مكرها",40,"ر",3,0],["أَفعى خَواطِرِهِمْ لانتْ ملامِسُها","لكنْ عليهم بسَمِّ القتلِ تنقَلِبُ",41,"ب",1,0],["أفعمت حُبا وإخلاصا لكم","فَرضُ عينٍ وله الكلُّ قضى",42,"ض",2,0],["أفعالُنا للرَّزايا فيه مُنكِرةٌ","ونطقُنا باِرتحالٍ عنه معترِفُ",43,"ف",1,0],["أفعل الفعل ثم أترُكُهُ","حاش لله أن أكون أنا",44,"ن",2,0],["أفعال رب الخلق روضة عطرِهِ","وأنامل الأيدي لأحرفِ سطره",45,"ه",1,1],["أفعالُهُ المتصرِّفاتُ صحيحةٌ","سَلِمتْ من الإعلال والتضعيفِ",46,"ف",1,0],["أُفْعُوَانَاً تُهَالُ مِنْهُ الأَعَادِي","حَيَّةً يَسْتَعِيْذُ مِنْهَا الرَّاقِي",47,"ق",2,0],["أفعالهم قد عطرت أسماءهم","أكرم بذي الأفعال والأسماء",48,"ا",2,0],["أفعاله الحسناء لا تحصى وكم","أسدت يداه إلى البرية من يد",49,"د",1,0],["أفعالك الغراء في جيد العلى","تزهو كما بالدر يزهو الجيد",50,"د",1,0],["افعالهم اعيا يراعي حمدُها","بل اعجزت عند الكلام لساني",51,"ن",2,0],["افعالك الغراء سرت امنا","مصرا كما سرت أبانا النبلا",52,"ل",2,0],["أفعال أحمد أدهشت بصري وقد","أرت الرشاد لمن أتى مسترشدا",53,"د",2,0],["أفٍ عَلَى الدُّنيا فَما خُلِبقَت لأَن","تَبقَى لخاطِبِها وَلا لِتَدُوما",54,"م",2,0],["أُفٍ عَلَى الدُّنيا فإنَّ نَعيمَها","بُؤسٌ وَإنَّ بِناءَها مُتَهَدِّمُ",55,"م",1,0],["افعوان اذا سرى بمداد","وَجواد اذا جرى فوق طرس",56,"س",1,0],["أفعاقلٌ يَرضى بها","وطناً لِسُكْنَى يَنْتِقيهْ",57,"ق",3,0],["أَفعالُكُمْ واعظةٌ","ولي بها تيقُّظُ",58,"ظ",1,1],["افعلِ الخيرَ تنلْ أكثرَه","إن فعلَ الخير مِنْ خير الخصال",59,"ل",1,0],["افعل علا اذا كبا","وابك اذا العل عفا",60,"ف",2,0],["أفعاله جميعها لحكمه","فأمره يبدي لها وحكمه",61,"ه",1,0],["أفعم القطر اعتزازاً وافتخارْ","واستضى لبنان فيه واستنار",62,"ر",1,0],["افّ على العلم قد كسدت تجارته","لما ظهر شعر ابن حنين شاهينا",63,"ن",2,0],["افعل جَميلاً تَلقَهُ وَتجزَ بِه","فَإِن فعل الناس غَير مُشتَبه",64,"ه",1,0],["أفعى تفح ووحش","دامي القوائم عاري",65,"ر",2,0],["اف عليك زماني","لذي الحجى كنت خصما",66,"م",2,0],["أفعموا الدهر بالفضائل شتى","وبحسن الجهور حازوا البقاءَ",67,"ا",2,0],["أفعى الأسى طرقت وغابَ الراقي","فأنا اللديغُ وأدمعي درياقي",68,"ق",2,1],["أفعال ألحاظه المرضى الصحاح بنا","أضعاف ما يفعل الصمصامة الذكر",69,"ر",1,1],["أفعالهم أحسابهم فهم بها","لا بالعظام الباليات عظام",70,"م",1,0],["أفعالهم أصبحت أفعى لهم وكما","دانوا يدانون والعمالُ أعمال",71,"ل",1,0],["أفعَالُكُمْ طَيِّبَةٌ","وعَرضِكُمْ مُسَدَّدُ",72,"د",1,0],["اف على الصبح ما دام الوصال فإن","كان التقاطع فلينعم بسراء",73,"ا",2,0],["أفعمتَ رائيكَ مشمولاً تغازلُهُ","محضَ المسَرَّةِ ملموساً ومحسوسا",74,"س",2,0],["أفعتموني نوالاً فانتوى أبداً","عنِّي به الهمُّ والتبريحُ والهَلَعُ",75,"ع",1,0],["أفعالُ أسماءِ أسْمَا غيرُ أسمالي","وهنَّ عن سائر الأفعال أسْمَى لي",76,"ل",2,1],["أفعاشق والعمر قد","رشف الهوى حتى الثماله",77,"ل",2,0],["أَفعالُ مُعتَصِمٍ بِاللَهِ مُنتَقِمٍ","مِمَّن عَصاهُ وَلِلزَّلّاتِ غَفّار",78,"ر",1,0],["أفعالهم تبنى على حركاتها","كسر العدى والحذف والإدغام",79,"م",1,0],["أفعاله للخق مرضيةٌ","وله بها من ربه الأجرُ",80,"ر",1,0],["افعلوا ما شئتُم إنّكُمُ","كلُّ فعل منكمُ عَذْبٌ لديّ",81,"ي",1,0],["أفعالُ الخير إذا انتشرت","في الناس فأنت لها مصدر",82,"ر",1,0],["أفعالك ما كانت فيها","إلا ذكرى لمن اذَّكَّر",82,"ر",1,0],["أفعالك الغرّ للدنيا وللدينِ","فافخر بحقّ على كلّ السلاطينِ",83,"ن",1,1],["أفعاله صدقت ما قد تكذبه","أسماعنا من حديث الجود في الأول",84,"ل",1,0],["إفعل جميل عل الجميل يحمد","وعاقبة فعل القبيح رديه",85,"ي",2,0],["اِفعَلوا في أَمرِ مَشغو","فٍ بِكُم فِعلاً جَميلا",86,"ل",2,0],["إفعَل بها مصلِّيَا على النبي","ما سَبَحت شمسٌ لنحوِ المغربِ",87,"ب",1,0],["افعالهم وقف على ما يرتضي","ومقَالهم ما شاء لا ما شاؤوا",88,"ا",1,0],["أفعشق الجمال خص البرايا","ولذا كابدوا العذاب الأليما",89,"م",2,0],["افعلي بي يا ربّة الخدر خيرا","ومن الماء شربة فاسقيني",90,"ن",2,0],["افعالهم كلها عن اذنه نشأت","بمحض قدرته أي باختيارهم",91,"م",1,0],["افعَل فَضل لو فِعْلَه مكيد","ادّ الكرم حَقَّه وخِذِ الثار",92,"ر",1,0],["أُفٍّ عَلَى الدنيا خيالٌ عيشُها","فهْي خَئونٌ مَا لَهَا قَطُّ وَفا",93,"ا",1,0],["افعل فإنّك حامدٌ","لسُراكَ في فَلَقِ الصّباح",94,"ح",1,0],["أفعال كل امرئ تنبي بعنصره","والعين تغنيك عن أن تطلب الأثرا",95,"ر",2,1],["أفعالُ موْلىً غَدا كِسْرى بمَن لهُمُ","قدِ انتَمى بين مَغْلولٍ ومغْلوبِ",96,"ب",1,0],["افعال اقلامِهِ في السَيفِ قَد جُمِعَت","وَإِنَّما الفَرقُ بَينَ الذِئبِ وَالغَنَمِ",97,"م",1,0],["أفعِلَةٌ أفعُلُ ثُمَّ فِعله","ثُمَّتَ أفعَالٌ جُمُوعُ قِلَّه",98,"ه",1,0],["أفعالكم في صدى الأيامِ ماثِلةٌ","قد سُطِّرتْ بِمدادِ النور في الكتُبِ",99,"ب",1,0],["أفعالهم بيضت أعراضهم أبداً","ومدحهم بالقوافي سود الصحفا",100,"ف",2,0],["أَفعالُهُ دَلَّت على أَنسابِهِ","والفعلُ للنَسَب العريق دليلُ",101,"ل",1,0],["أَفَعاجِزٌ عن أَن يُكثِّرَ جِسمَهُ","في كُلِّ أَين ما تَقدَّسَ او إِنا",102,"ا",1,0],["افعالهم سَلِمَت من عِلَّةٍ فنَحَوا","توجيهها للعُلَى قبلَ انصِرافهمِ",103,"م",1,0],["أفعل ما شئت بها ليلتي","وملءُ عيني نعمَةٌ ظاهرَه",104,"ر",2,0],["أفعالهم من عيوب النقص سالمة","فليس فيها إذا فتشت إعلال",105,"ل",1,0],["افعل كذاك وخلاك ذم","أَنك لا تُلحَى ولا تُذم",106,"م",1,0],["أفعاد ذئبا جازعا من بعد ما","كانت لديه خلائق الآساد",107,"د",1,0],["إفعل كما شئت لا خوف ولا حذر","إن الأذى منك محبوب وموموق",108,"ق",1,1],["أفعاله سعد على علاتها","سعدت نجوم الافق أو لم تسعد",109,"د",1,0],["أَفعالُهُ في كُلِّ اين عطَّرت","نَفحاتِ برٍّ كل يَومٍ تعبقُ",110,"ق",1,0],["أَفعالهم سلمت مِن علةٍ وَسمت","في كُلِّ صقعٍ وَذا من صادقِ الخبرِ",111,"ر",1,0],["أَفعالهم سلمت مِن كُلِّ شائبةٍ","وَقدرهم في صُدور الجَمع مُرتفعُ",112,"ع",1,0],["افعالهم سلمت مِن كُلِ شائِبَةٍ","وَشددوا العَزمَ مِن تَضعيف برهمِ",113,"م",1,0],["أَفعال مجد تسر الناس قاطبة","إِلّا الملوك فَقَد ماتوا لها غمما",114,"م",2,0],["أفعلةُ موتٍ بالمليكَة أم أبت","جلوس قصور ثم قربَ الأقاربِ",115,"ب",1,0],["أَفعلةُ الدهر هذي حين غفلتهِ","أم قلَّما يَلتَقي للناس أبصارُ",116,"ر",1,0],["أفعالك العور قد أردت بنيك فمن","مستعبدين ومن حيرى ومن حوب",117,"ب",1,0],["افعالهم صحَّت فليس يعيبها","ابداً بنقص واعتلال مفسدُ",118,"د",1,0],["افعل الخير ما استطعت تنل ما","تبتغيه من الثناء الجميل",119,"ل",1,1],["افعل الخير ما استطعت ففعل ال","خير ذكر لفاعليه وذخر",120,"ر",1,1],["أفعى ، جَسدها مِن حَبايل، وأجراس","تِندس في اقلوب الورى ، وبسلاسه",121,"س",2,0],["أفعاله عن معاليه مترجمةٌ","بها عرفناه تاج السادة اللطفا",122,"ف",2,0],["أفعالها شريرةُ","يبدو لديها مشكلة",123,"ل",2,0],["أفعالُهمْ كالفَجرِ ناصعةُ الجَدَا","إذْ ظَلَّ غيرُهُمُ يصوغُ 