{"poems":[[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[77,"هنيئا لمن حث الركائب في بدر","https://www.aldiwan.net/poem36494.html","الطويل"],[86,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[86,"من واجد منقر المنام","https://www.aldiwan.net/poem68846.html","الرجز"],[35,"ألا حييا ليلى أجد رحيلي","https://www.aldiwan.net/poem39100.html","الطويل"],[10,"لهفي على صخر فإني أرى له","https://www.aldiwan.net/poem21062.html","الطويل"],[93,"أخا الحزم نبئني أفارقت عن حزم","https://www.aldiwan.net/poem11418.html","الطويل"],[51,"يبيع الكماة الذائدون دماءهم","https://www.aldiwan.net/poem61834.html","الطويل"],[51,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[85,"كان لبعض الناس نعجتان","https://www.aldiwan.net/poem8026.html","الرجز"],[43,"أيقدح في الخيمة العذل","https://www.aldiwan.net/poem9940.html","المتقارب"],[58,"ألله حي قديم قادر صمد","https://www.aldiwan.net/poem31103.html","البسيط"],[44,"دموع أجابت داعي الحزن همع","https://www.aldiwan.net/poem30309.html","الطويل"],[31,"ولقد أشهد المحدث عند ال","https://www.aldiwan.net/poem41284.html","الخفيف"],[33,"ألا يا غراب البين هيجت لوعتي","https://www.aldiwan.net/poem25969.html","الطويل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[75,"أما والمذاكي يلكن الشكم","https://www.aldiwan.net/poem69039.html","المتقارب"],[48,"أحسن من ظبية لها رشأ","https://www.aldiwan.net/poem66599.html","المنسرح"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/15130","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30450","الطويل"],[100,"مآتم وأعراس","https://www.poetsgate.com/ViewPoem.aspx?id=50173",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[91,"الفاتحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67968&r=&rc=246",""],[115,"لاحظ المسكين بالمدد","https://www.aldiwan.net/poem42010.html","المديد"],[132,"ألا حييا دور الحبيب واحيينا","https://www.aldiwan.net/poem54648.html","الطويل"],[143,"لكم أن تجوروا معرِضين وتغضبوا","https://www.aldiwan.net/poem11720.html","الطويل"],[143,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[143,"تخلف عنه الصبر فيمن تخلفا","https://www.aldiwan.net/poem11783.html","الطويل"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[223,"كيف لا أندب أمسي","https://www.aldiwan.net/poem41625.html","مجزوء الرمل"],[229,"أراني إذا هذبت فيك قصيدة","https://www.aldiwan.net/poem51243.html","الطويل"],[271,"يا جيرة الحي في ذا الاثل والبان","https://www.aldiwan.net/poem52066.html","البسيط"],[282,"سقت بنت كرمة بنت الكرم","https://www.aldiwan.net/poem32455.html","المتقارب"],[328,"طار يطوى مجاهل الأفق والنار","https://www.aldiwan.net/poem55059.html","الخفيف"],[348,"وكم صاح في الأبطال هل من مبارز","https://www.aldiwan.net/poem20754.html","الطويل"],[364,"رمين القلوب بأشواقها","https://www.aldiwan.net/poem60835.html","المتقارب"],[366,"ما العجب في خلق ذاك الخلق بالعجب","https://www.aldiwan.net/poem17312.html","البسيط"],[366,"ألست ترى يومنا يوم طل","https://www.aldiwan.net/poem17732.html","المتقارب"],[410,"صحا بعد جهل فاستراحت عواذله","https://www.aldiwan.net/poem67474.html","الطويل"],[416,"سعيت لهذا الملك بالهمة الكبرى","https://www.aldiwan.net/poem53949.html","الطويل"],[416,"ألا إن هذا الفؤاد اضطرم","https://www.aldiwan.net/poem54173.html","المتقارب"],[421,"تملكتموا عقلي وطرفي ومسمعي","https://www.aldiwan.net/poem46401.html","الطويل"],[439,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[453,"خطرت آسيا بعيد أبيها","https://www.aldiwan.net/poem61621.html","الخفيف"],[482,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[500,"بين طي الحبيب والنشر معنى","https://www.aldiwan.net/poem37750.html","الخفيف"],[500,"تلألأ في الأكوان نور محيانا","https://www.aldiwan.net/poem37752.html","الطويل"],[551,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[551,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[551,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[558,"لذاتي بذاتي لا لكم أنا ظاهر","https://www.aldiwan.net/poem34556.html","الطويل"],[575,"يا حيرة الحق لما غيب الهادي","https://www.aldiwan.net/poem2786.html","البسيط"]],"verses":[["فَإِنْ طَعِمَتْ بِالنَّصْر كَانَ وُضوءُهَا","نَجِيعاً وَوَافَاهَا الْغُبَارُ بِأُشْنَانِ",0,"ن",1,0],["فإنْ طرَقَتْني منْ جَنابِكَ نسْمَةٌ","وضَعْتُ لَها يُمْنى يَدَيَّ على صَدْري",1,"ي",1,0],["فَاِنطَوَوا كَاِنطِواءِ أَهلِكِ بِالأَم","سِ وَزالَت بَشاشَةُ العُمرانِ",2,"ن",1,0],["فَأَنطَوي في هَذِهِ الآكامِ","وَتولِمُ الضَبعُ عَلى عِظامي",3,"م",2,0],["فَإِن طِبتِ نَفساً بَالعَطاءِ فَأَجزِلي","وَخَيرُ العَطايا لَيلَ كُلَّ جَزيلِ",4,"ل",1,0],["فَإِن طَلَبوا وِتراً بَدا بِتِراتِهِم","وَيَصبِرُ يَحميهِم إِذا الخَيلُ وَلَّتِ",5,"ت",1,0],["فَإنْ طَهْرَتْ نَفْسٌ فَمَا الفَخْرُ ظَاهِراً","بِفَخْرٍ وَلَيْسَ الجَاهُ خَيْراً مِنَ العُدْمِ",6,"م",1,0],["فإن طلبوها أو أفاضوا بذكرها","لقوا الهُون من حبْس طويل ومن جَلْدِ",7,"د",1,0],["فإنْ طاعَنوه كان أولَ طاعنٍ","وإنْ نازلوه كان أولَ نازلِ",8,"ل",1,0],["فَاِنطَلَقَت مِن فَورِها لِأُختِها","وَهيَ تَشُكُّ في صَلاحِ بَختِها",9,"ه",2,0],["فَإِن طُبِعَت قَبلَكَ المُرهَفاتُ","فَإِنَّكَ مِن قَبلِها المِقصَلُ",10,"ل",1,0],["فَإِنَّ طَلحَةَ غَادَرناهُ مُنجَدِلاً","وَلِلصَفائِحِ نارٌ بَينَنا تَقِدُ",11,"د",1,0],["فَأُنطِقَ فيها حامِدٌ وَهوَ مُفحَمٌ","وَأُفحِمَ فيها حاسِدٌ وَهوَ مِصقَعُ",12,"ع",1,0],["فَاِنطَلِق صاغِراً فَليسَ لَها الصَر","مُ لَدينا وَلا إِلَيها الهَوانُ",13,"ن",1,0],["فَإِن طِرتَ أَردَتكَ الحُتوفُ وَإِن تَقَع","تَقَيَّضَ ثُعبانٌ بِوَجهِكَ يَنفُخُ",14,"خ",1,0],["فَإِن طَرَدتَ الكَأسَ بِالسَنَّورِ","وَجِئتَ بِالكانونِ وَالسَمّورِ",15,"ر",1,0],["فإنْ طَفِقَتْ والِهٌ بيْنَنَا","تَحِنُّ حَنيناً فتلك الرّحِم",16,"م",1,0],["فانطلقت نحوهُ فعارضَها","فوارسٌ تنسفُ الفلا مرَحا",17,"ح",2,0],["فَإِنَّ طَريقَ الناسِ في الحَتفِ واحِدٌ","أَكُنتَ طَبيباً أَم نَقيضَ طَبيبِ",18,"ب",1,0],["فإِنْ طال ذِكْرِي بالمُجُونِ فإِنَّنِي","شَقِىٌّ بِمَنظومِ الكَلامِ سعيدُ",19,"د",1,0],["فانطلق حيث شئت يا فجر إنّا","قد فرشنا لك الدروب جماجم",20,"م",1,0],["فَإِنْ طَالَ المَطْلُ مِنْكِ تَطَلَّعَا","إِلَى امْرَأَةٍ تَسْمُوكِ بالجَاهِ وَالأَصْلِ",21,"ل",1,0],["فانطلق عنّي لئلّا تقتني همّا وحزنا","واتّخذ غيري رفيقا وسوى دنياي مغنى",22,"ن",2,0],["فانطوى في ذيل ساحته","شمخ هام الفيل والأسد",23,"د",1,0],["فإن طلول الحِبّ أوقدن في الحشا","زوافر منها لا يبني متشكيا",24,"ي",2,0],["فَإِن طابَتِ الأَوطانُ لي وَذَكَرتُها","فَإِنَّ مُقامي في جَنابِكَ أَطيَبُ",25,"ب",1,0],["فَإِن طاوَلوا أَو صاوَلوا بِقَديمِهِم","فَأَنتَ بِما تَأتي عَلى الطَولِ أَقدَرُ",26,"ر",1,0],["فَإِن طَلَبَ الأَمجادُ مَسعاهُ قَصَّروا","وَإِن حاوَلوا إِخفاءَ سُؤدُدِهِ خَفا",27,"ف",2,0],["فَإِن طلبَ الطبعُ الحلالَ ولم يجد","يُخافُ عليهِ أن يزين له الشرّا",28,"ر",2,0],["فَاِنطَفَت جذوةُ عُمري","وَاِستَحالَت لرماد",29,"د",1,0],["فإن طاب نَوْروزٌ وعِيدٌ فإنّما","بنورك أضحى ذا وذا وهو طيِّبُ",30,"ب",1,0],["فان طَغى الدهر أَو نابَت نوائبه","فالاهدليون حصن أَينما كانوا",31,"ن",3,0],["فَإِنَّ طَريقَ الهُدى واضِحٌ","وَكَم فيهِ لِلمُهتَدي مِن عَلَم",32,"م",1,0],["فانطلق من قيود دنياك إن كا","ن يسيرا عليك نزع اللباب",33,"ب",1,0],["فََأنطَقَ أَفْواهَ الجِراحِ وقد حَكتْ","بِها فَضَلاتٍ مِن مَواضِيهِ السَّنَا",34,"ن",2,0],["فإن طابَ منها ثِمارُ الفُروعِ","فمِن مُقتضَى طِيبِ أَعراقها",35,"ق",3,0],["فَإِن طَمِعتُ فَما أَروَيتَ مِن بَحَرٍ","وَإِن قَنَعتُ فَما أَنقَعتَ مِن ثَغَبِ",36,"ب",1,0],["فَإِن طُلَّ فيهِ دَمٌ لِلسَحابِ","فَقُل في دَمِ الكَرمِ لَم لا يُطَل",37,"ل",1,0],["فَإِنَّ طَليقَ اللَهِ مَن هُوَ مُطلِقٌ","وَإِنَّ قَتيلَ اللَهِ مَن هُوَ قاتِلُه",38,"ل",2,0],["فإنْ طاوَعَتْكَ اليوم جهراً وصالها","فقد كانَ هذا الأَمر في نفسها سرَّا",39,"ر",2,0],["فأنطقَ بالمدح حتَّى العُجُم","وأسمع بالصيت حتَّى الأصم",40,"م",1,0],["فإن طلبوني في حقوقِ هواهُم","فإني فقيرٌ لا عليَّ ولا معي",41,"ع",2,0],["فأَنْطَقَ غَرْبَيْ قلبِهِ ولسانِهِ","بتخليدِ مَا سَيَّرتَ من طَيِّبِ الذِّكْرِ",42,"ر",1,0],["فانطوت فوقَ لوعةٍ في نُهاهَا","بِدعاءٍ له وفوقَ الجراحِ",43,"ح",1,0],["فإن طافت الأشباح يوما بكعبة","بتلحظه في التربيعيات سريه",44,"ي",2,0],["فانْطَوَيْنا عنَّا وعن كلِّ شيءٍ","ونُشِرْنا والسِّرَّ بعدُ نَشَرْنَا",45,"ن",2,0],["فإنْ طُفْتَ أَكنافَ البِلادِ جميعِها","لمَا شِمْتَ فيها ما يُماثِلُ مَعْنَانَا",46,"ن",2,0],["فإنْ طُلِبَ النّدى كُنّا بحوراً","وإنْ حُذِر الرّدى كنّا حُصونا",47,"ن",2,0],["فإنْ طلب الأقوامُ عوناً على عُلاً","توحَّدَ لا يبغِي العَوِينَ المشاركا",48,"ك",2,0],["فَإِنْ طَعَنوا يومَ الكريهة أوسعوا","وإنْ أطعموا عند المجاعةِ أشبعوا",49,"ع",3,0],["فإن طريق الحق سهلٌ سلوكُه","وأوضح منه ليس يدرك ناظر",50,"ر",1,0],["فإِن طلبْتُ بديلاً منك أَو عوضاً","في العالمين لقد أَتعبت رُوَّادِي",51,"ي",1,0]]}