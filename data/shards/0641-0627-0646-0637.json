{"poems":[[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[77,"هنيئا لمن حث الركائب في بدر","https://www.aldiwan.net/poem36494.html","الطويل"],[86,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[86,"من واجد منقر المنام","https://www.aldiwan.net/poem68846.html","الرجز"],[35,"ألا حييا ليلى أجد رحيلي","https://www.aldiwan.net/poem39100.html","الطويل"],[10,"لهفي على صخر فإني أرى له","https://www.aldiwan.net/poem21062.html","الطويل"],[93,"أخا الحزم نبئني أفارقت عن حزم","https://www.aldiwan.net/poem11418.html","الطويل"],[51,"يبيع الكماة الذائدون دماءهم","https://www.aldiwan.net/poem61834.html","الطويل"],[51,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[85,"كان لبعض الناس نعجتان","https://www.aldiwan.net/poem8026.html","الرجز"],[43,"أيقدح في الخيمة العذل","https://www.aldiwan.net/poem9940.html","المتقارب"],[58,"ألله حي قديم قادر صمد","https://www.aldiwan.net/poem31103.html","البسيط"],[44,"دموع أجابت داعي الحزن همع","https://www.aldiwan.net/poem30309.html","الطويل"],[31,"ولقد أشهد المحدث عند ال","https://www.aldiwan.net/poem41284.html","الخفيف"],[33,"ألا يا غراب البين هيجت لوعتي","https://www.aldiwan.net/poem25969.html","الطويل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[75,"أما والمذاكي يلكن الشكم","https://www.aldiwan.net/poem69039.html","المتقارب"],[48,"أحسن من ظبية لها رشأ","https://www.aldiwan.net/poem66599.html","المنسرح"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/15130","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30450","الطويل"],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"]],"verses":[["فَإِنْ طَعِمَتْ بِالنَّصْر كَانَ وُضوءُهَا","نَجِيعاً وَوَافَاهَا الْغُبَارُ بِأُشْنَانِ",0,"ن",1,0],["فإنْ طرَقَتْني منْ جَنابِكَ نسْمَةٌ","وضَعْتُ لَها يُمْنى يَدَيَّ على صَدْري",1,"ي",1,0],["فَاِنطَوَوا كَاِنطِواءِ أَهلِكِ بِالأَم","سِ وَزالَت بَشاشَةُ العُمرانِ",2,"ن",1,0],["فَأَنطَوي في هَذِهِ الآكامِ","وَتولِمُ الضَبعُ عَلى عِظامي",3,"م",2,0],["فَإِن طِبتِ نَفساً بَالعَطاءِ فَأَجزِلي","وَخَيرُ العَطايا لَيلَ كُلَّ جَزيلِ",4,"ل",1,0],["فَإِن طَلَبوا وِتراً بَدا بِتِراتِهِم","وَيَصبِرُ يَحميهِم إِذا الخَيلُ وَلَّتِ",5,"ت",1,0],["فَإنْ طَهْرَتْ نَفْسٌ فَمَا الفَخْرُ ظَاهِراً","بِفَخْرٍ وَلَيْسَ الجَاهُ خَيْراً مِنَ العُدْمِ",6,"م",1,0],["فإن طلبوها أو أفاضوا بذكرها","لقوا الهُون من حبْس طويل ومن جَلْدِ",7,"د",1,0],["فإنْ طاعَنوه كان أولَ طاعنٍ","وإنْ نازلوه كان أولَ نازلِ",8,"ل",1,0],["فَاِنطَلَقَت مِن فَورِها لِأُختِها","وَهيَ تَشُكُّ في صَلاحِ بَختِها",9,"ه",2,0],["فَإِن طُبِعَت قَبلَكَ المُرهَفاتُ","فَإِنَّكَ مِن قَبلِها المِقصَلُ",10,"ل",1,0],["فَإِنَّ طَلحَةَ غَادَرناهُ مُنجَدِلاً","وَلِلصَفائِحِ نارٌ بَينَنا تَقِدُ",11,"د",1,0],["فَأُنطِقَ فيها حامِدٌ وَهوَ مُفحَمٌ","وَأُفحِمَ فيها حاسِدٌ وَهوَ مِصقَعُ",12,"ع",1,0],["فَاِنطَلِق صاغِراً فَليسَ لَها الصَر","مُ لَدينا وَلا إِلَيها الهَوانُ",13,"ن",1,0],["فَإِن طِرتَ أَردَتكَ الحُتوفُ وَإِن تَقَع","تَقَيَّضَ ثُعبانٌ بِوَجهِكَ يَنفُخُ",14,"خ",1,0],["فَإِن طَرَدتَ الكَأسَ بِالسَنَّورِ","وَجِئتَ بِالكانونِ وَالسَمّورِ",15,"ر",1,0],["فإنْ طَفِقَتْ والِهٌ بيْنَنَا","تَحِنُّ حَنيناً فتلك الرّحِم",16,"م",1,0],["فانطلقت نحوهُ فعارضَها","فوارسٌ تنسفُ الفلا مرَحا",17,"ح",2,0],["فَإِنَّ طَريقَ الناسِ في الحَتفِ واحِدٌ","أَكُنتَ طَبيباً أَم نَقيضَ طَبيبِ",18,"ب",1,0],["فإِنْ طال ذِكْرِي بالمُجُونِ فإِنَّنِي","شَقِىٌّ بِمَنظومِ الكَلامِ سعيدُ",19,"د",1,0],["فَإِنْ طَالَ المَطْلُ مِنْكِ تَطَلَّعَا","إِلَى امْرَأَةٍ تَسْمُوكِ بالجَاهِ وَالأَصْلِ",20,"ل",1,0]]}