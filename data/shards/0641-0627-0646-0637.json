],[4767,"بحور القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=179966",""],[4778,"ونفس المرء خدَّاعٌ رؤاها","https://www.poetsgate.com/ViewPoem.aspx?id=189596",""],[4804,"اذا ظلم الشيب رأس الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=92079",""],[4856,"رحيلٌ مؤقت","https://www.poetsgate.com/ViewPoem.aspx?id=36269",""],[5000,"يطير قصيدي","https://www.poetsgate.com/ViewPoem.aspx?id=7183",""],[5073,"بدأت بفضل أتاه الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=187165",""],[5085,"هواجس شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=188448",""],[5106,"عُدتَ يَا أَيلُولُ مَا أَغرَاكَ فِينَ","https://www.poetsgate.com/ViewPoem.aspx?id=147586",""],[5190,"الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=68760",""],[5219,"ظلام .. ونور","https://www.poetsgate.com/ViewPoem.aspx?id=195035",""],[5302,"خليلي زورا","https://www.poetsgate.com/ViewPoem.aspx?id=200132",""],[5302,"سأمضي","https://www.poetsgate.com/ViewPoem.aspx?id=200676",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5376,"مررْتُ الدارَ اسألُ عنْ صحابي","https://www.poetsgate.com/ViewPoem.aspx?id=188387",""],[5376,"سقى اللهُ نفساً لا تبورُ بذكرِه","https://www.poetsgate.com/ViewPoem.aspx?id=196443",""],[5387,"غردي","https://www.poetsgate.com/ViewPoem.aspx?id=53731",""],[5493,"تمادى الخلق","https://www.poetsgate.com/ViewPoem.aspx?id=197560",""],[5493,"فراق","https://www.poetsgate.com/ViewPoem.aspx?id=205056",""],[5533,"نُكْران","https://www.poetsgate.com/ViewPoem.aspx?id=214447",""],[5582,"فؤادٌ على جمر الغرام يقلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=63470",""],[5880,"الوحيدة","https://www.poetsgate.com/ViewPoem.aspx?id=208578",""],[5950,"مريم ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128336",""],[5997,"الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=214219",""]],"verses":[["فَإِنْ طَعِمَتْ بِالنَّصْر كَانَ وُضوءُهَا","نَجِيعاً وَوَافَاهَا الْغُبَارُ بِأُشْنَانِ",0,"ن",1,0],["فإنْ طرَقَتْني منْ جَنابِكَ نسْمَةٌ","وضَعْتُ لَها يُمْنى يَدَيَّ على صَدْري",1,"ر",2,0],["فَاِنطَوَوا كَاِنطِواءِ أَهلِكِ بِالأَم","سِ وَزالَت بَشاشَةُ العُمرانِ",2,"ن",1,0],["فَأَنطَوي في هَذِهِ الآكامِ","وَتولِمُ الضَبعُ عَلى عِظامي",3,"م",2,0],["فَإِن طِبتِ نَفساً بَالعَطاءِ فَأَجزِلي","وَخَيرُ العَطايا لَيلَ كُلَّ جَزيلِ",4,"ل",1,0],["فَإِن طَلَبوا وِتراً بَدا بِتِراتِهِم","وَيَصبِرُ يَحميهِم إِذا الخَيلُ وَلَّتِ",5,"ت",1,0],["فَإنْ طَهْرَتْ نَفْسٌ فَمَا الفَخْرُ ظَاهِراً","بِفَخْرٍ وَلَيْسَ الجَاهُ خَيْراً مِنَ العُدْمِ",6,"م",1,0],["فإن طلبوها أو أفاضوا بذكرها","لقوا الهُون من حبْس طويل ومن جَلْدِ",7,"د",1,0],["فإنْ طاعَنوه كان أولَ طاعنٍ","وإنْ نازلوه كان أولَ نازلِ",8,"ل",1,0],["فَاِنطَلَقَت مِن فَورِها لِأُختِها","وَهيَ تَشُكُّ في صَلاحِ بَختِها",9,"ه",2,0],["فَإِن طُبِعَت قَبلَكَ المُرهَفاتُ","فَإِنَّكَ مِن قَبلِها المِقصَلُ",10,"ل",1,0],["فَإِنَّ طَلحَةَ غَادَرناهُ مُنجَدِلاً","وَلِلصَفائِحِ نارٌ بَينَنا تَقِدُ",11,"د",1,0],["فَأُنطِقَ فيها حامِدٌ وَهوَ مُفحَمٌ","وَأُفحِمَ فيها حاسِدٌ وَهوَ مِصقَعُ",12,"ع",1,0],["فَاِنطَلِق صاغِراً فَليسَ لَها الصَر","مُ لَدينا وَلا إِلَيها الهَوانُ",13,"ن",1,0],["فَإِن طِرتَ أَردَتكَ الحُتوفُ وَإِن تَقَع","تَقَيَّضَ ثُعبانٌ بِوَجهِكَ يَنفُخُ",14,"خ",1,0],["فَإِن طَرَدتَ الكَأسَ بِالسَنَّورِ","وَجِئتَ بِالكانونِ وَالسَمّورِ",15,"ر",1,0],["فإنْ طَفِقَتْ والِهٌ بيْنَنَا","تَحِنُّ حَنيناً فتلك الرّحِم",16,"م",1,0],["فانطلقت نحوهُ فعارضَها","فوارسٌ تنسفُ الفلا مرَحا",17,"ح",2,0],["فَإِنَّ طَريقَ الناسِ في الحَتفِ واحِدٌ","أَكُنتَ طَبيباً أَم نَقيضَ طَبيبِ",18,"ب",1,0],["فإِنْ طال ذِكْرِي بالمُجُونِ فإِنَّنِي","شَقِىٌّ بِمَنظومِ الكَلامِ سعيدُ",19,"د",1,0],["فانطلق حيث شئت يا فجر إنّا","قد فرشنا لك الدروب جماجم",20,"م",1,0],["فَإِنْ طَالَ المَطْلُ مِنْكِ تَطَلَّعَا","إِلَى امْرَأَةٍ تَسْمُوكِ بالجَاهِ وَالأَصْلِ",21,"ل",1,0],["فانطلق عنّي لئلّا تقتني همّا وحزنا","واتّخذ غيري رفيقا وسوى دنياي مغنى",22,"ن",2,0],["فانطوى في ذيل ساحته","شمخ هام الفيل والأسد",23,"د",1,0],["فإن طلول الحِبّ أوقدن في الحشا","زوافر منها لا يبني متشكيا",24,"ي",2,0],["فَإِن طابَتِ الأَوطانُ لي وَذَكَرتُها","فَإِنَّ مُقامي في جَنابِكَ أَطيَبُ",25,"ب",1,0],["فَإِن طاوَلوا أَو صاوَلوا بِقَديمِهِم","فَأَنتَ بِما تَأتي عَلى الطَولِ أَقدَرُ",26,"ر",1,0],["فَإِن طَلَبَ الأَمجادُ مَسعاهُ قَصَّروا","وَإِن حاوَلوا إِخفاءَ سُؤدُدِهِ خَفا",27,"ف",2,0],["فَإِن طلبَ الطبعُ الحلالَ ولم يجد","يُخافُ عليهِ أن يزين له الشرّا",28,"ر",2,0],["فَاِنطَفَت جذوةُ عُمري","وَاِستَحالَت لرماد",29,"د",1,0],["فإن طاب نَوْروزٌ وعِيدٌ فإنّما","بنورك أضحى ذا وذا وهو طيِّبُ",30,"ب",1,0],["فان طَغى الدهر أَو نابَت نوائبه","فالاهدليون حصن أَينما كانوا",31,"ن",3,0],["فَإِنَّ طَريقَ الهُدى واضِحٌ","وَكَم فيهِ لِلمُهتَدي مِن عَلَم",32,"م",1,0],["فانطلق من قيود دنياك إن كا","ن يسيرا عليك نزع اللباب",33,"ب",1,0],["فََأنطَقَ أَفْواهَ الجِراحِ وقد حَكتْ","بِها فَضَلاتٍ مِن مَواضِيهِ السَّنَا",34,"ن",2,0],["فإن طابَ منها ثِمارُ الفُروعِ","فمِن مُقتضَى طِيبِ أَعراقها",35,"ق",3,0],["فَإِن طَمِعتُ فَما أَروَيتَ مِن بَحَرٍ","وَإِن قَنَعتُ فَما أَنقَعتَ مِن ثَغَبِ",36,"ب",1,0],["فَإِن طُلَّ فيهِ دَمٌ لِلسَحابِ","فَقُل في دَمِ الكَرمِ لَم لا يُطَل",37,"ل",1,0],["فَإِنَّ طَليقَ اللَهِ مَن هُوَ مُطلِقٌ","وَإِنَّ قَتيلَ اللَهِ مَن هُوَ قاتِلُه",38,"ل",2,0],["فإنْ طاوَعَتْكَ اليوم جهراً وصالها","فقد كانَ هذا الأَمر في نفسها سرَّا",39,"ر",2,0],["فأنطقَ بالمدح حتَّى العُجُم","وأسمع بالصيت حتَّى الأصم",40,"م",1,0],["فإن طلبوني في حقوقِ هواهُم","فإني فقيرٌ لا عليَّ ولا معي",41,"ع",2,0],["فأَنْطَقَ غَرْبَيْ قلبِهِ ولسانِهِ","بتخليدِ مَا سَيَّرتَ من طَيِّبِ الذِّكْرِ",42,"ر",1,0],["فانطوت فوقَ لوعةٍ في نُهاهَا","بِدعاءٍ له وفوقَ الجراحِ",43,"ح",1,0],["فإن طافت الأشباح يوما بكعبة","بتلحظه في التربيعيات سريه",44,"ي",2,0],["فانْطَوَيْنا عنَّا وعن كلِّ شيءٍ","ونُشِرْنا والسِّرَّ بعدُ نَشَرْنَا",45,"ن",2,0],["فإنْ طُفْتَ أَكنافَ البِلادِ جميعِها","لمَا شِمْتَ فيها ما يُماثِلُ مَعْنَانَا",46,"ن",2,0],["فإنْ طُلِبَ النّدى كُنّا بحوراً","وإنْ حُذِر الرّدى كنّا حُصونا",47,"ن",2,0],["فإنْ طلب الأقوامُ عوناً على عُلاً","توحَّدَ لا يبغِي العَوِينَ المشاركا",48,"ك",2,0],["فَإِنْ طَعَنوا يومَ الكريهة أوسعوا","وإنْ أطعموا عند المجاعةِ أشبعوا",49,"ع",3,0],["فإن طريق الحق سهلٌ سلوكُه","وأوضح منه ليس يدرك ناظر",50,"ر",1,0],["فإِن طلبْتُ بديلاً منك أَو عوضاً","في العالمين لقد أَتعبت رُوَّادِي",51,"د",2,0],["فإن طلاقها رأيٌ رشيدٌ","تحقق رشده تلك الجلاله",52,"ل",2,0],["فأنطوِي من حنيني عند ذكرِكُمُ","وفرطُ شوقي إِلى لُقْياكَ فوقَ يدي",53,"د",2,0],["فإن طاف في جوفه مسهد","وألقى على سجفه نظرتين",54,"ن",1,0],["فإن طلقت قبل الدخول ففرضها","ثلاثة أقراء تعد لها عدا",55,"د",2,0],["فإن طرقت يوماً تعرَّض دونها","من الرعب ما ينسى الحمام المسهر",56,"ر",1,0],["فَإن طابَ لي نشرُ الغرار فيمّما","خلاقَ عرار منه أزكى وأطيبُ",57,"ب",1,0],["فإن طلبت قصداً تساوين سرعة","قوادمها في جوها والقوائم",58,"م",1,0],["فَانْطِق بِإِرْبٍ فَوْقَ مَنْ تَأَرَّبا","وَالإِرْبُ يُدْهِي خِبَّ مَنْ تَخَبَّبا",59,"ب",2,0],["فانطلق الشيخ بِهِ قَليلا","ثَم رَأى الناشد وَالفَصيلا",60,"ل",2,0],["فانطوي طي سجلٍ يا سما","أبد الدهر وموري يا جبال",61,"ل",1,0],["فإن طلعة ميخائيل شمس ضحىً","والشمس من نورها الأقمار تستتر",62,"ر",1,0],["فإن طعنت في السن خودٌ فأبصرت","دماً سائلاً من فرجها قدر محجمِ",63,"م",1,0],["فإن طهرت طافت وتم طوافها","وصكت لدى البيت العتيق المكرمَ",63,"م",1,0],["فإن طلاقها منه ثلاثٌ","كذلك في الجميع من الفنون",64,"ن",1,0],["فانطرحت ذاهلةً لا تعي","واصفر جوري المحيا النضير",65,"ر",1,0],["فأنطقه للقوم ثم أعاده","إلى الحالة الأولى إلى مطلعِ الفجر",66,"ر",1,0],["فان طلب الصبر الجميل يخونه","وان يسع في وصلٍ فمسعاه يخفق",67,"ق",1,0],["فَإِن طَلَبوا مِنكَ عَودَ البِلادِ","فَقَد لَحِقَ الأَقرَبُ الأَبعَدا",68,"د",2,0],["فَإِن طَرَقَت فيكَ اللَّيالي بِفادِحٍ","فَلا عَجَبٌ أَن يُكسَفَ القَمَرانِ",69,"ن",1,0],["فأن طلبوا مني الزيادة زدتهم","أبا دلف والمستطيل بن أكثم",70,"م",1,0],["فإن طلع النور أمَّحوا وكأَنما","تلاشوا ولا روح تحركهم ثَمّا",71,"م",2,0],["فانطلق العقل وهو ما","بين الورى قد قيَّدته الجسوم",72,"م",1,0],["فان طرى الكف عليه فحرب","وفي مفاعلتن إلى العصب انتسب",73,"ب",1,0],["فانطقني الغرام وقلت شعراً","أنا أميتٌ ومن أبر عظامي",74,"م",2,0],["فَإن طالَ سَيرٌ غيرَ يَومٍ وَليلَةٍ","فَرُدَّ على القُطبِ الشمالي وخاير",75,"ر",1,0],["فَإن طَلَقتَ يا أخي وَاسِيني","فَإلزَم المَجرَى عَلى اليَقينِ",76,"ن",1,0],["فإن طلعت شاة فشاتان فرضها","إلى مائتي شاة من البيض والرمد",77,"د",1,0],["فإن طال في ينبع عمره","فمنه الهدايا ومني القصيد",78,"د",1,0],["فانطفوا وانطفتْ برغمي لأبقى","كلّ يوم ٍمفتشاً عن حسودِ",79,"د",1,0],["فإن طلاءه بالٍ سريع ال","تشهم فوقه ذو الجهل حاما",80,"م",2,0],["فإن طلبت عروساً لا تكلفني","غير المحبة من مهر ومن ثمن",81,"ن",1,0],["فإن طمحنا إلى العلياء نطلبها","فحقه الهدم ذاك المنزل الخرب",82,"ب",1,0],["فأنطق الحب منا السناً وصفت","ما في القلوب فقد حازت هو ادمعا",83,"ع",2,0],["فإن طرابلس للمسلمين","جميعا يحامونها اجمعينا",84,"ن",2,0],["فانطوى الكون وأضحى أبكما","لا يرى في الحق جدوى للكلام",85,"م",1,0],["فإن طلب المال أودى بها","ولو بره باعتذار رقيق",86,"ق",1,0],["فانطلقنا خلف أبعاد المنى","في المجال الصاخب المحتدم",87,"م",1,0],["فأنطقُ مبهوتاً وبيني وبينها","من البُعد مَا بيني وبين المطامع",88,"ع",1,0],["فأنطق أفواها بالفاظ حكمةٍ","وما حلها إثغارها واتغارها",89,"ر",3,0],["فان طويل البين يخلق عهدنا","فيصيبك ان تهوي اخامقةٍ بعدي",90,"د",2,0],["فَإِن طَغا أَو زَها عَلَيكَ بِما","صَحَّ لَهُ في اللِئامِ مِن عَرَبِه",91,"ب",2,0],["فإنَّ طريق الحربِ وعرٌ مضلةٌ","تؤولُ بباغيها إلى غير طائلِ",92,"ل",1,0],["فإن طلبت الفدا صونا لعرضهم","فإن صون العذارى بعض ما تهب",93,"ب",1,0],["فانطقها حب التَشفي واظهرت","لهم باسها والياس فيهم تجسما",94,"م",2,0],["فَأَنطِماخُ يُجزِلُ الهَدايا","إِن نَبقَ حَيَّينِ عَلى الخَلايا",95,"ي",2,0],["فَأَنطِفاتَ فَرى يُلقيهِ مُنقَلِبا","مِن ثُمَّ كَرَّ وَمِنيونَ الفَتى اِقتَضَبا",96,"ب",2,0],["فإن طر صبح فهي كالشمس تزدهي","وإن جن ليل فهي كالبدر تبدر",97,"ر",1,0],["فانطوى ناراً بأحشاء السحاب","فرزت فيها حواياها فذاب",98,"ب",1,0],["فإن طاوعتني كانت ضيائي","وإن عاصيت كانت من حدادي",99,"د",2,0],["فإنْ طالَ جَرَّرَ منْ خَلْفهِ","منَ الوَيْلِ لا طالَ فينا ذُيُولا",100,"ل",2,0],["فانطبعت منها له أشياء","حارت بدرك كنهها الآراء",101,"ا",2,0],["فإنْ طُرَّةٌ راقَتْك مِنه فرُبّما","أَمرَّ مَذَاقُ العُود