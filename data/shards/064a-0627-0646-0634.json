{"poems":[[87,"إثن عنان القلب واسلم به","https://www.aldiwan.net/poem63782.html","السريع"],[76,"يانشر عرف الروضة الغناء","https://www.aldiwan.net/poem12828.html","الكامل"],[201,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[201,"كفكف بربك دمعك الهتانا","https://www.aldiwan.net/poem39950.html","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125488","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204642","الخفيف"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145120","الرمل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86509","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44906","البسيط"],[4767,"نشوة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=198112",""],[4830,"وَحيُ الصَّبابات","https://www.poetsgate.com/ViewPoem.aspx?id=208638",""],[5005,"إلى ساعة مضت","https://www.poetsgate.com/ViewPoem.aspx?id=208148",""],[5111,"هَمْسٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212518",""],[5409,"قل للمجانين في الدنيا لكم طوبى","https://www.poetsgate.com/ViewPoem.aspx?id=155254",""],[5425,"شَفَتِي الغَلِيْلُ وَثَغْرُكِ المُتَبَرَّضُ","https://www.poetsgate.com/ViewPoem.aspx?id=207511",""],[5480,"عزوتي","https://www.poetsgate.com/ViewPoem.aspx?id=16305",""],[5533,"قَدْ أَتَيْتُ أَعْتَذرُ","https://www.poetsgate.com/ViewPoem.aspx?id=176647",""],[5843,"خيل الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=51277",""]],"verses":[["يا نَشأَ الحَيِّ شَبابَ الحِمى","سُلالَةَ المَشرِقِ مِن نُجبِهِ",0,"ب",2,0],["يانَشرَ عَرفِ الرَوضَةِ الغَنّاءِ","وَنَسيمَ ظِلِّ السَرحَةِ العَيناءِ",1,"ا",2,1],["يانشءُ هل من نهضةٍ نُحيي بها","المجدَ الأثيلَ كنَهضةِ الجابانِ",2,"ن",1,0],["يا نشءُ هل من وثبةٍ نشفي بها","هذا الغليلَ كوثبةِ الطليان",2,"ن",1,0],["يا نشءُ هل من صرخةٍ تدع العِدا","صرعى الذهولِ كصرخَةِ الألمان",2,"ن",1,0],["يا نشءُ عَرقَلَتِ العمائمُ سيرنا","والدينُ أضحى سُلّماً للجاني",2,"ن",2,0],["يا نشءُ وا أسفا على دينٍ غدا","أحبولةً للأصفر الرنانِ",2,"ن",1,0],["يا نشءُ أمّة يعرُبٍ عقدت عليك","رجاءَها قم قدّم القربانا",3,"ن",2,0],["يا نشءُ يا أملَ البلاد وسؤلَها","أقسِم على أن لا تطيقَ هوانا",3,"ن",2,0],["يا نشءُ للمجدِ هَيّا","قد لاحَ نجمُ السُّعُود",4,"د",1,1],["يا نشاوى يعربدون جدالا","إذ سقاهم ساقي الضلال رحيقه",5,"ق",2,0],["يا نشيد القلب في أفراحه","يا حياة الحب يا طيب جناها",6,"ا",3,0],["يا نشوة الألباب لما أبرزوا","حريةً عذراء من أخدار",7,"ر",1,0],["يا نشءَ الشَرقِ خُذ لِلمَجدِ أُهبَتَهُ","وَأَهزُز قَناتَكَ وَاِقدَح زَندَكَ الواري",8,"ر",2,0],["يا نشوةَ العلمِ التي وُلِدتْ","دومِي بلا حدٍّ ولا أمدِ",9,"د",1,0],["يانشوةَ الأُنسِ ياطيفاً يُداعبُهُ","رمْشُ الجفونِ فيغفو في عُيَيْناتي",10,"ت",2,0],["يا نشوةَ الأحلامِ في مُقَلِ النَّدى","إنْ سالَ دمعُ الوردِ بالأشواكِ",11,"ك",1,0],["يَا نَشِيْدًا لِصَفَاهَا","هَمْسَ مَوْجٍ شَدْوَ طَائِرْ",12,"ر",1,1],["يا نشوةً كانت الأحلام مبعثها","لم نحس راحاً ولم نلمس لها كوبا",13,"ب",2,0],["يَا نَشْوَةَ الرَمضَاءِ في عَطِشَ المَدى","شَفَتِي الغَلِيْلُ وَثَغْرُكِ المُتَبَرَّضُ (7)",14,"ض",1,0],["يا نشوةً تعلى على روس المراقيب","أسدلي في موكبي غيم وسحابه",15,"ب",2,1],["يا نَشِيْدَ أُمْسَيتِي","حِيْنَ يُفْقَدُ الوَتَرُ",16,"ر",1,0],["يانشادة فؤادي ويش اخايل والمسا مخطور","مداي الذكريات اللي حنايا صدري ابهجته",17,"ت",2,1]]}