{"poems":[[89,"ما الدهر إلا ضوء شمس","https://www.aldiwan.net/poem8362.html","السريع"],[48,"أنا صائم طول الحياة وإنما","https://www.aldiwan.net/poem22412.html","الكامل"],[48,"إجعل تقاك الهاء تعرف همسها","https://www.aldiwan.net/poem22561.html","الكامل"],[48,"تجنب الوعد يوما أن تفوه به","https://www.aldiwan.net/poem22757.html","البسيط"],[48,"دع الراح في راح الغواة مدارة","https://www.aldiwan.net/poem23160.html","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/8871","الطويل"],[48,"أنا صائمٌ طولَ الحياةِ، وإنّما","https://www.poetsgate.com/ViewPoem.aspx?id=18375",""],[139,"شقوا القلوب وغادروا الأطواقا","https://www.aldiwan.net/poem49169.html","الكامل"],[164,"قليل لها هجر الجنوب المضاجعا","https://www.aldiwan.net/poem58996.html","الطويل"],[190,"لقد هاج لي الوجد","https://www.aldiwan.net/poem43978.html","الهزج"],[353,"صدقوا قد نظروا الورد مسيج","https://www.aldiwan.net/poem19932.html","الرمل"],[358,"تصاحى نديم الحان من نشوة السكر","https://www.aldiwan.net/poem40344.html","البسيط"],[445,"زمان جديد وصنع جديد","https://www.aldiwan.net/poem34911.html","المتقارب"],[487,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[511,"طهر بماء التقى جنابك","https://www.aldiwan.net/poem2461.html","مخلع البسيط"],[556,"إنا نعلل كلنا بمحال","https://www.aldiwan.net/poem47297.html","الكامل"],[564,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[580,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83281","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122616","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86601","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87140","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38276","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119928","الكامل"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105226","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108564","الوافر"],[2246,"","https://poetry.dctabudhabi.ae/diwan/poem/116755","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88653","الكامل"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68349","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94287","المتقارب"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205804","الكامل"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9609","الكامل"],[3252,"","https://poetry.dctabudhabi.ae/diwan/poem/105713","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129339","الطويل"],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77727","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117845","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133093","الطويل"],[5081,"لَا تَسْتَهِنْ","https://www.poetsgate.com/ViewPoem.aspx?id=185840",""],[5397,"هلا سألت مرابعا وطلولا","https://www.poetsgate.com/ViewPoem.aspx?id=157941",""],[5419,"تباريح الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=32266",""],[243,"مأساة الميناء","https://www.poetsgate.com/ViewPoem.aspx?id=50470",""],[6157,"وأصم ممطول الكعوب اذا اقتضى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=558680",""],[5377,"لحظات الإشراق الفني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79566&r=&rc=22",""]],"verses":[["وَاصْمُتْ عَنِ الشَّرِّ إِذَا لَمْ تُطِقْ","دَفْعاً وَإِنْ صَادَفْتَ خَيْراً فَقُلْ",0,"ل",1,0],["وَاِصمُت فَما كُثِرَ الكَلامُ مِن اِمرِئٍ","إِلّا وَظُنَّ بِأَنَّهُ مُتَزَيِّدُ",1,"د",1,0],["وَاِصمُت فَإِنَّ الصَمتَ يَكفي أَهلَهُ","وَالنُطقُ يُظهِرُ كامِناً وَيُقَرِّرُ",2,"ر",1,0],["وَاِصمُت فَإِنَّ كَلامَ المَرءِ يُهلِكُهُ","وَإِن نَطَقتَ فَإِفصاحٌ وَإِيجازُ",3,"ز",1,0],["وَأَصمُتُ صَمتاً لا تَكَلُّمَ بَعدَهُ","وَلا قَولَ داعٍ يا فُلانُ وَيا فُلا",4,"ل",2,0],["وَأُصمِتَ عَنّي حاسِدي بِخَلائِقٍ","مُهَذَّبَةٍ لَيسَت لَهُنَّ عُيوبُ",5,"ب",1,0],["واصمُتْ، فما كثُرَ الكلام من امرىء","إلاّ وظُنّ بأنّه مُتَزَيِّد",6,"د",1,0],["وأصمّت الأسماعُ رنة وقعه","والحزن أولى الألسنَ استغلاقا",7,"ق",2,0],["واصمت بلحظ ما برحن قسيه","باسهمها فينا روام نوازعا",8,"ع",2,0],["وأصمينا وبخّرنا","بلا عود ولا ند",9,"د",1,0],["وَأَصَمٍّ فُتِحَتْ أَسْماعُهُ","بِقَوافٍ كَمْ بِها يُفْتَحُ مُرْتَجْ",10,"ج",1,0],["وَأصمى البُكا إِنسان عَيني وَهَل أَتى","سِواه عَلى الإِنسان حينٌ مِن الدَهرِ",11,"ر",1,0],["وأَصمدَ من جَرَّبَتْهُ السيوفُ","وأَجملَ من ظَلَّلَتْهُ البُنُودُ",12,"د",1,0],["وأصمته ما كان يعلم أنه","غدا مغرب الأسرار في سر ميزان",13,"ن",1,0],["وَاصمُت إِذا ما سَمِعتَ لغواً","وَلاَ تُحَرِّك بهِ لسَانَك",14,"ك",1,0],["وأصمّ ناعيه الغداة مسامعي","ورمى سوادَ جوانحي بخَبالِ",15,"ل",1,0],["وأصْمت للجنَيِّ تجريدُ خلقِه","مع الأمر إِذْ صارت فصاحتُه لُكنْا",16,"ن",2,0],["وأَصمَت القلبَ كِنَانيةٌ","بناظرٍ إِن شئتَ أَو سَهْمِ",17,"م",1,0],["وَأَصمَتَ رِجالاً لِلزَمانِ وَأَنَّهُم","لَنِعمَ رِجالِ الدَهرِ شَمُّ المَعاطِسِ",18,"س",1,0],["وأصَمُّوا الآذانَ عن نهي هارو","نَ وضَلَّت عن دينِ عيسى النَّصارى",19,"ر",2,0],["وَأَصمت سِهامُ الدَهر مِنها فؤادَها","فَعاشَت بِلا قَلب وَذاكَ عُجاب",20,"ب",1,0],["وَأَصمى مُهجة المَفتون ظلماً","بِعادل قامةٍ كَالخيزران",21,"ن",1,0],["وَأَصمى سَهمُه قرْماً جَسوراً","وَجَندَلَ رمحُه في الأَرضِ أُسْدا",22,"د",2,0],["وأصم معتدل الكعوب وأبيضا","كالبرق نضنض في الغمامة وابتسم",23,"م",1,0],["وأصمّت مسمع الدهر فما","مثلها من نكبة في الناس تروى",24,"و",2,0],["وأصماني بسودٍ فاتراتٍ","مراض تفضل البيض الصحاحا",25,"ح",2,0],["وأصمّ الكعوب أسمرَ لدنٍ","يتثنّى كالحيّةِ المنساب",26,"ب",1,1],["واصم اعجم جد في عذلى","اولى بسمعك ويحك العذل",27,"ل",1,0],["واصمت ولا تنطق فما ال","هادي إليه المهتدي",28,"د",2,0],["وأصمت مناهم سهام المنايا","ولم تغن عنهم سبوغ الدلاس",29,"س",1,0],["وأصمّ عن نغم عشقت سماعه","أيام كان القلب غير سميع",30,"ع",1,0],["وَأَصَمَّ صَدقاً مِن رِماحِ رُدَينَةٍ","بِيَدَي غُلامِ كَريهَةٍ مِخراقِ",31,"ق",1,0],["واصمى قريشاً بالأسى ولو لوا","لوي ومن عدنان حطم أضلعا",32,"ع",2,0],["وأصمى بكعب الرمح كعبا فاصبحت","منازلهم بعد الأنيس سباسبا",33,"ب",2,0],["وأصمَّ ممطولِ الكعوبِ إذا اقتضى","مُهَجَ الكُماةِ فديْتُه لا يُمطَلُ",34,"ل",1,1],["واصمي غوي العاذلات بثاقب","من الشهب حتى تنزوي في كمامها",35,"م",3,0],["وَأَصمى ابنُ نَسطُورَ أَنطِيلُخُس","بِنافِذِ عاسِلِهِ ابلِرُس",36,"س",1,0],["وأصمى بثكليس خلكون من","بهيلاذةٍ ناعماً سكنا",37,"ن",2,0],["واصمت ففي صمت اللبيب نجاته","سوى في خطاب من بخيرٍ يخاطبُ",38,"ب",1,0],["وَاصْمُتْ إِذَا كَانَ السُّكُوتُ لِصَالِحٍ","بَعْضُ السُّكُوتِ هُوَ الْكَلَامُ الْمُتَّسِعْ !",39,"ع",1,0],["واصم واعية المنية مرهجا","لم تدر إلا للحمام صليلا",40,"ل",2,0],["وأصمت كي أظل على هدوئي","فيفجعني من الحسّ امتناعُ",41,"ع",1,0],["وأصمي في جوانح كل طاغ","فؤادا كان للشر استجابا",42,"ب",2,0],["وَأَصمّ مَمطول الكُعوب إِذا اِقتَضى","مُهَج الكماة فَدينه لا يمطلُ",43,"ل",1,1],["واصمت مستمعاً تارة","وأصرخ حيناً عبوساً غضوبا",44,"ب",2,0]]}