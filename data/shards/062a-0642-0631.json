الرمل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35415","الطويل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119561","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72568","السريع"],[4551,"","https://poetry.dctabudhabi.ae/diwan/poem/139849",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136383",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120521","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120526","الطويل"],[4767,"المقام العالي","https://www.poetsgate.com/ViewPoem.aspx?id=179947",""],[4981,"غزليّتي","https://www.poetsgate.com/ViewPoem.aspx?id=190495",""],[5046,"غرامك نارٌ","https://www.poetsgate.com/ViewPoem.aspx?id=197894",""],[5072,"لا تدعها","https://www.poetsgate.com/ViewPoem.aspx?id=52557",""],[3591,"تقرب كل للكريم أخي الجدا","https://www.poetsgate.com/ViewPoem.aspx?id=149402",""],[5135,"أيا لَيْلُ مهْلاً","https://www.poetsgate.com/ViewPoem.aspx?id=203367",""],[5186,"إاذا كانت الآمال بالوصل أوهاما","https://www.poetsgate.com/ViewPoem.aspx?id=156475",""],[5199,"الموادع","https://www.poetsgate.com/ViewPoem.aspx?id=146781",""],[5277,"أطلالُ الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=185555",""],[5277,"عيونُ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=191335",""],[5376,"وما خَلَقَ الالهُ النفسَ لهواً","https://www.poetsgate.com/ViewPoem.aspx?id=204778",""],[5409,"أضحكتنا ورب ضحكٍ بكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155244",""],[5431,"جعلتَ القلبَ بكّاءً وليّا ولم يكُ قبْلَ أنْ يهواكَ شيّا","https://www.poetsgate.com/ViewPoem.aspx?id=189483",""],[5464,"سميرَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=125410",""],[5582,"أَفْراحُ أَهْلِ الهَوَى فِي الهَجْرِ أَحْزانُ","https://www.poetsgate.com/ViewPoem.aspx?id=187308",""],[5582,"سَبانِي بِتَكْسِيرِ أَجْفانِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63597",""],[5648,"طمن خفوقك","https://www.poetsgate.com/ViewPoem.aspx?id=156246",""],[5660,"كِثارٌ ذُنوبي أَيا نَفسُ توبي","https://www.poetsgate.com/ViewPoem.aspx?id=37324",""],[5691,"قرارات حمقاء","https://www.poetsgate.com/ViewPoem.aspx?id=206313",""],[5691,"عاصمة السماء","https://www.poetsgate.com/ViewPoem.aspx?id=206341",""],[5725,"يا كاتم السر الهوى ذائع","https://www.poetsgate.com/ViewPoem.aspx?id=201607",""],[5776,"الغلام والملكة","https://www.poetsgate.com/ViewPoem.aspx?id=199336",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5843,"طيحة عزيز .! ولا وقوف إمتمايل.!","https://www.poetsgate.com/ViewPoem.aspx?id=51298",""],[5848,"أول إرهابيه سعوديه","https://www.poetsgate.com/ViewPoem.aspx?id=53213",""],[5952,"تضوع عطراً","https://www.poetsgate.com/ViewPoem.aspx?id=202703",""],[5953,"أيها الزائرون مشهد نور","https://www.poetsgate.com/ViewPoem.aspx?id=93793",""],[5956,"آتاكَ ربك صحة وإيادا","https://www.poetsgate.com/ViewPoem.aspx?id=207823",""],[6074,"بنفسى من ولى وخلف لي الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=200377",""],[313,"صبر ينفذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66511&r=&rc=33",""],[6195,"مهلهلُ قد حلبتُ شطورَ دهري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78997&r=&rc=0",""],[6251,"إلى الشيخ جابر الأحمد الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76467&r=&rc=7",""],[2220,"إذا أنت لم تعرف إلهك فاعتكف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11821&r=&rc=690",""],[6346,"بَريقٌ وشعاع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84885&r=&rc=10",""]],"verses":[["تَقرِضُ مِن جُنوبِكُم","طَمَّ اللِمامِ بِالجَلَم",0,"م",1,0],["تَقْرو مَراتِعَ وُشِّحَتْ بِمَناهِلٍ","تَخْتالُ بَينَ نَميرِها وَمَعينِها",1,"ن",3,0],["تُقَرَّطُ أثْناءَ الأعِنّةِ والثّرى","يُواري جَبينَ الشّمْسِ والنّقْعُ ذائِلُ",2,"ل",1,0],["تَقَرَّبتُ بِالإِحسانِ مِنها فَزادَني","بُعاداً فَما أَدري بِما أَتَقَرَّبُ",3,"ب",1,0],["تَقَرُّ بِقُربِهِ عَيني وَإِنّي","لَأَخشى أَن يَكونَ يُريدُ فَجعي",4,"ع",2,0],["تُقَرِّبُهُ الأَوْهَامُ مِنِّي وَإِنْ نَأتْ","مَنَازِلُهُ عَنِّي وَعَزَّ مَنَالُهُ",5,"ل",2,0],["تُقِرُّ لَهُ الأَمْلاَكُ بِالشِّيَمِ الْعُلَى","إِذَا بُدِلَ الْمَعْرُوفُ أَوْ نُصِبَ الْقِسْطُ",6,"ط",1,0],["تقَرُّ بمَرْآيَ العُيونُ إذا بدَتْ","عَجائِبُ أشْكالي ويَنْشَرِحُ الصّدْرُ",7,"ر",1,0],["تُقِرُّ مُلوكُ الصّينِ بالفَخْرِ كلّما","فخَرْتُ بفَضْلٍ حُزْتُهُ لتِلادِ",8,"د",1,0],["تَقُرُّ بِهِ عَينُ الَّذي كانَ شامِتاً","وَتَبتَلُّ مِنها سُرَّةٌ وَمَآكِمُ",9,"م",1,0],["تَقرو بِهِ مَنزِلَ الحَسناءِ إِذ رَحَلَت","فَاِستَقبَلَت رُجَبَ الجَوفَين فَالعُمَقا",10,"ق",2,0],["تَقَرَّبَ حَتّى قُلتُ لَم يَدنُ هَكَذا","مِنَ الإِنسِ إِلّا جاهِلٌ أَو مُضَلَّلُ",11,"ل",1,0],["تَقرَأُ في عَينَيهِ كُلَّ الَّذي","في نَفسِهِ عَن نَفسِهِ يَستُرُ",12,"ر",1,0],["تَقري العَلابِيَّ مُصفَرَّ العَصيمِ إِذا","غَبَّت أَخاديدُهُ جَوناً إِذا اِنعَصَرا",13,"ر",2,0],["تَقَرَّبنا فَلا طَمَعٌ قَريبٌ","وَباعَدنا فَزِدتِ عَلى البِعادِ",14,"د",1,0],["تُقَرِّبُنا مِنَ اليَمَنِ المَهاري","لِعيدِيٍّ مِنَ النُجُبِ التِلادِ",14,"د",1,0],["تُقَرقِرُ يا فَرَزدَقُ إِذ فَزِعتُم","خَزيراً باتَ في أُدَرٍ ثِقالِ",15,"ل",1,0],["تُقِرُّ لَهُ بيضُ الظِباءِ وَأُدمُها","وَيَحكيهِ في بَعضِ الأُمورِ غَريرُها",16,"ر",3,0],["تقر لك السادات طوعاً وعنوةً","ويحسن سرّ الفضل فيك وجهره",17,"ر",2,0],["تقر له السادات طوعاً وعنوةً","ويحسن سرّ الفضل فيه وجهره",17,"ر",2,0],["تقرأ الدَّستَ ظاهراً فتُؤدي","ه جميعاً كأحْفظ القُرّاءِ",18,"ا",2,0],["تَقْرُو القبورَ مَرْمَساً فمرمَسا","حتى يُوافينَ العَجوزَ المُومسا",19,"س",2,0],["تُقرضنا العرفَ بالثناءِ وتع","تدُّ زكيَّ القروضِ من عَيَنك",20,"ك",1,0],["تُقرّبها للنائكين مطيةً","جهاراً وربُّ العالمين يراكا",21,"ك",2,0],["تقريهُمُ طعناً أبجَّ وتارةً","ضرباً يُزيّلُ بينهم تزييلا",22,"ل",2,0],["تُقري الفَقيرَ عَلى خَصاصَةِ حالِهِ","كَرَماً كَما تُقري الغَنِيَّ الموسَرا",23,"ر",2,0],["تقريظ أعيان الكتب","باب يعدّ من الأدب",24,"ب",1,1],["تُقَرِّبُ عَهدَهُ لِلناسِ حَتّى","تَرَكتَ الجَليلَ في التاريخِ عاما",25,"م",2,0],["تُقَرِّبُ رَبّاتُ البُعولِ بُعولَها","فَإِن لَم يَكُن بَعلٌ فَنَفساً تُقَرِّبُ",26,"ب",1,0],["تَقري صَوارِمُهُ الساعاتِ عَبطَ دَمٍ","كَأَنَّما الساعُ نُزّالٌ وَقُفّالُ",27,"ل",1,0],["تُقِرُّ وتمحو المُلْكَ حيث تُريدُهُ","وأنتَ مُديلٌ مرةً ومُذيلُ",28,"ل",1,0],["تَقريرُ لُطفِكَ وَاختِيارُكَ أَغنَيا","عَن كُلِّ مُختارٍ لَها وَمُقَدَّرِ",29,"ر",1,0],["تَقَرّى جُنوبَ الأَرضِ جوداً وَنائِلاً","وَطَبَّقَ عَدلاً حُزنَها وَسُهولَها",30,"ل",3,0],["تَقَرَّبْتُ من هذي القَوارِبِ راكباً","ويا ليتَني منها الغداةَ بَعيدُ",31,"د",1,1],["تقرأ الأعلاجُ منها للرّدَى","فوْقَ طِرْسِ الماءِ أسطارَ كتاب",32,"ب",1,0],["تُقَرِّبُ الشُقَّةَ القُصوى إِذا أَخَذت","سِلاحَها وَهُوَ الإِرقالُ وَالرَمَلُ",33,"ل",1,0],["تَقرو بِأَسفَلِهِ رُبولاً غَضَّةً","وَتَقيلُ أَعلاهُ كِناساً أَجوَفا",34,"ف",2,0],["تُقَرِّبُني وَلَيسَ تَشُكُّ أَنّي","عَدا فيهِنَّ بي الداءُ الدَفينُ",35,"ن",1,0],["تَقَرُّ العَوادِي حين يَهتاجُ سِربُها","وتَرْضَى السّماواتُ العُلىَ حين تَغضبُ",36,"ب",1,0],["تقرُّ فتفزعُ الدّنيا وتأبى","ممالِكُها الهَوادةَ والسُّكونا",37,"ن",2,0],["تُقَرِّبُ مِن أَسبابِها وَهيَ نُزَّعٌ","وَتَجمَعُ مِن أَسرابِها وَهيَ شُرَّدُ",38,"د",1,0],["تَقَرَّبَ ناسٌ بِالمُدامِ وَعِندَنا","عَلى كُلِّ حالٍ أَنَّ شارِبَها يُحَدّ",39,"د",1,0],["تَقَرّبَ جبريلٌ بُروحِكَ صاعِداً","إلى العرشِ يُهديها لجَدّك والأُمِّ",40,"م",1,0],["تُقَرِّبُ عَهدَهُ لِلناسِ حَتّى","تَرَكتَ الجَيل في التاريخِ عاما",41,"م",2,0],["تَقْرَأَ مُهْتَزّاً تحِيةَ عَصْرِنا","وَتَسْمَعَ مُعْتَزّاً صَدَاكَ المُرَددَا",42,"د",2,0],["تُقِرُّ دُموعي بِشَوقي إِلَيكَ","وَيَشهَدُ قَلبي بِطولِ الكَرَب",43,"ب",1,1],["تَقرّ بهِ عَيني إِذا سَخِنَت بِهِم","وَتُقذى إِذا ما أقذيَت وَهُمُ القَذى",44,"ذ",2,0],["تقرأُ الإقدامَ في صفحتهِ","مثلَما تقرأُ خطَّ الكاتبين",45,"ن",1,0],["تقرَعُ الأقدارُ منه عَزْمَةً","أنِفَتْ صخرتُها أنْ تستكين",45,"ن",1,0],["تقر بمرآيا العيون إذا بدت","عجائب أشكالي وينشرح الصدر",46,"ر",1,0],["تقرا هواها على أنوار غرته","وقد تسر إليه بعض نجواها",47,"ا",3,0],["تُقَرَّظُ غير أنك لا تُوَفَّى","وتوصف غير أنك لا تُحَدُّ",48,"د",1,0],["تقرأ الدست ظاهراً فتؤديه","ه جميعاً كأحْفظ القُرّاء",49,"ا",2,0],["تقربت من مولاك قرباً مؤبداً","وادعوك لا تبعد وأنت بعيد",50,"د",1,0],["تَقْرُو به مَنْزلَ الحَسْنَاءِ إذْ رَحَلَتْ","فاستقبلت رُحبَ الجوفين فال