{"poems":[[77,"عهد الشباب سقى أيامك الأولا","https://www.aldiwan.net/poem35728.html","البسيط"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[93,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[93,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[51,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[102,"عبس الخطب فابتسم","https://www.aldiwan.net/poem32984.html","مجزوء الخفيف"],[52,"راب دهر وسطا","https://www.aldiwan.net/poem26869.html","مجزوء الرمل"],[46,"ضمكم جنس وأزرى بكم","https://www.aldiwan.net/poem23547.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54986","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43877","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5177","الرمل"],[45,"قالتِ: الشَّيْبُ بَدا، قلتُ: أجَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=32070",""],[130,"فت بين الرباب في العين صابا","https://www.aldiwan.net/poem54893.html","الطويل"],[130,"أبدلت راءها بظاء فتاة","https://www.aldiwan.net/poem54899.html","الخفيف"],[133,"شقوا القلوب وغادروا الأطواقا","https://www.aldiwan.net/poem49169.html","الكامل"],[223,"يا مقر الغزال قد صح عندي اليوم","https://www.aldiwan.net/poem55158.html","الخفيف"],[233,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[334,"فسارعوا للعلم أجمعينا","https://www.aldiwan.net/poem67804.html","عموديه"],[413,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[429,"كوكب لاح بين بدر وشمس","https://www.aldiwan.net/poem12312.html","الخفيف"],[549,"في العناء الطويل كيف وقعتم","https://www.aldiwan.net/poem47151.html","الخفيف"],[549,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"]],"verses":[["رابَ الجَزيرةَ أمْرٌ لا تقَرُّ بِهِ","وهاجَ مِرجَلُها منْ فِتْنَةٍ وغَلا",0,"ل",2,0],["رابَهُ نَبأَةٌ وَأَضمَرَ مِنها","في الصَماخَينِ وَالفُؤادِ ضَميرا",1,"ر",2,0],["رَابِطُ الْجَأْشِ ثَابِتٌ","وَهْوَ فِي أَرْفَعِ الْقِمَمْ",2,"م",1,0],["رَأَبَ الصُّدُوعَ المُوهِيَاتِ بِوَصْلِهِ","مَا انْبَتَّ حَوْلَ العَرْشِ مِنْ أَرْحَامِ",3,"م",1,0],["رابِطُ الجَأشِ عَلى فَرجِهِمُ","أَعطِفُ الجَونَ بِمَربوعٍ مِتَل",4,"ل",1,0],["رابط الجأش في الخطوب وما تع","دم قلباً من خوف ذمٍّ خفوقا",5,"ق",2,0],["رابني صائني ظهيري وزيري","غالني الدهر فيه لُقِّيَ غولهْ",6,"ل",2,0],["رابط الجأش والنهى","ثابتُ القلبِ والقدمْ",7,"م",1,0],["رابَ دَهرٌ وَسَطا","وَنَأى وَأَفرَطا",8,"ط",2,1],["رابَطتُمُ الثَغرَ بِأَفراسِكُم","وَفَوقَكُم في العَقلِ ما تَربِطون",9,"ن",1,0],["رَابَهُمْ حَافِظٌ فَعُوقِبَ فِي جُمَ","لَة مَنْ عَاقَبُوهُ بالإِبْعَاد",10,"د",1,0],["رابِطِ الجَأْشِ فِي الْخطُوبِ فإِنْ","تَعْرِضيِ ليْسَ رَابِطاً جَأْشا",11,"ش",2,0],["رابَه عِلَّتِي ضَنىً فأَتانِي","عائِداً في يَدِهِ لي ياسَمِينُ",12,"ن",1,1],["رابِئٌ يَرتَقِبُ العَيا مَتى","أَمكَنَتهُ فُرصَةُ المَجدِ اهتَبَل",13,"ل",1,0],["رَابىءٌ يَرْتَقِبُ العَلْيَا، مَتَى","أمكَنَتْه فرْصَةُ المَجدِ اهتَبَلْ",14,"ل",1,0],["رَابَ بَينُ الربابِ قلبي ولم أَش","عُر إِلَى أن حَدَا الحُداةُ الرَّبَابَا",15,"ب",2,0],["رَابني صرم رَحمَةٍ وَرَمَاني","بغرامٍ جُرِّعتُ مِنهُ الصَّرَاءَ",16,"ا",2,0],["رأب الصدوع بحكمة منه وقد","ملئت طباقُ بلاد مصر شقاقا",17,"ق",2,0],["رابَني فيكَ ما أَرى من عُيونٍ","باتَ يُغرى بها السَوادُ عُيونا",18,"ن",2,0],["رَأَبتَ شَعبَ الدُنيا وَكانَ ثَأَى ال","إِسلامِ لَولاكَ غَيرَ مَشعوبِ",19,"ب",1,0],["رابعها حلم كمثل الهر","خامسهاإدامة للصبر",20,"ر",1,0],["رابَ سلمى ما رأت من همة","نهضت مني وحَظٍّ متوان",21,"ن",1,0],["رابعٌ للثَّلاَثَةِ الرَّائِضِي المَجْ","دَ بمَسْعَاتِهِمْ رِيَاضَةَ شُمْسِ",22,"س",1,0],["رابَني في اِختيارِ مثلك عقلي","وأَرَتْني المحالَ عيني وأُذني",23,"ي",1,0],["رابطُ الجَأشِ في جليلِ الرّزايا","شاردُ الفِكْرِ في المعاني الدِّقاقِ",24,"ق",1,0]]}