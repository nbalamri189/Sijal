,"https://www.poetsgate.com/ViewPoem.aspx?id=53674",""],[5183,"جلاء الجيش الإنجليزى عن مصر","https://www.poetsgate.com/ViewPoem.aspx?id=185638",""],[5559,"خنساء القدس / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=178195",""],[5756,"الجريمة","https://www.poetsgate.com/ViewPoem.aspx?id=5418",""],[402,"من لعان هواك يصرعه","https://www.poetsgate.com/ViewPoem.aspx?id=35991",""],[402,"لتاج تاج مملكين عظام","https://www.poetsgate.com/ViewPoem.aspx?id=36335",""],[5879,"خماسيات الوجد (4)","https://www.poetsgate.com/ViewPoem.aspx?id=215455",""],[5956,"مجاهد في سبيل الله","https://www.poetsgate.com/ViewPoem.aspx?id=192254",""],[6207,"بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78948&r=&rc=4",""],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""],[6320,"أَقْتَاتُ حُزْنِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83620&r=&rc=1",""]],"verses":[["رابَ الجَزيرةَ أمْرٌ لا تقَرُّ بِهِ","وهاجَ مِرجَلُها منْ فِتْنَةٍ وغَلا",0,"ل",2,0],["رابَهُ نَبأَةٌ وَأَضمَرَ مِنها","في الصَماخَينِ وَالفُؤادِ ضَميرا",1,"ر",2,0],["رَابِطُ الْجَأْشِ ثَابِتٌ","وَهْوَ فِي أَرْفَعِ الْقِمَمْ",2,"م",1,0],["رَأَبَ الصُّدُوعَ المُوهِيَاتِ بِوَصْلِهِ","مَا انْبَتَّ حَوْلَ العَرْشِ مِنْ أَرْحَامِ",3,"م",1,0],["رابِطُ الجَأشِ عَلى فَرجِهِمُ","أَعطِفُ الجَونَ بِمَربوعٍ مِتَل",4,"ل",1,0],["رابط الجأش في الخطوب وما تع","دم قلباً من خوف ذمٍّ خفوقا",5,"ق",2,0],["رابني صائني ظهيري وزيري","غالني الدهر فيه لُقِّيَ غولهْ",6,"ل",2,0],["رابط الجأش والنهى","ثابتُ القلبِ والقدمْ",7,"م",1,0],["رابَ دَهرٌ وَسَطا","وَنَأى وَأَفرَطا",8,"ط",2,1],["رابَطتُمُ الثَغرَ بِأَفراسِكُم","وَفَوقَكُم في العَقلِ ما تَربِطون",9,"ن",1,0],["رَابَهُمْ حَافِظٌ فَعُوقِبَ فِي جُمَ","لَة مَنْ عَاقَبُوهُ بالإِبْعَاد",10,"د",1,0],["رابِطِ الجَأْشِ فِي الْخطُوبِ فإِنْ","تَعْرِضيِ ليْسَ رَابِطاً جَأْشا",11,"ش",2,0],["رابَه عِلَّتِي ضَنىً فأَتانِي","عائِداً في يَدِهِ لي ياسَمِينُ",12,"ن",1,1],["رابِئٌ يَرتَقِبُ العَيا مَتى","أَمكَنَتهُ فُرصَةُ المَجدِ اهتَبَل",13,"ل",1,0],["رَابىءٌ يَرْتَقِبُ العَلْيَا، مَتَى","أمكَنَتْه فرْصَةُ المَجدِ اهتَبَلْ",14,"ل",1,0],["رَابَ بَينُ الربابِ قلبي ولم أَش","عُر إِلَى أن حَدَا الحُداةُ الرَّبَابَا",15,"ب",2,0],["رَابني صرم رَحمَةٍ وَرَمَاني","بغرامٍ جُرِّعتُ مِنهُ الصَّرَاءَ",16,"ا",2,0],["رأب الصدوع بحكمة منه وقد","ملئت طباقُ بلاد مصر شقاقا",17,"ق",2,0],["رابَني فيكَ ما أَرى من عُيونٍ","باتَ يُغرى بها السَوادُ عُيونا",18,"ن",2,0],["رَأَبتَ شَعبَ الدُنيا وَكانَ ثَأَى ال","إِسلامِ لَولاكَ غَيرَ مَشعوبِ",19,"ب",1,0],["رابعها حلم كمثل الهر","خامسهاإدامة للصبر",20,"ر",1,0],["رابَ سلمى ما رأت من همة","نهضت مني وحَظٍّ متوان",21,"ن",1,0],["رابعٌ للثَّلاَثَةِ الرَّائِضِي المَجْ","دَ بمَسْعَاتِهِمْ رِيَاضَةَ شُمْسِ",22,"س",1,0],["رابَني في اِختيارِ مثلك عقلي","وأَرَتْني المحالَ عيني وأُذني",23,"ن",2,0],["رابطُ الجَأشِ في جليلِ الرّزايا","شاردُ الفِكْرِ في المعاني الدِّقاقِ",24,"ق",1,0],["رابط الجأش وما معضلة","لم تمزقها بعضب خذم",25,"م",1,0],["رابطُ الجأش ليس يصبو إلى وص","ل الغزال المخضَّب الأطراف",26,"ف",1,0],["رَابني البارق من مُبتسمٍ","بالثنايا ونسيم السحر",27,"ر",1,0],["رَابَطته حيثُ القدُود شوارع","يزري بحدّ الصارم البتار",28,"ر",1,0],["رابنا من نسيم بونة طيب","فعَساه له هنالك أهل",29,"ل",1,0],["رَابٍ رَوَادِفُهَا يَنُوءُ بخَصرِهَا","كَفَلٌ لَهَا مِثلُ النَّقَا المُتَهَيِّلِ",30,"ل",1,0],["رَابَكِ وَالشَّيْبُ قِنَاعُ المَقْتِ","نُحُولُ جُسْمانِي كَمَا نَحَلْتِ",31,"ت",1,0],["رابضات في صفاها آمنَهْ","هايماتٍ لافتراس واقتناصْ",32,"ص",1,0],["رابطُ الجأشِ وقد جَدَّتْ به","عَزَماتُ الدهر منْ هَزْلٍ وَجِد",33,"د",1,0],["رأبي المحيسة أعلاه وأسفله","ضيق إذا دارك الدهر الجياذير",34,"ر",1,0],["رابحاتٌ قُوَى الفطانةِ فيها","خاسراتٌ من جهلِها الأغبياء",35,"ا",2,0],["رابي المجسة مُترفٌ رَهِلٌ","لم يَبرِهِ سَفَرٌ ولا سَفَنُ",36,"ن",1,0],["رابَني مِنها سُفورٌ راعَني","عِندَهُ مِنها جَمالٌ وَبَها",37,"ه",2,0],["رابي فَنَق فِيْ البيت واتْلَع","حَرْفين باكتب لِهْ مناكيس",38,"س",1,0],["رابعها نصفاً لثانيها غدا","وواحداً ينقص عن أول ها",39,"ل",3,0],["رابطت اعداءاً ملأت قلوبهم","رهبا جزيت الخير عن أرهابها",40,"ب",3,0],["رابِياً ذا مَجَسَّةٍ","أَخنَساً قَد تَقَنفَذا",41,"ذ",2,0],["رَأَبنا وَعَفَّينا الكُلومَ كَما دَجا","عَلى الأَرضِ غَيثٌ صادِقُ الخالِ مُونِقُ",42,"ق",1,0],["رابض كالليث لا يع","بأ بالبرد الشديد",43,"د",1,0],["رابط الجأش إذا قي","ل استعدوا يا جنود",43,"د",1,0],["رَأَبتُ الصَدعَ مِن كَعبٍ فَأَودى","وَكانَ الصَدعُ لا يَعِدُ اِرتِئابا",44,"ب",2,0],["رابطةٌ كانت تضمّ الرّفاق","وأنتَ مَبناها وبيتُ القصيد",45,"د",1,0],["رابضاً ربضةَ الهِزَبْرِ كأَنَّ النْ","نَاسَ يَحْدُو بِهِمْ نَعاماً مَروعَا",46,"ع",2,0],["رابط الجأش ترصد القوم عينٌ","وباخرى يرعى الخبا الممدودا",47,"د",2,0],["رابط الجاش إذا هاج الوغى","باسم بين القنا المشتبك",48,"ك",1,0],["رابضا ربضة بكل هدوء","لم يخف من صواعق الارزاء",49,"ا",2,0],["رابعة يقال ماعون وهي","من درةٍ بيضاء لونها بهيْ",50,"ي",1,0],["رابني بَعْدَكم زماني فلا","الأَيامُ بيضٌ ولا الربيعُ أَنيقُ",51,"ق",1,0],["رابع عماد البيت في ساعة الجد","يا عزوتي يوم كل يعزى عياله",52,"ل",2,0],["رابني منك في ملامك تكث","ير لصبري ببعضه تقليل",53,"ل",1,0],["رابط ُ الجأش ِ .. ها .. أراك تُغنّي","وتُغنّي على شفاك َ اللغات ُ",54,"ت",1,0],["رابضاً ينظر شزْراً فيكم","فإذا واتته حال وثبا",55,"ب",2,0],["رابطْتِ بالقدس الاسير شهيدة","فحملت عمراً فوقه تابوتا",56,"ت",2,0],["رابية بين القبايل والعرب واهل الحمية","عاقله ماتبذر إلا نخلة تعرف رطبها",57,"ب",3,0],["رابط الجأس في الخطوب فإن","تعرضي ليس رابطا جأشا",58,"ش",2,0],["رأب الصدوع الموهيات بوصله","ما نبت حول العرش من أرحام",59,"م",1,0],["رابطّتُ أبكي في البعاد وأشهقُ","حتى بدا للناس أني أحمقُ",60,"ق",1,1],["رابضٌ بين الروابي قانصٌ","دخلاءً يقنصون العربا",61,"ب",2,1],["رابني الأمر حين ألقى بروعي","وحيه الصبح ثم زال ارتيابي",62,"ب",2,0],["رَابينُ شَاميرُ بيريزٌ وراءَهمُ","بَارَاكُ شارونُ كُلٌّ يَتْبَعُ الأَثَراْ",63,"ر",2,0],["رَأَبْتُ صَدْعِي وَخُضْتُ الغَيْمَ وَامْتَنَعَتْ","مِنْ بَعْدِ لَوْكٍ عَلَى هِنْدٍ بَقَايَايَا",64,"ا",3,1]]}