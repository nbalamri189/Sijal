{"poems":[[91,"اخي الى الموت سلك","https://www.aldiwan.net/poem44697.html","مجزوء الرجز"],[68,"خذ من الدهر لي نصيب","https://www.aldiwan.net/poem41371.html","مجزوء الخفيف"],[33,"كدت يوم الرحيل أقضي حياتي","https://www.aldiwan.net/poem42017.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85762","الخفيف"],[133,"صاح قل هل ترى","https://www.aldiwan.net/poem67441.html","مجزوء المتدارك"],[283,"قل لحادي عشر البروج أبي العاشر","https://www.aldiwan.net/poem2479.html","الخفيف"],[415,"ليس طرفي جارا لقلبي ولكن","https://www.aldiwan.net/poem32616.html","الخفيف"],[563,"ليس طيب الحياة غير وفاتك","https://www.aldiwan.net/poem34275.html","الخفيف"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80218","الرمل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46569","الرجز"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/22","الخفيف"],[3469,"ليس طُعمي طُعْمَ الأنامل إِذ","https://www.poetsgate.com/ViewPoem.aspx?id=17634",""],[5674,"فصاحتي بلساني","https://www.poetsgate.com/ViewPoem.aspx?id=185901",""],[6102,"عَيناكِ","https://www.poetsgate.com/ViewPoem.aspx?id=182765",""]],"verses":[["ليس طريقا للرجو","ع ماله أخي سلك",0,"ك",1,0],["لَيسَ طولُ المَدى نَصيب","صَفوِ عَيشٍ بِلا كَدَر",1,"ر",1,0],["لَيسَ طَعمُ الكافورِ وَالمِسكِ شيباً","ثُمَّ عُلّا بِالراحِ وَالزَنجَبيلِ",2,"ل",1,0],["لَيسَ طول الحياة في عدد الأع","وام بل في تنوعات الشعور",3,"ر",1,0],["ليسَ طَرفي يَحيد","عنكَ حتى يَعود",4,"د",1,0],["ليس طبعي ذم الزمان ولكن","أنت أغريتني بذم الزمان",5,"ن",1,0],["لَيس طَرفِي جاراً لِقلبي ولكنْ","دَمُ هَذا بدمعِ هذَا مَشُوبُ",6,"ب",1,1],["ليس طيب الحياة غير وفاتِكْ","والسوى فاتنُ النفوس وفاتِكْ",7,"ك",1,1],["لَيسَ طول البُعد عَني مانِعٌ","إِن أَجدَّ السَعيَ لِلوَجه المُنير",8,"ر",1,0],["لَيسَ طَويلاً يضجر","وَلا قَصيراً يحقر",9,"ر",1,0],["لَيسَ طَعمي طَعمَ الأَرانِبِ إِذ قَل","لَصَ دَرُّ اللِقاحِ في الصِنَبرِ",10,"ر",1,1],["ليس طُعمي طُعْمَ الأنامل إِذ","قلَّص درُّ اللِّقاح في الصِّنبرِ",11,"ر",1,1],["لي سطوةٌ بالشعرِ سادتْ احرُفي","ويظلُّ وحيُ الشعرِ في أوطاني",12,"ن",2,0],["لَيسَ طَوعًا تَرينَهُ يَتَوارَى","كُلَّما الصُّبحُ مِلءَ عَينَيكِ أَشرَقْ",13,"ق",1,0]]}