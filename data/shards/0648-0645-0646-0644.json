َينِ","وَمِن بَينِ الخَليطَينِ",0,"ن",1,0],["وَمَن لي أَن أَراكَ وَلي مُقامٌ","بِدارِكَ لا أَزولُ وَلا أَريمُ",1,"م",1,0],["وَمَن لَم يُوَطِّن لِلصَغيرِ مِنَ الأَذى","تَعَرَّضَ أَن يَلقى أَجَلَّ وَأَعظَما",2,"م",2,0],["وَمَن لَم يَدَع إيقادَ نارٍ بِقَرَّةٍ","فَلا بُدَّ يَوماً أَن يَجيءَ بِصالي",3,"ي",1,0],["وَمَن لِوَجدِيَ أَن يَقتادَني طَمَعٌ","إِلى الحَبيبِ وَأَن يَعتاقَني طَلَلُ",4,"ل",1,0],["وَمَن لو بِخِلٍّ أَرتَضيهِ وَلَيتَ لي","يَميناً يُعاطيها الوَفاءَ شِمالُ",5,"ل",1,0],["وَمَن لي بِيَومٍ شاحِبٍ في عَجاجِهِ","أَنالُ بِأَطرافِ القَنا وَأُنالُ",5,"ل",1,0],["وَمَن لِلمَعاني في الأَكِمَّةِ أُلقِيَت","إِلى باقِرٍ غَيبَ المَعاني وَفاتِقِ",6,"ق",1,0],["وَمَن لِلعُفاةِ المُرمِلينَ يَشُلَّهُم","مِنَ الدَهرِ قِرنٌ لا يُرامُ مَنيعُ",7,"ع",1,0],["وَمَن لَم يَنَل أَطماعَهُ مِن حَبيبِهِ","رَضي غَيرَ راضٍ بِالخَيالِ المُزاوِرِ",8,"ر",1,0],["وَمَن لي بِيَومٍ أَبطَحِيٍّ سُرورُهُ","يُجَوِّلُ ما بَينَ الصَفا وَالمَشاعِرِ",8,"ر",1,0],["وَمَن لِلخَيلِ يُقبِلُهُنَّ شُعثاً","وَيَركَبُهُنَّ شُقراً أَو وِرادا",9,"د",2,0],["وَمَن لِلحَربِ يَنضَحُ ذِفرَيَيها","وَيَعرُكُها جِلاداً أَو طِرادا",9,"د",2,0],["وَمَن لي بِأَن أَتَلافى الخُطو","بَ إِن نافَرَتني صُدورُ الرِماحِ",10,"ح",1,0],["وَمَن لي بِتَقبيلِ كَفِّ الزَما","نِ مِن قَبلِ تَوقيعِها بِاِطِّراحي",10,"ح",2,0],["وَمَن لِعَجاجِ الحَربِ يَجلو ظَلامَهُ","إِذا خَفَقَت في نَقعِها عَذَباتُها",11,"ت",3,0],["وَمَن لِلمَعالي القودِ يَقرَعُ هامَها","إِذا نَفَتِ الإِقدامَ عَنها صِفاتُها",11,"ت",3,0],["وَمَن لِأَضاميمِ الجِيادِ فُدوُّها","لِطَعنِ حَماليقِ العِدى وَبَياتُها",11,"ت",3,0],["وَمِن لَوعَةٍ لِلحُبِّ مَشحوذَةِ الظُبى","إِذا ضَرَبَت في جانِبِ القَومِ ثَنَّتِ",12,"ت",1,0],["وَمَن لَكَ بي يَرُدُّ عَلَيكَ شَخصِيَ","إِذا أَثبَتُّ رِجلي في الرِكابِ",13,"ب",1,0],["وَمَن لَم يَكُن حَمدي نَصيباً لِبِشرِهِ","جَعَلتُ ضُروبَ الذَمِّ أَدنى نَصيبِهِ",14,"ب",2,0],["وَمَن لي بِأَن يَشتاقَ ما أَنا قائِلٌ","وَيَسمَعَ مِنّي ما يَروقُ وَيُعجِبُ",15,"ب",1,0],["وَمَن لَعِبَت بيضُ الثُغورِ بِعَقلِهِ","فَعِندي أَحَرُّ البارِدينِ رُضابُ",16,"ب",1,0],["وَمَنْ لانَ لِلْخَطْبِ المُلِمِّ عَريكَةً","فَإنّي على ما نَابَني حَجَرٌ صَلْدُ",17,"د",1,0],["ومَنْ لم يُراقِبْ رَبَّهُ في رَعيّةٍ","أخِشَّتُهُ تُدْمي عَرانينَهُمْ جَذْبا",18,"ب",2,0],["وَمَن لَم يُرَوِّ رُمحَهُ مِن دَمِ العِد","إِذا اِشتَبَكَت سُمرُ القَنا بِالقَواضِبِ",19,"ب",1,0],["وَمَن لَم يَذُق مُرَّ التَعَلُّمِ ساعَةً","تَذَرَّعَ ذُلَّ الجَهلِ طولَ حَياتِهِ",20,"ت",2,0],["وَمِنْ لُغَاتٍ حَوَالَيْنَا مُبَرْبَرَةٍ","كَأَنَّنَا فِي بِلاَدِ الزَّنْجِ وَالنَّبَطِ",21,"ط",1,0],["ومَنْ لمْ تكُنْ منْ قبْلُ للسّعْدِ عنْدَهُ","مَخيلَةُ نُجْحٍ كيْفَ تُرْجى لهُ بعْدُ",22,"د",1,0],["وَمَنْ لِي بِأَقْوَامٍ عَلَيَّ تَأَلَّبُوا","أُسَالِمُهُمْ دَهْرِي وَيَسْعَوْنَ فِي حَرْبِي",23,"ي",1,0],["وَمَن لَبِس النِّعالَ وَمَن حَذاها","وَمَن قَرأَ المَثانيَ والمئينا",24,"ن",2,0],["وَمَن لا تُفَزَّعُ جاراتُهُ","وَمَن لا يُرى حِلمُهُ مُستَعارا",25,"ر",2,0],["وَمَن لا تُضاعُ لَهُ ذِمَّةٌ","فَيَجعَلَها بَينَ عَينٍ ضِمارا",25,"ر",2,0],["وَمَن لا يَفثَإِ الواشينَ عَنهُ","صَباحَ مَساءَ يَبغوهُ الخَبالا",26,"ل",2,0],["وَمَن لَم تُنَوّه بِاِسمِهِ الحَربُ لَم يَزَل","وَإِن كَرُمَت آباؤُهُ خامِلَ الذِكرِ",27,"ر",1,0],["وَمَن لا يُغَمِّض عَينَه عَن صَديقِهِ","وَعَن بَعضِ ما فيهِ يَمُت وَهوَ عَاتِبُ",28,"ب",1,0],["وَمَن لِكُربَةِ عانٍ في الوِثاقِ وَمَن","يُعطي الجَزيلَ عَلى عُسرٍ وَمَيسورِ",29,"ر",1,0],["وَمَن لِطَعنَةِ حِلسٍ أَو لِهاتِفَةٍ","يَومَ الصُياحِ بِفُرسانٍ مَغاويرِ",29,"ر",1,0],["وَمَن لِمُهِمٍّ حَلَّ بِالجارِ فادِحٍ","وَأَمرٍ وَهى مِن صاحِبٍ لَيسَ يُرقَعُ",30,"ع",1,0],["وَمَن لِجَليسٍ مُفحِشٍ لِجَليسِهِ","عَلَيهِ بِجَهلٍ جاهِداً يَتَسَرَّعُ",30,"ع",1,0],["وَمَنْ لَهُ خَاطِرٌ","إِنْ يَبْتَعِثْهُ الْتَهَبْ",31,"ب",1,0],["ومن لك في الفتيان بالفاضل الذي","له نبل ميخائيل والحلم والرفد",32,"د",1,0],["ومن لم يُهِن صَرْف الزمان برحلة","تُهِنْهُ صروف الدهر في عُقر داره",33,"ر",2,0],["ومن لمعات الشعر نظرة غادة","بنجلاء تسبي القلب في طرَفْها فتر",34,"ر",1,0],["وَمَن لِيَتيمٍ بَعدَ مَوتِ اِبنِ غالِبٍ","وَأُمِّ عِيالٍ ساغِبينَ وَدَردَقِ",35,"ق",1,0],["ومن لا يكن في صدر أمرٍ ينوبه","كذي العَجُز البالي له حين يذهبُ",36,"ب",1,0],["وَمَن لَم يَعرِفِ الشَرَّ","مِنَ الخَيرِ يَقَع فيهِ",37,"ه",1,0],["وَمَن لَقِيَ الَّذي لاقَيتُ هانَت","عَلَيهِ مَوارِدُ المَوتِ الزُؤامِ",38,"م",1,0],["وَمَن لَم يُوَقِّ اللَهُ فَهوَ مُمَزَّقٌ","وَمَن لَم يُعِزِّ اللَهُ فَهوَ ذَليلُ",39,"ل",1,0],["وَمِن لَئيمٍ عَبدٍ يُحالِفُكُم","لَيسَت لَهُ دَعوَةٌ وَلا شَرَفُ",40,"ف",1,0],["ومن لي فيه من ليلٍ طويل","أكابده ومن جفنٍ قصير",41,"ر",1,0],["ومن لعفافٍ عن ثراً وبني الورى","عبيِد الأماني وانْثنيت به حرَّا",42,"ر",2,0],["ومن ليراعٍ قد أفاض مداده","وجرّ من الأطراس ذيل خياله",43,"ل",2,0],["ومن لخطوطٍ غاب بدر كمالها","فهلاّ فداه الخط بابن هلاله",43,"ل",2,0],["ومن لمعانٍ في المهارق تجتلى","بحلي وجوه الخود بين حجاله",43,"ل",2,0],["ومن لي بطرف يستزير خياله","وقد حلف التَّسهيد من بعده أن لا",44,"ل",2,0],["ومن لم يزل في مَصْعَدِ المجد راقياً","صعابَ المَراقي نال عُليا المراتبِ",45,"ب",1,0],["ومن لحظات طرفٍ طاويات","حشايَ برجعهنَّ على نُدوبِ",46,"ب",1,0],["وَمَنْ لم ينلْ مُلكَ المكارمِ باللُّهى","فأموالُهُ للشامتينَ مَوارثُ",47,"ث",1,0],["ومن لمْ يَزِدْ في مجده بذْلُ مالِهِ","وجادَ به فَهْو الجَوَادُ المقلَّدُ",48,"د",1,0],["ومن لا تخلِّده الليالي فكلُّكُمْ","بِخُلْدِ الذي يبني ويَثْني مُخَلَّدُ",49,"د",1,0],["ومن لم يزل يرعَى الشدائد فكره","على مهلٍ هانت عليه الشدائدُ",50,"د",1,0],["ومن لم يزلْ بالحادثات معيِّراً","فَوشكان ما يُلْحقْنَه بالمعيَّر",51,"ر",1,0],["ومن لم يُكفَ ما جرّت يداهُ","فقادته الجريرة في جرير",52,"ر",1,0],["ومن لم تجد في فضل كفيه مرتعاً","ففي عرضه لا في سواه رتوعها",53,"ع",3,0],["ومَن لا يجتبيك الناسُ طرّاً","وضِعفا ذاك من لا يَرتضيكا",54,"ك",2,0],["ومَن لكَ في الدنيا بأروعَ ماجدٍ","رقيقِ الحواشي صادق البأس حازمِ",55,"م",1,0],["ومن لم يزل يبْتَزُّ ليثاً فريسةً","يكن قَمِناً أنْ لا يُرى منه سالما",56,"م",2,0],["ومن له من يدٍ كفٌّ وساعدُها","إذ ليس لي عنده ساقٌ ولا قدمُ",57,"م",1,0],["وَمَنِ لثاوي الَّذي تَبكونَهُ","قَيصَرٌ أَم تُبَّعٌ أَم عَنتَرَه",58,"ر",2,0],["وَمَن لا يَرى الحُسنَ في ما يَراهُ","فَما هُوَ بِالرَجُلِ الأَلمَعي",59,"ي",1,0],["وَمَن لِلحَقِّ يَنشُرُهُ لِوءً","بِهِ لِلناسِ هَديٌ وَاِعتِصامُ",60,"م",1,0],["وَمَن لَم تُضَرِّسهُ الخُطوبُ بِنابِها","يَظُنُّ شِكاياتِّ النُفوسِ تَشاكِيا",61,"ي",2,0],["ومَن لم يعانقْهُ شَوْقُ الحياةِ","تَبَخَّرَ في جَوِّها واندَثَرْ",62,"ر",1,0],["ومن لا يحبُّ صُعودَ الجبالِ","يَعِشْ أبَدَ الدَّهرِ بَيْنَ الحُفَرْ",62,"ر",1,0],["ومن لم يرُعْهُ قطوبُ الدّياجيرِ","لَمْ يغتبط بالصَّباحِ الجديدْ",63,"د",1,0],["وَمِن لَذَّةِ الدُنيا وَإِن كُنتَ ظالِماً","عِناقُكَ مَظلوماً وَأَنتَ تُعاتِبُه",64,"ب",2,0],["ومن للنفحة الكبرى","من الرِجل إلى الرأس",65,"س",1,0],["وَمَن لَقِيَ السِباعَ بِغَيرِ ظَفرٍ","وَلا نابٍ تَمَزَّقَ أَو تَفادى",66,"د",2,0],["وَمَن لَم يُقِم سِتراً عَلى عَيبِ غَيرِهِ","يَعِش مُستَباحَ العِرضِ مُنهَتِكَ السِترِ",67,"ر",1,0],["وَمَن لَم يُجَمِّل بِالتَواضُعِ فَضلَهُ","يَبِن فَضلُهُ عَنهُ وَيَعطَل مِنَ الفَخرِ",67,"ر",1,0],["وَمَن لي بِيَومٍ مِثلِ يَومٍ كَرِهتُهُ","قَرُبتُ بِهِ عِندَ الوَداعِ مِنَ البُعدِ",68,"د",1,0],["وَمَن لَم يَعشَقِ الدُنيا قَديماً","وَلَكِن لا سَبيلَ إِلى الوِصالِ",69,"ل",1,0],["وَمَن لَم تُعَلِّمهُ لَكَ الذُلَّ نَفسُهُ","مِنَ الناسِ طُرّاً عَلَّمَتهُ المَناصِلُ",70,"ل",1,0],["وَمَنٌّ لِفُرسانِ الثُغورِ عَلَيهِمِ","بِتَبليغِهِم ما لا يَكادُ يُرامُ",71,"م",1,0],["وَمَن لُبُّهُ مَع غَيرِهِ كَيفَ حالُهُ","وَمَن سِرُّهُ في جَفنِهِ كَيفَ يَكتُمُ",72,"م",1,0],["ومن لم يكن عارفاً بالرمو","زِ فلا يهلكنَّ بتعبيرِنا",73,"ن",2,0],["ومن لم يُردْ عيشَ الوحيدِ فإنَّه","يلاقي مُعاديهِ لقاءَ المسالمِ",74,"م",1,0],["ومن لي بكتمانِ الهوى ومدامعي","تَنُمُّ وأنفاسي الحرارُ تشيعُ",75,"ع",1,0],["ومن ليس تلحقهُ أعينُ ال","عِدى كيف تلحَقُهُ الأذرعُ",76,"ع",1,0],["وَمَن لي بِإِذنٍ حينَ أَغدو إِلَيكُما","وَدونَكُما البَرجُ المُطِلُّ وَحاجِبُه",77,"ب",2,0],["وَمِن لُؤلُؤٍ في الأُقحُوانِ مُنَظَّمٍ","عَلى نُكَتٍ مُصفَرَّةٍ كَالفَرائِدِ",78,"د",1,0],["وَمَن لَو تَرى في مِلكِهِ عُدتَ نائِلاً","لَأَوَّلِ عافٍ مِن مُرَجّيهِ مُقتِرِ",79,"ر",1,0],["وَمَن لَم يَرَ الإيثارَ لَم يَشتَهِر لَهُ","فَعالٌ وَلَم يَبعُد بِسُؤدَدِهِ ذِكرُ",80,"ر",1,0],["وَمِن لَوعَةٍ تَعتادُ في إِثرِ لَوعَةٍ","وَمِن أَدمُعٍ تَرفَضُّ في إِثرِ أَدمُعِ",81,"ع",1,0],["وَمَن لَهُ عَمَّةٌ تَزني وَوالِدَةٌ","قَوّادَةٌ نَذلَةٌ مَهتوكَةٌ خَلَقَه",82,"ق",2,0],["ومَنْ لَدَيْهِ رياضُ الحَمدِ مُونِقَةً","فزَهرُها فيه منظومٌ ومنثورُ",83,"ر",1,0],["وَمَن لا يُقَدِّم رِجلَهُ مُطمَئِنَّةً","فَيُثبِتَها في مُستَوى الأَرضِ تَزلِقِ",84,"ق",1,0],["وَمَن لا يَصُن قَبلَ النَوافِذِ عِرضَهُ","فَيُحرِزَهُ يُعرَر بِهِ وَيُخَرَّقِ",84,"ق",1,0],["وَمَن لا يُصانِع في أُمورٍ كَثيرَةٍ","يُضَرَّس بِأَنيابٍ وَيوطَأ بِمَنسِمِ",85,"م",1,0],["وَمَن لا يَذُد عَن حَوضِهِ بِسِلاحِهِ","يُهَدَّم وَمَن لا يَظلِمِ الناسَ يُظلَمِ",85,"م",1,0],["وَمَن لا يَزَل يَستَحمِلُ الناسَ نَفسَهُ","وَلا يُغنِها يَوماً مِنَ الدَهرِ يُسأَمِ",85,"م",1,0],["وَمَن لَم يُقاسِ الدَهرَ لَم يَعرِفِ الأَسى","وَفي غِيَرِ الأَيّامِ ما وَعَد الدَهرُ",86,"ر",1,0],["وَمَن لي بِهَذا لَيتَ أَنّي أَصَبتُهُ","فَقاسَمتُهُ مالي مِنَ الحَسَناتِ",87,"ت",1,0],["وَمَن لَم يَزِدهُ السِنُّ ما عاشَ عِبرَةً","فَذاكَ الَّذي لا يَستَنيرُ بِنورِ",88,"ر",1,0],["وَمَن لَم يُحاسِب نَفسَهُ في أُمورِهِ","يَقَع في عَظيمٍ مُشكِلٍ مُتَشابِهِ",89,"ه",1,0],["وَمَن لَهُ خاطَبَ الجِزعُ اليَبيسُ وَمَن","بِكَّفِهِ أَورَقَت عَجراءُ مِن سَلَمِ",90,"م",1,0],["وَمَن لَوَ اَنَّ صُروفَ الدَهرِ تُسعِدُني","لَما سَعَت نَحوَ مَغنى غَيرِهِم قَدَمي",91,"م",2,0],["وَمَن لِكَثرَةِ تَمثيلي لِشَخصِهِمُ","أَظُنُّ في كُلِّ يَومٍ أَنَّهُم قَدِموا",92,"م",3,0],["وَمَن لي بِصَدٍّ مِنهُمُ وَتَجَنُّبٍ","إِذا كانَ مِنّا مَنزِلُ القَومِ دانِيا",93,"ي",2,0],["وَمَن لَهُ أَخَذَ اللَهُ العُهودَ عَلى","كُلِّ النَبِيِّنَ مِن بادٍ وَمُلتَحِقِ",94,"ق",1,0],["ومن لي بإدراك عُمرٍ قضى","إذا أحْوَجَتني الليالي إليها",95,"ي",3,0],["ومن لَثْمِ يمناك لولا النّدى","رأى حَجَرَ الركن يُغْشَى استلاما",96,"م",2,0],["وَمِن لَحظَتِهِ عَينُ يَحيَى برفعةٍ","فَقَد رَكِبَ الأيّامَ واستَخدَمَ السّعْدا",97,"د",2,0],["وَمَن لَم يَكُن يَنفَكُّ يَغبِقُ سَيفَهُ","دَماً عانِداً مِن نَحرِ لَيثٍ مُعانِدِ",98,"د",1,0],["وَمَن لَم يُسَلِّم لِلنَوائِبِ أَصبَحَت","خَلائِقُهُ طُرّاً عَلَيهِ نَوائِبا",99,"ب",2,0],["وَمَنْ لَمْ يُغَالِطْ فِي الزَّمَانِ عَدُوَّهُ","وَيُبْدِي لَهُ الْحُسْنَى فَلَيْسَ بِحَازِمِ",100,"م",1,0],["ومنْ لي أن أبيتَ قريرَ عينٍ","أعاطي كأسَ لفظِكَ للصباحِ",101,"ح",1,0],["ومَنْ للمشكلاتِ والفتاوى","وفصلُ الأمرِ إنْ عَظُمَ الخصامُ",102,"م",1,0],["ومن لم يتعظ لغدٍ بأمسٍ","وإن كان الذكيُّ هو البليد",103,"د",1,0],["وَمَن لِسَقيمٍ يَكتُمُ الناسَ ما بِهِ","لِزَينَبَ نَجوى صَدرِهِ وَالوَساوِسُ",104,"س",1,1],["وَمَن لَستُ أَصبِرُ عَن ذِكرِهِ","وَلا هُوَ عَن ذِكرِنا صابِرُ",105,"ر",1,0],["وَمَن لا أُبالي رِضا غَيرِهِ","إِذا هُوَ سُرَّ وَلَم يَغضَبِ",106,"ب",1,0],["وَمَن لا يُطيعُ بِنا أَهلَهُ","وَمَن قَد عَصَيتُ لَهُ أَقرَبي",106,"ب",2,0],["وَمَن لَو نَهانِيَ مِن حُبِّهِ","عَنِ الماءِ عَطشانَ لَم أَشرَبِ",106,"ب",1,0],["وَمَن لا سِلاحَ لَهُ يُتَّقى","وَإِن هُوَ نوزِلَ لَم يُغلَبِ",106,"ب",1,0],["وَمَن لي بِرَدِّ الريحِ مِن أَبرَقِ الحِمى","وَرَيّا الخُزامى مِن أُجارِعِ لَعلَعا",107,"ع",2,0],["وَمَن لي بِذاكَ الخِشفِ مِن مُتَقَنَّصٍ","فَآكُلَهُ عَضّاً وَأَشرَبَهُ شَمّا",108,"م",2,0],["وَمَن لَو رَأى الأَعداءَ يَكتَنِفونَني","لَهُم غَرَضاً يَرمونَني لَرَمانِيا",109,"ي",2,0],["وَمَنْ لم يَرْعَ ما شَرَعا","فما صَلَّى ولا صاما",110,"ا",1,0],["وَمَن لا يُرِد عِندَهُ عِصمَةً","إِذا فَدَحَ الخَطبُ لَم يُعصَمِ",111,"م",1,0],["ومن لم يَمْتَحِنْ دُنيا المعالي","فما امتحَنَ الشُّجَاعَ ولا الجبانا",112,"ن",2,0],["وَمَن لي بِجِسمٍ أَشتَكي مِنهُ بِالضَنى","وَقَلبٍ فَأَشكو مِنهُ بِالخَفَقانِ",113,"ن",1,0],["وَمَن لي بِوَعدٍ مِنهُ أَشكو بِخُلفِهِ","وَمَن لي بِعَهدٍ مِنهُ أَشكو بِهِ الغَدرا",114,"ر",2,0],["وَمِن لغرّ القَوافي وَهِيَ مُشرِقَة","كَأَوجه البَدَويات الرَعابيب",115,"ب",1,0],["وَمَن لَم تُنازِعهُ الخَلائِقُ مُلكَهُ","وَإِن لَم تُفرِّدهُ العِبادُ فَمُفرَدُ",116,"د",1,0],["وَمَنْ لي أنْ أرى منه مُحَيّاً","يُسَرُّ بحسنِهِ القلْبُ الكئِيبُ",117,"ب",1,0],["وَمَنْ لَمْ يَلِنْ منهُ إلى الحَقِّ جانِبٌ","بِقَولٍ أَلانَتْ جَانِبَيهِ القَنا المُلْدُ",118,"د",1,0],["ومَنْ لَمْ يَخَفْ في اللَّهِ لَوْمَةَ لائِمٍ","وَلَمْ يُعْيِهِ قِسْطٌ يُقامُ وَلا حَدُّ",118,"د",1,0],["وَمَنْ لَمْ يُعَفَّر كَرَّمَ اللَّهُ وَجْهَهُ","جَبينٌ لغيرِ اللَّهِ منه ولا خَدُّ",118,"د",1,0],["ومَنْ لَهُ مَنْزِلَةٌ في العُلا","تَكِلُّ عَنْ أَوْصَافِهَا الفِكْرَهْ",119,"ر",2,0],["وَمَنْ لَمْ يَدَّخِرْ فَرَساُ جَوَاداً","لِوَقِعَةٍ وَلا سَيْفاً ثَمِينا",120,"ن",2,0],["ومَن لم تُؤيِّدْ مُلْكَهُ يَهْوِ عَرشُهُ","ومَنْ لم تُثَبِّتْ عِزَّه يَتَهَدَّم",121,"م",1,0],["ومنْ لي بمثلِ سلاح الزّمانِ","فأسْطو عليه إذا ما سطا",122,"ا",1,0],["ومن لا يُنادي أخاً باسمِهِ","فليس يُخافُ ولا يُرتَجَى",122,"ا",1,0],["وَمَن لَهُ شَمسٌ عَلى خَدِّهِ","طالِعَةٌ بِالسَعدِ ما تَغرُبُ",123,"ب",1,0],["وَمَن لِنَفسٍ في الهَوى","تَدورُ دَورَ العَرَبَه",124,"ب",2,0],["وَمَن لَو كانَ في المَشرَ","بِ ساوى المِزرَ بِالشَهدِ",125,"د",1,0],["وَمَن لَو كانَ في الطيبِ","لَكانَ العَنبَرَ الهِندي",125,"ي",1,0],["وَمَن لَو كانَ في الرَيحا","نِ ما كانَ سِوى الوَردِ",125,"د",1,0],["ومن لامكَ في هذا","فقُل مَن أنتَ في الرُقعه",126,"ع",2,0],["وَمَن لَيسَ يُواتيني","وإِن كَلَّفتُهُ يُسرا",127,"ر",2,0],["وَمن لِصَخر بنِ عَمرٍو أَنَّ جُثَّتَهُ","صَخرٌ وَخَنساءَهُ في السِربِ خَنساءُ",128,"س",3,0],["وَمَن لَم يَنَل في القولِ رُتبَةَ شاعِرٍ","تَقَنَّعَ في نَظمٍ بِرُتبَةِ راجِزِ",129,"ز",1,0],["وَمَن لي أَن أَفَرَّ عَلى طِمِرٍّ","مِنَ الدُنِّيا الخَبيثَةِ أَو دِلَمزِ",130,"ز",1,0],["وَمَن لا يُجِد حِفظَ التَجارُبِ لا يَزَل","عَلى السِنِّ غُمراً إِنَّ طولَ المَدى يُنسي",131,"س",2,0],["وَمَن لي أَن يَعودَ الدينُ غَضّاً","فَّيَنقَعَّ مَن تَنَسَّكَ بَعدَ خِمسِ",132,"س",1,0],["وَمَن لِأَخيكَ لَو يَحدو رِكاباً","بِأَفراسٍ يَطَأنَ عَلى القَراسِ",133,"س",1,0],["وَمَن لَكَ بِالعَيشِ في غُرَّةٍ","تَظَلُّ مَطاياكَ لا تَرقُصُ",134,"ص",1,0],["وَمَن لَم تُشرِقِ الدُنيا بِماءٍ","فَأُقسِمُ أَن سَتُشرِقُهُ بَريقِ",135,"ق",1,0],["وَمَن لِلفَتى وَهُوَ الشَقيُّ بِأَنَّهُ","يَدومُ عَلى ضَنكِ الشَقاءِ وَيُترَكُ",136,"ك",1,0],["وَمَن لي بِجونٍ عِندَ كُدرٍ بِقَفرَةٍ","كَأَنَّهُما مِن آلِ يَعقوبَ سِبطانِ",137,"ن",1,0],["وَمَن لي أَن أَكونَ طَريدَ سِربٍ","سَما لي خِدنُ سِنبِسَ أَو رَماني",138,"ي",1,0],["ومَنْ لي أن أصُوغَ الشُّهْبَ شِعْراً","فأُلْبِسُ قَبْرَهَا سِمْطَيْ نِظامِ",139,"م",1,0],["ومَنْ لم يَسْتَطِعْ أعْلامَ رَضْوَى","ليَنزِلَ بعضَها نَزَلَ السُّفوحا",140,"ح",2,0],["ومَنْ لم يَأتِ دارَكَ مُسْتَفِيداً","أتاها في عُفاتِكَ مُسْتَميحا",140,"ح",2,0],["ومن لم يكنْ في عِزّةِ الحبِّ تائهاً","بِحُبّ الذي يَهوى فَبَشّرْهُ بالذّل",141,"ل",1,0],["ومن لم يحط علماً بأمر محيطه","عداه الهدى أَو أَقلَقته الهواجس",142,"س",1,0],["ومن لم يزن عند التكلم نفسه","فمن حقه أن لا يقام له وزن",143,"ن",1,0],["ومن لم يعشق الدّنيا قديماً","ولكن لا سبيل إلى وصال",144,"ل",1,0],["ومَن لي بِزادكِ لم يَبق ما","يَلوكُ لِسانُكِ أو يعلُكُ",145,"ك",1,0],["ومن لقلبٍ أضاع بين اله","وى وبين الصبا ربيعه",146,"ع",2,0],["ومَنْ لي بأنّي في جَناحِ غَمامةٍ","تُشَبّهُها في الجُنْحِ أُمّ رِئال",147,"ل",1,0],["وَمَن لَم يُرَوِّ رُمحَهُ مِن دَمِ العِدا","إِذا اِشتَبَكَت سُمرُ القَنا بِالقَواضِبِ",148,"ب",1,0],["ومَن لَم يَكُن ذا ناصِرٍ عِندَ حَقِّه","يُغَلَّب عَلَيهِ ذُو النَّصيرِ ويُضهَدِ",149,"د",1,0],["ومَن لا يُوَرِّع نَفسَهُ يَتبَعِ الهَوَى","ومَن يَتبَعِ الَحرباءَ يَغشَ القَناذِعا",150,"ع",2,1],["وَمَنْ لَكَ أَنْ تَرَى قَلْبَاً نَقِيَّاً","وَلَمَّا يَخْلُ قَلْبٌ مِنْ سَوَادِ",151,"د",1,0],["وَمَنْ لَمْ يُدارِ النَّاسَ عَادَاهُ صَحْبُهُ","وَأَنْكَرَهُ مِنْ قَوْمِهِ مَنْ يَسُودُهُ",152,"د",2,0],["وَمَنْ لِي بِأَنَّ الْقَلْبَ يَكْتُمُ وَجْدَهُ","وَكَيْفَ تُسَامُ النَّارُ أَنْ تَكْتُمَ النَّدَّا",153,"د",2,0],["وَمَنْ لَمْ يَذُقْ حُلْوَ الزَّمَانِ وَمُرَّهُ","فَمَا هُوَ إِلَّا طَائِشُ اللُّبِّ نَافِرُ",154,"ر",1,0],["وَمَنْ لَمْ يُعِنْ بِالجِدِّ عَالِيَ جَدِّهِ","فَيَقْظَتُهُ حُلْمٌ وَعِيشَتُهُ سُدَى",155,"د",2,0],["وَمِنْ لَسِنٌ تَجْرِي عُيُونُ كَلامِهِ","عَلَى شِبْهِ دُرٍّ مِنْ مَعَانِيهِ وَضَّاحِ",156,"ح",1,0],["وَمَنْ لَمْ يَمُتْ بِالدَّاءِ فَالطِّبُّ لَمْ يَزَلْ","سِلاَحَ المَنَايَا فِي يَدَيْ كُلِّ جَاهِلِ",157,"ل",1,0],["وَمَن لَم يَكُن حَدّهُ جَدُّه","دَهَتهُ الَّتي اِستَأصَلَت بَرمَكا",158,"ك",2,0],["ومَنْ لم يُؤَدِّبْهُ البيانُ وهَدْيُه","فإنَّ الحسامَ العَضبَ نعمَ المؤَدِّبُ",159,"ب",1,0],["ومن لم تكن من قبل للسعد عنده","مخيلة نجع كيف ترجى له بعد",160,"د",1,0],["ومن لم يرضَ موطنه مقراً","من الدنيا فليس له مقر",161,"ر",1,0],["ومن لم يجد إلا ذعاف مذلة","وروداً فموت العز مورده عذب",162,"ب",1,0],["ومن لم يذق مر التعلم ساعة","تجرع ذل الجهل طول حياته",163,"ت",2,0],["وَمِنْ لُؤلُؤٍ في الأُمحُوَانِ مُنَظَّمٍ،","عَلى نُكَتٍ مُصْفَرّةٍ، كالفَرَائِدِ",164,"د",1,0],["ومن لم تبيّتْهُ الخطوبُ، فإنّهُ","سيَصْبَحُهُ من حادث الدّهر صابح",165,"ح",1,0],["وَمَنْ لَمْ يُصَانِعْ فِي أُمُورٍ كَثِيرَةٍ","يُضَرَّسْ بِأَنْيَابٍ وَيُوْطَأ بِمَنْسِمِ",166,"م",1,0],["وَمَنْ لَمْ يَذُدْ عَنْ حَوْضِهِ بِسِلاحِهِ","يُهَدَّمْ وَمَنْ لا يَظْلِمْ النَّاسَ يُظْلَمِ",166,"م",1,0],["ومن لم تجد في فضل كفَّيه مرتعاً","ففي عرضه لا في سواه روعُها",167,"ع",3,0],["ومن لا يزد عن حوضه بنفسه","يهدم ومن يخالق الناس يعلم",168,"م",1,0],["وَمَن لا يَكُن ذا ناصِرٍ عِندَ حَقِّهِ","يُغَلَّب عَلَيهِ ذو النَصيرِ وَيَعتَدِ",169,"د",1,0],["ومَنْ لصُرُوفِ الدَّهْرِ عَنِّيَ صارفٌ","ومن لهموم القلب عني طاردُ",170,"د",1,0]]}