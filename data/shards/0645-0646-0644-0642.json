tps://www.aldiwan.net/poem61226.html","الكامل"],[458,"ما جاء قبلك للتخليد إنسان","https://www.aldiwan.net/poem61247.html","البسيط"],[482,"ما لحبل الوصل قد أمسى رماما","https://www.aldiwan.net/poem15278.html","الرمل"],[484,"أبتي كيف غالك الموت غدرا","https://www.aldiwan.net/poem37049.html","الخفيف"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53808","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122789","المديد"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64112","الرجز"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145637","المديد"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96686","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96676","الرمل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105426","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125377","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53052","الخفيف"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110612","الرمل"],[2469,"","https://poetry.dctabudhabi.ae/diwan/poem/203611","الخفيف"],[2552,"","https://poetry.dctabudhabi.ae/diwan/poem/144425","السريع"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113863","الرمل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122494","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109855","الخفيف"],[3170,"","https://poetry.dctabudhabi.ae/diwan/poem/115122","المديد"],[3461,"","https://poetry.dctabudhabi.ae/diwan/poem/34011","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59480","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73380","الدوبيت"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83147","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72520","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72789","الرمل"],[4750,"الجهالة","https://www.poetsgate.com/ViewPoem.aspx?id=180397",""],[4797,"حالك وش بلاه","https://www.poetsgate.com/ViewPoem.aspx?id=132237",""],[4119,"من لقلب يألف الفكرا","https://www.poetsgate.com/ViewPoem.aspx?id=16151",""],[5219,"لمن أشكو","https://www.poetsgate.com/ViewPoem.aspx?id=194428",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5463,"كل عام وإنتي حبّي","https://www.poetsgate.com/ViewPoem.aspx?id=33784",""],[5672,"نزيل الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=206401",""],[5830,"طَيْفٌ وَ وَعْدٌ وَ أَمَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=200906",""],[5931,"بس أمل !","https://www.poetsgate.com/ViewPoem.aspx?id=175192",""],[4432,"ادكارا بعد ما ولى الشباب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=564221",""],[5377,"حراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79568&r=&rc=24",""]],"verses":[["مَن لِقَتيلِ الحُبِّ لَو","رُدَّ عَلَيهِ القاتِلُ",0,"ل",1,0],["مَن لِقَلبٍ مُتَيَّمٍ مُستَهَامِ","غَيرِ ما صَبوةٍ ولا أحلاَمِ",1,"م",1,1],["مَن لَقَّنَ الطَيرَ أَناشيدَها","وَعَلَّمَ الزَهرَ تَآخيها",2,"ي",3,0],["مَن لِقَلبٍ مُتَيَّمٍ مُشتاقِ","شَفَّهُ شَوقُهُ وَطولُ الفِراقِ",3,"ق",1,1],["مَنْ لقلبي بسلمِها وَهْيَ تأتي","كلَّ يومٍ مِنْ حربِها بفنونِ",4,"ن",1,0],["مَن لِقَلبٍ أَمسى حَزيناً مُعَنّى","مُستَكيناً قَد شَفَّهُ ما أَجَنّا",5,"ن",2,1],["مَن لِقَلبٍ عِندَ الرَبابِ عَميدِ","غَيرِ ما مُفتَدىً وَلا مَردودِ",6,"د",1,1],["مَن لِقَلبٍ غَيرَ صاحِ","في تَصابٍ وَمِزاحِ",7,"ح",1,1],["مَن لِقرنِ الشّمسِ جبْهتهُ","ولِلمعِ البَرقِ مُبْتسَمُهْ",8,"م",2,0],["من لقلبٍ مُستطارِ اللُّبِّ مَن","كلما عاوده التَّذكارُ جُنّ",9,"ن",1,0],["من لقتيلٍ بالسّفا مكفّن","مرّت به ثلاثةٌ لم يدفن",10,"ن",1,1],["من لِقَلبٍ دَنِفٍ أو مُعتَمَد","قد عَصَى كلَّ نَصيحٍ ومُفَد",11,"د",1,1],["مَنْ لِقَلْبِي بِشَادِنٍ","لَمْ يُمَتَّعْ بِحَظِّهِ",12,"ظ",2,1],["من لقلب مشت عليه المطايا","حين امت سوح البطاح الحسان",13,"ن",1,0],["من لقلب معذب صار في قيدٍ","وأضحى من الغرام عميدَا",14,"د",2,0],["مَن لِقَلبٍ أَمسى كَئيباً حَزيناً","مُستَهاماً بَينَ اللُها وَالتَراقي",15,"ق",2,1],["مَن لِقَلبٍ أَصلَيتُموهُ لَظى الجَم","رِ وَجَنبٍ أَفرَشتُموهُ القَتادا",16,"د",2,0],["من لقلبي وقد تملّكه اليأس","ونفسي الثكلى وروحي الطامي",17,"م",2,0],["مَن لِقَلبٍ مَعَ الصَبا","بَةِ وَالشَوقِ مُرتَهَن",18,"ن",1,0],["من لَقّبتهُ المَعالي رفعة وَأَبَت","تَلقيبه بِسوى ما فيهِ مِن نسَبِ",19,"ب",1,0],["مِن لَقَلب باتَ يُصلى","جَمر شَوق وَبُعاد",20,"د",1,0],["مَن لِقَلب يَصلى سَعير تَجني","ك وَيَبقى كَأَنَّهُ الياقوت",21,"ت",1,1],["مَن لِقَلبي بِأَمان","وَهُدؤ كَالقُلوب",22,"ب",1,0],["مَن لِقَلبٍ يَهيمُ في كُلِّ وادي","وَقَتيلٍ لِلحُبِّ مِن غَيرِ وادي",23,"د",2,1],["مَنْ لِقَلبٍ ما سلاك وإن","قالتِ العُذّالُ فيه سلا",24,"ل",2,0],["من لقّن الإيثار دينا للورى","كأخيه واستبقا استباق الغافر",25,"ر",1,0],["من لقّن الحكمة الشورى بسيرته","ووزّع الحب فالأعداء إخوان",26,"ن",1,0],["مَنْ لقلبٍ كلَّما قلتُخَبَتْ","نارُه أذكتْهُ لي ريحُ النُّعامى",27,"م",2,0],["من لقلبي المسجور من لفؤادي","من لدار قد أصبحت منك قترا",28,"ر",2,0],["مَنْ لقلب مُتَيَّمٍ برغيفين","ونفس تاقت إلى تَطْفيلِ",29,"ل",1,0],["مَن لِقَلبٍ ذابَ أَسوَدُهُ","مِن جِنانٍ فيهِ نيرانُ",30,"ن",1,0],["مَنْ لقلوبٍ حَرِقَهْ","مَنْ لعيونٍ أرِقَهْ",31,"ه",1,1],["مَنْ لِقَلبٍ عاشِقٍ جُرِحَا","لَمْ يَعُدْ لِلوصلِ مُنْشَرِحا",32,"ا",1,1],["مَن لقلبٍ ذائبٍ محترقٍ","في مَقاساتِ الكآباتِ عكَف",33,"ف",1,0],["مَن لقلبٍ خامَرَته همّةٌ","طَأطَأ النجمُ لها وَاِتّضعا",34,"ع",2,0],["من لقلبي بأن يفوز بمن يهوا","ه بعد التياعه بالبعاد",35,"د",1,0],["من لقلبي بأن يَعيشَ سعيداً","أو يَذُوقَ الرَّدَى شهيَّ غرامِك",36,"ك",1,0],["من لقلب إذا بوادر دمع","بردته فماؤهن لهيبُ",37,"ب",1,0],["من لقلب المستهام الواله","فلقد أسرف في بلباله",38,"ه",1,0],["من لقلب به البعاد مضر","وبه من جوى النوى تبريح",39,"ح",1,1],["من لقتيل بسهام هي ال","نجلُ السَّواجي واللَّمى الأحوى؟",40,"و",2,0],["من لقلب ضاع في ينبعكم","منبع الحسن ودار الحسنات",41,"ت",1,0],["مَن لقولِ الرسُولِ يا شيخُ مَن بع","دك يحمِي ذِمارَهُ والذِّمَامَا",42,"م",2,0],["من لقلبي بان يعيش سعيداً","او يذوق الردى شهياً غرامك",43,"ك",1,0],["مَن لقلبٍ هائمٍ دَنِفِ","كلمّا سلّيتُه قَلقا",44,"ق",2,0],["مَن لِقَلبٍ يَجولُ بَينَ التَراقي","مُستَهامٍ يتوقُ كُلَّ مَتاقِ",45,"ق",1,1],["مِن لِقا جَوىً","مِن طروقِ همّ",46,"م",1,0],["مَن لقلبٍ كلما قيلَ سلا","عاده عائد شوقٍ فخفقْ",47,"ق",1,0],["من لَقَّبَكَ النَّجمَ تُرى كَيفَ أَتى","بالقَصدِ فَأَنتَ الكَوكَبُ الَمشبوبُ",48,"ب",1,0],["مَن لِقَلبٍ بَينَ الجَوانح عانِ","جَمَع اليَأسَ وَالمُنى في مَكانِ",49,"ن",1,1],["من لقلبي من مقاساة الغرام","آتش هجران وي سوزد مدام",50,"م",1,0],["من لقلبي من هوى غانيةٍ","بسيوفِ الهندِ تهزو مقلتاها",51,"ا",3,0],["من لقا عذب المشارب ومثمرة الزهور","ما قعد يغرف من البحر ويسوق أحدجه",52,"ج",2,0],["من لقاني قال حالك وش بلاه","انت كنك طالعن لك من مرض",53,"ض",1,1],["من لقلب يألف الفكرا","ولعين ما تذوق كرى",54,"ر",2,1],["من لقلب بائس وجل","من لثكلى عينها رمدت",55,"ت",1,0],["مَنْ لُقِّبُوا بِعِبَادِ الله فِي سُوَرٍ","وَالآيُ يَمْدَحُ أَصْحَابًا بِلا ذَمَمِ",56,"م",1,0],["من لقيتك زان حالي وزانت أحوال القصيد","فصرت أكتب بالمحبه وعن سعاده هالكيان",57,"ن",1,0],["من لقلبي وقد وهاه حنينٌ","أنتَ عمري وقد بلغتُ عتيا ..",58,"ي",2,0],["مَنْ لِقَلْبِي وَ النَّوى يَكْوِي الهَوَى","يَالِقَلْبِي مِنْ حَبِيبِي لَوْ غَدَرْ",59,"ر",1,0],["من لقا بك غايته شيٍ جميل","ومن تجلّى في عيونك ما أفل",60,"ل",1,0],["مَن لِقَلبٍ حامِلٍ مِن وَجدِهِ","ما يَذُوبُ الصَخرُ مِنهُ وَالهِضاب",61,"ب",1,0],["من لقلب الظمآن من وقدِ صحرا","ء تلظت من حرها الأفياء",62,"ا",2,1]]}