/poem24798.html","أحذ الكامل"],[44,"سعدت غربة النوى بسعاد","https://www.aldiwan.net/poem30559.html","الخفيف"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[48,"باتت بطرف مسهد","https://www.aldiwan.net/poem62576.html","المجتث"],[48,"يا معرضا نفسي الفداء","https://www.aldiwan.net/poem64363.html","مجزوء الكامل"],[76,"أيها البدر الذي ضن","https://www.aldiwan.net/poem39263.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85432","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54775","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54559","الكامل"],[106,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[106,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179090",""],[54,"عَلِّلانِي بِسَمَاعٍ وَطِلا","https://www.poetsgate.com/ViewPoem.aspx?id=13864",""],[108,"ماني نبي","https://www.poetsgate.com/ViewPoem.aspx?id=36760",""],[41,"يا رَوضَة َ الوضَّاحِ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=4227",""],[94,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[63,"ومشبلة ٍ شمطاءَ تبكي منَ النَّوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=25951&r=&rc=13",""],[109,"وروز لا كنت قلبي فيك مكروب","https://www.aldiwan.net/poem16501.html","البسيط"],[115,"بعينيك يا هذا الغزال الى متى","https://www.aldiwan.net/poem41106.html","عموديه"],[147,"يا سيدي يا رسول الله يا سندي","https://www.aldiwan.net/poem47642.html","البسيط"],[186,"إنما أنت بحسك","https://www.aldiwan.net/poem43503.html","مجزوء الرمل"],[211,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[211,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[211,"إيه يا فتنة الوجود سلام من","https://www.aldiwan.net/poem46801.html","الخفيف"],[223,"أسيلة الفحشاء نارك في دمي","https://www.aldiwan.net/poem41597.html","الكامل"],[237,"يا أيها البحر مهلا","https://www.aldiwan.net/poem18847.html","المجتث"],[338,"أي جهل يكون أبين من جهل","https://www.aldiwan.net/poem68748.html","الخفيف"],[369,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[391,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[416,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[441,"حتام طول الأماني والتعلات","https://www.aldiwan.net/poem14355.html","البسيط"],[441,"يا راقد الليل إن الليل قد صدرا","https://www.aldiwan.net/poem14367.html","البسيط"],[458,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[458,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[458,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[458,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[464,"قالوا السعيد تعاطى بغله نزقاً","https://www.aldiwan.net/poem3122.html","عموديه"],[464,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[464,"قسماً لقد أملى أحاديث الغضا","https://www.aldiwan.net/poem3531.html","عموديه"],[470,"إني لآمل أن تدنو وإن بعدت","https://www.aldiwan.net/poem4661.html","البسيط"],[477,"دمع على عرصات الربيع مسكوب","https://www.aldiwan.net/poem15258.html","البسيط"],[514,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[529,"أبغضوه لا لذنب","https://www.aldiwan.net/poem37283.html","مجزوء الرمل"],[551,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[551,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[551,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[551,"زعازع ثم نكب","https://www.aldiwan.net/poem48102.html","الطويل"],[558,"إن ديني وملتي واعتقادي","https://www.aldiwan.net/poem34642.html","الخفيف"]],"verses":[["أَبُغاةَ هَذا المَجدِ إِنَّ مَرامَهُ","دَحضٌ يُزِلُّ الصاعِدينَ وَيُزلِقُ",0,"ق",1,0],["أَبغي هَواهُ بِشافِعٍ مِن غَيرِهِ","شَرُّ الهَوى ما نِلتَهُ بِشَفيعِ",1,"ع",1,0],["أَبَغداذُ ما لي فيكَ نَهلَةُ شارِبٍ","مِنَ العَيشِ إِلّا وَالخَطوبُ مِزاجُها",2,"ج",3,0],["أَبغي الفؤادَ لديها","فما وجدتُ فؤادي",3,"ي",1,0],["أَبْغَي عُلاً رامَها جَدِّي فَأَدْرَكَها","وَكانَ في غَمْرَةِ الهَيْجاءِ يَنْغَمِسُ",4,"س",1,0],["أَبَغْداذُ كَمْ تُنْسيهِ نَجْداً وَأَهْلَهُ","أَلا خَابَ من يَشْري بِبغْدادِكُمْ نَجْدا",5,"د",2,0],["أَبغي الأَنيسَ فَلا أَرى لي مُؤنِساً","إِلّا التَرَدُدَ حَيثُ كُنتُ أَراكِ",6,"ك",1,0],["أَبْغِضْ بِهِ فِي العِدَى مِنْ هَادِمٍ حَنِقٍ","وَحَبَّذَا هُوَ التَّارِيخِ مِنْ بَانِ",7,"ن",1,0],["أَبْغِي الرِّثَّاءَ لَهُ فَيُبْرِقُ خَاطِرِي","حُزْناً وَلَكِنْ أَيْنَ صَوْبُ غَمَامِ",8,"م",1,0],["أَبغِض المالَ إِذا جَمَّعتَهُ","إِنَّ بُغضَ المالِ مِن حُبِّ العُلا",9,"ا",1,0],["أَبغَضُ ثَوبَيها إِلَيها الباقي","تَأكُلُ مِن كيسِ اِمرِئٍ وَرّاقِ",10,"ق",1,0],["أَبغي الوَفاءَ بِدَهرٍ لا وَفاءَ لَهُ","كَأَنَّني جاهِلٌ بِالدَهرِ وَالناسِ",11,"س",1,0],["أبِغَثِّ الكِياد تلقَى القوافي","كمُلاقي الجيوش في كالوز",12,"ز",1,0],["أبغضتَ من طَعِمَ الطَّعامَ فريقُه","سمٌّ لديك فما تُجاِمُل طاعما",13,"م",2,0],["أَبغي الشِفاءَ مِنَ الهُمومِ بِها","فَتُزيدُني وِقراً عَلى وَقرِ",14,"ر",1,0],["أَبغي الثَراءَ وَلَم يَكُن مِن مَطلَبي","وَأَرى الجَمالَ بِناظِرٍ مُتَعامِ",15,"م",1,0],["أَبغَضُ لِلعَينِ مِنَ الأَقذاءِ","أَثقَلُ مِن شَماتَةِ الأَعداءِ",16,"ا",2,0],["أُبَغّي بَني صَعبِ بنِ مُرٍّ بِلادَهُم","وَسَوفَ أُلاقيهِم إِن اللَهُ أَخَّرا",17,"ر",2,0],["أبغي العصاة بدافع من نفسهم","ام كان ذاك البغي بالايعاز",18,"ز",1,0],["أبغدادُ أنت الموطن الأوَّل الذي","به طاب في عهد الصبا لي صبابات",19,"ت",1,0],["أبغي نهاياتِ العُلى وسجيتي","تأبى التوسُّطَ فالتوسطُ هونُ",20,"ن",1,0],["أَبغي شَفيعاً إِلَيكَ أَو سَبَباً","عِندَكَ في الناسِ أَستَزيدُكَ بِه",21,"ب",2,0],["أَبغي مِنَ الدُنيا زِيادَتَها","وَزِيادَتي فيها هِيَ النَقصُ",22,"ص",1,0],["أَبغي الكَثيرَ إِلى الكَثيرِ مُضاعَفاً","وَلَوِ اِقتَصَرتُ عَلى القَليلِ كَفاني",23,"ي",1,0],["أبغي الهدوء ولا هدوء وفي","صدري عبابٌ غير مأمون",24,"ن",1,0],["أَبغَضوا عِزَّكُم وَوَدّوا نِداكُم","فَقَرَوكُم مِن بِغضَةٍ وَوِدادِ",25,"د",1,0],["أبغِضْ بها مُقَلاً قد أَشْبَهَتْ لَبَناً","طَفا الذُّبابُ عليهِ وهْوَ مَمْقولُ",26,"ل",1,0],["أَبغي دُنُوّاً إِلَيها","بِالجَهدِ مِنّي فَتَبعُد",27,"د",1,0],["أَبغَضتَني يا سَيِّدي","أَفديكَ حِبّاً مُبغِضا",28,"ض",2,0],["إِبْغِ لي عِنْدَكَ قَلْباً","طارَ مِنْ بَينِ ضُلوعِي",29,"ي",1,0],["أَبغي الحَقيقَة وَالحَقي","قةُ ما عَلَيها من غبار",30,"ر",1,0],["أَبْغِي بَيَاناً لِمَا يُخَامِرُنِي","مِنْهَا وَمَالِي فِي أَنْ أُبِينَ يَدُ",31,"د",1,0],["أَبْغِي الذَّهَابَ فَفِيمَ أُحْ","رَمُهُ وَيَسْتَعْصِي الذَّهَابُ",32,"ب",1,0],["أبغير مجد بني نزارَ ويعربِ","يُزهى عراقيِّ، ويفخر شامي؟",33,"م",2,0],["أبغصن زيتون يجا","زَى أم بصَارم الانتقام؟",34,"م",1,0],["أبغدادُ وهي القحمةُ السِنِّ خِبرةً","تَلَهَّى بألعابٍ كطفلٍ مُحمَّق",35,"ق",1,0],["أبغي المسائلَ محضةً ويعوُقني","عن ذلكم ، سببٌ من الأسباب",36,"ب",1,0],["\" أبغدادُ \" اذكري كم من دموع","أزارتكِ الصبابةَ والغليلا",37,"ل",2,0],["أَبْغُضُ المَالَ إذا جَمّعتُهُ إنَّ بغضَ المالِ من حبَّ العلا","إنما العَيْشُ خِلاَلٌ خَمْسَة ٌ حَبَّذَا تِلكَ خِلاَلاً حَبَّذا",38,"ا",1,0],["أبغا أتوحّد وأنت أخذ مزهبك وأترك مزهبي","كنّا أخويا ومن بعد مازلّليت ؟ ماحن بخويا",39,"ي",2,0],["أبْغَضْتُ فيهِ أحِبَّتي","وقليتُ أهلي والوطنْ",40,"ن",1,0],["أبغضونا على العروبة والفت","ح ويلقى عند الهجين الأصيل",41,"ل",1,0],["أَبَغْدادُ كَمْ تُنْسيهِ نَجْداً وَأَهْلَهُ","أَلا خَابَ من يَشْري بِبغْدادِكُمْ نَجْدا",42,"د",2,0],["أَبغي القِيام وَسوء الحَظ يَقعدني","مِن غالب القَدر المَحتوم مَغلوب",43,"ب",1,0],["أبغية روحي والمحبة عهدها","قديم ودين الود لا يتغير",44,"ر",1,0],["أبغي رضاك ولا شيء أقدمه","سوى افتقاري وذلّي واصفرار يدي",45,"ي",1,0],["ابغ للناس من الخي","ر كما تبغي لنفسك",46,"ك",1,0],["أبغداد هل تدرين أني مودّعٌ","وأن سمومَ البين تلفح أحشائي",47,"ي",1,0],["أبغدادُ هذا آخر العهد فاذكرى","مدامع مفطورٍ على الحبّ بكّاء",47,"ا",2,0],["أبغداد يضنيني فراقك فاذكرى","لدى ذمة التاريخ بيني وإضنائي",47,"ي",1,0],["أبغدادُ في عهد الرشيد تأرّجت","بأطيب من أنفاسها وهي في عهدي",48,"د",2,0],["أبغى صاحبا تولّه قبلى","وشجاه من الجوى ما شجاني",49,"ي",1,0],["أَبغيَّ هذا العَصر خمركِ فَاِغرُفي","وَاِسقي ذَراريَّ الوَرى وَاِستَسلمي",50,"ي",1,0],["أَبْغِي السِّوَاكَ وَلاَ أُرِيدُ سِوَاكَا","سُبْحَانَ يَا بَدْرُ الذِي سَوَّاكَا",51,"ك",2,0],["أُبغِضُ الناسَ إِن ظَنَنتُ عَلى الظَ","ظَنِّ وَأَنسى اليَقينَ مِن عِلمِ نَفسي",52,"ي",1,0],["أبغي شفاء تدلُّهي من دلِّه","ومتى يرقُّ مدلَّلٌ لمدلَّه",53,"ه",1,0],["أبغض الخلق للهاذي تراه","أكثر الناس فكاللهاه",54,"ه",1,0],["أبْغَضَ الشر فلا يَصْحَبُه","وانطوى منه على الخير الضمير",55,"ر",1,0],["أبغي العلاج لعلات بليت بها","فالحرص والطمع المرذول علاتي",56,"ي",1,0],["أبغي الجوار أجرني من عذاب غد","أنت الحفظي فما أحتاج للخفرا",57,"ر",2,0],["أبغي حياضَكُمُ فأُضْرَبُ دونها","ضربَ الغرائب وهْي حَرَّى هِيمُ",58,"م",1,0],["أبغداد حُلتِ فما أنتِ لي","بدارِ مَصيفٍ ولا مَربعِ",59,"ع",1,0],["أبغضاً أم لأنَّ سِنيَّ مُدَّتْ","فدام عليكُمُ ردّي وكرّي",60,"ي",1,0],["أبغي الشفاءَ بذكره مِن مُسقِمي","عجباً لمن هو علّتي وتعلّتي",61,"ي",1,0],["أبغضت بالطبع أم المؤمنين ولم","تحبب أباها فجاءت وقعة الجمل",62,"ل",1,0],["أبغي الثناء على حماة أسودها","جهدي فتشغلني صفات ظبائها",63,"ا",3,0],["أبغضتُ حسنَ الصبر مذ أحببتها","فأعجبْ لمن أضحى محبّاً مبغضاً",64,"ض",2,0],["أَبغَضتُ كُلَّ بِلادٍ كُنتُ آلَفُها","فَما أُلائِمُ إِلا أَرضَها بَلَدا",65,"د",2,0],["أبغي الوصالَ ومِن دوني ودونهمُ","بيدٌ تَكِلُّ بها البُزْلُ المصاعيبُ",66,"ب",1,0],["أبغَضُ النّاسِ من بَنيه لديهِ","ماجدٌ عقّهُ بخُلْقٍ جديدِ",67,"د",1,0],["أَبْغَضُوهُ لا لِذَنْبٍ","وَهْوَ بالحُبِّ خَلِيقُ",68,"ق",1,1],["أبغي النّجاءَ وما أنجو وإنْ غفلتْ","عنّى المنون كما لم ينجُ أمثالي",69,"ي",1,0],["أبغي الّذي كلُّ الورى عن بَغْيهِ","من بين مصدودٍ ومن مصدوفِ",70,"ف",1,0],["أبغِي الرّذاذ من الجَهام وتارةً","أرجو وأمرِي دَرَّ كلِّ جَدودِ",71,"د",1,0],["أَبغي وَما العودُ رَطْباً","ما كانَ وَالعودُ رَطْبُ",72,"ب",1,0],["أبغضتها مني العدا بعيون","هي ما بين جفنهم والسواد",73,"د",1,0]]}