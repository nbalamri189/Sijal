abi.ae/diwan/poem/105175","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120363","الكامل"],[4797,"ماهوب كفو الوقت حبك يمحّيه","https://www.poetsgate.com/ViewPoem.aspx?id=50259",""],[4869,"محاكاة صورة","https://www.poetsgate.com/ViewPoem.aspx?id=138048",""],[4875,"أبغى الإجابة","https://www.poetsgate.com/ViewPoem.aspx?id=132226",""],[4956,"إلى سلطان","https://www.poetsgate.com/ViewPoem.aspx?id=1483",""],[4963,"ليش نزلتي عيونك ارفعيها وطالعيني","https://www.poetsgate.com/ViewPoem.aspx?id=35142",""],[5026,"فراشة سكرى","https://www.poetsgate.com/ViewPoem.aspx?id=210477",""],[5038,"آل الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=188998",""],[5122,"(( لا حرزت راحه ولا مربح أحرزت ))","https://www.poetsgate.com/ViewPoem.aspx?id=26734",""],[5122,"(( يامضيع العشاق..1))","https://www.poetsgate.com/ViewPoem.aspx?id=27095",""],[5126,"لا أبتغي الا لقانا","https://www.poetsgate.com/ViewPoem.aspx?id=206094",""],[5277,"رسائلُ عشقٍ بغدادية..4","https://www.poetsgate.com/ViewPoem.aspx?id=191525",""],[5277,"جوريّة قيسية","https://www.poetsgate.com/ViewPoem.aspx?id=200587",""],[5320,"إلى رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=40398",""],[5376,"إنِّي جَزِعْتُ وما لنا الا هو","https://www.poetsgate.com/ViewPoem.aspx?id=188286",""],[5460,"أجمعت ظالمة على تركي","https://www.poetsgate.com/ViewPoem.aspx?id=200739",""],[5480,"(هذا الزمن) في غلاء المهور","https://www.poetsgate.com/ViewPoem.aspx?id=4166",""],[5648,"الا ياليتني شعره على ذيك الكتوف تميل","https://www.poetsgate.com/ViewPoem.aspx?id=157235",""],[5691,"شموع","https://www.poetsgate.com/ViewPoem.aspx?id=206531",""],[5725,"على مجدك المذبوح","https://www.poetsgate.com/ViewPoem.aspx?id=177465",""],[5725,"عشقت بعينيك","https://www.poetsgate.com/ViewPoem.aspx?id=181097",""],[402,"يا صورة شبهت صخرا بإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=36833",""],[5848,"محراب صمتك","https://www.poetsgate.com/ViewPoem.aspx?id=53163",""],[5848,"عقارب تعبث","https://www.poetsgate.com/ViewPoem.aspx?id=53335",""],[5931,"نديم الهمس وشعوره !!","https://www.poetsgate.com/ViewPoem.aspx?id=174779",""],[6093,"الكُلُّ يخطيءُ تارةً ويُصيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=205649",""],[6100,"هياكل أوادم","https://www.poetsgate.com/ViewPoem.aspx?id=52556",""],[469,"قالوا السعيد تعاطى بغله نزقا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574821",""],[6262,"الرحيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80112&r=&rc=10",""],[422,"قلبٌ يذوبُ ومهجة ٌ تتقطَّع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22250&r=&rc=6",""],[5126,"متى أعيش؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87816&r=&rc=31",""]],"verses":[["أَبُغاةَ هَذا المَجدِ إِنَّ مَرامَهُ","دَحضٌ يُزِلُّ الصاعِدينَ وَيُزلِقُ",0,"ق",1,0],["أَبغي هَواهُ بِشافِعٍ مِن غَيرِهِ","شَرُّ الهَوى ما نِلتَهُ بِشَفيعِ",1,"ع",1,0],["أَبَغداذُ ما لي فيكَ نَهلَةُ شارِبٍ","مِنَ العَيشِ إِلّا وَالخَطوبُ مِزاجُها",2,"ج",3,0],["أَبغي الفؤادَ لديها","فما وجدتُ فؤادي",3,"د",2,0],["أَبْغَي عُلاً رامَها جَدِّي فَأَدْرَكَها","وَكانَ في غَمْرَةِ الهَيْجاءِ يَنْغَمِسُ",4,"س",1,0],["أَبَغْداذُ كَمْ تُنْسيهِ نَجْداً وَأَهْلَهُ","أَلا خَابَ من يَشْري بِبغْدادِكُمْ نَجْدا",5,"د",2,0],["أَبغي الأَنيسَ فَلا أَرى لي مُؤنِساً","إِلّا التَرَدُدَ حَيثُ كُنتُ أَراكِ",6,"ك",1,0],["أَبْغِضْ بِهِ فِي العِدَى مِنْ هَادِمٍ حَنِقٍ","وَحَبَّذَا هُوَ التَّارِيخِ مِنْ بَانِ",7,"ن",1,0],["أَبْغِي الرِّثَّاءَ لَهُ فَيُبْرِقُ خَاطِرِي","حُزْناً وَلَكِنْ أَيْنَ صَوْبُ غَمَامِ",8,"م",1,0],["أَبغِض المالَ إِذا جَمَّعتَهُ","إِنَّ بُغضَ المالِ مِن حُبِّ العُلا",9,"ا",1,0],["أَبغَضُ ثَوبَيها إِلَيها الباقي","تَأكُلُ مِن كيسِ اِمرِئٍ وَرّاقِ",10,"ق",1,0],["أَبغي الوَفاءَ بِدَهرٍ لا وَفاءَ لَهُ","كَأَنَّني جاهِلٌ بِالدَهرِ وَالناسِ",11,"س",1,0],["أبِغَثِّ الكِياد تلقَى القوافي","كمُلاقي الجيوش في كالوز",12,"ز",1,0],["أبغضتَ من طَعِمَ الطَّعامَ فريقُه","سمٌّ لديك فما تُجاِمُل طاعما",13,"م",2,0],["أَبغي الشِفاءَ مِنَ الهُمومِ بِها","فَتُزيدُني وِقراً عَلى وَقرِ",14,"ر",1,0],["أَبغي الثَراءَ وَلَم يَكُن مِن مَطلَبي","وَأَرى الجَمالَ بِناظِرٍ مُتَعامِ",15,"م",1,0],["أَبغَضُ لِلعَينِ مِنَ الأَقذاءِ","أَثقَلُ مِن شَماتَةِ الأَعداءِ",16,"ا",2,0],["أُبَغّي بَني صَعبِ بنِ مُرٍّ بِلادَهُم","وَسَوفَ أُلاقيهِم إِن اللَهُ أَخَّرا",17,"ر",2,0],["أبغي العصاة بدافع من نفسهم","ام كان ذاك البغي بالايعاز",18,"ز",1,0],["أبغدادُ أنت الموطن الأوَّل الذي","به طاب في عهد الصبا لي صبابات",19,"ت",1,0],["أبغي نهاياتِ العُلى وسجيتي","تأبى التوسُّطَ فالتوسطُ هونُ",20,"ن",1,0],["أَبغي شَفيعاً إِلَيكَ أَو سَبَباً","عِندَكَ في الناسِ أَستَزيدُكَ بِه",21,"ب",2,0],["أَبغي مِنَ الدُنيا زِيادَتَها","وَزِيادَتي فيها هِيَ النَقصُ",22,"ص",1,0],["أَبغي الكَثيرَ إِلى الكَثيرِ مُضاعَفاً","وَلَوِ اِقتَصَرتُ عَلى القَليلِ كَفاني",23,"ن",2,0],["أبغي الهدوء ولا هدوء وفي","صدري عبابٌ غير مأمون",24,"ن",1,0],["أَبغَضوا عِزَّكُم وَوَدّوا نِداكُم","فَقَرَوكُم مِن بِغضَةٍ وَوِدادِ",25,"د",1,0],["أبغِضْ بها مُقَلاً قد أَشْبَهَتْ لَبَناً","طَفا الذُّبابُ عليهِ وهْوَ مَمْقولُ",26,"ل",1,0],["أَبغي دُنُوّاً إِلَيها","بِالجَهدِ مِنّي فَتَبعُد",27,"د",1,0],["أَبغَضتَني يا سَيِّدي","أَفديكَ حِبّاً مُبغِضا",28,"ض",2,0],["إِبْغِ لي عِنْدَكَ قَلْباً","طارَ مِنْ بَينِ ضُلوعِي",29,"ع",2,0],["أَبغي الحَقيقَة وَالحَقي","قةُ ما عَلَيها من غبار",30,"ر",1,0],["أَبْغِي بَيَاناً لِمَا يُخَامِرُنِي","مِنْهَا وَمَالِي فِي أَنْ أُبِينَ يَدُ",31,"د",1,0],["أَبْغِي الذَّهَابَ فَفِيمَ أُحْ","رَمُهُ وَيَسْتَعْصِي الذَّهَابُ",32,"ب",1,0],["أبغير مجد بني نزارَ ويعربِ","يُزهى عراقيِّ، ويفخر شامي؟",33,"م",2,0],["أبغصن زيتون يجا","زَى أم بصَارم الانتقام؟",34,"م",1,0],["أبغدادُ وهي القحمةُ السِنِّ خِبرةً","تَلَهَّى بألعابٍ كطفلٍ مُحمَّق",35,"ق",1,0],["أبغي المسائلَ محضةً ويعوُقني","عن ذلكم ، سببٌ من الأسباب",36,"ب",1,0],["\" أبغدادُ \" اذكري كم من دموع","أزارتكِ الصبابةَ والغليلا",37,"ل",2,0],["أَبْغُضُ المَالَ إذا جَمّعتُهُ إنَّ بغضَ المالِ من حبَّ العلا","إنما العَيْشُ خِلاَلٌ خَمْسَة ٌ حَبَّذَا تِلكَ خِلاَلاً حَبَّذا",38,"ا",1,0],["أبغا أتوحّد وأنت أخذ مزهبك وأترك مزهبي","كنّا أخويا ومن بعد مازلّليت ؟ ماحن بخويا",39,"ي",2,0],["أبْغَضْتُ فيهِ أحِبَّتي","وقليتُ أهلي والوطنْ",40,"ن",1,0],["أبغضونا على العروبة والفت","ح ويلقى عند الهجين الأصيل",41,"ل",1,0],["أَبَغْدادُ كَمْ تُنْسيهِ نَجْداً وَأَهْلَهُ","أَلا خَابَ من يَشْري بِبغْدادِكُمْ نَجْدا",42,"د",2,0],["أَبغي القِيام وَسوء الحَظ يَقعدني","مِن غالب القَدر المَحتوم مَغلوب",43,"ب",1,0],["أبغية روحي والمحبة عهدها","قديم ودين الود لا يتغير",44,"ر",1,0],["أبغي رضاك ولا شيء أقدمه","سوى افتقاري وذلّي واصفرار يدي",45,"د",2,0],["ابغ للناس من الخي","ر كما تبغي لنفسك",46,"ك",1,0],["أبغداد هل تدرين أني مودّعٌ","وأن سمومَ البين تلفح أحشائي",47,"ي",1,0],["أبغدادُ هذا آخر العهد فاذكرى","مدامع مفطورٍ على الحبّ بكّاء",47,"ا",2,0],["أبغداد يضنيني فراقك فاذكرى","لدى ذمة التاريخ بيني وإضنائي",47,"ي",1,0],["أبغدادُ في عهد الرشيد تأرّجت","بأطيب من أنفاسها وهي في عهدي",48,"د",2,0],["أبغى صاحبا تولّه قبلى","وشجاه من الجوى ما شجاني",49,"ن",2,0],["أَبغيَّ هذا العَصر خمركِ فَاِغرُفي","وَاِسقي ذَراريَّ الوَرى وَاِستَسلمي",50,"م",2,0],["أَبْغِي السِّوَاكَ وَلاَ أُرِيدُ سِوَاكَا","سُبْحَانَ يَا بَدْرُ الذِي سَوَّاكَا",51,"ك",2,0],["أُبغِضُ الناسَ إِن ظَنَنتُ عَلى الظَ","ظَنِّ وَأَنسى اليَقينَ مِن عِلمِ نَفسي",52,"ي",1,0],["أبغي شفاء تدلُّهي من دلِّه","ومتى يرقُّ مدلَّلٌ لمدلَّه",53,"ه",1,0],["أبغض الخلق للهاذي تراه","أكثر الناس فكاللهاه",54,"ه",1,0],["أبْغَضَ الشر فلا يَصْحَبُه","وانطوى منه على الخير الضمير",55,"ر",1,0],["أبغي العلاج لعلات بليت بها","فالحرص والطمع المرذول علاتي",56,"ت",2,0],["أبغي الجوار أجرني من عذاب غد","أنت الحفظي فما أحتاج للخفرا",57,"ر",2,0],["أبغي حياضَكُمُ فأُضْرَبُ دونها","ضربَ الغرائب وهْي حَرَّى هِيمُ",58,"م",1,0],["أبغداد حُلتِ فما أنتِ لي","بدارِ مَصيفٍ ولا مَربعِ",59,"ع",1,0],["أبغضاً أم لأنَّ سِنيَّ مُدَّتْ","فدام عليكُمُ ردّي وكرّي",60,"ر",2,0],["أبغي الشفاءَ بذكره مِن مُسقِمي","عجباً لمن هو علّتي وتعلّتي",61,"ي",1,0],["أبغضت بالطبع أم المؤمنين ولم","تحبب أباها فجاءت وقعة الجمل",62,"ل",1,0],["أبغي الثناء على حماة أسودها","جهدي فتشغلني صفات ظبائها",63,"ا",3,0],["أبغضتُ حسنَ الصبر مذ أحببتها","فأعجبْ لمن أضحى محبّاً مبغضاً",64,"ض",2,0],["أَبغَضتُ كُلَّ بِلادٍ كُنتُ آلَفُها","فَما أُلائِمُ إِلا أَرضَها بَلَدا",65,"د",2,0],["أبغي الوصالَ ومِن دوني ودونهمُ","بيدٌ تَكِلُّ بها البُزْلُ المصاعيبُ",66,"ب",1,0],["أبغَضُ النّاسِ من بَنيه لديهِ","ماجدٌ عقّهُ بخُلْقٍ جديدِ",67,"د",1,0],["أَبْغَضُوهُ لا لِذَنْبٍ","وَهْوَ بالحُبِّ خَلِيقُ",68,"ق",1,1],["أبغي النّجاءَ وما أنجو وإنْ غفلتْ","عنّى المنون كما لم ينجُ أمثالي",69,"ل",2,0],["أبغي الّذي كلُّ الورى عن بَغْيهِ","من بين مصدودٍ ومن مصدوفِ",70,"ف",1,0],["أبغِي الرّذاذ من الجَهام وتارةً","أرجو وأمرِي دَرَّ كلِّ جَدودِ",71,"د",1,0],["أَبغي وَما العودُ رَطْباً","ما كانَ وَالعودُ رَطْبُ",72,"ب",1,0],["أبغضتها مني العدا بعيون","هي ما بين جفنهم والسواد",73,"د",1,0],["أبغِض بِشَيبِ مَفارِقي مِن نازِلٍ","عِندي وَأَحبِب بِالشَّبابِ الرّاحِلِ",74,"ل",1,0],["أبغض عنصر السلافِيِّينا","طبيعةً وعادةً ودينا",75,"ن",2,1],["أَبغي زِيارَتَها وَالنّفسُ طالِبةٌ","لَكِن عَفافي اِرتَضَى لِي شقةَ البينِ",76,"ن",1,1],["أَبَغِضِتَهُ مِنْ بَعْدِمَا بُذِلَ الرِّضَا","هذَا تَجَنٍّ مِنْ حَبِيبٍ يُرتضَى",77,"ض",2,1],["أَبْغِي الفَخارَ وأخشى أنْ يُعَنِّفَني","مَن ليس يعلم ما عندي من القلقِ",78,"ق",1,0],["أبغى بهنَّ لحافاً","ولو بأيسر قيمه",79,"م",2,0],["أبغي ابنِ أنثى يُناك في دُبُرٍ","وشعره من نجومه أدبر",80,"ر",1,0],["أبغضت كل العاملين الأثم وال","متهورّين بوهدة الزلاتِ",81,"ت",1,0],["ابغي وفاء الفرض في","اقبال ايام أُخر",82,"ر",1,0],["أَبغِي مُرَاجَعَةً وَأَعلَمُ أَنَّهَا","لَهو المقيمِ وَضحكَةُ المُستَوفِزِ",83,"ز",1,0],["أبغي الخطابَ له بوصفٍ جامعٍ","لهباته فيه أخاطب مجده",84,"د",2,0],["أبغي صفاء ودكم وحاني","عليه لا أبغي خمور حان",85,"ن",1,0],["أبغير الهجر تقتلني","لا أبالي هجرك الغرض",86,"ض",1,0],["أبغى بها الجمع به يوما ونيل قربه","وفضل حب ربه ومن رضاه أملى",87,"ل",2,0],["أَبغي السُلُوَّ وَلا أَبغيهِ وا أَسَفا","قَلبٌ تَنازَعَهُ في الحُبِّ ضِدّانِ",88,"ن",1,0],["أبغير القرآن أحكم أح","كاماً إليها دون الملا أوجاها",89,"ا",3,0],["أبغى السرى والعيس عز مسيرها","والطرق سدّت عن فتى مسجون",90,"ن",1,0],["أبغي ذمام لحاظه وقوامُه","يملي عليَّ مقاتل الفرسان",91,"ن",1,0],["أبغضُ الخلقِ إلينا","من تسمى لي بإنسي",92,"س",2,0],["أبغى من ا