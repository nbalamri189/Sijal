{"poems":[[53,"لمن الحدوج تهزهن الأنيق","https://www.aldiwan.net/poem29959.html","الكامل"],[53,"يا صاحب القلب الصحيح أما اشتفى","https://www.aldiwan.net/poem30126.html","الكامل"],[53,"لي الحرب معطوفا علي هياجها","https://www.aldiwan.net/poem30661.html","الطويل"],[63,"قفا بنجد نسلم","https://www.aldiwan.net/poem45684.html","المجتث"],[63,"يا صاحبي خذا للسير أهبته","https://www.aldiwan.net/poem45929.html","البسيط"],[63,"ومشبلة شمطاء تبكي من النوى","https://www.aldiwan.net/poem46114.html","الطويل"],[55,"يا من تباشرت القبور بموته","https://www.aldiwan.net/poem26192.html","الكامل"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[93,"طفيء الصباح بعيني الإلهام","https://www.aldiwan.net/poem11359.html","الكامل"],[54,"عللاني بسماع وطلا","https://www.aldiwan.net/poem27664.html","الرمل"],[27,"لا تحسبي سباسب العراق","https://www.aldiwan.net/poem5929.html","الرجز"],[47,"لمن أعاتب مالي أين يذهب بي","https://www.aldiwan.net/poem25243.html","البسيط"],[51,"قل لنا يا سلامة بن سعيد","https://www.aldiwan.net/poem64538.html","الخفيف"],[51,"كم جارع جرع المكاره عالما","https://www.aldiwan.net/poem66087.html","الكامل"],[91,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[91,"سيرت في فجر الحياة سفينتي","https://www.aldiwan.net/poem62730.html","عموديه"],[70,"وجاهل طال به عنائي","https://www.aldiwan.net/poem43039.html","الرجز"],[12,"ونائحة أوحيت في الصبح سمعها","https://www.aldiwan.net/poem1211.html",""],[89,"أكبر بفيصل من مليك حازم","https://www.aldiwan.net/poem44730.html","الكامل"],[89,"أعاشر قوما عندهم لي عداوة","https://www.aldiwan.net/poem45081.html","الطويل"],[62,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[45,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[49,"كل على الدنيا له حرص","https://www.aldiwan.net/poem62136.html","الكامل"],[49,"عجبا عجبت لغفلة الإنسان","https://www.aldiwan.net/poem63130.html","الكامل"],[97,"أمسي يعذبني ويضنيني","https://www.aldiwan.net/poem24798.html","أحذ الكامل"],[44,"سعدت غربة النوى بسعاد","https://www.aldiwan.net/poem30559.html","الخفيف"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[48,"باتت بطرف مسهد","https://www.aldiwan.net/poem62576.html","المجتث"],[48,"يا معرضا نفسي الفداء","https://www.aldiwan.net/poem64363.html","مجزوء الكامل"],[76,"أيها البدر الذي ضن","https://www.aldiwan.net/poem39263.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85432","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54775","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54559","الكامل"],[106,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[106,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179090",""],[54,"عَلِّلانِي بِسَمَاعٍ وَطِلا","https://www.poetsgate.com/ViewPoem.aspx?id=13864",""],[41,"يا رَوضَة َ الوضَّاحِ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=4227",""],[63,"ومشبلة ٍ شمطاءَ تبكي منَ النَّوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=25951&r=&rc=13",""]],"verses":[["أَبُغاةَ هَذا المَجدِ إِنَّ مَرامَهُ","دَحضٌ يُزِلُّ الصاعِدينَ وَيُزلِقُ",0,"ق",1,0],["أَبغي هَواهُ بِشافِعٍ مِن غَيرِهِ","شَرُّ الهَوى ما نِلتَهُ بِشَفيعِ",1,"ع",1,0],["أَبَغداذُ ما لي فيكَ نَهلَةُ شارِبٍ","مِنَ العَيشِ إِلّا وَالخَطوبُ مِزاجُها",2,"ج",3,0],["أَبغي الفؤادَ لديها","فما وجدتُ فؤادي",3,"ي",1,0],["أَبْغَي عُلاً رامَها جَدِّي فَأَدْرَكَها","وَكانَ في غَمْرَةِ الهَيْجاءِ يَنْغَمِسُ",4,"س",1,0],["أَبَغْداذُ كَمْ تُنْسيهِ نَجْداً وَأَهْلَهُ","أَلا خَابَ من يَشْري بِبغْدادِكُمْ نَجْدا",5,"د",2,0],["أَبغي الأَنيسَ فَلا أَرى لي مُؤنِساً","إِلّا التَرَدُدَ حَيثُ كُنتُ أَراكِ",6,"ك",1,0],["أَبْغِضْ بِهِ فِي العِدَى مِنْ هَادِمٍ حَنِقٍ","وَحَبَّذَا هُوَ التَّارِيخِ مِنْ بَانِ",7,"ن",1,0],["أَبْغِي الرِّثَّاءَ لَهُ فَيُبْرِقُ خَاطِرِي","حُزْناً وَلَكِنْ أَيْنَ صَوْبُ غَمَامِ",8,"م",1,0],["أَبغِض المالَ إِذا جَمَّعتَهُ","إِنَّ بُغضَ المالِ مِن حُبِّ العُلا",9,"ا",1,0],["أَبغَضُ ثَوبَيها إِلَيها الباقي","تَأكُلُ مِن كيسِ اِمرِئٍ وَرّاقِ",10,"ق",1,0],["أَبغي الوَفاءَ بِدَهرٍ لا وَفاءَ لَهُ","كَأَنَّني جاهِلٌ بِالدَهرِ وَالناسِ",11,"س",1,0],["أبِغَثِّ الكِياد تلقَى القوافي","كمُلاقي الجيوش في كالوز",12,"ز",1,0],["أبغضتَ من طَعِمَ الطَّعامَ فريقُه","سمٌّ لديك فما تُجاِمُل طاعما",13,"م",2,0],["أَبغي الشِفاءَ مِنَ الهُمومِ بِها","فَتُزيدُني وِقراً عَلى وَقرِ",14,"ر",1,0],["أَبغي الثَراءَ وَلَم يَكُن مِن مَطلَبي","وَأَرى الجَمالَ بِناظِرٍ مُتَعامِ",15,"م",1,0],["أَبغَضُ لِلعَينِ مِنَ الأَقذاءِ","أَثقَلُ مِن شَماتَةِ الأَعداءِ",16,"ا",2,0],["أُبَغّي بَني صَعبِ بنِ مُرٍّ بِلادَهُم","وَسَوفَ أُلاقيهِم إِن اللَهُ أَخَّرا",17,"ر",2,0],["أبغي العصاة بدافع من نفسهم","ام كان ذاك البغي بالايعاز",18,"ز",1,0],["أبغدادُ أنت الموطن الأوَّل الذي","به طاب في عهد الصبا لي صبابات",19,"ت",1,0],["أبغي نهاياتِ العُلى وسجيتي","تأبى التوسُّطَ فالتوسطُ هونُ",20,"ن",1,0],["أَبغي شَفيعاً إِلَيكَ أَو سَبَباً","عِندَكَ في الناسِ أَستَزيدُكَ بِه",21,"ب",2,0],["أَبغي مِنَ الدُنيا زِيادَتَها","وَزِيادَتي فيها هِيَ النَقصُ",22,"ص",1,0],["أَبغي الكَثيرَ إِلى الكَثيرِ مُضاعَفاً","وَلَوِ اِقتَصَرتُ عَلى القَليلِ كَفاني",23,"ي",1,0],["أبغي الهدوء ولا هدوء وفي","صدري عبابٌ غير مأمون",24,"ن",1,0],["أَبغَضوا عِزَّكُم وَوَدّوا نِداكُم","فَقَرَوكُم مِن بِغضَةٍ وَوِدادِ",25,"د",1,0],["أبغِضْ بها مُقَلاً قد أَشْبَهَتْ لَبَناً","طَفا الذُّبابُ عليهِ وهْوَ مَمْقولُ",26,"ل",1,0],["أَبغي دُنُوّاً إِلَيها","بِالجَهدِ مِنّي فَتَبعُد",27,"د",1,0],["أَبغَضتَني يا سَيِّدي","أَفديكَ حِبّاً مُبغِضا",28,"ض",2,0],["إِبْغِ لي عِنْدَكَ قَلْباً","طارَ مِنْ بَينِ ضُلوعِي",29,"ي",1,0],["أَبغي الحَقيقَة وَالحَقي","قةُ ما عَلَيها من غبار",30,"ر",1,0],["أَبْغِي بَيَاناً لِمَا يُخَامِرُنِي","مِنْهَا وَمَالِي فِي أَنْ أُبِينَ يَدُ",31,"د",1,0],["أَبْغِي الذَّهَابَ فَفِيمَ أُحْ","رَمُهُ وَيَسْتَعْصِي الذَّهَابُ",32,"ب",1,0],["أبغير مجد بني نزارَ ويعربِ","يُزهى عراقيِّ، ويفخر شامي؟",33,"م",2,0],["أبغصن زيتون يجا","زَى أم بصَارم الانتقام؟",34,"م",1,0],["أبغدادُ وهي القحمةُ السِنِّ خِبرةً","تَلَهَّى بألعابٍ كطفلٍ مُحمَّق",35,"ق",1,0],["أبغي المسائلَ محضةً ويعوُقني","عن ذلكم ، سببٌ من الأسباب",36,"ب",1,0],["\" أبغدادُ \" اذكري كم من دموع","أزارتكِ الصبابةَ والغليلا",37,"ل",2,0],["أَبْغُضُ المَالَ إذا جَمّعتُهُ إنَّ بغضَ المالِ من حبَّ العلا","إنما العَيْشُ خِلاَلٌ خَمْسَة ٌ حَبَّذَا تِلكَ خِلاَلاً حَبَّذا",38,"ا",1,0],["أبْغَضْتُ فيهِ أحِبَّتي","وقليتُ أهلي والوطنْ",39,"ن",1,0],["أَبَغْدادُ كَمْ تُنْسيهِ نَجْداً وَأَهْلَهُ","أَلا خَابَ من يَشْري بِبغْدادِكُمْ نَجْدا",40,"د",2,0]]}