{"poems":[[55,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[53,"لهوت عن وصف الطلول الدارسه","https://www.aldiwan.net/poem64573.html","الرجز"],[47,"ما لذا الظبي لاينال إقتناصه","https://www.aldiwan.net/poem64618.html","الخفيف"],[47,"وعدت برذونا فرددتني","https://www.aldiwan.net/poem66686.html","السريع"],[82,"نثر الجو على الأرض برد","https://www.aldiwan.net/poem31499.html","الرمل"],[50,"يا مبيح الدمع في الطلل","https://www.aldiwan.net/poem64995.html","المديد"],[189,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[228,"غلواء ما أحلى المعطارا","https://www.aldiwan.net/poem39711.html","الرجز"],[333,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[385,"يا رياح الفجر من نحو الحمى","https://www.aldiwan.net/poem48786.html","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63801","البسيط"],[868,"","https://poetry.dctabudhabi.ae/diwan/poem/177868","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120021","الرمل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109039","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52084","الخفيف"],[2129,"","https://poetry.dctabudhabi.ae/diwan/poem/111101","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27181","الرجز"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216578",""],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123937","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85205","الخفيف"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59480","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114052","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127242","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52204","السريع"],[4724,"ماس وغصونه مواريجي","https://www.poetsgate.com/ViewPoem.aspx?id=25792",""],[4578,"قلبٌ بنار الأسى والوجد حرانُ","https://www.poetsgate.com/ViewPoem.aspx?id=49529",""],[5232,"قرية النور","https://www.poetsgate.com/ViewPoem.aspx?id=212235",""],[5431,"لو...لو ...لو","https://www.poetsgate.com/ViewPoem.aspx?id=199908",""],[470,"بعد فوات الأوان","https://www.poetsgate.com/ViewPoem.aspx?id=178099",""],[5829,"إنما الله غفور","https://www.poetsgate.com/ViewPoem.aspx?id=171624",""],[6142,"حملته أم المعادنِ في أحشا","https://www.poetsgate.com/ViewPoem.aspx?id=155689",""]],"verses":[["لَو لَوى عَنكَ رائِعَ الخَطبِ ذَبٌّ","أَو رَمَت دونَكَ الحِمامَ يَدانِ",0,"ن",1,0],["لؤلؤةُ الطَّلِّ عليها قارسه","وخُرَّمٌ في صبغة الطيالسه",1,"س",2,0],["لُؤلُؤٌ أُعطِيَ النَفاسَةَ حَتّى","أُعطيتَ فَوقَ حَكمِها غُوّاصُه",2,"ص",2,0],["لُؤلُؤَةٌ تَضحَكُ أَرجاؤُها","تَحسُنُ في البَذلَةِ وَالصَونِ",3,"ن",1,0],["لؤلؤٌ أصْدافُهُ السُّحْبُ التي","أنْجَزَ البارقُ منها ما وَعَد",4,"د",1,0],["لُؤلُؤاتٍ يَنحَدِرنَ بِها","كَانحِدارِ الدَمعِ في عَجَلِ",5,"ل",1,0],["لؤلؤٌ اَصْغرُه أَفْخَرُه","جلَّ في السِّلكِ وإنْ لم يُثْقَب",6,"ب",1,0],["لُؤلُؤَةُ العُروشِ وَالتيجانِ","وَمَطمَحُ اليونانِ وَالرومانِ",7,"ن",1,0],["لؤلؤيُّ الألفاظ لا يتصبّا","ه ضجيج البهارج الزائفات",8,"ت",1,0],["لُؤلؤٌ أَحكمهُ مِن نَظَما","وَيُسَمى بَرداً وَهُوَ حَبب",9,"ب",1,0],["لؤلؤةٌ حَشْوُها عقيقٌ","من فوقها لؤلؤٌ صغار",10,"ر",1,0],["لؤلؤتا بحر وغن شئت قل","ياقوتتا نحر وعقدا لبان",11,"ن",1,0],["لؤلؤى المبسم الوا","ضح خوطيّ القوام",12,"م",1,0],["لؤلؤ هامت البحار به","حبًّا وخافت عليه عينَ الحسان",13,"ن",1,0],["لؤلؤٌ نادِرٌ ودُرٌّ يتيمٌ","وعقودٌ من فاتِنِ المُرجانِ",14,"ن",1,0],["لؤلُؤاً سِلْكُهُ المَسَامِعُ لَكِنْ","طَوَّقَ الرُّوحَ مِنهُ طَوقُ الحَمَامهْ",15,"م",2,0],["لؤلؤاً يلتقيان","فاق في العشاق ذكري",16,"ي",1,0],["لُؤلُؤَةٌ مَكنونَةٌ في صَدَفٍ","مِن شَعَرٍ مِثلِ سَوادِ السَبَجِ",17,"ج",1,0],["لُؤلُؤَةٌ غَوّاصُها الفِكرُ فَما","تَنفَكُّ في أَغوارِ تِلكَ اللُجَجِ",17,"ج",1,0],["لو لو لو لولا التّأنّي","والمِسْتِحَى لا نْشَعْك بالإيد",18,"د",1,0],["لؤلؤ أنت قد صفا","فحكاه لنا الصدف",19,"ف",1,0],["لؤلؤ في انحداره في انتثار","وهو حال ارتفاعه في انتظام",20,"م",1,0],["لؤلؤَّيات الثَّنايا شُمّس","ناعمات عنبرَّياتُ العَرقْ",21,"ق",1,0],["لُؤلُؤٌ مَكنُونٌ نَفِيسٌ إِذَا مَا","أبرَزَتهُ فِي جِيدِهَا حَسنَاءُ",22,"ا",2,0],["لَوَلَّوا وَلَكِن أَتَى هَكطُرا","وَأَنيَاسَ يَبغِيهِما مُنذِرا",23,"ر",2,0],["لؤلؤ معدنه عذب فرات","وهو لا يصفر من طول الدوام",24,"م",1,0],["لؤلؤةُ الشوفينِ دارُ السنا","هلَّ بأفق عُلاها هلالْ",25,"ل",1,1],["لؤلؤي ما به تعرفيجي","عيطليّن صورته فتنة",26,"ن",2,0],["لؤلؤ الثغر منهُ كنت ذا فرح","فالآن دمعي أيا ياقوت مرجان",27,"ن",1,0],["لؤلؤٌ من عقدهاِ","فوقَ صدرِ المنحنى",28,"ا",1,0],["لو...(لو)...أصيرُ بحسّه وبنبضه","بين الحشا وبرعشةٍ أتشخصُ",29,"ص",1,0],["لو... لو تلفَتَّ يوماً.. لو رفعتَ","ولو صراخَ جرحِكَ يوماً عندما تُصمى",30,"م",2,0],["لؤلؤات كالثريا","بارزات كالبدور",31,"ر",1,0],["لولوج الحياة في الجسم للإد","راك للسمع للكلام المفيد",32,"د",1,0]]}