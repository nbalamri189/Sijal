36032",""],[5818,"حمامات الحرم","https://www.poetsgate.com/ViewPoem.aspx?id=177754",""],[5853,"((غيمٌ بلا مخاض))","https://www.poetsgate.com/ViewPoem.aspx?id=175650",""],[5953,"أيصحو فؤادي والفراق عظيم","https://www.poetsgate.com/ViewPoem.aspx?id=93865",""],[5956,"أ يصبح أولويّاً في انتشالي","https://www.poetsgate.com/ViewPoem.aspx?id=204460",""],[6023,"ماذا يقول مُفَوهٌ في وصف ما","https://www.poetsgate.com/ViewPoem.aspx?id=123866",""],[6102,"لا كرامة لنبي في قومه ..","https://www.poetsgate.com/ViewPoem.aspx?id=186289",""],[6118,"عودة الشراع","https://www.poetsgate.com/ViewPoem.aspx?id=12625",""],[6124,"يا ابنة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=101248",""],[6142,"بديع كون تحلى بالوجود طلى","https://www.poetsgate.com/ViewPoem.aspx?id=155673",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[6302,"رَجَاحَهْ ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86239&r=&rc=37",""],[6356,"آخرُ شموعِ الخريفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81908&r=&rc=9",""],[4890,"أرض الغياب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72998&r=&rc=200",""]],"verses":[["أَيَصرَعُني الزَمانُ وَلَستُ آوي","إِلى جَنبٍ ذَليلٍ لِلصِراعِ",0,"ع",1,0],["أَيُصاحُ بي عَن كُلِّ صافِيَةٍ","طَرداً إِلى الأَقذاءِ وَالثَمَدِ",1,"د",1,0],["أَيَصْلُحُ مُجْتَمَعٌ لَيْسَ فِيهِ","لِمَنْ يَسْتَعِينُ بِهِ مِنَ مُعِينْ",2,"ن",1,0],["أَيَصُح حِكْمٌ مِثْلَمَا صَححْتَهُ","وَيَكُونُ فِي الوَطَنِ السَّوَادُ سَقِيمَا",3,"م",2,0],["أيصبح في سياسته طليقاً","أسير أوجب الفقر احتباسه",4,"ه",1,0],["أيصونُ المال للولدِ","ثم يُبقيه حِذار غدِ",5,"د",1,0],["أي صُلْحٍ رأيتَهُ واتفاقٍ","بين هذين يا أخا التمويه",6,"ي",2,0],["أيصفع مثلي ناشئ ويراعتي","أسالت دموع القوم في مصر عَندما",7,"م",2,0],["أَيُصبِحُ وِردِيَ في ساحَتَي","كَ طَرقاً وَمَرعايَ مَحلاً جَديبا",8,"ب",2,0],["أيُّ صوتٍ من الغيوب ينادي","ني فأطوي له الدُّنَى والمعالم",9,"م",1,0],["أَيُصبحُ قلبي بالأَسى غيرَ ذائبٍ","وقلبُ الثَرى قاسٍ على قلبها الرّطبِ",10,"ب",1,0],["أَيصيحُ صائحكم بما","يؤذيهِ من قالٍ وقيلْ",11,"ل",1,0],["أَيُصاغُ الفُؤادُ بَعدَ نُهاهُ","مِن صَفاةٍ صَمّاءَ أَو مِن حَديدِ",12,"د",1,0],["أَيُّ صَفاةٍ لا يُرى دَهرَها","يُجيدُ في مُدَّتِهِ نَحتَها",13,"ت",3,1],["أَيُصِرُّ الخَمرَ في أَخلافِها","حالِبٌ يَحتَلِبُ الغاوي المُصِر",14,"ر",1,0],["أيْ صَباً أيَّ صِباً هِجْتِ لنا","سَحَراً من أينَ ذَيّاكَ الشُّذَي",15,"ي",1,0],["أيصبحُ الإنسانُ هذا الرميمْ","والجيفةَ الملقاةَ نهبَ الترابْ",16,"ب",1,0],["أَيُّ صَرْحٍ حَلَّ فِيهِ","ذَلِكَ الخَطْبُ المُلِمُّ",17,"م",1,1],["أَيُصْيِبك الجَمَالُ فَأَيُّ حُسْنٍ","شَهِدْتَ مِثَالَهُ وَلَهُ مَثِيلُ",18,"ل",1,0],["أَيْ صَائِدَ اللَّيْثِ الْهَصُورِ بِغَابَةٍ","أَتُرَى وَجَدْتَ هُنَا كِنَاسَ غَزَالِ",19,"ل",1,0],["أَيَصْدُقُ كُلَّ الصِّدْقِ مَا هُوَ مُوعِدٌ","وَيَكْذِبُ كُلَّ الكِذْبِ مَا هُوَ وَاعِدُ",20,"د",1,0],["أَيْ صَاحِبَيَّ لَقَدْ قَضَى","أُسْتَاذُنَا البَرُّ الحَبِيبُ",21,"ب",1,0],["أَيُّ صَرْحٍ مُمَرَّدٍ دَكَّهُ رَيْ","بُ المَنَايَا وَأَيُّ حِصْنٍ وَطِيدِ",22,"د",1,0],["أَيَّ صَبرٍ عَنكَ أَقوى","وَمحَلّي مِنكَ أَقوى",23,"و",2,1],["أيصدني نهد تعبت برسمه","وتخونني الأقراط والأثواب",24,"ب",1,0],["أَيُصَاغُ الْفُؤَادُ بَعْدَ نُهَاهُ","من صفاءٍ صماء أو من حديد",25,"د",1,0],["أيصنع المرء أصناماً ويعبدها","هذا هو الزور والبهتان والكذب",26,"ب",1,0],["أيصْلَدُ بعد طول القدح زَندي","ولم يصْلَدْ لمن رجَّاك زَنْدُ",27,"د",1,0],["أيصيبنِي ظَمأٌ وسيبُ نوالِهِ","متتابعٌ كالوابلِ الهتّانِ",28,"ن",1,0],["أَيُصبِحُ حَظّي فيكُمُ وَهوَ ناقِصٌ","وَتَغدُو حُظوظُ الغَيرِ أَوفى وَأَكمَلا",29,"ل",2,0],["أَيُّ صَدرٍ أَحَنَّ مِن صَدرِ أُختٍ","في لَيالي الأَسى وَأَسمى شُعورا",30,"ر",2,0],["أَيُصيخُ لي المَلِكَ الهُمامُ قَليلا","إن قُلتُ صَبراً مرَّةً فَأَقولا",31,"ل",2,1],["أَيُّ صَوتٍ حَيَّتهُ بِالأَمسِ باري","سُ مقرُّ العلومِ والعلماءِ",32,"ا",2,1],["أَيُّ صَونٍ وَجَمالٍ وَتُقىً","وَحَياءٍ جُمِعَت في مَلحَدِ",33,"د",1,0],["أَيَصُدُّنِي عَنْ نَشْوَتِي بِخِطَابِكُمْ","وَهْوَ الْمُنَى رُودٌ زَهَتْ وَلَبُوسُ",34,"س",1,0],["أَيَصْعَدُ عائِداً فِي السُّحْبِ قَطْرٌ","تَنَزَّلَ فِي الوَهادِ بهِ الرِّهامُ",35,"م",1,0],["أَيُصبِحُ ذاكَ العَهد للشمل جامِعاً","فَيَخبو جَوىً بين الجَوانح ذو وَقدِ",36,"د",1,0],["أَيصحو عاشقٌ أَم يستفيقُ","لأَصحوَ أم ترى يسلو مشوقُ",37,"ق",1,1],["أيصبر متبولُ الفؤادِ كثيبُ","وَترحاله عمن يخبُّ قريبُ",38,"ب",1,1],["أيصبيك منه يا أخا الوجد ناظرٌ","مهنده ماض فقلت وسالف",39,"ف",1,0],["أَيُّ صِنديدَ أَو نَبي كَرا","أَبدَلَ الناسَ مِلَّةً بِالأُخرى",40,"ر",2,0],["أَيُّ صَبٍّ يَقوى عَلى ما أُقاسي","مِن هَوان الهَوى بِدون مَلاله",41,"ل",2,0],["أَيّ صَبٍّ عَن مَحبّتهِ","يَنثَني وَالصَبر مَفقودُ",42,"د",1,0],["أيصد عن مولاه عبدٌ مُقترٌ","أغناه سيده وهوْ مخذول",43,"ل",1,0],["أي صاحبيَّ قفا بديرٍ جئته","فرداً وهوْ في كل صقعٍ مُفرد",44,"د",1,0],["أيّ صبٍّ تركتمُ ساعةَ البينِ","يُطِلُ الدّموع سجلاً فسجلاَ",45,"ل",2,0],["أيصدّكمْ عَنْها أُناسٌ ما لَهُمْ","قَدمٌ إلى العَلْيا تَسيرُ",46,"ر",1,0],["أيصح تجويز القبيح لمسلم","إني أرى تنزيهه مدخولا",47,"ل",2,0],["أي صلاة بطلت","من أجل ستر العورة",48,"ه",1,1],["أيّ صبر يكون للدّنِف الها","ئمِ ذي الوجدِ والحشا الخفّاقِ",49,"ق",1,0],["أي صدق هذا الذي أعلن","الكذب تبنيه واشتهى طرفه",50,"ف",2,0],["أي صديقي كفاكَ وعظاً ووعظاً","وحذارِ الفداءَ يوماً حذارِ",51,"ر",1,0],["أي صادٍ ما بلًّ منها غليلاً","وسقيمٍ بلطفها ما أبلاَّ",52,"ل",2,0],["أيصبح عنّي أفلاً بعد ما قضى","لهُ سهري أن لا يكون أفول",53,"ل",1,0],["أيُّ صبرٍ يومَ تنأَى بهمُ","عيسُهمْ ينأَى عنِ الصبَّ المولَّه",54,"ل",2,0],["أَيَصْرَعُني الزَّمانُ ولي عِنانٌ","بحبلِ جَنابِهِ سامي العِنَانِ",55,"ن",1,0],["أَيَصبِرُ عاشِقٌ هَجَرَ الحَبيبا","أُجِنَّ فُؤادُهُ شَوقاً عَجيبا",56,"ب",2,0],["أَيُّ صَبٍّ قَدْ غَادَرَ الوَجْدُ مِنْهُ","مُسْتَقَرّاً بِقَلْبِهِ وَمُقَامَا",57,"م",2,0],["أيصح ان القطر يا اهل النهى","يغدو بها نحو التقهقر سائرا",58,"ر",2,0],["أيُصبحُ عن أوطانهِ البدر غائباً","وكيفَ هلالُ السعد في اللحد يغربُ",59,"ب",1,0],["أيُصبح عن أوطانه البدر غائباً","فكيفَ هلالُ الشرق في الغرب يغربُ",60,"ب",1,0],["أيُّ صدرٍ يحوي الكنوز كصدري","ويُريكَ الجمان فيه نضيدا",61,"د",2,0],["أيصبح قلب قومي مستقر","وقلب الحق معتل وجيب",62,"ب",1,0],["إِيصال عَيش ذُوي العَفا","لاحَت بِذاك أَمائر",63,"ر",1,0],["أَيصحُّ جسمٌ للجشاني بَعدَما","أَسلمتَه رغماً لِمَن لَم يُحسنا",64,"ن",2,0],["أَي صبح عرفت فيهِ نَبيّاً","نُوره يَزدري بِبَدر التَمام",65,"م",1,0],["أيصفو لكم ماء تصفقه الصبا","ويصفق مني الكف بالكف صافق",66,"ق",1,0],["أيُّ صبٍّ حال عن حُبِّ الحَسَنْ","فَاِضرِبوا فيهِ بِسَيفٍ لعَلي",67,"ي",1,0],["أَيُّ صَبرٍ لِمُغرَمٍ مَعروفِ","بِغَرامٍ وَبِالهَوى مَشغوفِ",68,"ف",1,1],["أَيُّ صَبٍّ يَعيشُ بَينَ اِغترابٍ","وبعادٍ وجفوةٍ وصدودِ",69,"د",1,0],["أيصبرُ عن نجد فُؤاد متّيم","وتُنسى ليال بالمصلى وتُكفر",70,"ر",1,0],["أي صدر هو لوكا","ن على جذع مقسى",71,"س",2,0],["أيصِحُّ تَوحيدٌ بغير ولائه","وولاؤه لكتابه عُنْوانُه",72,"ن",2,0],["أَي صَبر لعَميد قَلبه","أَقصدته صائِبات الحدق",73,"ق",1,0],["أيصيبني صرف الزمان وأنت لي","جار, وبابك مَعرجي ومُعرَّجي",74,"ج",2,0],["أيصفو العيش في الدنيا بحال","لشخص وهو منقطع القرين",75,"ن",1,1],["أيّ صبٍّ لم يؤرّقْ جفنَه","خفَقانُ البرقِ لما طلَعا",76,"ع",2,0],["أَي صاح إِن رُمت النَجاح فَعِج إِلى","ذاكَ الجَناب المُستَطاب وَيَمم",77,"م",1,0],["أَي صَبَّ صَبَّ مثلي مَدمَعاً","في هَواكُم ثُمَ قاسى المَنصِبا",78,"ب",2,0],["أيُصبح فيكم بلا عاضد","وصيُّ الرسول ولا وازرِ",79,"ر",1,0],["أيصان ملك أهله في غرّة","أقصى مناهم راحة وحمام",80,"م",1,0],["أيصبح القرآن ألعوبة","بكف أولاد الخنا والسفاح",81,"ح",1,0],["أي صب تأبى الأحبة لقيا","ه وعن عذل عاذل واباها",82,"ا",3,0],["أي صيدٍ من مُشكلات النهى لم","يَصِدَن إن رمى اليه سِهامَه",83,"م",2,0],["أيصبر ذو عقل لفرقة أحمد","فلا والذي من قاب قوسين أدناه",84,"ن",3,0],["أيُّ صَدرٍ في الزمان لنا","بعد صدر الدين ينشرحُ",85,"ح",1,0],["أي صدر بنعلة قد رقاها","أي نحر بنصله قد فراها",86,"ا",3,0],["أي صنم يجلو التهم","وبالعلم دون إضم",87,"م",1,0],["أي صِيدٍ مضوا حميدين كالغي","ث وابْقَوْا ما راق من غدرانه",88,"ن",2,0],["أيَصيرُ أهلُ الخُلدِ في جَنَّاتهم","وجَحِيمِهِم كحِجَارَةِ البُنيَانِ",89,"ن",1,0],["أيصِحُّ فِي عَقلٍ وَفِي نَقلٍ نِدَا","ءٌ لَيسَ مَسمُوعاً لَنَا بأذَانِ",89,"ن",1,0],["أيَصِحُّ وَصفُ الشَّيءِ بالمشتَقِّ لل","مَسلُوبِ مَعنَاهُ لِذِي الأذهَانِ",89,"ن",1,0],["أيَصِحّ