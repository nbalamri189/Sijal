{"poems":[[53,"طلاب العز من شيم الشجاع","https://www.aldiwan.net/poem30155.html","الوافر"],[53,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[93,"مددت طرافك للائدين","https://www.aldiwan.net/poem11200.html","المتقارب"],[93,"يا من تحيي مصر عالي شأنه","https://www.aldiwan.net/poem11294.html","الكامل"],[88,"أتى من مصر طلعتها بن حرب","https://www.aldiwan.net/poem44397.html","الوافر"],[51,"لا أزال اللَّه نعمته","https://www.aldiwan.net/poem61963.html","المديد"],[51,"شهر نسك قرينه يوم لهو","https://www.aldiwan.net/poem66715.html","الخفيف"],[85,"لقد نقل الراوون عني حكاية","https://www.aldiwan.net/poem7570.html","الطويل"],[45,"لوت بالسلام بنانا خضيبا","https://www.aldiwan.net/poem10668.html","المتقارب"],[97,"أنا وحدي في البيد حيران هائم","https://www.aldiwan.net/poem24927.html","الخفيف"],[80,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[105,"يا قوم ما ذنب الرئيس","https://www.aldiwan.net/poem42136.html","مجزوء الكامل"],[50,"راح صحبي وبت للموعود","https://www.aldiwan.net/poem63873.html","الخفيف"],[46,"أي صفاة لا يرى دهرها","https://www.aldiwan.net/poem22181.html","السريع"],[46,"قصر اليوم بكأس كاس من","https://www.aldiwan.net/poem22741.html","الرمل"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55123","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[50,"رَاحَ صَحْبِي وَبِتُّ لِلْمَوْعُودِ","https://www.poetsgate.com/ViewPoem.aspx?id=22568",""],[103,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[129,"أأخاف من ريب الزمان وصرفه","https://www.aldiwan.net/poem50492.html","الكامل"],[170,"أقيما على حر المدى أو ترحلا","https://www.aldiwan.net/poem1649.html",""],[224,"تسأل الغيب أن يريها المصيرا","https://www.aldiwan.net/poem41609.html","الخفيف"],[226,"أَيصيخ لي الملك الهمام قليلا","https://www.aldiwan.net/poem55085.html","الكامل"],[226,"أي صوت حيته بالأمس باريس","https://www.aldiwan.net/poem55196.html","الخفيف"],[236,"أي نار ضرمت في كبدي","https://www.aldiwan.net/poem32094.html","الرمل"],[238,"ربع المودة بالحشا مأنوس","https://www.aldiwan.net/poem19705.html","الكامل"],[281,"متى ارتجعت مواهبها الكرام","https://www.aldiwan.net/poem60717.html","الوافر"],[298,"تذكر والذكرى تهيج أخا الوجد","https://www.aldiwan.net/poem33290.html","الطويل"],[299,"أيصحو عاشق أم يستفيق","https://www.aldiwan.net/poem36284.html","عموديه"],[299,"أيصبر متبول الفؤاد كثيب","https://www.aldiwan.net/poem36324.html","عموديه"],[304,"يقول لي العذال لما عشقته","https://www.aldiwan.net/poem57570.html","الطويل"],[321,"أي وقت وأي هائل طقس","https://www.aldiwan.net/poem61667.html","الخفيف"],[354,"ما ترى البدر حين حاز كماله","https://www.aldiwan.net/poem40002.html","الخفيف"],[354,"منهل العشاق مورود","https://www.aldiwan.net/poem40392.html","المديد"],[378,"قدك البعاد فهل إليك سبيل","https://www.aldiwan.net/poem59293.html","الكامل"],[378,"قالت إليك فقلت طرفي أرمد","https://www.aldiwan.net/poem66873.html","الكامل"],[403,"طالع اليمن بالوصال استهلا","https://www.aldiwan.net/poem46915.html","الخفيف"],[403,"كم ذا يذوب أسى وكم يتجلد","https://www.aldiwan.net/poem46938.html","الكامل"],[404,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[404,"أي صلاة بطلت","https://www.aldiwan.net/poem34098.html","مجزوء الرجز"],[433,"ما لمن في الهوى من خلاق","https://www.aldiwan.net/poem12686.html","الخفيف"],[454,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[454,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[465,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[465,"خليلي من عليا دمشق سقيتما","https://www.aldiwan.net/poem3335.html","عموديه"],[478,"حي عني منحني الوادي وأثله","https://www.aldiwan.net/poem15200.html","الخفيف"],[501,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[554,"أحب الريح إن هبت شمالا","https://www.aldiwan.net/poem68381.html","الوافر"],[587,"ليت شعري من قد أحل الخياما","https://www.aldiwan.net/poem17744.html","الخفيف"]],"verses":[["أَيَصرَعُني الزَمانُ وَلَستُ آوي","إِلى جَنبٍ ذَليلٍ لِلصِراعِ",0,"ع",1,0],["أَيُصاحُ بي عَن كُلِّ صافِيَةٍ","طَرداً إِلى الأَقذاءِ وَالثَمَدِ",1,"د",1,0],["أَيَصْلُحُ مُجْتَمَعٌ لَيْسَ فِيهِ","لِمَنْ يَسْتَعِينُ بِهِ مِنَ مُعِينْ",2,"ن",1,0],["أَيَصُح حِكْمٌ مِثْلَمَا صَححْتَهُ","وَيَكُونُ فِي الوَطَنِ السَّوَادُ سَقِيمَا",3,"م",2,0],["أيصبح في سياسته طليقاً","أسير أوجب الفقر احتباسه",4,"ه",1,0],["أيصونُ المال للولدِ","ثم يُبقيه حِذار غدِ",5,"د",1,0],["أي صُلْحٍ رأيتَهُ واتفاقٍ","بين هذين يا أخا التمويه",6,"ي",2,0],["أيصفع مثلي ناشئ ويراعتي","أسالت دموع القوم في مصر عَندما",7,"م",2,0],["أَيُصبِحُ وِردِيَ في ساحَتَي","كَ طَرقاً وَمَرعايَ مَحلاً جَديبا",8,"ب",2,0],["أيُّ صوتٍ من الغيوب ينادي","ني فأطوي له الدُّنَى والمعالم",9,"م",1,0],["أَيُصبحُ قلبي بالأَسى غيرَ ذائبٍ","وقلبُ الثَرى قاسٍ على قلبها الرّطبِ",10,"ب",1,0],["أَيصيحُ صائحكم بما","يؤذيهِ من قالٍ وقيلْ",11,"ل",1,0],["أَيُصاغُ الفُؤادُ بَعدَ نُهاهُ","مِن صَفاةٍ صَمّاءَ أَو مِن حَديدِ",12,"د",1,0],["أَيُّ صَفاةٍ لا يُرى دَهرَها","يُجيدُ في مُدَّتِهِ نَحتَها",13,"ت",3,1],["أَيُصِرُّ الخَمرَ في أَخلافِها","حالِبٌ يَحتَلِبُ الغاوي المُصِر",14,"ر",1,0],["أيْ صَباً أيَّ صِباً هِجْتِ لنا","سَحَراً من أينَ ذَيّاكَ الشُّذَي",15,"ي",1,0],["أيصبحُ الإنسانُ هذا الرميمْ","والجيفةَ الملقاةَ نهبَ الترابْ",16,"ب",1,0],["أَيُّ صَرْحٍ حَلَّ فِيهِ","ذَلِكَ الخَطْبُ المُلِمُّ",17,"م",1,1],["أَيُصْيِبك الجَمَالُ فَأَيُّ حُسْنٍ","شَهِدْتَ مِثَالَهُ وَلَهُ مَثِيلُ",18,"ل",1,0],["أَيْ صَائِدَ اللَّيْثِ الْهَصُورِ بِغَابَةٍ","أَتُرَى وَجَدْتَ هُنَا كِنَاسَ غَزَالِ",19,"ل",1,0],["أَيَصْدُقُ كُلَّ الصِّدْقِ مَا هُوَ مُوعِدٌ","وَيَكْذِبُ كُلَّ الكِذْبِ مَا هُوَ وَاعِدُ",20,"د",1,0],["أَيْ صَاحِبَيَّ لَقَدْ قَضَى","أُسْتَاذُنَا البَرُّ الحَبِيبُ",21,"ب",1,0],["أَيُّ صَرْحٍ مُمَرَّدٍ دَكَّهُ رَيْ","بُ المَنَايَا وَأَيُّ حِصْنٍ وَطِيدِ",22,"د",1,0],["أَيَّ صَبرٍ عَنكَ أَقوى","وَمحَلّي مِنكَ أَقوى",23,"و",2,1],["أيصدني نهد تعبت برسمه","وتخونني الأقراط والأثواب",24,"ب",1,0],["أَيُصَاغُ الْفُؤَادُ بَعْدَ نُهَاهُ","من صفاءٍ صماء أو من حديد",25,"د",1,0],["أيصنع المرء أصناماً ويعبدها","هذا هو الزور والبهتان والكذب",26,"ب",1,0],["أيصْلَدُ بعد طول القدح زَندي","ولم يصْلَدْ لمن رجَّاك زَنْدُ",27,"د",1,0],["أيصيبنِي ظَمأٌ وسيبُ نوالِهِ","متتابعٌ كالوابلِ الهتّانِ",28,"ن",1,0],["أَيُصبِحُ حَظّي فيكُمُ وَهوَ ناقِصٌ","وَتَغدُو حُظوظُ الغَيرِ أَوفى وَأَكمَلا",29,"ل",2,0],["أَيُّ صَدرٍ أَحَنَّ مِن صَدرِ أُختٍ","في لَيالي الأَسى وَأَسمى شُعورا",30,"ر",2,0],["أَيُصيخُ لي المَلِكَ الهُمامُ قَليلا","إن قُلتُ صَبراً مرَّةً فَأَقولا",31,"ل",2,1],["أَيُّ صَوتٍ حَيَّتهُ بِالأَمسِ باري","سُ مقرُّ العلومِ والعلماءِ",32,"ا",2,1],["أَيُّ صَونٍ وَجَمالٍ وَتُقىً","وَحَياءٍ جُمِعَت في مَلحَدِ",33,"د",1,0],["أَيَصُدُّنِي عَنْ نَشْوَتِي بِخِطَابِكُمْ","وَهْوَ الْمُنَى رُودٌ زَهَتْ وَلَبُوسُ",34,"س",1,0],["أَيَصْعَدُ عائِداً فِي السُّحْبِ قَطْرٌ","تَنَزَّلَ فِي الوَهادِ بهِ الرِّهامُ",35,"م",1,0],["أَيُصبِحُ ذاكَ العَهد للشمل جامِعاً","فَيَخبو جَوىً بين الجَوانح ذو وَقدِ",36,"د",1,0],["أَيصحو عاشقٌ أَم يستفيقُ","لأَصحوَ أم ترى يسلو مشوقُ",37,"ق",1,1],["أيصبر متبولُ الفؤادِ كثيبُ","وَترحاله عمن يخبُّ قريبُ",38,"ب",1,1],["أيصبيك منه يا أخا الوجد ناظرٌ","مهنده ماض فقلت وسالف",39,"ف",1,0],["أَيُّ صِنديدَ أَو نَبي كَرا","أَبدَلَ الناسَ مِلَّةً بِالأُخرى",40,"ر",2,0],["أَيُّ صَبٍّ يَقوى عَلى ما أُقاسي","مِن هَوان الهَوى بِدون مَلاله",41,"ل",2,0],["أَيّ صَبٍّ عَن مَحبّتهِ","يَنثَني وَالصَبر مَفقودُ",42,"د",1,0],["أيصد عن مولاه عبدٌ مُقترٌ","أغناه سيده وهوْ مخذول",43,"ل",1,0],["أي صاحبيَّ قفا بديرٍ جئته","فرداً وهوْ في كل صقعٍ مُفرد",44,"د",1,0],["أيّ صبٍّ تركتمُ ساعةَ البينِ","يُطِلُ الدّموع سجلاً فسجلاَ",45,"ل",2,0],["أيصدّكمْ عَنْها أُناسٌ ما لَهُمْ","قَدمٌ إلى العَلْيا تَسيرُ",46,"ر",1,0],["أيصح تجويز القبيح لمسلم","إني أرى تنزيهه مدخولا",47,"ل",2,0],["أي صلاة بطلت","من أجل ستر العورة",48,"ه",1,1],["أيّ صبر يكون للدّنِف الها","ئمِ ذي الوجدِ والحشا الخفّاقِ",49,"ق",1,0],["أي صدق هذا الذي أعلن","الكذب تبنيه واشتهى طرفه",50,"ف",2,0],["أي صديقي كفاكَ وعظاً ووعظاً","وحذارِ الفداءَ يوماً حذارِ",51,"ر",1,0],["أي صادٍ ما بلًّ منها غليلاً","وسقيمٍ بلطفها ما أبلاَّ",52,"ل",2,0],["أيصبح عنّي أفلاً بعد ما قضى","لهُ سهري أن لا يكون أفول",53,"ل",1,0],["أيُّ صبرٍ يومَ تنأَى بهمُ","عيسُهمْ ينأَى عنِ الصبَّ المولَّه",54,"ل",2,0],["أَيَصْرَعُني الزَّمانُ ولي عِنانٌ","بحبلِ جَنابِهِ سامي العِنَانِ",55,"ن",1,0],["أَيَصبِرُ عاشِقٌ هَجَرَ الحَبيبا","أُجِنَّ فُؤادُهُ شَوقاً عَجيبا",56,"ب",2,0],["أَيُّ صَبٍّ قَدْ غَادَرَ الوَجْدُ مِنْهُ","مُسْتَقَرّاً بِقَلْبِهِ وَمُقَامَا",57,"م",2,0]]}