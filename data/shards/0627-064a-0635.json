{"poems":[[53,"طلاب العز من شيم الشجاع","https://www.aldiwan.net/poem30155.html","الوافر"],[53,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[93,"مددت طرافك للائدين","https://www.aldiwan.net/poem11200.html","المتقارب"],[93,"يا من تحيي مصر عالي شأنه","https://www.aldiwan.net/poem11294.html","الكامل"],[88,"أتى من مصر طلعتها بن حرب","https://www.aldiwan.net/poem44397.html","الوافر"],[51,"لا أزال اللَّه نعمته","https://www.aldiwan.net/poem61963.html","المديد"],[51,"شهر نسك قرينه يوم لهو","https://www.aldiwan.net/poem66715.html","الخفيف"],[85,"لقد نقل الراوون عني حكاية","https://www.aldiwan.net/poem7570.html","الطويل"],[45,"لوت بالسلام بنانا خضيبا","https://www.aldiwan.net/poem10668.html","المتقارب"],[97,"أنا وحدي في البيد حيران هائم","https://www.aldiwan.net/poem24927.html","الخفيف"],[80,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[105,"يا قوم ما ذنب الرئيس","https://www.aldiwan.net/poem42136.html","مجزوء الكامل"],[50,"راح صحبي وبت للموعود","https://www.aldiwan.net/poem63873.html","الخفيف"],[46,"أي صفاة لا يرى دهرها","https://www.aldiwan.net/poem22181.html","السريع"],[46,"قصر اليوم بكأس كاس من","https://www.aldiwan.net/poem22741.html","الرمل"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55123","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[50,"رَاحَ صَحْبِي وَبِتُّ لِلْمَوْعُودِ","https://www.poetsgate.com/ViewPoem.aspx?id=22568",""],[103,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""]],"verses":[["أَيَصرَعُني الزَمانُ وَلَستُ آوي","إِلى جَنبٍ ذَليلٍ لِلصِراعِ",0,"ع",1,0],["أَيُصاحُ بي عَن كُلِّ صافِيَةٍ","طَرداً إِلى الأَقذاءِ وَالثَمَدِ",1,"د",1,0],["أَيَصْلُحُ مُجْتَمَعٌ لَيْسَ فِيهِ","لِمَنْ يَسْتَعِينُ بِهِ مِنَ مُعِينْ",2,"ن",1,0],["أَيَصُح حِكْمٌ مِثْلَمَا صَححْتَهُ","وَيَكُونُ فِي الوَطَنِ السَّوَادُ سَقِيمَا",3,"م",2,0],["أيصبح في سياسته طليقاً","أسير أوجب الفقر احتباسه",4,"ه",1,0],["أيصونُ المال للولدِ","ثم يُبقيه حِذار غدِ",5,"د",1,0],["أي صُلْحٍ رأيتَهُ واتفاقٍ","بين هذين يا أخا التمويه",6,"ي",2,0],["أيصفع مثلي ناشئ ويراعتي","أسالت دموع القوم في مصر عَندما",7,"م",2,0],["أَيُصبِحُ وِردِيَ في ساحَتَي","كَ طَرقاً وَمَرعايَ مَحلاً جَديبا",8,"ب",2,0],["أيُّ صوتٍ من الغيوب ينادي","ني فأطوي له الدُّنَى والمعالم",9,"م",1,0],["أَيُصبحُ قلبي بالأَسى غيرَ ذائبٍ","وقلبُ الثَرى قاسٍ على قلبها الرّطبِ",10,"ب",1,0],["أَيصيحُ صائحكم بما","يؤذيهِ من قالٍ وقيلْ",11,"ل",1,0],["أَيُصاغُ الفُؤادُ بَعدَ نُهاهُ","مِن صَفاةٍ صَمّاءَ أَو مِن حَديدِ",12,"د",1,0],["أَيُّ صَفاةٍ لا يُرى دَهرَها","يُجيدُ في مُدَّتِهِ نَحتَها",13,"ت",3,1],["أَيُصِرُّ الخَمرَ في أَخلافِها","حالِبٌ يَحتَلِبُ الغاوي المُصِر",14,"ر",1,0],["أيْ صَباً أيَّ صِباً هِجْتِ لنا","سَحَراً من أينَ ذَيّاكَ الشُّذَي",15,"ي",1,0],["أيصبحُ الإنسانُ هذا الرميمْ","والجيفةَ الملقاةَ نهبَ الترابْ",16,"ب",1,0],["أَيُّ صَرْحٍ حَلَّ فِيهِ","ذَلِكَ الخَطْبُ المُلِمُّ",17,"م",1,1],["أَيُصْيِبك الجَمَالُ فَأَيُّ حُسْنٍ","شَهِدْتَ مِثَالَهُ وَلَهُ مَثِيلُ",18,"ل",1,0],["أَيْ صَائِدَ اللَّيْثِ الْهَصُورِ بِغَابَةٍ","أَتُرَى وَجَدْتَ هُنَا كِنَاسَ غَزَالِ",19,"ل",1,0],["أَيَصْدُقُ كُلَّ الصِّدْقِ مَا هُوَ مُوعِدٌ","وَيَكْذِبُ كُلَّ الكِذْبِ مَا هُوَ وَاعِدُ",20,"د",1,0],["أَيْ صَاحِبَيَّ لَقَدْ قَضَى","أُسْتَاذُنَا البَرُّ الحَبِيبُ",21,"ب",1,0],["أَيُّ صَرْحٍ مُمَرَّدٍ دَكَّهُ رَيْ","بُ المَنَايَا وَأَيُّ حِصْنٍ وَطِيدِ",22,"د",1,0],["أَيَّ صَبرٍ عَنكَ أَقوى","وَمحَلّي مِنكَ أَقوى",23,"و",2,1],["أيصدني نهد تعبت برسمه","وتخونني الأقراط والأثواب",24,"ب",1,0],["أَيُصَاغُ الْفُؤَادُ بَعْدَ نُهَاهُ","من صفاءٍ صماء أو من حديد",25,"د",1,0],["أيصنع المرء أصناماً ويعبدها","هذا هو الزور والبهتان والكذب",26,"ب",1,0],["أيصْلَدُ بعد طول القدح زَندي","ولم يصْلَدْ لمن رجَّاك زَنْدُ",27,"د",1,0]]}