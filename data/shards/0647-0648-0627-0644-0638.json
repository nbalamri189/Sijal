{"poems":[[75,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[47,"هو الظلام فلا صبح ولا شفق","https://www.aldiwan.net/poem65179.html","البسيط"],[107,"جمعن المشارق في المؤتمر","https://www.aldiwan.net/poem42051.html","المتقارب"],[445,"أهلي قد أنى لك أن تهلي","https://www.aldiwan.net/poem34788.html","الوافر"],[473,"لنا سكن لم يسكن الشعر خده","https://www.aldiwan.net/poem60200.html","الطويل"],[563,"هو الوارد القدسي كالسيل يحطم","https://www.aldiwan.net/poem33881.html","الطويل"],[563,"أزال عن الوجه الجميل قناعه","https://www.aldiwan.net/poem34366.html","الطويل"],[567,"أتدري ما بقلبك من جراح","https://www.aldiwan.net/poem52911.html","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64542","الطويل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102322","الطويل"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103202","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53115","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27624","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76096","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93822","الوافر"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71321","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48420","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48329","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86293","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85122","الطويل"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105151","الطويل"],[835,"رأى اللوم من كل الجهات فراعه","https://www.poetsgate.com/ViewPoem.aspx?id=40616",""]],"verses":[["هُوَ الظافِرُ الأَعلى المُؤَيَّدُ بِالَّذي","لَهُ في الَّذي وَلّاهُ مِن صُنعِهِ سِرُّ",0,"ر",1,0],["هُوَ الظَلامُ فَلا صُبحٌ وَلا شَفَقُ","هَل يُطلِقُ اللَيلُ مِن طَرفي فَأَنطَلِقُ",1,"ق",1,1],["هو الظُّلمُ هَيَّجَ كلّ القُوَى","فما تستكنُّ وما تَسْتَقِرْ",2,"ر",1,0],["هُوَ الظِلُّ الَّذِي قارَعتِ عنهُ","حَصى الرَّمضاءِ دامِيةَ الأظلِّ",3,"ل",1,0],["هُوَ الظُبى إِلّا أَنَّهُ كُلُّ ضَيغَمٍ","إِذا ما رَآهُ وَدَّ لَو كانَ عَبدَهُ",4,"ه",1,0],["هو الظاهر المعروف في كل ظاهر","هو الباطن المجهول من ليس يعلم",5,"م",1,0],["هو الظاهر المعروف في كل ظاهر","هو الباطن المجهول يخفى شياعه",6,"ع",2,0],["هو الظِلُّ الظَليلُ بأرضِ قومٍ","وقاهُمْ حَرَّ هاجرةِ الضَّواحي",7,"ح",2,0],["هو الظاهر المعلوم قبل ظهوره","هو الباطن الخافي بكل حقيقة",8,"ه",1,0],["هو الظبي إلا أن في الظبي لفتة","وغصن النقا لولا التعطف في الغصن",9,"ن",1,0],["هُوَ الظَفِرُ المَيمونُ إن راح أو غدا","بهِ الرَكبُ والتَلعابَةُ المُتَحَبَّبُ",10,"ب",1,0],["هو الظاهر الغازي الغياث الذي غدت","به هضبات الملك شامخة الذُّرى",11,"ر",2,0],["هو الظاهر المشهودُ في كلِّ ظاهر","وفي كلِّ مستورٍ فمشهودُك الله",12,"ل",2,0],["هُوَ الظَبي في جِيدٍ وَعَينٍ وَنَفرَةٍ","وَإِن لا يَكُنهُ فَهوَ حَقاً أَخُو الظَبي",13,"ي",1,0],["هو الظبي الشرود وفي فؤادي","كناس حل فيه على الدوام",14,"م",1,0],["هُوَ الظَّبْىُ لاَ بَلْ صَائِدُ الظَّبْيِ لَحْظُهُ","وَيَا مَا أُحَيْلاَ الصَّيْدَ في شَرَكِ الهُدْبِ",15,"ب",1,0],["هو الظّبيُ الذي أمْسَتْ جُفوني","تُسَهِّدُها لواحظُهُ الرّقودُ",16,"د",1,0],["هو الظِّلُّ ظِلُّ اللهِ تضْفو سُتورُهُ","ويغنِي عنِ الصُّبْحِ المُبين ظهورُهُ",17,"ه",1,0],["هُوَ الظفر في يَومِ الكِفاحِ وَفِعلُه","نَرى دونهُ فِعل الحُسام المهنَّد",18,"د",1,0],["هو الظبي إلا أنه غير أخنس","هو البدر إلا أنه ليس يغرب",19,"ب",1,0],["هو الظبي لكن العيون موارد","له وله حب القلوب مراتع",20,"ع",1,0],["هو الظبي أدنى ما يكون نفاره","وياليت لي شيئا يزيل ارتياعه",21,"ع",2,0]]}