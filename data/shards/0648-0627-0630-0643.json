يرجَّع في إِثر الهديل له صدحا",233,"ح",2,0],["واذكر مقالة صبّ فيه ممتَحِن","يا ديرَ مُرّان لا عُرّيتَ من سكر",234,"ر",1,0],["واذكر مقالة من ظلت خواطره","تربى على السحر في أوصافها الغرر",234,"ر",1,0],["وأذكرُ عذباً من رُضابكِ مُسكراً","فما أشربُ الصهباءَ إلا تعلُّلا",235,"ل",2,0],["واذكر نسايا الشعرِ عندك إنها","لا تنفعُ الذكرى لغير الذاكرِ",236,"ر",1,0],["واذكروا صبّاً إذا غنَّى بكم","شِربَ الدمعَ وعاف القَدحَا",237,"ح",2,0],["واذكر مآربَ غَيْرَها واعجبْ لها","غصبتك آفتُها على لذَّاتِها",238,"ت",3,0],["واذكراني بتراتي انما","هُدْنةُ الحَيِّ رياءٌ ودَخَلْ",239,"ل",1,0],["واذكر منه هزة حاتمية","بصم العطايا والعتاق الشواذب",240,"ب",1,0],["وَأَذكُرُ أَيّامَ الحِمى ثُمَّ أَنثَني","عَلى كَبِدي مِن خَشيَةٍ أَن تَقَطَّعا",241,"ع",2,0],["وأذ كَرتَني زماناٌ بانَ منفصِلاً","عنّي ووجدي عليه غيرُ منفصِلِ",242,"ل",1,0],["واذكر خليلك في الطلول لعله","يحيي بذكرك واغل في الأرباض",243,"ض",1,0],["واذكر لشعبك تاريخ الجدود وما","كانوا عليه وما في سالف العصر",244,"ر",1,0],["واذكر مطالب شعب ليس ينكرها","إلا الحليفان مأجور وذو جور",245,"ر",1,0],["واذكر أبا الحسن المحاذي خصمه","مذ قال لم كنّيتني في الناس",246,"س",1,0],["وأذكُر قدَّها فأنوحُ شوقاً","على الأغصان تنتدِبُ الحَمامُ",247,"م",1,0],["واذكر معاني أسرارٍ له انبجست","من النبي انجلت عن ذلك الزَّجل",248,"ل",1,0],["وأذكرها وتطربني المعاني","فأضحك حين أذكرها وأبكي",249,"ي",1,0],["واذكر المصطفى أمام البرايا","سيد المرسلين عالي الجنابِ",250,"ب",1,0],["واذكره منطوباً عن كل حادثةٍ","مستجمع الصدق في محوٍ وإثبات",251,"ت",1,0],["واذْكُرْ أَخا عادٍ ففي آياتِهِ","تلكَ التَّفاصيلُ التي طَوَتِ الجُمَلْ",252,"ل",1,0],["واذْكُر لأهلِ الحِمى من شأنِه أثراً","فالعَيْنُ غالَتْ بهِ والشَخْصُ والأثَرُ",253,"ر",1,0],["واذْكُرْ مقامي يا بنيَّ فإِنَّني","معكَ اتَّحدْتُ لفائِفاً وعَصائِبَا",254,"ب",2,0],["وإذ كُنتُ القَسيمَ بغير عَدلٍ","نجَوْا منهُ وحازوا الصّبرَ دوني",255,"ي",1,0],["واذكر أبا الميمون تعل بذكره","شرفاً ولا تتعد نحو معده",256,"د",2,0],["واذكرونا كذِكرِنا لَكُمُ دَو","ماً وَحَيُّوا مِنَّا عهودَ وِصالِ",257,"ل",1,0],["وأذْكرتنِي والشّيبُ يضحك ثغرُه","بلمَّتِنا عهدَ الشّبيبةِ والفتكِ",258,"ك",1,0],["وأذكرنِي نجداً على شَحْطِ نأيها","ونحن بأرض الغَوْرِ نكباءُ حَرْجَفُ",259,"ف",1,0],["وَأَذكرني شبهَ القضيبِ ونحنُ في","ظُهورِ مَطايانا قضيبٌ من الرّندِ",260,"د",1,0],["وَاِذكُر صَنائِعَهُ فَلَسنَ صَنائِعاً","لَكِنَّهُنَّ قَلائِدُ الأَعناقِ",261,"ق",1,0],["واذكروني عند من صلَّى لها","يعرف الحال ومن بالصدق صاما",262,"م",2,0],["واذكروا لي فرد مصنوع له","صانع يعرف من قد صنعه",263,"ع",2,0],["وأذكرت عهداً مِن ألستُ بربكم","به شخصت منا إليه البصائر",264,"ر",1,0],["واذكرا لي سنداً أعرفه","لست ألقى لي سواء سندا",265,"د",2,0],["واذكر إلهَكَ في سرٍّ وفي علن","تنجو غداً من لهيب النار والوهج",266,"ج",1,0],["وأذكرُ من ألطافِهِ ووِدادهِ","بدائعَ شَتَّى لا أُطيقُ لها ذِكرا",267,"ر",2,0],["وأذكُرُ من مُطوَّقِهِ أيادٍ","بِطَوْقِ البِرِّ قَلَّدَت الرِجالا",268,"ل",2,0],["وَأَذْكُرُهَا فِي المَحَلِّ الجَدِيْبِ","فَيُخْصِبُ مِنْ دَمْعِيَ المُنْسَجِمْ",269,"م",1,0],["وَأَذْكُرُ حَاجَتِي فَتَعِي وَتُغْضِي","فَلاَ مُتِّعْتَ بِالطَّرْفِ الغَضِيْضِ",270,"ض",1,0],["وأذْكُرُ خالِياً حُجَجي","وأَنْسَى حِيْنَ أَبْصِرُهُ",271,"ر",2,0],["وأذْكىَ عِطْرَهَا الريحُ","فأَهْدَتْ له أُنْجُوجَهْ",272,"ج",2,0]]}