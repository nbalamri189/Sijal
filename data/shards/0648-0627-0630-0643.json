{"poems":[[53,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[53,"أحن إلى لقائك كل يوم","https://www.aldiwan.net/poem30671.html","الوافر"],[53,"جزاء أمير المؤمنين ثنائي","https://www.aldiwan.net/poem30783.html","الطويل"],[63,"خلا الجزع من سلمى وهاتيك دارها","https://www.aldiwan.net/poem45717.html","الطويل"],[63,"نزلنا بنعمان الأراك وللندى","https://www.aldiwan.net/poem45791.html","الطويل"],[63,"لمن فتية منشورة وفراتها","https://www.aldiwan.net/poem46199.html","الطويل"],[63,"حنانيك إن الغدر ضربة لازب","https://www.aldiwan.net/poem46200.html","الطويل"],[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[34,"حننت إلى ريا ونفسك باعدت","https://www.aldiwan.net/poem4912.html","الطويل"],[77,"خدع الشوق فؤادي فانخدع","https://www.aldiwan.net/poem35986.html","الرمل"],[77,"بشرى تقوم لها الدنيا على قدم","https://www.aldiwan.net/poem36125.html","البسيط"],[86,"آذنت شمس حياتي بمغيب","https://www.aldiwan.net/poem10474.html","الرمل"],[86,"لله درك كنت من رجل","https://www.aldiwan.net/poem10491.html","أحذ الكامل"],[86,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[86,"فتية الصهباء خير الشاربين","https://www.aldiwan.net/poem10937.html","الرمل"],[86,"ورد الكنانة عبقري زمانه","https://www.aldiwan.net/poem68904.html","الكامل"],[86,"سكن الظلام وبات قلبك يخفق","https://www.aldiwan.net/poem68942.html","الكامل"],[71,"عسى البارق الشامي يهمي سحابه","https://www.aldiwan.net/poem4026.html","الطويل"],[73,"الدهر إن أملى فصيح أعجم","https://www.aldiwan.net/poem11979.html","الكامل"],[10,"ألا يا عين ويحك أسعديني","https://www.aldiwan.net/poem21105.html","الوافر"],[93,"فجع القريض وقد ثوى حسان","https://www.aldiwan.net/poem11217.html","البسيط"],[93,"ألطيب في نفحات الروض حياني","https://www.aldiwan.net/poem11224.html","البسيط"],[93,"دعا الوفاء وهذا وقت تبيان","https://www.aldiwan.net/poem11236.html","البسيط"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[83,"حيت صباحا فأحيت ساكني القصبه","https://www.aldiwan.net/poem54338.html","الطويل"],[88,"إلى كم تصب الدمع عيني وتسكب","https://www.aldiwan.net/poem44399.html","الطويل"],[88,"لقد طوحتني في البلاد مضاعا","https://www.aldiwan.net/poem45009.html","الطويل"],[27,"حيوا أمامة واذكروا عهدا مضى","https://www.aldiwan.net/poem5655.html","الكامل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[23,"عين جودي بدمعك المنزور","https://www.aldiwan.net/poem21412.html","الخفيف"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[72,"غازلتنا فأعيدي ماضي الغزل","https://www.aldiwan.net/poem19472.html","البسيط"],[72,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[72,"ليهن بنو الآمال أنك قادم","https://www.aldiwan.net/poem19670.html","الطويل"],[72,"أحبتنا لا عين سلوان عنكم","https://www.aldiwan.net/poem19978.html","الطويل"],[72,"يا طرس قبل راحة شمسية","https://www.aldiwan.net/poem19995.html","الكامل"],[72,"حويت ذرا المجد لما حويت","https://www.aldiwan.net/poem20191.html","المتقارب"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[51,"أيها السيد الذي ورث السؤدد","https://www.aldiwan.net/poem10880.html","الخفيف"],[51,"بكيت فلم تترك لعينك مدمعا","https://www.aldiwan.net/poem65076.html","الطويل"],[51,"إن ائتمانك آفات الزمان على","https://www.aldiwan.net/poem65773.html","البسيط"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[91,"يا جنة قبلما حلت بها قدمي","https://www.aldiwan.net/poem62814.html","عموديه"],[91,"ألا أيها الباكي فديتك باكيا","https://www.aldiwan.net/poem62816.html","عموديه"],[70,"أحن إلى عهد المحصب من منى","https://www.aldiwan.net/poem42756.html","الطويل"],[70,"سواك الذي ودي لديه مضيع","https://www.aldiwan.net/poem43024.html","الطويل"],[85,"أيها الثغر بلغت الأملا","https://www.aldiwan.net/poem7143.html","الرمل"],[85,"يا راحلا عنا وذكرك خالد","https://www.aldiwan.net/poem7267.html","الكامل"],[85,"لك في الأرض والسماء مآتم","https://www.aldiwan.net/poem11330.html","الخفيف"],[85,"خلقنا للحياة وللممات","https://www.aldiwan.net/poem62917.html","الوافر"],[85,"أريد سلوكم والقلب يأبى","https://www.aldiwan.net/poem63680.html","الوافر"],[85,"قم في فم الدنيا وحي الأزهرا","https://www.aldiwan.net/poem63764.html","الكامل"],[85,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"عليك السلام أيها القمر البدر","https://www.aldiwan.net/poem63569.html","الطويل"],[61,"أذم إليك عادية الفراق","https://www.aldiwan.net/poem51504.html","الوافر"],[2,"كم للمنازل من عام ومن زمن","https://www.aldiwan.net/poem25005.html","البسيط"],[2,"أعن كل أخدان وإلف ولذة","https://www.aldiwan.net/poem25038.html","الطويل"],[66,"حي بالصرف من كؤوس المدام","https://www.aldiwan.net/poem39204.html","الخفيف"],[66,"أخلاي بالفيحاء إن طال بعدكم","https://www.aldiwan.net/poem40651.html","الطويل"],[80,"أإن بكت ورقاء في غضن بان","https://www.aldiwan.net/poem31262.html","السريع"],[80,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[87,"يا نديمي في سرنديب كفا","https://www.aldiwan.net/poem8241.html","الخفيف"],[87,"ما لي بودك بعد اليوم إلمام","https://www.aldiwan.net/poem8263.html","البسيط"],[69,"يا بن أخينا أقمتنا أبدا","https://www.aldiwan.net/poem28602.html","المنسرح"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[69,"وأذكرني ليالي ماضيات","https://www.aldiwan.net/poem29239.html","الوافر"],[31,"إرحمينا يا نعم مما لقينا","https://www.aldiwan.net/poem41278.html","الخفيف"],[31,"ألمم بجور في الصفاح حسان","https://www.aldiwan.net/poem41303.html","الكامل"],[31,"يا ثريا الفؤاد ردي السلاما","https://www.aldiwan.net/poem41340.html","الخفيف"],[31,"أأنكرت من بعد عرفانكا","https://www.aldiwan.net/poem42028.html","المتقارب"],[31,"نام الخلي وبت غير موسد أ","https://www.aldiwan.net/poem42571.html","الكامل"],[74,"أما وخيال قد أطاف وسلما","https://www.aldiwan.net/poem13244.html","الطويل"],[105,"أدر الحديث وطف على الأقوام","https://www.aldiwan.net/poem42048.html","الكامل"],[105,"أعجزنا أن نجوب المشرقين","https://www.aldiwan.net/poem42090.html","الرمل"],[105,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[105,"مرحبا بالأحبة المقبلينا","https://www.aldiwan.net/poem44058.html","الخفيف"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[67,"أمدائح لي فيك أم تسبيح","https://www.aldiwan.net/poem18045.html","الكامل"],[48,"أمربعنا بالشط لا لعب البلى","https://www.aldiwan.net/poem62578.html","الطويل"],[50,"يا ابنة الخير عدينا موعدا","https://www.aldiwan.net/poem63924.html","الرمل"],[50,"يا خليلي أسعدا","https://www.aldiwan.net/poem63945.html","مجزوء الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85556","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39671","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39684","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16677","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19015","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20988","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54735","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55054","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141982","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/200123","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[77,"بشرى تقوم لها الدنيا على قدم","https://www.poetsgate.com/ViewPoem.aspx?id=34158",""],[103,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[90,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[45,"عَلَيكَ السَلامٌ، أيّها القَمَرُ البَدْرُ،","https://www.poetsgate.com/ViewPoem.aspx?id=31254",""]],"verses":[["وَأَذكى المُضمَراتِ حَشاً","تُطَهِّرُهُ ضَمائِرُه",0,"ر",2,0],["وَأَذكُرُ ما مَضى فَيَغيضُ صَبري","وَتَنفُرُ عَبرَتي وَيَبوحُ صَمتي",1,"ي",1,0],["وَأَذكُرُما أَولَيتَني مِن صَنيعَةٍ","فَأُصفيكَ رَهنَي طاعَةٍ وَوَفاءِ",2,"ا",2,0],["وَأَذكُرُ لَيلاً خُضتُ قُطرَيهِ بالحِمى","وَبِتُّ يُلَّهيني بِسَلمى سِرارُها",3,"ر",3,0],["وَأَذكُرُ خَوداً إِن دَعاني عَلى النَّوى","هَواها أَجابَتهُ الدُّموعُ الذَّوارِفُ",4,"ف",1,0],["وأذكُرُ أيّاماً بجَرعاءِ مالِكٍ","رِقاقاً حَواشيها غِضاباً وُشاتُها",5,"ت",3,0],["وأذْكُرُ عَهدي من غُفَيْلَةَ بَعدَما","طَوَيْتُ على أسرارِ حُزْوى تَرائِبي",6,"ب",2,0],["وَاِذكُرُوا حِلفَ ذي المَجازِ وَما قُ","دِّمَ فيهِ العُهودُ وَالكُفَلاءُ",7,"ا",2,0],["وَأَذكُرُ أَيّامَ الحِمى ثُمَّ أَنثَني","عَلى كَبِدي مِن خَشيَةٍ أَن تَصَدَّعا",8,"ع",2,0],["واذكُرِ الصَّبّاغَ عبْدَ اللهِ إنْ","رجّعَ الشّدْوَ وبالذِّكْرِ سجَعْ",9,"ع",1,0],["وَاذْكُرْ بِمِسْمَعِهِ الأَنْدَى وَقَائِعَهَا","يَلُحْ لِوَجْهِكَ مِنْهُ وَجْهُ مُبْتَسِمِ",10,"م",1,0],["وَاُذكُري الوَحشَةَ في القَبرِ فَلا","مُؤنِسٌ فيهِ سِوى تَقوى القُلوبِ",11,"ب",1,0],["وَاِذكُر لَهُم حاجَ البِلادِ إِلى","تِلكَ النُهى في الحادِثِ الجَلَلِ",12,"ل",1,0],["وَأَذكَرَهُم يَوماً أَغَرَّ مُحَجَّلاً","بِهِ تُوِّجَ التاريخُ وَالسَعدُ مُسفِرُ",13,"ر",1,0],["وَاِذكُروني عِندَ كاساتِ الطِلا","إِنَّني كُنتُ إِمامَ المُدمِنين",14,"ن",1,0],["وَاِذكُر لَنا الحَمراءَ كَيفَ رَأَيتَها","وَالقَصرَ ماذا كانَ مِن بُنيانِهِ",15,"ن",2,0],["وَاِذكُر لَنا عَهدَ الَّذينَ بِنايِهِم","جَمَعوا عَلَيكَ هُمومَهُم وَتَفَرَّقوا",16,"ق",3,0],["وَأَذكَرتُهُ أَيّامَ دِمياط بَينَنا","وَبَينَ العدى وَالمَوتُ تَهوي عُقابُهُ",17,"ب",2,0],["وَاِذكُر صَنيعَ أَبيكَ أَوَّلَ أَمرِهِ","في كُلِّ مُتَّهَمٍ فَإِنَّكَ تَعلَمُ",18,"م",1,0],["وَأَذكُرُهُ إِذا ما الأَرضُ أَمسَت","هُجولاً لَم تُلَمَّع بِالوَميضِ",19,"ض",1,0],["وَاذْكَرْ مَنَاقِبَ حُرَّةً عَرَبِيَّةً","سَارَتْ بِسِيبِ حَدِيثِهَا الرُّكْبَانُ",20,"ن",1,0],["وَاذْكُرْ بَنِي كَرَمٍ قَوْمٌ غَدَا اسْمُهُمْ","لِلْجُودِ وَاللُّطْفِ فِيهِ خَيْرَ عُنْوَانِ",21,"ن",1,0],["وَاذْكُرْ صُروحاً لِسَمْعَانَ مُشَيَّدَةً","لَمْ يَبْنِهَا من عُصُورٍ قَبْلَهُ بانِي",22,"ن",2,0],["وأذكرني ثغراً ظمئتُ بِورْدِهِ","ولا والهوى العذريّ ما كنْتُ ناسيا",23,"ي",2,0],["وأذكرتَ يوم العرض جوداً ومنعةً","بموقفِ عرضٍ كنتَ فيه المجازيا",23,"ي",2,0],["وأذكرتُ عهد مهديها ويشكر","فوجهها بعصاب الحس قد عصبه",24,"ب",2,0],["وأذكركم للشمس عند طلوعها","ويعزب عني الصبر أيّان تغرب",25,"ب",1,0],["وأذكر هاتيك الرِباعَ بحسُنْها","فنعمتْ على شَحْط المَزار رباعا",26,"ع",2,0],["وَاِذكُر قَرابَةَ قَومِ بَرَّةَ مِنكُمُ","فَالرِحمُ طالِبَةٌ وَتَرضى بِالرِضا",27,"ا",1,0],["وَأَذكُرُ مِن أوَاصِرِهِم إِلَينَا","وقُربَاهُم طوائِفَ ما نُسِينَا",28,"ن",2,0],["وَأَذكَت مَذاكيهِ بِسَرحٍ وَأَرضِها","مِنَ الضَربِ ناراً جَمرُها مُتَطايِرُ",29,"ر",1,0],["وَاِذكُري مُؤتَةً وَما كانَ فيها","يَومَ وَلَّوا في وَقعَةِ التَغويرِ",30,"ر",1,0],["واذكر ببدر طلعةً نبويةً","من مفردٍ يسمو ابنَ عشرَ وأربع",31,"ع",1,0],["واذكر إذا هبَّ معتل الصبا جسدِي","فرُبَّما صحَّ الأجساد بالعلل",32,"ل",1,0],["وأذكر العيش مصقولاً سوالفه","إذ مصر داري وأحبابي بها خوَلي",33,"ل",2,0],["وأذكرته في الوفد وفد قديمه","لأنك للأموال في الجود هاشم",34,"م",1,0],["وأذكرني القدر الشريف قمامةً","فقلت ودعني بعد ذا أتقمّم",35,"م",1,0],["واذكر ضرورة قائلٍ في شعره","قولاً مضى عامٌ عليه وعام",36,"م",1,0],["وأذكرت مصر الثنا الفاضليّ","وأخفت دمشقك نيسانها",37,"ن",3,0],["واذكُر بقلبٍ غيرِ مُسْتَوْهلٍ","يعروهُ من ذِكْر القِرى ناخبُ",38,"ب",1,0],["واذكرِ الجعْد وارعَهُ فيَّ واحفظ","حُرْمَتينا بالعدل والتوحيدِ",39,"د",1,0],["وأذكى نسيمَ الروض ريعانُ ظلِّه","وغنى مغني الطير فيه فسجَّعا",40,"ع",2,0],["واذكر وُقيتَ من النسيان أسوَأَه","كوني سُرورَك في أيام أحزانك",41,"ك",1,0],["وَاِذكُر غُدانَةَ عِدّاناً مُزَنَّمَةً","مِنَ الحَبَلَّقِ تُبنى حَولَها الصِيَرُ",42,"ر",1,0],["وَاِذكُر أَكارِمَ قَومٍ طابَ عُنصُرُهُم","وَأَشبَهوا بِسَجاياهُم أَقاحيها",43,"ي",3,0],["وَأَذكُرُهُ ذِكرى العَجوزِ شَبابَها","وَأَبكي لَدى ذِكراهُ أَحمَرَ قانِيا",44,"ي",2,0],["وَأَذكُرُ أَيّامَ الحِجازِ وَأَنثَني","كَأَنّي صَريعٌ يَعتَريهِ خَبالُهُ",45,"ل",2,0],["وَإِذ كُنتُ لَم أَعتَد لِهاتَيكَ ذِلَّةً","فَحَسبي بِها مِن خَجلَةٍ حينَ أَذهَبُ",46,"ب",1,0],["واذكر الداعين لله غدا","في منى وادع لهم مبتهلا",47,"ل",2,0],["واذكر حكاية دنشواى فإنها","كم خلّفت بين الربوع يتامى",48,"م",2,0],["وَاِذكُروا لِلأَميرِ مَكَّةَ وَالقَص","رَ وَعَهدَ الصَفا وَطيبَ المَواسِم",49,"م",1,0],["وَأَذكُرُ مِن حَياتِكِ ما تَقَضّى","فَكانَ مِنَ الغَداةِ إِلى الغَداةِ",50,"ه",1,0],["وَأَذكُرُكُم بِرُؤيَةِ كُلِّ حُسنٍ","فَيَصبو ناظِري وَالقَلبُ أَصبى",51,"ب",2,0],["وَاِذكُرهُ بَعدَ المَسجِدَينِ مُعَظِّماً","لِمَساجِدِ اللَهِ الثَلاثَةِ مُكبِرا",52,"ر",2,0],["وَاِذكُرِ الأَنصارَ بِالأَم","سِ وَلا تَنسَ الصِحابا",53,"ب",2,0],["وَاِذكُروا في الصَحَّةِ الدا","ءَ إِذا ما السُقمُ نابا",53,"ب",2,0],["وَاِذكُرِ الغُرَّ آلَ أَيّوبَ وَاِمدَح","فَمِنَ المَدحِ لِلرِجالِ جَزاءُ",54,"ا",2,0],["وَاِذكُرِ التُركَ إِنَّهُم لَم يُطاعوا","فَيَرى الناسُ أَحسَنوا أَم أَساؤوا",54,"ا",1,0],["وَأَذكُرُ أَيّامي لَدَيكَ وَنِعمَتي","وَآخِرُ ما يَبقى مِنَ الذاهِبِ الذِكرُ",55,"ر",1,0],["وأَذْكُرُ حَبلَكَ الثَّبْتَ الأواخي","عليَّ وَوُدَّكَ العَذْبَ المَذاقِ",56,"ق",1,0],["وَإِذ كِلانا إِذا حانَت مُفارَقَةٌ","مِنَ الدِيارِ طَوى كَشحاً عَلى حَزَنِ",57,"ن",1,0],["وَأَذكُرُ سَلمى في الزَمانِ الَّذي مَضى","كَعَيناءَ تَرتادُ الأَسِرَّةَ عَوهَجِ",58,"ج",1,0],["وَاِذكِ فَهمي بِقَهوَةٍ تُطفِىءُ الهَم","مَ بِبَردٍ مِن سُكرِها وَسَلامِ",59,"م",1,0],["وَأَذكَرَني عَهداً وَما كُنتُ ناسِياً","وَلَكِنَّهُ تَجديدُ ذِكرٍ عَلى ذِكرِ",60,"ر",1,0],["وأذكرَتْهُ من زمانِ الصّبا","طيبَ المغاني والغواني الحسان",61,"ن",1,0],["وأذكرْتني عَصْرَ الصبا فكأنّما","تَحدّثُ منه العينُ عن طيْفِ حالمِ",62,"م",1,0],["وَأَذكَرتِني عَصْرَ الشبابِ الذي مضى","لِبرديَ فيه بالتَّنَعُّمِ إِسبالُ",63,"ل",1,0],["وَاذْكُرَا لِي فُسْطَاطَ مِصْرَ فَإِنِّي","بِهَوَاهَا مُتَيَّمٌ مُسْتَهَامُ",64,"م",1,0],["وَاذْكُرْ مَكَانَكَ مِنْ عَبَّاسَ حَيْثُ مَضَتْ","عَلَيْكَ فِي الدَّارِ أَعْوَامٌ وَأَعْوَامُ",65,"م",1,0],["واذكر لمولاكَ كيفَ نحنُ لما","أولاكَ مِنْ فيضِ جودِهِ الزائدْ",66,"د",1,0],["واذكرْ هبوبَ نسيمِ المنحنى سحراً","لما تمرُّ على الأزهارِ والغُدْرِ",67,"ر",1,0],["وأذكرني لياليَ ماضيَاتْ","بكم تزري على ضوء الصباحِ",68,"ح",1,1],["وَاِذكُري العَهدَ وَالمَواثيقَ مِنّا","يَومَ آلَيتِ لا تُطيعينَ فينا",69,"ن",2,0],["وَاِذكُر لَهُنَّ جَوىً بِنَفسِكَ داخِلاً","قَد هاضَ عَظمي حَرُّهُ وَبَراني",70,"ن",2,0],["وَاِذكُري لَيلَةَ المَطارِفِ وَالوَب","لِ وَإِرسالَنا إِلَيكِ الغُلاما",71,"م",2,0],["وَاِذكُري مَجلِساً لَدى جانِبِ القَص","رِ عَشيّاً وَمُقسَمي أَقساما",71,"م",2,0],["وَإِذ كُلُّ مَرعىً رَعَتهُ السَراةُ","وَإِن طابَ لَيسَ كَسَعدانِكا",72,"ك",2,0],["وَاِذكُر لَنا ما شِئتَ مِمّا تَشتَهي","وَاللَهِ لا نَعصيكَ أُخرى المُسنَدِ",73,"د",1,0],["وَأَذكَرَني عَهداً تَقادَمَ بِاللِوى","وَعَصراً بَينَ الكَثيبِ إِلى الحِمى",74,"م",2,0],["واذْكُرْ حَديثَ الفاتحينَ وما رَعَوْا","لِقَطينِها من حُرمةٍ وذِمامِ",75,"م",1,0],["واذكروا للشَّرق عن شاعرهِ","حَيرةَ الرُّزءين بين الموسميْنْ",76,"ن",1,0],["وَاذْكُرْ لِصاحبكَ الحديثَ فَرُبَّما","كَفَّ المناجِزُ وارْعَوى المُسْتَهْدِفُ",77,"ف",1,0],["واذكروا خطبَكم وكيفَ ذَهْبتُمْ","خِيفةَ الضَّيْمِ في البلادِ عِزينا",78,"ن",2,0],["وَاذْكُرْ سَمِيِّكَ إذ يقولُ محمَّدٌ","ارجعْ عُمَيْرُ فدمعُه يتسحَّحُ",79,"ح",1,0],["وَأَذْكُرُهُ وَلَيْلُ الخَطْبِ داجٍ","عَلَيَّ فَتَنْجَلِي عني الخُطوبُ",80,"ب",1,0],["وَاذكُر مَناقِبَه الَّتي أَلفاظُها","ضَاقَ الفضاءُ بِذِكرِها وَاللوحُ",81,"ح",1,0],["وَأَذكُرُ طَرفاً بِالوِصالِ سَخَت لَهُ","قُلوبٌ تَداعَت مِن وَثاقِ صِفادِ",82,"د",1,0],["وَاِذكُري قَولَ أَديبٍ ناصِحٍ","يَومَ أَوصاني وَأَوصى وَلَدا",83,"د",2,0],["وَاِذكُري لَيلَةَ السَما","ءِ بِذي التاجِ مَقعَدا",84,"د",2,0],["واذكر لمن لجَّ في الانكار بينةً","فذاك أكشف بين الناس للرِيبَب",85,"ب",1,0],["واذكر الأوطان لا تأخذ بما","يكتب الحقدُ ويُمليهِ العداءْ",86,"ا",2,0],["واذكري بعض لياليها القُدامَى","في ضفافٍ حَمَلَتْ عنك الهُياما",87,"م",2,0],["واذكر على الأرض الشقية رفقة","باتوا عليك يقلبون الراحا",88,"ح",2,0],["واذكُري لي فَضْلَ الشبابِ وما يَجْ","مَعُ مِنْ مَنْظَرٍ يَرُوقُ وطِيب",89,"ب",1,0],["واذكر العادل الكريم سعيدا","إن قوما له انتموا سعداء",90,"ا",2,0],["وأذكُرِ النُّعمَى الَّتي لَم أَنسَهَا","لكَ في السَّعيِ إذا العبَدُ كَفَر",91,"ر",1,0],["وَأَذْكَرَتْهَا أَنَّ مِنْ شَأْنِهَا","أَنْ تُصْلِح الْعَيْشَ الذي أُفسِدَا",92,"د",2,0],["وَاذْكُرْ لَهُ ذَوداً مَجِيداً صَادِقاً","بِسِنَانِ ذَاكَ المِرْقَمِ العَسَّالِ",93,"ل",1,0],["وَاذْكُرْ لَهُ تَبْرِيزَهُ فِي فَنِّهِ","بِذَكَائِهِ وَبِكَدِّهِ المُتَوَالِي",93,"ل",2,0],["وَاذْكُرْ لَهُ فَضْلَ التَّعَاوُنِ يَقْتَفِي","فِيهِ طَريقَ شَقِيقِهِ المِفْضَالِ",93,"ل",1,0],["وَاذْكُرْ ضُرُوبَ كِفَاحِهِ لِبِلاَدِهِ","مَا اسْطَاعَ فِي حَلٍّ وَفِي تَرْحَالِ",93,"ل",1,0],["وَإِذْ كُلُّ صَعبِ لاَ يُرامُ مُذلَّلٌ","لاَ يُجَازُ رَحِيبُ",94,"ب",1,0],["وَإِذْ كُلُّ أَرْضِ رَوْضَةٌ عَبْقَرِيَّةٌ","جَدِيبٍ في الدِّيَارِ خَصِيبُ",94,"ب",1,0],["وَإِذْ كُلُّ ذِي قَلْبٍ خَفُوقٍ بِصَبْوَةٍ","عَلَى الْجَهْلِ مِنْهُ شَاعِرٌ وَأَديبُ",94,"ب",1,0],["وَاذَّكِرْ مَا يُمِيتُ مِنْ هِمَمِ النَّ","اسِ تَوَالِي مَهَانَةٍ وَاضْطِهَادِ",95,"د",1,0],["وَاذْكُرْ لَهُ فَوْقَ الحَصَافَةِ وَالحِجَى","خُلُقاً بِأَسْنَى التَّكْرِمَاتِ خَلِيقَا",96,"ق",2,0],["واذكروا عهدَنا القديم، فقِدماً","بخل الدهرُ بالصديق الملائمْ..",97,"م",1,0],["وَاذْكُرُونِي لهَابِكُلّ جَمِيلٍ","فَعَسَاهَا تَبْكِيعَليَّ عَسَاهَا",98,"ا",3,0],["وأذكر صحبي كلهم في إجازتي","له بالذي أروي فمنهم أبو بشر",99,"ر",1,0],["وَاِذكُر وَلا تَنسَ أَباً","لِذا المَقامِ اِدَّخَرَك",100,"ك",1,0],["وَإِذ كُلَّ يَومٍ لي بِلَحظِيَ نَشوَةٌ","يَبيتُ لَها قَلبي عَلى نَشَواتي",101,"ت",2,0],["واذكر بمسمعه الأهدى وقائعه","يلح لوجهك منه وجه مبتسم",102,"م",1,0],["واذكر حديث الألى كانت شريعتهم","سفك الدماء فكم سالت بها قضب",103,"ب",1,0],["واذكري الشدةَ في فرحِتها","واعرفي حُسنَ صنيعِ المطر",104,"ر",1,0],["وَأذكُرُ أيّامي لَدَيْكَ وَحُسْنَهَا،","وَآخِرُ ما يَبقَى مِنَ الذّاهبِ الذّكْرُ",105,"ر",1,0]]}