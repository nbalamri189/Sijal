 من نحوها","https://www.aldiwan.net/poem69514.html","المتقارب"],[565,"أراك تضن بالجاه العريض","https://www.aldiwan.net/poem69624.html","الوافر"],[565,"ينام الليل أسهره","https://www.aldiwan.net/poem69687.html","مجزوء الوافر"],[565,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"]],"verses":[["وَأَذكى المُضمَراتِ حَشاً","تُطَهِّرُهُ ضَمائِرُه",0,"ر",2,0],["وَأَذكُرُ ما مَضى فَيَغيضُ صَبري","وَتَنفُرُ عَبرَتي وَيَبوحُ صَمتي",1,"ي",1,0],["وَأَذكُرُما أَولَيتَني مِن صَنيعَةٍ","فَأُصفيكَ رَهنَي طاعَةٍ وَوَفاءِ",2,"ا",2,0],["وَأَذكُرُ لَيلاً خُضتُ قُطرَيهِ بالحِمى","وَبِتُّ يُلَّهيني بِسَلمى سِرارُها",3,"ر",3,0],["وَأَذكُرُ خَوداً إِن دَعاني عَلى النَّوى","هَواها أَجابَتهُ الدُّموعُ الذَّوارِفُ",4,"ف",1,0],["وأذكُرُ أيّاماً بجَرعاءِ مالِكٍ","رِقاقاً حَواشيها غِضاباً وُشاتُها",5,"ت",3,0],["وأذْكُرُ عَهدي من غُفَيْلَةَ بَعدَما","طَوَيْتُ على أسرارِ حُزْوى تَرائِبي",6,"ب",2,0],["وَاِذكُرُوا حِلفَ ذي المَجازِ وَما قُ","دِّمَ فيهِ العُهودُ وَالكُفَلاءُ",7,"ا",2,0],["وَأَذكُرُ أَيّامَ الحِمى ثُمَّ أَنثَني","عَلى كَبِدي مِن خَشيَةٍ أَن تَصَدَّعا",8,"ع",2,0],["واذكُرِ الصَّبّاغَ عبْدَ اللهِ إنْ","رجّعَ الشّدْوَ وبالذِّكْرِ سجَعْ",9,"ع",1,0],["وَاذْكُرْ بِمِسْمَعِهِ الأَنْدَى وَقَائِعَهَا","يَلُحْ لِوَجْهِكَ مِنْهُ وَجْهُ مُبْتَسِمِ",10,"م",1,0],["وَاُذكُري الوَحشَةَ في القَبرِ فَلا","مُؤنِسٌ فيهِ سِوى تَقوى القُلوبِ",11,"ب",1,0],["وَاِذكُر لَهُم حاجَ البِلادِ إِلى","تِلكَ النُهى في الحادِثِ الجَلَلِ",12,"ل",1,0],["وَأَذكَرَهُم يَوماً أَغَرَّ مُحَجَّلاً","بِهِ تُوِّجَ التاريخُ وَالسَعدُ مُسفِرُ",13,"ر",1,0],["وَاِذكُروني عِندَ كاساتِ الطِلا","إِنَّني كُنتُ إِمامَ المُدمِنين",14,"ن",1,0],["وَاِذكُر لَنا الحَمراءَ كَيفَ رَأَيتَها","وَالقَصرَ ماذا كانَ مِن بُنيانِهِ",15,"ن",2,0],["وَاِذكُر لَنا عَهدَ الَّذينَ بِنايِهِم","جَمَعوا عَلَيكَ هُمومَهُم وَتَفَرَّقوا",16,"ق",3,0],["وَأَذكَرتُهُ أَيّامَ دِمياط بَينَنا","وَبَينَ العدى وَالمَوتُ تَهوي عُقابُهُ",17,"ب",2,0],["وَاِذكُر صَنيعَ أَبيكَ أَوَّلَ أَمرِهِ","في كُلِّ مُتَّهَمٍ فَإِنَّكَ تَعلَمُ",18,"م",1,0],["وَأَذكُرُهُ إِذا ما الأَرضُ أَمسَت","هُجولاً لَم تُلَمَّع بِالوَميضِ",19,"ض",1,0],["وَاذْكَرْ مَنَاقِبَ حُرَّةً عَرَبِيَّةً","سَارَتْ بِسِيبِ حَدِيثِهَا الرُّكْبَانُ",20,"ن",1,0],["وَاذْكُرْ بَنِي كَرَمٍ قَوْمٌ غَدَا اسْمُهُمْ","لِلْجُودِ وَاللُّطْفِ فِيهِ خَيْرَ عُنْوَانِ",21,"ن",1,0],["وَاذْكُرْ صُروحاً لِسَمْعَانَ مُشَيَّدَةً","لَمْ يَبْنِهَا من عُصُورٍ قَبْلَهُ بانِي",22,"ن",2,0],["وأذكرني ثغراً ظمئتُ بِورْدِهِ","ولا والهوى العذريّ ما كنْتُ ناسيا",23,"ي",2,0],["وأذكرتَ يوم العرض جوداً ومنعةً","بموقفِ عرضٍ كنتَ فيه المجازيا",23,"ي",2,0],["وأذكرتُ عهد مهديها ويشكر","فوجهها بعصاب الحس قد عصبه",24,"ب",2,0],["وأذكركم للشمس عند طلوعها","ويعزب عني الصبر أيّان تغرب",25,"ب",1,0],["وأذكر هاتيك الرِباعَ بحسُنْها","فنعمتْ على شَحْط المَزار رباعا",26,"ع",2,0],["وَاِذكُر قَرابَةَ قَومِ بَرَّةَ مِنكُمُ","فَالرِحمُ طالِبَةٌ وَتَرضى بِالرِضا",27,"ا",1,0],["وَأَذكُرُ مِن أوَاصِرِهِم إِلَينَا","وقُربَاهُم طوائِفَ ما نُسِينَا",28,"ن",2,0],["وَأَذكَت مَذاكيهِ بِسَرحٍ وَأَرضِها","مِنَ الضَربِ ناراً جَمرُها مُتَطايِرُ",29,"ر",1,0],["وَاِذكُري مُؤتَةً وَما كانَ فيها","يَومَ وَلَّوا في وَقعَةِ التَغويرِ",30,"ر",1,0],["واذكر ببدر طلعةً نبويةً","من مفردٍ يسمو ابنَ عشرَ وأربع",31,"ع",1,0],["واذكر إذا هبَّ معتل الصبا جسدِي","فرُبَّما صحَّ الأجساد بالعلل",32,"ل",1,0],["وأذكر العيش مصقولاً سوالفه","إذ مصر داري وأحبابي بها خوَلي",33,"ل",2,0],["وأذكرته في الوفد وفد قديمه","لأنك للأموال في الجود هاشم",34,"م",1,0],["وأذكرني القدر الشريف قمامةً","فقلت ودعني بعد ذا أتقمّم",35,"م",1,0],["واذكر ضرورة قائلٍ في شعره","قولاً مضى عامٌ عليه وعام",36,"م",1,0],["وأذكرت مصر الثنا الفاضليّ","وأخفت دمشقك نيسانها",37,"ن",3,0],["واذكُر بقلبٍ غيرِ مُسْتَوْهلٍ","يعروهُ من ذِكْر القِرى ناخبُ",38,"ب",1,0],["واذكرِ الجعْد وارعَهُ فيَّ واحفظ","حُرْمَتينا بالعدل والتوحيدِ",39,"د",1,0],["وأذكى نسيمَ الروض ريعانُ ظلِّه","وغنى مغني الطير فيه فسجَّعا",40,"ع",2,0],["واذكر وُقيتَ من النسيان أسوَأَه","كوني سُرورَك في أيام أحزانك",41,"ك",1,0],["وَاِذكُر غُدانَةَ عِدّاناً مُزَنَّمَةً","مِنَ الحَبَلَّقِ تُبنى حَولَها الصِيَرُ",42,"ر",1,0],["وَاِذكُر أَكارِمَ قَومٍ طابَ عُنصُرُهُم","وَأَشبَهوا بِسَجاياهُم أَقاحيها",43,"ي",3,0],["وَأَذكُرُهُ ذِكرى العَجوزِ شَبابَها","وَأَبكي لَدى ذِكراهُ أَحمَرَ قانِيا",44,"ي",2,0],["وَأَذكُرُ أَيّامَ الحِجازِ وَأَنثَني","كَأَنّي صَريعٌ يَعتَريهِ خَبالُهُ",45,"ل",2,0],["وَإِذ كُنتُ لَم أَعتَد لِهاتَيكَ ذِلَّةً","فَحَسبي بِها مِن خَجلَةٍ حينَ أَذهَبُ",46,"ب",1,0],["واذكر الداعين لله غدا","في منى وادع لهم مبتهلا",47,"ل",2,0],["واذكر حكاية دنشواى فإنها","كم خلّفت بين الربوع يتامى",48,"م",2,0],["وَاِذكُروا لِلأَميرِ مَكَّةَ وَالقَص","رَ وَعَهدَ الصَفا وَطيبَ المَواسِم",49,"م",1,0],["وَأَذكُرُ مِن حَياتِكِ ما تَقَضّى","فَكانَ مِنَ الغَداةِ إِلى الغَداةِ",50,"ه",1,0],["وَأَذكُرُكُم بِرُؤيَةِ كُلِّ حُسنٍ","فَيَصبو ناظِري وَالقَلبُ أَصبى",51,"ب",2,0],["وَاِذكُرهُ بَعدَ المَسجِدَينِ مُعَظِّماً","لِمَساجِدِ اللَهِ الثَلاثَةِ مُكبِرا",52,"ر",2,0],["وَاِذكُرِ الأَنصارَ بِالأَم","سِ وَلا تَنسَ الصِحابا",53,"ب",2,0],["وَاِذكُروا في الصَحَّةِ الدا","ءَ إِذا ما السُقمُ نابا",53,"ب",2,0],["وَاِذكُرِ الغُرَّ آلَ أَيّوبَ وَاِمدَح","فَمِنَ المَدحِ لِلرِجالِ جَزاءُ",54,"ا",2,0],["وَاِذكُرِ التُركَ إِنَّهُم لَم يُطاعوا","فَيَرى الناسُ أَحسَنوا أَم أَساؤوا",54,"ا",1,0],["وَأَذكُرُ أَيّامي لَدَيكَ وَنِعمَتي","وَآخِرُ ما يَبقى مِنَ الذاهِبِ الذِكرُ",55,"ر",1,0],["وأَذْكُرُ حَبلَكَ الثَّبْتَ الأواخي","عليَّ وَوُدَّكَ العَذْبَ المَذاقِ",56,"ق",1,0],["وَإِذ كِلانا إِذا حانَت مُفارَقَةٌ","مِنَ الدِيارِ طَوى كَشحاً عَلى حَزَنِ",57,"ن",1,0],["وَأَذكُرُ سَلمى في الزَمانِ الَّذي مَضى","كَعَيناءَ تَرتادُ الأَسِرَّةَ عَوهَجِ",58,"ج",1,0],["وَاِذكِ فَهمي بِقَهوَةٍ تُطفِىءُ الهَم","مَ بِبَردٍ مِن سُكرِها وَسَلامِ",59,"م",1,0],["وَأَذكَرَني عَهداً وَما كُنتُ ناسِياً","وَلَكِنَّهُ تَجديدُ ذِكرٍ عَلى ذِكرِ",60,"ر",1,0],["وأذكرَتْهُ من زمانِ الصّبا","طيبَ المغاني والغواني الحسان",61,"ن",1,0],["وأذكرْتني عَصْرَ الصبا فكأنّما","تَحدّثُ منه العينُ عن طيْفِ حالمِ",62,"م",1,0],["وَأَذكَرتِني عَصْرَ الشبابِ الذي مضى","لِبرديَ فيه بالتَّنَعُّمِ إِسبالُ",63,"ل",1,0],["وَاذْكُرَا لِي فُسْطَاطَ مِصْرَ فَإِنِّي","بِهَوَاهَا مُتَيَّمٌ مُسْتَهَامُ",64,"م",1,0],["وَاذْكُرْ مَكَانَكَ مِنْ عَبَّاسَ حَيْثُ مَضَتْ","عَلَيْكَ فِي الدَّارِ أَعْوَامٌ وَأَعْوَامُ",65,"م",1,0],["واذكر لمولاكَ كيفَ نحنُ لما","أولاكَ مِنْ فيضِ جودِهِ الزائدْ",66,"د",1,0],["واذكرْ هبوبَ نسيمِ المنحنى سحراً","لما تمرُّ على الأزهارِ والغُدْرِ",67,"ر",1,0],["وأذكرني لياليَ ماضيَاتْ","بكم تزري على ضوء الصباحِ",68,"ح",1,1],["وَاِذكُري العَهدَ وَالمَواثيقَ مِنّا","يَومَ آلَيتِ لا تُطيعينَ فينا",69,"ن",2,0],["وَاِذكُر لَهُنَّ جَوىً بِنَفسِكَ داخِلاً","قَد هاضَ عَظمي حَرُّهُ وَبَراني",70,"ن",2,0],["وَاِذكُري لَيلَةَ المَطارِفِ وَالوَب","لِ وَإِرسالَنا إِلَيكِ الغُلاما",71,"م",2,0],["وَاِذكُري مَجلِساً لَدى جانِبِ القَص","رِ عَشيّاً وَمُقسَمي أَقساما",71,"م",2,0],["وَإِذ كُلُّ مَرعىً رَعَتهُ السَراةُ","وَإِن طابَ لَيسَ كَسَعدانِكا",72,"ك",2,0],["وَاِذكُر لَنا ما شِئتَ مِمّا تَشتَهي","وَاللَهِ لا نَعصيكَ أُخرى المُسنَدِ",73,"د",1,0],["وَأَذكَرَني عَهداً تَقادَمَ بِاللِوى","وَعَصراً بَينَ الكَثيبِ إِلى الحِمى",74,"م",2,0],["واذْكُرْ حَديثَ الفاتحينَ وما رَعَوْا","لِقَطينِها من حُرمةٍ وذِمامِ",75,"م",1,0],["واذكروا للشَّرق عن شاعرهِ","حَيرةَ الرُّزءين بين الموسميْنْ",76,"ن",1,0],["وَاذْكُرْ لِصاحبكَ الحديثَ فَرُبَّما","كَفَّ المناجِزُ وارْعَوى المُسْتَهْدِفُ",77,"ف",1,0],["واذكروا خطبَكم وكيفَ ذَهْبتُمْ","خِيفةَ الضَّيْمِ في البلادِ عِزينا",78,"ن",2,0],["وَاذْكُرْ سَمِيِّكَ إذ يقولُ محمَّدٌ","ارجعْ عُمَيْرُ فدمعُه يتسحَّحُ",79,"ح",1,0],["وَأَذْكُرُهُ وَلَيْلُ الخَطْبِ داجٍ","عَلَيَّ فَتَنْجَلِي عني الخُطوبُ",80,"ب",1,0],["وَاذكُر مَناقِبَه الَّتي أَلفاظُها","ضَاقَ الفضاءُ بِذِكرِها وَاللوحُ",81,"ح",1,0],["وَأَذكُرُ طَرفاً بِالوِصالِ سَخَت لَهُ","قُلوبٌ تَداعَت مِن وَثاقِ صِفادِ",82,"د",1,0],["وَاِذكُري قَولَ أَديبٍ ناصِحٍ","يَومَ أَوصاني وَأَوصى وَلَدا",83,"د",2,0],["وَاِذكُري لَيلَةَ السَما","ءِ بِذي التاجِ مَقعَدا",84,"د",2,0],["واذكر لمن لجَّ في الانكار بينةً","فذاك أكشف بين الناس للرِيبَب",85,"ب",1,0],["واذكر الأوطان لا تأخذ بما","يكتب الحقدُ ويُمليهِ العداءْ",86,"ا",2,0],["واذكري بعض لياليها القُدامَى","في ضفافٍ حَمَلَتْ عنك الهُياما",87,"م",2,0],["واذكر على الأرض الشقية رفقة","باتوا عليك يقلبون الراحا",88,"ح",2,0],["واذكُري لي فَضْلَ الشبابِ وما يَجْ","مَعُ مِنْ مَنْظَرٍ يَرُوقُ وطِيب",89,"ب",1,0],["واذكر العادل الكريم سعيدا","إن قوما له انتموا سعداء",90,"ا",2,0],["وأذكُرِ النُّعمَى الَّتي لَم أَنسَهَا","لكَ في السَّعيِ إذا العبَدُ كَفَر",91,"ر",1,0],["وَأَذْكَرَتْهَا أَنَّ مِنْ شَأْنِهَا","أَنْ تُصْلِح الْعَيْشَ الذي أُفسِدَا",92,"د",2,0],["وَاذْكُرْ لَهُ ذَوداً مَجِيداً صَادِقاً","بِسِنَانِ ذَاكَ المِرْقَمِ العَسَّالِ",93,"ل",1,0],["وَاذْكُرْ لَهُ تَبْرِيزَهُ فِي فَنِّهِ","بِذَكَائِهِ وَبِكَدِّهِ المُتَوَالِي",93,"ل",2,0],["وَاذْكُرْ لَهُ فَضْلَ التَّعَاوُنِ يَقْتَفِي","فِيهِ طَريقَ شَقِيقِهِ المِفْضَالِ",93,"ل",1,0],["وَاذْكُرْ ضُرُوبَ كِفَاحِهِ لِبِلاَدِهِ","مَا اسْطَاعَ فِي حَلٍّ وَفِي تَرْحَالِ",93,"ل",1,0],["وَإِذْ كُلُّ صَعبِ لاَ يُرامُ مُذلَّلٌ","لاَ يُجَازُ رَحِيبُ",94,"ب",1,0],["وَإِذْ كُلُّ أَرْضِ رَوْضَةٌ عَبْقَرِيَّةٌ","جَدِيبٍ في الدِّيَارِ خَصِيبُ",94,"ب",1,0],["وَإِذْ كُلُّ ذِي قَلْبٍ خَفُوقٍ بِصَبْوَةٍ","عَلَى الْجَهْلِ مِنْهُ شَاعِرٌ وَأَديبُ",94,"ب",1,0],["وَاذَّكِرْ مَا يُمِيتُ مِنْ هِمَمِ النَّ","اسِ تَوَالِي مَهَانَةٍ وَاضْطِهَادِ",95,"د",1,0],["وَاذْكُرْ لَهُ فَوْقَ الحَصَافَةِ وَالحِجَى","خُلُقاً بِأَسْنَى التَّكْرِمَاتِ خَلِيقَا",96,"ق",2,0],["واذكروا عهدَنا القديم، فقِدماً","بخل الدهرُ بالصديق الملائمْ..",97,"م",1,0],["وَاذْكُرُونِي لهَابِكُلّ جَمِيلٍ","فَعَسَاهَا تَبْكِيعَليَّ عَسَاهَا",98,"ا",3,0],["وأذكر صحبي كلهم في إجازتي","له بالذي أروي فمنهم أبو بشر",99,"ر",1,0],["وَاِذكُر وَلا تَنسَ أَباً","لِذا المَقامِ اِدَّخَرَك",100,"ك",1,0],["وَإِذ كُلَّ يَومٍ لي بِلَحظِيَ نَشوَةٌ","يَبيتُ لَها قَلبي عَلى نَشَواتي",101,"ت",2,0],["واذكر بمسمعه الأهدى وقائعه","يلح لوجهك منه وجه مبتسم",102,"م",1,0],["واذكر حديث الألى كانت شريعتهم","سفك الدماء فكم سالت بها قضب",103,"ب",1,0],["واذكري الشدةَ في فرحِتها","واعرفي حُسنَ صنيعِ المطر",104,"ر",1,0],["وَأذكُرُ أيّامي لَدَيْكَ وَحُسْنَهَا،","وَآخِرُ ما يَبقَى مِنَ الذّاهبِ الذّكْرُ",105,"ر",1,0],["واذكر شؤنك وابشر فهي