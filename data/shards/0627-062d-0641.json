ع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[463,"لمنَ الطلولُ تراقصتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60065&r=&rc=121",""],[6257,"سامرتُه حلما ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87182&r=&rc=7",""],[4222,"لو كنت تعلم منتهى برحائه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52713&r=&rc=5",""],[5190,"الناس صنفان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78332&r=&rc=45",""]],"verses":[["أَحَفَّت مِن جَوانِبِها الفَيافي","وَساقَطَ نَحضَها خَعضُ الظَلامِ",0,"م",1,0],["اِحفَظ لِسانَكَ أَيُّها الإِنسانُ","لا يَلدَغَنَّكَ إِنَّهُ ثُعبانُ",1,"ن",1,1],["اِحفَظ لِشَيبِكَ مِن عَيبٍ يُدَنِّسُهُ","إِنَّ البَياضَ قَليلُ الحَملِ لِلدَنَسِ",2,"س",1,0],["إِحْفَظُوا غَيْبَنَا وَأَغْضُوا عَنِ التَّقْ","صِيرِ مِنَّا فِي شَوْطِنَا وَاسْبَقُونَا",3,"ن",2,0],["أَحفَظُ غَيرانُ ما تُسطاعُ عانَتُهُ","لا الوِردُ وِردٌ وَلا إِصدارُهُ صَدَرُ",4,"ر",1,0],["احفظ لنا يا ربنا","وحيدنا خصم الوطن",5,"ن",1,1],["أُحفِروا التَلَّ يا بَني عَبدِ الأَعلى","وَأَثيروا صُخُرَهُ وَتُرابَه",6,"ب",2,0],["إِحفَظ وَسائِلَ شِعرٍ فيكَ ما ذَهَبَت","خَواطِفُ البَرقِ إِلّا دونَ ما ذَهَبا",7,"ب",2,0],["احفَظْ بقيَّتَهم وإن هم ضَيَّعوا","ما اسْتحفِظُوا من حُرمةٍ وذمامِ",8,"م",1,0],["احفَظوها إِنَّ مِصراً إن تَضِع","ضاعَ في الدُنيا تُراثُ المُسلِمينْ",9,"ن",1,0],["أَحفَظُ الإِخوانَ كَيما","يَحفَظوا مِنّي المَغيبا",10,"ب",2,0],["احفروا لي يا أَهل بغداد قبراً","إن جِسمي خير له أَن يوارى",11,"ر",2,0],["احفَظ لسانكَ إن اللسان","حريصٌ على المرء في قتلهِ",12,"ه",1,1],["أحفظ الهيفاء من تياره","ليس بحر الشعر سهلَ المركب",13,"ب",1,0],["أحفظ الأجرام في أفلاكها","وأقيها عاديات الخلل",14,"ل",1,0],["إحْفِرُوا التّلّ يا بَني عَبدِ الأعْ","لى، وَأثيرُوا صُخورَهُ وَتُرَابَهْ",15,"ب",2,0],["احفظ رسول الله وانصر دينه","واقتل مبيح عبادة الأوثان",16,"ن",1,0],["احفَظْ ولا تَنْسَ فإنْ لم تَكُنْ","تَحفظُ فازْدَدْ رغبةً في الطَّلَبْ",17,"ب",1,1],["احفظوا في الإسار قلبا تَمنَّى","شغفا أن يموت فيكم أسيرا",18,"ر",2,0],["احفظ لسانك يا أخيّ","فليسَ هذا بختيار",19,"ر",1,1],["احفروا لي قبرا إذا متّ في الأر","ض بعيدا من ضجّة الأصوات",20,"ت",1,1],["احفروا لي قبرا على شاطىء البحر","لعلّ الأمواج تبكي شبابي",21,"ب",2,0],["احفروا لي قبراً على شاطىء البحر","سميري في وحدَتي ومُقيلي",22,"ل",2,0],["أحفى شواربَه وَلحيتَه معاً","أرأيتَ رأسَ التيسِ ساعةَ يسمطُ",23,"ط",1,1],["اِحفظ سمي محمّد ال","مُنجي الأنامَ منَ الرّدى",24,"د",2,0],["اِحفَظْ مكاني في فؤادِك غائباً","حِفْظي مَكانكَ من لِساني يَثْبتُا",25,"ت",2,0],["احفَظ فُؤادي فَأنتَ تَملكُه","واستُر ضَميري فأنتَ تهتِكُهُ",26,"ك",2,1],["احفظ وصايا العلي مع أمر ابنتِه","إن كنتَ مولودَه بالروح والماء",27,"ا",2,0],["احفظ لسانك تسترح","كم صامتٍ للبر مالك",28,"ك",1,0],["احفظ يمينك والسُلام","من حر نار الغضبِ",29,"ب",1,0],["احفظ الرحمن تحفظ ما بقيت","احفظ الله تجده حيث شيت",30,"ت",1,0],["اِحفَظِ السِرَّ وَاِرعَهُ","اِنَّ اِظهارَهُ خَطَر",31,"ر",1,1],["اِحفَظِ السِرَّ مِثلَما","يُحفَظُ السَمعُ وَالبَصَر",31,"ر",1,0],["احفظوا للفنون معبدها السا","مي وغنوا أنغامها القدسيّه",32,"ه",1,0],["أحْفَظتُمُ قَلبي بِغَدْرِكُمُ","والقلبُ أدْنَى الغَدْرِ يُحفِظُهُ",33,"ظ",2,1],["احفل الفارس منها والفرس","اسفرت عن سرب طير قد نفر",34,"ر",1,0],["أحفيتِ غيرَ ضنينةٍ بهمُ","ولقد يكون سماحُكِ الضَّنّا",35,"ن",2,0],["أحفيتُ رُسغَ جيادها","وتنوءُ بي أعيارُها",36,"ر",3,0],["أحْفظتموني في المعاش فلم أجُزْ","لُطفَ العِتابِ ولا اطبَّاني اللُّوم",37,"م",1,0],["اِحْفَظْ مغيب الناس ما أحسنَوا","وما أساؤا تَحْوِ مَجْداً أثِيلْ",38,"ل",1,1],["أَحفَظُهُ ما وَجَدتُ حِفظاً","مِنهُ وَأَرميهِ إِن رَماني",39,"ن",2,0],["احْفَظْ نِظامي والهَجَنْ بِقَصائِدي","بَحْرُ العِنايَةِ ضِمْنَها مَخْبِيُّ",40,"ي",1,0],["احْفظِ الله واذْكُرَنْهُ دَواماً","ذِكرُهُ للرِّجالِ ماضي السَّلاحِ",41,"ح",1,0],["إِحفَظ وَديعَتَكَ الَّتي اِستودِعتَها","يَومَ الأَعازِبِ إِن وَصلتَ وَإِن لَمِ",42,"م",1,1],["أَحْفَظَهُ ألفاظَها","وزاده في التلقين",43,"ن",1,0],["احفظْ كَرامَةَ من كانت كرامتُهُ","تجري على الضَّيفِ جَرْيَ الماء في العودِ",44,"د",1,0],["أَحفَظَهُم قَومُهُم بِباطِلِهِم","حَتّى إِذا حارَبوهُمُ حَرِبوا",45,"ب",3,0],["أحْفظُه دائما لِحَبْرٍ","مَحلُّه في العُلَى عَظِيمُ",46,"م",1,0],["احفتهُ في بعض أبيات بها","الهيه أن يرتد عن ذا المذهبِ",47,"ب",1,0],["أحفاه بالقلم الحافي وعلمه","خلاف ما علم الرحمن بالقلم",48,"م",1,0],["احفظني اللّه من قواه","بحق لا إله إلا اللّه",49,"ه",1,0],["إحفظ فؤادك إما جئت واديه","فقد تقلد عضبا من مآقيه",50,"ي",2,1],["احفظ من الأَمراضِ والأعراضِ رُو","حَ جَواهِرِ الأكوَانِ والأعرَاضِ",51,"ض",1,1],["احفظ بني وصيتي واعمل بها","فالطب مجموع بنص كلامي",52,"م",2,1],["احفيته العتب حتى عاد من خجل","جبينه الصَّلت منه يرشح العَرَقا",53,"ق",2,0],["احفيته العتبى فمال بعطفه","كبراً وتاه يريث الخطو الوني",54,"ن",2,0],["احفظي يا دار محبو","بي جميل الذكريات",55,"ت",1,0],["احفظ لهم ما ليس يجهل حقه","ذمم مؤكدة وعقد محكم",56,"م",1,0],["أحفاد أصحابي لهم وُلُدٌ","وها أنا من عُمُري جد",57,"د",1,0],["أحفظ شخصي حاملا ثروة","مغنية الناثر والناظم",58,"م",1,1],["احفظ كيان الجسم منك سالما","ثم اقطع العضو اذا العضو فسد",59,"د",1,0],["أحُفُّ بالوجْهِ منهُ حتّى","تحْسِبُني هالةً معَهْ",60,"ع",2,0],["إِحفَظ وصايا اللَهِ يا ذا المُتَّقي","ودَعِ البَطالةَ وانبُذِ البُطلانا",61,"ن",2,1],["إِحفَظ حَواسَكَ تسترح","طُولَ المَدى وأنا الكفيلُ",62,"ل",1,0],["أحفزها عني بذي رونقٍ","مهند كالملح قطاع",63,"ع",1,0],["احفظ لقدر الناس صاح","كي تحظى منهم بالنجاح",64,"ح",1,0],["احفظ لسانك لا تبح بثلاثة","سر ومال ما استطعت ومذهب",65,"ب",1,1],["أحفظتني لفظاً أتيحَ منيَّةَ","خطرت ولم يك ثمَّ عنها مدفعُ",66,"ع",1,0],["أحفظ الناس عهودا ان دعوا","للمواثيق وأحماهم ذمارا",67,"ر",2,0],["احفظ الحقة واحفظ ما بها","ان وجه القوم محتاج اليه",68,"ي",2,0],["اِحفَظ بِلُطفِكَ فَلك عَبد خاضِع","لَكَ أَنتَ تَحفَظَهُ كَما قَد أَمَلَّك",69,"ك",1,0],["احفظ حياتك فيها والحياء معاً","فما بها اليوم مأمون ومعتصم",70,"م",1,0],["اِحفَظ لِسانَك من دم الانام وَدَع","أَمر الجَميعِ لِمَن أَمضاهُ في القدم",71,"م",1,1],["إحفظْ لسانكَ أَنْ يطولَ فإنّما","قصرُ اللِّسان يكُفُّ من غلوائهِ",72,"ا",3,0],["احفظ فؤاداً أنت فيهِ مصوَّرٌ","وهو المشوق وغيرَكم لم يعرفِ",73,"ف",1,0],["اِحفَظ صَبييه وَباركهما","لِلحُب يا نَيل وَأَلحاني",74,"ن",2,0],["أَحفَظ مَغيبي فَإِنّي غَيرُ غادِرَةٍ","أَما حَفِظتَ وَلا حُسنى لِمَن غَدَرا",75,"ر",2,0],["احْفَظْ لِسانَكَ ما اسْتَطَعْتَ ولا تَجُلْ","في كُلِّ ناحيَةٍ تَراها تَزْلَقِ",76,"ق",1,1],["أَحْفَظُ الدَّرْسَ وأَسْعَى","لِلْخِصالِ الفاضِلاتِ",77,"ت",1,0],["احفظْ لسانَكَ فهي أَهْلَكُ آفةٍ","تُلْقِي بِحَرِّ جهنمَ الموصودِ",78,"د",1,0],["احفظ كتاب الله والسنن التي","صحت وفقه الشافعي محمد",79,"د",1,0],["أحفاد خالد في السجون استعبدوا","وسليلة الخنساء تعمل نادلة",80,"ل",2,0],["احفاد خالد تنتفض بالشمالي","ومن خلفهم جيشٍ على ارقابكم داس",81,"س",1,0],["احفري فوق أرضها يا يديني واردمي","علّها تهمل قدا واحدٍ ما هو همل",82,"ل",1,0],["أحفاد ُ خالدَ لا تكلّ ُ زنودهمْ","رجموا العِدى بحجارة ٍ لا ترحم",83,"م",1,0],["أحفاد من طُحِنت به في كربلا","للعارفين الجاحدين جماجم",84,"م",1,0],["احفظ إخواني في خير","يا سامعَ صوتي ودعائي",85,"ا",2,0],["إحفظ بلاد المؤمنين جميعها","إذ راعها في دينها الإملاقُ",86,"ق",1,0],["أحفيدتي ، يا طِبّ قلبٍ مُبْتلَىً","هيّا فداوي ما عراهُ الدّاءُ",87,"ا",2,0],["أحفادنا عِقدٌ يُزَيّن عمرنا","والوُلد أحيوا أنفساً وقلوبا",88,"ب",2,0],["أحفاد خالد صدّقوا وعد بلفور","في وجيهم، سود الوجيه أم الألوان",89,"ن",1,0],["أحفظ الدرس بفكر نير","وأفهم المعنى وشرف سمعتك",90,"ك",1,0],["أحفظ النفس من المين ولا","تتبع من حاد عن شرع وضل",91,"ل",1,0],["أحفاد خالد بن مغيره ابن الوليد","بيدين جدّي لانت اسيوف (ن) صقيله",92,"ل",2,0],["احفظْ لنا السُّلطانَ نُورًا ساطِعًا","أنتَ المُجِيبُ ولا سِواكَ المُرْتَجى",93,"ج",2,0],["أحْفلْ بها بالصّدقِ تلكَ مُهوُرُها","واخْطبْ هواها واحْترسْ للخَطْوه",94,"و",2,0],["أَحفَادَ أَصْحَابِ النَّبِيِّ مُحَمَّدٍ","لِمَ صِرْتُمُ ذَيلًا لِمَنْ عَادَاكُمُ ؟!",95,"م",1,0],["احفَلِي يا عَرُوسُ تطبيبَ جُرْحِي","سئمَ الصمتَ صمتيَ المنحوسُ",96,"س",1,0],["اِحفلِي أنتِ جَنَّةُ اللهِ في أَر","ضٍ، تهادَتْ فِي روضِها فِينُوسُ",96,"س",1,0],["\"اِحفظْ لسانك أيها\" الفَاتِكانُ","ماهكذا تتحاور الأدي