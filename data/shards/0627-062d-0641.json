{"poems":[[53,"متى أنا قائم أعلى مقام","https://www.aldiwan.net/poem29753.html","الوافر"],[57,"احفظ لسانك أيها الإنسان","https://www.aldiwan.net/poem24629.html","الكامل"],[57,"يا واعظ الناس عما أنت فاعله","https://www.aldiwan.net/poem24681.html","البسيط"],[93,"يفسح الراحلون للقادمينا","https://www.aldiwan.net/poem11170.html","الخفيف"],[29,"لقد غدوت على الندمان لا حصر","https://www.aldiwan.net/poem6163.html","البسيط"],[85,"احفظ لنا يا ربنا","https://www.aldiwan.net/poem7264.html","مجزوء الرجز"],[45,"قصة التل فاسمعها عجابه","https://www.aldiwan.net/poem10889.html","الخفيف"],[44,"قل للأمير تجد للقول مضطربا","https://www.aldiwan.net/poem29988.html","البسيط"],[105,"حملت سناك مواكب الأعوام","https://www.aldiwan.net/poem42074.html","الكامل"],[105,"اشهدي يا مصر أعمال البنين","https://www.aldiwan.net/poem43070.html","الرمل"],[48,"لا أعير الدهر سمعي","https://www.aldiwan.net/poem10819.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85378","الخفيف"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116979","المتقارب"],[106,"شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=179472",""],[98,"مؤتمر الجماد","https://www.poetsgate.com/ViewPoem.aspx?id=55343",""],[45,"قِصّةُ التّلّ، فاسمَعوها عُجَابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31562",""],[160,"خاطر بنفسك في رضى الرحمن","https://www.aldiwan.net/poem59197.html","الكامل"],[185,"احفظ ولا تنس فإن لم تكن","https://www.aldiwan.net/poem14105.html","السريع"],[185,"هي دار العيش العزيز بما ضم","https://www.aldiwan.net/poem14788.html","الخفيف"],[186,"احفظ لسانك يا أخي","https://www.aldiwan.net/poem43758.html","مجزوء الكامل"],[186,"احفروا لي قبرا إذا مت في الأرض","https://www.aldiwan.net/poem44094.html","الخفيف"],[197,"ليس عيدا بل مأتم يا صحابي","https://www.aldiwan.net/poem39805.html","الخفيف"],[197,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[298,"أحفى شواربه ولحيته معا","https://www.aldiwan.net/poem36831.html","الكامل"],[305,"بالمصطفى وبأم كلثوم","https://www.aldiwan.net/poem56575.html","مجزوء الكامل"],[364,"يا معرضا قد آن أن تتلفتا","https://www.aldiwan.net/poem60975.html","الكامل"],[371,"احفظ فؤادي فأنت تملكه","https://www.aldiwan.net/poem57246.html","المنسرح"],[377,"إليك أضرع في مدحٍ خصصتِ به","https://www.aldiwan.net/poem59155.html","البسيط"],[377,"يا غافلا عن نفسه","https://www.aldiwan.net/poem59302.html","مجزوء الكامل"],[377,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[391,"أسأل الرحمن لا تسأل سواه","https://www.aldiwan.net/poem54436.html","عموديه"],[393,"احفظ السر وارعه","https://www.aldiwan.net/poem53640.html","مجزوء الخفيف"],[394,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[409,"أحفظتم قلبي بغدركم","https://www.aldiwan.net/poem32573.html","أحذ الكامل"],[443,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[458,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[458,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[461,"قل للكمال مقال مولي حلفة","https://www.aldiwan.net/poem15459.html","الكامل"],[461,"احفظ مغيب الناس ما أحسنوا","https://www.aldiwan.net/poem16128.html","السريع"],[468,"إذا الفتى مرة كساني","https://www.aldiwan.net/poem59641.html","مخلع البسيط"],[500,"قل للذي فينا تمسك مخلصا","https://www.aldiwan.net/poem37724.html","الكامل"],[500,"روح القلب تارة بالمباح","https://www.aldiwan.net/poem38040.html","الخفيف"],[540,"إحفظ وديعتك التي استودعتها","https://www.aldiwan.net/poem56674.html","الكامل"],[558,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[562,"ماذا جلبت لنا يا ليلة العيد","https://www.aldiwan.net/poem52846.html","البسيط"]],"verses":[["أَحَفَّت مِن جَوانِبِها الفَيافي","وَساقَطَ نَحضَها خَعضُ الظَلامِ",0,"م",1,0],["اِحفَظ لِسانَكَ أَيُّها الإِنسانُ","لا يَلدَغَنَّكَ إِنَّهُ ثُعبانُ",1,"ن",1,1],["اِحفَظ لِشَيبِكَ مِن عَيبٍ يُدَنِّسُهُ","إِنَّ البَياضَ قَليلُ الحَملِ لِلدَنَسِ",2,"س",1,0],["إِحْفَظُوا غَيْبَنَا وَأَغْضُوا عَنِ التَّقْ","صِيرِ مِنَّا فِي شَوْطِنَا وَاسْبَقُونَا",3,"ن",2,0],["أَحفَظُ غَيرانُ ما تُسطاعُ عانَتُهُ","لا الوِردُ وِردٌ وَلا إِصدارُهُ صَدَرُ",4,"ر",1,0],["احفظ لنا يا ربنا","وحيدنا خصم الوطن",5,"ن",1,1],["أُحفِروا التَلَّ يا بَني عَبدِ الأَعلى","وَأَثيروا صُخُرَهُ وَتُرابَه",6,"ب",2,0],["إِحفَظ وَسائِلَ شِعرٍ فيكَ ما ذَهَبَت","خَواطِفُ البَرقِ إِلّا دونَ ما ذَهَبا",7,"ب",2,0],["احفَظْ بقيَّتَهم وإن هم ضَيَّعوا","ما اسْتحفِظُوا من حُرمةٍ وذمامِ",8,"م",1,0],["احفَظوها إِنَّ مِصراً إن تَضِع","ضاعَ في الدُنيا تُراثُ المُسلِمينْ",9,"ن",1,0],["أَحفَظُ الإِخوانَ كَيما","يَحفَظوا مِنّي المَغيبا",10,"ب",2,0],["احفروا لي يا أَهل بغداد قبراً","إن جِسمي خير له أَن يوارى",11,"ر",2,0],["احفَظ لسانكَ إن اللسان","حريصٌ على المرء في قتلهِ",12,"ه",1,1],["أحفظ الهيفاء من تياره","ليس بحر الشعر سهلَ المركب",13,"ب",1,0],["أحفظ الأجرام في أفلاكها","وأقيها عاديات الخلل",14,"ل",1,0],["إحْفِرُوا التّلّ يا بَني عَبدِ الأعْ","لى، وَأثيرُوا صُخورَهُ وَتُرَابَهْ",15,"ب",2,0],["احفظ رسول الله وانصر دينه","واقتل مبيح عبادة الأوثان",16,"ن",1,0],["احفَظْ ولا تَنْسَ فإنْ لم تَكُنْ","تَحفظُ فازْدَدْ رغبةً في الطَّلَبْ",17,"ب",1,1],["احفظوا في الإسار قلبا تَمنَّى","شغفا أن يموت فيكم أسيرا",18,"ر",2,0],["احفظ لسانك يا أخيّ","فليسَ هذا بختيار",19,"ر",1,1],["احفروا لي قبرا إذا متّ في الأر","ض بعيدا من ضجّة الأصوات",20,"ت",1,1],["احفروا لي قبرا على شاطىء البحر","لعلّ الأمواج تبكي شبابي",21,"ي",1,0],["احفروا لي قبراً على شاطىء البحر","سميري في وحدَتي ومُقيلي",22,"ل",2,0],["أحفى شواربَه وَلحيتَه معاً","أرأيتَ رأسَ التيسِ ساعةَ يسمطُ",23,"ط",1,1],["اِحفظ سمي محمّد ال","مُنجي الأنامَ منَ الرّدى",24,"د",2,0],["اِحفَظْ مكاني في فؤادِك غائباً","حِفْظي مَكانكَ من لِساني يَثْبتُا",25,"ت",2,0],["احفَظ فُؤادي فَأنتَ تَملكُه","واستُر ضَميري فأنتَ تهتِكُهُ",26,"ك",2,1],["احفظ وصايا العلي مع أمر ابنتِه","إن كنتَ مولودَه بالروح والماء",27,"ا",2,0],["احفظ لسانك تسترح","كم صامتٍ للبر مالك",28,"ك",1,0],["احفظ يمينك والسُلام","من حر نار الغضبِ",29,"ب",1,0],["احفظ الرحمن تحفظ ما بقيت","احفظ الله تجده حيث شيت",30,"ت",1,0],["اِحفَظِ السِرَّ وَاِرعَهُ","اِنَّ اِظهارَهُ خَطَر",31,"ر",1,1],["اِحفَظِ السِرَّ مِثلَما","يُحفَظُ السَمعُ وَالبَصَر",31,"ر",1,0],["احفظوا للفنون معبدها السا","مي وغنوا أنغامها القدسيّه",32,"ه",1,0],["أحْفَظتُمُ قَلبي بِغَدْرِكُمُ","والقلبُ أدْنَى الغَدْرِ يُحفِظُهُ",33,"ظ",2,1],["احفل الفارس منها والفرس","اسفرت عن سرب طير قد نفر",34,"ر",1,0],["أحفيتِ غيرَ ضنينةٍ بهمُ","ولقد يكون سماحُكِ الضَّنّا",35,"ن",2,0],["أحفيتُ رُسغَ جيادها","وتنوءُ بي أعيارُها",36,"ر",3,0],["أحْفظتموني في المعاش فلم أجُزْ","لُطفَ العِتابِ ولا اطبَّاني اللُّوم",37,"م",1,0],["اِحْفَظْ مغيب الناس ما أحسنَوا","وما أساؤا تَحْوِ مَجْداً أثِيلْ",38,"ل",1,1],["أَحفَظُهُ ما وَجَدتُ حِفظاً","مِنهُ وَأَرميهِ إِن رَماني",39,"ي",1,0],["احْفَظْ نِظامي والهَجَنْ بِقَصائِدي","بَحْرُ العِنايَةِ ضِمْنَها مَخْبِيُّ",40,"ي",1,0],["احْفظِ الله واذْكُرَنْهُ دَواماً","ذِكرُهُ للرِّجالِ ماضي السَّلاحِ",41,"ح",1,0],["إِحفَظ وَديعَتَكَ الَّتي اِستودِعتَها","يَومَ الأَعازِبِ إِن وَصلتَ وَإِن لَمِ",42,"م",1,1],["أَحْفَظَهُ ألفاظَها","وزاده في التلقين",43,"ن",1,0],["احفظْ كَرامَةَ من كانت كرامتُهُ","تجري على الضَّيفِ جَرْيَ الماء في العودِ",44,"د",1,0]]}