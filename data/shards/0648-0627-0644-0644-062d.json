{"poems":[[79,"النصر نصك والحسام دليله","https://www.aldiwan.net/poem36377.html","الكامل"],[74,"يا سعد دين الله أين الذي","https://www.aldiwan.net/poem18766.html","السريع"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/142341","الرجز"],[164,"في لحظ عينيه سكر من رحيق فمه","https://www.aldiwan.net/poem58995.html","البسيط"],[255,"يمضي الزمان وأنت هاجر","https://www.aldiwan.net/poem14959.html","مجزوء الكامل"],[376,"ما بال همك لا يزيد","https://www.aldiwan.net/poem57503.html","مجزوء الكامل"],[563,"أنت هو الملفوظ واللافظ","https://www.aldiwan.net/poem34401.html","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38384","السلسلة"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38165","السلسلة"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38016","السلسلة"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70982","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59673","السريع"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55935","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64703","البسيط"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131595",""],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95398","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124720","السريع"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124742","البسيط"],[2177,"","https://poetry.dctabudhabi.ae/diwan/poem/138801",""],[2766,"","https://poetry.dctabudhabi.ae/diwan/poem/124308","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93891","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109799","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100854","الكامل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91337","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91323","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206162","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83141","الكامل"],[4852,"قاصي اللمى","https://www.poetsgate.com/ViewPoem.aspx?id=214360",""],[5038,"دار السلام","https://www.poetsgate.com/ViewPoem.aspx?id=195233",""],[5038,"أسحار الملاح","https://www.poetsgate.com/ViewPoem.aspx?id=195420",""],[5038,"سحرتني","https://www.poetsgate.com/ViewPoem.aspx?id=195425",""],[1420,"اللّّه يشفي وينفي ما بجبهته","https://www.poetsgate.com/ViewPoem.aspx?id=87630",""],[5525,"العمر احبك","https://www.poetsgate.com/ViewPoem.aspx?id=957",""],[5574,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=206009",""],[5599,"حزين وافكر","https://www.poetsgate.com/ViewPoem.aspx?id=213841",""],[5858,"يوم التقينا","https://www.poetsgate.com/ViewPoem.aspx?id=190523",""],[5897,"إليك ...أمي","https://www.poetsgate.com/ViewPoem.aspx?id=157276",""],[5937,"اللحن باب الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=211896",""],[1920,"عشاء فاخر","https://www.poetsgate.com/ViewPoem.aspx?id=191428",""],[5956,"تأخُّر الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=182519",""],[6093,"أَضْحَى التَّحَدُّثُ بِالفُصْحَى مِنَ العَجَبِ (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=184315",""],[6093,"الجلبي","https://www.poetsgate.com/ViewPoem.aspx?id=201050",""],[6124,"ليل وموعد","https://www.poetsgate.com/ViewPoem.aspx?id=128746",""],[6134,"طول البعاد مزق صبري يا غائبين","https://www.poetsgate.com/ViewPoem.aspx?id=169589",""],[6144,"الغش والغلا","https://www.poetsgate.com/ViewPoem.aspx?id=13802",""]],"verses":[["وَاللَّحْنُ قَدْ وَشَجَتْ غُصُونُ ضُرُوبِهِ","فَسَبَى الْعُقُولَ خَفِيفُهُ وَثَقِيلُهُ",0,"ل",2,0],["واللحم كالخبز ولم أدرِ من","قالت به حداتها طيري",1,"ر",2,0],["واللحظ في ذهوله","مغرورق تململا",2,"ل",2,0],["واللحظ واللفظ منه ساحران فخذ","من لحظ مقلته حذرا ومن كلمه",3,"م",2,0],["واللحمُ يَقبُحُ أن أعو","د لبَيعهِ والشعرُ بائر",4,"ر",1,0],["واللحظُ موقعُه على","ما رقَّ رقَّتها شديدُ",5,"د",1,0],["واللحظ والمعلوم والعالم","والعلم والمحفوظ والحافظ",6,"ظ",1,0],["وَاللّحظُ حُسامٌ وَإِنّهُ لَضَعيفٌ","إِنّ فتكَ فيهِ يَكونُ أَقطعَ قرضاب",7,"ب",1,0],["وَاللّحظُ حسامٌ أَراهُ يَلمَعُ سحراً","كَم سلَّ عُقولاً وَكَم تَناهَب أَرواح",8,"ح",1,0],["وَاللَّحظُ حُسامٌ وَفي الجُفونِ سِهامْ","وَالقامَةُ رُمحٌ لَقَد تَمايَل عَسّال",9,"ل",1,0],["واللِّحْزُ لو ملك الدنيا وزينتَها","لذَبّ سِنّوْرَه عن قَيْئِهِ بعصا",10,"ص",2,0],["واللحظ معقود بهم جيرةً","من قاطع للسبب الواصل",11,"ل",1,0],["واللحم غطّسهُ بماءٍ ساخنْ","وخضّهُ بالماء خضًّا ما كنْ",12,"ن",1,0],["وَاللَّحظُ والقدُّ يَسْلُباني","لُبِّيَ لا السَّيْفُ وَالقَناةُ",13,"ه",1,0],["واللحظ الوصاف الأسياف","والثغر الرشاف سلافه",14,"ه",1,0],["واللحم قمع منه في زمن به","الخاروف جاء بدهنه المسكوب",15,"ب",1,0],["واللحم لا تأكلهُ إن حا","زهُ عنكَ مجوسي ورا جدر",16,"ر",1,0],["واللحم واللبن المشروب بيعهما","في الشاء عيب فخل العيب مجتنبا",17,"ب",2,0],["واللحظ كالقلب عين نحو نسوته","ترنو وعين لقوم لا تبارحه",18,"ح",2,0],["واللحم نم بما من سم اودعه","ليدفع السم إذ أهديَ له أكُلا",19,"ل",2,0],["واللحظ بالأمداد منه مساعد","ومهنئ لك بازدياد السؤدد",20,"د",1,0],["واللحظ ينطق والشفاه صوامت","لغة تخطُّ عيوننا كلماتها",21,"ت",3,0],["واللحد اطفأ منه لبا مسرجا","واذاب قلبا كان ابيض صافيا",22,"ي",2,0],["واللحم اطيبه لحم الذراع فكل","منه من عجوة سبعا على الدوم",23,"م",1,0],["وَاللحظ مَكحولٌ يَسلُّ بغنجه","سَيفاً عَلى الأَحشاء بِالأَفكار",24,"ر",1,0],["وَاللَحظُ يُشبهُ نَرجساً","لَو كانَت الأَزهار سُود",25,"د",1,0],["واللحاظ التي أصابت فؤادي","عندها طب هذه البرحاء",26,"ا",2,0],["وَاللَحنُ مِن سِرِّ المَلا","ئِكِ غَيرُ مُبتَذَلِ الصِيانِ",27,"ن",1,0],["واللَّحظُ - أُخرَى - مِن هناكَ إلى هنا ..","كي يَتَّقِي بَرْقًا سرى بثُرَيّا",28,"ي",2,0],["وَاللَّحْظُ شَرْيانُ الْجَمالِ وَشِعْرُهُ","وَخَمائِلٌ فيها النَّوارِسُ تَسْحَرُ",29,"ر",1,0],["وَاللّحْظُ يُحْرِقُ جَفْنَهُ وَهْجُ الْطُلى","في جُبِّ ذِقْنِكَ كابَدَ الْأَهْوالا",30,"ل",2,0],["واللحظ رمى قلبي سهما","فسخا فيْ حاميةٍ يَهْجُرْ",31,"ر",1,0],["واللحم يهجره إلا الخفيف ولا","يدني إليه شراباً من مدامته",32,"ت",2,0],["واللحظة اللي كلها عند وغرور","أشوف قبري بين عينك .. وقلبك",33,"ك",1,0],["١٥- والّلحْظُ بئرٌ بها شِرْبٌ لواردِهِ","والهدْبُ حبْلٌ يجُرُّ الحبَّ مُكْتنِفا",34,"ف",2,0],["واللحين تبغين الفراق الضار؟؟","(عيني ما ترخص دمعها الحاير)",35,"ر",1,0],["واللحنُ يَعزفُ والحَمَائمُ أَنشدَتْ","أُعجوبةَ الإبداعِ في أَزهى الصُّوَرْ",36,"ر",1,0],["واللحن في شفتيك منكسر","في أغنيات الحزن والمللِ",37,"ل",1,0],["واللحن بابُ الذكريات وكلما","أصغت للحن ، قابلته ببابهِ",38,"ب",2,0],["واللَّحمُ يشوى، والرَّغيف ممدَّدٌ","قربَ العصيرِ، تَخالُهُ سكرانا",39,"ن",2,0],["واللحمُ فوق الرزّ بحرٌ مائجٌ","وثغورنا سفُنٌ تهمُّ لتبحرا",40,"ر",2,0],["وَ اللَّحْنُ قَحْطٌ إِذَا مَا حَلَّ أَلْسِنَةً","أَحَالَ كُلَّ نَضِيْرِ القَولِ كَالحَطَبِ",41,"ب",1,0],["وَاللَّحْنُ مِنْ ثغَرِ الحَبِيبِ إِذَا أَتَى","تَلْقَاهُ فِي سَمْعِ المُحِبِّ مَلِيحَا",42,"ح",2,0],["واللّحنُ منْ أوتارِنا في قابعٍ","منْ همِّنا عندَ النَّوى يتبدَّدُ",43,"د",1,0],["واللحظ قد حلل سلبي يا فاتين","فصاب بالنبل قلبي يا قاتلين",44,"ن",1,0],["واللحم معروض بدون أختام رسمية","والميه هيه اللبن ولا اللبن هيه",45,"ي",2,0]]}