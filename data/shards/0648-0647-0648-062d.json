{"poems":[[91,"الشعر ديوان العرب","https://www.aldiwan.net/poem44780.html","مجزوء الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[102,"في طريق الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50125",""],[193,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[226,"بلدة خاب بمن فيها الرجاء","https://www.aldiwan.net/poem55290.html","الرمل"],[240,"مولاي يامن له أياد","https://www.aldiwan.net/poem31781.html","مجزوء البسيط"],[290,"لامني بعض رجال العلم","https://www.aldiwan.net/poem39356.html","مجزوء الرمل"],[333,"أمل لا يزال فوق المرام","https://www.aldiwan.net/poem54962.html","الخفيف"],[543,"طال مني لذا النهار ارتقابي","https://www.aldiwan.net/poem48296.html","عموديه"],[563,"هذه الكائنات أم هي حانه","https://www.aldiwan.net/poem33691.html","الخفيف"],[563,"إنما نحن للإله شئون","https://www.aldiwan.net/poem33829.html","المديد"],[563,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[563,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[563,"إن من آيات ربي هو قال","https://www.aldiwan.net/poem34210.html","الرمل"],[563,"كل مصنوع بمن قد صنعه","https://www.aldiwan.net/poem34365.html","الرمل"],[563,"عالم النطق عالم الأنفاس","https://www.aldiwan.net/poem34442.html","الخفيف"],[563,"خالق الكل واحد","https://www.aldiwan.net/poem34618.html","مجزوء الخفيف"],[563,"إن بين الوجود والموجود","https://www.aldiwan.net/poem34628.html","الخفيف"],[563,"كفة الغيب كفة الحسنات","https://www.aldiwan.net/poem34721.html","الخفيف"],[563,"إنني إن أمت فما أنا ميت","https://www.aldiwan.net/poem34725.html","الخفيف"],[629,"","https://poetry.dctabudhabi.ae/diwan/poem/100596","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99981","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1135,"","https://poetry.dctabudhabi.ae/diwan/poem/124201","الرمل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124730","الرمل"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105384","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203053","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115632","المنسرح"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121615","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121622","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138578",""],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123863","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52131","الرمل"],[4767,"مولد الانتصار","https://www.poetsgate.com/ViewPoem.aspx?id=179794",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5246,"أتَوا يقطعون البيدَ يبغون مكةً","https://www.poetsgate.com/ViewPoem.aspx?id=187045",""],[5302,"قد زاد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=201906",""],[5397,"غير بدع بأن يخون الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=157911",""],[5751,"بينَ موتٍ وموت","https://www.poetsgate.com/ViewPoem.aspx?id=214771",""],[5953,"بإسماعيل تهتم يا رعاء","https://www.poetsgate.com/ViewPoem.aspx?id=93799",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""]],"verses":[["وهو حديث في نهو","ضه قديم في النسب",0,"ب",1,0],["وَهْوَ حَيْثُ الحِفَاظُ فِي كُلِّ حَالٍ","لاَ بِوَعْدٍ يُثْنَى وَلاَ بِوَعِيدِ",1,"د",1,0],["وهو حبّ يجول في خاطرينا","جولة الفكر في المعاني الدقيقة",2,"ق",2,0],["وهوَ حَيٌّ وجسمهُ غير فاني","وَلهُ القبرُ روضةٌ من جنانِ",3,"ن",1,0],["وهو حي ذاهل تحسبه","جثة قد حنطتها القدماء",4,"ا",2,0],["وَهوَ حَرونٌ وَفيهِ بُطءٌ","فَلا جَوادٌ وَلا ذَلولُ",5,"ل",1,0],["وهو حق عند بعض ال","قوم قاض بالعقاب",6,"ب",1,0],["وهو حلم كهذه الأحلام","وهو وهم كسائر الأوهام",7,"م",1,0],["وَهوَ حَاشاهُ أن يَرى سيفَه المَس","لُولَ يوما بُمغمَدٍ في قَرَابِ",8,"ب",1,0],["وهو حق به تحقق كوني","لا بسحر من السوى وكَهَانه",9,"ن",2,0],["وهو حق هو الوجود على ما","هو فيه والفتح غيثٌ هتون",10,"ن",1,0],["وهو حسن الوجه لا ينكره","غير أعمى عنه أو من يتعامى",11,"م",2,0],["وهو حق وسواه","باطل لمعة آل",12,"ل",1,0],["وهو حق وسواه باطل","وإلى الحق رجوع ومآل",13,"ل",1,0],["وهو حق وسواه باطل","لا يساوي الحق فاترك بدعه",14,"ع",2,0],["وهو حق والعلم حق وفيه","كل هذا الترتيب في الأجناس",15,"س",1,0],["وهو حد لمطلق","عنه فيه الفوائد",16,"د",1,0],["وهو حرف محمدي شريف","هو عين الآباء عين الجدود",17,"د",1,0],["وهو حقٌّ ذاتاً ووصفاً وإني","باطل زاهق بغير ثبات",18,"ت",1,0],["وهو حي في قبر جسم محب","بغذاء الهوى له تقويت",19,"ت",1,0],["وهو حكم صعب على غير ما را","ض هواه بعقله وهداه",20,"ا",2,0],["وَهُوَ حَبِيبُ اللهِ في أرْضِهِ","مؤيَّداً بالْوَحي والْقُدْسِ",21,"س",1,0],["وهو حسبي إليه فوضت أمري","حسبي الله مقعدا ومطارا",22,"ر",2,0],["وهو حظي من زماني","فلهذا صار أسود",23,"د",1,0],["وَهُوَ حَنوخ بِالبَيانِ أَعجَما","صَلّى عَلَيهِ رَبُّنا وَسَلَّما",24,"م",2,0],["وهو حرٌّ وأناسٌ زعموا","أنه في الدين مملوكٌ غلق",25,"ق",1,0],["وهو حرٌّ حين ما كاتبته","وعليه دفع ما كان نمق",25,"ق",1,0],["وهو حسبي من كل سوءٍ وحسبي","أن أراه إن مسني السوء حسبا",26,"ب",2,0],["وهو حلو ساد الذباب عليه","فنبت عنه أنفس الأحرار",27,"ر",1,0],["وهو حبيبٌ لمن تأمّلهُ","وليسَ فيما شرحتهُ خلفُ",28,"ف",1,0],["وهْو حِزْبِي ووِرْدُ كُلِّ لسانٍ","ولَكم أخْصَبَتْ به الشَّهْباءُ",29,"ا",2,0],["وهْو حَيٌّ في قَبْرِه ورسولٌ","لم يُوَرِّثْ حَيّاً ذَوُو الأحْلامِ",30,"م",1,0],["وهو حياً تقمص العز لكن","ميتاً صغر العدى منه قدرا",31,"ر",2,0],["وهو حسام جيد وجودته","بالفتح قد بانت وجادت مزنته",32,"ه",1,0],["وهو حيٌّ بعوده منصورا","وجذلتم بملتقاه جميعاً",33,"ع",2,0],["وهو حسبي نعم الوكيل وإن يخذل","عبدا وافاه بالقلب خاشع",34,"ع",1,0],["وهو حقاً بالأماني ملتهِ","بأماني نَيلِ ما لم يكنِ",35,"ن",1,0],["وهو حصن مِن هَوى نفس تردَّت","قد نجا مِن نفسه مَن جاء داخل",36,"ل",1,0],["وهو حفاً أفضى حفاؤك في التقى","غليه فعقباه سنى وسناء",37,"ا",2,0],["وهو حملوا بين الحشايا حوائجاً","على عرفات بثَّها الكلُّ داعيا",38,"ي",2,0],["وهو حليم إذا هوى وإذا اس","تبد خل بصدقه التزما",39,"م",2,0],["وهو حبل الله المتين وثقل","بالمعالي عديله القرآن",40,"ن",1,0],["وهوَ حَيرانُ بينَ مَوتٍ وموتٍ","كيفَ يبني لفرحةِ النهرِ شكلا",41,"ل",2,0],["وهو حكم يدوم وليس يفنى","وهذا فيه لله النّهاء",42,"ا",2,0],["وهو حمار موقف ببابه","أو هرة هراء أو كلبٌ كلب",43,"ب",1,0]]}