ttps://www.aldiwan.net/poem66970.html","الكامل"],[404,"الحمد كل الحمد للخلاق","https://www.aldiwan.net/poem33620.html","الكامل"],[404,"أترى يعود من الحمى قلبي","https://www.aldiwan.net/poem34152.html","الكامل"],[433,"متعتب من غير ما سبب","https://www.aldiwan.net/poem12570.html","أحذ الكامل"],[435,"كم كان فيها من كرام سادة","https://www.aldiwan.net/poem25692.html","الكامل"],[439,"جمرة من صدى صوتها","https://www.aldiwan.net/poem505.html",""],[440,"قل للخلافة قد بلغت مناك","https://www.aldiwan.net/poem34895.html","الكامل"],[444,"تحت الجبال خمائل وغياض","https://www.aldiwan.net/poem55967.html","عموديه"],[459,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[459,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[465,"قف بالخليج فإنه","https://www.aldiwan.net/poem3518.html","عموديه"],[465,"هل هز بالأعطاف سمر صعاده","https://www.aldiwan.net/poem3623.html","عموديه"],[516,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[516,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[539,"قال البيان لمن أراد مديحه","https://www.aldiwan.net/poem48155.html","عموديه"],[539,"وافيت ربع الفضل كم من مرة","https://www.aldiwan.net/poem48248.html","عموديه"],[543,"صل من هويت ودع مقالة حاسد","https://www.aldiwan.net/poem34051.html","الكامل"],[554,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[576,"يا منية النفس يا مسكية النفس","https://www.aldiwan.net/poem2925.html","البسيط"],[576,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[576,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[587,"هيهات أن يسخو ولو بسلامه","https://www.aldiwan.net/poem17766.html","الكامل"]],"verses":[["مُتَعَرِّضٌ إِمّا لِلَونٍ حائِلٍ","بَينَ الذَوائِبِ أَو لِعُمرٍ فانِ",0,"ن",1,0],["مُتَعَلِّقينَ عِنانَ كُلِّ مُسَوَّمٍ","يَشأى عُجاجَتِهِ بِوَقعِ الأَربَعِ",1,"ع",1,0],["مُتعَبٍ يَشكو أَذى السَيرِ عَلى","نَقِبِ المَنسِمِ مَجزولِ المَطا",2,"ا",1,0],["مِتَّ عَن يافِعٍ وَخَمسِ بَناتٍ","لَم تُخَلِّف لَها سِوى الذِكرَياتِ",3,"ت",1,0],["مُتَعَثِّراً يَنتابُني وَهَنٌ","مُتَرَنِّحاً كَالشارِبِ الثَمِلِ",4,"ل",1,0],["متعطّر فيها النسيم كأنّما","جيب النسيم على الشذا مزرور",5,"ر",1,0],["مُتَعَوِّدٌ لَحِنٌ يُعيدُ بِكَفِّهِ","قَلَماً عَلى عُسُبٍ ذَبُلنَ وَبانِ",6,"ن",1,0],["متعوني عنكم بمسموع وعدٍ","إن بخلْتم عليَّ بالملحوظ",7,"ظ",1,1],["متّع لواحظنا بحسنك ساعةً","ودع النفوس تروح وهي توالف",8,"ف",1,1],["متّع لواحظنا التي أضنيتها","لما اتخذتَ إلى البعاد سبيلا",9,"ل",2,1],["مُتَعَزِّزاً مُتَحَرِّزاً مُتَواضِعاً","مُتَبَدِّلَ الأَشباحِ وَالأَرواحِ",10,"ح",1,0],["مَتِّع الظبْي من جنى غُصنك اللد","نِ يُمَتِّعْكَ منه قبل انخِضادِهْ",11,"د",2,0],["مُتِّعتْ بالسيد المذ","كور في يوم الفخار",12,"ر",1,0],["مُتعاتُ وجهك في بديهتها","جُددٌ وفي أعقابها الأُخَر",13,"ر",1,0],["متعرِّضٌ للفَرْس نابِحُها","والليثُ لا يرضاه للفرس",14,"س",1,0],["متَّعتُ منه مسامعي ومراشفي","بنثير لؤلؤِهِ وماء رصيفه",15,"ف",2,0],["مَتِّعي هذه المراشف من ري","قِك يا من يُمَتِّع الآذانا",16,"ن",2,0],["مُتَعَثِّراتٍ بِالظَلامِ كَأَنَّما","حالَ الظَلامُ أَساوِدا وَأُسودا",17,"د",2,0],["مُتَعَلِّماً مِنهُ التَواضُعَ وَالنَدى","وَالصَفحَ عَن عَبَثِ الجَهولِ الأَحمَقِ",18,"ق",1,0],["مَتِّع لِحاظَكَ في النُجومِ وَحُسنِها","فَلَسَوفَ تَمضي وَالكَواكِبُ باقِيَه",19,"ي",2,0],["مُتَعَثِّراً بَيْنَ الصُّخورِ","يَغُورُ في تِلْكَ الظُّلَمْ",20,"م",1,0],["متع حياتك وأغتنم لذاتها","من قبل ان تلقى المنون زؤاما",21,"م",2,0],["متع السمع والبصر","قبل ان تبلغ الكبر",22,"ر",1,1],["متعثرا في رأيه","متورّطا في كل مأتم",23,"م",1,0],["متعاشقان من الزهور تبديا","ببديع مرأى في الغصون عجيب",24,"ب",1,1],["مُتَعَوِّداً لُبسَ الدُروعِ يَخالُها","في البَردِ خَزّاً وَالهَواجِرِ لاذا",25,"ذ",2,0],["متعلِّلاً بالوَعْدِ لا","نُجْحٌ ولا رَدٌّ صَرِيحُ",26,"ح",1,0],["مُتِّعتُ مِنكِ بِغَيرِ الهَجرِ وَالغَضَبِ","اليَومَ أَوَّلُ يَومٍ كانَ في رَجَبِ",27,"ب",1,1],["مُتَعَسِّفاتٍ ماتَزالُ رُواتُها","تَأبى عَلَيها أَن تَسيرَ قَواصِدا",28,"د",2,0],["مُتعَةُ العَينِ مِن حَلاوَةُ مَرأى","وَرِضى النَفسِ مِن وَثاقِهِ أَسرِ",29,"ر",1,0],["مُتِّعا بِاللِقاءِ عِندَ الفِراقِ","مُستَجيرينَ بِالبُكا وَالعِناقِ",30,"ق",1,1],["مُتَعَلٍّ عَلى الخُطوبِ إِذِ العا","ثِرُ كابٍ في صَرفِها ما يُقالُ",31,"ل",1,0],["مُتَعَتِّبٌ في حَيثُ لا مُتَعَتِّبٌ","إِن لَم يَجِد جُرماً عَلَيَّ تَجَرَّما",32,"م",2,0],["مُتَعَزِّزٍ بِاللَهِ أَصبَحَ نِعمَةً","لِلَّهِ سابِغَةً عَلى الإِسلامِ",33,"م",1,0],["مُتَعَبِّثاتٍ بِالنُباحِ وَراءَنا","حَتّى طَرَحنا زادَنا فَرَضينا",34,"ن",2,0],["مُتَعَرِّضٌ لِلهَجرِ وَهوَ جَبانُ","وَسِلاحُهُ لِعَدُوِّهِ الهِجرانُ",35,"ن",1,1],["مُتَعالِمُ النَفَرِ الَّذينَ هُمُ هُمُ","بِالتَبلِ لا غُمُرٌ وَلا أَفتارُ",36,"ر",1,0],["متعالياً حتى الأشعة مشرقاً","متالقاً كالكوكب السيَّارِ",37,"ر",1,0],["مُتَعانِقُ الحَوذانِ تَنشُرُهُ الصَبا","خَضِلاً وَتَطويهِ كَطَيِّ الرَفرَفِ",38,"ف",1,0],["مَتَعَت كَما مَتَعَ الضُحى في حادِثٍ","داجٍ كَأَنَّ الصُبحَ فيهِ مَغرِبُ",39,"ب",1,0],["مُتَعَطِّفٌ مِثلَ السِوارِ كَأَنَّهُ","وَالزَهرُ يَكنُفُهُ مَجَرُّ سَماءِ",40,"ا",2,0],["مُتَعَذِّبٌ مازالَ يَضرِبُ يَومَهُ","كَدّاً وَيُحنِقُ لَيلَهُ إِشفاقا",41,"ق",2,0],["متعذِّبٌ بنهارِهِ","حتى يزورَ المكتبهْ",42,"ب",2,0],["مُتَعَطِّفينَ عَلى خَناجِرِهِم","سُلُبٍ لِشُربِهِم مِنَ القِرَبِ",43,"ب",1,0],["مُتَعَمِّقٍ في دينِهِ مُتَفَقِّهٍ","مُتَبَصِّرٍ في العِلمِ وَالأَخبارِ",44,"ر",1,0],["مُتَعَقرِبِ الصُدغَينِ في لَحَظاتِهِ","فِتَنٌ لَها مَقرونَةٌ لِبَواثِقِ",45,"ق",1,0],["مُتَعَقربِ الصدغينِ في لحظاتهِ","فِتَنُ لها مقرونةٌ ببوائق",46,"ق",1,0],["مَتِّع صَديقَكَ غَيرَ مُخلِقِ وَجهِهِ","وَإِذا سُئِلتَ فَلا تَكُن جُلمودا",47,"د",2,0],["مَتَعَرِّضينَ لِسَيِّدٍ","عَجلانَ بِالمَعروفِ زائِد",48,"د",1,0],["مُتَعَرِّياً في صَيفِهِ وَشِتائِهِ","ما ريعَ قَطُّ لِمَلبَسٍ يَتَخَرَّقُ",49,"ق",1,0],["متع حَياتَك قَبلَ أَن","تودي بمهجتك الحتوف",50,"ف",1,0],["متع حياتك وارضع","دنيا عليك تجود",51,"د",1,1],["متع حَياتك واِغتنم","لذاتها قبل الفوات",52,"ت",1,0],["مُتَعرّفاً صُوَرَ الخلائق سابراً","أعماقَ أرواحٍ وَغَورَ سرائرِ",53,"ر",1,0],["متعت ليلى بالحياة","وبلغت الأربا",54,"ب",2,0],["مُتَعَوِّدٌ قَهْرَ العِدَى","كَالنُّورِ فِي كَشْفِ الظُّلَمْ",55,"م",1,0],["مُتَعَدَّداً بِصِفَاتِهِ مُتَفَرِّداً","بِحَصَاتِهِ مُتَفَرِّغاً مَشْغُولاً",56,"ل",2,0],["مُتُعَهِّداً أَبَداً رَعِيَّتَهُ فَلاَ","سَأْمٌ يُثَبِّطُهُ وَلاَ أَعْيَاءُ",57,"ا",2,0],["متَعَلِّمٌ فِيهَا الهِجَاءَ وَبِي","نَزَقٌ فَلاَ أَصْغُو لإِرْشَادِ",58,"د",1,0],["مُتَعَوِّداً أَلّا مَحيصَ لِطَرفِهِ","عَن لَوحِهِ حَتّى يعبهُ مُمحَّصا",59,"ص",2,0],["مَتْعَبَةُ الإِنسانِ في حِسِّهِ","وشِقْوةُ الإِنسان من فِكْرِه",60,"ر",2,0],["متَّع فؤادَك بالربيع؛ فإنه","لحنُ الزمانِ، وبسمةُ الأقدار",61,"ر",1,0],["متعب طال عمره وشقاه","وتمادت جراحة ودموعه",62,"ع",2,0],["متعب يعبر الطريق ويمضي","وحده يتبع الخيال الحزينا",63,"ن",2,0],["متعهُ الشاعرِ المفكرِ يقظانَ","ومَسْرى خيالِه وهو حالِم",64,"م",1,0],["مُتعَب الذهنِ بالسياسة لا ينُسيه","أثقالَها جِمالُ المصيف",65,"ف",1,0],["مَتّعِ العينَ إنَّ حُسناً تراهُ","الآنَ من بعدِ ساعةٍ منهوب",66,"ب",1,0],["متعومس .. وحزن النبلاء مرموق","يعني لو أحتاج لك ماجيت أسألك",67,"ك",1,0],["متّع لحظك في النجوم وحسنها","فلسوف تمضي والكواكب باقية",68,"ي",2,0],["متّعتُ منه مسامعي ومراشفي","بنثير لؤلئِه وماء رصيفه",69,"ف",2,0],["متعالياً حتى الأشعةِ مشرقاً!","متألفاً كالكوكبِ السيَّارِ!",70,"ر",1,0],["متعطر فيها النسيم كأنما","جيب النسيم على شذا مزرور",71,"ر",1,0],["مُتَعانِقين عَلى فِراش صِيانَةٍ","مُتَحذرين مِن الصَباح المُسفر",72,"ر",1,0],["مُتَعاظم وَيَمينهُ مَمدودة","تَرجو النَدا وَنَشاء مِن يَتَصَدَقُ",73,"ق",1,0],["متع اللَه سَيدي بِحياة","وَفَداهُ بِكُلّ ضد عَنيد",74,"د",1,1],["متعة العين من ملاحة مرأىً","ومني النفس من صباحة مجلى",75,"ل",2,0],["مُتَعَزِّراً مُتَذِّلِّلاَ مُتَهَيِّباً","مُتَهَيِّباً مُتَخَوَّفاً مُتَخَوفاً",76,"ف",2,0],["متِّع لواحظّنا حتّى نقولَ لها","لقد رأيتِ جميعَ الناس في رجلِ",77,"ل",1,0],["مُتِّعتَ ما مَتَعَ النَهارُ بِقُربِهِ","أَبَداً وَدامَ بِكَ الزَمانُ مُمَتَّعا",78,"ع",2,0],["مُتَعَرِّضاً لِنِضالِ مَن هُوَ فَوقَهُ","جَهلاً بِسَهمٍ قَد خَلا مِن فوقِهِ",79,"ق",2,0],["مُتَعَوِّضاً مِن عِزِّ مَن هُوَ فَرعُهُ","ذُلّاً يُحَدِّثُ عَنهُ جيلٌ جيلا",80,"ل",2,0],["متعظّم برجاله","العزّ من سلطانه",81,"ن",2,0],["متعظما بثيابه","للمجد مطرحا مضيعا",82,"ع",2,0],["متعرّضا لحوائج ال","إخوان ماض في احتسابه",83,"ب",2,0],["متعطش والذكريات هواتفٌ","تهفو بخافقه الحنون وتنهل",84,"ل",1,0],["مُتَعَثِّراً نهبَ الوساوِسِ","والمخاوِفِ والظنونِ",85,"ن",1,0],["متعت بالأنس والأفراح مبتهجاً","ودام سعدك ذا يعلو وينتشر",86,"ر",1,0],["متّع جفوني بذاك المنظر الحسن","واستبق روحي فان الجسم فيك فني",87,"ن",2,1],["متّعت فيها ناظريّ وربما","أدركت منها الضم والتقبيلا",88,"ل",2,0],["متّعه بالعيون والآماق","بنور وجهٍ كاشفٍ عن ساقِ",89,"ق",1,0],["متعذراً عن لبثه بمقاله","ذو الدل يأبى طبعه الأذلالا",90,"ل",2,0],["متعجب منك الحسود وربما","تدهى الدنى من العلى عجائب",91,"ب",1,0],["متعرض العريض فضلك يا رَسو","ل اللَه يوم الفقر والاملاق",92,"ق",1,0],["مَتَّعتُ أَحمَدَ بِالرَفاهَةِ وَالهَنا","وَبَلَغتُ أَعظَمَ رُتبَةٍ عَلياءِ",93,"ا",2,0],["متع اللَه عصرنا بِشَريف","من بنيهم بَل من أَجل بنيهم",94,"م",1,0],["مُتَعَثِّراً في غَربِهِ","وَالدَمعُ فيهِ ما تَعَثَّر",95,"ر",1,0],["مَتِّع لِحاظَكَ مِن خِلٍّ تُوَدِّعُهُ","فَلا أَخٌ لَكَ بَعدَ اليَومِ في الوادي",96,"ي",1,1],["مُتَعوِّدٌ حملَ الكبا","ئِر فَوقَ أعناقِ الأكابِر",97,"ر",1,0],["مُتعرضاً للحمدِ مَع","روفاً بصدقِ الحامدِ",98,"د",1,0],["متعامياً عن نور كل فضيلةٍ","فكأنه الخفاش في وكناتها",99,"ت",3,0],["متعذباً بسماعه وبلحظه","وبذوقه وبجوعه وظَمائه",100,"ا",3,0],["متعت فيها بالحواس وبالذي","أهواه من ولد ومن أرزاق",101,"ق",1,0],["متعرضاً للبرق أنشده","يا برق حيِّ منازل السرب",102,"ب",1,0],["متعتّبٌ من غيرِ ما سببِ","راضٍ به مسٌّ من الغضبِ",103,"ب",1,1],["مُتَعاوِنينَ على الدِّيانَةِ والتّقى","للهِ في الإِسْرارِ والإِعْلان",104,"ن",1,0],["متعي قلبيَ الحزينَ بوهمٍ","إنّ سرّ الحياة وهمٌ، وكانا !.",105,"ن",2,0],["مُتَعَوِّذِينَ من الفَناءِ بصَفْحَتَيْ","سيفٍ لمثلِ دمائِهِم سَفَّاكِ",106,"ك",1,0],["متع لحاظك بالطبيعة إنها","نعم الزمان ومالها اعواض",107,"ض",1,0],["متعرّفاتٌ بالدماء كأنما","ضَفَّرن من عَذَبِ الرماح نواصيا",108,"ي",2,0],["متعلِّلاتٍ بعدَ طارقِةِ النوَى","أو أبرأت داءَ الجوى أو علَّلتْ",109,"ت",1,0],["متعطف كالأيم ذعرا