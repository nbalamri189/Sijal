لامنا","https://www.poetsgate.com/ViewPoem.aspx?id=192918",""],[5956,"يستشرف ابني بالحِجى المستقبَلا","https://www.poetsgate.com/ViewPoem.aspx?id=193298",""],[5956,"أرجوك لا تمرض","https://www.poetsgate.com/ViewPoem.aspx?id=193797",""],[5956,"مُعَذبان باتباع طقوس الكرم المتواصلة","https://www.poetsgate.com/ViewPoem.aspx?id=193944",""],[5956,"أخَّرْتُ في أغلى الصحاب قصائدي","https://www.poetsgate.com/ViewPoem.aspx?id=214991",""],[5970,"متع النفس بما تهوى فما","https://www.poetsgate.com/ViewPoem.aspx?id=130585",""],[6056,"أبجدية حروفك","https://www.poetsgate.com/ViewPoem.aspx?id=130326",""],[6068,"قَدْ جُزْتُ بالسلفيّ عَادِلْ -09-","https://www.poetsgate.com/ViewPoem.aspx?id=175812",""],[6068,"هل تارك روحي لنصح العاذل","https://www.poetsgate.com/ViewPoem.aspx?id=181693",""],[6093,"صمت المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=197106",""],[6093,"الزمكان","https://www.poetsgate.com/ViewPoem.aspx?id=198343",""],[6093,"خليفة الكميت","https://www.poetsgate.com/ViewPoem.aspx?id=206828",""],[6102,"قَبِّليني","https://www.poetsgate.com/ViewPoem.aspx?id=184635",""],[3520,"هَنيئاً لدينِ الهُدَى الأشْرَفِ","https://diwany.org/%D9%87%D9%8E%D9%86%D9%8A%D8%A6%D8%A7%D9%8B-%D9%84%D8%AF%D9%8A%D9%86%D9%90-%D8%A7%D9%84%D9%87%D9%8F%D8%AF%D9%8E%D9%89-%D8%A7%D9%84%D8%A3%D8%B4%D9%92%D8%B1%D9%8E%D9%81%D9%90/","المتقارب"],[243,"يا نهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68172&r=&rc=164",""],[6202,"إن تمكري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86708&r=&rc=9",""],[463,"أهفو لعلويَّ الرياح إذا جرتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59997&r=&rc=53",""],[572,"لستُ على عذلِكَ صَبَّارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9316&r=&rc=173",""]],"verses":[["مُتَعَرِّضٌ إِمّا لِلَونٍ حائِلٍ","بَينَ الذَوائِبِ أَو لِعُمرٍ فانِ",0,"ن",1,0],["مُتَعَلِّقينَ عِنانَ كُلِّ مُسَوَّمٍ","يَشأى عُجاجَتِهِ بِوَقعِ الأَربَعِ",1,"ع",1,0],["مُتعَبٍ يَشكو أَذى السَيرِ عَلى","نَقِبِ المَنسِمِ مَجزولِ المَطا",2,"ا",1,0],["مِتَّ عَن يافِعٍ وَخَمسِ بَناتٍ","لَم تُخَلِّف لَها سِوى الذِكرَياتِ",3,"ت",1,0],["مُتَعَثِّراً يَنتابُني وَهَنٌ","مُتَرَنِّحاً كَالشارِبِ الثَمِلِ",4,"ل",1,0],["متعطّر فيها النسيم كأنّما","جيب النسيم على الشذا مزرور",5,"ر",1,0],["مُتَعَوِّدٌ لَحِنٌ يُعيدُ بِكَفِّهِ","قَلَماً عَلى عُسُبٍ ذَبُلنَ وَبانِ",6,"ن",1,0],["متعوني عنكم بمسموع وعدٍ","إن بخلْتم عليَّ بالملحوظ",7,"ظ",1,1],["متّع لواحظنا بحسنك ساعةً","ودع النفوس تروح وهي توالف",8,"ف",1,1],["متّع لواحظنا التي أضنيتها","لما اتخذتَ إلى البعاد سبيلا",9,"ل",2,1],["مُتَعَزِّزاً مُتَحَرِّزاً مُتَواضِعاً","مُتَبَدِّلَ الأَشباحِ وَالأَرواحِ",10,"ح",1,0],["مَتِّع الظبْي من جنى غُصنك اللد","نِ يُمَتِّعْكَ منه قبل انخِضادِهْ",11,"د",2,0],["مُتِّعتْ بالسيد المذ","كور في يوم الفخار",12,"ر",1,0],["مُتعاتُ وجهك في بديهتها","جُددٌ وفي أعقابها الأُخَر",13,"ر",1,0],["متعرِّضٌ للفَرْس نابِحُها","والليثُ لا يرضاه للفرس",14,"س",1,0],["متَّعتُ منه مسامعي ومراشفي","بنثير لؤلؤِهِ وماء رصيفه",15,"ف",2,0],["مَتِّعي هذه المراشف من ري","قِك يا من يُمَتِّع الآذانا",16,"ن",2,0],["مُتَعَثِّراتٍ بِالظَلامِ كَأَنَّما","حالَ الظَلامُ أَساوِدا وَأُسودا",17,"د",2,0],["مُتَعَلِّماً مِنهُ التَواضُعَ وَالنَدى","وَالصَفحَ عَن عَبَثِ الجَهولِ الأَحمَقِ",18,"ق",1,0],["مَتِّع لِحاظَكَ في النُجومِ وَحُسنِها","فَلَسَوفَ تَمضي وَالكَواكِبُ باقِيَه",19,"ي",2,0],["مُتَعَثِّراً بَيْنَ الصُّخورِ","يَغُورُ في تِلْكَ الظُّلَمْ",20,"م",1,0],["متع حياتك وأغتنم لذاتها","من قبل ان تلقى المنون زؤاما",21,"م",2,0],["متع السمع والبصر","قبل ان تبلغ الكبر",22,"ر",1,1],["متعثرا في رأيه","متورّطا في كل مأتم",23,"م",1,0],["متعاشقان من الزهور تبديا","ببديع مرأى في الغصون عجيب",24,"ب",1,1],["مُتَعَوِّداً لُبسَ الدُروعِ يَخالُها","في البَردِ خَزّاً وَالهَواجِرِ لاذا",25,"ذ",2,0],["متعلِّلاً بالوَعْدِ لا","نُجْحٌ ولا رَدٌّ صَرِيحُ",26,"ح",1,0],["مُتِّعتُ مِنكِ بِغَيرِ الهَجرِ وَالغَضَبِ","اليَومَ أَوَّلُ يَومٍ كانَ في رَجَبِ",27,"ب",1,1],["مُتَعَسِّفاتٍ ماتَزالُ رُواتُها","تَأبى عَلَيها أَن تَسيرَ قَواصِدا",28,"د",2,0],["مُتعَةُ العَينِ مِن حَلاوَةُ مَرأى","وَرِضى النَفسِ مِن وَثاقِهِ أَسرِ",29,"ر",1,0],["مُتِّعا بِاللِقاءِ عِندَ الفِراقِ","مُستَجيرينَ بِالبُكا وَالعِناقِ",30,"ق",1,1],["مُتَعَلٍّ عَلى الخُطوبِ إِذِ العا","ثِرُ كابٍ في صَرفِها ما يُقالُ",31,"ل",1,0],["مُتَعَتِّبٌ في حَيثُ لا مُتَعَتِّبٌ","إِن لَم يَجِد جُرماً عَلَيَّ تَجَرَّما",32,"م",2,0],["مُتَعَزِّزٍ بِاللَهِ أَصبَحَ نِعمَةً","لِلَّهِ سابِغَةً عَلى الإِسلامِ",33,"م",1,0],["مُتَعَبِّثاتٍ بِالنُباحِ وَراءَنا","حَتّى طَرَحنا زادَنا فَرَضينا",34,"ن",2,0],["مُتَعَرِّضٌ لِلهَجرِ وَهوَ جَبانُ","وَسِلاحُهُ لِعَدُوِّهِ الهِجرانُ",35,"ن",1,1],["مُتَعالِمُ النَفَرِ الَّذينَ هُمُ هُمُ","بِالتَبلِ لا غُمُرٌ وَلا أَفتارُ",36,"ر",1,0],["متعالياً حتى الأشعة مشرقاً","متالقاً كالكوكب السيَّارِ",37,"ر",1,0],["مُتَعانِقُ الحَوذانِ تَنشُرُهُ الصَبا","خَضِلاً وَتَطويهِ كَطَيِّ الرَفرَفِ",38,"ف",1,0],["مَتَعَت كَما مَتَعَ الضُحى في حادِثٍ","داجٍ كَأَنَّ الصُبحَ فيهِ مَغرِبُ",39,"ب",1,0],["مُتَعَطِّفٌ مِثلَ السِوارِ كَأَنَّهُ","وَالزَهرُ يَكنُفُهُ مَجَرُّ سَماءِ",40,"ا",2,0],["مُتَعَذِّبٌ مازالَ يَضرِبُ يَومَهُ","كَدّاً وَيُحنِقُ لَيلَهُ إِشفاقا",41,"ق",2,0],["متعذِّبٌ بنهارِهِ","حتى يزورَ المكتبهْ",42,"ب",2,0],["مُتَعَطِّفينَ عَلى خَناجِرِهِم","سُلُبٍ لِشُربِهِم مِنَ القِرَبِ",43,"ب",1,0],["مُتَعَمِّقٍ في دينِهِ مُتَفَقِّهٍ","مُتَبَصِّرٍ في العِلمِ وَالأَخبارِ",44,"ر",1,0],["مُتَعَقرِبِ الصُدغَينِ في لَحَظاتِهِ","فِتَنٌ لَها مَقرونَةٌ لِبَواثِقِ",45,"ق",1,0],["مُتَعَقربِ الصدغينِ في لحظاتهِ","فِتَنُ لها مقرونةٌ ببوائق",46,"ق",1,0],["مَتِّع صَديقَكَ غَيرَ مُخلِقِ وَجهِهِ","وَإِذا سُئِلتَ فَلا تَكُن جُلمودا",47,"د",2,0],["مَتَعَرِّضينَ لِسَيِّدٍ","عَجلانَ بِالمَعروفِ زائِد",48,"د",1,0],["مُتَعَرِّياً في صَيفِهِ وَشِتائِهِ","ما ريعَ قَطُّ لِمَلبَسٍ يَتَخَرَّقُ",49,"ق",1,0],["متع حَياتَك قَبلَ أَن","تودي بمهجتك الحتوف",50,"ف",1,0],["متع حياتك وارضع","دنيا عليك تجود",51,"د",1,1],["متع حَياتك واِغتنم","لذاتها قبل الفوات",52,"ت",1,0],["مُتَعرّفاً صُوَرَ الخلائق سابراً","أعماقَ أرواحٍ وَغَورَ سرائرِ",53,"ر",1,0],["متعت ليلى بالحياة","وبلغت الأربا",54,"ب",2,0],["مُتَعَوِّدٌ قَهْرَ العِدَى","كَالنُّورِ فِي كَشْفِ الظُّلَمْ",