,[4888,"ضياء الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=207674",""],[4926,"إلى متى أنت باللَّذات مشغول","https://www.poetsgate.com/ViewPoem.aspx?id=171096",""],[4939,"أجعل صديقَكَ نفسَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=135264",""],[5111,"مُدُن النِّسْيَانِ","https://www.poetsgate.com/ViewPoem.aspx?id=212521",""],[5183,"عُلْيَا المَناَصِب","https://www.poetsgate.com/ViewPoem.aspx?id=186458",""],[5183,"حد الطور","https://www.poetsgate.com/ViewPoem.aspx?id=186609",""],[5185,"عساكر الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=118567",""],[5206,"الدُّنيا والنفس","https://www.poetsgate.com/ViewPoem.aspx?id=187386",""],[5206,"في الصديق والصداقة","https://www.poetsgate.com/ViewPoem.aspx?id=187434",""],[5230,"أوصاف الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=12271",""],[5278,"يا ظبيةَ الإنس","https://www.poetsgate.com/ViewPoem.aspx?id=202525",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5419,"لماذا أنت بالذات؟","https://www.poetsgate.com/ViewPoem.aspx?id=31454",""],[5431,"مهما فعلت وكيفما ...","https://www.poetsgate.com/ViewPoem.aspx?id=198603",""],[5458,"يارب","https://www.poetsgate.com/ViewPoem.aspx?id=72281",""],[5459,"دوح النهى","https://www.poetsgate.com/ViewPoem.aspx?id=198288",""],[5459,"هَذِي الجِنان ..","https://www.poetsgate.com/ViewPoem.aspx?id=200767",""],[5512,"المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=204242",""],[5573,"أشعلت لي في داجر الليل مصباح","https://www.poetsgate.com/ViewPoem.aspx?id=200076",""],[5616,"آلاء","https://www.poetsgate.com/ViewPoem.aspx?id=205243",""],[5660,"أُغالِبُ شَوقَ القَلبِ بَل كُنتُ أُغلَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33986",""],[5718,"قدس أقصانا","https://www.poetsgate.com/ViewPoem.aspx?id=213783",""],[5750,"كوني مع الليل","https://www.poetsgate.com/ViewPoem.aspx?id=214629",""],[5879,"غربل ترابك","https://www.poetsgate.com/ViewPoem.aspx?id=215401",""],[5939,"اضرب كي تقطع رأس الأفعى","https://www.poetsgate.com/ViewPoem.aspx?id=136646",""],[5939,"أعطيني هذا الدواء!","https://www.poetsgate.com/ViewPoem.aspx?id=185502",""],[6056,"نفحة نسانيس","https://www.poetsgate.com/ViewPoem.aspx?id=130322",""],[6102,"هيت لك","https://www.poetsgate.com/ViewPoem.aspx?id=185305",""],[6124,"يا ابنة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=101248",""],[6152,"عانق خيالي ما استطعت","https://www.poetsgate.com/ViewPoem.aspx?id=213211",""],[5190,"غيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78340&r=&rc=53",""]],"verses":[["وأقْطَعُ بالمُنى عُمْري ونَفْسي","أُعَلِّلُها بآمالٍ فِساحِ",0,"ح",1,0],["وَاِقطِفي مِن كُلِّ رَوضٍ زَهرَةً","وَاِجعَليها لِتَحايانا كِماما",1,"م",2,0],["وَاَقطَع حِبالَةَ مَن يُريدُ سِواهُمُ","في حُبِّهِ تَحلُل بِدارِ نَجاةِ",2,"ه",1,0],["وَأَقطَعُ الخَرقَ قَد بادَت مَعالِمُهُ","فَما يُحَسُّ بِهِ عَينٌ وَلا أَثَرُ",3,"ر",1,0],["واقطفِ الوردَ من خدودي وجيدي","ونُهودي وافْعَلْ بهِ مَا تَرُومُهْ",4,"م",2,0],["واقطُفي من كلإِ الأَرضِ","ومَرعاها الجَديدْ",5,"د",1,0],["وأقطع من سيوف الهند حدا","لسان لا يهاب ولا يزل",6,"ل",1,0],["وَاِقطَعِ الآمالَ مِن ما","لِ بَني آدَمَ طُرَّاً",7,"ر",2,0],["وَاِقطَع قُوى كُلِّ حِقدٍ أَنتَ مُضمِرَهُ","إِن زَلَّ ذو زَلَّةٍ أَو إِن هَفا هافِ",8,"ف",1,0],["وَأَقطَعُ أَيّامي بِيَومِ سُهولَةٍ","أُزَجّي بِهِ عُمري وَيَومَ حُزونِ",9,"ن",1,0],["وَأَقطَعتُهُ كِفلاً مِنَ الأَمنِ بَعدَما","بَسَطتُ لَهُ صَدراً مِنَ الدَهرِ أَرحَبا",10,"ب",2,0],["واقطع حِبالَ الأَمانِيِّ الَّتي اتَّصَلَت","فَإِنَّما حَبلُها بِالزُّورِ مَوصُولُ",11,"ل",1,0],["وَاِقطَع بِسَيفٍ صارِمٍ ذَكَرٍ","أَسبابَ كُتبٍ بَينَنا تَجري",12,"ر",2,0],["وَأَقطَعُ الخَرقَ بِالخَرقاءِ قَد جَعَلَت","بَعدَ الكَلالِ تَشَكّى الأَينَ وَالسَأما",13,"م",2,0],["وأقْطَعْ حَبَائلَ خلٍّ لا تُلائمُهُ","فربَّما ضاقَتِ الدُّنيا على اثْنينِ",14,"ن",1,0],["وَأَقطَعَها إِذا وصلَت","مُحِبّيها وَأَخوَنَها",15,"ن",3,0],["واقطفِ الورد من خدودي، وجي","وَنُهودي..، وافْعَلْ بِهِ ما تَرُومُهْ»",16,"م",2,0],["واقطابهم اهل الوحا ابحر الندى","جداول فيض الله في الجزر والمد",17,"د",1,0],["واقطف من خديدك زهر ورد","تبسم في رباه بلا احتشام",18,"م",1,0],["واقطع حبال الخائنين فان من","حمل الخيانة لم يفز بمآله",19,"ل",2,0],["واقطع حبال الكل","وانف السوى تلقاه",20,"ه",1,0],["واقطع حبال الكل","تصل إلى قرب اللَه",21,"ه",1,0],["واقطع حبال الغير أن جمالها","قد حرمته على محب سواها",22,"ا",3,0],["واقطعْ الآمالَ مِن مال الورى","واعتصمْ باللهِ نعم المتكلْ",23,"ل",1,0],["واقطع مهامه كل خرق هَوْجِلٍ","بشِمِلَّةٍ محبورَةٍ وَجْناء",24,"ا",2,0],["وأَقطِف ورد الخدِّ وهْو مُضرَّجٌ","وأَجنِي أَقاحَ الثَّغْرِ وهْو بَرود",25,"د",1,0],["وأقطف وردَ الخدِّ والوردُ زاهرٌ","وأَلزَم غصنَ البانِ والغصنُ مائس",26,"س",1,0],["واقطف لنا ورد المنى من","روضه الزاهي النضير",27,"ر",1,0],["وَاِقطَعِ الدَهرَ بِالبَطالَةِ وَالرا","حَةِ وَاِقنَع بِالفَأرِ وَالحَيّاتِ",28,"ت",1,0],["وأقطع البيد علي أشهب","يشبهه في سيره الكوكب",29,"ب",1,0],["واقطع علائقها عن قرب منتقم","أو ود منتقل أو وصل منتقص",30,"ص",1,0],["واقطع الحجب اللطيف بالسي","ر فيها غير مغترر",31,"ر",1,0],["واقطع القاطعات من كل وهم","واعياد يشير للأحجام",32,"م",1,0],["واقطع الوادي المبارك طولاً","مستعيناً باللَه رب الأنام",32,"م",1,0],["وَاِقطع علائقَ عادةٍ عُوِّدتها","فهيَ الّتي بك للحضيضِ تكسّعُ",33,"ع",1,0],["وَاِقطَع أَخا الجَهلِ وَصِل كُلَّ فَتى","شَبَّ عَلى دينِ الغَرامِ وَاِكتَهَل",34,"ل",1,0],["وأقطَعَ عُمْري في ذُراكَ بغِبْطةٍ","وأهجُرَ أذراءَ الّلئامِ وأرفُضا",35,"ض",2,0],["واقطع مشيَّةَ خاطيها بصالحةٍ","وادفع هواها وقم بالقول والعمل",36,"ل",1,0],["واقطع البيدا ناءياً","عنه والرملَ والنَقا",37,"ق",2,0],["وَاِقطَع أَيامي بِحُسن تَوَكُل","وَصَبر عَلى الأَيام ما أَمكَن الصَبر",38,"ر",1,0],["واقطع لكل معوق عن مداركها","وغب عن الغير تبدو لك مباديها",39,"ي",3,0],["وأقطعُ في تَرجّي الوَصْل عمري","وما يجدي الترجّي والتمنّي",40,"ن",2,0],["وأقطفُ الغَضَّ من تفّاح وجنتها","ومَن رأى قاطِفاً باللّثم تفاحا",41,"ح",2,0],["وأَقْطَعَنَا اقْتِراحاتِ الأَماني","وما الإِقطاعُ منهُ بذِي انْقِطاعِ",42,"ع",1,0],["وأقطفُ ورد ذاك الخدِّ لثماً","ونرجسَ ذلك الطرْفِ الكحيلِ",43,"ل",1,0],["واقطعي عادة الخيال فما أهدا","ه وهنٌإلاَّ وجدَّد وهنا",44,"ن",2,0],["وَأَقطَعُ حَبلَ ذي مَلَقٍ كَذوبٍ","سَريعٍ في الخُطوبِ إِلى انتِقالِ",45,"ل",1,0],["وَأقطَعُ الهَوجَلَ مُستَأنِساً","بِهَوجَلٍ عَيرانَةٍ عَنتَريس",46,"س",1,0],["واقْطَعِ الخائِنينَ عنكَ وأَعْظِمْ","حالَ عبدٍ من الضِعافِ تَقِيِّ",47,"ي",1,0],["واقْطَعِ الإِيصالَ عن مُنقَطِعٍ","واقبَلِ الأَعذارَ للمُعْتَذِرِ",48,"ر",1,0],["واقْطَعِ الكاذِبينَ عنكَ فإنَّ ال","كذبَ فيه نَميطَةٌ شَنْعاءُ",49,"ا",2,0],["واِقْطِفْ بثغرِك وَرْدَ وَجنَتِها على","خدِّ الشقيقِ ومَبسمِ النِسرينِ",50,"ن",1,0],["واِقطِف ثِمارَ الحُزنِ من عُرجونِه","واِنحَر بخَنجَرِه بمُقلَتِك الكَرى",51,"ر",2,0],["وأقطع أياماً تقول همومها","لأنفاس نفسي كيف شئت فذوبي",52,"ب",2,0],["وأقطع أيامي عليه بلوعة","تعبر عن مكنونها عبراتي",53,"ت",2,0],["وأقطع أيامي بهم وترحة","وأبقى حزيناًَ بعده لمماتي",54,"ت",2,0],["واقْطَعْ بتَقْطيعاتِ قَطّاعِهِ","حُلْقُومَ مَنْ أَوْرَدَ أَو أَصْدَرَا",55,"ر",2,0],["وَاِقطَعْ بهِ كَي لا أسافرَ أنسُعي","وَاِعقِرْ لَه كي لا أريمَ رِكابي",56,"ب",2,0],["واقطع بعجز الكل عن دركه","واهرب من العقل وتحكيره",57,"ر",2,0],["وأقطع الفدك والعوالي","وخمس إفريقية في حال",58,"ل",1,0],["وأقطع الثلث سليمان على","ما ذكروا حتى إذا ما احتملا",58,"ل",2,0],["وأَقطع إِخواني وما حال عهدهم","حياء وإِعراضاً وما بي من كِبَرِ",59,"ر",1,0],["وأَقطع الخرق بالخَرقاء لاهية","إِذا الكواكب كانَت في الدجى سرجا",60,"ج",2,0],["وأَقطعُهُ بالعَضِّ إِذ سَرَقَ الكرَى","كَرَى مُقْلَتي والقطعُ يُعْرَفُ لِلِّصِّ",61,"ص",1,0],["وَأَقْطفُ وَرْداً بأغْصانِه","وَلم يَكُ هذَا بغَيْرِ المُقَلْ",62,"ل",1,0],["وَأَقطَعَ لِلأَرحامِ لَم يَرقُبوا بِها","مِنَ اللَهِ إِلّا يَومَ ذاكَ وَأَيصَرا",63,"ر",2,0],["واقطع دموعاً تجري","كالسيل والأمطار",64,"ر",1,0],["وَاقطع رَجاءَك مِن أَهلٍ وَمِن وَلَد","وَمِن خَليل عَلى حُكم الهَوى جاري",65,"ر",2,0],["وَأَقطَعَ دابرهم عُنوةً","بِجَزم وَجَيش كَثير العَدد",66,"د",1,0],["وَاِقطَع بِماضي العَزم حجة آمرٍ","يَنهاكَ عَن وَصل المِلاح وَلا تَهب",67,"ب",1,0],["وَاِقطَع رَجاك مِن الرِياسة وَاِنتَحب","لِنفورها يا أَخبث الخُبَثاء",68,"ا",2,0],["وَاِقطَع حِبال البخل وَاِنقض عَهده","فَالبُخل في الإِنسان أَقبَح داء",68,"ا",2,0],["واقطع زمانك مشغوفاً بحبهم","مضنى الفؤاد بهم ما عشت مكتئبا",69,"ب",2,0],["وأقطِفُ زهْرَ الرّوضِ مِنْ وَجَنَاتِها","وأرْشُفُ مِنْ فيها المُدَامةَ والشَّهْدَا",70,"د",2,0],["وأقْطَعُ العُمْرَ مالي في سِواكِ هَوىً","ولَيْسَ لي مِنْكِ يَوْماً حَظُّ مِسْواكِ",71,"ك",1,0],["وَأَقطفُ رُمّاناً عَلا فَوقَ نَهدِها","وَأَحلى مِنَ الرُّمّانِ نَهدُ الكَواعِبِ",72,"ب",1,0],["وَاِقطَع بِسيفِهِ العِدى","وَاِجعَلهُ فيهِم ظافِرا",73,"ر",2,0],["واقطع رجاءك من رفد تومله","ما دمت حيا وان شيمت بوارقه",74,"ق",2,0],["واقطع أقاويل الوشاة فإنها","سبب لوصلة حبلنا المقطوعِ",75,"ع",1,0],["وأقطع أسيافا وأحصن محجنا","وأقوم أرماحا وأنفذ الهذما",76,"م",2,0],["واقطع بها قفراء لست بسامع","فيها حسيسا او تحس نفيسا",77,"س",2,0],["واقطع عرى التسويف منك بصارم","يفري اديم العجز منك إذا سطا",78,"ط",2,0],["وأقطع زند الهجر والقطعُ حقُّهُ","فما زال مني طيبَ العمر يَسرِقُ",79,"ق",1,0],["واقطع لرفع أو لنصب وانتقل","كحارث أو كسعاد المرتجل",80,"ل",1,0],["وأقطعهم سيفاً وأسمحهم يداً","وأمنعهم جاراً وأشرفهم أصلا",81,"ل",2,0],["واِقطعا لي كَفناً مِن زقِّها","واطرحا مِنها عَلَيهِ واِرشُشا",82,"ش",2,0],["واقطع من اللية والهبر فمث","لهما السهل البلع حاشا يوجد",83,"د",1,0],["واقطعوا دابِرَ الفُجُورِ وَإِلاَّ","تتمشَّى مع الدَّمِ الفَحشاء",84,"ا",2,0],["وَاقْطَعُ الوَقتَ فِي أنْسٍ بِطَا ئِفَةٍ","عَزيزَةٍ مِنْ خِيارِ النَّاس اخْيَارِ",85,"ر",1,0],["واقطعوا من ضوئها أكفانه","حبرا تعشي عيون الناظرين",86,"ن",1,0],["وأَقْطَعْتَني منهم رقابَ مَعاشِرٍ","رَأَوْا أَنَّني فيهم لنُعْماك أَكْفُرُ",87,"ر",1,0],["وأقطع سيفي في الطلى ثم أنثني","فأذبح عيري بالبقية من سيفي",88,"ف",2,0],["واقطع رجاءَك عن جزاء المدح في","مثرٍ وان حاز الكنوزَ العسجدا",89,"د",2,0],["واقْطِفْ ثمار اللّهو قطفَ مُراغم","أَنْف الأعادِ ولا يَصُدَّك مُسْرِفُ",90,"ف",1,0],["واقطَع عَلاَئِقَكَ الَّتِي قَد قَيَّدَت","هَذَا الوَرَى مِن سَالِفِ الأزمَانِ",91,"ن",1,0],["واقطف ثمار المعالى من أزاهره","واجل الهموم برؤيا حسن ما فيه",92,"ي",2,0],["وَأَقطُفُ مِن آدابِهِ الزَهرَ يانِعاً","وَأشتمُّ رَيحاناً بِخَدٍّ مُوَرَّدِ",93,"د",1,0],["واقطف ثماراً دانيات قطوفها","فلك الهنا يا وارداً لمحبه",94,"ب",2,0],["واقطعي إِن شئت وصلي واصرمي","وإِن ضربت هامة الغشمشم",95,"م",1,0],["واقطع الأرض بالسياحة تعرف","أمماً طار صيتها وترامى",96,"م",2,0],["وأقطعُ بالتسهاد ليلي صبابةً","وزندُ الأسى في باطن القلب يقدَحُ",97,"ح",1,0],["وأقطف التفاح من خده","راحي وتفاحي خدود الملاح",98,"ح",1,0],["واقطب حرارة نارها","بمصفق الماء المبرد",99,"د",1,0],["وأقطعٍ قلتُ لهُ","هَل أنتَ لصَ أوحَدُ",100,"د",1,1],["وأقطع أشعاري إذا ما بدوتِ لي","فرؤْياك تُغني عن تقاطيع أشعاري",101,"ي",1,0],["واقطع الظلمات تحظ بهِ","وبعالي القدر من بذرِه",102,"ر",2,0],["وأَقطَعُ كُلَّ ذي بِرٍّ وَصولٍ","إذا مزجَ الخليقةَ باختلاقِ",103,"ق",1,0],["واِقطع لسانَ حسودٍ","يجورُ أو يتعدّى",104,"د",2,0],["وأقْطعُ دهْري في عَسى ولعلّما","مَشوقاً مُعنّىً مسْتهاماً متيّما",105,"م",2,0],["وَاقطَع أوَ اتبِع إن يَكُن مُعَيِّناً","بِدُونِهَا أو بَعضِهَأ اقطَع مُعلِنَا",106,"ن",2,0],["واِقطَع بِهِ طَمَعي وَشَرِّف هِمَّتي","كَثِّر بِهِ وَرَعي واحيِ جَناني",107,"ن",2,0],["وأقطف أزهار الأماني تعلة","بأيدي الرجا والدمع ينهل ساكبه",108,"ب",2,0],["وأقطع الخرق يخافُ الردى","فيه على أدماء هلواع",109,"ع",1,0],["واقطفوا من كل روض زهرة","فرياض العلم أضحت في إبتسام",110,"م",1,0],["وأقطابها قد أترفتهم سعادة","إذ الشعب يشقى والجياع مئات",111,"ت",1,0],["واقطع زمانك طيباً في محاسنها","وعد إلى اللهو واللذات والطرب",112,"ب",1,0],["وَاقْطَعِ الآمَالَ إِذْ مَا بَسَقَتْ","ذِلَّةٌ إِلاَّ عَلَى بَذْرِ أَمَلْ",113,"ل",1,0],["واقطع بها عنا رقابَ الظالمينْ","والحفظَ دُمْ لنا بها من فاسقينْ",114,"ن",1,0],["واقطعْه إن رامَ بقطْعٍ يقطعُ","لضرِّهِ ونفسِهِ ويردعُ",114,"ع",1,0],["واقطفي الزهر ان اردت وَلكن","حاذري ان تبعثري زهراتي",115,"ت",2,0],["وَاقطَع سَبِيلَ قُفُولهِ لرِجالهِ","وإِلى السَّفائِنِ رُدَّهُ مُتَعَقِّبا",116,"ب",2,0],["وَاقطَع ذَوِى المَيلِ وَاوصِل مَن عَدَل","وَلاَ تَمِل إِلَى المِرَاء وَالجَدَل",117,"ل",1,0],["واقطف من الروض الأغن جماله","ومن البلابل روعة الإنشاد",118,"د",1,0],["واقطع هنالك جيد الجدب إن تره","فقد لمعت كسيف هند واني",119,"ي",1,0],["واقطف متى شئت ورود الهنا","ما انتشر الطل على الجلنار",120,"ر",1,0],["وَاقطع حالاً أَن يُناضل في الوَغى","بزاة وَهَل يَعلو الزَئير ضَغيب",121,"ب",1,0],["وَاِقطَع لَهُ مَجاهِلَ القِفارِ","وَخُض إِلَيهِ لُجَجَ البِحارِ",122,"ر",1,0],["واقطعوا وصلَ الكرى","تَحمَدوا غِبَّ السُّرى",123,"ر",2,0],["واقطع عن الأسباب قلبك واصطبر","واشكر لمن أولاك خيرا واحمد",124,"د",1,0],["واقطعي كف الهم وانتقمي لي","من همومي لا ترحمي أعدائي!!",125,"ا",3,0],["وأَقطِفُ الفَجرَ بَعدَ الفَجرِ مُنتَظِرًا","سُهَيلَ، وهو بِصَدرِي يَغرِسُ \"الدَّانا\"",126,"ن",2,0],["واقطف إذا جئتها أزهارَ معرفةٍ","تزدد بها رِفعةً في نيلها عَظمَة",127,"م",2,0],["واقطِفي مِمَّا على الأغ","صانِ مِمَّا شئتِ شَيا",128,"ي",2,0],["وأقطعُ ما استطعتُ البيدَ حتى","تقاذفني غُدُوِّيَ والرواح",129,"ح",1,0],["وأقطفُ من وجومِ الحظِّ عمري","فيتلفني فراغُ يدي يبابا",130,"ب",2,0],["واقطف من زهور الوصل منك حرفين","من باقةٍ ما بين نعسى وخجلا",131,"ل",2,0],["واقطُفْ سَنا أنوارِهِ","واصعَدْ لأعلى مَرْتَبَةْ",132,"ب",2,0],["(واقطع حبال الأماني الَّتي اتَّصلت)","فكلُّ أمنيةٍ للنَّفس تسويل",133,"ل",1,0],["وأقطع رجاءَك إلاّ","ممن يُصَرِّفُ نفسك",134,"ك",1,0],["واقْطِفِيِهِ مِنْ رِيَاضٍ","وَانْثُرِيْهِ يَا سَمِيْنَا",135,"ن",2,0],["واقطعتها من قلبيَ الحب والوفا","وأن غالبتنى والهوى شر غالب",136,"ب",1,0],["وأقطع أسباب الرجاء لغيره","فأسمعه لي في الخفاء يجيب",137,"ب",1,0],["واقطف لغانم زهرة ، وانثر على","إخوانه زمرا من الأزهار",138,"ر",1,0],["وَاقْطَعْ مِنَ الدُّنيَا المَطَامِعَ كُلَّهَا","إِنَّ المَطَامِعَ للوَرَى كَبَّالَه",139,"ل",2,0],["وَاقْطَعْ أَخَا العُجبِ والكِبْرِ الذَّمِيمَ وَمَنْ","تَلقَاهُ فَظًّا غَلِيظَ القَلبِ يَلقَاكَا",140,"ك",2,0],["واقطيّها متشبّعات وعريضات","صلبة قوايم مابها كلّ علّه",141,"ل",2,0],["واقطعْ حبالَ الأماني","فأنتَ شيخٌ تصابَى",142,"ب",2,0],["واقطع هناك وصل هنا متفردا","ببيان أستاذ وحكمة باني",143,"ن",2,0],["وأقطف من نجوم اللي","لِ باقاتٍ وباقاتِ",144,"ت",1,0],["واقطف من الشعر اللذيذ","فواكها متنعما",145,"م",2,0],["واقطع فؤادي عن الدنيا وزينتها","ولا تكلني لنفسي لست ذا همم",146,"م",1,0],["وَ اقْطِفِ الحِكْمَةَ مِنْ دَوْحِ النُّهَى ..","لاَ تُشَيِّدْ بالدَّنَايَا مَرْتَعَكْ..!",147,"ك",1,0],["واقْطِفْ مِنَ الثّمَرِ النَّضِيج ولا","يَغْلُلْ يدَيْكَ توقُّدُ الحَرَجِ",148,"ج",1,0],["واقطِفْ وروداً إذا ما النُّورُ فتَّحَهَا","فزادُ علمٍ على البَتْلاتِ موشومُ",149,"م",1,0],["واقطع مداد الكون بالكون سواح","لين أركز بجسر المواصل بيارق",150,"ق",1,0],["واقطفي من زهورِ صدريَ فُلًّا","واسْكُبي الماءَ فوقَهُ رَقراقا",151,"ق",2,0],["وَ أَقطَعُ شُرياناً مِنَ القَلبِ نَبضُهُ","عُصارَةَ مِسكٍ نازِفٍ وَ أُخَضِّبُ",152,"ب",1,0],["وأَقْطَارٌ مِنَ العُرْبِ اسْتُبِيحَتْ","غَزَاهَا القَتْلُ وانْتَشَرَ الدَّمَارُ",153,"ر",1,0],["وأقطعُ الوقتَ والأقداحُ مترَعةٌ","أُقامرُ الليلَ أو يهفو بيَ الشغفُ",154,"ف",1,0],["وَاقْطَعْ يَدَ الْأَشْرَارِ دُونَ شَفَاعَةٍ","وَانْسِفْ صَدَى مَنْ يَرْتَجِي إِخْضَاعَهَا",155,"ع",3,0],["واقطَعْ أذنابَ نظامٍ طاغٍ","لا تأخذْ فيهم أبدًا شَفعا",156,"ع",2,0],["وأَقطِفَ زهرةً خَجْلَى","وأَرشُفَ رَشفةً بحذرْ",157,"ر",1,0],["وأقطف جنا ورد ٍ بصدره مغاريس","في روضة ٍ دون النحر ، زارعينه",158,"ن",2,0],["وَ اقْطَعْ - وَ فِي شَفَتَيْكَ - نَحْرِيَ لَسْتُ مَنْ","يَوْمًا أَتُوْبُ فَإِنَّنِي مَنْ زَمَّلَكْ",159,"ك",1,0],["واقطُفي وردَ الصّبايا","غازلاً عقدَ الغرامِ",160,"م",1,0],["واقطع مسافات البحار بقُبلة","ليعود لي بعد الضجيج سكوني",161,"ن",2,0],["وأقطفُ زهرةً حمراءَ ماستْ","بِدَلٍّ في حدائقِ وجنتيها",162,"ي",3,0]]}