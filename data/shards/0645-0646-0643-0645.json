{"poems":[[95,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[90,"قد كانت الأغصان مخضرة","https://www.aldiwan.net/poem44411.html","السريع"],[49,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[74,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[53,"صبحة النوروز في الأحد","https://www.aldiwan.net/poem61831.html","المديد"],[53,"عيد يطابق أول الأسبوع","https://www.aldiwan.net/poem65060.html","الكامل"],[53,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[47,"يا ابن عيسى ابن فرخان وللعجم","https://www.aldiwan.net/poem63601.html","الخفيف"],[30,"يا ابن المراغة إنما جاريتني","https://www.aldiwan.net/poem5241.html","الكامل"],[54,"راض نفسي حتى ترضيت إبلي","https://www.aldiwan.net/poem26911.html","الخفيف"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[50,"اسقنيها بسواد","https://www.aldiwan.net/poem62549.html","مجزوء الرمل"],[50,"اترك التقصير في الشر","https://www.aldiwan.net/poem64368.html","مجزوء الرمل"],[50,"يا خليلي من بني مخزوم","https://www.aldiwan.net/poem65102.html","الخفيف"],[50,"يا كثير النوح في الدمن","https://www.aldiwan.net/poem66134.html","المديد"],[52,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[139,"طاب صفو الزمان والدهر رقا","https://www.aldiwan.net/poem49085.html","الخفيف"],[141,"أدر الكأس يمينا","https://www.aldiwan.net/poem67988.html","مجزوء الرمل"],[185,"زوروا بنا اليوم سلمى أيها النفر","https://www.aldiwan.net/poem58885.html","البسيط"],[203,"هل لذا الجفا سبب","https://www.aldiwan.net/poem45523.html","المقتضب"],[240,"حان إسفار الصباح","https://www.aldiwan.net/poem32120.html","مجزوء الرمل"],[266,"أكناس ريم أم عرين غضنفر","https://www.aldiwan.net/poem38278.html","الكامل"],[280,"أذنت أرض العدى بافتتاح","https://www.aldiwan.net/poem25601.html","المديد"],[333,"أقبل على موكب الحيارى","https://www.aldiwan.net/poem54967.html","مخلع البسيط"],[366,"آل طه ومن يقل آل طه","https://www.aldiwan.net/poem68120.html","الخفيف"],[382,"مريم مدينة مولاها معظمة","https://www.aldiwan.net/poem59157.html","البسيط"],[382,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[398,"يا أمير المؤمنين المرتضى","https://www.aldiwan.net/poem53501.html","الرمل"],[398,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[438,"مالك قلبي عن يد","https://www.aldiwan.net/poem12587.html","مجزوء الرجز"],[445,"منكم إليكم مساعي المجد تنصرف","https://www.aldiwan.net/poem34822.html","البسيط"],[447,"بئس الصداقة عقباها العداوات","https://www.aldiwan.net/poem14353.html","البسيط"],[543,"أهلا بجرح ليته يتكرر","https://www.aldiwan.net/poem48144.html","عموديه"],[563,"هذا الطريق الأقرب","https://www.aldiwan.net/poem34925.html","مجزوء الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66702","الكامل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88601","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122375","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63944","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62682","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16742","البسيط"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35387","الخفيف"],[1137,"","https://poetry.dctabudhabi.ae/diwan/poem/34703","الخفيف"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/74008","الخفيف"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145153","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64594","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78170","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11949","السريع"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114026","الخفيف"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102114","المجتث"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109401","الخفيف"],[2351,"","https://poetry.dctabudhabi.ae/diwan/poem/202634","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60820","الرمل"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100436","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102513","الكامل"],[2610,"","https://poetry.dctabudhabi.ae/diwan/poem/22591","الخفيف"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100884","الخفيف"],[2721,"","https://poetry.dctabudhabi.ae/diwan/poem/20687","الخفيف"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99433","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115800","الرمل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118882","الدوبيت"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65133","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132700","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132737","الرمل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123922","الكامل"],[3511,"","https://poetry.dctabudhabi.ae/diwan/poem/202632","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86306","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66577","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103002","البسيط"],[3962,"","https://poetry.dctabudhabi.ae/diwan/poem/131910","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125856","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123494","السلسلة"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90820","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73262","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117245","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133106","الرمل"],[4504,"","https://poetry.dctabudhabi.ae/diwan/poem/142718","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72351","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120555","الكامل"],[4767,"أفظع الأنباء","https://www.poetsgate.com/ViewPoem.aspx?id=179272",""],[4767,"قوم لوط","https://www.poetsgate.com/ViewPoem.aspx?id=212902",""],[4767,"ثامن الحُجَج","https://www.poetsgate.com/ViewPoem.aspx?id=214501",""],[5186,"لا خير في الشكوى وقد","https://www.poetsgate.com/ViewPoem.aspx?id=156478",""],[2365,"سلم على قبر الحسين وقل له","https://www.poetsgate.com/ViewPoem.aspx?id=200650",""],[5465,"أنتم يا بني علي ذوو الحق","https://www.poetsgate.com/ViewPoem.aspx?id=98442",""],[5786,"لعاذلي قلبٌ ولي قلْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50652",""],[5790,"إن أقفر السفح والصريخ","https://www.poetsgate.com/ViewPoem.aspx?id=112129",""],[5887,"رُغمَ الجراح الداميات بغزّةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27996",""],[5956,"أرسلتُ من أموالكم لمياتمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193833",""],[5956,"القداسة في البشرْ","https://www.poetsgate.com/ViewPoem.aspx?id=193842",""],[5956,"سبحانَه القيُّومُ سمّاعُ الدُّعا","https://www.poetsgate.com/ViewPoem.aspx?id=204194",""],[5977,"يا آل شطر الخامسة","https://www.poetsgate.com/ViewPoem.aspx?id=213059",""],[5991,"أبداً بكم منكم إليكم اهرب","https://www.poetsgate.com/ViewPoem.aspx?id=116382",""]],"verses":[["مَنْ كَمُورِيسَ مِدْرَهٌ أَلْمَعِيٌّ","فَوْزُهُ فِي الجِدَالِ فَوْقَ الجِدَالِ",0,"ل",1,0],["منكم وأن أوجعه برده","لأنه بالعارض المسجم",1,"م",1,0],["مِنكُم عُلَيَّةُ أَم مِنهُم وَكانَ لَهُم","شَيخُ المُغَنّينَ إِبراهيمُ أَم لَكُمُ",2,"م",1,0],["منكم عليٌّ نماه للعلى عمرٌ","فحبذا ثمرات المغرس النامي",3,"م",2,0],["من كُميت اللون صافية","ترتمي في الكأس بالزَّبدِ",4,"د",1,0],["منكم عبيد اللَهِ وترُ زمانِه","ولرُبّ وترٍ ليس بالمشفوع",5,"ع",1,0],["منكمُ حلّاكمُ الما","دح ما جلّ ودقّا",6,"ق",2,0],["منك ما كان طاهرٌ ذا يمينَيْ","نِ يفوقان سائر الأيمان",7,"ن",1,0],["مِن كُمَيتٍ تَوَلَّتِ الشَمسُ مِنها","ما تَوَلَّتهُ مِن سِواها النارُ",8,"ر",1,0],["مِنكُم إِذا لَحِقَ الرُكوبُ كَأَنَّها","خِرَقُ الجَرادِ تَثورُ يَومَ غُبارِ",9,"ر",1,0],["مِن كُمَيتٍ كَأَنَّها أَرضُ تِبرٍ","في نَواحيهِ لُؤلُؤٌ مَغروسُ",10,"س",1,0],["مَنْ كَمَّلَ اللَّهُ مَعناهُ وصورَتَهُ","فَلَم يَفُتهُ عَلَى الحالَيْن تَكْمِيلُ",11,"ل",1,0],["مِنْكُمْ لنا ولكم مِنْ بَعْضِكُمْ شُغُلٌ","والناسُ بالناسِ فِي الدُّنيا مَشاغِيلُ",11,"ل",1,0],["مِن كُمَيتٍ بَلَغَت في ال","دَنِّ أَقصى مُستَزادِ",12,"د",1,0],["مِن كُمَيتٍ كَسَنى البَر","قِ أَضاءَت في البَواطي",13,"ط",2,0],["مِن كُمَيتٍ لَذيذَةِ الطَعمِ وَالري","حِ عُقارٍ عَتيقَةٍ خُرطومِ",14,"م",1,0],["مِن كُمَيتِ اللَونِ صافِيَةٍ","خَيرِ ما سَلسَلتَ في بَدَنِ",15,"ن",1,0],["مِنكُم نَبِيُّ الهُدى يَقرو مَحاسِنَهُ","ساقي الحَجيجِ وَمِنكُم مُنهِبُ الزادِ",16,"د",1,0],["مَن كمثلي منعَّم البال خالٍ","من هموم ساءت ومرّت مذاقا",17,"ق",2,0],["مِن كُمَيتٍ عَتَّقوها","مُنذُ دَهرٍ في جِرارِ",18,"ر",1,0],["منكم قريبا فَهل مِن وَاردٍ لكُم","قد ضَمَّهُنَّ إِلى وَهدَاهُما العكرُ",19,"ر",1,0],["من كمثلي إن ذكروا","من سما بهِ الأدبُ",20,"ب",1,0],["مِن كُمتِ وَردَةٍ ذا","تِ شَبابٍ وَجَماحِ",21,"ح",1,0],["من كمل اللَه العلا بوجوده","وبجوده جود السحاب الممطر",22,"ر",1,0],["مِنْ كَمُاةٍ في وثوبِ الضّواري","فَوْقَ خَيْلٍ في هُبوبِ الرّياح",23,"ح",1,0],["منكم وممّن بغي عليكم","سيّان في شرعة الحروب",24,"ب",1,0],["مِنكُم أَسمّد بل كُل من في الك","ون من فَيض فَضلِكُم يَستَمد",25,"د",1,0],["منك ملاكاً أنيساً ترسلين لنا","يقي لقانا من الشيطان واللِّمَم",26,"م",1,0],["من كمِّ أعدادٍ وروحٍ جُسِّمت","صُبُرٌ ونيرانٌ ونسلٌ مع أجل",27,"ل",1,0],["مَن كَمَولايَ عَلَيٍّ زاهِد","طَلَّق الدُنيا ثَلاثاً وَوَفى",28,"ف",2,0],["مَن كَمَولايَ عَلِيٍّ","في الوَغى يَحمي لِظاها",29,"ا",3,0],["منكمْ أحومُ والهوى","يصدِفُني عن موردي",30,"د",2,0],["منكُمْ إِلَيْكم مَساعِي المجدِ تنصرِفُ","ونحوَكُمُ عَنْكُمُ الآمالُ تَنْعَطِفُ",31,"ف",1,1],["منكم علينا جنيات وليس لنا","فيكم على ما تجنيتم جنيات",32,"ت",1,0],["منكم عُيوناً فوقَ عَيني زِدتُها","أوَ ما بِكُم هذي المَعاني أبُصِرُ",33,"ر",1,0],["منكم إليكم فالذي","يدري الكلام مهذب",34,"ب",1,0],["منكم برئنا أجمعين فأشهراً","في الأرضِ سِيروا كُلُّكم فُرَّارا",35,"ر",2,0],["منكم تَهادَت نفحَةٌ","عادَت معطَّرة ثيابه",36,"ب",2,0],["منكم بدا نجم الهداية للعلا","وعشا لنار قراكم الفصاد",37,"د",1,0],["مَنْ كمحيي الوئيد أو راهن القو","سِ اعترضْ إن وجدتَ وَجهَ اعتراض",38,"ض",1,0],["منكم سبتني ظبية عربية","ما قابلت بدر الدجى إلا اندهشش",39,"ش",1,0],["مِنكُم عَلى الدَهرِ عَينٌ لا تُناوِمُهُ","وَلِلحَوادِثِ قَرنٌ لا تُغالِبُهُ",40,"ب",2,0],["مِن كُماةِ الهَيجاءِ تَحسِبُها فَو","قَ مُتونِ الجِيادِ شُمُّ الجِبالِ",41,"ل",1,0],["مِن كُمَيتٍ يُبدي المَزاجُ لَها","لُؤلُؤَ نَظمِ وَالفَصلُ مِنها جُمانُ",42,"ن",1,0],["من كميتٍ راقت ورقت فما تد","رك لطفاً بالفكر والأوهام",43,"م",1,0],["منكمشا منخذلا مقعنسسا","مُبَصْبصاً قيل له اخْسأْ فخسا",44,"س",2,0],["من كمثلي وذا الشراب شرابي","والنبيون كلهم ندماني",45,"ي",1,0],["مِنكُم تَعَلَمَت المُلوك ملابس ال","زُهاد حَسب الجُهد وَالإِمكان",46,"ن",1,0],["منكم لا نزُعَت ما الدهرُ داما","وإليكم غادةً وشّحتُها",47,"ه",2,0],["مِنكُم سُلُوّي كانَ لا مِن يَدي","أَطفَأتُمُ ناري بِما أَدمُعي",48,"ع",2,0],["مَن كَمثِل الباشا علي بنِ حسينِ بنِ","علي في جوده الطفَّاح",49,"ح",1,0],["منكُم وهذا الأثيثا","ألا يا أحمد",50,"د",1,0],["من كمال ورفعةٍ واحترام","ووقار وهمةٍ ومبره",51,"ر",2,0],["منكم نبيُّ قد مضى لسبيله","قِدْماً فهل منكم نَبيٌّ يُعبَدُ",52,"د",1,0],["من كَمثل ابن أبي بكرٍ وما","كلّ نبتِ الأرضِ حلوُ الثمرِ",53,"ر",1,0],["منكم علي المعالي من سمت شرفاً","مناقب من مساعيه وضيئات",54,"ت",1,0],["منكم وان لم أستحق لكم يدا","فلكم صرفتم بالعنايات الردى",55,"د",2,0],["مِن كُمَيتٍ مُدامَةٍ","حَبَّذا تِلكَ حَبَّذا",56,"ذ",2,0],["منك من شيَّدُوا القصور على الما","ءِ فقلت بحاجة الضيفان",57,"ن",1,0],["منك من حنَّطوا الجسومَ فلم تفنَ","وإن كان كلُّ شيءٍ فانى",57,"ن",2,0],["منك من أركز السماءَ على الأ","رضِ فأمسى من عُمدِها الهَرمان",57,"ن",1,0],["مِن كَمَيتٍ أَجادها طابِخاها","لَم تَمُت كُلُ مَوتِها في القُدورِ",58,"ر",1,0],["من كمثلي وعن يمينه شمسٌ","تتجلى وعن شمالي بدرُ",59,"ر",1,0],["من كميتٍ خندريسٍ","لونُها كالزعفرانِ",60,"ن",1,0],["منكم طربي إذا شجاني العودُ","فاسقوا غرسي يخضر منه العودُ",61,"د",1,0],["من كمثل الأمير في العفو عنكم","أو بإدراره لكم إنعامه",62,"م",2,0],["منكم الدين بدؤه وإليكم","عوده وال