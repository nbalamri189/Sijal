{"poems":[[429,"حن إلى كأسه الخليع","https://www.aldiwan.net/poem4107.html","مخلع البسيط"],[1362,"","https://poetry.dctabudhabi.ae/diwan/poem/113644","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21668","المتقارب"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96024","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91368","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131257",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86519","الطويل"]],"verses":[["كَأَنَّ أَزهارَها نُجومٌ","لَها بِأُفقِ الرُبى طُلوعُ",0,"ع",1,0],["كأنَّ أزاهير الشَّقيق بدوحها","خدودٌ ونور الأقحوان ثغورُ",1,"ر",1,0],["كَأَنَّ أَزِمَّتَها في البُرى","أَراقِمُ نيطَت بِأَذرارِها",2,"ر",3,0],["كان ازدحام القرن منه لقرنه","نديمان في كفيهما الراح تقطف",3,"ف",1,0],["كَأَنّ ازرقاقَ الجوّ ذوبُ بنفسجٍ","يُدارُ بكأسٍ مِن سَنا أُفْقِنا فِضِّي",4,"ض",2,0],["كأن أزاهيرها حوله","يتامى تعهدهم كافل",5,"ل",1,0],["كأن أزيز الجوف عند وجيبه","حسيس هشيم والندى يتوكف",6,"ف",1,0]]}