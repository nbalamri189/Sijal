{"poems":[[51,"أسألت رسم الدارِ أم لم تسأل","https://www.aldiwan.net/poem65978.html","الكامل"],[44,"قل للأمير تجد للقول مضطربا","https://www.aldiwan.net/poem29988.html","البسيط"],[44,"قل للأمير الذي قد نال ما طلبا","https://www.aldiwan.net/poem30577.html","البسيط"],[20,"لمضن لليل بذي جشم طويل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502464",""],[259,"لمن المهارى اليعملات القود","https://www.aldiwan.net/poem38338.html","الكامل"],[456,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[493,"يا لمة ضرب الزمان","https://www.aldiwan.net/poem10273.html","مجزوء الكامل"]],"verses":[["لمَضَتْ من الدنيا وما أسِفت على","مستمتَعٍ من مَشْربٍ أو مأكلِ",0,"ل",1,0],["لَمُضمِرٌ غُلَّةً في القَلبِ يُضرِمُها","أَنّي سَبَقتُ وَتُعطي غَيرِيَ القَصَبا",1,"ب",2,0],["لَمُضمِرٌ غُلَّةً تَخبو فَيُضرِمُها","أَنّي سَبَقتُ وَيُعطى غَيرِيَ القَصَبا",2,"ب",2,0],["لِمضن لَليلٌ بِذي جُشُمٍ طَويلُ","لِمَن قَد شَفَّهُ همٌّ دَخيلُ",3,"ل",1,1],["لمضاء أمرك كل عضو سامع","ولمجدك التأبيد والتأييد",4,"د",1,0],["لمضطَهدٍ يُسرُهُ ما اتسعتَ","وضيقُك آيةُ إعسارِهِ",5,"ر",2,0],["لمضرج بدم النبو","ة ضارب بِيد الإمامه",6,"م",2,0]]}