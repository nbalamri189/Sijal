{"poems":[[53,"أسألت رسم الدارِ أم لم تسأل","https://www.aldiwan.net/poem65978.html","الكامل"],[46,"قل للأمير تجد للقول مضطربا","https://www.aldiwan.net/poem29988.html","البسيط"],[46,"قل للأمير الذي قد نال ما طلبا","https://www.aldiwan.net/poem30577.html","البسيط"],[20,"لمضن لليل بذي جشم طويل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502464",""],[266,"لمن المهارى اليعملات القود","https://www.aldiwan.net/poem38338.html","الكامل"],[463,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[500,"يا لمة ضرب الزمان","https://www.aldiwan.net/poem10273.html","مجزوء الكامل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202071","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27234","الرمل"],[4135,"","https://poetry.dctabudhabi.ae/diwan/poem/198348","الخفيف"],[5409,"لم ضيعت منك سحر الغدائر","https://www.poetsgate.com/ViewPoem.aspx?id=155279",""],[5605,"مصائب عانسة","https://www.poetsgate.com/ViewPoem.aspx?id=160690",""],[5064,"لَمْ يبقَ للحُبِّ العظِيمِ مكَانُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87536&r=&rc=31",""]],"verses":[["لمَضَتْ من الدنيا وما أسِفت على","مستمتَعٍ من مَشْربٍ أو مأكلِ",0,"ل",1,0],["لَمُضمِرٌ غُلَّةً في القَلبِ يُضرِمُها","أَنّي سَبَقتُ وَتُعطي غَيرِيَ القَصَبا",1,"ب",2,0],["لَمُضمِرٌ غُلَّةً تَخبو فَيُضرِمُها","أَنّي سَبَقتُ وَيُعطى غَيرِيَ القَصَبا",2,"ب",2,0],["لِمضن لَليلٌ بِذي جُشُمٍ طَويلُ","لِمَن قَد شَفَّهُ همٌّ دَخيلُ",3,"ل",1,1],["لمضاء أمرك كل عضو سامع","ولمجدك التأبيد والتأييد",4,"د",1,0],["لمضطَهدٍ يُسرُهُ ما اتسعتَ","وضيقُك آيةُ إعسارِهِ",5,"ر",2,0],["لمضرج بدم النبو","ة ضارب بِيد الإمامه",6,"م",2,0],["لمْ ضيَّعْتُ في الغواية عمْري","ومَجَالي من الرَّشادِ رَحِيبُ",7,"ب",1,0],["لمضاهاة استواء","فوق عرشٍ فلكيّ",8,"ي",1,0],["لُمِضِلٍ يَهْدِيهِ نَحْوَ مُضِلٍ","وَسَفِيهٍ يَقُودُهُ لِسَفِيهِ",9,"ي",2,0],["لم ضيعت منك سحر الغدائر","وهي لو تعرفينها فن ساحر",10,"ر",1,1],["لم ضيعت محبوبا وحبا ؟","لم أحجمت أمس يا (نهار)؟",11,"ر",1,0],["لمضَى بِهَا مِنْ دُونِ مخلوقاتِهِ","قلبٌ مُحِبٌّ مُولَهٌ هَيمَانُ",12,"ن",1,0]]}