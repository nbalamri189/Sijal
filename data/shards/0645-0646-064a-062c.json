{"poems":[[30,"لو شئت لمت بني زبينة صادقا","https://www.aldiwan.net/poem5605.html","الكامل"],[107,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[107,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54328","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[111,"نكس العلام يا خير الملل","https://www.poetsgate.com/ViewPoem.aspx?id=67046",""],[147,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[190,"من يصحب الدهر يبصر من تقلبه","https://www.aldiwan.net/poem44146.html","البسيط"],[208,"لست ترى ذا الفقار مذكرا","https://www.aldiwan.net/poem53274.html","المنسرح"],[240,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[353,"من يحفظ الفيل بعد الشبل والأسد","https://www.aldiwan.net/poem20070.html","البسيط"],[438,"أي نجم من أي شمس وبدر","https://www.aldiwan.net/poem12370.html","الخفيف"],[438,"لست أدري أتحفة تتهادى","https://www.aldiwan.net/poem12431.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86594","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48824","الخفيف"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/104471","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70753","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70954","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70746","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62534","الكامل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87905","الكامل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87867","البسيط"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114037","الخفيف"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114026","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118309","الخفيف"],[1924,"","https://poetry.dctabudhabi.ae/diwan/poem/102027","الرمل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76794","الكامل"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101856","الرمل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88651","المنسرح"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93736","الرمل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130826",""],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83243","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93782","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93980","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74178","الرمل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100181","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89281","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108382",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108107","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117960","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114115","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45951","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83580","الكامل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139187","الخفيف"],[4447,"","https://poetry.dctabudhabi.ae/diwan/poem/198780","الكامل"],[4739,"انت السؤال","https://www.poetsgate.com/ViewPoem.aspx?id=36914",""],[4929,"(... إذ هما في الغار...)","https://www.poetsgate.com/ViewPoem.aspx?id=199722",""],[5135,"حق الصحبة","https://www.poetsgate.com/ViewPoem.aspx?id=201891",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5277,"مقهى البيروتي.. ذاكرة المكان..","https://www.poetsgate.com/ViewPoem.aspx?id=185251",""],[5338,"يا مدخلي بالهجر ذات وقود","https://www.poetsgate.com/ViewPoem.aspx?id=187990",""],[5376,"يا نبيُّ اللهِ يا نورُ السما","https://www.poetsgate.com/ViewPoem.aspx?id=188536",""],[5376,"لا تسلْ عني فأنِّي عاشقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=197711",""],[5431,"فلسفة الحياة ....","https://www.poetsgate.com/ViewPoem.aspx?id=199987",""],[5533,"في ذِكْرى الرَّحيل","https://www.poetsgate.com/ViewPoem.aspx?id=183279",""],[5573,"اتعبني التقسيم والطرح والضرب","https://www.poetsgate.com/ViewPoem.aspx?id=200090",""],[5574,"صفْصافةُ البيْنِ في سكرةِ الرّوح","https://www.poetsgate.com/ViewPoem.aspx?id=205993",""],[5756,"آفة العصر","https://www.poetsgate.com/ViewPoem.aspx?id=5432",""],[5956,"عِشْ مَعَ النباتِ والجمادِ","https://www.poetsgate.com/ViewPoem.aspx?id=184145",""]],"verses":[["مَن يَجرَحا فَكَأَنَّما يُرمى بِهِ","مِن حَيثُ يَرتَفِعُ الشَبوبُ الأَعصَمُ",0,"م",1,0],["من يُجيرُ القومَ إن صَبَّحَهم","خطبُ عادٍ وثمودٍ في القِدَمْ",1,"م",1,0],["مَن يَجهل الرِئبالَ يَنفُذ نابُهُ","في كلِّ مُقتنَصٍ وَيَمْضِي المِخلَبُ",2,"ب",1,0],["مَنْ يَجِدْهُ مُمْكِناً أَصْمَى وَمَنْ","لَمْ يَجِدْهُ مُمْكِناً مَنَّى فَأَغْرَى",3,"ر",2,0],["من يجيب اليوم أبناءك إن","هتفوا باسمك فيهم يا أبانا",4,"ن",2,0],["مَنْ يَجْعَلِ الإِيمَانَ صَخْرَةَ مُلْكِهِ","رَفَعَ البِنَاءَ عَلَى أَشَمَّ وَطِيدِ",5,"د",1,0],["من يجلي ظلم الجهل ومن","ينصر الدين اضطلاعاً للجلل",6,"ل",1,0],["مَن يُجزِلُ العُرفَ إِذ يَرجونَهُ رَغَباً","وَيَبذُلُ العَفوَ إِذ يَخشَونَهُ رَهَبا",7,"ب",2,0],["من يجعل العجب خدنا لا يفارقه","فما يمتعه شيء سوى العجب",8,"ب",1,0],["مَن يجعلِ الفضلَ في مواطنه","فذاك في كل موطنٍ يُشكَرْ",9,"ر",1,0],["مَن يَجمَعُ العَلياءَ وَهِيَ بَدائِدٌ","وَيُشِتُّ شَملَ المالِ وَهُوَ مُجَمَّعُ",10,"ع",1,0],["من يجير الغدير يروى جدوباً","ثمّ لا ترتوي شفاه الجدوب",11,"ب",1,0],["مَنَ يَجْمَعُ الشَّمْلَ مَن يُرْضِي العَشِيرةَ مَن","يَجْلُو الضَّرورةَ مَن يَهْدِى إلى الرشَدِ",12,"د",1,0],["من يُجارِيكُمُ وقد جَعَلَ اللّ","هُ بأَيديكُمُ المقاديرَ تَجْري",13,"ر",2,0],["من يُجارِيكَ فِي العلومِ وقد مَلَّ","كَكَ الفضلُ والكمالُ القِيادا",14,"د",2,0],["من يجاريه في منافع قطرٍ","حبُّه مِن بَنيه بِالشَرع وَاجب",15,"ب",1,0],["من يجئْ راضياً أراح ومن ول","لى فعذراً يلقى لديك ومهلا",16,"ل",2,0],["من يجبر اللَه في كسر القلوب به","منا ويقصم فيه كل جبار",17,"ر",1,0],["مَنْ يجعل الملكَ الكبيرَ مطيَّه","يجعل عصاه صارما وسنانا",18,"ن",2,0],["من يجعل الفاسقَ الجدَّاعَ صاحبَه","يوماً ليُشركه في أمره بُهِظَا",19,"ظ",2,0],["منْ يجعل الإفْكَ شيئاً هيِّناً ويُرِدْ","بيانَه يتدَبَّرْ سورةَ النورِ",20,"ر",1,0],["من يجعل الأسلام أصلاً يحترس","من أن يُدنسه بشيْءٍ هازلِ",21,"ل",1,0],["من يجتزي بحلاوة الوصل وير","غب عن خلود الروح في بنويَّة",22,"ي",2,0],["مَن يجترح فيهِ ما اشقى مغبَّتُهُ","ان السعادة للانسان عفته",23,"ه",1,0],["من يجاري مَدَاه ان هو أجرى","في ميادين طِرسه أقلامه",24,"م",2,0],["من يُجاري عليَّا بنَ حسين بنِ","علي في عقله الرّجَّاحِ",25,"ح",1,0],["من يجد نصه كفاه يقينا","دون شك يبقى ودون ارتياب",26,"ب",1,0],["من يجاريه بفضل","وله السهم المعلى",27,"ل",2,0],["مَن يَجتنِب إِنعاظَه وَكلامَه","يأمَن فَأَصلُ الشَّرِّ فَرجٌ أو فَمُ",28,"م",1,0],["من يجاريه فخاراً وثنا","كلف النفس بما لم تطق",29,"ق",1,0],["من يجحد الشمس وهي طالعة","الا قذى في العيون يسملها",30,"ل",3,0],["مَن يجاريك سَخاء","وَالسَخا مِنكَ سَجيّه",31,"ي",2,0],["من يجد السعي يستثمر ومن","يعرف المطلوب يحقر ما بذل",32,"ل",1,0],["مَن يَجتَهِد في دَرسِهِ وَبِنَفسِهِ","فَاللَهُ أَكرَمُ مَن يُساعِدُ ذا شَرَف",33,"ف",1,0],["من يجهل الناس يسأل أهل خيرتهم","شتان ما بين ذي جهل ومن عرفا",34,"ف",2,0],["من يجيء نحو حيه مستغيثا","لم يصادف حيا يراه مغيثا",35,"ث",2,0],["مَن يُجاريه إِذا البحث دجا","وَالجَواد الحُر سبقاً لَن يُراما",36,"م",2,0],["من يجاريه في نثار ونظم","وهو رب المنظوم والمنثور",37,"ر",1,0],["من يجعل اللَه الحوائج عنده","لا شك عند إلهه مقبول",38,"ل",1,0],["من يجتني الورد المنعم قد غدا","في غبطة وبدا بعيش انعم",39,"م",1,0],["من يجافيك يا عيوني ولا تب","كي دماءً عيونه لا ماءَ",40,"ا",2,0],["من يجامع فليبل لو قطرةً","وليسر لو خطوةً من أكلا",41,"ل",2,0],["مَن يَجنِ ذَنباً لَم تَعُد","إِلاَّ عَلَيهِ جِنَايَتُه",42,"ه",1,0],["من يجد حال صحة وشباب","لم يكن في خموله معذورا",43,"ر",2,0],["مَن يُجاريكَ في القَريضِ إِذا ما","جالَ أَهلُ القَريضِ في مِضمارِ",44,"ر",1,0],["مَن يَجمَع الشَملَ المفر","رقَ مِنهُمُ مِن بَعد خَطبِه",45,"ب",2,0],["من يجد غير مسرف فهو في النا","س موقى تثني عله الخليقه",46,"ه",1,0],["من يجمع الآراء بعد تشتت","وله تبث عروبتي شكواها",47,"ا",3,0],["من يجني الراحه بموسم عذابه","حاول تناسى والليالي تنسيك",48,"ك",1,0],["من يجاريك يا(أبا بكرٍ الصدِّ","يقُ) قدراً ورفعة من يباري ؟",49,"ر",2,0],["مَنْ يجازيْ الصَّحْبَ مِنْ أفْعالهمْ","جاحدٌ لِلْفَضْلِ ظلّامٌ جَهِلْ",50,"ل",1,0],["من يجعل الله أمام وجهه","كان الصواب حظه دون الخطا",51,"ا",1,0],["مَنْ يجبرُ الفارسَ المغلوبَ في وطنٍ","أضحى الشريفُ بِهِ أدنى أهاليهِ؟",52,"ي",2,0],["مِنِّي جَرَائِرُ أَنْتَ تَعْلَمُ عُظْمَهَا","تَرْبُو بِصَيِّبِ حَظِّيَ الْمَنْكودِ(١٩)",53,"د",1,0],["من يجيرُ العبدَ الا ربنا","ان أراد الأمرَ أضحى ملزِما",54,"م",2,0],["مَنْ يجيشُ الحبُّ فيه لوعةً","أنِسَ الدمعَ وما نالَ حراما",55,"م",2,0],["من يجهل العشق يُخطءْ في تفهمه !!","لاحدَّ بالعشق لا قيدٌ بإطلاقِ!!",56,"ق",1,0],["مَنْ يَجْعلِ العَلْيَاءَ أَكْبرَ همِّه","لا يَنْزَوِي في كَهْفِهِ مَعْزولا",57,"ل",2,0],["من يجهلك مايعرفك يحسبك خَرب","لوالمناره بينه من هلالك",58,"ك",1,0],["١- مَن يجْتلي جلَلَي مِن كوْمةِ العِلَلِ؟","من يشتري أَجَلي إنْ باعَهُ زللي؟",59,"ل",2,1],["من يجيب لنا المخدر خايب والسم خاب","وكل ناسي يتبعونه بالتجارة يخسرون",60,"ن",1,0],["مَنْ يجعلِ الإسلام والدَ فكرِهِ","تصبحْ له قممُ الحضارةِ أُمّا",61,"م",2,0]]}