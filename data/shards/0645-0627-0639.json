net/poem39282.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85470","الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39573","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16703","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42580","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54887","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54827","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54897","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54749","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43720","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54328","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[106,"إلى القائد المظفر","https://www.poetsgate.com/ViewPoem.aspx?id=179595",""],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[106,"هو ليلاي","https://www.poetsgate.com/ViewPoem.aspx?id=179378",""],[106,"ميلاد الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179497",""],[106,"من وحي السد","https://www.poetsgate.com/ViewPoem.aspx?id=179600",""],[106,"عصفورة تتحدى النسور!","https://www.poetsgate.com/ViewPoem.aspx?id=179471",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"فلسفة الألم","https://www.poetsgate.com/ViewPoem.aspx?id=179662",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[106,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[100,"بعد الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=50367",""],[98,"الدول العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=55340",""],[98,"الشباب الذاوى","https://www.poetsgate.com/ViewPoem.aspx?id=55332",""],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[45,"عِلَلُ النّفُوسِ قَرِيبَةٌ أوْطانُهَا","https://www.poetsgate.com/ViewPoem.aspx?id=31725",""],[91,"صاحب القلم","https://www.poetsgate.com/ViewPoem.aspx?id=53269",""],[91,"تأملات","https://www.poetsgate.com/ViewPoem.aspx?id=53220",""],[51,"من رأى مثلَ خالدٍ فضلَ حلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30775",""],[51,"أحمدُ اللَّه مُبدِئاً ومُعيد","https://www.poetsgate.com/ViewPoem.aspx?id=27043",""],[51,"كُفي الدموع وإن كان الفراقُ غَدَاً","https://www.poetsgate.com/ViewPoem.aspx?id=27698",""],[31,"يا صاحبيّ، قفا نقضِّ لبانة ً،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18929&r=&rc=192",""],[31,"ما عَلَى الرَّسْمِ بالبُلَيَّيْن لَوْ بَيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18767&r=&rc=30",""],[88,"قسَماً بالإله عزَّ وجلاَّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19555&r=&rc=58",""]],"verses":[["ما عَلى ذي لَوعَةٍ نَبَّهَهُ","بارِقٌ مِن قِبَلِ الغَورِ فَشاما",0,"م",2,0],["ما عِفَّتي في الهَوى يَوماً بِمانِعَتي","أَن لا تَعِفَّ بِكَفِّيَ القَنا الذُبُلُ",1,"ل",1,0],["ما عُذرُ مِثلِيَ في نَقصٍ وَقَولَتِهِ","إِنّي الرَضيُّ وَجَدّي خاتَمُ الرُسُلِ",2,"ل",1,0],["ما عَلى البَرقِ لَو تَحَمَّلَ مِن نَج","دٍ بِأَظعانِهِ فَسَقّى حِماكا",3,"ك",2,0],["ما عِندَ عَينِكَ في الخَيالِ الزائِرِ","أَطُروقُ زَورٍ أَم طَماعَةُ خاطِرِ",4,"ر",1,1],["ما عُدتَ إِلّا عادَ قَلبي غُلَّةٌ","حَرّى وَلَو بالَغتُ في إِبرادِها",5,"د",3,0],["ما عُذرُ مَن ضَرَبَت بِهِ أَعراقُهُ","حَتّى بَلَغنَ إِلى النَبِيِّ مُحَمَّدِ",6,"د",1,0],["ما عُدِّدَت مِنكَ إِلا نُطفَةٌ سَلَكَت","إِلى الأَماني طَريقَ الماءِ في العودِ",7,"د",1,0],["ما عَبَّسَت حَومَةُ الهَيجاءِ وَجهَ فَتىً","إِلّا وَوَجهي إِلَيها باسِمٌ طَلِقُ",8,"ق",1,0],["ما عَلَينا إِلّا الجَميلُ وَما يُش","بِهُكُم يا ظَلومُ إِلّا الجَميلُ",9,"ل",1,0],["ما عَمَدنا ما تَكرَهونَ وَلَكِن","ساءَ ظَنُّ المُحِبِّ فَهوَ يَقولُ",9,"ل",1,0],["ماعَلَيها لَو أَنَّها أَذِنَت لي","في كِتابٍ فَقَد نَهَتَني مِرارا",10,"ر",2,1],["ما عِندَهُم فَرَجٌ في قُربِ دارِهِمُ","وَلا لَنا مِنهمُ في البُعدِ أَخبارُ",11,"ر",1,0],["ما عُذْرُها إنْ لمْ تُقاسِمْكَ الرّدَى","في فضْلِ كأسٍ قدْ شرِبْتَ دِهاقِ",12,"ق",1,0],["مَا عطَّرَ الرَّوْضُ فِي الأَسْحَارِ عَرفَ صبَا","وَفَاحَ نَشرُ خُزَامَى مِنَّةَ نِسْرِينِ",13,"ن",1,0],["ما عُوقِبَ اللّيلُ بالصّباحِ وما","تقدّمَ البَرْقُ عارِضَ المطَرِ",14,"ر",1,0],["ما على القَلْبِ بعْدكُمْ منْ جُناحِ","أنْ يُرى طائِراً بغيْرِ جَناحِ",15,"ح",1,1],["ما عُذْرُ مَشْغوفٍ بخَيْرِ الوَرى","إنْ هاجَ منهُ الذِّكْرُ أنْ لا يَبوحْ",16,"ح",1,0],["ما عابَهُم أَنَّ الصُعو","دَ يَليهِ في الدَهرِ اِنحِدار",17,"ر",1,0],["ما عَهِدنا المُلوكَ تَبكي وَلَكِن","عَلَّها نَزوَةُ الفُؤادِ الجَليدِ",18,"د",1,0],["ما عَهِدناها لِظَبيٍ مَسرَحاً","يَبتَغي مُلهىً بِهِ أَو مَلعَبا",19,"ب",2,0],["ما عابَهُم أَنَّهُم في الأَرضِ قَد نُثِروا","فَالشُهبُ مَنثورَةٌ مُذ كانَتِ الشُهُبُ",20,"ب",1,0],["ما عَهِدناكَ يا كَريمَ السَجايا","تَصرِفُ النَفسَ عَن هَناتِ الكِرامِ",21,"م",1,0],["ما عِندَ مَودودَ مَن قَلَّت مَثالِبُهُ","إِلّا المُبارِزُ إِبراهيمُ نائِبُهُ",22,"ب",2,1],["ما عَدَد مِثلُ ضِعفِهِ نِصفُه","تَندى عَلى لينِ كَفِّهِ كَفُّه",23,"ف",2,1],["ما عَمَّهُ بِالحُسنِ عَنبَرُ خالِهِ","إِلّا لِيُصبِحَ بِالسَوادِ مجمَّلا",24,"ل",2,0],["ما عَلى ظَنِّيَ باسُ","يَجرَحُ الدَهرُ وَياسو",25,"س",2,1],["ما عَنانا أَن يَأنَفَ السابِقُ المَربِطَ","في العِتقِ مِنهُ وَالتَطهيمِ",26,"م",1,0],["ما عَناكَ الغَداةَ مِن أَطلالِ","دارِساتِ المَقامِ مُذ أَحوالِ",27,"ل",1,1],["مَا عُذْرُ طَائِفَةٍ مِنْ قَوْمِهِ أُخِذَتْ","بِمَا أَثَارَ العِدَى مِنْ ذَلِكَ الشَّغَبِ",28,"ب",1,0],["مَا عَيْنُ فِيجَتِهَا وَصَافِي مَائِهَا","هِيَ أُمَّةٌ رَوِيَ الثَّرَى بِدِمَائِهَا",29,"ا",3,1],["مَا عِزَّة الأُمَّةِ إِنْ كَاثرَتْ","وَفِي السَّوادِ الجَهْلُ مُسْتَحْكِمُ",30,"م",1,0],["مَا عَلَى الْعِلْمِ لا وَلا طَالِبِيهِ","مِنْ نَصِيرٍ غَضَاضَةٌ أَوْ ذَامُ",31,"م",1,0],["مَا عِشتُ لا أَسْلُو صِبَايَ وَمَرْبَعاً","مِنْهُ دَرَجْتُ وَفِيهِ طَابَ مُقَامِي",32,"ي",1,0],["ما عُلِّقَ القلبُ كَتَعلِيقِها","وَاضعةً كفَّاً عَلَت مِعصَما",33,"م",2,0],["ما عصرت بسقيّا","إل بش يجري سقيّا",34,"ي",2,0],["ما عسى نقول فشكر","والوجود بشكر ينطق",34,"ق",1,0],["ما عذركم أنْ لم تجودوا بعدما","مُلْكتُمُ كَفَّ الخليفة أحمدِ",35,"د",1,1],["ما عاب من سَلّ المهنَّد أنه","للسيف من بعد التجالُد غامد",36,"د",1,0],["ما عَضَّ نابِيَ قَوماً أَو أَقولَ لَهُم","إِيّاكُمُ ثُمَّ إِيّاكُمُ وَإِيّانا",37,"ن",2,0],["ما عُدَّ قَومٌ وَإِن عَزّوا وَإِن كَرَموا","إِلّا اِفتَخَرنا بِحَقٍّ فَوقَ ما اِفتَخَروا",38,"ر",3,0],["ما عَدَّ قَومٌ بِإِحسانٍ صَنيعَهُمُ","إِلّا صَنيعُكُمُ فَوقَ الَّذي صَنَعوا",39,"ع",3,0],["ما عَلِمَ الأَقوامُ أَسرَقَ مِنكُمُ","وَأَلأَمَ لُؤماً مِنكِ قَيسَ البَراجِمِ",40,"م",1,1],["ما عاتَبَ الحُرَّ الكَريمَ كَنَفسِهِ","وَالمَرءُ يُصلِحُهُ الجَليسُ الصالِحُ",41,"ح",1,1],["ما على من عصى النهى فيه رأيٌ","لو عصى في الهوى عليَّ نهاته",42,"ت",2,0],["ما على من أمّ ساحته","أن عام الجدب لم يغث",43,"ث",1,0],["ما عقد الليل لأجفانه","هدباً ولا حل عقودَ الوداد",44,"د",1,0],["ما علمنا من قبله في تصاني","ف الهوى إنَّ لابن بسَّام عقدا",45,"د",2,0],["ما عدّ مذ ملكت يمينك رقه","عيباً عليه فلا سبيلَ لردّه",46,"ه",1,0],["ما عليكم من احمرار دموع","تتحلوا بها مع الأطواق",47,"ق",1,0],["ما عارضت يدُ أمداحِي مواهبهُ","إلاَّ رجعت بصفوِ المغنم الزاكي",48,"ك",2,0],["ما على عاشقٍ يقول على حك","مِ التداوي بالضمّ والتقبيل",49,"ل",1,0],["ما عمل في الحبّ خاف على","كتاب حسنٍ فيه مرقوم",50,"م",1,0],["ما عذولي في حبِّه برشيدٍ","لا ولا رأيُ ناصحِي بأمين",51,"ن",1,0],["ما عرفت البخل بالروح إذا","طلبتها غصص المجد الظمي",52,"م",2,0],["ما عسى نَرتجي ونحن مع الأم","وات يُحْدَى بنا أَحَثَّ الحُداءِ",53,"ا",2,0],["ما عاب ذو طعم ريا","ضَتَهُ الأمورَ ولا اقتضابهْ",54,"ب",2,0],["ما على حاكم من السعر أم ما","ذا عليهِ إن كان عاماً جديبا",55,"ب",2,0],["ما عيبُه غيرَ أنَّ صاحبَهُ","يطول عند الفراقِ مُنْتَحبُهْ",56,"ب",2,0],["مَا عذيري من هذه الحال إلا","سيِّدٌ لي من آل وَهْبٍ وَهُوبُ",57,"ب",1,0],["ما علِمْنا من لؤلؤٍ ما ذكرتَا","هي وقفٌ إذا هممتَ فَعَلْتا",58,"ت",2,1],["ما على المَفْتُون فيما","غَلَبَ الصَّبْرَ جُنَاحُ",59,"ح",1,0],["ما عذرُ مُعتزليٍّ مُوسِرٍ مَنَعتْ","كفَّاهُ مُعتزليَّاً مُقتراً صَفدا",60,"د",2,0],["ما على الأحرار من رِقٍّ إذا","نَقَدوا شكرهم مَوْلى أيادِي",61,"د",2,1],["ما عليه لو كفاني ال","قوت يا قلةَ خيرِهْ",62,"ر",2,0],["ما عاش لي ابن سعيدٍ","فإن شأني كبيرُ",63,"ر",1,0],["ما عامل الدهرَ في إقباله أحدٌ","إلا اشترى منه إقبالاً بإدبارِ",64,"ر",1,0],["ما عليه أن لا يرى فيه راءٍ","آخرَ الدهر صوبَ غيثٍ هَمُوع",65,"ع",1,0],["ما عُفرُ شابةَ في أعلى معاقله","ولا عقاب شَرَورى ضمَّها لَجَف",66,"ف",1,0],["ما عيبه غير أنه رجل","يدعو ذوي حلمنا إلى النزق",67,"ق",1,0],["ما علينا بعد شرب ال","خمر من طرح الزقاق",68,"ق",1,0],["ما عيبُ عبدِك إلا أنَّ قيمتَهُ","تنهى أخا العدلِ أن يعتدَّه خولا",69,"ل",2,0],["ما عجبنا من انفلال ابن ليثٍ","عن حسامٍ لمثله فلّالِ",70,"ل",1,0],["ما عرفناك بالبوادرِ كلّا","بل عرفناك بالعطايا العِجالِ",70,"ل",1,0],["ما علةٌ بك لا بَلْ","بكلّ حيّ ونامي",71,"م",2,0],["ما عرَّفَ اللَّهُ قبلهُ أحداً","ما فَضْلُ نعمائهِ على النقمِ",72,"م",1,0],["ما عهدناك قطُّ إلا عَزوفاً","للْمَذَلّاتِ مستباحَ الحريم",73,"م",1,0],["ما علا من طفا كما طفت الجي","فةُ في لُجَّةٍ من الطوفان",74,"ن",1,0],["ما عجيباً ألا يَغارَ عليها","بل عجيبٌ ألا تغارَ عليه",75,"ي",2,0],["ما عِشتُها لِأَعُدَّها بَل عِشتُها","لِتَبينَ في سيمائِها سيمائي",76,"ي",1,0],["ما عَلى مَن لا يُطيقُ يَرى","نَوَّرَ الوادي أَوِ اِكتَأَبا",77,"ب",2,0],["ما عُشتُ لَم يَمسُس جَوانِحَكَ الهَوى","لَم نَدرِ ما في العَيشِ مِن أَمجادِ",78,"د",1,0],["ما عَزَّ مَن لَم يَصحَبِ الخَذِما","فَاِحطِم دَواتَكَ وَاِكسِرِ القَلَما",79,"م",2,1],["ماعَسى يَفعَلُ مَولىً مُحسِنٌ","بِمُحِبٍّ قَد جَنى فيما فَعَل",80,"ل",1,0],["ما عَرَّسَت لَيلَةً إِلّا عَلى وَجَلٍ","حَتّى تَلوحَ مِنَ الصُبحِ التَباشيرُ",81,"ر",1,0],["ما على ذاك النعش جثمان سعد","بل عليه آمال قوم تسير",82,"ر",1,0],["ما على انها خبت بدليل","حاسم كون وقدها غير باد",83,"د",1,0],["ما عاش شعب نصفه","قد شل من داء اصابا",84,"ب",2,0],["ما على وجه الارض من هو يبقى","من رحاها التي تلحّ مصونا",85,"ن",2,0],["ما عند قوم ضيعوا","استقلالهم شيء يسر",86,"ر",1,0],["ما على الارض بِغَي","رِ الدم والنار غلاب",87,"ب",1,0],["ما عجيج القريض ان ضيم بدع","أي بحر ما ان له امواج",88,"ج",1,0],["ما عندليب الروض الا شاعر","في كل مورقة له ديوان",89,"ن",1,0],["ما على كفري عند","خصومي سند",90,"د",1,1],["ما علمنا لغيرهم من لسان","زال أهلوه وهو في إقبال",91,"ل",1,0],["ما علمت المجد إلا مجدكم","قُصِر المجد عليكم والعلى",92,"ل",2,0],["ما عَجبي لِمُلكِهم كَيفَ بُنى","بَل عَجبي كَيفَ تَأَخّر البنا",93,"ا",1,0],["ما عَلِمنا أَشَقوا","بِالرَحيلِ أَم سَعِدوا",94,"د",3,0],["ما عَلِمنا قائِداً في مَوطِنٍ","صَفَحَ الدَهرَ وَصَفَّ الدارِعين",95,"ن",1,0],["ما عَلى الرَكبِ مِن وُقوفِ الرِكابِ","في مَغاني الصِبا وَرَسمِ التَصابي",96,"ب",2,1],["ما عَلَيهِ أَلّا يَكونَ حُساماً","وَلَهُ في الخُطوبِ ذاكَ الهُبوبُ",97,"ب",1,0],["ما عَلِمتُ النَوى وَ