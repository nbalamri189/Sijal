 عُرِيّا",170,"ر",3,0],["ما عِشْتَ عاشَ النَّاسُ في نِعْمَةٍ","وإِنْ تَمُتْ ماتَ بِكَ النَّاسُ",171,"س",1,0],["ما عقابي من بعد ما صح نقلاً","أنَّ ما قد أتيتهُ مقدور",172,"ر",1,0],["ما عَسى أَن تفيد نَفسي المَساعي","إن قَضَت بالحبوط فيها الدواعي",173,"ي",1,1],["ما على الهجر معينٌ أبداً","وعلى النّسيانِ لا شيءَ يُعين",174,"ن",1,0],["ما عَرفَ القتلَ ولا أبصرهْ","ولا رأى من قبلُ لونَ الدماءْ",175,"ا",2,0],["ما عرَفوا في صَعقاتِ الردى","إلَّاكَ من غوثٍ ومن منجدِ",175,"د",1,0],["ما عادَ جبَّارُ الشعوبِ وإنما","قد عادَ قيصرُكِ الرشيدُ المسلمُ",176,"م",1,0],["ما على مغتربي أهل ودار","إنْ أدارا ها هنا كأس مدامِ",177,"م",1,0],["ما عجيبٌ أن تردِّيهِ عليَّا","بل عجيبٌ أنني لا زلتُ حيَّا",178,"ي",2,0],["ما عرَفتِ السفينَ من عهد نافا","رينَ غيرَ المجللاتِ الحزينه",179,"ن",2,0],["ما عالمُ الماءِ يا رُبَّان صفهُ لنا","فما تحيطُ به في الوهم أفكارُ",180,"ر",1,0],["ما عَزّتِ العُزّى بها ولوَ أنّها","لِلاتِ ما افتَقَرَتْ إلى أشياعها",181,"ع",3,0],["مَا عَلَى الْبَرْقِ لَوْ تَحَمَّلَ عَنِّي","بَعْضَ مَا خَفَّ مِنْ سَلامٍ فَأَدَّى",182,"د",2,0],["مَا عَلَى قَوْمِهِ وَإِنْ كُنْتُ حُرَّاً","أَنْ دَعَتْنِي لَهُ الْمَحَبَّةُ عَبْدَا",182,"د",2,0],["مَا عَنَاهَا إِلاَّ السَّوَادُ الَّذِي يَشْ","قَى وَمِنْ حَظِّ غَيْرِهِ الإِنْعَامُ",183,"م",1,0],["مَا عَرَاهَا أَذىً وَلَكِنْ تَغَشَّى","عَارِضٌ دُونهَا جَلاءَ النُّورِ",184,"ر",1,0],["مَا عَدَدْنَا بِغَيْرِ طَيِّبَةِ السَّا","عَاتِ أَيَّامَ سَعدِهِ وَالشُّهُورَا",185,"ر",2,0],["مَا عِشْتَ فِيهِمْ ظَلْتَ بُلْبُلَ أَيْكِهِمْ","في الأَمْنِ وَالرِّئْبَالَ في الَّلأْوَاءِ",186,"ا",2,0],["مَا عَرَفْنَا فِي النَّاسِ قَبْلَكَ فَرْداً","تَتَحَلَّى بِهِ الصِّفَاتُ الْجِيَادُ",187,"د",1,0],["مَا عَهِدْنَا فِي كَاتِبٍ أَنَّ مِنْ آ","يَاتِهِ صَوْغَ الدُّرِّ وَهْوَ مِدَادُ",187,"د",1,0],["مَا عَرَفْناك وَالْقَوَافِي بِناءٌ","قبْلَ هَذي الأَبْياتِ تُنْشِئُ شِعْرا",188,"ر",2,0],["مَا عَلَيْنَا مِنْ غِريمٍ غارِمٍ","إِنَّ أَزْرَى الخلْقِ شَعْبٌ مَاتَ صَبْرَا",189,"ر",2,0],["مَا عَلَى الحُرِّ أَنْ يَكُونَ طَمُوحاً","تَصْدَأُ البَاتِرَاتُ فِي الأَغْمَادِ",190,"د",1,0],["ماعامل في الحقل حمّل يومه","ماليس يحمل مثله الهرمان",191,"ن",1,0],["ما عابَهُ أن سيف الله جندلهُ","بل شرّفَ الفرسَ لمّا جاء يهديها",192,"ي",3,0],["ما عَلى الأَيّامِ لَو أَسعَفَتني","بِرُقوّ الدَمِّ عَن ذي الرُقيِّ",193,"ي",1,0],["ما عَقَّني الدَهرُ وَلا عاقَني","اللَهُ أَبلى وَقَضى القِسطا",194,"ط",2,0],["ما عَلى الدّهْرِ مَرَّةً لَوْ تَوانَى","أو عَلَى الدَّهْرِ ساعة لو تَهَدَّا",195,"د",2,0],["ما على الدهر لو تريّث حِيناً","أو على الدهرِ مَرّةً لو تأنَّى",196,"ن",2,0],["ما عليهم إن هام عمرٌو بهندٍ","أو شدا شاعرٌ بأيامٍ سُعدى",197,"د",2,0],["ما عهدناه على المنبر إلاّ","ماضياً كالسيفِ نصلاً وسنانا",198,"ن",2,0],["مَا عَقَّهُ حُرُّ الْبَيانِ وَلاَ جَزَتْ","أُمُّ اللُّغاتِ وَفَاءَهُ بِمطَالِ",199,"ل",1,0],["ما علينا إذا جلسنا بركن","وفتحنا حقائب الاحزان",200,"ن",1,0],["ما عاد ليْلكَ يشكو السُّهْدَ دامسُهُ","ولا نهارُك يشكو الكَدَّ والنَّصَبَا",201,"ب",2,0],["ما عيدُه إلا غداةَ تعدُّه","في شعبه فردًا من الأفراد",202,"د",1,0],["ما عَهِدْنَاهُ بالمناصب مَفْتُو","نًا، ولكنها به مفتونة",203,"ن",2,0],["ما عاق سيرَ الشعب مثلُ الداء، إذ","ينسلُّ بين حُفاته، وعُراته",204,"ت",2,0],["ما عدتَ، يا نيلُ، بعد اليوم تُظمئُنا","أو عدتَ تطْغَى علينا أيَّ طُغيانِ",205,"ن",1,0],["ما عهدنا بطولةَ الغيد إلا","في سباق الوجوه والسيقان",206,"ن",1,0],["ما عاد نورُك فتنة","يغري بإنشاد القصيد",207,"د",1,0],["ما عاد في الأرض حادثٌ جَلَلٌ","يحولُ بين الجفونِ والوسن",208,"ن",1,0],["ما عاد لي بين الحسَان سابي","يذيقني حلاوة العقَاب",209,"ب",1,0],["ما عاد يجرَحُ أُذْنَ الضاد جارحةٌ","من ذكر لُبنانَ، أو من ذكر عَمَّانا",210,"ن",2,0],["ما عاد هذا المسخُ يُزْ","عجُنا بطلْعَتِه الوَقاح",211,"ح",1,0],["ما عاش يومًا وإن طال الزمان بهِ","بل دُورُه حين تأويه مقابره",212,"ر",2,0],["ما عذرنا إن بقينا أُمة شيعًا","لكل جيش بها جندٌ وقُوَّاد؟",213,"د",1,0],["ما عاد يسبقني الحنين","إليك أو ينجر خلفي",214,"ف",2,0],["ما على الأسطول من أسطولهم","أيخاف الباز شر الحجل",215,"ل",1,0],["ما عليه إن جازها وكفته","وثبة فى السباق من وثباته",216,"ت",2,0],["ما عليه إن جاز غايته","القصوى وعد الزمان من ساعاته",216,"ت",2,0],["ماعليه إذا تعجل فى الشد","ووروى الخلود من نغماته",216,"ت",2,0],["ما عابَني غير أنّي لا أمُدُّ يداً","إلى دنيءٍ وأنّي غيرُ خوّار",217,"ر",1,0],["ما عَلِمنا كيفَ كُنّا ، وكذا","دينُ اهلِ الحبِّ والحبُّ جُنون",218,"ن",1,0],["ما علينا ما غابَ عنَّا فعندَ","اللهِ تُحصى مظاهرٌ وغيوب",219,"ب",1,0],["ما عِلّةٌ كَتَمَ التّجَهّلُ سِرَّهَا،","لَوْ لمْ يُخَبّرْنَا بِِهَا إعْلانُهَا",220,"ن",3,0],["ما عزّ قدر الأديب الحرّ بينهم","إلاّ كما عزّ قدر الحيّ في الرّمم",221,"م",1,0],["ما عليها شيء سوى اضمحلالها","والذنب للأقدار في اضمحلالها",222,"ل",3,0],["ما عجيبباً ألا يَغارَ عليها","بل عجيبٌ ألا تغارَ عليه",223,"ي",2,0],["ما على حاكمٍ من الشعر أم ما","ذا عليهِ إن كان عاماً جديبا",224,"ب",2,0],["ماعذر معتزليٍّ مُوسعٍ مَنَعتْ","كفَّاهُ مُعتزليَّاً مُقتراً صفدا",225,"د",2,0],["ما عدتُ أرضي الكاشحينَ بهجرها،","أبداً، وإنْ قالَ النصيحُ وعرضا",226,"ض",2,0],["ما عَلَى الرَّسْمِ بالبُلَيَّيْن لَوْ بَيّ","نَ رَجْعَ التَّسلِيمِ أَوْ لَوْ أَجابا",227,"ب",2,1],["ما عسى ان يضر انكار شئ","وهو كالشمس في العِيان تجلى",228,"ل",2,0]]}