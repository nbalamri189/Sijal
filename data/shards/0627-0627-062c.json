{"poems":[[55,"لعمر الطير يوم ثوى ابن ليلى","https://www.aldiwan.net/poem29808.html","الوافر"],[79,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[75,"أأجفى بلا جرم وأقصى بلا ذنب","https://www.aldiwan.net/poem11875.html","الطويل"],[5,"أأجمع صحبتي سحر ارتحال","https://www.aldiwan.net/poem302.html",""],[53,"مالي أسل من القراب وأغمد","https://www.aldiwan.net/poem61901.html","الكامل"],[47,"مثالك من طيف الخيال المعاود","https://www.aldiwan.net/poem63474.html","الطويل"],[30,"أكان الباهلي يظن أني","https://www.aldiwan.net/poem1248.html",""],[68,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[22,"فلست بمحبو ولا جد مكرم","https://www.aldiwan.net/poem21706.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39628","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39675","المتقارب"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72223","الوافر"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6812","الوافر"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/883","الوافر"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/852","الطويل"],[47,"مِثَالُكَ مِنْ طَيْفِ الخَيَالِ المُعَاوِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31687",""],[136,"يا أيها المرتدى أسنى الجلابيب","https://www.aldiwan.net/poem54882.html","البسيط"],[147,"أما وهوى عصيت له العواذل","https://www.aldiwan.net/poem11798.html","الوافر"],[234,"إذا كنت ذا قلب عزوف وهمة","https://www.aldiwan.net/poem51037.html","الطويل"],[240,"لك ذروة البيت العتيق عماده","https://www.aldiwan.net/poem32098.html","الكامل"],[242,"سلام عليكم والحوادث ألوان","https://www.aldiwan.net/poem19283.html","الطويل"],[266,"سلا عن ربي سلع فأعين عينها","https://www.aldiwan.net/poem38135.html","الطويل"],[285,"أبا حسن لئن كانت أجابت","https://www.aldiwan.net/poem60736.html","الوافر"],[299,"لعمري لجو من جواء سويقة","https://www.aldiwan.net/poem1750.html","الطويل"],[368,"أبيت اللعن والراعي متى ما","https://www.aldiwan.net/poem1693.html","الوافر"],[369,"أأجفان بيض هن أم بيض أجفان","https://www.aldiwan.net/poem60628.html","الطويل"],[445,"قل للهوى حكمت فاحكم لي","https://www.aldiwan.net/poem34825.html","أحذ الكامل"],[447,"عتاب أحال الشهد كالصاب في الحلق","https://www.aldiwan.net/poem14428.html","الطويل"],[482,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[484,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[520,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122610","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39025","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59111","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96755","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96707","الوافر"],[1175,"","https://poetry.dctabudhabi.ae/diwan/poem/67738","الوافر"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115915","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53222","الكامل"],[2233,"","https://poetry.dctabudhabi.ae/diwan/poem/98187","الكامل"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100120","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67995","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216794","البسيط"],[4568,"","https://poetry.dctabudhabi.ae/diwan/poem/143589","الكامل"],[4584,"","https://poetry.dctabudhabi.ae/diwan/poem/141866","الوافر"],[4759,"ناديت","https://www.poetsgate.com/ViewPoem.aspx?id=204102",""],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[585,"أتحسب سر الغيب طوعك بالذي","https://www.poetsgate.com/ViewPoem.aspx?id=161975",""],[5638,"لا مَثَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=198251",""],[5829,"وإن طاوعتني في الحبِّ أبشر","https://www.poetsgate.com/ViewPoem.aspx?id=178392",""],[5880,"ليلة المزرعة","https://www.poetsgate.com/ViewPoem.aspx?id=208586",""],[6068,"أ أُجْمع بالقبر عند محبٍّ -07-","https://www.poetsgate.com/ViewPoem.aspx?id=175889",""],[520,"عسى منجد الأظعان يوما يغيرها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577553",""],[242,"سلام عليكم والحوادث الوان","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563731",""]],"verses":[["أَأَجزَعُ إِن حَطَمنَ حِجازَ أَنفي","وَهُنَّ يَقِصنَ أَعناقَ القُرومِ",0,"م",1,0],["أأجْحَدُ حقَّ الحِبِّ والدّمعُ شاهِدٌ","وقد وقَعَ التّسْجيلُ منْ بعْدِ ما أدّى",1,"د",2,0],["أَأُجفى بِلا جُرمٍ وَأُقصى بِلا ذَنبِ","سِوى أَنَّني مَحضُ الهَوى صادِقُ الحُبِّ",2,"ب",1,1],["أَأَجمَعُ صُحبَتي سَحَرَ اِرتِحال","وَلَم أَشعُر بِبَينٍ مِنكِ هالا",3,"ل",2,1],["أأجور عن رَشَدي وشيْبي شامل","وقد اهتديتُ له ورأسي أسودُ",4,"د",1,0],["أَأَجحَدُكَ النَعماءَ وَهيَ جَلِيَّةٌ","وَما أَنا لِلبِرِّ الخَفِيِّ بِجاحِدِ",5,"د",1,0],["أَأَجعَلُ دارِماً كَاِبنَي دُخانٍ","وَكانا في الغَنيمَةِ كَالرِكابِ",6,"ب",1,0],["أَأَجعَلُ لي سِواكَ عَلَيكَ عَيناً","وَكُنتَ عَلى جَميعِ الناسِ عَيني",7,"ن",2,0],["أَأَجعَلُ عِرضي دونَ أَعراضِكُم لَكُم","وَأَكلُمُ عِرضاً كانَ غَيرَ مُكَلَّمِ",8,"م",1,0],["أأجلسُ يا نارُ وحدي هُنا","أراعيكِ وهْناً وأستطلعُ",9,"ع",1,0],["أأجلسُ يا بحرُ وحدي هنا","فأينَ من العين ذاك السنى",10,"ن",2,0],["أَأَجْعَلُ مِثْلَ تَوْبَةَ في نَداهُ","أَبا الذِّبان فُوهُ الدَّهْرَ دَامِي",11,"م",2,0],["أَأَجمَعُ صُحبَتي سَحَرَ اِرتِحالا","وَلَم أَشعُر بِبَينٍ مِنكِ هالا",12,"ل",2,1],["أَأَجعَلُ في الأَوائِلِ مِن نِزارٍ","كَفِعلِكَ أَم بِأُسرَتِنا اِفتِتاحي",13,"ح",2,0],["أَأَجحَدُهُ إِحسانُهُ فِيَّ إِنَّني","لَكافِرُ نُعمى إِن فَعَلتُ مُوارِبُ",14,"ب",1,0],["أأجْحَدُكَ النَّعْمَاءَ، وهيَ جَليلَةٌ،","وَمَا أنَا للبِرّ الخَفيّ بِجَاحِدِ",15,"د",1,0],["إإجعَل لَنَا الهمة العلياءَ في حِكَمٍ","نَطوِى بها البيدَ في السُّودِ الغَرَابِيبِ",16,"ب",1,0],["أَأَجحَدُ رَبعَ رَيّى وَهوَ عافٍ","زَماناً مَرَّ فيهِ وَهوَ آهِل",17,"ل",1,0],["أأجزع من صَرْف الزمان ورَيْبه","وأنت على صرف الزمان أمير",18,"ر",1,0],["أَأُجاوِزُ العَذبَ النَميرَ مُيَمِّماً","وَشلاً يَجُفُّ عَلى الوُرودِ ثَمادُهُ",19,"د",2,0],["أَأَجْوَدَ شَيْءٍ مَا أَضَنَّ خَيَالَكُمْ","عَلَى مُقْلَتِي فَالْوَجْدُ مِنْ ذَاكَ يَقْضَانُ",20,"ن",1,0],["أأجهد في الدنيا واحرم فضل من","تكفل في الأمعاء رزق جنينها",21,"ن",3,0],["أَأَجْحَدُ مِنَّةً بَدَأَتْ وَعادَتْ","إِذَنْ فَعَدَلْتُ عَنْ سَنَنٍ الْوفاءِ",22,"ا",2,0],["أأجعل نفسي وزن عِلج كأنما","يموت به كلبٌ إذا مات أجمع",23,"ع",1,0],["أَأَجرَمَ أَم جَنى أَم لَم تَخُطّوا","لَهُ أَمناً فَيوجَدَ في الكِتابِ",24,"ب",1,0],["أأجفانُ بِيضٍ هُنّ أم بِيضُ أجفانِ","فَواتِكُ لا تُبقي على الدَّنِفِ العاني",25,"ن",2,1],["أَأَجُودُ بالنَّفْسِ الَّتِي كَرُمَتْ","لِرَشاً يَضِنُّ عَلَيَّ بالوَصْلِ",26,"ل",1,0],["أَأَجزيك بالبأوا على القُرب والنَوى","وحسناك مثل الطوق قد زيّنت عنقي",27,"ق",2,0],["أأجحدُ الوجدَ ولي أدمعٌ","شهودُها تُثْبِتُ ما أجحَدُ",28,"د",1,0],["أأجبن والمخاوف لي أمان","وأخشاهم وبالله اعتصامي",29,"م",2,0],["أأجحد إحساناً أبا الفتح أرخيت","علي به أبوابهم وستورها",30,"ر",3,0],["أأجحَدُ داءَ الحُبَّ بَعدَ دَلالَةٍ","مُخامِرَةٍ والحبُّ داءٌ مُخامِر",31,"ر",1,0],["أأجنحُ من بَعْدِ الهُدى لِضَلالةٍ","وأطلب بعدَ الحقِّ أكْذبَ مَطْلَبِ",32,"ب",1,0],["أأجْحَدُكَ النَعْمَاءَ عندِي وَقد نَمَتْ","نُمُوَ الربَى جَادَتْ عَلَيْهَا الهَوَاطِلُ",33,"ل",1,0],["أأجحدُ حبَّها وكفى بجسمي","لدقَّته على وجدي دليلا",34,"ل",2,0],["أَأَجحدُ حبّ سعدى وهو سرٌّ","حقيقٌ أن يصرّح في المقالِ",35,"ل",1,0],["أأجْعَلُكُمْ وَأَقْوَاماً سَوَاءً","وَبَيْنَكُمُ وَبَيْنَهُمُ الهَوَاءُ",36,"ا",2,0],["أأجعلُ الشامَ لى داراً أحُلُّ بها","ولى بمصرَ حبيبٌ نازحُ الدَّارِ",37,"ر",1,0],["أأجيل في نظم المراثي خاطري","من بعد صوغ مدائح وتهان",38,"ن",1,0],["أأجيز قتلي في الوجيز لقاتلي","أم حل في التهذيب أم في الشامل",39,"ل",1,0],["أأجدر المرء أن يختار لثم ثرى","مرت به قدم المختار في القدم",40,"م",1,0],["أَأَجني ذنوباً فِي هواه وأبتغي","رِضاه فما عذري إِذَا كنت جانيا",41,"ي",2,0],["أأجدبتْ روضة الحسن التي غَنِيَتْ","بالزهر أم بات كاسيها كعاريها",42,"ي",3,0],["أأجامل الأهواء في طلب المُنى","ولطالما جانبْتُ ما لم يجملِ؟",43,"ل",1,0],["أآجال الورى متقاربات","بهذا الفضل أم فسد الهواء",44,"ا",2,0],["أ أ جيئ تحفلني على أ صدائها","الناس والأ جواء والأضواء",45,"ا",2,0],["أأجرى غرورا أم ستبدي صدوركم","أسود وأحداج أم الْمُورُ قد عفا",46,"ا",1,0],["أأجهزةٌ حسيةٌ أنت بعضها","تحاول ما للحس عنه كلال",47,"ل",1,0],["أَأَجْمَلَ مَنْ رَأَتْ عَيْنِي","وَمَا لَكِ فِي الْوَرَى مَثَلُ",48,"ل",1,1],["أأجحدها وقلبي قد رآها","وكل جوارحي تزهو وتزهر",49,"ر",1,0],["أأجمل منك؟ معاذ الجمال","معاذ الإله الذي أبدعَهْ!",50,"ع",2,0],["أ أُجْمع بالقبر عند محبٍّ","بعيد المواطن مهما مشيْتُ",51,"ت",1,1],["أأجحد أحياناً أبا الفتح أرخيت","عليه به أبوابهم وستورها",52,"ر",3,0],["أَأَجودُ المُنى مِن بُعدِكُم غَيرَ نابِضٍ","وَهَل لِلمُنى بَعدَ الأَحِبَّةِ شِريانُ",53,"ن",1,0]]}