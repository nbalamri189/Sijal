tps://www.aldiwan.net/poem65464.html","الكامل"],[51,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[51,"يا أبا الصقر إن شكري لمعروفك","https://www.aldiwan.net/poem66341.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[38,"إن على أهوى لألأم حاضر","https://www.aldiwan.net/poem7819.html","الكامل"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[92,"ليت لي أن أعيش في هذه الدنيا","https://www.aldiwan.net/poem38950.html","الخفيف"],[92,"كل ما هب وما دب وما","https://www.aldiwan.net/poem38957.html","الرمل"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[85,"كم لنا من عجيبة","https://www.aldiwan.net/poem7784.html","مجزوء الخفيف"],[85,"قصر الأعزة ما أعز حماكا","https://www.aldiwan.net/poem7925.html","الكامل"],[62,"ولما حللنا جميع الرموز","https://www.aldiwan.net/poem52148.html","المتقارب"],[62,"إن الهواء به الحياة","https://www.aldiwan.net/poem52230.html","مجزوء الكامل"],[45,"إني لفعلك يا محمد حامد","https://www.aldiwan.net/poem63455.html","الكامل"],[45,"غال صبري إما سألت بصبري","https://www.aldiwan.net/poem63641.html","الخفيف"],[45,"أبى الليل إلا أن يعود بطوله","https://www.aldiwan.net/poem65540.html","الطويل"],[45,"للفضل أخلاق يلقن بفضله","https://www.aldiwan.net/poem65547.html","الكامل"],[45,"أأراك الحبيب خاطر وهم","https://www.aldiwan.net/poem65655.html","الخفيف"],[28,"وما سال في واد كأودية له","https://www.aldiwan.net/poem5003.html","الطويل"],[28,"أنسيت صحبتها ومن يك مقرفا","https://www.aldiwan.net/poem5255.html","الكامل"],[49,"دار بليت بحبها خوانة لمحبها","https://www.aldiwan.net/poem10386.html","مجزوء الكامل"],[49,"لم لا نبادر ما نراه يفوت","https://www.aldiwan.net/poem10389.html","الكامل"],[49,"قطعت منك حبائل الآمال","https://www.aldiwan.net/poem63049.html","الكامل"],[49,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[66,"ورد الربيع فمرحبا بوروده","https://www.aldiwan.net/poem38811.html","الكامل"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[74,"أما وخيال قد أطاف وسلما","https://www.aldiwan.net/poem13244.html","الطويل"],[105,"خلوا سبيل الشاعر المتدفع","https://www.aldiwan.net/poem42071.html","الكامل"],[40,"من لنفس عن الهوى لا تناهى","https://www.aldiwan.net/poem42329.html","الخفيف"],[40,"لقد أرسلت ليلى رسولا بأن أقم","https://www.aldiwan.net/poem42342.html","الطويل"],[22,"شكت العنتريس نصي وإدلا","https://www.aldiwan.net/poem21677.html","الخفيف"],[52,"رثيت الحجيج فقال العداة","https://www.aldiwan.net/poem27263.html","المتقارب"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[48,"قولا لعباس لكي يدري","https://www.aldiwan.net/poem63387.html","الكامل"],[15,"ليس رسم على الدفين ببالي","https://www.aldiwan.net/poem45253.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141011",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39554","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39549","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42504","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54749","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54634","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[106,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[106,"من وحي الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=179738",""],[77,"وبحْري تلاعَبَ في شريطٍ","https://www.poetsgate.com/ViewPoem.aspx?id=33381",""],[77,"هب النسيم معطر الأراج","https://www.poetsgate.com/ViewPoem.aspx?id=33813",""],[90,"دمعَة على صديق","https://www.poetsgate.com/ViewPoem.aspx?id=179103",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"صحو بعد سكر","https://www.poetsgate.com/ViewPoem.aspx?id=178933",""],[20,"وبح ام دار حللنا بها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502574",""]],"verses":[["وَبِحَيثُ جَعجَعتِ العَريبُ ضُحىً","مِثلَ الحَنيِّ بُلي مُعَطَّفُها",0,"ف",3,0],["وَبِحَسبِ جودِكَ أَنَّني لَكَ مادِحٌ","وَبِحَسبِ مَجدي أَنَّني بِكَ فاخِرُ",1,"ر",1,0],["وَبَحرِ دَمٍ تَعومُ الطَيرُ فيهِ","وَتَرقى بَينَ أَمواجِ الطَرادِ",2,"د",1,0],["وَبَحْرٍ مِنَ الآدَابِ يَقْذِفُ مَوْجُهُ","ثَمِينَ الَّلآلِي بَيْنَ فَذٍّ وَتَوْأَمِ",3,"م",1,0],["وبَحْراً من الماءِ الأُجاجِ تَروعُنا","رَوائِعُ من أهْوالِهِ في اشْتِدادِهِ",4,"د",2,0],["وبَحَثْتُ عَنْها خَمْرَةً لمّا تَزَلْ","سَبَبَ النّجاةِ لِطالِب أوْراجِي",5,"ي",1,0],["وبَحْريٍّ تَلاعَبَ في شَريطٍ","وجِيءَ الفِعْلُ متّصِلَ الصُّموتِ",6,"ت",1,1],["وَبِحَذفِ ثالِثه يُعابُ أَخو الحِجى","إِن جاءَ فيما قالَ أَو ما يَفعَلُ",7,"ل",1,0],["وَبَحرٍ تَبَطَّنت الجَواري بِظَهرِهِ","فَجُبنَ وَهُنَّ المُقرِباتُ المَناجِبُ",8,"ب",1,0],["وَبِحِلمٍ إِذا الجَهولُ اِعتَراهُ","يَردَعُ الجَهلَ بَعدَما قَد أَشاحا",9,"ح",2,0],["وبحسن البلاء في كل قطر","يمموه كانوا فخار الجوالي",10,"ل",2,0],["وَبِحِفْظِهِ الْبَاقُونَ زِيدُوا أَنْعُماً","تَتْرَى بِمَا قَدْ أَسْلَفُوا مِنْ أَنْعُمِ",11,"م",1,0],["وَبَحرانِ مِن تَحتِها واحِدٌ","وَآخَرُ مِن فَوقِها مُطبِقُ",12,"ق",1,0],["وبحر الهند أصبح في اضطراب","يرجّم في عواقبه الظنونا",13,"ن",2,0],["وبحمده من الفقراء طفل","يذُمّ لفقد والده الحِماما",14,"م",2,0],["وبحثنا عن جوهر الحق فيه","فبلغنا دفينه وركازه",15,"ز",2,0],["وبحر علم إذا جاشت غواربه","تقاذف الدرّ في لجّيه منهالا",16,"ل",2,0],["وبحر شعر خضتهُ لذكرهِ","وغصت في البحرِ ابْتغاء درِّه",17,"ه",1,0],["وبِحَسْبي عرفانُ آل بُنانٍ","وَبُنانٌ شِرْباً معيناً رَواءَ",18,"ا",2,0],["وبحَسْب النعماءِ يُطَّلَبُ الشك","رُ كِفاءً لواهب النعماءِ",19,"ا",2,0],["وبحيث أرْيُ النحل حَدُّ حُماتها","وبحيث لذاتُ الهوى أبراحُهُ",20,"ح",2,0],["وبُحْ بالذي أنت لي مضمرٌ","فما كلُّ ما أشتهي مُسْعدي",21,"ي",1,0],["وبحقكمْ وبحقها قدِرتْ لكم","ومن الحقوق مُبَيَّنٌ وملبَّس",22,"س",1,0],["وبحقٍّ تجهُّمُ البيضِ بيضاً","أعقبَتْهُنّ أربعونَ مواضِي",23,"ض",2,0],["وبحقها وبحقه فتنت به","أنثى وأغيد كالقضيب الأهيف",24,"ف",1,0],["وبحقّي أقولُ فيك بأني","لم أجدْ موعدَ المُنى فيك آلا",25,"ل",2,0],["وبحسب المُفَنِّدي بمشيبٍ","ردَّ غَرْبَ الجماح ردَّ اللِّجام",26,"م",1,0],["وبِحَسْبي بأنَّ شكري لمعرو","فِكَ مما أُريتُهُ في المنام",27,"م",1,0],["وبحمل الثِّقلِ الثقيل عليه","يومَ غُرم ويومَ حربٍ عَوان",28,"ن",1,0],["وَبِحُزنٍ تَنَهَّدتُ","فَاِستَجاشَت تَنَهُّدي",29,"ي",1,0],["وَبِحَسبِ قَومِكَ إِن شَتَوا مَطلولَةٌ","شَرعَ النَهارِ وَمَذقَةٌ أَحيانا",30,"ن",2,0],["وبحبِّها الرَّحْبِ العميقِ الطَّامي","حتَّى تَمَلأ بالحَيَاةِ كيانُهُ",31,"ه",1,0],["وبحسبي من الأسى مَا بنفسي","من طَريفٍ مسْتَحْدَثٍ وتَلاد",32,"د",1,0],["وبحار وكهوف وذرى","وبراكين ووديان وبيد",33,"د",1,0],["وبحرٌ فسيحٌ بعيدُ القرارِ","يَضُجُّ ويَدْوي دويَّ الوليدْ",34,"د",1,0],["وبحار تحوّلت","من مكان لبقعة",35,"ه",1,0],["وَبِحِكمَةٍ في الحُكمِ تَوفيقِيَّةٍ","لَكَ يَقتَفي فيها الرِجالُ خُطاكا",36,"ك",2,0],["وبحنا بأسرارهم في الذي","جمعنا وجئنا بما أهملوا",37,"ل",3,0],["وبحرّه وعفونة","في طبعه ظهر الديب",38,"ب",1,0],["وَبِحُرمَةِ الأَدَبِ المُقَرِّبِ بَينَنا","وَالناسُ فيهِ أَقارِبٌ وَأَباعِدُ",39,"د",1,0],["وَبِحَسبِ الشَريفِ حُلَّةَ فَخرٍ","بَعضُ ما أَلبَسَتكَ أَقوافُ شِعري",40,"ي",1,0],["وَبَحرٌ يَمُدُّ الراغِبونَ عُيونَهُم","إِلى ظاهِرِ المَعروفِ فيهِم جَزيلِهِ",41,"ل",2,0],["وَبِحَسبِهِ المَأمونُ وَالمَهدِيُّ وَالمَن","صورُ مِن كُثرِ الفَعالِ وَقُلِّهِ",42,"ل",2,0],["وَبِحَقٍّ إِنَّ السُيوفَ لَتَنبو","تارَةً وَالعُيونَ بِاللَحظِ تُدمي",43,"ي",1,0],["وَبَحرُ أَبي سُفيانَ وَاِبنَيهِ يَلتَقي","لَهُنَّ إِذا يَعلو الحَصينَ المُشَيَّدا",44,"د",2,0],["وَبِحَقِّها وَأَبيكَ تُهزَلُ مالَها","مالٌ فَيَعصِمَها وَلا أَيسارُ",45,"ر",1,0],["وَبِحَمدِها وَبِذَمِّها","وَبِحُبِّها وَبِسَبِّها",46,"ب",3,0],["وَبِحَسبِ مَن يَسمو إِلى الشَهَواتِ ما","يَكفيهِ مِن شَهَواتِهِ وَيَقوتُ",47,"ت",1,0],["وَبِحَسبِ مَن تُنعى إِلَيهِ نَفسُهُ","مِنهُم بِأَيّامٍ خَلَت وَلَيالِ",48,"ل",1,0],["وَبِحَسبِ عَقلِكَ بِالزَمانِ مُؤَدَّباً","وَبِحَسبِهِ بِتَقَلُّبِ الأَحوالِ",49,"ل",1,0],["وَبِحُسنِ مَنظَرِهِ وَطيبِ نَسيمِهِ","وَأَنيقِ مَلبَسِهِ وَوَشيِ بُرودِهِ",50,"د",2,0],["وَبِحَرْبِيّةٍ لها نِفْطُ حَرْبٍ","يحرقُ الماءَ تارةً باضطرامِ",51,"م",1,0],["وَبَحرِ حَديدٍ قَد تَلاطَمَ أَخضَرٍ","إِذا عَصَفَت ريحُ الجِلادِ بِهِ طَمى",52,"م",2,0],["وَبحبلِ ربِّكَ ذي الجلالةِ فاعتصمْ","وإليه في كلِّ المواطنِ فارْجعِ",53,"ع",1,0],["وَبِحَسبِ الفَتاةِ قُرباً مِنَ المَج","دِ قُصَيٌّ إِن يَعدِلُوا مَولاها",54,"ا",3,0],["وَبُحتُ بِما قَد وَسَّعَ الناسُ ذِكرَهُ","وَأَكثَرُهُ في الصَدرِ مِنيِّ مُزَمَّلُ",55,"ل",1,0],["وَبِحَملِ العَظيمِ عِندَ عُرى الكَي","دِ إِذا ضَنَّ كُلُّ صائِدِ مالِ",56,"ل",1,0],["وَبَحرُ العُلومِ وَغَيظُ الخُصومِ","مَتى يَصطَرِع وَهُمُ يَغلِبِ",57,"ب",1,0],["وبِحُبِّ النبيِّ فابْغِ رِضَى الل","هِ فَفِي حُبِّهِ الرِّضا والحِبَاءُ",58,"ا",2,0],["وبِحاتمٍ فُتِحَتْ سِيادَةُ هُرْمُزٍ","وغَدا تَمِيمٌ لِلْمَكَارِمِ يَهْتَدِي",59,"د",2,0],["وَبِحُسنِ صُنعِ اللَهِ يا عَجَبا","لَكَ في جَميعِ الشَأنِ وَالأَمرِ",60,"ر",1,0],["وَبِحَظٍّ مِمّا نَعيشُ فَلا تَذ","هَب بِكِ التُرَّهاتُ في الأَهوالِ",61,"ل",1,0],["وبحبسي أني صدعتُ بما أد","ري على علمي أنه سيضير",62,"ر",1,0],["وبحر أبو المسك الخضمّ الّذي له","على كلّ بحرٍ زخرةٌ وعباب",63,"ب",1,0],["وبحارٌ إن رُدْتُها لم تجدْ غَ","يرَ جليدٍ من لجَّةٍ وضفافِ",64,"ف",1,0],["وبحارةُ الوادي تلفَّعُ بالدُجى","وتُنْشِد ألحانَ الربيع المباكرِ",65,"ر",1,0],["وَبَحْرٍ مِنَ الْهَيجَاءِ خُضْتُ عُبابَهُ","وَلا عاصِمٌ إِلَّا الصَّفِيحُ المُشَطَّبُ",66,"ب",1,0],["وَبِحَضْرَمَوْتَ عَلَى تَنَائِي دَارِهَا","شَكْوَى كَشَكْوَى تُونُسَ الخَضْرَاءِ",67,"ا",2,0],["وَبِحَقِّ مَنْ كُنْتَ المُنِي","بَ إِلَيْهِ يَا نِعْمَ المُنِيبُ",68,"ب",1,0],["وَبِحَقٍّ مَا أَحْرَزُوهُ جَمِيعاً","بَيْنَنَا مِنْ تَجِلَّةٍ وَوِدَادِ",69,"د",1,0],["وَبِحَضْرَةِ المَلِكِ المَهِيبِ وَمُلْتَقَى","وُزَرَائِهِ وَالشّعْبِ وَالنُّوّابِ",70,"ب",1,0],["وبحوت اليوم كم من رجل","وجدت كي تصل السبل وقد",71,"د",1,0],["وبِحَارٌ من الأنَاسِيِّ ماجَتْ","مُزْبداتٍ يَجِشْنَ جَزْراً ومَدَّا",72,"د",2,0],["وبحصِبَهُمْ بحرُها بالشُّواظِ","ويقذِفَهُمْ جوُّها بالحُمَمْ",73,"م",1,0],["وبحسبُ الفأرَ -إذ يبدو له- جملاً","يَعدو عليه، فيجري خشيةَ الفار",74,"ر",1,0],["وبحْري تلاعَبَ في شريطٍ","وحيّ الفِعْلَ مُتّصلَ الصُّموتِ",75,"ت",1,1],["وبحثت عنها خمرة لما تزل","سبب النجاة لطالب أوراج",76,"ج",1,0],["وبحَسْبِ \" أحمدَ \" لوعة \"أنَّ ابنهُ","لبس الغروبَ ولم يَعُدْ لطلوع\"",77,"ع",1,0],["وبحَشْرجاتِ الذاهبينَ مُثيرةً","للقادمينَ مواكباً فمواكبا",78,"ب",2,0],["وبح لي بأسرار الغرام فرحمة","بأهل الهوى غني مغن ونغما",79,"م",2,0],["وَبحَ أمِّ دارٍ حَلَلنا بِها","بَينَ الثَّوِيَّةِ والمَردَمَه",80,"م",2,1]]}