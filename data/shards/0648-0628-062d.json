مان الوافي","https://www.aldiwan.net/poem61693.html","الكامل"],[456,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[456,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[456,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[456,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[456,"أمرتكم أمري بنعمان ناصحا","https://www.aldiwan.net/poem56253.html","الطويل"],[459,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[462,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[462,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[462,"وجودك غادر النعمى معينا","https://www.aldiwan.net/poem3274.html","عموديه"],[462,"أما وابتسام البرق في عابس الدجن","https://www.aldiwan.net/poem3514.html","عموديه"],[477,"تقدم وقل حطة يا جرير","https://www.aldiwan.net/poem37034.html","المتقارب"],[493,"ألم ترني فارقت قيسي وخندفي","https://www.aldiwan.net/poem9856.html","الطويل"],[498,"تدوس بساط الله والقلب فاقد","https://www.aldiwan.net/poem37566.html","الطويل"],[498,"عوجا إلى الوادي المقدس بالسرى","https://www.aldiwan.net/poem37817.html","الكامل"],[498,"قسما بثائرة الغرام المذهل","https://www.aldiwan.net/poem37925.html","الكامل"],[498,"وحد الله ولا تشرك به","https://www.aldiwan.net/poem38033.html","الرمل"],[498,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[503,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[512,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[512,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[512,"لما نهج النوى بالسير شديتم","https://www.aldiwan.net/poem20903.html","المواليا"],[536,"بلغ إلى المولى الهمام سلامي","https://www.aldiwan.net/poem47926.html","عموديه"],[536,"بمكتبة ابن زيدان حللت","https://www.aldiwan.net/poem47967.html","عموديه"],[536,"كيف المآل إذا تكون الحال","https://www.aldiwan.net/poem47997.html","عموديه"],[536,"بحقكم في مهجتي راقبوا الربا","https://www.aldiwan.net/poem48266.html","عموديه"],[549,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[549,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[549,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[549,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[551,"نبا به الوساد","https://www.aldiwan.net/poem68396.html","مجزوء الرجز"],[556,"وجدت كنزا هنا هو البركه","https://www.aldiwan.net/poem33508.html","المنسرح"],[556,"أنا العاشق السالي لوجهك يا علو","https://www.aldiwan.net/poem33585.html","الطويل"],[556,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[556,"لنا غرق كلنا في القدم","https://www.aldiwan.net/poem33853.html","المتقارب"],[556,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[556,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[560,"لمن الدمع بعد هذا تصون","https://www.aldiwan.net/poem52978.html","الخفيف"],[561,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[565,"بكاء وقل غناء البكاء","https://www.aldiwan.net/poem69825.html","الطويل"],[584,"أبدا بذكرك تنقضي أوقاتي","https://www.aldiwan.net/poem17455.html","الكامل"]],"verses":[["وَبِحَيثُ جَعجَعتِ العَريبُ ضُحىً","مِثلَ الحَنيِّ بُلي مُعَطَّفُها",0,"ف",3,0],["وَبِحَسبِ جودِكَ أَنَّني لَكَ مادِحٌ","وَبِحَسبِ مَجدي أَنَّني بِكَ فاخِرُ",1,"ر",1,0],["وَبَحرِ دَمٍ تَعومُ الطَيرُ فيهِ","وَتَرقى بَينَ أَمواجِ الطَرادِ",2,"د",1,0],["وَبَحْرٍ مِنَ الآدَابِ يَقْذِفُ مَوْجُهُ","ثَمِينَ الَّلآلِي بَيْنَ فَذٍّ وَتَوْأَمِ",3,"م",1,0],["وبَحْراً من الماءِ الأُجاجِ تَروعُنا","رَوائِعُ من أهْوالِهِ في اشْتِدادِهِ",4,"د",2,0],["وبَحَثْتُ عَنْها خَمْرَةً لمّا تَزَلْ","سَبَبَ النّجاةِ لِطالِب أوْراجِي",5,"ي",1,0],["وبَحْريٍّ تَلاعَبَ في شَريطٍ","وجِيءَ الفِعْلُ متّصِلَ الصُّموتِ",6,"ت",1,1],["وَبِحَذفِ ثالِثه يُعابُ أَخو الحِجى","إِن جاءَ فيما قالَ أَو ما يَفعَلُ",7,"ل",1,0],["وَبَحرٍ تَبَطَّنت الجَواري بِظَهرِهِ","فَجُبنَ وَهُنَّ المُقرِباتُ المَناجِبُ",8,"ب",1,0],["وَبِحِلمٍ إِذا الجَهولُ اِعتَراهُ","يَردَعُ الجَهلَ بَعدَما قَد أَشاحا",9,"ح",2,0],["وبحسن البلاء في كل قطر","يمموه كانوا فخار الجوالي",10,"ل",2,0],["وَبِحِفْظِهِ الْبَاقُونَ زِيدُوا أَنْعُماً","تَتْرَى بِمَا قَدْ أَسْلَفُوا مِنْ أَنْعُمِ",11,"م",1,0],["وَبَحرانِ مِن تَحتِها واحِدٌ","وَآخَرُ مِن فَوقِها مُطبِقُ",12,"ق",1,0],["وبحر الهند أصبح في اضطراب","يرجّم في عواقبه الظنونا",13,"ن",2,0],["وبحمده من الفقراء طفل","يذُمّ لفقد والده الحِماما",14,"م",2,0],["وبحثنا عن جوهر الحق فيه","فبلغنا دفينه وركازه",15,"ز",2,0],["وبحر علم إذا جاشت غواربه","تقاذف الدرّ في لجّيه منهالا",16,"ل",2,0],["وبحر شعر خضتهُ لذكرهِ","وغصت في البحرِ ابْتغاء درِّه",17,"ه",1,0],["وبِحَسْبي عرفانُ آل بُنانٍ","وَبُنانٌ شِرْباً معيناً رَواءَ",18,"ا",2,0],["وبحَسْب النعماءِ يُطَّلَبُ الشك","رُ كِفاءً لواهب النعماءِ",19,"ا",2,0],["وبحيث أرْيُ النحل حَدُّ حُماتها","وبحيث لذاتُ الهوى أبراحُهُ",20,"ح",2,0],["وبُحْ بالذي أنت لي مضمرٌ","فما كلُّ ما أشتهي مُسْعدي",21,"ي",1,0],["وبحقكمْ وبحقها قدِرتْ لكم","ومن الحقوق مُبَيَّنٌ وملبَّس",22,"س",1,0],["وبحقٍّ تجهُّمُ البيضِ بيضاً","أعقبَتْهُنّ أربعونَ مواضِي",23,"ض",2,0],["وبحقها وبحقه فتنت به","أنثى وأغيد كالقضيب الأهيف",24,"ف",1,0],["وبحقّي أقولُ فيك بأني","لم أجدْ موعدَ المُنى فيك آلا",25,"ل",2,0],["وبحسب المُفَنِّدي بمشيبٍ","ردَّ غَرْبَ الجماح ردَّ اللِّجام",26,"م",1,0],["وبِحَسْبي بأنَّ شكري لمعرو","فِكَ مما أُريتُهُ في المنام",27,"م",1,0],["وبحمل الثِّقلِ الثقيل عليه","يومَ غُرم ويومَ حربٍ عَوان",28,"ن",1,0],["وَبِحُزنٍ تَنَهَّدتُ","فَاِستَجاشَت تَنَهُّدي",29,"ي",1,0],["وَبِحَسبِ قَومِكَ إِن شَتَوا مَطلولَةٌ","شَرعَ النَهارِ وَمَذقَةٌ أَحيانا",30,"ن",2,0],["وبحبِّها الرَّحْبِ العميقِ الطَّامي","حتَّى تَمَلأ بالحَيَاةِ كيانُهُ",31,"ه",1,0],["وبحسبي من الأسى مَا بنفسي","من طَريفٍ مسْتَحْدَثٍ وتَلاد",32,"د",1,0],["وبحار وكهوف وذرى","وبراكين ووديان وبيد",33,"د",1,0],["وبحرٌ فسيحٌ بعيدُ القرارِ","يَضُجُّ ويَدْوي دويَّ الوليدْ",34,"د",1,0],["وبحار تحوّلت","من مكان لبقعة",35,"ه",1,0],["وَبِحِكمَةٍ في الحُكمِ تَوفيقِيَّةٍ","لَكَ يَقتَفي فيها الرِجالُ خُطاكا",36,"ك",2,0],["وبحنا بأسرارهم في الذي","جمعنا وجئنا بما أهملوا",37,"ل",3,0],["وبحرّه وعفونة","في طبعه ظهر الديب",38,"ب",1,0],["وَبِحُرمَةِ الأَدَبِ المُقَرِّبِ بَينَنا","وَالناسُ فيهِ أَقارِبٌ وَأَباعِدُ",39,"د",1,0],["وَبِحَسبِ الشَريفِ حُلَّةَ فَخرٍ","بَعضُ ما أَلبَسَتكَ أَقوافُ شِعري",40,"ي",1,0],["وَبَحرٌ يَمُدُّ الراغِبونَ عُيونَهُم","إِلى ظاهِرِ المَعروفِ فيهِم جَزيلِهِ",41,"ل",2,0],["وَبِحَسبِهِ المَأمونُ وَالمَهدِيُّ وَالمَن","صورُ مِن كُثرِ الفَعالِ وَقُلِّهِ",42,"ل",2,0],["وَبِحَقٍّ إِنَّ السُيوفَ لَتَنبو","تارَةً وَالعُيونَ بِاللَحظِ تُدمي",43,"ي",1,0],["وَبَحرُ أَبي سُفيانَ وَاِبنَيهِ يَلتَقي","لَهُنَّ إِذا يَعلو الحَصينَ المُشَيَّدا",44,"د",2,0],["وَبِحَقِّها وَأَبيكَ تُهزَلُ مالَها","مالٌ فَيَعصِمَها وَلا أَيسارُ",45,"ر",1,0],["وَبِحَمدِها وَبِذَمِّها","وَبِحُبِّها وَبِسَبِّها",46,"ب",3,0],["وَبِحَسبِ مَن يَسمو إِلى الشَهَواتِ ما","يَكفيهِ مِن شَهَواتِهِ وَيَقوتُ",47,"ت",1,0],["وَبِحَسبِ مَن تُنعى إِلَيهِ نَفسُهُ","مِنهُم بِأَيّامٍ خَلَت وَلَيالِ",48,"ل",1,0],["وَبِحَسبِ عَقلِكَ بِالزَمانِ مُؤَدَّباً","وَبِحَسبِهِ بِتَقَلُّبِ الأَحوالِ",49,"ل",1,0],["وَبِحُسنِ مَنظَرِهِ وَطيبِ نَسيمِهِ","وَأَنيقِ مَلبَسِهِ وَوَشيِ بُرودِهِ",50,"د",2,0],["وَبِحَرْبِيّةٍ لها نِفْطُ حَرْبٍ","يحرقُ الماءَ تارةً باضطرامِ",51,"م",1,0],["وَبَحرِ حَديدٍ قَد تَلاطَمَ أَخضَرٍ","إِذا عَصَفَت ريحُ الجِلادِ بِهِ طَمى",52,"م",2,0],["وَبحبلِ ربِّكَ ذي الجلالةِ فاعتصمْ","وإليه في كلِّ المواطنِ فارْجعِ",53,"ع",1,0],["وَبِحَسبِ الفَتاةِ قُرباً مِنَ المَج","دِ قُصَيٌّ إِن يَعدِلُوا مَولاها",54,"ا",3,0],["وَبُحتُ بِما قَد وَسَّعَ الناسُ ذِكرَهُ","وَأَكثَرُهُ في الصَدرِ مِنيِّ مُزَمَّلُ",55,"ل",1,0],["وَبِحَملِ العَظيمِ عِندَ عُرى الكَي","دِ إِذا ضَنَّ كُلُّ صائِدِ مالِ",56,"ل",1,0],["وَبَحرُ العُلومِ وَغَيظُ الخُصومِ","مَتى يَصطَرِع وَهُمُ يَغلِبِ",57,"ب",1,0],["وبِحُبِّ النبيِّ فابْغِ رِضَى الل","هِ فَفِي حُبِّهِ الرِّضا والحِبَاءُ",58,"ا",2,0],["وب