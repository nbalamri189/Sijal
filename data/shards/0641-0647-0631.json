{"poems":[[88,"أجدك يا كواكب لا ترينا","https://www.aldiwan.net/poem45071.html","الوافر"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[4,"درس المنا بمتالع فأبان","https://www.aldiwan.net/poem21206.html","الكامل"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43853","البسيط"],[4,"إن تقوى ربنا خير نفل","https://www.poetsgate.com/ViewPoem.aspx?id=687",""],[288,"أصرمت حبل الوصل من فتر","https://www.aldiwan.net/poem1918.html","أحذ الكامل"],[291,"أسفا لقد ولى الشباب ولم أفد","https://www.aldiwan.net/poem11672.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[588,"أرى كل ما قد قدر الله يكتب","https://www.aldiwan.net/poem11510.html","عموديه"]],"verses":[["«فهرشل» ما شفى منا غليلًا","ولا «غاليلُ» أنبأنا اليقينا",0,"ن",2,0],["فَهَرَقنا لَهُما في دائِرٍ","لِضَواحيهِ نَشيشٌ بِالبَلَل",1,"ل",1,0],["فَهَرَقتُ أُذنِبَةً عَلى مُتَثَلِّمٍ","خَلقٍ بِمُعتَدِلٍ مِنَ الأَصفانِ",2,"ن",1,0],["فَهَرَتْ إلى صَدْرِ التُّرابِ","وقدْ قَضَتْ أَشْواقُهَا",3,"ه",2,0],["فِهرُ المَعالي مَعي بَكتهُ","وَأسعدَت بِالبُكا ثَقيفُ",4,"ف",1,0],["فهَرَقْنَا لَهُمَا في داثِرٍ","لَضواحيهِ نَشِيشٌ بالبَلَلْ",5,"ل",1,0],["فَهَراقَ في طَرَفِ العَسيبِ إِلى","مُتَقَبِّلٍ لِنَواطِفٍ صُفرِ",6,"ر",1,0],["فهرمت قبل الشيب وانحلت قوى","جسدي ببرح الهمّ والأوصاب",7,"ب",1,0],["فهربوا فمنهم ابن منية","وكان ذا مال كثير القنية",8,"ه",1,0],["فهرتها بالميل وهو مشرب","بذاك الدوى الموذي لها حين ينكب",9,"ب",1,0]]}