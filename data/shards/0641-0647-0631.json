{"poems":[[90,"أجدك يا كواكب لا ترينا","https://www.aldiwan.net/poem45071.html","الوافر"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[4,"درس المنا بمتالع فأبان","https://www.aldiwan.net/poem21206.html","الكامل"],[94,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43853","البسيط"],[4,"إن تقوى ربنا خير نفل","https://www.poetsgate.com/ViewPoem.aspx?id=687",""],[292,"أصرمت حبل الوصل من فتر","https://www.aldiwan.net/poem1918.html","أحذ الكامل"],[295,"أسفا لقد ولى الشباب ولم أفد","https://www.aldiwan.net/poem11672.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[592,"أرى كل ما قد قدر الله يكتب","https://www.aldiwan.net/poem11510.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63760","الكامل"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/138856",""],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77631","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77550","الرجز"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44792","الكامل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101569","الكامل"],[2210,"","https://poetry.dctabudhabi.ae/diwan/poem/107082","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132699","الطويل"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68001","الكامل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202349","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131013",""],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103800","المجتث"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111459","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77131","الرجز"],[4308,"","https://poetry.dctabudhabi.ae/diwan/poem/34763","المنسرح"],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""],[5909,"نغماً أراقتْ معدني الأسماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=210236",""],[6102,"فُرات !!","https://www.poetsgate.com/ViewPoem.aspx?id=184551",""],[6167,"فرار الضياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85536&r=&rc=19",""]],"verses":[["«فهرشل» ما شفى منا غليلًا","ولا «غاليلُ» أنبأنا اليقينا",0,"ن",2,0],["فَهَرَقنا لَهُما في دائِرٍ","لِضَواحيهِ نَشيشٌ بِالبَلَل",1,"ل",1,0],["فَهَرَقتُ أُذنِبَةً عَلى مُتَثَلِّمٍ","خَلقٍ بِمُعتَدِلٍ مِنَ الأَصفانِ",2,"ن",1,0],["فَهَرَتْ إلى صَدْرِ التُّرابِ","وقدْ قَضَتْ أَشْواقُهَا",3,"ه",2,0],["فِهرُ المَعالي مَعي بَكتهُ","وَأسعدَت بِالبُكا ثَقيفُ",4,"ف",1,0],["فهَرَقْنَا لَهُمَا في داثِرٍ","لَضواحيهِ نَشِيشٌ بالبَلَلْ",5,"ل",1,0],["فَهَراقَ في طَرَفِ العَسيبِ إِلى","مُتَقَبِّلٍ لِنَواطِفٍ صُفرِ",6,"ر",1,0],["فهرمت قبل الشيب وانحلت قوى","جسدي ببرح الهمّ والأوصاب",7,"ب",1,0],["فهربوا فمنهم ابن منية","وكان ذا مال كثير القنية",8,"ه",1,0],["فهرتها بالميل وهو مشرب","بذاك الدوى الموذي لها حين ينكب",9,"ب",1,0],["فهرقلةٍ ذات المزا","هر والقناطرِ والسَّواري",10,"ر",2,0],["فَهرَاق ودقُ سهامهم لمزاده","وانتابه منها لذاك كلام",11,"م",1,0],["فَهَرَبَت كُلُّ الكُبوش مِنهُ","وَحَوَّلت وَجهَ الثَبات عَنهُ",12,"ه",1,0],["فَهرع الوحوش للجَنازَه","وَدَخَلوا للغار بِالإِجازَه",13,"ه",1,0],["فَهَرَبتَ إِنَّكَ في الجَما","دِ إِذَن لَذو أَسمى شُعورِ",14,"ر",1,0],["فهرعت نحو الرَوضِ معدوم القوى","أبكي وأفواه الأزاهر تبسم",15,"م",1,0],["فهر دسنك تارة","وجردسن إذا انجلى",16,"ل",2,0],["فهرت كلاب الحوئبين نوابحاً","عليك وما زادتك الا توغلا",17,"ل",2,0],["فهر في وجهي من في الدار حل","سر لا على اسم ربنا عزوجل",18,"ل",1,0],["فهُرزت من طرب كَأَنَّ جوانحي","سيف الأمير إذَا أراد كفاحا",19,"ح",2,0],["فهربت من زمني اليك فذدته","عني بأحمى من حماه وأمنعا",20,"ع",2,0],["فهرناكم والملك قد كان ذوايا","فكيف وروض الملك فينان احضر",21,"ر",1,0],["فهر بهاؤون در","مشطب قد تعضعظ",22,"ظ",1,0],["فَهَرفَلِيونُ بنَ فيليمشنِ","بَدا لِلقَواضِبِ لا يَنثَني",23,"ي",1,0],["فهرَقلٌ قَد دَكَّ إِليُونَ لا بَل","دَكَّها حُمقٌ لَومِدُونَ الرَّعُونِ",24,"ن",1,0],["فَهَرَستُ شَمسُ الفَضلِ أَعني المَغرب","مُحَمَّد نَجلُ سُلَيمان الأَبي",25,"ي",1,0],["فَهَروَلَت عِندَ ذاكَ إِذ عَظُمَ ال","أَمرُ وَقالَت وَدَمعُها هَطِلُ",26,"ل",1,0],["فهر عن أشداق مكر ساطيا","لكنه ما كاد يدنو أو خسا",27,"ا",1,0],["فهرول فيما بين ذلك وانبرى","فلا ذا ولا هذا تأتى ولا حصل",28,"ل",1,0],["فهرعتُ للقلمِ القديم مجدِّدٌ","فلكم دعته لمجدها عفراءُ",29,"ا",2,0],["فَهَرِمنا وَ لَمْ تَزَلْ - وَيكَ - غَضًّا !","وَ مَضَينا وَ أَنتَ يا نَهرُ راسِ !",30,"س",1,0],["فهربتُ من داءٍ تفيَّأَ حُسنَها","والناسُ تبحرُ في خِضمِّ دماءِ",31,"ا",2,0]]}