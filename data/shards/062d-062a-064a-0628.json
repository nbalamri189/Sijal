{"poems":[[53,"غالى بها الزائد حتى ابتاعها","https://www.aldiwan.net/poem30152.html","الرجز"],[53,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[55,"عبث الحبيب وكان منه صدود","https://www.aldiwan.net/poem26371.html","الكامل"],[30,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[88,"وفدفد قاتم الأعماق متسع","https://www.aldiwan.net/poem44438.html","البسيط"],[88,"نجيت بالسد بغدادا من الغرق","https://www.aldiwan.net/poem44443.html","البسيط"],[88,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[88,"هي النفوس وإن لم تبلغ الحلما","https://www.aldiwan.net/poem44830.html","البسيط"],[27,"أمسيت إذ رحل الشباب حزينا","https://www.aldiwan.net/poem4446.html","الكامل"],[27,"صرم الخليط تباينا وبكورا","https://www.aldiwan.net/poem5774.html","الكامل"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[72,"سقى حماك من الوسمي باكره","https://www.aldiwan.net/poem18704.html","البسيط"],[91,"صبرا على هجرها إن كان يرضيها","https://www.aldiwan.net/poem62813.html","عموديه"],[89,"لم يطمئن القوم في بغداد","https://www.aldiwan.net/poem44851.html","الكامل"],[85,"قل للمؤيد ما دهاك","https://www.aldiwan.net/poem7356.html","مجزوء الكامل"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[85,"إثن عنان القلب واسلم به","https://www.aldiwan.net/poem63782.html","السريع"],[45,"بعدوك الحدث الجليل الواقع","https://www.aldiwan.net/poem64709.html","الكامل"],[61,"لا يعرف العدل وهو معتدل","https://www.aldiwan.net/poem51483.html","السريع"],[66,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[31,"يا قلب هل لك عن حميدة زاجر","https://www.aldiwan.net/poem42488.html","الكامل"],[40,"حور بعثن رسولا في ملاطفة","https://www.aldiwan.net/poem42344.html","البسيط"],[52,"ذهب الشباب وكدر العمر","https://www.aldiwan.net/poem27013.html","الكامل"],[52,"يا ابن الوزير والوزير أنتا","https://www.aldiwan.net/poem27203.html","الرجز"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[75,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[48,"يا طيبنا بقصور القفص مشرفة","https://www.aldiwan.net/poem62551.html","البسيط"],[48,"لا تبك رسما بجانب السند","https://www.aldiwan.net/poem62559.html","المنسرح"],[48,"يا من جداه قليل","https://www.aldiwan.net/poem65017.html","المجتث"],[48,"سبحان من خلق الخل","https://www.aldiwan.net/poem66166.html","المجتث"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85835","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85583","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16626","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19289","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30464","الكامل"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/142406","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42553","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55080","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[68,"","https://poetry.dctabudhabi.ae/diwan/poem/25961","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[77,"إن كنت تنكر ما تكن ضلوعي","https://www.poetsgate.com/ViewPoem.aspx?id=34176",""],[50,"يا ابني جلا هل بكما تنكير","http://www.aldiwanalarabi.com/poemDescription.do?poemId=488717",""],[109,"قد كنت أسمع بالهوى فأكذب","https://www.aldiwan.net/poem16610.html","الكامل"],[132,"بالسب من يدعى ما ليس فيه حر","https://www.aldiwan.net/poem54822.html","البسيط"],[132,"ما للشجى على برح الغرام يد","https://www.aldiwan.net/poem54853.html","الطويل"],[142,"ما زال يكشف عنى كل طارقة","https://www.aldiwan.net/poem58377.html","البسيط"],[143,"ظن الأراك لدى واديه أظعانا","https://www.aldiwan.net/poem11832.html","عموديه"],[160,"هذا التأني وهذا الحلم قد فعلا","https://www.aldiwan.net/poem58892.html","البسيط"],[189,"أقبل على مدح النبي مفخما","https://www.aldiwan.net/poem35104.html","الكامل"],[198,"لله شهر ما انتظرت هلاله","https://www.aldiwan.net/poem51884.html","الكامل"],[198,"يا فتية الحي كفوا الأعين النجلا","https://www.aldiwan.net/poem51900.html","البسيط"],[211,"مازلت أمرح في نعمى وعافية","https://www.aldiwan.net/poem46333.html","البسيط"],[229,"غيري رمين ذوات الأعين النجل","https://www.aldiwan.net/poem50856.html","البسيط"],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[235,"يا علو أغريت السهاد بناظري","https://www.aldiwan.net/poem32015.html","الكامل"],[235,"يا ابن الدوامي الذي هو عصمة","https://www.aldiwan.net/poem32122.html","الكامل"],[259,"الحمد لله مهذب النفوس","https://www.aldiwan.net/poem35935.html","الرجز"],[297,"يا راحلين وهم في القلب سكان","https://www.aldiwan.net/poem33146.html","البسيط"],[297,"عارضه السندسي من رقمه","https://www.aldiwan.net/poem33169.html","المنسرح"],[297,"لا تقل البدر لاح في الغسق","https://www.aldiwan.net/poem33210.html","المنسرح"],[298,"هلم ننشد يا صاحبي معا","https://www.aldiwan.net/poem36288.html","عموديه"],[316,"خطب طرقت به أمر طروق","https://www.aldiwan.net/poem69430.html","البسيط"],[353,"ما للمتيم حائما حول الحمى","https://www.aldiwan.net/poem39959.html","الكامل"],[353,"وفى لنا الدهر إسعادا بما وعدا","https://www.aldiwan.net/poem40401.html","البسيط"],[362,"حب جديد","https://www.aldiwan.net/poem11635.html","عموديه"],[364,"لمن الركائب سيرهن تهاد","https://www.aldiwan.net/poem60948.html","الكامل"],[364,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[377,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[377,"الله ألله حق صادق أبدا","https://www.aldiwan.net/poem59411.html","البسيط"],[393,"قدم الرئيس مقدما في سبقه","https://www.aldiwan.net/poem53490.html","الكامل"],[393,"ما لعلي العلاء أشباه","https://www.aldiwan.net/poem53682.html","المنسرح"],[437,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[439,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[439,"الشمس شاهدة وإن تك واحده","https://www.aldiwan.net/poem34857.html","الكامل"],[439,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[441,"يا خالق الخلق يا من جوده الجود","https://www.aldiwan.net/poem14289.html","البسيط"],[441,"العذل يقلق والصبابة تلبس","https://www.aldiwan.net/poem14308.html","الكامل"],[441,"طيف لليلى على شحط النوى طرقا","https://www.aldiwan.net/poem14316.html","البسيط"],[441,"ليتني كنت شجره","https://www.aldiwan.net/poem14371.html","مجزوء الرجز"],[441,"لا يمنع الموت حجاب ولا زرد","https://www.aldiwan.net/poem14449.html","البسيط"],[452,"أرنت الورق وهنا فوق أبراج","https://www.aldiwan.net/poem13683.html","البسيط"],[452,"يا عقلة حنت إليك حشا","https://www.aldiwan.net/poem13834.html","مجزوء الكامل"],[453,"وددت أهدي طويل العمر من أدبي","https://www.aldiwan.net/poem61568.html","البسيط"],[458,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[464,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[464,"عز الجفون وذلة الصبر","https://www.aldiwan.net/poem3484.html","عموديه"],[468,"يا رب ذات قلائد نازعتها","https://www.aldiwan.net/poem59687.html","المتقارب"],[468,"وليلة لم تك في سري","https://www.aldiwan.net/poem60007.html","السريع"],[468,"لما أتى النيل لنا من لجه","https://www.aldiwan.net/poem60328.html","الرجز"],[477,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[477,"ما الدمع بعد نوى الأحبة عار","https://www.aldiwan.net/poem15339.html","الكامل"],[514,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[514,"يا منة لذ بها السكر","https://www.aldiwan.net/poem20811.html","أحذ الكامل"],[538,"بعد التطلع لي بعيد ندائي","https://www.aldiwan.net/poem48308.html","عموديه"],[551,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[553,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[558,"إن الفناء طهارة الإنسان","https://www.aldiwan.net/poem33788.html","الكامل"],[558,"عجبت من شيئين قد أجمعت","https://www.aldiwan.net/poem34079.html","السريع"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["حَتّى بَنى النَيُّ عَلى سَنامِها","مَبانِياً ما بَطَنَت سِياعَها",0,"ع",3,0],["حَتّى بَلَغتَ مِنَ العَلياءِ مَنزِلَةً","تُفدى الأَعاجِمُ فيها بِالأَعاريبِ",1,"ب",1,0],["حَتّى بَرى جِسمي هَواكِ فَما تُرى","إِلاّ عِظامٌ يُبَّسٌ وَجُلودُ",2,"د",1,0],["حَتّى بَهَرتَ فَما تَخفى عَلى أَحَدٍ","إِلّا عَلى أَحَد لا يَعرفُ القَمَرا",3,"ر",2,0],["حتى بلغت به أقصى مدىً عجزت","عنه العتاق من الجرد السراحيب",4,"ب",1,0],["حتى بنيت وكان النهر منفلقاً","سدّاً عليه رصيناً غير منفلق",5,"ق",1,0],["حتى بدا الفجر لي وقد طفِقت","تغرق في فيض نوره الشهب",6,"ب",1,0],["حتى بدت مُخزيات اللؤم مشركةً","من الحِجاز حسيناً ثالثاً بهما",7,"م",2,0],["حَتّى بَلينَ مِنَ الوَجيفِ وَرَدَّها","بُعدُ المَفاوِزِ كَالقِسِيِّ حَنينا",8,"ن",2,0],["حَتّى بُليتُ وَما عَلِمتِ بِهَمِّنا","وَرَأَيتُ أَفضَلَ نَفعِكِ التَغيِيرا",9,"ر",2,0],["حتى بَدَا حَاجِبٌ من الشَّمسِ وال","حَاجِبِ منها الشَّرقِّي مُحتَجِبُ",10,"ب",1,0],["حتَّى بدا الصبح يحكِي وجه سيِّدنا","قاضي القضاة إذا استجداه زائره",11,"ر",2,0],["حَتّى بَدا الفَجرُ وَاِعتَلَّت نَسائِمُهُ","وَكادَ يَنشُرُ أَسراري وَيُفشيها",12,"ي",3,0],["حتى بدا لي والزمان معلم","ان الاحبة في العراق اعاد",13,"د",1,0],["حتى بطرت وآذنت","عنك السعود بالانفكاك",14,"ك",1,0],["حَتّى بَلَغتَ سَماءً لا يُطارُ لَها","عَلى جَناحٍ وَلا يُسعى عَلى قَدَمِ",15,"م",1,0],["حَتّى بَنَيتُم هَرَماً رابِعاً","مِن فِئَةِ الحَقِّ وَمِن حِزبِهِ",16,"ب",2,0],["حَتّى بَرَزتَ لَنا وَجَأشُكَ ساكِنٌ","مِن نَجدَةٍ وَضِياءُ وَجهِكَ ساطِعُ",17,"ع",1,0],["حتَّى بدا الفَجرُ في مُوَرَّدَةٍ","كأنَّه من جَمالِهِ خَجِلُ",18,"ل",1,0],["حَتّى بَدا فَلَقُ الصَباحِ فَراعَهُ","إِنَّ الصَباحَ هُوَ العَدوُّ الأَزرَقُ",19,"ق",1,0],["حَتّى بَدا لي مِن حُمَيدَةَ خُلَّتي","بَينٌ وَكُنتُ مِنَ الفِراقِ أُحاذِرُ",20,"ر",1,0],["حَتّى بَدا ساطِعُ مِلفَجرِ تَحسبُهُ","سَنا حَريقٍ بِلَيلٍ حِينَ يَضطَرِمُ",21,"م",1,0],["حَتّى بَلَغتَ السُؤلَ مِنهُ فَهَل","حانَ اِلتَقى لَكَ وَاِنجَلى الشُكرُ",22,"ر",1,0],["حَتّى بَلَغتَ الآنَ ما بَلَغتا","فَراحَ فينا سالِماً وَدُمتا",23,"ت",2,0],["حتى بكى عَمراً هِشامٌ في الثَّرَى","مِنْ ذِلَّةٍ وَنَعَى حُيَيّاً أَخْطَبُ",24,"ب",1,0],["حتى بدَتْ والبدرُ في سِرْبالِها","فكأنّها خَيْفَانةٌ صَدراء",25,"ا",2,0],["حَتّى بَدَت غُرَّةُ الإِثنَينِ واضِحَةً","وَالسَعدُ مُعتَرِضٌ وَالطالِعُ الأَسَدُ",26,"د",1,0],["حَتّى بَذَلنا بِعَقرِها مِئَةً","صَفراءَ تَبدو بِكَفِّ مُنتَقِدِ",27,"د",1,0],["حَتّى بَدا مِنكَ ما لَم","يُطِقهُ قَطُّ مَلولُ",28,"ل",1,0],["حَتّى بَدَت حَرَكاتٌ","مَخلوقَةٌ مِن سُكونِ",29,"ن",1,0],["حتى بدتْ هزيمةُ البَشكنسِ","كأَنَّهُ مُخْتضبٌ بالوَرْسِ",30,"س",1,0],["حتى بَدَوْا إليه بالبرهانِ","من أكبرِ الآباءِ والوِلْدانِ",30,"ن",1,0],["حتى بَنى جرنكشه بجَنبها","حِصْناً منيعاً كافلاً بحَرْبها",30,"ه",2,0],["حتى بدا الضعف به","وارتجفت منه الركب",31,"ب",1,0],["حَتى براها الهمّ وان","حلَّت لما قاست قواها",32,"ا",3,0],["حتى بدا الفجْرُ به حُمْرَةٌ","كصَارمٍ غَيّرَ مِنْه الدّمُ",33,"م",1,0],["حَتّى بَدا الصُبحُ فَوَلّى أَبي","وَأَقبَلَت بَعدَ العَناءِ اِبنَتي",34,"ي",1,0],["حتى بدتْ سيدة الأمصار","وبلدة الأعيان والأنصار",35,"ر",1,0],["حتى بدت منازل الرومان","ساهرة الخطّيّ واليماني",36,"ي",1,0],["حتى بدا الثغر فودّت قُبْلة","كما اشتهى العبسيّ ثغر عبله",36,"ه",1,0],["حتَّى بَدا عبْد العَزيز لناظِرَيْ","أَمَلِي فمَزَّقْتُ الدُّجَى عن نُورِه",37,"ر",2,0],["حتّى بكيت فذابت كلّ واحدة","منهنّ في أدمع النائي الذي وفدا",38,"د",2,0],["حَتَّى بَدَا الْفَجْرُ مِنْ أَطْرَافِ ظُلْمَتِهَا","كَغُرَّةٍ فِي جَوَادٍ أَدْهَم وَضَحَتْ",39,"ت",1,0],["حَتَّى بَدتْ فِي القُدْسِ آيَاتٌ مَحَتْ","كِسَفَ الدُّجَى فَإِذَا الغُرُوب شُرُوقُ",40,"ق",1,0],["حتَّى بَثَثْتَ الْيَوْمَ بَثكَ","وَانْفَرَدْتَ بِهِ انْفِرَادَكْ",41,"ك",1,0],["حتى بَدا لي مَقامُ لم يكُنْ أَرَبي","ولم يَمُرّ بأفكاري وأوهامي",42,"ي",1,0],["حتى بدت غُرّةُ الدُسْتورِ عن كَثَبِ","كما تبدّى هلالُ العِيدِ في العيد",43,"د",1,0],["حتى بكى لي عاذلي من رحمة","ورثى لطول صبابتي وولوع",44,"ع",1,0],["حَتّى بَدا في رَأسِيَ القَتيرُ","وَعَصَبَت في هَمِّها قَدورُ",45,"ر",1,0],["حَتى بَليت بِحُلوه وَبِمُره","مَن كانَ يَنهم الهَوى فيجرّب",46,"ب",1,0],["حتى بَدَا لِى ما شَاهَدتُ مِن عَجَبٍ","عُذنَا بِعِزَّتِهِ مِن ضَيعَةِ العُمُرِ",47,"ر",1,0],["حَتَّى بَعَثتَ قَرِيضاً دُونَ دَاعيَةٍ","كَأنَّكَ انقَطَعَت عَن حِزبِكَ الشَّدَدُ",48,"د",1,0],["حتى بلغن إلى الغاياب حاسرةً","هُتْمَ السنابكِ من بدءٍ وتعقيبِ",49,"ب",1,0],["حَتّى بَدَت أَنجُماً في الأَرضِ باقِيَةً","فَكَم رَجَمتُم بِها مِنَ الإِنسِ شَيطانا",50,"ن",2,0],["حتى بدى وجهك الميمونُ فانقشعت","تلك الغياهبُ بالنور الذي اشتعلا",51,"ل",2,0],["حتَّى بَدا في الكون نوراً أعظما","اللَّهُ قَد صلّى عليهِ وسلّما",52,"م",2,0],["حتى بدا منه أَغن مهفهف","لضيائه ينجابُ كلُّ ظلام",53,"م",1,0],["حتى بدا ذنبُ السرحانِ يُعْجِلنا","برفعهِ من ظلامِ الليل ما انسدلا",54,"ل",2,0],["حتى بلغت بجدى بعض ما طمحت","إليه نفسي كما يرجوه لي وطني",55,"ي",1,0],["حتى بلغتَ المُصَلّى خاشعاً نَسِكاً","خشوعَ جَدِّك في أَزمانِه الأُولِ",56,"ل",1,0],["حَتّى بَدَت أَنوارُهُ في وَضعِها","فَرَأَت قُصورَ الشامِ رُؤيَةَ داني",57,"ن",2,0],["حَتّى بَدا فَلَكُ الصَباحِ كَأَنَّهُ","عَدلُ الخَليفَةِ في الزَمانِ الجائِرِ",58,"ر",1,0],["حَتّى بَعَثتَ مُلاطِفاً مُتَفَنِّناً","في المَكرُماتِ بِسُكَّرٍ وَبَنَفسَجِ",59,"ج",1,0],["حتّى بدا ما قد بدا من الّذي","قد كان لكن عهدنا لم يُنبَذِ",60,"ذ",1,0],["حتّى بدا الفَجرُ فاِرتاعت كواكبُها","كأَنَّها نَقَدٌ وَالفَجرُ سرحانُ",61,"ن",1,0],["حتّى بَدا الصبحُ فاِنثَنى عجلاً","لَم يشِ واشٍ به ولا اِتَّهمَه",62,"م",2,0],["حتّى بَدا فيه وهو مُنفَلقٌ","يشقُّ ثَوبَ الظَلام من حَنَقِ",63,"ق",1,0],["حتى بدا نورُه يبدد من","غياهبِ الجهلِ أَجبلا فرعا",64,"ع",2,0],["حتى بديك كنت آلف قريه","حسن إلي من الديوك رشيق",65,"ق",1,0],["حَتّى بَرى جَسَدي الغَرام فَلَم يَدع","مِنّي سِوى شَبَحٍ يَلوحُ تَوَهُّما",66,"م",2,0],["حَتّى بَدا صبحُ أَفراح المَلا فَمَحا","لَيل العَنا فَأرانا لِلهَنا جددا",67,"د",2,0],["حتى باتَ كالسرِّ الدَّفينْ","في بُؤرةٍ،",68,"ه",1,0],["حتىّ بَعُدْنَ فعادَ عنهم ناظري","وأبَى الصّبابةُ أن يَعودَ فؤادي",69,"د",2,0],["حتى بَدتْ تُطلِقُ طَيْرَ الدُّجى","من شَكِ الأنجُمِ كفُّ الصباح",70,"ح",1,0],["حتى بك الفخر أضحى مفرداً علماً","لو سامه آخرٌ بالجد لم يَصل",71,"ل",1,0],["حتى بذلك أتنبَّا على أَمَةٍ","بكرٍ مقدسةٍ ما شانها عار",72,"ر",1,0],["حَتّى بَدا من فَوقِ أَجرَدَ سابِحٍ","اِن قالَ فُتُّ الريحَ فاه بِصِدقِهِ",73,"ق",2,0],["حَتّى بَكى الدينُ مِن صَنيعِكُمُ","وَاِنبَجَسَت بِالدِماءِ عَيناهُ",74,"ا",2,0],["حتى بدا الصبحُ يحكى في تبلّجهِ","وجه المليك عماد الدين ذي الرتب",75,"ب",1,0],["حَتَّى بلغتُ بك المُنى إِلّا الحَصى","إِذ لَمْ تُقَيَّضْ لي بشكرِكَ أَلْسُنا",76,"ن",2,0],["حَتَّى بَسَطْتَ لخاضِعٍ ومُقَبِّلٍ","كفّاً لسيفِ البأْسِ عنهُمْ غامِدَهْ",77,"د",2,0],["حَتَّى بَدا الصُّبحُ مُشمَطّاً ذَوائِبُهُ","يُطارِدُ اللَّيلَ مَوْشِيّاً أكارِعُهُ",78,"ع",2,0],["حتى بدا الأبطح الأعلى وشاع لنا","ضوضاء ليلى ولاح الصدر والجيد",79,"د",1,0],["حتى بدت أعلام ليلى قدست","اسم الإله وهم بها فتقدسوا",80,"س",3,0],["حتى بقبري أذري الدمع معتفراً","بتربه فعسى أن أطفئ الحرقا",81,"ق",2,0],["حتى بها لا ناظر","يعيد فيها نظره",82,"ر",2,0],["حتى به ظفرت أصحابه وبه","نور الايابة مثل الشمس يتقد",83,"د",1,0],["حتى بدت واردي غدر أنها سحراً","تشدو كورقٍ وسُمَّانٍ ودُرَّاج",84,"ج",1,0],["حتى بدا فَلَقُ الصباح","وقمتُ حرانَّ الدموعِ",85,"ع",1,0],["حتى بيثرب ضج القبر من جزع","لأمّة بعد نور رهن ظلماء",86,"ا",2,0],["حتى بمكة صار البيت في دنس","من قومكم بين أبناء وأحباء",86,"ا",2,0],["حتى بلغتُ مسرحَ العزّ به","بأوّل الشوط وأقرب الأمدْ",87,"د",1,0],["حتى بدا ضوء الصباح كطلعة ال","ملك العزيز سطت على ظلمائها",88,"ا",3,0],["حتى بدا وكأنَّ طلعتهُ","وجهُ الوزير يهشُّ بالبشرِ",89,"ر",1,0],["حَتّى بَدا وَجهُ الصَباحِ كَأَنَّهُ","صَفحُ الصَديقِ عَنِ الصَديقِ المَجرِمِ",90,"م",1,0],["حَتّى بَدا الصُبحُ وَقَد سَرَّني","ما تَمَّ لِلوَصلِ عَلى الهَجرِ",91,"ر",1,0],["حَتّى بَدا الصُبحِ لَهُ بِعِلجِهِ","فَقُمتُ مَسروراً بِقَتلِ زَنجِهِ",92,"ج",2,0],["حتى بقيتُ شَبَحَاً","للعائدينَ لا أُرى",93,"ر",2,0],["حتى بدا وَضَحُ المشيبِ فلم يَرُقَ","في العيشِ منه سكينةٌ ووَقارُ",94,"ر",1,0],["حتّى بَدا كِسرى الصّباح وأدبرَتْ","قومُ النّجاشي عن عَساكر قيصَرِ",95,"ر",1,0],["حتّى بلغْتُ أبا الحُسين به","فبلغْتُ حيث يُرَفرِفُ النّسرُ",96,"ر",1,0],["حتَّى بدا فَجرا زمانُ محمّدٍ","زَينُ الإمارَة صَفوَةُ الأُمَراء",97,"ا",2,0],["حتّى بدا وَضَحٌ كُغرّةِ شادِخٍ","أو بارقٌ يحدو إليك بُروقا",98,"ق",2,0],["حَتّى بُعِثتَ عَلَيها رَحمَةً فَخَبَت","نيرانُها بِكَ فَاِنفَتَّت أَفاعيها",99,"ي",3,0],["حتى به حدث يزول وإن يكن","ماء تراه مقيداً بمعاني",100,"ي",1,0],["حتى بدا التنزيه عنها به","واحتاج هذا الأمر للإختصام",101,"م",1,0],["حتى بلغت القائم المهديا","أعني إمام عصرنا المرضيا",102,"ي",2,0]]}