m/ViewPoem.aspx?id=136825",""],[5950,"أغاني الراحلين ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128337",""],[5956,"لله درُّ الأريحية سامِيا","https://www.poetsgate.com/ViewPoem.aspx?id=208562",""],[6019,"إشتياق بعنوان آخر !!","https://www.poetsgate.com/ViewPoem.aspx?id=53047",""],[6068,"قالت: فطورك جاهزُ -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175940",""],[6068,"إن الأساتذة اﻷلى نفضوا -4-","https://www.poetsgate.com/ViewPoem.aspx?id=177340",""],[6093,"القصيدة الزبيدية في مدح خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=195006",""],[6102,"دِيوانُ العَربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=182739",""],[6127,"فداء العرش","https://www.poetsgate.com/ViewPoem.aspx?id=189496",""],[6234,"الربيع الفاتن في نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6538&r=&rc=5",""],[5126,"صورة منّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87799&r=&rc=14",""],[6352,"هي دار غيبته فحي قبابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22743&r=&rc=4",""]],"verses":[["حَتّى بَنى النَيُّ عَلى سَنامِها","مَبانِياً ما بَطَنَت سِياعَها",0,"ع",3,0],["حَتّى بَلَغتَ مِنَ العَلياءِ مَنزِلَةً","تُفدى الأَعاجِمُ فيها بِالأَعاريبِ",1,"ب",1,0],["حَتّى بَرى جِسمي هَواكِ فَما تُرى","إِلاّ عِظامٌ يُبَّسٌ وَجُلودُ",2,"د",1,0],["حَتّى بَهَرتَ فَما تَخفى عَلى أَحَدٍ","إِلّا عَلى أَحَد لا يَعرفُ القَمَرا",3,"ر",2,0],["حتى بلغت به أقصى مدىً عجزت","عنه العتاق من الجرد السراحيب",4,"ب",1,0],["حتى بنيت وكان النهر منفلقاً","سدّاً عليه رصيناً غير منفلق",5,"ق",1,0],["حتى بدا الفجر لي وقد طفِقت","تغرق في فيض نوره الشهب",6,"ب",1,0],["حتى بدت مُخزيات اللؤم مشركةً","من الحِجاز حسيناً ثالثاً بهما",7,"م",2,0],["حَتّى بَلينَ مِنَ الوَجيفِ وَرَدَّها","بُعدُ المَفاوِزِ كَالقِسِيِّ حَنينا",8,"ن",2,0],["حَتّى بُليتُ وَما عَلِمتِ بِهَمِّنا","وَرَأَيتُ أَفضَلَ نَفعِكِ التَغيِيرا",9,"ر",2,0],["حتى بَدَا حَاجِبٌ من الشَّمسِ وال","حَاجِبِ منها الشَّرقِّي مُحتَجِبُ",10,"ب",1,0],["حتَّى بدا الصبح يحكِي وجه سيِّدنا","قاضي القضاة إذا استجداه زائره",11,"ر",2,0],["حَتّى بَدا الفَجرُ وَاِعتَلَّت نَسائِمُهُ","وَكادَ يَنشُرُ أَسراري وَيُفشيها",12,"ي",3,0],["حتى بدا لي والزمان معلم","ان الاحبة في العراق اعاد",13,"د",1,0],["حتى بطرت وآذنت","عنك السعود بالانفكاك",14,"ك",1,0],["حَتّى بَلَغتَ سَماءً لا يُطارُ لَها","عَلى جَناحٍ وَلا يُسعى عَلى قَدَمِ",15,"م",1,0],["حَتّى بَنَيتُم هَرَماً رابِعاً","مِن فِئَةِ الحَقِّ وَمِن حِزبِهِ",16,"ب",2,0],["حَتّى بَرَزتَ لَنا وَجَأشُكَ ساكِنٌ","مِن نَجدَةٍ وَضِياءُ وَجهِكَ ساطِعُ",17,"ع",1,0],["حتَّى بدا الفَجرُ في مُوَرَّدَةٍ","كأنَّه من جَمالِهِ خَجِلُ",18,"ل",1,0],["حَتّى بَدا فَلَقُ الصَباحِ فَراعَهُ","إِنَّ الصَباحَ هُوَ العَدوُّ الأَزرَقُ",19,"ق",1,0],["حَتّى بَدا لي مِن حُمَيدَةَ خُلَّتي","بَينٌ وَكُنتُ مِنَ الفِراقِ أُحاذِرُ",20,"ر",1,0],["حَتّى بَدا ساطِعُ مِلفَجرِ تَحسبُهُ","سَنا حَريقٍ بِلَيلٍ حِينَ يَضطَرِمُ",21,"م",1,0],["حَتّى بَلَغتَ السُؤلَ مِنهُ فَهَل","حانَ اِلتَقى لَكَ وَاِنجَلى الشُكرُ",22,"ر",1,0],["حَتّى بَلَغتَ الآنَ ما بَلَغتا","فَراحَ فينا سالِماً وَدُمتا",23,"ت",2,0],["حتى بكى عَمراً هِشامٌ في الثَّرَى","مِنْ ذِلَّةٍ وَنَعَى حُيَيّاً أَخْطَبُ",24,"ب",1,0],["حتى بدَتْ والبدرُ في سِرْبالِها","فكأنّها خَيْفَانةٌ صَدراء",25,"ا",2,0],["حَتّى بَدَت غُرَّةُ الإِثنَينِ واضِحَةً","وَالسَعدُ مُعتَرِضٌ وَالطالِعُ الأَسَدُ",26,"د",1,0],["حَتّى بَذَلنا بِعَقرِها مِئَةً","صَفراءَ تَبدو بِكَفِّ مُنتَقِدِ",27,"د",1,0],["حَتّى بَدا مِنكَ ما لَم","يُطِقهُ قَطُّ مَلولُ",28,"ل",1,0],["حَتّى بَدَت حَرَكاتٌ","مَخلوقَةٌ مِن سُكونِ",29,"ن",1,0],["حتى بدتْ هزيمةُ البَشكنسِ","كأَنَّهُ مُخْتضبٌ بالوَرْسِ",30,"س",1,0],["حتى بَدَوْا إليه بالبرهانِ","من أكبرِ الآباءِ والوِلْدانِ",30,"ن",1,0],["حتى بَنى جرنكشه بجَنبها","حِصْناً منيعاً كافلاً بحَرْبها",30,"ه",2,0],["حتى بدا الضعف به","وارتجفت منه الركب",31,"ب",1,0],["حَتى براها الهمّ وان","حلَّت لما قاست قواها",32,"ا",3,0],["حتى بدا الفجْرُ به حُمْرَةٌ","كصَارمٍ غَيّرَ مِنْه الدّمُ",33,"م",1,0],["حَتّى بَدا الصُبحُ فَوَلّى أَبي","وَأَقبَلَت بَعدَ العَناءِ اِبنَتي",34,"ي",1,0],["حتى بدتْ سيدة الأمصار","وبلدة الأعيان والأنصار",35,"ر",1,0],["حتى بدت منازل الرومان","ساهرة الخطّيّ واليماني",36,"ي",1,0],["حتى بدا الثغر فودّت قُبْلة","كما اشتهى العبسيّ ثغر عبله",36,"ه",1,0],["حتَّى بَدا عبْد العَزيز لناظِرَيْ","أَمَلِي فمَزَّقْتُ الدُّجَى عن نُورِه",37,"ر",2,0],["حتّى بكيت فذابت كلّ واحدة","منهنّ في أدمع النائي الذي وفدا",38,"د",2,0],["حَتَّى بَدَا الْفَجْرُ مِنْ أَطْرَافِ ظُلْمَتِهَا","كَغُرَّةٍ فِي جَوَادٍ أَدْهَم وَضَحَتْ",39,"ت",1,0],["حَتَّى بَدتْ فِي القُدْسِ آيَاتٌ مَحَتْ","كِسَفَ الدُّجَى فَإِذَا الغُرُوب شُرُوقُ",40,"ق",1,0],["حتَّى بَثَثْتَ الْيَوْمَ بَثكَ","وَانْفَرَدْتَ بِهِ انْفِرَادَكْ",41,"ك",1,0],["حتى بَدا لي مَقامُ لم يكُنْ أَرَبي","ولم يَمُرّ بأفكاري وأوهامي",42,"م",2,0],["حتى بدت غُرّةُ الدُسْتورِ عن كَثَبِ","كما تبدّى هلالُ العِيدِ في العيد",43,"د",1,0],["حتى بغاث الطير تسمو أنفا","عن مشروب تخزى به لمنتضى",44,"ا",1,0],["حتى بكى لي عاذلي من رحمة","ورثى لطول صبابتي وولوع",45,"ع",1,0],["حَتّى بَدا في رَأسِيَ القَتيرُ","وَعَصَبَت في هَمِّها قَدورُ",46,"ر",1,0],["حتى بغاث الطير تسمو أنفاً","عن مشرب تخزى به لمنتضى",47,"ا",1,0],["حَتى بَليت بِحُلوه وَبِمُره","مَن كانَ يَنهم الهَوى فيجرّب",48,"ب",1,0],["حتى بَدَا لِى ما شَاهَدتُ مِن عَجَبٍ","عُذنَا بِعِزَّتِهِ مِن ضَيعَةِ العُمُرِ",49,"ر",1,0],["حَتَّى بَعَثتَ قَرِيضاً دُونَ دَاعيَةٍ","كَأنَّكَ انقَطَعَت عَن حِزبِكَ الشَّدَدُ",50,"د",1,0],["حتى بلغن إلى الغاياب حاسرةً","هُتْمَ السنابكِ من بدءٍ وتعقيبِ",51,"ب",1,0],["حَتّى بَدَت أَنجُماً في الأَرضِ باقِيَةً","فَكَم رَجَمتُم بِها مِنَ الإِنسِ شَيطانا",52,"ن",2,0],["حتى بدى وجهك الميمونُ فانقشعت","تلك الغياهبُ بالنور الذي اشتعلا",53,"ل",2,0],["حتَّى بَدا في الكون نوراً أعظما","اللَّهُ قَد صلّى عليهِ وسلّما",54,"م",2,0],["حتى بدا منه أَغن مهفهف","لضيائه ينجابُ كلُّ ظلام",55,"م",1,0],["حتى بدا ذنبُ السرحانِ يُعْجِلنا","برفعهِ من ظلامِ الليل ما انسدلا",56,"ل",2,0],["حتى بلغت بجدى بعض ما طمحت","إليه نفسي كما يرجوه لي وطني",57,"ن",2,0],["حتى بلغتَ المُصَلّى خاشعاً نَسِكاً","خشوعَ جَدِّك في أَزمانِه الأُولِ",58,"ل",1,0],["حَتّى بَدَت أَنوارُهُ في وَضعِها","فَرَأَت قُصورَ الشامِ رُؤيَةَ داني",59,"ن",2,0],["حَتّى بَدا فَلَكُ الصَباحِ كَأَنَّهُ","عَدلُ الخَليفَةِ في الزَمانِ الجائِرِ",60,"ر",1,0],["حَتّى بَعَثتَ مُلاطِفاً مُتَفَنِّناً","في المَكرُماتِ بِسُكَّرٍ وَبَنَفسَجِ",61,"ج",1,0],["حتّى بدا ما قد بدا من الّذي","قد كان لكن عهدنا لم يُنبَذِ",62,"ذ",1,0],["حتّى بدا الفَجرُ فاِرتاعت كواكبُها","كأَنَّها نَقَدٌ وَالفَجرُ سرحانُ",63,"ن",1,0],["حتّى بَدا الصبحُ فاِنثَنى عجلاً","لَم يشِ واشٍ به ولا اِتَّهمَه",64,"م",2,0],["حتّى بَدا فيه وهو مُنفَلقٌ","يشقُّ ثَوبَ الظَلام من حَنَقِ",65,"ق",1,0],["حتى بدا نورُه يبدد من","غياهبِ الجهلِ أَجبلا فرعا",66,"ع",2,0],["حتى بديك كنت آلف قريه","حسن إلي من الديوك رشيق",67,"ق",1,0],["حَتّى بَرى جَسَدي الغَرام فَلَم يَدع","مِنّي سِوى شَبَحٍ يَلوحُ تَوَهُّما",68,"م",2,0],["حَتّى بَدا صبحُ أَفراح المَلا فَمَحا","لَيل العَنا فَأرانا لِلهَنا جددا",69,"د",2,0],["حتى باتَ كالسرِّ الدَّفينْ","في بُؤرةٍ،",70,"ه",1,0],["حتىّ بَعُدْنَ فعادَ عنهم ناظري","وأبَى الصّبابةُ أن يَعودَ فؤادي",71,"د",2,0],["حتى بَدتْ تُطلِقُ طَيْرَ الدُّجى","من شَكِ الأنجُمِ كفُّ الصباح",72,"ح",1,0],["حتى بك الفخر أضحى مفرداً علماً","لو سامه آخرٌ بالجد لم يَصل",73,"ل",1,0],["حتى بذلك أتنبَّا على أَمَةٍ","بكرٍ مقدسةٍ ما شانها عار",74,"ر",1,0],["حَتّى بَدا من فَوقِ أَجرَدَ سابِحٍ","اِن قالَ فُتُّ الريحَ فاه بِصِدقِهِ",75,"ق",2,0],["حَتّى بَكى الدينُ مِن صَنيعِكُمُ","وَاِنبَجَسَت بِالدِماءِ عَيناهُ",76,"ا",2,0],["حتى بدا الصبحُ يحكى في تبلّجهِ","وجه المليك عماد الدين ذي الرتب",77,"ب",1,0],["حَتَّى بلغتُ بك المُنى إِلّا الحَصى","إِذ لَمْ تُقَيَّضْ لي بشكرِكَ أَلْسُنا",78,"ن",2,0],["حَتَّى بَسَطْتَ لخاضِعٍ ومُقَبِّلٍ","كفّاً لسيفِ البأْسِ عنهُمْ غامِدَهْ",79,"د",2,0],["حَتَّى بَدا الصُّبحُ مُشمَطّاً ذَوائِبُهُ","يُطارِدُ اللَّيلَ مَوْشِيّاً أكارِعُهُ",80,"ع",2,0],["حتى بدا الأبطح الأعلى وشاع لنا","ضوضاء ليلى ولاح الصدر والجيد",81,"د",1,0],["حتى بدت أعلام ليلى قدست","اسم الإله وهم بها فتقدسوا",82,"س",3,0],["حتى بقبري أذري الدمع معتفراً","بتربه فعسى أن أطفئ الحرقا",83,"ق",2,0],["حتى بها لا ناظر","يعيد فيها نظره",84,"ر",2,0],["حتى به ظفرت أصحابه وبه","نور الايابة مثل الشمس يتقد",85,"د",1,0],["حتى بدت واردي غدر أنها سحراً","تشدو كورقٍ وسُمَّانٍ ودُرَّاج",86,"ج",1,0],["حتى بدا فَلَقُ الصباح","وقمتُ حرانَّ الدموعِ",87,"ع",1,0],["حتى بيثرب ضج القبر من جزع","لأمّة بعد نور رهن ظلماء",88,"ا",2,0],["حتى بمكة صار البيت في دنس","من قومكم بين أبناء وأحباء",88,"ا",2,0],["حتى بلغتُ مسرحَ العزّ به","بأوّل الشوط وأقرب الأمدْ",89,"د",1,0],["حتى بدا ضوء الصباح كطلعة ال","ملك العزيز سطت على ظلمائها",90,"ا",3,0],["حتى بدا وكأنَّ طلعتهُ","وجهُ الوزير يهشُّ بالبشرِ",91,"ر",1,0],["حَتّى بَدا وَجهُ الصَباحِ كَأَنَّهُ","صَفحُ الصَديقِ عَنِ الصَديقِ المَجرِمِ",92,"م",1,0],["حَتّى بَدا الصُبحُ وَقَد سَرَّني","ما تَمَّ لِلوَصلِ عَلى الهَجرِ",93,"ر",1,0],["حَتّى بَدا الصُبحِ لَهُ بِعِلجِهِ","فَقُمتُ مَسروراً بِقَتلِ زَنجِهِ",94,"ج",2,0],["حتى بقيتُ شَبَحَاً","للعائدينَ لا أُرى",95,"ر",2,0],["حتى بدا وَضَحُ المشيبِ فلم يَرُقَ","في العيشِ منه سكينةٌ ووَقارُ",96,"ر",1,0],["حتّى بَدا كِسرى الصّباح وأدبرَتْ","قومُ النّجاشي عن عَساكر قيصَرِ",97,"ر",1,0],["حتّى بلغْتُ أبا الحُسين به","فبلغْتُ حيث يُرَفرِفُ النّسرُ",98,"ر",1,0],["حتَّى بدا فَجرا زمانُ محمّدٍ","زَينُ الإمارَة صَفوَةُ الأُمَراء",99,"ا",2,0],["حتّى بدا وَضَحٌ كُغرّةِ شادِخٍ","أو بارقٌ يحدو إليك بُروقا",100,"ق",2,0],["حَتّى بُعِثتَ عَلَيها رَحمَةً فَخَبَت","نيرانُها بِكَ فَاِنفَتَّت أَفاعيها",101,"ي",3,0],["حتى به حدث يزول وإن يكن","ماء تراه مقيداً بمعاني",102,"ن",2,0],["حتى بدا التنزيه عنها به","واحتاج هذا الأمر للإختصام",103,"م",1,0],["حتى بلغت القائم المهديا","أعني إمام عصرنا المرضيا",104,"ي",2,0],["حتى بدا لونه في الوجه مصطبغا","بشكله دون اشكال وألوان",105,"ن",1,0],["حتى برؤيته اكتحلت ونلت ما","كنت بتغيت فاثبت الخبر الخبر",106,"ر",1,0],["حتى بدا هذا القران عليه من","نور الاماني والتهاني زخرف",107,"ف",1,0],["حتى بلغتُ مَدى المشيبِ وأَصبحتُ","مِني القرونُ كأنّهنَّ ثَغامُ",108,"م",1,0],["حتى بدت آياتُ فضلك اسهماً","راحت تبدّدُ كالقطيع كماتهُ",109,"ت",2,0],["حَتّى بَدا لي أَن ذمك واجب","في مَذهب السادات وَالفضلاء",110,"ا",2,0],["حتى بكيت من السرور وطالما","أبكي السرور متيماً من وجده",111,"د",2,0],["حَتّى بَدَت دَولةُ الأَشرافِ 