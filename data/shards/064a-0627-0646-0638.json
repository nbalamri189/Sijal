{"poems":[[57,"يا نظرة كانت عليك بلية","https://www.aldiwan.net/poem26128.html","الكامل"],[85,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[29,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[74,"أهلا بها صحف الإمام المسند","https://www.aldiwan.net/poem18563.html","الكامل"],[53,"وضعت كقضبان اللجين","https://www.aldiwan.net/poem64035.html","مجزوء الكامل"],[45,"في الخد أن عزم الخليط رحيلا","https://www.aldiwan.net/poem10125.html","الكامل"],[33,"إعتادني بعد سلوة حزني","https://www.aldiwan.net/poem41290.html","المنسرح"],[83,"وداع قلب أزفا","https://www.aldiwan.net/poem61459.html","مجزوء الرجز"],[104,"حسبت أن الشبابا","https://www.aldiwan.net/poem33070.html","المجتث"],[42,"إن الخليط الذين كنت","https://www.aldiwan.net/poem42265.html","المنسرح"],[50,"يا نظرة ساقت إلى ناظر","https://www.aldiwan.net/poem64404.html","السريع"],[52,"يا شوق من بات مشغوفا ومجتنبا","https://www.aldiwan.net/poem64811.html","البسيط"],[78,"عيني كيف غررتما قلبي","https://www.aldiwan.net/poem39488.html","أحذ الكامل"],[534,"مولاي يا فرد العلى والملا","https://www.aldiwan.net/poem37525.html","السريع"],[558,"يا نظرة نلتها على حذر","https://www.aldiwan.net/poem68365.html","المنسرح"],[615,"","https://poetry.dctabudhabi.ae/diwan/poem/34547","الرجز"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177915","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64815","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64920","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56697","الكامل"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73489","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/114002","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125421","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125423","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125468","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53064","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120758","الرجز"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106865","الكامل"],[2408,"","https://poetry.dctabudhabi.ae/diwan/poem/128807","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201479","المجتث"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99447","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132693","السريع"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48449","السريع"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129352","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91383","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90845","الكامل"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143041","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73181","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83659","الكامل"],[4470,"","https://poetry.dctabudhabi.ae/diwan/poem/125356","الرجز"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67581","الخفيف"],[5055,"اطلال شمسة","https://www.poetsgate.com/ViewPoem.aspx?id=100726",""],[5055,"المضرحي","https://www.poetsgate.com/ViewPoem.aspx?id=100745",""],[5055,"قلب طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=102728",""],[5092,"نظرةٌ في عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=149793",""],[5106,"ذَاْكَ عُذْرٌ تَاْفِهٌ ..","https://www.poetsgate.com/ViewPoem.aspx?id=137255",""],[5595,"وسَكرتُ فيك","https://www.poetsgate.com/ViewPoem.aspx?id=150151",""],[5615,"آهات .....!","https://www.poetsgate.com/ViewPoem.aspx?id=193282",""],[5688,"خلّوا الدموع تَسرّب","https://www.poetsgate.com/ViewPoem.aspx?id=200824",""],[5790,"غزلان رامة أم جاذر بابل","https://www.poetsgate.com/ViewPoem.aspx?id=112113",""],[5861,"رفقا حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=188296",""],[6056,"أزرق الدمع بعيوني","https://www.poetsgate.com/ViewPoem.aspx?id=130134",""]],"verses":[["يا نَظرَةً كانَت عَلَيكَ بَليَّةً","إِنّي إِخالُكَ بَعدَها لا تَسلَمُ",0,"م",1,1],["يا نظرةً جاذبتها أيدي النوى","حتى استهلَّتْ أدمعي بدماءِ",1,"ا",2,0],["يا نَظرَةً لَكِ يَومَ هاجَت عَبرَةً","مِن أُمِّ حَزرَةَ بِالنُمَيرَةِ دارُ",2,"ر",1,0],["يا نظمها المخدوم بعدَ نظيمِها","كم خادم لك من صواب مرشد",3,"د",1,0],["يا نظرة لي والنوى","نحوي بعين الموت تنظرْ",4,"ر",1,0],["يا نَظرَةً نَفَتِ الرُقادَ وَغادَرَت","في حَدِّ قَلبي ما حَيِيتُ فُلولا",5,"ل",2,0],["يا نَظرَةً ما نَظَرتُ موجِعَةً","لَم أَرَها بَعدَها وَلَم تَرَني",6,"ن",2,0],["يانَظرَةً ما غُرِسَت","حَتّى جَنَيتُ الشَغَفا",7,"ف",2,0],["يا نظرةً لم أُرِدْها","ساقت إلي عذاباً",8,"ب",2,0],["يا نَظرَةً ما نَظَرتُ في فَلَقِ ال","صُبحِ إِلَيها إِذ قيلَ تَنطَلِقُ",9,"ق",1,0],["يا نَظرَةً ساقَت إِلى ناظِرٍ","أَسبابَ ما تَدعو إِلى حَتفِهِ",10,"ف",2,1],["يا نَظرَةً عَقَلَت سَلمى بِمُقلَتِهِ","فَما يَزالُ قَذىً في عَينِهِ نَشِبا",11,"ب",2,0],["يَا نَظْرَةً أَذْكَتْ على كبِدي","ناراً قَضَيْتُ بِحَرِّهَا نَحْبي",12,"ب",2,0],["يا نَظْمُ نُبْ عَنِّي وكُنْ زَائِراً","قالُوا عَمِيدُ الْمُلْكِ لم يَرْكَبِ",13,"ب",1,0],["يا نَظرَةً نِلتُها عَلى حَذَرِ","أَوَّلُها كانَ آخِرَ النَظَرِ",14,"ر",1,1],["يا نَظرَةً أَبقَت جَوىً قاتِلاً","مِن شادِنٍ يَومَ السَعانينِ",15,"ن",1,0],["يا نظرة قد أعقبتني حسرة","طرفي جنا فعلام قلبي يؤخذ",16,"ذ",1,0],["يا نَظْرةً كمْ أَباحتْ مِنْ حِمَى أَسَدٍ","كأَنَّها طَعْنَةٌ مِنْ كفِّ جَسّاسِ",17,"س",1,0],["يا نَظْرَةً ما جَلَتْ لي حُسْنَ طَلْعَتِهِ","حتَّى إنْقَضَتْ وأَدامَتنْي على وَجَلي",18,"ل",2,0],["يا نظرة ما كنت أقصد شرها","أكذاك انت فكيف بي لو أقصد",19,"د",1,0],["يا نَظرَةً بِشَرخٍ شَبابي","وَقَضى عَلَيَّ نَعيمُها بِعَذابِ",20,"ب",1,1],["يا نظرَةً ونَظَرَت عيني مخالَسَةً","جنَت على القَلبِ ما لم يجنهِ جانِ",21,"ن",1,1],["يا نظرةً أرسلت سهماً إلى كَبِدي","فبات من جُرحِهِ في ثورةِ الألمِ",22,"م",1,0],["يا نظرةً أرسلت نارَ الغرامِ إلى","قلبي فبات وجمرُ الحبِّ يكويهِ",23,"ي",2,0],["يا نظرةً تركت بقلبي جمرةً","منها تأجّجَ في الفؤادِ غرامُ",24,"م",1,0],["يا نظرة نَثَلَتْ كِنَانة بابل","قتلت ويالك خطرة من رامح",25,"ح",1,0],["يا نظرةً أرسَلَهَا مُختَلِساً","صارَ لها القلبُ المعنّى تَبعا",26,"ع",2,0],["يا نظرةً للقلب إذ عرضت","ماذا فعلت بقلب من نظرا",27,"ر",2,0],["يا نظامَ العلياء بعدك ما للعلمِ","والعدلِ والقضاءِ نظام",28,"م",1,0],["يا نظرةً أرجعتنْي","الى زمان الشباب",29,"ب",1,1],["يا نظير البدر في صورته","وشبيه الغصن في قامته",30,"ت",2,1],["يا نظرة اللطف التي قد شفت","بعض الجوى رحماك رحماك",31,"ك",1,0],["يا نَظَراتِ اللحْظِ ما أنصَفوا","لوْ أنهُمْ بالسّحْرِ حلَّوْكِ",32,"ك",1,0],["يا نظام العراق خذ من نظامي","غادة لفظها كدر نضيد",33,"د",1,0],["يا نَظرةً وَلّت وَقَد أَبقت قوى","حَسراتها وَالجسمُ مِنها يضعف",34,"ف",1,0],["يا نظرة تركت فؤادي شاخصا","لجلال وجه جمال بدر تمام",35,"م",1,0],["يا نظرةً جلبت حتفي مفاجأة","ما خلت أن حمامي حم في النظر",36,"ر",1,1],["يا نظرةً بعدَ عزِّي قد ذَللتُ بها","حتَّى غدوتُ أسيراً ليسَ لي فادي",37,"د",2,0],["يا نَظرَةً تَشفي السقامَ حَقيقَةً","نظرُ الحَبيبِ إلى المحبّ وجودهُ",38,"د",2,0],["يا نظرى صلِّ لما غمضت عنه النظرا","أغضبتَه فاستترا عاد إلى ما لا يُرى",39,"ا",1,0],["يا نظير للبرء بعد السقام","يا يساراً أتى على أعدام",40,"م",1,1],["يا نظرتي عيدي وشوفي على ميل","النفس مالت تهتوي لمس خمسه",41,"س",2,0],["يا نظرة المشتاق مشتاق للدار","مشتاق نور الفجر والشوق طالي",42,"ل",2,0],["يا نظرة الحرمان يا قلب طفلة","هذي سيوف العدل نُور المعالي",43,"ل",2,0],["يا نظرةً رقَصَتْ على","أوتارِ نبضِ صبابتي",44,"ت",2,0],["يا نظرةً من بعدها","هامُ الفؤادُ بنظرتي",44,"ت",2,0],["يَاْ نَظِيْفَ الرُّوْحِ لا تَحْيَاْ عَلَىْ إِقْلاْقِ رُوْحِيْ","دَعْ لِطَبْعِ الرُّوْحِ فِيْهَاْ طَيْبَهَاْ يَسْرِيْ بَرَاْرَاْ",45,"ر",2,0],["يَا نَظْرةً غَصّتْ بِبابِ حبيبة ٍ","فتطوّحتْ في مَشيها تَتعَثّرُ",46,"ر",1,0],["يَا نَظرَةً كالسُّيوفِ تَجرَحُني","هَلَّا بِغَيرِ القُلوبِ تُغمِدُهَا ؟",47,"د",3,0],["يا نظرة ألقيتها","وإذا بقلبي يسلب",48,"ب",1,0],["يا نظرة أهدت إليك من الحمى","ماذا على بعد المدى المتطاول",49,"ل",1,0],["يا نظرةَ القلب الشغوف لطلةٍ","فيها العيون ضحوكةً برؤاكا",50,"ك",2,0],["يانظرعيني علامك ما تحنيّن المعنىّ","متعب ٍ نفسي ورجلي كل يوم ٍ بالتعنيّ",51,"ن",2,1]]}