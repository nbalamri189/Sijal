{"poems":[[53,"قل للعدى موتوا بغي","https://www.aldiwan.net/poem30609.html","مجزوء الكامل"],[53,"هل ناشد لي بعقيق الحمى","https://www.aldiwan.net/poem30721.html","السريع"],[53,"أماني نفس ما تناخ ركابها","https://www.aldiwan.net/poem30760.html","الطويل"],[63,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[3,"أعادي صرف دهر لا يعادى","https://www.aldiwan.net/poem145.html",""],[55,"وصلت فلما لم أر الوصل نافعي","https://www.aldiwan.net/poem26185.html","الطويل"],[55,"تنامين لا تدرين ما ليل ذي هوى","https://www.aldiwan.net/poem26531.html","الطويل"],[57,"أجود بموجود ولو بت طاويا","https://www.aldiwan.net/poem24637.html","الطويل"],[57,"لما عفوت ولم أحقد على أحد","https://www.aldiwan.net/poem24721.html","البسيط"],[77,"وأظهر السلم وقد","https://www.aldiwan.net/poem35978.html","مجزوء الرجز"],[86,"أخشى مربيتي","https://www.aldiwan.net/poem10701.html","مجزوء الكامل"],[35,"عرج بأطراف الديار وسلم","https://www.aldiwan.net/poem38831.html","الطويل"],[30,"وأظهر في غلان رقد وسيله","https://www.aldiwan.net/poem29501.html","الطويل"],[88,"هذي بلودان وذا نزلها","https://www.aldiwan.net/poem44394.html","الخفيف"],[27,"نعوا عبد العزيز فقلت هذا","https://www.aldiwan.net/poem5749.html","الوافر"],[37,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[47,"نفى النوم عن عيني خيال مسلم","https://www.aldiwan.net/poem25134.html","الطويل"],[72,"جسمي أبو ذر الضنا فذروني","https://www.aldiwan.net/poem20182.html","الكامل"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"إذا جئت أشكو ما بقلبي من الأسى","https://www.aldiwan.net/poem8661.html","الطويل"],[51,"منع المخنث أحمد","https://www.aldiwan.net/poem64006.html","مجزوء الكامل"],[51,"عيد يطابق أول الأسبوع","https://www.aldiwan.net/poem65060.html","الكامل"],[51,"الشيب أحلم والشبيبة أظرف","https://www.aldiwan.net/poem65458.html","الكامل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[51,"أمسى دمشقي الأمير ودهره","https://www.aldiwan.net/poem66442.html","الكامل"],[51,"يا ليت شعري عنك يا حرماني","https://www.aldiwan.net/poem66520.html","الكامل"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[91,"دبت وقد أرخى الظلام ستارا","https://www.aldiwan.net/poem8861.html","عموديه"],[70,"كان البياض يروقني","https://www.aldiwan.net/poem42445.html","مجزوء الكامل"],[70,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[70,"وعد الزيارة طرفه المتملق","https://www.aldiwan.net/poem42802.html","الكامل"],[38,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[85,"أهلا وسهلا بحاميها وفاديها","https://www.aldiwan.net/poem7586.html","البسيط"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[56,"على هذه كانت تدور النوائب","https://www.aldiwan.net/poem58651.html","الطويل"],[43,"أغالب فيك الشوق والشوق أغلب","https://www.aldiwan.net/poem9508.html","الطويل"],[45,"وأظلمت حين لبست السواد","https://www.aldiwan.net/poem11050.html","المتقارب"],[45,"أإبراهيم دعوة مستعيد","https://www.aldiwan.net/poem63459.html","الوافر"],[45,"يمزج خمرا بجنى ريقه","https://www.aldiwan.net/poem65194.html","السريع"],[45,"جمعت أمور الدين بعد تزيل","https://www.aldiwan.net/poem65538.html","الكامل"],[45,"تبا للحمك أيها اللحام","https://www.aldiwan.net/poem66642.html","البسيط"],[61,"نحن للأيام غنم ونفل","https://www.aldiwan.net/poem51477.html","الرمل"],[61,"سر سرك الله فيما أنت منتظر","https://www.aldiwan.net/poem51675.html","البسيط"],[49,"مؤاخاة الفتى البطر البطين","https://www.aldiwan.net/poem63141.html","الوافر"],[66,"لو صرت من سقمي شبيه سواك","https://www.aldiwan.net/poem39929.html","الكامل"],[66,"تيقن مذ أعرضت أني له سالي","https://www.aldiwan.net/poem40100.html","الطويل"],[66,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[97,"طلق شجونك في ثرى الأحبابِ","https://www.aldiwan.net/poem24392.html","الكامل"],[97,"يا غلة المتلهف الصادي","https://www.aldiwan.net/poem24996.html","أحذ الكامل"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[44,"عنت له سكن فهام بذكرها","https://www.aldiwan.net/poem30241.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[31,"أأنكرت من بعد عرفانكا","https://www.aldiwan.net/poem42028.html","المتقارب"],[105,"أبا سفيان أي دم تريد","https://www.aldiwan.net/poem43580.html","الوافر"],[105,"تعلموا كيف تبني مجدها الأمم","https://www.aldiwan.net/poem44217.html","البسيط"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[50,"غدا سلف فأصعد بالرباب","https://www.aldiwan.net/poem64835.html","الوافر"],[46,"راعد تحته صلف","https://www.aldiwan.net/poem23007.html","مجزوء الخفيف"],[46,"أما الحقيقة فهي أني ذاهب","https://www.aldiwan.net/poem23058.html","الكامل"],[46,"إذا بلغ الإنسان خمسين حجة","https://www.aldiwan.net/poem23372.html","الطويل"],[68,"ما بين ضال المنحنى وظلاله","https://www.aldiwan.net/poem1518.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85532","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39564","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43720","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43746","المتقارب"],[77,"","https://poetry.dctabudhabi.ae/diwan/poem/71429","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[106,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[90,"ساعة مع البحتري في سامراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=179035",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[57,"أجود بموجودٍ ولو بت طاوياً","https://www.poetsgate.com/ViewPoem.aspx?id=3250",""],[57,"لما عفوت ولم أحقد على أحدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=3231",""],[51,"يا أخي يا أخا الدماثة والرقة","https://www.poetsgate.com/ViewPoem.aspx?id=25882",""]],"verses":[["وَأَظُنُّ نَفسي سَوفَ تَح","مِلُني عَلى الأَمرِ الأَشَدِّ",0,"د",1,0],["وَأَظمَأَ القَلبَ إِلى مالِكٍ","لايُحسِنُ العَدلَ عَلى القَلبِ",1,"ب",1,0],["وَأَظما إِلى دَرِّ الأَماني فَتَنثَني","بِأَخلافِها عَنّي وَمِنكَ مَصابُها",2,"ب",3,0],["وأظَلَّ أطرافَ البسيطةِ جَحفَلٌ","لَجِبٌ يُبَشِّرُ نَسرَهُ السِّرْحانُ",3,"ن",1,0],["وَأُظهِرُ نُصحَ قَومٍ ضَيَّعوني","وَإِن خانَت قُلوبُهُمُ الوِدادا",4,"د",2,0],["وَأَظلَمَتِ الدُنيا عَلَيَّ بِرَحبِها","وَقَلقَلَني الهِجرانُ كُلَّ مُقَلقَلِ",5,"ل",1,0],["وَأَظمَأُ مَمنوعَ الوُرودِ إِلَيكُمُ","كَما يَظمَأُ الصادي إِلى البارِدِ العَذبِ",6,"ب",1,0],["وَأُظهِرُ أَسبابَ الغِنى بَينَ رِفقَتي","لَيَخفاهُمُ حالي وَإِنّي لَمُعدَمُ",7,"م",1,0],["وَأُظهِرُ البِشرَ لِلإِنسانِ أَبغَضُهُ","كَما إِن قَد حَشى قَلبي مَوَدّاتِ",8,"ت",1,0],["وأظْهَرَ السِّلْمَ وقدْ","أسَرّ حَسْواً فِي ارْتِغا",9,"غ",2,1],["وَأَظَلُّ بَينَ صَواحِبي","لِعِقابِها أَتَوَقَّعُ",10,"ع",1,0],["وَأَظهَرتَ نورَ الحَقِّ فَاِشتَدَّ نورُهُ","عَلى كُلِّ لَبسٍ بارِقِ الحَقِّ مُظلِمِ",11,"م",1,0],["وَأَظهَرَ في غُلاّنِ رَقدٍ وَسيلَهُ","عَلاجيمُ لا ضُحلٌ وَلا مُتَضَحضِحُ",12,"ح",1,1],["وأظلّت جبينها وهو صبح","طرّةٌ غَيهبيّة فينانه",13,"ن",2,0],["وَأَظلَمَتِ البِلادُ عَلَيهِ حُزناً","وَقُلتُ أَفارَقَ القَمَرُ المُنيرُ",14,"ر",1,0],["وأظمَاؤنا الأَعشَارُ فيها لَدِيهُم","وَمَرتَعُنا فيهم أَلاءٌ وحَرمَلُ",15,"ل",1,0],["وَأُظهِرُ لِلأَعداءِ فيكَ جَلادَةً","وَأَكتُمُ ما أَلقاهُ وَاللَهُ يَعلَمُ",16,"م",1,0],["وأظلُّ من إعسار مصطبرِي ويا","عجباً لها في ربقة المسجون",17,"ن",1,0],["وأظُنُّ افتراسَك القِرْنَ فالقر","ن منايا وشيكةَ الإرداءِ",18,"ا",2,0],["وأَظَنُّوك أن ذاك وفاءٌ","من مَوالٍ يُصَحِّحون الولاءَ",19,"ا",2,0],["وأظهر لي بعد الوصالِ تجنِّياً","فأصبرُ خوفاً منهُ أن يتجنَّبا",20,"ب",2,0],["وأظنُّ بالمأبون ظنْ","ناً لا أظن بغيره",21,"ر",2,0],["وأظَلَّه جودُ الأمير وقد ذكتْ","نارُ المصيف فظلّ كالمربوعِ",22,"ع",1,0],["وأظل أزماناً خلت ومعاهداً","ورقٌ تظلُّ غصونه تتعطّف",23,"ف",1,0],["وأظلمتِ الدنيا وباخ ضياؤها","نهاراً وشمسُ الصَّحوِ حَيْرى على القِمَمْ",24,"م",1,0],["وأظن أنك لا محالَة مُسعِفي","ظناً سيتْبَعُ شكُّه استيقانَهُ",25,"ن",2,0],["وأظنُّ ظنَّاً كاليقين وثاقةً","أني وأنك ثَمَّ مُصطحبان",26,"ن",1,0],["وَأَظُنُّهُمُ قَد أَدرَكوا","لا أَدرَكوا ما في ضَميري",27,"ر",2,0],["وَأَظُنُّها فَقَدَت حَبيباً أَو أَخاً","وَلِذَلِكَ اِرتَدَتِ السَوادَ شِعارا",28,"ر",2,0],["وَأَظَلُّ أَقرَعُ دائِماً","سِنّي إِذا حَقَّقتُ سِنّي",29,"ن",2,0],["وَأَظُنُّهُ طَلَبَ الجَديدَ وَطالَما","عَتَقَ القَميصُ عَلى اِمرِئٍ فَتَبَدَّلا",30,"ل",2,0],["وَأَظُنُّ خَدَّكَ شامِتاً بِفِراقِنا","فَلَقَد نَظَرتُ إِلَيهِ وَهوَ مُخَلَّقُ",31,"ق",1,0],["وَأَظعانٍ طَلَبتُ بِذاتِ لَوثٍ","يَزيدُ رَسيمُها سَرَعاً وَلينا",32,"ن",2,0],["واظلم صحيح البخارى كل أونة","ونم عن الحرب واقرأ في لياليها",33,"ي",3,0],["وَأَظفَر الصابر بِالنُجح فَيا","هَزيمة اليَأس وَيا فَوز الرَجا",34,"ا",1,0],["وأَظْلَمَتِ الدُّنْيا التي كُنْتَ جَارَهَا","كَأنّكَ للِدُّنْيا أَخٌ ومُنَاسِبُ",35,"ب",1,0],["وَأَظلَمُ أَهلِ الظُلمِ مَن باتَ حاسِداً","لِمَن باتَ في نَعمائِهِ يَتَقَلَّبُ",36,"ب",1,0],["وَأَظلَمتَ حينَ لَبِستَ السَوا","دَ ظَلامَ الدُجى لَم يَسِر راكِبُه",37,"ب",2,1],["وَأَظلَمَ بَينَنا ما كانَ أَضوا","عَلى اللَحَظاتِ مِن فَلَقِ العَمودِ",38,"د",1,0],["وَأُظفِرَ العاشِقُ مِن بَعدِ ما","عَذَّبَهُ البَينُ بِمَعشوقِهِ",39,"ق",2,0],["وَأَظُنُّ أَنَّكَ لا تَرُدُّ وُجوهَها","حَتّى تُنيخَ عَلى الخَليجِ بِكَلكَلِ",40,"ل",1,0],["وَأَظُنُّها حِلّاً لَهُ مِن فاقَةِ ال","إِملاقِ إِذ هِيَ لِليَتيمِ حَرامُ",41,"م",1,0],["وأظَلَّتْ صاحبَ الحَضْرِ فما","بَرِحَتْ حتى غدا تحتَ الأَظَل",42,"ل",1,0],["وأظفرتكَ بما أمَّلْتَ أربعةٌ","النَّصرُ والفَتحُ والإقبالُ والظَّفَرُ",43,"ر",1,0],["وَأَظمَأتُ النَهارَ لِرَوحِ قَلبي","وَبِتُّ اللَيلَ مُفتَرِشاً جَبيني",44,"ي",1,0],["وَأَظَلُّ مُبتَسِماً لِفَرطِ تَعَجُّبي","فَالسِنُّ ضاحِكَةٌ وَقَلبي باكِ",45,"ك",1,0],["وَأَظهَرَ لِلأَعداءِ إِذ صَدَّ جافِياً","بِأَنَّ جَفاهُ عَن دَلالٍ وَإِذلالِ",46,"ل",1,0],["وَأَظَلُّ في جَوبِ البِلادِ كَأَنَّني","سَيفُ اِبنِ أُرتُقَ لا يَقَرُّ بِغِمدِهِ",47,"د",2,0],["واظفر بنورِ الخلدِ قد بُلغته","أنتَ الجديرُ بمجدِه الخلابِ",48,"ب",1,0],["وأظل أسقيها وتملؤ لي","من مورد خلف الظنون خفي",49,"ي",1,0],["وأظنّهُ مترنّحاً من نَشْوَةٍ","كاساتُها بهوَى العيون تُدارُ",50,"ر",1,0],["وَأَظُنُّ حَبلَ وِصالِها لِمُحِبِّها","أَوهى وَأَضعَفُ قُوَّةً من خَصرِها",51,"ر",3,0],["وَأَظهَرَ الصَّحبُ وَالأَنصارُ بَأسَهم","وَالبَأسُ في الفِعلِ غَيرُ البَأسِ فِي الكَلِمِ",52,"م",1,0],["وَأَظهَرتَ هِجرانَها ظالِماً","وَلَم تَكُ أَهلاً لِهِجرانِكا",53,"ك",2,0],["وأظهر َما يُوارِي من سِلاحٍ","يَدُبُّ بمثلِهِ الشَّنِفُ الحَقودُ",54,"د",1,0],["وأظلمُ النّاسِ من ظنَّ الظنونَ به","ما كلُّ ذي نشوةٍ في الناس مُتّهمُ",55,"م",1,0],["وَأَظهَرَ الخِلافَ وَالعِصيانا","وَنُصرَةَ الباطِلِ وَالبُهتانا",56,"ن",2,0],["وأَظُنُّهُمْ قد خالفوه فعجَّلتْ","لهُمُ العُقوبة بالخنا تعْجِيلا",57,"ل",2,0],["وَأَظُنُّه لو لَمْ يُرِدْ إِقْلاعَهُ","لأَتَى بِسَيْلٍ ما يُصِيبُ مَسِيلا",58,"ل",2,0],["وَأَظُنُّ أنَّهُم لِعُظْمِ بَلِيَّتي","حَمَلَتْ بِهِمْ لاشَكَّ ليسَ بالقَوَّامِ",59,"م",1,0],["وَأَظهَرَ صَفحَةً سُتِرَت وَأُخرى","مِنَ العَبَراتِ تَشهَدُ بِالتَبابِ",60,"ب",1,0],["وَاِظلِفِ النَفسَ وَالطَري","دُ سَريعٌ إِلى الظَلَف",61,"ف",1,0],["وَأَظُنُّني مِن بَعدُ لَستُ بِذاكِرٍ","ما كانَ مِن يُسرٍ وَمِن اِملاقِ",62,"ق",1,0],["وَإِظلامُ عَينٍ بَعدَهُ ظُلمَةُ الثَرى","فَقُل في ظَلامٍ زيدَ فَوقَ ظَلامِ",63,"م",1,0],["وأظُنّهُ لم يدْرِ ذُلّ صَبابتي","إذ ظَلّ مُلْتَهِياً بعِزّ جَماله",64,"ل",2,0],["وأظلُّ أصقله إلى","أن تَستَقيم الأشطر",65,"ر",1,0],["وأظلّنا الصمتُ الرهيبُ ونحن في","شكٍ من الدنيا وحلمٍ ساحرِ",66,"ر",1,0],["وَأَظَللَّهُ بَلَدٌ جَدِيدٌ كُلَّما","ضَنَّ القَدِيمُ عَلَيْهِ بِالإظْلاَلِ",67,"ل",1,0],["وَاظْنُنْ بِمَا هُوَ فَوْقَ ذَاكَ نِكَايةٌ","مِنْ جَفْوَةِ الأَدْنَى وَغَدْرِ الصَّاحِبِ",68,"ب",1,0],["وَأَظلَمَ الأُفقُ وَلكِن بِهِ","أَنارَت المَقبَرَةُ الوسطا",69,"ط",2,0],["وَأظلَمتُ حَتّى كَأَنَّ الدُجى","خَبا مِنكَ ضَوءُ قَناديلِهِ",70,"ه",1,0],["وَأَظْهَرْتَ يَا مَوْلَى الأَئِمَّةِ نَصْرَهُ","فَمُلْكُكَ بِالنَّصْرِ اسْتَقَلَّتْ رَكَائِبُهْ",71,"ب",2,0],["وأظلَّتْ بِنْتَ الفَدافِدِ والبِيدِ","بأَفْياءِ دَوْحِها الفَيْنانِ",72,"ن",1,0],["وأَظَلَّ النيلَ عيدٌ شاملٌ","فيه حَيَّا كلُّ مصريّ أخاهْ",73,"ا",2,0],["وأظُنُ أنَّكَ لو نمتْكَ ربوعُهُ","لشكوتَ منه فؤادَكَ المصدوعا",74,"ع",2,0],["وأظُنّني قد كنتُ أرْوَحَ خاطراً","بالخطبِ لو لم أُعنَ في تأويله",75,"ل",2,0],["وأظهر أسباب الغنى بين رفقتي","لمخافهم حالي وإني لمعدم",76,"م",1,0],["وأظهر البشر للإنسان أبغضه","كما أن قد حشى قلبي محبات",77,"ت",1,0],["وأظُنُّ افتراسك القرن فالقر","قرن منايا وشيكة الأرداء",78,"ا",2,0]]}