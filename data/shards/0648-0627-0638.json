iwan.net/poem14492.html","الوافر"],[450,"يا عقلة حنت إليك حشا","https://www.aldiwan.net/poem13834.html","مجزوء الكامل"],[451,"ست من السنوات جاوز عمرها","https://www.aldiwan.net/poem61591.html","الكامل"],[451,"سألوني لم ارتحلت كأني","https://www.aldiwan.net/poem61618.html","الخفيف"],[451,"أين ابتسامك يا حبيبي","https://www.aldiwan.net/poem61716.html","مجزوء الكامل"],[456,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[456,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[456,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[456,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[456,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[456,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[459,"صحا القلب من ود الغواني وودها","https://www.aldiwan.net/poem15177.html","الطويل"],[462,"أما وبنات الفكر حلفة فاضل","https://www.aldiwan.net/poem3336.html","عموديه"],[462,"قلب لذكر الحمى بعد النوى يجب","https://www.aldiwan.net/poem3566.html","عموديه"],[475,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[477,"سمعا لصوتك سمعا أيها الشادي","https://www.aldiwan.net/poem36952.html","البسيط"],[477,"الذكر أبقى لكم والمال عارية","https://www.aldiwan.net/poem37207.html","البسيط"],[477,"أبى الله إلا أن تعظم مطلقا","https://www.aldiwan.net/poem37599.html","الطويل"],[480,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[480,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[493,"ولقد دخلت ديار فارس تاجرا","https://www.aldiwan.net/poem10226.html","الكامل"],[496,"يا راكضاً في طلاب دنيا","https://www.aldiwan.net/poem3693.html","مخلع البسيط"],[498,"بين بطاح حيهم والأبطح","https://www.aldiwan.net/poem38037.html","الرجز"],[498,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[504,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[512,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[513,"لو كان ينفع أن تجود بمائها","https://www.aldiwan.net/poem11998.html","الكامل"],[513,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[513,"الطويل","https://www.aldiwan.net/poem12121.html","الطويل"],[513,"لله من يوم أغر مجمل","https://www.aldiwan.net/poem12208.html","الكامل"],[513,"من استعان بغير الله لم يعن","https://www.aldiwan.net/poem12278.html","البسيط"],[536,"وليلة أنس جاد عنا وماننا","https://www.aldiwan.net/poem47976.html","عموديه"],[549,"خيالك يا أميمة كيف زارا","https://www.aldiwan.net/poem47801.html","الوافر"],[549,"ذكرتك في الخلوات التي","https://www.aldiwan.net/poem47803.html","المتقارب"],[549,"وثقت بكم حتى خجلت وكم جنت","https://www.aldiwan.net/poem47888.html","الطويل"],[556,"ألا يا فتى كيلان حف بجحفل","https://www.aldiwan.net/poem34477.html","الطويل"],[556,"نعم لقلوب العاشقين سرائر","https://www.aldiwan.net/poem34527.html","الطويل"],[556,"لذاتي بذاتي لا لكم أنا ظاهر","https://www.aldiwan.net/poem34556.html","الطويل"],[556,"كلى تفنيه وتوجده","https://www.aldiwan.net/poem34567.html","المتدارك"],[556,"لا بد للضيق في الدنيا من الفرج","https://www.aldiwan.net/poem34691.html","البسيط"],[556,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[557,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[573,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[573,"ما لي أنهنه عنك آمالي","https://www.aldiwan.net/poem2782.html","أحذ الكامل"],[573,"غدا الحسن شورى في الملاح وإنما","https://www.aldiwan.net/poem2922.html","الطويل"],[573,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[573,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[573,"يا ثالث العمرين علماً","https://www.aldiwan.net/poem3011.html","مجزوء الكامل"],[573,"أمجلس لهوي ليس لي منك مجلس","https://www.aldiwan.net/poem3058.html","الطويل"],[573,"تنسك شيطاني فيا ليته غدا","https://www.aldiwan.net/poem3081.html","الطويل"],[585,"يا تاركاً لمراضي الله أوطاناً","https://www.aldiwan.net/poem11514.html","عموديه"]],"verses":[["وَأَظُنُّ نَفسي سَوفَ تَح","مِلُني عَلى الأَمرِ الأَشَدِّ",0,"د",1,0],["وَأَظمَأَ القَلبَ إِلى مالِكٍ","لايُحسِنُ العَدلَ عَلى القَلبِ",1,"ب",1,0],["وَأَظما إِلى دَرِّ الأَماني فَتَنثَني","بِأَخلافِها عَنّي وَمِنكَ مَصابُها",2,"ب",3,0],["وأظَلَّ أطرافَ البسيطةِ جَحفَلٌ","لَجِبٌ يُبَشِّرُ نَسرَهُ السِّرْحانُ",3,"ن",1,0],["وَأُظهِرُ نُصحَ قَومٍ ضَيَّعوني","وَإِن خانَت قُلوبُهُمُ الوِدادا",4,"د",2,0],["وَأَظلَمَتِ الدُنيا عَلَيَّ بِرَحبِها","وَقَلقَلَني الهِجرانُ كُلَّ مُقَلقَلِ",5,"ل",1,0],["وَأَظمَأُ مَمنوعَ الوُرودِ إِلَيكُمُ","كَما يَظمَأُ الصادي إِلى البارِدِ العَذبِ",6,"ب",1,0],["وَأُظهِرُ أَسبابَ الغِنى بَينَ رِفقَتي","لَيَخفاهُمُ حالي وَإِنّي لَمُعدَمُ",7,"م",1,0],["وَأُظهِرُ البِشرَ لِلإِنسانِ أَبغَضُهُ","كَما إِن قَد حَشى قَلبي مَوَدّاتِ",8,"ت",1,0],["وأظْهَرَ السِّلْمَ وقدْ","أسَرّ حَسْواً فِي ارْتِغا",9,"غ",2,1],["وَأَظَلُّ بَينَ صَواحِبي","لِعِقابِها أَتَوَقَّعُ",10,"ع",1,0],["وَأَظهَرتَ نورَ الحَقِّ فَاِشتَدَّ نورُهُ","عَلى كُلِّ لَبسٍ بارِقِ الحَقِّ مُظلِمِ",11,"م",1,0],["وَأَظهَرَ في غُلاّنِ رَقدٍ وَسيلَهُ","عَلاجيمُ لا ضُحلٌ وَلا مُتَضَحضِحُ",12,"ح",1,1],["وأظلّت جبينها وهو صبح","طرّةٌ غَيهبيّة فينانه",13,"ن",2,0],["وَأَظلَمَتِ البِلادُ عَلَيهِ حُزناً","وَقُلتُ أَفارَقَ القَمَرُ المُنيرُ",14,"ر",1,0],["وأظمَاؤنا الأَعشَارُ فيها لَدِيهُم","وَمَرتَعُنا فيهم أَلاءٌ وحَرمَلُ",15,"ل",1,0],["وَأُظهِرُ لِلأَعداءِ فيكَ جَلادَةً","وَأَكتُمُ ما أَلقاهُ وَاللَهُ يَعلَمُ",16,"م",1,0],["وأظلُّ من إعسار مصطبرِي ويا","عجباً لها في ربقة المسجون",17,"ن",1,0],["وأظُنُّ افتراسَك القِرْنَ فالقر","ن منايا وشيكةَ الإرداءِ",18,"ا",2,0],["وأَظَنُّوك أن ذاك وفاءٌ","من مَوالٍ يُصَحِّحون الولاءَ",19,"ا",2,0],["وأظهر لي بعد الوصالِ تجنِّياً","فأصبرُ خوفاً منهُ أن يتجنَّبا",20,"ب",2,0],["وأظنُّ بالمأبون ظنْ","ناً لا أظن بغيره",21,"ر",2,0],["وأظَلَّه جودُ الأمير وقد ذكتْ","نارُ المصيف فظلّ كالمربوعِ",22,"ع",1,0],["وأظل أزماناً خلت ومعاهداً","ورقٌ تظلُّ غصونه تتعطّف",23,"ف",1,0],["وأظلمتِ الدنيا وباخ ضياؤها","نهاراً وشمسُ الصَّحوِ حَيْرى على القِمَمْ",24,"م",1,0],["وأظن أنك لا محالَة مُسعِفي","ظناً سيتْبَعُ شكُّه استيقانَهُ",25,"ن",2,0],["وأظنُّ ظنَّاً كاليقين وثاقةً","أني وأنك ثَمَّ مُصطحبان",26,"ن",1,0],["وَأَظُنُّهُمُ قَد أَدرَكوا","لا أَدرَكوا ما في ضَميري",27,"ر",2,0],["وَأَظُنُّها فَقَدَت حَبيباً أَو أَخاً","وَلِذَلِكَ اِرتَدَتِ السَوادَ شِعارا",28,"ر",2,0],["وَأَظَلُّ أَقرَعُ دائِماً","سِنّي إِذا حَقَّقتُ سِنّي",29,"ن",2,0],["وَأَظُنُّهُ طَلَبَ الجَديدَ وَطالَما","عَتَقَ القَميصُ عَلى اِمرِئٍ فَتَبَدَّلا",30,"ل",2,0],["وَأَظُنُّ خَدَّكَ شامِتاً بِفِراقِنا","فَلَقَد نَظَرتُ إِلَيهِ وَهوَ مُخَلَّقُ",31,"ق",1,0],["وَأَظعانٍ طَلَبتُ بِذاتِ لَوثٍ","يَزيدُ رَسيمُها سَرَعاً وَلينا",32,"ن",2,0],["واظلم صحيح البخارى كل أونة","ونم عن الحرب واقرأ في لياليها",33,"ي",3,0],["وَأَظفَر الصابر بِالنُجح فَيا","هَزيمة اليَأس وَيا فَوز الرَجا",34,"ا",1,0],["وأَظْلَمَتِ الدُّنْيا التي كُنْتَ جَارَهَا","كَأنّكَ للِدُّنْيا أَخٌ ومُنَاسِبُ",35,"ب",1,0],["وَأَظلَمُ أَهلِ الظُلمِ مَن باتَ حاسِداً","لِمَن باتَ في نَعمائِهِ يَتَقَلَّبُ",36,"ب",1,0],["وَأَظلَمتَ حينَ لَبِستَ السَوا","دَ ظَلامَ الدُجى لَم يَسِر راكِبُه",37,"ب",2,1],["وَأَظلَمَ بَينَنا ما كانَ أَضوا","عَلى اللَحَظاتِ مِن فَلَقِ العَمودِ",38,"د",1,0],["وَأُظفِرَ العاشِقُ مِن بَعدِ ما","عَذَّبَهُ البَينُ بِمَعشوقِهِ",39,"ق",2,0],["وَأَظُنُّ أَنَّكَ لا تَرُدُّ وُجوهَها","حَتّى تُنيخَ عَلى الخَليجِ بِكَلكَلِ",40,"ل",1,0],["وَأَظُنُّها حِلّاً لَهُ مِن فاقَةِ ال","إِملاقِ إِذ هِيَ لِليَتيمِ حَرامُ",41,"م",1,0],["وأظَلَّتْ صاحبَ الحَضْرِ فما","بَرِحَتْ حتى غدا تحتَ الأَظَل",42,"ل",1,0],["وأظفرتكَ بما أمَّلْتَ أربعةٌ","النَّصرُ والفَتحُ والإقبالُ والظَّفَرُ",43,"ر",1,0],["وَأَظمَأتُ النَهارَ لِرَوحِ قَلبي","وَبِتُّ اللَيلَ مُفتَرِشاً جَبيني",44,"ي",1,0],["وَأَظَلُّ مُبتَسِماً لِفَرطِ تَعَجُّبي","فَالسِنُّ ضاحِكَةٌ وَقَلبي باكِ",45,"ك",1,0],["وَأَظهَرَ لِلأَعداءِ إِذ صَدَّ جافِياً","بِأَنَّ جَفاهُ عَن دَلالٍ وَإِذلالِ",46,"ل",1,0],["وَأَظَلُّ في جَوبِ البِلادِ كَأَنَّني","سَيفُ اِبنِ أُرتُقَ لا يَقَرُّ بِغِمدِهِ",47,"د",2,0],["واظفر بنورِ الخلدِ قد بُلغته","أنتَ الجديرُ بمجدِه الخلابِ",48,"ب",1,0],["وأظل أسقيها وتملؤ لي","من مورد خلف الظنون خفي",49,"ي",1,0],["وأظنّهُ مترنّحاً من نَشْوَةٍ","كاساتُها بهوَى العيون تُدارُ",50,"ر",1,0],["وَأَظُنُّ حَبلَ وِصالِها لِمُحِبِّها","أَوهى وَأَضعَفُ قُوَّةً من خَصرِها",51,"ر",3,0],["وَأَظهَرَ الصَّحبُ وَالأَنصارُ بَأسَهم","وَالبَأسُ في الفِعلِ غَيرُ البَأسِ فِي الكَلِمِ",52,"م",1,0],["وَأَظهَرتَ هِجرانَها ظالِماً","وَلَم تَكُ أَهلاً لِهِجرانِكا",53,"ك",2,0],["وأظهر َما يُوارِي من سِلاحٍ","يَدُبُّ بمثلِهِ الشَّنِفُ الحَقودُ",54,"د",1,0],["وأظلمُ النّاسِ من ظنَّ الظنونَ به","ما كلُّ ذي نشوةٍ في الناس مُتّهمُ",55,"م",1,0],["وَأَظهَرَ الخِلافَ وَالعِصيانا","وَنُصرَةَ الباطِلِ وَالبُهتانا",56,"ن",2,0],["وأَظُنُّهُمْ قد خالفوه فعجَّلتْ","لهُمُ العُقوبة بالخنا تعْجِيلا",57,"ل",2,0],["وَأَظُنُّه لو لَمْ يُرِدْ إِقْلاعَهُ","لأَتَى بِسَيْلٍ ما يُصِيبُ مَسِيلا",58,"ل",2,0],["وَأَظُنُّ أنَّهُم لِعُظْمِ بَلِيَّتي","حَمَلَتْ بِهِمْ لاشَكَّ ليسَ بالقَوَّامِ",59,"م",1,0],["وَأَظهَرَ صَفحَةً سُتِرَت وَأُخرى","مِنَ العَبَراتِ تَشهَدُ بِالتَبابِ",60,"ب",1,0],["وَاِظلِفِ النَفسَ وَالطَري","دُ سَريعٌ إِلى الظَلَف",61,"ف",1,0],["وَأَظُنُّني مِن بَعدُ لَستُ بِذاكِرٍ","ما كانَ مِن يُسرٍ وَمِن اِملاقِ",62,"ق",1,0],["وَإِظلامُ عَينٍ بَعدَهُ ظُلمَةُ الثَرى","فَقُل في ظَلامٍ زيدَ فَوقَ ظَلامِ",63,"م",1,0],["وأظُنّهُ لم يدْرِ ذُلّ صَبابتي","إذ ظَلّ مُلْتَهِياً بعِزّ جَماله",64,"ل",2,0],["وأظلُّ أصقله إلى","أن تَستَقيم الأشطر",65,"ر",1,0],["وأظلّنا الصمتُ الرهيبُ ونحن في","شكٍ من الدنيا وحلمٍ ساحرِ",66,"ر",1,0],["وَأَظَللَّهُ بَلَدٌ جَدِيدٌ كُلَّما","ضَنَّ القَدِيمُ عَلَيْهِ بِالإظْلاَلِ",67,"ل",1,0],["وَاظْنُنْ بِمَا هُوَ فَوْقَ ذَاكَ نِكَايةٌ","مِنْ جَفْوَةِ الأَدْنَى وَغَدْرِ الصَّاحِبِ",68,"ب",1,0],["وَأَظلَمَ الأُفقُ وَلكِن بِهِ","أَنارَت المَقبَرَةُ الوسطا",69,"ط",2,0],["وَأظلَمتُ حَتّى كَأَنَّ الدُجى","خَبا مِنكَ ضَوءُ قَناديلِهِ",70,"ه",1,0],["وَأَظْهَرْتَ يَا مَوْلَى الأَئِمَّةِ نَصْرَهُ","فَمُلْكُكَ بِالنَّصْرِ اسْتَقَلَّتْ رَكَائِبُهْ",71,"ب",2,0],["وأظلَّتْ بِنْتَ الفَدافِدِ والبِيدِ","بأَفْياءِ دَوْحِها الفَيْنانِ",72,"ن",1,0],["وأَظَلَّ النيلَ عيدٌ شاملٌ","فيه حَيَّا كلُّ مصريّ أخاهْ",73,"ا",2,0],["وأظُنُ أنَّكَ لو نمتْكَ ربوعُهُ","لشكوتَ منه فؤادَكَ المصدوعا",74,"ع",2,0],["وأظُنّني قد كنتُ أرْوَحَ خاطراً","بالخطبِ لو لم أُعنَ في تأويله",75,"ل",2,0],["وأظهر أسباب الغنى بين رفقتي","لمخافهم حالي وإني لمعدم",76,"م",1,0],["وأظهر البشر للإنسان أبغضه","كما أن قد حشى قلبي محبات",77,"ت",1,0],["وأظُنُّ افتراسك القرن فالقر","قرن منايا وشيكة الأرداء",78,"ا",2,0],["وَأَظنُّ دَهري لَم يَخني عامِداً","لَكنهُ مِن جَهلِهِ لا يُفرقُ",79,"ق",1,0],["وَأَظن أَن الدَهر لَيسَ بِموحشي","وَبِأَنَّهُ بِبَنيهِ غَير رَفيق",80,"ق",1,0],["وأظهر أنه بالوصل سمح","وأخفى الموت في طي اللثام",81,"م",1,0],["وأظلمت المدائنُ والنواحي","بموتِ العالمِ البرِّ الوفِىّ",82,"ا",1,0],["وإظهَارِ الودَادِ لَهُ عَلَى مَا","أجَىَّ مِنَ الخَبَائِثِ في الضَّمِيرِ",83,"ر",1,0],["وأظهرَ سِرَّهُ فِيها فَدَبَّت","حُمَيَّا سِرِّهِ فيها دَبِيبَأ",84,"ب",2,0],["واظفرْ بها لو أدركت ثعلبا","أنسته ما يُروَى عن الأصمعى",85,"ع",2,0],["وَأَظهَرتَ لِلأَيّامِ ليناً وَقَسوَةً","تُسالِمُها طَوراً وَطَوراً تُحارِبُ",86,"ب",1,0],["وَأَظهَرَت غامِضَ المَعنى بَديهَتَهُ","فَفاتَ مَن أَتعَبَ الأَفكارَ مُقتَضِبا",87,"ب",2,0],["وَأَظهَرتَ فَضلي وَهوَ خافٍ عَنِ الوَرى","بِفَضلٍ كَفى المُدّاحَ أَن تَتَكَلَّفا",88,"ف",2,0],["وَأَظُنُّها تاجاً وَلَكِن لَم تَجِد","لِعُلُوِّ قَدرِكَ فَوقَ خَصرِكَ مَنزِلا",89,"ل",2,0],["وَأَظُنُّها مِن بَعدِ سَبعٍ نُهزَةً","ما اِغتَرَّ مَن أَوسَعتَهُ إِمهالا",90,"ل",2,0],["وَأَظُنُّهُ مُستَنبِطاً","مَن قَولِ دِمنَةَ أَو كَليلَه",91,"ل",2,0],["وأظهرن حزبه في كل متّجه","وسددن منه أوقالا وأفعالا",92,"ل",2,0],["وَأَظُنُّها مِنْ صِحَّةٍ","مَرِضَتْ وَلَيْسَ بِها سَقَامُ",93,"م",1,0],["وأظنها أدنى واحقر عنده","من أن يعاقبها على أحماقها",94,"ق",3,0],["وَأَظهَرَ العُجبَ شَطّاها وَدِجلَتُها","وَما أَحاطَت بِهِ الأَسواقُ وَالرُحُبُ",95,"ب",1,0],["وَأُظهِرُ للأَقوامِ أَنّي بِقُربِهِ","مَليكٌ يُرَجّى رِفدُهُ وَفَواضِلُه",96,"ل",2,0],["وَأَظْهَرْتَ لِي حُبَّاً يَطِيفُ بِهِ قِلىً","كَخَائِبِ بَرْقٍ فِي عِراضِ سَحائِبِ",97,"ب",1,0],["وَأَظهَرَت لِمروءاتِ الكِرام يَداً","يَبقى ثَناها عَلى تِكرارِ أَحقابِ",98,"ب",1,0],["واظبْ تَنَلْ كلَّ صعبٍ مُعْوِزٍ عَسِرِ","فالماءُ أَثَّر بالإدمانِ في الحَجَرِ",99,"ر",1,1],["وأظنُّ مولاي اقْتَدَى بمقالِ مَنْ","نَظم القريضَ وأَغْرَب التأويلا",100,"ل",2,0],["وأظنُّ ذلك مُوجِبا","طَرَبَ القضيبِ إذا تَثَنَّى",101,"ن",2,0],["وأظهر فيها العدل حتى مشى الظِّبا","على اللَّيث معْ طولِ الطّوى وهْو جائع",102,"ع",1,0],["وأظهرنا البتيكات","وما في ذاك من بد",103,"د",1,0],["وَأَظهرَ دينَ اللَّه في فتحِ مكّةٍ","وَقوّمَ مِن يومِ الحُديبيةِ الظهرا",104,"ر",2,0],["وَأَظلم كلّ الناسِ ظالم نفسهِ","بإهلاكها حتّى بها قد وَقى الغيرا",104,"ر",2,0],["وأظنني بينَ الملو","كِ مليكَ كلِّ الأنفسِ",105,"س",1,0],["واظهراه على خافي نحولكما","فان تألم اشفاقا لجالكما",106,"م",2,0],["وأظلم الدهر إن لم","يجد لها بالخلود",107,"د",1,0],["وأظمأ وحدى فيك والنيل ثائر","يروز الجسور الشم بالمزق والقد",108,"د",1,0],["وأظلمت الآفاقُ منها توحُّشاً","كأنك كنتَ الصبح والشمس والبدرا",109,"ر",2,0],["وأظل بالأشواق أطوي نحوه","ما ليس تقطعه الركاب القود",110,"د",1,0],["وَأَظَلَّ يَومَ الفَتحِ مَكَّةَ مِنهُ ما","بَهَرَت كَتائِبهُ أَبا سُفيانِ",111,"ن",1,0],["وَأَظُنُّها أَكَلَت لِشِقوَتِها","مِن تِبنِهِ شَيئاً فَأَخرَجَها",112,"ج",3,0],["وأظنهم رفضوا المعاني عنهم","عجزوا وليس العجز كالتمكين",113,"ن",1,0],["واظهرت للباغي مدار رحى الوغى","وكيف مجال القرن في طلب القرن",114,"ن",1,0],["وأظل صادي القلب خيفة صده","ولو انه بنعيم وصل أنغما",115,"م",2,0],["وأظنهم قلت جموعهم","جميعا بافتراق",116,"ق",1,0],["واظلم من تراقبه المجازي","محبيه على القرب البعادا",117,"د",2,0],["وأظلمُ عابدي الأصنامَ حتى","يَقولوا اليومَ صِرنا مؤمنينا",118,"ن",2,0],["وأظهِر للعِدى جَلداً وصَمتاً","ويومَ البَطشِ أسمِعهم زئيرا",119,"ر",2,0],["وَا ظَمَئي إِلى اِرتِشافِ ظَلمِهِ","فَذاكَ يَروي ظَمَئي وَيَضمي",120,"ي",1,0],["وأظهرِ الإِيناسا","ولا تكن عبّاسا",121,"س",2,0],["وأظهر اللَه دين الحق وانتظمت","في دينه سائر الأديان فادكر",122,"ر",1,0],["وَأَظهرَ اللّه آياتِ الكمالِ على","خَلقٍ وخُلقٍ بِه تعنى وتتّسمُ",123,"م",1,0],["وَأظنُّكم لا تفقدوني بعده","ما مِن شمائله لبرٍّ يرجعُ",124,"ع",1,0],["وَأظهِر مزايا الشيخ فينا فإنّنا","وَإن لم نَكن أهلاً لنا نوع نسبةِ",125,"ه",1,0],["وأَظلم ليلُ الخطبِ حتّى تَهافَتوا","فراشاً وقد شاموا لصولته لهبا",126,"ب",2,0],["وَإِظهارِ النَدامَةِ كُلَّ وَقتٍ","عَلى ما كُنتَ فيهِ مِنَ اِعوِجاجِ",127,"ج",1,0],["وَأَظهَرَ الحَربُ لِلفِجارِ قَدرَهُم","حَتّى اِنثَنوا بِأَريحِ الفَخرِ دَهرَهُم",128,"م",1,0],["وأظلمت دنياك مما جرى","وأوشك المدبر أن يقبلا",129,"ل",2,0],["وأظهر سعدي باللقاء وفرحتي","وأشفق من بعد سيفقدني لُبى",130,"ب",2,0],["وأَظهرَ فيهِ سِرّاً من عليّ","أَضاءَ لنا ومَنْ يُخفِي ذُكاءَ",131,"ا",2,0],["وَأَظُنُّهمْ لَمْ يَسْمعُوا بِمَدائحٍ","خلّدتها في أَحمدَ بنِ مُحمَّدِ",132,"د",1,0],["وَأَظُنُّ جَفنَكِ قَد تَحَكَّمَ فِيهما","فَلَقَدْ أَجَادَ وَصحَّحَ التقِسيمَا",133,"م",2,0],["وَأَظهَرَ في الشِعرِ تَصديقَهُ","وَعَن قَولِهِ لَم يَمُت ذا اِنحِرافِ",134,"ف",1,0],["وَأَظهَرَتني بِها لي عِندَما ظَهَرَت","وَبِالمُنى آمَنتُ نَفسي مِن الوَجَلِ",135,"ل",1,0],["وَأَظُنّ البُدور قَد نَقَّطَته","عِندَما لاحَ بِالنُجومِ سرورا",136,"ر",2,0],["وأظلمتِ الدُّنيا فأيقنتُ عندها","بأنّي دَفنْتُ الشّمسَ في قبره دفْنا",137,"ن",2,0],["وأَظْهَر لي ما أَضمرَ الدّهرُ حقْبةً","ودهرُ الفتَى ذو أَظهُرٍ وبُطون",138,"ن",1,0],["وأظَلَّ اليومَ مُودِّعُه","للِقاءٍ منك يُزوَّده",139,"د",2,0],["وأَظلَّهم بيتُ النّبوّةِ وابتنَوا","مُلكاً ببِيضٍ في الأكُفِّ حِداد",140,"د",1,0],["وأَظُنُّ أنّ سَوادَ إنسانَيْهما","لهما حِدادٌ للمُصابِ أحَدَّتا",141,"ت",2,0],["وَأَظُنُّ وَردَ الخَدِّ يُس","قى مِن مَراشِفِهِ بِراح",142,"ح",1,0],["وأظهر لي حُسنَ اللقاء تكلفاً","ومن تحتِ إحسان اللقاء عقارب",143,"ب",1,0],["وأظهَروا نَوراً لهُ أرزقاً","له من الأنفسِ أثمارُ",144,"ر",1,0],["وأَظلُّ أعترضُ الرياح تنسماً","فأعالجُ الأهواءَ بالأهواءِ",145,"ا",2,0],["وأظنُّها نسيت عهوداً بالحمى","كلّا ولكن شوقُها لم يُقلِع",146,"ع",1,0],["وَأَظهر شُكر الرَوض لِلغَيث مَثنياً","عَلى دَولة الإِحسان أَثنى وَما اِستَثنى",147,"ن",2,0],["وَأَظُنني إِن ضَنَّ دَه","ري بِالتَلاقي غَيرَ باقي",148,"ق",2,0],["وَاِظمائي إَلَيهِ لَكن دونَهُ","سَيف اللحاظ قاطع في الغمد",149,"د",1,0],["وأظهرتُ للأَيام صَبر ابنِ حُرةٍ","وقد نثلتْ ما في الكنانةِ مِن سهمِ",150,"م",1,0],["وأظهر غرامك مبرزاً","ما في الضمير المستكن",151,"ن",1,0],["وأظنه فيما يلوح لمن غدا","بالسجن صارم ذهنه مفلولا",152,"ل",2,0],["وأظن المزن إذ شاهدها","قال هذي مؤنة قد كفيت",153,"ت",1,0],["وَأَظلمهنَّ إِن ناديتُ يَوماً","بِإِحداهِنَّ يا بَدرُ التَمامِ",154,"م",1,0],["وَأَظُن عين سعاد قَد قلبت لَهُ","هاء فَكُل سهادِهِ بِسعادِهِ",155,"د",2,0],["وأظُنُّه يُبدي الصدودَ ضرورةً","وإذا قطيعَتُه قطيعةُ عَامِدِ",156,"د",1,0],["وَأَظلَمَتِ العِراقُ وَأَورَثَتها","مُصيبَتُهُ المُجَلِّلَةُ اِختِلالا",157,"ل",2,0],["وأَظهروا ما أَضمروا من كيدِهم","وكانَ في صدورهم كمينا",158,"ن",2,0],["وأظلمُ من يجني على الصّبّ في الهوى","مليٌّ لوى دين الغرام مطول",159,"ل",1,0],["وأظمى كبدي الحرّى","بَرودُ الثغر ريَّان",160,"ن",1,0],["وأظهرَ فيه الله أسرارَ لُطفِهِ","وقد كانَ سِرًّا في الغيوب محجّبا",161,"ب",2,0],["وأظهرت بالعراق العدل رأفته","من بعد ما مُلِئت ظلماً وعدوانا",162,"ن",2,0],["وأظن أن الشمس ما كسفت","إلاَّ لتكشف بعدها ضري",163,"ر",2,0],["وأظنّها لمّا بدَتْ","كالشّمسِ أعشَتْ ناظرَيْهِ",164,"ي",2,0],["وأظنّ أمكَ يا مذَبذبُ خلّطَتْ","فالناسُ فيك جمعُهم خُلَطاءُ",165,"ا",2,0],["وأظنّهُ هزّ السماحَ بعطفِه","كرَماً فقسّمَهُ على عُوّادِه",166,"د",2,0],["وأظلّ في دولة وفرط صبابةٍ","من ساكيني هضب العقيق ولعلع",167,"ع",1,0],["وأَظلَمَ فِي عُلْيا سمِائكَ كوكَبٌ","يُسامِي بذكراكَ الظَّلامَ فَيَبيَضُّ",168,"ض",1,0],["وأُظْمِيتُ منها إِلَى رَشْفِ ماءٍ","يُمَثَّلُ لي فِيهِ رِيقُ الحبيبِ",169,"ب",1,0],["وَأُظفِرَ سَعيٌ بالرِّضى من مُظَفَّرٍ","وبُورِكَ لي فِي حُسنِ رأْي مُبارَكِ",170,"ك",1,0],["وأظهرت الرزية سوء حالي","وفتش مدمعي السر الخفيا",171,"ي",2,0],["وأظلّ في مَرَح الصِبا","نشوانَ ما بين الربوع",172,"ع",1,0],["وأظل أعتنقُ الشقاءَ عقيدتي","ما دمتُ ألهمُ أمَّتى بشقائي",173,"ي",1,0],["وأظل انتحهم بروحٍ حُرةٍ","لم تُخترم بمنافعٍ عرجاءِ",173,"ا",2,0],["وأظل الوفي رغمَ اغترابي","لبلادٍ ما غُيبِّت قطَّ عنِّي",174,"ي",1,0],["وأظلُ عمري مَن يناِ","فحُ دون عونٍ أو مُجيبِ",175,"ب",1,0],["وأظهرَ في تدبيرها معجزاتِهِ","فقام نذيرٌ بالغيوب مُبينُ",176,"ن",1,0],["وأظلعَ البزلَ منه ثقَلٌ","أقلَّه وهو في الفصالِ",177,"ل",1,0],["وأظنّ إصرارَ الزمان قد ارعوى","شيئاً ومُعرضَ وجهه قد أقبلا",178,"ل",2,0],["وأظنّ أنّ محاسناً سأرودها","نظراً وتجريها لديّ تفضُّلا",178,"ل",2,0],["وأظلُّ أسمح للصعيد بأوجهٍ","قلبي بهنّ على الشحوبِ بخيلُ",179,"ل",1,0],["وأظنُّ استقلالَه الدَّستَ أن ير","كَبَهُ يملكُ الزمانَ السريرا",180,"ر",2,0],["وأظهرَ الآيةَ في اشتباههم","بأساً وجوداً وعناءً وجَلَدْ",181,"د",1,0],["وأُظْهرُ سِلواني لها ووراءهُ","غرامٌ كضرب المُرهفاتِ القواطِعِ",182,"ع",1,0],["وأظلمَ حالي بعد مالي كأنهُ","دجى الليل من بعد البدور الأوافل",183,"ل",1,0],["وأظلم البعدُ فالأشواق واضحة","وفي ظلام الليالي تظهرَ الشُّهب",184,"ب",1,0],["وأظهرتْ في بُعدِهم","لنا الليالي عِبَرا",185,"ر",2,0],["واظهر بمظهرك المستحسن الوطني","واظفر من الصدق في المسعى بإشهاد",186,"د",1,0],["واظهر بمظهرها السامي ومديدا","في الصالحات وبمم سوقها وسق",187,"ق",1,0],["وأظهرت باعا في السياسة طائلا","وأظهرت مذ أبحرت فيها تعمقا",188,"ق",2,0],["وإظهارها مع سؤدد ومهابة","وإقبال نور الفهم من فوق رغبتي",189,"ت",2,0],["وأظلم جو الروح من حيث لا لها","وثوب بكوات المغاني الصمدانية",190,"ي",2,0],["وأظهر على ليلي مطالع صبحه","وشتت جيوش الواردات الشيطانيه",190,"ي",2,0],["وأظن هذا الشيب في استيفائه","سنة الضحى هي في العيون تغاض",191,"ض",1,0],["وَاِظمأ لِتَروى وَكُن كَقومٍ","ماتُوا بِها عِفَّةً فَعاشُوا",192,"ش",3,0],["واظْهري وامْسي بِظلِّ رُكْنَهمْ","على إنابَةِ الخُشوعِ واصْبحي",193,"ي",1,0],["وأَظهرَكُمْ من قلبِ صِبغَةِ هاشمٍ","وأعلى بكم عَلْيا لؤيِّ بن غالِبِ",194,"ب",1,0],["وأظهَرَ عَجزاً عَن مُقَاوَمَة الأسَى","وأيقن أنَّ الخَطبَ أعظَمُ مِن خَطبي",195,"ب",2,0],["واِظْهَرْ لهُ حتّى يراكَ فإنّه","صبٌّ كساهُ الشوقُ ثوبَ خَفائِهِ",196,"ا",3,0],["وأظن أياماً سمحن بشاور","لا تقدر الدنيا على نظرائها",197,"ا",3,0],["وأظهرا المكنون من هواكما","فإنما حسن الهوى إظهاره",198,"ر",2,0],["وأظلم جو الفضل إذ غاب بدره","وفي الليلة الظلماء يفتقد البدر",199,"ر",1,0],["وأظن أن النيل لما فاته","مفروض خدمة ذا المقام الأكمل",200,"ل",1,0],["وأظهر الله فيها من براءته","ما لم يجل قط في الأوهام والظنن",201,"ن",1,0],["وأظلَمَ مِنها قَدرَ أوجُهِ بَعضِنا","فهَل هي مرآةٌ لمَجلِسِنا تَجلو",202,"و",1,0],["وأظهرهم وقد ظفروا اِمتناناً","وأطهرهم وقد قدروا إزارا",203,"ر",2,0],["وأظلمَ بينِي وبين الأنام","وما كنت من قبل إلّا البَصيرا",204,"ر",2,0],["وَأَظْفَركمْ بالعزِّ وَالعزُّ شاهقٌ","وَأَنتُمْ بِلا طَرْفٍ إلى العزِّ طامحِ",205,"ح",1,0],["وأظلم في الدنيا وأنت نصيري","مقامك ما بين البرية نادرٌ",206,"ر",1,0],["وأظهرت سراً طالما قد كتمته","وبالغير في أرض القريحة غائر",207,"ر",1,0],["وأُظهر أني قد ظفرت بعلمهم","وقلبي بذات الخال لا العلم ظافر",208,"ر",1,0],["واظهر بالحمد له أبداً","قد فاز به من يحمده",209,"د",2,0],["وأظهرِ البسطَ في كل الأمور وإن","ضاقت عليك فقل يا أزمة انفرجي",210,"ج",2,0],["وأظهرت في ذاك الملا فضل آدم","وأنزلته أعلى مقام بجنتي",211,"ي",1,0],["وأظهرت من صلبي جميع مظاهري","بصورة ذر للعهود الوثيقة",211,"ه",1,0],["وأظهرت ما قد كان في الأب مضمراً","وبينت للأقوام سر الأمومة",211,"ه",1,0],["وأظهرت دين الحق بعد خفائه","فأصبحت الكفار في سوء حالة",211,"ه",1,0],["وأظهر منه الغافِقي لِمَا خفى","كشَّف عن أطوارِه الغَيمَ والدُّجنا",212,"ن",2,0],["وأظهر الأثرة والحمية","وأطعم الدنيا بني أمية",213,"ه",1,0],["وأظهر القوة والعزيمة","فأمكن القوم من الهزيمة",213,"ه",1,0],["وأظهروا في ذلك الندامة","والحق في ظاهره علامة",213,"ه",1,0],["وأظهروا بعض الذي كان استتر","وهم على الجمل في حال الحذر",213,"ر",1,0],["وأظهر البدعة والتعدي","مبتدع يعرف بالراوندي",213,"ي",1,0],["وأَظمأُ إِن أَبْدَى لي الماءُ مِنَّةً","ولو كانَ لي نَهْرُ المجرَّة مَوْرِداً",214,"د",2,0],["وأَظلُّ في سوق الكَسَا","دِ أُباع فيه ولَسْتُ أُشْرىَ",215,"ر",2,0],["وأَظنُّ أَنَّ الصَبر يُرْغِبُهُ","إِن جاءَ يوماً فرطُ إِعْوَالِي",216,"ي",1,0],["وأَظْلِمُه وهو البري لأَغْتَدِي","بجائِرِ لَثْمِي أَسْتَقِصُّ وأَسْتَقْصي",217,"ص",2,0],["وأَظُنُّ بالدّهر الظنو","نَ وإِنَّ بَعْضَ الظَّنِّ يُضْنِي",218,"ي",1,0],["وأَظنُّه قصدَ الجناسَ لأَنه","طرْفٌ زنا لما رأَى طَرْفاً رَنَا",219,"ن",2,0],["وأَظلُّ باسْمِك في الهوَى","وأَضِلُ من كَلَفِي بأَسْما",220,"م",2,0],["وأَظلمَ فيها النَّقعُ واشْتَكَت الظُّبَى","فأَصبحَ فيها الموتُ لا يَتَنَفَّسُ",221,"س",1,0],["وأَظهرَ فينا الفضل قبل ظهوره","وقد يقطع الصمصام بالحد مغمداً",222,"د",2,0],["وأظهر الله هذا الدين وانتشرت","أحكامه في الورى من بعد أن كانا",223,"ن",2,0]]}