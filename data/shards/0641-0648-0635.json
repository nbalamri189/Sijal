{"poems":[[95,"وزنجية حسناء كالمسك لونها","https://www.aldiwan.net/poem11303.html","الطويل"],[68,"قيل لي تعشق الصحابة طرا","https://www.aldiwan.net/poem41384.html","الخفيف"],[71,"لا تعاتب على انقطاعي فودي","https://www.aldiwan.net/poem28553.html","الخفيف"],[77,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[21,"","https://poetry.dctabudhabi.ae/diwan/poem/11120","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9904","الكامل"],[132,"إن يوم الفراق كان شديدا","https://www.aldiwan.net/poem50634.html","الخفيف"],[154,"تركنا زهيرا للبقيع فثهمد","https://www.aldiwan.net/poem68579.html","الطويل"],[190,"أفديه من هاجر وما هجرا","https://www.aldiwan.net/poem43856.html","المنسرح"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[327,"أرقت وشر الداء هم مؤرق","https://www.aldiwan.net/poem56359.html","الطويل"],[409,"أهلا بها فلقد وافت على ظمإ","https://www.aldiwan.net/poem33377.html","البسيط"],[415,"لا توص عند الموت","https://www.aldiwan.net/poem31621.html","عموديه"],[445,"كسيت بدولتك اليالي نورا","https://www.aldiwan.net/poem34851.html","الكامل"],[445,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[463,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[463,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[518,"إذا زار الحبيب أثار شوقا","https://www.aldiwan.net/poem67706.html","الوافر"],[563,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[568,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[580,"رحلوا فلست مسائلاً عن دارهم","https://www.aldiwan.net/poem2861.html","الكامل"],[580,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198602","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96643","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48934","الكامل"],[1798,"","https://poetry.dctabudhabi.ae/diwan/poem/114919","الطويل"],[1845,"","https://poetry.dctabudhabi.ae/diwan/poem/132181","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52062","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69400","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123032","الوافر"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46729","الكامل"],[2939,"","https://poetry.dctabudhabi.ae/diwan/poem/146972","الكامل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103419","البسيط"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123881","الرجز"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99314","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89295","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89154","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62909","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48440","المتقارب"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216698","الخفيف"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/90032","الخفيف"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59505","الوافر"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35544","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81927","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73251","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73231","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73207","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58018","الكامل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113822","البسيط"],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[307,"عاشق الكعبة","https://www.poetsgate.com/ViewPoem.aspx?id=213651",""],[5582,"صِلِيهِ بِما يَشْفِي غَلِيلَ فُؤادِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63496",""],[5704,"كَمْ طَالَ لَيْلي","https://www.poetsgate.com/ViewPoem.aspx?id=191157",""],[5704,"هيداء","https://www.poetsgate.com/ViewPoem.aspx?id=191600",""],[5906,"هيهات","https://www.poetsgate.com/ViewPoem.aspx?id=188315",""],[6093,"هَلْ تَأْذَنِيْنَ لِشَاعِرٍ بِلْ عَاشقٌ ( الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=180692",""],[6102,"دِيوانُ العَربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=182739",""],[402,"وزنيجة حسناء كالمسك لونها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54063&r=&rc=915",""]],"verses":[["فَوَصْلُكِ بِنْتَ الزِّنْجِ وَالبَدْرُ طَالِعٌ","سِتَارٌ لِصَبٍّ بِالبَيَاضِ مُلَثَّمِ",0,"م",1,0],["فَوَصَفتُ الجَميعَ وَصفاً إِذا ضُو","وِعَ أَزرى بِكُلِّ مِسكٍ سَحيقِ",1,"ق",1,0],["فوصالُ العدوِّ ليسَ وصالاً","وانقطاعُ المحبِّ ليسَ انقطاعا",2,"ع",2,0],["فوَصَلتُمُ ما بيْنَنَا وأمدَّكُمْ","برهانُهُ سبباً به موصولا",3,"ل",2,0],["فوصلتَ قومك واتخذت صنيعةً","فيهم تعد وذو الصنيعة يُشكرُ",4,"ر",1,0],["فَوَصَلتُ ثُمَّ قَدَرتُ ثُمَّ عَفَفتُ مِن","شَرَفٍ تَناهى بي إِلى الإِنضاجِ",5,"ج",1,0],["فوصلتُ السهادَ ليلا طويلا","وهجرتُ الرقادَ هجراً مديدَا",6,"د",2,0],["فَوَصفُ مُقِلٍّ عِندَها مِثلُ مُكثِرٍ","إِذا خيضَ مِنها البَحرُ مُدَّ بِأَبحُرٍ",7,"ر",1,0],["فوصله نعمة وجفوته","أبيت فيها للوصل منتظرا",8,"ر",2,0],["فوَصَفوا نَديما","ذا أَدب كَريما",9,"م",2,0],["فَوَصَّلتُ أَرماثاً قِصارا وَبَعضُها","ضَعيفُ القُوى بِمَحمَلِ السَيفِ موثَقُ",10,"ق",1,0],["فوصل من شئت منها غير ممتنع","ومورد اللهو صاف من تصافينا",11,"ن",2,0],["فوصية الأموات بالأحيا","ء من شعب الجنون",12,"ن",1,0],["فوصلْتَ مَا وصلُوا من النسبِ الَّذِي","بِذَرَاكَ عُوِّذَ أَن يُرى مهجورا",13,"ر",2,0],["فَوَصَلْتَ يَا مَنْصُورُ مِنَّا غُرْبَةً","مَقْطُوعَةَ الأَنْسابِ والأَسْبابِ",14,"ب",1,0],["فوصلتَ في المقطوع ممتثلاً","أمرَ العلا ووسمتَ في الغُفْلِ",15,"ل",1,0],["فوصلنا والعلا لم تختضعْ","باعتساف والذّرَى لم تُلتَطا",16,"ط",2,0],["فوصلٌ يكسب المشتاق سقماً","ونأيٌ لا يقوم له قوام",17,"م",1,0],["فوصف الصفا عندهم زائد","وقدس النفوس بأفضالها",18,"ل",3,0],["فَوَصلُها ذو اِنصِرامٍ","وَصَرمُها ذو اِتِّصالِ",19,"ل",1,0],["فوصالُها لنعيمِهم وصدودُها","لشقائِهم ورحيلُها لدمَارهم",20,"م",1,0],["فوصلُكم ولا عدمتُ وصلَكم","إِن شئتَ يغْري أَو أَردت يسلي",21,"ل",2,0],["فوصلت عهد الراشدين بيومنا","حتى غدا عن عهدهم لا يجذم",22,"م",1,0],["فَوصلك يا ذاتَ الوشاحِ يصدّهُ","وَيثنيهِ مِن قبلِ اللقاءِ معادهِ",23,"د",2,0],["فوصله بالنصب جاز والبذل","أولى وقطعه على خلف حصل",24,"ل",1,0],["فوصفتَ لبناناً وفرطَ شقائه","في الحرب وصفاً ذكرُه إيلام",25,"م",1,0],["فوصلاً ولا تقطع علايقَ خُلَّةٍ","أُميمةَ حَتَّى بَتَّها فتقضبا",26,"ب",2,0],["فوصالكم لي جنة","لكن قلبتم لى المجنه",27,"ن",2,0],["فَوَصَلَتْ رَحْمَكَ رأفَةً وَأقَمْتَها","أعلَى مَقَامٍ فِي الجِنَانِ كَبِيراً",28,"ر",2,0],["فَوَصَلتُ حينَ وَصَلتُ أَشرَفَ عامِرٍ","خِيماً وَأَفخَرَ مَنصِباً وَجُدُودا",29,"د",2,0],["فوصلك من جراح الهَجر آس","وإن تبخل به فالصبّ آسف",30,"ف",1,0],["فَوصَفتَهُ بِالسَّمعِ وَالإبصَارِ مَع","نَفسِ الحَيَاةِ وَعِلمِ ذِي الأكوَانِ",31,"ن",1,0],["فَوِصالُنا لَمّا تَعَذَّرَ بِالمُنى","أَو بِالتَحِيَّةِ في مَثاني أَسطُرِ",32,"ر",1,0],["فوصيده للصيد قِبلة قُبلة","كعصائب التيجان فيه تغفر",33,"ر",1,1],["فوَصفُهُ ببَديعِ الحُسنِ مُشتهرٌ","وَنَعتُهُ بشَديدِ البأسِ مَوجودُ",34,"د",1,0],["فوص أن يحفظها الغلام","لكي يقل منهم الملام",35,"م",1,0],["فوصلت اشكو ذا واشكر ذا وبال","غيثين ما بهما من التسكاب",36,"ب",1,0],["فوصلت بالدعوى إلى طلب العلا","ومن ادعى ما لا يليق به اختبل",37,"ل",1,0],["فوصفك منكرٌ لا شك فيه","وشخرك في بشاعته نكير",38,"ر",1,0],["فَوَصَلْنا بوصلِها زَفَراتٍ","تصدعُ الشَّأنَ أو تَفُضُّ الضُّلوعَا",39,"ع",2,0],["فوصْفُ حُلاها إذا رُمْتُهُ","يُقيّدُ منّي لساناً طَليقا",40,"ق",2,0],["فوصلنا مساءها بصباح","ووصلنا صباحها بمساء",41,"ا",2,0],["فَوَصَبري لآخُذَنّ بثاري","من ليالي الفراق يوم التلاقي",42,"ق",2,0],["فوصلكِ دونهُ الفردَوسُ طيباً","وصدُّكِ دون أبرده الجحيمُ",43,"م",1,0],["فَوِصالُها بَردُ الأَصي","لِ وَهَجرُها حَرّ الهَجير",44,"ر",1,0],["فوصالها بعد ونائلها","قرب وكثرة وعدها مطل",45,"ل",1,0],["فَوَصلُكِ من بَعدِ الَمماتِ أَظُنُّهُ","حَياتي وَمِنكِ الهَجرُ يا مُنَيتي قَتلي",46,"ل",2,0],["فَوَصلُهُ سريعُهُ خفُيفُه","وَهجرهُ طويلُهُ مديدهُ",47,"د",2,0],["فَوصلُهُمُ ما زالَ ليَ فيهِ جَنَّةٌ","وَهجرُهمُ لاَ كانَ يَوماً جهَنَّمُ",48,"م",1,0],["فوصَالُها قلبَ السليمِ مُبَرِّدٌ","وحديثُها يَشْفي العَليلَ الأرْمَدا",49,"د",2,0],["فوصفها باهر مع حسن رونقه","وكيف لا وهي قد فاقت على الأول",50,"ل",1,0],["فوصلا بها لِينًا وها النفاذ وال","خروج بذي لين لها الوصل قد قفى",51,"ا",1,0],["فوَصْلُكِ والرحيلُ عمَى عُيُونِي","مَنَ الأشواقِ أدْمَاها البُكاءُ",52,"ا",2,0],["فَوَصْلُكِ يا ذاتَ الوِشاحِ يُعِيدُهُ","وَيُحْيِيهِ مِنْ قَبْلِ اللِّقا بِمَعادِهِ",53,"د",2,0],["فوِصالُ أحْبَابِي دواءٌ ناجعٌ","للصَّبِّ ترياقُ الشفاءِ يُقَدَّمُ",54,"م",1,0],["فوصالها للقلب بات حياتهُ","وحديث عشقي مسندٌ ومقرَّرُ",55,"ر",1,0],["فَوَصلتُ بَعدَ لُصوصِنا ما غادَروا","وَ عَلى الرَّغيفِ تَقاتَلوا إخوانيْ",56,"ن",2,0],["فَوَصَفْتُ رَوْضَاً فِيْهِ أَجَمْلُ زَهْرَةٍ","وَ الشُّوكُ حَولَ عَبِيْرِهَا كَنِبَالِ",57,"ل",1,0],["فَوَصَلتُ أُمًّا أَرضَعَتنِي, صَدرَها","عَزمًا يَثُرُّ, إِذِ المَراضِعُ تَفطِمُ",58,"م",1,0],["فوصلك بنت الزنج والبدر طالع","سار لصب بالبيضا ملثم",59,"م",1,0]]}