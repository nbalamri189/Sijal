{"poems":[[79,"زارت ونجم الدجى يشكو من الأرق","https://www.aldiwan.net/poem35921.html","البسيط"],[79,"لا تعجبن لطالب نال العلا","https://www.aldiwan.net/poem36129.html","الخفيف"],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[32,"عفا الزرق من أطلال مية فالدحل","https://www.aldiwan.net/poem29547.html","الطويل"],[2,"عفا من آل فاطمة الجواء","https://www.aldiwan.net/poem25055.html","الوافر"],[51,"كأنا وإن كنا نياما عن الردى","https://www.aldiwan.net/poem62059.html","الطويل"],[51,"ألا طالما خان الزمان وبدلا","https://www.aldiwan.net/poem63069.html","الطويل"],[51,"قولا لمن يرتجي الحياة أما","https://www.aldiwan.net/poem65356.html","المنسرح"],[82,"أشكو إلى الله ما قاسيت من رمد","https://www.aldiwan.net/poem31451.html","البسيط"],[107,"مللنا وما مل العدو المغاضب","https://www.aldiwan.net/poem43099.html","الطويل"],[104,"لا تبالي بألف خطب عراها","https://www.aldiwan.net/poem32997.html","الخفيف"],[54,"صحوت ولكن بعد أي فتون","https://www.aldiwan.net/poem26609.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62213","البسيط"],[79,"زارت ونجم الدجى يشكو من الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=34208",""],[113,"أدار علي طرفك ما أدارا","https://www.aldiwan.net/poem16251.html","الوافر"],[185,"حى المنازل من حماء قد درست","https://www.aldiwan.net/poem58851.html","البسيط"],[189,"كأنما النرجس الطاقي حين بدا","https://www.aldiwan.net/poem14535.html","البسيط"],[189,"له عذار أثره ظاهر","https://www.aldiwan.net/poem14558.html","السريع"],[199,"أتعرف بالصحراء شرقي شابك","https://www.aldiwan.net/poem54400.html","الطويل"],[260,"فدى لكُما رجلي أمي وخالتي","https://www.aldiwan.net/poem709.html",""],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[342,"سل الهموم التي باتت مؤرقة","https://www.aldiwan.net/poem45296.html","البسيط"],[369,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[369,"هم نازلون بقلبي أية سلكوا","https://www.aldiwan.net/poem60817.html","البسيط"],[374,"بما حوت الأجفان نفدي عصابة","https://www.aldiwan.net/poem4300.html","الطويل"],[438,"تلين لعزمي بالعراء العوائك","https://www.aldiwan.net/poem12691.html","الطويل"],[445,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[447,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[457,"ومجلس حفت الغصون بنا","https://www.aldiwan.net/poem13686.html","المنسرح"],[475,"لتارك أرضكم من غير مقلية","https://www.aldiwan.net/poem4667.html","البسيط"],[488,"إن الخليط أجد البين فابتكروا","https://www.aldiwan.net/poem2067.html","البسيط"],[521,"كأن اولى الحاجات لما بدا لهم","https://www.aldiwan.net/poem48600.html","الطويل"],[556,"ويوم وقفنا للوداع وكلنا","https://www.aldiwan.net/poem47713.html","الطويل"],[556,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[556,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122794","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122793","الوافر"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104099","البسيط"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/103999","البسيط"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112437","الطويل"],[706,"","https://poetry.dctabudhabi.ae/diwan/poem/144827","البسيط"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44627","المجتث"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50022","المتقارب"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53053","البسيط"],[2291,"","https://poetry.dctabudhabi.ae/diwan/poem/114948","المتقارب"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28557","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88693","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88643","الخفيف"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18052","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93650","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137086",""],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10414","الطويل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121142","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201005","الطويل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22544","الوافر"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112622","الرجز"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66478","الطويل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89993","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103062","البسيط"],[3901,"","https://poetry.dctabudhabi.ae/diwan/poem/141231","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[4168,"","https://poetry.dctabudhabi.ae/diwan/poem/123832","البسيط"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96066","الطويل"],[5183,"إلى رجال الإستقامة","https://www.poetsgate.com/ViewPoem.aspx?id=180170",""],[5431,"فلن يجمع الأحياء إلاّ المصالحُ","https://www.poetsgate.com/ViewPoem.aspx?id=196844",""],[5616,"نطيحة","https://www.poetsgate.com/ViewPoem.aspx?id=203339",""],[6102,"رِديني","https://www.poetsgate.com/ViewPoem.aspx?id=182763",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""]],"verses":[["كأنّ أوْراقَهُ والرّيحُ تعطِفُها","سَواعِدٌ رفَعَتْ خُضراً منَ الورَقِ",0,"ق",1,0],["كَانَ أَوْلَى لَهُ الإِبَايَة وَالْعِز","ز يَا بِيسَ مَا ارْتَضَى أَولَى لَهْ",1,"ل",2,0],["كَأَنَّ أَوبَ ذِراعَيها وَقَد عَرِقَت","وَقَد تَلَفَّعَ بِالقورِ العَساقيلُ",2,"ل",1,0],["كَأَنّا وَالسُيوفُ مُسَلَّلاتٌ","وَلَدنا الناسَ طُرّاً أَجمَعينا",3,"ن",2,0],["كَأَنّا وَمَيّاً بَعدَ أَيّامِنا بِها","وَأَيّامِ حُزوى لَم يَكُن بَينَنا وَصلُ",4,"ل",1,0],["كَأَنَّ أَوابِدَ الثيرانِ فيها","هَجائِنُ في مَغابِنِها الطِلاءُ",5,"ا",2,0],["كَأَنّا وَإِن كُنّا نِياماً عَنِ الرَدى","غَداً تَحتَ أَحجارِ الصَفيحِ المُنَضَّدِ",6,"د",1,1],["كَأَنّا وَقَد صِرنا حَديثاً لِغَيرِنا","يُخاضُ كَما خُضنا الحَديثَ بِمَن خَلا",7,"ل",2,0],["كانا وَزيرَي خَليفَةِ اللَهِ ها","رونَ هُما ما هُما سَليلاهُ",8,"ا",2,0],["كَأَنَّ أَوجاعَ قَلبي من مُطاعَنَةٍ","بِالشَّوكِ ما بَينَ أَشفاري وأَشفاري",9,"ر",2,0],["كَأَنّا وَإِيّاهُم عَلى مُستَكِنَّةٍ","مِنَ الحِقدِ نُخفيها مَعاً وَنُوارِبُ",10,"ب",1,0],["كان أولى بكم لو انَّ مع القو","لِ فعالاً محمودة عقباها",11,"ا",3,0],["كَأَنّا وَضَوءُ الصُبحِ يَستَعجِلُ الدُجى","نُطيرُ غُراباً ذا قَوادِمِ جونِ",12,"ن",1,0],["كَأَنَّ أَوْسَاطَهُ بِالبَابِ مُمسِكَةٌ","أَذْنَابَ بُلْقٍ تُحَامِي عِنْدَ أَمْهَارِ",13,"ر",1,0],["كأن أوراقه والريح تعطفها","سواعد رفعت خضرا من الدرق",14,"ق",1,0],["كانّا وَالنُجوم إِذا عَلقنا","بِحُبك نَقطَع الظُلما نَهارا",15,"ر",2,0],["كأَنَّ أَوبَ يَدَيهِ حِينَ تَرعَبُهُ","بِالصَّوتِ وَهو يُبارِى الضُمَّرَ النُّجُبَا",16,"ب",2,0],["كأنّ أوراقَه والشمسُ تصقُلها","أوراقُ شمعٍ فمن خامٍ ومَقْصورِ",17,"ر",1,0],["كأن أُولاهُ على خَدِّهِ","ظلُّ قضيبٍ ظَلَّ في الشمس",18,"س",1,0],["كَأَنّا وَرَحلَينا عَلى أَخدَرِيَّةٍ","نَحوصٍ تُباري طاوِيَ الكَشحِ أَحقَبا",19,"ب",2,0],["كَأَنَّا وَقَد حالَت حُذُنَّةُ دونَنا","نَعَامٌ تَلاهُ فارِسٌ مُتَواتِرُ",20,"ر",1,0],["كأن أويقات النزول بحيها","معجلة من جنة في المصائر",21,"ر",1,0],["كَأَنَّ أَوبَ يَدَيها حينَ أَعجَلَها","أَوبُ المِراحِ وَقَد نادَوا بِتَرحالِ",22,"ل",1,0],["كأنّا والمطيُّ لنا حَنايا","خُلِقْنا في غَواربِها سِهاما",23,"م",2,0],["كأنّ أوجُهَهمْ والرَّوعُ يَبذُلُها","عِزّاً دَنانيرُ لم تُنقَشْ لها سِكَك",24,"ك",1,0],["كأنا وإياهم لوشكٍ فراقنا","جميعاً رأونا في الكرى ورأيناهم",25,"م",1,0],["كأنّا وأفواهُ الفِجاجِ تمُجّنا","الى مالكٍ من كلّ أرضٍ مسالكُ",26,"ك",1,0],["كَأَنَّا وَقَدْ سَدَّ بابَيْهِ عنَّا","وهامَ بِنا الذعرُ هامٌ وبومُ",27,"م",1,0],["كانا وزيريك في الدنيا ومذ تلفا","كانا ضجيعيك ما خانا وما انهدفا",28,"ف",2,0],["كان أوراقها يرف بها","فوق الندامى نسيمها الأرج",29,"ج",1,0],["كَأَنَّ أَوبَ يَدَيها بِالفَلاةِ إِذا","لاحَت أَماعِزُها والآلُ يَطَّرِدُ",30,"د",1,0],["كأن أوب ذراعيها إذا نجدت","وأحرز الظل في أعدائه الشجر",31,"ر",1,0],["كَأَن اولى الحاجات لما بَدا لَهُم","مَناكِب اِعلى عابِد فَالمُقطم",32,"م",1,1],["كأنّا وقد سلَّ الفراقُ عقولَنا","سلكنا جنوناً أو كرعنا المُشَعشَعا",33,"ع",2,0],["كَأنّ أَوجههمْ مِن نورها غَصَبَتْ","ضوءَ الصّباح وأنوارَ المقاييسِ",34,"س",1,0],["كأنَّ أَوجههم بيضاً ملألئةً","كواكبٌ في عِراصِ القفرةِ السُّودِ",35,"د",1,0],["كأَنَّ أُولاكَ ما قَرُّوا عُيُونا","بِرُؤيَتِنا وَلا كانُوا وَكُنَّا",36,"ن",2,0],["كَأنّا والأَحِبَّةَ ما عَكَفنا","عَلَى سَمَرٍ وَلا كانُوا وَكُنّا",37,"ن",2,0],["كأنّ أولهُ من حيةٍ سكنَت","إلى لِيانةِ كفِّ غَضّةِ العَنَمِ",38,"م",1,0],["كأنّ أولادها حنَّ إِذا انبعثت","لم تبقِ لا والداَ حيًا ولا وَلدا",39,"د",2,0],["كأن أوار الحب يحيى مواتها","إذا التهبت فيه قلوب وأضلع",40,"ع",1,0],["كأن أولَ فجرٍ فارسٌ حُمِلَتْ","راياتُهُ البيضُ في إِثر الدجى فكبا",41,"ب",2,0],["كَأَنَّ أَوراقَ زَهرٍ","لِلباقِلاءَ بَهِيَّهْ",42,"ه",1,1],["كأنا وجدنا ببذل الأيادي","ودفع الملمات ذهلا كفيلا",43,"ل",2,0],["كان أول النهار على رأ","سي فأمسى على رءوس القيان",44,"ن",1,0],["كان أوفى لنيل ما ترتجيه","لو أعادت ذاك الفؤاد أباها",45,"ا",3,0],["كأن أوراقه والوُرق هاتفة","منابر تليت من فوقها خُطَبُ",46,"ب",1,0],["كأنّا وثوبُ الدجى مسبلٌ","علينا لمُبصرِنا واحدُ",47,"د",1,0],["كَأَنّا وَقَد أُلقي إِلَينا هِلالُهُ","سَلَبناهُ تاجاً أَو فَصَمنا لَهُ وَقفا",48,"ف",2,0],["كان اولى بك التنصر بل ادنى","نيل غاية المقصود",49,"د",1,0],["كانَ اولى بك الحضيض ولو كنت","به عاد صاغرا بك ذلا",50,"ل",2,0],["كَأَنّا وَالرِحالَ عَلى صِوارٍ","بِرملِ جُرادَ أَسلَمَها الصَريمُ",51,"م",1,0],["كَأَن أَول حَرف بِالحَديد جَرى","مِن اسمه قال يا عَين انقلعي",52,"ع",2,0],["كأنا والقوافي زاهرات","نفوق بها نظام الاولينا",53,"ن",2,0],["كَأَنّا وَقَد أَجلَوا لَنا عَن نِسائِهِم","أُسودٌ لَها في عيصِ بيشَةَ أَشبُلُ",54,"ل",1,0],["كان أولى لك أن تن","جز للأوطان وعدا",55,"د",2,0],["كان أولى لك أن تب","قى لنا ذخراً معدّا",55,"د",2,0],["كأنا وهذا الدهر طفل ووالد","ظلوم يحب الضرب للطفل والعسفا",56,"ف",2,1],["كَأَنَّ أَواسِطَ الأَكوارِ فينا","بَنونَ لَنا نُلاعِبُهُم صِغارُ",57,"ر",1,0],["كأن أوصاليَ ترمى في الفَلا","بينَ النواويسِ وبينَ كربلا",58,"ل",2,0],["كأنا وبردينا الصبابة والتقى","وليس لنا إلاَّ العفاف قرين",59,"ن",1,0],["كأنَّ أوتارَه إذ بات يُعمِلها","قد اكتست مُلَحاً من حسن نغمته",60,"ت",2,0],["كأن أوجههم والطعن يونقها","زهر ينمنم بالطل الجمانيّ",61,"ي",1,0],["كَأَنَّا وَقَد جُزنَا لمِصِرَ فِرِنجةً","حَنِيفٌ تَخَطَّى مِن ضَلاَلٍ إِلَى هُدَى",62,"د",2,0],["كانَ أَولَى أَولَى أَن تُرَاعي شَرَفي","فَيكونَ الآن لي بعلٌ أَشَد",63,"د",1,0],["كأن أوراقه في القد أجنحةٌ","حمرٌ وصفر وبيضٌ من دنانير",64,"ر",1,0],["كأنا وإيّاكُم إذا الحربُ بينَنا","أُسودٌ عليها الزَعفرانُ مع الورسِ",65,"س",1,0],["كأنا ولم نبرح عليه صواعقا","نجرعه الغِسلين إن جار أو برى",66,"ر",2,0],["كأنا وما زلنا عليه بلية","ومرعى وخيما ناقع السم أحمرا",66,"ر",2,0],["كأنّا وقود الحرب شهوةُ نارها","كما تشتهي الصيدَ المصابَ الجوارحُ",67,"ح",1,0],["كأنا والكهوف على مزاجٍ","فلا جَبلاً نُحْب ولا سفوحا!",68,"ح",2,0],["كَأَنَّا واقِفانِ عَلَى شَفِيرٍ","يُحَرِّقُنا فَلا نَجِدُ البُرُودا",69,"د",2,0],["كأنَّا والحكاياتِ اللواتي","عميد الحيِّ يَرتقبُ الخياما",70,"م",2,0],["كَأَنَّ أَوْراقَهُ والرّيحُ تُرْعِشُها","قُلوبُ حُبٍّ لَها بالخَفْقِ إِمْعانُ",71,"ن",1,0]]}