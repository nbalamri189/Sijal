{"poems":[[79,"إن كنت تنكر ما تجن ضلوعي","https://www.aldiwan.net/poem35994.html","الكامل"],[45,"ومنتسب عندي إلى من أحبه","https://www.aldiwan.net/poem9730.html","الطويل"],[64,"الحمد لله الذي خصنا","https://www.aldiwan.net/poem52241.html","السريع"],[30,"وحلت بدهناها تميم وألجأت","https://www.aldiwan.net/poem5114.html","الطويل"],[99,"يا رب ما أعجب هذي البلاد","https://www.aldiwan.net/poem24999.html","السريع"],[83,"طاول بجدك فالأقدار عنوان","https://www.aldiwan.net/poem61481.html","البسيط"],[48,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[78,"وروضة ورد حف بالسوسن الغض","https://www.aldiwan.net/poem39277.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9497","الرمل"],[102,"تحدّي","https://www.poetsgate.com/ViewPoem.aspx?id=50181",""],[139,"لي في الصبابة أخبار وأحوال","https://www.aldiwan.net/poem49113.html","البسيط"],[266,"هل المجد إلا دوحة أنت فرعها","https://www.aldiwan.net/poem38142.html","الطويل"],[285,"إذا لم يكن من حادث الدهر موئل","https://www.aldiwan.net/poem60784.html","الطويل"],[366,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[369,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[369,"رمتني بلحظ واتقتني بمعصم","https://www.aldiwan.net/poem60649.html","الطويل"],[376,"هو الحب يصنع ما يصنع","https://www.aldiwan.net/poem57326.html","المتقارب"],[411,"زيادة المرء في دنياه نقصان","https://www.aldiwan.net/poem49713.html","البسيط"],[422,"هو الوجد يا ظمياء منك وجدته","https://www.aldiwan.net/poem53967.html","الطويل"],[463,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[469,"ما لطيف زار منكم موهنا","https://www.aldiwan.net/poem3343.html","عموديه"],[482,"بي من جوى التبريح اشفاق","https://www.aldiwan.net/poem15351.html","السريع"],[505,"دع وهم أهل الوحدة المطلقه","https://www.aldiwan.net/poem37935.html","السريع"],[539,"أزف لك التحية والسلاما","https://www.aldiwan.net/poem23815.html","الوافر"],[556,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[556,"ليت أنا لما فقدنا الهجوعا","https://www.aldiwan.net/poem47716.html","الخفيف"],[563,"إن الحروف إشارات المداد فلا","https://www.aldiwan.net/poem33579.html","البسيط"],[563,"وجودكم تتمنوا أنه دائم","https://www.aldiwan.net/poem33862.html","المواليا"],[563,"نعم لقلوب العاشقين سرائر","https://www.aldiwan.net/poem34527.html","الطويل"],[563,"كل أناس لهم لغات","https://www.aldiwan.net/poem34724.html","مخلع البسيط"],[563,"قلبي لعلم الإله باب","https://www.aldiwan.net/poem34962.html","مخلع البسيط"],[567,"سلام على من لا نمر بباله","https://www.aldiwan.net/poem52813.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103088","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87064","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48820","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48676","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64041","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37962","المجتث"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34764","الرمل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77479","الرجز"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1128,"","https://poetry.dctabudhabi.ae/diwan/poem/146939","المجتث"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46676",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50007","الطويل"],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206238",""],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124722","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71082","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27624","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27527","المتقارب"],[2226,"","https://poetry.dctabudhabi.ae/diwan/poem/200275","الطويل"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34714","الرمل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129982","المجتث"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129910","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87328","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130807",""],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102185","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134205","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87361","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48358","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86310","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110051","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92430","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92012","الطويل"],[3815,"","https://poetry.dctabudhabi.ae/diwan/poem/143161","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135913","الرجز"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103543","الطويل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102741","الطويل"],[4201,"","https://poetry.dctabudhabi.ae/diwan/poem/143824","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90840","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133069","الرجز"],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4961,"وصلَّى خلفكَ العملُ المثالي","https://www.poetsgate.com/ViewPoem.aspx?id=37240",""],[5219,"أضنيت قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=193839",""],[5277,"حمامةٌ زادُها الكتابُ..","https://www.poetsgate.com/ViewPoem.aspx?id=215560",""],[5461,"طالت القامات","https://www.poetsgate.com/ViewPoem.aspx?id=5039",""],[5564,"يالله بليلة من خيار الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=186846",""],[5606,"يقول عيسى وعيسى يرفع أقواله","https://www.poetsgate.com/ViewPoem.aspx?id=197970",""],[5896,"القمران","https://www.poetsgate.com/ViewPoem.aspx?id=190063",""]],"verses":[["وكَّلُوا بحِفْظِ العَهْدِ أيَّ مُراقِبٍ","واسْتَحْفَظوا الأسْرارَ غيْرَ مُذيعِ",0,"ع",1,0],["وَكُلُّ وِدادٍ لا يَدومُ عَلى الأَذى","دَوامَ وِدادي لِلحُسَينِ ضَعيفُ",1,"ف",1,0],["وكل وأنفق غير مستأثر","فقد كفيت الفقر والفاقره",2,"ر",2,0],["وَكُلُّ وُجوهِ الناسِ إِلّا إِلَيكُمُ","يَتيهُ بِضُلّالٍ عَنِ القَصدِ جائِرُه",3,"ر",2,0],["وكل وجه في حماها ضِماد","ومصر لا تنبت إلا الجراح",4,"ح",1,0],["وَكُلُّ وَقتٍ رَبيعٌ مِن خَلائِقِهِ","وَكُلُّ رَوضٍ بِهِ في الطيبِ بُستانُ",5,"ن",1,0],["وكُلِّ وَجِيهِيّ كأنّ رُؤالَه","تحَدّرَ من عِطْفَيْهِ فوْقَ حِزامِهِ",6,"م",2,0],["وَكُلْ وَرْدَ خَدَّيْهِ ورُمَّانَ صَدْرِهِ","بِمَصٍّ على مَصٍّ وعَضٍّ عَلى عَضّ",7,"ض",1,0],["وكل ورد رائع غريب","في أرض جور ليس بالغريب",8,"ب",1,0],["وَكَّلوا بِكَريمٍ","حَسَداً وَغَراما",9,"م",2,0],["وكلوا جوعنا وسيروا على أش","لائنا الحمر º كالخيول ... الجماح",10,"ح",1,0],["وكل وادٍ أرى قلبي يهيم بهِ","سيانَ في مذهبي شيبٌ وأطفالُ",11,"ل",1,0],["وكل وحوش القفر تدعى بواحد","وأين من القرد المماجن سبعها",12,"ع",3,0],["وَكُلٌّ وَإِنْ طَالَ الثَّوآءُ مَصِيرُهُ","إِلى مَوْرِدٍ مَا عَنْهُ لِلْخَلْقِ مَعْدٍلُ",13,"ل",1,0],["وَكل وَصف جَميل","لِغَيرِهِ فيه قَد تَم",14,"م",1,0],["وكلُّ وجيهيٍّ أغرٍّ مُحجَّلٍ","مُقَيَّدِ حُورٍ بالفَلاةِ وَعين",15,"ن",1,0],["وكلٌّ وإنْ وافَى ضُحىً وهْو كوكبٌ","أضاء لعَيْن النّاظرِ المُتَوسِّم",16,"م",1,0],["وكلٌّ وإن كرِهَ الحاسِدو","نَ منَّا لصاحِبه أطوَعُ",17,"ع",1,0],["وكُل وِجدانِ حَظٍّ لاثَباتَ لَهُ","فإنَّ مَعناهُ في التَّحقيق فِقْدانُ",18,"ن",1,0],["وكلُّ وميضٍ يا سُليمى يروعُه","وكلُّ هوًى من آل ميٍّ يشوقُه",19,"ق",2,0],["وكلّ والٍ للخطو","ب باسمه منصرفُ",20,"ف",1,0],["وكلوا باللحظ هنديّ الظُّبى","والقدودَ المخطفاتِ اللُّدنا",21,"ن",2,0],["وكلُّ وخادٍ رمينا بهِ","غُبرَ الموامي فهو سبّاقُ",22,"ق",1,0],["وكلَّ وقتٍ كُلُّهُ حاجَةٌ","لثوبِهِ والخُبْزِ والمَلْعَقَهْ",23,"ق",2,0],["وكل وزارة بل كل قسم","به منهم مشير قد أقاما",24,"م",2,0],["وَكَلوا إليه عُرا الأمور وإنّما","وَكَلوا السَّماحَ إلى العمامِ المُسبِلِ",25,"ل",1,0],["وكِلونا إلى النُّزُوعِ عن الحب","بِ وهيهات أنْ نريد النُّزوعا",26,"ع",2,0],["وكل واحدة مما ذكرتُ لها","بالأصل منها اتصال قط ما انفصلا",27,"ل",2,0],["وكل واحدْ مقدَّرْ في العدمْ حائمْ","لم يدر أن وجودُهْ ربُّهُ القائمْ",28,"م",1,0],["وكل وجود مطلق أو مقيد","بعقل وحس فهو عنه ستائر",29,"ر",1,0],["وكل وقت له كلام","وكل شغل له أداةُ",30,"ه",1,0],["وكل وقت لنا دنو","وكل حين لنا اقتراب",31,"ب",1,0],["وكلُّ ولاةِ الأمرِ تحتاجُ قاضياً","سِوى ملحمٍ عمِّ القضاءِ وخالِهِ",32,"ل",2,0],["وكل وجودي في وجود طويته","وقد ظل نشر الطي في نشره ظلا",33,"ل",2,0],["وكل وجود عنك باللَه أعلما","وفي طيك النشر البسيط وإنما",34,"م",2,0],["وَكُل وَزير أَلمعيّ بِتُونس","جَدير بِمَدح من فَقيه وَعالم",35,"م",1,0],["وكل وفيٍّ للبلاد وأهلها","جوادٌ بعينيه ومهجته سمحُ",36,"ح",1,0],["وكلوا لك العفو المرجَّى بعد ما","قضت الصروف قضاءها المحتوما",37,"م",2,0],["وكلُّ وصفٍ جميلٍ ظلَّ مفترقاً","في الناس متَّفِقٌ فيهم ومؤتلف",38,"ف",1,0],["وَكلَّ وَقتٍ أَعِنْهم","وَلا تَكُن ذا قصورِ",39,"ر",1,0],["وَكَلوحٍ أَبَداً مُفتَرَّةٍ","لَكَ عَن هُتمٍ كَليلاتٍ رُجُف",40,"ف",1,0],["وَكُلُ وَاحدٍ رَمى لَهُ شرك","وَبَينَهُم ما راجَ فَهوَ مُشترك",41,"ك",1,0],["وكل وجه حازه جميل","والنفس دائما له تميل",42,"ل",1,0],["وكل ود مراء","وكل بر عقوق",43,"ق",1,0],["وكلّ وجهٍ مثل شمسِ الضحى","فوقَ قَوام مثل غصن رشيق",44,"ق",1,0],["وكلُّ وصالٍ لم يكن بين أهلِهِ","مواثيق من حبل الهوى سَيَزُولُ",45,"ل",1,0],["وكل واحد بات مرتاح الضمير","فِيْ ذرى الله وحبيب الجوهره",46,"ر",2,0],["وكلوا لمسقط شمسه ووجوبها","حتى يبين تنفس الفجر",47,"ر",1,0],["وكلَّ وسيع النَّسْجِ يُشْحَذُ حَدَّهُ","عن الفُرُش اللاتي غُلِلْنَ غِلالا",48,"ل",2,0],["وكلُّ وليٍّ ما عدا الحق نازلٌ","فليس ولياً فالوليّ هو الله",49,"ل",2,0],["وكلُّ وجودٍ له باطنٌ","إذا ما دجا ليله أشرقا",50,"ق",2,0],["وكل وداد لايكون مسرمدا","إلى يوم ميعاد الورى ليس بالود",51,"د",1,0],["وَكَلومٍ مُؤلِماتٍ","وَنُدوبٍ قَرِحات",52,"ت",1,0],["وكلّ وجه مليحٍ","يزويه بدرٌ لعِلّه",53,"ل",2,0],["وكلّ وادٍ به موسى يُفَجّرهُ","وكُلُّ واد على حافاتهِ الخضِرُ",54,"ر",1,0],["وكُلُّ وَصفِي ذا على نجمين","طالع وغارب فآفهَمِ التقمين",55,"ن",1,0],["وكل واحدة ثلث بطلقتها","وفي فتاوي سدسها بلا وجل",56,"ل",1,0],["وكل ورد بديع الشكل مختلف","لونا ومؤتلف من خير أجناس",57,"س",1,0],["وكل وقت من الرحمن تكرمة","جليلة وتحيات عليات",58,"ت",1,0],["وَكُلُّ وردٍ فعنهُ يُبتَغى صَدَرٌ","وعن ورودهما لا يُبتَغي صَدَرُ",59,"ر",1,0],["وكُلُّ واشٍ يَرومُ صَبْري","جنّبتُ أقوالَهُ اطّراحا",60,"ح",2,0],["وَكُل وُجدان حَظ لا دَوام لَهُ","فَهو السَرابُ وَمن يَأتيه عَطشان",61,"ن",1,0],["وَكُلُّ وَقتٍ قَابِلٌ ذَاكَ وَمَا","يَقبَلُهُ المَكان إلاّ مُبهَمَا",62,"م",2,0],["وكلُّ وَرُودٍ غيرَ مَورِدها قَذىً","وكلُّ عُقار ليس من حانِها خَلُّ",63,"ل",1,0],["وكُلوا مَرِيّاً واشرَبوا ثُمَّ اسكَروا","من خمرةٍ ان أَسكَرَت عقلاً صَحا",64,"ا",1,0],["وكل وعدٍ قادمٍ","يمحوه مطلٌ ذاهبُ",65,"ب",1,0],["وَكُل وَليد هالكٌ وابن هالك","سِوى أَن أعمار الوَرى في مظنة",66,"ه",1,0],["وكلّ وإن طال المدى سوف ينتهي","إلي قعر لحدٍ في ثرى منه يودع",67,"ع",1,0],["وكل واحدٍ من اسم نفسُ","صاحبهِ وكل ذاك قُدْسُ",68,"س",1,0],["وكل وجودٍ عن وجودك كائن","فواجدُ أصناف الورى لك واجدُ",69,"د",1,0],["وَكلُّ وَصفٍ وَاجِبٌ لِلذَّامرها","دَامَت بِلاَ زَيدٍ لِنفسٍ وانتَمَى",70,"م",2,0],["وكل وإن نال السماء مطاره","فريش بزاة الفكر منه قصيص",71,"ص",1,0],["وكل وزري محبط","ما دام فيه وزري",72,"ر",2,0],["وكل وجيه وجه ذي جبين","به نور النبوة والسجود",73,"د",1,0],["وكل ولي ماضٍ وآت","أصلح دنانا والمعاد",74,"د",1,0],["وكل وصي أو ولي مكاشف","جلا سره عندي ولم ير كتمان",75,"ن",1,0],["وكلُّ وجودِك الميمون ِ ِ درسٌ","يقصُّ على الورى معنى النضال ِ",76,"ل",1,0],["وكلوم قلب بالجراح تفتقت","عجز الأساة بطبها وبطبنا",77,"ن",2,0],["وكلوحةٍ لاشيَ مسّ إطارَها","ألوانها الحمراءُ من طينٍ وماءْ",78,"ا",2,0],["وكل وادي سال بجموع البشر","حادي الاشواق داعيها تسير",79,"ر",1,0],["وكلّ وادٍ يصبح من السيل مالي","ويسقي وطن متخالفات الوسايم",80,"م",1,0],["وكل واحد بيسكن قبره لحاله","وحده يحاسب ووحده يحمل أوزاره",81,"ر",2,0],["وكل وعودنا باتت تداري","على الآمال أوهام الخمار",82,"ر",1,0]]}