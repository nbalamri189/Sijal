{"poems":[[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59418","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95542","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83161","الخفيف"],[5038,"يشكو الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=188833",""],[5982,"يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=152889",""],[6069,"حي كتاباً فضضت خاتمه","https://www.poetsgate.com/ViewPoem.aspx?id=105655",""]],"verses":[["حيكت ببنان الثنا رقيقة غزل","زينت بلال السنا على أشرف منوال",0,"ل",1,0],["حيك بُرداه من خلاصة فضل","ويقين وحكمة ووقارِ",1,"ر",1,0],["حَيِّ كَنزاً مِن الحِلى تَرجَح الدُر","رَةُ مِنهُ بِكُلِّ ما في الوُجودِ",2,"د",1,0],["حِيكَتْ على عَورَةِ الرِّعْديدِ مِدْرَعَةً","مِنْها إِذَنْ أسْيفُ الْأبْطالِ تَرْتَجِفُ",3,"ف",1,0],["حيكي لباسك من ثراك وابرزي","كزهرة البستان والغصن الرطيب",4,"ب",1,0],["حي كتاباً فضضت خاتمه","عن مثل وشي الرياض أو أملح",5,"ح",1,1]]}