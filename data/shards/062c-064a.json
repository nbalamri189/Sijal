.com/ViewPoem.aspx?id=50385",""],[50,"يَا لَقَوْمِ لِلْحَبِيبِ الْمُذَّكَرْ","https://www.poetsgate.com/ViewPoem.aspx?id=22682",""],[67,"أزمعوا البين وشدوا الركابا","https://www.poetsgate.com/ViewPoem.aspx?id=3141",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[45,"لمْ يَبقَ، في تلكَ الرّسُومِ بمَنْعِجِ","https://www.poetsgate.com/ViewPoem.aspx?id=33107",""],[80,"ولما التقى الأجسام من غير ريبة","https://www.poetsgate.com/ViewPoem.aspx?id=3317",""],[101,"بَغْدَادُ يَابَلَد الرَشِيدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62444&r=&rc=36",""],[105,"يا أيها القوم ماذا في حقائبكم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54986&r=&rc=156",""],[85,"أَمِنَ البحرِ صائغٌ عَبْقَرِيٌّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9659&r=&rc=149",""],[85,"جئتنا بالشعور والأحداق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9559&r=&rc=49",""]],"verses":[["جِئتُهُم في جَفوَةِ الدَهرِ فَلا","أَوصَدوا البابَ وَلا لَطّوا القِراما",0,"م",2,0],["جَيئُهُم مُخمَسُ الرِكابِ فَنادَوا","جَنِّبِ الوِردَ لا نَقَعتَ صَداكا",1,"ك",2,0],["جِيادٌ إِلى غَزوِ القَبائِلِ تُمتَطى","وَأَرضٌ إِلى نَيلِ العَلاءِ تُجابُ",2,"ب",1,0],["جيْشُ بَني نصْرٍٍ مُلوكِ الوَرَى","قوْماً إذا الدّاعِي لخَطْبٍ دَعا",3,"ع",2,0],["جِيدٌ كَمَا الْتَفَتَ الظَّلِيمُ وَفَوْقَهُ","أُذْنٌ مُشَنَّفَةٌ وَطَرْفٌ أَكْحَلُ",4,"ل",1,0],["جيْشانِ منْ زَنْجٍ ورومٍ أحْدَقا","بطَريدِ معْرَكةٍ فبانَ فِرارُهُ",5,"ر",2,0],["جيرانُ بيْتِ اللهِ والعَرَبِ الأُلى","أضْحَوْا على قُنَنِ النّجومِ قُعودا",6,"د",2,0],["جِيرَةَ الحَيِّ والحَديثُ شُجونٌ","واللّيالي تَلينُ بعْدَ الجِماحِ",7,"ح",1,0],["جَيْشانِ منْ لَيْلٍ وبُرْغوثٍ فهَلْ","جَيْشُ الصّباحِ لصَرْخَتي بمُغيثِ",8,"ث",1,0],["جيش يرى تعب المغاوز راحة","وَالسَّهْلَ صَعْباً والْبَعيدَ قَرِيبا",9,"ب",2,0],["جِيادُكَ في الصَيفِ في نِعمَةٍ","تُصانُ الجِلالَ وَتُعطى الشَعيرا",10,"ر",2,0],["جِئتُهُ يَوماً فَأَدنى مَجلِسي","وَحَباني بِلُجوجٍ في السُنَن",11,"ن",1,0],["جِئتُ أَروي بِدُموعي مَضجَعاً","فيهِ أَودَعتُ مِنَ الدُنيا نَصيبي",12,"ب",2,0],["جِئتُ عَنها أَحمِلُ البُشرى إِلى","أَوَّلِ البانينَ في هَذا البَلَد",13,"د",1,0],["جِئنا نُؤَدّي حِساباً عَن مَواقِفِنا","وَنَستَمِدُّ وَنَستَعدي وَنَحتَكِمُ",14,"م",1,0],["جِئنا إِلى بابِهِ لاجينَ نَسأَلُهُ","فَلَيتَنا عاقَنا مَوتٌ وَلا جينا",15,"ن",2,0],["جَيشٌ إِذا ما الأُفقُ سافَرَ طَيرُهُ","مَعَهُ فَفي ذِمَمِ الصَوارِمِ زادُ",16,"د",1,0],["جئت فيه المعجزات فأمسى","فوق وصفٍ تضمه الأشعار",17,"ر",1,0],["جيش من الأحرار يأتي النظام","حسب العلى منه بلوغ المرام",18,"م",1,0],["جِئْنِي بِمَجْدٍ وَخُذْ مِنِّي تَحِيَّتَهُ","فِي كُلِّ آنٍ وَهْيَ وَلا وَهَنِ",19,"ن",1,0],["جِئْنَا نُلَطِّفُ تَبْرِيحَ المُصَابِ بِهِمْ","إِنْ لَطَّفَ البَثُّ نِيرَاناً بِنِيرَانِ",20,"ن",1,0],["جِئْنَا حِمَاهَا وَعِشْنَا آمِنِينَ بِهِ","مُمَتَّعِينَ كَأَنَّ العَيْشَ فِي حُلمِ",21,"م",1,0],["جَيْشُهَا نَاكِسُ السِّلاحِ تُمَاشِي","هِ وَئِيداً شَجِيَّةُ الأَنْغَامِ",22,"م",1,0],["جَيْشٌ وَأَنْتَ القَائِدُ الأَعْلَى لَهُ","هُوَ لِلحِمَى وَبَنِيهِ نِعْمَ الحَامِي",23,"م",2,0],["جُيُوبٌ بِهَا مِنْ كُلِّ غَالٍ وَفَاخِرٍ","نَفَائِسُ تَغْزُوهَا اللِّحَاظُ فَتَغْنَمُ",24,"م",1,0],["جِئنا بِهِ يَشفَعُ في حاجَةٍ","فَاِحتاجَ في الإِذنِ إِلى شافِعِ",25,"ع",1,0],["جِئتُ بِلا حُرمَةٍ وَلا سَبَبِ","إِلَيكَ إِلّا بِحُرمَةِ الأَدَبِ",26,"ب",1,1],["جِئنا بِأَثارِهِم أَسرى مُقَرَّنَةً","حَتّى دَفَعنا إِليهِم رُمَّةَ القَوَدِ",27,"د",1,0],["جيش قد اقتحم المخاطر واثقاً","بالله والنصر المؤزَّر مؤمنا",28,"ن",2,0],["جئت إلى الدير ضحا يوم الأحد","أقصِد منها حلباً فيمن قصد",29,"د",1,1],["جيش ابن عثمان مولانا الخليفة من","أضحى به شمل هذا الملك منتظِما",30,"م",2,0],["جيش إذا صال صال النصر يتبعه","كالريح إن شدّ أو كالموج إن هجما",30,"م",2,0],["جِئنا بِكُم مِن زُهَيراتٍ وَمِن سَبَإٍ","وَلِلجَوامِعِ في أَعناقِكُم أَثَرُ",31,"ر",1,0],["جِئني بِمِثلِ بَني بَدرٍ لِقَومِهِمُ","أَو مِثلِ أُسرَةِ مَنظورِ بنِ سَيّارِ",32,"ر",1,0],["جِئني بِخالِكَ يا فَرَزدَقُ وَاِعلَمَن","أَن لَيسَ خالُكَ بالِغاً أَخوالي",33,"ي",1,0],["جِئناهُ وَالشَمسُ قُبَيلَ المَغرِبِ","تَختالُ في ثَوبِ الأَصيلِ المُذهَبِ",34,"ب",1,0],["جِئتُ بِبازٍ حَسَنٍ مُبَهرَجِ","دونَ العُقابِ وَفُوَيقَ الزُمَّجِ",34,"ج",1,0],["جِيادُ الخُيولِ بِأَجنابِهِم","وَقَد جَلَّلوها ثِخانَ الأَدَم",35,"م",1,0],["جَيشٌ عُيَينَةُ وَاِبنُ حَربٍ فيهِمِ","مُتَخَمِّطينَ بِحَلبَةِ الأَحزابِ",36,"ب",1,0],["جيرانُهُ الأَدنَونَ حَولَ بُيوتِهِ","غَدَروا وَرَبِّ البَيتِ ذي الأَستارِ",37,"ر",1,0],["جيوش حسنك يا ذا الحسن متَّفقه","لها من السقم عرضٌ والبكا نفقه",38,"ق",2,1],["جيفٌ أنتنت فأضحتْ على اللُّج","جَة والدُّرُّ تحتها في حجابِ",39,"ب",1,0],["جئتُ والدولةُ السعيدةُ خلفي","رأسُها في مَقَادتي مَجْنوبُ",40,"ب",1,0],["جياعاً نِياعاً ذوي فاقة","يُباع لهم بالبتات السلاحُ",41,"ح",1,0],["جيئوا به وكأن قدْ","جاء النبيذ يطير",42,"ر",1,0],["جئتَ بالدرِّ في عِيالة نَغْلي","ن وليسا للشيخ بل للعجوز",43,"ز",1,0],["جيف تطفو على بحر الغنى","حين لا تطفو خبيئات الصدف",44,"ف",1,0],["جِئتُ لا أَعلَمُ مِن أَين وَلَكِنّي أَتَيتُ","وَلَقَد أَبصَرتُ قُدّامي طَريقاً فَمَشَيتُ",45,"ت",1,1],["جِياعٌ كُلَّما صاحوا وَناحوا","تَوَهَّمَ أَنَّ بَعضَ الأَرضِ مادا",46,"د",2,0],["جِئتُ في حاجَةٍ فَعَزَّت مَراماً","وَوَدِدنا قَضاءَها وَاِشتَهَينا",47,"ن",2,0],["جِئتُ طَريقَينِ فَما","وَجَدتُ لي طَريقا",48,"ق",2,0],["جيدُهُ تَحْتَ فَرْعِهِ","بَرْقُ غَيْمٍ تَألَّقا",49,"ق",2,0],["جئننا بالشعور والحداق","وقسمن الحظوظ في العشاق",50,"ق",1,1],["جيءَ بِشَيخٍ عَلويٍّ زاهِدٍ","فَقَبِل البَيعة بَعدَما أَبى",51,"ا",1,0],["جِئنَهُ في مَعاصِمٍ وَنُحورٍ","فَكَسا مِعصَماً وَآخَرَ عَرّى",52,"ر",2,0],["جِئنَنا بِالشُعورِ وَالأَحداقِ","وَقَسَمنَ الحُظوظَ في العُشّاقِ",53,"ق",1,1],["جِئنا إِلى الصَبرِ نَدعوهُ كَعادَتِنا","في النائِباتِ فَلَم يَأخُذ بِأَيدينا",54,"ن",2,0],["جِئتَ الشُعوبَ المُحسِنينَ بِشافِعٍ","مِن مِثلِ مُتقَنِ فَنِّهِم وَلُبابِهِ",55,"ب",2,0],["جيءَ بِالمالِكِ العَزيزِ ذَليلاً","لَم تُزَلزِل فُؤادَهُ البَأساءُ",56,"ا",2,0],["جِيرانُها وَهُمُ شَرُّ الجِوارِ لَها","وَصَحبُها وَهُمُ شَرُّ الأَصاحيبِ",57,"ب",1,0],["جِيادٌ تَعجِزُ الأَرسانُ عَنها","وَفُرسانٌ تَضيقُ بِها الدِيارُ",58,"ر",1,0],["جَيشٌ كَأَنَّكَ في أَرضٍ تُطاوِلُهُ","فَالأَرضُ لا أُمَمٌ وَالجَيشُ لا أَمَمُ",59,"م",1,0],["جئناهُمُ والسماءُ مُصحِيَةٌ","والأرضُ خضراءُ نبتُها القُضْبُ",60,"ب",1,0],["جُيوشٌ مَلَأنَ الأَرضَ حَتّى تَرَكنَها","وَما في أَقاصيها مَفَرُّ لِهارِبِ",61,"ب",1,0],["جِئنا نُحَيّي مِن أُثَيلَةَ مَنزِلاً","جُدُداً مَعالِمُهُ بِذي الأَنصابِ",62,"ب",1,0],["جِئتَها وَالسَحابُ فيها مُغِذٌّ","فَأَرَيتَ السَحابَ كَيفَ يَصوبُ",63,"ب",1,0],["جِئناهُ إِذ لا التُربُ في أَفيائِهِ","يَبَسٌ وَلا بابُ العَطاءِ بِمُرتَجِ",64,"ج",1,0],["جَيشٌ يُجَهِّزُهُ لِأَر","ضِ الكُفرِ أَو ثَغرٌ يَسُدُّه",65,"د",2,0],["جِئناكَ نَحمِلُ أَلفاظاً مُدَبَّجَةً","كَأَنَّما وَشيُها مِن يُمنَةِ اليَمَنِ",66,"ن",1,0],["جَيشٌ يَسيرُ إِلَيهِ مُلتَمِسَ القِرى","غَصباً بِكُلِّ مُسَوَّمٍ جَرّارِ",67,"ر",1,0],["جياعا نصف الزيتو","ن لو أمكن والجبنا",68,"ن",2,0],["جيشٌ إذا لاقَى العدُوُّ صُدورَه","لم تَلْقَ للأعجازِ منه لُحُوقا",69,"ق",2,0],["جيوبٌ مِنَ الوَشْيِ مَزرُورَةٌ","يلوحُ عليها بياضُ النُّحورِ",70,"ر",1,0],["جِئناكَ يا مَلِكَ الدُنيا وَواحِدَها","نَؤُمُّ بِالدُرِّ نُهديهِ إِلى اللُجَجِ",71,"ج",1,0],["جيرَةٌ بِحَيِّهِمُ","لَيسَ يُحفَظُ الحَسَبُ",72,"ب",1,0],["جيلاً من النشء القوي إذا مشوا","رفعوا الرؤوس بعزة وعنادِ",73,"د",1,0],["جئتُ أشكو لكِ روحي وجواها","وردت ظمأى وعادت بصدَاها",74,"ا",3,1],["جئتنِي في الخريفِ والروضُ عارٍ","فكسوتَ الرُّبَى عذَارَى البراعم",75,"م",1,0],["جيدَت بِداني الأَكنافِ ساحَتُها","نائي المَدى واكِفِ الجَدى سَرِبِه",76,"ب",2,0],["جِيادٌ وَقَد سَدَّ الغُبارُ فُروجَها","تَروحُ إِلى طَعنِ القَبائِلِ أَو تَغدو",77,"د",2,0],["جئنا إلى البابِ بانتهاز","ثمَّ رجعنا بِلا جواز",78,"ز",1,1],["جئنا إلى البابِ باحتفالٍ","ثمَّ رجعنا بسوءِ حالِ",79,"ل",1,1],["جِئنا مغانيكِ نُسَّاكاً يُبرِّحهمْ","لُقيا حبيبٍ أقاموا حُبَّه دينا",80,"ن",2,0],["جِئتُم إِلَينا فَباتَت مِصرُ راجِفَةً","مِمّا حَمَلتُم وَكانَ النيلُ يَحتَرِقُ",81,"ق",1,0],["جَيشٌ يَسيرُ بِهِ النَبِيّ