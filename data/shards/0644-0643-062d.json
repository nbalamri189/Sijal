{"poems":[[51,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[97,"هل في العصيب المدلهم","https://www.aldiwan.net/poem24783.html","مجزوء الكامل"],[102,"كيف أغويتني وأمعنت صدا","https://www.aldiwan.net/poem33127.html","الخفيف"],[75,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[106,"في زيارة الواحات","https://www.poetsgate.com/ViewPoem.aspx?id=179379",""],[126,"وحباك الإله ملكا وإنصالا","https://www.aldiwan.net/poem50531.html","الخفيف"],[133,"بالأمس كان خطيبنا بالنادي","https://www.aldiwan.net/poem49174.html","الكامل"],[140,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[167,"ألقت إليك مقادها الأيام","https://www.aldiwan.net/poem1678.html",""],[456,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[456,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[573,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"]],"verses":[["لك حظّ أراه يُعْنِقُ في السَّيْ","رِ فساير أخاك تُعْنِقْ حَرونه",0,"ن",2,0],["لك حسن نوّار الخمي","لة طلَّ صبحاً فابتسم",1,"م",1,0],["لَكَ حَمّلتها رِسالة شَوقٍ","وَعِتاب أَظنها لا تَؤدى",2,"د",2,0],["لك حَمدُنا لا أنّه لك مَفْخَرٌ","ما قَدْرُكَ المنثور والموزون",3,"ن",1,0],["لكَ حُسْنُهُ مُتَقَلَّداً وبَهاؤهُ","مُتَنَكَّباً ومضاؤهُ مَسْلُولا",4,"ل",2,0],["لكَ حاضرٌ زَاهٍ، سيأتي بعدهُ","مستقبلٌ أزْهَى على يَدِ أنور",5,"ر",1,0],["لكَ حِلمٌ تخفُّ منهُ الرواسِي","أنت من فاقَ في الرجالِ الرجالاَ",6,"ل",2,0],["لك حكمة يا ربِ تعلم سرها","دقتْ على النُّظار والنُّقادِ",7,"د",1,0],["لك حيثما سمت الركائب لفتةٌ","أتُرى البدورُ بكل وادٍ تَطلعُ",8,"ع",1,0],["لَكَ حينَ يَعتَكِرُ الظَلامُ صَنائِعٌ","تَغشى الأَرامِلَ وَالعُيونُ نِيامُ",9,"م",1,0],["لك حبي حزته أكرمته","عن عقيم اليدِ مولود العِللْ",10,"ل",1,0],["لك حلمُه وعلى عَدُو","وِك طيشُهُ وتنزُّقُهْ",11,"ق",2,0],["لَكَ حَجِّي وهِجْرتي ولمنْ في","كَ ثنائي ومدْحَتي ودُعائِي",12,"ي",1,0]]}