iwan/poem/131253",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131240",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135225","السريع"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135352","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103006","الكامل"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139405",""],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93759","الرمل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83138","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141677","الكامل"],[4679,"لقد ازدهى بفعالك الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=142779",""],[4691,"منعتني ذكر اسمها في قصيدي","https://www.poetsgate.com/ViewPoem.aspx?id=123537",""],[4728,"آه من قلبٍ على الضيق محدي","https://www.poetsgate.com/ViewPoem.aspx?id=176989",""],[4960,"تجليات عاشق في يوم الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=210423",""],[585,"هي لفتةٌ أوحت إلي الموعدا","https://www.poetsgate.com/ViewPoem.aspx?id=161932",""],[5072,"خريف الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=53931",""],[5186,"ما لواه الكلال والتهويم","https://www.poetsgate.com/ViewPoem.aspx?id=156453",""],[5302,"موطن العز","https://www.poetsgate.com/ViewPoem.aspx?id=201148",""],[5431,"اغضب وزمجر","https://www.poetsgate.com/ViewPoem.aspx?id=182966",""],[5431,"ليس حبا من كان رهن انتهاء","https://www.poetsgate.com/ViewPoem.aspx?id=196612",""],[5431,"دجلة الحب-للعراق الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=198264",""],[5499,"ماشفت ابردي","https://www.poetsgate.com/ViewPoem.aspx?id=177626",""],[5694,"الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=132098",""],[5792,"ابركها من ساعه","https://www.poetsgate.com/ViewPoem.aspx?id=180342",""],[5848,"اطقها فالوجه","https://www.poetsgate.com/ViewPoem.aspx?id=51948",""],[5848,"تصطفل يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=50599",""],[5956,"لم تقع عيني على أجمل منكِ","https://www.poetsgate.com/ViewPoem.aspx?id=182269",""],[5956,"احفظ له أكباده يا خالقي","https://www.poetsgate.com/ViewPoem.aspx?id=194229",""],[463,"سلكَ الخيالُ بحاجرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60161&r=&rc=217",""]],"verses":[["لك حظّ أراه يُعْنِقُ في السَّيْ","رِ فساير أخاك تُعْنِقْ حَرونه",0,"ن",2,0],["لك حسن نوّار الخمي","لة طلَّ صبحاً فابتسم",1,"م",1,0],["لَكَ حَمّلتها رِسالة شَوقٍ","وَعِتاب أَظنها لا تَؤدى",2,"د",2,0],["لك حَمدُنا لا أنّه لك مَفْخَرٌ","ما قَدْرُكَ المنثور والموزون",3,"ن",1,0],["لكَ حُسْنُهُ مُتَقَلَّداً وبَهاؤهُ","مُتَنَكَّباً ومضاؤهُ مَسْلُولا",4,"ل",2,0],["لكَ حاضرٌ زَاهٍ، سيأتي بعدهُ","مستقبلٌ أزْهَى على يَدِ أنور",5,"ر",1,0],["لك حبّي ومنك حبّي فهل","يعطي من السائل الكريم المنيل",6,"ل",1,0],["لك حبّي فهل لفقري إذا","أهدى إلى كنزك الغنيّ قبول",6,"ل",1,0],["لكَ حِلمٌ تخفُّ منهُ الرواسِي","أنت من فاقَ في الرجالِ الرجالاَ",7,"ل",2,0],["لك حكمة يا ربِ تعلم سرها","دقتْ على النُّظار والنُّقادِ",8,"د",1,0],["لك حيثما سمت الركائب لفتةٌ","أتُرى البدورُ بكل وادٍ تَطلعُ",9,"ع",1,0],["لَكَ حينَ يَعتَكِرُ الظَلامُ صَنائِعٌ","تَغشى الأَرامِلَ وَالعُيونُ نِيامُ",10,"م",1,0],["لك حبي حزته أكرمته","عن عقيم اليدِ مولود العِللْ",11,"ل",1,0],["لك حلمُه وعلى عَدُو","وِك طيشُهُ وتنزُّقُهْ",12,"ق",2,0],["لَكَ حَجِّي وهِجْرتي ولمنْ في","كَ ثنائي ومدْحَتي ودُعائِي",13,"ي",1,0],["لك حق عندي وفي محنة العل","لة أني لا أستطيع قضاءَهْ",14,"ه",1,0],["لكَ حرٌّ من النظامِ رقيقٌ","ورقيق النظام ما كانَ حرَّا",15,"ر",2,0],["لك حوز الرهان في كل مجرى","ان اعدت بين الملا الحلبات",16,"ت",1,0],["لَكَ حلم إِذا الحلوم استخفت","يمسك الأَرض ثقله إِن تَزولا",17,"ل",2,0],["لك حيث تمضي من بنيها عصبة","هم في يمينك يا حبيب حسام",18,"م",1,0],["لك حين تبدو من جمالك هيبةً","ومن الملاحة حين تقبل موكب",19,"ب",1,0],["لَكَ حَتّى الضَبُّ يَشهَد","وَشَقِيُّ الحَظِّ يَجحَر",20,"ر",1,0],["لَكَ حكم الأُمور إِرثاً قَديماً","وَحَديثاً وَما أَنا بِالكَذوب",21,"ب",1,0],["لك حق الثنا بحمد وشكر","من لآلي المنثور والمنظوم",22,"م",1,0],["لكَ حكمَةُ الوهّابِ سابقُ حُكْمِها","نادَى بخيْلِكَ أن تجُولَ مَجالَها",23,"ل",3,0],["لك حسن وصف في بديع شمائل","قد حار فيها العقل حين تمعنا",24,"ن",2,0],["لك حسن منزه عن مثيل","كل من رام وصف حسنك قاصر",25,"ر",1,0],["لك حرب الكلام فاهجم وغامر","واملأ الأرض عدةً وعديدا",26,"د",2,0],["لك حسنٌ أراهُ يطلب نداً","انما يطلب العجيب العجيبا",27,"ب",2,0],["لك حبي عن سواك","وشعوري وسماتي",28,"ت",2,0],["لك حمدٌ لا ينتهي لا يُحَدُّ","لك شكرٌ لم يُحصِ عبدٌ عريفُ",29,"ف",1,0],["لك حكمة قام الوجود بلطفها","والروح موجبة قيام الهيكل",30,"ل",1,0],["لك حتى ضرج السي","ف له خداً نضيرا",31,"ر",2,0],["لَكَ حُب ضمنته في الحَشا","بِسُطور الوَحي آيات عِجاب",32,"ب",1,0],["لَكِ حَبّاتُ القُلوبِ اِنتَظَمَت","طَوِّقي جيدَك مِنها وَالجَبينا",33,"ن",2,0],["لك حيث شئت عناية صمدية","ترعى حماك ونصر ربّ قادر",34,"ر",1,0],["لك حكمة في المعضلات سمت","وشهامة بالحزم تقترنُ",35,"ن",1,0],["لكِ حزني يا أمّةً نهشتها","بالسُّعارِ الكلابُ ثمَّ الذئاب ُ",36,"ب",1,0],["لك حسامٍ مضربه غصنٍ ندي","دون ربعك ما تفرّق به عدا",37,"د",2,0],["لكِ حُبّيْ وصبوَتيْ وافتِتانيْ","لكِ عمريْ حبيبتيْ (مُرِتانِ)",38,"ن",1,1],["لك حدةٌ في الطبع أحسب أنها","شرر تطاير من ذكائك موقدا",39,"د",2,0],["لك حائط ٌ فاضرب ْ به رأس َ الهوى","فالحب ُّ أجفان ٌ وحظُّك َ عاقد ُ",40,"د",1,0],["لك حمدي على سعادة بيت","خيره من ندى عطاك عميم",41,"م",1,0],["لك حبي والعذر منك إذا ما","قلت ماجاش في الفؤاد اختصارا",42,"ر",2,0],["لك حبنا الأبدي في أحشائنا","لك عشقنا الصوفي والوقّادُ",43,"د",1,0],["لك حبي منزّها عن زوالٍ","ليس حبا ما كان رهن انتهاء",44,"ا",2,0],["لك حجّت قبائل الوقت عطشى","واستفاضت قلوبها بالنماء",45,"ا",2,0],["لك حق مني والعذر احيان ، ماكان الحلول","وش عاد باقي في يدي ماغير هالحظ الردي",46,"د",2,0],["لك حق ياخذك تيار الدلع والغرور","الشعر عشب المشاعر وإنبثاق الشعور",47,"ر",1,0],["لك حب صبح وفي المسا حب ثاني","والله يسعد لي صباحك وممساك",48,"ك",1,0],["لك حق تزعل كان جيتك في خمال","وازعل عليك ان قمت في حقي تعيل",49,"ل",1,0],["لك حبيبٍ من يحبه يموت ولا ينام","إسهره يا قلب في غيبة اخوان وصديق",50,"ق",1,0],["لك َحُسْنٌ تتمنّاه بدورٌ","وتُجيد الشمسُ تقبيلَ يديكِ",51,"ك",1,0],["لك حُسْنُ يوسُفَ في بطولةِ ناصرٍ","في حكمة الطهطاو* تعمل جاهدا",52,"د",2,0],["لكَ حلمهُ وعلى عد","وّكَ طيشهُ وتنزُّقهْ",53,"ق",2,0]]}