لظباء","https://www.poetsgate.com/ViewPoem.aspx?id=32824",""],[64,"وأَطْلُبُ منك الفضل من غير رغبةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=3134",""],[28,"ألا طالما رسفت في قيد مالك","https://www.poetsgate.com/ViewPoem.aspx?id=22076",""],[88,"لا تشك للناس يوماً عسرة الحال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19556&r=&rc=59",""],[85,"خُذوا القمَّة َ علماً وبيانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9587&r=&rc=77",""],[85,"تاجَ البلادِ، تحية ٌ وسلامُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9638&r=&rc=128",""],[91,"غرامية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67836&r=&rc=120",""],[71,"سلوا صهواتِ الخيلِ يومَ الوغى عنَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=28021&r=&rc=8",""]],"verses":[["وَأَطيَبُ مِن داري بِلاداً أَجوبُها","إِلى العِزِّ جَوبي بِالبَنانِ رِدائِيا",0,"ي",2,0],["وَأُطلِقُ عُقلَها بِرُبىً تَراها","مِنَ الأَنواءِ ضاحِكَةَ الوُشومِ",1,"م",1,0],["وَأَطلُبُها بِالراقِصاتِ كَأَنَّما","أُثَوِّرُ مِنها رَبرَباً وَرِئالا",2,"ل",2,0],["وَأَطلَعتُمونِيَ فَوقَ الرَجاءِ","بَعيداً وَفَوقَ مَنالِ اللَيالي",3,"ل",2,0],["وَأَطلَقتُمُ الحَدَّ مِن مَضرَبي","وَحادَثتُمُ قائِمي بِالصِقالِ",3,"ل",1,0],["واطٍ بِجَفوَتِهِ أَعقابَ خُلَّتِهِ","يَوماً وَدودٌ وَيَوماً مَلَّةٌ طَرِفُ",4,"ف",1,0],["وَأَطلُبُ مِنكَ ما لا عَيبَ فيهِ","وَأَينَ المَجدُ إِلّا في اِصطِناعي",5,"ع",2,0],["وَاِطلُب عَلى أَيّامِهِ وَجِيادُهُ","حَسرى يَرِدنَ عَلى الطِعانِ وَظُلَّعُ",6,"ع",1,0],["وَأَطرَقَ شَيطانُ الغَوايَةِ مِنهُمُ","فَلَم يَبقَ مِن نَعّابَةِ الغَيِّ نابِسُ",7,"س",1,0],["وَأَطلَسَ مَنّاني الكِذابَ وَقالَ لي","لِيَهنِكَ إِحدى اللَيلَتَينِ لَباكِرُ",8,"ر",1,0],["وَأَطرُدُ الطَرفَ عَلى","آثارِهِم ما اِنطَرَدا",9,"د",2,0],["وَأَطلالاً يُطَلُّ الدَمعُ فيها","إِذا بَدَتِ الحَواضِرُ وَالبَوادي",10,"د",2,0],["وَأَطلُبُ في الدُنيا العُلى وَرَكائِبي","مُقَلقَلَةٌ ما بَينَ غَورٍ إِلى نَجدِ",11,"د",1,0],["وَأُطرِقُ وَالعَينانِ يومِضُ لَحظُها","إِلَيكِ وَما بَينَ الضُلوعِ وَجيبُ",12,"ب",1,0],["وَأَطلَقَ مِن وَجدٍ حُباها وَلَم تَكُن","لِهاشِمَ لَولاهُ العُقولُ العَوازِبُ",13,"ب",1,0],["وَأَطمَعَني في العِزِّ أَنّي مُغامِرٌ","جَريٌ عَلى الأَعداءِ وَالقَلبُ قُلَّبُ",14,"ب",1,0],["وَأَطَرتُ تَحتَ السَيفِ كُلَّ عَشيَّةٍ","عُرقوبَ مُغتَبِطٍ يَطولُ رُغاؤُهُ",15,"ا",3,0],["وَأَطلُبُ غايَةً إِن طَوَّحَت بي","أَصابَت بي الحِمامَ أَوِ العَلاءَ",16,"ا",2,0],["وَأَطْلُبُ أَمْراً حالَ بَيْني وَبَيْنَهُ","زَمانٌ نَباني وَامْتَعَضْتُ مِنَ الشّكْوى",17,"و",2,0],["وَاطْلُبْ مَداهُمْ إِنَّهُمْ نَفَرٌ","عَاشُوا بِذِكْرِهِمُ وَقَدْ هَلَكُوا",18,"ك",3,0],["وأطْمَعْتَ في أعْراضِنا كُلَّ كاشِحٍ","يُجرِّعُهُ الغَيْظُ السِّمامَ المُثمَّلا",19,"ل",2,0],["وأطْوي على الهَمِّ النّزيعِ جَوانِحي","وإنْ أقلَقَ الخَطْبُ المُلِمُّ وأرْمَضا",20,"ض",2,0],["وَأَطعَنُ في الهَيجا إِذا الخَيلُ صَدَّه","غَداةَ الصَباحِ السَمهَرِيُّ المُقَصَّدُ",21,"د",1,0],["وَأَطعَنُ بِالقَنا حَتّى يَراني","عَدوّي كَالشَرارَةِ مِن بَعيدِ",22,"د",1,0],["وَأَطرافُ القَنا الخَطِّيِّ نَقلي","وَرَيحاني إِذا المِضمارُ ضاقا",23,"ق",2,0],["وَأَطمَعُ مِن دَهري بِما لا أَنالُهُ","وَأَلزَمُ مِنهُ ذُلَّ مَن لَيسَ يَرحُمُ",24,"م",1,0],["وَأَطفَءُ لَوعَةً كانَت بِقَلبي","أَغَصَّتني حَرارَتُها بَريقي",25,"ق",2,0],["وأطْنَبَ فيكَ المادِحونَ وأغْرَقوا","فلمْ يُجْدِ إطْنابٌ منْكَ ولمْ يغْنِ إغْراقُ",26,"ق",1,0],["وأطاعَتْ بأبي العاصِي المُنَى","فلَكَمْ بابٍ الى الأُنْسِ شرَعْ",27,"ع",1,0],["وأُطْفِئَ في تلْكَ المَوارِدِ غُلّتي","وأُحْسبَ قُرْباً مُهْجَةً شكَتِ البُعْدا",28,"د",2,0],["وَأَطْلَعَ سَعْدٌ مِنْكَ بَدْرَ خَلاَفِةٍ","تُنِيرُ بِهِ الدُّنْيَا وَتُجْلَى الْغَيَاهِبُ",29,"ب",1,0],["وَأَطفَأتِ نِبراساً وَأَشعَلتِ أَنفُساً","عَلى جَمَراتِ الحُزنِ مُنطَوِياتِ",30,"ت",1,0],["وَأَطفَأَ وارِفُ تِلكَ الظِلالِ","سَعيرَ الهَجيرِ وَحَرَّ الجَوى",31,"ا",1,0],["وأُطفِئَت فِتَنةٌ لولاكَ لاستَعَرَت","بين القَبائِل وانسابَت أفاعيها",32,"ي",3,0],["وَأَطمَعهُم فينا غُرورٌ فَأَرقَلوا","إِلَينا سِراعاً بِالجِيادِ وَأَرقَلنا",33,"ن",2,0],["وَأَطلَعَ فيها لِلأَزاهيرِ أَنجُما","فَكَم رَفَلَت فيها الخَرائِدُ كَالدُمى",34,"م",2,0],["وَأَطِل إِلى شَدوِ القِيانِ إِصاخَةً","وَتَلَقَّ مُترَعَةَ الكُؤوسِ دِراكا",35,"ك",2,0],["وَأَطنابَهُ أَشطانُ خوصٍ نَجائِبٍ","وَصَهوَتُهُ مِن أَتحَمِيٍّ مُشَرعَبِ",36,"ب",1,0],["وأطلقت وفرتها في الهواء","أمينة تنهب عرض الخلاء",37,"ا",2,0],["وَأَطْرَبَ العَصْرَ مِنْ مَنَابِرِهَا","بَلْ كُلَّ عَصْرٍ يَجِيءُ مُنْشِدُهَا",38,"د",3,0],["وأطلعت من جزل الوقود هوادجاً","تُذكِّرُ يوم النّفر من كان ساهيا",39,"ي",2,0],["وأطلتُ لكنِّي أطبتُ وعادتي","أُلْفَى مُطيباً في المديح مُطيلا",40,"ل",2,0],["وأطيق في طول المقام تحكُّماً","منكم ولست لبَيْنكم بمطيق",41,"ق",1,0],["وأطلع في سماء الشرق شمساً","تُفيض عليه أنوار الترجّي",42,"ج",2,0],["واطمأنّت له القلوب بفَوْز","يغتدي في فم الزمان ابتساما",43,"م",2,0],["وأطلب على عزّه بَيْض الأنوق ولا","تطلب لعمرك أن تَحظى بِمفضال",44,"ل",1,0],["وأطّرح المجد غيرَ طارفه","وأجتنب الفخر غير مكتَسَبه",45,"ب",2,0],["وأطلف جَورْ الدهر نرى به","تدلّل معشوق وذِلّة عاشق",46,"ق",1,0],["وأطلالِ علم لا تزال شواخصاً","تُذكر بالعهد القديم وتشهد",47,"د",1,0],["وأطرقتُ نحو الأرض أطلب عفوها","وما أنا بالجاني ولا بالمتيَّم",48,"م",1,0],["وأطلق أذهان الورى من قيودها","فطارت بأفكار على المجد حُوَّم",49,"م",1,0],["وأطلنا عن الكلام سكوتاً","معرباً عن نشيجنا المهموس",50,"س",1,0],["وأطلقنا المدائح والمرائي","بإنشاد لهنّ وبارتجاز",51,"ز",1,0],["وَأَطفَأتَ نيرانَ النِفاقِ وَأَهلِهِ","وَقَد حاوَلوا في فِتنَةٍ أَن تُسَعَّرا",52,"ر",2,0],["وَأَطعَنَ حينَ تَختَلِفُ العَوالي","بِمَأزولٍ إِذا ما النَقعُ ثارا",53,"ر",2,0],["وَأَطفَأتَ نيرانَ العِراقِ وَقَد عَلا","لَهُنَّ دُخانٌ ساطِعٌ وَحَريقُ",54,"ق",1,0],["وَأَطلَعتُ القَصائِدَ طَودَ سَلمى","وَصَدَّعَ صاحِبَي شُعَبى اِنتِقامي",55,"م",2,0],["واطلُبُ الشَّأوَ من نوازعِ اللَّ","هوِ وألقى الصِبا فَنَصطَحِبُ",56,"ب",1,0],["وَأطنَابُ القِبَابِ مُمَدَّدات","بِخَيفِ مِنىً على المُستأذِينَا",57,"ن",2,0],["وَأَطيَبَ في المَغَارِس نَابِتَات","وأَفضَلَ في التَّقَايُسِ لِلِّدِينَا",57,"ن",2,0],["وَأَطلَقَها فَوضى عَلى مَرجِ قِلِّزٍ","حَوادِرَ في أَشباحِهِنَّ المَحاذِرُ",58,"ر",1,0],["وَأَطلُبُ إِبقاءً عَلى الوُدِّ أَرضَهُ","وَذِكري مُنىً في غَيرِها وَطِلابُ",59,"ب",1,0],["وأطفئْ بهذا الكاسِ همِّي فإنَّني","أرى السرج تطفا وهي تطفي سراجها",60,"ج",3,0],["واطرح بعيشك أثقالَ الملام فما","حملت وزْري ولا كلفت إصلاحي",61,"ح",2,0],["وأطولَ أشجاني بطرفٍ فاترٍ","ترك الفؤادَ بناره متوقّدا",62,"د",2,0],["وأطلق فيه ألفاظاً تسامت","على ألفاظ رهن المحسنين",63,"ن",1,0],["وَأَطيبُ الحُبِّ ما نَمَّ الحَديثُ بِهِ","كَالنارِ لا تَأتِ نَفعاً وَهيَ في الحَجَرِ",64,"ر",1,0],["وَأَطلُبُ مِنكَ الفَضلَ مِن غَيرِ رَغبَةٍ","فَلَم أَرَ قَلبي زاهِداً وَهوَ راغِبُ",65,"ب",1,0],["وأطلّ النبي فيضا من الرحمة","يروي الظماء تلو الظماء",66,"ا",2,0],["وأطال الإلهُ عمرك في عز","زٍ يسوءُ الجميعَ من أعدائِكْ",67,"ك",1,0],["واطمأن الفِراش تحتي وقد كا","ن شديدَ النُّبوِّ والإقضاض",68,"ض",1,0],["وأطربَ فيه الشعرُ حتى كأنما","تجاوبَ قيناتٌ به وبرابط",69,"ط",1,0],["وأطلِقْ ما تَهُمُّ به عساهُ","كفافي أيها الرجلُ النبيلُ",70,"ل",1,0],["وأطاعه حرفُ الروي فلم يجىءْ","فيه بمفعولٍ يشوبُ فعيلا",71,"ل",2,0],["وأطِبْ وأكثر إن فعلتَ فلم تزل","تهبُ الجسيمَ فلا تقول جسيمُ",72,"م",1,0],["وأطيلُ في حاجي عليك تسحُّبي","فكأنني فيما ملكتَ سهيمُ",72,"م",1,0],["وأطاعتْ له الروايةُ والصَّنْ","عةُ وانقاد كيف شاء الكلامُ",73,"م",1,0],["واطْرَحِ الهمَّ عنك وافرح بنصحي","فرَّجَ الله نفسك المهمومه",74,"م",2,0],["واطبُخِ الدِّباء والحِي","راب لوناً بمُتونه",75,"ن",2,0],["واطبُخَنْ لي اللبنَ الرا","ئب لوناً بلَبُونه",75,"ن",2,0],["وَأَطفِىء وَلا توقِد وَلا تَكُ مِحضَأً","لِنارِ العُداةِ أَن تَطيرَ شَكاتُها",76,"ت",3,0],["وَأَطعَمَ أَشهُرَ الشَهباءِ حَتّى","تَضَرَّجَ عَن مَنابِتِهِ الحَسارُ",77,"ر",1,0],["وَأَطفَأتَ عَنّي نارَ نُعمانَ بَعدَما","أَغَذَّ لِأَمرٍ عاجِزٍ وَتَجَرَّدا",78,"د",2,0],["وَأَطرَقَ عَنكُم حَيَّةً لَو تَمَكَّنَت","مِنَ الأَرضِ كانَت حَيَّةً بِغَليلِ",79,"ل",1,0],["وَأَطفَأنا شِهابَهُمُ جَميعاً","وَشُبَّ شِهابُ تَغلِبَ فَاِستَنارا",80,"ر",2,0],["وَأَطَلَّ مِن قَلبِ البَخيلِ سَماحَةً","وَشَجاعَةً في السِلمِ وَالهَيجاءِ",81,"ا",2,0],["وَأَطارَ عَن جَفني الكَرى وَأَطارَني","عَن مَرقَدي مَشيُ الهُمومِ بِمَرقَدي",82,"د",2,0],["وَأَطَعتِ بي حَتّى العِدى","وَضَنِنتِ حَتّى بِاليَسيرِ",83,"ر",1,0],["وَأَطرُقُ الرَوضَةَ عِندَ الضُحى","كَيما أُناجي البُلبُلَ الشاعِرا",84,"ر",2,0],["وَأَطلَقَ البومَ في الفَضاءِ","زَعمُ الوَرى أَنَّهُ دَميمُ",85,"م",1,0],["وَأُطلِقَتِ الأَقلامُ بَعدَ اِعتِقالِها","فَأَسمَعَتِ الأَكوانَ سَجعَ الحَمائِمِ",86,"م",1,0],["وَأُطِلُّ مِن أَهدابِها السَكرى عَلى","ظِلٍّ وَأَنداءٍ وَزَهرٍ نامِ",87,"م",1,0],["وَأَطمَعُ حينَ أَعطِفُهُ عَساهُ","يَلينُ لِأَنَّهُ غُصنٌ رَطيبُ",88,"ب",1,0],["وَاَطوي عَلى الخُمصِ الحَوايا كَما اِنطَوَت","خُيوطَةُ مارِيٍّ تُغارُ وَتُفتَلُ",89,"ل",1,0],["وأَطَلَّتْ بوجهِها الباسِمِ الحلْ","وِ على خدِّه وقالتُ تَلُومُهْ",90,"م",2,0],["وأَطَلَّ الصَّبَاحْ","مِنْ وراءِ القُرُونْ",91,"ن",1,0],["وأَطافَتْ بكَ الوُحوشُ وناشتْكَ","فلم تَضْطَرِبْ ولم تتألَّمْ",92,"م",1,0],["وأَطرقتُ أُصغي لهَمْسِ الأَسى","وقد غَشِيَ النفسَ هَمٌّ كَثيفْ",93,"ف",1,0],["وأطرقتُ أُصغي لقصفِ الرُّعودِ","وعزفِ الرّياحِ وَوَقْعِ المَطَرْ",94,"ر",1,0],["وَأطمَعتَني ثُمَّ أَيأستَني","وَيمنَعُني الودّ أَن أَحقِدا",95,"د",2,0],["واِطعَن بِأَطراف اليَرا","ع نُصرتَ في ثَغر المَحابِرْ",96,"ر",1,0],["وَأَطِعتِ فيَّ عَواذِلاً فَهَجَرتِني","وَعَصَيتُ فيكِ وَقَد جَهَدنَ عَواذِلي",97,"ي",1,0],["وأطلب من ناس يعادونني الرضى","وبين الرضى والحقد منهم مسافات",98,"ت",1,0],["وأطلق نفساً رأى أنها","متى علقت بالحياة تقيّد",99,"د",1,0],["وأطل له طربوشة","وامطط له أنفوشه",100,"ه",1,0],["واطيبُ من قرب الحبيب على رضى","مقامك في دار السعادة راضيا",101,"ي",2,0],["واطمأنت إلى الرقاع ولكن","لم تزدها الرقاع إلا رقاعة",102,"ه",1,0],["وَأَطهَرُ المُعاهدين ذِمَّه","وَأَكبرُ المُجاهِدين هِمه",103,"ه",1,0],["وَاطلُبوا الديكَ يُؤَذِّن","لِصَلاةِ الصُبحِ فينا",104,"ن",2,0],["وَاِطلُبِ الرِزقَ هُنا أَو هَهُنا","كَم مَعَ الجَهلِ يَسارٌ وَغِنى",105,"ن",2,0],["وَأَطالَ خوفو في مَواكِبِ عِزِّهِ","فَاِهتَزَّتِ الرَبَواتُ وَالآكامُ",106,"م",1,0],["وَأَطرَقَ بَينَهُما والِدٌ","أَخو تَرحَةٍ لَيلُهُ أَليَلُ",107,"ل",1,0],["وَاِطلُبوا بِالعَبقَرِيّاتِ المَدى","لَيسَ كُلُّ الخَيلِ يَشهَدنَ الرِهنا",108,"ن",2,0],["وَأَطهَرَ مِن ذَيلِها لَم يَلُمّ","مِنَ الناسِ ماشٍ وَلَم يَسحَبِ",109,"ب",1,0],["وَاِطلُبِ الخُلدَ وَرُمهُ مَنزِلاً","تَجِدِ الخُلدَ مِنَ التاريخِ بابا",110,"ب",2,0],["وَاِطلُبوا المَجدَ عَلى الأَرضِ فَإِن","هِيَ ضاقَت فَاِطلُبوهُ في السَماء",111,"ا",2,0],["وَاِطلُبوا العِلمَ لِذاتِ العِلمِ لا","لِشَهاداتٍ وَآرابٍ أُخَر",112,"ر",1,0],["وَأَطاعَتهُ في الإِلَهِ شُيوخٌ","خُشَّعٌ خُضَّعٌ لَهُ ضُعَفاءُ",113,"ا",2,0],["وَأَطعَنَ مَن مَسَّ خَطِّيَّةً","وَأَضرَبَ مَن بِحُسامٍ ضَرَب",114,"ب",1,0],["وَأَطاعَ الَّذي أَطاعَكَ وَالطا","عَةُ لَيسَت خَلائِقُ الآسادِ",115,"د",1,0],["وَأَطمَعَ عامِرَ البُقيا عَلَيها","وَنَزَّقَها اِحتِمالُكَ وَالوَقارُ",116,"ر",1,0],["وَأَطاعَتهُمُ الجُيوشُ وَهيبوا","فَكَلامُ الوَرى لَهُم كَالنُحازِ",117,"ز",1,0],["وَأَطاعَكَ الدَهرُ العَصِيُّ كَأَنَّهُ","عَبدٌ إِذا نادَيتَ لَبّى مُسرِعا",118,"ع",2,0],["وَإِطراقُ طَرفِ العَينِ لَيسَ بِنافِعٍ","إِذا كانَ طَرفُ القَلبِ لَيسَ بِمُطرِقِ",119,"ق",1,0],["وَأَطعَمتَني في نَيلِ مالا أَنالُهُ","بِما نِلتُ حَتّى صِرتُ أَطمَعُ في النَجمِ",120,"م",1,0],["وأُطلِعُ بيضاً كالشموسِ مُطِلَّةً","إذا طلعَت بيضاً وإن غرَبَت حُمرا",121,"ر",2,0],["واطرحه في دن الشراب ولا","تعجل عليه فإنه الحزمُ",122,"م",1,0],["واطبخ لتخرج دهننا من أرضه","فبصحنك الزيتون ثم سليطُ",123,"ط",1,0],["واطبخ دواءك في رفق فإنّ به","حسن التزاوج من أنثى ومن ذكرِ",124,"ر",1,0],["واطبخهما في الاله المستورة","فهي التي تعطي كمال الصورة",125,"ه",1,0],["وأطلعت أبخرة منهما","فابتدأت أفلاكها تصلبُ",126,"ب",1,0],["واطلَعْ عليه برايةٍ منصورةٍ","إِقبالُه بطلوعِها مقرونُ",127,"ن",1,0],["وأطلبُ منكم وافياً بذمامهِ","فأطلبُ شمساً في النجومِ العواتم",128,"م",1,0],["وأطوي على ما تعلمونَ جوانحي","وأُظهرُ للعُذَّالِ أنيَ سَالي",129,"ي",1,0],["وأطيبَ مغناها وأعذبَ ماءَها","وأفيحَها للطارقينَ رِحابَا",130,"ب",2,0],["وَأَطلَسَ مِلءِ العَينِ يَحمِلُ زَورَهُ","وَأَضلاعَهُ مِن جانِبَيهِ شَوى نَهدُ",131,"د",1,0],["وَأَطالَ اِبتِناءَهُ الحَسَنُ القَر","مُ وَعَبدُ العَزيزِ بِالتَشييدِ",132,"د",1,0],["وَأَطرَيتَ لي بَغدادَ إِطراءَ مادِحٍ","وَهَذي لَياليها فَكَيفَ شُهورُها",133,"ر",3,0],["وَأَطلَقَني النَضرُ اِبنُ عَمروٍ وَرُبَّما","بِكَفَّيهِ قَد فَكَّ الأَسيرَ المُكَبَّلا",134,"ل",2,0],["وَأَطلَسَ عَسّالٍ وَما كانَ صاحِباً","دَعَوتُ بِناري موهِناً فَأَتاني",135,"ن",2,1],["وأطلعَ لي كوكباً كالسُّها","قليلَ الضيِّاء سريعَ الأُفولِ",136,"ل",1,0],["وأطبقتُ إِشفاقاً عليه حِقاقَه","فصارَ وما أرخَصتُ من حَلْيِه غالي",137,"ل",2,0],["وأطلَقَ من عيونٍ في وجوهٍ","تروحُ لَعقل مُبصِرِها عِقالا",138,"ل",2,0],["وأطيبُ من رَوْحِ ريحِ الجِنانِ","خُطوطٌ تَرَوَّيْنَ من ريقِه",139,"ق",2,0],["وأطلعْتَ فيها نجومَ القَنا","فليست تَغورُ إذا النجمُ غارا",140,"ر",2,0],["وأطلقَ الشَّوقُ أَسْرَ عَبرَتِه","وهو أسيرُ الفؤادِ مُضطَهَدُه",141,"د",2,0],["واطَّردَتْ بِصَفْوِها مَوارِدُه","حتى ظَننَّا حَسَناً يُجاوِدُه",142,"د",2,0],["واطِّراحاً يَبيتُ يُخْلِقُ صَبْراً","بينَ أحشايَ أو يجدِّدُ وَجْدا",143,"د",2,0],["وَأَطِع أَباكَ بِكُلِّ ما أَوصى بِهِ","إِنَّ المُطيعَ أَباهُ لا يَتَضَعضَعُ",144,"ع",1,0],["وَاِطلُبهُمُ طَلَبَ المَريضِ شِفاءَهُ","وَدَعِ الكَذوبَ فَلَيسَ مِمَّن يُصحَبُ",145,"ب",1,0],["وَأَطمَعُ في المَحيا وَعَيشِيَ إِنَّما","مَسالِكُهُ مَوصولَةٌ بِمَماتِ",146,"ت",1,0],["وَأَطيَبُ أَوقاتي مِنَ الدَهرِ خَلوَةٌ","يَقَرَّ بِها قَلبي وَيَصفوا بِها ذِهني",147,"ن",2,1],["وَأَطيَبُ أَوقاتي مِنَ الدَهرِ لَيلَةٌ","تُريغُ القَوافي خاطِري وَأَريغُها",148,"غ",3,0],["وَأَطلَقتُ دَمعي في الخُدودِ تَأَسُّفاً","عَليكَ فَطَلَّقتُ الجُفونَ مِنَ الغُمضِ",149,"ض",1,0],["وَأَطلَقتِ دَمعي لَو طَفا حَرَّ زَفرَتي","فَقُلتُ وَقَد أَبدى الغَرامُ سَريرَتي",150,"ي",1,0],["وَأَطالَ الإِلَهُ عُمرَ مَراثي","كَ فَإِنّي فيها حَليفُ اِجتِهادِ",151,"د",1,0],["وَأَطلُبُ قُرباً مِن حِماكُم وَأَنتُمُ","إِلى ناظِري وَالقَلبُ في غايَةِ القُربِ",152,"ب",1,0],["وَأَطلَقَ الطَيرُ فيها سَجعَ مَنطِقَهِ","ما بَينَ مُختَلِفٍ مِنهُ وَمُتَّفِقِ",153,"ق",1,0],["وَأَطوادٌ حُلومُكَ أَم جِباكٌ","تَميدُ الراسِياتُ وَلا تَميدُ",154,"د",1,0],["واطلع كعهدك في الحياة فراشةً","غراءَ حائمةً على الأنوارِ",155,"ر",1,0],["وأَطِع فيها نَديمَيك بِما","حَكَما واعصِ عَلَيها عاذِلَيك",156,"ك",1,0],["وأطرَقْتُ لمّا حالتِ الحالُ حَيْرَةً","تَحَيّرَ منها عالمُ النفس في صدري",157,"ي",1,0],["وَاطُولَ شَوْقِي إِلَيْكَ يَا وَطَنُ","وَإِنْ عَرَتْنِي بِحُبِّكَ الْمِحَنُ",158,"ن",1,1],["وَأَطْرَبُ مِنْ دِيكٍ يَصِيحُ بِكُوَّةٍ","أَرَاكِيَّةٌ تَدْعُو هَدِيلاً عَلَى غُصْنِ",159,"ن",1,0],["وأطالَ ارتجاجَ ردفَيْه حتى","يُتْعباهُ والكسرُ في جفنيهِ",160,"ي",2,0],["وَأَطَعتِ فِيَّ عَواذِلاً حَمَّلنَكُم","وَعَصَيتُ فيكِ الأَهلَ وَالإِخوانا",161,"ن",2,0],["وَأَطَعتُ فيها الكاشِحينَ فَأَكثَروا","فيها المَقالَةَ شامِتاً وَمُعَرِّضا",162,"ض",2,0],["وَأَطيَبَ ذاكَ الجَنى رَوضَةً","وَرَشفَةَ ذاكَ اللِمى مَشرَبا",163,"ب",2,0],["وَأَطلَسَ مِلءُ جانِحَتَيهِ خَوفٌ","لِأَشوَسَ مِلءُ شَدقَيهِ سِلاحُ",164,"ح",1,1],["وَأَطلَسُ زَوّارٌ مَعَ اللَيلِ أَغبَشٌ","سَرى خَلفَ أَستارِ الدُجى يَتَنَكَّرُ",165,"ر",1,0],["وَأَطرَبَ سَجعُ الحَليِ مِن خَيزُرانَةٍ","تَميلُ بِها ريحُ الشَبيبَةِ وَالسُكرِ",166,"ر",1,0],["وَاِطلُع بِكُلِّ فَلاةِ أَرضٍ غُرَّةً","غَرّاءَ في وَجهِ الظَلامِ العابِسِ",167,"س",1,0],["وَأَطمَعَ في حَسمِ داءٍ دَهى","وَإِقشاعِ عارِضِ هَمٍّ أَطَل",168,"ل",1,0],["وَاطْوِ الجِواءَ إلى مَكانِكَ صَاعِداً","فَمداكَ حيثُ تُحلِّقُ العِقبانُ",169,"ن",1,0],["واطْوِ السّنِينَ بهمَّةٍ قُرَشيَّةٍ","تقتادُ منها رَيِّضاً وشَموسا",170,"س",2,0],["واطلبوا الرّيحان عندي وخذوا","من بياني روضةً أو روضتيْنْ",171,"ن",1,0],["واطلبوا في عصركم أقصى المدى","لا تهابوا تلك إحدى الخُطّتيْنْ",171,"ن",1,0],["وَاِطِّراحي لِكُلِّ دَينٍ","وَأَخذي لِكُلِّ دَين",172,"ن",1,0],["وَأَطاف المَلأ الأَعلى بِمن","عزمه في الحَقِّ عزمُ الرُسُلِ",173,"ل",1,0],["وَاِطل بِالمِسكِ إِذ شالَت نَعامَتُهُم","وَأَسبِلِ اليَومَ في بُردَيكَ إِسبالا",174,"ل",2,0],["وَأَطوَلَهُم في النَدى بَسطَةً","وَأَفضَلَهُم حينَ عُدّوا فِعالا",175,"ل",2,0],["وَأَطعَمَ الذُبوحَ أَطفالَ الناس","مَكيدَةً مِنهُ فَأَعظِم مِن باس",176,"س",1,0],["وَأَطَلتِ بي سَفَرَ المَلامَةِ وَالأَذى","فَاِثني الرِكابَ هُنيدَ أَن تَتَبَلَّغي",177,"غ",2,0],["وَأَطيَبَ الناسِ ريقاً","لِمُغتَدٍ وَلِسارِ",178,"ر",1,0],["وَأَطلَعتُ لَكَ الوُدَّ","بِشَيءٍ فَتَغَضَّبتا",179,"ت",2,0],["وَأَطَلتُ تَجريبي لَها","لَو كُنتُ أَطمَعُ بِالتَجارِب",180,"ب",1,0],["وَأَطلَقنَ أَشباحاً يُخَلنَ عَقارِباً","إِذا رَفَعَت عِندَ الحَفيظَةِ أَذنابا",181,"ب",2,0],["وَأَطاعَتْ لأَمْرِهِ العَرَبُ العَرْ","باء وَالْجَاهِلِيَّةُ الْجَهْلاءُ",182,"ا",2,0],["واطمأنوا بقَوْلِ الَاحزاب إِخوا","نِهِمُ إِننا لكم أولياءُ",182,"ا",2,0],["وَأَطْعَمَ الصَّائِمِينَ الجائِعِينَ وَمِنْ","فَرْطِ الخَصاصَةِ في أكْبَادِهِم سُعُرُ",183,"ر",1,0],["وَأَطَلْتَ فِي مَرْضاةِ رَبِّكَ سُخْطَهُم","فَجَرَعتَ مِنهُم عَلقَماً مَغسُولا",184,"ل",2,0],["وأطَلْتُ تفكيري فلا واللّهِ مَا","أدري أوجْهُكَ أم فَعالُكَ أجمْل",185,"ل",1,0],["وَاطَّرَدَت عَيناكَ في رَوضَةٍ","تَضحُكُ عَن خُضرٍ وَعَن صُفرِ",186,"ر",1,0],["وَأَطِر فيها حَماماً","وَاِرتَبِط فيها المَهارى",187,"ر",2,0],["وَاِطعَن بِرُمحِكَ بَطنَ تِلكَ وَظَهرَ ذا","هَذا الجِهادُ فَنِعمَ عُقبى الدارِ",188,"ر",1,0],["وَأَطعَمَ حَتّى ما بِمَكَّةَ آكِلٌ","وَأَعطى عَطايا لَم تَكُن بِضِمارِ",189,"ر",1,0],["وَأَطرُقُ حَيّاتِ البِلادِ لِحَيَّةٌ","خَصيبِيَّةُ التَصميمِ حينَ تَسورُ",190,"ر",1,0],["وَاِطوِ شَوّالاً عَلى القَص","فِ وَتَغريدِ القِيانِ",191,"ن",1,0],["وأطلبُ حاجتي من ظهر غيبٍ","من البيض الكواعبِ والغلامِ",192,"م",1,0],["وأطربُ من مطارحةٍ بنجوى","مطارقةُ الجواري للطروقِ",193,"ق",1,0],["وأطيبُ من مُنازلةٍ لحربٍ","منازلةُ الدنان من الرحيقِ",193,"ق",1,0],["وإطلاقُ الجفونِ وهنّ حومٌ","لصيدِ الخدّ والوجهِ النفيس",194,"س",1,0],["وأطلع فطاعتهُ عليكَ فريضة","إبليسَ عمّكَ تُكملُ الكفرا",195,"ر",2,0],["وَأَطَرتُ جَنَّةَ عَجرَدٍ","وَأَنا المُغَنُّ المِشغَبُ",196,"ب",1,0],["وَأَطبَقَ حُبُّهُنَّ عَلى فُؤادي","كَما اِنطَبَقَت عَلى الأَرضِ السَماءُ",197,"ا",2,0],["وَأَطهَرُ مِن ضَوارِبَ في نَعيمٍ","نَعامٌ بِالفَلا مُتَهَبِّداتُ",198,"ت",1,0],["وَاِطلُب لِبِنتِكَ زَوجاً كَي يُراعيها","وَخَوِّفِ اِبنَكَ مِن نَسلٍ وَتَزويجِ",199,"ج",1,0],["وَأَطيَبُ مِنهُم مَطعَماً في حَياتِهِ","سُعاةُ حَلالٍ بَينَ غَادٍ وَرائِحِ",200,"ح",1,0],["وَأَطوَلُ الحينِ يُلفى مِثلَ أَقصَرِهِ","فَاِسأَل رَبيعَةَ عَمّا قُلتُ أَو مُضَرا",201,"ر",2,0],["وَأَطَلنا في بَني أَيّا","مِنا قالاً وَقيلا",202,"ل",2,0],["وَاِطلُب رِضاكَ مِنَ الخِلَّينِ ذي شُطَبٍ","وَمُطلَقِ الحَدِّ في الأَبطالِ مُعتَقَلُ",203,"ل",1,0],["وَاِطلُبِ الرِزقَ بِالمُرورِ مِن الشَجَ","راءِ لامِن أَسِنَّةٍ وَمَناصِل",204,"ل",1,0],["وأطْرَبَني الشّبابُ غَداةَ ولّى","فليْتَ سِنِيهِ صوْتٌ يُسْتَعادُ",205,"د",1,0],["وَأَطلَقَ عَبدُ اللَهِ غُلَّ اِبنِ جَعفَرٍ","عُلاَثَةَ مَغلُولاً يُقادُ مُكبَّلا",206,"ل",2,0],["وَأَطواءَنا مِن بَطنِ أَكمَةَ إِنَّكُم","جَشِمتُم إِلى أَربابِهِنَّ الدَواهِيا",207,"ي",2,0],["وَأطبَقَتْ ظُلمٌ مِنْ فَوْقِها ظُلمٌ","مَا يُسْتَضاءُ بِها نُورٌ ولا نارُ",208,"ر",1,0],["وأطالا فيه عذابي إلى أن","غاب وعيي وزال عني الشعور",209,"ر",1,0],["وأُطلقت كل نفس من أسارتها","هذا الذي كان يرجو نيله الراجي",210,"ي",1,0],["وأطلعتِ الأرضُ من ليلها","مفاتنَ مختلفاتِ الصُّورْ",211,"ر",1,0],["وإطارٍ من السَّنى","جمع الكون وانتظمْ",212,"م",1,0],["واطلع اليوم عليها سيرةً","وكن الشاعر واهتف بالقصيد",213,"د",1,0],["وأطعْتُ ثم عَصيتُ ثم وجدتني","بيديكِ لا عن ذلَّةٍ وتغاضي",214,"ي",1,0],["وأطلت الأزهارُ من ورقاتها","حيرى تعجَّبُ للربيع الباكرِ",215,"ر",1,0],["واطرقي غيرَ بابهِ إنَّ رَوحي","أحكمتْ دونه رُتاجاً وقُفلا",216,"ل",2,0],["وأطْوَلِهِمْ إذا ركِبوا قَناةً","وأرْفَعِهِمْ إذا نزَلوا عِمادا",217,"د",2,0],["وأطْلَسَ مُخْلِقِ السِّرْبالِ يَبْغي","نَوافِلَنا صَلاحاً أو فَسادا",217,"د",2,0],["واطلع منه اللياحُ الشميط","خدوداً كما سُلت الانصلُ",218,"ل",1,0],["وَأَطلُبُ أَعدائي بِكُلِّ سَمَيذَعٍ","وَكُلِّ هِزَبرٍ في اللِقاءِ هُمامِ",219,"م",1,0],["وَأَطعَنُ في الهَيجا إِذا الخَيلُ صَدَّها","غَداةَ الصَباحِ السَمهَرِيُّ المُقَصَّدُ",220,"د",1,0],["وأَطلُبُ ألُخطَّةَ النَّبيلَةَ بال","قُوَّةِ إذ يُستَهَدُّ طالبُها",221,"ب",3,0],["وأَطفِ حَديثَ السُّوء بالصَّمتِ إنَّهُ","مَتَى يُؤرَ ناراً لِلعِتابِ تَأَجَّجا",222,"ج",2,1],["واطْوِ المَغَارِبَ خَافِياً لَوْ أَنَّهَا","تُخْفِي عُلاَكَ مَطَالِعُ الأَنْوَارِ",223,"ر",1,0],["وَأَطْلَقَ فِي الجَوِّ السَّحيق نسُورَهَا","تَجُوبُ فَضَاءَ الله مَثْنَى وَمَوْحَدَا",224,"د",2,0],["وَأَطَقْتَ فِي نَفْعِ الشَّبَابِ وَهَدْيِهِمْ","مَا لَمْ يَكُنْ جَلْدٌ سِوَاكَ يَطِيقُ",225,"ق",1,0],["وَأَطْلِعْ فِي سَمَاءِ الكأْ","سِ آفَاقاً مِنَ التِّبْرِ",226,"ر",1,0],["وَأَطَلَّ مِصْبَاحٌ يُطَالِعُهَا","كَلِفاً كَأَنَّ شُعَاعَهُ نَظَرُ",227,"ر",1,0],["وَأطَالَ عُمْرَكَ بَيْنَ إِجْلاَلٍ","تُحَاطُ بِهِ وَحُبِّ",228,"ب",1,0],["وَأَطيَبُ مِن نَسيمِ الرَوضِ حَفَّت","بِهِ اللَذاتُ مِن رَوحٍ وَراحِ",229,"ح",1,0],["واطرُقوا البابَ كلُّ بابٍ كفيلٌ","بولُوجٍ لمن دَرَى دقَّاتهْ",230,"ت",2,0],["وأَطَاحَتْ القَيْدَ العَنيفَ وطَالَما","عاذَتْ بِرَبِّ النَّاس مِنْ إِيذَائه",231,"ا",3,0],["وأطفأ نيرانَ العداوةِ وابلٌ","من الْحِلم حَيّا صَوبَه كلُّ وابل",232,"ل",1,0],["وأطاحَ القفصَ المشئوم لا","تعرفُ الجنُّ متى أو أيْنَ طَاح",233,"ح",1,0],["وأطلقتَ عقلاً كان بالأمس مُصْفَداً","فدان له سرُّ الوجودِ المحجَّبُ",234,"ب",1,0],["واطلبي الْخَيْرَ والمُنَى مِنْ فُؤادٍ","ناشرِ الفَضْلِ ناصِرِ الآداب",235,"ب",1,0],["وأطَاحتْ قُيُودَها فَاستقلّتْ","وامْحَى ما تَرَكْنَ مِنْ نَدَبَاتِ",236,"ت",1,0],["وأَطَلّتْ من الخِباءِ عَلَيْهِمْ","فَسَبتْهُمْ بِسِحْرِها الفَتّانِ",237,"ن",1,0],["وأطلَعَ من زُرْقِ الأسِنَّةِ أنجُماً","على الثَّغْرِ تَرعاها من السَّعْدِ أنجُمُ",238,"م",1,0],["واطرحي الكبرياء شلوا مدمى","تحت أقدام دهرك السكير",239,"ر",1,0],["وأطيبُ ساع الحياة لديَّا","عشيةَ أخلو إلى ولديَّا",240,"ي",2,1],["وَأطافت به الرياحُ رُخاءً","فهْو حلم في خاطر الوسنان",241,"ن",1,0],["وأطافت به الأعاصير هوجًا","فهْو طيشُ الشَّباب في عُنفوان",241,"ن",1,0],["وأطلع منك الفلك شمسا منيرة","لها فلك بالعلم والحلم دائر",242,"ر",1,0],["وأطفيء في تلك الموارد غلتي","وأحسب قربا مهجة شكت البعدا",243,"د",2,0],["وأطلقني من سجن عمري فقاتلي","عدوّ ، مروءات الصديق لديه",244,"ي",2,0],["وأطهر صفحة ً سترت وأخرى","من العبرات تشهدُ بالتباب",245,"ب",1,0],["وَأَطَلْتَ في مَرْضَاة ِ رَبِّكَ سُخْطَهُمْ","جُمِعَتْ لَهُ أغْنامُ قَيْدَارَ التي",246,"ل",3,0],["واطرُدي هذه الهمومَ وسَلِّي","حُزن وجهي بوجهك الضحّاك",247,"ك",1,0],["وأطلقَ للصيدِ أظفارهنَّ","وأنيابَهنَّ بها واختفى",248,"ا",1,0],["وَأطفأ لَوعَة ً كانَت بِقَلبي","أغَصَّتني حَرَارَتُها بِرِيقي",249,"ق",2,0],["واطال ثواؤه في دمنتيها","فهيج شوقه طول الثواء",250,"ا",2,0],["وأَطْلُبُ منك الفضل من غير رغبةٍ","فلم أر قبلي زاهدا فيك راغب",251,"ب",1,1],["وَأطْلَقَني النّضْرُ بنُ عَمْروٍ، وَرُبّما","بكَفّيْهِ قَدْ فَكّ الأسِيرَ المُكَبَّلا",252,"ل",2,0],["واطلب على عزّه بيض الانوف ولا","تطلب لعَمْرُك أن تُحظى بمفضال",253,"ل",1,0],["واطلُبوا بالعبقريات المدى","ليس كلُّ الخيلِ يشهدن الرِّهانا",254,"ن",2,1],["وأَطال خوفو من مواكبِ عِزِّه","فاهتزَّت الرَّبَواتُ، والآكام",255,"م",1,0],["وأطرق الروضة عند الضحى","كما أناجي البلبل الشاعرا",256,"ر",2,0],["وأطعمهم فينا غرورٌ فأرقلوا","إلينا سراعاً بالجيادِ وأرقلنا",257,"ن",2,0]]}