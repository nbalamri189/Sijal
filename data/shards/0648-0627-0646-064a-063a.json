{"poems":[[49,"لأيكم أذكر","https://www.aldiwan.net/poem25261.html","مجزوء المتقارب"],[31,"صحا القلب إلا من ظعائن فاتني","https://www.aldiwan.net/poem6052.html","الطويل"],[119,"سكنتم سويد القلب في برزخ الصدر","https://www.aldiwan.net/poem41661.html","الطويل"],[242,"هديتك العظمى أصار قبولها","https://www.aldiwan.net/poem18176.html","الطويل"],[302,"وإني غريب بين قومي وجيرتي","https://www.aldiwan.net/poem32946.html","الطويل"],[370,"لقد علمت خيل الأعاجم أنني","https://www.aldiwan.net/poem44368.html","الطويل"],[371,"فعالك في العلياء أسمى وأسمح","https://www.aldiwan.net/poem17315.html","الطويل"],[438,"يقول وأبصر حالي الحسود","https://www.aldiwan.net/poem12621.html","المتقارب"],[487,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[567,"مضى زمن الصبى فدع التصابي","https://www.aldiwan.net/poem52876.html","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34431","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38434","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145811","الوافر"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132826","الوافر"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48937","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69412","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110233","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109353","البسيط"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142778","السريع"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106858","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87694","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204480","الوافر"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130066","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87361","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68033","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74020","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77131","الرجز"],[4003,"","https://poetry.dctabudhabi.ae/diwan/poem/199233","الطويل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93297","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136534",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58147","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58122","المتقارب"],[5039,"بعض الأغاني حزينه","https://www.poetsgate.com/ViewPoem.aspx?id=48130",""],[5436,"بغداد .. يا مجد هارون ( علي محمد السليم )","https://www.poetsgate.com/ViewPoem.aspx?id=46675",""],[5463,"أنا غرامك يوم كنتي عن غرامي تبحثين","https://www.poetsgate.com/ViewPoem.aspx?id=32341",""],[5474,"لن أَخْنَع لهم","https://www.poetsgate.com/ViewPoem.aspx?id=181743",""],[5616,"محنة","https://www.poetsgate.com/ViewPoem.aspx?id=203469",""],[466,"لقد علمت زوراء دجلة أنني","https://www.poetsgate.com/ViewPoem.aspx?id=38054",""],[5818,"لاجئ","https://www.poetsgate.com/ViewPoem.aspx?id=196530",""],[6084,"زارني ليلا وقد نام الرقيب","https://www.poetsgate.com/ViewPoem.aspx?id=170819",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[456,"لقاء الأندلس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84501&r=&rc=0",""]],"verses":[["وَإِنّي غَزيرُ الذُنوبِ","وَإِحسانُهُ أَغزَرُ",0,"ر",1,0],["وَإِنّي غَداةَ اِستَعبَرَت أُمُّ مالِكٍ","لِراضٍ مِنَ السُلطانِ أَن يَتَهَدَّدا",1,"د",2,0],["وإني غريب بين أهلي لشأنكم","جمعت بكم سرى وأعطيتهم جهرى",2,"ر",2,0],["وإني غني عن شؤون الورى بكم","ولكن لعليا عز سدتكم فقري",2,"ر",2,0],["وَإِنِّي غَنِيٌّ عَنْ غَرَامَةِ صَاحِبِي","وَإِلاَّ فَمَالِي مِنْ سَبِيلٍ إِلَى الرَّدِّ",3,"د",1,0],["وإنّي غَريبٌ بين قومي وجيرَتي","وأَهليَ حَتّى ما كأَنَّهم من أَهلي",4,"ل",2,1],["وأنّي غداةَ القادسيّةِ إذ أتَوا","بجمعِهِمُ ليثٌ هَصُورٌ غشمشَمُ",5,"م",1,0],["وَإِنّي غَنِيُّ النَفسِ في الفَقرِ وَالغِنى","أَظَلُّ إِلى بَردِ المُنى أَتَرَوَّحُ",6,"ح",1,0],["وإني غداً سائلُ عنبراً","ومستمعٌ منه ما يذكرُ",7,"ر",1,0],["وإني غرثان للقياك طالبا","من الله أن تطوى مسافة حيران",8,"ن",1,0],["وأني غرثان للقياك طالبا","من الله أن تطوى مسافة غرثان",8,"ن",1,0],["وإنِّي غَرْسُ نِعمتِهِ قديماً","نَشَأتُ بها كأغصانِ الرَّوابي",9,"ب",2,0],["وَإِنّي غَريبٌ لَو سَكَنتُ بِبَلدَتي","وَإِنّي وَحيدٌ لَو رَكَنتُ إِلى إِلفِ",10,"ف",1,0],["وَإِنّي غَنيّ النّفسِ أَرضَى بِفاقَةٍ","وَإِنّ الرّضا فيها مِنَ المَجدِ وَالعزِّ",11,"ز",1,1],["وأني غير جمر ِالشعر","لي جمرٌ ومحتَضَنُ",12,"ن",1,0],["وإن يُغري به شوقٌ مُوالٍ","يغالبُهُ على صَبرٍ مُعادِ",13,"د",1,0],["وإن يَغضبْ عليَّ الأرزُ يوماً","حَسِبتُ الناس كلَّهم غِضابا",14,"ب",2,0],["وَأَن يَغتَدِي مِسكاً ثَراهُ وَلُؤلؤاً","حَصاهُ وَياقُوتاً ثَمِيناً جَنادِلُه",15,"ل",2,0],["وأن يغني المغني شعرَنا وبهِ","من التهتك ألوانٌ وأشكالُ",16,"ل",1,0],["وان يغب شخصه عنا فسيرته","ورد لكل نقي القلب ميمون",17,"ن",1,0],["وإنْ يَغِضْ ما فاضَ من أَدْمُعي","مَزَجْتُهُ من مُهجَتي بالنَّجيعْ",18,"ع",1,0],["وإني غريبٌ بين أهلي ومعشري","اجرر بين الناس أقدامَ تائه",19,"ا",3,0],["وَان يَغض ماء جفني","أَسَلت فيك الفُؤادا",20,"د",2,0],["واني غصت فيه سوى فؤاد","يغوص غداً فيعمى مثل عيني",21,"ن",2,0],["وَأن يغشى البلاد إذا اِستقلّت","وساعدها الزمان بأن تسودا",22,"د",2,0],["وان يغِب فسهامُ الشوقِ ترشقني","في القرب خَوفٌ وَفي شَحطِ النوى خَطَرُ",23,"ر",1,0],["وإِن يَغَضَّ الدهرُ عثى طَرْفَه","فَعَلَّه يَعْتاضُ مني مَا مَضَى",24,"ا",1,0],["وَإِنّي غنيّ ولكنَّ لي","فؤاداً إِلى وَصلها يملقُ",25,"ق",1,0],["وَأَن يَغض عَن مَعايِبي البَصَر","إِذا بَدَت وَليلف مِمَّن اِعتَذَر",26,"ر",1,0],["وإني غريبٌ بين بست وأهلها","وإن كان فيها أسرتي وبها أهلي",27,"ي",1,0],["وإِنْ يغب عنك اهتزازُ قدّه","فسل به أَترابه من الأَسَل",28,"ل",1,0],["وإنيّ غريبٌ في الزَمان وأهله","وإن كنتُ ما بينَ الانام عماده",29,"د",2,0],["وإني غريقٌ في المعاصِي وإنَّما","لِحُسْنِ رجائي نحو عفوِك قد سَعَا",30,"ع",2,0],["وإني غريب بهذا الزمان","ما بين قومٍ لئامٍ سِفَالْ",31,"ل",1,0],["واني غريب وكل ماقلت حنيت","تعلقت في رجل الإحساس طينه",32,"ن",2,0],["وإن يَغِب ْ وجهك َ الوضّاءُ في جَدَث ٍ","فإنّ ذكْرَك َ فينا غير ُ مَدفون (7)",33,"ن",1,0],["--{ وإني غرامك يوم كنتي عن غرامي تبحثين }--","في قلوب ٍ ما تِعَرْف .. للحب أي قمّة وقاع",34,"ع",1,0],["وَإِنِّي غزّةُ الشمّاء أأبى","خنوعا مثلما يأبى الشهيد",35,"د",1,0],["وأن يُغرّد حرف الحاء في فمها","والباء يسعفه طوعاً فتبتسم",36,"م",1,0],["وأني غفورٌ للسفيه وآخذُ النَّبي","هِ ومنَّاع النزيل المجاورِ",37,"ر",1,0],["وأنّي غارقٌ في حسْنِ ظنّي","وأنّي بالشهادةِ ما كفرت",38,"ت",1,0],["وان يغب يا سعد عني ساعة","بت ليلى ساهرا أرعى الرقيب",39,"ب",1,0],["وإنّي غميضُ الكُنهِ كنزٌ مطلسَمٌ","ولا منتهى عرضاً ولا منتهى طولا",40,"ل",2,0],["وإني غريبٌ في ذراكِ وإن يكنْ","عليكِ بغاةٌ يجحدون عطائيا",41,"ي",2,0]]}