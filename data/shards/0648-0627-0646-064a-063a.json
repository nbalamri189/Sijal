{"poems":[[49,"لأيكم أذكر","https://www.aldiwan.net/poem25261.html","مجزوء المتقارب"],[31,"صحا القلب إلا من ظعائن فاتني","https://www.aldiwan.net/poem6052.html","الطويل"],[118,"سكنتم سويد القلب في برزخ الصدر","https://www.aldiwan.net/poem41661.html","الطويل"],[240,"هديتك العظمى أصار قبولها","https://www.aldiwan.net/poem18176.html","الطويل"],[300,"وإني غريب بين قومي وجيرتي","https://www.aldiwan.net/poem32946.html","الطويل"],[368,"لقد علمت خيل الأعاجم أنني","https://www.aldiwan.net/poem44368.html","الطويل"],[369,"فعالك في العلياء أسمى وأسمح","https://www.aldiwan.net/poem17315.html","الطويل"],[435,"يقول وأبصر حالي الحسود","https://www.aldiwan.net/poem12621.html","المتقارب"],[484,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[564,"مضى زمن الصبى فدع التصابي","https://www.aldiwan.net/poem52876.html","البسيط"]],"verses":[["وَإِنّي غَزيرُ الذُنوبِ","وَإِحسانُهُ أَغزَرُ",0,"ر",1,0],["وَإِنّي غَداةَ اِستَعبَرَت أُمُّ مالِكٍ","لِراضٍ مِنَ السُلطانِ أَن يَتَهَدَّدا",1,"د",2,0],["وإني غريب بين أهلي لشأنكم","جمعت بكم سرى وأعطيتهم جهرى",2,"ر",2,0],["وإني غني عن شؤون الورى بكم","ولكن لعليا عز سدتكم فقري",2,"ر",2,0],["وَإِنِّي غَنِيٌّ عَنْ غَرَامَةِ صَاحِبِي","وَإِلاَّ فَمَالِي مِنْ سَبِيلٍ إِلَى الرَّدِّ",3,"د",1,0],["وإنّي غَريبٌ بين قومي وجيرَتي","وأَهليَ حَتّى ما كأَنَّهم من أَهلي",4,"ل",2,1],["وأنّي غداةَ القادسيّةِ إذ أتَوا","بجمعِهِمُ ليثٌ هَصُورٌ غشمشَمُ",5,"م",1,0],["وَإِنّي غَنِيُّ النَفسِ في الفَقرِ وَالغِنى","أَظَلُّ إِلى بَردِ المُنى أَتَرَوَّحُ",6,"ح",1,0],["وإني غداً سائلُ عنبراً","ومستمعٌ منه ما يذكرُ",7,"ر",1,0],["وإني غرثان للقياك طالبا","من الله أن تطوى مسافة حيران",8,"ن",1,0],["وأني غرثان للقياك طالبا","من الله أن تطوى مسافة غرثان",8,"ن",1,0],["وإنِّي غَرْسُ نِعمتِهِ قديماً","نَشَأتُ بها كأغصانِ الرَّوابي",9,"ب",2,0]]}