{"poems":[[74,"تحلو الثغور بذكرك المتردد","https://www.aldiwan.net/poem18546.html","الكامل"],[50,"دع جنانا وحبها","https://www.aldiwan.net/poem64515.html","مجزوء الخفيف"],[520,"نبهتني حمامة بسحير","https://www.aldiwan.net/poem12292.html","الخفيف"],[556,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122667","الخفيف"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19992","المديد"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91539","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114580","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73242","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136550",""],[5010,"الترك دواء الجهلاء","https://www.poetsgate.com/ViewPoem.aspx?id=189904",""],[5163,"تكلمت بلسان حالي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=33947",""],[5561,"صراع الذات","https://www.poetsgate.com/ViewPoem.aspx?id=194666",""],[5582,"أَفْراحُ أَهْلِ الهَوَى فِي الهَجْرِ أَحْزانُ","https://www.poetsgate.com/ViewPoem.aspx?id=187308",""],[5704,"وصْف...","https://www.poetsgate.com/ViewPoem.aspx?id=191601",""],[520,"نبهتني حمامة بسحير","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577675",""]],"verses":[["دعجاء ساحرة لأن لحاظها","تفري جوانحنا بسيف مغمد",0,"د",1,0],["دَع جِناناً وَحُبَّها","عَنكَ إِن كُنتَ عاقِلا",1,"ل",2,1],["دعجة المقلتين في وجنتيها","وردة من شقائق النعمان",2,"ن",1,0],["دَعْ جانبَ الذُلِّ لمنْ حَلَّهُ","فما به شيءٌ من الخيْرَةِ",3,"ه",1,0],["دَع جُفُوني تَنهَلُّ وِتراً وشَفعاً","أنا أبكي دَماً إذا غِضتُ دَمعا",4,"ع",2,1],["دَع جَدا قَحطانَ أَو مُضَرٍ","في يَمانيهِ وَفي مُضَرِه",5,"ر",2,0],["دَعجاءُ إِنسانها يُغري القُلوب فَما","قَلبٌ يقابله إِلا يُكلّمه",6,"م",2,0],["دع جميعَ الورى وَرا","واشهدِ اللَهَ لا سوى",7,"س",3,1],["دَع جُفوني والأَدمُعَ الُمستَهِلَّه","خلفَ تلكَ الرَّكائبِ الُمستَقلَّه",8,"ل",2,1],["دعجاء تؤمن كهانُ القلوب بها","طوعاً وتسجدُ إذ ترنو فتسحرها",9,"ر",3,0],["دَعْ جَهُولاً حانقًا في غيظِهِ","فَدَواءُ البعضِ تَركٌ واستِفَالْ",10,"ل",1,1],["دعج المآقي سمير الخد ليل هوىً","مياس قدٍّ يذيب الخلد في العدمِ",11,"م",1,0],["دعْ جراحاتي تستبيحُ جراحي","فمواساتي أنّكَ التخديرُ",12,"ر",1,0],["دَعْجاءُ يَفْتِنُ مِنْها كُلَّما نَظَرَتْ","طَرْفٌ لأَفْئِدَةِ الرَّائِينَ فَتَّانُ",13,"ن",1,0],["دعجاءُ زادتْ لهفتي","أهدابها كمْ أرقتْ",14,"ت",1,0],["دعجة المقلتين في وجنتيها","وردةٌ في شقائق النعمان",15,"ن",1,0]]}