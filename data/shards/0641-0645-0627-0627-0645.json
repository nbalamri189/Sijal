{"poems":[[55,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[32,"أللربع ظلت عينك الماء تهمل","https://www.aldiwan.net/poem29546.html","الطويل"],[29,"شتمت مجاشعا ببني كليب","https://www.aldiwan.net/poem5702.html","الوافر"],[53,"قل للأمير أدام الله غبطته","https://www.aldiwan.net/poem10869.html","البسيط"],[26,"هل الدهر إلا ليلة ونهارها","https://www.aldiwan.net/poem24105.html","الطويل"],[40,"أمن آل وسنى آخر الليل زائر","https://www.aldiwan.net/poem7713.html","الطويل"],[45,"ضيف ألم برأسي غير محتشم","https://www.aldiwan.net/poem10532.html","البسيط"],[30,"وعائذة التي كانت تميم","https://www.aldiwan.net/poem5237.html","الوافر"],[63,"عزاء يا أبا الفضل","https://www.aldiwan.net/poem51391.html","الهزج"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[35,"أنيري مكان البدر إن أفل البدر","https://www.aldiwan.net/poem25934.html","الطويل"],[35,"فما وجد أعرابية قذفت بها","https://www.aldiwan.net/poem25978.html","الطويل"],[107,"لمن تجمع الروم أبطالها","https://www.aldiwan.net/poem44030.html","المتقارب"],[52,"لعمري لقد أزرى سهيل بصهره","https://www.aldiwan.net/poem63967.html","الطويل"],[52,"أحبى فيم خليت","https://www.aldiwan.net/poem64745.html","الهزج"],[48,"إذا درجت في العالمين قبيلة","https://www.aldiwan.net/poem22241.html","الطويل"],[48,"بني الآداب غرتكم قديما","https://www.aldiwan.net/poem22343.html","الوافر"],[19,"فما أم الردين وإن أدلت","https://www.aldiwan.net/poem370.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42659","الوافر"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142327","الرجز"],[111,"تهد العمر رائعة المنون","https://www.poetsgate.com/ViewPoem.aspx?id=523",""],[92,"بنت بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=179192",""],[40,"أمِنْ آلِ وَسْنَى آخِرَ اللَّيْلِ زَائِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=21190",""],[35,"أنِيري مَكانَ البَدْرِ إنْ أفَلَ البَدْرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14108&r=&rc=43",""],[147,"سبقت ففز بعظيم الخطر","https://www.aldiwan.net/poem11757.html","المتقارب"],[147,"لقد أدنت لك البلد السحيقا","https://www.aldiwan.net/poem11785.html","الوافر"],[164,"وقفت على بيتين من أثقل الشعر","https://www.aldiwan.net/poem59177.html","الطويل"],[240,"هل أنت يا أخت القضيب الناضر","https://www.aldiwan.net/poem31983.html","الرجز"],[251,"نأتك بليلى دارها لا تزورها","https://www.aldiwan.net/poem56333.html","الطويل"],[275,"بكيت على حب مع الحسن ذاهب","https://www.aldiwan.net/poem35237.html","الطويل"],[276,"حروف معان أو عقود جواهر","https://www.aldiwan.net/poem52109.html","الطويل"],[287,"دعا مهجة الصب لا تردعاها","https://www.aldiwan.net/poem32310.html","المتقارب"],[333,"دع النائم اليقظان لا تستقه خمرا","https://www.aldiwan.net/poem54971.html","الطويل"],[368,"فما أم أدراص بأرض مضلة","https://www.aldiwan.net/poem1730.html","الطويل"],[447,"فؤاد بنيران المصاب مفأد","https://www.aldiwan.net/poem14450.html","الطويل"],[463,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[510,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[556,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[556,"لقل غناء العتب والمجرم الدهر","https://www.aldiwan.net/poem47826.html","الطويل"],[572,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[575,"فما أم أدراض بأرض مضلة","https://www.aldiwan.net/poem59340.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122599","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103071","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39039","البسيط"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104554","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64001","البسيط"],[899,"","https://poetry.dctabudhabi.ae/diwan/poem/115094","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59654","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136182","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21663","البسيط"],[1774,"","https://poetry.dctabudhabi.ae/diwan/poem/79635","الوافر"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128789","السريع"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104464","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27541","الطويل"],[2528,"","https://poetry.dctabudhabi.ae/diwan/poem/199542","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118958","المجتث"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86267","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138600",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91090","البسيط"],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18575","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59476","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81706","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66104","الطويل"],[4723,"بوارق السيف","https://www.poetsgate.com/ViewPoem.aspx?id=63448",""],[585,"سمعت صريف الباب وهو يسبح","https://www.poetsgate.com/ViewPoem.aspx?id=161931",""],[5072,"موت ُ الضمائر","https://www.poetsgate.com/ViewPoem.aspx?id=51898",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5351,"يمانيون يا طه تنادت","https://www.poetsgate.com/ViewPoem.aspx?id=202647",""],[5376,"عجباً من الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=188267",""],[5397,"تخادعك الدنيا وتبدي اغترارها","https://www.poetsgate.com/ViewPoem.aspx?id=157907",""],[5459,"بعثة الرحمة المهداة","https://www.poetsgate.com/ViewPoem.aspx?id=190905",""],[5628,"لا أمل في البقاء","https://www.poetsgate.com/ViewPoem.aspx?id=178512",""]],"verses":[["فَما أَمَلُّ مَديحاً أَنتَ سامِعُهُ","وَعاشِقُ العِزِّ لا يُؤتى مِنَ المَلَلِ",0,"ل",1,0],["فَما أُمُّ أَولادٍ ثَكولٌ وَإِنَّما","تَبوءُ بِما في بَطنِها حينَ تَثكَلُ",1,"ل",1,0],["فَما أُمُّ الفَرَزدَقِ مِن هِلالٍ","وَما أُمُّ الفَرَزدَقِ مِن صُباحِ",2,"ح",1,0],["فما امتدحتُك إلا بعد ألسنةٍ","ولا انتجعتُك إلا بعد رُوَّادِ",3,"د",1,0],["فَما أُمُّ خِشفٍ بِالعَلايَةِ شادِنٍ","تَنوشُ البَريرَ حَيثُ نالَ اِهتِصارُها",4,"ر",3,0],["فَما أُمُّ عَبدِ اللَهِ إِلّا عَطِيَّةٌ","مِنَ اللَهِ أَعطاها اِمرَأً فَهوَ شاكِرُ",5,"ر",1,0],["فَما أَمُرُّ بِرَسمٍ لا أُسائِلُهُ","وَلا بِذاتِ خِمارٍ لا تُريقُ دَمي",6,"م",2,0],["فَما أَمسى لِضَبَّةَ مِن عَدُوٍّ","يَنامُ وَلا يُنيمُ مِنَ الحِذارِ",7,"ر",1,0],["فما امتد بك العمر","فأنت الدين والدنيا",8,"ا",1,0],["فَما أَمَرَّ عَلَيها داعِياً يَدَهُ","حَتّى اِستَهَلَّت بِذِي شَخبينِ كَالدِّيَمِ",9,"م",1,0],["فَما أُمُّ خِشفٍ بِالعَقيقَينِ تَرعَوي","إِلى رَشَأٍ طِفلٍ مَفاصِلُهُ خُدرُ",10,"ر",1,0],["فَما أُمُّ سَقبَ هالِكٍ في مَضَلَّةٍ","إِذا ذَكَرَتهُ آخِرَ اللَيلِ حَنَّتِ",11,"ت",1,0],["فما أمسكَ البُخلُ دُمْلُوجَها","ولا مَلَكَ الحِرصُ خلخَالَها",12,"ل",3,0],["فَما أَمَّلَت هَذا لَهُ نَفسُ صالِحٍ","وَلا كانَ يَرجوها لَهُ في المَناكِحِ",13,"ح",1,0],["فُما أَمسَيتُ حَتّى صَر","رَخَ الحَيُّ وَسُجّيتُ",14,"ت",1,0],["فَما أَمِنَت نِسوانُ قَوم أَعِزَّةٍ","عَلى عِزِّها أَن تُستَباحَ فُروجُها",15,"ج",3,0],["فَما أُمُّ الحُوَيرِثِ في كَلامي","بِعارِضَةٍ وَلا أُمُّ الرَبابِ",16,"ب",1,0],["فَما أُمُّ الرُدَينِ وَإِن أَدَلَّت","بِعالِمَةٍ بِأَخلاقِ الكِرامِ",17,"م",1,1],["فَمَا أَمْسِي كَيَومِي حِينَ أَغْدُو","عَلَى كِبَرٍ وَمَا يَوْمِي كَأَمْسِي",18,"س",2,0],["فما أمرّ أمسها","ويومها ما أشبهه",19,"ه",1,0],["فما أمني فجورك أم عمرو","وقد خالفت خالصة الأمين",20,"ن",1,0],["فما أمرَّ وأقسى ما خرجتُ به","لولا بَقيةُ قلبٍ فيَّ مُتَّقِد",21,"د",1,0],["فَمَا أُمُّ عَبْدِالله إلاَّ عَطِيَّة","ٌ مِنَ اللَّهِ أعْطَاهَا أمْرَءاً فَهْوَ شَاكِرُ",22,"ر",1,0],["فمَا أُمُّ خِشْفٍ بالْعَقِيقَيْنِ تَرْعَوِي","إلى رشأ طفل مفاصلها خدر",23,"ر",1,0],["فَما أُمهِلَ السُمُّ إِلّا وَدَبَّ","وَلا أُهمِلَ الكَلبُ إِلّا عَقَر",24,"ر",1,0],["فَما أَمَّ العِدى إِلّا مُشيحاً","وَلا قَصَدَ الوَغى إِلّا مَشوقا",25,"ق",2,0],["فما أمره هين على الله إنه","عدو له يمسى على دينه يغري",26,"ر",2,0],["فَما اِمتَرَت كَفِّيَ غَيرَ باخِلٍ","مِنهُم وَلا جاوَرتُ غَيرَ جائِرِ",27,"ر",1,0],["فما أمُّ سَوداءِ المحاجرِ مُطفِلٌ","بأحسنَ منها مقلتينِ تُديرُها",28,"ر",3,0],["فما امتلأت إلا خزينةُ سارقٍ","وما قُضيت إلا لُبانةُ كاذب",29,"ب",1,0],["فَما أَمل الراجين من مطلب الغنى","سواك وَما راجى سواك بظافر",30,"ر",1,0],["فَما أُمُّ خشفٍ رَأَت قانِصاً","فَرَوَّعَها وَهيَ تُزجي طلاها",31,"ا",3,0],["فما آمن التاريخ إلا بماجد","يحقّر في آماله الموت والدهرا",32,"ر",2,0],["فَما أُمُّ أَدراصٍ بِأَرضٍ مَضِلَّةٍ","بِأَغدَرَ مِن قَيسٍ إِذا اللَيلُ أَظلَما",33,"م",2,1],["فما أم خسف أودعته خميلة","وظلت بروض الزند ترعىوتورد",34,"د",1,0],["فما أمكنَ القولُ فاسمع أُزِرْك","قوافِيَ بادئةً عُوَّدا",35,"د",2,0],["فما امْتطَىْ خيلَهُ صدِيقٌ","وما انتَخىْ قبلَه قريبُ",36,"ب",1,0],["فَما أَمنتُ بها إلّا على حَذَرٍ","ولا فرغتُ بها إلّا بأشغالِ",37,"ل",1,0],["فَما أَمترِي إلّا وَفاءً مُصرَّداً","مَذِيقاً ينادي من جوانبه الغَدْرُ",38,"ر",1,0],["فما امتدى فإنك شجاع","فِي أَنَّهُ الفَاتِكُ الشُّجَاعُ",39,"ع",1,0],["فما أمَّ أدراضٍ بأرضٍ مضلةٍ","بأغدر من عوفٍ اذا الليل أظلما",40,"م",2,1],["فما أمُّ فَردٍ شَذبَ الدَّهرُ غُصنَها","بأحداثِه تَشذيبَ إحدَى الجَرائِد",41,"د",1,0],["فما أميلح حسنا زانه خفر","وما أحيلى رضابا مزجه شنب",42,"ب",1,0],["فَما أمانيَّ إلّا أنْ تُرَوِّعني","ولا نَعِيمِيَ إِلّا أنْ تُعَذِّبَني",43,"ن",2,0],["فما أُمُّ رئمٍ لا تريمُ بروضةٍ","مفوَّفةِ الأرجاءِ بالزَّهرِ النّضرِ",44,"ر",1,0],["فما امترى فاتكٌ شجاعٌ","في أَنَّهُ الفاتكُ الشجاع",45,"ع",1,0],["فما أم عمرو حين تمسي ببلدةٍ","من الأرض إلا مثل غيثٍ يُصيبُها",46,"ب",3,0],["فما أمَلُ المملوكِ عِتقاً ورأفة","ولكنني أهوى طريق رضاكا",47,"ك",2,0],["فما ام ربع الفضل والجود قاصد","يروم العطا والفضل الا وقد مدى",48,"د",2,0],["فَما اِمرؤٌ لَم يُضِع وَلا حَسَباً","بِفَضلِ مالٍ وَقى عِرضاً بِمَغبونِ",49,"ن",1,0],["فما أُمّي برهْمٍ قد علمتُمْ","ولا بالعامليّة فاحذروني",50,"ن",2,0],["فما امرؤ القيس على فضله","ان قيس يوماً في نهاه الخطير",51,"ر",1,0],["فما أمسى سوى قلق وسادي","يقلبني التفكر كيف ماشا",52,"ش",2,0],["فما أمها إلا الطبيعةُ وحدها","فكانت كعيسى حين أحيى بها الموتى",53,"ا",1,0],["فما أم سقب أودعته قرارةً","من الأرض وانساخت لتروى وتهجعا",54,"ع",2,1],["فما أمر التجافي","مكانه وزمانه",55,"ن",2,0],["فَما امهُ من قاصِد نَحوَهُ سَعى","لَدى حاجَة إِلّا وَقَد نالَ مَقصِدا",56,"د",2,0],["فما اميةٌ لا أمت بمغفرةٍ","وهاشمٌ ما الضحى والليلُ حين سجى",57,"ج",2,0],["فَما اِمتداحي مُلوك الدَهر عَن أَرَبٍ","وَقَد غَنيت بِمَوجود عَن العَدَم",58,"م",1,0],["فَما أُمُّ سَقبٍ أَودَعَتهُ قَرارَةً","مِنَ الأَرضِ وَاِنساحَت لِتَرعى وَتَهجِعا",59,"ع",2,1],["فما أمَّ داري خائفٌ فهو خائفٌ","ولا زارَ رَبعي جائعٌ فهو جائعُ",60,"ع",1,0],["فما أمرض القلب الذي قد أغصَّه","تملُّؤه من ذلك المقضمِ الرَّخص",61,"ص",1,0],["فما امَّةٌ في الهُونِ طال احْتِباسُها","وليسَ لها عَزْمٌ بهِ يَنْهَضُ الحقُّ",62,"ق",1,0],["فما أملي سوى أمل ٍ عزيز ٍ","ولا ألمي سوى ألم ٍ عظيم ِ",63,"م",1,0],["فما امتلأت عجباً ولكن تبسمت","وقد سألت ما للطبيعة تمزح",64,"ح",1,0],["فما أمامِي َ إلا حرف ُ مهزلة ٍ","أباحه ُ مدّع ٍ بالمَكْر ِ واضطربا",65,"ب",2,0],["فما أمة المعصوم يا فدم كلها","خليون من قدح وقدح بهم نزل",66,"ل",1,0],["فما أمسى الحمى إلا منارا","بضوء محمدٍ يسمو اتشاحا",67,"ح",2,0],["فما أمنتْ نفسٌ حلالاً يصيبُها","قد اختلطَ الأقوامَ طهرٌ ورافثُ",68,"ث",1,0],["فما أمهل الأقوام بنت محمدٍ","تلوث عليها مرطها وخمارها",69,"ر",3,0],["فَمَا امتثَلَتْ لدعْوَته قُرْشٌ","وَ أوْرَتْ نارَ تكذيب وَ ذَمّ",70,"م",1,0],["فما أمل في البقاء هنا","يعيدُ الى القلب ما ضيَّعه ْ",71,"ع",2,0]]}