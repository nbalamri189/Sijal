{"poems":[[53,"لا يبعد الله أسلافا لنا سبقوا","https://www.aldiwan.net/poem66458.html","البسيط"],[50,"يا واضعا بيض القطا","https://www.aldiwan.net/poem62545.html","مجزوء الكامل"],[360,"وما حائمات حمن يوما وليلة","https://www.aldiwan.net/poem61023.html","الطويل"],[415,"من مبلغ المعتر والقانع","https://www.aldiwan.net/poem31879.html","السريع"],[415,"أعلمت ما فعلت به أجفانه","https://www.aldiwan.net/poem32364.html","الكامل"],[415,"لك أن أطيعك راضيا أو ساخطا","https://www.aldiwan.net/poem32575.html","الكامل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6770","الخفيف"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216559",""],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61261","الكامل"],[4806,"ماخنت ابنظر","https://www.poetsgate.com/ViewPoem.aspx?id=190863",""],[5122,"(( الشعر ))","https://www.poetsgate.com/ViewPoem.aspx?id=23975",""],[5122,"أول كلامي","https://www.poetsgate.com/ViewPoem.aspx?id=24265",""]],"verses":[["لو أيقن الناس جَدُّوا في أمورهُمُ","وكيف يوقن قومٌ لا يَجِدُّونا",0,"ن",2,0],["لَو أَيقَنَت ما تَحتَها","لَم تَخلُ مِن نَقرِ السِماخِ",1,"خ",1,0],["لوائب لا يصدرن عنه لوجهةٍ","ولا هنَّ من بَردِ الحياضِ داون",2,"ن",1,0],["لو أيقَنُوا أنَّ لهم رازِقاً","ليس لما يُعطيهِ مِن مانِعِ",3,"ع",1,0],["لو أيقَنَ الحَنِقُ الحسودُ عليهِمُ","حَظّي لَحالَتْ رحمةً أضغَانُهُ",4,"ن",2,0],["لو أَيقنَ الواشُونَ حَظّيَ منكُمُ","وصبَابتي بكُمُ لَسرّوا الغَابِطَا",5,"ط",2,0],["لَو إِياسٌ يَلقاهُ قالَ اِعتِرافاً","غَلِطَ الواصِفونَ لي بِالذَكاءِ",6,"ا",2,0],["لو أيرّ النِّصَخ بانفاسي","لَي مِحِب مَيِّت قِضَى حَتْفَه",7,"ف",2,0],["لَو أَيقَنوا أَنّ الفِرارَ مِن الرَدى","ينجيهُمُ فرّوا إِذاً وَتَسلّلوا",8,"ل",3,0],["لو گايل بعت وكت الچنت شَراي","مارخصت سوگي ولاچنت مَصروف",9,"ف",1,0],["لو أيتحصن جزلها منه تحصين","في شامخ(ن)عسر(ن)صعيب(ن)صعوده",10,"د",2,0],["لو أيترداء صاحبي مأترديت","مانيب من خيب رجاء مستجيره",11,"ر",2,0]]}