],[5183,"إن تنصروا الله ينصركم","https://www.poetsgate.com/ViewPoem.aspx?id=185640",""],[5277,"أقاصي الجروح","https://www.poetsgate.com/ViewPoem.aspx?id=198360",""],[5277,"دمعةٌ في مآقي دجلة..","https://www.poetsgate.com/ViewPoem.aspx?id=198594",""],[5279,"حُلْمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=182953",""],[5281,"تُسيئون للطُّهرِ!","https://www.poetsgate.com/ViewPoem.aspx?id=199660",""],[5397,"على الربع دمعي أرسل المد لا الجزرا","https://www.poetsgate.com/ViewPoem.aspx?id=157921",""],[5433,"الطريق المهجور","https://www.poetsgate.com/ViewPoem.aspx?id=36118",""],[5756,"الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=5179",""],[5776,"الهُبوبُ الثّاني","https://www.poetsgate.com/ViewPoem.aspx?id=199446",""],[5781,"جهادُ العاشقين..","https://www.poetsgate.com/ViewPoem.aspx?id=209062",""],[5956,"جواسيسُ عربٌ ضدُّ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=202496",""],[6177,"رَجْعُ الغِياَب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79067&r=&rc=14",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""]],"verses":[["تَخوضُ تَرائِكاً مِنها لُجَيناً","وَتَصدُرُ وَهيَ مِن عَلَقٍ نُضارُ",0,"ر",1,0],["تُخَوِّضُنا البِحارَ مُزَمجِراتٍ","وَتُسلِكُنا المَضايِقَ وَالعُقابا",1,"ب",2,0],["تَخوضُ اللَيلَ يَلمَعُ جانِباها","كَأَنَّ الصُبحَ قَد حَدَرَ النِقابا",1,"ب",2,0],["تَخوضُ الوَغى والقَوْمُ ما بينَ مُلْجِمٍ","أتاهُ الصّريخُ العامريُّ ومُسْرِجِ",2,"ج",1,0],["تَخوضُ خُدارِيَّ الظّلامِ بأوْجُهٍ","تُقايِضُ غَيَّ الدّاعِرِيَّةِ بالرُّشْدِ",3,"د",1,0],["تَخَوَّنَهُمْ صَرْفُ الرَّدَى فَتَخَرَّمُوا","كَمَا انْتَثَرَتْ يَوْماً قِلاَدَةُ عِقْيَانِ",4,"ن",1,0],["تَخَّونَنِي صَرفُ الْحَوَادِثِ فَانْثَنَى","يُقَبِّلُ أَرْدَانِي وَمِنْ بَعْدُ أَرْدَانِي",5,"ن",2,0],["تخَوَّنَهُ صرْفُ الزّمانِ وهلْ ترى","بقاءً لحَيٍّ أو دَواماً على أمْرِ",6,"ر",1,0],["تَخَوَّفَ السَيرَ مِنها تامِكاً قَرِداً","كَما تَخَوَّفَ ظَهرَ النَبعَةِ السَفَنُ",7,"ن",1,1],["تخوّنه ريب الزمان فاولعت","بإخلاقها ديباجتيه يد الفقر",8,"ر",1,0],["تخوض فياشل الأوغا","د لجته وتخترق",9,"ق",1,0],["تَخَوِّفُني رَيبَ المَنونُ وَقَد مَضى","لَنا سَلَفٌ قَيسٌ مَعاً وَرَبيعُ",10,"ع",1,0],["تَخوضُ بِهِ الظَلماءَ ذاتُ مُخيلَةٍ","جُمالِيَّةٍ قَد زالَ عَنها المُناظِرُ",11,"ر",1,0],["تُخَوِّفُني دونَ الَّذي أَمَرَت بِهِ","وَلَم تَدرِ أَنَّ العارَ شَرُّ العَواقِبِ",12,"ب",1,0],["تَخونُ المَنايا عَهدَهُ في سَليلِهِ","وَتَنصُرُهُ بَينَ الفَوارِسِ وَالرَجلِ",13,"ل",1,0],["تُخوِّفُني ريبَ الزمانِ وأنَّهُ","شروبٌ لأشلاءِ الكِرامِ أكُولُ",14,"ل",1,0],["تَخَوَّنَهُ خَطبٌ تَخَوَّنَ قَبلَهُ","حُسَينَ النَدى وَالسُؤدَدِ المُتَواتِرِ",15,"ر",1,0],["تَخوضُ إِذا صاحَ الصَدى بَعدَ هَجعَةٍ","مِنَ اللَيلِ مُلتَجّاً غَياطِلُهُ خُضرا",16,"ر",2,0],["تَخوضُ فُروجَهُ حَتّى أَتَتنا","عَلى بُعدِ المَناخِ مِنَ المَزارِ",17,"ر",1,0],["تَخَوَّنَها تَهجيرُ كُلِّ وَديقَةٍ","إِلى أَن أَتَت مُخَّ السُلامى شُحومُها",18,"م",3,0],["تَخونُني مَع وُفورِ الخَيلِ وَالعُدَدِ","لَكِنَّ قَومي وَإِن كانوا ذَوي عَدَدِ",19,"د",1,0],["تَخوضُ الحربَ شُبّاناً وشِيباً","وتغشى القتلَ أبكاراً وعونا",20,"ن",2,0],["تخوضُ الدمَ المسفوكَ لا جِسْرَ دُونَهُ","وما لَكَ كالإيمانِ في مثلِهِ جِسْرُ",21,"ر",1,0],["تَخَوَّلتَ مَخزوماً وَفُزتَ بِهاشِمٍ","فَأَصبَحتَ مِن فَرعَي قُرَيشٍ مُرَدَّدا",22,"د",2,0],["تُخَوِّفُنا مِن أُمِّ دَفرٍ خَديعَةً","وَمَكراً فَلَم تَذرِ الدُموعَ وَلَم تُذرِ",23,"ر",1,0],["تَخوّنَ أَربَعي وَمَضى بِخَمسي","وَأَعلَقَ في حِبالِ الشَمسِ عَشري",24,"ر",2,0],["تَخونُ أَمينَكَ دينارُهُ","وَفي رُبعِهِ يُقطَعُ السارِقُ",25,"ق",1,0],["تَخونُ الأَوَّلَ العَهدَ","فَخَلِّ العِرسَ أَو شارِك",26,"ك",1,0],["تَخَوَّفَ السَّيْرُ مِنْهَا تامِكاً قَرِداً","كمَا تَخَوَّفَ عُودَ النَّبْعَةِ السَّفَنُ",27,"ن",1,1],["تخوض الدُّجى سهمانَ والنجمُ حائر","يسائل من ذاك الشقيُّ المجازفُ",28,"ف",1,0],["تخوّنوني بسعاياتهم","فغيروا نية إخواني",29,"ن",2,0],["تَخَوَّنَتْني رجالٌ طالَما شَكَرتْ","عَهْدِي وأَثنَتْ بما راعيْتُ من ذِممِ",30,"م",1,0],["تخونه صرف الزمان وهل ترى","دواما لحال أو بقاء على أمر",31,"ر",1,0],["تخوض بالشعر تستجلي قوافيه","وانت تعلم اني اشعر العرب",32,"ب",1,0],["تخون الأرض أخيلهم فتردى","قوائمهن في الأرض انسياخ",33,"خ",1,0],["تخوضُ غمارَ الآلِ مثل سفينةٍ","ببحرٍ متى نِيْطَتْ عليه حمولُها",34,"ل",3,0],["تَخوضُ بَحرَ السَرابِ مِنها","سَفائِنٌ رَكبُها القُلوعُ",35,"ع",1,0],["تَخوضُ دِماءَ أَفئِدَةِ الأَعادي","فَمِنهُ عَلى مَعاصِمِها خِضابُ",36,"ب",1,0],["تخوض دم الاعداء جرد جياده","فأعراقها سحم وارجلها ورد",37,"د",1,0],["تَخُوضُ لنيْلِ الثّأر فيهِم خُضَارَةً","كَتيبَتُهُ الخَضْراءُ غُلْباً عَلى جُرْدِ",38,"د",1,0],["تَخَوَّنَتِ الأَيّامُ حالِي وَأَقْسَمَتْ","عَلَيَّ اللَّيالِي أَنْ أَعِيشَ بِلا قِسْمِ",39,"م",1,0],["تخوفني بالبعد عند دلالها","ولكن لها قلب على البعد لا يقوى",40,"و",2,0],["تَخوض به سبحاً طويلاً ويَنثني","وما عبرت عبرا ولا زاحمت ثعبا",41,"ب",2,0],["تَخَوَّفَ مِنها أَن يَقولَ مَتى الوَعدُ","وَلَيسَ لَها بِالوَعدِ مُذ وَعَدَت عَهدُ",42,"د",1,1],["تَخوض حَشا اللَيل رُكبانُهُ","وَتَدرع النَقع فُرسانَهُ",43,"ن",2,0],["تَخَوَّنَتْني كلَّ يوم نكبةٌ","ضرامها في كل آن تُحتَضا",44,"ا",1,0],["تخونُ أموالُه أناملَهُ","ولم يزلْ في الرواة مُؤتَمَنا",45,"ن",2,0],["تُخَوِّفُنِي طولَ السِّفارِ وإِنَّهُ","لتقبيلِ كفِّ العامِريّ سَفِيرُ",46,"ر",1,0],["تخوّن من خزيمةَ عرضتيها","لنبلي فاحتمت بالأزد مني",47,"ن",2,0],["تخوض نجيع القِرن من قبل مورد","ويدمى قناها قبل يَدْمي شيمُها",48,"م",3,0],["تخوَّنهُ الطَّوي فَغدا سَقيماً","ولم يرَ عندهُ الآسي سَقاما",49,"م",2,0],["تخوَّنهُ صوْمُ الهَجيرِ نَحافةً","وثَمَّ المَساعي والجدودُ ضِخامُ",50,"م",1,0],["تخونتها الليالي فهي طامسة","كما تخون جسماً دائمُ السقم",51,"م",1,0],["تخوضُ بهم في غمرةِ الآلِ كلَّما","تكنَّفها كَومُ المطايا وَقُودُها",52,"د",3,0],["تخوضُ الدجى والقفرَ حتى كأنّما","يناهِبُها البيدَ النعامُ المصلَّمُ",53,"م",1,0],["تخوض بحارا لا تنال بحيلة","على رغم من باءوا بخبث الطويتي",54,"ت",2,0],["تخون عقود الله بعد انعقادها","وأقبح شيءٍ أن يزلَّ المعاهد",55,"د",1,0],["تخوي العُروشُ إذا ما غِبْتَ عن بلدٍ","حتّى تعودَ فيَحْيى ميْتُهُ الخَرِبُ",56,"ب",1,0],["تخوفت منها أن تنم إليهم","بمسراكم والريح أم النمائم",57,"م",1,0],["تخوّفنا أبناءُ قيسٍ وعيدَهمْ","وَلو أنّنا نخشى الوعيد لما سُدْنا",58,"ن",2,0],["تَخوضُ بَحرَ الرّدى وَالمجدُ ساحِلهُ","بِوَجهِ مُغتفرٍ أَو فعلِ منتقمِ",59,"م",1,0],["تخوّفني الخرقاءُ أوْبَةَ خائفٍ","وما الحزمُ سلطاناً على كلّ عائقِ",60,"ق",1,0],["تَخُوضُ فيها الجواري المنشآتُ بِنا","من النُّهَى لا منَ الأَلواحِ والدُسُرِ",61,"ر",1,0],["تَخُونُني الرِّيحُ في حَمْلِ السَّلامِ لهم","منّي وتَكتُمُ عنّي صادقَ الخَبَرِ",62,"ر",1,0],["تخوَّفَ من صَدِّي فصدَّ تَجنُّباً","وذلك ذنبٌ لم أَكُنْ من جُنَاتِه",63,"ت",2,0],["تَخَوَّنَهُ الدَهرُ إِخوانَهُ","كَثيرَةُ قَد كُنتِ بي عالِمَه",64,"م",2,0],["تخونتها بالنص حتى كأنها","هلال يوافي كفه الليل واضح",65,"ح",1,1],["تَخوضُ إِذا اِهتاجَت بحورَ مَفاوزٍ","وَتَسهلُ إِدلاجاً لَديها البسائسُ",66,"س",1,0],["تخوّدُ تخويدَ النَّعامةِ بعدما","تصوّبت الجوزاءُ قصدَ المغاربِ",67,"ب",1,0],["تخوضه العين ولكنها","تخوض منه معمعان السراب",68,"ب",1,0],["تخوض منه المقربا","ت الجرد بحرا مزبدا",69,"د",2,0],["تخوض غمار الغي قد حال بينها","وبينك منها غمرة فوق غمرة",70,"ه",1,0],["تخوّنه العفاء كما تراه","فأمسى لا رسوم ولا طلولا",71,"ل",2,0],["تخَوّف تُخمَةَ أَصحابِهِ","فَعَوّدَهُم أَكلَةً واحِدَه",72,"ه",1,0],["تُخَوِّفُنِي الدَّوَاهِي وَهيَ عِندِي","أَقَلُّ مِنَ ان أَضِيقَ بهَا جَنَابا",73,"ب",2,0],["تخوضين المياه وأَنتَ عطشي","فَلَم لا تشربين من المياه",74,"ا",2,0],["تخوف مسك الخال من نار خدها","ومن مشرفيّات الجفون الفواتنِ",75,"ن",1,1],["تُخَوِّفُني صَرفَ الزمانِ وقد حَدَث","برحلي إلى ابنِ الحَضْرَمِيِّ ركاب",76,"ب",1,0],["تخوض نار الحرب لا تنثنى","إلا بعزٍ وانتصار صراح",77,"ح",1,0],["تخوض الوغى عريانة لتخيفه","ولو سئلت لم تعرف الخوف والأمنا",78,"ن",2,0],["تخوفه المنون جنود حرب","وهل يخشى المنون ابن الحروب",79,"ب",1,0],["تخور به الغزلان كل عشية","الى كل خشف كالسوار وتخرج",80,"ج",1,0],["تَخَوَّضتُها حَتّى يُفَرِّجنَ غَمَّها","وَيَنجابُ عَن أَعناقِهِنَّ ثِيابُها",81,"ب",3,0],["تَخُوضُ خِضَمَّ البحر عَبَّ عُبابهُ","كَصُمِّ صُخورٍ في غَديرٍ من السَّرْد",82,"د",1,0],["تُخَوِّفُني جَيْبٌ بكُثْر عَدِيدِها","وما لجنودِ اللهِ حَوْليَ مِنْ عَدِّ",82,"د",1,0],["تخوض الجداول في زورق","يشقُّ بمسراه عذب الورود",83,"د",1,0],["تخونُكَ البركةُ تلكَ التي","سَقاكَ منها أمسِ أكوابا",84,"ب",2,0],["تخوض بجهل سادراً في فكاهة","وتدخل في غي الغواة وتشركُ",85,"ك",1,0],["تخوض غامرها مستنبطاً غررا","تبقى على كرّ أيام وأعوام",86,"م",1,0],["تَخوضُ الطَّوامِيَ خَوْضَ المَوَامِي","لِهَصْرِ المعَادِي ونَصْرِ المُوَالِي",87,"ل",2,0],["تخوض فوق سفين الخيل بحر دم","بالبيض والسمر زخار مموجه",88,"ج",2,0],["تخوضُ بنا بحْرَ السّرابِ ظعائِنٌ","فللّه عيْنَا مَن رأى البحرَ والسُّفْنا",89,"ن",2,0],["تخوضُ إلى الأعْداءِ بحْراً من القَنا","سِراعاً وهَوْلُ الرّوْعِ ليسَ يَهولُها",90,"ل",3,0],["تخونَ عزَّ ساكنها زمانٌ","تلعبَ بالقرون الأولينا",91,"ن",2,0],["تخوّنها الجور فاستدركت","بعدْلِك أغبار ظبظابها",92,"ب",3,0],["تَخوض إِلَيكَ مَوج اليَم شَوقاً","وَفي البَيداءِ تَقطَعُ كُل واد",93,"د",1,0],["تَخوض غمار الحرب لا متنكراً","وَلا القلب خفاق وَلا الوجه شاحب",94,"ب",1,0],["تخوض بحار النقس عَرفاً بثغرها","وتروي ظماءِ الطرس جرياً بجرَّة",95,"ه",1,0],["تخوّف الرحل منها تامكا قردا","كما تخوّف عود النبعة السفنُ",96,"ن",1,0],["تخونهم القوافي إن أرادوا","مديح سواه ثم تتيه صدا",97,"د",2,0],["تخوض زوجي في كل الفنون وما","تخشى خطاء ولا ردا مع الظرفا",98,"ف",2,1],["تخوّلتها في خلقة وخليقة","وإن لم تكن أنت الخليق بها فمنْ",99,"ن",1,0],["تخوض البحرَ مِن دمِنا","لِتَقصدَ قاعَه السُّفلَى",100,"ل",2,0],["تخوفني النيران في كل ساعة","وأصبو إلى الجنات ما بين خلان",101,"ن",1,0],["تخونني في خِضّمِّ الشوقِ مرساتي","وتلكَ أشرعةُ الأبحارِ آهاتي",102,"ت",2,1],["تخوض بحر المنايا وهي صامدةٌ","إلى المسالح في فلك الخيانات",103,"ت",1,0],["تخوَّفَ قلبي بعدَها الحزنَ والأسى","وآهٍ لقلبي دائماً يتخوَّفُ",104,"ف",1,0],["تخونُ جوعي لوجهِ القحطِ سنبلةٌ","كأنّها من عجافٍ تأكلُ الحجرا",105,"ر",2,0],["تَخُوضُونَ بَحْرًا عَمِيقًا وَعَالٍ","وَتُلْقَوْنَ رُعْبًا بِجَوٍّ وَبَرْ",106,"ر",1,0],["تَخُوضُون فِي عِرْضِه فِتْنَةً","وَنَحْنُ لِعِرضِ الرَّسولِ الْفِداءْ",107,"ا",2,0],["تخوض المنايا السود بيضك فوقها","وزرق القنا تتلو كتيبتك الخضرا",108,"ر",2,0],["تخوفني مشاوير الطريق المظلم المهجور","واليامني ذكرتك قلت طولي يامشاويري",109,"ر",2,1],["تخونين،وتبين أرضى!واحد يرضى تخونينه!","أنا لاجي