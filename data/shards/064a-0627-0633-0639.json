ي للحسنيين وتحدو",227,"د",2,0],["يا سعوداً لك النعيم المرجى","خلف صبر الولي والموت شد",227,"د",1,0],["يا سعد إن جئت ذّياك المقام فقم","وحيِّ باللطف عني حيَّ واديه",228,"ي",2,0],["يا سعود العلياء يا واحد الفضل","ولياً يا زينة المحراب",229,"ب",1,0],["يا سعد حيِّ الأمالي في أمانيها","وحيِّ باللطف عنا حيَّ واديها",230,"ي",3,1],["يا سعد ما سعدي وما فخري","إلا ببسط يدي على فقري",231,"ر",2,1],["يا سعد خذ بيديه مذكرا","أطفاله بالخير يا سعد",232,"د",1,0],["يا سعد صح بالربع يا سعد","جاء المغير وخيله الجرد",233,"د",1,1],["يا سعدُ من فهمَ الدُنا","متجنِّباً فيها الرسوبْ",234,"ب",1,1],["يا سَعْدَ منْ أرْضى الإلهَ بحُبِّهَ","رَغدُ الجِنانِ وصُحْبَةٌ كُرماءُ",235,"ا",2,0],["يا سعد يا بن أبي وقاص قم عجلا","بغت علينا ومن ذل أكاسره",236,"ر",2,0],["يا سعدَ منْ دانى الوصالَ بليلِهِ","وتتابعتْ بلقائِهِ الأيامُ",237,"م",1,0],["يا سعدَ رفرفةِ الحمامِ بسربِه","أنت العرائشُ والسماءُ الصافيهْ",238,"ف",3,0],["يا سعد اللي نظرها","وتحف بها الاسرار",239,"ر",1,0],["يا سعادة من لفى دارك","إلانالي بي الوزا باني",240,"ن",2,0],["يا سعد للقانون فلسفةٌ","ملعونةٌ لن تقبل الدعوى",241,"و",2,0],["ياسعود لاصكت علي الغلايب","قربت لي من نادر الذود طفحا",242,"ح",2,1],["ياسعد من مثلك على دربه ارجال","ومدهل وفا مايسكنه دونك الغير",243,"ر",1,0],["٩- يا \"سعْدُ\"، اِرْمِ سِهامَ الوصْلِ مجْتهِدًا","حتى تجُزَّ نِياقَ البيْنِ مُغتَنِما",244,"م",2,0],["١- يا \"سعْدُ\" هل لي لما ألقاهُ من راقِ؟","فقد جرى الحبْرُ نيرانًا بأوراقي",245,"ق",2,1],["يا (سعيدٌ) سعدت حيّاً وميتاً","إنه الفوز أيها الأتقياء",246,"ا",2,0],["ياسعود هاك العلم وارقى به سنود","ومثلك يسند للمعالي سموه",247,"و",2,1],["ياسعود علمي جاك وارقى به سنود","ومثلك يسند للمعالي سموه",247,"و",2,0],["يا سعد من في حمى سورية سكنوا","مذحلها قلت قد حل الهنا فيها",248,"ي",3,0],["يا سعد بيروت هذا الشهم قائدنا","وهو الكفيل بحفظ العهد والذممِ",249,"م",1,0],["يا سعد عبد تابع لرشادكم","يُهدي بنبراس العلوم الزاهرِ",250,"ر",1,0],["يا (سعيدُ العَمْرُو) المتيَّمُ بالقدْسِ","هنيئاً بالْمجْدِ والعَلْياءِ !",251,"ا",2,0],["يا سعد قم وانظر تجد ما نستحي","من ذكره بعد الجهاد الغابر",