877,"الكيف","https://www.poetsgate.com/ViewPoem.aspx?id=52287",""],[192,"يا كويت","https://www.poetsgate.com/ViewPoem.aspx?id=16377",""],[5977,"سنابل المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=213793",""],[6008,"ياسعود","https://www.poetsgate.com/ViewPoem.aspx?id=60804",""],[6046,"هاجر لتنشئ دولة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=36938",""],[6335,"قراءة في قسمات وجه عربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65401&r=&rc=3",""]],"verses":[["يا سَعدُ سَعدَ الخَيلِ وَالإِبِلِ","إِدفَع صُدورَ الأَينُقِ البُزُلِ",0,"ل",1,1],["يا سَعدَ كُلِّ فُؤادٍ في بُيوتِكُمُ","مِثلي تَحَكَّمَ فيهِ الظَلمُ وَالشَنَبُ",1,"ب",1,1],["يا سَعدُ أَعظَمُ مِحنَةً","مَن لا يُرَوِّعُهُ العِتابُ",2,"ب",1,0],["يا سَعدُ هَل لي وَهَذااللَّيلُ يَشهَدُ لي","بِما أُقاسي لَدى التَّسهيدِ مِن فَرَجِ",3,"ج",1,0],["يا سَعدُ إِنَّ فِراقاً كنتَ تحذَرُهُ","دَنا ليَنزِعَ مِن أَحشائِكَ الكَبِدا",4,"د",2,0],["يا سَعْدُ كَمْ لكَ منْ نَعْماءَ جُدْتَ بِها","حتّى تَرَكْتَ الحَيا يُعْزى إِلى البَخَلِ",5,"ل",1,0],["يا سَعْدُ إنّ الصِّلَّ عِندَكَ مُطْرِقٌ","فاحْذَرْ سُؤورَ مُنَضْنِضٍ نَهّاشِ",6,"ش",1,0],["يا سَعدُ إنّ الجِزْعَ أكثَبَ فاسْتَعِرْ","نَظَراتِ طاوي ليلَتَينِ شَفونِ",7,"ن",1,0],["يا سَعدُ ذا اللِّمَّةِ المُرخاةِ ما عَلِقَتْ","مِنْكَ الخُطوبُ بِكابي الزِّنْدِ هِلْباجِ",8,"ج",1,0],["يا سَعدُ كَيفَ قَضى سَعي","دٌ وَهوَ مِن سَعدٍ قَريب",9,"ب",1,0],["يا سَعدُ أَنتَ مَسيحُها","فَاِجعَل لِهَذا المَوتِ حَدّا",10,"د",2,0],["يا سَعدُ إِنَّ بِمِصرَ أَي","تاماً تُؤَمِّلُ فيكَ سَعدا",10,"د",2,0],["يا سَعدُ إِنَّكَ أَنتَ أَعظَمُ عُدَّةٍ","ذُخِرَت لَنا نَسطو بِها وَنَصولُ",11,"ل",1,0],["يا سَعدُ أَنتَ زَعيمُنا وَوَكيلُنا","وَعَلَيكَ عِندَ مَليكِنا التَعويلُ",11,"ل",1,0],["يا سَعدُ كادَ العيدُ يُصبِحُ مَأتَماً","الدَمعُ فيهِ أَسىً عَلَيكَ يَسيلُ",11,"ل",1,0],["يَا سَعْدُ جَلَّتْ مَأْثُرَاتُكَ عِنْدَهَا","عَنْ أَبْلَغِ الإِطْرَاءِ فِي أَقْوَالِهَا",12,"ل",3,0],["يا سعد دين الله عش متمتعاً","أما بكسب ثنا وكسبِ ثواب",13,"ب",1,0],["يا سعد دين الله أين الذي","عوّدت من برٍّ وتيسير",14,"ر",1,1],["يا سعد إن أنت دخلت لوندرة","منتصرا مظفرا كعنترة",15,"ه",1,1],["يا سَعيدُ اِتَّئِد وَرِفقاً بِشَيخٍ","والِهٍ مِن لَواعِجِ الثُكلِ والِه",16,"ل",2,0],["يا سَعدُ قَد جَرَتِ الأُمورُ لِغايَةٍ","اللَهُ هَيَّأَها لَنا ما شاءَ",17,"ا",2,0],["يا سَعيدٌ وَالأَمرُ فيكَ عَجيبُ","أَينَ ذاكَ التَأهيلُ وَالتَرحيبُ",18,"ب",1,1],["يا سَعدُ إِنَّكَ قَد حَجَبتَ ثَلاثَةً","كُلٌّ عَلَيهِ مِنكَ وَشمٌ لائِحُ",19,"ح",1,1],["يا سعدُ زُرْ أرضَ المعرةِ نائباً","عنِّي وسرْ فيها مسيرَ مبجَّلِ",20,"ل",1,0],["يا سعدُ إنْ عاينْتَ بهجةَ طيبةٍ","فابشرْ بكونِكَ ناجياً فيمن نجا",21,"ج",2,0],["يا سعدُ ساعدني على هجرانِهم","في اللّهِ هجرُ مجانبٍ متوارِ",22,"ر",1,0],["يا سعدُ عَلِّلْ نُفوسَ القومِ ثانيةً","إن كان ينفعُ بعدَ اليومِ تعليلُ",23,"ل",1,0],["يا سعدُ ما راعني ما نِلْتَ من خطرٍ","وإنّما راعني أن يُعبَدَ الصَّنمُ",24,"م",1,0],["يا سعدُ إنّ سبيلَ الحقِّ بَيِّنةٌ","للسّالكين وإنّ الأمرَ قد وضحا",25,"ح",2,0],["يا سعدُ لا تَقْتحِمْها خُطَّةً حَرَجاً","فإنّ حولك للأحرارِ مُنتدَحا",25,"ح",2,0],["يا سعدُ إن مَنَع الأقوامُ أو منحوا","فإننا مَعشرٌ لا نعرفُ المِنَحا",25,"ح",2,0],["يا سعدُ حَسْبُكَ عِرفاناً وتجربةً","وحسبُنا ما جَنَى الماضي وما اجترحا",25,"ح",2,0],["يا سَعدُ إِنَّكَ ذو عِلمٍ وَتَجرِبَةٍ","فَاربَأ بِنَفسِكَ عَن خِزىً وَخُسرانِ",26,"ن",1,0],["يا سَعدُ إِنَّ عُقوقَ النَفسِ مهلكَةً","فَاِستَبقِ نَفسَكَ وَاِحذَر بَطشَ باريها",27,"ي",3,0],["يا سعد أدَّيتَ حقَّ اللَّهِ من ثَمَرٍ","لو كانَ من ذَهَبٍ ما زِدْتَه عِظَما",28,"م",2,0],["يا سعدُ خطبُكَ عند كلِّ مُوَحِّدٍ","خَطبٌ يجيءُ بهِ الزَّمانُ ويرجِعُ",29,"ع",1,0],["يا سعدُ ما نَسِيَ العريشَ مُقيمُه","يحمي غِياثَ العالمين ويمنعُ",29,"ع",1,0],["يا سَعد يا ابن النيل رَنَّقَ ماءه","ثكلُ البَنين وَهَل كَسَعدِ يولد",30,"د",1,0],["يا سَعد شَأنك وَالبُطولَةَ أَنَّها","تَجثو لَديك وَأَنتَ أَنتَ السَيد",30,"د",1,0],["يا سُعدَ إِنّي عَداني عَن زِيارَتِكُم","تَقاذُفُ الهَمِّ وَالمَهرِيَّةُ النُجُبُ",31,"ب",1,0],["يا سَعدُ إِنَّ أَبا سَعدٍ لَحادِثُهُ","أَمسى الحِمامُ يُسَمّى عِندَهُ فَرَجا",32,"ج",2,1],["يا سَعْدَ أخْبِيَةِ الّذينَ تَحَمَّلوا","لمّا رَكِبْتِ دُعيتِ سَعْدَ المَرْكَب",33,"ب",1,0],["يَا سَعْدُ قُلْ لِي فَأَنْتَ أَدْرَى","مَتَى رِعَانُ الْعَقِيقِ تَبْدُو",34,"د",2,0],["يَا سَعْدُ مَنْ سَاسَهُمْ مَلِيكٌ","لِشَعْبِهِ مُسْعِدٌ وَهَادِ",35,"د",1,0],["يَا سَعْدَ هَذِي اللَّيْلَةِ الزَّهْرَاءِ","جَدَّدْتِ عَهْدَ السَّعْدِ بِالْحَمْرَاءِ",36,"ا",2,1],["يَا سَعْدَ قَوْمٍ وَلِيتَ فِيهِمْ","وِلاَيَةَ المُصْلِحِ المُشِيحِ",37,"ح",1,0],["يَا سَعْدُ طَائِفَةٍ سَامُوكَ رَاعِيَها","في أَمْسِكَ ابْنٌ لَهَا وَالْيَومَ أَنْتَ أَبُ",38,"ب",1,0],["يا سُعدُ هاتي لي بِعَيشِكِ قَبضَةً","مِن بَيتِها لِأَشُمَّ ريحَ تُرابِها",39,"ب",3,0],["يا سَعْدُ أَنْتَ لَها إِذَا","لَهَبُ الْجِدَالِ عَلاَ وَشَبَّا",40,"ب",2,0],["يا سَعْدُ أَنْتَ لَها إِذا","ما صَرْصَرُ الأَحْداثِ هَبَّا",40,"ب",2,0],["يا سعد أمّا موطني فمهدَّدٌ","- إن لم يُعَدْ بنيانه – بهلاك",41,"ك",1,0],["يا سعدُ أبلغُ من قصيدةِ شاعرٍ","يبني القوافي فيك دمعة شاكي",41,"ك",2,0],["يا سعدُ ما قدري وقدرُ نياحتي","كلُّ البلادِ نوائحٌ وبواكي",41,"ك",2,0],["يا سعد كرر ما استطعت حديثهم","فهم لدى الأحباب لب لباب",42,"ب",1,0],["يا سعدُ إن كنت البشير بوصله","فلقد أتيت على المسرة والوفا",43,"ف",2,0],["يا سَعدَ سعدٍ أرضعتهُ فتاتُها","قويَت مطيّتها ودرّت شاتها",44,"ه",2,0],["يا سعدُ هذا عصرُنا فدعِ النيا","قَ يشفها الإتهامُ والإنجادُ",45,"د",1,0],["يا سعد من بسم الزما","ن ببيته فغدا أباك",46,"ك",1,0],["يا سعد سر مترنماً","ببشائر السعد المبين",47,"ن",1,1],["يا سعاداً هذي عُيونُ العَذارى","باسِماتٌ جَميعُها لسعادِ",48,"د",1,0],["يا سعاداً غَداً نَراك فَتاةً","تَسكُبين الهَوى بِكُلِّ فُؤادِ",48,"د",1,0],["يا سعاداً غَداً تَرينَ قُدوداً","مُسكِراتٍ تُباعُ بَيعَ المَزادِ",48,"د",1,0],["يا سَعدُ يا خيرَ أخٍ","نازَعْتُ دَرَّ الحلمَهْ",49,"م",2,1],["يا سَعْدُ كمْ أوقدتَ للأ","ضيافِ ناراً زَهِمَه",49,"م",2,0],["يا سَعدُ لي قَلبُ أَسيرٌ في الهَوى","عَرِّج عَساكَ تَهُمُّ في إِطلاقِهِ",50,"ق",2,0],["ياسَعدُ أَنجَدني عَلى ال","بُرَحاءِ إِسعادَ الخَليلِ",51,"ل",1,0],["يا سَعَةَ الأَيّامِ ما","أَضيَقَ فيكِ مَذهَبي",52,"ب",2,0],["ياسَعدُ إِلمامَةً عَلى إِضَمٍ","فَالهَضبِ مِن راكِسٍ فَمَلحوبِ",53,"ب",1,0],["يا سَعْدَهُ مِنْ قادِمٍ سُرَّ السُّرُو","رُ بِهِ وَهُنَّئَ بِالخُلُودِ هَناؤُهُ",54,"ا",3,0],["يا سَعدُ عَدِّ عَن هَوىً","فيهِ اِرتَكَبتَ الخَطَرا",55,"ر",2,0],["يا سعد سربي نحو ربع حبي","فالشوق قد قطع نياط قلبي",56,"ي",1,0],["يا سعد قلبي حزين","على فراق الربوع",57,"ع",1,1],["يا سعد ما كان في ظني","أن الأحبة والجيران",58,"ن",1,0],["يا سعد راح الوفى واُهلٌ وراح الجميل","وراح ذا القوم لي كانوا هداة السبيل",59,"ل",1,1],["يا سعد قف بي على الطلول","أبكي على الأحبة",60,"ه",1,1],["يا سَعيداً بِهِ كَواكب سعدي","أَشرَقَت بَهجَة وَأرضي سَماءُ",61,"ا",2,1],["يا سعد قلبي ما سلا ولا طاب","وزاد حزنه والحنين",62,"ن",1,1],["يا سعد حدث مسرعاً","عنهم ودع عنك التأني",63,"ن",2,0],["يا سعد خذ بأبي وأمي","ذات اليمين بسفح سلم",64,"م",1,1],["يا سعد في دهري وفتنته","شغل لقلبي أيَّما شغل",65,"ل",1,0],["يا سَعْدُ لا الوعدُ بالقاصي أرِقت له","ولا اصطباري بعد النأي بالداني",66,"ن",2,0],["يا سعد قد نفرت أوانس ربرب","بنوىً يشطّ به المزار شطوني",67,"ن",2,0],["يا سعد حين ذكرت شرقيّ الحمى","هل كانَ قلبي في جناحي طائر",68,"ر",1,0],["يا سعد قد ألف السهاد متيَّمٌ","دامي الحشاشة مستهام شيّق",69,"ق",1,0],["يا سعدها تاريخها","بجوده غراءُ",70,"ا",2,0],["يا سعد من نظرت عيناه روضتها","ونزه الطرف في فياح مغناها",71,"ا",3,0],["يا سعدنا إن لامحت أبصارنا","أنواره وسنا محاملنا السنا",72,"ن",2,0],["يا سعد جدي إذ لاقيته بكمو","غدا بجنة عدن والخطير نضا",73,"ض",2,0],["يا سعد جدي إذا ما رحمة سبقت","لي منك أحشر في قوم تواليكا",74,"ك",2,0],["يا سعدُ أحرِزْها يداً مذخورةً","تُولِي أخاً قمِناً بشكر النائلِ",75,"ل",1,0],["يا سعدُ هل لمياءُ تبسم موهناً","أم ذاك برقُ الأبرقينِ تألقاً",76,"ق",2,0],["يا سعد قد بان العذيب وبانه","فانزل فديتك قد بدا إسعادي",77,"د",2,0],["يا سُعادُ الله في قلبي بهِمْ","قد شقَقْتِ يا سُعادُ الحُجُبا",78,"ب",2,0],["يا سَعدُ إِن أَبصَرَت عَيناكَ كاظِمَةً","وَجئت سِلَعاً فَسَل عَن أَهلِها القدُمِ",79,"م",1,0],["يا سَعدُ إِن ساعَدَ الإِسعادُ وَاِجتَمَعَت","لَكَ الأَماني وَجئت الحَيّ عَن أُمَمِ",79,"م",1,0],["يا سَعدَنا لَم يجد فيك الزّمانُ وقد","بلاك موضعَ إخشاعٍ وقد وجدا",80,"د",2,0],["يا سعد