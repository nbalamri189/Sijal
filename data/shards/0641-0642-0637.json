{"poems":[[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[72,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[72,"أسفي على زمن التلاقي","https://www.aldiwan.net/poem42789.html","مجزوء الكامل"],[47,"بين الشقيقة فاللوى فالأجرع","https://www.aldiwan.net/poem64692.html","الكامل"],[63,"لقد طمع البشري في ولم يكن","https://www.aldiwan.net/poem51804.html","الطويل"],[50,"رأيت الفضل مكتإبا","https://www.aldiwan.net/poem64480.html","مجزوء الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141988","الكامل"],[56,"أعوذُ باللهِ منْ ليلٍ يقرِّبني","https://www.poetsgate.com/ViewPoem.aspx?id=13901",""],[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[113,"ومذ كشف الفصاد عن زنده رأى","https://www.aldiwan.net/poem16473.html","الطويل"],[186,"تصبر وإن لم تملك الصبر فاجزع","https://www.aldiwan.net/poem67051.html","الطويل"],[197,"بالأمس قد قال الحجى لي","https://www.aldiwan.net/poem13121.html","مجزوء الكامل"],[201,"يا جارة الوادي طربت وعادني","https://www.aldiwan.net/poem39810.html","الكامل"],[242,"رب من صادني وبرحبي","https://www.aldiwan.net/poem18047.html","الخفيف"],[285,"أبعدك أتقي نوب الزمان","https://www.aldiwan.net/poem60705.html","الوافر"],[303,"برح الخفاء فلست أكتم لوعة","https://www.aldiwan.net/poem36808.html","عموديه"],[325,"بك العلا تظاهر","https://www.aldiwan.net/poem67198.html","مجزوء الرجز"],[369,"خيال زائر مني خيالا","https://www.aldiwan.net/poem60676.html","الوافر"],[385,"واحر غلة قلبي الوقاد","https://www.aldiwan.net/poem48838.html","الكامل"],[438,"كانت يد لك عند عبد","https://www.aldiwan.net/poem12805.html","مجزوء الكامل"],[445,"أنضيت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34916.html","الكامل"],[466,"اذا الأبطال مارست المنايا","https://www.aldiwan.net/poem15405.html","الوافر"],[534,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[543,"قد سقانا جرعة يوم الفراق","https://www.aldiwan.net/poem47544.html","عموديه"],[556,"يا مالكا رقي بلا ثمن","https://www.aldiwan.net/poem47157.html","أحذ الكامل"],[556,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[558,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2456","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122584","الخفيف"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104599","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77518","الرجز"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123399","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59785","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59685","الطويل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17606","الكامل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107229","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25350","الرجز"],[1276,"","https://poetry.dctabudhabi.ae/diwan/poem/123673","السريع"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49971","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108713","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108501","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128757","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106846","المتقارب"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60860","الكامل"],[2621,"","https://poetry.dctabudhabi.ae/diwan/poem/199833","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65993","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121555","السريع"],[3428,"","https://poetry.dctabudhabi.ae/diwan/poem/124017","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117967","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133242","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29312","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111394","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199074","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97095","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133114","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58095","الوافر"],[4691,"سجال الإجازة زياد بنجر وظميان غدير","https://www.poetsgate.com/ViewPoem.aspx?id=110553",""],[4856,"رحيلٌ مؤقت","https://www.poetsgate.com/ViewPoem.aspx?id=36269",""],[4884,"قهوة أمي","https://www.poetsgate.com/ViewPoem.aspx?id=210383",""],[4927,"قصيدة لعيني عُروة وعَفْراء","https://www.poetsgate.com/ViewPoem.aspx?id=29954",""],[5246,"تقلب الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=187046",""],[5431,"لغتنا تتكلم ...","https://www.poetsgate.com/ViewPoem.aspx?id=201472",""],[5431,"يوتوبيا...","https://www.poetsgate.com/ViewPoem.aspx?id=215433",""],[5616,"صرخة","https://www.poetsgate.com/ViewPoem.aspx?id=204843",""],[5638,"يا قدس صبرًا","https://www.poetsgate.com/ViewPoem.aspx?id=198037",""],[5703,"ياشاهر السيف","https://www.poetsgate.com/ViewPoem.aspx?id=206123",""],[5804,"لا تلم في الزمان حرا غريبا","https://www.poetsgate.com/ViewPoem.aspx?id=215193",""],[5851,"وعد الغمام للأرض","https://www.poetsgate.com/ViewPoem.aspx?id=175307",""],[5858,"الحروف العاثره","https://www.poetsgate.com/ViewPoem.aspx?id=188024",""],[5910,"خَطَّتْ سطورَ البينِ","https://www.poetsgate.com/ViewPoem.aspx?id=206277",""],[5956,"أخشى الجُنون بآخر العمر","https://www.poetsgate.com/ViewPoem.aspx?id=183884",""],[5956,"خشيت من الخروج إلى المروج","https://www.poetsgate.com/ViewPoem.aspx?id=201543",""],[5956,"أنا الصعلوكُ في جسمي","https://www.poetsgate.com/ViewPoem.aspx?id=215613",""],[6019,"مجرد حُلم","https://www.poetsgate.com/ViewPoem.aspx?id=158062",""]],"verses":[["فقطعْتَ الرسول عنِّيَ ضَنّاً","باتِّخاذِيهِ مَفْخَراً وبهاءَ",0,"ا",2,0],["فَقَطَعتُ يَومي كُلَّهُ مُتَفَكِّراً","وَسَهِرتُ لَيلي كُلَّهُ مُتَمَلمِلا",1,"ل",2,0],["فَقَطَعتُ أَنعَمَ لَيلَةٍ","ما بَينَ لَثمٍ وَاِعتِناقِ",2,"ق",1,0],["فَقَطَعتَها رَكضَ الجَوادِ وَلَو مَشى","في جانِبَيها الشَنفَرى لَم يُسرِعِ",3,"ع",1,0],["فقطَّبَ حتى خِلتُ أن قد وَسَمْتُهُ","وذو اللؤمِ فيه ضُجْرَةٌ وقطوبُ",4,"ب",1,0],["فَقَطَّبَ حينَ أَبصَرَني","وَنَكَّسَ رَأسَهُ وَبَكى",5,"ك",2,0],["فقطب منه الوجه ينفخ غاضباً","وَمد يديه جاذِباً وَهي تدفع",6,"ع",1,0],["فقطفت أول قبلة من وردة","ورشفت أول مبسم من زنبق",7,"ق",1,0],["فقط لَمَستُ مُعرَّاها فما وَقَعتْ","ممّا لمسْت ، يدي إلا على وتدِ",8,"د",1,0],["فقطع أعناق الخلاف وأصبحت","ملوك حجاج البطل وهي عبيد",9,"د",1,0],["فَقطب مِن أَهوى وَأَبصَر مَغضباً","وَأَوقع ظلّ الجفن مِنهُ عَلى الزند",10,"د",1,0],["فَقَطَّعَ أَحشاءً وَواصلَ أَدمُعَاً","وَضيََّع مِن آمالِنا كُلَّ مَطمَعِ",11,"ع",1,0],["فَقَطَعتُ طَرفي دُونَها","وَأَطَعتُ ما قالَ الحِجى لي",12,"ي",1,0],["فقطعت ليلي غارقا نشوان في","ما يشبه الأحلام من ذكراك",13,"ك",1,0],["فَقَطَفْتُ الشَّقِيقَ منْ وجْهِهِ","وَاغْتَبَقْتُمِنْ فِيهِ بِالضَّرَبِ",14,"ب",1,0],["فَقُطِّعَ بِالنَّوائِبِ صَفْحَتاهُ","وَفُلِّلَ بِالْخُطُوبِ الْمَضْرِبانِ",15,"ن",1,0],["فقطعتُ مُوْماةً عزوفاً جُنها","ضَلَّتْ بها كدرُ القطا منهاجها",16,"ج",3,0],["فَقُطرُ مِصرَ يَنبَغي","بِكَ المَلا يُفاخِرُ",17,"ر",1,0],["فقَطْعُ الرِّزقِ عن شَيْخٍ قبيحٌ","إذا ما سِنُّه كِبَراً تَعالى",18,"ل",2,0],["فَقَطعتها فَرداً بِطَرف دامع","دامِ وَأَنفاس عَلَيكَ مِداد",19,"د",1,0],["فقطعتَها ويعُزُّ عنْ","دي قولُهُم قُطِعَتْ يدُهْ",20,"ه",1,0],["فقطعتُ يَا منصورُ نحوَكَ نَازِعاً","خُدَعَ المنى وعلائقَ الأَسبابِ",21,"ب",1,0],["فقطبُ الدين فارسُها وحامي","حَقيقتها وسيِّدُها المُشارُ",22,"ر",1,0],["فَقَطَعْتَ أَنْساعَ الرَّواحِلِ مُعْلِناً","في كُلِّ خَيْرٍ جِئْتَهُ بِطِلابِهِ",23,"ب",2,0],["فَقطَفتُ الَوردَ مِن وَجنَتِه","ولَثمتُ الثَّغرَ مَعسُولَ المَذَاق",24,"ق",1,0],["فقطعتُ من إنصافِهِ أَمَلِي","ونفضتُ من إسعافِهِ دَرَنِي",25,"ن",2,0],["فَقَطعتِ وَصلكِ لا لجرمٍ كان لِي","وَإِلى وصالكِ جيئتي وذهابي",26,"ب",2,0],["فَقَطَفتُ رُمّانَ الصُدورِ لِلَذَّةٍ","وَلَمَستُ أَردافاً كَفِعلِ اللاعِبِ",27,"ب",1,0],["فقطعوا دجلة ثم ساروا","وكل من مرؤوا به أغاروا",28,"ر",3,0],["فَقُطِّعَ أَرحامٌ وَفُضَّت جَماعَةٌ","وَعادَت رَوايا الحِلمِ بَعدُ رَكائِكا",29,"ك",2,0],["فقطفنا التُّفّاحَ والوَردَ والآ","سَ جَنيّاً وَلسَ آساُ ووردا",30,"د",2,0],["فقطّبت ثم قالت وهي مُغضَبٌةٌ","ألا استعذت بيونانٍ ويانينِ",31,"ن",1,0],["فَقطعة الأَرض الَّتي ترَكتُها","هِيَ الَّتي عَن والِدي وَرثتها",32,"ه",2,0],["فقُطَّ شَوى هَمّي بُرقْشٍ تَقُطُّها","فهُنَّ كبِيضٍ دِينُها في الوغى القَطُّ",33,"ط",1,0],["فقطعت القلبَ جَهلاً","وقتَلت النفسَ عَمدا",34,"د",2,0],["فقطَّب هذا والغروب يحثُّه","وهذا تجلي وهْو جذلان باسم",35,"م",1,0],["فَقَطَعت أَصلَهُم وَقَط","ع الأصل أقطع لِلطَّرفِ",36,"ف",1,0],["فَقَطَفنا مِنَ الأَماني ثِماراً","هُنَّ لِلمَجدِ والعُلى غاياتُ",37,"ت",1,0],["فَقَطَعَت أَرْوَى القُوَى مِنْ وَصْلِي","كَأَنَّهَا مَقْلِيَّةٌ أَوْ تَقْلِي",38,"ل",2,0],["فقطرة من فضلات له","تبرئ أسقام فؤاد مصاب",39,"ب",1,0],["فقطَّع من أقرانهم وأبادهم","وكلهمُ في صفقة البيع خاسرُ",40,"ر",1,0],["فقطعت من وصل الغرير مطامعي","وجعلت تمداح الأمير شعاري",41,"ر",2,0],["فقطعت من كل العباد علائقي","ووصلت بالمعبود حبل رجائي",42,"ي",1,0],["فقطر كبشها وهوى صريعاً","على الدقعاء يلتهم الرغاما",43,"م",2,0],["فقطعت قلبي الذكرى وبرح بي","شوق ملح وتوق اوهنا اكتفي",44,"ف",2,0],["فقطَّ أنامله بالحسام","موراً وجاء به يظلع",45,"ع",1,0],["فقطفت من خدَّيه ورداً طالما","قطرتْ سيوفُ الهند دون جناه",46,"ه",1,0],["فقطوبه طبع وليس تطبعاً","والطبع باق والتطبع زائل",47,"ل",1,0],["فقطَّعت غيطاناً وجاوزت أبحرا","إليهم أجر المجد من آل قحطان",48,"ن",1,0],["فقطرة من فضلات له","في الجوف تنجي من أليم العقاب",49,"ب",1,0],["فقطب رحاهم وهو باب هداهم","محم جامع الخيرات في بابه جمعا",50,"ع",2,0],["فقطعت المدى أروح وأغدو","وعلى صهوة الجلال اختيالي",51,"ل",2,0],["فقطعت بالوابور كل مفازة","جرداء لا ماء يلوح ولا شجر",52,"ر",1,0],["فَقَطَعنا حَبلَ السُكونِ بَصَوتٍ","أَبَدِيٍّ ما زالَ يَملأُ أُذني",53,"ي",1,0],["فَقَطُّ عَليَّ لم يَبغُوا بسُوءٍ","وما سَلَبوا خيولي او ثِياري",54,"ر",2,0],["فقطر قل شك بزاهي سلاح","ببراق فولاذه قد أضا",55,"ض",2,0],["فقطعت نحوكم الديار ملبيا","وعدا جرى تقريره وحواره",56,"ر",2,0],["فقطعت كبداً ممن غدا كبداً","لفاطم وحشى ومن واحد الزمن",57,"ن",1,0],["فقط وخط المشيب ولا رشادٌ","وكل في فيافي الغي داوي",58,"ا",3,0],["فقطعُك طولَ دهرك بالتمنِّي","كأنك أنت ذو المُلْكِ الأنيقِ",59,"ق",1,0],["فقطفنا الهوى وطرنا سويا","......................ما بلغْنا من الهناءِ حدودا",60,"د",2,0],["فَقَطْ قُمْ وأَنشِدْ كلاماً جميلاً","وقُلْ أَبَداً أَبَداً لنْ نُفرَّقْ",61,"ق",1,0],["فقطعُكَ للأمِّ العظيمةِ قاطعٌ","حبالَ الأماني ثمَّ ترْتدُّ مفْلسا",62,"س",2,0],["فَقَطَعْتُ أَنْفَاْسَ الْحَسُودِ بِعِشْقِ مَنْ","مَلأَتْ بِعِشْقِي الْقَلْبَ وَالأَقْدَاْحَاْ",63,"ح",2,0],["فقطَّب وجهُ الأرضِ واغبرت السما","وأصبح ميسورُ المعيشةِ في عُسر",64,"ر",1,0],["فقطوفي شهيّة بشفاهٍ","واهباتٍ لبُعدها السرمديّ!!",65,"ي",1,0],["فقط لأنيَ من يُغريك باللعبِ","أدمنت حرقك حتى آخر اللهب!",66,"ب",1,1],["فقطارُ الأيام في وطنِ المج","دِ ذليلٌ وصوتُهُ مخنوقُ",67,"ق",1,0],["فَقَطْرُ مَاءِ الْفَتَى فِي الْبِيدِ يُنْقِذُهُ","وَالْحُلْمُ يُسْلِيهِ فِي أَسْرٍ وَفِي الْغَمَمِ",68,"م",1,0],["فقطْ لأنظُرَ في عينيكَ أُخْبرُها","أنّي بحجمِ السما والأرضِ أهواكا",69,"ك",2,0],["فقطعنا ظنونَهُ بيقينٍ","من فَعالٍ فانهارَ مِنّا وخارا",70,"ر",2,0],["فقطفت منه البوح حرا يانعا","أشهى من العناب في ناديه",71,"ي",2,0],["فقط أنت أهملتَها عندما","أرادتْ وصالَكَ في الطائره",72,"ر",2,0],["فقطعتُ بالآمال ليلًا مُطْبِقًا","وزجرتُ بالتَّذكار همَّ المُفْرَدِ",73,"د",1,0],["فقط الطفولة والشباب أراهما","لا بأس يُحْتَملان مهما سُبَّا",74,"ب",2,0],["فقط حررتُ شعري في المعاني","وكان النحوُ ينخرُ في نسيجي",75,"ج",2,0],["فقط بثقافةٍ هي ذاتُ جسمي","فقط بمبادئِ الصدقِ الأتمِّ",76,"م",1,0],["فقطفتُ نبضَكِ كي أشُمَّ عراقَةَ _","الأشواقِ في صدري يتيهُ ويخفقُ",77,"ق",1,0]]}