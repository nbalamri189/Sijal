{"poems":[[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[72,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[72,"أسفي على زمن التلاقي","https://www.aldiwan.net/poem42789.html","مجزوء الكامل"],[47,"بين الشقيقة فاللوى فالأجرع","https://www.aldiwan.net/poem64692.html","الكامل"],[63,"لقد طمع البشري في ولم يكن","https://www.aldiwan.net/poem51804.html","الطويل"],[50,"رأيت الفضل مكتإبا","https://www.aldiwan.net/poem64480.html","مجزوء الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141988","الكامل"],[56,"أعوذُ باللهِ منْ ليلٍ يقرِّبني","https://www.poetsgate.com/ViewPoem.aspx?id=13901",""],[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[113,"ومذ كشف الفصاد عن زنده رأى","https://www.aldiwan.net/poem16473.html","الطويل"],[186,"تصبر وإن لم تملك الصبر فاجزع","https://www.aldiwan.net/poem67051.html","الطويل"],[197,"بالأمس قد قال الحجى لي","https://www.aldiwan.net/poem13121.html","مجزوء الكامل"],[201,"يا جارة الوادي طربت وعادني","https://www.aldiwan.net/poem39810.html","الكامل"],[241,"رب من صادني وبرحبي","https://www.aldiwan.net/poem18047.html","الخفيف"],[284,"أبعدك أتقي نوب الزمان","https://www.aldiwan.net/poem60705.html","الوافر"],[302,"برح الخفاء فلست أكتم لوعة","https://www.aldiwan.net/poem36808.html","عموديه"],[324,"بك العلا تظاهر","https://www.aldiwan.net/poem67198.html","مجزوء الرجز"],[368,"خيال زائر مني خيالا","https://www.aldiwan.net/poem60676.html","الوافر"],[384,"واحر غلة قلبي الوقاد","https://www.aldiwan.net/poem48838.html","الكامل"],[436,"كانت يد لك عند عبد","https://www.aldiwan.net/poem12805.html","مجزوء الكامل"],[443,"أنضيت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34916.html","الكامل"],[464,"اذا الأبطال مارست المنايا","https://www.aldiwan.net/poem15405.html","الوافر"],[532,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[541,"قد سقانا جرعة يوم الفراق","https://www.aldiwan.net/poem47544.html","عموديه"],[554,"يا مالكا رقي بلا ثمن","https://www.aldiwan.net/poem47157.html","أحذ الكامل"],[554,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[556,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["فقطعْتَ الرسول عنِّيَ ضَنّاً","باتِّخاذِيهِ مَفْخَراً وبهاءَ",0,"ا",2,0],["فَقَطَعتُ يَومي كُلَّهُ مُتَفَكِّراً","وَسَهِرتُ لَيلي كُلَّهُ مُتَمَلمِلا",1,"ل",2,0],["فَقَطَعتُ أَنعَمَ لَيلَةٍ","ما بَينَ لَثمٍ وَاِعتِناقِ",2,"ق",1,0],["فَقَطَعتَها رَكضَ الجَوادِ وَلَو مَشى","في جانِبَيها الشَنفَرى لَم يُسرِعِ",3,"ع",1,0],["فقطَّبَ حتى خِلتُ أن قد وَسَمْتُهُ","وذو اللؤمِ فيه ضُجْرَةٌ وقطوبُ",4,"ب",1,0],["فَقَطَّبَ حينَ أَبصَرَني","وَنَكَّسَ رَأسَهُ وَبَكى",5,"ك",2,0],["فقطب منه الوجه ينفخ غاضباً","وَمد يديه جاذِباً وَهي تدفع",6,"ع",1,0],["فقطفت أول قبلة من وردة","ورشفت أول مبسم من زنبق",7,"ق",1,0],["فقط لَمَستُ مُعرَّاها فما وَقَعتْ","ممّا لمسْت ، يدي إلا على وتدِ",8,"د",1,0],["فقطع أعناق الخلاف وأصبحت","ملوك حجاج البطل وهي عبيد",9,"د",1,0],["فَقطب مِن أَهوى وَأَبصَر مَغضباً","وَأَوقع ظلّ الجفن مِنهُ عَلى الزند",10,"د",1,0],["فَقَطَّعَ أَحشاءً وَواصلَ أَدمُعَاً","وَضيََّع مِن آمالِنا كُلَّ مَطمَعِ",11,"ع",1,0],["فَقَطَعتُ طَرفي دُونَها","وَأَطَعتُ ما قالَ الحِجى لي",12,"ي",1,0],["فقطعت ليلي غارقا نشوان في","ما يشبه الأحلام من ذكراك",13,"ك",1,0],["فَقَطَفْتُ الشَّقِيقَ منْ وجْهِهِ","وَاغْتَبَقْتُمِنْ فِيهِ بِالضَّرَبِ",14,"ب",1,0],["فَقُطِّعَ بِالنَّوائِبِ صَفْحَتاهُ","وَفُلِّلَ بِالْخُطُوبِ الْمَضْرِبانِ",15,"ن",1,0],["فقطعتُ مُوْماةً عزوفاً جُنها","ضَلَّتْ بها كدرُ القطا منهاجها",16,"ج",3,0],["فَقُطرُ مِصرَ يَنبَغي","بِكَ المَلا يُفاخِرُ",17,"ر",1,0],["فقَطْعُ الرِّزقِ عن شَيْخٍ قبيحٌ","إذا ما سِنُّه كِبَراً تَعالى",18,"ل",2,0],["فَقَطعتها فَرداً بِطَرف دامع","دامِ وَأَنفاس عَلَيكَ مِداد",19,"د",1,0],["فقطعتَها ويعُزُّ عنْ","دي قولُهُم قُطِعَتْ يدُهْ",20,"ه",1,0],["فقطعتُ يَا منصورُ نحوَكَ نَازِعاً","خُدَعَ المنى وعلائقَ الأَسبابِ",21,"ب",1,0],["فقطبُ الدين فارسُها وحامي","حَقيقتها وسيِّدُها المُشارُ",22,"ر",1,0],["فَقَطَعْتَ أَنْساعَ الرَّواحِلِ مُعْلِناً","في كُلِّ خَيْرٍ جِئْتَهُ بِطِلابِهِ",23,"ب",2,0],["فَقطَفتُ الَوردَ مِن وَجنَتِه","ولَثمتُ الثَّغرَ مَعسُولَ المَذَاق",24,"ق",1,0],["فقطعتُ من إنصافِهِ أَمَلِي","ونفضتُ من إسعافِهِ دَرَنِي",25,"ن",2,0],["فَقَطعتِ وَصلكِ لا لجرمٍ كان لِي","وَإِلى وصالكِ جيئتي وذهابي",26,"ب",2,0],["فَقَطَفتُ رُمّانَ الصُدورِ لِلَذَّةٍ","وَلَمَستُ أَردافاً كَفِعلِ اللاعِبِ",27,"ب",1,0],["فقطعوا دجلة ثم ساروا","وكل من مرؤوا به أغاروا",28,"ر",3,0]]}