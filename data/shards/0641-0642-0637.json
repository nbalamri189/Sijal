{"poems":[[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[70,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[70,"أسفي على زمن التلاقي","https://www.aldiwan.net/poem42789.html","مجزوء الكامل"],[45,"بين الشقيقة فاللوى فالأجرع","https://www.aldiwan.net/poem64692.html","الكامل"],[61,"لقد طمع البشري في ولم يكن","https://www.aldiwan.net/poem51804.html","الطويل"],[48,"رأيت الفضل مكتإبا","https://www.aldiwan.net/poem64480.html","مجزوء الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141988","الكامل"],[54,"أعوذُ باللهِ منْ ليلٍ يقرِّبني","https://www.poetsgate.com/ViewPoem.aspx?id=13901",""]],"verses":[["فقطعْتَ الرسول عنِّيَ ضَنّاً","باتِّخاذِيهِ مَفْخَراً وبهاءَ",0,"ا",2,0],["فَقَطَعتُ يَومي كُلَّهُ مُتَفَكِّراً","وَسَهِرتُ لَيلي كُلَّهُ مُتَمَلمِلا",1,"ل",2,0],["فَقَطَعتُ أَنعَمَ لَيلَةٍ","ما بَينَ لَثمٍ وَاِعتِناقِ",2,"ق",1,0],["فَقَطَعتَها رَكضَ الجَوادِ وَلَو مَشى","في جانِبَيها الشَنفَرى لَم يُسرِعِ",3,"ع",1,0],["فقطَّبَ حتى خِلتُ أن قد وَسَمْتُهُ","وذو اللؤمِ فيه ضُجْرَةٌ وقطوبُ",4,"ب",1,0],["فَقَطَّبَ حينَ أَبصَرَني","وَنَكَّسَ رَأسَهُ وَبَكى",5,"ك",2,0],["فقطب منه الوجه ينفخ غاضباً","وَمد يديه جاذِباً وَهي تدفع",6,"ع",1,0],["فقطفت أول قبلة من وردة","ورشفت أول مبسم من زنبق",7,"ق",1,0],["فقط لَمَستُ مُعرَّاها فما وَقَعتْ","ممّا لمسْت ، يدي إلا على وتدِ",8,"د",1,0]]}