{"poems":[[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[8,"دار حي كانت لهم زمن التو","https://www.aldiwan.net/poem21824.html","الخفيف"],[261,"يا ندمي قد خلوت بحر","https://www.aldiwan.net/poem48472.html","الخفيف"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67637","الخفيف"],[5704,"دعْكَ مِنْ هجري","https://www.poetsgate.com/ViewPoem.aspx?id=191698",""],[5762,"الذبيح الصاعد","https://www.poetsgate.com/ViewPoem.aspx?id=13136",""]],"verses":[["من كهولٍ جحاجحٍ تُعرف الحن","كةُ فيهم وفتيةٍ أزوالِ",0,"ل",1,0],["مِن كُهولٍ غُلبٍ مَلاوِيثَ قَطّا","عِينَ قَدَّ الأَسِيرِ ذي الأَغلالِ",1,"ل",1,0],["منك هذا النبيذ والخبز واللح","م الذي يشرب النبيذ عليه",2,"ي",2,0],["من كهولٍ وسادةٍ سمحاءٍ","باللهى باخلين بالأعراضِ",3,"ض",1,0],["منك هذا البحر يسترعي جمالاً","هذه الشطآنِ جَذْلَى من بهاكَا",4,"ك",2,0],["من كهولٍ، يقودها الموت للن صر، فتفتكُّ نصرها الموعودا","وشبابٍ، مثل النسورِ، تَرامى لا يبالي بروحه، أن يجودا",5,"د",2,0]]}