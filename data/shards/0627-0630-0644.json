//www.aldiwan.net/poem69092.html","الطويل"],[48,"لست بدار عفت وغيرها","https://www.aldiwan.net/poem62428.html","البسيط"],[48,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[48,"لمن طلل لم أشجه وشجاني","https://www.aldiwan.net/poem66140.html","الطويل"],[48,"ذكر الكرخ نازح الأوطان","https://www.aldiwan.net/poem66142.html","الخفيف"],[50,"هل تعلمين وراء الحب منزلة","https://www.aldiwan.net/poem24524.html","البسيط"],[50,"أشادن إن ريمة لا تصاد","https://www.aldiwan.net/poem63916.html","الوافر"],[50,"طرب الحمام فهاج لي طربا","https://www.aldiwan.net/poem64861.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85557","الكامل"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1314","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39665","الطويل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72185","الطويل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72191","الطويل"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6796","البسيط"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9981","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42700","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42644","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43917","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1942","الطويل"],[78,"غريب بأرض المغربين","https://www.poetsgate.com/ViewPoem.aspx?id=1467",""],[90,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=179156",""],[9,"أثوى ، قصّرَ ليلة ً ليزوَّدا،","https://www.poetsgate.com/ViewPoem.aspx?id=20031",""],[45,"بِاللهِ يَا رَبْعُ لَمَّا ازْدَدْتَ تِبْيَانا","https://www.poetsgate.com/ViewPoem.aspx?id=31884",""],[45,"كَمْ من وُقُوفٍ على الأطلال وَالدِّمَنِ","https://www.poetsgate.com/ViewPoem.aspx?id=32011",""],[80,"غريبٌ بأرض المغربين أسيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=3292",""],[31,"نُعْمُ الفُؤَادِ مَزارُها مَحْظُورُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18866&r=&rc=129",""]],"verses":[["إِذ لا يُضيفونَ المَعائِبَ بَينَهُم","وَبُيوتُهُم وَقفٌ عَلى الضيفانِ",0,"ن",1,0],["إِذْ لَمْ تَكُنْ قَبْلَنا بِالمَجْدِ حاليَةً","وَلا لَها مَنظَرٌ مِنْ بَعْدِنا حَسَن",1,"ن",1,0],["إذْ لِمّتي سَحْماءُ مَدَّ على التُّقى","أظْلالَها وَرَقُ الشّبابِ الأخضَرُ",2,"ر",1,0],["إذ لم يكنْ والليلُ يَسحَبُ ذَيلَهُ","لسُعادَ غيرَ يَدي وِشاحٌ جائِلُ",3,"ل",1,0],["إذْ لِمَّتي كَجَناحِ النَّسْرِ داجِيَةٌ","والعَيْشُ رَقَّتْ حَواشي رَوضِهِ الخَضِلِ",4,"ل",1,0],["أذَلُّوا بِسَيفِ الدّولةِ ابنِ بَهائِها","رِقاباً فأرْخَى مِن عَلابِيِّها القَسْرُ",5,"ر",1,0],["إِذ لا أَزالُ عَلى رِحالَةِ سابِحٍ","نَهدٍ تَعاوَرُهُ الكُماةُ مُكَلَّمِ",6,"م",1,0],["إِذ لا تَزالُ لَكُم مُغَرغَرَةٌ","تَغلي وَأَعلى لَونِها صَهرُ",7,"ر",1,0],["إِذ لا أُبادِرُ في المَضيقِ فَوارِسي","وَلا أُوَكِّلُ بِالرَعيلِ الأَوَّلِ",8,"ل",1,0],["إِذ لا أَرى شِكلاً يَكونُ كَشِكلِنا","حُسناً ويَجمَعُنا هُناكَ جِوارُ",9,"ر",1,0],["أَذَلفاءُ إِن كانَ يُرضيكُم","عَذابي فَدونَكُمُ عَذِّبوا",10,"ب",3,0],["إِذ لا يُرى قَيسٌ يَكونُ كَقَيسِنا","حَسَباً وَلا كَبَنيهِ في الأَولادِ",11,"د",1,0],["إِذ لِمَّتي سَوداءُ أَتبَعُ ظِلَّها","دَدَناً قُعودَ غَوايَةٍ أَجري دَدا",12,"د",2,0],["أَذلَلتَ نَفسَكَ بَعدَ تَكرِمَةٍ لَها","أَو كُنتَ ذا عَوَزٍ وَمُنتَظِرٍ غَدا",12,"د",2,0],["أَذَلِكَ أَم خَميصُ البَطنِ جَأبٌ","أَطاعَ لَهُ النَواصِفُ وَالكَديدُ",13,"د",1,0],["إِذ لا تَزالُ فَريسٌ أَو مُغَبَّبَةٌ","صَيداءُ تَنشِجُ مِن دونِ الدِماغِ دَما",14,"م",2,0],["إِذ لا التَحِيَّةُ إيماءٌ مُخالَسَةً","وَلا الزِيارَةُ إِلمامٌ عَلى خَطَرِ",15,"ر",1,0],["إِذ لا تُرَجّي سُلَيمى أَن يَكونَ لَه","مَن بِالخَوَرنَقِ مِن قَينٍ وَنَسّاجِ",16,"ج",1,0],["أَذَلِكَ أَم جَونٌ يُطارِدُ آتُن","حَمَلنَ فَأَربى حَملُهُنَّ دُروصُ",17,"ص",1,0],["إِذ لا تُكَلِّمُنا وَكانَ كَلامُها","نَفلاً نُؤَمِّلُهُ مِنَ الأَنفالِ",18,"ل",1,0],["إِذ لُحِقَت مِن خَلفِها تَدَّعي","مِثلَ سَوامِ الرَجُلِ الغادِيَه",19,"ي",2,0],["أذُلاً وهذا العزّ صرّح سابغاً","علينا إِذن فالعز أن نُدرك الحَتفا",20,"ف",2,0],["إذ لست أنت بكُفْوِي","ولست أنت بنِدّي",21,"ي",1,0],["إذ لن يقوم نظيره من بعده","هيهات أن تأتي الدنى بنظيره",22,"ر",2,0],["إِذ لا عِقالٌ يُحامي عَن ذَمارِكُمُ","وَلا زُرارَةَ لا يَحمي وَزَرّارُ",23,"ر",1,0],["إِذ لا تَغارُ عَلى البَناتِ مُجاشِعٌ","يَومَ الحِفاظِ وَلا يَفونَ بِجارِ",24,"ر",1,0],["إِذ لا يَذودُ عَنِ الحِمى مُتَوَكِّلٌ","رُمِيَت يَداهُ بِفالِجٍ وَجُذامِ",25,"م",1,0],["أَذَلِكَ أَم عِراقِيُّ شَتيمٌ","أَرَنَّ عَلى نَحائِصَ كَالمَقالي",26,"ل",2,0],["أَذَلِكَ أَم نَزرُ المَراتِعِ فادِرٌ","أَحَسَّ قَنيصاً بِالبَراعيمِ خاتِلا",27,"ل",2,0],["إذ لمتي جثلة اكفِّئها","يُضحك منها الغوانيَ العَجَبُ",28,"ب",1,1],["إذ لا يزال له نهبٌ يُنفِّله","من المقاسم لا وُخشٌ ولا نكدُ",29,"د",1,0],["إذ لا تَبِض إلى الترا","ئك والضرائك كف جازرْ",30,"ر",1,1],["أذلك لا بَل تَيِكَ غِبَّ وَجِيفِها","إذا ما أكَلَّ الصَّارِخُونَ وانقَبُوا",31,"ب",3,0],["إذ لِمَّتي جَثلَةٌ أُكَفِّئُها","يَضحَكُ مني الغَوانِيُ العَجَبُ",32,"ب",1,0],["إِذ لاتَرُدّونَ عَن أَكنافِ أَهلِكُمُ","شَوازِبَ الخَيلِ مِن مَثنىً وَوِحدانِ",33,"ن",1,0],["أَذَلَّ تَميماً بَعدَ عِزٍّ وَطالَما","أُذِلَّ بِنا الباغي وَعَزَّ المُجاوِرُ",34,"ر",1,0],["إذ لم يكن درهمي دِرْهمي","ن عندك لم يزكُ عند الغريبِ",35,"ب",1,1],["إذ لا يُرى ذنبٌ له","إلا بها وَلِيَ اكتسابهْ",36,"ب",2,0],["إذ لا أبالي فيهمُ","حسكَ العدو ولا ضِبابَهْ",36,"ب",2,0],["إذ لم يَرَوْا تقريعه","يوماً بذاك ولا اغتيابهْ",36,"ب",2,0],["أذلكَ أم تُدِلُّ بعزِّ قومٍ","قد انقرضوا فما منهم عَريبُ",37,"ب",1,0],["أذَلْنا دون ذلك كل عِلْقٍ","ومُلْتمِسُ السلامة لا يخيبُ",37,"ب",1,0],["أذلك أو قلتُ كان امرَأً","رأى الجودَ ذنباً عظيماً فتابا",38,"ب",2,0],["أذلك أو قلتُ بل لم يزلْ","أخا البخل إلا عِداتٍ كِذابا",38,"ب",2,0],["إذ لم أُسَقِّ الديارَ أدمُعَ لَهْ","فانَ تُوالي زفيرَهُ كُرَبُهْ",39,"ب",2,0],["أذِلْهَا أبا عيسى لَبُوساً فإنها","سَتبقى ويَبْلى الأتْحَمِيُّ المعَضَّدُ",40,"د",1,0],["إذ للشباب حِبالاتٌ أصيدُ بها","وغِرَّةٌ تدَّرِي وحشي لمصطادي",41,"ي",1,0],["إذ لم تزدك ولايةٌ في سؤددٍ","كلّا ولا الأخرى محتْ لك سؤددا",42,"د",2,0],["إذ لم أنلْ من فضلكم","مقدارَ ما يزنُ النَّقيرُ",43,"ر",1,0],["أذلك أم هلّا منعت مُصرِّحاً","فأيأستني لكن خلقت من الصخر",44,"ر",1,0],["إذ لا أعدُّهم مما أحرِّمُهُ","بل كالاضاحيِّ من ضأنٍ وأمعوز",45,"ز",1,0],["أذلك أم يَزويه عنك وقد رأى","عطاياك إلا عاثرُ الجَدّ ناعِسه",46,"س",2,0],["إذ لا أرى في عيشتي شَرَقاً","بفراقِهِ كلا ولا غصصا",47,"ص",2,0],["إذ لا تزالُ تُسقّى","من رائبي بعد مَخضي",48,"ض",2,0],["إذ لم ينفِّل هناك نافلةً","تكونُ من نفسهِ له عِوضا",49,"ض",2,0],["أذلَّكَ حُبُّك عُجرَ الفيا","شِ يا ابنَ المَقاوِل من نَاعط",50,"ط",1,0],["إذ لا يكون لذي المِراس غناؤُهُ","إلا الدموعَ يحثُّها بدموع",51,"ع",1,0],["إذ لك اسمٌ من السلامة مشتق","قٌ وإذ كنت لي إليها شفيعا",52,"ع",2,0],["إذ لا يرى لأبي العباس حينئذ","حق السلام لقد أزرى به الموق",53,"ق",1,0],["إذ للشبيبة صبوة تُصبي بها","وبشاشة يصبى بها وتروق",54,"ق",1,0],["إذ لا تجوزُ الصوابَ خطبتُهُ","ولا يضلُّ الهدى إذا اقتعدكْ",55,"ك",1,0],["إذ لا تقحُّم في حين الأناة لهم","ولا أناةَ له في حين إقحامِ",56,"م",1,0],["إذ لا المنازلُ أطلالٌ نُسائلُها","ولا القواطنُ آجالٌ وصِيران",57,"ن",1,0],["إِذ لا تَجَهَّمُني أَرضُ العَدُوِّ وَلا","عَسفُ البِلادِ إِذا حِرباؤُها جَذَلا",58,"ل",2,0],["إِذ لا أُطاوِعُ أَمرَ العاذِلاتِ وَلا","أُبقي عَلى المالِ إِن ذو حاجَةٍ سَأَلا",58,"ل",2,0],["أَذَلَّ بَني ماءِ السَماءِ زَمانُهُم","وَذُلُّ بَني ماءِ السَماء كَبيرُ",59,"ر",1,0],["أَذَلُّ قَومَ حينَ يُدعى الجارُ","كَما أَذَلَّ الحَرِثَ النَخّارُ",60,"ر",1,0],["إذ لم يكن لبطرس","من طاقة بدلكسي",61,"ي",1,0],["أذِلُّ لِمَنْ دوني وأُعِطي مقادَتِي","وأُرجِعُ طرفِي وهو خَزيانُ خاشعُ",62,"ع",1,0],["إِذ لَم يَكُن شَرَفُ المَناكِحِ يُشتَرى","بِالمالِ في اللَأواءِ وَاللَزَباتِ",63,"ت",1,0],["إِذ لا يُنَهنِهُني العَذولُ وَلا أُرى","مُتَوَقِّفاً لِلَّومِ وَالتَعنيفِ",64,"ف",1,0],["إِذ لا وَسيلَةَ لِلواشي يَمُتُّ بِها","مَعَ الصِبا وَهوَ غَضّاتٌ وَسائِلُهُ",65,"ل",2,0],["إِذ لا الوِصالُ بِخُلسَةٍ فيهِم وَلا","فَرطُ اللِقاءِ لَدَيهِمُ بِلِمامِ",66,"م",1,0],["إِذ لا هَوىً كَهَوانا يُستَدامُ بِهِ","عَهدُ السُرورِ وَلا دُنيا كَدُنيايا",67,"ي",2,0],["إِذ لا تَزالُ لَهُ خَيلٌ مُدافِعَةٌ","بِالطَعنِ وَالضَربِ عَن صَنعاءَ أَو عَدَنِ",68,"ن",1,0],["أَذَلَّ بِهِ اللَهُ الَّذي كانَ ظالِماً","وَعَزَّ بِهِ المَظلومُ وَاِشتَدَّ جانِبُه",69,"ب",2,0],["إذ للعواذلِ غَفلَتي وتماسُلي","وإلى الغَوايَةِ نَهضَتي وَنَشاطي",70,"ط",2,0],["أذَلَّ عِزُّ النَّوى عَزاءَهُما","وبيَّنَ البينُ منهما الكَمَدا",71,"د",2,0],["أَذَلِكَ أَم شَتيمُ الوَجهِ جَأبٌ","عَلَيهِ مِن عَقيقَتِهِ عِفاءُ",72,"ا",2,0],["أَذَلَّ الحِرصُ وَالطَمَعُ الرِقابا","وَقَد يَعفو الكَريمُ إِذا اِستَرابا",73,"ب",2,1],["إِذ لَم يَكُن لَكِ في التَغَزُّلِ بِالمَها","لَقَبٌ وَلا أَسماهُ مَن أَسماكِ",74,"ك",1,0],["إِذ لا أَرومُ بِهِ الجَزاءَ لِأَنَّهُ","بَحرٌ أُنَزِّهُ غُلَّتي عَن وِردِهِ",75,"د",2,0],["أَذلِكَ خَيرٌ أَم تَعَسُّفُ سَبسَبٍ","يُعَقِّلُ أَخفافَ النّجائبِ عاتِكُه",76,"ك",2,0],["إِذ لا مُعَوَّلَ إِلّا كُلُّ مُعتَدِلٍ","أَصَمَّ يُبرِئُ أَقواماً مِنَ الصَمَمِ",77,"م",1,0],["إِذ لا نُعَطِّلُ مِنها مَنظَراً أَنِقاً","وَمَربَعاً بِمَها اللَذاتِ مَأنوسا",78,"س",2,0],["إِذ لا صَدوفُ وَلا كَنودُ اَسماهُما","كَالمَعنَيَينِ وَلا نَوارُ نَوارُ",79,"ر",1,0],["إِذْ لِلْهَوَى ثَمَرٌ يَرِفُّ وَلِلصِّبَا","كَأْسٌ تُشَفُّ وَلِلْمُنَى إِلْمَامُ",80,"م",1,0],["إذْ لمْ يزلْ يبلغُ المملوكَ ذكرُكُمُ","إياهُ جبراً وتأهيلاً ولا سببا",81,"ب",2,0],["إِذ لا تُغَيِّرُها الوُشاةُ فَوُدُّها","صافٍ تُراسِلُ مَرَّةً وَنَزورُ",82,"ر",1,0],["أَذِلُّ لَكُم يا عَبدَ فيما هَويتُمُ","وَإِنّي إِذا ما رامَني غَيرَكُم صَعبُ",83,"ب",1,0],["أُذَلُّ لِآلِ لَيلى في هَواها","وَأَقبَلُ لِلأَكابِرِ وَالصِغارِ",84,"ر",1,1],["أَذَلَّ جِبِاهَهم حَدَثٌ ذَميمٌ","أهانَ العِزَّ والشرَّفَ المصونا",85,"ن",2,0],["أَذِلّاءُ حَمّالونَ كُلَّ ظَلامَةٍ","وَمَن يَتَهَيَّب جانِبَ البَأسِ يُظلَمِ",86,"م",1,0],["أَذَلَّت طاعَةُ الأَهواءِ مِنهُم","نُفوساً بِالزَواجِرِ تَستَهينُ",87,"ن",1,0],["أذلك الجدُّ منكم أم هو السَّخَرُ","دعوا اللّجاجَ فهذا مطلبٌ عَسِرُ",88,"ر",1,0],["أَذَلِكَ أَم فَردٌ بِقَفرٍ أَجادَهُ","مِنَ الغَيثِ أَيكٌ فَرعُهُ قَد تَهَلَّلا",89,"ل",2,0],["إِذ لا يَزالُ مِنَ الفِتيانِ ذو طَرَبٍ","يَعُبُّ مِن ذَهَبٍ قَد ذابَ إِبريزِ",90,"ز",1,0],["إِذ لَيسَ لي عِلمٌ مِنَ ال","دُنيا بِما هُوَ آتِ",91,"ت",1,0],["إذْ لَمْ تَزَلْ تَصْفَحُ عَمَّنْ جَنَى","وتُؤْثِرُ العَفْوَ مَعَ القُدْرَهْ",92,"ر",2,0],["إذْ لَنْ يَقُومَ لَهُمْ نَبِيٌّ مِثْلُهُ","منهم ولو كانَ النَّبِيُّ مَثيلا",93,"ل",2,0],["إذ لا رعودَ سوى هماهمها","ولا بروقَ سوى مناصلها",94,"ل",3,0],["إذ لا يزالُ مُطاعاً في عَشيرتِهِ","تُلقَى إليه أُمورُ الزَّيْغ والنِّحَل",95,"ل",1,0],["إذ لا يزالُ لهم إليك تغلْغُلٌ","وسُرىً وَوَخْدٌ دائِمٌ وذمِيل",96,"ل",1,0],["إذْ لا تَبيتُ ظِباءُ الوحشِ نافرةً","ولا تُراعُ مَهاةُ الرملِ بالسِّيد",97,"د",1,0],["إذْ لا ترَى هِبْرزِيّاً غيرَ منعفرٍ","منهم ولا جاثلِيقاً غيرَ مصفود",97,"د",1,0],["إِذ لاذَ بِروازُ يَومَ ذاكَ بِنا","وَالحَربُ تَمري بِكَفِّ حالِبِها",98,"ب",3,0],["إِذ لَيسَ في الناسِ عَصَر","وَلا مِنَ الخَوفِ وَزَر",99,"ر",1,0],["أَذَلَّ صِعابَ المُشكِلاتِ مُحَمَّدٌ","فَأَصبَحَ مَمدوحاً بِكُلِّ لِسانِ",100,"ن",1,0],["إِذ لِبابِ الأَميرِ صَدرُ نَهاري","وَرَواحي إِلى بُيوتِ القِيانِ",101,"ن",1,0],["إِذ لا يَزالُ لها طَيفٌ يُؤَرِّقُني","نَشوانَ مِن حُبِّها أَو غَيرَ نَشوانِ",102,"ن",1,0],["أَذَلَّ لِطالِبِ العُضُلاتِ رَوحٌ","فَواضِلَهُ وَعَزَّ بِهِ الجِهادُ",103,"د",1,0],["إِذ لامَني عَمروٌ فَقُلتُ لَهُ","غُلِبَ العَزاءُ وَرُبَّما غَلَبا",104,"ب",2,0],["اذ ليس بغداد كما تلفى ولا","حكام بغدادٍ ذوي اِستبداد",105,"د",1,0],["إِذ لابِسُ الذِلَّةِ المَقطوعُ ذو رَحِمٍ","قَطَعتَهُ وَإِذا المَوصولُ مَن تَصِلُ",106,"ل",1,0],["أذلَّاءُ إنْ ناموا أرقاءُ إنْ صحوا","يُباعُ ويُشرَى فيهمو ويُسوّمُ",107,"م",1,0],["أُذِلَّتْ بقُرْبي عِنْدَه وقَضى لها","قَضاءً فَلَمْ يُنْقَضْ ولم يُتَعَقَّبِ",108,"ب",1,0],["أذلكَ أم كُدْرِيَّةٌ هاج وِرْدَها","من القيظ يومٌ واقِدٌ وسَمُومُ",109,"م",1,1],["إِذ لا تُرَجّي سُلَيمى أَن يَكونَ لَها","مَن بِالخَوَرنَقِ مِن قَينٍ وَنَسّاجِ",110,"ج",1,0],["أَذِلُّ لِعَبلَةٍ مِن فَرطِ وَجدي","وَأَجعَلُها مِنَ الدُنيا اِهتِمامي",111,"ي",1,0],["إِذْ لِمَّتِي فَيْنَانَةٌ وَيَدِي","فَوْقَ الأَكُفِّ وَقَامَتِي أَلِفُ",112,"ف",1,0],["إِذْ لا صَدِيقَ يَسُرُّ السَّمْعَ غَائِبُهُ","وَلا رَفِيقَ يَرُوقُ الْعَيْنَ حَاضِرُهُ",113,"ر",2,0],["إِذْ لَمْ يَكُنْ فِي النَّاسِ مَلاَّحٌ وَلَمْ","يَكُ فَوْقَ لُجٍّ رَائحٌ أَوْ غَادِ",114,"د",1,0],["أذلُّ مراراً للصديق تواضُعاً","وأسطو على من يعتدي وأراهقُ",115,"ق",1,0],["أَذَلِكَ أَم جَونٌ يُطارِدُ آتُناً","حَمَلنَ فَأَربى حَملُهُنَّ دُروصُ",116,"ص",1,0],["أذل بني ماء السماء زمانهم","وذل بني ماء السماء كثير",117,"ر",1,0],["إذ لا يلائمُ مَعدِني بَشَرٌ","ما لم يكُنْ من معدِنٍ صُلُب",118,"ب",1,0],["أذْلَلْتَ نَفْسَكَ بَعْدَ تَكْرِمَة ٍ لها","فإذا تُرَاعُ، فإنّهَا لَنْ تُطْرَدَا",119,"د",2,0],["إِذْ لا هَوًى كَهَوَانا يُسْتَدامُ بهِ","عَهْدُ السُّرُورِ ، ولا دُنْيَا كَدُنْيَانَا",120,"ن",2,0],["إذْ لا تَزَالُ لَهُ خَيْلٌ مُدافِعَةٌ","بالطّعْنِ وَالضّرْبِ من صَنعاءَ أوْ عدَنِ",121,"ن",1,0],["أذلّ بني ماء السماء زمانُهم","وذلَّ بني ماء الزمان كثير",122,"ر",1,0],["إذْ لا تغيرها الوشاة ُ، فودها","صافٍ نُرَاسِلُ مَرَّة ً وَتزُورُ",123,"ر",1,0]]}