لله أنت السمع والبصر","https://www.aldiwan.net/poem59432.html","البسيط"],[378,"بشراك بشراك قد أدناكم النائي","https://www.aldiwan.net/poem66985.html","البسيط"],[381,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[381,"من للمحب المستهام","https://www.aldiwan.net/poem48802.html","مجزوء الكامل"],[381,"لبيك داعية الغرام","https://www.aldiwan.net/poem49199.html","مجزوء الكامل"],[387,"هل عند غان لفؤاد","https://www.aldiwan.net/poem1847.html","السريع"],[403,"حتام أكتم ما الدموع تبيح","https://www.aldiwan.net/poem46754.html","الكامل"],[404,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[404,"وكذاك توجيه الضمير فإنه","https://www.aldiwan.net/poem33594.html","الكامل"],[404,"ومليك عنه ما شئت فقل","https://www.aldiwan.net/poem33770.html","الرمل"],[404,"سرى طيفها والطرف مني مسهد","https://www.aldiwan.net/poem33967.html","الطويل"],[411,"حمدنا الذي أدى ابن يحيى فأصبحت","https://www.aldiwan.net/poem67519.html","الطويل"],[417,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[417,"ألا إن هذا الفؤاد اضطرم","https://www.aldiwan.net/poem54173.html","المتقارب"],[417,"بلغت بحمد الله ما أنا طالب","https://www.aldiwan.net/poem54188.html","الطويل"],[433,"خذوا لقلبي أمانا من تجنيه","https://www.aldiwan.net/poem12768.html","البسيط"],[438,"خف القطين وبان الرائح الغادي","https://www.aldiwan.net/poem2619.html","البسيط"],[440,"الآن رد عنان الملك في يده","https://www.aldiwan.net/poem34858.html","البسيط"],[440,"لئن سرت الدنيا فأنت سرورها","https://www.aldiwan.net/poem34913.html","الطويل"],[442,"وحسن جمال ليلى أن ليلى","https://www.aldiwan.net/poem14305.html","الوافر"],[444,"بحق من يا منيتي","https://www.aldiwan.net/poem56010.html","عموديه"],[459,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[459,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[459,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[462,"عفا الله عنها هل يلم خيالها","https://www.aldiwan.net/poem15086.html","الطويل"],[462,"يغب الغيث أكناف البلاد","https://www.aldiwan.net/poem15141.html","الوافر"],[465,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[465,"أهدى الضنا تذكارها","https://www.aldiwan.net/poem3495.html","عموديه"],[465,"يا فاضحاً بالقد غصن الآسن","https://www.aldiwan.net/poem3595.html","عموديه"],[478,"دمع جرى فأخجل الغماما","https://www.aldiwan.net/poem15186.html","الكامل"],[478,"رضيت بربقة العشاق حبسا","https://www.aldiwan.net/poem15212.html","الوافر"],[480,"أساءت لمن لم يبد منه لها ذنب","https://www.aldiwan.net/poem36914.html","الطويل"],[480,"عاقبتني بالصد وهو عصيب","https://www.aldiwan.net/poem36947.html","الكامل"],[480,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[516,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[516,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[539,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[552,"صارمت بعدك أشجاني فلا تلم","https://www.aldiwan.net/poem47218.html","البسيط"],[552,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[552,"زعازع ثم نكب","https://www.aldiwan.net/poem48102.html","الطويل"],[554,"اهلا بكيت ظعائنا وحمولا","https://www.aldiwan.net/poem68428.html","الكامل"],[559,"نحن المراتب بالوجود مرتبه","https://www.aldiwan.net/poem33526.html","الكامل"],[559,"أهل المحبة في السرور الدائمِ","https://www.aldiwan.net/poem33857.html","الكامل"],[559,"قد صرت كلي قلوبا فيه تحتار","https://www.aldiwan.net/poem34523.html","البسيط"],[559,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[559,"ظهر الوجود بسائر الأشياء","https://www.aldiwan.net/poem35085.html","الكامل"],[562,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[563,"أسفا لمن قد مات قبل مماته","https://www.aldiwan.net/poem52864.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[587,"جادت عليك من السحاب سواري","https://www.aldiwan.net/poem17533.html","الكامل"]],"verses":[["إِذ لا يُضيفونَ المَعائِبَ بَينَهُم","وَبُيوتُهُم وَقفٌ عَلى الضيفانِ",0,"ن",1,0],["إِذْ لَمْ تَكُنْ قَبْلَنا بِالمَجْدِ حاليَةً","وَلا لَها مَنظَرٌ مِنْ بَعْدِنا حَسَن",1,"ن",1,0],["إذْ لِمّتي سَحْماءُ مَدَّ على التُّقى","أظْلالَها وَرَقُ الشّبابِ الأخضَرُ",2,"ر",1,0],["إذ لم يكنْ والليلُ يَسحَبُ ذَيلَهُ","لسُعادَ غيرَ يَدي وِشاحٌ جائِلُ",3,"ل",1,0],["إذْ لِمَّتي كَجَناحِ النَّسْرِ داجِيَةٌ","والعَيْشُ رَقَّتْ حَواشي رَوضِهِ الخَضِلِ",4,"ل",1,0],["أذَلُّوا بِسَيفِ الدّولةِ ابنِ بَهائِها","رِقاباً فأرْخَى مِن عَلابِيِّها القَسْرُ",5,"ر",1,0],["إِذ لا أَزالُ عَلى رِحالَةِ سابِحٍ","نَهدٍ تَعاوَرُهُ الكُماةُ مُكَلَّمِ",6,"م",1,0],["إِذ لا تَزالُ لَكُم مُغَرغَرَةٌ","تَغلي وَأَعلى لَونِها صَهرُ",7,"ر",1,0],["إِذ لا أُبادِرُ في المَضيقِ فَوارِسي","وَلا أُوَكِّلُ بِالرَعيلِ الأَوَّلِ",8,"ل",1,0],["إِذ لا أَرى شِكلاً يَكونُ كَشِكلِنا","حُسناً ويَجمَعُنا هُناكَ جِوارُ",9,"ر",1,0],["أَذَلفاءُ إِن كانَ يُرضيكُم","عَذابي فَدونَكُمُ عَذِّبوا",10,"ب",3,0],["إِذ لا يُرى قَيسٌ يَكونُ كَقَيسِنا","حَسَباً وَلا كَبَنيهِ في الأَولادِ",11,"د",1,0],["إِذ لِمَّتي سَوداءُ أَتبَعُ ظِلَّها","دَدَناً قُعودَ غَوايَةٍ أَجري دَدا",12,"د",2,0],["أَذلَلتَ نَفسَكَ بَعدَ تَكرِمَةٍ لَها","أَو كُنتَ ذا عَوَزٍ وَمُنتَظِرٍ غَدا",12,"د",2,0],["أَذَلِكَ أَم خَميصُ البَطنِ جَأبٌ","أَطاعَ لَهُ النَواصِفُ وَالكَديدُ",13,"د",1,0],["إِذ لا تَزالُ فَريسٌ أَو مُغَبَّبَةٌ","صَيداءُ تَنشِجُ مِن دونِ الدِماغِ دَما",14,"م",2,0],["إِذ لا التَحِيَّةُ إيماءٌ مُخالَسَةً","وَلا الزِيارَةُ إِلمامٌ عَلى خَطَرِ",15,"ر",1,0],["إِذ لا تُرَجّي سُلَيمى أَن يَكونَ لَه","مَن بِالخَوَرنَقِ مِن قَينٍ وَنَسّاجِ",16,"ج",1,0],["أَذَلِكَ أَم جَونٌ يُطارِدُ آتُن","حَمَلنَ فَأَربى حَملُهُنَّ دُروصُ",17,"ص",1,0],["إِذ لا تُكَلِّمُنا وَكانَ كَلامُها","نَفلاً نُؤَمِّلُهُ مِنَ الأَنفالِ",18,"ل",1,0],["إِذ لُحِقَت مِن خَلفِها تَدَّعي","مِثلَ سَوامِ الرَجُلِ الغادِيَه",19,"ي",2,0],["أذُلاً وهذا العزّ صرّح سابغاً","علينا إِذن فالعز أن نُدرك الحَتفا",20,"ف",2,0],["إذ لست أنت بكُفْوِي","ولست أنت بنِدّي",21,"د",2,0],["إذ لن يقوم نظيره من بعده","هيهات أن تأتي الدنى بنظيره",22,"ر",2,0],["إِذ لا عِقالٌ يُحامي عَن ذَمارِكُمُ","وَلا زُرارَةَ لا يَحمي وَزَرّارُ",23,"ر",1,0],["إِذ لا تَغارُ عَلى البَناتِ مُجاشِعٌ","يَومَ الحِفاظِ وَلا يَفونَ بِجارِ",24,"ر",1,0],["إِذ لا يَذودُ عَنِ الحِمى مُتَوَكِّلٌ","رُمِيَت يَداهُ بِفالِجٍ وَجُذامِ",25,"م",1,0],["أَذَلِكَ أَم عِراقِيُّ شَتيمٌ","أَرَنَّ عَلى نَحائِصَ كَالمَقالي",26,"ل",2,0],["أَذَلِكَ أَم نَزرُ المَراتِعِ فادِرٌ","أَحَسَّ قَنيصاً بِالبَراعيمِ خاتِلا",27,"ل",2,0],["إذ لمتي جثلة اكفِّئها","يُضحك منها الغوانيَ العَجَبُ",28,"ب",1,1],["إذ لا يزال له نهبٌ يُنفِّله","من المقاسم لا وُخشٌ ولا نكدُ",29,"د",1,0],["إذ لا تَبِض إلى الترا","ئك والضرائك كف جازرْ",30,"ر",1,1],["أذلك لا بَل تَيِكَ غِبَّ وَجِيفِها","إذا ما أكَلَّ الصَّارِخُونَ وانقَبُوا",31,"ب",3,0],["إذ لِمَّتي جَثلَةٌ أُكَفِّئُها","يَضحَكُ مني الغَوانِيُ العَجَبُ",32,"ب",1,0],["إِذ لاتَرُدّونَ عَن أَكنافِ أَهلِكُمُ","شَوازِبَ الخَيلِ مِن مَثنىً وَوِحدانِ",33,"ن",1,0],["أَذَلَّ تَميماً بَعدَ عِزٍّ وَطالَما","أُذِلَّ بِنا الباغي وَعَزَّ المُجاوِرُ",34,"ر",1,0],["إذ لم يكن درهمي دِرْهمي","ن عندك لم يزكُ عند الغريبِ",35,"ب",1,1],["إذ لا يُرى ذنبٌ له","إلا بها وَلِيَ اكتسابهْ",36,"ب",2,0],["إذ لا أبالي فيهمُ","حسكَ العدو ولا ضِبابَهْ",36,"ب",2,0],["إذ لم يَرَوْا تقريعه","يوماً بذاك ولا اغتيابهْ",36,"ب",2,0],["أذلكَ أم تُدِلُّ بعزِّ قومٍ","قد انقرضوا فما منهم عَريبُ",37,"ب",1,0],["أذَلْنا دون ذلك كل عِلْقٍ","ومُلْتمِسُ السلامة لا يخيبُ",37,"ب",1,0],["أذلك أو قلتُ كان امرَأً","رأى الجودَ ذنباً عظيماً فتابا",38,"ب",2,0],["أذلك أو قلتُ بل لم يزلْ","أخا البخل إلا عِداتٍ كِذابا",38,"ب",2,0],["إذ لم أُسَقِّ الديارَ أدمُعَ لَهْ","فانَ تُوالي زفيرَهُ كُرَبُهْ",39,"ب",2,0],["أذِلْهَا أبا عيسى لَبُوساً فإنها","سَتبقى ويَبْلى الأتْحَمِيُّ المعَضَّدُ",40,"د",1,0],["إذ للشباب حِبالاتٌ أصيدُ بها","وغِرَّةٌ تدَّرِي وحشي لمصطادي",41,"د",2,0],["إذ لم تزدك ولايةٌ في سؤددٍ","كلّا ولا الأخرى محتْ لك سؤددا",42,"د",2,0],["إذ لم أنلْ من فضلكم","مقدارَ ما يزنُ النَّقيرُ",43,"ر",1,0],["أذلك أم هلّا منعت مُصرِّحاً","فأيأستني لكن خلقت من الصخر",44,"ر",1,0],["إذ لا أعدُّهم مما أحرِّمُهُ","بل كالاضاحيِّ من ضأنٍ وأمعوز",45,"ز",1,0],["أذلك أم يَزويه عنك وقد رأى","عطاياك إلا عاثرُ الجَدّ ناعِسه",46,"س",2,0],["إذ لا أرى في عيشتي شَرَقاً","بفراقِهِ كلا ولا غصصا",47,"ص",2,0],["إذ لا تزالُ تُسقّى","من رائبي بعد مَخضي",48,"ض",2,0],["إذ لم ينفِّل هناك نافلةً","تكونُ من نفسهِ له عِوضا",49,"ض",2,0],["أذلَّكَ حُبُّك عُجرَ الفيا","شِ يا ابنَ المَقاوِل من نَاعط",50,"ط",1,0],["إذ لا يكون لذي المِراس غناؤُهُ","إلا الدموعَ يحثُّها بدموع",51,"ع",1,0],["إذ لك اسمٌ من السلامة مشتق","قٌ وإذ كنت لي إليها شفيعا",52,"ع",2,0],["إذ لا يرى لأبي العباس حينئذ","حق السلام لقد أزرى به الموق",53,"ق",1,0],["إذ للشبيبة صبوة تُصبي بها","وبشاشة يصبى بها وتروق",54,"ق",1,0],["إذ لا تجوزُ الصوابَ خطبتُهُ","ولا يضلُّ الهدى إذا اقتعدكْ",55,"ك",1,0],["إذ لا تقحُّم في حين الأناة لهم","ولا أناةَ له في حين إقحامِ",56,"م",1,0],["إذ لا المنازلُ أطلالٌ نُسائلُها","ولا القواطنُ آجالٌ وصِيران",57,"ن",1,0],["إِذ لا تَجَهَّمُني أَرضُ العَدُوِّ وَلا","عَسفُ البِلادِ إِذا حِرباؤُها جَذَلا",58,"ل",2,0],["إِذ لا أُطاوِعُ أَمرَ العاذِلاتِ وَلا","أُبقي عَلى المالِ إِن ذو حاجَةٍ سَأَلا",58,"ل",2,0],["أَذَلَّ بَني ماءِ السَماءِ زَمانُهُم","وَذُلُّ بَني ماءِ السَماء كَبيرُ",59,"ر",1,0],["أَذَلُّ قَومَ حينَ يُدعى الجارُ","كَما أَذَلَّ الحَرِثَ النَخّارُ",60,"ر",1,0],["إذ لم يكن لبطرس","من طاقة بدلكسي",61,"ي",1,0],["أذِلُّ لِمَنْ دوني وأُعِطي مقادَتِي","وأُرجِعُ طرفِي وهو خَزيانُ خاشعُ",62,"ع",1,0],["إِذ لَم يَكُن شَرَفُ المَناكِحِ يُشتَرى","بِالمالِ في اللَأواءِ وَاللَزَباتِ",63,"ت",1,0],["إِذ لا يُنَهنِهُني العَذولُ وَلا أُرى","مُتَوَقِّفاً لِلَّومِ وَالتَعنيفِ",64,"ف",1,0],["إِذ لا وَسيلَةَ لِلواشي يَمُتُّ بِها","مَعَ الصِبا وَهوَ غَضّاتٌ وَسائِلُهُ",65,"ل",2,0],["إِذ لا الوِصالُ بِخُلسَةٍ فيهِم وَلا","فَرطُ اللِقاءِ لَدَيهِمُ بِلِمامِ",66,"م",1,0],["إِذ لا هَوىً كَهَوانا يُستَدامُ بِهِ","عَهدُ السُرورِ وَلا دُنيا كَدُنيايا",67,"ي",2,0],["إِذ لا تَزالُ لَهُ خَيلٌ مُدافِعَةٌ","بِالطَعنِ وَالضَربِ عَن صَنعاءَ أَو عَدَنِ",68,"ن",1,0],["أَذَلَّ بِهِ اللَهُ الَّذي كانَ ظالِماً","وَعَزَّ بِهِ المَظلومُ وَاِشتَدَّ جانِبُه",69,"ب",2,0],["إذ للعواذلِ غَفلَتي وتماسُلي","وإلى الغَوايَةِ نَهضَتي وَنَشاطي",70,"ط",2,0],["أذَلَّ عِزُّ النَّوى عَزاءَهُما","وبيَّنَ البينُ منهما الكَمَدا",71,"د",2,0],["أَذَلِكَ أَم شَتيمُ الوَجهِ جَأبٌ","عَلَيهِ مِن عَقيقَتِهِ عِفاءُ",72,"ا",2,0],["أَذَلَّ الحِرصُ وَالطَمَعُ الرِقابا","وَقَد يَعفو الكَريمُ إِذا اِستَرابا",73,"ب",2,1],["إِذ لَم يَكُن لَكِ في التَغَزُّلِ بِالمَها","لَقَبٌ وَلا أَسماهُ مَن أَسماكِ",74,"ك",1,0],["إِذ لا أَرومُ بِهِ الجَزاءَ لِأَنَّهُ","بَحرٌ أُنَزِّهُ غُلَّتي عَن وِردِهِ",75,"د",2,0],["أَذلِكَ خَيرٌ أَم تَعَسُّفُ سَبسَبٍ","يُعَقِّلُ أَخفافَ النّجائبِ عاتِكُه",76,"ك",2,0],["إِذ لا مُعَوَّلَ إِلّا كُلُّ مُعتَدِلٍ","أَصَمَّ يُبرِئُ أَقواماً مِنَ الصَمَمِ",77,"م",1,0],["إِذ لا نُعَطِّلُ مِنها مَنظَراً أَنِقاً","وَمَربَعاً بِمَها اللَذاتِ مَأنوسا",78,"س",2,0],["إِذ لا صَدوفُ وَلا كَنودُ اَسماهُما","كَالمَعنَيَينِ وَلا نَوارُ نَوارُ",79,"ر",1,0],["إِذْ لِلْهَوَى ثَمَرٌ يَرِفُّ وَلِلصِّبَا","كَأْسٌ تُشَفُّ وَلِلْمُنَى إِلْمَامُ",80,"م",1,0],["إذْ لمْ يزلْ يبلغُ المملوكَ ذكرُكُمُ","إياهُ جبراً وتأهيلاً ولا سببا",81,"ب",2,0],["إِذ لا تُغَيِّرُها الوُشاةُ فَوُدُّها","صافٍ تُراسِلُ مَرَّةً وَنَزورُ",82,"ر",1,0],["أَذِلُّ لَكُم يا عَبدَ فيما هَويتُمُ","وَإِنّي إِذا ما رامَني غَيرَكُم صَعبُ",83,"ب",1,0],["أُذَلُّ لِآلِ لَيلى في هَواها","وَأَقبَلُ لِلأَكابِرِ وَالصِغارِ",84,"ر",1,1],["أَذَلَّ جِبِاهَهم حَدَثٌ ذَميمٌ","أهانَ العِزَّ والشرَّفَ المصونا",85,"ن",2,0],["أَذِلّاءُ حَمّالونَ كُلَّ ظَلامَةٍ","وَمَن يَتَهَيَّب جانِبَ البَأسِ يُظلَمِ",86,"م",1,0],["أَذَلَّت طاعَةُ الأَهواءِ مِنهُم","نُفوساً بِالزَواجِرِ تَستَهينُ",87,"ن",1,0],["أذلك الجدُّ منكم أم هو السَّخَرُ","دعوا اللّجاجَ فهذا مطلبٌ عَسِرُ",88,"ر",1,0],["أَذَلِكَ أَم فَردٌ بِقَفرٍ أَجادَهُ","مِنَ الغَيثِ أَيكٌ فَرعُهُ قَد تَهَلَّلا",89,"ل",2,0],["إِذ لا يَزالُ مِنَ الفِتيانِ ذو طَرَبٍ","يَعُبُّ مِن ذَهَبٍ قَد ذابَ إِبريزِ",90,"ز",1,0],["إِذ لَيسَ لي عِلمٌ مِنَ ال","دُنيا بِما هُوَ آتِ",91,"ت",1,0],["إذْ لَمْ تَزَلْ تَصْفَحُ عَمَّنْ جَنَى","وتُؤْثِرُ العَفْوَ مَعَ القُدْرَهْ",92,"ر",2,0],["إذْ لَنْ يَقُومَ لَهُمْ نَبِيٌّ مِثْلُهُ","منهم ولو كانَ النَّبِيُّ مَثيلا",93,"ل",2,0],["إذ لا رعودَ سوى هماهمها","ولا بروقَ سوى مناصلها",94,"ل",3,0],["إذ لا يزالُ مُطاعاً في عَشيرتِهِ","تُلقَى إليه أُمورُ الزَّيْغ والنِّحَل",95,"ل",1,0],["إذ لا يزالُ لهم إليك تغلْغُلٌ","وسُرىً وَوَخْدٌ دائِمٌ وذمِيل",96,"ل",1,0],["إذْ لا تَبيتُ ظِباءُ الوحشِ نافرةً","ولا تُراعُ مَهاةُ الرملِ بالسِّيد",97,"د",1,0],["إذْ لا ترَى هِبْرزِيّاً غيرَ منعفرٍ","منهم ولا جاثلِيقاً غيرَ مصفود",97,"د",1,0],["إِذ لاذَ بِروازُ يَومَ ذاكَ بِنا","وَالحَربُ تَمري بِكَفِّ حالِبِها",98,"ب",3,0],["إِذ لَيسَ في الناسِ عَصَر","وَلا مِنَ الخَوفِ وَزَر",99,"ر",1,0],["أَذَلَّ صِعابَ المُشكِلاتِ مُحَمَّدٌ","فَأَصبَحَ مَمدوحاً بِكُلِّ لِسانِ",100,"ن",1,0],["إِذ لِبابِ الأَميرِ صَدرُ نَهاري","وَرَواحي إِلى بُيوتِ القِيانِ",101,"ن",1,0],["إِذ لا يَزالُ لها طَيفٌ يُؤَرِّقُني","نَشوانَ مِن حُبِّها أَو غَيرَ نَشوانِ",102,"ن",1,0],["أَذَلَّ لِطالِبِ العُضُلاتِ رَوحٌ","فَواضِلَهُ وَعَزَّ بِهِ الجِهادُ",103,"د",1,0],["إِذ لامَني عَمروٌ فَقُلتُ لَهُ","غُلِبَ العَزاءُ وَرُبَّما غَلَبا",104,"ب",2,0],["اذ ليس بغداد كما تلفى ولا","حكام بغدادٍ ذوي اِستبداد",105,"د",1,0],["إِذ لابِسُ الذِلَّةِ المَقطوعُ ذو رَحِمٍ","قَطَعتَهُ وَإِذا المَوصولُ مَن تَصِلُ",106,"ل",1,0],["أذلَّاءُ إنْ ناموا أرقاءُ إنْ صحوا","يُباعُ ويُشرَى فيهمو ويُسوّمُ",107,"م",1,0],["أُذِلَّتْ بقُرْبي عِنْدَه وقَضى لها","قَضاءً فَلَمْ يُنْقَضْ ولم يُتَعَقَّبِ",108,"ب",1,0],["أذلكَ أم كُدْرِيَّةٌ هاج وِرْدَها","من القيظ يومٌ واقِدٌ وسَمُومُ",109,"م",1,1],["إِذ لا تُرَجّي سُلَيمى أَن يَكونَ لَها","مَن بِالخَوَرنَقِ مِن قَينٍ وَنَسّاجِ",110,"ج",1,0],["أَذِلُّ لِعَبلَةٍ مِن فَرطِ وَجدي","وَأَجعَلُها مِنَ الدُنيا اِهتِمامي",111,"م",2,0],["إِذْ لِمَّتِي فَيْنَانَةٌ وَيَدِي","فَوْقَ الأَكُفِّ وَقَامَتِي أَلِفُ",112,"ف",1,0],["إِذْ لا صَدِيقَ يَسُرُّ السَّمْعَ غَائِبُهُ","وَلا رَفِيقَ يَرُوقُ الْعَيْنَ حَاضِرُهُ",113,"ر",2,0],["إِذْ لَمْ يَكُنْ فِي النَّاسِ مَلاَّحٌ وَلَمْ","يَكُ فَوْقَ لُجٍّ رَائحٌ أَوْ غَادِ",114,"د",1,0],["أذلُّ مراراً للصديق تواضُعاً","وأسطو على من يعتدي وأراهقُ",115,"ق",1,0],["أَذَلِكَ أَم جَونٌ يُطارِدُ آتُناً","حَمَلنَ فَأَربى حَملُهُنَّ دُروصُ",116,"ص",1,0],["أذل بني ماء السماء زمانهم","وذل بني ماء السماء كثير",117,"ر",1,0],["إذ لا يلائمُ مَعدِني بَشَرٌ","ما لم يكُنْ من معدِنٍ صُلُب",118,"ب",1,0],["أذْلَلْتَ نَفْسَكَ بَعْدَ تَكْرِمَة ٍ لها","فإذا تُرَاعُ، فإنّهَا لَنْ تُطْرَدَا",119,"د",2,0],["إِذْ لا هَوًى كَهَوَانا يُسْتَدامُ بهِ","عَهْدُ السُّرُورِ ، ولا دُنْيَا كَدُنْيَانَا",120,"ن",2,0],["إذْ لا تَزَالُ لَهُ خَيْلٌ مُدافِعَةٌ","بالطّعْنِ وَالضّرْبِ من صَنعاءَ أوْ عدَنِ",121,"ن",1,0],["أذلّ بني ماء السماء زمانُهم","وذلَّ بني ماء الزمان كثير",122,"ر",1,0],["إذْ لا تغيرها الوشاة ُ، فودها","صافٍ نُرَاسِلُ مَرَّة ً وَتزُورُ",123,"ر",1,0],["إِذ لَيسَ لي طَمَع في زور طَيفهم","وَإِن طَمعت فَباب النَوم مَسدودُ",124,"د",1,0],["إِذ لَيسَ يَنجَح وَالنَوائب جَمة","إِلّا ببابك دَعوَة العَوّاذ",125,"ذ",1,0],["إذلاء للَه في بابه ال","ظيم وفي الحرب شوس أسود",126,"د",1,0],["أذلت بما هجوت أباك عِرضاً","أبى الله المدبر أن يصانا",127,"ن",2,0],["أذَلَّكَ في مَواطِنِ صَادِقَاتٍ","وعَلَّكَ مِن مَشَارِبِ كُلِّ زَامِ",128,"م",1,0],["إذ لَيسَ بِالعَارِفِ مَن لَم يَكُن","عِندَ حُدُوقِ الشَّرعِ بالوَاقِفِ",129,"ف",1,0],["إِذ لَم تَكُن في عَصرِهِم وَلَوَ اِنَّهُم","شَهِدوا زَمانَكَ ما اِستَحَلّوا المَيسِرا",130,"ر",2,0],["أَذَلَّ عَصِيَّ الخَطبِ بَعدَ جِماحِهِ","إِلى أَن أَتى مِمّا جَنى مُتَنَصِّلا",131,"ل",2,0],["أَذَلَّ رِقابَ المُشركينَ بِوَطأَةٍ","ضُلوعُهُمُ مِن ذُعرِها لَيسَ تَهدأُ",132,"د",2,0],["إذ ليس يحفظ غير ما هو حافظٌ","أَبداً ولا ينسى سوى ما يرقدُ",133,"د",1,0],["أذلني الغرامُ فكلُّ لاج","عليَّ إِذا بدا وجدي أميرُ",134,"ر",1,0],["أذل صعاب المشكلات برأيه","ولين ما شا من مراكبها الخشنا",135,"ن",2,0],["إِذ لُمَّتي تَحكي الغُدافَ وَإِنَّما","أَشهى الشُعورِ إِلى العُيونِ الأَسوَدُ",136,"د",1,0],["إِذ لَيسَ البِيضُ تُؤَنِّبُني","بِمَشيبٍ لاحَ وَلا عَدَمِ",137,"م",1,0],["إِذ ليسَ يَدريه لا جنٌّ ولا ملكٌ","وَلا نبيٌّ قريبٌ من مقرّبهِ",138,"ب",2,0],["إِذ لهُ بِالبراقِ أرسل جِبري","لَ سَفيراً ما مثله سفراءُ",139,"ا",2,0],["أَذلنا دماءً في هواه وأدمعاً","وضنَّ لنا ظُلماً بِظَلْمِ ثناياه",140,"ا",2,0],["أذَلتُ لهُ دمعي الاَبيَّ وان يكن","أَعزَّ من الدنيا عليَّ واكرما",141,"م",2,0],["إذ لانَ في الوقعة كالقرطاسِ","حتى ضربنا رأسَه بالفاسِ",142,"س",1,0],["إذ لم تكن صلة منكم لذي أدب","فاجرة الخط أو كفارة الكذب",143,"ب",1,0],["أذلك بيت أم كناس يهابه","ويرهب غزلاناً به أفتك الأسد",144,"د",1,0],["إذ لم يكن في عَيْن شمسٍ لنا","مُخَيَّمٌ نَكْرَهُ سُكْناه",145,"ن",3,0],["إِذ لا مُعيني غَيرَ قَلبٍ والِهٍ","أَثرُ الحَمولِ وَدَمعُهُ مِهراقُ",146,"ق",1,0],["أُذِلَّت لَهُم في طاعَةِ اللَهِ أَنفُسٌ","كَرائِمُ لا يَعرِفنَ بُؤساً وَلا ذُلا",147,"ل",2,0],["إِذ لا ظَلومُ تُسِرُّ لي ظُلماً وَلا","ذاتُ النَصيفِ تَميلُ عَن إِنصافي",148,"ف",2,0],["أَذلَتُ دُموعي حِذاراً عَلَيكَ","مِنَ البَينِ وَالحُبُّ حُلوٌ وَمُرُّ",149,"ر",1,0],["إِذْ لاَالأَحِبَّةُ يَعْدُو عَنْ وِصَالِهِمُ","بُعْدٌ يُؤجِّجُ فِي أَحْشائِنا سَقَرَا",150,"ر",2,0],["أَ ذَلِكَ أَمْ دُرُّ الْبَيَانِ مُنَظَّماً","فَأَسْلاَكُهُ أَسْطَارُهُ شُطُورُهُ",151,"ر",2,0],["أَذلّ إِذا ما عَزَّ في الحُبِّ أَوسَطا","وَهَل لي إِذا ما عَزَّ إِلّا التَذَلّلُ",152,"ل",1,0],["إذ له المعروف خلقٌ","والسخا والجودُ عاده",153,"د",2,0],["إذ ليس ينجب من دهرنا","وأنت ابن الأنجب الأنجب",154,"ب",1,0],["إذ لا يساويك العلا في غاية","أيظن بالماشي يساوي الراكب",155,"ب",1,0],["إذ لم يَعُد لي بهجةٌ بجمالِها","لغيابِ بدرٍ في فؤادي أسفَرا",156,"ر",2,0],["اذ لَم أَكن لِسَبيل الرشد متبعا","وَلا لمنهج زلاتي بتراك",157,"ك",1,0],["أَذَلَّنِي حُبُّكُمُ فِي الْهُوى","فَما حَمَتْنِي ذِلَّتِي مِنْكُمْ",158,"م",1,0],["إِذ لَستُ إِلّا عَلى كَأ","سِ قَهوَةٍ أَتَنَفَّس",159,"س",1,0],["إِذ لَم تَكُن لي يا يَزيدُ مُطيَةً","فَجَعَلتُها لي في السِفارِ مَطيَه",160,"ي",2,0],["أذلك أم ضرسٌ من النخلِ مُترَعٌ","بوادي القُرى فيه العيونُ الرواجِعُ",161,"ع",1,1],["إِذ لا رَبيعُ الوصل فيه محرَّمٌ","كلّا وَلَيسَ خُطى المُنى بقصارِ",162,"ر",1,0],["إِذْ لم تكنْ بيعتُها","بالغَصْبِ والتغلب",163,"ب",1,0],["إِذ لا وليّ سِواهما فسقوطهُ","لَم يَختلف إِذ ذاك فيه اِثنانِ",164,"ن",1,0],["إِذ لا يرى حسبٌ عالٍ ولا نسبٌ","يومَ القيامةِ إلّا وهو منحسمُ",165,"م",1,0],["إِذ ليسَ يقدرُ رزء مثلك قدرهُ","إلّا اِمرؤٌ للدين منه موضعُ",166,"ع",1,0],["إِذ ليسَ يحرمُ راغبٌ أو راهبٌ","مِنه المُنى والأمن من موجوسِ",167,"س",1,0],["أذل فيا حبذا من مدل","ومن ظالم لدمي مستحل",168,"ل",1,1],["أَذَلُّ لَدَيهِ عَلَّهُ أَن يَرِقَّ لي","فَيَأخُذُهُ في ذِلِّيَ وَالشَمخُ",169,"خ",1,0],["إذ لا أزالُ على أرجاء مهلكةٍ","تسائل المعشر الأعداء ما صنعا",170,"ع",2,0],["إِذ لا كِتابٌ يُتلَى فَتَسمَعه","هَيهاتَ لَو كانَ سامِعاً لَتُلِي",171,"ل",2,0],["إذ لا يغرك كفر الكافرين به","كأنهم بقرٌ مأواهمُ سقر",172,"ر",1,0],["إذ لاحَ شَمسُ الهُدى في بُرجِ طالعِه","بِشارةٌ قَدَّست أرحامَ حَوّاءِ",173,"ا",2,0],["إِذ لِلوزارة ناموس بِهَيبَتِهِ","أَحياهُ لَما رَآهُ وَهُوَ مُحتضرُ",174,"ر",1,0],["أَذلا وَصال سِوى حَد","يث وَالتِزام وَالتِثام",175,"م",1,0],["إِذ لا رَقيب سِوى العَفا","ف وَلِأَوصال سِوى الكَلام",176,"م",1,0],["إِذ لَم أَجِد حَبلاً لَهُ مِرَّةٌ","إذ أَنا بَينَ الخَلِّ وَالأَوبَدِ",177,"د",1,0],["إذْ لا أَخافُ الكاشحين وقولهم","هذَا الفتى المسْتَهتَرُ المفْضوحُ",178,"ح",1,0],["إذ ليس إلاّ مدمعٌ مُتَدَفّقٌ","إثر الهوادح أو دمٌ مسفوحُ",178,"ح",1,0],["إذ لو جنحنا نحو ما قد قاله","لرأيت كلاً منهما مغسولا",179,"ل",2,0],["إذ لم يكن موسى مريداً عندما","قتل الغلام العالم التبديلا",180,"ل",2,0],["إذ لأموال الورى في داره","ولأوزار له لَفٌّ ونشر",181,"ر",1,0],["أذلك نظم أم كؤوس بعثتها","فإن مما قد بعثت معربد",182,"د",1,0],["أَذَلَّت مَعَ الشِركِ النِفاقَ سُيوفُهُ","وَكانَت لِأَهلِ الدينِ عِزّاً مُؤَبَّدا",183,"د",2,0],["أذلّوا عزّة المال","فما ذلّوا وما هانوا",184,"ن",3,0],["أذَلَّ الطغاة وأردى الكماة","وساق الصناديد سوق الغنم",185,"م",1,0],["أذلَّ بكَ الأخطارَ وهي عزيزة","فهانتْ عليه في علاك المصاعب",186,"ب",1,0],["إذ لا جُمارَ سوى دمعي فأقذِفُها","ولا هديَّ سوى قلبي فأُهديهِ",187,"ي",2,0],["إذ لا النوى بيننا يوما مفرقة","ولا المكتم من أسرارنا باد",188,"د",1,0],["إِذ لَمْ ترم خيلك الغزَّى بمكلئه","وَلَمْ يُضِعْ ثغرَكَ الأَعلى بِمَرْصَدِهِ",189,"د",2,0],["أَذَلَّ لَهُ عَبْدُ المليكِ ملوكَهَا","وَأَنْجَبَهُ المنصورُ فَهْوَ نصيرُها",190,"ر",3,0],["أذلتني أعمال قباح","عسى عزاً بآمال العزاز",191,"ز",1,0],["إذ لذة اللقاء في","سماك فوق قدرتي",192,"ي",1,0],["أذلَّهم الطِّلابُ وعزَّ وجهي","وضامهم الثَّراء ولم يَضِمني",193,"ن",2,0],["أذلتَني في أنفس مغمورةٍ","وأوجهٍ حُمسٍ وأيدٍ خُشُنِ",194,"ن",1,0],["أذللتَ قلبي للأسى وتركتني","أتبرَّدُ الزفراتِ وهي حِرارُ",195,"ر",1,0],["أذَلتُ مديحي والحوادثُ جمَّةٌ","بأعراضِ لؤمٍ من أَذاها نوالُها",196,"ل",3,0],["أذلَّ له القياد وكان صعباً","على الأحرار مُمتنعَ القِيادِ",197,"د",1,0],["إذ لحظُ كل غزالٍ ما بهِ خزرٌ","ولفظ كلّ عتابٍ بيننا غزل",198,"ل",1,0],["إذ لا يخاف محاقها","لكن يخاف سرارها",199,"ر",3,0],["إذ للعيون على القلوب ولايةٌ","فالليث يحكم فيه ظبيُ كناس",200,"س",1,0],["أذلتُها من بعدِ صوني برهةً","لها فأثبتُّ بها الغراما",201,"م",2,0],["أُذِلُّ بها أعرَّةَ كلَِّ حيِّ","واِنْ كَرُموا محاربَةُ وجِنْسا",202,"س",2,0],["أذل الهوى نفسي وكانت أبية","وما حلت عن طبعي ولكن هو الحب",203,"ب",1,0],["اذ لا اختيار ولا تصرف لا مرىء","في أي شيء والنفوس ضروب",204,"ب",1,0],["إذ لم يكن قول المؤرخ فيصلا","يعطي لنفسه وحده التحكيما",205,"م",2,0],["أذل بها ملوك الشرك ملك","يذلل شامس النوب الصعاب",206,"ب",1,0],["أذله الشوق ولولا فقره","إلى الغواني ما بدا افتقاره",207,"ر",2,0],["إذ لستَ تَقوَى مِن مَهابته أَن","ترَاهُ وهو فِيك ذو تَحَقُّقِ",208,"ق",1,0],["إِذ لا حُشاشةَ إلّا في فَمٍ حنقٍ","وَلا يدٌ للرّدى إلّا عَلى كظمِ",209,"م",1,0],["إذْ لا جريء البأسِ إلّا مُحجمٌ","حيرانُ يخبط حَيْرةً بتأمّلُ",210,"ل",1,0],["أَذلَّ رَبّيَ قَوماً","لَهُم مِنَ الذُلّ شِربُ",211,"ب",1,0],["إِذ لا حِمى إِلّا الرِماحُ وَبَينَها","خَيلٌ يَطَأنَ بِقاتِلٍ مَقتولا",212,"ل",2,0],["إذ لا سواه وما سواه جميعه","إلا الشئون له به متغلبه",213,"ب",2,0],["إذ لا نعيم سوى نعيم شهوده","يوم اللقا بلطائف وكرائم",214,"م",1,0],["إذ ليس للحق مع شيء مناسبة","ولا بوجه فكالتصديق إنكار",215,"ر",1,0],["إذ لا مضل بلا إضلاله أحداً","ولا يسمى بهادٍ دون إهداء",216,"ا",2,0],["إذ لم تكن تعلمْ به من حيث ما","هو في تدانٍ للورى وتناء",217,"ا",2,0],["إِذ لَقِحَ اليَومُ العَماسُ وَاقمَطَر","وَخَطَرَت أَيدي الكُماةِ وَخَطَر",218,"ر",1,0],["إذ لم يَجِدْ في الناسِ أمثالاً لهُ","طَلَبَ الملائكَ فَهْيَ من طَغمَاتِهِ",219,"ت",2,0],["إذ لم يكن يعرف من وليه","كمثل ما قد قاله نبيه",220,"ه",1,0],["إذْ لا يَعُوجُ إلى الدِّيارِ مُسائِلاً","شِعْري ولا أَشْكُو فِراقَ قِفَارِ",221,"ر",1,0]]}