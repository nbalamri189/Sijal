{"poems":[[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[87,"ظلم الرجال نساءهم وتعسفوا","https://www.aldiwan.net/poem63768.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85579","المجتث"],[190,"وجاهل زوج بنتا له","https://www.aldiwan.net/poem43284.html","السريع"],[369,"هو ما علمت فأقصري أو فاعذلي","https://www.aldiwan.net/poem60809.html","الكامل"],[457,"أبدر تم مذ تبدا طالعا","https://www.aldiwan.net/poem13829.html","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64336","المنسرح"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101038","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28578","السريع"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140313",""],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139842",""],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36658","الدوبيت"]],"verses":[["ما زوى اللَّه عن علي بن يحيى","وزواه عني فلست أبالي",0,"ل",2,0],["ما زُوِّجَت تِلكَ الفَتاةُ وَإِنَّما","بيعَ الصِبا وَالحُسنُ بِالدينارِ",1,"ر",1,0],["ما زوى الداء منك تلك السجايا","فَلَقَد كنت أي وَرَبي حمولا",2,"ل",2,0],["ما زوجة المرء إلا","حصن العفاف المنيع",3,"ع",1,0],["ما زوّج البنت ولكنّه","زوجه من جهله أمّها",4,"ه",2,0],["ما زوّد الأحبابَ منه تَعلُّلاً","إلاّ وَداعَ الظّاعنِ المُتَحمِّل",5,"ل",1,0],["ما زورة الحب وما نيل المني","مذ راح يهدي نحونا البدائعا",6,"ع",2,0],["ما زوج الماء بنت عاشرة","أرق منها في العين أو أبهج",7,"ج",1,0],["مازوا الجديد من القديم ومادروا","أن الجديد من القديم سليل",8,"ل",1,0],["ما زُوحِمَت في المَجدِ أَعمامُهُ","إِلّا إِذا عَدَّدَ أَخوالَه",9,"ل",2,0],["ما زوجت بسوى ابن المزن والدها","فعل المجوس بها القسيس يفتيها",10,"ي",3,0],["ما زودتك سعاد في إلمامها","إلا بنزر من رخيم كلامها",11,"م",3,1],["ما زَوجُكِ بانياً بِكِ اليَومَ سِوى","موهٍ لِقَواعِد اِصطِباري هادِم",12,"م",1,0]]}