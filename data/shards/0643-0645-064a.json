{"poems":[[53,"أعاد لي عيد الضنى","https://www.aldiwan.net/poem29729.html","مجزوء الرجز"],[53,"أبا نزار تفسد القوم النعم","https://www.aldiwan.net/poem29802.html","الرجز"],[53,"أتذكراني طلب الطوائل","https://www.aldiwan.net/poem29897.html","الرجز"],[53,"ما رقع الواشون في ولفقوا","https://www.aldiwan.net/poem29938.html","الكامل"],[53,"قد زيلت عظيمة فشمري","https://www.aldiwan.net/poem30450.html","الرجز"],[63,"يا طرة الشيح بسفح عاقل","https://www.aldiwan.net/poem46162.html","الرجز"],[3,"كم يبعد الدهر من أرجو أقاربه","https://www.aldiwan.net/poem125.html",""],[9,"ألم تنه نفسك عما بها","https://www.aldiwan.net/poem21912.html","المتقارب"],[9,"أجد بتيا هجرها وشتاتها","https://www.aldiwan.net/poem21916.html","الطويل"],[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[71,"ذراها إذا رامت معاجاً إلى الحمى","https://www.aldiwan.net/poem4002.html","الطويل"],[71,"جعل العتاب إلى الصدود توصلا","https://www.aldiwan.net/poem4030.html","الكامل"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[82,"لكل شيء إذا ما تم نقصان","https://www.aldiwan.net/poem29425.html","البسيط"],[93,"لقيتك مصر بثغرها المتبسم","https://www.aldiwan.net/poem11335.html","الكامل"],[83,"هذا الصباح صباح الشيب قد وضحا","https://www.aldiwan.net/poem54333.html","الكامل"],[88,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[4,"لما أتاني عن طفيل ورهطه","https://www.aldiwan.net/poem21200.html","الطويل"],[37,"كميت يزل اللبد عن دأياتها","https://www.aldiwan.net/poem7234.html","الطويل"],[72,"لتهن عين إلى مراك قد طمحت","https://www.aldiwan.net/poem18476.html","البسيط"],[72,"لغرة الأفق بياض شدخ","https://www.aldiwan.net/poem18533.html","السريع"],[64,"كم ينشرني الهوى وكم يطويني","https://www.aldiwan.net/poem67535.html","الدوبيت"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[51,"قرن سليمان قد أضر به","https://www.aldiwan.net/poem65440.html","المنسرح"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[51,"يا ابن حسان لا تشكن في دينى","https://www.aldiwan.net/poem66483.html","الخفيف"],[51,"ما الشكر مني لما أوليتني ثمنا","https://www.aldiwan.net/poem66514.html","البسيط"],[16,"ذهبت من الهجران في غير مذهب","https://www.aldiwan.net/poem27693.html","الطويل"],[91,"يا عبيد اللّه لا زلت","https://www.aldiwan.net/poem61853.html","مجزوء الرمل"],[70,"يا كتابا من حبيب","https://www.aldiwan.net/poem42406.html","مجزوء الرمل"],[70,"كم يذهب هذا العمر في خسران","https://www.aldiwan.net/poem42431.html","الدوبيت"],[85,"يا غاب بولون ولي","https://www.aldiwan.net/poem63721.html","مجزوء الكامل"],[56,"ألا إسقنيها صاحبي وخليلي","https://www.aldiwan.net/poem58523.html","الطويل"],[49,"كل امرئ فكما يدين يدان","https://www.aldiwan.net/poem63132.html","الكامل"],[49,"كم يكون الشتاء ثم المصيف","https://www.aldiwan.net/poem64243.html","الكامل"],[66,"أرسلت في الكؤوس بالمعجزات","https://www.aldiwan.net/poem39185.html","الخفيف"],[66,"عجبت لها تمسي العقول لها نهبا","https://www.aldiwan.net/poem39205.html","الطويل"],[97,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[97,"جلست يوما حين حل المساء","https://www.aldiwan.net/poem24794.html","السريع"],[80,"قضت في الصبا النفس أوطارها","https://www.aldiwan.net/poem31465.html","المتقارب"],[44,"كم يتمادى ليلي الأطول","https://www.aldiwan.net/poem30130.html","السريع"],[69,"حرفوشة قد سبتني","https://www.aldiwan.net/poem28218.html","المجتث"],[81,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[21,"كميت بهيم اللون ليس بفارض","https://www.aldiwan.net/poem36158.html","الطويل"],[22,"ستكفيك أمثال المجادل جلة","https://www.aldiwan.net/poem22005.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[46,"لو كنتم أهل صفو قال ناسبكم","https://www.aldiwan.net/poem22122.html","البسيط"],[46,"ما وفقوا حسبوني من خيارهم","https://www.aldiwan.net/poem22330.html","البسيط"],[46,"أقصرت من قصر النهار وقد أنى","https://www.aldiwan.net/poem22568.html","الكامل"],[46,"كم يسر الأمر لم تأمل تيسره","https://www.aldiwan.net/poem22627.html","البسيط"],[46,"كم ينظم الدهر من عقد وينثره","https://www.aldiwan.net/poem22665.html","البسيط"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[15,"تذكرت أهلي الصالحين بملحوب","https://www.aldiwan.net/poem45284.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147474",""],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42636","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54887","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54720","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54242","الخفيف"],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[51,"يا بن حسانَ لا تشكنَّ في دي","https://www.poetsgate.com/ViewPoem.aspx?id=30674",""],[71,"جعل العتاب الى الصدود توصٌّلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=28014&r=&rc=1",""],[4,"لَمّا أتَانِي عَنْ طُفَيْلٍ وَرَهْطِهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10950&r=&rc=45",""]],"verses":[["كَميا النُزوعُ عِندَكُم","كَذا النِزاعُ عِندَنا",0,"ن",2,0],["كَم يَلبَثُ الأَصلُ عَلى ضَربِ القُدُم","عُرِّضتَ مِنّي لِبَصيرٍ بِالقِيَم",1,"م",1,0],["كَم يَقتَضيني السَيفُ عَزمي وَيَدي","تَدفَعُهُ دَفعَ الغَريمِ الماطِلِ",2,"ل",1,0],["كَم يُسبَكُ الذَهَبُ المُصَفّى مَرَّةً","قَد لاحَ جَوهَرُهُ وَبانَ الرَونَقُ",3,"ق",1,0],["كَم يَومِ مَجدٍ ظاهِرٍ فَخارُهُ","عَنهُم ظُهورَ الأَبلَقِ المُشَهَّرِ",4,"ر",1,0],["كمْ يُلْقِحُ الآمالَ وهْيَ تَرْعَوي","إليهِ في أعقابِ جَدٍّ حائِلِ",5,"ل",1,0],["كَم يُبعِدُ الدَهرُ مَن أَرجو أُقارِبُهُ","عَنّي وَيَبعَثُ شَيطاناً أُحارِبُهُ",6,"ب",2,1],["كُمَيتٍ يُرى دونَ قَعرِ الإِنى","كَمِثلِ قَذى العَينِ يُقذى بِها",7,"ب",3,0],["كُمَيتٍ عَلَيها حُمرَةٌ فَوقَ كُمتَةٍ","يَكادُ يُفَرّي المَسكَ مِنها حَماتُها",8,"ت",3,0],["كُمَيتاً تَكَشَّفُ عَن حُمرَةٍ","إِذا صَرَّحَت بَعدَ إِزبادِها",9,"د",3,0],["كُمَيتٍ إِذا ما نلتُ مِنها ثَلاثَةً","رَأَيتُ السَما كَالأَرضِ وَالأَرضَ كَالسَما",10,"م",2,0],["كَم يَومِ هَولٍ قَد وَرَدتَ وَطَعمُهُ","مُرُّ المَذاقِ كَريه نارِ المُصطَلى",11,"ل",2,0],["كُمَيتٍ يَزِلُّ اللِبدُ عَن حالِ مَتنِهِ","كَما زَلَّتِ الصَفواءُ بِالمُتَنَزَّلِ",12,"ل",1,0],["كَم يَستَغيثُ بِنا المُستَضعَفُونَ وَهُم","قَتلى وَأَسرى فَما يَهتَزَّ إِنسانُ",13,"ن",1,0],["كَمْ يَمَّمَتْ هِبَةٌ كَرِيماً مُوحَشاً","فِي دَارِهِ وَذَرَاهُ غَيرُ مُيَمَّمِ",14,"م",1,0],["كم يكدحُ المرءُ لا يدري مَنِيَتَهُ","أليسَ كلُّ امرئ يُجزى بما كَدَحا",15,"ح",2,0],["كم يدّعي وطنيةً","من لم تكن مرّت ببابه",16,"ب",2,0],["كَميشُ الإِزارِ يَكحَلُ العَينَ إِثمِداً","سُراهُ وَيُضحي مُسفِراً غَيرَ واجِمِ",17,"م",1,0],["كميَّتٌ يزل اللِّبْدْ عن دَأياتها","كما زلَّ عن رأس الشجيج المحارِفُ",18,"ف",1,1],["كم يقصد الدهر إغضابِي بقادحةٍ","في الحال لكنَّها في الصبرِ ما قدحت",19,"ت",1,0],["كم يبصق الثلج على لحيةٍ","وكم يقول الرعد في الوجه إخّ",20,"خ",1,0],["كَم يَنشُرُني الهَوى وَكَم يَطويني","يا مالِكَ دُنيايَ وَمَولى ديني",21,"ي",1,1],["كم يُعَزّ المُفَضَّلُ المبخوتُ","ويُبَزُّ المحبَّبُ المنعوتُ",22,"ت",1,1],["كم يَعِدُ القرن باللقاء وكم","يكذب في وعده ويخلفه",23,"ف",2,0],["كمينُ ردىً في جسمه أوْ مُبارِزٌ","نجيدٌ من الأقران غادره جِذمْ",24,"م",1,0],["كم يُعَرِّينيَ من أفضالكم","ألبس اللَّه عدوي كفنَه",25,"ن",2,0],["كم يكونُ العتوُّ في الأرض يا شقْ","راقُ لا ترعوي ولا تستكين",26,"ن",1,0],["كم يا أبا الصقر من نُعمى تركتَ بها","شُكري على غابرِ الأيامُ مُرتَهنا",27,"ن",2,0],["كُمَيتٍ كَلَونِ الأُرجُوان نَشَرتَهُ","لِبَيع الرِداءِ في الصُوانِ المُكَعَّبِ",28,"ب",1,0],["كم يَدٍ مثل أيادٍ","عن يدٍ منك كأيدي",29,"د",2,0],["كَم يَدٍ لِلدَهرِ مُذ أَب","صَرتُ آثارَ يَدَيهِ",30,"ي",2,0],["كَم يَذهَبُ هَذا العُمرُ في خُسرانِ","ما أَغفَلَني عَنهُ وَما أَنساني",31,"ي",1,1],["كَم يا جَمادُ قَساوَةً","كَم هَكَذا أَبَداً جُحود",32,"د",1,0],["كُمَيْتٌ خَطَبناها إلى رَبِّ دَنِّها","وقَدْ آذَنَتْ زُهْرُ الدُّجَى بأُفُولِ",33,"ل",1,0],["كَم يَستَصِمُّ الغافِلونَ وَقَد دُعوا","وَغَدا وَراحَ عَلَيهِمُ الحَدَثانُ",34,"ن",1,0],["كَم يَكونُ الشِتاءُ ثُمَّ المَصيفُ","وَرَبيعٌ يَمضي وَيَأتي الخَريفُ",35,"ف",1,1],["كَم يَفوتُ المُعَربِدينَ عَلى السُك","رِ لَدينا مِن طَيِّبِ اللَذّاتِ",36,"ت",1,0],["كُمَيتٌ إِذا شاهَدتَها في إِنائِها","وَلَكِن لِصافي لَونِها دُعِيَت صَهبا",37,"ب",2,0],["كم يَعذُب الموت لو نراهُ","أو كان فيك اللقاءُيُرجى",38,"ج",2,0],["كم يسخر النجمُ بنا مِن عل","وكم يرانا الله أطفالا",39,"ل",2,0],["كميتاً لها مَرَحٌ بِالفَتى","إِذا حَثَّ بِاللَّهوِ أَدوارَها",40,"ر",3,0],["كَم يَتَمادى لَيلِيَ الأَطوَلُ","كَم يَتَبارى دَمعِيَ المُسبَلُ",41,"ل",1,1],["كمْ يا مُسيكين تبكي","على شُعَيْري الجُعَيْدي",42,"ي",1,0],["كَمِيُّ تَجَلَّت مِن بَنِي حَكَمٍ بِهِ","ظُباً مَا لَهَا غَيرَ المَعَانِي صَيَاقِلُ",43,"ل",1,0],["كُمَيتٍ بَهيمِ اللَونِ لَيسَ بِفارضٍ","ولا بِخَصيفٍ ذات لَونٍ مُرَّقَمِ",44,"م",1,1],["كُمَيتٍ كَرُكنِ البابِ قَد شَقَّ نابُهُ","وَأَحيَت لَهُ مِقلاتُها وَنَزورُها",45,"ر",3,0],["كم يَدٍ عن نَبِيِّهِ كَفَّهَا الل","هُ وَفي الخَلْقِ كَثْرَةٌ وَاجتراءُ",46,"ا",2,0],["كَم يُقتَلُ الناسُ ما هَمُّ الَّذي عَمَدَت","يَداهُ لِلقَتلِ إِلّا أَخذُهُ السَلَبا",47,"ب",2,0],["كَم يَنشُدونَ صَفاءً مِن دِيانَتِهِم","وَلَيسَ يوجَدُ حَتّى المَوتِ ما نَشَدوا",48,"د",3,0],["كَم يَسمَعُ الناسُ العِظاتِ وَكَم رَأَوا","غَيرَ الجَميلِ فَغُضَّت الأَبصارُ",49,"ر",1,0],["كَم يُسِّرَ الأَمرُ لَم تَأمَل تَيَسُّرَهُ","وَكَم حَذِرتَ فَما وُقّيتَ مَحذورا",50,"ر",2,1],["كَم يَنظِمُ الدَهرُ مِن عِقدٍ وَيَنثُرُهُ","وَلَيسَ عِقدُ ثُرَيّاهُ بِمُنتَثِرِ",51,"ر",1,1],["كُمَيتٍ عَصاها النَقرُ صادِقَةِ السُرى","إِذا قيلَ لِلحَيرانِ أَينَ تُخالِفُ",52,"ف",1,0],["كُمَيتٍ كَشاةِ الرَملِ صافٍ أَديمُهُ","مُفِجِّ الحَوامي جُرشُعٍ غَيرِ مَخشوبِ",53,"ب",1,0],["كُمَيتٌ كأَنَّ عَلى مَتِنِهِ","سَبائِكَ مِن قِطَعِ المُذهَبِ",54,"ب",1,0],["كَم يودّ الإنسان لَو طارَ في الجو","وِ خَفيفاً كَما تطير القطاة",55,"ه",1,0],["كَم يَتيمٍ كادَت بِهِ البَأ","ساءُ لَولا رِعايَةُ الأَطفالِ",56,"ل",1,0],["كم يبطئون عن الجمي","ل وما مناياهم بطيئة",57,"ه",1,0],["كُمَيْتٌ جَرَتْ فِي حَلْبَةِ الدَّهْرِ فَانْطَوَتْ","ثَمِيلَتُهَا وَالْخَيْلُ تُحْمَدُ بِالضُّمْرِ",58,"ر",1,0],["كَمِياَهِ العُيُونِ تَجْرِي بِذَوْبٍ","مِنْ مَشِيبِ الجِبَالِ مِلْءَ النُّهُورِ",59,"ر",1,0],["كَمْ يَسَّرَ النوْمَ الْهَنِيءَ لِسَاهِدٍ","شَاكٍ وَلَطَّفَ مِنْ أَسَى مَكْمُوُدِ",60,"د",1,0],["كَمْ يَتِيمٍِ مِنَ الْمعَانِي غَرِيبٍ","مَسَحَتْ كَفُّهُ عَلَيْهِ فَصَانَه",61,"ن",2,0],["كم يمُدُّ اليديْنِ أَسْوانَ مُضْنىً","فَيفِرُّ الشُّعاعُ من قَبَضاتِهْ",62,"ت",2,0],["كم يُروى منفوخةً أوداجُهُ","من نِعاجٍ هُزِلَتْ ، ذئبٌ سمين",63,"ن",1,0],["كمي مشى بين الكمات وحوله","نجوم بليل من عجاج طوالع",64,"ع",1,0],["كم يَعْجَبُ المرءُ من أمرٍ يفاجئه","وما درى أن فيهأعجبَ العجب",65,"ب",1,0],["كم يكونُ العتو في الأرض يا شقْر","راقُ لا ترعوي ولا تستكين",66,"ن",1,0],["كم يوم هولٍ قد وردت وطعمه","مر المذاق كريه نار المصطلا",67,"ل",2,0],["كميشُ الإزارِ يَكْحَلُ العَيْنَ إثْمِداً","سُرَاهُ ، وَيُضْحِ مُسْفِراً غَيرَ وَاجِمِ",68,"م",1,0]]}