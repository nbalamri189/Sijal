ريع"],[455,"من دمعة الشعب ومن كده","https://www.aldiwan.net/poem61803.html","السريع"],[460,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[460,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[460,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[460,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[460,"يا ليلة ما رأتها أعين الغير","https://www.aldiwan.net/poem56196.html","البسيط"],[460,"لا تلمس الشمس يد","https://www.aldiwan.net/poem56236.html","مجزوء الرجز"],[460,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[460,"أَستنجِد الصبر فيكم وهو مغلوب","https://www.aldiwan.net/poem56300.html","البسيط"],[479,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[479,"كم يذهب هذا العمر في الخسران","https://www.aldiwan.net/poem15365.html","الدوبيت"],[483,"تسائلني بنو جشم بن بكر","https://www.aldiwan.net/poem1770.html","الوافر"],[516,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[516,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[516,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[516,"يا جيرة بالطرب تحيي دياجيكم","https://www.aldiwan.net/poem20907.html","المواليا"],[555,"خليلي لست أرى الحب عارا","https://www.aldiwan.net/poem68409.html","المتقارب"],[561,"لأخلعن عذارى في محبتكم","https://www.aldiwan.net/poem69347.html","البسيط"],[561,"أيها اللائم رفقا","https://www.aldiwan.net/poem69350.html","مجزوء الرمل"],[564,"مات الحبيب كأنه لم يولد","https://www.aldiwan.net/poem52912.html","الكامل"],[577,"ما لي أنهنه عنك آمالي","https://www.aldiwan.net/poem2782.html","أحذ الكامل"],[577,"لا أجازى حبيب قلبي بجرمه","https://www.aldiwan.net/poem2856.html","الخفيف"],[577,"ظبي بمصر نسيت منه","https://www.aldiwan.net/poem2908.html","مجزوء الكامل"],[577,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[588,"كم يشمت بي في حبك العذال","https://www.aldiwan.net/poem17647.html","مخلع الرمل"],[588,"يا من أمر الغرام والقلب له","https://www.aldiwan.net/poem17830.html","الدوبيت"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/17779","الوافر"],[1139,"","https://poetry.dctabudhabi.ae/diwan/poem/29462","المتقارب"]],"verses":[["كَميا النُزوعُ عِندَكُم","كَذا النِزاعُ عِندَنا",0,"ن",2,0],["كَم يَلبَثُ الأَصلُ عَلى ضَربِ القُدُم","عُرِّضتَ مِنّي لِبَصيرٍ بِالقِيَم",1,"م",1,0],["كَم يَقتَضيني السَيفُ عَزمي وَيَدي","تَدفَعُهُ دَفعَ الغَريمِ الماطِلِ",2,"ل",1,0],["كَم يُسبَكُ الذَهَبُ المُصَفّى مَرَّةً","قَد لاحَ جَوهَرُهُ وَبانَ الرَونَقُ",3,"ق",1,0],["كَم يَومِ مَجدٍ ظاهِرٍ فَخارُهُ","عَنهُم ظُهورَ الأَبلَقِ المُشَهَّرِ",4,"ر",1,0],["كمْ يُلْقِحُ الآمالَ وهْيَ تَرْعَوي","إليهِ في أعقابِ جَدٍّ حائِلِ",5,"ل",1,0],["كَم يُبعِدُ الدَهرُ مَن أَرجو أُقارِبُهُ","عَنّي وَيَبعَثُ شَيطاناً أُحارِبُهُ",6,"ب",2,1],["كُمَيتٍ يُرى دونَ قَعرِ الإِنى","كَمِثلِ قَذى العَينِ يُقذى بِها",7,"ب",3,0],["كُمَيتٍ عَلَيها حُمرَةٌ فَوقَ كُمتَةٍ","يَكادُ يُفَرّي المَسكَ مِنها حَماتُها",8,"ت",3,0],["كُمَيتاً تَكَشَّفُ عَن حُمرَةٍ","إِذا صَرَّحَت بَعدَ إِزبادِها",9,"د",3,0],["كُمَيتٍ إِذا ما نلتُ مِنها ثَلاثَةً","رَأَيتُ السَما كَالأَرضِ وَالأَرضَ كَالسَما",10,"م",2,0],["كَم يَومِ هَولٍ قَد وَرَدتَ وَطَعمُهُ","مُرُّ المَذاقِ كَريه نارِ المُصطَلى",11,"ل",2,0],["كُمَيتٍ يَزِلُّ اللِبدُ عَن حالِ مَتنِهِ","كَما زَلَّتِ الصَفواءُ بِالمُتَنَزَّلِ",12,"ل",1,0],["كَم يَستَغيثُ بِنا المُستَضعَفُونَ وَهُم","قَتلى وَأَسرى فَما يَهتَزَّ إِنسانُ",13,"ن",1,0],["كَمْ يَمَّمَتْ هِبَةٌ كَرِيماً مُوحَشاً","فِي دَارِهِ وَذَرَاهُ غَيرُ مُيَمَّمِ",14,"م",1,0],["كم يكدحُ المرءُ لا يدري مَنِيَتَهُ","أليسَ كلُّ امرئ يُجزى بما كَدَحا",15,"ح",2,0],["كم يدّعي وطنيةً","من لم تكن مرّت ببابه",16,"ب",2,0],["كَميشُ الإِزارِ يَكحَلُ العَينَ إِثمِداً","سُراهُ وَيُضحي مُسفِراً غَيرَ واجِمِ",17,"م",1,0],["كميَّتٌ يزل اللِّبْدْ عن دَأياتها","كما زلَّ عن رأس الشجيج المحارِفُ",18,"ف",1,1],["كم يقصد الدهر إغضابِي بقادحةٍ","في الحال لكنَّها في الصبرِ ما قدحت",19,"ت",1,0],["كم يبصق الثلج على لحيةٍ","وكم يقول الرعد في الوجه إخّ",20,"خ",1,0],["كَم يَنشُرُني الهَوى وَكَم يَطويني","يا مالِكَ دُنيايَ وَمَولى ديني",21,"ي",1,1],["كم يُعَزّ المُفَضَّلُ المبخوتُ","ويُبَزُّ المحبَّبُ المنعوتُ",22,"ت",1,1],["كم يَعِدُ القرن باللقاء وكم","يكذب في وعده ويخلفه",23,"ف",2,0],["كمينُ ردىً في جسمه أوْ مُبارِزٌ","نجيدٌ من الأقران غادره جِذمْ",24,"م",1,0],["كم يُعَرِّينيَ من أفضالكم","ألبس اللَّه عدوي كفنَه",25,"ن",2,0],["كم يكونُ العتوُّ في الأرض يا شقْ","راقُ لا ترعوي ولا تستكين",26,"ن",1,0],["كم يا أبا الصقر من نُعمى تركتَ بها","شُكري على غابرِ الأيامُ مُرتَهنا",27,"ن",2,0],["كُمَيتٍ كَلَونِ الأُرجُوان نَشَرتَهُ","لِبَيع الرِداءِ في الصُوانِ المُكَعَّبِ",28,"ب",1,0],["كم يَدٍ مثل أيادٍ","عن يدٍ منك كأيدي",29,"د",2,0],["كَم يَدٍ لِلدَهرِ مُذ أَب","صَرتُ آثارَ يَدَيهِ",30,"ي",2,0],["كَم يَذهَبُ هَذا العُمرُ في خُسرانِ","ما أَغفَلَني عَنهُ وَما أَنساني",31,"ي",1,1],["كَم يا جَمادُ قَساوَةً","كَم هَكَذا أَبَداً جُحود",32,"د",1,0],["كُمَيْتٌ خَطَبناها إلى رَبِّ دَنِّها","وقَدْ آذَنَتْ زُهْرُ الدُّجَى بأُفُولِ",33,"ل",1,0],["كَم يَستَصِمُّ الغافِلونَ وَقَد دُعوا","وَغَدا وَراحَ عَلَيهِمُ الحَدَثانُ",34,"ن",1,0],["كَم يَكونُ الشِتاءُ ثُمَّ المَصيفُ","وَرَبيعٌ يَمضي وَيَأتي الخَريفُ",35,"ف",1,1],["كَم يَفوتُ المُعَربِدينَ عَلى السُك","رِ لَدينا مِن طَيِّبِ اللَذّاتِ",36,"ت",1,0],["كُمَيتٌ إِذا شاهَدتَها في إِنائِها","وَلَكِن لِصافي لَونِها دُعِيَت صَهبا",37,"ب",2,0],["كم يَعذُب الموت لو نراهُ","أو كان فيك اللقاءُيُرجى",38,"ج",2,0],["كم يسخر النجمُ بنا مِن عل","وكم يرانا الله أطفالا",39,"ل",2,0],["كَمْ يَشْبَهُونَ فِدائِيينَ أعْرِفَهُم","لَمْ يَبْتَغُواْ عَنْ سَبيِلِ اللَّهِ مُلْتَحَدَا",40,"د",2,0],["كميتاً لها مَرَحٌ بِالفَتى","إِذا حَثَّ بِاللَّهوِ أَدوارَها",41,"ر",3,0],["كَم يَتَمادى لَيلِيَ الأَطوَلُ","كَم يَتَبارى دَمعِيَ المُسبَلُ",42,"ل",1,1],["كمْ يا مُسيكين تبكي","على شُعَيْري الجُعَيْدي",43,"ي",1,0],["كَمِيُّ تَجَلَّت مِن بَنِي حَكَمٍ بِهِ","ظُباً مَا لَهَا غَيرَ المَعَانِي صَيَاقِلُ",44,"ل",1,0],["كُمَيتٍ بَهيمِ اللَونِ لَيسَ بِفارضٍ","ولا بِخَصيفٍ ذات لَونٍ مُرَّقَمِ",45,"م",1,1],["كُمَيتٍ كَرُكنِ البابِ قَد شَقَّ نابُهُ","وَأَحيَت لَهُ مِقلاتُها وَنَزورُها",46,"ر",3,0],["كم يَدٍ عن نَبِيِّهِ كَفَّهَا الل","هُ وَفي الخَلْقِ كَثْرَةٌ وَاجتراءُ",47,"ا",2,0],["كَم يُقتَلُ الناسُ ما هَمُّ الَّذي عَمَدَت","يَداهُ لِلقَتلِ إِلّا أَخذُهُ السَلَبا",48,"ب",2,0],["كَم يَنشُدونَ صَفاءً مِن دِيانَتِهِم","وَلَيسَ يوجَدُ حَتّى المَوتِ ما نَشَدوا",49,"د",3,0],["كَم يَسمَعُ الناسُ العِظاتِ وَكَم رَأَوا","غَيرَ الجَميلِ فَغُضَّت الأَبصارُ",50,"ر",1,0],["كَم يُسِّرَ الأَمرُ لَم تَأمَل تَيَسُّرَهُ","وَكَم حَذِرتَ فَما وُقّيتَ مَحذورا",51,"ر",2,1],["كَم يَنظِمُ الدَهرُ مِن عِقدٍ وَيَنثُرُهُ","وَلَيسَ عِقدُ ثُرَيّاهُ بِمُنتَثِرِ",52,"ر",1,1],["كُمَيتٍ عَصاها النَقرُ صادِقَةِ السُرى","إِذا قيلَ لِلحَيرانِ أَينَ تُخالِفُ",53,"ف",1,0],["كُمَيتٍ كَشاةِ الرَملِ صافٍ أَديمُهُ","مُفِجِّ الحَوامي جُرشُعٍ غَيرِ مَخشوبِ",54,"ب",1,0],["كُمَيتٌ كأَنَّ عَلى مَتِنِهِ","سَبائِكَ مِن قِطَعِ المُذهَبِ",55,"ب",1,0],["كميت عبنّاة السراة نمى بها","إلى نسب الخيل الصريح وجافل",56,"ل",1,0],["كَم يودّ الإنسان لَو طارَ في الجو","وِ خَفيفاً كَما تطير القطاة",57,"ه",1,0],["كَم يَتيمٍ كادَت بِهِ البَأ","ساءُ لَولا رِعايَةُ الأَطفالِ",58,"ل",1,0],["كم يبطئون عن الجمي","ل وما مناياهم بطيئة",59,"ه",1,0],["كُمَيْتٌ جَرَتْ فِي حَلْبَةِ الدَّهْرِ فَانْطَوَتْ","ثَمِيلَتُهَا وَالْخَيْلُ تُحْمَدُ بِالضُّمْرِ",60,"ر",1,0],["كَمِياَهِ العُيُونِ تَجْرِي بِذَوْبٍ","مِنْ مَشِيبِ الجِبَالِ مِلْءَ النُّهُورِ",61,"ر",1,0],["كَمْ يَسَّرَ النوْمَ الْهَنِيءَ لِسَاهِدٍ","شَاكٍ وَلَطَّفَ مِنْ أَسَى مَكْمُوُدِ",62,"د",1,0],["كَمْ يَتِيمٍِ مِنَ الْمعَانِي غَرِيبٍ","مَسَحَتْ كَفُّهُ عَلَيْهِ فَصَانَه",63,"ن",2,0],["كم يمُدُّ اليديْنِ أَسْوانَ مُضْنىً","فَيفِرُّ الشُّعاعُ من قَبَضاتِهْ",64,"ت",2,0],["كميتين ، يمدّون الأكفّ إلى","موت جديد يمنّي ، وهو يبتلع",65,"ع",1,0],["كم يُروى منفوخةً أوداجُهُ","من نِعاجٍ هُزِلَتْ ، ذئبٌ سمين",66,"ن",1,0],["كمي مشى بين الكمات وحوله","نجوم بليل من عجاج طوالع",67,"ع",1,0],["كم يَعْجَبُ المرءُ من أمرٍ يفاجئه","وما درى أن فيهأعجبَ العجب",68,"ب",1,0],["كمَيْسِ الهوادج .. شرقيةً","تَرْشُّ على الشمس حُلْوَ الحِدا ..",69,"ا",1,1],["كم يكونُ العتو في الأرض يا شقْر","راقُ لا ترعوي ولا تستكين",70,"ن",1,0],["كم يوم هولٍ قد وردت وطعمه","مر المذاق كريه نار المصطلا",71,"ل",2,0],["كميشُ الإزارِ يَكْحَلُ العَيْنَ إثْمِداً","سُرَاهُ ، وَيُضْحِ مُسْفِراً غَيرَ وَاجِمِ",72,"م",1,0],["كم يدعي صدق المحبة كاذب","ويطول منه بما ادعاه لسان",73,"ن",1,0],["كَميشٌ كَتَيسِ الرَملِ أَخلَصَ مَتنَهُ","ضَريبُ الخَلايا وَالنَقيعُ المُعَجَّلُ",74,"ل",1,0],["كَميشُ الإِزارِ خارِجٌ نِصفُ ساقِهِ","صَبورٌ عَلى العَزاءِ طَلّاعُ أَنجُدِ",75,"د",1,0],["كم يا ربيع غمرتنا بمواهبٍ","تترى وكم لك في البرية من يدِ",76,"د",1,0],["كم يضحك الرحمن من فعلاتهم","يوم الكريهة نعم فعل الكمّل",77,"ل",1,0],["كَم يَنفُقُ الغِشُّ فِيكُم وَالنِفاقُ وَكَم","لا تَرغَبُونَ إِلى نُصحٍ ولا عَذَلِ",78,"ل",1,0],["كَم يَتَلَقّاكَ مِن زَبانٍ","قَساوَةُ الطَبعِ فيهِ شِيمَه",79,"م",2,0],["كَم يَمضُغُ الدَهرُ فِيما بَينَ أَظهُرِكُم","لَحمي وَيَشرَبُ شُربَ الهيمِ فَضلَ دَمي",80,"م",2,0],["كَمْ يَكُونُ الْخِلافُ وَالْبُعْدُ قَلْ لِي","مَعَ ذُلِّي وَطَاعَتِي واقْتِرابِي",81,"ب",2,0],["كُمَيتٌ أُمِرَّ عَلى زُفرَةٍ","طَويلُ القَوائِمِ عُريانُها",82,"ن",3,0],["كَمياهِ قَطرٍ فَوقَ خُضرِ رُبىً","فيها تَجلَّى وَجهُكَ الحَسَنُ",83,"ن",1,0],["كم يد للصدود عندي لأني","أجعل الوصل بعد صدّك عيدا",84,"د",2,0],["كمّي تخاف الأسدُ عند لقائه","وتَقَصْرُ عنه والمدى مُتباعِدُ",85,"د",1,0],["كُمَيْت بَزَلْنا دَنَّها فتفجَّرت","بأحْمَر قانٍ مثلَ ما قُطِر الذَّهَبْ",86,"ب",1,0],["كم يسأل بالحمى ومن يخبره","عن سر هوى يخفى على ذي نظر",87,"ر",1,0],["كَم يَقطَعُ اللَيلَ بِالأَحزانِ ساهِرُهُ","لا الصُبحُ يَبدو وَلا الظَلماءُ تَنحَسِرُ",88,"ر",1,0],["كُمَيتٍ كِنازِ اللَحمِ أَو حِميَرِيَّةٍ","مُواشِكَةٍ تَنفي الحَصى بِمُلَثَّمِ",89,"م",1,0],["كميٌّ تراه في الكتائب باسماً","بثغرٍ كزهر الروض وهو كِمام",90,"م",1,0],["كمىَّ كمي وهو غيلان يلقى","وجوه المنايا شوهت بقتير",91,"ر",1,0],["كم يمطلونَ ولا يفونَ بعهدِهم","وَعدُ الفرنجةِ ما لهُ إنجاز",92,"ز",1,0],["كَم يأَمَل الرَوضَة الغراء ذو شغف","