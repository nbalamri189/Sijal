03.html","السريع"],[459,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[459,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[459,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[459,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[459,"يا ليلة ما رأتها أعين الغير","https://www.aldiwan.net/poem56196.html","البسيط"],[459,"لا تلمس الشمس يد","https://www.aldiwan.net/poem56236.html","مجزوء الرجز"],[459,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[459,"أَستنجِد الصبر فيكم وهو مغلوب","https://www.aldiwan.net/poem56300.html","البسيط"],[478,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[478,"كم يذهب هذا العمر في الخسران","https://www.aldiwan.net/poem15365.html","الدوبيت"],[482,"تسائلني بنو جشم بن بكر","https://www.aldiwan.net/poem1770.html","الوافر"],[515,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[515,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[515,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[515,"يا جيرة بالطرب تحيي دياجيكم","https://www.aldiwan.net/poem20907.html","المواليا"],[554,"خليلي لست أرى الحب عارا","https://www.aldiwan.net/poem68409.html","المتقارب"],[560,"لأخلعن عذارى في محبتكم","https://www.aldiwan.net/poem69347.html","البسيط"],[560,"أيها اللائم رفقا","https://www.aldiwan.net/poem69350.html","مجزوء الرمل"],[563,"مات الحبيب كأنه لم يولد","https://www.aldiwan.net/poem52912.html","الكامل"],[576,"ما لي أنهنه عنك آمالي","https://www.aldiwan.net/poem2782.html","أحذ الكامل"],[576,"لا أجازى حبيب قلبي بجرمه","https://www.aldiwan.net/poem2856.html","الخفيف"],[576,"ظبي بمصر نسيت منه","https://www.aldiwan.net/poem2908.html","مجزوء الكامل"],[576,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[587,"كم يشمت بي في حبك العذال","https://www.aldiwan.net/poem17647.html","مخلع الرمل"],[587,"يا من أمر الغرام والقلب له","https://www.aldiwan.net/poem17830.html","الدوبيت"]],"verses":[["كَميا النُزوعُ عِندَكُم","كَذا النِزاعُ عِندَنا",0,"ن",2,0],["كَم يَلبَثُ الأَصلُ عَلى ضَربِ القُدُم","عُرِّضتَ مِنّي لِبَصيرٍ بِالقِيَم",1,"م",1,0],["كَم يَقتَضيني السَيفُ عَزمي وَيَدي","تَدفَعُهُ دَفعَ الغَريمِ الماطِلِ",2,"ل",1,0],["كَم يُسبَكُ الذَهَبُ المُصَفّى مَرَّةً","قَد لاحَ جَوهَرُهُ وَبانَ الرَونَقُ",3,"ق",1,0],["كَم يَومِ مَجدٍ ظاهِرٍ فَخارُهُ","عَنهُم ظُهورَ الأَبلَقِ المُشَهَّرِ",4,"ر",1,0],["كمْ يُلْقِحُ الآمالَ وهْيَ تَرْعَوي","إليهِ في أعقابِ جَدٍّ حائِلِ",5,"ل",1,0],["كَم يُبعِدُ الدَهرُ مَن أَرجو أُقارِبُهُ","عَنّي وَيَبعَثُ شَيطاناً أُحارِبُهُ",6,"ب",2,1],["كُمَيتٍ يُرى دونَ قَعرِ الإِنى","كَمِثلِ قَذى العَينِ يُقذى بِها",7,"ب",3,0],["كُمَيتٍ عَلَيها حُمرَةٌ فَوقَ كُمتَةٍ","يَكادُ يُفَرّي المَسكَ مِنها حَماتُها",8,"ت",3,0],["كُمَيتاً تَكَشَّفُ عَن حُمرَةٍ","إِذا صَرَّحَت بَعدَ إِزبادِها",9,"د",3,0],["كُمَيتٍ إِذا ما نلتُ مِنها ثَلاثَةً","رَأَيتُ السَما كَالأَرضِ وَالأَرضَ كَالسَما",10,"م",2,0],["كَم يَومِ هَولٍ قَد وَرَدتَ وَطَعمُهُ","مُرُّ المَذاقِ كَريه نارِ المُصطَلى",11,"ل",2,0],["كُمَيتٍ يَزِلُّ اللِبدُ عَن حالِ مَتنِهِ","كَما زَلَّتِ الصَفواءُ بِالمُتَنَزَّلِ",12,"ل",1,0],["كَم يَستَغيثُ بِنا المُستَضعَفُونَ وَهُم","قَتلى وَأَسرى فَما يَهتَزَّ إِنسانُ",13,"ن",1,0],["كَمْ يَمَّمَتْ هِبَةٌ كَرِيماً مُوحَشاً","فِي دَارِهِ وَذَرَاهُ غَيرُ مُيَمَّمِ",14,"م",1,0],["كم يكدحُ المرءُ لا يدري مَنِيَتَهُ","أليسَ كلُّ امرئ يُجزى بما كَدَحا",15,"ح",2,0],["كم يدّعي وطنيةً","من لم تكن مرّت ببابه",16,"ب",2,0],["كَميشُ الإِزارِ يَكحَلُ العَينَ إِثمِداً","سُراهُ وَيُضحي مُسفِراً غَيرَ واجِمِ",17,"م",1,0],["كميَّتٌ يزل اللِّبْدْ عن دَأياتها","كما زلَّ عن رأس الشجيج المحارِفُ",18,"ف",1,1],["كم يقصد الدهر إغضابِي بقادحةٍ","في الحال لكنَّها في الصبرِ ما قدحت",19,"ت",1,0],["كم يبصق الثلج على لحيةٍ","وكم يقول الرعد في الوجه إخّ",20,"خ",1,0],["كَم يَنشُرُني الهَوى وَكَم يَطويني","يا مالِكَ دُنيايَ وَمَولى ديني",21,"ي",1,1],["كم يُعَزّ المُفَضَّلُ المبخوتُ","ويُبَزُّ المحبَّبُ المنعوتُ",22,"ت",1,1],["كم يَعِدُ القرن باللقاء وكم","يكذب في وعده ويخلفه",23,"ف",2,0],["كمينُ ردىً في جسمه أوْ مُبارِزٌ","نجيدٌ من الأقران غادره جِذمْ",24,"م",1,0],["كم يُعَرِّينيَ من أفضالكم","ألبس اللَّه عدوي كفنَه",25,"ن",2,0],["كم يكونُ العتوُّ في الأرض يا شقْ","راقُ لا ترعوي ولا تستكين",26,"ن",1,0],["كم يا أبا الصقر من نُعمى تركتَ بها","شُكري على غابرِ الأيامُ مُرتَهنا",27,"ن",2,0],["كُمَيتٍ كَلَونِ الأُرجُوان نَشَرتَهُ","لِبَيع الرِداءِ في الصُوانِ المُكَعَّبِ",28,"ب",1,0],["كم يَدٍ مثل أيادٍ","عن يدٍ منك كأيدي",29,"د",2,0],["كَم يَدٍ لِلدَهرِ مُذ أَب","صَرتُ آثارَ يَدَيهِ",30,"ي",2,0],["كَم يَذهَبُ هَذا العُمرُ في خُسرانِ","ما أَغفَلَني عَنهُ وَما أَنساني",31,"ي",1,1],["كَم يا جَمادُ قَساوَةً","كَم هَكَذا أَبَداً جُحود",32,"د",1,0],["كُمَيْتٌ خَطَبناها إلى رَبِّ دَنِّها","وقَدْ آذَنَتْ زُهْرُ الدُّجَى بأُفُولِ",33,"ل",1,0],["كَم يَستَصِمُّ الغافِلونَ وَقَد دُعوا","وَغَدا وَراحَ عَلَيهِمُ الحَدَثانُ",34,"ن",1,0],["كَم يَكونُ الشِتاءُ ثُمَّ المَصيفُ","وَرَبيعٌ يَمضي وَيَأتي الخَريفُ",35,"ف",1,1],["كَم يَفوتُ المُعَربِدينَ عَلى السُك","رِ لَدينا مِن طَيِّبِ اللَذّاتِ",36,"ت",1,0],["كُمَيتٌ إِذا شاهَدتَها في إِنائِها","وَلَكِن لِصافي لَونِها دُعِيَت صَهبا",37,"ب",2,0],["كم يَعذُب الموت لو نراهُ","أو كان فيك اللقاءُيُرجى",38,"ج",2,0],["كم يسخر النجمُ بنا مِن عل","وكم يرانا الله أطفالا",39,"ل",2,0],["كَمْ يَشْبَهُونَ فِدائِيينَ أعْرِفَهُم","لَمْ يَبْتَغُواْ عَنْ سَبيِلِ اللَّهِ مُلْتَحَدَا",40,"د",2,0],["كميتاً لها مَرَحٌ بِالفَتى","إِذا حَثَّ بِاللَّهوِ أَدوارَها",41,"ر",3,0],["كَم يَتَمادى لَيلِيَ الأَطوَلُ","كَم يَتَبارى دَمعِيَ المُسبَلُ",42,"ل",1,1],["كمْ يا مُسيكين تبكي","على شُعَيْري الجُعَيْدي",43,"ي",1,0],["كَمِيُّ تَجَلَّت مِن بَنِي حَكَمٍ بِهِ","ظُباً مَا لَهَا غَيرَ المَعَانِي صَيَاقِلُ",44,"ل",1,0],["كُمَيتٍ بَهيمِ اللَونِ لَيسَ بِفارضٍ","ولا بِخَصيفٍ ذات لَونٍ مُرَّقَمِ",45,"م",1,1],["كُمَيتٍ كَرُكنِ البابِ قَد شَقَّ نابُهُ","وَأَحيَت لَهُ مِقلاتُها وَنَزورُها",46,"ر",3,0],["كم يَدٍ عن نَبِيِّهِ كَفَّهَا الل","هُ وَفي الخَلْقِ كَثْرَةٌ وَاجتراءُ",47,"ا",2,0],["كَم يُقتَلُ الناسُ ما هَمُّ الَّذي عَمَدَت","يَداهُ لِلقَتلِ إِلّا أَخذُهُ السَلَبا",48,"ب",2,0],["كَم يَنشُدونَ صَفاءً مِن دِيانَتِهِم","وَلَيسَ يوجَدُ حَتّى المَوتِ ما نَشَدوا",49,"د",3,0],["كَم يَسمَعُ الناسُ العِظاتِ وَكَم رَأَوا","غَيرَ الجَميلِ فَغُضَّت الأَبصارُ",50,"ر",1,0],["كَم يُسِّرَ الأَمرُ لَم تَأمَل تَيَسُّرَهُ","وَكَم حَذِرتَ فَما وُقّيتَ مَحذورا",51,"ر",2,1],["كَم يَنظِمُ الدَهرُ مِن عِقدٍ وَيَنثُرُهُ","وَلَيسَ عِقدُ ثُرَيّاهُ بِمُنتَثِرِ",52,"ر",1,1],["كُمَيتٍ عَصاها النَقرُ صادِقَةِ السُرى","إِذا قيلَ لِلحَيرانِ أَينَ تُخالِفُ",53,"ف",1,0],["كُمَيتٍ كَشاةِ الرَملِ صافٍ أَديمُهُ","مُفِجِّ الحَوامي جُرشُعٍ غَيرِ مَخشوبِ",54,"ب",1,0],["كُمَيتٌ كأَنَّ عَلى مَتِنِهِ","سَبائِكَ مِن قِطَعِ المُذهَبِ",55,"ب",1,0],["كَم يودّ الإنسان لَو طارَ في الجو","وِ خَفيفاً كَما تطير القطاة",56,"ه",1,0],["كَم يَتيمٍ كادَت بِهِ البَأ","ساءُ لَولا رِعايَةُ الأَطفالِ",57,"ل",1,0],["كم يبطئون عن الجمي","ل وما مناياهم بطيئة",58,"ه",1,0],["كُمَيْتٌ جَرَتْ فِي حَلْبَةِ الدَّهْرِ فَانْطَوَتْ","ثَمِيلَتُهَا وَالْخَيْلُ تُحْمَدُ بِالضُّمْرِ",59,"ر",1,0],["كَمِياَهِ العُيُونِ تَجْرِي بِذَوْبٍ","مِنْ مَشِيبِ الجِبَالِ مِلْءَ النُّهُورِ",60,"ر",1,0],["كَمْ يَسَّرَ النوْمَ الْهَنِيءَ لِسَاهِدٍ","شَاكٍ وَلَطَّفَ مِنْ أَسَى مَكْمُوُدِ",61,"د",1,0],["كَمْ يَتِيمٍِ مِنَ الْمعَانِي غَرِيبٍ","مَسَحَتْ كَفُّهُ عَلَيْهِ فَصَانَه",62,"ن",2,0],["كم يمُدُّ اليديْنِ أَسْوانَ مُضْنىً","فَيفِرُّ الشُّعاعُ من قَبَضاتِهْ",63,"ت",2,0],["كميتين ، يمدّون الأكفّ إلى","موت جديد يمنّي ، وهو يبتلع",64,"ع",1,0],["كم يُروى منفوخةً أوداجُهُ","من نِعاجٍ هُزِلَتْ ، ذئبٌ سمين",65,"ن",1,0],["كمي مشى بين الكمات وحوله","نجوم بليل من عجاج طوالع",66,"ع",1,0],["كم يَعْجَبُ المرءُ من أمرٍ يفاجئه","وما درى أن فيهأعجبَ العجب",67,"ب",1,0],["كمَيْسِ الهوادج .. شرقيةً","تَرْشُّ على الشمس حُلْوَ الحِدا ..",68,"ا",1,1],["كم يكونُ العتو في الأرض يا شقْر","راقُ لا ترعوي ولا تستكين",69,"ن",1,0],["كم يوم هولٍ قد وردت وطعمه","مر المذاق كريه نار المصطلا",70,"ل",2,0],["كميشُ الإزارِ يَكْحَلُ العَ