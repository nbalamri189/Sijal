px?id=200391",""],[4578,"مسعاك والحج مشكورٌ ومبرورُ","https://www.poetsgate.com/ViewPoem.aspx?id=49423",""],[4578,"ثغر الأماني أبان دُراً","https://www.poetsgate.com/ViewPoem.aspx?id=49425",""],[4852,"قارب ورق","https://www.poetsgate.com/ViewPoem.aspx?id=214376",""],[1901,"من مجيري من الهوى أَو معيني","https://www.poetsgate.com/ViewPoem.aspx?id=160400",""],[4935,"لو كنت مثلي في الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=129296",""],[4955,"رسول الله كم هامت حروفي","https://www.poetsgate.com/ViewPoem.aspx?id=203670",""],[5151,"صلصل الفردوس","https://www.poetsgate.com/ViewPoem.aspx?id=185896",""],[5205,"أمبكي عيون الصد لا أبكي","https://www.poetsgate.com/ViewPoem.aspx?id=120996",""],[5213,"أعلى السفح تعرفت الديارا","https://www.poetsgate.com/ViewPoem.aspx?id=170459",""],[1021,"تبدى يملأ الناظر","https://www.poetsgate.com/ViewPoem.aspx?id=47834",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5358,"عسى ألا غيابَ","https://www.poetsgate.com/ViewPoem.aspx?id=27544",""],[5397,"أخذ الريع من دموعي حذاره","https://www.poetsgate.com/ViewPoem.aspx?id=157939",""],[5431,"داريا","https://www.poetsgate.com/ViewPoem.aspx?id=183023",""],[5431,"قبلته...","https://www.poetsgate.com/ViewPoem.aspx?id=200620",""],[5431,"على لسان الحرية...","https://www.poetsgate.com/ViewPoem.aspx?id=209177",""],[5457,"الطفل","https://www.poetsgate.com/ViewPoem.aspx?id=213388",""],[5545,"قلبًا مؤازرًا","https://www.poetsgate.com/ViewPoem.aspx?id=184777",""],[5562,"قارئ الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=190067",""],[482,"خلا مِنَ القومِ مصطاف ومرتبعُ","https://www.poetsgate.com/ViewPoem.aspx?id=111303",""],[5605,"الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=161109",""],[2110,"كرعتها وحباب الكأس مشتبك","https://www.poetsgate.com/ViewPoem.aspx?id=156284",""],[5776,"انتحارُ عرّافة","https://www.poetsgate.com/ViewPoem.aspx?id=199330",""],[5829,"رسالة إلى أمي في ذكرى وفاتها","https://www.poetsgate.com/ViewPoem.aspx?id=175530",""],[5829,"وليس لعاشق عنها حياد","https://www.poetsgate.com/ViewPoem.aspx?id=204665",""],[5939,"كلُّ أُنثى تُشبِهُكْ","https://www.poetsgate.com/ViewPoem.aspx?id=178587",""],[5956,"أ تذْكر؟","https://www.poetsgate.com/ViewPoem.aspx?id=192440",""],[5956,"ما درَّ شعري هكذا لسواكما","https://www.poetsgate.com/ViewPoem.aspx?id=193703",""],[5956,"من البجَّاع دكتورٌ عظيمُ","https://www.poetsgate.com/ViewPoem.aspx?id=214191",""],[5957,"تذكرتُ","https://www.poetsgate.com/ViewPoem.aspx?id=189912",""],[5969,"مؤامرة","https://www.poetsgate.com/ViewPoem.aspx?id=205051",""],[6002,"في موضع للسالك","https://www.poetsgate.com/ViewPoem.aspx?id=211682",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""],[5309,"نصوغ من لاعج الأشواق الحانا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573550",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""],[6198,"الأفق المحترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79279&r=&rc=53",""],[5126,"ملل ويأس وأفكار سوداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87789&r=&rc=4",""],[6331,"الصَّبر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82022&r=&rc=3",""],[5190,"نامي بظلِّ قصائدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78344&r=&rc=57",""]],"verses":[["كمال خلائق وكمال خلق","وما شغل الهواجس كالكمال",0,"ل",1,0],["كَمِ الهَوانُ كَأَنّي بَينَكُم جَمَلٌ","في كُلِّ يَومٍ قَطيعُ الذُلِّ يَحدوني",1,"ن",2,0],["كَم إِلى كَم تَعلو الطُغاةُ وَكَم يَح","كُمُ في كُلِّ فاضِلٍ مَفضولُ",2,"ل",1,0],["كَم إِلى كَم تَبغي الصُعودَ وَقَد جُز","تَ المَعالي وَقَد طَلَعتَ السُكاكا",3,"ك",2,0],["كِمُّ الفُؤادِ حَبيساً غَيرُ مُنطَلِقٍ","وَدَمعُ عَيني طَليقاً غَيرُ مُنحَبِسِ",4,"س",1,0],["كَمِ المُقامُ عَلى جيلٍ سَواسِيَةٍ","نَرجو النَدى مِن إِناءٍ قَلَّ مارَشَحا",5,"ح",2,0],["كَمَالٌ وَلاَ نَقْصٌ وَرُشْدٌ وَلاَ هَوىً","وَمَنْحٌ وَلاَ مَنْعٌ وَحَمْدٌ وَلاَ ذَمُّ",6,"م",1,0],["كَما لاقى أَبي حُجرٌ وَجَدّي","وَلا أَنسى قَتيلاً بِالكِلابِ",7,"ب",1,0],["كَما لَو وَشى واشٍ بِوُدِّكِ عِندَنا","لَقُلنا تَزَحزَح لا قَريباً وَلا سهلا",8,"ل",2,0],["كم إلى العلم أقمتم من مَنار","بعقول هي أسَنى من شُعاع",9,"ع",1,0],["كَما لاحَ عُنوانُ مَبروزَةٍ","يَلوحُ مَعَ الكَفِّ عُنوانُها",10,"ه",2,1],["كَما لَو فَعَلتُم مِثلَ ذاكَ إِلَيهِمِ","لَأَثنَوا بِهِ ما يَأثُرُ القَولَ سامِعُه",11,"ع",2,0],["كم إلى كم هذا التغافل منَّا","عن يقين الردى وهذا التباله",12,"ل",2,0],["كمال دين الله من غيثه","قد ألحق النائي بخصب المقيم",13,"م",1,0],["كمال الدين عشت لنا ملاذاً","تصوَّغ عن شمائله المعاني",14,"ن",2,1],["كم إلى بيت ماله في العطايا","قد ضربنا بطالعِ العيس رملا",15,"ل",2,0],["كم إلى كم تصدُّ عن","نيَ ظلماً وتَبْعُدُ",16,"د",1,0],["كما لو أردنا أن نُحيل شبابنا","مَشيباً ولم يأن المشيب تعذرا",17,"ر",2,1],["كما لاحظت عوادَه عينُ مُدنفٍ","توجَّع من أوصابه ما توجعا",18,"ع",2,0],["كما لو هجاكُمْ شاعرٌ حلَّ قَتْلُهُ","كذاك فأوفوا مدْحَه دِيَةَ القتلِ",19,"ل",1,0],["كما ليستْ تزال له دواةٌ","لداهٍ في مَهالكها ارتطامُ",20,"م",1,0],["كَما لَم يَذُقها إِذ تَكونُ عَزيرَةً","أَبوكَ وَلا تُدنى إِلَيهِ فَيَطمَعا",21,"ع",2,0],["كَم أُلاقي مِنكَ مالا","أَشتَهي لاقَيتُ حَينَك",22,"ك",1,1],["كَما لاحَ وَشمٌ في يَدَي حارِثِيَّةٍ","بِنَجرانَ أَدمَت لِلنِؤورِ الأَشاجِعا",23,"ع",2,0],["كَم أَلفُ ميلٍ نَحوَ مِصرَ قَطَعتُم","فيمَ الوُقوفُ وَدونَ مِصرٍ ميلُ",24,"ل",1,0],["كَما لَم يَنَل إِبليسُ آدَمَ إِذ سَعى","وَلَم يَمحُ مِن نورِ النَبِيِّ أَبو جَهلِ",25,"ل",1,0],["كَما لا تَنفَعُ الشَمسَ","وَضوءُ العَينِ مَمنوعُ",26,"ع",1,0],["كَم إِلى كَم أَنتَ في أُرجوحَةٍ","تَتَمَنّى زَمَناً بَعدَ زَمَن",27,"ن",1,0],["كَما لَو مَلَكنا أَن نَزورَ بِلادَكُم","فَعَلنا وَلَم تَكثُر عَلَينا التَكالِفُ",28,"ف",1,0],["كمالُ النَّفسِ إيمانٌ وَتَقْوَى","وماذا بعدَ مَرتبةِ الكمالِ",29,"ل",1,0],["كَما لَم أَرى النَفعَ في وَصلِهِ","كَذَلِكَ هُجرانُهُ لا يَضيرُ",30,"ر",1,0],["كَما لا يَنقَضي الأَرَبُ","كَذا لا يَفتُرُ الطَرَبُ",31,"ب",1,1],["كَما لَم تَخفَ سافِرَةٌ","وَتُنكَرُ حينَ تَنتَقِبُ",32,"ب",1,0],["كَما لَقِيَت ذاتُ الصَفا مِن حَليفِها","وَما اِنفَكَّتِ الأَمثالُ في الناسِ سائِرَه",33,"ر",2,0],["كم أَلحَمَ السَّيفُ في أبناءِ مَلْحَمَةٍ","ما مِنْهُمُ فَوقَ ظهْرِ الأَرْض دَيَّارُ",34,"ر",1,1],["كَم إِلى كَم أَعيش بين ذئاب","كاشرات وأنمر وَضباع",35,"ع",1,0],["كَما لَيسَ يَصبو الطفل إلا لأمه","وَلَيسَ بمختار على حضنها حضنا",36,"ن",2,0],["كم إلى كم كهولُكم في رقادٍ","كم إِلى كم شبابُكم في سبات",37,"ت",1,0],["كَمَالُ حِجىً فِي اقْتِبَالِ الصِّبَا","تَبَارَكَ وَاهِبُكَ الأَكْرَمُ",38,"م",1,0],["كما لا يعرف الثمر","... فقولي إنه الشجر!",39,"ر",1,0],["كَمالٌ تَمَنَّتهُ البُدورُ وَأَيقَنَت","بِأَنَّكَ لَو نُظِّمتَ واسطَةَ السِلكِ",40,"ك",1,0],["كمال توحيد ربي حب طائعه","وبغض أعدائه في السر والجهر",41,"ر",1,0],["كم إلى كم أمشي ، ودربي ظنون","ومداه قاص عن الوهم دان ؟",42,"ن",1,0],["كَمال غَريب وَلُطف عَجيب","وَمَغني اللَبيب بِحُسن الأَدَب",43,"ب",1,0],["كَمَأ لَم يُعذَرِ المُهدِى إِلينا","هِجَاءً بَعدَ إعلاَنِ الجُؤَارِ",44,"ر",1,0],["كمالُ المُنَى إن كُنتَ تَرغَبُ في المُنى","إذا فَنِيَ المَملُوكُ في مالِكِ الملُكِ",45,"ك",1,0],["كَمالٌ بِهِ خَصَّ الإِلَهُ مُحَمَّدا","فِعالٌ كآثارِ المَواطِرِ في النَدى",46,"د",2,0],["كمال وحلم فيك زانا خلافة","نهضت وقد أعيوا بأعبائها حلا",47,"ل",2,0],["كَما لَم يَكُن عَصرُ النَضارَةِ لابِثاً","كَذَلِكَ عَصرُ البُؤسِ لَيسَ بِلابِثِ",48,"ث",1,0],["كَم إِلى كَم نَعيشُ أَنضاءَ ذُلٍّ","كُلُّنا مُلجَم بِهِ مَعلوطُ",49,"ط",1,0],["كَمالَ الدّينِ أَنتَ لِكُلِّ خَيرٍ","وَعارِفَةٍ تُفيدُ الشُكرَ أَهلُ",50,"ل",1,1],["كَمالَ الوَرى آنَ الرَحيلُ وَلَم يَعُد","لِذي أَرَبٍ عَن قَصدِهِ مُتَعَلَّلُ",51,"ل",1,0],["كما لم تحضر الفطرة","في الكون بتدقيق",52,"ق",1,0],["كما لا أرى لي زائرا في شديدة","فما أنا للقالي النفور زؤور",53,"ر",1,0],["كما لم تجد عيناكِ بُدّاً من الضَّنَى","كذا ما لجسمي من ضنىً بهما بدّ",54,"د",1,0],["كم إلى كم أخفي الإشارة فيمن","فضله ظاهر بغير خفاء",55,"ا",2,0],["كما لو أصابَ الموتُ ليلى بكيتُها","وجادَ لها جارٍ من الدمعِ سافحُ",56,"ح",1,0],["كما لابن العميد جميع شكري","ودنيا ابن العميد جميعها لي",57,"ل",2,0],["كمال أولى العلم الشريف ومن به","تشيد من ركن الهدى ما تصدعا",58,"ع",2,0],["كم إِلى تَضحيةٍ أحملُهُ","فأراهُ دامياً في جانِحي",59,"ي",1,0],["كَمالاتُ يَحيى المرتضَى نقْصُ من مضَى","فكَيفَ ادَّعَت فَضلَ الذَّواتِ الأوائِلُ",60,"ل",1,0],["كَمالُهُ أَحسَنُ مِن كَمالِها","فَصينَ طولَ الدَهرِ عَن محاقِها",61,"ق",3,0],["كَم إِلى كَم أَتَقاضى وصلَكم","وإلامَ الهَجرُ لا كان إلى ما",62,"م",2,0],["كَم إِلى كَم قطيعةٌ وَصدودٌ","أَقُلوبٌ نَحيا بها أَم صخورُ",63,"ر",1,0],["كَمالُهُ غَيرُ خافٍ","وَفَضلُهُ لَيسَ يَجحَدُ",64,"د",1,0],["كم ألوف تمر دوني فلا تع","رف ما بيننا من الأسرار",65,"ر",1,0],["كَم إِلى كَم أَنتَ لِلحِر","صِ وَلِلآمالِ عَبدُ",66,"د",1,1],["كَم إِلى كَم تُحسِنُ القَو","لَ وَلا تُحسِنُ فِعلا",67,"ل",2,0],["كَمالَ الدِّينِ صَفحاً عَن مُسِئٍ","عَديمِ الصَّبْرِ مُنْحَرِفِ المِزاجِ",68,"ج",1,1],["كَما لِآخِرِ آنٍ","تاليهِ يُصبِحُ أَوَّل",69,"ل",1,0],["كَمال سُؤلك لِلمَولى بِخيرته","خَتم النَبيين خَتم بِالتُقى عَملا",70,"ل",2,0],["كَمال في كَمال في كَمال","وَنور فَوق نور فَوق نور",71,"ر",1,0],["كَمالُ العَقْلِ في عُظْمِ الأيادي","وصِدْقُ القَوْلِ في َكرِم الفِعال",72,"ل",1,0],["كم إلى كم أَجوزُ بحْرَ الفيافي","جاعلاً جَسْرتي عليه جِسرا",73,"ر",2,0],["كما لا يَخافُ الدَّهرَ مُلْكٌ غدا له","وَلِيُّ أميرِ المؤمنين مُؤيِّدا",74,"د",2,0],["كم إلى كم تُرى أُطوّفُ في الآ","فاق فوق الرّكائبِ الأنضاء",75,"ا",2,0],["كم إلى كم تَشكُو إلى النَّاسِ ما تَل","قَى مِن النَّاسِ والقُلوب جُسُومُ",76,"م",1,0],["كما لذَّ مدحُ البكر مريمَ في الورى","لمادحها في مدحها المتبارك",77,"ك",1,0],["كم ألَّف الإِرشاد والدرر التي","غدت في أصول الفقه خير مجلد",78,"د",1,0],["كَم إلى كَم هذا التَّشاغُلُ والغَف","لَةُ حارَ السّاري وضلَّ الطّريقُ",79,"ق",1,0],["كَم إلى كَم يُلحى المحبُّ المشوقُ","وهو من سَكرةِ الهَوى لا يُفيقُ",80,"ق",1,0],["كَم إلى كَمْ أُكَاتِمُ الن","ناسَ وجْدي ويظهَرُ",81,"ر",1,1],["كم ألَمَّت بنا على آل ميٍّ","ونبا من دروسها الآلام",82,"م",1,0],["كمالُكَ لا يُرام إليه نَقْصٌ","وأينَ البَدْرُ تمًّا من كمالك",83,"ك",1,0],["كما لم يزل منِّي عليه ولم يَزلْ","ثنائي على طول الزمان وبرّه",84,"ر",2,0],["كما لم يَزَلْ يُرجى لكلِّ ملمَّة","ويعرف فيه الأمن في موطن الذعر",85,"ر",1,0],["كما لابن الجميل أبي جميل","نياق مطالب الرَّاجين تحدى",86,"د",2,0],["كمال الدين فيك كمال فضلٍ","ومنك لهُ وفاءٌ واكتمالُ",87,"ل",1,0],["كمالكٍ والشافعي","ومَعمرٍ باليَمنِ",88,"ن",1,0],["كما لَبَّيْتَهُ أَيَّامَ تلقَى","سيوفَ عُداتِهِ بالرَّاحَتَيْنِ",89,"ن",1,0],["كما لذّت البشرى بأكرم قادم","وذاك هو الشهم السُّمَيْدَعُ فارس",90,"س",1,0],["كم النَّحتُ في جنبيّ والحزُّ في متني","أما يُشبع الأيامَ ما أكلتْ منّي",91,"ن",2,1],["كم الجفاء لا أجازيكم به","والصدُّ والوجدُ بكم يعطِفُني",92,"ن",2,0],["كم الرضا بوشَلٍ مصرَّدٍ","لا ناقعٌ ولا يميط الدرَنا",93,"ن",2,0],["كم الثأر أما يُنْسَى","دمٌ بين قبيليْنا",94,"ن",2,0],["كم القعودُ تحت أدراج الأذى","فرصةَ مَن ضام ونهبَ مَن ظَلَمْ",95,"م",1,0],["كم الضيمُ تحت رواق القنوع","أما يأنف الأدبَ الخاملُ",96,"ل",1,0],["كم النوم تحت ظلال القنوع","وفوق القذى جفنُك المطبَقُ",97,"ق",1,0],["كم النوى قد جَزِع الصابرُ","وقَنَط المهجورُ يا هاجرُ",98,"ر",1,1],["كم المنى تُرعَى له وكم تُرَى","يُمسِك من أرماقها رجعُ الجِرَرْ",99,"ر",1,0],["كم التمادي تطلب العفوَ به","قد بلغَ الجهدَ بك التمادي",100,"د",2,0],["كما لاحَ برقٌ في مُتون غمامةٍ","فأصبحَ يُرجى صوبهُ ويُشامُ",101,"م",1,0],["كمالُ دينِ اللّهِ حامي الحِمى","إذا اسْتَغاثَ المجْدُ بالنَّاصِرِ",102,"ر",1,0],["كما لاعب الروضَ مرُّ النسيم","ونشرَ في ساحة الحيِ برد",103,"د",1,0],["كم إلى كم تفلي الطيوفُ إلى","لقياك هام الربى وظهر المهمةْ",104,"م",2,0],["كَم إِلى كَم تُبلى المَلامَ لِصَبٍّ","سَمعُهُ في الهَوى بِهِ لا يُبالي",105,"ل",2,0],["كَم إِلى كَم تَكونُ أَيدي المَعاصي","عاقِداتٍ أَطرافَها بِالنَواصي",106,"ص",2,1],["كَم إِلى كَم عَلَيَّ لِلهَجرِ دَينٌ","تَقتَضيهِ شَماتُةُ الأَعداءِ",107,"ا",2,0],["كما لَوَّحْتَ في ظلماءِ ليلٍ","إلى الأبطال في العَضْبِ اليمانِي",108,"ن",2,0],["كم إليه لذاكريه حنينٌ","وعليه لناظريه دموعُ",109,"ع",1,0],["كما لملوكنا دُوَلٌ علينا","عليهم للقَضَا دُوَلٌ تَدُولُ",110,"ل",1,0],["كَما لَكَ يا إِنسانَ عَينِ زَمانِهِ","تَكَنَّفَهُ حِفظٌ مِنَ اللَهِ حاجِبُه",111,"ب",2,0],["كَما لاقَيتُ مِن حَمَلِ بنِ بَدرٍ","وَإِخوَتِهِ عَلى ذاتِ الإِصادِ",112,"د",1,0],["كَمْ 