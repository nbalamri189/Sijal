{"poems":[[94,"كرهت القصور وقطانها","https://www.aldiwan.net/poem38931.html","المتقارب"],[35,"بنفسي من لا بد لي أن أهاجره","https://www.aldiwan.net/poem25922.html","الطويل"],[50,"يا راكبا أقبل من ثهمد","https://www.aldiwan.net/poem10416.html","السريع"],[170,"أراك مستعجلا يا حادي الإبل","https://www.aldiwan.net/poem46896.html","البسيط"],[280,"نفوس العالمين لك الفداء","https://www.aldiwan.net/poem25644.html","الوافر"],[408,"رميت أسهم آمالي فلم تصب","https://www.aldiwan.net/poem46936.html","البسيط"],[463,"مالكم لا تغضبون للهوى","https://www.aldiwan.net/poem56311.html","الرجز"],[466,"إذا أحببت فاصبر للرزايا","https://www.aldiwan.net/poem16088.html","الوافر"],[556,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/74019","الطويل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145159","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64491","الطويل"],[2036,"","https://poetry.dctabudhabi.ae/diwan/poem/203622","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111272","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100725","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86307","الطويل"],[3724,"","https://poetry.dctabudhabi.ae/diwan/poem/145221","الطويل"],[5725,"وليل يكيل الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=179909",""]],"verses":[["وكيف خَبَتْ بَسَمَاتُ الحَيَاةِ","بأَجْفانِها وعَرَاها الكُسُوفْ",0,"ف",1,0],["وَكَيفَ خَلاصي مِن جَوى الحُبِّ بَعدَما","يُسَرُّ بِهِ بَطنُ الفُؤادِ وَظاهِرُه",1,"ر",2,0],["وَكَيفَ خَلَّفتَ لَدى قَعنَبٍ","حَيثُ تَرى التَنَّوُمَ وَالآءَ",2,"ا",2,0],["وكيف خَفّتْ إلى المُشتاق نهضتُها","والثِّقلُ يُقعدُها من جانبِ الكَفَلِ",3,"ل",1,0],["وكيفَ خَطا إلى ناديكَ يُفضي","وبالخَطّي قد شَرِق الفَضاء",4,"ا",2,0],["وكيفَ خابتْ ظنوني في أكفّكمُ","وظنّ غيري فيكم قطّ لم يَخبِ",5,"ب",1,0],["وكيف خلاَّني بطيئا قَدَمِي","عنه ومرّ سابقا مع الوَنَى",6,"ا",1,0],["وكيفَ خُلوصُ حُبٍّ من بَلاءٍ","وبينَ الحُبِّ والبَلْوى إِخاءُ",7,"ا",2,0],["وكيف خلوتِ من القاطنين","وغربانُ بينك لم يَنعَبِ",8,"ب",1,0],["وكيف خلاصي من سقامي ونشوتي","وألحاظه مرضى وقامته نشوى",9,"و",2,0],["وكيف خرَّجتَ رُعاةَ الأمَمِ","من أمَّة كانت رُعاة غَنَمِ",10,"م",1,0],["وكيف خروج البعد عن حد عجزه","إذا لم تشأ تقديمه قيد خطوة",11,"ه",1,0],["وكيف خلاصي من يدي شادن إذا","بدا ابيضَّ في الديجور من نوره الحلك",12,"ك",1,0],["وكيف خلفت أهل العلم قاطبة","حلف البكا لم يفارق جفنها البلل",13,"ل",1,0],["وكيف خلفت شوط المجد ينهبه","قوم شأوتهمُ في كل مضمار",14,"ر",1,0],["وَكَيفَ خَلاصي لا رُزئت بِضيرها","وَلي عِندَها ذَنبٌ بِرُؤيَة غَيرِها",15,"ه",2,0],["وكيف خلوصي من أخ ذي تدابر","إلى وصله والصرم بالوصل محدق؟",16,"ق",1,1],["وكيف خطام الروح مزّقه صدى","لطيْفٍ توارى كل يوم يعاودهْ",17,"د",2,0]]}