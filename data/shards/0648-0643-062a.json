{"poems":[[63,"جهد الصبابة أن أكون ملوما","https://www.aldiwan.net/poem46195.html","الكامل"],[3,"يا عبل أين من المنية مهربي","https://www.aldiwan.net/poem116.html",""],[55,"عسكر الحب في فؤادي مقيم","https://www.aldiwan.net/poem26125.html","الخفيف"],[55,"أيا وحشتا لانقطاع الرسول","https://www.aldiwan.net/poem26289.html","المتقارب"],[55,"ولقد دفنت هواكم","https://www.aldiwan.net/poem26485.html","مجزوء الكامل"],[55,"كتب المحب إلى الحبيب رسالة","https://www.aldiwan.net/poem26558.html","الكامل"],[77,"سقى دارهم هام من السحب هامع","https://www.aldiwan.net/poem35996.html","الطويل"],[77,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[77,"قلدت من نصر الإلاه حساما","https://www.aldiwan.net/poem36124.html","الكامل"],[82,"وكتيبة بالدارعين كثيفة","https://www.aldiwan.net/poem29400.html","الكامل"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[83,"بشرى كما وضح الزمان وأجمل","https://www.aldiwan.net/poem54256.html","الكامل"],[27,"يا صاحبي هل الصباح منير","https://www.aldiwan.net/poem5778.html","الكامل"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[72,"يا إماما في مدح علياه صدق","https://www.aldiwan.net/poem18491.html","الخفيف"],[72,"يفديك عبد مودة","https://www.aldiwan.net/poem19614.html","مجزوء الكامل"],[91,"سئمت نفسي الحياة مع الناس","https://www.aldiwan.net/poem8747.html","عموديه"],[70,"يا قضيبا من لجين","https://www.aldiwan.net/poem42676.html","مجزوء الرمل"],[70,"أعلمتم أن النسيم إذا سرى","https://www.aldiwan.net/poem42922.html","السريع"],[99,"في المقهى","https://www.aldiwan.net/poem6248.html","عموديه"],[61,"هم صرموا حبل الهوى فتصرما","https://www.aldiwan.net/poem51445.html","الطويل"],[61,"عندي إذا مالروض أصبح ذابلا","https://www.aldiwan.net/poem51487.html","الكامل"],[61,"أعن الأهلة في الدياجر","https://www.aldiwan.net/poem51676.html","مجزوء الكامل"],[66,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[66,"أسلبن من فوق النهود ذوائبا","https://www.aldiwan.net/poem41382.html","الكامل"],[80,"ورد الخدود ونرجس المقل","https://www.aldiwan.net/poem31330.html","أحذ الكامل"],[80,"هل كان أودع سر قلب محجرا","https://www.aldiwan.net/poem31438.html","الكامل"],[44,"إصبري أيتها النف","https://www.aldiwan.net/poem29699.html","مجزوء الرمل"],[44,"بأبي وغير أبي وذاك قليل","https://www.aldiwan.net/poem30307.html","الكامل"],[17,"إن امرأً أمن الحوادث جاهل","https://www.aldiwan.net/poem1197.html",""],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"ما غر من تسري عقاربه","https://www.aldiwan.net/poem26889.html","الكامل"],[52,"وآثار وصل في هواك حفظتها","https://www.aldiwan.net/poem27163.html","الطويل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[50,"تبوح بسرك ضيقا به","https://www.aldiwan.net/poem62236.html","المتقارب"],[46,"أما والركاب وأقتابها","https://www.aldiwan.net/poem22365.html","المتقارب"],[68,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67292","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[77,"قلدت من نصر الإله حساما","https://www.poetsgate.com/ViewPoem.aspx?id=34200",""],[67,"وكتابُ شعيا مخبرٌ عن ربهِ","https://www.poetsgate.com/ViewPoem.aspx?id=14561",""],[99,"في المقهى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=338&r=&rc=45",""],[31,"ما شَجَاكَ الغَدَاة َ مِنْ رَسْمِ دَارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18869&r=&rc=132",""]],"verses":[["وكَتيبَةٍ منْ سِرِّ جَوثَةَ فَخمَةٍ","كالأُسْدِ تَملأُ مِسمَعَيْكَ نَئيما",0,"م",2,0],["وَكَتيبَةٍ لَبَّستُها بِكَتيبَةٍ","شَهباءَ باسِلَةٍ يُخافُ رَداها",1,"ا",3,0],["وَكَتَمتُ الهَوى فَقَلَّ اِصطِباري","وَبَدا مِن ضَميريَ المَكتومُ",2,"م",1,0],["وَكِتمانُ ما اِستودِعَتهُ النُفو","سُ لا شَكَّ خَيرٌ مِنِ اِظهارِهِ",3,"ر",2,0],["وَكَتَمتُ حُبَّكِ جاهِداً","وَرَعَيتُ غَيبَكِ بِالمَغيبِ",4,"ب",1,0],["وَكَتَمتُ حُبَّكِ فَاِعلَمي وَاِستَيقِني","وَالحُبُّ مِن غَيري فَدَيتُكِ قَد أَبى",5,"ا",1,0],["وكتّبْتَ منْ أُسْد الحِفاظِ كَتائِباً","إذا ثوّبَ الدّاعي أتَتْهُ تُسارِعُ",6,"ع",1,0],["وَكَتِيبَةٍ قَرَأَتْ ظُباكَ كِتَابَهَا","فَعَلِمْتَ مِنْهَا كُلَّ مَا لَمْ يُعْلَمِ",7,"م",1,0],["وَكَتِيبَةٍ جعَلُو االصِّفَاحَ صَحَائِفاً","مِنْهَا وَخَطِّيَّ الْقَنَا أَقْلاَمَا",8,"م",2,0],["وكتيبة بالدارعين كثيفة","جرت ذيول الجحفل الجرار",9,"ر",1,1],["وكتيبةٍ للشوق قد جهزتها","أغزو بها السلوانَ غزوَ مُصمِّم",10,"م",1,0],["وكتيبةٍ أردفتها بكتيبةٍ","والخيل تمرحُ في الحديد وترفُلُ",11,"ل",1,0],["وَكَتَمتُ سِرَّكَ في الفُؤادِ مُجَمجِماً","إِنَّ الكَتومَ لِسِرِّهِ لَجَديرُ",12,"ر",1,0],["وَكَتيبَةُ الأَحلافِ قَد لاقَيتُهُم","حَيثُ اِستَفاضَ دَكادِكٌ وَقَصيمُ",13,"م",1,0],["وكتاب الصحاح أوتي فما ين","فك يروى عنكم كتاب الصحاح",14,"ح",1,0],["وكتبت عهدةَ رقه","بالمكرمات فحله",15,"ه",1,0],["وَكِتابي الفَضاءُ أَقرَأُ فيهِ","سُوَراً ما قَرَأتُها في كِتابِ",16,"ب",1,0],["وَكِتابٌ سُطِّرَ الحُس","نُ بِهِ في صَفحَتَينِ",17,"ن",1,0],["وَكَتَمتُ فيهِ مَحَبَّتي فَأَذاعَها","غَزَلٌ يَفوحُ المِسكُ مِنهُ أَذفَرا",18,"ر",2,0],["وكتاب ضارع في يده","يحصد الفضلة من إيمانها",19,"ن",3,0],["وكتَّابُ مَلْكٍ لا تَطيشُ سِهامُهُم","إذا فوَّقُوا للحادثِ النُّكْرِ أسهُما",20,"م",2,0],["وكَتِيبتَا زَنْجٍ ورومٍ أَذْكَتَا","حَرباً يَسُلُّ بها الذَّكاءُ مَناصِلا",21,"ل",2,0],["وكتائبٍ تُزجي الرَّدى","ما بينَ مُدَّرِعٍ وَحاسِر",22,"ر",1,0],["وَكَتيبَةٍ تَختالُ في أَجمِ القَنا","كَالأُسدِ تَسري وَهيَ في غاباتِها",23,"ت",3,0],["وَكَتيبَةٌ ضَرَبَ العَجاجُ رِواقَها","مِن فَوقِ أَعمِدَةِ القَنا المُرّانِ",24,"ن",1,0],["وَكَتيبَةٍ تَذَرُ الصَهيلَ رَواعِداً","وَالبيضَ بَرقاً وَالعَجاجَ سَحائِبا",25,"ب",2,0],["وكتيبةٍ شهباءَ رانيةٍ","تحتَ العجاج بأعْيُنِ الأسَلِ",26,"ل",1,0],["وكتيبةٍ كَتَبَتْ صدورُ رماحها","للموتِ في صُحُفِ الحيازم أسْطُرا",27,"ر",2,0],["وَكِتابٍ كَتَبَتهُ","مُقلَةٌ لا تَتَهَجّى",28,"ج",2,0],["وَكَتيبَةٍ كُتِبَت لَها أَرواحُها","وَاليَومُ أَحمَرُ مِن دَمٍ مَصقولُ",29,"ل",1,0],["وَكَتيبَةٍ أَدنَيتُها لِكَتيبَةٍ","وَمُضاغِنٍ صَبَّحتُ شَرَّ صَباحِ",30,"ح",1,0],["وَكَتَبوا صَكّاً بِبَيعِ الضَيعَه","وَحَلَّفوهُ بِيَمينِ البَيعَه",31,"ه",1,0],["وَكَتيبَةٍ دَفّاءَ مِن أَسَلٍ","قَد أَلبَسوها مِن دَمٍ قُمُصا",32,"ص",2,0],["وَكُتبٍ لِطافٍ تُربُها المِسكُ أُدرِجَت","عَلى وَصفِ أَحزانٍ وَتَعذيبِ أَرواحِ",33,"ح",1,0],["وَكِتابُ شَعْيا مُخْبِرٌ عَنْ رَبِّهِ","فاسْمَعْهُ يُفْرِحُ قَلْبَكَ المَتْبُولا",34,"ل",2,0],["وَكِتابُهُ ما ليسَ يُطْفَأُ نُورُهُ","والحَقُّ مُنْقَادٌ إليه ذَلولا",34,"ل",2,0],["وكتائِباً تُرْدي غواربَها القَنا","وفوارساً تَغْدى صَوالجَها الظُّبى",35,"ب",2,0],["وَكِتمانُكَ السِرَّ عَمّن تَخافُ","وَمَن لا تَخَوَّفُهُ أَحزَمُ",36,"م",1,0],["وَكُتبٍ يَبينُ اِتِّقاءُ المَليكِ","في دارِسيها وَكُتّابِها",37,"ب",3,0],["وكتمْتُهُ عنّي فلو أبدَيْتُهُ","لوَجَدْتُهُ أخفى منَ اللُّطْف الخَفي",38,"ي",1,0],["وكتبتمو عهداً بحدِّ سيوفكم","مزَّقتُمُوهُ ولم يجِفَّ مِدَادَا",39,"د",2,0],["وكتيبةٍ ينفي القِرَانَ قتيرُهَا","وتَرُدُّ حدَّ قَوَاحزِ النُّشَّابِ",40,"ب",1,0],["وكتَبنا في رْوعةٍ وبيانٍ","يُقسمُ السحرُ إنه من بيانه",41,"ن",2,0],["وكتبتَ في التاريخ أروعَ قصَّة","من غَضْبَةَ الآسادِ إنْ ديسَ الثَّرَى",42,"ر",2,0],["وكتيبة جعلوا الصفاح صحائفا","فيها وخطي القنا أقلاما",43,"م",2,0],["وكتابهُ ماليسَ يطفأُ نوُره","مَلأَ الأَعادِي ذِلَّة ً وخُمولا",44,"ل",2,0],["وكتاب ضارع في يدها","يحصد الفضلة من إيمانها",45,"ن",3,0],["وکكْتَنَنّا بُرْدَيْنِ مِنْ جَيِّدِ العَصْ","بِ معاً، بينَ مطرفٍ، وشعار",46,"ر",1,0]]}