.net/poem538.html",""],[498,"وحياتكم يا أهل منعرج اللوى","https://www.aldiwan.net/poem37677.html","الكامل"],[513,"لبيك تلبية الحجيج إلى الصفا","https://www.aldiwan.net/poem12179.html","الكامل"],[513,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[527,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[536,"ضاءتا كالفرقدين","https://www.aldiwan.net/poem47422.html","عموديه"],[536,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"],[549,"ما أرادت إلا الجفاء ظلوم","https://www.aldiwan.net/poem47245.html","الخفيف"],[556,"لمتى أنت في الضلال المبين","https://www.aldiwan.net/poem33722.html","الخفيف"],[556,"علم عظيم النفع للعالم","https://www.aldiwan.net/poem34181.html","السريع"],[556,"أنا دائما يا نور كل مليح","https://www.aldiwan.net/poem34680.html","الكامل"],[560,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[560,"العلم فوق المال في إرشاده","https://www.aldiwan.net/poem52802.html","الكامل"],[573,"قالوا محبك يا حبيب صبر","https://www.aldiwan.net/poem2956.html","أحذ الكامل"],[573,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[573,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"],[577,"أي شيء يمنح الأوطان قدرا","https://www.aldiwan.net/poem56777.html","الرمل"]],"verses":[["وكَتيبَةٍ منْ سِرِّ جَوثَةَ فَخمَةٍ","كالأُسْدِ تَملأُ مِسمَعَيْكَ نَئيما",0,"م",2,0],["وَكَتيبَةٍ لَبَّستُها بِكَتيبَةٍ","شَهباءَ باسِلَةٍ يُخافُ رَداها",1,"ا",3,0],["وَكَتَمتُ الهَوى فَقَلَّ اِصطِباري","وَبَدا مِن ضَميريَ المَكتومُ",2,"م",1,0],["وَكِتمانُ ما اِستودِعَتهُ النُفو","سُ لا شَكَّ خَيرٌ مِنِ اِظهارِهِ",3,"ر",2,0],["وَكَتَمتُ حُبَّكِ جاهِداً","وَرَعَيتُ غَيبَكِ بِالمَغيبِ",4,"ب",1,0],["وَكَتَمتُ حُبَّكِ فَاِعلَمي وَاِستَيقِني","وَالحُبُّ مِن غَيري فَدَيتُكِ قَد أَبى",5,"ا",1,0],["وكتّبْتَ منْ أُسْد الحِفاظِ كَتائِباً","إذا ثوّبَ الدّاعي أتَتْهُ تُسارِعُ",6,"ع",1,0],["وَكَتِيبَةٍ قَرَأَتْ ظُباكَ كِتَابَهَا","فَعَلِمْتَ مِنْهَا كُلَّ مَا لَمْ يُعْلَمِ",7,"م",1,0],["وَكَتِيبَةٍ جعَلُو االصِّفَاحَ صَحَائِفاً","مِنْهَا وَخَطِّيَّ الْقَنَا أَقْلاَمَا",8,"م",2,0],["وكتيبة بالدارعين كثيفة","جرت ذيول الجحفل الجرار",9,"ر",1,1],["وكتيبةٍ للشوق قد جهزتها","أغزو بها السلوانَ غزوَ مُصمِّم",10,"م",1,0],["وكتيبةٍ أردفتها بكتيبةٍ","والخيل تمرحُ في الحديد وترفُلُ",11,"ل",1,0],["وَكَتَمتُ سِرَّكَ في الفُؤادِ مُجَمجِماً","إِنَّ الكَتومَ لِسِرِّهِ لَجَديرُ",12,"ر",1,0],["وَكَتيبَةُ الأَحلافِ قَد لاقَيتُهُم","حَيثُ اِستَفاضَ دَكادِكٌ وَقَصيمُ",13,"م",1,0],["وكتاب الصحاح أوتي فما ين","فك يروى عنكم كتاب الصحاح",14,"ح",1,0],["وكتبت عهدةَ رقه","بالمكرمات فحله",15,"ه",1,0],["وَكِتابي الفَضاءُ أَقرَأُ فيهِ","سُوَراً ما قَرَأتُها في كِتابِ",16,"ب",1,0],["وَكِتابٌ سُطِّرَ الحُس","نُ بِهِ في صَفحَتَينِ",17,"ن",1,0],["وَكَتَمتُ فيهِ مَحَبَّتي فَأَذاعَها","غَزَلٌ يَفوحُ المِسكُ مِنهُ أَذفَرا",18,"ر",2,0],["وكتاب ضارع في يده","يحصد الفضلة من إيمانها",19,"ن",3,0],["وكتَّابُ مَلْكٍ لا تَطيشُ سِهامُهُم","إذا فوَّقُوا للحادثِ النُّكْرِ أسهُما",20,"م",2,0],["وكَتِيبتَا زَنْجٍ ورومٍ أَذْكَتَا","حَرباً يَسُلُّ بها الذَّكاءُ مَناصِلا",21,"ل",2,0],["وكتائبٍ تُزجي الرَّدى","ما بينَ مُدَّرِعٍ وَحاسِر",22,"ر",1,0],["وَكَتيبَةٍ تَختالُ في أَجمِ القَنا","كَالأُسدِ تَسري وَهيَ في غاباتِها",23,"ت",3,0],["وَكَتيبَةٌ ضَرَبَ العَجاجُ رِواقَها","مِن فَوقِ أَعمِدَةِ القَنا المُرّانِ",24,"ن",1,0],["وَكَتيبَةٍ تَذَرُ الصَهيلَ رَواعِداً","وَالبيضَ بَرقاً وَالعَجاجَ سَحائِبا",25,"ب",2,0],["وكتيبةٍ شهباءَ رانيةٍ","تحتَ العجاج بأعْيُنِ الأسَلِ",26,"ل",1,0],["وكتيبةٍ كَتَبَتْ صدورُ رماحها","للموتِ في صُحُفِ الحيازم أسْطُرا",27,"ر",2,0],["وَكِتابٍ كَتَبَتهُ","مُقلَةٌ لا تَتَهَجّى",28,"ج",2,0],["وَكَتيبَةٍ كُتِبَت لَها أَرواحُها","وَاليَومُ أَحمَرُ مِن دَمٍ مَصقولُ",29,"ل",1,0],["وَكَتيبَةٍ أَدنَيتُها لِكَتيبَةٍ","وَمُضاغِنٍ صَبَّحتُ شَرَّ صَباحِ",30,"ح",1,0],["وَكَتَبوا صَكّاً بِبَيعِ الضَيعَه","وَحَلَّفوهُ بِيَمينِ البَيعَه",31,"ه",1,0],["وَكَتيبَةٍ دَفّاءَ مِن أَسَلٍ","قَد أَلبَسوها مِن دَمٍ قُمُصا",32,"ص",2,0],["وَكُتبٍ لِطافٍ تُربُها المِسكُ أُدرِجَت","عَلى وَصفِ أَحزانٍ وَتَعذيبِ أَرواحِ",33,"ح",1,0],["وَكِتابُ شَعْيا مُخْبِرٌ عَنْ رَبِّهِ","فاسْمَعْهُ يُفْرِحُ قَلْبَكَ المَتْبُولا",34,"ل",2,0],["وَكِتابُهُ ما ليسَ يُطْفَأُ نُورُهُ","والحَقُّ مُنْقَادٌ إليه ذَلولا",34,"ل",2,0],["وكتائِباً تُرْدي غواربَها القَنا","وفوارساً تَغْدى صَوالجَها الظُّبى",35,"ب",2,0],["وَكِتمانُكَ السِرَّ عَمّن تَخافُ","وَمَن لا تَخَوَّفُهُ أَحزَمُ",36,"م",1,0],["وَكُتبٍ يَبينُ اِتِّقاءُ المَليكِ","في دارِسيها وَكُتّابِها",37,"ب",3,0],["وكتمْتُهُ عنّي فلو أبدَيْتُهُ","لوَجَدْتُهُ أخفى منَ اللُّطْف الخَفي",38,"ي",1,0],["وكتبتمو عهداً بحدِّ سيوفكم","مزَّقتُمُوهُ ولم يجِفَّ مِدَادَا",39,"د",2,0],["وكتيبةٍ ينفي القِرَانَ قتيرُهَا","وتَرُدُّ حدَّ قَوَاحزِ النُّشَّابِ",40,"ب",1,0],["وكتَبنا في رْوعةٍ وبيانٍ","يُقسمُ السحرُ إنه من بيانه",41,"ن",2,0],["وكتبتَ في التاريخ أروعَ قصَّة","من غَضْبَةَ الآسادِ إنْ ديسَ الثَّرَى",42,"ر",2,0],["وكتيبة جعلوا الصفاح صحائفا","فيها وخطي القنا أقلاما",43,"م",2,0],["وكتابهُ ماليسَ يطفأُ نوُره","مَلأَ الأَعادِي ذِلَّة ً وخُمولا",44,"ل",2,0],["وكتاب ضارع في يدها","يحصد الفضلة من إيمانها",45,"ن",3,0],["وکكْتَنَنّا بُرْدَيْنِ مِنْ جَيِّدِ العَصْ","بِ معاً، بينَ مطرفٍ، وشعار",46,"ر",1,0],["وكتمت ما القاه من الم النوى","عن آل عمي الاقربي وخالي",47,"ل",2,0],["وكَتَمنا عن الوَرى شَكوانا","كيفَ نَشكو ولا سَميعَ سِوانا",48,"ن",2,0],["وَكَتيبَةٍ شَهباءَ مِن ماذِيِّها","لاقَيتَها بِمَنيَّةٍ دَهماءِ",49,"ا",2,0],["وَكَتيبَةٍ رَعناءَ يَخشاها الرَدى","أَبكى فَوارِسَها عَلى ساداتِها",50,"ت",3,0],["وَكَتائبٍ كانَت تَها","بُ لِقاءَ سَطوَتِها المَتارِسْ",51,"س",1,0],["وكتبتُ سائر حاجتي يا سيدي","وَقِّع فَديتُك واستمدَّ وَوقِّعا",52,"ع",2,0],["وكتمان الهوى خطب عظيم","على قرب الديار من الديار",53,"ر",1,0],["وَكُتبهم في سوى مَعنى عقائدهم","بحورُ علمٍ فَرِد منها لأعذبهِ",54,"ب",2,0],["وكتمتُ حبّك مرغما","والحبّ يقتل حين يكتم",55,"م",1,0],["وكَتَمتُ الأحلام في الحبّ عنهُ","يومَ كنّا مخافةَ التأويل",56,"ل",1,0],["وكتيبةٍ فرقتها وشدائدٍ","فَرَّجْتُهن ولم أبِتْ مُتَضَجّعا",57,"ع",2,0],["وكتمت حتى غال حبك مهجتي","واشتد شيئا في الهوى مكتومه",58,"م",2,0],["وكتابُ الكونِ فيه صُحفٌ","يقرأ الحكمةَ فيها العُقلاء",59,"ا",2,0],["وكتبوا إجازةً في الوَرَقِ","والمقصد الأسنى اصطيادُ الوَرِقِ",60,"ق",1,0],["وَكتاب أَحكمت آياته","عصمة اللَه لمن رام اِعتصاما",61,"م",2,0],["وَكَتَّمتُ حالي عَنِ الشامِتينَ","كَما كُتِمَ الشَيبُ تَحتَ الكَتَم",62,"م",1,0],["وَكُتبُهُ الكَتائِبُ الشُّهبُ إِذا","أَنشَأَها مُبتَدِهاً أَو مُحتَفِل",63,"ل",1,0],["وكتمت في الصدر الهوى","ولواعج الشوق المذيب",64,"ب",1,0],["وَكتمتُ عَن نَفسي حَديثَ غرامه","حذراً عليه ولَم أفُه بمصونِهِ",65,"ن",2,0],["وكتاب اللَه قد يفهمهم","لو تلوه بقلوب حضرت",66,"ت",1,0],["وكتيبةٍ تَطِسُ الحصَى مَلْمومةٍ","تُعْشى إياةَ الشّمسِ بالومَضان",67,"ن",1,0],["وكتابُ عصرِكَ مُذْ أَتَى أَبناءه","واللهُ ضَمَّنه عُلاكَ وعَنْوَنا",68,"ن",2,0],["وَكَتَمتُ حُبَّهُمُ وَكَتمي حُبَّهُم","لا بَل كَتَمتُ الحُبَّ عَن كِتماني",69,"ي",1,0],["وَكُتبٌ يَفيضُ بِأَرجائِها","يَمينُ الجَدا وَلِسانُ الجِدالِ",70,"ل",1,0],["وَكُتبُهُ تَحكي لَنا دارَهُ","فَكُلُّ مَن فيها بَناتُ الخَطا",71,"ط",2,1],["وَكِتابَكَ المَلعونُ في أَلفاظِهِ","ما يَدَّعي قَسراً لِغَيرِ أَبيهِ",72,"ه",1,1],["وكتابةٍ سوداءَ فيها أسهمٌ","يجري الندى منها وتجري بالرَّدى",73,"د",2,0],["وكتيبةٌ لمعت فأب","رق جَوُها وجرت فأرعَد",74,"د",1,0],["وكتَمتُ سِرّي عن نَباكَ مُغالِطاً","كيما أُواري النورَ بالظَلماءِ",75,"ا",2,0],["وكتاب إحياء لنا فتعلموا","وتفهموا ما قاله ثم اعملوا",76,"ل",3,0],["وكتاب الله والحق المنير","ثم طوبى للذي قلبه نوير",77,"ر",1,0],["وكَتَائبٌ خُضْرٌ تَظلّ كُماتُها","كالأُسْد في أجم القنا تَتَبَخْتَرُ",78,"ر",1,0],["وَكتمت حُبَّك وَهوَ نارٌ مِثلما","كتم الزِناد ثَواقِبَ النِيرانِ",79,"ن",1,0],["وَكَتيبَةٍ قَرأت مِنكَ فانفضَّ","ت كَما فَضَّت خِتام سِحائِهِ",80,"ا",3,0],["وكتابٍ منكَ فاجأنِي","كبشيرٍ جَاءَ بالظّفَرِ",81,"ر",1,1],["وكتْبك أمثال الشُّموس طوالع","فلا اللَّيل يغشاها إذ الشّكّ كاللَّيل",82,"ل",1,0],["وكتبٌ لدين الله أضحتْ مطالعاً","كما كانت الأَفلاك للشَّمس مطلعا",83,"ع",2,0],["وكتَابَةٌ لا تَرْتَضِى نَهْرَ الصَّفَا","رَقًّا ولا زَهْرَ البِطاحِ سُطُورا",84,"ر",2,0],["وكتابٍ صَغُرَتْ أَجزاؤُهُ","وَهُوَ قد حازَ الحديثَ الأَكْبَرَا",85,"ر",2,1],["وكتابَةٌ من حُسْنِ صُورَتِها","تُغْنِي عن التَنْقِيطِ والشَّكْلِ",86,"ل",1,0],["وكتائبٍ خطبَ الزمانُ خطوبها","فرمَتْ جوارحَه بفتْكِ جراحِه",87,"ح",2,0],["وكتائِبٌ لليُمْنِ يومَ رَحِيلِها","بالفتحِ فِي جَنَباتِها اسْتِهْلالُ",88,"ل",1,0],["وكتائِبٍ لَهِجَتْ بَطَيِّبِ ذِكْرِكُمْ","فلذيذُهُ عندَ الهياجِ شِعارُها",89,"ر",3,0],["وكَتَبْتُ منها لِلَّيالي مُصْحَفاً","تتلُوهُ أَلسِنَةُ الزَّمانِ الدَّائِبِ",90,"ب",1,0],["وكَتائِبُ الإِفْرَنج إِذ كادَتْكَ فِي","أَشياعِها والله عنكَ يكِيدُها",91,"د",3,0],["وكُتْبٌ تفضُّ الروضَ نَشرا ومنظرا","إذا فُضَّ من مَطْوِيِّهنَّ خِتامُ",92,"م",1,0],["وَكَتِ القِرافَ بحِجرِها","ووِكاؤُها زُنَّارها",93,"ر",3,0],["وكِتْمانُ السَّرائرِ عن حبيبٍ","بفَتْوى الحبِّ كِتْمانٌ حَرامُ",94,"م",1,0],["وكتبت أطراس الفلا بكتائب","أبداً يسير النصر تحت لوائها",95,"ا",3,0],["وكتمتُ لما ثوَّروا أسرارَهمْ","والبينُ فيه يُذاعُ بالأسرارِ",96,"ر",1,0],["وكَتيبَةٍ لَبَّستُها بِكَتيبَةٍ","حَتّى تَقولَ سَراتُهُم هَذا الفَتى",97,"ا",1,0],["وكتيبةُ الأحداق ما وقفت ولم","تلمس لديكم مسدل الأذيالِ",98,"ل",1,0],["وكتبت تسأل في قبول مثوبة","منها ببابك منعماً ومشرفا",99,"ف",2,0],["وكتائب التأييد محدقة به","أنى أتى من خلفه وأمامه",100,"م",2,0],["وكُتُبُ الأَئِمهْ","بِمِثْلِ ذا مُلِمَّهْ",101,"ه",1,0],["وكتابُ الدرس في","يدها تقرأُ فيه",102,"ه",1,0],["وكتابُ الإِمامِ مثلُ سَماءٍ","ورِجالُ الحَديثِ كَالأقمار",103,"ر",1,0],["وكتمنا وَجْداً بها ساعةَ البَيْ","نِ ولكنْ دَمْعُ العيونِ نَمومُ",104,"م",1,0],["وكتاب الأبرار يعلو علوّاً","وكتاب الفجار في سجين",105,"ن",1,0],["وكتْبَ محيي الدين طالعْ لها","بخاطرٍ عن غيرها صائم",106,"م",1,0],["وكتمته لما بدا لنواظري","نور الخباء وملت للتلميح",107,"ح",1,0],["وكتابُهُ الإِنجيلُ حقٌّ واضحٌ","لا ريبَ فيهِ ولا سبيلَ لمُتهِمِ",108,"م",1,0],["وكتبتُ ما قد أحزَنَ القِرطاسَ مِن","تَلَفٍ فكانَ الحِبرُ ثَوْبَ حِدادِهِ",109,"د",2,0],["وكتابُ جُودِكَ بالوصال وما","فيه لديوان الصُّدُودِ نَظَرْ",110,"ر",1,0],["وكتابُه للمُلْك أَيُّ كتيبة","تَدَعُ العَدُوَّ محيَّراً ومُجنَّنا",111,"ن",2,0],["وكُت