],[5943,"تشطير لقصيدة نجاة الظاهري","https://www.poetsgate.com/ViewPoem.aspx?id=138286",""],[5947,"ممكن؟!!","https://www.poetsgate.com/ViewPoem.aspx?id=23331",""],[5956,"لمن تثور العاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=181909",""],[5956,"حتى الدجى حسد النجاح فقد سجى","https://www.poetsgate.com/ViewPoem.aspx?id=193508",""],[5956,"أحسِنْ إلى الفقراء وابعدْ عنهمو","https://www.poetsgate.com/ViewPoem.aspx?id=207268",""],[5974,"غربة","https://www.poetsgate.com/ViewPoem.aspx?id=208112",""],[5975,"اذكريني","https://www.poetsgate.com/ViewPoem.aspx?id=52970",""],[5975,"الوفاء لمن أحب","https://www.poetsgate.com/ViewPoem.aspx?id=52984",""],[5977,"ستار الليل","https://www.poetsgate.com/ViewPoem.aspx?id=213264",""],[6004,"خيال النَّدامى","https://www.poetsgate.com/ViewPoem.aspx?id=59141",""],[6052,"أنت المنار","https://www.poetsgate.com/ViewPoem.aspx?id=49595",""],[6082,"حلم متعثَر","https://www.poetsgate.com/ViewPoem.aspx?id=59182",""],[6093,"ولقد وقفت بحيرة لوداعهم","https://www.poetsgate.com/ViewPoem.aspx?id=197661",""],[6093,"الجلبي","https://www.poetsgate.com/ViewPoem.aspx?id=201050",""],[6124,"تمشي وكأنك","https://www.poetsgate.com/ViewPoem.aspx?id=194318",""],[6125,"عَاقَرتُ حُبَّكِ فَاستَحَلتُ مُرِيدَا","https://www.poetsgate.com/ViewPoem.aspx?id=209068",""],[6152,"أصعب الأشياء كتمان الشعور","https://www.poetsgate.com/ViewPoem.aspx?id=213344",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6177,"لن أعود إليك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79464&r=&rc=24",""],[6189,"اعترافات شاهد الموت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83556&r=&rc=23",""],[6202,"مرثيتي ......","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86754&r=&rc=55",""],[6228,"هي لا تغيب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85979&r=&rc=16",""],[6259,"قولا له هل دارَ في حوبائهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59352&r=&rc=0",""],[6318,"يا قُدسُ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66166&r=&rc=16",""],[6343,"تهويمات في وجهها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1971&r=&rc=1",""],[6355,"اللصوص","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66664&r=&rc=124",""]],"verses":[["وكَتيبَةٍ منْ سِرِّ جَوثَةَ فَخمَةٍ","كالأُسْدِ تَملأُ مِسمَعَيْكَ نَئيما",0,"م",2,0],["وَكَتيبَةٍ لَبَّستُها بِكَتيبَةٍ","شَهباءَ باسِلَةٍ يُخافُ رَداها",1,"ا",3,0],["وَكَتَمتُ الهَوى فَقَلَّ اِصطِباري","وَبَدا مِن ضَميريَ المَكتومُ",2,"م",1,0],["وَكِتمانُ ما اِستودِعَتهُ النُفو","سُ لا شَكَّ خَيرٌ مِنِ اِظهارِهِ",3,"ر",2,0],["وَكَتَمتُ حُبَّكِ جاهِداً","وَرَعَيتُ غَيبَكِ بِالمَغيبِ",4,"ب",1,0],["وَكَتَمتُ حُبَّكِ فَاِعلَمي وَاِستَيقِني","وَالحُبُّ مِن غَيري فَدَيتُكِ قَد أَبى",5,"ا",1,0],["وكتّبْتَ منْ أُسْد الحِفاظِ كَتائِباً","إذا ثوّبَ الدّاعي أتَتْهُ تُسارِعُ",6,"ع",1,0],["وَكَتِيبَةٍ قَرَأَتْ ظُباكَ كِتَابَهَا","فَعَلِمْتَ مِنْهَا كُلَّ مَا لَمْ يُعْلَمِ",7,"م",1,0],["وَكَتِيبَةٍ جعَلُو االصِّفَاحَ صَحَائِفاً","مِنْهَا وَخَطِّيَّ الْقَنَا أَقْلاَمَا",8,"م",2,0],["وكتيبة بالدارعين كثيفة","جرت ذيول الجحفل الجرار",9,"ر",1,1],["وكتيبةٍ للشوق قد جهزتها","أغزو بها السلوانَ غزوَ مُصمِّم",10,"م",1,0],["وكتيبةٍ أردفتها بكتيبةٍ","والخيل تمرحُ في الحديد وترفُلُ",11,"ل",1,0],["وَكَتَمتُ سِرَّكَ في الفُؤادِ مُجَمجِماً","إِنَّ الكَتومَ لِسِرِّهِ لَجَديرُ",12,"ر",1,0],["وَكَتيبَةُ الأَحلافِ قَد لاقَيتُهُم","حَيثُ اِستَفاضَ دَكادِكٌ وَقَصيمُ",13,"م",1,0],["وكتاب الصحاح أوتي فما ين","فك يروى عنكم كتاب الصحاح",14,"ح",1,0],["وكتبت عهدةَ رقه","بالمكرمات فحله",15,"ه",1,0],["وَكِتابي الفَضاءُ أَقرَأُ فيهِ","سُوَراً ما قَرَأتُها في كِتابِ",16,"ب",1,0],["وَكِتابٌ سُطِّرَ الحُس","نُ بِهِ في صَفحَتَينِ",17,"ن",1,0],["وَكَتَمتُ فيهِ مَحَبَّتي فَأَذاعَها","غَزَلٌ يَفوحُ المِسكُ مِنهُ أَذفَرا",18,"ر",2,0],["وكتاب ضارع في يده","يحصد الفضلة من إيمانها",19,"ن",3,0],["وكتَّابُ مَلْكٍ لا تَطيشُ سِهامُهُم","إذا فوَّقُوا للحادثِ النُّكْرِ أسهُما",20,"م",2,0],["وكَتِيبتَا زَنْجٍ ورومٍ أَذْكَتَا","حَرباً يَسُلُّ بها الذَّكاءُ مَناصِلا",21,"ل",2,0],["وكتائبٍ تُزجي الرَّدى","ما بينَ مُدَّرِعٍ وَحاسِر",22,"ر",1,0],["وَكَتيبَةٍ تَختالُ في أَجمِ القَنا","كَالأُسدِ تَسري وَهيَ في غاباتِها",23,"ت",3,0],["وَكَتيبَةٌ ضَرَبَ العَجاجُ رِواقَها","مِن فَوقِ أَعمِدَةِ القَنا المُرّانِ",24,"ن",1,0],["وَكَتيبَةٍ تَذَرُ الصَهيلَ رَواعِداً","وَالبيضَ بَرقاً وَالعَجاجَ سَحائِبا",25,"ب",2,0],["وكتيبةٍ شهباءَ رانيةٍ","تحتَ العجاج بأعْيُنِ الأسَلِ",26,"ل",1,0],["وكتيبةٍ كَتَبَتْ صدورُ رماحها","للموتِ في صُحُفِ الحيازم أسْطُرا",27,"ر",2,0],["وَكِتابٍ كَتَبَتهُ","مُقلَةٌ لا تَتَهَجّى",28,"ج",2,0],["وَكَتيبَةٍ كُتِبَت لَها أَرواحُها","وَاليَومُ أَحمَرُ مِن دَمٍ مَصقولُ",29,"ل",1,0],["وَكَتيبَةٍ أَدنَيتُها لِكَتيبَةٍ","وَمُضاغِنٍ صَبَّحتُ شَرَّ صَباحِ",30,"ح",1,0],["وَكَتَبوا صَكّاً بِبَيعِ الضَيعَه","وَحَلَّفوهُ بِيَمينِ البَيعَه",31,"ه",1,0],["وَكَتيبَةٍ دَفّاءَ مِن أَسَلٍ","قَد أَلبَسوها مِن دَمٍ قُمُصا",32,"ص",2,0],["وَكُتبٍ لِطافٍ تُربُها المِسكُ أُدرِجَت","عَلى وَصفِ أَحزانٍ وَتَعذيبِ أَرواحِ",33,"ح",1,0],["وَكِتابُ شَعْيا مُخْبِرٌ عَنْ رَبِّهِ","فاسْمَعْهُ يُفْرِحُ قَلْبَكَ المَتْبُولا",34,"ل",2,0],["وَكِتابُهُ ما ليسَ يُطْفَأُ نُورُهُ","والحَقُّ مُنْقَادٌ إليه ذَلولا",34,"ل",2,0],["وكتائِباً تُرْدي غواربَها القَنا","وفوارساً تَغْدى صَوالجَها الظُّبى",35,"ب",2,0],["وَكِتمانُكَ السِرَّ عَمّن تَخافُ","وَمَن لا تَخَوَّفُهُ أَحزَمُ",36,"م",1,0],["وَكُتبٍ يَبينُ اِتِّقاءُ المَليكِ","في دارِسيها وَكُتّابِها",37,"ب",3,0],["وكتمْتُهُ عنّي فلو أبدَيْتُهُ","لوَجَدْتُهُ أخفى منَ اللُّطْف الخَفي",38,"ف",2,0],["وكُتْمَى ودُوَّارٌ كأّنَّ ذُرَاهُمَا","وقَدْ خَفِيَا إِلاَّ الغَوَارِبَ رَبْرَبُ",39,"ب",1,0],["وكتبتمو عهداً بحدِّ سيوفكم","مزَّقتُمُوهُ ولم يجِفَّ مِدَادَا",40,"د",2,0],["وكتيبةٍ ينفي القِرَانَ قتيرُهَا","وتَرُدُّ حدَّ قَوَاحزِ النُّشَّابِ",41,"ب",1,0],["وكتَبنا في رْوعةٍ وبيانٍ","يُقسمُ السحرُ إنه من بيانه",42,"ن",2,0],["وكتبتَ في التاريخ أروعَ قصَّة","من غَضْبَةَ الآسادِ إنْ ديسَ الثَّرَى",43,"ر",2,0],["وكتيبة جعلوا الصفاح صحائفا","فيها وخطي القنا أقلاما",44,"م",2,0],["وكتابهُ ماليسَ يطفأُ نوُره","مَلأَ الأَعادِي ذِلَّة ً وخُمولا",45,"ل",2,0],["وكتاب حقّ لا يبالي بالهوى","إن خالف المعقول والنقولا",46,"ل",2,0],["وكتاب ضارع في يدها","يحصد الفضلة من إيمانها",47,"ن",3,0],["وکكْتَنَنّا بُرْدَيْنِ مِنْ جَيِّدِ العَصْ","بِ معاً، بينَ مطرفٍ، وشعار",48,"ر",1,0],["وكتمت ما القاه من الم النوى","عن آل عمي الاقربي وخالي",49,"ل",2,0],["وكَتَمنا عن الوَرى شَكوانا","كيفَ نَشكو ولا سَميعَ سِوانا",50,"ن",2,0],["وَكَتيبَةٍ شَهباءَ مِن ماذِيِّها","لاقَيتَها بِمَنيَّةٍ دَهماءِ",51,"ا",2,0],["وَكَتيبَةٍ رَعناءَ يَخشاها الرَدى","أَبكى فَوارِسَها عَلى ساداتِها",52,"ت",3,0],["وَكَتائبٍ كانَت تَها","بُ لِقاءَ سَطوَتِها المَتارِسْ",53,"س",1,0],["وكتبتُ سائر حاجتي يا سيدي","وَقِّع فَديتُك واستمدَّ وَوقِّعا",54,"ع",2,0],["وكتمان الهوى خطب عظيم","على قرب الديار من الديار",55,"ر",1,0],["وَكُتبهم في سوى مَعنى عقائدهم","بحورُ علمٍ فَرِد منها لأعذبهِ",56,"ب",2,0],["وكتمتُ حبّك مرغما","والحبّ يقتل حين يكتم",57,"م",1,0],["وكَتَمتُ الأحلام في الحبّ عنهُ","يومَ كنّا مخافةَ التأويل",58,"ل",1,0],["وكتيبةٍ فرقتها وشدائدٍ","فَرَّجْتُهن ولم أبِتْ مُتَضَجّعا",59,"ع",2,0],["وكتمت حتى غال حبك مهجتي","واشتد شيئا في الهوى مكتومه",60,"م",2,0],["وكتابُ الكونِ فيه صُحفٌ","يقرأ الحكمةَ فيها العُقلاء",61,"ا",2,0],["وكتبوا إجازةً في الوَرَقِ","والمقصد الأسنى اصطيادُ الوَرِقِ",62,"ق",1,0],["وَكتاب أَحكمت آياته","عصمة اللَه لمن رام اِعتصاما",63,"م",2,0],["وَكَتَّمتُ حالي عَنِ الشامِتينَ","كَما كُتِمَ الشَيبُ تَحتَ الكَتَم",64,"م",1,0],["وَكُتبُهُ الكَتائِبُ الشُّهبُ إِذا","أَنشَأَها مُبتَدِهاً أَو مُحتَفِل",65,"ل",1,0],["وكتمت في الصدر الهوى","ولواعج الشوق المذيب",66,"ب",1,0],["وَكتمتُ عَن نَفسي حَديثَ غرامه","حذراً عليه ولَم أفُه بمصونِهِ",67,"ن",2,0],["وكتاب اللَه قد يفهمهم","لو تلوه بقلوب حضرت",68,"ت",1,0],["وكتيبةٍ تَطِسُ الحصَى مَلْمومةٍ","تُعْشى إياةَ الشّمسِ بالومَضان",69,"ن",1,0],["وكتابُ عصرِكَ مُذْ أَتَى أَبناءه","واللهُ ضَمَّنه عُلاكَ وعَنْوَنا",70,"ن",2,0],["وَكَتَمتُ حُبَّهُمُ وَكَتمي حُبَّهُم","لا بَل كَتَمتُ الحُبَّ عَن كِتماني",71,"ن",2,0],["وَكُتبٌ يَفيضُ بِأَرجائِها","يَمينُ الجَدا وَلِسانُ الجِدالِ",72,"ل",1,0],["وَكُتبُهُ تَحكي لَنا دارَهُ","فَكُلُّ مَن فيها بَناتُ الخَطا",73,"ط",2,1],["وَكِتابَكَ المَلعونُ في أَلفاظِهِ","ما يَدَّعي قَسراً لِغَيرِ أَبيهِ",74,"ه",1,1],["وكتابةٍ سوداءَ فيها أسهمٌ","يجري الندى منها وتجري بالرَّدى",75,"د",2,0],["وكتيبةٌ لمعت فأب","رق جَوُها وجرت فأرعَد",76,"د",1,0],["وكتَمتُ سِرّي عن نَباكَ مُغالِطاً","كيما أُواري النورَ بالظَلماءِ",77,"ا",2,0],["وكتاب إحياء لنا فتعلموا","وتفهموا ما قاله ثم اعملوا",78,"ل",3,0],["وكتاب الله والحق المنير","ثم طوبى للذي قلبه نوير",79,"ر",1,0],["وكَتَائبٌ خُضْرٌ تَظلّ كُماتُها","كالأُسْد في أجم القنا تَتَبَخْتَرُ",80,"ر",1,0],["وَكتمت حُبَّك وَهوَ نارٌ مِثلما","كتم الزِناد ثَواقِبَ النِيرانِ",81,"ن",1,0],["وَكَتيبَةٍ قَرأت مِنكَ فانفضَّ","ت كَما فَضَّت خِتام سِحائِهِ",82,"ا",3,0],["وكتابٍ منكَ فاجأنِي","كبشيرٍ جَاءَ بالظّفَرِ",83,"ر",1,1],["وكتْبك أمثال الشُّموس طوالع","فلا اللَّيل يغشاها إذ الشّكّ كاللَّيل",84,"ل",1,0],["وكتبٌ لدين الله أضحتْ مطالعاً","كما كانت الأَفلاك للشَّمس مطلعا",85,"ع",2,0],["وكتَابَةٌ لا تَرْتَضِى نَهْرَ الصَّفَا","رَقًّا ولا زَهْرَ البِطاحِ سُطُورا",86,"ر",2,0],["وكتابٍ صَغُرَتْ أَجزاؤُهُ","وَهُوَ قد حازَ الحديثَ الأَكْبَرَا",87,"ر",2,1],["وكتابَةٌ من حُسْنِ صُورَتِها","تُغْنِي عن التَنْقِيطِ والشَّكْلِ",88,"ل",1,0],["وكتائبٍ خطبَ الزمانُ خطوبها","فرمَتْ جوارحَه بفتْكِ جراحِه",89,"ح",2,0],["وكتائِبٌ لليُمْنِ يومَ رَحِيلِها","بالفتحِ فِي جَنَباتِها اسْتِهْلالُ",90,"ل",1,0],["وكتائِبٍ لَهِجَتْ بَطَيِّبِ ذِكْرِكُمْ","فلذيذُهُ عندَ الهياجِ شِعارُها",91,"ر",3,0],["وكَتَبْتُ منها لِلَّيالي مُصْحَفاً","تتلُوهُ أَلسِنَةُ الزَّمانِ الدَّائِبِ",92,"ب",1,0],["وكَتائِبُ الإِفْرَنج إِذ كادَتْكَ فِي","أَشياعِها والله عنكَ يكِيدُها",93,"د",3,0],["وكُتْبٌ تفضُّ الروضَ نَشرا ومنظرا","إذا فُضَّ من مَطْوِيِّهنَّ خِتامُ",94,"م",1,0],["وَكَتِ القِرافَ بحِجرِها","ووِكاؤُها زُنَّارها",95,"ر",3,0],["وكِتْمانُ السَّرائرِ عن حبيبٍ","بفَتْوى الحبِّ كِتْمانٌ حَرامُ",96,"م",1,0],["وكتبت أطراس الفلا بكتائب","أبداً يسير النصر تحت لوائها",97,"ا",3,0],["وكتمتُ لما ثوَّروا أسرارَهمْ","والبينُ فيه يُذاعُ بالأسرارِ",98,"ر",1,0],["وكَت