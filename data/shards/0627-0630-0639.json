{"poems":[[53,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[51,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[91,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[85,"طوقتك السحب بالمنن","https://www.aldiwan.net/poem7886.html","المديد"],[85,"أتى نبي الله يوما ثعلب","https://www.aldiwan.net/poem8019.html","الرجز"],[85,"أذعن للحسن عصي العنان","https://www.aldiwan.net/poem63009.html","السريع"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[74,"أما وخيال قد أطاف وسلما","https://www.aldiwan.net/poem13244.html","الطويل"],[105,"صفوا المواكب وامشوا حولها مرحا","https://www.aldiwan.net/poem43049.html","البسيط"],[81,"وداع قلب أزفا","https://www.aldiwan.net/poem61459.html","مجزوء الرجز"],[81,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85425","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43732","الرجز"]],"verses":[["أَذَعنا لَهُ سِرَّ الكَرى مِن عُيونِنا","وَسِرُّ العُلى بَينَ الجَوانِحِ يُحجَبُ",0,"ب",1,0],["أذْعَنَ المدْحُ له في شاعرٍ","يغْزُر المنطق فيه ويجودُ",1,"د",1,0],["أَذعَنَ القَلبُ طائِعاً","بَعدَ ذاكَ التَمَرُّدِ",2,"د",1,0],["إذ عنان العيش منطلق","بالصبا واللهو والددن",3,"ن",1,0],["إِذ عِفتُ في اِفتِراسِهِ الدَناءَه","فَلَم يَصِلهُ مِن يَدي مَساءَه",4,"ه",1,0],["أَذعَنَ لِلحُسنِ عَصِيُّ العِنان","وَحاوَلَت عَيناكَ أَمراً فَكان",5,"ن",1,1],["أَذعَنَ الناسُ وَالمُلوكُ إِلى ما","رَسَموا وَالعُقولُ وَالعُقَلاءُ",6,"ا",2,0],["أَذَعَنَ الناكِثونَ إِذ أَلقَتِ الحَر","بُ عَلَيهِم بِكَلكَلٍ وَجِرانِ",7,"ن",1,0],["أَذَعتُ بِهِم سِرَّ الصَباحِ وَإِنَّما","سَرَرتُ بِهِم لَيلَ السُرى فَتَبَسَّما",8,"م",2,0],["أَذعنتَ للقوم إذ قالوا مُفاوضةٌ","فما استقامَ لنا أمرٌ ولا صَلُحا",9,"ح",2,0],["أَذعَنتُ إِذ جارَ وَلا","يُحمَلُ حُكمُ الضُعَفا",10,"ف",2,0],["إِذ عَصرُكُم كُلُّ الزَمانِ وَأُفقُكُم","كُلُّ البِلادِ وَشَخصُكُم كُلُّ الوَرى",11,"ر",2,0],["إذ عيْشُنَا في مثْلِ دولَةِ جَعفَرٍ","والعَدْلُ فيها ضاحكٌ والنّائل",12,"ل",1,0],["إذ عمَّه كوباء جارفٍ رهَجٌ","ما سارَ عَن بلد إلا أَتى بلدا",13,"د",2,0],["إِذْ عَادَ بِالدَّهْنِ وَالصَّقْ","لِ صُورةً جَوْفَاءَ",14,"ا",2,0],["إِذ عَزَّ ثَأرُ مَن ثَنى","كُلُّ صَميمٍ وَشَظا",15,"ظ",2,0]]}