{"poems":[[53,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[51,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[91,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[85,"طوقتك السحب بالمنن","https://www.aldiwan.net/poem7886.html","المديد"],[85,"أتى نبي الله يوما ثعلب","https://www.aldiwan.net/poem8019.html","الرجز"],[85,"أذعن للحسن عصي العنان","https://www.aldiwan.net/poem63009.html","السريع"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[74,"أما وخيال قد أطاف وسلما","https://www.aldiwan.net/poem13244.html","الطويل"],[105,"صفوا المواكب وامشوا حولها مرحا","https://www.aldiwan.net/poem43049.html","البسيط"],[81,"وداع قلب أزفا","https://www.aldiwan.net/poem61459.html","مجزوء الرجز"],[81,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[75,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85425","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43732","الرجز"],[118,"أعيذك أن تمنى بتبريح لوعة","https://www.aldiwan.net/poem49306.html","الطويل"],[130,"أني على هيمى مى تلحاني","https://www.aldiwan.net/poem54712.html","البسيط"],[141,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[141,"إن العلى المعيي الملوك طلابها","https://www.aldiwan.net/poem11732.html","الكامل"],[158,"سم سمة تحمد آثارها","https://www.aldiwan.net/poem59021.html","السريع"],[197,"مكانك يا بدر وإن كنت واشيا","https://www.aldiwan.net/poem45229.html","الطويل"],[259,"طرف بكى وفؤاد أن من وصب","https://www.aldiwan.net/poem38369.html","البسيط"],[283,"ظهرت محاسن ذا الزمان فقابلت","https://www.aldiwan.net/poem39432.html","الكامل"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[362,"اليوم عاد رجائي مورق العود","https://www.aldiwan.net/poem60929.html","البسيط"],[374,"هبطت إليك من المحل الأرفع","https://www.aldiwan.net/poem59343.html","الكامل"],[390,"لاح لعينيك الطلل","https://www.aldiwan.net/poem53681.html","مجزوء الرجز"],[426,"يرق بدا ام ثغرك الجوهر","https://www.aldiwan.net/poem41418.html","السريع"],[488,"إما ترى رأسي أزرى به","https://www.aldiwan.net/poem658.html",""],[498,"يا بارقا قد تلوى","https://www.aldiwan.net/poem37978.html","المجتث"],[512,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["أَذَعنا لَهُ سِرَّ الكَرى مِن عُيونِنا","وَسِرُّ العُلى بَينَ الجَوانِحِ يُحجَبُ",0,"ب",1,0],["أذْعَنَ المدْحُ له في شاعرٍ","يغْزُر المنطق فيه ويجودُ",1,"د",1,0],["أَذعَنَ القَلبُ طائِعاً","بَعدَ ذاكَ التَمَرُّدِ",2,"د",1,0],["إذ عنان العيش منطلق","بالصبا واللهو والددن",3,"ن",1,0],["إِذ عِفتُ في اِفتِراسِهِ الدَناءَه","فَلَم يَصِلهُ مِن يَدي مَساءَه",4,"ه",1,0],["أَذعَنَ لِلحُسنِ عَصِيُّ العِنان","وَحاوَلَت عَيناكَ أَمراً فَكان",5,"ن",1,1],["أَذعَنَ الناسُ وَالمُلوكُ إِلى ما","رَسَموا وَالعُقولُ وَالعُقَلاءُ",6,"ا",2,0],["أَذَعَنَ الناكِثونَ إِذ أَلقَتِ الحَر","بُ عَلَيهِم بِكَلكَلٍ وَجِرانِ",7,"ن",1,0],["أَذَعتُ بِهِم سِرَّ الصَباحِ وَإِنَّما","سَرَرتُ بِهِم لَيلَ السُرى فَتَبَسَّما",8,"م",2,0],["أَذعنتَ للقوم إذ قالوا مُفاوضةٌ","فما استقامَ لنا أمرٌ ولا صَلُحا",9,"ح",2,0],["أَذعَنتُ إِذ جارَ وَلا","يُحمَلُ حُكمُ الضُعَفا",10,"ف",2,0],["إِذ عَصرُكُم كُلُّ الزَمانِ وَأُفقُكُم","كُلُّ البِلادِ وَشَخصُكُم كُلُّ الوَرى",11,"ر",2,0],["إذ عيْشُنَا في مثْلِ دولَةِ جَعفَرٍ","والعَدْلُ فيها ضاحكٌ والنّائل",12,"ل",1,0],["إذ عمَّه كوباء جارفٍ رهَجٌ","ما سارَ عَن بلد إلا أَتى بلدا",13,"د",2,0],["إِذْ عَادَ بِالدَّهْنِ وَالصَّقْ","لِ صُورةً جَوْفَاءَ",14,"ا",2,0],["إِذ عَزَّ ثَأرُ مَن ثَنى","كُلُّ صَميمٍ وَشَظا",15,"ظ",2,0],["أذعت لنا سرّاً شقينا بمثله","زماناً وفي غصن الشبيبة لين",16,"ن",1,0],["إِذ عَنَّ مِن حَدَثَانِ الدَّهرِ دَاهِيَةٌ","عَنًّا أقَرَّ مُعَانِيهِم بِإذعَانِ",17,"ن",1,0],["إِذ عَمَّ كُلَّ فَصيحٍ مِدرَهٍ خَرَسٌ","وَلِلظُبى وَالعَوالي أَلسُنٌ ذُرُبُ",18,"ب",1,0],["إِذعَر جُيوشَهُمُ بِجَيشِكَ إِنَّها","نَعَمٌ وَأَطرافُ الوَشيجِ ذِئابُها",19,"ب",3,0],["إذ عد مهجا حولا معجزا","فقل لأجل الفصل إذ عدمه",20,"م",2,0],["أذِع حسنَها في كلِّ أفقٍ تنيرُهُ","وأحصِ علينا ما حيينا اللياليا",21,"ي",2,0],["إذ عنك يقصر ذو حظ وذو خطر","وفيك يعجز ذو خط وذو خطب",22,"ب",1,0],["اذعاد تشيد المدارس قربة","في ظل سلطان الورى عبدالحميد",23,"د",1,0],["إِذعانُهم لجاجُ","مَعينُهم أُجاجُ",24,"ج",1,0],["إِذ عادَ بِالطائِرِ المَيمونِ مُبتَهِجاً","يَختالُ ما بَينَ تَمكينٍ وَتَأييدِ",25,"د",1,0],["إذ عاقها الشَّرَكُ الكثيف وصدَّها ال","مَيلُ الضعيف عن العلاء الأرفع",26,"ع",1,0],["اِذ عَجَزَت بِقُربِها","وَبُعدِها الشُمُّ الأُوَل",27,"ل",1,0],["إذ عمّروا برج الرؤوس الذي","في كل صقع ذكره يشهد",28,"د",1,0],["إِذ عايَنوا بِالخَبثِ رَجراجَةً","تَمشي اِزدِلافاً كَازدِلافِ العَروس",29,"س",1,0],["أذَعْتُ سَيْلَ عُيوني","لهمْ وهَجْري أذاعوا",30,"ع",3,0],["إذ عودُنا رطْبٌ وموردُ لهوِنا","عذبٌ وروضُ العيش خِصبٌ مؤْنِقُ",31,"ق",1,0],["إذ علما أنهما لو فعلا","كمثل ما فعله لقتلا",32,"ل",2,0]]}