{"poems":[[55,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[53,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[93,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[87,"طوقتك السحب بالمنن","https://www.aldiwan.net/poem7886.html","المديد"],[87,"أتى نبي الله يوما ثعلب","https://www.aldiwan.net/poem8019.html","الرجز"],[87,"أذعن للحسن عصي العنان","https://www.aldiwan.net/poem63009.html","السريع"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[47,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[76,"أما وخيال قد أطاف وسلما","https://www.aldiwan.net/poem13244.html","الطويل"],[107,"صفوا المواكب وامشوا حولها مرحا","https://www.aldiwan.net/poem43049.html","البسيط"],[83,"وداع قلب أزفا","https://www.aldiwan.net/poem61459.html","مجزوء الرجز"],[83,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[77,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85425","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43732","الرجز"],[124,"أعيذك أن تمنى بتبريح لوعة","https://www.aldiwan.net/poem49306.html","الطويل"],[136,"أني على هيمى مى تلحاني","https://www.aldiwan.net/poem54712.html","البسيط"],[147,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[147,"إن العلى المعيي الملوك طلابها","https://www.aldiwan.net/poem11732.html","الكامل"],[164,"سم سمة تحمد آثارها","https://www.aldiwan.net/poem59021.html","السريع"],[203,"مكانك يا بدر وإن كنت واشيا","https://www.aldiwan.net/poem45229.html","الطويل"],[266,"طرف بكى وفؤاد أن من وصب","https://www.aldiwan.net/poem38369.html","البسيط"],[290,"ظهرت محاسن ذا الزمان فقابلت","https://www.aldiwan.net/poem39432.html","الكامل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[369,"اليوم عاد رجائي مورق العود","https://www.aldiwan.net/poem60929.html","البسيط"],[382,"هبطت إليك من المحل الأرفع","https://www.aldiwan.net/poem59343.html","الكامل"],[398,"لاح لعينيك الطلل","https://www.aldiwan.net/poem53681.html","مجزوء الرجز"],[435,"يرق بدا ام ثغرك الجوهر","https://www.aldiwan.net/poem41418.html","السريع"],[495,"إما ترى رأسي أزرى به","https://www.aldiwan.net/poem658.html",""],[505,"يا بارقا قد تلوى","https://www.aldiwan.net/poem37978.html","المجتث"],[519,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104024","الرمل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146215","المديد"],[826,"","https://poetry.dctabudhabi.ae/diwan/poem/140227",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38477","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77671","الرجز"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105455","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46539","الرجز"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19990","الرمل"],[1420,"","https://poetry.dctabudhabi.ae/diwan/poem/100692","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95574","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79965","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66237","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118315","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123160","المتدارك"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113738","الكامل"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33846","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109453","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93583","الرمل"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17735","البسيط"],[2553,"","https://poetry.dctabudhabi.ae/diwan/poem/12036","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87331","الرجز"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116493","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94090","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94023","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94244","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94276","المديد"],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113679","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87572","الكامل"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203546","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62868","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138563",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109899","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70034","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77156","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77032","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77154","الطويل"],[3998,"","https://poetry.dctabudhabi.ae/diwan/poem/34824","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54498","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94584","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57980","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33496","المنسرح"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72748","السريع"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67449","الطويل"],[4984,"كريم الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=199233",""],[5055,"( م . س . س )","https://www.poetsgate.com/ViewPoem.aspx?id=104296",""],[5376,"قفْ ودِّعِ الكفرَ فالإسلامُ في نهم","https://www.poetsgate.com/ViewPoem.aspx?id=188508",""],[5376,"يا قاصدَ البيتِ قفْ للهِ وابتهلِ","https://www.poetsgate.com/ViewPoem.aspx?id=205906",""],[5431,"رقصة النار ...","https://www.poetsgate.com/ViewPoem.aspx?id=204746",""],[5582,"أَنَّى يَكُونُ مِنَ الغَرامِ جُحُودُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186884",""],[5786,"يا بارقاً لاحَ من أكتاف كوفانِ","https://www.poetsgate.com/ViewPoem.aspx?id=50655",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["أَذَعنا لَهُ سِرَّ الكَرى مِن عُيونِنا","وَسِرُّ العُلى بَينَ الجَوانِحِ يُحجَبُ",0,"ب",1,0],["أذْعَنَ المدْحُ له في شاعرٍ","يغْزُر المنطق فيه ويجودُ",1,"د",1,0],["أَذعَنَ القَلبُ طائِعاً","بَعدَ ذاكَ التَمَرُّدِ",2,"د",1,0],["إذ عنان العيش منطلق","بالصبا واللهو والددن",3,"ن",1,0],["إِذ عِفتُ في اِفتِراسِهِ الدَناءَه","فَلَم يَصِلهُ مِن يَدي مَساءَه",4,"ه",1,0],["أَذعَنَ لِلحُسنِ عَصِيُّ العِنان","وَحاوَلَت عَيناكَ أَمراً فَكان",5,"ن",1,1],["أَذعَنَ الناسُ وَالمُلوكُ إِلى ما","رَسَموا وَالعُقولُ وَالعُقَلاءُ",6,"ا",2,0],["أَذَعَنَ الناكِثونَ إِذ أَلقَتِ الحَر","بُ عَلَيهِم بِكَلكَلٍ وَجِرانِ",7,"ن",1,0],["أَذَعتُ بِهِم سِرَّ الصَباحِ وَإِنَّما","سَرَرتُ بِهِم لَيلَ السُرى فَتَبَسَّما",8,"م",2,0],["أَذعنتَ للقوم إذ قالوا مُفاوضةٌ","فما استقامَ لنا أمرٌ ولا صَلُحا",9,"ح",2,0],["أَذعَنتُ إِذ جارَ وَلا","يُحمَلُ حُكمُ الضُعَفا",10,"ف",2,0],["إِذ عَصرُكُم كُلُّ الزَمانِ وَأُفقُكُم","كُلُّ البِلادِ وَشَخصُكُم كُلُّ الوَرى",11,"ر",2,0],["إذ عيْشُنَا في مثْلِ دولَةِ جَعفَرٍ","والعَدْلُ فيها ضاحكٌ والنّائل",12,"ل",1,0],["إذ عمَّه كوباء جارفٍ رهَجٌ","ما سارَ عَن بلد إلا أَتى بلدا",13,"د",2,0],["إِذْ عَادَ بِالدَّهْنِ وَالصَّقْ","لِ صُورةً جَوْفَاءَ",14,"ا",2,0],["إِذ عَزَّ ثَأرُ مَن ثَنى","كُلُّ صَميمٍ وَشَظا",15,"ظ",2,0],["أذعت لنا سرّاً شقينا بمثله","زماناً وفي غصن الشبيبة لين",16,"ن",1,0],["إِذ عَنَّ مِن حَدَثَانِ الدَّهرِ دَاهِيَةٌ","عَنًّا أقَرَّ مُعَانِيهِم بِإذعَانِ",17,"ن",1,0],["إِذ عَمَّ كُلَّ فَصيحٍ مِدرَهٍ خَرَسٌ","وَلِلظُبى وَالعَوالي أَلسُنٌ ذُرُبُ",18,"ب",1,0],["إِذعَر جُيوشَهُمُ بِجَيشِكَ إِنَّها","نَعَمٌ وَأَطرافُ الوَشيجِ ذِئابُها",19,"ب",3,0],["إذ عد مهجا حولا معجزا","فقل لأجل الفصل إذ عدمه",20,"م",2,0],["أذِع حسنَها في كلِّ أفقٍ تنيرُهُ","وأحصِ علينا ما حيينا اللياليا",21,"ي",2,0],["إذ عنك يقصر ذو حظ وذو خطر","وفيك يعجز ذو خط وذو خطب",22,"ب",1,0],["اذعاد تشيد المدارس قربة","في ظل سلطان الورى عبدالحميد",23,"د",1,0],["إِذعانُهم لجاجُ","مَعينُهم أُجاجُ",24,"ج",1,0],["إِذ عادَ بِالطائِرِ المَيمونِ مُبتَهِجاً","يَختالُ ما بَينَ تَمكينٍ وَتَأييدِ",25,"د",1,0],["إذ عاقها الشَّرَكُ الكثيف وصدَّها ال","مَيلُ الضعيف عن العلاء الأرفع",26,"ع",1,0],["اِذ عَجَزَت بِقُربِها","وَبُعدِها الشُمُّ الأُوَل",27,"ل",1,0],["إذ عمّروا برج الرؤوس الذي","في كل صقع ذكره يشهد",28,"د",1,0],["إِذ عايَنوا بِالخَبثِ رَجراجَةً","تَمشي اِزدِلافاً كَازدِلافِ العَروس",29,"س",1,0],["أذَعْتُ سَيْلَ عُيوني","لهمْ وهَجْري أذاعوا",30,"ع",3,0],["إذ عودُنا رطْبٌ وموردُ لهوِنا","عذبٌ وروضُ العيش خِصبٌ مؤْنِقُ",31,"ق",1,0],["إذ علما أنهما لو فعلا","كمثل ما فعله لقتلا",32,"ل",2,0],["إذ علا القيّمُ رأ","سَ البثرَ ليِّ بدُرّه",33,"ر",2,0],["إذ عدمت العدل منك وإذ","أنا فيك الدّهر معدول",34,"ل",1,0],["إذ عرضنا اليومَ للأضياف في","حلبةِ الميدانِ جُرْداً خيلَنا",35,"ن",2,0],["إِذ عَلى ظَهرِها الذّوائب ماجَت","وَهيَ كَاللّيلِ إِنْ تَرُمْ تَشبيها",36,"ي",3,1],["إِذ عاين القطّ يسل مِنهُ","لا رَضِيَ اللَهُ تَعالى عَنهُ",37,"ه",1,0],["إذ عتقت أبدت لنا نشوةً","سلافة العصر بمر العصور",38,"ر",1,0],["إِذ عِنده الأَسرار","أجمعُ وَالأَخبار",39,"ر",1,0],["إِذ عُيونُ الدارِ صورٌ","وَإِذا الجيرَةُ خيرُ",40,"ر",1,0],["إذ عاقها الشرك الكثيف وصدّها","قفص عن الأوج الفسيح الأربع",41,"ع",1,0],["أذعن الدهر للمقول قديما","لا صديقٌ لا الغولُ لا العنقاءُ",42,"ا",2,0],["إذ على تقوى من الله الصمد","أُسِّس البنيانُ منها وَوطد",43,"د",1,0],["إذ عندي القاموس بعض هباته","فمتى سوى القاموس يشملُ رفده",44,"د",2,0],["إذ عدتُ متشحاً بخير عباءةٍ","من خير نُسباً لأصحاب العبا",45,"ب",2,0],["اذ عندهم ان النهاية نجحها","بطريقهم انتاج حسن بداية",46,"ا",3,0],["إذ عارضُه من سالفه","قد جُنّ فَسُلسل بالشعر",47,"ر",1,0],["إذ عادَةُ المُشتاقِ يَبكي دائماً","إن يَنعَموا بالوَصلِ أو إن يَهجُروا",48,"ر",3,0],["إِذ عَيشُنا مُقتَبِلٌ","وَشَملُنا مُؤتَلِفُ",49,"ف",1,0],["إذ عندهم لها اعتبارٌ زائدُ","وقدرها تسمو به الموائد",50,"د",1,0],["إذ عِندَ نَفخِ الصُّورِ لاَ يَبقَى امرُؤٌ","فِي الأرضِ حَيًّا قَطُّ بِالبُرهَانِ",51,"ن",1,0],["إذ عَطَّلُوا الرَّحمَنَ من أوصافِهِ","وَالعَرشَ أخلَوهُ مِنَ الرَّحمَنِ",51,"ن",1,0],["إِذ عنت فيكُم رِجال","لَيسَ يَألون عِنادا",52,"د",2,0],["إِذ عَرَّضَت لي أَقوالاً لِتَقصِدَني","وَالقَلبُ مِن حَذَرِ الهِجرانِ مَقصودُ",53,"د",1,0],["إِذ عابَهُ عائِبٌ يَوماً فَقالَ لَهُ","دَمِّث لِجَنبِكَ قَبلَ اللَيلِ مُضطَجَعا",54,"ع",2,0],["إذ عَمِلَ الناسُ جميعاً فيهَا","من برِّ هُرموزٍ وَمَا يليهَا",55,"ه",2,0],["إذ عليه تكاد تنفطر السما","أسفا وتتلى سورة الأحقاف",56,"ف",1,0],["إذ عارضاه بالنبات أقبلا","وأحدثا في خده وبالا",57,"ل",2,0],["إذ عطر الأكوان طيب نشره","وهو على سر المثاني منطوي",58,"و",2,0],["إذ علا مجده على كل مجد","وحلاه باهت بحلية فضله",59,"ل",2,0],["إذ علا تفريطه وغدا","قائلا يا حسرتاه على",60,"ل",2,0],["إذ عرى نرجس العيون ذبولٌ","وغدا الغصن ليس بالميَّادِ",61,"د",1,0],["اذ عاقهُ عنهُ فخفَّ بقدر ما","قد عاقهُ فبقي هنالك فضلهُ",62,"ل",2,0],["إذ عجزوا فيه عن المعارضه","ولم يرو بابا الى المناقضه",63,"ه",1,0],["اذْ عدا دَاحِسٌ لحى بَغِيضٍ","عَدْوَةً أوقعتهم في التَّعَادي",64,"د",2,0],["إذ عرته ظلماتٌ بعضها","فوق بعضٍ كدن يحجبن الشعاعا",65,"ع",2,0],["إذ عَصَى اللَهَ عَصَتهُ فاغتدَى","في نِزاعٍ دائِمٍ مَع نَصَبِ",66,"ب",1,0],["إذ عن سوامك قد قصلتك لم","تنفت فردت وراءك الهضبا",67,"ب",2,0],["إِذ عاشَ في بردِ العَفافِ مُؤرخاً","أَضحى بِمَجدٍ لابِساً بيض الحلل",68,"ل",1,0],["إِذ عيشنا في القبلَتين عَلى الصَفا","وَالحَي تَمرح بِالهَنا فِتيانه",69,"ه",1,0],["اِذ عيشُنا رَغد بِاِخوان الصَفا","وَعَلى ال