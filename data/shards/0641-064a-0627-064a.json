{"poems":[[3,"بين العقيق وبين بُرقة ثهمد","https://www.aldiwan.net/poem152.html",""],[93,"إهنأ بما أهدى المليك","https://www.aldiwan.net/poem9675.html","عموديه"],[93,"قف خاشعاً بضريح عز الدين","https://www.aldiwan.net/poem11214.html","الكامل"],[93,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[51,"يا خالد ابن الخالدات","https://www.aldiwan.net/poem65801.html","مجزوء الكامل"],[51,"يا هل تعود سوالف الأزمان","https://www.aldiwan.net/poem66471.html","الكامل"],[89,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[45,"في أي حين رأيت مولاتي","https://www.aldiwan.net/poem62656.html","المنسرح"],[97,"إنعام يا روح الندى وأنسه","https://www.aldiwan.net/poem24343.html","الكامل"],[97,"في أي روض من رياضك أمرح","https://www.aldiwan.net/poem24865.html","الكامل"],[44,"أعيدي النوح معولة أعيدي","https://www.aldiwan.net/poem30318.html","الوافر"],[44,"غدا الملك معمور الحمى والمنازل","https://www.aldiwan.net/poem30375.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42577","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54963","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54831","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54708","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54633","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54978","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54293","الطويل"],[87,"سَمَا الْمُلْكُ مُخْتَالاً بِمَا أَنْتَ فَاعِلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=22587",""],[87,"سل الفلك الدوار إن كان ينطق","https://www.poetsgate.com/ViewPoem.aspx?id=18212",""],[106,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[100,"ذهول الذهول","https://www.poetsgate.com/ViewPoem.aspx?id=50391",""],[116,"رأيت كأن خدك فوق زندي","https://www.aldiwan.net/poem40483.html","عموديه"],[143,"ماذا يعيب رجال الحى في النادي","https://www.aldiwan.net/poem58426.html","البسيط"],[144,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[170,"عني إليك حوادث الأيام","https://www.aldiwan.net/poem1669.html",""],[179,"الطريد","https://www.aldiwan.net/poem50688.html","الكامل"],[227,"مأساة البدارى","https://www.aldiwan.net/poem24222.html","عموديه"],[306,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[329,"هات كاسك واشرب واسقيني","https://www.aldiwan.net/poem54909.html","عموديه"],[358,"يا من يخط كتاب الله وهو له","https://www.aldiwan.net/poem4170.html","البسيط"],[367,"بناني فيكم مثل يحيى بن طالب","https://www.aldiwan.net/poem17326.html","الطويل"],[367,"لبثت على باب الأمير معللا","https://www.aldiwan.net/poem17384.html","الكامل"],[430,"وافى يطوف بشمس كاسه","https://www.aldiwan.net/poem40239.html","مجزوء الكامل"],[433,"صدرنا وقد نادى السماح بنا ردوا","https://www.aldiwan.net/poem12450.html","الطويل"],[459,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[465,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[480,"قل ما بدا لك تلق السمع صاغيه","https://www.aldiwan.net/poem37039.html","البسيط"],[501,"يا لفتة الظبي من غربي لعلع في","https://www.aldiwan.net/poem38060.html","البسيط"],[515,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[539,"عبد ببابك خده قد عفرا","https://www.aldiwan.net/poem48191.html","عموديه"],[552,"عن الخيال لنا ليالي الأبرق","https://www.aldiwan.net/poem47353.html","الكامل"],[559,"لا تأخذ الخلاق يا قوم","https://www.aldiwan.net/poem34085.html","أحذ الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"هواي لمحبوبي الأول","https://www.aldiwan.net/poem3036.html","المتقارب"]],"verses":[["في أَيمَنِ العَلَمينِ دَرسُ مَعالِمٍ","أَوهى بِها جَلَدي وَبانَ تَجَلُّدي",0,"د",2,0],["فِي أَيِّ مَعْنَىً لَمْ تَكُنْ","أَهْلاً لِعَالِيَةِ الرُّتَبْ",1,"ب",1,0],["فِي أَيِّ نَجْمٍ لِلْهِدَايَةِ زَاهِرٍ","فُجِعُوا وَرُكْنٍ لِلْفَخَارِ رَكِينِ",2,"ن",1,0],["فِي أي جِوٍّ بِالأَسَى مُفْعَمِ","يَتَّصِلُ المَأْتَمُ بِالمَأْتَمِ",3,"م",1,1],["في أيّما مُتورَّدٍ","دلّاكَ يا مغرورُ دحْضُك",4,"ك",1,0],["في أيِّها جَارَى تقدَّم شأوُه","فحَوى الرهانَ أمام كُلِّ عِنان",5,"ن",1,0],["في أي قبر انت يا","مجد العروبة مسبطر",6,"ر",1,0],["في أَيِّ حينٍ رَأَيتُ مَولاتي","في خَيرِ حينٍ وَخَيرِ ميقاتِ",7,"ت",1,1],["في أيّ معنًى من معانيكِ التي","تَسبِي النهى إبداع هذا الخاطرِ",8,"ر",1,0],["في أي روضٍ من رياضك أمرح","وبأيّ آلاءٍ لَدَيكِ أُسَبِّح",9,"ح",1,1],["فَيا يَومَ الثُلاثاءِ اِصطَبَحنا","غَداةً مِنكَ هائِلَةَ الوُرودِ",10,"د",1,0],["فَيَأَيُّها النُوّامُ عَن رَيِّقِ الهُدى","وَقَد جادَكُم مِن ديمَةٍ بَعدَ وابِلِ",11,"ل",1,0],["فَيَأَيُّهَا النُّوَّامُ والشَّوْقُ عَازِرٌ","أَلا أَحَدٌ يَشْرِي بِغَفْوَتِهِ السُّهْدَا",12,"د",2,0],["فِي أَيِّ عَصرٍ كانَ عِرْفَانهَا","أَوْ خبْرُهَا مَا هُوَ فِي العَصْرِ",13,"ر",1,0],["فِي أَيِّ مِصْبَاحٍ كَزَاهِرِ وَجْهِهَا","تَتَنَوَّرُ الأَلْبَابُ ضَوْءَ مَنَارِ",14,"ر",1,0],["في أَيِّ حَفْلٍ كَأَبْهَى","مَا نُظِّمَ الدُرُّ عقْدَا",15,"د",2,0],["فِي أَيِّ وَقْتٍ لَمْ يَطُلْ وَكَأَنَّهُ","عُمْرٌ طَوِيلُ الهَمِّ وَالأَوْصَابِ",16,"ب",1,0],["فِي أَيِّ قُطْرٍ عَاشَ أَمْثالُكُمْ","فَلَيْسَ فِي البَأْسَاءِ مِنْ بِأْسِ",17,"س",1,0],["فيأيُّها الناعِي إذا قُلْتَ فاتَّئِدْ","فما مُخطىءٌ في قولهِ كمُصيب",18,"ب",1,0],["فَيَأَيُّهَا الصَّادِي إِلَى الْعَدْلَ وَالنَّدَى","هلمَّ º فذا بحرٌ لهُ البحرُ ساحلُ",19,"ل",1,0],["فَيَأَيُّهَا السَّارِي عَلَى غَيْرٍ هُدْيَة ٍ","رُويداً ، فإنَّ البابَ دُونَكَ مُغلَقُ",20,"ق",1,0],["فيأيها الليثُ المكشر للورى","حنانيك إما الانصراف أو الوثب",21,"ب",1,0],["في أي زاه من تهاويلها ؟","يرسو ، وفي أي اخضرار يجول ؟",22,"ل",1,0],["فيا يقظان خذ خبرا جديدا","يؤمل منك احسانا قديمه",23,"م",2,0],["في أيِّما جانبٍ من حزمهِ نظروا","لم يجدوا مطلعا فيه لأَفنادِ",24,"د",1,0],["في أَيِّ يَومِ نَزالٍ حارَبوكَ فَما","دارَت كُؤوسُ المَنايا فيهِمُ نُخُبا",25,"ب",2,0],["في أَيِّ يَومٍ لَم نُصَب بِمُتَوَّجٍ","ضَخمِ الدَسيعَةِ صادِقِ الإِقدامِ",26,"م",1,0],["في \"أيْنِهِ\"أرْسى الأسى إيوانَهُ","في \"آنِهِ\" حَشَدَ الأوانُ لهُ العَنا",27,"ن",2,0],["في أيما بلد نعيش ؟ وأيما","عهد يمر على الكنانة مظلم ؟",28,"م",1,0],["فَيا يوسفيّ الملك والعفو جُد لنا","بِقولك لا تثريب واِجزل لنا الوهبا",29,"ب",2,0],["في أيديّه","أرويها بحبّي وأحلامي",30,"ي",1,0],["في أيِّ آيَاتِهِ أَلفَيتَ سَفكَ دَمِي","حلا بلا دِيَةٍ تُرضِي ولا ثَارِ",31,"ر",1,0],["فَيَأَيُّها الغَيثُ الَّذي التُربُ ضَيفُهُ","فَيُصبح مِن زَهرٍ وَيُغبَقُ مِن وَبلِ",32,"ل",1,0],["فَيَأَيَّها الكَهفُ الَّذي قَد رَجَوتُهُ","لَقَد نِمتَ عَنّى مِثلَ نَومِ أَهلِهِ",33,"ه",1,0],["في أي فنٍ شئتهُ","فكأنهُ باني أساسه",34,"س",2,0],["فيا ياسراً نلنا به الفضل ياسراً","لنا ووجدنا منه ما ليس يوجَدُ",35,"د",1,0],["في أيّ بيتٍ شئتَ من","ها قلتَ ذا سيَّارُها",36,"ر",3,0],["في أي طوقٍ من صلاتك لم ترحْ","وبأي قيدٍ كرامةٍ بم ترسف",37,"ف",1,0],["في أيّ قطرٍ نازحٍ لم تهمِ جد","واهُ وبارح سخطهِ لم تعصف",37,"ف",1,0],["في أي بيت ترى الإبداع دعمه","ما كان أشرفه بيتا لبانيه",38,"ي",2,0],["في أَيمنِ الجِزْعِ أَحبابٌ وَلِعْتُ بهم","حَطَطْتُ في بابِهم يا ظبيُ راحِلَتي",39,"ت",2,0],["في آية التطهير قد دخلوا ولو","سبقوا لضمَّهُم العَبا في الآلِ",40,"ل",1,0],["في أيٍّ كَسرٍ لم تَكُن لِىَ جابراً","وبأيِّ كَربٍ لم تَكُن لي مُؤَزِّرا",41,"ر",2,0],["في أيّ شِعْبٍ من شعوبِ مُرادهمْ","حتّى أُتاهِمَ لم أخِبَّ وأعنِقِ",42,"ق",1,0],["في آية الكرسيْ لنا عبرٌ","منه كتابٌ جاء مرقوم",43,"م",1,0],["في آية فيه فقد سلمتم","إلى النبي كل ما جهلتم",44,"م",1,0],["فيأَيُّها الملِك المرْتَقِي","ويأَيُّها الملِكُ المعْتَلي",45,"ل",2,0]]}