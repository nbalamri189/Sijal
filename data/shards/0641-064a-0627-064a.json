92,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5362,"يا قاتلي بسيف هجرانه","https://www.poetsgate.com/ViewPoem.aspx?id=170350",""],[5409,"في أي وادٍ رحت يا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=155373",""],[5425,"نَورَسَةُ الهَور","https://www.poetsgate.com/ViewPoem.aspx?id=198930",""],[5431,"كلّي دموعٌ والفرات صلاتي","https://www.poetsgate.com/ViewPoem.aspx?id=186984",""],[5431,"مادمت بالأحياء مشغولا","https://www.poetsgate.com/ViewPoem.aspx?id=198405",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5533,"رَغْمَ الجِراح","https://www.poetsgate.com/ViewPoem.aspx?id=184051",""],[5545,"أسرج خيول الراحلين","https://www.poetsgate.com/ViewPoem.aspx?id=185707",""],[5690,"عصرٌ على الإعصار فاق وأزهر","https://www.poetsgate.com/ViewPoem.aspx?id=172158",""],[5720,"يا أيها الشبلُ *","https://www.poetsgate.com/ViewPoem.aspx?id=199718",""],[5721,"الرقص على حبال الموت","https://www.poetsgate.com/ViewPoem.aspx?id=214687",""],[5725,"راهبة","https://www.poetsgate.com/ViewPoem.aspx?id=197099",""],[5725,"الطف في بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=207110",""],[5829,"اليرموك في ذكرى بدء التحرير","https://www.poetsgate.com/ViewPoem.aspx?id=204254",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[5956,"بأي حق؟","https://www.poetsgate.com/ViewPoem.aspx?id=202503",""],[5997,"الليلة الدلماء","https://www.poetsgate.com/ViewPoem.aspx?id=214293",""],[6027,"مشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=187270",""],[6068,"في أي فلب أسكن -14-","https://www.poetsgate.com/ViewPoem.aspx?id=175866",""],[6108,"قبل العاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=192394",""],[6115,"اذا كان داعش دولة الحق والأسلام","https://www.poetsgate.com/ViewPoem.aspx?id=181802",""],[6322,"احتِرَاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82626&r=&rc=7",""]],"verses":[["في أَيمَنِ العَلَمينِ دَرسُ مَعالِمٍ","أَوهى بِها جَلَدي وَبانَ تَجَلُّدي",0,"د",2,0],["فِي أَيِّ مَعْنَىً لَمْ تَكُنْ","أَهْلاً لِعَالِيَةِ الرُّتَبْ",1,"ب",1,0],["فِي أَيِّ نَجْمٍ لِلْهِدَايَةِ زَاهِرٍ","فُجِعُوا وَرُكْنٍ لِلْفَخَارِ رَكِينِ",2,"ن",1,0],["فِي أي جِوٍّ بِالأَسَى مُفْعَمِ","يَتَّصِلُ المَأْتَمُ بِالمَأْتَمِ",3,"م",1,1],["في أيّما مُتورَّدٍ","دلّاكَ يا مغرورُ دحْضُك",4,"ك",1,0],["في أيِّها جَارَى تقدَّم شأوُه","فحَوى الرهانَ أمام كُلِّ عِنان",5,"ن",1,0],["في أي قبر انت يا","مجد العروبة مسبطر",6,"ر",1,0],["في أَيِّ حينٍ رَأَيتُ مَولاتي","في خَيرِ حينٍ وَخَيرِ ميقاتِ",7,"ت",1,1],["في أيّ معنًى من معانيكِ التي","تَسبِي النهى إبداع هذا الخاطرِ",8,"ر",1,0],["في أي روضٍ من رياضك أمرح","وبأيّ آلاءٍ لَدَيكِ أُسَبِّح",9,"ح",1,1],["فَيا يَومَ الثُلاثاءِ اِصطَبَحنا","غَداةً مِنكَ هائِلَةَ الوُرودِ",10,"د",1,0],["فَيَأَيُّها النُوّامُ عَن رَيِّقِ الهُدى","وَقَد جادَكُم مِن ديمَةٍ بَعدَ وابِلِ",11,"ل",1,0],["فَيَأَيُّهَا النُّوَّامُ والشَّوْقُ عَازِرٌ","أَلا أَحَدٌ يَشْرِي بِغَفْوَتِهِ السُّهْدَا",12,"د",2,0],["فِي أَيِّ عَصرٍ كانَ عِرْفَانهَا","أَوْ خبْرُهَا مَا هُوَ فِي العَصْرِ",13,"ر",1,0],["فِي أَيِّ مِصْبَاحٍ كَزَاهِرِ وَجْهِهَا","تَتَنَوَّرُ الأَلْبَابُ ضَوْءَ مَنَارِ",14,"ر",1,0],["في أَيِّ حَفْلٍ كَأَبْهَى","مَا نُظِّمَ الدُرُّ عقْدَا",15,"د",2,0],["فِي أَيِّ وَقْتٍ لَمْ يَطُلْ وَكَأَنَّهُ","عُمْرٌ طَوِيلُ الهَمِّ وَالأَوْصَابِ",16,"ب",1,0],["فِي أَيِّ قُطْرٍ عَاشَ أَمْثالُكُمْ","فَلَيْسَ فِي البَأْسَاءِ مِنْ بِأْسِ",17,"س",1,0],["فيأيُّها الناعِي إذا قُلْتَ فاتَّئِدْ","فما مُخطىءٌ في قولهِ كمُصيب",18,"ب",1,0],["فَيَأَيُّهَا الصَّادِي إِلَى الْعَدْلَ وَالنَّدَى","هلمَّ º فذا بحرٌ لهُ البحرُ ساحلُ",19,"ل",1,0],["فَيَأَيُّهَا السَّارِي عَلَى غَيْرٍ هُدْيَة ٍ","رُويداً ، فإنَّ البابَ دُونَكَ مُغلَقُ",20,"ق",1,0],["فيأيها الليثُ المكشر للورى","حنانيك إما الانصراف أو الوثب",21,"ب",1,0],["في أي زاه من تهاويلها ؟","يرسو ، وفي أي اخضرار يجول ؟",22,"ل",1,0],["فيا يقظان خذ خبرا جديدا","يؤمل منك احسانا قديمه",23,"م",2,0],["في أيِّما جانبٍ من حزمهِ نظروا","لم يجدوا مطلعا فيه لأَفنادِ",24,"د",1,0],["في أَيِّ يَومِ نَزالٍ حارَبوكَ فَما","دارَت كُؤوسُ المَنايا فيهِمُ نُخُبا",25,"ب",2,0],["في أَيِّ يَومٍ لَم نُصَب بِمُتَوَّجٍ","ضَخمِ الدَسيعَةِ صادِقِ الإِقدامِ",26,"م",1,0],["في \"أيْنِهِ\"أرْسى الأسى إيوانَهُ","في \"آنِهِ\" حَشَدَ الأوانُ لهُ العَنا",27,"ن",2,0],["في أيما بلد نعيش ؟ وأيما","عهد يمر على الكنانة مظلم ؟",28,"م",1,0],["فَيا يوسفيّ الملك والعفو جُد لنا","بِقولك لا تثريب واِجزل لنا الوهبا",29,"ب",2,0],["في أيديّه","أرويها بحبّي وأحلامي",30,"ي",1,0],["في أيِّ آيَاتِهِ أَلفَيتَ سَفكَ دَمِي","حلا بلا دِيَةٍ تُرضِي ولا ثَارِ",31,"ر",1,0],["فَيَأَيُّها الغَيثُ الَّذي التُربُ ضَيفُهُ","فَيُصبح مِن زَهرٍ وَيُغبَقُ مِن وَبلِ",32,"ل",1,0],["فَيَأَيَّها الكَهفُ الَّذي قَد رَجَوتُهُ","لَقَد نِمتَ عَنّى مِثلَ نَومِ أَهلِهِ",33,"ه",1,0],["في أي فنٍ شئتهُ","فكأنهُ باني أساسه",34,"س",2,0],["فيا ياسراً نلنا به الفضل ياسراً","لنا ووجدنا منه ما ليس يوجَدُ",35,"د",1,0],["في أيّ بيتٍ شئتَ من","ها قلتَ ذا سيَّارُها",36,"ر",3,0],["في أي طوقٍ من صلاتك لم ترحْ","وبأي قيدٍ كرامةٍ بم ترسف",37,"ف",1,0],["في أيّ قطرٍ نازحٍ لم تهمِ جد","واهُ وبارح سخطهِ لم تعصف",37,"ف",1,0],["في أي بيت ترى الإبداع دعمه","ما كان أشرفه بيتا لبانيه",38,"ي",2,0],["في أَيمنِ الجِزْعِ أَحبابٌ وَلِعْتُ بهم","حَطَطْتُ في بابِهم يا ظبيُ راحِلَتي",39,"ت",2,0],["في آية التطهير قد دخلوا ولو","سبقوا لضمَّهُم العَبا في الآلِ",40,"ل",1,0],["في أيٍّ كَسرٍ لم تَكُن لِىَ جابراً","وبأيِّ كَربٍ لم تَكُن لي مُؤَزِّرا",41,"ر",2,0],["في أيّ شِعْبٍ من شعوبِ مُرادهمْ","حتّى أُتاهِمَ لم أخِبَّ وأعنِقِ",42,"ق",1,0],["في آية الكرسيْ لنا عبرٌ","منه كتابٌ جاء مرقوم",43,"م",1,0],["في آية فيه فقد سلمتم","إلى النبي كل ما جهلتم",44,"م",1,0],["فيأَيُّها الملِك المرْتَقِي","ويأَيُّها الملِكُ المعْتَلي",45,"ل",2,0],["في اي مضما نراه سابقا","كلا ولم تلحق به الفرسان",46,"ن",1,0],["في أي صقع حلّ فهو مبجل","بين الملوك وسائر الرؤساء",47,"ا",2,0],["في أي صقع ينزلون فانما","معهم يحل اليمن فيه وينزل",48,"ل",1,0],["في أي عين تنظرين","فتور ألحاظي وجيدي",49,"د",2,0],["في أَيِّ دينٍ حَلَّ قتلُ الروحِ","وَهَل لِما تَفعَلُ مِن مُبيحِ",50,"ح",1,0],["في أي يوم غير يومك هائل","يبكي المسيء لذنبه استغفارا",51,"ر",2,0],["فيا يُمْنَ فتىً ما بي","ن فتيانٍ ميامين",52,"ن",1,0],["في أيَّ شرع جاز","إلقاءُ نفوس للتلفْ",53,"ف",1,0],["فِي آيَةِ الاََنْفالِ وَالرِّوايَهْ","قَدْ بَيَّنَتْ مَنْ ذُكِرُوا فِي الآيَهْ",54,"ه",1,0],["فيا يوسفَ الحسنِ الذي مذ لقيتُه","بسيارةٍ من فكرتي قلتُ يا بُشرى",55,"ر",2,0],["في أي جدٍّ تستغيث فلا ترى","إلا التقنع في سياط طغاتها",56,"ت",3,0],["فَيا يُوسُفَ الْحُسْنِ الّذي مُذْ عَلِقْتُهُ","بِسَيّارَةٍ مِنْ فِكْرَتي قُلْتُ يا بُشْرى",57,"ر",2,0],["فَيَايِيدُهَا تَنفِي وَينَأمُ بُومُهَا","وتَركُضُ فِيهَا وُرقُها رَنَّةَ الوَترِ",58,"ر",1,0],["في أي مصدر وأي مورد","بكسب جسم أو بقصد الخلد",59,"د",1,0],["في أَيِّ سَلحٍ تَرتَطِم","وَبِأَيِّ كَفٍّ تَلتَقِم",60,"م",1,1],["في أي فصل زرت أوطانها","قلت الربيع الطلق قد أخضرا",61,"ر",2,0],["فيا يوم الخميس لك التهاني","برونق عاهل الزمن السعيد",62,"د",1,0],["فيأيها الغادون والنيل أدمع","يرقرقها من بعد ما بنتم القُطر",63,"ر",1,0],["فيأيُّها المحمولُ فوقَ مَواكِبِ ال","ملائك والأطيارُ تُبكى ترَحَّمُ",64,"م",1,0],["في أي جارحة أصون أحبّتي","إذ كان صونهم عليّ حقيقا",65,"ق",2,1],["في أي جارحة منّي أصونكم","لم تلق جائحة مما ألاقيه",66,"ه",1,1],["فيا يومه قد أذبت الحشى","وأعقبت قلبي داء دخيلا",67,"ل",2,0],["في آية الشورى تحارُ عقولُنا","وتواصل الأسحار والآصالا",68,"ل",2,0],["في أي قطرٍ حلّ كان له","سعدٌ وقارنه به البشر",69,"ر",1,0],["فيا يومَ فاجأه الإنكليزُ","على رأسه حُوَّمٌ شُرَّع",70,"ع",1,0],["في أينَمَا كانَ بِلاَ آشتِبَاهِ","لأنَّهُ قامَ مقامَ الجاهِ",71,"ه",1,0],["في آى أوصافه الغراء قد صدحت","بلابل المدح تكرارا وتردادا",72,"د",2,0],["في أي وصف من صفاتك أمدح","وبأي روض من رياضك أصدح",73,"ح",1,1],["فيا يومَ الرهانِ فُجِعتُ فيهِ","بشَخصٍ جازَ عن جدّ الصفات",74,"ت",1,0],["فَي أَيِّ جارِحَةٍ أَصُونُ مُعذبي","سَلِمَت مِن التَّعذيبِ وَالتَّنكيلِ",75,"ل",1,0],["في أَيّ دينٍ يُجازي المحسنون بما","يَسُوءهم ولماذا تُجْحَد النِّعَم",76,"م",1,0],["في أينق كلما حث الحداة لها","بدت مناسمها هوجاء حطاطه",77,"ه",1,0],["في أي بطالة وفي أي زمان","أستبدل في الهوى فلاناً بفلان",78,"ن",1,1],["فيا يوم عاشوراء أوقدت في الحشا","من الحزن نيراناً مدى الدهر لا تخبو",79,"ب",2,0],["فيا يوم سلمان أنت الذي","جعلت وجوه الهدى ناضرة",80,"ر",2,0],["في أي أرض زرتها جثم الدجى","في ظل وجه عن ذكاءَ ينوب",81,"ب",1,0],["في آية الكتاب عفوا أطلقا","والقيد يحتاج له من فرقا",82,"ق",2,0],["في أي منزل صبوة لم أنزل","وبأي منطق عاذل لم أعذلِ",83,"ل",1,1],["فَيا يوسُفيَّ الحُلَى والصّفاتِ","فَعالاً كريماً وقَوْلاً صَدوقا",84,"ق",2,0],["فيا يوم بدر ليت انك لم تكن","فلولاك هند لم ترع قلب فاطم",85,"م",1,0],["في أَيّ مَكرُمَةٍ يُقاسُ وَلَم يَزَل","في كُلّ مكرُمَةٍ عَديمَ قَرينِ",86,"ن",1,0],["في آية التطهير آياتٌ بها","سر باسرار الغيوب مجلل",87,"ل",1,0],["في اي مغنى قد اناخ مطيُّها","لذهبتُ لوادري اليها من هنا",88,"ن",2,0],["فيا يوم محمود لمذموم بهجة","على المجد منه غبرة وقتام",89,"م",1,0],["في أَيّ مِيزانٍ وَزنَتَ بهِ القَضا","ءَ بهِ لك العِوَضُ الجزيلُ يُدانُ",90,"ن",1,0],["فيا يوم ذكراه سنلقاك كلما","رجعت إلينا، والضمائر صاغيةْ",91,"ي",2,0],["فيأيها المولى الذي أنا عبده","وقدماً رجا طول الموالي عبيدها",92,"د",3,0],["في إيذةٍ من وجه صعدته","وليت قبلاً هالعاً وجلا",93,"ل",2,0],["فيا يومه قد كنت أسوأ طالع","علينا برزء فادح الخطب هائل",94,"ل",1,0],["فَيا يومَ الرّهانِ فُجعتُ فيها","بِشَخصٍ جازَ عَن حدّ الصفاتِ",95,"ت",1,0],["في أي أرض كنت حسبي إلا من إذ","أنتم سماء ظلال أمن أنتم",96,"م",1,0],["في أَيِّ عيصٍ وَشَوكَةٍ وَقَعوا","وَأَيَّ قَومٍ بِغَرَّةٍ وَغَروا",97,"ر",3,0],["فيأيها الركب قولوا له","إذا ضاع قلبي بماذا أسير",98,"ر",1,0],["في أي وجه أملوا","يخيب منهم الأمل",99,"ل",1,0],["في أيِّ شيءٍ يرى الضَّنى بدَني","وصِرتُ مِما لقيتهُ علَما",100,"م",2,0],["في أيها هلك العدو","وإن يكن معه جحافل",101,"ل",1,0],["في أي فن شئته ان قلت لم","ينكر عليك القول قط نطاسي",102,"س",2,0],["في أيِّ قفرٍ مهمهٍ","ظامي الحشا فيه مخاطر",103,"ر",1,0],["في آية التطهير أدخلَه الهدى","كُن قارئاً تفسيرَها أو سامِعَه",104,"ع",2,0],["في أي نادٍ ما أكون فإنّني","لأنا ال أقيمُ قيامةَ الشّعراءِ",105,"ا",2,0],["في أي دينٍ جاء أن أسيرةً","هي من تهب وغيرها لا يُنجِدُ",1