ttps://www.poetsgate.com/ViewPoem.aspx?id=153941",""],[5106,"أُسَهَّدُ فِيْ تَذَكُّرِهِ وَأَرْضَى ..","https://www.poetsgate.com/ViewPoem.aspx?id=137167",""],[5186,"لا تعد بي إلى ربوع الخيام","https://www.poetsgate.com/ViewPoem.aspx?id=156442",""],[5190,"عزلة","https://www.poetsgate.com/ViewPoem.aspx?id=153691",""],[5190,"الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=68760",""],[2365,"نقض الليالى فيك مرّتيه","https://www.poetsgate.com/ViewPoem.aspx?id=200661",""],[5277,"المُرفِئ","https://www.poetsgate.com/ViewPoem.aspx?id=197924",""],[5277,"قدسُ الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=206957",""],[5296,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=155187",""],[5402,"طلَّ الصباحُ","https://www.poetsgate.com/ViewPoem.aspx?id=215711",""],[5409,"عيش ترصده المنايا ضيق","https://www.poetsgate.com/ViewPoem.aspx?id=155461",""],[5411,"رَغْوَةُ البُنّ بالتَّكَهُّنِ تَهْذي","https://www.poetsgate.com/ViewPoem.aspx?id=199392",""],[5431,"أجمل القول ماارتضته العقولُ","https://www.poetsgate.com/ViewPoem.aspx?id=198172",""],[5431,"كنتِ كنزه!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200141",""],[5431,"قاصرٌ من ذويه ...","https://www.poetsgate.com/ViewPoem.aspx?id=210853",""],[5460,"أجمعت ظالمة على تركي","https://www.poetsgate.com/ViewPoem.aspx?id=200739",""],[5461,"ليه إذا","https://www.poetsgate.com/ViewPoem.aspx?id=8538",""],[5461,"ميلت نجمة حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=504",""],[5525,"الشفق","https://www.poetsgate.com/ViewPoem.aspx?id=921",""],[5538,"الله يقسم من أضاع فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=142624",""],[5609,"جازان","https://www.poetsgate.com/ViewPoem.aspx?id=214101",""],[5660,"فَالوَصلُ وَ الصَّدُ في أَيامِنا دُوَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=23914",""],[5689,"باتت اليك يد الأشواق تدفعه","https://www.poetsgate.com/ViewPoem.aspx?id=143392",""],[5701,"أين المعز الفاطمي وجوهر","https://www.poetsgate.com/ViewPoem.aspx?id=164689",""],[5725,"أهون الطعنات","https://www.poetsgate.com/ViewPoem.aspx?id=211094",""],[5725,"أملأ القلب مفرحات ونبلا","https://www.poetsgate.com/ViewPoem.aspx?id=213017",""],[5848,"حاجات","https://www.poetsgate.com/ViewPoem.aspx?id=50629",""],[5848,"شاعر ولكنه من الغاوون","https://www.poetsgate.com/ViewPoem.aspx?id=48814",""],[5848,"ضاع الجمل والحمل والحمال","https://www.poetsgate.com/ViewPoem.aspx?id=48815",""],[5848,"يادلعها","https://www.poetsgate.com/ViewPoem.aspx?id=48987",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5956,"أ جَميلُ هل تنسى مُحِبَّك خالدا؟","https://www.poetsgate.com/ViewPoem.aspx?id=194657",""],[5956,"تتزاحم الأحزان في بنياني","https://www.poetsgate.com/ViewPoem.aspx?id=205383",""],[6001,"أبو ظبي","https://www.poetsgate.com/ViewPoem.aspx?id=375",""],[6031,"أَلجَفْنٍ أَرَّقتُموهُ هُجُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=46277",""],[6038,"كويتيه","https://www.poetsgate.com/ViewPoem.aspx?id=25685",""],[6045,"البشير عامر","https://www.poetsgate.com/ViewPoem.aspx?id=135938",""],[6056,"أبجدية حروفك","https://www.poetsgate.com/ViewPoem.aspx?id=130326",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[6203,"عاشق.. يتعثر في بردته!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88024&r=&rc=2",""],[463,"آنسة ٌ لا تكتم القولَ الحسنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60217&r=&rc=273",""],[6285,"هذه الشام لا تقولي كفانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86807&r=&rc=0",""],[6290,"جبل ورابية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85155&r=&rc=14",""]],"verses":[["أَجَمَمتُ لَحظي عِفَّةً وَسَجِيَّةً","أَن لا أَجُمَّ البيضَ في الأَجفانِ",0,"ن",1,0],["أَجمَعتَ هَجري وَالفِراقَ مَعاً","أَوما اِشتَفَيتَ بِواحِدٍ مِنّي",1,"ن",2,0],["أُجَمجِمُ عَن عَوّادِ قَومِيَ عِلَّتي","وَحُبُّكُمُ ذاكَ الدَخيلُ المُجَمجَمُ",2,"م",1,0],["أَجَمَّكُمُ وَلاقى عَن عُلاكُم","عِضاضَ الطَعنِ وَالضَربِ الخِلاطا",3,"ط",2,0],["أَجمَمتُ جُمَّتَهُ فَفاضَ بِها","يَطَأُ الرُبى وَيُبَلِّلُ اليَبَسا",4,"س",2,0],["أَجمَمتُمُ في الصُبحِ راعي هَجمَتي","وَكَفَيتُمُ بِاللَيلِ مَوقِدَ ناري",5,"ر",2,0],["إِجمَح أَمامَكَ إِن هَمَمتَ بِفَعلَةٍ","وَتَغابَ عَن عَذلٍ وَعَن تَفنيدِ",6,"د",1,0],["أَجمَعوا أَمرَهُم بِلَيلٍ فَلَمّا","أَصبَحُوا أَصبَحَت لَهُم ضَوضاءُ",7,"ا",2,0],["أَجْمَلْتُهُ وَتَشَوَّفَتْ لِبَيَانِهِ","هِمَمٌ فَكُنْتَ مُفَسِّرَ الإِجْمَالِ",8,"ل",1,0],["أَجمَلتَ ما فَصَّلوهُ في قَصائِدِهِم","حَتّى لَقَد نَضَّروا بِالحَمدِ مَثواكا",9,"ك",2,0],["أَجمَعوا أَمرَهُم عِشاءً وَباتوا","يُسمِعونَ الوَرى طَنينَ الذُبابِ",10,"ب",1,0],["أجملت في هذا الصنيع عوائداً","الجود فيها مجمل ومفصّلُ",11,"ل",1,0],["أَجمِل عَلى النَفسِ الكَري","مَةِ فِيَّ وَالقَلبِ الحَمولِ",12,"ل",1,0],["أَجمِلي يا أُمَّ عَمرٍ","زادَكِ اللَهُ جَمالا",13,"ل",2,1],["أَجمَعَت عَمرَةُ صُرماً فَاِبتَكِر","إِنَّما يُدهِنُ لِلقَلبِ الحَصِر",14,"ر",1,1],["أَجمَعتُ أَنَّكَ أَنتَ أَلأَمُ مَن مَشى","في فُحشِ مومِسَةٍ وَزَهوِ غُرابِ",15,"ب",1,0],["أجميلٌ بك اطِّراحِي وقد قد","دَمتُ في رأيك الجميلِ رجاءَ",16,"ا",2,0],["أجممت حسرى أياديك التي ثَقُلتْ","على الكواهل حتى آدها ذاكا",17,"ك",2,0],["أجملتُ من وصفي خلالك جُملةً","وعلى التجاربِ بعدها التفصيلُ",18,"ل",1,0],["أَجُمَيعُ قَد فُسكِلتَ عَبداً تابِعاً","فَبَقَيتَ أَنتَ المُفحَمُ المَعكومُ",19,"م",1,0],["أَجَميلٌ ما أَنتَ أَبهى مِنَ الوَر","دَةِ ذاتِ الشَذى وَلا أَنتَ أَجوَد",20,"د",1,0],["أجملته في باقة خلابة","من بعد ما فصلته تفصيلا",21,"ل",2,0],["اجمع الشعب في العراق على التر","حيب بالعبقري والاكبار",22,"ر",1,0],["اجمل به لما استقل مغادرا","اياي من لذاته في موكب",23,"ب",1,0],["أَجمٌ بَعضُهُ لِبَعضٍ عَدُوٌّ","زَحَفَت غابَةٌ لِتَمزيقِ أُخرى",24,"ر",2,0],["اِجمَعِ القِرشَ إِلى القِرشِ يَكُن","لَكَ مِن جَمعِهِما مالٌ لُبَد",25,"د",1,0],["أجمل القول قد بدا","أجمل السرّ قد ظهر",26,"ر",1,0],["أجمده بالأجساد فهو بها","يقوى وفيه السر بالثقلِ",27,"ل",1,0],["أجِمَّا البُكا يا مقلتَيَّ فإننَّا","على موعدٍ للبينِ لا شكَّ واقعِ",28,"ع",1,1],["أَجمَمتُ نائِلَهُ وَلَيسَ بِزائِدٍ","في نَحرِ دِجلَةَ إِذ طَما إِجمامُهُ",29,"م",2,0],["أَجمَعُ المالَ لِغَيري دائِباً","وَأُقاسي العَيشَ مِنهُ في كَبَد",30,"د",1,0],["اجمع الآنَ طاقةً","غضّةَ النور تبتسم",31,"م",1,0],["أجمْلٌ على بُخْلِ الغواني وإجمالُ","تفاءلتُ باسمٍ لا يصحّ به الفالُ",32,"ل",1,1],["أَجَميلُ ما لَكَ لا تُجيبُ أَخاكا","ماذا الَّذي بِاللَهِ أَنتَ دَهاكا",33,"ك",2,1],["أَجمَعَت خُلَّتي مَعَ الهَجرِ بَينا","جَلَّلَ اللَهُ ذَلِكَ الوَجهَ زَينا",34,"ن",2,1],["أَجمَعَت بَينَها وَلَم نَكُ مِنها","لَذَّةَ العَيشِ وَالشَبابِ قَضَينا",34,"ن",2,0],["أَجمَعَ الناسُ عَلى تَفضيلِها","وَهَواهُم في سِوى هَذا اِختَلَف",35,"ف",1,0],["أَجمَعَ الحَيُّ رِحلَةً","فَفُؤادي كَذي الأَسى",36,"ا",1,0],["اجمعْ لِمصرَ جَزاكَ ربُّك صَالحاً","أعلامَ عمروٍ في مواكبِ خفرعِ",37,"ع",1,0],["اجمعْ قُواكَ وإن تَباعَدَ شأوُها","إنّا نَعُدُّك للوغَى وكأن قدِ",38,"د",1,0],["أَجْمَعُوا الأمرَ وجاءوكم بها","قُطُراً تُزْجَى إليكم كلَّ حينْ",39,"ن",1,0],["اجْمَعوا المالَ لأيدي السَّالبينْ","وَلِدُوا الأبناءَ للمُستَعبِدينْ",39,"ن",1,0],["اجمَع لَهُ تَقوى الإِلَهِ فِإِنَّها","أَمنُ المَروعِ وَنَجدَةُ المُستَنصِرِ",40,"ر",1,0],["اجمعْ قُواكَ فقد بلغتَ المُنتهى","وانقعْ صَداكَ فقد أصبتَ الموردا",41,"د",2,0],["أجمعوا أمرهم وقالوا هو القت","لُ يُميطُ الأذَى ويَشفِي الصُّدورا",42,"ر",2,0],["أَجمَعَ القَومُ أَمرَهُم وَعَجوزٌ","خَيَّبَ اللَهُ سَعيَها وَلَحاها",43,"ا",1,0],["اِجمَع عَلَيكَ صَلاةَ حَولٍ كامِلٍ","مِن فَرضِ لَيلٍ فَاِقضِهِ بِنَهارِ",44,"ر",1,0],["أَجمَلُ بي مِن أَن أُعَدَّ اِمرِأً","أَو ذيكَ في أَهلِكَ أَن أَهلِكا",45,"ك",2,1],["أَجمِل فَعالَكَ إِن وُليتَ وَلا تَجُر","سُبلَ الهُدى فَلِكُلِّ والٍ عازِلُ",46,"ل",1,1],["أَجَمَّ رَحيلي ما أَجَمَّت مَوارِدي","وَكانَ دُخولي في ذَوي الع