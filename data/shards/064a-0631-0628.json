{"poems":[[55,"حقيق أن تكاثرك التهاني","https://www.aldiwan.net/poem29651.html","الوافر"],[65,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[23,"كنا ملوك الناس قبل محمد","https://www.aldiwan.net/poem21425.html","الطويل"],[64,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[48,"عليكم بإحسانكم إنكم","https://www.aldiwan.net/poem22164.html","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[135,"أدينك أن تذمى الخيزرانا","https://www.aldiwan.net/poem54721.html","الوافر"],[145,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[146,"قصر عن سعيك الألى جهدوا","https://www.aldiwan.net/poem11756.html","المنسرح"],[146,"يا للرجال لنظرة سفكت دما","https://www.aldiwan.net/poem11808.html","الكامل"],[163,"لا تأخذنك رأفة أو رحمة","https://www.aldiwan.net/poem58804.html","الكامل"],[234,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[238,"وجه حميد إن تأملته","https://www.aldiwan.net/poem32123.html","الرجز"],[307,"أموت بدائي والدوا في يديكم","https://www.aldiwan.net/poem16754.html","الطويل"],[325,"أضحت أميمة لا ينال زمامها","https://www.aldiwan.net/poem56344.html","الكامل"],[360,"ما عسى تبلغ شكراً ما عسى","https://www.aldiwan.net/poem4166.html","الرمل"],[366,"صحا قلبه وأقصر اليوم باطله","https://www.aldiwan.net/poem1724.html","الطويل"],[367,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[369,"بسطت لعاشقي الأتراك عذرا","https://www.aldiwan.net/poem17370.html","الوافر"],[409,"أتروم تغطية الهوى بجحوده","https://www.aldiwan.net/poem50187.html","الكامل"],[455,"سواء حول لنكلن المعلى","https://www.aldiwan.net/poem61754.html","الوافر"],[502,"يربي الحكم حقا ثم بطلا","https://www.aldiwan.net/poem37553.html","الوافر"],[564,"بناء العلى بين القنا والبوارق","https://www.aldiwan.net/poem52969.html","الطويل"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/20460","الطويل"]],"verses":[["يُرَبّى بَينَ أَحشاءِ المَعالي","وَيودَعُ بَينَ أَجفانِ الأَماني",0,"ن",2,0],["يَرْبِطُ فيما يعتَريهِ جأشَهُ","وقَلبُهُ مُشْتَمِلٌ على الأسى",1,"ا",1,0],["يَرُبّونَ بِالمَعروفِ مَعروفَ مَن مَضى","وَلَيسَ عَلى مَعروفِهِم أَبَداً قُفلُ",2,"ل",1,0],["يربي العِدى أبناءَهمْ لِسهامهِ","وللصَّقْرِ ما أضحَى البُغَاثُ يُفَرِّخُ",3,"خ",1,0],["يُرَبّي المَعاشِرُ أَبناءَهُم","وَيَشقى الأَنامُ بِما رَبَّتوا",4,"ت",3,0],["يُرَبَّبُ مِثلَ الغُصْنِ حتى إذا انتهى","أتى عاضِدٌ واستقبَلَ التُّرْبَ غارِس",5,"س",1,0],["يُربي عليهِ تِجاهَ الرَّكب ذُو دَرَكٍ","بالعَقبِ إن لَم يدمِّ الَجلزَ إحضارا",6,"ر",2,0],["يُربي وَهوَ لَم يَبلُغ مَقَاماً","ولَم تَسكُن لَهُ حِكَمٌ جَنَانَا",7,"ن",2,0],["يربك ما ضَمَّت جلابيبُه","محاسنَ العالَم في مَوضعِ",8,"ع",1,0],["يُربي عَلى الغَيثِ حينَ يَقتَصِدُ","وَيَسبِقُ الرِيحَ وَهوَ مُتَّئِدُ",9,"د",1,0],["يُربي عَلى القَدَرِ المُتاحِ إِذا سَطا","وَيُجاوِدُ الجَودَ السَحاحَ إِذا هَما",10,"م",2,0],["يربى على الخمسين قوم غرهم","قد عددوا أمسوا وكل ميت",11,"ت",1,0],["يربي عَلى مِسكٍ تَضَوَّعَ نَشرُهُ","مَن ذاقَهُ لَم يدعَ بِالظَمآنِ",12,"ن",1,0],["يَرَبِّ لا تَجعَل لِحُرٍّ إِلى","نَذلٍ لَئيمٍ أَبَداً حاجَه",13,"ج",2,0],["يربي قيامي لا بنفسي ولا السوى","فشكري له سبحانه وثنائي",14,"ا",3,0],["يُربي عَلى حُسنِ الحَوابي حُسنُها","وَيَزيدُ فَوقَ تَمامِهِنَّ تَمامُها",15,"م",3,0],["يَربَأُ النَّجمُ لَهُ عَسكَرَهُ","وَيُغيرُ الصُّبحُ عَنهُ والمَسَا",16,"س",2,0],["يُرَبنَ وَيَعرِفنَ القَوامَ وَشيمَتي","وَأَنكَرنَ زَيغَ الرَأسِ وَالشَيبُ شامِلُه",17,"ل",2,0],["يَرُبُّ ما يَصنَعُ من مَعروِفه","ورُبّ إحسانٍ وليدٍ لم يُرَب",18,"ب",1,0],["يُرَبّيهِ عَلى الغَرَضَينِ فَاِفهَم","فَإِنّي لا أُكاشِفُكَ الضَميرا",19,"ر",2,0],["يربي عَلى جهد الكرام كثيره","وَيَزيد فَوقَ كثيرهم بِزَهيدِهِ",20,"د",2,0],["يُرَبِّى الرائدين ولم يزالوا","حماة الفنِ والفكرِ الرصين",21,"ن",1,0],["يربي الحكم حقاً ثمَّ بطلاً","وسرُّ الحكم يبرزُ حكمتيه",22,"ي",2,1],["يربّي جيادَ الصافناتِ كوالدٍ","ويُنشي جِدادَ المَكرُماتِ كخالقِ",23,"ق",1,0],["يُرَبِّتُها التَرعيبُ وَالمَحضُ خِلفَةً","وَمَسكٌ وَكافورٌ وَلُبنى تَأكُلُ",24,"ل",1,0]]}