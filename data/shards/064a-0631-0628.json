{"poems":[[55,"حقيق أن تكاثرك التهاني","https://www.aldiwan.net/poem29651.html","الوافر"],[65,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[23,"كنا ملوك الناس قبل محمد","https://www.aldiwan.net/poem21425.html","الطويل"],[64,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[48,"عليكم بإحسانكم إنكم","https://www.aldiwan.net/poem22164.html","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[136,"أدينك أن تذمى الخيزرانا","https://www.aldiwan.net/poem54721.html","الوافر"],[146,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[147,"قصر عن سعيك الألى جهدوا","https://www.aldiwan.net/poem11756.html","المنسرح"],[147,"يا للرجال لنظرة سفكت دما","https://www.aldiwan.net/poem11808.html","الكامل"],[164,"لا تأخذنك رأفة أو رحمة","https://www.aldiwan.net/poem58804.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[240,"وجه حميد إن تأملته","https://www.aldiwan.net/poem32123.html","الرجز"],[309,"أموت بدائي والدوا في يديكم","https://www.aldiwan.net/poem16754.html","الطويل"],[327,"أضحت أميمة لا ينال زمامها","https://www.aldiwan.net/poem56344.html","الكامل"],[362,"ما عسى تبلغ شكراً ما عسى","https://www.aldiwan.net/poem4166.html","الرمل"],[368,"صحا قلبه وأقصر اليوم باطله","https://www.aldiwan.net/poem1724.html","الطويل"],[369,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[371,"بسطت لعاشقي الأتراك عذرا","https://www.aldiwan.net/poem17370.html","الوافر"],[412,"أتروم تغطية الهوى بجحوده","https://www.aldiwan.net/poem50187.html","الكامل"],[458,"سواء حول لنكلن المعلى","https://www.aldiwan.net/poem61754.html","الوافر"],[505,"يربي الحكم حقا ثم بطلا","https://www.aldiwan.net/poem37553.html","الوافر"],[567,"بناء العلى بين القنا والبوارق","https://www.aldiwan.net/poem52969.html","الطويل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2408","المنسرح"],[790,"","https://poetry.dctabudhabi.ae/diwan/poem/142577","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38967","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145801","المتقارب"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106704","الطويل"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20460","الطويل"],[2261,"","https://poetry.dctabudhabi.ae/diwan/poem/105649","الكامل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84539","البسيط"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124714","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115796","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132578","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62992","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62921","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86253","الطويل"],[3625,"","https://poetry.dctabudhabi.ae/diwan/poem/204081","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85255","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66099","المتقارب"],[4925,"ما بين بابَيْ عينِ سَعْنةَ واليَمنْ","https://www.poetsgate.com/ViewPoem.aspx?id=176643",""],[4929,"شجرة البن(دعوة الى عودة زراعتها)","https://www.poetsgate.com/ViewPoem.aspx?id=210429",""],[4959,"أَهْلَاً بِكَ يَا شَهْرَ الصِّيَام","https://www.poetsgate.com/ViewPoem.aspx?id=211445",""],[4968,"لَحْنُ الحَيَاةِ","https://www.poetsgate.com/ViewPoem.aspx?id=206762",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5038,"خصومة الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=190124",""],[5145,"تولّى الظلم وإنجاب الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=108226",""],[5431,"عبدة الشيطان ....","https://www.poetsgate.com/ViewPoem.aspx?id=207545",""],[5561,"أُحُبّكِ","https://www.poetsgate.com/ViewPoem.aspx?id=197377",""],[402,"عهدتك لا تهوى ثناء لقائل","https://www.poetsgate.com/ViewPoem.aspx?id=36162",""],[5956,"بعدالةٍ من أحمد الطعمينا","https://www.poetsgate.com/ViewPoem.aspx?id=194285",""],[5956,"مثل انبثاق الفجر صوت محمد","https://www.poetsgate.com/ViewPoem.aspx?id=194380",""],[6031,"عَاثَ الحِمامُ فما أبقَى وما تَرَكَا","https://www.poetsgate.com/ViewPoem.aspx?id=46283",""],[6212,"جُبَر.. ومئةُ عامٍ من المطر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1625&r=&rc=6",""]],"verses":[["يُرَبّى بَينَ أَحشاءِ المَعالي","وَيودَعُ بَينَ أَجفانِ الأَماني",0,"ن",2,0],["يَرْبِطُ فيما يعتَريهِ جأشَهُ","وقَلبُهُ مُشْتَمِلٌ على الأسى",1,"ا",1,0],["يَرُبّونَ بِالمَعروفِ مَعروفَ مَن مَضى","وَلَيسَ عَلى مَعروفِهِم أَبَداً قُفلُ",2,"ل",1,0],["يربي العِدى أبناءَهمْ لِسهامهِ","وللصَّقْرِ ما أضحَى البُغَاثُ يُفَرِّخُ",3,"خ",1,0],["يُرَبّي المَعاشِرُ أَبناءَهُم","وَيَشقى الأَنامُ بِما رَبَّتوا",4,"ت",3,0],["يُرَبَّبُ مِثلَ الغُصْنِ حتى إذا انتهى","أتى عاضِدٌ واستقبَلَ التُّرْبَ غارِس",5,"س",1,0],["يُربي عليهِ تِجاهَ الرَّكب ذُو دَرَكٍ","بالعَقبِ إن لَم يدمِّ الَجلزَ إحضارا",6,"ر",2,0],["يُربي وَهوَ لَم يَبلُغ مَقَاماً","ولَم تَسكُن لَهُ حِكَمٌ جَنَانَا",7,"ن",2,0],["يربك ما ضَمَّت جلابيبُه","محاسنَ العالَم في مَوضعِ",8,"ع",1,0],["يُربي عَلى الغَيثِ حينَ يَقتَصِدُ","وَيَسبِقُ الرِيحَ وَهوَ مُتَّئِدُ",9,"د",1,0],["يُربي عَلى القَدَرِ المُتاحِ إِذا سَطا","وَيُجاوِدُ الجَودَ السَحاحَ إِذا هَما",10,"م",2,0],["يربى على الخمسين قوم غرهم","قد عددوا أمسوا وكل ميت",11,"ت",1,0],["يربي عَلى مِسكٍ تَضَوَّعَ نَشرُهُ","مَن ذاقَهُ لَم يدعَ بِالظَمآنِ",12,"ن",1,0],["يَرَبِّ لا تَجعَل لِحُرٍّ إِلى","نَذلٍ لَئيمٍ أَبَداً حاجَه",13,"ج",2,0],["يربي قيامي لا بنفسي ولا السوى","فشكري له سبحانه وثنائي",14,"ا",3,0],["يُربي عَلى حُسنِ الحَوابي حُسنُها","وَيَزيدُ فَوقَ تَمامِهِنَّ تَمامُها",15,"م",3,0],["يَربَأُ النَّجمُ لَهُ عَسكَرَهُ","وَيُغيرُ الصُّبحُ عَنهُ والمَسَا",16,"س",2,0],["يُرَبنَ وَيَعرِفنَ القَوامَ وَشيمَتي","وَأَنكَرنَ زَيغَ الرَأسِ وَالشَيبُ شامِلُه",17,"ل",2,0],["يَرُبُّ ما يَصنَعُ من مَعروِفه","ورُبّ إحسانٍ وليدٍ لم يُرَب",18,"ب",1,0],["يُرَبّيهِ عَلى الغَرَضَينِ فَاِفهَم","فَإِنّي لا أُكاشِفُكَ الضَميرا",19,"ر",2,0],["يربي عَلى جهد الكرام كثيره","وَيَزيد فَوقَ كثيرهم بِزَهيدِهِ",20,"د",2,0],["يُرَبِّى الرائدين ولم يزالوا","حماة الفنِ والفكرِ الرصين",21,"ن",1,0],["يربي الحكم حقاً ثمَّ بطلاً","وسرُّ الحكم يبرزُ حكمتيه",22,"ي",2,1],["يربّي جيادَ الصافناتِ كوالدٍ","ويُنشي جِدادَ المَكرُماتِ كخالقِ",23,"ق",1,0],["يَرُبُّ مَعروفَهُ الجَزيلَ فَلا","يَنقُصُهُ بَعدَ قُوَّةِ الوَذَمِ",24,"م",1,0],["ي ربيع الحياة ألقتْه للدا","ءِ عليلاً، فضاع مني صوابي",25,"ب",2,0],["يَربو رَضيع المَعالي غَير مُنفَطِمٍ","مَحضون مَجدٍ وَفيهِ المَجد مسعودُ",26,"د",1,0],["يُرَّبِت ُفوق َظهوراِلمسَافا","ت ِ، لا تنطفيءْ أيها الإنطِفاءُ",27,"ا",2,0],["يُرَبِّسُ للإقدامِ كُلَّ كَتِيبةٍ","كمَا رَبَّسَ المَرجَان في السِّلكِ رابِسُ",28,"س",1,0],["يُرَبِّتُها التَرعيبُ وَالمَحضُ خِلفَةً","وَمَسكٌ وَكافورٌ وَلُبنى تَأكُلُ",29,"ل",1,0],["يربو على حب التجد","د في الحقول وليدها",30,"ه",2,0],["يَربو الهِلال بشيء من محاسنه","وَالشمس تَربو عَلى القرص الهلاليّ",31,"ي",1,0],["يربو على طلعة الساعي ليدركه","فليس يلحقه إن خَبَّ أو بَرَكا",32,"ك",2,0],["يربك إذا تبدّى أو تثنّى","هلالاً طالعاً من غصنِ بان",33,"ن",1,0],["يربك في ابتسامه","عقد جمان نضدا",34,"د",2,0],["يَربَا بِه عزُّ الفخا","رِ عن التعرضِ للفَخَارِ",35,"ر",1,0],["يربُّونَ نعماهم ولا يلحقونها","كما تفعلُ الشمسُ المضيئة بالبدرِ",36,"ر",1,0],["يربنا حجى الأَشياخُ في سن أَمرد","خَبيرٌ بِتَدبيرِ الأُمورِ حَكيمُ",37,"م",1,0],["يُرْبي على نَورِ الرُّبا أنوارُهُ","ويرفُّ في وادي النَّدى ديباجُهُ",38,"ج",2,0],["يربي يتاما المسلمين كأنه","لهم والدبر بهم غير دافع",39,"ع",1,0],["يُرَبِّينَ في الرَّوْض نَبْتا صِغارا","لِيَحْيَوْا حَياةَ المَعالي كِبارا",40,"ر",2,0],["يربو على الغيد الخرائد حسنها","فغدت تخر لها القصائد للذقن",41,"ن",1,0],["يربُو على النفطِ في أسعاره ثمنا","ولا ينافِسُها في كنزِه بحرُ",42,"ر",1,0],["يُرَبِّي النُّفُوسَ علَىٰ الصَّالِحَاتِ","فَإِنَّ الصِّيَامَ لَهَا كَاللِّجَامْ",43,"م",1,0],["يَرْبُو بِسَنَاهُ عَلَى صَرْحٍ","يَخْتَالُ وَيَزْهُو مُؤْتَلِقَا",44,"ق",2,0],["يربيك بالتدريج كيما ترى على","شمائل تهديك اقتفا سلف سما",45,"م",2,0],["يَرْبتُ الْكَتْفينِ وَالْأضْلاعَ يَحْشوها شَظايا","جاءَني مَنْ لايُريدُ الْيَومَ في النَّاسِ سِوايا",46,"ا",3,0],["يربب مجده مال حلال","يصان يبذله عرضٌ حرام",47,"م",1,0],["يُربّطُ العبدُ من أخلاقه الدونِ","لاأفقَ يبلغه فوق السلاطينِ",48,"ن",1,1],["يربّيهمْ ويرضعُهمْ شموسا","يعلّمهمْ بأنّ الحبّ غيرَهْ",49,"ر",2,0],["يربي بنيه بالحصافة والهدى","وتسعده أوفى وأكفى العقائل",50,"ل",1,0],["يُرْبي الإله هناءهُ أضعاف ما","ملأ القلوب هناءةً وسكونا",51,"ن",2,0],["يُرْبي على المفضال صالحَ لطفه","أضعافه سبحان من أعطانا",52,"ن",2,0],["يُرْبِعْ على ضلعِهِ السَّاعي ليُدركَهُ","فليس يلحقُهُ إنْ خبَّ أو بَرَكا",53,"ك",2,0],["يَرُبُّنِيْ في ابْتِداءاتِ الرُّؤى وَجَلٌ","ويَزْدَهِيْنِيَ في أُمِّ الدُّجَى سَمَرُ",54,"ر",1,0]]}