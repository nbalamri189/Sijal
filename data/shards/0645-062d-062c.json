/diwan/poem/117863","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118009","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117977","الوافر"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202349","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66533","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59464","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111397","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77027","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101380","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86456","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119672","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127072","المتقارب"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94460","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94550","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73138","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133075","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33336","البسيط"],[4927,"حِجابُ عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=30186",""],[5136,"القلب يخشع والأماني تدمع","https://www.poetsgate.com/ViewPoem.aspx?id=121614",""],[5397,"تبلجت ليلة في سعدها طلعا","https://www.poetsgate.com/ViewPoem.aspx?id=157936",""],[5689,"هات لي الكأس عزيز القلب هات","https://www.poetsgate.com/ViewPoem.aspx?id=143411",""],[5690,"صدقتم لحظهُ لحظ الغزالِ","https://www.poetsgate.com/ViewPoem.aspx?id=172173",""],[5786,"لعاذلي قلبٌ ولي قلْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50652",""],[5790,"ما للجمال بوجنتيك معين","https://www.poetsgate.com/ViewPoem.aspx?id=112147",""],[5790,"الله أكبر أي طرف يطمح","https://www.poetsgate.com/ViewPoem.aspx?id=111868",""],[5848,"إلى صدى الحرمان","https://www.poetsgate.com/ViewPoem.aspx?id=49007",""],[5986,"أيا عترة المختار والسادة الطهر","https://www.poetsgate.com/ViewPoem.aspx?id=162956",""],[5992,"مُحَجَّلٌ أشقرُ قلنا لمن","https://www.poetsgate.com/ViewPoem.aspx?id=41837",""],[6189,"حاشية على الجرح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83547&r=&rc=14",""]],"verses":[["مُحَجَّلاتِ نِعَمٍ وَغُرَّها","شَغَلتَنا حَتّى نَسينا شُكرَها",0,"ر",3,0],["مُحَجَّبُ أطرافِ الرِّواقَيْنِ بالقَنا","إذا ادّرَعَ الخَيْلانِ ظِلَّ قَتامِ",1,"م",1,0],["مَحْجُوْبَةٌ فِي خِدْرِ طِرْسٍ دُونَهَا","لِلْحُسْنِ مِنْ غُرِّ المَعَانِي مَوْكِبُ",2,"ب",1,0],["مَحجوبَةٌ لَم تَبتَذِل أَمّارَةٌ","لَم تَأتَمِر مَخدومَةٌ لَم تَخدِمِ",3,"م",1,0],["محجب العزَّ عن خلق تحاوله","وجودُ كفَّيه بادٍ غير محتجب",4,"ب",1,0],["محجبٌ غير ممنوعِ الندَى بسنَا","عليائِه ومهيب غير محتجب",5,"ب",1,0],["محجب العزّ في أيَّام سؤدَدهِ","للعزّ محوٌ وللأمداحِ إثبات",6,"ت",1,0],["محجوبة إن أقل عمرِي انْقضى فبِها","قضى حجايَ ولم يقض اللقا حاجي",7,"ج",2,0],["محجبة لا طعن فيها لعائب","على أنها تمشي فتهتز كالرمح",8,"ح",1,0],["محجّبةٌ تفترّ عن مبسمٍ كما","ينظّم في أزكى الأنام بديعي",9,"ع",2,0],["محجب لا يراه العاذلون ولا","أصغى إليهم وإن برُّوا وإن أفكوا",10,"ك",3,0],["محجبة أبكي ليالي وصلها","بشهبي وحمري وهي تبكي بدهمها",11,"م",3,0],["محجبة ما خلت قبل جفونها","على كبدِي إنَّ السيوف جفون",12,"ن",1,0],["محجّبةٌ تحتلّ عليا خَوَرْنقٍ","تشارف أنهاراً خلال سَدير",13,"ر",1,0],["مَحجوبُ إِن جِئتَ الحِجا","زَ وَفي جَوانِحِكَ الهَوى لَه",14,"ل",2,1],["مُحَجَّلٍ نَهدٍ كُمَيتٍ زاهِقِ","شادِخَةً غُرَّتُهُ كَالشارِقِ",15,"ق",1,0],["مَحجوبَةٌ بِسُرادِقٍ مِن هَيبَةٍ","تَثني الأَزِمَّةَ وَالمَطِيُّ ذَوامِلُ",16,"ل",1,0],["محجوبة بالرمز لكنها","بالكشف في أثنائها سافره",17,"ر",2,0],["مَحجوبَةٌ فَإِذا بَدَت فَكَأَنَّها","بَدرُ السَماءِ تَمامُهُ وَمُرامُهُ",18,"م",2,0],["مُحجبَّةٌ عن شُموسِ النَّهارِ","وبارزةٌ لنسيمِ المَسا",19,"س",2,0],["مُحَجَّبَةٌ وَسطَ الدِنانِ وَنورُها","يُخَرِّقُ مِن لَألاءِ غُرَّتِها الحُجبا",20,"ب",2,0],["مُحَجَّلِ الأَربَعِ ذي غُرَّةٍ","مَيمونَةِ الطَلعَةِ ذاتِ اِتِّضاح",21,"ح",1,0],["مُحَجَّباتٌ دَعاها المَجدُ فَاِبتَدَرَت","وَلِلجَلالِ حِجابٌ فَوقَها ضُرِبا",22,"ب",2,0],["مَحجوبَةُ الشَخصِ الكَريمِ وَفَضلُها","كَالفَجرِ لا يُلقى عَلَيهِ لِثامُ",23,"م",1,0],["محجَّلَةً غُرّاً وزُهراً نواصعاً","كأنَّ قُباطِيّاً عليها مُنشَّرا",24,"ر",2,0],["مَحجوبَةٌ في مَقيلِ حَوبَتِها","تِسعينَ عاماً مَحسوبَةَ العَدَدِ",25,"د",1,0],["مَحجوبَةً تَنفُذُ أَحكامُها","لَيسَ لَنا عَن ذاكَ تَأخيرُ",26,"ر",1,0],["مُحَجَّبٌ لو سَرى في مِثلِ طُرَّتِهِ","أغنَتْهُ غُرّتُهُ الغَرّا عن السُّرُجِ",27,"ج",1,0],["محْجوبةً كأميرةٍ شرقيةٍ","في هَوْدَجٍ أستارُهُ لم تُرفَعِ",28,"ع",1,0],["مَحجوبَةٌ بِصَوارِمٍ وَذَوابِلٍ","سُمرٍ وَدونَ خِبائِها أُسدُ الشَرى",29,"ر",2,0],["مِحْجَرٌ ضَائِقٌ بِإِنْسَانِ عَيْنٍ","وَاسِعِ الْحَوْلِ وَهْوَ غَيْرُ مَرِيدِ",30,"د",1,0],["مَحْجُوبَةِ النُّورِ إِلاَّ حَيْثُ نمَّ بِهَا","مِنْ خَالِصِ الشِّعْرِ وَصْفٌ خَالِدُ الأَثر",31,"ر",1,0],["محجب البث رحيبا شامخا","من رقة الشكوى وسورة الجفا",32,"ا",1,0],["محْجوبَة ٌ في خَدْرِ طِرْسٍ دُونها","للحُسْنِ من غُرِّ المعاني مَرْكَبُ",33,"ب",1,0],["مُحَجَبة قَد أَقسَم البيض وَالقَنا","بِأَلحاظِها أَن لا تَزور وَلا رُؤيا",34,"ي",2,0],["محجب لا تَراهُ مُقلة مَن","يَهواهُ إِلّا عَلى تَوهمِهِ",35,"ه",1,1],["محجب همه بالله اشغله","اذا تشاغل لاه همه القوت",36,"ت",1,0],["محجوبة عن ناظري","ساكنة بخاطري",37,"ر",2,1],["محجوبة برداء الحسن طلعتها","شمس وفي طرفها سيف الإمام على",38,"ل",2,0],["محجب بالقنا كم من قتيل هوى","قضى وبالوصل منه ما قضى وطره",39,"ر",2,0],["محجب بالعزّ لا بالظُبا","به سناه لا القنا مُحدق",40,"ق",1,0],["مُحَجَّلٍ تَحسِبُهُ","مِنَ الدُجى في يَلمَقِ",41,"ق",1,0],["محجبة إلا عن الفكر والكرى","فإما بوهم أو بطيف أزورها",42,"ر",3,0],["مُحَجَّبَةٌ مِن دونِهَا ذُبُلُ القَنَا","تَأَطَّر مِنْهَا فَوْقَ غُصْنٍ مُنَعَّمِ",43,"م",1,0],["مُحَجَّبَةٌ لَوْلاكَ لَمْ يَحْوِ ناظِرٌ","بِها الْفَوْزَ وَالْحَسْناءُ لا تَتَبَرَّجُ",44,"ج",1,0],["محجَّب إِن بَدَت محاسنُه","هفَت عليه القُلوبُ مُزدحمَه",45,"م",2,0],["محجبة الحسن البديع الذي غدا","به كل صب واله القلب حائر",46,"ر",1,0],["محجب وجيه بدر وطرته","ليل وقامته كالمائس النضر",47,"ر",1,0],["محجبة من هاشم ومحمد","عليه صلاة اللَه دأباً وسرمدا",48,"د",2,0],["محجّبة لولاك ضياك جهلتها","فعشت بعقل في الوجود شريد",49,"د",1,0],["محجّبة النور عن ناظري","محرمة العزف والناغيه",50,"ه",1,0],["مُحَجَّلِ أَوساطِ الغَراميلِ رُكِّبَت","أَنابيبُهُ في صُرَّةٍ ذاتِ ساتِرِ",51,"ر",1,0],["مَحُجَّبَةٌ لِمّا اِختَلَفَت بِجَلالِها","عَنِ الوَهمِ أَبداها الجَمالُ لِمُلَتي",52,"ي",1,0],["مَحجوبَةٌ يُظهِرُها حِجابُها","كَالشَمسِ يَجلوها عَلى الطَرفِ الطَفَل",53,"ل",1,0],["مُحجَّبَةً لَو طَيفها زارَ مَضجَعي","لَكانَ رَقيبي لَيله وَالسُها عيني",54,"ن",2,0],["مَحجوبة الأعيانِ وَقعُ سلاحِهَا","بِالرُّوحِ لَيسَ بِظَاهِرِ الأجسَامِ",55,"م",1,0],["محجوبةٌ عن كل مقلة عارفٍ","كمّاً وكيفاً كالجهات الأربع",56,"ع",1,0],["محجة الأرض والعلياء زينها","أمام بكرٍ وفت عن آدم الحججا",57,"ج",2,0],["محجوبةٌ لا تراها الشمس بارزةٌ","زارت بلا موعد لا تختشى الحرسا",58,"س",2,0],["محجبٌ بين بيض الهند والأسلِ","وليتما الخمر حلت دارة الحملِ",59,"ل",1,0],["مُحجَّبةٍ لا تُتَّقى بشبا القنا","ولا يُخْتَفَى منها ببابٍ ولا حُجْبِ",60,"ب",1,0],["محجَّةٌ سُبْلُها البيضاءُ خافيةٌ","وكلّها في مرائي أعينٍ سُبُلُ",61,"ل",1,0],["مُحْجِمٌ عن كل عارٍ خائمٌ","فاذا آنسَ مجْداً أقْدَما",62,"م",2,0],["محجّباتٍ لستر الليل هاتكةٌ","لم تهتك الليلَ ألاَّ وهي أقمار",63,"ر",1,0],["محجة الزهد صلبٌ لا يَزال به ال","إنسان ممتنعاً عن كل ترداد",64,"د",1,0],["مَحجوبَةً مِن بِناتِ الكَرمِ إِن بَرَزَت","لَم تَخشَ صورَتُها مِن ناظِرٍ مَلَلا",65,"ل",2,0],["مَحجوبَةٌ بِرَمادِها","بَعدَ اضَطِرامٍ وَالتِهابِ",66,"ب",1,0],["مُحَجَّبٌ عندَهُ الأَكوانُ فانِيَةٌ","وقامَ منهُ على الأَهواءِ سُلْطَانُ",67,"ن",1,0],["مُحَجَّبٌ من أُسودِ اللهِ ذو مَدَدٍ","سارٍ تصرُّفُهُ في الكَوْنِ لم يَزُلِ",68,"ل",1,0],["محجوبةٌ لا ينالُ الوهمُ رؤيتَها","ولا تَصيدُ شِراكَ النّومِ رُؤياها",69,"ا",3,0],["مَحجوبةٍ عمّن سِواك كَما","حَجَب الغباءُ الفهمَ عن فدمِ",70,"م",1,0],["محجّبين عن الفحشاء قاطبةً","كأنّهمْ بسوى المعروف ما علموا",71,"م",3,0],["مَحجوبَةً عَن عُيونِ الناسِ لَيسَ لَها","في غَيرِ بَيتِ بَني ساسانَ مِن نَسَبِ",72,"ب",1,0],["محجب خلف سجوف الورى","صدى الفتى ينبيك عن صوته",73,"ت",2,0],["محجبة عنها لفرط ظهورها","بها عجز المثني وكل المبالغ",74,"غ",1,0],["محجبة إلا على كل محرم","لها قرَّبتْهُ فهو للوتر شافع",75,"ع",1,0],["محجوبة بالستر عن كل من","ينظرها من أجنبي قبيح",76,"ح",1,0],["محجوبة بعقلها وحسها","عنه وعن ظهوره للرائي",77,"ا",2,0],["محجَّتُنا قطْع الحجا وهوَ حجُّنا","وحَجَّتُنا تتلوه باءٌ بِها تُهْنا",78,"ن",2,0],["مَحجوبةٌ تحتَ أَستارٍ تَغيبُ بها","ونُورُها كالدَّراري غيرُ محجوبِ",79,"ب",1,0],["محجَّبُ العِزِّ لا تَعْلو يدٌ لِيَدِي","قهراً ويَعْدوُ عَلَى السُّلْطانِ سُلْطَاني",80,"ن",2,0],["مَحجُوبةٌ عَنّي وليس خَيالُها","عَنّي على الخَلَواتش بالمحجوب",81,"ب",1,0],["محجبة بالنور من سبحاتها","كما حجبتني أنوارها بالأشعة",82,"ه",1,0],["محجبةً لم يطرق السمع صوتها","ولا شخصها يومها تراءت شمائله",83,"ل",2,0],["محجوبةٌ خلف الجدار كأنها","ماتت فصار لها البلى اطمارا",84,"ر",2,0],["مُحجَّلِ رِجْليْنِ طَلْقِ اليَدَيْنِ","لَه غُرَّةٌ مِثْلُ ضَوْءِ الإِرَاثِ",85,"ث",1,0],["مَحجُوبَةٌ بِظُبا المَواضِي وَالقَنا","تَقِفُ الأَمَاني عَن هَواها ظُلَّعا",86,"ع",2,0],["محجوبة لم تنتقب وجناتها","إذ هن من ورد الحيا بنقابِ",87,"ب",1,0],["محجوبة غيداء يوصدها الحيا","ما فارقت للمستريب حجابها",88,"ب",3,0],["مُحَجَّبَةٌ كَفَلَتْ لِلْغَيورِ","صُدورُ الرِّماحِ بِإِخْفائِها",89,"ا",3,0],["محجلة غرا على جبهاتها","بأقلام خرصان القنا كتب النصر",90,"ر",1,0],["محجبة حيرى غدت تشتكي النوى","بدمع جرى يشكو من الدهر مجراه",91,"ا",2,0],["محجوبة عن كلّ مقلة عارف","وهي التي سفرت ولم تتبرقع",92,"ع",1,0],["مُحَجَّبَةٍ بِالبِيضِ دُونِيَ وَالقَنَا","وَأَثْوَابِ نَقْعٍ لاَ بِلِبْسِ سِبَاغِ",93,"غ",1,0],["مُحَجَّلَةً غُراً كَأَنَّ رِعَالَهَا","بِحارٌ جَرَتْ فِيهَا الصَّبَا وَالْجَنائِبُ",94,"ب",1,0],["مَحجوبة الخلق دون الخلق لَو ظهرت","لأصبح الكون منها غير ما كانا",95,"ن",2,0],["محجوبة كشفت لنا عن وجهها","فتلألأت بشموسها الآفاق",96,"ق",1,0],["مَحجوبَة سَفرت وَأَسفَر صُبحها","وَتَجَرَّدت عَمّا أَجدّ وَأَخلقا",97,"ق",2,0],["محجوبة بالصون قد حجبت","ما شامها في صونها الخدر",98,"ر",1,0],["محجوبة لو مثلت فكرتها","لطرفها طيف الخيال لم ينم",99,"م",1,0],["محجوبةٌ مطلوبةٌ","لطالبِ التطرُّفِ",100,"ف",1,0],["محجب الحسن ولكنه","لم يبق فيما بيننا من حجاب",101,"ب",1,0],["محجلةٌ افعا