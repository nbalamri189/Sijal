{"poems":[[53,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[53,"أغر أيامي مني ذا الطلل","https://www.aldiwan.net/poem29853.html","الرجز"],[53,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[3,"حسناتي عند الزمان ذنوب","https://www.aldiwan.net/poem130.html",""],[3,"مدت إلي الحادثات باعه","https://www.aldiwan.net/poem173.html",""],[55,"إنما أبكي لأني","https://www.aldiwan.net/poem26251.html","مجزوء الرمل"],[77,"سبق القضاء وأبرم المحتوم","https://www.aldiwan.net/poem36093.html","الكامل"],[77,"قلدت من نصر الإلاه حساما","https://www.aldiwan.net/poem36124.html","الكامل"],[86,"طمع ألقى عن الغرب اللثاما","https://www.aldiwan.net/poem10683.html","الرمل"],[82,"ألثام شف عن ورد ند","https://www.aldiwan.net/poem29423.html","الرمل"],[93,"هانت معالم مات سيدها","https://www.aldiwan.net/poem11139.html","أحذ الكامل"],[93,"لقيتك مصر بثغرها المتبسم","https://www.aldiwan.net/poem11335.html","الكامل"],[93,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[54,"منازل الحي من غمدان فالنضد","https://www.aldiwan.net/poem27597.html","البسيط"],[72,"لا وأجفانك المراض الصحاح","https://www.aldiwan.net/poem18482.html","الخفيف"],[72,"مولاي أرجعني لبيت المال في","https://www.aldiwan.net/poem19050.html","الرجز"],[72,"زحفت بيض الظبا لما رنا","https://www.aldiwan.net/poem20619.html","الرمل"],[51,"يا داعيا نحو العلاء مثوبا","https://www.aldiwan.net/poem9252.html","الكامل"],[51,"أنجز مواعدك التي قدمتها","https://www.aldiwan.net/poem61860.html","الكامل"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[51,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[51,"يا أيها السيد الذي وهنت","https://www.aldiwan.net/poem66394.html","المنسرح"],[51,"مكر الزمان علينا غير مأمون","https://www.aldiwan.net/poem66416.html","البسيط"],[91,"شوق يروح مع الزمان ويغتدي","https://www.aldiwan.net/poem8800.html","عموديه"],[91,"ياليتما رجع الزمان الأول","https://www.aldiwan.net/poem9058.html","عموديه"],[91,"يا نبأ سر به مسمعي","https://www.aldiwan.net/poem9060.html","عموديه"],[91,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[91,"زعم المؤدب أن عيرا سائه","https://www.aldiwan.net/poem62774.html","عموديه"],[91,"مرت ليال وقلبي حائر قلق","https://www.aldiwan.net/poem62798.html","عموديه"],[91,"ثكل الشرق فتاه","https://www.aldiwan.net/poem62806.html","عموديه"],[89,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[89,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[89,"خمسة طاروا من عيون الشباب","https://www.aldiwan.net/poem44625.html","الخفيف"],[89,"اخي الى الموت سلك","https://www.aldiwan.net/poem44697.html","مجزوء الرجز"],[85,"الحرب لا بد منها","https://www.aldiwan.net/poem7753.html","المجتث"],[85,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[85,"هالة للهلال فيها اعتصام","https://www.aldiwan.net/poem62829.html","الخفيف"],[43,"ما الشوق مقتنعا مني بذا الكمد","https://www.aldiwan.net/poem9538.html","البسيط"],[43,"حسم الصلح ما اشتهته الأعادي","https://www.aldiwan.net/poem9554.html","الخفيف"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[62,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[45,"من قائل للزمان ما أربه","https://www.aldiwan.net/poem11054.html","المنسرح"],[45,"أعاد شكوى من الطيف الذي اعتادا","https://www.aldiwan.net/poem63468.html","البسيط"],[49,"يا أيها المتسمن","https://www.aldiwan.net/poem63142.html","مجزوء الكامل"],[66,"ما دام قلبي مأسورا بأسر علي","https://www.aldiwan.net/poem39524.html","البسيط"],[66,"ما دام جري الفلك الدائر","https://www.aldiwan.net/poem40135.html","السريع"],[66,"يقبل الأرض عبد تحت ظلكم","https://www.aldiwan.net/poem40334.html","البسيط"],[66,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[66,"لا تخش ياربع الحبيب همودا","https://www.aldiwan.net/poem41375.html","الكامل"],[66,"مادام وعد الأماني غير منتجز","https://www.aldiwan.net/poem41555.html","البسيط"],[80,"أي روح لي في الريح القبول","https://www.aldiwan.net/poem31315.html","الرمل"],[80,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[44,"صبرا على المطل ما لم يتله الكذب","https://www.aldiwan.net/poem29987.html","البسيط"],[44,"يا دهر قدك وقلما يغني قدي","https://www.aldiwan.net/poem30317.html","الكامل"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[44,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[69,"ما دام في الإنسان روح","https://www.aldiwan.net/poem28554.html","السريع"],[74,"الليل إلا حيث كنت طويل","https://www.aldiwan.net/poem13223.html","الكامل"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[102,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[40,"حمل القلب من حميدة ثقلا إن","https://www.aldiwan.net/poem42297.html","الخفيف"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[75,"قل للمليك ابن الملوك الصيد","https://www.aldiwan.net/poem69088.html","الكامل"],[50,"يا خاتم الملك يا سمعي ويا بصري","https://www.aldiwan.net/poem63811.html","البسيط"],[50,"أذكرت نفسي عشية الأحد","https://www.aldiwan.net/poem63909.html","المنسرح"],[50,"لا تلمني على عبيدة صاح","https://www.aldiwan.net/poem63969.html","الخفيف"],[50,"آب ليلي بعد السلو بعتب","https://www.aldiwan.net/poem64827.html","الخفيف"],[46,"ما الخير صوم يذوب الصائمون له","https://www.aldiwan.net/poem22459.html","البسيط"],[46,"يقال أن سوف يأتي بعدنا عصر","https://www.aldiwan.net/poem23309.html","البسيط"],[46,"إجتنب الناس وعش واحدا","https://www.aldiwan.net/poem23414.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85329","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54908","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54737","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141951","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43672","المقتضب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[106,"استعطاف وتبرئة","https://www.poetsgate.com/ViewPoem.aspx?id=179393",""],[106,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[106,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[77,"قلدت من نصر الإله حساما","https://www.poetsgate.com/ViewPoem.aspx?id=34200",""],[43,"لك يا منازل في القلوب منازل","https://www.poetsgate.com/ViewPoem.aspx?id=183",""],[90,"على الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179083",""],[45,"أعادَ شَكوى منَ الطّيفِ الذي اعتَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=31633",""],[91,"عصر الشبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=53194",""]],"verses":[["ما دَرِنَت أَعراضُهُم مِنَ الخَنا","وَلا اِنجَلَت أَسيافُهُم مِنَ الدَرَن",0,"ن",1,0],["ما دُمتَ جَثّاماً عَلى نِضوِ الإِبِل","مُسَوَّفاً في كُلِّ يَومٍ بِالرِحَل",1,"ل",1,0],["ما دُمتَ تَنتَظِرُ العَواقِبَ لا بِداً","لا تَغتَدي لِعُلىً وَلا تَتَرَوَّحُ",2,"ح",1,0],["ما دَعاني إِلّا مَضى يَكدِمُ الأَر","ضَ وَقَد شُقَّت عَلَيهِ الجُيوبُ",3,"ب",1,0],["ما دُستُ في أَرضِ العُداةِ غُدوَةً","إِلّا سَقى سَيلُ الدِما بِقاعَها",4,"ع",3,0],["ما دَعاني الشَوقُ إِلّا","أَذرَتِ العَينُ دُموعا",5,"ع",2,0],["مَا دُونَ وَجْهِ الْحَقِّ إِنْ حَقَّقْتَهُ","يَفْنَى وَيَبْقَى الْوَاحِدُ الْقَيُّومُ",6,"م",1,0],["مَادامَ ثَغْرُ الزَّهْرِ تَلْثُمُهُ الصِّبَا","فَتَحُطُّ عَنْهُ مِنَ الْكِمَامِ لِثَامَاك",7,"م",3,0],["مادَتِ الأَرضُ بِنا حينَ اِنتَشَت","مِن دَمِ القَتلى حَلالاً وَحَراما",8,"م",2,0],["ما دَرى مديرُها في كَأسِها","وَهيَ مثلُ البارِقِ المتّقدِ",9,"د",1,0],["مَادَتْ بِهَا شُمُّ الصُّرُوحِ فَهَلْ","شَعَرَتْ بِحَدْثَانٍ يُهَدِّدُهَا",10,"د",3,0],["مَا دُمْتِ سَالِمَةً فَمِصْرُ وَأَهْلُهَا","فِي نِعْمَةٍ وَفَرَتْ فَدُومِي وَاسْلَمِي",11,"م",2,0],["مَا دَهَى الضَّادَ فِي أَبَرِّ بَنِيهَا","مَا دَهَى الشَّرْقَ فِي فَتَاهُ الْعَظِيمِ",12,"م",1,0],["ما دَخَلوا قَريَةً إِلّا وَقَد كَتَبوا","بِها كِتاباً فَلَم يَدرُس وَلَم يَبِدِ",13,"د",1,0],["ما درى من يلوم حمرةَ دمعي","أن قلبي عليك دامي الجراح",14,"ح",1,0],["ما دامَ معلومِي بدار ضربها","فبعد دار الضَّرب دار الحبس",15,"س",1,0],["ما دنا شخصكَ حتَّى ارتحلا","ودعا الحادي وشدَّ الجملا",16,"ل",2,0],["ما دون معروفِ العلاء وعفوهِ","عند الرجوع إليه بابٌ مُرْتَجُ",17,"ج",1,0],["ما دَفْعُ أمري بعدَما أوليتني","بِرَّ الشقيق إلى حُنُوِّ الوالدِ",18,"د",1,0],["مادحاً صاعداً بها وعلاءً","مُطنباً في الخسيس وابن الخسيس",19,"س",1,0],["ما دفع مثلي والحال موجبة","والصدر رحب والوجه متسع",20,"ع",1,0],["مادحُ عشرين حجةً كَمَلاً","محرومُها منك غيرَ مضطغِن",21,"ن",1,0],["ما دافعتْ عنه أبوابٌ مُحجَّبةٌ","كلا ولا حُجَرٌ مغشيَّة الخُون",22,"ن",1,0],["ما دُمتَ في الدُنيا فَلا تَزهَد بِها","فَأَخو الزَهادَةِ مَيِّتٌ لَم يُلحَدِ",23,"د",1,0],["ما دُمتُ في صَحبي وَدامَ وَفائُهُم","فَأَنا الغَنِيُّ الحَقُّ لا المُتَمَوِّلُ",24,"ل",1,0],["ما دُمتُمُ لِلحَقِّ أَنصارَهُ","هَيهاتَ أَن يَنتَصِرَ الباطِلُ",25,"ل",1,0],["ما دَعَوتُ الدَمعَ إِلّا اِنسَكَبا","يا دُموعي أَنتِ لي أَوفى صَديق",26,"ق",1,0],["ما دامَ يَصحَبُ كُلُّ حَيٍّ صَوتُهُ","هَيهاتَ يَخفي العَيرَ جِلدُ حِصانِ",27,"ن",1,0],["ما دامَ قَلبُكَ فيهِ رَحمَةٌ لِأَخٍ","عانٍ فَأَنتَ اِمرُؤٌ في قَلبِكَ اللَهُ",28,"ه",1,0],["مادَ لُبنانُ وَمادَ","الشامُ لَمّا سَمِعاه",29,"ه",1,0],["ما دروا أن الشعر في كل أرض","هو من نفس أهلها منزوع",30,"ع",1,0],["ما دعوت القوافي الغر الا","وهي عند الدعاء جاءت تلبي",31,"ي",1,0],["ما دهاها حتى هوت كشهاب","خر من جوه بلا انذار",32,"ر",1,0],["ما دلكت شمس النها","ر انما اخي دلك",33,"ك",1,0],["ما دام شر فحرب","والشر فيهم لزام",34,"م",1,0],["ما دَرَت مِصرٌ بِدَفنٍ صُبِّحَت","أَم عَلى البَعثِ أَفاقَت مِن كَراها",35,"ا",3,0],["ما دَعاها الحَقُّ إِلّا سارَعَت","لَيتَهُ يَومَ وَصيفٍ ما دَعاها",35,"ا",3,0],["ما دَفَعتَ الحُسامَ عَجزاً وَلَكِن","عَجَّزتَ ضَيغَمَ الحُروبِ الكِلامُ",36,"م",1,0],["ما دارَ في خَلَدِ الأَيّامِ لي فَرَحٌ","أَبا عُبادَةَ حَتّى دُرتَ في خَلَدي",37,"د",2,0],["ما دَرَوا إِذ رَأَوا فُؤادَكَ فيهِم","ساكِناً أَنَّ رَأيَهُ في الطِرادِ",38,"د",1,0],["ما دُمتَ مِن أَرَبِ الحِسانِ فَإِنَّما","رَوقُ الشَبابِ عَلَيكَ ظِلٌّ زائِلُ",39,"ل",1,0],["ما دارَ في الحَنَكِ اللِسانُ وَقَلَّبَت","قَلَماً بِأَحسَنَ مِن نَثاكَ أَنامِلُ",39,"ل",1,0],["مادتْ غُصونُ العيشِ مُثْقَلةً","حَمْلاً وغصنُ الدِين مُعتدلُ",40,"ل",1,0],["ما دارَ لِلمَكرُماتِ مِن فَلَكٍ","إِلّا وَزاكى فَعالِهِ قُطُبُه",41,"ب",2,0],["ما دَيرُ عاقولَكُم بِالبُعدِ مانِعَنا","مِن أَن نَجيأَكَ مِن بَغدادَ عُوّادا",42,"د",2,0],["ما دونَ دائِرَةِ الرَدى","حِصنٌ لِمَن يَتَحَصَّنُ",43,"ن",1,0],["ما دامَ قَلبِيَ مَأسوراً بأَسرِ عَلي","كَيفَ البَقاءُ فَإِنَّ المَوتَ أَسرَعُ لي",44,"ل",2,1],["ما دامَ جَريُ الفَلَكِ الدائِرِ","لَم يَبقَ مِن بَرٍّ وَلا فاجِرِ",45,"ر",1,1],["ما دارُ مَيَّةَ مِن أَقصى مَطالِبِهِ","يَوماً وَأَنتُم لَهُ العَلياءُ وَالسَنَدُ",46,"د",1,0],["ما دامَتِ الأَيّامُ في نَصاحَتي","وَالعِزُّ مُلقٍ رَحلَهُ بِساحَتي",47,"ي",1,0],["مادامَ جودُكَ ياِّبنَ أُرتُقَ واصِلي","مَن شاءَ يَمنَحُني جَفاً وَصَدودا",48,"د",2,0],["مادامَ وَعدُ الأَماني غَيرَ مُنتَجِزِ","فَطولُ مَكثِكَ مَنسوبٌ إِلى العَجَزِ",49,"ز",1,1],["ما درت مضجَعَ نومي إنّما","دلّها ليلي عليه بأليلي",50,"ل",2,0],["ما درى خمّارُها عاصِرَها","فحديثُ الصدق فيها كالكذب",51,"ب",1,0],["ما دونَ بابِكَ لي بابٌ أَلوذُ بِهِ","وَلا وَراءَكَ لي مَثوىً وَمُطَّلَبُ",52,"ب",1,0],["مادامَ ذاكَ المَعدِنُ الزاكي الثَرى","في جِزعِنا لَم نَلتَفِت لِلعَسجَدِ",53,"د",1,0],["ما دامَ هارونُ الخَليفَةَ فَالهُدى","في غِبطَةٍ مَوصولَةٍ بِدَوامِ",54,"م",1,0],["ما دامَ عَيشٌ لَبِسناهُ بِساكِنِهِ","لَدناً وَلَو أَنَّ عَيشاً دامَ لَم يَدُمِ",55,"م",1,0],["مَأدومَةً لِلمُجتَدي مَوسومَةً","لِلمُهتَدي مَظلومَةً لِلمُصطَلي",56,"ل",2,0],["ما دامَ في الإنسانِ روحٌ","يبلغُ الدنيا أمانيهِ",57,"ه",1,1],["مادَ النُحولُ بِهِ فَلاعَبَ شَخصَهُ","ظِلٌّ تَحَيَّفَهُ السَقامُ نَحيلُ",58,"ل",1,0],["ما دَنا حَتّى هَمى الدَمعُ فَهَل","إِيلياءُ الغَيث فوق الجَبلِ",59,"ل",1,0],["مادت الأَرضُ ثم شَبَّتْ وألقت","ما على ظهرها من الأَثقالِ",60,"ل",1,0],["ما دَعا نائِحُ الحَمامِ بِوادٍ","ذي أَراكٍ وَهَزَّتِ الرِيحُ أَثلا",61,"ل",2,0],["ما دامَ يَتّبِعُ النُّجُومَ مُنَجِّمٌ","وَيُخَبِّرُ التَّثْلِيثَ والتَّسْدِيسا",62,"س",2,0],["ما داؤهُ شيءٌ سوى السرف الذي","يُمضي وما الإسرافُ بالمحمودِ",63,"د",1,0],["ما دَومَةٌ بَالنَدى طابَت وَطَيَّبَها","ثَلاثَةٌ مِثلُ أَدعاصِ المُلا المَطِرِ",64,"ر",1,0],["مَأدومَةٌ بِالعَبيرِ تَضحَكُ عَن","مِثلِ وِشاحِ الجُمانِ أَو بَرَدِ",65,"د",1,0],["ما دَواءُ الَّذي يُسَهَّدُ بِاللَي","لِ وَلا يَستَريحُ في الإِصباحِ",66,"ح",1,0],["ما دَعاني هَواكِ مُنذُ اِفتَرَقنا","بِاِشتِياقٍ إِلّا نَهَضتُ أُلَبّي",67,"ي",1,0],["ما دامَتِ الوَحشُ وَالإِنعامُ خائِفَةً","فَرَساً فَما صَحَّ أَمرُ النُسكِ لِلأَسَدِ",68,"د",1,0],["ما دامَ في الفَلَكِ المِرّيخُ أَو زُحَلٌ","فَلا يَزالُ عُبابُ الشَرِّ يَلتَطِمُ",69,"م",1,0],["ما دامَ غَيرُ اللَهِ مِن دائِمٍ","فَاِغضَب عَلى الأَقدارِ أَو سَلِّمِ",70,"م",1,0],["ما دام ذاك العيش في معانه","إلا كلمح البرق للمتوسِّم",71,"م",1,0],["ما دامت البيضاء والصفراء","فرعون لم يخلد ولا اشباهه",72,"ه",1,0],["مَا دَهَى المَحْمَدَاتِ يَوْمَ ثَوَى","بِالْقَاعِ ذَاكَ المُيَمَّمُ المَسْؤُولُ",73,"ل",1,0],["مَادِدِ الأُفْقَ أَيهَا البَحْرُ وَاسْطَعْ","أَيُّهَا البَدْرُ وَاسْتَفِضْ يَا نِيلُ",73,"ل",1,0],["ما دَهَى الأُمَّةَ الَّتِي فَقَدَتْهُ","أَفْدَحَ الرُّزْءِ فقْدِهَا الحَجَّارَا",74,"ر",2,0],["مَا دَعَاهْ دَاعِي الْمَبَرَّة إِلاَّ","كَانَ مِنْهُ الْجَوَابُ بِالإِسْعَاد",75,"د",1,0],["مادار ثََم سوى الحديث كأنه","راح يدير كؤوسها الملكان",76,"ن",1,0],["مأدبة افرغت كأسي بها","وقمت عنها لا كما تزعمين",77,"ن",1,0],["ما دَرى الزَمانُ وَقَد","جارَ فيهِ أَينَ عَتا",78,"ت",2,0],["ما دكّه عَصْفُ الْخُطُوبِ ولا وَنَى","لزَعازِع الإِبْراق والإِرْعاد",79,"د",1,0],["ما دان يوماً للصغار بصيته","أو دان للزُّلفى برفعة شانه",80,"ن",2,0],["مادتِ الراسياتُ ذُعْراً وخَفَّتْ","مِنْ أفانينِ كَيْدهِ أنْ تميدا",81,"د",2,0],["ما دار في فلك المُحْتَلٍّ إِمَّعَةً","بل كان يَقْضِي، ولا يَقْضي له أربَا",82,"ب",2,0],["ما دمت أنت نصيرَنا","فالنَّصْرُ موعدُهُ قريب",83,"ب",1,0],["ما دروا إِذ تأنقوا في كساهم","أَنهم يكتسون بالأكفان",84,"ن",1,0],["ما دام ثغر الزهر تلمه الصبا","فتحط عنه من الحكام لثاما",85,"م",2,0],["ما دارَ في الحَنَكِ اللّسانُ وقَلّبَتْ","قَلَماً بأحْسَنَ مِنْ ثَنَاكَ أنَامِلُ",86,"ل",1,0],["ما دأبه العجب ولكن كفى","أنك قد كنت به معجَبا",87,"ب",2,0],["ما دَيرُ عاقُولِكُمْ بالبُعْدِ مانِعُنَا","مِنْ أنْ نَجيئَكَ مِنْ بَغدادَ عُوّادَا",88,"د",2,0],["ما دمت في صحبي ودام وفاؤهم","فأنا الغنّي الحقّ لا المتموّل",89,"ل",1,0]]}