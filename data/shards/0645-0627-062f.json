00,"الجدار الفولاذي","https://www.aldiwan.net/poem6710.html","عموديه"],[400,"أيها الغائب","https://www.aldiwan.net/poem6734.html","عموديه"],[400,"حلم اللقاء","https://www.aldiwan.net/poem6766.html","عموديه"],[402,"عيد ثغور الأماني فيه تبتسم","https://www.aldiwan.net/poem46932.html","البسيط"],[403,"قد شف جسمي طول ما أتشوف","https://www.aldiwan.net/poem33640.html","الكامل"],[403,"كل أخبار الهوى قد رويت","https://www.aldiwan.net/poem34111.html","الرمل"],[416,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[432,"إليك من ملك سام ومن ملك","https://www.aldiwan.net/poem12357.html","البسيط"],[432,"قف بقفراء يباب","https://www.aldiwan.net/poem12547.html","مجزوء الرمل"],[432,"أرح المطية برهة يا حادي","https://www.aldiwan.net/poem12596.html","الكامل"],[432,"قد كان شعرك صالحا","https://www.aldiwan.net/poem12640.html","مجزوء الكامل"],[452,"درنا مع المحبوب في","https://www.aldiwan.net/poem13664.html","مجزوء الكامل"],[453,"حاصرتموني وحلتم دون إحساني","https://www.aldiwan.net/poem61606.html","البسيط"],[453,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[458,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[458,"نفرها عن وردها بحاجر","https://www.aldiwan.net/poem56177.html","الرجز"],[458,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[458,"صدت بنعمان على طول الصدى","https://www.aldiwan.net/poem56213.html","الرجز"],[458,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[458,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[458,"أنت على حالتيك محمود","https://www.aldiwan.net/poem56242.html","المنسرح"],[461,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[461,"وصاحب من بني الآمال خضت به","https://www.aldiwan.net/poem15303.html","البسيط"],[464,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[464,"ما دعوك البديع حتى تفردت","https://www.aldiwan.net/poem3339.html","عموديه"],[464,"ما بالها لم تجرني في بالها","https://www.aldiwan.net/poem3414.html","عموديه"],[465,"من لي ببغداد","https://www.aldiwan.net/poem36225.html","عموديه"],[468,"اسحب أبا عبد الإله","https://www.aldiwan.net/poem59532.html","مجزوء الكامل"],[468,"اشرب على شرب الغيوم","https://www.aldiwan.net/poem59697.html","مجزوء الكامل"],[468,"الماء بين مجوشن ومدرع","https://www.aldiwan.net/poem59892.html","الكامل"],[468,"قد أوقد الزهر مصابيحه","https://www.aldiwan.net/poem59958.html","السريع"],[468,"باكر صبوحك باصطباحك","https://www.aldiwan.net/poem60300.html","مجزوء الكامل"],[468,"طرف الشباب جموح","https://www.aldiwan.net/poem60303.html","المجتث"],[468,"الزهر ينشر ما طوى","https://www.aldiwan.net/poem60389.html","مجزوء الكامل"],[468,"الغيم بين بكا وبين نحيب","https://www.aldiwan.net/poem60394.html","الكامل"],[468,"يا من هو الأم لنا والأب","https://www.aldiwan.net/poem60460.html","السريع"],[468,"حث الكؤوس فكل هم","https://www.aldiwan.net/poem60482.html","مجزوء الكامل"],[479,"يا صاحب التقويم بل","https://www.aldiwan.net/poem36985.html","مجزوء الكامل"],[479,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[505,"الحسد","https://www.aldiwan.net/poem61088.html","البسيط"],[515,"أيها السيد الذي أنا عبده","https://www.aldiwan.net/poem12085.html","الخفيف"],[538,"شبل القساور من أبناء مزوار","https://www.aldiwan.net/poem48190.html","عموديه"],[544,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[544,"ما زال في الأرض","https://www.aldiwan.net/poem67255.html","عموديه"],[551,"لذ بالعزاء فلا خل تضن به","https://www.aldiwan.net/poem47346.html","البسيط"],[551,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"],[551,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[551,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[551,"في مثلها يستثار الصبر والجلد","https://www.aldiwan.net/poem47882.html","البسيط"],[558,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[562,"تقارن اليوم طيب السمع والبصر","https://www.aldiwan.net/poem52782.html","البسيط"],[562,"ما دام هذا اليوم يخلفه الغد","https://www.aldiwan.net/poem52845.html","الكامل"],[562,"إن كنت بالله في دنياك تعتصم","https://www.aldiwan.net/poem52850.html","البسيط"],[575,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[575,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"],[575,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[575,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[586,"وفقيه كالبدر زار بليل","https://www.aldiwan.net/poem17659.html","الخفيف"],[586,"بمن أباحك قتلي","https://www.aldiwan.net/poem17667.html","المجتث"]],"verses":[["ما دَرِنَت أَعراضُهُم مِنَ الخَنا","وَلا اِنجَلَت أَسيافُهُم مِنَ الدَرَن",0,"ن",1,0],["ما دُمتَ جَثّاماً عَلى نِضوِ الإِبِل","مُسَوَّفاً في كُلِّ يَومٍ بِالرِحَل",1,"ل",1,0],["ما دُمتَ تَنتَظِرُ العَواقِبَ لا بِداً","لا تَغتَدي لِعُلىً وَلا تَتَرَوَّحُ",2,"ح",1,0],["ما دَعاني إِلّا مَضى يَكدِمُ الأَر","ضَ وَقَد شُقَّت عَلَيهِ الجُيوبُ",3,"ب",1,0],["ما دُستُ في أَرضِ العُداةِ غُدوَةً","إِلّا سَقى سَيلُ الدِما بِقاعَها",4,"ع",3,0],["ما دَعاني الشَوقُ إِلّا","أَذرَتِ العَينُ دُموعا",5,"ع",2,0],["مَا دُونَ وَجْهِ الْحَقِّ إِنْ حَقَّقْتَهُ","يَفْنَى وَيَبْقَى الْوَاحِدُ الْقَيُّومُ",6,"م",1,0],["مَادامَ ثَغْرُ الزَّهْرِ تَلْثُمُهُ الصِّبَا","فَتَحُطُّ عَنْهُ مِنَ الْكِمَامِ لِثَامَاك",7,"م",3,0],["مادَتِ الأَرضُ بِنا حينَ اِنتَشَت","مِن دَمِ القَتلى حَلالاً وَحَراما",8,"م",2,0],["ما دَرى مديرُها في كَأسِها","وَهيَ مثلُ البارِقِ المتّقدِ",9,"د",1,0],["مَادَتْ بِهَا شُمُّ الصُّرُوحِ فَهَلْ","شَعَرَتْ بِحَدْثَانٍ يُهَدِّدُهَا",10,"د",3,0],["مَا دُمْتِ سَالِمَةً فَمِصْرُ وَأَهْلُهَا","فِي نِعْمَةٍ وَفَرَتْ فَدُومِي وَاسْلَمِي",11,"م",2,0],["مَا دَهَى الضَّادَ فِي أَبَرِّ بَنِيهَا","مَا دَهَى الشَّرْقَ فِي فَتَاهُ الْعَظِيمِ",12,"م",1,0],["ما دَخَلوا قَريَةً إِلّا وَقَد كَتَبوا","بِها كِتاباً فَلَم يَدرُس وَلَم يَبِدِ",13,"د",1,0],["ما درى من يلوم حمرةَ دمعي","أن قلبي عليك دامي الجراح",14,"ح",1,0],["ما دامَ معلومِي بدار ضربها","فبعد دار الضَّرب دار الحبس",15,"س",1,0],["ما دنا شخصكَ حتَّى ارتحلا","ودعا الحادي وشدَّ الجملا",16,"ل",2,0],["ما دون معروفِ العلاء وعفوهِ","عند الرجوع إليه بابٌ مُرْتَجُ",17,"ج",1,0],["ما دَفْعُ أمري بعدَما أوليتني","بِرَّ الشقيق إلى حُنُوِّ الوالدِ",18,"د",1,0],["مادحاً صاعداً بها وعلاءً","مُطنباً في الخسيس وابن الخسيس",19,"س",1,0],["ما دفع مثلي والحال موجبة","والصدر رحب والوجه متسع",20,"ع",1,0],["مادحُ عشرين حجةً كَمَلاً","محرومُها منك غيرَ مضطغِن",21,"ن",1,0],["ما دافعتْ عنه أبوابٌ مُحجَّبةٌ","كلا ولا حُجَرٌ مغشيَّة الخُون",22,"ن",1,0],["ما دُمتَ في الدُنيا فَلا تَزهَد بِها","فَأَخو الزَهادَةِ مَيِّتٌ لَم يُلحَدِ",23,"د",1,0],["ما دُمتُ في صَحبي وَدامَ وَفائُهُم","فَأَنا الغَنِيُّ الحَقُّ لا المُتَمَوِّلُ",24,"ل",1,0],["ما دُمتُمُ لِلحَقِّ أَنصارَهُ","هَيهاتَ أَن يَنتَصِرَ الباطِلُ",25,"ل",1,0],["ما دَعَوتُ الدَمعَ إِلّا اِنسَكَبا","يا دُموعي أَنتِ لي أَوفى صَديق",26,"ق",1,0],["ما دامَ يَصحَبُ كُلُّ حَيٍّ صَوتُهُ","هَيهاتَ يَخفي العَيرَ جِلدُ حِصانِ",27,"ن",1,0],["ما دامَ قَلبُكَ فيهِ رَحمَةٌ لِأَخٍ","عانٍ فَأَنتَ اِمرُؤٌ في قَلبِكَ اللَهُ",28,"ه",1,0],["مادَ لُبنانُ وَمادَ","الشامُ لَمّا سَمِعاه",29,"ه",1,0],["ما دروا أن الشعر في كل أرض","هو من نفس أهلها منزوع",30,"ع",1,0],["ما دعوت القوافي الغر الا","وهي عند الدعاء جاءت تلبي",31,"ي",1,0],["ما دهاها حتى هوت كشهاب","خر من جوه بلا انذار",32,"ر",1,0],["ما دلكت شمس النها","ر انما اخي دلك",33,"ك",1,0],["ما دام شر فحرب","والشر فيهم لزام",34,"م",1,0],["ما دَرَت مِصرٌ بِدَفنٍ صُبِّحَت","أَم عَلى البَعثِ أَفاقَت مِن كَراها",35,"ا",3,0],["ما دَعاها الحَقُّ إِلّا سارَعَت","لَيتَهُ يَومَ وَصيفٍ ما دَعاها",35,"ا",3,0],["ما دَفَعتَ الحُسامَ عَجزاً وَلَكِن","عَجَّزتَ ضَيغَمَ الحُروبِ الكِلامُ",36,"م",1,0],["ما دارَ في خَلَدِ الأَيّامِ لي فَرَحٌ","أَبا عُبادَةَ حَتّى دُرتَ في خَلَدي",37,"د",2,0],["ما دَرَوا إِذ رَأَوا فُؤادَكَ فيهِم","ساكِناً أَنَّ رَأيَهُ في الطِرادِ",38,"د",1,0],["ما دُمتَ مِن أَرَبِ الحِسانِ فَإِنَّما","رَوقُ الشَبابِ عَلَيكَ ظِلٌّ زائِلُ",39,"ل",1,0],["ما دارَ في الحَنَكِ اللِسانُ وَقَلَّبَت","قَلَماً بِأَحسَنَ مِن نَثاكَ أَنامِلُ",39,"ل",1,0],["مادتْ غُصونُ العيشِ مُثْقَلةً","حَمْلاً وغصنُ الدِين مُعتدلُ",40,"ل",1,0],["ما دارَ لِلمَكرُماتِ مِن فَلَكٍ","إِلّا وَزاكى فَعالِهِ قُطُبُه",41,"ب",2,0],["ما دَيرُ عاقولَكُم بِالبُعدِ مانِعَنا","مِن أَن نَجيأَكَ مِن بَغدادَ عُوّادا",42,"د",2,0],["ما دونَ دائِرَةِ الرَدى","حِصنٌ لِمَن يَتَحَصَّنُ",43,"ن",1,0],["ما دامَ قَلبِيَ مَأسوراً بأَسرِ عَلي","كَيفَ البَقاءُ فَإِنَّ المَوتَ أَسرَعُ لي",44,"ل",2,1],["ما دامَ جَريُ الفَلَكِ الدائِرِ","لَم يَبقَ مِن بَرٍّ وَلا فاجِرِ",45,"ر",1,1],["ما دارُ مَيَّةَ مِن أَقصى مَطالِبِهِ","يَوماً وَأَنتُم لَهُ العَلياءُ وَالسَنَدُ",46,"د",1,0],["ما دامَتِ الأَيّامُ في نَصاحَتي","وَالعِزُّ مُلقٍ رَحلَهُ بِساحَتي",47,"ي",1,0],["مادامَ جودُكَ ياِّبنَ أُرتُقَ واصِلي","مَن شاءَ يَمنَحُني جَفاً وَصَدودا",48,"د",2,0],["مادامَ وَعدُ الأَماني غَيرَ مُنتَجِزِ","فَطولُ مَكثِكَ مَنسوبٌ إِلى العَجَزِ",49,"ز",1,1],["ما درت مضجَعَ نومي إنّما","دلّها ليلي عليه بأليلي",50,"ل",2,0],["ما درى خمّارُها عاصِرَها","فحديثُ الصدق فيها كالكذب",51,"ب",1,0],["ما دونَ بابِكَ لي بابٌ أَلوذُ بِهِ","وَلا وَراءَكَ لي مَثوىً وَمُطَّلَبُ",52,"ب",1,0],["مادامَ ذاكَ المَعدِنُ الزاكي الثَرى","في جِزعِنا لَم نَلتَفِت لِلعَسجَدِ",53,"د",1,0],["ما دامَ هارونُ الخَليفَةَ فَالهُدى","في غِبطَةٍ مَوصولَةٍ بِدَوامِ",54,"م",1,0],["ما دامَ عَيشٌ لَبِسناهُ بِساكِنِهِ","لَدناً وَلَو أَنَّ عَيشاً دامَ لَم يَدُمِ",55,"م",1,0],["مَأدومَةً لِلمُجتَدي مَوسومَةً","لِلمُهتَدي مَظلومَةً لِلمُصطَلي",56,"ل",2,0],["ما دامَ في الإنسانِ روحٌ","يبلغُ الدنيا أمانيهِ",57,"ه",1,1],["مادَ النُحولُ بِهِ فَلاعَبَ شَخصَهُ","ظِلٌّ تَحَيَّفَهُ السَقامُ نَحيلُ",58,"ل",1,0],["ما دَنا حَتّى هَمى الدَمعُ فَهَل","إِيلياءُ الغَيث فوق الجَبلِ",59,"ل",1,0],["مادت الأَرضُ ثم شَبَّتْ وألقت","ما على ظهرها من الأَثقالِ",60,"ل",1,0],["ما دَعا نائِحُ الحَمامِ بِوادٍ","ذي أَراكٍ وَهَزَّتِ الرِيحُ أَثلا",61,"ل",2,0],["ما دامَ يَتّبِعُ النُّجُومَ مُنَجِّمٌ","وَيُخَبِّرُ التَّثْلِيثَ والتَّسْدِيسا",62,"س",2,0],["ما داؤهُ شيءٌ سوى السرف الذي","يُمضي وما الإسرافُ بالمحمودِ",63,"د",1,0],["ما دَومَةٌ بَالنَدى طابَت وَطَيَّبَها","ثَلاثَةٌ مِثلُ أَدعاصِ المُلا المَطِرِ",64,"ر",1,0],["مَأدومَةٌ بِالعَبيرِ تَضحَكُ عَن","مِثلِ وِشاحِ الجُمانِ أَو بَرَدِ",65,"د",1,0],["ما دَواءُ الَّذي يُسَهَّدُ بِاللَي","لِ وَلا يَستَريحُ في الإِصباحِ",66,"ح",1,0],["ما دَعاني هَواكِ مُنذُ اِفتَرَقنا","بِاِشتِياقٍ إِلّا نَهَضتُ أُلَبّي",67,"ي",1,0],["ما دامَتِ الوَحشُ وَالإِنعامُ خائِفَةً","فَرَساً فَما صَحَّ أَمرُ النُسكِ لِلأَسَدِ",68,"د",1,0],["ما دامَ في الفَلَكِ المِرّيخُ أَو زُحَلٌ","فَلا يَزالُ عُبابُ الشَرِّ يَلتَطِمُ",69,"م",1,0],["ما دامَ غَيرُ اللَهِ مِن دائِمٍ","فَاِغضَب عَلى الأَقدارِ أَو سَلِّمِ",70,"م",1,0],["ما دام ذاك العيش في معانه","إلا كلمح البرق للمتوسِّم",71,"م",1,0],["ما دامت البيضاء والصفراء","فرعون لم يخلد ولا اشباهه",72,"ه",1,0],["مَا دَهَى المَحْمَدَاتِ يَوْمَ ثَوَى","بِالْقَاعِ ذَاكَ المُيَمَّمُ المَسْؤُولُ",73,"ل",1,0],["مَادِدِ الأُفْقَ أَيهَا البَحْرُ وَاسْطَعْ","أَيُّهَا البَدْرُ وَاسْتَفِضْ يَا نِيلُ",73,"ل",1,0],["ما دَهَى الأُمَّةَ الَّتِي فَقَدَتْهُ","أَفْدَحَ الرُّزْءِ فقْدِهَا الحَجَّارَا",74,"ر",2,0],["مَا دَعَاهْ دَاعِي الْمَبَرَّة إِلاَّ","كَانَ مِنْهُ الْجَوَابُ بِالإِسْعَاد",75,"د",1,0],["مادار ثََم سوى الحديث كأنه","راح يدير كؤوسها الملكان",76,"ن",1,0],["مأدبة افرغت كأسي بها","وقمت عنها لا كما تزعمين",77,"ن",1,0],["ما دَرى الزَمانُ وَقَد","جارَ فيهِ أَينَ عَتا",78,"ت",2,0],["ما دكّه عَصْفُ الْخُطُوبِ ولا وَنَى","لزَعازِع الإِبْراق والإِرْعاد",79,"د",1,0],["ما دان يوماً للصغار بصيته","أو دان للزُّلفى برفعة شانه",80,"ن",2,0],["مادتِ الراسياتُ ذُعْراً وخَفَّتْ","مِنْ أفانينِ كَيْدهِ أنْ تميدا",81,"د",2,0],["ما دار في فلك المُحْتَلٍّ إِمَّعَةً","بل كان يَقْضِي، ولا يَقْضي له أربَا",82,"ب",2,0],["ما دمت أنت نصيرَنا","فالنَّصْرُ موعدُهُ قريب",83,"ب",1,0],["ما دروا إِذ تأنقوا في كساهم","أَنهم يكتسون بالأكفان",84,"ن",1,0],["ما دام ثغر الزهر تلمه الصبا","فتحط عنه من الحكام لثاما",85,"م",2,0],["ما دامت هجعتها حبلى","فولادتها لن تتأخر",86,"ر",1,0],["ما دارَ في الحَنَكِ اللّسانُ وقَلّبَتْ","قَلَماً بأحْسَنَ مِنْ ثَنَاكَ أنَامِلُ",87,"ل",1,0],["ما دأبه العجب ولكن كفى","أنك قد كنت به معجَبا",88,"ب",2,0],["مادامني عبدك .. وبقدارك أأأأأمنت...؟","أكيد أبصبر لا انفقدلي طماعه",89,"ع",2,0],["مادام عينك.. من اللي صار مكسوره.؟..","أجمع.. شموخك... وخفف حدة النبره",90,"ر",2,0],["مادرى..؟ أنها.....؟ قد... تحلت.. بركة الهرش العماني..","أمن..؟ أناسيمه... الا...ثفنته...لا....يده...لا...قيد ه.",91,"د",2,0],["مادامني شفت فيك الطهر والعفة","باعيف نفسي لامنك كرهتيني",92,"ن",2,0],["ما دَيرُ عاقُولِكُمْ بالبُعْدِ مانِعُنَا","مِنْ أنْ نَجيئَكَ مِنْ بَغدادَ عُوّادَا",93,"د",2,0],["ما دمت في صحبي ودام وفاؤهم","فأنا الغنّي الحقّ لا المتموّل",94,"ل",1,0],["ما دامَ حُبُّكِ يُعْطيني عباءتَهُ","فكيفَ لا أفتحُ الدنيا .. وأنتصِرُ ؟",95,"ر",1,0],["ما دامت هجعتها حبلى","فولادتها لن تنأخّر",96,"ر",1,0],["ما دعا لله داع خالص","واخو صدق باخلاص تعبد",97,"د",1,0],["مادرى أن حظه قدم الرا","ء وقبل التقديم قد كان فرضا",98,"ض",2,0],["ما دروا أني بأولا","د رسول اللَه وصلى",99,"ل",2,0],["ما دعاك الخائف اللاجي دجا","يا رسول اللَه دارك كرما",100,"م",2,0],["ما دُمتَ حيَّا نحن في سلوةٍ","قلوبُنا من أجلِكم سَالِيَهْ",101,"ي",2,0],["ما دارَ في ضمير الفؤادِ","محبكم أو ما خَطَرْ",102,"ر",1,0],["ما دواءُ العشاقِ من ألم الشو","قِ سوى أن تلقى الخدودُ خدودَا",103,"د",2,0],["ما درى أنَّ ربنا في جميع ال","أجنبياتِ أنزلَ التحريما",104,"م",2,0],["ما دنس العرض منا ما افتراه وما","من ترهات علينا الكاذبُ افتعلا",105,"ل",2,0],["ما دَرَوا أنَّ أعبُدَ اللهِ مِنهُم","مَن يَبَرَّ الإلَهُ إِن هُو آلَى",106,"ل",2,0],["ما دمت حيًّا فاعتلق","أبداً بأسبابِ الأملْ",107,"ل",1,1],["ما دنَستْها ذلةً أو خسةً","يوماً فتقدح في كمال حلاكا",108,"ك",2,0],["ما دمتَ سمعا وعينا في الزمان لنا","فكلُّ أيامِه أيامُ أعياد",109,"د",1,0],["ما دونَ أَمرِكَ في المَمالِكِ حاجِزٌ","قُل ما تَشاءُ فَإِنَّهُ مَفعولُ",110,"ل",1,0],["ما دامَ شَعبانٌ يَجيءُ أَمامَهُ","أَبَداً وَما أَفضى إِلى شَوّالِ",111,"ل",1,0],["مَا دارَ ذِكْرٌ مِنْكَ في خَلَدي","إِلا طَرَفْتُ بِدمْعَتي طَرْفي",112,"ف",2,0],["مَادامَ ش