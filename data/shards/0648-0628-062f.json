ِلَ الفَيحُ بالزُّرافَةِ وأل","أيَّامُ خُونٌ جَمٌّ عَجائُبها",132,"ب",3,0],["وَبَدَا الْهِلالُ عَلَى الأَصِيلِ كَأَنَّهُ","نُونٌ مُفَضَّضَةٌ بِرَقٍّ مُذْهَبِ",133,"ب",1,0],["وَبَدَتْ أَسِرَّتُهُ فَكانَتْ غُرَّةً","لِلْمُلْكِ فَوْقَ أَسِرَّةِ الْجَوْزَاءِ",134,"ا",2,0],["وَبَدَتْ لِمِصْرَ بِهِ بَوَادِرُ حِكْمَةٍ","سَبَتِ الْعُقُولَ بِآيِهَا الأَبْكَارِ",135,"ر",1,0],["وَبَدَتْ بَوَادِرُ عِلْمِهِ بِوُجُودِهِ","وَشُعُورِهِ بِجُمُودِهِ القَتَّالِ",136,"ل",1,0],["وَبَدَا لِلمُنَى الجَلاَئِلِ فِيهَا","أُفُقٌ وَاسِعُ المَدَى لاِرْتِيَادِ",137,"د",1,0],["وبَدَتْ قُوَّةُ التعَاوُنِ فِي","تحْقِيقِ مَا لا يُظَنُّ كَسْباً وَوَفْرَا",138,"ر",2,0],["وَبَدَا فِيهِ وَقارٌ بَعْدَ أَنْ","كانَ خَفَّاقاً إِذَا حُمِّلَ وِقْرَا",139,"ر",2,0],["وَبَدْئِهِ الحُكْمَ بِالشَّورَى يُتِمُّ بِهِ","مَا شاءَهُ اللهُ عَنْ عَدْلٍ وَعَنْ جُودِ",140,"د",1,0],["وَبدَا مِن حِفَاظِهِ كلُّ مَذْخُو","رٍ كَرِيمٍ فِي كُلِّ رَسْمٍ جَمِيلِ",141,"ل",1,0],["وَبُدِّلْنَا مَطَايَا لاَ تجَارَى","مِنَ اللاَّئِي عَجَزنَ عَنِ اللِّحَاقِ",142,"ق",1,0],["وَبَدِيعٌ فِي مَأْثَرَاتِكَ دَامَتْ","أَنَّهَا مِنْ وَلاَئِدِ الآرَاءِ",143,"ا",2,0],["وَبَدَا لِوَهْمِكَ مِنْ حُلِيِّ نَبَاتِهَا","أَثَرٌ بِوَشْيِ بَيَانِهِ مُتَرَائِي",144,"ا",2,0],["وبداً في المُلْكِ تُرَغِّبُه","وبُقىً في المالِ تُزهّدهُ",145,"د",2,0],["وَبَدا من سيفِكَ مُبرِقُه","وَعلا من صوتك مُرْعِدهُ",145,"د",2,0],["وَبَدا كالصَّبَاحِ فانْهَزَمَ اللَّيْلُ","وَوَلَّتْ مَذْعُورةً ظَلْماؤه",146,"ا",3,0],["وبَدَا للْعيُونِ والدُكَ المِسْمَاحُ","تُحْيِيهِ ثانياً أَبْناؤه",146,"ا",3,0],["وَبَدأْنَا عَصْراً أغَرَّ سَعِيداً","بِمَليكٍ مَاضٍ أَغَرَّ سَعِيدِ",147,"د",1,0],["وبدار الفِردوسِ من جانبوا الإث","مَ لعجز النفوسِ عن إتيانه",148,"ن",2,0],["وبدا في طليعة الركب طيْفٌ","لجَّ منه الفؤَاد في تحنانهْ",148,"ن",2,0],["وَبَدا بينَهُمْ محمدٌ الأَكْبَر","مُحْيِي البلادِ مُنْشِي الرجال",149,"ل",1,0],["وبدتْ دُرَّةً من النُّبْلِ والمجدِ","فغضَّت منَ الدَّرارِي الصِّحاح",150,"ح",1,0],["وَبَدَا عَمُودُ الصُّبح أَبْيَضَ ناصِعاً","كالسَّلْسَلِ الضَّحْضَاحِ فَوْق جَلِيدِ",151,"د",1,0],["وَبدَا المْلِيكُ بهِ يُمَجِّدُ رَبَّهُ","للّهِ مِنْ نُسْكٍ وَمِنْ تَمْجِيدِ",151,"د",1,0],["وبدا العرشُ وقد حلَّ به","يَفْرَعُ الشمسَ ويعلو الأنجمَا",152,"م",2,0],["وبدا الموتُ سافرًا كالحَ الوج","هِ، ولم تُجدِ حيلةُ الرُّبان",153,"ن",1,0],["وبدَّدَتْ بخيوطٍ من أشعتها","غيمًا على الأفُقُ الشرقيِّ قد رانا",154,"ن",2,0],["وبدا النخيل: غصونهُ فيروزجٌ","يحملن من صافي العقيق حبوبا",155,"ب",2,0],["وبُدِّلَتْ مِنْ أهْلِها وُحوشًا","وغًيَّرتْ حالَها الخُطُوبُ",156,"ب",1,0],["وبدا لنا الدستورُ وهو مخلَّعٌ","عريانَ غيرَ تستُّرٍ مزعوم",157,"م",1,0],["وبَدَتْ من الأرماث ، عائمةً","فيه ، طلائعُ ما يُجَنِّدُه",158,"د",2,0],["وبدا على وَجهِ الحفيدِ وجدِّه","للناظرينَ تقارُبُ الأعمار",159,"ر",1,0],["وبدا الحَصَى اللمّاعُ في رَقراقه","دُرراً غواليَ تزدهي وجُمانا",160,"ن",2,0],["وبدَتْ عندَ سفحِه خاشِعاتُ","الدور مثل \" الزٍّميت \" في مِحراب",161,"ب",1,0],["وبديعٍ من البدائع يَسْبي","كل عقلٍ ويطبيَّ كُلَّ طرْفِ",162,"ف",1,1],["وبُدِّل إعجاب الغواني تعجباً","وَهُنَّ الرزايا بادئاتٌ وعُوَّدُ",163,"د",1,0],["وبدائدُ المزجانِ في قرنٍ،","والدرُّ، والياقوتُ، والشذر",164,"ر",1,0],["وَبُدِّلَ الفَتحُ بِالزَرافَةِ وَالْ","أيَام جونٌ جَمٌّ عَجائِبُها",165,"ب",3,0]]}