d=179666",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[106,"الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179446",""],[15,"معلقة عبيد بن الأبرص","https://www.poetsgate.com/ViewPoem.aspx?id=11410",""],[90,"ذكرى الهاشمي","https://www.poetsgate.com/ViewPoem.aspx?id=179163",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[51,"أخفُّ مناطاً في الرقاب وأوْكَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=25837",""],[31,"لمنِ الديارُ رسومها قفرُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18874&r=&rc=137",""],[20,"لم أر مثل الفتيان في غبن ال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69760&r=&rc=1",""]],"verses":[["وَبُدِّلتُ مِمّا يَروقُ الحِسا","نَ مِن مَنظَرٍ ما يَروعُ العَوالي",0,"ل",2,0],["وَبُدورٍ يَلِطُّ مِن دونِها النَق","عُ وَلا يَكتَفي بِلَطِّ السُجوفِ",1,"ف",1,0],["وَبَدَت سَلمى تُخاصِرُها","غادَةٌ مِنهُنَّ عُطبولُ",2,"ل",1,0],["وَبَدا بَرقٌ يَدِبُّ كَما","دَبَّ في قَيْدَيْهِ مَكبولُ",2,"ل",1,0],["وَبَدَتْ لنا هَيْفاءُ مُخْطَفَةُ الحَشى","فَتَنَاهَبَتْ وَجَناتِها الأَلْحاظُ",3,"ظ",1,0],["وبَدا لنا طَلَلٌ لرَبْعِكِ خاشِعٌ","تَزدادُ بَهجَتُهُ على الإقواءِ",4,"ا",2,0],["وَبَدَت فَقُلتُ البَدرُ لَيلَةَ تِمِّهِ","قَد قَلَّدَتهُ نُجومَها الجَوزاءُ",5,"ا",2,0],["وَبَدرٌ قَد تَرَكناهُ طَريح","كَأَنَّ عَلَيهِ حُلَّةَ أُرجُوانِ",6,"ن",1,0],["وَبَدَتْ سُعُودُكَ مُسْتَقِيماً سَيْرُهَا","وَعَلَتْ فَفَرَّ أَمَامَهَا النَّحْسَانِ",7,"ن",1,0],["وَبَدْرٍ بَدَا قِسْمَيْنِ فَالِقسْمُ ثَابِتٌ","مُقِيمٌ وَقَدْ أَهْوَى إِلَيْكَ قَسِيمُهُ",8,"م",2,0],["وَبَدَا انْفِعَالُ الْكَوْنِ هَذَا الْعَالَم","الْعُلْوِيَّ مُهْتزَّ فَكَيْفَ الأَسْفَلُ",9,"ل",1,0],["وبَدّدْتَ شمْلَ الكُفْرِ بعْدَ ائتلافِهِ","فأضْحَى عَميداً في الرُّغامِ عَميدُهُ",10,"د",2,0],["وَبَدْرُ اللَّيَالِي لاَ يُرَجَّى طُلُوعُهُ","وَقَلْبُ الْمَعَالِي أَسْلَمَتْهُ ضُلُوعُهُ",11,"ه",1,0],["وَبَدْرِ كَمَالٍ ضاءَ تَلْتَاحُ حَوْلَهُ","مِنَ الأَمَرَاءِ الْغَالِبينَ الْكَوَاكِبُ",12,"ب",1,0],["وَبَدَرتُ القَولَ أَن حَيَّيتُها","ثُمَّ أَنشَأتُ أُفَدّي وَأُهَنّ",13,"ن",1,0],["وَبَدا شِعري عَلى قِرطاسِهِ","لَوعَةً سالَت عَلى دَمعٍ جَمَد",14,"د",1,0],["وَبَدا يَموجُ بِساكِنيهِ وَعِطفُهُ","قَد كادَ مِن طَرَبِ اللِقاءِ يَميلُ",15,"ل",1,0],["وَبَدا ماؤُهُ كَخاطِرِكَ المَص","قولِ أَو كَالفِرِندِ أَو كَالسَرابِ",16,"ب",1,0],["وَبَدا الهِلالُ كَزَورَقٍ","مِن فِضَّةٍ في البَحرِ عائِم",17,"م",1,0],["وَبَدا زَمانَكَ لابِساً ديباجَةً","تَجلو لِعَينِ المُجتَلي سيماكا",18,"ك",2,0],["وَبُدِّلتُ قَرحاً دامِياً بَعدَ صِحَّةٍ","فَيا لَكِ مِن نُعمى تَحَوَّلنَ أَبؤُسا",19,"س",2,0],["وَبَدَّلَ مِنها بَعدَ طولِ إِقامَةٍ","تَبَعُّثُ نَكباءِ العَشِيِّ جَفولِ",20,"ل",1,0],["وَبَدِيعٌ فِي السِّلْمِ أَنَّكَ غَازٍ","مِثْلَمَا كُنْتَ غَازِياً فِي الحُرُوبِ",21,"ب",1,0],["وَبَدَتْ لأَهْلِ الغَرْبِ فِي إِلْمَامِهِ","للهِ حِكْمَةُ ذَلِكَ الإِلْمَامِ",22,"م",1,0],["وبدر دياجيها وشمس نهارها","وبشرَ مُحيّاها ونورَ مجاليها",23,"ي",3,0],["وبدائع الأكوان في إتقانها","أثر يشير إلى البديع المتقن",24,"ن",1,0],["وبدائع التحفِ التي قد أطلعت","مثلَ البدور أنارت الأحلاكا",25,"ك",2,0],["وبدتْ نجوم السعد قبلَ طلوعه","تجلو المطامع قبلَه وتُؤثَّلُ",26,"ل",1,0],["وبدائع التصوير من حسناتها","أن يستفيد بها الشعور سموقا",27,"ق",2,0],["وَبُدِّلَتِ الحَمِيرُ فَمَا فَزِعنَا","لِذاك مِنَ النَّهِيقِ بِهِ الحَنِينَا",28,"ن",2,0],["وَبَدَت مِنهُ مُزَمَّلَةٌ","حِلمُهُ في غَيِّها ذاهِبُ",29,"ب",1,0],["وبديع الجمالِ زينَ بخالٍ","ساكنٍ فوقَ أشرف الوجنات",30,"ت",1,1],["وبدرً سرى في طيةِ البينِ متهماً","فيا صاحبي دمعاً لعلكَ منجدي",31,"د",2,0],["وبدراً فائزاً بالحسنِ يحثو","تراب السبق في وجه البدور",32,"ر",1,0],["وبدت لدى البيدا مطي قبورهم","علماً بأنهمُ على أسفار",33,"ر",1,0],["وبديع الجمال لم يرَ طرفي","مثل أعطافه ولا طرف غيري",34,"ي",1,1],["وبديعة كالروض إلا أنها","تجلى بجارحة السماع وتعشق",35,"ق",1,0],["وبدر مضى وقتِي مضيئاً بوصله","فلا غَرْوَ أني بعد بدرِي مضلَّل",36,"ل",1,0],["وبدت وباعث شهوتي للقولِ قد","ولَّى فها أنا أشتهي أن أشتهي",37,"ه",2,0],["وبدراً له في العرب والترك نسبة","دعتني إلى داني الهوى وقصيّه",38,"ي",2,0],["وَبَدا لَهُ مِن بَعدِ ما اِندَمَلَ الهَوى","بَرقٌ تَأَلَّقَ مَوهِناً لَمَعانُهُ",39,"ن",2,1],["وبدت تنحر القرابين نحرا","في هوى كل دمية صماء",40,"ا",2,0],["وبُدِّلْتُ من ذاك البياض وحسنِه","بياضاً ذميماً لا يزال يُسَوَّدُ",41,"د",1,0],["وبُدِّل إعجابُ الغواني تعجُّباً","فهنَّ رَوانٍ يَعْتَبِرْن وصُدَّدُ",41,"د",1,0],["وبُدِّلْتَ منْ قَرْحٍ بِفَتْح مُسَيَّرٍ","بأمْثَاله غاظ الحسُودَ الْمَحَسَّدُ",41,"د",1,0],["وبُدُورٌ طوالعٌ من بدورٍ","وشموسٍ لا من دَياجيرَ سودِ",42,"د",1,0],["وبدت عليه من الحياء غَضاضةٌ","أو يرجعَ المرتاد وهو مُفادُ",43,"د",1,0],["وبدَّلتَ خبط العالمين هدايةً","وقد يهتدي أعمى بنور بصير",44,"ر",1,0],["وبدا به الجدريُّ فهْو كلؤلؤٍ","فوق العقيق منضَّد مسطور",45,"ر",1,0],["وبدْرٌ لبدرٍ بدا مُشْبِهاً","لوالدهِ غيرَ ما ظالم",46,"م",1,0],["وَبَدَت غِياضُ البُرتُقالِ فَأَشبَهَت","جِلبابَ خَودٍ بِالنُضارِ مُزَرَّرا",47,"ر",2,0],["وَبَدَت في الخَدِّ مِنهُ جَمرَةٌ","وَلَعَمري كَوَتِ الأَكبادَ كَيَّ",48,"ي",1,0],["وَبَدَت عُيوبي في الهَوى","مَن لي بِعَينٍ راضِيَه",49,"ي",2,0],["وَبَدَت مَعانيهِ وَقَد","رَقَّت كَما رَقَّ النَسيمُ",50,"م",1,0],["وَبَدا عَلى دَوحاتِهِ","ثَمَرٌ كَأَذنابِ الثَعالِب",51,"ب",1,0],["وَبَدرِيَّةٍ شَمطاءَ تَبني خِباءَها","عَلى بَرَمٍ عِندَ الشِتاءِ مُجَنَّبِ",52,"ب",1,0],["وَبَدا ما كانَ يخفى","وَفَشا ما كانَ يُستَرْ",53,"ر",1,0],["وبدت عليه ذلة فكأنما","صفعته كف الصبح فوق الاخدع",54,"ع",1,0],["وبدَّل حسن ذاك السمت قبحا","وأصناف النعيم به عذابا",55,"ب",2,0],["وَبَدا مُحَيّاكَ الَّذي قَسَماتُهُ","حَقٌّ وَغُرَّتُهُ هُدىً وَحَياءُ",56,"ا",2,0],["وَبَدا المُلكُ مُلكُ عُثمانَ مِن عَل","ياكَ في الذِروَةِ الَّتي لا تُرامُ",57,"م",1,0],["وَبِدونِ ما أَنا مِن وِدادِكَ مُضمِرٌ","يُنضى المَطِيُّ وَيَقرُبُ المُستارُ",58,"ر",1,0],["وبدا من مستجن ال","طبع تلك الكامنات",59,"ت",1,0],["وبدء جنيننا صلصال طين","بدا من لينه حَمَأٌ سَنينُ",60,"ن",1,0],["وبَدَّلتْ خُضْرَ عناقِيدِها","بالأدهمِ اليحمومِ والأشهبِ",61,"ب",1,0],["وَبَدَأتَ في أَمرٍ فَعُد إِنَّ الفَتى","بادٍ لِما جَلَبَ الثَناءَ وَعائِدُ",62,"د",1,0],["وَبَديعٍ كَأَنَّهُ الزَهرُ الضا","حِكُ في رَونَقٍ الرَبيعِ الجَديدِ",63,"د",1,0],["وَبَدرَينِ أَنضَيناهُما بَعدَ ثالِثِ","أَكَلناهُ بِالإيجافِ حَتّى تَمَحَّقا",64,"ق",2,0],["وَبَدرٌ أَضاءَ الأَرضَ شَرقاً وَمَغرِباً","وَمَوضِعُ رِجلي مِنهُ أَسوَدُ مُظلِمُ",65,"م",1,0],["وَبَديهَةٍ مِن طَولِهِ لَم تُرتَقَب","وافاكَ مُبتَدِئاً بِها إِنعامُهُ",66,"م",2,0],["وبديعةٍ أضحَى الجمالُ شِعارَها","صَبَغَ الحياءُ رِداءَها وإزارَها",67,"ر",3,1],["وبَدَّلَني بأخدانِ المعالي","أُناساً فِعلُهُم شَيْنٌ وعَارُ",68,"ر",1,0],["وبدرٌ ما استسرَّ البدرُ إلا","تعالَى أن يُحيطَ به السِّرارُ",69,"ر",1,0],["وَبَدؤُهُمُ كانَ مِن رَبِّهِم","وَكُلٌّ إِلى رَبِّهِ عائِدُ",70,"د",1,0],["وَبُدِّلَ بِالبُسطِ فَرشَ الثَرى","وَريحَ ثَرى الأَرضِ مِن عِطرِهِ",71,"ر",2,0],["وَبَديعُ السَماءِ وَالأَرضِ يَكفي","كَ فَسَلِّم لَهُ وَأَنتَ مُطيعُ",72,"ع",1,0],["وَبَدا السَوادُ عَلى نَقاءِ خُدودِهِ","فَجَديدُهُ لِجَديدِها قَد أَخلَقا",73,"ق",2,0],["وَبَدا النَرجِسُ ما بَي","نَ أَقاحٍ مُستَنيرِ",74,"ر",1,0],["وَبَدا النَرجِسُ المُحَدَّقُ يَحكي","أَشيَباً فَوقَ رَأسِهِ طاسُ تِبرِ",75,"ر",1,0],["وَبَدا بِخَدَّيكَ السُوادُ فَزانَها","مِثلُ المَليحَةِ في الخِماءِ الأَسوَد",76,"د",1,0],["وَبُدِّلتُ مِن دُهمِ اللَيالي وَغَيرِها","لَدَيهِ بِأَيّامٍ مُحَجَّلَةٍ غُرِّ",77,"ر",1,0],["وَبَدا مُحَيّاهُ فَفَوَّقَ لَحظُهُ","نَبلاً يَذودُ بِشَوكِهِ عَن وَردِهِ",78,"د",2,0],["وَبَديعَةٍ نَظَرَت إِلَيَّ بِها العِدى","نَظَرَ الفَقيرُ إِلى الغَنِيِّ المُقبِلِ",79,"ل",1,0],["وبدا شاحباً كيوم قتيل","لم يكد يلثم الصباح المورَّد",80,"د",1,0],["وبديعةِ الثّمَرَاتِ تعبُرُ نحوها","عينايَ بحرَ عجائبٍ مسجورا",81,"ر",2,0],["وَبِدهمٍ تمرّ منها وشهبٍ","أمِنَ الليلِ والنهارِ خيولُ",82,"ل",1,0],["وبدا عليٌّ في سماءِ قتامها","قمراً وصالَ على الفوارس قَسْوَرا",83,"ر",2,0],["وَبَدا لَهُ أَنَّا بِأَلْسِنَةِ العلى","في جَوهَرِ 