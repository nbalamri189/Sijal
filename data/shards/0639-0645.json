""],[88,"الدهرُ بيَّن في كتابِ شهادة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19562&r=&rc=65",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""]],"verses":[["عَماعِمٌ لَمّا تَزَل أَسيافُهُم","عَماعِمَ الصيدِ وَأَقيادَ البُدُن",0,"ن",1,0],["عِمادُ أَبياتِهِم سُمرُ الرِماحِ وَمِن","أَطنابِها الخَيلُ تَعطو وَالأَناعيمُ",1,"م",1,0],["عَمري لَقَد قَذَفوا الكُروبَ بِفارِجٍ","مِنهُ وَقَد رَجَموا الخُطوبَ بِمِرجَمِ",2,"م",1,0],["عُمري لَقَد فَنِيَت مَحاسِنُ وَجهِهِ","فيها وَقَد بَقِيَت مَحاسِنُ فِعلِهِ",3,"ل",2,0],["عَمائِرُ مِن رَبيعَةَ أَنزَلَتهُم","أَعالي المَجدِ أَطرافُ العَوالي",4,"ل",2,0],["عَمَلٌ فاضِحٌ وَأَجمَلُ مِن بَع","ضِ الوِلاياتِ عُطلَةُ المَصروفِ",5,"ف",1,0],["عَمَّت عُقيلاً وَإِن خَصَّت بَني شَبثٍ","بِزلاءُ تَملَأُ أُذنَ السامِعِ الواعي",6,"ع",2,0],["عُمِّروا لَم يَعلَموا أَنَّ لَنا","جائِزَ الأَمرِ عَلَيهِم وَالإِمارا",7,"ر",2,0],["عُمرُ الفَتى شَبابُهُ وَإِنَّما","آوِنَةُ الشَيبِ اِنقِضاءُ العُمُرِ",8,"ر",1,0],["عَمائِمٌ مِنَ التَريكِ وُضَّحٌ","عَلى جَلابيبٍ مِنَ السَنَوَّرِ",8,"ر",1,0],["عُمري لَقَد أَغمَدتُ مِنكَ مُهَنَّداً","في التُربِ كانَ مُمَزِّقَ الأَغمادِ",9,"د",1,0],["عِمادُهُ أسَلٌ تَرْوى إذا اضْطَرَمَتْ","نارُ الوغى منْ دَمِ الجاني شَوارِعُهُ",10,"ع",2,0],["عَمرَكَ اللَهُ صُن حَديثَكَ هَذا","فَلَعَمري ما بي إِلَيهِ حَنينُ",11,"ن",1,0],["عَمي بَصَري فَلَيسَ يَرى جَمالاً","فَلَيسَ عَلى سِواكِ لَهُ دَليلُ",12,"ل",1,0],["عمرُ الفتى لو كان في كفِّه","رمى به بعد أحبَّائهِ",13,"ه",1,0],["عَمَرتُ الدَهرَ مُلتَمِساً بِجُهدي","أَخا ثِقَةٍ فَأَلهاني اِلتِماسي",14,"س",2,0],["عِمَامَةُ الْبُنِّيِّ مَشْهُورَةٌ","بالْحُسْنِ وَالإِقْبَالِ مَا أَقْلَلَهْ",15,"ه",1,1],["عِمَامَةٌ قَدْ ظَهَرَتْ فِي الأَذَى","كَأَنَّهَا الْفُقَّاعُ فِي الْمَزْبَلَهْ",15,"ه",1,0],["عَمَوا عَنْ سَنَا فَضْلِي فَضَلُّوا عَنْ الْهُدَى","هَوَى النَّفْسِ قِدْماً لِلرِّجَالِ قَتُولُ",16,"ل",1,0],["عمَرَتْ بحِلّة عامِرٍ وأعزِّها","عبْدِ العزيزِ بمُرْهَفٍ بتّارِ",17,"ر",1,0],["عَميمُ النّدى حتّى بماءِ شَبابِهِ","كَريمٌ بأفْواهِ المَواهِبِ مَشْكورُ",18,"ر",1,0],["عُمْرِيَ ما إنْ نالَني مِثْلُهُ","منْ ضَيْمِ سَبْتيٍّ ولا طَنْجي",19,"ج",2,0],["عُميٌ وَبُكمٌ لَيسَ يُرجى نَفعُهُم","وَزَعيمُعُم في النائِباتِ مُليمُ",20,"م",1,0],["عَمِلتُم عَلى عِزِّ الجَمادِ وَذُلِّنا","فَأَغلَيتُمُ طيناً وَأَرخَصتُمُ دَما",21,"م",2,0],["عَمَدَ الساقي لِأَن يَقتُلَها","وَهيَ بِكرٌ أَحصَنَت مُنذُ سِنين",22,"ن",1,0],["عُمري بِعُمرِكَ رَهنٌ","فَعِش أَعِش أَلفَ قَرنِ",23,"ن",1,0],["عَمِلتُ لِقَومِيَ جُهدَ المُقِلِّ","عَلى أَنَّهُ عَمَلٌ مُقتَضَب",24,"ب",1,0],["عَمِلتَ عَلى نَيلِ الخُلودِ فَنِلتَهُ","فَقُل في مَقامِ الشُكرِ يا رَبِّ أَوزِعِ",25,"ع",1,0],["عَمَدتَ لِشِعري وَلَم تَتَّئِب","تُعارِضُ جَوهَرَهُ بِالعَرَض",26,"ض",1,0],["عُمِّرَت حيناً وَماءَ ال","مُزنِ شَكلَينِ سَواءَ",27,"ا",2,0],["عُمِّرَ مَن يَعمُرُ ذا المَجلِسا","أَطوَلَ عُمرٍ يُبهِجُ الأَنفُسا",28,"س",2,1],["عَمي الَّذي طَلَبَ العُداةَ فَنالَه","بَكراً فَجَلَّلَها الجِيادَ بِكِنهَلا",29,"ل",2,0],["عُمْرُهُ وَالمَالُ قَدْ بُذِلاَ","قُرْبَةً فِ خِدْمَةِ الشَّعْبِ",30,"ب",1,0],["عَمَلٌ لا يُكَادُ يَقْضِيهُ إِلاَّ","مَجْمَعٌ بِالكَثِيرِ مِنْ أَعْوَانِهْ",31,"ن",2,0],["عُمَرُ الَّذِي اخْتَلَفَتْ صِفَاتُ كَمَالِهِ","وَجَلالُهَا وَجَمَالُهَا وَحَمَالُهَا سَيَّانِ",32,"ن",1,0],["عُمْرٌ قَطَعْتَ مَدَاهُ قَبْلَ أَوَانِ","خُذْ بِالمُخْلَّدِ وَاعْدُ مَا هُوَ فَانِ",33,"ن",1,1],["عُمْرٌ مَدِيدٌ تَقَضَّى فِي مُجَاهَدَةٍ","شَرِيفَةٍ بَيْنَ تَأْثِيلٍ وَبُنْيَانِ",34,"ن",1,0],["عِمَادٌ بِصَرْحِ المَجْدَ قَامُوا فَقُوِّضُوا","دِرَاكاً وَدُكَّ اليَوْمَ آخِرُ قَائِمِ",35,"م",1,0],["عُمْرٌ تَقَضَّى فِي جِهَادٍ لا تَنِي","فِيهِ وَلا يُلْهِيكَ عَنْهُ حُطَامُ",36,"م",1,0],["عُمَرٌ مَعَاذَ اللهِ أَنْ أَرْضَى بِهِ","بَعْلاً وَمَا أَرْضَاهُ فِي خُدَّامِي",37,"ي",1,0],["عُمْرٌ جَدِيدٌ بِالقِرَانِ صَفَا لَنَا","لا كَدَّرَتْهُ طَوَارِئُ الأيَّامِ",37,"م",1,0],["عُمانِيَّةٌ مَهرِيَّةٌ دَوسَرِيَّةٌ","عَلى ظَهرِها لِلحِلسِ وَالكورِ مِحمَلُ",38,"ل",1,0],["عُمارِيُّ النُجارِ كَأَنَّ جِنّاً","يُعاوِدُهُ إِذا خافَ الرَحيلا",39,"ل",2,0],["عَمٍ شَرَكُ الأَقطارِ بَيني وَبَينَهُ","مَراريُّ مَخشيٍّ بِهِ المَوتُ ناضِبِ",40,"ب",1,0],["عميدَ بني الأنصار غير مدافع","ومحيي معاليها ومولى مواليها",41,"ي",3,0],["عما قريبٍ ترى الأعيادَ مُقبلةً","من الفتوح ووفدُ النصر حاديها",42,"ي",3,0],["عمروا بها جناتِ عدن زُخرفت","ثم انْثَنَوْا عنها ديار بَوارِ",43,"ر",1,0],["عمّت الناس بالغرام فكلّ","قد غدا عاشقاً لها ورقيبا",44,"ب",2,0],["عَمداً حَزَزتُ أُنوفَ تَغلِبَ مِثلَ ما","حَزَّ المَواسِمُ آنُفَ الأَقيانِ",45,"ن",1,0],["عَمِرَت مُكَرَّمَةَ المَساكِ وَفارَقَت","ما مَسَّها صَلَفٌ وَلا إِقتارُ",46,"ر",1,0],["عَمداً عَمَدتُ لِما يَسوءُ مُجاشِعاً","وَأَقولُ ما عَلِمَت تَميمٌ فَاِسمَعوا",47,"ع",3,0],["عِمادُ تَميمٍ كُلِّها وَلِسانُها","وَناطِقُها البَذّاخُ في كُلِّ مَنطِقِ",48,"ق",1,0],["عَمروٌ وَسَعدٌ يا فَرَزدَقُ فيهِمُ","زُهرُ النُجومِ وَباذِخاتُ الأَجبُلِ",49,"ل",1,0],["عَمداً رَمَيتُ اِبنَ مَكحولٍ بِدامِغَةٍ","حَتّى اِستَدارَ بَواهي الرَأسِ مَأمومِ",50,"م",1,0],["عَمداً أُعَرِّفُ بِالهَوانِ مُجاشِعاً","إِنَّ اللِئامَ عَلَيَّ غَيرُ كِرامِ",51,"م",1,0],["عَميدُ أُناسٍ قَد أَتى الدَهرُ دونَهُ","وَخَطّوا لَهُ يَوماً مِنَ الأَرضِ مَضجَعا",52,"ع",2,0],["عَمروُ اِبنُ أَوسٍ إِذا أَشياعُهُ غَضِبو","فَأَحرَزوهُ بِلا غُرمٍ وَلا عارِ",53,"ر",1,1],["عَمَدتُ مِنها لِكَبيرٍ مُفرَدِ","يَمشي بِعُنقٍ كَالرَشاءِ المُحصَدِ",54,"د",1,0],["عَمُّ النَبِيِّ وَصُنوُ والِدِهِ الَذي","وَرِثَ النَبِيَّ بِذاكَ دونَ الناسِ",55,"س",1,0],["عمري لقد قل صفو العيش من بشر","وكيف لا وهو من طين ومن ماء",56,"ا",2,0],["عمت مكارمهُ وسارَ حديثهُ","فبكلِّ أرض نعمةٌ وثناء",57,"ا",2,0],["عمرت من ذا وذا صرحين قد شكرا","يقظان من ذا الذي لم يمس شاكره",58,"ر",2,0],["عملت للمولى الذي ذاته","على فنون الفضل مجموعه",59,"ع",2,1],["عملتْ لمن جود أقلامه","ربيع ومنطقه بارع",60,"ع",1,1],["عمامتي كبرتها غالطاً","فقيل لي باردة جزلهْ",61,"ه",1,1],["عمري لقد صرخ الناعون في رجبٍ","فأسمعَ النوح شجواً من به صمم",62,"م",1,0],["عمري لقد زهت الأمصار حين محى","عليّ عنها دياجي الظلم والظَلم",63,"م",1,1],["عمرت بيت ولاءٍ فيكَ أو مدَحٍ","حتَّى كأنِّي سلمانٌ وحسَّان",64,"ن",1,0],["عمرية أعراقه علوية","ومديحه لمكرريه شهٍ شهي",65,"ه",2,0],["عَمَرنا بها الأيام في ظل ماجدٍ","له الرتبة العلياءُ والمثلُ الأعلى",66,"ا",1,0],["عَمِرتَ والمولودَ حتى ترى","أولادَهُ خلفكُما موكبا",67,"ب",2,0],["عمىً من الجهل أدَّاهُ إلى عَطَبٍ","وغيرُ بدْعٍ عمىً أدى إلى عَطَبِ",68,"ب",1,0],["عَمَّرَكَ اللًّهُ في السُّرور وأعْ","لاَكَ بتلكَ العُلاَ عَنِ المِدحِ",69,"ح",1,0],["عَمِيدَيَّ ما بالي حُرمت جَداكما","ورأيُكما رأيٌ وعهدكما عهْدُ",70,"د",1,0],["عُمِّرْتَ تنهض في مَراقٍ عَفْوُها","عفوُ الحُدور وأنت في إصعادِ",71,"د",1,0],["عَمَّتْ أيُورَ النائكي","نَ بِنَيْلها وبرفْدِها",72,"د",3,0],["عمِيتَ لأنها جعلتك نصباً","تَهدَّفُه غراميل العبيدِ",73,"د",1,0],["عَمرْتُ دهراً أراهُمُ عُقَداً","لنائبات الزمان مُعتَقَدَهْ",74,"د",2,0],["عَمَر الله اللذاذاتِ به","تحت أيام اسمه ذات الرَّذاذِ",75,"ذ",1,0],["عُمِّرت ياابن سعيدٍ","ما سرك التعمير",76,"ر",1,0],["عمَّره اللَّه وأبقى لهُ","رُكنيه من عز ومن قدرهْ",77,"ر",2,0],["عمروٌ أخوك أصَبْتُهُ","لي مكسباً فأفدتُ وَفرا",78,"ر",2,0],["عَمِروا حِقبَةً كثُلَّةِ ضأنٍ","خُلِّيَت بينها سَراحين مُعط",79,"ط",1,0],["عمر الإله بعمره في غبطة","خططاً تضيء بوجهه ورُبوعا",80,"ع",2,0],["عم التدابير إلطافاً يردُّ به","على الأواخيِّ إثخاناً وإكثافا",81,"ف",2,0],["عمَّ ألطافاً وبرّاً","إذ جفا الدهر وعقّا",82,"ق",2,0],["عمَّ الأذينُ بإذْنه وتخلفت","حالي فلم أُذْكر ولم أتوهمِ",83,"م",1,0],["عُمِرا برهةً على دين كسرى","وهما الآن بعده مُسلمان",84,"ن",1,0],["عمن يُصانُ الشعر من بعدما","صار لك اسمٌ في دواوينه",85,"ن",2,0],["عما قليل سينبو","بك الفراشُ الوَطيُّ",86,"ي",1,0],["عَمَدتَ إِلى رَبيعَةَ تَغتَزيها","بِمِثلِ القَملِ مِن أَهلِ الحِجازِ",87,"ز",1,0],["عَمَدتُم إِلى شِلوٍ تُنوذِرَ قَبلَكم","كَثيرِ عِظامَ الرَأسِ ضَخمُ المُذَمَّرِ",88,"ر",1,0],["عَمرٌ صَديقٌ كانَ يَحلِفُ لي","إِن نُحتُ ناح وَإِن شَدَوتُ شَدا",89,"د",2,0],["عُمَيرِيَّةٌ حَلَّت بِرَملِ كُهَيلَةٍ","فَبَينونَةٍ تَلقى لَها الدَهرَ مَربَعا",90,"ع",2,0],["عُمُرٌ مَيِّتٌ وقلبٌ خَواءٌ","ودمٌ لا تُثيرُهُ الآلامُ",91,"م",1,0],["عمَّا تحجِّبُهُ الكَواكبُ خلفَها","مِنْ سِرِّ هذا العالَم المستورِ",92,"ر",1,0],["عمدت إلى الشورى فسنت مجلساً","فيهِ