{"poems":[[55,"وفى بمواعيد الخليط وأخلفوا","https://www.aldiwan.net/poem29968.html","الطويل"],[65,"بعيشكما يا صاحبي دعانيا","https://www.aldiwan.net/poem46218.html","الكامل"],[57,"أيا وحشتا لانقطاع الرسول","https://www.aldiwan.net/poem26289.html","المتقارب"],[74,"أيا واحدا بالمن منه وبالثنا","https://www.aldiwan.net/poem20519.html","الطويل"],[47,"أبيني لنا أيها الواسعه","https://www.aldiwan.net/poem65134.html","المتقارب"],[51,"أيا ويح قلبي من نجي البلابل","https://www.aldiwan.net/poem64301.html","الطويل"],[46,"أيا ويل الشجي من الخلي","https://www.aldiwan.net/poem30326.html","الوافر"],[35,"أيا ويح من أمسى يخلس عقله","https://www.aldiwan.net/poem25988.html","الطويل"],[104,"أعيدي إلى المضنى وإن بعد المدى","https://www.aldiwan.net/poem33100.html","الطويل"],[54,"أيا وادي الأحباب سقيت واديا","https://www.aldiwan.net/poem26567.html","الطويل"],[54,"أيا ويحه ما ذنبه إن تذكرا","https://www.aldiwan.net/poem27049.html","الطويل"],[48,"أيا والي المصر لا تظلمن","https://www.aldiwan.net/poem23005.html","المتقارب"],[78,"أيا ويح نفسي وويل أمها","https://www.aldiwan.net/poem38881.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55240","الخفيف"],[35,"أيَا وَيْحَ مَنْ أمسَى يُخَلَّسُ عَقْلُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=2588",""],[132,"أتاني كتاب من شقيقى ووالدى","https://www.aldiwan.net/poem50625.html","الطويل"],[136,"خليلى لا لا تبديبا لى التلكيا","https://www.aldiwan.net/poem54683.html","الطويل"],[146,"أيا ولد الحصين وما حصين","https://www.aldiwan.net/poem58367.html","الوافر"],[208,"بوصل الحبيب تطيب الحياة","https://www.aldiwan.net/poem53182.html","المتقارب"],[214,"أماني الهنا بالحمد وافت وبالشكر","https://www.aldiwan.net/poem13524.html","الطويل"],[275,"حديثك من مقامات البديع","https://www.aldiwan.net/poem35015.html","الوافر"],[275,"بكيت لباك واشتكيت لشاك","https://www.aldiwan.net/poem35624.html","الطويل"],[276,"رياض نجد بكم جنان","https://www.aldiwan.net/poem52050.html","مخلع البسيط"],[369,"أيا ولي الدولة المرتجى","https://www.aldiwan.net/poem60856.html","السريع"],[369,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[382,"أيا وامقي ألبكر مريم لا تنوا","https://www.aldiwan.net/poem59131.html","الطويل"],[382,"عد الدهر حتى انقض كوكبه الدري","https://www.aldiwan.net/poem59424.html","الطويل"],[382,"تنبه دهري من عهود معاهدي","https://www.aldiwan.net/poem59454.html","الطويل"],[385,"لئن حل في دين الهوى لكم ظلمي","https://www.aldiwan.net/poem49259.html","الطويل"],[408,"أيا وجد أبقيت حتى على صبري","https://www.aldiwan.net/poem46745.html","الطويل"],[469,"أيا واعدي يوم الوصال وأنني","https://www.aldiwan.net/poem3368.html","عموديه"],[519,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[580,"يقولون لم خلى هواه فلانه","https://www.aldiwan.net/poem2849.html","الطويل"],[580,"دنوت وقد أبدى الكرى منه ما أبدى","https://www.aldiwan.net/poem3082.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126722","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122751","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122808","الوافر"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137335",""],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105474","الوافر"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16930","الوافر"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35376","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80239","الطويل"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111170","المتقارب"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6780","السريع"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144781","الطويل"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124296","الطويل"],[1847,"","https://poetry.dctabudhabi.ae/diwan/poem/27014","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120568","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60840","الطويل"],[2456,"","https://poetry.dctabudhabi.ae/diwan/poem/121890","الطويل"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100441","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111244","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87802","الوافر"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87687","الوافر"],[2660,"","https://poetry.dctabudhabi.ae/diwan/poem/203388","المتقارب"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83212","الوافر"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58285","المنسرح"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100715","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100836","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89433","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108378",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91769","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135784","الرجز"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32431","الطويل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111061","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94608","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94436","الطويل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62156","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33603","الوافر"],[4679,"يجد الفتى كما يعيش مُخلَّدَا","https://www.poetsgate.com/ViewPoem.aspx?id=142735",""],[4830,"صريعُ الفاتنات","https://www.poetsgate.com/ViewPoem.aspx?id=211103",""],[4830,"فَوا حَرَّ قلباه","https://www.poetsgate.com/ViewPoem.aspx?id=214347",""],[4929,"جمالك ماله ثاني","https://www.poetsgate.com/ViewPoem.aspx?id=199239",""],[4978,"تشطير وطني","https://www.poetsgate.com/ViewPoem.aspx?id=177411",""],[4984,"حي الفريقين","https://www.poetsgate.com/ViewPoem.aspx?id=175837",""],[4984,"يَوْمُ الْاسْتِقْلَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=204988",""],[5020,"أيا وقفبة البين ماذا شببت","https://www.poetsgate.com/ViewPoem.aspx?id=201049",""],[3271,"التائهة","https://www.poetsgate.com/ViewPoem.aspx?id=131013",""],[5200,"أيا واحد الناس فى قوله","https://www.poetsgate.com/ViewPoem.aspx?id=200796",""],[5282,"للقصيد وطن","https://www.poetsgate.com/ViewPoem.aspx?id=213986",""],[5320,"تقدم يا رخاء","https://www.poetsgate.com/ViewPoem.aspx?id=43108",""],[5365,"وطن المعجزات","https://www.poetsgate.com/ViewPoem.aspx?id=191266",""],[5431,"وطني...","https://www.poetsgate.com/ViewPoem.aspx?id=183069",""],[5431,"كربُ الشام","https://www.poetsgate.com/ViewPoem.aspx?id=183134",""],[5431,"أنوحُ وقد نجا بالركبِ نوحُ","https://www.poetsgate.com/ViewPoem.aspx?id=189541",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5660,"سَتُصبِحَ بِالهِجاءِ غَداً شَهيراً","https://www.poetsgate.com/ViewPoem.aspx?id=23781",""],[5689,"أهبت فنلت من قلبي الجوابا","https://www.poetsgate.com/ViewPoem.aspx?id=143429",""],[5847,"عمان في عيدها","https://www.poetsgate.com/ViewPoem.aspx?id=8560",""],[5865,"هذيان...","https://www.poetsgate.com/ViewPoem.aspx?id=179829",""],[5912,"نديمان","https://www.poetsgate.com/ViewPoem.aspx?id=205016",""],[5937,"موجزٌ عربي","https://www.poetsgate.com/ViewPoem.aspx?id=211884",""],[5957,"عروبي الهوى قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=194589",""],[5969,"إلى أبي","https://www.poetsgate.com/ViewPoem.aspx?id=198710",""],[6102,"نِهايَةُ المُسَلسَل","https://www.poetsgate.com/ViewPoem.aspx?id=182768",""],[6124,"ألحان الموج","https://www.poetsgate.com/ViewPoem.aspx?id=125195",""],[231,"الشاعر في وادي الموتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79142&r=&rc=17",""],[6251,"إلى الشيخ جابر الأحمد الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76467&r=&rc=7",""],[6262,"صديقي الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80127&r=&rc=25",""]],"verses":[["أَيا وَقفَةَ التَوديعِ هَل فيكِ راجِعٌ","إِشارَتَهُ ذاكَ البَنانُ المُطَرَّفُ",0,"ف",1,0],["أيا وارِثَ البُرْدِ المُعَظَّمِ رَبُّهُ","بَلغْنا المُنى حتى اقْتَسَمْنا التَّهانِيا",1,"ي",2,0],["أَيا وَحشَتا لِاِنقِطاعِ الرَسو","لِ مِمَّن أُسَرُّ بِأَخبارِه",2,"ر",2,1],["أيا واحداً بالمنِّ منه وبالثنا","تحلَّت رقاب للورى وشفاه",3,"ف",3,1],["أَيا وَهبُ لِم هَتَفَت بِالوَزي","رِ لَعَلَّكَ بَيَّتَّها جائِعَه",4,"ع",2,0],["أَيا وَيحَ قَلبي مِن نَجِيِّ البَلابِلِ","وَياوَيحَ ساقي مِن قُروحِ السَلاسِلِ",5,"ل",1,1],["أَيا وَيلَ الشَجِيِّ مِنَ الخَلِيِّ","وَبالي الرَبعِ مِن إِحدى بَلِيِّ",6,"ي",1,1],["أَيا وَيحَ مَن أَمسى يُخَلَّسُ عَقلُهُ","فَأَصبَحَ مَذهوباً بِهِ كُلَّ مَذهَبِ",7,"ب",1,1],["أيا وادي الرمان لا طِبْتَ وادياً","إذا هي لم تنعم بظلِّك سرمدا",8,"د",2,0],["أَيا وادِيَ الأَحبابِ سُقّيتَ وادِياً","وَلا زِلتَ مَسقِيّاً وَإِن كُنتَ خالِيا",9,"ي",2,1],["أَيا وَيحَهُ ما ذَنبُهُ إِن تَذَكَّرا","سَوالِفَ أَيّامٍ سَبَقنَ وَأَخَّرا",10,"ر",2,1],["أَيا والِيَ المِصرِ لا تَظلِمَنَّ","فَكَم جاءَ مِثلُكَ ثُمَّ اِنصَرَف",11,"ف",1,1],["أيا ويحَ نفسي وويلَ أُمِّها","لما لقيَتْ من جوَى همَّها",12,"م",3,1],["أَيَّ أَوْصَافِهِ أُعَدِّدُ وَالشَّ","يْءُ كَثِيرٌ فِيهِ الكَلامُ",13,"م",1,0],["أيَا وَيْحَ مَنْ أمسَى يُخَلَّسُ عَقْلُهُ","فأصبح مذموماً به كل مذهب",14,"ب",1,1],["أَيَا واحداً في هَجْرِه وجَفَائِه","أنا واجد في الشوق رفقا بواجد",15,"د",1,0],["أيَا وَغدُ لا تَفخَر فَلَستَ بِشَاعِرٍ","وَلَم تَكُ مِمَّن بِالجَزَالَةِ حُلِّيَا",16,"ي",2,0],["أيا وَلد الحُصَين وما حُصَينٌ","لماذا ضلَّ سعيُك هِجتَ حَربى",17,"ب",2,1],["أيا واحد الحسن يا من غدا","لهُ الحسنُ مُتَّبِعاً مُقتَسَمْ",18,"م",1,0],["ايا واحد العاليا لنحوك انني","جعلت التفاتي لا لزيد ولا عمرو",19,"ر",2,0],["أيا ولادةَ الشامِ اذكُريني","بما قدَّمتُ من حسنِ الصنيع",20,"ع",1,0],["أيا وردَتي في الوردِ والياسمين ما","يعيرُ شتائي من ربيع صِباك",21,"ك",1,0],["أيّ أوان تتوب فيه","هَل بعد قطع الرجا أَوان",22,"ن",1,0],["أيا وليَّ الدَّولةِ المُرتَجى","قَولُ وَليٍّ لكَ مُستَبْطِ",23,"ط",1,1],["أيا واحداً قد حَلّ للمجدِ ذِروةً","إذا حّلَّ كلٌّ في حواشٍ وأثْبُج",24,"ج",1,0],["أيا وامقي ألبكرِ مريمَ لا تَنوا","وهدُّوا قلوباً حاربتها العواذلُ",25,"ل",1,1],["أيا والداً أضحى له الدهر فاجعاً","بمولوده إن الخسوفَ إلى البدر",26,"ر",1,0],["أيا واحداً في الدهر والدهر قائلٌ","رعى اللَه قلبي ثم عيني وواحدي",27,"د",2,0],["أَيا وَيحَهُ ما آن أَن يَشتَفي وَقَد","تَوَلهت حَتّى صِرت أَسأل عَن اِسمي",28,"م",2,0],["أيا وجدُ أبقيتَ حتّى على صبري","ويا دمعُ أطلعتَ الوشاة على سرّي",29,"ر",2,1],["أيا واعدي يوم الوصال وأنني","لأقضي زمان العمر من قبل أن يقضي",30,"ض",2,1],["أيا وارِدي لُجَّ البِحار اِكْتَفوا به","فسَبْعَتُها في طيِّ أُنمُلِهِ العَشْرِ",31,"ر",1,0],["أَيا واحداً ديني عبادةُ واحدٍ","كَفَرْتُ بما بي إِنْ كفَرْتُ بثَانِ",32,"ن",1,0],["أَيا واحداً أَنْدى مِن الْخَلْقِ كلِّهم","ليْهنِك أَنِّي لم أَجِدْ منكَ لي بُدّاً",33,"د",2,0],["أيا وفد إيران الكرام الأماجد","ومَن هُم بأفقِ المكرُمات فراقدُ",34,"د",1,1],["أَيا وَلَهي أَلَيسَ لَكَ انصِرامٌ","وَيا نَدَمَى زَمانُكَ لي نَديمُ",35,"م",1,0],["أَيا وَقتي عَدَمتُكَ مِن وُقَيتٍ","وَيا زَمَني عَدِمتُك مِن زُمَينِ",36,"ن",1,0],["أَيا وطنَ الأُسودِ فدتك نفسي","وخيرُ الناس من ماتوا فِداكا",37,"ك",2,0],["أيا وادي المعالي إن شعري","لجيد علاك عقد من جمان",38,"ن",1,0],["أَيا وَرداً عَلى غُصنِ","بِكَرِّ اللَحظِ يَلقُطُهُ",39,"ط",2,1],["أَيا واثِقاً إِنّي بِجاهِكَ واثِقُ","وَإِنَّ وِدادَ العَبدِ فيكَ لَصادِقُ",40,"ق",1,1],["أَيا واحد الدُنيا وَيا بَطَل العُلى","وَيا هام مَجدٍ كَلَلتَهُ الفَضائِلُ",41,"ل",1,0],["أيا وحشة ما وعاها امرئ","وآنس في الدهر ايناسه",42,"س",2,0],["أَيا وَزيراً لَم يَزَل آخِذاً","عِندَ المُلِمّاتِ بِأَيدينا",43,"ن",2,1],["أيا واحد النقاد في النحو قد أتى","إلى سؤال حير الفكر وصفه",44,"ه",1,1],["أيا واهب النعمى لمن ليس أهلها","ومانحها عفوا لبَرّ وظالم",45,"م",1,0],["أَيا والِيَيْ أَهلِ المَدينَةِ رَفِّعا","لَنا غُرَفاً فَوقَ البُيوتِ تَروقُ",46,"ق",1,1],["أيا واحدي المعدود بالألف وحدَهُ","ويا ولدي البر الزكي إن ارتَضَى",47,"ض",2,1],["أيا واردينَ الماءَ من شعبِ رامةٍ","ألَمْ تَكفِكُم أمواه عيني موردا",48,"د",2,0],["أَيا ولدي قد زادَ قلبي تلهباً","وقد أُحرِقَت مني الخُدودُ الدوامِعُ",49,"ع",1,1],["أيا واهناً خصراً ومثر روادفاً","حناناً على ذاك الفقير من المثري",50,"ر",2,0],["أيا ويحها إني عفيف أما درت","وكم ذات خدر راودتني فبادرت",51,"ت",1,0],["أَيا وَرَقاتِ هَذا البَنكَنُوطِ","همُ قَد أَصدَروكِ بِلا شُروط",52,"ط",1,1],["أَيا وَرد الخُدود أَراك تَزهو","عَلى قَد يَميس كَخُوط بان",53,"ن",1,0],["أيا واحد العصر ما بلدةً","محاسنها في الورى تذكر",54,"ر",1,1],["أَيا وَطَني وَقاكَ اللَهُ عابا","وَبَلَّغَكَ المَقاصِدَ وَالرِغابا",55,"ب",2,1],["أَيا وَطَني أُجِلُّكَ في فُؤادي","لِما لكَ مِن حُقوقٍ لَن تُشابا",55,"ب",2,0],["أَيا وَطَني أُحابيكَ اِجتِهادي","وَحَقِّكَ مِن وَفَى في الحُبِّ حابى",55,"ب",2,0],["أيا وَزيراً أعيذُ مَنْصبَهُ","من كُلِّ عَين بايةِ الحرس",56,"س",1,1],["أيا واحد الدنيا عُلِ القوم تغتنم","أجلَّ جزاءٍ في أبرّ ثواب",57,"ب",1,0],["أيا وفد مصر أنت عنوان امة","به يعرف الاقدام والدأب والجد",58,"د",1,0],["أيا ولد الأراذل كيف تهجو","وإنك في العيوب بلا شبيه",59,"ي",2,0],["ايا وردة طل الندى منه قد جفا","وكان له درا به كان حاليا",60,"ي",2,0],["أَيا واقفاً بِالدار بَعدَ ارتحاليا","عَليكَ سَلامُ اللَه بَلِّغ سَلاميا",61,"ي",2,1],["أيا ودودُ يا زكيُّ يا حميدْ","يا طاهرٌ طهِّر لنا الطهرَ السعيدْ",62,"د",1,0],["أَيا وَيحَهُ لا الصَبرُ يَملِكُ قَلبَهُ","فَيَصبِرَ لَمّا قيلَ سارَ مُحَمَّدَ",63,"د",1,1],["أيا ورق الهنا بالبشر صدحاً","تنالي منة يا ورق منا",64,"ن",2,0],["أيا واعدي خيراً ألا انجز قضيتي","أليس الوفا بالمطل نقصاً بجودةِ",65,"ه",1,1],["أيا واحد الأكوان يا مفخر الحجى","ومدحة حمدٍ زيَّنت كل لهجةِ",66,"ه",1,0],["أيا واقفاً والترب بيني وبينه","ترحم على قبر الحبيب وسلم",67,"م",1,1],["أيا وَجداً يزيدُ على التنائِي","أيا شَوقاً إلى رَشأ رَخيمِ",68,"م",1,0],["أيا ويل أبناء البسيطة إنهم","نشاوى بخمر اللهو غابوا عن الهدى",69,"د",2,0],["أيا وِتْرَ الفؤادِ وليس مَثْنى","أتهجُرُ مَنْ يكونُ اِليكَ مَغْنى",70,"ن",2,1],["أيا وِتْرَ عشْقٍ سَما في الصّفاتِ","كَزيجَةِ قومِ النّبي اليسوعْ",71,"ع",1,0],["أيا واحاتِ أمنيتي","ويا أزهار نيساني",72,"ن",2,0],["أيا وطنًا بحجمِ الجرحِ فينا","( به عاث الثعالب والذئاب)",73,"ب",1,0],["أيا وطني نجواك سحر ولوعة","فجامك ما زلنا على إثره سكرى",74,"ر",2,0],["أَيَا وَقْفَةَ الْمُلْتَاعِ فِي سُدَّةِ الصِّبَا","تُرَاوِحُ فِي طَيَّات مَرْجِعِهَا الدَّانِي",75,"ن",2,0],["أيا وقفبة البين ماذا شبب","ت من النّار فى كبد المغرم",76,"م",1,1],["إياؤها يخزي صلاةَ الضحى","لو شبّها معبد أطيارِ",77,"ر",1,0],["أيا واحد الناس فى قوله","فليس به أحد يقرن",78,"ن",1,1],["أيا وطَن القصيدِ ومَن سِواكَ","يَصُونُ الضاد أو يَحْمي حِماكَ؟!",79,"ك",1,1],["أيا وطن الأباة لك التهانى","فهذا اسمك الغالى يسود",80,"د",1,0],["أيا وطنَ المواجعِ والمآسي","على كلِّ الدُّروبِ نُزعتَ نابَا",81,"ب",2,0],["أيا وطني..شغفتَ الروحَ وجدا","أيا وطني....أتبكي مُقلتاك؟",82,"ك",1,0],["أيا وطني مكانك عمق روحي","وينبت رائعا عذبا هواك",82,"ك",1,0],["أيا وطناً...أيا طهراً زُلالا","لقد عاثَ الغزاةُ بكَ افتعالا",83,"ل",2,0],["أيا وطني الجريح فدتك روحي","وأنت لاعذب الأرواح روح",84,"ح",1,0],["ايا وطني أمِنْ زمنٍ","جفاك الاهل لاتعدا",85,"د",2,0],["أَيا واهي البَلاغَةِ وَلِّ عَنّي","فَإِنَّ قَصيدَكَ الواهي وَشاكَ",86,"ك",1,0],["أيا وطني أتيتك بعد فقد","دفنت بأرض غربتي الشبابا",87,"ب",2,0],["أيا وطنا سطرته أياد","من النور يزري بوجه الظلم",88,"م",1,0],["أيا وطني المعلّقَ في فؤادي","علقتُ بحبّكَ المحشوِّ درّا",89,"ر",2,0],["أيا وردُ أَزْهِرْ بلونِ ربيعي","وهدهدْ بعطرٍ نفوسَ الحيارى ..",90,"ر",2,0],["أيا وطناً يعيش الطير فيه","لكي يبتاعَ خُبزًا بالجناحِ",91,"ح",1,0],["أيا وطناً تمنى الشمع فيهِ","بأن يحيى ، ولو بفم الرياحِ",91,"ح",1,0],["أيا وطنا ً يمر العمر أوهاما ً على","جسدي ونار الحزن تكويني",92,"ن",2,0],["أيا والدي قَدْ أَتانا الصَباحُ","مِنَ الفَجرِ نَصحو لأنَّكَ فيه",93,"ي",2,0],["أَيا وَغدُ؛ الخِيانَةُ مُستَقَرٌّ","عَلَيها كُلُّ خَوَّانٍ تَأَصَّلْ",94,"ل",1,0],["أَيَا وَاعِدًا قَلْبِيْ شُمُوسًا نَسَائِمًا","تََفِيْضُ عَلَىْ كَفٍّ خَصِيْبِ الغَمامِ",95,"م",1,0],["\" أيا ويلها تلك الحياة وأهلها","تكشف عن بلوائها كل ساتر \"",96,"ر",1,0],["أَيَا وَاسَعُ الْنَّاسِ الخَصِيْبُ جِنَابُهُ","وَيَا طَيِّبَاً أَهْدَاهُ لِلْنَّاسِ طَيِّبُ",97,"ب",1,0],["أيا وطناً مِنْ جراحِ النبيين (م)","مِنْ أدمعِ الشهداءِ السعيده",98,"د",2,0]]}