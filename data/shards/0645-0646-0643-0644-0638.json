{"poems":[[295,"لقد لقيت صباحاً","https://www.aldiwan.net/poem11657.html","المجتث"],[309,"يا من هواهم أقام","https://www.aldiwan.net/poem16886.html","المجتث"],[369,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[469,"ثنت الشمول من الشمائل","https://www.aldiwan.net/poem3447.html","عموديه"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120024","الكامل"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143131","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127971","الكامل"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113030","السريع"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130556","الكامل"],[5213,"ما هز عطف الصب صبوه","https://www.poetsgate.com/ViewPoem.aspx?id=170568",""],[469,"زهر الحجى سمر القنا سود الوغى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574760",""]],"verses":[["من كلّ ظبي غرير","قد أخجل المصباحا",0,"ح",2,0],["من كل ظالم جهول كدر علينا الصفا","يا ربنا يا سلام غثنا بخير البشر",1,"ر",1,0],["من كلِّ ظاعنةٍ أقامَ خيالُها","ومضَتْ تَروحُ بها الرِكابُ وتغتَدي",2,"د",2,0],["من كل ظامية الوشا","ح كتربها ريَّا الخلاخلْ",3,"ل",1,0],["من كل ظامية الموشح وجهها","صبح وفاحمها الأثيث ظلامُ",4,"م",1,0],["من كلِّ ظمآن الفؤاد الى الرَّدى","بيديه ريان الشفار طريرها",5,"ر",3,0],["من كل ظبى في لواحظه الظبا","يغنى السردية ردفه المردوف",6,"ف",1,0],["من كل ظبيٍ قضفٌ قدُّه","لا البان يحكيه ولا الرَّندُ",7,"د",1,0],["من كل ظامئة الوشاح خريدة","وأغن مخطوف الحشاشة ظامي",8,"م",2,0],["من كل ظمياء الوشاح","ورية الخلخال عطوه",9,"و",2,0],["من كلِ ظبيٍ دونه ليثُ شرىً","ليسَ له غيرُ قنا الخطِّ أجم",10,"م",1,0]]}