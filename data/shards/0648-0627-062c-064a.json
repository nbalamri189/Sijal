{"poems":[[55,"إن لم أطع همما وأعص عواذلا","https://www.aldiwan.net/poem29863.html","الكامل"],[65,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[3,"يا عبل أين من المنية مهربي","https://www.aldiwan.net/poem116.html",""],[45,"لعينيك ما يلقى الفؤاد وما لقي","https://www.aldiwan.net/poem9733.html","الطويل"],[68,"خطب لسان الحال فيه أبكم","https://www.aldiwan.net/poem41549.html","الكامل"],[99,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[69,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[52,"أمن الحوادث والهوى المعتاد","https://www.aldiwan.net/poem63910.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[102,"صياد البروق","https://www.poetsgate.com/ViewPoem.aspx?id=50408",""],[3,"يا عَبلُ أينَ من المَنيَّة ِ مَهْربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10773&r=&rc=127",""],[159,"يا من نفت عني لذيذ رقادي","https://www.aldiwan.net/poem55488.html","الطويل"],[354,"وآجيرة جاءت بحسن مبدع","https://www.aldiwan.net/poem15843.html","الكامل"],[422,"أتراك تعرف علتي وشفائي","https://www.aldiwan.net/poem54187.html","الكامل"],[458,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[463,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[578,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62659","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59416","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115999","الكامل"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67397","الخفيف"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144760","الكامل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95376","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48305","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61263","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91384","الكامل"],[3766,"","https://poetry.dctabudhabi.ae/diwan/poem/198811","الطويل"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122226","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40096","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90741","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91002","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90814","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72587","الرمل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76722","الطويل"],[4755,"يا أَسَانا.. أَمَا لَنا مِنكَ مَخرَجْ !","https://www.poetsgate.com/ViewPoem.aspx?id=210324",""],[4869,"احبك لحالك","https://www.poetsgate.com/ViewPoem.aspx?id=151550",""],[4929,"يارب أقمِ الساعه","https://www.poetsgate.com/ViewPoem.aspx?id=199711",""],[5072,"أنت الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=52568",""],[5252,"اشلونك","https://www.poetsgate.com/ViewPoem.aspx?id=36106",""],[5536,"صرح فرعون!!","https://www.poetsgate.com/ViewPoem.aspx?id=27509",""],[5563,"في حادثة نيوزيلندا","https://www.poetsgate.com/ViewPoem.aspx?id=212765",""],[5790,"الله أكبر أي طرف يطمح","https://www.poetsgate.com/ViewPoem.aspx?id=111868",""],[6056,"شيخة القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=130570",""],[6093,"النت ( مجزوء الكامل المرفل)","https://www.poetsgate.com/ViewPoem.aspx?id=181568",""],[463,"سلكَ الخيالُ بحاجرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60161&r=&rc=217",""]],"verses":[["وَأُجيعُ أَعياساً وَأُشبِعُ صارِماً","وَأَعُلُّ خُرصاناً وَأُظمىءُ صاهِلا",0,"ل",2,0],["وأُجيلُ في تلكَ المَعاهِدِ ناظِري","فالقَلبُ يعرِفُها وطَرْفي يُنكِرُ",1,"ر",1,0],["وَأُجيبُها إِمّا دَعَت لِعَظيمَةٍ","وَأُغيثُها وَأَعِفُّ عَمّا ساها",2,"ا",3,0],["وَأَجيادِ غِزلانٍ كَجيدِكِ زُرنَني","فَلَم أَتَبَيَّن عاطِلاً مِن مُطَوَّقِ",3,"ق",1,0],["وَأُجيلُ عَيني في الحُبوسِ فَلا أَرى","إِلا اِبنَ جاري أَو غُلاماً يَخدُمُ",4,"م",1,0],["وأجيل عين الريب ملتفتاً","متطلعاً للباب حيرانا",5,"ن",2,0],["وأُجِيبَ داعِيها لِرَدِّ مُشَرَّدٍ","مِنْ أمْرِها طَوْعَاً وَجمْعِ مُبَدَّدِ",6,"د",1,0],["وَأُجيبُ قائِلَ كَيفَ أَنتَ بِصالِحٍ","حَتّى مَلِلتُ وَمَلَّني عُوّادي",7,"د",2,0],["وأجيءُ الأرضَ من محورها","فإذا بي يتدانى قطباها",8,"ا",3,0],["وأجيء من نار البروق","يسنبل الأشواق رعدي",9,"د",2,0],["وأُجيبُها إمَّا دَعتْ لِعَظيمة ٍ","وأعينها وأكفُّ عَّما ساها",10,"ا",3,0],["وَأُجيلُ مِنكِ نَواظِري في ناضِرٍ","مِن خَدِّكِ المُتَرَقرِقِ الوَقادِ",11,"د",1,0],["وَآجيرَةً جاءَت بِحُسنٍ مُبدِعٍ","نَسَخَ الغَرامَ بِكُلِّ عِشقٍ أَوَّلِ",12,"ل",1,1],["وأجيبُ سائلَ مهجتي عن دائها","دائي هواك فلا بليت بدائي",13,"ا",2,0],["وأجئ زائركَ الوفَّى كأنني","لم افتقدكَ ولم يكن إلمامي",14,"م",2,0],["وأجيلُ كفّي أستعي","ذُ ببُردِه أتعلّقُهْ",15,"ق",2,0],["وَأَجيلُ لَحظي في المُنى شَغَفاً بِها","وَأَجَلُّ شَوقي عَن لَعَلَّ وَعَن عَسى",16,"س",2,0],["وأُجيزَ صَومُ الدهر إلا ما استوى","في الفِطر فيه ساكنُ الغبراءِ",17,"ا",2,0],["وأجيل طرف المدح فيك ولم أدن","ألا لحبك في الحديث وفي القديم",18,"م",1,0],["وأجيل طرفي في البقيع وحبذا","روض يروق العين موسمه الوسيم",18,"م",1,0],["وأجيل في المسعى جواد تملق","جادت محاجره بسحب هطل",19,"ل",1,0],["وأجيبُ داعية الكفاحِ مبادراً","كالماء يستدعى العطاشَ الهيما",20,"م",2,0],["وأجيري مسخر ينقل الأت","بان بالذل عارياً والهوان",21,"ن",1,0],["وَأجيْنَاكَ إذْ دَعَوْتَ إلى الشَ","ام عَلَى الْقُبِّ كالسَّحُونِ الْعِتَاقِ",22,"ق",1,0],["وأجيل في تلك المعاهد مقلة","جادت مواطرها بكل صبيب",23,"ب",1,0],["وأجيبوا فها المدراج صفت","في ضواحي الميماس بين الزهور",24,"ر",1,0],["وَأُجِيبَ عَنهُ بِأنَّهُ أسرِى بِهِ","لِيَرَاهُ ثَمَّ مُشَاهِداً بِعَيَانِ",25,"ن",1,0],["وأجيب عنه بأنه نوع سوى ال","معهود في الدنيا من النسوان",25,"ن",1,0],["وأجيبُ من قدْ لامَني في ذكرِها","دارُ الحَبيبِ أحقُّ أن تهْواها",26,"ا",3,0],["وَأَجيبُ داعِيَةَ التَصابي مُلقيا","رَسَني إلَيهِ يُضِلُّ أَو يَهديني",27,"ن",2,0],["وَأُجيلُ طَرفي في محاسنه وَفي","خلدي يَجول لهُ الخَيالُ المُطلق",28,"ق",1,0],["وأجيال لا تنسى سترويه قصة","ووبل به يخضرُّ للأهل مجدب",29,"ب",1,0],["واجير لكسر قلوب الخلق اجمعهم","واكفيهم السوء من ضر ومن ألم",30,"م",1,0],["وَأُجيل عَيني في علائك ناظِراً","فأَخِيطُ منه على الثَّنا ما فَصَّلَهْ",31,"ل",2,0],["وأجيبوا علاى صماع الأغاني","داعي اللهو بين مرد وحور",32,"ر",1,0],["وأجيبوا دعوة الداعي إلى","نغمة العود ونقر الوتر",33,"ر",1,0],["وأجيبوا على سماع الأغاني","داعي اللهو بين مرد وحور",34,"ر",1,0],["وأجيل الفكر في درك معانيه مدام","مثل ما جال كميت أكف الساقي",35,"ق",2,0],["وأجيادها مالت عليك نواعماً","كما مالت الاغصان فانعم بها لمسا",36,"س",2,0],["وأَجِيبي؛ إِلى متى سَوف نَشقَى","فِيكِ.. والأَرضُ كَالسَّمَا تَتَفَرَّج",37,"ج",1,0],["واجي من اقصآيه وانا اقول جآلك","جآلك حبيبك دمْع عينه يهلّه",38,"ل",2,0],["وأُجِيئَ بإسلامٍ كَذِبٍ","للكفر نِتَاجٌ وصِنَاعهْ",39,"ع",2,0],["وأجيبُه ُ - وأنا الوحيد ُ بعبرتي","لا أستفق ْ - : لك َ في الوجود ِ مُحَصّلَه",40,"ل",2,0],["واجيك شاري الموت بعيونك","هواك يا المجمول يحداني",41,"ن",2,0],["واجيب البيت صاحي كامل العقل ويجي مجنون","واجيب البيت مجنون وتزيد جنون حساده",42,"د",2,0],["وأجيرٍ من بني قومي يماري","ويرى أنَّ استباقَ الحكمِ قاسي",43,"س",2,0],["وأجيل في ملكوت قدسك ناظرا","ما زال يغبق بالنسيم ويصبح",44,"ح",1,0],["وأجيبه من شواهيق الغمام بعالي الآفاق","وأسوقه نوّ ، لرياض الحشا يسقي نباتاته",45,"ت",2,0],["وأُجِيْبُ آخرَ بالعرا","قِ وما ارتحلتُ ولا انتقلتُ",46,"ت",1,0],["وأجيلُ كفّى أستعي","دُ ببردهِ أتعلّقهْ",47,"ق",2,0]]}