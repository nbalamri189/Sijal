{"poems":[[79,"إن كانت الجنة موجودة","https://www.aldiwan.net/poem35711.html","السريع"],[79,"يا بقعة بالجمد معروفة","https://www.aldiwan.net/poem35906.html","السريع"],[53,"عيني هذا ربيع الدمع فاحتشدا","https://www.aldiwan.net/poem62985.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54749","الخفيف"],[406,"ياشذا المجد أين بغداد عنا ؟!","https://www.aldiwan.net/poem6735.html","عموديه"],[447,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54042","السريع"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129534","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72332","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48983","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48977","الخفيف"],[2175,"","https://poetry.dctabudhabi.ae/diwan/poem/101278","البسيط"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67867","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202869","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115655","الرجز"],[3242,"","https://poetry.dctabudhabi.ae/diwan/poem/124098","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127077","الخفيف"],[5039,"سبحة الكهرمان","https://www.poetsgate.com/ViewPoem.aspx?id=48132",""],[5213,"يا بقعة تحيى الفروض والسنن","https://www.poetsgate.com/ViewPoem.aspx?id=170394",""],[5356,"فلترحلي","https://www.poetsgate.com/ViewPoem.aspx?id=196980",""],[5409,"لا عشت لصاً في ثياب عسيس","https://www.poetsgate.com/ViewPoem.aspx?id=155282",""],[6355,"متى يطهر التراب؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66581&r=&rc=41",""]],"verses":[["يا بُقْعَةً فازَ بِها المُشْتَري","فأمُّ مَنْ خلّفَها هاوِيَهْ",0,"ه",1,0],["يا بُقْعَةً بالجَمْدِ مَعْروفَةً","تحْذَرُها الشّمْسُ فَلا تُشْرِقُ",1,"ق",1,1],["يا بقعةً قُدِّرت فيها حفيرتُها","لقد خُصِصتِ بتقديس وتطهير",2,"ر",1,0],["يَا بَقَايَا مِنْ هِمَّةٍ تَتَلاشَى","لاَ تَضَنِّي عَلَيَّ بِالإِسْعَادِ",3,"د",1,0],["يا بقلبي تلكَ المَغاني أَراها","تتلوَّى من قَسْوةِ الإحراقِ",4,"ق",1,0],["يا بقلبي وجهَ المروءاتِ أمسى","كالحاً من تسلُّطِ الفُسَّاقِ",4,"ق",1,0],["يا بقلبي صوتَ الحقيقةِ لمَّا","ضاع منَّا في ضَجَّة الأبواقِ",4,"ق",1,0],["يا بقعة ضمت فضائل أحمد","في أحمد عن سائر الدقعاء",5,"ا",2,0],["يا بُقعةً شرَّفها اللهُ","ماذا بحبّي فيكِ ألقاهُ",6,"ه",1,1],["يا بقعة حسر الجما","ل لدى معالمها لثامه",7,"م",2,1],["يا بقعة بالطف حشو","ترابها دنيا ودين",8,"ن",1,0],["يا بقايا محمدٍ من هو الزا","ئرُ طيَّ الأَكفانِ دون فؤاد",9,"د",1,0],["يا بقايا نعّومٍ عُدتِ لواديكِ","فناجي الجدودَ في ظِلّ بانِهْ",10,"ن",2,0],["يا بقعة بزغت كالشمس في أفق","قد ضم خير سراة الأرض ناديك",11,"ك",1,1],["يا بقايا السَّلفِ الصَّا","لحِ والتَّجرِ الرَّبيحِ",12,"ح",1,1],["يا بقلةً نبتتْ عندي بمزهرة","ظللت بالسقي كالأزهار أشملها",13,"ه",2,1],["يا بقّاءَ مهجتي","بنارها تحترِقُ",14,"ق",1,0],["يا بقعة شرفت بالهاشميّ فدى","لك الشريف وذات الرمث من أجلا",15,"ل",2,0],["يا بقاع الطفوف طاب ثراك","وسقى الوابل الملث حماك",16,"ك",1,1],["يابقايا فتات الفص من خاتم عقيق","هو متى قد سمعت ان الذهب يوم خان",17,"ن",1,0],["يا بقعة تحيى الفروض والسنن","بها بذكر الله في مدى الزمن",18,"ن",1,1],["يا بقعةً ما كُنتِ يوماً نجمةً","فلتتركيني ساااااااابحاً بفضائي",19,"ا",2,0],["يا بقعة الوادي المقدس لم أزل","برفيع مجدك معلناً تقديسي",20,"س",2,0],["يا بقايا قَرية اللؤم ويا رَمْزَ الدَّنايا","عشقَتْ منذ صباها الغضِّ قتلَ الأبرياءِ",21,"ا",2,0]]}