رد الجراح مضعفاً ومنضدا",175,"د",2,0],["والمجدُ يَطْلُبُ هِمَّةً سَباقةً","قَعْساءَ لا يَخْشَى المَنَى انْصارُها",176,"ر",3,0],["والمجدُ إِنْ لم تَحْمِهِ","بِطَرِيفِ مَجْدِكَ يُنْتَهَبْ",177,"ب",1,0],["والمجدُ لا يُبْتَنَى إلاَّ عَلَى عَمَدٍ","منَ الإِباءِ ورُكْنٍ غَيْرِ مُنْثَلِمِ",178,"م",1,0],["والمجدُ ليس ينال الا","بالمكارهِ والمتاعب",179,"ب",1,0],["والمجد في خطة غيري أقام بها","كطيف مية لم يسنح بالمام",180,"م",1,0],["والمُجَلِّي طِرْفَ الفضائل والبَذْ","لِ سَبُوقاً في حَلْبة الميْدانِ",181,"ن",1,0],["والمجد ينعاها كما","تنعى القصائدُ في الرثاء",182,"ا",2,0],["والمجتبي الحسن الذي في كفه","للعلم لانَ وللزمان زمام",183,"م",1,0],["والمجد في عرف الممالك درة","ترجى بأفئدة الملوك وترمق",184,"ق",1,0],["والمجلس اللي ماتواتي مناهجه","ومعزبه جنبت ممشاي عنه",185,"ن",2,0],["والمجد بانياب العرب مات مسموم","بعض العرب رقطا وبعض العرب هام",186,"م",1,0],["والمجنّب من الأوادم مايخلاّ","لا سلم من شرّ ذولا ..جوه ذولا",187,"ل",2,0],["والمجتبى البرِّ الذي كُشِفتْ به","للناس سَوءةُ عابدِ اللذات",188,"ت",1,0],["والمجدُ لا يُبتنى إلا لهُ عمد","آوي إليها يداً خيرٌ من الخطبِ",189,"ب",1,0],["والمجرمونَ الحارسونَ قصورَهم","يتفيأونَ مغبّةَ الحرمانِ",190,"ن",1,0],["وَ الْمَجْدُ مَجْدُ الرَّاْفِدَيْنِ º وَ عِزُّهُ","مُتَوَاْتِرٌ بِتَوَاْتُرِ الآَبَاْدِ",191,"د",1,0],["والمجد مخزون العلا","والمال ليس عليه خازن",192,"ن",1,0],["والمجد صعب لا ينال بهينةٍ","إلاّ بطول تلدّدٍ وتردّد",193,"د",1,0],["والمجد مجدك لا الذي يصفونه","عن سيّد الأمجاد أفريدون",194,"ن",1,0],["والمجدُ في أحيائنا ... وبشعبنا","تجدُ العروبةُ وجهها الإنساني",195,"ن",2,0],["والمجد لا يدركه مجمع","لو أنه في ذروة الجد استوى",196,"ا",1,0],["والمجد في حب الترفع عن","حمد يهون بذكره الحمد",197,"د",1,0],["والمجدُ مجدُ شراذمٍ","ليستْ عروبتيَ انْتماءْ",198,"ا",2,0],["والمجد والعز المكين رداؤه","من سمته تتزين الكونان",199,"ن",1,0],["وَالْمُجْتَبَىٰ وَالْمُنْتَقَىٰ وَالْمُقْتَدَىٰ","وَالْمُرْتَجَىٰ وَمَلاَذِ كُلِّ شَرِيدِ",200,"د",1,0],["والمجد أنحله فرط الشجون وكم","بثا من السقم في أحشائه هجسا",201,"س",2,0],["والمجد بعدك لم يخفق له علم","ولم تزن مسند العليا خلائفه",202,"ف",2,0],["والمجاديف عُطّلت غير ساقين اس","راحا إلى لذيذ السباتِ",203,"ت",1,0],["وَالمَجْدُ يَرْفَعُ فِي العُلا أَرْبابَهُ","فِي كُلِّ مَرْتَبَةٍ يَنُوفُ مَكانُها",204,"ن",3,0],["والمَجْدُ لا يصْنَعُهُ عاجِزٌ","يُغْضي على الظُّلْمِ ولا يعْبِسُ",205,"س",1,0],["وَالْمَجْدُ صَاحِبُ مَنْ أَفْنَوْا لَهُ عُمُرَاً","لَمَّا سَمَتْ وَاعتَلَتْ فِيْ دَربِهِمْ هِمَمُ",206,"م",1,0],["وَالْمَجْدُ سُلَّمُ أَفْذَاذٍ عَلَيْهِ مَضَوْا","حَتَّىٰ اعتَلَوْهُ .. فَكَانَتْ إِثْرَهُ نِعَمُ",206,"م",1,0],["والمجدُ ياشام لن يبقى برفعته","مالمْ نظلُّ على أبوابهِ خَدَما",207,"م",2,0],["و(المجتمع) من بدو رحل من امزارع وصياد","ألم (تجمع) على كاهلك ياحلم ٍ تبوه",208,"و",2,0],["والمجدان ترقي وتبلغ منزلا","ما كنت تنزل عنه بعد ليالي",209,"ل",2,0],["والمَجْدُ صَارَ خَريفَ السَّطْرِ فِي كُتُبٍ","تَأْبَى التَّنَاسِي ، بِرَفِّ الصَّبْرِ تَرْتَكِنُ",210,"ن",1,0],["والمجلس اللى يسمعك نمّه وغيبه لاتجيه","لوكان فيه البن الاشقر في دلاله ينثرا",211,"ر",2,0],["والمجدُ في أيِّ أرض يبلغون ثوى","مستوطنًا حيثما حلُّوا بجاكانا",212,"ن",2,0],["وَالمُجرِمونَ سَطَوا عَلَيه فَأَثخَنوا","فيهِ الجِراحَ وَعذَّبوهُ طَويلا",213,"ل",2,0],["وَالمَجدُ عاقِبَةُ المُجِدِّ فَلَيتَ لي","أَيّامَ أُبدِعُ مَن لِحَقّي يَشفَعُ",214,"ع",1,0],["والمجد يطرق أبواب العلاء فلا","تبكي السماء وتبدو أعين سدل",215,"ل",1,0],["والمجد تحت ظبى السيوف يحوزه","من كان رقع حدادها كجلاده",216,"د",2,0],["وآلمَ جرحًا جارِحًا فتحوّلت","يداه جراحًا فاستزادَ تألُّما",217,"م",2,0]]}