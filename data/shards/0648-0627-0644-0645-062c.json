اةُ بني يحيى بن عثمانا","https://www.poetsgate.com/ViewPoem.aspx?id=122039",""],[5309,"جذل وقلبي لا يزال عليلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573525",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[6213,"كل الهوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76310&r=&rc=58",""],[6259,"إن كنت تصدق في ادعاء وداده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59365&r=&rc=13",""],[6300,"مصير آخر فارس عربيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82875&r=&rc=46",""]],"verses":[["وَالمَجدُ يُخبِرُ عَن فِعالِكَ أَنَّهُ","يُدلي إِلَيهِ بِحُرمَةٍ وَذِمامِ",0,"م",1,0],["والمَجْدُ ممّا أقْتَني وأبْتَني","فإنْ عَثَرْتُ دونَهُ فلا لَعَا",1,"ا",1,0],["وَالمُجَلي في كُلِّ حَلبَةِ سَبقٍ","وَسِواكَ السُكَيتُ غَيرُ الجاري",2,"ر",2,0],["وَالمَجدُ يُفسِدُهُ اللَئيمُ بِلُؤمِهِ","كَالمِسكِ يَفسُدُ ريحُهُ بِالكُندُسِ",3,"س",1,0],["والمجتبى من عنصر النور الذي","في مطلع الهَدي المقدس قد ظهرْ",4,"ر",1,0],["والمجد أعطى الضُبى ميثاق معترف","أن ليس يضحك إلا حين تبتسم",5,"م",1,0],["والمجدَ لا تَبنِه إلا على أسس","من الحديد وإلاّ فهو منهدم",6,"م",1,0],["والمجد يأثل حيث البأس يدعَمُه","حتى إذا زال زال المجد والكرم",6,"م",1,0],["وَالمَجدُ لِلزَندِ الَّذي أَورَيتُمُ","بَحرٌ يَمُدُّ عُبابُهُ جوفَ القِنى",7,"ا",1,0],["وَالمُجرِمونَ إِذا أَرَدتَ عِقابَهُم","بارَزتَهُم وَتَرَكتَ كُلَّ ضَراءِ",8,"ا",2,0],["والمجتلى تاج علياه الرفيع وما","للبدر تاجٌ ولا للنجمِ إكليل",9,"ل",1,0],["والمجد لا تنثني يوماً معالمه","إلا إذا راح مبنى المال ينهدمُ",10,"م",1,0],["والمجازاةُ بذلُ وُدّي ونَصْري","ودعائي لك القريبَ المُجيبا",11,"ب",2,0],["والمجدُ ضامك لي وأنت بنجوةٍ","فيها ثُويُّ العِزِّ ليس يريمُ",12,"م",1,0],["وَالمُجرِمِينَ مخافَةً وتَعبُّداً","يَحدونَ كلَّ نَجيبَةٍ شِملالِ",13,"ل",1,0],["وَالمَجدُ في الدُنيا لِأَوَّلِ مُبتَنٍ","وَلِمَن شُيِّدَ بَعدَهُ فَيُطيلُ",14,"ل",1,0],["وَالمَجدُ عِندَ الغانِياتِ رَغيبَةٌ","يُبغى كَما يُبغى الجَمالُ وَيُعشَقُ",15,"ق",1,0],["وَالمَجدُ قَد يَأبِقُ مِن أَهلِهِ","لَولا عُرى الشِعرِ الَّذي قَيَّدَه",16,"د",2,0],["وَالمَجدُ مُشتَرِطٌ عَلَي","كَ قَضاءَها وَالشَرطُ أَملَك",17,"ك",1,0],["والمجد تاجك والسهى لك موطن","والشهب والأقمار في نعليك",18,"ك",1,0],["والمجد يوغل في حنا","يا روحه والمجدُ داء",19,"ا",2,0],["والمجدُ لا تُعْلي يَداك بناءَهُ","إلّا بِمالٍ بِالنَدى مَهدودِ",20,"د",1,0],["وَالمَجدُ مِن تالِدٍ قَديمٍ","ثَمَّ وَمِن طارِفٍ حَديثِ",21,"ث",1,0],["وَالمَجدُ يَعرِفُهُ بِطيبِ مَذاقِهِ","مَن يَستَطيبُ المَوتَ فيهِ مَذاقا",22,"ق",2,0],["وَالمُجيرونَ العاطِفونَ عَلى الدَه","رِ صِحابَ المَيسورِ في كُلِّ حالِ",23,"ل",1,0],["وَالمَجدُ وَالحُسّادُ مَق","رونانِ إِن ذَهَبوا فَذاهِب",24,"ب",1,0],["والمجدُ يلقى المجْدَ بين فُرُوجِهَا","ذا راحِلٌ مَعَها وهذا قافل",25,"ل",1,0],["وَالمَجدُ لِلَّهِ لا خَلقٌ يُشارِكُهُ","وَآلُ حَوّاءَ ما طابوا وَلا مَجَدوا",26,"د",3,0],["وَالمَجدُ كَالرُزقِ هَذا نالَ مِنهُ غِنىً","وَذاكَ مِنهُ مافاتَ إِعوالُ",27,"ل",1,0],["وَالمَجدُ كَالقُلَّةِ المُنيفَةِ وَال","مَرءُ لِقالٍ مِنَ الزَمانِ قُلَه",28,"ل",2,0],["وَالمَجدُ نَنميهِ وَنُتلِدُهُ","وَالحَمدُ في الأَكفاءِ نَدَّخِرُه",29,"ر",2,0],["والمجد أن تحمي وراءك قرية","ضاعت مسالكها وضاق رحيبها",30,"ب",3,0],["والمجد موهبةُ الملوك وإنما","تَبْني المواهبُ والخلائقُ تدْعَمُ",31,"م",1,0],["والمَجْدُ إِنْ لَمْ يُحْلَ مِنْهُ بِطَائِلٍ","كَالوِرْد قلَّ وَمَرَّ مِنْهُ المَقْطَعُ",32,"ع",1,0],["وَالمَجدُ إِن يَنعَتكَ بَينَهُمُ","فِبِكُلِّ ذِكرٍ طَيِّبٍ نَعَتا",33,"ت",2,0],["والمجد منه زائفٌ وممحصٌ","لا تخلطوا بلوره بجمانه",34,"ن",2,0],["والمجدُ عَزْمةُ أبطالِ مسدَّدةٌ","بريئةٌ النصلِ من شكٍّ وترديد",35,"د",1,0],["والمجدُ أنْ تَرِدَ الصعابَ بهمةٍ","شُمُّ الرواسي عِندَها كبِطاحها",36,"ح",3,0],["والمَجْدُ يَعْتَدُّ الْحَيَاةَ قَصِيرةً","ويَرَى فَناءَ الْخَالِدِين دَوَاما",37,"م",2,0],["والمجدُ منه: زائفٌ، وممحَّضٌ","ولا تَخْلطوا بِلَّورَه بجُمانهِ",38,"ن",2,0],["والمجد حيث أبرقت وأرعدت","ينبت من ساعته ويرتعى",39,"ا",1,0],["والمجد لا يملك عن وراثة","لكن بتحطيم الشبا على الشبا",39,"ا",1,0],["والمجدُ في الدنيا لأَوّلِ مُبْتنٍ","ولمن يشيد بعده فيطيل",40,"ل",1,0],["وَالمَجد سار إِلى جَنا","بك مِن أَبيك عَلى سِنَن",41,"ن",1,0],["وَالمَجدُ إِن كانَ في الأَقوامِ مُكتَسَباً","فَإِنَّهُ فيكَ مَولودٌ وَمُكتَسَبُ",42,"ب",1,0],["وَالمَجدُ كُلٌّ يَدَّعي ما لَم يَنَل","مِنهُ وَأَنتَ تَحوزُ ما لا تَدَّعي",43,"ع",2,0],["وَالمَجدُ شِنشِنَةٌ لِآلِ مُسَيَّبٍ","ما كُلُّ شِنشِنَةٍ تُناطُ بِأَخزَمِ",44,"م",1,0],["والمجد باسمك يا ربوع مسبّح","والفخر يهتف والزمان يهلل",45,"ل",1,0],["والمجدُ تَوَّجهُ بتاجٍ زاهِرٍ","ما مثلهُ تاجٌ من التيجانِ",46,"ن",1,0],["والمجدُ مزدَهِرٌ مطلٌّ من عل","عشقَ الوجودُ شبابَهُ الرّيّانا",47,"ن",2,0],["والمجدُ أقتلُ ما يكونُ هزالهُ","أما رأيتَ الكيسَ وهوَ سمينُ",48,"ن",1,0],["والمجدُ فَرْعٌ أصلُه كَرَمي","والدهرُ رُمْحٌ سِنُّه قَلمي",49,"م",2,0],["والمجد ليس يناله","إلاَّ الأديبُ الماجِد",50,"د",1,0],["والمجدُ للمالِ وكلُّ الذي","تراهُ من مَجدٍ فَمِن مَجدِه",51,"د",2,0],["وَالمجد وَالكرم العَريض رداؤه","وَشعاره ودثاره في المشهد",52,"د",1,0],["والمجد لا يحيا إذا","لم تسقه بدم غزير",53,"ر",1,0],["والمَجدُ والشرفُ المؤثَّل والعُلى","وقفٌ عليكَ وَلَيسَ بالمتسودَعِ",54,"ع",1,0],["وَالمَجلِسُ العالي المُهَيّا لَهُ","مَن ساءَ تَوفيقاً وَأُبدي الظَنَنِ",55,"ن",1,0],["وَالمَجدِ مِن قَدَمٍ يُعَزِّزُ فَخرَهُ","فَيَكادُ في الأَحشاءِ يَظهَرُ بِرَّهُ",56,"ه",1,0],["والمجاديف عطّلت غير ساقين","استراحا إلى لذيذ السبات",57,"ت",1,0],["وَالمَجدُ مجدُكَ يا اِبنَ الاِكرَمين فَمن","يُنكِر عَلاك عِنادا فليمت كَمدا",58,"د",2,0],["والمَجلِسُ السّامي الظّهيرِيَّ له","لك اعْتِناءٌ وهْو ذو تَلَطف",59,"ف",1,0],["والمجلسِ الاعَلى لسلطانِ الورى","فمتى يكونُ تُرى عليه وُفودي",60,"د",2,0],["وَالمَجلِسُ المَخدومُ مَخ","صوصٌ بِلَثمِي وِاِستِلامي",61,"م",2,0],["والمجد كلٌّ يدَّعيهِ وإنَّما","يَصفو لكَ الإبريزُ بالروباسِ",62,"س",1,0],["وَالمَجدُ لَيسَ يَنال إِلّا","بِالمَكارم وَالمتَاعب",63,"ب",1,0],["والمجد زاد ابن عمرو والزبير معاً","ولم يعد ابن مسعود فقيه نظر",64,"ر",1,0],["وَالمَجدِ تَحتَ ظَبي السُيوف يَجوزه","مَن كانَ وقع جِلادِهِ كَجِلادِهِ",65,"د",2,0],["والمجيدين وكلٌّ منهما","طيّب العنصر زاكي الأَصل والجد",66,"د",1,0],["والمجد يطلب في شفير مهنَّد","ماضي الغرار 