{"poems":[[63,"وليل طويل الباع فرقت شمله","https://www.aldiwan.net/poem45907.html","الطويل"],[63,"هفا بهوادي الخيل والليل أسحم","https://www.aldiwan.net/poem46209.html","الطويل"],[77,"بشرى تقوم لها الدنيا على قدم","https://www.aldiwan.net/poem36125.html","البسيط"],[77,"نفحت فشبت لافح التذكار","https://www.aldiwan.net/poem36518.html","الكامل"],[93,"أنا في الروض ساهر وهو نائم","https://www.aldiwan.net/poem11410.html","الخفيف"],[51,"أبا الصقر لست أرى مهديا","https://www.aldiwan.net/poem8301.html","المتقارب"],[61,"هفا طربا في أوان الطرب","https://www.aldiwan.net/poem51796.html","المتقارب"],[80,"وسامية الألحاظ للصيد قربت","https://www.aldiwan.net/poem31469.html","الطويل"],[80,"هفا القلب عن وصل هيف القدود","https://www.aldiwan.net/poem31501.html","المتقارب"],[74,"ماذا عليك وقد نأيت ديارا","https://www.aldiwan.net/poem12958.html","الكامل"],[105,"يا مالكا عنت الوجوه لعزه","https://www.aldiwan.net/poem42114.html","الكامل"],[105,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[105,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[105,"ما للسيوف أما تثوب فتعطف","https://www.aldiwan.net/poem44198.html","الكامل"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[46,"أرى كل أم عبرها غير مبطئ","https://www.aldiwan.net/poem22528.html","الطويل"],[46,"لا تأنفن من احترافك طالبا","https://www.aldiwan.net/poem22704.html","الكامل"],[46,"إن هللت أفواهكم فقلوبكم","https://www.aldiwan.net/poem23175.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39681","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[94,"حيرة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=15611",""],[94,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=12815",""],[105,"فزع الدجى لأنينه المتردد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54897&r=&rc=67",""],[151,"هلموا فعندي للمحبة والهوى","https://www.aldiwan.net/poem68551.html","الطويل"],[222,"بلدة خاب بمن فيها الرجاء","https://www.aldiwan.net/poem55290.html","الرمل"],[224,"جثا الليل ملتفا ببرد السرائر","https://www.aldiwan.net/poem41614.html","الطويل"],[381,"هفا بفؤادي موهنا صوت صادح","https://www.aldiwan.net/poem49256.html","الطويل"],[410,"كعهدك بانات الحمى فوق كثبها","https://www.aldiwan.net/poem31848.html","الطويل"],[417,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[433,"تهز بك الخطوب من الخطاب","https://www.aldiwan.net/poem12383.html","الوافر"],[433,"هفا طربي الى عافي الرسوم","https://www.aldiwan.net/poem12714.html","الوافر"],[442,"نيوب النائبات البائنات","https://www.aldiwan.net/poem14437.html","الوافر"],[459,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[465,"شجنك رسوم بالعقيق وأطلال","https://www.aldiwan.net/poem3543.html","عموديه"],[516,"أمالي من عذولكم عذير","https://www.aldiwan.net/poem12131.html","الوافر"],[537,"أشاقك بالملا دمن عواف","https://www.aldiwan.net/poem23849.html","الوافر"],[539,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[552,"خليلي من فرعي معد تأملا","https://www.aldiwan.net/poem47141.html","الطويل"],[559,"هي الحقيقة كل الكائنات لها","https://www.aldiwan.net/poem33534.html","البسيط"]],"verses":[["هَفا مَرَحَاً وَالدِّيكُ يَدْعُو صَباحَهُ","وَخاضَ حَشاهُ وَالقطا في مَبيتهِ",0,"ت",2,0],["هَفا بِهوادي الخَيلِ والليْلُ أسْحَمُ","نَبيلُ حَواشي لَبَّةِ الزَّوْرِ ضَيْغَمُ",1,"م",1,1],["هَفَا بِهَا الرَّوْعُ وَارْتَجَّتْ جَوَانِبُهَا","وَكَانَ سَاكِنُهَا لَحْماً عَلَى وَضَمِ",2,"م",1,0],["هفّافَةً يقْضي لطيفُ هُبوبِها","بتَذكُّرِ الأوْطانِ والأوْطارِ",3,"ر",1,0],["هَفْوَةٌ رَامَها الْقَضَاءُ وَفَادِي","كِ هَفَاهَا بِغَيْرِ مَا هُوَ رَائِمْ",4,"م",1,0],["هفا هفوةً بالندى ثم قال","أنبتُ إلى اللَّه فيمن أنابا",5,"ب",2,0],["هَفا طَرَباً في أوانِ الطَّرَبْ","فَأَنْخَبَ أقداحَه بالنُّخَبْ",6,"ب",1,1],["هَفا بَينَنا مِنها جَناحُ بُوَيْزَةٍ","كَقادِمَةِ العصفورِ طارَ بِها الذُّعرُ",7,"ر",1,0],["هفا القلبُ عن وَصلِ هِيفِ القدودِ","وماءُ الصِّبا مُورِقٌ منه عُودي",8,"د",2,1],["هَفَتِ الصَبا مِنهُ بِمَسرى ديمَةٍ","هَطلاءَ قَرَّ بِها العَجاجُ وَقارا",9,"ر",2,0],["هَفتِ الجُموعُ ولو أَذِنْتَ لِغيرِها","طارت إليك الدُّورُ والأسواقُ",10,"ق",1,0],["هَفَتِ العُروشُ وَزُلزِلَت زِلزالا","عَرشٌ هَوى وَقَديمُ مُلكٍ زالا",11,"ل",2,1],["هَفَتِ المخاوفُ بالنّفوسِ فزُلزِلتْ","ومَضتْ بها هُوجُ الظّنونِ سَوافيا",12,"ي",2,0],["هَفَتِ السُّيوفُ إلى السُّيوفِ وأوشكت","صُمُّ الرماح على الرماحِ تقَصَّفُ",13,"ف",1,0],["هَفتِ العَشيرَةُ إذ نَهَضتَ تُريدها","والعِيرُ دائبةٌ تَشُطُّ وتنزَحُ",14,"ح",1,0],["هَفا دونَها قَسُّ النَصارى وَموبَذُ ال","مَجوسِ وَدَيّانُ اليَهودِ وَحَبرُها",15,"ر",3,0],["هَفَتِ الجِبالُ مِنَ الرِجالِ بِعَسجَدٍ","أَو فِضَّةٍ وَهُما مِنَ الأَحجارِ",16,"ر",1,0],["هَفَتِ الحَنيفَةُ وَالنَصارى ما اِهتَدَت","وَيَهودُ حارَت وَالمَجوسُ مُضَلَّلَه",17,"ل",2,0],["هَفَتْ للشرق فاختلجتْ جناحاً","بهِ واستقبلت لثماً غمامهْ",18,"م",2,0],["هفهافةُ الثوب في بياضٍ","يكاد عن روحها يشفُّ",19,"ف",1,0],["هفت بجوقاتها إليه","مفشيةً سرّهُ مذيعَه",20,"ع",2,0],["هفوةٌ ، جرَّها الزمانُ علينا لا","ملومٌ أنا، ولا أنا لائم",21,"م",1,0],["هفت لشبابها وصبت إليه","ورقّ لها النصيح فما لحاها",22,"ا",3,0],["هفت الحور وألقت خمرها","أين رضوان وأين الرقباء",23,"ا",2,0],["هف القلوب العاطفات أمالهم","في الناس من ناهٍ ولا من مرشد",24,"د",1,0],["هَفا بكَ قَلبٌ أنتَ أوريتَ زِندَهُ","ونالَك طَرفٌ أنتَ أهمَلتَ سُحبَهُ",25,"ب",2,0],["هفوة أخرى هفاها آدم","إن يكن ضمن بنيه هؤلاء",26,"ا",2,0],["هَفا شَبحُ الأَحلامِ من غورِ كهفِهِ","وَقد عَلِقَت أَذيالُهُ بِالمَحاجِرِ",27,"ر",1,0],["هَفا بِفُؤادي مُوهِناً صَوت صادح","يَنوح عَلى إِلف عَن البان نازح",28,"ح",1,1],["هَفَتْ كَبِدٌ عمّا يَقُلْنَ صَديعُ","يَزيدُ هوى ليلى رضاها وعُتْبُها",29,"ه",2,0],["ه فكان الصَّوام والقوَّاما","لا ينال الشيطانُ منه مراماً",30,"ا",1,0],["هَفَتْ بكمُ المُنَى فأَطَعْتُمُوهَا","على الأَمْواهِ من عَدَدِ التُّرابِ",31,"ب",1,0],["هَفا طرَبي الى عافي الرسومِ","فلا روّى الغَمامُ رُبى الغميمِ",32,"م",1,1],["هفا بي سيء الأعمال هفوا","علانية وبعضاً كان خفوا",33,"ف",3,0],["هفا الدهرُ فيهم مستغرَّاً بغيره","فخاضوا وشاكَتْ رِجلَه عَثراتُها",34,"ت",3,0],["هفتْ بيَ دون العامرية في الحشا","لوائمُ خابت في هواها وعذّال",35,"ل",1,0],["هفا أرج الجمان على ثغور","إذا فاهت تأرَّجت الخمور",36,"ر",1,0],["هَفا وَقُلوبُ هذا الخَلقِ طُرّاً","إِلى أَوطانِها أَبَداً هَوافِ",37,"ف",1,0],["هِ فكانَ البُكاءُ منهم لِزاما","وأحَرُّ الدُّموعِ دَمعُ قُبورٍ",38,"ر",1,0],["هفا ثُمّتَ اِستخفى فَقُلت لصاحبي","ألا هلْ أراك البرقُ ما قد أرانِيا",39,"ي",2,0],["هفا بك البرق من أوج الكثيف فقف","أنت الوميض وعنك الطرف منك سها",40,"ه",2,0]]}