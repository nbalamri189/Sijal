{"poems":[[65,"وليل طويل الباع فرقت شمله","https://www.aldiwan.net/poem45907.html","الطويل"],[65,"هفا بهوادي الخيل والليل أسحم","https://www.aldiwan.net/poem46209.html","الطويل"],[79,"بشرى تقوم لها الدنيا على قدم","https://www.aldiwan.net/poem36125.html","البسيط"],[79,"نفحت فشبت لافح التذكار","https://www.aldiwan.net/poem36518.html","الكامل"],[95,"أنا في الروض ساهر وهو نائم","https://www.aldiwan.net/poem11410.html","الخفيف"],[53,"أبا الصقر لست أرى مهديا","https://www.aldiwan.net/poem8301.html","المتقارب"],[63,"هفا طربا في أوان الطرب","https://www.aldiwan.net/poem51796.html","المتقارب"],[82,"وسامية الألحاظ للصيد قربت","https://www.aldiwan.net/poem31469.html","الطويل"],[82,"هفا القلب عن وصل هيف القدود","https://www.aldiwan.net/poem31501.html","المتقارب"],[76,"ماذا عليك وقد نأيت ديارا","https://www.aldiwan.net/poem12958.html","الكامل"],[107,"يا مالكا عنت الوجوه لعزه","https://www.aldiwan.net/poem42114.html","الكامل"],[107,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[107,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[107,"ما للسيوف أما تثوب فتعطف","https://www.aldiwan.net/poem44198.html","الكامل"],[107,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[48,"أرى كل أم عبرها غير مبطئ","https://www.aldiwan.net/poem22528.html","الطويل"],[48,"لا تأنفن من احترافك طالبا","https://www.aldiwan.net/poem22704.html","الكامل"],[48,"إن هللت أفواهكم فقلوبكم","https://www.aldiwan.net/poem23175.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39681","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[96,"حيرة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=15611",""],[96,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=12815",""],[107,"فزع الدجى لأنينه المتردد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54897&r=&rc=67",""],[154,"هلموا فعندي للمحبة والهوى","https://www.aldiwan.net/poem68551.html","الطويل"],[226,"بلدة خاب بمن فيها الرجاء","https://www.aldiwan.net/poem55290.html","الرمل"],[228,"جثا الليل ملتفا ببرد السرائر","https://www.aldiwan.net/poem41614.html","الطويل"],[385,"هفا بفؤادي موهنا صوت صادح","https://www.aldiwan.net/poem49256.html","الطويل"],[415,"كعهدك بانات الحمى فوق كثبها","https://www.aldiwan.net/poem31848.html","الطويل"],[422,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[438,"تهز بك الخطوب من الخطاب","https://www.aldiwan.net/poem12383.html","الوافر"],[438,"هفا طربي الى عافي الرسوم","https://www.aldiwan.net/poem12714.html","الوافر"],[447,"نيوب النائبات البائنات","https://www.aldiwan.net/poem14437.html","الوافر"],[463,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[469,"شجنك رسوم بالعقيق وأطلال","https://www.aldiwan.net/poem3543.html","عموديه"],[520,"أمالي من عذولكم عذير","https://www.aldiwan.net/poem12131.html","الوافر"],[541,"أشاقك بالملا دمن عواف","https://www.aldiwan.net/poem23849.html","الوافر"],[543,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[556,"خليلي من فرعي معد تأملا","https://www.aldiwan.net/poem47141.html","الطويل"],[563,"هي الحقيقة كل الكائنات لها","https://www.aldiwan.net/poem33534.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122587","الوافر"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101506","الخفيف"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44561","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59685","الطويل"],[287,"","https://poetry.dctabudhabi.ae/diwan/poem/69701","البسيط"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133756","المتقارب"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133757","المتقارب"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133758","المتقارب"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78021","البسيط"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45362","الوافر"],[1733,"","https://poetry.dctabudhabi.ae/diwan/poem/216310","الوافر"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87833","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87829","الكامل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198885","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69414","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104756","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110318","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27153","الخفيف"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21440","الوافر"],[2452,"","https://poetry.dctabudhabi.ae/diwan/poem/141043","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76008","الطويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97995","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140036","الطويل"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26954","السريع"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129508","الطويل"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99229","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114564","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102748","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72790","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120516","السريع"],[4755,"عَرَبيٌّ في الجِيتُو","https://www.poetsgate.com/ViewPoem.aspx?id=215951",""],[4830,"صريعُ الفاتنات","https://www.poetsgate.com/ViewPoem.aspx?id=211103",""],[4578,"قد رعت يا ريب المنون فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=49406",""],[5038,"نسيم الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=188550",""],[5102,"عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=12900",""],[5121,"الجناح الأخضر","https://www.poetsgate.com/ViewPoem.aspx?id=36279",""],[5121,"طير الحقول","https://www.poetsgate.com/ViewPoem.aspx?id=37478",""],[5264,"بحلم","https://www.poetsgate.com/ViewPoem.aspx?id=184356",""],[5264,"أصل الحكاية","https://www.poetsgate.com/ViewPoem.aspx?id=185053",""],[5387,"بعد الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=53063",""],[5770,"رثاء الشهيد فيصل الحسيني","https://www.poetsgate.com/ViewPoem.aspx?id=178701",""],[5834,"َهْفَ نفسي كيف حالي ما الذي","https://www.poetsgate.com/ViewPoem.aspx?id=5009",""],[5970,"هفت بفؤاد (أحمدكم) كعاب","https://www.poetsgate.com/ViewPoem.aspx?id=130639",""],[5975,"هفت روحي","https://www.poetsgate.com/ViewPoem.aspx?id=58783",""]],"verses":[["هَفا مَرَحَاً وَالدِّيكُ يَدْعُو صَباحَهُ","وَخاضَ حَشاهُ وَالقطا في مَبيتهِ",0,"ت",2,0],["هَفا بِهوادي الخَيلِ والليْلُ أسْحَمُ","نَبيلُ حَواشي لَبَّةِ الزَّوْرِ ضَيْغَمُ",1,"م",1,1],["هَفَا بِهَا الرَّوْعُ وَارْتَجَّتْ جَوَانِبُهَا","وَكَانَ سَاكِنُهَا لَحْماً عَلَى وَضَمِ",2,"م",1,0],["هفّافَةً يقْضي لطيفُ هُبوبِها","بتَذكُّرِ الأوْطانِ والأوْطارِ",3,"ر",1,0],["هَفْوَةٌ رَامَها الْقَضَاءُ وَفَادِي","كِ هَفَاهَا بِغَيْرِ مَا هُوَ رَائِمْ",4,"م",1,0],["هفا هفوةً بالندى ثم قال","أنبتُ إلى اللَّه فيمن أنابا",5,"ب",2,0],["هَفا طَرَباً في أوانِ الطَّرَبْ","فَأَنْخَبَ أقداحَه بالنُّخَبْ",6,"ب",1,1],["هَفا بَينَنا مِنها جَناحُ بُوَيْزَةٍ","كَقادِمَةِ العصفورِ طارَ بِها الذُّعرُ",7,"ر",1,0],["هفا القلبُ عن وَصلِ هِيفِ القدودِ","وماءُ الصِّبا مُورِقٌ منه عُودي",8,"د",2,1],["هَفَتِ الصَبا مِنهُ بِمَسرى ديمَةٍ","هَطلاءَ قَرَّ بِها العَجاجُ وَقارا",9,"ر",2,0],["هَفتِ الجُموعُ ولو أَذِنْتَ لِغيرِها","طارت إليك الدُّورُ والأسواقُ",10,"ق",1,0],["هَفَتِ العُروشُ وَزُلزِلَت زِلزالا","عَرشٌ هَوى وَقَديمُ مُلكٍ زالا",11,"ل",2,1],["هَفَتِ المخاوفُ بالنّفوسِ فزُلزِلتْ","ومَضتْ بها هُوجُ الظّنونِ سَوافيا",12,"ي",2,0],["هَفَتِ السُّيوفُ إلى السُّيوفِ وأوشكت","صُمُّ الرماح على الرماحِ تقَصَّفُ",13,"ف",1,0],["هَفتِ العَشيرَةُ إذ نَهَضتَ تُريدها","والعِيرُ دائبةٌ تَشُطُّ وتنزَحُ",14,"ح",1,0],["هَفا دونَها قَسُّ النَصارى وَموبَذُ ال","مَجوسِ وَدَيّانُ اليَهودِ وَحَبرُها",15,"ر",3,0],["هَفَتِ الجِبالُ مِنَ الرِجالِ بِعَسجَدٍ","أَو فِضَّةٍ وَهُما مِنَ الأَحجارِ",16,"ر",1,0],["هَفَتِ الحَنيفَةُ وَالنَصارى ما اِهتَدَت","وَيَهودُ حارَت وَالمَجوسُ مُضَلَّلَه",17,"ل",2,0],["هَفَتْ للشرق فاختلجتْ جناحاً","بهِ واستقبلت لثماً غمامهْ",18,"م",2,0],["هفهافةُ الثوب في بياضٍ","يكاد عن روحها يشفُّ",19,"ف",1,0],["هفت بجوقاتها إليه","مفشيةً سرّهُ مذيعَه",20,"ع",2,0],["هفوةٌ ، جرَّها الزمانُ علينا لا","ملومٌ أنا، ولا أنا لائم",21,"م",1,0],["هفت لشبابها وصبت إليه","ورقّ لها النصيح فما لحاها",22,"ا",3,0],["هفت الحور وألقت خمرها","أين رضوان وأين الرقباء",23,"ا",2,0],["هف القلوب العاطفات أمالهم","في الناس من ناهٍ ولا من مرشد",24,"د",1,0],["هَفا بكَ قَلبٌ أنتَ أوريتَ زِندَهُ","ونالَك طَرفٌ أنتَ أهمَلتَ سُحبَهُ",25,"ب",2,0],["هفوة أخرى هفاها آدم","إن يكن ضمن بنيه هؤلاء",26,"ا",2,0],["هَفا شَبحُ الأَحلامِ من غورِ كهفِهِ","وَقد عَلِقَت أَذيالُهُ بِالمَحاجِرِ",27,"ر",1,0],["هَفا بِفُؤادي مُوهِناً صَوت صادح","يَنوح عَلى إِلف عَن البان نازح",28,"ح",1,1],["هَفَتْ كَبِدٌ عمّا يَقُلْنَ صَديعُ","يَزيدُ هوى ليلى رضاها وعُتْبُها",29,"ه",2,0],["ه فكان الصَّوام والقوَّاما","لا ينال الشيطانُ منه مراماً",30,"ا",1,0],["هَفَتْ بكمُ المُنَى فأَطَعْتُمُوهَا","على الأَمْواهِ من عَدَدِ التُّرابِ",31,"ب",1,0],["هَفا طرَبي الى عافي الرسومِ","فلا روّى الغَمامُ رُبى الغميمِ",32,"م",1,1],["هفا بي سيء الأعمال هفوا","علانية وبعضاً كان خفوا",33,"ف",3,0],["هفا الدهرُ فيهم مستغرَّاً بغيره","فخاضوا وشاكَتْ رِجلَه عَثراتُها",34,"ت",3,0],["هفتْ بيَ دون العامرية في الحشا","لوائمُ خابت في هواها وعذّال",35,"ل",1,0],["هفا أرج الجمان على ثغور","إذا فاهت تأرَّجت الخمور",36,"ر",1,0],["هَفا وَقُلوبُ هذا الخَلقِ طُرّاً","إِلى أَوطانِها أَبَداً هَوافِ",37,"ف",1,0],["هِ فكانَ البُكاءُ منهم لِزاما","وأحَرُّ الدُّموعِ دَمعُ قُبورٍ",38,"ر",1,0],["هفا ثُمّتَ اِستخفى فَقُلت لصاحبي","ألا هلْ أراك البرقُ ما قد أرانِيا",39,"ي",2,0],["هفا بك البرق من أوج الكثيف فقف","أنت الوميض وعنك الطرف منك سها",40,"ه",2,0],["هَفَوا فَجزَيتُهم بالبُغض حُبّا","لَهم وجزيتُهم بالذَّم حَمدا",41,"د",2,0],["هَفَوات الكبار تأتي كباراً","ليت ذا العلم يعصم العقلاءَ",42,"ا",2,0],["هَفا بِقَلبي مِنهُ إِفراطُ الهَيَفْ","فَقُلتُ لَمّا أَن تَثَنّى وَاِنعَطَفْ",43,"ف",1,0],["هفا بالمناوي والمعاند روْعه","وإن قيل فيه راجحُ الحلم حازم",44,"م",1,0],["هَفا لِقَلبي رَشيقُ القَدِّ أَهيَفُهُ","وَباتَ يَعسِفُهُ مَن لَيسَ يُسعِفُهُ",45,"ف",2,1],["هفا الليل قومي نهز المنى","بأرجوحة من ضياء القمر",46,"ر",1,1],["هفا الليل قومي نذر على","حواشيه مخمور أحلامنا",47,"ن",2,1],["هفا الليل يحمل في راحتيه","إلى البائسين وعود الهناء",48,"ا",2,1],["هفافة تقطع الأكوان واجدة","حتى أناخت بباب الخالق الباري",49,"ر",2,0],["هَفَت بي وَالدُجى يَهفو حَشاهُ","كَما كَسَرَت عَلى خُززٍ عقابُ",50,"ب",1,0],["هفا عطر الجنوب له نسيم","أقول إذا أناسم منه نشرا",51,"ر",2,0],["هَفوَةٌ بَعدَ هَفوَةٍ بَعدَ أُخرى","هَفَواتٌ كانَت عَلَيكِ وَبيلَه",52,"ل",2,0],["هَفَتِ الغُصونُ إِلَيهِ تَلثمُ خَدَّهُ","هَفوانَ مُلتاحٍ إِلى مُلتاحِ",53,"ح",1,0],["هفونا لهونا وهو عنا مدافع","فكم فتنة عنا الشفيع نفاها",54,"ا",3,0],["هَفَوا هَفوَةً مِن غَيرِ بُغضِ فَأُدِّبُوا","بِعَفوِكَ إِنَّ العَفوَ لِلحُرِّ تَأَديبُ",55,"ب",1,0],["هَفَوتُ أَونالَنى دَهرِى بِنَوعِ أَذا","أَورُمتُ مِنكَ مِدَاداً قَدُّ ما نَفَذَا",56,"ذ",2,0],["هفوا اليك وانت اليوم رايتهم","فكن طليعتهم في كل ميدان",57,"ن",1,0],["هَفَتِ الوُرقُ بِالرِياضِ وَناحَت","شَجوُ هذا الحَمامِ مِمّا شَجاني",58,"ن",2,0],["هَفا لِهديلِهِ مني إِذا ما","تغرّد ساجِعاً قَلبٌ قَريحُ",59,"ح",1,0],["هفا بك متن الغصن لو أنّ قدرةً","سلبْتك حليَ الطوق والغصن الرّطبا",60,"ب",2,0],["هفَّ لبرقٍ بِالحمى قَد هَفا","وَما اِختَفَت أَسرارُهُ مُذ خَفى",61,"ف",2,1],["ةفتنا تهاويل الشباب تحرجا","فما مسنا العذال بالهمز واللمز",62,"ز",1,0],["هَفَتْ عند نبذ العهدِ أفئدةُ العدا","فطاروا وكانوا نوّماً فتنبّهوا",63,"ه",3,0],["هَفا بِهِ الوَجدُ فَلَو مِنبَرٌ","طارَ لِوافي خَطفَةَ الكَوكَبِ",64,"ب",1,0],["هفوني وكانت زلة من ذوي الحجى","وعما قليل في البكا نتلافاها",65,"ا",3,0],["هفا هفوَ اللواءِ الوَرْدِ أَرْخَى","ذوائبَهُ فلاعَبْنَ الرياحا",66,"ح",2,0],["هفت لكَ أشجارٌ بلا قدمٍ سَعَت","وكلمَكَ الجنينُ والضَّبُّ والمَها",67,"ه",2,0],["هَفا قَومُهُ لمَّا أتاهُمُ داعياً","سراجاً م