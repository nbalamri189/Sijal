{"poems":[[55,"ألهاك عنا ربة البرقع","https://www.aldiwan.net/poem30157.html","السريع"],[95,"ما عين فيجتها وصافي مائها","https://www.aldiwan.net/poem11154.html","الكامل"],[87,"كنيسة صارت إلى مسجد","https://www.aldiwan.net/poem63722.html","السريع"],[83,"يلحى الزمان وما عليه ملام","https://www.aldiwan.net/poem61489.html","الكامل"],[146,"لا أعذر المرء يصبو وهو مختار","https://www.aldiwan.net/poem58448.html","البسيط"],[408,"لولا ضني جسدي والمدمع الجاري","https://www.aldiwan.net/poem46918.html","البسيط"],[520,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119987","المنسرح"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83219","الكامل"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106691","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103008","الكامل"],[4013,"","https://poetry.dctabudhabi.ae/diwan/poem/113663","الكامل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62135","البسيط"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62197","البسيط"],[5277,"فاطمة","https://www.poetsgate.com/ViewPoem.aspx?id=195091",""],[5616,"محنة","https://www.poetsgate.com/ViewPoem.aspx?id=203469",""]],"verses":[["لَولا ضَلالاتُ الهَوى لَم يَكُن","عِنانُ قَلبي لَكِ بِالأَطوَعِ",0,"ع",1,0],["لَوْلا ضَنَايَ لَكُنْتُ مِنْ أَشْهَادِهَا","يَوْمَ الفِدَى وَلَكُنْتُ مِنْ شُهَدَائِهَا",1,"ا",3,0],["لَولا ضَلالٌ سابِقٌ لَم يَقُم","مِن أَجلِكَ الخَلقُ وَلَم يَقعُدِ",2,"د",1,0],["لَولا ضَريحُكِ ما عَلِمنا حُفرَةً","أَضحَت يُنافِسُها العُلُوَّ شَمامُ",3,"م",1,0],["لولا ضمانُ يديه رىَّ عالَمِهِ","لجاءت السُّحبُ من كفَّيه تمتارُ",4,"ر",1,0],["لولا ضني جسدي والمدمعِ الجاري","ما كنتُ أظهر لِلْواشين أَسراري",5,"ر",2,1],["لولا ضياء جبينه ما ابيض من","ظلماء مفرقها ذوائب سود",6,"د",1,0],["لولا ضنى بي ألم حينا","لا زال حلفا لمن تعادي",7,"د",2,0],["لَولا ضِياءُ العِلمِ ما عَرَفَ الفَتى","مَعنى الحَياةِ وَلا بَنى الآطاما",8,"م",2,0],["لَولاَ ضِيَاءُ المشرفَّيةِ والقَنَا","ضَلَّت كَتائِبُهُم بلَيلِ أليَلِ",9,"ل",1,0],["لولا ضلال لاح في زيّ الهدى","ما غرَّت الظمآن لمعة آل",10,"ل",1,0],["لولا ضرامٌ شبَّ بين جوانحي","لغرقتُ من غربيَّ بالطُوفانِ",11,"ن",1,0],["لولا ضلوع تواري نار فطنته","لأحرقت وجنات الشمس بالشرر",12,"ر",1,0],["لولا ضلوع تواري نار فطنة","لأحرقت وجنات الشمس بالشرر",13,"ر",1,1],["لولا ضبطتُ إلى عينيكِ بوصلتي","ما تاهَ دربي وزاغَ الضادُ عن لغتي",14,"ت",2,1],["لولا ضراعة زوجي وهي ترمقني","على السرير وفيها ينهش الألم",15,"م",1,0]]}