{"poems":[[48,"أيا شجر العرا أوسعت ريا","https://www.aldiwan.net/poem22995.html","الوافر"],[92,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[568,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62890","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205538","الكامل"]],"verses":[["وَفَذٌّ في مَقاصِدِهِ بَليغٌ","أَحَبُّ إِلَيَّ مِن إِلفٍ أَلَفِّ",0,"ف",1,0],["وفذٍ \" عبقريّ من نَتاجي","تَرَعْرَعَ \" صيتُه \" ونما وشاعا",1,"ع",2,0],["وَفَذلَكَةٌ لِكُلِّ مَكارِمٍ في","أَقارِبِهِ وَفي نُبلِ الجُدودِ",2,"د",1,0],["وفذٍ من الفتيانِ يأنفُ وحدَهُ","بِنَا وبِهِ من سَورِةِ العزِّ أَولقُ",3,"ق",1,0],["وفذوو المعايب عذرهم في نقصهم","والنبل ما لكماله من عاذرِ",4,"ر",1,0]]}