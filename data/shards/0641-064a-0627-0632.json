{"poems":[[55,"وقد كنت آبي أن أذل لصبوة","https://www.aldiwan.net/poem29877.html","الطويل"],[85,"أدرها ثلاثا من لحاظك واحبس","https://www.aldiwan.net/poem54280.html","الطويل"],[64,"وزائرة وافت فأجللت خدها","https://www.aldiwan.net/poem52362.html","الطويل"],[71,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[71,"تذكرت بالبرق إذ يلمع","https://www.aldiwan.net/poem28985.html","المتقارب"],[50,"أيها الناس ارحموني","https://www.aldiwan.net/poem66186.html","مجزوء الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54863","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54763","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[124,"أيا ساعة مليت فيها بحسنه","https://www.aldiwan.net/poem49302.html","الطويل"],[164,"ولعت به كبدر التم يبدو","https://www.aldiwan.net/poem58989.html","الطويل"],[208,"أتجرؤ في تلبيس ذكرك في ذكري","https://www.aldiwan.net/poem53145.html","الطويل"],[230,"كلامكما إن كان مثل سهام","https://www.aldiwan.net/poem55242.html","الطويل"],[276,"حروف معان أو عقود جواهر","https://www.aldiwan.net/poem52109.html","الطويل"],[302,"يا راحلين وهم في القلب سكان","https://www.aldiwan.net/poem33146.html","البسيط"],[302,"إلام تطيل نوحك يا حمام","https://www.aldiwan.net/poem33161.html","الوافر"],[358,"قضى تذكار أبكار الليالي","https://www.aldiwan.net/poem40000.html","الوافر"],[369,"روحا ساعة متون القلاص","https://www.aldiwan.net/poem60864.html","الخفيف"],[371,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[409,"يا عاتبا لي ما الذي","https://www.aldiwan.net/poem34113.html","مجزوء الرجز"],[422,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[422,"متى يشفى بك الصب العميد","https://www.aldiwan.net/poem54140.html","الوافر"],[463,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[466,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[469,"أقل عنائي أنني فيه هائم","https://www.aldiwan.net/poem3633.html","عموديه"],[498,"كم منة للظلام في عنقي","https://www.aldiwan.net/poem67351.html","المنسرح"],[520,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107231","الطويل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129517","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133825","الخفيف"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61224","الوافر"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132857","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111819","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102725","الطويل"],[2126,"","https://poetry.dctabudhabi.ae/diwan/poem/100548","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53088","البسيط"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110638","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121206","البسيط"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84856","البسيط"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130826",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94011","الطويل"],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145868","المتقارب"],[3372,"","https://poetry.dctabudhabi.ae/diwan/poem/198805",""],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123915","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138556",""],[3669,"","https://poetry.dctabudhabi.ae/diwan/poem/124608","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131979","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91189","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91098","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91696","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205582","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205947",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85206","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131210",""],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/198887","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73283","الطويل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198187","الطويل"],[4604,"","https://poetry.dctabudhabi.ae/diwan/poem/113020","الكامل"],[4701,"للقدس هدية عيد الميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=48453",""],[4782,"دمع الصبايا","https://www.poetsgate.com/ViewPoem.aspx?id=198723",""],[4984,"وليلي","https://www.poetsgate.com/ViewPoem.aspx?id=180974",""],[585,"هجرتك حتى قيل لم يعرف الحبا","https://www.poetsgate.com/ViewPoem.aspx?id=161854",""],[5096,"معاناة مع القدر","https://www.poetsgate.com/ViewPoem.aspx?id=208532",""],[5408,"أحزان سندسية","https://www.poetsgate.com/ViewPoem.aspx?id=190869",""],[5550,"كفِّي الصُدود","https://www.poetsgate.com/ViewPoem.aspx?id=213892",""],[5660,"أَرى في عُيوني وُجوهاً كَثيرَه","https://www.poetsgate.com/ViewPoem.aspx?id=23973",""],[5957,"كل حب في حياتي لا يزول","https://www.poetsgate.com/ViewPoem.aspx?id=113357",""],[5997,"العذراء","https://www.poetsgate.com/ViewPoem.aspx?id=214229",""],[520,"أيا اذن الأيام ان قلت فاسمعي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577575",""]],"verses":[["فَيا زائِراً لَو أَستَطيعُ فَدَيتُهُ","بِأَهلي عَلى عِزِّ القَبيلِ وَمالي",0,"ل",2,0],["فيا زاجر الأظعان وهي ضوامرٌ","بغير الفلا والوحش لم تتأنَّسِ",1,"س",1,0],["فيا زورةً جاءت على غير موعدٍ","فقرَّتْ عيونٌ واشتفتْ أنفسٌ مرضى",2,"ض",2,0],["في ازديادِ العلمِ إرغامُ العِدى","وجمالُ العلمِ يا صاحِ العملْ",3,"ل",1,0],["فيا زمنَ الوصلِ هَلْ عائدٌ","فتخمد ما حوتِ الأضلعُ",4,"ع",1,0],["في إِزارٍ قَد لَواهُ","ثُمَّ دَلّى طَرَفَيهِ",5,"ي",2,0],["فَيَا زُمَراً مِنَ الأَحْبَا","بِ حَارَ بِوَصْفِهَا فِكْرِي",6,"ر",2,0],["فَيَا زَائِراً هَذَا الضَّرِيحَ وَنَاظِراً","إِلى أَثَرٍ لِلْحَزْمِ وَالعَزْمِ خُلِّدَ",7,"د",1,0],["فيا زعماءَ الشرق والشرقُ أمّةٌ","على الدهرِ لا تفنَى ولا تتضعْضَعُ",8,"ع",1,0],["فيا زائراً أفديه بالنفس لو درى","أغشى وكن عوني إذا خان ناصر",9,"ر",1,0],["فيا زمني أهل هذا اتفاق","فارجو العود أم ذا منك قصد",10,"د",1,0],["فيا زارياً ما زال تمصيعُ لفظه","اذا قرأ القرآنَ يدعو الى الكُفر",11,"ر",1,0],["فَيا زمناً ما خِلتُه غيرَ سَكرةٍ","مُضيُّكَ أَبقى لي خُمارَ غرامِ",12,"م",1,0],["فَيا زائِرا روح الحَبيب محمد","بِنَفسي وَأَهلي من حَبيب وَزائِر",13,"ر",1,0],["فَيا زَمانَ اللِوى حيِّيتَ من زَمَنٍ","ولا أَغبَّ اللِوى وَالسَفحَ هتّانُ",14,"ن",1,0],["فَيا زَمني إِذِ الدُنيا فتاةٌ","كَما أَهوى وإِذ دَهري غُلامُ",15,"م",1,0],["فَيا زَمَناً لِبَيت البين بانٍ","رُويدك إن ربعَ الصَبر بالي",16,"ل",2,0],["في ازديادٍ وفي اطّرادٍ وأعدا","ؤك في الاْنتِقاصِ والانتِكاص",17,"ص",1,0],["فَيا زَماني إِن جَرَت قَطرَةٌ","مِن دَمِ قَلبي فَلَها شانُ",18,"ن",1,0],["فيا زماني هل قضي","ت من جفائي أربك",19,"ك",1,0],["فيا زهر روض أنتم زهر كمِّهِ","لقد ماس غصن الفخر فيكم سيّدا",20,"د",2,0],["فيا زمنَ الصِّبا هَلْ من رجوعٍ","ويا عهدَ الشباب متى يعود",21,"د",1,0],["فيا زمناً بذاك العي","ش مَرَّ أما تعودُ أما",22,"م",2,0],["في أزْمَةٍ قُذفٍ كأنّض أخيرَها","منْ بُؤسِها للضَّعْفِ عنهُ أوَّلُ",23,"ل",1,0],["فيا زمني بالجزع هل أنت عائد","ويا جؤذرَ الوعساء هل أنت راحم",24,"م",1,0],["في أَزرَقٍ كَالهَواءِ يَخرُقُهُ اللَح","ظُ وَإِن كانَ غَيرَ مُنخَرِقَ",25,"ق",1,0],["فيا زارع الإحسان في كل تربة","ظفرت بأرض تنبت الشكر فازرع",26,"ع",1,0],["فيا زائِراً أَنعمتُ بالِي بقُربِهِ","قليلاً فلمَّا سارَ ودَّعتُ مُهجَتِي",27,"ي",1,0],["فيا زمن اللذات هل أنت عائد","بما مر في تلك المعاهد والعهد",28,"د",1,0],["في ازدحام الأضواء تعصب صنيّن","وفي روعة الظلام المدلّى",29,"ل",2,0],["فَيا زَمَن التغافل وَالتغاضي","وَيا عَهد التواصل وَالتداني",30,"ن",2,0],["فيا زَورَةً لم تَشفِ قَلباً مُتَيَّماً","وِلكنَّها زادت غرامي فأضعَفَا",31,"ف",2,0],["فيا زمن اللذَّاتِ هل انت عائدٌ","ويا مالكي هل أنتَ باقٍ عَلَى العهدِ",32,"د",1,0],["في إزارٍ مطهرٍ ورداءٍ","لم يمسا طيباً ولا جريالا",33,"ل",2,0],["فيا زائري لا تستحي أن تنادني","فما شئتَ موجودٌ وحيّي له مغنا",34,"ن",2,0],["فيا زمرةَ الأحبابِ هيموا بحبِّه","فكم للدسوقي من هدايا تُنعنِشُنا",34,"ن",2,0],["فيا زائراً أرض الغريين قاصداً","محجب قدس شاقه البيت والحجر",35,"ر",1,0],["فيا زمان الصبا هل أنت مرتجع","حتى أقول لأيام الحمى عودي",36,"د",2,0],["فيا زاخري بحر تلاطم لجه","ببحر علوم بالعلوم تدفقا",37,"ق",2,0],["فيا زبير لك البشرى بخير اب","ويا اباه بنجل بين الوطف",38,"ف",1,0],["فَيا زَمان العُلا أَبشر بِمَولده","وَدامَ لَهُ مُخلِصاً مَجداً وَمُستَنَدا",39,"د",2,0],["في ازدياد العلم ارغام العدى","وبه ذو الفضل بالعلياء حل",40,"ل",1,0],["فيا زين زين العابدين لك الهنا","ودمت كما تهوى مدى مدة العمر",41,"ر",1,0],["فيا زهرة قد سقتها الدماء","وأذكت أماليدها الطيبات",42,"ت",1,0],["فيا زايد الخير والمكرمات","ويا زايد العلم.. والاطلاعِ",43,"ع",1,0],["فيا زين العباد فدتك جل ال","عباد وليس تصلح للفداء",44,"ا",2,0],["فيا زهرة الايام من بعد فقده","بمن تزهر الدنيا سلامٌ لنا منك",45,"ك",1,0],["في أزمة تسلى الودود عن ابنها","جهدا ولا يلفى بها خلان",46,"ن",1,0],["فيا زهرة القيروان التي","تلظى فؤادي لها واستعر",47,"ر",1,0],["فَيا زَمان التَهاني دم لَنا فَلَقد","عادَت أَعاديك في خزي مخاسيرا",48,"ر",2,0],["فَيا زَمانيَ إِني عَنكَ في شغلٍ","وَأَنتَ مشتغل عَني بكل غَبي",49,"ب",2,0],["فيا زيد ما أَقسى فؤادي عَلى النَوى","وَيا عمرو ما أَجرى المَدامعَ يا عمرو",50,"ر",2,0],["فيا زمانًا جاد لي منعمًا","بالضن، أو أسعدني بالعذابْ",51,"ب",1,0],["فيا زمانًا بلا حياة","إنِّي حياة بلا زمان",52,"ن",1,0],["فيا زائري بحر الكمال محمد","لكم منه ربح والكبر له جبر",53,"ر",1,0],["فيا زيدُ لا يذهب بك الظن مذهباً","قبيحاً فمن لا يحسن الظن يأثم",54,"م",1,0],["فيا زايد يا سيد القوم إننا","وراءك فاذهب حيث شئت فقاتل",55,"ل",1,0],["فَيا زورةٌ بَثَّ الصبَّاحُ سُروَرها","عَلينا كأنّ الصبُّحَ ما فارَقَ الإِلفا",56,"ف",2,0],["فَيا ((زائِدَ))الإِفضالِ لا زِلْتَ والِداً","فقَدْ طِبْتَ مَوْلوداً وَقَدْ طِبْتَ مَوْلِدَا",57,"د",2,0],["فيا ((زائِداً)) يُهْنيك َعيدٌ مَؤَثَّلٌ","بِكُم قَد غَدَى رَوْضُ السُعُودِ مُوَرِّدَا",57,"د",2,0],["في أزرقِ الملبوسِ مرَّ مُعذِّبي","متمايِلاً كالغُصنِ في خيْلائِهِ",58,"ا",3,1],["- في أزرقٍ يُدعى السهادُ.. تركتَها","أتنامُ يا \"عيسى\"؟وأختُك ساهدةْ؟",59,"د",2,0],["فيازهر الحياة كفاكِ شجوًا","وأنتِ العيد تهواهُ البرايا",60,"ا",3,0],["فيا زهرة العمر مما مضى","تعاليْ فليلاك ما أخلفت",61,"ت",1,0],["فيا زهرة الشرق اسمعي قول موجعٍ","تصبّيته لكنه لم يعد صبا",62,"ب",2,0],["فيا زائري جدْ خصالا فأقْبل","على الموْعد الآن عنْد النَهر",63,"ر",1,0],["فيا زمان الهوى جُدْ لي بقافية","حتى يطرِّزَني في حرفها الشّغفُ",64,"ف",1,0],["فيا زهرة البان إنِّي أسيرُ","الأسى والسّهاد ففكِّي قيودي",65,"د",2,0],["فَيا زَيفَ وَعدٍ وَ يا نَقضَ عَهدٍ","وَ يا نَارَ بُعدٍ بِقَلبي أَسيرَه",66,"ر",2,0],["في ازدهار الحب يسمو روضنا","تثمر الأزهار من بعد الذبول",67,"ل",1,0],["فيا زهْرةَ العشريْنِ جُوديْ لعاشقٍ","منَ الجَنَّةِ {العَذْرَاْءِ} ما صاْر نافرا",68,"ر",2,0],["فيا زارع الإسلام في كل تربةٍ","ظفرت بأرض تنبت الشكر فازرع",69,"ع",1,0]]}