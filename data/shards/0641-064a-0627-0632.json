{"poems":[[53,"وقد كنت آبي أن أذل لصبوة","https://www.aldiwan.net/poem29877.html","الطويل"],[83,"أدرها ثلاثا من لحاظك واحبس","https://www.aldiwan.net/poem54280.html","الطويل"],[62,"وزائرة وافت فأجللت خدها","https://www.aldiwan.net/poem52362.html","الطويل"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[69,"تذكرت بالبرق إذ يلمع","https://www.aldiwan.net/poem28985.html","المتقارب"],[48,"أيها الناس ارحموني","https://www.aldiwan.net/poem66186.html","مجزوء الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54863","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54763","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[118,"أيا ساعة مليت فيها بحسنه","https://www.aldiwan.net/poem49302.html","الطويل"],[158,"ولعت به كبدر التم يبدو","https://www.aldiwan.net/poem58989.html","الطويل"],[202,"أتجرؤ في تلبيس ذكرك في ذكري","https://www.aldiwan.net/poem53145.html","الطويل"],[223,"كلامكما إن كان مثل سهام","https://www.aldiwan.net/poem55242.html","الطويل"],[269,"حروف معان أو عقود جواهر","https://www.aldiwan.net/poem52109.html","الطويل"],[295,"يا راحلين وهم في القلب سكان","https://www.aldiwan.net/poem33146.html","البسيط"],[295,"إلام تطيل نوحك يا حمام","https://www.aldiwan.net/poem33161.html","الوافر"],[351,"قضى تذكار أبكار الليالي","https://www.aldiwan.net/poem40000.html","الوافر"],[362,"روحا ساعة متون القلاص","https://www.aldiwan.net/poem60864.html","الخفيف"],[364,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[400,"يا عاتبا لي ما الذي","https://www.aldiwan.net/poem34113.html","مجزوء الرجز"],[413,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[413,"متى يشفى بك الصب العميد","https://www.aldiwan.net/poem54140.html","الوافر"],[456,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[459,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[462,"أقل عنائي أنني فيه هائم","https://www.aldiwan.net/poem3633.html","عموديه"],[491,"كم منة للظلام في عنقي","https://www.aldiwan.net/poem67351.html","المنسرح"],[513,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"]],"verses":[["فَيا زائِراً لَو أَستَطيعُ فَدَيتُهُ","بِأَهلي عَلى عِزِّ القَبيلِ وَمالي",0,"ي",1,0],["فيا زاجر الأظعان وهي ضوامرٌ","بغير الفلا والوحش لم تتأنَّسِ",1,"س",1,0],["فيا زورةً جاءت على غير موعدٍ","فقرَّتْ عيونٌ واشتفتْ أنفسٌ مرضى",2,"ض",2,0],["في ازديادِ العلمِ إرغامُ العِدى","وجمالُ العلمِ يا صاحِ العملْ",3,"ل",1,0],["فيا زمنَ الوصلِ هَلْ عائدٌ","فتخمد ما حوتِ الأضلعُ",4,"ع",1,0],["في إِزارٍ قَد لَواهُ","ثُمَّ دَلّى طَرَفَيهِ",5,"ي",2,0],["فَيَا زُمَراً مِنَ الأَحْبَا","بِ حَارَ بِوَصْفِهَا فِكْرِي",6,"ي",1,0],["فَيَا زَائِراً هَذَا الضَّرِيحَ وَنَاظِراً","إِلى أَثَرٍ لِلْحَزْمِ وَالعَزْمِ خُلِّدَ",7,"د",1,0],["فيا زعماءَ الشرق والشرقُ أمّةٌ","على الدهرِ لا تفنَى ولا تتضعْضَعُ",8,"ع",1,0],["فيا زائراً أفديه بالنفس لو درى","أغشى وكن عوني إذا خان ناصر",9,"ر",1,0],["فيا زمني أهل هذا اتفاق","فارجو العود أم ذا منك قصد",10,"د",1,0],["فيا زارياً ما زال تمصيعُ لفظه","اذا قرأ القرآنَ يدعو الى الكُفر",11,"ر",1,0],["فَيا زمناً ما خِلتُه غيرَ سَكرةٍ","مُضيُّكَ أَبقى لي خُمارَ غرامِ",12,"م",1,0],["فَيا زائِرا روح الحَبيب محمد","بِنَفسي وَأَهلي من حَبيب وَزائِر",13,"ر",1,0],["فَيا زَمانَ اللِوى حيِّيتَ من زَمَنٍ","ولا أَغبَّ اللِوى وَالسَفحَ هتّانُ",14,"ن",1,0],["فَيا زَمني إِذِ الدُنيا فتاةٌ","كَما أَهوى وإِذ دَهري غُلامُ",15,"م",1,0],["فَيا زَمَناً لِبَيت البين بانٍ","رُويدك إن ربعَ الصَبر بالي",16,"ي",1,0],["في ازديادٍ وفي اطّرادٍ وأعدا","ؤك في الاْنتِقاصِ والانتِكاص",17,"ص",1,0],["فَيا زَماني إِن جَرَت قَطرَةٌ","مِن دَمِ قَلبي فَلَها شانُ",18,"ن",1,0],["فيا زماني هل قضي","ت من جفائي أربك",19,"ك",1,0],["فيا زهر روض أنتم زهر كمِّهِ","لقد ماس غصن الفخر فيكم سيّدا",20,"د",2,0],["فيا زمنَ الصِّبا هَلْ من رجوعٍ","ويا عهدَ الشباب متى يعود",21,"د",1,0],["فيا زمناً بذاك العي","ش مَرَّ أما تعودُ أما",22,"م",2,0],["في أزْمَةٍ قُذفٍ كأنّض أخيرَها","منْ بُؤسِها للضَّعْفِ عنهُ أوَّلُ",23,"ل",1,0],["فيا زمني بالجزع هل أنت عائد","ويا جؤذرَ الوعساء هل أنت راحم",24,"م",1,0],["في أَزرَقٍ كَالهَواءِ يَخرُقُهُ اللَح","ظُ وَإِن كانَ غَيرَ مُنخَرِقَ",25,"ق",1,0],["فيا زارع الإحسان في كل تربة","ظفرت بأرض تنبت الشكر فازرع",26,"ع",1,0]]}