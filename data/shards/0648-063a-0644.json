ry.dctabudhabi.ae/diwan/poem/62923","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138625",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110064","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109925","الطويل"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199170","المتدارك"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91728","الوافر"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199026","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111450","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4289,"","https://poetry.dctabudhabi.ae/diwan/poem/199285","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139635",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139484",""],[4815,"حرب مع الذَّات","https://www.poetsgate.com/ViewPoem.aspx?id=210640",""],[4877,"قبل لاتنوي الفرقى","https://www.poetsgate.com/ViewPoem.aspx?id=36560",""],[4926,"بحقِّك يا الله صل وسلِّم","https://www.poetsgate.com/ViewPoem.aspx?id=171099",""],[5120,"لَيْلَةٌ فِي اَلْحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=179956",""],[5122,"(( لا حرزت راحه ولا مربح أحرزت ))","https://www.poetsgate.com/ViewPoem.aspx?id=26734",""],[5136,"رق قلبي ومدمعي","https://www.poetsgate.com/ViewPoem.aspx?id=121941",""],[5145,"أعوز الصبر فهل لي من طريق","https://www.poetsgate.com/ViewPoem.aspx?id=108199",""],[5442,"اشرفت في السواد ذات الثور","https://www.poetsgate.com/ViewPoem.aspx?id=114768",""],[5722,"آذار","https://www.poetsgate.com/ViewPoem.aspx?id=12684",""],[5756,"ادلعها واولعها","https://www.poetsgate.com/ViewPoem.aspx?id=5414",""],[5829,"الا المساجد","https://www.poetsgate.com/ViewPoem.aspx?id=211699",""],[5842,"من ورق / إياد صالح","https://www.poetsgate.com/ViewPoem.aspx?id=150275",""],[5848,"جتك تكفى","https://www.poetsgate.com/ViewPoem.aspx?id=53101",""],[5997,"وحي المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214233",""],[6213,"وهدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80548&r=&rc=80",""],[572,"دَجَاجَة ٌ في سِمَنْ السّمَنْدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9248&r=&rc=105",""]],"verses":[["وَغِلمَةٍ أَخَذوا لِلرَوعِ أُهبَتَهُ","لُفَّ البُطونِ عَلى الأَعوادِ خُمصانُ",0,"ن",1,0],["وَغَلغَلَ ما بَينَ الحِجابَينِ وَالحَشا","سِنانٌ كَمِصباحِ السَليطِ وَقيعُ",1,"ع",1,0],["وَغِلمَةٍ في ظُهورِ العيسِ أَرَّقَهُم","هَمٌّ شُعاعٌ وَآمالٌ عَباديدُ",2,"د",1,0],["وَغُلبٌ كَالقَواضِبِ مِن قُرَيشٍ","يَرَونَ القَواضِبَ وَالكِعابا",3,"ب",2,0],["وغِلْظَةُ أخلاقٍ يوَلِّدُها الغِنى","على أنّها عندَ الخَصاصَةِ تَدْمُثُ",4,"ث",1,0],["وَغُلامٍ قائِمٍ ذي عَدوَةٍ","وَذَلولٍ جَسرَةٍ مِثلِ الفَدَن",5,"ن",1,0],["وَغَلَبنَ أَبرَهَةَ الَّذي أَلفَينَهُ","قَد كانَ خَلَّدَ فَوقَ غُرفَةِ مَوكِلِ",6,"ل",1,0],["وَغُلامٍ أَرسَلَتهُ أُمُّهُ","بِأَلوكٍ فَبَذَلنا ما سَأَل",7,"ل",1,0],["وَغُلاَماً وناشِئاً ثم كَهلاً","خَيرُ كَهلٍ وَنَاشِىءٍ وغُلامِ",8,"م",1,0],["وغلَّة طاف أولادي فقلت لهم","اسعوا لها يا عفاة البيت أو طوفوا",9,"ف",3,0],["وغلامٌ من بني الأص","فر فَحْلٌ كالحِصان",10,"ن",1,0],["وَغُلبٌ كَأَعناقِ الضِباعِ مَضيغُها","سِلامُ الشَظى يَغشى بِها كُل مَركَبِ",11,"ب",1,0],["وَغَلغَلتُ مِن وَجدٍ إِلَيهِنَّ بَعدَما","سَرَيتُ وَأَحشائي مِنَ الخَوفِ تَخفِقُ",12,"ق",1,0],["وغلى قبرك الذي فيه تغفو","نحمل الورد الغض والياسمينا",13,"ن",2,0],["وغلمة كأنهم لؤلؤ","وقاصرات الطرف أتراب",14,"ب",1,0],["وَغَلَّسَ في الوادي بِهِنَّ مُشَيَّعٌ","مُبارَكُ ما تَحتَ اللِثامَينِ عابِدُ",15,"د",1,0],["وَغَلّاتُ الضَياعِ إِنِ اِستُبيحَت","فَلَيسَ تُباحُ غَلّاتُ القَصيدِ",16,"د",1,0],["وَغُلامٍ كَالشَمسِ في خِدمَةِ الشَم","سِ يُحَيّي بِالشَمسِ بِنتَ الدَنانِ",17,"ن",1,0],["وَغُلامٌ مِنَ النَصارى بِماءِ ال","حُسنِ قَبلَ اِعتِمادِهِ مَعموذُ",18,"ذ",1,0],["وَغَلَت في صِفاتِ فَضلِكَ ياسي","نُ وَصادٌ وَآلُ سينٍ وَصادُ",19,"د",1,0],["وَغَلى بالفراقِ مِرْجَلُ حُزْني","فهو بالدّمع من جْفُوني يفُورُ",20,"ر",1,0],["وغَلَوْا فظنّوا اللهَ مُخلفَ وعدِه","واللهُ فوق مَزاعمِ الجُهلاءِ",21,"ا",2,0],["وغليلُ نفسي في جوانب مُمحلٍ","والطيرُ بين مناهلٍ وظلالِ",22,"ل",1,0],["وغلامٌ أريحيّ","من تلاميذ سياهِ",23,"ه",1,0],["وَغَلا عَلَيكَ طِلابُهُ","وَالدُرُّ يُترَكُ في غَلائِه",24,"ه",1,1],["وغلا آخرون فيه، فقالوا:","كان في مذهب النشوء إماما",25,"م",2,0],["وغَلَّفْنا مظاهرهُ حِساناً","مزخرفةً على صُوَرٍ قِباح",26,"ح",1,0],["وغلبت آرائي كريما صابراً","وارحت من هم الوجود جناني",27,"ن",2,0],["وغلا في الضلال فاشتبه الأمر","عليه وبات في عشواء",28,"ا",2,0],["وغلائلٌ بات الغما","م يجودها حتى رواها",29,"ا",3,0],["وَغَلَت في الحَشَا زَوَافِرُ أنفَا","سٍ تَشَكَّى الإِهابُ منها التِهابَا",30,"ب",2,0],["وَغَلَّ يَدي ذي غُدرَةٍ رامَ قَتلَهُ","عَوائِدُ هَذي الدارِ قَد خُرِقَت لَهُ",31,"ه",1,0],["وغلقت الأبواب وانقطع الرجا","وما شك فيما زوروا رُب فطنة",32,"ه",1,0],["وغلاء سعر قاتل","في كل يوم بانقلابه",33,"ب",2,0],["وغلائل زُرْق نشرن كأنها","آثار تَجْميش الصدور النُضَّر",34,"ر",1,0],["وَغُلامُ حُلو الشَمائِلِ قَد أَل","قى عَلى خَدِّهِ المَدامُ شَعاعَه",35,"ع",2,0],["وغُلامٍ مِن بَني الأَص","فَرِ كَالثَوبِ القُباطي",36,"ط",2,0],["وغلام شظى بكرفس مفسا","ه قديماً أسنةُ الأقلام",37,"م",1,1],["وغلامٍ بكأسها","راح يسعى وبكرا",38,"ر",2,0],["وَغُلامٍ مُهَفهَفٍ مِن بَني التُر","كِ جَليبٍ واهاً لَهُ مِن غُلامِ",39,"م",1,0],["وَغَلَت بِهِم سَجحاءُ جارِيَةٌ","تَهوي بِهِم في لَجَّةِ البَحرِ",40,"ر",1,0],["وغلَّتْ أَياديهمْ كبُولٌ وطالما","ببسطتِها فكّوا أسيراً وعانيا",41,"ي",2,0],["وغلامٌ وراءه في يدَيْه","زَنْدُ بأسٍ للنّارِ فيه كُمون",42,"ن",1,0],["وغلامٍ إذا بدا فوق مُهْرٍ","خِلْتَهُ فوق مَتْنِه مُوْتودا",43,"د",2,0],["وغلست والظل آزما زحل","وحاضر الماء هجود ومصل",44,"ل",1,0],["وَغلة ما لَها شِفاءٌ","وَعلة ما لَها طَبيبُ",45,"ب",1,0],["وغلِطْتَ في تَشبيهِها","بالبحرِ فاللهمّ غُفْرا",46,"ر",2,0],["وغليلِ ظامٍ للعلومِ أباحَهُ","من علمِه الوضّاحِ بحراً مترَعا",47,"ع",2,0],["وغلمةً حولك من عامرٍ","شَرطَك مدعُوّاً ومستنصَرا",48,"ر",2,0],["وغلامٌ آخذٌ ما طلبتْ","نفسهُ أو فائتٌ كلَّ طلوبِ",49,"ب",1,0],["وغَلَّس حتى انتهى واحداً","له المجلسُ الصدرُ والموكبُ",50,"ب",1,0],["وغلوتَ في وصفي فقلتُ سجيّةٌ","ما زلتُ أعرفها من الكرماءِ",51,"ا",2,0],["وغلوتَ في عتبي ولستُ بمذنبٍ","فعليكَ خزيُ الله إن لم تعتب",52,"ب",1,0],["وغلطت فيها غلطة","أزرت بقدري واقتداري",53,"ر",2,0],["وغلا فقُل لي مِن عجَائب دَهرِنا","ترَى الضِّدَّ أحيانا تَجَمَّعَ بالضِّ",54,"ض",1,0],["وَغِلابٌ لأَعادي","كم وما يرجى الغِلابُ",55,"ب",1,0],["وغلام وروضة ورداح","وانعطاف وميلة وتثني",56,"ن",2,0],["وَغَلَّ لِساني فيكَ ما غَمَّ خاطِر","فَها أَنا أَرسو في الكَلامِ وَأَرسُفُ",57,"ف",1,0],["وَغُلاَمٍ فِي زِيِّهِ كَفَتَاةٍ","وَفَتَاةٍ فِي زِيِّهَا كَغُلاَمْ",58,"م",1,0],["وَغلام السوء إِن جوَّعته","سرق الجار وان يشبع فسق",59,"ق",1,0],["وغلت على من سَامَها","وعَلت على مَنْ شَامَها",60,"م",3,0],["وَغَلائِلُ الأَوْرَاقِ فَوْقَ قُدُودِهَا","تَنْقَدُّ عِنْدَ تَطَرُّبِ الوَرْقَاءِ",61,"ا",2,0],["وغليله أروين من علم لمن","وردوا مناهله فراتاً قد جرى",62,"ر",2,0],["وَغُلامٌ والمُلُوكُ لَهُ","خَوَلٌ رِقاً وَغِلمانُ",63,"ن",1,0],["وغلمة من بني عدنان أرسلها","للجد والدها في الحرب لا اللعب",64,"ب",1,0],["وَغلمة منه على نار القرى","بانت تقص بالندى أَخباره",65,"ر",2,0],["وَغلق باب الرزق دُوني عَلى","لَها القَطع يَسعى قَبل يَوم القِيامة",66,"ه",1,0],["وَغلقت في وَجه الأَقارب كُلِّهم","بابَ المُروءة بئس ما تَلقاه",67,"ا",2,0],["وغَلَّقَ بابَ الظُّلم من بعدِ فَتْحِه","وفتّح باب الحق من بعد ما انسَدَّا",68,"د",2,0],["وَغُلام ناديتهُ تِهْ دَلالاً","مَلَأ الكَونَ يا حَبيبي بَهاؤُكْ",69,"ك",1,1],["وَغلّه فَوراً بِمارستانِ","فَافهم لما تَرى وخُذ بَياني",70,"ي",1,0],["وغلس فعند الصبح يبتهج السرى","وهل يشهد الإصلاح غير المغلس",71,"س",1,0],["وغلامُهُ مُتَقَبِّضٌ فى مَتنِهِ","بمكانِهِ مِنهُنَّ رَأىٌ مُعجَبُ",72,"ب",1,0],["وغُلْبِ عِداً جزَّتْ نواصي رُؤوسِها","ظُباكَ ولولا العَفْوُ حَانَ احْتِرازهُا",73,"ز",3,0],["وَغَلب السكر فنمت فوثب","إِلى فِراخي فَلَقوا مِنهُ العطب",74,"ب",1,0],["وَغَلْيُ القُدور الرَّاسياتِ بتامكٍ","عَبيطٍ ترى فيه المجالَ المُؤرَّبا",75,"ب",2,0],["وغُلّةٍ فى فؤادى لا يُبرِّدُها","شىءٌ سوى ضمَّةٍ أو رشفِ رِيقته",76,"ت",2,0],["وغلام مقين حسن الوج","ه يحاكي بقده غصن بان",77,"ن",1,0],["وغلمانُنا كانُوا أُسودَ خَفِيَّةٍ","وحُقَّ علينا أن يُثابوا ويُمدحُوا",78,"ح",3,0],["وغلطتُ فيما قلتُ بل","يا ما أقلَّ حياءها",79,"ا",3,0],["وغلائلُ الآداب أجملُ حِلية","تاهت بها نفس على إملاقِ",80,"ق",1,0],["وغلاَّ فمن آدابِكَ الزُّهرِ يجتلي","فرنداً له درٌّ عليه رطيب",81,"ب",1,0],["وغلاه فِيْ روحي تمكّن","لو كتب ما تضمّه صحايف",82,"ف",1,0],["وغلب سحر فرعون عصا موسى فعاد","سحر أم القرينه نظيره",83,"ر",2,0],["وغلامٌ لغلامٍ شطره","وأخيه الشطر منه فاتسق",84,"ق",1,0],["وغلال من غلول جمعت","لا من الأرث ولا كد اليمين",85,"ن",1,0],["وغُلْبٌ كآساد الشَّرَى ضَمِنَتْ لها","فَوارسُها في الرَّوْعِ أَيَّ ضَمان",86,"ن",1,0],["وغلاك عندي ماله احساب","ولا تنقله سبع الأراضي",87,"ض",2,0],["وَغَلَقتُمُ بَابَينِ لَو فُتِحَا لَكُم","فُزتُم بِكُلِّ بِكُلِّ بِشَارَةٍ وَتَهَانِ",88,"ن",1,0],["وغَلَّقَ الموسِمُ وأنتَ مُغزِر","وقامَ ريحُ الغربِ ثُمَّ أدبَر",89,"ر",1,0],["وَغَلائِلٍ مِصرِيَّةٍ تَزهو بِها","بَينَ الكَواعِبِ مُعصِراتُ زَماني",90,"ن",2,0],["وَغُلبٍ نَضَّدَتها راحُ قومي","تَطولُ عَلى الرِّقابِ العاتِياتِ",91,"ت",1,0],["وغلي بأدهان الغوالي متونه","فإني كذا أهوى فروع الحلائل",92,"ل",1,0],["وغلام يسعى بكاس لجين","مُوِّهت بالنضار والإبريز",93,"ز",1,0],["وَغلق الحانوت وَالأسواق","وَزادَ خَوف وَكَذا إِشفاق",94,"ق",1,0],["وَغلّق الأَبواب ثُمَّ سدّها","بِذاك ظهر الناس قوّى شَدَّها",94,"ه",2,0],["وَغَلّة الخالص في","تَحصيلها والمَلَقَه",95,"ق",2,0],["وغِلمانٌ كأنَّهُم جُنُونٌ","وأنتَ تراهُمُ صُوراً وَإِنسَا",96,"س",2,0],["وغلبننا اذكن افتك لحظة","واشد دلالاً واوثق دينا",97,"ن",2,0],["وغلا بالذي أجمجم صدري","وشكاني من عجمتي شيطاني",98,"ن",2,0],["وغُلّةُ الشّوق تُطفا","بطيب ورد زُلالك",99,"ك",1,0],["وَغُلامٌ وَأَشمَطٌ وَرَضيعٌ","كُلُّهُم في التُرابِ يَوماً يُزارُ",100,"ر",1,0],["وغلني بالشكل","في حبه واحزب",101,"ب",1,0],["وغلمانَ كالليلِ البهيم نَظنُّهم","جنوداً من الخُزّانِ عن مالكٍ مَرّوا",102,"ر",3,0],["وَغلبتهُ مُتفنّناً","يَومَ الغلاب به فُنونا",103,"ن",2,0],["وَغلطت بل لمن الضَوارِب في الفَلا","تَ