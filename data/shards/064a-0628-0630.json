{"poems":[[88,"آذنت شمس حياتي بمغيب","https://www.aldiwan.net/poem10474.html","الرمل"],[53,"وصديق أجبته إذ دعاني","https://www.aldiwan.net/poem61866.html","الخفيف"],[53,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[94,"أي ناس هذا الورى ما رأى","https://www.aldiwan.net/poem38889.html","الخفيف"],[87,"طال عليها القدم","https://www.aldiwan.net/poem63695.html","مجزوء السريع"],[51,"يا صاحبي رحلي لا تكثرا","https://www.aldiwan.net/poem64297.html","السريع"],[50,"نبئت في آل زياد فتى","https://www.aldiwan.net/poem66223.html","السريع"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54698","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[53,"وصديقٍ أجبتُهُ إذ دعاني","https://www.poetsgate.com/ViewPoem.aspx?id=27821",""],[141,"هل إلى أم سعيد","https://www.aldiwan.net/poem67960.html","مجزوء الرمل"],[147,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[214,"راح يرنو مرنح الاعطاف","https://www.aldiwan.net/poem13327.html","الخفيف"],[228,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[234,"معصمها من سوارها اعتقرا","https://www.aldiwan.net/poem51094.html","المنسرح"],[287,"سرى طيف علوة من بانياسا","https://www.aldiwan.net/poem32735.html","المتقارب"],[396,"باسمك الله ابتدى","https://www.aldiwan.net/poem54499.html","عموديه"],[409,"قد أصبتم يا سيدي بالجواب","https://www.aldiwan.net/poem34148.html","الخفيف"],[438,"ما الطويل الذراع مثل القصير","https://www.aldiwan.net/poem12627.html","الخفيف"],[463,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[463,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[466,"صارم ان خذل السيف حمى","https://www.aldiwan.net/poem15477.html","الرمل"],[466,"يبذل المال فان حل به","https://www.aldiwan.net/poem15666.html","الرمل"],[469,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[556,"إن على رمل العقيق خيما","https://www.aldiwan.net/poem47229.html","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64949","الطويل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126651","الخفيف"],[2081,"","https://poetry.dctabudhabi.ae/diwan/poem/146928","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67986","الخفيف"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53026","الرجز"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129509","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114310","الرمل"],[4025,"","https://poetry.dctabudhabi.ae/diwan/poem/122154","الرمل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83121","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141680","الخفيف"],[1012,"فتح جعلان","https://www.poetsgate.com/ViewPoem.aspx?id=124501",""],[5135,"لا تلمني","https://www.poetsgate.com/ViewPoem.aspx?id=201789",""],[5150,"اخوة في سجل العائلة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204652",""],[5596,"فنجاء","https://www.poetsgate.com/ViewPoem.aspx?id=206476",""],[4115,"لي قمر من اهل بغداد قد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=607585",""]],"verses":[["يَبذُلُ المَعروفَ في السِرِّ كَما","يَرقُبُ العاشِقُ إِغفاءَ الرَقيبِ",0,"ب",1,0],["يبذل التافه الذي يُلبس الحُر","رَ خشوعاً ولا يَسُدُّ مَسَدَّا",1,"د",2,0],["يبذُلونَ الحقوقَ لا عارضيها","فُدي الباذلُونَ بالعُرّاض",2,"ض",1,0],["يبذْلُونَ الأموالَ طوراً وطوراً","يقتنُونَ الأموال للأعراض",2,"ض",1,0],["يبذُرَ الرُّعبَ في القُلُوبِ ويُذكي","حيثما حلَّ في الجوانحِ نارا",3,"ا",1,0],["يَبذُلُ إِلّا النُهى","يَهتِكُ إِلّا الحُرَم",4,"م",1,0],["يَبذُلُ ما يَمنَعُ أَهلُ النَدى","هَذا لَعَمري مُنتَهى البَذلِ",5,"ل",1,0],["يبذلُ للزوّارِ وجعاءهُ","صيانةٌ منه لعِرضِ الرغيف",6,"ف",1,0],["يَبُذُّ الجِيادَ بِتَقرِيِبهِ","وَيَأوي إِلى حُضُرٍ مُلهَبِ",7,"ب",1,0],["يَبْذلونَ القُوى وَفَوْقَ القوَى غَيْ","رَ مُبَالينَ أَنَّهَا لِنَفَادِ",8,"د",1,0],["يَبْذُرُ الْبَغْيُ دِمَاءً","يَنْبَتُ العَدْلُ وُروُدا",9,"د",2,0],["يَبذُلُ الْخيْرَ فِطْرَةً ليس يَثْنيه","عن الْخَيْر والصَنيعَةِ ثاني",10,"ن",2,0],["يبذل التافه الذي يُلبس الحُرَّ","خشوعاً ولا يَسُدُّ مَسَدَّا",11,"د",2,0],["يَبذُلُ الوُدَّ لِغَيري","وَأُكافي بالجَميلِ",12,"ل",1,0],["يَبذُلونَ النُفوسَ في طاعَةِ اللَ","هِ اِحِتساباً وَيَذكُرونَ المَعادا",13,"د",2,0],["يبذل المال رغبة وسخاء","وترى جمعه من الاشراف",14,"ف",1,0],["يَبذر نوراً في رِياضِ الهَوى","فَأَنثَني أَجمَعُ ما يبذُرُ",15,"ر",1,0],["يبذل قبل السؤال نائِلَهُ","ثم يلاقي العُفَاة معتذرا",16,"ر",2,0],["يَبُذُّ الخُصومَ إِذا ناظَروهُ","بِنَصٍّ وَيُربي عَلَيهِم قِياسا",17,"س",2,0],["يبذل النصح للورى","لا بعنف ولا خصام",18,"م",1,0],["يبذل المال من أراد اتصالاً","أو يوافي على جناح الغراب",19,"ب",1,0],["يبذُلُ النائلَ الكثيرَ ولكن","هو في عينِه كنَزْرٍ يسيرِ",20,"ر",1,0],["يبذلُ في الراح اللُّها عادلاً","ما وزن الخَّمارُ منها وكالْ",21,"ل",1,0],["يبذُلُ في حفظ العلا مهجةً","تكبُرُ أن تَفديِهَا نفسُ فادْ",22,"د",1,0],["يبْذلُ الدَّثْرَ غَنيَاً قادراً","غير مَنَّانٍ ويُعطي مُعْدِما",23,"م",2,0],["يبذلُ المال فانْ حَلَّ بهِ","لاجىءٌ من صَرْفِ دهرٍ منَعهْ",24,"ع",2,1],["يبذلون القرى كما يمنعون الجا","ر والمحل كالعدى محسوم",25,"م",1,0],["يبذل لِي من بعد أن ضَنَّ به","وشافعي النومُ العِذارَ والفما",26,"م",2,0],["يَبُذُّ مُجاريهِ إِلى مَوْقِفٍ بهِ","تُحازُ الْمَعالي أَوْ تَحيزُ الأَكازِمُ",27,"م",1,0],["يبذل النفس والنفيس ويأبى","أن يرى راكضا إلى الأطماع",28,"ع",1,0],["يبذ خطيب القوم في كل مشهد","وإن كان سحبان الخطيب ودغفلا",29,"ل",2,0],["يبذُل النفسَ والنَّفيس إذَا مَا","نَسْرُ بَغْيٍ عَلَى الرعية حاما",30,"م",2,0],["يبذل في التشويق كلَّ جهدِ","بقدرِ حظِ الفضل في السهام",31,"م",1,0],["يبذل النفس اذا استرفدته","إي وربي لم أقل شيئا فريا",32,"ي",2,0],["يُبْذَلُ المَالُ لإِصْلاَحِ الفَتَى","لاَ تَنَلْ ذَاكَ بِعِرْضٍ مُبْتَذَلْ",33,"ل",1,0],["يبذلُونَ المالَ فيما نابَهُم","لحقوقٍ تعتريهم وُعُرُف",34,"ف",1,0],["يَبذل النُصحَ لا يَمُنُّ بِما يُس","دِي وَلا يَبتَغي ثَناءَ شَكُورِ",35,"ر",1,0],["يبذل الأصّ بذله المال لكن","ثمَّ فرق في بذل هذين أصّى أصلي",36,"ص",3,0],["يبذلون النفوس لله كلٌ","يتلقى حِمامه جذلانا",37,"ن",2,0],["يبْذُلُوْنَ الْجهْدَ في إدْراكِها","وتَرَى مِنْ فِعْلِها فِيْهِمْ عَجائبْ",38,"ب",1,0],["يبذِّرون مالَهُم بذَخاً","وابنُ أخيهم يشتهي الباقلهْ",39,"ل",2,0],["يبذل النفس والنفيس سخاءً","وفداءً بعزمة الإقدام",40,"م",1,0],["يبذل الراء بغين إذا","أرشف سمعي راحة النطق",41,"ق",1,0]]}