تقول يا فتاح","https://www.aldiwan.net/poem34679.html","الكامل"],[563,"إن الوجود بموجوداته امتزجا","https://www.aldiwan.net/poem34689.html","البسيط"],[563,"هما إحاطتان بالأشياء","https://www.aldiwan.net/poem35075.html","الرجز"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103103","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86588","الكامل"],[971,"","https://poetry.dctabudhabi.ae/diwan/poem/204335","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56296","السريع"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136133","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136314","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136278","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136147","الخفيف"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79534","المنسرح"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141245","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27834","الوافر"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83208","الرمل"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68193","البسيط"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138011",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91051","الطويل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44909","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81917","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81947","البسيط"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35437","الكامل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119510","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72494","الرجز"],[4988,"إحساس شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=202454",""],[5136,"نسيم بارد رطب","https://www.poetsgate.com/ViewPoem.aspx?id=121500",""],[5186,"لا تعد بي إلى ربوع الخيام","https://www.poetsgate.com/ViewPoem.aspx?id=156442",""],[5535,"سأودعك السر الذي قد كتمته","https://www.poetsgate.com/ViewPoem.aspx?id=201513",""],[5561,"ألقت معاذيرها ...","https://www.poetsgate.com/ViewPoem.aspx?id=194433",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5866,"قال من لا يعجزه نظم الحروف الابجدية","https://www.poetsgate.com/ViewPoem.aspx?id=182872",""],[6102,"مراهقة ..","https://www.poetsgate.com/ViewPoem.aspx?id=185048",""]],"verses":[["وإفهام الجهول الحق مرّاً","عناءٌ ليس يشبهه عناءُ",0,"ا",2,0],["وَاِفهَمي عَنّا تَحاوُرَنا","وَاِحكُمي رَضيتُ بِالحُكمِ",1,"م",1,0],["وافِها واجمعِ المصلّينَ فيها","عُصبةً إن أردتَ أو جُمهورا",2,"ر",2,0],["وَآفَةُ النَطّافِ مِن غَضبَةٍ","أَغضَبُها يَوماً فَآتيهِ",3,"ي",2,0],["وآفَةُ العاشِقِ مِنْ طَرْفِهِ","وآفَةُ الصّارِمِ مِنْ حَدّهِ",4,"د",2,0],["وأفهِمْهُمُ بدمٍ أنَّهمْ","عَبيدُكَ إنْ تَدْعُهمْ يَخدُموا",5,"م",3,0],["وأفْهَمُ مِنْ نظرةٍ أنَّني","لشرٍّ فكَرْتُ بهِ أصْلُح !!",6,"ح",1,0],["وافهمي عنا تجاوزنا،","واحكمي، رضيتُ بالحكم",7,"م",1,0],["وافهم السر من نظام بديع","جل مبديه زانه الانتظام",8,"م",1,0],["وافهم شؤن العصر من علمائه","واحذر بان تلوي الى جهاله",9,"ل",2,0],["وافهم من الصفات","مضمون أسرار اللَه",10,"ه",1,0],["وأفهمونَا بمَا يحووُنَ من نُكتٍ","غريبةٍ ما بها لحنٌ ولا زَلَلُ",11,"ل",1,0],["وَآفَةُ العَقلِ الهَوى فَمَن عَلا","عَلى هَواهُ عَقلُهُ فَقَد نَجا",12,"ا",1,0],["وأفهمتني مني بأن ليس موطني","مكاناً به في عالم الحس نشأتي",13,"ي",1,0],["وأفهام أفهام النفوس لطائف ال","معاني التي ذاتها قد تهيت",13,"ت",1,0],["وأفهمَ سرَّ الحبّ خطُّ عذارهِ","ولا شكَّ أن الخطّ يفهم ذا اللبّ",14,"ب",1,0],["وَآفةُ قلب الفَتى عَينهُ","فإِن تَرعَ قَلبك لا تنظُر",15,"ر",1,0],["وافهر ببطشك حاسديه وكن له","عوناً على الأيام يا غوثاه",16,"ا",2,0],["وافْهَمِ السِّرَّ من كلامٍ رَشيقٍ","رُبَّ سِرٍّ قد أَوْدَعوهُ الكَلاما",17,"م",2,0],["وافْهَمِ المَضْمونَ بالرَّمزِ العَجيبْ","وانتَفِعْ من نظمِ ما زاغَ البصَرْ",18,"ر",1,0],["وافهم الأمر به يا أمره","تعرف الأمر مع الكل فنون",19,"ن",1,0],["وافهم معاني حروف الخلق أقوى فهمْ","وارفع قناع الحجى واخرق حجاب الوهمْ",20,"م",1,0],["وافهم إشارة قوله قد جاءكم","من عين أنفسكم إليكم مرسل",21,"ل",1,0],["وافهم من القرآن مستدركاً","ما خرب العقل بتعميره",22,"ر",2,0],["وافهم مقالة عارف","ودع المرا والإفترا",23,"ر",2,0],["وافهم ولا تفهم وتب عن توبة","هذا مقامك ما عليك جناح",24,"ح",1,0],["وافهم كلامي كفهمي أو فدعه ولا","تتبع أولى الجهل فينا واترك الهمجا",25,"ج",2,0],["وافهم كلامي واتبع القرآن لا","تعدل إلى العقول والآراء",26,"ا",2,0],["وأفهمني سر الحروف حديثه","وفي قوله حققت أسماءه الحسنى",27,"ن",2,0],["وَاِفَهم حَقيقة ما يقال بمجلس","إِن كُنت مَعدوداً مِن النَبهاء",28,"ا",2,0],["وآفة الصبِّ مثلي أن يبثّ جوىً","لمن يحبُّ ولا يُلوى له جيد",29,"د",1,0],["وآفة العريان في عمره","برد الشتا وهوله المخنقُ",30,"ق",1,0],["وافهم وقرب إلى العرفان شاهده","وقم بحق الهوى في غيب اياته",31,"ت",2,0],["وافهم رموزي ودم في السير متخذاً","محجة العلم مرقى وادن واغتنم",32,"م",1,0],["وافهم رموزاً سلكنا في تحققها","معنى رأينا به التفصيل في الجمل",33,"ل",1,0],["وافهم الرمز في مباني متون ال","حق من حيثما تريك الشروح",34,"ح",1,0],["وآفةَ الأموالِ","بدرَ بني ميكالِ",35,"ل",1,0],["وأفهموا الأغنياء القائمين بنا","إن التعاون إجلالٌ وإعلاء",36,"ا",2,0],["وأفهمني بأنْ أحظى","به في العالم الوسَط",37,"ط",1,0],["وَاِفهَمِ الماضي لِأَجدادٍ هُمُ","فَخرُ أَجيالٍ بِرَغمِ الأَرغَمِ",38,"م",1,0],["وافهم كلامي وحقق ما تراه هنا","وميز الفرق والزم ساحة الأدب",39,"ب",1,0],["وافهم الرمز وابعد في حقيقته مغزاك","واحذر الناس لي تسعى لتخريب مبناك",40,"ك",1,0],["وآفة السادة والأتباع","ومنتهى الإفساد في المساعي",41,"ي",1,0],["وَأَفهمنا سرَّ الوُجود وَجودُنا","وَأَعلمنا أن الدَواعي بَواعث",42,"ث",1,0],["وَأفهَمَ الحَقَّ ذَوِى الأَذهَانِ","وأَفحَمَ الخُصُومَ باِالبُرهَانِ",43,"ن",1,0],["وآفة القرب ادكار البعد","شاور فدتك النفس أهل الأدب",44,"ب",1,0],["وَأَفهِموهُ إِذا ساءَت مَسامِعُهُ","أَنَّ الحَياةَ تَجاريبٌ وَتِكرارُ",45,"ر",1,0],["وأفهم الناس عن غيٍّ برقدتهم","فأصبحوا كدواب الرعي للعشب",46,"ب",1,0],["وأفهمت سائر الأقطار دعوته","وحشرها ألسنٌ صيغت من الذهب",47,"ب",1,0],["وَاِفهَم لَطيفَةَ حاذِقٌ مِن أَهلِهِ","ظَنَّ الكَليمُ النورَ نار الساري",48,"ر",2,0],["وافهم كلامي يا أبا عامرٍ","لا يشبه العنوان ما في الكتاب",49,"ب",1,0],["وأفهم الحاذق تشخيص العلل","من الاطباء لسائر الملل",50,"ل",1,0],["وافهق ضلوع المشاعر شوف قلبي من وصله","واكتشف بعيون قلبك وش يصير وما يصير",51,"ر",1,0],["وأفهمني كلاماً لا","تعيه الرسل والكتب",52,"ب",1,0],["وافهموا كيف إنهم آخذونا","بسنام ومقود وزمام",53,"م",1,0],["وأفهمك المعنى اللطيف من الهوى","واشرحه حتى تقول فهمته",54,"ت",2,0],["وآفةُ الذلِّ تضنيها وتصفَعُها","كأنّما طللٌ مُذ شاخَ صارَ فما",55,"م",2,0],["وأفهمت الأنبياء أنه مطلق الن","نبوة فرد في كمال الخلافتي",56,"ت",2,0],["وافهمو بالربع والتوجية لعموم الرعية","طاعة اولاة الامور من الامور الواجباتي",57,"ت",2,0],["وَافهَمِي - يا فَتَاةُ - جَوهَرَ قَولِي","إِنَّ خَيرَ الصِّفاتِ ما الشَّرَّ جَبَّتْ",58,"ت",1,0]]}