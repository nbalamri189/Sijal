{"poems":[[55,"سقاها وإن لم يرو قلبي بيانها","https://www.aldiwan.net/poem29650.html","الطويل"],[88,"حطمت اليراع فلا تعجبي","https://www.aldiwan.net/poem10923.html","المتقارب"],[53,"أبيتم أن تفيدوا شكر مثلي","https://www.aldiwan.net/poem8129.html","الوافر"],[53,"أكلت رغيفا عند عيسى فملني","https://www.aldiwan.net/poem8173.html","الطويل"],[93,"رآني الله ذات يوم في الأرض أبكي من الشقاء","https://www.aldiwan.net/poem8734.html","عموديه"],[93,"من الفرنسيس قيد العين صورتها","https://www.aldiwan.net/poem8873.html","عموديه"],[72,"بروحي من قد زارني وهو خائف","https://www.aldiwan.net/poem42941.html","الطويل"],[45,"ملث القطر أعطشها ربوعا","https://www.aldiwan.net/poem9722.html","الوافر"],[64,"لقاء الأماني في ضمان القواضب","https://www.aldiwan.net/poem52506.html","الطويل"],[47,"ومستضحك من عبرتي وبكائي","https://www.aldiwan.net/poem10209.html","الطويل"],[30,"ألستم عائجين بنا لعنا","https://www.aldiwan.net/poem5607.html","الوافر"],[99,"يا من طواها الليل في بيدائه","https://www.aldiwan.net/poem25096.html","الكامل"],[46,"أظن دموعها سنن الفريد","https://www.aldiwan.net/poem30546.html","الوافر"],[92,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[48,"عذيري من الدنيا عرتني بظلمها","https://www.aldiwan.net/poem22189.html","الطويل"],[48,"رآني في الكرى رجل كأني","https://www.aldiwan.net/poem22840.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42698","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55227","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[53,"أبيتُم أن تُقيدوا شكرَ مثلي","https://www.poetsgate.com/ViewPoem.aspx?id=26199",""],[228,"عذيرك من مستلهمين تصدروا","https://www.aldiwan.net/poem39687.html","الطويل"],[266,"إلام اصطباري لا يرى غير خائب","https://www.aldiwan.net/poem38372.html","الطويل"],[280,"أجار من الخطب الأمير محمد","https://www.aldiwan.net/poem25580.html","الطويل"],[287,"أقر نجدا ومن بنجد سلامي","https://www.aldiwan.net/poem32631.html","الخفيف"],[463,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[484,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[505,"رآني بمرط الإنكسار أخو الهوى","https://www.aldiwan.net/poem37972.html","الطويل"],[520,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[520,"أمالي من عذولكم عذير","https://www.aldiwan.net/poem12131.html","الوافر"],[558,"ومنتجع حمدي بأكرم رائد","https://www.aldiwan.net/poem68386.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48728","الكامل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104592","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64177","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38402","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37933","الطويل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123362","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72328","السريع"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117717","الطويل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102318","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44851","الوافر"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111877","المتقارب"],[1870,"","https://poetry.dctabudhabi.ae/diwan/poem/20042","الطويل"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105291","المتقارب"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42423","الوافر"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124177","الطويل"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121928","الطويل"],[2293,"","https://poetry.dctabudhabi.ae/diwan/poem/198998","الطويل"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111672","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129992","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75946","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65947","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202715","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205079","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204692","الهزج"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131896","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86256","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77176","الطويل"],[3996,"","https://poetry.dctabudhabi.ae/diwan/poem/114911","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83638","الطويل"],[4532,"","https://poetry.dctabudhabi.ae/diwan/poem/45298","الطويل"],[182,"يا من هواهُ أعزّني","https://www.poetsgate.com/ViewPoem.aspx?id=72792",""],[182,"الرويبضة","https://www.poetsgate.com/ViewPoem.aspx?id=72840",""],[5150,"تموز رمز الشهادة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204037",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5587,"جيتك يا حبي","https://www.poetsgate.com/ViewPoem.aspx?id=197806",""],[5587,"جاني كلام","https://www.poetsgate.com/ViewPoem.aspx?id=197890",""],[5829,"الأمل الباقي","https://www.poetsgate.com/ViewPoem.aspx?id=151395",""],[5978,"آمال عجاف","https://www.poetsgate.com/ViewPoem.aspx?id=191287",""],[161,"الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=157684",""],[6093,"حَرْثُ فِكْرٍ ( الطويل)","https://www.poetsgate.com/ViewPoem.aspx?id=183200",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""]],"verses":[["رَآني بَهاءُ المُلكِ سَيفاً عَلَيكُمُ","جَرِيءَ الظُبى لا يَنثَني صَلَتانُها",0,"ن",3,0],["رَآنا نِياماً وَلَمّا نُفِق","فَشَمَّرَ لِلسَعيِ وَالمَكسَبِ",1,"ب",1,0],["رآني اللَّه أرفعَ من جَداكم","وأنَّى تُمْطِر الأرضُ والسماءَ",2,"ا",2,0],["رآني قليلَ الخوف من لحظاته","وذلك من شأني لهُ غيرُ مُعجبُ",3,"ب",1,0],["رَآنِيَ اللَهُ ذاتَ يَومٍ","في الأَرضِ أَبكي مِنَ الشَقاء",4,"ا",2,1],["رانَ الهَيامُ عَلى الصَبَّينِ فَاِعتَنَقا","لا يَملِكانِ النُهى وِردا وَلا صَدِرا",5,"ر",2,0],["رَآني عَليلاً في هَواهُ فَعادَني","حَبيبٌ لَهُ بِالمَكرُماتُ عَوائِدُ",6,"د",1,0],["رَآني بَعدَ ما قَطَعَ المَطايا","تَيَمُّمُهُ وَقَطَّعَتِ القُطوعا",7,"ع",2,0],["رآنِيَ والأيامُ تَحرِقُ نابَها","فأنقذَ شِلْوِي من نُيُوبِ النوائبِ",8,"ب",1,0],["رَآني وَعَيني بِالدُموعِ غَزيرَةٌ","وَقَد هَتَكَ الهِجرانُ سِترَ عَزائي",9,"ا",3,0],["رَآني الغانِياتُ فَقُلنَ هَذا","أَبونا جاءَ مِن تَحتِ السِلامِ",10,"م",1,0],["ران السواد على وجود الدور","وسرى إليّ نحيبها والأدمع",11,"ع",1,0],["رَآنا مُشعَري أَرَقٍ وَحُزنٍ","وَبُغيَتُهُ لَدى الرَكبِ الهُجودِ",12,"د",1,0],["رانَ الخمولُ عليه واستبدَّ به","جذبُ الجواذب من هَنّا ومن هِينا",13,"ن",2,0],["رَآنِيَ رَبُّ الناسِ فيها مُتابِعاً","هَوايَ فَوَيحي يَومَ أَسكُنُ هُوَّتي",14,"ت",2,0],["رآني في الكَرى رَجَلٌ كَأَنّي","مِنَ الذَهَبِ اِتَّخَذَتُ غِشاءَ راسي",15,"س",2,1],["رآنا فأعرض عنَّا ولمْ","يُحَييِّ السماءَ بروحٍ قريرْ",16,"ر",1,0],["رَآنِي بِهِ مُولَعاً","فَعَاتَبَنِي وانْحَرَفْ",17,"ف",1,0],["رَانَ الكَرَى دَهْراً عَلَى أَجْفَانِهِ","فَالْعَيْشُ مِمَّا رَقَّ شِبْهُ مَنَامِ",18,"م",1,0],["رانَ الذهولُ فكل عقل حائر","وجرى القضاءُ فكل طرف غافي",19,"ف",2,0],["رآني اللَّهُ أرفعَ من جَداكم","وأنَّى تُمْطِر الأرضُ السماءَ",20,"ا",2,0],["رَآني حَوارِيُّ القَريضِ فَقالَ لي","أَتاني هُدىً مِنهُ فَقُمتُ أُبَشِّرُ",21,"ر",1,0],["رانت الذي أنعمت لي برغائب","فعوضت من شكري لها برغائب",22,"ب",1,0],["رَآنيَ مرْدودَ الشّرائعِ كُلّما","تَقَرّبْتُ بالإخْلاصِ أُقصَى وأُبْعَدُ",23,"د",1,0],["رانِياتٍ بِأَعيُنٍ رامِياتٍ","بِسِهامٍ واها لَها مِن سِهامِ",24,"م",1,0],["رانٍ عليّ على ارتفاع سمائه","بَرٍّ بوفدِ مدائحي ومَحامدي",25,"د",2,0],["رآني للزيارة كنت أهلا","وبالإيقاف لم ينقص مقامي",26,"م",2,0],["رآني بمِرْطِ الإنْكِسارِ أَخو الهَوَى","فأَهمَلَني من طمسِ طابِعِ طَبْعِهِ",27,"ع",2,1],["رآني بعين لو رأت يابس الثرى","لأينع مخضراً وأورق عود",28,"د",1,0],["رآني والعيون بها تعام","ومات الأعمى سواء والبصير",29,"ر",1,0],["رَآني بِعَينِ الجودِ فَاِنتَهَزَ الَّتي","طَلَبتُ وَلَم أَفتَح إِلَيهِ بِها فَما",30,"م",2,0],["رانت على ألبابهم شبهاتهم","في الدين فاتهموا اليقين وفنّدوا",31,"د",3,0],["رآنيَ صَرفُ الدهرِ حُرّاً فراعني","كذلك صَرَفُ الدهرِ يفعلُ بالحر",32,"ر",1,0],["رانٍ بِفُصَّيْ عقيقٍ يدركان له","من حِدَّةٍ فيهما ما ليس محدودا",33,"د",2,0],["رَآني عَدوِّي فَاِنفَعلت وَقَد بَدا","تَغيّرُ وَجهي حينَما لي قَدِ اِعتَرَض",34,"ض",1,1],["رَآنيَ لَم أَقدرْ أَرى شَمسَ وَجهِهِ","فَردَّ عَلَيها أَلطَفَ الغيمِ كَي أَرى",35,"ر",2,0],["رآني عليٌّ لاعِباً بقرائنٍ","فجاء بأُخرى مثلِها غيرَ لاعب",36,"ب",1,0],["رآني في البيض الوجوه الأُلى","فاقوا الورى الشم العرايين",37,"ن",1,0],["رآني حُساماً ماضياً فأقامني","مدى الدهر في وجهِ الأعادي مُجردا",38,"د",2,0],["رآني محني الضلوع على جوى","فما رق لي مما ألاقي ولا حنا",39,"ن",2,0],["رَآنَا البَحرُ نَرزَؤُهُ بَنِيهِ","فَضَعضَعَ مِن مُنَانَا مَا بَنَاهُ",40,"ا",2,0],["رآني اصوغُ الكلامَ عقوداً","فقال سرقتَ وماكانَ صادق",41,"ق",1,1],["رَآني عَلى ما بي عُمَيلَةُ فَاِشتَكى","إِلى مالِهِ حالي أَسَرَّ كَما جَهَر",42,"ر",1,1],["رآني صغيراً فلم يعتبر","مقامي وأعلى النجوم الصغار",43,"ر",1,0],["رآني مُقبلاً يوماً وقَلبي","بهِ قلقٌ ودمعُ العينِ هاتنْ",44,"ن",1,0],["رآني خيالاً حين وافى خياله","فأطرق من فرط الحياء طروقه",45,"ق",2,0],["رآنى غريبا مفردا بين أسرتى","فأيقن انى بالخمول شهير",46,"ر",1,0],["رآنا عياناً عين معنى وجوده","فعاج عن الشكوى وفوض في البلوى",47,"و",2,0],["رآني فأوراني عجائب لطفه","فَهِمتُ وقلبي بالفراق يذوبُ",48,"ب",1,1],["رآني أظما في الهجيرَة ضاحياً","فرَقّ وآواني إلى الماء والظلِّ",49,"ل",1,0],["رَآني أَخا صَمتٍ وَسَمتٍ فَظَنَّني","تُؤثِّر في المُوهِماتُ هَوادِسُه",50,"س",2,0],["رآنا سمونا فارتدى الحسد عتوة","وكل سمو فيه رغم لحاسد",51,"د",1,0],["رآني جاهل في سفح تلٍّ","أطل به على أبهى مناظر",52,"ر",1,1],["رآني فقدتُ جميل الحياة","فأسعفني بجميل الدعا",53,"ا",1,0],["رآني صادق القول","فناجاني بأسرار",54,"ر",1,0],["رآنى أعانى حملَ شوق إلى الحمى","فساعدنى بالحمل فوق الرواحل",55,"ل",1,0],["رَآنا امير المُؤمِنين فَريسَة","إِلى بَعضِ اقوام لَهُم سوء اضمار",56,"ر",1,0],["رَآني أُعاني عِبءٍ ما قَد أُنيطَ بي","فَساعَدَني في حَمل ما يَتَقَرطَس",57,"س",1,0],["رآني شجاً في حلقه ما يسيغُهُ","فما ان يزال الدهرَ يُحرَض بي حَرضا",58,"ض",2,0],["رَآنيَ في سجن الفَضيلَة راقِداً","فَأَيقَظَني لِلحَربِ وَالحَربُ تقربُ",59,"ب",1,0],["رَآني فَآساني وَلو صَدَّ أَلُم","عَلى حينِ لا بادٍ يُرَجّى وَلا حَضَرْ",60,"ر",1,0],["رانَ الهوانُ عليّ ردحاً هَدَّني","مُذْ صرت لي يا مُهجتي أنصفتَني",61,"ن",2,0],["ران الفساد وانت من حراسه","جافاك حسن الخلق اغراك السراب",62,"ب",1,0],["رآنا بين من تاهوا رشَدنا","فيسَّرَنا على نهجِ الريادَهْ",63,"د",2,0],["ران بحق مغتصب","رام بحق مكتسب",64,"ب",1,0],["رَانِي نَبْغِي كَانْ قِيسْ إِلِّي يَسْبِي","وْمِنْ عَاتَبْ لَيْلَله مِنْهُ عَقْلُو غَابْ",65,"ب",1,0],["رَانِي عُدتْ نْهُومْ كُلْ عْشِيَّة","خْيَالِكْ رُوحِي مَا تْفَارِقْهَاشْ",66,"ش",1,0],["رانت على صدري فاستحكمت وجنت","ظلماً بلا رأفٍ يرجى وقسطاس",67,"س",1,0],["رانت على جسدِ الرعاةِ خرافهم","واستغفروا من قلبهم فتحجَّرا",68,"ر",2,0],["14- رَانَ الخُنُوعُ على قلوبٍ قَلَّدَتْ","والأَصْلُ يَرْفَعُ قَدْرَهُ حُرَّاسُهُ",69,"س",2,0],["رَآني على حَالٍ مِنَ الصَّمتِ صاحبي","فأَشْغَلهُ إِطْرَاقُ إطْرَاق مُجْهَدِ",70,"د",1,1],["رانت عليها الخطايا فهي صادئة","والقلب يصدأ إن لم تجله حينا",71,"ن",2,0]]}