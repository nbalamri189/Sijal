{"poems":[[53,"سقاها وإن لم يرو قلبي بيانها","https://www.aldiwan.net/poem29650.html","الطويل"],[86,"حطمت اليراع فلا تعجبي","https://www.aldiwan.net/poem10923.html","المتقارب"],[51,"أبيتم أن تفيدوا شكر مثلي","https://www.aldiwan.net/poem8129.html","الوافر"],[51,"أكلت رغيفا عند عيسى فملني","https://www.aldiwan.net/poem8173.html","الطويل"],[91,"رآني الله ذات يوم في الأرض أبكي من الشقاء","https://www.aldiwan.net/poem8734.html","عموديه"],[91,"من الفرنسيس قيد العين صورتها","https://www.aldiwan.net/poem8873.html","عموديه"],[70,"بروحي من قد زارني وهو خائف","https://www.aldiwan.net/poem42941.html","الطويل"],[43,"ملث القطر أعطشها ربوعا","https://www.aldiwan.net/poem9722.html","الوافر"],[62,"لقاء الأماني في ضمان القواضب","https://www.aldiwan.net/poem52506.html","الطويل"],[45,"ومستضحك من عبرتي وبكائي","https://www.aldiwan.net/poem10209.html","الطويل"],[28,"ألستم عائجين بنا لعنا","https://www.aldiwan.net/poem5607.html","الوافر"],[97,"يا من طواها الليل في بيدائه","https://www.aldiwan.net/poem25096.html","الكامل"],[44,"أظن دموعها سنن الفريد","https://www.aldiwan.net/poem30546.html","الوافر"],[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[46,"عذيري من الدنيا عرتني بظلمها","https://www.aldiwan.net/poem22189.html","الطويل"],[46,"رآني في الكرى رجل كأني","https://www.aldiwan.net/poem22840.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42698","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55227","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[51,"أبيتُم أن تُقيدوا شكرَ مثلي","https://www.poetsgate.com/ViewPoem.aspx?id=26199",""],[221,"عذيرك من مستلهمين تصدروا","https://www.aldiwan.net/poem39687.html","الطويل"],[259,"إلام اصطباري لا يرى غير خائب","https://www.aldiwan.net/poem38372.html","الطويل"],[273,"أجار من الخطب الأمير محمد","https://www.aldiwan.net/poem25580.html","الطويل"],[280,"أقر نجدا ومن بنجد سلامي","https://www.aldiwan.net/poem32631.html","الخفيف"],[456,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[477,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[498,"رآني بمرط الإنكسار أخو الهوى","https://www.aldiwan.net/poem37972.html","الطويل"],[513,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[513,"أمالي من عذولكم عذير","https://www.aldiwan.net/poem12131.html","الوافر"],[551,"ومنتجع حمدي بأكرم رائد","https://www.aldiwan.net/poem68386.html","الطويل"]],"verses":[["رَآني بَهاءُ المُلكِ سَيفاً عَلَيكُمُ","جَرِيءَ الظُبى لا يَنثَني صَلَتانُها",0,"ن",3,0],["رَآنا نِياماً وَلَمّا نُفِق","فَشَمَّرَ لِلسَعيِ وَالمَكسَبِ",1,"ب",1,0],["رآني اللَّه أرفعَ من جَداكم","وأنَّى تُمْطِر الأرضُ والسماءَ",2,"ا",2,0],["رآني قليلَ الخوف من لحظاته","وذلك من شأني لهُ غيرُ مُعجبُ",3,"ب",1,0],["رَآنِيَ اللَهُ ذاتَ يَومٍ","في الأَرضِ أَبكي مِنَ الشَقاء",4,"ا",2,1],["رانَ الهَيامُ عَلى الصَبَّينِ فَاِعتَنَقا","لا يَملِكانِ النُهى وِردا وَلا صَدِرا",5,"ر",2,0],["رَآني عَليلاً في هَواهُ فَعادَني","حَبيبٌ لَهُ بِالمَكرُماتُ عَوائِدُ",6,"د",1,0],["رَآني بَعدَ ما قَطَعَ المَطايا","تَيَمُّمُهُ وَقَطَّعَتِ القُطوعا",7,"ع",2,0],["رآنِيَ والأيامُ تَحرِقُ نابَها","فأنقذَ شِلْوِي من نُيُوبِ النوائبِ",8,"ب",1,0],["رَآني وَعَيني بِالدُموعِ غَزيرَةٌ","وَقَد هَتَكَ الهِجرانُ سِترَ عَزائي",9,"ا",3,0],["رَآني الغانِياتُ فَقُلنَ هَذا","أَبونا جاءَ مِن تَحتِ السِلامِ",10,"م",1,0],["ران السواد على وجود الدور","وسرى إليّ نحيبها والأدمع",11,"ع",1,0],["رَآنا مُشعَري أَرَقٍ وَحُزنٍ","وَبُغيَتُهُ لَدى الرَكبِ الهُجودِ",12,"د",1,0],["رانَ الخمولُ عليه واستبدَّ به","جذبُ الجواذب من هَنّا ومن هِينا",13,"ن",2,0],["رَآنِيَ رَبُّ الناسِ فيها مُتابِعاً","هَوايَ فَوَيحي يَومَ أَسكُنُ هُوَّتي",14,"ت",2,0],["رآني في الكَرى رَجَلٌ كَأَنّي","مِنَ الذَهَبِ اِتَّخَذَتُ غِشاءَ راسي",15,"ي",1,1],["رآنا فأعرض عنَّا ولمْ","يُحَييِّ السماءَ بروحٍ قريرْ",16,"ر",1,0],["رَآنِي بِهِ مُولَعاً","فَعَاتَبَنِي وانْحَرَفْ",17,"ف",1,0],["رَانَ الكَرَى دَهْراً عَلَى أَجْفَانِهِ","فَالْعَيْشُ مِمَّا رَقَّ شِبْهُ مَنَامِ",18,"م",1,0],["رانَ الذهولُ فكل عقل حائر","وجرى القضاءُ فكل طرف غافي",19,"ف",2,0],["رآني اللَّهُ أرفعَ من جَداكم","وأنَّى تُمْطِر الأرضُ السماءَ",20,"ا",2,0],["رَآني حَوارِيُّ القَريضِ فَقالَ لي","أَتاني هُدىً مِنهُ فَقُمتُ أُبَشِّرُ",21,"ر",1,0],["رانت الذي أنعمت لي برغائب","فعوضت من شكري لها برغائب",22,"ب",1,0],["رَآنيَ مرْدودَ الشّرائعِ كُلّما","تَقَرّبْتُ بالإخْلاصِ أُقصَى وأُبْعَدُ",23,"د",1,0],["رانِياتٍ بِأَعيُنٍ رامِياتٍ","بِسِهامٍ واها لَها مِن سِهامِ",24,"م",1,0],["رانٍ عليّ على ارتفاع سمائه","بَرٍّ بوفدِ مدائحي ومَحامدي",25,"د",2,0],["رآني للزيارة كنت أهلا","وبالإيقاف لم ينقص مقامي",26,"م",2,0],["رآني بمِرْطِ الإنْكِسارِ أَخو الهَوَى","فأَهمَلَني من طمسِ طابِعِ طَبْعِهِ",27,"ع",2,1],["رآني بعين لو رأت يابس الثرى","لأينع مخضراً وأورق عود",28,"د",1,0],["رآني والعيون بها تعام","ومات الأعمى سواء والبصير",29,"ر",1,0],["رَآني بِعَينِ الجودِ فَاِنتَهَزَ الَّتي","طَلَبتُ وَلَم أَفتَح إِلَيهِ بِها فَما",30,"م",2,0]]}