",""],[4984,"بشرى","https://www.poetsgate.com/ViewPoem.aspx?id=175838",""],[4984,"عَوْدَةٌ - جِدَارِيَّةٌ : 09 -","https://www.poetsgate.com/ViewPoem.aspx?id=187631",""],[5064,"أهازيجُ الغُبار","https://www.poetsgate.com/ViewPoem.aspx?id=199174",""],[231,"إلى الشاطئ المجهول","https://www.poetsgate.com/ViewPoem.aspx?id=186165",""],[5274,"أحلام أندلسية","https://www.poetsgate.com/ViewPoem.aspx?id=207438",""],[5277,"من يصدقُ يغار","https://www.poetsgate.com/ViewPoem.aspx?id=206846",""],[5302,"ملحمة الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=200060",""],[5314,"رسول الله وانبثقت حياة","https://www.poetsgate.com/ViewPoem.aspx?id=214860",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5431,"وبالخيبات قد رجع البريدُ","https://www.poetsgate.com/ViewPoem.aspx?id=191824",""],[5431,"الريم ..لوحة ذاتية","https://www.poetsgate.com/ViewPoem.aspx?id=206889",""],[5442,"دع الصب يدمع منه المآقيا","https://www.poetsgate.com/ViewPoem.aspx?id=114761",""],[5596,"اليحمدي","https://www.poetsgate.com/ViewPoem.aspx?id=206710",""],[5605,"لهب في اللهب","https://www.poetsgate.com/ViewPoem.aspx?id=160691",""],[5606,"ترى الزعل ممنوع يامودماني","https://www.poetsgate.com/ViewPoem.aspx?id=195382",""],[5616,"مزاج","https://www.poetsgate.com/ViewPoem.aspx?id=203198",""],[5725,"هواي عذري","https://www.poetsgate.com/ViewPoem.aspx?id=177796",""],[5725,"هنا كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=206598",""],[5725,"الى حيث لا أدري","https://www.poetsgate.com/ViewPoem.aspx?id=214796",""],[5732,"يا نور عيني","https://www.poetsgate.com/ViewPoem.aspx?id=177930",""],[5770,"على اليرموك","https://www.poetsgate.com/ViewPoem.aspx?id=178268",""],[402,"إلى الغادة الزهراء من آل فاضل","https://www.poetsgate.com/ViewPoem.aspx?id=35397",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5845,"أمن نيابتي برع تقيم","https://www.poetsgate.com/ViewPoem.aspx?id=16700",""],[5848,"الى حال دون الباب","https://www.poetsgate.com/ViewPoem.aspx?id=48847",""],[5855,"بوادر دمعك ما تنزف","https://www.poetsgate.com/ViewPoem.aspx?id=186553",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""],[5961,"الى حي المليحة سر","https://www.poetsgate.com/ViewPoem.aspx?id=199805",""],[6068,"ل بُونَةَ فِي قَلْبِي غَرَامٌ مُطَابِق -26-","https://www.poetsgate.com/ViewPoem.aspx?id=175807",""],[6093,"تحج نوايا لا مطايا تقلها","https://www.poetsgate.com/ViewPoem.aspx?id=205931",""],[6167,"أمام البيت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85535&r=&rc=18",""],[2220,"أصرِّفه في كلِّ وقتٍ تصرُّفا أصرِّفه في كلِّ وقتٍ تصرُّفا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11549&r=&rc=423",""],[5126,"أعَاذلتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87835&r=&rc=49",""]],"verses":[["أُليحُ مِنهُ رُوَيداً أَو عَلى عَجَلٍ","لَو كانَ يَنفَعُ إِروادي وَإِعجالي",0,"ل",2,0],["إِلى حَيثُ تومي إِلَيكَ البَنانُ","وَتُصبِحُ ثَمَّ الأَعَزُّ المُجَلّا",1,"ل",2,0],["إِلى حَسَبٍ مِنهُ عَلى البَدرِ عِمَّةٌ","وَفي عاتِقِ الجَوزاءِ مِنهُ نِجادُ",2,"د",1,0],["إِلى حَيِّ مَن كانَ الإِمامُ عَدُوَّهُ","وَصَبَّحَهُ مِن أَمرِهِ بِقَضاءِ",3,"ا",2,0],["إِلى حَبيبٍ كَنَيتُ عَنهُ","أَجَلَّ ذِكرَ اِسمِهِ لِساني",4,"ن",2,0],["إلى حبْرِ السّياسَةِ لا يُجارَى","ولا يَبْغِي مُعارِضُهُ اللِّحاقَا",5,"ق",2,0],["إِلى حامِلِ الثِقلِ عَن أَهلِهِ","إِذا الدَهرُ ساقَ الهَناتِ الكِبارا",6,"ر",2,0],["إِلَى حِلاَها الغَوالِي","بِهِ أَضَافَتْ حُلِيَّا",7,"ي",2,0],["إِلَى حَيَاءٍ إِلَى جُودٍ بِصَنْعَتِهِ","وَبِالمُبَرَّاتِ لا يَفْسِدْنَ بِالمَنَنِ",8,"ن",1,0],["إلى حرمِ الأمن المنيع جواره","إذا ظلت الأصوات بالروعِ تجأر",9,"ر",1,0],["إلى حلبٍ رمت السرى بعد بُعدكم","فعارضني أيضاً زمان بعائق",10,"ق",1,1],["إلى حياً جاء إلى رائدٍ","فالآن تروى غلة الهيم",11,"م",1,0],["إلى حمى علمه وأنعمه","لكلِّ سامي الطلاّب مستامه",12,"م",2,0],["إلى حاجبيها صارَ قلبي صبابة","وقلبيَ منها قاب قوسين أو أدنى",13,"ن",2,0],["إِلى حَتفي سَعى قَدَمي","أَرى قَدَمي أَراقَ دَمي",14,"ي",1,1],["إِلى حَيثُ أَلقَت يا زَمانَ المَظالِمِ","وَلا عُدتَ يا عَهدَ الشَقا المُتَقادِمِ",15,"م",1,1],["إِلى حَكَمٍ تَناجَلَ مَنسِماها","حَصى المَعزاءُ مِن كَنَفَي حَقيلِ",16,"ل",1,1],["إلى حيثُ تَجْني كفُّهُ بَذْرَ أَمْسِهِ","ومُزْدَرعُ الأَوجاعَ لا بدَّ يَنْدَمُ",17,"م",1,0],["إِلى حَيثُ آباءُ الفَتى يَذهَبُ الفَتى","سَبيلٌ يَدينُ العالَمونَ بِها قِدما",18,"م",2,0],["إِلى حُسَينٍ حاكِمِ القَنالِ","مِثالِ حُسنِ الخُلقِ في الرِجالِ",19,"ل",1,1],["أُليحُ مِنَ الغَواني أَن تَرى لي","ذَوائِبَ لائِحاً فيها القَتيرُ",20,"ر",1,0],["إِلى حَيثُ مَدَّ المُلكُ أَطنابَ بَيتِهِ","عَلى اِبنِ أَبي الأَعياصِ في المَنزِلِ الرَحبِ",21,"ب",1,0],["إِلى حَيثُ تَلقاني تَميمٌ إِذا بَدَت","وَزُدتُ عَلى قَومٍ عُداةٍ لِتُنصَرا",22,"ر",2,0],["إِلى حُجُرِ الأَضيافِ كُلَّ عَشِيَّةٍ","بِذي حَلَقٍ تَمشي بِهِ تَتَدَعدَعُ",23,"ع",1,0],["إِلى حُجرَةٍ كَم مِن خِباءٍ وَقُبَّةٍ","إِلَيها وَهُلّاكٍ كَثيرٌ عِيالُها",24,"ل",3,0],["إِلى حَيثُ صارَت مِن لُؤَيِّ اِبنِ غالِبٍ","إِلى بَيتِهِ أَحسابُها وَظِلالُها",25,"ل",3,0],["إِلى حُفرَةٍ أُهدى إِلَيها مُقيمَةٍ","يَحُثُّ إِلَيها سائِقٌ مِن وَرائِيا",26,"ي",2,0],["إِلى حائِطِ الثَغرِ الَّذي يورِدُ القَنا","مِنَ الثُغرَةِ الرَيّا القَليبَ المُهَدَّما",27,"م",2,0],["إِلى حَيثُ يُلفى الجودُ سَهلاً مَنالُهُ","وَخَيرَ اِمرِئٍ شُدَّت إِلَيهِ وَحَطَّتِ",28,"ت",1,0],["إلى حِسْمَى فما للداءِ حَسْمٌ","إذا لم تَرْقِهِ بدمٍ مُراقِ",29,"ق",1,0],["إِلى حاناتِ خَمرٍ في كُرومٍ","مُعَرَّشَةٍ مُعَرَّجَةِ النَواحي",30,"ح",2,0],["إلى حيث يَلقى الحر للحق ذادة","كراماً فلا ضيم هناك ولا حقد",31,"د",1,0],["إلى حيث لا يرجى مآب لراحل","إليه وَهَل من مورد الموت مصدر",32,"ر",1,0],["إلى حيث لا شمس النهار مطلة","وَلا اللَيل نظّارٌ بأعينه النجل",33,"ل",1,0],["إلى حيث ينمو الرأيُ حُراً تذيعه","من الحقِّ فيها ألسنٌ وصحائفُ",34,"ف",1,0],["إلى حارمٍ قاد العتاق سواهماً","لها من نشاطٍ بالكماة زمال",35,"ل",1,0],["إلىَ حَيثُ يُنْجَى مِن مَخَالِبِ حَتْفِهِ","غَرِيقٌ وَيُوقَى الظَّالمِينَ غَرِيبُ",36,"ب",1,0],["إِلَّي حَبِيبٌ قُوْمُها وَهَوَاؤُهَا","وَمَا ثَمَّ مِنْ حَيٍّ وَمَاءٍ وجَلْمَد",37,"د",1,0],["إلى حُفرةٍ غبراءَ يُكْرهُ ورِدُها","سِوى أنها مثوى وضيعٍ وسِّيدِ",38,"د",1,0],["إلى حَمَدٍ ترنو المعالي مُدِلَّةً","وتُلْقي بأسباب النُّهى والفضائل",39,"ل",1,0],["الى حفرة ضمت من الجود بحره","رويدا هو البحر المحيط يدمدم",40,"م",1,0],["إلى حَيْثُ صَارَتْ من لُؤيّ بنِ غالبٍ","إلى بَيْتِهِ أحْسَابُهَا وَظِلالُها",41,"ل",3,0],["إِلَى حَيْثُ يُرْوِي النِّيلُ بَاسِقَةَ النَّحْلِ","فَلاَخِيَّةٌ مَا درَّهَا ثَدْيُ أُمهَا",42,"ه",2,0],["إِلى حَيْثُ يَخْشَى نَاسِكٌ زَلَّةَ الرِّجْلِ","فَمَرَّ بِهَا فِي حَانَةٍ نَفَرٌ أُولُو",42,"و",1,0],["إلى حيث ألقت يا يا زمان المظالم","ولا عدت يا عهد الشّقا المتقادم",43,"م",1,1],["إِلى حِماك وَفدنا حامِلين عَلى","ظُهورِنا وَقر آثام عَلى كبر",44,"ر",1,0],["إِلى حِماكُم عَلى خَيل المُنا جِينا","وَذكركهم في دَياجينا مُناجينا",45,"ن",2,1],["الى حلب الشهباء ثار بنا الوجد","وطال علينا الهجر يا مي والبعد",46,"د",1,1],["ِإلَى حَضَرَاتِ عَبداللهِ مني","سَلاَماً رَقَّ شِنشِنَةً ورَاقَا",47,"ق",2,0],["إلى حيث لا تُجزَى بحسن صنيعها","إذا ما قضَوا نُسكا جزَوها به نَحرا",48,"ر",2,0],["إلى حَضْرَةٍ تَنْدَى بِنَشْرِ ثَنائِهِ","كأنَّ نثيرَ المسكِ فيها يُبَدَّد",49,"د",1,0],["إلى حسنك الوهاج أرسل زفرةً","معطّرة الأنفاس بالصبر تأمر",50,"ر",1,0],["إِلَى حَيْثُ نَوَاهُ الْمُنَى مُتَأَرِّجٌ","وَحَيْثُ النَّدَى ثَاوٍ وَحَيْثُ أَبُو يَعْزَى",51,"ز",2,0],["إِلَى حَيْثُ مُاءُ الْمَكْرُمَاتِ مُسَلْسَلٌ","وَنَهْرُ النَّدَى فِي جَرْيَةٍ وَتَصَيُّعِ",52,"ع",1,0],["إلى حضرة المولى الذي نوى وجهه","غنينا به عن مطلع البدر مطلعا",53,"ع",2,0],["إِلى حرض الى خلب تراث","الى جازان جازَت وهيَ هيم",54,"م",1,0],["إلَى حِلْمٍ تَقَاصَرَ عَنه قَيسٌ","وعلم ضلَّ مدركَه الخَليلُ",55,"ل",1,0],["إِلى حَيْثُ تَلْقى الْجُودَ هَيْناً مَرامُهُ","لِباغِيهِ وَالْحاجاتِ سَهْلاً عَسِيرُها",56,"ر",3,0],["أُليحُ إِذا البَرقُ الحِجازِيُّ لاحَ لي","عَلى القَلبِ مِن وَجدٍ عَلَيهِ يَصولُ",57,"ل",1,0],["إِلى حِميَرٍ إِذ وَجَّهوا مِن بِلادِهِم","تَضيقُ لَهُم لَأياً فُروجُ المَخارِمِ",58,"م",1,0],["إِلى حين هبَّت نسمةُ الفجر واِنبرَت"