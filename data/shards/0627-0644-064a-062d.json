 الصفرا","https://www.aldiwan.net/poem58435.html","الطويل"],[198,"مصابك ما كر الجديدان سرمد","https://www.aldiwan.net/poem51953.html","الطويل"],[211,"خطاب كزهر الروض بل هو أنضر","https://www.aldiwan.net/poem46594.html","الطويل"],[237,"بحار الندى تعزى إليكم أبا يعزى","https://www.aldiwan.net/poem18834.html","الطويل"],[237,"قفا حدثاني عن مغان وأربع","https://www.aldiwan.net/poem19486.html","الطويل"],[261,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[271,"أفي نيابتي برع تقيم","https://www.aldiwan.net/poem52116.html","الوافر"],[275,"ونت من دون غايتك العقول","https://www.aldiwan.net/poem25542.html","الوافر"],[280,"إذا عز نفسي عن هواك قصورها","https://www.aldiwan.net/poem60737.html","الطويل"],[282,"ألا هل إلى الخل الوصول وصول","https://www.aldiwan.net/poem32645.html","الطويل"],[287,"لقد نظرت عنز إلى الجزع نظرة","https://www.aldiwan.net/poem1906.html","الطويل"],[297,"بكيت لبرق لاح بالثغر باسمه","https://www.aldiwan.net/poem33167.html","الطويل"],[304,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[305,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[416,"ألا أيها النحرير والعالم الذي","https://www.aldiwan.net/poem53856.html","الطويل"],[416,"أقول لها يوم جدت بنا","https://www.aldiwan.net/poem53955.html","المتقارب"],[416,"دعاه إلى الهوى داعي التصابي","https://www.aldiwan.net/poem54151.html","الوافر"],[432,"ثنت عنك يوم الرحيل العنانا","https://www.aldiwan.net/poem12741.html","المتقارب"],[458,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[458,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[458,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[458,"أمرتكم أمري بنعمان ناصحا","https://www.aldiwan.net/poem56253.html","الطويل"],[461,"طوت ما طوت في سهل أرض ووعرها","https://www.aldiwan.net/poem15314.html","الطويل"],[477,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[477,"كفاك على وجدي دليلا مدامعي","https://www.aldiwan.net/poem15237.html","الطويل"],[477,"تذكر أيام الصبا فتألما","https://www.aldiwan.net/poem15241.html","الطويل"],[490,"ألا علِّلاني واعلما أنني غرر","https://www.aldiwan.net/poem654.html",""],[495,"لئن أحرزك الداعي","https://www.aldiwan.net/poem10238.html","الهزج"],[524,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[551,"أمن أجل من سارت بهن الأباعر","https://www.aldiwan.net/poem47825.html","الطويل"],[558,"لقد نظرت قوم بطرف لهم قذي","https://www.aldiwan.net/poem33813.html","الطويل"],[563,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[563,"سقى دمن الحي الحيا المتفائض","https://www.aldiwan.net/poem13605.html","الطويل"],[575,"سرى طيفه لا بل سرى بي سرابه","https://www.aldiwan.net/poem3103.html","الطويل"]],"verses":[["أُليحُ مِنهُ رُوَيداً أَو عَلى عَجَلٍ","لَو كانَ يَنفَعُ إِروادي وَإِعجالي",0,"ي",1,0],["إِلى حَيثُ تومي إِلَيكَ البَنانُ","وَتُصبِحُ ثَمَّ الأَعَزُّ المُجَلّا",1,"ل",2,0],["إِلى حَسَبٍ مِنهُ عَلى البَدرِ عِمَّةٌ","وَفي عاتِقِ الجَوزاءِ مِنهُ نِجادُ",2,"د",1,0],["إِلى حَيِّ مَن كانَ الإِمامُ عَدُوَّهُ","وَصَبَّحَهُ مِن أَمرِهِ بِقَضاءِ",3,"ا",2,0],["إِلى حَبيبٍ كَنَيتُ عَنهُ","أَجَلَّ ذِكرَ اِسمِهِ لِساني",4,"ي",1,0],["إلى حبْرِ السّياسَةِ لا يُجارَى","ولا يَبْغِي مُعارِضُهُ اللِّحاقَا",5,"ق",2,0],["إِلى حامِلِ الثِقلِ عَن أَهلِهِ","إِذا الدَهرُ ساقَ الهَناتِ الكِبارا",6,"ر",2,0],["إِلَى حِلاَها الغَوالِي","بِهِ أَضَافَتْ حُلِيَّا",7,"ي",2,0],["إِلَى حَيَاءٍ إِلَى جُودٍ بِصَنْعَتِهِ","وَبِالمُبَرَّاتِ لا يَفْسِدْنَ بِالمَنَنِ",8,"ن",1,0],["إلى حرمِ الأمن المنيع جواره","إذا ظلت الأصوات بالروعِ تجأر",9,"ر",1,0],["إلى حلبٍ رمت السرى بعد بُعدكم","فعارضني أيضاً زمان بعائق",10,"ق",1,1],["إلى حياً جاء إلى رائدٍ","فالآن تروى غلة الهيم",11,"م",1,0],["إلى حمى علمه وأنعمه","لكلِّ سامي الطلاّب مستامه",12,"م",2,0],["إلى حاجبيها صارَ قلبي صبابة","وقلبيَ منها قاب قوسين أو أدنى",13,"ن",2,0],["إِلى حَتفي سَعى قَدَمي","أَرى قَدَمي أَراقَ دَمي",14,"ي",1,1],["إِلى حَيثُ أَلقَت يا زَمانَ المَظالِمِ","وَلا عُدتَ يا عَهدَ الشَقا المُتَقادِمِ",15,"م",1,1],["إِلى حَكَمٍ تَناجَلَ مَنسِماها","حَصى المَعزاءُ مِن كَنَفَي حَقيلِ",16,"ل",1,1],["إلى حيثُ تَجْني كفُّهُ بَذْرَ أَمْسِهِ","ومُزْدَرعُ الأَوجاعَ لا بدَّ يَنْدَمُ",17,"م",1,0],["إِلى حَيثُ آباءُ الفَتى يَذهَبُ الفَتى","سَبيلٌ يَدينُ العالَمونَ بِها قِدما",18,"م",2,0],["إِلى حُسَينٍ حاكِمِ القَنالِ","مِثالِ حُسنِ الخُلقِ في الرِجالِ",19,"ل",1,1],["أُليحُ مِنَ الغَواني أَن تَرى لي","ذَوائِبَ لائِحاً فيها القَتيرُ",20,"ر",1,0],["إِلى حَيثُ مَدَّ المُلكُ أَطنابَ بَيتِهِ","عَلى اِبنِ أَبي الأَعياصِ في المَنزِلِ الرَحبِ",21,"ب",1,0],["إِلى حَيثُ تَلقاني تَميمٌ إِذا بَدَت","وَزُدتُ عَلى قَومٍ عُداةٍ لِتُنصَرا",22,"ر",2,0],["إِلى حُجُرِ الأَضيافِ كُلَّ عَشِيَّةٍ","بِذي حَلَقٍ تَمشي بِهِ تَتَدَعدَعُ",23,"ع",1,0],["إِلى حُجرَةٍ كَم مِن خِباءٍ وَقُبَّةٍ","إِلَيها وَهُلّاكٍ كَثيرٌ عِيالُها",24,"ل",3,0],["إِلى حَيثُ صارَت مِن لُؤَيِّ اِبنِ غالِبٍ","إِلى بَيتِهِ أَحسابُها وَظِلالُها",25,"ل",3,0],["إِلى حُفرَةٍ أُهدى إِلَيها مُقيمَةٍ","يَحُثُّ إِلَيها سائِقٌ مِن وَرائِيا",26,"ي",2,0],["إِلى حائِطِ الثَغرِ الَّذي يورِدُ القَنا","مِنَ الثُغرَةِ الرَيّا القَليبَ المُهَدَّما",27,"م",2,0],["إِلى حَيثُ يُلفى الجودُ سَهلاً مَنالُهُ","وَخَيرَ اِمرِئٍ شُدَّت إِلَيهِ وَحَطَّتِ",28,"ت",1,0],["إلى حِسْمَى فما للداءِ حَسْمٌ","إذا لم تَرْقِهِ بدمٍ مُراقِ",29,"ق",1,0],["إِلى حاناتِ خَمرٍ في كُرومٍ","مُعَرَّشَةٍ مُعَرَّجَةِ النَواحي",30,"ح",2,0],["إلى حيث يَلقى الحر للحق ذادة","كراماً فلا ضيم هناك ولا حقد",31,"د",1,0],["إلى حيث لا يرجى مآب لراحل","إليه وَهَل من مورد الموت مصدر",32,"ر",1,0],["إلى حيث لا شمس النهار مطلة","وَلا اللَيل نظّارٌ بأعينه النجل",33,"ل",1,0],["إلى حيث ينمو الرأيُ حُراً تذيعه","من الحقِّ فيها ألسنٌ وصحائفُ",34,"ف",1,0],["إلى حارمٍ قاد العتاق سواهماً","لها من نشاطٍ بالكماة زمال",35,"ل",1,0],["إلىَ حَيثُ يُنْجَى مِن مَخَالِبِ حَتْفِهِ","غَرِيقٌ وَيُوقَى الظَّالمِينَ غَرِيبُ",36,"ب",1,0],["إِلَّي حَبِيبٌ قُوْمُها وَهَوَاؤُهَا","وَمَا ثَمَّ مِنْ حَيٍّ وَمَاءٍ وجَلْمَد",37,"د",1,0],["إلى حُفرةٍ غبراءَ يُكْرهُ ورِدُها","سِوى أنها مثوى وضيعٍ وسِّيدِ",38,"د",1,0],["إلى حَمَدٍ ترنو المعالي مُدِلَّةً","وتُلْقي بأسباب النُّهى والفضائل",39,"ل",1,0],["إلى حَيْثُ صَارَتْ من لُؤيّ بنِ غالبٍ","إلى بَيْتِهِ أحْسَابُهَا وَظِلالُها",40,"ل",3,0],["إِلَى حَيْثُ يُرْوِي النِّيلُ بَاسِقَةَ النَّحْلِ","فَلاَخِيَّةٌ مَا درَّهَا ثَدْيُ أُمهَا",41,"ه",2,0],["إِلى حَيْثُ يَخْشَى نَاسِكٌ زَلَّةَ الرِّجْلِ","فَمَرَّ بِهَا فِي حَانَةٍ نَفَرٌ أُولُو",41,"و",1,0],["إلى حيث ألقت يا يا زمان المظالم","ولا عدت يا عهد الشّقا المتقادم",42,"م",1,1],["إِلى حِماك وَفدنا حامِلين عَلى","ظُهورِنا وَقر آثام عَلى كبر",43,"ر",1,0],["إِلى حِماكُم عَلى خَيل المُنا جِينا","وَذكركهم في دَياجينا مُناجينا",44,"ن",2,1],["الى حلب الشهباء ثار بنا الوجد","وطال علينا الهجر يا مي والبعد",45,"د",1,1],["ِإلَى حَضَرَاتِ عَبداللهِ مني","سَلاَماً رَقَّ شِنشِنَةً ورَاقَا",46,"ق",2,0],["إلى حيث لا تُجزَى بحسن صنيعها","إذا ما قضَوا نُسكا جزَوها به نَحرا",47,"ر",2,0],["إلى حَضْرَةٍ تَنْدَى بِنَشْرِ ثَنائِهِ","كأنَّ نثيرَ المسكِ فيها يُبَدَّد",48,"د",1,0],["إلى حسنك الوهاج أرسل زفرةً","معطّرة الأنفاس بالصبر تأمر",49,"ر",1,0],["إِلَى حَيْثُ نَوَاهُ الْمُنَى مُتَأَرِّجٌ","وَحَيْثُ النَّدَى ثَاوٍ وَحَيْثُ أَبُو يَعْزَى",50,"ز",2,0],["إِلَى حَيْثُ مُاءُ الْمَكْرُمَاتِ مُسَلْسَلٌ","وَنَهْرُ النَّدَى فِي جَرْيَةٍ وَتَصَيُّعِ",51,"ع",1,0],["إلى حضرة المولى الذي نوى وجهه","غنينا به عن مطلع البدر مطلعا",52,"ع",2,0],["إِلى حرض الى خلب تراث","الى جازان جازَت وهيَ هيم",53,"م",1,0],["إلَى حِلْمٍ تَقَاصَرَ عَنه قَيسٌ","وعلم ضلَّ مدركَه الخَليلُ",54,"ل",1,0],["إِلى حَيْثُ تَلْقى الْجُودَ هَيْناً مَرامُهُ","لِباغِيهِ وَالْحاجاتِ سَهْلاً عَسِيرُها",55,"ر",3,0],["أُليحُ إِذا البَرقُ الحِجازِيُّ لاحَ لي","عَلى القَلبِ مِن وَجدٍ عَلَيهِ يَصولُ",56,"ل",1,0],["إِلى حِميَرٍ إِذ وَجَّهوا مِن بِلادِهِم","تَضيقُ لَهُم لَأياً فُروجُ المَخارِمِ",57,"م",1,0],["إِلى حين هبَّت نسمةُ الفجر واِنبرَت","تجرُّ ذيولاً في الرياض نسائمُه",58,"م",2,0],["إلى حجرة الهادي البشير وقبره","وثم تقر العين من كل زائر",59,"ر",1,0],["إِلى حضرة لو أنّ سحبانَ وائلٍ","تيمّمها صمّت شقاشقه رعبا",60,"ب",2,0],["إلى حضرة السلطان دام بقاؤه","وأيّده ربّ السَّماء بتأييد",61,"د",1,0],["إلى حيث تهوى نفوس الكرام","وتبلُغٍ بالعِزّ تسآلَها",62,"ل",3,0],["إلى حضراته الأمداح تجبى","ومن ثم انتَمى فيها لجابي",63,"ب",2,0],["الى حافظِ الدينِ والمُرتجى","لدفعِ المُلمِّ إذا ما اعترانا",64,"ن",2,0],["إلى حيث لا يجِدُ الناسبون","وراءَ المجرّة من مَرفعِ",65,"ع",1,0],["إلى حاجة من جانب الرمل سُخِّرت","لها الشمسُ حتى ما اهتدت لطلوعِ",66,"ع",1,0],["إلى حاجةٍ في العلا همَّتي","إليها تطول وحظّي قصيرُ",67,"ر",1,0],["إلى حاجةٍ في طُرْقها الجِدُّ كلُّه","فأدركتُها جذلانَ أُحسَبُ مازحا",68,"ح",2,0],["إِلى حرمٍ جمِّ المناقب لم يزلْ","مدى الدهر مشحوناً بحزمٍ ونائلِ",69,"ل",1,0],["الى حيَّ كتمتُ هواىَ فيه","اِذا الاهْواءُ دنسَّهَا العِلانُ",70,"ن",1,0],["الى حيث كانوا مِن بلادٍ بعيدةٍ","بأيدٍ لها نحوَ الخليطِ نوازعِ",71,"ع",1,0],["الى حيثُ كانوا في البلادِ فاِنَّني","أرى العيشَ إلا بالتواصلِ مَغْرَما",72,"م",2,0],["إِلى حُفرَةٍ يَأوي إِلَيها بِسَعيِهِ","فَذَلِكَ بَيتُ الحَقِّ لا الصوفُ وَالشَعَر",73,"ر",1,0],["إلى حين نسيناك","فغمضنا لتهجاع",74,"ع",1,0],["اليَحمَدِي وَأَبو تَمّام كلّ شَج","عانى الغَرام إِلى قَلبي لِأَجلِهِمِ",75,"م",1,0],["إِلى حَيثُ حَلّ المجدُ جمّاً عديدُه","وحيث يكون السُّؤدُدُ المتكاثرُ",76,"ر",1,0],["إلى حضرات الحق كان ارتفاعُنا","ومنا لقد مدت إلى الغيب باعُنا",77,"ا",1,0],["إِلى حَضرَةٍ سُنِّيَّةٍ حَسَنِيَّةٍ","مُنيرَةِ آلاءِ الهُدى المُتَصَعِّدِ",78,"د",1,0],["إِلى حَيثُ صَيرُ الشَرعِ لا نَهجَ ظاهِرٌ","وَلا باطِلٌ مِن حُكمِهِ مُتَناقِضُ",79,"ض",1,0],["إِلى حَوْزَةِ العَافين تَهوِي هِبَاتُه","وَفي قِمَّةِ الجَوْزَاءِ تَعْلُو قِبَابُه",80,"ب",2,0]]}