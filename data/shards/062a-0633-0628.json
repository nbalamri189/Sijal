id=145919",""],[5111,"النورُ المقدسُ","https://www.poetsgate.com/ViewPoem.aspx?id=212081",""],[5122,"وين أنت يالمعتصم","https://www.poetsgate.com/ViewPoem.aspx?id=24262",""],[5135,"وجاء الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=201954",""],[5246,"في الإسبال","https://www.poetsgate.com/ViewPoem.aspx?id=187033",""],[5302,"خوفي بأن تنأى","https://www.poetsgate.com/ViewPoem.aspx?id=204917",""],[5343,"صدى البردة","https://www.poetsgate.com/ViewPoem.aspx?id=132671",""],[5376,"قولوا لها .....يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=188269",""],[5376,"في غوطةِ الشامِ أحزانٌ وآلامُ","https://www.poetsgate.com/ViewPoem.aspx?id=192672",""],[5431,"في يوم مولد سيدي محمد (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=200935",""],[5490,"أقرئهُ عنّي الجوى","https://www.poetsgate.com/ViewPoem.aspx?id=176415",""],[5573,"ياحاتم","https://www.poetsgate.com/ViewPoem.aspx?id=200215",""],[5582,"نَفْسُ المُتَيَّمِ دِينُ الحُبِّ مَذْهَبُها","https://www.poetsgate.com/ViewPoem.aspx?id=186667",""],[5582,"قِفْ بِالدِّيارِ مُخاطِباً وَاسْتَخْبِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=63518",""],[5582,"لِمَن الهَوادِجُ وَالقبب","https://www.poetsgate.com/ViewPoem.aspx?id=63458",""],[5691,"جيل الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=205892",""],[5700,"إلى الطفلة السورية زهرة","https://www.poetsgate.com/ViewPoem.aspx?id=138054",""],[5809,"خود","https://www.poetsgate.com/ViewPoem.aspx?id=205632",""],[5943,"جنَّةُ النارِ","https://www.poetsgate.com/ViewPoem.aspx?id=41590",""],[5943,"يااسودَ الوجهِ ياقذاف ويلاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=61861",""],[5943,"تشطير لقصيدة نجاة الظاهري","https://www.poetsgate.com/ViewPoem.aspx?id=138286",""],[5956,"بسمة ذات إعجاب بموهبتي","https://www.poetsgate.com/ViewPoem.aspx?id=182292",""],[5956,"رحلةٌ نفسية","https://www.poetsgate.com/ViewPoem.aspx?id=183278",""],[5956,"تسبح النحلة","https://www.poetsgate.com/ViewPoem.aspx?id=183469",""],[6056,"الشعر أكذبه  أعذبه","https://www.poetsgate.com/ViewPoem.aspx?id=130138",""],[6247,"غريبٌ أنا أم زماني غريبُ؟!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80262&r=&rc=1",""]],"verses":[["تُسبى بَناتُ رَسولِ اللَهِ بَينَهُمُ","وَالدينُ غَضُّ المَبادي غَيرُ مَستورِ",0,"ر",1,0],["تَسبي الأُسودَ بنُجْلٍ","كالباتراتِ الحدادِ",1,"د",1,0],["تَسبي الغَوانيَ ما تَنفَكُّ غانيَةٌ","تَعطو إِلَيها بِضافٍ لَيِّنِ الجيدِ",2,"د",1,0],["تسبع دونهن لكل وحي","تعرض من أزلَّ لها نسول",3,"ل",1,0],["تسبق الفجر بالغدو عليها","ثم لا تستفيق إلا غُسوقا",4,"ق",2,0],["تسبك المعنى البكر في خير لفظ","فبه يحلولي وخير سياق",5,"ق",1,0],["تسبني حسدا والحلم من شيمي","فلا أسبك لكن سبك الله",6,"ه",1,0],["تَسبي العُقولَ فَصاحَةً وَصَباحَةً","فَتَحارُ بَينَ طَريفِها وَتَليدِها",7,"د",3,0],["تُسَبِّحُهُ الطَيرُ الجَوانِحُ في الخَفى","وإِذ هِيَ في جَوِّ السَماءِ تُصَعِّدُ",8,"د",1,0],["تَسبِقُ الطَيرَ في السَماءِ إِذا ما اِس","تَعجَلوها بِجيأَةٍ وَذِهابِ",9,"ب",1,0],["تَسبي القُلوبَ بِمُقلَةٍ","أَلحاظُها فيها شُهودُ",10,"د",1,0],["تسبّي سبَّ ما شئت","سامع غير منكر",11,"ر",1,0],["تَسبِقُ مَن جاراكَ قَبلَ الشَدِّ","بِالحِلمِ وَالجودِ وَضَربِ الكَردِ",12,"د",1,0],["تُسبى الكَرائِمُ وَالكُمَيتُ شَرابُها","يُلفى لِأَلأَمِ شارِبٍ مَسبوءا",13,"و",3,0],["تَسْبِي القُلُوبَ فَمِنْ زُوَّارِهَا دَنِفٌ","يَعْتَدُّ آخِر دُنْيَاهُ ومَقْتُولُ",14,"ل",1,0],["تَسْبِي مَحَاسِنُهَا الْقُلُوبِ وَتَنْثَنِي","عَنْهَا عُيُونُ النَّاظِرِينَ كَلاَلاَ",15,"ل",2,0],["تَسْبِقُ السَّهْمَ عينُهُ فَتَرَاهُ","يَتَلَوَّى تَلوِّيَ الخَيْزُرانَه",16,"ن",2,0],["تسبقُ الفجرَ بالغدوِّ عيها","ثم لاتستفيقُ إلا غُسوقا",17,"ق",2,0],["تَسبي خُدود الغَيد مَفقود الحجى","بِدَم يَجول وَإِسمَهُ تَوريدُ",18,"د",1,0],["تَسب صَحابة المُختار حيناً","وَحيناً تَدَعي حُبّاً لِآل",19,"ل",1,0],["تَسبي الحليمَ إذَا غَنَّت أو ابتسمت","وليس ينفع فِيما قُدِّرُ الحَذَرُ",20,"ر",1,0],["تُسبى ذراري المُصطَفى مُحمَّدٍ","رِضاً لِشانيهِ الزَنيمِ الدُكَّعِ",21,"ع",1,0],["تَسْبَح في باطِنيةٍ من عنبر","والأُفْق قد غرَّب فيه المشترِي",22,"ر",2,0],["تسبَحُ في الآل إذا لم تُسْئِد","والآلُ في رَقْراقِهِ الممدَّد",23,"د",1,0],["تَسْبِق أقصَى لحظِه خُطاه","لا يَطَأُ التُّرْبَ ولا تَلْقاه",24,"ا",2,0],["تسبى النُّهى بنواظرٍ فتانةٍ","تدعُ المتيمَ فاقدَ الإحساسِ",25,"س",1,0],["تسبح في جانب مفساتها","عين خرا بالعرض خراره",26,"ر",2,0],["تسبح ذرّات الوجود بحمده","وَيسجد بالتَعظيم نجم وَأَشجار",27,"ر",1,0],["تُسبى بَناتُ رَسولِ اللَه حاسِرةً","كأَنَّهُنَّ سبايا قوم سابورِ",28,"ر",1,0],["تسبح كل الكائنات بحمده","وتسجد إعظا ما له عن تصاغر",29,"ر",1,0],["تسبي القلوب بحسنها وجمالها","بتعطف وتلطف وتمنع",30,"ع",1,0],["تَسبي القُلوبُ بِوَجهٍ لا كِفاءَ لَهُ","كَالبَدرِ تَمَّ جَمالاً حينَ يَنتَصِفُ",31,"ف",1,0],["تَسْبي شَمائلُك الرِّقاقُ عقولَنا","ومنَ الشّمائلِ ما يُخالُ شَمولا",32,"ل",2,0],["تُسبي بناتُ محمدٍ حَتّى كَأَن","نَ محمداً وافى بملَّةِ هرقلِ",33,"ل",1,0],["تسبيحها يجعل الليل البهيم ضحى","تضيئه بجميل القول والعمل",34,"ل",1,0],["تَسبقُ الأقوالَ أفعالٌ له","وإذا قال بشيء فعلا",35,"ل",2,0],["تسبّب بالإِحسان للحمد والثنا","ومن يتسبَّب للمحامد يُحْمَدِ",36,"د",1,0],["تسبّب في حفر أنهارها","ومنع خبائث جيرانها",37,"ن",3,0],["تسبي الألباب إذا خطرت","وإذا نطقت تسبي الهما",38,"م",2,0],["تسبب الخلف في تضيع أندلس","وما اتعظنا فضيعنا فلسطينا",39,"ن",2,0],["تَسبِي العطايا لك كلَّ حُرّةٍ","لولا نداك لم تكن لتُعتَبَدْ",40,"د",1,0],["تَسبِقُ نهْضاتُهُم عزائمَهُمْ","أن تُستشارَ العاداتُ والعُقُب",41,"ب",1,0],["تسبي ثناء الخلق خيل سماحه","وتطاعن الآمال بالأموال",42,"ل",1,0],["تسبيحتي في خلوتي","سلمى بعيشك واصلي",43,"ل",2,0],["تسبي العقول لحاظه فإذا رنا","خرت له أولو الهوى إجلالا",44,"ل",2,0],["تسبي بأدوارها في الرقص أفئدة","وبلبل الشجو في عيدانه سجعا",45,"ع",2,0],["تُسَبِّحُ من أَهَدى النُفوسَ إلى المُنى","وقَدَّر أشْكَالَ الأمورِ وحَلَّها",46,"ه",2,1],["تسبيك حمرة جمرة في خده","أبداً وحمرة خمرة في فيه",47,"ي",2,0],["تَسْبيك قامتُه إن قام يمزجها","موشَّحاً بصليبٍ صيغَ من ذَهَبِ",48,"ب",1,0],["تسبي العقول بلفظها من حسنه","حتى تزول بطيبه أحلامها",49,"م",3,0],["تسبق خفاق الهوى","إذا بها الحادي صخب",50,"ب",1,0],["تسبي قلوباً خاليات من هوى","لم تدر انّ بها الكواعب يسحر",51,"ر",1,0],["تسبق الفجرَ للصوامح نُسكاً","وعن الصوم ليس تلوي الأَعنَّه",52,"ن",2,0],["تسبحُ أشجانُ القلوب برحبها","إذا ما غدت فوق الغصون تغرد",53,"د",1,0],["تسبيك بديباج خده شعرات","قد نمنمها السحر والجمال لها حاك",54,"ك",1,0],["تُسَبِّحُ وَالْمَاءُ الزُّلاَلُ بِهَا جَرى","شَرِيفٌ عَفِيفٌ كَمْ تَعَبَّدَ فِي حِرَا",55,"ر",2,0],["تَسِبرُ وَنِيرَانُ الأَسى بَيْنَ أَضْلُعِي","أُسَائِلُ عَنْهُمْ كُلَّ نَادٍ وَمَرْبَعِ",56,"ع",1,0],["ِتسبل عند المشيء جعدا على","مثل الكثيب المائر الجعدِ",57,"د",1,0],["تُسبى الحجا بمسوّر وموشّحٍ","وَمخلخلٍ ريّان كالأنبوبِ",58,"ب",1,0],["تسبي الحِجا بمخلخلٍ وموشّحٍ","وَمقلّدٍ ومفتّحٍ ومسوّرِ",59,"ر",1,0],["تسبح الطير بألطافه","وتحمد الماء على النضر",60,"ر",1,0],["تسبيغ أو تذييل أو ترفيل","زائد ضرب وزنه مقبول",61,"ل",1,0],["تسبيغهم زد ألفا ما بين تن","فيث رمل وفي سواه لم يكن",61,"ن",1,0],["تسبب فعل الصالحات تكرمَا","وتجزي عليها صالحات المثوية",62,"ه",1,0],["تَسبي المُنيبَ بِأَنيابٍ لَها شَنَبٌ","يُشفي بِها لسعُها إِن لَم يَكُن بَدَلا",63,"ل",2,0],["تسب وتسلب الأبيات منها","فيوجع قلبها سبٌ وسلب",64,"ب",1,0],["تسبى فؤاد الحليم المرعوى بدجى","ليل ووجه كضوء الصبح وهاج",65,"ج",1,0],["تسبي ببهجتها عيوناً لم تزل","تسبي قلوباً في الهوى وعيونا",66,"ن",2,0],["تُسبى مواهبُه بها","ويُسرُّ إذ يؤخذْنَ عنوه",67,"و",2,0],["تُسبى حرائرها بالطفّ حاسرةً","ولم تكن بغُبار الموت تلتثمُ",68,"م",1,0],["تسبى القلوب بكل كعب أدمج","وبمعصم وبساعد ريان",69,"ن",1,0],["تسبي النهى وترف لط","فاً تستهيم به السرائر",70,"ر",1,0],["تسبى فقل في الزنج تملك أمرها","أيدي الجفاة والسن الاشرار",71,"ر",1,0],["تسبى وتقرع بالرماح إذا بكت","وشكت فتنتاب الزفير تحسرا",72,"ر",2,0],["تَسْبُّ بني الزهرا في غير عِلّة","لسبهم هذا الضَلاَلُ المكمّل",73,"ل",1,0],["تُسْبلُ الشعْرَ فوقَ نور من الوجهِ","فتجلو الصباحَ تحتَ السماء",74,"ا",2,0],["تَسبل فَوقَ رَدفِها ذوائِباً","يَذوب قَلب الصَب مِن تَقليبها",75,"ب",3,0],["تُسبي الرِّجالَ بِذي غُروبٍ بارِدٍ","عَذبٍ إِذا شرعَ الضَّجيعُ زُلالِ",76,"ل",1,0],["تسبي عقول بني الزمان","بسحر عين بابليه",77,"ي",2,0],["تسبق الشهب ان جريت مع الشهب","الى غاية بكل مجال",78,"ل",1,0],["تسبا الممثلة ارعوت من حالها","والرجس