{"poems":[[55,"قف موقف الشك لا يأس ولا طمع","https://www.aldiwan.net/poem30134.html","البسيط"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[47,"يا ابن من طاب في المواليد حرا","https://www.aldiwan.net/poem66862.html","الخفيف"],[107,"اشهدي يا مصر أعمال البنين","https://www.aldiwan.net/poem43070.html","الرمل"],[41,"إن تختلف مضر تتبع عدوهم","https://www.aldiwan.net/poem53772.html","البسيط"],[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[52,"قل لفرخ الزنجي لا تشك ليثا","https://www.aldiwan.net/poem64736.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[111,"ليس في الحب قياس","https://www.poetsgate.com/ViewPoem.aspx?id=612",""],[92,"العلم والوطنية","https://www.poetsgate.com/ViewPoem.aspx?id=178949",""],[101,"ترصيع بالذهب على سيف دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=587",""],[113,"منعتك رقة كاشح","https://www.aldiwan.net/poem16472.html","مجزوء الكامل"],[119,"قل لشيخ يؤذي النبي عناداً","https://www.aldiwan.net/poem40846.html","عموديه"],[128,"وادته بعد تجاذب وتدافع","https://www.aldiwan.net/poem23745.html","الكامل"],[177,"أيها العالم ادركني سماحاً","https://www.aldiwan.net/poem4405.html","عموديه"],[193,"يا نبيا لدى الإله عظيما","https://www.aldiwan.net/poem35102.html","الخفيف"],[240,"لا أوحش الله ممن","https://www.aldiwan.net/poem31995.html","المجتث"],[275,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[280,"عندي نزاع ليس عنه نزوع","https://www.aldiwan.net/poem25487.html","الكامل"],[285,"يا موقد النار الذي لم يأل في","https://www.aldiwan.net/poem60754.html","الكامل"],[295,"حسب قلبي من الحزن","https://www.aldiwan.net/poem11681.html","مجزوء الخفيف"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[310,"خطب له الدين أرنى لحظ مذعور","https://www.aldiwan.net/poem56539.html","البسيط"],[376,"إن تخطاني زماني","https://www.aldiwan.net/poem57086.html","مجزوء الرمل"],[435,"سل سبيلا لتسقي سلسبيلا","https://www.aldiwan.net/poem39889.html","الخفيف"],[457,"إنتخب للندام كل حديث","https://www.aldiwan.net/poem13698.html","الخفيف"],[463,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[469,"يا لقبي من نغمة الأوتار","https://www.aldiwan.net/poem3182.html","عموديه"],[534,"الجواب الحق في هذا بلا","https://www.aldiwan.net/poem37268.html","الرمل"],[572,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122790","الكامل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103095","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86921","الرمل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124041","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48856","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70979","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70956","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70928","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70808","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120048","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72265","الخفيف"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44935","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56644","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56640","السريع"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64642","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124718","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77356","المديد"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104983","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93540","الكامل"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100435","السريع"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137190",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87343","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2706,"","https://poetry.dctabudhabi.ae/diwan/poem/205633","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104677","الرمل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107063","الخفيف"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70400","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121576","الخفيف"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36068","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205608","الخفيف"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132132","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29301","الرمل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32435","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77021","السريع"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105568","الخفيف"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35047","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73164","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73115","الخفيف"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117232","الكامل"],[4691,"شبيهة الأمطار يا سارا","https://www.poetsgate.com/ViewPoem.aspx?id=153501",""],[182,"من لي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=72826",""],[5121,"دولة الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=33514",""],[5216,"ابكِ يوما","https://www.poetsgate.com/ViewPoem.aspx?id=187650",""],[5335,"اكحل عينها","https://www.poetsgate.com/ViewPoem.aspx?id=36041",""],[5455,"آخر دروبي","https://www.poetsgate.com/ViewPoem.aspx?id=213954",""],[5717,"وهل قرأت من كتاب النفس ما","https://www.poetsgate.com/ViewPoem.aspx?id=170602",""],[5718,"الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=213899",""],[5804,"الوردة والنار","https://www.poetsgate.com/ViewPoem.aspx?id=191787",""],[5818,"اعلمي","https://www.poetsgate.com/ViewPoem.aspx?id=182814",""],[5829,"التحدي","https://www.poetsgate.com/ViewPoem.aspx?id=162457",""],[5956,"الشعرُ وهْجُ الفكرِ والنبضاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=186207",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6056,"نايض البرق","https://www.poetsgate.com/ViewPoem.aspx?id=130383",""],[6082,"ربما كيف وليس","https://www.poetsgate.com/ViewPoem.aspx?id=58825",""],[6102,"سُحقًا لِقَلبكِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=184412",""],[572,"أيُّ حِرَاكٍ غالَ منكَ السكونْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9491&r=&rc=348",""]],"verses":[["إِن تَخبُ أَنوارُكُم مِن بَعدِ ما صَدَعَت","ثَوبَ الدُجى فَلَضَوءِ الشَمسِ مُنقَطَعُ",0,"ع",1,0],["أَنتَ خَيرٌ مِن أَلفِ أَلفٍ مِنَ القَو","مِ إِذا ما كَبَت وُجوهُ الرِجالِ",1,"ل",1,0],["أَن تَخَّجمَتُهُ وَإِن كانَ إِلّا","مِثلَ ما يَأنَسُ الفَتى بِأَخيهِ",2,"ي",2,0],["أَنتِ خُنتِ البِرَّ إِذ لَم تَعرِفي","مَوضِعَ الخائِنِ وَالبَرِّ الأَمينْ",3,"ن",1,0],["إِن تَختَلِف مُضَرٌ تَتبَع عَدُوَّهُمُ","أَو تَجتَمِع تَنفِكُم عَن أَرضِها مُضَرُ",4,"ر",1,1],["إنْ تخْبُ نارُ الحْرب فهو بفتكِهِ","مِيقادُهَا مِضرَامُها المِغْوار",5,"ر",1,0],["أَنتَ خُنثى تُناكُ وَاللَيثُ فَحلٌ","لَو تَراهُ خَريتَ ما قَد أَكَلتا",6,"ت",2,0],["إِنْ تَخْتَلِفْ طَبَقَاتهُمْ لمْ تخْتَلِفْ","فِيه شُجُونُ أَكَابِرِ وَأَصَاغِرِ",7,"ر",1,0],["أَنْتَ خِدْنُ الشَّبابِ بَيْنكما في الْوَهمِ","قُرْبَى وَشِيجةُ الأَنْسابِ",8,"ب",1,0],["أنت خلو وأنا صب شج","فاذا حدثت عني قل وزد",9,"د",1,0],["إن تخش سطوة ظالم فلقد ترى","والغرب منه لحكمك الاذعان",10,"ن",1,0],["إن تخلت كل المقادير عني","فبعيني حبيبتي أستعينُ",11,"ن",1,0],["أَن تَخش مِن نَظَر إِلى","شُمّ الهِلال تَكَرما",12,"م",2,0],["انت خضت الدجا بقفر بلا نو","ر فمزقت في ضروب الضلال",13,"ل",1,0],["ان تخدع الطماع لمعته فلن","تقوي على عبت بذقن القانع",14,"ع",1,0],["إن تَخَلني إذا نَطَفتُ عَيِبّاً","فَبَنانِي إذا كَتَبتُ وَقَاحُ",15,"ح",1,0],["أَنتَ خيرُ الوَرى على الإطلاقِ","سيّدُ الخلقِ صفوة الخلّاقِ",16,"ق",1,0],["إِن تَخلُ مِنكَ عِراصٌ","فيحٌ بِها وَقُصورُ",17,"ر",1,0],["إن تخطُ ترتجف البلادُ وإن تقل","تتنصتُ الدنيا لقولٍ يؤثر",18,"ر",1,0],["إنْ تَخْلُ مِنْهُ مَنَازِلٌ وَمَطَالِعٌ","لَمْ تَخْلُ مِنْهُ جَوَانِحٌ وضُلوعُ",19,"ع",1,0],["إِنْ تَخْبُ نارُكَ فَاقْتَبِسْ مِنْ مُهْجَتِي","أَوْ يَفْنَ وَرْدُكَ فَاقْتَطِفْ مِنْ خَدِّهِ",20,"د",2,0],["أنت خلّفت لي الهموم","وأخذت المنى معك",21,"ك",1,0],["إِن تخدَعي مُزيّدا","عَن دِرهَمٍ لا أَزيَدا",22,"د",2,0],["إِن تخلُ منكَ مقاماتٌ فَقد أرِجت","أَرجاؤُها بثناءٍ فيك معطورِ",23,"ر",1,0],["إن تَخَطَّاني زَماني","نافِذاً بالحَدَثانِ",24,"ن",1,1],["أنت خليّ فخل سربي وسربي","يا فؤادي إلى مقام الحبيبِ",25,"ب",1,0],["إِنتخبْ للنَدام كلَّ حديثٍ","من قِصار الفصول داني القطافِ",26,"ف",1,1],["إن تخلُ من وجهك الزوراء مكرَهةً","فإنّ صدَّك عنها صدُّ مختارِ",27,"ر",1,0],["إن تخالف في أنها الشمس فانظر","نورها إذ خبت على الأقمار",28,"ر",1,0],["إنّ تَخْريجَ مَقالٍ حادِثٍ","مِنْ مَقالٍ لإمامٍ أَوّلِ",29,"ل",1,0],["إِنْ تُخْلِفِ الآمَالُ فِي عُمْرِهِ","فَلَمْ تَكُنْ تُخْلِفُ فِيْهِ الظُّنُونْ",30,"ن",1,0],["إن تَختَبِر ساداتِ آلِ مُحَمَّدٍ","يَوماً تَجِد سُلطانَها سُلطانَها",31,"ن",3,1],["أنت خلق الخلق في تحقيقه","أنت سر العقل فياض الصور",32,"ر",1,0],["أَنتَ خَير الناس في مَصر الَّتي","بِكَ فيها كَوكب الملك اِستَنار",33,"ر",1,0],["ان تخترمك قنى أم اللهيم فكم","نفست معضلها المرهوب إن نزلا",34,"ل",2,0],["أنت خلصتها من البيع جبراً","فتملكتَ مالكيها جميعا",35,"ع",2,0],["إن تختبْره تلق ليْ","ثاً إن عنا أمر مفاج",36,"ج",1,0],["إن تختبرْهمْ وتنظرْ في فعالهمُ","تجدْ عجائب ما عاينت والعِبَرا",37,"ر",2,0],["إنْ تختبرْ أهلَ هذا الدهر تلقهمُ","بهائما عوَّفتْ أعناقَها الرِّيَقُ",38,"ق",1,0],["إنْ تختبْره ترَه في الورى","أحقَّ بالمغزل مِنْ عِرسه",39,"س",2,0],["أنت خولتني النفيس من الوف","ر ونفست منعما من خناقي",40,"ق",2,0],["إن تخصصكم نوائب ما زالت","لكم دون من سواكم تنوب",41,"ب",1,0],["إِن تَخَلفت بَعدَ ما تَصِل الرَق","عَة عَنّا فَأَنتَ في الأَمواتِ",42,"ت",1,0],["إن تخالفتما طباعاً وقصداً","فلكل شأن له يغنيه",43,"ي",2,0],["انت خيال نعم الخيال","حذار لا تدخل قلوب الرجال",44,"ل",1,0],["أنت خلو وأنا صب شجٍ","فإذا حدثت عني قل ورْد",45,"د",1,0],["أنت خلفت ثم آلهة القو","مِ جُذاذاً وهم لديك سواء",46,"ا",2,0],["أنت خصم الله إذ قال له","كتب الذنبَ وأصلاني سقر",47,"ر",1,0],["إِن تَخذناكَ لَنا وَطَنا","مَن يَعولُ القطنَ وَالقَصَبا",48,"ب",2,0],["إن تخل منك محاريب بك امتلأت","أنوار قدس وجنح الليل معتكر",49,"ر",1,0],["أَن تخلق الأَيام جدة عالم","مِن بَيتكم فَقَد اِرتَدَيت قَشيبا",50,"ب",2,0],["إن تختبر كل فتىً منهما","فخبره طباق مرآه",51,"ا",2,0],["انت خود في كل ناد رأينا","لك ذكراً يحلو وفضلا ونبلا",52,"ل",2,0],["إنتَخ عليهِ على دابولَ مُحتَكِماً","وبرِّ عالي فَتلقَاهُم نَفِيسَينِ",53,"ن",1,0],["إنتَخ مُلَبيُونِي وَمَا يَلِيهَا","وَلاَ هُنَاكَ مَركَبٌ يُعدِيهَا",54,"ه",2,0],["أنت خلّفتَ في الأنام ثناءً","تتغنّى بذكره الأقلام",55,"م",1,0],["أَنتَ خَيرُ الرسلِ طَرّاً","وَالأُولى دانوكَ غُرّاً",56,"ر",2,0],["أنت خير ممحض لو حوته","أمة الشرق أصبحت كسرويه",57,"ي",2,0],["أنت خدن العلا فلا ذاق يوماً","مر طعم الفراق منك خدينُكْ",58,"ك",1,0],["أن تخاشنه في تقاضيه يوما","صاربا لحلف دينه مقضبا",59,"ا",1,0],["إِن تَخُنّي رِشاءَ دَلوي فَقَد أَح","كَمتُ إِكرابَهُ بِعَقدٍ مُغارِ",60,"ر",1,0],["أنت خدن الكتاب، والموت سفر","صدقه ظاهر على عنوانِهْ",61,"ن",2,0],["إن تخترم أسد الشرى","فكذاك تصنع بالأسود",62,"د",1,0],["إِن تَخَذتَ اليَومَ غَيري في الهَوى","فَأَنا لِلآنَ لَم أَعشَق سِواك",63,"ك",1,0],["أَنتِ خُلوُ مِنَ الَّذي بي وَما يَع","لَمُ ما بي إِلّا القَريحُ الفُؤادِ",64,"د",1,0],["أَنتَ خَليقٌ بِالوَفا سَيِّدي","فَلَم جَزاءُ الوُدِّ مِنكَ الحَرب",65,"ب",1,0],["إن تخطيت عاملاً فأنحها","يتلألأ لك الجناب المنيع",66,"ع",1,0],["إِن تخطّئني فَهذا","أَو تسئ فَهمي فأعجب",67,"ب",1,0],["أنتَ خالٍ دوني بِقلبي فَسلهُ","هل تسلَّى أو رامً أَن يَتسلَّى",68,"ل",2,0],["أنتَ خالٍ ممَّا يُقاسيه قلبي","من غريرٍ له على الخدِّ خالُ",69,"ل",1,0],["إن تخذلوه فما له من ناصر","أو تبعدوه تسلموه للردى",70,"د",2,0],["إن تخطئي في الودِّ يا طفلتي","تلقي فؤادي لكِ غفّارا",71,"ر",2,0],["أنتخي فيك رجائي","يَتوارى بعضُ نحْسي",72,"س",2,0],["إن تخلّى عن جمال ٍ في وجوه ٍ","زاد نضْبًا في قلوب ٍ بالجويل ِ",73,"ل",1,0],["إنْ تخافُ اللهَ أضحَتْ","بالخشوعِ لها دواءُ",74,"ا",2,0],["ان تخاوينا على بيض الورق كفي زبونك","ذيك نلقاها على الحروه والاخرى نقتفيها",75,"ي",3,0],["أنت خلك بس في الدنيا عزايه","لا تفكر في العواذل وأنت صوبي",76,"ب",2,0],["إن تخف لطفا فهي في آثارها","أظهر من نار برأس العلم",77,"م",1,0],["إِنْ تَخَلَّ الصَّمْتُ عَنِّي","ذَاعَ شَدْوِي , في رُبَاهُ",78,"ا",2,0],["إنْ تخدعيهِ فسوفَ يُصبحُ بعدَها","مُستيأسًا من عالمٍ وأنامِ",79,"م",1,0],["أنتِ خلفَ البحارِ تبكينَ سِرًّا","كُلّما بدا وجهُهُ في القلادهْ",80,"د",2,0],["إن تخيرت التحدي","فأنا اهوى التحدي",81,"د",2,0],["إنْ تَخْبُ صحتُهم تمُتْ أشعارُهم","إلا احتضارٌ راجفُ النبراتِ",82,"ت",1,0],["إِنْ تُخْفِ وَجْهَ الغَدرِ كَاَنَ أنفُهُ","بينَ أُلُوفٍ منْ وُجُوهٍ بَادِيَا",83,"ي",2,0],["إنتخيت وفزع لي من حشام الطنايا","قالوا أبشربعزك لوهي روس ٍتطيح",84,"ح",1,0],["انتِ خمرٌ من كرومٍ","ما شربْتُ العشق كأسا",85,"س",2,0],["أَنْ تُخضِعِينِي لِقَيدِ العِشقِ فِي خَرَفٍ","أَنْ تُرغِمِينِي عَلَى تَصوِيرِهِ قَدَرا",86,"ر",2,0],["إنْ تخلفِ الآمالُ في عُمْرِهِ","فلا تَكنْ تُخْلِفُ فيهِ الظّنونْ",87,"ن",1,0]]}