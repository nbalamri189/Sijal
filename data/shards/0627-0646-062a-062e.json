{"poems":[[53,"قف موقف الشك لا يأس ولا طمع","https://www.aldiwan.net/poem30134.html","البسيط"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[45,"يا ابن من طاب في المواليد حرا","https://www.aldiwan.net/poem66862.html","الخفيف"],[105,"اشهدي يا مصر أعمال البنين","https://www.aldiwan.net/poem43070.html","الرمل"],[39,"إن تختلف مضر تتبع عدوهم","https://www.aldiwan.net/poem53772.html","البسيط"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[50,"قل لفرخ الزنجي لا تشك ليثا","https://www.aldiwan.net/poem64736.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[90,"العلم والوطنية","https://www.poetsgate.com/ViewPoem.aspx?id=178949",""],[99,"ترصيع بالذهب على سيف دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=587",""],[110,"منعتك رقة كاشح","https://www.aldiwan.net/poem16472.html","مجزوء الكامل"],[116,"قل لشيخ يؤذي النبي عناداً","https://www.aldiwan.net/poem40846.html","عموديه"],[125,"وادته بعد تجاذب وتدافع","https://www.aldiwan.net/poem23745.html","الكامل"],[174,"أيها العالم ادركني سماحاً","https://www.aldiwan.net/poem4405.html","عموديه"],[190,"يا نبيا لدى الإله عظيما","https://www.aldiwan.net/poem35102.html","الخفيف"],[236,"لا أوحش الله ممن","https://www.aldiwan.net/poem31995.html","المجتث"],[271,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[276,"عندي نزاع ليس عنه نزوع","https://www.aldiwan.net/poem25487.html","الكامل"],[281,"يا موقد النار الذي لم يأل في","https://www.aldiwan.net/poem60754.html","الكامل"],[291,"حسب قلبي من الحزن","https://www.aldiwan.net/poem11681.html","مجزوء الخفيف"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[306,"خطب له الدين أرنى لحظ مذعور","https://www.aldiwan.net/poem56539.html","البسيط"],[372,"إن تخطاني زماني","https://www.aldiwan.net/poem57086.html","مجزوء الرمل"],[430,"سل سبيلا لتسقي سلسبيلا","https://www.aldiwan.net/poem39889.html","الخفيف"],[453,"إنتخب للندام كل حديث","https://www.aldiwan.net/poem13698.html","الخفيف"],[459,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[465,"يا لقبي من نغمة الأوتار","https://www.aldiwan.net/poem3182.html","عموديه"],[530,"الجواب الحق في هذا بلا","https://www.aldiwan.net/poem37268.html","الرمل"],[568,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"]],"verses":[["إِن تَخبُ أَنوارُكُم مِن بَعدِ ما صَدَعَت","ثَوبَ الدُجى فَلَضَوءِ الشَمسِ مُنقَطَعُ",0,"ع",1,0],["أَنتَ خَيرٌ مِن أَلفِ أَلفٍ مِنَ القَو","مِ إِذا ما كَبَت وُجوهُ الرِجالِ",1,"ل",1,0],["أَن تَخَّجمَتُهُ وَإِن كانَ إِلّا","مِثلَ ما يَأنَسُ الفَتى بِأَخيهِ",2,"ي",2,0],["أَنتِ خُنتِ البِرَّ إِذ لَم تَعرِفي","مَوضِعَ الخائِنِ وَالبَرِّ الأَمينْ",3,"ن",1,0],["إِن تَختَلِف مُضَرٌ تَتبَع عَدُوَّهُمُ","أَو تَجتَمِع تَنفِكُم عَن أَرضِها مُضَرُ",4,"ر",1,1],["إنْ تخْبُ نارُ الحْرب فهو بفتكِهِ","مِيقادُهَا مِضرَامُها المِغْوار",5,"ر",1,0],["أَنتَ خُنثى تُناكُ وَاللَيثُ فَحلٌ","لَو تَراهُ خَريتَ ما قَد أَكَلتا",6,"ت",2,0],["إِنْ تَخْتَلِفْ طَبَقَاتهُمْ لمْ تخْتَلِفْ","فِيه شُجُونُ أَكَابِرِ وَأَصَاغِرِ",7,"ر",1,0],["أَنْتَ خِدْنُ الشَّبابِ بَيْنكما في الْوَهمِ","قُرْبَى وَشِيجةُ الأَنْسابِ",8,"ب",1,0],["إن تخش سطوة ظالم فلقد ترى","والغرب منه لحكمك الاذعان",9,"ن",1,0],["إن تخلت كل المقادير عني","فبعيني حبيبتي أستعينُ",10,"ن",1,0],["أَن تَخش مِن نَظَر إِلى","شُمّ الهِلال تَكَرما",11,"م",2,0],["انت خضت الدجا بقفر بلا نو","ر فمزقت في ضروب الضلال",12,"ل",1,0],["ان تخدع الطماع لمعته فلن","تقوي على عبت بذقن القانع",13,"ع",1,0],["إن تَخَلني إذا نَطَفتُ عَيِبّاً","فَبَنانِي إذا كَتَبتُ وَقَاحُ",14,"ح",1,0],["أَنتَ خيرُ الوَرى على الإطلاقِ","سيّدُ الخلقِ صفوة الخلّاقِ",15,"ق",1,0],["إِن تَخلُ مِنكَ عِراصٌ","فيحٌ بِها وَقُصورُ",16,"ر",1,0],["إن تخطُ ترتجف البلادُ وإن تقل","تتنصتُ الدنيا لقولٍ يؤثر",17,"ر",1,0],["إنْ تَخْلُ مِنْهُ مَنَازِلٌ وَمَطَالِعٌ","لَمْ تَخْلُ مِنْهُ جَوَانِحٌ وضُلوعُ",18,"ع",1,0],["إِنْ تَخْبُ نارُكَ فَاقْتَبِسْ مِنْ مُهْجَتِي","أَوْ يَفْنَ وَرْدُكَ فَاقْتَطِفْ مِنْ خَدِّهِ",19,"د",2,0],["أنت خلّفت لي الهموم","وأخذت المنى معك",20,"ك",1,0],["إِن تخدَعي مُزيّدا","عَن دِرهَمٍ لا أَزيَدا",21,"د",2,0],["إِن تخلُ منكَ مقاماتٌ فَقد أرِجت","أَرجاؤُها بثناءٍ فيك معطورِ",22,"ر",1,0],["إن تَخَطَّاني زَماني","نافِذاً بالحَدَثانِ",23,"ن",1,1],["أنت خليّ فخل سربي وسربي","يا فؤادي إلى مقام الحبيبِ",24,"ب",1,0],["إِنتخبْ للنَدام كلَّ حديثٍ","من قِصار الفصول داني القطافِ",25,"ف",1,1],["إن تخلُ من وجهك الزوراء مكرَهةً","فإنّ صدَّك عنها صدُّ مختارِ",26,"ر",1,0],["إن تخالف في أنها الشمس فانظر","نورها إذ خبت على الأقمار",27,"ر",1,0],["إنّ تَخْريجَ مَقالٍ حادِثٍ","مِنْ مَقالٍ لإمامٍ أَوّلِ",28,"ل",1,0],["إِنْ تُخْلِفِ الآمَالُ فِي عُمْرِهِ","فَلَمْ تَكُنْ تُخْلِفُ فِيْهِ الظُّنُونْ",29,"ن",1,0]]}