[5528,"اعتذار إلى ليلى العربية ..!","https://www.poetsgate.com/ViewPoem.aspx?id=201010",""],[5758,"إلى ابن زريق البغدادي","https://www.poetsgate.com/ViewPoem.aspx?id=200531",""],[469,"شكوت هوى في مثله تسمع الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=76778",""],[5956,"أحبك يا صديق الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192520",""],[5956,"أحزانه تفري فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=194059",""],[6093,"طَعْمُ الأنَا","https://www.poetsgate.com/ViewPoem.aspx?id=205586",""],[6152,"صبا نجد","https://www.poetsgate.com/ViewPoem.aspx?id=201750",""],[6152,"شوق لايرحم","https://www.poetsgate.com/ViewPoem.aspx?id=202892",""],[6152,"هواك الغرم والمغنم","https://www.poetsgate.com/ViewPoem.aspx?id=203036",""],[6239,"المتنبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75979&r=&rc=30",""],[6345,"صب وفاتنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78654&r=&rc=25",""]],"verses":[["يتيم صانه المولى فأضحت","له كل الأنام من العيال",0,"ل",1,0],["يَتيمٌ جَفاهُ الأَقرَبونَ فَجِسمُهُ","نَحيلٌ وَعَهدُ الوالِدَينِ قَديمُ",1,"م",1,0],["يَتيهُ بِمَرقاهُ سَريرٌ وَمِنبَرٌ","وَيَحمَدُ مَسعاهُ حُسامٌ وَمُصحَفُ",2,"ف",1,0],["يتيمُ ابْتسامك ما يُقهر","فسائل دمعيَ لا ينهر",3,"ر",1,1],["يتيمة فكر امرئٍ يرتجي","كفالة أيامه الماضيه",4,"ي",2,0],["يتيه بمنقارٍ عليه حبائلٌ","تخيّلنَ في ضاحيه جَزعاً مجزَّعا",5,"ع",2,0],["يَتيمَةٌ ما لَها أُمٌّ تَلوذُ بِها","وَلا أَبٌ إِن دَعَتهُ نَحوَها حَضَرا",6,"ر",2,0],["يتيما في غِلالتها","تعالى الله مُوتمه",7,"م",2,0],["يتيم في جناح الل","ه يرعاه ويعصمه",7,"م",2,0],["يَتيهُ عَلى الماسِ بَعضُ النُحاسِ","إِذا ضَمَّ أَلحانَهُ الغالِيَه",8,"ي",2,0],["يَتيهُ الدَقيقُ الفِكرِ في بُعدِ غَورِهِ","وَيَغرَقُ في تَيّارِهِ وَهوَ مِصقَعُ",9,"ع",1,0],["يَتيهُ أَهلُ التيهِ مِن جَهلِهِم","وَهُم يَموتونَ وَإِن تاهو",10,"ا",3,0],["يتيمةٌ ثغرُها يتيمٌ","تجورُ بالقامةِ القويمَهْ",11,"ه",1,1],["يَتيمٌ جَفاهُ الأَقرَبونَ فَعَظمُهُ","ضَعيفٌ وَحُبُّ الوالِدَينِ قَديمُ",12,"م",1,0],["يَتيمٌ جَفاهُ الأَقرَبونَ فَعَظمُهُ","كَسيرٌ وَفَقدُ الوالِدَينِ عَظيمُ",13,"م",1,0],["يَتيهُ عِندي وَأَنا أَخضَعُ","إِن كانَ ذا بَختي فَما أَصنَعُ",14,"ع",1,1],["يَتيمَةٌ بَينَ أَهلِ الدَهرِ قَد رُزِقَت","جَدّاً مُزاحاً وَجِدَّ الناسِ مِن لَعِبِ",15,"ب",1,0],["يَتيهِ عَلى العِبادِ بِحُسنِ وَجهٍ","وَشَعرٍ قَد أُطيلَ عَلى قَفاهُ",16,"ا",2,0],["يتيهُ باسمكَ في أقداسهِ نُصُبٌ","رخامهُ الدهرُ والتاريخُ حَفّارُ",17,"ر",1,0],["يَتِيهُ البَيَانُ بِأَوْصَافِهَا","وَيُوشِكُ أَنْ يُفْصِحَ المُعْجِمُ",18,"م",1,0],["يتِيمَتَا العَصْرِ هُمَا هَلْ تُرَى","ثَالِثَةٌ تَأْتِي بِهَا الأَعْصُرُ",19,"ر",1,0],["يتيه بمنقارٍ عليه حبائكٌ","تخيّلنَ في ضاحيه جَزعاً مجزَّعا",20,"ع",2,0],["يَتِيهُ بِهَا ضَافي الشبابِ ونَضْرُهُ","وَتَسْمُو حَوَاليهِ بِهَا وعَوَأطِلُهْ",21,"ل",2,0],["يتيه بالفضل ذو فضل فأمقته","ما بال قوم بأسلاف لهم تاهوا؟",22,"ا",1,0],["يتيهون سكعا في المجاهل ما بهم","بمواطئ أخفاف المطي بصير",23,"ر",1,0],["يَتيهُ بحيثُ تَلتحِمُ الرَّزايا","عليكَ ، بحيثُ تَلْتَحِمُ السُقوف",24,"ف",1,0],["يتيهون سكعاً في المجاهل ما بهم","بموطىء أخفاف المطي بصير",25,"ر",1,0],["يَتيمٍ فَقالَ اِدعوهُ إِنَّ طَعامَنا","لَهُ دونَكُم مِن سوقَةٍ وَإِمامِ",26,"م",1,0],["يتيه بطلعةٍ من فوقَ قدٍّ","فوا شوقي لطلعتهِ وقدّه",27,"ه",1,0],["يتية بدلّه ويصول عمدا","غنيٌّ بالجمال فلا يداري",28,"ر",2,0],["يتيه ثرى تمشى بنعليك فوقه","ويسحب للعليا عليه ذيول",29,"ل",1,0],["يتيمة وبها فقر لعل اذا","ما صال جودك عنها الفقر ينهزم",30,"م",1,0],["يَتيهِ اِفتِخاراً بِأَجدادِهِ","كَأَنَّ الوَرى جَهِلوا جَدَّه",31,"د",2,0],["يتيهون في ديمومة مدلهمة","يطوفون بالأحجار تطواف عابث",32,"ث",1,0],["يَتيهُ بِسَرجٍ عَسجَدِيٍّ كَأَنَّما","هِلالانِ مِنهُ في المُقَدَّمِ وَالتالي",33,"ل",2,0],["يَتيهُ عَلى الأَيّامِ فَضلاً وَسودَداً","فَلَو فاخَرَتهُ أَفحَمَتها مَفاخِرُه",34,"ر",2,0],["يَتِيهُ بِكَ الْمُلْكُ وَهْوَ الُوَقُورُ","وَيَشْجى بِكَ الْدَّهْرُ وَهْوَ الصَّبُورُ",35,"ر",1,0],["يتيه ضلالاً في غيابه همه","فلا حجر يهديه لرشدٍ ولا حجا",36,"ج",2,0],["يتيهُ بها دلٌّ ويَعطِفُها حيا","فَتُبدي الجَفا قبضاً وتولي الوَفا بَسطا",37,"ط",2,0],["يَتيمَةُ الدَهرِ الَّتي كافِلُها","وَلِيُّ ذي الكِفلِ وَصاحِبُ الخِضِر",38,"ر",1,0],["يَتيهُ بقَدِّ كلّما هَزَّه الصِّبا","تَمايلَ مَيْل الغُصْنِ وهو رطيب",39,"ب",1,0],["يَتيمٌ إِذا ما ماتَ عَنهُ حَبيبُهُ","وَما كُلُّ فَقدِ الوالِدَينِ هُوَ اليُتمُ",40,"م",1,0],["يتيماتٌ تُصَدِّقُ في عُلاهُ","مَقَالَةَ مَنْ دعاهُ أَبا اليتامى",41,"م",2,0],["يَتيهُ بذِكراه النّسيب وتزدهي","بسَيدنا الحبر الإمام المدائحُ",42,"ح",1,0],["يتيمني طرف كحيل وقامة","مهفهفة تبدو ديها المطامع",43,"ع",1,0],["يتيه من يأتمّ في الصبح بها","وابن الظلام لا يخافُ التِّيها",44,"ه",2,0],["يتيه في الزمان مثلَ تيهها","في الشعر أو يختال كاختيالها",45,"ل",3,0],["يتيه من فوق كرسيٍّ وُهِبتُ له","من الحسين بقدٍّ قام كالألف",46,"ف",1,0],["يتيه الخميس المجر بابن مُهلهلٍ","ونفس حسام الدين من بأسه مجْر",47,"ر",1,1],["يتيهُ الدينُ إذْ ندعوكَ صِدْقاً","لهُ عَضُداً ويبْتَهِجُ الإِمامُ",48,"م",1,0],["يتيهُ الثرى يمشي عليه تواضعاً","على المسكة الذفراءِ والعنبر الورد",49,"د",1,0],["يتيمني لدن الكثيب وهيفه","وتحكم حور السرب في وعينه",50,"ن",2,0],["يتيّم قلبي ظبيُ تيماءَ ظالماً","ويوضح ما أخفيته عنك توضحُ",51,"ح",1,0],["يتيه بوجنةٍ كالورد حسناً","يحيط بها عذارٌ كالسياج",52,"ج",1,0],["يتيّمهُ جدُّ الفراقِ وهزلهُ","ويملكهُ حقُّ الفراقِ وباطله",53,"ل",2,0],["يَتيهُ بِرِدفٍ كَثيرِ الحَراكِ","وَيُزهى بِخَصرٍ كَثيرُ السُكونِ",54,"ن",1,0],["يَتيهُ بِخَدَّينِ قَد عُذِّرا","فَصارَ لُجَينُهُما مُحرَقا",55,"ق",2,0],["يَتيهُ الثَرى مِنّا بِوَطئٍ غَطارِفٍ","مَناقِبُهُم مِن كُلِّ ما فيهِ أَكثَرُ",56,"ر",1,0],["يَتيهُ فَيُعذِرُ في تيهِهِ","وَما كُلُّ مَن تاهَ مِنّا عُذِر",57,"ر",1,0],["يَتيهُ عَلى الغُصونِ إِذا تَثَنّى","بِلينِ مَعاطِفٍ وَبِحُسنِ قَدِّ",58,"د",1,0],["يَتيهُ صريخُ مَطْلَبِه المُرجّي","بسيرَتِهِ ويفتخِرُ الزِّحامُ",59,"م",1,0],["يتيه بكفيه من الهند أبيض","ويزهى به لدن من الخط أسمر",60,"ر",1,0],["يَتيهُ بِمَدحِكُم شِعرىَّ زَهواً","ويَزهي العِقدُ بالجِيدِ الجَميلِ",61,"ل",1,0],["يتيه وتبصرُه مقبلاً","فيُحسَب من تيهه مُعْرضا",62,"ض",2,0],["يتيه في تيهه من ظل يرشده","إلى الهدى طالب قد شفه الطلب",63,"ب",1,0],["يَتَيَقَّنُ الراجي اليَسارَ لِقَصدِهِ","لِلبَحرِ أَن مَدَّ اليَمينَ لمدِّهِ",64,"د",2,0],["يتيمةُ الدّهر في إبْدَا عجائِبه","ذخيرةُ المُلْكِ في الآراءِ والأدبِ",65,"ب",1,0],["يتيه على الإخوان كبراً ولم يكن","ليخفض من مقداره التيه والكبر",66,"ر",1,0],["يَتيمَةُ درٍّ لا سِواكَ لَها أبٌ","أَتَتكَ بِجَدٍّ إِذ غَدَت فيك ترغبُ",67,"ب",1,0],["يَتيمَةُ الحسنِ وَبِنت الجَمالْ","حَسناءُ بِالغرّةِ ذاتِ البَلجْ",68,"ج",1,0],["يَتيمَةُ حُسنٍ وَهيَ بالِغةٌ بهِ","إِلى الغايَةِ القُصوى منَ الأَكمَلِ الأصفى",69,"ف",2,0],["يَتَيمَةً بِنت فِكرٍ لا مِثالَ لها","وَأَحسَنُ الشّيء في الدّنيا نَوادِرُهُ",70,"ر",2,0],["يَتيمَةُ درٍّ تعزُّ وجوداً","وَعَنها تَعرَّت خَزائن دارا",71,"ر",2,0],["يَتيمَةُ الدّهرِ صِينَتْ عَن مُماثِلها","فريدةُ الوَقتِ بَينَ النّاسِ وَالبشَرِ",72,"ر",1,0],["يَتيمَةُ الحُسنِ يا بِنت الجَمالِ زَها","يا غُصنَ بانٍ تَثَنّى وَهوَ أُملودُ",73,"د",1,0],["يَتيمة وَأَبوها الحُسن يَحضِنُها","حَسناء عَذراء لَم تُطمَث وَلم تُصَبِ",74,"ب",1,0],["يتيه بها التّيار فخراً فينثني","وتجري بهَا الأميال شوقاً على عجَلْ",75,"ل",1,0],["يتيه على من تاه قدماً بقوله","قفا نبك من ذكرى حبيب ومنزل",76,"ل",1,0],["يَتِيمَةُ أدنَانٍ عَجُوزة حَانَةٍ","فَيَا لَعَجْوزٍ قَدْ حَوَتْنَا بِيُتْمِهَا",77,"م",3,0],["يتيه في رحابها الخيال","والظنُ الِملم",78,"م",1,0],["يتيمة عقد الهاشميين والذي","به نلتجي ان ما دهمن خطوب",79,"ب",1,0],["يتيمة عقد أنت ان اخلصت له","صفاتك والانسان والحر والعبد",80,"د",1,0],["يتيه بصدره رُمان ثَديٍ","على عُكنٍ تفتحُ عن نطاقِ",81,"ق",1,0],["يتيهُ ببرديةِ حنان ورأفةٍ","وملءُ حواشيهِ المُنى والمعارف",82,"ف",1,0],["يتيه في زاه من الملبس","أما ترى تاج الربيع انعقد",83,"د",1,0],["يتيمان قام الشعر يحكي جواهما","بأميهما والهم يهتاج بالهم",84,"م",1,0],["يتيهُ والكلبُ اعلى منهُ منزلةً","كأنَّه بعدُ لم يخرج من التيهِ",85,"ه",1,0],["يتيمها شعري ولولاه لم تكن","متيمةً بي تستطيب التلاقيا",86,"ي",2,0],["يتيمة عقد المجد مشكاة نوره","ومقباسه ان تخب منه النبارس",87,"س",1,0],["يتيه علي الدهر إني فاضل","ولو كنت ذا جهل لتهت على الدهر",88,"ر",1,0],["يتيه بقد يُغيرُ الغصونَ","وخد بغير دمي ما اختضب",89,"ب",1,0],["يتيمه للسيف خدٌّ مضرج","ويطربه للرمح قدٌّ مهفهف",90,"ف",