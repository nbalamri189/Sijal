{"poems":[[73,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[51,"ويوم كأن النوم يغتال طوله","https://www.aldiwan.net/poem64087.html","الطويل"],[29,"خليلي قوما للرحيل فإنني","https://www.aldiwan.net/poem6047.html","الطويل"],[29,"وبالجزع من خفان صاحبت عصبة","https://www.aldiwan.net/poem6109.html","الطويل"],[38,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[45,"عذيري من واش بها لم أواله","https://www.aldiwan.net/poem65537.html","الطويل"],[45,"أَكان الصبا إِلا خيالا مسلما","https://www.aldiwan.net/poem66638.html","البسيط"],[458,"أيا ليل جو من بشيرك بالصبح","https://www.aldiwan.net/poem56252.html","الطويل"],[555,"ألا أبلغا سعد بن ليث وجندعاً","https://www.aldiwan.net/poem1921.html","الطويل"]],"verses":[["إِذا مَعشَرٌ أَلهاهُمُ جُلَساؤُهُم","فَلَهوُكَ ذِكرٌ وَالجَليسُ كِتابُ",0,"ب",1,0],["إذا معجت فيه الشمال رأيتها","كأن عليها لؤلؤاً يتحدّر",1,"ر",1,0],["إِذا مُعجَلٌ غادَرنَهُ عِندَ مَنزِلٍ","أُتيحَ لِجَوّابِ الفَلاةِ كَسوبِ",2,"ب",1,0],["إِذا مَعَكَ الدَينَ الغَريمُ فَإِنَّها","عَلى كُلِّ أَحيانٍ تَحِلُّ دُيونُها",3,"ن",3,0],["إِذا مَعزاءُ هاجِرَةٍ أَرَنَّت","جَنادِبُها وَكانَ العيسُ جونا",4,"ن",2,0],["إِذا مَعشَرٌ صانوا التِلادَ تَعَسَّفَت","بِهِ هِمَّةٌ مَجنونَةٌ في اِبتِذالِهِ",5,"ل",2,0],["إِذا مَعشَرٌ جارَوكَ في إِثرِ سُؤدُدٍ","تَأَخَّرَ مِن مَسعاتِهِم ما تَقَدَّما",6,"م",2,0],["إذا معجزاتُ الشعر عارضن فهمَه","حَلبنَ بكيئاً لا تدرُّ على المسحِ",7,"ح",1,0],["إِذا مَعشَرٌ يَوماً بَغَوني بَغَيتُهُم","بِمُسقِطَةِ الأَحبالِ فَقماءَ قِنطِرِ",8,"ر",1,0]]}