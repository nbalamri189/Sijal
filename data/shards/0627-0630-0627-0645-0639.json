{"poems":[[75,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[53,"ويوم كأن النوم يغتال طوله","https://www.aldiwan.net/poem64087.html","الطويل"],[31,"خليلي قوما للرحيل فإنني","https://www.aldiwan.net/poem6047.html","الطويل"],[31,"وبالجزع من خفان صاحبت عصبة","https://www.aldiwan.net/poem6109.html","الطويل"],[40,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[47,"عذيري من واش بها لم أواله","https://www.aldiwan.net/poem65537.html","الطويل"],[47,"أَكان الصبا إِلا خيالا مسلما","https://www.aldiwan.net/poem66638.html","البسيط"],[463,"أيا ليل جو من بشيرك بالصبح","https://www.aldiwan.net/poem56252.html","الطويل"],[560,"ألا أبلغا سعد بن ليث وجندعاً","https://www.aldiwan.net/poem1921.html","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17114","الطويل"],[1354,"","https://poetry.dctabudhabi.ae/diwan/poem/205985",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49933","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65109","الطويل"],[194,"ما بالُ عَينٍ شَوقُها استَبكاها","https://www.poetsgate.com/ViewPoem.aspx?id=51514",""],[469,"محيّكِ أحيا الوجدَ بل اتلفَ الصبّا","https://www.poetsgate.com/ViewPoem.aspx?id=76783",""]],"verses":[["إِذا مَعشَرٌ أَلهاهُمُ جُلَساؤُهُم","فَلَهوُكَ ذِكرٌ وَالجَليسُ كِتابُ",0,"ب",1,0],["إذا معجت فيه الشمال رأيتها","كأن عليها لؤلؤاً يتحدّر",1,"ر",1,0],["إِذا مُعجَلٌ غادَرنَهُ عِندَ مَنزِلٍ","أُتيحَ لِجَوّابِ الفَلاةِ كَسوبِ",2,"ب",1,0],["إِذا مَعَكَ الدَينَ الغَريمُ فَإِنَّها","عَلى كُلِّ أَحيانٍ تَحِلُّ دُيونُها",3,"ن",3,0],["إِذا مَعزاءُ هاجِرَةٍ أَرَنَّت","جَنادِبُها وَكانَ العيسُ جونا",4,"ن",2,0],["إِذا مَعشَرٌ صانوا التِلادَ تَعَسَّفَت","بِهِ هِمَّةٌ مَجنونَةٌ في اِبتِذالِهِ",5,"ل",2,0],["إِذا مَعشَرٌ جارَوكَ في إِثرِ سُؤدُدٍ","تَأَخَّرَ مِن مَسعاتِهِم ما تَقَدَّما",6,"م",2,0],["إذا معجزاتُ الشعر عارضن فهمَه","حَلبنَ بكيئاً لا تدرُّ على المسحِ",7,"ح",1,0],["إِذا مَعشَرٌ يَوماً بَغَوني بَغَيتُهُم","بِمُسقِطَةِ الأَحبالِ فَقماءَ قِنطِرِ",8,"ر",1,0],["إِذا مَعشَرٌ في المَجدِ كانوا هَوادِيا","فَقيسوا بِهِ في المَجدِ عادوا تَوالِيا",9,"ي",2,0],["اذا معه في البيت جده","باستوي لك جزرٍ ومد",10,"د",1,0],["إذا مَعاشرُ عن طرق العُلى لُفِتوا","أُلفيتَه شمَّرياً غيْر مَلْفُوتِ",11,"ت",1,0],["إذا مُعتف يوما حباهُ رغيبة","تعودُ من العافي تُنال الرّغائب",12,"ب",1,0],["اِذا مَعَدُّ زَخَرَت قُدناها","كُرهاً اِذا ما اجتَمَعَت عُتاها",13,"ا",3,0],["إذا معضلٌ في المُلك أعيا دواؤهُ","غدا حاسماً أسبابهُ حازماً طبّا",14,"ب",2,0]]}