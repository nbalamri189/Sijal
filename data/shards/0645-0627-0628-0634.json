{"poems":[[53,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[107,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[240,"ما كنت أول حافظ لمضيع","https://www.aldiwan.net/poem31823.html","الكامل"],[445,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145611","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96619","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120499","الكامل"],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""]],"verses":[["ما بَشرِي بالبعيد من شَعَري","ذا ورقٌ حائلٌ وذا نَجَبُهْ",0,"ب",2,0],["ما بَشَّرَتنا بِمَحبوبٍ وَما بَرَحَت","يَنعى إِلَينا حُماةَ المُلكِ ناعيها",1,"ي",3,0],["ما بَشَّرَت بِالخِصبِ أُمُّ بَوارِقٍ","تَفتَرُّ عَن واري الزِنادِ لَموعِ",2,"ع",1,0],["ما بُشِّرُوا بالفَوْزِ حَتَّى بُشِّرُوا","بِأَبَرِّ مَنْ خَلَفَ الجُدُودَ وأَمْجَدِ",3,"د",1,0],["ما بشخص الحبيب يفرح ذو العق -","ل ولا بالخدود والأحداق",4,"ق",1,0],["ما بشّ لي بالودّ منه تودّداً","إلّا وعبّس بعد ذاك وقطّبا",5,"ب",2,0],["ما بشر الاسلام قط بمثلها","فاتاه منها امة ونصير",6,"ر",1,0],["ما بَشَّ لِي زَمَنٌ إِلاَّ وَقَدْ عَبَسَتْ","بَعْدَ البَشاشَةِ أَزْمانٌ فأَزْمانُ",7,"ن",1,0]]}