{"poems":[[50,"لما أتوني بكأس من شرابهم","https://www.aldiwan.net/poem63274.html","البسيط"],[463,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140224",""],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/177841","الطويل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[3427,"","https://poetry.dctabudhabi.ae/diwan/poem/205335","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4728,"على قبر أبي","https://www.poetsgate.com/ViewPoem.aspx?id=176882",""],[406,"أنشودة الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1117&r=&rc=61",""]],"verses":[["آلى زَعيمُهُمُ بِالنارِ قَد طُبِخَت","يُريدُ مِدحَتَها بِالشَينِ وَالعارِ",0,"ر",1,0],["إلى زعيم الدين خضنا بها","غِمار تيهِ البلدِ الماحلِ",1,"ل",1,0],["إِلى زَوالِ المانِع المُكَدَّر","مِن دَفعِ غرمٍ مُجحفٍ مخسرِ",2,"ر",1,0],["إلى زنجبار حرك الشجو تذكار","وما لي والذكرى وقد شطت الدار",3,"ر",1,1],["إلى زمزم زمت ركاب مطينا","ونحو الصفا عيس الوفود صففناه",4,"ن",3,0],["إلى زمان المستعين بالله","بلَّغهُ اللَه المرادَ كُلَّه",5,"ه",1,0],["آلي زعيمهم بالله: قد طبخت","يريد مدحتها بالشين والعار",6,"ر",1,0],["إلى زانةٍ قربه استندا","ليدرأ عنه ثقيل الردى",7,"د",2,0],["إلى زُقاقِ الجنةِ الأَعلى الذي","بشاطئ الكَوثَرِ من بابِ المُنى",8,"ا",1,0],["إلى زاجٍ بعد عينه على وبل الحبر محتوت","إلى دمعٍ من الكوثر يقبّل سلّة الإصليت",9,"ت",1,0],["إلى زمانٍ كان فيه الرضَّا","يرقُصُ في ظلَّ أمانينا",10,"ن",2,0]]}