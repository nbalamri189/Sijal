 غيدي الحسان عوانساً","وأمسينَ من نعماك نازحةَ الخطب",76,"ب",1,0],["لقد غادرت نعماك عندي صبابةً","يضيق بها ذرعُ االحشى الحيازمِ",77,"م",1,0],["لقد غدا كل صوت في منازلنا","يبكي إذا لم يجد أهلا لهم يصل!",78,"ل",1,0],["لقد غدروا بذي عهدٍ متينٍ","تَنَزَّهَ أن يُغَيرَهُ الزمانُ",79,"ن",1,0],["لقد غدرتْ بمَنْ لم ينوِ غدراً","ولم يَذُقِ الكرى إلا غِرارا",80,"ر",2,0],["لقد غدرتْ بي وما خُنْتُها","فيا بئسَ ما أصبحتْ تصنعُ",81,"ع",1,0],["لقد غنى اليمام بصوت أحمر","أسحر السحر في جفن الغزال",82,"ل",1,0],["لقد غير الحساد حسن فتوتي","بناءٍ صلاحي في الصبابه محكم",83,"م",1,0],["لقد غَدا البُخلُ شخصاً نَصْبَ أعيُننا","فأصبحَ الجودُ عهداً ليس نَذكرُهُ",84,"ر",2,0],["لقد غُبِطَ العُلا بخِتانِ شِبلٍ","أبوهُ أنت يا ليثَ النِّزالِ",85,"ل",1,0],["لقد غصبَتْ منها القُرون لَيالياً","من الدهرِ لولا طُولُها قلتُ من عُمري",86,"ر",2,0],["لقد غلِطَ الزّمانُ فجادَ فيه","وأعْقَمَ بعدَه فرْجُ الأوانِ",87,"ن",1,0],["لقد غمرتني من نداه مواهب","أضافت إلى عز الغنى شرف القدر",88,"ر",1,0],["لقد غادرتني في كلِّ حالٍ","أذمُّ الدهر فيك وأستزيدُ",89,"د",1,0],["لقد غِبتَ عن عيني وأنتَ ضياؤُها","وطولُ غيابٍ منك للعَينِ يُسهِدُ",90,"د",1,0]]}