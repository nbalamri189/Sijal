aspx?id=184513",""],[4755,"مَتَى يَفْقَأُ اللهُ هذِي الكُرَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=200256",""],[5033,"أنا باختصار","https://www.poetsgate.com/ViewPoem.aspx?id=182757",""],[5080,"مواويل لاء","https://www.poetsgate.com/ViewPoem.aspx?id=185549",""],[5092,"يموت الظلُّ","https://www.poetsgate.com/ViewPoem.aspx?id=190579",""],[5183,"مبعث الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=180278",""],[5185,"بعض أنفاس البحر","https://www.poetsgate.com/ViewPoem.aspx?id=71578",""],[5277,"دمعةٌ على وجنةِ الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=189757",""],[5582,"أَلا هَلْ تَوَلَّتْ نَوارٌ نَوارا","https://www.poetsgate.com/ViewPoem.aspx?id=186999",""],[1547,"يا راكب البَكر بين الشيحِ والغارِ","https://www.poetsgate.com/ViewPoem.aspx?id=16759",""],[5703,"الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=216044",""],[5742,"رثاء الأماجد","https://www.poetsgate.com/ViewPoem.aspx?id=206966",""],[5804,"قصيدة من مساجلة 3","https://www.poetsgate.com/ViewPoem.aspx?id=180670",""],[5910,"بِمكةَ نورٌ قد سَرَى وضياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=206977",""],[5956,"رفضتُ حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=182142",""],[5956,"الأشواقُ الجنونية","https://www.poetsgate.com/ViewPoem.aspx?id=192466",""],[5956,"مضى عبدُ هادي لخلدِ النعيم","https://www.poetsgate.com/ViewPoem.aspx?id=192987",""]],"verses":[["لَقَد غَدَرَ الأَظعانُ يَومَ سَويقَةٍ","وَيَدمى لِذِكرِ الغادِرينَ بَناني",0,"ن",2,0],["لَقَد غَرَّبَتني حُظوَةُ الفَضلِ عَنكُمُ","وَإِن جَمَعَت أَعراقَنا نَبَعاتُها",1,"ت",3,0],["لقدْ غَدَتِ الوِزارةُ منْكَ تُزْهى","بمَنْ رقّتْ سَجاياهُ وَراقا",2,"ق",2,0],["لَقَد غُرِسوا غَرسَ النَخيلِ تَمَكُّناً","وَما حُصِدوا إِلّا كَما حُصِدَ البَقلُ",3,"ل",1,0],["لقد غاظني عند الشروق هياجها","كما سرّني عند الغروب هجوعها",4,"ع",3,0],["لقد غَمِطوا حق النساء فشدّدوا","عليهنّ في حبس وطول ثواء",5,"ا",2,0],["لَقَد غَرَّ القُيونُ دَماً كَريماً","وَرَحلاً ضاعَ فَاِنتُهِبَ اِنتِهابا",6,"ب",2,0],["لَقَد غادَروا بِالعيصِ عِلقَ مَضِنَّةٍ","وَلَم تَرَ عَيني مِثلَهُ عِلقَ لابِسِ",7,"س",1,0],["لَقَد غادَروا في اللَحدِ مَن كانَ يَنتَمي","إِلى كُلِّ نَجمٍ في السَماءِ مُحَلِّقِ",8,"ق",1,0],["لَقَد غَيَّبُوا بِرَّاً وصِدقاً ونَائِلاً","عَشِيّةَ وَارَاكَ الصَّفِيحُ المُنَصَّبُ",9,"ب",1,0],["لَقَد غَضِبَت جَهلاً سُلَيمٌ سَفاهَةً","وَطاشَت بِأَحلامٍ كَثيرٍ عُثورُها",10,"ر",3,1],["لَقَد غَيَّبوا حِلماً وَعِلماً وَرَحمَةً","عَشِيَّةَ عَلَّوهُ الثَرى لا يُوَسَّدُ",11,"د",1,0],["لقد غرَّت الدُّنيا بخدعة حربها","فما أكثر القتلى وما أرخص الأسرى",12,"ر",2,0],["لقد غدت فكر الأمداح جائزة","بين التفاصيل من نعماك والجمل",13,"ل",1,0],["لقد غدا يُثنى به شعرُنا","أضعاف ما يثنى به المجمر",14,"ر",1,0],["لقد غُشّ فيك أبٌ غافلٌ","فما دُهمةٌ فيك لم تُغشَش",15,"ش",1,0],["لَقَد غَدَوتَ عَلى النَدمانِ لا حَصِرُ","يُخشى أَذاهُ وَلا مُستَبطَأٌ زَمِرُ",16,"ر",1,1],["لقد غاب من تهوين مرأى وجوهِهم","كأنهم زهر النجوم الغوارب",17,"ب",1,0],["لَقَد غَيَّبوا فيكَ أَمضى السُيوفِ","فَهَل أَنتَ يا قَبرُ أَوفى الغُمود",18,"د",1,0],["لقد غَرَّهم متنٌ من السيف ليِّنٌ","فَهلّا نهاهم حدُّهُ وهو مذروبُ",19,"ب",1,0],["لَقَد غادَرتِ في جَسَدي سَقاماً","بِما في مُقلَتَيكِ مِنَ السَقامِ",20,"م",1,0],["لَقَد غَشِيَتنا ظُلمَةٌ بِعدَ فَقدِكُم","نَهاراً وَقَد زادَت عَلى ظُلمَةِ الدُجى",21,"ا",1,0],["لَقَد غَرَّتِ الدُنيا قُروناً كَثيرَةً","وَأَتعَبَتِ الدُنيا قُروناً وَأَنصَبَت",22,"ت",1,0],["لَقَد غَمَرَتني مِن أَياديكَ أَنعُمٌ","مَلَكتَ بِها رِقّي وَإِن أَكثَرَت مُلكي",23,"ك",2,0],["لقد غفلَتْ صروفُ الدهر عني","وبتُّ منَ الحوادثِ في أمانِ",24,"ن",1,1],["لقد غَرَّ الهُنَيْدُ بني جُذَامٍ","فما للقومِ مِمّا جَرَّ واقِ",25,"ق",1,0],["لقد غَرَّنَا كَيْما يَفُوزُ بِمَالِهِ","فحاقَ بنا من إثمِهِ ما تَعَمَّدا",26,"د",2,0],["لَقَد غادَرَت حَزماً وَبِرّاً وَنائِلاً","وَلُبّاً أَصيلاً خالَفَتهُ المَجاهِلُ",27,"ل",1,0],["لَقَد غَرَّني مِن جَعفَرٍ حُسنُ بابِهِ","وَلَم أَدرِ أَنَّ اللُؤمَ حَشوُ إِهابِهِ",28,"ه",1,1],["لَقَد غَرَّتِ الدُنيا بَنيها بِمَذقِها","وَإِن سَمَحوا مِن وُدِّها بِصَريحِ",29,"ح",1,0],["لَقَد غادَرَ العَيشُ هَذا السَوادَ","يُعاني مِنَ الدَهرِ بيضاً وَسودا",30,"د",2,1],["لَقَد غابَ عَن فَودَيكَ خَمسينَ حَجَّةً","فَأَهلاً بِهِ لَمّا دَنا وَتَسَوَّرا",31,"ر",2,0],["لَقَد غَرَّني أَمَلٌ في الحَياةِ","كَأَنّي بِما يَفعَلُ الدَهرُ غِرُّ",32,"ر",1,0],["لَقَد غمطوا بغدادَ في شعرائها","وَقالوا جلال الشعر أَجمع في مصر",33,"ر",1,0],["لَقَد غاظَكَ الدهر حَتّى ودد","تَ أنك من أَهله تنقم",34,"م",1,0],["لقد غمر الأكواخَ فوق صخوره","ولجَّ بها في موجه المتزائرِ",35,"ر",1,0],["لقد غرقوا في إثر أكواخهم به","وما لمسوا من حكمِه عفوَ قادرِ",35,"ر",1,0],["لقد غادروا حزماً وعزوماً ونائلاً","وصبراً على اليومِ العبوسِ القماطرِ",36,"ر",1,0],["لَقَدْ غَبَرَتْ حِقَبٌ لاَ تُعَدُّ","يِدُولُ النَّعِيمُ بِهَا وَالشَّقَاءْ",37,"ا",2,0],["لقد غيّب القبرُ في لحدهِ","وقاراً نبيلا وبراً ودنيا",38,"ن",3,0],["لقد غَّض من شأن العمامةِ معشرٌ","فَشِدتَ لها بين السماكين مقعدا",39,"د",2,0],["لَقَدْ غادَرْتِ في قَلبي سَقَاماً،","بِما في مُقلَتَيكِ منَ السّقامِ",40,"م",1,0],["لقد غَمَرَ الفَجْرُ نهديْكِ ضوءاً","فَعُودي إلى أُمِّكِ الغافلَهْ",41,"ل",2,0],["لَقَدْ غَنِيَتْ نَفْسي، وأَنْتَ بِهَمِّها،","فَقَدْ جَعَلَتْ، والحَمْدُ لِلَّهِ، تَذْهَلُ",42,"ل",1,0],["لقد غبت يا نور العيون تحجبا","متى فجرك الوضاح ابصر مطلعه",43,"ع",2,0],["لقد غُيِّبُوا واللهِ في حُفَرِ البِلَى","فلم يدْرِ مَثْوى شيخِها وَصَبِيهَا",44,"ي",3,0],["لَقَد غَدا بِكَ هَذا الدَهرُ مُحتَلِياً","فَعادَ بَعدَ عُلُوِّ السِنِّ مُحتَلِما",45,"م",2,0],["لَقَد غادَرتَ بِالإِحسانِ بَيني","وَبَينَ النائِباتِ نَوىً شَطَونا",46,"ن",2,0],["لَقَد غابَ نورُ الشَمسِ في نورِ صَدرِهِ","كَما دَقَّ قَدرُ الكَونِ عَن عُظمِ قَدرِهِ",47,"ه",1,0],["لَقَد غَيَّبَت أَثراؤُهُ جِسمَ ماجِدٍ","جَليلٍ إِذا اِلتَفَّت عَلَيهِ المَجامِعُ",48,"ع",1,0],["لَقَد غَدَرَت إِنّا إِلى اللهِ بَعدَما","وَفَينَا وَكُنّا كُلَّ يَومِ نَشوقُها",49,"ه",2,0],["لقد غَضَّ منك فهَلاّ لبستَ","علىرغمه حُلَّةَ الخاضِب",50,"ب",1,0],["لقد غادرتْ آثارُ عزمِك سِنْبِسا","نذيرا لمن قد غَرَّه الجمعُ والحَشْد",51,"د",1,0],["لَقَد غلبَ الأديانَ بالحقِّ دينهُ","كَما غلبَ الليثُ الغضنفرُ سنّورا",52,"ر",2,0],["لَقَد غَفلوا عَن شأنِ يومٍ يهولهم","وَلَو صدّقوا المختارَ