{"poems":[[53,"أيا جبلي نجد أبينا سقيتما","https://www.aldiwan.net/poem29656.html","الطويل"],[53,"أبينتها أم ناكرتك شياتها","https://www.aldiwan.net/poem30677.html","الطويل"],[77,"رأت والليل قد سدل الرواقا","https://www.aldiwan.net/poem35908.html","الوافر"],[54,"ألم تر صرف الدهر في آل برمك","https://www.aldiwan.net/poem27506.html","الطويل"],[88,"يدل على لؤم الغزالة أنها","https://www.aldiwan.net/poem44409.html","الطويل"],[88,"ألا ما لأهل الشرق في برحاء","https://www.aldiwan.net/poem44973.html","الطويل"],[27,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[27,"إذا ذكرت نفسي شريكا تقطعت","https://www.aldiwan.net/poem5790.html","الطويل"],[27,"لعمري لقد أشجى تميما وهدها","https://www.aldiwan.net/poem5943.html","الطويل"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[23,"لقد غضبت جهلا سليم سفاهة","https://www.aldiwan.net/poem21364.html","الطويل"],[23,"بطيبة رسم للرسول ومعهد","https://www.aldiwan.net/poem21547.html","الطويل"],[72,"تنبه لما أن رأى شبيه فجرا","https://www.aldiwan.net/poem18702.html","الطويل"],[72,"يا أيها المربي برؤيته","https://www.aldiwan.net/poem19567.html","البسيط"],[51,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[51,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[29,"لقد غدوت على الندمان لا حصر","https://www.aldiwan.net/poem6163.html","البسيط"],[89,"أحاطت بليل اليأس مني غياهب","https://www.aldiwan.net/poem44938.html","الطويل"],[85,"أصاب المجاهد عقبى الشهيد","https://www.aldiwan.net/poem62887.html","المتقارب"],[62,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[45,"خيال يعتريني في المنام","https://www.aldiwan.net/poem65653.html","الوافر"],[58,"أمن بعد تكفين النبي ودفنه","https://www.aldiwan.net/poem31202.html","الطويل"],[49,"أيا عجب الدنيا لعين تعجبت","https://www.aldiwan.net/poem10847.html","الطويل"],[66,"أيا ملك العصر الذي شاع فضله","https://www.aldiwan.net/poem41353.html","الطويل"],[69,"لقد غفلت صروف الدهر عني","https://www.aldiwan.net/poem29296.html","الوافر"],[105,"أما ومضارب البيض الرقاق","https://www.aldiwan.net/poem43994.html","الوافر"],[105,"تقدم فهذا مطلع الحق والهدى","https://www.aldiwan.net/poem44054.html","الطويل"],[22,"أرى العير تحدى بين قو وضارج","https://www.aldiwan.net/poem22003.html","الطويل"],[48,"لقد غرني من جعفر حسن بابه","https://www.aldiwan.net/poem62439.html","الطويل"],[46,"أما وفؤاد بالغرام قريح","https://www.aldiwan.net/poem22295.html","الطويل"],[46,"لقد غادر العيش هذا السواد","https://www.aldiwan.net/poem22441.html","المتقارب"],[46,"إذا طلع الشيب الملم فحيه","https://www.aldiwan.net/poem22607.html","الطويل"],[46,"أغارت عليهم خيول الزمان","https://www.aldiwan.net/poem22752.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85592","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85328","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39549","الطويل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72196","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116987","المتقارب"],[106,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[45,"خَيَالٌ يَعْتَرِيني في المَنَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=32026",""],[99,"أفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=17704",""],[31,"قُلْ للَّذِي يَهْوَى تَفَرُّقَ بَيْنِنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19010&r=&rc=273",""],[115,"خليلي ما لي لا ارى القلب موضعه","https://www.aldiwan.net/poem40907.html","عموديه"],[128,"هو الحق ما قال الحكيم فإنها","https://www.aldiwan.net/poem50484.html","الطويل"],[143,"إني وإن كنت في الأقوال محتكما","https://www.aldiwan.net/poem11816.html","البسيط"],[143,"أما وبديع ما تأتي يمينا","https://www.aldiwan.net/poem11835.html","الوافر"],[150,"لذكر رسول الله يرتاح من هدى","https://www.aldiwan.net/poem68592.html","الطويل"],[164,"بملتفتيه للمشيب طوالع","https://www.aldiwan.net/poem67832.html","الطويل"],[181,"أرى غدر ليلى يا خليلى حاملي","https://www.aldiwan.net/poem59057.html","الطويل"],[185,"لقد قدح الشيب في جانبي","https://www.aldiwan.net/poem14095.html","المتقارب"],[185,"بكم آل وحي الله يفتخر المجد","https://www.aldiwan.net/poem14508.html","الطويل"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[189,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[199,"تمايل دهرك حتى اضطرب","https://www.aldiwan.net/poem45666.html","المتقارب"],[211,"أموج البحر أسعفني فإني","https://www.aldiwan.net/poem46226.html","الوافر"],[223,"مضت أشهر نذرت للمطر","https://www.aldiwan.net/poem39700.html","المتقارب"],[235,"قفوا تعجبوا من سوء حالي ومن ضري","https://www.aldiwan.net/poem31944.html","الطويل"],[237,"يا أيها المولى الهمام","https://www.aldiwan.net/poem19073.html","مجزوء الرجز"],[261,"هلما نحييها ربى وربوعا","https://www.aldiwan.net/poem38241.html","الطويل"],[270,"أرى علمنا والمدعون بنوه","https://www.aldiwan.net/poem35066.html","الطويل"],[270,"إلام تعالج الأسد القيودا","https://www.aldiwan.net/poem35176.html","الوافر"],[270,"وقفت على الأمواج أبكي وأشتاق","https://www.aldiwan.net/poem35597.html","الطويل"],[275,"لقد غضبت حتى على السمط نخوة","https://www.aldiwan.net/poem25428.html","الطويل"],[279,"دع العيس في طي الفلا تبلغ المدى","https://www.aldiwan.net/poem2650.html","الطويل"],[280,"لقد غال نبلك يا نابل","https://www.aldiwan.net/poem60706.html","المتقارب"],[305,"رنت بفواتر الأجفان سكرى","https://www.aldiwan.net/poem56517.html","الوافر"],[320,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[337,"لعمري لا أنسى وإن طال عهدنا","https://www.aldiwan.net/poem45297.html","الطويل"],[364,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[409,"فيا أخا العزم يطوي البيد منصلتا","https://www.aldiwan.net/poem32225.html","البسيط"],[432,"يا حافظا تشهد أخلاقه","https://www.aldiwan.net/poem12532.html","السريع"],[458,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[461,"لقد غنيت بالقيل من آل هاشم","https://www.aldiwan.net/poem15652.html","الطويل"],[464,"لقد غاض بحر العلم بعد أخي العلم","https://www.aldiwan.net/poem3167.html","عموديه"],[464,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[464,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[464,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[465,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[477,"وفيت لمن أحبهم فخانوا","https://www.aldiwan.net/poem15198.html","الوافر"],[477,"أعن أرض الغميم لمحت نارا","https://www.aldiwan.net/poem15207.html","الوافر"],[477,"على البان قمرية تسجع","https://www.aldiwan.net/poem15215.html","المتقارب"],[482,"أسحر السحر في جفن الغزال","https://www.aldiwan.net/poem24467.html","عموديه"],[504,"أراك ترى حالي وما تترحم","https://www.aldiwan.net/poem38409.html","الطويل"],[514,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[514,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[514,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[514,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[515,"ليالي بالفسطاط من شاطئي مصر","https://www.aldiwan.net/poem12144.html","الطويل"],[527,"أيدري السيف أي فتى يبيد","https://www.aldiwan.net/poem45970.html","الوافر"],[538,"ألا إنه يوم به الدهر يشهد","https://www.aldiwan.net/poem48238.html","عموديه"]],"verses":[["لَقَد غَدَرَ الأَظعانُ يَومَ سَويقَةٍ","وَيَدمى لِذِكرِ الغادِرينَ بَناني",0,"ي",1,0],["لَقَد غَرَّبَتني حُظوَةُ الفَضلِ عَنكُمُ","وَإِن جَمَعَت أَعراقَنا نَبَعاتُها",1,"ت",3,0],["لقدْ غَدَتِ الوِزارةُ منْكَ تُزْهى","بمَنْ رقّتْ سَجاياهُ وَراقا",2,"ق",2,0],["لَقَد غُرِسوا غَرسَ النَخيلِ تَمَكُّناً","وَما حُصِدوا إِلّا كَما حُصِدَ البَقلُ",3,"ل",1,0],["لقد غاظني عند الشروق هياجها","كما سرّني عند الغروب هجوعها",4,"ع",3,0],["لقد غَمِطوا حق النساء فشدّدوا","عليهنّ في حبس وطول ثواء",5,"ا",2,0],["لَقَد غَرَّ القُيونُ دَماً كَريماً","وَرَحلاً ضاعَ فَاِنتُهِبَ اِنتِهابا",6,"ب",2,0],["لَقَد غادَروا بِالعيصِ عِلقَ مَضِنَّةٍ","وَلَم تَرَ عَيني مِثلَهُ عِلقَ لابِسِ",7,"س",1,0],["لَقَد غادَروا في اللَحدِ مَن كانَ يَنتَمي","إِلى كُلِّ نَجمٍ في السَماءِ مُحَلِّقِ",8,"ق",1,0],["لَقَد غَيَّبُوا بِرَّاً وصِدقاً ونَائِلاً","عَشِيّةَ وَارَاكَ الصَّفِيحُ المُنَصَّبُ",9,"ب",1,0],["لَقَد غَضِبَت جَهلاً سُلَيمٌ سَفاهَةً","وَطاشَت بِأَحلامٍ كَثيرٍ عُثورُها",10,"ر",3,1],["لَقَد غَيَّبوا حِلماً وَعِلماً وَرَحمَةً","عَشِيَّةَ عَلَّوهُ الثَرى لا يُوَسَّدُ",11,"د",1,0],["لقد غرَّت الدُّنيا بخدعة حربها","فما أكثر القتلى وما أرخص الأسرى",12,"ر",2,0],["لقد غدت فكر الأمداح جائزة","بين التفاصيل من نعماك والجمل",13,"ل",1,0],["لقد غدا يُثنى به شعرُنا","أضعاف ما يثنى به المجمر",14,"ر",1,0],["لقد غُشّ فيك أبٌ غافلٌ","فما دُهمةٌ فيك لم تُغشَش",15,"ش",1,0],["لَقَد غَدَوتَ عَلى النَدمانِ لا حَصِرُ","يُخشى أَذاهُ وَلا مُستَبطَأٌ زَمِرُ",16,"ر",1,1],["لقد غاب من تهوين مرأى وجوهِهم","كأنهم زهر النجوم الغوارب",17,"ب",1,0],["لَقَد غَيَّبوا فيكَ أَمضى السُيوفِ","فَهَل أَنتَ يا قَبرُ أَوفى الغُمود",18,"د",1,0],["لقد غَرَّهم متنٌ من السيف ليِّنٌ","فَهلّا نهاهم حدُّهُ وهو مذروبُ",19,"ب",1,0],["لَقَد غادَرتِ في جَسَدي سَقاماً","بِما في مُقلَتَيكِ مِنَ السَقامِ",20,"م",1,0],["لَقَد غَشِيَتنا ظُلمَةٌ بِعدَ فَقدِكُم","نَهاراً وَقَد زادَت عَلى ظُلمَةِ الدُجى",21,"ا",1,0],["لَقَد غَرَّتِ الدُنيا قُروناً كَثيرَةً","وَأَتعَبَتِ الدُنيا قُروناً وَأَنصَبَت",22,"ت",1,0],["لَقَد غَمَرَتني مِن أَياديكَ أَنعُمٌ","مَلَكتَ بِها رِقّي وَإِن أَكثَرَت مُلكي",23,"ك",2,0],["لقد غفلَتْ صروفُ الدهر عني","وبتُّ منَ الحوادثِ في أمانِ",24,"ن",1,1],["لقد غَرَّ الهُنَيْدُ بني جُذَامٍ","فما للقومِ مِمّا جَرَّ واقِ",25,"ق",1,0],["لقد غَرَّنَا كَيْما يَفُوزُ بِمَالِهِ","فحاقَ بنا من إثمِهِ ما تَعَمَّدا",26,"د",2,0],["لَقَد غادَرَت حَزماً وَبِرّاً وَنائِلاً","وَلُبّاً أَصيلاً خالَفَتهُ المَجاهِلُ",27,"ل",1,0],["لَقَد غَرَّني مِن جَعفَرٍ حُسنُ بابِهِ","وَلَم أَدرِ أَنَّ اللُؤمَ حَشوُ إِهابِهِ",28,"ه",1,1],["لَقَد غَرَّتِ الدُنيا بَنيها بِمَذقِها","وَإِن سَمَحوا مِن وُدِّها بِصَريحِ",29,"ح",1,0],["لَقَد غادَرَ العَيشُ هَذا السَوادَ","يُعاني مِنَ الدَهرِ بيضاً وَسودا",30,"د",2,1],["لَقَد غابَ عَن فَودَيكَ خَمسينَ حَجَّةً","فَأَهلاً بِهِ لَمّا دَنا وَتَسَوَّرا",31,"ر",2,0],["لَقَد غَرَّني أَمَلٌ في الحَياةِ","كَأَنّي بِما يَفعَلُ الدَهرُ غِرُّ",32,"ر",1,0],["لَقَد غمطوا بغدادَ في شعرائها","وَقالوا جلال الشعر أَجمع في مصر",33,"ر",1,0],["لَقَد غاظَكَ الدهر حَتّى ودد","تَ أنك من أَهله تنقم",34,"م",1,0],["لقد غمر الأكواخَ فوق صخوره","ولجَّ بها في موجه المتزائرِ",35,"ر",1,0],["لقد غرقوا في إثر أكواخهم به","وما لمسوا من حكمِه عفوَ قادرِ",35,"ر",1,0],["لقد غادروا حزماً وعزوماً ونائلاً","وصبراً على اليومِ العبوسِ القماطرِ",36,"ر",1,0],["لَقَدْ غَبَرَتْ حِقَبٌ لاَ تُعَدُّ","يِدُولُ النَّعِيمُ بِهَا وَالشَّقَاءْ",37,"ا",2,0],["لقد غيّب القبرُ في لحدهِ","وقاراً نبيلا وبراً ودنيا",38,"ن",3,0],["لقد غَّض من شأن العمامةِ معشرٌ","فَشِدتَ لها بين السماكين مقعدا",39,"د",2,0],["لَقَدْ غادَرْتِ في قَلبي سَقَاماً،","بِما في مُقلَتَيكِ منَ السّقامِ",40,"م",1,0],["لقد غَمَرَ الفَجْرُ نهديْكِ ضوءاً","فَعُودي إلى أُمِّكِ الغافلَهْ",41,"ل",2,0],["لَقَدْ غَنِيَتْ نَفْسي، وأَنْتَ بِهَمِّها،","فَقَدْ جَعَلَتْ، والحَمْدُ لِلَّهِ، تَذْهَلُ",42,"ل",1,0],["لقد غبت يا نور العيون تحجبا","متى فجرك الوضاح ابصر مطلعه",43,"ع",2,0],["لقد غُيِّبُوا واللهِ في حُفَرِ البِلَى","فلم يدْرِ مَثْوى شيخِها وَصَبِيهَا",44,"ي",3,0],["لَقَد غَدا بِكَ هَذا الدَهرُ مُحتَلِياً","فَعادَ بَعدَ عُلُوِّ السِنِّ مُحتَلِما",45,"م",2,0],["لَقَد غادَرتَ بِالإِحسانِ بَيني","وَبَينَ النائِباتِ نَوىً شَطَونا",46,"ن",2,0],["لَقَد غابَ نورُ الشَمسِ في نورِ صَدرِهِ","كَما دَقَّ قَدرُ الكَونِ عَن عُظمِ قَدرِهِ",47,"ه",1,0],["لَقَد غَيَّبَت أَثراؤُهُ جِسمَ ماجِدٍ","جَليلٍ إِذا اِلتَفَّت عَلَيهِ المَجامِعُ",48,"ع",1,0],["لَقَد غَدَرَت إِنّا إِلى اللهِ بَعدَما","وَفَينَا وَكُنّا كُلَّ يَومِ نَشوقُها",49,"ه",2,0],["لقد غَضَّ منك فهَلاّ لبستَ","علىرغمه حُلَّةَ الخاضِب",50,"ب",1,0],["لقد غادرتْ آثارُ عزمِك سِنْبِسا","نذيرا لمن قد غَرَّه ال