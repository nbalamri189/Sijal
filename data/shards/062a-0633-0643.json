tps://poetry.dctabudhabi.ae/diwan/poem/45106","الرجز"],[4691,"فواكه القلب","https://www.poetsgate.com/ViewPoem.aspx?id=74525",""],[4691,"جمالها خريطة للهوى","https://www.poetsgate.com/ViewPoem.aspx?id=186003",""],[4578,"قلَ الريحان في الورد أجاد","https://www.poetsgate.com/ViewPoem.aspx?id=49392",""],[3271,"لم يطب للنبوغ فيك مقام","https://www.poetsgate.com/ViewPoem.aspx?id=103537",""],[5111,"فَلسَفَاتٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212317",""],[5111,"وَلَهٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212602",""],[5121,"لُغَةُ الرَّبِيِع","https://www.poetsgate.com/ViewPoem.aspx?id=68726",""],[5121,"نَوْمَةُ مَلاَك","https://www.poetsgate.com/ViewPoem.aspx?id=174100",""],[5122,"حال القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=27775",""],[5376,"علي الأذربيجاني ونينو الجورجية","https://www.poetsgate.com/ViewPoem.aspx?id=202463",""],[5461,"لو نسيت","https://www.poetsgate.com/ViewPoem.aspx?id=5064",""],[5642,"جهرة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=125040",""],[5798,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=139103",""],[5875,"مشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=12145",""],[6069,"خير ما أصبحت مخلوع العذار","https://www.poetsgate.com/ViewPoem.aspx?id=105669",""],[6124,"وحدنا كنا","https://www.poetsgate.com/ViewPoem.aspx?id=174665",""],[4990,"نحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6607&r=&rc=151",""]],"verses":[["تَسكُنُ الضَوضاءُ عَنهُ هَيبَةً","مِثلَ ما لَبَّدَتِ المُزنُ الغُبارا",0,"ر",2,0],["تُسِكرُ الخمرُ شاربِيها وخمرُ ال","ريق يصحو بشربها المستهام",1,"م",1,0],["تَسكُتُ إِذ نَشكو شَحاريرُها","كَأَنَّما التَغريدُ يُؤذيها",2,"ي",3,0],["تَسكُبُ الدَمعَ عَلى سَعدٍ دَماً","أُمَّةٌ مِن صَخرَةِ الحَقِّ بَناها",3,"ا",3,0],["تَسكُنُ العاصِفاتُ عَن جانِبَيهِ","وَتَطيرُ الجِبالُ في هَبَواتِهْ",4,"ت",2,0],["تَسْكُنُ دُرّاتُهَا البُحُورَ وذِي","تَسْكُنُ للحُسْنِ رَوْضةً أُنُفَا",5,"ف",2,0],["تسكر الكأس حين تسكرها الكأ","س وتسقي الرحيق أحلى وأفضل",6,"ل",1,0],["تُسِكرُ الخمرُ شاربِيها وخمرُ الرْ","ريق يصحو بشربها المستهام",7,"م",1,0],["تسكت إذ نشكو شحاريرها","كأنّما التغريد يؤدّيها",8,"ي",3,0],["تَسكُبين الشِعر الطَروبِ مِن العَي","نِ وَفي النَفسِ غَيرُ ما تَسكُبينَه",9,"ه",1,0],["تسكبُ الدَّمعَ عَلَى تلك الطُّلولْ","أَيُّ شيءٍ هو أَدعى لِلذُّهولْ",10,"ل",1,0],["تسكعت في حيرة إلا أجو","زمنها إلى عضد أو وزرز",11,"ر",2,0],["تسكن ريح الذنب منك لطائفٍ","ولو أنما ريح الذنوب عصوف",12,"ف",1,0],["تُسكِر مِن تسنِيمها صاحياً","وتُطرِبُ الكاتبَ والقاريا",13,"ي",2,0],["تسكرُ منه صاحياً","إن أسكرتك القرقفُ",14,"ف",1,0],["تسكُنُ أحشائي إلى حِفاظكم","سكونَ أجفاني إلى رقادِها",15,"د",3,0],["تُسَكّنُنِي المَهابَةُ عَنهُ طَوراً","وَيُؤمِنني وَفاؤُك أَن أَهابا",16,"ب",2,0],["تَسكُنها في صِحّةٍ فَلتَدم","حَمداً لِمَن أَورَثَكم أَرضَهُم",17,"م",1,0],["تُسكبُ مِن زقٍّ لَنا مُسنَدٍ","اسحَم رشاش لَهُ قَرقَرهْ",18,"ر",2,0],["تسكرني أوصافه كأنني","عوطيت منهن السلاف الرائقا",19,"ق",2,0],["تَسَكَّعَ في العَمايَةِ لَم يُوَقِّر","مُهَذَّبَةً وَلَم يَرحَم صَغيرا",20,"ر",2,0],["تَسكر النفس منه لثماً وشمّاً","فاذا غبتِ لم يغب منك طيب",21,"ب",1,0],["تسكن مثل العروس في غرف","كأنها تحفة من التحف",22,"ف",1,0],["تسكرنا عذوبة من لفظه","إذا أدار لفظه جريالها",23,"ل",3,0],["تسكب الدمع دما مهما رأت","رأسك السامي على لدن ثقيف",24,"ف",1,0],["تسكع نشؤك منهمكا","بكل طريق من الطرق",25,"ق",1,0],["تُسكَنُ مَع سَعادَةٍ","وَجَمعٍ أَهلِ الكَرَم",26,"م",1,0],["تسكنين السماء هلا نزلتِ","الأرض يوماً لتلهمينا الصعودا",27,"د",2,0],["تسكبُ عيناها رضاب الهوى","فتكبر اللهفة لا تصغرُُ",28,"ر",1,0],["تسكر السمع أحاديث له","وقعها اللطف من صوب العهاد",29,"د",1,0],["تسكب السحر من شفاهٍ عليها","مصرع السحر لهفةٌ وأوامُ",30,"م",1,0],["تسكب العطرَ والخمائلُ صفرٌ","مات في الأيكِ نورُها البسّام",30,"م",1,0],["تسكب البرءَ من جراحٍ عليها","تُرعشُ العمر شكوةٌ وسقامُ",30,"م",1,0],["تَسْكُبُ الْمَعْنَى كُؤُوسًا","فِيْ شِغَافِ الرُّوْحِ يَحْلُو",31,"ل",2,0],["تُسْكِبُ المَاضِي عَلَى لَوْحَاتِهَا","شَكَّلَتْ مِنْ حلمها فجرا تنامى",32,"م",2,0],["تَسْكُبْنَ أَوْعِيَةَ الرَّحِيِقِ كَأَنَّمَا","تَسْكُبْنَهَا بِأَصَابِعِ الأَحْلاَمِ",33,"م",1,0],["تَسْكُبُ الْوَرْدَ فِي خَرِيِفِ الْمعَانِي","فَتُنَدِّي رَحِيِقَهَا الأَسْمَاءُ",34,"ا",2,0],["تسكن لها في خيمة(ن) مالها أرواق","..حر وجليّد والعواصف شديده",35,"د",2,0],["تسكنُ القلبَ لم تغادرْه طوعاً","وحصونٌ من حولِها وقلاعُ",36,"ع",1,0],["تسكب الدمعه وتظمى نظرتك","مشهد النظرة وهي تظمى يروع",37,"ع",1,0],["تَسْكُنُ الأسوَارُ وَ الحَارَاتُ في","جَوْفِهِ رَغْمَ ابتِعَادِ المَوْقِع",38,"ع",1,0],["تسكنُها أميرةٌ لا أمسَ فيها أو غدُ","فتحتُ بابها على مَهْلٍ وفيها أنشدُ",39,"د",1,0],["تسكن بنبض الدم والقلب لك بيت","وفياض عشق الروح نبضك ثمرها",40,"ر",3,0],["تسكر الألباب من ألفاظه","فهي تغني الشرب عن شرب العقار",41,"ر",1,0],["تَسكنُ الكفَّ التي كانتْ عمادي","تجرحُ القلبَ الذي قد كانَ عهْدَا",42,"د",2,0],["تسكن روحاً واحدةً مصابةً","بدوار البحث عن ذهب الوجود.",43,"د",1,0]]}