om/ViewPoem.aspx?id=205068",""],[5561,"خذني إليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=206453",""],[5689,"كم بذا بعاصمة الأنوار من لهب","https://www.poetsgate.com/ViewPoem.aspx?id=143425",""],[5948,"أمُّ سلمٍ بذاك أعلمُ شيء","https://www.poetsgate.com/ViewPoem.aspx?id=100598",""],[5970,"ميز الأقوام في الدهر الهمم","https://www.poetsgate.com/ViewPoem.aspx?id=130661",""],[6093,"إنَّ للمجد بقِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=181652",""],[6260,"ذكرى الهجرة النبوية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68351&r=&rc=43",""]],"verses":[["لا يَصحَبُ الأَيّامَ إِلّا راغِباً","في وَصلَتي أَو سائِلاً عَن شاني",0,"ن",2,0],["لا يُصدِرُ الراياتِ حَ","تّى يَعتَصِرنَ دَماً جَمرَما",1,"م",2,0],["لا يَصحَبُ الأَغمادَ مَن لَم تَزَل","سُيوفُهُ في حُلَلٍ مِن دَمِ",2,"م",1,0],["لا يُصلِحُ الناسَ لِأَربابِهِم","غَيرُ بَياضِ السَيفِ وَالدِرهَمِ",2,"م",1,0],["لِأَيِّ صَنائِعِهِ أَشكُرُ","وَفي أَيِّ أَخلاقِهِ أَنظُرُ",3,"ر",1,1],["لا يَصلُحُ الناسُ فَوضى لا سَراةَ لَهُم","وَلا سَراةَ إِذا جُهّالُهُم سادوا",4,"د",3,1],["لا يَصرِفُ السُحتوتَ إِل","لا وَهوَ غَيرُ مُخَيَّرِ",5,"ر",1,0],["لا يَصبِرونَ عَلى ضَيمٍ يُحاوِلُهُ","باغٍ مِنَ الإِنسِ أَو طاغٍ مِنَ الجانِ",6,"ن",1,0],["لا يُصدِرُون الأُمُورَ مُبهَلَةً","ولا يُضِيعُون دَرَّ ما حَلَبُوا",7,"ب",3,0],["لا يَصطَفونَ مُذيعاً في مَجالِسِهِم","حاشا جَلالُهُم مِن ذَلِكُم حاشا",8,"ش",2,0],["لا يصغرنَّ لديك قدرُ خطيئة","إن المحاسبَ سجنُه السّجين",9,"ن",1,0],["لا يَصطَلينَ دُخانَ النارِ شاتِيَةً","إِلّا بِعودِ يَلَنجوجٍ عَلى فَحَمِ",10,"م",1,0],["لا يصون الورد الجميل من الجنى","سياج له من الأشواك",11,"ك",1,0],["لا يصل الشعب الى","الغاية الا ان وثب",12,"ب",1,0],["لِأَيِّ صُروفِ الدَهرِ فيهِ نُعاتِبُ","وَأَيَّ رَزاياهُ بِوِترٍ نُطالِبُ",13,"ب",1,1],["لا يُصرَمُ المُحدَثُ الكَهامُ وَإِن","أَخلَصَهُ الهالِكِيُّ مِن جَرَبِه",14,"ب",2,0],["لا يَصِلُ الصاحِبُ الأَخَصُّ إِلى","مَطوِيِّ سِرٍّ أَجَنَّهُ خَلَدُه",15,"د",2,0],["لا يُصلِحُ الثَغرَ إِلّا كُلُّ مُحتَنِكٍ","ضَخمُ الدَسيعَةِ أَو صَمصامَةٌ ذَكَرُ",16,"ر",1,0],["لا يُصَدُّ الثَّناءُ عَنه ولا تَرْ","غَبُ عن وِرْدِهِ النُّفوسُ الحِرارُ",17,"ر",1,0],["لا يُصلِحُ الواعِظُ قَلبَ اِمرءٍ","لَم يَعزِمِ اللَهَ عَلى رُشدِهِ",18,"د",2,0],["لا يصحّ البقاءُ في دار دنيا","وَمَتى صحّ في النّهَى المستحيلُ",19,"ل",1,0],["لا يَصرَعَنَّكَ وَهمٌ بِتَّ تَرقُبُهُ","إِنَّ التَّوَهُّمَ حَتفُ العاجِزِ الوَخِمِ",20,"م",1,0],["لا يَصلحُ الأَمرُ إلا في مَدارجهِ","ولا تَطولُ الذُّرَى إلا بآساسِ",21,"س",1,0],["لا يَصعُبُ الأَمرُ يوهي الشَعبُ جانِبَهُ","بِمَنكِبَيهِ وَيَرميهِ بِتَذليلِ",22,"ل",1,0],["لا يَصُمْ عن طعامه في فلسطي","نَ يموت الزعيمُ لولا طعامُهْ",23,"م",2,0],["لا يَصعُبُ الأَمرُ إِلّا رَيثَ يَركَبُهُ","وَلا يَبيتُ عَلى مالٍ لَهُ قَسَمُ",24,"م",1,0],["لا يَصبِرونَ وَلا تَزالُ نِسائُهُم","تَشكو الهَوانَ إِلى البَئيسِ الأَبأَسِ",25,"س",1,0],["لا يُصلِحُ الجَبّارَ إِلّا ضَربَةٌ","تَشفيهِ مِن خَبَلٍ بِهِ وَجُنونِ",26,"ن",1,0],["لا يُصْدرونَ نحورَها يومَ الوغى","إلاّ كما صَبَغَ الخدودَ حياء",27,"ا",2,0],["لا يَصرِفَنَّكَ عَن قَصفٍ وَإِصباءِ","مَجموعُ رَأيِ وَلا تَشتيتُ أَهواءِ",28,"ا",2,1],["لا يَصُدَّنَّكَ لاحٍ","هُوَ عَن سُكرِكَ صاحِ",29,"ح",1,0],["لا يصيد الدهرَ إلّا","حمرَ وحشٍ أو نعاما",30,"م",2,0],["لا يُصابي عَلى الفُضولِ وَلا يُع","طي اِفتِخاراً لا خَيرَ في الفِخّيرِ",31,"ر",1,0],["لا يَصبِرونَ فَقيرٌ تَحتَ فاقَتِه","إِنَّ السَباريتَ جابَتها السَباريتُ",32,"ت",1,0],["لا يَصِلُ الرُّمْحُ إلى طَرْفِهِ","ولا إلى المُحْكَمِ مِنْ سَرْدِهِ",33,"د",2,0],["لا يصرف الهمَّ إلّا شدوُ محسنة","أَو منظرٌ حسنٌ تهواهُ أو قدحُ",34,"ح",1,1],["لا يصحَب الإنسانَ في قبرهِ","غيرُ التقى والعمََلُ الصالحُ",35,"ح",1,0],["لا يصرف (الفكر) في شيء فيخلفه","لأنه من فيوض الكشف ملآن",36,"ن",1,0],["لا يصدق الدين الا من يناصحه","ولا يتم بغير النصح ايمان",36,"ن",1,0],["لا يصدُقُ الحب إلا من يموت به","ما للهوى دون حسو الموت من قدر",37,"ر",1,0],["لا يصطفون مضيفاً بعْض سرّهم","حاشا جلالهم من ذلِكم حاشا",38,"ش",2,0],["لا يَصْرفُ السُّحْتُوتَ إلاَّ","وهوَ غيرُ مُخَيَّرِ",39,"ر",1,0],["لا يَصطَفي القَلب مِمَن رُحت تُبصرهُ","إِلّا ذَوات الَّتي تُرضيكَ شيمتها",40,"ه",2,1],["لا يصافِى الحرّ إلا مثلَه","هل ترى الأحرارَ صافتهم سِفلْ",41,"ل",1,0],["لاَ يَصِحُّ القًَرِيضُ دُونَ بَيَانٍ","ومَعَانٍ بَدِيعَةٍ وبَدِيعِ",42,"ع",1,0],["لا يَصطَلِ الرومُ جَهلاً ما يَشُبُّ لَهُم","رَبُّ العُلى لَم تُشَب وَالجودِ لَم يُشَبِ",43,"ب",1,0],["لا يصون الحليم فيها نهاه","ساحة الحرب ليس فيها حليم",44,"م",1,0],["لا يُصْلِتُ الْبَطَلُ الْمُقارِعُ سَيْفَهُ","إِلاّ إِذا ما الرُّمْحُ قَلَّ غَناؤُهُ",45,"ا",3,0],["لا يَصْحَبُ الدَّهْرُ مِنْهُمْ طُولَ ما ذُكِرُوا","إِلاّ الثَّناءُ وَإلاّ طِيبُ أَخْبارِ",46,"ر",1,0],["لا يُصبِحُ المَرءُ ذو اللُبِّ الأَصيلِ وَلا","يُمسي عَلى آلَةٍ إِلّا لَهُ عَمَلُ",47,"ل",1,0],["لا يصلح الدهر من مفاسده","الا ليسلمه الى العطب",48,"ب",1,0],["لا يصحان إن تأملت فيه","لفوات الشروط والأحكام",49,"م",1,0],["لا يصدق النظم عليه ولا","يدخله المنصف في حده",50,"د",2,0],["لا يصحبُ المرءَ مما كان يملِكُهُ","في ظُلمةِ اللَّحدِ إلاّ خِرقَةُ الكَفَنِ",51,"ن",1,0],["لا يصلح الجاهل المغرور في نظر","إلاَّ إذا كانَ مصروفاً عن النظر",52,"ر",1,0],["لا يَصلحُ الأمرُ على غيركم","لا عارض منه ولا راتبُ",53,"ب",1,0],["لا يصعب الأمر إلا ريث يركبه","وكل أمر سوى الفحشاء يأتمر",54,"ر",1,0],["لا يصغر الرجل الكبير","بعشرةِ الرَّجل الصغيرِ",55,"ر",1,1],["لا يَصرفُ الإنسانُ قيمةَ دِرهَمٍ","عَبَثاً ويَصرِفُ عُمرَهُ الغالي سُدَى",56,"د",2,0],["لا يصَطلِي نارَ إبراهيمَ مُجتهِدٌ","ولا تنالُ عُلاهُ كَفُّ مُلتمِسِ",57,"س",1,0],["لا يَصحَبُ المرءُ شيئاً من غِناهُ ولو","سَلَّمْتُ ذاك لكانَتْ صُحبَةُ العَدَمِ",58,"م",1,0],["لا يَصل الفكرُ لَها","فكيفَ كفُّ اللاَّمس",59,"س",1,0],["لا يَصْدُقُ التَّخْوِيفُ مِنْ وَاشٍ سَعَى","حَسَداً وَلاَ قَوْلُ الأَماني يَكْذِبُ",60,"ب",1,0],["لا يَصِلُ الحَبلَ بِالصَفاءِ وَلا","يُكسِبُهُ قُوَّةً إِذا اِنجَذَما",61,"م",2,0],["لا يصلح القومَ الا مقسط يقظ","يجرى على سنن لانصاف ما خبطا",62,"ط",2,0],["لا يَصرِفَنَّكَ عَن لَهوٍ وَعَن دََدَنٍ","نَهيُ النُّهاةِ فَطيبُ العَيشِ في الدَدنِ",63,"ن",1,0],["لا يَصُدُّ الملاحَ عن صِلَةِ العُشّا","قِ إلا القَتيرُ والإقتارُ",64,"ر",1,0],["لا يصلحون له ولا يدَعونه","تُعنَى به الأكفاء والأقران",65,"ن",1,0],["لا يصيرُ الأحمقُ عن طبعه","حتى يلاقى الموتَ لا يصبِر",66,"ر",1,0],["لا يصدق الكذابُ لو أنه","طول المدى يُضربُ في حبسه",67,"س",2,0],["لا يصلح الملكُ إلا بالسياسة معْ","عساكرٍ وصلاحُ العسكر المالُ",68,"ل",1,1],["لا يصبَرنْ ذو الرأى يوماً على","عجوز سوءٍ لم تزلْ مُذْنِبَه",69,"ب",2,0],["لا يصنعُ القُبْحُ الجَمَالَ ولا الصِغَا","رُ ، بأيِّ حَالٍ ، يُصبِحُونَ كِبَارا",70,"ر",2,0],["لا يَصبِرونَ عَلى أَذىً مَهما يَكُنْ","وَالحُرُّ إِن بَسَمَ الأَذى لَم يَصبِرِ",71,"ر",1,0],["لا يَصبرُ الناسُ على كلِّ ذا","من ذي علاءٍ كيف من نازل",72,"ل",1,0],["لاَ يُصْدِرُونَ أحِبَّاهُمْ عَلَى ظَمَإ","وَيُورِدُونَ عِدَاهُمْ مَوْرِدَ الهُونِ",73,"ن",1,0],["لاَ يَصْلِهَا جارِي وَلا أَضْيَافِي","ذَاكَ التَغاني عَنْكَ وَالتَشَافِي",74,"ف",2,0],["لا يصل العبد على الحرية","ما بقيت من نفسه بقية",75,"ه",1,0],["لا يَصبِرونَ عَلى ضيمِ المُحب لَهُم","وَيَصبِرونَ عَلى الإيفاءِ بِالذِّمَمِ",76,"م",1,0],["لا يَصْلُحُ الْبَغْلُ إِلاَّ","لِلْكَدِّ وَالأَسْفارِ",77,"ر",1,0],["لا يصنع الله للمستعمرين فكم","يلقى بنو النيل من جرّاء ما صنعوا",78,"ع",3,0],["لا يصدُقُ الحب إلا من يموت به","ما للوى دون حسو الموت من قدر",79,"ر",1,0],["لا يصلح القلوب إلا اللّه","بحق لا إله إلا اللّه",80,"ه",1,0],["لا يُصَلّي وَلا يَصومُ وَلا يَق","رَأُ حَرفاً مِن مُحكَمِ القُرآنِ",81,"ن",1,0],["لا يُصلِح السُلطان إِلّا شِدَّة","تَغشى البَريءَ بِفَضلِ ذَنبِ المُجرِمِ",82,"م",1,0],["لا يصاد الوفا بفخ التواني","فغزال الصفا من السهم أمرق",83,"ق",1,0],["لا يَصحَبُ الإِنسانَ مَن","دُنياهُ إِلّا عَمَلُه",84,"ل",2,0],["لا يَصرف الجُندُ حَتّى يَستَضىءُ بِهِم","نَهباً عَظيماً وَيَحوي مُلكَ جَبارِ",85,"ر",1,0],["لا يُصبِحُونَ حَليبَ الدَرِّ ضَيفَهُمُ","أَو يُمزَجَ الدَرُّ لِلضِيفانِ بِالدُرَرِ",86,"ر",1,0],["لا يصبحون اذا انتضوا بيض الظبا","وشيا القنا غير المنايا السود",87,"د",1,0],["لا يَصعُبُ الأَمرُ إِلّا رَيثَ يَركَبُهُ","مُصَمِّمُ العَزمِ لا يُصغي إِلى العَذَلِ",88,"ل",1,0],["لا يَصدقُ القولَ في صَدٍّ ولا صِلَةٍ","ولا يدوم على وُدٍّ ولا شَنَفِ",89,"ف",1,0],["لا يصل الريح إليه ولا","أحكم للريح من سده",90,"د",2,0],["لا يَصبِرونَ عَنِ الطَعامِ فَما لَهُم","صَبَروا لِحُكمِ الأَجنَبِيِّ وَسَلَّموا",91,"م",3,0],["لا يصلح الناس إلا السيف إذ فتنوا","لهفي عليك ولا حجاج للدين",92,"ن",1,1],["لا يصدُّه الفنا عن البِقا","كما البقا لا يصدُّ عن فنا",93,"ن",2,0],["لا يصلحون بدونكم فَكأنَّما ال","بَشر الجسوم وَأَنتُم الأَرواح",94,"ح",1,0],["لا يُصلِحُ العَبدَ إِلّا قَرعُ هامَتِهِ","وَالحُرُّ يَكفيهِ أَن تَلقاهُ مَعزولا",95,"ل",2,0],["لا يصدِفُ الشرقُ عن نعمَى رفَعت بها","رأسَ الهلالِ ونجم الغربِ منحدر",96,"ر",1,0],["لا يصح الصفو إن لا","هامة الجرة تكسر",97,"ر",1,0],["لا يصلحون لغير أخدْ دمائهم","لذوي المشاعر من ضعاف الناس",98,"س",1,0],["لا يصلحون لغير اخذ فلوسهم","لذري المدارك من ذوي الإفلاس",98,"س",1,0],["لا يصلح الغرب إلا حين نفتحه","حتى يعيد لدينا سيرة الخدم",99,"م",1,0],["لا يصف الشارب اسرار الطلا","إلا إذا في لفظه تلجلجا",100,"ج",2,0],["لا يصرفني عنها أليم الفرض","فاترك عذلي تربح ثواب الفرض",101,"ض",1,0],["لاَ يَصْدِفُونَ عَنِ الْوَغَى بِنحورهم","فِي كُلِّ سَابِغَةٍ كَلَوْنِ الْعِظْلِمِ",102,"م",1,0],["لا يصدع الزبد الجفاء سفينةً","والبحر طوع رغائب الملّاح",103,"ح",1,0],["لا يصرف الهم عنه غير ناجية","عنس أمون عليها المال معكوم",104,"م",1,0],["لا يصدر الطرف عن جيداء منعمة","إلا امرؤ لم يكن في وجهه بصر",105,"ر",1,0],["لا يَصحبِ البِدعيُّ إِلّا مِثلَهُ","تَحتَ الدُخانِ تأَجُّجُ النيرانِ",106,"ن",1,0],["لا يصلحون لجودٍ","ولا لضربٍ وطعن",107,"ن",1,0],["لا يصحب الليث في الغابات ثعلبها","يوماً ولا يتآخى الباز والرخم",108,"م",1,0],["لا يصحب البشر قلباً رعته أبداً","ولو تعلل بالصرف السلافيّ",109,"ي",1,0],["لا يَصدَعَنَّكُمُ قَرمٌ يَسوقَكُمُ","إِلى سَفينِكُمُ في خائِرِ المُهَجِ",110,"ج",1,0],["لا يَصلح الدينُ إِلّا بِالسَخا وَأَتى","إِنَّ السَخاءَ مِنَ الإيمانِ فَاِعتَبِر",111,"ر",1,0],["لا يصد الزمان بيني فإني","ممتط غارب النوائب نيبا",112,"ب",2,0],["لا يصدق الشعراء في دعوى الهوى","والكذب محمود لهم مغفور",113,"ر",1,1],["لا يَصدِفونَ عِن الوَغى بِخُدودِهِم","في كُلِّ سابِغَةٍ كَلَونِ العِظلَمِ",114,"م",1,0],["لا يَصرِمُ الوُدَّ مِنّي بُعدُ دارِهُم","وَلا تَطاولُ هَذا الدَهرِ يُسليَني",115,"ن",2,0],["لا يصدقُ الشِّعرُ إلاّ حين