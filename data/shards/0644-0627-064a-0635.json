{"poems":[[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[53,"تأبى الليالي أن تديما","https://www.aldiwan.net/poem29749.html","مجزوء الكامل"],[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[53,"لأي صنائعه أشكر","https://www.aldiwan.net/poem30454.html","المتقارب"],[42,"لا يصلح الناس فوضى لا سراة لهم","https://www.aldiwan.net/poem50309.html","البسيط"],[86,"وافى كتابك يزدري","https://www.aldiwan.net/poem68852.html","مجزوء الكامل"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[64,"من سارروه فأبدى كل ما ستروا","https://www.aldiwan.net/poem67633.html","البسيط"],[51,"يا من هواه من القلوب مكين","https://www.aldiwan.net/poem66463.html","الكامل"],[29,"أتنكر الدار أم عرفان منزلة","https://www.aldiwan.net/poem6042.html","البسيط"],[89,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[89,"أيتها النفس اقترب","https://www.aldiwan.net/poem44672.html","مجزوء الرجز"],[43,"لأي صروف الدهر فيه نعاتب","https://www.aldiwan.net/poem9464.html","الطويل"],[45,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[45,"رنو ذاك الغزال أو غيده","https://www.aldiwan.net/poem63505.html","المنسرح"],[28,"يا قاتل الله ليلا كنت أحرسه","https://www.aldiwan.net/poem5145.html","البسيط"],[61,"لحظ عينيك للردى أنصار","https://www.aldiwan.net/poem51681.html","الخفيف"],[58,"يا مؤثر الدنيا على دينه","https://www.aldiwan.net/poem31106.html","السريع"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[105,"ممالك الشرق ما في الحق من باس","https://www.aldiwan.net/poem42109.html","البسيط"],[105,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[102,"حبذا لو يصوم منا زعيم","https://www.aldiwan.net/poem33022.html","البسيط"],[22,"يا عام قد كنت ذا باع ومكرمة","https://www.aldiwan.net/poem21654.html","البسيط"],[22,"ولقد رأيتك في النساء فسؤتني","https://www.aldiwan.net/poem21658.html","الكامل"],[52,"لمن القتيل وما تحللت الحبا","https://www.aldiwan.net/poem26617.html","الكامل"],[75,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[48,"لا يصرفنك عن قصف وإصباء","https://www.aldiwan.net/poem10400.html","البسيط"],[48,"أله بالبيض الملاح","https://www.aldiwan.net/poem62510.html","مجزوء الرمل"],[48,"رب ظبي كهلال","https://www.aldiwan.net/poem66281.html","مجزوء الرمل"],[50,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[46,"لا خير في المال أعطاه وأجمعه","https://www.aldiwan.net/poem22149.html","البسيط"],[46,"أحسن بالواجد من وجده","https://www.aldiwan.net/poem23628.html","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43907","البسيط"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116997","السريع"],[64,"الأهوال أمانات عند أهلها","https://www.poetsgate.com/ViewPoem.aspx?id=3098",""],[86,"وافَى كِتابُكَ يَزْدَرِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13064&r=&rc=19",""],[109,"لا يصطفي القلب ممن رحت تبصره","https://www.aldiwan.net/poem16712.html","البسيط"],[128,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[132,"رسم ربع بجانب الينبوع","https://www.aldiwan.net/poem54803.html","الخفيف"],[143,"سل المقادير ما أحببته تجب","https://www.aldiwan.net/poem11725.html","البسيط"],[211,"ما على الغادرين نسكب دمعا إن","https://www.aldiwan.net/poem46763.html","الخفيف"],[280,"يا حسنه قمرا وأنت سماؤه","https://www.aldiwan.net/poem60576.html","الكامل"],[280,"هي الديار فعج في رسمها العاري","https://www.aldiwan.net/poem60723.html","البسيط"],[322,"بانت سليمى وأقوى بعدها تبل","https://www.aldiwan.net/poem56346.html","البسيط"],[342,"تأملاتي تموج في عجب","https://www.aldiwan.net/poem55348.html","المنسرح"],[403,"أفتنا ما تقول إن قال زيد","https://www.aldiwan.net/poem33415.html","الخفيف"],[403,"ما طرق الطرف سوى سهده","https://www.aldiwan.net/poem33971.html","السريع"],[409,"لا تغبطن أهل بيت سرهم زمن","https://www.aldiwan.net/poem31869.html","البسيط"],[416,"هنيت هنيت بالإقدام والظفر","https://www.aldiwan.net/poem54155.html","الوافر"],[458,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[485,"إني أتتني لسان لا أسر بها","https://www.aldiwan.net/poem1121.html",""],[527,"لا يصغر الرجل الكبير","https://www.aldiwan.net/poem45962.html","مجزوء الكامل"],[562,"لا تجزعي يا نفس من حكم الردى","https://www.aldiwan.net/poem52894.html","البسيط"],[562,"بكل ظبية وحش ظبية الأنس","https://www.aldiwan.net/poem52905.html","البسيط"],[562,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[575,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[586,"من شاء بعد رضى الأحبة يغضب","https://www.aldiwan.net/poem17412.html","الكامل"]],"verses":[["لا يَصحَبُ الأَيّامَ إِلّا راغِباً","في وَصلَتي أَو سائِلاً عَن شاني",0,"ي",1,0],["لا يُصدِرُ الراياتِ حَ","تّى يَعتَصِرنَ دَماً جَمرَما",1,"م",2,0],["لا يَصحَبُ الأَغمادَ مَن لَم تَزَل","سُيوفُهُ في حُلَلٍ مِن دَمِ",2,"م",1,0],["لا يُصلِحُ الناسَ لِأَربابِهِم","غَيرُ بَياضِ السَيفِ وَالدِرهَمِ",2,"م",1,0],["لِأَيِّ صَنائِعِهِ أَشكُرُ","وَفي أَيِّ أَخلاقِهِ أَنظُرُ",3,"ر",1,1],["لا يَصلُحُ الناسُ فَوضى لا سَراةَ لَهُم","وَلا سَراةَ إِذا جُهّالُهُم سادوا",4,"د",3,1],["لا يَصرِفُ السُحتوتَ إِل","لا وَهوَ غَيرُ مُخَيَّرِ",5,"ر",1,0],["لا يَصبِرونَ عَلى ضَيمٍ يُحاوِلُهُ","باغٍ مِنَ الإِنسِ أَو طاغٍ مِنَ الجانِ",6,"ن",1,0],["لا يُصدِرُون الأُمُورَ مُبهَلَةً","ولا يُضِيعُون دَرَّ ما حَلَبُوا",7,"ب",3,0],["لا يَصطَفونَ مُذيعاً في مَجالِسِهِم","حاشا جَلالُهُم مِن ذَلِكُم حاشا",8,"ش",2,0],["لا يصغرنَّ لديك قدرُ خطيئة","إن المحاسبَ سجنُه السّجين",9,"ن",1,0],["لا يَصطَلينَ دُخانَ النارِ شاتِيَةً","إِلّا بِعودِ يَلَنجوجٍ عَلى فَحَمِ",10,"م",1,0],["لا يصون الورد الجميل من الجنى","سياج له من الأشواك",11,"ك",1,0],["لا يصل الشعب الى","الغاية الا ان وثب",12,"ب",1,0],["لِأَيِّ صُروفِ الدَهرِ فيهِ نُعاتِبُ","وَأَيَّ رَزاياهُ بِوِترٍ نُطالِبُ",13,"ب",1,1],["لا يُصرَمُ المُحدَثُ الكَهامُ وَإِن","أَخلَصَهُ الهالِكِيُّ مِن جَرَبِه",14,"ب",2,0],["لا يَصِلُ الصاحِبُ الأَخَصُّ إِلى","مَطوِيِّ سِرٍّ أَجَنَّهُ خَلَدُه",15,"د",2,0],["لا يُصلِحُ الثَغرَ إِلّا كُلُّ مُحتَنِكٍ","ضَخمُ الدَسيعَةِ أَو صَمصامَةٌ ذَكَرُ",16,"ر",1,0],["لا يُصَدُّ الثَّناءُ عَنه ولا تَرْ","غَبُ عن وِرْدِهِ النُّفوسُ الحِرارُ",17,"ر",1,0],["لا يُصلِحُ الواعِظُ قَلبَ اِمرءٍ","لَم يَعزِمِ اللَهَ عَلى رُشدِهِ",18,"د",2,0],["لا يصحّ البقاءُ في دار دنيا","وَمَتى صحّ في النّهَى المستحيلُ",19,"ل",1,0],["لا يَصرَعَنَّكَ وَهمٌ بِتَّ تَرقُبُهُ","إِنَّ التَّوَهُّمَ حَتفُ العاجِزِ الوَخِمِ",20,"م",1,0],["لا يَصلحُ الأَمرُ إلا في مَدارجهِ","ولا تَطولُ الذُّرَى إلا بآساسِ",21,"س",1,0],["لا يَصعُبُ الأَمرُ يوهي الشَعبُ جانِبَهُ","بِمَنكِبَيهِ وَيَرميهِ بِتَذليلِ",22,"ل",1,0],["لا يَصُمْ عن طعامه في فلسطي","نَ يموت الزعيمُ لولا طعامُهْ",23,"م",2,0],["لا يَصعُبُ الأَمرُ إِلّا رَيثَ يَركَبُهُ","وَلا يَبيتُ عَلى مالٍ لَهُ قَسَمُ",24,"م",1,0],["لا يَصبِرونَ وَلا تَزالُ نِسائُهُم","تَشكو الهَوانَ إِلى البَئيسِ الأَبأَسِ",25,"س",1,0],["لا يُصلِحُ الجَبّارَ إِلّا ضَربَةٌ","تَشفيهِ مِن خَبَلٍ بِهِ وَجُنونِ",26,"ن",1,0],["لا يُصْدرونَ نحورَها يومَ الوغى","إلاّ كما صَبَغَ الخدودَ حياء",27,"ا",2,0],["لا يَصرِفَنَّكَ عَن قَصفٍ وَإِصباءِ","مَجموعُ رَأيِ وَلا تَشتيتُ أَهواءِ",28,"ا",2,1],["لا يَصُدَّنَّكَ لاحٍ","هُوَ عَن سُكرِكَ صاحِ",29,"ح",1,0],["لا يصيد الدهرَ إلّا","حمرَ وحشٍ أو نعاما",30,"م",2,0],["لا يُصابي عَلى الفُضولِ وَلا يُع","طي اِفتِخاراً لا خَيرَ في الفِخّيرِ",31,"ر",1,0],["لا يَصبِرونَ فَقيرٌ تَحتَ فاقَتِه","إِنَّ السَباريتَ جابَتها السَباريتُ",32,"ت",1,0],["لا يَصِلُ الرُّمْحُ إلى طَرْفِهِ","ولا إلى المُحْكَمِ مِنْ سَرْدِهِ",33,"د",2,0],["لا يصرف الهمَّ إلّا شدوُ محسنة","أَو منظرٌ حسنٌ تهواهُ أو قدحُ",34,"ح",1,1],["لا يصحَب الإنسانَ في قبرهِ","غيرُ التقى والعمََلُ الصالحُ",35,"ح",1,0],["لا يصطفون مضيفاً بعْض سرّهم","حاشا جلالهم من ذلِكم حاشا",36,"ش",2,0],["لا يَصْرفُ السُّحْتُوتَ إلاَّ","وهوَ غيرُ مُخَيَّرِ",37,"ر",1,0],["لا يَصطَفي القَلب مِمَن رُحت تُبصرهُ","إِلّا ذَوات الَّتي تُرضيكَ شيمتها",38,"ه",2,1],["لا يصافِى الحرّ إلا مثلَه","هل ترى الأحرارَ صافتهم سِفلْ",39,"ل",1,0],["لاَ يَصِحُّ القًَرِيضُ دُونَ بَيَانٍ","ومَعَانٍ بَدِيعَةٍ وبَدِيعِ",40,"ع",1,0],["لا يَصطَلِ الرومُ جَهلاً ما يَشُبُّ لَهُم","رَبُّ العُلى لَم تُشَب وَالجودِ لَم يُشَبِ",41,"ب",1,0],["لا يصون الحليم فيها نهاه","ساحة الحرب ليس فيها حليم",42,"م",1,0],["لا يُصْلِتُ الْبَطَلُ الْمُقارِعُ سَيْفَهُ","إِلاّ إِذا ما الرُّمْحُ قَلَّ غَناؤُهُ",43,"ا",3,0],["لا يَصْحَبُ الدَّهْرُ مِنْهُمْ طُولَ ما ذُكِرُوا","إِلاّ الثَّناءُ وَإلاّ طِيبُ أَخْبارِ",44,"ر",1,0],["لا يُصبِحُ المَرءُ ذو اللُبِّ الأَصيلِ وَلا","يُمسي عَلى آلَةٍ إِلّا لَهُ عَمَلُ",45,"ل",1,0],["لا يصلح الدهر من مفاسده","الا ليسلمه الى العطب",46,"ب",1,0],["لا يصحان إن تأملت فيه","لفوات الشروط والأحكام",47,"م",1,0],["لا يصدق النظم عليه ولا","يدخله المنصف في حده",48,"د",2,0],["لا يصحبُ المرءَ مما كان يملِكُهُ","في ظُلمةِ اللَّحدِ إلاّ خِرقَةُ الكَفَنِ",49,"ن",1,0],["لا يصلح الجاهل المغرور في نظر","إلاَّ إذا كانَ مصروفاً عن النظر",50,"ر",1,0],["لا يَصلحُ الأمرُ على غيركم","لا عارض منه ولا راتبُ",51,"ب",1,0],["لا يصعب الأمر إلا ريث يركبه","وكل أمر سوى الفحشاء يأتمر",52,"ر",1,0],["لا يصغر الرجل الكبير","بعشرةِ الرَّجل الصغيرِ",53,"ر",1,1],["لا يَصرفُ الإنسانُ قيمةَ دِرهَمٍ","عَبَثاً ويَصرِفُ عُمرَهُ الغالي سُدَى",54,"د",2,0],["لا يصَطلِي نارَ إبراهيمَ مُجتهِدٌ","ولا تنالُ عُلاهُ كَفُّ مُلتمِسِ",55,"س",1,0],["لا يَصحَبُ المرءُ شيئاً من غِناهُ ولو","سَلَّمْتُ ذاك لكانَتْ صُحبَةُ العَدَمِ",56,"م",1,0],["لا يَصل الفكرُ لَها","فكيفَ كفُّ اللاَّمس",57,"س",1,0],["لا يَصْدُقُ التَّخْوِيفُ مِنْ وَاشٍ سَعَى","حَسَداً وَلاَ قَوْلُ الأَماني يَكْذِبُ",58,"ب",1,0]]}