ُطْرٍ وَمُغتابٍ وَباكٍ وَضاحِكِ",3,"ك",1,0],["فَلا تَتَّخِذ عِندَ الرَواحِ طَريقَهُم","فَقَد يُقنَصُ البازي وَإِن كانَ أَصيَدا",4,"د",2,0],["فَلا تَتَّقونَ الشَرَّ حَتّى يُصيبَكُم","وَلا تَعرِفونَ الأَمرَ إِلّا تَدَبُّرا",5,"ر",2,0],["فَلا تَترُكَنَّ العَفوَ عَن كُلِّ زَلَّةٍ","فَما العَفوُ مَذمومٌ وَإِن عَظُمَ الجُرمُ",6,"م",1,0],["فَلا تَترُكِ الأَعداءَ حَولي لِيَفرَحوا","وَلا تَقطَعِ التَسآلَ عَنّي وَتَقعُدِ",7,"د",1,0],["فلا تتبع لتبع ذكر جور","ودعنا من رعونة ذي رعين",8,"ن",1,0],["فلا تَتَّكِلْ إلا على ما فعلتَهُ","ولا تحسبنَّ المجدَ يُورَثُ بالنسبْ",9,"ب",1,0],["فلا تتركوا ردَّ السلام إذا جرتْ","شمالٌ على نائي المحلِّ غريبِ",10,"ب",1,0],["فلا تتهم لله فيها ولايةً","ولا نظراً فالله للعبد أنْظَر",11,"ر",1,0],["فلا تتركنّي أيُّها الحرُّ عُرضةً","لدهرٍ غدا للحرّ غير متارك",12,"ك",1,0],["فلا تتقدمِ الضعفاءَ منا","إلى معروفك الجُلُدُ الحُمولُ",13,"ل",1,0],["فَلا تُتبِعِ الأَفعى يَدَيكَ تَنوشُها","وَدَعها إِذا ما غَيَّبَتها سَفاتُها",14,"ت",3,0],["فلا تتشبهوا يا قوم إنا","عرفنا مصر المتشبهينا",15,"ن",2,0],["فلا تتركنِّي للنوائب مُضْغَةً","وقد كشَّرتْ عن حَدِّ أنيابِها العُصْلِ",16,"ل",1,0],["فَلا تَتَكَلَّفَنَّ إِلَيَّ وَصلاً","تُلاقي مِن أَذاهُ ما تُلاقي",17,"ق",2,0],["فَلا تُتبِعِ الماضي سُؤالَكَ لِم مَضى","وَعَرِّج عَلى الباقي فَسائِلهُ لِم بَقي",18,"ق",2,0],["فَلا تَترُكوا عُذري المُضيءَ بَيانَهُ","وَلا تَجعَلوني في الرَكِيَّةِ كَالرَدي",19,"د",2,0],["فَلا تَتَكَثَّر بِدارِ البِلى","فَإِنَّكَ فيها وَحيدٌ فَريدُ",20,"د",1,0],["فَلا تَتْرُكي نَفْسِي تَذُوبُ وَمُهْجَتِي","تَسِيلُ دَمَاً بَيْنَ الدُّمُوعِ السَّوَاجِمِ",21,"م",1,0],["فَلا تَترُكي نَفسي شَعاعاً فَإِنَّها","مِنَ الوَجدِ قَد كادَت عَلَيكَ تَذوبُ",22,"ب",1,0],["فَلا تَترُك الأَشغالَ طُرّاً وَتَرتَقي","إِلى أُفُقِ اللَذاتِ جَهراً بِلا سِرِّ",23,"ر",1,0],["فَلا تَتَمَنَّني وَتَمَنَّ جِلفاً","قُراقِرَةً هِجَفّاً كَالخَيالِ",24,"ل",1,0],["فلا تَتَكَلّفْ للخميسِ من العِدى","خَميساً ولكِنْ رُعْهُ باسمِكَ يُهزَم",25,"م",1,0],["فلا تَتَبعِ الحُسّادَ منكَ مَلامَةٌ","فما شَرَفُ الحُسّادِ منكَ بِباطل",26,"ل",1,0],["فَلا تَترُكَنّي بِالوَعيدِ كَأَنَّني","إِلى الناسِ مَطلِيٌّ بِهِ القارُ أَجرَبُ",27,"ب",1,0],["فَلا تَتَعَرَّض في طَريقِكَ ناظِراً","نِساءَ النَصارى غَادِياتٍ إِلى الكُنسِ",28,"س",1,0],["فَلا تَترُكَنَّ وَرَعاً في الحَياةِ","وَأَدِّ إِلى رَبِّكَ المُفتَرَضُ",29,"ض",1,0],["فَلا تَتَعَلَّل بِالمُدامِ وَإِن تَجُز","إِلَيها الدَنايا اِّخشَ كُلَّ نَديمِ",30,"م",1,0],["فَلا تَتَّقي ذَمَّ العَشيرَةِ كُلَّها","وَتَدفَعُ عَنها بِاللِسانِ وَبِاليَدِ",31,"د",1,0],["فَلاَ تَتْبَعِ الظَّنَّ إِنَّ الظُّنُونَ","تُرِيكَ مِنَ الأَمْرِ مَا لَمْ يَكُنْ",32,"ن",1,0],["فَلا تَتَّبِعْ رَيْبَ الظُّنُونِ فَكُلُّ مَا","تَصَوَّرَهُ الإِنْسَانُ وَهْمٌ مُلَفَّقُ",33,"ق",1,0],["فَلاَ تَتَهدَّد بالوَعِيدِ سَفَاهَةً","وأوْعِدْ شُنَيْفاً إنْ غَضِبْتَ وواقِمَا",34,"م",2,1],["فلا تَتَخبَّطى فالليلُ داجٍ","وإنْ لم يَبْقَ بُدٌّ مِن صباح",35,"ح",1,0],["فَلاَ تَتَألَّم مِن هِجَائِكَ هِجتَهُ","وَتعلَمُ أني حَامِلٌ فِيهِ لِلتوي",36,"و",2,0],["فَلا تَتَحَدَّوهُ بِذَمٍّ فَإِن تَكُن","إِساءَتُهُ سَهواً فَإِحسانُهُ عَمدُ",37,"د",1,0],["فلا تتعجبوا لمضاه فيهم","فإن رضاهم قد كان اذنا",38,"ن",2,0],["فَلا تَترُكَن حَقّاً لِخيفَةِ قائِلٍ","فَإِنَّ الَّذي تَخشى وَتَحذَرُ حاصِلُ",39,"ل",1,0],["فَلا تَتَّكِل يا فَضلُ في الفَضلِ وَالنَدى","عَلى سالِفٍ أَسداهُ جَدٌّ وَوالِدُ",40,"د",1,0],["فَلا تَتَوَهَّمَن لِيَ عَنكَ صَبراً","مَتى صَبِرَت عَنِ الماءِ الحيامُ",41,"م",1,0],["فلا تتركنْ أمرا مخافةَ قائلٍ","فإن الذي تخشى وتَحْذَر حاصل",42,"ل",1,0],["فَلا تَتعجّب مِن كمالِ جَمالها","وَنَقصي فَكم ذا أخرجَ الصدَفُ الدرّا",43,"ر",2,0],["فلا تتقاعدْ إن تلحْ لك فرصةٌ","ولا تزدرِ الشيءَ الحقيرَ وإن هانا",44,"ن",2,0],["فَلا تَتبَعي العَينَ الغَوِيَّةَ وَاِنظُري","إِلى عُنصُرِ الأَحسابِ أَينَ يَؤولُ",45,"ل",1,0],["فلا تتسرع بالعتاب فمنكرٌ","تسرُّع خِلٍّ بالعتاب إلى خلّ",46,"ل",1,0],["فلا تترك الآداب يا ابن مليكها","إلى الدهر تسقى من أراقمه الربد",47,"د",1,0],["فلا تتهِمْني باتِّهامِك ظالماً","فإنّي لم أَعْتِبك إلا على الهجرِ",48,"ر",1,0],["فَلاَ تَتَعَشَّقْ غَيْرَ سَعْيٍ لِرَاحَةٍ","تَدُومُ وَوَصْلٍ مَا لَهُ مِنْ تَفَرُّقِ",49,"ق",1,0],["فلا تتَرفَّعي عن ساقطاتٍ","رياءً إنَّ هذا مِثلُ هذا",50,"ذ",2,0],["فَلا تتركَ الأهواءُ إلّا فَجاءةً","وَلا تُنزعُ الأرواحُ إلّا تَخطّفا",51,"ف",2,0],["فلا تتجاهل ندائي حبيبي","فإنك تعلم ما بي وتدري",52,"ي",1,0],["فلا تتخيل بأنك أقوى","وأني صبور على رغم أنفي",53,"ف",2,0],["فَلا تَتَمنَّني وَتَمَن","نَ غيري لَيِّناً كَتَدُه",54,"د",2,0],["فَلا تَتَجَشَّم سُؤالاً لَهُ","سَيَكفيكَهُ بادِئاً بادِرا",55,"ر",2,0],["فَلا تَتبَعوا رَأى الأَماني في عَسى","فَإِن عَسى ما لَيَّنَت مِعطَفي عاسِ",56,"س",1,0],["فلا تتعبن يا من يروم عَفافةً","إذا لم يُعنك اللَه لا تتمنَّع",57,"ع",1,0],["فلا تَتْرُكْ يدَ الأحقادِ تُدْمِي","جَبِيناً لا يَلِيقُ بهِ الشُّحُوبُ",58,"ب",1,0],["فلا تتعَلَّموها ما استطَعْتُمْ","وإلاّ كُنتُمُ في الفَقْرِ مِثلي",59,"ي",1,0],["فلا تتجرَّمنَّ على القوافي","مطاوعةَ التسرُّعِ والعُرامِ",60,"م",1,0],["فلا تتوهموا لي خصبَ مرعى","إذا قعدت سماؤكُمُ بأرضي",61,"ض",2,0],["فلا تتعنَّ لائمةٌ بعذلي","ولا تغمزْ فما تسطيعُ كسري",62,"ر",2,0],["فلا تتوهَّمي بالشرِّ ليناً","فقد يتألَّقُ النَّصلُ الطريرُ",63,"ر",1,0],["فلا تتجاذب الحسّادُ منها","عرىً يَعيا بمرَّتها الجذيبُ",64,"ب",1,0],["فلا تتطلَّبي غَلَطاتِ شوقي","فما إن زلتُ ذا شوقٍ مصيبِ",65,"ب",1,0],["فَلا تَترُكِ العَتبَ العَسوفَ يَرُدُّني","وَما قَضِيَت عِندَ الرِضا حاجَةُ العُذرِ",66,"ر",1,0],["فَلا تَتَعَرَّضنَ لِحِفظَ مالٍ","فَحَفِظَ المالَ تَضييعُ الثَناءِ",67,"ا",2,0],["فَلا تَترُكي نَفسي شَعاعاً فإِنَّها","مِنَ الحُزنِ قَد كادَت عَلَيكِ تَذوبُ",68,"ب",1,0],["فلا تتعجب أن تظلمت محوجاً","فقد حان للمظلوم أن يتظلما",69,"م",2,0],["فلا تتصوره بصورة صاحب","فليس أبو شبلين غرثان يصحب",70,"ب",1,0],["فلا تتركوني أشتكي جور حادث","وأنتم على الإنصاف أقوى وأقدر",71,"ر",1,0],["فَلا تَترُكوا حَقّاً لَكُم وَتُضَيِّعوا","نَفيساً وَدينُ اللَهِ أَعلى وَأَنفَسُ",72,"س",1,0],["فلا تتّقيني في البكاءِ وكلّما","سئمتُ فأعييتُ البكاءَ فقِيني",73,"ن",2,0],["فلاتتّهم كلا وإن كان بعضهم","لقد طاش عن نزقٍ لعل له عذرا",74,"ر",2,0],["فلا تتذمر على حكمة ال","قدير كما يصنع الجهلاء",75,"ا",2,0],["فلا تتبعْ أخا سفهٍ وَدَعْهُ","وكنْ للحرِّ دَهْرَكَ