15093.html","الطويل"],[462,"أذنت لك العلياء نازحها","https://www.aldiwan.net/poem15363.html","أحذ الكامل"],[465,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[466,"يا نائي الدار","https://www.aldiwan.net/poem36226.html","عموديه"],[466,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[466,"يا وارف الظِّل","https://www.aldiwan.net/poem43684.html","عموديه"],[514,"جعلت فداك قد طال انعطافي","https://www.aldiwan.net/poem67718.html","الوافر"],[517,"أفي قلائص جرب كن من عمل","https://www.aldiwan.net/poem48703.html","البسيط"],[530,"قالوا يعاديك جميع الورى","https://www.aldiwan.net/poem37327.html","السريع"],[539,"إذن حصحص الحق وانكشفا","https://www.aldiwan.net/poem47450.html","عموديه"],[547,"آذنت جارتي بوشك رحيل","https://www.aldiwan.net/poem1858.html","الخفيف"],[552,"هل أنت من وصب الصبابة ناصري","https://www.aldiwan.net/poem47790.html","الكامل"],[559,"ظهر الوجود الحق في مرآتنا","https://www.aldiwan.net/poem34219.html","الكامل"],[562,"لقد وجدتم مصعبا مستصعبا","https://www.aldiwan.net/poem27829.html","الرجز"],[562,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[562,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[571,"أذنب علينا ستم عروة خاله","https://www.aldiwan.net/poem59457.html","الطويل"],[576,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[586,"لا تلق دهرك بالعتاب","https://www.aldiwan.net/poem1570.html",""]],"verses":[["أذن بمن في السُرى عن أنسِ حادينا","بنارِ دار علت للهاشميينا",0,"ن",2,1],["آَذَنَتنا بِبَينِها أَسماءُ","رُبَّ ثاوٍ يُمَلُّ مِنهُ الثَواءُ",1,"ا",2,1],["آَذَنَتنا بِبَينِها ثُمَّ وَلَّت","لَيتَ شِعري مَتى يَكونُ اللِقاءُ",1,"ا",2,0],["إِذ نَحنُ نَعصي في الهَوى","قَولَ الوُشاةِ وَمَن يَلومُ",2,"م",1,0],["أَذَّنَ مُجتازاً بِنا بِالصَلاة","وَغارَتِ الأَنجُمُ مُستَوسِقات",3,"ت",1,1],["إِذ نَظَرَت نَظرَةً لَيسَت بِكاذِبَةٍ","إِذ يَرفَعُ الآلُ رَأسَ الكَلبِ فَاِرتَفَعا",4,"ع",2,0],["أَذِنَ اليَومَ جيرَتي بِحُفوفِ","صَرَموا حَبلَ آلِفٍ مَألوفِ",5,"ف",1,1],["آذَنَت شَمسُ حَياتي بِمَغيبِ","وَدَنا المَنهَلُ يا نَفسُ فَطيبي",6,"ب",2,1],["أَذِنتُكِ تَرتابينَ في الشَمسِ وَالضُحى","وَفي النورِ وَالظَلماءِ وَالأَرضِ وَالسَما",7,"م",2,1],["إِذ نَحنُ في رَوضَةٍ لِلوَصلِ نَعَّمَها","مِنَ السُرورِ غَمامٌ فَوقَها صابا",8,"ب",2,0],["أذناه أطول شيءٍ","ومخه جد خالي",9,"ل",2,0],["إذَنْ لَزُفَّتْ عَزِيزاً","عَلَى الْوَرَى أن تَبِينَا",10,"ن",2,0],["إِذَنْ كَانَ هَذَا العَيْشُ كَأْساً مَسُوغَةً","بِصَبْرِي أُحَلِّيهِ وَإِنْ يَكُ عَلْقَمَا",11,"م",2,0],["إِذَن فَرماني اللَهُ مِن حَيثُ لا أَرى","بِزُرقِ النَواحي لَم تُفَلَّ نِصالُها",12,"ل",3,0],["إذن فالهند أشرف من بلادي","وأشرف من بني قومي الهنود",13,"د",1,0],["إذ نهر بِينٍ عند كَلْواذى به","مُلْد الغصون تَهزّها النسمات",14,"ت",1,0],["إِذَن لَتَقَصَّمَ الحِجلانِ عَنها","وَظُنّا في مَكانِهِما رُثاما",15,"م",2,0],["إذ نظرت للربى والنهر","فارْوِ عن الربيع أو عن جعفرِ",16,"ر",1,0],["إذَنْ وسرَّكَ أن ينسى الذنوبَ معاً","وأن تصادفَ منه جانباً دَمِثا",17,"ث",2,0],["إذن لاستقدتم منهما وِتْر فارسٍ","وإن وَلَّياكم فالوشائجُ أوشجُ",18,"ج",1,0],["إذ نحن أترابُ النعي","م ودَرُّ دنيانا دريرُ",19,"ر",1,0],["أُذنٌ منك قَلَّ ما تدع العَلْ","ياءُ فيها فضلاً لشدوِ القيان",20,"ن",1,0],["أذنٌ وإن هي كَلَّت ما عهدتُ بها","وقراً سوى وَقْرها عن لَوْمِ لاحيها",21,"ي",3,0],["آذَنوا بِالبَينِ جيرانَهُم","ثُمَّ راحوا ثُمَّ ما باتوا",22,"ت",3,1],["إِذَن فَأَباحَتني المَنايا وَقادَني","إِلى أَجَلي عَضبُ السِلاحِ سَفوحُ",23,"ح",1,0],["اذ نحن من دجلة في عدوة رحبت","وقد تصافح فيها الماء والشجر",24,"ر",1,0],["اذنبٌ يا رعاكِ اللَه أنا","عشقنا منك يا ميُّ الجمالا",25,"ل",2,0],["إذن جمال صفقة رابحة","لنا كلينا قد فهمت مأربي",26,"ي",1,1],["إذن لقد كنت تراني يا أخي","ولم تكن تقواك إلا كذبا",27,"ب",2,1],["آذَنَ الحَقُّ ضَحاياها بِها","وَيحَهُ حَتّى إِلى المَوتى نَعاها",28,"ا",3,0],["إِذ نَحنُ في ظِلِّ الشَبا","بِ الوارِفِ المُتَهَدِلِ",29,"ل",1,0],["آذَنونا بِمَوقِفٍ","مِن جَلالٍ وَمِن خَطَر",30,"ر",1,0],["أُذُنُ الفَتى في قَلبِهِ","حيناً وَحيناً في نُهاهُ",31,"ا",2,0],["آذَنتِها بِنَوىً فَقالَت لَيتَ لَم","تَصِلِ الحِبالَ وَلَيتَها لَم تَقطَعِ",32,"ع",1,0],["أَذَنبُهُم عِندَ هَذا الدَهرِ أَنَّهُمُ","يَحمونَ أَرضاً لَهُم ديسَت وَأَوطانا",33,"ن",2,0],["إِذَنْ لَعَلِمْتَ أَنِّي عَنْ قَرِيبٍ","سَتُحْفَرُ حُفْرَتي ويُشَقُّ لَحْدِي",34,"د",2,0],["إِذنُ الأَميرِ بِأَن أَعودَ إِلَيهِمِ","صِلَةٌ تَسيرُ بِشُكرِها الأَشعارُ",35,"ر",1,0],["إِذ نَحنُ نَستَرِقُ الحَديثَ وَفَوقَنا","مِثلُ الضَبابِ مِنَ العَجاجِ الأَقتَمِ",36,"م",1,0],["إِذ نَحنُ نُخبِرُ بِالحَواجِبِ بَينَنا","ما في النُفوسِ وَنَحنُ لَم نَتَكَلَّمِ",37,"م",1,1],["إِذ نَحنُ في غُرَفِ الجِنا","نِ نَعومُ في بَحرِ السُرورِ",38,"ر",1,0],["إِذَن لَقامَ بِنَصري مَعشَرٌ خُشُنُ","عِندَ الحَفيظَةِ إِن ذو لَوثَةِ لانا",39,"ن",2,0],["أذنَبَت ساعة نجوى وحنين","وسدت راحتَهُ في راحتيك",40,"ك",1,0],["أذِنَ اللهُ به بَعد النَّوي","فثوينا واسترحنا وأمِنَّا",41,"ن",2,0],["أذن الموت لها فالتأمت","وشفاها بعدما استعصى الشفاء",42,"ا",2,0],["أَذنوباً كاثَرت عِدّ الحصى","بِئسَ ما استَكثَرتَ مِن كَسبِ يَدَيك",43,"ك",1,0],["أُذُنٌ صَفوحٌ لَيسَ يَفتَحُ سَمعَها","لِدَنِيَّةٍ وَأَنامِلٌ لَم تُقفَلِ",44,"ل",1,0],["إِذ نَحْنُ فِي عَيْشٍ تَرِفُّ ظِلالُهُ","وَلَنَا بِمُعْتَرِك الْهَوَى آثَامُ",45,"م",1,0],["إذ نحنُ مِن هذه الدنيا ضراوتُها","وإذ مغاني الصِّبا فيها مغانينا",46,"ن",2,0],["إِذ نَلبَسُ العَيشَ صَفواً لا يُكَدِّرُهُ","جَفوُ الوُشاةِ وَلا يَنبو بِنا زَمَنُ",47,"ن",1,0],["آذَنَت هِندٌ بِبَينٍ مُبتَكِر","وَحَذِرتُ البَينَ مِنها فَاِستَمَر",48,"ر",1,1],["أَذِنَ الغَمامُ بِديمَةٍ وَعُقارِ","فَاِمزُج لُجَيناً مِنهُما بِنُضارِ",49,"ر",1,1],["أَذِنَ الرَحيلُ بِلُقيَةٍ لِوَداعِ","إِنَّ اللَيالي نَزرَةُ الإِمتاعِ",50,"ع",1,1],["إِذَن لَما اِنبَعَثَت عَنّي مُغَلغَلَةٌ","مِنَ القَوافي تَهُزُّ الأَرضَ بِاللَجَبِ",51,"ب",1,0],["إذن لدفعناهُ إلى الجانبِ الذي","تَنَكَّبَ نُؤذيه ونُرهقُه عُسْرا",52,"ر",2,0],["أذِنَ اللَّهُ باللقاءِ وكانتْ","لوعةً للفِراقِ دَامتْ سِنينا",53,"ن",2,0],["أذن النبيُّ له فأشرقَ وجههُ","ولقد يُرى وهو الأحمُّ الأكفحُ",54,"ح",1,0],["أَذِّنْ بِلاَلُ لكَ الوَلاَيةُ لم تُتَحْ","لِسوَاكَ إذ تدعو الجموع فَتُقبِلُ",55,"ل",1,0],["أذِّنْ فإنَّ الدِّينَ قامَ عَمُودُه","وَرَستْ جَوانبُهُ فما يَتَقَلقَلُ",55,"ل",1,0],["إذنْ لَرَأْيتني يوماً","صريعاً تحت شباكي",56,"ك",2,0],["إِذ نَشَأَت غَيرَ فَتى مالِكٍ","لِنِيَّةٍ شالَت بِأَجذامِها",57,"م",3,0],["آذَنَ الناوي بِبَينونَةٍ","ظَلتُ مِنها كَصَريعِ المُدام",58,"م",1,0],["إِذ نَحنُ وَالحَيُّ بِهِ جِيرَةٌ","فِيما مَضى مِن سالِفِ الأَعصُرِ",59,"ر",1,0],["إِذ نَحنُ أخدانُ الصِبا وَالهَوى","مِنّي وَمِن أَسماءَ لَم يَنفَد",60,"د",1,0],["إِذَن لَأَيقَنتَ بِأَنَّ الهَوى","أَعجَلَ مَوتاً قَبلَ ميقاتِهِ",61,"ت",2,0],["آذَنَكَ الناقوسُ بِالفَجرِ","وَغَرَّدَ الراهِبُ في العُمرِ",62,"ر",1,1],["إِذَن لَعَلِمتَ أَنَّ الحُب","بَ يَأخُذُ أَخذَ مُقتَدِرِ",63,"ر",1,0],["آذَنَني بِاليَأسِ مِن وَصلِهِ","وَالقَلبُ مَشغوفٌ عَلى ياسِهِ",64,"س",2,0],["إِذَن لَيسَ تُزري بي لَدَيكَ مَوَدَّتي","وَلكِن يُزري بِوِدَّيكَ إِفلاسي",65,"س",2,0],["إِذَن قَد مَلَأَت بِالكُث","رِ يا مُسلِمَةُ الأَرضا",66,"ض",2,0],["إِذَن لَجَهِدتُ فَوقَ الجَهدِ حَتّى","أُطيقَ خَلاصَكُم أَو لا أُطيقا",67,"ق",2,0],["إِذ نَجتَليها وَإِذ نُسقى عَلى ظَمَاءٍ","بِالراحِ خالَطَ أَنفاساً مِنَ القُطُرِ",68,"ر",1,0],["إِذ نَحنُ في غَيِّ الصِبا نَظيرُ","وَالدَهرُ لا تَشعِبُهُ الدُهورُ",69,"ر",1,0],["إِذ نَلتَقي حَلَقاً وَنَستَرِقُ الهَوى","سَرقَ العَفاريتِ السَماعَ مَذودا",70,"د",2,0],["آذَنَ طِلباتُ الصِبى بِصَدِّ","طالَبَني أَمرٌ وَلَيسَ يُجدي",71,"د",2,0],["إِذ نَحنُ بِالرَوحاءِ نُسقي الهَوى","صِرفاً وَإِذ يَغبِطُنا اللاعِبُ",72,"ب",1,0],["إِذ نَسوقُ المُنى وَنَغتَبِقُ الرا","حَ وَيَأتي الهَوى عَلى تَغييبِ",73,"ب",1,0],["إِذ نَحنُ بِالميثِ لا تَرى أَحَداً","يُزري وَإِذ شَأنُنا بِهِ اللَعِبُ",74,"ب",1,0],["إِذَن تَسَربَلتُمُ فِيهِ ليُنجِيَكُم","مِمّا يَقولُ اِبنُ ذِي الجَدّينِ إِذ قالا",75,"ل",2,0],["إذ نهر دجلة أنت تجري ههنا","دهراً فتخرق جانبي بغداد",76,"د",1,0],["إذن لرأيت عمرك عمر نجم","له في اللانهاية ألف جيل",77,"ل",1,0],["إذن لطلعن في الظلمات بيضا","من الغرر اللوامع والحجول",77,"ل",1,0],["أَذَّنَ الدِّيكُ فَثُبْ أَوْ ثَوِّب","وانْضَحِ القَلْبَ بماءِ العِنَبِ",78,"ب",1,1],["إذ نحن أهونُ أن نحرِّك ساكناً","في 