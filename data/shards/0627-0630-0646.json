ب",3,0],["إذن فتلافني من قبل يأسٍ","يولد ما يجل عن التلافي",178,"ف",2,0],["اذنَبَ غَيري وَلَم اذنب يكلفني","ام كَيفَ اقتل لا عَقل وَلا قَوَدَ",179,"د",1,0],["إذن فَلا كُنْتُ ولا كَانَ لِي","بِرَوْضِ عِلْمٍ للهُدَى مَرْتَعُ",180,"ع",1,0],["إذَن حَصحَص الحَقُّ وانكَشَفا","وبانَ الصَّوابُ وزالَ الخَفَا",181,"ف",2,1],["آذَنَتْ جارَتِي بِوَشْكِ رَحيلِ","باكِراً جاهَرَتْ بخَطْبٍ جَلِيلِ",182,"ل",1,1],["إذ نحن في أرض التّصابي جيرةٌ","في ظلّ أيامٍ هناك نضائرِ",183,"ر",1,0],["إذ نحن أجمعنا هو العدم الذي","ما شم رائحة الوجود إذا نزل",184,"ل",1,0],["إِذ نَصَبَ الحَربَ فَلاقى مُنصِبا","بِجانِبِ الكُوفَةِ يَوماً مُشجِبا",185,"ب",2,0],["إِذ نَذَرَ الناذِرُ نَذرَ المُجذَلِ","صَوماً عَنِ الطَعامِ وَالتَعَلُّلِ",186,"ل",1,0],["إِذ نَحنُ في ضَبابَةِ التَسكيرِ","وَالعَصرِ قَبلَ هَذِهِ العُصورِ",187,"ر",1,0],["أذنبٌ علينا ستم عروةَ خالَهُ","بقرةَ أحساءِ ويوماً ببديدِ",188,"د",1,1],["آذَنَتْنَا يومَ اللوى بالحَرْب","أَسْهُمُ التُّركِ في عُيونِ العُرْبِ",189,"ب",1,0],["إِذ نحن في جاه الصِّبا","والعمرُ مجهول الحساب",190,"ب",1,0]]}