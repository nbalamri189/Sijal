{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[55,"قد كنت أعلم يا ظلوم","https://www.aldiwan.net/poem26110.html","مجزوء الكامل"],[55,"أذن مجتازا بنا بالصلاة","https://www.aldiwan.net/poem26442.html","السريع"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[9,"أذن اليوم جيرتي بحفوف","https://www.aldiwan.net/poem21953.html","الخفيف"],[86,"آذنت شمس حياتي بمغيب","https://www.aldiwan.net/poem10474.html","الرمل"],[86,"أذنتك ترتابين في الشمس والضحى","https://www.aldiwan.net/poem10929.html","الطويل"],[73,"أذكرتني سالف العيش الذي طابا","https://www.aldiwan.net/poem11904.html","البسيط"],[93,"حكوا لنا عن حمارٍ","https://www.aldiwan.net/poem11072.html","المجتث"],[93,"جاء الكتاب وأصدق","https://www.aldiwan.net/poem11242.html","المجتث"],[93,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[30,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[88,"لنا ملك وليس له رعايا","https://www.aldiwan.net/poem44793.html","الوافر"],[88,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[27,"ألا حي المنازل والخياما","https://www.aldiwan.net/poem6017.html","الوافر"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"يا مادح الحقد محتالا له شبها","https://www.aldiwan.net/poem9213.html","البسيط"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[51,"نبكي الشباب لحاجات النساء ولي","https://www.aldiwan.net/poem66769.html","البسيط"],[29,"آذنوا بالبين جيرانهم","https://www.aldiwan.net/poem6221.html","المديد"],[32,"هل الحائم العطشان مسقى بشربة","https://www.aldiwan.net/poem27760.html","الطويل"],[89,"أضاء ثم تدلى يأفل القمر","https://www.aldiwan.net/poem44783.html","البسيط"],[89,"متى تحضر تطب يا عذل بالا","https://www.aldiwan.net/poem44966.html","الوافر"],[85,"إذن جمال صفقة رابحة","https://www.aldiwan.net/poem6958.html","الرجز"],[85,"إذن لقد كنت تراني يا أخي","https://www.aldiwan.net/poem7030.html","الرجز"],[85,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[85,"ما بين دمعي المسبل","https://www.aldiwan.net/poem62836.html","مجزوء الكامل"],[85,"لم يمت من له أثر","https://www.aldiwan.net/poem62861.html","مجزوء الخفيف"],[85,"قالوا له روحي فداه","https://www.aldiwan.net/poem62996.html","مجزوء الكامل"],[85,"ضمي قناعك يا سعاد أو ارفعي","https://www.aldiwan.net/poem63709.html","الكامل"],[85,"يا قوم عثمان والدنيا مداولة","https://www.aldiwan.net/poem63738.html","البسيط"],[56,"أساكن حفرة وقرار لحد","https://www.aldiwan.net/poem58603.html","الطويل"],[43,"سر حل حيث تحله النوار","https://www.aldiwan.net/poem9562.html","الكامل"],[28,"وبواضح رتل تشف غروبه","https://www.aldiwan.net/poem5543.html","الكامل"],[28,"إذ نحن نخبر بالحواجب بيننا","https://www.aldiwan.net/poem5544.html","الكامل"],[49,"لهفي على الزمن القصير","https://www.aldiwan.net/poem64191.html","مجزوء الكامل"],[66,"يا للحماسة ضاقت بينكم حيلي","https://www.aldiwan.net/poem41550.html","البسيط"],[97,"إن تجد يا قلب قلباً قد لها","https://www.aldiwan.net/poem24347.html","الرمل"],[97,"يا حنانا كيد الآسي الرؤوم","https://www.aldiwan.net/poem24775.html","الرمل"],[97,"ها هنا حفل وذكرى ووفاء","https://www.aldiwan.net/poem24983.html","الرمل"],[80,"ما الذي أعددت للموت فقد","https://www.aldiwan.net/poem31350.html","الرمل"],[44,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[87,"ذهب الصبا وتولت الأيام","https://www.aldiwan.net/poem8289.html","الكامل"],[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[31,"قد هاج قلبك بعد السلوة الوطن","https://www.aldiwan.net/poem41294.html","البسيط"],[31,"آذنت هند ببين مبتكر","https://www.aldiwan.net/poem42521.html","الرمل"],[74,"أذن الغمام بديمة وعقار","https://www.aldiwan.net/poem12944.html","الكامل"],[74,"أذن الرحيل بلقية لوداع","https://www.aldiwan.net/poem13175.html","الكامل"],[105,"كم دون مية من عين أحاذرها","https://www.aldiwan.net/poem43153.html","البسيط"],[105,"يقول دعاة الشر ليت محمدا","https://www.aldiwan.net/poem44020.html","الطويل"],[105,"مرحبا بالأحبة المقبلينا","https://www.aldiwan.net/poem44058.html","الخفيف"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[102,"بكوري عند شباكي","https://www.aldiwan.net/poem33125.html","مجزوء الوافر"],[39,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[40,"عوجا خليلي على المحضر","https://www.aldiwan.net/poem42271.html","السريع"],[40,"يا عاذلي اليوم لا تعذلا","https://www.aldiwan.net/poem42343.html","السريع"],[48,"أقر بالذنب ولم آته","https://www.aldiwan.net/poem62470.html","السريع"],[48,"آذنك الناقوس بالفجر","https://www.aldiwan.net/poem63267.html","السريع"],[48,"أراح الله من بصري","https://www.aldiwan.net/poem63327.html","مجزوء الوافر"],[48,"إن الذي ضن بقرطاسه","https://www.aldiwan.net/poem63426.html","السريع"],[48,"ألا ليت شعري هكذا أنت للناس","https://www.aldiwan.net/poem64344.html","الطويل"],[48,"وفي الديوان غزلان","https://www.aldiwan.net/poem64362.html","الهزج"],[48,"أخلائي أذمكم إليكم","https://www.aldiwan.net/poem64456.html","الوافر"],[50,"يا خاتم الملك يا سمعي ويا بصري","https://www.aldiwan.net/poem63811.html","البسيط"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[50,"يا حب عبدة قد رجعت جديدا","https://www.aldiwan.net/poem63941.html","الكامل"],[50,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[50,"لله سلمى حبها ناصب","https://www.aldiwan.net/poem64840.html","البسيط"],[50,"يا خليلا نبا بنا في المشيب","https://www.aldiwan.net/poem64853.html","الخفيف"],[50,"يا صاح دعني فإنني نصب","https://www.aldiwan.net/poem64857.html","المنسرح"],[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85557","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125533","الوافر"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30442","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141933","الكامل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199493","المتقارب"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199471","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[92,"مرح الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=175492",""],[50,"يا خاتم الملك يا سمعي ويا بصري","https://www.poetsgate.com/ViewPoem.aspx?id=22672",""],[43,"أجارك يا أسد الفراديس مكرم","https://www.poetsgate.com/ViewPoem.aspx?id=463",""],[43,"ضيف ألم برأسي غير محتشم","https://www.poetsgate.com/ViewPoem.aspx?id=427",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[90,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[90,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179090",""],[90,"ذكرى دمشق الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179048",""],[90,"سبيل الجَماهير","https://www.poetsgate.com/ViewPoem.aspx?id=178923",""],[23,"إذن واللهِ نرميهمْ بحربٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=12808&r=&rc=12",""]],"verses":[["آَذَنَتنا بِبَينِها أَسماءُ","رُبَّ ثاوٍ يُمَلُّ مِنهُ الثَواءُ",0,"ا",2,1],["آَذَنَتنا بِبَينِها ثُمَّ وَلَّت","لَيتَ شِعري مَتى يَكونُ اللِقاءُ",0,"ا",2,0],["إِذ نَحنُ نَعصي في الهَوى","قَولَ الوُشاةِ وَمَن يَلومُ",1,"م",1,0],["أَذَّنَ مُجتازاً بِنا بِالصَلاة","وَغارَتِ الأَنجُمُ مُستَوسِقات",2,"ت",1,1],["إِذ نَظَرَت نَظرَةً لَيسَت بِكاذِبَةٍ","إِذ يَرفَعُ الآلُ رَأسَ الكَلبِ فَاِرتَفَعا",3,"ع",2,0],["أَذِنَ اليَومَ جيرَتي بِحُفوفِ","صَرَموا حَبلَ آلِفٍ مَألوفِ",4,"ف",1,1],["آذَنَت شَمسُ حَياتي بِمَغيبِ","وَدَنا المَنهَلُ يا نَفسُ فَطيبي",5,"ب",2,1],["أَذِنتُكِ تَرتابينَ في الشَمسِ وَالضُحى","وَفي النورِ وَالظَلماءِ وَالأَرضِ وَالسَما",6,"م",2,1],["إِذ نَحنُ في رَوضَةٍ لِلوَصلِ نَعَّمَها","مِنَ السُرورِ غَمامٌ فَوقَها صابا",7,"ب",2,0],["أذناه أطول شيءٍ","ومخه جد خالي",8,"ي",1,0],["إذَنْ لَزُفَّتْ عَزِيزاً","عَلَى الْوَرَى أن تَبِينَا",9,"ن",2,0],["إِذَنْ كَانَ هَذَا العَيْشُ كَأْساً مَسُوغَةً","بِصَبْرِي أُحَلِّيهِ وَإِنْ يَكُ عَلْقَمَا",10,"م",2,0],["إِذَن فَرماني اللَهُ مِن حَيثُ لا أَرى","بِزُرقِ النَواحي لَم تُفَلَّ نِصالُها",11,"ل",3,0],["إذن فالهند أشرف من بلادي","وأشرف من بني قومي الهنود",12,"د",1,0],["إذ نهر بِينٍ عند كَلْواذى به","مُلْد الغصون تَهزّها النسمات",13,"ت",1,0],["إِذَن لَتَقَصَّمَ الحِجلانِ عَنها","وَظُنّا في مَكانِهِما رُثاما",14,"م",2,0],["إذ نظرت للربى والنهر","فارْوِ عن الربيع أو عن جعفرِ",15,"ر",1,0],["إذَنْ وسرَّكَ أن ينسى الذنوبَ معاً","وأن تصادفَ منه جانباً دَمِثا",16,"ث",2,0],["إذن لاستقدتم منهما وِتْر فارسٍ","وإن وَلَّياكم فالوشائجُ أوشجُ",17,"ج",1,0],["إذ نحن أترابُ النعي","م ودَرُّ دنيانا دريرُ",18,"ر",1,0],["أُذنٌ منك قَلَّ ما تدع العَلْ","ياءُ فيها فضلاً لشدوِ القيان",19,"ن",1,0],["أذنٌ وإن هي كَلَّت ما عهدتُ بها","وقراً سوى وَقْرها عن لَوْمِ لاحيها",20,"ي",3,0],["آذَنوا بِالبَينِ جيرانَهُم","ثُمَّ راحوا ثُمَّ ما باتوا",21,"ت",3,1],["إِذَن فَأَباحَتني المَنايا وَقادَني","إِلى أَجَلي عَضبُ السِلاحِ سَفوحُ",22,"ح",1,0],["اذ نحن من دجلة في عدوة رحبت","وقد تصافح فيها الماء والشجر",23,"ر",1,0],["اذنبٌ يا رعاكِ اللَه أنا","عشقنا منك يا ميُّ الجمالا",24,"ل",2,0],["إذن جمال صفقة رابحة","لنا كلينا قد فهمت مأربي",25,"ي",1,1],["إذن لقد كنت تراني يا أخي","ولم تكن تقواك إلا كذبا",26,"ب",2,1],["آذَنَ الحَقُّ ضَحاياها بِها","وَيحَهُ حَتّى إِلى المَوتى نَعاها",27,"ا",3,0],["إِذ نَحنُ في ظِلِّ الشَبا","بِ الوارِفِ المُتَهَدِلِ",28,"ل",1,0],["آذَنونا بِمَوقِفٍ","مِن جَلالٍ وَمِن خَطَر",29,"ر",1,0],["أُذُنُ الفَتى في قَلبِهِ","حيناً وَحيناً في نُهاهُ",30,"ا",2,0],["آذَنتِها بِنَوىً فَقالَت لَيتَ لَم","تَصِلِ الحِبالَ وَلَيتَها لَم تَقطَعِ",31,"ع",1,0],["أَذَنبُهُم عِندَ هَذا الدَهرِ أَنَّهُمُ","يَحمونَ أَرضاً لَهُم ديسَت وَأَوطانا",32,"ن",2,0],["إِذَنْ لَعَلِمْتَ أَنِّي عَنْ قَرِيبٍ","سَتُحْفَرُ حُفْرَتي ويُشَقُّ لَحْدِي",33,"د",2,0],["إِذنُ الأَميرِ بِأَن أَعودَ إِلَيهِمِ","صِلَةٌ تَسيرُ بِشُكرِها الأَشعارُ",34,"ر",1,0],["إِذ نَحنُ نَستَرِقُ الحَديثَ وَفَوقَنا","مِثلُ الضَبابِ مِنَ العَجاجِ الأَقتَمِ",35,"م",1,0],["إِذ نَحنُ نُخبِرُ بِالحَواجِبِ بَينَنا","ما في النُفوسِ وَنَحنُ لَم نَتَكَلَّمِ",36,"م",1,1],["إِذ نَحنُ في غُرَفِ الجِنا","نِ نَعومُ في بَحرِ السُرورِ",37,"ر",1,0],["إِذَن لَقامَ بِنَصري مَعشَرٌ خُشُنُ","عِندَ الحَفيظَةِ إِن ذو لَوثَةِ لانا",38,"ن",2,0],["أذنَبَت ساعة نجوى وحنين","وسدت راحتَهُ في راحتيك",39,"ك",1,0],["أذِنَ اللهُ به بَعد النَّوي","فثوينا واسترحنا وأمِنَّا",40,"ن",2,0],["أذن الموت لها فالتأمت","وشفاها بعدما استعصى الشفاء",41,"ا",2,0],["أَذنوباً كاثَرت عِدّ الحصى","بِئسَ ما استَكثَرتَ مِن كَسبِ يَدَيك",42,"ك",1,0],["أُذُنٌ صَفوحٌ لَيسَ يَفتَحُ سَمعَها","لِدَنِيَّةٍ وَأَنامِلٌ لَم تُقفَلِ",43,"ل",1,0],["إِذ نَحْنُ فِي عَيْشٍ تَرِفُّ ظِلالُهُ","وَلَنَا بِمُعْتَرِك الْهَوَى آثَامُ",44,"م",1,0],["إذ نحنُ مِن هذه الدنيا ضراوتُها","وإذ مغاني الصِّبا فيها مغانينا",45,"ن",2,0],["إِذ نَلبَسُ العَيشَ صَفواً لا يُكَدِّرُهُ","جَفوُ الوُشاةِ وَلا يَنبو بِنا زَمَنُ",46,"ن",1,0],["آذَنَت هِندٌ بِبَينٍ مُبتَكِر","وَحَذِرتُ البَينَ مِنها فَاِستَمَر",47,"ر",1,1],["أَذِنَ الغَمامُ بِديمَةٍ وَعُقارِ","فَاِمزُج لُجَيناً مِنهُما بِنُضارِ",48,"ر",1,1],["أَذِنَ الرَحيلُ بِلُقيَةٍ لِوَداعِ","إِنَّ اللَيالي نَزرَةُ الإِمتاعِ",49,"ع",1,1],["إِذَن لَما اِنبَعَثَت عَنّي مُغَلغَلَةٌ","مِنَ القَوافي تَهُزُّ الأَرضَ بِاللَجَبِ",50,"ب",1,0],["إذن لدفعناهُ إلى الجانبِ الذي","تَنَكَّبَ نُؤذيه ونُرهقُه عُسْرا",51,"ر",2,0],["أذِنَ اللَّهُ باللقاءِ وكانتْ","لوعةً للفِراقِ دَامتْ سِنينا",52,"ن",2,0],["أذن النبيُّ له فأشرقَ وجههُ","ولقد يُرى وهو الأحمُّ الأكفحُ",53,"ح",1,0],["أَذِّنْ بِلاَلُ لكَ الوَلاَيةُ لم تُتَحْ","لِسوَاكَ إذ تدعو الجموع فَتُقبِلُ",54,"ل",1,0],["أذِّنْ فإنَّ الدِّينَ قامَ عَمُودُه","وَرَستْ جَوانبُهُ فما يَتَقَلقَلُ",54,"ل",1,0],["إذنْ لَرَأْيتني يوماً","صريعاً تحت شباكي",55,"ك",2,0],["إِذ نَشَأَت غَيرَ فَتى مالِكٍ","لِنِيَّةٍ شالَت بِأَجذامِها",56,"م",3,0],["آذَنَ الناوي بِبَينونَةٍ","ظَلتُ مِنها كَصَريعِ المُدام",57,"م",1,0],["إِذ نَحنُ وَالحَيُّ بِهِ جِيرَةٌ","فِيما مَضى مِن سالِفِ الأَعصُرِ",58,"ر",1,0],["إِذ نَحنُ أخدانُ الصِبا وَالهَوى","مِنّي وَمِن أَسماءَ لَم يَنفَد",59,"د",1,0],["إِذَن لَأَيقَنتَ بِأَنَّ الهَوى","أَعجَلَ مَوتاً قَبلَ ميقاتِهِ",60,"ت",2,0],["آذَنَكَ الناقوسُ بِالفَجرِ","وَغَرَّدَ الراهِبُ في العُمرِ",61,"ر",1,1],["إِذَن لَعَلِمتَ أَنَّ الحُب","بَ يَأخُذُ أَخذَ مُقتَدِرِ",62,"ر",1,0],["آذَنَني بِاليَأسِ مِن وَصلِهِ","وَالقَلبُ مَشغوفٌ عَلى ياسِهِ",63,"س",2,0],["إِذَن لَيسَ تُزري بي لَدَيكَ مَوَدَّتي","وَلكِن يُزري بِوِدَّيكَ إِفلاسي",64,"س",2,0],["إِذَن قَد مَلَأَت بِالكُث","رِ يا مُسلِمَةُ الأَرضا",65,"ض",2,0],["إِذَن لَجَهِدتُ فَوقَ الجَهدِ حَتّى","أُطيقَ خَلاصَكُم أَو لا أُطيقا",66,"ق",2,0],["إِذ نَجتَليها وَإِذ نُسقى عَلى ظَمَاءٍ","بِالراحِ خالَطَ أَنفاساً مِنَ القُطُرِ",67,"ر",1,0],["إِذ نَحنُ في غَيِّ الصِبا نَظيرُ","وَالدَهرُ لا تَشعِبُهُ الدُهورُ",68,"ر",1,0],["إِذ نَلتَقي حَلَقاً وَنَستَرِقُ الهَوى","سَرقَ العَفاريتِ السَماعَ مَذودا",69,"د",2,0],["آذَنَ طِلباتُ الصِبى بِصَدِّ","طالَبَني أَمرٌ وَلَيسَ يُجدي",70,"ي",1,0],["إِذ نَحنُ بِالرَوحاءِ نُسقي الهَوى","صِرفاً وَإِذ يَغبِطُنا اللاعِبُ",71,"ب",1,0],["إِذ نَسوقُ المُنى وَنَغتَبِقُ الرا","حَ وَيَأتي الهَوى عَلى تَغييبِ",72,"ب",1,0],["إِذ نَحنُ بِالميثِ لا تَرى أَحَداً","يُزري وَإِذ شَأنُنا بِهِ اللَعِبُ",73,"ب",1,0],["إِذَن تَسَربَلتُمُ فِيهِ ليُنجِيَكُم","مِمّا يَقولُ اِبنُ ذِي الجَدّينِ إِذ قالا",74,"ل",2,0],["إذ نهر دجلة أنت تجري ههنا","دهراً فتخرق جانبي بغداد",75,"د",1,0],["إذن لرأيت عمرك عمر نجم","له في اللانهاية ألف جيل",76,"ل",1,0],["إذن لطلعن في الظلمات بيضا","من الغرر اللوامع والحجول",76,"ل",1,0],["أَذَّنَ الدِّيكُ فَثُبْ أَوْ ثَوِّب","وانْضَحِ القَلْبَ بماءِ العِنَبِ",77,"ب",1,1],["إذ نحن أهونُ أن نحرِّك ساكناً","في حاسد أو غلّةً في صادِ",78,"د",1,0],["اذن جُنّ من قبلي الشعراء..","وما كنت في الصبوة الأوحدا..",79,"د",2,0],["اذن أنا أقبلت أهدي التمور..","لهجْر .. وأرقب منها الجَدا",79,"د",2,0],["إذن لن نهيم معا في الدروب","ونوغل في الليل حتى السحر",80,"ر",1,1],["إِذ نَما طَيِّباً وَتَمَّ فَقالوا","بَرَكاتٌ في سنى ذا السَنِيِّ",81,"ي",1,0],["إِذَن لَلَطَمتِ الخَدَّ فاطِمُ عِندَهُ","وَأَجرَيتِ دَمعَ العَينِ في الوَجَناتِ",82,"ت",1,0],["إذ نحن لم نعرف من الدنيا سوى مرح السرور","وبناء اكواخ الطفولة تحت اعشاش الطيور",83,"ر",1,0],["إِذْ نَجْتَلِيهَا وإِذْ نُسْقى عَلَى ظَمَإ","بالراح خالط أنفاساً من القطر",84,"ر",1,0],["إذن لأتاك الخير من كل وجهة","وأثريت مما تغنمين وأغنم",85,"م",1,0],["إِذن لَبَزَّكَ ثَوبَ الحُسنِ أَصغَرُهُ","وَصِرتِ مِثلِيَ في ثَوبَينِ مِن سَقَمِ",86,"م",1,0],["إذن لسألتَ اللهَ فَّلاً لغَربِه","جزاءً على ما فلَّ من سترِها غَرْبا",87,"ب",2,0],["اذنْ لاستشَفَّ الناسُ نفساً تجلببتْ","غباراً يغطي اقتمَ الريشِ بازيا",88,"ي",2,0],["اذن! فالثَأر نَنشُده كِذاباً","وصوتُ الحق نسمعُه خِداعا",89,"ع",2,0],["اذن! فسَيُوسِعُ التاريخُ رجماً","كِلَينا ، من \" أطَلَّ \" ومن أضاعا",89,"ع",2,0],["إذن لرأيتِ كيف النار تذكو","وكيف السيل إنْ ركب المسيلا",90,"ل",2,0],["أذنباً تحسبون على البرايا","إذا ما ضويقوا يوماً فضاقوا",91,"ق",3,0],["إذن عَلِمَتْ أنْ لا حياةَ لأمّةٍ","تُحاولُ أن تَحيا بغير التجدُّد",92,"د",1,0],["إذن واللهِ نرميهمْ بحربٍ","تُشِيبُ الطّفلَ مِنْ قبْل المَشيبِ",93,"ب",1,1]]}