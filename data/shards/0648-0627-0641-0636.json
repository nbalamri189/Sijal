tsgate.com/ViewPoem.aspx?id=197617",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5022,"غن الهو","https://www.poetsgate.com/ViewPoem.aspx?id=201037",""],[5105,"وقد أُزارُ وللزوارِ حكمهمُ","https://www.poetsgate.com/ViewPoem.aspx?id=135343",""],[5122,"(( الشعر ))","https://www.poetsgate.com/ViewPoem.aspx?id=23975",""],[5136,"بروحي طيفاً أتى في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=121707",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[5237,"حسامي ومنهاجي القويم وشرعتي","https://www.poetsgate.com/ViewPoem.aspx?id=113120",""],[5246,"عتاب الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=187064",""],[5246,"نظم القريض يسليني عن الكسل","https://www.poetsgate.com/ViewPoem.aspx?id=187059",""],[5452,"عذابي","https://www.poetsgate.com/ViewPoem.aspx?id=120639",""],[5459,"ازرع الخير","https://www.poetsgate.com/ViewPoem.aspx?id=198569",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[243,"مرئية الآلهة","https://www.poetsgate.com/ViewPoem.aspx?id=50562",""],[5764,"قويٌ لا رحيم","https://www.poetsgate.com/ViewPoem.aspx?id=175604",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[6019,"ذبولٌ يطوقُ زهرةَ عُمرك","https://www.poetsgate.com/ViewPoem.aspx?id=175268",""],[6089,"طافوا وطفتُ سعوا سعيتُ رموا رميتُ","https://www.poetsgate.com/ViewPoem.aspx?id=214664",""],[6271,"هواجس في طقس الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80710&r=&rc=16",""],[2546,"ألبسِ الماءَ المداما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19382&r=&rc=64",""]],"verses":[["وأفْضى إِلى أمَدٍ لوْ جَرَتْ","إليهِ الصَّبا طَفِقَتْ تَلْغَبُ",0,"ب",1,0],["وافضل الناس ما بين الورى رجل","تقضى على يده.. للناس حاجات",1,"ت",1,0],["وَأَفِضْ فِي تَلاَعِ نَجْدٍ وَقَدْ جَم","مَ بِهَا الْحَمْضُ وَاكُرَنْ أَبْقَالَهْ",2,"ل",2,0],["وَأَفِض عَلى بُندٍ إِذا وَلِيَ القَضا","رِفقاً يَهَشُّ لَهُ القَضاءُ وَيَطرَبُ",3,"ب",1,0],["وأفضت فينا من نداك مواهباً","حسُنت مواقعُها على التكرارِ",4,"ر",1,0],["وَأَفضَلُ ما نِلتُم مِنَ المَجدِ وَالعُلى","رِدافَتُنا عِندَ اِحتِضارِ المَواسِمِ",5,"م",1,0],["وأفضلُ ما صِيدَتْ به العِينُ كالدُّمَى","مُهُورٌ وأثْمَانٌ من العين تُنْقدُ",6,"د",1,0],["وَأَفضَلُ مِنها صَونُ سِرِّكِ كاتِماً","إِلى الفُرَصِ اللاتي يُنالُ بِها الجَدُّ",7,"د",1,0],["وَأَفَضنَ بَعدَ كُظومِهِنَّ بِجِرَّةٍ","مِن ذي الأَبارِقِ إِذ رَعَينَ حَقيلا",8,"ل",2,0],["وأَفضى إليه بوحْيِ النُّجُومِ","وسِرِّ الظَّلامِ ولَحْنِ السُّكونْ",9,"ن",1,0],["وَأَفضَلُ مَن يَمشي عَلى الأَرضِ حَيُّنا","وَما ضَمِنَت في الذاهِبينَ قُبورُها",10,"ر",3,0],["وَأَفضَلُ قَسمِ اللَهِ لِلمَرءِ عَقلُهُ","فَلَيسَ مِن الخَيراتِ شِيءٌ يُقارِبُه",11,"ب",2,1],["وَأَفضَلُ الزُهدِ زُهدٌ كانَ عَن جِدَةٍ","وَأَفضَلُ العَفوِ عَفوٌ عِندَ مَقدِرَةِ",12,"ر",2,0],["وَأَفضَلُ شَيءٍ نِلتَ مِنها فَإِنَّهُ","مَتاعٌ قَليلٌ يَضمَحِلُّ وَيَنفَدُ",13,"د",1,0],["وَأَفضَلُ هَديٍ هَديَ سَمتِ مُحَمَّدٍ","نَبِيٍّ تَنَقّاهُ الإِلَهُ لِدينِهِ",14,"ن",2,0],["وَأَفضَلَ أَحلاماً وَأَعظَمَ نائِلاً","وَأَقرَبَ مَعروفاً وَأَبعَدَ مُنكَرا",15,"ر",2,0],["وأَفِضْ على النّيلِ الدِّماءَ زَكِيَّةً","تُحيي القُرى مَوْتَى الزُّروعِ قِفارا",16,"ر",2,0],["وَأَفَضتُ عَبرَةَ مَعوِلٍ هاجَت لَهُ","ذِكرَ الحَبيب فَهاجَهُ إِطرابُهُ",17,"ب",2,0],["وَأَفضَلُ مِن عَيشِ الغِنى عَيشُ فاقَةٍ","وَمِن زِيِّ مَلكٍ رائِقٍ زِيُّ راهِبِ",18,"ب",1,0],["وَأَفضَلُ مِن مِزمارِ شَربٍ نَعامَةٌ","تُكَرِّرُ في السَهبِ الرَحيبِ زِمارَها",19,"ر",3,0],["وا فَضحَتا لَكَ في شِمالِكَ غادِياً","عودُ المِراةِ وَفي يَمينِكَ مِلقَطُ",20,"ط",1,0],["وَأَفضَلُ مِنهُ اِمرُؤٌ خامِلٌ","يَقوتُ بِمَكسَبِهِ حِسكِلَه",21,"ل",2,0],["وَأَفضَلُ ما اِكتَسَبَت أُمَّةٌ","وَإِن شَقِيَت حُسنُ أَعمالِها",22,"ل",3,0],["وَأَفضَلُ عِندي مِن أَكُفٍّ تَداوَلَت","سُلافَةَ خَمّارٍ أَكُفُّ قُيونِ",23,"ن",1,0],["وأفضل الصلاة والسلام","على أجل رسل السلام",24,"م",1,0],["وأفضَلُ من رَوَحاتِ النعيم","على النفس مَسغبَةُ المُترِب",25,"ب",1,0],["وأفضت بمافيها إليك ضمائرٌ","وأنتَ على مافي الضمائرِ شاهدُ",26,"د",1,0],["وافض جميلك فالسيادة للفتى","بجميله الفياض لا بجماله",27,"ل",2,0],["وافض نفحة الرسول علينا","ما حينا في صبحنا والمساء",28,"ا",2,0],["وأفضِ بفضلك أنعما","لجميعنا في كل حالْ",29,"ل",1,0],["وأفضالُك الروضُ الربيعىُّ إن دعا","بزَهرته وُرقَ الحمام ترنَّما",30,"م",2,0],["وأفضِّل الطيفَ المُلمَّ لأنهم","هَجروا وأن طُيوفَهم لم تَهجُرِ",31,"ر",1,0],["وأفض على من المعارف واللطائف","والمراحم وارحمني من زلتي",32,"ي",1,0],["وأفضل البر مالا من يتبعه","ولا تقدمه شيء من المطل",33,"ل",1,0],["وَأَفضَحُها يَومَ الخِصامِ مَقالَةً","إِذا فصحاءُ القَومِ أَكدى خِطابُها",34,"ب",3,0],["وَأَفِض عَلَيها أَلفَ أَلفِ تَحِيَّةٍ","بِالمِسكِ تَفتُقُ بُكرَةً وَأَصيلا",35,"ل",2,0],["وَأَفضَلُ ما يُرجى ثَوابُ زِيارَةٍ","يَؤُمُّ بِها أَكنافَ دارِكَ مُسلمُ",36,"م",1,0],["وأفضل صبر ما ثنى عن خزاية","وعلم حلما والحليم ينيل",37,"ل",1,1],["وأفضل صبر ما ثنى عن خزاية","وعلم حلما والحليم بنيل",38,"ل",1,0],["وأفضلُ البرّ وإن قلّ ما","فيه مع القلة تعجيل",39,"ل",1,0],["وأفضلُ معروفِ الفتى ما تحلّلت","عراه بديّا من ذكور لغافل",40,"ل",1,0],["وَأَفض يا سعدُ مِن دمعِ الهنا","ما يُروّي الأرضَ إِن شحّ الغمام",41,"م",1,0],["وَأَفضى النُسورَ المُجمِراتِ حَوافِر","إِلى الأَرضِ حَتّى أَوجَعَتها الدَوابِرُ",42,"ر",1,0],["وَأَفِض من نداكَ فيه غُيوثا","قَصُرَت عن سِجالِها الأَنواءُ",43,"ا",2,0],["وأَفضْنَ ماءَ عيونِهنّ فجال في","تلك الخدودِ كأنّه عِقْيان",44,"ن",1,0],["وأفضلُ الحلِم حلمٌ عند مَقْدُرة","وأعذبُ الجود ما وافَى بلا طلب",45,"ب",1,0],["وَأَفِضْ علَى الْعَافِي بُحُورَ نَدَاكُمُ","يَا مَنْ سَمَا شَرَفاً عَلَى الأَشْبَاهِ",46,"ا",2,0],["وافضح ما يكون السر يوماً","إذا انطقت عن القلب العيون",47,"ن",1,0],["وافضل من تكسو فضائله الورى","اديم بهاء فوق كل اديم",48,"م",1,0],["وأفضَلُ من قصرٍ يُشادُ بمَرمَرٍ","وِجارٌ على أمنٍ من الشَّرِّ أو عشُّ",49,"ش",1,0],["وأفضَلُ النَّاسِ أقواهم فلا عجبٌ","إذا تطَلَّبتُ تبريزاً وسُلطانا",50,"ن",2,0],["وأفضلُ من هؤلاءِ البنينَ","عظامُ الجدودِ الغزاة العظام",51,"م",1,0],["وأفِض على قلبي ضياءً ساطعاً","منهُ دواءُ اليأسِ والسَّوداء",52,"ا",2,0],["وَأَفضَلُ ذي يَمَنٍ كُلِّها","إِذا اِفتَقَدَ المُسنِتونَ السِجالا",53,"ل",2,0],["وأفضنا نطوف بالبيت للرك","ن وللسعي إن لم يكن مضى بالأمام",54,"م",1,0],["وَأَفضت سَجاياهم لأبناءِ فكرتي","سحاباً ليستعلمن منقطع النسبِ",55,"ب",1,0],["وافض ما بقلبك الحر من نو","ر على أفقك الحزين المديد",56,"د",1,0],["وأفض على جدب الحياة صبابة","من كاسك الروحيّة الصهباء",57,"ا",2,0],["وأُفْضِي إليهِ قَاصِداً بَعْدَ قَاصِدٍ","كَمَا بُدِّلَتْ تَحْتَ البَريِدِ الجَنائِبُ",58,"ب",1,0],["وأفضل من انفاق تبر وفضة","وأخير من ضرب الرقاب لذي الكفر",59,"ر",1,0],["وأفضل ذكر الله علم مقرب","إلى الله بالترغيب والخوف والزجر",59,"ر",1,0],["وأفضل من جهاد","المجاهد للشهادات",60,"ت",1,0],["وأفضْ عَليَّ بحار جُود منعماً","حتّى يموتَ بغَيظِهُ مَن يحسُدُ",61,"د",1,0],["وأفِضْ إلى نَجل النبيّ محمدٍ","والسّبط مِنْ رَيحانَتَيْهِ الأكْبَرا",62,"ر",2,0],["وأفضلُ مُستَشارٍ كُلَّ وَقتٍ","زمانُكَ فاقتَبسْ مِنهُ الإشارَهْ",63,"ه",1,0],["وأفضت فيه جداول الخيرات من","صافي سحائب جودك الفوّارِ",64,"ر",1,0],["وأفضل تأبين بمدح على الذي","توطن حيّاً ثم ميتاً بيثرب",65,"ب",1,0],["وأفضل ذخر للمعاد ادخرته","مديحي رسول اللَه بين الملا يروى",66,"و",2,0],["وأفضل ما مُلِّكتُه صفوُ خاطري","وها أنا مهديهِ فهل أنت قابلُهْ",67,"ل",2,0],["وأفضلُ ما جَزَيت أخاً بودٍّ","وإحسانٍ ثناءٌ وامتداحُ",68,"ح",1,0],["وأفضل الناس من لم يرتكب سبباً","حتى يميز ما تجني عواقبه",69,"ه",1,1],["وأَفَضْنا من آيَةٍ ونَسَخْنا","ونَقَلْنا من مُسْنَدٍ وَرَوَيْنَا",70,"ن",2,0],["وأفضى إلى شُعثِ الحقائب عرّسوا","على منزلٍ وَعْرٍ ودَوِّيّةٍ قَفْرِ",71,"ر",1,0],["وأفضى إلى حُجْبِ الملوكِ وَلَم يَخفْ","شَباها ولم يرقُبْ هنالك حَشْدَها",72,"د",3,0],["وأفضلُ الأرضِ ما يزكو النَّباتُ بها","وأفضلُ النَّبْتِ ما يأتيكَ بالثَّمرِ",73,"ر",1,0],["وأفضلُ مَشرَبٍ كأسُ المنايا","إذا كان النَّعيمُ بها شرابا",74,"ب",2,0],["وأفضلُ ما اشتغَلْتَ بهِ كِتابٌ","جليلٌ نفعُهُ حُلوُ المَذاقِ",75,"ق",1,0],["وأفضَلُ المدحِ ما وازَنْتَ صاحبَهُ","وزْنَ العَروض فلم تَنْقُص ولم تَزِدِ",76,"د",1,0],["وأفضَلُ الحاكِمينَ القائمِينَ فتىً","ذو حِ