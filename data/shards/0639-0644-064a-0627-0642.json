{"poems":[[32,"ألم تسأل اليوم الرسوم الدوارس","https://www.aldiwan.net/poem29577.html","الطويل"],[46,"ذريني منك سافحة المآقي","https://www.aldiwan.net/poem30396.html","الوافر"],[101,"اكتبي لي","https://www.poetsgate.com/ViewPoem.aspx?id=36388",""],[408,"نعم هذه حزوى وتلك زرود","https://www.aldiwan.net/poem46908.html","الطويل"],[463,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[463,"ما ناشر ذو مخاليب","https://www.aldiwan.net/poem56163.html","المجتث"],[466,"الق الحدائج ترع الضمر القود","https://www.aldiwan.net/poem15103.html","البسيط"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67820","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87329","الرجز"],[2721,"","https://poetry.dctabudhabi.ae/diwan/poem/20682","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89146","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83472","البسيط"],[4366,"","https://poetry.dctabudhabi.ae/diwan/poem/31513","الوافر"],[5616,"أنا","https://www.poetsgate.com/ViewPoem.aspx?id=205028",""]],"verses":[["عَلى أُقحُوانٍ في حَنادِجِ حُرَّةٍ","يُناصي حَشاها عانِكٌ مُتَكاوِسُ",0,"س",1,0],["عَلى أَقرابِها وَعَلى ذُراها","لَطائِمُ مِن مَديحٍ وَاِشتِياقِ",1,"ق",1,0],["عليَّ اقْصُصي أنباءَ نَفْسِكِ وابعثي","بشكواكِ مَنْ مثلي يشاركُكِ الشكوى ؟",2,"و",2,0],["عُلّى أقْعَدَتْ عجزاً سواك كأنّها","جوامعُ في أعناقهم وقيودُ",3,"د",1,0],["على اقتفاء أمره","في كلِّ ما جلَّ ودقّْ",4,"ق",1,0],["على أقبَّ خفيفٍ","محمَّلٍ فوق وِقْرِهْ",5,"ر",2,0],["على أقبَّ رحيب الصدر ذي خصل","فيه على الريح تبريزٌ وتجويد",6,"د",1,0],["عَليَّ أَقَامَ الحُبَّ فَرْضا وَسَنَّهُ","وَلِلْعَاشِقِ الْمَهْجُورِ يُخْلِفُ ظَنَّهُ",7,"ه",1,0],["على أقاليمِ الشمالِ خصَّا","أهلُ الفَلَك نصُّوا عليه نصَّا",8,"ص",2,0],["عَلى أَقتادِ ذِعلِبَةٍ إِذا ما","أُدِيثَت مَيَّثَت أُخرى حَسيرُ",9,"ر",1,0],["على أقطاره تبكي عيونٌ","إذا ابتسمت لوارده زهور",10,"ر",1,0],["عَلّي أَقوم ببابِ اللَهِ معتكِفاً","أَرجو اِفتِتاحيَ أَقفالاً فَأَقفالا",11,"ل",2,0],["عَلى أَقدامِهِم يَمشو","نَ في أَيمانِهِم خَدَبُ",12,"ب",1,0],["علِّي أقولُ كلاماً غيرَ ذي عوَجٍ","أشدُّ فيه زماناً غيرَ مشدودِ",13,"د",1,0],["علِّي أقيمُ على صحرائِنا وطناً","حُرًّا فلا فرقَ بين البيضِ والسودِ",13,"د",1,0]]}