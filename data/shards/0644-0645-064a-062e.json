ps://www.aldiwan.net/poem59310.html","الكامل"],[378,"كن محسنا تحسم ملامة لائم","https://www.aldiwan.net/poem59312.html","الكامل"],[392,"خذ من الوقت ما سمح","https://www.aldiwan.net/poem54594.html","عموديه"],[394,"يا وصل مالك لا تعاود","https://www.aldiwan.net/poem53658.html","مجزوء الكامل"],[410,"يا هلالا إذا تبدى يراه","https://www.aldiwan.net/poem32519.html","الخفيف"],[417,"قد نحرنا الزق يوم العيد نحرا","https://www.aldiwan.net/poem53935.html","الطويل"],[417,"يا إماما في الدين والمذهب الحق","https://www.aldiwan.net/poem54104.html","الخفيف"],[430,"لا والمحيا وصباح الجبين","https://www.aldiwan.net/poem40242.html","السريع"],[433,"لله در مجن قد جننت به","https://www.aldiwan.net/poem12391.html","البسيط"],[438,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[442,"الرزء من قلقي أجل وأعظم","https://www.aldiwan.net/poem14482.html","الكامل"],[454,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[459,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[459,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[459,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[459,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[465,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[465,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[465,"وجدي كوجدك بالظباء الغيد","https://www.aldiwan.net/poem3208.html","عموديه"],[465,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[469,"ومهفهف كالغصن في حركاته","https://www.aldiwan.net/poem60335.html","الكامل"],[478,"ذنبي إلى البيض ذنب غير مغتفر","https://www.aldiwan.net/poem15246.html","البسيط"],[480,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[501,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[501,"أسكرت أهل الوحا خمرتنا","https://www.aldiwan.net/poem37672.html","الرمل"],[501,"وحد الله ولا تشرك به","https://www.aldiwan.net/poem38033.html","الرمل"],[501,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[515,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[516,"كن لي على شكر ما أوليت من نعم","https://www.aldiwan.net/poem12253.html","البسيط"],[537,"حين ولى الناس وانخذلوا","https://www.aldiwan.net/poem23859.html","المديد"],[539,"شبل القساور من أبناء مزوار","https://www.aldiwan.net/poem48190.html","عموديه"],[539,"عبد ببابك خده قد عفرا","https://www.aldiwan.net/poem48191.html","عموديه"],[539,"إني بعثت لسيدي بكتابي","https://www.aldiwan.net/poem48294.html","عموديه"],[543,"صل من هويت ودع مقالة حاسد","https://www.aldiwan.net/poem34051.html","الكامل"],[552,"ريعت لتنعاب الغراب الهاتف","https://www.aldiwan.net/poem47390.html","الكامل"],[554,"استمطر العين أن أحبابه احتملوا","https://www.aldiwan.net/poem68393.html","البسيط"],[563,"على الدنيا ومن فيها السلام","https://www.aldiwan.net/poem52970.html","الوافر"],[576,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"]],"verses":[["لَم يَخلُ مَن تَرمي الخُطوبُ سَوادَهُ","مِن واقِعٍ أَبَداً وَمِن مُتَوَقَّعِ",0,"ع",1,0],["لَم يَخلُفوها في الشَهيدِ وَقَد رَأى","دُفَعَ الفُراتِ يذادُ عَن أَورادِها",1,"د",3,0],["لَم يُخَلّوا بَني رِزاحٍ بِبَرقا","ءِ نِطاعٍ لَهُم عَلَيهُم دُعاءُ",2,"ا",2,0],["لَم يَخرُجوا قَيدَ شِبرٍ","عَن مَسبَحِ الحيتانِ",3,"ن",1,0],["لَم يُخجِلوها بِالسُؤالِ عَنِ اِسمِها","تِلكَ المُروءَةُ وَالشُعورُ العالي",4,"ل",2,0],["لَمْ يُخْطِيءِ التَّوفِيقُ صَاحِبَهُ","فِيمَا أَرَدْتَ بِنَاءهُ فَبُنِي",5,"ن",2,1],["لَمْ يَخْتَدِعْ عَرَضٌ حِجَاكَ وَلَمْ يَجُرْ","بِكَ عَنَّ طَرِيقِ الجَوْهَرِ المَكْنُونِ",6,"ن",1,0],["لَمْ يَخْشَ فِي الْحَقِّ المَلاَمَ وَلَمْ يَكُنْ","لِسِوَى الضَّمِيرِ عَلَيْهِ مِنْ سُلْطَانِ",7,"ن",1,0],["لم يَخشَ فتكَ السقم فيها رُضَّعٌ","في البؤس قد ولدوا وفي الأقلال",8,"ل",1,0],["لَم يُخزِ أَوَّلَ يَربوعٍ فَوارِسُهُم","وَلا يُقالُ لَهُم كَلّا إِذا اِفتَخَروا",9,"ر",3,0],["لم يخجل الورد المورّد لونه","إلا وناحِلُه الفضيلةَ عاندُ",10,"د",1,0],["لم يخل نائلُهُ ولا آراؤه","من سدِّ خلّاتٍ ورأب صُدوع",11,"ع",1,0],["لم يخل دهر فيه إسماعيله","من أمن خائفه وخوف مخيفه",12,"ف",2,0],["لم يخالطهُمُ من الحمأ المس","نونِ إلا طيفٌ كطيف الخيالِ",13,"ل",1,0],["لم يخيموا عَنِ النزال ولكن","نزل النصرُ قبلَ دعوى نَزالِ",13,"ل",1,0],["لم يُخْلق الدمعُ لامرئٍ عبثاً","اللَّهُ أدرَى بلوعةِ الحزنِ",14,"ن",1,0],["لم يخل يوماً من نجِيِّ تقيّةٍ","تدعو إلى المعروف والإحسان",15,"ن",1,0],["لم يخل من أير ومن عَيْبةٍ","مُذْ شُقَّ فوهُ لمُناغيهِ",16,"ي",2,0],["لَم يَختَرِمكِ المَوتُ يا دَوحَةً","باسِقَةً قَد خَلَّفَت باسِقات",17,"ت",1,0],["لَم يَخلُ مِنهُ أَخو الثَراءِ","وَلا الفَتى البائِسُ العَديمُ",18,"م",1,0],["لَم يَخُنكُم سِوى دُمو","عِيَ أَظهَرنَ سِرَّكُم",19,"م",1,0],["لَم يَخلُ مِن جَدٍّ بِها أَو لَعبٍ","مِن المَيادين إِلى حَرِّ الرَحى",20,"ا",1,0],["لَم يَخَف في حَياتِهِ شَبَحَ الفَق","رِ إِذا طافَ بِالرِجالِ مَهولا",21,"ل",2,0],["لَم يَخلِقِ الرَحمَنُ أَك","بَرَ مِنهُما في البَرِّ آيَه",22,"ا",3,0],["لَم يَختَرِع شَيطانَ حَسّانٍ وَلَم","تُخرِج مَصانِعُهُ لِسانَ زِيادِ",23,"د",1,0],["لَم يَخلُ مِن صُوَرِ الحَياةِ وَإِنَّما","أَخطاهُ عُنصُرُها فَماتَ وَليدا",24,"د",2,0],["لَم يَخلُقِ الرَحمَنُ مِثلَ مُحَمَّدٍ","أَبَداً وَظَنّي أَنَّهُ لا يَخلُقُ",25,"ق",1,0],["لَم يُخطِ مَأبِضَ خُلساتٍ تَعَمَّدَها","فَشَكَّ ذا الشُعبَةِ الطولى فَلَم يُصِبِ",26,"ب",1,0],["لَم يَخُن رَبَّها وَلَم يُعمِلِ التَد","بيرِ في حَلِّ تاجِها المَعقودِ",27,"د",1,0],["لم يخلُ من رِفدِها نَديمٌ","يومَ خُمارٍ ولا نِدامِ",28,"م",1,0],["لَم يُخلَقِ الخَلقُ إِلّا لِلفَناءِ مَعاً","نَفنى وَتَفنى أَحاديثٌ وَأَسماءُ",29,"ا",2,0],["لَم يَختَلِف في المَوتِ مَسلَكُهُم","لابَل سَبيلاً واحِداً سَلَكوا",30,"ك",3,0],["لَم يُخلقوا وبهم من نفسهم عِلَلٌ","لكن حضارةُ هذا العالمِ الداءُ",31,"ا",2,0],["لم يخلق الله من جمالٍ","يلفُّه في سَنِيِّ بُرد",32,"د",1,0],["لَم يَخرج الدرُّ الَّذي زينت به","إلّا بغوصٍ في البُحورِ قَريبِ",33,"ب",1,0],["لَم يُخطِىءِ الرَأيَ غيلانٌ وَشيعَتُهُ","إِن لَم تَكُن أَخطَأَت فيكَ المَقاديرُ",34,"ر",1,0],["لَم يَخُنكِ الوِدادَ لا","لا وَرَبِّ المَواسِمِ",35,"م",1,0],["لَم يُخطِ سَهمُكِ إِذ رَميتِ مَقاتِلي","وَتَطيشُ عَنكِ إِذا رَمَيتُكِ أَسهُمي",36,"م",2,0],["لم يَخلقِ اللهُ القويَّ بِمُلكهِ","لِيكونَ وَحشيَّ الطّباعِ غَشوما",37,"م",2,0],["لَم يَخذُلوهُ وَلا أَضاعوا حَقَّهُ","في شِدَّةٍ مِن أَمرِهِم وَلَيانِ",38,"ن",1,0],["لم يخذلُوهُ ولم تَفُتْهُ كرامةٌ","هم عند نُصرتِهِ وفي إكرامِهِ",39,"م",2,0],["لم يخْل ميدانُ الجهاد بسَجْنه","فلقد رماه بقلبه المتسعّرِ",40,"ر",1,0],["لَم يَخل مِنكَ الذكر في وَطَن وَما","بَرِحَت لِذكرك لَوعة تَتَجَدَد",41,"د",1,0],["لَمْ يَخْفَ عَنْ عِلْمِهِ في الأرضِ خافِيَةٌ","كأَنَّهُ لِلْوُجُودِ السَّمْعُ والبَصَرُ",42,"ر",1,0],["لم يخْلُ جَبّارُ المُلوكِ بِذِكْرِهِ","إلاّ تَشَحَّطَ في الدماء قتيلا",43,"ل",2,0],["لم يَخلُ مَطلَعُها ولا أفَلَتْ","وبنو أبيها الأنجُمُ الزُّهُرُ",44,"ر",1,0],["لَم يَخشَ في شَهرِ الصِيامِ رَبَّه","يا رَبَّنا لا تَغفِرَنَّ ذَنبَه",45,"ب",2,0],["لَم يَختَرِق كَرَماً بَي","نَنا بِوِدٍّ رَسولُ",46,"ل",1,0],["لَم يَخلُقِ اللَهُ مِثلَهُ بَشَراً","سُبحانَ ذي الكِبرِياءِ وَالمِنَنِ",47,"ن",1,0],["لم يخوضوا غمارها قبل أن تح","كم فيها الآراء والتدبير",48,"ر",1,0],["لم يخلق الرحمن مثل محمدٍ","أحداً وظني أنه لا يخلق",49,"ق",1,0],["لم يَخلُ من شرها ماءٌ ويابسةٌ","أو تنجُ من غدرها غابٌ وصحراءُ",50,"ا",2,0],["لمْ يَخْبو أشواقُ الحياةْ بها","فَغَادَرَها القُطُوبْ",51,"ب",1,0],["لَمْ يُخَيِّبُ مَا دَامَ حَيّاً لَهَا سُؤْ","لاً وَكَائِنْ أَجَابَ قَبْلَ الدُّعَاءِ",52,"ا",2,0],["لَم يَخْشَ إِلاَّ رَبَّهُ فِي حُكْمِهِ","وَنَبَا بِقِيل لِلْوُشَاةِ وَقَالِ",53,"ل",1,0],["لمْ يَخَلْ ذِلكَ نَيرُونُ وَلَمْ","يَرَ مَنْ يَأْمِنُهَا يَأْمِنُ وَتْرَا",54,"ر",2,0],["لمْ يُخْطِيءِ الدَّاعِيكَ بِالْقاضِي إِذَا","عُنِيَ الَّذِي لاَ تحْرِفُ الأَوْطَارُ",55,"ر",1,0],["لَمْ يَخَالوا عِنَايَةَ اللهِ حَلَّتْ","وَهْيَ مِنْهُمْ بِمَسْمَعٍ وَبِمَشْهَدْ",56,"د",1,0],["لَمْ يَخْنْكِ الوَفَاءُ طَرْفَةَ عَيْنٍ","وَأَبَى المَجْدُ وَالعُلَى أَنْ تَخُونِي",57,"ن",2,0],["لَم يَخلُقِ اللَهُ في الدُنيا لَها شَبَهاً","إِنّي لَأَحسَبُها لَيسَت مِنَ البَشَرِ",58,"ر",1,0],["لم يَخْلُ منكَ مكانٌ قد تركتَ به","ما يملأُ الأرضَ من ذكرٍ وتخليد",59,"د",1,0],["لم يختلف في ذا اثنان","وماله في خذلان",60,"ن",1,0],["لم يَختر الناسُ دياناتِهم","بل أخذوا بالمذاهب السائد",61,"د",1,0],["لم يخلقُ الناس من در ومن خزَف","الناس -مهما عَلَوْا- للنَّاس أشباه",62,"ا",2,0],["لم يُخْلق الدمعُ لامريءٍ عبثا","اللَّهُ أدرَى بلوعة ِ الحزن",63,"ن",1,0],["لَم يَخل ذا القَلب مِن غَرام","وَلَم يَكُن غَيرُهُ نَصيبي",64,"ي",1,1],["لم يخف عن مولاك من كل الذي","تجريه انت كبائر وصغائر",65,"ر",1,0],["لم يخلق اللَه في لغير الز","زفير فليفرح العذول",66,"ل",1,0],["لم يخب من كانَ يرجو ربَّهْ","عفوك اللهم يا رب الأنام",67,"م",1,0],["لَم يَخُنهَا ولَم تَخُنهُ ولَكِن","شَفَّهَا جَذبُهَا البُرَى وبَرَاهَا",68,"ا",3,0],["لَم يُخَف مِنهُم لَدَى السِّلمِ بَأسٌ","ولَدَى الحَربِ كالأُسُودِ الضَّوَارِي",69,"ر",2,0],["لم يخلق الله الحميّا عابثا","وكذاك ما خُلقت جهنم ملعبا",70,"ب",2,0],["لم يخلق الرحمن شيئاً عابثاً","فالخمر ما خلقت لأن تُتجنّبا",71,"ب",2,0],["لَم يَخلُ مِن فَرَحٍ بِنَصرِكَ فَليَدُم","قَلبٌ وَلا مِن ذِكرِ فَتحِكَ مَوضِعُ",72,"ع",1,0],["لم يخلُ من ثَمَراتِ الفَضلِ مُذ غُرست","يداهُ فيها من القصباءِ أَغصانا",73,"ن",2,0],["لَم يَخفَ حُبُّكُما وَلَكِن لَيسَ لي","رَأيٌ يُطاعُ فَقَرِّبا أَو بَعِّدا",74,"د",2,0],["لميخائيلَ تمَّ قِرانُ سعدٍ","غَدا نَجمُ الهَناءِ لَهُ قَرينا",75,"ن",2,1],["لم يَخْصُصوه بشكرهم إلا وقد","عمَّت جميعَهُمُ به النَّعماءُ",76,"ا",2,0],["لم يخلق اللَهُ في خلائقه","أحسنَ من محسنٍ إذا قدرا",77,"ر",2,0],["لم يخش من بذل النوال منازعا","وكفاك ان الجود من راحاتها",78,"ت",3,0],["لم يخلق اللَه وجهاً مثل طلعته","إذا تراءى لأحلامي وأهوائي",79,"ي",1,0],["لم يخلق اللَه من حسن يماثله","غير الوفاء بقلبٍ منه معمود",80,"د",1,0],["لم يَخلُق اللَهُ الشَهامةَ في امرىءٍ","إِلّا لخير قد أَراد وَدبَّرا",81,"ر",2,0],["لم يخلق الله فيك ساقطة","تُسخن عين العلا ولا كَدرا",82,"ر",2,0],["لم يخلُ قلبيَ من ذِكرْ العزيز وإن","نأي به شُغُلٌ أو عاقه قَدَرُ",83,"ر",1,1],["لَم يَخلُ مِنها مَن يُحَصِّنُها كَما","لَم يَخلُ مِن أَلطافِ بِرِّكَ مَوضِعُ"