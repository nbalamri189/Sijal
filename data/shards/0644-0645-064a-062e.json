"ع",1,0],["لَم يَخلُفوها في الشَهيدِ وَقَد رَأى","دُفَعَ الفُراتِ يذادُ عَن أَورادِها",1,"د",3,0],["لَم يُخَلّوا بَني رِزاحٍ بِبَرقا","ءِ نِطاعٍ لَهُم عَلَيهُم دُعاءُ",2,"ا",2,0],["لَم يَخرُجوا قَيدَ شِبرٍ","عَن مَسبَحِ الحيتانِ",3,"ن",1,0],["لَم يُخجِلوها بِالسُؤالِ عَنِ اِسمِها","تِلكَ المُروءَةُ وَالشُعورُ العالي",4,"ل",2,0],["لَمْ يُخْطِيءِ التَّوفِيقُ صَاحِبَهُ","فِيمَا أَرَدْتَ بِنَاءهُ فَبُنِي",5,"ن",2,1],["لَمْ يَخْتَدِعْ عَرَضٌ حِجَاكَ وَلَمْ يَجُرْ","بِكَ عَنَّ طَرِيقِ الجَوْهَرِ المَكْنُونِ",6,"ن",1,0],["لَمْ يَخْشَ فِي الْحَقِّ المَلاَمَ وَلَمْ يَكُنْ","لِسِوَى الضَّمِيرِ عَلَيْهِ مِنْ سُلْطَانِ",7,"ن",1,0],["لم يَخشَ فتكَ السقم فيها رُضَّعٌ","في البؤس قد ولدوا وفي الأقلال",8,"ل",1,0],["لَم يُخزِ أَوَّلَ يَربوعٍ فَوارِسُهُم","وَلا يُقالُ لَهُم كَلّا إِذا اِفتَخَروا",9,"ر",3,0],["لم يخجل الورد المورّد لونه","إلا وناحِلُه الفضيلةَ عاندُ",10,"د",1,0],["لم يخل نائلُهُ ولا آراؤه","من سدِّ خلّاتٍ ورأب صُدوع",11,"ع",1,0],["لم يخل دهر فيه إسماعيله","من أمن خائفه وخوف مخيفه",12,"ف",2,0],["لم يخالطهُمُ من الحمأ المس","نونِ إلا طيفٌ كطيف الخيالِ",13,"ل",1,0],["لم يخيموا عَنِ النزال ولكن","نزل النصرُ قبلَ دعوى نَزالِ",13,"ل",1,0],["لم يُخْلق الدمعُ لامرئٍ عبثاً","اللَّهُ أدرَى بلوعةِ الحزنِ",14,"ن",1,0],["لم يخل يوماً من نجِيِّ تقيّةٍ","تدعو إلى المعروف والإحسان",15,"ن",1,0],["لم يخل من أير ومن عَيْبةٍ","مُذْ شُقَّ فوهُ لمُناغيهِ",16,"ي",2,0],["لَم يَختَرِمكِ المَوتُ يا دَوحَةً","باسِقَةً قَد خَلَّفَت باسِقات",17,"ت",1,0],["لَم يَخلُ مِنهُ أَخو الثَراءِ","وَلا الفَتى البائِسُ العَديمُ",18,"م",1,0],["لَم يَخُنكُم سِوى دُمو","عِيَ أَظهَرنَ سِرَّكُم",19,"م",1,0],["لَم يَخلُ مِن جَدٍّ بِها أَو لَعبٍ","مِن المَيادين إِلى حَرِّ الرَحى",20,"ا",1,0],["لَم يَخَف في حَياتِهِ شَبَحَ الفَق","رِ إِذا طافَ بِالرِجالِ مَهولا",21,"ل",2,0],["لَم يَخلِقِ الرَحمَنُ أَك","بَرَ مِنهُما في البَرِّ آيَه",22,"ا",3,0],["لَم يَختَرِع شَيطانَ حَسّانٍ وَلَم","تُخرِج مَصانِعُهُ لِسانَ زِيادِ",23,"د",1,0],["لَم يَخلُ مِن صُوَرِ الحَياةِ وَإِنَّما","أَخطاهُ عُنصُرُها فَماتَ وَليدا",24,"د",2,0],["لَم يَخلُقِ الرَحمَنُ مِثلَ مُحَمَّدٍ","أَبَداً وَظَنّي أَنَّهُ لا يَخلُقُ",25,"ق",1,0],["لَم يُخطِ مَأبِضَ خُلساتٍ تَعَمَّدَها","فَشَكَّ ذا الشُعبَةِ الطولى فَلَم يُصِبِ",26,"ب",1,0],["لَم يَخُن رَبَّها وَلَم يُعمِلِ التَد","بيرِ في حَلِّ تاجِها المَعقودِ",27,"د",1,0],["لم يخلُ من رِفدِها نَديمٌ","يومَ خُمارٍ ولا نِدامِ",28,"م",1,0],["لَم يُخلَقِ الخَلقُ إِلّا لِلفَناءِ مَعاً","نَفنى وَتَفنى أَحاديثٌ وَأَسماءُ",29,"ا",2,0],["لَم يَختَلِف في المَوتِ مَسلَكُهُم","لابَل سَبيلاً واحِداً سَلَكوا",30,"ك",3,0],["لَم يُخلقوا وبهم من نفسهم عِلَلٌ","لكن حضارةُ هذا العالمِ الداءُ",31,"ا",2,0],["لم يخلق الله من جمالٍ","يلفُّه في سَنِيِّ بُرد",32,"د",1,0],["لَم يَخرج الدرُّ الَّذي زينت به","إلّا بغوصٍ في البُحورِ قَريبِ",33,"ب",1,0],["لَم يُخطِىءِ الرَأيَ غيلانٌ وَشيعَتُهُ","إِن لَم تَكُن أَخطَأَت فيكَ المَقاديرُ",34,"ر",1,0],["لَم يَخُنكِ الوِدادَ لا","لا وَرَبِّ المَواسِمِ",35,"م",1,0],["لَم يُخطِ سَهمُكِ إِذ رَميتِ مَقاتِلي","وَتَطيشُ عَنكِ إِذا رَمَيتُكِ أَسهُمي",36,"م",2,0],["لم يَخلقِ اللهُ القويَّ بِمُلكهِ","لِيكونَ وَحشيَّ الطّباعِ غَشوما",37,"م",2,0],["لَم يَخذُلوهُ وَلا أَضاعوا حَقَّهُ","في شِدَّةٍ مِن أَمرِهِم وَلَيانِ",38,"ن",1,0],["لم يخذلُوهُ ولم تَفُتْهُ كرامةٌ","هم عند نُصرتِهِ وفي إكرامِهِ",39,"م",2,0],["لم يخْل ميدانُ الجهاد بسَجْنه","فلقد رماه بقلبه المتسعّرِ",40,"ر",1,0],["لَم يَخل مِنكَ الذكر في وَطَن وَما","بَرِحَت لِذكرك لَوعة تَتَجَدَد",41,"د",1,0],["لَمْ يَخْفَ عَنْ عِلْمِهِ في الأرضِ خافِيَةٌ","كأَنَّهُ لِلْوُجُودِ السَّمْعُ والبَصَرُ",42,"ر",1,0],["لم يخْلُ جَبّارُ المُلوكِ بِذِكْرِهِ","إلاّ تَشَحَّطَ في الدماء قتيلا",43,"ل",2,0],["لم يَخلُ مَطلَعُها ولا أفَلَتْ","وبنو أبيها الأنجُمُ الزُّهُرُ",44,"ر",1,0],["لَم يَخشَ في شَهرِ الصِيامِ رَبَّه","يا رَبَّنا لا تَغفِرَنَّ ذَنبَه",45,"ب",2,0],["لَم يَختَرِق كَرَماً بَي","نَنا بِوِدٍّ رَسولُ",46,"ل",1,0],["لَم يَخلُقِ اللَهُ مِثلَهُ بَشَراً","سُبحانَ ذي الكِبرِياءِ وَالمِنَنِ",47,"ن",1,0],["لم يخوضوا غمارها قبل أن تح","كم فيها الآراء والتدبير",48,"ر",1,0],["لم يخلق الرحمن مثل محمدٍ","أحداً وظني أنه لا يخلق",49,"ق",1,0],["لم يَخلُ من شرها ماءٌ ويابسةٌ","أو تنجُ من غدرها غابٌ وصحراءُ",50,"ا",2,0],["لمْ يَخْبو أشواقُ الحياةْ بها","فَغَادَرَها القُطُوبْ",51,"ب",1,0],["لَمْ يُخَيِّبُ مَا دَامَ حَيّاً لَهَا سُؤْ","لاً وَكَائِنْ أَجَابَ قَبْلَ الدُّعَاءِ",52,"ا",2,0],["لَم يَخْشَ إِلاَّ رَبَّهُ فِي حُكْمِهِ","وَنَبَا بِقِيل لِلْوُشَاةِ وَقَالِ",53,"ل",1,0],["لمْ يَخَلْ ذِلكَ نَيرُونُ وَلَمْ","يَرَ مَنْ يَأْمِنُهَا يَأْمِنُ وَتْرَا",54,"ر",2,0],["لمْ يُخْطِيءِ الدَّاعِيكَ بِالْقاضِي إِذَا","عُنِيَ الَّذِي لاَ تحْرِفُ الأَوْطَارُ",55,"ر",1,0],["لَمْ يَخَالوا عِنَايَةَ اللهِ حَلَّتْ","وَهْيَ مِنْهُمْ بِمَسْمَعٍ وَبِمَشْهَدْ",56,"د",1,0],["لَمْ يَخْنْكِ الوَفَاءُ طَرْفَةَ عَيْنٍ","وَأَبَى المَجْدُ وَالعُلَى أَنْ تَخُونِي",57,"ن",2,0],["لَم يَخلُقِ اللَهُ في الدُنيا لَها شَبَهاً","إِنّي لَأَحسَبُها لَيسَت مِنَ البَشَرِ",58,"ر",1,0],["لم يَخْلُ منكَ مكانٌ قد تركتَ به","ما يملأُ الأرضَ من ذكرٍ وتخليد",59,"د",1,0],["لم يختلف في ذا اثنان","وماله في خذلان",60,"ن",1,0],["لم يَختر الناسُ دياناتِهم","بل أخذوا بالمذاهب السائد",61,"د",1,0],["لم يخلقُ الناس من در ومن خزَف","الناس -مهما عَلَوْا- للنَّاس أشباه",62,"ا",2,0],["لم يُخْلق الدمعُ لامريءٍ عبثا","اللَّهُ أدرَى بلوعة ِ الحزن",63,"ن",1,0],["لَم يَخل ذا القَلب مِن غَرام","وَلَم يَكُن غَيرُهُ نَصيبي",64,"ي",1,1],["لم يخف عن مولاك من كل الذي","تجريه انت كبائر وصغائر",65,"ر",1,0],["لم يخلق اللَه في لغير الز","زفير فليفرح العذول",66,"ل",1,0],["لم يخب من كانَ يرجو ربَّهْ","عفوك اللهم يا رب الأنام",67,"م",1,0],["لَم يَخُنهَا ولَم تَخُنهُ ولَكِن","شَفَّهَا جَذبُهَا البُرَى وبَرَاهَا",68,"ا",3,0],["لَم يُخَف مِنهُم لَدَى السِّلمِ بَأسٌ","ولَدَى الحَربِ كالأُسُودِ الضَّوَارِي",69,"ر",2,0],["لم يخلق الله الحميّا عابثا","وكذاك ما خُلقت جهنم ملعبا",70,"ب",2,0],["لم يخلق الرحمن شيئاً عابثاً","فالخمر ما خلقت لأن تُتجنّبا",71,"ب",2,0],["لَم يَخلُ مِن فَرَحٍ بِنَصرِكَ فَليَدُم","قَلبٌ وَلا مِن ذِكرِ فَتحِكَ مَوضِعُ",72,"ع",1,0],["لم يخلُ من ثَمَراتِ الفَضلِ مُذ غُرست","يداهُ فيها من القصباءِ أَغصانا",73,"ن",2,0],["لَم يَخفَ حُبُّكُما وَلَكِن لَيسَ لي