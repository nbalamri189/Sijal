لِيفُ غَرامٍ عَزَّ مِنْهُ اصْطِبارُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=63515",""],[5616,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=203475",""],[5648,"خدك الوردي","https://www.poetsgate.com/ViewPoem.aspx?id=155978",""],[5674,"حزن المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=198680",""],[5747,"إن تباطيت ماابطيت","https://www.poetsgate.com/ViewPoem.aspx?id=61684",""],[5756,"أهل الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=34581",""],[5790,"ولم تر عيناي من قبله","https://www.poetsgate.com/ViewPoem.aspx?id=112165",""],[5790,"الله أكبر أي طرف يطمح","https://www.poetsgate.com/ViewPoem.aspx?id=111868",""],[5956,"الجنس اللطيف","https://www.poetsgate.com/ViewPoem.aspx?id=182619",""],[5956,"لا أستطيع الانتظار لثانية ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182632",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[5956,"أنا وشقيقي والحمامة","https://www.poetsgate.com/ViewPoem.aspx?id=184560",""],[5956,"اشتقت إليك، أ لَمْ تشتق؟","https://www.poetsgate.com/ViewPoem.aspx?id=193798",""],[5957,"قلبي يئن","https://www.poetsgate.com/ViewPoem.aspx?id=213542",""],[5961,"يسير بك المهيمن","https://www.poetsgate.com/ViewPoem.aspx?id=199772",""],[6007,"احفظ لسَانك لَا أَقُول فَإِن أقل","https://www.poetsgate.com/ViewPoem.aspx?id=190366",""],[6008,"رثاء بالشيوخ (مهل القعقاع -مساعد البنيه )","https://www.poetsgate.com/ViewPoem.aspx?id=60996",""],[6032,"غرام وشجون","https://www.poetsgate.com/ViewPoem.aspx?id=181505",""],[6102,"تحذير ..","https://www.poetsgate.com/ViewPoem.aspx?id=183311",""],[6190,"إباء الورد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86998&r=&rc=4",""],[6225,"حلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80912&r=&rc=181",""],[463,"ما نازلٌ بمنْ علا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60117&r=&rc=173",""],[6252,"مَدينَةُ الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79809&r=&rc=4",""],[5190,"صوتٌ من القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78349&r=&rc=62",""]],"verses":[["وَأَعيرانيَ طَرْفاً","شَرِقاً بالعَبَراتِ",0,"ت",1,0],["وَأُعِيدَ الاسْتِقْلالُ مُنْتَزَعاً","مِنْ عَادِيَاتِ الدَّهْرِ وَالمِحَنِ",1,"ن",1,0],["وَأَعيُنَ العَينِ بِأَعلى خَوَّدا","أَلِفنَ ضالاً ناعِماً وَغَرقَدا",2,"د",2,0],["وَأَعيَسَ قَد كَّلَفتُهُ بُعدَ شُّقَةٍ","تَعَقَّدَ مِنها أَبيَضاهُ وَحالِبُه",3,"ب",2,0],["وأعين النرجس المطلول يانعة","ترقرقَ الطلّ دمعاً في مآقيها",4,"ي",3,0],["وَأَعيَينا أَباكَ أَبا غُوَيثٍ","فَأَعيا عَن مُجاهَدَةِ الخُصومِ",5,"م",1,0],["وَأَعيُنُهُم مِثلُ الزُجاجِ وَصيغَةٌ","تُخالِفُ كَعباً في لَحىً لَهُمُ ثُطِّ",6,"ط",1,0],["وأعيا فصيح الوصف بنت عذاره","وعير قسّا بالفهاهة باقل",7,"ل",1,0],["وأعيذه من أن يراني مقسماً","أن لست أفتح بالسؤال فماً لهُ",8,"ه",1,0],["وأعيانُ غِزلانٍ مِراضٍ جُفونُها","لواحظُها في كل نفسٍ عوائثُ",9,"ث",1,0],["وَأُعيدُها لَكَ لا عَدِم","تَ بِعَينِها وَكما هِيَه",10,"ي",2,0],["وأَعيشُ عِيشَةَ زاهدٍ متَنَسِّكٍ","مَا إنْ تُدَنِّسْهُ الحَيَاةُ بِذَامِ",11,"م",1,0],["وأعينٍ تذيب قل","ب الفارس المستلئم",12,"م",1,0],["وَأُعيدَ المَجدُ القَديمُ وَقامَت","في مَعالي آبائِها الأَبناءُ",13,"ا",2,0],["وَأَعيا أَبا حَفصٍ فَكَسَّرتَ عَنهُمُ","عَلى أَسوُقٍ أَسرى الحَديدَ المُسَمَّرا",14,"ر",2,0],["وَأَعيَسَ مَخلوجٍ عَنِ الشَولِ مُلبِدٍ","فَنابانِ مِن أَنيابِهِ غَرِدانِ",15,"ن",1,0],["وَأَعيُنُ الأُسدِ إِذا جَنَّ الدُجى","أَذكَت لَنا أَحداقُها مَشاعِلا",16,"ل",2,0],["وَأُعيذُ سِرَّكَ أَن يَكابِدَ بَعضَ ما","لاقَيتُ مِن قيلِ العَذولِ وَقالِهِ",17,"ل",2,0],["وأعينُ الخلقِ منه كلما نَظَرَتْ","على العجائب بالألحاظ تَزْدحِمُ",18,"م",1,0],["وَأَعيُنُ الخَلقِ تُعطي فَوقَ ما سُئِلَت","عَلَيكَ وَالصَبرُ يُعطى دونَ ما يَسَلُ",19,"ل",1,0],["وَأَعيُنُ رَبرَبٍ كُحِلَت بِسِحرٍ","وَأَجسادٌ تُضَمَّخُ بِالجَسادِ",20,"د",1,0],["وأُعِيذُ مَجْدَكَ أنْ يكونَ بِطائِفٍ","مِنْ حاسِدٍ بِنَمِيمَةٍ مَمسوسا",21,"س",2,0],["وأعيت القومَ كل مشكلة","ملتبسٌ حقها بباطلها",22,"ل",3,0],["وأعيَا الحروريّينَ مُتَّقِدُ النُّهَى","مُظاهِرُ عِقدِ الحزْمِ بالحزْم موثِقُه",23,"ق",2,0],["وأعْيَت فلم يَحمِلْ بها بَزَّ فارسٍ","حِصانٌ ولم يثبُتْ على ظهرِها لِبد",24,"د",1,0],["وَأَعيُنٍ أَصفى مِنَ البِلَّورِ","في لامِعٍ مِن حُمرَةٍ مُنيرِ",25,"ر",1,0],["وَأُعيذُهُ مِن أَن يَكونَ لَهُ","ما تَحتَ مِئزَرِها مِنَ الرَجسِ",26,"س",1,0],["وَأَعينا اِمرَأً جَفا وُدَّهُ الحَيُ","وَأَمسى مِنَ الهَوى في عَناءِ",27,"ا",2,0],["وَأَعيارٍ صَوادِرَ عَن حَماتا","لِبَينِ الكَفرِ وَالبُرَقِ الدَواني",28,"ي",1,1],["وأعْيَسَ لو وافى به خُرْقَ مِخْيَطٍ","لأنْفَذَهُ من ضُمْرِهِ وانضِمامهِ",29,"م",2,0],["وأعِيدِي حَضَارةً زانَتْ الدُّنْيَا فكم","وَدَّتِ المُنَى أَنْ تُعِيدِي",30,"د",2,0],["وأَعيشُ في دُنْيَا الْخيالِ لأنَّني","أَحْظَى بها بالفائت المفْقُودِ",31,"د",1,0],["وأعير الحزين سحر بياني","فيعزّيه لو يعار البيان",32,"ن",1,0],["وأعينُ آمالي إليكِ نواظرٌ","لما أنا من عادات فضلك عائدُ",33,"د",1,0],["وأعيني على البكا يا مآقي","فعلى البؤس كل خل يعينُ",34,"ن",1,0],["وَأُعيذُ مَجدَكَ مِن عَطايا جَمَّةٍ","أَبغي لَها التَكميلَ وَالتَتميما",35,"م",2,0],["وأَعينُ الغيثِ تجري","لَها انهمالٌ وسَكْبُ",36,"ب",1,0],["وأعينا تجرى إذا خالطها إِلا","نسان أنشت فيه روحا أخرى",37,"ر",2,0],["وَأُعيذُ مَجدَكَ أَن يَقولوا باخِلٌ","وَأبوكَ مُحيي بالِياتِ رُفاتِها",38,"ت",3,0],["وَأُعيذُ مَجدَكَ أَن أُقابِلَ مِثلَها","مِن حَيثُ أَنتَ وَسَيبُكَ المُتظاهِرُ",39,"ر",1,0],["وأعيش أيام الحياة","على التجمل والتوافي",40,"ف",2,0],["وأعيذها ما شعشعت","من كل مأفون لئيم",41,"م",1,0],["وأعيى كفها الشعرُ اختلافاً","كما تعيى الهدايةُ بالضلالِ",42,"ل",1,0],["وأعيني ما تزالُ واكفةً","وأضلعي ما تزالُ تتقدُ",43,"د",1,0],["واعين الطل در الدمع قد نثرت","والروض يضحك عجبا من تباكيها",44,"ي",3,0],["واعينها مما بكت قد تفجرت","ولا عجب والله ان تتشهدا",45,"د",2,0],["وأعين من فتون","لو شفتموها فتنتم",46,"م",1,0],["وأعين منه حالماتٌ","كأنها خاطر شرود",47,"د",1,0],["وأعين حالمات","بهن ثار غرامي",48,"ي",1,0],["وَأَعيُنٌ أَربَعٌ تبكى عَلَيكَ أَسىً","وَمن بُكاءِ الثَكالى السَيلُ وَالمَطَرُ",49,"ر",1,0],["وَأَعيُنُ اللَهوِ شَوقاً","إِلى أَياديكَ صورُ",50,"ر",1,0],["وأعيا على بأس الرجال انقيادُها","وعاشَ زماناً سَيفُها لم يُثَلَّمِ",51,"م",1,0],["وأعينَ العينِ من للعينِ إن نظرت","بلحظِكِ الفاتِرِ الأجفانِ والشاكي",52,"ك",2,0],["وَأَعين الماء قَد أَجرَت سَواقيها","وَالأَعين النجل قَد جارَت سَواقيها",53,"ي",3,0],["واعين الشقيق حمر شهل","من رمد سوادهن الكحل",54,"ل",1,0],["وأعيذُهُم إذْ لَمْ يُلقِنا جَانِبٌ","مِنْ أن تَطولَ قَطيعَةٌ وتجنُّبُ",55,"ب",1,0],["وأَعيدا مَديح يحيى ليحيا","مَيتُ هَجرٍ قد عزَّ منه الشِفاءُ",56,"ا",2,0],["وأعينوا على الزمان غريباً","يشتكي جدب عيشه ومحوله",57,"ل",2,0],["وَأَعيُنُ الماءِ خانَتها غَزارَتُها","وَساءَ ساوَةً إن غارَت بُحَيرَتُها",58,"ه",2,0],["وأعيدي إليّ فجري فقد ضق","تُ بصمتي وظلمتي وانتظاري",59,"ر",2,0],["وأعيدي ما تغنّاه الوجود","من أغاريدك في فجر الصبا",60,"ب",2,0],["وَأَعيذُ نَفسي بِالهَوى مِن أَن أُرى","مِن جَورِ حُكّامِ الهَوى مُتَعَوِّذا",61,"ذ",2,0],["واعيدوا وكرروا الذكر علي","من سقامي يهون لي الاضطرام",62,"م",1,0],["وَأعيَادُ هَذَا الفَتحِ بَاهِرَةٌ فَلا","شَعانِينُ دَيرٍ بَعدَهُنّ ولا فَصحُ",63,"ح",1,0],["وأُعيرَ مَنْكِبُه قَباءً فابْتَنى","مَجْداً لأتراكِ الزّمانِ أثيلا",64,"ل",2,0],["وَأَعْيُنُ آمالي إليكِ نواظِرٌ","بِمَا أَنَا مِنْ عاداتِ فضلِكِ عائدُ",65,"د",1,0],["وَأَعيَنَ كَالذَرِّيِّ في سَفَلاتِهِ","سَوادٌ وَأَعلى ظاهر اللَونِ واضِح",66,"ح",1,1],["وأعيدي مني إذا شئت للطي","ن فتاة تبكي على كل حيّ",67,"ي",1,0],["وأعين الزهر شاخصاتٌ","تحسب فيها الرَّذاذَ دمعا",68,"ع",2,0],["وأعيدوا ما كانَ منَّا ومنكم","وليَكُنْ ما جَرى على المعتاد",69,"د",1,0],["وأعيدي شكوى الغرام عَلَيْنا","واجهدي لا شقيتِ أنْ تسعدينا",70,"ن",2,0],["وأَعْيا بآراءِ التَّرَضِّي وزيرُهُ","وأَنْفَذَ أَلفاظَ التَّذَلُّلِ كاتِبُهْ",71,"ب",2,0],["واعير سارية الصبا","وأجر بالعلمين بردي",72,"د",2,0],["وأعيدوا الوجد القديم فقد حا","ن ارتكاض طوع المنى في مَجاله",73,"ل",2,0],["وأعين لم يحصهن","نَ بحسابٍ من ضبطْ",74,"ط",1,0],["وأعينٌ موكَّلاتٌ بالحمى","من مستقيم اللحظ أو مُخازرِ",75,"ر",1,0],["وأعينٌ تحسبها قريرةً","نائمةً عن أعينٍ سواهرِ",75,"ر",1,0],["واعيسَ يذرعُ الفلواتِ وخداً","يطيرُ على خُطاهُ الَهيِّبانُ",76,"ن",1,0],["وأُعيدُ الكَلامَ والحُبُّ قَوْلي","أَنا لولاهُ ما عرفْتُ الكَلاما",77,"م",2,0],["وأعيَتْ محاسنُه أن تنالَ