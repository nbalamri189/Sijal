{"poems":[[9,"هل أنت يا مصلات مب","https://www.aldiwan.net/poem21972.html","مجزوء الكامل"],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[10,"يا ابن الشريد على تنائي بيننا","https://www.aldiwan.net/poem20947.html","الكامل"],[10,"يا ابن الشريد وخير قيس كلها","https://www.aldiwan.net/poem21076.html","الكامل"],[29,"انظر خليلي بأعلى ثرمداء ضحى","https://www.aldiwan.net/poem5927.html","البسيط"],[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[31,"بانت سعاد ففي العينين تسهيد","https://www.aldiwan.net/poem6030.html","البسيط"],[31,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[31,"هل تعرف اليوم من ماوية الطللا","https://www.aldiwan.net/poem6034.html","البسيط"],[87,"وممهد في الوكر","https://www.aldiwan.net/poem7930.html","مجزوء الكامل"],[47,"فيم ابتداركم الملام ولوعا","https://www.aldiwan.net/poem64665.html","الكامل"],[30,"ولنا قراسية تظل خواضعا","https://www.aldiwan.net/poem5475.html","الكامل"],[68,"ضحكت ثغور حدائق الأرض","https://www.aldiwan.net/poem38487.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[122,"ما بالرزايا وما بالنأي من باس","https://www.aldiwan.net/poem492.html",""],[132,"ثلاث بهن المرء يزداد قوة","https://www.aldiwan.net/poem50656.html","الطويل"],[135,"لا نهض في مثل زماني الأول","https://www.aldiwan.net/poem23996.html","الرجز"],[302,"على الزعازع والأهوال والبأس","https://www.aldiwan.net/poem36834.html","البسيط"],[335,"إني أتتني لسان ما أسر بها","https://www.aldiwan.net/poem518.html",""],[341,"ماذا يهيجك من ذكر ابنة الراقي","https://www.aldiwan.net/poem45424.html","البسيط"],[407,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[464,"الله جارك من أخي شرف","https://www.aldiwan.net/poem15448.html","أحذ الكامل"],[467,"وجه الحبيب شهية ألطافه","https://www.aldiwan.net/poem3540.html","عموديه"],[503,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[889,"","https://poetry.dctabudhabi.ae/diwan/poem/105719","الكامل"]],"verses":[["ضَخمِ الجُزارَةِ سابِحٍ","عَبلٍ يُضَمَّرُ بِالأَصائِل",0,"ل",1,0],["ضَخمٌ مُقَلَّدُها فَعَمٌ مُقَيَّدُها","في خَلقِها عَن بَناتِ الفَحلِ تَفضيلُ",1,"ل",1,0],["ضَخمَ الدَسيعَةِ بِالنَدى مُتَدَفِّقاً","مَأوى اليَتيمِ وَغايَةَ المُنتابِ",2,"ب",1,0],["ضَخمَ الدَسيعَةِ ماجِداً أَعراقُهُ","كَالبَدرِ أَو في طَلعَةٍ كَالأَسعُدِ",3,"د",1,0],["ضَخمُ الدَسيعَةِ وَالأَبياتِ غُرَّتُهُ","كَالبَدرِ لَيلَةَ كادَ الشَهرُ يَنتَصِفُ",4,"ف",1,0],["ضَخمٍ قَريبِ الدَستَبانِ جِدّا","يَلقى الَّذي يَحمِلُ مِنهُ كَدّا",5,"د",2,0],["ضخمُ الدّسيعةِ والفعا","لِ نبيهُ مملكةٍ ذَكيرُ",6,"ر",1,0],["ضَخمُ المِلاطَينِ مَوّارُ الضُحى هَزِجٌ","كَأَنَّ زُبرَتَهُ في الآلِ عُنقودُ",7,"د",1,0],["ضَخمٍ سُرادِقُهُ يُعارِضُ سَيبُهُ","نَفَحاتِ كُلِّ صَبا وَكُلِّ شَمالِ",8,"ل",1,0],["ضَخمٌ تُعَلَّقُ أَشناقُ الدِياتِ بِهِ","إِذا المِئُونَ أُمِرَّت فَوقَهُ حَمَلا",9,"ل",2,0],["ضَخمُ الدِماغِ عَلى الخُلُو","وِ مِنَ الحِجى وَالمَنطِق",10,"ق",1,0],["ضَخمَ الدَسائِعِ لِلمَكارِمِ حافِظاً","بِنَدى يَدَيهِ وَلِلتِلادِ مُضيعا",11,"ع",2,0],["ضَخمِ المَناكِبِ تَحتَ شَجرِ شُؤونِهِ","نابٌ إِذا ضَغَمَ الفُحولَةَ مِقصَلُ",12,"ل",1,0],["ضَخمُ الدَسيعَةِ جودُهُ غَدِقٌ","أَحوى المَرابِعِ أَبيَضُ العِرضِ",13,"ض",1,0],["ضَخْمِ الكَرَادِيسِ لَمْ تُغْمَزْ أَبَاجِلُهُ","مهرت الشدق سامي الهم والنظر",14,"ر",1,0],["ضَخَّموهُ وَأَطالُوا فَيْئَهُ","فَترَامَى يَملأُ الآفاقَ فُجْرَا",15,"ر",2,0],["ضخم الدسيعة قد عمّت فواضلهُ","شرقا وغرباً وأغنَت كلّ مفلاس",16,"س",1,0],["ضخامةُ جسمٍ والرطوبةُ بعدها","وراحَةُ جسمٍ فهي للباهِ مُعْجِبَهْ",17,"ه",1,0],["ضَخمَ الكَراديسِ خَميصَ الأَشكَلِ","ذي حَنجَرٍ رَحبِ وَصَلبٍ أَعدَلِ",18,"ل",1,0],["ضخمٌ تكاد تسدُّ الأفقَ بسطتُه","كالعارِض الجوْنِ إلاّ أنه جاسي",19,"س",2,0],["ضَخْمُ الدّسِيعَةِ متلافٌ أَخُو ثِقةٍ","حَامِي الحَقِيقةِ مِنْهُ الجُودُ والفَخَرُ",20,"ر",1,0],["ضَخمُ الدَسيعَةِ مِتلافٌ أَخو ثِقَةٍ","جَزلُ المَواهِبِ ذو قيلٍ وَمِصداقِ",21,"ق",1,0],["ضخمت أصالة وسقيت فرعاً","وحزت علوم آباء ضخام",22,"م",1,0],["ضخْمُ الدَّسائعِ في صوارمه","ورماحِه ويَراعهِ هَيَفُ",23,"ف",1,0],["ضخم الجزارة لم أزل حتى انطوتْ","انساعهُ ضمراً وطال سنافه",24,"ف",2,0],["ضخمُ المَناقِبِ إذْ تُفَسَّرُ حالُهُ","رحبُ الحضيرَةِ شامِخُ الشُّرُفاتِ",25,"ت",1,0],["ضخمُ الدسيعةِ ماجد","يعطي الجزيلَ بلا كدَر",26,"ر",1,0]]}