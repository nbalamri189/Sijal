{"poems":[[57,"وراضي القلب غضبان اللسان","https://www.aldiwan.net/poem26074.html","الوافر"],[79,"سرى والدجى قد آن منه رحيل","https://www.aldiwan.net/poem36376.html","الطويل"],[37,"فكم من يتامى بوس قد جبرتها","https://www.aldiwan.net/poem39620.html","الطويل"],[95,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[29,"لا خير في مستعجلات الملاوم","https://www.aldiwan.net/poem4454.html","الطويل"],[64,"لقد هاجني والصبح طلق المباسم","https://www.aldiwan.net/poem52267.html","الطويل"],[64,"هو الشوق حتى ما تقر المضاجع","https://www.aldiwan.net/poem52357.html","الطويل"],[107,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202541","الرجز"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30450","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55002","البسيط"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[79,"سرى والدجى قد آن منه رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=34205",""],[128,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[146,"كما قلتما برء الصبابة في الياس","https://www.aldiwan.net/poem58452.html","الطويل"],[240,"عسى قاعد الحظ يوما يثب","https://www.aldiwan.net/poem32180.html","المتقارب"],[246,"سقاها وحيا تربها وابل القطر","https://www.aldiwan.net/poem45764.html","الطويل"],[276,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[318,"ما بال نفس تطيل شكواها","https://www.aldiwan.net/poem59508.html","المنسرح"],[422,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[438,"نثرن عليه من صدف الخيام","https://www.aldiwan.net/poem12735.html","الوافر"],[438,"هبهم رضوا غير قلبه وطنا","https://www.aldiwan.net/poem12755.html","المنسرح"],[463,"عجبت لمر النفس كيف يضام","https://www.aldiwan.net/poem55871.html","الطويل"],[463,"أصبت لو أحمدت أن أصيبا","https://www.aldiwan.net/poem56297.html","الرجز"],[534,"على عصر الشبيبة كل حين","https://www.aldiwan.net/poem37469.html","الوافر"],[563,"في الكلب عشر خصال كلها حمدت","https://www.aldiwan.net/poem33800.html","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49947","الرجز"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137930",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76025","الطويل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67587","المتقارب"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133189","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72841","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139579",""],[5183,"العجوز","https://www.poetsgate.com/ViewPoem.aspx?id=186415",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5749,"اصل لمحبة","https://www.poetsgate.com/ViewPoem.aspx?id=177112",""],[402,"يا صورة شبهت صخرا بإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=36833",""]],"verses":[["وَراضي القَلبِ غَضبانِ اللِسانِ","لَهُ خُلقانِ ما يَتَشابَهانِ",0,"ن",1,1],["وَرَاضَ اعْتِسَافَ الْبِيدِ حَتَّى شِمَاسِهَا","فَأَصْبَحَ مِنْهَا الصَّعْبُ وَهْوَ ذَلُولُ",1,"ل",1,0],["وَراضَ بِرِفقٍ ما أَرادَ وَلَم تَزَل","رِيَاضَتُهُ حَتّى أَذَلَّ صِعابَها",2,"ب",3,0],["وَرَاضَ كُلَّ هَوْلِ بِهَا حَرشدٍ","دُمىً تَهَاوِيلُهَا آيَاتُ إِحْسَانِ",3,"ن",1,0],["وَراضٍ بَني تَيمِ بنِ مُرَّةَ إِنَّهُم","قُرومٌ تَسامى لِلعُلى وَالمَكارِمِ",4,"م",1,0],["وَراضٍ بِحُكمِ الحَيِّ بَكرِ بنِ وائِلٍ","إِذا كانَ في الذُهلَينِ أَو في اللَهازِمِ",4,"م",1,0],["وراضعَها دَرَّ الحيا متحدّبٌ","يطاوعُه مَرُّ الرياحِ النواسمِ",5,"م",1,0],["وراضٍ بأن يختصَّني البؤسَ منعمٌ","نَداهُ ولا قَرْنُ الغزالةِ شائعُ",6,"ع",1,0],["وراضَ ذويه من بعدِ الإباءِ","فَمُتِّعَ بالسّلامةِ والبقاءِ",7,"ا",2,0],["وراضياً عنها بأغلالها","محتملاً وطأة أثقالها",8,"ه",2,0],["وراض من شكائم الأباة","بهيبة الملك وبالهبات",9,"ت",1,0],["وراضَتْ صِعابِي سطْوةٌ علَوِيَّةٌ","لها بارِقٌ نَحْوَ النَّدى ورُعودُ",10,"د",1,0],["وَرَاضَ دَوْلَتَهُ حَتَّى اسْتَقرَّ بِهَا وَالعَرْشُ","فِي حِصْنِهِ وَالْحِصْنُ مَمْنُوعُ",11,"ع",1,0],["وراضيا بذلة مفتخرا","بأن يعيش خازيا ومزدرى",12,"ا",1,0],["وراض اعتساف البيد حد شماسها","فأصبح منها الصعب وهو كلول",13,"ل",1,0],["وراض قومي على الإذعان رائضهم","على احتمال الأذى من كل إنسان",14,"ن",1,0],["وراضَ الجَموحَ للذَّلولِ برفقهِ","فما بينهم إلا موازينُ قِسطاسِ",15,"س",1,0],["وَراضَت عَطاياهُ حَظي الحَرونَ","فَأَصحَبَ في كَفِّهِ وَاِنجَذَب",16,"ب",1,0],["وراضَ جماحي للزمان وحُكمِه","بما شاءَ من عدلٍ وما شاءَ من جُور",17,"ر",1,0],["وَراضوا عَلى حب الحَبيب نفوسهم","فَكانَ لوجه اللَه ذاكَ التقرب",18,"ب",1,0],["وراضها بالصيام فانقمعت","بالرغم عن غيها ومغراها",19,"ا",3,0],["وراض أهل البغي بالقتل فلن","تسمع في ديارهم إلاَّ الوعى",20,"ا",1,0],["وراضَ جوامحَ الأيامِ حتّى","جرَتْ بيدَيْهِ طيّعةُ اللِجامِ",21,"م",1,0],["وراضَهُ والجِماحُ شيمتُه","فصِرْتُ أقتادُه ولا رسَنا",22,"ن",2,0],["وراضٍ بأوساطِ الأمور فقاعدٌ","وفيه إلى غاياتهنَّ قيامُ",23,"م",1,0],["وراضَ منّي الدهرُ ظَهْرا لم يكن","لو أَنْصَفَ الحظُّ له مَركوبا",24,"ب",2,0],["وَرَاضَ جَوامِحاً مِنْ كُلِّ فَنٍّ","وَصَارَ لِكُلِّ شاردَةٍ يَقُودُ",25,"د",1,0],["وراضيا بيسير من معيشته","ما زال كالقانع المستكمل الدينا",26,"ن",2,0],["وراضَه زمانُهُ","حتى صَفا جَنانُهُ",27,"ه",1,0],["وراضَ شوامخَ الكربات حتى","أطاعت واستماحت منه عذرا",28,"ر",2,0],["وَراضَ لَهُ في العلمِ نَفساً نَفيسَةً","فَقادَت لَهُ آبي المَقادَةِ آبِقا",29,"ق",2,0],["وراضت ربيعةٌ بي صَعبةً","من الأمرِ أحجَمَ عنها مُضرْ",30,"ر",1,0],["وراضِ النفس في طلب المعالي","وسار القصد إذ رام انتفاعه",31,"ع",2,0],["وراض مسائلاً شمست ظهورا","فزحزح ما بهنَّ من الشماسِ",32,"س",1,0],["وراضوا الدهر في قسطاس عدل","أقاموا للوجود به اعوجاجا",33,"ج",2,0],["وراضتها لغايتها العجوز61","وكم والت موليها العجوز62",34,"ز",1,0],["وراضها لهواه وهي طاوية","تحت الحجارة كشحاً مترف الأَدم",35,"م",1,0],["ورا ضهر النسوان يتخبا","هذاحال كل منهو جبان",36,"ن",1,0],["وراض كل أبي هول بها حرد","دمى تهاويلها آيات إحسان",37,"ن",1,0]]}