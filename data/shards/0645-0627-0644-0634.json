{"poems":[[79,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[23,"هل تعرف الدار عفا رسمها","https://www.aldiwan.net/poem21428.html","السريع"],[47,"أرق العين أن قرة عيني","https://www.aldiwan.net/poem66693.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[96,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[369,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[563,"ربنا الله ذلك المتعالي","https://www.aldiwan.net/poem34231.html","الخفيف"],[674,"","https://poetry.dctabudhabi.ae/diwan/poem/145910","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109232","الخفيف"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132840","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202148","الرمل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201721","الخفيف"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216559",""],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216554",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54478","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[5668,"لم أعشق سواه","https://www.poetsgate.com/ViewPoem.aspx?id=179114",""],[1583,"هذه الأرض لي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73069&r=&rc=26",""]],"verses":[["ما لشَيْخٍ سوى الرّجوعِ الى ال","لَّهِ ونَجْوَى أهْلِ التُّقى والصّلاح",0,"ح",1,0],["ما لِشَهيدٍ بَينَ أَرماحِكُم","شَلَّت يَدا وَحشِيِّ مِن قاتِلِ",1,"ل",1,0],["ما لِشَيءٍ بَشاشَةَ بَعدَ شَيءٍ","كَتَلاقٍ مُواشِكٍ بَعدَ بَينِ",2,"ن",1,0],["مَا لِشُعُوبٍ جَمَدَتْ بَاعِثٌ","كَالخَطْبِ مَهْمَا يَطْوِها تُنْشَرِ",3,"ر",1,0],["ما لشمّ الذرى تغضّ من الذلّ","فأين النسور والعقبان",4,"ن",1,0],["ما لشانِيكَ يَلْتظي من غُرورٍ","وله آخِراً تُرَقَّبُ قَمْعه",5,"ع",2,0],["ما لشيء سواه تأثير فعل","أبداً غير نسبة الأفعال",6,"ل",1,0],["مآل شعيب في الزمان بدوره","ولم تكن الشمس المنيرة إلاه",7,"ا",2,0],["مالشعبٍ مفرَّقٍ من حياة","ما لقوم تنافروا من كيان",8,"ن",1,0],["ما لِشَمسُ الضُّحَى اختصاصٌ بوقتٍ","فيه تَعلُو على الورى أو تُنيرُ",9,"ر",1,0],["ما لشعب سودوا صفحته","لم يسود صفحات العابثين",10,"ن",1,0],["ما لشرقيٍّ بعد هذا هوان","أُطلقتْ من قيودها الأُسَراء",11,"ا",1,0],["مِ الشَّمِس خَذ نور وِقباسِ","ومِ الغصن خَذ ميله وهَزفَه",12,"ف",2,0],["مِ «الشارجه» ل «بَمْبي» يا رامي","صِبت الهَدف لو رَميك بعيد",13,"د",1,0],["ما لشَملي بها سِوى أَمرِ مولا","ي عماد الدِّينِ المملّكِ ناظمْ",14,"م",1,0],["ما لشمسي مُنطقت بُرد الكسوف","ما لبدري بات في أيدي الخسوف",15,"ف",1,0],["ما لشأني من سلوٍّ أبدا","كيف أسلو دون وفد المنتَظَر",15,"ر",1,0],["مَالَ شَرْقًا فَنَالَ عِزًّا مَنِيعًا","وَمَكِينًا بِطَيّبٍ الأعْرَاقِ",16,"ق",1,0],["ما لشرقٍ لولا شفاعة لبنانَ","خلاصٌ ولا لغربٍ فداءُ ،",17,"ا",2,0]]}