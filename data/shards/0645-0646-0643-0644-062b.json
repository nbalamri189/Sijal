{"poems":[[87,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[147,"ما كان قبلك في الزمان الخالي","https://www.aldiwan.net/poem11802.html","الكامل"],[164,"من بات مثلي للنجوم نزيلا","https://www.aldiwan.net/poem59095.html","الكامل"],[520,"ما هاج مزنة دمعه المترقرق","https://www.aldiwan.net/poem12188.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122695","المنسرح"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111173","الرجز"],[2590,"","https://poetry.dctabudhabi.ae/diwan/poem/105076","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97076","الكامل"],[4119,"إني لأغنى الناس عن عصبية","https://www.poetsgate.com/ViewPoem.aspx?id=16088",""]],"verses":[["مِن كُلِّ ثِقلٍ كاهِلُ الدُنيا بِهِ","تَعِبٌ وَوَجهُ الأَرضِ عَنهُ ضَيِّقُ",0,"ق",1,0],["مِن كُلِّ ثاوِيَةٍ لَدَيكَ مُقيمَةٍ","جَوّالَةٍ في الأَرضِ كُلَّ مَجالِ",1,"ل",1,0],["من كل ثبت زاجر وإذا دعى","يوم النزال هناك كان عجولا",2,"ل",2,0],["من كل ثغر مثل ثغر مخافة","خاف طريق رضابه لم يطرق",3,"ق",1,0],["مِن كُلِّ ثَبتٍ إذا تَرجرَجَتِ الأق","دامُ أو كانَ مَسلَكٌ زَلَقُ",4,"ق",1,0],["من كل ثبت ان تكسر الوغى","ناباً وتحمر الكماة حدقا",5,"ق",2,0],["من كل ثاكلة تسلي صبية","يستصر خون ظواميا وسواغبا",6,"ب",2,0],["من كل ثاكلةٍ تود لو أنها","تقضي ولم تبرز من الأستار",7,"ر",1,0],["من كل ثاوية تبيت على السرى","كالنجم بين مشرق ومغرب",8,"ب",1,0]]}