{"poems":[[55,"أما لو لم تعاقره العقار","https://www.aldiwan.net/poem30451.html","الوافر"],[49,"اللوم للعاشقين لوم","https://www.aldiwan.net/poem25159.html","مجزوء البسيط"],[53,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[91,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[68,"مرحبا مرحبا بأبطال لهو","https://www.aldiwan.net/poem40671.html","الخفيف"],[99,"نقلت حياتي والحياة بنا تجري","https://www.aldiwan.net/poem24902.html","الطويل"],[99,"ها هنا حفل وذكرى ووفاء","https://www.aldiwan.net/poem24983.html","الرمل"],[15,"يا عين فابكي ما بني","https://www.aldiwan.net/poem45245.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42547","الطويل"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/199472","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43917","الطويل"],[92,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[136,"صاحب الرحل والقلوص الرسوما","https://www.aldiwan.net/poem54652.html","الخفيف"],[167,"أرسم ديار لإبنة القين تعرف","https://www.aldiwan.net/poem397.html",""],[173,"بالسيف يفتح كل باب مقفل","https://www.aldiwan.net/poem1657.html",""],[185,"أمن طلل بالجزع قو المعارف","https://www.aldiwan.net/poem58844.html","الطويل"],[190,"برمت بمن أراه وضاق صدري","https://www.aldiwan.net/poem43228.html","الوافر"],[190,"برمت بما أراه وضاق صدري","https://www.aldiwan.net/poem43869.html","الوافر"],[280,"يقر بعيني أن قلبي ما قرا","https://www.aldiwan.net/poem25560.html","الطويل"],[287,"عدم الإسلام معدوم المثال","https://www.aldiwan.net/poem32634.html","الرمل"],[303,"لمن وبمن عسى يرجى العزاء","https://www.aldiwan.net/poem36264.html","عموديه"],[368,"غشيت بِقرا فرط حول مكمل","https://www.aldiwan.net/poem1723.html","الطويل"],[382,"لقد ضل من قد حاد عن مورد الكشف","https://www.aldiwan.net/poem59322.html","الطويل"],[463,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[463,"يا مستضيم الملك أين الحامي","https://www.aldiwan.net/poem55873.html","الكامل"],[510,"التوبة","https://www.aldiwan.net/poem27892.html","الطويل"],[566,"وبلدة بعيدة النياط","https://www.aldiwan.net/poem27843.html","الرجز"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138114",""],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130880","السريع"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112845","الكامل"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107301","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77973","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101015","الطويل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95382","الدوبيت"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69433","البسيط"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111149","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137263",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201555","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201144","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200666","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202856","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204957","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139966","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62757","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86274","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45885","الطويل"],[3619,"","https://poetry.dctabudhabi.ae/diwan/poem/33113","الطويل"],[3693,"","https://poetry.dctabudhabi.ae/diwan/poem/145913","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206139","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81300","الخفيف"],[4727,"أبت شفتايَ اليومَ إلا تكلُماَ","https://www.poetsgate.com/ViewPoem.aspx?id=215160",""],[4780,"رأيت الشيخ بالمصباح يسعى","https://www.poetsgate.com/ViewPoem.aspx?id=13170",""],[4816,"باقي الوعد","https://www.poetsgate.com/ViewPoem.aspx?id=8451",""],[4830,"سجيّةُ الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=194089",""],[4908,"عدْ يا ضنايَ","https://www.poetsgate.com/ViewPoem.aspx?id=207337",""],[4927,"أغلى الْمِلاح","https://www.poetsgate.com/ViewPoem.aspx?id=29951",""],[4978,"أحمد الدقاسمة","https://www.poetsgate.com/ViewPoem.aspx?id=188844",""],[5022,"بورما المضطهدة","https://www.poetsgate.com/ViewPoem.aspx?id=200677",""],[5085,"ياقاتلي باللحظ","https://www.poetsgate.com/ViewPoem.aspx?id=188439",""],[231,"الإنسان الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=186167",""],[5105,"وقد أُزارُ وللزوارِ حكمهمُ","https://www.poetsgate.com/ViewPoem.aspx?id=135343",""],[5122,"غريب طبعك","https://www.poetsgate.com/ViewPoem.aspx?id=18651",""],[5277,"الليالي البيض..","https://www.poetsgate.com/ViewPoem.aspx?id=213842",""],[5387,"أهون عليكِ؟","https://www.poetsgate.com/ViewPoem.aspx?id=83392",""],[5612,"يا عالِمَ الأسْرار","https://www.poetsgate.com/ViewPoem.aspx?id=182859",""],[5703,"أشواق وهواجس","https://www.poetsgate.com/ViewPoem.aspx?id=208968",""],[5829,"وليس لعاشق عنها حياد","https://www.poetsgate.com/ViewPoem.aspx?id=204665",""]],"verses":[["بِرُمحٍ طَرفُهُ يَزدادُ لَحظاً","إِذا ما فَضَّ مِنهُ دَمٌ مُمارُ",0,"ر",1,0],["بِرَملَتَي عالِجٍ رُسومٌ","يَطولُ مِن دونِها الرَسيمُ",1,"م",1,0],["برماحٍ مَداعس وصِفاحٍ","مرهفاتٍ لهنَّ قدٌّ وقطُّ",2,"ط",1,0],["برمت بمالي من حياة فإنها","شقائي وإن الموت منها لأفضلُ",3,"ل",1,0],["بِرِماحٍ لَها أَسِنَّةُ نارٍ","قَد أَبادَت عَساكِرَ اللَيلِ طَعنا",4,"ن",2,0],["بَرمتُ بأوضاع الورى كلُّ أمرهم","وسيلةُ محتاج ومسعاةُ مضطرّ",5,"ر",1,0],["برمت بأوضاع الورى ليس بينهم","وشائج لم تُوصَل لغايٍ ولا أمر",5,"ر",1,0],["برم العيش بها لم يشفها","وتولى الدهر سأمان وجاء",6,"ا",2,0],["بَرِمَت بَنو أَسَدٍ كَما","بَرِمَت بِبَيضَتِها الحَمامَه",7,"م",2,0],["بَرِمْتُ بِهِمْ حَتَّى سَئِمْتُ مَكَانَتِي","وَأَنْكَرْتُ طِيبَ الْعَيْشِ وَهْوَ دَمِيثُ",8,"ث",1,0],["برمت بالمسرح.. أخرجيني","مري بكفيك على جبيني",9,"ن",2,0],["برِمتُ بما ألقاه مِمَّنْ أُوَامِقُ","وأوذِيتُ حتّى لا أرى من أُصادقُ",10,"ق",1,1],["بَرِمْتُ بلوم الَّلائمين ، وقولِهم ْ :","أأنتَ إلى تغريدةٍ غيرُ راجع",11,"ع",1,0],["برِماً مفرطا قبيحا شحيحا","لحزاً كاذبا سفيها عديما",12,"م",2,0],["بِرَمّانَ وَالعَرجَينِ إِنَّ لِقاءَها","بَعيدٌ وَإِنَّ الوَعدَ منها سَيُخلِفُ",13,"ف",1,0],["بِرِماحِهِم وَصِفاحِهِم وَسَماحِهِم","وَرِثُوا السِيادَةَ آخِراً عَن أَوَّلِ",14,"ل",1,0],["بِرَمّاحةِ الأَنضادِ قَمّاصَةِ الصُّوَى","تُداوِى المَطايا مِن مِراحِ العَجارِفِ",15,"ف",1,0],["برمت بمن أراه وضاق صدري","بمن القاه من قوم ثخان",16,"ن",1,1],["برمت بما أراه وضاق صدري","بمن ألقاه من قوم تحار",17,"ر",1,1],["بَرَمْتُ بِهَجْرِ دَاوَل الوَصْل بُرْهةً","وقَد أبْرَمَتْ لِلْبَيْنِ مَا حَبّبَ الهَجْرا",18,"ر",2,0],["بَرمَكِيّونَ لَدى كُلِّ سُؤالٍ","فَارِسِيّونَ لدى كُلِّ مَقالِ",19,"ل",1,0],["برمنا بالروايةِ حين طالتْ","فصولٌ كلُّ ما فيها هراءُ",20,"ا",2,0],["بِرَمّاحَةٍ تَنفي التُرابَ كَأَنَّها","هَراقَةُ عَقٍّ مِن شَعيبى مُعَجَّلِ",21,"ل",1,0],["برمْلٍ واصطُرلابِ وَفْقٍ ومَنْدَلٍ","وسحرٍ وإرصادات نجمٍ مع الحفِّ",22,"ف",1,0],["بَرِماً بحبّات القلو","ب يخافها وتهشُّ نحوَهْ",23,"و",2,0],["بَرِمُونَ بالإعراضِ بعد غُبورهم","وسُمَاءُ يُمتدَحون بالأجسامِ",24,"م",1,0],["برمت بشكواك وكثر أنينك","بلا سبب فاعف وأطلق سراحيهْ",25,"ي",2,0],["بِرَملِها مِن عاطِفٍ وَعاطِ","عَلَوتُ حينَ هَيبَةِ الوَطواطِ",26,"ط",1,0],["برمت بعيش لست أدرى بلاغه","فهل من مزيج ستره فيُبين",27,"ن",1,0],["برمة من مسد رثة","بالذل قد قاد الصغار الكبار",28,"ر",1,0],["بر من البر الكريم الاخر","الجود فيه والجمال اصطحبا",29,"ب",2,0],["بَرٌّ مَلِيحُ الدَلِّ أَحوَى أَهيَفٌ","في حُبِّهِ عاصَيتُ أَمرَ مُفنِّدِي",30,"د",2,0],["برٌّ مطيعٌ خاشِع متواضِعٌ","راسي الجفان وَهاطل الأَجفان",31,"ن",1,0],["برمتِ بنا يا مصر لا عن جناية","يُعَّنى عليها جارم أو يُعنَّف",32,"ف",1,0],["برماء عساها تواصلن فتاها","في القلب هواها فكيف أقبل أعذار",33,"ر",1,0],["بِرَملِ يَبرِينَ أَصبَحتُم فَهَل عَلِمَت","رِمالُ يَبرِينَ أَنَّ الشَوقَ يَبرِيني",34,"ن",2,0],["برماح من اليراع قصار","قصدت كل صعدة تقصيدا",35,"د",2,0],["برمانا شهدت اليوم عيداً","لعبد الله عازار المفدى",36,"د",2,1],["برمِتَ بأمر الناس يعييك تركهم","وبالقرب منهم تمزج الكُفربالدين",37,"ن",1,1],["برمت بحسنٍ لم يقسّم على الورى","بعدلٍ فأدعوا ضارعاً خالقَ الناس",38,"س",1,1],["برمتُ بقومٍ يزدريني جهلهم","سأشفي لقاهم وهو دائي بالنأي",39,"ي",1,1],["برمتم بصفّ تلاميذكم","فكيف بتعليم كل البشر",40,"ر",1,0],["برمت بصوت الطير يصحو مبكراً","فتوقظني ألحانه تتردّد",41,"د",1,1],["برماحكم نفحتْ وعنها أُمطرت","بل كانَ منّا ذا وإن لم نشهدِ",42,"د",1,0],["برِمتُ من الحياة وأيُّ عيشٍ","يلذُّ لمن مطاعمه الخَيالُ",43,"ل",1,0],["بِرُمحٍ قَدٍّ عَلى العُشّاقِ ما خَطَرَت","إِلّا وَقالَت لَهُم ايّاكُم الخَطَرا",44,"ر",2,0],["برمهات برمودا بشنسُ بؤنة","أَبيبُ وَمَسرى وَالنَسيء زيادة",45,"ه",1,0],["بِرُمحَينِ أَو بِالمُنحَنى دَبَّ فَوقَها","سَفا الريحِ أَو جِذعٌ مِنَ السَيلِ خادِشُ",46,"ش",1,0],["برمهات برمودة وبشنس","وبؤون أبيب مسري الحرور",47,"ر",1,1],["برمنا بما يمضي الغداة فبُعده","أحب إلينا من ملاقاة ما يلي",48,"ل",2,0],["برمحيه قام يروم لقاه","وزنث ببأسٍ شديدٍ حباه",49,"ه",1,0],["برمتها اتقدت شررا","فلم تبق عيناً ولا أثرا",49,"ر",2,0],["برمت بِالحَياة لَهواً فَجدت","مِن صَباها مَحروسة ما تُعاق",50,"ق",1,0],["بَرِمْتُ به قولاً وفعلاً وهزّةً","كما برِمَ الأيتامُ منهم عوائلُه",51,"ل",2,0],["برمت برفقة خارت قواها","برستم أو بحيدر اندمال",52,"ل",1,0],["برمشها تطوي المسافات والبين","وبرمشها تبعد طريقي ويبعد",53,"د",1,0],["برَمْسِ الأهلِ يكفينا اتعاظاً","كأنَّ حذارِ من دنياكَ قالا",54,"ل",2,0],["برمجتُ قلبي في المحبة والجوى","عَلِّي أفسرُ كل شيءٍ أُبْهِما",55,"م",2,0],["بِرُمُوْشِ عَيْنَيْكِ الَّتِيْ","نُصِرَتْ عَلَىْ أَهْلِ الرِّمَاْحِ",56,"ح",1,0],["برمجونا أننا خدّامُهم","ولهم نبقى كما شاؤوا جِثيّا",57,"ي",2,0],["بُرما وما أدراك ما أخبارها","جمعت مشاهدُها حديث الغاشيه",58,"ي",2,1],["بِرَمَادِهِ إنِّي أُسَطّرُ أحْرُفِي","كيْمَا يَرَى شِعْرِي لِقلبي مَنْ سَرَقْ",59,"ق",1,0],[":\" برمتُ بهذا الكون همدان موحشاً","برمتُ بملكٍ ربهُ (1) فيه خاسرُ \"",60,"ر",1,0],["برمتُ باثنين ضاق الصدر بينهما","فَقْدُ المدامةِ واستيحاشُ مغترب",61,"ب",1,0],["برمج حياتي في عيونك ونظم","اللي بقا من رحلتي للبهاذيل",62,"ل",1,0],["برمش العين من فرطِ الجمالِ","رمتْ قلبي كرمْيٍ بالنبالِ",63,"ل",1,1],["برمت بحبي الصافي فوا عجبي","أيبرم الموت بالغيمات والمطرِ",64,"ر",1,0],["بَرِمْتُ بالهَمِّ في أحْشايَ أخْزِنُهُ","وليْسَ ينْفعُ مَهْموماً تَبَرُّمُهُ",65,"م",2,0],["برمالِ أشواقي أسيرُ وفي فمي","ظمَأٌ ويلفَحُني لهيبُ الهاجره",66,"ر",2,0],["برمش العين أرعاها وتقسو","وأغمرها فيغريها بِعادُ",67,"د",1,0]]}