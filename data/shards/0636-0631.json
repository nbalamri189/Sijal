udhabi.ae/diwan/poem/39649","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39629","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16703","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9863","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42562","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54882","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54638","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67343","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43644","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43773","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43850","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"شكر عارفة","https://www.poetsgate.com/ViewPoem.aspx?id=179475",""],[77,"عن باب والدك الرضا لا أبرح","https://www.poetsgate.com/ViewPoem.aspx?id=33552",""],[18,"طفلة ما ابنة المحلل بيضا","https://www.poetsgate.com/ViewPoem.aspx?id=27761",""],[13,"جَزَى اللَّهُ فِتْيَاناً عَلَى العَوْصِ أَمْطَرَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=180822",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[45,"عَارَضْنَنا أُصُلاً، فَقُلْنَا الرّبْرَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31698",""],[45,"ضَرْطَةُ وهْبٍ نكرَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=32529",""],[45,"ضراط ابن ميمون وصوت العروب","https://www.poetsgate.com/ViewPoem.aspx?id=31412",""],[45,"لمْ يَبقَ، في تلكَ الرّسُومِ بمَنْعِجِ","https://www.poetsgate.com/ViewPoem.aspx?id=33107",""],[80,"ليَ قلبٌ من جَلمَدِ الصَّخرِ أقسى","https://www.poetsgate.com/ViewPoem.aspx?id=3360",""],[46,"لا تَصحبنّ، يدَ اللّيالي، فاجراً،","https://www.poetsgate.com/ViewPoem.aspx?id=20121",""],[51,"قالوا ابنُ يوسفَ مستوهٌ فقلتُ لهم","https://www.poetsgate.com/ViewPoem.aspx?id=27038",""],[51,"ضراطُ ابن ميمون فيه سَعَه","https://www.poetsgate.com/ViewPoem.aspx?id=29552",""],[30,"ألا أيُّها الرَّسمُ الذي غيَّرَ البلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20510&r=&rc=4",""],[31,"نامَ صحبي، وباتَ نومي عسيرا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18872&r=&rc=135",""],[31,"ما عَلَى الرَّسْمِ بالبُلَيَّيْن لَوْ بَيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18767&r=&rc=30",""],[85,"جئتنا بالشعور والأحداق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9559&r=&rc=49",""]],"verses":[["ضَروبٍ حَيثُ تَعثُرُ شَف","رَةُ الصَمصامِ بِاللِمَمِ",0,"م",1,0],["ضَرَبنَ إِلَينا خُدوداً وِساما","وَقُلنَ لَنا اليَومَ موتوا كِراما",1,"م",2,1],["ضَرَبَ العِزُّ عَلَيهِم بَيتَهُ","ثُمَّ أَلقى الرَحلَ فيهِم وَأَقاما",2,"م",2,0],["ضَرورَةً حُمتُ عَلى وِردِكُم","لَمّا خَطاني مَطَرُ الوابِلِ",3,"ل",1,0],["ضِرغامِ هَيجاءٍ كَفاهُ بِأَنَّهُ","عِندَ القَواضِبِ وَالقَنا بي مُشبِلُ",4,"ل",1,0],["ضَرباً كَأَشداقِ الهِجانِ رَواغِياً","وَوَغىً كَما اِضطَرَمَ الأَباءُ المُشعَلُ",4,"ل",1,0],["ضَرَبوا في جَوانِبِ الطَودِ فَاِنظُر","حَمِقَ العاجِزينَ كَيفَ أَحاكا",5,"ك",2,0],["ضَرَبنَ طَريقاً بِالمَناسِمِ أَربَعاً","إِلى الماءِ لا تُدنى إِلَيهِ شَروعُ",6,"ع",1,0],["ضَرَبوهُ في بَطنِ الصَعيدِ بِنَومَةٍ","أَبَدَ الزَمانِ وَلاتَ حينَ نُعاسِ",7,"س",1,0],["ضَرَبَ المَجدُ عَليهِم بَيتَهُ","وَغَدَوا دونَ حِمى المَجدِ إِطارا",8,"ر",2,0],["ضَرَبنَ لَنا النُسورُ رِواقَ ظِلٍّ","تَلوذُ بِحَقوَةِ القُبِّ المِهارُ",9,"ر",1,0],["ضَرَبوا أَوجُهَ البِكارِ وَقادوا","لِلأَعادي قَباقِباً هَدّارا",10,"ر",2,0],["ضَرَبوا بِمَدرَجَةِ الفَناءِ قِبابَهُم","مِن غَيرِ أَطنابٍ وَلا أَوتادِ",11,"د",1,0],["ضَرَبوا بِسَيفِ مُحَمَّدٍ أَبناءَهُ","ضَربَ الغَرائِبِ عُدنَ بَعدَ ذِيادِها",12,"د",3,0],["ضَرَبَت بِعِرقي دَوحَةٌ نَبَوِيَّةٌ","في مَنصِبٍ وَاري الزَنادِ صُراحِ",13,"ح",1,0],["ضَرَبْنَ بألْحِيهِنَّ والريحُ قَرّةٌ","على قُلَّتَيْ أرْوَنْدَ غِبَّ كَلالِ",14,"ل",1,0],["ضَرَبَتْ على الأيْنِ صَدْرَ المَطيِّ","فقدَّ إليكَ أديمَ القِرى",15,"ا",1,0],["ضَرَبْتُ إليهِ صَدْرَ كلِّ نَجيبةٍ","لها نَظَرٌ شَطرَ النّوائِبِ أخْزَرُ",16,"ر",1,0],["ضَرَبْتَ بسَيْفٍ لم يَخُنْكَ غِرارُهُ","يَرُدُّ شَباهُ جانِبَ القِرْنِ أثْلَما",17,"م",2,0],["ضُرِبْنَ إِلى البَيْتِ العَتيقِ ولمْ تَقُلْ","لِناجِيةٍ منهُنَّ إذْ عَثَرَتْ لَعا",18,"ع",2,0],["ضَرَبتُ عَمرواً عَلى الخَيشومِ مُقتَدِر","بِصارِمٍ مِثلِ لَونِ المِلحِ بَتّارُ",19,"ر",1,0],["ضَرَبناهُم بِبيضٍ مُرهَفاتٍ","تَقُدُّ جُسومَهُم ظَهراً وَبَطنا",20,"ن",2,0],["ضرَبْتَ الصّخْرَ فانْفجَرَ انْفِجاراً","ضرَبْتَ البَحْرَ فانْفرَقَ انْفِراقا",21,"ق",2,0],["ضَرَطَ الْفَقِيهُ فَقُلْتُ ذَاكَ غَرِيبةٌ","مَا كَانَ ذَلِكَ مِنْهُ بِالْمَعْلُومِ",22,"م",1,1],["ضَرَائِرُ الدَّهْرِ سَارَتْ عَنْ دِيَارِكَ لَوْ","لاَ الضَّرُورَةُ لَمْ يَخْطُرْ عَلَى بَالِي",23,"ل",2,0],["ضُرِبَتْ خِيامي في حِماهُ فَصِبْيَتي","تَرْعى الجَميمَ بهِ وبَهيمي تَسْرَحُ",24,"ح",1,0],["ضَرَبناهُم بِمَكَّةَ يَومَ فَتحِ النَ","بِيِّ الخَيرِ بِالبيضِ الخِفافِ",25,"ف",1,0],["ضَرَبتُم حَولَ قادَتِنا نِطاقاً","مِنَ النيرانِ يُعيي الدارِعينا",26,"ن",2,0],["ضَرَبوا الزَمانَ بِسَوطِ عِز","زَتِهِم فَلانَ لَهُم فَدار",27,"ر",1,0],["ضَرائِبُ جَهمَةٌ في العَتبِ تُتلى","بِأَخلاقٍ لَدى العُتبى مِلاحِ",28,"ح",1,0],["ضَرَجنَ البَرودَ عَن تَرائِبِ حُرَّةٍ","وَعَن أَعيُنٍ قَتَّلنَنا كُلَّ مَقتَلِ",29,"ل",1,0],["ضَريبٌ بِأَرواقِ السَواري كَأَنَّهُ","قَرا البَوِّ تَغشاهُ ثَلاثٌ صَعائِدُ",30,"د",1,0],["ضريحَ أمير المسلمين محمد","يخصُّك ربِّي بالسلام المردَّدِ",31,"د",1,1],["ضربة جيش لم يكن ناطقاً","إلاّ بنيرانٍ له زافره",32,"ر",2,0],["ضَرَبتَ بِهِ عِندَ الإِمامِ فَأُرعِشَت","يَداكَ وَقالوا مُحدَثٌ غَيرُ صارِمِ",33,"م",1,0],["ضَرَبتَ بِهِ عُرقوبَ نابٍ بِصَوأَرٍ","وَلا تَضرِبونَ البيضَ تَحتَ الغَماغِمِ",33,"م",1,0],["ضَرَبتَ بِحَفَّتَي صَنعاءَ لَمّا","أَحادَ أَبوكَ بِالجَنَدِ العِصابا",34,"ب",2,0],["ضَرَبنا عَميدَ الصِمَّتَينِ فَأَعوَلَت","جُداعُ عَلى صَلتِ المَفارِقِ أَنزَعا",35,"ع",2,0],["ضَرَحنَ حَصى المَعزاءِ حَتّى عُيونُها","مُهَجِّجَةٌ أَبصارُهُنَّ وَذُرَّفُ",36,"ف",1,0],["ضَرَحنَ بِنا حَصى المَعزاءِ حَتّى","تَقَطَّعَتِ السَرائِحُ وَالخِدامُ",37,"م",1,0],["ضَرَبَت مَعارِفَها الرَوامِسُ بَعدَنا","وَسِجالُ كُلِّ مُجَلجِلٍ سَجّامِ",38,"م",1,0],["ضَرَبنا سَراةَ القَومِ حَتّى تَوَجَّهوا","سِراعاً وَقَد بَلَّ النَجيعُ المَحامِلا",39,"ل",2,0],["ضَرَبتَ فَلَم تَدَع لِلسَيفِ حَدّاً","وَجُلتَ بِحَيثُ ضاقَ عَنِ المَجالِ",40,"ل",1,0],["ضَرَبنا بِها عُرضَ الفُراتِ كَأَنَّما","تَسيرُ بِنا تَحتَ السُروجِ جَزائِرُ",41,"ر",1,0],["ضَروبٍ بِأَعجازِ القِداحِ إِذا شَتا","سَريعٍ إِلى داعي الهِياجِ مُصَمَّمِ",42,"م",1,0],["ضَرَبناهُمُ حَتّى اِستَباحَت سُيوفُنا","حِماهُم وَراحوا موجَعينَ مِنَ القَتلِ",43,"ل",1,0],["ضربت إليك الرمل سعياً وربما","ضربنا عليك الرّمل عند المنجّم",44,"م",1,0],["ضرطة باستك قصدي","فأدرها واسْقنيها",45,"ه",2,0],["ضربُكِ في صوتك لا خارجٌ","عن حدِّه والصوت في الضَّربِ",46,"ب",1,0],["ضرباً وجيعاً سوى ضربِ العبيد لهُ","والضرب ضربان مكروه ومحبوبُ",47,"ب",1,0],["ضرورٌ نفوعٌ عاجلُ النفع ثَرُّهُ","على مُعتفيه آجلُ الضَّرِّ رائثُهْ",48,"ث",2,0],["ضربتُ شعري عن الكتَّاب قاطبةً","صفحاً إليه ومثلي نحوَه جَنحا",49,"ح",2,0],["ضَرْطَةُ إبراهيم في البَرْبَخِ","كنفْخة النَّافخ في المِنْفَخِ",50,"خ",1,1],["ضرب اللّه عليه","دون لفظ الخلق حدَّا",51,"د",2,0],["ضرطةٌ حابت أبا ضارطها","أثبتوها في البنين البرره",52,"ر",2,0],["ضرطتْ عِرسُهُ على رأس أيري","فتوهمتُ أن ذاك بِدَسِّه",53,"س",2,0],["ضرْطٌ في قفاك يحسبهُ السا","معُ ثوباً من الحرير يُعَطُّ",54,"ط",1,0],["ضربت بسيفك يا ابن الكرا","م غيرَ الشجاع ولا الدارع",55,"ع",1,0],["ضراط ابن ميمون فيه سعَهْ","وضرط أبي صالح في دعَهْ",56,"ع",2,1],["ضرطة تسكت الرعو","د وفيها تقصُّف",57,"ف",1,0],["ضرّابةٌ با