{"poems":[[55,"لو علمت أي فتى ماجد","https://www.aldiwan.net/poem30613.html","السريع"],[75,"ألا هل درى الداعي المثوب إذ دعا","https://www.aldiwan.net/poem11947.html","الطويل"],[95,"جاء الكتاب وأصدق","https://www.aldiwan.net/poem11242.html","المجتث"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[29,"أرسم الحي إذ نزلوا الإيادا","https://www.aldiwan.net/poem5724.html","الوافر"],[4,"ألم تلمم على الدمن الخوالي","https://www.aldiwan.net/poem21182.html","الوافر"],[23,"لعمرك إن إلك من قريش","https://www.aldiwan.net/poem21483.html","الوافر"],[74,"جميعنا في عشقك البادي","https://www.aldiwan.net/poem18569.html","السريع"],[68,"أدرها بلطف واجعل الرفق مذهبا","https://www.aldiwan.net/poem39207.html","الطويل"],[46,"يا سهم للبرق الذي استطارا","https://www.aldiwan.net/poem29693.html","الرجز"],[107,"هو الحكم أمضته السيوف القواطع","https://www.aldiwan.net/poem43054.html","الطويل"],[107,"اشهدي يا مصر أعمال البنين","https://www.aldiwan.net/poem43070.html","الرمل"],[107,"إلى طيئ يا ابن عم النبي","https://www.aldiwan.net/poem43588.html","المتقارب"],[107,"بني حنيفة ما أشقى مسيلمة","https://www.aldiwan.net/poem44011.html","البسيط"],[107,"أنخ البعير فقد بلغت المسجدا","https://www.aldiwan.net/poem44013.html","الكامل"],[107,"ترامى الجيش واندفع الرعيل","https://www.aldiwan.net/poem44191.html","الوافر"],[50,"أفناني الدهر نهسا","https://www.aldiwan.net/poem64323.html","الخفيف"],[52,"خليلي ما بال الدجى لا تزحزح","https://www.aldiwan.net/poem63979.html","الطويل"],[48,"أيزورنا شرخ الشباب فيرتجى","https://www.aldiwan.net/poem22579.html","الكامل"],[8,"أضل الله سعي بني قريع","https://www.aldiwan.net/poem21782.html","الوافر"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49149","الوافر"],[87,"نُراوَحُ بالحوادثِ، أَو نُغادَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9639&r=&rc=129",""],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[199,"لو أطعتك يا غرار كسوتني","https://www.aldiwan.net/poem54379.html","الكامل"],[215,"أضلني الله بالجمال","https://www.aldiwan.net/poem46321.html","مخلع البسيط"],[215,"صورة ما أراه أم ذاك حلم","https://www.aldiwan.net/poem46762.html","الخفيف"],[240,"يا علو أغريت السهاد بناظري","https://www.aldiwan.net/poem32015.html","الكامل"],[240,"ومميل العطفين أغيد","https://www.aldiwan.net/poem32099.html","مجزوء الكامل"],[354,"قوامك العادل المفدى","https://www.aldiwan.net/poem15619.html","مخلع البسيط"],[376,"أما اشتفى كاشح ولا حاسد","https://www.aldiwan.net/poem57477.html","المنسرح"],[408,"عيناي فيك بأسياف البكى اجترحا","https://www.aldiwan.net/poem46751.html","البسيط"],[411,"قل للذي ركب الفساد","https://www.aldiwan.net/poem49980.html","الكامل"],[415,"أعاتب فيك الدهر لو أعتب الدهر","https://www.aldiwan.net/poem31861.html","الطويل"],[422,"اليوم أصبح فيك الوقت منتظما","https://www.aldiwan.net/poem54127.html","البسيط"],[422,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[443,"سفها بكيت بدمع عين هام","https://www.aldiwan.net/poem2585.html","الكامل"],[458,"لعل جميع هذا الكون حولي","https://www.aldiwan.net/poem61328.html","الوافر"],[463,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[463,"أتكتم يوم بانة أم تبوح","https://www.aldiwan.net/poem56247.html","الوافر"],[466,"خذ ما تشاء من الأيام أو فذر","https://www.aldiwan.net/poem15097.html","البسيط"],[469,"خليلي ما بال النجوم كأَّنما","https://www.aldiwan.net/poem3154.html","عموديه"],[469,"ظباء الحمى حين تعتادها","https://www.aldiwan.net/poem3457.html","عموديه"],[519,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[556,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[558,"دعوت أمير المؤمنين ولم تكن","https://www.aldiwan.net/poem68253.html","الطويل"],[563,"نحن الجفون نحفظ العيونا","https://www.aldiwan.net/poem33809.html","الرجز"],[567,"لعمرك ليس فوق الأرض باق","https://www.aldiwan.net/poem52859.html","الوافر"],[666,"","https://poetry.dctabudhabi.ae/diwan/poem/147419","الكامل"],[736,"","https://poetry.dctabudhabi.ae/diwan/poem/131447","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70953","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70870","الخفيف"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105475","المنسرح"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59437","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59429","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59185","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202076","الكامل"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126632","المتقارب"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64592","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71038","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137920",""],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89525","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27749","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27950","السريع"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104988","المنسرح"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113037","المتقارب"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17720","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115829","الكامل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103437","المنسرح"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79721","المتقارب"],[3204,"","https://poetry.dctabudhabi.ae/diwan/poem/203628","الكامل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104267","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/63028","الوافر"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45743","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91833","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91858","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205655","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131097",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131278",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34683","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119711","الطويل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93256","الكامل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33068","المتقارب"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73117","السريع"],[4767,"سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=179611",""],[592,"ألا أيها الباغي طريقاً إلى الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128716",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"شكت فجشت مذ أعلنت بجشاها","https://www.poetsgate.com/ViewPoem.aspx?id=128712",""],[5431,"كيّ الذهب...","https://www.poetsgate.com/ViewPoem.aspx?id=214701",""],[470,"بيضُ وجوهُ بني عمي كما الغُررُ","https://www.poetsgate.com/ViewPoem.aspx?id=18590",""],[5961,"اضرب عن الناس","https://www.poetsgate.com/ViewPoem.aspx?id=199763",""],[6164,"فتاتان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66064&r=&rc=73",""],[5377,"إلي وطني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79564&r=&rc=20",""],[5080,"حتّام ترثي نخيلا في العناوينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88135&r=&rc=5",""],[463,"سقى أيَّامَ رامة َ بل سقاها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60273&r=&rc=329",""],[5126,"الطائر الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87826&r=&rc=41",""]],"verses":[["أَضلَلتَ قَلبي فيكَ عَمداً وَقَد","تَعَيَّنَ الثَأرُ عَلى العامِدِ",0,"د",1,0],["أَضَلَّهُمُ فِقدانُها فَكَأَنَّما","أَضَلَّت سَوامُ الوَحشِ في الجَدبِ مَرتَعا",1,"ع",2,0],["أضَلَّهَا وَقَدِيمٌ","إضْلاَلُهُ الرَّاشِدِينَا",2,"ن",2,0],["أَضَلَّهُ راعِيا كَلبِيَّة صَدَرا","عَن مُطلِب وَطُلى الأَعناقِ تَضطَرِبُ",3,"ب",1,0],["أَضَلَّ اللَهُ خَلفَ بَني عِقالٍ","ضَلالَ يَهودَ لا تَرجو مَعادا",4,"د",2,0],["أَضَلَّ صِوارَهُ وَتَضَيَّفَتهُ","نَطوفٌ أَمرُها بِيَدِ الشَمالِ",5,"ل",1,0],["أَضَلّوا جَدَّهُم مِن آلِ شَجعٍ","وَنيطوا مِن قُرَيشٍ بِاللِئامِ",6,"م",1,0],["أضلَّنا الحبُّ ولكن لنا","نعم الإمامُ الرَّاشد الهادِي",7,"د",2,0],["أَضَلّوا الوَرى مِن جَهلِهِم وَتَنَزَّهوا","عَنِ الجَهلِ حَتّى صارَ جَهلاً مُرَكَّبا",8,"ب",2,0],["آضَ لَنا ماءً وَكانَ نارا","أَرضى الثَرى وَأَسخَطَ الغُبارا",9,"ر",2,0],["أضلَّكُمُ البرقُ المُليحُ ورُبَّما","أضَلَّ وميضُ البرقِ والبرقُ لامِعُ",10,"ع",1,0],["أَضلالاً مِنكِ تَجزينَ الأُلى","أَفسَدوا الأَمرَ جَزاءَ المُصلِحينْ",11,"ن",1,0],["أضلّ العُقولَ وأعْمَى القلوب","وأشقى النُّفوسَ وهدَّ الهِمَمْ",12,"م",1,0],["أضلَّهُ غيهبٌ للجهلِ مُرتَكِمٌ","أحاط بالقومِ حيناً ثُمَّتَ انْقَشَعا",13,"ع",2,0],["أضَلْلتَ حين سألت أين مُحمَّدٌ","أفما رأيتَ الكوكبَ المتوَقَّدا",14,"د",2,0],["أَضلَّهُمُ الغباءُ فهم كثيرٌ","وَعَمَّهُمُ البلاءُ فهم قَليلُ",15,"ل",1,0],["أَضَلَّني بَعدَما كُن","تُ في العِبادَةِ قَسّا",16,"س",2,0],["أَضَلَّ الصَباحُ المُستَنيرُ سَبيلَهُ","أَمِ الدَهرُ لَيلٌ كُلُّهُ لَيسَ يَبرَحُ",17,"ح",1,0],["أَضلَلتُهُ وَصَبَرتُ عَنهُ فَلا يَدَي","أَزمَت عَلَيهِ وَلا الدُموعُ غِزارُ",18,"ر",1,0],["أَضَلَّ اللَهُ سَعيَ بني قُرَيعٍ","وَلَيسَ لِما أَضَلَّ اللَهُ هادِ",19,"د",1,1],["أَضَلَّتكَ اليهودُ فَرُحْتَ تَبْغِي","ثَمارَ النّخلِ يا لَكَ من بَلِيَّهْ",20,"ي",2,0],["أضلتنا عن الإصلاح، حتى","عَجَزْنا أَن نُناقشَها الفسادا",21,"د",2,0],["أضل به من يقتفيه من الورى","فما مسلم للمقتفيه بعاذر",22,"ر",1,0],["أَضَلالُ لَيلٍ ساقِطٍ أَكنافُهُ","في الناسِ أَعذَرُ أَم ضَلالُ نَهارِ",23,"ر",1,0],["أضلّني اللَه بالجمال","ما لي وللحسن آه ما لي",24,"ل",2,1],["أضلل قلبي في هواك لعله","إذا كثُر التضليل في الحب يجهل",25,"ل",1,0],["أَضلَلتُ بَعدَكُمُ الرُقادَ فَما لِأَش","جاني وَلَيلي بَعدَكُم مِن آخِرِ",26,"ر",1,0],["أُضلِلتَ فَالإِحسانُ عِن","دَ سِواهُمُ ما لَيسَ يُقصَد",27,"د",1,0],["أَضَلَّني الحُبُّ فيكَ حَتّى","رَأَيتُ فيكَ الضَلالَ رَشدا",28,"د",2,0],["أضلَلتُ قلبي روحتُ أنشدُه","وليتَ شعري من ينشد الناشِد",29,"د",1,0],["أضلَّ وجهك حُسادي عَدمتُهمُ","حتّى رأوه هلالاً وهو شمس ضُحى",30,"ح",2,0],["أضلَلْتَ رأيَكَ عامِداً أو ساهِياَ","مَن ذا الّذي ركِبَ الفَسادَ فَسادا",31,"د",2,0],["أضلَّ الورى حبُّ الحياةِ فحازِمٌ","خبيرٌ سواءُ في الضَّلالةِ والغِرُّ",32,"ر",1,0],["أضلَّ مسعاه تركي في غوايته","كأنه اختار عن وجدانه العدما",33,"م",2,0],["أضِلُّ فأُهدى في هَواكم وينثني","إليَّ هوىً يَهدي عياناً ويهتدى",34,"د",2,0],["أضللت حلمك في الديار ولم يجز","تخيبك ذلك منك في الأحلام",35,"م",1,0],["أضلّي للجمال ولا أصلي","كمن جعلوا الصلاة من الملاهي",36,"ي",1,0],["أضلّ البينُ فطنتها فحارت","كأمّ الخشفِ ناشدةً طَلاها",37,"ا",3,0],["أضلَّ الناسَ في طرق المعالي","سبيلاً بين عينيه يلوحُ",38,"ح",1,0],["أَضلَّه نور فضلي عن مقاصده","وربما ضلَّ ساري الليل بالقمر",39,"ر",1,0],["أضلَّ بها الأيدي اللوامسَ قصدها","من التيه حتى وَّفر الدرَّ حالبه",40,"ب",2,0],["أضلَّ عن الصَّبر ذاك العذارُ","نفساً تعذَّرَ إرشادها",41,"د",3,0],["أضلّكُم عن هُداكُم سامريُّكُمُ","حتّى اِتّخذتُم إلَهاً عِجلَ ضِلّتِهِ",42,"ت",2,0],["أَضَلَّهُ اللّؤمُ عن ذمِّي وجنّبهُ","خُمولُهُ وَقْعَ أنيابي وأظفاري",43,"ر",2,0],["أَضَلَّكَ قَرعُ الآبِداتِ طَريقَها","فَأَصبَحتَ مِن عَميائِها في تَهَيُّمِ",44,"م",1,0],["أضلَّ في آدمَ عن طلعته","عدوَّه إبليساً الملعونا",45,"ن",2,0],["أضَلُّ النَّاسِ في الدُّنيا سَبيلاً","مُحِبٌّ باتَ منها في وِثاقِ",46,"ق",1,0],["اضلاعنا تعرى وتوشك","ان تلامسك اقترابا",47,"ب",2,0],["أضل عن المكارم من دليلٍ","وأكذب من سليمان بن وهب",48,"ب",1,0],["أضلَّتهمُ أهواءَهم عنْ صلاحِهم","وقد ضلت الآراءُ وابتْلخَ الأمرُ",49,"ر",1,0],["أضلْلتُ السبيلَ أم زاغ قلبي","إنَّ هذا لهْو البلاء المبين",50,"ن",1,0],["أضل قلبي بليل طرته","لكن بصبح الجبين أهداه",51,"ا",2,0],["اضله غيه عن رشده فلذا","أمسى حزينا كئيبا خائفا حذرا",52,"ر",2,0],["أضلّني الغيى عن سبل الهدايات","لما امتطيت مطيات الضلالات",53,"ت",1,1],["أضلني بثناياه ومن عجب","إن النجوم به ترجى الهدايات",54,"ت",1,0],["أضَلَّتْ رَشَادِي فِي الهَوَى بِسُؤَالِهَا","أغَارُ عَلَيْهَا إذْ تَحَمَّلَهَا الخَدُّ",55,"د",1,0],["أضْللتِني في الأرض بَل ألقيْتني","في اليَمِّ مَالي النَّجاءِ رجاءُ",56,"ا",2,0],["أضل برمل اللوى قلبه","فهل ناشد قلبه باللوى",57,"و",2,0],["أضللت صديقية عمريّة","و