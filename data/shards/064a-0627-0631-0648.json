ياريمُ كمْ أدنو وأنتَ ترِيمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9467&r=&rc=324",""]],"verses":[["يا رَوضَ ذي الأَثلِ مِن شَرقَيِّ كاظِمَةٍ","قَد عاوَدَ القَلبُ مِن ذِكراكَ أَديانا",0,"ن",2,1],["يا روّعَ اللهُ قوماً ريعَ جارُهُمُ","والذُّلُّ حيثُ ثَوى جَنْبٌ وهَمْدانُ",1,"ن",1,0],["يَارَوْضَةً لِلأَدَبِ الْمُجْتَنَى","أَغْرَقَهَا الشَّامِتُ فِي حَوْضِ",2,"ض",1,1],["يا رَوْضَةً غَرَسَتْ لِحاظي وَرْدَها","وسَكبْتُ دَمْعيَ دِيمَةً وسَقَيْتُهُ",3,"ت",2,0],["يا رَوضَةً طالَما أَجنَت لَواحِظَنا","وَرداً جَلاهُ الصِبا غَضّاً وَنَسرينا",4,"ن",2,0],["يا رُوحَ أَشْرَفَ مَنْ فَدَّى مَوَاطِنَهْ","بِمَوْتِهِ بَعْدَ طُولَ الْجُهْدِ وَالسَّقَمِ",5,"م",1,0],["يا رَوضةَ الوضَّاحِ قَد","عَنَّيتِ وَضَّاحَ اليَمَن",6,"ن",1,1],["يَارَوضُ حُبُّكِ سَلَّ جِسمي وانتَحى","في العَظمِ حتى قَد بَلَغتِ مُشَاشِي",7,"ش",2,0],["يا رَوضُ جيرانُكُمُ البَاكِرُ","فَالقَلبُ لاَ لاَهٍ ولا صَابِرُ",8,"ر",1,1],["يا روضةَ الحسنِ إنَّ النفسَ خضراءُ","فهل يدٌ بيننا للوصلِ بيضاءُ",9,"ا",2,1],["يا روضة تجني بألحاظها","فتجتني حرّ الشقا من نعيم",10,"م",1,0],["يا رَوضَةً في سَماءِ الرَوضِ طائِرَةً","وَطائِراً كَالأَقاحي ذا شَذى ذاكِ",11,"ك",1,0],["يا رَوضَةَ الحُسنِ صِلي","فَما عَلَيكِ ضَيرُ",12,"ر",1,1],["يا روضة الشعر مالي عنك من حول","ما دام في ايكك الفينان غريد",13,"د",1,0],["يا روح هذه الدنى","شرارة منك أنا",14,"ن",2,1],["يا روضةَ الحُسْن إنْ ضَنِّ السَّحَابُ بما","يرويكِ أغناكِ عنه دمعِيَ الهَطِلُ",15,"ل",1,1],["يا روضةَ حسنٍ ليتَها لي وحدي","الشركةُ فيكِ قَدْ أذابَتْ كبدي",16,"ي",1,1],["يا روضَ علمٍ ويا سَحابَ ندىً","لا زِلتَ لا زِلتَ عيشَنا الرَّغدا",17,"د",2,1],["يا رَوحُ كَم تَحمُلينَ الجِسمَ لاهِيَةً","أَبلَيتِهِ فَاِطرَحيهِ طالَما لُبِسا",18,"س",2,1],["يا روحُ شَخصي مَنزِلٌ أُو طَنتَهُ","وَرَحَلتِ عَنهُ فَهَل أَسِفتِ وَقَد هُدِم",19,"م",1,1],["يا رَوّعَ الله سَوْطي كم أرُوعُ به","فُؤادَ وجْنَاءَ مثلَ الطائرِ الحَذِرِ",20,"ر",1,0],["يا روض زهرك قد تغير لونُهُ","لا أَنتَ أَنتَ وَلا الشَقيق شَقيق",21,"ق",1,0],["يَا رَوْضَةَ النِّيلِ لا مَسَّتْكِ بَائِقَةٌ","وَلا عَدَتْكِ سَمَاءٌ ذَاتُ أَغ