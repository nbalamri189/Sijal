{"poems":[[91,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[30,"تقول ابنة الغوثي ما لك ههنا","https://www.aldiwan.net/poem1290.html",""],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[193,"برئت من عقيدة الأشرار","https://www.aldiwan.net/poem35101.html","الرجز"],[463,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[551,"لابنة عجلان بالجو رسوم","https://www.aldiwan.net/poem1857.html","مجزوء البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71031","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204654","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89048","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89430","الكامل"],[5518,"إلى متى أنتَ باللذاتِ مشغولُ","https://www.poetsgate.com/ViewPoem.aspx?id=187371",""],[5977,"لا تؤذ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=213062",""],[463,"هبَّتْ ومنها الخلابُ والخدعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60118&r=&rc=174",""]],"verses":[["تؤذى العذارى في الحيا","ة قلة التجارب",0,"ب",1,0],["تُؤَذِّنُني قَبلَ الرَواحِ وَقَد دَنا","مِنَ البَينِ لا دانٍ وَلا مُتَقارِبُه",1,"ب",2,0],["تُؤَذِّنونَ بِزِقٍّ مِنْ جَهالَتِكُمْ","بهِ انْتِفَاخٌ وَجِسْمٌ فيهِ تَرْهِيلُ",2,"ل",1,0],["تُؤذيهِ منّا عصبةُ الأغمارِ","فَاِحرسهُ يا ربِّ من الأشرارِ",3,"ر",1,0],["تؤذنني بالمدى وتخرُقُ من","عمريَ مالا تسدُّه الرُّقَعُ",4,"ع",1,0],["تُؤْذِي صَدِيقاً وتُبْدِي ظِنَّةً","تُحْرِزُ سَهماً وسَهْماً ما تَشِيمْ",5,"م",1,0],["تؤذى كرامَ الورى وتُكرِمُ مَنْ","إلى المخازى مُسارِعٌ ساع",6,"ع",1,0],["تؤذن بالكمان لنا فيهفو","الى الطاعات مقترف الذنوب",7,"ب",1,0],["تؤذن بالتكبير فيه مدافعٌ","فيركع منها كل عالٍ ويسجد",8,"د",1,0],["تؤذي علياً في بنيه ولم تزل","تُسقَى الأهاجي والملام الآنيه",9,"ي",2,0],["تؤذنونَ بزقٍّ من جهالتكمْ","به انتفاخٌ وجسمٌ في ترهيلُ",10,"ل",1,0],["تؤذِ قلبي بالقليلِ من الذي","قالوه عني ..أنت تعلم من أنا",11,"ن",2,1],["تؤذنني بالمدى وتخرقُ منْ","عمري ولا تسدُّهُ الرّقعُ",12,"ع",1,0]]}