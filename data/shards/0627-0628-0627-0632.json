{"poems":[[147,"أبا زنة لا زال جدك هابطا","https://www.aldiwan.net/poem11736.html","الطويل"],[191,"يا عين بكي لمسعود بن شداد","https://www.aldiwan.net/poem2248.html","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49559","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121207","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121230","البسيط"],[4412,"","https://poetry.dctabudhabi.ae/diwan/poem/104197","الوافر"],[4912,"أبا زيد اعلم أن من شرب الطلا","https://www.poetsgate.com/ViewPoem.aspx?id=181778",""]],"verses":[["أَبا زَنَّةٍ لا زالَ جَدُّكَ هابِطاً","وَحَدُّكَ مَفلولاً وَسَعيُكَ خَياّبا",0,"ب",2,1],["أبا زُرارةَ لا تبعُدْ فَكُلُّ فتىً","يوماً رهينُ صَفيحاتٍ وأعوادِ",1,"د",1,0],["أبا زُهْرُ والأحْزان حولي فوادحاً","ولولاكَ لم يَخْلُصْ إليّ سرور",2,"ر",1,0],["ابا زبير إلى لقياك يجذبني","شوق ويذهب انسي معظم القلق",3,"ق",1,1],["أبا زبير انا العبد الذي شهدت","بفضله السن الازمان والحقب",4,"ب",1,0],["أبا زين العباد قدتك روحي","وروح الأكرمين من العباد",5,"د",1,1],["أبا زيد اعلم أن من شرب الطلا","تدنس فافهم سر قولي المهذب",6,"ب",1,1]]}