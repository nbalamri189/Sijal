{"poems":[[30,"أعياش قد برذنت خيلك كلها","https://www.aldiwan.net/poem1254.html",""],[69,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85839","المجتث"],[146,"إن لم أكن من راضعى الخمر","https://www.aldiwan.net/poem58375.html","السريع"],[146,"كان الوداد منغصا لوشاتنا","https://www.aldiwan.net/poem58379.html","الكامل"],[354,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[396,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96604","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80051","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52062","الكامل"],[3393,"","https://poetry.dctabudhabi.ae/diwan/poem/107076","المجتث"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62914","المنسرح"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83571","البسيط"],[5376,"وإذا بلغْتَ أواخرَ العشرِ","https://www.poetsgate.com/ViewPoem.aspx?id=214068",""],[5582,"قِف بِالرسومِ الخاليات مخاطباً","https://www.poetsgate.com/ViewPoem.aspx?id=63456",""],[5956,"سخّرْتَ وقتك لنجدتنا","https://www.poetsgate.com/ViewPoem.aspx?id=193506",""],[5956,"تراث يصغي لغناء ابنه ويقول:","https://www.poetsgate.com/ViewPoem.aspx?id=205423",""]],"verses":[["تَحَظّى بِإِنكاحِ اللِئامِ وَإِنَّما","أَتَيتَ الَّتي أَخزَت شُهوداً وَغُيَّبا",0,"ب",2,0],["تَحظَى بها أبناءُ مَنْ يدعو لَهُ","فكأنها وقْفٌ عَلَى مَنْ يُعْقِبُ",1,"ب",1,0],["تحظى بحور وغلما","ن ثم قصر معلى",2,"ل",2,0],["تحظى بها عينى وحاشا يدى","منها وحاشا موضعَ البشرِ",3,"ر",1,0],["تُحظى ظواهرُنا فنُغِمضُ عيننا","عنها ونطمحُ في صوابِ ضمائرِ",4,"ر",1,0],["تَحَظَ بِسِرِّ الصَونِ في سَبيلِها","وَما عَلَيهِ مِن مَعانيها اِشتَمَل",5,"ل",1,0],["تحظى بكل الغنايم","ونيل تلك المعيه",6,"ه",1,0],["تَحظى الملوكُ عُلاه إِذ هيَ قبّلت","مِن راحَتيهِ أَناملاً وَرَواجبا",7,"ب",2,0],["تحظى بكلِّ طريفةٍ من حسنها","غدت العقولُ العشر من روَّادها",8,"د",3,0],["تُحْظَى فَيَقْصُرُ يَومُهَا لِحَدِيثِهَا","وَتَكُونُ فِي غَلَسِ الظَّلاَمِ سَمِيرَا",9,"ر",2,0],["تحظى بما ترتجيه","من المنى والأماني",10,"ن",2,0],["تَحظى بطيفِ الكرى العُيونُ وما","طيفُكِ الاّ الدُّمُوعُ والأَرَقُ",11,"ق",1,0],["تحظ بِنَيلِ مُنىً في كلّ جارِحَةٍ","تَسعى بِها وَاِلتزمها تحيي أَقواما",12,"م",2,0],["تحظَ النعيمَ بما أتاك بها","بالسعدِ إنعاماً من البِشْرِ",13,"ر",1,0],["تَحْظَى المُلُوكُ عُلاً إِذا هِيَ قَبَّلَتْ","مِنْ راحَتَيْهِ أَنامِلاً وَرَواجِبَا",14,"ب",2,0],["تحظى صداقتكم يا شهم تأييدي","عكس الرعاع الألى يحظون تنديدي",15,"د",2,0],["تحظى احتراماً منك شحّاطاتنا","ما منك لا نحظاه يا مولودي",16,"د",2,0]]}