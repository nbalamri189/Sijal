{"poems":[[71,"كم أوري عن لوعتي وأواري","https://www.aldiwan.net/poem4006.html","الخفيف"],[93,"فاح ريحانها ولاح الخزام","https://www.aldiwan.net/poem11347.html","الخفيف"],[93,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[30,"خليلي لا ربع بوهبين مخبر","https://www.aldiwan.net/poem29588.html","الطويل"],[11,"وعاذلة هبت بليل تلومني","https://www.aldiwan.net/poem238.html",""],[37,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[51,"لن تنال العلا بشكر عريب","https://www.aldiwan.net/poem8645.html","الخفيف"],[51,"أبى القلب إلا وجده برخاص","https://www.aldiwan.net/poem64933.html","الطويل"],[51,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[29,"لعمري لقد ناطت هوازن أمرها","https://www.aldiwan.net/poem6165.html","الطويل"],[91,"كلوا واشربوا أيحا الأغنياء","https://www.aldiwan.net/poem62793.html","عموديه"],[32,"كلوا اليوم من رزق الإله وأبشروا","https://www.aldiwan.net/poem27718.html","الطويل"],[85,"يا أيها الدمع الوفي بدار","https://www.aldiwan.net/poem62872.html","الكامل"],[45,"ليالينا بين اللوى فمحجر","https://www.aldiwan.net/poem63636.html","الطويل"],[28,"كأن فريدة سفعاء راحت","https://www.aldiwan.net/poem5058.html","الوافر"],[66,"رو عظامي بسلا","https://www.aldiwan.net/poem38502.html","مجزوء الرجز"],[66,"أذى الجسم شرب الراح قبل اغتذائه","https://www.aldiwan.net/poem39078.html","الطويل"],[80,"أغمر الهوى كم ذا تقطعني عذلا","https://www.aldiwan.net/poem31329.html","الطويل"],[44,"قرى دارهم مني الدموع السوافك","https://www.aldiwan.net/poem30391.html","الطويل"],[44,"تقي جمحاتي لست طوع مؤنبي","https://www.aldiwan.net/poem30583.html","الطويل"],[87,"كل صعب سوى المذلة سهل","https://www.aldiwan.net/poem8345.html","الخفيف"],[31,"صرمت حبلك البغوم وصدت","https://www.aldiwan.net/poem42663.html","الخفيف"],[105,"هم سادة الحرب من شيب وشبان","https://www.aldiwan.net/poem43573.html","البسيط"],[39,"ألا أيها الليل الطويل ألا أصبحي","https://www.aldiwan.net/poem53802.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[46,"إذا سعد البازي البعيد مغاره","https://www.aldiwan.net/poem22650.html","الطويل"],[46,"كل واشرب الناس على خبرة","https://www.aldiwan.net/poem23549.html","السريع"],[15,"أرقت لضوء برق في نشاص","https://www.aldiwan.net/poem45263.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10367","الطويل"],[106,"في ربا الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179685",""],[11,"وعاذلة هبت بليل تلومني،","https://www.poetsgate.com/ViewPoem.aspx?id=16842",""],[90,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[90,"بعد المطر","https://www.poetsgate.com/ViewPoem.aspx?id=179092",""],[80,"أغُمْرَ الهوى كم ذا تُقَطّعُني عَذْلا","https://www.poetsgate.com/ViewPoem.aspx?id=3585",""],[91,"كلوا واشربوا","https://www.poetsgate.com/ViewPoem.aspx?id=53344",""],[51,"غابن الحمد حقَّهُ مغبُونهْ","https://www.poetsgate.com/ViewPoem.aspx?id=30800",""],[99,"فم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=299&r=&rc=32",""],[133,"ربع أسماء إذ هي الأنس آلا","https://www.aldiwan.net/poem54778.html","الطويل"],[187,"كلوا واشربوا في عيدكم وتمتعوا","https://www.aldiwan.net/poem43694.html","الطويل"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[196,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[199,"قفا نقتبس من نور تلك الركائب","https://www.aldiwan.net/poem51987.html","الطويل"],[251,"كفى ما جرى يا عين من دمع حسرة","https://www.aldiwan.net/poem15075.html","الطويل"],[262,"ما راعني الليل ولا السبسب","https://www.aldiwan.net/poem38366.html","السريع"],[283,"لي غريم لازم وهو الغرام","https://www.aldiwan.net/poem32465.html","الرمل"],[323,"ذرفت عيني دموعا","https://www.aldiwan.net/poem56351.html","مجزوء الرمل"],[362,"آل بيت النبي ما لي سواكم","https://www.aldiwan.net/poem68119.html","الخفيف"],[365,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[365,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[365,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[365,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[365,"وجهك عند الشموس أضوؤها","https://www.aldiwan.net/poem61008.html","المنسرح"],[392,"أشكو إلى الله الرحيم الودود","https://www.aldiwan.net/poem54592.html","عموديه"],[406,"يا محب النجاة أصغ لقولي","https://www.aldiwan.net/poem49424.html","الخفيف"],[430,"قوم لهم حسن الوفا شيمة","https://www.aldiwan.net/poem41416.html","السريع"],[459,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[459,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[459,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[459,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[459,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[476,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"],[496,"وأبى الدهر لقد جذذ","https://www.aldiwan.net/poem10234.html","مجزوء الرمل"],[501,"كل وقت له من القوم شيخ","https://www.aldiwan.net/poem37749.html","الخفيف"],[515,"يا مصدر البيض محمره وسمر الصعد","https://www.aldiwan.net/poem20869.html","المواليا"],[552,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[559,"بلغوا الحي من عريب كنانه","https://www.aldiwan.net/poem33686.html","الخفيف"],[559,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[559,"لم يكن ذا الكون قط","https://www.aldiwan.net/poem34408.html","مجزوء الرمل"],[559,"اغسلوا بي نجاسة الوسواس","https://www.aldiwan.net/poem34440.html","الخفيف"],[559,"كل وقت جمال وجهك بادي","https://www.aldiwan.net/poem34633.html","الخفيف"],[559,"إن هذا الصبا وهذا الصباحا","https://www.aldiwan.net/poem34664.html","الخفيف"],[576,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["كُلّ وَطفاءَ تحسبُ الرَعدَ فيها","بَعدَ وَهنٍ تَجاوُبَ الأَطيارِ",0,"ر",1,0],["كل وَرْدٍ فِي غَيرِ مِصْرَ لَهُ عَا","مٌ وَفِي مِصْرَ لَيْسَ لِلْوَرْدِ عَامُ",1,"م",1,0],["كُلوا وَاشْرَبُوا مَا لَذَّكُمْ وَحَلالَكُمْ","وَفُضُّوا زُجَاجَ السَّلْسَبِيلِ المُخَتَّمَا",2,"م",2,0],["كَلونِ الحِصانِ الأَنبَطِ البَطنِ قَائِماً","تَمايَلَ عَنهُ الجُلُّ وَاللَونُ أَشقَرُ",3,"ر",1,0],["كُلوا الآنَ مِن رِزقِ الإِلَهِ وَأَيسِرو","فَإِنَّ عَلى الرَحمَنِ رِزقَكُمُ غَدا",4,"د",2,0],["كلوا ما لديكم من سَنام وغارب","إذا غُيَّبت دودان عنكم غُيُوبها",5,"ب",3,0],["كُلُوهُ لا يَكَن لَكُمُ هَنِيئاً","وَلاَ حُلواً فَيُمكِن قَارِمينَا",6,"ن",2,0],["كلُّ وَفْرٍ يفنى ويبقى من الصَّا","حبِ حسنُ الثناءِ للمصحوبِ",7,"ب",1,0],["كلؤلؤة البحرِ التي ظل بُرهةً","يغوص لها الغواص كلِّ مغاص",8,"ص",1,0],["كلْ وأطعمْ فربما راعَ ريْعاً","زاكياً من تعولُه وتَمونه",9,"ن",2,0],["كُلوا الكَلبَ وَاِبنَ العَيرِ وَالباقِعَ الَّذي","يَبيتُ يَعُسُّ اللَيلَ أَهلَ المَقابِرِ",10,"ر",1,0],["كُلوا وَاِشرَبوا أَيُّحا الأَغنِياءُ","وَإِن مَلَأَ السِكَكَ الجائِعون",11,"ن",1,1],["كِلوا لِلظُبى حَقَّ هاماتِهِم","فَإِنَّ المُلوكَ كَذا يَفعَلون",11,"ن",1,0],["كُلوا اليَومَ مِن رِزقِ الإِلَهِ وَأَبشِروا","فَإِنَّ عَلى الرَحمَنِ رِزقَكُمُ غَدا",12,"د",2,1],["كُلٌّ وَإِن شَغَفَتهُ دُنياهُ هَوىً","يَوماً مُطَلِّقُها طَلاقَ نَوارِ",13,"ر",1,0],["كِلوا الغايَةَ القُصوى إِلى مَن يَفوتُكُم","بِها وَدَعوا التَدبيرَ لِاِبنِ المُدَبِّرِ",14,"ر",1,0],["كَلَونِ الأَرضِ يَرقُدُ حَيثُ يُضحي","بِأَعلى التَلعِ أَضمَرَتِ الحِذارا",15,"ر",2,0],["كَلُؤلُؤٍ بِالتِبرِ في","زُمُرِّدٍ مُعَلَّقِ",16,"ق",1,0],["كُلوا وَاِشرَبوا أَمرٌ بِتَرتيبِ شُربِها","وَلا تَشرَبوا الصَهباءَ إِلّا عَلى أَكلِ",17,"ل",1,0],["كلؤلؤةٍ بيضاءَ في الكفِّ أقبلتْ","بياقوتةٍ حمراءَ مظهرةً حَمْلا",18,"ل",2,0],["كُلوا الصَبرَ غَضّاً وَأَشرَبوهُ فَإِنَّكُم","أَثَرتُم بَعيرَ الظُلمِ وَالظُلمُ بارِكُ",19,"ك",1,0],["كَلَوذِهِمُ فيما مَضى مِن جُدودِهِ","بِذي العُرفِ وَالإِحمادِ قَيلٍ وَمَرحَبِ",20,"ب",1,0],["كُلُّ وَغْدٍ أَهْدَى إِلَى اللُّؤْمِ مِنْ بَا","زِ وَلَكِنْ مِنَ الْحِمَارِ أَضَلُّ",21,"ل",1,0],["كُلُّ وَصلٍ أَمسى لَدَيَّ لِأُنثى","غَيرَها وَصلُها إِلَيها أَداءُ",22,"ا",2,0],["كُلُوا من الخَبْطِ نِعمَ الخَبْطُ من أُكُلٍ","لكلّ ذي سَغَبٍ في اللهِ طَيَّانِ",23,"ن",1,0],["كَلَونِ الغَرِيِّ الفَردِ أَجسَدَ رَأسَهُ","عَتائِرُ مَظلومِ الهَدِيِّ المُذَبِّحِ",24,"ح",1,0],["كلُّ وَصْفٍ له ابْتَدَأتَ به استَوْ","عَبَ أخبَارَ الفضلِ مِنه ابتداءُ",25,"ا",2,0],["كِلوا الخِلافَةَ وَاِحشوا عَينَ حاسِدِكُم","قَيحاً يُفَقِّئُهُ العُوّارُ وَالرَمَدُ",26,"د",1,0],["كُلوا طَيِّباً فَالطيبُ فيما طَعِمتُمُ","يُبينُ عَلى أَفواهِكُم خالِصَ الشُكرِ",27,"ر",1,0],["كُل وَاِشرَبِ الناسَ عَلى خِبرَةٍ","فَهُم يَمُرّونَ وَلا يَعذُبون",28,"ن",1,1],["كَلَونِ الماءِ أَسوَدُ ذو قُشورٍ","نُسِجنَ تَلاحُمَ السَردِ الدِلاصِ",29,"ص",1,0],["كُلُّ وُدٍ يَدُولُ لَكِنَّ وُدِّي","لَكَ مَا دُمْتُ ثَابِتٌ لاَ يَدُولُ",30,"ل",1,0],["كُلُّ وَقْتٍ يُمَدَّدُ العِلْمُ فِيهِ","هُوَ لاَ رَيْبَ أَسْمَحُ الأَوْقَاتِ",31,"ت",1,0],["كُلوا الآنَ مِن رِزقِ الإِلَهِ وَأَيسِروا","فَإِنَّ عَلى الرَحمَنِ رِزقَكُمُ غَدا",32,"د",2,0],["كلُّ وجهٍ له الترابُ نقابٌ","غيرَ وجه المهيمِنِ المعبود",33,"د",1,0],["كلوا الآن من رزق الإله، وأيسروا،","فإنّ، على الرّحمانِ، رِزْقَكُمُ غَدا",34,"د",2,0],["كِلُوا إلى الغَيبِ ما يأتي به القَدَرُ","واستَقبلوا يومَكُمْ بالعزمِ وابتدروا",35,"ر",3,1],["كلُّ وجوه الأرض مكسوَّةٌ","لفائفَ الأزهار حتى الطريق",36,"ق",1,0],["كلؤلؤة ٍ بيضاءَ في الكفِّ أقبلتْ","بياقونة ٍ حمراءَ مظهرة ً حَمْلا",37,"ل",2,0],["كلوا واشربوا أيّها الأغنياء","وإن ملأ السكك الجائعون",38,"ن",1,1],["كلوا للظبي حلق عاماتهم","فإنّ الملوك كذا يفعلون",38,"ن",1,0],["كلْ وأطعمْ فربما راعَ ريْعاً","زاكياً ممن تعولُه وتَمونه",39,"ن",2,0],["كلوحة ناجحة .. لونها","أثار حتى حائط المرسم",40,"م",1,0],["كُلُّ وَهمٍ عَالِيهِ خِدرٌ عَلَيه","مِن عِتَاقِ الأَنمَاطِ رَقمٌ مُعَالَى",41,"ل",2,0],["كلوا واشربوا في عيدكم وتمتّعوا","فها أنا عارٍ ما عليّ لباس",42,"س",1,1],["كلوا واطعمونا قبل تغيير حالنا","بكرّ الليالي والنوازل كاس",42,"س",1,0],["كلُّ وحشٍ وكلّ طيرٍ ونبتٍ","نالَ أَمناً فعمّتِ الآلاءُ",43,"ا",2,0],["كلُّ وصفٍ في العالمين جميلٍ","لكَ مَهما تعدّد الأسماءُ",43,"ا",2,0],["كُلَّ وَسمِيَّةٍ تَحَيَّرَ فيها","مِن سُيولِ الرَبيعِ وَالصَيفِ ماءُ",44,"ا",2,0],["كِلُوْنا لأطراف الرماحِ فإننا","نكلنا جميعاً عن لحاظِ الحبائبِ",45,"ب",1,0],["كلوُني إلى ما ترتجي من شفاعةٍ","له في غد تمحو الذي كان من إفكي",46,"ك",2,0],["كل ولم يشبهك إلا كما","أشبه رضوى الرجل الأحدب",47,"ب",1,0],["كُلُّ وَقتٍ مِنهُ تَبدو مِنَنٌ","ما اِهتَدَت قِدماً إِلَيهِنَّ الكِرامُ",48,"م",1,0],["كُلُّ وَجناءَ وَشَهمٍ","عَوهَجٍ ضَخمِ الكُسورِ",49,"ر",1,0],["كُل وَقت يَودّ يلثم قَبرا","أَنتَ فيهِ بمقلتَيه وَيَشهَد",50,"د",1,0],["كَلوءةُ اللَّيْلِ إمّا أقبلَتْ ظُلَمٌ","أَمسَتْ لها طَلْعةٌ للصَّحْبِ تُذْكيها",51,"ي",3,0],["كُلُّ وَرْدٍ وأَدهمٍ مثْل ليلٍ","لمعَتْ قطعةٌ من الصُّبْحِ قِطْعه",52,"ع",2,0],["كلوءُ مُلْكٍ برأْيٍ ما يزالُ له","يُعِدُّه وَزَراً كُلُّ امرئٍ وَزرا",53,"ر",2,0],["كُلُّ وجناءَ إذا ما طَرِبوا","عَطّتِ البيدَ بهم عَطَّ المُلاء",54,"ا",2,0],["كُلُّ وفودِ الأنامِ واردُها","فما سِوى عاذلٍ مُحَلَّؤها",55,"ا",3,0],["كل وراشفه وحظه ينود","غايب عن احساسه ومفقود",56,"د",1,0],["كل وقتٍ لديكَ للّهِ نُعمى","فلتكن شاكراً له كلَ وَقتِ",57,"ت",1,0],["كلو صعبٌ نيل علياهم","عليّهم بدرٌ تلالا بجو",58,"و",1,0],["كلّ وَلاجةٍ إذا امتطت القر","طاسَ لم تنتظر على السمع إذنا",59,"ن",2,0],["كلوءِ العين يحمى جانبيه","إذا ذُعرت مشلَّلةً سَوَامَهْ",60,"م",2,0],["كلّ وجيه الوجه رحبِ الجدا","معذَّل السمع رضيّ الخصالْ",61,"ل",1,0],["كلُّ وضّاحٍ قُدامَى دستِهِ","قُبَلُ الآمالِ تَحفِي البُسُطا",62,"ط",2,0],["كلُّ وغدِ الكفِّ منبوذِ الحيا","طيِّب المحضرِ مسبوبِ المغيبِ",63,"ب",1,0],["كَلَونِ المِلحِ ضَربتُهُ هَبيرٌ","يُتِرُّ العَظمَ سَقّاطٌ سُراطى",64,"ط",2,0],["كل وثابٍ على الده","ر ليوم فيه يُدعى",65,"ع",2,0],["كلُّ وقتٍ له من القَومِ شيخٌ","هو في الأَولِياءِ شيخُ الزَّمانِ",66,"ن",1,1],["كلٌّ وعدته بوعد يا سلالة معد","إلّا أنا بعد يا مورد قناة المعد",67,"د",1,0],["كُلوها بعد غصبكُمُ عليها اِنْ","تِهاباً واِزدراداً واِستراطا",68,"ط",2,0],["كل وردي في حبها شم وردي","وارتياحي تنشق الريحانه",69,"ن",2,0],["كل وقت ما تغنَّى","طائر فوق التلال",70,"ل",1,0],["كل وقت غيرها","من يد الحق سقط",71,"ط",1,0],["كل وقت قلوبهم في انقلاب","أسرتهم خواطر الوسواس",72,"س",1,0],["كل وقت جمال وجهك بادي","يتجلى في مهجتي وفؤادي",73,"د",2,1],["كل وجه له من الله شكل","أتراءى به الجمال الصراحا",74,"ح",2,0],["كُلُّ وجهٍ له يُعَفَّر إِمَّا","بسجودٍ لطاعةٍ أَو سَحْبِ",75,"ب",1,0]]}