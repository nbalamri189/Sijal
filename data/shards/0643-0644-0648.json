/111122","الرمل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62146","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83127","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120481","الخفيف"],[4702,"كلما زاد عمرك يابن آدم نقص","https://www.poetsgate.com/ViewPoem.aspx?id=154552",""],[4702,"كارثة سيول جدة .. 30 / 1 / 2011م","https://www.poetsgate.com/ViewPoem.aspx?id=155464",""],[4755,"كُلُّ وَجهٍ طَرَقتَهُ صارَ ظِلَّا","https://www.poetsgate.com/ViewPoem.aspx?id=193476",""],[4767,"شعلة الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=207342",""],[4802,"مجتمع كان","https://www.poetsgate.com/ViewPoem.aspx?id=34319",""],[4861,"من القلب","https://www.poetsgate.com/ViewPoem.aspx?id=33707",""],[4961,"النصفُ الثاني للإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=33329",""],[4978,"أحمد الدقاسمة","https://www.poetsgate.com/ViewPoem.aspx?id=188844",""],[5011,"سر حبي","https://www.poetsgate.com/ViewPoem.aspx?id=197862",""],[5041,"إنَّما العارُ أنْ يَهونَ السِّلاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=24394",""],[5064,"ما لم تَستطِعْهُ المحابِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=200052",""],[5198,"قلب ابومتعب","https://www.poetsgate.com/ViewPoem.aspx?id=136095",""],[5264,"والله خيبه يا عصام","https://www.poetsgate.com/ViewPoem.aspx?id=179953",""],[5277,"في ظلال (القُشْلَةُ)","https://www.poetsgate.com/ViewPoem.aspx?id=201748",""],[5397,"أخذ الريع من دموعي حذاره","https://www.poetsgate.com/ViewPoem.aspx?id=157939",""],[5409,"حدثينا يا فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=155283",""],[5431,"سطوة المال ...(شجرُ الحب مورقٌ لا انتهاءُ )","https://www.poetsgate.com/ViewPoem.aspx?id=198472",""],[5573,"لاتقول اني على فرقاك قادر​","https://www.poetsgate.com/ViewPoem.aspx?id=204553",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[402,"آية في تسلسل الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=35359",""],[5976,"امزعزعين امضعضعين","https://www.poetsgate.com/ViewPoem.aspx?id=30537",""],[6102,"طيب","https://www.poetsgate.com/ViewPoem.aspx?id=184439",""],[6115,"سامحوا والله مسامح وسامحكم","https://www.poetsgate.com/ViewPoem.aspx?id=196474",""],[6124,"أين","https://www.poetsgate.com/ViewPoem.aspx?id=109739",""],[463,"بكرتْ هيماً تحلُّ الرَّبطا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60115&r=&rc=171",""]],"verses":[["كُلّ وَطفاءَ تحسبُ الرَعدَ فيها","بَعدَ وَهنٍ تَجاوُبَ الأَطيارِ",0,"ر",1,0],["كل وَرْدٍ فِي غَيرِ مِصْرَ لَهُ عَا","مٌ وَفِي مِصْرَ لَيْسَ لِلْوَرْدِ عَامُ",1,"م",1,0],["كُلوا وَاشْرَبُوا مَا لَذَّكُمْ وَحَلالَكُمْ","وَفُضُّوا زُجَاجَ السَّلْسَبِيلِ المُخَتَّمَا",2,"م",2,0],["كَلونِ الحِصانِ الأَنبَطِ البَطنِ قَائِماً","تَمايَلَ عَنهُ الجُلُّ وَاللَونُ أَشقَرُ",3,"ر",1,0],["كُلوا الآنَ مِن رِزقِ الإِلَهِ وَأَيسِرو","فَإِنَّ عَلى الرَحمَنِ رِزقَكُمُ غَدا",4,"د",2,0],["كلوا ما لديكم من سَنام وغارب","إذا غُيَّبت دودان عنكم غُيُوبها",5,"ب",3,0],["كُلُوهُ لا يَكَن لَكُمُ هَنِيئاً","وَلاَ حُلواً فَيُمكِن قَارِمينَا",6,"ن",2,0],["كلُّ وَفْرٍ يفنى ويبقى من الصَّا","حبِ حسنُ الثناءِ للمصحوبِ",7,"ب",1,0],["كلؤلؤة البحرِ التي ظل بُرهةً","يغوص لها الغواص كلِّ مغاص",8,"ص",1,0],["كلْ وأطعمْ فربما راعَ ريْعاً","زاكياً من تعولُه وتَمونه",9,"ن",2,0],["كُلوا الكَلبَ وَاِبنَ العَيرِ وَالباقِعَ الَّذي","يَبيتُ يَعُسُّ اللَيلَ أَهلَ المَقابِرِ",10,"ر",1,0],["كُلوا وَاِشرَبوا أَيُّحا الأَغنِياءُ","وَإِن مَلَأَ السِكَكَ الجائِعون",11,"ن",1,1],["كِلوا لِلظُبى حَقَّ هاماتِهِم","فَإِنَّ المُلوكَ كَذا يَفعَلون",11,"ن",1,0],["كُلوا اليَومَ مِن رِزقِ الإِلَهِ وَأَبشِروا","فَإِنَّ عَلى الرَحمَنِ رِزقَكُمُ غَدا",12,"د",2,1],["كُلٌّ وَإِن شَغَفَتهُ دُنياهُ هَوىً","يَوماً مُطَلِّقُها طَلاقَ نَوارِ",13,"ر",1,0],["كِلوا الغايَةَ القُصوى إِلى مَن يَفوتُكُم","بِها وَدَعوا التَدبيرَ لِاِبنِ المُدَبِّرِ",14,"ر",1,0],["كَلَونِ الأَرضِ يَرقُدُ حَيثُ يُضحي","بِأَعلى التَلعِ أَضمَرَتِ الحِذارا",15,"ر",2,0],["كَلُؤلُؤٍ بِالتِبرِ في","زُمُرِّدٍ مُعَلَّقِ",16,"ق",1,0],["كُلوا وَاِشرَبوا أَمرٌ بِتَرتيبِ شُربِها","وَلا تَشرَبوا الصَهباءَ إِلّا عَلى أَكلِ",17,"ل",1,0],["كلؤلؤةٍ بيضاءَ في الكفِّ أقبلتْ","بياقوتةٍ حمراءَ مظهرةً حَمْلا",18,"ل",2,0],["كُلوا الصَبرَ غَضّاً وَأَشرَبوهُ فَإِنَّكُم","أَثَرتُم بَعيرَ الظُلمِ وَالظُلمُ بارِكُ",19,"ك",1,0],["كَلَوذِهِمُ فيما مَضى مِن جُدودِهِ","بِذي العُرفِ وَالإِحمادِ قَيلٍ وَمَرحَبِ",20,"ب",1,0],["كُلُّ وَغْدٍ أَهْدَى إِلَى اللُّؤْمِ مِنْ بَا","زِ وَلَكِنْ مِنَ الْحِمَارِ أَضَلُّ",21,"ل",1,0],["كُلُّ وَصلٍ أَمسى لَدَيَّ لِأُنثى","غَيرَها وَصلُها إِلَيها أَداءُ",22,"ا",2,0],["كُلُوا من الخَبْطِ نِعمَ الخَبْطُ من أُكُلٍ","لكلّ ذي سَغَبٍ في اللهِ طَيَّانِ",23,"ن",1,0],["كَلَونِ الغَرِيِّ الفَردِ أَجسَدَ رَأسَهُ","عَتائِرُ مَظلومِ الهَدِيِّ المُذَبِّحِ",24,"ح",1,0],["كلُّ وَصْفٍ له ابْتَدَأتَ به استَوْ","عَبَ أخبَارَ الفضلِ مِنه ابتداءُ",25,"ا",2,0],["كِلوا الخِلافَةَ وَاِحشوا عَينَ حاسِدِكُم","قَيحاً يُفَقِّئُهُ العُوّارُ وَالرَمَدُ",26,"د",1,0],["كُلوا طَيِّباً فَالطيبُ فيما طَعِمتُمُ","يُبينُ عَلى أَفواهِكُم خالِصَ الشُكرِ",27,"ر",1,0],["كُل وَاِشرَبِ الناسَ عَلى خِبرَةٍ","فَهُم يَمُرّونَ وَلا يَعذُبون",28,"ن",1,1],["كَلَونِ الماءِ أَسوَدُ ذو قُشورٍ","نُسِجنَ تَلاحُمَ السَردِ الدِلاصِ",29,"ص",1,0],["كُلُّ وُدٍ يَدُولُ لَكِنَّ وُدِّي","لَكَ مَا دُمْتُ ثَابِتٌ لاَ يَدُولُ",30,"ل",1,0],["كُلُّ وَقْتٍ يُمَدَّدُ العِلْمُ فِيهِ","هُوَ لاَ رَيْبَ أَسْمَحُ الأَوْقَاتِ",31,"ت",1,0],["كُلوا الآنَ مِن رِزقِ الإِلَهِ وَأَيسِروا","فَإِنَّ عَلى الرَحمَنِ رِزقَكُمُ غَدا",32,"د",2,0],["كلُّ وجهٍ له الترابُ نقابٌ","غيرَ وجه المهيمِنِ المعبود",33,"د",1,0],["كلوا الآن من رزق الإله، وأيسروا،","فإنّ، على الرّحمانِ، رِزْقَكُمُ غَدا",34,"د",2,0],["كِلُوا إلى الغَيبِ ما يأتي به القَدَرُ","واستَقبلوا يومَكُمْ بالعزمِ وابتدروا",35,"ر",3,1],["كلُّ وجوه الأرض مكسوَّةٌ","لفائفَ الأزهار حتى الطريق",36,"ق",1,0],["كلؤلؤة ٍ بيضاءَ في الكفِّ أقبلتْ","بياقونة ٍ حمراءَ مظهرة ً حَمْلا",37,"ل",2,0],["كلوا واشربوا أيّها الأغنياء","وإن ملأ السكك الجائعون",38,"ن",1,1],["كلوا للظبي حلق عاماتهم","فإنّ الملوك كذا يفعلون",38,"ن",1,0],["كلْ وأطعمْ فربما راعَ ريْعاً","زاكياً ممن تعولُه وتَمونه",39,"ن",2,0],["كلوحة ناجحة .. لونها","أثار حتى حائط المرسم",40,"م",1,0],["كُلُّ وَهمٍ عَالِيهِ خِدرٌ عَلَيه","مِن عِتَاقِ الأَنمَاطِ رَقمٌ مُعَالَى",41,"ل",2,0],["كلوا واشربوا في عيدكم وتمتّعوا","فها أنا عارٍ ما عليّ لباس",42,"س",1,1],["كلوا واطعمونا قبل تغيير حالنا","بكرّ الليالي والنوازل كاس",42,"س",1,0],["كلُّ وحشٍ وكلّ طيرٍ ونبتٍ","نالَ أَمناً فعمّتِ الآلاءُ",43,"ا",2,0],["كلُّ وصفٍ في العالمين جميلٍ","لكَ مَهما تعدّد الأسماءُ",43,"ا",2,0],["كُلَّ وَسمِيَّةٍ تَحَيَّرَ فيها","مِن سُيولِ الرَبيعِ وَالصَيفِ ماءُ",44,"ا",2,0],["كِلُوْنا لأطراف الرماحِ فإننا","نكلنا جميعاً عن لحاظِ الحبائبِ",45,"ب",1,0],["كلوُني إلى ما ترتجي من شفاعةٍ","له في غد تمحو الذي كان من إفكي",46,"ك",2,0],["كل ولم يشبهك إلا كما","أشبه رضوى الرجل الأحدب",47,"ب",1,0],["كُلُّ وَقتٍ مِنهُ تَبدو مِنَنٌ","ما اِهتَدَت قِدماً إِلَيهِنَّ الكِرامُ",48,"م",1,0],["كُلُّ وَجناءَ وَشَهمٍ","عَوهَجٍ ضَخمِ الكُسورِ",49,"ر",1,0],["كُل وَقت يَودّ يلثم قَبرا","أَنتَ فيهِ بمقلتَيه وَيَشهَد",50,"د",1,0],["كَلوءةُ اللَّيْلِ إمّا أقبلَتْ ظُلَمٌ","أَمسَتْ لها طَلْعةٌ للصَّحْبِ تُذْكيها",51,"ي",3,0],["كُلُّ وَرْدٍ وأَدهمٍ مثْل ليلٍ","لمعَتْ قطعةٌ من الصُّبْحِ قِطْعه",52,"ع",2,0],["كلوءُ مُلْكٍ برأْيٍ ما يزالُ له","يُعِدُّه وَزَراً كُلُّ امرئٍ وَزرا",53,"ر",2,0],["كُلُّ وجناءَ إذا ما طَرِبوا","عَطّتِ البيدَ بهم عَطَّ المُلاء",54,"ا",2,0],["كُلُّ وفودِ الأنامِ واردُها","فما سِوى عاذلٍ مُحَلَّؤها",55,"ا",3,0],["كل وراشفه وحظه ينود","غايب عن احساسه ومفقود",56,"د",1,0],["كل وقتٍ لديكَ للّهِ نُعمى","فلتكن شاكراً له كلَ وَقتِ",57,"ت",1,0],["كلو صعبٌ نيل علياهم","عليّهم بدرٌ تلالا بجو",58,"و",1,0],["كلّ وَلاجةٍ إذا امتطت القر","طاسَ لم تنتظر على السمع إذنا",59,"ن",2,0],["كلوءِ العين يحمى جانبيه","إذا ذُعرت مشلَّلةً سَوَامَهْ",60,"م",2,0],["كلّ وجيه الوجه رحبِ الجدا","معذَّل السمع رضيّ الخصالْ",61,"ل",1,0],["كلُّ وضّاحٍ قُدامَى دستِهِ","قُبَلُ الآمالِ تَحفِي البُسُطا",62,"ط",2,0],["كلُّ وغدِ الكفِّ منبوذِ الحيا","طيِّب المحضرِ مسبوبِ المغيبِ",63,"ب",1,0],["كَلَونِ المِلحِ ضَربتُهُ هَبيرٌ","يُتِرُّ العَظمَ سَقّاطٌ سُراطى",64,"ط",2,0],["كل وثابٍ على الده","ر ليوم فيه يُدعى",65,"ع",2,0],["كلُّ وقتٍ له من القَومِ شيخٌ","هو في الأَولِياءِ شيخُ الزَّمانِ",66,"ن",1,1],["كلٌّ وعدته بوعد يا سلالة معد","إلّا أنا بعد يا مورد قناة المعد",67,"د",1,0],["كُلوها بعد غصبكُمُ عليها اِنْ","تِهاباً واِزدراداً واِستراطا",68,"ط",2,0],["كل وردي في حبها شم وردي","وارتياحي تنشق الريحانه",69,"ن",2,0],["كل وقت ما تغنَّى","طائر فوق التلال",70,"ل",1,0],["كل وقت غيرها","من يد الحق سقط",71,"ط",1,0],["كل وقت قلوبهم في انقلاب","أسرتهم خواطر الوسواس",72,"س",1,0],["كل وقت جمال وجهك بادي","يتجلى في مهجتي وفؤادي",73,"د",2,1],["كل وجه له من الله شكل","أتراءى به الجمال الصراحا",74,"ح",2,0],["كُلُّ وجهٍ له يُعَفَّر إِمَّا","بسجودٍ لطاعةٍ أَو سَحْبِ",75,"ب",1,0],["كِلُوهُمُ إلَينا إن خَذَلتُم فَإنَّنا","إلى ضُرِّهِم أَهدَى مِنَ اليَدِ للفَمِ",76,"م",1,0],["كلؤلوءٍ عَهدَ كسرى","صباحَ نيروزَ يُنثَر",77,"ر",1,0],["كُلُّ وَقتٍ أَظفارُها مُنْشَباتٌ","لِاِفتِراسِ الأَشرافِ وَالأَنذالِ",78,"ل",1,0],["كُلِّ وَاهِي الْقُوَى نَؤُومٍ إِذَا مَا","نَهَضَ النَّاسُ للْعُلَى رَبَّاضِ",79,"ض",1,0],["كلوا عجْوة الوادي فإن بلاءَكم","قليلٌ إذا ما كان يومٌ قُماطرُ",80,"ر",1,0],["كل ورد حامل منا شذى","مسكر الفوح وحباً وافتتاناً",81,"ن",2,0],["كلوم في الحشى بِمَدى الزَّمان","وَقَد ثرم الأَواني وَالمَغاني",82,"ن",2,1],["كل وصف حكاه سر التلاقي","هو ذكر المحب وصف الحبيب",83,"ب",1,0],["كُلوها يكلُّ الداء عنكم فانني","أزوركم للشوق لا زرت عائدا",84,"د",2,0],["كل وبعض واشتمال للبدل","وغلط نسيان اضراب ببل",85,"ل",1,0],["كلُّ وجه من المُلوك لديه","مظلم كالهلال عند المحاقِ",86,"ق",1,0],["كلّ وقتٍ يمرُّ منه تراه","باردَ الظلِّ طيباً مستنيرا",87,"ر",2,0],["كلّ وطّاءٍ على شوكِ القنا","إثرَ مشاءٍ على الجمر اختيالا",88,"ل",2,0],["كلوا انف جبار بكارا فانه","تركناه عن فرط من الشر اجدعا",89,"ع",2,0],["كل وقتٍ مضى ولم أمتدحه","فيه أضحى على حياتي عارا",90,"ر",2,0],["كلوا ما اشتهيتم فوقها من سِماكَها","وغنّوا بما شئتم وصيحوا أوِ اطرَبوا",91,"ب",3,0],["كل وجود هو من وجوده","فكل موجود رهين جوده",92,"ه",1,0],["كل وصف جميل مد فمقصو","ر عليهكم يا أطلس يا علاء",93,"ا",2,0],["كِلٍ ولِهْ مقدَّر ومَا