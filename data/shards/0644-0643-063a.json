{"poems":[[85,"لك غرة ود الصباح جمالها","https://www.aldiwan.net/poem54261.html","الكامل"],[164,"شكوى الهدى وتعلق الإسلام","https://www.aldiwan.net/poem59211.html","الكامل"],[519,"لك غصن قد بأنواع البها أثمر","https://www.aldiwan.net/poem20922.html","المواليا"],[572,"ما ترى في الصبوح أيدك الله","https://www.aldiwan.net/poem69743.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138247",""],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120023","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120001","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96031","الكامل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216558",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110064","الكامل"],[4988,"كل جنس الخود إلاكي .,., حدر","https://www.poetsgate.com/ViewPoem.aspx?id=153966",""],[5370,"نون","https://www.poetsgate.com/ViewPoem.aspx?id=81630",""],[5431,"ادنُ مني...","https://www.poetsgate.com/ViewPoem.aspx?id=196602",""],[5431,"الى قمرٍ أسمر...","https://www.poetsgate.com/ViewPoem.aspx?id=198438",""],[6056,"عبير الورد","https://www.poetsgate.com/ViewPoem.aspx?id=130354",""],[6202,"خجلي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86719&r=&rc=20",""],[572,"ما تَرَى في الصبوحِ أيّدَكَ اللّه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9212&r=&rc=69",""]],"verses":[["لك غُرَّةٌ ودَّ الصّباحُ جمالَها","ومحاسنٌ تهوى البدور كمالَها",0,"ل",3,1],["لك غيرة والله قد أوذي فما","منك امرؤ أولى بحسن قيام",1,"م",1,0],["لك غصن قدٍّ بأنواع البها أثمر","وليل فرعٍ بواضح غرَّتك أقمر",2,"ر",1,1],["لك غيرُ القَبيحِ ما تَبْتَغي مِنْ","ه وحَاشَاكَ مِنْ فَعَالٍ القَبِيْحِ",3,"ح",1,0],["لك غابط لا حاسد أو شانىءٌ","أقصاهما الرحمن عنك بعيدا",4,"د",2,0],["لك غرة كالبدر ريش","رق بشرها ويد كبحرِ",5,"ر",1,0],["لك غرة تجلو الخطوبَ كأَنَّها","في كلِّ داجِيَة شهاب لائحُ",6,"ح",1,0],["لك غر افعال اذا استقريتها","أخذت علي مغاوراً ونجودا",7,"د",2,0],["لِك غلا وِحروز حِرّاسِ","وحِشْمَه بالمِدراه مَحفوفه",8,"ف",2,0],["لك غُرَّةٌ ظلمت وقلبٌ ظالمٌ","قد حِرتُ ايُّهما الأَجَنُّ الأَظلَمُ",9,"م",1,0],["لك غلا لو باح قلبي يا غلاي","ينحني تقدير ويفوح الزهر",10,"ر",1,0],["لك غرام محشّم ومحزون","هو سبب \" عابرة \" وفنونها",11,"ن",3,0],["لك غيمي مكثف الغيم قلبي","وهطولي في روضة من رباكا",12,"ك",2,0],["لك غنى مزقزقا بانتشاء","بوح شعري محلقا في صعود",13,"د",1,0],["لك غلا ًمهما العوا ذل تذمّك","فوق ماتتصوره في خيالك",14,"ك",1,0],["لك غزة الأحرار رب إن رمى","لم يبق من سهل لهم وجبال",15,"ل",1,0],["لكَ غَيرُ القبيحِ ما تَبتَغِي في","هِ وحَاشَاكَ من فِعَالِ القَبيحِ",16,"ح",1,0]]}