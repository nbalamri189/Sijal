{"poems":[[79,"كن من صروف الردى على حذر","https://www.aldiwan.net/poem36441.html","المنسرح"],[90,"يا عدل طال الانتظار فعجل","https://www.aldiwan.net/poem44798.html","الكامل"],[49,"هل تعطفان على العليل","https://www.aldiwan.net/poem25175.html","مجزوء الكامل"],[53,"يا أبا إسحاق واقلب","https://www.aldiwan.net/poem65439.html","مجزوء الرمل"],[53,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[91,"قد أسمعتك أنينها الأوطان","https://www.aldiwan.net/poem44941.html","الكامل"],[91,"تأن في الظلم تخفيفا وتهوينا","https://www.aldiwan.net/poem44960.html","البسيط"],[87,"يا عدو الله والرسل","https://www.aldiwan.net/poem7565.html","مجزوء الرمل"],[87,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[47,"أترى اللاحي وقد أروح","https://www.aldiwan.net/poem65646.html","مجزوء الرمل"],[71,"يا عدتي يا عمدتي","https://www.aldiwan.net/poem29259.html","مجزوء الرجز"],[107,"نبئت ما صنع الذين تألفوا","https://www.aldiwan.net/poem43090.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85551","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85547","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85556","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116947","الخفيف"],[108,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[90,"يا عدل طال الانتظار فعجلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19514&r=&rc=17",""],[132,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[147,"فت الورى فعلام ذا الإجهاد","https://www.aldiwan.net/poem11754.html","الكامل"],[147,"من عف عن ظلم العباد تورعا","https://www.aldiwan.net/poem11773.html","الكامل"],[266,"زد علا ما لحده من تناه","https://www.aldiwan.net/poem38145.html","الخفيف"],[276,"بكى الغريب لفقد الدار والجار","https://www.aldiwan.net/poem52093.html","البسيط"],[276,"لكل خطب مهم حسبي الله","https://www.aldiwan.net/poem52129.html","البسيط"],[309,"يا هاجري كم ذا تكون مهاجري","https://www.aldiwan.net/poem16862.html","الكامل"],[376,"يا عدل في لقب العداله","https://www.aldiwan.net/poem57204.html","مجزوء الكامل"],[376,"يا عدل تصلح عدلا","https://www.aldiwan.net/poem57535.html","المجتث"],[438,"تيم قلبي أغيد","https://www.aldiwan.net/poem12484.html","مجزوء الرجز"],[453,"شوقي إليكم مثل وجدي فيكم","https://www.aldiwan.net/poem53724.html","الكامل"],[563,"كان أنا سيدي","https://www.aldiwan.net/poem34417.html","مجزوء السريع"],[563,"وجود كوني من تجلي الجواد","https://www.aldiwan.net/poem34632.html","السريع"],[572,"عادات طيفك أن يعاود","https://www.aldiwan.net/poem69711.html","مجزوء الكامل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216866","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96751","الرمل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112886","البسيط"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128081","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132252","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69342","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69404","السريع"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104803","الكامل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67958","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104684","الكامل"],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113676","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202774",""],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112600","الخفيف"],[3484,"","https://poetry.dctabudhabi.ae/diwan/poem/216401",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135728","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101395","الخفيف"],[4119,"كلما خالسته نظري","https://www.poetsgate.com/ViewPoem.aspx?id=16163",""],[3271,"ثورة الإسلام في بدر","https://www.poetsgate.com/ViewPoem.aspx?id=103535",""],[5183,"مأساة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=186493",""],[5183,"النافقاء","https://www.poetsgate.com/ViewPoem.aspx?id=186606",""],[5376,"جاد بسْمُ العرْبِ يسري في فمي","https://www.poetsgate.com/ViewPoem.aspx?id=188477",""],[5442,"يامن إليه بعزه اتشفع","https://www.poetsgate.com/ViewPoem.aspx?id=114749",""],[5845,"لكلِّ خطبٍ مهمٍّ حسبيَ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198425",""],[5897,"بين الخوف والرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=156850",""]],"verses":[["يا عِدْلَ سَرْجٍ يا دنَّ مُقْتَعَدٍ","مَلآنَ منْ رِيبَةٍ ومنْ قَذَرِ",0,"ر",1,0],["يا عدل طَال الانتظار فعجِلِّ","يا عدل ضاق الصبر عنك فأقبل",1,"ل",1,1],["يا عدل ليس على سواك مُعوَّل","هلا عطفت على الصَريخ المعْوِل",1,"ل",1,0],["ياعُدَّتي في النائِبا","تِ وَظُلَّتي عِندَ المَقيلِ",2,"ل",1,0],["يا عدو الزاد يا ثع","بان موسى المتلقف",3,"ف",1,0],["يا عدة الملك وأملاكه","لحادث ينباق مُنباقه",4,"ق",2,0],["يا عدل إنك أنت محبوب لنا","حتامَ هذا الصدُّ والهِجران",5,"ن",1,0],["يا عدلُ ألقى الياس في أرواحنا","يا عدل منك المطلُ والليانُ",5,"ن",1,0],["يا عدل منذ صددت عنا مالنا","يا عدل عنك بحالة سلوان",5,"ن",1,0],["يا عدل إنا قد تفارقنا كما","تتفارق الأرواح والأبدان",5,"ن",1,0],["يا عدل إن التفاتاً منك يسعدنا","يا عدل إن ابتساما منك يكفينا",6,"ن",2,0],["يا عدل من كانَ محبوباً محاسنه","ما هَكَذا يصرم القوم المحبينا",6,"ن",2,0],["يا عدوّ الله والرس","ل وسبَّاب الخليفة",7,"ه",1,1],["يا عَدُوَّ القَيدِ لَم يَلمَح لَهُ","شَبَحاً في خُطَّةٍ إِلّا أَباها",8,"ا",3,0],["يا عَدُوّاً في غِناهُ","وَصَديقاً في اِختِلالِه",9,"ل",2,0],["يا عُدَّتي يا عُمدتي","يا قُدوتي يا جابري",10,"ر",2,1],["يا عُدَّةَ الوادي لِيَومِ رَجائِهِ","وَعَتادِهِ لِلحادِثِ المُنتابِ",11,"ب",1,0],["يا عدل أنت مشاع النفع مشترك","فهل يظل نصيبي منك حرمانا",12,"ن",2,0],["يا عدل سيفك محمود صرامته","في حده الحد بين الجد واللعب",13,"ب",1,0],["يا عدل بعدك من للاهفين ومن","للواقفين تجاه الموت والعطب",14,"ب",1,0],["يا عدل من لمروع بات مرتجفاً","وَصارخ قد دعا بالويل والحرب",14,"ب",1,0],["يا عدل هل أنت في يوم معاودنا","فبعدك العيش لم يحسن ولم يطب",14,"ب",1,0],["يا عدل حسنك بعد اللَه نعشقه","حتَّام أنت عن العشاق في حُجُب",14,"ب",1,0],["يَا عَدُوَّ الجَهْلِ المُمَوَّهِ بِالعِلْ","مِ عَلَى شَكْلِهِ المُرِيبِ الْعَتِيد",15,"د",1,0],["يا عَدُوّاً شَمِتوا بي","لا تَسُبّوا اللَهُ عَدوا",16,"و",2,0],["يا عدولَ البلادِ أنتُم ذِئابٌ","ستترتكم عن العيونِ الثيابُ",17,"ب",1,1],["يا عدوَ النيران إِن هي شبَّت","كيف أصبحت مشعل النيران؟",18,"ن",1,0],["يا عدل ليس على سواك معوَّل","هلا عطفت عن الصريخ المعْول",19,"ل",1,0],["يا عديمَ النظيرٍ دامَ لك الدهرُ","فمزَّقْ عنّا ثيابَ دَهائه",20,"ا",3,0],["يا عُدَّةَ الإِسلامِ مَن ذا يَشتَكي","ظَمَأً وَعِدُّكَ لِلعُفاةِ عَتادُ",21,"د",1,0],["يا عُدَّةَ الخُلَفاءِ كَم لَكَ مِن يَدٍ","قامَ الزَمانُ بِها خَطيباً مِصقَعا",22,"ع",2,0],["يا عديم الشبيه في الجود","والأشباح منها عديمة الأشباه",23,"ه",1,0],["يا عدتي يا رَجائي في النَوائب يا","عزى وَكنزى وَيسرى بعد اعساري",24,"ر",2,0],["يا عدتي يا نجاتي في الخطوب إِذا","ضاقَ الخناق لِقَلب جل بَلواه",25,"ا",2,0],["يا عدتي في شدتي يا عمدتي","في مدني ومواردي ومصادري",26,"ر",2,0],["يا عدلُ في لَقبِ العَدالَه","فألٌ تؤمِّلُ أَن تَنالَه",27,"ل",2,1],["يا عدلُ تصلحُ عدلاً","على وجوهِ النساءِ",28,"ا",2,1],["يا عُدّتي في النّوبِ","ومنقِذي من زمني",29,"ي",1,0],["يا عدتى لغدي ويومي والذي","ن بهم أصول على الزمان وأحكم",30,"م",1,0],["يا عدماً ظاهراً","ما بوجود قضا",31,"ض",2,0],["يا عدماً أحرفه خطها","كاتبه النور بنور المدادْ",32,"د",1,0],["يا عُدَّةً نَعْتَدُّهَا","لِحَوَادِثِ الزَّمَنِ الشدائِدْ",33,"د",1,0],["يا عدياَّ لقلبك المُهتاجِ","إنْ عفا رسمُ منزلٍ بالنّباجِ",34,"ج",1,1],["يا عديم الشعور جهلا إلى كم","أنت في اللهو تنظم الشعارا",35,"ر",2,0],["يا عديماً إن ترد في ال","عيشِ أن تنعمَ بالا",36,"ل",2,0],["يا عدة الخائف الجاني الذي ظلم","جد بالرضا وهدى بالحسن قد ختما",37,"م",2,0],["يا عدتى للنائبات وعمدتى","في الحادثات ومنيتى في مأملى",38,"ل",2,0],["يا عدتي يا عمدتي يا نزهتي","يا نصرتي يا زينتي ومنار",39,"ر",1,0],["يا عدوَّ الإنسانِ قد كنتَ حرباً","أعلنتها حماقةُ الطغيانِ",40,"ن",1,0],["يا عُدَّةَ الدَولَةِ القِرمُ الَّذي فَعَلَت","أَفعالَهُ الغُرُّ مالا تَفعَلُ العُدَدُ",41,"د",1,0],["يا عُدَّةَ الدَولَةِ يا مَن لَهُ","مالٌ مُباحٌ وَحِمىً لا يُباح",42,"ح",1,0],["يا عُدَّتِى فِى شِدَّتِى يا مُنقِذِى","فِى يَومِ تَأتِى النَّاسُ فِيهِ شِحَاحَا",43,"ح",2,0],["يا عديلَ القرآن من بينِ ذي الخَ","لقِ ويا واحداً من الثَّقلينِ",44,"ن",1,0],["يا عدتي في كربتي وبجاهه","جليت كروب الأولين سوائي",45,"ا",2,0],["يا عدوًّا قد ظلمنا","هُ بتلقيب الحبيبِ",46,"ب",1,1],["يا عدل يا عدل أين أنتا","نادوك دهراً وما سمعتا",47,"ت",2,1],["يا عداة السلام كم من أذاكم","أخفرت ذمة وديست عهود",48,"د",1,0],["يا عِديل الروح ما وِدّي","الهجِر لي ينفِتِح بابه",49,"ب",2,0],["يا عدلُ يا عفوُّ يا عطوفُ","بالفضل لا ينالنا مخوفُ",50,"ف",1,0],["يا عِدَّ زَفسَ زَفسُ بِالرِسالَه","أَنفَذَني فَاِستَمِعِ المَقالَه",51,"ه",1,0],["يا عداك الردى وقولي عداكا","غير مجدٍ من بعد يوم رداكا",52,"ك",2,0],["يا عديل النفس محتملا","ونزيل الطرف في الحضر",53,"ر",1,0],["يا عدوّ الإسلام خذها من الإسْ","لام ردّتكَ كالقنا المتكسّر",54,"ر",1,0],["يا عدواً تربع القدس عرشاً","جاثماً فوق صدره بلواه",55,"ا",2,0],["يا عدوا كالسمع يوغل في القم","ع ليوهي عزائم الأقوياء",56,"ا",2,0],["يا عدوِّي فارحلِ اليوم فما","لك سكنى في ديارِ المرغمِ",57,"م",1,0],["يا عدتي في شدتي يا نجدتي","في وحدتي فلغيره لا أضرع",58,"ع",1,0],["يا عدتي يا نجاتي في الخطوبِ إذا","ضاقَ الخناقُ لخطبٍ جلَّ بلواهُ",59,"ا",2,0],["يا عدلُ خذ من ضعفنا بحقوقنا","مالت علينا بالردى الأهواءُ",60,"ا",2,0]]}