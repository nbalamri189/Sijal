{"poems":[[74,"رب راح بت أشربها","https://www.aldiwan.net/poem18445.html","المديد"],[74,"قال لي خلي تزوج تسترح","https://www.aldiwan.net/poem20453.html","الرمل"],[53,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[93,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[104,"ما لك والذكريات تذعرها","https://www.aldiwan.net/poem32915.html","المنسرح"],[177,"قال لي يهزأ من لم","https://www.aldiwan.net/poem4415.html","مجزوء الرمل"],[190,"لي صديق يلومني في انفرادي","https://www.aldiwan.net/poem43842.html","الخفيف"],[228,"أيكون الهوى ندى وملابا","https://www.aldiwan.net/poem39721.html","الخفيف"],[275,"سألتني عن علتي وعيائي","https://www.aldiwan.net/poem35302.html","الخفيف"],[347,"ومليح جاء صبحا","https://www.aldiwan.net/poem55351.html","مجزوء الرمل"],[358,"قيل لي ما لعصبة","https://www.aldiwan.net/poem39969.html","مجزوء الخفيف"],[369,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[398,"قال لي ان رقيبي","https://www.aldiwan.net/poem53537.html","مجزوء الرمل"],[409,"يا ضياء الدين يا من مجده","https://www.aldiwan.net/poem34151.html","الرمل"],[415,"من عذيري من شادن لم أطق عن","https://www.aldiwan.net/poem32582.html","الخفيف"],[438,"وسريع الجواب نازعته القول","https://www.aldiwan.net/poem12772.html","الخفيف"],[458,"ها هو الشحاذ لصق البنك","https://www.aldiwan.net/poem61577.html","مجزوء الرمل"],[473,"وعذول كان من قولي له","https://www.aldiwan.net/poem59638.html","الرمل"],[543,"قال ما للسواد لبسك أضحى","https://www.aldiwan.net/poem48244.html","عموديه"],[619,"","https://poetry.dctabudhabi.ae/diwan/poem/203371","زجل"],[1455,"","https://poetry.dctabudhabi.ae/diwan/poem/198839","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80006","الخفيف"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132322","الخفيف"],[2610,"","https://poetry.dctabudhabi.ae/diwan/poem/22596","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201312","السريع"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99520","الرمل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118827","الخفيف"],[3546,"","https://poetry.dctabudhabi.ae/diwan/poem/103371","المنسرح"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77115","الرجز"],[4418,"","https://poetry.dctabudhabi.ae/diwan/poem/95770","الرمل"],[4728,"عابر سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=176954",""],[5057,"زارني في المنام","https://www.poetsgate.com/ViewPoem.aspx?id=198052",""],[5434,"الشاور غشاني","https://www.poetsgate.com/ViewPoem.aspx?id=37612",""],[5763,"ِ شجيٌّ وخليٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=27066",""]],"verses":[["قلت دعها قال قد سُرِقت","من سنا خدّي ومن نَفَثي",0,"ث",2,0],["قلتُ دع نصحك واعْلم أنني","لم أضع بين ظهور المسلمينا",1,"ن",2,0],["قلت داليةً أعانتني الجن","ن عليها لا شك دون الأنيس",2,"س",1,0],["قُلتُ داءٌ في الفُؤادِ اِستَحكَما","كادَ قَلبِيَ مِنهُ أَن يَنفَطِرا",3,"ر",2,0],["قُلت دَعيها غَداً أُفاجئها","أَحلامَها الغرّ لا أُنفّرها",4,"ر",3,0],["قُلتُ دَعنِي مِن مُحالٍ","قَد شَكا الشَّيخُ السَّآمَه",5,"م",2,0],["قلت دعني ووحدتي وانفرادي","مدخل الهمّ من طريق السرور",6,"ر",1,0],["قُلتِ دَعني أَنَل كَما نِلتَ مِنّي","قَطَراتٍ مِنَ العُروقِ عِذابا",7,"ب",2,0],["قلتُ داوي قَلبي المريضَ فقالت","مرضُ القلبِ ما لهُ من دواءِ",8,"ا",2,0],["قلت دعني الان والور","د ودعها في يديكِ",9,"ك",1,0],["قُلت دَعني فَإِنَّنا","كُلّنا ذَلك الرَجل",10,"ل",1,0],["قلتُ دَعْني فجفْنُه الآن يَنضو","سيفَ لحظٍ فيقتلُ الصّبَّ صَبْرا",11,"ر",2,0],["قُلتُ دَعني وَجهُكَ الجَن","نَةُ حُفَّت بِالمَكارِه",12,"ه",1,0],["قلت دعني من تجاريك وقف","وأرحني واسترح من تعبك",13,"ك",1,0],["قُلت دَعْ ذا فأنتَ شَرطي ولكن","لم يَدعْ لي المشيبُ في الجَهلِ عُذْرَا",14,"ر",2,0],["قلتُ دعْني أشمّهُ قال مهلاً","مقصَدُ الشيخِ حسْوُهُ لا ارْتغاؤهُ",15,"ا",3,0],["قلت دولاران فازور","ر كناجٍ من نهيق",16,"ق",1,0],["قُلتُ دَعني عَنكَ وَاِصنَع ما تَشا","ما أَنتَ وَلا أَنتَ أَنا",17,"ن",2,0],["قلتُ دَعنِي فما علمتَ بِحالِي","ماتَ حَظِّي وقد لَبِستُ السَّوادا",18,"د",2,0],["قلت دي ريحة رحيق","وإلا تفاح يا مقيصف",19,"ف",1,0],["قلت دعني أمت بدائي فإّني","لو براني الغرام لا أبديه",20,"ي",2,0],["قلتُ دعني ومقلةً لي عبرى","ببكاها ومهجة لي حرَّى",21,"ر",2,0],["قُلتُ دَعنِي إنَّ الجسُورَ الذي لا","يترُكُ الأمرَ آيلاً للنجاحِ",22,"ح",1,0],["قُلتُ دَندانَ أَغِثني فَمَضى","وَأَنا أَعلو وَأَهوي في الدَّرَك",23,"ك",1,0],["قلت دعوني من دعاواكمُ","مساخرُ الأرض سرتْ للسما",24,"م",2,0],["قلت دراعةُ عريٍ","تحتها جبةْ رعده",25,"ه",1,0],["قلت دعني فلم يكن بي ملالٌ","غير أنَّ العجيبَ صرفُ الليالي",26,"ل",2,0],["قلتُ دعي سورةً لهجتِ بها","لا تحرِمنّا لذاتنا السور",27,"ر",1,0],["قُلتُ دَعوَه وَدَعوا جَرابَه","هذا مِنَ القُبحِ حَشا إِهابَه",28,"ه",1,0],["قُلت دَعني من رَقاعا","تِكَ واسمع لاِعتِذاري",29,"ر",2,0],["قلت دوم اقول بتهون لكن لا جديد","هي كذيّا قال قل لا ضرار ولا ضرر",30,"ر",1,0],["قلتُ دعنا مِن الحديثِ وأعتِقْ","كبِداً - مِن لظى فِراقِكَ - حرّى",31,"ر",2,0],["قلت دوك اللف خابو شاربينه","غطني عن شوف شي قد غشاني",32,"ن",2,0],["قلتُ : دعني لا تسلني","لستَ مسؤول العواطفْ",33,"ف",1,0]]}