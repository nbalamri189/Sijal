{"poems":[[86,"أتيت سوق عكاظ","https://www.aldiwan.net/poem68903.html","المجتث"],[71,"لا يخدعنك صحة ويسار","https://www.aldiwan.net/poem4009.html","الكامل"],[71,"يا ظالماً جعل القطيعة مذهبا","https://www.aldiwan.net/poem4020.html","الكامل"],[93,"مر في بالنا فأحيانا","https://www.aldiwan.net/poem11201.html","الخفيف"],[93,"في زحلة مولدي بالروح لا البدن","https://www.aldiwan.net/poem11273.html","البسيط"],[88,"يدل على لؤم الغزالة أنها","https://www.aldiwan.net/poem44409.html","الطويل"],[51,"في زخرف القول ترجيح لقائله","https://www.aldiwan.net/poem64095.html","البسيط"],[51,"يا قمر الموكب والمجلس","https://www.aldiwan.net/poem64576.html","السريع"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[85,"في زهرتَي ذا العود من أهل الهوى","https://www.aldiwan.net/poem7756.html","مجزوء الكامل"],[85,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[56,"عين بكت وادي العقيق بمثله","https://www.aldiwan.net/poem58922.html","الكامل"],[45,"من عذيري من الظباء الغيد","https://www.aldiwan.net/poem63503.html","الخفيف"],[45,"أبكاء في الدار بعد الدار","https://www.aldiwan.net/poem63605.html","الخفيف"],[45,"ماجو خبت وإن نأت ظعنه","https://www.aldiwan.net/poem66814.html","المنسرح"],[61,"غضبان ينساني وأذكره","https://www.aldiwan.net/poem51669.html","أحذ الكامل"],[80,"أعطيت حكمك في الأيام فاحتكم","https://www.aldiwan.net/poem31290.html","البسيط"],[31,"ولقد أشهد المحدث عند ال","https://www.aldiwan.net/poem41284.html","الخفيف"],[31,"ضحكت أم نوفل إذ رأتني","https://www.aldiwan.net/poem41286.html","الخفيف"],[40,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42569","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54985","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54738","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54638","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[106,"نذير الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179329",""],[45,"مَنْ عَذِيرِي مِنَ الظّبَاءِ الغِيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31417",""],[75,"كَذبَ السلوُّ، العِشقُ أيسَرُ مركبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10785&r=&rc=5",""],[31,"وَلَقَدْ أَشْهَدُ المُحَدِّثَ عِنْدَ کلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19117&r=&rc=379",""]],"verses":[["في زُمرَةٍ مِن رِفاقٍ","غُرِّ الشَمائِلِ شوسِ",0,"س",1,0],["فَيَزولُ عَنكَ جَميعُ ما أوتيتَ في ال","دُنيا وَلَو زُوِيَت لَكَ الأَمصارُ",1,"ر",1,0],["فَيَزيدُهُ طولُ التَذَلُّلِ عِزَّةً","أَبَداً وَفرطُ الإِعتِذارِ تَعَتُّبا",2,"ب",2,0],["فِي زَمَانٍ بِهِ غَدَتْ","رَوْضَ أَمْنٍ أَغَنَّ رَيَّانَا",3,"ن",2,0],["فِي زَحْلَةٍ مَوْلِدِي بِالرُّوحِ لا البَدَنِ","وَ زَحْلَةٌ بِرِضَى مِنْ أَهْلِهَا وَطَنِي",4,"ي",1,1],["فِي زَحْلَةٍ لِيَ عَهْدٌ مِنْ صِبًى وَهَوًى","فِي زَحْلَةٍ أُسْرَتِي فِي زَحْلَةٍ سَكَنِي",4,"ي",1,0],["فيزعجنا بالخاز باز طنينها","وتقذف أوساخاً علينا فروعها",5,"ع",3,0],["في زخرفِ القول ترجيحٌ لقائلهِ","والحقُّ قد يعتريه بعضُ تغييرِ",6,"ر",1,1],["في زمن الغيث الذي لم يزل","يحكيك في الجود ولم أعكس",7,"س",1,0],["في زَورَقٍ بَينَ الزَوا","رِقِ كَالحَمامَةِ في الطُيورِ",8,"ر",1,0],["في زهرتَي ذا العود من","أهل الهوى جُمعت صفات",9,"ت",1,1],["في زَمانٍ غَبِيَ النا","صِحُ فيهِ أَو تَغابى",10,"ب",2,0],["في زرعي وحامي دونه","كالليث قام محامياً عن شِبلهِ",11,"ل",2,0],["في زَمانٍ كَأَنَّ نَرجِسَهُ الغَض","ضَ سُموطٌ مِن لُؤلُؤٍ وَفَريدِ",12,"د",1,0],["في زُهاهُ أَبو سَعيدٍ عَلى آ","ثارِ خَيلٍ قَد صَبَّحَتهُ بِثارِ",13,"ر",1,0],["في زَمَنٍ رَنَّقَت حَوادِثُهُ","أَشبَهُ شَيءٍ بِحادِثٍ زَمَنُه",14,"ن",2,0],["في زاهرٍ عَبقٍ تَضوُّعُه","فكأنّ عطّاراً يُعَطِّرُه",15,"ر",2,0],["في زاخرٍ من بحورِ الروم عادتُهُ","ألا يزال مشوباً منهمُ بدمِ",16,"م",1,0],["في زَمانٍ مِنَ المَعيشَةِ لَخٍّ","قَد مَضى عَصرُهُ وَهَذا زَمانُ",17,"ن",1,0],["في زَمانٍ لَو كُنتِ فيهِ ضَجيعي","غَيرَ شَكٍّ عَرَفتِ لي عِصياني",18,"ي",1,0],["في زاهِرٍ مِثل النُجُومِ أَمالَهُ","ظَلَمٌ فَتَمَّ وَلَم يَهِج إِعشابُهُ",19,"ب",2,0],["فيَزيدُها دَرُّ السّماحِ تخرّقاً","ويَزيدُها بَسْطُ البنانِ ترحُّبا",20,"ب",2,0],["في زجاج مُحلِّقٍ","لا دخانٌ ولا شرَرْ",21,"ر",1,0],["في زَمَانٍ قَدْ كَانَ لِلظُّلْمِ فِيهِ","أَثَرُ النَّارِ فِي هَشِيمِ الْقَتَادِ",22,"د",1,0],["فِي زهْرةِ العُمْرِ فتىً نابِهٌ","أَصْمَاهُ سهْمٌ لِلردى طاشَا",23,"ش",2,1],["فِي زِينَةٍ نَظَمَ الوَفَاءُ جَمَالَهَا","وَمُرَادُهُ مِنْهَا أَجلُّ مُرَاد",24,"د",1,0],["فِي زُهْرِهَا الغَرَّارِ لِلْسَّارِي","وَفِي الوَرْدِ السَّرَابْ",25,"ب",1,0],["فِي زِينَة لَسْتَ تَدْرِي","زَرْقَاءَ أَوْ خَضْرَاءَ",26,"ا",2,0],["في زمانٍ قد ذلَّ كلُّ إباءٍ","فيه وانقاد كلُّ صعبِ الْحِران",27,"ن",1,0],["فِي زَمَانٍ كَانَ الْقَديِمُ بِهِ قُدْ","ساً يُذَادُ الْجَدِيدُ عَنْ مِحْرَابِهْ",28,"ب",2,0],["في زَمانٍ مَنْ كَانَ يُمْسكُ فِيه","قَلَماً عُدَّ أَكْتَب الكُتَّاب",29,"ب",1,0],["في زمان أَلِفَ الذُّلَّ؛ فمَنْ","رفع الهامةَ فيه، جَوَّعَه",30,"ع",2,0],["فيزدادُ في الإحسان مَن كان مُحْسِنًا","ويُقْلِعُ عن سُوءِ الصنيع مُسِيء",31,"ي",2,0],["في زَمَانٍ كأنّ نَرْجِسَهُ الغَضّ","سُمُوطٌ منْ لُؤلُؤٍ وَفَرِيدِ",32,"د",1,0],["فيزيدها درُّ السّماحِ تخرّقاً","خالَستُه نَظَراً وكانَ مُوَرَّداً",33,"د",2,0],["في زمانٍ من المعيشة ِ لذٍّ،","قد مضى عصره، وهذا زمانُ",34,"ن",1,0]]}