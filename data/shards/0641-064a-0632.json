{"poems":[[86,"أتيت سوق عكاظ","https://www.aldiwan.net/poem68903.html","المجتث"],[71,"لا يخدعنك صحة ويسار","https://www.aldiwan.net/poem4009.html","الكامل"],[71,"يا ظالماً جعل القطيعة مذهبا","https://www.aldiwan.net/poem4020.html","الكامل"],[93,"مر في بالنا فأحيانا","https://www.aldiwan.net/poem11201.html","الخفيف"],[93,"في زحلة مولدي بالروح لا البدن","https://www.aldiwan.net/poem11273.html","البسيط"],[88,"يدل على لؤم الغزالة أنها","https://www.aldiwan.net/poem44409.html","الطويل"],[51,"في زخرف القول ترجيح لقائله","https://www.aldiwan.net/poem64095.html","البسيط"],[51,"يا قمر الموكب والمجلس","https://www.aldiwan.net/poem64576.html","السريع"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[85,"في زهرتَي ذا العود من أهل الهوى","https://www.aldiwan.net/poem7756.html","مجزوء الكامل"],[85,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[56,"عين بكت وادي العقيق بمثله","https://www.aldiwan.net/poem58922.html","الكامل"],[45,"من عذيري من الظباء الغيد","https://www.aldiwan.net/poem63503.html","الخفيف"],[45,"أبكاء في الدار بعد الدار","https://www.aldiwan.net/poem63605.html","الخفيف"],[45,"ماجو خبت وإن نأت ظعنه","https://www.aldiwan.net/poem66814.html","المنسرح"],[61,"غضبان ينساني وأذكره","https://www.aldiwan.net/poem51669.html","أحذ الكامل"],[80,"أعطيت حكمك في الأيام فاحتكم","https://www.aldiwan.net/poem31290.html","البسيط"],[31,"ولقد أشهد المحدث عند ال","https://www.aldiwan.net/poem41284.html","الخفيف"],[31,"ضحكت أم نوفل إذ رأتني","https://www.aldiwan.net/poem41286.html","الخفيف"],[40,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42569","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54985","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54738","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54638","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[106,"نذير الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179329",""],[45,"مَنْ عَذِيرِي مِنَ الظّبَاءِ الغِيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31417",""],[75,"كَذبَ السلوُّ، العِشقُ أيسَرُ مركبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10785&r=&rc=5",""],[31,"وَلَقَدْ أَشْهَدُ المُحَدِّثَ عِنْدَ کلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19117&r=&rc=379",""],[118,"كل يوم لي شكاة","https://www.aldiwan.net/poem49324.html","مجزوء الرمل"],[122,"سكر الدهر فقل لي كيف أَصحو","https://www.aldiwan.net/poem23736.html","الرمل"],[126,"بوركت غرفة وبورك من قام","https://www.aldiwan.net/poem50481.html","الخفيف"],[145,"عن الحب ما لي كلما رمت سلوانا","https://www.aldiwan.net/poem47620.html","الطويل"],[167,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[183,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[219,"أرخصت يوم فراقك الدمعا","https://www.aldiwan.net/poem55275.html","أحذ الكامل"],[278,"أنت للمسلمين حصن وحرز","https://www.aldiwan.net/poem60691.html","الخفيف"],[278,"يا نسيم الصبا الولوع بوجدي","https://www.aldiwan.net/poem60760.html","الخفيف"],[280,"تألق البرق له عشيا","https://www.aldiwan.net/poem32299.html","الرجز"],[320,"ذرفت عيني دموعا","https://www.aldiwan.net/poem56351.html","مجزوء الرمل"],[326,"هتف الشاطىء بالمدح","https://www.aldiwan.net/poem55007.html","مجزوء الرمل"],[360,"سر منقلبًا","https://www.aldiwan.net/poem11643.html","عموديه"],[362,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[369,"سقيا لوقت مضى ورعيا","https://www.aldiwan.net/poem56967.html","الطويل"],[369,"نحن يوما وصل ويوما فراق","https://www.aldiwan.net/poem57277.html","الخفيف"],[374,"دهرنا قد تزندقا","https://www.aldiwan.net/poem59319.html","مجزوء الخفيف"],[388,"يا لطيف الطف بي فيجميع أحوالي","https://www.aldiwan.net/poem54515.html","عموديه"],[397,"وهج الحب","https://www.aldiwan.net/poem6703.html","عموديه"],[399,"كيف يرضيك على الضيم المقام","https://www.aldiwan.net/poem46920.html","الرمل"],[406,"رفقا بقلب الصب رفقا","https://www.aldiwan.net/poem32413.html","مجزوء الكامل"],[413,"ما لها مفرية بيدا فبيدا","https://www.aldiwan.net/poem53936.html","الرمل"],[413,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[413,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[413,"قدحت في مزجها بالماء نارا","https://www.aldiwan.net/poem54186.html","الرمل"],[436,"الآن رد عنان الملك في يده","https://www.aldiwan.net/poem34858.html","البسيط"],[450,"يا بعيدا له القلوب ديار","https://www.aldiwan.net/poem13785.html","الخفيف"],[450,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[450,"ويح قلبي كم ذا يطيق احتمالا","https://www.aldiwan.net/poem13962.html","الخفيف"],[456,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[456,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[459,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[475,"با أدمعي في رسمها الجاري","https://www.aldiwan.net/poem15193.html","الرجز"],[475,"أهدت الي شذا العرار الفائح","https://www.aldiwan.net/poem15194.html","الكامل"],[498,"ولما دعينا والدجا في غلالة","https://www.aldiwan.net/poem37936.html","الطويل"],[536,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[549,"أعلى العهد منزل بالجناب","https://www.aldiwan.net/poem48064.html","الخفيف"],[565,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"],[565,"وصب الهوى ما كان من أوصابه","https://www.aldiwan.net/poem69816.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["في زُمرَةٍ مِن رِفاقٍ","غُرِّ الشَمائِلِ شوسِ",0,"س",1,0],["فَيَزولُ عَنكَ جَميعُ ما أوتيتَ في ال","دُنيا وَلَو زُوِيَت لَكَ الأَمصارُ",1,"ر",1,0],["فَيَزيدُهُ طولُ التَذَلُّلِ عِزَّةً","أَبَداً وَفرطُ الإِعتِذارِ تَعَتُّبا",2,"ب",2,0],["فِي زَمَانٍ بِهِ غَدَتْ","رَوْضَ أَمْنٍ أَغَنَّ رَيَّانَا",3,"ن",2,0],["فِي زَحْلَةٍ مَوْلِدِي بِالرُّوحِ لا البَدَنِ","وَ زَحْلَةٌ بِرِضَى مِنْ أَهْلِهَا وَطَنِي",4,"ي",1,1],["فِي زَحْلَةٍ لِيَ عَهْدٌ مِنْ صِبًى وَهَوًى","فِي زَحْلَةٍ أُسْرَتِي فِي زَحْلَةٍ سَكَنِي",4,"ي",1,0],["فيزعجنا بالخاز باز طنينها","وتقذف أوساخاً علينا فروعها",5,"ع",3,0],["في زخرفِ القول ترجيحٌ لقائلهِ","والحقُّ قد يعتريه بعضُ تغييرِ",6,"ر",1,1],["في زمن الغيث الذي لم يزل","يحكيك في الجود ولم أعكس",7,"س",1,0],["في زَورَقٍ بَينَ الزَوا","رِقِ كَالحَمامَةِ في الطُيورِ",8,"ر",1,0],["في زهرتَي ذا العود من","أهل الهوى جُمعت صفات",9,"ت",1,1],["في زَمانٍ غَبِيَ النا","صِحُ فيهِ أَو تَغابى",10,"ب",2,0],["في زرعي وحامي دونه","كالليث قام محامياً عن شِبلهِ",11,"ل",2,0],["في زَمانٍ كَأَنَّ نَرجِسَهُ الغَض","ضَ سُموطٌ مِن لُؤلُؤٍ وَفَريدِ",12,"د",1,0],["في زُهاهُ أَبو سَعيدٍ عَلى آ","ثارِ خَيلٍ قَد صَبَّحَتهُ بِثارِ",13,"ر",1,0],["في زَمَنٍ رَنَّقَت حَوادِثُهُ","أَشبَهُ شَيءٍ بِحادِثٍ زَمَنُه",14,"ن",2,0],["في زاهرٍ عَبقٍ تَضوُّعُه","فكأنّ عطّاراً يُعَطِّرُه",15,"ر",2,0],["في زاخرٍ من بحورِ الروم عادتُهُ","ألا يزال مشوباً منهمُ بدمِ",16,"م",1,0],["في زَمانٍ مِنَ المَعيشَةِ لَخٍّ","قَد مَضى عَصرُهُ وَهَذا زَمانُ",17,"ن",1,0],["في زَمانٍ لَو كُنتِ فيهِ ضَجيعي","غَيرَ شَكٍّ عَرَفتِ لي عِصياني",18,"ي",1,0],["في زاهِرٍ مِثل النُجُومِ أَمالَهُ","ظَلَمٌ فَتَمَّ وَلَم يَهِج إِعشابُهُ",19,"ب",2,0],["فيَزيدُها دَرُّ السّماحِ تخرّقاً","ويَزيدُها بَسْطُ البنانِ ترحُّبا",20,"ب",2,0],["في زجاج مُحلِّقٍ","لا دخانٌ ولا شرَرْ",21,"ر",1,0],["في زَمَانٍ قَدْ كَانَ لِلظُّلْمِ فِيهِ","أَثَرُ النَّارِ فِي هَشِيمِ الْقَتَادِ",22,"د",1,0],["فِي زهْرةِ العُمْرِ فتىً نابِهٌ","أَصْمَاهُ سهْمٌ لِلردى طاشَا",23,"ش",2,1],["فِي زِينَةٍ نَظَمَ الوَفَاءُ جَمَالَهَا","وَمُرَادُهُ مِنْهَا أَجلُّ مُرَاد",24,"د",1,0],["فِي زُهْرِهَا الغَرَّارِ لِلْسَّارِي","وَفِي الوَرْدِ السَّرَابْ",25,"ب",1,0],["فِي زِينَة لَسْتَ تَدْرِي","زَرْقَاءَ أَوْ خَضْرَاءَ",26,"ا",2,0],["في زمانٍ قد ذلَّ كلُّ إباءٍ","فيه وانقاد كلُّ صعبِ الْحِران",27,"ن",1,0],["فِي زَمَانٍ كَانَ الْقَديِمُ بِهِ قُدْ","ساً يُذَادُ الْجَدِيدُ عَنْ مِحْرَابِهْ",28,"ب",2,0],["في زَمانٍ مَنْ كَانَ يُمْسكُ فِيه","قَلَماً عُدَّ أَكْتَب الكُتَّاب",29,"ب",1,0],["في زمان أَلِفَ الذُّلَّ؛ فمَنْ","رفع الهامةَ فيه، جَوَّعَه",30,"ع",2,0],["فيزدادُ في الإحسان مَن كان مُحْسِنًا","ويُقْلِعُ عن سُوءِ الصنيع مُسِيء",31,"ي",2,0],["في زَمَانٍ كأنّ نَرْجِسَهُ الغَضّ","سُمُوطٌ منْ لُؤلُؤٍ وَفَرِيدِ",32,"د",1,0],["فيزيدها درُّ السّماحِ تخرّقاً","خالَستُه نَظَراً وكانَ مُوَرَّداً",33,"د",2,0],["في زمانٍ من المعيشة ِ لذٍّ،","قد مضى عصره، وهذا زمانُ",34,"ن",1,0],["في زمانٍ يقظ الآ","لام موفور الأذاة",35,"ه",1,0],["في زمان ليس للحق به","أي صوت إن أسف الدهر يلحو",36,"ح",2,0],["في زمانِ الإمام سيف بن سلطا","ن سيف مُعْطِى القلوب مُنَاهَا",37,"ا",3,0],["فيزداد شوقي كلما زدت قربة","ويزداد وجدي كلما زدت عرفانا",38,"ن",2,0],["في زَمانٍ لا تَسمَعُ الأُذنُ فيهِ","غَير صَوتِ الصُراخِ في كُلِّ نادِ",39,"د",1,0],["في زمانِ الأفْضلِ المُحيْى الوَرَى","سِيّما فيه فنونُ الأدب",40,"ب",1,0],["فيزيد وجهك حين أبصره","نور الشموس بمقلتي سطعا",41,"ع",2,0],["فِي زَمانٍ بِهِ الرَّئِيسُ وَجِيهُ ال","دَّوْلَةِ الأَوْحَدُ الأَجَلُّ الأَعَزُّ",42,"ز",1,0],["فِي زَمانٍ مِنَ الشَّبِيبَةِ مَصْقُو","لٍ وَعَيْشٍ مِنَ الْبَطالَةِ رَغْدِ",43,"د",1,0],["في زَمَنٍ رِياضُهُ تَختالُ في ال","ديباجِ وَالسُندُسِ عَبقَرِيّا",44,"ي",2,0],["في زِقاقٍ كُلُّ جَحلَي","نِ أَضَرّا بِبَعيرِ",45,"ر",1,0],["فيزيدان جمال","الشط والأمواج سحرا",46,"ر",2,0],["في زَمَنٍ أصْْبَحَ مَعكوسً","مَفهومُ العَدْلِ ومَقلوبا",47,"ب",2,0],["في زمانٍ لم يُبْقِ في قَرْضِ شعْرٍ","طائلاً من غنىً ولا مِن غَناء",48,"ا",2,0],["في زَمنٍ نحنُ مالِكُوهُ","أمراً عَلى صَرفِه ونَهيا",49,"ي",2,0],["في زمانٍ صَفا ورَقَّت حَواشي","هِ فَأضحى كأنَّه إِسحاقُ",50,"ق",1,0],["في زفير مُحرَّقاً","في دموعٍ مغرَّقا",51,"ق",2,0],["في زمان مظلم كثرت شروره","رب وفق سدد واحم عن ضلال",52,"ل",1,0],["في زمانٍ تخطَّفَتْه الدَّعاوى","وشكا من وسائل المرجفينا",53,"ن",2,0],["في زمانٍ أهلُه زِعنَفَةٌ","هَمَلٌ مَلبوسهُم عابٌ وذامُ",54,"م",1,0],["في زُمرة الشّهدَاءِ يُح","شَرُ في غَدٍ إن مَاتَ عِشْقا",55,"ق",2,0],["في زَرودٍ وقفة أَذكرُها","فسقى الله حيا المزن زرودا",56,"د",2,0],["في زمانٍ أصْبَحَ الجودُ به","والمعالي أثَراً بعدَ عيان",57,"ن",1,0],["فيزهو لدى الأَبصار لطف سماته","يفوق الفتى أقرانه في هباته",58,"ه",1,0],["في زمانٍ مذنبٍ لم يعتذر","بكريم لبني الفضل اعتذارا",59,"ر",2,0],["في زهرةٍ من وفاءِ العهدِ فاحَ بِهَا","غمامُ أَنعُمِكُمْ فِي روضِ مَحْتِدِهِ",60,"د",2,0],["في زمان الربيع يوماً بأذكى","منه نَشْراً تضوع منه القفار",61,"ر",1,0],["في زمانِ لذَّ عيشاً وصَفا","نَعِمَتْ آصالُه والبُكَرُ",62,"ر",1,0],["في زمانِ الربيعِ يوماً بأزهى","منهما روْنَقاً وأبهى جمالا",63,"ل",2,0],["في زمن يرشُقني كيدُه","ليس له غيريَ من مَرشَقِ",64,"ق",1,0],["في زمانٍ إذا الرجالُ سخَوا في","ه فما فرطُ نَيْلهم تبذيرُ",65,"ر",1,0],["في زُمْرةٍ قطعوا الأحِبَّة عَنْوةً","وحَدا ببَيْنهمُ القَضاءُ المُبْرمُ",66,"م",1,0],["في زمنٍ سائر أوقاتِهِ","في الطيبِ والحُسنِ كأيّارِ",67,"ر",1,0],["فيزيدُ وجداً كلَّ قلبٍ ذاهلٍ","اِنشادُهنَّ وكلَّ لبًّ طائحِ",68,"ح",1,0],["فيزْكو بإذْنِ اللهِ في الخلقِ خُلقُهُ","ويَلوي عن الدُّنيا كما لَيَّةِ البَرْقِ",69,"ق",1,0],["فَيَزورُ أنفي رَغمَ أنفِي جاعِلاً","مِنهُ لِزَورَتِهِ حَصينَ مَكانِ",70,"ن",1,0],["في زَمانٍ يُنسِي زمانَ التّصابِي","وَنَعيمٍ يُسلِي نعيمَ الشّبابِ",71,"ب",1,0],["فِي زُمْرَةٍ خَيرِ زُمَرْ","مِنْ نَفَرِ أيِّ نَفَرْ",72,"ر",1,0],["في زجرِ فالٍ بان صادقُ وعده","وطلوع سعد لاح ضوء شِهابِهِ",73,"ب",2,0],["في زمن أو قام منهم ألف","أو وثبوا كلهم فاصطفوا",74,"ف",3,0]]}