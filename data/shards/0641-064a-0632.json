للاصلاح عنوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55134&r=&rc=1",""],[6223,"حثالة الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1211&r=&rc=6",""],[6243,"مُوَشَّح خليجيّ ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84443&r=&rc=17",""],[463,"لمنْ الظَّعنُ تهتدي وتجورُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60080&r=&rc=136",""],[6325,"صورة أخرى للحرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88018&r=&rc=0",""],[4890,"مرآة لمعاوية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74531&r=&rc=285",""]],"verses":[["في زُمرَةٍ مِن رِفاقٍ","غُرِّ الشَمائِلِ شوسِ",0,"س",1,0],["فَيَزولُ عَنكَ جَميعُ ما أوتيتَ في ال","دُنيا وَلَو زُوِيَت لَكَ الأَمصارُ",1,"ر",1,0],["فَيَزيدُهُ طولُ التَذَلُّلِ عِزَّةً","أَبَداً وَفرطُ الإِعتِذارِ تَعَتُّبا",2,"ب",2,0],["فِي زَمَانٍ بِهِ غَدَتْ","رَوْضَ أَمْنٍ أَغَنَّ رَيَّانَا",3,"ن",2,0],["فِي زَحْلَةٍ مَوْلِدِي بِالرُّوحِ لا البَدَنِ","وَ زَحْلَةٌ بِرِضَى مِنْ أَهْلِهَا وَطَنِي",4,"ن",2,1],["فِي زَحْلَةٍ لِيَ عَهْدٌ مِنْ صِبًى وَهَوًى","فِي زَحْلَةٍ أُسْرَتِي فِي زَحْلَةٍ سَكَنِي",4,"ن",2,0],["فيزعجنا بالخاز باز طنينها","وتقذف أوساخاً علينا فروعها",5,"ع",3,0],["في زخرفِ القول ترجيحٌ لقائلهِ","والحقُّ قد يعتريه بعضُ تغييرِ",6,"ر",1,1],["في زمن الغيث الذي لم يزل","يحكيك في الجود ولم أعكس",7,"س",1,0],["في زَورَقٍ بَينَ الزَوا","رِقِ كَالحَمامَةِ في الطُيورِ",8,"ر",1,0],["في زهرتَي ذا العود من","أهل الهوى جُمعت صفات",9,"ت",1,1],["في زَمانٍ غَبِيَ النا","صِحُ فيهِ أَو تَغابى",10,"ب",2,0],["في زرعي وحامي دونه","كالليث قام محامياً عن شِبلهِ",11,"ل",2,0],["في زَمانٍ كَأَنَّ نَرجِسَهُ الغَض","ضَ سُموطٌ مِن لُؤلُؤٍ وَفَريدِ",12,"د",1,0],["في زُهاهُ أَبو سَعيدٍ عَلى آ","ثارِ خَيلٍ قَد صَبَّحَتهُ بِثارِ",13,"ر",1,0],["في زَمَنٍ رَنَّقَت حَوادِثُهُ","أَشبَهُ شَيءٍ بِحادِثٍ زَمَنُه",14,"ن",2,0],["في زاهرٍ عَبقٍ تَضوُّعُه","فكأنّ عطّاراً يُعَطِّرُه",15,"ر",2,0],["في زاخرٍ من بحورِ الروم عادتُهُ","ألا يزال مشوباً منهمُ بدمِ",16,"م",1,0],["في زَمانٍ مِنَ المَعيشَةِ لَخٍّ","قَد مَضى عَصرُهُ وَهَذا زَمانُ",17,"ن",1,0],["في زَمانٍ لَو كُنتِ فيهِ ضَجيعي","غَيرَ شَكٍّ عَرَفتِ لي عِصياني",18,"ن",2,0],["في زاهِرٍ مِثل النُجُومِ أَمالَهُ","ظَلَمٌ فَتَمَّ وَلَم يَهِج إِعشابُهُ",19,"ب",2,0],["فيَزيدُها دَرُّ السّماحِ تخرّقاً","ويَزيدُها بَسْطُ البنانِ ترحُّبا",20,"ب",2,0],["في زجاج مُحلِّقٍ","لا دخانٌ ولا شرَرْ",21,"ر",1,0],["في زَمَانٍ قَدْ كَانَ لِلظُّلْمِ فِيهِ","أَثَرُ النَّارِ فِي هَشِيمِ الْقَتَادِ",22,"د",1,0],["فِي زهْرةِ العُمْرِ فتىً نابِهٌ","أَصْمَاهُ سهْمٌ لِلردى طاشَا",23,"ش",2,1],["فِي زِينَةٍ نَظَمَ الوَفَاءُ جَمَالَهَا","وَمُرَادُهُ مِنْهَا أَجلُّ مُرَاد",24,"د",1,0],["فِي زُهْرِهَا الغَرَّارِ لِلْسَّارِي","وَفِي الوَرْدِ السَّرَابْ",25,"ب",1,0],["فِي زِينَة لَسْتَ تَدْرِي","زَرْقَاءَ أَوْ خَضْرَاءَ",26,"ا",2,0],["في زمانٍ قد ذلَّ كلُّ إباءٍ","فيه وانقاد كلُّ صعبِ الْحِران",27,"ن",1,0],["فِي زَمَانٍ كَانَ الْقَديِمُ بِهِ قُدْ","ساً يُذَادُ الْجَدِيدُ عَنْ مِحْرَابِهْ",28,"ب",2,0],["في زَمانٍ مَنْ كَانَ يُمْسكُ فِيه","قَلَماً عُدَّ أَكْتَب الكُتَّاب",29,"ب",1,0],["في زمان أَلِفَ الذُّلَّ؛ فمَنْ","رفع الهامةَ فيه، جَوَّعَه",30,"ع",2,0],["فيزدادُ في الإحسان مَن كان مُحْسِنًا","ويُقْلِعُ عن سُوءِ الصنيع مُسِيء",31,"ي",2,0],["في زَمَانٍ كأنّ نَرْجِسَهُ الغَضّ","سُمُوطٌ منْ لُؤلُؤٍ وَفَرِيدِ",32,"د",1,0],["فيزيدها درُّ السّماحِ تخرّقاً","خالَستُه نَظَراً وكانَ مُوَرَّداً",33,"د",2,0],["في زمانٍ من المعيشة ِ لذٍّ،","قد مضى عصره، وهذا زمانُ",34,"ن",1,0],["في زمانٍ يقظ الآ","لام موفور الأذاة",35,"ه",1,0],["في زمان ليس للحق به","أي صوت إن أسف الدهر يلحو",36,"ح",2,0],["في زمانِ الإمام سيف بن سلطا","ن سيف مُعْطِى القلوب مُنَاهَا",37,"ا",3,0],["فيزداد شوقي كلما زدت قربة","ويزداد وجدي كلما زدت عرفانا",38,"ن",2,0],["في زَمانٍ لا تَسمَعُ الأُذنُ فيهِ","غَير صَوتِ الصُراخِ في كُلِّ نادِ",39,"د",1,0],["في زمانِ الأفْضلِ المُحيْى الوَرَى","سِيّما فيه فنونُ الأدب",40,"ب",1,0],["فيزيد وجهك حين أبصره","نور الشموس بمقلتي سطعا",41,"ع",2,0],["فِي زَمانٍ بِهِ الرَّئِيسُ وَجِيهُ ال","دَّوْلَةِ الأَوْحَدُ الأَجَلُّ الأَعَزُّ",42,"ز",1,0],["فِي زَمانٍ مِنَ الشَّبِيبَةِ مَصْقُو","لٍ وَعَيْشٍ مِنَ الْبَطالَةِ رَغْدِ",43,"د",1,0],["في زَمَنٍ رِياضُهُ تَختالُ في ال","ديباجِ وَالسُندُسِ عَبقَرِيّا",44,"ي",2,0],["في زِقاقٍ كُلُّ جَحلَي","نِ أَضَرّا بِبَعيرِ",45,"ر",1,0],["فيزيدان جمال","الشط والأمواج سحرا",46,"ر",2,0],["في زَمَنٍ أصْْبَحَ مَعكوسً","مَفهومُ العَدْلِ ومَقلوبا",47,"ب",2,0],["في زمانٍ لم يُبْقِ في قَرْضِ شعْرٍ","طائلاً من غنىً ولا مِن غَناء",48,"ا",2,0],["في زَمنٍ نحنُ مالِكُوهُ","أمراً عَلى صَرفِه ونَهيا",49,"ي",2,0],["في زمانٍ صَفا ورَقَّت حَواشي","هِ فَأضحى كأنَّه إِسحاقُ",50,"ق",1,0],["في زفير مُحرَّقاً","في دموعٍ مغرَّقا",51,"ق",2,0],["في زمان مظلم كثرت شروره","رب وفق سدد واحم عن ضلال",52,"ل",1,0],["في زمانٍ تخطَّفَتْه الدَّعاوى","وشكا من وسائل المرجفينا",53,"ن",2,0],["في زمانٍ أهلُه زِعنَفَةٌ","هَمَلٌ مَلبوسهُم عابٌ وذامُ",54,"م",1,0],["في زُمرة الشّهدَاءِ يُح","شَرُ في غَدٍ إن مَاتَ عِشْقا",55,"ق",2,0],["في زَرودٍ وقفة أَذكرُها","فسقى الله حيا المزن زرودا",56,"د",2,0],["في زمانٍ أصْبَحَ الجودُ به","والمعالي أثَراً بعدَ عيان",57,"ن",1,0],["فيزهو لدى الأَبصار لطف سماته","يفوق الفتى أقرانه في هباته",58,"ه",1,0],["في زمانٍ مذنبٍ لم يعتذر","بكريم لبني الفضل اعتذارا",59,"ر",2,0],["في زهرةٍ من وفاءِ العهدِ فاحَ بِهَا","غمامُ أَنعُمِكُمْ فِي روضِ مَحْتِدِهِ",60,"د",2,0],["في زمان الربيع يوماً بأذكى","منه نَشْراً تضوع منه القفار",61,"ر",1,0],["في زمانِ لذَّ عيشاً وصَفا","نَعِمَتْ آصالُه والبُكَرُ",62,"ر",1,0],["في زمانِ الربيعِ يوماً بأزهى","منهما روْنَقاً وأبهى جمالا",63,"ل",2,0],["في زمن يرشُقني كيدُه","ليس له غيريَ من مَرشَقِ",64,"ق",1,0],["في زمانٍ إذا الرجالُ سخَوا في","ه فما فرطُ نَيْلهم تبذيرُ",65,"ر",1,0],["في زُمْرةٍ قطعوا الأحِبَّة عَنْوةً","وحَدا ببَيْنهمُ القَضاءُ المُبْرمُ",66,"م",1,0],["في زمنٍ سائر أوقاتِهِ","في الطيبِ والحُسنِ كأيّارِ",67,"ر",1,0],["فيزيدُ وجداً كلَّ قلبٍ ذاهلٍ","اِنشادُهنَّ وكلَّ لبًّ طائحِ",68,"ح",1,0],["فيزْكو بإذْنِ اللهِ في الخلقِ خُلقُهُ","ويَلوي عن الدُّنيا كما لَيَّةِ البَرْقِ",69,"ق",1,0],["فَيَزورُ أنفي رَغمَ أنفِي جاعِلاً","مِنهُ لِزَورَتِهِ حَصينَ مَكانِ",70,"ن",1,0],["في زَمانٍ يُنسِي 