{"poems":[[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"عطون بأعناق الظباء وأشرقت","https://www.aldiwan.net/poem29798.html","الطويل"],[53,"ثورتها تنتعل الظلاما","https://www.aldiwan.net/poem29812.html","الرجز"],[53,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[100,"يقظة الصحراء","https://www.aldiwan.net/poem23696.html","عموديه"],[57,"أمطري لؤلؤا جبال سرندي","https://www.aldiwan.net/poem24697.html","الخفيف"],[77,"ما لليراع خواضع الأعناق","https://www.aldiwan.net/poem35907.html","الكامل"],[77,"أمط عنك مهما اسطعت كل إرادة","https://www.aldiwan.net/poem36529.html","الطويل"],[10,"بكت عيني وعاودها قذاها","https://www.aldiwan.net/poem21140.html","الوافر"],[54,"أمطلب أنت مستعذب","https://www.aldiwan.net/poem27510.html","المتقارب"],[54,"أمطلب دع دعاوى الكماة","https://www.aldiwan.net/poem27635.html","المتقارب"],[72,"أمط بالدواء ثياب الأذى","https://www.aldiwan.net/poem20530.html","المتقارب"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[51,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[51,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[51,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[78,"أمطلع زهر نجوم الكلام","https://www.aldiwan.net/poem14187.html","المتقارب"],[85,"إنما البنت وإن ضاقوا بها","https://www.aldiwan.net/poem7806.html","الرمل"],[43,"أرق على أرق ومثلي يأرق","https://www.aldiwan.net/poem9735.html","الكامل"],[43,"محبي قيامي ما لذلكم النصل","https://www.aldiwan.net/poem9982.html","الطويل"],[45,"لك الخلائق فينا السهلة السمح","https://www.aldiwan.net/poem62686.html","البسيط"],[45,"إستقبلا الركب في أطلالهم وقفا","https://www.aldiwan.net/poem65170.html","البسيط"],[80,"أمطتك همتك الغريمة فاركب","https://www.aldiwan.net/poem31243.html","الكامل"],[44,"أصغى إلى البين مغترا فلا جرما","https://www.aldiwan.net/poem30366.html","البسيط"],[44,"يا برق طالع منزلا بالأبرق","https://www.aldiwan.net/poem30397.html","الكامل"],[44,"يقول في قومس صحبي وقد أخذت","https://www.aldiwan.net/poem30534.html","الكامل"],[46,"مضى زماني وتقضى المدى","https://www.aldiwan.net/poem23552.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85570","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140804",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42608","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[106,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179448",""],[54,"أمطلبُ دعْ دعاوى الكماة ِ","https://www.poetsgate.com/ViewPoem.aspx?id=13985",""],[80,"أمْطَتكَ همّتك العزيمة فاركبِ","https://www.poetsgate.com/ViewPoem.aspx?id=3720",""]],"verses":[["أَمُطَّلِعٌ يَومي عَليَّ وَلَم أَخُض","دِماءَ الأَعادي بِالوَشيجِ المُقَوَّمِ",0,"م",1,0],["أَمَطنَ سُجوفاً عَن خُدودٍ نَقِيَّةٍ","صَفا بَشَرٌ مِنها وَرَقَّ أَديمُ",1,"م",1,0],["أَمطَونِيَ الغارِبَ وَالسَناما","وَطالَ ما غاظوا بِيَ الأَقواما",2,"م",2,0],["أَمطَروا الجودَ مُضيئاً بِشرُهُم","فَرَأَيناهُم شُموساً وَغَماما",3,"م",2,0],["أمطر الغربُ على الشرق الشقا","وبدعوى السلم أسقاه الحماما",4,"م",2,0],["أَمطِري لُؤلُؤاً جِبالَ سَرَندي","بَ وَفيضي آبارُ تَكرورَ تِبرا",5,"ر",2,1],["أمُطَيَّباً بمَحامِدِ العَمَلِ الرِّضا","ومُكَفّناً بمَكارِمِ الأخْلاقِ",6,"ق",1,0],["أمِطْ عنْكَ مهْما اسْطَعْتَ كلَّ إرادَةٍ","وإلاّ فمعْنى القوم عنْكَ بَعيدُ",7,"د",1,1],["أَمُطعِمَكُم وَحامِلَكُم تَرَكتُم","لَدى غَبراءَ مُنهَدِمٍ رَجاها",8,"ا",3,0],["أَمُطَّلِبٌ أَنتَ مُستَعذِبٌ","حُماتِ الأَفاعي وَمُستَقتِلُ",9,"ل",1,1],["أَمُطَّلِبٌ دَع دَعاوى الكُماةِ","فَتِلكَ نَحيزَةُ لا رُتبَه",10,"ب",2,1],["أمطْ بالدَّواء ثياب الأذى","وطبْ في الرواح به والغدوّ",11,"و",1,1],["أمطِرْ نداك جنابي يكسُه زهراً","أنت المُحَيَّا بريَّاه إذا نفحا",12,"ح",2,0],["أمطيتَني البِشرَ حُملاناً وأقفرني","قومٌ وكم بين حملان وإقفار",13,"ر",1,0],["أُمطِر مستمطري الصواعقَ وال","غيثَ شآبيبَ غير طشّاش",14,"ش",1,0],["أمطاكه جزلٌ مواهبه","كلِفٌ بربّ العرف يصنعه",15,"ع",2,0],["أَمَطلَعُ زُهر نُجوم الكَلام","وَمشرِقَهُ مِن خِلال الحلَكْ",16,"ك",1,1],["أمطرى مصر وشرق الأرض من","ولد الأمجاد أملاكا وساده",17,"د",2,0],["أَمطِر عَلَيَّ سَحابَ جودِكَ ثَرَّةً","وَاِنظُر إِلَيَّ بِرَحمَةٍ لا أَغرَقُ",18,"ق",1,0],["أَمِط عَنكَ تَشبيهي بِما وَكَأَنَّهُ","فَما أَحَدٌ فَوقي وَلا أَحَدٌ مِثلي",19,"ي",1,0],["أَمُطلِقي مِن يَدِ السَيبِيِّ أَنتَ فَقَد","كَلَّت لَدَيهِ رِكابُ الطالِبِ الطُلُحُ",20,"ح",1,0],["أَمطَرتَ أَرؤُسَهُم ضَرباً تَرَكتَ بِهِ","مَأثورَةَ السُمرِ مُنآداً وَمُنقَصِفا",21,"ف",2,0],["أمْطَتْكَ همّتُك الغريمةَ فاركبِ","لا تُلقِيَنّ عصاكَ دون المَطلبِ",22,"ب",1,1],["أَمطَرتَهُم عَزَماتٍ لَو رَمَيتَ بِها","يَومَ الكَريهَةِ رُكنَ الدَهر لَاِنهَدَما",23,"م",2,0],["أَمطاكَهُ الحَسَنُ بنُ وَهبٍ إِنَّهُ","داني ثَرى اليَدِ مِن رَجاءِ المُملِقِ",24,"ق",1,0],["أَمَطلَعَ الشَمسِ تَنوي أَن تَؤُمَّ بِنا","فَقُلتُ كَلّا وَلَكِن مَطلِعَ الجودِ",25,"د",1,0],["أَمطَرَنا اللَهُ بِإِحسانِهِ","لا أَنسُبُ الغَيثَ إِلى المِرزَمَين",26,"ن",1,0],["أَمطرتنا من بعد محل طويل","ديمة كان ماؤُها ثجّاجا",27,"ج",2,0],["أمط عنك تشبيهي بما وكأنه","فما أحدٌ فوقي ولا",28,"ل",2,0],["أم طِرْتَ في جوِّ الحَلِي","فَةِ مُنجداً أبطالِ كنْتْ",29,"ت",1,0],["أم طالعتكِ من السِّحر القديم رؤىً","يشدو بهنَّ الثرى والريحُ والماءُ",30,"ا",2,0],["أَمُطَاعِنَ الْفُرْسَانِ فِي حَمَسِ الْوَغَى","أَقْصِرْ فَرُمْحُكَ عَنْ غَريمِكَ أَقْصَرُ",31,"ر",1,0],["أَمطَروني مَطرَ السو","ءِ وَقالوا نَحنُ أَنوا",32,"و",2,0],["أم طريقًا إلى الفناء قصيرًا","قد ركبنا لطيِّه الأياما؟",33,"م",2,0],["أمطلبُ دعْ دعاوى الكماة","ِ فَتلكَ نَحِيزقٌ لا رُتبَهْ",34,"ب",2,1],["أمْطَتكَ همّتك العزيمة فاركبِ","لا تُلقينّ عصاكَ دونَ المَطلبِ",35,"ب",1,1]]}