ww.poetsgate.com/ViewPoem.aspx?id=199803",""],[5431,"أمطريني ماء طهركْ","https://www.poetsgate.com/ViewPoem.aspx?id=183436",""],[5431,"ليرتل الإشراق ترتيلا","https://www.poetsgate.com/ViewPoem.aspx?id=214920",""],[5582,"أَمُوسِعَةً بِمُهْجَتِيَ الصُّدُوعا","https://www.poetsgate.com/ViewPoem.aspx?id=187177",""],[5582,"أَنَوارُ هَلْ مِنْ زَوْرَةٍ أَنَوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63507",""],[5644,"هل تراني سوف ألقى بغيتي","https://www.poetsgate.com/ViewPoem.aspx?id=211268",""],[5644,"أي شأن من شؤونك","https://www.poetsgate.com/ViewPoem.aspx?id=211271",""],[5671,"ضل الطريق وضلت العفر","https://www.poetsgate.com/ViewPoem.aspx?id=169350",""],[5704,"رُجُوع","https://www.poetsgate.com/ViewPoem.aspx?id=191319",""],[5725,"لاالقوم قومي","https://www.poetsgate.com/ViewPoem.aspx?id=177420",""],[5725,"أي حسن","https://www.poetsgate.com/ViewPoem.aspx?id=210212",""],[5725,"آه يا بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=215377",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5736,"قصيدة لم تكتمل","https://www.poetsgate.com/ViewPoem.aspx?id=203164",""],[5739,"زوايا الحبر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126878",""],[5908,"بنا من بنات الماء للكوفة الغرا","https://www.poetsgate.com/ViewPoem.aspx?id=170972",""],[5956,"سارقُ الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=183309",""],[6031,"تَوَشَّحَتِ السَّمَاءُ بِبُرْدِ غَيْمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=46337",""],[6056,"كفيّ ، طوّ قت معصمه","https://www.poetsgate.com/ViewPoem.aspx?id=130137",""],[6152,"أمطريني بحنانكِ","https://www.poetsgate.com/ViewPoem.aspx?id=203400",""],[6212,"مُكَاشَفَاتٌ أَخِيْرَةٌ في مَهَبِّ اللَّيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1623&r=&rc=4",""],[406,"كاترينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66905&r=&rc=11",""],[406,"أين بغداد عنا ؟!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=925&r=&rc=55",""],[6328,"آمنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84422&r=&rc=20",""],[6341,"تجربة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87271&r=&rc=0",""],[5396,"المسافر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65510&r=&rc=9",""]],"verses":[["أَمُطَّلِعٌ يَومي عَليَّ وَلَم أَخُض","دِماءَ الأَعادي بِالوَشيجِ المُقَوَّمِ",0,"م",1,0],["أَمَطنَ سُجوفاً عَن خُدودٍ نَقِيَّةٍ","صَفا بَشَرٌ مِنها وَرَقَّ أَديمُ",1,"م",1,0],["أَمطَونِيَ الغارِبَ وَالسَناما","وَطالَ ما غاظوا بِيَ الأَقواما",2,"م",2,0],["أَمطَروا الجودَ مُضيئاً بِشرُهُم","فَرَأَيناهُم شُموساً وَغَماما",3,"م",2,0],["أمطر الغربُ على الشرق الشقا","وبدعوى السلم أسقاه الحماما",4,"م",2,0],["أَمطِري لُؤلُؤاً جِبالَ سَرَندي","بَ وَفيضي آبارُ تَكرورَ تِبرا",5,"ر",2,1],["أمُطَيَّباً بمَحامِدِ العَمَلِ الرِّضا","ومُكَفّناً بمَكارِمِ الأخْلاقِ",6,"ق",1,0],["أمِطْ عنْكَ مهْما اسْطَعْتَ كلَّ إرادَةٍ","وإلاّ فمعْنى القوم عنْكَ بَعيدُ",7,"د",1,1],["أَمُطعِمَكُم وَحامِلَكُم تَرَكتُم","لَدى غَبراءَ مُنهَدِمٍ رَجاها",8,"ا",3,0],["أَمُطَّلِبٌ أَنتَ مُستَعذِبٌ","حُماتِ الأَفاعي وَمُستَقتِلُ",9,"ل",1,1],["أَمُطَّلِبٌ دَع دَعاوى الكُماةِ","فَتِلكَ نَحيزَةُ لا رُتبَه",10,"ب",2,1],["أمطْ بالدَّواء ثياب الأذى","وطبْ في الرواح به والغدوّ",11,"و",1,1],["أمطِرْ نداك جنابي يكسُه زهراً","أنت المُحَيَّا بريَّاه إذا نفحا",12,"ح",2,0],["أمطيتَني البِشرَ حُملاناً وأقفرني","قومٌ وكم بين حملان وإقفار",13,"ر",1,0],["أُمطِر مستمطري الصواعقَ وال","غيثَ شآبيبَ غير طشّاش",14,"ش",1,0],["أمطاكه جزلٌ مواهبه","كلِفٌ بربّ العرف يصنعه",15,"ع",2,0],["أَمَطلَعُ زُهر نُجوم الكَلام","وَمشرِقَهُ مِن خِلال الحلَكْ",16,"ك",1,1],["أمطرى مصر وشرق الأرض من","ولد الأمجاد أملاكا وساده",17,"د",2,0],["أَمطِر عَلَيَّ سَحابَ جودِكَ ثَرَّةً","وَاِنظُر إِلَيَّ بِرَحمَةٍ لا أَغرَقُ",18,"ق",1,0],["أَمِط عَنكَ تَشبيهي بِما وَكَأَنَّهُ","فَما أَحَدٌ فَوقي وَلا أَحَدٌ مِثلي",19,"ل",2,0],["أَمُطلِقي مِن يَدِ السَيبِيِّ أَنتَ فَقَد","كَلَّت لَدَيهِ رِكابُ الطالِبِ الطُلُحُ",20,"ح",1,0],["أَمطَرتَ أَرؤُسَهُم ضَرباً تَرَكتَ بِهِ","مَأثورَةَ السُمرِ مُنآداً وَمُنقَصِفا",21,"ف",2,0],["أمْطَتْكَ همّتُك الغريمةَ فاركبِ","لا تُلقِيَنّ عصاكَ دون المَطلبِ",22,"ب",1,1],["أَمطَرتَهُم عَزَماتٍ لَو رَمَيتَ بِها","يَومَ الكَريهَةِ رُكنَ الدَهر لَاِنهَدَما",23,"م",2,0],["أَمطاكَهُ الحَسَنُ بنُ وَهبٍ إِنَّهُ","داني ثَرى اليَدِ مِن رَجاءِ المُملِقِ",24,"ق",1,0],["أَمَطلَعَ الشَمسِ تَنوي أَن تَؤُمَّ بِنا","فَقُلتُ كَلّا وَلَكِن مَطلِعَ الجودِ",25,"د",1,0],["أَمطَرَنا اللَهُ بِإِحسانِهِ","لا أَنسُبُ الغَيثَ إِلى المِرزَمَين",26,"ن",1,0],["أَمطرتنا من بعد محل طويل","ديمة كان ماؤُها ثجّاجا",27,"ج",2,0],["أمط عنك تشبيهي بما وكأنه","فما أحدٌ فوقي ولا",28,"ل",2,0],["أم طِرْتَ في جوِّ الحَلِي","فَةِ مُنجداً أبطالِ كنْتْ",29,"ت",1,0],["أم طالعتكِ من السِّحر القديم رؤىً","يشدو بهنَّ الثرى والريحُ والماءُ",30,"ا",2,0],["أَمُطَاعِنَ الْفُرْسَانِ فِي حَمَسِ الْوَغَى","أَقْصِرْ فَرُمْحُكَ عَنْ غَريمِكَ أَقْصَرُ",31,"ر",1,0],["أَمطَروني مَطرَ السو","ءِ وَقالوا نَحنُ أَنوا",32,"و",2,0],["أم طريقًا إلى الفناء قصيرًا","قد ركبنا لطيِّه الأياما؟",33,"م",2,0],["أمطلبُ دعْ دعاوى الكماة","ِ فَتلكَ نَحِيزقٌ لا رُتبَهْ",34,"ب",2,1],["أمْطَتكَ همّتك العزيمة فاركبِ","لا تُلقينّ عصاكَ دونَ المَطلبِ",35,"ب",1,1],["أمطري حيث شئت فالكون ملكي","وبنوه قبائلي وجنودي",36,"د",2,0],["أمطروا الدمع عليه لا الندى","وانثروا الشعر عليه لا الزهور",37,"ر",1,1],["أمطرْ علىَّ سحائبا من فضةٍ","من أنمل مثلَ البحارِ هَوَامِي",38,"م",2,0],["أم طَافَ طَيفُ مَيَّةٍ طَارِقاً","أهلاً بِه من طَارِقٍ طائف",39,"ف",1,0],["أَمُطعِمُ لَم أَخذُلكَ في يَومِ نَجدَةٍ","ولا عِندَ تِلكَ المُعظماتِ الجَلائِلِ",40,"ل",1,0],["أَمُطعِمُ إِنَّ القَومَ ساموكَ خُطَّةً","وَإِنّي مَتى أُوكَل فَلَستُ بِوائِلِ",40,"ل",1,0],["أَمطَيتَني ظَهرَ السِماكِ بِرُتبَةٍ","سُقِيَت عِدايَ بِها سِماماً مُنقَعا",41,"ع",2,0],["أَمطاكَهُ الموفي عَلى آبائِهِ","وَرَعاً وَكَم عَلَتِ الفُروعُ أُصولا",42,"ل",2,0],["أَمطارُهُنَّ دَمُ العِدى وَبُروقُها","لَمعُ الصَوارِمِ وَالرُعودُ صَليلُ",43,"ل",1,0],["أمِط عن محياه الحجاب فلو رأى","ذوو الرشد منهم ما رأيتُ لهاموا",44,"م",3,0],["امطر عليها الخيل تمطر ثرة","وابرق عليها بالسيوف وارعد",45,"د",1,0],["أَمطَرنَني بِها يَمينُ فَتىً","أَروَعَ لا كَزَّةٌ وَلا شَهجاءُ",46,"ا",2,0],["أمطرى يا سماء في كل أر","أوقدي يا سماء نور الشموع",47,"ع",1,0],["أَمطِري يا سَماءُ في كلِّ يومٍ","ما تَشاءُ الأَقدارُ من نُظّارِ",48,"ر",1,1],["أَمطِري يا سحائِبَ الفَضلِ ما شِئ","تِ وَفيضي على الرُبا وَالوِهادِ",49,"د",1,1],["أَمَطْنَ دِمَقْسِيَّ المُلاَ عَنْ روادفٍ","رِوَاءٍ ولكنّ الخصور صوادي",50,"د",2,0],["أَمِطِ اللِثامَ عَنِ العِذارِ السائِلِ","لِيَقومَ عُذري فيكَ عِندَ عَواذِلي",51,"ل",2,1],["أَمِطْ عَنَّا أَذَى الدُّنْيَا وَأَهْدِي","لَنَا مِمَّا نُؤَمِّلُ مِنْكَ بُدْنَا",52,"ن",2,0],["أَمِطْ يَا عَيْنَ بَهْجَتِهَا قَذَاهَا","وَحُطْ يَا شَوْقَ مَغْرِبِهَا سَنَاهَا",53,"ا",3,0],["أمطت قناع النفس عن شهواتها","ذر الحمقا فالحمقاء بالدر تقنع",54,"ع",1,0],["أمطعمك عبء الحب ما اسطعت فالهوي","كوى عبئه قلباً هوى بالكواعب",55,"ب",1,0],["أَمْطَرْتَها مِنْ فَيْضِ عَدْلِكَ أَنْعُماً","لا تُعْدِمُ الرُّوّادَ رَوْضاً مُونِقا",56,"ق",2,0],["أَمِط عَنكَ السِلاحَ غَنيتَ عَنهُ","وَأَنتَ الفارِسُ البَطَلُ الهُمامُ",57,"م",1,0],["أَمِط عَنّي الوَقارَ بِها فَإِنّي","أَرى خَلعَ العِذارِ عَلى العُقارِ",58,"ر",1,0],["أَمَّ طالوتُ حانَها فحبَتهُ","مُلكَ قَوم طالوا على طالوتِ",59,"ت",1,0],["أَمطرَ الظلماء نبلاً بعد ما","قد رماها مستديراً بِوَققْ",60,"ق",1,0],["أَمطارُها اللُجَينُ","وَالدُرُّ وَالعِقيانُ",61,"ن",1,0],["ام طار كالعندليب","ام هب مثل النسيم",62,"م",1,0],["أَمْطِرْ نَواحِيَنَا التى قَدْ أَجْدَبَتْ","وَنَدا يَدَيْكَ بِكُلِّ قَطْرٍ صَابَا",63,"ب",2,0],["أَمُطَهَّرُ بنُ الطَّاهِرِ بنِ مَناسِب","رفعَتْ علَى قِمَمِ الكَواكَبِ مَجْدَها",64,"ه",2,1],["أَمطر الغَيث وَكَفّ كَفّيه جودا","فَظَنناه ديمَةً هطّاله",65,"ل",2,0],["أَمطَرتُها قُبلاً وَأَصبَحَ خَدُّها ال","محمَرُّ مُخضَرُّ الجَوانِبِ مُعشِبا",66,"ب",2,1],["أَمَطلَعَ شَمسِ الحُسنِ لا مَطلَعَ الفَجرِ","جَلَوتَ ظَلامَ اللَيلِ بِالكَأسِ وَالثَغرِ",67,"ر",1,1],["أمطلِّق الدُّنيا ثَلاثاً بِالنَّدى","زهداً فَلَيسَت بِالثَّلاثِ تُطلَّقُ",68,"ق",1,0],["أمطر علينا شئابيب التلاوة في","عصرٍ تشرّب إعراضاً وإنكارا",69,"ر",2,0],["أمطلتم وأنتم في غناء","إن مطل الغني في الشرع ظلم",70,"م",1,0],["أَمْطَرَت