{"poems":[[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"عطون بأعناق الظباء وأشرقت","https://www.aldiwan.net/poem29798.html","الطويل"],[53,"ثورتها تنتعل الظلاما","https://www.aldiwan.net/poem29812.html","الرجز"],[53,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[100,"يقظة الصحراء","https://www.aldiwan.net/poem23696.html","عموديه"],[57,"أمطري لؤلؤا جبال سرندي","https://www.aldiwan.net/poem24697.html","الخفيف"],[77,"ما لليراع خواضع الأعناق","https://www.aldiwan.net/poem35907.html","الكامل"],[77,"أمط عنك مهما اسطعت كل إرادة","https://www.aldiwan.net/poem36529.html","الطويل"],[10,"بكت عيني وعاودها قذاها","https://www.aldiwan.net/poem21140.html","الوافر"],[54,"أمطلب أنت مستعذب","https://www.aldiwan.net/poem27510.html","المتقارب"],[54,"أمطلب دع دعاوى الكماة","https://www.aldiwan.net/poem27635.html","المتقارب"],[72,"أمط بالدواء ثياب الأذى","https://www.aldiwan.net/poem20530.html","المتقارب"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[51,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[51,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[51,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[78,"أمطلع زهر نجوم الكلام","https://www.aldiwan.net/poem14187.html","المتقارب"],[85,"إنما البنت وإن ضاقوا بها","https://www.aldiwan.net/poem7806.html","الرمل"],[43,"أرق على أرق ومثلي يأرق","https://www.aldiwan.net/poem9735.html","الكامل"],[43,"محبي قيامي ما لذلكم النصل","https://www.aldiwan.net/poem9982.html","الطويل"],[45,"لك الخلائق فينا السهلة السمح","https://www.aldiwan.net/poem62686.html","البسيط"],[45,"إستقبلا الركب في أطلالهم وقفا","https://www.aldiwan.net/poem65170.html","البسيط"],[80,"أمطتك همتك الغريمة فاركب","https://www.aldiwan.net/poem31243.html","الكامل"],[44,"أصغى إلى البين مغترا فلا جرما","https://www.aldiwan.net/poem30366.html","البسيط"],[44,"يا برق طالع منزلا بالأبرق","https://www.aldiwan.net/poem30397.html","الكامل"],[44,"يقول في قومس صحبي وقد أخذت","https://www.aldiwan.net/poem30534.html","الكامل"],[46,"مضى زماني وتقضى المدى","https://www.aldiwan.net/poem23552.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85570","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140804",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42608","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[106,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179448",""],[54,"أمطلبُ دعْ دعاوى الكماة ِ","https://www.poetsgate.com/ViewPoem.aspx?id=13985",""],[80,"أمْطَتكَ همّتك العزيمة فاركبِ","https://www.poetsgate.com/ViewPoem.aspx?id=3720",""],[118,"أمطروا الدمع عليه لا الندى","https://www.aldiwan.net/poem49303.html","الرمل"],[126,"بيضاء واضحة الترائب غادة","https://www.aldiwan.net/poem50502.html","الكامل"],[130,"ما بال هذا المدمع الذارف","https://www.aldiwan.net/poem54792.html","السريع"],[132,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[141,"قسما بسؤددك الذي لا يدعى","https://www.aldiwan.net/poem11776.html","الكامل"],[141,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[141,"هل غير ظلك للعفاة مقيل","https://www.aldiwan.net/poem11791.html","الكامل"],[158,"لنا بهواه حرمة وذمام","https://www.aldiwan.net/poem58939.html","الطويل"],[158,"عندي لوالد أحمد ولأحمد","https://www.aldiwan.net/poem58984.html","الكامل"],[193,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[209,"منظر رائع الجمال رهيب","https://www.aldiwan.net/poem46588.html","الخفيف"],[223,"أمطري يا سماء في كل يوم","https://www.aldiwan.net/poem55180.html","الخفيف"],[223,"أمطري يا سحائب الفضل ما شئ","https://www.aldiwan.net/poem55202.html","الخفيف"],[227,"ولما أثاروا البزل وهنا وأشأموا","https://www.aldiwan.net/poem51125.html","الطويل"],[233,"أمط اللثام عن العذار السائل","https://www.aldiwan.net/poem31792.html","الكامل"],[235,"إلى الخياط عبد الله جئنا","https://www.aldiwan.net/poem19091.html","الوافر"],[235,"وعيشك والسماء وما بناها","https://www.aldiwan.net/poem19739.html","الوافر"],[259,"أيا غاديا والدهر يغذي بلحمه","https://www.aldiwan.net/poem38236.html","الطويل"],[259,"أمض الجوى صد القريب المجانب","https://www.aldiwan.net/poem38365.html","الطويل"],[278,"لو كنت شاهد عبرتي يوم النقا","https://www.aldiwan.net/poem60695.html","الكامل"],[280,"قوامك ثم لحظك يا غلام","https://www.aldiwan.net/poem32625.html","الوافر"],[280,"أديري في الدجى شمس العقار","https://www.aldiwan.net/poem32778.html","الوافر"],[295,"خطرت في شمائل ونعوت","https://www.aldiwan.net/poem33316.html","الخفيف"],[296,"خفق القلب له لما خفق","https://www.aldiwan.net/poem36855.html","عموديه"],[324,"لعاصم سماء","https://www.aldiwan.net/poem44238.html","منهوك المنسرح"],[340,"يا ليل اين حبيبي","https://www.aldiwan.net/poem55309.html","المجتث"],[346,"الخبز فت وزبدنا قد ذابا","https://www.aldiwan.net/poem19860.html","الكامل"],[346,"أمطهر بن الطاهر بن مناسب","https://www.aldiwan.net/poem20171.html","الكامل"],[351,"ما ترى البدر حين حاز كماله","https://www.aldiwan.net/poem40002.html","الخفيف"],[364,"أمطرتها قبلا وأصبح خدها ال","https://www.aldiwan.net/poem16936.html","الكامل"],[364,"أمطلع شمس الحسن لا مطلع الفجر","https://www.aldiwan.net/poem16981.html","الطويل"],[369,"جفن على شوك القتادة يطبق","https://www.aldiwan.net/poem57276.html","الطويل"],[397,"أنوار القرآن","https://www.aldiwan.net/poem6712.html","عموديه"],[400,"يا مليا من النظام لماذا","https://www.aldiwan.net/poem33428.html","الخفيف"],[413,"ما لها مفرية بيدا فبيدا","https://www.aldiwan.net/poem53936.html","الرمل"],[413,"دنف ذو مهجة في الحب تصدا","https://www.aldiwan.net/poem54128.html","الرمل"],[434,"حيا بكاس السرى سا في الأغاريد","https://www.aldiwan.net/poem2596.html","البسيط"],[438,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[451,"ولولي ولولي وصيحي وطيري","https://www.aldiwan.net/poem61249.html","الخفيف"],[456,"لله ساع بلغته قدمه","https://www.aldiwan.net/poem55865.html","الرجز"],[459,"تنادوا فقالوا يا لها من عجيبة","https://www.aldiwan.net/poem16416.html","الطويل"],[462,"لندى يديك ويمن رأيك","https://www.aldiwan.net/poem3314.html","عموديه"],[462,"لقد لج دمعي ليلة السفح بالسفح","https://www.aldiwan.net/poem3581.html","عموديه"],[466,"يا سهل سهلت عيشي","https://www.aldiwan.net/poem60027.html","المجتث"],[477,"سألت عليك القبر لو نطق القبر","https://www.aldiwan.net/poem37592.html","الطويل"],[493,"حديقة الجو غضي هذه الحدقا","https://www.aldiwan.net/poem10251.html","البسيط"],[493,"إن لم يكن هذا الصدود فصالا","https://www.aldiwan.net/poem10260.html","الكامل"],[512,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[512,"خلط الغرام الشجو في أمشاجه","https://www.aldiwan.net/poem20829.html","الكامل"],[549,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[551,"يقول صحبي وقد جدوا على عجل","https://www.aldiwan.net/poem68249.html","البسيط"],[573,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[584,"يا زائرا جعل الدجنة مركبا","https://www.aldiwan.net/poem17424.html","الكامل"]],"verses":[["أَمُطَّلِعٌ يَومي عَليَّ وَلَم أَخُض","دِماءَ الأَعادي بِالوَشيجِ المُقَوَّمِ",0,"م",1,0],["أَمَطنَ سُجوفاً عَن خُدودٍ نَقِيَّةٍ","صَفا بَشَرٌ مِنها وَرَقَّ أَديمُ",1,"م",1,0],["أَمطَونِيَ الغارِبَ وَالسَناما","وَطالَ ما غاظوا بِيَ الأَقواما",2,"م",2,0],["أَمطَروا الجودَ مُضيئاً بِشرُهُم","فَرَأَيناهُم شُموساً وَغَماما",3,"م",2,0],["أمطر الغربُ على الشرق الشقا","وبدعوى السلم أسقاه الحماما",4,"م",2,0],["أَمطِري لُؤلُؤاً جِبالَ سَرَندي","بَ وَفيضي آبارُ تَكرورَ تِبرا",5,"ر",2,1],["أمُطَيَّباً بمَحامِدِ العَمَلِ الرِّضا","ومُكَفّناً بمَكارِمِ الأخْلاقِ",6,"ق",1,0],["أمِطْ عنْكَ مهْما اسْطَعْتَ كلَّ إرادَةٍ","وإلاّ فمعْنى القوم عنْكَ بَعيدُ",7,"د",1,1],["أَمُطعِمَكُم وَحامِلَكُم تَرَكتُم","لَدى غَبراءَ مُنهَدِمٍ رَجاها",8,"ا",3,0],["أَمُطَّلِبٌ أَنتَ مُستَعذِبٌ","حُماتِ الأَفاعي وَمُستَقتِلُ",9,"ل",1,1],["أَمُطَّلِبٌ دَع دَعاوى الكُماةِ","فَتِلكَ نَحيزَةُ لا رُتبَه",10,"ب",2,1],["أمطْ بالدَّواء ثياب الأذى","وطبْ في الرواح به والغدوّ",11,"و",1,1],["أمطِرْ نداك جنابي يكسُه زهراً","أنت المُحَيَّا بريَّاه إذا نفحا",12,"ح",2,0],["أمطيتَني البِشرَ حُملاناً وأقفرني","قومٌ وكم بين حملان وإقفار",13,"ر",1,0],["أُمطِر مستمطري الصواعقَ وال","غيثَ شآبيبَ غير طشّاش",14,"ش",1,0],["أمطاكه جزلٌ مواهبه","كلِفٌ بربّ العرف يصنعه",15,"ع",2,0],["أَمَطلَعُ زُهر نُجوم الكَلام","وَمشرِقَهُ مِن خِلال الحلَكْ",16,"ك",1,1],["أمطرى مصر وشرق الأرض من","ولد الأمجاد أملاكا وساده",17,"د",2,0],["أَمطِر عَلَيَّ سَحابَ جودِكَ ثَرَّةً","وَاِنظُر إِلَيَّ بِرَحمَةٍ لا أَغرَقُ",18,"ق",1,0],["أَمِط عَنكَ تَشبيهي بِما وَكَأَنَّهُ","فَما أَحَدٌ فَوقي وَلا أَحَدٌ مِثلي",19,"ي",1,0],["أَمُطلِقي مِن يَدِ السَيبِيِّ أَنتَ فَقَد","كَلَّت لَدَيهِ رِكابُ الطالِبِ الطُلُحُ",20,"ح",1,0],["أَمطَرتَ أَرؤُسَهُم ضَرباً تَرَكتَ بِهِ","مَأثورَةَ السُمرِ مُنآداً وَمُنقَصِفا",21,"ف",2,0],["أمْطَتْكَ همّتُك الغريمةَ فاركبِ","لا تُلقِيَنّ عصاكَ دون المَطلبِ",22,"ب",1,1],["أَمطَرتَهُم عَزَماتٍ لَو رَمَيتَ بِها","يَومَ الكَريهَةِ رُكنَ الدَهر لَاِنهَدَما",23,"م",2,0],["أَمطاكَهُ الحَسَنُ بنُ وَهبٍ إِنَّهُ","داني ثَرى اليَدِ مِن رَجاءِ المُملِقِ",24,"ق",1,0],["أَمَطلَعَ الشَمسِ تَنوي أَن تَؤُمَّ بِنا","فَقُلتُ كَلّا وَلَكِن مَطلِعَ الجودِ",25,"د",1,0],["أَمطَرَنا اللَهُ بِإِحسانِهِ","لا أَنسُبُ الغَيثَ إِلى المِرزَمَين",26,"ن",1,0],["أَمطرتنا من بعد محل طويل","ديمة كان ماؤُها ثجّاجا",27,"ج",2,0],["أمط عنك تشبيهي بما وكأنه","فما أحدٌ فوقي ولا",28,"ل",2,0],["أم طِرْتَ في جوِّ الحَلِي","فَةِ مُنجداً أبطالِ كنْتْ",29,"ت",1,0],["أم طالعتكِ من السِّحر القديم رؤىً","يشدو بهنَّ الثرى والريحُ والماءُ",30,"ا",2,0],["أَمُطَاعِنَ الْفُرْسَانِ فِي حَمَسِ الْوَغَى","أَقْصِرْ فَرُمْحُكَ عَنْ غَريمِكَ أَقْصَرُ",31,"ر",1,0],["أَمطَروني مَطرَ السو","ءِ وَقالوا نَحنُ أَنوا",32,"و",2,0],["أم طريقًا إلى الفناء قصيرًا","قد ركبنا لطيِّه الأياما؟",33,"م",2,0],["أمطلبُ دعْ دعاوى الكماة","ِ فَتلكَ نَحِيزقٌ لا رُتبَهْ",34,"ب",2,1],["أمْطَتكَ همّتك العزيمة فاركبِ","لا تُلقينّ عصاكَ دونَ المَطلبِ",35,"ب",1,1],["أمطروا الدمع عليه لا الندى","وانثروا الشعر عليه لا الزهور",36,"ر",1,1],["أمطرْ علىَّ سحائبا من فضةٍ","من أنمل مثلَ البحارِ هَوَامِي",37,"م",2,0],["أم طَافَ طَيفُ مَيَّةٍ طَارِقاً","أهلاً بِه من طَارِقٍ طائف",38,"ف",1,0],["أَمُطعِمُ لَم أَخذُلكَ في يَومِ نَجدَةٍ","ولا عِندَ تِلكَ المُعظماتِ الجَلائِلِ",39,"ل",1,0],["أَمُطعِمُ إِنَّ القَومَ ساموكَ خُطَّةً","وَإِنّي مَتى أُوكَل فَلَستُ بِوائِلِ",39,"ل",1,0],["أَمطَيتَني ظَهرَ السِماكِ بِرُتبَةٍ","سُقِيَت عِدايَ بِها سِماماً مُنقَعا",40,"ع",2,0],["أَمطاكَهُ الموفي عَلى آبائِهِ","وَرَعاً وَكَم عَلَتِ الفُروعُ أُصولا",41,"ل",2,0],["أَمطارُهُنَّ دَمُ العِدى وَبُروقُها","لَمعُ الصَوارِمِ وَالرُعودُ صَليلُ",42,"ل",1,0],["أمِط عن محياه الحجاب فلو رأى","ذوو الرشد منهم ما رأيتُ لهاموا",43,"م",3,0],["امطر عليها الخيل تمطر ثرة","وابرق عليها بالسيوف وارعد",44,"د",1,0],["أَمطَرنَني بِها يَمينُ فَتىً","أَروَعَ لا كَزَّةٌ وَلا شَهجاءُ",45,"ا",2,0],["أمطرى يا سماء في كل أر","أوقدي يا سماء نور الشموع",46,"ع",1,0],["أَمطِري يا سَماءُ في كلِّ يومٍ","ما تَشاءُ الأَقدارُ من نُظّارِ",47,"ر",1,1],["أَمطِري يا سحائِبَ الفَضلِ ما شِئ","تِ وَفيضي على الرُبا وَالوِهادِ",48,"د",1,1],["أَمَطْنَ دِمَقْسِيَّ المُلاَ عَنْ روادفٍ","رِوَاءٍ ولكنّ الخصور صوادي",49,"د",2,0],["أَمِطِ اللِثامَ عَنِ العِذارِ السائِلِ","لِيَقومَ عُذري فيكَ عِندَ عَواذِلي",50,"ل",2,1],["أَمِطْ عَنَّا أَذَى الدُّنْيَا وَأَهْدِي","لَنَا مِمَّا نُؤَمِّلُ مِنْكَ بُدْنَا",51,"ن",2,0],["أَمِطْ يَا عَيْنَ بَهْجَتِهَا قَذَاهَا","وَحُطْ يَا شَوْقَ مَغْرِبِهَا سَنَاهَا",52,"ا",3,0],["أمطت قناع النفس عن شهواتها","ذر الحمقا فالحمقاء بالدر تقنع",53,"ع",1,0],["أمطعمك عبء الحب ما اسطعت فالهوي","كوى عبئه قلباً هوى بالكواعب",54,"ب",1,0],["أَمْطَرْتَها مِنْ فَيْضِ عَدْلِكَ أَنْعُماً","لا تُعْدِمُ الرُّوّادَ رَوْضاً مُونِقا",55,"ق",2,0],["أَمِط عَنكَ السِلاحَ غَنيتَ عَنهُ","وَأَنتَ الفارِسُ البَطَلُ الهُمامُ",56,"م",1,0],["أَمِط عَنّي الوَقارَ بِها فَإِنّي","أَرى خَلعَ العِذارِ عَلى العُ