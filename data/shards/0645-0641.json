458,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[458,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[461,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[461,"ممدح غمر الرداء والشيم","https://www.aldiwan.net/poem16220.html","الرجز"],[463,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[464,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[464,"أنجل علي ما برحت محمداً","https://www.aldiwan.net/poem3305.html","عموديه"],[464,"وأحور في عينيه هاروت بابل","https://www.aldiwan.net/poem3344.html","عموديه"],[464,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[465,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[466,"إذا انشق عند السابري رأيته","https://www.aldiwan.net/poem50369.html","الطويل"],[493,"جاورت بالحب قلبا لم تذر فكرى","https://www.aldiwan.net/poem67354.html","البسيط"],[500,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[500,"كل وقت له من القوم شيخ","https://www.aldiwan.net/poem37749.html","الخفيف"],[504,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[514,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[514,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[515,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[515,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[515,"أنهي إليك من خفي حالي","https://www.aldiwan.net/poem12216.html","السريع"],[538,"مفضل بالرغم من خواه","https://www.aldiwan.net/poem47506.html","عموديه"],[538,"مفضل مستعجل","https://www.aldiwan.net/poem47928.html","عموديه"],[551,"لا تلم الدهر ولا تعذل","https://www.aldiwan.net/poem47269.html","السريع"],[551,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[567,"ضحكت من شيبة ضحكت","https://www.aldiwan.net/poem69551.html","الرمل"],[573,"مفتتن في نفسه فاتن","https://www.aldiwan.net/poem3638.html","السريع"]],"verses":[["مُفتَرِقاً لا عَن قِلىً وَمُصطَدَم","صَكَّ المُجيلِ زَلَماً بَعدَ زَلَم",0,"م",1,0],["مِفتاحُ كُلِّ نَدىً وَرَبُّ مَعاشِرٍ","كانوا عَلى أَموالِهِم أَقفالا",1,"ل",2,0],["مُفيضٌ وَلَكِنَّهُ غايِضٌ","وَخَرقٌ وَلَكِنَّهُ يُرقَعُ",2,"ع",1,0],["مُفتَقَةٌ مِن جَنِبِ النِشاصِ","تَطَلُّعَ الرودِ مِنَ الخَصاصِ",3,"ص",1,0],["مُفارِقَ دارٍ طَأطَأَ الذُلُّ أَهلَها","وَما عِزُّ دارٍ لَيسَ فيها مَعاشِرُ",4,"ر",1,0],["مَفارِقُ لا يَعلو عَلَيها مُطاوِلٌ","غَداةَ وَغىً إِلا قِباُبَ المَغافِرِ",5,"ر",1,0],["مُفتَرِشٌ لِلمُلكِ أَح","لى في المَعالي وَأَمَرّ",6,"ر",1,0],["مُفَرَّغَةً مِمّا تُنيلُ عُبابَها","مِنَ المالِ أَو مَملوءَةً جَفَناتُها",7,"ت",3,0],["مُفَرِّطٌ يَشقَى بِتَفْرِيطِهِ","وَمُحْسِنٌ يُجْزَى بِإِحْسَانِهِ",8,"ن",2,0],["مَفارِقُ ما راعَ البَياضُ سَوادَها","وأفْئِدَةٌ لمْ تَدْرِ ما ألَمُ الصّدِّ",9,"د",1,0],["مُفَرَّجَةً يَإِطُّ النِسعُ فيها","أَطيطَ السَمهَرِيَّةِ أَن تُقاما",10,"م",2,0],["مُفضِلاً مُحسِناً عَلى العُسرِ وَاليُس","رِ جَميعَ الفُؤادِ رَحبَ الجَنابِ",11,"ب",1,0],["مُفَتِّشاً وَفَقيهاً","وَقاضِياً وَاِبنَ فَنِّ",12,"ن",1,0],["مُفَضَّضُ الثَغرِ لَهُ نُقطَةٌ","مِن عَنبَرٍ في خَدِّهِ المُذهَبِ",13,"ب",1,0],["مفتقداً في السير شطر الهدى","من خطتي مصر وشطر الهوى",14,"ا",1,0],["مُفَارِقاً غُرَّ أَمَانِيهِ","أَوْ مُوتِمَ الأَطْهَارِ مِنْ وَلْدِهِ",15,"د",2,0],["مَفَاخِرُ فَارُوقَ فِي عَصْرِهِ","تُجَاوِزُ مَقْدَرَةَ المَادِحِينْ",16,"ن",1,0],["مُفَرَّجَةٌ حَمراءُ عَيساءُ جَونَةٌ","صُهابِيَّةُ العُثنونِ دَهماءُ صَندَلُ",17,"ل",1,0],["مفاتيح أبواب الفتوح فطالما","أُبيحت بها للكافرين المعاقلُ",18,"ل",1,0],["مفتّرة الأجفان تدمي بلحظها","قلوب أسود مدميات الكتائب",19,"ب",1,0],["مُفَدّى مُرَدّى يَكثُرُ الناسُ حَولَهُ","طَويلُ نِجادِ السَيفِ سَبطُ الأَنامِلِ",20,"ل",1,0],["مَفاوِزُ لا يُعجِزنَ صاحِبَ هِمَّةٍ","وَإِن عَجَزَت عَنها الغُرَيرِيَّةُ الصُبرُ",21,"ر",1,0],["مُفَجَّعَةً قَد شَفَّها فَقدُ أَحمَدٍ","فَظَلَّت لِآلاءِ الرَسولِ تُعَدِّدُ",22,"د",1,0],["مفرغين جفوناً في صباح وغى","ومالئين جفاناً عند إمساء",23,"ا",2,0],["مفارق أوطان له وشبيبة","إذا شرَّقت أهل التواصل غرَّبا",24,"ب",2,0],["مفطراً فمَ وفد أو كبود عدى","يا بعد ما بين أفواهٍ وأكباد",25,"د",1,0],["مفارق الطرف فيكَ غيري","حيثُ سرَت خيلكَ السوابق",26,"ق",1,0],["مفطَّر المهجة في حبِّ من","عيني من النوم بها صائمهْ",27,"م",2,0],["مفطّراً فيه أكباد العدَاة كما","فطرت أفواهَ أحبابٍ بإحسانِ",28,"ن",1,0],["مَفْزعٌ للرُّعاةِ مرعىً خصيبٌ","لرعاياهُمُ وفوق الخصيبِ",29,"ب",1,0],["مفجَّرةٌ قبل السؤال وبعدَهُ","صوافي جِمام الماء لا كَدِراتُ",30,"ت",1,0],["مِفْتَاحُكَ العفْوُ لا التَّشدُّدُ بَلْ","لَسْتَ بِمُسْتَغْلِقٍ فَتُفْتَتَحُ",31,"ح",1,0],["مَفاخِرُ عنْ آبائِهِ وبِنَفْسِه","نُفُودُ حصى الإحْصَاءِ قبل نُفُودها",32,"د",3,0],["مُفْصِحٌ فأْلُهُ يُخَبِّرُ عنْ أز","رٍ بأَزْر من شَكْله مشدودِ",33,"د",1,0],["مَفْزَع إبليسَ إليه إذا","رام فتون العاتِق البِكر",34,"ر",1,0],["مفلَّلُ حدِّ السيف من طول ضربه","قوانس بَيضِ الدّارعين الدَّلامص",35,"ص",1,0],["مفكك أوصال معلَّل فقحةٍ","عضوضٌ بسفلاه الأيور بلوعها",36,"ع",3,0],["مفتاح رأي حين يغلق بابه","مغلاق شر أيما مغلاق",37,"ق",1,0],["مُفدّىً يسمَّى باسمِ فيها مقبَّلاً","إذا قيل للخدّ الملعَّنِ مَلْطَمُ",38,"م",1,0],["مُفيداً مفيتاً يُسبغُ اللَّهُ فضلهُ","عليه ويُوليه الأخلاءَ دائما",39,"م",2,0],["مِفتاح أبوابِ السماء يفي","لك بافتتاح الأرضِ والأُمَمِ",40,"م",1,0],["مُفكِّرٌ قبل صُبْحِ الرأي متَّئدٌ","مُشمِّرٌ بعد صبحِ الرأي شيحان",41,"ن",1,0],["مفعَماتٍ كأنها حافلاتٌ","وهي صفرٌ من دِرَّةِ الألبان",42,"ن",1,0],["مُفتَرِشٌ كَاِفتِراشِ اللَيثِ كَلكَلَهُ","لِوَقعَةٍ كائِنٍ فيها لَهُ جَزَرُ",43,"ر",1,0],["مَفاخِرُهُم مَدى الأَجيالِ تَبقى","مُخَلَّدَةً إِذا ذُكِرَ الخُلودُ",44,"د",1,0],["مفجعة ليست بغير حِمامها","تلاقي مع العسر الذي مضها يسرا",45,"ر",2,0],["مفاخر لك يختال الزمان بها","قام الخطيب وزير الرىّ يطريها",46,"ي",3,0],["مَفاخِرُ لِلتاريخِ تُحصى لِأَدهَمٍ","وَمَن يُقرِضِ التاريخَ يَربَح وَيَغنَمِ",47,"م",1,0],["مَفخَرَةٌ لِبَيتِكُم","كَم قَبلَه