/poetry.dctabudhabi.ae/diwan/poem/5277","الخفيف"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9497","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54290","المجتث"],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[43,"أطاعن خيلا من فوارسها الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=178",""],[45,"إنّ طَيْفاً يزُورُني في المَنامِ","https://www.poetsgate.com/ViewPoem.aspx?id=31854",""],[51,"تحلَّبتِ الأنواءُ بعد جمودها","https://www.poetsgate.com/ViewPoem.aspx?id=27438",""],[85,"خفضتُ لعزة ِ الموتِ اليراعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9610&r=&rc=100",""]],"verses":[["مُفتَرِقاً لا عَن قِلىً وَمُصطَدَم","صَكَّ المُجيلِ زَلَماً بَعدَ زَلَم",0,"م",1,0],["مِفتاحُ كُلِّ نَدىً وَرَبُّ مَعاشِرٍ","كانوا عَلى أَموالِهِم أَقفالا",1,"ل",2,0],["مُفيضٌ وَلَكِنَّهُ غايِضٌ","وَخَرقٌ وَلَكِنَّهُ يُرقَعُ",2,"ع",1,0],["مُفتَقَةٌ مِن جَنِبِ النِشاصِ","تَطَلُّعَ الرودِ مِنَ الخَصاصِ",3,"ص",1,0],["مُفارِقَ دارٍ طَأطَأَ الذُلُّ أَهلَها","وَما عِزُّ دارٍ لَيسَ فيها مَعاشِرُ",4,"ر",1,0],["مَفارِقُ لا يَعلو عَلَيها مُطاوِلٌ","غَداةَ وَغىً إِلا قِباُبَ المَغافِرِ",5,"ر",1,0],["مُفتَرِشٌ لِلمُلكِ أَح","لى في المَعالي وَأَمَرّ",6,"ر",1,0],["مُفَرَّغَةً مِمّا تُنيلُ عُبابَها","مِنَ المالِ أَو مَملوءَةً جَفَناتُها",7,"ت",3,0],["مُفَرِّطٌ يَشقَى بِتَفْرِيطِهِ","وَمُحْسِنٌ يُجْزَى بِإِحْسَانِهِ",8,"ن",2,0],["مَفارِقُ ما راعَ البَياضُ سَوادَها","وأفْئِدَةٌ لمْ تَدْرِ ما ألَمُ الصّدِّ",9,"د",1,0],["مُفَرَّجَةً يَإِطُّ النِسعُ فيها","أَطيطَ السَمهَرِيَّةِ أَن تُقاما",10,"م",2,0],["مُفضِلاً مُحسِناً عَلى العُسرِ وَاليُس","رِ جَميعَ الفُؤادِ رَحبَ الجَنابِ",11,"ب",1,0],["مُفَتِّشاً وَفَقيهاً","وَقاضِياً وَاِبنَ فَنِّ",12,"ن",1,0],["مُفَضَّضُ الثَغرِ لَهُ نُقطَةٌ","مِن عَنبَرٍ في خَدِّهِ المُذهَبِ",13,"ب",1,0],["مفتقداً في السير شطر الهدى","من خطتي مصر وشطر الهوى",14,"ا",1,0],["مُفَارِقاً غُرَّ أَمَانِيهِ","أَوْ مُوتِمَ الأَطْهَارِ مِنْ وَلْدِهِ",15,"د",2,0],["مَفَاخِرُ فَارُوقَ فِي عَصْرِهِ","تُجَاوِزُ مَقْدَرَةَ المَادِحِينْ",16,"ن",1,0],["مُفَرَّجَةٌ حَمراءُ عَيساءُ جَونَةٌ","صُهابِيَّةُ العُثنونِ دَهماءُ صَندَلُ",17,"ل",1,0],["مفاتيح أبواب الفتوح فطالما","أُبيحت بها للكافرين المعاقلُ",18,"ل",1,0],["مفتّرة الأجفان تدمي بلحظها","قلوب أسود مدميات الكتائب",19,"ب",1,0],["مُفَدّى مُرَدّى يَكثُرُ الناسُ حَولَهُ","طَويلُ نِجادِ السَيفِ سَبطُ الأَنامِلِ",20,"ل",1,0],["مَفاوِزُ لا يُعجِزنَ صاحِبَ هِمَّةٍ","وَإِن عَجَزَت عَنها الغُرَيرِيَّةُ الصُبرُ",21,"ر",1,0],["مُفَجَّعَةً قَد شَفَّها فَقدُ أَحمَدٍ","فَظَلَّت لِآلاءِ الرَسولِ تُعَدِّدُ",22,"د",1,0],["مفرغين جفوناً في صباح وغى","ومالئين جفاناً عند إمساء",23,"ا",2,0],["مفارق أوطان له وشبيبة","إذا شرَّقت أهل التواصل غرَّبا",24,"ب",2,0],["مفطراً فمَ وفد أو كبود عدى","يا بعد ما بين أفواهٍ وأكباد",25,"د",1,0],["مفارق الطرف فيكَ غيري","حيثُ سرَت خيلكَ السوابق",26,"ق",1,0],["مفطَّر المهجة في حبِّ من","عيني من النوم بها صائمهْ",27,"م",2,0],["مفطّراً فيه أكباد العدَاة كما","فطرت أفواهَ أحبابٍ بإحسانِ",28,"ن",1,0],["مَفْزعٌ للرُّعاةِ مرعىً خصيبٌ","لرعاياهُمُ وفوق الخصيبِ",29,"ب",1,0],["مفجَّرةٌ قبل السؤال وبعدَهُ","صوافي جِمام الماء لا كَدِراتُ",30,"ت",1,0],["مِفْتَاحُكَ العفْوُ لا التَّشدُّدُ بَلْ","لَسْتَ بِمُسْتَغْلِقٍ فَتُفْتَتَحُ",31,"ح",1,0],["مَفاخِرُ عنْ آبائِهِ وبِنَفْسِه","نُفُودُ حصى الإحْصَاءِ قبل نُفُودها",32,"د",3,0],["مُفْصِحٌ فأْلُهُ يُخَبِّرُ عنْ أز","رٍ بأَزْر من شَكْله مشدودِ",33,"د",1,0],["مَفْزَع إبليسَ إليه إذا","رام فتون العاتِق البِكر",34,"ر",1,0],["مفلَّلُ حدِّ السيف من طول ضربه","قوانس بَيضِ الدّارعين الدَّلامص",35,"ص",1,0],["مفكك أوصال معلَّل فقحةٍ","عضوضٌ بسفلاه الأيور بلوعها",36,"ع",3,0],["مفتاح رأي حين يغلق بابه","مغلاق شر أيما مغلاق",37,"ق",1,0],["مُفدّىً يسمَّى باسمِ فيها مقبَّلاً","إذا قيل للخدّ الملعَّنِ مَلْطَمُ",38,"م",1,0],["مُفيداً مفيتاً يُسبغُ اللَّهُ فضلهُ","عليه ويُوليه الأخلاءَ دائما",39,"م",2,0],["مِفتاح أبوابِ السماء يفي","لك بافتتاح الأرضِ والأُمَمِ",40,"م",1,0],["مُفكِّرٌ قبل صُبْحِ الرأي متَّئدٌ","مُشمِّرٌ بعد صبحِ الرأي شيحان",41,"ن",1,0],["مفعَماتٍ كأنها حافلاتٌ","وهي صفرٌ من دِرَّةِ الألبان",42,"ن",1,0],["مُفتَرِشٌ كَاِفتِراشِ اللَيثِ كَلكَلَهُ","لِوَقعَةٍ كائِنٍ فيها لَهُ جَزَرُ",43,"ر",1,0],["مَفاخِرُهُم مَدى الأَجيالِ تَبقى","مُخَلَّدَةً إِذا ذُكِرَ الخُلودُ",44,"د",1,0],["مفجعة ليست بغير حِمامها","تلاقي مع العسر الذي مضها يسرا",45,"ر",2,0],["مفاخر لك يختال الزمان بها","قام الخطيب وزير الرىّ يطريها",46,"ي",3,0],["مَفاخِرُ لِلتاريخِ تُحصى لِأَدهَمٍ","وَمَن يُقرِضِ التاريخَ يَربَح وَيَغنَمِ",47,"م",1,0],["مَفخَرَةٌ لِبَيتِكُم","كَم قَبلَها مِن مَفخَرَه",48,"ر",2,0],["مُفَسِّرَ آيِّ اللَهِ بِالأَمسِ بَينَنا","قُمِ اليَومَ فَسِّر لِلوَرى آيَةَ المَوتِ",49,"ت",1,1],["مَفرَشي صَهوَةُ الحِصانِ وَلَكِن","نَ قَميصي مَسرودَةٌ مِن حَديدِ",50,"د",1,0],["مُفَدّى بِئاباءِ الرِجالِ سَمَيذَعاً","هُوَ الكَرَمُ المَدُّ الَّذي مالَهُ جَزرُ",51,"ر",1,0],["مفاتيح مشحونة بالعلوم","بها يفتح القفل المعطل",52,"ل",1,0],["مفاتيحُ علمِ اللّهِ في الأرض من تَفُزْ","بها يدُه يظفَرْ بكلِّ مَرامِ",53,"م",1,0],["مفارقِ ريحانِ الحياةِ ونازحٍ","عن الكأسِ والخِلِّ الوفيِّ الملائمِ",54,"م",1,0],["مَفازَةُ صَدرٍ لَو تُطَرَّقُ لَم يَكُن","لَيَسلِكَها فَرداً سُلَيكُ المَقانِبِ",55,"ب",1,0],["مُفَصَّصَةً تُقَرِّبُ بِالدَواهي","وَناكِثَةً تُريدُ لَكَ الزِيالا",56,"ل",2,0],["مَفتولةٌ مجدولةٌ","تحكي لنا قَدَّ الأَسَل",57,"ل",1,1],["مُفردٌ في السَّماحِ أضحى فَريقاً","في معاليهِ والأنامُ فَريقا",58,"ق",2,0],["مُفوَّفاتٌ إذا استسقَت أناملُه","ضَحِكْنَ من عارضٍ للجُودِ ثَجَّاجِ",59,"ج",1,0],["مفروجةٌ عن قَلِقِ الأَحشاءِ","أبيضَ ذي حاشيةٍ خضراءِ",60,"ا",2,0],["مفقودةٌ شِيَةُ الجوادِ لنَقْعِهِ","وحُجولُ أربعةٍ لخَوْضِ دمِائِه",61,"ا",3,0],["مُفَرِّقُ شَملِ المالِ بَعدَ اِجتِماعِهِ","وَفي راحَتَيهِ جَمعُ شَملِ المَكارِمِ",62,"م",1,0],["مَفاتِحُ أَرزاقِ العِبادِ بِكَفِّهِ","فَيُمنى بِها يُمنٌ وَيُسرى بِها يُسرُ",63,"ر",1,0],["مفيدٌ مبيدٌ في سبيليه جاعلٌ","مذاقة شهدٍ للأَنامِ وصَابا",64,"ب",2,0],["مُفيدُ جَزلِ المالِ مُعطي جَزلِهِ","يَحويهِ مِن حَرامِهِ وَحِلِّهِ",65,"ل",2,0],["مِفتاحُ كُلِّ مَدينَةٍ قَد أُبهِمَت","غَلَقاً وَمُخلي كُلِّ دارِ مُقامِ",66,"م",1,0],["مُفتَرَسٌ مالُهُ وَلَستَ تَرى","فَريسَةً عِرضَهُ لِمُفتَرِسِ",67,"س",1,0],["مُفَصَّلَةٌ بِاللُؤلُؤِ المُنتَقى لَها","مِنَ الشِعرِ إِلّا أَنَّهُ اللُؤلُؤُ الرَطبُ",68,"ب",1,0],["مفييءٍ بالجواء الطلقِ مُنصلِتٍ","للشمس تجدعُ منه الريحُ عِرنينا",69,"ن",2,0],["مُفَلَّجَةِ الأَنيابِ لَو أَنَّ ريقَها","يُداوى بِهِ المَوتى لَقاموا مِنَ القَبرِ",70,"ر",1,0],["مَفجوعَةٌ وَلِعَت بِها أَحزانُها","وَمَحَت غَضارَةَ عَيشِها الأَتراحُ",71,"ح",1,0],["مُفْتَرٍ يَهْذِي بقولِ الزُّورِ في","سَيِّدِ الرُّسْلِ ويُؤذيه جِهارا",72,"ر",2,0],["مُفَجَّعَةٌ لا دَفعَ لِلضَيمِ عِندَها","سِوى سَفَحانِ الدَمعِ مِن كُلّ مَسفَحِ",73,"ح",1,0],["مُفَرَّجَةَ الضَبعِ مَوّارَةً","تَخُدُّ الإِكامَ وَتَنفي النِقالا",74,"ل",2,0],["مُفَكِّرٍ مِن قَبلِ أَن يَقولا","وَيُحسِنُ التَفهيمَ وَالتَمثيلا",75,"ل",2,0],["مَفتوقَةٍ بِالبَرقِ يَضحَكُ أُفقُها","في لَيلَةٍ بَيضاءَ ذاتِ دَياجي",76,"ج",2,0],["مَفْتُوقَةً بِعَبِيرِ الْمِسْكِ زَاكِيةً","مِنْ طِيبها أَرَجُ الرَّضْوَانِ يَنْتَشِرُ",77,"ر",1,0],["مُفَهَّمٌ إِهابَةَ المُهيبِ","وَكَلِماتِ كُلِّ مُستَجيبِ",78,"ب",1,0],["مُفَرَّدٌ بِنَعيمٍ","مِنَ الظِباءِ اللَواتي",79,"ي",1,0],["مُفَتَّحِ الريشِ شَديدِ الزَندِ","ضَخمِ المَخاليبِ عَظيمِ العَضدِ",80,"د",1,0],["مُفَحَّجُ الرِجلَينِ عِندَ النَجدِ","ثَمَّ وَظيفانِ لَهُ مِن بَعدِ",81,"د",1,0],["مُفيدٌ وَمِتلافٌ سَبيلَ تُراثِهِ","إِذا ما غَدا أَو راحَ بِالجَزرِ وَالمَدِّ",82,"د",1,0],["مِفتاحُ بابِ الحَدَثِ المُنسَدِّ","نِعمَ مَزارُ المُعتَفي وَالوَفدِ",83,"د",1,0],["مُفَرَّجَةُ الضَبعَينِ مَمهورَةُ القَرى","تَحُذُّ عَلَيها راكِبٌ مُتَنَقِّبُ",84,"ب",1,0],["مُفنِياً بَينَ لَيلَتَينِ زَماني","لَيلَةٍ طَلقَةٍ وَأُخرى عَماسِ",85,"س",1,0],["مَفعولُ خَيرِكَ في الأَفعالِ مُفتَقَدٌ","كَما تَعَذَّرَ في الأَسماءِ فَعلولُ",86,"ل",1,0],["مَفازَةٌ ما الضَبابُ فيها","وَلا عَقيلٌ بِحافِرَيّا",87,"ر",3,0],["مُفْتَنّةٌ في ظِلّها وحَرورِها","تُغْنيكَ في المَشْتَى وفي المُصْطافِ",88,"ف",1,0],["مفهماً اياه أن ال","جهل موت أَي موتِ",89,"ت",1,0],["مفرشي صهوة الحصان ولكن","قميصي مسرودةٌ من حديد",90,"د",1,0],["مفازعُ للرَّدى إن لاح فَرّتْ","وراءَ خطاهُ وارتدّتْ أمامهْ",91,"م",2,0],["مُفَلَّجَةُ الأَنيابِ لَو أَنَّ ريقَها","يُداوى بِهِ المَوتى لَقاموا بِهِ مِنَ القَبرِ",92,"ر",1,0],["مَفْغُورَةُ الأَفْوَاهِ طَا","وِيَةُ الحَشَى بَعْدَ البَشَمْ",93,"م",1,0],["مُفَعَّماً قَلْبُهُ سُرُوراً وَقَدْ سَرَ","ى عَنْهُ مِنَ الفِرَاقِ الأَلِيمِ",94,"م",1,0],["مُفَصِّلُ آيَاتِ الْبَلاَغَةِ إِنْ نَهَى","نَهَى عَنْ ضَلاَلٍ أَوْ دَعَا فإِلى هدَى",95,"د",2,0],["مُفَكِّهَيْنِ مِنَ الأَحَا","دِيثِ الْعِذَابِ بِمَا نَشَاءْ",96,"ا",2,0],["مَفَاخِرُ فِي كِتَابِ الدَّهْرِ خُطَّتْ","بِكَفِّ لَمْ تُفَاخِرُ بِالخِضَابِ",97,"ب",1,0],["مُفْتَرٍ مَنْ قَالَ إِنَّ الْقَوْمَ مَاتُوا","حَدِّثِينَا عَنْهُمُ يَا مُعْجِزَاتِ",98,"ت",1,1],["مُفَكِّراً في مَعانٍ كُنتُ أَسمَعُها","مِن فيكَ قَد حَيَّرَت لُبّي وَأَفهامي",99,"ي",1,0],["مُفحَماتٌ تُعيِ الصِفاتِ فَما تُد","رَكُ إِلّا بِالظَنِّ وَالإيهامِ",100,"م",1,0],["مُفرَداً بِضَناهُ","يَحسَبُ اللَيلَ عاما",101,"م",2,0],["مُفَضَّلاَتٌ قِصَارٌ","لَهَا رنينٌ وَنَبْر",102,"ر",1,0],["مُفْصِحَاتٌ عن مجد مصر قديمًا","وحديثًا بِمُحْكَم الآيات",103,"ت",1,0],["مُفَدّى بِآباءِ الرِجالِ سَمَيذَعًا","هُوَ الكَرَمُ المَدُّ الَّذي مالَهُ جَزرُ",104,"ر",1,0],["مُفحَماتٌ تُعْيي الصّفاتِ فما تُد","ْ رَكُ إلاّ بالظّنّ والإِيهامِ",105,"م",1,0],["مَفاخرُ عنْ آبائِهِ وبِنفسه","نُفُوذُ حصى الإحصاءِ قبل نُفُودِها",106,"د",3,0],["مُفلِّلَ كلّ حادثة ٍ قِراعا","ومَنْ يتجرَّع الآلامَ حياً",107,"ا",1,0]]}