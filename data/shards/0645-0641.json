"البسيط"],[403,"ألم خاليها بعد الهجوع","https://www.aldiwan.net/poem50149.html","الوافر"],[403,"علا بك نجم الدين فاشتد ناصره","https://www.aldiwan.net/poem50168.html","الطويل"],[406,"أبا حسن قد ران بعد بعادكم","https://www.aldiwan.net/poem32256.html","الطويل"],[413,"هذا محل العلم والإفتاء","https://www.aldiwan.net/poem53983.html","الكامل"],[413,"شديد ما أضر بها الغرام","https://www.aldiwan.net/poem54005.html","الوافر"],[413,"عيدي بيوم شفائكم لسقامي","https://www.aldiwan.net/poem54014.html","الكامل"],[413,"ليالينا على الجرعاء عودي","https://www.aldiwan.net/poem54070.html","الوافر"],[413,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[413,"أسير وقد جازت بنا غاية السرى","https://www.aldiwan.net/poem54176.html","البسيط"],[426,"لحد ثوى فيه بدر العلم وا أسفا","https://www.aldiwan.net/poem40707.html","البسيط"],[429,"تنفس الروض عن نواره الأرج","https://www.aldiwan.net/poem12315.html","البسيط"],[433,"كنت في ركن من الأرض","https://www.aldiwan.net/poem2472.html","مجزوء الرمل"],[436,"إلى أي ذكر غير ذكرك أرتاح","https://www.aldiwan.net/poem34787.html","الطويل"],[436,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[436,"اسعد كما سعدت بك الأيام","https://www.aldiwan.net/poem34855.html","الكامل"],[436,"تتبين شمل الدين أنك ناظمه","https://www.aldiwan.net/poem34869.html","الطويل"],[436,"سلام وهنيت فيك السلامه","https://www.aldiwan.net/poem34883.html","المتقارب"],[456,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[456,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[456,"تمنى رجال أن تزل بي النعل","https://www.aldiwan.net/poem55997.html","الطويل"],[456,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[456,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[459,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[459,"ممدح غمر الرداء والشيم","https://www.aldiwan.net/poem16220.html","الرجز"],[461,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[462,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[462,"أنجل علي ما برحت محمداً","https://www.aldiwan.net/poem3305.html","عموديه"],[462,"وأحور في عينيه هاروت بابل","https://www.aldiwan.net/poem3344.html","عموديه"],[462,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[463,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[464,"إذا انشق عند السابري رأيته","https://www.aldiwan.net/poem50369.html","الطويل"],[491,"جاورت بالحب قلبا لم تذر فكرى","https://www.aldiwan.net/poem67354.html","البسيط"],[498,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[498,"كل وقت له من القوم شيخ","https://www.aldiwan.net/poem37749.html","الخفيف"],[502,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[512,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[512,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[513,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[513,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[513,"أنهي إليك من خفي حالي","https://www.aldiwan.net/poem12216.html","السريع"],[536,"مفضل بالرغم من خواه","https://www.aldiwan.net/poem47506.html","عموديه"],[536,"مفضل مستعجل","https://www.aldiwan.net/poem47928.html","عموديه"],[549,"لا تلم الدهر ولا تعذل","https://www.aldiwan.net/poem47269.html","السريع"],[549,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[556,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[565,"ضحكت من شيبة ضحكت","https://www.aldiwan.net/poem69551.html","الرمل"],[571,"مفتتن في نفسه فاتن","https://www.aldiwan.net/poem3638.html","السريع"]],"verses":[["مُفتَرِقاً لا عَن قِلىً وَمُصطَدَم","صَكَّ المُجيلِ زَلَماً بَعدَ زَلَم",0,"م",1,0],["مِفتاحُ كُلِّ نَدىً وَرَبُّ مَعاشِرٍ","كانوا عَلى أَموالِهِم أَقفالا",1,"ل",2,0],["مُفيضٌ وَلَكِنَّهُ غايِضٌ","وَخَرقٌ وَلَكِنَّهُ يُرقَعُ",2,"ع",1,0],["مُفتَقَةٌ مِن جَنِبِ النِشاصِ","تَطَلُّعَ الرودِ مِنَ الخَصاصِ",3,"ص",1,0],["مُفارِقَ دارٍ طَأطَأَ الذُلُّ أَهلَها","وَما عِزُّ دارٍ لَيسَ فيها مَعاشِرُ",4,"ر",1,0],["مَفارِقُ لا يَعلو عَلَيها مُطاوِلٌ","غَداةَ وَغىً إِلا قِباُبَ المَغافِرِ",5,"ر",1,0],["مُفتَرِشٌ لِلمُلكِ أَح","لى في المَعالي وَأَمَرّ",6,"ر",1,0],["مُفَرَّغَةً مِمّا تُنيلُ عُبابَها","مِنَ المالِ أَو مَملوءَةً جَفَناتُها",7,"ت",3,0],["مُفَرِّطٌ يَشقَى بِتَفْرِيطِهِ","وَمُحْسِنٌ يُجْزَى بِإِحْسَانِهِ",8,"ن",2,0],["مَفارِقُ ما راعَ البَياضُ سَوادَها","وأفْئِدَةٌ لمْ تَدْرِ ما ألَمُ الصّدِّ",9,"د",1,0],["مُفَرَّجَةً يَإِطُّ النِسعُ فيها","أَطيطَ السَمهَرِيَّةِ أَن تُقاما",10,"م",2,0],["مُفضِلاً مُحسِناً عَلى العُسرِ وَاليُس","رِ جَميعَ الفُؤادِ رَحبَ الجَنابِ",11,"ب",1,0],["مُفَتِّشاً وَفَقيهاً","وَقاضِياً وَاِبنَ فَنِّ",12,"ن",1,0],["مُفَضَّضُ الثَغرِ لَهُ نُقطَةٌ","مِن عَنبَرٍ في خَدِّهِ المُذهَبِ",13,"ب",1,0],["مفتقداً في السير شطر الهدى","من خطتي مصر وشطر الهوى",14,"ا",1,0],["مُفَارِقاً غُرَّ أَمَانِيهِ","أَوْ مُوتِمَ الأَطْهَارِ مِنْ وَلْدِهِ",15,"د",2,0],["مَفَاخِرُ فَارُوقَ فِي عَصْرِهِ","تُجَاوِزُ مَقْدَرَةَ المَادِحِينْ",16,"ن",1,0],["مُفَرَّجَةٌ حَمراءُ عَيساءُ جَونَةٌ","صُهابِيَّةُ العُثنونِ دَهماءُ صَندَلُ",17,"ل",1,0],["مفاتيح أبواب الفتوح فطالما","أُبيحت بها للكافرين المعاقلُ",18,"ل",1,0],["مفتّرة الأجفان تدمي بلحظها","قلوب أسود مدميات الكتائب",19,"ب",1,0],["مُفَدّى مُرَدّى يَكثُرُ الناسُ حَولَهُ","طَويلُ نِجادِ السَيفِ سَبطُ الأَنامِلِ",20,"ل",1,0],["مَفاوِزُ لا يُعجِزنَ صاحِبَ هِمَّةٍ","وَإِن عَجَزَت عَنها الغُرَيرِيَّةُ الصُبرُ",21,"ر",1,0],["مُفَجَّعَةً قَد شَفَّها فَقدُ أَحمَدٍ","فَظَلَّت لِآلاءِ الرَسولِ تُعَدِّدُ",22,"د",1,0],["مفرغين جفوناً في صباح وغى","ومالئين جفاناً عند إمساء",23,"ا",2,0],["مفارق أوطان له وشبيبة","إذا شرَّقت أهل التواصل غرَّبا",24,"ب",2,0],["مفطراً فمَ وفد أو كبود عدى","يا بعد ما بين أفواهٍ وأكباد",25,"د",1,0],["مفارق الطرف فيكَ غيري","حيثُ سرَت خيلكَ السوابق",26,"ق",1,0],["مفطَّر المهجة في حبِّ من","عيني من النوم بها صائمهْ",27,"م",2,0],["مفطّراً فيه أكباد العدَاة كما","فطرت أفواهَ أحبابٍ بإحسانِ",28,"ن",1,0],["مَفْزعٌ للرُّعاةِ مرعىً خصيبٌ","لرعاياهُمُ وفوق الخصيبِ",29,"ب",1,0],["مفجَّرةٌ قبل السؤال وبعدَهُ","صوافي جِمام الماء لا كَدِراتُ",30,"ت",1,0],["مِفْتَاحُكَ العفْوُ لا التَّشدُّدُ بَلْ","لَسْتَ بِمُسْتَغْلِقٍ فَتُفْتَتَحُ",31,"ح",1,0],["مَفاخِرُ عنْ آبائِهِ وبِنَفْسِه","نُفُودُ حصى الإحْصَاءِ قبل نُفُودها",32,"د",3,0],["مُفْصِحٌ فأْلُهُ يُخَبِّرُ عنْ أز","رٍ بأَزْر من شَكْله مشدودِ",33,"د",1,0],["مَفْزَع إبليسَ إليه إذا","رام فتون العاتِق البِكر",34,"ر",1,0],["مفلَّلُ حدِّ السيف من طول ضربه","قوانس بَيضِ الدّارعين الدَّلامص",35,"ص",1,0],["مفكك أوصال معلَّل فقحةٍ","عضوضٌ بسفلاه الأيور بلوعها",36,"ع",3,0],["مفتاح رأي حين يغلق بابه","مغلاق شر أيما مغلاق",37,"ق",1,0],["مُفدّىً يسمَّى باسمِ فيها مقبَّلاً","إذا قيل للخدّ الملعَّنِ مَلْطَمُ",38,"م",1,0],["مُفيداً مفيتاً يُسبغُ اللَّهُ فضلهُ","عليه ويُوليه الأخلاءَ دائما",39,"م",2,0],["مِفتاح أبوابِ السماء يفي","لك بافتتاح الأرضِ والأُمَمِ",40,"م",1,0],["مُفكِّرٌ قبل صُبْحِ الرأي متَّئدٌ","مُشمِّرٌ بعد صبحِ الرأي شيحان",41,"ن",1,0],["مفعَماتٍ كأنها حافلاتٌ","وهي صفرٌ من دِرَّةِ الألبان",42,"ن",1,0],["مُفتَرِشٌ كَاِفتِراشِ اللَيثِ كَلكَلَهُ","لِوَقعَةٍ كائِنٍ فيها لَهُ جَزَرُ",43,"ر",1,0],["مَفاخِرُهُم مَدى الأَجيالِ تَبقى","مُخَلَّدَةً إِذا ذُكِرَ الخُلودُ",44,"د",1,0],["مفجعة ليست بغير حِمامها","تلاقي مع العسر الذي مضها يسرا",45,"ر",2,0],["مفاخر لك يختال الزمان بها","قام الخطيب وزير الرىّ يطريها",46,"ي",3,0],["مَفاخِرُ لِلتاريخِ تُحصى لِأَدهَمٍ","وَمَن يُقرِضِ التاريخَ يَربَح وَيَغنَمِ",47,"م",1,0],["مَفخَرَةٌ لِبَيتِكُم","كَم قَبلَها مِن مَفخَرَه",48,"ر",2,0],["مُفَسِّرَ آيِّ اللَهِ بِالأَمسِ بَينَنا","قُمِ اليَومَ فَسِّر لِلوَرى آيَةَ المَوتِ",49,"ت",1,1],["مَفرَشي صَهوَةُ الحِصانِ وَلَكِن","نَ قَميصي مَسرودَةٌ مِن حَديدِ",50,"د",1,0],["مُفَدّى بِئاباءِ الرِجالِ سَمَيذَعاً","هُوَ الكَرَمُ المَدُّ الَّذي مالَهُ جَزرُ",51,"ر",1,0],["مفاتيح مشحون