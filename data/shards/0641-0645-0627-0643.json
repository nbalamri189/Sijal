et/poem46983.html","الكامل"],[403,"أجزتكما يا أهل ودي روايتي","https://www.aldiwan.net/poem33356.html","الطويل"],[405,"دعني فإن غريم العقل لازمني","https://www.aldiwan.net/poem49681.html","البسيط"],[405,"ثقوا معشر الناس بي إنني","https://www.aldiwan.net/poem50083.html","المتقارب"],[409,"سقى دارهم هامي الغمام وهامله","https://www.aldiwan.net/poem31668.html","عموديه"],[416,"بكت بدم من بعد عيسى وبندر","https://www.aldiwan.net/poem54120.html","الطويل"],[416,"إلى إحسان مولانا الرفاعي","https://www.aldiwan.net/poem54178.html","الوافر"],[432,"أقول رياض إذ ترصعها زهرا","https://www.aldiwan.net/poem12435.html","الطويل"],[439,"لك البشرى ودمت قرير عين","https://www.aldiwan.net/poem34819.html","الوافر"],[439,"أخو ظمأ يمص حشاه سبع","https://www.aldiwan.net/poem34835.html","الوافر"],[453,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[458,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[458,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[458,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[458,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[458,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[458,"وفى لي بك الحظ الذي كان يغدر","https://www.aldiwan.net/poem56168.html","الطويل"],[458,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[458,"أشوقا ومن تهوى خلي الجوانح","https://www.aldiwan.net/poem56258.html","الطويل"],[458,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[458,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[458,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[458,"قضى دين سعدى طيفها المتأوب","https://www.aldiwan.net/poem56292.html","الطويل"],[461,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15305.html","الطويل"],[461,"جزيت نجيب الدين خيرا وانني","https://www.aldiwan.net/poem15911.html","الطويل"],[461,"أقول لصحبي حين أجهشت العلى","https://www.aldiwan.net/poem15940.html","الطويل"],[461,"وأقسم لولا أحمد بن محمد","https://www.aldiwan.net/poem16176.html","الطويل"],[464,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[464,"سمو كما تهدى على العجم والعرب","https://www.aldiwan.net/poem3260.html","عموديه"],[464,"ليهن الورى برء العلى والفضائل","https://www.aldiwan.net/poem3265.html","عموديه"],[464,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[464,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[464,"أقل عنائي أنني فيه هائم","https://www.aldiwan.net/poem3633.html","عموديه"],[464,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[466,"عقيلية أما ملاث إزارها","https://www.aldiwan.net/poem50386.html","الطويل"],[468,"أيا من يهاب ومن يتقى","https://www.aldiwan.net/poem59813.html","المتقارب"],[470,"ولكنني وكلت من كل باخل","https://www.aldiwan.net/poem4736.html","الطويل"],[477,"تمنى فكنتم جل ما يتمناه","https://www.aldiwan.net/poem15345.html","الطويل"],[479,"وذات محيا يخلق الله ما يشا","https://www.aldiwan.net/poem36913.html","الطويل"],[479,"ولائمة للثغر إثر ابتسامها","https://www.aldiwan.net/poem37031.html","الطويل"],[479,"رأيت الهلال ووجه الأمير","https://www.aldiwan.net/poem37056.html","المتقارب"],[479,"سلا تونسا عني وعنها سلانيا","https://www.aldiwan.net/poem37589.html","الطويل"],[495,"لعمر المعالي إن مطلبها سهل","https://www.aldiwan.net/poem10261.html","الطويل"],[505,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[513,"أرى كل مرتاب يخاف خياله","https://www.aldiwan.net/poem67787.html","الطويل"],[551,"ولما تعانقنا ولم يك بيننا","https://www.aldiwan.net/poem47150.html","الطويل"],[551,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[551,"عرفت الديار كسحق البرود","https://www.aldiwan.net/poem47805.html","المتقارب"],[567,"أخ لي كنت أغبط باعتقاده","https://www.aldiwan.net/poem69712.html","الكامل"],[586,"ألين فيقسو ثم أرضى فيحقد","https://www.aldiwan.net/poem17480.html","الطويل"],[587,"ألا أيها الغادي مجداً بنجداً","https://www.aldiwan.net/poem11509.html","عموديه"],[587,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"]],"verses":[["فَما كُلُّ مَمنوحٍ مِنَ العِزِّ شاكِرٌ","وَلا كُلُّ مَحظوظٍ مِنَ المالِ قانِعُ",0,"ع",1,0],["فَما كانَ لَولاكُم يَمُرُّ لِيَ الغِنى","وَيَحلو إِلى قَلبي الخَصاصَةُ وَالفَقرُ",1,"ر",1,0],["فَما كانَ إِلّا خِلسَةً ثُمَّ إِنَّني","رَأَيتُ يَدي مِمّا عَلِقتُ بِهِ صِفراً",2,"ر",2,0],["فَما كُنتُ أَوَّلَ بَدرٍ أَتى","وَلا كُنتَ أَوَّلَ نَجمٍ غَرَب",3,"ب",1,0],["فَما كَذِبُ الواشي بِظَمياءَ نافِعٌ","لَديَّ وَلا وُدِّي لَها غَيرُ صادِقِ",4,"ق",1,0],["فَما كُلَّ يَومٍ لي فؤادٌ تَروعُهُ","وَلا كَبِدٌ مِمّا بِهِ تَتَصَدَّعُ",5,"ع",1,0],["فَما كُلُّ مَن يَشري القَنا يَطعَنُ العِد","وَلا كُلُّ مَن يَلقى الرِجالَ بِفارِسِ",6,"س",1,0],["فَما كُلُّ مَن تَهواهُ يَهواكَ قَلبُهُ","وَلا كُلُّ مَن صافَيتَهُ لَكَ قَد صَفا",7,"ف",2,0],["فَما كُنْتَ إلاّ رَحْمَةَ اللّهِ أُرْسِلَتْ","فأعْطِيَ معْتَرٌّ وأخْصَبَ مُعجِفُ",8,"ف",1,0],["فَمَا كُنْتَ إِلاَّ دُرَّةَ الْمَجْدِ كُلَّمَا","تَرَدَّدَ فِيهَا الْوَصْفُ لَمْ يُعْرَفِ الْوَصْمُ",9,"م",1,0],["فَمَا كَانَ إِلاَّ أَنْ أَتَوْا مَعْهَدَ الْهُدَى","وَشِيكاً كَمَا أَغْفَيْتَ فِي سِنَةِ الْحُلْمِ",10,"م",1,0],["فما كنْتَ لوْلا أن تَبُثَّ هِدايَةَ","مِنَ اللهِ مثْلَ الخلْقِ رسْماً ولا حَدّا",11,"د",2,0],["فَما كانَ إلا أنْ أناخَتْ وعرّسَتْ","فعرّسَتِ النَّعْماءُ واقتُضِيَ الوعْدُ",12,"د",1,0],["فَما كانَ فيهِ الوصْلُ إلاّ عُلالةً","كنُغْبَةِ مُرْتاعِ ونُهْبَةِ خَلاّسِ",13,"س",1,0],["فَما كُلُّ ذي لُبٍّ بِمؤتيكَ نُصحَهُ","وَما كُلُّ مؤتٍ نَصحَهُ بِلبيبِ",14,"ب",1,0],["فَما كَأولاكَ في بِرٍّ وَفي كَرَمٍ","أولى كَريمٍ وَلا عُقبى كَعُقباكا",15,"ك",2,0],["فَما كانَ إِلّا صَخرَةً لا تُلينُها الر","رُقاةُ وَطَوداً لا تَميلُ جَوانِبُه",16,"ب",2,0],["فَما كُنتُ إِلّا مُستَظِلّاً بِعشبَةٍ","مِنَ الشَوكِ ما فيها جَنىً لي وَلا ظِلُّ",17,"ل",1,0],["فَما كِدنَ لأياً بَينَ جَرعاءِ مالِكٍ","وَبَينَ النّقا يُعرَفنَ إِلّا تَماريا",18,"ي",2,0],["فَما كَلَّمَتنا دارُها غَيرَ أَنَّها","ثَنَت هاجِساتٍ مِن خَيالٍ مُراجِعِ",19,"ع",1,0],["فما كنت غلاّ الشمسَ قد غَرَبَتْ لنا","وأنوارها بدرُ التمام يُجلّيها",20,"ي",3,0],["فما كل ما قالت به شعراؤه","سوى ثلث ما يحويه بل هو خمسه",21,"س",2,0],["فَما كَعبُ بنُ مامَةَ وَاِبنُ سُعدى","بِأَجوَدَ مِنكَ يا عُمَرَ الجَوادا",22,"د",2,0],["فَما كانَ جيرانُ الزُبَيرِ مُجاشِعٌ","بِأَلأَمَ مِن جيرانِ وَهبٍ وَأَغدَرا",23,"ر",2,0],["فَما كانَ أَبلانا مِنَ الدَهرِ نَبوَةً","لَدى البابِ أَو عَضَّ السِنينَ الأَحامِسِ",24,"س",1,0],["فَما كُنتُ إِذ بانوا بِنَفسِكَ فاعِلاً","فَدونَكَ مُت إِنَّ الخَليطَ لَزائِلُ",25,"ل",1,0],["فَما كُلُّ مَن شاءَ المَعالي يَنالُها","وَلا كُلُّ سَيّارٍ إِلى المَجدِ يَهتَدي",26,"د",2,0],["فَما كانوا لَنا إِلّا أَسارى","وَما كانَت لَنا إِلّا نِهابا",27,"ب",2,0],["فما كانَ بالسفرِ المستجاد","وقد أطلعَ القمرَ العقرب",28,"ب",1,0],["فما كانَ بيني وبين اليسار","سوى أن مددتُ إليكَ اليمينا",29,"ن",2,0],["فما كلُّ من حطَّ الرحالَ بمخفِقٍ","ولا كلُّ من شدَّ الرحال بكاسبِ",30,"ب",1,0],["فما كافأْتني إلا بجوع","كأني كنتُ عندك كلبَ طَسْم",31,"م",1,0],["فَما كانَ فيهِم مِثلُهُ لِكَريهَةٍ","وَلا مُستَقِلٌّ بِالَّذي هُوَ حامِلُه",32,"ل",2,0],["فَما كانَ في مَدِّ المَدى لِيَ نَكبَةٌ","وَلا عَثرَةٌ إِنَّ البِطاءَ العَواثِرُ",33,"ر",1,0],["فَما كانَ أَدرى الغُصنَ بِالنَظم وَالنَثرِ","وَما كانَ أَدرى الماءَ بِالطَي وَالنَشرِ",34,"ر",1,0],["فَما كانَ أَحسَنَ مِن مَجلِسي","وَما كانَ أَرفَعَ مِن هِمَّتي",35,"ت",2,0],["فَما كانَ أَسهَلَ إِذ أَقبَلَت","وَما كانَ أَصعَبَ إِذ وَلَّتِ",35,"ت",1,0],["فما كان عند الناس فالناس ألسن","وما كان عند الله فالله أكرم",36,"م",1,0],["فما كشروقها منه نعيما","ولا كغرو بها فيه متاعا",37,"ع",2,0],["فَما كُنتِ إِلّا السَيفَ وَالنارَ مَركَباً","وَما كانَ يَستَعصي عَلى التُركِ مَركَبُ",38,"ب",1,0],["فَما كانَ ذَلِكَ مَدحاً لَهُ","وَلَكِنَّهُ كانَ هَجوَ الوَرى",39,"ا",1,0],["فَما كانَ فيهِ الغَدرُ إِلّا دَلالَةً","عَلى أَنَّهُ فيهِ مِنَ الأُمِّ وَالأَبِ",40,"ب",1,0],["فَما كُنتُ أَوَّلَ مَن فاتَهُ","لَدى صاحِبٍ بَعضُ ما أَمَّلَه",41,"ل",2,0],["فَما كُنتُ عَن نَفسي لِأَرحَلَ طائِعاً","إِلى الشَأمِ حَتّى كُنتَ أَنتَ المُؤَمَّرا",42,"ر",2,0],["فَما كانَ إِلّا ساعَةً ثُمَّ أَدبَرَت","فُقَيمٌ بِأَعضادٍ رَبَت وَظُهورِ",43,"ر",1,0],["فَما كانَ ذَنبي أَن جَنابٌ سَما بِهِ","حِفاظٌ وَشَيطانٌ بَطيءُ التَعَذُّرِ",44,"ر",1,0],["فَما كُلُّ مَن يَظُّنَّني أَنا مُعتِبٌ","وَلا كُلُّ مَن قَد خافَني أَنا قاتِلُه",45,"ل",2,0],["فَما كانَ شَيءٌ كانَ مِمّا نُجِنَّهُ","مِنَ الغِشِّ إِلّا قَد أَبانَت شَواكِلُه",46,"ل",2,0],["فَما كانَ ذَنبي في المَنِيَّةِ إِن عَصَت","وَلَم أَتَّرِك شَيئاً عَزيزاً وَرائِيا",47,"ي",2,0],["فما كشفَ القناعَ له قنوعي","ولا ملَّ الحياةَ له حيائي",48,"ا",2,0],["فَما كُلُّ وَصفٍ في الحَقيقَةِ ذاتُه","وَليسَ المُسَمّى في حَقيقَتِهِ الاِسمُ",49,"م",1,0],["فما كان إلا ما قضى بالُها به","فهل كان عنها الغيبُ ليس يغيبُ",50,"ب",1,0],["فَما كُنتَ إِلّا السَيفَ لاقى ضَريبَةً","فَقَطَّعَها ثُمَّ اِنثَنى فَتَقَطَّعا",51,"ع",2,0],["فَمَا كُلُّ مَنْ حَاكَ الْقَصَائِدَ شَاعِرٌ","وَلا كُلُّ مَنْ قَالَ النَّسِيبَ مُتَيَّمُ",52,"م",1,0],["فَمَا كُنْتُ لَوْلاهُنَّ تَهْتَاجُنِي الصَّبَا","أَصِيلاً وَيُشْجِينِي هَدِيرُ الْحَمَائِمِ",53,"م",1,0],["فَما كانَ إِلّا أَن طَوَتهُم يَدُ الرَدى","وَطارَت بِهِم ريحُ النَوى وَالنَوائِبِ",54,"ب",1,0],["فَما كانَ بِدعاً أَن يُصابَ فَمِثلُهُ","أُصيبَ وَحُمَّ المُلتَجونَ الفَوادِرُ",55,"ر",1,0],["فَما كانَ إِلّا فَرطَ خَمسٍ حَسِبتُهُ","مِنَ الدَهرِ حَتّى جاءَ لا يَتَعَلَّلُ",56,"ل",1,0],["فَما كانَ بَيني لَو لَقيتُكَ سالِماً","وَبَينَ الغِنى إِلّا لَيالٍ قَلائِلُ",57,"ل",1,0],["فَما كُنتَ إِلّا مِثلَ بائِعَةِ استِها","تَعودُ عَلى المَرضى بِهِ طَلَبَ الأَجرِ",58,"ر",1,0],["فَما كَلَّمتَني دارُها إِذ سَأَلتُها","وَفي كَبِدي كَالنِفطِ شُبَّت لَهُ النارُ",59,"ر",1,0],["فَما كانَ إِلّا الأُنسُ بَيني وَبَينَها","وَشَدوُ غِناءٍ تارَةً وَنَشيدُ",60,"د",1,0],["فَما كانَ بَينَ الخَيرِ لَو جاءَ سالِماً","أَبو حُجُرٍ إِلّا لَيالٍ قَلائِلُ",61,"ل",1,0],["فَما كُنتَ مِنَ الرَهطِ","يُعَدّونَ مَقابيلا",62,"ل",2,0],["فَما كُنتُ الحَبيبَ إِلَيكَ يَوماً","فَأَقرُبُ في الثَوِيِّ لِتَخدَعيني",63,"ي",1,0],["فَما كانَ يطغيه هناك رقيُّه","ولا يزدهيه أنه متقدم",64,"م",1,0],["فما كان منه الغدر إلاّ دلالةً","على أنّه فيه من الأمّ بالأب",65,"ب",1,0],["فَما كانَ لي الإِسلامُ إِلّا تَعَبُّداً","وَأَدعِيَةً لا تُتَّقى بِدُروعِ",66,"ع",1,0],["فما كبروا حتى يكونوا فريسةً","ولا بلغوا ان يقصدوا فينالوا",67,"ل",3,0],["فَما كُلُّ مَن يَشري القَنا يَطعَنُ العِدا","وَلا كُلُّ مَن يَلقى الرِجالَ بِفارِسِ",68,"س",1,0],["فَمَا كُلُّ جَفْرٍ غَاضَ يَرْتَدُّ نَبْعُهُ","وَلا كُلُّ سَاقٍ جَفَّ يَخْضَرُّ عُودُهُ",69,"د",2,0],["فَمَا كُنْتُ إِلَّا الْغَيثَ طَارَتْ بُروقُهُ","ومَا كُنْتُ إِلَّا الرَّعْدَ دَوَّى هَدِيدُهُ",69,"د",2,0],["فَمَا كُلُّ حَيٍّ يَنْصُرُ الْقَوْلَ فِعْلُهُ","وَلا كُلُّ خِلٍّ يَصْدُقُ النَّفْسَ وَعْدُهُ",70,"د",2,0],["فَمَا كُلُّ مَنْ رَاضَ الْبَدِيهَةَ عَاقِلٌ","وَلا كُلُّ مَنْ خَاضَ الْكَرِيهَةَ بَاسِلُ",71,"ل",1,0],["فَمَا كُنْتُ إِلَّا اللَّيْثَ أَنْهَضَهُ الطَّوَى","ومَا كُنْتُ إِلَّا السَّيْفَ فَارَقَهُ الْغِمْدُ",72,"د",1,0],["فَمَا كُلُّ مَا تَهْوَاهُ يَأْتِيكَ بِالْمُنَى","وَلا كُلُّ مَا تَخْشَاهُ فِي الْدَّهْرِ يَطْرُقُ",73,"ق",1,0],["فَمَا كُلُّ ما تَرْجُو مِنَ الأَمْرِ ناجِعٌ","وَلا كُلُّ ما تَخْشَى مِنَ الْخَطْبِ فَادِحُ",74,"ح",1,0],["فَمَا كُلُّ مَحْلُولِ الْعَرِيكَةِ خَائِبٌ","وَلا كُلُّ مَحْبُوكِ التَّرِيكَةِ ظَافِرُ",75,"ر",1,0],["فَمَا كُنْتُ لَوْلا إِنَّنِي وَاهِنُ الْقُوَى","أُعَلَّقُ فِي خَيْطٍ وَأُحْبَسُ في جِلْدِ",76,"د",1,0],["فَما كَانَ إِلَّا لَفْتَةُ ُالْجِيدِ أَنْ غَلَتْ","قُدُورٌ وَفارَ اللَّحْمُ وَانْفَضَّ مَأْرَبُ",77,"ب",1,0],["فمَا كل حَتى وَجَّهَ القَوْمَ وِجْهَةً","مُوَفَّقَةً أَجْدَى عَلَيْهِمْ وَأَرْشَدَا",78,"د",2,0],["فَمَا كَان سِجْنُكَ إِلاَّ قَرَاراً","وَقَدْ تعِبَ الجِدُّ أَنْ يَسْهَرَا",79,"ر",2,0],["فَما كُلُّ لَفظٍ في خِطابِكَ يُرتَضى","وَما كُلُّ مَعنىً في مَديحِكَ يَصلُحُ",80,"ح",1,0],["فَمَاكُرَهُ فأَنْزَلَهُ بمَكرٍ","وَمَحْمُودٌ أخو ثِقَةٍ جَسُورُ",81,"ر",1,0],["فما كان أغربه .. ملتقى","وما كان أقصره .. موعدا",82,"د",2,0],["فمَا كَرَمٌ إِلاَّ ومِنْه