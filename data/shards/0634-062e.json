{"poems":[[53,"بيني وبين الصوارم الهمم","https://www.aldiwan.net/poem29775.html","المنسرح"],[73,"هل راكب ذاهب عنهم يحييني","https://www.aldiwan.net/poem11849.html","البسيط"],[93,"وارحمتا لي من صروف زماني","https://www.aldiwan.net/poem11180.html","الكامل"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[51,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[91,"طوى بعض نفسي إذ طواك الثرى عني","https://www.aldiwan.net/poem62780.html","عموديه"],[92,"رفرفت في دجية الليل الحزين","https://www.aldiwan.net/poem38917.html","الرمل"],[45,"ضعة للزمان عندي وعكس","https://www.aldiwan.net/poem64604.html","الخفيف"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[44,"حل الأمير محل رفد الرافد","https://www.aldiwan.net/poem30525.html","الكامل"],[31,"إن الخبيب تروحت أثقاله","https://www.aldiwan.net/poem41844.html","الكامل"],[40,"إن الحبيب تروحت أجماله","https://www.aldiwan.net/poem42316.html","الكامل"],[52,"شخوص ولاية كشخوص عزل","https://www.aldiwan.net/poem26730.html","الوافر"],[48,"أكثري أو فأقلي","https://www.aldiwan.net/poem65047.html","مجزوء الرمل"],[50,"أهجرت عبدة أم عداك مسير","https://www.aldiwan.net/poem63827.html","الكامل"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[46,"الحمد لله الذي صاغني","https://www.aldiwan.net/poem23537.html","السريع"],[76,"بكفه ساحر البيان إذا","https://www.aldiwan.net/poem39322.html","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43856","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[31,"إنّ الحبيبَ تروحتْ اثقالهُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19025&r=&rc=288",""]],"verses":[["شَخصُكَ في وَجهِ كُلِّ داجِيَةٍ","ضُحىً وَفي كُلِّ مَجهَلٍ عَلَمُ",0,"م",1,0],["شَخصٌ يُذَكِّرُني فاهُ وَغُرَّتَهُ","شَمسُ النَهارِ وَأَنفاسُ الرَياحينِ",1,"ن",1,0],["شَخْصٌ قَلِيلٌ ظِلُّهُ طَاوِي الحَشَى","يَمْشِي فَلا تَتَوَازَنُ الكَتِفَانِ",2,"ن",1,0],["شَختُ الجُزارِةِ مِثلُ البَيتِ سائِرُهُ","مِنَ المَسوحِ خِدَبٌّ شَوقَبٌ خَشِبُ",3,"ب",1,0],["شِخت فأْذنْ بفراقٍ","وتجهز لانطلاق",4,"ق",1,0],["شَخَصتُ بِروحي حائِراً مُتَطَلِّعاً","إِلى ما وَراءِ البَحرِ أَدنو وَأَستَدني",5,"ي",1,0],["شَخَصَتْ لمَّا رَأَتْ عَيْنُ النُّجُومْ","بَعْثَةَ العُشَّاقْ",6,"ق",1,0],["شَخصُهُ المُزدَرى عِندي وَمَخبَرُهُ المَش","نوءُ قُبحاً وَرَأيُهُ المُستَخَسُّ",7,"س",1,0],["شَخصٌ هُوَ العالَمُ الجُزئِيُّ في سَرَفٍ","وَنَفسُهُ الجَوهَرُ الكُلِّيَّ في عِظَمِ",8,"م",1,0],["شَخصانِ أَفّاكانِ قيلُهُما الخَنا","حَلّا لَدَيكَ مَحَلَّ عَمرِو الزاهِدِ",9,"د",1,0],["شَخصٌ غَضيضُ الطَرفِ مُضَّمِرُ الحَشا","عَبلُ المُدَملَجِ مُشبَعٌ خَلخالُهُ",10,"ل",2,0],["شَخص غَضيض الطَرف مضطم الحَشا","عَبل المدملج مشبع خلخاله",11,"ل",2,0],["شُخوصُ وِلايَةٍ كَشُخوصِ عَزلِ","عَلى دَهشٍ وَعِزٍّ مِثلَ ذُلِّ",12,"ل",1,1],["شَخصُها شَخصٌ قَبيحٌ","وَلَها وَجهٌ مُوَلّي",13,"ي",1,0],["شَخصٌ إِذا التَبَسَت بِعَيني عَينُهُ","حَلَفَ النَواسِكُ أَنَّني مَسحورُ",14,"ر",1,0],["شَخصٌ بِرُؤيَتِهِ مُناهُ وَهَمُّهُ","وَحَديثُهُ في جِدِّهِ وَلِعابِهِ",15,"ب",2,0],["شَخصِيَ هَذا عُرضَةٌ لِلرَدى","وَلَم يَزَل مَعدِنَ عِصيانِ",16,"ن",1,0],["شَختٌ ضئيلٌ لفعلهِ خَطَرٌ","أعظِمْ به في مُلمَّةٍ خَطرا",17,"ر",2,0],["شختُ وَلَو مَرَّ طَرفهُ بي","لَم يَعنِهِ أَنَّهُ حُشاشُ",18,"ش",1,0],["شَخصتْ له الآمالُ تُسرِع خَطْوَها","ودنَا لرُؤيته العدِيدُ الأكْثرُ",19,"ر",1,0],["شَخْصٌ غَضيضُ الطَّرْفِ مُضْطَربُ الحَشَا","عَبْلُ المُدَمْلَجِ مُشْبَعٌ خَلْخَالُهُ",20,"ل",2,0]]}