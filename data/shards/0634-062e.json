لأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=204197",""],[5956,"الشاكر لقرينته","https://www.poetsgate.com/ViewPoem.aspx?id=207167",""],[161,"بيْنَ السَّجؤينِ وخُطَّةِ السَّجَّانِ","https://www.poetsgate.com/ViewPoem.aspx?id=175319",""],[6068,"رشيد تونس -18-","https://www.poetsgate.com/ViewPoem.aspx?id=177481",""],[6093,"مسائل في الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=176101",""],[6093,"شخص بغيض","https://www.poetsgate.com/ViewPoem.aspx?id=193987",""],[186,"دع عنك ذكر المنحنى وزرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55750&r=&rc=13",""],[572,"سَاجِلْ بفصلِكَ من أَردْتَ وباهِرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9225&r=&rc=82",""]],"verses":[["شَخصُكَ في وَجهِ كُلِّ داجِيَةٍ","ضُحىً وَفي كُلِّ مَجهَلٍ عَلَمُ",0,"م",1,0],["شَخصٌ يُذَكِّرُني فاهُ وَغُرَّتَهُ","شَمسُ النَهارِ وَأَنفاسُ الرَياحينِ",1,"ن",1,0],["شَخْصٌ قَلِيلٌ ظِلُّهُ طَاوِي الحَشَى","يَمْشِي فَلا تَتَوَازَنُ الكَتِفَانِ",2,"ن",1,0],["شَختُ الجُزارِةِ مِثلُ البَيتِ سائِرُهُ","مِنَ المَسوحِ خِدَبٌّ شَوقَبٌ خَشِبُ",3,"ب",1,0],["شِخت فأْذنْ بفراقٍ","وتجهز لانطلاق",4,"ق",1,0],["شَخَصتُ بِروحي حائِراً مُتَطَلِّعاً","إِلى ما وَراءِ البَحرِ أَدنو وَأَستَدني",5,"ن",2,0],["شَخَصَتْ لمَّا رَأَتْ عَيْنُ النُّجُومْ","بَعْثَةَ العُشَّاقْ",6,"ق",1,0],["شَخصُهُ المُزدَرى عِندي وَمَخبَرُهُ المَش","نوءُ قُبحاً وَرَأيُهُ المُستَخَسُّ",7,"س",1,0],["شَخصٌ هُوَ العالَمُ الجُزئِيُّ في سَرَفٍ","وَنَفسُهُ الجَوهَرُ الكُلِّيَّ في عِظَمِ",8,"م",1,0],["شَخصانِ أَفّاكانِ قيلُهُما الخَنا","حَلّا لَدَيكَ مَحَلَّ عَمرِو الزاهِدِ",9,"د",1,0],["شَخصٌ غَضيضُ الطَرفِ مُضَّمِرُ الحَشا","عَبلُ المُدَملَجِ مُشبَعٌ خَلخالُهُ",10,"ل",2,0],["شَخص غَضيض الطَرف مضطم الحَشا","عَبل المدملج مشبع خلخاله",11,"ل",2,0],["شُخوصُ وِلايَةٍ كَشُخوصِ عَزلِ","عَلى دَهشٍ وَعِزٍّ مِثلَ ذُلِّ",12,"ل",1,1],["شَخصُها شَخصٌ قَبيحٌ","وَلَها وَجهٌ مُوَلّي",13,"ل",2,0],["شَخصٌ إِذا التَبَسَت بِعَيني عَينُهُ","حَلَفَ النَواسِكُ أَنَّني مَسحورُ",14,"ر",1,0],["شَخصٌ بِرُؤيَتِهِ مُناهُ وَهَمُّهُ","وَحَديثُهُ في جِدِّهِ وَلِعابِهِ",15,"ب",2,0],["شَخصِيَ هَذا عُرضَةٌ لِلرَدى","وَلَم يَزَل مَعدِنَ عِصيانِ",16,"ن",1,0],["شَختٌ ضئيلٌ لفعلهِ خَطَرٌ","أعظِمْ به في مُلمَّةٍ خَطرا",17,"ر",2,0],["شختُ وَلَو مَرَّ طَرفهُ بي","لَم يَعنِهِ أَنَّهُ حُشاشُ",18,"ش",1,0],["شَخصتْ له الآمالُ تُسرِع خَطْوَها","ودنَا لرُؤيته العدِيدُ الأكْثرُ",19,"ر",1,0],["شخصيتي من غرابتها وطيبتها","كن الزمن في تحدي بينه وبيني",20,"ن",2,0],["شَخْصٌ غَضيضُ الطَّرْفِ مُضْطَربُ الحَشَا","عَبْلُ المُدَمْلَجِ مُشْبَعٌ خَلْخَالُهُ",21,"ل",2,0],["شخصك في فؤادي","معزز المقام",22,"م",1,0],["شِخْنا وما شاخَ الهوى بيننا","ولا أرى للغَيِّ عَنَّا بَرَاح",23,"ح",1,0],["شخص الحبيب وذاته","واللّه عندي غالية",24,"ل",3,0],["شَخْتُ الحواشي باسلٌ يومَ الوغى","ضَخم الجَدا طَلْقُ المحيَّا أَبلَج",25,"ج",1,0],["شخص بصير وأعمى","ليسا سواء بحال",26,"ل",1,0],["شَختور مُصَفَّح","عِندي مَدافِع",27,"ع",1,0],["شخصك مذ صار نصب عيني","أثر في مقلتي سهادا",28,"د",2,1],["شخصٌ وليس له أذنٌ ليسمعنا","إذا نَبذنا حياةً كلُّها فان",29,"ن",1,0],["شخص مُعاويُّ المِعِيْ","يُهدي لها طَرفاه زَرْدا",30,"د",2,1],["شخّصتَ ما أولى نداكَ وإن تفض","كرماً عليّ به فما أولاني",31,"ن",2,0],["شخصيتان له توحدتا كما","يتوحد المنظور بالمسموع",32,"ع",1,0],["شخُنا السَّيِّدُ الجَليلُ الرِّفاعِي","من غَدا للرِّجالِ أَعظَمَ سَاقِ",33,"ق",1,0],["شخصت إليك نواظر الأمم التي","ملكتهم لك بيعة وعهود",34,"د",1,0],["شخص الأنام إليه تحت جنازة","خفضت برفعة قدرها الأقدار",35,"ر",1,0],["شخصٌ له عجائبٌ لا تُحصَرُ","ومن عَجيبِ أمرِهِ ما نَذكُرُ",36,"ر",1,1],["شخصُه الفذُّ ذائعُ الص","صيتِ في كلِّ مَا بَلَد",37,"د",1,0],["شَخَصتُ مُذ يَومَ نادَوا بِالرَحيلِ عَلى","آثارِهِم ثُمَّ لَم أَطرَف إِلى أَحَدِ",38,"د",1,1],["شخصوا إلىأنوار ذاتك في الورى","فإذا الجميع عن المغايرة انزووا",39,"و",3,0],["شخوص وأشباح تمر وتنقضي","وليس لها مما قضى الله من واقي",40,"ق",2,0],["شخوصٌ وأشباح تمر وتنقضي","وتفنى جميعاً والمحرك باقي",41,"ي",1,0],["شخوص شاءها فيقال أشيا","بلا شك هناك ولا اختلاف",42,"ف",1,0],["شخصت لطلعة وجهك الأشخاصُ","وتراقصت بطيورها الأقفاصُ",43,"ص",1,1],["شخصت عيونٌ قلبها مدهوشُ","لما تجلت للغيوب عروشُ",44,"ش",1,1],["شخصُ الكَمالِ كأنَّ اللهَ صَوَّرَهُ","من مَعدِنِ اللُّطفِ لا طِيناً ولا خَزَفا",45,"ف",2,0],["شخصُ الخليفةِ بعدَ اللهِ نَحسبُهُ","وبعدَ ذاكَ سعيدٌ أوَّلُ العُمَدِ",46,"د",1,0],["شخَصَتْ لهُ أبصارُ عينِ محبِّهِ","حتى كأنَّ سَوادَها من حِبرِهِ",47,"ر",2,0],["شخصٌ إذا أقبلَ لكنَّهُ","من شخصهِ يَخرُجُ في مَوْكِبِ",48,"ب",1,0],["شَخَصَ الأنامُ إلى جَمَالِكَ فاستعِذْ","مِنْ شَرِّ أَعْيُنِهِم بِعَيْبٍ واحِدِ",49,"د",1,0],["شخصان في شكلٍ واحدٍ قُدرا","ورُكّبا بالعقولِ تركيبا",50,"ب",2,0],["شَخِصَ الأنامُ إِلى جَمالِكَ وَانْثَنُوا","عَنْهُ وَقَدْ أَثْنوا عَلَيهِ وأَجْمَلوا",51,"ل",3,0],["شخصت إليك وفودهم لترى الذي","شخصت إليه سائر الأنظار",52,"ر",1,0],["شخَصت نحوَها النواظر لمّا","أن بَدى نور وجهها كالهلالِ",53,"ل",1,0],["شَخَصنا إليكَ وأنتَ الّذي","إليهِ عيونُ الورى تشخصُ",54,"ص",1,1],["شخص الكيان وكل شيء ظله","ظل الحياة ونفثة الإيمان",55,"ن",1,0],["شخصنا إليه مثلما شخصت إلى","الحمائم أفراخ لها تتشوف",56,"ف",1,0],["شخَصُوا وحَشْوُ خدورِهمْ أشخاصُ","أَشباهها الأغصانُ والأدعاصُ",57,"ص",1,0],["شَخصانِ أَقبَلا مِن الحَج مَعي","قَد لَقِيا قَوقَعَةً في يَنبُع",58,"ع",1,1],["شَخصان مِن بَينِهما المكالمه","أَفضَت عَلى الفَور إِلى المُخاصَمه",59,"ه",1,1],["شخصٌ يَهيمُ بكل وادٍ مثلما","لعبت بمجنون الحمى الأوهام",60,"م",1,0],["شخص هو الجوهر الفرد الذي جمعت","فيه المعاني فمفعول ومنقول",61,"ل",1,0],["شخص هو الجوهر الفرد الذي جمعت","فيه المعالي لذا لم يلق منقسما",62,"م",2,0],["شَخَصَت لَهُ أَبصارُهُم وَاِستَمسَكوا","رَعلاً بِعُروَةِ جاهِهِ اِستِعصاما",63,"م",2,0],["شخصيّة اسم عين المدعوّا","مطلقه كآدم وحوّا",64,"ح",3,0],["شخصت نحوه العيونُ ولكن","عاد بعض يَقذى وبعضٌ قريرا",65,"ر",2,0],["شخوصٌ وَأَشباحٌ تَمُرُّ وَتَنقَضي","سَريعاً وَأَشكالاً بِغَيرِ وِفاقِ",66,"ق",1,0],["شخصت لها الابصار لما أصبحت","في حسنها الزاهى بدون مثال",67,"ل",1,0],["شخص العوارف والمعارف والندى","فله بذلك غابط وحسود",68,"د",1,0],["شَختِ المآزر لاذِيّ الظهائرِ قد","أتاكَ يَرفُلُ في ثَوبٍ لَهُ سُوسي",69,"س",2,0],["شَخَصَت إلى الزرقاءِ منها مُقلَةٌ","أهدَت إلى هاتُورَ لحظاً ساحِراً",70,"ر",2,0],["شَخَصَت له كلُّ العيونِ وَلَيتَني","ثوبٌ عليه لكي أُريحَ غرامي",71,"ي",1,0],["شخصت إلى الزرقاء منها مقلةٌ","وترفعت عن رؤية الثقلانِ",71,"ن",1,0],["شخّيت حشاكم في ثيابي عندما","عاينه بالموسى يقطع زبّوري",72,"ر",2,0],["شُختَ المَخالِبَ وَالأَناييبِ وَالشَوى","ثُجلَ الخُصورِ رَحيبَةَ الأَقرابِ",73,"ب",1,0],["شخصاً سويا وقد سماه لي بشرا","من المباشرة الزُّلفى التي انتهضا",74,"ض",2,0],["شخص يرى قرصةَ البرغوثِ تؤلمه","إلى مكارهَ يلقى في تقلبه",75,"ب",2,0],["شخصت إليها المحدقون ليدركوا","عمشت عيونهم بنور أبهرا",76,"ر",2,0],["شخصت نحوك الأنام حيارى","تتحرى بك الهدى في الزحام",77,"م",1,0],["شخصت بطلعتها العيون وقد بدا","دبر الدجى بجبينها المتبلج",78,"ج",1,0],["شَخصت لِمهبّكِ عَيناه","وَتَلفَّتتا نَحُوَ القَبر",79,"ر",1,0],["شخصت بِقَلبي لا بِشخص اليهم","وَذا حال صبّ من رَقيب قد اختَشى",80,"ش",2,0],["شُخوصُكَ يا رُبوعي في ضُلوعي","لَها مِنّي الغَداةَ هَوىً شَجاني",81,"ن",2,0],["شخص ولكن هيولي روحه ملك","وجسمه صورة في شكل قديس",82,"س",1,0],["شخص أوى إلى مكان وثوى","وقد غوى حين خوى نجم هوى",83,"ه",3,0],["شخوصهم في الخيال حاضرةٌ","تسمعني ما تركن في الكتب",84,"ب",1,0],["شخصيّة الروح أدت","بها الى الأطواق",85,"ق",1,0],["شخر الضيف حين نام فلاموه","وما كان مستحق الملام",86,"م",1,0],["شخوصٌ وأصواتٌ يخالفُ بعضُها","بعضاً وأفعالٌ بغير وفاقِ",87,"ق",1,0],["شَخص كَأَن اللَه كَون ذاته","لُطفاً لِتَظهر في الوَرى أَسراره",88,"ر",2,0],["شخصت للقرص لما بان أوله","كجايع مد طرفاً نحو عرجون",89,"ن",1,0],["شخصٌ من العربِ أتى لخفضكم","يمشي بخيله بوسط النهرِ",90,"ر",1,0],["شَخَصَت عَلى بُعدِ النَوى أَشخاصُهُم","فَراتَهُم الأَوهامُ كَالأَشباحِ",91,"ح",1,0],["شَخصٌ نَفِيسٌ خَطِيرٌ لَو بَدَلتُ بِهِ","نَفسِي أخَذتُ الذِي يَبقَى علَى الفَانِي",92,"ن",2,0],["شخصُ القَداسةِ لم يَقُم إلَّا بطبع","مَحَبَّةٍ قُدسيَّةٍ وإِخاءِ",93,"ا",2,0],["شخصهُ الجوهريُّ قام بنوعٍ","مُفرَدِ الحُسنِ بالبَها موصوفِ",94,"ف",1,0],["شخصٌ بطبعَينِ والتفسيرُ يُوضِحُهُ","طبعٌ بسيطٌ وطبعٌ قابل الأَلَمِ",95,"م",1,0],["شخصتُ لعزمِ البينِ فاخترَمَتْ شخصي","زيادةُ وجدٍ تنهكُ الجسمَ بالنقصِ",96,"ص",1,1],["شخوصاً بني الآمال نحو رحابه",