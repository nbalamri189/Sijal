{"poems":[[53,"بيني وبين الصوارم الهمم","https://www.aldiwan.net/poem29775.html","المنسرح"],[73,"هل راكب ذاهب عنهم يحييني","https://www.aldiwan.net/poem11849.html","البسيط"],[93,"وارحمتا لي من صروف زماني","https://www.aldiwan.net/poem11180.html","الكامل"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[51,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[91,"طوى بعض نفسي إذ طواك الثرى عني","https://www.aldiwan.net/poem62780.html","عموديه"],[92,"رفرفت في دجية الليل الحزين","https://www.aldiwan.net/poem38917.html","الرمل"],[45,"ضعة للزمان عندي وعكس","https://www.aldiwan.net/poem64604.html","الخفيف"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[44,"حل الأمير محل رفد الرافد","https://www.aldiwan.net/poem30525.html","الكامل"],[31,"إن الخبيب تروحت أثقاله","https://www.aldiwan.net/poem41844.html","الكامل"],[40,"إن الحبيب تروحت أجماله","https://www.aldiwan.net/poem42316.html","الكامل"],[52,"شخوص ولاية كشخوص عزل","https://www.aldiwan.net/poem26730.html","الوافر"],[48,"أكثري أو فأقلي","https://www.aldiwan.net/poem65047.html","مجزوء الرمل"],[50,"أهجرت عبدة أم عداك مسير","https://www.aldiwan.net/poem63827.html","الكامل"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[46,"الحمد لله الذي صاغني","https://www.aldiwan.net/poem23537.html","السريع"],[76,"بكفه ساحر البيان إذا","https://www.aldiwan.net/poem39322.html","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43856","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[31,"إنّ الحبيبَ تروحتْ اثقالهُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19025&r=&rc=288",""],[113,"بلهفة الغرام","https://www.aldiwan.net/poem40481.html","عموديه"],[115,"بقايا جراح","https://www.aldiwan.net/poem24061.html","السريع"],[122,"ما للوشاة وماليه","https://www.aldiwan.net/poem23786.html","مجزوء الكامل"],[196,"أرض منمنمة وظل سجسج","https://www.aldiwan.net/poem51974.html","الكامل"],[219,"الصفو مثل الكمال","https://www.aldiwan.net/poem55249.html","المجتث"],[221,"نحن الأطفال عصب","https://www.aldiwan.net/poem41453.html","عموديه"],[301,"شخصك مذ صار نصب عيني","https://www.aldiwan.net/poem58176.html","مخلع البسيط"],[374,"عهدي برومية الكبرى وقد أخذت","https://www.aldiwan.net/poem59226.html","البسيط"],[429,"شخص معاوي المعي","https://www.aldiwan.net/poem12588.html","مجزوء الكامل"],[429,"أنا من جوارك في أعز مكان","https://www.aldiwan.net/poem12752.html","الكامل"],[451,"لا ترقبوا مني الدموع رخيصة","https://www.aldiwan.net/poem61319.html","الكامل"],[498,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[513,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[513,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[536,"شخص له عجائب لا تحصر","https://www.aldiwan.net/poem47444.html","عموديه"],[536,"يا له حبا اتحد","https://www.aldiwan.net/poem48224.html","عموديه"],[551,"شخصت مذ يوم نادوا بالرحيل على","https://www.aldiwan.net/poem68367.html","البسيط"],[556,"يا صدق القوم عن جمالك قد رووا","https://www.aldiwan.net/poem33584.html","الكامل"],[556,"رأيت خيال الظل أكبر عبرة","https://www.aldiwan.net/poem34333.html","الطويل"],[556,"أنا الهيكل الذاتي لمظهر قدرة","https://www.aldiwan.net/poem34334.html","الطويل"],[556,"صفا ماء الحقيقة فهو صافي","https://www.aldiwan.net/poem34351.html","الوافر"],[556,"شخصت لطلعة وجهك الأشخاص","https://www.aldiwan.net/poem34426.html","الكامل"],[556,"شخصت عيون قلبها مدهوش","https://www.aldiwan.net/poem34429.html","الكامل"],[560,"نادى حمى الملك حسبي عزة وكفى","https://www.aldiwan.net/poem52828.html","البسيط"],[560,"كادت تذوب ثغور البحر من حسد","https://www.aldiwan.net/poem52927.html","البسيط"],[560,"ورد الكتاب فضاع طيب نشره","https://www.aldiwan.net/poem52956.html","الكامل"],[560,"قد طلع البدر من المغرب","https://www.aldiwan.net/poem52981.html","السريع"],[565,"يا كامل الآداب منفرد العلا","https://www.aldiwan.net/poem69736.html","الكامل"],[565,"جد لي ببركارك الذي صنعت","https://www.aldiwan.net/poem69811.html","المنسرح"],[584,"عجبا وطرفك للدماء محلل","https://www.aldiwan.net/poem18008.html","الكامل"]],"verses":[["شَخصُكَ في وَجهِ كُلِّ داجِيَةٍ","ضُحىً وَفي كُلِّ مَجهَلٍ عَلَمُ",0,"م",1,0],["شَخصٌ يُذَكِّرُني فاهُ وَغُرَّتَهُ","شَمسُ النَهارِ وَأَنفاسُ الرَياحينِ",1,"ن",1,0],["شَخْصٌ قَلِيلٌ ظِلُّهُ طَاوِي الحَشَى","يَمْشِي فَلا تَتَوَازَنُ الكَتِفَانِ",2,"ن",1,0],["شَختُ الجُزارِةِ مِثلُ البَيتِ سائِرُهُ","مِنَ المَسوحِ خِدَبٌّ شَوقَبٌ خَشِبُ",3,"ب",1,0],["شِخت فأْذنْ بفراقٍ","وتجهز لانطلاق",4,"ق",1,0],["شَخَصتُ بِروحي حائِراً مُتَطَلِّعاً","إِلى ما وَراءِ البَحرِ أَدنو وَأَستَدني",5,"ي",1,0],["شَخَصَتْ لمَّا رَأَتْ عَيْنُ النُّجُومْ","بَعْثَةَ العُشَّاقْ",6,"ق",1,0],["شَخصُهُ المُزدَرى عِندي وَمَخبَرُهُ المَش","نوءُ قُبحاً وَرَأيُهُ المُستَخَسُّ",7,"س",1,0],["شَخصٌ هُوَ العالَمُ الجُزئِيُّ في سَرَفٍ","وَنَفسُهُ الجَوهَرُ الكُلِّيَّ في عِظَمِ",8,"م",1,0],["شَخصانِ أَفّاكانِ قيلُهُما الخَنا","حَلّا لَدَيكَ مَحَلَّ عَمرِو الزاهِدِ",9,"د",1,0],["شَخصٌ غَضيضُ الطَرفِ مُضَّمِرُ الحَشا","عَبلُ المُدَملَجِ مُشبَعٌ خَلخالُهُ",10,"ل",2,0],["شَخص غَضيض الطَرف مضطم الحَشا","عَبل المدملج مشبع خلخاله",11,"ل",2,0],["شُخوصُ وِلايَةٍ كَشُخوصِ عَزلِ","عَلى دَهشٍ وَعِزٍّ مِثلَ ذُلِّ",12,"ل",1,1],["شَخصُها شَخصٌ قَبيحٌ","وَلَها وَجهٌ مُوَلّي",13,"ي",1,0],["شَخصٌ إِذا التَبَسَت بِعَيني عَينُهُ","حَلَفَ النَواسِكُ أَنَّني مَسحورُ",14,"ر",1,0],["شَخصٌ بِرُؤيَتِهِ مُناهُ وَهَمُّهُ","وَحَديثُهُ في جِدِّهِ وَلِعابِهِ",15,"ب",2,0],["شَخصِيَ هَذا عُرضَةٌ لِلرَدى","وَلَم يَزَل مَعدِنَ عِصيانِ",16,"ن",1,0],["شَختٌ ضئيلٌ لفعلهِ خَطَرٌ","أعظِمْ به في مُلمَّةٍ خَطرا",17,"ر",2,0],["شختُ وَلَو مَرَّ طَرفهُ بي","لَم يَعنِهِ أَنَّهُ حُشاشُ",18,"ش",1,0],["شَخصتْ له الآمالُ تُسرِع خَطْوَها","ودنَا لرُؤيته العدِيدُ الأكْثرُ",19,"ر",1,0],["شَخْصٌ غَضيضُ الطَّرْفِ مُضْطَربُ الحَشَا","عَبْلُ المُدَمْلَجِ مُشْبَعٌ خَلْخَالُهُ",20,"ل",2,0],["شخصك في فؤادي","معزز المقام",21,"م",1,0],["شِخْنا وما شاخَ الهوى بيننا","ولا أرى للغَيِّ عَنَّا بَرَاح",22,"ح",1,0],["شخص الحبيب وذاته","واللّه عندي غالية",23,"ل",3,0],["شَخْتُ الحواشي باسلٌ يومَ الوغى","ضَخم الجَدا طَلْقُ المحيَّا أَبلَج",24,"ج",1,0],["شخص بصير وأعمى","ليسا سواء بحال",25,"ل",1,0],["شَختور مُصَفَّح","عِندي مَدافِع",26,"ع",1,0],["شخصك مذ صار نصب عيني","أثر في مقلتي سهادا",27,"د",2,1],["شخصٌ وليس له أذنٌ ليسمعنا","إذا نَبذنا حياةً كلُّها فان",28,"ن",1,0],["شخص مُعاويُّ المِعِيْ","يُهدي لها طَرفاه زَرْدا",29,"د",2,1],["شخّصتَ ما أولى نداكَ وإن تفض","كرماً عليّ به فما أولاني",30,"ن",2,0],["شخصيتان له توحدتا كما","يتوحد المنظور بالمسموع",31,"ع",1,0],["شخُنا السَّيِّدُ الجَليلُ الرِّفاعِي","من غَدا للرِّجالِ أَعظَمَ سَاقِ",32,"ق",1,0],["شخصت إليك نواظر الأمم التي","ملكتهم لك بيعة وعهود",33,"د",1,0],["شخص الأنام إليه تحت جنازة","خفضت برفعة قدرها الأقدار",34,"ر",1,0],["شخصٌ له عجائبٌ لا تُحصَرُ","ومن عَجيبِ أمرِهِ ما نَذكُرُ",35,"ر",1,1],["شخصُه الفذُّ ذائعُ الص","صيتِ في كلِّ مَا بَلَد",36,"د",1,0],["شَخَصتُ مُذ يَومَ نادَوا بِالرَحيلِ عَلى","آثارِهِم ثُمَّ لَم أَطرَف إِلى أَحَدِ",37,"د",1,1],["شخصوا إلىأنوار ذاتك في الورى","فإذا الجميع عن المغايرة انزووا",38,"و",3,0],["شخوص وأشباح تمر وتنقضي","وليس لها مما قضى الله من واقي",39,"ق",2,0],["شخوصٌ وأشباح تمر وتنقضي","وتفنى جميعاً والمحرك باقي",40,"ي",1,0],["شخوص شاءها فيقال أشيا","بلا شك هناك ولا اختلاف",41,"ف",1,0],["شخصت لطلعة وجهك الأشخاصُ","وتراقصت بطيورها الأقفاصُ",42,"ص",1,1],["شخصت عيونٌ قلبها مدهوشُ","لما تجلت للغيوب عروشُ",43,"ش",1,1],["شخصُ الكَمالِ كأنَّ اللهَ صَوَّرَهُ","من مَعدِنِ اللُّطفِ لا طِيناً ولا خَزَفا",44,"ف",2,0],["شخصُ الخليفةِ بعدَ اللهِ نَحسبُهُ","وبعدَ ذاكَ سعيدٌ أوَّلُ العُمَدِ",45,"د",1,0],["شخَصَتْ لهُ أبصارُ عينِ محبِّهِ","حتى كأنَّ سَوادَها من حِبرِهِ",46,"ر",2,0],["شخصٌ إذا أقبلَ لكنَّهُ","من شخصهِ يَخرُجُ في مَوْكِبِ",47,"ب",1,0],["شَخَصَ الأنامُ إلى جَمَالِكَ فاستعِذْ","مِنْ شَرِّ أَعْيُنِهِم بِعَيْبٍ واحِدِ",48,"د",1,0],["شخصان في شكلٍ واحدٍ قُدرا","ورُكّبا بالعقولِ تركيبا",49,"ب",2,0],["شَخِصَ الأنامُ إِلى جَمالِكَ وَانْثَنُوا","عَنْهُ وَقَدْ أَثْنوا عَلَيهِ وأَجْمَلوا",50,"ل",3,0]]}