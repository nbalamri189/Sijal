{"poems":[[4,"أنبئت أن أبا حنيف","https://www.aldiwan.net/poem21209.html","مجزوء الكامل"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[70,"عشقته أهيف قد","https://www.aldiwan.net/poem42810.html","مجزوء الرجز"],[85,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[28,"لعمرك ما تجزي مفداة شقتي","https://www.aldiwan.net/poem5651.html","الطويل"],[61,"تباعد عن عرسه جعفر","https://www.aldiwan.net/poem51779.html","المتقارب"],[31,"إني وأول ما كلفت بحبها","https://www.aldiwan.net/poem42628.html","الكامل"],[33,"أتضرب ليلى كلما زرت دارها","https://www.aldiwan.net/poem25998.html","الطويل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[99,"لا تحبيني","https://www.poetsgate.com/ViewPoem.aspx?id=196733",""]],"verses":[["فَمَكَثتُ بَعدَهُم وَكُن","تُ بِطولِ صُحبَتِهِم ضَنينا",0,"ن",2,0],["فمٌ كمفسىً ومَفسىً واسعٌ كفمٍ","ومنخرانِ قد اسودَّا من الذَّبَبِ",1,"ب",1,0],["فَمٌ كَأَنَّ الشَهدَ قَد","خالَطَ مِنهُ قَرقَفُه",2,"ف",2,0],["فَمُكِّنت مِنهُ سُيوفُ الهِندِ","وَظَفَر الفِرندُ بِالفِرِندِ",3,"د",1,0],["فَمَكَّنتُ سَيفي مِن ذَواتِ رِماحِها","غِشاشاً وَلَم أَحفَل بُكاءَ رِعائِيا",4,"ي",2,0],["فمكَّنَها من قِيادِ الزُّناةِ","وتُمكِنُه من قِيادِ القِحابِ",5,"ب",1,0],["فَمَكَثنَ حيناً ثُمَّ قُلنَ تَوَجَّهَت","لِلحَجِّ مَوعِدِها لِقاءُ الأَخشَبِ",6,"ب",1,0],["فَمُكرِمُ لَيلى مُكرِمي وَمُهينُها","مُهيني وَلَيلى سِرُّ روحي وَطيبُها",7,"ب",3,0],["فمُكْبِرُكُمْ للّهِ أوّلٌ مُكْبِرٍ","ومُعْظِمُكُمْ للّهِ أوّلُ مُعْظِم",8,"م",1,0],["فَمَكَثْتَ فِي أَعْقَابِ مَا اضْطَلعتْ بِهِ","مِنْ جُهْدِ أَيَّامٍ وسُهدِ ليالِ",9,"ل",1,0],["فمكُسكِ مُشْرِقُ البسماتِ ضاحٍ","ورملُكِ جنَةٌ طابت مُقامَا",10,"م",2,0],["فمُكِ الصغيرً ... أدرتهُ بيدي","وزرعتهُ أزهار ليمون",11,"ن",1,0]]}