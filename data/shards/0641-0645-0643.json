{"poems":[[4,"أنبئت أن أبا حنيف","https://www.aldiwan.net/poem21209.html","مجزوء الكامل"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[70,"عشقته أهيف قد","https://www.aldiwan.net/poem42810.html","مجزوء الرجز"],[85,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[28,"لعمرك ما تجزي مفداة شقتي","https://www.aldiwan.net/poem5651.html","الطويل"],[61,"تباعد عن عرسه جعفر","https://www.aldiwan.net/poem51779.html","المتقارب"],[31,"إني وأول ما كلفت بحبها","https://www.aldiwan.net/poem42628.html","الكامل"],[33,"أتضرب ليلى كلما زرت دارها","https://www.aldiwan.net/poem25998.html","الطويل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[99,"لا تحبيني","https://www.poetsgate.com/ViewPoem.aspx?id=196733",""],[109,"زعموا بأن الواقدي قد اشتكى","https://www.aldiwan.net/poem16540.html","الكامل"],[143,"أرى الشرف الأعلى إليك مسلما","https://www.aldiwan.net/poem11811.html","الطويل"],[147,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[160,"أزلت عن الإسلام ما أوجب الشكوى","https://www.aldiwan.net/poem59202.html","الطويل"],[185,"شهر الصيام بك المهنا","https://www.aldiwan.net/poem14680.html","مجزوء الكامل"],[282,"هب نسيم بالطل مبلول","https://www.aldiwan.net/poem32639.html","المنسرح"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[366,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[377,"بالعقل قد يحوي الفتى الإحياء","https://www.aldiwan.net/poem66965.html","الكامل"],[409,"ألوم الردى كم خضته متعرضا","https://www.aldiwan.net/poem31832.html","عموديه"],[437,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[439,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[567,"اكفنا ياعذول شر لسانك","https://www.aldiwan.net/poem69496.html","الخفيف"],[575,"دع قضب نعمان أو كثبان يبرين","https://www.aldiwan.net/poem2851.html","البسيط"]],"verses":[["فَمَكَثتُ بَعدَهُم وَكُن","تُ بِطولِ صُحبَتِهِم ضَنينا",0,"ن",2,0],["فمٌ كمفسىً ومَفسىً واسعٌ كفمٍ","ومنخرانِ قد اسودَّا من الذَّبَبِ",1,"ب",1,0],["فَمٌ كَأَنَّ الشَهدَ قَد","خالَطَ مِنهُ قَرقَفُه",2,"ف",2,0],["فَمُكِّنت مِنهُ سُيوفُ الهِندِ","وَظَفَر الفِرندُ بِالفِرِندِ",3,"د",1,0],["فَمَكَّنتُ سَيفي مِن ذَواتِ رِماحِها","غِشاشاً وَلَم أَحفَل بُكاءَ رِعائِيا",4,"ي",2,0],["فمكَّنَها من قِيادِ الزُّناةِ","وتُمكِنُه من قِيادِ القِحابِ",5,"ب",1,0],["فَمَكَثنَ حيناً ثُمَّ قُلنَ تَوَجَّهَت","لِلحَجِّ مَوعِدِها لِقاءُ الأَخشَبِ",6,"ب",1,0],["فَمُكرِمُ لَيلى مُكرِمي وَمُهينُها","مُهيني وَلَيلى سِرُّ روحي وَطيبُها",7,"ب",3,0],["فمُكْبِرُكُمْ للّهِ أوّلٌ مُكْبِرٍ","ومُعْظِمُكُمْ للّهِ أوّلُ مُعْظِم",8,"م",1,0],["فَمَكَثْتَ فِي أَعْقَابِ مَا اضْطَلعتْ بِهِ","مِنْ جُهْدِ أَيَّامٍ وسُهدِ ليالِ",9,"ل",1,0],["فمكُسكِ مُشْرِقُ البسماتِ ضاحٍ","ورملُكِ جنَةٌ طابت مُقامَا",10,"م",2,0],["فمُكِ الصغيرً ... أدرتهُ بيدي","وزرعتهُ أزهار ليمون",11,"ن",1,0],["فَمكثر لمكثر وَمُقلل","لِمُقلل لِلرزق وَهُوَ خَزين",12,"ن",1,0],["فَمَكَّنَكَ الإِسلامُ عِزّاً لِأَهلِهِ","فَما زِلتَ لِلإِسلامِ عيداً مُعَظَّما",13,"م",2,0],["فمكّة ذي خير البلاد فديتها","فما طاولتها الشمس يوما ولا النسر",14,"ر",1,0],["فمكر النصارى بالهدى لا تضره","مضرة أهليه إذا كدروا الصفوا",15,"و",2,0],["فمكانُه من علمِهِ","كمكانك المحروسِ مِنّا",16,"ن",2,0],["فَمَكَّنَ السَيفَ مِن مَفارِقِهِ","فَهوَ قَتيلٌ لَم يُبكَ مَطلولُ",17,"ل",1,0],["فمُكثُ ذي الصَداقَه","قدرُ احتلاب الناقَه",18,"ه",1,0],["فَمَكَّنَ اللَهُ مِن صَدرٍ وَمِن عُنُقٍ","مِمَّن يُفارِقُهُ الأَغلالَ وَالعِلَلا",19,"ل",2,0],["فمكارم الأخلاق عنوان الفتى","وبها يصيب مودةً وإخاء",20,"ا",2,0],["فمكروه ما تخشى النفوس من الردى","ألذ وأحلى من حياتي وأعذب",21,"ب",1,0],["فمكارم خطبت كريمة خاطري","وبمثلها لم توصف الكرماء",22,"ا",2,0],["فَمَكَّنَ سيفَ النَّصْرِ فِي عاتِقِ العُلا","وأَثْبَتَ تاجَ المُلْكِ فِي مَفْرِقِ الفَخْرِ",23,"ر",1,0],["فَمَكَانُ الحَبِيْبِ أَكْبَرُ مِنْ أَنْ","أَتَسَلَّى عَن حُبِّهِ بِمَكَانِكْ",24,"ك",1,0],["فمٌ كميمٍ وفيهِ سينُ مُبْتَسمٍ","واضيعةَ العقلِ بين الميمِ والسِينِ",25,"ن",1,0]]}