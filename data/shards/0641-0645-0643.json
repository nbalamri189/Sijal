{"poems":[[4,"أنبئت أن أبا حنيف","https://www.aldiwan.net/poem21209.html","مجزوء الكامل"],[53,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[72,"عشقته أهيف قد","https://www.aldiwan.net/poem42810.html","مجزوء الرجز"],[87,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[30,"لعمرك ما تجزي مفداة شقتي","https://www.aldiwan.net/poem5651.html","الطويل"],[63,"تباعد عن عرسه جعفر","https://www.aldiwan.net/poem51779.html","المتقارب"],[33,"إني وأول ما كلفت بحبها","https://www.aldiwan.net/poem42628.html","الكامل"],[35,"أتضرب ليلى كلما زرت دارها","https://www.aldiwan.net/poem25998.html","الطويل"],[77,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[101,"لا تحبيني","https://www.poetsgate.com/ViewPoem.aspx?id=196733",""],[113,"زعموا بأن الواقدي قد اشتكى","https://www.aldiwan.net/poem16540.html","الكامل"],[147,"أرى الشرف الأعلى إليك مسلما","https://www.aldiwan.net/poem11811.html","الطويل"],[151,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[164,"أزلت عن الإسلام ما أوجب الشكوى","https://www.aldiwan.net/poem59202.html","الطويل"],[189,"شهر الصيام بك المهنا","https://www.aldiwan.net/poem14680.html","مجزوء الكامل"],[287,"هب نسيم بالطل مبلول","https://www.aldiwan.net/poem32639.html","المنسرح"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[371,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[382,"بالعقل قد يحوي الفتى الإحياء","https://www.aldiwan.net/poem66965.html","الكامل"],[415,"ألوم الردى كم خضته متعرضا","https://www.aldiwan.net/poem31832.html","عموديه"],[443,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[445,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[572,"اكفنا ياعذول شر لسانك","https://www.aldiwan.net/poem69496.html","الخفيف"],[580,"دع قضب نعمان أو كثبان يبرين","https://www.aldiwan.net/poem2851.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138378",""],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46516","الرجز"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124685","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125435","الطويل"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96175","الطويل"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119204","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27612","الطويل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120982","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134016","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112638","الرجز"],[3638,"","https://poetry.dctabudhabi.ae/diwan/poem/203036","اللويحاني"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199024","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83138","الرمل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66139","الوافر"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4693,"حماك الله يا بلد السلام","https://www.poetsgate.com/ViewPoem.aspx?id=33402",""],[4755,"فَمُكِ الأَنِيقُ, وخَدُّكِ المُتَوَرِّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=183694",""],[4858,"مرسي والسيسي","https://www.poetsgate.com/ViewPoem.aspx?id=144476",""],[4888,"في ظلِّ مكتبتي","https://www.poetsgate.com/ViewPoem.aspx?id=207731",""],[5189,"مكة","https://www.poetsgate.com/ViewPoem.aspx?id=195284",""],[5425,"يَا طَاعِنَاً ... والمُستَحِيْلُ حِرَابُهُ (جيش العراق)","https://www.poetsgate.com/ViewPoem.aspx?id=198923",""],[5431,"قطوف عشقٍ دانيه!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200580",""],[5703,"صوت السجينة","https://www.poetsgate.com/ViewPoem.aspx?id=206101",""],[5776,"عامُ الأبابيلِ اليمانية...","https://www.poetsgate.com/ViewPoem.aspx?id=203647",""],[402,"في معاليك قام عذر القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=36007",""],[5818,"نفَس الرحمان","https://www.poetsgate.com/ViewPoem.aspx?id=182713",""],[5906,"سَمراء","https://www.poetsgate.com/ViewPoem.aspx?id=188806",""],[6031,"نَبَتْ بي أرضُكُمْ فَرحلْتُ عَنهَا","https://www.poetsgate.com/ViewPoem.aspx?id=46408",""],[6101,"مبتور عدوك / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120280",""],[6102,"زيشان","https://www.poetsgate.com/ViewPoem.aspx?id=184170",""],[402,"في معاليك قام عذر القوافي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=53724&r=&rc=576",""],[2220,"إذا جاءتِ الأرسال من عند مُرسِلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11707&r=&rc=577",""],[572,"أَكْفِنَا يا عَذُولُ شرَّ لسانِكْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9418&r=&rc=275",""]],"verses":[["فَمَكَثتُ بَعدَهُم وَكُن","تُ بِطولِ صُحبَتِهِم ضَنينا",0,"ن",2,0],["فمٌ كمفسىً ومَفسىً واسعٌ كفمٍ","ومنخرانِ قد اسودَّا من الذَّبَبِ",1,"ب",1,0],["فَمٌ كَأَنَّ الشَهدَ قَد","خالَطَ مِنهُ قَرقَفُه",2,"ف",2,0],["فَمُكِّنت مِنهُ سُيوفُ الهِندِ","وَظَفَر الفِرندُ بِالفِرِندِ",3,"د",1,0],["فَمَكَّنتُ سَيفي مِن ذَواتِ رِماحِها","غِشاشاً وَلَم أَحفَل بُكاءَ رِعائِيا",4,"ي",2,0],["فمكَّنَها من قِيادِ الزُّناةِ","وتُمكِنُه من قِيادِ القِحابِ",5,"ب",1,0],["فَمَكَثنَ حيناً ثُمَّ قُلنَ تَوَجَّهَت","لِلحَجِّ مَوعِدِها لِقاءُ الأَخشَبِ",6,"ب",1,0],["فَمُكرِمُ لَيلى مُكرِمي وَمُهينُها","مُهيني وَلَيلى سِرُّ روحي وَطيبُها",7,"ب",3,0],["فمُكْبِرُكُمْ للّهِ أوّلٌ مُكْبِرٍ","ومُعْظِمُكُمْ للّهِ أوّلُ مُعْظِم",8,"م",1,0],["فَمَكَثْتَ فِي أَعْقَابِ مَا اضْطَلعتْ بِهِ","مِنْ جُهْدِ أَيَّامٍ وسُهدِ ليالِ",9,"ل",1,0],["فمكُسكِ مُشْرِقُ البسماتِ ضاحٍ","ورملُكِ جنَةٌ طابت مُقامَا",10,"م",2,0],["فمُكِ الصغيرً ... أدرتهُ بيدي","وزرعتهُ أزهار ليمون",11,"ن",1,0],["فَمكثر لمكثر وَمُقلل","لِمُقلل لِلرزق وَهُوَ خَزين",12,"ن",1,0],["فَمَكَّنَكَ الإِسلامُ عِزّاً لِأَهلِهِ","فَما زِلتَ لِلإِسلامِ عيداً مُعَظَّما",13,"م",2,0],["فمكّة ذي خير البلاد فديتها","فما طاولتها الشمس يوما ولا النسر",14,"ر",1,0],["فمكر النصارى بالهدى لا تضره","مضرة أهليه إذا كدروا الصفوا",15,"و",2,0],["فمكانُه من علمِهِ","كمكانك المحروسِ مِنّا",16,"ن",2,0],["فَمَكَّنَ السَيفَ مِن مَفارِقِهِ","فَهوَ قَتيلٌ لَم يُبكَ مَطلولُ",17,"ل",1,0],["فمُكثُ ذي الصَداقَه","قدرُ احتلاب الناقَه",18,"ه",1,0],["فَمَكَّنَ اللَهُ مِن صَدرٍ وَمِن عُنُقٍ","مِمَّن يُفارِقُهُ الأَغلالَ وَالعِلَلا",19,"ل",2,0],["فمكارم الأخلاق عنوان الفتى","وبها يصيب مودةً وإخاء",20,"ا",2,0],["فمكروه ما تخشى النفوس من الردى","ألذ وأحلى من حياتي وأعذب",21,"ب",1,0],["فمكارم خطبت كريمة خاطري","وبمثلها لم توصف الكرماء",22,"ا",2,0],["فَمَكَّنَ سيفَ النَّصْرِ فِي عاتِقِ العُلا","وأَثْبَتَ تاجَ المُلْكِ فِي مَفْرِقِ الفَخْرِ",23,"ر",1,0],["فَمَكَانُ الحَبِيْبِ أَكْبَرُ مِنْ أَنْ","أَتَسَلَّى عَن حُبِّهِ بِمَكَانِكْ",24,"ك",1,0],["فمٌ كميمٍ وفيهِ سينُ مُبْتَسمٍ","واضيعةَ العقلِ بين الميمِ والسِينِ",25,"ن",1,0],["فمكارم الاخلاق قد خلقت له","والجد والاقدام مع عالي الهمم",26,"م",1,0],["فمكثت حائرة مذبذة","بهمها بينهما معذبه",27,"ه",1,0],["فمك الشهي مرّغتهُ","بالطيب من شفة الجمال",28,"ل",1,0],["فمكنت منه الوجدَ يكوى صَميمه","ولم ترحمي أنات قلبٍ شاكِ",29,"ك",1,0],["فمكنته من أهل دنيا وأرضها","ففاز بما يهوى وفوق الذي يهوى",30,"ا",1,0],["فمكان قائم سيفه عكازه","ومكان ما يتمنطق الزنار",31,"ر",1,0],["فمكري كمر الله إنْ كنت عالماً","فمهما تشا فأمر فؤادي يفعل",32,"ل",1,0],["فمكذب ومؤول ومحير","ما ذاق طعم حلاوة الايمان",33,"ن",1,0],["فمكارمٌ آثارها مأثورةٌ","برّزت فيها سابق الأمجادِ",34,"د",1,0],["فَمَكَّةٌ عشرونَ ثمَّ واحدُ","والطولُ ستُّونَ وَسَبعٌ زايدُ",35,"د",1,0],["فمكارم الأخلاق منك سماتها","حسن القبول يلوح للمتعشم",36,"م",1,0],["فمكنَ اللَهُ بريراً التقي","من قتلِ ذاك الفاسقِ الرجسِ الشقي",37,"ي",1,0],["فمكاننا به طهر","خلا من العار والرجس",38,"س",1,0],["فمكثا مقدار ربع يوم","وأهبطا منها هبوط لوم",39,"م",1,0],["فمكث ذا الصداقة","قدر احتلاب الناقه",40,"ه",1,0],["فَمُك الكاسُ فَهاتِي نَصطَبِح","مِن سُلافٍ لَذَّةٍ لِلشارِبينا",41,"ن",2,0],["فَمَكَّةُ في جِوارِ الله دارِي","ولِي فيها كما لِلناسِ بَيتُ",42,"ت",1,0],["فَمُكِّنتُ مِن مُلكِ الغَرامِ وَها أَنا","مَليكٌ وَسَيفي بِالصبابَةِ قاطِعُ",43,"ع",1,0],["فمكة قبلة الإسلام مهوى","لحجاج الى البيت الحرام",44,"م",1,0],["فَمُكِ الأَنِيقُ, وخَدُّكِ المُتَوَرِّدُ","وجَبِينُكِ المُتَوَهِّجُ المُتَجَرِّدُ",45,"د",1,1],["فمكرتمُ , لكنّ مكرَ اللهِ أكبرُ","يا شياطينَ الهوى , فهو القدير",46,"ر",1,0],["فمَكتبتي كمِصباحٍ","تُضيءُ كَزَيْتِهِ الكُتُبُ",47,"ب",1,0],["فمكّةَ تلتقي فيها البرايا","وتَجتمعُ الأُ خُوَّةُ والكرامُ",48,"م",1,0],["فَمُكَلَّلٌ بَيْنَ الرِفَاقِ مُمَجَّدٌ","أَو خَالِدٌ قَادَ النُجُومِ دَلِيْلا",49,"ل",2,0],["فمك المجاز إذا تأوّه وجده","صارت عناقيد الكروم سواقيهْ",50,"ي",2,1],["فمك اشتهاءات الشتاء زوابعا","تجتاحه وتهزّ عرشكَ لاهيه!",50,"ي",2,0],["فمَكانكَ المهْجورُ يَسْقيني الأَسى","من طُولِ فقدِكَ قد كَساهُ غُبارُ",51,"ر",1,0],["فمكّنتنا كي نحشرَ اليوم حشدَهم","أآلاتهم تكسو الذي كانَ عاريا",52,"ي",2,0],["ف مكان به يد البر تجلو رأفة الله بالمراض الضعاف","بارك الله في نوابغ طب شأنهم فيه ليس شأن احتراف",53,"ف",1,0],["فَمُكِ الذي يُغري.. خَضَاركِ .. صُفرتي","دَمُكِ الذي يجري ب أوردةِ البدَنْ",54,"ن",1,0],["فَمَكاني في الأََرضِ مَلَّ وُجودي","وأَنا مِن كَمِّ الهَوى مُستاءُ",55,"ا",2,0],["فَمكَّةُ وهي أشْرَفُ كُل أْرْضٍ","تحمَّلَ ظَاعِناً عَنهَا الرَّسُولُ",56,"ل",1,0],["فمكِّن أمة الإسلام تصحو","ويحييها بلاء وامتحان",57,"ن",1,0],["فَمَكَثْتُ , مَا أَدْرَكْتُ مِنْ فَمِها","إِلَّا - بِنَفْحِ اليَاسَمِينِ - صَبا",58,"ب",2,0],["ف مكان به يد البر تجلو","رأفة الله بالمراض الضعاف",59,"ف",1,0],["فمكري مكرُ اللهِ إنْ كنتَ عالماً","فمهما تشا فأمر فؤادي يفعل",60,"ل",1,0],["فمكان الحبيبِ أكثَرُ من أَن","أتسلَّى عن حُبّهِ لمكانكْ",61,"ك",1,0]]}