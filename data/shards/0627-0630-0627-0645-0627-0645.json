فلسطيني خاص جدًّا","https://www.poetsgate.com/ViewPoem.aspx?id=205045",""],[5700,"أُحِبُّ الله","https://www.poetsgate.com/ViewPoem.aspx?id=191216",""],[5790,"سلوا أجفانه الكحلا","https://www.poetsgate.com/ViewPoem.aspx?id=112107",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5855,"بوادر دمعك ما تنزف","https://www.poetsgate.com/ViewPoem.aspx?id=186553",""],[5906,"فجور طيف","https://www.poetsgate.com/ViewPoem.aspx?id=188072",""],[6093,"فَلْسَفَةُ المَوتِ","https://www.poetsgate.com/ViewPoem.aspx?id=179845",""],[6093,"مِيْراثُ الجَمِيعِ","https://www.poetsgate.com/ViewPoem.aspx?id=185309",""],[6106,"بين نهرين : د . جهاد ، د . سمير","https://www.poetsgate.com/ViewPoem.aspx?id=6314",""],[199,"لَعَمْرِي لَقَدْ أَصْحَرَتْ خَيْلُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=20782",""],[6237,"إفاقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77866&r=&rc=8",""],[6259,"أبان لنا من دره يوم ودّعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59387&r=&rc=35",""],[6350,"إذا ما متُّ فادفني بِوعْسَاء سَهلة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24091&r=&rc=4",""]],"verses":[["إِذا ما مَطَلناهُنَّ بُقيا عَليكُمُ","خَرَجنَ خُروجَ الخالِعينَ النَواكِثِ",0,"ث",1,0],["إِذا ما مَطاياهُ جُبنَ الفَلا","أَمِنّا عَليها الوَجى وَاللُغوبا",1,"ب",2,0],["إذا ما مَخَضْتَ الرّأيَ والخَطْبُ عاقِدٌ","نَواصيَهُ بانَ الصّريحُ منَ الرُّغا",2,"غ",2,0],["إِذا ما مَشَوا في السابِغاتِ حَسِبتَهُم","سُيولاً وَقَد جاشَت بِهِنَّ الأَباطِحُ",3,"ح",1,0],["إِذا ما مُنادي الحَيِّ نادى أَجَبتُهُ","وَخَيلُ المَنايا بِالجَماجِمِ تَعثُرُ",4,"ر",1,0],["إِذا ما مَضى هَذانِ عَنّي بِلَذَّتي","فَما أَنا في الدُنيا لِعَيشٍ بِصاحِبِ",5,"ب",1,0],["إِذا ما مَشَت شِبراً مِنَ الأَرضِ أَرجَفَت","مِنَ البُهرِ حَتّى ما تَزيدُ عَلى شِبرِ",6,"ر",1,0],["إِذا ما مَرَّ بِالبَأساءِ عامٌ","أَطَلَّ عَلَيهِ بِالبَأساءِ عامُ",7,"م",1,0],["إِذا ما مَشَت بينَ البُيوتِ تَخَزَّلَت","وَمالَت كَما مالَ النَزيفُ المُرَنَّحُ",8,"ح",1,0],["إِذا ما مَطَوتُ النُسعَ في دَفِ حُرَّةٍ","يَمانِيَةٍ تَطوي البِلادَ الفَيافِيا",9,"ي",2,0],["إذا ما مصر في المال استقلّت","فلا تخشى التأخّر في السياسه",10,"ه",1,0],["إِذا ما مَشَت لَم تَنتَهِز وَتَأَوَّدَت","كَما اِنآدَ مِن خَيلٍ وَجٍ غَيرُ مُنعَلِ",11,"ل",1,0],["إِذا ما مالَ يُرعِبُني","أَخافُ عَلَيهِ يَنقَصِفُ",12,"ف",1,0],["إِذا مامَرَرتَ بِأَهلِ القُبورِ","تَيَقَّنتَ أَنَّكَ مِنهُم غَدا",13,"ا",1,0],["إِذا ما مَشوا في السابِغاتِ كَأَنَّها","هَزيمٌ مِنَ الرَعدِ المُجَلجِلِ يَزأَرُ",14,"ر",1,0],["إذا ما مددت لحاظ اليراع","أنمتَ السيوف وأجفانها",15,"ن",3,0],["إذا ما مدحتُ المرءَ يوماً ولم يُثِبْ","مديحي وحقُّ الشعرِ في الحكم واجبُ",16,"ب",1,1],["إذا ما مدحتَ أبا صالح","فأَعدِدْ له الشتم قبل المديحِ",17,"ح",1,1],["إذا ما مشى عمرو ولجّ اضطرابه","فعيناه في شطرٍ ورجلاه في شطر",18,"ر",1,0],["إذا ما مدَحْتَ المرءَ تطلب رفدَه","ولم تَرج فيه الخيرَ إلا بِذَلكا",19,"ك",2,1],["إذا ما مدحتَ الناقصين فإنما","تُذكّرهم ما في سواهم من الفضلِ",20,"ل",1,1],["إِذا ما مَصايِيفُ القَطا قَرَبَت بِهِ","مِنَ القَيظِ أَدناها السُرى وَهيَ لُغَّبُ",21,"ب",1,0],["إِذا ما مَشَت تَهتَزُّ لا أَحمَرِيَّةٌ","وَلا نَصَفٌ تَطَنُّ مِن جِسمِها دَخلا",22,"ل",2,0],["إِذا ما مَشَت مالَت رَوادِفُها بِها","جَميعاً كَما مالَ المَهيضُ مِنَ الكَسرِ",23,"ر",1,0],["إِذا ما مَرَّ ذِكرُكَ بَينَ قَومٍ","رَأَيتَ أَشَدُّهُم عِيّاً فَصيحا",24,"ح",2,0],["إِذا ما مُتُّ فَاِندُبني","فَرُبَّ أَخٍ أَخاً نَدَبا",25,"ب",2,0],["إِذا ما مَسَّ تُرباً عادَ مِسكاً","وَنافَسَ تَحتَهُ الذَهَبَ الرَغامُ",26,"م",1,0],["إِذا ما مشَى في سمعِه العذلُ مجَّهُ","كما طردَ النومَ الجبانُ المفزَّعُ",27,"ع",1,0],["إِذا ما مَشى بَينَ الصُفوفِ تَقاصَرَت","رُؤوسُ الرِجالِ عَن طِوالٍ سَميدَعِ",28,"ع",1,0],["إِذا ما مَشَت في جانِبَيكِ بِأَوجُهٍ","تَهَضَّمُ أَقمارَ الدُجى وَتَضيمُها",29,"م",3,0],["إذا ما مضى صَدْرُ النَّهارِ بسَيلِه","تولَّى وأبقى آخرَ اللَّيلِ مَربَعا",30,"ع",2,0],["إِذا ما مَضى القَرنُ الَّذي كُنتَ فيهِم","وَخُلِّفتَ في قَرنٍ فَأَنتَ غَريبُ",31,"ب",1,0],["إِذا ما مَشى يَوماً عَلى الرَأسِ موحِياً","إِلى مَلِكٍ وافى عَلى الرَأسِ ماشِيا",32,"ي",2,0],["إِذا ما مَشَت بَينَ أَترابِها","كَمِثلِ الإِراخِ يَطَأنَ الوَحَل",33,"ل",1,0],["إذا ما مصرُ زُلزِلَ جانباها","فَمِن خَفَقانِ قلبِكَ والوجيبِ",34,"ب",1,0],["إِذ أَمامي يَدفَعُ الحادِثُ عَن","ني المَليكُ الكامِلُ البَأسِ المَنيعُ",35,"ع",1,0],["إِذا ما مَشَت هَزَّت قَضيباً عَلى نَقاً","كَهَزِّ نَسيمِ الغُصنِ رَيحانَهُ غَضّا",36,"ض",2,0],["إذا ما مَدحناكم تضَوّعَ بيننا","وبينَ القوافي من مَكارمكم طيب",37,"ب",1,0],["إِذا ما مَرَّ مُلتَفِتاً","رَآني خَلفَهُ ذَنَبا",38,"ب",2,0],["إِذا ما مَشى يَهتَزُّ مِن دونِ نَحرِهِ","وَأَعطافِهِ مِنهُ إِلى مُنتَهى الخَصرِ",39,"ر",1,0],["إِذا ما مَضى نَفَسٌ فَإِحسَبنَهُ","كَالخَيطِ مِن ثَوبِ عُمرٍ نَهَج",40,"ج",1,1],["إذا ما مات منها فيهِ قسم","يجيء مكانه قسم جديد",41,"د",1,0],["إِذَا مَا مَشَى هَذَا الشَّرَارُ بِلِمَّةٍ","فَمَا هِيَ إِلاَّ فَحْمَةٌ سَتَذُوبُ",42,"ب",1,0],["إذا ما مضى يَومٌ منَ البِشْرِ مُسْفِرٌ","أتى بعدَه يَومٌ من النَّقْعِ أقْتَمُ",43,"م",1,0],["إذا ما مشى فوقَ الشوك القَتاد","غدا تحته سندُسًا أخضرا",44,"ر",2,0],["إذا ما مشى قُدمًا في الطريق","فلن يتلفَّتَ نحو الوراء",45,"ا",2,0],["اذا ما مشى بزّ المفارقَ مَفرِقٌ","بتاجٍ من النصرِ المبين مُكلَّل",46,"ل",1,0],["إذا ما مخضتَ نفوسَ الرجالِ","من الأقربين إلى الأبعد",47,"د",1,0],["إذا مَا مَشَى بَينَ الصّفُوفِ تَقَاصرَتْ","رُؤوسُ الرّجالِ عن طُوَالٍ سَمَيْذَعِ",48,"ع",1,0],["إذا ما مصاييف القطا قربتْ بهِ","من القيظِ أداها السرى وهي لغّبُ",49,"ب",1,0],["إذا ما مضى منهم إمامُ هدى ً أتى","إمامُ هدى ً يدعو إلى الله راشدُ",50,"د",1,0],["إِذا ما مَضَت زُمَرٌ مِن لُهاكَ","تَلَتها وَأَربَت عَلَيها زُمَر",51,"ر",1,0],["إِذا ما مُلوكُ الأَرضِ تيهاً تَرَفَّعوا","كَفاكَ عُلُوُّ القَدرِ أَن تَتَرَفَّعا",52,"ع",2,0],["إِذا ما مُلوكُ الأَرضِ تيهاً تَعَظَّموا","كَفاكَ عَظيمُ القَدرِ أَن تَتَعَظَّما",53,"م",2,0],["إذا ما مشى يتْبعنهُ عندَ خطْوهِ","عيوناً مِراضاً طرْفُهنَّ روانِيا",54,"ي",2,1],["إذا ما مشى الضرير الكلب أزرى","عليه الكلب في كل الأمور",55,"ر",1,0],["إِذا ما مُنافِقُ أَهلِ العِرا","قِ عوتِبَ يَوماً فَلَم يُعتَبِ",56,"ب",1,0],["إذا ما مزجت الراح بالماء أخمدت","لحا اللَه من للراح بالماء يقتل",57,"ل",1,0],["إذا ما ملوكُ الأرِض سامَتْك في العلا","فَضَلتْهَمُ فَضْلَ الهلال على النسر",58,"ر",1,0],["إذا ما مرَرنا حيثُ مرَّت حبيبةٌ","وحيثُ رأيناها وحيثُ استقرّت",59,"ت",1,0],["إِذا ما مستَ عُجباً هَزَّ رُمحاً","يُسَدِّدُهُ لِيَطعَنَني القَوامُ",60,"م",1,0],["إِذا ما مَشَوا خَلفَهُم خِلتَهُم","ظِباءَ الأَجارِعِ خَلفَ التُيوسِ",61,"س",1,0],["إِذا ما مَشَت يَنسابُ في التُربِ خَلفَها","أَساوِدُ من تِلكَ الضَفائِرِ سُودُ",62,"د",1,0],["إذا ما ماسَ يخطُر في","حُلاه فعشقُه خَطَرُ",63,"ر",1,0],["إذا ما مس قصراً مشمخرّاً","هوى فأحاله رسماً محيلا",64,"ل",2,0],["إِذا ما مَزَجناها بلطفِ طباعِ من","يَجودُ بِها عذباً نسيلُ بها لطفا",65,"ف",2,0],["اذا ما مَشَت نادى بما في ثِيابها","ذكِيُّ الشذا والمَندَليّ المطَيَّرُ",66,"ر",1,1],["إذا ما مثَّلَتْ قَوساً وسَهماً","وناضَل في العُلا بِهما نِضالا",67,"ل",2,0],["إذا ما مَدَّةٌ لك من دَواةٍ","أتَتْ طَرْفاً كفَتْ حَرْباً سِجالا",67,"ل",2,0],["إذا ما مدحْناهمُ لم يُوقَظوا كرَماً","وإن تركْناهمُ ناموا على حَنَق",68,"ق",1,0],["إذا ما مَذحِجٌ قذفت عليها","سرابيلاً لها من كلِّ سَردِ",69,"د",1,0],["إِذا ما مَشى ماشٍ إِلَيكَ بِحاجَةٍ","فَدَع قَولَهُم يَمشي وَقُل هُوَ طائِرُ",70,"ر",1,0],["إذا ما معانيهِ طالَت فما","يضرُّك إلا تطول العبارَه",71,"ر",2,0],["إذا ما مضى يَومٌ ولم أَصْطَنِعْ يَداَ","ولم أقتبِسْ عِلماً فما هُوَ مِن عُمْري",72,"ي",1,0],["إِذا ما مدحت ابن الحسين بِوَصفِهِ","أَو البعض منه جِئتُ بِالمَدح أَجمعا",73,"ع",2,0],["إذا ما مال نحو الحقّ يوماً","أمالته الوَساوِسُ إذ يجور",74,"ر",1,0],["إذا ما ماس أزرى بالعوالي","وكم طَعَنَ الجوانحَ منه قَدُّ",75,"د",1,0],["إذا ما مضى منكم عن المجد سيّدٌ","أقام لكم في موقف الفخر سيّدا",76,"د",2,0],["إذا ما مضى عنا مصاب أهالَنا","دهانا مصاب بعده ومصاب",77,"ب",1,0],["إذا ما مضى ردّ القضاء ولم تكن","لتمنع عن غير الولي مظالمه",78,"م",2,0],["إذا ما مسه الفعل آوى لمحسن","أواه وحامى دونه حيث أخرجا",79,"ج",2,0],["إذا ما مسيءٍ لاذ ف جنب محسنٍ","وآب فلم ينكر لماض طباعه",80,"ع",2,0],["إذا ما مات بعضي كيف بعضي","يعيش وهل حراك من سكون",81,"ن",1,0],["إِذا ما مررنا بالمقابر ساعة","نصد لنستبقي السر