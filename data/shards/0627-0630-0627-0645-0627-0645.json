08,"د",2,0],["إذا ما متّ سرّ بني تميم","على الحدثان لو يلقون مثلي",109,"ي",1,1],["إِذا ما مشى فَالأَرض تَهتز خيفة","وَمِنهُ الجِبال الراسيات تَزلزل",110,"ل",1,0],["إِذا ما مَضى بَيتٌ تَلاهُ نَظيرُهُ","سَريعاً وَإِن لَم أَدعُ آخرَ يَلحَقِ",111,"ق",1,0],["إِذا ما مَشَت تَختالُ بَينَ لِداتِها","رَأَيتَ مَلاكَ الدَّجنِ تَكنَفُهُ الزَّهرُ",112,"ر",1,0],["إذَا مَا مَاتَ فِي بَلَدٍ مَجِديٌ","رَثَاهُ الشَّاعِرُ الذَّرِبُ المُجِيدُ",113,"د",1,0],["إذا ما مات في قوم شعور","فما يحييه يوما نفخ صور",114,"ر",1,0],["إذا ما مات كِسرى قامَ كسرى","نعدُّ ثلاثةً مُتَتَابعينا",115,"ن",2,0],["إذا ما ملت هاج بنا عباب","من الأهوال تلتطم التطاما",116,"م",2,0],["إذا ما مشكل ألقاه حبر","تيمم حله بين العصائب",117,"ب",1,0],["اذا ما مَرَّ ذكركَ في لساني","حلا حتىّ حكى طعم السُلافِ",118,"ف",1,0],["إِذا مَا مَاتَ ذُو علم وتقوى","فقد ثلمت من الْإِسْلَام ثلمه",119,"م",2,1],["إِذا ما مَضى نحو غاياتهِ","فَبيض الظبى دونه نابيَه",120,"ي",2,0],["إِذا ما مَشى نَجمٌ أَتَتهُنَّ جُمَّةٌ","فَلا الدَهرُ يُغنيها وَلا الحَقُّ سائِمُ",121,"م",1,0],["إذا ما مشت للحرب تختال في الوغى","نشاوى تهادى بين لدنٍ ومخدم",122,"م",1,0],["إذا ما مشى فيها الفتى بات يزدري","سواها ولم يملأ سواها له جفنا",123,"ن",2,0],["إذا مامسنَ لا متبختراتٍ","فما أَسمَى وحَسْنَا والرّبابا",124,"ب",2,0],["إِذا ما ماسَ قَدٌّ طارَ قَلبي","كما روّعت وُرْقاً عن وَريق",125,"ق",1,0],["إِذا ما ماس من عجبٍ وَتيهٍ","تَرى الأَغصان تومي بِالسُجود",126,"د",1,0],["إذا ما ملوك الأرض همّوا لمفخر","تقدمهم عبد الحميد له وأم",127,"م",1,0],["إِذا ما ماسَ أَو أَومى بِلَحظِ","بَدا مِنهُ المُثَقَّفُ وَالحُسامِ",128,"م",1,0],["إذا ما مسني ظمأ سقاني","تردد ذكره الماء الزلالا",129,"ل",2,0],["إذا ما ملكتَ المالَ مَلَّكْتَهُ الوَرَى","كأَنَّكَ لم تُرْزَقْهُ إلا لِيُرْزَقَا",130,"ق",2,0],["إذا ما مدح الهند","وسهم الهند في المقتل",131,"ل",1,0],["إذا ما مرَّ ذكرُهُمُ بسَمعِي","أكادُ أغصُّ بالعَذبِ الزُّلالِ",132,"ل",1,0],["إذا ما منهم أودى امام","أقام على الهدى علماً إماما",133,"م",2,0],["إذا ما مشت نم الحلي بها كما","ترجع من ذات الجناح هديلها",134,"ل",3,0],["إِذا ما ماسَ يَ