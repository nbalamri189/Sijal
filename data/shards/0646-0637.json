ww.aldiwan.net/poem47757.html","مجزوء الكامل"],[552,"لا تقربن عضيهة","https://www.aldiwan.net/poem48037.html","مجزوء الكامل"],[562,"ورأس أعداء شديد أضمه","https://www.aldiwan.net/poem27859.html","الرجز"],[563,"هذا الضريح لبطرس الشهم الذي","https://www.aldiwan.net/poem52681.html","الكامل"],[568,"نطق الود باللسان الفصيح","https://www.aldiwan.net/poem69741.html","الخفيف"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["نُطَنِّبُ لِلمُقامِ قِبابَ حَيٍّ","وَيَحفِزُنا المَنونُ إِلى الرِحالِ",0,"ل",1,0],["نُطيلُ غَراماً وَالسَلوُّ مُوافِقٌ","وَنُبدي بُكاءً وَالعَزاءُ جَميلُ",1,"ل",1,0],["نَطَقَ اللِسانُ عَنِ الضَميرِ","وَالبِشرُ عُنوانُ البَشيرِ",2,"ر",1,1],["نُطيلُ بِهِ صَدى الجُردِ المُذاكي","إِلى أَن نورِدَ الأَسَلَ الظِماءَ",3,"ا",2,0],["نَطَقَتْ نَواعي اللَّيلِ فاِنصَرَفَتْ","تطأ الدُّجى بِخَلاخِلٍ خُرْسٍ",4,"س",1,0],["نطَقَ الزَّبورُ بفَضْلِهِ المَشْهورِ وال","قُرآنُ والتّوراةُ والإنْجيلُ",5,"ل",1,0],["نُطالِعُ منْ أقْلامِهِ وحُسامِهِ","مَقَرَّ حَياةٍ في مَدَبِّ حِمامِ",6,"م",1,0],["نَطَقَتْ بما يُخْفيهِ قَلْبي أدْمُعي","ولَطالَما صَمَتَتْ عنِ التّصْريحِ",7,"ح",1,0],["نَطَقْتَ فَحُزْتَ الْحُكْمَ فَصْلاً خطَابُهُ","يُقَلَّبُ مِنْ وَشْي الْبَلاغِةِ فِي عَصْبِ",8,"ب",1,0],["نَطَقتُ وَلَم يَعجِز عَليَّ رَوِيُّها","وَلِلقَولِ أَبوابٌ تُرى وَمَخاصِرُ",9,"ر",1,0],["نُطاعِنُ ما تَراخى الناسُ عَنّ","وَنَضرِبُ بِالسُيوفِ إِذا غُشينا",10,"ن",2,0],["نَطعُنُهُم سُلكى وَمَخلوجَةً","كَرَّكَ لَأمَينِ عَلى نابِلِ",11,"ل",1,0],["نَطَقتَ اِبنَ عَمروٍ فَسَهَّلتَها","وَلَم يَنطِقِ الناسُ أَمثالَها",12,"ل",3,0],["نَطَّافُ سُحْبِ وَلَكِنْ لاَ يُخَالِطُهَا","عَوَارِضُ الْبَرْقِ وَالأَرَعَادِ في السُّحُبِ",13,"ب",1,0],["نطقت تهنيّ","وخاطري قد جال",14,"ل",1,0],["نطف من النور المبين تجَسَّمتْ","حتى حسبنا َنَّهنَّ هداكا",15,"ك",2,0],["نطقت ببطل القول تهذي ممخرقّاً","ومثلك من يهذي وينطق بالبطل",16,"ل",1,0],["نَطَحَ الرُؤوسَ بِهامَةٍ فَتَفَرَّقوا","عَنها وَعَظمُ فَراشِها لَم يُهزَمِ",17,"م",1,0],["نطعم الجيألَ اللهيدَ من اللحم","ولم ندعُ من يُشيط الجزورا",18,"ر",2,1],["نَطَقتُ بِفَضلي وَاِمتَدَحتُ عَشيرَتي","وَما أَنا مَدّاحٌ وَلا أَنا شاعِرُ",19,"ر",1,0],["نُطيعُ فَعالَ الشَيخِ مِنّا إِذا سَما","لِأَمرٍ وَلا نَعيا إِذا الأَمرُ أَعضَلا",20,"ل",2,0],["نطقتني ورفعتني بمكارمٍ","خفضت لديَّ وأخرست من حسّد",21,"د",1,0],["نطقَ الزمان به وكلٍّ مفاخر","كلمٌ على لسنِ الزمان مجمجم",22,"م",1,0],["نطقت وابتسمت عن جوهرٍ","ياله في فمها من معدن",23,"ن",1,0],["نطُفت فلو ماسسْت كعبة مكةٍ","بثوبك حاضت حيضة لا تطهَرُ",24,"ر",1,0],["نَطَقتْ بناتُ اللهو فيه معاً","من بعد خفض الصوتِ والهمس",25,"س",1,0],["نطقْتَ بحق ساعدته بلاغةٌ","وفي الناس هادٍ حين يسري وخابِطُ",26,"ط",1,0],["نطقْتَ بحكمةٍ جلَّى سناها","عن المعنى اللطيفِ دُجى الظلامِ",27,"م",1,0],["نُطيفُ ببَحْرٍ لهُ زاخرٍ","ونأوي إلى جبلٍ عاصمِ",28,"م",1,0],["نَطَقتَ فَلَم تُحسِن وَلَم تَبقَ ساكِتاً","لَقَد فاتَكَ الأَمرُ الَّذي كانَ أَحسَنا",29,"ن",2,0],["نُطُفٌ يُجمّلُها فَقاقِعُ مِنهُ ما","جَمَدَت لِتَحفَظ جِسمَ ما لَم يَجمَدِ",30,"د",1,0],["نطقت حشاشة محسن تتبرم","حتى اذا سكتت ونى نطق الدم",31,"م",1,1],["نَطوي دُجاهُ بِجُرحٍ مِن فُراقِكُمو","يَكادُ في غَلَسِ الأَسحارِ يَطوينا",32,"ن",2,0],["نَطوي إِلَيكَ دُجى اللَيا","لي وَالدُجى عَنّا يَذود",33,"د",1,0],["نُطقي هَوىً وَصَبابَةٌ","وَحَديثُها وَتَرٌ وَعود",33,"د",1,0],["نَطِقٌ إِذا حَطَّ الكَلامُ لِثامَهُ","أَعطى بِمَنطِقِهِ القُلوبَ عُقولا",34,"ل",2,0],["نَطَقَت بِسُؤدُدِكَ الحَمامُ تَغَنِّياً","وَبِما تُجَشِّمُها الجِيادُ صَهيلا",34,"ل",2,0],["نَطرُدِ الهَمَّ بِاِصطِباحِ ثَلاثٍ","مُترَعاتٍ تُنفى بِهِنَّ الكُروبُ",35,"ب",1,0],["نَطَقتُ فَأَقحَمتُ الأَعادي وَلَم يَكُن","لِيُفحِمَني جُمهورُهُم حينَ يَنطِقُ",36,"ق",1,0],["نُطيفُ بِطَلقِ الوَجهِ لا مُتَجَهِّمٍ","عَلَينا وَلا نَزرَ العَطاءِ جَهامِ",37,"م",1,0],["نُطالِبُ بِشراً بِسُقيا المُدا","مِ وَبِشرٌ يُطالِبُنا بِالثَمَن",38,"ن",1,1],["نَطوي اللَّيالَي عِلْمَاً أن سَتَطوِينا","فشَعشِعِيها بماءِ المُزنِ واسقِينا",39,"ن",2,1],["نَطَأُ الصَّفيحَ عليهمُ ووراءَه","مثلُ الصَّفائحِ مُنجِبونَ كِرامُ",40,"م",1,0],["نَطَقَت بِفضلِ أبي شُجاعٍ آيةٌ","وَسَمَت مَفاوزَ أرضِه بجَداولِ",41,"ل",1,1],["نطرُقُ من حِيتانِهِ","صَيدَ حِجابٍ ما طُرِقْ",42,"ق",1,0],["نَطوي على المَدحِ الصُّدورَ وإنما","تُطْوى على أمثالِ يُمْنَةِ عَبْقَرِ",43,"ر",1,0],["نَطَقَت بَنو أَسَدٍ وَلَم تَجهَر","وَتَكَلَّمَت خَفياً وَلَم تَظهَر",44,"ر",1,1],["نُطيعُ رِماحاً فَوقَهُنَّ أَهِلَّةً","وَكُثبانَ رَملٍ فَوقَهُنَّ غُصونُ",45,"ن",1,0],["نُطفَةُ كَرمٍ فُوَيقَها حَبَبٌ","كَأَنَّهُنَّ الرَضابُ وَالشَنَبُ",46,"ب",1,0],["نطولُ من ساعات أفْراحهِ","بالسّعْد ما يقصرُ عنه الأنام",47,"م",1,0],["نَطَقَت مُقلَةُ الفَتى المَلهوفِ","فَتَشَكَّت بِفَيضِ دَمعٍ ذَروفِ",48,"ف",1,1],["نَطَقَ الجَمالُ بِعُذرِ عاشِقِهِ","لِلعاذِلاتِ فَأُخرِسَ الوَعظُ",49,"ظ",1,0],["نُطتُ هَمّي مِنهُ بِهِمَّةِ قَرمٍ","ثَقَّلَت وَطأَتي عَلى الأَيّامِ",50,"م",1,0],["نُطنِبُ كَيفَ شينا","فيهِ وَلَم نُحابِه",51,"ب",2,0],["نَطَقَتْ مَدَامِعُهُ بِسِرِّ ضَمِيرِهِ","وَذَكَتْ جَوَانِحُهُ بِنَارِ غَرَامِهِ",52,"م",2,0],["نُطيعُ من الخليفةِ كلَّ أمرٍ","ونعمل للخلافةِ مُخلصينا",53,"ن",2,0],["نُطيعُ العامِلينَ وَنَفتَديهِم","وَنَنصُرُهُم إِذا اِشتَدَّ الوَعيدُ",54,"د",1,0],["نَطَقَ الشِعرُ حينَ لاحَت وَلِم لا","تَسجَعُ الطَيرُ في رَبيعِ الجَمالِ",55,"ل",1,0],["نُطعِمُها اللَحمَ إِذا عَزَّ الشَجَر","وَالخَيلُ في إِطعامِها اللَحمَ عَسَر",56,"ر",1,1],["نَطَقنَ بِحاجَةٍ وَطَوَينَ أُخرى","كَطَيِّ كَرائِمِ البَزِّ المَصونِ",57,"ن",1,0],["نَطِقُ المَقالَةِ قائِلُ","لِلمُستَكِنّاتِ المَفاصِل",58,"ل",1,0],["نُطقاً وَمَنصَرَةً لِدينِ مُحُمَّدٍ","وَالحَقُّ ذو تَبَعٍ وَذو أَنصارِ",59,"ر",1,0],["نُطفَةٌ ما مُنيتُ يَومَ مُنيتُ","أُمِرَت أَمرَها وَفيها بُريتُ",60,"ت",1,1],["نَطَقَت عَلَيهِ كَرامَةٌ","مَشهورَةُ الحَسَناتِ",61,"ت",1,0],["نَطَقَت مَناطِقُ خَصرِهِ بِصِفاتِهِ","وَاِهتَزَّ غُصنُ البانِ مِن حَرَكاتِه",62,"ت",2,1],["نَطَقَ اللِئامُ فَمَن يَقولُ وَمَن","سُبحانَكَ اللَهُمَّ يا رَبِّ",63,"ب",1,1],["نَطَقَتْ بك السَّبْعُ المثاني ألسُناً","فكَفَيْنَنَا التعريض والتّصْريحا",64,"ح",2,0],["نَطوي لِذاكَ الزَمانِ نَصرِفُهُ","طيباً وَنَشفي بِهِ صَدى الكَمَدِ",65,"د",1,0],["نَطوي بِها الدَهرَ حينَ نُنكِرُهُ","طَيّاً وَنَشفي بِها صَدى الكَمِدِ",66,"د",1,