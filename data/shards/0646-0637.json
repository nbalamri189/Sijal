{"poems":[[53,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[53,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[53,"أيا لله أي هوى أضاء","https://www.aldiwan.net/poem30781.html","الوافر"],[63,"وأوانس تدنو إذا اجتديت","https://www.aldiwan.net/poem45697.html","أحذ الكامل"],[63,"هو طيفها وطروقه تعليل","https://www.aldiwan.net/poem46153.html","الكامل"],[63,"من الركب يا بن العامري أمامي","https://www.aldiwan.net/poem46178.html","الطويل"],[77,"هل كنت تعلم في هبوب الريح","https://www.aldiwan.net/poem36635.html","الكامل"],[77,"أنور سناء لاح في مشرق الغرب","https://www.aldiwan.net/poem36773.html","الطويل"],[42,"أرقت وهاجتني الهموم الحواضر","https://www.aldiwan.net/poem50385.html","الطويل"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[0,"يا دار ماوِية بالحائلِ","https://www.aldiwan.net/poem65.html",""],[10,"ألا ما لعينك أم ما لها","https://www.aldiwan.net/poem21129.html","المتقارب"],[93,"صوت الكنانة في يوبيلك الذهبي","https://www.aldiwan.net/poem9800.html","عموديه"],[83,"فمنهج النصرا","https://www.aldiwan.net/poem54206.html","مخلع البسيط"],[83,"يا خير من ملك الملوك بجوده","https://www.aldiwan.net/poem54266.html","الكامل"],[88,"أ يوسف ما إن أنت من فحل هجمة","https://www.aldiwan.net/poem44392.html","الطويل"],[27,"حي الديار بعاقل فالأنعم","https://www.aldiwan.net/poem5982.html","الكامل"],[37,"نطعم الجيأل اللهيد من اللحم","https://www.aldiwan.net/poem7058.html","الخفيف"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[23,"لك الخير غضي اللوم عني فإنني","https://www.aldiwan.net/poem21238.html","الطويل"],[72,"يا أهل فضل الله إن لبيتكم","https://www.aldiwan.net/poem18556.html","الكامل"],[72,"ربع لعزة صامت لا يفهم","https://www.aldiwan.net/poem19680.html","الكامل"],[72,"بأبي مائسة يثني على","https://www.aldiwan.net/poem20158.html","الرمل"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"قل للأمير إذا مثلت له","https://www.aldiwan.net/poem64651.html","أحذ الكامل"],[51,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[51,"ألا يا زينة الدنيا جميعا","https://www.aldiwan.net/poem66039.html","الوافر"],[51,"تظلّم شِعري إلى القاسمِ","https://www.aldiwan.net/poem66302.html","المتقارب"],[70,"أتقدح فيمن شرف الله قدره","https://www.aldiwan.net/poem42455.html","الطويل"],[78,"لو زرتنا لرأيت ما لم تعهد","https://www.aldiwan.net/poem14051.html","الكامل"],[89,"نطقت حشاشة محسن تتبرم","https://www.aldiwan.net/poem44897.html","الكامل"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[85,"يا غاب بولون ولي","https://www.aldiwan.net/poem63721.html","مجزوء الكامل"],[43,"في الخد أن عزم الخليط رحيلا","https://www.aldiwan.net/poem10125.html","الكامل"],[45,"يوم سبت وعندنا ما كفى الحر","https://www.aldiwan.net/poem10661.html","الخفيف"],[45,"أفي كل دار منك عين ترقرق","https://www.aldiwan.net/poem65183.html","الطويل"],[45,"ألا هل أتاها بالمغيب سلامي","https://www.aldiwan.net/poem65670.html","الطويل"],[45,"نطالب بشرا بسقيا المدام","https://www.aldiwan.net/poem66796.html","الخفيف"],[61,"نطوي الليالي علما أن ستطوينا","https://www.aldiwan.net/poem51410.html","البسيط"],[61,"أسمعتما أن الجبال تضام","https://www.aldiwan.net/poem51425.html","الكامل"],[61,"نطقت بفضل أبي شجاع آية","https://www.aldiwan.net/poem51458.html","الكامل"],[61,"وطيب النشر عبق","https://www.aldiwan.net/poem51526.html","مجزوء الرجز"],[61,"عفر الظباء لدى الكثيب الأعفر","https://www.aldiwan.net/poem51686.html","الكامل"],[49,"نطقت بنو أسد ولم تجهر","https://www.aldiwan.net/poem64211.html","الكامل"],[66,"نعم لقلوب العاشقين عيون","https://www.aldiwan.net/poem38477.html","الطويل"],[66,"وقهوة يجتلى السرور بها","https://www.aldiwan.net/poem39195.html","المنسرح"],[80,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[44,"نطقت مقلة الفتى الملهوف","https://www.aldiwan.net/poem29715.html","الخفيف"],[44,"برعت محاسنه فجل بها","https://www.aldiwan.net/poem30219.html","الكامل"],[44,"أنا في ذمة الكريم سليما","https://www.aldiwan.net/poem30361.html","الخفيف"],[44,"الحسن بن وهب","https://www.aldiwan.net/poem30588.html","مجزوء الرجز"],[87,"ردي الكرى لأراك في أحلامه","https://www.aldiwan.net/poem8244.html","الكامل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"يقول البرق شر مستطير","https://www.aldiwan.net/poem43067.html","الوافر"],[81,"أخذوا موثق العذار على الخد","https://www.aldiwan.net/poem61501.html","الخفيف"],[39,"نطعمها اللحم إذا عز الشجر","https://www.aldiwan.net/poem53706.html","الرجز"],[39,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[17,"نطفة ما منيت يوم منيت","https://www.aldiwan.net/poem1193.html",""],[52,"ولقد غدوت على طمر","https://www.aldiwan.net/poem27191.html","مجزوء الكامل"],[52,"نطقت مناطق خصره بصفاته","https://www.aldiwan.net/poem27214.html","الكامل"],[52,"نطق اللئام فمن يقول","https://www.aldiwan.net/poem27258.html","الكامل"],[75,"هل كان ضمخ بالعبير الريحا","https://www.aldiwan.net/poem69095.html","الكامل"],[50,"غيب جيرانه بذي حمد","https://www.aldiwan.net/poem63926.html","الطويل"],[50,"راحت سليمى تدعوك بالعند","https://www.aldiwan.net/poem63952.html","المنسرح"],[50,"أسعاد جودي لا شفيت سعادا","https://www.aldiwan.net/poem63955.html","الكامل"],[46,"نطيح ولا نطيق دفاع أمر","https://www.aldiwan.net/poem22284.html","الوافر"],[46,"خف دنيا كما تخاف شريفا","https://www.aldiwan.net/poem22360.html","الخفيف"],[46,"ما جدري أمات صاحبه","https://www.aldiwan.net/poem22597.html","المنسرح"],[46,"ذهاب عيني صان الجسم آونة","https://www.aldiwan.net/poem22833.html","البسيط"],[46,"نطقت حيا نيرا فاعذري","https://www.aldiwan.net/poem23416.html","السريع"],[68,"صد حمى ظمئي لماك لماذا","https://www.aldiwan.net/poem1495.html",""],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6821","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42732","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42506","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54815","المنسرح"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67325","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5177","الرمل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10242","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[58,"يا حبذا مقامنا بالكوفة","https://www.poetsgate.com/ViewPoem.aspx?id=22714",""],[90,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[0,"يَا دَارَ مَاوِيّة َ بِالحَائِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=4787",""],[45,"أفي كُلّ دارٍ مِنكَ عَينٌ تَرَقْرَقُ","https://www.poetsgate.com/ViewPoem.aspx?id=32846",""],[45,"قالتِ: الشَّيْبُ بَدا، قلتُ: أجَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=32070",""],[51,"قل للأمير إذا مثلتَ له","https://www.poetsgate.com/ViewPoem.aspx?id=29316",""]],"verses":[["نُطَنِّبُ لِلمُقامِ قِبابَ حَيٍّ","وَيَحفِزُنا المَنونُ إِلى الرِحالِ",0,"ل",1,0],["نُطيلُ غَراماً وَالسَلوُّ مُوافِقٌ","وَنُبدي بُكاءً وَالعَزاءُ جَميلُ",1,"ل",1,0],["نَطَقَ اللِسانُ عَنِ الضَميرِ","وَالبِشرُ عُنوانُ البَشيرِ",2,"ر",1,1],["نُطيلُ بِهِ صَدى الجُردِ المُذاكي","إِلى أَن نورِدَ الأَسَلَ الظِماءَ",3,"ا",2,0],["نَطَقَتْ نَواعي اللَّيلِ فاِنصَرَفَتْ","تطأ الدُّجى بِخَلاخِلٍ خُرْسٍ",4,"س",1,0],["نطَقَ الزَّبورُ بفَضْلِهِ المَشْهورِ وال","قُرآنُ والتّوراةُ والإنْجيلُ",5,"ل",1,0],["نُطالِعُ منْ أقْلامِهِ وحُسامِهِ","مَقَرَّ حَياةٍ في مَدَبِّ حِمامِ",6,"م",1,0],["نَطَقَتْ بما يُخْفيهِ قَلْبي أدْمُعي","ولَطالَما صَمَتَتْ عنِ التّصْريحِ",7,"ح",1,0],["نَطَقْتَ فَحُزْتَ الْحُكْمَ فَصْلاً خطَابُهُ","يُقَلَّبُ مِنْ وَشْي الْبَلاغِةِ فِي عَصْبِ",8,"ب",1,0],["نَطَقتُ وَلَم يَعجِز عَليَّ رَوِيُّها","وَلِلقَولِ أَبوابٌ تُرى وَمَخاصِرُ",9,"ر",1,0],["نُطاعِنُ ما تَراخى الناسُ عَنّ","وَنَضرِبُ بِالسُيوفِ إِذا غُشينا",10,"ن",2,0],["نَطعُنُهُم سُلكى وَمَخلوجَةً","كَرَّكَ لَأمَينِ عَلى نابِلِ",11,"ل",1,0],["نَطَقتَ اِبنَ عَمروٍ فَسَهَّلتَها","وَلَم يَنطِقِ الناسُ أَمثالَها",12,"ل",3,0],["نَطَّافُ سُحْبِ وَلَكِنْ لاَ يُخَالِطُهَا","عَوَارِضُ الْبَرْقِ وَالأَرَعَادِ في السُّحُبِ",13,"ب",1,0],["نطقت تهنيّ","وخاطري قد جال",14,"ل",1,0],["نطف من النور المبين تجَسَّمتْ","حتى حسبنا َنَّهنَّ هداكا",15,"ك",2,0],["نطقت ببطل القول تهذي ممخرقّاً","ومثلك من يهذي وينطق بالبطل",16,"ل",1,0],["نَطَحَ الرُؤوسَ بِهامَةٍ فَتَفَرَّقوا","عَنها وَعَظمُ فَراشِها لَم يُهزَمِ",17,"م",1,0],["نطعم الجيألَ اللهيدَ من اللحم","ولم ندعُ من يُشيط الجزورا",18,"ر",2,1],["نَطَقتُ بِفَضلي وَاِمتَدَحتُ عَشيرَتي","وَما أَنا مَدّاحٌ وَلا أَنا شاعِرُ",19,"ر",1,0],["نُطيعُ فَعالَ الشَيخِ مِنّا إِذا سَما","لِأَمرٍ وَلا نَعيا إِذا الأَمرُ أَعضَلا",20,"ل",2,0],["نطقتني ورفعتني بمكارمٍ","خفضت لديَّ وأخرست من حسّد",21,"د",1,0],["نطقَ الزمان به وكلٍّ مفاخر","كلمٌ على لسنِ الزمان مجمجم",22,"م",1,0],["نطقت وابتسمت عن جوهرٍ","ياله في فمها من معدن",23,"ن",1,0],["نطُفت فلو ماسسْت كعبة مكةٍ","بثوبك حاضت حيضة لا تطهَرُ",24,"ر",1,0],["نَطَقتْ بناتُ اللهو فيه معاً","من بعد خفض الصوتِ والهمس",25,"س",1,0],["نطقْتَ بحق ساعدته بلاغةٌ","وفي الناس هادٍ حين يسري وخابِطُ",26,"ط",1,0],["نطقْتَ بحكمةٍ جلَّى سناها","عن المعنى اللطيفِ دُجى الظلامِ",27,"م",1,0],["نُطيفُ ببَحْرٍ لهُ زاخرٍ","ونأوي إلى جبلٍ عاصمِ",28,"م",1,0],["نَطَقتَ فَلَم تُحسِن وَلَم تَبقَ ساكِتاً","لَقَد فاتَكَ الأَمرُ الَّذي كانَ أَحسَنا",29,"ن",2,0],["نُطُفٌ يُجمّلُها فَقاقِعُ مِنهُ ما","جَمَدَت لِتَحفَظ جِسمَ ما لَم يَجمَدِ",30,"د",1,0],["نطقت حشاشة محسن تتبرم","حتى اذا سكتت ونى نطق الدم",31,"م",1,1],["نَطوي دُجاهُ بِجُرحٍ مِن فُراقِكُمو","يَكادُ في غَلَسِ الأَسحارِ يَطوينا",32,"ن",2,0],["نَطوي إِلَيكَ دُجى اللَيا","لي وَالدُجى عَنّا يَذود",33,"د",1,0],["نُطقي هَوىً وَصَبابَةٌ","وَحَديثُها وَتَرٌ وَعود",33,"د",1,0],["نَطِقٌ إِذا حَطَّ الكَلامُ لِثامَهُ","أَعطى بِمَنطِقِهِ القُلوبَ عُقولا",34,"ل",2,0],["نَطَقَت بِسُؤدُدِكَ الحَمامُ تَغَنِّياً","وَبِما تُجَشِّمُها الجِيادُ صَهيلا",34,"ل",2,0],["نَطرُدِ الهَمَّ بِاِصطِباحِ ثَلاثٍ","مُترَعاتٍ تُنفى بِهِنَّ الكُروبُ",35,"ب",1,0],["نَطَقتُ فَأَقحَمتُ الأَعادي وَلَم يَكُن","لِيُفحِمَني جُمهورُهُم حينَ يَنطِقُ",36,"ق",1,0],["نُطيفُ بِطَلقِ الوَجهِ لا مُتَجَهِّمٍ","عَلَينا وَلا نَزرَ العَطاءِ جَهامِ",37,"م",1,0],["نُطالِبُ بِشراً بِسُقيا المُدا","مِ وَبِشرٌ يُطالِبُنا بِالثَمَن",38,"ن",1,1],["نَطوي اللَّيالَي عِلْمَاً أن سَتَطوِينا","فشَعشِعِيها بماءِ المُزنِ واسقِينا",39,"ن",2,1],["نَطَأُ الصَّفيحَ عليهمُ ووراءَه","مثلُ الصَّفائحِ مُنجِبونَ كِرامُ",40,"م",1,0],["نَطَقَت بِفضلِ أبي شُجاعٍ آيةٌ","وَسَمَت مَفاوزَ أرضِه بجَداولِ",41,"ل",1,1],["نطرُقُ من حِيتانِهِ","صَيدَ حِجابٍ ما طُرِقْ",42,"ق",1,0],["نَطوي على المَدحِ الصُّدورَ وإنما","تُطْوى على أمثالِ يُمْنَةِ عَبْقَرِ",43,"ر",1,0],["نَطَقَت بَنو أَسَدٍ وَلَم تَجهَر","وَتَكَلَّمَت خَفياً وَلَم تَظهَر",44,"ر",1,1],["نُطيعُ رِماحاً فَوقَهُنَّ أَهِلَّةً","وَكُثبانَ رَملٍ فَوقَهُنَّ غُصونُ",45,"ن",1,0],["نُطفَةُ كَرمٍ فُوَيقَها حَبَبٌ","كَأَنَّهُنَّ الرَضابُ وَالشَنَبُ",46,"ب",1,0],["نطولُ من ساعات أفْراحهِ","بالسّعْد ما يقصرُ عنه الأنام",47,"م",1,0],["نَطَقَت مُقلَةُ الفَتى المَلهوفِ","فَتَشَكَّت بِفَيضِ دَمعٍ ذَروفِ",48,"ف",1,1],["نَطَقَ الجَمالُ بِعُذرِ عاشِقِهِ","لِلعاذِلاتِ فَأُخرِسَ الوَعظُ",49,"ظ",1,0],["نُطتُ هَمّي مِنهُ بِهِمَّةِ قَرمٍ","ثَقَّلَت وَطأَتي عَلى الأَيّامِ",50,"م",1,0],["نُطنِبُ كَيفَ شينا","فيهِ وَلَم نُحابِه",51,"ب",2,0],["نَطَقَتْ مَدَامِعُهُ بِسِرِّ ضَمِيرِهِ","وَذَكَتْ جَوَانِحُهُ بِنَارِ غَرَامِهِ",52,"م",2,0],["نُطيعُ من الخليفةِ كلَّ أمرٍ","ونعمل للخلافةِ مُخلصينا",53,"ن",2,0],["نُطيعُ العامِلينَ وَنَفتَديهِم","وَنَنصُرُهُم إِذا اِشتَدَّ الوَعيدُ",54,"د",1,0],["نَطَقَ الشِعرُ حينَ لاحَت وَلِم لا","تَسجَعُ الطَيرُ في رَبيعِ الجَمالِ",55,"ل",1,0],["نُطعِمُها اللَحمَ إِذا عَزَّ الشَجَر","وَالخَيلُ في إِطعامِها اللَحمَ عَسَر",56,"ر",1,1],["نَطَقنَ بِحاجَةٍ وَطَوَينَ أُخرى","كَطَيِّ كَرائِمِ البَزِّ المَصونِ",57,"ن",1,0],["نَطِقُ المَقالَةِ قائِلُ","لِلمُستَكِنّاتِ المَفاصِل",58,"ل",1,0],["نُطقاً وَمَنصَرَةً لِدينِ مُحُمَّدٍ","وَالحَقُّ ذو تَبَعٍ وَذو أَنصارِ",59,"ر",1,0],["نُطفَةٌ ما مُنيتُ يَومَ مُنيتُ","أُمِرَت أَمرَها وَفيها بُريتُ",60,"ت",1,1],["نَطَقَت عَلَيهِ كَرامَةٌ","مَشهورَةُ الحَسَناتِ",61,"ت",1,0],["نَطَقَت مَناطِقُ خَصرِهِ بِصِفاتِهِ","وَاِهتَزَّ غُصنُ البانِ مِن حَرَكاتِه",62,"ت",2,1],["نَطَقَ اللِئامُ فَمَن يَقولُ وَمَن","سُبحانَكَ اللَهُمَّ يا رَبِّ",63,"ب",1,1],["نَطَقَتْ بك السَّبْعُ المثاني ألسُناً","فكَفَيْنَنَا التعريض والتّصْريحا",64,"ح",2,0],["نَطوي لِذاكَ الزَمانِ نَصرِفُهُ","طيباً وَنَشفي بِهِ صَدى الكَمَدِ",65,"د",1,0],["نَطوي بِها الدَهرَ حينَ نُنكِرُهُ","طَيّاً وَنَشفي بِها صَدى الكَمِدِ",66,"د",1,0],["نَطَقَت فَأَنطَقَ ما سَمِعتُ مَدامِعي","عَن كُلِّ ناطِقَةٍ تَقولُ سَدادا",67,"د",2,0],["نطيحُ وَلا نُطيقُ دِفاعَ أَمرٍ","فَكَيفَ يَروعُنا الغادي النَطيحُ",68,"ح",1,1],["نَطَقَت أَلسُنُ الحِمامِ وَبِالإي","جازِ جاءَت وَكَثرَةِ الإِطنابِ",69,"ب",1,0],["نَطلُبُ نوراً يَلوحُ ساطِعُهُ","وَدونَ ذاكَ الظَلامُ وَالغَدَرُ",70,"ر",1,0],["نُطالِبُ الدَهرَ بِالأَحرارِ وَهُوَ لَنا","مُبينُ عُذرَينِ إِفلاسٍ وَتَفليسِ",71,"س",1,0],["نَطَقتُ حَيّاً نَيِّراً فَاِعذُري","مَن نَطَّقَ النَيِّرَ أَو لومي",72,"م",2,1],["نَطَقَتْ مَناطقُ خَصْرِهِ خَتْماً إذا","صَمْتُ الخواتِم للخناصِرِ آذى",73,"ذ",2,0],["نُطاعِنُ ما تَراخى الناسُ عَنّا","وَنَضرِبُ بِالسُيوفِ إِذا غُشينا",74,"ن",2,0],["نَطَقْتُ بِفَضْلٍ مِنْكَ لَوْلاهُ لَمْ يَدُرْ","لِسَانِي وَلَمْ يَحْفِلْ بِقَوْلِيَ فَاضِلُ",75,"ل",1,0],["نَطِيرُ مَعَ السُّرُورِ إِذَا انْتَشَيْنَا","بِأَجْنِحَةِ الْخَلاعَةِ وَالتَّصَابِي",76,"ب",2,0],["نُطْفَةُ قَطْرٍ عَلَى شَفا أَفُقٍ","مُفَضَّضِ الجَانِبَيْنِ مُنْحَدِرِ",77,"ر",1,0],["نُطِيعُ نَبيَّنَا وَنُطِيعُ ربّاً","هُوَ الرّحمن كانَ بِنَا رَؤُوفَا",78,"ف",2,0],["نَطيحُ فَتُؤخَذَ الثاراتُ مِنّا","وَناطِحُ كُلِّ جَمّاءٍ نَطيحُ",79,"ح",1,0],["نَطلُبُ الأَكثَرَ في الدُنيا وَقَد","نَبلُغُ الحاجَةَ فِها بِالأَقَل",80,"ل",1,0],["نَطَقَ القُرآنُ بِفَضلِ آلِ مُحَمَّدِ","وَوِلايَةٍ لِعَلِيِّهِم لَم تُجحَدِ",81,"د",1,1],["نَطيرُ لِلَّفْظِ نَسْتَجْدِيه مِنْ بَلَدٍ","نَاءٍ وَأَمثْالُهُ مِنَّا عَلَى كَثَبِ",82,"ب",1,0],["نطليك بالأصباغ لو","نجدُ السبيلَ إلى الصعود",83,"د",1,0],["نطرقها جمالنا المعلوفة","عمى صباحاً واسلمي مألوفة",84,"ه",1,0],["\"نُطَوِّفُ ما نُطَوِّفُ ثُم نأوي","الى بيتٍ \" أُقيمَ على \" اقتراح \"",85,"ح",1,0],["نطعنهم سُلكى وملوجة","ً لفتكَ لأمينِ على نابل",86,"ل",1,0],["نَطَقْتُ، فأفحَمتُ الأعادي، وَلم يكن","ليُفحِمَني جُمهُورُهمْ، حينَ َينْطِقُ",87,"ق",1,0],["نَطلُبُ الأكثرَ في الدّنيا، وَقَدْ","نَبْلُغُ الحَاجَةَ فيها بالأقَلّ",88,"ل",1,0],["نَطَقتْ بناتُ اللهو فيه معاً","من بعض خفض الصوتِ والهمسِ",89,"س",1,0]]}