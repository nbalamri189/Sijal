/www.poetsgate.com/ViewPoem.aspx?id=190744",""],[5431,"أنين شوق....","https://www.poetsgate.com/ViewPoem.aspx?id=191398",""],[5431,"زندقة!..","https://www.poetsgate.com/ViewPoem.aspx?id=194763",""],[5431,"وبمثله هو يقتدي العظماء","https://www.poetsgate.com/ViewPoem.aspx?id=194798",""],[5431,"سيقودني للغيم تحشيشُ....","https://www.poetsgate.com/ViewPoem.aspx?id=200263",""],[5431,"على لسان شاعر!...","https://www.poetsgate.com/ViewPoem.aspx?id=205607",""],[3294,"قد بت طول الليل ساهر","https://www.poetsgate.com/ViewPoem.aspx?id=173268",""],[5436,"موال حب للعراق(للشاعرجميل حسين الساعدي)","https://www.poetsgate.com/ViewPoem.aspx?id=138980",""],[5457,"صرخة السمجد الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=214567",""],[5458,"الحب قوة","https://www.poetsgate.com/ViewPoem.aspx?id=71979",""],[5510,"غزل الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=205752",""],[5512,"أنا السُّوري","https://www.poetsgate.com/ViewPoem.aspx?id=205024",""],[5587,"أَرْضُ الرِّسَالَاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=196678",""],[5628,"الأميرة الغجرية","https://www.poetsgate.com/ViewPoem.aspx?id=178444",""],[5628,"يا ساكب الروح","https://www.poetsgate.com/ViewPoem.aspx?id=178466",""],[5628,"السماء القاتمة","https://www.poetsgate.com/ViewPoem.aspx?id=178511",""],[5674,"وأقمت بعدك يافرات عزائي","https://www.poetsgate.com/ViewPoem.aspx?id=190746",""],[5830,"هَلْ كَنْتُ جُرْماً","https://www.poetsgate.com/ViewPoem.aspx?id=200766",""],[5956,"أنا ضد باطنية كل الأطراف","https://www.poetsgate.com/ViewPoem.aspx?id=192188",""],[5956,"أسحب منكم محبتي","https://www.poetsgate.com/ViewPoem.aspx?id=192461",""],[5956,"إني أنصّب نفسي مثل والدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=193718",""],[5956,"كثيرهم بالنصب قد آذاني","https://www.poetsgate.com/ViewPoem.aspx?id=194065",""],[5956,"بالي على شقيقك يا سمية مقلقي","https://www.poetsgate.com/ViewPoem.aspx?id=204343",""],[6019,"الأَربَعُونَ ... رِوَايَةٌ أُخرَى","https://www.poetsgate.com/ViewPoem.aspx?id=71121",""],[6082,"قفْ عند حَدّك","https://www.poetsgate.com/ViewPoem.aspx?id=180123",""],[6127,"السمو","https://www.poetsgate.com/ViewPoem.aspx?id=205187",""],[6167,"هذا المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85537&r=&rc=20",""],[6181,"مسافر ومسافرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87686&r=&rc=1",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[2220,"إني إناءٌ ملآنُ ليسَ يشرٌ ما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11724&r=&rc=594",""],[5164,"ذُلُّ الهَوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75663&r=&rc=17",""]],"verses":[["إِنّي أَنا عَنتَرَةَ الهَجينُ","فَجُّ الأَتانِ قَد عَلا الأَنينُ",0,"ن",1,1],["إِنّي أَنا لَيثُ العَرينِ وَمَن لَهُ","قَلبُ الجَبانِ مُحَيَّرٌ مَدهوشُ",1,"ش",1,0],["إِنّي أَنا السَيفُ لا تُرضيكَ جِدَّتُهُ","وَلَيسَ يُرضيكَ إِلّا بَعدَ إِخلاقِ",2,"ق",1,1],["إِنِّي أَنَا الوَضَّاحُ إِن تَصِلي","أُحسِن بِكِ التشبِيبَ وَالوَصفَا",3,"ف",2,0],["إِنّي اِنصَبَبتُ مِنَ السَماءِ عَلَيكُمُ","حَتّى اِختَطَفتُكَ يا فَرَزدَقُ مِن عَلِ",4,"ل",1,0],["إني أنا المرءُ إن نفَّلتَه نَفَلاً","فلست تعدم منه الشكرَ ما خلدا",5,"د",2,0],["إِنّي أَنا اللَيثُ في عَريسَةٍ أَشِبٍ","فَوَرِّعِ السَرحَ حَتّى يَفسَحَ البَصَرُ",6,"ر",1,0],["إِنّي أَنا الأَسَدُ الهَصورُ بَسالَةً","وَيلٌ لِقَومٍ حاوَلوا إِحراجي",7,"ج",2,0],["إنِّي أنا النَّايُ الَّذي لا تنتهي","أنغامُهُ ما دام في الأَحياءِ",8,"ا",2,0],["إنى أنا المحامي","عنك لدى الأنام",9,"م",1,0],["إِنّي أَنا المِصباحُ لَستُ بِضائِعٍ","حَتّى أَكونَ فَراشَةَ المِصباحِ",10,"ح",1,0],["إِنّي أَنا الذَهَبُ المَعروفُ مَخبَرُهُ","يَزيدُ في السَبكِ لِلدينارِ دينارا",11,"ر",2,0],["إِنّي أَنا الزادُ إِذ لا زادَ يَحمِلُهُ","رِكابُهُم غَيرَ أَنقاءٍ وَأَصلابِ",12,"ب",1,0],["إنّي أُنادي منكَ غيرَ مُجَاوِبٍ","ميتاً وعن شوقٍ إِلَيك أُنادي",13,"د",2,0],["إِنّي اِنتَجَعتُكَ يا أَبا الفَضلِ الَّذي","بِالجودِ قَرَّبَ مَورِدي مِن مَصدَري",14,"ر",2,0],["إني أَنا الصب قد ذاعَت محبته","وإنني أَنا ذاكَ الشاعر الزجل",15,"ل",1,0],["أَنِّي أُنَفِّر قَامُوصَ الظَّهِيرَةِ والحِرْبَاءُ","فَوْقَ فُرُوعِ السَّاقِ يَمْتَصِعُ",16,"ع",1,0],["إنِّي أنا الرُّوحُ الَّذي","سيظَلُّ في الدُّنيا غَريبْ",17,"ب",1,0],["اني انفت من البقيا إذا أنفت","الا اغتيال السري الماجد العضل",18,"ل",1,0],["إِني أَنا البازيُّ قَصَّ جَناحُهُ","فَعَسى يراش وَيَعتَريهِ فِكاكُ",19,"ك",1,0],["إِني أَنا الذَهب الذَّي قَد شابَهُ","كَدر الرغام يُزيلُهُ الحِكاكُ",19,"ك",1,0],["إني أناديه والأحشا بها لهب","والدمع جار وقد مليت من المي",20,"م",2,0],["إنِّي أنا صَدَّامُ أُطْلِقُ لِحْيَتِي","حِينًا ووَجْهُ البَدْرِ لَيسَ يُعابُ",21,"ب",1,0],["إني أنا الصَّبُّ المتيَّمُ في الهوى","هو في الحَشاشة والبكاءُ وشفائي",22,"ا",2,0],["إِنّي أَنَختُ رِكابي في ذَرى مَلِكٍ","لَم يُبقِ لي في بِلادِ اللَهِ مُضطَرَبا",23,"ب",2,0],["إني أنزه عن سواك مدائحا","لك عن فلان صنتها وفلان",24,"ن",1,0],["إني أنا شاعر","من أنت يا ساحر",25,"ر",1,0],["اني اِنتصرت بكم وَاللَه ناصركم","أَينَ الحَميَّة منكم بالحماية لي",26,"ل",2,0],["أني أنفت على رجائهم","وملكت عز جميعهم وحدي",27,"د",2,0],["أَنّي اِنتَشَقت نَسمة التَحيّة","مِن الصَديق خالص الطَويّه",28,"ه",1,0],["إِنّي أنزّه نَفسي أَن يدنّسها","تَمويه مُختلفٍ في زيِّ مُؤتلفِ",29,"ف",1,0],["أَنِّيَ إِن نِمتُ عَلى حالَةٍ","لَستُ أَرى إِلّا أَحاديثُها",30,"ه",2,0],["إني أناديك من قلبٍ به ألمٌ","من العلى فاسمعي ثم ارحمي دائي",31,"ي",1,0],["إني أنا أمُّ المحبة والتقى","أم الرجا السامي الذي لا يُخلِفُ",32,"ف",1,0],["إني أنا القلب الإلهيُّ الذي","صفُّ الملائك ساجدٌ بإزائي",33,"ي",1,0],["إني أنا العبد الفقير","ذو الذنب والفعل الذميم",34,"م",1,0],["إني أنا البائس العبد الحقير الذميم","ذو الفعل والقال والحال الوخيم الشتيم",35,"م",1,0],["إني أنا الناسي القاسي الظلوم الكفور","ذا الحق والصدق أما غير هذا فزور",36,"ر",1,0],["أني أنا السائل الطلاب","وحسبي إن صح ذامني",37,"ن",2,1],["أنى انثنت فالغصن يخجل دونها","فكأنّها اليزنيّة السمراء",38,"ا",2,0],["إِني أَنا الرجل الضرب الَّذي خلُصت","منه الطبائع في سر وفي علن",39,"ن",1,0],["إنّي أَنَا الاَشتَرُ مَعرُوفٌ الشَّتَر","إنِّي أَنَا الأَفعَى العِرَاقِيُّ الذَّكَر",40,"ر",1,1],["إِنّي أَنا الناصِحُ المُبدي نَصيحَتَهُ","ما شُبتُ نُصحاً بِإِبطالٍ وَلا كَذِبِ",41,"ب",1,0],["إني أنا وكذا أنتم بكن فيكونْ","لقد ظهرنا جميعا فافهموا المضمونْ",42,"ن",1,1],["إني أنا وبينما","قلت لكم أني أنا",43,"ن",2,1],["إني أنا لست أنا","فليت شعري من أنا",44,"ن",2,1],["إني أنا المعني القديمُ","إني أنا النبأ العظيمُ",45,"م",1,1],["إني أنا المكتوب في الطرسِ","لا يهرب الكلب من العرسِ",46,"س",1,1],["إني أنا فرضه وتقديرُهُ","إني أنا خلقه وتصويرُهُ",47,"ر",2,1],["إني أنا بك يا ودودْ","عدم أحاط به الوجودْ",48,"د",1,1],["إني أنا جسم فنفس فروحْ","ثلاثة فيهن أغدو أروحْ",49,"ح",1,1],["إِنِّي أَنا الظَّامِي إِليكَ فاسقِنِي","إِن كُنتَ لا تَسقي سِوى ظَمآنِ",50,"ن",1,0],["إني أنال برقتي وفصاحتي","ما لم أنل بالسيف والنيران",51,"ن",1,0],["إني أنا الحاسد لا أنتمُ","هل فيكم بالأمر مثلي بصيرْ",52,"ر",1,0],["إني أنا الفتح سمعتم به","ما همه حرب ولا صلح",53,"ح",1,1],["إِنّي أُنزِّهُه عن ذِكره بفَمي","وَأَنْ أُسمّيَهُ صَوناً وَإِجلالا",54,"ل",2,1],["إني أنا الظامي ولا ورد لي","إلا ارتشاف الدمع من مقلتي",55,"ي",1,0],["إني أنا الملك الذي قد مُلِّكت","يمنايَ رقَ خلائف وعبيد",56,"د",1,0],["إني أنا الحر وابن الحُرِّ","ذو حَسَب مذحج وفخرِ",57,"ر",1,1],["إِنّي أَنا الحرُّ وَاِبنُ الحرِّ","ذو حَسَبٍ في مذحج وَفَخرِ",58,"ر",1,1],["إِني أَنا ذاك الفَقير البائس","وَلَيسَ مِن لُطف الإِله يائس",59,"س",1,0],["أنى أناديك ابراهيم عن كثب","وكم يلذ إسمك الأسمى لكل فمِ",60,"م",1,0],["إني أنا الوطنيةُ الحسناء كم","متنعِّم باسمي بغير وداد",61,"د",1,0],["إِنّي أَنا فَيروز ما نعم لا","يَجري عَلى مَجرى رَسائلي لا",62,"ل",2,0],["إِنّي أَنا الأصفهسلا","رة وَالسمستار الخَليل",63,"ل",1,0],["إِنّي أَنا الله الذي شَهِدَا له","بالمُلْكِ ناطِقُ خَلْقِهِ والأَخْرَسُ",64,"س",1,0],["إنى أنا الوامقُ العبدُ الذي اندرستْ","همومُهُ وله في الفُصْحِ تدريسُ",65,"س",1,0],["اني انتفى ذاك الجمال واصبحت","ايامك البيض الليالي سودا",66,"د",2,0],["إني أنزهك عن تنزيه أكثرهم","بما أتت فيه أرسالٌ لكم وقد",67,"د",1,0],["إني أنا وصفه النفسيُّ فاعتبروا","إن زلت زال بهذا النعت أدريه",68,"ي",2,0],["إني إناء ملآن يشرب ما","فيه من اللبن الممزوج بالعسل",69,"ل",1,1],["إنِّي أنَا الرَّحمنُ تَسبِقُ رَحمَتِي","غَضَبِي وَذَاكَ لرأفتِي وَحَنَاني",70,"ن",2,0],["إنَّي أنَا الدَّيَّانُ آخُذُ حقَّ مَظ","لُومٍ مِنَ العَبدِ الظَّلُومِ الجَانِي",70,"ن",2,0],["أني أنادي في الظلام إذا سجى","يارب لا تغضب على بزلتي",71,"ي",1,0],["إني انزويت بقعر كأسي تاركاً","آلام مجتمع وحرب خصوم",72,"م",1,0],["إني أنزّه نفسي عن جوابكم","كما أنزه عن ضرب الكلاب يدي",73,"ي",1,0],["إني أناجيك ملهوفاً أتسمعني","قد بُحّ صوت مناجاتي وأشعاري",74,"ر",2,0],["إني أنا اسمي ليس لي غيره","أول ما فاه به ذاكري",75,"ر",2,0],["إني أنا العقل ما شابته شائبة","من الهوان وطبعي طبع أحرار",76,"ر",1,0],["إِنِّيْ أَنَا لَكِنَّ صَمْتًا سَاتِرَاً","مَاهِيَّتِيْ مُتَجَرِّدَاً بِمُجَرَّدِيْ",77,"د",2,0],["إنِّي أنا ابنُ جَلا إن كنتَ تُنكرني","يا رُؤبَ والحيةُ الصمَّاءُ في الجَبَلِ",78,"ل",1,1],["اني أنا المستمجد الفخور","فما الذي عندك يا عنجور",79,"ر",1,0],["اني أنا الطيب نشراً وارج","بنشر انفاسي ترتاح المهج",79,"ج",1,0],["أَنّى أَنا وَبذي الحَليفة موردي","وَببانة الجرعاء ثم مخيمي",80,"م",2,0],["انى أنا الفرد الذى في حضرة ال","تقريب كاسى لايزال يروق",81,"ق",1,0],["انى أنا العبد المقر بذنبه","فاغفر لى الأوزار ياغفار",82,"ر",1,0],["إِنّي أَنا البَحرُ غَمراً لَستَ جاسِرَهُ","وَسَبّيَ النارَ دونَ البَحرِ تَستَعِرُ",83,"ر",1,0],["إني أنا الدنف الذي","أضحى أتاني ذا شغفْ",84,"ف",1,1],["إِنّي اِنتَشيت وطاسَتي","قلمي وَذكركمو سلافي",85,"ف",2,0],["اني أُنبيكَ عن قولي وعن خُلقي","والمجدُ يعتدُّ أَقوالي بأفعالي",86,"ل",2,0],["إِني أَنزه قَولي عَن مَذَمَتِهم","وَالجَهر بِالسوءِ فاعلم لَيسَ مِن شِيَمي",87,"م",2,0],["اني أُنادِي مَن مُنعتُ جَوابَهُ","فلذاك رَجعُ نِدايَ مثلي يَهتِفُ",88,"ف",1,0],["اني اناقضُ ما أَبدَوهُ من رَشَدٍ","إِمَّا ضَلَلتُ وضَلَّت رُوحُ معتصمِ",89,"م",1,0],["إني أنا التُّبَّعُ المسعودُ من يَمنٍ","وبي لعمركَ دُرُّ المُلكِ منظومُ",90,"م",1,0],["أني أنا الأبريزُ أصلاً وعُلىً","والنَّاسُ صُفرٌ بالدقيق يُشترى",91,"ا",1,0],["إني أنا الموتُ الذي لا بدَّ من","لقِيانه والموتُ ليس ببائنِ",92,"ن",1,0],["إني أنا الدَّهرُ لكنْ ما انطويت على","غدرٍ وذا الدَّهر خواَّن وغدَّار",93,"ر",1,0],["إني أنا منيةُ مريم فلي","تولَّ يا وال