فر"],[551,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[551,"عجبت لقلبي كيف يصبو ويكلف","https://www.aldiwan.net/poem47405.html","البسيط"],[551,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[551,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[551,"ألا يا قوم للقدر المتاح","https://www.aldiwan.net/poem47892.html","الوافر"],[551,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[551,"إذا ساءلتني فخذ الجوابا","https://www.aldiwan.net/poem48078.html","الوافر"],[551,"إيابا أيها المولى إيابا","https://www.aldiwan.net/poem48081.html","الوافر"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[570,"تعلم أن خير الناس ميت","https://www.aldiwan.net/poem59477.html","البسيط"],[575,"دنوت وقد أبدى الكرى منه ما أبدى","https://www.aldiwan.net/poem3082.html","الطويل"]],"verses":[["أَلا قاتَلَ اللَهُ هَذا الأَنامَ","وَقاتَلَ ظَنّي وَآمالِيَه",0,"ي",2,0],["أَلا قَطَعَ الناسُ حَبلَ الوَفاء","وَأُولِعَ بِالغَدرِ خُلّانِيَه",0,"ي",2,0],["أَلا قاتَلَ اللَهُ الَّذي جاءَ غازِياً","فَقارَعَنا عَن مُخَّةِ الساقِ وَاِنتَقى",1,"ق",2,0],["أَلا قاتَلَ اللَهُ الطُلولَ البَوالِي","وَقاتَلَ ذِكراكَ السِنينَ الخَوالِيا",2,"ي",2,1],["أَلا قَد جَنى طَرفي عَلَيَّ بَلِيَّةً","أَعوذُ بِكَ اللَهُمَّ مِن شَرِّ ما يَجني",3,"ي",1,0],["أَلا قَد قَدَمَت فَوزٌ","فَقَرَّت عَينُ عَبّاسِ",4,"س",1,0],["أَلا قُل لِتَيّاكَ ما بالُها","أَلِلبَينِ تُحدَجُ أَحمالُها",5,"ل",3,1],["أَلا قُل لِتَيّا قَبلَ مِرَّتِها اِسلَمي","تَحِيَّةَ مُشتاقٍ إِلَيها مُتَيَّمِ",6,"م",1,1],["أَلا قَبَّحَ اللَهُ البَراجِمَ كُلَّه","وَجَدَّعَ يَربوعاً وَعَفَّرَ دارِها",7,"ه",2,1],["أَلا قَبَّحَ اللَهُ القَصيبَةَ قَريةً","وَمَرأَةَ مَأوى كُلِّ زانٍ وَسارِقِ",8,"ق",1,0],["أَلا قَبَحَ اللَهُ اِمرَأَ الَقيسِ إِنَّها","كَثيرٌ مَخازيها قَليلٌ عَديدُها",9,"د",3,0],["ألا قدّس الرحمن نفساً كريمة","بكلِّ عزيز في الوجود نُفدّيها",10,"ي",3,0],["ألا قل في الطلاق لمُوقِعِيه","بما في الشرع ليس له وجوب",11,"ب",1,0],["ألا قل لمن جاروا علينا بحكمهم","رُوَيداً فقد قارفتم كل مأثمَ",12,"م",1,0],["أَلا قَبَحَ الإِلَهُ بَني عِقالٍ","وَزادَهُمُ بِغَدرِهِمِ اِرتِيابا",13,"ب",2,0],["إِلّا قَتيلاً قَد سَلَبنا بَزَّهُ","تَقَعُ النُسورُ عَلَيهِ أَو مَصفودا",14,"د",2,0],["أَلا قَبَحَ اللَهُ الفَرَزدَقَ كُلَّما","أَهَلَّ مُصَلٍّ لِلصَلاةِ وَكَبَّرا",15,"ر",2,0],["أَلا قَبَّحَ اللَهُ يَومَ الزُبَيرِ","بَلاءَ القُيونِ وَأَخبارَها",16,"ر",3,0],["أَلا قُل لِبَرّادٍ إِذا ما لَقيتَهُ","وَبَيِّن لَهُ إِنَّ البَيانَ مِنَ الصِدقِ",17,"ق",1,0],["أَلا قُل لِرَبعٍ بِالأُفاقَينِ يَسلَمِ","يُحَيّا عَلى شَحطٍ وَإِن لَم يُكَلَّمِ",18,"م",1,1],["أَلا قُل لِسَيفِ الدَولَةِ القَرمِ إِنَّني","عَلى كُلِّ شَيءٍ غَيرِ وَصفِكَ قادِرُ",19,"ر",1,0],["ألا قل لقاضي قضاة الأنام","أمام التقى ذي الفخار العربق",20,"ق",1,1],["ألا قل لمولانا الإمام أخي التقى","أغثني فعندِي للعلاء غليل",21,"ل",1,1],["ألا قُلْ لسيدنا قل له","مقالاً إذا قيل لم يُفْسخِ",22,"خ",1,1],["ألا قاتَل اللَّهُ المنايا ورَمْيَها","من القَوْمِ حَبَّات القُلوب على عَمْدِ",23,"د",1,0],["ألا قُل لنحويِّكَ الأخفشِ","أنِسْتَ فأقصِرْ ولم تُوحِشِ",24,"ش",1,1],["ألا قل لذي العطن الواسعِ","أخي المجد والشرف اليافعِ",25,"ع",1,1],["إلّا قرأتم على مؤمَّلِنا","سلام صادي الأحشاء خافقها",26,"ق",3,0],["ألا قُبحاً على قبح وسُحقاً","لهاتيك المناظرِ والجُسومِ",27,"م",1,0],["أَلا قَبَّحَ اللَهُ الحُطَيئَةَ إِنَّهُ","عَلى كُلِّ ضَيفٍ ضافَهُ فَهوَ سالِحُ",28,"ح",1,1],["أَلا قَد أَرى إِلّا بُثَينَةَ لِلقَلبِ","بِوادي بَدِيٍّ لا بِحِسمى وَلا شَغبِ",29,"ب",1,1],["أَلا قَد أَرى إِلّا بُثَينَةَ هَهُنا","لَنا بَعدَ ذا المُصطافِ وَالمُتَرَبَّعِ",30,"ع",1,0],["أَلا قَلَّما تَبقى عَلى ما بَدا لَها","وَحَلَّ بِها مِنكَ القَنا وَالسَوابِقُ",31,"ق",1,0],["إلا قلائل من أسرارنا كتمت","منها أداة وأيام ونيران",32,"ن",1,0],["إِلّا قُرَيشاً فَإِنَّ اللَهَ فَضَّلَها","مَعَ النُبُوَّةِ بِالإِسلامِ وَالخيرِ",33,"ر",1,0],["أَلا قَبَّحَ اللَهُ الأَصَمَّ وَأُمَّهُ","وَنَذرَهُما الموفى الخَبيثِ مِنَ النَذرِ",34,"ر",1,0],["أَلا قَبَحَ الإِلَهُ بَني كُلَيبٍ","ذَوي الحُمُراتِ وَالعَمَدِ القِصارِ",35,"ر",1,0],["أَلا قَبَحَ اللَهُ الكَرَوَّسَ وَالَّتي","مَشَت سَنَةً في بَطنِها بِالكَرَوَّسِ",36,"س",1,1],["أَلا قَبَّحَ اللَهُ القَلوصَ الَّتي سَرَت","بِرَحلي إِلى خَصيَي عِدانِ المُهَمَّلِ",37,"ل",1,0],["أُلاقي الظلامَ بمثلِ الظَّلامِ","وألقى النهارَ بمثلِ النَّهارِ",38,"ر",1,0],["أَلا قَد أَرى وَاللَهِ أَن لَستُ مِنكُمُ","وَلا أَنتَمُ مِني وَإِن كُنتُمُ أَهلي",39,"ي",1,1],["أَلا قَلَّما تَبقى نُفوسٌ لِأَهلِها","إِذا راوَحَتهُنَّ المَنايا وَغادَتِ",40,"ت",1,0],["أَلا قَلَّ ما يَنجو ضَميرٌ مِنَ المُنى","وَفيهِ لَهُ مِنهُنَّ شُعبَةُ وَسواسِ",41,"س",1,0],["أَلا قُل لِابنِ مَعنٍ ذا ال","لَذي في الوُدِّ قَد حالا",42,"ل",2,1],["أَلا قُل لِذاتِ الخالِ يا رَبَّةَ الذَكا","وَمَن بِضِياءِ الوَجهِ فاقَت عَلى ذُكا",43,"ك",2,0],["أَلا قُل لِشَرِّ عَبيدِ الإِلَ","هِ وَطاغي قُرَيشٍ وَكَذّابِها",44,"ب",3,1],["إلّا قصائدُ بالمحامدِ صُغْتُها","غُرّاً تهزّ مَحافلَ الإِنشادِ",45,"د",1,0],["أَلا قَاتَلَ اللَّهُ الْحَيَاةَ فَإِنَّهَا","إِلَى الْمَوْتِ أَدْنَى مِنْ فَمٍ لِبَنَانِ",46,"ن",1,0],["أَلا قَاتَلَ اللَّهُ الْهَوَى مَا أَلَذَّهُ","عَلَى أَنَّهُ مُرُّ الْمَذَاقِ أَلِيمُ",47,"م",1,0],["ألا قلْ لسيدنا الشاعرِ","ولا تخشَ منْ طبعهِ النافرِ",48,"ر",1,1],["إلا قليلاً قال عن","دنياهُ أنتِ طالقَهْ",49,"ق",2,0],["أَلا قُل لِهِندٍ إِحرَجي وَتَأَثَّمي","وَلا تَقتُليني لا يَحِلُّ لَكُم دَمي",50,"م",2,1],["أَلا قاتَلَ اللَهُ الهَوى حَيثُ أَخلَقا","فَما إِن تَرى إِلّا مَشوباً مُمَذَّقا",51,"ق",2,1],["أَلا قُل لِلمَريضِ القَلبِ مَهلاً","فَإِنَّ السَيفَ قَد ضَمِنَ الشِفاءَ",52,"ا",2,1],["أَلا قَصرُ كُلِّ بَقاءٍ ذَهاب","وَعُمرانُ كُلِّ حَياةٍ خَراب",53,"ب",1,1],["أَلا قُل لِذاتِ الخالِ عَنّي إِنَّني","لَأَرغَبُ عَن خالٍ تَطَلَّعَ في خَدِّ",54,"د",1,1],["أَلا قانِعٌ مِن مُلكِ كِسرى بِكِسرَةٍ","فَما الوَجدُ إِلّا الخُلدُ لاماجَنى كِسرى",55,"ر",2,1],["أَلا قُل لَهُم ما قَد تَرى مِن صَبابَتي","وَمِن أَدمُعِ تَنهَلُّ مِنّي تَوالِيا",56,"ي",2,0],["أَلا قُل لِلَيلى هَل تُراها مُجيرَتي","فَإِنّي لَها فيما لَدَيَّ مُجيرُ",57,"ر",1,0],["أَلا قُل لِلَيلى قَد وَهَبتُ لَها دَمي","وَجُدتُ بِنَفسي قَد نَعاها عَزيزُها",58,"ه",2,0],["أَلا قاتَلَ اللَهُ الهَوى ما أَشَدَّهُ","وَأَسرَعَهُ لِلمَرءِ وَهوَ جَليدُ",59,"د",1,1],["أَلا قاتَلَ اللَهُ الحَمامَةَ غَدوَةً","عَلى الغُصنِ ماذا هَيَّجَت حينَ غَنَّتِ",60,"ت",1,0],["أَلا قاتَلَ اللَهُ اللَوى مِن مَحَلَّةِ","وَقاتَلَ ذُؤباناً بِها كَيفَ وَلَّتِ",60,"ت",1,0],["أَلا قاتَلَ اللَهُ الرَكائِبَ إِنَّما","تُفَرِّقُ بَينَ العاشِقينَ الرَكائِبُ",61,"ب",1,0],["أَلاَ قَدَرٌ للهِ يجرِي سَنيحُه","بحاجاتها أو آيةٌ منه تُكتَبُ",62,"ب",1,0],["أَلا قاتل اللَهُ المقطَّمَ إِنَّهُ","لَيُوشِك أَن يندكَّ مِنهُ المقطَّمُ",63,"م",1,0],["ألا قُمْ فَأدْرِكْهُم ولمَّا يُصِبْهُمُ","عَذابٌ غَليظٌ ما لهم منه مَهْرَبُ",64,"ب",1,0],["أَلا قُل لِلقبائِل إِنَّ بَكراً","وَتَغلِبَ بَعدَ حَربِهِم سِنينا",65,"ن",2,0],["أَلا قُل لِمَن أَمسى بِمَكَّةَ قاطِناً","وَمِن جاءَ مِن عَمقٍ وَنَقبِ المُشَلَّلِ",66,"ل",1,1],["أَلا قاتَلَ اللَهُ الهَوى كَيفَ أَخلَقا","وَلَم تَلقَهُ إِلّا مَشُوباً مُمَذَّقا",67,"ق",2,1],["إِلّا قَليلاً لَيتَهُ لَم يَكُن","شَيئاً كَنَومِ الخائِفِ الأَرمَدِ",68,"د",1,0],["أَلا قوموا إِلى الكَرخِ","إِلى مَنزِلِ خَمّارِ",69,"ر",1,1],["أَلا قُل لِعَمرٍ كَيفَ أَنِّيَ واحِدٌ","وَمِثلُكَ يا ذا في الأَنامِ كَثيرُ",70,"ر",1,1],["أَلا قُل لِأَمينِ اللَ","هِ وَاِبنِ القادَةِ الساسَه",71,"س",2,1],["أَلا قُل لِإِسماعيلَ إِنَّكَ شارِبٌ","بِكَأسِ بَني ماهانَ ضَربَةَ لازِمِ",72,"م",1,1],["أَلا قولا لِحَمدانِ","أَيا فاسِقَ مُردانِ",73,"ن",1,1],["ألا قبّح الرحمنُ داحةَ أمردا","أراد اقتداءٌ بالرقاشيّ فاقتدى",74,"د",2,1],["ألا قل يلحي على حبِّ شاطر","ويحكمُ في الأشياءِ حكماً بظاهرِ",75,"ر",1,1],["أَلا قُل لِعَبدَةَ إِن جِئتَها","وَقَد يُبلِغُ الأَقرَبُ الباعِدا",76,"د",2,1],["أَلا قُل لِعُزّابِ البُصَيرَةِ أَقبِلوا","بِحاجَتِكُم مِن نازِحٍ وَقَريبِ",77,"ب",1,0],["أَلا قُل لِتِلكَ المالِكِيَّةِ أَصحِبي","وَإِلّا فَمَنّينا لِقاءَكِ وَاِكذِبي",78,"ب",2,1],["أَلا قَد ذَهَبَ الناسُ","وَنِضوي رِزامٌ بارِك",79,"ك",1,0],["الأقوياء بكل أَرض قد قضوا","أن لا تُراعى للضَعيق حقوق",80,"ق",1,0],["إلا قصَدتَ لحاجَتي","وأعَنتَ عبدَكَ يا عليّ",81,"ي",1,0],["ألاقَيْتَ في أجوائها غيرَ طيرها","على نَسَماتٍ في الغصون تُهَيْنِمُ",82,"م",1,0],["أَلا قَد أَرى وَاللَهِ أَن رُبَّ عُبرَةٍ","إِذا الدار شَطَّت بَينَنا سَتَزيدُ",83,"د",1,0],["أُلاقي الدّارِعينَ بغيرِ دِرْعٍ","وأدْعو بالمُدَجَّجِ لا تَفُتْني",84,"ن",2,0],["أَلا قاتَلَ اللَهُ الطُلولَ البَوالِيا","وَقاتَلَ ذِكراكَ السِنينَ الخَوالِيا",85,"ي",2,1],["أَلا قاتَلَ اللَهُ الهَوى كَم بِسَيفِهِ","قَتيلُ غَرامٍ لا يُوَسَّدُ في اللَحدِ",86,"د",1,0],["أَلا قَبَّحَ اللَّهُ الْجَهَالَةَ إِنَّهَا","عَدُوَّةُ مَا شَادَتْهُ فِينَا يَدُ الْفِكْرِ",87,"ر",1,0],["أَلا قُلْ لِقَوْمٍ شَامِتِينَ تَرَبَّصوا","تَهَزُّمَ شَرٍّ بِالْمَنِيَّة كارِثِ",88,"ث",1,1],["ألا قطرة عرس قانا الجليل","ولوبين جُدرانك الدائره",89,"ر",2,0],["أَلا قَبَّحَ اللَهُ البَراجِمَ كُلَّها","وَجَدَّعَ يَربوعاً وَعَفَّرَ دارِها",90,"ه",2,1],["ألاَ قل لمن طَافَ حول الفضاءِ","ورام الكواكب فَارْتَادها:",91,"د",3,0],["ألاقيك ، أرصفة في (الرياض) ... وأوراق مزرعة في (الكويت)","ومكنة في رمال الخليج ... وشبت عن يديك ، وأنت أختفت",92,"ت",1,0],["ألا قُوَّةٌ تسطيعُ دفع المَظالِمِ","وإنعاشَ مخلوقٍ على الذُّلِّ نائِمِ",93,"م",1,1],["ألا قبساً من شُعاعِ الكليم","تُعيدُ على الشَّرق يا\" طُورَ سينا \"",94,"ن",2,0],["ألا قبح الله البراجم كلها","وجدع يربوعاً وعفر دارما",95,"م",2,1],["الأقحوان ثغرك المندّى","ونحن بالعطر وبالرفيف",96,"ف",1,0],["ألا قاتلَ الله الهوى حيثُ أخلقا،","فما انْ ترى إلا مشوياً ممذقا",97,"ق",2,1],["ألا قلْ لهندس: إحرجي وتأثمي،","وَلا تَقْتُليني، لا يَحلُّ لَكُمْ دَمي",98,"م",2,1],["ألاقيك ، أرصفة في (الرياض)","وأوراق مزرعة في (الكويت)",99,"ت",1,0],["ألا قدْ أرى أنْ لنْ أُلاقِيَ مثلَها","ولكنَّ أبْدالاَ يكونُ عِيالا",100,"ل",2,0],["الا قاتل الله الدني فانه","تراه الى السوء المجرد دانيا",101,"ي",2,1],["الا قاتل الله الهوى وشؤُنه","ظلوما لاهليه تراه ومقسطا",102,"ط",2,0],["الاقي به الاسد الجرئية ربضا","وارغم اعدائي واقهر حسدي",103,"ي",1,0],["الأقربون بهم أوصى الإله وذا","سر لعارف معنى وصلة الرحم",104,"م",1,0],["ألا قل لأهلِ الدهرِ والدهر إنني","ثبوتٌ ولو رَضْوَى عَلَىَّ تَهَدَّمَا",105,"م",2,0],["ألا قُل لِذى حمق تسربل بالغدرِ","وجانب أهل العدل والفضل والقدرِ",106,"ر",1,1],["إلا قليل العقل مِن","هذى الخلائق والبشَر",107,"ر",1,0],["أَلاَ قُلْ لمن يبغى المعالي مُبَادِراً","فهذى العُلا تبغى حكيما يسُودُها",108,"د",3,0],["ألاَ قُل لِلوَلىِّ عَلَوتَ جَاهاً","وعِزاًّ في المُزايِلِ والمُبني",109,"ي",1,0],["ألاَ قُل لِمَن يَحجُوهُ فَارَقَ أهلَهُ","وأوطَانَهُ أو كَان قَارَفَ هُونَا",110,"ن",2,0],["ألا قل للّتي سلبت فؤادي","وأبقتني أهيمُ بكلّ وادِ",111,"د",1,1],["ألا قل لأرباب الردى بميرقة","فربتما أودى النصيحة ناصح",112,"ح",1,0],["ألا قل للثّقاة السّامعينَ","عن المثنى عليهم أجمعينا",113,"ن",2,1],["ألا قللا ما بي تقرُّ عيونُها","فقد صدقت في ابن التقي ظنونُها",114,"ن",3,1],["أَلا قُل لِمَن أَرهَقَتهُ الذُنوبُ","وَخافَ مِن الدَهرِ خَطباً جَسيما",115,"م",2,1],["أَلاَ قَد أَرَى وَاللهِ اَن قَد قَذِيتُما","بِمَن لاَ يُبالِى أَن يَطُولَ قَذَاكما",116,"م",2,0],["ألا قبّح الله الضرورة إنّها","تكلّف أعلى الناس أدنى الخلائق",117,"ق",1,1],["أُلاقي الدهر في ثوبي غريب","بلا مال يُعَدّ ولا صديق",118,"ق",1,0],["إِلّا قُصورُ وُجودِهِ عَن جُودِهِ","لا عَونَ لِلرَجُلِ الكَريمِ كَمالِهِ",119,"ل",2,0],["ألا قُل لبدر ليالي الدجى","ونور الظلام إذا أسدَفا",120,"ف",2,1],["ألا قاتل الله النفوس فإنها","لكل بلاء ملقيات أعنة",121,"ه",1,0],["ألا قُلْ لمن ضلّ من هاشم","ورام اللُّحوق بأرْبابها",122,"ب",3,0],["أَلا قَد بَرانِيَ مِن قدِّهِ","وَذاكَ التَثَنّى وَلَم يَعطِفِ",123,"ف",1,0],["أَلا قُل لِرُكنِ الدينِ ذي الفَضلِ وَالحَجا","مَقالَةَ غَيرانٍ عَلَيهِ إِذا زالا",124,"ل",2,1],["أَلا قُل لِشَمسِ الدَولَةِ اِبنِ مُحَمّدٍ","وَلا تَحتَشِم وَاَبلِغهُ ما أَنا ذاكِرُ",125,"ر",1,1],["أَلا قُل لِمُفتَخِرٍ بِالمَجوسِ","أَبوهُ عَلى زَعمِهِ المُؤبِذُ",126,"ذ",1,1],["أَلا قُل لِباغي الجودِ يُنضي رِكابَهُ","عَلى الرِزقِ خَبطاً لا يَرى وَجهَ مَقصَدِ",127,"د",1,0],["أَلاَ قُلْ لِمَنْ يَبْغِي إِلَى العِزِّ مَنْفَذاً","إِلَهَكَ فَاذْكُرْ دَائِماً ودَعِ البَذَا",128,"ذ",2,1],["ألا قُل للذي يسألُ","عن قومي وعن أهلي",129,"ي",1,1],["ألا قولوا لشخصٍ قد تعدّى","عليّ برجمه غيباً بغيبهْ",130,"ب",2,1],["ألاقي من رجالٍ منكراتٍ","فأنكرُها وما أنا بالظلومِ",131,"م",1,0],["ألا قل لسعدى ما لنا فيك من وطر","وما تطيبنا النجل من أعين البقر",132,"ر",1,1],["أَلا قُل لِعُبَيدِ اللَ","هِ ما بالُكَ لا تَسلى",133,"ل",2,1],["إلا قليلاً يَربى على شرفٍ","ما كلُّ بنٍّ يَزكو كبنِّ مخا",134,"خ",2,0],["ألا قُل لذي الجهل كم تطمَحُ","وقلبُك للغيّ كم يجنحُ",135,"ح",1,1],["الا قل بحق يا سليمان واجتنب","مقاله حب قد أردت هداكا",136,"ك",2,0],["أَلا قَدْ أَحْرَجَتْ صدري هُمومٌ","أَرى صدر الفضاءِ بِها يضيق",137,"ق",1,0],["ألا قلْ للرَّسولِ بلغت عُذْراً","وكنتَ في السَّوابقِ في المجال",138,"ل",1,0],["أَلا قولا لِعَبدِ الجَهلِ إِنَّ الص","صحيحَةَ لا تُحالِبُها التَلوثُ",139,"ث",1,1],["أَلا قَلَّ خَيرُ الدَهرِ كَيفَ تَغَيَّرا","فَأَصبَحَ يَرمي الناسَ عَن قَرنِ أَعفَرا",140,"ر",2,0],["ألا قلْ لقيسٍ يبعثوا في بيوتهم","مآتمَ تبغى مطْلِعَ الشمس عازِبا",141,"ب",2,1],["أَلا قُل لِمَروانٍ أَتَتكَ رِسالَةٌ","لَها نَبَأٌ لا يَنثَني عَن لِقائِكا",142,"ك",2,1],["أَلا قُل لِلعَواذل كُلّ أَعمى","أراني عَن نَصيحته أَصمّا",143,"م",2,0],["إلاّ قريضٌ رائقٌ رُبَّما","في نَفَرٍ منهمْ نَظَمْناه",144,"ا",2,0],["ألا قاتلَ اللهُ المطامعَ إنّما","تُذِلُّ عزيزاتِ النّفوسِ المَطامع",145,"ع",1,0],["ألا قُلْ لسَعْدِ المُلْكِ دام علاؤه","وقد يَعطِف المَولَى الكريمُ على العَبدِ",146,"د",1,1],["إلا قَليلٌ قلَّ فيه","عَزاءُ صَبٍّ مُستَهامِ",147,"م",1,0],["ألا قُل لأَبي الفَتحِ","إذا لاقَيتَه سِرَّا",148,"ر",2,1],["الا قليلا ولا حكم على من ندر","يجلي الهم ذي عندي ظهر وانتشر",149,"ر",1,0],["ألا قُل لتاجِ المُلكِ سيِّدنا نَضرِ","حليف العلى فَرد الورى غُرِّة العصرِ",150,"ر",1,1],["أَلا قاتِل اللَهَ الحمام فَإِنَّها","بَكَت فَشَجَت قَلباً طَروباً إِلى هِندِ",151,"د",1,0],["الأقل لصرافٍ يعد هباته","متى حصر البحر العرمرم بالعدِ",152,"د",1,0],["ألا قاتلَ اللهُ العيونَ فإنّها","تحكّمُ فينا عزةً وتَجورُ",153,"ر",1,0],["ألا قاتل الله الجمال فإنها","أقلّ جمالا مبدعا فيه واسمه",154,"م",2,0],["ألا قَلَّما يقضِي من الحبِّ حاجةً","مُعنّىً بنفسٍ عُلِّقتْ حاجةً أُخرَى",155,"ر",2,0],["أَلا قاتَلَ اللَهُ الهَوى ما أَشَدَّهُ","وَأَصرَعَهُ لِلمَرءِ وَهوَ جَليدُ",156,"د",1,0],["أَلا قَد يُرَجُّونَ الهَوانَ فَإِنَّهُم","بَنو حَبِق ناءٍ عَنِ الخَيرِ فائِلِ",157,"ل",1,0],["أَلا قِف بِرَسمِ الدارِ واستَنطِق الرَسما","فَقَد هاجَ أَحزاني وَذَكَّرَني نُعما",158,"م",2,1],["ألا قرَّبَ اللهُ احبابنَا","واِن هجروني واِن أزْمَعوا",159,"ع",3,0],["أُلاقي المَنايا كَي ألاقي عَبيدَهُمْ","وأودِعُ روحي لَهْفَةً للمُوَدِّعِ",160,"ع",1,0],["ألا قل لعز الدين لا زال جده","عزيزاً وأما ضده فذليل",161,"ل",1,1],["ألا قل لكتاب الصناعة كلهم","وخص أبا النقص المكنى أبا الفضل",162,"ل",1,1],["أَلاَ قُلْ لِشَيْخِ الْمُسْلِمِينَ مُحَمّدٍ","حَلِيفِ التُّقَى والزُّهْدِ بَدْرِ تِمامِ",163,"م",1,1],["أَلاَ قُلْ لِمَوْلانَا الإمامِ مَناخُنَا","بِحُصْنِ مَسارٍ لا بِحُصْنِ شِبَامِ",164,"م",1,1],["ألا قبَّحَ اللهُ اللِّئامَ ومَن أتى","إليهِم ولو أدَّى به الأمرُ لِلحدِّ",165,"د",1,0],["الأَقرَبينَ فَلَم تَنفَع قَرابَتُهُم","وَالموجَعينَ فَلَم يَشكوا مِنَ الأَلَمِ",166,"م",1,0],["ألا قوّضوا تلك الخيامَ على الرُّبا","وكُبّوا جِفاناً للقِرى ومَقارِيا",167,"ي",2,0],["ألا قلْ للوزير مقالَ مُثْنٍ","بما يولي من المِنَنِ الجِسامِ",168,"م",1,1],["ألا قلْ لمن ملَّ الطّريق إلى العِدا","وَقَد ملّ من مسِّ الرِّحال سَنامُ",169,"م",1,0],["ألا قلْ للأُلى ملكوا البرايا","وعشعش في ديارهمُ النّعيمُ",170,"م",1,0],["ألا قلتَ ما يا ليتَ ما كنتَ قلتَه","فكم ضَرَمٍ في القلب من قول قائلِ",171,"ل",1,0],["أَلا قاتل اللَّهُ الهوى فطِلابُهُ","متاعٌ من الدّنيا قليلٌ وزُخرُفُ",172,"ف",1,0],["أَلا قُلْ لِناعِي جعفرِ بنِ محمّدٍ","وأسمَعني يا ليت لم أكُ أسمعُ",173,"ع",1,0],["أَلا قولوا لِمَنْ يَملِ","كِ تقريبِي وإبعادِي",174,"ي",1,0],["أَلا قُلْ للأَخايرِ من قريشٍ","وسُكَّانِ الظّواهِرِ والبِطاحِ",175,"ح",1,0],["ألا قلْ للأجادِلِ من بُوَيْهٍ","أرى أوَداً شديداً وَاِعوِجاجا",176,"ج",2,0],["أَلا قَبحَ الإِلهُ وُجوهَ قومٍ","أَذلّوا في طِلابهمُ الرّقابا",177,"ب",2,0],["أَلا قُل للأُلى زمّوا المَطايا","وَعالوها الهَوادجَ والقِبابا",178,"ب",2,0],["إلا قليلا منهم قد علموا","ما كان من نبيهم فاتصموا",179,"م",3,0],["إلا قليلا فاستراح حزبه","وزال عنه همه وكربه",179,"ه",1,0],["أُلاقي مِن رِجالٍ مُنكَراتٍ","فَأُنكِرُها وَما أَنا بِالغَشومِ",180,"م",1,0],["ألا قُلْ لصَرفِ الدَّهرِ قد عَلِقَتْ يَدِي","بِحبْلٍ مَتينٍ منه فلْيَبْلغ الحَدَّا",181,"د",2,0]]}