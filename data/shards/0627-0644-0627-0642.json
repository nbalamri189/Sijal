tps://www.aldiwan.net/poem64923.html","المتقارب"],[51,"ألا قل لذي العطن الواسع","https://www.aldiwan.net/poem65403.html","المتقارب"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[51,"ترى الأفدام يعتلفون ثوما","https://www.aldiwan.net/poem66034.html","الوافر"],[38,"ألا قبح الله الحطيئة إنه","https://www.aldiwan.net/poem7839.html","الطويل"],[32,"ألا قد أرى إلا بثينة للقلب","https://www.aldiwan.net/poem27755.html","الطويل"],[32,"ألا ناد عيرا من بثينة ترتعي","https://www.aldiwan.net/poem27781.html","الطويل"],[43,"هو البين حتى ما تأنى الحزائق","https://www.aldiwan.net/poem9738.html","الطويل"],[62,"حل وعقد وأثال وأوزان","https://www.aldiwan.net/poem52227.html","البسيط"],[28,"فأنت إذ لم تكن إياه صاحبه","https://www.aldiwan.net/poem5082.html","البسيط"],[28,"إذا خندف بالليل أسدف سجرها","https://www.aldiwan.net/poem5206.html","الطويل"],[28,"أقول لصاحبي من التعزي","https://www.aldiwan.net/poem5236.html","الوافر"],[28,"ألا قبح الله الكروس والتي","https://www.aldiwan.net/poem5263.html","الطويل"],[28,"وركب قد استرخت طلاهم من السرى","https://www.aldiwan.net/poem5467.html","الطويل"],[61,"إذا الشيب باعد بين القلوب","https://www.aldiwan.net/poem51663.html","المتقارب"],[58,"ألا قد أرى والله أن لست منكم","https://www.aldiwan.net/poem30890.html","الطويل"],[49,"ألا من لنفس في الهوى قد تمادت","https://www.aldiwan.net/poem10840.html","الطويل"],[49,"خذ الناس أو دع إنما الناس بالناس","https://www.aldiwan.net/poem62127.html","الطويل"],[49,"ألا قل لابن معن ذا","https://www.aldiwan.net/poem64281.html","الهزج"],[66,"وحق الهوى ما حلت يوما عن الهوى","https://www.aldiwan.net/poem39641.html","الطويل"],[66,"ألا قل لشر عبيد الإله","https://www.aldiwan.net/poem41383.html","المتقارب"],[80,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[87,"نعاء عليه أيها الثقلان","https://www.aldiwan.net/poem8232.html","الطويل"],[87,"بأي غزال في الخدور تهيم","https://www.aldiwan.net/poem8259.html","الطويل"],[69,"ألا قل لسيدنا الشاعر","https://www.aldiwan.net/poem28838.html","المتقارب"],[69,"اعتزل الناس ومل","https://www.aldiwan.net/poem29303.html","مجزوء الرجز"],[31,"ألا قل لهند إحرجي وتأثمي","https://www.aldiwan.net/poem41824.html","الطويل"],[31,"ألا قاتل الله الهوى حيث أخلقا","https://www.aldiwan.net/poem42038.html","الطويل"],[74,"ألا قل للمريض القلب مهلا","https://www.aldiwan.net/poem12826.html","الوافر"],[74,"ألا قصر كل بقاء ذهاب","https://www.aldiwan.net/poem12864.html","المتقارب"],[74,"ألا قل لذات الخال عني إنني","https://www.aldiwan.net/poem12907.html","الطويل"],[74,"ألا قانع من ملك كسرى بكسرة","https://www.aldiwan.net/poem12953.html","الطويل"],[33,"ألا فاسأل الركبان هل سقي الحمى","https://www.aldiwan.net/poem25709.html","الطويل"],[33,"شكوت إلى سرب القطا إذ مررن بي","https://www.aldiwan.net/poem25928.html","الطويل"],[33,"زها جسم ليلى في الثياب كما زها","https://www.aldiwan.net/poem25953.html","الطويل"],[33,"ألا قاتل الله الهوى ما أشده","https://www.aldiwan.net/poem25966.html","الطويل"],[33,"فما وجد أعرابية قذفت بها","https://www.aldiwan.net/poem25978.html","الطويل"],[33,"أمن أجل خيمات على مدرج الصبا","https://www.aldiwan.net/poem26028.html","الطويل"],[105,"ركدت وهبت لوعة الحزن تدأب","https://www.aldiwan.net/poem42108.html","الطويل"],[105,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[105,"سويلم ما قول ببيتك يفترى","https://www.aldiwan.net/poem44029.html","الطويل"],[21,"غدا جيران أهلك ظاعنينا","https://www.aldiwan.net/poem36142.html","الوافر"],[40,"ألا قل لمن أمسى بمكة قاطنا","https://www.aldiwan.net/poem42263.html","الطويل"],[40,"ألا قاتل الله الهوى كيف أخلقا","https://www.aldiwan.net/poem42279.html","الطويل"],[40,"يا عاذلي اليوم لا تعذلا","https://www.aldiwan.net/poem42343.html","السريع"],[48,"ألا قوموا إلى الكرخ","https://www.aldiwan.net/poem63331.html","الهزج"],[48,"ألا قل لعمر كيف أني واحد","https://www.aldiwan.net/poem63398.html","الطويل"],[48,"ألا قل لأمين الله","https://www.aldiwan.net/poem64335.html","الهزج"],[48,"ألا قل لإسماعيل إنك شارب","https://www.aldiwan.net/poem65264.html","الطويل"],[48,"ألا قولا لحمدان","https://www.aldiwan.net/poem66129.html","الهزج"],[48,"ألا قبح الرحمن داحة أمردا","https://www.aldiwan.net/poem66237.html","الطويل"],[48,"ألا قل يلحي على حب شاطر","https://www.aldiwan.net/poem66545.html","الطويل"],[50,"ألا قل لعبدة إن جئتها","https://www.aldiwan.net/poem63871.html","المتقارب"],[50,"لقد ودعت حبي وهام رقيبي","https://www.aldiwan.net/poem64804.html","الطويل"],[50,"ألا قل لتلك المالكية أصحبي","https://www.aldiwan.net/poem64863.html","الطويل"],[46,"شربت الراح بالراح","https://www.aldiwan.net/poem23110.html","الهزج"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85334","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/384","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39665","الطويل"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8237","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16678","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9885","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9918","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42606","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42549","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142038","المتقارب"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1930","الطويل"],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[90,"الإقطاع","https://www.poetsgate.com/ViewPoem.aspx?id=179169",""],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[0,"ألا قبح الله البراجم كلها","https://www.poetsgate.com/ViewPoem.aspx?id=4790",""],[31,"ألا قاتلَ الله الهوى حيثُ أخلقا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18984&r=&rc=247",""],[31,"إحرجي وتأثمي،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19045&r=&rc=308",""]],"verses":[["أَلا قاتَلَ اللَهُ هَذا الأَنامَ","وَقاتَلَ ظَنّي وَآمالِيَه",0,"ي",2,0],["أَلا قَطَعَ الناسُ حَبلَ الوَفاء","وَأُولِعَ بِالغَدرِ خُلّانِيَه",0,"ي",2,0],["أَلا قاتَلَ اللَهُ الَّذي جاءَ غازِياً","فَقارَعَنا عَن مُخَّةِ الساقِ وَاِنتَقى",1,"ق",2,0],["أَلا قاتَلَ اللَهُ الطُلولَ البَوالِي","وَقاتَلَ ذِكراكَ السِنينَ الخَوالِيا",2,"ي",2,1],["أَلا قَد جَنى طَرفي عَلَيَّ بَلِيَّةً","أَعوذُ بِكَ اللَهُمَّ مِن شَرِّ ما يَجني",3,"ي",1,0],["أَلا قَد قَدَمَت فَوزٌ","فَقَرَّت عَينُ عَبّاسِ",4,"س",1,0],["أَلا قُل لِتَيّاكَ ما بالُها","أَلِلبَينِ تُحدَجُ أَحمالُها",5,"ل",3,1],["أَلا قُل لِتَيّا قَبلَ مِرَّتِها اِسلَمي","تَحِيَّةَ مُشتاقٍ إِلَيها مُتَيَّمِ",6,"م",1,1],["أَلا قَبَّحَ اللَهُ البَراجِمَ كُلَّه","وَجَدَّعَ يَربوعاً وَعَفَّرَ دارِها",7,"ه",2,1],["أَلا قَبَّحَ اللَهُ القَصيبَةَ قَريةً","وَمَرأَةَ مَأوى كُلِّ زانٍ وَسارِقِ",8,"ق",1,0],["أَلا قَبَحَ اللَهُ اِمرَأَ الَقيسِ إِنَّها","كَثيرٌ مَخازيها قَليلٌ عَديدُها",9,"د",3,0],["ألا قدّس الرحمن نفساً كريمة","بكلِّ عزيز في الوجود نُفدّيها",10,"ي",3,0],["ألا قل في الطلاق لمُوقِعِيه","بما في الشرع ليس له وجوب",11,"ب",1,0],["ألا قل لمن جاروا علينا بحكمهم","رُوَيداً فقد قارفتم كل مأثمَ",12,"م",1,0],["أَلا قَبَحَ الإِلَهُ بَني عِقالٍ","وَزادَهُمُ بِغَدرِهِمِ اِرتِيابا",13,"ب",2,0],["إِلّا قَتيلاً قَد سَلَبنا بَزَّهُ","تَقَعُ النُسورُ عَلَيهِ أَو مَصفودا",14,"د",2,0],["أَلا قَبَحَ اللَهُ الفَرَزدَقَ كُلَّما","أَهَلَّ مُصَلٍّ لِلصَلاةِ وَكَبَّرا",15,"ر",2,0],["أَلا قَبَّحَ اللَهُ يَومَ الزُبَيرِ","بَلاءَ القُيونِ وَأَخبارَها",16,"ر",3,0],["أَلا قُل لِبَرّادٍ إِذا ما لَقيتَهُ","وَبَيِّن لَهُ إِنَّ البَيانَ مِنَ الصِدقِ",17,"ق",1,0],["أَلا قُل لِرَبعٍ بِالأُفاقَينِ يَسلَمِ","يُحَيّا عَلى شَحطٍ وَإِن لَم يُكَلَّمِ",18,"م",1,1],["أَلا قُل لِسَيفِ الدَولَةِ القَرمِ إِنَّني","عَلى كُلِّ شَيءٍ غَيرِ وَصفِكَ قادِرُ",19,"ر",1,0],["ألا قل لقاضي قضاة الأنام","أمام التقى ذي الفخار العربق",20,"ق",1,1],["ألا قل لمولانا الإمام أخي التقى","أغثني فعندِي للعلاء غليل",21,"ل",1,1],["ألا قُلْ لسيدنا قل له","مقالاً إذا قيل لم يُفْسخِ",22,"خ",1,1],["ألا قاتَل اللَّهُ المنايا ورَمْيَها","من القَوْمِ حَبَّات القُلوب على عَمْدِ",23,"د",1,0],["ألا قُل لنحويِّكَ الأخفشِ","أنِسْتَ فأقصِرْ ولم تُوحِشِ",24,"ش",1,1],["ألا قل لذي العطن الواسعِ","أخي المجد والشرف اليافعِ",25,"ع",1,1],["إلّا قرأتم على مؤمَّلِنا","سلام صادي الأحشاء خافقها",26,"ق",3,0],["ألا قُبحاً على قبح وسُحقاً","لهاتيك المناظرِ والجُسومِ",27,"م",1,0],["أَلا قَبَّحَ اللَهُ الحُطَيئَةَ إِنَّهُ","عَلى كُلِّ ضَيفٍ ضافَهُ فَهوَ سالِحُ",28,"ح",1,1],["أَلا قَد أَرى إِلّا بُثَينَةَ لِلقَلبِ","بِوادي بَدِيٍّ لا بِحِسمى وَلا شَغبِ",29,"ب",1,1],["أَلا قَد أَرى إِلّا بُثَينَةَ هَهُنا","لَنا بَعدَ ذا المُصطافِ وَالمُتَرَبَّعِ",30,"ع",1,0],["أَلا قَلَّما تَبقى عَلى ما بَدا لَها","وَحَلَّ بِها مِنكَ القَنا وَالسَوابِقُ",31,"ق",1,0],["إلا قلائل من أسرارنا كتمت","منها أداة وأيام ونيران",32,"ن",1,0],["إِلّا قُرَيشاً فَإِنَّ اللَهَ فَضَّلَها","مَعَ النُبُوَّةِ بِالإِسلامِ وَالخيرِ",33,"ر",1,0],["أَلا قَبَّحَ اللَهُ الأَصَمَّ وَأُمَّهُ","وَنَذرَهُما الموفى الخَبيثِ مِنَ النَذرِ",34,"ر",1,0],["أَلا قَبَحَ الإِلَهُ بَني كُلَيبٍ","ذَوي الحُمُراتِ وَالعَمَدِ القِصارِ",35,"ر",1,0],["أَلا قَبَحَ اللَهُ الكَرَوَّسَ وَالَّتي","مَشَت سَنَةً في بَطنِها بِالكَرَوَّسِ",36,"س",1,1],["أَلا قَبَّحَ اللَهُ القَلوصَ الَّتي سَرَت","بِرَحلي إِلى خَصيَي عِدانِ المُهَمَّلِ",37,"ل",1,0],["أُلاقي الظلامَ بمثلِ الظَّلامِ","وألقى النهارَ بمثلِ النَّهارِ",38,"ر",1,0],["أَلا قَد أَرى وَاللَهِ أَن لَستُ مِنكُمُ","وَلا أَنتَمُ مِني وَإِن كُنتُمُ أَهلي",39,"ي",1,1],["أَلا قَلَّما تَبقى نُفوسٌ لِأَهلِها","إِذا راوَحَتهُنَّ المَنايا وَغادَتِ",40,"ت",1,0],["أَلا قَلَّ ما يَنجو ضَميرٌ مِنَ المُنى","وَفيهِ لَهُ مِنهُنَّ شُعبَةُ وَسواسِ",41,"س",1,0],["أَلا قُل لِابنِ مَعنٍ ذا ال","لَذي في الوُدِّ قَد حالا",42,"ل",2,1],["أَلا قُل لِذاتِ الخالِ يا رَبَّةَ الذَكا","وَمَن بِضِياءِ الوَجهِ فاقَت عَلى ذُكا",43,"ك",2,0],["أَلا قُل لِشَرِّ عَبيدِ الإِلَ","هِ وَطاغي قُرَيشٍ وَكَذّابِها",44,"ب",3,1],["إلّا قصائدُ بالمحامدِ صُغْتُها","غُرّاً تهزّ مَحافلَ الإِنشادِ",45,"د",1,0],["أَلا قَاتَلَ اللَّهُ الْحَيَاةَ فَإِنَّهَا","إِلَى الْمَوْتِ أَدْنَى مِنْ فَمٍ لِبَنَانِ",46,"ن",1,0],["أَلا قَاتَلَ اللَّهُ الْهَوَى مَا أَلَذَّهُ","عَلَى أَنَّهُ مُرُّ الْمَذَاقِ أَلِيمُ",47,"م",1,0],["ألا قلْ لسيدنا الشاعرِ","ولا تخشَ منْ طبعهِ النافرِ",48,"ر",1,1],["إلا قليلاً قال عن","دنياهُ أنتِ طالقَهْ",49,"ق",2,0],["أَلا قُل لِهِندٍ إِحرَجي وَتَأَثَّمي","وَلا تَقتُليني لا يَحِلُّ لَكُم دَمي",50,"م",2,1],["أَلا قاتَلَ اللَهُ الهَوى حَيثُ أَخلَقا","فَما إِن تَرى إِلّا مَشوباً مُمَذَّقا",51,"ق",2,1],["أَلا قُل لِلمَريضِ القَلبِ مَهلاً","فَإِنَّ السَيفَ قَد ضَمِنَ الشِفاءَ",52,"ا",2,1],["أَلا قَصرُ كُلِّ بَقاءٍ ذَهاب","وَعُمرانُ كُلِّ حَياةٍ خَراب",53,"ب",1,1],["أَلا قُل لِذاتِ الخالِ عَنّي إِنَّني","لَأَرغَبُ عَن خالٍ تَطَلَّعَ في خَدِّ",54,"د",1,1],["أَلا قانِعٌ مِن مُلكِ كِسرى بِكِسرَةٍ","فَما الوَجدُ إِلّا الخُلدُ لاماجَنى كِسرى",55,"ر",2,1],["أَلا قُل لَهُم ما قَد تَرى مِن صَبابَتي","وَمِن أَدمُعِ تَنهَلُّ مِنّي تَوالِيا",56,"ي",2,0],["أَلا قُل لِلَيلى هَل تُراها مُجيرَتي","فَإِنّي لَها فيما لَدَيَّ مُجيرُ",57,"ر",1,0],["أَلا قُل لِلَيلى قَد وَهَبتُ لَها دَمي","وَجُدتُ بِنَفسي قَد نَعاها عَزيزُها",58,"ه",2,0],["أَلا قاتَلَ اللَهُ الهَوى ما أَشَدَّهُ","وَأَسرَعَهُ لِلمَرءِ وَهوَ جَليدُ",59,"د",1,1],["أَلا قاتَلَ اللَهُ الحَمامَةَ غَدوَةً","عَلى الغُصنِ ماذا هَيَّجَت حينَ غَنَّتِ",60,"ت",1,0],["أَلا قاتَلَ اللَهُ اللَوى مِن مَحَلَّةِ","وَقاتَلَ ذُؤباناً بِها كَيفَ وَلَّتِ",60,"ت",1,0],["أَلا قاتَلَ اللَهُ الرَكائِبَ إِنَّما","تُفَرِّقُ بَينَ العاشِقينَ الرَكائِبُ",61,"ب",1,0],["أَلاَ قَدَرٌ للهِ يجرِي سَنيحُه","بحاجاتها أو آيةٌ منه تُكتَبُ",62,"ب",1,0],["أَلا قاتل اللَهُ المقطَّمَ إِنَّهُ","لَيُوشِك أَن يندكَّ مِنهُ المقطَّمُ",63,"م",1,0],["ألا قُمْ فَأدْرِكْهُم ولمَّا يُصِبْهُمُ","عَذابٌ غَليظٌ ما لهم منه مَهْرَبُ",64,"ب",1,0],["أَلا قُل لِلقبائِل إِنَّ بَكراً","وَتَغلِبَ بَعدَ حَربِهِم سِنينا",65,"ن",2,0],["أَلا قُل لِمَن أَمسى بِمَكَّةَ قاطِناً","وَمِن جاءَ مِن عَمقٍ وَنَقبِ المُشَلَّلِ",66,"ل",1,1],["أَلا قاتَلَ اللَهُ الهَوى كَيفَ أَخلَقا","وَلَم تَلقَهُ إِلّا مَشُوباً مُمَذَّقا",67,"ق",2,1],["إِلّا قَليلاً لَيتَهُ لَم يَكُن","شَيئاً كَنَومِ الخائِفِ الأَرمَدِ",68,"د",1,0],["أَلا قوموا إِلى الكَرخِ","إِلى مَنزِلِ خَمّارِ",69,"ر",1,1],["أَلا قُل لِعَمرٍ كَيفَ أَنِّيَ واحِدٌ","وَمِثلُكَ يا ذا في الأَنامِ كَثيرُ",70,"ر",1,1],["أَلا قُل لِأَمينِ اللَ","هِ وَاِبنِ القادَةِ الساسَه",71,"س",2,1],["أَلا قُل لِإِسماعيلَ إِنَّكَ شارِبٌ","بِكَأسِ بَني ماهانَ ضَربَةَ لازِمِ",72,"م",1,1],["أَلا قولا لِحَمدانِ","أَيا فاسِقَ مُردانِ",73,"ن",1,1],["ألا قبّح الرحمنُ داحةَ أمردا","أراد اقتداءٌ بالرقاشيّ فاقتدى",74,"د",2,1],["ألا قل يلحي على حبِّ شاطر","ويحكمُ في الأشياءِ حكماً بظاهرِ",75,"ر",1,1],["أَلا قُل لِعَبدَةَ إِن جِئتَها","وَقَد يُبلِغُ الأَقرَبُ الباعِدا",76,"د",2,1],["أَلا قُل لِعُزّابِ البُصَيرَةِ أَقبِلوا","بِحاجَتِكُم مِن نازِحٍ وَقَريبِ",77,"ب",1,0],["أَلا قُل لِتِلكَ المالِكِيَّةِ أَصحِبي","وَإِلّا فَمَنّينا لِقاءَكِ وَاِكذِبي",78,"ب",2,1],["أَلا قَد ذَهَبَ الناسُ","وَنِضوي رِزامٌ بارِك",79,"ك",1,0],["الأقوياء بكل أَرض قد قضوا","أن لا تُراعى للضَعيق حقوق",80,"ق",1,0],["إلا قصَدتَ لحاجَتي","وأعَنتَ عبدَكَ يا عليّ",81,"ي",1,0],["ألاقَيْتَ في أجوائها غيرَ طيرها","على نَسَماتٍ في الغصون تُهَيْنِمُ",82,"م",1,0],["أَلا قَد أَرى وَاللَهِ أَن رُبَّ عُبرَةٍ","إِذا الدار شَطَّت بَينَنا سَتَزيدُ",83,"د",1,0],["أُلاقي الدّارِعينَ بغيرِ دِرْعٍ","وأدْعو بالمُدَجَّجِ لا تَفُتْني",84,"ن",2,0],["أَلا قاتَلَ اللَهُ الطُلولَ البَوالِيا","وَقاتَلَ ذِكراكَ السِنينَ الخَوالِيا",85,"ي",2,1],["أَلا قاتَلَ اللَهُ الهَوى كَم بِسَيفِهِ","قَتيلُ غَرامٍ لا يُوَسَّدُ في اللَحدِ",86,"د",1,0],["أَلا قَبَّحَ اللَّهُ الْجَهَالَةَ إِنَّهَا","عَدُوَّةُ مَا شَادَتْهُ فِينَا يَدُ الْفِكْرِ",87,"ر",1,0],["أَلا قُلْ لِقَوْمٍ شَامِتِينَ تَرَبَّصوا","تَهَزُّمَ شَرٍّ بِالْمَنِيَّة كارِثِ",88,"ث",1,1],["ألا قطرة عرس قانا الجليل","ولوبين جُدرانك الدائره",89,"ر",2,0],["أَلا قَبَّحَ اللَهُ البَراجِمَ كُلَّها","وَجَدَّعَ يَربوعاً وَعَفَّرَ دارِها",90,"ه",2,1],["ألاَ قل لمن طَافَ حول الفضاءِ","ورام الكواكب فَارْتَادها:",91,"د",3,0],["ألا قُوَّةٌ تسطيعُ دفع المَظالِمِ","وإنعاشَ مخلوقٍ على الذُّلِّ نائِمِ",92,"م",1,1],["ألا قبساً من شُعاعِ الكليم","تُعيدُ على الشَّرق يا\" طُورَ سينا \"",93,"ن",2,0],["ألا قبح الله البراجم كلها","وجدع يربوعاً وعفر دارما",94,"م",2,1],["ألا قاتلَ الله الهوى حيثُ أخلقا،","فما انْ ترى إلا مشوياً ممذقا",95,"ق",2,1],["ألا قلْ لهندس: إحرجي وتأثمي،","وَلا تَقْتُليني، لا يَحلُّ لَكُمْ دَمي",96,"م",2,1]]}