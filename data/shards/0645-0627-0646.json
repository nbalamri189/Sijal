لرجز"],[459,"حاشاك من عارية ترد","https://www.aldiwan.net/poem56234.html","الوافر"],[459,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[459,"مالكم لا تغضبون للهوى","https://www.aldiwan.net/poem56311.html","الرجز"],[465,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[465,"لنا بسمر الحمى في الحي أسمار","https://www.aldiwan.net/poem3186.html","عموديه"],[465,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[465,"ما على الركب من تلافي تلافي","https://www.aldiwan.net/poem3215.html","عموديه"],[465,"حي ظباء بالعقيق غيدا","https://www.aldiwan.net/poem3466.html","عموديه"],[465,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[465,"ما نال من وصلكم بعض الذي وجبا","https://www.aldiwan.net/poem3498.html","عموديه"],[465,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[501,"وحي السماء منزل ببيوتنا","https://www.aldiwan.net/poem37804.html","الكامل"],[501,"تحت شراع الرفرف","https://www.aldiwan.net/poem37961.html","مجزوء الرجز"],[530,"تروم نفسي أن يدوم الوصال","https://www.aldiwan.net/poem37265.html","السريع"],[530,"ما نظرت عيناي كالأهجر","https://www.aldiwan.net/poem37381.html","السريع"],[552,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[552,"ضرم قلبي فاضطرم","https://www.aldiwan.net/poem47190.html","مجزوء الرجز"],[552,"كنا جميعا ثم فرق بيننا","https://www.aldiwan.net/poem47225.html","الكامل"],[552,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"],[552,"يا قاتلي إن كنت ترضي","https://www.aldiwan.net/poem47267.html","مجزوء الكامل"],[552,"يا خليلي ومعيني","https://www.aldiwan.net/poem47735.html","مجزوء الرمل"],[552,"إما بقيت فهلك غيرك هين","https://www.aldiwan.net/poem47818.html","الكامل"],[552,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[552,"هل شافع لي إلى نعم وسيلتها","https://www.aldiwan.net/poem47879.html","البسيط"],[552,"ما نحن إلا للفناء","https://www.aldiwan.net/poem48110.html","مجزوء الكامل"],[554,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[559,"شمس لها قلب الموحد مطلع","https://www.aldiwan.net/poem34390.html","الكامل"],[559,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[563,"إن لم لك يكن في نقد الرجال يد","https://www.aldiwan.net/poem52863.html","البسيط"],[563,"ما بال تلك الشامة الخضراء","https://www.aldiwan.net/poem52869.html","الكامل"],[568,"محاسن الدير تسبيحي ومساحي","https://www.aldiwan.net/poem69749.html","البسيط"],[576,"أما الغرام بها فعاد كما بدا","https://www.aldiwan.net/poem3079.html","الكامل"],[587,"لا تخف ما صنعت بك الأشواق","https://www.aldiwan.net/poem17611.html","الكامل"],[587,"ما ناح على الغصون في الدوح حمام","https://www.aldiwan.net/poem17774.html","الدوبيت"],[587,"ما ناح حمام الأيك في الأغصان","https://www.aldiwan.net/poem17806.html","الدوبيت"]],"verses":[["ما ناقَلَت رَكبُ الرِكابِ إِلى مِنىً","وأَراقَ مِن عَلَقِ الدِماءِ المَوسِمِ",0,"م",1,0],["ما نازِلُ الشَيبِ في رَأسي بِمُرتَحِلٍ","عَنّي وَأَعلَمُ أَنّي عَنهُ مُرتَحِلُ",1,"ل",1,0],["مانِعٌ لا يَجودُ بِالنَيلِ مَمنو","عٌ بِرَزٍ مِنَ القَنا وَحَفيفِ",2,"ف",1,0],["ما ناهَضَ الرِحلَةَ الخَرقاءَ مُعتَقِلاً","بِالحَزمِ مَن فَلَّ مِن آرائِهِ السَفَرُ",3,"ر",1,0],["ما نَرى عِندَ غَيرِكُم مِن جَميلٍ","لَيسَ إِلّا مِن عِندِكُم مُستَعارا",4,"ر",2,0],["ما نِمتُ عَنهُ إِلّا وَأَيقَظَني","مِنَ الرَزايا بِفَيلَقٍ لَجِبِ",5,"ب",1,0],["ما نالَ مَدحي أَبو نَصرٍ بِنائِلَةٍ","وَلا بِسُلطانِ تَرغيبٍ وَتَرهيبِ",6,"ب",1,0],["ما نحْنُ مِنْ سُوَقٍ فَنُشْبِهَهُمْ","لَمْ يَنْمِنا إِلّا أَبٌ مَلِكُ",7,"ك",1,0],["ما نِلتُ مِن هَذهِ الدُنيا وَلَذَّتِها","كَشَربَةٍ نِلتُها في البَيتِ ذي الطاقِ",8,"ق",1,0],["ما نُبالي إِذا صَحِبنا أَمينَ اللَ","هِ هارونَ أَن يَطولَ المَغيبُ",9,"ب",1,0],["ما نِمْتُ لكنّ الخَيالَ يُلمُّ بي","فيُجِلُّهُ طرْفي فيطْرُقُ ساجِدا",10,"د",2,0],["ما نَظَرَت ذاتُ أَشفارٍ كَنَظرَتِها","حَقّاً كَما صَدَقَ الذِئبِيُّ إِذ سَجَعا",11,"ع",2,0],["ما نُجومُ الرَجمِ مِن أَبراجِها","إِثرَ عِفريتٍ مِنَ الجِنِّ تَرامى",12,"م",2,0],["ما نالَ سِرَّ الهَوى مِمَّن كلفتُ بِهِ","مِنّي صَديقٌ وَلا أَبثَثتَهُ بَشَرا",13,"ر",2,1],["ما نضوبي لدى إفاضة فياض","وألفاظه العذاب سجام",14,"م",1,0],["مَا نَفَقَاتُ المَالِ إِلاَّ عَلَى","مَا تَشْتَهِيهِ النَّفْسُ بِالهَيِّنَهْ",15,"ن",2,0],["ما نفع تسمية الأماكن باسم من","خلت الضمائر منه والأفكار",16,"ر",1,0],["ما نرى سلطة علينا لخلقٍ","غير سلطان خالق الأكوان",17,"ن",1,0],["ما نضا في الدفاع عنهم بنو الغر","بِ حساماً ولا أحاروا كلاما",18,"م",2,0],["ما نابَ مِن حَدَثٍ فَلَيسَ بِمُسلِمي","عَمري وَحَنظَلَتي وَلا السَعدانِ",19,"ن",1,0],["ما نالَتِ الأَزدُ مِن دَعوى مُضِلِّهِمُ","إِلّى المَعاصِمَ وَالأَعناقَ تُختَطَفُ",20,"ف",1,0],["ما نَظرَةٌ لَكَ يَومَ تَجعَلُ دونَها","فَضلَ الرِداءِ وَتَتَّقي بِالمِعصَمِ",21,"م",1,0],["مانُزِّهَت لِرَسولِ اللَهِ مُهجَتُهُ","عَنِ السِياطِ فَهَلّا نُزِّهَ الحَرَمُ",22,"م",1,0],["مانالَ مِنهُم بَنو حَربٍ وَإِن عَظُمَت","تِلكَ الجَرائِرُ إِلّا دونَ نَيلُكُمُ",22,"م",1,0],["ما نَقَمتُم مِن ثِيابٍ خِلفَةٍ","وَعَبيدٍ وَإِماءٍ وَذَهَب",23,"ب",1,1],["ما نَخشى بِحَمدِ اللَهِ قَوماً","وَإِن كَثُروا وَأُجمِعَتِ الزُحوفُ",24,"ف",1,1],["ما نافعي سعةٌ في العيشِ أو حرجٌ","إن لم تسعنيَ رُحمى الواحدِ الصمدِ",25,"د",1,0],["ما نالَني عِندَ الهُجومِ البَلا","بَأَسٌ وَلا مَسَّنِيَ الضُرُّ",26,"ر",1,0],["ما نهضتْ عن مجلس ساعةً","إلا وجدنا تحتها مَجَّهْ",27,"ج",2,0],["ما نَذُمُّ امرءاً حميداً ولكن","هل حميدٌ وقد بلونا حميدَكْ",28,"ك",1,0],["ما نال منه منالَه من نفسه","وِترُ الأُلى وَتَروه بالأوتارِ",29,"ر",1,0],["ما نعمةُ اللِّه فيه راضيةً","صدَّك عنهُ بوجهك النضرِ",30,"ر",1,0],["ما نكهتْ في مجلس شُنطفٌ","إلا خَشينا قتلَها نفسا",31,"س",2,1],["ما نسأل الدهر إتحافاً بغيركم","فأنتم كل إتحاف وإتراف",32,"ف",1,0],["ما نعرف الوعد والإيعاد من رجل","سواه إلا أمانيّاً وإرجافا",33,"ف",2,0],["ما نال منها ولا من فضل نجدته","ما نال من ثفر قسطنطينة الحوق",34,"ق",1,0],["ما نسألُ اللَّه أن تنالَ من ال","خيراتِ إلا عديدَ مَنْ حمدكْ",35,"ك",1,0],["ما نفلٌ جاءني فقُمْت به","في الناس إلا أردفْتَه نفلا",36,"ل",2,0],["ما نمتَ نومَ غريرةٍ في خِدْرها","لكن سَريْتَ سُرى الرجال رجيلا",37,"ل",2,0],["ما نبالي إذا دُرَيْرة أبدتْ","نُزْهَتَيْها ألا نرى بستانا",38,"ن",2,0],["ما نالَ بَعدَ جِهادِهِ إِلّا الرَدى","وَالبَدرُ يُكسِبُهُ المَسيرُ أُفولا",39,"ل",2,0],["ما نظمت القريض إلا بالها","م جديد من السماء لنفسي",40,"ي",1,1],["ما نحن الا اقرد","من نسل قرد هالك",41,"ك",1,1],["ما نسينا وقوفه بصلاح ال","دين والعالمون في نسيان",42,"ن",1,0],["ما نحن قلنا فالحب قائله","وما فعلنا فللهوى الفعل",43,"ل",1,0],["ما نلتُ مِنهُم فِضَّةً","وَلا مُنِحتُ ذَهَبا",44,"ب",2,0],["ما نَظَرَت مِثلَكَ عَينُ النَرجِسِ","بَعدَ مُلوكِ الظُرفِ في الأَندَلُسِ",45,"س",1,0],["ما نَسِيَت مِصرُ لَكُم بِرَّها","في حازِبِ الأَمرِ وَفي صَعبِهِ",46,"ب",2,0],["ما نَراها دَعا الوَفاءُ بَنيها","وَأَتاهُم مِنَ القُبورِ النِداءُ",47,"ا",2,0],["ما نالَ أَهلُ الجاهِلِيَّةِ كُلُّهُم","شِعري وَلا سَمِعَت بِسِحرِيَ بابِلُ",48,"ل",1,0],["ما نَقَلَت في مَشيئةِ قَدَماً","وَلا اِشتَكَت مِن دُوارِها أَلَما",49,"م",2,1],["ما نَفَضَت في يَدي غَدائِرُها","جَعَلَتهُ في المُدامِ أَفواها",50,"ا",3,0],["ما نَهاكَ الشِتاءُ عَنها وَفي صَد","رِكَ نارٌ لِلحِقدِ تُنهي الشِتاءَ",51,"ا",2,0],["ما نُبالي يَدُ الوَزيرِ اِستَهَلَّت","أَم رَأَيتَ العَقيقَ سالَت شِعابُه",52,"ب",2,0],["ما نَصيبونَ لي بِدارٍ وَمالي","بِنَصيبَينِ غَيرَ عِرضي نَصيبُ",53,"ب",1,0],["ما نُبالي أَيَّ الحُظوظِ فَقَدنا","ما تَراخى عَنّا فَأُمهِلَ فَقدُه",54,"د",2,0],["ما نُرى خِلفَةَ اللَيالي تُرينا","شَرَفاً مِثلَ بَأسِ خِضراً وَجودِه",55,"د",2,0],["ما نَسأَلُ اللَهَ إِلّا أَن تَدومَ لَكَ ال","نَعماءُ فينا وَأَن تَبقى لَنا أَبَدا",56,"د",2,0],["ما نالَ ما نالَ الأَميرُ مُحَمَّدٌ","إِلّا بِيُمنِ مُحَمَّدِ بنِ يَزيدِ",57,"د",1,1],["مانِعاً مِن جَليلِ ما أَسلَموهُ","إِنَّما يَدفَعُ الجَليلَ الجَليلُ",58,"ل",1,0],["ما نالَ لَيثُ الغابِ إِلّا بَعضَها","حَتّى رَعى مُهَجَ النُفوسِ حَميما",59,"م",2,0],["ما نَقَضتُم عَهداً وَلا خُنتُمُ غَي","باً وَحاشا لِمَجدِكُم أَن يَخونا",60,"ن",2,0],["ما نَحنُ إِن جارَت صُدورُ رِكابِنا","بِأَوَّلِ مَن غَرَّت هِدايَةُ عاصِمِ",61,"م",1,1],["ما نابتِ المجدَ والعلياءَ نائبةٌ","إلاّ وَجُودُ بني فَهدٍ تُحلِّيها",62,"ي",3,0],["ما نيلَ مجدُهُمُ وَأَنْ","ى يَلمُسُ الجوزاءَ لامِس",63,"س",1,0],["ما نَجا اللَهُ وَالرَسولُ مَعاً","مِن لِسانِ الوَرى فَكَيفَ أَنا",64,"ن",2,0],["ما نَحنُ فيهِ مَتاعُ أَي","يامٍ تُعارُ وَتُستَرَدُّ",65,"د",1,0],["ما نَحنُ إِلّا كَرَكبٍ ضَمَّهُ سَفَرٌ","يَوماً إِلى ظِلِّ فَيءٍ ثُمَّتَ اِفتَرَقوا",66,"ق",3,0],["ما نِلتُ مِنها لَذَّةً إِلّا وَقَد","أَبَتِ الحَوادِثُ أَن يَكونَ لَها دَوام",67,"م",1,0],["ما نُبالي أَمِن حَلالٍ جَمَعنا","أَم حَرامٍ وَلا يَحِلُّ الحَرامُ",68,"م",1,0],["ما نَرعَوي لِلحادِثا","تِ وَلا الخُطوبِ الجارِيَه",69,"ي",2,0],["ما نالَ ما قَد نالَ فِرعَونُ وَلا","هامانُ في الدُنيا وَلا قارونُ",70,"ن",1,0],["ما نيلَ حَتّى طارَ مِن خَوفِ الرَدى","كُلَّ المَطارِ وَجالَ كُلَّ مَجالِ",71,"ل",1,0],["ما نظيرٌ لقولي","باعَ أرضَ سوادِ",72,"د",1,0],["ما نلتَ خيراً في الذي قلتَهُ","أغضبتني عنكَ وأغضبْتَهُ",73,"ه",1,0],["ما نَرى راكِباً يُخَبِّرُ عَنكُم","أَو يُريدُ الحِجازَ إِلّا حِزَنّا",74,"ن",2,0],["ما نَلتَقي إِلّا ثَلاثَ مِنىً","حَتّى يُفَرِّقَ بَينَنا النَفرُ",75,"ر",1,0],["ما نَلتَقي إِلّا إِذا","نَزَلَت مِنىً بِقِبابِها",76,"ب",3,0],["ما نَستَفيقُ وَما نَزالُ لِحينِنا","في الخاسِرينَ مِنَ الوَرى أَعمالا",77,"ل",2,0],["ما نَأَى المؤمنُ عن عاداتِهِ","حين ينأى عن هَوانٍ وَضِعَهْ",78,"ع",2,0],["ما نالَتِ الآلامُ مِنهُ سِوى الَّذي","نالَ الصِقالُ مِنَ الحُسامِ المُرهَفِ",79,"ف",1,0],["ما نال مَنْ خدمَ البلادَ","أَجلَّ من أجْرِ الشهيدِ",80,"د",1,0],["ما نال مرتبةَ الخلو","د بغْيرِ تضحيةٍ رضيَّهْ",81,"ي",2,0],["ما نالَها أَحَدٌ مَضى وَمُريدُهُ","مِنهُ عَلى أَثَرٍ مِنَ الأَثارِ",82,"ر",1,0],["ما نِلتُ مِنهُ غَيرَ غَمزَةِ عَينِهِ","وَرَسائِلٍ بِوِصالِهِ أَو سُخطِهِ",83,"ط",2,1],["ما نِلتُ مِنهُ نائِلاً غَيرَ أَن","وافَقَ كُمّي كُمَّهُ فَاِلتَوى",84,"و",2,0],["ما نمْنَمَ الرّوْض أو حاكَتْ وشائعَهُ","أيدي السحابِ الغوادي الغُرِّ بالدِّيَم",85,"م",1,0],["ما نَوَّلَتكَ بِما تُطالِبُها","إِلّا مَواعِدَ كُلُّها فَنَدُ",86,"د",1,0],["ما نالَ فَضلَ بَني المُهَل","لَبِ مِنذُ كانوا جودُ جائِد",87,"د",1,0],["ما نَفَقَ الص