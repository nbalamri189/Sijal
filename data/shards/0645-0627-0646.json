امه ومؤخَّرُ",245,"ر",1,0],["ما نافعٌ جدِّي إلى أمَدٍ","جدّ الفَتى وَقدِ اِلتَوى الجَدُّ",246,"د",1,0],["ما نامَ ذِكرُكِ في قلبِي فيوقظُهُ","برقٌ سرى موهِناً أو طائرٌ غَرِدُ",247,"د",1,0],["ما نَحنُ إِلّا لِلفَناءِ","وَإِن طَمِعنا في البقاء",248,"ا",2,1],["ما نالَ حَمدَ القَولِ بَعدَ قِيامِهِ","فيها وَسَلِّ المَشرَفِيِّ المُغمَدِ",249,"د",1,0],["ما نالها إلا الذي هو محرمٌ","والأجنبيُّ على التباعد يطمع",250,"ع",1,0],["ما نفوس قد أسلمت كنفوس","عابدات من الهوى للصليب",251,"ب",1,0],["ما نومةٌ لَكَ يومُ الحَشْرِ مَوعِدُها","ويحي وما غيبةٌ ميعادُها الأبَدُ",252,"د",1,0],["ما نَرْتجي والحَرْبُ دائرةٌ إذا","قابَلْتِنا بالرَّايةِ البَيضاء",253,"ا",2,0],["ما نُورُ أَحْداقِنا إلا حَدَائِقَهُ","لاَمَ اللوائِمُ فِيْهِ أَوْ لْحَى اللاّحِي",254,"ح",2,0],["ما نالَت الأَملاكُ ما قد نلتَ في","عصرِ الشَّبابِ وبَعْدمَا بَعُد المَدَى",255,"د",2,0],["مَا نَاءَ إِلّا حَارَبَتْ أَرْدافُهُ","خَصْراً عَليهِ مِنَ العُيونِ نِطَاقُ",256,"ق",1,0],["ما ناحَ على الغُصُونِ في الدَّوْحِ حَمامْ","إلّا ولقيتُ مِنْكَ بِالشَّوْقِ حِمامْ",257,"م",1,1],["ما نَاحَ حَمامُ الأَيْكِ فِي الأَغْصانِ","إِلَّا وَتَزايَدتْ بِكُمْ أَشْجاني",258,"ي",1,1]]}