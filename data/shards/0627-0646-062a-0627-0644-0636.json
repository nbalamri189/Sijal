{"poems":[[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103094","البسيط"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46469","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137023",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66497","الكامل"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22805","البسيط"],[4691,"منك الأنوثة تقطر","https://www.poetsgate.com/ViewPoem.aspx?id=61787",""],[5111,"القَلمُ المُرَابِطُ","https://www.poetsgate.com/ViewPoem.aspx?id=212648",""],[307,"ملكة الدار","https://www.poetsgate.com/ViewPoem.aspx?id=214581",""],[5596,"اليحمدي","https://www.poetsgate.com/ViewPoem.aspx?id=206710",""],[5616,"إلى ممثلة","https://www.poetsgate.com/ViewPoem.aspx?id=205251",""],[5829,"الحبيب الأول","https://www.poetsgate.com/ViewPoem.aspx?id=211051",""],[5974,"أنت الضياء","https://www.poetsgate.com/ViewPoem.aspx?id=204626",""],[6152,"الصبح حين أراكِ يغدو جنة","https://www.poetsgate.com/ViewPoem.aspx?id=203731",""],[6312,"البؤرُ المتحركةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82949&r=&rc=4",""]],"verses":[["أنت الضليع بها حملا وتأديه","اذ كل أمرك تدبير واتقان",0,"ن",1,0],["أنت الضياء لنا في كل مظلمة","وظلمة في ضياء نوره لهب",1,"ب",1,0],["أَنتَ الضَعيف إِذا عَلا ما قُلتَهُ","وَالأَرعنُ الآتي بِكُل هُذاء",2,"ا",2,0],["انت الضياء لنا في كل داجية","وانت اجمل اهل الحزم عيدانا",3,"ن",2,0],["أنت الضياء لمقلتي فمتى تغب","يا ذا العلاء فإنّها عمياءُ",4,"ا",2,0],["أَنتِ الضَجيعُ إِذا ما نِمتُ في حُلُمي","وَالنَجمُ أَنتِ إِذا ما العَينُ لَم تَنَمِ",5,"م",1,0],["أنت الضياء وعين","إحساسي لحسنك تبصرُ",6,"ر",1,0],["أنْتَ الضِّيَا مِصْبَاحُ نُورٍ فِي الدُّجَى","يَضْوي الْمَدَارِسَ قُدْوَةً وَمِثَالا",7,"ل",2,0],["أنت الضمادُ من الجراحِ وقد غدتْ","في العظمِ أنيابُ اللئامِ حشودا",8,"د",2,0],["أنت الضليع إذا ما اللُسْن أخرسها","عِيٌّ وأربكها إن موقف أزِما",9,"م",2,0],["أَنْتِ الضَّحِيَّةُ أَنْتِ بَيْنَهُمُ","وَعَلَيْكِ ثُمَّ عَلَيْهِمُ الْوِزْرُ!",10,"ر",1,0],["انت الضياء وشمسه ونهاره","انت الثريا فازدهي وتكللي",11,"ل",2,0],["أنت الضياء لحب بات في خلدي","منذ الطفولة في الأحداق ما وهنا",12,"ن",2,1],["أنتِ الضياء وما عداكِ فظلمة","فالروح تشرق من سناكِ وتُسفر",13,"ر",1,0],["أنتَ الضُّحى، أنتَ الحنادِسُ كشَّرَتْ","أنيابَها، أنتَ الرؤى بِشَرابي!",14,"ب",2,0]]}