{"poems":[[47,"حقا أقول لقد تبلت فؤادي","https://www.aldiwan.net/poem63504.html","الكامل"],[68,"أذكروا لما أروها النديما","https://www.aldiwan.net/poem39208.html","الخفيف"],[108,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[266,"أعيونهن أم بيض الصفاح","https://www.aldiwan.net/poem38347.html","الرمل"],[371,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[385,"هل للمحب المستهام رفيق","https://www.aldiwan.net/poem49204.html","الكامل"],[463,"الآن إذ برد السلو ظمائي","https://www.aldiwan.net/poem56313.html","الكامل"],[556,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[556,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[563,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[821,"","https://poetry.dctabudhabi.ae/diwan/poem/205143","الرمل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35381","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141351","الكامل"],[2308,"","https://poetry.dctabudhabi.ae/diwan/poem/138926",""],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87753","الكامل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83206","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65977","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123933","الخفيف"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75691","الكامل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62159","الكامل"],[5147,"مددنا بصائرنا لا العيونا","https://www.poetsgate.com/ViewPoem.aspx?id=166673",""],[592,"تبصر نور الحق من كان يبصر","https://www.poetsgate.com/ViewPoem.aspx?id=128795",""],[5616,"دَنس","https://www.poetsgate.com/ViewPoem.aspx?id=203431",""],[6102,"جُناح","https://www.poetsgate.com/ViewPoem.aspx?id=183610",""],[6305,"أنتَ الخلودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87335&r=&rc=8",""]],"verses":[["وَقَذَت مُوالاةُ الصِيامِ تَصَرُّفاً","مِن لَحظِ ظَمآنِ الهَواجِرِ صادِ",0,"د",1,0],["وَقَذَفنا بِشُهبِها مارِدَ الهَم","مِ فَكانَت لِلمارِدينَ رُجوما",1,"م",2,0],["وقذائفُ البارود أب","لغُ من قصائد ألفِ شاعر",2,"ر",1,0],["وقذا ناظر من هام هوى","ذات واشيه على ذات الوشاح",3,"ح",1,0],["وَقَذفُ المُحصَناتِ كَما عَلِمتُم","وَيَومُ الحَشرِ لَيسَ بِيَومِ هَذرِ",4,"ر",1,0],["وَقَذفت في لجج الهُموم كَأَنَّني","طَيف يَشق حَشا الظَلام طُروق",5,"ق",1,0],["وقَذاءُ قلبي أن يَحنّ لناظرٍ","يومَ الرحيل تفرّقَ الخُلَطاءِ",6,"ا",2,0],["وقَذِيتُ في قلبي بفقدك والقذى","في القلبِ يُنسينا قَذاةَ الماقِ",7,"ق",1,0],["وقذى العيونِ يجولُ في","كلِّ النّواظِر إنْ قُذِيتا",8,"ت",2,0],["وقذف أولي التشبيه يوجب حدهم","سياطَ بعادٍ عن حماه قوارع",9,"ع",1,0],["وقذى في عين ضدي","وشجاً في حلق قرني",10,"ن",2,0],["وَقَذَّفَت قَيصَرَ مِن قُنَّةٍ","تَهوي بِهِ إِلى مَكانٍ سَحيق",11,"ق",1,0],["وَقذفَ الدينارَ عَن يَديه","تطيراً إذ اسمه عليه",12,"ه",1,0],["وقذائف النّيران قوّضت الرّبى","فتحولت قمم الجبال سهولا",13,"ل",2,0],["وقذفناهم برمي جمار البع","د عنا فأحرقتهم لظاها",14,"ا",3,0],["وَقَذائف لَو أَنَّها صُبت عَلى","شمّ الجِبال لَما تَركن قِنانا",15,"ن",2,0],["وَقَذاةُ عَينِيَ أَن أَراهُم رُكَّعاً","لِلجَهلِ لا يَدرونَ طيبَ دَواءِ",16,"ا",2,0],["وقذف الفتى بالنفس في الحتف جهرة","وفي لجج الهيجاء تحت القساطل",17,"ل",1,0],["وقذيف المكسيم يلهب قطراً","ومكين الرشاش يهمي قطارا",18,"ر",2,0],["وقذيت تقذى قذى صار القذى","فيها وقد أقذيت عينيك إذا",19,"ذ",2,0],["وَقذفت يا بحر العلوم جواهراً","أَضحَت لجمع التاج منك تنظم",20,"م",1,0],["وقذ الزمان جوانحي ووقذته","فانظر إلى موقوذه ووقاذه",21,"ذ",2,0],["وقذف المدافع بين الجموع","يهد معالمها والحصونا",22,"ن",2,0],["وقذفك بالبهتان للشيخ فرية","بلا مرية بل أنت بالزور تبدر",23,"ر",1,0],["وقذائف الأشرار هاطلةٌ","ومدائن في الموت تنغرس",24,"س",1,0],["وَ قَذَىً بَاتَ إِثْمِدُ العَينِ - وَيحِي -","وَ ظَلَامًا نَهَارِيَ الوَضَّاحُ",25,"ح",1,0],["وقذائفاً ملأتْ سماءَ بلادِنا","كيما تُقبِّلَ أرضَنا تقبيلا",26,"ل",2,0]]}