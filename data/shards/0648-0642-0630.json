{"poems":[[45,"حقا أقول لقد تبلت فؤادي","https://www.aldiwan.net/poem63504.html","الكامل"],[66,"أذكروا لما أروها النديما","https://www.aldiwan.net/poem39208.html","الخفيف"],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[262,"أعيونهن أم بيض الصفاح","https://www.aldiwan.net/poem38347.html","الرمل"],[367,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[381,"هل للمحب المستهام رفيق","https://www.aldiwan.net/poem49204.html","الكامل"],[459,"الآن إذ برد السلو ظمائي","https://www.aldiwan.net/poem56313.html","الكامل"],[552,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[552,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"]],"verses":[["وَقَذَت مُوالاةُ الصِيامِ تَصَرُّفاً","مِن لَحظِ ظَمآنِ الهَواجِرِ صادِ",0,"د",1,0],["وَقَذَفنا بِشُهبِها مارِدَ الهَم","مِ فَكانَت لِلمارِدينَ رُجوما",1,"م",2,0],["وقذائفُ البارود أب","لغُ من قصائد ألفِ شاعر",2,"ر",1,0],["وقذا ناظر من هام هوى","ذات واشيه على ذات الوشاح",3,"ح",1,0],["وَقَذفُ المُحصَناتِ كَما عَلِمتُم","وَيَومُ الحَشرِ لَيسَ بِيَومِ هَذرِ",4,"ر",1,0],["وَقَذفت في لجج الهُموم كَأَنَّني","طَيف يَشق حَشا الظَلام طُروق",5,"ق",1,0],["وقَذاءُ قلبي أن يَحنّ لناظرٍ","يومَ الرحيل تفرّقَ الخُلَطاءِ",6,"ا",2,0],["وقَذِيتُ في قلبي بفقدك والقذى","في القلبِ يُنسينا قَذاةَ الماقِ",7,"ق",1,0],["وقذى العيونِ يجولُ في","كلِّ النّواظِر إنْ قُذِيتا",8,"ت",2,0],["وقذف أولي التشبيه يوجب حدهم","سياطَ بعادٍ عن حماه قوارع",9,"ع",1,0]]}