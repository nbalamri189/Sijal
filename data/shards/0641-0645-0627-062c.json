{"poems":[[53,"بني عامر ما العز إلا لقادر","https://www.aldiwan.net/poem29773.html","الطويل"],[53,"تمنى رجال نيلها وهي شامس","https://www.aldiwan.net/poem30198.html","الطويل"],[100,"وراء الرياح","https://www.aldiwan.net/poem23704.html","عموديه"],[24,"صبحنا الحي حي بني جحاش","https://www.aldiwan.net/poem21861.html","الوافر"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[64,"رقيبان مني شاهدان لحبه","https://www.aldiwan.net/poem67600.html","الطويل"],[91,"ثكل الشرق فتاه","https://www.aldiwan.net/poem62806.html","عموديه"],[43,"حشاشة نفس ودعت يوم ودعوا","https://www.aldiwan.net/poem9720.html","الطويل"],[62,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[45,"أجز من غلة الصدر العميد","https://www.aldiwan.net/poem62751.html","الوافر"],[45,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[28,"رأى عبد قيس خفقة شورت بها","https://www.aldiwan.net/poem5050.html","الطويل"],[28,"أتصرف أجمال النوى شاجنية","https://www.aldiwan.net/poem5245.html","الطويل"],[61,"ألا يا ابن فهد وقيت الردى","https://www.aldiwan.net/poem51544.html","المتقارب"],[44,"أألله إني خالد بعد خالد","https://www.aldiwan.net/poem30315.html","الطويل"],[87,"لأمر ما تحيرت العقول","https://www.aldiwan.net/poem8363.html","الوافر"],[31,"ألم تسأل الأطلال والمتربعا","https://www.aldiwan.net/poem42466.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[22,"ألا آل ليلى أزمعوا بقفول","https://www.aldiwan.net/poem21653.html","الطويل"],[67,"نهى السلطان عن شرب الحميا","https://www.aldiwan.net/poem18149.html","الوافر"],[75,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[75,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[48,"أجارة بيتينا أبوك غيور","https://www.aldiwan.net/poem63375.html","الطويل"],[48,"أنا أبصرت صاح الشمس","https://www.aldiwan.net/poem64383.html","الطويل"],[50,"وإني لقادتني إليه مودتي","https://www.aldiwan.net/poem63833.html","الطويل"],[46,"تصدق على الطير الغوادي بشربة","https://www.aldiwan.net/poem22818.html","الطويل"],[19,"ألم تر أن الله أنزل مُزنةً","https://www.aldiwan.net/poem349.html",""],[87,"لأمرٍ ما تحيرتِ العقولُ","https://www.poetsgate.com/ViewPoem.aspx?id=14065",""],[32,"على الدار التي لبست بلاها","https://www.poetsgate.com/ViewPoem.aspx?id=126",""],[129,"دعوت الحي نصرا فاستهلوا","https://www.aldiwan.net/poem24171.html","الوافر"],[145,"أبى القلب أن ينسى المعاهد من برسا","https://www.aldiwan.net/poem47636.html","الطويل"],[158,"تألق نور العدل وانطفأ الظلم","https://www.aldiwan.net/poem58882.html","الطويل"],[158,"الحمد للّه رب العالمين على","https://www.aldiwan.net/poem58891.html","الكامل"],[158,"هو الدهر كرت في المعالي كتائبه","https://www.aldiwan.net/poem59068.html","الطويل"],[202,"أعاذل حسب المرء بالشيب عاذلا","https://www.aldiwan.net/poem53155.html","الطويل"],[210,"فها كبدي من محجري تسيل","https://www.aldiwan.net/poem37841.html","الطويل"],[233,"وباخل قدم لي شمعة","https://www.aldiwan.net/poem31583.html","السريع"],[235,"إن الشمائل أزهار وأنوار","https://www.aldiwan.net/poem18809.html","البسيط"],[235,"ألا أيها القائد المجتبى","https://www.aldiwan.net/poem19077.html","المتقارب"],[268,"تغنيت بالأشعار عند المخاوف","https://www.aldiwan.net/poem35640.html","الطويل"],[280,"هنيئا لقد أوتيت سؤلك يا موسى","https://www.aldiwan.net/poem32738.html","الطويل"],[283,"ما بالكم لم تفوا بالعهد وانفصلت","https://www.aldiwan.net/poem39336.html","البسيط"],[362,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[362,"أرقت وصحبي بنجد هجود","https://www.aldiwan.net/poem60951.html","المتقارب"],[363,"لمن طلل بتيمات فجند","https://www.aldiwan.net/poem44517.html","الوافر"],[364,"إذا ما الغزال سرى زائرا","https://www.aldiwan.net/poem17196.html","المتقارب"],[364,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[374,"سمعت بأذني رنة السهمِ في قلبي","https://www.aldiwan.net/poem66952.html","الطويل"],[400,"عذرا على ما جرى مني من الزلل","https://www.aldiwan.net/poem33488.html","البسيط"],[426,"غدوت متيما وصبا فوادي","https://www.aldiwan.net/poem40524.html","الوافر"],[436,"ويوم كسوتها رهج المصلى","https://www.aldiwan.net/poem34769.html","الوافر"],[436,"تصدت لوشك البين من جفوة الصد","https://www.aldiwan.net/poem34776.html","الطويل"],[436,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[438,"الصبر من كرم الأخلاق فاصطبر","https://www.aldiwan.net/poem14368.html","البسيط"],[468,"فما جعلت ما بين مكة ناقتي","https://www.aldiwan.net/poem4680.html","الطويل"],[504,"قد أحدث الناس أموراً فلا","https://www.aldiwan.net/poem2448.html","السريع"],[511,"أرى نوح الحمام يشوق قوما","https://www.aldiwan.net/poem67800.html","الوافر"],[527,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[536,"عدو الحق عند الناس طرا","https://www.aldiwan.net/poem47994.html","عموديه"],[549,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[562,"من الفخر هل فاتتك يوماً شوارد","https://www.aldiwan.net/poem819.html",""],[565,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"]],"verses":[["فَما جَذَبَ الأَقرانُ مِنهُ فَريسَةً","وَلا عادَ يَوماً أَنفُهُ وَهوَ راغِمُ",0,"م",1,0],["فَما جازَها في ذُروَةِ النيقِ صاعِدٌ","وَلا فاتَها في لُجَّةِ الماءِ قامِسُ",1,"س",1,0],["فماج بنا منزل من شذا","ومن أغنيات الصّبا والمداح",2,"ح",1,0],["فَما جَبُنوا غَداتَئِذٍ وَلَكِن","أُشِبَّ بِهِم فَلَم يَسَعوا الذِيادا",3,"د",2,0],["فَما جِئنا نُطاوِلُكُم بِجاهٍ","يُطولُكُمُ وَلا رُكنٍ شَديدِ",4,"د",1,0],["فَما جالَ في سِرّي لَغَيرِكَ خاطِرٌ","وَلا قالَ إِلّا في هَواكَ لِساني",5,"ي",1,0],["فَما جادَتِ الدُنيا عَلَيهِم بِمِثلِهِ","وَغَيرُ يَسيرٍ أَن تَجودَ بِئاخَرِ",6,"ر",1,0],["فَما جَلَسَت حَتّى اِنثَنَت توسِعُ الخُطا","كَفاطِمَةٍ عَن دَرِّها قَبلَ تُرضِعُ",7,"ع",1,0],["فما جُرِّد البيض الرقاق لمشهدٍ","كما ابْتُزَّ عن تلك الخدود الجَلابيبُ",8,"ب",1,0],["فَما جَزَعُ الجَزوعِ مِنَ اللَيالي","بِمُحرِزِهِ وَلا جَلَدُ الجَليدِ",9,"د",1,0],["فَما جارَ في تِلكَ المَدامِعِ دَمعُها","لِنازِلَةٍ إِلّا وَحادِثُها نُكرُ",10,"ر",1,0],["فَما جَهِدوا يَومَ النِسارِ وَلَم تَعُد","نِساؤُهُمُ مِنهُم كَمِيّاً مُوَسَّدا",11,"د",2,0],["فَما جاءَ حَتّى مَجَّ وَالماءُ دونَهُ","مِنَ النَفسِ أَلواناً عَبيطاً بُحورُها",12,"ر",3,0],["فما جادَ بالرَّاحِ إلاّ الجَوادُ","وما كَبْرَ الظَّرْفَ إلا الظَّريفُ",13,"ف",1,0],["فَما جانِبُ الدُنيا بِسَهلٍ وَلا الضُحى","بِطَلقٍ وَلا ماءُ الحَياةِ بِبارِدِ",14,"د",1,0],["فَمَا جَرَتِ الظُّنُونُ عَلَى يَقِينٍ","تَفِيءُ بِهِ وَلا صَحَّ الْمَقُولُ",15,"ل",1,0],["فَما جِئتَنا إِلّا عَلى وَفقِ مَوعِدٍ","عَلى مَلَإٍ مِنّا خَرَجنا لَهُ مَعا",16,"ع",2,0],["فما جحدت بلاريسا الرَّوابِي","ولا الشُّمُّ الفوارعُ من ملونا",17,"ن",2,0],["فَما جَعَلَ الصُعرَ اللِئامَ خُدودُها","كَآدَمَ قَلباً مِن بَناتِ جَديلِ",18,"ل",1,0],["فما جَسَرَتْ مُلُوكُ الجِنِّ مِنْهُ","لِجَوْفِ الْقَتْلِ تَدْخُلُ في القَنَانِيْ",19,"ي",1,0],["فما جالَ إلاّ في عجاجك فارساً","ولا شَبَّ إلا تحتَ راياتك الحُمر",20,"ر",1,0],["فما جاء هذا اليومُ إلاّ وقد غدَتْ","وأيديكُمُ منها ومِنْ غَيرِها صفْر",21,"ر",1,0],["فَما جازَهُ جودٌ وَلا حَلَّ دونَهُ","وَلَكِن يَصيرُ الجودُ حَيثُ يَصيرُ",22,"ر",1,0],["فَماجَ الناسُ في الناسِ","وَظَنّوا أَنَّها الرَجعَه",23,"ع",2,0],["فَما جِئتُهُ حَتّى رَأَيتُ خَلايِقاً","يُداوي بِها المَرضى أَلَذَّ مِنَ الشَهدِ",24,"د",1,0],["فَما جِنسُها جانٍ عَليكَ أَذيَّةً","بِحالٍ إِذا ماخِفتَ مِن ذلِكَ الجِنسِ",25,"س",1,0],["فَما جَبُنوا أَنّا نَسُدُّ عَلَيهِمُ","وَلَكِن لَقوا ناراً تَحُسُّ وَتَسفَعُ",26,"ع",1,0],["فَمَا جَرَتِ الظُّنُونُ عَلَى يَقِينٍ","تفيءُ بهِ ، وَ لاَ صحَّ المقلُ",27,"ل",1,0],["فما جادت لنا حتى وردنا","حياض الموت أو كدنا نراها",28,"ا",3,0],["فَما جَبُنوا وَلَكِنّا نَصَبنا","صُدورَ الشَرعَبِيَّةِ لِلقُلوبِ",29,"ب",1,0],["فما جازها فضلٌ ولا حل دونها","سواها نجومٌ وهي أحسبها شمسا",30,"س",2,0],["فما جالبٌ خيراً إذا لم يكن قضاً","ولا دافعٌ شرا إذا ما قضى حزمُ",31,"م",1,0],["فما جزا فهو من هذا فقرَّبه","عيناً ونمْ آمنا لا تختشى خَللا",32,"ل",2,0],["فما جدعت إلاّ عرانين أنفه","ولا جب إلا ظهره وغواربه",33,"ب",2,0],["فما جُرِّدَت إلا تسربلَ جسمُها","غلائلَ نورٍ حين تنضو الغلائلا",34,"ل",2,0],["فما جدبت يا سلوتي قطُّ عَبْرَتي","ولا خَصِبت بعد الفراقِ طُلولُ",35,"ل",1,0],["فَما جَرَت مِن عَينِها دَمعَةٌ","إِلّا وَمِن عَينَيهِ أَمثالُها",36,"ه",2,0],["فَمَا جِنَانُ الرُّبَى هَبَّتْ عَلَيْهَا صَبَا","مِنْ بَعْدِ أَنْ عَلَّهَا بِالرَّيِّ مِدْرَارُ",37,"ر",1,0],["فَمَا جِئْتُ شَيْئاً أُلاَمُ بهِ","سِوَى أَنَّنِي بِالْعُلاَ مُسْتَهَامْ",38,"م",1,0],["فما جلَّ من كلِّ الأمورِ عَرفتُهُ","وما دقَّ منها لم يفُت رأيَ عارف",39,"ف",1,0],["فَما جُندُهُ إِلا أُسودُ خَفِيَّةٍ","تَخِذنَ لَها سُمرَ القَنا اللَّدن عِرّيسا",40,"س",2,0],["فما جوابك لو يبدي معاتبة","بين الاحبة بالرهان قد كملت",41,"ت",1,0],["فماج إلى الوَداعِ كثيبُ رَمْلٍ","ومال إلى العناقِ قضيبُ بان",42,"ن",1,0],["فما جاء سَوْقٌ شديدٌ بها","ولكنّ ما جاءَ شَوقٌ شَديد",43,"د",1,0],["فما جَمعٌ لِيَغلِبَ جَمعَ قومي","مُكاثرةً ولا فَردٌ لِفَردِ",44,"د",1,0],["فَما جارَ مَن جارَ في حُكمِهِ","وَلَكِنَّ مَن أَلجَأَ الجائِرا",45,"ر",2,0],["فَما جاءَ عَن مِعطَفي ذَمُّ جانٍ","وَلا جاءَ عَن جَوهَري ذَمُّ حالي",46,"ل",2,0],["فما جادعٌ أنفي بكفّي مكيدةً","سوايَ وما باغٍ عليَّ سوى قلبي",47,"ي",1,0],["فما جنيت على غيري بما رقمت","أناملي وبما أمليت يا أملي",48,"ل",2,0],["فما جنحت لخفٍ قط يوماً","ولم نسلك سوى طرق الرشادِ",49,"د",1,0],["فما جَلَتِ الدُّجى شمسٌ تَجَلَّتْ","كوجهِكَ فِي الوغى لما تَجلَّى",50,"ل",2,0],["فما جَلَتِ الدنيا عَروسَ رِياسَةٍ","لِمُلْكِهِمُ إلّا وَفِي صَدْرِها عِقدي",51,"د",2,0],["فما جَهِدُوا فُلْكاً كَما جَهِدُوا يَدِي","ولا أَنْقَضُوا رحلاً كَمَا أنْقَضُوا ظَهْرِي",52,"ر",2,0],["فما جمعناه للدنيا فمفترق","وما عمرناه فيها غير معتمر",53,"ر",1,0],["فَما جَعَلَت ما بَينَ مَكَّةَ ناقَتي","إِلى البِركِ إِلا نَومَةَ المُتَهَجِّدِ",54,"د",1,1],["فما جِماعُ الخَيرِ الا الّذي","كان عَليه السّلف الصّالح",55,"ح",1,0],["فما جز الأنيس من التصابي","إذا امتنع التزاور واللقاء",56,"ا",2,0],["فما جاءَنا نَقْلٌ بِقَصْرٍ ولا أتَى","بذلِكَ حُكْمٌ للعُقُولِ الصَّحِيحةِ",57,"ه",1,0],["فما جر البخيلُ لنا ملاماً","ومنا قيلَ قد سَخُفَت عُقولُ",58,"ل",1,0],["فما جازيتُمُ لهمُ جميلاً","ولا أَمضيتمُ لهمُ اِشتراطا",59,"ط",2,0],["فما جاد إلاّ من أياديك كنزه","ولا ساد إلاّ من لمجدك ساجد",60,"د",1,0],["فَمَا جَاءَنَا مَا جِئْتُمُونَا بِهِ","مِنَ الظُّلْمِ أَعْمَى القُرُونَ الأُوَلْ",61,"ل",1,0]]}