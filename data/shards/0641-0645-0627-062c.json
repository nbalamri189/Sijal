gate.com/ViewPoem.aspx?id=128719",""],[592,"أرى طالع الأدبار والنحس قد بدا","https://www.poetsgate.com/ViewPoem.aspx?id=128843",""],[592,"ألا حدثاني بالأمور الحوادث","https://www.poetsgate.com/ViewPoem.aspx?id=128835",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5351,"هنا صنعاء هنا صعدة","https://www.poetsgate.com/ViewPoem.aspx?id=202119",""],[5376,"تناغي الهوى في قلبها العشق والوصلُ","https://www.poetsgate.com/ViewPoem.aspx?id=190151",""],[475,"فَمَا جَعَلَتْ مَا بَيْنَ مَكَّة َ نَاقَتيفَمَا جَ","https://www.poetsgate.com/ViewPoem.aspx?id=20540",""],[5431,"إلى حبيب الروح...","https://www.poetsgate.com/ViewPoem.aspx?id=214054",""],[5544,"عمان اسعدي","https://www.poetsgate.com/ViewPoem.aspx?id=213441",""],[5550,"رجوع حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=215208",""],[5596,"توالت غيوث الشكر تسكب خيركم","https://www.poetsgate.com/ViewPoem.aspx?id=205667",""],[243,"مرئية الآلهة","https://www.poetsgate.com/ViewPoem.aspx?id=50562",""],[5720,"علىٰ المسعىٰ","https://www.poetsgate.com/ViewPoem.aspx?id=199560",""],[402,"مصابك حيا عرا جعفرا","https://www.poetsgate.com/ViewPoem.aspx?id=35746",""],[5916,"الى ليلى ...","https://www.poetsgate.com/ViewPoem.aspx?id=190587",""],[5943,"ومن عجبي","https://www.poetsgate.com/ViewPoem.aspx?id=11250",""],[5997,"ريع الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214208",""],[6093,"أتدري متى","https://www.poetsgate.com/ViewPoem.aspx?id=192264",""],[6147,"عقيم العمر ينتظر الجنين","https://www.poetsgate.com/ViewPoem.aspx?id=151501",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""],[5464,"بغداد والخمسون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=491&r=&rc=5",""],[6225,"تقمُّص","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78046&r=&rc=131",""],[5190,"مسافر من زمان العولمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78311&r=&rc=24",""]],"verses":[["فَما جَذَبَ الأَقرانُ مِنهُ فَريسَةً","وَلا عادَ يَوماً أَنفُهُ وَهوَ راغِمُ",0,"م",1,0],["فَما جازَها في ذُروَةِ النيقِ صاعِدٌ","وَلا فاتَها في لُجَّةِ الماءِ قامِسُ",1,"س",1,0],["فماج بنا منزل من شذا","ومن أغنيات الصّبا والمداح",2,"ح",1,0],["فَما جَبُنوا غَداتَئِذٍ وَلَكِن","أُشِبَّ بِهِم فَلَم يَسَعوا الذِيادا",3,"د",2,0],["فَما جِئنا نُطاوِلُكُم بِجاهٍ","يُطولُكُمُ وَلا رُكنٍ شَديدِ",4,"د",1,0],["فَما جالَ في سِرّي لَغَيرِكَ خاطِرٌ","وَلا قالَ إِلّا في هَواكَ لِساني",5,"ن",2,0],["فَما جادَتِ الدُنيا عَلَيهِم بِمِثلِهِ","وَغَيرُ يَسيرٍ أَن تَجودَ بِئاخَرِ",6,"ر",1,0],["فَما جَلَسَت حَتّى اِنثَنَت توسِعُ الخُطا","كَفاطِمَةٍ عَن دَرِّها قَبلَ تُرضِعُ",7,"ع",1,0],["فما جُرِّد البيض الرقاق لمشهدٍ","كما ابْتُزَّ عن تلك الخدود الجَلابيبُ",8,"ب",1,0],["فَما جَزَعُ الجَزوعِ مِنَ اللَيالي","بِمُحرِزِهِ وَلا جَلَدُ الجَليدِ",9,"د",1,0],["فَما جارَ في تِلكَ المَدامِعِ دَمعُها","لِنازِلَةٍ إِلّا وَحادِثُها نُكرُ",10,"ر",1,0],["فَما جَهِدوا يَومَ النِسارِ وَلَم تَعُد","نِساؤُهُمُ مِنهُم كَمِيّاً مُوَسَّدا",11,"د",2,0],["فَما جاءَ حَتّى مَجَّ وَالماءُ دونَهُ","مِنَ النَفسِ أَلواناً عَبيطاً بُحورُها",12,"ر",3,0],["فما جادَ بالرَّاحِ إلاّ الجَوادُ","وما كَبْرَ الظَّرْفَ إلا الظَّريفُ",13,"ف",1,0],["فَما جانِبُ الدُنيا بِسَهلٍ وَلا الضُحى","بِطَلقٍ وَلا ماءُ الحَياةِ بِبارِدِ",14,"د",1,0],["فَمَا جَرَتِ الظُّنُونُ عَلَى يَقِينٍ","تَفِيءُ بِهِ وَلا صَحَّ الْمَقُولُ",15,"ل",1,0],["فَما جِئتَنا إِلّا عَلى وَفقِ مَوعِدٍ","عَلى مَلَإٍ مِنّا خَرَجنا لَهُ مَعا",16,"ع",2,0],["فما جحدت بلاريسا الرَّوابِي","ولا الشُّمُّ الفوارعُ من ملونا",17,"ن",2,0],["فَما جَعَلَ الصُعرَ اللِئامَ خُدودُها","كَآدَمَ قَلباً مِن بَناتِ جَديلِ",18,"ل",1,0],["فما جَسَرَتْ مُلُوكُ الجِنِّ مِنْهُ","لِجَوْفِ الْقَتْلِ تَدْخُلُ في القَنَانِيْ",19,"ي",1,0],["فما جالَ إلاّ في عجاجك فارساً","ولا شَبَّ إلا تحتَ راياتك الحُمر",20,"ر",1,0],["فما جاء هذا اليومُ إلاّ وقد غدَتْ","وأيديكُمُ منها ومِنْ غَيرِها صفْر",21,"ر",1,0],["فَما جازَهُ جودٌ وَلا حَلَّ دونَهُ","وَلَكِن يَصيرُ الجودُ حَيثُ يَصيرُ",22,"ر",1,0],["فَماجَ الناسُ في الناسِ","وَظَنّوا أَنَّها الرَجعَه",23,"ع",2,0],["فَما جِئتُهُ حَتّى رَأَيتُ خَلايِقاً","يُداوي بِها المَرضى أَلَذَّ مِنَ الشَهدِ",24,"د",1,0],["فَما جِنسُها جانٍ عَليكَ أَذيَّةً","بِحالٍ إِذا ماخِفتَ مِن ذلِكَ الجِنسِ",25,"س",1,0],["فَما جَبُنوا أَنّا نَسُدُّ عَلَيهِمُ","وَلَكِن لَقوا ناراً تَحُسُّ وَتَسفَعُ",26,"ع",1,0],["فَمَا جَرَتِ الظُّنُونُ عَلَى يَقِينٍ","تفيءُ بهِ ، وَ لاَ صحَّ المقلُ",27,"ل",1,0],["فما جذلت لخير في يدي أجل","ولا جزعت لشر بعده أمل",28,"ل",1,0],["فما جمعوا ما فرق الله جمعه","ولا فرقوا في الدين ما الله جامع",29,"ع",1,0],["فما جادت لنا حتى وردنا","حياض الموت أو كدنا نراها",30,"ا",3,0],["فَما جَبُنوا وَلَكِنّا نَصَبنا","صُدورَ الشَرعَبِيَّةِ لِلقُلوبِ",31,"ب",1,0],["فما جازها فضلٌ ولا حل دونها","سواها نجومٌ وهي أحسبها شمسا",32,"س",2,0],["فما جالبٌ خيراً إذا لم يكن قضاً","ولا دافعٌ شرا إذا ما قضى حزمُ",33,"م",1,0],["فما جزا فهو من هذا فقرَّبه","عيناً ونمْ آمنا لا تختشى خَللا",34,"ل",2,0],["فما جدعت إلاّ عرانين أنفه","ولا جب إلا ظهره وغواربه",35,"ب",2,0],["فما جُرِّدَت إلا تسربلَ جسمُها","غلائلَ نورٍ حين تنضو الغلائلا",36,"ل",2,0],["فما جدبت يا سلوتي قطُّ عَبْرَتي","ولا خَصِبت بعد الفراقِ طُلولُ",37,"ل",1,0],["فَما جَرَت مِن عَينِها دَمعَةٌ","إِلّا وَمِن عَينَيهِ أَمثالُها",38,"ه",2,0],["فَمَا جِنَانُ الرُّبَى هَبَّتْ عَلَيْهَا صَبَا","مِنْ بَعْدِ أَنْ عَلَّهَا بِالرَّيِّ مِدْرَارُ",39,"ر",1,0],["فَمَا جِئْتُ شَيْئاً أُلاَمُ بهِ","سِوَى أَنَّنِي بِالْعُلاَ مُسْتَهَامْ",40,"م",1,0],["فما جلَّ من كلِّ الأمورِ عَرفتُهُ","وما دقَّ منها لم يفُت رأيَ عارف",41,"ف",1,0],["فَما جُندُهُ إِلا أُسودُ خَفِيَّةٍ","تَخِذنَ لَها سُمرَ القَنا اللَّدن عِرّيسا",42,"س",2,0],["فما جوابك لو يبدي معاتبة","بين الاحبة بالرهان قد كملت",43,"ت",1,0],["فماج إلى الوَداعِ كثيبُ رَمْلٍ","ومال إلى العناقِ قضيبُ بان",44,"ن",1,0],["فما جاء سَوْقٌ شديدٌ بها","ولكنّ ما جاءَ شَوقٌ شَديد",45,"د",1,0],["فما جَمعٌ لِيَغلِبَ جَمعَ قومي","مُكاثرةً ولا فَردٌ لِفَردِ",46,"د",1,0],["فَما جارَ مَن جارَ في حُكمِهِ","وَلَكِنَّ مَن أَلجَأَ الجائِرا",47,"ر",2,0],["فَما جاءَ عَن مِعطَفي ذَمُّ جانٍ","وَلا جاءَ عَن جَوهَري ذَمُّ حالي",48,"ل",2,0],["فما جادعٌ أنفي بكفّي مكيدةً","سوايَ وما باغٍ عليَّ سوى قلبي",49,"ب",2,0],["فما جنيت على غيري بما رقمت","أناملي وبما أمليت يا أملي",50,"ل",2,0],["فما جنحت لخفٍ قط يوماً","ولم نسلك سوى طرق الرشادِ",51,"د",1,0],["فما جَلَتِ الدُّجى شمسٌ تَجَلَّتْ","كوجهِكَ فِي الوغى لما تَجلَّى",52,"ل",2,0],["فما جَلَتِ الدنيا عَروسَ رِياسَةٍ","لِمُلْكِهِمُ إلّا وَفِي صَدْرِها عِقدي",53,"د",2,0],["فما جَهِدُوا فُلْكاً كَما جَهِدُوا يَدِي","ولا أَنْقَضُوا رحلاً كَمَا أنْقَضُوا ظَهْرِي",54,"ر",2,0],["فما جمعناه للدنيا فمفترق","وما عمرناه فيها غير معتمر",55,"ر",1,0],["فَما جَعَلَت ما بَينَ مَكَّةَ ناقَتي","إِلى البِركِ إِلا نَومَةَ المُتَهَجِّدِ",56,"د",1,1],["فما جِماعُ الخَيرِ الا الّذي","كان عَليه السّلف الصّالح",57,"ح",1,0],["فما جز الأنيس من التصابي","إذا امتنع التزاور واللقاء",58,"ا",2,0],["فما جاءَنا نَقْلٌ بِقَصْرٍ ولا أتَى","بذلِكَ حُكْمٌ للعُقُولِ الصَّحِيحةِ",59,"ه",1,0],["فما جر البخيلُ لنا ملاماً","ومنا قيلَ قد سَخُفَت عُقولُ",60,"ل",1,0],["فما جازيتُمُ لهمُ جميلاً","ولا أَمضيتمُ لهمُ اِشتراطا",61,"ط",2,0],["فما جاد إلاّ من أياديك كنزه","ولا ساد إلاّ من لمجدك ساجد",62,"د",1,0],["فَمَا جَاءَنَا مَا جِئْتُمُونَا بِهِ","مِنَ الظُّلْمِ أَعْمَى القُرُونَ الأُوَلْ",63,"ل",1,0],["فَما جازَ يا رَب المَعالي عَلَيهما","يَجوز عَلى علياك يا غاية الأَمَلْ",64,"ل",1,0],["فما جاء ذاك الصعود ولا ذا ال","هبوط بإجهاده للقوى",65,"ق",3,0],["فما جند البوير به أحاطت","جنود الإنكليز مسددات",66,"ت",1,0],["فما جوابي ان قيل أي غنى","نلت وماذا أفادك الطلب",67,"ب",1,0],["فما جبنوا ولكنَّا أُناسٌ","نُقيمُ لَمن يُقارِعُنا القِراعا",68,"ع",2,0],["فماجُوا بالتطاول والتعادي","وساسُوا الضُرَّ في مال ونفسِ",69,"س",1,0],["فما جاء إلا من لجَدْواه آملٌ","ولا سار إلا من لِلُقياه حامدُ",70,"د",1,0],["فما جنَّة الفردوس إلا لقاؤه","وما النار والأهوال إلا صدوده",71,"د",2,0],["فما جَأْبَهُ المِدري تَروحُ وتَغْتَدي","ذُرى الطّامساتِ الفرْدِ من وَرَقانِ",72,"ن",1,0],["فَما جِئتُكُم إِلا رَجَعتُ وَحاجَتِي","كَما هِيَ في صَدرِي غَداةَ أَؤُوبُ",73,"ب",1,0],["فما جَارَ إلا عَاذِلاٌ عن هَوَاكُمُ","ولا عَاش إلا من رَأى جَوْرَكم عَدلاً",74,"ل",2,0],["فَما جاوزوا هم إلّا تصعّدت","بهم هممٌ جاوزنَ كلّ شكاكِ",75,"ك",1,0],["فَما جَبُنَت خَيلي وَلَكِن بَدَت لَها","أُلوفٌ أَتَت مِن بَعدِهِنَّ أُلوفُ",76,"ف",1,0],["فَما جِئتُهُ أَعشو إِلَيهِ بِشُبهَةٍ","وَلا طالِباً مالاً وَلا الجاهَ أَطلُبُ",77,"ب",1,0],["فما جاءنا إلا بأمرٍ مناسبٍ","أينهض عن كفِّ الجبانِ المثقَّفُ",78,"ف",1,0],["فما جردت في الحرب ألا تناهبت","مضاربها أرواح أسد الكتائب",79,"ب",1,0],["فَما جاءَني رجل واحد","يَزيد على درهم واحِد",80,"د",1,0],["فما جولة عند الردى فوقَ هذه","فنخشاه يوماً في كريم يجولها",81,"ل",3,0],["فما جهد العصاة لدى إمامٍ","مهابته تنوب عن الجنود",82,"د",1,0],["فما جمر الغضا الاّ زفير","اذاب جوانحي فجرين مزنا",83,"ن",2,0],["فَمَا جَرَّدَتْ في نَفْطَة ثَوبَ فَاترٍ","من الأيْنِ حتى بَرَّدَتْ ثَوبَ وَاثِبِ",84,"ب",1,0],["فما جده بختاً أراد ولا أباً","ولكن معنى الجد من ربنا العظم",85,"م",1,0],["فما جوّ السماح لديه مصح","ولا هو من كؤوس الحمد صاح",86,"ح",1,0],["فما جهلت منه","عن ذاك تسأل",87,"ل",1,0],["فما جعل الله العظيم دواءنا","بما هو محظور بملّة أحمد",88,"د",1,0],["فَما جَبُنوا وَلكِن واجَهونا","بِسَجلٍ مِن سِجالِ المَوتِ حامي",89,"م",2,0],["فماج حسناً فوق ما","فيه من التموج",90,"ج",1,0],["فَما جَشَأَت نَفسي عَشِيَّةَ مُشرِفٍ","وَلا اِحتَلَبَت عَينَيَّ حَزوى وَفَيفاءُ",91,"ا",2,1],["فَما جَلَبَ المَصائِبَ وَالبَلايا","وَوَيلاتٍ تُخَرِّبُ أَدؤُراتِ",92,"ت",1,0],["فما جدّت مطايا الشوق إلا","وآب بها حليف جوى ووجدِ",93,"د",1,0],["فما جَسَرتْ ملوكُ الجنّ خوفاً","لأجلِ الخمرِ تَدخُلُ في القناني",94,"ي",1,0],["فما جزاءُ العلجِ منها فَقُلْ","موفّقاً في هذِهِ المسأله",95,"ل",2,0],["فماجت شوارع عاصمتي","بسيل جماهيرها العاتيه",96,"ي",2,0],["فما جعفر الحلي يدرك شأوه","ولا ابن شبيب الندب والسيد الهندي",97,"د",2,0],["فما جَوابي إِذا الجَبّار ساءَلَني","عَمّا اقتَرفتُ وَقَلبي خَشيَةً ذابا",98,"ب",2,0],["فما جَلَبَ الاحزانَ غيرُ حَمامةٍ","على فننٍ من سِدْرِ حومل تَصْدَحُ",99,"ح",1,0],["فما جدّ إلا ما انتَضَتْ عَزَماتُها","ولا جادَ إلا جودُها المُ