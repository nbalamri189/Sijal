{"poems":[[45,"دمع جرى فقضى في الربع ماوجبا","https://www.aldiwan.net/poem9465.html","البسيط"],[64,"أصالة الرأي صانتني ( لامية العجم )","https://www.aldiwan.net/poem52315.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[96,"اللهب القدسي","https://www.poetsgate.com/ViewPoem.aspx?id=15627",""],[136,"أني على هيمى مى تلحاني","https://www.aldiwan.net/poem54712.html","البسيط"],[240,"يا زمن السوء الذي مسني","https://www.aldiwan.net/poem31814.html","السريع"],[240,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[240,"حتام أرضى في هواك وتغضب","https://www.aldiwan.net/poem32181.html","الكامل"],[341,"كن كاتما للضر والبؤسى تنلْ","https://www.aldiwan.net/poem67805.html","عموديه"],[385,"من للمحب المستهام","https://www.aldiwan.net/poem48802.html","مجزوء الكامل"],[385,"ناء بمصر وبالشآم حبيبه","https://www.aldiwan.net/poem49206.html","الكامل"],[409,"من فلق البحر للكليم ومن","https://www.aldiwan.net/poem33376.html","المنسرح"],[415,"يا دهر كم هذا التفرق","https://www.aldiwan.net/poem31863.html","مجزوء الكامل"],[438,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[447,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[556,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82804","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34404","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96709","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25344","الرجز"],[1144,"","https://poetry.dctabudhabi.ae/diwan/poem/199145","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56124","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101030","السريع"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100983","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87842","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108492","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121199","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60888","المنسرح"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106996","الرجز"],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101887","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112501","الرمل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100864","البسيط"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145047","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66368","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91550","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117893","الكامل"],[3815,"","https://poetry.dctabudhabi.ae/diwan/poem/143165","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59454","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125880","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94800","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136622",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136610",""],[4727,"السيف أقطعُ أحياناً مِن الخشبِ","https://www.poetsgate.com/ViewPoem.aspx?id=208920",""],[4785,"شكوى الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=129743",""],[4927,"غيابُ عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=29828",""],[4929,"سفينةالضياع","https://www.poetsgate.com/ViewPoem.aspx?id=204798",""],[5092,"أنثايَ","https://www.poetsgate.com/ViewPoem.aspx?id=180133",""],[5277,"بعيدةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=187712",""],[5277,"فراتٌٌ سائغٌ شرابُهُ..","https://www.poetsgate.com/ViewPoem.aspx?id=200934",""],[5277,"مهرةٌ بلا فارس..","https://www.poetsgate.com/ViewPoem.aspx?id=206839",""],[5431,"للقدس...للحبيبة...","https://www.poetsgate.com/ViewPoem.aspx?id=194944",""],[5431,"من ذا يُجففُ أنهره","https://www.poetsgate.com/ViewPoem.aspx?id=199762",""],[5740,"تندغ الخير","https://www.poetsgate.com/ViewPoem.aspx?id=211474",""],[5746,"لذة الأسر","https://www.poetsgate.com/ViewPoem.aspx?id=207035",""],[5956,"خذني لعَطفك","https://www.poetsgate.com/ViewPoem.aspx?id=193808",""],[5970,"ضاقت عليه بصحن الأرض ساحته","https://www.poetsgate.com/ViewPoem.aspx?id=130654",""],[5989,"يا نجمةً ومضت","https://www.poetsgate.com/ViewPoem.aspx?id=181494",""],[6031,"لي إنْ تَحَامَاني أَخٌ وحَميمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46275",""],[6127,"أسد بابل","https://www.poetsgate.com/ViewPoem.aspx?id=188648",""]],"verses":[["ناءَيتُهُ فَدَنا أَدنَيتُهُ فَنَأى","جَمَّشتُهُ فَنَبا قَبَّلتُهُ فَأَبى",0,"ب",2,0],["نَاءٍ عن الأهلِ صِفْرُ الكفِّ منفردٌ","كالسيفِ عُرِّيَ متناهُ من الخَللِ",1,"ل",1,0],["نَاءٍ وَلَوْ أَغْنَتْ مِنَ المُقَلِ النُّهى","مَا كَانَ عَنْهُمْ لَحْظَةً بِالنَّائِي",2,"ا",2,0],["ناء عن النّار لو طاف اللّهيب به","لوهّجت هذه الدّنيا شظاياه",3,"ا",2,0],["نَاءَت بِهَا كُلُّ عُلكُومٍ مُذَكَّرَةٍ","وَجنَاءَ لاَ تَتَشَكَّى الأَينَ مِذعَانِ",4,"ن",1,0],["ناءَت صُروفُ الدَهرِ عَنها فَما","يَطوفُ لِلذُعرِ بِها طائِفُ",5,"ف",1,0],["ناءٍ عَنِ الأَحياءِ في بَرزَخٍ","مُنقَطِعٌ عَن بَينِهِم ذِكري",6,"ر",2,0],["ناءٍ عَلى الأَبصارِ دانٍ جودُهُ","لِعُفاتِهِ فَهوَ البَعيدُ المُكثِبُ",7,"ب",1,0],["ناء الكواعب والغواني اعتزل","إن تدن منها من ردى لا تسلمُ",8,"م",1,0],["ناءٍ تساقيهِ يَد ال","أَشواق كاسات الحَمام",9,"م",1,0],["ناء بِمصر وَبِالشَآم حَبيبُهُ","دَنفٌ وَلَكن أَينَ مِنهُ طَبيبُهُ",10,"ب",2,1],["ناء عن الأهل والصديق وما","يروق من مسكن ومن سكن",11,"ن",1,0],["ناءٍ عن الأهلينَ وال","أَوطانِ والأترابُ ماتُوا",12,"ت",3,0],["ناءٍ مناطُ نجادِه فكأنه","من تحت منعقِد اللواءِ لواءُ",13,"ا",2,0],["ناءٍ عن الأهل وال","أصحاب أو أوطانيه",14,"ي",2,0],["ناءٍ عن الخير منحازٍ بناحيةٍ","عن المكارمِ صَبّارٍ عن الوَهَنِ",15,"ن",1,0],["ناءَت بِعبء الثَرى دَهرا وَناءَ بِها","مِن قَبل ذاكَ لَهُم العَيش أَعباء",16,"ا",2,0],["ناءٍ عَن الأَهلِ والأَوطان مُغتَرِبٌ","وَواجِدٌ ما لَهُ في الصَبر مَوجودُ",17,"د",1,0],["ناء تمنّى ظمياء الحشا واِغتدى بها","قلوص بها أضحت تخبّ وترقلُ",18,"ل",1,0],["ناءٍ مِنَ التَصْبِيحِ نَائِي المُغْتَبَقْ","تَبْدُو لَنَا أَعْلامُهُ بَعْد الغَرَقْ",19,"ق",1,0],["ناءٍ عن الأهل خال الجوف منقبض","كمعدم مات من جوع ومن قشل",20,"ل",1,0],["ناءياً وفواد الصب مأواه","رفقاً بمن أضرمت بالوجد احشاهُ",21,"ا",2,1],["ناءت به البأساء حتى هوى","عن عزه مبتذلاً ذائلا",22,"ل",2,0],["ناءٍ قضى البين فيه حكمه فهوى","تحت الصبابة لا ركنٌ ولا عمد",23,"د",1,0],["ناءٍ عَنِ الظُلمِ المهينِ مَكانَةً","مُخضَوضَرُ الشُرُفاتِ حُلوُ المَوقِعِ",24,"ع",1,0],["ناء عن الوطن العزيز مغادر","لي فيه من صفو الحياة شمولا",25,"ل",2,0],["ناءت فكانت شتاء بعدها سنتي","حتى اشتكي كمدا من صيفه الجسد",26,"د",1,0],["ناء الفتى إنْ رحلتُ عن بلدٍ","فلي سواه الصديقُ والبلدُ",27,"د",1,0],["ناء عن الرشد فلو مرّ به","سرب القطا تاه عن القصد وضل",28,"ل",1,0],["ناء عن الأهل لم يحضره من أحد","فداه أهلوه من شيب وشبان",29,"ن",1,0],["ناء بالأرار عن جناتهم","إن رب الفسق مبرور نج",30,"ج",1,0],["ناء الى الشام عليّ بالغ وطرا","به تزول حقود الدهر والنقم",31,"م",1,0],["ناءت بها أغلالها فتقاعست","عن واجباتك فاكفها أغلالها",32,"ل",3,0],["ناءٍ عن الأهلين رهن مصائب","فرد بلا صحب ولا أعوانِ",33,"ن",1,0],["ناءٍ عَن السَرّاء تبكي أَعيني","وَالجسم بَين تحوّلٍ وَتفان",34,"ن",1,0],["ناءٍ بأعلى حضرموت مقامه","متجرّعاً كأس البعاد أجاجا",35,"ج",2,0],["ناء عن الخير ذي جدب فليس به","سوى صخور وحر منه ملتهب",36,"ب",1,0],["نآءٍ عَنِ الأهلِ بعيدِ المَنْهجٍ","لم يَرعنْ حُكم الهوى منَ مخرجِ",37,"ج",1,0],["ناءٍ تطاولتِ المهامةُ بيننا","تَدوى من الدهنا إلى الصمّان",38,"ن",1,0],["ناء عن الفحش في قول وفي عمل","ومن رضى اللَه والخيرات مقترب",39,"ب",1,0],["ناءَت أويقاتُ الصفا بتفجُّع","وعلى اللقاءِ تسلَّط التخذيمُ",40,"م",1,0],["ناءٍ عن العين والأحشاء مَرتعه","فلا يَزال على بُعد المدى أمَما",41,"م",2,0],["ناءٍ تُنادمه الذكرى بقُربكم","فينثَني وهو من ذكراكم ثَمل",42,"ل",1,0],["ناْءِ عَن الأهلِ فِي أثباجِ حَضْرَتِهِم","ناْء عنِ المَجْدِ حِلّاَ مثْلَ مُغْتَرِبِ",43,"ب",1,0],["ناءٍ عن الأوطان يفصلُني","عمَّن أُحبُّ البرُّ والبحر",44,"ر",1,0],["نَاْءٍ عَنِ الأَهْلِ! لاْ عَفْرَاْ تُعَاْنِقُنِيْ","وَلا أَنَاْمُ عَلَىْ لَحْنِ الْمَزَاْمِيْرِ",45,"ر",1,0],["ِناءت بكلكلِها أيامُنَا فمشتْ","به يباباً كثيفاً فاقعَ النسبِ",46,"ب",1,0],["ناءت وفي يدها قلبي تُسيّرهُ","ما كنت أعلم أنّ القلب قد رحلا",47,"ل",2,0],["ناءتْ...وتحملُها المراكبْ","بينَ المنافي والمغاربْ",48,"ب",1,1],["ناءَ قلبي من مراراتِ النوى","كفطيمٍ ليتهُ لمْ يفطمِ",49,"م",1,0],["ناءتْ بكلكلِها..وألقتْ حملَها","فوق الرصيفِ بساحةِ الميدان",50,"ن",1,1],["ناءت بأحقاد الغراب غصونها","وسعى التشيطن عابثا بسمائها",51,"ا",3,0],["ناء الربيع بورده","متصحرا ..ماأعسره!!",52,"ر",2,0],["ناءت بحملهم وانهار مأربها","ولم تغادر بها الأيام إنسانا",53,"ن",2,0],["نَاءٍ خَليُّ البَالِ تَعْبَثُ","بِي وَتُشْقِيْنِي بِأَسْرِكْ",54,"ك",1,0],["ناءٍ عن الجُّلى وأنعَى حالتي","قل كيف لو أنا كنت وسْط الرِّيحِ؟",55,"ح",1,0],["ناء عن الناس لا يرجو مودتهم","فليس في الناس من ترجي مودته",56,"ت",2,0],["ناءَ الفؤاد بثقل حملتهِ","هل من قلوبٍ بعدها نهضت",57,"ت",1,0],["نَاءٍ يشقُّ على المطيِّ بلاغُهُ","فتظَلُّ تقعدُ دُونَهُ وتَقُومُ",58,"م",1,0],["ناءتْ بحَمْلٍ أنفسٌ قدْ أُذهِلَتْ","إذ لا نجاة! ومن نجا أوّاها",59,"ا",3,0]]}