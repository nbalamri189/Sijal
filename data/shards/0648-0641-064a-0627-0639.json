{"poems":[[55,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[74,"ديار شعري سقاك السعد ماطره","https://www.aldiwan.net/poem18709.html","البسيط"],[45,"أبعد نأي المليحة البخل","https://www.aldiwan.net/poem10113.html","المنسرح"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140866",""],[45,"أبعد نأي المليحة البخل","https://www.poetsgate.com/ViewPoem.aspx?id=95",""],[275,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[347,"ما للجمال ومالي","https://www.aldiwan.net/poem55367.html","المجتث"],[369,"بدا في فرعك الوخط","https://www.aldiwan.net/poem60858.html","الهزج"],[503,"وعندي من لواحظها حديث","https://www.aldiwan.net/poem3707.html","الوافر"],[543,"وفي كبد المفجوع ما الله عالم","https://www.aldiwan.net/poem47577.html","عموديه"],[572,"روح من الماء في جسم من الصفر","https://www.aldiwan.net/poem69680.html","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126717","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49939","الطويل"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101894","الرجز"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83245","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62951","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91220","الوافر"],[4306,"","https://poetry.dctabudhabi.ae/diwan/poem/121962","المنسرح"],[5145,"ألا بكر السحاب ضحى الخميس","https://www.poetsgate.com/ViewPoem.aspx?id=108074",""],[5376,"دخلْتُك آمناً ولك ائتلاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188462",""],[5380,"يا راقيا فوق أقطاب العلا وعلا","https://www.poetsgate.com/ViewPoem.aspx?id=127727",""],[5587,"أنت الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=202780",""],[5752,"في محراب الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=1331",""],[5190,"دعاة الشر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85051&r=&rc=126",""]],"verses":[["وَفي أَعيُنِ القَومِ اِنضِمامٌ مِنَ الكَرى","وَطَرفُ السُرى بَينَ الأَزِمَّةِ شاهِدُ",0,"د",1,0],["وفي أعاليه سرجٌ من محامدكم","قبل القناديل تستعلي منائره",1,"ر",2,0],["وَفي اِعتِمارِ الأَميرِ بَدرِ بنِ عَم","مارٍ عَنِ الشُغلِ بِالوَرى شُغُلُ",2,"ل",1,0],["وفي اعتماد الأمير بدر بن عما","رٍ عن الشغل بالورى شغل",3,"ل",1,0],["وَفي اعتِمادِ الأَميرِ بَدرِ بنِ عَم","مارٍ عَنِ الشُغلِ بِالوَرى شُغُلُ",4,"ل",1,0],["وفي أعمالِكم تكذيبُ قولٍ","غدا كيّاً على الجرحِ الدميِّ",5,"ي",1,0],["وفي اعالي الفضاء","ام في فضاء الاعالي",6,"ل",2,0],["وَفي أَعطافِهِ هِزَّ","ةُ ما يُنبِتُهُ الخَطُّ",7,"ط",1,0],["وفي أَعطافها النَشوَى دليل","وما ذُقنا ولا زعم الهُمامُ",8,"م",1,0],["وفي أعيُنِ الباكي من الدمعِ ما الذِي","به يَشتفِي الباكِي إذا العينُ تَدمَعُ",9,"ع",1,0],["وفي أعالِيْهِ حُسْبَانٌ مُفَصّلَةٌ","للنّاظِرِيْنَ بِلاَ ذِهْنٍ ولا فِكْرِ",10,"ر",1,0],["وفي أعتابها كلّ البرايا","تَراهم في ركوعٍ أو سجودِ",11,"د",1,0],["وفي أَعينُ الشَّانْين والحُسَّد القَذى","وأكْبادُهم بالغيْظِ داميةُ القَرْحِ",12,"ح",1,0],["وفي اعتبار ذاك في ابن المرضعة","قولانه والرجحان مع من منعه",13,"ه",1,0],["وَفِيّاً عَبقَرِيّاً أَريحِيّاً","أَليفاً ناهِضاً شَهماً رَزينا",14,"ن",2,0],["وفي أَعوجياتِ الرهانِ اذا صفتْ","وصَمِّ العوالي والسهامِ نُحولُ",15,"ل",1,0],["وَفي أَعطافه لينٌ وَشدّ","عَلى حُكم المَناطق وَالبُنود",16,"د",1,0],["وفي اعتِدالِ الخَرِيفِ أَحسنُ ما","يُرْ قِلُ مِثلَ الرَّداحِ في أُزُرِه",17,"ر",2,0],["وفي إعطاء تيك الهلك برداً","وفي إعطائه دفء النفوس",18,"س",1,0],["وفي أعطافِها خيرٌ عميمٌ","وفي غيماتها كأسٌ دهاقُ",19,"ق",1,0],["وفي اعتقادي بأني لا أخيب إذا","أملت من كان وهابا وفتاكا",20,"ك",2,0],["وَ فِي أَعْيَادِهَا رُوحِي تُنَادِي","سَأَكْتُبُ فِي مَعَانِيهَا الكِتَابَا",21,"ب",2,0],["وفي أعيني من سَنا الله بَرْق","يُحَسّ ، ولكنه لا يُشامْ",22,"م",1,0],["وفي أعماقِكُم حِقدٌ توارى","وإنْ أخفاهُ عند النُّطقِ نُطقُ",23,"ق",1,0]]}