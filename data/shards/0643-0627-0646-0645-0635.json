{"poems":[[44,"ألا تلك عرسي أم سكن تنكرت","https://www.aldiwan.net/poem50437.html","الطويل"],[4,"ألم تلمم على الدمن الخوالي","https://www.aldiwan.net/poem21182.html","الوافر"],[74,"على مثلها فلتهم أعيننا العبرى","https://www.aldiwan.net/poem18716.html","الطويل"],[26,"أمن أم سفيان طيف سرى","https://www.aldiwan.net/poem24085.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85603","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62233","المتقارب"],[228,"جثا الليل ملتفا ببرد السرائر","https://www.aldiwan.net/poem41614.html","الطويل"],[327,"بانت سليمى وأقوى بعدها تبل","https://www.aldiwan.net/poem56346.html","البسيط"],[327,"أرقت وشر الداء هم مؤرق","https://www.aldiwan.net/poem56359.html","الطويل"],[369,"ألا طرقتنا والثريا كقرطها","https://www.aldiwan.net/poem60853.html","الطويل"],[2399,"","https://poetry.dctabudhabi.ae/diwan/poem/26606","الوافر"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99414","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74059","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108022","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45759","الطويل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33119","البسيط"],[3833,"","https://poetry.dctabudhabi.ae/diwan/poem/147703","الوافر"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133303","البسيط"],[4679,"من الشهبُ المحاطة بالضبابِ","https://www.poetsgate.com/ViewPoem.aspx?id=142741",""],[5213,"أعرّست على العذيب العرب","https://www.poetsgate.com/ViewPoem.aspx?id=170410",""]],"verses":[["كَأَنَّ مَصاماتِ الأُسودِ بِبَطنِهِ","مَراغٌ وَآثارُ الأَراجيلِ ملعَبُ",0,"ب",1,0],["كَأَنَّ مُصَفَّحاتٍ في ذُراهُ","وَأَنواحاً عَلَيهِنَّ المَآلي",1,"ل",2,0],["كأنَّ مصابيحَ الظلام بأفقهِ","لفقدك نيرانُ الصبابة والذكرى",2,"ر",2,0],["كَأَنَّ مَصاعيبَ غُلبَ الرِقا","بِ في دارِ صِرمٍ تَلاقى مُريحا",3,"ح",2,0],["كأَنَّ مصر ووادي النيل يخصبها","حسناء ترفل في أَثوابها القشب",4,"ب",1,0],["كَأَنَّ مَصَاعِيبَ أَنْقَائِهِ","جِمَالٌ هِجَانٌ تُسَامِي جِمَالاَ",5,"ل",2,0],["كَأَنَّ مَصاريعَ الكَوى وَهيَ شُرَّعٌ","جُفونُ يَتيمٍ موجَعِ القَلبِ حائِرِ",6,"ر",1,0],["كَأَنَّ مَصقولَةً بَيضاً يُهَّدُ بِها","لَهُ سَجيمَةُ جَودٍ كُلُّها هَطِلُ",7,"ل",1,0],["كَأَنَّ مَصابيحاً غَذا الزَيتُ فُتلَها","ذُبالاً بِهِ باتَت إِذا التَجَّ تَذلَقُ",8,"ق",1,0],["كأنّ مَصوغاتٍ بأيدي عِجالِها","إذا ذَعرتْ ليلُ الكئيبِ بخَبْطها",9,"ط",3,0],["كَأَنَّ مُصَدَّرا يَحبو وَرائي","إِلى أَشبالِهِ يَبغي الأُسودا",10,"د",2,0],["كأن مصون ما احرزت فيها","على أبواب مشرعة الخيام",11,"م",1,0],["كانَ مصاب الأَحرار خطباً","بفقد صمصامهم جَسيما",12,"م",2,0],["كأَن مصرَ بباريسٍ وما احتجبت","عني وما بنتُ عنها قط محتجبا",13,"ب",2,0],["كَأَنَّ مَصابيح السَماء تَنَزَلَت","وَأَطلَع وَجه الأَرض نَجماً تَوَقَدا",14,"د",2,0],["كَأَنَّ مِصرَ وَصورَ السورِ باطِنُهُ","فينا وَظاهِرُهُ فيهِمُ بِما كَفَروا",15,"ر",3,0],["كأن مصائب الدنيا سهامٌ","لها الأيام أغراض الرمايه",16,"ا",3,0],["كأن مصر وقد قامت مظاهره","بالسلم صارت بعين الجند ألمانا",17,"ن",2,0],["كأن مصابهُ شيءٌ يسيرٌ","فزدتن المصاب على المصابِ",18,"ب",1,0],["كأن مصفر البهار وجنة","صد بها خوف الوشاة ربرب",19,"ب",1,0]]}