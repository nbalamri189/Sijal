{"poems":[[47,"أنظر إلى العلياء كيف تضام","https://www.aldiwan.net/poem65657.html","الكامل"],[95,"عَبْدَ العَزِيزِ لَقَدْ جَزِعْتَ","https://www.poetsgate.com/ViewPoem.aspx?id=33738",""],[91,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[234,"يا عذبة الرشف هل لمكتئب","https://www.aldiwan.net/poem50892.html","المنسرح"],[266,"يا أخا العين في المحاسن عينا","https://www.aldiwan.net/poem38162.html","الخفيف"],[266,"هذي ربى الأثلات من يبرين","https://www.aldiwan.net/poem38165.html","الكامل"],[354,"بي للورى فليطل العجب","https://www.aldiwan.net/poem15535.html","السريع"],[415,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[469,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203691",""],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64944","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64736","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27146","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45835","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109906","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89576","الكامل"],[4755,"الحَربُ تُلقِي خِطابًا ساذِجًا","https://www.poetsgate.com/ViewPoem.aspx?id=192964",""],[4755,"كَبيرَةُ الهَمِّ رُوحِي","https://www.poetsgate.com/ViewPoem.aspx?id=207774",""],[4755,"حَجْر الله\" الصحي","https://www.poetsgate.com/ViewPoem.aspx?id=211332",""],[5277,"رغبةٌ من جنون","https://www.poetsgate.com/ViewPoem.aspx?id=188248",""],[5277,"زد في تعلّاتي","https://www.poetsgate.com/ViewPoem.aspx?id=191051",""],[5277,"سيدي العراق","https://www.poetsgate.com/ViewPoem.aspx?id=201721",""],[5277,"قُطيْطةٌ..","https://www.poetsgate.com/ViewPoem.aspx?id=214906",""],[5376,"بي لوعة العشاق تهمي خافقي","https://www.poetsgate.com/ViewPoem.aspx?id=188476",""],[5464,"وفي حقول فؤادي أتمَرَ القصب","https://www.poetsgate.com/ViewPoem.aspx?id=21368",""],[6120,"قَلْبِيْ عَلَىٰ نَارِ الصَّبَابَةِ يَكْتَوِي","https://www.poetsgate.com/ViewPoem.aspx?id=213514",""]],"verses":[["بي لا بِغَيرِيَ تُربَةٌ مَجفُوَّةٌ","لَكَ في ثَراها رِمَّةٌ وَعِظامُ",0,"م",1,0],["بِي لاَ بِكَ البَرَحُ الَّذي","تَشْكُوهُ مِنْ حَرِّ الضُّلُوعِ",1,"ع",1,0],["بي لا تمشي بعد ذلك رجلي","فوق ارض ولا يفكر رأسي",2,"ي",1,0],["بي لوعةٌ منكِ ليس يُطْفِئها","إلاّ جَنَى الظَّلِمْ من ثَناياكِ",3,"ك",1,0],["بي لرؤياك أي شوق مبيد","من ضلوعي إلا الجوى والحنينا",4,"ن",2,0],["بي لوعة ومن الحوادث روعة","لا شي اقتل فيك من دائين",5,"ن",1,0],["بي لِلوَرى فَليَطُلِ العُجبَ","لِأَنَّ سَهلي عِندَهُم صَعبُ",6,"ب",1,1],["بي لوعَتان عليكَ يضعُفُ عنهما","جَلَدِي من الأشْواقِ والإشفاقِ",7,"ق",1,0],["بيلتُ بعطف لا يميل لعاشق","كئيب وعطف كالقضيب يميل",8,"ل",1,0],["بي لهفة المشتاق لل","عاصي المضمّخ بالطيوبِ",9,"ب",1,0],["بي لَمٌ مِنْ وَضَحِ اللِّمَّهْ","وفَرْطُ هَمٍّ أَضعفَ الهِمَّهْ",10,"م",2,1],["بِي لُوْعةٌ ليسَ يُطفي الماءُ غُلَّتَها","وفي ثناياه ورْدٌ غيرُ مُوْرودِ",11,"د",1,0],["بي لاعِجٌ مِن حُبِّ رَملَةِ عالِجٍ","حَيثُ الخِيامُ بِها وَحَيثُ العينُ",12,"ن",1,0],["بي لِلفُراق جَوى لَو مَرَّ أَبرده","بِقَلب مَن لامَني في الحُب ما عَذَلا",13,"ل",2,0],["بيلاطسُ البنطيُّ أَذهَلَ لُبَّهُ","صمتُ المسيح بغير رَدِّ جوابِ",14,"ب",1,0],["بي للحمى عوداً إذا ما ارتويت","لا تتركاني إن أمت ثم ميت",15,"ت",1,0],["بي لَوعَةٌ بِيَ حَسرَةٌ","بِيَ وَحشَةٌ بِيَ داهِيَه",16,"ي",2,0],["بي لَهفَةٌ لستُ أَدري كيف أَنطِقُها","شِعرًا، ولا الصَّبرُ يدري كيف يَصبِرُها",17,"ر",3,0],["بي لَهفَةٌ.. لستُ أَدري كيف أَجعَلُها","شِعرًا ولا الصَّبرُ يَدري كيف يَصبِرُها",18,"ر",3,0],["بِي لَفِيفٌ مِن ذِكرياتٍ، وبِي ما","ليس يُنسَاهُ رَاجِعٌ دُونَ رَجعَة",19,"ع",2,0],["بي لوعةٌ وبعيدُ الدارِ يعرفُها","تمضي عليَّ بإلفٍ طالما اغتربا",20,"ب",2,0],["بي لوعةٌ يومَ الفراقِ وجدتها","قد زادها عشقٌ هناك مسافرُ",21,"ر",1,0],["بيلسانُ الروضِ في ماءِ الندى","حولكَ اليومَ علينا ينتشرْ",22,"ر",1,0],["بي للإيابِ سفينُ روحٍ تائهٍ","تشتاق أنْ ترسو وتطرقُ بابيا",23,"ب",3,1],["بي لوعة العشاق تهمي خافقي","والإلف بدرٌ نوره براق",24,"ق",1,1],["بي للأحبة ِوجد ٌ ما عرفت له","صبرا ً ودون مناي الضّيمُ والرّعُبُ",25,"ب",1,0],["بِيْ لَهْفَةُ العُشَّاْقِ لَا مُنْجٍ لَهَا","وَالقَلبُ رُغمَ بَلَائِهِ لَا يَرْعَوِي",26,"و",2,0]]}