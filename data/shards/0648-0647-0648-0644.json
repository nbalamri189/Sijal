odules.php?name=Sh3er&doWhat=shqas&qid=22753&r=&rc=14",""]],"verses":[["وَهَولٍ يُرعَدُ النِسيانُ مِنهُ","رَكِبتُ مَعارِضَ الجَدِّ المَرومِ",0,"م",1,0],["وَهَولٍ يَغيظُ الحاسِدينَ رَكِبتَهُ","وَحيدَ العُلى وَالهائِبونَ نُزولُ",1,"ل",1,0],["وَهوَ لَعَمري أَخَسُّ مَن وَطيءَ التُر","بَ وَأَولى بِاللعنِ وَالسَبِّ",2,"ب",1,0],["وهو لولا طموحها","لم يتيم ولا اكتوى",3,"و",2,0],["وهؤلاء الشيب والمرد من","أسواقها في شرها ملتقى",4,"ا",1,0],["وهو لا يملك أمراً","غير كرسيّ الوزاره",5,"ر",2,0],["وهْو لما يلتذُّ من نيكه","أنفاسُهُ تَصْعَد في الصدر",6,"ر",1,0],["وهْو لي جُنَّةٌ تفُلُّ شبا بأ","سِك بل عُدَّةٌ تفضُّ عديدَك",7,"ك",1,0],["وهْو لا ينفك من عَوداته","فيه بالآلاء تَتَرى والمِنَنْ",8,"ن",1,0],["وَهوَ لِلشُهبِ تَستَحِمُّ بِهِ في الصَي","فِ لَيلاً كَأَنَّها تَتَبَرَّد",9,"د",1,0],["وهو للقوم الرافهين هتاف","وهو للناس البائسين نحيب",10,"ب",1,0],["وهو لقوم عضهم","صرف الزمان مأتم",11,"م",1,0],["وهو لرهط اعرسوا","قيثارة ترنم",11,"م",1,0],["وهو لمن قد عوجت","اخلاقه مقوم",11,"م",1,0],["وَهُوَ لِفَضلِ الطاهِرين ناسِ","وَما لَهُم في الحُب عِندَ الناسِ",12,"س",1,0],["وَهَولٍ كَشَفتَ وَنَصلٍ قَصَفتَ","وَرُمحٍ تَرَكتَ مُباداً مُبيدا",13,"د",2,0],["وَهوَ لا تَلحَقُ الدِماءُ غِرارَي","هِ وَلا عِرضَ مُنتَضيهِ المَخازي",14,"ز",2,0],["وهْوَ لا يدري مداراةَ الورى","ومداراةُ الورى أمرٌ مُهمْ",15,"م",1,0],["وهْو للضيفِ حارمُ","وهْوَ للعرضِ دابقُ",16,"ق",1,0],["وَهوَ لَعَمري شاعِرٌ مُغرِزٌ","بِالفِعلِ لَكِن لَفظُهُ مُجبِلُ",17,"ل",1,0],["وهو لمن قد عوجت","أخلاقهم مقومُ",18,"م",1,0],["وهؤلاء البائسونَ الجياعْ","تطحنهم تلك الرَّحى الدائرهْ",19,"ه",1,0],["وهو لاهٍ بخدرها","ثَمِلٌ بالذي غَنِمْ",20,"م",1,0],["وَهْوَ لاَ يَمْنَحُهْا مِنْ بَالِهِ","غيْرَ هَمِّ الخطَرِ المَكسُوبِ قَمْرا",21,"ر",2,0],["وهو لو ريم على ساح الوغى","لفداه من معدّ كل حلس",22,"س",1,0],["وهوَّل ما يهوِّلُ واستطارت","بُروقٌ تنشُرُ النبأَ الجُسَاما",23,"م",2,0],["وهو لولا عُذوبةُ الْحُبِّ ما فا","ضَ بعَذْبٍ من النَّمِيرِ زُلال",24,"ل",1,0],["وَهْوَ لاَ يُؤمِنُ حَتَّى","سَلَبُوه الروحَ جَهْرَهْ",25,"ر",2,0],["وهؤلاءِ الدُّعاةُ العاكفونَ على","أوهامهم ، صنماً يُهدون القُرَبا",26,"ب",2,0],["وهو لا ينفك في استعراضها","ذا زفيرٍ ونُباحٍ متعالي",27,"ل",2,0],["وهؤلاء غدا معنى أولئك في","القرآن قد عُدَّ معناه وفحواه",28,"ا",2,0],["وهو لا زالَ في ذُرَاكَ مقيماً","أينَما كنتَ لم يزل جوّالا",29,"ل",2,0],["وهؤلاءِ طغوْا في سَعيهم وبغوا","وغرَّ بعضهم بعضاً بما ائتمرُوا",30,"ر",3,0],["وهؤلاء فلم تؤمَنْ غوائلهم","حتى الممات فلا ينفكُّ يرتقبُ",31,"ب",1,0],["وهْو لابدَّ أن تُشاوِر حَبْراً","عالماً بالأحوالِ والآراءِ",32,"ا",2,0],["وهْو لَعَمْرِي مما يراه","من شدةِ الهول لا يُلام",33,"م",1,0],["وَهوَ لعمري حِصنٌ حَصينٌ","مِن كلّ نازٍ وكلّ نازِغ",34,"غ",1,0],["وَهوَ للَّه وحدهُ عبدهُ الخا","لِصُ مَجلى الصفات والأسماءِ",35,"ا",2,0],["وهو لي مذ كنت أصل للشقاء","وهو للغير سبيل للهناء",36,"ا",2,0],["وهو للأمة المجيز على مت","ن الصراط مزلة المخدوش",37,"ش",1,0],["وَهوَ لَعَمري مُرتَجٌ","إِلّا عَلَيكَ مُقفَلُ",38,"ل",1,0],["وَهوَ لا يَسخو بِهِ أَو","يَدخُلَ الوَردُ الحَديثُ",39,"ث",1,0],["وَهوَ لَوحُ الأَسرارِ وَالقَلَمِ الأَع","لى وَعَرشٌ لِلمَشهَدِ العَينيِّ",40,"ي",1,0],["وَهوَ لَعَمري تَرجُمانٌ وَنا","هيكَ بِهِ في الناسِ مِن تَرجُمان",41,"ن",1,0],["وَهوَ لَو يَأمُرُنا يَوماً لَهُ","بِسُجودٍ لَسَمِعنا وَأَطَعنا",42,"ن",2,0],["وهو لا ينفكُّ يروي العللا","وله غُنَّةُ رُجعي ومتاب",43,"ب",1,0],["وَهوَ لِلمَرءِ رَوضَةٌ","أَو مَضيقٌ وَبَلقَعُ",44,"ع",1,0],["وَهوَ لَم يَبقَ هَكَذا","كانَ أَجدى وَأَنفَعُ",44,"ع",1,0],["وَهو لمّا حَوى اِفتخار فريقٍ","سَتراه أميره بعد آنِ",45,"ن",1,0],["وَهَولُ الحَشرِ أَفظَعُ كُلِّ أَمرٍ","إِذا دُعِيَ اِبنُ آدَمَ لِلحِسابِ",46,"ب",1,0],["وَهوَ لا شَكَّ نافِعٌ وَمُفيدُ","صَنَعَ مِن طِبٍّ يا أَخي لِمَن حَب",47,"ب",1,0],["وَهوَ لِلشِدَّةِ ذُخرٌ زاخِرٌ","لا عَدِمناهُ وَنِعمَ المُدَّخَر",48,"ر",1,0],["وهو لو يرحمُ شكوا","يَ قضى بالغرق",49,"ق",1,0],["وَهْوَ لا يَنكُرُ السِّراجَ وَكَمْ ضَ","مَّهُما في المَسَاءِ وَقْتٌ وَاحدْ",50,"د",1,0],["وَهوَ لي فَوقٌ وَتَحتٌ وَوَرا","وَأَمامُ وَيَمينٌ وَشِمالُ",51,"ل",1,0],["وَهوَ لي فَوقٌ وَتَحتٌ وَوَراً","وَأَمامٌ وَجَليسٌ عَن يَدَي",52,"ي",1,0],["وهو لي شمس وجودي","وهو للداء شفا",53,"ف",2,0],["وَهوَ لِقَلبي ذاعِرُ إِبعادُهُ","فَردُ الذُرا المُكثِرُ غَيظَ حُسَّدي",54,"د",2,0],["وهوْلَها مُواصِلُ الجَفاء","مُبَدِّلُ الإدناء بالإقصاء",55,"ا",2,0],["وهو له الا حسابه والعذاب الوبيل","والخوف من كل ظالم مثل قاتل قتيل",56,"ل",1,0],["وَهوَ لَولا الدينُ لَم يَأ","سَف عَلى مَن قَد نَفاها",57,"ا",3,0],["وهو لم يأته يقينا ولا ف","رَّ عليه الغلام يا بن الهمام",58,"م",1,0],["وهو لا بد أن يكون لشيء منهما","عند جلة الأعلام",59,"م",1,0],["وهْوَ لاشَكَّ شاهِدٌ","أنَّ إبريقَنا شَبَهْ",60,"ب",2,0],["وَهوَ لو نَادى عِظامي","رِمّةً لَبّى صَداهَا",61,"ا",3,0],["وهو للدين عماد وبشير","وهو سيل ان تبدى خاطبا",62,"ب",2,0],["وهو للفضل سمير ونصير","وهو في الشعر ذكي النفس",62,"س",1,0],["وهو للناس صباح","ولذي الرأي صبوح",63,"ح",1,0],["وهو للحادِثِ منَّا مُظْهِرٌ","وكذا الحادِثُ منَّا مظهَرُ",64,"ر",1,0],["وهوَ لو شاءَ قتلَهُمْ ما أصابوا","مهرَباً من حُسامهِ المَشهورِ",65,"ر",1,0],["وهو لآل المصطفى خاذل","وأنت سيف لهم ناصر",66,"ر",1,0],["وهوَ لولاكِ خَديناً","لَم يُصِبهُ ما أصَابَه",67,"ه",1,0],["وهو لسَانُ العالَم","مِن أعجمِي وَعَربي",68,"ي",1,0],["وَهوَ لِنَفسِهِ إِذ","يَظلِمُ مُستَفيدُ",69,"د",1,0],["وهو لا شك وصف ولدان حور","حجبت بالجلال عن كل عين",70,"ن",1,0],["وهو لولا فيه سمعي","ياتُهُ محضُ ضلال",71,"ل",1,0],["وهو لم يولد كما قا","ل بنص متلالي",71,"ل",2,0],["وهو لسره النزيه هيكل","يروق للوارد منه المنهل",72,"ل",1,0],["وهو لا شك عارف","وهو ذو الفهم والذكا",73,"ك",2,0],["وهو لاهي القلب مشتغل","بسواه والسوى غلط",74,"ط",1,0],["وهو لا شك قامر","كل شيء إليه قمر",75,"ر",1,0],["وهو لا يظهر إلا بعد أن يفنى الورى","كلهم يظهر بالإيمان منه في الشهود",76,"د",1,0],["وهو لا شك كثير بالورى","وهو في تحقيقه منفرد",77,"د",1,0],["وَهْوَ لاَ يَفُوزُ بِمَا يَرْتَجِيْهِ","لاَ وَلاَ يَضِلُّهُمَا عَنْ سَبِيْلِ",78,"ل",1,0],["وَهْوَ لا يدري لِنَخْوَتِهِ","أنّنا في النّومِ نَصْطَلِحُ",79,"ح",1,0],["وهؤلاء قدموا عليا","عليه وهو عندهم بديا",80,"ي",2,0],["وهو لا يَلْبَسُ الحُليَّ ولكِن","ربَّما كان في اليَمينِ مختَّم",81,"م",1,0],["وهْو لحتفي صنمٌ فاتِنٌ","ما فيه غَيْرَ