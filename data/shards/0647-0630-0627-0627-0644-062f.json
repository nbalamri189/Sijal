{"poems":[[107,"هذا الدفاع وهذه الأجناد","https://www.aldiwan.net/poem42120.html","الكامل"],[78,"أبا عبيدة ما المسؤول عن خبر","https://www.aldiwan.net/poem39033.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[102,"في بيتها العريق","https://www.poetsgate.com/ViewPoem.aspx?id=50421",""],[203,"هذا الدجى والهم في صدري","https://www.aldiwan.net/poem45622.html","أحذ الكامل"],[228,"في ليلة حالكة كالهموم","https://www.aldiwan.net/poem39701.html","السريع"],[409,"أسواك إن حلت بنا اللوآء","https://www.aldiwan.net/poem34179.html","الكامل"],[487,"يا ربنا يا مظهر الشهود","https://www.aldiwan.net/poem24528.html","عموديه"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124614","الكامل"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18243","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49093","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125476","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27607","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116494","الرجز"],[3523,"","https://poetry.dctabudhabi.ae/diwan/poem/131357","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205711","المجتث"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135858","الرجز"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44721","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94487","الكامل"],[4288,"","https://poetry.dctabudhabi.ae/diwan/poem/95805","المجتث"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57987","البسيط"],[4767,"نشوة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=198112",""],[4858,"من شعب عمر المختار","https://www.poetsgate.com/ViewPoem.aspx?id=138201",""],[4858,"العيد أقبل والأحباب قد بانوا","https://www.poetsgate.com/ViewPoem.aspx?id=143449",""],[4896,"في وجه العدوان","https://www.poetsgate.com/ViewPoem.aspx?id=180880",""],[5187,"صامدٌ أيها الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=37392",""],[5413,"إنا بفراقكما لمحزونون","https://www.poetsgate.com/ViewPoem.aspx?id=208634",""],[5616,"أين النخوة العرباء؟","https://www.poetsgate.com/ViewPoem.aspx?id=204849",""]],"verses":[["هذا الدفاعُ وهذه الأجنادُ","أَأَمِنتَ أن تتوثَّبَ الآسادُ",0,"د",1,1],["هذا الدليلُ ولا قولٌ غُرِرتَ بهِ","منَ القوانينِ يُجلي القولَ والعَمَلا",1,"ل",2,0],["هذا الدمُ الغالي الذي أرخصتمُ","هوَ في بناءِ المجدِ أولُ باني",2,"ن",2,0],["هذا الدهليز المستلقي","هذي الجدران المصقولة",3,"ل",2,0],["هذا الدُّجى والهمُّ في صدري","كالفحمِ زادَ توهجَ الجمرِ",4,"ر",1,1],["هذا الدُجى الحالِكِ هذا الغِطاء","ماذا وَراءَ اللَيلِ هَل من ضِياء",5,"ا",2,0],["هذا الدليل بأن ربك واحد","يختار لا قسْرٌ ولا إلجاء",6,"ا",2,0],["هذا الدعاء وعليك التكلان","أجب دعانا عاجلا يا رحمان",7,"ن",1,0],["هذا الدعاء فمنك رب إجابةٌ","أنت المجيب الواحد الفتّاح",8,"ح",1,0],["هَذا الدَواءُ الَّذي يَشفي جَماعَتَكُم","حَتّى تُطيعوا عَلِيّا وَاِبنَ عَبّاسِ",9,"س",1,0],["هذا الدليلُ على خلائقِك التي","من أَجلها كلٌّ عليكَ يرحِّم",10,"م",1,0],["هذا الدواءُ الذي ردَّ اللقاءَ لنا","أسرع لقد آن وقتُ اللهوِ واللعِبِ",11,"ب",1,0],["هذا الدليلُ على إمكانه ولذا","لو شاء كان اصطفاءٌ منه عنه لنا",12,"ن",2,0],["هذا الدَّليلُ هو الذِي أرداهُمُ","بل هَدَّ كُلَّ قَوَاعِدِ القرآنِ",13,"ن",1,0],["هذا الدعا فهات بالاجابه","والقصد من دعائنا الانابه",14,"ه",1,0],["هذا الدعا منا وأنت وعدتنا","بإجابة ولأنت أوفى من وفى",15,"ف",2,0],["هذا الدلال علاما","أكان حتمًا لزاما",16,"م",2,1],["هذا الدعاء مني والإجابهْ","منك فقد حقَّقتها إصابهْ",17,"ه",1,0],["هَذا الدواءُ أَتى مِن مَعشَرٍ شُهرواً","بَينَ الكَرامِ وَأَقوى الناسِ إِيمانا",18,"ن",2,0],["هَذا الدعا تتلوهُ مريم أسعدٍ","لمليكة الألطاف ما سارٍ سرى",19,"ر",2,0],["هذا الدَعيُّ الذي غَي","رُ جَهله لم يُهِنهُ",20,"ن",2,1],["هذا الدليل غداة الحشر في ندم","يفضي إلى نار خلد ذات حيَّاتِ",21,"ت",1,0],["هذا الدعا لله أرفعه","والاستجابة منه يا ولدي",22,"د",2,0],["هذا الدّعِيُّ بشعبنا متبجّحٌ","زوراً وبهتاناً وزاد جفاءَ",23,"ا",2,0],["هذا الدّعاء أيا ربّي ومسألتي","فهل تقرّ بمرأى الوُلْد أجفانُ ؟!",24,"ن",1,0],["هذا الدم الفائر المهتاج نبعثه","ناراً ونحرق منه كل مغتصب",25,"ب",1,0],["هذا الدَّمُ المُهراقُ حَبلُ تَواصُلٍ","قد مُدَّ مِن ( عَبسٍ ) إلى ( ذُبْيانِ )",26,"ن",1,0],["هذا الدعاءُ وأنتَ الربُّ لي أبدًا","فارحمْ عبيدكَ بل فامنحه ما سألا",27,"ل",2,0],["هذا الدمُ المسفوحُ في","بلدي يجودُ به الشبابُ",28,"ب",1,0]]}