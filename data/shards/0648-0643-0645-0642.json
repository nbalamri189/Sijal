البسيط"],[479,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[482,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[482,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[482,"أنخت مطايا الذل نحوك ملقيا","https://www.aldiwan.net/poem24461.html","عموديه"],[500,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[514,"بقيت بقاء الدهر يا بهجة الدهر","https://www.aldiwan.net/poem20808.html","الطويل"],[515,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[515,"سجوداً فهذا صاحب الركن والحجر","https://www.aldiwan.net/poem12107.html","الطويل"],[515,"قبولاً وإن بان عجز الخواطر","https://www.aldiwan.net/poem12122.html","الطويل"],[515,"لك الحسب الباقي على عقب الدهر","https://www.aldiwan.net/poem12142.html","الطويل"],[529,"نداء لكل الناس فالأمر أعظم","https://www.aldiwan.net/poem37210.html","الطويل"],[529,"رعايا اليمن الميمون","https://www.aldiwan.net/poem37340.html","مجزوء الوافر"],[538,"درست الفقه علما والأصولا","https://www.aldiwan.net/poem47454.html","عموديه"],[551,"نجوت القنا والبيض تدمى متونها","https://www.aldiwan.net/poem47142.html","الطويل"],[551,"أأغفل والدهر لا يغفل","https://www.aldiwan.net/poem47339.html","المتقارب"],[551,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[551,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[558,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[562,"أجارتنا هل للنسيم وصول","https://www.aldiwan.net/poem52906.html","الطويل"],[575,"طراز غرامي في المحبة مذهب","https://www.aldiwan.net/poem2984.html","الطويل"],[575,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[575,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"],[575,"أمجلس لهوي ليس لي منك مجلس","https://www.aldiwan.net/poem3058.html","الطويل"],[575,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[575,"أجل مناه قبلة من حبيبه","https://www.aldiwan.net/poem3098.html","الطويل"],[586,"فكم جمع الحسن النفيس من العلى","https://www.aldiwan.net/poem17490.html","الطويل"]],"verses":[["وَكَم قُمتُ في مَشهَدٍ لِلخُطوبِ","قِياماً بَغيضاً إِلى الحاضِرِ",0,"ر",1,0],["وَكَم قَلبٍ أَسَرَّ عَلَيَّ حِقداً","فَأَفشى سِرُّهُ سِرَّ النَجادِ",1,"د",1,0],["وَكَم قَعدَةٍ مِنّي أَقَمتُ بِبَأسِها","إِلى الطَعنِ مَيّادَ القَنا في كُعوبِهِ",2,"ب",2,0],["وَكَم قَرَعَ الدوَّ مِن حافِرٍ","يُخالُ عَلى الأَرضِ قَعباً يُكَب",3,"ب",1,0],["وَكَم قَد ذَكَرتُكَ في لَيلَةٍ","فَبِتُّ لِذِكراكَ أَرعى النُجوما",4,"م",2,0],["وَكَم قائِلٍ قَد قالَ تُب فَعَصَيتُهُ","وَتِلكَ لَعَمري تَوبَةٌ لا أَتوبُها",5,"ب",3,0],["وَكَم قَد عِشتَ كَم بِالقُربِ مِنها","وَلَكِنَّ الفُراقَ هُوَ السَبيلُ",6,"ل",1,0],["وكمْ قدَمٍ قدْ أُقْدِمَتْ لغَرامِها","ولحظٍ على تَعْذيبِ مهْجَتِهِ دَلاّ",7,"ل",2,0],["وكم قد كتَمْتُ الشّوْقَ لوْلا مدامِعٌ","ترَوّي مَجاريها المحاجِرَ والخَدّا",8,"د",2,0],["وكمْ قد تجشّمْتَ الخُطوبَ كَوالِحاً","وصابَرْتَ ليْلَ الرّوْعِ وهْوَ قدِ ارْبَدّا",8,"د",2,0],["وكم قد جلَوْتَ المُعْجِزاتِ عليهِمُ","شُموساً أقاموا دونَها اللُّبْسَ والجُحْدا",8,"د",2,0],["وَكَم قَد كَسَونا مِن يَتيمٍ وَمَيِّتٍ","سَتَرنا وَلَولانا لَبانَت مَعايِبُه",9,"ب",2,0],["وَكَم قَد سَعى جَدّي لِمَدِّ صَنيعَةٍ","تُهَزُّ لَها أَعطافُهُ وَمَناكِبُه",9,"ب",2,0],["وَكَم قيلَ لي في ساحَةِ الأَرضِ مَذهَبٌ","وَعَن وَطَنٍ لِلنَفسِ مَيلٌ إِلى وَطَن",10,"ن",1,0],["وَكَم قائِلٍ في الأَرضِ لِلحُرِّ مَذهَبٌ","إِذا جارَ دَهرٌ وَاِستَحالَ مَلولُ",11,"ل",1,0],["وَكَم قَد نَزَلنا ثُغرَ قَومٍ أَعزَّةٍ","فَلَم نَرتَحِل حَتّى تَداعى خرابُهُ",12,"ب",2,0],["وَكَم قَد جاوَزَت نَقضي إِلَيكُم","مِنَ الحُزُزِ الأَماعِزِ وَالبِراقِ",13,"ق",1,0],["وكم قرطست فيك الرماة ووترّت","عليك القسيّ الملس يا جعبة النبل",14,"ل",1,0],["وكم قد نثرنا بالسيوف جماجماً","نظمنا بها فوق الثرى للعدى شعرا",15,"ر",2,0],["وكم قامَرتنا ساسة الأمر خُدعةً","فتَمّ علينا بالخِداع لها الدَسْت",16,"ت",1,0],["وكم قد سمعنا ساسة الغرب تدّعي","بأشياء من بُطلانها ضحك الحق",17,"ق",1,0],["وكم قد رَنّ في أمل مُخاف","فأمن صوته الأمل المُخافا",18,"ف",2,0],["وكم قد قام في نادٍ خطيباً","بمُحكمة المقاصد والمبادي",19,"ي",1,0],["وكم قامَ ينعَى حين أنشدت مادحاً","إليّ الندى ناعٍ فأنشدت راثيا",20,"ي",2,0],["وَكَم قَطَعَ القَرينَةَ مِن قَرينٍ","إِذا اِختَلَفا وَفي القَرنِ اِلتِواءُ",21,"ا",2,0],["وَكَم قَد قَتَلنا مِن كَريمٍ مُرَزَّءٍ","لَهُ حَسَبٌ في قَومِهِ نابِهِ الذِكرِ",22,"ر",1,0],["وَكَم قَتَلنا مِن رائِسٍ لَكُمُ","في فَيلَقٍ يُجتَدى لَهُ التَلَفُ",23,"ف",1,0],["وكم قمرٍ فيكِ سافرتُ عنهُ","وعقرب أصداغه غيهب",24,"ب",1,0],["وكم قابلت رجوايَ حالاً حسبته","فضاعف لي ذاك الحساب وعدَّدا",25,"د",2,0],["وكم قهر","من ذي أشر",26,"ر",1,0],["وكم قيل للنفسِ قال العذول","فقالت جفون الرَّشا تغتر",27,"ر",1,0],["وكم قاصدٍ يبكي عليكَ وقاصدٍ","فهذا له بشرٌ وهذا له أجر",28,"ر",1,0],["وكم قلت ما الرفق قال الطلا","وأقسم ما أنت بالذائق",29,"ق",1,0],["وكم قلمٍ ما مرَّ تلوَ دواته","وهنَّ لتدبير الممالك في دنك",30,"ك",1,0],["وكم قيل في البستان غصنٌ وهذه","معاطفها تجلى وفي الغصنِ بستان",31,"ن",1,0],["وكم قَائلٍ لَمَّا هجوتك غيرةً","أمالك في أعراضنا مُتَنَدَّحُ",32,"ح",1,0],["وكم قائلٍ في مثلها وهو طالبٌ","فهل ساقطٌ مستهدِفٌ لمفنِّدِ",33,"د",1,0],["وكم قائل أبلغتَ فيما تقولهُ","فقلت لقد غَنَّيْتُ إنْ ساعد الزَمر",34,"ر",1,0],["وكم قادم منهن مرتادِ منزلٍ","أناخ به منا منيخٌ فجعجعا",35,"ع",2,0],["وكم قطعوا من لسان امرئ","وإن كان لم يَدمَ لما قطع",36,"ع",1,0],["وكم قد قلت حين يُريب رَيْبٌ","مقالة آمِلٍ من آمليكا",37,"ك",2,0],["وكم قائلٍ قد قالَ لي فيك مرةً","أتصحبُ ذا بخلٍ ولستَ بذي بخلِ",38,"ل",1,1],["وكم قد أَهان الشعرَ قبلَك معشرٌ","فلاقى مُهينوه هوانَ سِبالِ",39,"ل",1,0],["وكم قعصَ الأبطالَ إمّا شجاعةً","وإمَّا بمقدارٍ إذا اضطرَّهُ اقتحمْ",40,"م",1,0],["وكم قارعٍ سمعي بوعظٍ يُجيدُه","ولكنَّهُ في الماء يرْقُمُ ما رقمْ",40,"م",1,0],["وكم قائلٍ قد قال لي متمثّلاً","ليوهِنَ مني أو يشدَّ قوى متني",41,"ي",1,0],["وَكَم قَطَعَت وَالرَكبُ غيدٌ مِنَ السَرى","إِلَيكَ اِبنَ رِبعِيٍّ مِنَ البَلَدِ القَفرِ",42,"ر",1,0],["وَكَم قَتَلَت أَروى بِلا تِرَةٍ لَها","وَأَروى لِفُرّاغِ الرِجالِ قَتولُ",43,"ل",1,0],["وَكَم قَد صُنتَ في بَيروتَ عِرضاً","وَكَم أَمَّنتَ في الشَهباءِ روحا",44,"ح",2,0],["وَكَم قَد رَأَت عَيني بِلاداً كَثيرَةً","فَلَم أَرَ فيها مايُسِرُّ وَما يُرضي",45,"ض",2,0],["وَكَم قُلتُ وَلَكِن أَي","نَ مَن يَسمَعُ أَو يَدري",46,"ي",1,0],["وَكَم قَطَعتُ إِلَيكُم مِن مُوَدَّأَةٍ","كَأَنَّ أَعلامَها في آلِها القَزَعُ",47,"ع",1,0],["وَكَم قَد توكفتُها رَوضَةً","تُقَرّب لي الأَمَلَ الأَبعَدا",48,"د",2,0],["وَكَم قَد رَأَينا ساعِياً بِنَميمَةٍ","لآخَرَ لَم يَعمِد بِكَفٍّ وَلا رِجلِ",49,"ل",1,0],["وَكَم قَد خَلَت مِن أَبيكِ الجُيوبُ","وَلَيسَت جُيوبُكِ بِالخالِيَه",50,"ي",2,0],["وَكَم قَد شَكا المُرَّ مِن عَيشِهِ","وَأَنتِ وَحَلواكِ في ناحِيَه",50,"ي",2,0],["وَكَم قَد مَرِضتِ فَأَسقَمتِهِ","وَقُمتِ فَكُنتِ لَهُ شافِيَه",50,"ي",2,0],["وَكَم قَد جاهَدَ الحَيوانُ فيهِ","وَخَلَّفَ في الهَزيمَةِ حافِرَيهِ",51,"ي",2,0],["وكَمْ قَرَّبَتْ مِنْ دارِ عَبْلَةَ عَبْلَةٌ","كَجَنْدَلَةِ السُّورِ المُقابِلِ تُشْرِفُهْ",52,"ه",1,1],["وَكَم قَد مَدَدنا مِن غُرورِ رَجائِنا","إِلى أَمَدٍ مِن وُدِّكُنَّ بَعيدِ",53,"د",1,0],["وَكَم قَد أَغفَلَ العُذّالُ عِندي","مِنَ اِستِئنافِ بَثٍّ وَاِشتِياقِ",54,"ق",1,0],["وَكَم قَد أَعنَقَت مِن رِقِّ مُكثٍ","خُطى هَذي المُخَزَّمَةِ العِتاقِ",54,"ق",1,0],["وَكَم قَطَّعَت أُمُّ العَلاءِ مِنَ القُوى","وَمَوصولِ حَبلٍ بِالعُيونِ الضَعائِفِ",55,"ف",1,0],["وَكَم قَد غَيَّرَ الأَبدانَ مِنّا","عَلى شُعبِ الرِحالِ مِنَ السَمومِ",56,"م",1,0],["وَكَم قاتِلٍ لِلجوعِ قَد كانَ مِنهُمُ","وَمِن حَيَّةٍ قَد كانَ سُمّاً لُعابُها",57,"ب",3,0],["وكم قد سكَنَّا إلى غيرِه","فكنَّا بهِ في عّذابٍ أليمِ",58,"م",1,0],["وكم قَبيحٍ لَهُما مُسَتَّرِ","في كلِّ مَبْدى نازحٍ ومحضَرِ",59,"ر",1,0],["وكم قيلَ لي قد جفاكَ ابنُ فَهْدٍ","وقد كُنتَ بالوصلِ منه جَديرا",60,"ر",2,0],["وكم قد وَطِئْتَ ديارَ العِدا","على الرُّغمِ منهم فجُستَ الدِّيارا",61,"ر",2,0],["وكم قصدَتْكَ أبكارُ القَوافي","فلم يَقنَعْ نَوالُكَ باقتصادِ",62,"د",1,0],["وَكَم قَد طَوَت مِن مَنهَلٍ بَعدَ مَنهَلٍ","وَأَورَدتُها مِن آجِنٍ وَدِفانِ",63,"ن",1,0],["وَكَم قَدَرٍ دَبَّ في غَفلَةٍ","فَلَم يَشعُرِ الناسَ حَتّى هَجَم",64,"م",1,0],["وَكَم قَد تَرَكنا في دِمشقَ وَأَهلِها","مَن أَشمَط مَوتُورٍ وَشمطاءَ ثاكِلِ",65,"ل",1,1],["وَكَم قَد دَعَتني هِمَّتي فَأَجَبتُها","وَكَم لَوَّثَتني هِمَّتي فَتَلَوَّثتُ",66,"ت",1,0],["وَكَم قَد رَأَينا فَتىً ماجِداً","تَفَرَّعَ في أُسرَةٍ ماجِدَه",67,"د",2,0],["وَكَم قَد عَزَّ مِن مَلِكٍ","يَحُفُّ بِهِ قَنابِلُهُ",68,"ل",2,0],["وَكَم قَد طالَ مِن أَمَلٍ","فَلَم يُدرِكهُ آمِلُهُ",68,"ل",2,0],["وَكَم قَد هَفَوتَ بِهُجرِ الكَلامِ","فَأَعرَضتُ عَن سَمعِهِ مِسمَعي",69,"ي",1,0],["وَكَم قَد رامَهُ ضِدّي بِسوءٍ","فَراحَ وَآلُهُ في الحَربِ آلُ",70,"ل",1,0],["وَكَم قَد شاهَدَتكَ الناسُ قَبلي","فَما نَظَروكَ كُلُّهُمُ بِعَيني",71,"ن",2,0],["وَكَم قَصَدتُ بِلاداً كَي أَمُرَّ بِكُم","وَأَنتُمُ القَصدُ لا مِصرٌ وَلا حَلَبُ",72,"ب",1,0],["وَكَم قَطَعتُ إِلَيكُم ظَهرَ مُقفِرَةٍ","لا تَسحَبُ الذَيلَ في أَرجائِها السُحبُ",72,"ب",1,0],["وَكَم قَد كَسَيتَ العِزَّ مِن جاءَ آمِلاً","إِذا ما مَشى في رَبعِ قُدسِكَ حافِيا",73,"ي",2,0],["وَكَم قَضَينا لِلبُكاءِ مَنسِكاً","لَمّا تَذَكَّرنا بِهِنَّ مَن سَكَن",74,"ن",1,0],["وَكَم قَد نَصَرتُكَ في مَعرَكٍ","تَحَطَّمُ فيهِ القَنا الذُبَّلُ",75,"ل",1,0],["وَكَم قَد بَذَلتُ النَفسَ أَخطُبُ وَصلَها","وَخاطَرتُ فيها بِالنَفيسِ عَلى عِلمِ",76,"م",1,0],["وكمْ قدْ شكا الحيفَ منْ دهرِهِ","فأنصفَهُ الدهرُ منْ نفسِهِ",77,"ه",1,0],["وكمْ قدْ بلَّغوني عنكَ جبراً","وتأهيلاً يزيدُ بهِ مراحي",78,"ح",2,0],["وكمْ قدْ أفنتِ الدنيا مليكاً","بعيدَ الصيتِ مُنْبَثَّ السرايا",79,"ا",3,0],["وَكَم قَد لَحَتني العاذِلاتُ جَهالَةً","وَيَأبى المُعَنّى أَن يُطيعَ اللَواحِيا",80,"ي",2,0],["وَكَم قائِلٍ لي اِسلُ عَنها بِغَيرِها","وَذَلِكَ مِن قَولِ الوُشاةِ عَجيبُ",81,"ب",1,1],["وَكَم قَد أضرَمَ الحُسَّادُ نَاراً","عَلَىَّ رَدَدتَهَا نَارَ الخَلِيلِ",82,"ل",1,0],["وَكَم قائِلٍ هَذا النُمَيري فَأَقبَلوا","وَكَم قائِلٍ هَذا النَبيُّ المُجَمَّشُ",83,"ش",1,0],["وَكَم قَد بَكَينا عَلَيهِ دَماً","بِسُمرٍ مُثَقَّفَةِ الأَكعُبِ",84,"ب",1,0],["وَكَم قَد عَفا وَأَقَرَّ الحَياةَ","في آيِسٍ قَلبُهُ يَضطَرِب",85,"ب",1,0],["وكم قد رأينَا من مَسولٍ وسائِلٍ","قديماً ومن مَفضُولِ قومٍ وفاضل",86,"ل",1,0],["وَكَم قَتيلٍ وَلاسِلاحَ لَهُ","غَيرُ الخَلاشيلِ وَالدَماليجِ",87,"ج",1,0],["وَكَم قَد رَأَينا مُطاعاً هُنا","كَ صارَ المُذَلَّلَ لِلمَجلِسِ",88,"س",1,0],["وَكَم قَيَّدَ الدَهرُ مِن دالِفٍ","وَقَد كانَ كَالسابِقِ الجائِلِ",89,"ل",1,0],["وَكَم قَطَعَت سَواري الشُهبِ لَيلاً","سَواهِدَ ما هَجَعنَ وَلا نَعَسنَه",90,"ن",2,0],["وكم قد نجا باغ فما صدق الذي","يقول على الباغي تدور الدوائر",91,"ر",1,0],["وكم قبْلُ منَّاني على وفرِ ما جَنَى","بحربين من زرعي وضَرْع وليدي",92,"ي",1,0],["وكَمْ قَدْ رَأَى رائِيهِمُ وَرَأَيْتُهُ","بِها ليَ مِنْ عمٍّ كَرِيمٍ ومِنْ أَبِ",93,"ب",1,0],["وكم قَصَرْنا صَلاةً غيرُ نافِلةٍ","في مَهْمَهٍ كَصَلاة الكَسْفِ شَعشاعِ",94,"ع",1,0],["وَكَم قائِلٍ قَد قالَ تُب فَعَصَيتُهُ","وَتِلكَ لَعَمري خَلَّةٌ لا أُصيبُها",95,"ب",3,0],["وَكَم قَد أَتَيتُكَ مِن لَيلَةٍ","فَنِلتُ الغِنى وَسَمِعتُ الغِناءَ",96,"ا",2,0],["وَكَمْ قَدْ هَزَلْتِ لتَشْفي النُفُوسَ","فَكَانَ مِنَ الْجِدِّ أَنْ تَهْزِلي",97,"ل",2,0],["وكم قلم في بنَانٍ خَضِيبٍ","حسبناه من شاربْين استُعيرا",98,"ر",2,0],["وكم قد كتمت الشوق لولا مدامع","يروي حديثها المحاجر والخدا",99,"د",2,0],["وكم قد تجهمت الخطوب كوالحا","وصابرت ليل الربع وهو قد اربدا",99,"د",2,0],["وكم قدم قد أقدمت لغرامها","وخط على تعذيب مهجته دلا",100,"ل",2,0],["وَكم قد رَأينا الجامِعينَ قدَ اصْبَحَتْ","لهم، بينَ أطباقِ التّرابِ مَضاجعُ",101,"ع",1,0],["وكم قائل ما اصطلى في الهوى","بناري وقد غرّه ملمسي",102,"س",2,0],["وكم قد مددنا من غرور رجئنا","إلى أمد من ودكن بعيد",103,"د",1,0],["وكم قائل قد قال فيك مرة ً","أتصحبُ ذا بخلٍ ولستَ بذي بخلِ",104,"ل",1,1],["وكم قطعوا من لسان امرىء","ٍ وإن كان لم يَدْمَ لمَّا قُطع",105,"ع",1,0],["وكم قد قلن من قول شجى ٍّ","ومذ حان الوَداع دنون منهم",106,"م",1,0],["وكم قد فزت في حرب وسلم","فلم يلعب بعطفيك العرام",107,"م",1,0],["وكم قال العذول لسوء ظن","بنا يا سعد قولا لا يقال",108,"ل",1,0],["وكم قاطع حبل الوداد لدرهم","وراض له والعزم ادنى واصغر",109,"ر",1,0],["وكم قال العذول بنا لحقد","علينا كامن قولا غثيثا",110,"ث",2,0],["وكم قد جلوا بالمكرمات عيد","وجازوا من الفخر المنيع سباسبا",111,"ب",2,0],["وكم قد أقامُوا من عُروشٍ موائلٍ","وكم قد أقالُوا من جُدُودٍ عَواثِرِ",112,"ر",1,0],["وكم قد دعوني نحوهم فأجبتهم","دعوني فبابُ الرزقِ ليس بمنسدِّ",113,"د",1,0],["وَكَم قالَ رائِي جودِكُم وَوَفائِكُم","وَبَأسِكُمُ ما الفَخرُ إِلّا لِتَغلِبا",114,"ب",2,0],["وَكَم قَد نَهاهُ الناصِحونَ بِزَعمِهِم","فَمَرَّ كَأَنَّ النَهيَ في سَمعِهِ أَمرُ",115,"ر",1,0],["وَكَم قَد بَغاها المُلوكُ الأُلى","فَأَعيَت عَلى بَدوِهِم وَالحَضَر",116,"ر",1,0],["وَكَم قَطَعَ الظَلامَ بِغَيرِ وَعدٍ","غَزالٌ دَأبُهُ قَطعُ الحَبائِل",117,"ل",1,0],["وَكَم قَد عَموا عَنهُ وَكَم صُمَّ سَمعُهُم","وَإِذ حانَ بالكَفِّ الكَريمَةِ قَمعُهُم",118,"م",1,0],["وَكَمْ قَتِيلٍ لَنَا في الحُبِّ مَاتَ جَوىً","مِنَ الغَرامِ وَلَمْ يُبْدِئْ وَلَمْ يُعِدِ",119,"د",1,0],["وكم قضايا على غير الصواب مضت","حكما ولله في تنفيذها حكم",120,"م",1,0],["وكم قللت ما استكثرته نفوسنا","من الجود في الماضيين والخلق الرحب",121,"ب",1,0],["وَكَم قائِلٍ ماذا المقامُ وَإِنَّما","مَقامُ الفَتى المُستَهلِك المالَ عائِبُهْ",122,"ب",2,0],["وَكَم قَبائِلَ بَعدَ المَوتِ أَنشَرَها","وَما لَها غَيرُ مَقصوراتِها تُرُبُ",123,"ب",1,0],["وكَمْ قَدْ وَطئْتُ عَلَى فِتْنَةٍ","وَثُرْتُ بأُخْرَى فَقَضَّيْتُ نَحْبَا",124,"ب",2,0],["وكم قَدْرُ لومِك حتى تُزي","لَ غراما تَمكَّن من أَضْلُعي",125,"ع",2,0],["وكم قَدْرُ ما يستقرُّ الظلام","إذا ما الصباح عليه هجم",126,"م",1,0],["وَكم قامَ يَتلو في الكنيسة خطبةً","بِها نابَ عن قسٍّ وعانقهُ جَهرا",127,"ر",2,0],["وَكَم قامَ في وسطِ المجامعِ خاطباً","وَقد مَزج الإيمانَ بالخلطِ والكفرا",127,"ر",2,0],["وَكَم قَد أتى في الأرضِ منهم طوائفٌ","إِلى عصرهِ عصرٌ قَفا قبلهُ عصرا",128,"ر",2,0],["وكم قيل إنسانية ومحبة","وعلم وتمدين وأشباهها الكثرُ",129,"ر",1,0],["وكم قتلةٍ لي في حروبٍ من الهوى","تسلَّط فيهن الظباءُ على الأُسدِ",130,"د",1,0],["وكم قد شاد مجدا في ابتداء","على العيا عليه الانتهاء",131,"ا",2,0],["وكم قبضت كفاك رمحا وصارما","وكم بسطت يوما لجينا وعسجدا",132,"د",2,0],["وكم قصورٍ شُيِّدت قبله","لكنه أحسنُ ما شُيِّدا",133,"د",2,0],["وَكَم قَد أَتَتني مِن سُخطِكُم","صَواعِقُ ما بَعدَها وابِلُ",134,"ل",1,0],["وكم قَصرِ بها أضحى كحِصن","منيعٍ لا كَزَربٍ من جريدِ",135,"د",1,0],["وكم قابلتُ تزكيّا بمدحي","فكادَ لما أُحاولُ منه يُخنَق",136,"ق",1,1],["وَكَم قَد هَرَقتَ دِماءَ العِدى","تَصُحُّ عَليلاً وَتشفي غُلَل",137,"ل",1,0],["وكم قينةٍ في حليها وحريرِها","منعَّمةٍ تمشي على الخزِّ والمرمر",138,"ر",1,0],["وكم قد أبان الحق في كل محفلٍ","فأورى بما يروي ظماء المحافل",139,"ل",1,0],["وَكَمْ قَلَقْ لَكَ مِنْ ساكِنٍ","عَلَى سَهَرٍ لَكَ مِنْ راقِدِ",140,"د",1,0],["وَكَمْ قَطَعَتْ فِينا اللَّيالِي وَغالَنا","لَها مُقْلِقٌ مِنْ فادِحِ الْخَطْبِ مُزْعِجُ",141,"ج",1,0],["وَكَمْ قَسَمَ الْبَنِيْنُ الضَّنى بَيْنَ مَنْزِلٍ","وَجِسْمٍ وَلكِنَّ الْهَوى جائِرُ الْقَسْمِ",142,"م",1,0],["وَكَم قُمتَ في نَصرِ دينِ النبيِّ","بِصِدق مُقاوِم تُرضي الإِلَها",143,"ا",1,0],["وَكَم قَوافٍ تَروقُ السامِعينَ مَعا","نيها بِلا خَطَأ فيها وَلا خَطَلِ",144,"ل",1,0],["وَكَم قَلعَةٍ أَنكَحتَها السِلمَ عاصِماً","وَطَلَّقتَ مِنها بَعدَ عِصمَتِها الكُفرا",145,"ر",2,0],["وَكَم قد نالَ من يُسراهُ يسراً","أَخو عُسرٍ ومن يُمناه يُمنا",146,"ن",2,0],["وَكَم قد سَبت من مَعقِل العزِّ حُرَّةً","تَوَدُّ الثريّا أَن تَكونَ لها شَنفا",147,"ف",2,0],["وكم قانت قوام في غسق الدجى","من الخوف محشو الفؤاد ومهجة",148,"ه",1,0],["وكم قطعوا براو بحرا لكسبهم","وكم اشهروهم في الورى أهل بلدان",149,"ن",1,0],["وكم قد اضاعوا ملك من لم يع النهى","ولم يحو تدبير الملوك في الأذهان",149,"ن",1,0],["وكم قد تمنى الموت من زاغ عن هدى","الى النفس أو قد مات من شرب ذيفان",149,"ن",1,0],["وَكَم قد أحمد المسرى صباحٌ","وَأعقَب راحةً إلحاح نسِّ",150,"س",1,0],["وَكم قائلٍ إنّا عَهدناه صادقاً","وَآخر يغضي عن قذى ويكذّبُ",151,"ب",1,0],["وكم قارع سناً علي ندامة","وآخر مكوي بنيران حسرة",152,"ه",1,0],["وَكَم قَد رَفَعتُ سُتورَ المُلوكِ","وَزاوَلتُ بِالشِعرِ أَزوالَها",153,"ل",3,0],["وكم قلت لنا صبرا","فربّ الناس موجود",154,"د",1,0],["وكم قوّضت يمناك عرشا موطّدا","تخادعه مكراً لتحطمه كبرا",155,"ر",2,0],["وَكَمْ قَلَبَ المَرابِطَ في رَبيعٍ","وأَيْقَظَ في دُجَاها كُلَّ هَاجِدْ",156,"د",1,0],["وَكَم قَبِلتُ شَمسَ الرا","حِ فيهِ مِن يَدِ البَدرِ",157,"ر",1,0],["وَكَم قَد صَبا الرَكب الحِجازيُّ مُنشِدا","عراقاً وَأَوج الحُسن أَبهى وَأَبهَرُ",158,"ر",1,0],["وَكَم قَيّدت مِن كَرَم ثَناءً","وَكَم أَطلَقت مِن كرب سَراحا",159,"ح",2,0],["وَكم قامَة لاحَت فَقامَت قِيامَتي","وَما صَدّني عَنها عَذول معنف",160,"ف",1,0],["وَكَم قُلت لِلقَلبِ الوَلوع بذكرِها","تصبر فَقال القَلب لَم أَستَطِع صَبرا",161,"ر",2,0],["وكم قد جَرَرتُ ذيولَ الصِّبا","وجُنَّ العواذلُ منّي جُنونا",162,"ن",2,0],["وكم قد نُقلُّ الحمدَ حلْيةَ مُكْثِرٍ","ولا يَهْدِمُ العَلياءَ مُجْتاب إهدام",163,"م",1,0],["وكم قالوا مَجازاً ما أَحاطَتْ","له بحقيقةٍ منّا العُلوم",164,"م",1,0],["وكم قُلتَ ثُمّ فَعلْتَ الجميلَ","وما كُلُّ مَن قال قَولاً فعَل",165,"ل",1,0],["وكم قامَ يَبغي شَأْوَ عَلْياكَ حاسِدٌ","فقالَ الزّمانُ اقْعُدْ فلستَ هُناكا",166,"ك",2,0],["وكم قد تَعنَّى في مَديحِك خاطري","فما كان قَولي من فِعالِك أَبلَغا",167,"غ",2,0],["وكم قَعد الأقوامُ عنك فأظلَمُوا","وجاؤوكَ يَرجون الغِنى فأناروا",168,"ر",3,0],["وكم قد رأوا وفداً إلى البحرِ سائراً","وما سَمِعوا بالبحرِ سارَ إلى وفْد",169,"د",1,0],["وكم قمت بالرّأي من دونه","مقاوم ما شهدته الجنود",170,"د",1,0],["وكم قد هَوى من قُلّةٍ الأُفْقِِ كوكبٌ","وكم ثارَ من تحتِ النِّعالِ تُراب",171,"ب",1,0],["وَكَم قَد مَضى يَومٌ كَلَيلٍ بِهَجرِهِ","بِقَلبِيَ مُسوَدٌّ وَبِالبيضِ أَبيضُ",172,"ض",1,0],["وَكَم قَد جَرى ماءُ الدُموعِ وَعَذلُهُم","فَمَرَّ وَلَم يَرقُمُ عَلى الماءِ راقِمُ",173,"م",1,0],["وَكَم قيلَ لي بَحرٌ فَقُلتُ صَدَقتُمُ","يَضِنُّ بِهِ دُرّاً وَيَسخو بِهِ مِلحا",174,"ح",2,0],["وَكَم قَد خَلا بِشَياطينِهِ","فَأَجرى الحَديثَ بِنا فاجِرا",175,"ر",2,0],["وَكَم قَد سَرَّ في سَمعي مَلامٌ","أَخَذتُ لُبابَهُ وَتَرَكتُ قِشرَه",176,"ر",2,0],["وَكَم قد كَسَونَ عَواري ظُباً","وَكَم قد سَلَبنَ عَواري عَوالي",177,"ل",2,0],["وَكَم قيلَ عَن قائِلٍ إِنَّهُ","وَإِنَّ وَإِنَّ وزادَ التَغالي",177,"ل",2,0],["وَكَم قَد حَجَجنا فيكَ لِلمَجدِ كَعبَةً","وَكَم قَد أَقَمنا فيكَ لِلحَمدِ مَوسِما",178,"م",2,0],["وَكَم قالَ لي لَولاكَ لَم أَلقَ غَمرَةً","كَأَنَّ قَضاءَ اللَهِ لَولايَ عاجِزُ",179,"ز",1,0],["وَكَم قُلتُ حَقّاً لَيتَني كُنتُ عِندَهُ","وَلَم أَتَفَوَّه لَيتَهُ لَيتَهُ عِندي",180,"ي",1,1],["وَكَم قائِلٍ جَهلاً نسلَّ بِغَيرِهِ","وَلا تَجرِ ذِكراهُ بِسرٍّ وَلا جَهر",181,"ر",1,0],["وكم قد علموا أخلاق سوء","فشت في الأبعدين والأقربينا",182,"ن",2,0],["وكم قد روعوا من غير جرم","أناسا صالحين وعابدينا",182,"ن",2,0],["وكم قلبٍ إذا ناداه حقٌّ","إليه هفا، وزادَ به حُفُولا",183,"ل",2,0],["وكم قبلك الأيامُ قد غدرت بنا","ولم تزل الأيام شيمتُها الغدرُ",184,"ر",1,0],["وكَمْ قَطَعْتُ الظلام سُهْداً","حتّى جفا جَفنيَ المنامُ",185,"م",1,0],["وكم قَتلُوا مِن آل أحمد سيّداً","إماماً زَكتْ أعراقُهُ ومَناقبُهْ",186,"ب",2,0],["وكم قد ثقّفَ مِنكَ الرَّزايا","وأَحْكمتِ اللّيالي مِن صقالِكْ",187,"ك",1,0],["وكم قد رحلت العيش في طلب العلى","فلما بكت سعدي حططت بها رحلي",188,"ي",1,0],["وكم قد رأينا بالمحاق أهلة","تجلت بلا طَبٍّ هناك ولا آس",189,"س",1,0],["وكم قص فيه اللّه من خبر الأُلَى","عصوه فأبقاهم قليلاً ودمروا",190,"ر",3,0],["وكمْ قد قرانِيَ لفظاً وسيماً","عَلَيهِ من الطبَّعِ حُسْنٌ وسيما",191,"م",2,0],["وَكَم قائِلٍ سَجَنوهُ عَلى","تطلُّبِهِ الملك مِن لَهفِهِ",192,"ف",2,0],["وَكَم قائِل لي كَيف مدحك هَكَذا","فَقُلتُ صِفوه إِنَّ لِلحَقِّ مُقنِعا",193,"ع",2,0],["وَكَم قطعت بِحاراً لَيسَ يَقطعها النَي","رانِ وَلا العالي مِنَ السُحُبِ",194,"ب",1,0],["وكم قدر ما تبقي الدّموع إذا جرت","على كل ربع أو على كل منزل",195,"ل",1,0],["وكم قائل لي هَلْ وجدت نظيرهم","فقلتُ له أين الثريَّا من الثرى",196,"ر",2,0],["وكم قد أعْجَزَ الأَغيار ردًّا","بأجوبةٍ لعمرك لا تردّ",197,"د",1,0],["وكم قد زارني رشأ غرير","فأرشفني على ظمأٍ زلالا",198,"ل",2,0],["وكم قالَ للصَّهْبَاءِ إِنِّيَ حالِفٌ","فقالَتْ له الصهباءُ إِنَّكَ حانِثُ",199,"ث",1,0],["وكم قلت للساعي إلى المجد والعلا","تزحزح قصيّا فالمعمّر نائله",200,"ل",2,0],["وكم قَدْ دَعَوْنا قريبَ الدِّيارِ","وأَنتُمْ عَلَى البُعْدِ لَبَّيْتُمونا",201,"ن",2,0],["وكم قُدْتَ للأَعداءِ من حُزْنِ ليلةٍ","ضُحاها لمن والاكَ غُنْمٌ وأفراحُ",202,"ح",1,0],["وكم قَدْ رَدَدْنَ حياةَ نُفوسٍ","ظِماءٍ بِمَوْتِ نفوسٍ ظِماءِ",203,"ا",2,0],["وكم قَدْ كَسَوْتَ ثيابَ الحِدادِ","بلاداً لبسْتَ إِلَيْها الحديدا",204,"د",2,0],["وكم قَوَّدْتَها يحيى فَحَفَّتْ","نجومُ الليلِ بالبدرِ التَّمَامِ",205,"م",1,0],["وكَمْ قَدْ فَدى أَدنى النُّفُوسِ مِنَ القَنا","بِنَفْسٍ نُفُوسُ العالَمِينَ فِدىً لَهَا",206,"ل",3,0],["وكمْ قاطِعٍ بالنَّوْمِ لَيْلاً وَصَلْتَهُ","بِغَزْوِكَ مَا بَيْنَ الأَصِيلِ إِلَى الفَجْرِ",207,"ر",1,0],["وكم قد هفا الدهرُ من قبلها","وعاد وأقلعَ عما اجترمْ",208,"م",1,0],["وكم قام بيني وبين الحظوظِ","وقد بلغتني فقال ارجعي",209,"ع",2,0],["وكم قمتَ دون الملك كاشفَ كربةٍ","تيقَّظ منها الخطبُ والملكُ هاجعُ",210,"ع",1,0],["وكم قد شكوتُ الدهرَ لو كان مُشْكِياً","وعاتبتُ جَورَ الحظّ لو نفع العتبُ",211,"ب",1,0],["وكم قوْلٍ تَعاورهُ رجالٌ","ليُدْرَك سِرُّ معناهُ الشَّريدِ",212,"د",1,0],["وكمْ قدْرٍ يزيدُ مع انْحطاطٍ","مُسِفُّ السُّحْب أصدقُهنَّ خالا",213,"ل",2,0],["وكم قطعوا الفيافي فوق نجب","لها خبب المسير أو القطوف",214,"ف",1,0],["وكم قتلتْ محلاً سهامُ قطارها","وشامتْ بروق الدْجن أبيضَ مخدما",215,"م",2,0],["وَكَم قَد عَدَلنا إِلى ظِلِّهِ","لِيَحظى بِلَهوٍ حَميدِ الأَثَر",216,"ر",1,0],["وكم قرعت له الظنبوب في غلس","غثر خطاه ولا أشكو من اللغب",217,"ب",1,0],["وكم قد جردت سيفا","على المسكين صمصاما",218,"م",2,0],["وكم قد تولهنا وذبنا صبابة","على إثرها يوم المعارك بغيتي",219,"ي",1,0],["وكم قفصت أرواحنا إذ تغربت","عن الوطن الأسنى بمربع وحشتي",220,"ت",2,0],["وكم قد غزتنا الصافنات بمهمه","على غفلة وكم رزينا بنكبة",220,"ه",1,0],["وكم قد علتنا فاعلات فواعل","لترتاض منا النفس في كسر سورتي",220,"ت",2,0],["وكم قد أتى من أذهل الدهر ضرّه","فصار معافى بالهاء مبلل",221,"ل",1,0],["وكم قُلوبٍ طمتْ فيها الكُدورَةُ مذْ","أمَّتْهُ أَمَّ بها للهِ إِصفاءُ",222,"ا",2,0],["وكم قبلَهُم صبّحْتَ قوماً بغارةٍ","فلم يحتَموا منها ببَرٍّ ولا بَحْرِ",223,"ر",1,0],["وكم قد بت في مدحي علاهم","أفر من الرقاد إلى السهاد",224,"د",1,0],["وكم قدرة يا آل رزيك منكم","تعبر بالإحسان عن شرف القدر",225,"ر",1,0],["وكم قد أعارتني الوجوه التفاتها","وأنست بسر الأنس من كل نافر",226,"ر",1,0],["وكم قصدت بابي نفوس قصيرة","فطولت مرمى خطوها المتقاصر",226,"ر",1,0],["وكم قمت في بأس وجود ورتبة","بما سره في الخطب والدست والثغر",227,"ر",1,0],["وكَمْ قائِلٍ قَدْ صِرْتُمُ مِثْلَ آلةٍ","يُقَلِّبُها في كِفَّةِ الدَّهْرِ أبْكَمُ",228,"م",1,0],["وكَمْ قَدْ أَطالُوا الْقَوْلَ في ذا وإنَّهُ","حَقِيقٌ بأنَّ الْقَوْلَ فيهِ يُعَظَّمُ",228,"م",1,0],["وكَمْ قَدْ جئْتُ ذاكَ الْبَا","بَ أَرْجُو فَتْح مِصْراعِ",229,"ع",1,0],["وكم قد أرهَقوني في امتحانٍ","وما وجَدوا لإخفاقي سَبيلا",230,"ل",2,0],["وكم قلتُ للنّفسِ العَزوفِ لَدى الوغى","رِدِي مَكْرَعاً من قبل أنْ تَرِدِيهِ",231,"ي",2,0],["وكم قلّبوا في العبادِ العيونَ","فلم يُبصروا غيرَ ما أفضَلوا",232,"ل",3,0],["وكم قلّبتْ كفّاي من ذي مودّةٍ","فَلم يَلقَنِي إلّا الملومُ المقرَّعُ",233,"ع",1,0],["وكم قعد القومُ بعد القيامِ","ومذ قام بالفضلِ لم يقعدِ",234,"د",1,0],["وكم قد شهدناه يومَ الوغى","وبيضُ النّصولِ بلا أغْمُدِ",234,"د",1,0],["وكم قُطبٍ وصدِّيقٍ","ومن يفهم ولا يفهمْ",235,"م",1,0],["وكم قائلٍ في الناس ليسَ بفاعلٍ","وكم فاعلٍ في الناس ليسَ يقولُ",236,"ل",1,0],["وكم قلتُ لمَّا أَن رَمَت مقلةٌ له","أَلا إِنَّها بالسِّحر بابٌ مُجَرَّبُ",237,"ب",1,0],["وكَمْ قلعةٍ فوقَ السماءِ أَساسُها","وعامِرُها من أَسلافِ عاد وجُرْهُم",238,"م",1,0],["وكَمْ قائلٍ من يملكُ الدَّهرَ قادراً","عليه فقلْتُ المالكانِ له هُمَا",239,"م",2,0],["وكم قالَ بدرُ التَّم ما أَنَا نيِّرٌ","لَديه وظبيُ الرَّمْلِ ما أَنا أَلْعسُ",240,"س",1,0],["وكَمْ قَدْنَهاه هبوبُ الرِّياح","فظَلَّ بتجعيده يَسْتُر",241,"ر",1,0],["وكم قَد كسا عِطْفيَّ ثوبُ عناقِه","فمزَّق عن خدَّيَّ ثوبَ شُحوبِه",242,"ب",2,0],["وَكَمْ قَدْ نَضَا سَيْفاً بِكَفٍّ كَرِيمَةٍ","فَأَحْسَنَ وَضْعَ السَّيْفِ في مَوْضِع النَّدَى",243,"د",2,0]]}