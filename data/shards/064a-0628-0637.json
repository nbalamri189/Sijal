{"poems":[[53,"لي خادم لا أزال أحتسبه","https://www.aldiwan.net/poem8303.html","المنسرح"],[31,"يا مي هلا يجازي بعض ودكم","https://www.aldiwan.net/poem6157.html","البسيط"],[564,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119914","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108802","الطويل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199636","المسحوب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205002","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92142","الخفيف"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[4869,"ظلم خلق الله","https://www.poetsgate.com/ViewPoem.aspx?id=151717",""],[5652,"شاعر ولي بالشعر وقفه وجمهور ؟","https://www.poetsgate.com/ViewPoem.aspx?id=175169",""]],"verses":[["يبطىءُ حتى أكاد أحسبه","صادف تيساً فظلّ يحتلبُهْ",0,"ب",2,0],["يُبطِرنَ ذا الشَيبِ وَالإِسلامِ هَمَّتَهُ","وَيَستَقيدُ لَهُنَّ الأَهيَفُ الرَوِقُ",1,"ق",1,0],["يُبطِّئنا عند الصُّعودِ لأنَّه","يودُّ لوَانَّا للصَّعيدِ قد أخْلَدْنا",2,"ن",2,0],["يبطا النوال لديه معتذرا","ويحب يأكل مدحه بطي",3,"ط",2,0],["يبطِّل عذل السيف سيفك عاشقٌ","وفي أذن العشاق لا يلج العذل",4,"ل",1,0],["يبطي مسوّي في غواربهم امهور","من فعل زينات العيون الفنيجه",5,"ج",2,0],["يبطئ الخطو في المسير ولكن","يسرع الخطو للردى تعجيلا",6,"ل",2,0],["يَبطُلُ الدورُ والتسلسلُ إلا","في ارتشاف الرحيق من كفِّ أغيدْ",7,"د",1,1],["يبطلُ بُطلا وبطولا وبطل","من شغله زيد وقد خلى العمل",8,"ل",1,0],["يبطي عذولي ولآهو شآمت وفآرح","ببقى انا والغضي رجآل مع ظلّه",9,"ل",2,0],["يبطي يهين الشمري علم مسبور","لو شبوآ الغِيبات نار وحريقه",10,"ق",2,0]]}