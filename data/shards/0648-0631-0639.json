,"الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30500","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55119","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54719","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55101","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55142","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54730","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54254","البسيط"],[106,"أسطول معاوية","https://www.poetsgate.com/ViewPoem.aspx?id=179631",""],[90,"إليها !","https://www.poetsgate.com/ViewPoem.aspx?id=179205",""],[51,"عاصيتُ كلَّ هوى مُطاعِ","https://www.poetsgate.com/ViewPoem.aspx?id=29479",""],[115,"المها","https://www.aldiwan.net/poem24062.html","الرمل"],[122,"بين الأَنين وغصة الذكرى","https://www.aldiwan.net/poem23714.html","الكامل"],[130,"رقاب العقل إن لنا ولوعا","https://www.aldiwan.net/poem54805.html","الوافر"],[141,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[141,"هل غير ظلك للعفاة مقيل","https://www.aldiwan.net/poem11791.html","الكامل"],[141,"دعوا القول فيمن جاد منا ومن ضنا","https://www.aldiwan.net/poem11826.html","الطويل"],[141,"أما الزمان ففي يديك عنانه","https://www.aldiwan.net/poem11830.html","الكامل"],[167,"ألقت إليك مقادها الأيام","https://www.aldiwan.net/poem1678.html",""],[193,"ورعيت من دار وإن لم تنطقي","https://www.aldiwan.net/poem54364.html","الكامل"],[193,"لمن الدار كعنوان الكتاب","https://www.aldiwan.net/poem54425.html","الرمل"],[219,"بينما الجو بديع رائق","https://www.aldiwan.net/poem55264.html","الرمل"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[233,"حتام أرضى في هواك وتغضب","https://www.aldiwan.net/poem32181.html","الكامل"],[257,"فؤاد على غصن الصبابة ساجع","https://www.aldiwan.net/poem35548.html","الطويل"],[259,"ما راعني الليل ولا السبسب","https://www.aldiwan.net/poem38366.html","السريع"],[295,"أليلة الحشر لا بل يوم عاشور","https://www.aldiwan.net/poem33262.html","البسيط"],[303,"صبحا بدا من رأي خير الدين","https://www.aldiwan.net/poem56390.html","الكامل"],[303,"تونس الأنس بلدة ميمونه","https://www.aldiwan.net/poem56392.html","الخفيف"],[303,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[346,"ورعيت هذا الجيش منك بناظر","https://www.aldiwan.net/poem20670.html","الكامل"],[355,"يا خيل محيي ملة الإسلام","https://www.aldiwan.net/poem4147.html","الكامل"],[362,"بكر العواذل أن رأين خصاصتي","https://www.aldiwan.net/poem60953.html","الكامل"],[362,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[369,"لمن العيس أصبحت مستقله","https://www.aldiwan.net/poem57189.html","الخفيف"],[374,"أمانا لقلب طال فيه اعتناؤه","https://www.aldiwan.net/poem66968.html","الطويل"],[413,"لمن أينق يا سعد ترقل أو تخدي","https://www.aldiwan.net/poem53991.html","الطويل"],[426,"سعد العلياء جلا ثغرا","https://www.aldiwan.net/poem40840.html","المتدارك"],[434,"سفها بكيت بدمع عين هام","https://www.aldiwan.net/poem2585.html","الكامل"],[436,"منن بأيسر شكرها أعييتني","https://www.aldiwan.net/poem34915.html","الكامل"],[441,"قف بالديار وحيها","https://www.aldiwan.net/poem56021.html","عموديه"],[446,"لم توف أشواقي ولا لوعاتي","https://www.aldiwan.net/poem53723.html","الكامل"],[446,"يا مغانى الوصل من سفح الغوير","https://www.aldiwan.net/poem53766.html","الرمل"],[450,"مولاي صدر الموالي","https://www.aldiwan.net/poem13875.html","المجتث"],[450,"أحبابنا عودوا علينا عودة","https://www.aldiwan.net/poem13932.html","الكامل"],[456,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[456,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[456,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[456,"ما على منجد رأى ما أهمه","https://www.aldiwan.net/poem55903.html","الخفيف"],[456,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[456,"سقى زمنا ببابل عقربي","https://www.aldiwan.net/poem56146.html","الوافر"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[513,"لك الحسب الباقي على عقب الدهر","https://www.aldiwan.net/poem12142.html","الطويل"],[513,"ثغر الهدى متبلج بسام","https://www.aldiwan.net/poem12245.html","الكامل"],[549,"إن العقيق يزيدني خبلا","https://www.aldiwan.net/poem47321.html","أحذ الكامل"],[549,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[573,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"]],"verses":[["وَرَعَتكَ عَينُ اللَهِ مِق","لاقَ الرَكائِبِ أَومُقيما",0,"م",2,0],["وَرَعاهُ مَن أَرعى البَرِيَةَ سَيبَهُ","وَسَقاهُ مَن أَسقى بِهِ الآمالا",1,"ل",2,0],["وَرَعى كُلَّ ناشِقٍ لَكَ دَلَّت","هُ صَباً طَلَّةٌ عَلى رَيّاكا",2,"ك",2,0],["وَرَعيِها بَينَ القَنا العَرّاصِ","مِن آمِنِ القُلّامِ وَالقُرّاصِ",3,"ص",1,0],["وَرَعَيتَ الإِيابَ غَضاً جَديداً","وَتَبَدَّلتَ مُطمَحاً بِالقِيادِ",4,"د",1,0],["ورُعْتُ بهِ مَنْ لَوْ تأمّلَ صارِمي","رأى المَوْتَ يَرْنو نَحوَهُ منْ شَباتِهِ",5,"ت",2,0],["ورَعَيْنَ حالَيَةَ الرّبيعِ ودونَها","جارٌ بِما تَعِدُ الظّنونُ كَفيلُ",6,"ل",1,0],["ورعى الأغنام بالعدل إلى","أن رعى في مرتع الحق الأناما",7,"م",2,0],["ورَعَوا لهُ بعْدَ الوَفاةِ حُقوقَهُ","فمَرتْ سُيوفِ اللهِ كلَّ مَمارِ",8,"ر",1,0],["وَرَعَيْتَهُ بَعْدَ الْمَمَاتِ كَأَنَّهُ","رَهْنُ الْحَيَاةِ يَرَاكَ خَلْفَ حِجَابِ",9,"ب",1,0],["ورَعَى الحُرَّ المُفَدى","وَرَعَى البِرَّ الوَفِيَّا",10,"ي",2,0],["وَرَعَى حَقِيقَةَ نَفْسِهِ وَأَجَلِّهَا","عَنْ أَنْ تُبَدَّلَ عِزَّةً بِهَوَانِ",11,"ن",1,0],["وَرَعَتْهُ فَحَل مِنْ ذُرْوَةِ العَلْيَاءِ","فِي ذلِكَ المَحَلِّ الأمِينِ",12,"ن",1,0],["وَرَعنٍ يَقُدُّ الآلَ قَدّاً بِخَطمِهِ","إِذا غَرِقَت فيهِ القِفافُ الخَواشِعُ",13,"ع",1,0],["ورعيتَه بسياسةٍ دارتْ على","مُخْتَطِّهِ دورَ السوار بمعصم",14,"م",1,0],["وَرَّعتُ رَكبي بِالدَفينَةِ بَعدَما","ناقَلنَ مِن وَسَطِ الكُراعِ نَقيلا",15,"ل",2,0],["ورعى المقامَ الأفضليَّ بمدحه","فضلٌ يشرِّق ذكره ويغرِّب",16,"ب",1,0],["ورعاكَ الله فينَا ملكاً","ملكَ الأنفس ملكاً لا يخابا",17,"ب",2,0],["ورعيتُ ما يرعى ومِلتُ إلى الذي","وردَتْهُ همَّتُهُ فكنتُ شَريبَهُ",18,"ب",2,0],["ورعاعٌ تغلَّبوا بزمانٍ","أنا فيه وفيهُم ذو اغترابِ",19,"ب",1,0],["ورعوا أنجم الدجى","طالعاً بعد طالع",20,"ع",1,0],["ورعيتُ حقَّ مودتي","إذ لم أجدك لها بِراع",21,"ع",1,0],["ورعايا حميتها بعد أن شا","رك في حفظها الرعاء السباعا",22,"ع",2,0],["ورعاً أن تقارف البخل كفا","ك وهيهات أن تُلاقى فروقا",23,"ق",2,0],["ورعَى اللَّه مَنْ رَعَيْتَ من النا","س ولم يَرْعَ من رآه طريدَك",24,"ك",1,0],["ورعيتَ العلا على كل حيٍّ","رعْيَ لا مُغفلٍ ولا متواني",25,"ن",2,0],["ورعاهُ معروفٌ يُخامِرُ نَفسَهُ","ويفيضُ عنها والنفوسُ لواهي",26,"ه",2,0],["وَرَعى المُهَيمَنُ ساكِنيهِ فَإِنَّهُم","في خَيرِ أَرضٍ خَيرَةِ السُكّانِ",27,"ن",1,0],["وَرَعَيتُ فيكَ النَجمَ يا","مَن كانَ يَحفَظُني وَيَرعى",28,"ع",2,0],["ورعية لك في الممالك بَرّة","غمرتهمومن بيتك الآلاء",29,"ا",2,0],["ورعاهم لك واسترعاهم","بك مأمونا على العهد أمين",30,"ن",1,0],["وَرِعايَةِ طِفلٍ أَو هَرِمِ","وَالذَودُ عَنِ الغيدِ الحُصُنِ",31,"ن",1,0],["وَرَعاني رَعى الإِلَهُ لَهُ الفارو","قَ طِفلاً وَيَومَ مَرجُوِّ شانِه",32,"ن",2,0],["وَرُعْنَ بِنَا قَلْبَ الفُراتِ كأنّمَا","تَخِرُّ عَلَيْهِ بالرّجالِ سُيُولُ",33,"ل",1,0],["وَرَعَيتَنا فَأَرَيتَنا","سُنَنَ الرَشادِ بِحُسنِ قَصدِك",34,"ك",1,0],["وَرَعِيَّةٍ أَحسَنتَ رَعيَ سَوامِها","حَتّى غَدَت وَالعَدلُ فيها مُهمَلُ",35,"ل",1,0],["وَرَعى اللَهُ مَن رَعى","حَقَّ عَهدي وَصُحبَتي",36,"ت",2,0],["وَرَعَيتُ أَنجُمَهُ فَأَكسَبتُ السُها","سُقمي وَأَكسَبَ جَفنِيَ التَسهيدا",37,"د",2,0],["ورعانا بجاههم وحمانا","بحماهُمْ وبدَّل الخوفَ أمنا",38,"ن",2,0],["وَرَعْيَاً ليومِكَ يومِ \"الطُّفوف\"","وسَقْيَاً لأرضِكَ مِن مَصْرَعِ",39,"ع",1,0],["وَرَعى الأَمانَةَ في المَغيبِ وَلَم يَخُن","غيبَ الصَديقِ وَذاكَ فِعلُ المُسلِمِ",40,"م",1,0],["وَرَعوا ذِمامَ بِلادِهِم بِوَصِيَّةٍ","نَكَصَ الغَوِيُّ لَها عَلى الأَعقابِ",41,"ب",1,0],["وَرَعاكم رَعْيَ الحفيِّ يُؤّدي","حقَّ أضيافهِ وَفِيّاً أمينا",42,"ن",2,0],["وَرُعْتَ به أَدِيمَ الأرضِ لمّا","جَعلتَ عليه من دَمِه خِضابا",43,"ب",2,0],["وَرَعى حقَّكِ لا يبغِي سوى","أن تكوني بالمحلِّ الأليق",44,"ق",1,0],["وَرَعَت جُنوبَ السِدرِ حَولاً كامِلاً","وَالحَزنُ فَهيَ يَزِلُّ عَنها الكورُ",45,"ر",1,0],["وَرَعَت بُطونَ بِلادِهِ","لِقَحٌ مِنَ البَرَكاتِ",46,"ت",1,0],["ورَعِيَّةٌ هُدّابُ عَدلِكَ فوقَها","سِتْرٌ على مُهَجاتِها مسدول",47,"ل",1,0],["وَرعدٌ يصمُّ الأذْنَ صوتُ دويِّهِ","وَبرقُ سحابٍ بالتتابعِ يلمع",48,"ع",1,0],["ورعتني في ظلمة الليل حتى","تركت نومها لأجل منامي",49,"م",2,0],["ورَعَيْتُ مِن وَجْهِ السَّمَاءِ خَمِيلةً","خَضْرَاءَ لاحَ البَدْرُ مِن غُدْرانِهَا",50,"ن",3,0],["وَرَعَّادٌ تَطِيرُ لَهُ","نُفُوسُ الْوَحْشِ مِنْ ذَهَلِ",51,"ل",1,0],["وَرَعَى الأُولَى خَلَفُوا الْعِمَا","دَ السَّابِقِينَ مِنَ الْعِمَادْ",52,"د",1,0],["وَرَعَى الأُولَى قَدَرُوا الجَمَالَ فَبَرَّزُوا","بِفُنُونِهِمْ مِنْ صَامِتٍ أَوْ نَاطِقِ",53,"ق",1,0],["وَرَعَى رِيَاضَاتٍ تُنَشِّيءُ فِتْيَةً","سُمَحَاءَ أَخْلاَقٍ حُمَاةَ حَقائِقِ",53,"ق",1,0],["وَرَعَتْكَ عَيْنٌ لِلْعِنَا","يَاتِ الْعُلَى فِي مُسْتَقَرِّكْ",54,"ك",1,0],["وَرَعَاهُ اللّهُ الكَريمُ وَأَوْلا","هُ إِذَا مَا اسْتَعَانَهُ كُلَّ نَصْرِ",55,"ر",1,0],["وَرَعَتْهُ حَاكِماً حَتَّى إِذا","شَجَرَتْ بَيْنَهُمَا الْعِلاَّتُ شجْرَا",56,"ر",2,0],["وَرَعْتِنَا يَا وَقَارُ فِيمَا","لَطُفَتْ مِنْ فِتْنَةِ الدَّلاَلِ",57,"ل",1,0],["وَرَعَى مَعَاهِدَ الاقْتِصَادِ فَأَزهَرَتْ","وَقَضَتْ مُنىً بِعَدِيدِها الْمُتَعَدِّدِ",58,"د",1,0],["ورَعَى اللّهَ في الرّعِيّةِ والملكِ","فوفَّى حقَّ الإِلهِ وأَدَّى",59,"د",2,0],["ورُعْتَ كلَّ فتاةِ في قِلادتِها","بِدُرِّ لفظِكَ منثُوراً ومُنتظِما",60,"م",2,0],["وَرَعَى البحارَ، ومَن يقيم بهنَّ من","أمَمٍ رعاةُ النُّوق والأغنام",61,"م",1,0],["ورعشةَ أهدابِك المثقلاتِ","على فرْط ما حُمِّلَت تَحْلِف",62,"ف",1,0],["ورعيتُ حقَّ مودتي","إذا لم أجدك لها براعِ",63,"ع",1,0],["ورَعى اللهُ غَزالًا نافِرًا","طَرْفُهُ يَكْتُبُ آدابًا وفَنّْ",64,"ن",1,0],["ورعيت حرمة شاعر دنف","يشكو إليك العوز والفقرا",65,"ر",2,0],["ورُعنَا كُلَّ مَن يَهوَى ورُغنَا","وأَبدَينَا التَّصَوُّفَ والخُشُوعَا",66,"ع",2,0],["وَرَعَيتَ حَقَّ القاصِدينَ وَما رَعَوا","وَوَعَيتَ قَولَ المادِحينَ وَلَم يَعوا",67,"ع",3,0],["وَرَعِيَّةٍ أَغنَيتَها وَحَمَيتَها","فَدُعاؤُها بِثَنائِها مَوصولُ",68,"ل",1,0],["وَرُعنا بِكَ الأَحداثَ حَتّى كَأَنَّما","حَطَطنا عَلى الأَحداثِ مِن يَذبُلٍ رُكنا",69,"ن",2,0],["وَرَعِيَّةٍ أَنسَيتَها مُذ حُطتَها","زَمَناً تَشيبُ لِهَولِهِ وَلِدانُهُ",70,"ن",2,0],["وَرَعاكَ مَن لَو كُنتَ راعِيَ خَلقِهِ","لَم يُرعَ إِلّا لِلحَنيفِ ذِمامُ",71,"م",1,0],["وَرُعيتِ مِن دارٍ وَإِن لَم تَنطُقي","بِجوابِ حاجَتِنا وضإِن لَم تَعقِلي",72,"ي",1,1],["وَرَعابيبٌ حِسانٌ كَالدُمى","لا يُنِلنَ الشَيبَ لِذاتِ الشَبابِ",73,"ب",1,0],["ورعود ذهل الناس بها","عن حطام جمعوه وعيال",74,"ل",1,0],["وَرِعٌ كَثيرٌ صَمتُهُ ذو فِكرَةٍ","مَرضِيَّةٍ مُتَواصِلُ الأَحزانِ",75,"ن",1,0],["وَرُعِ العِدى مِنها بِأَدهَمَ رائِعٍ","يَعنو لِغُرَّتِهِ الصَباحُ الأَشهَبُ",76,"ب",1,0],["ورعيا لأوقاتٍ مضت في ظلاله","بها ظبيُ أُنسي بالمسرّة راتع",77,"ع",1,0],["ورعت إجلالا قلوب العدى","فكل قلب منهم قلب",78,"ب",1,0],["وَرُعتمُ بالرَدى قَلبَ ابنِ فاطمة","وَما رَعيتم ذِماماً جدَّ مَخفورِ",79,"ر",1,0],["وَرَعى ذمامَ المعلواتِ وصانهُ","وَأبانَ وجهَ النصحِ غير مصونِ",80,"ن",1,0],["وَرَعاهُ بِصادقِ الوعدِ ملكاً","وَالوزير الّذي اِصطفاه خدينه",81,"ن",2,0],["وَرعى بسدٍّ للذرائِع منعةً","لحِمى الشرائِع عن ذوي اِستهوانِ",82,"ن",1,0],["وَرَعَيْتَ هذا الجيشَ مِنكَ بِناظِرٍ","مَا كادَ يُهْمَلُ رَعْيُهُ بِمَنامِ",83,"م",1,1],["وَرَعَيتَ ما استَرعَوكَ مُجتَهِداً وَلَم","تَأخُذكَ فيهِ مَلامَةُ اللَّوامِ",84,"م",1,0],["ورَعاك مَنْ أَعْلَى مَحلَّك فاعتلَى","فوق النجومِ برغْمِ كلِّ حَسود",85,"د",1,0],["ورِعُ النّفسِ ما رأى اللهُ حُوباً","قطّ منه يدورُ في حَوباء",86,"ا",2,0],["وَرِعاتٌ عَن الخِيانَةِ إِلا","نَظَراتٍ رأَينَها مُستَحَلَّه",87,"ل",2,0],["ورعياً لمرءٍ ظن دنياه إنَّها","منكَّرَةٌ والنقصُ فيها جزاؤه",88,"ا",3,0],["ورَعياً لأيَّام مضتْ في عِراصِها","تُؤَلِّفُ بين الظبْي والأسَدِ الوَرْدِ",89,"د",1,0],["ورعاه بعين الأمن وقد","جعل الأدهار له عمرا",90,"ر",2,0],["ورعيت هذا الملك منك بمقلةٍ","لم تكتحل أجفانها بمنام",91,"م",1,0],["ورَعى لَكَ الرحمن مَا اسْتَرْعاكَهُ","من دِينِهِ أَجْراً بما راعيتَني",92,"ن",2,0],["ورعى الإله منازلا","وحمى جواسقك الفخيمه",93,"م",2,0],["ورعى الإله على المصلى جيرة","ما زلت أرعاهم على العلات",94,"ت",1,0],["ورعى أيامك البيض وان","ذهبت مني بالعيش النضير",95,"ر",1,0],["ورعته بانتقاصٍ","وذاك عين الكمال",96,"ل",1,0],["ورعيتها هَمَلاً وما بالعهد مِن","قِدَمٍ وجُدتَ ولستَ بالخَوّان",97,"ن",1,0],["ورعَى لي في دوحةِ المجد غصنا","كيفما هُزَّ هُزَّ أخضَرَ لَدْنا",98,"ن",2,0],["ورعَى الدولةَ من تدبيره","يقِظ العين إذا الذائدُ ناما",99,"م",2,0],["ورُعتَ كما آمنتَ بالعدل فاشتفى","بريءٌ وأعيا أن يُبِلَّ سقيمُ",100,"م",1,0],["ورعى الفضلَ مبرِمُ العهد لم تُخ","فَرْ لديه ولم تُرَعْ قطُّ ذِمَّهْ",101,"م",2,0],["ورعَى النارَ غداً جس","مٌ رعَى أمسِ حماكِ",102,"ك",1,0],["ورعتُ بك النوائب وهي فوقي","وتحتي بين حائمةٍ ورُبْضِ",103,"ض",1,0],["ورعَى الندامةَ حيث لم يشبع بها","غاوٍ رماك وآخرون أشاروا",104,"ر",3,0],["ورعت بأطراف اليراعين قلب من","تفرخ في أيامه بيضة الغدر",105,"ر",1,0],["ورعيت حق المسلمين رعاية","صلوا بها لك لو أردت وصاموا",106,"م",3,0],["ورَعتْ فِجاجاً لا تُصيب بها ال","حَوْذانَ مكتهلاً ولا النَّفَلا",107,"ل",2,0],["ورعٌ نبا عنهُ الرّجال وعفّةٌ","لم يَستطعها النّاسك المتجنِّبُ",108,"ب",1,0],["وَرِعٌ إِنْ تَقُل لَه النَّفْس خُذْ ه","ذَا وحَاشاه منه قَالَ لَها ذَرْ",109,"ر",1,0]]}