277,"بيني وبينها","https://www.poetsgate.com/ViewPoem.aspx?id=186896",""],[5282,"قلوب من نور","https://www.poetsgate.com/ViewPoem.aspx?id=214082",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5410,"بلا ميعاد","https://www.poetsgate.com/ViewPoem.aspx?id=139640",""],[5431,"جدوى الحياة....","https://www.poetsgate.com/ViewPoem.aspx?id=205102",""],[5431,"أحجية...","https://www.poetsgate.com/ViewPoem.aspx?id=213354",""],[5596,"طبع الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=205611",""],[5596,"إلى ابن مكتوم","https://www.poetsgate.com/ViewPoem.aspx?id=206174",""],[402,"عادوا وقوفا حول قبرك","https://www.poetsgate.com/ViewPoem.aspx?id=36028",""],[402,"حي الجماعة جاوزت","https://www.poetsgate.com/ViewPoem.aspx?id=35455",""],[5897,"وللأنس مجلس !","https://www.poetsgate.com/ViewPoem.aspx?id=157551",""],[5897,"من وحي ال21","https://www.poetsgate.com/ViewPoem.aspx?id=158793",""],[5906,"ماذا بعد","https://www.poetsgate.com/ViewPoem.aspx?id=188226",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[5956,"صور إيمانية","https://www.poetsgate.com/ViewPoem.aspx?id=192502",""],[5956,"تجديد الانتماء","https://www.poetsgate.com/ViewPoem.aspx?id=193912",""],[6052,"الشيخ نعمة","https://www.poetsgate.com/ViewPoem.aspx?id=34890",""],[6052,"ميراث الفضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=35378",""],[6052,"همس الذكربات","https://www.poetsgate.com/ViewPoem.aspx?id=49636",""],[6052,"قبة الامام علي الهادي","https://www.poetsgate.com/ViewPoem.aspx?id=53825",""],[4442,"أنت والسجن صارم وقراب","https://www.poetsgate.com/ViewPoem.aspx?id=171198",""],[6102,"مِزَعُ الشَّرِّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=185056",""],[6229,"الوطن المفدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65170&r=&rc=4",""],[463,"علَّمتها الأيامُ أن تتجنَّى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60232&r=&rc=288",""],[463,"على مثلها كان العلاءُ يحومُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60303&r=&rc=359",""],[5555,"فِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""],[402,"ذلك الشعب الذي آتاه نصرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=53563&r=&rc=415",""],[4222,"قد أضاء الزمان بالمستضيء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52712&r=&rc=4",""],[6352,"هي دار غيبته فحي قبابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22743&r=&rc=4",""]],"verses":[["وَرَعَتكَ عَينُ اللَهِ مِق","لاقَ الرَكائِبِ أَومُقيما",0,"م",2,0],["وَرَعاهُ مَن أَرعى البَرِيَةَ سَيبَهُ","وَسَقاهُ مَن أَسقى بِهِ الآمالا",1,"ل",2,0],["وَرَعى كُلَّ ناشِقٍ لَكَ دَلَّت","هُ صَباً طَلَّةٌ عَلى رَيّاكا",2,"ك",2,0],["وَرَعيِها بَينَ القَنا العَرّاصِ","مِن آمِنِ القُلّامِ وَالقُرّاصِ",3,"ص",1,0],["وَرَعَيتَ الإِيابَ غَضاً جَديداً","وَتَبَدَّلتَ مُطمَحاً بِالقِيادِ",4,"د",1,0],["ورُعْتُ بهِ مَنْ لَوْ تأمّلَ صارِمي","رأى المَوْتَ يَرْنو نَحوَهُ منْ شَباتِهِ",5,"ت",2,0],["ورَعَيْنَ حالَيَةَ الرّبيعِ ودونَها","جارٌ بِما تَعِدُ الظّنونُ كَفيلُ",6,"ل",1,0],["ورعى الأغنام بالعدل إلى","أن رعى في مرتع الحق الأناما",7,"م",2,0],["ورَعَوا لهُ بعْدَ الوَفاةِ حُقوقَهُ","فمَرتْ سُيوفِ اللهِ كلَّ مَمارِ",8,"ر",1,0],["وَرَعَيْتَهُ بَعْدَ الْمَمَاتِ كَأَنَّهُ","رَهْنُ الْحَيَاةِ يَرَاكَ خَلْفَ حِجَابِ",9,"ب",1,0],["ورَعَى الحُرَّ المُفَدى","وَرَعَى البِرَّ الوَفِيَّا",10,"ي",2,0],["وَرَعَى حَقِيقَةَ نَفْسِهِ وَأَجَلِّهَا","عَنْ أَنْ تُبَدَّلَ عِزَّةً بِهَوَانِ",11,"ن",1,0],["وَرَعَتْهُ فَحَل مِنْ ذُرْوَةِ العَلْيَاءِ","فِي ذلِكَ المَحَلِّ الأمِينِ",12,"ن",1,0],["وَرَعنٍ يَقُدُّ الآلَ قَدّاً بِخَطمِهِ","إِذا غَرِقَت فيهِ القِفافُ الخَواشِعُ",13,"ع",1,0],["ورعيتَه بسياسةٍ دارتْ على","مُخْتَطِّهِ دورَ السوار بمعصم",14,"م",1,0],["وَرَّعتُ رَكبي بِالدَفينَةِ بَعدَما","ناقَلنَ مِن وَسَطِ الكُراعِ نَقيلا",15,"ل",2,0],["ورعى المقامَ الأفضليَّ بمدحه","فضلٌ يشرِّق ذكره ويغرِّب",16,"ب",1,0],["ورعاكَ الله فينَا ملكاً","ملكَ الأنفس ملكاً لا يخابا",17,"ب",2,0],["ورعيتُ ما يرعى ومِلتُ إلى الذي","وردَتْهُ همَّتُهُ فكنتُ شَريبَهُ",18,"ب",2,0],["ورعاعٌ تغلَّبوا بزمانٍ","أنا فيه وفيهُم ذو اغترابِ",19,"ب",1,0],["ورعوا أنجم الدجى","طالعاً بعد طالع",20,"ع",1,0],["ورعيتُ حقَّ مودتي","إذ لم أجدك لها بِراع",21,"ع",1,0],["ورعايا حميتها بعد أن شا","رك في حفظها الرعاء السباعا",22,"ع",2,0],["ورعاً أن تقارف البخل كفا","ك وهيهات أن تُلاقى فروقا",23,"ق",2,0],["ورعَى اللَّه مَنْ رَعَيْتَ من النا","س ولم يَرْعَ من رآه طريدَك",24,"ك",1,0],["ورعيتَ العلا على كل حيٍّ","رعْيَ لا مُغفلٍ ولا متواني",25,"ن",2,0],["ورعاهُ معروفٌ يُخامِرُ نَفسَهُ","ويفيضُ عنها والنفوسُ لواهي",26,"ه",2,0],["وَرَعى المُهَيمَنُ ساكِنيهِ فَإِنَّهُم","في خَيرِ أَرضٍ خَيرَةِ السُكّانِ",27,"ن",1,0],["وَرَعَيتُ فيكَ النَجمَ يا","مَن كانَ يَحفَظُني وَيَرعى",28,"ع",2,0],["ورعية لك في الممالك بَرّة","غمرتهمومن بيتك الآلاء",29,"ا",2,0],["ورعاهم لك واسترعاهم","بك مأمونا على العهد أمين",30,"ن",1,0],["وَرِعايَةِ طِفلٍ أَو هَرِمِ","وَالذَودُ عَنِ الغيدِ الحُصُنِ",31,"ن",1,0],["وَرَعاني رَعى الإِلَهُ لَهُ الفارو","قَ طِفلاً وَيَومَ مَرجُوِّ شانِه",32,"ن",2,0],["وَرُعْنَ بِنَا قَلْبَ الفُراتِ كأنّمَا","تَخِرُّ عَلَيْهِ بالرّجالِ سُيُولُ",33,"ل",1,0],["وَرَعَيتَنا فَأَرَيتَنا","سُنَنَ الرَشادِ بِحُسنِ قَصدِك",34,"ك",1,0],["وَرَعِيَّةٍ أَحسَنتَ رَعيَ سَوامِها","حَتّى غَدَت وَالعَدلُ فيها مُهمَلُ",35,"ل",1,0],["وَرَعى اللَهُ مَن رَعى","حَقَّ عَهدي وَصُحبَتي",36,"ت",2,0],["وَرَعَيتُ أَنجُمَهُ فَأَكسَبتُ السُها","سُقمي وَأَكسَبَ جَفنِيَ التَسهيدا",37,"د",2,0],["ورعانا بجاههم وحمانا","بحماهُمْ وبدَّل الخوفَ أمنا",38,"ن",2,0],["وَرَعْيَاً ليومِكَ يومِ \"الطُّفوف\"","وسَقْيَاً لأرضِكَ مِن مَصْرَعِ",39,"ع",1,0],["وَرَعى الأَمانَةَ في المَغيبِ وَلَم يَخُن","غيبَ الصَديقِ وَذاكَ فِعلُ المُسلِمِ",40,"م",1,0],["وَرَعوا ذِمامَ بِلادِهِم بِوَصِيَّةٍ","نَكَصَ الغَوِيُّ لَها عَلى الأَعقابِ",41,"ب",1,0],["وَرَعاكم رَعْيَ الحفيِّ يُؤّدي","حقَّ أضيافهِ وَفِيّاً أمينا",42,"ن",2,0],["وَرُعْتَ به أَدِيمَ الأرضِ لمّا","جَعلتَ عليه من دَمِه خِضابا",43,"ب",2,0],["وَرَعى حقَّكِ لا يبغِي سوى","أن تكوني بالمحلِّ الأليق",44,"ق",1,0],["وَرَعَت جُنوبَ السِدرِ حَولاً كامِلاً","وَالحَزنُ فَهيَ يَزِلُّ عَنها الكورُ",45,"ر",1,0],["وَرَعَت بُطونَ بِلادِهِ","لِقَحٌ مِنَ البَرَكاتِ",46,"ت",1,0],["ورَعِيَّةٌ هُدّابُ عَدلِكَ فوقَها","سِتْرٌ على مُهَجاتِها مسدول",47,"ل",1,0],["وَرعدٌ يصمُّ الأذْنَ صوتُ دويِّهِ","وَبرقُ سحابٍ بالتتابعِ يلمع",48,"ع",1,0],["ورعتني في ظلمة الليل حتى","تركت نومها لأجل منامي",49,"م",2,0],["ورَعَيْتُ مِن وَجْهِ السَّمَاءِ خَمِيلةً","خَضْرَاءَ لاحَ البَدْرُ مِن غُدْرانِهَا",50,"ن",3,0],["وَرَعَّادٌ تَطِيرُ لَهُ","نُفُوسُ الْوَحْشِ مِنْ ذَهَلِ",51,"ل",1,0],["وَرَعَى الأُولَى خَلَفُوا الْعِمَا","دَ السَّابِقِينَ مِنَ الْعِمَادْ",52,"د",1,0],["وَرَعَى الأُولَى قَدَرُوا الجَمَالَ فَبَرَّزُوا","بِفُنُونِهِمْ مِنْ صَامِتٍ أَوْ نَاطِقِ",53,"ق",1,0],["وَرَعَى رِيَاضَاتٍ تُنَشِّيءُ فِتْيَةً","سُمَحَاءَ أَخْلاَقٍ حُمَاةَ حَقائِقِ",53,"ق",1,0],["وَرَعَتْكَ عَيْنٌ لِلْعِنَا","يَاتِ الْعُلَى فِي مُسْتَقَرِّكْ",54,"ك",1,0],["وَرَعَاهُ اللّهُ الكَريمُ وَأَوْلا","هُ إِذَا مَا اسْتَعَانَهُ كُلَّ نَصْرِ",55,"ر",1,0],["وَرَعَتْهُ حَاكِماً حَتَّى إِذا","شَجَرَتْ بَيْنَهُمَا الْعِلاَّتُ شجْرَا",56,"ر",2,0],["وَرَعْتِنَا يَا وَقَارُ فِيمَا","لَطُفَتْ مِنْ فِتْنَةِ الدَّلاَلِ",57,"ل",1,0],["وَرَعَى مَعَاهِدَ الاقْتِصَادِ فَأَزهَرَتْ","وَقَضَتْ مُنىً بِعَدِيدِها الْمُتَعَدِّدِ",58,"د",1,0],["ورَعَى اللّهَ في الرّعِيّةِ والملكِ","فوفَّى حقَّ الإِلهِ وأَدَّى",59,"د",2,0],["ورُعْتَ كلَّ فتاةِ في قِلادتِها","بِدُرِّ لفظِكَ منثُوراً ومُنتظِما",60,"م",2,0],["وَرَعَى البحارَ، ومَن يقيم بهنَّ من","أمَمٍ رعاةُ النُّوق والأغنام",61,"م",1,0],["ورعشةَ أهدابِك المثقلاتِ","على فرْط ما حُمِّلَت تَحْلِف",62,"ف",1,0],["ورعيتُ حقَّ مودتي","إذا لم أجدك لها براعِ",63,"ع",1,0],["ورَعى اللهُ غَزالًا نافِرًا","طَرْفُهُ يَكْتُبُ آدابًا وفَنّْ",64,"ن",1,0],["ورعيت حرمة شاعر دنف","يشكو إليك العوز والفقرا",65,"ر",2,0],["ورُعنَا كُلَّ مَن يَهوَى ورُغنَا","وأَبدَينَا التَّصَوُّفَ والخُشُوعَا",66,"ع",2,0],["وَرَعَيتَ حَقَّ القاصِدينَ وَما رَعَوا","وَوَعَيتَ قَولَ المادِحينَ وَلَم يَعوا",67,"ع",3,0],["وَرَعِيَّةٍ أَغنَيتَها وَحَمَيتَها","فَدُعاؤُها بِثَنائِها مَوصولُ",68,"ل",1,0],["وَرُعنا بِكَ الأَحداثَ حَتّى كَأَنَّما","حَطَطنا عَلى الأَحداثِ مِن يَذبُلٍ رُكنا",69,"ن",2,0],["وَرَعِيَّةٍ أَنسَيتَها مُذ حُطتَها","زَمَناً تَشيبُ لِهَولِهِ وَلِدانُهُ",70,"ن",2,0],["وَرَعاكَ مَن لَو كُنتَ راعِيَ خَلقِهِ","لَم يُرعَ إِلّا لِلحَنيفِ ذِمامُ",71,"م",1,0],["وَرُعيتِ مِن دارٍ وَإِن لَم تَنطُقي","بِجوابِ حاجَتِنا وضإِن لَم تَعقِلي",72,"ي",1,1],["وَرَعابيبٌ حِسانٌ كَالدُمى","لا يُنِلنَ الشَيبَ لِذاتِ الشَبابِ",73,"ب",1,0],["ورعود ذهل الناس بها","عن حطام جمعوه وعيال",74,"ل",1,0],["وَرِعٌ كَثيرٌ صَمتُهُ ذو فِكرَةٍ","مَرضِيَّةٍ مُتَواصِلُ الأَحزانِ",75,"ن",1,0],["وَرُعِ العِدى مِنها بِأَدهَمَ رائِعٍ","يَعنو لِغُرَّتِهِ الصَباحُ الأَشهَبُ",76,"ب",1,0],["ورعيا لأوقاتٍ مضت في ظلاله","بها ظبيُ أُنسي بالمسرّة راتع",77,"ع",1,0],["ورعت إجلالا قلوب العدى","فكل قلب منهم قلب",78,"ب",1,0],["وَرُعتمُ بالرَدى قَلبَ ابنِ فاطمة","وَما رَعيتم ذِماماً جدَّ مَخفورِ",79,"ر",1,0],["وَرَعى ذمامَ المعلواتِ وصانهُ","وَأبانَ وجهَ النصحِ غير مصونِ",80,"ن",1,0],["وَرَعاهُ بِصادقِ الوعدِ ملكاً","وَالوزير الّذي اِصطفاه خدينه",81,"ن",2,0],["وَرعى بسدٍّ للذرائِع منعةً","لحِمى الشرائِع عن ذوي اِستهوانِ",82,"ن",1,0],["وَرَعَيْتَ هذا الجيشَ مِنكَ بِناظِرٍ","مَا كادَ يُهْمَلُ رَعْيُهُ بِمَنامِ",83,"م",1,1],["وَرَعَيتَ ما استَرعَوكَ مُجتَهِداً وَلَم","تَأخُذكَ فيهِ مَلامَةُ اللَّوامِ",84,"م",1,0],["ورَعاك مَنْ أَعْلَى مَحلَّك فاعتلَى","فوق النجومِ برغْمِ كلِّ حَسود",85,"د",1,0],["ورِعُ النّفسِ ما رأى اللهُ حُوباً","قطّ منه يدورُ في حَوباء",86,"ا",2,0],["وَرِعاتٌ عَن الخِيانَةِ إِلا","نَظَراتٍ رأَينَها مُستَحَلَّه",87,"ل",2,0],["ورعياً لمرءٍ ظن دنياه إنَّها","منكَّرَةٌ والنقصُ فيها جزاؤه",88,"ا",3,0],["ورَعياً لأيَّام مضتْ في عِراصِها","تُؤَلِّفُ بين الظبْي والأسَدِ الوَرْدِ",89,"د",1,0],["ورعاه بعين الأمن وقد","جعل الأدهار له عمرا",90,"ر",2,0],["ورعيت هذا الملك منك بمقلةٍ","لم تكتحل أجفانها بمنام",91,"م",1,0],["ورَعى لَكَ الرحمن مَا اسْتَرْعاكَهُ","من دِينِهِ أَجْراً بما راعيتَني",92,"ن",2,0],["ورعى الإله منازلا","وحمى جواسقك الفخيمه",93,"م",2,0],["ورعى الإله على المصلى جي