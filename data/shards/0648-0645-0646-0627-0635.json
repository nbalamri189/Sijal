{"poems":[[55,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[65,"لمعت كناصية الحصان الأشقر","https://www.aldiwan.net/poem46196.html","الكامل"],[53,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[72,"أيا من زاد في تيه","https://www.aldiwan.net/poem42902.html","الهزج"],[87,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54868","الكامل"],[189,"يا ساحل الثغر كم لي فيك من أرب","https://www.aldiwan.net/poem14109.html","البسيط"],[189,"أوجهك أم قبلة فالغصو","https://www.aldiwan.net/poem14585.html","المتقارب"],[214,"أكاتب خط الوصل حرر لي الضبطا","https://www.aldiwan.net/poem13302.html","الطويل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[398,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[534,"أمرهف لحظه سله","https://www.aldiwan.net/poem37272.html","مجزوء الوافر"],[567,"لمن الخيام ومن هنالك نازل","https://www.aldiwan.net/poem52901.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138355",""],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59578","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62593","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59429","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65054","الكامل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145163","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93136","البسيط"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82557","الوافر"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123091","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113760","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126231","المتدارك"],[2603,"","https://poetry.dctabudhabi.ae/diwan/poem/134216","الكامل"],[398,"","https://poetry.dctabudhabi.ae/diwan/poem/88162","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140046",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200745","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100786","الطويل"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105841","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102944","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77153","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123502","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123496","البسيط"],[4267,"","https://poetry.dctabudhabi.ae/diwan/poem/120187","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72493","الطويل"],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[592,"بهجر أضاء الفجر واستعلن الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128846",""],[592,"ألا قل لأهل الجهل من كل من قد طغى","https://www.poetsgate.com/ViewPoem.aspx?id=128809",""],[5690,"نادى البشير وصبح الخير قد سفرا","https://www.poetsgate.com/ViewPoem.aspx?id=172159",""],[5842,"إشراقات الأمل / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=105051",""],[5894,"إن الفضيلة في الزمان تراد","https://www.poetsgate.com/ViewPoem.aspx?id=131439",""],[5309,"بلادي هوى الدنيا ومأوى الغرائب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573554",""]],"verses":[["وَمَن أَصبَحَ المِقدارُ حادي مَطِيَّهِ","أَجَدُّ بِلا رُزءٍ وَلا سَوطِ ضارِبِ",0,"ب",1,0],["ومَناصِباً فَرَعَتْ ذُؤابَةَ فارِسٍ","لمْ يَستَبِدَّ بهِنّ آلُ المُنْذِرِ",1,"ر",1,0],["ومناصحٌ تعلَى ونبْلٌ يعتلي","وصفائح تعلو وسُمرٌ تَنهلُ",2,"ل",1,0],["وَمَن أَصبَحَ لا يُلوي","عَلى زَيدٍ وَلا عَمرِو",3,"ر",2,0],["وَمَناصِبٌ في غَيرِ مَوضِعِها كَما","حَلَّت مَحَلَّ القُدوَةِ الأَصنامُ",4,"م",1,0],["ومن أصاب البحر في سلطانه","عدّ جميع الأرض من أوطانه",5,"ه",1,0],["وَمَنِ اصْطَفَتْهُ عِنَايَةٌ مِنْ رَبِّهِ","تَأْتِي الأُمُورُ لَهُ كَمَا يَخْتَارُ",6,"ر",1,0],["ومن أصيلٍ كأنّ الماءَ فيكَ به","ذَوْبُ اللُّجَين عَلاهُ ذائبُ الذهبِ",7,"ب",1,0],["ومن أصبحت نارُ وجدي به","تُؤَجِّجها في الحشا أدمعي",8,"ع",2,0],["ومن اصبعيه الماء فاض وقد جرى","ممينا فروّى الجيش واليلد القطحا",9,"ط",3,0],["وَمن أَصبحت غرّ الفضائلِ جنده","فَقَد صارَ ذا حزبٍ يؤمّنه الحزبا",10,"ب",2,0],["وَمناصبين تَسمَّعوا وَقلوبُهُم","حَرّى تَفَتَّتُ دونها الأَكبادُ",11,"د",1,0],["ومَنْ أَصْدَاغُه أَبَداً","عَقَارِبُها بِلا عِلّهْ",12,"ل",2,0],["ومنَاصلٌ وذَوابلٌ وجحافلٌ","وقنابلٌ ورواحلٌ وقوافلُ",13,"ل",1,0],["ومن اصطفته امة قد ناضلت","عن حق وادي النيل خير نضال",14,"ل",1,0],["ومن أصعب الأشياء ظام مُحلّأ","يرى الوِرد سهلاً وهو لم يستطع وِردا",15,"د",2,0],["ومن أصبحت محبوبَه حَسَناتُه","فتؤنسه ميتاً وتلقى به الخلدا",16,"د",2,0],["ومن اصابعه فاض الزلال فقل","يا حبذا النيل في وقت الزيادات",17,"ت",1,0],["ومَنِ اصْطفاهُ اللهُ مِنْ دونِ الوَرَى","فأَجَلَّهُ فَوقَ الكواكبِ مِنْ عَلِ",18,"ل",1,0],["ومَن أصاب منهم أصيبا","وكان يوم الملتقى عصيبا",19,"ب",2,0],["ومن أصاب قريشاً بابن بجدتها","وشيبة الحمد من أقذاه أجفانا",20,"ن",2,0],["وَمَن أصفَيتُه في الوُدّ جُهدي","فَعارَضَ في الجَفاءِ بِمِثلِ جهدي",21,"د",2,0],["ومنا صرن في سلفي نزارٍ","لما كنا عليه حاملينا",22,"ن",2,0],["ومن إصبعيه الماء فاض زُلاله","وأشبع أقواماً بكفّ طعام",23,"م",1,0],["ومناصِبٌ شَرعِيَّةٌ موروثة","مَبثوثةٌ في الفَرعِ عَن أصلٍ عَلا",24,"ل",2,0],["ومَنَاصِبُهُم ومّصَائِبُهُم","ومَعَائِشُهُم وعَواقِبُهُم",25,"م",1,0],["ومن اصطفى من لم يكن بالمصطفى","آليت غير المصطفى لا اصطفي",26,"ف",2,0],["وَمناصِبٍ فارَت مراجِلُ غيظِه","حَنَقاً عَلَيَّ وَلا يُطيقُ مَعابي",27,"ب",2,0],["ومن أصابعه بين الورى نبعت","عيون لو تركت كانت كجيحون",28,"ن",1,0],["ومن أصغى لأشعاري مليّاً","سأضمن خلقه خلقاً جديدا",29,"د",2,0],["ومن أصبحت تهدى المعالي كفه","جدير بأن نهدى اليه التهانيا",30,"ي",2,0],["ومن أصفرٍ كالصبّ يلقى الحبيب أو","كُراتٍ أديرت من خلاصة عسجد",31,"د",1,0],["ومن أصبحت ترعاه عين عناية","تداني له النائي ولان له الصلد",32,"د",1,0],["وَمن أَصلِه الأَنصار شيخي محمد","هُوَ البَحرُ عِلماً بِالفَضائِل زاخِر",33,"ر",1,0],["ومن اصبعيه سال ما روّى الظما","وبلمس راحته أزيل مسيس",34,"س",1,0],["ومن أصولى من كل الاذى وكذا","فرعى وصحبى واخوانا وأفخاذا",35,"ذ",2,0],["ومن أصبحت ترقى الى المجد والعلا","مراقي لم يرق اليها ولن ترقى",36,"ق",2,0],["ومن أصله الزاكي الارومة كم علا","إلى النجم فرع لا ينال طويل",37,"ل",1,0],["ومناصر السلطان كافى نصره","بعساكر السلطان أي كفاء",38,"ا",2,0],["ومن أصله المجد المؤثل والعلا","ومن جوده الجدوى لمن مسه الجهد",39,"د",1,0],["ومن أصغر الطلاب للعلم بل لكم","مزية جهل غيها قد تجهما",40,"م",2,0],["ومن أصر على العصيان كان لهُ","من القصاص نصيب يصدع الحجرا",41,"ر",2,0],["ومن اصطلاه الحقد ناءَ بغيظه","وحصادُه فوق التراب دَمارُ",42,"ر",1,0],["ومن اصطفى صنع الجميل تجارة","كأبي حسين حفه الإسعاد",43,"د",1,0],["وَمَن أَصمَتِ الأَطماعُ عِزَّةَ نَفسِهِ","يُسَمّي الَّذي لَم تُصمِهِ بِالمُشاغِبِ",44,"ب",1,0]]}