"https://poetry.dctabudhabi.ae/diwan/poem/143430","المتقارب"],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140145",""],[4858,"المرء بين الهوى والرّضا","https://www.poetsgate.com/ViewPoem.aspx?id=139676",""],[4858,"هنيئاً ذا التّخرّجُ يا صُهيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=156818",""],[5005,"معلّمنا..","https://www.poetsgate.com/ViewPoem.aspx?id=208154",""],[585,"يا جيرة البان مهلاً واسألوا البانا","https://www.poetsgate.com/ViewPoem.aspx?id=161926",""],[5121,"لذيذ الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=33869",""],[5145,"وزير المليك ورثت البقاءا","https://www.poetsgate.com/ViewPoem.aspx?id=108059",""],[5183,"سَيْفُ الْلّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=186452",""],[5183,"حلل الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=186599",""],[5183,"إلى الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=180189",""],[592,"اتاني تكتاب من صفى وذي ود","https://www.poetsgate.com/ViewPoem.aspx?id=128844",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5431,"تباكى كاليتامى ذات غصةْ....","https://www.poetsgate.com/ViewPoem.aspx?id=212134",""],[5438,"شَرِيدُ الأَشْوَاق","https://www.poetsgate.com/ViewPoem.aspx?id=202220",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5970,"غداً الرحيل وفي غد سنودع","https://www.poetsgate.com/ViewPoem.aspx?id=130611",""],[463,"علَّمتها الأيامُ أن تتجنَّى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60232&r=&rc=288",""]],"verses":[["فَبَوَّأَ أَوفاهُم يَداً قُلَّةَ العُلى","وَمَدَّ بِأَضباعِ الرِجالِ البَحاتِرِ",0,"ر",1,0],["فبوّأتُموها حيثُ يُلقي به التُّقى","مَراسِيهُ والعِزُّ مُرْخَى الضّفائِرِ",1,"ر",1,0],["فَبُؤتَ بِها علَى الأيّامِ داءً","عُضالاً لا تُفيقُ علَيْهِ فيقَهْ",2,"ق",2,0],["فَبَوْأَتُهُ مِنْ مُهْجَتِي مُتَبَوَّأ","عَزِيزاً عَلَى سِرِّ الْفُؤَادِ الْمُكَتَّمِ",3,"م",1,0],["فَبورِكَ ما أَعطى اِبنُ لَيلى بِنِيَّةٍ","وَصامِتُ ما أَعطى اِبنُ لَيلى وَناطِقُه",4,"ق",2,0],["فَبُورِكتْ أُمٌّ رَؤُومٌ مَضَتْ","وَبُورِكَ ابْنٌ عَبْقَرِيٌّ أَقَامْ",5,"م",1,0],["فَبَوَّأَ الرَميَ في نَزعٍ فَحُمَّ لَها","مِن ناشِباتِ أَخي جِلّانَ تَسليمُ",6,"م",1,0],["فَبُؤ بِالمَخازي يا فَرَزدَقُ لَم يَبِت","أَديمُكَ إِلّا واهِياً غَيرَ أَوفَرا",7,"ر",2,0],["فَبورِكتَ يا قَبرَ الرَسولِ وَبورِكَت","بِلادٌ ثَوى فيها الرَشيدُ المُسَدَّدُ",8,"د",1,0],["فبُؤْ بحمدٍ وذمّ تستحقُّهما","كما خَلَطْتَ الذي أسْدَيتَ بالعذلِ",9,"ل",1,0],["فَبورِكتُما مِن ساعِدٍ وَمُهَنَّدٍ","بِرَغمِ خَأونٍ مارِقٍ مُتَشائِمِ",10,"م",1,0],["فَبورِكتَ مِن غَيثٍ كَأَنَّ جُلودَنا","بِهِ تُنبِتُ الديباجَ وَالوَشيَ وَالعَصبا",11,"ب",2,0],["فَبوؤسى لِلكَئيبِ بِها إِذا ما","بَدَت تَختالُ في حُسنِ الرُواءِ",12,"ا",2,0],["فَبُوِّأَ مِن جَهَنَّمَ شَرَّ دارٍ","عَلَيها لَم يَجِد عَنها مُحيدا",13,"د",2,0],["فبودليرُ محزونٌ وفرلين بائسٌ","وميسيه مجروحُ الهوى عاثرُ الجَدِّ",14,"د",1,0],["فَبُورِكْتَ فِي مُلْكٍ وَرِثْتَ ذَمَاءَهُ","وَخَلَّدْتَهُ فِي نَسْلِ مَجْدٍ أَكَارِمِ",15,"م",1,0],["فبوركتم وبورك ما تبنت","مواهبكم وبوركت الجهود",16,"د",1,0],["فَبَوَّأتُ سَهمي في كَتومٍ غَمَزتُها","فَخالَطَ سَهمي مُهجَةَ الذِئبِ وَالنَحرا",17,"ر",2,0],["فَبورِكتُما إِذ تَنفُضانِ يَدَيكُما","مِنَ الأَمرِ لا تَعلو بِأَمرٍ وَأَكمَدُ",18,"د",1,0],["فَبُورِكَ فِيهِ مِنْ حِبْرٍ جَلِيلٍ","وَمِنْ رَاعٍ نَبيلٍ فِي الرُّعَاةِ",19,"ه",1,0],["فبورك علما طابع الشرع باطنا","وفي ظاهر الأحكام للعذر قاطع",20,"ع",1,0],["فبورِكَ نسْجُ الصَّبرِ درعاً مضاعفاً","وبوركْتَ من ذي مِرَّةٍ متدرِّع",21,"ع",1,0],["فبوسى للكئيب بها إذا ما","بدت تختال في حسن الرواء",22,"ا",2,0],["فبُؤْ بحمدٍ وذمّ وتستحقُّهما","كما خَلَطْتَ الذي أسْدَيتَ بالعذل",23,"ل",1,0],["فبوركتما إذ تنفضان يديكما","من الأمر لا تعلو بأمثاله اليد",24,"د",1,0],["فبوركتما من ساعد ومهنّد","برغم خؤون مارق متشائم",25,"م",1,0],["فبُورِكَ إنسانًا وبُورِكَ شاعِرًا","وليتَ له في خدمة الشِّعرِ ثانِيا",26,"ي",2,0],["فبوَّأهُ الرحمنُ حضرةَ قدسِه","فأصبحَ في روض الرياحين يَرْنَعُ",27,"ع",1,0],["فَبُورِكتَ يا سَرحَ الخَدِيمِ وبُورِكَت","قُصورٌ ثَوَى فِيهَا الخَدِيمُ المُحَقَّقُ",28,"ق",1,0],["فبورك منسلاً ملك البرايا","وبورك بعده المنصور نسلا",29,"ل",2,0],["فَبُورِكتُمُ يا آلَ فَضلٍ فَإِنَّكُم","ضِياءٌ وَبَعضُ المالِكينَ ظَلامُ",30,"م",1,0],["فَبورِكتَ مِن مَلكٍ أَقَلُّ هِباتِهِ","تَزيدُ عَلى فَيضِ البُحُورِ الخَضارِمِ",31,"م",1,0],["فَبُورِكتَ مِن مَلكٍ أَقَلُّ هِباتِهِ","تُبِرُّ عَلى فَيضِ البِحارِ الخَضارِمِ",32,"م",1,0],["فَبُؤْسَى لصرفِ الدهر كم مرَّ عنده","تراثٌ لنا لا ينقضي وديون",33,"ن",1,0],["فبورك حملا واستوى الخير مرضعا","وباء بأنواع الكرامة مذ نشا",34,"ش",2,0],["فَبَوَّأَنَا دَرَكاً نَازِحاً","بُعَيْدَ النِّهَايَةِ مِمَّنْ يُنِيلْ",35,"ل",1,0],["فبوجنةٍ رَيّا وجفنٍ ذابلٍ","ومُقبّلٍ نَشرَ الأريجَ لطيفا",36,"ف",2,0],["فَبَوَّأتُه مُقلَتِي مَنزِلاً","وَقَدَّمتُ نَوْمِي إِلَيهِ قِرَى",37,"ر",2,0],["فبُوركتَ من طَودٍ على الدِّينِ ظِلُّه","وبَحرٍ منَ الإفضالِ والفَضْلِ مُفْعَم",38,"م",1,0],["فبواحدٍ يَسطو على أحبابهِ","وبواحِد يَسْطو على أعدائه",39,"ا",3,0],["فبوركت غوثاً للموائل مدركاً","وبوركت غيثاً للمؤمِّل ماطرا",40,"ر",2,0],["فَبورِكَ ولدُهُ أَبَداً سِهاماً","وَبورِكَ سَهمُ دين اللَهِ رامي",41,"م",2,0],["فبِوُدّي لو اُطَّلعتَ على قلْ","بي فيبدُو لك الوَلاءُ الدخيلُ",42,"ل",1,0],["فبوركتْ دار سادات مُؤَرَّخة","وعُمِّرت دارُ سلمان بسلمان",43,"ن",1,0],["فبورك مولودٌ وبورك والدٌ","به الذكر يبقى والمحامد تخلف",44,"ف",1,0],["فبُورك من لا زالَ يُورثني الغنى","وذكَّرني أيَّام داود ذي الأَيدي",45,"د",2,0],["فبَوارِقُ الزَّفَراتِ فيه خوافِقٌ","وسحائبُ العَبَراتِ فيه مَواطرُ",46,"ر",1,0],["فبوركَ في العيسِ الذي بلغَتْ له","وردّت مراعيها لها والمَباركُ",47,"ك",1,0],["فبودِّ المنى لوَ اَنّ ليالي","يَ اللواتي بكيتُ منهنّ عُدنا",48,"ن",2,0],["فبورك نسلا وأترابه","بنوك وبوركتَ من ناسلِ",49,"ل",1,0],["فبوركَ من غمْر السَّجايا كأنهُ","سنى قَمرٍ في حالِك الجُنح مُظلِم",50,"م",1,0],["فبوركَ من ثبْت الحُبى راجح النُّهى","تطيشُ الليالي وهو في الصَّبر يذبل",51,"ل",1,0],["فبورِكَ منْ حَبْرٍ إِمامٍ مُؤيَّدٍ","تُقاهُ دُروعٌ ضافياتُ الذَّلاذِلِ",52,"ل",1,0],["فبؤساهمُ في الحرب موتُ محاربٍ","وفي السلم نعماهم حياة المسالمِ",53,"م",1,0],["فبوركتما ثم عمرتما","مع العز والنصر عمراً مديدا",54,"د",2,0],["فبورك مولوداً وبوركت من أبٍ","كريم خلال سامي القدر والهمم",55,"م",1,0],["فَبورِكَ مِن قَبرٍ وَطُهِّرَ مِن ثَرى","وَقُدِّسَ مِن روحٍ وَعوفِيَ مِن بَدَن",56,"ن",1,0],["فَبُورِكَ مَنْ مَا زالَ عِنْدي نعيمُه","كَما عِنْدكُمْ يَا حاسدين عَذَابُه",57,"ب",2,0],["فبوأتُ رحلي ظِلَّ أروعِ ماجدٍ","يقُول بلا خُلفٍ ويُعطي بلا مَنّ",58,"ن",1,0],["فبوركت مرثية خليت","من الحلي بالمنتقى المنتجب",59,"ب",1,0],["فبوركت مرثية حليت","من الحلي بالمنتقى المنتخب",60,"ب",1,1],["فبورك فيه موهوباً وشكرا","لواهبه على النعمى وحمدا",61,"د",2,0],["فبوركت حيًّا يا أخا الجود والندى","وبوركت ميتاً قد حوتك رجوم",62,"م",1,0],["فبوركت رحلات وهو قائدُهَا","وبوركت بلدة تسمو بطلعته",63,"ت",2,0],["فبورك فيه ذا عمر طويل","وبورك في بنيه الأسد نسلا",64,"ل",2,0],["فبورك من بحرٍ ركبت وإن يكن","غدا من أياديك الغزيرة في خجَلْ",65,"ل",1,0],["فبوركتِ يا دار في وصلها","وهُنِّئتِ يا مقلتي بالنظرْ",66,"ر",1,0],["فبوجهه صبح الصباحة طالع","وبشعره ليل القلى قد عسعسا",67,"س",2,0],["فَبُورِكَ مِنْ فَرْعٍ زَكَا كَأصْلِهُ الَّذِي","بِهِ أزْهَرتْ أفْنَانُ عِيدٍ ومَوْسِمِ",68,"م",1,0],["فبُورِكْتَ مِنْ لَيْثٍ وغَيْثٍ أَغاثَها","فقامَتْ بِهِ في البَأْسِ والجُودِ سُوقُها",69,"ق",3,0],["فَبُورِكَ تُربُ طيبةَ مِنْ تُرابٍ","ومُدَّ الظلُّ في ذاكَ السِّباخِ",70,"خ",1,0],["فبوركت يا أسيوط للعلم من حمى","وبوركت يا وكن الحمام بها وكنا",71,"ا",1,0],["فبوركتَ من فردٍ حوى الدهر كله","ببرد علاً منه طوى الناس في برد",72,"د",1,0],["فبوركتْ خِلقةُ تَضميخه","لم تَمْتَهِنْها أُنملُ الطاليَهْ",73,"ل",3,0],["فبويع عثمان بن أحمد بعده","وأنزل عن قرب لأمر محتّم",74,"م",1,0],["فبويع للسلطان محمود بعده","هو ابن أخيه مصطفى المتقدّم",74,"م",1,0],["فبوئني اختصاصك حيث تجني","ثمار العز والعيش الرطيب",75,"ب",1,0],["فَبُورِكَ في أَيِّ أَرضٍ حَلَلتَ","وَسَقى الإِلهُ ثَراها القِطارا",76,"ر",2,0],["فَبُوُرِكتَ مِن غَيثٍ يَسِحُّ إِذا غَدا","يَشِحُّ بِنُعماهُ الجَهامُ المُزَبرَجُ",77,"ج",1,0],["فَبُورِكَ شَهرٌ أَنتَ فِيهِ مُسَلَّماً","وَلَكِنَّ بَيتَ المالِ غَيرُ