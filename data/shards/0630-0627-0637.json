{"poems":[[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64093","الخفيف"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113767","الكامل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141211","الدوبيت"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123863","الخفيف"],[5638,"طريق الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=200123",""],[6178,"قبلة ماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85528&r=&rc=4",""]],"verses":[["ذا طريقُ السلوِّ قد قَطَعَتْهُ","مقلةٌ تستحلُّ قَطْعَ الطريق",0,"ق",1,0],["ذا طالبٌ فضلاً وذا مُتَفَضِّلٌ","ممّا جَناهُ مِنَ الذنوبِ وَقَدَّما",1,"م",2,0],["ذا طور سينين فاغضض الطرف به","هذا حرم العزة فاخلع نعليك",2,"ك",1,0],["ذا طعام إن لذ فهو غليظٌ","كظةٌ للرغيب غصة بالع",3,"ع",1,0],["ذَا طَرِيقٌ لَيْسَ لِلأقْدَامِ بَلْ","لِقُلُوبٍ تَعْشَقُ الْحَقَّ صَفِيَّا",4,"ي",2,0],["ذا طوقها الوردي يجمع شعرها","فيضيفها حسنا على استحياء",5,"ا",2,0]]}