{"poems":[[75,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[10,"يا ابن الشريد على تنائي بيننا","https://www.aldiwan.net/poem20947.html","الكامل"],[95,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[46,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122774","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122796","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122772","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122648","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122789","المديد"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48853","الرمل"],[1476,"","https://poetry.dctabudhabi.ae/diwan/poem/72988","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101044","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203003","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134075","المجتث"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83176","الكامل"],[5187,"نداء القدس","https://www.poetsgate.com/ViewPoem.aspx?id=29241",""],[5325,"من شل من غلب العلى أيمانها","https://www.poetsgate.com/ViewPoem.aspx?id=171981",""]],"verses":[["فَكِهٌ يُبهِجُ الخَليلَ بِوَجهٍ","تَرِدُ العَينُ مِنهُ يَنبوعَ بِشرِ",0,"ر",1,0],["فَكِهٌ عَلى خَيرِ الغِذاءِ إِذا غَدَت","شَهباءُ تَقطَعُ بالِيَ الأَطنابِ",1,"ب",1,0],["فَكِهِ الْحَدِيثِ وَإِنْ أَقَلَّ مَكَانُهُ","مُتَفَقَّدٌ فِي مَجْلِسِ الإِخْوَانِ",2,"ن",1,0],["فَكِهٌ يُجِمُّ الجِدَّ أَحياناً وَقَد","يُنضى وَيُهزَلُ عَيشُ مَن لَم يَهزِلِ",3,"ل",1,0],["فَكِهٌ يُداعِبُ أَهلَهُ وَصِحابهُ","بِالحَقِّ مَحروسٌ مِن البطلانِ",4,"ن",1,0],["فَكِهُ الخِوانِ يَضيقُ عَرضُ الأَرضِ إن","مَدّ السِّماطَ لِشارِبٍ وَلِطاعِمِ",5,"م",1,0],["فَكِهُ الخِوانِ مُهَذَّبُ الإخوانِ مَح","ضورِ السِّماطِ مُرَهَّقُ النّيرانِ",6,"ن",1,0],["فَكِهٌ إذا نَزَلَ الضُّيُوفُ تَرَقرَقَت","فيهِ البَشاشَةِ فَوقَ ثَغرٍ باسِمِ",7,"م",1,0],["فَكِهٌ إذا استَوحشتَ من مُتَجَبِّرٍ","زادَت فُكاهتُه على الإيناس",8,"س",1,0],["فَكِهٌ فَوقَ الخِوانِ إذا","أرَزَمَ الإخوانَ إخوانُ",9,"ن",1,0],["فَكَّها من فَكَّ قومي","من قيود الغرماء",10,"ا",2,0],["فكِهُ العَشيِّ إذا تأوَّبَ رحلُهُ","ركبُ الشتاءِ مسامحٌ بالمسيرِ",11,"ر",1,1],["فكهلٌ في جهالته تولى","وشيخٌ في ضلالته تعامى",12,"م",2,0],["فكهولتي أضحت كهولتها كما","قد كان في الماضي صباي وصباها",13,"ا",3,0],["فكهذا الصفو لاحت","أيامه والليالي",14,"ل",2,0],["فَكِهُ الحَديثِ حَكيمُهُ لا مُضجِرٌ","مِنهُ الغَويَّ وَلا التَقِيَّ الأَورَعا",15,"ع",2,0],["فكُهولُنا ونساؤنا","والطفلُ يصرخُ ما الدّواءْ",16,"ا",2,0],["فكهولهم تزن الجبال رزانة","مع نجدة أورثتها شبانها",17,"ن",3,0]]}