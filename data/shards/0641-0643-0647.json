{"poems":[[75,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[10,"يا ابن الشريد على تنائي بيننا","https://www.aldiwan.net/poem20947.html","الكامل"],[95,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[46,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[234,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[711,"","https://poetry.dctabudhabi.ae/diwan/poem/72988","الكامل"]],"verses":[["فَكِهٌ يُبهِجُ الخَليلَ بِوَجهٍ","تَرِدُ العَينُ مِنهُ يَنبوعَ بِشرِ",0,"ر",1,0],["فَكِهٌ عَلى خَيرِ الغِذاءِ إِذا غَدَت","شَهباءُ تَقطَعُ بالِيَ الأَطنابِ",1,"ب",1,0],["فَكِهِ الْحَدِيثِ وَإِنْ أَقَلَّ مَكَانُهُ","مُتَفَقَّدٌ فِي مَجْلِسِ الإِخْوَانِ",2,"ن",1,0],["فَكِهٌ يُجِمُّ الجِدَّ أَحياناً وَقَد","يُنضى وَيُهزَلُ عَيشُ مَن لَم يَهزِلِ",3,"ل",1,0],["فَكِهٌ يُداعِبُ أَهلَهُ وَصِحابهُ","بِالحَقِّ مَحروسٌ مِن البطلانِ",4,"ن",1,0],["فكِهُ العَشيِّ إذا تأوَّبَ رحلُهُ","ركبُ الشتاءِ مسامحٌ بالمسيرِ",5,"ر",1,1]]}