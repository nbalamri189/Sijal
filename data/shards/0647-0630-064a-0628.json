em.aspx?id=188463",""],[5376,"يا داحسَ الغبراءُ هيْتَ مُظفَّرَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=205986",""],[5397,"لمن الرواسم بين تلك الأرسم","https://www.poetsgate.com/ViewPoem.aspx?id=157956",""],[5431,"شهوة الموت...","https://www.poetsgate.com/ViewPoem.aspx?id=204950",""],[5436,"للكرامات دربنا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177708",""],[5449,"موسوعةُ الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=188935",""],[5542,"مالي أراك تقلبُ النظرا","https://www.poetsgate.com/ViewPoem.aspx?id=9683",""],[5542,"عندما يعزف الرصاص","https://www.poetsgate.com/ViewPoem.aspx?id=10187",""],[5582,"هذِي بِشاراتُ السُّرُورِ تَراها","https://www.poetsgate.com/ViewPoem.aspx?id=187331",""],[5589,"تلهو بما يسع الأضاد أشرعتي","https://www.poetsgate.com/ViewPoem.aspx?id=187957",""],[5616,"دَنس","https://www.poetsgate.com/ViewPoem.aspx?id=203431",""],[5626,"ما بالُ قومي","https://www.poetsgate.com/ViewPoem.aspx?id=189561",""],[5720,"نشيدُ البَيعَة","https://www.poetsgate.com/ViewPoem.aspx?id=201302",""],[5758,"تَجلّى الموت","https://www.poetsgate.com/ViewPoem.aspx?id=200514",""],[5829,"انت الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=150260",""],[5829,"دعونا وشأننا","https://www.poetsgate.com/ViewPoem.aspx?id=178059",""],[5837,"سارعي يا بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=179452",""],[5895,"قد أتت سلوى","https://www.poetsgate.com/ViewPoem.aspx?id=214162",""],[5897,"وللأنس مجلس !","https://www.poetsgate.com/ViewPoem.aspx?id=157551",""],[5939,"طفلٌ بلا وطن","https://www.poetsgate.com/ViewPoem.aspx?id=178610",""],[5943,"العين إن خاصمت","https://www.poetsgate.com/ViewPoem.aspx?id=20470",""],[5956,"الداشرة صاحبةُ اليوم الأسود المتوقَّع","https://www.poetsgate.com/ViewPoem.aspx?id=204358",""],[6038,"بيعة الخسراني","https://www.poetsgate.com/ViewPoem.aspx?id=26802",""],[6045,"هدية يوم الأم","https://www.poetsgate.com/ViewPoem.aspx?id=125354",""],[161,"الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=163040",""],[6052,"كواكب أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=34627",""],[6070,"قولي بربكِ ما الذي أبكاكِ","https://www.poetsgate.com/ViewPoem.aspx?id=189501",""],[6187,"آخر أنفاس الحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82157&r=&rc=0",""],[415,"أَطِع الهَوى ، واعصِ المُعاتِبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7779&r=&rc=9",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""],[6268,"يبكيكم الأقصى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82924&r=&rc=10",""]],"verses":[["هذي بلودان وذا نزلها","تلقي به الأنفس ما تهوى",0,"ه",3,1],["هذي بديهتكَ الحسناء ما تركتْ","للسحر والنحلِ لا ضرْباً ولا ضرَبا",1,"ب",2,0],["هَذي بُيوتُ الرومِ كَيفَ سَكَنتَها","بَعدَ القُصورِ المُزرِياتِ بِقَيصَرِ",2,"ر",1,0],["هَذي بِجانِبِها الكَسيرِ غَريقَةٌ","تَهوي وَتِلكَ بِرُكنِها المَدكوكِ",3,"ك",1,0],["هَذي بَرَزتِ لَنا فَهُجتِ رَسيسا","ثُمَّ اِنثَنَيتِ وَما شَفَيتِ نَسيسا",4,"س",2,1],["هَذي بِلا نارٍ تَفورُ وَهَذِهِ","ماسَت مَعاطِفُها بِغَيرِ هَواءِ",5,"ا",2,0],["هذي برزت لنا فهجت رسيساً","ثم انصرفت وما شفيت نسيسا",6,"س",2,1],["هذي بَواكِرُه فكي","ف يكونُ ما بعدَ البواكرْ",7,"ر",1,0],["هذي بلادي وهنا إخوتي","أسكت تأدب ظافر مجرم",8,"م",1,0],["هذي بلادي ، وهنا إخوتي","أسكت … تأدّب … طافر مجرم",9,"م",1,0],["هذي بيوتُ الرُّومِ، كيف سكنتها","بعد القصورِ المزريااتِ بقيصر؟",10,"ر",1,0],["هَذِي بَنَاتُ أَبِيهِ فِي ظَعائِنِهِ","يُبْدِينَ لِلسَّبي إجْهاشاً وإِذْعَانا",11,"ن",2,0],["هذِي بِجايَةُ قَد سَدَدت ثُغورَها","بِمُبَارَكٍ يُمْضي الأمور مُسِدّدا",12,"د",2,0],["هذي بناتُكَ للأَشهاد بارِزَة","يُشهرنَ بين الأَعادي أَيَّ تَشهيرِ",13,"ر",1,0],["هذي بطاقة خادمٍ","قد جاء يلهج بالمدح",14,"ح",1,1],["هذِي بُثينةُ والمجنونُ قائدُها","إلى جميلٍ أجادَ المخّ يَا جَمَلُ",15,"ل",1,0],["هذي بُخارى تَشتَكي أَلَمَ الصَدى","وَتَقولُ قَولاً نُبتُ في اخبارِهِ",16,"ر",2,0],["هذي بلادك صانها الرحمن من","شرك ومن سوء التذلل للوثن",17,"ن",1,0],["هذي بلادك قلبها متفتح","فهي التي لا تشتكي ضيق العطن",17,"ن",1,0],["هذي بلادك دينها متأصل","في قلبها والمجد فيها مختزن",17,"ن",1,0],["هَذي بقايا سِحْرِ بَا","بِلَ وهيَ من إحدى العجائِبْ",18,"ب",1,0],["هذي بني وصاني إن عملت بها","نلت انعطافي كما نلت انعطاف أبي",19,"ب",2,0],["هذي بلادك يا حسين وأنت في","سرواتها من أشرف الأبناء",20,"ا",2,0],["هذي بأنْصُل جَفْنِها تسطو على","مُهَجِ الأُسودِ وذاكَ منْ مُرّانهِ",21,"ن",2,0],["هَذِي بُيوتُ حَلَّ فيها الْقَاصِرُ","فَلْتَقْفُ ما ألقى عَلَيْكَ الْخَاطِرُ",22,"ر",1,1],["هذي بنو عمرو العلى والسادة ال","أمجادِ قد حضروا لدى التأبينِ",23,"ن",1,0],["هذي بنو العلياءِ أبنا يعرب","تُبدي لك الحبّ الصميم وتضمرُ",24,"ر",1,0],["هذي بعثمان وذي بشقيقه","عبدالمجيد وما أنا بمرائى",25,"ا",2,0],["هَذي بن أسَدٍ بِضيفكَ أوقعت","وحَوت عطاءَك إذ حَواهُ الفدفدُ",26,"د",1,0],["هذي بِقاعٌ لَم تَكُن في القَصدِ","ساقَت لَها الأَقدار دونَ قَصدِ",27,"د",1,0],["هذي به الناس وقالوا قد اس","تغنى وقد صار وقد صارا",28,"ر",2,0],["هذي بقايا فتى ما غرّه ترف","ولا ثنته عن الصحراء(لوزان)",29,"ن",1,0],["هذي بلاد كالدو مقفرة","أبيات أبائنا بها دمن",30,"ن",1,0],["هذي بلادي والبلادُ عزيزةٌ","عندي ولو جارتْ عليَّ بلادي",31,"د",2,0],["هذي بواسط آي الحق صلت بها","عَلى الغواة وحرز للمجانين",32,"ن",1,0],["هذي بقاياك يا حطين بددها","لله ظل بارض الشام ممدود",33,"د",1,0],["هذي بقاعٌ كان يعبد ربّه","فيها فيركع ما يشاء ويسجد",34,"د",1,0],["هَذِي بُنَيَّةُ خَاطِرٍ أهدَيْتُهَا","شَرَحَتْ إلَيكَ مِنَ الوِدَادِ ضَمِيرَا",35,"ر",2,0],["هَذي بقيتهم تَدعوكَ إِذ رمقت","في شَخصِكَ الفَذ تاجاً دره كلم",36,"م",1,0],["هَذِي بسائِطُهُ ومنه تركَّبت","هَذِي المظاهِرُ مَا هُنَا شَيئَانِ",37,"ن",1,0],["هَذِي بِضَاعَتُكُم فَمَن يَستَامُهَا","فَقَدِ ارتَضَى بِالجَهلِ وَالخُسرَانِ",37,"ن",1,0],["هذي بضاعة ضارب في الأرض يب","غي تاجرا يبتاع بالأثمان",37,"ن",1,0],["هذي بدائعُ حِكمَةٍ سَطَّرتُهَا","بإشارةِ المولى أبي الحجاج",38,"ج",1,1],["هذي برمانا مشى لك اهلها","بمواكب محفوفة ببشائر",39,"ر",1,0],["هذي بلادُ الغربِ قد","بسطَت لديكَ المعذِرَه",40,"ه",1,1],["هذي بلاد الشرق بعد خرابها","بك أصبحت تختال بالعمران",41,"ن",1,0],["هذي بنو حرب إلى حربكم","قادت جموعاً جمعت من عمى",42,"م",2,0],["هَذي بَنو مصر وَتلك بَناتها","ملء الفجاج كرائماً وَكراما",43,"م",2,0],["هَذي بواسِمُها رقّتْ نواسِمُها","هذي منازِلُها رقّتْ منازِعُها",44,"ع",3,0],["هذي بنات الشعر جئت أذيعها","عما نكن لكم من الاكبار",45,"ر",1,0],["هذي بقاياك لو تستطيع تذهبها","كما ذهبت فيطويهن نسيان",46,"ن",1,0],["هذي بلاد الغرب ماثلة لكم","قد خيست بالعلم أسد الغاب",47,"ب",1,0],["هذي بشائره نادت مبلغة","وافتكم آية الرحمن فاعتبروا",48,"ر",3,0],["هذي بلادك تنعي موت راحتها","وَفي غد سوف تَنعي كل تأسيس",49,"س",1,0],["هذي بلادُ العرب في ضعفها","لا يعطفُ الجارُ على جيرته",50,"ت",2,0],["هذي بنوا حربٍ في حرب ابن فاطمة","قامت على ساقها فاجتثوا على الركب",51,"ب",1,0],["هذي بناتك حاسراتٍ ولهاً","فوق المطايا فيها ابن سعد قوضا",52,"ض",2,0],["هذي بنات المصطفى مذعورة","ريعت وما ريع لها سرب قطا",53,"ا",1,0],["هذي بقية نفس فارقت وطناً","وفرقة النفس تتلو فرقة الوطن",54,"ن",1,0],["هذي بدائع قد اودعتها نكتا","من المعاني نبت عن سمع كل غبي",55,"ب",2,1],["هذي بِلادُ الشرق قد عَرَفَتْكَ مُذْ","رَبَّتْكَ في مَهْد العَلاءِ صَغيرا",56,"ر",2,0],["هذي بِلادُ الغَرْب فَضْلُكَ مُنطِقٌ","بِثناك فيها أهلَهَا والدُّورا",56,"ر",2,0],["هذي بنوك وليس الله يا وطنا","يأتي المصائب إن الله مكتملُ",57,"ل",1,0],["هذي بلادُكَ يا ابنَ الغُربَتَينِ, ويا","رُوحًا طَوَاها بِكَفٍ كُلُّ مُغتَرِبِ",58,"ب",1,0],["هذي بعضها في بعض كله ود","مزج الجمال ومزج كل الغنادير",59,"ر",1,0],["هذي بِلَادي في عُودِها صُلِبَتْ","مِنْ كُلِّ مَسلوبٍ خَانِعٍ لَبِدِ",60,"د",1,0],["هذي بِلادي عُيونُ المَوتِ تَعشَقُهَا","وَ الحُزنُ أَغرَقَهَا وَ الخِزيُ وَ النَّدَمُ",61,"م",1,0],["هذي بلادي التي ما التاع زائرها","لنا العروبة ُ عنوان ٌ والأخا عجم ُ",62,"م",1,0],["هذي بلادي فجئني غيرها نسِلت ْ","فيها الأمامة أو للا نبيا حرم ُ",62,"م",1,0],["هَذِي بلادي... تَشْتَكِي أَوْجَاعَها","وقفَ الزمان وغادرَ الخُطَّابُ",63,"ب",1,0],["هَذِي بِلادي هدموا أمجادَها","عبث الحمير بأرضها وكلابُ",63,"ب",1,0],["هذي بقاياي أضلاع مقوسة","على حشا من غرامي ملؤها عطب",64,"ب",1,0],["هذي بِلادِيَ قَد بيعتْ ضَفائرُها","غَصباً لكلِّ غَريبٍ رامَ أوطانا",65,"ن",2,0],["هذي بِلادي وَهذا النَّهْرُ والنّاسُ","فيها الْقُبابُ لِصُبْحِ الشّعْبِ أنْفاسُ",66,"س",1,1],["هذي بُغاتُكِ في السّوادِ تشتّتَتْ","هَيْهاتَ للْفِكْرِ الْعَقيمِ دَوامُ",67,"م",1,0],["هَذِيْ بِلادِيْ رُبُوْعٌ لا حُدُوْدَ لَهَا","وَ لَيْسَ أَجْمَلُ مِنْهَا الأَجْمَلُ الحَسَنُ",68,"ن",1,0],["هذي بلادي بنور الشرقِ مشرقةٌ","للمجدِ فيها لها الأحرار تنتقلُ",69,"ل",1,0],["هذي بلادي ونصرُ اللهِ موعدُها","في مُحكمِ الذِّكرِ والتنزيلِ قد ورَدا",70,"د",2,0],["هذي بلادك تستجير بربها","يا رب ملح طعامنا الإيمان",71,"ن",1,0],["هَذي بَقايايَ مِنْها بالنَّوى لَهَبٌ","يَشبُّ وَجْدَاً إلى لُقْياكَ يا كَبِدي",72,"د",2,0],["هذي بلادي لكمْ يشْتاقُها فَرَحي","لكي يَخُطَّ من الأمْجادِ أسْفارا",73,"ر",2,0],["هذي بوارقها وتلك غيومها","هطلت فقادتني إلى استنطاقها",74,"ق",3,0],["هذي براكين قومي للعلا قذفت","جيل الكرامة أعلى النجم كالشُّهبِ",75,"ب",1,0],["هذي بلادي سلاح الحق يرعبهم","أضلاعهم هرم هاماتهم هرمُ",76,"م",1,0],["هذي بلادي وهذي عزةُ بعدت","ماذا دهانا غرابُ البينِ ينعانا",77,"ن",2,0],["هذي بلادي لا أغالبُ حزنَها","وكأنَّها مسجونةٌ ومُسَوَّرَةْ",78,"ر",2,0],["هذي بنوك على الرغام قد انثنت","بمعاطس دون الحمية رغم",79,"م",1,0],["هذي بلاديَ قبحٌ طعنها قبحُ","ورقدة الموت أقصى مااشتهى الجرحُ !!",80,"ح",1,1],["هذي بغداد قدْ دعتْك لفجرٍ","فأنثر الشعر فوقها ياقوتا",81,"ت",2,0],["هذي بلادي كلُّها عربيَّةٌ","لو قُطِّعتْ أَلفاً مِنَ الأجزاءِ",82,"ا",2,0],["هذي بلادك ، ذكرها عَطِرٌ","فبها تسامى المجد وازدهرا",83,"ر",2,0],["هذي بساتين الجنان تزينت","للخاطبين فأين من يرتاد؟",84,"د",1,0],["هذِي بِشاراتُ السُّرُورِ تَراها","أَلْقَتْ إِلَيْكَ مَعَ السُّرُورِ عَصاها",85,"ا",3,1],["هذي بداية عشق بين مقلمتي","وبين ما يردع الآفات والجلد",86,"د",1,0],["هذي بضاعتهم ونعرفها","هذا عدوّ ماكر شرس!",87,"س",1,0],["هذي بلادُ العُرْبِ وَهْيَ صَريعَةُ","ما بَيْنَ شارِبَةِ الدِّما تَتَوارى",88,"ر",2,0],["هذي بلادُ النور .. طُهْرُ ترابِها","يُعطىٰ الحياةَ ، وخيرُها يتجددُ",89,"د",1,0],["هذي بلادي تجلّى الموتُ مُنطلقًا","نَبْكِي عَلى الفقْد أمْ نبْكي مَآسينَا",90,"ن",2,1],["هذي بلاد العرب صارت نهبة","بين الغريب وثلة العرباء",91,"ا",2,0],["هذي بلاد الشام أضحت نهبةً","في كل حين تستبى وتجمر",92,"ر",1,0],["هذي بلاد الخير وأهل الطيبة","دار النبوّة والرسول الهادي",93,"د",2,0],["هَذِى بُيُوتُ الصَّمْتِ قَدْ نَطَقَتْ","يَا لَيْتَ أَبْيَاتاً بِهَا نَجْوَى",94,"و",2,0],["هذي براعمُنا الصغار تفتحت","لما سقاها بالحيا ساقينا",95,"ن",2,0],["هذي بلادٌ لا تُحبُّ طُيورَها","قد زُيِّنَتْ للشرِّ والأعلاجِ",96,"ج",1,0],["هذي بها أقبلتْ دنياي مشرقة","وأختها ثروتي بالخيرِ تبتسمُ",97,"م",1,0],["هذي بداية شر يومٍ أسودٍ","ستدق رقبتها يدُ الفيروسِ",98,"س",1,0],["هذي باختصار قصتي مع الاحزاني","يوم شفته معاها قالت لي خطيبي",99,"ب",2,0],["هذي بقايا أحرُفي وهواكِ","تنثال من شفتي إلى مرساك",100,"ك",1,1],["هَذِي بِلاَدِي فَصَدِّقْ","أُنْظُرْ وَعَقِّبْ بِشُكْرِ",101,"ر",1,0],["هذي بلاد بالأباء تسورت","وتجندت إيمانها أسوارها",102,"ر",3,0],["هذي بلادي جنتي وجميلتي","بغدادُ أُمي والبهاءُ بهاكِ",103,"ك",1,0],["هذى براكين الأسى اندلعت","وزلازل الآهات تحتد",104,"د",1,0],["هذي بقايا سحرِ با","بلَ وهي إحدى العجائبْ",105,"ب",1,0],["هذي بِلادي مَا خُلِقْتُ لِغَيْرِها","وَ لِغَيْرِ رَبِّ البَيْتِ لَسْتُ الجاثِيَا",106,"ي",2,0],["هذي بطرف ناعس","والخصر بالصدر فتر",107,"ر",1,0],["هذي بلادي عُرضةٌ للردى","وذاك شعبي كالأسير الجريحْ",108,"ح",1,0]]}