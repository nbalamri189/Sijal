{"poems":[[445,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18055","الوافر"],[4791,"وقت الرد حان","https://www.poetsgate.com/ViewPoem.aspx?id=37112",""]],"verses":[["جآجِئُ غِرْبانٍ تطيرُ لنا بِهَا","عَلَى مثلِ أَطْوَادِ الفيافي نَعَائِمُ",0,"م",1,0],["جَآجِئُها تَشُقُّ اللُجَّ عَنها","وَيُبدي ماؤُها خَشَباً دَهينا",1,"ن",2,0],["جا جمال الكون كلَّه تحت يدّك","والحسن منك اشتكى يبغى الأمان",2,"ن",1,0]]}