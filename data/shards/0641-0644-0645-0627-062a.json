,"الطويل"],[4935,"بشير السرور بيوم سعيد","https://www.poetsgate.com/ViewPoem.aspx?id=129482",""],[585,"سل الفلك الدوار ما للكواكب","https://www.poetsgate.com/ViewPoem.aspx?id=161870",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5183,"إلى حادي العزائم","https://www.poetsgate.com/ViewPoem.aspx?id=180221",""],[5190,"حتى حين","https://www.poetsgate.com/ViewPoem.aspx?id=153350",""],[5236,"رأتني ومن لبسي المشيب فأملت","https://www.poetsgate.com/ViewPoem.aspx?id=82570",""],[308,"هَل الْبَرْق قد وشى مطارف ديجور","https://www.poetsgate.com/ViewPoem.aspx?id=189361",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"أرى طالع الأدبار والنحس قد بدا","https://www.poetsgate.com/ViewPoem.aspx?id=128843",""],[592,"هو الله معبود الورى فله الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=128841",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[5358,"النبضات","https://www.poetsgate.com/ViewPoem.aspx?id=133",""],[5358,"مسار الكواكب","https://www.poetsgate.com/ViewPoem.aspx?id=21906",""],[5431,"سيرة ذاتية","https://www.poetsgate.com/ViewPoem.aspx?id=183004",""],[5431,"الأنثى(الكلبة)...","https://www.poetsgate.com/ViewPoem.aspx?id=212495",""],[5582,"خَيالٌ سَرَى وَهْناً وَزارَ وِسادِي","https://www.poetsgate.com/ViewPoem.aspx?id=63489",""],[5884,"أغالب فيه الشوق والشوق غالبي","https://www.poetsgate.com/ViewPoem.aspx?id=124749",""],[5937,"شبيهةُ صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=211806",""],[5956,"أليمٌ أن أخَسِّرهُ حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=193200",""],[6093,"فَمَا كُلُّ قَولٍ يُقَالُ صَحِيْحاً (المتقارب)","https://www.poetsgate.com/ViewPoem.aspx?id=181457",""],[199,"لِمَنْ رَسْمُ دَارٍ كالكتابِ المُنَمْنَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=22432",""],[6259,"بدا البرق من نجدٍ فحن إلى نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59369&r=&rc=17",""],[2220,"حَمَلنَ على اليَعْمَلاَتِ الخُدورا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19274&r=&rc=816",""],[5126,"أعَاذلتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87835&r=&rc=49",""]],"verses":[["فَلَمّا تَراخَت في الضَلالِ ظُنونُهُم","تَراخى فَطارَت نارُهُ في العَشائِرِ",0,"ر",1,0],["فَلمّا تَفَهَّمتُ الكِتابَ رَدَدتُهُ","إِلَيها وَلَم أَبعَث بِرَدٍ لَهُ سَطرا",1,"ر",2,0],["فَلَمّا تَنازَعنا الحَديثَ وَأَسمَحَت","هَصَرتُ بِغُصنٍ ذي شَماريخَ مَيّالِ",2,"ل",1,0],["فَلَمَّا تَلاقَينا وجَدتُ بَنانَه","مُخَضّبَةً تَحكى الشَوَاعِلَ بِالشُّعَل",3,"ل",1,0],["فَلَمّا تَبَوّا مَنزِلَ اليُسرِ وَالغِنى","رَمى أَمَلي مِنهُ بِقاصِمَةِ الظَهرِ",4,"ر",1,0],["فَلَمّا تَجَلّى قَرعُها القاعَ سَمعَهُ","وَبانَ لَهُ وَسطَ الأَشاءِ اِنغِلالُها",5,"ل",3,0],["فَلَمّا تَقَضَّت حاجَةً مِن تَحَمُّلٍ","وَأَظهَرنَ وَاِقلَولى عَلى عودِهِ الجَحلُ",6,"ل",1,0],["فَلَمّا تَلاحَقنا وَلا مِثلَ ما بِنا","مِنَ الوَجدِ لا تَنقَضُّ مِنهُ الأَضالِعُ",7,"ع",1,0],["فَلَمّا تَقَضّى ذاكَ مِن ذاكَ وَاِكتَسَت","مُلاءً مِنَ الآلِ المِتانُ الأَجالِدُ",8,"د",1,0],["فَلَمّا تَسَربَلتَ الخِلافَةَ أَقبَلَت","عَلَيكَ بِأَبوابِ الأُمورِ الجَوامِعِ",9,"ع",1,0],["فَلَمّا تَغَشّى كُلَّ ثَغرٍ ظَلامُهُ","وَأَلقَت يَداً في كافِرٍ مُسيَ مَغرِبِ",10,"ب",1,0],["فلما تفرقنا كأني ومالكي","لطول اجتماع لم نبتْ ليلةً معا",11,"ع",2,0],["فلمَّا تعالت في السماء فحلّقت","وأمكنَها والأرض دَرْمَاءُ صَرْدَحُ",12,"ح",1,0],["فَلَمَّا تناهَى من يُبَارِيه في العلا","تَمادَى يُباري أمْسَهُ اليومُ والغدُ",13,"د",1,0],["فَلَمَّا تولَّى الأمرَ نُكِّرَ مُنْكرٌ","وعُرِّف معْرُوف وأُصْلِحَ مُفْسَدُ",13,"د",1,0],["فلمَّا تلَقَّتْها الثَّلاثُ رعَتْ لها","مع الجاهِ عند اللّه حُرْمَةَ جُودها",14,"د",3,0],["فلما تقضى حيْنُه وتفرَّغتْ","عَزاليه ثُرنا كالليوث اللوابدِ",15,"د",1,0],["فلما تجلَّى حِلُّها من حرامها","وزالت عن المرتاب فيها وساوسه",16,"س",2,0],["فلما تطعَّمْتُ الثمارَ وجدتُها","أمرَّ من البلوى وأدهَى من القتلِ",17,"ل",1,0],["فلم أتخيَّرْ من ثقاتيَ غيرهُ","ولم أرَ أنِّي عند ذلك ظالمه",18,"م",2,0],["فلم أتخيَّرْ بين يأْسٍ ومَطْمع","ولا قلتُ جبسٌ باردُ القلبِ نائمه",18,"م",2,0],["فَلمّا تَراماهُ الشَبابُ وَغَيُّهُ","وَفي النَفسِ مِنهُ فِتنَةٌ وَفُجورُها",19,"ر",3,0],["فَلَمّا تَلَوّى في جَحافِلِهِ السَفا","وَأَوجَعَهُ مَركوزُهُ وَذَوابِلُه",20,"ل",2,0],["فَلَمّا تَلاحَقنا نَبَذنا تَحِيَّةً","إِلَيهِنَّ وَاِلتَذَّ الحَديثَ أَصيلُها",21,"ل",3,0],["فَلَمّا تَناهى مِن قُلوبٍ طَرِيَّةٍ","تَذَكَّرَ وَكراً فَهوَ شَبعانُ آيِبُ",22,"ب",1,0],["فَلَمّا تَرَجَّت نَفعَهُ وَشَبابَهُ","أَتَت دونَها أُخرى حَديداً تُكَحِّلُ",23,"ل",1,0],["فَلَمّا تَفَرَّقنا شَجينَ بِعَبرَةٍ","وَزَوَّدنَنا نُصباً وَهُنَّ صَحائِحُ",24,"ح",1,0],["فَلَمّا تَرَكنَ الدارَ رُحنَ بِيانِعٍ","مِنَ النَخلِ لا جَحنٍ وَلا مُتَبَدِّدِ",25,"د",1,0],["فَلَمّا تَدارَكنا نَبَذنا تَحِيَّةً","وَدافَعَ أَدنانا العَوارِضَ بِاليَدِ",25,"د",1,0],["فَلَمّا تَرَكنَ الدارَ قُلتُ مُنيفَةٌ","بِقُرّانَ مِنها الباسِقاتُ المَواقِرُ",26,"ر",1,0],["فَلَمّا تَجَلّى لَيلُهُ عَن نَهارِهِ","غَدا سالِكاً بَينَ اللِوى فَالخَمائِلِ",27,"ل",1,0],["فلما تم من طهر","ومن شرف تنسمه",28,"م",2,0],["فلما تساقينا الوفاء وتم لي","وداد على كل الوداد أمير",29,"ر",1,0],["فَلَمّا تَجَلّى مِنْ دَلُوكٍ وَصَنْجةٍ","عَلَتْ كلَّ طَوْدٍ رَايَةٌ وَرَعيلُ",30,"ل",1,0],["فلما توسّطَ ذاك الطريقَ","عارضه بعضُ أهواله",31,"ل",2,0],["فَلَمّا تَأَمَّلتُ الطَلاقَةَ وَانثَنى","إِلَيَّ بِبِشرٍ آنَسَتني مَخايِلُه",32,"ل",2,0],["فَلَمّا تَصَفَّحتُ الرِكابَ اِتَّقَت بِها","أُريدُ بَقِيّاتِ العَرائِكِ في الذُرى",33,"ا",1,0],["فَلَمّا تَلاقى فَوقَهُ المَوجَ طامِياً","نَكَصتَ وَلَم تَحتَل لَهُ بِمَرامِ",34,"م",1,0],["فَلَمّا تَصافَنّا الإِداوَةَ أَجهَشَت","إِلَيَّ غُصونُ العَنبَرِيِّ الجُراضِمِ",35,"م",1,0],["فلما تَعلو عليكَ الطي","رُ إجلالاً وإعظَاما",36,"م",2,0],["فلمَّا تَهلَّلَ من وجهِه","هِلالٌ ومن بِشْرِه بارِقُ",37,"ق",1,0],["فلما تراءَتْ للجميعِ حبالُنا","عجبتُ لمضروبَيْنِ لا جَنَيَا ذَنبا",38,"ب",2,0],["فَلَمّا تَبَلَّجَ ما فَوقَهُ","أَناخَ فَشَنَّ عَلَيهِ الشَليلا",39,"ل",2,0],["فَلَمّا تَقاضَينا بِشِعرٍ سَخِطتُمُ","وَقُلتُم غَدا بَعدَ المَدائِحِ هاجِيا",40,"ي",2,0],["فَلَمّا تَجاوَزَ حَدَّ المَطالِ","نَسيتُ بِأَنّي لَهُ قَد نَسيتُ",41,"ت",1,0],["فَلَمّا تَرامَت عَن زَرودَ وَرَملِها","وَلاحَت لَها أَعلامُ نَجدٍ وُقورُها",42,"ر",3,0],["فَلَمّا تَلاقَينا وَقَد بَرِحَ الجَفا","رَأَت مُقلَتي أَضعافَ ما سَمِعَت أُذني",43,"ن",2,0],["فلما تنكر حتى المحب","تلفت أسألُ عنك العدا",44,"د",2,0],["فَلَمّا تَراءَت عَفاريتُهُ","سَنا كَوكَبٍ جاهِلِيِّ السَناءِ",45,"ا",2,0],["فلما تولى الحكمَ ما عاشَ طائلاً","فما هُنئَ ابنُ المجدِ واللهِ بالمجدِ",46,"د",1,0],["فَلَمّا تَقَضّى اللَيلُ إِلّا أَقَلَّهُ","هَبَبنا وَنادى بِالرَحيلِ سِنانُ",47,"ن",1,0],["فَلَمّا تَباثَثنا الحَديثَ وَبَيَّنَت","سَرائِرُهُ عَن بَعضِ ما كانَ قَد كَتَم",48,"م",1,0],["فَلَمّا تَقَضّى اللَيلُ قالَت فَتاتُها","أَرى قَبلَ أَن يَستيقِظَ الحَيُّ أَرفَقُ",49,"ق",1,0],["فَلَمّا تَواقَفنا تَحَيَّرَ حَولَها","نَواعِمُ كَالغِزلانِ بيضُ السَوالِفِ",50,"ف",1,0],["فَلَمّا تَجَلّى الرَوعُ عَنهُنَّ قُلنا لي","هَلُمَّ فَما عَنها لَكَ اليَومَ مَدفَعُ",51,"ع",1,0],["فَلَمّا تَواقَفنا وَسَلَّمتُ أَشرَقَت","وُجوهٌ زَهاها الحُسنُ أَن تَتَقَنَّعا",52,"ع",2,0],["فَلَمّا تَنازَعنا الأَحاديثَ قُلنَ لي","أَخِفتَ عَلَينا أَن نُغَرَّ وَنُخدَعا",52,"ع",2,0],["فَلَمّا تَقَضّى اللَيلُ إِلّا أَقَلَّهُ","وَكادَت تَوالي نَجمِهِ تَتَغَوَّرُ",53,"ر",1,0],["فَلَمّا تَقَضّى اللَيلُ إِلّا أَقَلَّهُ","وَأَعنَقَ تالي نَجمِهِ فَتَصَوَّبا",54,"ب",2,0],["فَلَمّا تَحَوَّلنا عَفاريتَ شِرَّةٍ","تَحَوَّلَ شُؤبوبُ السَماءِ رُجوما",55,"م",2,0],["فَلَمّا تَوَلّى وُدُّ لَيلى لِجانِبٍ","وَقَومٍ تَوَلَّينا لِقَومٍ وَجانِبِ",56,"ب",1,0],["فلما تسنَّى الأمرُ قال لثابتٍ","أنَبقى بلا مالٍ فَنَشقَى ونتلَفُ",57,"ف",1,0],["فَلَمّا تَناهَت وَهيَ عَجلى كَأَنَّها","عَلى حرفِ سَيفٍ حَدُّهُ غَيرُ مُصفَحِ",58,"ح",1,0],["فَلَمَّا تَقَضَّت أَربَعٌ قُلتُ هاتِيا","جَوادي وَقَلِّدهُ لِجاماً وَمِقوَدا",59,"د",2,0],["فَلَمّا تَجَلّى لَيلُنا وَبَدَت لَنا","كَواكِبُ فَجرٍ بَعدَ ذاكَ مُنِيرِ",60,"ر",1,0],["فَلَمّا تَبَدّى اللَيلُ يَحدو بِنَجمِهِ","لَبِسنا ظَلاماً لَم يَكَد صُبحُهُ يُرى",61,"ر",2,0],["فَلَمّا تَدَلَّت كَالثُدَيِّ وَأَصبَحَت","عَلى القَصَبِ المَعروشِ مُنبَعِثاتِ",62,"ت",1,0],["فلمّا تداركْتُ السُّرادِقَ في الدّجَى","عَشَوْتُ إليْه والمشاعلُ تُرفَع",63,"ع",1,0],["فلمّا تقنَّصْتَ الضّراغِمَ منهُمُ","فلم يبقَ إلاّ كُسعةٌ خلفهم تعدو",64,"د",2,0],["فَلَمّا تَمادى هَجرُها قُلتُ واصِلي","فَقالَت بِهَذا الوَجهَ تَرجو الهَوى عِندي",65,"د",2,0],["فَلَمّا تَوَجّى خَصرَها فاحَ ريحُها","فَقُلتُ أَذا عِطرٌ فَقالَ هُوَ العِطرُ",66,"ر",1,0],["فَلَمّا تَواصَلنا تَوَسَّطتُ لُجَّةً","غَرِقتُ بِها يا قَومُ مِن لُجَجِ البَحرِ",67,"ر",1,0],["فَلَمّا تَلاقَينا رَأيتُ أَكُفُّنا","قِصاراً وَقِدماً كُنَّ غَيرَ قِصارِ",68,"ر",1,0],["فَلَمّا تَوَفّى اللَيلُ جُنحاً مِنَ الدُجى","تَصابَيتُ وَاستَجمَلتُ غَيرَ جَميلِ",69,"ل",1,0],["فَلَمّا تَوَلّى الحَرُّ وَاِعتَصَرَ الثَرى","لَظى الصَيفِ مِن نَجمٍ تَوَقَّدَ لاهِبُه",70,"ب",2,0],["فَلَمّا تَدَلّى في السَرِيِّ وَغَرَّهُ","غَليلُ الحَشا مِن قانِصٍ لا يُواثِبُه",70,"ب",2,0],["فَلَمّا تَوَفّى العَقلَ إِلّا أَقَلَّهُ","وَجارَت بِهِ نَفسٌ عَنِ الحَقِّ جائِرَه",71,"ر",2,0],["فلمّا تجلّى الأمرُ قالوا تمَنّياً","ألا لَيْتَ أنّا في التّرابِ رِمامُ",72,"م",1,0],["فَلَماَّ تَخَيَّمنَ تَحتَ الأَرا","كِ والأثلِ مِن بَلَدٍ طيّبِ",73,"ب",1,0],["فلما تناهت نفسه من طعامهم","وأمسى طليحا ما يعانيه باطل",74,"ل",1,0],["فَلما تفرقنا شكوت كَما شكَت","شقاء أَليماً ثم شملاً مبددا",75,"د",2,0],["فَلمّا تبينتُ الَّذي لم أَظنه","ضربت كمن يستاء كفاً عَلى كف",76,"ف",1,0],["فَلَمَّا تَلَبَّسَ مَا بَيْنَنَا","لَبِسْتُ لَهَا مِنْ حِبَالي حِبَالاَ",77,"ل",2,0],["فلمّا تَعاشَرْنا ثَلاثاً وأرْبَعاً","وأيْقَنَ مِن صَدْري بحُسْنِ وِداد",78,"د",1,0],["فَلَما تَحَولنا عَفاريت جنةٍ","تحول شؤبوبُ الغَمام رجوما",79,"م",2,0],["فَلَمَّا تَولَّى وَطَّدَ اللّهُ بَيْتهُ","بِأَعْقابِ خيْرٍ شرفوا البَيْتَ وَالنجْرا",80,"ر",2,0],["فلمّا تَلاَقَيْنَا وَدَارَتْ بنَا الرَّحى","وليسَ لأمرٍ حَمَّهُ اللهُ مَدفَعُ",81,"ع",1,0],["فَلَمّا تَوَفَّتكَ المَلائِكُ طيّباً","وَقالوا سَلامٌ سِر إِلى اللَهِ تزلفِ",82,"ف",1,0],["فَلَمَّا تَلاقَينا وجَدتُ بَنانَها","مُخَضّبَةً تَحكى الشَوَاعِلَ بِالشُّعَل",83,"ل",1,0],["فلمّا تبلجَ ما حولهُ","أناخَ فَشَنّ عَلَيهِ الشّليلا",84,"ل",2,0],["فلما تق