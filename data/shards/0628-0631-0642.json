ate.com/ViewPoem.aspx?id=156535",""],[6093,"يوماً وقفتُ بسَفْحِ الرِّيمِ مُخْتار (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=175996",""],[406,"مليون توقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63261&r=&rc=71",""],[572,"لا وَعينٌ تُدِيرُ باللّحظِ خمرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9314&r=&rc=171",""]],"verses":[["بَرَقتَ بِالوَعدِ في دُجى أَمَلي","وَالغَيثُ لا يُقتَضى إِذا بَرَقا",0,"ق",2,1],["بَرقٌ كَخَفقِ جَناحِ المَضرَحِيَّ إِذا","جَلّى الطَرائِدَ مِن وَمضٍ وَتِلماعِ",1,"ع",1,0],["بَرقاً يُضيءُ عَلى أَجزاعِ مَسقِطِهِ","وَبِالخَبِيَّةِ مِنهُ عارِضٌ هَطِلُ",2,"ل",1,0],["بَرقٌ تَجاسَرَ مِن خَفّانَ لامِعُهُ","يَقضي اللُبانَةَ مِن قَلبي وَيَنصَرِفُ",3,"ف",1,0],["بِرَقمٍ وَوَشىٍ كَما زُخرِفَت","بِميشَمِها المُزدَهاةُ الهَدِيُّ",4,"ي",1,0],["بَرَقتِ بِعارِضَيكِ وَلَم تَجودي","وَلَم يَكُ ذاكِ مِن نُعمى ثَوابا",5,"ب",2,0],["بِرَقيقَةِ الأَلفاظِ تَح","كي الدَمعَ إِلّا في المَذاقِ",6,"ق",1,0],["برق ورعد قاصف","كرحىً تلح فتستمى",7,"م",2,0],["بَرقُ الفَجيعَةِ لَمّا ثارَ ثائِرُهُ","كادَت كَأَمسٍ لَهُ الأَحزابُ تَتَّحِدُ",8,"د",1,0],["بَرقٌ جَوائِبُهُ صَواعِقُ كُلُّها","وَمِنَ البُروقِ صَواعِقٌ وَغَمامُ",9,"م",1,0],["بَرْقٌ يلوحُ بنجدٍ والحِمى وطني","يهفو بلبِّي وقلبي كلما عَرَضَا",10,"ض",2,0],["بَرقٌ بِذي سَلَمٍ يُؤَرِّقُني","خَفَقانُهُ وَتَشوقُني لُمَعُه",11,"ع",2,0],["بَرَقَت مَخايِلُهُ لَها وَتَخَرَّقَت","فيها عَزالى جودِهِ تَخريقا",12,"ق",2,0],["بَرقٌ سَرى في بَطنِ وَجرَةَ فَاِهتَدَت","بِسَناهُ أَعناقُ الرِكابِ الضُلَّلِ",13,"ل",1,0],["بَرقٌ أَضاءَ العَقيقُ مِن ضَرمِهِ","يُكَشِّفُ اللَيلَ عَن دُجى ظُلَمِه",14,"م",2,1],["بَرَقُ المَشيبِ قَد أَضا","بِعارِضٍ مِثلِ الأَضا",15,"ا",1,1],["بَرَقَت بَوارِقُ مِن يَمينِكَ غادَرَت","وَضَحاً بِوَجهِ الخَطبِ وَهوَ بَهيمُ",16,"م",1,0],["بَرقٌ إِذا بَرقُ غَيثٍ باتَ مُختَطِفاً","لِلطَرفِ أَصبَحَ لِلأَعناقِ مُختَطِفا",17,"ف",2,0],["برق بأنباءِ الأحبّة سارِ","صَدعَ القُلوبَ وطار بالأبصارِ",18,"ر",1,1],["بَرقَتْ له مسنونةً تتلهَّبُ","أمضى من القَدرِ المتاح وأغلبُ",19,"ب",1,1],["بَرَقَت لي حَتّى إِذا قُلتُ جادَت","أَقلَعَت عَن جَهامَةٍ لا تَدُرُّ",20,"ر",1,0],["بَرَقَت فيهُمُ السَماءُ فَكَلَّف","تُ صِحابي وَاللَيلُ مُلقي السُتورِ",21,"ر",1,0],["برقِيقٍ مِثْلِ الشّقيقِ مِن البَرْ","قِ تَعَادَتْ فيه الصّياقِلُ غِيرا",22,"ر",2,0],["بِرِقَّةِ الْجُودِ اسْتَرَقُّوا النُّهَى","وَالْجُودُ مَنْ يُعْطِي وَمَنْ يَسْتُرُ",23,"ر",1,0],["بَرقُ الأَماني خُلَّبٌ كَم","يَغُرُّنا وَعدُها الكَذوبُ",24,"ب",1,0],["بَرْقٌ تَحَاسَرَ من خَفَّانَ لامِعُهُ","يقضي اللُّبانة َ منْ قلبي وينصرفُ",25,"ف",1,0],["برق بأنباء الأحبة سار","صدق القلوب وطار بالأبصار",26,"ر",1,1],["بَرقٌ أضا من أيمن الجَرْعاء","غيثاً مُلِثاً دائمَ الأنواءِ",27,"ا",2,1],["بَرقٌ بَدا ثُمَّ وَلَّى نازِفاً مَطراً","سالَت بِهِ عَبرَةٌ لي طابَ هاميها",28,"ي",3,0],["برقٌ تَاَلَّق من نَعْمانَ معترضا","أَهاجَ بينَ ضلوعي عارِضا عَرَضا",29,"ض",2,1],["برقاً تلألأَ غوْريَاً جلستُ له","ذاتَ العشاءِ وأصحابي بأفْنادِ",30,"د",1,0],["برقٌ رجوتُ به غيثاً زرعتُ له","بين الحشا طمعاً قد صار لي أسفا",31,"ف",2,0],["بَرْقٌ تبَدَّى خِفية بسَنَاء","سَحَراً يَعُطُّ جلاببَ الظَّلْمَاءِ",32,"ا",2,1],["بِرِقاقِ بيضٍ في الدِماءِ نَواهِلٍ","وَعِتاقِ جُردٍ في الشَكيمِ صِيامِ",33,"م",1,0],["بَرَقَت لِقَتلِ المُستَها","مِ لَها سَوالِفُ كَالسُيوفِ",34,"ف",1,0],["برقادك ليس الخير يجي","قم نحو حماه وابتهجِ",35,"ج",1,0],["برقة قد غدا في حوز قبضتها","الرقي طوعاً وبالطبع الحويزي",36,"ي",1,0],["برقَ الأنسُ في تبسُّمِ أُنثى","منهُ سعدٌ وقوةٌ ورجاء",37,"ا",2,0],["بَرقٌ يَمانٍ لي تَأَلَّقَ بِالمُنى","وَلَقَد عَهِدناهُ زَماناً خُلَّبا",38,"ب",2,0],["بَرقُ أَساريرِ مُحَيّاهُ مَتى","ما لاحَ غَيرُ خلَّبٍ لِمَن رَغِب",39,"ب",1,0],["برقُ الحِمى لاحَ مُجتازاً على الكثُب","وَراحَ يَسحبُ أَذيالاً مِن السُحبِ",40,"ب",1,1],["بَرقُ فِكري كلّما لاحَ هَمى","مِقوَلي بِالعارض المنبجسِ",41,"س",1,0],["برقٌ بِهِ أفقُ الرجاءِ أنارا","فَهَدى أماني يَعتِسفن حيارى",42,"ر",2,1],["بَرقَ اِنتِصارِ تَحَدّاهُم بِخَلبِهِ","وَإِذ لَقوا المَوتَ نَشاباً بِمَنخلَبِهِ",43,"ه",1,0],["برقُ الكَرى أَهدى لِعَيني الأَبرَقا","بِضِيائِهِ فَأَعادَ أَعيادَ اللِقا",44,"ق",2,1],["بَرْقُ الغمائمِ والمبَاسمِ لم يَكَدْ","أن يُوِمضا إلا وأنت مَغيث",45,"ث",1,0],["بَرق البَخيل وَإِن تَأَلَّقَ خلَّبٌ","وَودادهُ وادٍ بِغَير نَسيم",46,"م",1,0],["بَرق سَريع خَفقهُ","فَكَأَنَّهُ نَبض المَريض",47,"ض",1,0],["بَرقٌ بَدا جَنح الدُجى يَتَأَلَقُ","حَتّى أَضاءَ لَهُ الغَضا وَالإِبرقُ",48,"ق",1,1],["برقٌ تألّق مَوهناً لمعانه","فأَبّاحَ من سرِّ الغرام مَصونَهُ",49,"ه",1,0],["برقٌ تهلَّلَ فِي المزنِ الهَتُونِ كَأَنْ","من وجهِهِ ضاءَ أَوْ عَنْ كَفِّهِ سَمَحا",50,"ح",2,0],["بَرَقَتْ عَلَى الأَعْدَاءِ غَيْرَ خَوَالِبٍ","فِي عارِضٍ لِلْمَوْتِ غَيْرِ جَهامِ",51,"م",1,0],["بَرْقٌ أضيفَ إلى سحابِ أناملٍ","والبرق لولا سُحبهُ لم يلمعِ",52,"ع",1,0],["برقٌ تألَّق مِن تِهامَه","صَدَعَ القلوبَ المُستهامَهْ",53,"م",2,1],["برقٌ على الجِزعِ بدا يلمعُ","حَنَّتْ اليهِ الاِبِلُ الضُّلَّعُ",54,"ع",1,1],["برق الربيع لنا برونق مائه","فانظر لروعةِ أرضه وسمائهِ",55,"ا",3,1],["برقيقات معاني الكائنات","واختلاجات قلوب المؤمنين",56,"ن",1,0],["بَرقُ نُعمانَ عَلى الهائِمِ طَل","فَنَفَى عَن جِسمِهِ كُلَّ العِلَل",57,"ل",1,1],["برَقيقٍ من الشُّهودِ أَنيقٍ","غيرَ مُسْتَظْهِرٍ بقَيْسٍ وطَيِّ",58,"ي",1,0],["بِرَقيقِ عِطْرٍ زارَنا من حالِكُمْ","يا سادَتي هلْ يَخْطُرَنَّ بِبالِكُمْ",59,"م",1,0],["برَقيقِ رمزٍ للقُلوبِ نَسَجْتَهُ","فطَوى بها سِرَّ الغُيوبِ مُهَيْمِنَا",60,"ن",2,0],["برقْراقِ دمعٍ سلسلَتْهُ عُيونُهُمْ","عُيوناً وما اسْطاعوا لإفْشائِها كَتْمَا",61,"م",2,0],["بَرْقُ حِماهُمْ يَنْجَلي","يا عينُ لا تحوَّلي",62,"ل",2,1],["بَرْقُ حَبيبي بَرَقا","ولِفُؤادي انْطَلَقا",63,"ق",2,1],["بَرْقُ وهمٍ في سَمواتِ الهَوَى","لاحَ للشُّطَّاحِ لكن هو خُلَّبْ",64,"ب",1,0],["برق يذكرني وميض مباسم","يسري الهوى في ضوئها المتألق",65,"ق",1,0],["برقٌ أضا وبطنا","ثم أضا وبطنا",66,"ن",2,0],["برقع الظلمة والنور لمن","كان مأموماً ومن كان إماما",67,"م",2,0],["برقٌ من القهوة لمَّاعُ","بها من الأكوان دارت رحى",68,"ا",1,0],["بِرَقرَقانِ آلِها المَسجورِ","سَبائِباً كَسَرَقِ الحَريرِ",69,"ر",1,0],["بَرْقٌ سَرَى مِن غيرِ رَعدٍ مُخبراً","مَعَ صمتِهِ بأقلَّ مِن لمحِ البَصَرْ",70,"ر",1,0],["برقُ المُنى خُلَّبٌ إلا أقلَّ حِبَىً","تَقِرُّ عَينٌ ب