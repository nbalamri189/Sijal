{"poems":[[79,"باتت نجوم الأفق دون علاكا","https://www.aldiwan.net/poem36385.html","الكامل"],[53,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[53,"قل للأمير أدام الله نعماكا","https://www.aldiwan.net/poem65761.html","البسيط"],[87,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[87,"المشرقان عليك ينتحبان","https://www.aldiwan.net/poem8188.html","الكامل"],[87,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[71,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[41,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[48,"أما القيامة فالتنازع شائع","https://www.aldiwan.net/poem22577.html","الكامل"],[48,"ما بالها ناوية شقة","https://www.aldiwan.net/poem23616.html","السريع"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147507","البسيط"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9981","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54882","الكامل"],[92,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[97,"عروس المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=745&r=&rc=23",""],[87,"أنْدَلُسِيَّة ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9527&r=&rc=17",""],[131,"لم تأخذون سلاحه لقتاله","https://www.aldiwan.net/poem24273.html","الكامل"],[137,"ببسيط العالم تعتضد","https://www.aldiwan.net/poem4239.html","المتدارك"],[164,"سود العيون أم المواضي البيض","https://www.aldiwan.net/poem58917.html","الكامل"],[186,"رقص الهزار على الغصون الميس","https://www.aldiwan.net/poem67056.html","الكامل"],[190,"لمت الغواني في العدو","https://www.aldiwan.net/poem43441.html","مجزوء الكامل"],[211,"لم تأخذون سلاحه لقتاله","https://www.aldiwan.net/poem27870.html","الكامل"],[230,"لا القوم قومي ولا الأعوان أعواني","https://www.aldiwan.net/poem55113.html","البسيط"],[287,"تظلموا وهم عقوا وهم ظلموا","https://www.aldiwan.net/poem32460.html","البسيط"],[303,"إن كان باليمن هذا اليوم قد سنحا","https://www.aldiwan.net/poem36252.html","عموديه"],[303,"يفنى الزمان وذكره يتجدد","https://www.aldiwan.net/poem36263.html","عموديه"],[457,"لو أن بيضة زاغ راح يحضنها","https://www.aldiwan.net/poem13955.html","البسيط"],[463,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[463,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[463,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[463,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[470,"من لي ببغداد","https://www.aldiwan.net/poem36225.html","عموديه"],[498,"لمت الزمان على تأخير مطلبي","https://www.aldiwan.net/poem67377.html","البسيط"],[520,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[556,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[556,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[572,"وطيب أهدى لنا طيبا","https://www.aldiwan.net/poem69460.html","السريع"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48764","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48752","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64242","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64026","الكامل"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18483","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95498","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95551","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95535","البسيط"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35803","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26482","البسيط"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106709","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47125","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47104","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105013","الكامل"],[2320,"","https://poetry.dctabudhabi.ae/diwan/poem/144652","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106910","الكامل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87744","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93863","البسيط"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101627","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87360","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126940","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86509","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35509","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94391","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81930","الكامل"],[4463,"","https://poetry.dctabudhabi.ae/diwan/poem/144938","البسيط"],[4929,"جزء من قصيدة ملحمة النبوة","https://www.poetsgate.com/ViewPoem.aspx?id=199886",""],[5062,"امرؤ القيس","https://www.poetsgate.com/ViewPoem.aspx?id=20951",""],[5092,"غادرتُ بعضي","https://www.poetsgate.com/ViewPoem.aspx?id=176225",""],[5183,"النفََّسُ الطَّيِّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=185959",""],[5249,"هذا هو المجد من يعلقه لم ينم","https://www.poetsgate.com/ViewPoem.aspx?id=124961",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5363,"رثاء الشيخ البروفسور إبراهيم الكندي","https://www.poetsgate.com/ViewPoem.aspx?id=199950",""],[5376,"هل أنشدُ الدارَ قحطاناً وعدنانا.","https://www.poetsgate.com/ViewPoem.aspx?id=188463",""],[5376,"كأنَّ في القدسِ خلانٌ بلا وطنِ","https://www.poetsgate.com/ViewPoem.aspx?id=189993",""],[3294,"عجبا لقوم مسلمين بزعمهم","https://www.poetsgate.com/ViewPoem.aspx?id=173277",""],[5495,"بده العام الدراسي (مرثيه لولده حيدر)","https://www.poetsgate.com/ViewPoem.aspx?id=175440",""],[5691,"أسير الذئب","https://www.poetsgate.com/ViewPoem.aspx?id=205764",""],[4623,"ماذا يضرك لو تركت ملامي ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146686",""],[5956,"الحمد لله حمداً لا يفارقني","https://www.poetsgate.com/ViewPoem.aspx?id=193794",""],[6031,"لو أنَّ لي بانْبعاثِ الرِّيحِ نحوَكُمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46370",""],[6082,"لطفا كفى","https://www.poetsgate.com/ViewPoem.aspx?id=60250",""],[463,"هل عند عينيك على غربِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59971&r=&rc=27",""]],"verses":[["لَمْ تَأَلُ فِي حِفْظِ الرَّعَايَا جَاهِداً","وَمُرَاقِباً فِيهَا مَنِ اسْتَرْعَاكَا",0,"ك",2,0],["لم تأل في تقديم مالك غائظاً","لمسابق لم تأل في تخليفه",1,"ف",2,0],["لم تأتِ مأتاك في تعظيم قدرهما","من بابِ دينك بل من بابِ دنياكا",2,"ك",2,0],["لم تأت كيف رأيتمو تحصيلها","هذا لعمري البغي في الغايات",3,"ت",1,0],["لَم تَألُها عِندَ الشَدائِدِ خِدمَةً","في اللَهِ وَالمُختارِ وَالسُلطانِ",4,"ن",1,0],["لَم تَألُ ماءَكَ تَحناناً وَلا ظَمَأً","وَلا اِدِّكاراً وَلا شَجوا أَفانينا",5,"ن",2,0],["لمْ تألُ نصحاً نفوساً كذَّبتْ وعتَتْ","لكنْ سمحْتَ بما ينكرن منْ دررِ",6,"ر",1,0],["لَم تَأكُلِ الفَثَّ وَالدُعاعَ وَلَم","تَنقُف هَبيداً يَجنيهِ مُهتَدُه",7,"د",2,0],["لَم تَأتِ آصالي بِما أَنا شاكِرٌ","مِنها فَتَفعَلَ مِثلَهُ الأَسحارُ",8,"ر",1,0],["لَم تَأوِ لِلعيسِ وَلا بُّدَّ مِن","قَبرٍ إِلَيهِ أَوَت الآوِيَه",9,"و",3,0],["لم تأتنا منكم رسل مخبرة","ولا كتاب إلينا منكم وصلا",10,"ل",2,0],["لَمُتُ أَسىً وَكَم أَشكو لِأَنّي","أَغارُ عَلَيكِ يا بَدرَ التَمامِ",11,"م",1,0],["لَمْ تَأْلُ حِينَ حَدَتْكَ آمَالُ العُلى","أَلاَّ تُجِيبَ دَعَاءَ طِيبِ العُنْصُرِ",12,"ر",1,0],["لم تأتِني من بليغِ القولِ قافيةٌ","إلا وأبلغُ منها عندَه شِيمَ",13,"م",1,0],["لمّتِ الآمالُ منّا شملنا","ونمتْ ما بيننا من نسبِ",14,"ب",1,0],["لم تأل ماءك تحنانا ولا ظلماً","ولا أدكارا ، ولا شجوا أفانينا",15,"ن",2,0],["لِم تَأخُذونَ سِلاحَهُ لِقِتالِهِ","وَلذاكُمُ عِندَ الإِلَهِ إِثامُ",16,"م",1,1],["لم تأتِ بمشبهكَ الأيا","مُ ولا ولدتُه ولا تلدُ",17,"د",1,0],["لمتُ الزمانَ فلامني من لامني","وأبان عن تصريحه التعريضُ",18,"ض",1,0],["لَم تَأخُذِ الغَفلاتُ مِنهُ مُقلةً","سَهِرَت لَتَنبيهِ العُيون النُّعَّسِ",19,"س",1,0],["لمت الغواني في العدو","ل إلى الشباب ملام عاذل",20,"ل",1,1],["لِمَ تَأخُذونَ سِلاحَهُ لِقِتالِهِ","وَلَكُم بِهِ عِندَ الإِلَهِ أَثامُ",21,"م",1,1],["لَم تَأمَن الشَمس وهي الشَمسُ ما خَبَأَت","لها المَقاديرُ في طيِّ الأَحايينِ",22,"ن",1,0],["لَم تَألُ تَدرَأُ عَنهُم كُلَّ مُعضِلَةٍ","وَلَيسَ يُنكِرُ ذا عُرب وَلا عَجَمُ",23,"م",1,0],["لمتُ (الخوارج) حيناً في تآمرهم","عَلَى اغتيال (عليٍّ) واللذين لحا",24,"ح",2,0],["لَمْ تأْلفِ الأَيّامُ صحبةَ غيرِه","أَمسِ البعيدُ ويومُنا ذا والغد",25,"د",1,0],["لم تأتِ إِلاّ بزاغٍ وهي صاغرة","وذلك الأصلُ لا ينفكُّ يَلْزَمُها",26,"م",3,0],["لمتُ أيّامي على الغدرِ فقد","زادت الإجرامَ حتى لا مَلاما",27,"م",2,0],["لم تأكل الأيام وفرِي عسلاً","إلا رأت مُضغةَ لحمي علقما",28,"م",2,0],["لم تأتِ نِعمتُه برزقٍ غالطٍ","ضلَّ الطريقَ ولا بحظٍّ جاهلِ",29,"ل",1,0],["لم تألف البيداءُ قبل جُنونها","من ذات خُفٍّ أو تطيرَ بأربعِ",30,"ع",1,0],["لم تَألُ تَجأرُ دَبَّاباتُهُم هَلَعا ً","في أرضِها وهيَ وَطْفاءُ الدَّواوين ِ",31,"ن",1,0],["لُمتُ الزَمانَ عَلى تَأخيرِ مُطَّلَبي","فَقالَ ما وَجهُ لَومي وَهُوَ مَحظورُ",32,"ر",1,1],["لمت الزمان فلم تزل أقدامه","حتى غفرت به ذنوب لئامه",33,"م",2,0],["لِمْ تأسفين على المحبِّ بقُبلَةٍ","فكأنّ ثغراً منك غيرُ بَرودِ",34,"د",1,0],["لم تألفِ السُّوءَ ولا بتَّ في","ناحيةِ القذفِ ولا الثَّلْبِ",35,"ب",1,0],["لَمْ تَأْتِنَا حَتَّى أَتَتْنَا لَهُ","رَوَائِحٌ تُغْنِي عَنِ النَّدِّ",36,"د",1,0],["لم تأب يوماً مصر من ذي قوة","عهد الحليف وأنها لا تخدع",37,"ع",1,0],["لم تألفوا أن ناسا في مساومة","من بين ما يأخذ الباغي وما يهب",38,"ب",1,0],["لم تأبى إن تستشف يدُ الأل","حاظ ديباجَ خدكَ الخسرواني",39,"ن",2,0],["لم تألُ أن راغتْ بعهدكمُ النوى","لا درَّ درُّ نواكُم ما أرْوَغا",40,"غ",2,0],["لم تأتِهِ العيسُ حتى كدتُ أتركُها","ولا طم الضفرُ في أحقابها الحقبا",41,"ب",2,0],["لم تألُ جهداً أو تَدَع أمَلاً","إلا بذَلت وحّك النصرُ",42,"ر",1,0],["لم تأل جهدك فى الأخلاق فاضلة","تسمو بعفتك المثلى وبالشممِ",43,"م",1,0],["لم تألُ جهدَك في ودّ ومكرمةِ","تأسو جراح الأُلى لاذُوا بناديكا",44,"ك",2,0],["لَمَّت الشَعثَ مِن سُعادَ وَمِنّا","رُسلٌ بَينَنا مِنَ الأَحلامِ",45,"م",1,0],["لم تأتِ من قبل ظلما","عذَّبتَ قلبي شديداً",46,"د",2,0],["لَم تَأتِ مِنهُ اليَمينُ شَيئاً","إِلّا أَتَت مِثلَهُ اليَسارُ",47,"ر",1,0],["لم تأبَ سُؤددهُم أُباةُ رَبيعةٍ","بِكرٌ وتغلِبُ ذُهلُها وَجُشُومُهَا",48,"م",3,0],["لم تَأْلُ في صَوْمٍ وفي ذكرٍ وفي","صَدَقاتِها رِيُّ الفؤاد الصّادي",49,"د",2,0],["لم تَأْلُ في سَوْقِ الخِيَار إلى الرّدى","يا ليت شعري هل بذا أكرمتَه",50,"ت",2,0],["لم تألُ جهدك بالجهاد كأنّما","خوطبتَ وحدك دوننا بأدائه",51,"ا",3,0],["لم تأتيه الأزد عند الباب تربصه","مثل الجراد تنزى في التبابين",52,"ن",1,0],["لم تأت معليةً مقامَك أنه","من قبلها بين البرية عالِ",53,"ل",1,1],["لَم تَألُ ضَيفان الغَدير حَفاوَةً","وَقَرى مِن الأَمواه وَالأَزواده",54,"د",2,0],["لمت المحب على ترويح مهجته","رح واسترح وأرح من ريحك السمج",55,"ج",1,0],["لم تأل في وادي الملوك منقباً","في سفح قمته ورأسه هضابه",56,"ب",2,0],["لَم تأتِنا صُمُّ الصخورِ بجوهرٍ","الا على برد الزَمان وَشمسِهِ",57,"س",2,0],["لم تأمن الناس من فتك الوباء بها","حتى استجارت بحامى الجار اشتاتا",58,"ت",2,1],["لم تأتنا أنباؤهم إلا وقد","نضحت مهارق من عبير فخار",59,"ر",1,0],["لَم تَألُ تَدأبُ في المَكارِمِ وَالعُلا","مُتَوقِّلا هَضَباتها مُتَدرِّجا",60,"ج",2,0],["لَم تأتِ سكراً وهو في أجفانها","حوراءُ خَلقاً لا تلافي مِروَدا",61,"د",2,0],["لم تأتِ ألسنة الرواة بمثلها","أبداً ولم تسمح قريحة شاعر",62,"ر",1,0],["لم تأتياني وبي نهوض","إلى حلال ولا حرام",63,"م",1,0],["لم تأل حادثةُ الأسراء سخريةً","كفارُ مكةَ بل زادوا دجى وعمى",64,"م",2,0],["لم تأت موعدها ولا بعثت","في صدر طارقها ولو خبرا",65,"ر",2,0],["لمْ تأتِ يومًا إلا بغاويةٍ","أغويتُها زُهْدًا رحتُ أهملُها",66,"ل",3,0],["(( لم تأتِ إلا بشذا نشرها","أولا فماذا النفس الطيب))",67,"ب",1,0],["لم تألُ جهدا لتلوي من كتائبه","فسار عنها كمياً غير منهزمِ",68,"م",1,0],["لم تألها عند المصاعب جهد صل","ب ثابت ولقد قهرت الشاني",69,"ن",2,0],["لم تأخذ اللذاتِ منه وإنما","صعدتْ به خير الحياةِ منازلا",70,"ل",2,0],["لم تأل جهداً وما ذا الذلِّ يسعفُها","والخوفُ يسكنُها والنارُ تصلانا",71,"ن",2,0],["لم تألفِ البعدَ يوماً عند نازلةٍ","بالحبِّ غاديةٌ تبكي من الشجنِ",72,"ن",1,0],["لم تأت في هذه المقابر آية","تتلى ولا نص ولا اعلام",73,"م",1,0],["لمت الروح بس شفادني اللوم","شلحك ! وبسفينة الموت عابر",74,"ر",1,0],["لمْ تَأْنَسوا بالعقْلِ قبْلَ وُقوعِها","جَرْياً وَراءَ سَرابِها المَكْذوبِ",75,"ب",1,0],["لم تال جهدا في الذي تدعوا له","متحملا لاذاية الأقوام",76,"م",1,0],["لم تأتنا بركاتٌ من أخ أبداً","أو أيِّ شهم كما منه محتْ مِحَني",77,"ن",2,0],["لَمْ تأتِكُمْ نَسْمَةٌ إلاَّ وكاهِلُهَا","ينُوءُ ثِقْلاً بأَعْبَاءِ التَحِيَّاتِ",78,"ت",1,0],["لم تأتني كالنجم يلمع صادقا","يل جئت في ثوب الخداع مُغلّفا",79,"ف",2,0],["لم تألفِ الأبصارُ من قبلها","أن تطلعَ الشمسُ من المغربِ",80,"ب",1,0]]}