7",""],[6355,"حصاد الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66593&r=&rc=53",""]],"verses":[["فأنْزَلْتَ غيْثاً منْ سَماءِ عَجاجَةٍ","تُرَى دَلْوَها شُهْبَ الأسِنّةِ تَقْذِفُ",0,"ف",1,0],["فَأَنزَلَني مُنزَلاً طَيِّباً","وَرَوّى فُؤادِيَ حَتّى اِرتَوى",1,"ا",1,0],["فَأَنزِلوني مَكاناً أَستَجِمُّ بِهِ","وَيَنجَلي عَن فُؤادي بَرحُ أَحزاني",2,"ن",2,0],["فَإِنْ زِينَتْ لَنَا الأَقْوَالُ عِفْنَا","تَعاطِيهَا كَمَاكِرَةِ المُدَامِ",3,"م",1,0],["فَإِن زِدتَني بِرّاً تَزَيَّدتُ جَفوَةً","فَلا نَلتَقي طولَ الحَياةِ إِلى الحَشرِ",4,"ر",1,0],["فَأَنزَلَ رَبّي لِلنَبِيِّ جُنودَهُ","وَأَيَّدَهُ بِالنَصرِ في كُلِّ مَشهَدِ",5,"د",1,0],["فَأَنزَلوهُ بِدارٍ لا يَخافُ بِها","مَن كانَ جارَهُمُ داراً هِيَ الدارُ",6,"ر",1,0],["فأنزل الحاضرون من سبق","وعاد ذاك الطهور تنجيسا",7,"س",2,0],["فإن زوى عني الجُمَّار طلعته","فلا يصبني بحدي شوكه السعف",8,"ف",1,0],["فانزعوا من أرضكم خط الحديد","واقطعوا أسلاك برق لا تفيد",9,"د",1,0],["فَاِنزِلا في عُيونِ نَرجِسِها الغَضِّ","صِياناً وَفَوقَ خَدِّ الشَقيقِ",10,"ق",1,0],["فَاِنزِلِ التاريخَ قَبراً أَو فَنَم","في الثَرى غُفلاً كَبَعضِ الهامِدين",11,"ن",1,0],["فَأَنزَلَ اللَهُ بِهِ نِقمَةً","غَيَّرَتِ النِعمَةَ مِن حالِهِ",12,"ل",2,0],["فَأَنزَلَهُنَّ الضَربُ وَالطَعنُ بِالقَنا","وَبيضٌ بِأَيمانِ المُغيرَةِ تَجرَحُ",13,"ح",1,0],["فَأُنزِلَ جِبريلَ في قَتلِهِ","بِوَحيٍ إِلى عَبدِهِ المُلطِفِ",14,"ف",1,0],["فَإِن زُرتَ مَغنانا تَكُن أَنتَ أَوَّلاً","وَعَبدُكَ ثانيها وَشادٍ وَشادِنُ",15,"ن",1,0],["فَانزَوَتْ بِالشَّهيقِ خَوفاً وَظَنَّتْ","حَبَّ رُمَّانِ صَدرِها قد تَنَثَّر",16,"ر",1,0],["فإنْ زُمَرُ الأحزابِ راموا امتحانَهُ","سبى ليلَ فرقانِ المجادلةِ النصرُ",17,"ر",1,0],["فَأنزلَهُ في دارِهِ وأحلَّهُ","مَحلاً تَمنَّى مِثلَهُ كلُّ قادمِ",18,"م",1,0],["فأَنْزَلَ اللهُ أَمْلاكاً مُسَوَّمَة","لَبُوسُها مِنْ سَكِيناتٍ سَرابِيلُ",19,"ل",1,0],["فَأَنزَلتُ حاجاتي بِحَقوَي مُساعِدٍ","وَإِن كانَ أَدنى صاحِبٍ وَدَخيلِ",20,"ل",1,0],["فأَنزلَ الناسَ إلى البَسيطِ","وقَطَّعَ البَيْنَ منَ الخَليطِ",21,"ط",1,0],["فإن زليخا كلما بصرت بها","أحست بنار في الجوانح تسعر",22,"ر",1,0],["فإنْ زَعَموا أنّ الهَجِيرَ اسْتَشَفّهُمْ","إليها فمِنْها في المَزايِدِ أسْمال",23,"ل",1,0],["فَإِنْ زَادَنِي هَجْرَاً ضَرَبْتُ عَنِ اسْمِهِ","وَأَمْسَكْتُ عَنْ سُخْطِي عَلَيْهِ وَعَنْ شُكْرِي",24,"ر",2,0],["فأنزل الجور قبرا وابتنى زمنا","عدلا ... تدبّره أفكار أحرار",25,"ر",1,0],["فَانزلهُ مِن ناديك أَشرَف مَنزل","وَأَلبسهُ حلياً مِن قَريض منظم",26,"م",1,0],["فإن زهو العلا والمجد أن فتى","كمصطفى سلبته الغيد إدراكا",27,"ك",2,0],["فانزوى الطائرُ الأسيرُ حزيناً","ليته ما رأى ولم يتغنَّ",28,"ن",1,0],["فَأَنزَرُ ما تُعطيهِ يوفي عَلى المُنى","وَأَيسَرُ ما توليهِ يَستَغرِقُ الحَمدا",29,"د",2,0],["فان زوروا في الغيب عني قالةً","فقد زوروها في حضوري ورّوقوا",30,"ق",3,0],["فإنزل بساحته ونل من فضله","ما لا ينال القاعد الكسلان",31,"ن",1,0],["فَإِنَّ زَكاةَ الحُسنِ تَقبيلُ ثَغرِهِ","وَرَشفُ ثَناياهُ وَبَردِ رُضابِهِ",32,"ب",2,0],["فَإِنَّ زَهْرَةَ ذِي الدُّنْيَا وَزِينَتَهَا","وَمَا يَرُوقُ بِهَا أَضْغَاثُ أَحْلَامِ",33,"م",1,0],["فانزل على حكم الوفاء","فأنت مكلو أمين",34,"ن",1,0],["فانزل وأنت رقيقه","لتعود للعلياء راق",35,"ق",1,0],["فانزَع صمامَتَها بمَبزَلِ حاذِقٍ","فالبنتُ للتَّزويجِ لا للمكنَز",36,"ز",1,0],["فانزل بتربته ايما نزلت وَسل","أَهذه طيبة وَالخلق زوار",37,"ر",1,0],["فأَنزلَه في لَيلةِ القَدر جُملَةً","بِعِلمٍ وما أَدراك ما لَيلَةُ القَدرِ",38,"ر",1,0],["فانزعه في عصرِ الصبا طائعاً","من قبل أن ينزعَ بالشيبِ",39,"ب",1,0],["فأنزلت آمالي إذن من فنائكم","بواد سقاه الجود صيب وبله",40,"ل",2,0],["فَأَنزلَني الحِرْمانُ دارَ نَدامةٍ","وَأَنزَلَ أَشعارِي بِدارِ بَوَارِ",41,"ر",1,0],["فَاِنزِل بِها إِن جِئتَ زَوّارَ الحِمى","يا سائِقَ العيسِ فَدَع حَثَّ الإِبِل",42,"ل",1,0],["فَإِن زادَ ماءُ النيلِ فَهوَ مَدامِعي","وَإِن هاجَ وَقدُ القَيظِ فَهوَ ضِرامي",43,"م",2,0],["فأنزَرُ حَظِّي من مواهبهِ الغِنَى","وأيسرُ تخويلي العشيرةُ والرَّهطُ",44,"ط",1,0],["فانزل على سَعَة الوقار ورحبه","في منزل رحب وبيت عامر",45,"ر",1,0],["فانزل بحضرة يونسٍ","تامن به حوت الطريقِ",46,"ق",1,1],["فانزل وسلم على ذاك الغزال وقل","يقريك حبك شوقا كاد يفنيه",47,"ي",2,0],["فأَنزَلَني ولكِنْ عن ذُرَاهُ","وحَيَّانِي ولكنْ بِالنُّباحِ",48,"ح",1,0],["فأنزلوا من القصو","ر العاليات المقصره",49,"ر",2,0],["فأنْزلَ الضَّيْف بخيرِ مَنْزِل","وبَدَّل الجدْب بخصبٍ مُخضِل",50,"ل",1,0],["فَاِنزِل عَنِ الصَحوِ فَما مِشيَةٌ","أَطيبُ مِن هَملَجَةِ السُكرِ",51,"ر",1,0],["فَإِن زُرت لَيلَى بَعد طُولِ تَجَنُّبٍ","تَأَبَّضَ مَنقوصُ اليَدينِ غَيورُ",52,"ر",1,0],["فأنزلن سكينةً علينا","وثبِّت الأقدام إن لاقينا",53,"ن",2,0],["فانزِلْ بنا يا مُريدَ الحقِّ إنَّ لنا","حِمًى أقام رحاباً غيرَ مَهْجورِ",54,"ر",1,0],["فَأَنزَلَ اللَهُ قُرآناً يُبَرِّئُها","وَبَينَ عَوفٍ وَبَينَ اللَهِ ما صَنَعا",55,"ع",2,0],["فانزِعْ إلى دارِ السَّلامةِ في النَّقا","وإذا مَرَرتَ على الحُصَيب فهَرْولِ",56,"ل",1,0],["فإن زعمت أنه كان فعل","ذاك فقد أكذبك الذي نزل",57,"ل",1,0],["فإن زعمت أنه أوصانا","وخلف السنة والقرآنا",57,"ن",2,0],["فإن زعمت أنه كان أمر","أن لا يلي ذلك إلا من حضر",57,"ر",1,0],["فإن زعتم بعدما وصفتم","بأنهم تشاوروا كذبتم",57,"م",1,0],["فإن زعمت أنه سماه","صاحبه الله إذا ارتضاه",57,"ه",1,0],["فإن زعمتم أنه صح الخبر","فغيرهم أراد فيما قد ذكر",57,"ر",1,0],["فإن زعمت أنت أن الكثرة","قد عقدوا بعد النبي الإمرة",57,"ه",1,0],["فأنزل الله ولي النعمة","في ذاك أنه ولي الأمة",57,"ه",1,0],["فإن زعتم أنه كان كنى","في قوله ولم يكن كان عنى",57,"ن",2,0],["فأَنزل الشركَ بدار الرَّدى","وصيَّر الكفرَ ببالِ الوبال",58,"ل",1,0],["فَاِنزِلي في بَني كِنانَةَ تَلقَي","فيهِمُ العِزَّ إِن دَعَوتِ قَريبا",59,"ب",2,0],["فَاِنزِل عَلى سِعَةٍ بِرَحبِ فَنائِهِ","وَاِنظُر مَآثِرَ مَن عَجِبتُ لِشانِهِ",60,"ن",2,0],["فانزَع إلَى تَوديعِ قَلبِكَ إنَّهُ","قَلبٌ يَعِزُّ فِراقُهُ وَلِقاهُ",61,"ا",2,0],["فَأنزَلَهُم صِدقُ الجِلادِ وَبَأسُنا","عَلَى حُكمِنا في غِلظَةِ في التَّحَكُمِ",62,"م",1,0],["فَإِن زَماني قَد صَفا لي بِدَولة","لِتَوفيقها في مَصر رَأيٌ مُسدد",63,"د",1,0],["فَإِن زَعَمتَ أَن ذا مَوجودُ","في زُبُرٍ جاءَ بِها داودُ",64,"د",1,0],["فإن زدتهم زادوا أجفاء وغلظة","سجية فظ فضلوه وعظموا",65,"م",3,0],["فَاِنزَعج المسكين لَما نَظَرَه","أَلوى بِرَأسِهِ وَغَضَّ بَصَرَه",66,"ه",1,0],["فَاِنزَعج الإِثنان مِن مُروره"