{"poems":[[77,"تلافيت نصر الدين إذ كاد يتلف","https://www.aldiwan.net/poem35977.html","الطويل"],[86,"بنادي الجزيرة قف ساعة","https://www.aldiwan.net/poem10950.html","المتقارب"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[93,"إلى مصر أزف عن الشآم","https://www.aldiwan.net/poem11411.html","الوافر"],[54,"هجرتك لم أهجرك من كفر نعمة","https://www.aldiwan.net/poem27399.html","الطويل"],[23,"لقد لعن الرحمن جمعا يقودهم","https://www.aldiwan.net/poem21309.html","الطويل"],[23,"قومي الذين هم آووا نبيهم","https://www.aldiwan.net/poem21570.html","البسيط"],[72,"قام غلام الأمير يحسب في","https://www.aldiwan.net/poem19044.html","المنسرح"],[51,"الدين والعلم والنعماء والشرف","https://www.aldiwan.net/poem65471.html","البسيط"],[85,"لِيعِنا كل معبود معين","https://www.aldiwan.net/poem7767.html","الرمل"],[85,"أيها الكاتب المصور صور","https://www.aldiwan.net/poem63704.html","الخفيف"],[85,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[45,"ما الغيث يهمي صوب إسباله","https://www.aldiwan.net/poem65541.html","السريع"],[28,"تكاثر يربوع عليك ومالك","https://www.aldiwan.net/poem4981.html","الطويل"],[58,"عرفت ومن يعتدل يعرف","https://www.aldiwan.net/poem30961.html","المتقارب"],[66,"تصدق فإنا ذا النهار بخلوة","https://www.aldiwan.net/poem39061.html","الطويل"],[80,"غشيت حجرها دموعي حمرا","https://www.aldiwan.net/poem31463.html","الخفيف"],[69,"علا لك ذكر لا يشابهه ذكر","https://www.aldiwan.net/poem28801.html","الطويل"],[105,"إلى الله فارغب يا عدي بن حاتم","https://www.aldiwan.net/poem44010.html","الطويل"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[48,"وخيمة ناطور برأس منيفة","https://www.aldiwan.net/poem64489.html","الوافر"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42634","الطويل"],[107,"فدا لك روحي من رشا متبرم","https://www.aldiwan.net/poem16245.html","الطويل"],[122,"من رأس بيروت حتى ثغر لرناكا","https://www.aldiwan.net/poem23796.html","البسيط"],[127,"ذكر الطائر الرياض فغنى","https://www.aldiwan.net/poem67452.html","البسيط"],[141,"علي لها أن أحفظ العهد والودا","https://www.aldiwan.net/poem11743.html","الطويل"],[158,"على غيرك البهتان والزور ينفق","https://www.aldiwan.net/poem58945.html","الطويل"],[158,"عجل فقد نوديت يا عجلان","https://www.aldiwan.net/poem59017.html","الكامل"],[167,"أراه الهوى ما لم يكن في حسابه","https://www.aldiwan.net/poem1608.html",""],[235,"عبد السلام ومن عبد السلام إذا","https://www.aldiwan.net/poem19086.html","البسيط"],[259,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[259,"لو لم أطل أمل التلاق","https://www.aldiwan.net/poem38226.html","مجزوء الكامل"],[268,"إن كان وعد الحر دينا أنجز","https://www.aldiwan.net/poem35290.html","الكامل"],[269,"هب النسيم فما ست منه أشجار","https://www.aldiwan.net/poem52074.html","البسيط"],[295,"إذا ما امتطيت الفلك مقتحم البحر","https://www.aldiwan.net/poem33276.html","الطويل"],[301,"يا لابس الغي على غرة","https://www.aldiwan.net/poem58310.html","السريع"],[303,"أمولاي لم يرتد لي الظن غيركم","https://www.aldiwan.net/poem56432.html","الطويل"],[346,"طلبت جوادا فامتدحت مبلدا","https://www.aldiwan.net/poem20359.html","الطويل"],[347,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[364,"كفى حزنا يا طاعنين مقامي","https://www.aldiwan.net/poem17271.html","الطويل"],[406,"ومن علقت بالصالح الملك كفه","https://www.aldiwan.net/poem32218.html","الطويل"],[413,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[426,"فانزل بحضرة يونس","https://www.aldiwan.net/poem40693.html","مجزوء الكامل"],[426,"باح الفؤاد بسر كنت أخفيه","https://www.aldiwan.net/poem41067.html","البسيط"],[429,"يمينك في النوال وفي الكفاح","https://www.aldiwan.net/poem12349.html","الوافر"],[438,"ليتني كنت شجره","https://www.aldiwan.net/poem14371.html","مجزوء الرجز"],[459,"موسع المعروف رحب المنزل","https://www.aldiwan.net/poem16430.html","الرجز"],[466,"الروض في الياقوت والدر","https://www.aldiwan.net/poem60123.html","السريع"],[468,"ألا نولي قبل الفراق قذور","https://www.aldiwan.net/poem4845.html","الطويل"],[498,"والله لولا الله ما اهتدينا","https://www.aldiwan.net/poem37563.html","الرجز"],[498,"قد قام ينفخ داعي الصور في الصور","https://www.aldiwan.net/poem37999.html","البسيط"],[534,"يا عوف ويحك هلا قلت عارفة","https://www.aldiwan.net/poem23858.html","البسيط"],[560,"خلت الديار كأنها لم تؤهل","https://www.aldiwan.net/poem52933.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"ما ضر من أهدى إلي الخيال","https://www.aldiwan.net/poem3039.html","السريع"]],"verses":[["فأنْزَلْتَ غيْثاً منْ سَماءِ عَجاجَةٍ","تُرَى دَلْوَها شُهْبَ الأسِنّةِ تَقْذِفُ",0,"ف",1,0],["فَأَنزَلَني مُنزَلاً طَيِّباً","وَرَوّى فُؤادِيَ حَتّى اِرتَوى",1,"ا",1,0],["فَأَنزِلوني مَكاناً أَستَجِمُّ بِهِ","وَيَنجَلي عَن فُؤادي بَرحُ أَحزاني",2,"ي",1,0],["فَإِنْ زِينَتْ لَنَا الأَقْوَالُ عِفْنَا","تَعاطِيهَا كَمَاكِرَةِ المُدَامِ",3,"م",1,0],["فَإِن زِدتَني بِرّاً تَزَيَّدتُ جَفوَةً","فَلا نَلتَقي طولَ الحَياةِ إِلى الحَشرِ",4,"ر",1,0],["فَأَنزَلَ رَبّي لِلنَبِيِّ جُنودَهُ","وَأَيَّدَهُ بِالنَصرِ في كُلِّ مَشهَدِ",5,"د",1,0],["فَأَنزَلوهُ بِدارٍ لا يَخافُ بِها","مَن كانَ جارَهُمُ داراً هِيَ الدارُ",6,"ر",1,0],["فأنزل الحاضرون من سبق","وعاد ذاك الطهور تنجيسا",7,"س",2,0],["فإن زوى عني الجُمَّار طلعته","فلا يصبني بحدي شوكه السعف",8,"ف",1,0],["فانزعوا من أرضكم خط الحديد","واقطعوا أسلاك برق لا تفيد",9,"د",1,0],["فَاِنزِلا في عُيونِ نَرجِسِها الغَضِّ","صِياناً وَفَوقَ خَدِّ الشَقيقِ",10,"ق",1,0],["فَاِنزِلِ التاريخَ قَبراً أَو فَنَم","في الثَرى غُفلاً كَبَعضِ الهامِدين",11,"ن",1,0],["فَأَنزَلَ اللَهُ بِهِ نِقمَةً","غَيَّرَتِ النِعمَةَ مِن حالِهِ",12,"ل",2,0],["فَأَنزَلَهُنَّ الضَربُ وَالطَعنُ بِالقَنا","وَبيضٌ بِأَيمانِ المُغيرَةِ تَجرَحُ",13,"ح",1,0],["فَأُنزِلَ جِبريلَ في قَتلِهِ","بِوَحيٍ إِلى عَبدِهِ المُلطِفِ",14,"ف",1,0],["فَإِن زُرتَ مَغنانا تَكُن أَنتَ أَوَّلاً","وَعَبدُكَ ثانيها وَشادٍ وَشادِنُ",15,"ن",1,0],["فَانزَوَتْ بِالشَّهيقِ خَوفاً وَظَنَّتْ","حَبَّ رُمَّانِ صَدرِها قد تَنَثَّر",16,"ر",1,0],["فإنْ زُمَرُ الأحزابِ راموا امتحانَهُ","سبى ليلَ فرقانِ المجادلةِ النصرُ",17,"ر",1,0],["فَأنزلَهُ في دارِهِ وأحلَّهُ","مَحلاً تَمنَّى مِثلَهُ كلُّ قادمِ",18,"م",1,0],["فأَنْزَلَ اللهُ أَمْلاكاً مُسَوَّمَة","لَبُوسُها مِنْ سَكِيناتٍ سَرابِيلُ",19,"ل",1,0],["فَأَنزَلتُ حاجاتي بِحَقوَي مُساعِدٍ","وَإِن كانَ أَدنى صاحِبٍ وَدَخيلِ",20,"ل",1,0],["فأَنزلَ الناسَ إلى البَسيطِ","وقَطَّعَ البَيْنَ منَ الخَليطِ",21,"ط",1,0],["فإن زليخا كلما بصرت بها","أحست بنار في الجوانح تسعر",22,"ر",1,0],["فإنْ زَعَموا أنّ الهَجِيرَ اسْتَشَفّهُمْ","إليها فمِنْها في المَزايِدِ أسْمال",23,"ل",1,0],["فَإِنْ زَادَنِي هَجْرَاً ضَرَبْتُ عَنِ اسْمِهِ","وَأَمْسَكْتُ عَنْ سُخْطِي عَلَيْهِ وَعَنْ شُكْرِي",24,"ر",2,0],["فَانزلهُ مِن ناديك أَشرَف مَنزل","وَأَلبسهُ حلياً مِن قَريض منظم",25,"م",1,0],["فإن زهو العلا والمجد أن فتى","كمصطفى سلبته الغيد إدراكا",26,"ك",2,0],["فانزوى الطائرُ الأسيرُ حزيناً","ليته ما رأى ولم يتغنَّ",27,"ن",1,0],["فَأَنزَرُ ما تُعطيهِ يوفي عَلى المُنى","وَأَيسَرُ ما توليهِ يَستَغرِقُ الحَمدا",28,"د",2,0],["فان زوروا في الغيب عني قالةً","فقد زوروها في حضوري ورّوقوا",29,"ق",3,0],["فإنزل بساحته ونل من فضله","ما لا ينال القاعد الكسلان",30,"ن",1,0],["فَإِنَّ زَكاةَ الحُسنِ تَقبيلُ ثَغرِهِ","وَرَشفُ ثَناياهُ وَبَردِ رُضابِهِ",31,"ب",2,0],["فَإِنَّ زَهْرَةَ ذِي الدُّنْيَا وَزِينَتَهَا","وَمَا يَرُوقُ بِهَا أَضْغَاثُ أَحْلَامِ",32,"م",1,0],["فانزل على حكم الوفاء","فأنت مكلو أمين",33,"ن",1,0],["فانزل وأنت رقيقه","لتعود للعلياء راق",34,"ق",1,0],["فانزَع صمامَتَها بمَبزَلِ حاذِقٍ","فالبنتُ للتَّزويجِ لا للمكنَز",35,"ز",1,0],["فانزل بتربته ايما نزلت وَسل","أَهذه طيبة وَالخلق زوار",36,"ر",1,0],["فأَنزلَه في لَيلةِ القَدر جُملَةً","بِعِلمٍ وما أَدراك ما لَيلَةُ القَدرِ",37,"ر",1,0],["فانزعه في عصرِ الصبا طائعاً","من قبل أن ينزعَ بالشيبِ",38,"ب",1,0],["فأنزلت آمالي إذن من فنائكم","بواد سقاه الجود صيب وبله",39,"ل",2,0],["فَأَنزلَني الحِرْمانُ دارَ نَدامةٍ","وَأَنزَلَ أَشعارِي بِدارِ بَوَارِ",40,"ر",1,0],["فَاِنزِل بِها إِن جِئتَ زَوّارَ الحِمى","يا سائِقَ العيسِ فَدَع حَثَّ الإِبِل",41,"ل",1,0],["فَإِن زادَ ماءُ النيلِ فَهوَ مَدامِعي","وَإِن هاجَ وَقدُ القَيظِ فَهوَ ضِرامي",42,"ي",1,0],["فأنزَرُ حَظِّي من مواهبهِ الغِنَى","وأيسرُ تخويلي العشيرةُ والرَّهطُ",43,"ط",1,0],["فانزل على سَعَة الوقار ورحبه","في منزل رحب وبيت عامر",44,"ر",1,0],["فانزل بحضرة يونسٍ","تامن به حوت الطريقِ",45,"ق",1,1],["فانزل وسلم على ذاك الغزال وقل","يقريك حبك شوقا كاد يفنيه",46,"ي",2,0],["فأَنزَلَني ولكِنْ عن ذُرَاهُ","وحَيَّانِي ولكنْ بِالنُّباحِ",47,"ح",1,0],["فأنزلوا من القصو","ر العاليات المقصره",48,"ر",2,0],["فأنْزلَ الضَّيْف بخيرِ مَنْزِل","وبَدَّل الجدْب بخصبٍ مُخضِل",49,"ل",1,0],["فَاِنزِل عَنِ الصَحوِ فَما مِشيَةٌ","أَطيبُ مِن هَملَجَةِ السُكرِ",50,"ر",1,0],["فَإِن زُرت لَيلَى بَعد طُولِ تَجَنُّبٍ","تَأَبَّضَ مَنقوصُ اليَدينِ غَيورُ",51,"ر",1,0],["فأنزلن سكينةً علينا","وثبِّت الأقدام إن لاقينا",52,"ن",2,0],["فانزِلْ بنا يا مُريدَ الحقِّ إنَّ لنا","حِمًى أقام رحاباً غيرَ مَهْجورِ",53,"ر",1,0],["فَأَنزَلَ اللَهُ قُرآناً يُبَرِّئُها","وَبَينَ عَوفٍ وَبَينَ اللَهِ ما صَنَعا",54,"ع",2,0],["فانزِعْ إلى دارِ السَّلامةِ في النَّقا","وإذا مَرَرتَ على الحُصَيب فهَرْولِ",55,"ل",1,0],["فإن زعمت أنه كان فعل","ذاك فقد أكذبك الذي نزل",56,"ل",1,0],["فإن زعمت أنه أوصانا","وخلف السنة والقرآنا",56,"ن",2,0],["فإن زعمت أنه كان أمر","أن لا يلي ذلك إلا من حضر",56,"ر",1,0],["فإن زعتم بعدما وصفتم","بأنهم تشاوروا كذبتم",56,"م",1,0],["فإن زعمت أنه سماه","صاحبه الله إذا ارتضاه",56,"ه",1,0],["فإن زعمتم أنه صح الخبر","فغيرهم أراد فيما قد ذكر",56,"ر",1,0],["فإن زعمت أنت أن الكثرة","قد عقدوا بعد النبي الإمرة",56,"ه",1,0],["فأنزل الله ولي النعمة","في ذاك أنه ولي الأمة",56,"ه",1,0],["فإن زعتم أنه كان كنى","في قوله ولم يكن كان عنى",56,"ن",2,0],["فأَنزل الشركَ بدار الرَّدى","وصيَّر الكفرَ ببالِ الوبال",57,"ل",1,0]]}