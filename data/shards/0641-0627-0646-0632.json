{"poems":[[77,"تلافيت نصر الدين إذ كاد يتلف","https://www.aldiwan.net/poem35977.html","الطويل"],[86,"بنادي الجزيرة قف ساعة","https://www.aldiwan.net/poem10950.html","المتقارب"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[93,"إلى مصر أزف عن الشآم","https://www.aldiwan.net/poem11411.html","الوافر"],[54,"هجرتك لم أهجرك من كفر نعمة","https://www.aldiwan.net/poem27399.html","الطويل"],[23,"لقد لعن الرحمن جمعا يقودهم","https://www.aldiwan.net/poem21309.html","الطويل"],[23,"قومي الذين هم آووا نبيهم","https://www.aldiwan.net/poem21570.html","البسيط"],[72,"قام غلام الأمير يحسب في","https://www.aldiwan.net/poem19044.html","المنسرح"],[51,"الدين والعلم والنعماء والشرف","https://www.aldiwan.net/poem65471.html","البسيط"],[85,"لِيعِنا كل معبود معين","https://www.aldiwan.net/poem7767.html","الرمل"],[85,"أيها الكاتب المصور صور","https://www.aldiwan.net/poem63704.html","الخفيف"],[85,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[45,"ما الغيث يهمي صوب إسباله","https://www.aldiwan.net/poem65541.html","السريع"],[28,"تكاثر يربوع عليك ومالك","https://www.aldiwan.net/poem4981.html","الطويل"],[58,"عرفت ومن يعتدل يعرف","https://www.aldiwan.net/poem30961.html","المتقارب"],[66,"تصدق فإنا ذا النهار بخلوة","https://www.aldiwan.net/poem39061.html","الطويل"],[80,"غشيت حجرها دموعي حمرا","https://www.aldiwan.net/poem31463.html","الخفيف"],[69,"علا لك ذكر لا يشابهه ذكر","https://www.aldiwan.net/poem28801.html","الطويل"],[105,"إلى الله فارغب يا عدي بن حاتم","https://www.aldiwan.net/poem44010.html","الطويل"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[48,"وخيمة ناطور برأس منيفة","https://www.aldiwan.net/poem64489.html","الوافر"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42634","الطويل"]],"verses":[["فأنْزَلْتَ غيْثاً منْ سَماءِ عَجاجَةٍ","تُرَى دَلْوَها شُهْبَ الأسِنّةِ تَقْذِفُ",0,"ف",1,0],["فَأَنزَلَني مُنزَلاً طَيِّباً","وَرَوّى فُؤادِيَ حَتّى اِرتَوى",1,"ا",1,0],["فَأَنزِلوني مَكاناً أَستَجِمُّ بِهِ","وَيَنجَلي عَن فُؤادي بَرحُ أَحزاني",2,"ي",1,0],["فَإِنْ زِينَتْ لَنَا الأَقْوَالُ عِفْنَا","تَعاطِيهَا كَمَاكِرَةِ المُدَامِ",3,"م",1,0],["فَإِن زِدتَني بِرّاً تَزَيَّدتُ جَفوَةً","فَلا نَلتَقي طولَ الحَياةِ إِلى الحَشرِ",4,"ر",1,0],["فَأَنزَلَ رَبّي لِلنَبِيِّ جُنودَهُ","وَأَيَّدَهُ بِالنَصرِ في كُلِّ مَشهَدِ",5,"د",1,0],["فَأَنزَلوهُ بِدارٍ لا يَخافُ بِها","مَن كانَ جارَهُمُ داراً هِيَ الدارُ",6,"ر",1,0],["فأنزل الحاضرون من سبق","وعاد ذاك الطهور تنجيسا",7,"س",2,0],["فإن زوى عني الجُمَّار طلعته","فلا يصبني بحدي شوكه السعف",8,"ف",1,0],["فانزعوا من أرضكم خط الحديد","واقطعوا أسلاك برق لا تفيد",9,"د",1,0],["فَاِنزِلا في عُيونِ نَرجِسِها الغَضِّ","صِياناً وَفَوقَ خَدِّ الشَقيقِ",10,"ق",1,0],["فَاِنزِلِ التاريخَ قَبراً أَو فَنَم","في الثَرى غُفلاً كَبَعضِ الهامِدين",11,"ن",1,0],["فَأَنزَلَ اللَهُ بِهِ نِقمَةً","غَيَّرَتِ النِعمَةَ مِن حالِهِ",12,"ل",2,0],["فَأَنزَلَهُنَّ الضَربُ وَالطَعنُ بِالقَنا","وَبيضٌ بِأَيمانِ المُغيرَةِ تَجرَحُ",13,"ح",1,0],["فَأُنزِلَ جِبريلَ في قَتلِهِ","بِوَحيٍ إِلى عَبدِهِ المُلطِفِ",14,"ف",1,0],["فَإِن زُرتَ مَغنانا تَكُن أَنتَ أَوَّلاً","وَعَبدُكَ ثانيها وَشادٍ وَشادِنُ",15,"ن",1,0],["فَانزَوَتْ بِالشَّهيقِ خَوفاً وَظَنَّتْ","حَبَّ رُمَّانِ صَدرِها قد تَنَثَّر",16,"ر",1,0],["فإنْ زُمَرُ الأحزابِ راموا امتحانَهُ","سبى ليلَ فرقانِ المجادلةِ النصرُ",17,"ر",1,0],["فَأنزلَهُ في دارِهِ وأحلَّهُ","مَحلاً تَمنَّى مِثلَهُ كلُّ قادمِ",18,"م",1,0],["فأَنْزَلَ اللهُ أَمْلاكاً مُسَوَّمَة","لَبُوسُها مِنْ سَكِيناتٍ سَرابِيلُ",19,"ل",1,0],["فَأَنزَلتُ حاجاتي بِحَقوَي مُساعِدٍ","وَإِن كانَ أَدنى صاحِبٍ وَدَخيلِ",20,"ل",1,0],["فأَنزلَ الناسَ إلى البَسيطِ","وقَطَّعَ البَيْنَ منَ الخَليطِ",21,"ط",1,0],["فإن زليخا كلما بصرت بها","أحست بنار في الجوانح تسعر",22,"ر",1,0],["فإنْ زَعَموا أنّ الهَجِيرَ اسْتَشَفّهُمْ","إليها فمِنْها في المَزايِدِ أسْمال",23,"ل",1,0],["فَإِنْ زَادَنِي هَجْرَاً ضَرَبْتُ عَنِ اسْمِهِ","وَأَمْسَكْتُ عَنْ سُخْطِي عَلَيْهِ وَعَنْ شُكْرِي",24,"ر",2,0]]}