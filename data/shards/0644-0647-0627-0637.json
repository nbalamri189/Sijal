{"poems":[[37,"جزتك الجوازي عن صديقك نضرة","https://www.aldiwan.net/poem39183.html","الطويل"],[30,"ود جرير اللؤم لو كان عانيا","https://www.aldiwan.net/poem5620.html","الطويل"],[82,"ومشرعة بالموت للطعن صعدة","https://www.aldiwan.net/poem31547.html","الطويل"],[22,"آثرت إدلاجي على ليل حرة","https://www.aldiwan.net/poem21644.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55140","الطويل"],[37,"جزتك الجوازي عن صديقك نضرة ً","https://www.poetsgate.com/ViewPoem.aspx?id=21922",""],[164,"أقمن على قلبي رقيبا من الحب","https://www.aldiwan.net/poem58937.html","الطويل"],[216,"وأغيد ميال القوام مهفهف","https://www.aldiwan.net/poem37915.html","الطويل"],[240,"كذا كل يوم دولة تتجدد","https://www.aldiwan.net/poem32101.html","الطويل"],[302,"سرت موهنا والنجم في أذنها قرط","https://www.aldiwan.net/poem33231.html","الطويل"],[422,"أينكر معروفنا المنكر","https://www.aldiwan.net/poem54039.html","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63759","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96755","الوافر"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74993","الوافر"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48211","الوافر"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137016",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137246",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205036","الوافر"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112287","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86256","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109941","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118005","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66536","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103058","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101359","الوافر"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21544","الهزج"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94485","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94473","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66170","الطويل"],[4829,"شمّا وأم الجماجم","https://www.poetsgate.com/ViewPoem.aspx?id=34256",""],[5431,"يطلُ العيدُ والأوجاعُ حبلى","https://www.poetsgate.com/ViewPoem.aspx?id=189673",""],[5956,"من الزهر وضوء القمر","https://www.poetsgate.com/ViewPoem.aspx?id=182449",""]],"verses":[["لَها طُرَرٌ تَحتَ البَنائِقِ أُذنِبَت","إلىمُرهَفاتِ الحَضرَمي المُقَرَبِ",0,"ب",1,0],["لَهُ أَطلَقَ الأَسرى الَّتي في حِبالِهِ","مُغَلَّلَةً أَعناقُها في الأَداهِمِ",1,"م",1,0],["لها طعنةٌ لا تسْتَبينُ لناظرٍ","ولا يُرْسِلُ المسبارَ فيها طبيبها",2,"ب",3,0],["لَها طيبُ رَيّا إِن نَأَتني وَإِن دَنَت","دَنَت وَعثَةً فَوقَ الفِراشِ المُمَهَّدِ",3,"د",1,0],["لَهَا طَلْعَةُ الْجَاهِ المؤَثَّلِ وَالصِّبَا","وَفِي الوَجْهِ تَقْطِيبٌ لِمَنْ يَتَأَمَّلُ",4,"ل",1,0],["لها طُررٌ تحتَ البنائقِ أُذنِبتْ","إلى مُرْهَفَاتِ الحَضْرَميّ المُعقرَبِ",5,"ب",1,0],["لها طلعة تجلو الظلام وينطفي","بها كل نور حين تبدو من الحجب",6,"ب",1,0],["لها طربٌ في مَشْيِها وبَشَاشة","إلى مَلِكٍ تَعْنو لَهُ السادةُ النُجْبُ",7,"ب",1,0],["لَها طَودُ حِلمٍ في الحَوادِثِ مِنكُمُ","مَنيعٌ وَبَحرٌ بِالمَكارِمِ مُزبِدُ",8,"د",1,0],["لَها طرَّةٌ تَضفو عَلى صُبح غرَّة","يُساقِطُ مِسكاً من غدائِرها المشطُ",9,"ط",1,0],["لها طعناتٌ كَوَخْزِ السِّنان","ولا مثلها الذابلُ الأَسمر",10,"ر",1,0],["لها طعمان من عَسَلٍ حتّيٍ","وماءِ الورد لا زِفْتٍ وَقِير",11,"ر",1,0],["لها طرفٌ كحيل كم فؤاد","تعلَّق ذلك الطَّرفَ الكحيلا",12,"ل",2,0],["له أطم من الأنصار تَحمي","محللها إذا رفض القطين",13,"ن",1,0],["لها طَرْفٌ تلوذُ به المعاصي","وأعطافٌ يلوذُ بها الوَقَارُ",14,"ر",1,0],["لها طلعة يصبي خليل بحسنها","فلا بانة الوادي ولا ظبية الرمل",15,"ل",1,0],["لها طلعة كالبدر عند اكتماله","وصيت كمثل المسك فاح له نشر",16,"ر",1,0],["لها طيب مدى الأيام يبقى","إذا لم يبق للأزهار طيب",17,"ب",1,0],["لها طَلعَةٌ كالبَدرِ لَولا بَهاؤهَا","مشيت بلَيلٍ حالكٍ من دُجَى الشّعرِ",18,"ر",1,0],["لَها طَلعات يَعشَق البَدر حُسنَها","عَلَينا فَكَم تَجلو مَطالِع اقمار",19,"ر",1,0],["لها طُولٌ على عَرضٍ","وعُمقٌ مُوجَزُ البُعدِ",20,"د",1,0],["لها طيشٌ فما نَهدا","إذا هَبَّت صَبا نَجدِ",20,"د",1,0],["له اطلاع ونور في فراسته","مع الكشوف لأن الله يلقيه",21,"ي",2,0],["لَها طَلْعَةٌ مِنْ شَعْرِها وَجَبيِنها","تَعانَقَ فِيها لَيْلُها وَنَهارُها",22,"ر",3,0],["له اطعام عارفة وعز","وللكرماء أطعام الطعام",23,"م",1,0],["لها طرف المباني قد تهادت","فأمست وهي واهية الطراف",24,"ف",1,0],["لَها طَرفٌ يَشوب الخَم","ر للنُّدمان بالخَمرِ",25,"ر",1,0],["لها طَرفٌ كحيلٌ لا بغنجٍ","ولكن غنجها يَقضي عليّا",26,"ي",2,0],["لَها طَلعَةٌ حارت بتشبيهها النُهى","هل الورد والنسرين باتا بزهرةِ",27,"ه",1,0],["لَها طَلْعَةٌ ما البَدْرُ لَيْلَ تَمامِهِ","اذا اشْرَقَتْ تَسْبي الحَكِيمَ المُهَذَبا",28,"ب",2,0],["لها طللٌ يلاوح بالجواء ِ","كندب الجرحِ فوق ضلوع واجم",29,"م",1,0],["لها طفل يطل كألف نجم","تلألأ ثم صار العمر أحلى",30,"ل",2,0],["لها طيبةٌ لم أجد مثلها","بأهل القرى وبأهل الحضرْ",31,"ر",1,0]]}