{"poems":[[94,"أنت كالزهرة الجميلة في الغاب","https://www.aldiwan.net/poem38949.html","الخفيف"],[124,"لنجي الهم يجتاب الكرى","https://www.aldiwan.net/poem49291.html","الرمل"],[189,"غدونا للغداء غداة قر","https://www.aldiwan.net/poem14134.html","الوافر"],[368,"لمن طلل بذي خيم قديم","https://www.aldiwan.net/poem1721.html","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54073","الخفيف"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35663","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69249","الكامل"]],"verses":[["كأغاني الطُّيور كالشَّفَقِ السَّاحِرِ","كالكوكبِ البعيدِ السَّعيدِ",0,"د",1,0],["كأغاريد الهوى المنصرم","ما رأت غرته شمس ضحى",1,"ح",2,0],["كأغْشيةِ مبطّنةٍ بقُطْن","مقدَّرةٍ على أَدْراج عاجِ",2,"ج",1,0],["كَأَغلَبَ مِن أُسودِ كَراءَ وَردٍ","يَشُدُّ خِشاشَهُ الرَجُلُ الظَلومُ",3,"م",1,0],["كاغدٌ لا يغوصُ فيه مِدادٌ","أبيضُ اللَّونِ أمْلَسٌ ذو مَجَسِّ",4,"س",1,1],["كاغِدنا يشبِه حالاتنا","في كلِّ مَعنى وَيُحاكيها",5,"ي",3,1],["كَأَغضَفِ هَولٍ قَد تأَثَّرَ ضَيغَماً","تَذَعَّرَاً وخِر نَوصَ بَرٍّ يُكَبكِب",6,"ب",1,0],["كأغصف رام ريماً","في الكناس فهب منبعثاً",7,"ث",2,0],["كَأَغَرَّ يَتَّخِذُ السُيوفَ سُرادِقاً","يَمشي بِرايَتِهِ كَمَشي الأَنكَبِ",8,"ب",1,0]]}