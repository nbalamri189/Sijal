{"poems":[[55,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[85,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[76,"وصقيل إفرند الشباب بطرفه","https://www.aldiwan.net/poem12854.html","الكامل"],[76,"وصقيلة الأنوار تلوي عطفها","https://www.aldiwan.net/poem12939.html","الكامل"],[92,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[443,"إن داراً بين اللوى والعفيق","https://www.aldiwan.net/poem2547.html","الخفيف"],[463,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83311","الطويل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67922","الرجز"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77299","الكامل"],[3181,"","https://poetry.dctabudhabi.ae/diwan/poem/105093","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127245","الوافر"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81293","الخفيف"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62090","الكامل"],[4767,"جزاء سنمار","https://www.poetsgate.com/ViewPoem.aspx?id=87719",""],[669,"وصفت لك الحوض وصقت لك الحوض يابن الحصين","https://www.poetsgate.com/ViewPoem.aspx?id=19358",""],[4994,"مسيح لم تقرأه صلبانه","https://www.poetsgate.com/ViewPoem.aspx?id=210812",""],[5131,"يا بلادي ما اغتربنا ما نأيْنا","https://www.poetsgate.com/ViewPoem.aspx?id=42208",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5616,"تعليق هامشي على هامش أحداث هامشية!","https://www.poetsgate.com/ViewPoem.aspx?id=205035",""],[2220,"إذا نظرت عيني فأنت الذي ترى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11544&r=&rc=418",""]],"verses":[["وَصَقيلُ الذُبابِ يَق","بِضُ لَحظَ المَرامِقِ",0,"ق",1,0],["وصقلت للحسناء صفح مودتي","لما اجتليتُ العارضَ المصقولا",1,"ل",2,0],["وَصَقيلِ إِفرِندِ الشَبابِ بِطَرفِهِ","سَقَمٌ وَلِلعَضبِ الحُسامِ ذُبابُ",2,"ب",1,1],["وَصَقيلَةِ الأَنوارِ تَلوي عِطفَها","ريحٌ تَلُفُّ فُروعُها مِعطارُ",3,"ر",1,1],["وصَقْرٍ تحامَتْهُ الصقورُ وراعها","من النظر الغضبانِ موتٌ مُداهم",4,"م",1,0],["وصقيل كأنّه البين يرمي","شمل جسم الأبطال بالتمزيق",5,"ق",1,0],["وصقَلوا بِبِشرهم","وجهَ الزمان الجَهمِ",6,"م",1,0],["وصقيلةِ الأنيابِ تُش","رَبُ حُلوةً أَسآرُها",7,"ر",3,0],["وَصَقرُ قُرَيشٍ حينَ جاءَ مَشرَداً","فَاِنشَبَّ فيهِم أَيَّ ظَفرٍ مُظَفَّرِ",8,"ر",1,0],["وصقعَت أواخرُ الديوكِ","بادرَ مثلَ الرُّجلِ المسلوكِ",9,"ك",1,0],["وَصَقَلتُ في مِصرَ الجَديدَةِ خاطِري","بَينَ الرِياضِ وَكُلّ خَدّ نادي",10,"د",2,0],["وصقلت فيك مواهبا وضاءة ال","صفحات صقل القين للصمصام",11,"م",1,0],["وصقل السيف من رين وغش","وقط الشمع مع بري السهام",12,"م",1,0],["وَصَقيل في صَفحة الماء فَضف","اض نَدي ممصر مِن أَهابك",13,"ك",1,0],["وصقيل مدارج النمل فيه","وهو مذ كان ما درجن عليه",14,"ه",1,1],["وصقلت خنجرك الذي أودعتَه","ظهري بطعنة عابث لا يعبأ",15,"ا",1,0],["وصقت لك الحوض يابن الحصين","على صفة الحارث الأعور",16,"ر",1,1],["وصَقيعٌ يرتجي مِن حَضرَة الشَّمسِ اقترابَه","قيلَ يا خلي كلامٌ ألحَقوهُ بالنَّجابَه",17,"ب",2,0],["وصقلنا العقل من تجرِبةٍ","ثبتت في العقل إرشاداً وزَينا",18,"ن",2,0],["وصقْع حين يلذعني","يذيب الثلج والبردا",19,"د",2,0],["وصقيعُ الأيام يجلدُ أَعصا","بي وفَوقي مع الجليدِ جليدُ",20,"د",1,0],["وصقعٌ وجودُ الحقِّ في دارِ غربتي","فلا صقعٌ أعلى في المنازلِ من صقعي",21,"ع",2,0]]}