{"poems":[[53,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[74,"وصقيل إفرند الشباب بطرفه","https://www.aldiwan.net/poem12854.html","الكامل"],[74,"وصقيلة الأنوار تلوي عطفها","https://www.aldiwan.net/poem12939.html","الكامل"],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[434,"إن داراً بين اللوى والعفيق","https://www.aldiwan.net/poem2547.html","الخفيف"],[456,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[456,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"]],"verses":[["وَصَقيلُ الذُبابِ يَق","بِضُ لَحظَ المَرامِقِ",0,"ق",1,0],["وصقلت للحسناء صفح مودتي","لما اجتليتُ العارضَ المصقولا",1,"ل",2,0],["وَصَقيلِ إِفرِندِ الشَبابِ بِطَرفِهِ","سَقَمٌ وَلِلعَضبِ الحُسامِ ذُبابُ",2,"ب",1,1],["وَصَقيلَةِ الأَنوارِ تَلوي عِطفَها","ريحٌ تَلُفُّ فُروعُها مِعطارُ",3,"ر",1,1],["وصَقْرٍ تحامَتْهُ الصقورُ وراعها","من النظر الغضبانِ موتٌ مُداهم",4,"م",1,0],["وصقيل كأنّه البين يرمي","شمل جسم الأبطال بالتمزيق",5,"ق",1,0],["وصقَلوا بِبِشرهم","وجهَ الزمان الجَهمِ",6,"م",1,0],["وصقيلةِ الأنيابِ تُش","رَبُ حُلوةً أَسآرُها",7,"ر",3,0]]}