ا انحنى الشرق أكمدا","https://www.poetsgate.com/ViewPoem.aspx?id=161907",""],[585,"سلوه وقد مال السرير المطنب","https://www.poetsgate.com/ViewPoem.aspx?id=161851",""],[5183,"هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=180231",""],[5237,"هو السعد كم من وضيع رفع","https://www.poetsgate.com/ViewPoem.aspx?id=113113",""],[592,"ضلالٌُ ما يؤمله اللئام","https://www.poetsgate.com/ViewPoem.aspx?id=128813",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5397,"على الربع دمعي أرسل المد لا الجزرا","https://www.poetsgate.com/ViewPoem.aspx?id=157921",""],[5582,"أَبَرْقَ الأَبْرَقَيْنِ أَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63574",""],[5689,"ارك بقلبي بت غير موسوس","https://www.poetsgate.com/ViewPoem.aspx?id=143394",""],[5689,"أراك بذي الدنيا الجفاء حبورها","https://www.poetsgate.com/ViewPoem.aspx?id=143409",""],[6088,"سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=207606",""],[6102,"قاف قهر","https://www.poetsgate.com/ViewPoem.aspx?id=184627",""],[5064,"نرجِسَةُ المعَانِي الزُّجاجِيَّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87539&r=&rc=34",""]],"verses":[["وَهَل بَلِيَت خَيمٌ عَلى أَيمَنِ الحِمى","وَزالَت لَنا بِالأَبرَقَينِ رُبوعُ",0,"ع",1,0],["وَهَل بالِغٌ ما يَبلُغُ الدَمعُ عِندَها","حَقائِبَ غَيثٍ تَحمِلُ البَرقَ وَالرَعدا",1,"د",2,0],["وَهَل بَقِيَت قَبائِلُهُ فَيَبقى","رَبيعَةُ أَو نِزارٌ أَو مَعَدُّ",2,"د",1,0],["وهلْ بعْدَ اعْترافٍ منْ نِزاعٍ","وهلْ بعْدَ افْتِصالٍ منْ وَثيقَهْ",3,"ق",2,0],["وهلْ بائِعٌ فينا منَ اللهِ نفْسَهُ","فلا مُشْتَرٍ أوْلَى منَ اللهِ أو أوْفَى",4,"ف",2,0],["وَهَلْ بَعْدَ شَطْرِ الْحَوْلِ فِي دَارِ غُرْبَةِ","مُقَامٌ بِمَرْأَى لِلْعَدُوِّ الْمُصَمِّمِ",5,"م",1,0],["وهلْ باكَرَ الوَسْميّ داراً على اللِّوى","عفَتْ آيُها إلا التوهُّمُ والذِّكْرُ",6,"ر",1,0],["وهل بك مثل هذي الأرض أرضٌ","وفيها مثلنا متخالفونا؟",7,"ن",2,0],["وهل بالموت نحن إذا خرجنا","عن الأجساد نحوك مرتقونا؟",7,"ن",2,0],["وهل بين من لا يرتضي بمهانة","وبين الذي يرضى الهوان مساواة",8,"ه",1,0],["وهَل بالشَّامِ لي وَجْهُ ارتيادٍ","أُقيمُ عليه أَم وَجهُ انطلاقِ",9,"ق",1,0],["وهلْ بتّ منْهُ مُستعيراً أناملاً","تشيرُ إلينا حُمْرها بسلامهِ",10,"م",2,0],["وَهَل بَقِيَت لِلنَفسِ إِلّا اِطِّلاعَةٌ","إِلى القَلَمِ الأَعلى يَخُطُّ مُوَقِّعا",11,"ع",2,0],["وهل بالسَّهمِ نُكرٌ حين يَمضي","فيُؤثِرُ في مواقعهِ الرُّكودا",12,"د",2,0],["وهل بعدَ الرِّدَاءِ يُمَدُّ بِرٌّ","وتكرمةٌ لِذِي خَطَرٍ وَشَانِ",13,"ن",1,0],["وَهَل بِخَليفِ الخَلِّ مِمَّن عَهِدتُهُ","بِهِ غَيرُ أُحدانِ النَواشِطِ روعُ",14,"ع",1,0],["وهل برُبَى نجْدٍ فتوضحَ مسنِدٌ","أُهَيلَ النّقا عمّا حوَتْه الأضالع",15,"ع",1,0],["وهل بِلِوى سَلْعٍ يُسَلْ عن مُتَيَّمٍ","بكاظِمَةٍ ماذا به الشّوقُ صانع",15,"ع",1,0],["وَهَل بها للألى يب","صرون شيء كَثير",16,"ر",1,0],["وهل بدَّلَ الدينَ إلا الملوكُ","وأحبار سوءٍ ورُهبانُها",17,"ن",3,0],["وهَلْ بَعْدَ لَيْلٍ في الْحَيَاةِ مُرَرِّقٍ","كَثِيرِ التَّظَنِّي أَبْصَرَ الصُّبْحَ ساهِرُه",18,"ر",2,0],["وهل بعد إبراهيمَ من مُتكلمٍ","يُحاضرنا، أو من سميعٍ نحاضره؟",19,"ر",2,0],["وهل بعثَ اللهُ مَنْ في القبورِ","وأخرجت الأَرضُ أثقالَها؟",20,"ل",3,0],["وهل بائع فينا من الله نفسه","فلا مشتر أولى من الله أو أوفا",21,"ف",2,0],["وهلْ بالرَّغْمِ من هذا وهذا","تأبَّتْ منه ، دانيةً ، قُطوف",22,"ف",1,0],["وهل بحمام الأيك ما بي من الأسى","شكا فتغني ، واستراب فجمجما",23,"م",2,0],["وهل بعد تقبيل اليمين مزية","تشاكلها مهما اسندار زمان",24,"ن",1,0],["وهل بعيد عناء مسها نزلت","امينة تغنم المرعى بوادينا",25,"ن",2,0],["وهل بعد فقد الناصرين مصيبة","وان هو لا خلق سوى الله ينصر",26,"ر",1,0],["وهل بعد الجفا يحيا بوصل","تكون به السلامة والسلام",27,"م",1,0],["وَهَل بِالَّذي تَأتي إِلى الوَصفِ حاجَةٌ","وَأَخبارُهُ بِالشَرقِ وَالغَربِ تُشهَرُ",28,"ر",1,0],["وهل بذاك الشعب لي وقفةً","في حرم أنواره تُشرق",29,"ق",1,0],["وهل بينَ العِظامِ لهُ مقامٌ","إذا جاؤوا عليَّ مُسلِّمينا",30,"ن",2,0],["وَهَل بنجد وَسفح البان من اضم","ما يذهب القلب عَن نعم وَنعمانا",31,"ن",2,0],["وَهَل بعد شت الشمل وصل علائق","علقن بقلب فاقد غير فاقد",32,"د",1,0],["وَهَل بِسِوى قُربِ الحَبيبِ وَوَصلِهِ","يُبَلُّ غَليلٌ أَو يُبِلُّ عَليلُ",33,"ل",1,0],["وَهل بيدٍ من بعد ما بان كفُّها","يُوقع عهدٌ أَم يؤكد موثق",34,"ق",1,0],["وَهَل بَلغت إِلى غرضٍ سهامٌ","وَلَم تكُ من كنانتك السهامُ",35,"م",1,0],["وَهَل بَدا صُبح أَفراح المَلا فَزَها","حَتّى تَبلَّج بِالأَنوار مسفرهُ",36,"ر",2,0],["وهل باطِنٌ بعد هذا العُمو","مِ باق فُيكشَفَ عنه تُرى",37,"ا",1,0],["وهل بعدَ رأيِ العَينِ رأيٌ لِناقضٍ","عَليه إليه في النَّوائبِ أسكُنُ",38,"ن",1,0],["وهل بِسَمْعِكَ يَا يَحْيَى حَيِيتَ لَنا","عن دَعْوَتي زَوَرٌ أَوْ عَنْكَ لي وَزَرُ",39,"ر",1,0],["وهَلْ بِمَدْحِكَ أَسْتَقْضيكَ عارِفَةً","بَلِ الغَمامُ بِطَبْعِ السَّكْبِ يَنْهَمِرُ",39,"ر",1,0],["وهلْ بَعْدَ الأُسارى والسَّبايا","مكانٌ للفكاكِ أَوِ الْفِدَاءِ",40,"ا",2,0],["وهَلْ بالبَحْرِ من ظَمَأٍ فَيَرْوى","صَدَاهُ بِغَيْرِ أَكْبادٍ ظِماءِ",40,"ا",2,0],["وهل بهوه يزهو باطفال عسجد","لهوت بها ويلاه كم بعد العهد",41,"د",1,0],["وهل بات أهل الشعر أمثال غيرهم","صعاليك كل للضلال يوطى",42,"ا",1,0],["وهل بانُ سلع على العهد من","ه يحلو ثماراً ويدنو قُطوفا",43,"ف",2,0],["وهل بعد عبادان تعلم قرية","كما قيل أو مثل بن شاور يعلم",44,"م",1,0],["وهل بِرُضابِ الثَّغرِ مُرجٍ لها فَقَد","كَوى كَبِدي مِن نارِ وجنتِه جَمرُ",45,"ر",1,0],["وَهَل بَقيتْ للعين والقلبِ بهجةٌ","بهوجِ اللّيالِي في ديارِ إيادِ",46,"د",1,0],["وهل باسم محي الدين يمتاز في الورى","وعبد الغنيْ إلا من الشجر العرق",47,"ق",1,0],["وهل بقى لي قول بعد مؤتمر","مثيله لم تشاهد مصر مؤتمرا",48,"ر",2,0],["وَهَل بَعدَ هَذا الخَطبُ خَطبٌ نُعِدُّهُ","مُصاباً بِعِلمٍ أَو بَلاءً بِعالَمِ",49,"م",1,0],["وهَل بِساطُك حُفرٌ أو فِراشك مَو","هيّ الطَّهارةِ مِن مِسكٍ وكافُور",50,"ر",1,0],["وَهَل بِالرُسل وَالأَملاك صَلَّى","إِماماً غَيرُ أَحمدنا التهامي",51,"م",2,0],["وهل بعد تمهيد الحماة لفاتح","ترد تخومٌ فاتحاً وحدود",52,"د",1,0],["وهل بعدما استيقظ المسلمون","وهبت عواصفهم ذاريه",53,"ي",2,0],["وهل بعد ما آمن الملحدون","وأخلدت الأنفس العاصيه",53,"ي",2,0],["وهل بعد الشهور السود منهم","تعود إليهمُ تلك الشهور",54,"ر",1,0],["وهل بلغ البيتَ الحرامَ حديثُهم","وهال حجيجاً حوله وقبائلا",55,"ل",2,0],["وهل بعد خطبته فيكمُ","مكانٌ لمختلق حاسد",56,"د",1,0],["وهل بكى الربعُ رَكبً الظاعنين وهل","بكى وناح على الأحبابِ أحبابُ",57,"ب",1,0],["وهل بها الفيض كما عهدته","ترتع في مسرحه تلك الظبا",58,"ا",1,0],["وهل بساط الظل في الكهف غدت","تحثو الدنانير به كف ذكا",58,"ا",1,0],["وهل بعد القطيعة من وصال","وهلْ يلفي لفرقتنا نظام",59,"م",1,0],["وهل بعد رأس الطبل إسماع مُنصت","إلى مَشرق مُستفتح بعد مغرب",60,"ب",1,0],["وهل بالنجاسات انتفاع قيل لا","وقيل نعم قولان طِرفا رهانه",61,"ن",2,0],["وَهَل بَينَ بُردَيهِ سِوَى رُكنِ سُؤدَدٍ","وَمَحضِ فَخارٍ في مُهَنَّدِ هِمَّةِ",62,"ه",1,0],["وهل بما قد هل في الحي غيثه","ونم بما في الروض من بانه نما",63,"م",2,0],["وهل بعدما تبدينه من بشاشة","وعطف أظل العمر أشكو زمانيا",64,"ي",2,0],["وَهَل بَعد ما بانَت أُميمُ وودَّعت","شَجاك لَها رسمٌ دريسٌ ومعهدُ",65,"د",1,0],["وَهَل بعدَ الحِمى والرم","لِ رملٌ يَقتضي وجما",66,"م",2,0],["وَهَل باكَروا بِالسَفحِ مِن جانِبِ اللِوى","مَلاعِبَ آرامٍ هُناكَ وَغِزلانِ",67,"ن",1,0],["وَهَل بَعدَنا طابَ المُقامُ لِمَعشَرٍ","بِحَيثُ تَلاقى ساحَةُ الحَيِّ وَالدّربُ",68,"ب",1,0],["وهل بعد مغناه تروق لناظري","خمائل يذكو من لطائمها عطر",69,"ر",1,0],["وهل بارد من ماء باناس مبرد","لظى كبد حرى لها الشوق محرق",70,"ق",1,0],["وهل بها استفهم وينفى أو كقد","ومر بها ونحو بل قد ورد",71,"د",1,0],["وهل باقٍ لنا الرّبع","كما كنّا عهدناهُ",72,"ا",2,0],["وَهَلْ بُلْبُلُ الدَّوْحَاتِ يَحْيَى بْنُ أَكْثَمٍ","يَظَلُّ دَفِيناً فِي الرِّيَاحِينِ ذَا سُكْرِ",73,"ر",1,0],["وَهل باجتِماعِ الشَملِ مَع مَن أَوَدُّهُ","لنا عَودَةٌ يوماً فَما كانَ أَحلاهُ",74,"ا",2,0],["وهل بينها والشمس في الحسن فارق","فقلت ولا بين المقامين جامع",75,"ع",1,0],["وهل بدعوةِ أهلِ الأرضِ أم بِدُعا","أهلِ السَما عنكَ زالَت أم بِكُلِّهِمِ",76,"م",1,0],["وهل بعد يوم البين يومٌ تعيده","لنا كالدراري البيض أفراسك الدهم",77,"م",1,0],["وهل بَلِيَتْ أثْوَابُها بعدَ جِدَّةٍ","ألا حَبَّذا أخْلاَقُها وجَدِيدُها",78,"د",3,0],["وهل بعده الأوراد تتلى عشية","ومن بعهده هل تستمر الرواتب",79,"ب",1,0],["وهل بعده شمس المعارف تزدهى","وهل تتجلى بالقرب تلك الغياهب",79,"ب",1,0],["وهل بخديه من أهدابه حبك","أو ركبت فوق صدغيه محاجره",80,"ر",2,0],["وهل بعثوا رسائلهم اليه","كما بعث الدموع سجاما",81,"م",2,0],["وهل بلغت ما تبتغي منه أمةٌ","خبَت سُرُجٌ للعلم فيها وأنؤر",82,"ر",1,0],["وَهَل بُدور الهناءِ مشرقةٌ","فطالما سَرّ نَورها السَّرُ",83,"ر",1,0],["وهل بعد ذاك البين يجمعنا الخبا","وهل بعد ذاك البعد تجمعنا الدار",84,"ر",1,0],["وهل بهم هتف الركبان ركبهم","تنحو المكارم من شوق بلا سأم",85,"م",1,0],["وهل بعد هذا يجمل الصبر سيدي","وقد حيل ما بيني وبين التصبر",86,"ر",1,0],["وهل بلؤلؤ دمع ثم مُنتشرق","قبل المنية عقد الوصل منضود",87,"د",1,0],["وهل بكى وبكتْ قِدْماً لموقفنا","هذا لبينونةٍ ميٌّ وغَيْلانُ",88,"ن",1,0],["وهل بعد قول الله للناس حجة","تقوم بإظهار الحقيقة في الجهر",89,"ر",1,0],["وهل بانة الجرعاء صافح فرعها","شذا عرف أنفاس الصّبا والجنائب",90,"ب",1,0],["وهل بعدما ناب آل النبي","نائبة تختشي أن تنوبا",91,"ب",2,0],["وهلبة أبناء الذبيح التي سمى","بها في طلاب المجد شاوٌ مغرب",92,"ب",1,0],["وهل بها صفح وإغضاءٌ ففي","زهر الرياض الصفحُ بادٍ طلقا",93,"ق",2,0],["وهل بها ذكرى ففي الماءِ جرت","ذكرى نفت عنه القذى والرنقا",93,"ق",2,0],["وهل بها تأَلُّفٌ فالطير في","مبيتها تُقسمُ لن تفترقا",93,"ق",2,0],["وهل بها عهدٌ جميلٌ فالندى","على الأزاهير صفا مؤتلقا",93,"ق",2,0],["وَهَل بِنُجوم الأُفق مِنكَ صَبابة","فَأَدمعها بِالطل تَهمي وَتنطف",94,"ف",1,0],["وهل بعد هذا الخطب خطب تهابه","وقد طفقت أيدى الردا بالهدى مسحا",95,"ح",2,0],["وهل ببقائه التعليم ينفى","إذا بقيت ارادتنا تشاءُ",96,"ا",2,0],["وهل بعد نيلي تقدير من","يعرقلني غاية أو ظفر",97,"ر",1,0],["وهل بنسيمك المعتل خمر","فاني قد سكرت من النسيم",98,"م",1,0],["وهل بعد الأكرادي بحر نواله","ترى مورداً عذب المناهل يورد",99,"د",1,0],["وهل بعده من كنز فضل قد احتوي","غوالي لم يبخل بها حيث يقصد",99,"د",1,0],["وهل بعده من قدوة في معارف","إليها لتوصيل المريدين يرشد",99,"د",1,0],["وهل بعده من ملجأ في ملمة","لكشف خفيات الحقائق يعهد",99,"د",1,0],["وهل بعده يحصى الحساب مناقبا","يفيه بها الحساب مهما تعددوا",99,"د",3,0],["وهل بعده الفرضي رام خليفة","لزيد به نفع البرايا مؤكد",99,"د",1,0],["وهل بقلبك مثل قلبي حريق","من الهوى أمسى محرق",100,"ق",1,0],["وهل بعدُ يُقضى في الأَعادي بنصرةٍ","تغادرهُم للمرهفا