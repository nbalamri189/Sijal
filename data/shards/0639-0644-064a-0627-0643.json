{"poems":[[110,"هوينك بالغيور من الرجال","https://www.shoaraa.com/p13817",""],[74,"ما بت فيك بدمع عيني أشرق","https://www.aldiwan.net/poem19350.html","الكامل"],[40,"ألم تسأل بعارمة الديارا","https://www.aldiwan.net/poem7721.html","الوافر"],[108,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[113,"علياك في جسم المكارم روح","https://www.aldiwan.net/poem16213.html","الكامل"],[482,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66649","الطويل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100472","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93573","الكامل"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84892","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62760","الوافر"],[3829,"","https://poetry.dctabudhabi.ae/diwan/poem/101853","الوافر"],[5186,"غيد الهوى والجوى حاولن تجريبي","https://www.poetsgate.com/ViewPoem.aspx?id=156473",""],[5516,"لا غفت عين","https://www.poetsgate.com/ViewPoem.aspx?id=213424",""],[5582,"مُذْ حُلْنَ دُونَكِ يا سُعادُ فَراسِخُ","https://www.poetsgate.com/ViewPoem.aspx?id=186855",""],[5770,"شجب وأخواتها","https://www.poetsgate.com/ViewPoem.aspx?id=178721",""]],"verses":[["على أكل الربا سمنوا ويكسو","لهم وأد البنات هزيل حال",0,"ل",1,0],["علياك علياه وخلقك خلقه","فاهنأ بلبس مدائحٍ لا تخلق",1,"ق",1,0],["عَلى أَكوارِهِنَّ بَنو سَبيلٍ","قَليلٌ نَومُهُم إِلّا غِرارا",2,"ر",2,0],["على أكفِّهمو أرواحُهمْ هِبَةٌ","منهم لتحْرير واديهم وقُربان",3,"ن",1,0],["عَلياك في جسم المَكارم روحُ","وَثَناكَ طيب المِسك مِنهُ يِفوحُ",4,"ح",1,1],["على أكوارِها أنضاءُ شوقٍ","يؤودُ قواهمُ حملُ البرودِ",5,"د",1,0],["عليٌّ أَكَفُّ الناس عن كلّ مَحْرمٍ","وأتقاهم للهِ في كلّ جانبِ",6,"ب",1,0],["على أكوارها شعت تلبي","مهرولةٌ وتبطنها الهوينا",7,"ن",2,0],["عَلياك مثل الشَمس يَنفَع مبصر","بشعاع طلعتها وَيحرم أَرمد",8,"د",1,0],["علياك لِليمن دامَت يا خَديوينا","وَمَنبَع الخَير مِن جَدواك يُولينا",9,"ن",2,1],["على أكتافِنا وعلى طُلانا","أسَنّتَهنّ تلبُدُ للوثوبِ",10,"ب",1,0],["عليا كم تجور فدتك نفسي","وما ماملكت يدي عزاً ومالا",11,"ل",2,0],["على أكف ترى كالخز ناعمة","وتحت أردانها حد المخاليب",12,"ب",1,0],["على أكتافنا رفعوا قصورا","وفي تعذيبنا استهموا وهاموا",13,"م",3,0],["-عَلْياكَ فِي الجَوْزا دَعائِمُها وَفِي ال","أَرْضِ القَواعِدُ جُثَّمٌ وَرَواسِخُ",14,"خ",1,0],["على أكفهمُ أرواحهم سبقت","إلى الجنان لنيل الخلد أطفال",15,"ل",1,0]]}