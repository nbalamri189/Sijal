{"poems":[[55,"تفوز بنا المنون وتستبد","https://www.aldiwan.net/poem30604.html","الوافر"],[23,"فكف يديه ثم أغلق بابه","https://www.aldiwan.net/poem21614.html","الطويل"],[53,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[47,"عذيرك من نأي غدا وبعاد","https://www.aldiwan.net/poem63453.html","الطويل"],[71,"دموع يستبقن إلى النحور","https://www.aldiwan.net/poem28750.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67340","الطويل"],[49,"عجبتُ ، وقدْ لقيتَ بني \" كلابٍ \"","https://www.poetsgate.com/ViewPoem.aspx?id=14745",""],[101,"فم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=299&r=&rc=32",""],[211,"ألا هل أتى عرسي مكري وموقفي","https://www.aldiwan.net/poem27938.html","الطويل"],[280,"ولي العهد أم عهد الولي","https://www.aldiwan.net/poem25452.html","الوافر"],[445,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[463,"إن كان فوق الشمس للساعي قدم","https://www.aldiwan.net/poem55866.html","الرجز"],[466,"عليك ذمام الله ما ذر شارق","https://www.aldiwan.net/poem15694.html","الطويل"],[556,"أفي كل وم لي منى أستجدها","https://www.aldiwan.net/poem47870.html","الطويل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18541","الوافر"],[1017,"","https://poetry.dctabudhabi.ae/diwan/poem/45207","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49602","الوافر"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114038","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65971","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59459","الوافر"],[5320,"القومسيون","https://www.poetsgate.com/ViewPoem.aspx?id=43254",""],[5582,"بِنَفْسِي هَوَىً بِالظَّاعِنِينَ كَوانِسا","https://www.poetsgate.com/ViewPoem.aspx?id=187157",""],[5582,"أَلا هَلْ تَوَلَّتْ نَوارٌ نَوارا","https://www.poetsgate.com/ViewPoem.aspx?id=186999",""],[5953,"ولي صاحب إذا كان تقديره الغنى","https://www.poetsgate.com/ViewPoem.aspx?id=93864",""]],"verses":[["وَكَيفَ رَجَوتُ أَن يَبقى سَليماً","وَما شُربُ القُرونِ لَهُ مُعَدُّ",0,"د",1,0],["وَكَيفَ رَأَيتَ الخَيرَ أَدبَرَ بَعدَهُ","عَلى الناسِ إِدبارَ السَحابِ الحَوافِلِ",1,"ل",1,0],["وكيف رُقاد الصَّبِّ ما بين سائقٍ","من الشوْق يُقريه النزاعَ وقائدِ",2,"د",1,0],["وَكَيفَ رَحيلي وَالفُؤادُ مُخَلَّفٌ","أَسيرٌ لَدَيها لا يُفَكُّ بِفادِ",3,"د",1,0],["وكيفَ رضيتَ هذا البعدَ لكنْ","قضاءُ الواحدِ الربِّ القديرِ",4,"ر",1,0],["وكيف رأيتَ بعد الحرب سِلْماً","تملأُ بالضغينةِ واللآمهْ",5,"م",2,0],["وكيفَ رَأيتَ الخيرَ أَدْبَرَ عَنْهُمُ","وَوَلَّى كإِدْبَارِ النَّعامِ الجوافلِ",6,"ل",1,0],["وكيفَ رددتُ غربَ الجيشِ عنهمْ","وَقَدْ أخَذَتْ مَآخِذَهَا الرّمَاحُ",7,"ح",1,0],["وكيف ركزت إلى جنبه","غمارة .. تهزأ بالأنجم..",8,"م",1,0],["وَكَيفَ رَدَدتُ الخَيلَ وَهيَ مُغيرَةٌ","بِزَوراءَ تُعطي بِاليَدَينِ وَتَمنَعُ",9,"ع",1,0],["وَكَيْفَ رَجَا ابْنُ سَوَّاقٍ نَجَاةً","ولَيسَ لِما عَنَاهُ بِالنَّجِيِّ",10,"ي",1,0],["وكَيف رضيتِ الليلَ مَلبَسَ طارِقٍ","وَمَا ذَرَّ قَرْنُ الشمس إِلّا استنارَكِ",11,"ك",1,0],["وكيف رُضتَ طفلَه على الصِّبا","وكيف رِشت شيخَه على الهَرَمْ",12,"م",1,0],["وكيف رِضاها في المَقامِ كئيبةً","وأنت مُرجَّاها وهذا كلامُها",13,"م",3,0],["وَكَيفَ رَجَوتمْ خيرَها وإزاءَكمْ","طلائحُ أرْداهنّ بالأمس كدُّها",14,"د",3,0],["وَكَيفَ رَجاءُ مَن غَلبَت عَلَيهِ","تَنائي الدارِ كَالرَحِمِ العَقيمِ",15,"م",1,0],["وَكَيفَ رَأَيتَ اللَهَ أَلقى عَلَيهِمُ ال","عَداوَةَ وَالبَغضاءَ بَعدَ التَواصُلِ",16,"ل",1,0],["وَكَيفَ رَأَيتَ الخَيرَ أَدبَرَ بَعدَهُ","عَنِ الناسِ إِدبارَ المَخاضِ الجَوافِلِ",16,"ل",1,0],["وكيفَ رَأتْ طليطلةُ العوالي","بحيثُ تغيثُ باسمكَ أو تُعين",17,"ن",1,0],["وكيف رقيت أفلاك المعالي","وصرت مع الكواكب في قران",18,"ن",1,0],["وكيف رضوا بالذل بعد ظهورهم","على الكل وانقادوا ورا كل ناعق",19,"ق",1,0],["وكيف رأيتَ رَاية يَا خَيالاً","أراني وصلتها بعدَ الصُّدود",20,"د",1,0],["وكيف رشفت رؤوس الهوا","ن ولم ترفضيها إلى سكبها",21,"ه",2,0],["وَكَيْفَ رَجائِي لِلشَّبابِ وَإِنَّنِي","أَرَى الشَّيْبَ داءً لِلْبَرِيَّةِ ناجِسا",22,"س",2,0],["وَكَيْفَ رَجائِي فِكاكاً لَهُ","وَبِالهَجْرِ قَدْ أَوْثَقَتْهُ هِجارا",23,"ر",2,0],["وكيف رجوع الجد منا بقوة","إلى همة حتى يعود إلى الكل",24,"ل",1,0]]}