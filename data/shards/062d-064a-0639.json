{"poems":[[88,"لا رعى الله عهدها من جدود","https://www.aldiwan.net/poem10688.html","الخفيف"],[95,"ألطيب في نفحات الروض حياني","https://www.aldiwan.net/poem11224.html","البسيط"],[107,"نادى الشباب فهب من إغفائه","https://www.aldiwan.net/poem42094.html","الكامل"],[193,"يا نسيماً سرى إلى قاسيونا","https://www.aldiwan.net/poem34874.html","الخفيف"],[193,"حي عني المليحة الحسناء","https://www.aldiwan.net/poem35144.html","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[242,"حي على الأنس إن طيف الهموم سرى","https://www.aldiwan.net/poem18192.html","البسيط"],[276,"قف بذات الاراك واندب طلولا","https://www.aldiwan.net/poem52065.html","الخفيف"],[287,"حي على أثلات يبرينا","https://www.aldiwan.net/poem32396.html","السريع"],[309,"يا وجيه إنها هب","https://www.aldiwan.net/poem16885.html","عموديه"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[354,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[422,"نبهت الورقاء ذات الجناح","https://www.aldiwan.net/poem54157.html","الطويل"],[463,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[482,"حي عني منحني الوادي وأثله","https://www.aldiwan.net/poem15200.html","الخفيف"],[482,"حي عني الحمى وحي المصلى","https://www.aldiwan.net/poem15265.html","الخفيف"],[519,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[567,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[869,"","https://poetry.dctabudhabi.ae/diwan/poem/145902","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59435","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56258","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136148","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79804","السريع"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66299","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66244","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53131","المنسرح"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95163","المنسرح"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136988",""],[3132,"","https://poetry.dctabudhabi.ae/diwan/poem/73669","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85244","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83183","الخفيف"],[5136,"أما ترى القمري غنى وصاح","https://www.poetsgate.com/ViewPoem.aspx?id=121546",""],[5431,"حيّ على خير الغزلْ","https://www.poetsgate.com/ViewPoem.aspx?id=189160",""],[5689,"ما بال دمعك ينهمر","https://www.poetsgate.com/ViewPoem.aspx?id=143433",""],[5689,"حي بدرا بافق مسرتا، تلالا","https://www.poetsgate.com/ViewPoem.aspx?id=143437",""],[6142,"حي على إقامة الصلاة","https://www.poetsgate.com/ViewPoem.aspx?id=155771",""],[6149,"سبحان من صاغه وكون","https://www.poetsgate.com/ViewPoem.aspx?id=169628",""]],"verses":[["حَيِّ عَهدَ الرَشادِ يا شَرقُ وَاِبلُغ","ما تَمَنَّيتَ مِن زَمانٍ بَعيدِ",0,"د",1,0],["حَيِّ عَوْناً لَهُ تَعْتَزُّ دَوْلَتُهُ","مِنْهُ بِرُكْنٍ قَوِيٍّ بَيْنَ أَرْكَانِ",1,"ن",1,0],["حيٌّ على مَرِّ الدُّهور مُدَجَّجٌ","تتساقطُ الأجيالُ حول لوائهِ",2,"ا",3,0],["حيِّ عنّي بالصالحيّةِ بحراً","مَلأ الكونَ لؤلؤاً مكنونا",3,"ن",2,0],["حيِّ عنّي شَمساً هنالك صينت","طبّقَ الشامَ نورُها والصينا",3,"ن",2,0],["حيّ عنّي المليحةَ الحسناءَ","زادَها اللَّه رفعةً وبهاءَ",4,"ا",2,1],["حَيِّ عَنّي عُرباً بِطَيبَةَ طابوا","طابَ فيهِم شِعري وَطابَ الثَناءُ",5,"ا",2,0],["حَيِّ عُرباً هُم سادَةُ الخَلقِ طُرّاً","لَهُمُ الناسُ أَعبُدٌ وَإِماءُ",5,"ا",2,0],["حَيِّ عَنّي سَلعاً وَحَيِّ العَوالي","حَبَّذا حَبَّذا هُناكَ العَلاءُ",5,"ا",2,0],["حَيِّ عَنّي العَقيقَ حَيِّ قُباء","أَينَ مِنّي العَقيقُ أَينَ قُباءُ",5,"ا",2,0],["حَيِّ عَنّي البَقيعَ وَالسَفحَ وَالمَس","جِدَ حَيثُ الأَنوارُ حَيثُ البَهاءُ",5,"ا",2,0],["حَيَّ على الأُنْسِ إِنْ طَيْفُ الْهُمومِ سَرى","وَسَلِّ نَفْسَكَ وَانْهَجْ نَهْجَ مَنْ صَبَرَا",6,"ر",2,1],["حيّ عبد الرَحمن أَعنى وَجيه الدين","الدين سيف الهدى الجراز الصَقيلا",7,"ل",2,0],["حَيِّ عَلى أَثلاتِ يبرينا","حوراً حِساناً خُرَّداً عينا",8,"ن",2,1],["حي عيداً بها فا","قت على كل عيد",9,"د",1,0],["حَيَّ عَلى تَصَوُّفٍ بِمِثلِهِ","فَليَطُلِ العُجبُ لِأَربابِ القِصَر",10,"ر",1,0],["حَيَّ عَلى مَورِدِ عَينٍ عَذَبَت","ما دونَها رَيٌّ وَلا عَنها صَدَر",10,"ر",1,0],["حَيَّ عَلى مَعرِفَتي لِأَنَّها","عَصا هَدىً تَلقَفُ ما الجَبتُ سَحَر",10,"ر",1,0],["حَيَّ عَلى مَعرِفَةِ الحُسنِ الَّذي","قَد وَهَبَ الحُسنَ لِرَبّاتِ الكِلَل",11,"ل",1,0],["حَيَّ على الراح وقم هاتها","وقل لمن لاح الفلاح الفلاح",12,"ح",1,0],["حيِّ على رغم البدورِ غُرَراً","تَقدحُ في فحم الدجى فَتثْقُبُ",13,"ب",1,0],["حَيَّ عنّي مُنحني الوادي وأثلَه","ورُبَى سَلْعٍ على النأي ورَمْلَهْ",14,"ل",2,1],["حيَّ عنّي الحمى وحيَّ المصلَّى","وزماناً بالرقمتينِ تولّى",15,"ل",2,1],["حيٌّ على الوادي كأنّ قِبابَه","كُثُبٌ ينوّعُها الحَيا ويُزَبْرِجُ",16,"ج",1,0],["حَيٌّ على حيِّ مَيٍّ مَيّتٌ لَحِقتْ","بذَيلِها نَفسُهُ لو تَمَّ رِيُّ ظَمِي",17,"م",2,0],["حيّ على ابن الحسن","حي على البدر السني",18,"ن",2,0],["حي على من جوده","كصوب ماء المزن",18,"ن",1,0],["حي عليم سامع","متكلم راء أحد",19,"د",1,0],["حيٌّ عزيزٌ قديرٌ خالقٌ وله","من في السماء ومن في الأرض قد سجدوا",20,"د",3,0],["حيعل وان شئت ان لا تنتهي فإلى","حقيقة الوجد منها القوم تصطيح",21,"ح",1,0],["حيَّ على الموتِ بني غالبٍ","ما أبرد الموت بِحرِّ الضبا",22,"ب",2,0],["حيّ عنِّي بالغريّ","ين وعج حيث الضريح",23,"ح",1,0],["حيّ على سوابق","لا تنتهي مدى المدى",24,"د",2,0],["حَيَّ عليها قبل الأذان فقد","أَذَّن شادٍ بها وشحرور",25,"ر",1,0],["حَيعَلَ ضِمنَ الأذَان ملتفتاً","فقلتُ شأن الغزالِ يلتفِتُ",26,"ت",1,0],["حي عني البلبل الشادي الذي","نظم الآيات من در ثمين",27,"ن",1,0],["حي عن بيروت والعرب بها","جلقا دار الكرام الفاتحين",27,"ن",1,0],["حَيَّ عَنِ المُدنَفِ المُعَنَّى","مَنبِتَكِ القَطرُ وَالقَبولُ",28,"ل",1,0],["حي عليم قدير والكلام له","فرد سميع بصير ما أراد جرى",29,"ر",2,0],["حَيِّ عِلماً كَالغَيثِ فاضَ وَخُلقاً","يُخجِلُ الرَوضَ حُسنُهُ وَحلاهُ",30,"ا",2,0],["حي على المراح يحي بها","أجوز ساحي العين جود رداح",31,"ح",1,0],["حيّ على خير الغزلْ","إمطرْ على العشق القُبلْ",32,"ل",1,1],["حيّ على دراقتي","ن كليهما مثل العسلْ",32,"ل",1,0],["حيّ على حلو اللقا","اشعل منارك بالأملْ",32,"ل",1,0],["حي على رغم البلى","باق على مر العصر",33,"ر",1,0],["حي عني حياله هالة قد","ألبسته مهابة وجلالا",34,"ل",2,0],["حي على إقامة الصلاة","فإنها من أكمل الطاعات",35,"ت",1,1],["حي على جوده فقدما","في الناس داعي نداه أذن",36,"ن",1,0]]}