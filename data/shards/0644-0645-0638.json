{"poems":[[87,"إلى عرفات الله يا خير زائر","https://www.aldiwan.net/poem63776.html","الطويل"],[422,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63985","الكامل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82621","المنسرح"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88911","الوافر"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45772","الطويل"]],"verses":[["لِمُظهِرِ دينِ اللَهِ فَوقَ تَنوفَةٍ","وَباني صُروحِ المَجدِ فَوقَ فَلاةِ",0,"ه",1,0],["لم ظهوراً وترفع الإِيهاما","فتراه إذا تأَمَّلْتَ فيه",1,"ه",1,0],["لَمَّظتُ شعري طَعْمَ ظائك إذ حكت","طعماً بحلاوةِ الألفاظ",2,"ظ",1,0],["لَمَّظته قَوتَه وَفيك لَهُ","لَو قَد تَقَضّت أَقواتُه شِبَع",3,"ع",1,0],["لمظهر عابد الرحمن بيك","مديحي قد صبا فانظر بحاري",4,"ي",1,1],["لمظهر عابد الرحمن بيك","مديحي قد صبا فانظر بحاء",4,"ا",2,0],["لمظهر عابد الرحمن بيك","مديحي قد صبا فانظر بحالي",4,"ي",1,0],["لِمَظهر عز قَد سَما سَعد طالع","بِمَولده يمناً تَسر العَشائر",5,"ر",1,1]]}