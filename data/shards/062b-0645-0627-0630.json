{"poems":[[26,"نام الخلي وبت الليل مشتجرا","https://www.aldiwan.net/poem24088.html","البسيط"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[124,"تضحك عن طلها غلائلها","https://www.aldiwan.net/poem49331.html","المنسرح"],[202,"رب حمام تلظى","https://www.aldiwan.net/poem51915.html","مجزوء الرمل"],[236,"يا قسوة القلب مالي حيلة فيك","https://www.aldiwan.net/poem44559.html","البسيط"],[358,"ته دلالا أيها القمر","https://www.aldiwan.net/poem40228.html","المديد"],[369,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[396,"يا أهل العقول السالمه وأهل القلوب العالمه","https://www.aldiwan.net/poem54450.html","عموديه"],[398,"المجد أجمع ما حوته يميني","https://www.aldiwan.net/poem53666.html","الكامل"],[449,"لست أنسى عهد ليل قريب","https://www.aldiwan.net/poem56036.html","المديد"],[563,"كواكب جرت من السماء","https://www.aldiwan.net/poem35083.html","الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"يا ذا الذي يطربه كلما","https://www.aldiwan.net/poem3016.html","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63741","الرجز"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202130","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126121","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136094","الكامل"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128281","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119226","الرمل"],[2305,"","https://poetry.dctabudhabi.ae/diwan/poem/143179","السريع"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123479",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94154","الرمل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87414","المقتضب"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112629","الرجز"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66435","الرمل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118775","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111427","الخفيف"],[5145,"بينما راودته عن قبلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=108076",""]],"verses":[["ثُمَّ إِذا فارَقَ الأَغمادَ حُشوَتُها","وَصَرَّحَ المَوتُ إِنَّ المَوتَ تَصريحُ",0,"ح",1,0],["ثُمَّ إِذا ما قامَ عَن غِذائِهِ","وَفُرِّغَت قَهوَتُهُ بِمائِهِ",1,"ه",1,0],["ثُمَّ إِذ رِياحُ عفَت","رَسمَ مُلكِ حِميَرِها",2,"ر",3,0],["ثم إذ بلى كي تريه مصرعه","فكل حسن بالترب يلتطم",3,"م",1,0],["ثمّ أذرى عبراتٍ","صَوْبُها بالوجد ناطقْ",4,"ق",1,0],["ثم اذكري غصص الموت الفظيع يهن","عليك أكدار دنيا لا تصافيك",5,"ك",1,0],["ثُمَّ أَذكَت لَوعَتي فَذَكت","فَهيَ لا تبقي وَلا تَذرُ",6,"ر",1,0],["ثمّ إذا عادَى جَهَر","ولا يماشِيكَ الخَمَر",7,"ر",1,0],["ثم إذا مته أتوك وغسلوك وكفنوك","وشيعوك وألحدوك",8,"ك",1,0],["ثُمَّ اِذكُر الأَحزابَ وَاِذكُر سَيفَهُ","أَسَدٌ يُلاقي الحَربَ بِالتَبنينِ",9,"ن",1,0],["ثم إذ كنت أسوق الحديث","قد تصدّى لي هذا الخبيث",10,"ث",1,0],["ثم إذا أراد زادكم به","حق اليقين حضرة انتهاء",11,"ا",2,0],["ثم إذا بدا له في الإقتدا","عاد إلى التي بها كان بدا",12,"د",2,0],["ثُمَّ إِذا قيل له إِنَّهُ","عادَ سلِيماً عادَ مِثلَ السَّلِيم",13,"م",1,0],["ثم إذا آل إلى الإظهار","أهداهُ كانون إلى آذار",14,"ر",1,0],["ثم إذا ما الخوف يوما ذهبا","اتخذوا ثَلْبِي وَسبِّى مذهبا",15,"ب",2,0],["ثم اذا كان لذاك محمل","معين عليه حتماً يحمل",16,"ل",1,0],["ثم اذكري موت الحبيب محمد","خير الانام وسيد الشفعاء",17,"ا",2,0],["ثم إذا أزلت عنها ظلها","وقد صرفت عقدها وحلها",18,"ه",2,0],["ثم إذا جثت به من مقتضب","عولات مس مستفعلن عن انتصب",19,"ب",1,0],["ثم اذا توسط المريدُ","فالبحث بابٌ منه يستفيدُ",20,"د",1,0],["ثم إذ ذلك في سلة","إسحاق الذبيح",21,"ح",1,0],["ثم إذا طالعته ثانيا","رأيت تصحيفا فأصلحته",22,"ه",1,0],["ثم أذوا وديعة لذويها","خلفوها وشملها مكفول",23,"ل",1,0],["ثم إذ أحدث ذقناً","نزلت تشبه حريه",24,"ي",2,0],["ثُمَّ اذ رآكِ غدا","عاذِلاً ذوي العذَلِ",25,"ل",1,0],["ثم أُذرّى بعدُ في الهواءِ","ما مِلتُ عن نَصري ولا ولائي",26,"ي",1,0],["ثم اذا انتهوا من الزياره","يرخي عليها الحافظ الستاره",27,"ه",1,0],["ثم إذ بلغت مقصودها","في جوار البيت حلّت قاطنه",28,"ن",2,0],["ثم إذا به الكلام تمَّا","فالفعل تام عندهم يسمّى",29,"م",2,0],["ثُمَّ أَذكَت بِها حَنِيناً وَوَجدَا","لِمَنيلا والأَهلِ وَالأَوطانِ",30,"ن",1,0],["ثم إذا طاوع زادت حرقاً","يصبح القلب له ملتهبا",31,"ب",2,0]]}