{"poems":[[74,"ما لظبي الحمى إليه التفاته","https://www.aldiwan.net/poem18387.html","الخفيف"],[74,"جار الزمان علي بعدكم","https://www.aldiwan.net/poem18917.html","أحذ الكامل"],[74,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[53,"عيني إلى من أحب تختلج","https://www.aldiwan.net/poem9241.html","المنسرح"],[72,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[87,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[87,"طال عليها القدم","https://www.aldiwan.net/poem63695.html","مجزوء السريع"],[45,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[47,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[46,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[107,"قم ودع الأوثان والأصناما","https://www.aldiwan.net/poem44047.html","الكامل"],[52,"لاح الهوى واستنار العدل والبصر","https://www.aldiwan.net/poem63824.html","البسيط"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85464","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202551","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[108,"استعطاف وتبرئة","https://www.poetsgate.com/ViewPoem.aspx?id=179393",""],[69,"وكتابُ شعيا مخبرٌ عن ربهِ","https://www.poetsgate.com/ViewPoem.aspx?id=14561",""],[69,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[139,"مني لسيد الزجاله","https://www.aldiwan.net/poem48846.html","عموديه"],[202,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[215,"فررت منكم إليكم","https://www.aldiwan.net/poem46284.html","المجتث"],[215,"سمعت صوتك والهتاف ينقله","https://www.aldiwan.net/poem46324.html","البسيط"],[234,"بعثته يحكيك في بعض ما","https://www.aldiwan.net/poem50751.html","السريع"],[234,"الآن قد الفؤاد نصفين","https://www.aldiwan.net/poem50780.html","المنسرح"],[270,"الغبيط","https://www.aldiwan.net/poem8370.html","عموديه"],[287,"تب يا عذولي عن ملامي واتئب","https://www.aldiwan.net/poem32884.html","الرجز"],[308,"لو طلع العارض في خده","https://www.aldiwan.net/poem57924.html","الطويل"],[463,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[473,"لنا نديم دنس الخبر","https://www.aldiwan.net/poem60079.html","السريع"],[556,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[567,"قف بالعقيق وسل نسيم رياحه","https://www.aldiwan.net/poem52903.html","الكامل"],[568,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83310","المنسرح"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88602","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48671","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48728","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59529","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120117","المنسرح"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59128","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96693","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96645","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126123","الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145155","المنسرح"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82275","السريع"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93111","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109315","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28578","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93708","السريع"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105388","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94270","الكامل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122484","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200615","البسيط"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140294",""],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216556",""],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112323","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138513",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129376","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59440","الرجز"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76479","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77176","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125830","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101350","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36297","الدوبيت"],[4169,"","https://poetry.dctabudhabi.ae/diwan/poem/116601","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136596",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33232","المنسرح"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120380","الكامل"],[4731,"غروب","https://www.poetsgate.com/ViewPoem.aspx?id=978",""],[4805,"شمر","https://www.poetsgate.com/ViewPoem.aspx?id=176496",""],[4829,"ولاد المضا","https://www.poetsgate.com/ViewPoem.aspx?id=36743",""],[4987,"قلوب الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=49574",""],[5038,"نسائم المقل","https://www.poetsgate.com/ViewPoem.aspx?id=189850",""],[5118,"تلاوة حكيمة","https://www.poetsgate.com/ViewPoem.aspx?id=130106",""],[5121,"الغزل الطهور","https://www.poetsgate.com/ViewPoem.aspx?id=37451",""],[5193,"صقور سلاح الجو","https://www.poetsgate.com/ViewPoem.aspx?id=213567",""],[5198,"كلّك نظر","https://www.poetsgate.com/ViewPoem.aspx?id=135393",""],[5344,"صامت","https://www.poetsgate.com/ViewPoem.aspx?id=180709",""],[5397,"بكيت شجواً على الأطلال والدمن","https://www.poetsgate.com/ViewPoem.aspx?id=157909",""],[5495,"تغطيت","https://www.poetsgate.com/ViewPoem.aspx?id=175431",""],[5582,"دَعْهُ يَحِنُّ لِشَجْوِهِ وَشُجُونِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63583",""],[5756,"الاسطورة","https://www.poetsgate.com/ViewPoem.aspx?id=5416",""],[5756,"الذهب","https://www.poetsgate.com/ViewPoem.aspx?id=5187",""],[5813,"صدر الشّمالي","https://www.poetsgate.com/ViewPoem.aspx?id=176829",""],[5842,"أنين الشام/ محمد الرحمون","https://www.poetsgate.com/ViewPoem.aspx?id=113403",""],[6008,"شفت الخبل","https://www.poetsgate.com/ViewPoem.aspx?id=59161",""],[6124,"لو طفت","https://www.poetsgate.com/ViewPoem.aspx?id=201225",""],[6124,"الفارس الذي لا يأتي","https://www.poetsgate.com/ViewPoem.aspx?id=201237",""],[6255,"الحُزْنُ جَادَ أَبًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80883&r=&rc=11",""]],"verses":[["لو طلبنا له شبيهاً من الده","ر لكنا كطالبٍ إعنَاته",0,"ت",2,0],["لو طاب طابَ لي الحياة إذاً","ولقيتكم بفضيحة العذر",1,"ر",1,0],["لو طاولتكم نجوم الأفق ما بلغت","قوادم النسر منكم ترب أقدام",2,"م",1,0],["لو طلعتْ في الظلام غُرَّتُها","ظلت سُتُورُ الظلام تنفرجُ",3,"ج",1,0],["لَو طارَ في الهَيجاءِ عَن يَدِ قاذِفٍ","ذابَ الحَديدُ لَهُ وَريعَ الأُسرُبُ",4,"ب",1,0],["لَو طَمعت في مُلكِهِ أَولادُهُ","شَفاهمو مشن طَمع جَلّادُهُ",5,"ه",1,0],["لَو طَلَبَ الطَيرَ مِن","أَيكَتِهِ ما اِحتَرَم",6,"م",1,0],["لَو طابَ مَولِدُ كُلِّ حَيٍّ مِثلَهُ","وَلَدَ النِساءُ وَما لَهُنَّ قَوابِلُ",7,"ل",1,0],["لَو طَلَبنا بَلَّةً مِن ريقِهِ","وُجِدَت أَعمَقَ مِن بِئرِ العُمَق",8,"ق",1,0],["لَو طاوَعَتكَ الخَيلُ لَم تَقفُل بِها","وَالقُفلُ فيهِ شَباً وَلا مِسمارُ",9,"ر",1,0],["لو طَاوعَ النَّاسُ الطبيبَ لما اشتكى","مَن يَحملُ الأدواءَ والآلاما",10,"م",2,0],["لَو طالَعَت مِن ثَلاثِ المِصرِ واحِدَةٌ","مُعَمَّرينَ عَلى السَرّاءِ ما عُمِروا",11,"ر",3,0],["لو طَوَيْتُمْ نُصْحَ جارٍ لم يكُنْ","فيه يوماً يألُ طَيّاً يالَ طي",12,"ي",1,0],["لَو طابَ عيشي في العِراق كعهده","ما كانَ في قَلبي له بَغضاءُ",13,"ا",2,1],["لو طمعت في ملكه أولاده","شفاهمو من طمع جلاّده",14,"ه",1,0],["لَوْ طَبَّقَ السَّبْعَ النَّعِي","بُ أَيُطْرِبُ السَّمْعَ النَّعِيبُ",15,"ب",1,0],["لو طال صبرُكِ في المكارهِ ساعةً","لرأيتِ أنّ الموتَ قد يُنجيك",16,"ك",1,0],["لو طأطأ الرأس صقرٌ عاش في دَعَةٍ","ولم يَعِشْ في فِجَاجِ الأرض مغتربا",17,"ب",2,0],["لوطٍ فكيفَ بِقَذْفِهِمْ رُوبِيلا","عزَّا وطابتْ منزلاً ونزيلا",18,"ل",2,0],["لوطٍ فكيفَ بِقَذْفِهِمْ رُوبِيلا","قَوْلاً مِنَ السِّرِّ المَصُونِ ثَقِيلا",19,"ل",2,0],["لو طُلت لك شَفطةْ طرشي","لقلت دي الأشيا معدن",20,"ن",1,0],["لو طلب العنقا على متنهِ","راكبُهُ ما فاتَهُ مَطلبُ",21,"ب",1,0],["لو طار روحي إليكم","لقال روحي وقلتم",22,"م",1,0],["لو طاب لي فضح أمري في محبتكم","لما استبحتم برغم الشوق هجراني",23,"ن",2,0],["لو طُويَ الجود إذا أصبحتْ","لِطيِّهِ كفُّك عُنْوانا",24,"ن",2,0],["لو طاولت أرضها النجوم علت","به على النَّسْرِ والسِماكينِ",25,"ن",1,0],["لو طاحَ الغبيطُ بنا قليلاً","لم نَمُتْ",26,"ت",1,0],["لَو طَرَقَت سَمعَ السَرِيِّ لَم يَقُل","عَرج عَلى ذاكَ الكَثيبِ مِن كَثَب",27,"ب",1,0],["لو طلع العارض في خده","كان غرامي نزهةَ السامعِ",28,"ع",1,1],["لو طاول الغَمْرُ المغفَّلُ خُلقَه","شيئاً تعلَّم منه كيفَ يسودُ",29,"د",1,0],["لَو طَبَخَ المَرءُ عَلى فَرسَخٍ","أَتاهُ مِن ساعَتِهِ يَجري",30,"ي",1,0],["لَو طاوَلوا النّجمَ لم يطلعْ على أحدٍ","أو صاولوا النّارَ لم تظهرْ لقدّاحِ",31,"ح",1,0],["لو طارَ شوقٌ قَبلَها بصَحيفةٍ","طارَتْ إليهِ على خُفُوقِ جَناحهِ",32,"ح",2,0],["لَو طُلِبَ العِلمُ بِالفَخرِ بِهِ لأَبى","إِلّا لِرَبِّ السَمَواتِ الَّذي فَطَرا",33,"ر",2,0],["لَو طَبَّقَتهُ أَيدي الوَرى عَمَلاً","عضلى فِلَسطينَ فاضَتِ المِيَرُ",34,"ر",1,0],["لَو طاوَلَت ارما ذات العماد اذاً","لطال سمك مبانيها على أرم",35,"م",1,0],["لو طهر الدم آثماً من رجسه","لم يبق مأثوم ولا مأزور",36,"ر",1,0],["لو طال عمرك حقبة وصنعت ما","أزمعت صنت ولاية تتبدد",37,"د",1,0],["لو طِقتُ عنه صَبراً","ما بُحتُ بالذي بي",38,"ب",2,0],["لو طب من جهله مريضاًَ","وجئتموا كي تشاهدوهُ",39,"ه",1,1],["لَوْ طَاوَلَتْهُ النُّجُومُ الزُّهْرُ مَا بَلَغَتْ","مِنْ نَسْرِ عَلْيَاهُ إلاَّ تُرْبَ أنْعَالِ",40,"ل",1,0],["لو طلبتَ النجمَ ثأراً","نلتَ منهُ أخذ ثارِك",41,"ك",1,0],["لَو طبع أنملهِ يحلُّ بجلمدٍ","يوماً لأورقً منه ذاك الجلمدُ",42,"د",1,0],["لو طبخ الطباخ ألف قدر","بالماء واللحم وحب البر",43,"ر",1,0],["لو طاف مسراكا","بالليث ما صالا",44,"ل",2,0],["لَو طُلِيَت جَلدَتُهُ عَنبَرا","لَنَتَّنَت جلدَتُهُ العَنبَرا",45,"ر",2,0],["لو طاول القدرَ امرؤٌ","وعلاه طلتهما اقتدارا",46,"ر",2,0],["لو طال لاتخذ العرش المنير لها","سقفا ودقَّ دراريه مساميرا",47,"ر",2,0],["لَو طَابَ مِنكَ الوردُ طَابَت كُلُّهَا","أنَّى تَطِيبُ مَوَاردُ الأنتَانِ",48,"ن",1,0],["لَو طَلَبوا سِلمَكَ كانَت لَهُم","قُربى عَلى وُدِّكَ مُحتالَه",49,"ل",2,0],["لَو طفح المَحل بِأَمواجه","وَقيل لَيسَ اليَوم مِن عاصم",50,"م",1,0],["لو طلبتم لي مزيداً في الهوى","ما وجدتم فوق ما في مزيدا",51,"د",2,0],["لو طاف يسعى بالسلاف لخلته","بدراً تلوح بكفه شمس الضحى",52,"ا",1,0],["لو طَال عُمرٌ فِي الحياةِ لمُبدِعٍ","لبقيتَ ما نظمَ البديع طويلُ",53,"ل",1,0],["لو طاوع الروضُ ذوق الناظرين له","في نفي مالم يرُقْ لم يبقَ من زهر",54,"ر",1,0],["لو طالبوا النجم يوماً أن يدين به","لهم لنالوا به أضعاف ما طلبوا",55,"ب",3,0],["لو طاعت الخِدّام الاعمام","ما ريت مِثلي فِيْ الهوى مطيع",56,"ع",1,0],["لَو طرت في أعلى السما","ءِ محَلّقاً كَالزّابِلين",57,"ن",1,0],["لو طار الوهم إلى المحشر","ادنى درجاتك ما ابصر",58,"ر",1,0],["لو طار سهمك في اربيل عن هدف","فالصدر تالله بالكردي ما صدرا",59,"ر",2,0],["لو طَلبَ الموتُ نزالي في الوغى","جَدلته بالمُرهفِ الماضي الشَّبَا",60,"ا",1,0],["لَو طاوَعتَني حَياتي وَهيَ شارِدَة","مِمّا اعد لها ما عشت في هرج",61,"ج",1,0],["لَوطئته كَم ذل غَلب عُداتِهِ","وَعَن شِمَمٍ بِالسَيفِ أَرغَم مُعطَس",62,"س",1,0],["لو طهروا الأَهواءَ من أَطماعها","لغدا شِقاقُ القوم وهو وِفَاق",63,"ق",1,0],["لو طال طول المدى تفصيل ناعتهم","لم تبلغ الزند هاتيك التفاصيل",64,"ل",1,0],["لَو طوّقتِ التائِبَ وَاللَهِ يَدا","في أَلف يَمينٍ لزمته حَنَثا",65,"ث",2,0],["لو طافَ في شرقِ البِلاد وغربِها","لم يلقَ إلا حامداً لك لاقِ",66,"ق",1,0],["لو طويتم صَحائف الهجرَ عنا","لنَشرنا صحائف الأشواق",67,"ق",1,0],["لو طلبت فيه غيرَ حُجتِها","عينٌ على العاذلينَ لم تجدِ",68,"د",1,0],["لو طاوعوه لاصبحوا حظى الورى","تقنيهم الاعمال والآمال",69,"ل",1,0],["لو طويت ا