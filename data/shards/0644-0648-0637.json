{"poems":[[72,"ما لظبي الحمى إليه التفاته","https://www.aldiwan.net/poem18387.html","الخفيف"],[72,"جار الزمان علي بعدكم","https://www.aldiwan.net/poem18917.html","أحذ الكامل"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[51,"عيني إلى من أحب تختلج","https://www.aldiwan.net/poem9241.html","المنسرح"],[70,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[85,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[85,"طال عليها القدم","https://www.aldiwan.net/poem63695.html","مجزوء السريع"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[105,"قم ودع الأوثان والأصناما","https://www.aldiwan.net/poem44047.html","الكامل"],[50,"لاح الهوى واستنار العدل والبصر","https://www.aldiwan.net/poem63824.html","البسيط"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85464","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202551","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[106,"استعطاف وتبرئة","https://www.poetsgate.com/ViewPoem.aspx?id=179393",""],[67,"وكتابُ شعيا مخبرٌ عن ربهِ","https://www.poetsgate.com/ViewPoem.aspx?id=14561",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""]],"verses":[["لو طلبنا له شبيهاً من الده","ر لكنا كطالبٍ إعنَاته",0,"ت",2,0],["لو طاب طابَ لي الحياة إذاً","ولقيتكم بفضيحة العذر",1,"ر",1,0],["لو طاولتكم نجوم الأفق ما بلغت","قوادم النسر منكم ترب أقدام",2,"م",1,0],["لو طلعتْ في الظلام غُرَّتُها","ظلت سُتُورُ الظلام تنفرجُ",3,"ج",1,0],["لَو طارَ في الهَيجاءِ عَن يَدِ قاذِفٍ","ذابَ الحَديدُ لَهُ وَريعَ الأُسرُبُ",4,"ب",1,0],["لَو طَمعت في مُلكِهِ أَولادُهُ","شَفاهمو مشن طَمع جَلّادُهُ",5,"ه",1,0],["لَو طَلَبَ الطَيرَ مِن","أَيكَتِهِ ما اِحتَرَم",6,"م",1,0],["لَو طابَ مَولِدُ كُلِّ حَيٍّ مِثلَهُ","وَلَدَ النِساءُ وَما لَهُنَّ قَوابِلُ",7,"ل",1,0],["لَو طَلَبنا بَلَّةً مِن ريقِهِ","وُجِدَت أَعمَقَ مِن بِئرِ العُمَق",8,"ق",1,0],["لَو طاوَعَتكَ الخَيلُ لَم تَقفُل بِها","وَالقُفلُ فيهِ شَباً وَلا مِسمارُ",9,"ر",1,0],["لو طَاوعَ النَّاسُ الطبيبَ لما اشتكى","مَن يَحملُ الأدواءَ والآلاما",10,"م",2,0],["لَو طالَعَت مِن ثَلاثِ المِصرِ واحِدَةٌ","مُعَمَّرينَ عَلى السَرّاءِ ما عُمِروا",11,"ر",3,0],["لو طَوَيْتُمْ نُصْحَ جارٍ لم يكُنْ","فيه يوماً يألُ طَيّاً يالَ طي",12,"ي",1,0],["لَو طابَ عيشي في العِراق كعهده","ما كانَ في قَلبي له بَغضاءُ",13,"ا",2,1],["لو طمعت في ملكه أولاده","شفاهمو من طمع جلاّده",14,"ه",1,0],["لَوْ طَبَّقَ السَّبْعَ النَّعِي","بُ أَيُطْرِبُ السَّمْعَ النَّعِيبُ",15,"ب",1,0],["لو طال صبرُكِ في المكارهِ ساعةً","لرأيتِ أنّ الموتَ قد يُنجيك",16,"ك",1,0],["لو طأطأ الرأس صقرٌ عاش في دَعَةٍ","ولم يَعِشْ في فِجَاجِ الأرض مغتربا",17,"ب",2,0],["لوطٍ فكيفَ بِقَذْفِهِمْ رُوبِيلا","عزَّا وطابتْ منزلاً ونزيلا",18,"ل",2,0],["لوطٍ فكيفَ بِقَذْفِهِمْ رُوبِيلا","قَوْلاً مِنَ السِّرِّ المَصُونِ ثَقِيلا",19,"ل",2,0]]}