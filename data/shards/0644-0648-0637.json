{"poems":[[72,"ما لظبي الحمى إليه التفاته","https://www.aldiwan.net/poem18387.html","الخفيف"],[72,"جار الزمان علي بعدكم","https://www.aldiwan.net/poem18917.html","أحذ الكامل"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[51,"عيني إلى من أحب تختلج","https://www.aldiwan.net/poem9241.html","المنسرح"],[70,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[85,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[85,"طال عليها القدم","https://www.aldiwan.net/poem63695.html","مجزوء السريع"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[105,"قم ودع الأوثان والأصناما","https://www.aldiwan.net/poem44047.html","الكامل"],[50,"لاح الهوى واستنار العدل والبصر","https://www.aldiwan.net/poem63824.html","البسيط"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85464","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202551","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[106,"استعطاف وتبرئة","https://www.poetsgate.com/ViewPoem.aspx?id=179393",""],[67,"وكتابُ شعيا مخبرٌ عن ربهِ","https://www.poetsgate.com/ViewPoem.aspx?id=14561",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[136,"مني لسيد الزجاله","https://www.aldiwan.net/poem48846.html","عموديه"],[199,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[212,"فررت منكم إليكم","https://www.aldiwan.net/poem46284.html","المجتث"],[212,"سمعت صوتك والهتاف ينقله","https://www.aldiwan.net/poem46324.html","البسيط"],[230,"بعثته يحكيك في بعض ما","https://www.aldiwan.net/poem50751.html","السريع"],[230,"الآن قد الفؤاد نصفين","https://www.aldiwan.net/poem50780.html","المنسرح"],[266,"الغبيط","https://www.aldiwan.net/poem8370.html","عموديه"],[283,"تب يا عذولي عن ملامي واتئب","https://www.aldiwan.net/poem32884.html","الرجز"],[304,"لو طلع العارض في خده","https://www.aldiwan.net/poem57924.html","الطويل"],[459,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[469,"لنا نديم دنس الخبر","https://www.aldiwan.net/poem60079.html","السريع"],[552,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[563,"قف بالعقيق وسل نسيم رياحه","https://www.aldiwan.net/poem52903.html","الكامل"],[564,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"]],"verses":[["لو طلبنا له شبيهاً من الده","ر لكنا كطالبٍ إعنَاته",0,"ت",2,0],["لو طاب طابَ لي الحياة إذاً","ولقيتكم بفضيحة العذر",1,"ر",1,0],["لو طاولتكم نجوم الأفق ما بلغت","قوادم النسر منكم ترب أقدام",2,"م",1,0],["لو طلعتْ في الظلام غُرَّتُها","ظلت سُتُورُ الظلام تنفرجُ",3,"ج",1,0],["لَو طارَ في الهَيجاءِ عَن يَدِ قاذِفٍ","ذابَ الحَديدُ لَهُ وَريعَ الأُسرُبُ",4,"ب",1,0],["لَو طَمعت في مُلكِهِ أَولادُهُ","شَفاهمو مشن طَمع جَلّادُهُ",5,"ه",1,0],["لَو طَلَبَ الطَيرَ مِن","أَيكَتِهِ ما اِحتَرَم",6,"م",1,0],["لَو طابَ مَولِدُ كُلِّ حَيٍّ مِثلَهُ","وَلَدَ النِساءُ وَما لَهُنَّ قَوابِلُ",7,"ل",1,0],["لَو طَلَبنا بَلَّةً مِن ريقِهِ","وُجِدَت أَعمَقَ مِن بِئرِ العُمَق",8,"ق",1,0],["لَو طاوَعَتكَ الخَيلُ لَم تَقفُل بِها","وَالقُفلُ فيهِ شَباً وَلا مِسمارُ",9,"ر",1,0],["لو طَاوعَ النَّاسُ الطبيبَ لما اشتكى","مَن يَحملُ الأدواءَ والآلاما",10,"م",2,0],["لَو طالَعَت مِن ثَلاثِ المِصرِ واحِدَةٌ","مُعَمَّرينَ عَلى السَرّاءِ ما عُمِروا",11,"ر",3,0],["لو طَوَيْتُمْ نُصْحَ جارٍ لم يكُنْ","فيه يوماً يألُ طَيّاً يالَ طي",12,"ي",1,0],["لَو طابَ عيشي في العِراق كعهده","ما كانَ في قَلبي له بَغضاءُ",13,"ا",2,1],["لو طمعت في ملكه أولاده","شفاهمو من طمع جلاّده",14,"ه",1,0],["لَوْ طَبَّقَ السَّبْعَ النَّعِي","بُ أَيُطْرِبُ السَّمْعَ النَّعِيبُ",15,"ب",1,0],["لو طال صبرُكِ في المكارهِ ساعةً","لرأيتِ أنّ الموتَ قد يُنجيك",16,"ك",1,0],["لو طأطأ الرأس صقرٌ عاش في دَعَةٍ","ولم يَعِشْ في فِجَاجِ الأرض مغتربا",17,"ب",2,0],["لوطٍ فكيفَ بِقَذْفِهِمْ رُوبِيلا","عزَّا وطابتْ منزلاً ونزيلا",18,"ل",2,0],["لوطٍ فكيفَ بِقَذْفِهِمْ رُوبِيلا","قَوْلاً مِنَ السِّرِّ المَصُونِ ثَقِيلا",19,"ل",2,0],["لو طُلت لك شَفطةْ طرشي","لقلت دي الأشيا معدن",20,"ن",1,0],["لو طلب العنقا على متنهِ","راكبُهُ ما فاتَهُ مَطلبُ",21,"ب",1,0],["لو طار روحي إليكم","لقال روحي وقلتم",22,"م",1,0],["لو طاب لي فضح أمري في محبتكم","لما استبحتم برغم الشوق هجراني",23,"ن",2,0],["لو طُويَ الجود إذا أصبحتْ","لِطيِّهِ كفُّك عُنْوانا",24,"ن",2,0],["لو طاولت أرضها النجوم علت","به على النَّسْرِ والسِماكينِ",25,"ن",1,0],["لو طاحَ الغبيطُ بنا قليلاً","لم نَمُتْ",26,"ت",1,0],["لَو طَرَقَت سَمعَ السَرِيِّ لَم يَقُل","عَرج عَلى ذاكَ الكَثيبِ مِن كَثَب",27,"ب",1,0],["لو طلع العارض في خده","كان غرامي نزهةَ السامعِ",28,"ع",1,1],["لو طاول الغَمْرُ المغفَّلُ خُلقَه","شيئاً تعلَّم منه كيفَ يسودُ",29,"د",1,0],["لَو طَبَخَ المَرءُ عَلى فَرسَخٍ","أَتاهُ مِن ساعَتِهِ يَجري",30,"ي",1,0],["لَو طاوَلوا النّجمَ لم يطلعْ على أحدٍ","أو صاولوا النّارَ لم تظهرْ لقدّاحِ",31,"ح",1,0],["لو طارَ شوقٌ قَبلَها بصَحيفةٍ","طارَتْ إليهِ على خُفُوقِ جَناحهِ",32,"ح",2,0],["لَو طُلِبَ العِلمُ بِالفَخرِ بِهِ لأَبى","إِلّا لِرَبِّ السَمَواتِ الَّذي فَطَرا",33,"ر",2,0]]}