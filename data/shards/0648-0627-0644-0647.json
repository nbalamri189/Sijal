ابي اليومَ عن وطني","وكل بأسىِ دموعٌ لي أوزعها",227,"ع",3,0],["والَهْفَتَى إلى صدي","ق قال خيراً فصدقْ",228,"ق",1,0],["وآلُهُ وهُمُ آل الإله وهم","رعاة ذا الدين ضيموا بعده ورُعُوا",229,"ع",3,0],["والهضبةُ الملساءُ تَم","نعُ أن يداسَ خَبارُها",230,"ر",3,0],["والهمُّ داءُ أن لم تداركه بال","هجر دواء أنضاك أو قتلك",231,"ك",1,0],["والهوى يسأل عن أعطافهم","والتثني قضبَ البان الغيارى",232,"ر",2,0],["وآله والصحب والتابعين","هداة الأنام على الأبد",233,"د",1,0],["والهوى كالكهربا في جذبها","جرّنا للغيد جرّ الرسن",234,"ن",1,0],["وآله ينبوع المعارف كلها","وأصحابه أهل الهدى تتوقد",235,"د",1,0],["وآله أهل الإرث ما قد تماسكت","بهم حبل الأكوان في الصدع والكسر",236,"ر",1,0],["وآله والأصحاب طرا بلا عد","وأحبابه جمعا مقيما بلا حصر",237,"ر",1,0],["والهَمُّ مَا لَمْ تُمْضِهِ لِسَبِيْلِهِ","لَيْسَ المُفَارِقُ يَا أُمَيْمَ كَمَنْ نَأَى",238,"ا",1,0],["وآلِهِ والصِّحابِ الطَّاهِرينَ فهُمْ","نِعْمَ الرِّجالِ الشَّآبيبُ البَهاليلُ",239,"ل",1,0],["وآلِهِ وصَحْبِهِ ساداتِنا","أُولي الإغاثاتِ إذا طَمَّ الوَجَلْ",240,"ل",1,0],["والهْفَتاهُ قد أعاقَني النَّوى","ورُبَّ يومٍ تَكْثُرُ العَوائِقُ",241,"ق",1,0],["وآلِهِ والصِّحابَ الخَيِّرينَ فهم","يَجري السَّلامُ عَليهمْ كُلَّما ذُكِروا",242,"ر",3,0],["والهاشِمِيُّ نبيِّي","واللهُ قُدِّسَ ربِّي",243,"ب",2,0],["والهجرُ أطولُنا والوصلُ أقصرُنا","والبغضُ أسمنُنا والحبُّ قد نحَلا",244,"ل",2,0],["والهمُّ أكثرُنا إنْ أحصيَ العددُ","والرأس في أوّل العمرِ قدِ اشتعلا",244,"ل",2,0],["والهمّ قد تجسّدْ","والقلبُ صارَ أصْلدْ",245,"د",1,0],["والهامُ تدري وإنْ عزّت سيلزَمُها","ذلُّ السُّجودِ إذا صلّتْ مَواضيهِ",246,"ي",2,0],["والهوى بادي وخلخال الخنا","سوقه النّادي وطبّال يدور",247,"ر",1,0],["وآلِهِ وصَحْبِهِ","حُلاَّلِ عُقْدِ الْمِحَنِ",248,"ن",1,0],["والْهَضْبَ مَنْ عِلْمِ الْبَيَانِ أَشَادَهُ","وبِهِ تَطاوَلَ أَطْوَلٌ وَمُطَوَّلُ",249,"ل",1,0],["وآلِهِ الأَئِمةِ","أَمانِ هِذِي الأُمَّةِ",250,"ه",1,0],["وآلِهِ والصَّحْبِ","عَلَى مُرورِ الْحِقْب",251,"ب",1,0],["والهَمزُ أمنٌ مِنَ الهِجرانِ يُنقِذُ مَن","أضحى بِحُبِّكِ يَا زهراءُ مُفتَتِنَا",252,"ن",2,0],["والهوى بَلْوى ولكنْ","لسقيمٍ بصحيحِ",253,"ح",1,0],["وَالهاجِمونَ على المنيَّة دارَها","وَقُلوبُهم كالصَّخرِ لا تتهيَّبُ",254,"ب",1,0],["وَالهاجِمونَ عَلى الرّدى","وَاليومُ يجرى بالدّماء",255,"ا",2,0],["وآله الغر من عز الزمان بهم","والله قد بز عنهم حلة التهمِ",256,"م",1,0],["وآله القادة الهادون من نظمت","فرائد المجد في تقصار صدحهم",257,"م",1,0],["وآله الغر والصحب الأماجد من","بفضلهم لم يزل روض الكمال جني",258,"ن",2,0],["والهوا خالقه كال","ترب والماء الزلال",259,"ل",1,0],["والهوى مركبي وشوقي الزميل","صار ختمي في حب علوة بدءا",260,"ا",2,0],["والهوى قد هوى بروح وجسمِ","ونداماي ليس منهم سوى اسمِ",260,"م",1,0],["والهوى سائق له ودليل","في الفيافي على لقاء سعاد",261,"د",1,0],["والهدى فيها كما أشقى بها","ولها الحجة في كشف الغُطَيْ",262,"ي",1,0],["والهوى في القُلوبِ شَرْطٌ فإن لم","يَكُ بالمُشتَهى فبالمكروه",263,"ه",1,0],["والهاك الهوى عن كل شغل","لحظ من مقام واغتنام",264,"م",1,0],["وَالهَدَايَا فِي المَهْرَجَانِ قَدِيْمَاً","وَحَدِيْثَاً مِنْ سُنَّةِ الدِّهْقَانِ",265,"ن",1,0],["والهيفَ المستعارِ من غُصُنِ ال","بانَةَ ذي الانْثِنَاءِ والغَيَدِ",266,"د",1,0],["والهمّ عِنِّين إِذَا","ما صادفَ الصَّهْبَاءَ بِكْرا",267,"ر",2,0],["والهمُّ قَدْ وَقَعتْ ركائِبهُ","مذ مرَّ منْ جَسَدِي بأَطْلاَلِ",268,"ل",1,0],["والهمُّ راسٍ بعده راسِخٌ","كأَنَّني أَوْدَعْتُه حِلْمِي",269,"م",2,0],["وأَلْهَى مديحي فيكَ قلبي عن الْهَوى","وإِنْ كنتُ صبّاً بالملِيحِ الذي يُصبي",270,"ب",2,0]]}