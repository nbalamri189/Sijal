,["وأَلْهَتْكَ عن لَيْلٍ كواكبُهُ المَها","وعن أَبْرُجٍ أَقمارُهُنَّ الكَرَائِمُ",222,"م",1,0],["وأَلهى الثالث الضعفاء منكم","معاملة البيوع على رِباها",223,"ا",3,0],["وآلة حدباء تحمل أورعا","تحمل حمال الثأي والمساويا",224,"ي",2,0],["والهم مطرود بها","والأنس دانٍ مُطَّرِدْ",225,"د",1,0],["والهندسات وسد مأرب خلفت","لهفى الخرائب في مهانة زملها",226,"ل",3,0],["والهازلون بتهريج وقد خلقوا","منه البطولة ألوانا وكم خدعوا",227,"ع",3,0],["والهفتي في اغترابي اليومَ عن وطني","وكل بأسىِ دموعٌ لي أوزعها",228,"ع",3,0],["والَهْفَتَى إلى صدي","ق قال خيراً فصدقْ",229,"ق",1,0],["وآلُهُ وهُمُ آل الإله وهم","رعاة ذا الدين ضيموا بعده ورُعُوا",230,"ع",3,0],["والهضبةُ الملساءُ تَم","نعُ أن يداسَ خَبارُها",231,"ر",3,0],["والهمُّ داءُ أن لم تداركه بال","هجر دواء أنضاك أو قتلك",232,"ك",1,0],["والهوى يسأل عن أعطافهم","والتثني قضبَ البان الغيارى",233,"ر",2,0],["وآله والصحب والتابعين","هداة الأنام على الأبد",234,"د",1,0],["والهوى كالكهربا في جذبها","جرّنا للغيد جرّ الرسن",235,"ن",1,0],["وآله ينبوع المعارف كلها","وأصحابه أهل الهدى تتوقد",236,"د",1,0],["وآله أهل الإرث ما قد تماسكت","بهم حبل الأكوان في الصدع والكسر",237,"ر",1,0],["وآله والأصحاب طرا بلا عد","وأحبابه جمعا مقيما بلا حصر",238,"ر",1,0],["والهَمُّ مَا لَمْ تُمْضِهِ لِسَبِيْلِهِ","لَيْسَ المُفَارِقُ يَا أُمَيْمَ كَمَنْ نَأَى",239,"ا",1,0],["وآلِهِ والصِّحابِ الطَّاهِرينَ فهُمْ","نِعْمَ الرِّجالِ الشَّآبيبُ البَهاليلُ",240,"ل",1,0],["وآلِهِ وصَحْبِهِ ساداتِنا","أُولي الإغاثاتِ إذا طَمَّ الوَجَلْ",241,"ل",1,0],["والهْفَتاهُ قد أعاقَني النَّوى","ورُبَّ يومٍ تَكْثُرُ العَوائِقُ",242,"ق",1,0],["وآلِهِ والصِّحابَ الخَيِّرينَ فهم","يَجري السَّلامُ عَليهمْ كُلَّما ذُكِروا",243,"ر",3,0],["والهاشِمِيُّ نبيِّي","واللهُ قُدِّسَ ربِّي",244,"ب",2,0],["والهجرُ أطولُنا والوصلُ أقصرُنا","والبغضُ أسمنُنا والحبُّ قد نحَلا",245,"ل",2,0],["والهمُّ أكثرُنا إنْ أحصيَ العددُ","والرأس في أوّل العمرِ قدِ اشتعلا",245,"ل",2,0],["والهمّ قد تجسّدْ","والقلبُ صارَ أصْلدْ",246,"د",1,0],["والهامُ تدري وإنْ عزّت سيلزَمُها","ذلُّ السُّجودِ إذا صلّتْ مَواضيهِ",247,"ي",2,0],["والهوى بادي وخلخال الخنا","سوقه النّادي وطبّال يدور",248,"ر",1,0],["وآلِهِ وصَحْبِهِ","حُلاَّلِ عُقْدِ الْمِحَنِ",249,"ن",1,0],["والْهَضْبَ مَنْ عِلْمِ الْبَيَانِ أَشَادَهُ","وبِهِ تَطاوَلَ أَطْوَلٌ وَمُطَوَّلُ",250,"ل",1,0],["وآلِهِ الأَئِمةِ","أَمانِ هِذِي الأُمَّةِ",251,"ه",1,0],["وآلِهِ والصَّحْبِ","عَلَى مُرورِ الْحِقْب",252,"ب",1,0],["والهَمزُ أمنٌ مِنَ الهِجرانِ يُنقِذُ مَن","أضحى بِحُبِّكِ يَا زهراءُ مُفتَتِنَا",253,"ن",2,0],["والهوى بَلْوى ولكنْ","لسقيمٍ بصحيحِ",254,"ح",1,0],["وَالهاجِمونَ على المنيَّة دارَها","وَقُلوبُهم كالصَّخرِ لا تتهيَّبُ",255,"ب",1,0],["وَالهاجِمونَ عَلى الرّدى","وَاليومُ يجرى بالدّماء",256,"ا",2,0],["وآله الغر من عز الزمان بهم","والله قد بز عنهم حلة التهمِ",257,"م",1,0],["وآله القادة الهادون من نظمت","فرائد المجد في تقصار صدحهم",258,"م",1,0],["وآله الغر والصحب الأماجد من","بفضلهم لم يزل روض الكمال جني",259,"ن",2,0],["والهوا خالقه كال","ترب والماء الزلال",260,"ل",1,0],["والهوى مركبي وشوقي الزميل","صار ختمي في حب علوة بدءا",261,"ا",2,0],["والهوى قد هوى بروح وجسمِ","ونداماي ليس منهم سوى اسمِ",261,"م",1,0],["والهوى سائق له ودليل","في الفيافي على لقاء سعاد",262,"د",1,0],["والهدى فيها كما أشقى بها","ولها الحجة في كشف الغُطَيْ",263,"ي",1,0],["والهوى في القُلوبِ شَرْطٌ فإن لم","يَكُ بالمُشتَهى فبالمكروه",264,"ه",1,0],["والهاك الهوى عن كل شغل","لحظ من مقام واغتنام",265,"م",1,0],["وَالهَدَايَا فِي المَهْرَجَانِ قَدِيْمَاً","وَحَدِيْثَاً مِنْ سُنَّةِ الدِّهْقَانِ",266,"ن",1,0],["والهيفَ المستعارِ من غُصُنِ ال","بانَةَ ذي الانْثِنَاءِ والغَيَدِ",267,"د",1,0],["والهمّ عِنِّين إِذَا","ما صادفَ الصَّهْبَاءَ بِكْرا",268,"ر",2,0],["والهمُّ قَدْ وَقَعتْ ركائِبهُ","مذ مرَّ منْ جَسَدِي بأَطْلاَلِ",269,"ل",1,0],["والهمُّ راسٍ بعده راسِخٌ","كأَنَّني أَوْدَعْتُه حِلْمِي",270,"م",2,0],["وأَلْهَى مديحي فيكَ قلبي عن الْهَوى","وإِنْ كنتُ صبّاً بالملِيحِ الذي يُصبي",271,"ب",2,0],["وَأَلهى القَينَ عَن نَصرِ المَوالي","حِلابُ النيبِ وَالمَرعى الضَراءُ",272,"ا",2,0],["والهاتِكي ستر ذي حقٍّ وَمَحرَمَةٍ","فأَيّ سترٍ عَلى أَشياعِهِم هَتَكوا",273,"ك",3,0],["وآلهِ وصحبهِ الأخيار","ما بان ليلٌ وأضا نهار",274,"ر",1,0],["والهيف هائجةٌ لها ينتابها","طفَلُ العشي بذي حناتِمَ شُرَّقِ",275,"ق",1,0]]}