{"poems":[[53,"أعاد لي عيد الضنى","https://www.aldiwan.net/poem29729.html","مجزوء الرجز"],[53,"هذي المنازل بالغميم فنادها","https://www.aldiwan.net/poem30606.html","الكامل"],[53,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[3,"عجبت عبيلة من فتى متبذل","https://www.aldiwan.net/poem108.html",""],[55,"مرحبا بالأحبة القادمينا","https://www.aldiwan.net/poem26065.html","الخفيف"],[55,"إنما أشرق وجهي أنني","https://www.aldiwan.net/poem26473.html","الرمل"],[77,"لا تعجبن لطالب نال العلا","https://www.aldiwan.net/poem36129.html","الخفيف"],[77,"مولاي خمس تولت","https://www.aldiwan.net/poem36130.html","المجتث"],[9,"إن محلا وإن مرتحلا","https://www.aldiwan.net/poem21975.html","المنسرح"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[83,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[88,"أصبحت أوسعهم لوما وتثريبا","https://www.aldiwan.net/poem44832.html","البسيط"],[88,"لقد طوحتني في البلاد مضاعا","https://www.aldiwan.net/poem45009.html","الطويل"],[27,"إني امرؤ يبني لي المجد البان","https://www.aldiwan.net/poem4434.html","الرجز"],[27,"ألا حي ليلى إذ أجد اجتنابها","https://www.aldiwan.net/poem5681.html","الطويل"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[37,"هلا سألت منازلا بالأبرق","https://www.aldiwan.net/poem7239.html","الكامل"],[72,"مسلسل الدمع أسير الفؤاد","https://www.aldiwan.net/poem18550.html","السريع"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[51,"عسرت علينا دعوة السمك","https://www.aldiwan.net/poem65756.html","أحذ الكامل"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[51,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[91,"قالت وصفت لنا الرحيق وكوبها","https://www.aldiwan.net/poem8857.html","عموديه"],[91,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[91,"كن بلسما إن صار دهرك أرقما","https://www.aldiwan.net/poem62736.html","عموديه"],[91,"صبرا على هجرها إن كان يرضيها","https://www.aldiwan.net/poem62813.html","عموديه"],[38,"يا من توعدني جهلا بكثرته","https://www.aldiwan.net/poem7706.html","البسيط"],[92,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[92,"رفرفت في دجية الليل الحزين","https://www.aldiwan.net/poem38917.html","الرمل"],[89,"أيتها النفس اقترب","https://www.aldiwan.net/poem44672.html","مجزوء الرجز"],[89,"كذب الرجاء فما نجيب يرجع","https://www.aldiwan.net/poem44935.html","الكامل"],[85,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[43,"أيا خدد الله ورد الخدود","https://www.aldiwan.net/poem9535.html","المتقارب"],[43,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[43,"لهوى النفوس سريرة لا تعلم","https://www.aldiwan.net/poem10567.html","الكامل"],[45,"ظلم الدهر فيكم وأساء","https://www.aldiwan.net/poem10207.html","الخفيف"],[45,"لج من قد هويته في الصدود","https://www.aldiwan.net/poem63538.html","الخفيف"],[61,"يا دار يوسف لا عدتك تحية","https://www.aldiwan.net/poem51503.html","الكامل"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[66,"ولقد ذكرتك والجماجم وقع","https://www.aldiwan.net/poem39939.html","الكامل"],[97,"قل للذين بكوا على شوقي","https://www.aldiwan.net/poem24774.html","أحذ الكامل"],[80,"غيرته غير الدهر فشاب","https://www.aldiwan.net/poem31541.html","الرمل"],[80,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[44,"الحق أبلج والسيوف عوار","https://www.aldiwan.net/poem30507.html","الكامل"],[87,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[74,"وأهيف قام يسقي","https://www.aldiwan.net/poem12901.html","المجتث"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[52,"ما غر من تسري عقاربه","https://www.aldiwan.net/poem26889.html","الكامل"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[67,"لا تظلموني وتظلموا الحسبه","https://www.aldiwan.net/poem18043.html","المنسرح"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[67,"يا رب صل على المختار من مضر","https://www.aldiwan.net/poem18126.html","البسيط"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[48,"وعود كرمة كرخ","https://www.aldiwan.net/poem62558.html","الخفيف"],[48,"ودار يؤدب فيها البزاة","https://www.aldiwan.net/poem62610.html","المتقارب"],[50,"قد أدرك الحاجة ممنوعة","https://www.aldiwan.net/poem62284.html","الوافر"],[46,"الصبر أروح من حاج تكلفه","https://www.aldiwan.net/poem22433.html","البسيط"],[46,"قالت معاشر كل عاجز ضرع","https://www.aldiwan.net/poem22938.html","البسيط"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[15,"سقينا امرأ القيس ابن حجر ابن حارث","https://www.aldiwan.net/poem45267.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39573","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9873","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42586","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54730","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142000","الرمل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199480","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[106,"فلسفة الألم","https://www.poetsgate.com/ViewPoem.aspx?id=179662",""],[98,"الهوى والشباب","https://www.poetsgate.com/ViewPoem.aspx?id=55300",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[80,"غَيَّرَتْهُ غِيَرُ الدَّهْرِ فشابْ","https://www.poetsgate.com/ViewPoem.aspx?id=3021",""],[51,"عدِّ عن دارٍ وعن جارٍ ظَعَن","https://www.poetsgate.com/ViewPoem.aspx?id=30771",""],[51,"أجنتْ لك الوجدَ أغصانٌ وكثبانُ","https://www.poetsgate.com/ViewPoem.aspx?id=25836",""],[3,"عجبتْ عبيلة ُ منْ فتى ً متبذل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10728&r=&rc=82",""]],"verses":[["وا لَهفَتا مِن واجِدٍ","عَلى الشَبابِ وَالغِنى",0,"ن",2,0],["وا لَهفَتاهُ لِعُصبَةٍ عَلَوِيَّةٍ","تَبِعَت أُمَيَّةَ بَعدَ عِزِّ قِيادِها",1,"د",3,0],["وَالهامُ تَعتَصِبُ العَجاجَ كَأَنَّهُ","في الجَوِّ شُؤبوبُ الغَمامِ الأَملَحُ",2,"ح",1,0],["وَالهامُ تَندُرُ بِالصَعيدِ كَأَنَّم","تُلقي السُيوفُ بِها رُؤوسَ الحَنظَلِ",3,"ل",1,0],["وَالهَوى لَيسَ يَعلَمُهُ إِلّا اللَ","هُ وَالناسُ يُكثِرونَ الظُنونا",4,"ن",2,0],["وَالهَوى يَحدُثُ مِن بَعدِ القِلى","وَالرِضى يَأتيكَ مِن بَعدِ الغَضَب",5,"ب",1,0],["وَالْهَوَى مَرْكَبُ الْهَوَانِ إِذَا","هَمْلَجَ فِي مَلْعَبِ الصِّبَا وَالْجَهَالَهْ",6,"ل",2,0],["والْهَزْلُ مَسْرَحُ نَفْسٍ","عَوَائِدَ الْجِدِّ مَلَّتْ",7,"ت",1,0],["وَالهَوزَبَ العَودَ أَمتَطيهِ بِها","وَالعَنتَريسَ الوَجناءَ وَالجَمَلا",8,"ل",2,0],["وَالهَيكَلَ النَهدَ وَالوَليدَةَ وَال","عَبدَ وَيُعطي مَطافِلاً عُطُلا",8,"ل",2,0],["وَالهَمُّ عَيُن أُثالٍ ما يُنازِعُهُ","مِن نَفسِهِ لِسِواها مَورِداً أَرَبُ",9,"ب",1,0],["والهاديات يؤمُّها عبلُ الشَّوى","متدفّقٌ كتدفّق التيَّارِ",10,"ر",1,0],["وألهبت منهم الأهواء جاريةً","إلى التفرٌّق اُلْهْبا فألهوبا",11,"ب",2,0],["وألْهو بذكراهم على السير كلما","هبَطتِ وهاداً أو علوت يَفاعا",12,"ع",2,0],["وَالهَيصَمانِ وَبَنو ذي النيران","ما لِحَفيفِ القَصَباتِ الجوفان",13,"ن",1,0],["وَأَلهاكَ في ماخورِ حَزَّةَ قَرقَفٌ","لَها نَشوَةٌ يُمسي مَريضاً ذُبابُها",14,"ب",3,0],["وَالهَبانيقُ قِيامٌ مَعَهُم","كُلُّ مَحجومٍ إِذا صُبَّ هَمَل",15,"ل",1,0],["والهيفُ رائحة لها ينتاحها","طَفَل العشيَّ بذي حناتم شُرَّقِ",16,"ق",1,0],["والهيبة العظمى التي أصلحت","بذكرها السائر أهل الفساد",17,"د",1,0],["والهوى لا يزال فيه ضعيفٌ","بين ألحاظِهِ صريعٌ جليدُ",18,"د",1,0],["والهازِباءُ هديَّةٌ ذهبتْ","مذ جاوزت أُسْكُفَّةَ الحنكِ",19,"ك",1,0],["وألهجَ الحمد بالإيطانِ بينهمُ","أن ليس بينهُمُ للمالِ إيطان",20,"ن",1,0],["والْهُ عن عذلك سمعاً قد مَرَنْ","ودع العذلَ فسمعي قد مرن",21,"ن",1,0],["وَالهَمُّ بَعدَ نَجِيِّ النَفسِ يَبعَثُهُ","بِالحَزمِ وَالأَصمَعانِ القَلبُ وَالحَذَرُ",22,"ر",1,0],["وَالهَجر وَهوَ بِمَرءٍ مِن أَحِبَّتِهِ","وَالأَسر وَهوَ طَليقُ الروح وَالبَدَنِ",23,"ن",1,0],["وَالهَوى في بَدَنِهِ عَذبٌ شَهِيُّ","كُلُّ شَيءٍ بَعدَهُ مُحتَقَرُ",24,"ر",1,0],["وَاِلهُ بِوَردِ الرَوضِ عَن أَشواكِهِ","وَاِنسَ العَقارِبَ إِن رَأَيتَ الأَنجُما",25,"م",2,0],["وَأَلهَفَ نَفسي عَلى أُنسٍ بِلا كَدَرٍ","تُرى تَنالُ مِنَ الدُنيا أَمانيها",26,"ي",3,0],["وَالهَضبَ هَضبَ شَرَورى إِن مَرَرتَ بِهِ","وَرَحرَحانِ فَأَطلِعهُ إِلى أُحُدِ",27,"د",1,0],["والهوى والشَّبابْ","والمنى والحَنانْ",28,"ن",1,0],["والهَوَى يَسْكُبُ أَصْداءَ المَنُونْ","في فُؤادٍ فَانْ",29,"ن",1,0],["والهب القلب اسى","ثبت يدا ابي لهب",30,"ب",1,0],["والهمُّ يضغط قلبها من داخل","حتى يكاد شغافه يتمزع",31,"ع",1,0],["والهدب أرأف بالقلوب وإنما","يَتِد السلامُ بأوهن الأوتاد",32,"د",1,0],["وَأَلهَجَ نَفسي لِغَيرِ الخَنا","بِحُبِّ ذَواتِ اللَمى وَالنُهودِ",33,"د",1,0],["وَالهَجرُ أَقتَلُ لي مِمّا أُراقِبُهُ","أَنا الغَريقُ فَما خَوفي مِنَ البَلَلِ",34,"ل",1,0],["وَالهَمُّ يَختَرِمُ الجَسيمَ نَحافَةً","وَيُشيبُ ناصِيَةَ الصَبِيِّ وَيُهرِمُ",35,"م",1,0],["وَالهِزَبرَ الَّذي إِذا دارَتِ الحَر","بُ بِهِ صَرَّفَ الرَدى كَيفَ شاءَ",36,"ا",2,0],["وَالهَوى في الصِبا قَريبٌ مِنَ الرُش","دِ وَلَيسَ القَريبُ مِثلَ البَعيدِ",37,"د",1,0],["والهَيْكَلُ المُبيَضُّ يَلمَعُ وَسْطَها","كالأُقحُوانَةِ في بِساطِ شَقائقِ",38,"ق",1,0],["وَآلهُ أُمناءُ اللَهِ مَن شَهِدَت","لِقَدرِهِم سورَةُ الأَحزابِ بِالعِظَمِ",39,"م",1,0],["وَالهامُ في أُفُقِ العَجاجَةِ حُوَّمٌ","فَكَأَنَّها فَوقَ النُسورِ نُسورُ",40,"ر",1,0],["والهفَتاهُ لمصر والشَّرق","ولدولة الأشعار والأدبِ",41,"ب",1,0],["والهوى باقٍ مع المرءِ إذا","كان مع عَصْرِ الصِّبا عنه ذهاب",42,"ب",1,0],["والهصورُ الوردُ يُخْشى وثبهُ","وهو في الغيلِ مقيمٌ لم يثب",43,"ب",1,0],["وَالهاشِمِيّونَ اِستَقَلَّت عيرُهُم","مِن كَربَلاءَ بِأَثقَلِ الأَوتارِ",44,"ر",1,0],["وَالْهَوَى يَجْعَلُ الْخِلاجَ يَقِينَاً","وَيَغُرُّ الْحَلِيمَ بِالأَوْهَامِ",45,"م",1,0],["والهَ عنْ آلةِ لهوٍ أطربَتْ","وعنِ الأمردِ مرتجِّ الكفلْ",46,"ل",1,0],["وَأَلهَبَ السُكرُ خَدّاً","أَورى بِهِ الوَجدُ زَندَه",47,"د",2,0],["وَالهَوى يَطمس العُيون وَيُلقي","في قَرار الأَسماع مِنهُ دَويّا",48,"ي",2,0],["وَالهاجِعينَ عَلى سُروجِهِمُ","خَفَقاً يُذيقُهُمُ الكَرى نُغَصا",49,"ص",2,0],["وَأَلْهَمَنا به التَّقْوَى فَشَقَّتْ","لنا عمَّا أَكَنَّتْهُ الغُيُوبُ",50,"ب",1,0],["والهازِمُ الجَيْشَ والكَتائِبَ بال","طَّعْنَة يَوْمَ الوَغَى وبالضَّرْبَهْ",51,"ب",2,0],["وَالهُجْنُ تَحْسِبُها سُحْباً مُفَوَّفَةً","في الحَقِّ منها فضاء الجَوِّ مُنْحَصِرُ",52,"ر",1,0],["والهَمُّ عَنْ كُلِّ ما أَبْغِيهِ أَشْمَلَنِي","وقَدْ أَتَى خاضِعاً وَالقَلْبُ مُنْكَسِرٌ",53,"ر",1,0],["والهَضْبُ أشمخُ من هِمّاتِ أنفسهم","والقوْمُ أمنعُ من عُصْمِ الأراويّ",54,"ي",1,0],["وَاِلهوا نَهاراً وَلَيلاً","إِلى نِداءِ المُنادي",55,"ي",1,0],["وَأَلهاهُ ذو كَفَلٍ ناشِئٌ","شَديدُ الفَقارَةِ وَالبَلدَه",56,"د",2,0],["وَالهَمُّ ما أَمسَكتَهُ في الحَشا","داءٌ وَبَعضُ الداءِ لا يُستَقال",57,"ل",1,0],["وَالهَمُّ لِلحَيِّ إِلفٌ لا يُفارِقُهُ","حَتّى يَعودَ مَعَ الأَمواتِ مَفقودا",58,"د",2,0],["وَالهَذرُ يُعطيكَ عَن فَقدِ الهُدى نَبَأً","وَيكَثِرُ القَولَ طَيرٌ شَأنُها الضَرَعُ",59,"ع",1,0],["وإلهُ المَجُوسِ سَيْفُكَ إنْ لم","يَرْغَبوا عنْ عبادة النّيرانِ",60,"ن",1,0],["وَأَلهاهُ شُربٌ ناعِمٌ وَقُراقِرٌ","وَأَعياهُ ثَأرٌ كانَ يَطلُبُ في حُجرِ",61,"ر",1,0],["وا لهفَ نفسي كم تمنَّيتَ المُنى","يوم السيوف تقَرُّ في الأغمادِ",62,"د",1,0],["والهوى يَعْجب من مغتربَيْنْ","لم يَقُلْ أنتِ ولا قالتْ أنا",63,"ن",2,0],["والْهُ مع الغيد والعذارى","وغنّ بالكأس والوترْ",64,"ر",1,0],["وألهفَ قلبكَ لما اندكَّ شامخُها","والنوءُ مصطرعٌ والموجُ هدّارُ",65,"ر",1,0],["وآله بين مخالب الأسد","يتنزع الروح ويهتك الجسدْ",66,"د",1,0],["والهَزَجُ الذي هو السّوارُ","عليهِ للثالثةِ المَدارُ",67,"ر",1,0],["وَالهامُ تَندُرُ بِالصَعيدِ كَأَنَّما","تُلقي السُيوفُ بِها رُؤوسَ الحَنظَلِ",68,"ل",1,0],["وَالْهُ بِمَا شِئْت قَبْلَ مَنْدَمَةٍ","يَكْثُرُ فِيهَا الْعَنَاءُ وَالْكَمَدُ",69,"د",1,0],["وَالهَابِطِينَ إِلَى الثَّرَى","وَالصَّاعِدِينَ إِلَى القِمَمْ",70,"م",1,0],["وَالهِلاَلِيُّ كَانَ أَجْدَرَ مَنْ يَجْ","لُو بِنُورٍ غَيَاهِبَ الظُّلُمَاتِ",71,"ت",1,0],["وَالَهْفَ مِصْرَ عَلَى فَقَيدٍ رِزْءُهُ","رِزْءٌ إِذَا أَحْصَيْتُهُ لَمْ يُعْدَد",72,"د",1,0],["والهوى يوحي إليّا","برسالات العيون",73,"ن",1,0],["وألهو بنفس القرارات","أهذي بنفس الخطابات",74,"ت",1,0],["وألهمتَها معنى الثناء ولفظَهُ","كريماً فخذْه اليومَ من فَمِها نَغْما",75,"م",2,0],["والهَوى أمْرَدُ المحيَّا يناغي","فِتْيةً تُشبهُ الدنانير مُرْدَا",76,"د",2,0],["والهمُّ يجلو النفوسَ إن صَدئت","والهمُّ فيه رياضة البدن",77,"ن",1,0],["والهوى والشباب والأمل المن","شود ضاعت جميعها من يديّا",78,"ي",2,0],["والهِيمُ تخزُنُهُ وتنهبُهُ","والغِيدُ تُنزِلهُ وتصُعِده",79,"د",2,0],["وألهمَ الناسَ كي يَرضَوا مغبَّتهم","أن يُوسعوا العقلَ ميداناً ومضطَربا",80,"ب",2,0],["والهوى باقٍ مع المرء إذا","كان من عصرِ الصِّبا عنه ذهاب",81,"ب",1,0],["والْهُ عن عذلك سمعاً قد مَرَنْ","ودع العدلَ فسمعي قد مرن",82,"ن",1,0],["وألهجَ الحمد بالإيطانِ بينهمُ","أن ليس بينهُم للمالِ إيطال",83,"ل",1,0],["والهامُ تنذرُ بالصعيد كأنما","تُلْقي السُّيوفُ بها رُؤوس الحنظل",84,"ل",1,0]]}