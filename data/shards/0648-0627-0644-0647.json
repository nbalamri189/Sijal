لغَمامِ الأَملَحُ",2,"ح",1,0],["وَالهامُ تَندُرُ بِالصَعيدِ كَأَنَّم","تُلقي السُيوفُ بِها رُؤوسَ الحَنظَلِ",3,"ل",1,0],["وَالهَوى لَيسَ يَعلَمُهُ إِلّا اللَ","هُ وَالناسُ يُكثِرونَ الظُنونا",4,"ن",2,0],["وَالهَوى يَحدُثُ مِن بَعدِ القِلى","وَالرِضى يَأتيكَ مِن بَعدِ الغَضَب",5,"ب",1,0],["وَالْهَوَى مَرْكَبُ الْهَوَانِ إِذَا","هَمْلَجَ فِي مَلْعَبِ الصِّبَا وَالْجَهَالَهْ",6,"ل",2,0],["والْهَزْلُ مَسْرَحُ نَفْسٍ","عَوَائِدَ الْجِدِّ مَلَّتْ",7,"ت",1,0],["وَالهَوزَبَ العَودَ أَمتَطيهِ بِها","وَالعَنتَريسَ الوَجناءَ وَالجَمَلا",8,"ل",2,0],["وَالهَيكَلَ النَهدَ وَالوَليدَةَ وَال","عَبدَ وَيُعطي مَطافِلاً عُطُلا",8,"ل",2,0],["وَالهَمُّ عَيُن أُثالٍ ما يُنازِعُهُ","مِن نَفسِهِ لِسِواها مَورِداً أَرَبُ",9,"ب",1,0],["والهاديات يؤمُّها عبلُ الشَّوى","متدفّقٌ كتدفّق التيَّارِ",10,"ر",1,0],["وألهبت منهم الأهواء جاريةً","إلى التفرٌّق اُلْهْبا فألهوبا",11,"ب",2,0],["وألْهو بذكراهم على السير كلما","هبَطتِ وهاداً أو علوت يَفاعا",12,"ع",2,0],["وَالهَيصَمانِ وَبَنو ذي النيران","ما لِحَفيفِ القَصَباتِ الجوفان",13,"ن",1,0],["وَأَلهاكَ في ماخورِ حَزَّةَ قَرقَفٌ","لَها نَشوَةٌ يُمسي مَريضاً ذُبابُها",14,"ب",3,0],["وَالهَبانيقُ قِيامٌ مَعَهُم","كُلُّ مَحجومٍ إِذا صُبَّ هَمَل",15,"ل",1,0],["والهيفُ رائحة لها ينتاحها","طَفَل العشيَّ بذي حناتم شُرَّقِ",16,"ق",1,0],["والهيبة العظمى التي أصلحت","بذكرها السائر أهل الفساد",17,"د",1,0],["والهوى لا يزال فيه ضعيفٌ","بين ألحاظِهِ صريعٌ جليدُ",18,"د",1,0],["والهازِباءُ هديَّةٌ ذهبتْ","مذ جاوزت أُسْكُفَّةَ الحنكِ",19,"ك",1,0],["وألهجَ الحمد بالإيطانِ بينهمُ","أن ليس بينهُمُ للمالِ إيطان",20,"ن",1,0],["والْهُ عن عذلك سمعاً قد مَرَنْ","ودع العذلَ فسمعي قد مرن",21,"ن",1,0],["وَالهَمُّ بَعدَ نَجِيِّ النَفسِ يَبعَثُهُ","بِالحَزمِ وَالأَصمَعانِ القَلبُ وَالحَذَرُ",22,"ر",1,0],["وَالهَجر وَهوَ بِمَرءٍ مِن أَحِبَّتِهِ","وَالأَسر وَهوَ طَليقُ الروح وَالبَدَنِ",23,"ن",1,0],["وَالهَوى في بَدَنِهِ عَذبٌ شَهِيُّ","كُلُّ شَيءٍ بَعدَهُ مُحتَقَرُ",24,"ر",1,0],["وَاِلهُ بِوَردِ الرَوضِ عَن أَشواكِهِ","وَاِنسَ العَقارِبَ إِن رَأَيتَ الأَنجُما",25,"م",2,0],["وَأَلهَفَ نَفسي عَلى أُنسٍ بِلا كَدَرٍ","تُرى تَنالُ مِنَ الدُنيا أَمانيها",26,"ي",3,0],["وَالهَضبَ هَضبَ شَرَورى إِن مَرَرتَ بِهِ","وَرَحرَحانِ فَأَطلِعهُ إِلى أُحُدِ",27,"د",1,0],["والهوى والشَّبابْ","والمنى والحَنانْ",28,"ن",1,0],["والهَوَى يَسْكُبُ أَصْداءَ المَنُونْ","في فُؤادٍ فَانْ",29,"ن",1,0],["والهب القلب اسى","ثبت يدا ابي لهب",30,"ب",1,0],["والهمُّ يضغط قلبها من داخل","حتى يكاد شغافه يتمزع",31,"ع",1,0],["والهدب أرأف بالقلوب وإنما","يَتِد السلامُ بأوهن الأوتاد",32,"د",1,0],["وَأَلهَجَ نَفسي لِغَيرِ الخَنا","بِحُبِّ ذَواتِ اللَمى وَالنُهودِ",33,"د",1,0],["وَالهَجرُ أَقتَلُ لي مِمّا أُراقِبُهُ","أَنا الغَريقُ فَما خَوفي مِنَ البَلَلِ",34,"ل",1,0],["وَالهَمُّ يَختَرِمُ الجَسيمَ نَحافَةً","وَيُشيبُ ناصِيَةَ الصَبِيِّ وَيُهرِمُ",35,"م",1,0],["وَالهِزَبرَ الَّذي إِذا دارَتِ الحَر","بُ بِهِ صَرَّفَ الرَدى كَيفَ شاءَ",36,"ا",2,0],["وَالهَوى في الصِبا قَريبٌ مِنَ الرُش","دِ وَلَيسَ القَريبُ مِثلَ البَعيدِ",37,"د",1,0],["والهَيْكَلُ المُبيَضُّ يَلمَعُ وَسْطَها","كالأُقحُوانَةِ في بِساطِ شَقائقِ",38,"ق",1,0],["وَآلهُ أُمناءُ اللَهِ مَن شَهِدَت","لِقَدرِهِم سورَةُ الأَحزابِ بِالعِظَمِ",39,"م",1,0],["وَالهامُ في أُفُقِ العَجاجَةِ حُوَّمٌ","فَكَأَنَّها فَوقَ النُسورِ نُسورُ",40,"ر",1,0],["والهفَتاهُ لمصر والشَّرق","ولدولة الأشعار والأدبِ",41,"ب",1,0],["والهوى باقٍ مع المرءِ إذا","كان مع عَصْرِ الصِّبا عنه ذهاب",42,"ب",1,0],["والهصورُ الوردُ يُخْشى وثبهُ","وهو في الغيلِ مقيمٌ لم يثب",43,"ب",1,0],["وَالهاشِمِيّونَ اِستَقَلَّت عيرُهُم","مِن كَربَلاءَ بِأَثقَلِ الأَوتارِ",44,"ر",1,0],["وَالْهَوَى يَجْعَلُ الْخِلاجَ يَقِينَاً","وَيَغُرُّ الْحَلِيمَ بِالأَوْهَامِ",45,"م",1,0],["والهَ عنْ آلةِ لهوٍ أطربَتْ","وعنِ الأمردِ مرتجِّ الكفلْ",46,"ل",1,0],["وَأَلهَبَ السُكرُ خَدّاً","أَورى بِهِ الوَجدُ زَندَه",47,"د",2,0],["وَالهَوى يَطمس العُيون وَيُلقي","في قَرار الأَسماع مِنهُ دَويّا",48,"ي",2,0],["وَالهاجِعينَ عَلى سُروجِهِمُ","خَفَقاً يُذيقُهُمُ الكَرى نُغَصا",49,"ص",2,0],["وَأَلْهَمَنا به التَّقْوَى فَشَقَّتْ","لنا عمَّا أَكَنَّتْهُ الغُيُوبُ",50,"ب",1,0],["والهازِمُ الجَيْشَ والكَتائِبَ بال","طَّعْنَة يَوْمَ الوَغَى وبالضَّرْبَهْ",51,"ب",2,0],["وَالهُجْنُ تَحْسِبُها سُحْباً مُفَوَّفَةً","في الحَقِّ منها فضاء الجَوِّ مُنْحَصِرُ",52,"ر",1,0],["والهَمُّ عَنْ كُلِّ ما أَبْغِيهِ أَشْمَلَنِي","وقَدْ أَتَى خاضِعاً وَالقَلْبُ مُنْكَسِرٌ",53,"ر",1,0],["والهَضْبُ أشمخُ من هِمّاتِ أنفسهم","والقوْمُ أمنعُ من عُصْمِ الأراويّ",54,"ي",1,0],["وَاِلهوا نَهاراً وَلَيلاً","إِلى نِداءِ المُنادي",55,"ي",1,0],["وَأَلهاهُ ذو كَفَلٍ ناشِئٌ","شَديدُ الفَقارَةِ وَالبَلدَه",56,"د",2,0],["وَالهَمُّ ما أَمسَكتَهُ في الحَشا","داءٌ وَبَعضُ الداءِ لا يُستَقال",57,"ل",1,0],["وَالهَمُّ لِلحَيِّ إِلفٌ لا يُفارِقُهُ","حَتّى يَعودَ مَعَ الأَمواتِ مَفقودا",58,"د",2,0],["وَالهَذرُ يُعطيكَ عَن فَقدِ الهُدى نَبَأً","وَيكَثِرُ القَولَ طَيرٌ شَأنُها الضَرَعُ",59,"ع",1,0],["وإلهُ المَجُوسِ سَيْفُكَ إنْ لم","يَرْغَبوا عنْ عبادة النّيرانِ",60,"ن",1,0],["وَأَلهاهُ شُربٌ ناعِمٌ وَقُراقِرٌ","وَأَعياهُ ثَأرٌ كانَ يَطلُبُ في حُجرِ",61,"ر",1,0],["وا لهفَ نفسي كم تمنَّيتَ المُنى","يوم السيوف تقَرُّ في الأغمادِ",62,"د",1,0],["والهوى يَعْجب من مغتربَيْنْ","لم يَقُلْ أنتِ ولا قالتْ أنا",63,"ن",2,0],["والْهُ مع الغيد والعذارى","وغنّ بالكأس والوترْ",64,"ر",1,0],["وألهفَ قلبكَ لما اندكَّ شامخُها","والنوءُ مصطرعٌ والموجُ هدّارُ",65,"ر",1,0],["وآله بين مخالب الأسد","يتنزع الروح ويهتك الجسدْ",66,"د",1,0],["والهَزَجُ الذي هو السّوارُ","عليهِ للثالثةِ المَدارُ",67,"ر",1,0],["وَالهامُ تَندُرُ بِالصَعيدِ كَأَنَّما","تُلقي السُيوفُ بِها رُؤوسَ الحَنظَلِ",68,"ل",1,0],["وَالْهُ بِمَا شِئْت قَبْلَ مَنْدَمَةٍ","يَكْثُرُ فِيهَا الْعَنَاءُ وَالْكَمَدُ",69,"د",1,0],["وَالهَابِطِينَ إِلَى الثَّرَى","وَالصَّاعِدِينَ إِلَى القِمَمْ",70,"م",1,0],["وَالهِلاَلِيُّ كَانَ أَجْدَرَ مَنْ يَجْ","لُو بِنُورٍ غَيَاهِبَ الظُّلُمَاتِ",71,"ت",1,0],["وَالَهْفَ مِصْرَ عَلَى فَقَيدٍ رِزْءُهُ","رِزْءٌ إِذَا أَحْصَيْتُهُ لَمْ يُعْدَد",72,"د",1,0],["والهوى يوحي إليّا","برسالات العيون",73,"ن",1,0],["وألهو بنفس القرارات","أهذي بنفس الخطابات",74,"ت",1,0],["وألهمتَها معنى الثناء ولفظَهُ","كريماً فخذْه اليومَ من فَمِها نَغْما",75,"م",2,0],["والهَوى أمْرَدُ المحيَّا يناغي","فِتْيةً تُشبهُ الدنانير مُرْدَا",76,"د",2,0],["والهمُّ يجلو النفوسَ إن صَدئت","والهمُّ فيه رياضة البدن",77,"ن",1,0],["والهوى والشباب والأمل المن","شود ضاعت جميعها من يديّا",78,"ي",2,0],["والهِيمُ تخزُنُهُ وتنهبُهُ","والغِيدُ تُنزِلهُ وتصُعِده",79,"د",2,0],["وألهمَ الناسَ كي يَرضَوا مغبَّتهم","أن يُوسعوا العقلَ ميداناً ومضطَربا",80,"ب",2,0],["والهوى باقٍ مع المرء إذا","كان من عصرِ الصِّبا عنه ذهاب",81,"ب",1,0],["والْهُ عن عذلك سمعاً قد مَرَنْ","ودع العدلَ فسمعي قد مرن",82,"ن",1,0],["وألهجَ الحمد بالإيطانِ بينهمُ","أن ليس بينهُم للمالِ إيطال",83,"ل",1,0],["والهامُ تنذرُ بالصعيد كأنما","تُلْقي السُّيوفُ بها رُؤوس الحنظل",84,"ل",1,0],["والهفتاه على زمان قد مضى","كنا عن البعد المريع بمعزل",85,"ل",1,0],["والهج بذكر الله ثم تحققا","اخلص ودادك للنبي وآله",86,"ل",2,0],["والهف قلبي والايام خائنة","والوقت ظل وركب العمر مرتحل",87,"ل",1,0],["والهفتاه لوقت قرب مرلي","مع من احب مضى وآه لو بقي",88,"ق",2,0],["والهف قلبي فالتي قد ازمعت","تركت لنا صفو القلوب مكدرا",89,"ر",2,0],["والهفتاه أو يقاتي بهم قصرت","وبعدهم لي آهات طويلات",90,"ت",1,0],["والهندواني لم يقطع وجرحته","سحا عليها الشفاء المحض ينسكب",91,"ب",1,0],["والهفي عنكم ودين الهوى","لم ابغ منه الصبر الا ابى",92,"ب",2,0],["وآله الاطهار والصحب الغرر","وابن الرفاعي وغريب الغربا",93,"ا",1,0],["والهفتي لم ارم","لقياه الا ابي",94,"ب",2,0],["والهم عم اولى الفضائل واحتست","كأس الصفاء لجهلها الجهلاء",95,"ا",2,0],["والهوى قد هوى علي ببأس","صارع قد رأيت فيه خبالا",96,"ل",2,0],["وآله والصحب والأوليا","ما عطر النظم بمسك الختام",97,"م",1,0],["وآله والصحاب الطيبين ومن","صاروا بنسبته غرا ميامينا",98,"ن",2,0],["والهيكل المحفوظ في طي العمى","من قبل صبغة طينها والماء",99,"ا",2,0],["والهُتافُ المُتَعالي جَزَعًا","ليسَ إلّا مِنْ حَريقِ الوَطَنِ",100,"ن",1,0],["والهاتفُ المَلْعُونُ حيثُ أكونُ","يَتْبَعُني، ويَعْزِفُ كُلَّ ثانيةٍ رَقَمْ",101,"م",1,0],["والهبر يرفل في نعمى تشرده","بين الكواعب محفوفاً بأقمار",102,"ر",1,1],["والهبر قد زار الربوع","فيا هلا عم السلام",103,"م",1,0],["والهِلاَلُ التَّميمُ لَيسَ بِلَحنٍ","لَو نَظَرتَ اللُّغَى وكُنتَ فِهِيمَا",104,"م",2,0],["والهَيكَلَ الطِّرفَ المُسَوَّمَ مُسرَجاً","والشَّد قَمِىِّ المُقسَئِنَّ البَازِلا",105,"ل",2,0],["والهَوَى يَانِعُ الرِّيَاضِ مُطِيعٌ","والشَّجِىُّ المَلُومُ غَيرُ مُطِيعِ",106,"ع",1,0],["وَأَلهَمَكَ البَأسُ الهُجومَ عَلى الرَدى","فَلَم تَهَبِ الهَولَ الَّذي أَنتَ راكِبُ",107,"ب",1,0],["وَالهِمَّةُ البِكرُ الَّتي لَم تُفتَرَع","خَصَّتكَ بِالشَرَفِ الَّذي لَم يُفرَعِ",108,"ع",1,0],["وَالهِمَّةُ البِكرُ الَّتي لَم تُفتَرَع","خَصَّتكَ بِالشَرَفِ الَّذي لا يُفرَعُ",109,"ع",1,0],["والهج بمدحِ الهاشم","ي فإنه الحصن الحصين",110,"ن",1,0],["والهَوى لا خِفْتُ عاذِلَتي","في هَوى مَنْ جَلَّ عن صِفَتي",111,"ت",2,1],["والهام تسجد كلما صلت بها","وركعن بيضك والخدود تعفر",112,"ر",1,0],["وَالهاتِكينَ عَلى الجَبّارِ قُبّتهُ","شَدَّ النَهارِ بِلا خَوفٍ وَلا رَهَبِ",113,"ب",1,0],["وَالهامُ تُصدَعُ بِالسُيوفِ وَلِلقنا","وَقعٌ فَريصُ المَوتِ مِنهُ تُرعَدُ",114,"د",1,0],["وَالهَوى مَورِدُ الظُنون وَبَعض الظ","ظنِّ إِثمٌ غَلِطتُ بَل حاشاها",115,"ا",3,0],["وألهاك عَذْلىَ عن أن تفوزَ","بنفسِك من ذلك المَصْرع",116,"ع",1,0],["والهرّ يمنعها التأديب عن سرَق","خوفا وفي طبعها في الخلوة السرق",117,"ق",1,0],["وإله دمعتي تفيض من العي","ن بماء وتارة بنجيع",118,"ع",1,0],["والهف للمرء الذي","عادت مسرّته مضرّه",119,"ر",2,1],["والهزير الهصور أصبح كبشا","خاضعا رغم أنفه للكلاب",120,"ب",1,0],["والهاتِفونَ إذا الدماءُ تدفّقَت","أعني دما الأبطالِ بالميدانِ",121,"ن",1,0],["والهوى للقلبِ فخٌ","يخدعُ الطيرَ بحبِّ",122,"ب",1,0],["والهوى يستزيد حالاً فحالاً","وكذا يَنسَلي قليلاً قليلا",123,"ل",2,0],["والهمِّ والغمِّ الممضّ تجدّدا","والأنس ولَّى بالسّرور وأدبرا",124,"ر",2,0],["والهدايا نبتهن بأنسى","فكنوز السرور تحت يدينا",125,"ن",2,0],["والهلال المنير ليس يمارى","أنني من سناه أنور ذهنا",125,"ن",2,0],["والهواء الطلق يهفو عابثا","بغصون تتثنى بدلال",126,"ل",1,0],["وَالهِوى دون اكبُدٍ لَيسَ يَحيا","فَغِذاءُ الهوى من الأَجسامِ",127,"م",1,0],["وَالهَوى في فُؤادَكَ المَوجوعِ","وَلَياليكَ في ظَماءٍ وَجوعِ",127,"ع",1,0],["وَالهَوى أَصغِ في الرِياضِ إِلى البُل","بُلِ وَاِحذَر فَإِنّ