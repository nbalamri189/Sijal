مجانيه","https://www.aldiwan.net/poem20803.html","البسيط"],[523,"يا زمان العكس قلاب الأمور","https://www.aldiwan.net/poem818.html",""],[532,"أقول بعد حمد من","https://www.aldiwan.net/poem37084.html","مجزوء الهزج"],[532,"هب أن بدر التم يوما يأفل","https://www.aldiwan.net/poem37264.html","الكامل"],[532,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[532,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[541,"ألزاي أوله ينبي بزورتها","https://www.aldiwan.net/poem47613.html","عموديه"],[554,"يا مليح الوجه لم فعلك","https://www.aldiwan.net/poem47890.html","مجزوء الرمل"],[554,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[554,"ما نحن إلا للفناء","https://www.aldiwan.net/poem48110.html","مجزوء الكامل"],[561,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[561,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[561,"أستغفر الله من سري ومن علني","https://www.aldiwan.net/poem33748.html","البسيط"],[561,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[561,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[561,"عرجا بي على النقا فجياد","https://www.aldiwan.net/poem34617.html","الخفيف"],[562,"غير ليلي لم يرى في الحي حي","https://www.aldiwan.net/poem69333.html","الرمل"],[565,"لا تلوميه في الهوى واعذريه","https://www.aldiwan.net/poem52968.html","الخفيف"],[567,"سقاك الله كاسات الغرام","https://www.aldiwan.net/poem886.html",""],[570,"شارفتنا طلائع المهرجان","https://www.aldiwan.net/poem69480.html","الخفيف"],[570,"لا وجفون ينفثن في العقد","https://www.aldiwan.net/poem69709.html","البسيط"],[578,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[578,"ما لي أنهنه عنك آمالي","https://www.aldiwan.net/poem2782.html","أحذ الكامل"],[578,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[578,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/20894","الوافر"],[845,"","https://poetry.dctabudhabi.ae/diwan/poem/21468","البسيط"],[1075,"","https://poetry.dctabudhabi.ae/diwan/poem/84986","الرجز"],[861,"هلا سألت منازِلاً بالأبرَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=79429",""]],"verses":[["وا لَهفَتا مِن واجِدٍ","عَلى الشَبابِ وَالغِنى",0,"ن",2,0],["وا لَهفَتاهُ لِعُصبَةٍ عَلَوِيَّةٍ","تَبِعَت أُمَيَّةَ بَعدَ عِزِّ قِيادِها",1,"د",3,0],["وَالهامُ تَعتَصِبُ العَجاجَ كَأَنَّهُ","في الجَوِّ شُؤبوبُ الغَمامِ الأَملَحُ",2,"ح",1,0],["وَالهامُ تَندُرُ بِالصَعيدِ كَأَنَّم","تُلقي السُيوفُ بِها رُؤوسَ الحَنظَلِ",3,"ل",1,0],["وَالهَوى لَيسَ يَعلَمُهُ إِلّا اللَ","هُ وَالناسُ يُكثِرونَ الظُنونا",4,"ن",2,0],["وَالهَوى يَحدُثُ مِن بَعدِ القِلى","وَالرِضى يَأتيكَ مِن بَعدِ الغَضَب",5,"ب",1,0],["وَالْهَوَى مَرْكَبُ الْهَوَانِ إِذَا","هَمْلَجَ فِي مَلْعَبِ الصِّبَا وَالْجَهَالَهْ",6,"ل",2,0],["والْهَزْلُ مَسْرَحُ نَفْسٍ","عَوَائِدَ الْجِدِّ مَلَّتْ",7,"ت",1,0],["وَالهَوزَبَ العَودَ أَمتَطيهِ بِها","وَالعَنتَريسَ الوَجناءَ وَالجَمَلا",8,"ل",2,0],["وَالهَيكَلَ النَهدَ وَالوَليدَةَ وَال","عَبدَ وَيُعطي مَطافِلاً عُطُلا",8,"ل",2,0],["وَالهَمُّ عَيُن أُثالٍ ما يُنازِعُهُ","مِن نَفسِهِ لِسِواها مَورِداً أَرَبُ",9,"ب",1,0],["والهاديات يؤمُّها عبلُ الشَّوى","متدفّقٌ كتدفّق التيَّارِ",10,"ر",1,0],["وألهبت منهم الأهواء جاريةً","إلى التفرٌّق اُلْهْبا فألهوبا",11,"ب",2,0],["وألْهو بذكراهم على السير كلما","هبَطتِ وهاداً أو علوت يَفاعا",12,"ع",2,0],["وَالهَيصَمانِ وَبَنو ذي النيران","ما لِحَفيفِ القَصَباتِ الجوفان",13,"ن",1,0],["وَأَلهاكَ في ماخورِ حَزَّةَ قَرقَفٌ","لَها نَشوَةٌ يُمسي مَريضاً ذُبابُها",14,"ب",3,0],["وَالهَبانيقُ قِيامٌ مَعَهُم","كُلُّ مَحجومٍ إِذا صُبَّ هَمَل",15,"ل",1,0],["والهيفُ رائحة لها ينتاحها","طَفَل العشيَّ بذي حناتم شُرَّقِ",16,"ق",1,0],["والهيبة العظمى التي أصلحت","بذكرها السائر أهل الفساد",17,"د",1,0],["والهوى لا يزال فيه ضعيفٌ","بين ألحاظِهِ صريعٌ جليدُ",18,"د",1,0],["والهازِباءُ هديَّةٌ ذهبتْ","مذ جاوزت أُسْكُفَّةَ الحنكِ",19,"ك",1,0],["وألهجَ الحمد بالإيطانِ بينهمُ","أن ليس بينهُمُ للمالِ إيطان",20,"ن",1,0],["والْهُ عن عذلك سمعاً قد مَرَنْ","ودع العذلَ فسمعي قد مرن",21,"ن",1,0],["وَالهَمُّ بَعدَ نَجِيِّ النَفسِ يَبعَثُهُ","بِالحَزمِ وَالأَصمَعانِ القَلبُ وَالحَذَرُ",22,"ر",1,0],["وَالهَجر وَهوَ بِمَرءٍ مِن أَحِبَّتِهِ","وَالأَسر وَهوَ طَليقُ الروح وَالبَدَنِ",23,"ن",1,0],["وَالهَوى في بَدَنِهِ عَذبٌ شَهِيُّ","كُلُّ شَيءٍ بَعدَهُ مُحتَقَرُ",24,"ر",1,0],["وَاِلهُ بِوَردِ الرَوضِ عَن أَشواكِهِ","وَاِنسَ العَقارِبَ إِن رَأَيتَ الأَنجُما",25,"م",2,0],["وَأَلهَفَ نَفسي عَلى أُنسٍ بِلا كَدَرٍ","تُرى تَنالُ مِنَ الدُنيا أَمانيها",26,"ي",3,0],["وَالهَضبَ هَضبَ شَرَورى إِن مَرَرتَ بِهِ","وَرَحرَحانِ فَأَطلِعهُ إِلى أُحُدِ",27,"د",1,0],["والهوى والشَّبابْ","والمنى والحَنانْ",28,"ن",1,0],["والهَوَى يَسْكُبُ أَصْداءَ المَنُونْ","في فُؤادٍ فَانْ",29,"ن",1,0],["والهب القلب اسى","ثبت يدا ابي لهب",30,"ب",1,0],["والهمُّ يضغط قلبها من داخل","حتى يكاد شغافه يتمزع",31,"ع",1,0],["والهدب أرأف بالقلوب وإنما","يَتِد السلامُ بأوهن الأوتاد",32,"د",1,0],["وَأَلهَجَ نَفسي لِغَيرِ الخَنا","بِحُبِّ ذَواتِ اللَمى وَالنُهودِ",33,"د",1,0],["وَالهَجرُ أَقتَلُ لي مِمّا أُراقِبُهُ","أَنا الغَريقُ فَما خَوفي مِنَ البَلَلِ",34,"ل",1,0],["وَالهَمُّ يَختَرِمُ الجَسيمَ نَحافَةً","وَيُشيبُ ناصِيَةَ الصَبِيِّ وَيُهرِمُ",35,"م",1,0],["وَالهِزَبرَ الَّذي إِذا دارَتِ الحَر","بُ بِهِ صَرَّفَ الرَدى كَيفَ شاءَ",36,"ا",2,0],["وَالهَوى في الصِبا قَريبٌ مِنَ الرُش","دِ وَلَيسَ القَريبُ مِثلَ البَعيدِ",37,"د",1,0],["والهَيْكَلُ المُبيَضُّ يَلمَعُ وَسْطَها","كالأُقحُوانَةِ في بِساطِ شَقائقِ",38,"ق",1,0],["وَآلهُ أُمناءُ اللَهِ مَن شَهِدَت","لِقَدرِهِم سورَةُ الأَحزابِ بِالعِظَمِ",39,"م",1,0],["وَالهامُ في أُفُقِ العَجاجَةِ حُوَّمٌ","فَكَأَنَّها فَوقَ النُسورِ نُسورُ",40,"ر",1,0],["والهفَتاهُ لمصر والشَّرق","ولدولة الأشعار والأدبِ",41,"ب",1,0],["والهوى باقٍ مع المرءِ إذا","كان مع عَصْرِ الصِّبا عنه ذهاب",42,"ب",1,0],["والهصورُ الوردُ يُخْشى وثبهُ","وهو في الغيلِ مقيمٌ لم يثب",43,"ب",1,0],["وَالهاشِمِيّونَ اِستَقَلَّت عيرُهُم","مِن كَربَلاءَ بِأَثقَلِ الأَوتارِ",44,"ر",1,0],["وَالْهَوَى يَجْعَلُ الْخِلاجَ يَقِينَاً","وَيَغُرُّ الْحَلِيمَ بِالأَوْهَامِ",45,"م",1,0],["والهَ عنْ آلةِ لهوٍ أطربَتْ","وعنِ الأمردِ مرتجِّ الكفلْ",46,"ل",1,0],["وَأَلهَبَ السُكرُ خَدّاً","أَورى بِهِ الوَجدُ زَندَه",47,"د",2,0],["وَالهَوى يَطمس العُيون وَيُلقي","في قَرار الأَسماع مِنهُ دَويّا",48,"ي",2,0],["وَالهاجِعينَ عَلى سُروجِهِمُ","خَفَقاً يُذيقُهُمُ الكَرى نُغَصا",49,"ص",2,0],["وَأَلْهَمَنا به التَّقْوَى فَشَقَّتْ","لنا عمَّا أَكَنَّتْهُ الغُيُوبُ",50,"ب",1,0],["والهازِمُ الجَيْشَ والكَتائِبَ بال","طَّعْنَة يَوْمَ الوَغَى وبالضَّرْبَهْ",51,"ب",2,0],["وَالهُجْنُ تَحْسِبُها سُحْباً مُفَوَّفَةً","في الحَقِّ منها فضاء الجَوِّ مُنْحَصِرُ",52,"ر",1,0],["والهَمُّ عَنْ كُلِّ ما أَبْغِيهِ أَشْمَلَنِي","وقَدْ أَتَى خاضِعاً وَالقَلْبُ مُنْكَسِرٌ",53,"ر",1,0],["والهَضْبُ أشمخُ من هِمّاتِ أنفسهم","والقوْمُ أمنعُ من عُصْمِ الأراويّ",54,"ي",1,0],["وَاِلهوا نَهاراً وَلَيلاً","إِلى نِداءِ المُنادي",55,"د",2,0],["وَأَلهاهُ ذو كَفَلٍ ناشِئٌ","شَديدُ الفَقارَةِ وَالبَلدَه",56,"د",2,0],["وَالهَمُّ ما أَمسَكتَهُ في الحَشا","داءٌ وَبَعضُ الداءِ لا يُستَقال",57,"ل",1,0],["وَالهَمُّ لِلحَيِّ إِلفٌ لا يُفارِقُهُ","حَتّى يَعودَ مَعَ الأَمواتِ مَفقودا",58,"د",2,0],["وَالهَذرُ يُعطيكَ عَن فَقدِ الهُدى نَبَأً","وَيكَثِرُ القَولَ طَيرٌ شَأنُها الضَرَعُ",59,"ع",1,0],["وإلهُ المَجُوسِ سَيْفُكَ إنْ لم","يَرْغَبوا عنْ عبادة النّيرانِ",60,"ن",1,0],["وَأَلهاهُ شُربٌ ناعِمٌ وَقُراقِرٌ","وَأَعياهُ ثَأرٌ كانَ يَطلُبُ في حُجرِ",61,"ر",1,0],["وا لهفَ نفسي كم تمنَّيتَ المُنى","يوم السيوف تقَرُّ في الأغمادِ",62,"د",1,0],["والهوى يَعْجب من مغتربَيْنْ","لم يَقُلْ أنتِ ولا قالتْ أنا",63,"ن",2,0],["والْهُ مع الغيد والعذارى","وغنّ بالكأس والوترْ",64,"ر",1,0],["وألهفَ قلبكَ لما اندكَّ شامخُها","والنوءُ مصطرعٌ والموجُ هدّارُ",65,"ر",1,0],["وآله بين مخالب الأسد","يتنزع الروح ويهتك الجسدْ",66,"د",1,0],["والهَزَجُ الذي هو السّوارُ","عليهِ للثالثةِ المَدارُ",67,"ر",1,0],["وَالهامُ تَندُرُ بِالصَعيدِ كَأَنَّما","تُلقي السُيوفُ بِها رُؤوسَ الحَنظَلِ",68,"ل",1,0],["وَالْهُ بِمَا شِئْت قَبْلَ مَنْدَمَةٍ","يَكْثُرُ فِيهَا الْعَنَاءُ وَالْكَمَدُ",69,"د",1,0],["وَالهَابِطِينَ إِلَى الثَّرَى","وَالصَّاعِدِينَ إِلَى القِمَمْ",70,"م",1,0],["وَالهِلاَلِيُّ كَانَ أَجْدَرَ مَنْ يَجْ","لُو بِنُورٍ غَيَاهِبَ الظُّلُمَاتِ",71,"ت",1,0],["وَالَهْفَ مِصْرَ عَلَى فَقَيدٍ رِزْءُهُ","رِزْءٌ إِذَا أَحْصَيْتُهُ لَمْ يُعْدَد",72,"د",1,0],["والهوى يوحي إليّا","برسالات العيون",73,"ن",1,0],["وألهو بنفس القرارات","أهذي بنفس الخطابات",74,"ت",1,0],["وألهمتَها معنى الثناء ولفظَهُ","كريماً فخذْه اليومَ من فَمِها نَغْما",75,"م",2,0],["والهَوى أمْرَدُ المحيَّا يناغي","فِتْيةً تُشبهُ الدنانير مُرْدَا",76,"د",2,0],["والهمُّ يجلو النفوسَ إن صَدئت","والهمُّ فيه رياضة البدن",77,"ن",1,0],["وآله وجميع الصحب من شهدت","بفضلهم ابديا ألسن السور",78,"ر",1,0],["والهوى والشباب والأمل المن","شود ضاعت جميعها من يديّا",79,"ي",2,0],["والهِيمُ تخزُنُهُ وتنهبُهُ","والغِيدُ تُنزِلهُ وتصُعِده",80,"د",2,0],["وألهمَ الناسَ كي يَرضَوا مغبَّتهم","أن يُوسعوا العقلَ ميداناً ومضطَربا",81,"ب",2,0],["والهوى باقٍ مع المرء إذا","كان من عصرِ الصِّبا عنه ذهاب",82,"ب",1,0],["وإلهة الوادي تثور بعريها","وثبا للجّة نهره المنساب",83,"ب",1,0],["والهموم الحسان تفعل في الأنفس","ما تفعل الغواني الحسان",84,"ن",1,0],["والْهُ عن عذلك سمعاً قد مَرَنْ","ودع العدلَ فسمعي قد مرن",85,"ن",1,0],["وألهجَ الحمد بالإيطانِ بينهمُ","أن ليس بينهُم للمالِ إيطال",86,"ل",1,0],["والهامُ تنذرُ بالصعيد كأنما","تُلْقي السُّيوفُ بها رُؤوس الحنظل",87,"ل",1,0],["والهفتاه على زمان قد مضى","كنا عن البعد المريع بمعزل",88,"ل",1,0],["والهج بذكر الله ثم تحققا","اخلص ودادك للنبي وآله",89,"ل",2,0],["والهف قلبي والايام خائنة","والوقت ظل وركب العمر مرتحل",90,"ل",1,0],["والهفتاه لوقت قرب مرلي","مع من احب مضى وآه لو بقي",91,"ق",2,0],["والهف قلبي فالتي قد ازمعت","تركت لنا صفو القلوب مكدرا",92,"ر",2,0],["والهفتاه أو يقاتي بهم قصرت","وبعدهم لي آهات طويلات",93,"ت",1,0],["والهندواني لم يقطع وجرحته","سحا عليها الشفاء المحض ينسكب",94,"ب",1,0],["والهفي عنكم ودين الهوى","لم ابغ منه الصبر الا ابى",95,"ب",2,0],["وآله الاطهار والصحب الغرر","وابن الرفاعي وغريب الغربا",96,"ا",1,0],["والهفتي لم ارم","لقياه الا ابي",97,"ب",2,0],["والهم عم اولى الفضائل واحتست","كأس الصفاء لجهلها الجهلاء",98,"ا",2,0],["والهوى قد هوى علي ببأس","صارع قد رأيت فيه خبالا",99,"ل",2,0],["وآله والصحب والأوليا","ما عطر النظم بمسك الختام",100,"م",1,0],["وآله والصحاب الطيبين ومن","صاروا بنسبته غرا ميامينا",101,"ن",2,0],["والهيكل المحفوظ في طي العمى","من قبل صبغة طينها والماء",102,"ا",2,0],["والهُتافُ المُتَعالي جَزَعًا","ليسَ إلّا مِنْ حَريقِ الوَطَنِ",103,"ن",1,0],["والهاتفُ المَلْعُونُ حيثُ أكونُ","يَتْبَعُني، ويَعْزِفُ كُلَّ ثانيةٍ رَقَمْ",104,"م",1,0],["والهبر يرفل في نعمى تشرده","بين الكواعب محفوفاً بأقمار",105,"ر",1,1],["والهبر قد زار الربوع","فيا هلا عم السلام",106,"م",1,0],["والهِلاَلُ التَّميمُ لَيسَ بِلَحنٍ","لَو نَظَرتَ اللُّغَى وكُنتَ فِهِيمَا",107,"م",2,0],["والهَيكَلَ الطِّرفَ المُسَوَّمَ مُسرَجاً","والشَّد قَمِىِّ المُقسَئِنَّ البَازِلا",108,"ل",2,0],["والهَوَى يَانِعُ الرِّيَاضِ مُطِيعٌ","والشَّجِىُّ المَلُومُ غَيرُ مُطِيعِ",109,"ع",1,0],["وَأَلهَمَكَ البَأسُ الهُجومَ عَلى الرَدى","فَلَم تَهَبِ الهَولَ الَّذي أَنتَ راكِبُ",110,"ب",1,0],["وَالهِمَّةُ البِكرُ الَّتي لَم تُفتَرَع","خَصَّتكَ بِالشَرَفِ الَّذي لَم يُفرَعِ",111,"ع",1,0],["وَالهِمَّةُ البِكرُ الَّتي لَم تُفتَرَع","خَصَّتكَ بِالشَرَفِ الَّذي لا يُفرَعُ",112,"ع",1,0],["والهج بمدحِ الهاشم","ي فإنه الحصن الحصين",113,"ن",1,0],["والهَوى لا خِفْتُ عاذِلَتي","في هَوى مَنْ جَلَّ عن صِفَتي",114,"ت",2,1],["والهام تسجد كلما صلت بها","وركعن بيضك والخدود تعفر",115,"ر",1,0],["وَالهاتِكينَ عَلى الجَبّارِ قُبّتهُ","شَدَّ النَهارِ بِلا خَوفٍ وَلا رَهَبِ",116,"ب",1,0],["وَالهامُ تُصدَعُ بِالسُيوفِ وَلِلقنا","وَقعٌ فَريصُ المَوتِ مِنهُ تُرعَدُ",117,"د",1,0],["وَالهَوى مَورِدُ الظُنون وَبَعض الظ","ظنِّ إِثمٌ غَلِطتُ بَل حاشاها",118,"ا",3,0],["وألهاك عَذْلىَ عن أن تفوزَ","بنفسِك من ذلك المَصْرع",119,"ع",1,0],["والهرّ يمنعها التأديب عن سرَق","خوفا وفي طبعها في الخلوة السرق",120,"ق",1,0],["وإله دمعتي تفيض من العي","ن بماء وتارة بنجيع",121,"ع",1,0],["والهف للمرء الذي","عادت مسرّته مضرّه",122,"ر",2,1],["والهزير الهصور أصبح كبشا","خاضعا رغم أنفه للكلاب",123,"ب",1,0],["والهاتِفونَ إذا الدماءُ تدفّقَت","أعني دما الأبطالِ بالميدانِ",124,"ن",1,0],["والهوى للقلبِ فخٌ","يخدعُ الطيرَ بحبِّ",125,"ب",1,0],["والهوى يستزيد حالاً فحالاً","وكذا يَنسَلي قليلاً قليلا",126,"ل",2,0],["والهمِّ والغمِّ الممضّ تجدّدا","والأنس ولَّى بالسّرور وأدبرا",127,"ر",2,0],["والهدايا نبتهن بأنسى","فكنوز السرور تحت يدينا",128,"ن",2,0],["والهلال المنير ليس يمارى","أنني من سناه أنور ذهنا",128,"ن",2,0],["والهواء الطلق يهفو عابثا","بغصون تتثنى بدلال",129,"ل",1,0],["وَالهِوى دون اكبُدٍ لَيسَ يَحيا","فَغِذاءُ الهوى من الأَجسامِ",130,"م",1,0],["وَالهَوى في فُؤادَكَ المَوجوعِ","وَلَياليكَ في ظَماءٍ وَجوعِ",130,"ع",1,0],["وَالهَوى أَصغِ في الرِياضِ إِلى البُل","بُلِ وَاِحذَر فَإِنَّ فيها غُرابا",131,"ب",2,0],["وَالهَوى مَرتَعُ النَعيمِ فَذَلِّل","سُبُلَ الفَتحِ وَاِملِكِ الأَسبابا",131,"ب",2,0],["وَالهَوى ما رَوى","إِلّا هوايا",132,"ي",2,0],["وَآلهفَ قَلبي أَينَ مِنهُ قَصائِدٌ","لَم يروِها حَتّى بَيانُ الأَصمَعي",133,"ع",2,0],["وَآلهفَ قَلبي كَيفَ واراهُ الثَرى","وَأَنا هُنا أَحيا بِعَيشٍ أَمرعِ",133,"ع",1,0],["وَالهَوى شارِد البَصائِر أَعمى","ليسَ يَدري بِما بهِ العَقل أَدرى",134,"ر",2,0],["والهمُّ بالخطب قبل الخطب مَنْبهةٌ","ومن رَمى بسهام الحزم لم يَخِب",135,"ب",1,0],["وَالهَجرُ مِنكُم لا يَلُمُّ بِهِ النَوى","يا سادَتي نَعَقَ الغُرابُ الأَبقَعُ",136,"ع",1,0],["وَالهَوا وَالماءُ في وَص","فَي فُتورٍ وَنَشاطِ",137,"ط",1,0],["وَآلِهِ وَصَحْبِهِ","مِنْ كُلِّ لَيْثٍ مِحْرَبِ",138,"ب",1,0],["وَالْهُدَى أَصْلَتَ مِنْ فَهْمِهِ","بِيَمِينِ الْيُمْنِ أَمْضَى الصِّفَاحْ",139,"ح",1,0],["وَآلِهِ وَالصِّحَابِ وَمَنْ تَلاَهُمْ","بِإِحْسَانٍ إِلَى يَوْمِ التَّنَادِي",140,"د",2,0],["وَآلِهِ طُرّاً وَالصَّحَابَةِ كُلِّهِمْ","وَمَنْ لَهُ فِي إِجْلاَلِهِمْ أَيُّمَا قِسْطِ",141,"ط",1,0],["وَآلِهِ وَجَمِيعِ الصَّحْبِ مَا قَطَفَتْ","يَدُ الصَّبَابَةِ أَلْبَابَ الْمُحِبِّينَا",142,"ن",2,0],["وَآلِهِ وَالصِّحَابِ وَتَابِعِيهِمْ","وَمَنْ أَعْلَى لِدِينِ اللهِ رُكْنَا",143,"ن",2,0],["وَآلِهِ وَالصَّحْبِ مَا صَدَحَتْ","حَمَامٌ وَمَا ظَبْي