https://poetry.dctabudhabi.ae/diwan/poem/85375","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147505","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16626","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19720",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55163","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54860","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54828","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54517","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55146","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43731","الرمل"],[106,"يا راعي الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179702",""],[106,"الطفل الموءود!","https://www.poetsgate.com/ViewPoem.aspx?id=179638",""],[106,"مضيفة الطائرة","https://www.poetsgate.com/ViewPoem.aspx?id=179675",""],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[106,"ذكرى محمد ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=179428",""],[106,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[90,"على سعد","https://www.poetsgate.com/ViewPoem.aspx?id=179079",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[90,"بريد الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=179052",""],[90,"شدة لندن!..","https://www.poetsgate.com/ViewPoem.aspx?id=179068",""],[90,"فلسطين الدامية","https://www.poetsgate.com/ViewPoem.aspx?id=179033",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[57,"ما شئت كان وإن لم أشأ","https://www.poetsgate.com/ViewPoem.aspx?id=3314",""],[51,"ومُنْزل الوحْي علي نبيِّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30760",""]],"verses":[["ما شى الرِفاقَ يُراعي أَينَ مَسقِطُهُم","وَالسَمعُ مُنتَصِبٌ وَالقَلبُ يَقظانُ",0,"ن",1,0],["ما شِئتُ مِن والِدٍ يودي وَمِن وَلَدٍ","يَمضي الزَمانُ بِآسادي وَأَشبالي",1,"ي",1,0],["ما شَقَّقوا إِلّا كُساكَ وَأَلَّموا","إِلّا الأَنامِلَ نِلنَ مِنكَ سِجالا",2,"ل",2,0],["ما شِئتَ مِن لينِ أَخلاقٍ وَمَكرُمَةٍ","وَمِن عَفافٍ وَمِن فَضلٍ وَمِن وَرَعِ",3,"ع",1,0],["ما شِئتُ مِن دَمعٍ لَكُم مُتَحَدِّرٍ","وَزَفيرِ وَجدٍ بَعدَكُم مُتَرَفِّعِ",4,"ع",1,0],["ما شُدَّ لي يَوماً عَلى","ذُلٍّ وَلا طَمَعٍ حِقابُ",5,"ب",1,0],["مَا شِئْتَ مِنْ فَضْلٍ عَمِيمٍ إِنْ سَقَى","أَرْوَى وَمَنٍّ لَيْسَ بِالمَمْنُونِ",6,"ن",1,0],["مَا شِئْتَ مِنْ خُلُقٍ وَمِنْ","خَلْقٍ وَمِنْ بَأْسٍ وَنَائِلْ",7,"ل",1,0],["ما شِئْتَ منْ هِمَمٍ ومنْ شِيَمٍ غَدَتْ","كالرّوْضِ أو كالزّهْرِ في الأدْواحِ",8,"ح",1,0],["مَا شئْتَ فِي آفاقِها مِنْ رَامِحٍ","يَبْدُو وَكَفٍّ بِالنّجيعِ خَضِيبِ",9,"ب",1,0],["ما شَرُّها بَعدَ ما إِبيَضَّت مَسائِحُها","لا الوُدَّ أَعرِفُهُ مِنها وَلا اللَطَفا",10,"ف",2,0],["ما شَكا الجوعَ مُعدَمٌ أَو تَصَدّى","لِرُكوبِ الشُرورِ وَالآثامِ",11,"م",1,0],["ما شَدَّ بَندَ قَبائِهِ","إِلّا وَحَلَّ بِهِ العَزائِم",12,"م",1,0],["ما شِئتَ فَاصنَعهُ كُلٌّ مِنكَ مُحتَمَلٌ","وَالذَنبُ مُغتَفَرٌ وَالعُذرُ مَقبولُ",13,"ل",1,0],["ما شق جيباً للفجيعة من تقىً","لكن تحملها بشق مرائر",14,"ر",1,0],["ما شئت حدث عن حبيب الندى","ولا تصن مدحك فيما بذل",15,"ل",1,0],["مَا شِئْتَ مِنْ شَكْوَاكَ زِدْهُ فَإِنَّمَا","شَكْوَاكَ مِنْهُ ايَةٌ مِنْ حَمْدِهِ",16,"د",2,0],["مَا شِئْتَ إِطْرَاءً فَقُلْ فِيهِ وَفِي","أَصْحَابِهِ الصُّيَّابَةِ الشُّجْعَانِ",17,"ن",1,0],["مَا شِعْرُ حَافِظَ إِلاَّ صُورَةٌ مَثَلَتْ","لِلنَّيْلِ فَاضَ بِأَلْوَانٍ مِنَ النِّعَمِ",18,"م",1,0],["مَا شَهِدْنَا المُلُوكَ مِنْ قَبْلُ إلا","صُوَراً فِي الجِدَارِ أَوْ أَصْنَامَا",19,"م",2,0],["ما شِمتُ بارقةً من جوٌ كاظمةٍ","إلاَّ وبتُّ لزند الشوق مُقتدحا",20,"ح",2,0],["ما شئتَ من مجد قديم شاده","أبناءُ قيلةَ أشرف الأقيالِ",21,"ل",1,0],["ما شئت من حسن يفوق كمالُهُ","ويروق منظره الجميل الحالي",21,"ل",2,0],["ما شاد فيها فؤاد قد أقيِم على","ما شاد عمرو بها في سالف الحقب",22,"ب",1,0],["ما شبّ إلاّ على التقوى وكان له","قلب سليم بحبّ الخير قد شغفا",23,"ف",2,0],["مآشير ما كان الرخاء حُسَافةُ","إذا الحرب سماها صُرامَ الملقِّبُ",24,"ب",1,1],["ما شادَ إسماعيلُ بيتَ فخاره","إلا ليستدعي إليه محمدا",25,"د",2,0],["ما شمت بارق جدواه فأخلفني","ولا عهدت إلى معروفه فنسي",26,"س",2,0],["ماش من شئت في طرائق شتَّى","من علومٍ فإنه يتلاشى",27,"ش",2,0],["ما شيبة في فود مستجلى الدّمى","إلاَّ قذاة بين جفني أمرَه",28,"ه",1,0],["ما شفَّ جسمي في الهوى","إلا مراقبةُ الرقيبْ",29,"ب",1,0],["ما شاء من ديمةٍ رَكُودٍ","تَهْمِي ومن وابلٍ حَثيثِ",30,"ث",1,0],["ما شئتَ من مالٍ حِمىً","يأوي إلى عِرْضٍ مباحِ",31,"ح",1,0],["ما شئتَ من يُمنٍ ورأي منقادْ","وَسَوْقِ أموالٍ وَقَوْد أجنادْ",32,"د",1,0],["ما شَيَّبت رأسهُ السنون ولا","أبلتهُ بل حَرُّ وجدِهِ صَهره",33,"ر",2,0],["ما شتْمُ من أمه الده","رَ مركبي بمُمِضِّ",34,"ض",1,0],["ما شئتَ من عقل ضعيفٍ واهنٍ","فيهم ومن خبلٍ شديد ضابطِ",35,"ط",1,0],["ما شئتَ من أنجُمٍ وضاءٍ","ومُمطِراتٍ ومِنْ رُجومِ",36,"م",1,0],["ما شكا منك حاشَ لله ما تش","كوه من ذي تمرُّدٍ ومجُون",37,"ن",1,0],["ما شِبتُ مِن كِبَر وَلَكِنَّ الَّذي","حَمَّلتِ نَفسي حَمَّلتُهُ الفودا",38,"د",2,0],["ما شِمتُ حُسنَكَ قَطُّ إِلّا راعَني","فَوَدِدتُ لَو رُزِقَ الجَمالُ خُلودا",38,"د",2,0],["ما شَقَّ مَكروهُ الأُمورِ عَلى اِمرِئٍ","إِلّا وَتِلكَ أَشَقُّ مِنهُ وَأَصعَبُ",39,"ب",1,0],["ما شئت من حور وغلمان","وطيبة مأكل",40,"ل",1,0],["ما شاهدت عيني ممث","ثلة كفاطمة الشهيره",41,"ر",2,1],["ما شئت من صدق ومن","حذق ومن رأي حصيف",42,"ف",1,0],["ما شَرِبوها وَما","طالَ عَلَيها القِدَم",43,"م",1,0],["ما شِدَّةُ الحِرْصِ مِنْ شَأني ولا طَلَبي","ولا المَكاسِبُ مِنْ هَمِّيْ ولا أَرَبِي",44,"ي",1,0],["ما شارَكَتهُ مَنِيَّةٌ في مُهجَةٍ","إِلّا وَشَفرَتُهُ عَلى يَدِها يَدُ",45,"د",1,0],["ما شَكَّ خابِرُ أَمرِهِم مِن بَعدِهِ","أَنَّ العَزاءَ عَلَيهِمِ مَحظورُ",46,"ر",1,0],["ما شَيَّدَ اللَهُ مِن مَجدٍ لِسالِفِهِم","إِلّا وَنَحنُ نَراهُ فيهِمِ الآنا",47,"ن",2,0],["ما شئتَ من وعدٍ يساوِقُه","نُجْحٌ وقولٌ تِلوُهُ عملُ",48,"ل",1,0],["ما شِئتَ مِن طَولٍ وَإِحسا","نٍ وَمِن كَرَمٍ وَسُؤدُد",49,"د",1,0],["ما شِبتُ مِن طولِ السِنينَ وَإِنَّما","طولُ المَلامَةِ فيكَ شَيَّبَ راسي",50,"ي",1,0],["ما شِفاءُ المُتَيَّمِ الصَبِّ إِلّا","شُربُهُ مِن رُضابِكِ السَلسَبيلِ",51,"ل",1,0],["ما شيَّعَتْهُ بدَمْعِها مُقَلُ الدُّمَى","إلا وقد أبكَيْنَ مُقلَتَه دَما",52,"م",2,0],["ما شَنَّ وهو ضَعيفُ البَطْشِ غارَتَه","إلا استباحَ حِمى الشُّمِّ اللَّهاميمِ",53,"م",1,0],["ما شَمَّرَ الأعداءُ إلا راعَهم","بنُهوضِ أروعَ للِّقاءِ مُشمِّرِ",54,"ر",1,0],["ما شَرَفُ الدُنيا بِشَيءٍ إِذا","لَم يَتَّبِعهُ شَرَفُ الآخِرَة",55,"ه",1,0],["ما شَرَفُ المَرءِ كَالقَناعَةِ وَال","صَبرِ عَلى كُلِّ حادِثٍ يَقَعُ",56,"ع",1,0],["ما شِمتُ هَذا في مَخا","يِلِ بارِقاتِ سَمائِهِ",57,"ا",3,0],["ما شَبَّ مِن خَصلَتي حِرصي وَمِن أَمَلي","سِوى مَديحِكَ في شَيبي وَفي هَرَمي",58,"م",2,0],["ما شاهَدَت عَينايَ قَبلَكَ حاكِماً","يُعزى إِلى فِعلِ الجَميلِ فَيُعذَلُ",59,"ل",1,0],["ما شاهَدَت عَينايَ قَبلَ جَمالِهِ","بَدراً عَليهِ هالَةٌ مِن أَنجُمُ",60,"م",1,0],["ما شامَ بَعدَكَ أَهلُ الشامِ بارِقَةً","لِلفَضلِ حينَ ذَوى مِن رَبِّهِ العودُ",61,"د",1,0],["ما شَهِدنا مِن قَبلِها لَكَ حالاً","كُنتَ فيها خِلواً مِنَ الحُسّادِ",62,"د",1,0],["ما شانَها غِيرُ بَغيِ الجاهِلينَ بِها","كَأَنَّها جَنَّةٌ فيها شَياطينُ",63,"ن",1,0],["ما شانَهُ إِلّا مَقالُ العِدى","وَقَد هَمَت عَيناهُ ما شانُه",64,"ن",2,0],["ما شامَ بَرقَ الشامِ إِلّا هَمَت","بِوابِلِ الأَدمُعِ أَجفانُه",64,"ن",2,0],["ما شاهَدَ الأَملاكُ مَجَّةَ ريقِهِ","إِلّا وَجَفَّ الريقُ في لَهَواتِها",65,"ت",3,0],["ما شَدَّدَ النونَ الثَقيلَ لِأَنَّهُ","إِن قالَ يَسبُقُ فِعلَهُ التَأييدا",66,"د",2,0],["ماشيت هذا العصر في سيره","والعصر يعلو بجناح النسور",67,"ر",1,0],["ما شِعرُهُ كُفأً لِشِعري فَليَمُت","غَيظاً وَلا الخُلُقِيُّ مِن أَكفائي",68,"ي",1,0],["ما شِئتَ مِن مَنظَرٍ عَجيبٍ","فيهِ وَمِن مَنطِقٍ أَريبِ",69,"ب",1,0],["ما شَكَّ أَثبَتُهُم يَقيناً أَنَّهُ","لِلمَوتِ في قَبضِ النُفوسِ رَسولُ",70,"ل",1,0],["ما شَدَدتُ الأَوذامَ في عُقَدِ الأَك","رابِ حَتّى وَرَدتُ مِلءَ الحِياضِ",71,"ض",1,0],["ما شاهَدَ اللَبسَ إِلّا كانَ مُتَّضِحاً","وَلا نَأى الحَقَّ إِلّا كانَ مَلبوسا",72,"س",2,0],["ما شمَّرَتْ ساقاً لتسقيكَ الطلا","إلا لتدهشَ منْ جمالِ الساقِ",73,"ق",1,0],["ماشطةً ناشطةً في رضى","عشَّاقِها قلتُ لها خِفْيَهْ",74,"ه",1,1],["ما شأنُ أعدائِهِ والعلمُ إذْ سفَهٌ","حملُ الحُلي بمنْ أعيا عن النظرِ",75,"ر",1,0],["ما شاقَني في زماني قربُ غائبةٍ","رنَّتْ ولا راقني ذو منظرٍ بهجِ",76,"ج",1,0],["ما شرْتُ في المكتبِ صنفينِ مِنْ","شبْهِ الشواهينِ وشبهِ الذئابْ",77,"ب",1,1],["ما شبْتُ وحدِي عذارُ الماءِ شابَ إلى","أنْ صارَ ثلجاً كذا الأحوالُ تنقلبُ",78,"ب",1,0],["ما شَجاكَ الغَداةَ مِن رَسمِ دارِ","دارِسِ الرَبعِ مِثلِ وَحيِ السِطارِ",79,"ر",1,1],["ما شِئتَ مِن قُرَناءِ خَيرٍ أَعصَفَت","ريحُ الرَدى بِهِم وَمِن قُرَباءِ",80,"ا",2,0],["ما شاءَ ربُّكَ أن يكونَ عِبادُهُ","هَمَلاً ولا خَلقَ الشُّعوبَ أسارى",81,"ر",2,0],["ما شاءَ رَبُّكَ أَن يَكونَ طُغاتُهُم","في الناسِ آلِهَةً وَلا أَصناما",82,"م",2,0],["ما شِئتَ مِن سُؤْدُدٍ عالٍ ومن شَرَفٍ","على اليهودِ ويَجزِي اللَّهُ من شكرا",83,"ر",2,0],["ما شاءَ قُمتُ خَطيبا","فَقُلتُ وَالحَقُّ أَولى",84,"ل",2,0],["ما شاقَهُ لِغَزالٍ في الظّبا غَزَلٌ","وَلا لِغانِيَةٍ في طَرفِها حَوَرُ",85,"ر",1,0],["ما شِئتَ لا ما شاءَتِ الأقْدارُ","فاحكُمْ فأنتَ الواحد القهّارُ",86,"ر",1,0],["ما شِئتَ مِن بَلَدٍ تَدنو مَنازِهُهُ","لَكِنَّ فيهِ قَبيلاتٍ وَأَفخاذا",87,"ذ",2,0],["ما شاطرٌ في اللواطِ منغمسٌ","مجانبٌ للرشادِ عن سبُلِه",88,"ل",2,0],["ما شانها عضٍّ وقد صيّرت","لي نخبةً دون الرياحين",89,"ن",1,0],["ما شَدَّ رَبُّكَ أَزراً بي فَيَنقُصني","مِن رُتبَةٍ لِيَ مَن بِالقَولِ أَزرابي",90,"ي",1,0],["ما شِرَّةٌ مِن خَليلِ النَفسِ واحِدَةٌ","لا بَل تُوافيكَ مِن تِلقائِهِ شِرَرُ",91,"ر",1,0],["ما شَفَّني بُردٌ أَمَحُّ سِوى الصِبا","وَلَقَد تَمَزَّقَ لي سِواهُ مُلابِسُ",92,"س",1,0],["ما شِمتَ مِن شَمّاءَ قَبلُ وَهَل نَأَت","خَنساءُ عَن شَيطانِها الخَنّاسِ",93,"س",1,0],["ما شَدَّ صَرفُ زَمانٍ عِقدَةً لِأَذىً","إِلّا وَمَرُّ لَياليهِ يُراخيها",94,"ي",3,0],["ما شفى الماء منذ حين