جان",120,"ن",1,0],["ما شوقُ أهل الشوق في عُرفِ الهوى","نُكرٌ فقد خُلِقوا لكي يشتاقوا",121,"ق",3,0],["ما شَقِينا إلاّ لأنا حسِبْنا","أن في الكذب جرأة أدبيه",122,"ي",2,0],["ماشت عواطفَها في الحكم فارتطمت","مثلَ الزجاجِ بحد الصخرة ارتطما",123,"م",2,0],["ما شربنا الكؤوس الا لانّا","قد رأينا فيها لخديكَ عَكْسا",124,"س",2,0],["ما شئت كان وإن لم أشأ","وما شئت إن لم تشأ لم يكن",125,"ن",1,1],["ما شئتَ عجّاجِيه رُوبيِّهْ","لم يتقاصر عَنْ مُسَيبيِّه",126,"ب",3,0]]}