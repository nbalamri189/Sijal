مَلِكٍ وَسوقَةٍ","لَم يُدرَ ما العِزُّ وَنامٍ وَيَفَن",0,"ن",1,0],["بَينَ عَجاريفِ العَنيقِ وَالرَمَل","مُشتَمِلاً بُردَ الجَنوجَبِ وَالشَمَل",1,"ل",1,0],["بَينَ عَزمي وَبَينَهُنَّ حُروبُ","إِنَّ أَقواهُما هُوَ المَغلوبُ",2,"ب",1,1],["بَيْنَ عَهْدٍ مَضَى وَعَهْدٍ تَلاهُ","صِلَةٌ أَوْثِقَتْ لِغَيْرِ انْفِصَامِ",3,"م",1,0],["بين عفاةٍ له وبين عدا","ما يدٌ سمِّيت لديه يدا",4,"د",2,0],["بَينَ عَلياءِ وابِشٍ فَبُلِيٍّ","فَالغَميمِ الَّذي إِلى جَبَلِه",5,"ل",2,0],["بين عينيك وقلبي رحمة","نقلت عيناك لى ما أسمعك",6,"ك",1,0],["بَينَ عَينِهِ","وَالمَها نَسَب",7,"ب",1,0],["بَينَ عِتاقِ الخَيلِ وَالعَتائِقِ","فَعُنقُهُ يُربي عَلى البَواسِقِ",8,"ق",1,0],["بين عينيك ليس يعدوك منها","إن تفطنت فائض الخيرات",9,"ت",1,0],["بَينَ عَينَي كُلَّ حَيٍّ","عَلَمُ المَوتِ يَلوحُ",10,"ح",1,0],["بين عبريهما ثوتْ غُرُّ أيا","مي وحال الوضيءُ من ليلاتي",11,"ت",2,0],["بين عَدنانَ وغَسّانَ لهم","نسَبٌ يرفَعُ شأوَ النسب",12,"ب",1,0],["بَيْنَ عُودٍ كم هَزَّ أعطافَ رَمْسِيسَ","وحَيَّا مَواكِبَ الأَقْيالِ",13,"ل",1,0],["بين عواليهنَّ والسوافِل","نشرُ قرونٍ جعدة ِ السلاسل",14,"ل",1,0],["بينَ علياءَ وابشٍ، قبلي،","فالغميمُ الذي إلى جبلهِ",15,"ل",2,0],["بَينَ عُرفٍ يَدُ المُسيفِ بِهِ مَل","أى وَعَرفٍ لِمارِنِ المُستافِ",16,"ف",1,0],["بين عينَيه روضَةٌ","نزهة للخلائقِ",17,"ق",1,0],["بين عارضين وعارضين","وشامتين وشامتين",18,"ن",1,0],["بَينَ عَينَيهِ تَراءى هَيكَلٌ","سَجد الحسنُ بِذاكَ الهَيكَلِ",19,"ل",1,0],["بَينَ عودٍ وَبَينَ نايٍ وَجَنكٍ","وَطَبيبِ القانونِ بِالقانونِ",20,"ن",1,0],["بين عينيه وبين ال","نومِ قد أُعلنَ حرب",21,"ب",1,0],["بين عيشي وبين موتي فروقٌ","هي عندي يسيرةُ العرفان",22,"ن",1,0],["بين عَينَيْ عَينَيهِ قد بانَ منكمْ","كامِنُ النُّورِ للنّبِيِّ فَسُرّا",23,"ر",2,0],["بَينٌ عَلى قُربٍ كَما المَلوانِ","أَخَوانِ لَم يَجمَعهُما دارانِ",24,"ن",1,0],["بين عين الصفا وعين زحلنا","منظر عز وصفه بلسان",25,"ن",1,0],["بَينَ عانٍ في القيدِ غير طليقٍ","وقَتيلٍ بالسّيفِ غير شهيدِ",26,"د",1,0],["بين عينيه قد كمن","بين عينيه قد كمن",27,"ن",1,0],["بين عمٍّ وابنِ عمٍّ","حولَه كانوا عَرينا",28,"ن",2,0],["بينَ عامٍ مضى وعامٍ جديدِ","مَوعظاتٌ تبدو لعين الرشيد",29,"د",1,1],["بينَ عَيْنِيْ وَوَجْنَتَيكَ حَديثٌ","مُقْتَضاه شَرْحُ الهَوى والفُتُونِ",30,"ن",1,0],["بين عينيها وقلبي معرك","من لثاري عند تلك النظرات",31,"ت",1,0],["بين عاضد موز وغرايس","بالنّدى تتفتّح ازهوره",32,"ر",2,0],["بَينَ عَينيه للسيادة نُور","كُلما لاحَ خلت بَرقاً لَموعا",33,"ع",2,0],["بين عيش ذهبت نضرته","وحبيت غائب ليس يئوب",34,"ب",1,0],["بين عقل مسيطر وشعور","مستبد أصبحت كالمجنون",35,"ن",1,0],["بين عيدٍ أتى وعيدٍ تولى","سنةٌ خطبها على الناس جلا",36,"ل",2,1],["بين عيدين فرق الدهر اهلي","ها وافنى الألوف موتاً وقتلا",36,"ل",2,0],["بين عالٍ سامٍ ينكّسُهُ الحظ","ظُ ويعلو بسَافِلٍ مرزوقِ",37,"ق",1,0],["بين عرشان والشجنين في خير بلده","في البلاد الذي هي خير من مصر عنده",38,"د",2,0],["بين عيني وروحي يرسم الحب صوره","الله اللي نحتها بالغلا في فضاه",39,"ا",2,0],["بين عينيها وعيني رُسُلٌ","حَمَلَتْ آياتِ شوقٍ وحنينْ",40,"ن",1,0],["بين عينيها وعيني لُغَةٌ","بحروفٍ لِسوانا لاتَبينْ",40,"ن",1,0],["بين عينيها وعيني قد سرى","من وراء الغيبِ اِيحاءٌ دَفينْ",40,"ن",1,0],["بين عينيهِ قِبلةٌ للحيَارى","يوم صلّوا بظلّها، فاستقاموا",41,"م",3,0],["بين عُمرين اختفى من عامِهم","شَهرُ ميلادٍ وأصدافُ المَحَار",42,"ر",1,0],["بين عُجب النفوس والكبرياء","وادعاء الجلالة الجوفاء",43,"ا",2,1],["بين عينيك ساطعٌ حان قتلي","اقبض الروح ياحبيبي وخذني",44,"ن",2,0],["بين عزمٍ على المَضاء وحزمٍ","وسخاءٍ في حِلمه المحمود",45,"د",1,0],["بين عليك اللوم واثقل عتابه","عطنا الكلام ولاتكن المشاريه",46,"ي",2,0],["بين عقدٍ مرتّلِ الحسن والنَّ","ظم وبردٍ محبَّر التفويف",47,"ف",1,0],["بَينَ عُيُونِ الخَلقِ قَد سَطَعَتْ","بَينَ دُرُوبِ الهَدي كالعَلَمِ",48,"م",1,0],["بين عينيك والقلوب حروب","تتلاشى فيهن حرب الأساطل",49,"ل",1,0],["بين عينيك لي حبيب أليفٌ","زرع الأرض والسما أقحوانا",50,"ن",2,0]]}