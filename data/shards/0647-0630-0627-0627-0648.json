{"poems":[[55,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[12,"أونس ريح الموت في المكاسر","https://www.aldiwan.net/poem1213.html",""],[63,"هذا أوان ثمار له","https://www.aldiwan.net/poem51621.html","مجزوء الكامل"],[83,"هذا أوان فضيحتي لبيك يا","https://www.aldiwan.net/poem61444.html","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[208,"هيجني تذكر الأظعان","https://www.aldiwan.net/poem53166.html","الرجز"],[366,"يا قلب أبشر زالت الاكدار","https://www.aldiwan.net/poem68105.html","الكامل"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[466,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[484,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[566,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46469","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53199","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112598","الكامل"],[3826,"","https://poetry.dctabudhabi.ae/diwan/poem/84997","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54381","الكامل"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105178","السريع"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105171","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120356","الكامل"],[4680,"حتى يذهب الزبدُ","https://www.poetsgate.com/ViewPoem.aspx?id=185028",""],[5009,"إبتهال","https://www.poetsgate.com/ViewPoem.aspx?id=68090",""],[5033,"حسّان","https://www.poetsgate.com/ViewPoem.aspx?id=183980",""],[5277,"لوحةٌ ذهنية","https://www.poetsgate.com/ViewPoem.aspx?id=187829",""],[5277,"لا شيء في كفّي","https://www.poetsgate.com/ViewPoem.aspx?id=187908",""],[5277,"عشّاقُ الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=194588",""],[5277,"رسالةٌ إلى زهرة المدائنْ","https://www.poetsgate.com/ViewPoem.aspx?id=199986",""],[5281,"ليلة المعراج","https://www.poetsgate.com/ViewPoem.aspx?id=199707",""],[5433,"سيف العشق","https://www.poetsgate.com/ViewPoem.aspx?id=36119",""],[5533,"عَوْدَةُ مُهاجِر","https://www.poetsgate.com/ViewPoem.aspx?id=176272",""],[5559,"بيننا شغاف الروح ( محمود أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=60738",""],[5612,"حلم العمر","https://www.poetsgate.com/ViewPoem.aspx?id=198379",""],[5612,"هذا أوَانُ السَّعْد","https://www.poetsgate.com/ViewPoem.aspx?id=204515",""],[6093,"الأحواز","https://www.poetsgate.com/ViewPoem.aspx?id=195046",""],[433,"شاء الهوى أم شئتِ أنتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87054&r=&rc=7",""]],"verses":[["هَذا أَوانُ تَطاوُلِ ال","حاجاتِ وَالأَمَلِ القَصيرِ",0,"ر",1,0],["هذا أَواني أَسَدَ بن جابِر","بِنَبعَةٍ وأَسهُمٍ طَوائِر",1,"ر",1,0],["هذا أوانُ ثِمارِ لَه","وِكَ فَاجْنِ بالكاسِ الثِّمارا",2,"ر",2,1],["هَذا أَوانُ فَضيحَتي لَبَّيكَ يا","داعي الهَوى لا عِطرَ بَعدَ عَروسِ",3,"س",1,1],["هَذَا أَوَانُ الْعَدْوِ لاَ الْ","إِبْطَاءِ وَالْمَشْيِ الْوَئِيد",4,"د",1,0],["هذا أوان الشرب والقيانِ","والمجلس الغضّ من الريحانِ",5,"ن",1,0],["هذا أَو فرجات البدوي كم","قَضيت به لمحه أَوطار",6,"ر",1,0],["هذا أوانُ استقبلَتْ رشدَها","بوقفةِ المعتذِر المعتِبِ",7,"ب",1,0],["هذا أوان دلفت من شرف العُلى","فترقَّ في شمَّائها وتوقّلِ",8,"ل",1,0],["هذا أوان القسط والقسطاط في ال","دنيا استمع للصوت فيك رخيما",9,"م",2,0],["هَذا أَوانُ الجِدِ إِذ جَدَّ عُمَر","وَصَرَّحَ اِبنُ مَعمَرٍ لِمَن ذَمَر",10,"ر",1,0],["هَذا أَوان الشدّ فَاِبرز مُقَدماً","حَتّى تَرى مِن فارس الهَيجاء",11,"ا",2,0],["هذا أوانٌ تفيض البيض مسلطة","تسقي العداة نجيعاً وهي تبتسم",12,"م",1,0],["هذا أوان دم راق وفرحة","تولى الشهيد مضاعف الرحمات",13,"ت",1,0],["هذا أوانُ طابَ سلُّ المشرفي","وقودُنا الخيلَ وهزُّ السمهَرِي",14,"ي",1,0],["هذا أَوانُ نجازِ وعدِكَ لي","إنَّ الكريمَ لمُنْجزُ الوعدِ",15,"د",1,0],["هذا أوان الأنس عجل فقد","آوى له الوارد والصادر",16,"ر",1,0],["هذا أوان الأنس يا ورق انشدي","فوق الغصون طرباً ورددي",17,"د",2,1],["هذا او ان النصر","منك لطالب متودد",18,"د",1,0],["هذا أوانكِ يا بغداد فانتفضي","كي يستفيق َعلى أرض الشموخ غدُ",19,"د",1,0],["هذا أوان العفو , فاعف تفضّلا","يا من له تعنو الوجوه وتخشع !!",20,"ع",1,0],["هذا أوانُ الجَدِّ فيهِ مَشَاعِرِي","تنْسَابُ مِنِّي أدْمُعَاً وَسُطُورَا",21,"ر",2,0],["هذا أوانُكِ إذ تبدينَ باهرةً","يا جنحَ طيرٍ مشى هوْناً على هممي",22,"م",2,0],["هذا أوانُكَ كي تريحَ مواجعي","وتزين مثلَ النجمِ ليلاً مظلما",23,"م",2,1],["هذا أوانُ الصبحِ يجلى عن دجىً","فالليلُ طالَ بوارثي الإصحاحِ",24,"ح",1,0],["هذا أوانُك لحظةٌ قدريةٌ","كم تحتويني لحظةُ الأشياءِ",25,"ا",2,0],["هذا أوانُ زِيَارةٍ قُدسيّةٍ","هيّا إلى السَّلوى من الغفّارِ",26,"ر",1,0],["هذا اول الدرب اوهذا الطريق اولك","جيت اتوقا عذابات المدى واهتديك",27,"ك",1,0],["هَذا أَوَانٌ للعُبُوْرِ مُمَهَّدٌ","نَحْوَ المَدَى في رِحْلَةٍ لم تُشْرِقِ",28,"ق",1,0],["هذا أوانُ الشدِّ يا قدسَ الهدى","هل تعذريني ؟ ، فالورى قد خُدِّروا",29,"ر",3,0],["هذا أوانُ الفَرْزِ فارْقُبْ واصطبر","وانْظُرْ إلى كُلِّ العَجائبِ فيهِ",30,"ي",2,0],["هذا أوانُ السَّعْدِ فارْحَلْ يا أسَى","وابْعِدْ فَمالَكَ في القلوبِ مَكانُ",31,"ن",1,0],["هذا أوَانُ إيابِ دَعوةِ شَامِنا","مِنْ بَعْدِ أَسْفَارٍ عَلَى الأوْفَازِ",32,"ز",1,0],["هذا أوانك يا دموعي","فاظهري أين اختبأت؟",33,"ت",1,0]]}