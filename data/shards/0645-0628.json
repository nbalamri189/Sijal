تِيَ في أَثوابِ ظَمياءَ لَيلَةً","بِوادي الغَضا وَالعاذِلونَ هَواجِعُ",0,"ع",1,0],["مُبتَرِكُ الصالي عَلى ال","نارِ لَيالِيَ القِرَر",1,"ر",1,0],["مَباسِمٌ ما أرى تَجْلو لَنا بَرَداً","أمِ استَطارَتْ بُروقٌ بينَ أحْداجِ",2,"ج",1,0],["مُبتَدا الحُسنِ صيغَ مِنها وَمِنها","فُرِّقَ الحُسنُ في جَميعِ العِبادِ",3,"د",1,0],["مُبارَكُ ما قدّمْتُ سُفْيانَ رَغْبَةً","ولا خوْفَ تَقْصيرٍ ولا سوءَ سِيرَهْ",4,"ر",2,1],["مُبَلّغُهُمْ أهْدى رِسالاتِ رَبِّهِ","أمينٌ على الإسلامِ في اللهِ ناصِحُ",5,"ح",1,0],["مُبْتَلىً أَنْتَ بالْبَرابر وَالغُزِّ","وَأَهْلِ الجِبَالِ والْصَّحْرَاءِ",6,"ا",2,0],["مُبَرَّزَةٌ لا يُجعَلُ السَترُ دونَها","إِذا أُخمِدَ النيرانُ لاحَ بَشيرُها",7,"ر",3,0],["مُبتَلَّةِ الخَلقِ مِثلِ المَها","ةِ لَم تَرَ شَمساً وَلا زَمهَريرا",8,"ر",2,0],["مُبَتَّلَةٌ هَيفاءُ رَودٌ شَبابُها","لَها مُقلَتا رِئمٍ وَأَسوَدُ فاحِمُ",9,"م",1,0],["مُبَكِّرٌ تَحسَبُهُ طالِباً","يُسابِقُ الفَجرَ إِلى المَطلَعِ",10,"ع",1,0],["مُبدي الرِضا عَنهُما وَمُنصَرِفٌ","عَن بَعضِ ما لَو فَعَلتُ لَم أُلَمِ",11,"م",1,0],["مُبْتَذِلاً مَا غَلاَ","مِنْ هِمَّةٍ أَو نَشَبْ",12,"ب",1,0],["مُبْتَرِداً بِالمَاءِ فِي نَفْسِهِ","شُغْلٌ عَنِ المَاءِ وَعَنْ بَرْدِهِ",13,"د",2,0],["مَبَاحِثُهُ فِي كُلِّ فَنٍّ طَرَائِفٌ","يُجَمِّلُهَا سَبْكٌ بَدِيعٌ وَتَبْيَانُ",14,"ن",1,0],["مُبَاحٌ مَا تَشَاءُ فَخُذْهُ إِمَّا","بِحَقِّ الرَّأْيِ أَوْ حَقِّ الْحُسَامِ",15,"م",1,0],["مُبيدُ كُلِّ الكَفَرَة","لَيسَ لَهُ مُناضِلُ",16,"ل",1,0],["مُبارِزٌ ما يَرهَبُ","وَضَيغَمٌ ما يُغلَبُ",16,"ب",1,0],["مبتغى كل واحد","منهم الجور أن قدر",17,"ر",1,0],["مبدأ ذو مقاصد ضامنات","ما لأهل الحياة من آمال",18,"ل",1,0],["مَباشيمُ عَن غِبِّ الخَزيرِ كَأَنَّما","تُصَوِّتُ في أَعفاجِهِنَّ الضَفادِعُ",19,"ع",1,0],["مباؤك في البِثَن الناعما","ت عيناً إذا رَوَّحَ المؤصلُ",20,"ل",1,1],["مُبدِياً صَفحَتِي عَلَى المَرقَبِ المُع","لَمِ باللهِ قُوَّتِي واعتِصَامِي",21,"م",2,0],["مُبَشِّرَاً مُنذِرَاً ضياءَ به","أُنكَرَ فينا الدُّوار والنُّصُبُ",22,"ب",1,0],["مَبسُورَةً شَارِفاً مُصَرَّمَةً","مَحلُوبُها الصَّابُ حِينَ تُحتَلَبُ",22,"ب",1,0],["مبارك تارك الهوى سالك ال","قصد عزيز عليه ما عطبوا",23,"ب",3,1],["مُبارَكٌ كَضِياءِ البَدرِ صورَتُهُ","ما قالَ كانَ قَضاءً غَيرُ مَردودِ",24,"د",1,0],["مُبينَ الغَيِّ لا يَعيا عَلَيهِ","وَيَعيا بَعدُ عَن سُبُلِ الرَشادِ",25,"د",1,0],["مباركُ الكعبِ أن يسرّ بهِ ال","شآمُ فقد سرَّ قومه الكعبه",26,"ب",2,0],["مباشرُ والجامع المعمورِ قد منعوا","وافي الحوالةِ عن قصدِي فوا حربا",27,"ب",2,0],["مبقل الوجهِ أدَارَ الطَّلا","فقالَ لي في حبِّها عاتبي",28,"ي",1,1],["مبلبل الصدغ طوع الوصل منعطف","كأنَّ أصداغه للعطفِ واوات",29,"ت",1,0],["مبصر الرَّأي مأخوذٌ بفطنته","إلى المراشد مدلولٌ على النهج",30,"ج",1,0],["مباحثُ علمٍ بلدت كلَّ مفصح","على أنها قد فصَّحت كلَّ أبلد",31,"د",1,0],["مبلبل الأصداغ والطّره","ومرسل اللحظ على فتره",32,"ر",2,1],["مباشروا الجامعِ الذين همُ","صبحي ولكن على المنى مانع",33,"ع",1,0],["مبرأ القلب من ريبٍ ومن دَنسٍ","وكيف وهو بماءِ الخلدِ مغسول",34,"ل",1,0],["مبلبل أصداغٍ أثارت بلابلي","وجرَّت هوى عشَّاقها بالسلاسل",35,"ل",1,1],["مبقل الخدّ قالوا","فقلت ما ذاك يسلي",36,"ي",1,1],["مبخل يشبه ريم الفلا","وأطول شجوي من بخيل كريم",37,"م",1,0],["مباركاً حيث كانَ حامله","عيون غيد فتور إسقامه",38,"م",2,0],["مبيد لو أنَّ المرء ضاعف درعه","ومثله في نفسه لتجدَّلا",39,"ل",2,0],["مبارك الإقبال والإعراض","مستقبل الحال بنابٍ ماض",40,"ض",1,0],["مبلغٌ لم يكن ليَبْلُغَهُ الطا","لِبُ إلّا بِتلكُمُ الأسبابِ",41,"ب",1,0],["مَبَرَّةً لَطُفَتْ منه وتَصفيةً","لَمَوْرد العُرْفِ لم نعرفهما لأَبِ",42,"ب",1,0],["مبارَكُ الطائرِ ميمونُهُ","حدَّثني عن ذاك من جرّبا",43,"ب",2,0],["مباركُ الوجه ميمونٌ نقيبتُهُ","يُوري الزنادَ بكفَّيه إذا قدحا",44,"ح",2,0],["مبارَك في يديه للمالِ إه","لاكٌ وللهالكين إنقاذُ",45,"ذ",1,0],["مبْدَى المناذرةِ الذي","فيه الفواكهُ لا البريرُ",46,"ر",1,0],["مبال لعمري شقُ للبول كاسمه","إذا شق للإرْبين فرج مطهرُ",47,"ر",1,0],["مُبثبِثاً مثلَ عمّه الأعور ال","معورِ أهلِ الإعوارِ والعَور",48,"ر",1,0],["مبخوسةً في الشكر غير باخسه","في العرف تُسْديه ولا مماكسه",49,"س",2,0],["مَبلغاً تُنغِضُ الرؤوس لراجي","هِ وحُقَّت هناك بالإنغاض",50,"ض",1,0],["مبتاعة دفعاً بصفع ألا","قبَّحها الرحمن مبتاعه",51,"ع",2,0],["مبتذلاً أنفَسي وممتهناً","نفسي فيما هويت من مَهنِك",52,"ك",1,0],["مباركٌ لا تمُجُّ العينُ طلعتَه","ولا يرى الرائي في مخبوره فشلا",53,"ل",2,0],["مُبدلٌ لام كل لفظٍ بياء","مبدلٌ قاف كل لفظٍ بعين",54,"ن",1,0],["مُبِنَّةُ غارٍ أَينَما التَجَّ شَمسُهُ","بِحالٍ فَقَرنُ الشاةِ فيهِ ظَليلُ",55,"ل",1,0],["مُبَتَّلَةٌ كَأَنَّ أَنضاءَ حَليِها","عَلى شادِنٍ مِن صاحَةٍ مُتَرَبَّبِ",56,"ب",1,0],["مَبيتي عَلى مِثلِ الوَثيرِ لَيانَةً","وَأَحسَبُني فَوقَ الأَسِنَّة وَالمَدى",57,"د",2,0],["مباركة أهَّلتُها لمصر","وللكرسيّ والنجل الفخيم",58,"م",1,0],["مباركا لأبيه","وآله أجمعينا",59,"ن",2,0],["مبدعا في الكيد والدل معا","لست أشكوك إلى من أبدعك",60,"ك",1,0],["مبين فيه ما يأتي","وما ينوى ويعزمه",61,"م",2,0],["مبداى كان شرم برم","واليوم صار ترللي",62,"ي",1,0],["مبدؤه لا مبدأ","مشربه لا مشرب",63,"ب",1,0],["مُبتَهِجاً يُفَكِّرُ في وَليمَه","وَفي فَريسَةٍ لَها كَريمَه",64,"ه",1,0],["مُبارَكاً في يَومِهِ","وَالأَمسِ مَيموناً غَدا",65,"د",2,0],["مُبارَكُ الاِسمِ أَغَرُّ اللَقَب","كَريمُ الجِرِشّى شَريفُ النَسَب",66,"ب",1,0],["مُبَرقِعي خَيلِهِم بِالبيضِ مُتَّخِذي","هامِ الكُماةِ عَلى أَرماحِهِم عَذَبا",67,"ب",2,0],["مَبيتي مِن دِمَشقَ عَلى فِراشِ","حَشاهُ لي بِحَرِّ حَشايَ حاشِ",68,"ش",1,1],["مُباشِراً بِنَفسِهِ شُؤونَهُ","مُشَرِّفاً بِطَعنِهِ طَعينَهُ",69,"ن",2,0],["مُبتَسِمٌ وَالوُجوهُ عابِسَةٌ","سِلمُ العِدى عِندَهُ كَهَيجاها",70,"ا",3,0],["مُبارَكَةً شَدَّت قُوى السِلمِ بَعدَما","تَوالَت خُطوبُ الحَربِ مُقبِلَةً تَترى",71,"ر",2,0],["مُبدِئُ الفِعلِ إِن تَبايَنَتِ الأَف","عالُ بانَ اِقتِرابُهُ وَاِغتِرابُه",72,"ب",2,0],["مُبارَكُ الصُحبَةِ يُرضيكَ في","رَأيٍ لِضيقِ الأَمرِ فَرّاجِ",73,"ج",1,0],["مُباشِرٌ لِصِغارِ الأَمرِ لا سَلِسٌ","سَهلٌ وَلا عَسِرُ التَنفيذِ مُنعَقِدُ",74,"د",1,0],["مَباكٍ تَستَزيدَ الدَمعَ فيها","وَما لِلدَمعِ فيها مِن مَزيدِ",75,"د",1,0],["مُبتَدي سُؤدُدٍ وَشانوهُ أَتبا","عٌ وَمَولىً وَالكاشِحونَ عَبيدُه",76,"د",2,0],["مُبتَغي غايَةٍ مِنَ الجودِ ما يَب","لُغُهُ دونَ مُبتَغاها عَذولُ",77,"ل",1,0],["مبدية للصبا مغاضبه","فكلما هبت الصبا اختصما",78,"م