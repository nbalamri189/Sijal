{"poems":[[55,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[94,"بذر الحب بذره","https://www.aldiwan.net/poem38930.html","مجزوء الخفيف"],[87,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[119,"لذ بباب الغوث الجليل الرفاعي","https://www.aldiwan.net/poem41778.html","الخفيف"],[505,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[572,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110258","الخفيف"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101236","الخفيف"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105533","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91024","الرمل"],[5389,"هارون الأمة","https://www.poetsgate.com/ViewPoem.aspx?id=206085",""],[572,"كِلي إلى اللّومِ غيري رَبّة َ الكِلّهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9439&r=&rc=296",""]],"verses":[["مُرَشِّحاً لِلجِيادِ يُطلِعُها","عَلى العِدى ضُمَّراً سَراحيبا",0,"ب",2,0],["مَرْشَفاهُ بِخَدِّه","ودِمائي تخلَّقا",1,"ق",2,0],["مرشان في النيل التقى","من بعد ما عز اللقا",2,"ق",2,0],["مرشان فيها قد ثبت","كأنه عود نبت",2,"ت",1,0],["مرشد جاب عن مرايا قلوب السا","لكين العمى بغير نزاع",3,"ع",1,0],["مرَّ شيخُ العَرْجاءِ بالكأْسِ نَحوي","وحَباني بشُرْبِ كأْسٍ دِهَاقِ",4,"ق",1,0],["مُرَشَّحٌ لِلَّتِي لاض يَسْتَقِلُّ بِهَا","إِلاَّ الَّذِي عَرَفَتْ أَعْدَاؤُهُ فَضْلَهْ",5,"ل",2,0],["مر شهر ولم تزرنا وكانت","كل يوم تغشى ولا نغشاها",6,"ا",3,0],["مرشد الخاضعين من لمعاليه","لوت هامها الملوك خضوعا",7,"ع",2,0],["مُرشِدُنَا مِن فَضلِهِ وَجُودِهِ","بِصُنعِهِ المُعرِبِ عَن وُجُودِهِ",8,"ه",1,0],["مرشد بالخطاب كل قريبٍ","وبعيدٍ إلى الذي هو أسلم",9,"م",1,0],["مرشد جمعا وفرقا راشد","سالك للَه باللَه اقترب",10,"ب",1,0],["مرشح واحد من الامة ميصير","بس يصير اذا سابق فضلهه",11,"ل",3,0],["مرشّحٌ للّتي لا يستَقِلُّ بها","إلاَّ الذي عَرِفَتْ أعداؤهُ فَضْلَهْ",12,"ل",2,0]]}