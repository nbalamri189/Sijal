{"poems":[[73,"لا تعرضن لضيق المقل","https://www.aldiwan.net/poem4018.html","أحذ الكامل"],[74,"بعثت طيفها إلينا رسولا","https://www.aldiwan.net/poem20542.html","الخفيف"],[82,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[50,"أيها المنتاب عن عفره","https://www.aldiwan.net/poem63366.html","المديد"],[108,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[52,"يا ليت لي قلباً بقلب يثيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=19929",""],[246,"يا أخت غصن البانة المياس","https://www.aldiwan.net/poem45768.html","الكامل"],[309,"الله جل الله عن التكييف","https://www.aldiwan.net/poem16800.html","الكامل"],[358,"ما ترى البدر حين حاز كماله","https://www.aldiwan.net/poem40002.html","الخفيف"],[443,"إن داراً بين اللوى والعفيق","https://www.aldiwan.net/poem2547.html","الخفيف"],[519,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[580,"بعثت لي على فم الطيف قبله","https://www.aldiwan.net/poem3037.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120069","الكامل"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102231","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79962","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48246","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53165","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93519","الكامل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101595","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132587","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135243","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54469","السريع"]],"verses":[["مَلِكٌ قَصَرتُ عَلى مَدائِحِهِ","شِعري وَعِندَ نَوالِهِ أَمَلي",0,"ل",2,0],["ملك قد زهى به مربع المل","ك فحيَّى فرعه والأصولا",1,"ل",2,0],["مَلِكٌ قد علا مَصَامَ الثريّا","ليس فوق الثرى لهُ من مُسامِ",2,"م",1,0],["مَلِكٌ قَلَّ الشَبيهُ لَهُ","لَم تَقَع عَينٌ عَلى خِطَرِه",3,"ر",2,0],["مَلِك قد اقترن السرورُ بعهده","فكأنما كانا على ميعاد",4,"د",1,0],["ملكُ قلبي لا يملُّ الهوى","يَاطُولَ إِغْرامي بمنْ لاَ يُجيبْ",5,"ب",1,0],["مِلكق تودُّ النيراتُ لو انها","تحكيه في بِشرٍ وفي إِيناسِ",6,"س",1,0],["ملك قدير واحد متقدس","عن قول أهل الزيغ والتزييف",7,"ف",1,0],["مَلك قَد سَما بِدَولة حُسنٍ","أَبّد اللَه عَدله وَاِعتِداله",8,"ل",2,0],["ملك قدره سما السبعة الشه","ب بعزم علا على العيوق",9,"ق",1,0],["ملكٌ قد شرُفَ المُلكُ به","واِزدهى المنصِبُ والمجدُ تَناهى",10,"ا",3,0],["مَلِكٌ قبل خَلْقِه وَرث المُلْ","كَ كما حازَ وحْدَه الفضلَ كُلَّه",11,"ل",2,0],["ملك قد انشرحت صدور الخلق من","أفعاله والقسط والآلاء",12,"ا",2,0],["ملك قلائد جوده","جوالة بالطريف وبالتليدِ",13,"د",1,0],["ملكٌ قد انفردت مآثرُه بما","عظُمت به في المغربِ الآثارُ",14,"ر",1,0],["ملكٌ قد تقلد الأمر والنهى","ببأسٍ على العدوِّ أشدّ",15,"د",1,0],["ملكٌ قادرٌ قويٌّ عزيزٌ","نافذُ الأمرِ واهبُ الغُفرانِ",16,"ن",1,0],["ملْكٌ قد سما بمركزِ عَلْيا","هُ فأوْلَى العفاَةَ سامي الرِّكازِ",17,"ز",1,0],["ملك قضى ما بين ملتف القنا","والشرك قد ملأ البلاد زلازلا",18,"ل",2,0],["ملك قَد اتخذ العَطاء فَريضة","فَبهمه أَن يَعجلن أَداءها",19,"ا",3,0],["ملكٌ قبّة السماء له قص","رٌ وقلب الأثير مسرح حكمه",20,"م",2,0],["ملك قد حوى ممالك حمد","فغدا يوم حمده مشهودا",21,"د",2,0],["ملِكٌ قُدّوسٌ عَلِيٌ غَني","قدِّسَنَّا من عيبنا يا حكيم",22,"م",1,0],["مَلْكٌ قَضَى اللّهُ له أَنّه","على ملوكِ الأَرضِ يستعلي",23,"ل",2,0]]}