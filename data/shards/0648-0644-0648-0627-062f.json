{"poems":[[4,"بكتنا أرضنا لما ظعنا","https://www.aldiwan.net/poem21201.html","الوافر"],[48,"الله أكبر ما اشتريت بضاعة","https://www.aldiwan.net/poem22414.html","الكامل"],[19,"لعمرك ما آسى طفيل بن مالك","https://www.aldiwan.net/poem350.html",""],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[48,"اللَّه أكبرُ! ما اشتريتُ بِضاعةً،","https://www.poetsgate.com/ViewPoem.aspx?id=18377",""],[4,"بَكَتْنَا أرْضُنَا لمَا ظَعَنّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10951&r=&rc=46",""],[146,"هو منزل النجوى بخالي الأعصر","https://www.aldiwan.net/poem58442.html","الكامل"],[254,"وأفلت حاجب فوت العوالي","https://www.aldiwan.net/poem2086.html","الوافر"],[266,"يعاودني لذكراك الحنين","https://www.aldiwan.net/poem38166.html","الوافر"],[422,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[438,"يروع الذئب حيث سواك راع","https://www.aldiwan.net/poem12377.html","الوافر"],[556,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122533","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48852","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70850","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102074","المتقارب"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110612","الرمل"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21609","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202729","الوافر"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29462","المتقارب"],[4929,"قراءة دخانية","https://www.poetsgate.com/ViewPoem.aspx?id=207715",""],[5005,"بارقة الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=208142",""],[5353,"مخاض من الغيظ","https://www.poetsgate.com/ViewPoem.aspx?id=214898",""],[5790,"من مبلغ عني المليك الأروعا","https://www.poetsgate.com/ViewPoem.aspx?id=111886",""],[6093,"حُوارٌ مَعَ نَاقِدٍ ( الهَزَج )","https://www.poetsgate.com/ViewPoem.aspx?id=187204",""]],"verses":[["وَلَو أَدرَكنَ حَيَّ بَني جَرِيٍّ","وَتَيمَ اللاتِ نُفِّرَتِ البِهامُ",0,"م",1,0],["وَلَو اِدَّعى ظَبيُّ الفَلاةِ وَلائَهُ","لَعَداهُ مِن قُنّاصِهِ الإيسادُ",1,"د",1,0],["وَلَو أَدرَكَتهُ الخَيلُ شالَ بِرِجلِهِ","كَما شالَ يَومَ الخالِ كَعبُ بنُ أَصمَعِ",2,"ع",1,0],["وَلَو أَدماكَ غَيرُ اللَّهِ أَجرَوا","دَماً في سيلِهِ تَكبو السبوحُ",3,"ح",1,0],["ولو ادّعى ظبيُ الفلاةِ ولاءَه،","لعَداه، من قُنّاصِه، الإيساد",4,"د",1,0],["ولو أدْرَكْنَ حيَّ بني جَرِيٍّ","وتيمَ الللاتِ نفِّرَتِ البِهَامُ",5,"م",1,0],["ولو ادخرتُ المالَ أو أبقيتُه","يوما أثبتُ بأبيضٍ وبأصفرِ",6,"ر",1,0],["وَلَو أَدرَكنَ رَأسَ بَني تَميمٍ","عَفَرنَ الوَجهَ مِنهُ بِالتُرابِ",7,"ب",1,0],["ولو أدنى المنون هواك مني","تعذر ان برى شخصي المنون",8,"ن",1,0],["ولو أدركت بالأمم المواضي","لأمست وهي كافرة تدين",8,"ن",1,0],["ولو أدَّى إليك حديث وجدي","عرفت إليك منِّي ما يؤدَّى",9,"د",2,0],["ولو أَدركْتَ تُبَّعَ مالَ فخراً","إِلى التَّقديمَ عندَكَ باتِّباعِ",10,"ع",1,0],["ولوادٍ حَلَلْتَ فيه جَديبٌ","بك نائي الإخصابِ والإمراعِ",11,"ع",1,0],["ولو أدَّيتُ حَقَّكِ ما حَلا لِي","لِفُرقتِكِ الطعامُ وال الشراب",12,"ب",1,0],["ولو أدركتها عصبة الأمم اتقت","بها عَوْدَ غليوم وأمثالَ غليوم",13,"م",1,0],["ولو أدرى أن العشق تنغيصُ لذةِ","المعاشِ لصُمتُ الدهرَ منى تطوُّعا",14,"ع",2,0],["ولو أدنو لمحة مع ربي","لشرب المدام ولثم سعاد",15,"د",1,0],["ولوادي المنحني قد يمما","لم يزل بالمنحنى من أضلعي",16,"ي",1,0],["وَلَو أُدخِلتَ في حَمّامِ فيلٍ","وَأُلبِستَ المَطارِفَ وَالبُرودا",17,"د",2,0],["ولو أدعو لحب سواك قلبي","فثقْ من أن قلبي لا يجيب",18,"ب",1,0],["وَلَو أَدرَكَتهُم أَمَرَّت لَهُم","من الشَّرِ يَوماً مُمَرّاً مُغَارَا",19,"ر",2,0],["ولو أدركتْ في البَرِّ ناقةَ صالحٍ","لباتَتْ لها بالقنصِ صَيداً مُيَسَّرَا",20,"ر",2,0],["ولو أدْلجتُ يوماً في هدوئي","تَسلَّل في رُؤى قلبي العجلْ",21,"ل",1,0],["ولو آدَ بي حزنيَ المستباح ْ","تهيَّبتُ وجدَكَ شتّا وَلَمْ",22,"م",1,0],["ولو ادعيت بأن مالك ناصحٌ","مثلي شهدت بصدق هذا المدعى",23,"ع",2,0],["وَلوْ أَدْرَكْتَ مَا أَدْرَكْ","تُ لَمْ تَظْلِمْ وَ لَمْ أُظْلَمْ",24,"م",1,0]]}