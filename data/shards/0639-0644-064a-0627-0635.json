{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39608","المتقارب"],[342,"رأيت وقد أتى نجران دوني","https://www.aldiwan.net/poem45430.html","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38177","المتقارب"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118103","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52043","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118422","الوافر"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123643","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90853","الوافر"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130599","الوافر"],[5431,"فلسفة الحياة ....","https://www.poetsgate.com/ViewPoem.aspx?id=199987",""],[5595,"عليٌّ أصلهُ نسبُ النبيِّ","https://www.poetsgate.com/ViewPoem.aspx?id=144759",""]],"verses":[["على إصبعيْ قدَمٍ أُلهِمَتْ","هبوبَ الصَّبا ووثوبَ الغزَالْ",0,"ل",1,0],["عَلى أَصلابِ جَأبٍ أَخدَرِيٍّ","مِنَ اللائي تَضَمَّنَهُنَّ إيرُ",1,"ر",1,0],["عَلى أَصهَبٍ يَسبقُ الرّيحَ جرياً","وَفي لَمْحِ طرفِيَ كَالطّيرِ طارا",2,"ر",2,0],["على اصطخاب المثاني كان سفكهم","دماءَ ها بين عيدانٍ وأوتار",3,"ر",1,0],["على أصلهَا جاءتْ سَقَتْ كلُّ رَحمَةٍ","ترى أصْلها المَبرُور في جَنَّةِ الخُلدِ",4,"د",1,0],["على أصحابه من بعده ما","تعاقبت العشايا والغدايا",5,"ا",3,0],["على اصفخان وجدي لا يفارقني","أو تبلغ الروح مني منتهى الأجل",6,"ل",1,0],["على أصواتهم حمر المنايا","رواقص حيث لا لحن وحان",7,"ن",1,0],["على أصناف خلق الل","ه في بحر وفي بر",8,"ر",1,0],["علّي أصادقه أو شئتُ أتبعه","ونسكبُ الحبّ مشتاقا لمشتاقِ",9,"ق",1,0],["عليٌّ أصلهُ نسبُ النبيِّ","كريمٌ طيّبٌ خيرُ الرجالِ",10,"ل",1,0]]}