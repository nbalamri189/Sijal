,[53,"خُطُوبٌ لا يُقَاوِمُهَا البَقَاءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9811&r=&rc=8",""],[33,"بِيَ الْيَوْمَ مَا بِي مِنْ هيَام أصَابَنِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14183&r=&rc=117",""]],"verses":[["أَمرٌ بِقَبرٍ قَد طَواكَ صَعيدُهُ","فَأَبلَسُ حَتّى ما أَكادُ أُبينُ",0,"ن",1,0],["أَمُرُّ بِالرَكبِ مُجتازاً بِذي سَلَمٍ","لَو ما شَرَيتُكَ بِالأَوطانِ أَوطانا",1,"ن",2,0],["أَمُرخي ذُؤابَةِ ذاكَ الهَجيرِ","عَلى مَكِبَي مَجهَلٍ أَو عَلَم",2,"م",1,0],["أَمرُ الخِلافَةِ في يَدَيكَ وَإِنَّما","هِيَ عُقبَةٌ تُقضى بِكُلِّ هُمامِ",3,"م",1,0],["آمِراً تَخدُمُكَ الأَي","يامُ طَوعاً وَالأَنامُ",4,"م",1,0],["أَمُرُّ عَلى لُهى الأَضدادِ طَعماً","وَأَنفُذُ في طُلى الأَعداءِ نَبلا",5,"ل",2,0],["أَمُريدَ زائِدَةِ الأَنامِ أَقِم","هَيهاتَ مِنكَ الشَدُّ وَالعَجَلُ",6,"ل",1,0],["أَمُرَشِّحي لِلعَزمِ غَيرَ مُرَشَّحٍ","وَاليَومُ مِن لَيلِ العَجاجَةِ أَبلَقُ",7,"ق",1,0],["أَمرَ لِجامِ القَدَرِ القَرّاصِ","ماشاءَ مِن حُكمٍ فَلا مَناصِ",8,"ص",1,0],["أَمُرُّ بِدارٍ مِنكِ مَشجوجَةِ الثَرى","بِمَجرى نَسيمِ الآنِساتِ الغَرائِرِ",9,"ر",1,0],["أَمرَعَت أَرضُنا بِكُلِّ مَكانٍ","وَاِستَجابَت لَنا بُروقُ الغَوادي",10,"د",2,0],["أَمُرُّ بِدارِهِ فَأُطيلُ شَوقاً","وَيَمنَعُني مِنَ النَذَرِ البُكاءُ",11,"ا",2,0],["أَمُرُّ بِحُزوى مُطرِقاً خيفَةَ العِدا","وَإِن أَرَ مِنهُم غَفلَةً أَتَلَفَّتِ",12,"ت",1,0],["أُمِرتُ بِكِتمانِ الَّذي لَو أَشَعتُهُ","فَأَظهَرتُهُ لَم يَعلَمِ الناسُ مَن أَعني",13,"ي",1,1],["أَمُرُّ عَلى مَنازِلَ أَنتِ فيها","فَأَصرِفُ عَنكِ طَرفاً غَيرَ قالِ",14,"ل",1,0],["أمَرْتَني بسُلوٍّ عنْكَ مُمْتَنِعٍ","مأمورُ حُسْنِك لمّا يقْضِ ما أمَرَهْ",15,"ه",1,0],["أمَرَ العُلى ونَهَي فقالَتْ طاعَةً","ما شاءَ شِئْتُ وما أباهُ أبَيْتُهُ",16,"ت",2,0],["أَمُريهِم ما يَشتَهونَ وَفاعِلٌ","مِن ذاكَ ما يُثنى وَما يُستَقبَحُ",17,"ح",1,0],["أَمَرَ التَقليدُ فيها وَنَهى","بِجُيوشٍ مِن ظَلامِ الحُجُبِ",18,"ب",1,0],["أَمَرخٌ خِيامُهُمُ أَم عُشَر","أَمِ القَلبُ في إِثرِهِم مُنحَدِر",19,"ر",1,0],["أمر من يطلب الخلود عسير","لا يعار الخلود من يستعير",20,"ر",1,1],["أَمْرٌ يَضِيقُ بِهِ الذَرْعُ انْتَدَبْتَ لَهُ","وَأَنْتَ إِنْ ضَاقَ ذَرْعٌ خَيْرُ مُنْتَدِبِ",21,"ب",1,0],["أَمْرٌ عَظِيمٌ أَنْ يَجُودَ امْرُوءٌ","وَسِرُّهُ مِصْدَاق مَا أَعْلَنَهْ",22,"ن",2,0],["آمِرَاتُ العُيُونِ تَأْمُرُنَا","وَنَوَاهِي الخُصُورِ تَنْهَانَا",23,"ن",2,0],["أَمْرُهَا فِي يَدِ الرَّشِيدِ هُدىً","وَابْنِ عَبْدِ العَزِيزِ إِحْسَانَا",23,"ن",2,0],["أَمْرُكَ الأَمْرُ يَا مَلِيكِي","وَلَكِنْ رَفَعْتَ مَنْ",24,"ن",1,0],["أَمْرُ المَوَدَّةِ مَسْمُوعٌ فَكَيْفَ بِهِ","عَلَى الطَّهَارَةِ مِنْ رِجْسٍ وَمِنْ دَرَنِ",25,"ن",1,0],["أَمْرُ الأَمِيرِ لَمَّا أحب دَعَانِي","سَبَبَانِ لِلإِقْبَالِ وَالإِذْعَانِ",26,"ن",1,1],["أَمَرْتَنِي وَبِهَذَا الأَمْرِ تُسْعِدُنِي","عِبْيءِ ثَقِيلٌ وَلَكِنْ لَيْسَ يُقْعِدُنِي",27,"ن",2,1],["أَمْرُكُمْ أَحْكِمُوه وَاللهُ هَادِ","لا تُطِيعُوا مَشُورَةَ الأَحْقَادِ",28,"د",1,0],["أَمرَقتُ مِن جَوزِهِ أَعناقَ ناجِيَةٍ","وَاللَيلُ مُختَلِطٌ بِالأَرضِ دَيمومُ",29,"م",1,0],["أَمرَقتُ مِن جَوزِهِ أَعناقَ ناجِيَةٍ","تَنجو إِذا قالَ حاديها لَها هيجي",30,"ج",2,0],["أمُرّ فتنظر الأبصار شَزراً","إليّ كأنما قد مرّ ذيب",31,"ب",1,0],["أمريم مهلاً بعضَ ما تذكرينه","فإنك ترمين الفؤاد بأسهم",32,"م",1,0],["أمريم أن اللّه لا شك ناقمٌ","من القوم في قتل النفوس المحرَّم",32,"م",1,0],["أمريم فيما تحكمين تبصَّري","فإن أنت أدركتِ الحقيقة فاحكمي",32,"م",2,0],["أَمرَعَت في نَداهُ إِذ قَحَطَ القَط","رُ فَأَمسى جَمادُها مَمطورا",33,"ر",2,1],["أمرعت في نداه إذ قَحَط","القطر فأمسى جَهادُها ممطورا",34,"ر",2,1],["أَمَرتُ بِقَصِّهِ وَكَفَفتُ عَنهُ","وَقَرَّ عَلى تَحَمُّلِهِ قَراري",35,"ر",2,0],["أَمَرتَ وَأَنتَ المُطاعُ الكَريمُ","بِبَذلِ الأَمانِ وَرَدِّ السَلَب",36,"ب",1,0],["أَمَرَّ عَلَيهِمُ خَوفاً وَأَمناً","أَذاقَهُمُ بِهِ أَرياً وَصابا",37,"ب",2,0],["أمرت لحظك أن يسطو على كبدي","يا صدقَ من قال إن السيف مأمور",38,"ر",1,0],["أمرَتني الأشجان أمر الندى لاب","ن عليّ فقلت سمعاً وطاعه",39,"ع",2,0],["أمرّ بالرّبع والأجفان تنشده","بليت يا ربع حتى كدت أبكيكا",40,"ك",2,0],["أمر الله أن تسود ويزهى","حينك المجتلى على كلّ حين",41,"ن",1,0],["أمَّرت شعري على الأشعار قاطبةً","حتى اتخذت لشعري فيك ديوانا",42,"ن",2,0],["أمّرت في الأشعار شعرك حاكماً","متصرِّفاً في أمرها ديوانه",43,"ن",2,0],["أمَّرت شعريَ يا خير الملوك على","أشعار قومٍ فلي أمرٌ وديوان",44,"ن",1,0],["أمر الوحي ان يحث خطاه","في الدجى للمدينة الزهراء",45,"ا",2,0],["أمرَّ حبلي صَناعُ الكفِّ ماهرُها","فما لمرَّة ذاك الحبل مُنتكَثُ",46,"ث",1,0],["أمَرْتُ به رمحاً غيُوراً فخاضهُ","ذَليقاً كما شَكَّ النَّقيلة مِسْرَدُ",47,"د",1,0],["أم رمت شَيْني بأن تعرضني","لثلبه فالسَّليم من قصدَهْ",48,"د",2,0],["أمر أبي حفْصٍ إلى خالد","يا لك من قرْدٍ وقَرَّادِ",49,"د",1,0],["أمرضت قلبي ثم ما عدته","كلاً ولا داويت أوجاعَهْ",50,"ع",2,0],["أمري وأمركم بازٌ على علم","مُرَمَّقٌ بعيون الناس مُشتَرف",51,"ف",1,0],["أمرضني عسري وقد خلتني","عند مداواتك إفراقي",52,"ق",2,0],["أمرضتني إمراضَ أجفانك الوُطْ","فِ بألحاظك الحِدادِ البواكي",53,"ك",2,0],["أُمِرُّ وأُحْلِي منطقي في عتابكم","وكلُّ عتابٍ ذو سَجاح وذو كَحلِ",54,"ل",1,0],["أَمُرْضِعَتي أسترضِعُ الغيثَ دَرَّةً","لرَمْسِكِ بل أستغزِرُ الدمعَ ما سجمْ",55,"م",1,0],["أمُرتَجِعٌ في كل يوم صنيعةً","تجنَّى على مولاك فيها الجرائما",56,"م",2,1],["أمرتْ قدَّها يقودُ إليها ال","قلْبَ مني فقاده بزمام",57,"م",1,0],["أَمرَرتَ بِالأَعشابِ في تِلكَ الرُبى","وَذَكَرتَ أَنَّكَ كُنتَ في الأَعشابِ",58,"ب",1,0],["أَمَرتُ فُؤادي أَن يُطيعَ فُؤادَها","فَيَبكي كَما تَبكي وَتَشدو كَما تَشدو",59,"د",2,0],["أَم رَأى مَصرَعَ القَمَر","فَتَوارى",60,"ا",1,0],["أَمري لَكُم أَصدَرتُهُ فَخُذوا بِهِ","وَحَذارِ ثُمَّ حَذارِ مِن عِصياني",61,"ن",2,0],["أَمَرَ السُلطانُ بِالشاعِرِ يَوماً فَأَتاهُ","في كِساءٍ حائِلِ الصُبغَةِ واهٍ جنِباهُ",62,"ه",1,1],["أَمَرَجتَ أَنتَ مِياهَهُ أَصَبَغتَ أَن","تَ رِمالَهُ أَجَبَلتَ أَنتَ صُخورَهُ",62,"ه",1,0],["أَمَرَت جُفونُكَ بِالهَوى","مَن كانَ يَعرِفُهُ وَمَن لا",63,"ل",2,0],["أَمراً رَضيتَ لَهُ ثُمَّ اِعتَمَدتَ لَهُ","وَاِعلَم بِأَنَّ أَمينَ اللَهِ مُعتَمَدُ",64,"د",1,0],["أَمُرُّ وَأَحلَولي وَتَعلَمُ أُسرَتي","عَنائي إِذا جَمرٌ لِجَمرٍ تَوَقَّدا",65,"د",2,0],["امروا بالصبر الجميل ومن اين","لدامي الفؤاد صبر جميل",66,"ل",1,0],["أمر قضاه الإله","والناس فيه حيارى",67,"ر",2,0],["أمرى وأمرك في الهوى بيد الهوى","لو أنه بيدى فككت إسارى",68,"ر",2,0],["أَمرٌ لَهُ كِلاهُما قَد شَمَّرا","وَجَرّدا السَيفَ لَهُ بَأَخمرا",69,"ر",2,0],["أَمَرَ اللَهُ بِالحَقيقَةِ وَالحِك","مَةِ فَاِلتَفَّتا عَلى صَولَجانِه",70,"ن",2,0],["إِمرَةُ الناسِ هِمَّةٌ لا تَأَنّى","لِجَبانٍ وَلا تَسَنّى لِجِبسِ",71,"س",1,0],["أَمرُ الرِجالِ إِلَيهِ لا إِلى نَفَرٍ","مِن بَينِكُم سَبَقَ الأَنباءَ وَالكُتُبا",72,"ب",2,0],["أَمرٌ عَلَيكُم أَو لَكُم في غَدٍ","ما ساءَ أَو ما سَرَّ مِن غَبِّهِ",73,"ب",2,0],["أَمَرَ الفُؤادُ لِسانَهُ وَجُفونَهُ","فَكَتَمنَهُ وَكَفى بِجِسمِكَ مُخبِرا",74,"ر",2,0],["أَمُريدَ مِثلِ مُحَمَّدٍ في عَصرِنا","لا تَبلُنا بِطِلابِ ما لا يُلحَقُ",75,"ق",1,0],["أَمَرتَ بِأَن تُشالَ فَفارَقَتنا","وَما أَلِمَت لِحادِثَةِ الفِراقِ",76,"ق",1,0],["أمرى إليّ فإن سمحتُ بمهجَةٍ","كرُمَت عليّ فإنّ مثلي مَن سمَحْ",77,"ح",1,0],["أُمْرُرْ على الروضةِ الغنَّاءِ مرتكِضَاً","منها على الطِيب من رَوْحٍ وريحانِ",78,"ن",1,0],["أمرِي طريفٌ وقِصَّتِي عَجبٌ","طَنَّ بأمرِي وقِصَّتي البلدُ",79,"د",1,0],["أَمرُّ بذاك الرَّبْعِ ولهَى رياحُهُ","معطلةً أعلامُه والمعاهدُ",80,"د",1,0],["أمرَّ لهم عقدَ المكيدةِ حازمٌ","بصيرُ بأدواءِ الخُطوب طبيبُ",81,"ب",1,0],["أَمَردودٌ لَنا زَمَنُ الكَثيبِ","وَغُرَّةُ ذَلِكَ الرَشَإِ الرَبيبِ",82,"ب",1,1],["أَمُرتَجَعٌ مِنّي حِباءُ خَلائِفٍ","تَوَلَّيتُ تَسيِيرَ المَديحِ لَهُم وَحدي",83,"ي",1,1],["أَمَرَ العَطاءَ فَفاضَ مِن جَمّاتِهِ","وَنَهى الصَفيحَ فَقَرَّ في أَغمادِهِ",84,"د",2,0],["إِمرَةٌ إِثرَ كِتبَةٍ قَد تَوالَت","نِعَمُ اللَهِ فيهِما بِالمَزيدِ",85,"د",1,0],["آمِري بِالسُلُوِّ لَم يَدرِ أَنّي","بِسَبيلٍ مِنَ الهَوى ما أَحورُه",86,"ر",2,0],["أَمَرتَ بِأَن أُقيمَ عَلى اِنتِظارٍ","لِرايِكَ إِنَّهُ الرَأيُ الأَصيلُ",87,"ل",1,0],["آمِري بِاِبتِذالِ عِرضي وَعِرضي","رُقعَةٌ مُستَعارَةٌ مِن أَديمي",88,"م",2,0],["أَمرٌ تَوَلّى حَمدُهُ وَثَناؤُهُ","وَأَبَذَّ قَوماً ذَمُّهُ وَأَثامُهُ",89,"م",2,0],["أُمرُر عَلى حَلَبٍ ذاتِ البَساتينِ","وَالمَنظَرِ السَهلِ وَالعَيشِ الأَفانينِ",90,"ن",1,1],["أَمَرَّ لَهُم حَبلاً فَلَمّا اِرتَقوا بِهِ","أَتى دونَهُ مِنهُم بِدَرءٍ وَمَنكَبِ",91,"ب",1,0],["أَمَرَ الأَميرُ بِحاجَتي وَقَضائِها","وَأَبو عُبَيدَةَ عِندَنا مَذمومُ",92,"م",1,1],["أَمَروا زَبينَةَ إِذ أَنَختُ إِلَيهِمُ","بِالباقِياتِ وَبِالَّتي هِيَ أَكرَمُ",93,"م",1,0],["أَمرُّ بأفقِ البدرِ وهو مُغَيَّبٌ","أسائِلُ عنه كاسفَ البالِ أقتَما",94,"م",2,0],["أَمُرُّ عَلى رَمسِ القَريبِ كَأَنَّما","أَمُرُّ عَلى رَمسِ اِمرِئٍ ماتَ صاحِبُه",95,"ب",2,0],["أَمَرَ اللَهُ أَن يُطيعَكَ لُبّي","حينَ وَلاّكَ أَمرَ جِسمي وَقَلبي",96,"ب",2,1],["أَم رَوضِ رَشمَلَ أَعدى عِطرُ نَفحَتِهِ","طَيَّ النَسيمِ بِنَشرٍ فيهِ مَنشورِ",97,"ر",1,0],["أمرتنا فعصينا أمرها","وأبينا الذل أن يغشى الجباه",98,"ه",1,0],["أمرُّ بأبوابِ القصور وأغتدي","لمن بانَ عنها في الضمير مناجيا",99,"ي",2,0],["أمِراةٌ أم غديرٌ دائمٌ","مقشعرّ الجلدِ بالقَرّ شَبِمْ",100,"م",1,0],["إِمراتُهُ نَفَذَت عَلَيهِ أُمورُها","حَتّى ظَنَنّا أَنَّهُ إِمراتُها",101,"ت",3,0],["إِمرَأَةُ مُقرانَ ماتَت بَعدَ ما شابا","فَحَسَّتِ السَلَعَ الفِتيانُ وَالصابا",102,"ب",2,1],["أَمرايَ مِن خَيرٍ وَشَرٍّ فَاِعلَمي","طَوقانَ في عُنُقِ القَضاءِ الغالِبِ",103,"ب",1,0],["أَمَرَ التَجَلُّدَ بِالتَلَذُّذِ حُرقَةٌ","أَمَرَت جُمودَ دُموعِهِ بِسُجومِ",104,"م",1,0],["أمرُنا فيها عجيبٌ","نسألُ اللهَ السلامَهْ",105,"ه",1,0],["أمررْتُ كفاً سبَّحتْ فيها الحصى","وروَّتِ الركبَ بماءٍ طاهرِ",106,"ر",1,1],["أمرانِ فاخترْ منهما واحداً","أنْ تتركَ الحاجبَ أو نترككْ",107,"ك",1,0],["أمرُّ بهِ مستعطفاً متلطِّفاً","فيثقلُ تسليمي عليهِ عليهِ",108,"ي",2,0],["أمرُ هذا العودِ عندي عجبُ","لو عكسناهُ عذَرْنا العاكسا",109,"س",2,1],["أمرتني ما أنتَ أولى به","فشرِّف المأمورُ بالآمرِ",110,"ر",1,0],["أَمِرْيَةٌ بعدَ تجريبي فلستُ وإنْ","رامتْ مطامعٌ تجري بي بمنقلبِ",111,"ب",1,0],["أَمُرُّ مُجَنِّياً عَن بَيتِ لَيلى","وَلَم أُلَمِم بِهِ وَبِيَ الغَليلُ",112,"ل",1,1],["أَمُرُّ مُجَنِّباً وَهَوايَ فيهِ","فَطَرفي عَنهُ مُنكَسِرٌ كَليلُ",112,"ل",1,0],["أُمِرَّت فَفاضَت مِن فُروعٍ حَثيثَةٍ","عَلى جَدوَلٍ يَعلو فِناً مُتَعادِيا",113,"د",3,0],["أَمُرُّ عَلى الدِيارِ دِيارِ لَيلى","أُقَبِّلَ ذا الجِدارَ وَذا الجِدارا",114,"ر",2,1],["أَمَر الرّيحَ فلم تَحْمِلْهُما","وتنحَّتْ عنهما بالمنكَبَيْنْ",115,"ن",1,0],["أَمَروا فَما نَبَذَ الخُضوعَ وَلا عَصى","وَنَهوا فَأَذعَنَ رَهبَةً وَأَطاعا",116,"ع",2,0],["أَمراقِصَ الفَتَياتِ حينَ تَأَلَّبوا","ظَنّوا الوَغى وَملاعِبَ الفِتيانِ",117,"ن",1,0],["أُمِروا بالخيرِ طُرّاً مالهم","منهُ بُدٌّ ونُهوا عن كلِّ شرّ",118,"ر",1,0],["أَمرَ المليكُ فلا مَرَدَّ لأمرِهِ","وَلَكِ الكرامةُ في الفريقِ الأرشدِ",119,"د",1,0],["أمرٌ من اللّهِ مَرْجُوٌّ عَوَاقِبُه","يقضيه تبصرةً للقومِ أو أدبا",120,"ب",2,0],["أمر الرسولُ به فدونك أدّهِ","ولأنت صاحبُهُ الكريمُ المفضلُ",121,"ل",1,0],["أَمرٌ ذَخَرتَ لَهُ وَكانَ ذَخيرَةً","لَكَ إِذ تُحَطُّ عَواقِبُ الأَقدارِ",122,"ر",1,0],["أَمَرَّ وِصالُ الغانِياتِ فَأَصبَحَت","فَظاعَتُهايَشجى بِها مِن تَمَطَّقا",123,"ق",2,0],["أَمَرتُ فُؤادي بَعدَ ما نَشِبَت بِهِ","حَبائِلُ لَيلي جاهِداً بِالتَسَلُّمِ",124,"م",1,0],["آمَرتُ نَفسي فَقالَت وَهيَ خالِيَةٌ","إِنَّ الجَوادَ اِبنُ دَفّاعٍ عَلى العِلَلِ",125,"ل",1,0],["أَمرَضتِ قَلبي فَما إِن","يُطيقُ خِدمَةَ ديرِ",126,"ر",1,0],["أُمَراءٌ قادوا أَعِنَّةَ جَيشٍ","يَترُكُ الصَخرَ خَلفَهُ كَالكَثيبِ",127,"ب",1,0],["أمَرْتُكَ الخَيْرَ لكنْ ما ائْتَمَرْتُ به","وما اسْتَقَمْتُ فما قَوْلِي لَكَ اسْتَقِمِ",128,"م",1,0],["أَمَربَعَنا بِالشَطِّ لا لَعِبَ البِلى","بِرَبعِكَ ماناحَت حَمامَةُ وادِ",129,"د",1,1],["آمِراً ناهِياً أَميراً مُطاعاً","جائِزَ الحُكمِ سائِماً لا مَسوما",130,"م",2,0],["أَم رَحمَةٌ نَزَلَت مِن رَبِّهِ لَهُمو","ما قَد تَدارَكَهُم مِنَ بَعدِ ما جَهِدوا",131,"د",3,0],["أَمرَدُ كَالمَأثورِ حينَ اِستَوى","لَم تَرَهُ عَينٌ عَلى حوبِ",132,"ب",1,0],["أَمَرنا بِهِم صَدرَ النَهارِ فَصُلِّبوا","وَأَمسى حَميدٌ يَنحِتُ الجِذعَ صالِبُه",133,"ب",2,0],["أَمَرَّ عَلَيَّ العَيشَ يَومٌ عَدِمتُهُ","وَلا أَشتَهي لَيلي إِذا ما تَأَوَّبا",134,"ب",2,0],["أُمَراءُ حُكّامٌ كَأَيّامٍ أَتَت","شَفعاً بِها الجُمعاتُ وَالأَعيادُ",135,"د",1,0],["أَمَرَّت وَأَمرَت أُمُّ دَفرٍ وَإِن حَلَت","فَكَم حَلَأَت قَوماً غَداةَ وَرودِ",136,"د",1,0],["أَمَرَّت هَذِهِ الدُنيا وَمَرَّت","وَإِمراراً أُؤَنِّبُ لا مُرورا",137,"ر",2,1],["أَمَرَ الخالِقُ فَاِقبَل ما أَمَر","وَاِشكُرِ اللَهَ إِنِ العَذبُ أَمَر",138,"ر",1,1],["أَمرٌ بَدا ثُمَّ أَخفى شَأنَهُ قَدَرٌ","كَالنارِ ماتَت فَلَم يُنشَر لَها قَبَسُ",139,"س",1,0],["أَمَرَ الحازِمُ نَفساً بِالتُقى","ذاكَ أَمرٌ مِن لَبيبٍ لَم يُطَع",140,"ع",1,0],["أَمرٌ حَمى النَومَ بَعدَ الفِكرِ صاحِبَهُ","وَمِثلُهُ لِرُقادٍ وارِدٍ حامِ",141,"م",1,0],["أَمَرَتني بِسُلُوٍّ عَن خَوادِعِها","فَاِنظُر هَل أَنتَ مَعَ السالينَ ساليها",142,"ي",3,0],["أَمَرتَ بِالغَدرِ أُمَّ دَفرِ","وَلَم أُطِع فيكَ آمِرِيّا",143,"ر",3,0],["أمُرّ بِرَبْعٍ كُنْتَ فيهِ كأنّمَا","أمُرّ منَ الإكرامِ بالحِجرِ والرُّكْنِ",144,"ن",1,0],["أُمِرَّت يَداها فَتلَ شَزرٍ وَأُجنِحَت","لَها عَضُداها في سَقيفٍ مُسَنَّدِ",145,"د",1,0],["أُمِرَّ ونُحِّيَ مِن صُلبِهِ","كَتنَحِيَةِ القَتَبِ المُجلَبِ",146,"ب",1,0],["أمْرُ النبيِّ فَسِرْ يا زيدُ مُمتثلاً","والجندُ جُندُكَ ما تَأمُرْهُ يَمْتَثِلِ",147,"ل",1,0],["أمَروا بالسكوت وَهوَ لحرٍّ","ألف القول لَيسَ بالمستطاع",148,"ع",1,0],["أَمرت عيوني أن تصون دموعها","ولكن عيوني هذه لم تطاوع",149,"ع",1,0],["أمرُّ بعيني خلال السماء","وأُطرقُ مستغرقاً في الفِكَرْ",150,"ر",1,0],["أم راصدا كوكبٍ ضلاَّ سبيلهما","لما خَبَتْ من نجوم الليل أنوارُ",151,"ر",1,0],["أم رؤَى الخلدِ في الْ","حَياةِ تَمثَّلْنَ للبشَرْ",152,"ر",1,0],["أَمَرَ البَحرَ فَاِستَكانَ وَأَمسى","مِنهُ ذاكَ العُبابُ وَهوَ حَصيرُ",153,"ر",1,0],["أُمِرتُ بِالسُكوتِ مِن جانِبِ الحَق","قِ بِدُنيا فيها الأَحاديثُ زورُ",153,"ر",1,0],["أمَرَتْني الغَيَّ العَواذِلُ والحا","زِمُ رأياً مَنْ لا يُطيعُ أميرا",154,"ر",2,0],["أَمرْنا بإِمْساكِ الدُّمُوعِ جُفُونَنا","لِيْشجي بما تطوِي عَذُولٌ ولائِمُ",155,"م",1,0],["أَمَرْيَمُ لا واللَّهِ أَنْسَاكِ بَعْدَما","صَحِبْتُكِ فِي خَفْضٍ مِنَ الْعَيْشِ أَنْضَرِ",156,"ر",1,1],["أَمْرَانِ مَا اجْتَمَعَا لِقَائِدِ أُمَّةٍ","إِلَّا جَنَى بِهِمَا ثِمَارَ السُّؤْدُدِ",157,"د",1,0],["أَمَرْتُ بِمَعْرُوفٍ وَأَنْكَرْتُ مُنْكَراً","وَذَلِكَ حُكْمٌ فِي رِقَابِ الْخَلائِقِ",158,"ق",1,0],["أُمِّرَ بِالحَقِّ أَلْمَعِيٌّ","هَيْهَاتَ يُلْفى لَهُ نَدِيدُ",159,"د",1,0],["أَمَرَ الطَّاغِي بِهَا فَاحْتشَدَتْ","فِي مَقَامٍ زاخِرٍ بِالخَلْقِ زخْرَا",160,"ر",2,0],["أَمَرَ الإلهُ بِرَبْطِهَا لِعَدْوَهِ","في الحَرْبِ إنّ اللهَ خيرُ موفِّقِ",161,"ق",1,0],["أم رحتَ تبرمُ فيه رأيَ حاسدِه","راياً كسا حسنات الملكِ تشويها",162,"ي",3,0],["أمر بالشاطئ الغافي فأوقظه","بقبلة وأناديه الى السمر",163,"ر",1,0],["أُمَراءُ الكَلامِ عِشتَ وَماتوا","فَهُم مَبدَأٌ وَأَنتَ تَمامُ",164,"م",1,0],["أمُرُّ بالبَحْرِ مُرْتَاحاً إلى بَلَدٍ","تَموتُ نفسي وفيها منه حاجاتُ",165,"ت",1,0],["أَمْرٌ وعاه بنو الإنسانِ وَحْدَهُمُ","فَمَنْ بربِّكَ قلْ لي أخبر الجملا",166,"ل",2,0],["أمرٌ به سبقَ القضاء الجاري","ما حيلة الإنسان في الأقدارِ؟",167,"ر",1,1],["أم رحيقٌ طالت عليه الليالي","لم يعتَّق أمثالهُ في الدِّنان؟",168,"ن",1,0],["أمرٌ تطيشُ له العقو","لُ، ومنه تنْفَطِرُ المرائر",169,"ر",1,0],["أمر العُلا ونهى فقالت طاعة ٌ","ما شاء شِئْتُ وما أباه أبيْتُه",170,"ت",2,0],["أمرُّ على رمس القريب كأنما","أَمُرُّ عَلى رَسْم امْرىء ٍ لاَ أُنَاسِبُه",171,"ب",2,0],["امراً كما قالَ البديهةَ قائلٌ :","\" النورُ نورٌ والظَلامُ ظلام \"",172,"م",1,0],["إمراة إثر كتبة قد توالت","نعم الله فيهما بالمزيد",173,"د",1,0],["أمَرُوا زعبِينَةَ إذْ أنَخْتُ إلَيْهِمُ","بِالبَاقِيَاتِ، وَبالّتي هيَ أكْرَمُ",174,"م",1,0],["أمرّ بداره فاطيل شوقاً","وَيَمْنَعُني مِنَ النّظَرِ البُكَاءُ",175,"ا",2,0],["أمرت ففاضت من فروع حثيثة","على جدول يعلو منى متعاديا",176,"د",3,0]]}