an/poem/66137","البسيط"],[4760,"في ذمتي ..","https://www.poetsgate.com/ViewPoem.aspx?id=35830",""],[4578,"يا غزالاً قد نسجت الغزلا","https://www.poetsgate.com/ViewPoem.aspx?id=49611",""],[4869,"البارحه يوم الخلايق نياما","https://www.poetsgate.com/ViewPoem.aspx?id=137914",""],[4869,"ارجل طفل . مرثيه","https://www.poetsgate.com/ViewPoem.aspx?id=139688",""],[4927,"الباص العذول","https://www.poetsgate.com/ViewPoem.aspx?id=29647",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5198,"صوت وصدى","https://www.poetsgate.com/ViewPoem.aspx?id=136245",""],[5206,"في الصديق والصداقة","https://www.poetsgate.com/ViewPoem.aspx?id=187434",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[1043,"خداع الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=89287",""],[5370,"ضيقة العام","https://www.poetsgate.com/ViewPoem.aspx?id=86521",""],[5370,"لعيونه","https://www.poetsgate.com/ViewPoem.aspx?id=85510",""],[5433,"حب جديد","https://www.poetsgate.com/ViewPoem.aspx?id=36220",""],[5525,"تغريد","https://www.poetsgate.com/ViewPoem.aspx?id=833",""],[5536,"بذرة غلاه!!!","https://www.poetsgate.com/ViewPoem.aspx?id=20300",""],[5573,"الله وكيلي","https://www.poetsgate.com/ViewPoem.aspx?id=200181",""],[5587,"جاني كلام","https://www.poetsgate.com/ViewPoem.aspx?id=197890",""],[5606,"العام الأول قلت باروح للصيد","https://www.poetsgate.com/ViewPoem.aspx?id=197740",""],[5732,"وناديت من حولي","https://www.poetsgate.com/ViewPoem.aspx?id=177827",""],[5756,"الاولي والتالي","https://www.poetsgate.com/ViewPoem.aspx?id=5415",""],[5786,"لعاذلي قلبٌ ولي قلْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50652",""],[5877,"سوّد الله قلب جوالي","https://www.poetsgate.com/ViewPoem.aspx?id=37474",""],[5956,"مَن هي جانْسيت قازان (أمِّ خالد)؟","https://www.poetsgate.com/ViewPoem.aspx?id=207236",""],[6008,"ياحيف والله","https://www.poetsgate.com/ViewPoem.aspx?id=60801",""]],"verses":[["جانِبِ الأَطماعَ وَاِنهَج نَهجَهُ","وَاِجعَلِ الرَحمَةَ وَالتَقوى لِزاما",0,"م",2,0],["جانِبِ البُطءَ يا رَشيدُ وَعَجِّل","فَلَقَد زالَ ذلِكَ المَحذورُ",1,"ر",1,1],["جانحاتٍ تحتَ أطرَافِ القَنَا","بادِياتِ السّوقِ في فَجٍّ حذِرْ",2,"ر",1,0],["جانب الناس واعتزل","قائلاً أنهم همل",3,"ل",1,0],["جانٍ عليَّ إذا اجْتهدت كواقع","في الفخِّ زاد عناه حين تجبَّذا",4,"ذ",2,0],["جانحاً في هواهُ يَحكم بالحَيْ","فِ على الأنبياء للأحزابِ",5,"ب",1,0],["جانَبْتُ عَقْلي في الحِسَانِ فقالَ لي","لا رَأْيَ للأُذُنَيْنِ دونَ العَينِ",6,"ن",1,0],["جانِبهُ نازِلَ بَرقَعيدَ فَإِنَّهُ","أَسَدُ العَرينِ تَزورُهُ في زارِهِ",7,"ر",2,0],["جانَبَهُ القُرُّ والهَجيرُ فقَد","طابَ مَصِيفاً وطابَ مُرتَبَعا",8,"ع",2,0],["جانِب صِغارَ الذَنبِ لا تَركَبنَّها","فَإِنَ صِغارَ الذَنبِ يَوماً سُتجمَعُ",9,"ع",1,0],["جاني نَخيلٍ سِواهُ كانَ أَلَّفَها","غَرساً وَساكِنُ قَصرٍ غَيرُهُ الباني",10,"ن",2,0],["جانبِ السلطانَ واحذرْ بطشَهُ","لا تخاصمْ مَنْ إذا قالَ فعلْ",11,"ل",1,0],["جانَبتُ شَيئاً أُحِبُّ رُؤيَتَهُ","لِلَّهِ دَرِّيَ أَهوى وَأَجتَنِبُ",12,"ب",1,0],["جَانِيكَ مَنْ يَجْني عَلَيْكَ وَقَدْ","تُعْدِي الصِّحاحَ مَبارِكُ الجُرْبِ",13,"ب",1,0],["جَانِبُ الرِّفْقِ مِنْهُ دَانٍ وَلَكِنْ","جَانِبُ الحَقِّ عِنْدَهُ لا يُرَامُ",14,"م",1,0],["جَانِبُ المِرْسَمِ مَسَّتْهُ لَظىً","وَهْيَ بِالتَّصْويرِ عَنَّهُ تَشْتَغِلْ",15,"ل",1,1],["جانبُ اللهو من شبابك ولَّى","فدع اللهوَ ينتظرْ أبناءك",16,"ك",1,0],["جانُبوهُ في دَعة وأمْ","نِ والضحية أبرياؤه",17,"ا",3,0],["جانحاه في منتهى كل نجم","وهواه'، في كل سوق: تجاره",18,"ر",2,0],["جانٍ على الناس حامٍ عُقرَ بيضتهم","لا تدم الطَّول من حانٍ ومن حامِ",19,"م",1,0],["جانب الخب يا اخا الحب واصبر","فالليالي اوقاتها احلام",20,"م",1,0],["جانب زمانك ان اردت وواله","شتان بين فعاله ومقاله",21,"ل",2,1],["جانب الحرص واصحب الجود لكن","لا تبذر وكن فتى بذالا",22,"ل",2,0],["جانبت منهاج الرضا","ومضيت سوءا تقترف",23,"ف",1,0],["جاني النهارُده حمل خفيفْ","كلامُه أحلى من السُّكر",24,"ر",1,0],["جانب عدوهما ودعه فما امرؤ","والى عدوك واصطفاه صديق",25,"ق",1,0],["جانٍ جَنى النَحلَةَ مِن ريقِهِ","حُلوُ التَثَنّي وَالثَنايا رَشيق",26,"ق",1,0],["جانٍ إِذا عاتَبتُهُ","فيما جَناهُ تَعَتَّبا",27,"ب",2,0],["جانب مُعاشرة المُلوك لِزينةٍ","فَلرُبَّ داهية هُناك كَمينةٍ",28,"ه",1,1],["جانبَتهم جَوانبُ الأَرضِ حتَّى","خلت أنَّ السماءَ ذات انطِباقِ",29,"ق",1,0],["جانِبا لَوْمي وخافا لَددَي","إنَّ تفْنيدي بعضُ الفَنَدِ",30,"د",1,1],["جانب اللوم إنني مستبد","كبرياء في صبوتي وعتوا",31,"و",2,0],["جانبتم الإسراف إلا في الندى","فلذاك حسن فعالكم محمود",32,"د",1,0],["جانبت ما أهوى وطبت طوية","فنزلت منزلة هناك علية",33,"ه",1,0],["جانَبَ سِقْطَ اللَّوَى سُقُوطُ حَياً","يُكْسَى به ثَوْبَ عيشَةٍ رَغَدِ",34,"د",1,0],["جانبَ فِعْل الفتيان","وباعَه بِخُسران",35,"ن",1,0],["جانَبَ الاعتلاثَ وانتحَلَ المر","خَ لإيراءِ زَندِه والغِفارا",36,"ر",2,0],["جانَبْتُ ما جانَبْتَ فيه تَشَيُّعاً","فَمَنِ انْتَبَذْتَ فَنَبْذُهُ عِندي الجَزا",37,"ز",2,0],["جانَبتُ بَعدَكَ عِفَّتي وَوَقاري","وَخَلَعتُ في طُرُقِ المُجونِ عِذاري",38,"ر",2,1],["جانب السُلطان وَاحذَر بَطشَهُ","لا تُعاند مَن إِذا قالَ فَعَل",39,"ل",1,0],["جانَبتُهُ كَرَماً وَحَسبُكَ أَنَّني","زَحزَحتُهُ عَنِّي وَكانَ مُعانِقي",40,"ق",2,0],["جانب أقواله وأرضا","يحلها المحل والمحالُ",41,"ل",1,0],["جانب الحسن ما استطعت ولا تق","ربه فالحسن فاتن من بعيد",42,"د",1,0],["جانِبُ الشعرِ قَد اِعتَّزَ بِما","جِدتَ تَهديهِ فَأَثنى وَحَمد",43,"د",1,0],["جانب الكل وكن فيه أمِنْ","وبذاك الجنبلاطي كل جود",44,"د",1,0],["جانِبْ مُخادَعَةَ المُلوكِ عن اللُّها","فالمالُ يَذْهَبُ والخَصاصةُ تَنْجَلي ذ",45,"ل",3,0],["جانب الكرخ شأن أرضك شيّد","قبر موسى بن جعفر بن محمد",46,"د",1,1],["جانبت الحقائق الملموسَهْ","وجافت الوقائع المحسوسَهْ",47,"ه",1,0],["جانياً روضة المعارف يستو","في حقوقاً قامت بها الآباء",48,"ا",2,0],["جانست معاني بديع حسنك حتى","هميانك أضحى بضم خصرك هيمان",49,"ن",1,0],["جانب مناك ونم وقم","واترك هواك وصم وصل",50,"ل",1,0],["جانبه ياء ومن خلفه","جيم ومن قدامه داله",51,"ل",2,0],["جانِبَ الطُّورِ كلَّم اللَه موسى","واجتباهُ وفاضتِ النَّعماءُ",52,"ا",2,0],["جانبت كلّ الصحاب بعدكم","فصاحباي الحنين والأسف",53,"ف",1,0],["جانيا زهرَ أمانيه و