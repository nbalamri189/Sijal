ها","https://www.poetsgate.com/ViewPoem.aspx?id=61959",""],[5956,"لقاءُ القلوبِ الطيبة","https://www.poetsgate.com/ViewPoem.aspx?id=207912",""],[6019,"ثلاثة وعشرون عاما سنابلٌ ملأى","https://www.poetsgate.com/ViewPoem.aspx?id=206334",""],[6093,"قلقٌ تجذَّرَ في الفؤادِ وفي الحشا","https://www.poetsgate.com/ViewPoem.aspx?id=176519",""],[6225,"تفسيرٌ آخر لحلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81300&r=&rc=327",""]],"verses":[["فَعِبادَتي لِلَّهِ سِتَّةُ أَحرُفٍ","مِن بَينِها حَرفانِ مَعجومانِ",0,"ن",1,0],["فَعَبْرَةٌ في حُدُور لا رُقُوء لها","وزفْرةٌ تملأ الأحْشاء في صَعَدِ",1,"د",1,0],["فَعَبَّت غِشاشاً ثُمَّ مَرَّت كَأَنَّها","مَعَ الصُبحِ رَكبٌ مِن أُحاضَةَ مُجفِلُ",2,"ل",1,0],["فَعَبَّأَ المُسلِمُونَ الجُندَ وَاِقتَتَلُوا","قِتالَ مُنتَصِرٍ لِلحَقِّ مُنتَقِمِ",3,"م",1,0],["فَعَبَّت غِشاشاً ثُمَّ جالَت فَبادَرَت","مَعَ الفَجرِ وُرّادَ العِراكِ المُصَبِّحِ",4,"ح",1,0],["فعُبّىء الحزبان للّطام","طام يعبُّ لنزال طام",5,"م",1,0],["فعبرت زقاقا مأهولا","وزقاقا ، هرما منحلا",6,"ل",2,0],["فَعَبَّتْ غشاشاً ، ثُمَّ مَرَّتْ كأنها ،","مع الصُّبْحِ ، ركبٌ ، من أُحَاظة مُجْفِلُ",7,"ل",1,0],["فَعَبّاسُ بِنُ مِرداسِ بنِ عَمرٍو","وَكَذبُ المَرءِ أَقبَحُ ما يُفيدُ",8,"د",1,0],["فَعَبَّدَ لِلمُستَرفِدينَ طَريقَها","وَوَطَّدَ مِن أَكنافِها أَيَّ تَوطيدِ",9,"د",1,0],["فعَبّوا لهم طامي الضفافِ عرمرماً","كتائبُه للحربِ والسلمِ صُفَّت",10,"ت",1,0],["فعبرتم نهر المجرَّة مُخلين","مكاناً لهم عريضاً طويلا",11,"ل",2,0],["فعبَّرت عبرات الدمع حين جرتْ","عن صبوةٍ بتُّ أخفيها وأُبديها",12,"ي",3,0],["فعبداللَه يسمو كل حرٍ","ويعلو كل ذي همم فعالا",13,"ل",2,0],["فَعَبَأْتَ للإِسلامِ عَطْفَةَ رَحْمَةٍ","أَلْحَفْتَ أَهلَ الأَرْضِ ظلَّ جَناحِها",14,"ح",3,0],["فَعَبَّت وَعَبَّ السِربُ حَتّى إِذا اِرتَوَت","ذَكَرنَ فِراخاً دونَهُنَّ طُروحُ",15,"ح",1,0],["فعبد اللطيف الحبر أوحد عصره","إمام هدى قد كان الله داعيا",16,"ي",2,0],["فعبد عَزيزٍ أَنتَ أُنسِي وَراحَتِي","وَقُربُكَ يُحيينِي وَبُعدُكَ فادِحُ",17,"ح",1,0],["فَعَبد لَطيفٍ أَنتَ رُوحِي وَراحَتِي","وَقربُكَ يُحيِيني وَبُعدُكَ لِي حَتفُ",18,"ف",1,0],["فَعَبدت لإِزديادِ السَعدِ ذاكِرَةً","يَومَ الجُلوسِ الَّذي قَد راقَ مَنظَرَهُ",19,"ر",2,0],["فَعَبدَ العَزيزِ جُد عَلَيَّ تَكَرُّماً","بوَصلٍ فأحمَالُ الجَوى أَثقَلَت ظَهري",20,"ر",2,0],["فعبدتمُ بالصفح بيض صفاحهم","حتى لقد كادت تذوب توقدا",21,"د",2,0],["فعبر عَن أسمائِهِ كُل منبرٍ","وأفصَحَ عن آلائِهِ كُل ذي قال",22,"ل",1,0],["فَعَبَّأنا أعِنَّتَها فَجاءَت","عَوابِسَ وَالغُبارُ لَها بَريمُ",23,"م",1,0],["فَعبدهم بَينَ الأَجانب سَيد","وَسَيدهم لِلضَيف في بَيتِهِ عَبد",24,"د",1,0],["فعبد العَزيزِ بنَ الفَتَى عُمَرَ الذي","إِلى آلِ عَكّاسٍ نَماهُ المُتَرجِمُ",25,"م",1,0],["فعبت العين من سناها","وهامت الروح فى هواها",26,"ا",3,0],["فعبر عن سجية ممسكيه","بثرثرة وأصوات ضِخَام",27,"م",1,0],["فعبدا الغذا في أكثر الأمر مطعمٌ","ومبدا الردى في أغلب الحال إطعانُ",28,"ن",1,0],["فعبر عن حزنه للمصاب","بأن بعث الحسن بعد الغياب",29,"ب",1,0],["فعبيدك طال حسابُهُمُ","فاَلطف واسمح بالتحرير",30,"ر",1,0],["فعبْدُكَ يُهْديها إليك وسائِلاً","أبى اللهُ أنْ تُلفَى بجودك مُهْمَلَهْ",31,"ل",2,0],["فعبدوه مدة أعواما","إذ عدموا الألباب والأحلاما",32,"م",2,0],["فَعَبدُكَ في طامي عُبابِك طامِعٌ","وَإِن يَكُ ذا ذَنبٍ فَأَنتَ صَفوحُ",33,"ح",1,0],["فَعبدُكَ هَذا الدَهرُ أَصبَحَ عامِلاً","لِخَفضي وَما لي غَيرَ فِعلِكَ رافِعُ",34,"ع",1,0],["فعُبوسُ أرْديةِ الْحيَا","عُقْباه للرَّوضِ ابْتسامْ",35,"م",1,0],["فَعَبد اللَطيفِ الشيخ نَجل مُبارَك الن","قيبَة مَعقود عَلَيهِ الخَناصِر",36,"ر",1,0],["فعبيد فضلك أرخوه لطيبه","قصرٌ سما بسعادة السكّان",37,"ن",1,0],["فعبارته ذوات اعتبار","جملت طروسه وزانت مداده",38,"د",2,0],["فعبَّأ الرجسُ شياطينَه","ليبدأ الحربَ وما أخَّرا",39,"ر",2,0],["فعبأ جيشه وسطا عليهم","بسيف صب من موت زؤام",40,"م",1,0],["فعبأ جيشهم وسطا عليهم","بسيف صُبَّ من موت زؤام",41,"م",1,0],["فعبدته والعشق غال حشاشتي","يا نشوة الاقدار وهو رسيمها",42,"م",3,0],["فعبقريته لا شيء يشرحها","كالرّقْمِ فهو لشرح الفكر ميدانُ",43,"ن",1,0],["فعبدك ذا مابين جودك والرضى","وحلمك والأغضا ان ا نجداتها",44,"ه",2,0],["فَعَبِّقْ جِسْمَكَ الْمَغْلُوبَ مِسْكاً","لَعَلَّ الْعِطْرَ يَسْرِي فِي الدِّمَاءِ",45,"ا",2,0],["فعبِّري عنه يا ذات الوشاح ولا","تبقي عليه ليبقى بين أعشاش",46,"ش",1,0],["فَعَبرَ قَنَاةِ الجَمَاعَةِ تَمضِي","إلى العِزِّ ، فَاْجَهَرْ ب \\\" وَا مُرشِدَاهْ \\\"",47,"ا",2,0],["فعبر عنه جاهل متمعلم","بجهل وبهتان فما نال مغنما",48,"م",2,0],["(فعباس) للسقيا يروح مهرولا","إلى أن يَردّ الغدرُ ساقيك كوثرا",49,"ر",2,0],["فعبقر الجن حاكمٌ نهمٌ","يُلقي عليهم معيشة ضنكا",50,"ك",2,0],["فعباد الله بكل مكا","ن فوق الأرض توحّده",51,"د",2,0],["فعبِّئي من دموعِ الحزن آنيةً","يمضي بها العمرُ بالتذكارِ حيرانا",52,"ن",2,0],["فعبد الحميدِ حميدٌ سميعٌ","على قدْر وُسْعِهِ قدرُ التجائي",53,"ا",2,0],["فَعَبَرتُ كي ألقاك ضِفَّةَ مَائِهِ","بَوحاً وَبَعدِيَ كُلُّ حَرفٍ يَعبُرُ",54,"ر",1,0],["فعبيرُ ذِكرك بالثَّناء وفعلكم","نشرُ الورودِ إذا تحركها النَّشا",55,"ش",2,0],["فعبرْنا بلا سَفين ٍ مُحيط َ الحُلُم","المُختفي وراءَ الوضُوح ِ",56,"ح",1,0]]}