,[5956,"تقول لي: ليس في الحب حرام","https://www.poetsgate.com/ViewPoem.aspx?id=182679",""],[5956,"طول عمري وجهادي لم أشاهدْ","https://www.poetsgate.com/ViewPoem.aspx?id=193357",""],[6102,"عذلوني","https://www.poetsgate.com/ViewPoem.aspx?id=184448",""],[6115,"خذ من الأمس دروسا وعبر","https://www.poetsgate.com/ViewPoem.aspx?id=181639",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""],[6259,"لست في بينها الغداة بلاحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59363&r=&rc=11",""]],"verses":[["إنما هيأ الدعاة نظاماً","ولأمر قد اقتضاني النظام",0,"م",1,0],["إنما هذه المدارس روض","يُنبت المجد والعلا والفَخارا",1,"ر",2,0],["إنما هذه الأجازة صك","بيد المرء ضامن اعزازه",2,"ز",2,0],["إنما هذه المواطن أم","مستحق لها علينا الولاء",3,"ا",2,0],["إنما هذه الجسوم مبانٍ","قد بناها من الزمان عمول",4,"ل",1,0],["إنما هذه الجسوم رسوم","موحشات بعد الردى وطلول",4,"ل",1,0],["إنما هذه الحياة جروحٌ","أثخنتنا والموت مثل الضِماد",5,"د",1,0],["إنما هذه الحياةُ غرورٌ","وشقاءٌ للمَعْشر الأشقياءِ",6,"ا",2,0],["إِنَّما هَل يَدومُ لي","حُبُّكِ المُشرِقُ النَدي",7,"د",2,0],["إنما هذه النعوش التي ير","كبها الهالكون بئس المطايا",8,"ي",2,0],["إنما هذه الحياة كنور","حف من كل جانب بظلام",9,"م",1,0],["إنما هذه الحياة كنهر","صاخب في طريقه ينساب",10,"ب",1,0],["إنما هذه الطبيعة سفر","تتهجى عنوانه الألباب",10,"ب",1,0],["انما هذه الدموع تهاوى","من عيون عصارة الاكباد",11,"د",1,0],["انما هذه حقائق صرحت بها","صادعا بلا تمهيد",12,"د",1,0],["انما هذا القبر آخر بيت","لك يا مالك القصور الطباق",13,"ق",1,0],["انما هذا الشعر حين تغنيه","على قربه بعيد المنال",14,"ل",1,0],["انما هذا الكون بحر خضم","تستبيح الامواج منه السفينا",15,"ن",2,0],["انما هذه الطبيعة","بحر طما وثر",16,"ر",1,0],["انما هذه القطيعة آذتنا","فمن ذا سعى بنا وتسبب",17,"ب",1,0],["انما هذه الحياة شرار","من زفير الاثير ثار فشاعا",18,"ع",2,0],["انما هذه الطبيعة قيد","والنواميس كلها حلقات",19,"ت",1,0],["انما هذه الطبيعة سفر","لم تحبر حروفها فوق طرس",20,"س",1,0],["إنما هم كمثل أصداف بحر","لست تدري دُرّ بها أم خلاء",21,"ا",2,0],["إِنَّما هُم حِقدٌ وَغِشٌّ وَبُغضٌ","وَأَذاةٌ وَغَيبَةٌ وَاِنتِحالُ",22,"ل",1,0],["إِنَّما هَيبَةُ المُؤَمَّلِ سَيفِ ال","دَولَةِ المَلكِ في القُلوبِ حُسامُ",23,"م",1,0],["إِنَّما هَمُّ وارِثي بَعدَ مَوتي","ما أُخَلّي لا ما أَصيرُ إِلَيهِ",24,"ه",1,0],["إِنَّما هَذِهِ القُلوبُ حَديدٌ","وَلَذيذُ الأَلفاظِ مِغناطيسُ",25,"س",1,0],["إِنَّمَا هذِهِ الْحَيَاةُ غُرُورٌ","تَنْقَضِي بِالشَّقَاءِ وَالْحِرْمَانِ",26,"ن",1,0],["إنَّما هذه الطبيعةُ أُنسي","ومُعيني إنْ لم أجدْ من مُعين",27,"ن",1,0],["إِنَّما هِمَّتي غَزا","لٌ وَصَهباءُ كَالذَهَب",28,"ب",1,1],["إنّما همّتي غلا","مٌ وسؤلي ومطلبي",29,"ب",2,1],["إِنَّما هَذِهِ المَذاهِبُ أَسبا","بٌ لِجَذبِ الدُنيا إِلى الرُؤَساءِ",30,"س",3,0],["إِنّما هُوَ تَركُ الشَرِّ مُطَّرِحاً","وَنفضُكَ الصَدرَ مِن غِلٍّ وَمِن حَسَدِ",31,"د",1,0],["إِنَّما هَذِهِ الحَياةُ عَناءٌ","فَليُخَبِّركَ عَن أَذاها العِيانُ",32,"ن",1,0],["إنما هذه الطبيعة ذات ال","لاتناهي كتابُهُ المسطور",33,"ر",1,0],["إِنَّما هذه المَجَر","رة أَم الكَواكِب",34,"ب",1,1],["إنما هذه الخَليقَة سفر","يقرأ الفَيلَسوف منه فصولا",35,"ل",2,0],["إِنَّما هَذه التوابع يجري","نَ درا كاً في الجو حول ذكاء",36,"ا",2,0],["إنما هذه القوى عند ظَني","نجمت من مَعامل الكيمياء",36,"ا",2,0],["إِنَّمَا هَيَّأَ الدعَاةُ نِظَاماً","وَاقْتَضَانِي فِيمَا يُقَالُ النِّظَامُ",37,"م",1,0],["إنما هل يرى التفاهات حي ؟","تلتقي أحدث الخطورات قربه",38,"ب",2,0],["إنما ... هل ترين هذا امتيازا ؟","مثل هذا يجريه فأر وفارة",39,"ر",2,0],["إنما … هل ترين هذا امتيازا ؟","مثل هذا يجربه فار وفاره",40,"ر",2,0],["إنَّما هُو مستعدٌّ لِعُقبي الد","دارِ يَشدُو لَنِعمَ عُقبَى الدَّارِ",41,"ر",1,0],["إنما هذه الحياة غرور","قد خدعنا بها فأين العقول",42,"ل",1,0],["إِنّما هَذه القلوبُ مرايا","فَوقَها مِن ظلالٍ لكلِّ مرأى مراءُ",43,"ا",2,0],["إنّما هوَّنَ الرزيَّةَ أني","منذ خلّفتَني أراك بِوَهمْي",44,"م",2,0],["إنما هذه الأمانىُّ في النَفْ","س سَرابٌ لا يَنقَعُ الأظماءَ",45,"ا",2,0],["إنّما هيَ لحظةٌ في اِلتفات","ما تَراخت أو في خطرةٌ في جنانِ",46,"ن",1,0],["إنّما هيَ ميعةٌ من نشاطٍ","خامَرتها لا جمحةٌ من حرانِ",47,"ن",1,0],["إنّما هذهِ الحياة متاعٌ","بِعوارٍ مردودة باِغتصابِ",48,"ب",1,0],["إِنما هُمهنّ أَن يَتحلَّين سُ","موطاً وسُنبلاً فارسياً",49,"ي",2,0],["إِنَّما هُم كَما تَرى أَنعامَ","قَد أَضَلّوا أَمّا المَصيرُ فَلِلجَزرُ",50,"ر",1,0],["إنما هذه الحياة تهاويل نمتها","الأيام محتبلات",51,"ت",1,0],["إِنَّما هَذِهِ الحَياةُ مَتاعٌ","ثُمَّ تَفنى حَياتُنا وَالمَتاعُ",52,"ع",1,0],["إنَّما هذه العقولُ أبا الجَي","شِ لنَظم الأشعارِ فيك فصُنها",53,"ن",3,0],["إنما هذا مثال فاعتبر","وعليه قس تجدها ظلما",54,"م",2,0],["إنما هبت الرياح على خ","د حبيبي فأثرت فيه غبرة",55,"ه",1,1],["إنّما هزَّتِ الزَّلازلُ هذي ال","أرضَ بالغافلين كي يَستَفيقُوا",56,"ق",3,0],["إنَّما هذه الحياة ابتلاءُ","ولغوبٌ وشِقْوَةٌ وعَناءُ",57,"ا",2,0],["إنَّما هذا لَعمري مَرْكَبٌ","في أمانِ الله فيه من يُسافرْ",58,"ر",1,1],["إنما هذه المصابيحُ أدَّت","غايةَ السُّخرِ إن يُغلَّ اللسانُ",59,"ن",1,0],["إنما هذه مظاهر للقد","رة انفعلت بسر القرآن",60,"ن",1,0],["إنما هذا حبيبي حاضر","وأنا يا ليت شعري من أنا",61,"ن",2,0],["إنما هم عبدوا رب","ب الدراري والهلال",62,"ل",1,0],["إنَّمَا هِي لِمَالِكِي المسعُودِ","بَدْرِ أفْقِ السُّعُودْ",63,"د",1,0],["إنما هذا السلوقي فما","مات إلا في الأذى والمخزيات",64,"ت",1,0],["إنما هذه الحياة سراب","لا مع يخدع الغرير الغويّا",65,"ي",2,0],["إنَّما هزَّت قنا صبركمُ","نكبةُ الدهر فزادتها ثقافا",66,"ف",2,0],["إِنَّما هذه الحَياة غرور","كَخيال يَلوح للنوام",67,"م",1,0],["إنما هو عينه فاعتبروا","تجدوا ما قلت في نشر وطي",68,"ي",1,0],["إنما هواه","أن يكون حبي",69,"ب",2,0],["إنَّما هذه الحياة كحلمٍ","طارقٍ تستلذُّه في سباتك",70,"ك",1,0],["إنما هذه الحياة غرور","فسفاها تغتر فيها سفاها",71,"ا",3,0],["إنما هذه الحياة خيال","ولكل الأنام فيها مقيل",72,"ل",1,0],["إنما هذه الطبيعةُ انثى","قد حوت في الغرم كل السمات",73,"ت",1,0],["إنما هذه الحياةُ متاعٌ","فاصرفوها في البر والحسنات",74,"ت",1,0],["إنما هيش معانا البلاد حتى تنال","مطلبك حين قد اشتقت وصلي",75,"ل",2,0],["إِنّما هذه الحياةُ مَتاعٌ","والسّفيه الغَوِيّ من يَصْطفيها",76,"ه",2,1],["إنما هذه الحياة فناءٌ","فاطلب الموت إن أردتَ الخلودا",77,"د",2,1],["إنما هذه الحياةُ مَنامٌ","والأمانِي حُلْمٌ بها الْمَرْءُ صَبُّ",78,"ب",1,1],["انما هذه الحياة غرور","مثل لمع السراب فوق الهضاب",79,"ب",1,0],["انَّما هذه الصَّنائِع رِقٌّ","فَعزيزٌ مِن أَهلِهَا وَذَلِيلُ",80,"ل",1,0],["إِنَّما هِيَ لِأُناسٍ","شَأنُهُم شَأنٌ عَظيمُ",81,"م",1,0],["إِنَّما هَذِهِ الحَياةُ غُرورٌ","بَعدَها الفَصلُ بَينَكُم وَالخُلودُ",82,"د",1,0],["إنَّمَا هُم يَدٌ عَلَى مَن سِوَاهُم","ضَرَّرَ الكُفرُ بَينَهُم رُحمَاءُ",83,"ا",2,0],["انما هَذا شجاع انما","هُوَ يَبدو يَوم يَبدو كأسد",84,"د",1,0],["إنما هكطور لم يبغ انسياب","كتب الطرواد مشتد النداء",85,"ا",2,0],["إِنَّما هَكطُورُ وَالبِرَّ رَعى","إِسكَمَندَريُوساً الطِّفلَ دَعا",86,"ع",2,0],["إنما همتي وأعلى طلابي","للغربين أن أزج الركابا",87,"ب",2,0],["إنما هذه المظاهرُ جزءٌ","لك يبدو في طيِّها الاحترام",88,"م",1,0],["إِنَّما هاجَ لِقَلبي","شَجوَهُ بَعدَ المَشيبِ",89,"ب",1,1],["إنما هذه الحياة متاع","ومع الموت يستوي الاقدام",90,"م",1,0],["إنّما هذهِ الحياة عوارٍ","وعلى المستعير ردُّ المعارِ",91,"ر",1,0],["إِنَّما هَذِهِ العُيونَ السَقيما","ت بَلاء لِذي القُلوبِ الصِحاحِ",92,"ح",1,0],["انما هذه الحياة منامٌ","يعدم المرء لذة الاغماض",93,"ض",1,0],["انما هذه الحياة مَمَرٌّ","بين شِقَّيْ وجودِنا لا تمادِ",94,"د",1,0],["إنّما هَذهِ الحيَاةُ كنُوزٌ","لا تُساوِي أمَامَ حُزنِكَ قِرْشَا",95,"ش",2,0],["إنما هو بنو الزمان","وأخلاقهم كذا",96,"ذ",2,1],["إنما هذه الحياة ظروف","ملأتها الصروف حتى الجيوب",97,"ب",1,0],["إنما هذه الحياةُ تهاويلٌ","نَمتها الأيامُ مُختبلاتِ",98,"ت",1,0],["إنما هي ظلام أبيض","تتقيه دامسات السدفات",99,"ت",1,0],["إنَّما هذه الحياةُ شراعٌ","ومتاهاتُ الدَّهْرِ كرٌّ وفرُّ",100,"ر",1,0],["إنّما هُنَّ فتنةٌ لتقيٍّ","وشقيٍّ أدخلنَهُ هُنَّ نارا",101,"ر",2,0],["إنما هذا وثوقٌ وهيامٌ","بالتي أَخْبَرَها، يا زوجُ ثُبْ",102,"ب",1,0],["‏ ‏إنما هذا مُحالٌ","‏ ‏ في زمان عبدِ مَهْرِ",103,"ر",1,0],["إنّما هذا هيامٌ","لا تخف من أن تُضاما",104,"م",2,0],["إنما هذا أصيلٌ وفضيلٌ","فضلَ شهر الصومِ في العامِ كواحدْ",105,"د",1,0],["إِنَّما هُنَّ فَراشٌ حَولَهُ","قَدْ تَحَرَّقنَ عَلَى جَمرِ الشِّواءْ",106,"ا",2,0],["إنماهي ساعةٌ محتومةٌ","بعدها أما نعيماً أوسقر",107,"ر",1,0],["إنما هذه الحياة فناء","فلنقابلْ أدواءها بدواء",108,"ا",2,0],["إنما هذه العيونُ السقيما","تُ سقامٌ لذي القلوب الصِّحاح",109,"ح",1,0]]}