{"poems":[[87,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[47,"أبالمنحنى أم بالعقيق أم الجرف","https://www.aldiwan.net/poem65157.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55143","الكامل"],[246,"يا أخت غصن البانة المياس","https://www.aldiwan.net/poem45768.html","الكامل"],[1103,"","https://poetry.dctabudhabi.ae/diwan/poem/204004","الوافر"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123867","الطويل"],[5413,"مررنَ كأحلام الكرى!","https://www.poetsgate.com/ViewPoem.aspx?id=200636",""]],"verses":[["فَلِمِصرٍ وَأَنتَ بِالحُبِّ أَدرى","بِكَ ياحامِيَ الحِمى اِستِعصامُ",0,"م",1,0],["فَلِمَ صِرتُ في جَدواكَ أُسوَةَ واحِدٍ","وَقَد نُبتُ في تَفويفِ مَدحِكَ عَن أَلفِ",1,"ف",1,0],["فَلِمِصْر مَفْخَرَةٌ عَلَى الأَقْوَامِ فِي","تَقْدِيمهَا ذَاكَ المِثَالَ الأَمْثَلاَ",2,"ل",2,0],["فَلَمِصرُ مِصرُكَ عن أبيك وِرَاثةً","وافته عن أجدادِك الأكياسِ",3,"س",1,0],["فلم صلة الطبيب تكون زوراً","وقد أهدى الشفاء من السقام",4,"م",1,0],["فلم صرت يا مولاي عني معرضا","وانت ومن اعطاك اكرم منهم",5,"م",1,0],["فَلِمْ صَارَ مِنْ أَخْبَارِ كانَ علاقةٌ","تغنَّى بها حينًا زماني وأطربَا!!",6,"ب",2,0]]}