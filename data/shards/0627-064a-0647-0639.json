{"poems":[[79,"الصبر إلا في هواك حميد","https://www.aldiwan.net/poem36607.html","الكامل"],[87,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[107,"أيها القائد العظيم تقدم","https://www.aldiwan.net/poem42050.html","الخفيف"],[107,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[108,"عودة إلى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=179678",""],[79,"الصبر إلا في هواك حميد","https://www.poetsgate.com/ViewPoem.aspx?id=33802",""],[102,"روح شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50166",""],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[124,"إيه عبد الرحمن أذكيت جمرا","https://www.aldiwan.net/poem49274.html","الخفيف"],[189,"إيه على تذكار ما سلفا","https://www.aldiwan.net/poem14591.html","أحذ الكامل"],[230,"أمطري يا سحائب الفضل ما شئ","https://www.aldiwan.net/poem55202.html","الخفيف"],[280,"فواتح الفتح تنبي عن تواليه","https://www.aldiwan.net/poem25461.html","البسيط"],[315,"هذي الديار فحيهن صباحا","https://www.aldiwan.net/poem59513.html","الكامل"],[315,"أسرفن في هجري وفي تعذيبي","https://www.aldiwan.net/poem59519.html","الكامل"],[484,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83303","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48512","الخفيف"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122103","البسيط"],[2170,"","https://poetry.dctabudhabi.ae/diwan/poem/198609","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137051",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74035","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103267","الخفيف"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/141094","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35095","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35082","البسيط"],[4679,"أية عيد الجلوس يا خير عيد","https://www.poetsgate.com/ViewPoem.aspx?id=142750",""],[4929,"ليت ناعيك","https://www.poetsgate.com/ViewPoem.aspx?id=207549",""],[5183,"طوارق الحدثان","https://www.poetsgate.com/ViewPoem.aspx?id=180265",""],[5183,"الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=186596",""],[5365,"مالم تقلهُ زرقاءُ اليمامة","https://www.poetsgate.com/ViewPoem.aspx?id=190408",""],[5756,"حد علمي","https://www.poetsgate.com/ViewPoem.aspx?id=5421",""],[6019,"عاصفةُ الحنين ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=53053",""],[6102,"فوائد الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=182744",""],[6102,"دانا ..","https://www.poetsgate.com/ViewPoem.aspx?id=183992",""]],"verses":[["إيهٍ عَميدَ الحيِّ غيْرَ مُدافَعٍ","قَلْبي بِما يلْقاهُ منْكَ عَميدُ",0,"د",1,0],["إيهِ عَبدَ الحَميدِ جَلَّ زَمانٌ","أَنتَ فيهِ خَليفَةٌ وَإِمامُ",1,"م",1,0],["إيه عزّامُ أنت للحقِّ ركنٌ","في يد اللهِ ثابتٌ ليس يُهدَمْ",2,"م",1,0],["إيه عبدَ اللَّهِ أشهِدْ رافعاً","غزوةَ الحمراءِ في القومِ الشُّهُدْ",3,"د",1,0],["إيهِ عبدَ اللَّهِ ما أصدَقَها","هِمَّة صَمَّاء تأبى أن تُهَدّ",3,"د",1,0],["أيْةُ عذراءَ بغير لين؟","يا فتنةَ الدنيا، وركنَ الدينِ",4,"ن",1,0],["إيه عميد الوحي غير مدافع","قلبي بما يلقاه منك عميد",5,"د",1,0],["إيه عزّام أنت وعي من النيل","إلى العرب تستثير المشاعر",6,"ر",1,0],["إيهٍ \" عميدَ الدار \" كلُّ لئيمةٍ","لابُدَّ – واجدةٌ لئيماً صاحبا",7,"ب",2,0],["إيهٍ \" عميدَ الدار \" ! شكوى صاحبٍ","طفَحَتْ لواعجُهُ فناجى صاحبا",7,"ب",2,0],["إيهٍ عبد الرحمن أذكيت جمراً","حيث قدرت أن ستفرغ صبرا",8,"ر",2,1],["إيهٍ على تذكارِ ما سَلَفا","فالدمعُ منك أَقلُّ ما وَكَفا",9,"ف",2,1],["إيه عَبّاسُ شُقَّ نهجاً جديدا","كلَّ يومٍ إِلى ذُرا الأَمجادِ",10,"د",1,0],["إيهٍ عَن الشَّرفِ العَادِي أحْرَزَهُ","فَما ادَّعَتْهُ وَلا كَادَتْ أَعَادِيهِ",11,"ي",2,0],["إيه عن الحي الجميع وربما","طرب الفؤاد لذكرهم فارتاحا",12,"ح",2,0],["إيه عن الصبر الجميل فإنه","ألوى بدين فؤادي المنهوب",13,"ب",1,0],["إيه عشت يا ملك","كان للهدى سببا",14,"ب",2,0],["إيهٍ عَبد الحَميدِ إِنَّ زَماناً","أَنتَ فيهِ عَبّاسُهُ بَسّامِ",15,"م",1,0],["إيه عباس إن سعيك للإس","لام سعيٌ مبارك وجهاد",16,"د",1,0],["إِيهٍ عَلَى الجِيرَةِ الغَادِينَ دَارُهُمُ","نَجْدٌ وَعَنْ مُنْجِدِي مِنْ غُرِّ أَهْلِيهَا",17,"ي",3,0],["إيه، عياض عن العلاء فإنما","شرح العلاء حديثك المنظوم",18,"م",1,0],["ايه عيد الجلوس يا خير عيد","جادك الغيت من نهار سعيد",19,"د",1,1],["إِيه عليٌّ فَأَنتَ ملك فَضائلٍ","لكَ في العلا تاج علا وَسَريرُ",20,"ر",1,0],["إيه عيش الديار لو أبت أو لم","يَعرُ أيامك العزاز انقضاء",21,"ا",2,0],["إيه عهد الشباب والعمر غضٌّ","والليالي بأهلها وضّاء",21,"ا",2,0],["إيه عصر للرقي ماذا جنينا","فيك غير الشقاء والآلام",22,"م",1,0],["إيهٍ على الحيّ الذين تحملوا","والشوق يتبعهم ذماء الأنفس",23,"س",1,0],["إيهٍ عَميدَ الحَيِّ غَيرَ مُدافَعٍ","إيهٍ فِدىً لَكَ غابِرُ الأَمجادِ",24,"د",1,0],["إيهٍ عَنِ الكُديَةِ البَيضاءِ إِنَّ لَها","هَوىً بِقَلبِ أَخيكَ الوالِهِ الوَصِبِ",25,"ب",1,0],["أية عيد الجلوس يا خير عيد","جادك الغيث من نهار سعيد",26,"د",1,1],["إيهِ عمي...ذُبحتُ فيك فراقاً","سرمديا وعزَّ فيك التداني",27,"ن",2,0],["إيه علامة الشريعة أسجح","عن مدين الولا عثور اللسان",28,"ن",1,0],["إيه عفراء في خبائك روحي","ويح روح يضيق عنها الخباء",29,"ا",2,0],["إيهٍ على زمنٍ في كلّ موقعَةٍ","كان الخطابُ إذا ماعدْتُمُو عُدْنا",30,"ن",2,0],["إيه عدّت من يدي بس ماعدّت بخير","ليلةٍ عيّت تجيني وجتني مظلمه",31,"م",2,0],["إيه عدّت من يدي بس ماعدّت بخير","ليلةٍ عيّت تجي بس جتني مضلمه",31,"م",2,0],["إِيهٍ (عِرَاقُ) الطَّيِّبينَ تَقَازَمَتْ","عِندِي الحُرُوفُ أَمَامَ عُمقِ رُؤَاكَا",32,"ك",2,0],["إِيهٍ عَلَى زَمَنٍ ؛ لَوَ انَّ رُجُومَهُ","سَقَطَتْ عَلَى \" المَرِّيخِ \" ناحَ \" عُطارِدُ \" !",33,"د",1,0],["إِيهٍ ؛ عَلَى ذِكرَياتٍ كُلَّما خَطَرَتْ","فَوقَ التِياثِيَ رَجَّتْ أَضلُعِي . إِيهِ",34,"ي",2,0]]}