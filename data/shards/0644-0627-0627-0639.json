{"poems":[[6,"لا أعرفنك إن أرسلت قافيةً","https://www.aldiwan.net/poem386.html",""],[79,"لا أعدم الله دار الملك منك سنا","https://www.aldiwan.net/poem36115.html","البسيط"],[49,"قمر دون حسنه الأقمار","https://www.aldiwan.net/poem25276.html","الخفيف"],[74,"ما للندى لا يلبي صوت داعيه","https://www.aldiwan.net/poem20565.html","البسيط"],[53,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[53,"قد طلع البدر مع الزهره","https://www.aldiwan.net/poem62999.html","السريع"],[53,"أيها الحاسدي على صحبتي العسر","https://www.aldiwan.net/poem66408.html","الخفيف"],[94,"ليت لي أن أعيش في هذه الدنيا","https://www.aldiwan.net/poem38950.html","الخفيف"],[47,"لا يرم ربعك السحاب يجوده","https://www.aldiwan.net/poem63508.html","الخفيف"],[47,"ها هو الشيب لائما فأفيقي","https://www.aldiwan.net/poem65182.html","الخفيف"],[47,"لاتجزين أبا عبيدة صالحا","https://www.aldiwan.net/poem66810.html","الكامل"],[51,"سكر الشباب جنون","https://www.aldiwan.net/poem63129.html","المجتث"],[54,"أسألت طللا","https://www.aldiwan.net/poem26765.html","مجزوء الرمل"],[77,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[50,"لا أعير الدهر سمعي","https://www.aldiwan.net/poem10819.html","مجزوء الكامل"],[52,"اسمعي يا خليد أنت الخلود","https://www.aldiwan.net/poem63922.html","الخفيف"],[52,"لله سلمى حبها ناصب","https://www.aldiwan.net/poem64840.html","البسيط"],[7,"من مبلغ عمرو بن هند آية","https://www.aldiwan.net/poem1986.html","الكامل"],[7,"لقد نهيت بني ذبيان عن أقر","https://www.aldiwan.net/poem1997.html","البسيط"],[70,"العاذل كالعاذر عندي يا قوم","https://www.aldiwan.net/poem1530.html",""],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85538","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54920","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55074","الخفيف"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/50449","الرجز"],[108,"صدى الجمهورية","https://www.poetsgate.com/ViewPoem.aspx?id=179586",""],[108,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[6,"لا أَعْرِفَنَّكَ إنْ أرْسَلْتَ قَافِيَة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14192&r=&rc=7",""],[124,"أكلما عشت يوما","https://www.aldiwan.net/poem49334.html","المجتث"],[135,"هل مثل قلبك في الأهواء معذور","https://www.aldiwan.net/poem24018.html","البسيط"],[146,"لا أعذر المرء يصبو وهو مختار","https://www.aldiwan.net/poem58448.html","البسيط"],[190,"لا أعد العيش ما وقعت","https://www.aldiwan.net/poem43493.html","المديد"],[190,"الحب جائحة من فعل إبليس","https://www.aldiwan.net/poem43725.html","البسيط"],[203,"لا أعذل الدهر على","https://www.aldiwan.net/poem45399.html","مجزوء الرجز"],[215,"هذا ربيع وأنت ناء","https://www.aldiwan.net/poem46772.html","مخلع البسيط"],[230,"نحن لله ما لحي بقاء","https://www.aldiwan.net/poem55098.html","الخفيف"],[234,"يا سيدي وأميري","https://www.aldiwan.net/poem51098.html","المجتث"],[240,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[261,"من شروط الصبوح في المهرجان","https://www.aldiwan.net/poem48463.html","الخفيف"],[266,"عقبى مدى الهم أولي غاية الفرج","https://www.aldiwan.net/poem38354.html","البسيط"],[275,"حبي الخليفة مولانا ومولاك","https://www.aldiwan.net/poem35652.html","البسيط"],[280,"لا أعصر الخمر بل أغرس العنبا","https://www.aldiwan.net/poem25626.html","البسيط"],[290,"قل للجواد يجود لي بجواد","https://www.aldiwan.net/poem39381.html","الكامل"],[358,"تقارن النيران الشمس والقمر","https://www.aldiwan.net/poem40339.html","البسيط"],[387,"منع النوم ماوي التهمام","https://www.aldiwan.net/poem433.html",""],[453,"شوقي إليكم مثل وجدي فيكم","https://www.aldiwan.net/poem53724.html","الكامل"],[510,"الحبّ","https://www.aldiwan.net/poem42456.html","مخلع البسيط"],[563,"إنما الدين كله تقليد","https://www.aldiwan.net/poem34595.html","الخفيف"],[567,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[741,"","https://poetry.dctabudhabi.ae/diwan/poem/199301","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63868","المنسرح"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38136","السريع"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99971","الخفيف"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145825","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59156","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59157","البسيط"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130631","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76910","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71052","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53178","المنسرح"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27605","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109401","الخفيف"],[2255,"","https://poetry.dctabudhabi.ae/diwan/poem/34915","البسيط"],[2283,"","https://poetry.dctabudhabi.ae/diwan/poem/202194","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93535","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93582","الرمل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46749","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74243","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65296","السريع"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104320","السريع"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112367","المنسرح"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74058","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62869","الخفيف"],[3531,"","https://poetry.dctabudhabi.ae/diwan/poem/145742","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108310","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108059","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216711",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117922","الخفيف"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103791","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66544","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86517","السريع"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103026","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36528","الدوبيت"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22077","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81238","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33721","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139533",""],[4755,"حَجْر الله\" الصحي","https://www.poetsgate.com/ViewPoem.aspx?id=211332",""],[4908,"إليها في غِيَابِها","https://www.poetsgate.com/ViewPoem.aspx?id=207383",""],[3591,"ليس الحسان لنا إلا إذا حسنت","https://www.poetsgate.com/ViewPoem.aspx?id=149416",""],[5277,"ظلالٌ وضفاف","https://www.poetsgate.com/ViewPoem.aspx?id=206824",""],[5409,"هيئوا العدة وامشوا قدما","https://www.poetsgate.com/ViewPoem.aspx?id=155314",""],[5409,"وطن يرانا الخير من غربائه","https://www.poetsgate.com/ViewPoem.aspx?id=155247",""],[5431,"مناجاة...والحب أنت قُبيل الوقت مبتدأ","https://www.poetsgate.com/ViewPoem.aspx?id=198840",""],[5781,"وخزةٌ في قلبٍ مكشوفٍ للوجع","https://www.poetsgate.com/ViewPoem.aspx?id=185317",""],[5781,"وَخْزةٌ في قلبٍ مكشوفٍ للوجع","https://www.poetsgate.com/ViewPoem.aspx?id=190952",""],[5859,"طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=29415",""],[5903,"الملك الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=32599",""],[5956,"تتركني","https://www.poetsgate.com/ViewPoem.aspx?id=182007",""],[5956,"شاعر الأديان","https://www.poetsgate.com/ViewPoem.aspx?id=192499",""],[5977,"جنة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=213138",""],[6056,"نجاحي بعيد الإحتمال .....!","https://www.poetsgate.com/ViewPoem.aspx?id=130158",""],[6108,"خطيئة","https://www.poetsgate.com/ViewPoem.aspx?id=192749",""],[6108,"مع سبق الإصرار","https://www.poetsgate.com/ViewPoem.aspx?id=192751",""],[6124,"بلغت","https://www.poetsgate.com/ViewPoem.aspx?id=159861",""],[523,"هل لُغْزِي هذا مَفْهُومٌ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=100021",""],[6236,"من أجلك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82000&r=&rc=19",""]],"verses":[["لا أَعرِفَنَّكَ إِن أَرسَلتَ قافِيَةً","تُلقي المَعاذيرَ إِن لضم تَنفَعِ العِذَرُ",0,"ر",1,1],["لاَ أَعْدَمَ اللهُ دَارَ الْمُلْكِ مِنْكَ سَنَا","يُجْلَى بِهِ الْحَالِكَانِ الظُّلْمُ وَالظُّلَمُ",1,"م",1,1],["لا أُعاصيهِ في اِجتِراحِ المَعاصي","في هَوى مِثلِهِ تَطيبُ النارُ",2,"ر",1,0],["لا أعتب الزمن المودي بسيِّدهِ","يكفيه ما قد تولَّى عنه يكفيه",3,"ي",2,0],["لا أعدُّ العلوَّ منهم عُلوَّاً","بل طُفُوّاً يمينَ غيرِ كِذابِ",4,"ب",1,0],["لا أعقبا من فرحةٍ تَرْحة","كلّا ولا من حَبرة عبرهْ",5,"ر",2,0],["لا أعُدُّ الذنوبَ منك ذُنوباً","بل هدايا مقبولةً وحنانا",6,"ن",2,0],["لا أُعَنِّي نفسي بأحْزانِ شعبي","فَهْوَ حيٌّ يعيش عيشَ الجمادِ",7,"د",1,0],["لا أُعَنّيهِ بِاِقتِضاءٍ وَلا أُر","هِقَهُ طالِباً وَلا أَستَزيدُه",8,"د",2,0],["لا أَعُدُّ المَرزوقَ مِنها إِذا فَكَّر","تُ فيها وَفيهِ بِالمَرزوقِ",9,"ق",1,0],["لا أَعلَمَنَّكَ تَستَزيرُ عِصابَةً","مِن بَعدِنا شامينَ أَو جَزرينا",10,"ن",2,0],["لاأُعمِلُ الظَنَّ إِلّا","فيما تَسوغُ الظُنونَ",11,"ن",1,0],["لا أَعوذُ بِالدُجى","وَأُحِبُّ الرَجُلا",12,"ل",2,0],["لا أعذِرُ النصْلَ المُفيتَ أباكِ أو","يَهْمي نفوساً أو يُقَدَّ فُلولا",13,"ل",2,0],["لا أُعيرُ الدَهرَ سَمعي","لِيَعيبوا لي حَبيبا",14,"ب",2,1],["لا أُعَفّي بِهِ وَلا أَعرِفُ العَي","شَ وَعِندي بَلِيَّةٌ لا تَبيدُ",15,"د",1,0],["لا أَعبُدُ المالَ إِذا جاءَني","حَقُّ أَخٍ أَو جاءَني راغِبُ",16,"ب",1,0],["لا أَعرِفَنَّكَ عارِضاً لِرِماحِنا","في جُفِّ تَغلِبِ وادِيَ الإِمرارِ",17,"ر",1,0],["لا أَعرِفَن رَبرَباً حوراً مَدامِعُها","كَأَنَّ أَبكارَها نِعاجُ دُوّارِ",18,"ر",1,0],["لاأعتَبُهُ ان يزرْ في حُلُمي","فالسمعُ يَرى ما لا يُري طيف النوم",19,"م",1,0],["لا أَعادَ الرحمن أَيامَ كربٍ","عشت فيها والدائرات تدور",20,"ر",1,0],["لا اعْتِرَاضٌ عَلى القَضَاءِ وَلَكِنْ","كلَّ يَوْمٍ أُصابُ هَذَا كَثِيرُ",21,"ر",1,0],["لاَ اعْتِرَاضَ عَلَى القَضَاءِ وَلَكِنْ","أَشَد الأَحْكَامِ حِكْمُ الفِرَاقِ",22,"ق",1,0],["لا أعدَمَ اللهُ الأَنامَ ظِلَّه","فقد أزالَ الخَوفَ عنه والعَدَمْ",23,"م",1,0],["لا أعرِفُ الفردَ تَفْنَى فيه أمَّتُهُ","طُرًّا فإِنْ يَهْوِ يَهْوِ الكُلُّ من صَعَدِ",24,"د",1,0],["لا أعرفُ العربيَّ يكشفُ رأسه","نحو المجالس مُومئًا بسلام",25,"م",1,0],["لا أعرف العربي يلوي فكَّه","إن همَّ يومًا فكُّه بكلام",25,"م",1,0],["لا أَعْرِفَنَّكَ إنْ أرْسَلْتَ قَافِيَة ً","تُلقي المعاذيرَ إنْ لَمْ تنفَعِ العِذرُ",26,"ر",1,1],["لا أعرف الأمن عمري","كأنني قد رزئته",27,"ت",2,0],["لا أَعرِفَن لِمَّةً سَوداءَ داجِيَةً","تَدعو كِلاباً وَفيها الرِمحُ مَكسورُ",28,"ر",1,0],["لا أعِذر المرءَ يصبو وهو مختارُ","الحبُّ يُجمَعُ فيه العارُ والنارُ",29,"ر",1,1],["لا أعدّ العيش ما وقعت","دونه نفسي على خجل",30,"ل",1,1],["لا أعرف العطف إلا في مواصلةٍ","من الهديّة أو فرك القراطيس",31,"س",1,0],["لا أعذلُ الدهرَ على","ما أفسدت لي يدُهُ",32,"د",2,1],["لا أعرف اليوم كيف أصغى","إلى حديثٌ تغيب عنه",33,"ه",1,0],["لا أُعَزّيكُمُ وَأَنّي لِقَولي","أن تُعَزّى بِمثلهِ الحُكماء",34,"ا",2,0],["لا أعرف السهل والوَعْ","رَ إن قصدتُ مَسيري",35,"ر",2,0],["لا أَعتَفي غَيرَ الخَليفَةِ طالِباً","رِفداً كَفاني بِرُّهُ وَصِلاتُهُ",36,"ت",2,0],["لا أعد الصبوح إلا غب وقاً","إن جعلت الصبوح بعد الأذان",37,"ن",1,0],["لا اعذل الخل عني مال منحرفاً","أو ما ثنى عذل الثقيف من عوج",38,"ج",1,0],["لا أعدم الله داء الدهر منك رقى","فإنه جد معتل وملتعج",38,"ج",1,0],["لا أعجميَّ سطا يوماً عليكِ ولا","دَخيلَ فاللهُ من تَقواكِ أعطاك",39,"ك",1,0],["لا أعْصِرُ الخَمْرَ بل أغْرِس العِنَبا","حَسبي ثُغُورٌ تُبيحُ الظّلْمَ والشّنَبا",40,"ب",2,1],["لا أعرف الأسفار إلا راكبا","فرسا من الخيل العتاق ينادي",41,"ي",1,0],["لا أَعشق المرد أَهواها وَيُهلكني","مِن أَجلِها المرديان السُهد وَالسَهَرُ",42,"ر",1,0],["لا أَعُدُّ الإِقتارَ عُدماً وَلَكِن","فَقدُ مَن قَد رُزِئتُهُ الإِعدامُ",43,"م",1,0],["لا أعدم الله الوجود وجودكم","أبدا ومتعكم بما قد نلتم",44,"م",1,0],["لا أعْرفُ ماضياً يؤودُ","أوحاضراً عيْشُهُ كئيبُ",45,"ب",1,0],["لا اعتقاد له ولكن كلام","كسلاح يسطو به الصنديد",46,"د",1,0],["لا أعقَبَ الويلُ مِصراً وَهْوَ تارِكُها","همّاً فجُودُ يَديهِ جاءَ يُغنيها",47,"ي",3,0],["لا أعرف اللّيل من النّهار","لخلتني عجلان ذا انشمار",48,"ر",1,0],["لا أَعجز اللهُ غير رأي أبي","عثمانَ فيه فرأيه الأعجز",49,"ز",1,0],["لا أَعرفُ اللّيلَ وَشَمسَ الضّحى","لَم أَدرِ إِلّا الطّاسَ وَالكَأسا",50,"س",2,0],["لاَ أُعَلِّي بِهِ لعُلْوَةَ فِكْراً","فِي مَشِيبٍ لَهَا وَلاَ لِلْعَمِيسِ",51,"س",1,0],["لا أعدُ الجراحَ إلا هِبَاتٍ","ودُعاةُ الجراحِ ليسوا بجرحى",52,"ح",2,0],["لاَ أعتب الزمنَ المُودِي بسيده","يَكْفِيهِ مَا حَلَّ في أحْشَاهُ من كمدِ",53,"د",1,0],["لاَ أعتب الزمنَ المُودِي بِسَيِّدِهِ","يَكْفِيهِ مَا قَدْ تَوَلَّى مِنْهُ يكفيهِ",54,"ي",2,0],["لا أعذرن نفوسا لم تمت ولهاً","لتقتفيك ولكن شفها الألم",55,"م",1,0],["لا اعتذارٌ ولا شفيعٌ يُرَجَّى","هكذا فاجرعي كؤوسَ الهوانِ",56,"ن",1,0],["لا أُعطِيَ الواشي إلي","كَ لهجرتي ما قد نَوى لي",57,"ل",2,0],["لا أَعرفُ الدهر لي في الناس غيرهمُ","قِسماً إذا الناس يوم البأس يقتسمُ",58,"م",1,0],["لا أعثر الدهر منكم قدماً","تسمو بتقبيل تربه الدول",59,"ل",1,0],["لا أعرف اللغو في قولٍ أفوه به","إنَّ السديد من الأقوالِ أقوالي",60,"ل",2,0],["لا اعتذارٌ لموسرٍ فيهِ يوماً","عن أداء ولا لصاحب عسره",61,"ر",2,0],["لا أَعشَقُ الأَبيَضَ المَنفوخَ مِن سِمَنٍ","لَكِنَّني أَعشَقُ السُّمرَ المَهازيلا",62,"ل",2,0],["لا أعرفنك بعد اليوم تندبني","وفي حياتي ما زودتني زادي",63,"د",2,0],["لا أَعيب الدَهر ما دُمتُم بِهِ","فَزَمان قَد حَواكُم لَن يُعابا",64,"ب",2,0],["لا أَعاف البكر مِن ريقتها","لِعَجوز ولدت أَيّام عاد",65,"د",1,0],["لا أعدَمُ الذمَّ حينَ أُخطي","وَلَيسَ لي في الصَّوابِ حَمدُ",66,"د",1,1],["لا أَعرف الغمض وَطيب الكَرى","إِلا إِذا ما تم كراسها",67,"س",3,0],["لا أعذرُ الطيف إذا ما أتى","يشكو لعيني حالة هائله",68,"ه",1,1],["لا أعرف الشعر ولا نظمه","إلا إذا صرت ببيت الخلا",69,"ل",2,0],["لا أعرفُ التّجافي","لا أفهَمُ النّوَى",70,"ن",3,0],["لا أَعطَيت حريّة","تعطي القَليل لِتَمنَعا",71,"ع",2,0],["لا أُعَنِّي أَسماعكم بالمواعي","دِ فانَّ الوعيدَ كيدُ الضَّعِيفِ",72,"ف",1,0],["لا أعدَم اللهُ فيك الخلْقَ نافعَهم","يا من به تفخرُ الدُنيا وتبتهجُ",73,"ج",1,0],["لا أعشق البان إذ من كان رب أخ","يفوق بأن اللوىلا يعشق البانا",74,"ن",2,0],["لا اعد الجمالَ غير فقيرٍ","قد بذلنا له النفوسَ نوالا",75,"ل",2,0],["لا أعين الماء ناضبات","ولا خلا الروض من ثمر",76,"ر",1,0],["لا أعاني التأويل فيها اتباعاً","للهوى أو تعصّباً أو ضرارا",77,"ر",2,0],["لا اعشق الظبي ذا لجام","لانه في الظباء منكر",78,"ر",1,0],["لا أَعدَمَ اللَّهُ هذا الخَلْقَ مِنْكَ يَداً","بَيْضاءَ إِنْ مَنَعَتْهُمْ غَيْرُها سَمَحتْ",79,"ت",1,0],["لا أعرف الشاعر عيناً وقد","يشف عما يحتويه اللثام",80,"م",1,0],["لا أعتبنك في تناسي عهدنا","ما أخلق الإنسان بالنسيان",81,"ن",1,0],["لا أَعدَمُ من صوب دُموعي نَثراً","من سَجعِكَ في قرينَةٍ تُتبِعُها",82,"ه",2,0],["لا أَعتَقَ اللَهُ رِقّي مِن صَبابَتِكُم","ما ضَرَّني أَنَّني صَبُّ بِكُم قَلِقُ",83,"ق",1,0],["لا أَعرف اليَوم إِلّا أَنَّهُ لِغَد","باب تَمر عَلى مغلاقه يوح",84,"ح",1,0],["لا أعدمَ اللَه فؤادِي الهَوى","يوماً ولا جرَّبهُ قلبُك",85,"ك",1,0],["لا أعاد الإله أيامَ سوءٍ","كم أصابت سهامُها الألبابا",86,"ب",2,0],["لا أُعَانِي مِن سَكرَةِ الخَوفِ وَحدِي","إِنَّ كُلَّ البِلادِ -إِن خِفتُ- بِضعَة",87,"ع",2,0],["لا أعرفُ الآن أينَ الحُّبُّ يقذفُ بي","في لُجَّةِ اليَمِّ أم في ظُلْمَةِ الغَارِ",88,"ر",1,0],["لا أعشق الورد ليس الورد يخدمكم","فخدكم فاقه بالحسن والطيب",89,"ب",1,0],["لا أعرفُ الأمسَ الذي راودتهُ","ميقاتَ يومِكَ تحت وطأتهِ غدا",90,"د",2,0],["لا أعاد الله محيا زمن","طبخ اليتيم وغذى القيما",91,"م",2,0],["لا أعتبن على الزمان فانني","ممن يرون العدل ملء قضائه",92,"ا",3,0],["لاأعرف النوم في تختٍ وسادته","لم تشهد الحربَ لم يحفلْ بها النبأ!!",93,"ا",1,0],["لا أَعْصِرُ الدَّمعَ مُذْ جفَّتْ مَساكِبهُ","يُدمي الفؤادَ بلا سُمٍّ يُحَرِّعُهُ",94,"ع",2,0],["لا أَعْصِرُ الدَّمعَ مُذْ جفَّتْ مَساكِبهُ","يُدْمي الفُؤَادَ بِلا سُمٍّ يُجَرِّعُهُ",95,"ع",2,0],["لا أعلم كيف ستمضين","بأعماقي .. ومياهكِ ضحلة!",96,"ل",2,0],["لا أعرف اليوم الجميلَ ولا","شعري أذاق فؤاديَ الوسَنَ",97,"ن",1,0],["لا أعرف هل تشرق شمسي","أم تبقى في المغرب تُطْمَسْ",98,"س",1,0],["لا أعرف العلماء لكنْ عارفٌ","بسطاءَ قومي حيث عشتُ أغرِّدُ",99,"د",1,0],["\"لا أعشق الشعر إلا حين أذكركم\"","يا نبض شعري وإلهامي وإحساسي",100,"س",2,0],["لا اعلن برأس المؤشر ، معمل إعداد الجمل","يرسل النوتة تترجم كل مفهوم الجمال",101,"ل",1,0],["لا أعشق الوجه الجميل وإنّما","يختالني التفكيرُ والأخلاقُ",102,"ق",1,0],["لا أعرفُ الصدقَ إنّي محضُ كاذبةٍ","أطاول الحبَّ كي أُهدي له فاسا",103,"س",2,0],["لا أعرفُ البابَ الذي","يأتي إليهِ الغائبُ.",104,"ب",1,0],["لا أعرفُ ، لكني أعرفُ","أنَّكَ تعرِفُهُ مَكَّار",105,"ر",1,0],["لا أعرفُ أمَّاً تَكْفُلُنى","لا أعرفُ وطناً يَحْوينى",106,"ن",2,0],["لا أعرف اسمى أو سِنّى","لا شىءَ سوى مَنْ سَتَكونى",106,"ن",2,0],["لا أعرِفُ شيئاً عنكِ سِوى","أنِّى أهواكِ ... ويكفينى",106,"ن",2,0]]}