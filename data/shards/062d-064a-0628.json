{"poems":[[55,"حي بين النقا وبين المصلى","https://www.aldiwan.net/poem30776.html","الخفيف"],[79,"خدع الشوق فؤادي فانخدع","https://www.aldiwan.net/poem35986.html","الرمل"],[79,"عبد العزيز خليفة الله الذي","https://www.aldiwan.net/poem36624.html","الكامل"],[68,"حي بالصرف من كؤوس المدام","https://www.aldiwan.net/poem39204.html","الخفيف"],[69,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[108,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[160,"أيئست من أسماء أم لم تيأس","https://www.aldiwan.net/poem423.html",""],[458,"هاتى ثلوجك هاتي","https://www.aldiwan.net/poem61589.html","المجتث"],[572,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88600","الرجز"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101203","الرمل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199629","المسحوب"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216673",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79843","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113953","الخفيف"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96486","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48241","السريع"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53197","الرجز"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216397",""],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105402","الخفيف"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71361","الكامل"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104827","الخفيف"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101236","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127101","الكامل"],[4830,"نَخلُ العِراق","https://www.poetsgate.com/ViewPoem.aspx?id=207898",""],[5307,"حيّ بْجوابٍ مِنْك رايع","https://www.poetsgate.com/ViewPoem.aspx?id=10536",""],[5671,"حي برامة آراما وغزلانا","https://www.poetsgate.com/ViewPoem.aspx?id=169355",""],[5689,"حي بدرا بافق مسرتا، تلالا","https://www.poetsgate.com/ViewPoem.aspx?id=143437",""],[6045,"وثبة قلب طروب","https://www.poetsgate.com/ViewPoem.aspx?id=181560",""]],"verses":[["حَيِّ بَينَ النَقا وَبَينَ المُصَلّى","وَقَفاتِ الرَكائِبِ الأَنضاءِ",0,"ا",2,1],["حَيِّ بالرّضْوان عنّي ابْنَ رِضي","فرْعَ مجْدٍ قُنّةَ المجْدِ فرَعْ",1,"ع",1,0],["حَيَّ بِها وَطَنَ الجِهادِ تحيّةً","أبْدَتْ عُهودَ نَشاطِهِ ومَراحِهِ",2,"ح",2,0],["حَيِّ بِالصَرفِ مِن كُؤوسِ المُدامِ","إِنَّ بِنتَ الكُرومِ عِرسُ الكِرامِ",3,"م",1,1],["حَيَّ بُلْبَيْسَ مَنْزِلاً في العِمَارَهْ","وَتَوَجَّهْ تِلْقَاءَ بِئْرِ عُمَارَهْ",4,"ر",2,1],["حيٌّ به شبَحُ الرَّدَى","في كلِّ زاويةٍ كمينْ",5,"ن",1,0],["حِيبَت لَهُ جَبلاءُ مِن فَوقِ الصَّفا","مَجرٌ يَمُرُّ عَلى الخَليجِ الأَخرَسِ",6,"س",1,0],["حَى بفنىّ وفكرى","وليس موي سُباتي",7,"ت",2,0],["حَيٌّ بحالَةِ مَيِّتٍ","وَهَواكِ يودِعُهُ ضَريْحَهْ",8,"ح",2,0],["حيّ بممدود الرواق أَغلبا","يلبس عن شد الحبا وقاره",9,"ر",2,0],["حي بالكرخ كناسا","قد تخذناه مزارا",10,"ر",2,0],["حي بجوابٍ منه بدع جالي","بآرد ميازاته بكاس مالي",11,"ل",2,1],["حَيْ بِ اللي ينتظر رَدّي","عَدّ ما تِتْرَنَّمْ سْطوره",12,"ر",2,1],["حيّ بسامةَ العشيّ تُفدّي","بوجوهٍ كم قد دجت تقطيبا",13,"ب",2,0],["حيِّ بينَ النَقا وآدِكمارِ","أربُعاً قد بَلين مُذ أعصارِ",14,"ر",1,1],["حيُّ باسيافهم يبغون مجدهم","ان المكارم في المكروه تبتدر",15,"ر",1,0],["حيِّ بسفحِ البانِ أهلَ الصلاحْ","يحمي ظِبا الإِنْسِ بحدِّ السِّلاحْ",16,"ح",1,1],["حيّ به سمر القنا محدقة","بكل بيضاء لها طرف أَحَمّ",17,"م",1,0],["حيّ بْشرتاً لفاني","لي من جَدا لمغيب",18,"ب",1,1],["حي بالرقمتين حياً أقاموا","حبذا منزل لهم ومقام",19,"م",1,1],["حَيٌّ بهِ مَاتَ السُّلُوُ أَمَا تَرَى","لُبْسَ الجُفُونِ عَلَيهِ ثَوْبَ حِدَادِ",20,"د",1,0],["حي بدراً حيا بشمس الحميا","وحباها بالمزج شهب الحباب",21,"ب",1,0],["حي بالرقمتين منهم ربوعا","قد سقته الدموع غيثاً مريعا",22,"ع",2,1],["حي بها المولى الذي قصرت","عن فخره ديباجة المدح",23,"ح",1,0],["حَيِّ بُوَيتاً فيهِ ظلُّ نُبُوَّةٍ","أفتى فكانَ لِكُلِّ كَسْرٍ جابِرا",24,"ر",2,0],["حيّ بْجوابٍ مِنْك رايع","يا ذا الخوي لَيْ لك معي قَدّ",25,"د",1,1],["حي برامة آراما وغزلانا","سوانحا يرتعين الرند والبانا",26,"ن",2,1],["حي بدرا بافق مسرتا، تلالا","يكسب الأرض والسماء جمالا",27,"ل",2,1],["حي بالشعر سليمان فما","أقبح الشعر إذا لم ينتخب",28,"ب",1,0]]}