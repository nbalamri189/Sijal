et/poem15673.html","الطويل"],[462,"يفضل الصارم في عزمته","https://www.aldiwan.net/poem16119.html","الرمل"],[462,"يا عاقدا وضن الجمال البزل","https://www.aldiwan.net/poem16248.html","الكامل"],[467,"يا سخنة العين للجرمي إذ جمعت","https://www.aldiwan.net/poem50425.html","البسيط"],[480,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[501,"خبط الظلام ولألأ الفجر","https://www.aldiwan.net/poem37558.html","أحذ الكامل"],[501,"قل للذي فينا تمسك مخلصا","https://www.aldiwan.net/poem37724.html","الكامل"],[507,"يا رشأ حظى إبعاده","https://www.aldiwan.net/poem2442.html","السريع"],[516,"صرف النسيب إلى اللوى وزرود","https://www.aldiwan.net/poem12082.html","الكامل"],[516,"وفى لك حد الجد والسيف غادر","https://www.aldiwan.net/poem12105.html","الطويل"],[530,"خبرية حالية محكية","https://www.aldiwan.net/poem37081.html","الكامل"],[539,"لما استقام ولم يفز بمرامه","https://www.aldiwan.net/poem48130.html","عموديه"],[539,"عبد ببابك خده قد عفرا","https://www.aldiwan.net/poem48191.html","عموديه"],[539,"تأخرت عن صوغ القريض له قصدا","https://www.aldiwan.net/poem48216.html","عموديه"],[552,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[552,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[552,"لك ما تراماه لحاظ الناظر","https://www.aldiwan.net/poem47795.html","الكامل"],[559,"واحد وهو في الظهور ثلاثه","https://www.aldiwan.net/poem33515.html","الخفيف"],[559,"خلاف الوجود الصرف فالعدم الأخ","https://www.aldiwan.net/poem33553.html","الطويل"],[559,"أشكر الله خالقي في البريه","https://www.aldiwan.net/poem33560.html","الخفيف"],[559,"قمر من فوق غصن نقا","https://www.aldiwan.net/poem34336.html","المديد"],[563,"ورد الكتاب فضاع طيب نشره","https://www.aldiwan.net/poem52956.html","الكامل"],[563,"لمن الدمع بعد هذا تصون","https://www.aldiwan.net/poem52978.html","الخفيف"],[564,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[565,"متى يرحم المشتاق والوامق المضنى","https://www.aldiwan.net/poem896.html",""],[568,"ما بال طفشيلك قد أخرت","https://www.aldiwan.net/poem69459.html","السريع"],[587,"لاعبت بالخاتم إنسانة","https://www.aldiwan.net/poem18018.html","السريع"]],"verses":[["خبت بإزائه للدهر نار","وجدوته تزايد باشتعال",0,"ل",1,0],["خَبوطٌ بِاليَدَينِ يُشِتُّ شَملاً","جَميعاً بِالنَوى وَيُلِمُّ شَملا",1,"ل",2,0],["خَبَرٌ تَمَخَّضَ بِالأَحِبَّةِ ذِكرُهُ","قَبلَ اليَقينِ وَأَسلَفَ البَلبالا",2,"ل",2,0],["خَبَأتُ لَهُ ما بَينَ جَنبيَّ فَتكَةً","دَهَتهُ وَيَومُ الغادِرينَ شَنيعُ",3,"ع",1,0],["خَبَرٌ تَشَبَّثَ بِالمَسا","مِعِ عَن فَمِ المَلِكِ الخَطيرِ",4,"ر",1,0],["خَبَّت إِلَيكَ الخُطوبُ مُعجِلَةً","ضُروبَ شَدِّ الجِيادِ وَالخَبَبِ",5,"ب",1,0],["خَبَتْ نَجَداتُهمْ والجُبْنُ يُعْدي","بهِ والنارُ يُطْفِئُها الرّمادُ",6,"د",1,0],["خَبِّروني عَنِ الهَوى أَو سَلوني","نارُ قَلبي تَمُدُّ ماءَ جُفوني",7,"ن",2,1],["خَبِّروني عَن رَأيِكُم أَعَلى الهِج","رانِ أَم قَد بَدا لَكُم في وِصالي",8,"ي",1,1],["خَبَّرَ عَن شَكواكُمُ بِالَّذي","يَبكي لَهُ كُلُّ خَليلٍ صَديق",9,"ق",1,0],["خَبَّروني أَنَّها مَرَّت بِهِ","قُلتُ مِن ثَمَّ أَراهُ مُشرِقا",10,"ق",2,0],["خَبِّروني عَنِ الحِجازِ فَإِنّي","لا أَراني أَمَلُّ ذِكرَ الحِجازِ",11,"ز",1,1],["خَبِّرا عَنِّي المُنَجِّمَ أَنِّي","كافِرٌ بِالَّذي قَضَتهُ الكَواكِبُ",12,"ب",1,1],["خَبَت نارُ نَفسي بِاشتِعالِ مَفارِقي","وَأَظلَمَ لَيلي إِذ أَضاءَ شِهابُها",13,"ب",3,1],["خَبَّرُوهَا أنَّي سَلَوْتُ فَقَالَتْ","أَنْ يَشِيبَ الْغُرَابُ عِندِيَ أَدْنَى",14,"ن",2,0],["خَبَتْ نار حرْبٍ لمْ تهِجْها وأقْفَرَتْ","منازِلُ قوْمٍ لمْ تبِتْ منْكَ في خَفْرِ",15,"ر",1,0],["خبَطْنا بِها منْ هضْبَةٍ لقَرارةٍ","ضَلالاً ومِلْنا منْ كِناسٍ الى خِيسِ",16,"س",1,0],["خَبِّرينا جُهَينَ لا تَكذِبينا","ما الَّذي يَفعَلُ البِلى بِالجَوادِ",17,"د",1,0],["خَبِّروا فِكتورَ عَنّا أَنَّهُ","أَدهَشَ العالَمَ حَرباً وَنِظاما",18,"م",2,0],["خَبَت زَمَناً حَتّى تَوَهَّمتُ أَنَّها","تَجافَت عَنِ الإيراءِ لَولا كُرومَرُ",19,"ر",1,0],["خَبَرتُهُم فَرَأَيتُ القَومَ قَد سَهِروا","عَلى مَرافِقِهِم وَالمُلكُ قَد سَهِرا",20,"ر",2,0],["خَبّر فديتُكَ مَن أَبوهُ طائِرٌ","إِن كُنتَ تَعلَمُ وَابنُهُ إِنسانُ",21,"ن",1,1],["خَبّروني عَن اِسمِ جَمعٍ وَإِن شِئ","تَ فَفِعلٌ ماضٍ وَإِن شِئتَ حَرفُ",22,"ف",1,1],["خَبّروها بِأَنَّهُ ما تَصَدّى","لِسلُوٍّ عَنها وَلَو ماتَ صَدّا",23,"د",2,1],["خَبَرتُ الهَوى حَتّى عَرَفتُ أُمورَهُ","وَجَرَّبتُهُ في السِرِ مِنهُ وَفي الجَهرِ",24,"ر",1,1],["خَبَرنَجَةٌ خَودٌ كَأَنَّ نِطاقَها","عَلى رَملَةٍ بَينَ المُقَيَّدِ وَالخَصرِ",25,"ر",1,0],["خبر طويت حشاي مرتجفا","من هوله وسقطت منصدعا",26,"ع",2,0],["خُبِّرتُ أَهلَكِ أَصعَدوا مِن ذي الصَفا","سَقياً لِذَلِكَ مِن فَريقٍ أَصعَدا",27,"د",2,0],["خَبِّر عَنِ الحَيِّ سِرّاً أَو عَلانِيةً","جادَتكَ مُدجِنَةٌ في عَينِها وَطَفُ",28,"ف",1,0],["خَبَّرتُما خَبَراً فَهاجَ لَنا الهَوى","يا حَبَّذا الجَرَعاتُ فَوقَ سَنامِ",29,"م",1,0],["خُباساتُ الفَوارِسِ كُلَّ يَومٍ","إِذا لَم يُرجَ رِسلٌ في السَوامِ",30,"م",1,0],["خَبِيثٍ مِن العُصبَةِ الأخبَثِينَ","وإن قُلتُ زَانِينَ لَم أَقذِفِ",31,"ف",1,0],["خبية حسنٍ كنت مغتبطاً بها","ولكن برغمي في التراب دفنتها",32,"ت",3,0],["خبا الشهاب فقلنا الشمس فاعْترضت","أيدي الردَى فزمان الأنس ديجور",33,"ر",1,0],["خبزٌ وخيرٌ وجبرٌ بعد ما نطقت","فللمحامد تجنيسٌ وتصحيف",34,"ف",1,0],["خبى وجهها عنِّي وأُخليَ ربعها","فآهاً على وجهٍ ذكرت وخال",35,"ل",1,0],["خَبَّرَ عنها شيخُهُ أنه","صادفها مفتوحةَ المَثْعبِ",36,"ب",1,0],["خِبْتَ يا دهرُ بعدَهُ","فاحْيَ إن شئتَ أو مُتِ",37,"ت",1,0],["خَبَّرُونا أنْ قد هجوتَ ابن رومي","يٍ وما أنت من رجال جهادِهْ",38,"د",2,1],["خُبعثنةٌ جأب البضيع كأنه","مكسَّر أجواز العظام مجبّر",39,"ر",1,0],["خبُثت فلو شُلِشلت في الماء لم يسغ","لصادٍ وأضحى صفوه وهو أكدر",39,"ر",1,0],["خبا قمرُ الدنيا لحين اتساقه","فيا أسَفاً هلا لحين سِراره",40,"ر",2,0],["خبِّرهُ بالداء واسأله بحيلته","تُخْبَرْ وتَسْلَ أخا فهمٍ وإفهامِ",41,"م",1,0],["خبَّر اللَّهُ أنَّ مَشْأَمةً كا","نَتْ لقومٍ وخبَّر القرآن",42,"ن",1,0],["خبَّرتُه أن رأس الأيرِ فيشلةٌ","فقال كلا ولكن رأسُ خاقان",43,"ن",1,0],["خَبِّر بَني الصَلتِ عَنّا إِن لَقيتَهُمُ","أَنَّ الحَديدَ إِذا أَمسَيتُ غَنّاني",44,"ي",1,1],["خَبَرتُ بَني الدُنيا وَفَتَّشتُ فيهِمُ","فَلَم تَرَ عَينِيَ قَطُّ أَثقَلَ مِن قِسِّ",45,"س",1,0],["خَبا نِبراسُنا وَاللَيلُ داجٍ","وَمَوجُ الحادِثاتِ لَهُ اِلتِطامُ",46,"م",1,0],["خَبِّرهُمُ أَنَّ الكَواكِبَ لَم تَزَل","تَحنو عَلى العُشّاقِ بَينَ كُرومِها",47,"م",3,0],["خَبِّرينا إِنَّ فيكِ لَنا","حِكمَةً تَعلو عَلى الحُكمِ",48,"م",1,0],["خَبِّرينا كَيفَ عاقِبَةُ","البَغيِ هَل كانَت سِوى نَدَمِ",48,"م",1,0],["خَبِّر فَإِنَّ القَومَ في حَيرَةٍ","هَلِ الرَدى فاتِحَةٌ أَم خِتام",49,"م",1,0],["خَبِّر وَحَدِّث كُلُّنا حائِرٌ","ذو الجَهلِ مِنّا وَالأَريبُ الهُمام",49,"م",1,0],["خَبِّروهُم يا أَيُّها العاقِلونا","إِنَّما نَحنُ مَعشَرُ الشُعَراءِ",50,"ا",2,0],["خَبِّروني ماذا رَأَيتُم أَأَطفالاً","يَتامى أَم مَوكِباً عُلوِيّا",51,"ي",2,1],["خَبَأتُ لَكُم أَشياءَ سَوفَ أَقولُها","لَها جُمَلٌ هَذَّبتُها وَفُصولُ",52,"ل",1,0],["خَبَّأتُ لَكُم حَديثاً في فُؤادي","لَأُتحِفَكُم بِهِ عِندَ التَلاقي",53,"ق",2,0],["خَبَرٌ ما نابَنا مصمَئِلٌّ","جَلَّ حَتّى دَقَّ فِيه الأَجَلُّ",54,"ل",1,0],["خُبِّرتُ أَنَّ الفَتى مَروانَ يوعِدُني","فَاِستَبقِ بَعضَ وَعيدي أَيُّها الرَجُلُ",55,"ل",1,0],["خبِّروني هلْ للورى من إلهٍ","راحمٍ مِثْلُ زَعْمِهِمْ أَوَّاهِ",56,"ه",1,0],["خبِّريني مَا الَّذي خَلْفَ الغُيُومْ","رَبَّةَ الأَحْلامْ",57,"م",1,0],["خبير بقصر الأم يشكو لها الونى","بعينيه إلا أنه ليس يسأل",58,"ل",1,0],["خَبَتِ المَطالِعُ مِن أَغَرِّ مُؤَمَّلٍ","كَالفَجرِ ثَغراً وَالصَباحِ جَبينا",59,"ن",2,0],["خَبَّأَها كاهِنٌ","ناحِيَةً في الهَرَم",60,"م",1,0],["خَبَّأَ الشَيخُ لَها في رُدنِهِ","مِرقَماً أَدهى مِنَ الصِلِّ اِنسِيابا",61,"ب",2,0],["خَبَأتُ لِقَومِكَ ما يَستَقونَ","وَلا يَخبَأُ العَذبَ مِثلُ الحَجَر",62,"ر",1,0],["خَبَت نارُ حَربٍ لَم تَهِجها بَنانُهُ","وَأَسمَرُ عُريانٌ مِنَ القِشرِ أَصلَعُ",63,"ع",1,0],["خَبَّروهَا أنِّي مَرِضْتُ فقالتْ","أضنَىً طارِفاً شكا أم تليدَا",64,"د",2,1],["خبَتْ نارُ نفسي باشتعالِ مفارقي","وأظلمَ عُمري إذ أضاءَ شِهابُها",65,"ب",3,1],["خَبلٌ مِنَ الحُبِّ لَم يَزجُر سَفاهَتَهُ","حِلمٌ وَلَم يَتَدارَك غَيَّهُ رَشَدُ",66,"د",1,0],["خَبَرٌ مُبهِجٌ وَبُنيانُ يُمنٍ","في مُنيفٍ عِندَ السِماكِ مَشيدِ",67,"د",1,0],["خَبَرٌ ثَنى رُكَبَ الرِكابِ فَلَم يَدَع","لِلرَكبِ وَجهَ تَرَحُّلٍ فَأَقاموا",68,"م",3,0],["خَبَرٌ يَسوءُ الحاسِدينَ إِذا بَدا","وَأَعادَ فيهِ مُحَدِّثٌ أَو سامِعُ",69,"ع",1,0],["خَبَينَ بِهِم شَهراً إِلَيهِ وَدونَهُ","لَهُم رَصَدٌ يُخشى عَلى كُلِّ مَرقَبِ",70,"ب",1,0],["خَبَطنَ نِعالَ الجِلدِ حَتّى كَأَنَّها","شَراذيمُ في الأَرساغِ مِن خِرَقِ العُطبِ",71,"ب",1,0],["خَبَطتُ بِها الظَلماءَ حَتّى أَضائَها","عَمودُ ضِياءٍ بِالبَياضِ يَضيمُها",72,"م",3,0],["خَبيرٌ بِأَعمالِ الرِجالِ كَما جَزى","بِبَدرٍ وَبِاليَرموكِ فَيءَ جَنانِ",73,"ن",1,0],["خَبالٌ وَسُقمٌ مُضنِئٌ وَمَنِيَّةٌ","وَما غائِبٌ إِلّا كَآخَرَ شاهِدِ",74,"د",1,0],["خَبَّروني أَنَّ مِن ضَربِ السَنَه","جُدُداً بيضاً وَصُفراً حَسَنَه",75,"ه",1,1],["خَبيرٌ بِأَمرِ المُلكِ عَدلُكَ باسِطٌ","وَعِلمُكَ فَيّاضٌ وَحِلمُكَ راسِخُ",76,"خ",1,0],["خَبَّروني عَنّي بِما لَستُ أَدري","مِن أُمورٍ أَبدَيتُ في حالِ سُكري",77,"ر",2,1],["خَبَرتُ مَرامي أَرضِها فَقَتَلتُها","وَما يَقتُلُ الأَرضينَ إِلّا خَبيرُها",78,"ر",3,0],["خبأتُها حيث إذا","جُنَّ الهوى رأيتها",79,"ت",3,0],["خبأن نصفا في الدجى","وجلون نصفا لامعا",80,"ع",2,0],["خبيئةُ دنّ سناها المنيرُ","محيطٌ به قارها المظلمُ",81,"م",1,0],["خَبَرٌ جَلا صَدَأَ القُلوبِ ضِياؤُهُ","إِذ لاحَ أَنَّ الصِدقَ مِنهُ نَهارُ",82,"ر",1,0],["خَبُثْتَ فَلَوْ طُهِّرْتَ بِالْمَاءِ لاكْتَسَى","بِكَ الْمَاءُ خُبْثاً لا يَحِلُّ بِهِ الْغَسْلُ",83,"ل",1,0],["خبيرٌ بالمعالي والمعاني","قليلُ الخبرِ في كأسٍ ودَنِّ",84,"ن",1,0],["خبا من العمر نوءٌ كان يَرزُمنا","وغابَ نجمُ شبابٍ كان يَهدينا",85,"ن",2,0],["خبيث الكيل في شركٍ خفيٍّ","يصيدُ عوالماً فيما يصيد",86,"د",1,0],["خَبِّرينا بِما كَتَبتِ إِلَينا","أَهُوَ الحَقُّ أَم تَهَزَّأتِ مِنّا",87,"ن",2,0],["خَبَّروها بِأَنَّني قَد تَزَوَّج","تُ فَظَلَّت تُكاتِمُ الغَيظَ سِرّا",88,"ر",2,1],["خُبِّرتُ ما قالَت فَبِتُّ كَأَنَّما","رُمِيَ الجَشا بِنَوافِذِ النُشّابِ",89,"ب",1,0],["خَبَطَ البِلادَ يَمُرُّ غَيرَ مُغَيِّمٍ","في حالَةٍ وَيَصوبُ صَوبَ مُدَيِّمِ",90,"م",1,0],["خُبَيْبٌ في يَدَيْ جافٍ شديدٍ","يُعذَّبُ في أداهمِهِ الثِّقالِ",91,"ل",1,0],["خَبَرٌ ما نابَنا مُصمَإِلٌّ","جَلَّ حَت