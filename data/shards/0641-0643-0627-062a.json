{"poems":[[95,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[87,"كتاب مصر اثنان في آرائنا","https://www.aldiwan.net/poem7559.html","الرجز"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[415,"ما منهم لك معتاض ولا خلف","https://www.aldiwan.net/poem32425.html","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46539","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89527","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121198","البسيط"],[4551,"","https://poetry.dctabudhabi.ae/diwan/poem/139874",""],[402,"سوى الحب لا تشفي الفؤاد المكلما","https://www.poetsgate.com/ViewPoem.aspx?id=36334",""]],"verses":[["فَكَاتِبَهَا يَشْكثو إِلَيْهَا عَذَابهُ","وَيَرْجُو ذَلِيلاً أَنْ تَرِقَّ وَتَزْحَمَا",0,"م",2,0],["فكاتب يقام إجلالا له","وكاتب لا نستحى أن نصفعه",1,"ه",1,0],["فكاتَبَ الإمامَ بالإِجابَه","والسَّمْعِ والطَّاعةِ والإنابَه",2,"ه",1,0],["فكاتِبِ الإِخوانا","ولا تكُن خَوّانا",3,"ن",2,0],["فَكاتِمُ الحُبِّ إن لم يَقْضِ من كَمدٍ","فإنّه لإصابَاتِ الرّدَى هَدَفُ",4,"ف",1,0],["فَكاتب الرَّسائل","وال عَلى المقاتل",5,"ل",1,0],["فَكاتب القادر بِالحَقيقه","فَأخَذَت خيولَهُ طَريقه",6,"ه",1,0],["فَكاتَمتُهُم ما بي وَبِالقَلبِ لَوعَةٌ","إِذا اِضطَرَمَت تَنقَدُّ مِنه أَضالِعُه",7,"ع",2,0],["فكاتب الحسنات الخير اتعبه","اما اخوه فما املى ولا كتبا",8,"ب",2,0],["فكاتمه المكنون ثم تكاتمت","جوانحه فالكل من بثه صفر",9,"ر",1,0],["فكاتبها يشكو غليها عذابة","ويرجو ذليلا أن ترق وترحما",10,"م",2,0]]}