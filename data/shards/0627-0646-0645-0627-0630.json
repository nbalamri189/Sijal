{"poems":[[41,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141956","الخفيف"],[193,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[548,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[563,"لي وجود بمن يقول أنا","https://www.aldiwan.net/poem33776.html","الخفيف"],[563,"قد أحاط الوجود بالأشياء","https://www.aldiwan.net/poem35081.html","الخفيف"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26447","الرمل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82991","الخفيف"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/130031","الرمل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77054","الخفيف"],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33804","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204303",""],[5194,"كل لحظه","https://www.poetsgate.com/ViewPoem.aspx?id=32376",""],[5559,"من يرد للقدس نصرا","https://www.poetsgate.com/ViewPoem.aspx?id=204217",""]],"verses":[["إِنَّما ذِكرُكَ ما قَد مَضى","ضَلَّةٌ مِثلُ حَديثِ المَنام",0,"م",1,0],["انما ذاك يرفع الصوت في النا","دي وهذا يلقي عليها ستارا",1,"ر",2,0],["إنّما ذلكَ مِن فعلِ القدير","مَن برا كلّ الورى عزّ وجل",2,"ل",1,0],["إِنَّما ذِكرُكَ شَيئاً قَد مَضى","حُلُمٌ لَم يرجِعِ الحُلمَ اِدِّكارُ",3,"ر",1,0],["إنما ذاك واحد أحد","حاش لله أن أكون أنا",4,"ن",2,0],["إنما ذاك جاء في الذكر يتلى","وهو حق في مذهب الأولياء",5,"ا",2,0],["إِنَّما ذَنبي إِلَيهِنَّ المَشيبُ","فَمَتى يَعفونَ أَم كَيفَ أَتوبُ",6,"ب",1,1],["إِنَّما ذا زَمانُ كدحٍ إِلى المو","تِ وقوتٍ مبلّغٍ وَالسَلامُ",7,"م",1,0],["إنّما ذلك سحرٌ","أصله من ناظرَيهِ",8,"ه",1,0],["اِنَّما ذي حِكمَةٌ قَد شاءَها","رَبُّنا سُبحانَهُ مُنذُ الاِزَل",9,"ل",1,0],["إِنَّما ذا جُهدُ المَقلّ وَمن جا","دَ بَمَوجودِهِ فَقد جادَ جَدا",10,"د",2,0],["إِنَّما ذاكَ كُلُّهُ","دَمعُ عَيني تَحَدَّرا",11,"ر",2,0],["إنما ذلك فيه","صنعة الله اللطيفة",12,"ف",2,0],["إن ما ذكرتك كل لحظه وساعه","وإلا تراني مرخصك عكس مغليك",13,"ك",1,1],["إنّما ذا العبد فحل","بالتباري والكفاح",14,"ح",1,0]]}