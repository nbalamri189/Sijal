الرجز"],[506,"فلسفة","https://www.aldiwan.net/poem27794.html","الخفيف"],[506,"التّرِكة","https://www.aldiwan.net/poem42458.html","الرمل"],[515,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[516,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[516,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[516,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[541,"أم لا تذكر سلمى وهي نازحة","https://www.aldiwan.net/poem56896.html","البسيط"],[552,"أما ترى الدهر مسلولا صوارمه","https://www.aldiwan.net/poem47266.html","البسيط"],[552,"أمللتني وزعمت أن","https://www.aldiwan.net/poem47306.html","مجزوء الكامل"],[554,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[554,"أيا سرور وأنت يا حزن","https://www.aldiwan.net/poem68412.html","المنسرح"],[554,"أغرى به الشوق ليل الساهر الرمد","https://www.aldiwan.net/poem68425.html","البسيط"],[559,"طلعت شمس الوجود","https://www.aldiwan.net/poem34655.html","مجزوء الرمل"],[563,"أملاك نور لميخائيل معتنقه","https://www.aldiwan.net/poem52696.html","البسيط"],[563,"بغداد أيتها الركاب فبادري","https://www.aldiwan.net/poem52940.html","الكامل"],[568,"أي أب رزيته","https://www.aldiwan.net/poem69562.html","مجزوء الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[587,"أمل سعيت أجد في إتمامه","https://www.aldiwan.net/poem17764.html","الكامل"]],"verses":[["أَمُلتَمِساً مِنّي صَديقاً لِنَوبَةٍ","وَأَنتَ صَديقي لا أَرى لَكَ ثانِيا",0,"ي",2,1],["أَمِل مِن مَثانيها فَهَذا مَقيلُها","وَهَذي مَغاني دارِهِم وَطُلولُها",1,"ل",3,1],["أَمَلٌ جَثا بِفِناءِ دارِكَ قاطِناً","وَكَأَنَّهُ بِفِناءِ وادٍ مُبقِلِ",2,"ل",1,0],["أملأ التاريخ لحنا وصدى","وتغني في ربا الخلد ربابي",3,"ب",2,0],["أمْلاكُ صِدْقٍ جاهدوا في العِدَى","وصيّروا أمْلاكَها خُضَّعا",4,"ع",2,0],["أَمَلِي مِنَ الدُّنْيَا تَأَتِّي خَلْوَةٍ","فِي مَنْزلٍ بَادٍ خَصِيبِ الْجَانِبِ",5,"ب",1,1],["أَم لِلدَلالِ فَإِنَّ الفَتا","ةَ حَقٌّ عَلى الشَيخِ إِدلالُها",6,"ل",3,0],["أَم لاذَ مُعتَصِماً بِكُر","سِيِّ المُهَيمِنِ وَاِستَجار",7,"ر",1,0],["أَمَّلوا ما لَيسَ يُمنى","وَرَجَوا ما لا يَكونُ",8,"ن",1,0],["أَمَلٌ تَعَرَّضَتِ المَنَايَا دُونَهُ","فَمَضَى وَمَا يَثْنِيهِ عَنْهُ ثَانِ",9,"ن",1,0],["أم ليس يعلم أنني أحببته","حُباً أذبت بناره سلواني",10,"ن",2,0],["أَم لِلقَناةِ إِذا ما عَيَّ قائِلُها","أَم لِلأَعِنَّةِ يا عُقبَ بنَ عَمّارِ",11,"ر",1,0],["أم لشيب علا المفارق بيع","بالشباب المُرَجِّلِ الذيَّالِ",12,"ل",1,0],["أمّل عطاياه وأستعرض فضائله","فما يردّ جناه كفّ مقتطف",13,"ف",1,0],["أملت على الزّهر المقطب ذكركم","حتَّى تبسم ضاحكاً من قولها",14,"ه",2,0],["أمَّلْتُ منْ رفد سُلَيْمانِكُمْ","ما أمَّلَ المعتزُّ مِنْ نُصْرَتِهْ",15,"ه",1,0],["أم ليس مستأهِلاً جدواه صاحِبُهُ","أنَّى وما حاد عن قصدٍ ولا عَنَدا",16,"د",2,0],["أم ليس يُمْكِنُه ما يرتضيه له","يكفي أخاً من أخٍ ميسورُ ما وَجدا",16,"د",2,0],["أملي فيه ليأسي قاهرُ","فلذا قلبي عليه صابرُ",17,"ر",1,1],["أمْلَتْ له الأحداثُ حتى عَنَّسا","ببطن وادٍ وَحَدا فيه خَسا",18,"س",2,0],["أملَّ الليلَ يعقدُها بضربٍ","فجاءَ بها تمدَّد كالخيوطِ",19,"ط",1,0],["أمَّل القومُ ثوبةَ البُدنِ فيهنْ","نَ فأعجلن ثوبةَ الأبوالِ",20,"ل",1,0],["أم لذنبٍ نبوْتَ عني فلِمْ با","ن اكتسابُ الذنوبِ للأطفالِ",20,"ل",1,0],["أمَلُ الآملينَ إيَّاه زُلْفَى","لهمُ عنده وحَبْلُ اعتصام",21,"م",1,0],["أم لا فعبدُك باسطٌ لك عذرَه","إمَّا أبيتَ ولائمٌ حرمانَهُ",22,"ن",2,0],["أَمَلتَ بِهِ شِمالَكَ مِن بَعيدٍ","يَكادُ مِنَ الفَراغَةِ يُستَطارُ",23,"ر",1,0],["أُمُّ لَئيمَةُ نَجلِ الفَحلِ مُقرِفَةٌ","أَدَّت لِفَحلٍ لَئيمِ النَجلِ شَخّارِ",24,"ر",1,0],["أَمَلُ الشَبيبَةِ في يَدَيكَ وَديعَةٌ","فَاِرفَع لَها الأَخلاق وَالآدابا",25,"ب",2,0],["أُمَلِّكُ عَنهُ النَفسَ في قُربِهِ","خَوفاً مِنَ الوَحشَةِ في صَدِّهِ",26,"د",2,0],["أَمَلي فيكَ دونَهُ سَيفُ لَحظٍ","ذاكَ مُستَقبَلٌ وَهَذاكَ ماضي",27,"ض",2,0],["أَمَّلتُ خَيرَكِ هَل تَأتي مَواعِدُهُ","فَاليَومَ قَصَّرَ عَن تِلقائِكِ الأَمَلُ",28,"ل",1,0],["إِملأْ طريقي بالمخاوفِ والدُّجى","وزوابعِ الأَشواكِ والحصباءِ",29,"ا",2,0],["ام لا ينال العزة","القعساء الا الابكم",30,"م",1,0],["امل ذاهب وجهد مضاع","وشياه غرقى وشمل شتيت",31,"ت",1,0],["أملط يا رب كما خلقتني","راض على قلة ما رزقتني",32,"ي",1,0],["أم للمواقف لم يقفها ضيغم","لولاك لاضربت لها الأهرام",33,"م",1,0],["أَملاكُ مِصرَ القاهِرونَ عَلى الوَرى","المُنزَلونَ مَنازِلَ الأَقمارِ",34,"ر",1,0],["أَمَلٌ بَذَلتُم كُلَّ غالٍ دونَهُ","وَفَقَدتُمُ ما عَزَّ في وُجدانِهِ",35,"ن",2,0],["أَمُلكُكَ يا داوُدُ وَالمُلكُ الَّذي","يَغارُ عَلَيهِ وَالَّذي هُوَ واهِبُه",36,"ب",2,0],["أَملى عَلَيهِ الهَوى وَالحِقدُ فَاِندَفَعَت","يَداهُ تَرتَجِلانِ الماءَ وَاللَهَبا",37,"ب",2,0],["أَم لَيسَ ضَرّابَ كُلِّ جُمجُمَةٍ","مَنخُوَّةٍ ساعَةَ الوَغى زَعِلَه",38,"ل",2,0],["أَمَّلتُ ساعَةَ ساروا كَشفَ مِعصَمِها","لِيَلبَثَ الحَيُّ دونَ السَيرِ حَيرانا",39,"ن",2,0],["أَمَلٌ يُطيفُ الراغِبونَ بِظِلِّهِ","وَمَعاذُ خائِفَةِ القُلوبِ النُفَّرِ",40,"ر",1,0],["أَمَلي فيكُمُ وَحَقّي عَلَيكُم","وَرَواحي إِلَيكُمُ وَاِبتِكاري",41,"ر",2,0],["أَمَلي في الغُلامِ كانَ غُلاماً","فَهوَ كَهلٌ لِلمَطلِ وَالتَعويقِ",42,"ق",1,0],["أَمَلٌ تَرَجَّحَ بَينَ عامٍ أَوَّلٍ","في أَن أَراكِ وَبَينَ عامٍ قابِلِ",43,"ل",1,0],["أَم لا تُقارِبُ لَيلى مَن يُقارِبُها","وَلا تُداني بِوَصلٍ مَن يُدانيها",44,"ي",3,0],["أم لِطَيْفٍ أعلَّه الشَّوقُ حتَّى","زارَ تحتَ الدُّجى عَليلَ اشتياقِ",45,"ق",1,0],["أمَلِي في المُلوكِ عُسْرٌ ولكنْ","أملي في أبي المرجَّى اليَسارُ",46,"ر",1,0],["أَم لَستَ تَحسَبُهُ عَلَيكَ مُسَلَّطاً","وَبَلى وَرَبِّكَ إِنَّهُ لَمُسَلَّطُ",47,"ط",1,0],["أَمَّلتَ أَكثَرَ مِمّا أَنتَ مُدرِكُهُ","وَالعُمرُ لا بُدَّ أَن يَفنى وَإِن طالا",48,"ل",2,0],["أَم لا فَفيمَ جَفَوتِني وَظَلَمتِني","وَجَعَلتِني لِلعالَمينَ نَكالا",49,"ل",2,0],["أُمَلِّكُهُ قِيادي وَهوَ رِقّي","وَأَفديهِ بِعَيني وَهوَ ساقي",50,"ي",1,0],["أملٌ على أملٍ وآخرةُ المنى","نومٌ على نومٍ مَدَى الأحقابِ",51,"ب",1,0],["أملٌ ضائعٌ ولبٌّ مشرَّد","بين حبٍّ طغى وجُرحٍ تمرّد",52,"د",1,1],["أمَلٌ وعِدت بهِ وأَوعدَني الرّدى","فَبِهِ يُجَذّ الوعدُ بالإِيعادِ",53,"د",1,0],["إِمليسُهُ إِمليدُهُ لَو عُلِّقَت","في صَهوَتَيهِ العَينُ لَم تَتَعَلَّقِ",54,"ق",1,0],["أَمَلٌ أَناخَ بِهِم وُفوداً فَاِغتَدَوا","مِن عِندِهُ وَهُمُ مُناخُ وُفودِ",55,"د",1,0],["أُمٌّ لَهُم لَو رَجَوا أَن تُفتَدى جَعَلوا","فِداءَها كُلَّ أُمٍّ مِنهُمُ وَأَبِ",56,"ب",1,0],["أَم لِقَولٍ قالَهُ كاشِحٌ","كاذِبٌ يا لَيتَهُ قُبِرا",57,"ر",2,0],["أملٌ تَلوذُ به الكنانةُ صادقٌ","إن راحتِ الآمالُ وهي كواذبُ",58,"ب",1,0],["أملٌ يَزُفُّ مع السَنين عروسا","فيشوقهنَّ أهلَّةً وشُموسا",59,"س",2,1],["امْلكِي الأرضَ وَسُودِي الأُممَا","إنّه الحكمُ الذي أَمْضَى عُمَرْ",60,"ر",1,0],["أمٌّ لها مُلكٌ تَمكّنَ عرشُه","في دولةٍ من مَحْتِدٍ ونِصالِ",61,"ل",1,0],["أَمَلَكتَ ما بَينَ البَقيعِ فَجُدَّةٍ","وَأَبَحتَ جَيشَكَ ما وَراءَ مَعانِ",62,"ن",1,0],["املَأوا الأَرضَ يا بَني النيلِ سَعياً","وَاِغمُروا العالَمينَ عِلماً وَفَضلا",63,"ل",2,0],["أملى لهم حتّى إذا بلغوا المدَى","ألْوَى بهم خَطبٌ يجلُّ ويَفدحُ",64,"ح",1,0],["إملإِ الأرضَ يا مُحمّدُ نُورا","وَاغْمرِ النّاسَ حِكمةً والدُّهورا",65,"ر",2,1],["أم لابتِدَاءِ صَبَابَاتِ المُتَيَّمِ أم","لِمِلكِ مُهجَتهِ لِلعَينِ إذ رَمقَت",66,"ت",1,0],["أم لاختِصَاصِي بِنَبلٍ من لوَاحِظِهِ","أم لاستِغَاثَةِ قَلبِي منهُ إذ رَشقَت",66,"ت",1,0],["أم للإضافَةِ مِن ذُلِيِّ لِعِزَّتِهِ","يَا لَيتَ شِعرِيَ أم لِلعهدِ لو صَدَقَت",66,"ت",1,0],["أملٌ يلوحُ بريقهُ","فَاستَهْدِ يا هذا بَريقَهْ",67,"ه",1,0],["أَمْ لِكَوْني في إثْر كلِّ صَلاةٍ","بيَ يُدْعَى لِدَوْلَة السُّلْطانِ",68,"ن",1,0],["أَم لا فَفي أَيِّ شَيءٍ","هَجَرتِني خَبِّرينا",69,"ن",2,0],["أَمَلوا وَخافوا مِن حَياتِهِمُ","وَعراً فَما وَأَلوا مِنَ الوَعرِ",70,"ر",1,0],["أَملَسُ لا يُهدى بِهِ مُهَدِّ","حَتّى اِنتَهى مِثلَ صَليفِ القِدِّ",71,"د",1,0],["آمُلُ العَيشَ تارَةً","وَأَرى المَوتَ أَسوَدا",72,"د",2,0],["أَملَحُ الناسِ جَميعاً","سافِراً أَو في نِقابِ",73,"ب",1,0],["أَمَلي بَياضُ الصُبحِ أَنبَتَهُ","وَعَهِدتُه بِالأَمسِ مُنجَذّا",74,"ذ",2,0],["أَمَلٌ تَعَلَّقَ بِالنُجومِ فَلا تَقُل","عِندَ النَعامِ وَلا مَعَ الأَغفارِ",75,"ر",1,0],["أُمٌّ لَهُ أَكلَتُهُ طالَما بَذَلَت","لَهُ مَآكِلَ مِن زَرعٍ وَمُغتَرِسِ",76,"س",1,0],["أَمَلٌ أُحصِدَ لا تُرسِلُهُ","كَفُّ حَيٍّ فَإِذا ماتَ اِنقَطَع",77,"ع",1