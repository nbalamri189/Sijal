","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[106,"بطل الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179585",""],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[106,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[77,"ما ضر لو سلم أو ودعا","https://www.poetsgate.com/ViewPoem.aspx?id=34175",""],[98,"الدول العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=55340",""],[98,"مصرع النسر","https://www.poetsgate.com/ViewPoem.aspx?id=55338",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"عُدنا وقودا","https://www.poetsgate.com/ViewPoem.aspx?id=179221",""],[90,"جناية الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=178941",""],[97,"غيوم","https://www.poetsgate.com/ViewPoem.aspx?id=25526",""],[105,"لبيك من حر المواقف عال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55000&r=&rc=170",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[88,"برزت تميس كخطرة النشوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19539&r=&rc=42",""],[18,"كُنَّا نَغَارُ عَلَى الْعَوَاتِقِ أَنْ تَرَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26470&r=&rc=36",""]],"verses":[["أَمُلتَمِساً مِنّي صَديقاً لِنَوبَةٍ","وَأَنتَ صَديقي لا أَرى لَكَ ثانِيا",0,"ي",2,1],["أَمِل مِن مَثانيها فَهَذا مَقيلُها","وَهَذي مَغاني دارِهِم وَطُلولُها",1,"ل",3,1],["أَمَلٌ جَثا بِفِناءِ دارِكَ قاطِناً","وَكَأَنَّهُ بِفِناءِ وادٍ مُبقِلِ",2,"ل",1,0],["أملأ التاريخ لحنا وصدى","وتغني في ربا الخلد ربابي",3,"ي",1,0],["أمْلاكُ صِدْقٍ جاهدوا في العِدَى","وصيّروا أمْلاكَها خُضَّعا",4,"ع",2,0],["أَمَلِي مِنَ الدُّنْيَا تَأَتِّي خَلْوَةٍ","فِي مَنْزلٍ بَادٍ خَصِيبِ الْجَانِبِ",5,"ب",1,1],["أَم لِلدَلالِ فَإِنَّ الفَتا","ةَ حَقٌّ عَلى الشَيخِ إِدلالُها",6,"ل",3,0],["أَم لاذَ مُعتَصِماً بِكُر","سِيِّ المُهَيمِنِ وَاِستَجار",7,"ر",1,0],["أَمَّلوا ما لَيسَ يُمنى","وَرَجَوا ما لا يَكونُ",8,"ن",1,0],["أَمَلٌ تَعَرَّضَتِ المَنَايَا دُونَهُ","فَمَضَى وَمَا يَثْنِيهِ عَنْهُ ثَانِ",9,"ن",1,0],["أم ليس يعلم أنني أحببته","حُباً أذبت بناره سلواني",10,"ن",2,0],["أَم لِلقَناةِ إِذا ما عَيَّ قائِلُها","أَم لِلأَعِنَّةِ يا عُقبَ بنَ عَمّارِ",11,"ر",1,0],["أم لشيب علا المفارق بيع","بالشباب المُرَجِّلِ الذيَّالِ",12,"ل",1,0],["أمّل عطاياه وأستعرض فضائله","فما يردّ جناه كفّ مقتطف",13,"ف",1,0],["أملت على الزّهر المقطب ذكركم","حتَّى تبسم ضاحكاً من قولها",14,"ه",2,0],["أمَّلْتُ منْ رفد سُلَيْمانِكُمْ","ما أمَّلَ المعتزُّ مِنْ نُصْرَتِهْ",15,"ه",1,0],["أم ليس مستأهِلاً جدواه صاحِبُهُ","أنَّى وما حاد عن قصدٍ ولا عَنَدا",16,"د",2,0],["أم ليس يُمْكِنُه ما يرتضيه له","يكفي أخاً من أخٍ ميسورُ ما وَجدا",16,"د",2,0],["أملي فيه ليأسي قاهرُ","فلذا قلبي عليه صابرُ",17,"ر",1,1],["أمْلَتْ له الأحداثُ حتى عَنَّسا","ببطن وادٍ وَحَدا فيه خَسا",18,"س",2,0],["أملَّ الليلَ يعقدُها بضربٍ","فجاءَ بها تمدَّد كالخيوطِ",19,"ط",1,0],["أمَّل القومُ ثوبةَ البُدنِ فيهنْ","نَ فأعجلن ثوبةَ الأبوالِ",20,"ل",1,0],["أم لذنبٍ نبوْتَ عني فلِمْ با","ن اكتسابُ الذنوبِ للأطفالِ",20,"ل",1,0],["أمَلُ الآملينَ إيَّاه زُلْفَى","لهمُ عنده وحَبْلُ اعتصام",21,"م",1,0],["أم لا فعبدُك باسطٌ لك عذرَه","إمَّا أبيتَ ولائمٌ حرمانَهُ",22,"ن",2,0],["أَمَلتَ بِهِ شِمالَكَ مِن بَعيدٍ","يَكادُ مِنَ الفَراغَةِ يُستَطارُ",23,"ر",1,0],["أُمُّ لَئيمَةُ نَجلِ الفَحلِ مُقرِفَةٌ","أَدَّت لِفَحلٍ لَئيمِ النَجلِ شَخّارِ",24,"ر",1,0],["أَمَلُ الشَبيبَةِ في يَدَيكَ وَديعَةٌ","فَاِرفَع لَها الأَخلاق وَالآدابا",25,"ب",2,0],["أُمَلِّكُ عَنهُ النَفسَ في قُربِهِ","خَوفاً مِنَ الوَحشَةِ في صَدِّهِ",26,"د",2,0],["أَمَلي فيكَ دونَهُ سَيفُ لَحظٍ","ذاكَ مُستَقبَلٌ وَهَذاكَ ماضي",27,"ي",1,0],["أَمَّلتُ خَيرَكِ هَل تَأتي مَواعِدُهُ","فَاليَومَ قَصَّرَ عَن تِلقائِكِ الأَمَلُ",28,"ل",1,0],["إِملأْ طريقي بالمخاوفِ والدُّجى","وزوابعِ الأَشواكِ والحصباءِ",29,"ا",2,0],["ام لا ينال العزة","القعساء الا الابكم",30,"م",1,0],["امل ذاهب وجهد مضاع","وشياه غرقى وشمل شتيت",31,"ت",1,0],["أملط يا رب كما خلقتني","راض على قلة ما رزقتني",32,"ي",1,0],["أم للمواقف لم يقفها ضيغم","لولاك لاضربت لها الأهرام",33,"م",1,0],["أَملاكُ مِصرَ القاهِرونَ عَلى الوَرى","المُنزَلونَ مَنازِلَ الأَقمارِ",34,"ر",1,0],["أَمَلٌ بَذَلتُم كُلَّ غالٍ دونَهُ","وَفَقَدتُمُ ما عَزَّ في وُجدانِهِ",35,"ن",2,0],["أَمُلكُكَ يا داوُدُ وَالمُلكُ الَّذي","يَغارُ عَلَيهِ وَالَّذي هُوَ واهِبُه",36,"ب",2,0],["أَملى عَلَيهِ الهَوى وَالحِقدُ فَاِندَفَعَت","يَداهُ تَرتَجِلانِ الماءَ وَاللَهَبا",37,"ب",2,0],["أَم لَيسَ ضَرّابَ كُلِّ جُمجُمَةٍ","مَنخُوَّةٍ ساعَةَ الوَغى زَعِلَه",38,"ل",2,0],["أَمَّلتُ ساعَةَ ساروا كَشفَ مِعصَمِها","لِيَلبَثَ الحَيُّ دونَ السَيرِ حَيرانا",39,"ن",2,0],["أَمَلٌ يُطيفُ الراغِبونَ بِظِلِّهِ","وَمَعاذُ خائِفَةِ القُلوبِ النُفَّرِ",40,"ر",1,0],["أَمَلي فيكُمُ وَحَقّي عَلَيكُم","وَرَواحي إِلَيكُمُ وَاِبتِكاري",41,"ر",2,0],["أَمَلي في الغُلامِ كانَ غُلاماً","فَهوَ كَهلٌ لِلمَطلِ وَالتَعويقِ",42,"ق",1,0],["أَمَلٌ تَرَجَّحَ بَينَ عامٍ أَوَّلٍ","في أَن أَراكِ وَبَينَ عامٍ قابِلِ",43,"ل",1,0],["أَم لا تُقارِبُ لَيلى مَن يُقارِبُها","وَلا تُداني بِوَصلٍ مَن يُدانيها",44,"ي",3,0],["أم لِطَيْفٍ أعلَّه الشَّوقُ حتَّى","زارَ تحتَ الدُّجى عَليلَ اشتياقِ",45,"ق",1,0],["أمَلِي في المُلوكِ عُسْرٌ ولكنْ","أملي في أبي المرجَّى اليَسارُ",46,"ر",1,0],["أَم لَستَ تَحسَبُهُ عَلَيكَ مُسَلَّطاً","وَبَلى وَرَبِّكَ إِنَّهُ لَمُسَلَّطُ",47,"ط",1,0],["أَمَّلتَ أَكثَرَ مِمّا أَنتَ مُدرِكُهُ","وَالعُمرُ لا بُدَّ أَن يَفنى وَإِن طالا",48,"ل",2,0],["أَم لا فَفيمَ جَفَوتِني وَظَلَمتِني","وَجَعَلتِني لِلعالَمينَ نَكالا",49,"ل",2,0],["أُمَلِّكُهُ قِيادي وَهوَ رِقّي","وَأَفديهِ بِعَيني وَهوَ ساقي",50,"ي",1,0],["أملٌ على أملٍ وآخرةُ المنى","نومٌ على نومٍ مَدَى الأحقابِ",51,"ب",1,0],["أملٌ ضائعٌ ولبٌّ مشرَّد","بين حبٍّ طغى وجُرحٍ تمرّد",52,"د",1,1],["أمَلٌ وعِدت بهِ وأَوعدَني الرّدى","فَبِهِ يُجَذّ الوعدُ بالإِيعادِ",53,"د",1,0],["إِمليسُهُ إِمليدُهُ لَو عُلِّقَت","في صَهوَتَيهِ العَينُ لَم تَتَعَلَّقِ",54,"ق",1,0],["أَمَلٌ أَناخَ بِهِم وُفوداً فَاِغتَدَوا","مِن عِندِهُ وَهُمُ مُناخُ وُفودِ",55,"د",1,0],["أُمٌّ لَهُم لَو رَجَوا أَن تُفتَدى جَعَلوا","فِداءَها كُلَّ أُمٍّ مِنهُمُ وَأَبِ",56,"ب",1,0],["أَم لِقَولٍ قالَهُ كاشِحٌ","كاذِبٌ يا لَيتَهُ قُبِرا",57,"ر",2,0],["أملٌ تَلوذُ به الكنانةُ صادقٌ","إن راحتِ الآمالُ وهي كواذبُ",58,"ب",1,0],["أملٌ يَزُفُّ مع السَنين عروسا","فيشوقهنَّ أهلَّةً وشُموسا",59,"س",2,1],["امْلكِي الأرضَ وَسُودِي الأُممَا","إنّه الحكمُ الذي أَمْضَى عُمَرْ",60,"ر",1,0],["أمٌّ لها مُلكٌ تَمكّنَ عرشُه","في دولةٍ من مَحْتِدٍ ونِصالِ",61,"ل",1,0],["أَمَلَكتَ ما بَينَ البَقيعِ فَجُدَّةٍ","وَأَبَحتَ جَيشَكَ ما وَراءَ مَعانِ",62,"ن",1,0],["املَأوا الأَرضَ يا بَني النيلِ سَعياً","وَاِغمُروا العالَمينَ عِلماً وَفَضلا",63,"ل",2,0],["أملى لهم حتّى إذا بلغوا المدَى","ألْوَى بهم خَطبٌ يجلُّ ويَفدحُ",64,"ح",1,0],["إملإِ الأرضَ يا مُحمّدُ نُورا","وَاغْمرِ النّاسَ حِكمةً والدُّهورا",65,"ر",2,1],["أم لابتِدَاءِ صَبَابَاتِ المُتَيَّمِ أم","لِمِلكِ مُهجَتهِ لِلعَينِ إذ رَمقَت",66,"ت",1,0],["أم لاختِصَاصِي بِنَبلٍ من لوَاحِظِهِ","أم لاستِغَاثَةِ قَلبِي منهُ إذ رَشقَت",66,"ت",1,0],["أم للإضافَةِ مِن ذُلِيِّ لِعِزَّتِهِ","يَا لَيتَ شِعرِيَ أم لِلعهدِ لو صَدَقَت",66,"ت",1,0],["أملٌ يلوحُ بريقهُ","فَاستَهْدِ يا هذا بَريقَهْ",67,"ه",1,0],["أَمْ لِكَوْني في إثْر كلِّ صَلاةٍ","بيَ يُدْعَى لِدَوْلَة السُّلْطانِ",68,"ن",1,0],["أَم لا فَفي أَيِّ شَيءٍ","هَجَرتِني خَبِّرينا",69,"ن",2,0],["أَمَلوا وَخافوا مِن حَياتِهِمُ","وَعراً فَما وَأَلوا مِنَ الوَعرِ",70,"ر",1,0],["أَملَسُ لا يُهدى بِهِ مُهَدِّ","حَتّى اِنتَهى مِثلَ صَليفِ القِدِّ",71,"د",1,0],["آمُلُ العَيشَ تارَةً","وَأَرى المَوتَ أَسوَدا",72,"د",2,0],["أَملَحُ الناسِ جَميعاً","سافِراً أَو في نِقابِ",73,"ب",1,0],["أَمَلي بَياضُ الصُبحِ أَنبَتَهُ","وَعَهِدتُه بِالأَمسِ مُنجَذّا",74,"ذ",2,0],["أَمَلٌ تَعَلَّقَ بِالنُجومِ فَلا تَقُل","عِندَ النَعامِ وَلا مَعَ الأَغفارِ",75,"ر",1,0],["أُمٌّ لَهُ أَكلَتُهُ طالَما بَذَلَت","لَهُ مَآكِلَ مِن زَرعٍ وَمُغتَرِسِ",76,"س",1,0],["أَمَلٌ أُحصِدَ لا تُرسِلُهُ","كَفُّ حَيٍّ فَإِذا ماتَ اِنقَطَع",77,"ع",1,0],["أَمَلتَها لِلمَغاني وَالغِنى زَمَناً","فَلَم تَنَل مِن يَسارٍ أَو هَوىً أَمَلَك",78,"ك",1,0],["أَمَلَّني الدَهرُ بِأَحداثِهِ","فَاِشتَقتُ في بَطنِ الثَرى مَنزِلا",79,"ل",2,0],["أَمَلَّ حَبيبٌ أَدَلَّ","وَسِترُ الضَلالِ اِنسَدَل",80,"ل",1,1],["أُمٌّ لَنا ما فَتِئنا عائِبينَ لَها","فَاِشتَطَّ لاحٍ لَحاها في تَجافيها",81,"ي",3,0],["أَمَلي أَن يعود ذاكَ الماضي","غامراً لي بسيبه الفياضِ",82,"ض",1,1],["أَمَللت ضوضاء الحياة لطولها","فنزلت داراً ما بها ضوضاء",83,"ا",2,0],["أمَّلتُ بالأمس عن بعدٍ زيارتها","فواصلت فوق ما أمَّلتُ عن كثب",84,"ب",1,0],["إملأي الأرضَ من حدادٍ وغيهبْ","مالَ نجمُ البيان عنكِ وغرَّبْ",85,"ب",1,1],["أملٌ محا المقدارُ طيفَ خيالهِ","وتخطّفَتْهُ يد الزمان الجائرِ",86,"ر",1,0],["أَم لِلمَواقِفِ لَم يَقِفها ضَيغَمٌ","لَولاكَ لَاِضطَرَبَت لَهُ الأَهرامُ",87,"م",1,0],["أمل ابيض الخلال رفيع","صغرته الأذلة الأشقياء",88,"ا",2,0],["أَمَلْتُ رَجَائِي فِي غَدٍ فَانْتَظَرْتُهُ","فَمَا جَاءَ حَتَّى طَالَ حُزْنِي عَلَى أَمْسِي",89,"ي",1,1],["أَمْلَتْ عَلَيَّ قَصِيدَةً فَجَعَلْتُهَا","لِشَكِيبَ تُحْفَةَ صَادِقٍ لَمْ يَدَّعِ",90,"ع",1,0],["أَمْلَتْ عَلَيَّ بِلَحْظَيْهَا حَدِيثَ هَوىً","عَرَفْتُ مِنْهُ ضَمِيرَ الْعَينِ بِالأَثَرِ",91,"ر",1,0],["امْلإِ الْقدَحْ","واعْصِ مَنْ نَصَحْ",92,"ح",1,1],["أَمُلْحِمُ جِزْتَ كِفاحَ الصِّعَابِ","بِغْيرِ تبَاهٍ وَغيْر صَلفْ",93,"ف",1,0],["إملئيها شذى كما يملأ الورد","يد الجارحيه بالأطياب",94,"ب",1,0],["إملإ الكأس ابتساما وغراما","فلقد نام الندامى والخزامى",95,"م",2,0],["إملأ الشاطئَينِ حُبّا وشعرا","فجناحُ الهوى شراعُ سفينك",96,"ك",1,0],["أملٌ كخيط أبيض في قاتم","متلبد أو سكرةٌ وتوهّم",97,"م",1,0],["املِكوا الدّهرَ إنّه لا يُوَاتي","غيرَ عَزْمٍ يَفُلُّ من عَزَماتهْ",98,"ت",2,0],["اِمْلأِ الأُفْقَ مِنْ سَناً وَسَناءِ","وَتَرفَّقْ بِهَامَةِ الْجَوْزَاءِ",99,"ا",2,1],["أمَلُ الشَّعْبِ في خَليفَتِك الْفَا","رُوقِ أحْيَا آمالَه وأجَدّا",100,"د",2,0],["أَمَلٌ هَذِهِ الْحَياةُ فَهَلْ يَعْثُرُ بِي","الْمَوتُ دُونَ وَشْك طِلاَبِهْ",101,"ب",2,0],["أملُ البلادِ تمسّكَتْ بحباله","في الحادثاتِ وعيدُ مصرَ الأكبر",102,"ر",1,0],["أَمَلٌ تحقَّقَ بعدَ طُول مِطالِهِ","بُشْرَى الحمى بوثيقة استقلالِهِ",103,"ل",2,1],["أملعمي الوادي، عليكُمْ واجبٌ","لم يَضْطَلعْ أسلافُكم بمثالِهِ",103,"ل",2,0],["أمَلٌ لم يطش، وحُلمٌ جميلٌ","حقَّقَته لنا صُروف القضاء",104,"ا",2,0],["أملَ العروبةِ، يا ابْنَ مد","ينَ، من يَلُذْ بك فَهْوَ ظافر",105,"ر",1,0],["املئوا البر زاحفاتٍ ثقالاً","واملئوا الجوَّ كلَّه عِقبانا",106,"ن",2,0],["أملاك صدق جاهدوا في العدا","وصيروا أملاكها خشعا",107,"ع",2,0],["أمل ناجزتهم من أجله","ولقد يردى الفتى بالأمل",108,"ل",1,0],["أملٌ طاف بالجزيرة ريَّا","نُ طليقُ الهوى طليقُ الشكائم",109,"م",1,0],["أملٌ كالسماء في بسمة الفَجْ","رِ وفي موكب الرياض الفواغم",109,"م",1,0],["أملاعبَ الأرماح يومَ كريهةٍ","في السلمِ أنتِ ملاعبُ الألباب.",110,"ب",1,0],["أمْ لا تلاقٍ ، فلا خطوطٌ","تُدني بعيداً ، ولا حُدود؟!",111,"د",1,0],["أمل أخشى عليه زمني","فلو استطعت أطلت الزمنا",112,"ن",2,0],["أملٌ ضائعٌ ولبٌّ مشرَّدْ","بين حبٍّ طفى وجُرح تمرّدْ",113,"د",1,1],["أم لها ملك تمكن عرشه","في دولة من مختد ونصال",114,"ل",1,0],["أَم لَدَيكَ العَهدُ الوَثيقُ مِنَ الأيْ","يامِ بَل أَنتَ جاهِلٌ مَغرورُ",115,"ر",1,0],["أم ليس يعلم أنني أحببته","تحت البسيطة راسخ الاركان",116,"ن",1,0],["أمْ لا تسارٍ بالجزورِ إذا غدا","ريحٌ يقطعُ معقدَ الأشطانِ",117,"ن",1,0]]}