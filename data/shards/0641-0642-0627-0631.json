{"poems":[[64,"أيكية صدحت شجوا على فنن","https://www.aldiwan.net/poem52263.html","البسيط"],[63,"فتح أعز به الإسلام صاحبه","https://www.aldiwan.net/poem51815.html","البسيط"],[82,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[48,"مناطق غلمان وأحجال أنس","https://www.aldiwan.net/poem23366.html","الطويل"],[147,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[848,"","https://poetry.dctabudhabi.ae/diwan/poem/49899","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59149","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53181","الوافر"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101799","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87751","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204702","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89129","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83179","الطويل"],[4729,"لِمنْ بَعدَ هدءٍ صدفَةٌ وتلفتُ","https://www.poetsgate.com/ViewPoem.aspx?id=109440",""],[5240,"هذي مضاجع فهر أم مغانيها","https://www.poetsgate.com/ViewPoem.aspx?id=171240",""],[5431,"ولانور إلا الله عنك يُدافعُ","https://www.poetsgate.com/ViewPoem.aspx?id=198629",""]],"verses":[["فقارضيني إِذا ما اعتادني طَرَبٌ","وجداً بوجدٍ وسُلواناً بسلوانِ",0,"ن",1,0],["فقارَبَ الحربَ حتى ما تُباعِدُه","وباعدَ السِّلمَ حتى ما يُقارِبُه",1,"ب",2,0],["فقارِنِ السعدَ على أفْقِهِ","وأنْتَ في العمرِ قرينُ الدوام",2,"م",1,0],["فَقارِب وَباعِد وَاِحبُ وَاِعلُ وَلا تَقُل","وَقولَن وَجاهِر بِالمُرادِ وَكاتِمِ",3,"م",1,0],["فَقارَعوا عارِضاً عَمَّت مَواطِرُهُ","وَيَمَّموا لَمعَ بَرقٍ طالَما كَذَبا",4,"ب",2,0],["فَقارونُ أَغنى الناس قَد كان كافراً","وَآجرَ موسى نفسهُ حِججاً عَشرا",5,"ر",2,0],["فقارب الإخوانا","وكن لهم مِعوانا",6,"ن",2,0],["فَقارب السور المبارزونا","وإنهم لنا لغائظون",7,"ن",1,0],["فَقَارنْت بَيْن البَدْرِ والشَّمْسِ حَافِظاً","قِرانَيْهِمَا من نَحْسِ كَيْدٍ مُرجِّمِ",8,"م",1,0],["فقارعت الكماة وكان يوماً","تُحَدِّثُ عنه ربات الحجال",9,"ل",1,0],["فقار سليم في تبتل نسكه","وللوحش والأطيار في فتكه قاري",10,"ر",2,0],["فَقارب الخَطو مِنها ثُم هامسها","فعل المَغازل في حانوت فُجّار",11,"ر",1,0],["فقارن بشعري شعر نادٍ ومكتبٍ","ومائدة بين الأثاث المنضّد",12,"د",1,0],["فقارب إذا استرشدت يهديك خيره","وباعد إذا جادلت يكفيك شرَّهُ",13,"ر",2,0],["فقارب الإخوان","وكن لهم معوانا",14,"ن",2,0],["فَقارِب أَخاكَ الدَّهرَ وَالعَيشُ مُسعِفٌ","فَسَوفَ تُرى بِالمَوتِ غَيرَ مُقارِبِ",15,"ب",1,0],["فقارَبْتُ حتى لاتَ حينَ تَقَارُبٍ","أنا المادِحُ المَثني وأنتَ المَمدَّحُ",16,"ح",1,0],["فقاربت بين آجال لهم شيم","إذ المنايا طلاب العز يدنيها",17,"ي",3,0],["فقارون لم يبلغ بمالٍ نعيمه","وفرعون قد اُعطى لما هو زارعُ",18,"ع",1,0]]}