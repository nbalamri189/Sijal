{"poems":[[110,"خليلي","https://www.shoaraa.com/p11134",""],[55,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[55,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[65,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[65,"رنت إلي وظل النقع ممدود","https://www.aldiwan.net/poem46194.html","البسيط"],[36,"ألبنى لقد جلت عليك مصيبتي","https://www.aldiwan.net/poem4905.html","الطويل"],[95,"عيد تجدد فيه مجد عدنان","https://www.aldiwan.net/poem11223.html","البسيط"],[39,"فما غاب عن حلم ولا شهد الخنا","https://www.aldiwan.net/poem7482.html","الطويل"],[93,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[34,"ألا هل إلى إلمامة أن ألمها","https://www.aldiwan.net/poem27810.html","الطويل"],[64,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[35,"أيا بائعي ليلى بمكة ضلة","https://www.aldiwan.net/poem25774.html","الطويل"],[22,"فدى لابن بدر ناقتي ونسوعها","https://www.aldiwan.net/poem21685.html","الطويل"],[69,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42721","الطويل"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[169,"نأت سلمى وأمست في عدو","https://www.aldiwan.net/poem719.html",""],[169,"ألا أبلغ النعمان عني رسالة","https://www.aldiwan.net/poem722.html",""],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[215,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[266,"أألزم قلبي فيك حبك والصبرا","https://www.aldiwan.net/poem38279.html","الطويل"],[280,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[310,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[353,"جرت من بعد ساداتي أمور","https://www.aldiwan.net/poem20692.html","الوافر"],[369,"أراقب من طيف البخيلة موعدا","https://www.aldiwan.net/poem60959.html","الطويل"],[371,"ألا ليت شعري ما درى الباب أنني","https://www.aldiwan.net/poem17812.html","الطويل"],[376,"أيترك سر بعد سري لكاتم","https://www.aldiwan.net/poem57133.html","الطويل"],[385,"تحجبت يا ناظري","https://www.aldiwan.net/poem48790.html","مجزوء المتقارب"],[398,"هذي المكارم والعلياء تفتخر","https://www.aldiwan.net/poem53551.html","الكامل"],[415,"ماذا يروعك من وجدي ومن قلقي","https://www.aldiwan.net/poem32420.html","البسيط"],[422,"أدار الكأس صافية المدام","https://www.aldiwan.net/poem53947.html","الكامل"],[422,"أعادك يا سعد عيد الهوى","https://www.aldiwan.net/poem54181.html","المتقارب"],[463,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[463,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[463,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[469,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[469,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[495,"أبي فارسُ الصرماء عمرُو بنُ مالكٍ","https://www.aldiwan.net/poem656.html",""],[505,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[543,"بمقدمك الحمراء قد عبقت عطرا","https://www.aldiwan.net/poem48185.html","عموديه"],[556,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"],[580,"لقد عفت عيشي بعد العفيف","https://www.aldiwan.net/poem2791.html","المتقارب"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126747","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122615","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87140","الوافر"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130180","البسيط"],[804,"","https://poetry.dctabudhabi.ae/diwan/poem/73831","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38999","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145802","المتقارب"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96372","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96691","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136294","الطويل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124329",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49926","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48927","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108624","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108628","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49542","المتقارب"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128748","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137932",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53123","الرجز"],[2215,"","https://poetry.dctabudhabi.ae/diwan/poem/141784","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100309","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26112","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89301","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103977","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48286","الطويل"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3550,"","https://poetry.dctabudhabi.ae/diwan/poem/206254","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108027","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45765","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91466","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91163","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131252",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86530","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136925",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90878","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136470",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72957","الوافر"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96062","الطويل"],[4613,"","https://poetry.dctabudhabi.ae/diwan/poem/101946","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139545",""],[4679,"من الشهبُ المحاطة بالضبابِ","https://www.poetsgate.com/ViewPoem.aspx?id=142741",""],[4691,"توضأ قلبي بماء الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=59823",""],[3591,"رأيناك غصناً مثلما كنت أهيفا","https://www.poetsgate.com/ViewPoem.aspx?id=149460",""],[5121,"ملاك الروح","https://www.poetsgate.com/ViewPoem.aspx?id=36278",""],[5183,"فيض الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=185882",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5390,"كَبِيرٌ بعَيْنَيَّاسْمُكَ يَا وَطنِي","https://www.poetsgate.com/ViewPoem.aspx?id=215720",""],[5509,"هل كان طيفا ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=93489",""],[5582,"خَيالٌ سَرَى نَوْمَةَ السَّامِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=187098",""],[5691,"قرارات حمقاء","https://www.poetsgate.com/ViewPoem.aspx?id=206313",""],[5956,"توبة عاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=182680",""],[5956,"دعوتُ للإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=194884",""],[5997,"عسى يا ليالي","https://www.poetsgate.com/ViewPoem.aspx?id=214241",""],[6229,"ملاكي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65181&r=&rc=8",""]],"verses":[["فما غاب حتى أُشربوا العجل بعده","وفي سامري ضل كل مضلل",0,"ل",1,0],["فَما غيضَ ذاكَ الماءُ حَتّى عَلا","الرُبى وَلا اِجتُثَّ ذاكَ الأَصلُ حَتّى تَفَرَّعا",1,"ع",2,0],["فَما غَرَّني جودُهُ بِالثَراءِ","وَما زادَني مِنهُ إِلّا نِفارا",2,"ر",2,0],["فما غَرَّهُ مِنْ مُضْمِرِ الغِلِّ كاشِحٌ","إذا حَدَرَ الخَصْمُ اللِّثامَ تقَنَّعا",3,"ع",2,0],["فَما غَمَدْنَ عنِ الأسيافِ أعيُنَها","إلا وَسْلولُها في الهامِ مَغمودُ",4,"د",1,0],["فَما غَشِيَت عَينَيكِ مِن ذاكَ عَبرَةٌ","وَعَيني عَلى ما بي بِذِكراكِ تَدمَعُ",5,"ع",1,0],["فَمَا غَوَى جَيْشُ مِصْرٍ فِي تَحِيَّته","رَبَّ الكَتَائِبِ مِنْ رَجْلٍ وَفُرْسَانِ",6,"ن",1,0],["فما غاب عن حلم ولا شهد الخنا","ولا استعذب العوراء يوماً فقالها",7,"ل",3,1],["فَما غَصَّ في رَوضَةٍ طائِرٌ","وَلَم يَنطَفِئ في السَما كَوكَبُ",8,"ب",1,0],["فَما غابَ عَن عَيني خَيالُكِ لَحظَةً","وَلا زالَ عَنها وَالخَيالُ يَزولُ",9,"ل",1,0],["فما غرّهمْ واللّهُ ناصرُ حزبِهِ","بأبيضَ طاغي الحدِّ حينَ يصولُ",10,"ل",1,0],["فَما غُبِنَ المُبتاعُ لَيلى بِمالِهِ","بَلِ البائِعا لَيلى هُما غَبِنانِ",11,"ن",1,0],["فَما غَنِموا يَومَ النِسارِ وَلا وَنَت","فَوارِسُنا إِذ أَبصَروا عَورَةَ الرَجلِ",12,"ل",1,0],["فما غيرَ شمسِ الدِّينِ يَحْمِي دِيارَها","سُطاهُ كما يَحْمِي العَرِينَةَ قَسْوَرُ",13,"ر",1,0],["فما غاضَ منها ناجِرٌ شُخْبَ أرْنَب","ولا سامَنِيها تاجِرٌ عِنْدَ إقْلال",14,"ل",1,0],["فَمَا غَيَّرَتْنِي مِحْنَةٌ عَنْ خَلِيقَتِي","وَلا حَوَّلَتْنِي خُدْعَةٌ عَنْ طَرَائِقِي",15,"ق",2,0],["فما غير شرع الله دين يقتني","ولا يستوى الدين الرضى منه يكسب",16,"ب",1,0],["فما غطفان لي بأب ولكن","لؤي والدي قولا صوابا",17,"ب",2,0],["فما غره والمرء يدرك وتره","بأروع ماضي الهم من آل ظالم",18,"م",1,0],["فَما غيّرَت أَخلاقهُم قطُّ غيرةٌ","وَإِن شاهَدوا زَوجاتهم تصحبُ الغَيرا",19,"ر",2,0],["فما غدرت بي في حماها نسائمٌ","سقاها ربيع الحب أكواب أنداء",20,"ا",2,0],["فما غاية المثنى عليهم بشعره","ولو نظم الشعري العبور بهم شعرا",21,"ر",2,0],["فَما غَيَّر البَحرَ وَالفُراتَ مزاحِمٌ","عَلَى مَضَض وَالعَذْبُ فِي حَجَرٍ صَلدِ",22,"د",1,0],["فَما غمدانُ والإِيوانُ إلّا","مثالٌ وهو ممثولٌ فريدُ",23,"د",1,0],["فَما غَلَتِ البَطالةُ لي لأَنّي","عَرَفْتُ بها الكِرامَ مِن اللِّئَامِ",24,"م",1,0],["فما غابَ شمْسُ الأفْقِ إلا ومِن دَمٍ","بَدا شَفَقٌ قانٍ به الأفُقُ ارتدى",25,"د",2,0],["فَما غفلَتي إِنّي مَعَ اليَومِ سائِرٌ","وَيا وَيلَتي إِنّي مَعَ الغَدِ واصِلُ",26,"ل",1,0],["فما غَرَّني إلا فُتُورُ لَواحِظٍ","لَها فتكات كالقَنا والصَّوارِمِ",27,"م",1,0],["فَما غَبت عَن خاطِري","بِبَعدك عَن ناظِري",28,"ي",1,0],["فَما غَدَوتَ وَما لِلعَينِ منقلب","إِلّا إِلى مَنظرٍ يَبهي وَيحتبرُ",29,"ر",1,0],["فَما غَدَوتُ بشَملٍ غَيرِ مَجتمِعٍ","إلا ورُحتُ بهَمٍّ غَيرِ مُفتَرِقِ",30,"ق",1,0],["فما غَدَرَتْ لمشتاق بعهدٍ","ولا خَفَرَتْ لصبِّ بالذمام",31,"م",1,0],["فما غير قلبي يصْلى الفضا","ولا غير طرفي يفيض الدما",32,"ا",1,0],["فما غام خطبٌ وجهُ أحمدَ شمسُهُ","ولا جفَّ عامٌ كفُّ أحمدَ وابلُهْ",33,"ل",2,0],["فما غَنِيَ المبصَّرُ وهو باغٍ","بما تُجدِي المَشُورةُ أو تُفيدُ",34,"د",1,0],["فما غيرها فوق البسيطة للعلا","مَقرٌّ على أن البلاد فسائحُ",35,"ح",1,0],["فما غير ومض البرق فيه بسائفٍ","يشامُ ولا غير الغدير بدارع",36,"ع",1,0],["فما غلّةُ الصادي وما جنَّةُ الهوى","وما أنَّة الشاكي وما صبوةُ الترب",37,"ب",1,0],["فَما غَمَرَتهُ الحَربُ إذ شَمَّرَت لَهُ","وَلا خارَ إِذ جُرَّت عَلَيهِ الجَرائِرُ",38,"ر",1,0],["فما غيركُمْ أعني ولم أبغِ مظهري","لطرزٍ ولا أُمِّي الحَصانَ ولا أَبي",39,"ب",2,0],["فما غِبتَ عنَّا حين فينا تركتَهُ","وما كنتَ إلا الشمسَ خلَّفتِ البَدرا",40,"ر",2,0],["فما غيّرت كفُّ ذي صنعةٍ","بِأَخفى التحلّي مَكانَ الحُلى",41,"ا",1,0],["فما غاب ما غاب إِلاَّ الجميلُ","وما مات ما ماتَ إِلاَّ الوفاءُ",42,"ا",2,0],["فَما غسلوه بل على التُربِ قد هوى","ومنهُ جيادُ الخيل قد وَطأت صَدرا",43,"ر",2,0],["فما غارةٌ إلا وأنتَ زعيمُها","ولا غَزوةٌ إلا وأنتَ أميرُها",44,"ر",3,0],["فَما غَيري يَدُوم عَلى غَرام","وَكُلُّ الحُسن يا مَياس فاني",45,"ن",2,0],["فما غدت تحتها الأنهار جارية","إلا وقلبي سعير النار يصلاها",46,"ا",3,0],["فَما غَلَّقَت قَطُّ مُذ فُتِّحَت","عَلى فاضِلِ الطَّبعِ أَبوابَها",47,"ب",3,0],["فَما غَيرهُ يا هند يَوماً يُغيثُنا","إِذا عَضّنا الدّهر الخَؤونُ بِنابِهِ",48,"ب",2,0],["فما غادرَتنا وإنْ غادَرتنَا","وبالدِيْنِ لا النارِ إضرَامُها",49,"م",3,0],["فما غراءُ في دَمثٍ هيامٍ","أراد بها السهولةَ والقرارا",50,"ر",2,0],["فَما غرّبت إلّا وغرّبَ عندها","وَلا شرّقت إلّا وكانَ المشرِّقا",51,"ق",2,0],["فما غاية في الذوق الا وقد بدت","شواهدها تنبيك عما به اتصل",52,"ل",1,0],["فما غش امرءاً عن ظهر غيب","وربة ناصح بالغيب غشَّا",53,"ش",2,0],["فما غادرَا من كل فنٍ فضيلَةً","ولا أغفَلا بين ال