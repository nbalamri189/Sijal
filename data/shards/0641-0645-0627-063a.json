{"poems":[[53,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[63,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[63,"رنت إلي وظل النقع ممدود","https://www.aldiwan.net/poem46194.html","البسيط"],[34,"ألبنى لقد جلت عليك مصيبتي","https://www.aldiwan.net/poem4905.html","الطويل"],[93,"عيد تجدد فيه مجد عدنان","https://www.aldiwan.net/poem11223.html","البسيط"],[37,"فما غاب عن حلم ولا شهد الخنا","https://www.aldiwan.net/poem7482.html","الطويل"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[32,"ألا هل إلى إلمامة أن ألمها","https://www.aldiwan.net/poem27810.html","الطويل"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[33,"أيا بائعي ليلى بمكة ضلة","https://www.aldiwan.net/poem25774.html","الطويل"],[22,"فدى لابن بدر ناقتي ونسوعها","https://www.aldiwan.net/poem21685.html","الطويل"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42721","الطويل"],[160,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[165,"نأت سلمى وأمست في عدو","https://www.aldiwan.net/poem719.html",""],[165,"ألا أبلغ النعمان عني رسالة","https://www.aldiwan.net/poem722.html",""],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[211,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[261,"أألزم قلبي فيك حبك والصبرا","https://www.aldiwan.net/poem38279.html","الطويل"],[275,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[305,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[348,"جرت من بعد ساداتي أمور","https://www.aldiwan.net/poem20692.html","الوافر"],[364,"أراقب من طيف البخيلة موعدا","https://www.aldiwan.net/poem60959.html","الطويل"],[366,"ألا ليت شعري ما درى الباب أنني","https://www.aldiwan.net/poem17812.html","الطويل"],[371,"أيترك سر بعد سري لكاتم","https://www.aldiwan.net/poem57133.html","الطويل"],[380,"تحجبت يا ناظري","https://www.aldiwan.net/poem48790.html","مجزوء المتقارب"],[393,"هذي المكارم والعلياء تفتخر","https://www.aldiwan.net/poem53551.html","الكامل"],[409,"ماذا يروعك من وجدي ومن قلقي","https://www.aldiwan.net/poem32420.html","البسيط"],[416,"أدار الكأس صافية المدام","https://www.aldiwan.net/poem53947.html","الكامل"],[416,"أعادك يا سعد عيد الهوى","https://www.aldiwan.net/poem54181.html","المتقارب"],[458,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[458,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[458,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[464,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[464,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[490,"أبي فارسُ الصرماء عمرُو بنُ مالكٍ","https://www.aldiwan.net/poem656.html",""],[500,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[538,"بمقدمك الحمراء قد عبقت عطرا","https://www.aldiwan.net/poem48185.html","عموديه"],[551,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"],[575,"لقد عفت عيشي بعد العفيف","https://www.aldiwan.net/poem2791.html","المتقارب"]],"verses":[["فَما غيضَ ذاكَ الماءُ حَتّى عَلا","الرُبى وَلا اِجتُثَّ ذاكَ الأَصلُ حَتّى تَفَرَّعا",0,"ع",2,0],["فَما غَرَّني جودُهُ بِالثَراءِ","وَما زادَني مِنهُ إِلّا نِفارا",1,"ر",2,0],["فما غَرَّهُ مِنْ مُضْمِرِ الغِلِّ كاشِحٌ","إذا حَدَرَ الخَصْمُ اللِّثامَ تقَنَّعا",2,"ع",2,0],["فَما غَمَدْنَ عنِ الأسيافِ أعيُنَها","إلا وَسْلولُها في الهامِ مَغمودُ",3,"د",1,0],["فَما غَشِيَت عَينَيكِ مِن ذاكَ عَبرَةٌ","وَعَيني عَلى ما بي بِذِكراكِ تَدمَعُ",4,"ع",1,0],["فَمَا غَوَى جَيْشُ مِصْرٍ فِي تَحِيَّته","رَبَّ الكَتَائِبِ مِنْ رَجْلٍ وَفُرْسَانِ",5,"ن",1,0],["فما غاب عن حلم ولا شهد الخنا","ولا استعذب العوراء يوماً فقالها",6,"ل",3,1],["فَما غَصَّ في رَوضَةٍ طائِرٌ","وَلَم يَنطَفِئ في السَما كَوكَبُ",7,"ب",1,0],["فَما غابَ عَن عَيني خَيالُكِ لَحظَةً","وَلا زالَ عَنها وَالخَيالُ يَزولُ",8,"ل",1,0],["فما غرّهمْ واللّهُ ناصرُ حزبِهِ","بأبيضَ طاغي الحدِّ حينَ يصولُ",9,"ل",1,0],["فَما غُبِنَ المُبتاعُ لَيلى بِمالِهِ","بَلِ البائِعا لَيلى هُما غَبِنانِ",10,"ن",1,0],["فَما غَنِموا يَومَ النِسارِ وَلا وَنَت","فَوارِسُنا إِذ أَبصَروا عَورَةَ الرَجلِ",11,"ل",1,0],["فما غيرَ شمسِ الدِّينِ يَحْمِي دِيارَها","سُطاهُ كما يَحْمِي العَرِينَةَ قَسْوَرُ",12,"ر",1,0],["فما غاضَ منها ناجِرٌ شُخْبَ أرْنَب","ولا سامَنِيها تاجِرٌ عِنْدَ إقْلال",13,"ل",1,0],["فَمَا غَيَّرَتْنِي مِحْنَةٌ عَنْ خَلِيقَتِي","وَلا حَوَّلَتْنِي خُدْعَةٌ عَنْ طَرَائِقِي",14,"ق",2,0],["فما غير شرع الله دين يقتني","ولا يستوى الدين الرضى منه يكسب",15,"ب",1,0],["فما غطفان لي بأب ولكن","لؤي والدي قولا صوابا",16,"ب",2,0],["فما غره والمرء يدرك وتره","بأروع ماضي الهم من آل ظالم",17,"م",1,0],["فَما غيّرَت أَخلاقهُم قطُّ غيرةٌ","وَإِن شاهَدوا زَوجاتهم تصحبُ الغَيرا",18,"ر",2,0],["فما غدرت بي في حماها نسائمٌ","سقاها ربيع الحب أكواب أنداء",19,"ا",2,0],["فما غاية المثنى عليهم بشعره","ولو نظم الشعري العبور بهم شعرا",20,"ر",2,0],["فَما غَيَّر البَحرَ وَالفُراتَ مزاحِمٌ","عَلَى مَضَض وَالعَذْبُ فِي حَجَرٍ صَلدِ",21,"د",1,0],["فَما غمدانُ والإِيوانُ إلّا","مثالٌ وهو ممثولٌ فريدُ",22,"د",1,0],["فَما غَلَتِ البَطالةُ لي لأَنّي","عَرَفْتُ بها الكِرامَ مِن اللِّئَامِ",23,"م",1,0],["فما غابَ شمْسُ الأفْقِ إلا ومِن دَمٍ","بَدا شَفَقٌ قانٍ به الأفُقُ ارتدى",24,"د",2,0],["فَما غفلَتي إِنّي مَعَ اليَومِ سائِرٌ","وَيا وَيلَتي إِنّي مَعَ الغَدِ واصِلُ",25,"ل",1,0],["فما غَرَّني إلا فُتُورُ لَواحِظٍ","لَها فتكات كالقَنا والصَّوارِمِ",26,"م",1,0],["فَما غَبت عَن خاطِري","بِبَعدك عَن ناظِري",27,"ي",1,0],["فَما غَدَوتَ وَما لِلعَينِ منقلب","إِلّا إِلى مَنظرٍ يَبهي وَيحتبرُ",28,"ر",1,0],["فَما غَدَوتُ بشَملٍ غَيرِ مَجتمِعٍ","إلا ورُحتُ بهَمٍّ غَيرِ مُفتَرِقِ",29,"ق",1,0],["فما غَدَرَتْ لمشتاق بعهدٍ","ولا خَفَرَتْ لصبِّ بالذمام",30,"م",1,0],["فما غير قلبي يصْلى الفضا","ولا غير طرفي يفيض الدما",31,"ا",1,0],["فما غام خطبٌ وجهُ أحمدَ شمسُهُ","ولا جفَّ عامٌ كفُّ أحمدَ وابلُهْ",32,"ل",2,0],["فما غَنِيَ المبصَّرُ وهو باغٍ","بما تُجدِي المَشُورةُ أو تُفيدُ",33,"د",1,0],["فما غيرها فوق البسيطة للعلا","مَقرٌّ على أن البلاد فسائحُ",34,"ح",1,0],["فما غير ومض البرق فيه بسائفٍ","يشامُ ولا غير الغدير بدارع",35,"ع",1,0],["فما غلّةُ الصادي وما جنَّةُ الهوى","وما أنَّة الشاكي وما صبوةُ الترب",36,"ب",1,0],["فَما غَمَرَتهُ الحَربُ إذ شَمَّرَت لَهُ","وَلا خارَ إِذ جُرَّت عَلَيهِ الجَرائِرُ",37,"ر",1,0],["فما غيركُمْ أعني ولم أبغِ مظهري","لطرزٍ ولا أُمِّي الحَصانَ ولا أَبي",38,"ب",2,0],["فما غِبتَ عنَّا حين فينا تركتَهُ","وما كنتَ إلا الشمسَ خلَّفتِ البَدرا",39,"ر",2,0],["فما غيّرت كفُّ ذي صنعةٍ","بِأَخفى التحلّي مَكانَ الحُلى",40,"ا",1,0],["فما غاب ما غاب إِلاَّ الجميلُ","وما مات ما ماتَ إِلاَّ الوفاءُ",41,"ا",2,0]]}