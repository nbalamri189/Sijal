/poem54097.html","الطويل"],[413,"أنا في هواكم مطلق ومقيد","https://www.aldiwan.net/poem54136.html","الكامل"],[426,"يا ظبية البان بين الرند والخزم","https://www.aldiwan.net/poem41405.html","البسيط"],[441,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[441,"عوذت بالله إمام العصر","https://www.aldiwan.net/poem56033.html","عموديه"],[453,"لا يبعد الله حسادي وزادهم","https://www.aldiwan.net/poem26636.html","البسيط"],[468,"أقبح به من ولد وأشقح","https://www.aldiwan.net/poem4656.html","الرجز"],[468,"الأكرمون طوال الدهر إن نسبوا","https://www.aldiwan.net/poem4668.html","البسيط"],[468,"إما تصبني المنايا وهي لاحقة","https://www.aldiwan.net/poem4745.html","البسيط"],[527,"درر تلوح من السطور","https://www.aldiwan.net/poem37422.html","مجزوء الكامل"],[536,"لله في مراكش قبر به","https://www.aldiwan.net/poem48226.html","عموديه"],[549,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"],[551,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[560,"ما بال تلك الشامة الخضراء","https://www.aldiwan.net/poem52869.html","الكامل"],[562,"دعني أخي من الأدب","https://www.aldiwan.net/poem823.html",""],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[571,"يا برق برقاً بين مروة والصفا","https://www.aldiwan.net/poem3646.html","الكامل"],[573,"عز إله العالم","https://www.aldiwan.net/poem2756.html","مجزوء الرجز"],[573,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"]],"verses":[["إِن يَرحَلوا اليَومَ عَن داري فَإِنَّهُمُ","جيرانُ قَلبي أَقاموا بَعدَما اِنطَلَقوا",0,"ق",3,0],["إِنّي رَضيتُكَ في الزَمانِ مُمَدَّحاً","وَعُلاكَ لا تَرضى بِأَنِّيَ شاعِرُ",1,"ر",1,0],["إِنّي رَأَيتُكَ مِمَّن لا يُخادِعُهُ","حَثُّ الزُجاجَةِ بِالغيدِ الرَعابيبِ",2,"ب",1,0],["أُنيرُ وأُسْدي مَجْدَ أرْوَعَ باسِمٍ","على حِينِ يَلوي بالوجُوهِ قُطوبُها",3,"ب",3,0],["إِنّي رَأَيتُ وُقوفَ الماءِ يُفسِدُهُ","إِن ساحَ طابَ وَإِن لَم يَجرِ لَم يَطِبِ",4,"ب",1,0],["إِنْ يُرفَعِ الْقَيْدُ عَنْهَا","عَلَتْ وَعَزَّتْ وَجَلَّتْ",5,"ت",1,0],["إِنّي رَأَيتُ الحَربَ إِن شَمَّرَت","دارَت بِكَ الحَربُ مَعَ الدائِرِ",6,"ر",1,0],["إِنّي رَثَيتُكَ وَالأَسى جَلَلٌ","وَالحُزنُ يَصدَعُ مُهجَتي صَدعا",7,"ع",2,0],["إِنّي رَأَيتُكَ قَبلَ المَوتِ في فَلَكٍ","مِنَ الجَلالِ عَلى جَنبَيهِ نورانِ",8,"ن",1,0],["إِنّي رَأَيتُ الجاهِلا","تِ السافِراتِ عَلى خَطَر",9,"ر",1,0],["إِنّي رَأَيتُ عَلى أَهرامِها حُلَلاً","مِنَ الجَلالِ أَراها فَوقَ لُبنانِ",10,"ن",1,0],["أَنّي رَأَيتُ المُنذِرَينِ كِلَيهِما","في كَونِ مُلكٍ لَم يُحِلهُ فَسادُ",11,"د",1,0],["إِنْ يُرْجَ لاَ يُرْجَ إِلاَّ فَضْلُ بَارِئِهِ","وَمَنْ رَجَا غَيْرَهُ يَوْماً وَلَمْ يَخِبِ",12,"ب",1,0],["إني رفعت تهانئي وقبولها","هو من لدنك السعد والإسعاد",13,"د",1,0],["إِنْ يَرْأَسِ الشُّورَى يَسُسْهَا وَلَمْ","تُؤْخَذْ عَلَيْهِ فِي مَقَامٍ هَنَهْ",14,"ن",2,0],["إِنْ يَرْمِكَ الشَّاكِي بِحِقْدٍ عِنْدَهُ","فَاسْلَمْ وَلا تَبْلُغْكَ رَمْيَةُ حِقْدِهِ",15,"د",2,0],["أَنِيرُوا أَنِيرُوا فَإِنَّ الظَّلامَ","حَلِيفُ المَظَالِمِ وَالظَّالِمِ",16,"م",1,0],["أَنِيرُوا أَنِيرُوا فَإِنْ الضيَا","ءَ عَدُوُّ الْجَرَائِمِ وَالْجَارِمِ",16,"م",1,0],["أَنِيرُوا الْعُقُولَ وَلا تَتْرُكُوا","عَلَى الْفِكْرَ مِنْ أَثَرٍ قاتِمِ",16,"م",1,0],["إنْ يُرضِ أسْمَى جَانِبٍ مِنْ نَفْسِهِ","لَمْ يَثْنِهِ أنَّ الطَّرِيقَ ألِيمُ",17,"م",1,0],["إِنّي رَئيتُكُمُ وَالحَقُّ مَغضَبَةٌ","تَخزَونَ أَن يُذكَرَ الجَحّافُ أَو زُفَرُ",18,"ر",1,0],["إِنّي رَضيتُ وَإِن كَرِه","تُ أَبا مُحَمَّدٍ الحَكَم",19,"م",1,0],["إِنّي رَأَيتُ أَمينَ اللَهِ مُضطَهَداً","عُثمانَ رَهناً لَدى الأَجداثِ وَالكَفَنِ",20,"ن",1,0],["أنْ يرى مَلْهَاهُ إلا","آخذاً بعضَ صفاتِهْ",21,"ت",2,0],["إن يرتدِ الحمدَ سالمٌ رجلاً","فإنه قبل حُلمه ائْتزَره",22,"ر",2,0],["إني رأيتك يا ابن أحمد سيداً","فينا بحق واجب وحقاق",23,"ق",1,0],["إني رأيتُك جنةً عدنيةً","قد هُدّلتْ ثمراتُها تهديلا",24,"ل",2,0],["إني رأيتُك حالماً أنشدتني","بيتين قاداني عليك على أمَلْ",25,"ل",1,1],["إنِّي رأيتُ سؤالَ الباخلينَ زِناً","وفي سؤالك للأحرارِ إحصان",26,"ن",1,0],["أَنّي رَأَيتُ جَرادَةً مَطروحَةً","في سَبخَةٍ مَنهوكَةِ الأَعضاءِ",27,"ا",2,0],["إِنّي رَأَيتُ البَحرَ أَخرَسَ ساهِياً","كَالشَيخِ طالَ بِما مَضى تَفكيرُهُ",28,"ر",2,0],["إِن يَرفَعِ المالُ الكَريمَ فَإِنَّهُ","لِلنَذلِ مِثلُ الحَبلِ لِلمَشنوقِ",29,"ق",1,0],["إِنّي رَأَيتُ الفَتى الكَريمَ إِذا","رَغَّبتَهُ في صَنيعَةٍ رَغِبا",30,"ب",2,0],["إِنّي رأيتُكِ في المَنام ضَجيعَتي","وَكَأَنَّ ساعِدَك الوَثيرَ وِسادي",31,"د",2,1],["أَنّى رَجَوتم غَدرَ من جَرَّبتمُ","مِنهُ الوَفاءَ وَظُلمَ مَن لا يَظلِمُ",32,"م",1,0],["إِنّي رَأَيتُ يَدَ الحَضارَةِ أولِعَت","بِالحَقِّ هَدماً تارَةً وَبِناءَ",33,"ا",2,0],["إِنّي رَأَيتُ جُيوشَ النَصرِ مُنزَلَةً","عَلى جُيوشِ أَبي الجَيشِ بنِ طولونا",34,"ن",2,0],["إِنّي رَأَيتُ بَني مَروانَ غُرَّتَكُم","وَالمُطعِمينَ إِذا ما غَيرَهُم جَحِدوا",35,"د",3,0],["إِنّي رَأَيتُ يَزيدَ عِندَ شَبابِهِ","لَبِسَ التُقى وَمَهابَةَ الجَبّارِ",36,"ر",1,0],["إِنّي رَأَيتُ أَبا الأَشبالِ قَد ذَهَبَت","يَداهُ حَتّى تُلاقي الشَمسَ وَالقَمَرا",37,"ر",2,1],["إِنّي رَأَيتُكَ إِذ أَبَقتَ فَلَم تَئل","خَيَّرتَ نَفسَكَ مِن ثَلاثِ خِلالِ",38,"ل",1,0],["إِنّي رَأَيتُ أَبا الأَشبالِ مُعتَصِماً","بِهِ الجِبالُ كَعادٍ عِندَ خَفّانا",39,"ن",2,0],["إني رأيتك جالسا في مجلس","قعد الملوك به لديك وقاموا",40,"م",3,1],["إِنّي رَأَيتُ وَفي الأَيّامِ تَجرِبَةٌ","لِلصَبرِ عاقِبَةٌ مَحمودَةُ الأَثَرِ",41,"ر",1,0],["إِنّي رَأَيتُ عَواقِبَ الدُنيا","فَتَرَكتُ ما أَهوى لِما أَخشى",42,"ا",1,0],["إِنّي رَأَيتُ الشَريفَ مُعتَرِفاً","مُصطَبِراً لِلحُقوقِ إِذ تَجِبُ",43,"ب",1,0],["إنّي رأيتُكَ بعدما وَلَّى الصِبَا","فبكى الشبابُ على ربيعِ زمانِه",44,"ن",2,0],["إني رأيت أساكِ عن كثبِ","ولَمست كربك نابضاً حيَّا",45,"ي",2,0],["إِن يُرفَعِ السَجفُ لَهُ اليَومَ يَر","فَعهُ غَداً في المَشهَدِ البارِعِ",46,"ع",1,0],["إِنّي رَأَيتُ الحُبَّ يَنقُصُهُ","طولُ الزَمانِ وَحُبُّكُم يَنمي",47,"م",2,0],["إِنّي رَأَيتُكِ غادَةً خُمصانَةً","رَيّا الرَوادِفِ لَذَّةً مِبشارا",48,"ر",2,0],["أَنيري مَكانَ البَدرِ إِن أَفَلَ البَدرُ","وَقومي مَقامَ الشَمسِ ما اِستَأخَرَ الفَجرُ",49,"ر",1,1],["إنّي رَسُولُك لَنْ أَمَلَّ جِهادَهم","أو يَعبدوكَ ولن أكونَ سَؤوما",50,"م",2,0],["إنّي رأيتُ الأمرَ بعد مِطَالِه","بلغَ المصيرَ وللأُمورِ مَصيرُ",51,"ر",1,0],["إن يَرُعْها أمَّةً مَحزونةً","فلقد يَجمعُ بين الأُمَّتيْنْ",52,"ن",1,0],["إنّي رأيتُ النّاسَ رُسْلَ هدايةٍ","بذلوا النُّفوسَ وآخرين تجارا",53,"ر",2,0],["إِنّي رَأَيتُ مِنَ المَقالِ مَناقِباً","مَأثورَةً وَوَجَدتُ مِنهُ مَخازِيا",54,"ي",2,0],["إنّي رأيتُ لخالدٍ من عقلِهِ","فيما يُمارسُ مُرشداً وإماما",55,"م",2,0],["إني رسولُ اللَّهِ ليس بِخاذِلي","واللَّهُ يَقْدِرُ ما يشاءُ وَيَقْسِمُ",56,"م",1,0],["إِنّي رُزِقتُ مِنَ الإِخوانِ جَوهَرَةً","ما إِن لَها قيمَةٌ عِندي وَلا ثَمَنُ",57,"ن",1,1],["إِن يَرجِعِ اللَهُ لي مَوَدَّتَها","فَكُلُّ شَيءٍ سِواهُ مُحتَقَرُ",58,"ر",1,0],["إِن يَرتَفِع بَشَرٌ عَلَيكَ فَكَم غَدا","عَلَمٌ بِتابِعِ فِتنَةٍ مَربوءا",59,"و",3,0],["إِنّي رَقَدتُ فَعُمتُ في لُجَجِ المُنى","ثُمَّ اِنتَبَهتُ فَعادَني إِقصارُ",60,"ر",1,0],["إِن يُرسِلِ النَفسَ في اللَذّاتِ صاحِبُها","فَما يُخَلَّدنَ صُعلوكاً وَلا مَلِكا",61,"ك",2,1],["إِن يَرحَلِ الناسُ وَلَم أَرتَحِل","فَعَن قَضاءٍ لَم يُفَوَّض إِلَيّ",62,"ل",2,0],["إني رَفعْتُ بكم مِثالاً رائعاً","يُوما إليهِ في العُلى ويُشارُ",63,"ر",1,0],["إنْ يَرها ظَمآنُ في مَهْمَهٍ","يَسْأَلْكَ منها جُرْعَةً للفَمِ",64,"م",1,0],["إِنْ يَرْكَبِ الْبَاغِي هَوَاةُ مَطِيَّةً","فَأْشدُّ بَغْياً خُضَّعُ الاجْيَادِ",65,"د",1,0],["إنِّي رَأَيْتُ قَتِيلَ الدَّارِ مُضْطَهَداً","عُثْمَانَ يُهدَى إلى الأجْدَاثِ في كَفَنِ",66,"ن",1,0],["إنّي رَأَيْتُ محمّداً إِختَارَهُ","صِهراً وَكَانَ يَعُدُّهُ خلصَانَا",67,"ن",2,0],["إني رأيت جيوشه لم تغزُنا","في الحرب، بل في مشرب وطعام",68,"م",1,0],["إن يرفعوا ما انقضَّ من بنيانهم","فالضادُ أولُ حائطِ ودعام",68,"م",1,0],["إني رأيتُ الشرقَ ينطقُ عَنْهُمُو","«كالببغاءِ مردّدًا ومكرّرًا»",69,"ر",2,0],["إن يركبوا كانوا قَسَا","وِرَ، تَحتها خبلٌ ضوامر",70,"ر",1,0],["إني رأيت القولَ غيرَ مرَّفهٍ","لكن رأيتُ الصمتَ غيرَ بديع",71,"ع",1,0],["إني رَصَدتُكَ من بعيد لم أُرِدْ","إذناً عليكَ ولا بعثتُ رسولا",72,"ل",2,0],["إنِّي رأيتُك يابن أحمد سيدا","فينا بحق واجبٍ وحقاق",73,"ق",1,0],["أَنّى رَجَوتم غَدرَ من جَرَّبتمُ","مِنهُ الوَفاءَ، وَجور مَن لا يَظلِمُ",74,"م",1,0],["إنِّي رميت بمنجلي","وتركت للطير السنابل",75,"ل",1,0],["أن يرى بالذل في نار الغضا","مات مخذولاً وفي البلوى مضى",76,"ض",2,0],["إنِّي رَأيْتُ بِمِصْرَ نَهْرَ مَحَبَّةٍ","مَا كَانَ مِنْ دُونِ الحِوَارِ سَيَنْبُعُ",77,"ع",1,0],["إني رأيتُ اللهَ رؤيةَ عاقلٍ","متأمّلٍ في الخَلقِ والأكْوانِ",78,"ن",1,0],["إنِّي رجوت بحُسْن ظنِّي","أن تجودَ بما أُحبّْ",79,"ب",1,0],["إني رجوتك أن تَسُدَّ خَصاصتي","والظَّنُّ مِنِّي لا يخيب رجائي",80,"ا",2,0],["أَنِيري طَريقي خِلالَ الرؤى","خِلالَ الشُكوكِ خِلالَ السآم",81,"م",1,0],["إن يرقُدوا فنعيمٌ","رُقادهم في البُؤوس",82,"س",1,0],["أن يَرَى الفِعلَ في المُحَرَّمِ نَصًّا","لَم يَجِد فِيهِ لِلحَلاَلِ إحتِمَالا",83,"ل",2,0],["إن يَرُم لَذَّةَ السَّمَاعِ سميعٌ","مِنهُ لَم يُهدِ لَذَّةً لِلسَّمِيعِ",84,"ع",1,0],["إن يَرُم انشاءَ قافيةٍ","ظنه أنشَى كانشائِى",85,"ا",2,0],["إن يَرُج قَفراً فِيهِ أدُمٌ عَوَاهِيجُ","وعِينٌ تَحنُو على الأطلاَءِ",86,"ا",2,0],["إني رأيت العزّ مستودعاً","في خدمة الخلاق سبحانَه",87,"ن",2,1],["إني رفعت إلى عطائك حاجتي","ووثقت منك بنيل ما أهواه",88,"ا",2,0],["إِن يَرضَ قَومي الهونَ فيَّ فَطالَما","عَمداً أَهَنتُ النَفسَ في مَرضاتِها",89,"ت",3,0],["إني رأيت ومثلي من رأى عجبا","فظلّ في حيرة من ذلك العجب",90,"ب",1,1],["إِن يُرِد يُقدم وإلّا أحجما","لَم يخالِف فعلَ عبدٍ كيّسِ",91,"س",1,0],["إني رأيتُ أخا الغرامِ كأنما","صبتْ عليهِ وحدهُ الأوصابُ",92,"ب",1,0],["اني رضيت بما يرضيه من تلفي","فما علي اذا ما عاذلي غضبا",93,"ب",2,0],["إني رأيتك في حلوان واشغفى","إلى النسائم في صحراء حلوان",94,"ن",1,1],["أنيران قلبي تجعل الكون دمعة","تحول بها عيناي سهدا على سهد",95,"د",1,0],["إن يَرجَحِ الخيرُ نعمَ الخيرُ من عملٍ","دَخَلتَ في زُمرَةِ الغرِّ المَيامينِ",96,"ن",1,0],["إِن يُرتَجَل عُرفٌ فَأَنت إِلى الذي","لَم يَرتَجِله المالِكون موفَّقُ",97,"ق",1,0],["أَن يَرى تَحتَ ظِلالٍ","لَكَ أَو تَحتَ رُواقِ",98,"ق",1,0],["إن يرد كان ما أراد فإيجا","باً يكون المراد كوناً وسلبا",99,"ب",2,0],["إنّي رَأيتُكَ في المَنَا","مِ وَأَنتَ تُعطِيني خِيَارَه",100,"ه",1,1],["إني رَغِبتُ عَنِ الإقامةِ عزَّةً","وأعزُّ شيءٍ ما