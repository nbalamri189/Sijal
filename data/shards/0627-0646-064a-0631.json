,0],["إِن يَرَ سوءاً لَم يَقُم فَيَنبَحِ","بالبابِ عِندَ خَلقِهِ المُستَقبَحِ",127,"ح",1,0],["إِنّي رَأَيت ابنَ لَيلى وَهوَ مُصطَنَعٌ","موَفَّقاً أَمرُهُ حَيثُ انتَوى رَشَدُ",128,"د",1,0],["إِنّي رَأَيتُ غَداةَ السوقِ مَحضَرَهُم","إِذ نَحنُ نَنظُرُ ما يُتلى وَنَستَمِعُ",129,"ع",1,0],["إنّي رَأَيْتُ الاِعْتِذا","رَ مِنَ الذّنُوبِ إلى الغَفُورِ",130,"ر",1,0],["إني رأيتُ البؤس يَجذِبُ بعضَه","ورأيتُ من مُتوسِّدٍ مُتوسَّدِ",131,"د",1,0],["أنيروزَ مالكنا دُمْ له","وكنْ بالّذي يبتغيه كفيلا",132,"ل",2,0],["إِنّي رَماني الدَهرُ مِنهُ بِنَكبَةٍ","حَتّى حَمَلتُ مِنَ الدُيونِ ثِقالا",133,"ل",2,0],["إني رأيتُ الشِّعرَ فيكَ يُطيعُني","فأرَاكَ تُسِعفُني على الإنشاءِ",134,"ا",2,0],["إني رأيت الناصحي","ن المبعدين بذا السبب",135,"ب",1,0],["أن يرجموها فأتى الوصي","فقال قد برأها العلي",136,"ي",1,0],["أن يرث الأمر على ما عقدوا","إذا أمادوا إبنه محمد",136,"د",1,0],["إِن يَرفَعوا رَأسَ الحُسنِ فَقَبلَهُ","رَفَعوا لَواذاً مِن أَبيعِ المُصحَفا",137,"ف",2,0],["إن يرج إلا حربه","ما تم إلا ما تم",138,"م",1,0],["إِنِّي رأَيت الشمسَ ثم رأَيتُها","ماذا عليَّ إِذا عَشِقْتُ الأَحْسَنَا",139,"ن",2,0]]}