{"poems":[[55,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[55,"عند قلبي علاقة ما تقضى","https://www.aldiwan.net/poem30174.html","الخفيف"],[74,"أعيذ ريم الترك بالروم","https://www.aldiwan.net/poem19684.html","السريع"],[53,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[87,"الضلوع تتقد","https://www.aldiwan.net/poem62893.html","المقتضب"],[82,"جلا محياك عن أبصارنا الرمدا","https://www.aldiwan.net/poem31474.html","البسيط"],[82,"غيرته غير الدهر فشاب","https://www.aldiwan.net/poem31541.html","الرمل"],[41,"قل في شط نهروان اغتماضي","https://www.aldiwan.net/poem53771.html","الخفيف"],[50,"كل ناع فسينعى كل باك فسيبكى","https://www.aldiwan.net/poem10765.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42586","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55079","الخفيف"],[240,"مدحك لا يستطيعه البشر","https://www.aldiwan.net/poem32019.html","المنسرح"],[415,"كل مستقبل من الهم","https://www.aldiwan.net/poem32069.html","مجزوء الخفيف"],[469,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[556,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[556,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[567,"أجمل الله في فؤادك صبرا","https://www.aldiwan.net/poem52990.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122667","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122531","الخفيف"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88617","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38856","الخفيف"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100503","الرجز"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107488","الخفيف"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105503","الخفيف"],[4988,"ما نهض ابن الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=180737",""],[5277,"قميصُ الوجع","https://www.poetsgate.com/ViewPoem.aspx?id=191116",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[520,"قل لجمال الملك يا ابن الذي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577486",""]],"verses":[["كُلُّ مُستَيقِظِ الجَنانِ إِذا أَظ","لَمَ لَيلُ النَواسَةِ المِبطانِ",0,"ن",1,0],["كُلُّ مُستَعسِفِ اليَدَينِ بِقَوسِ ال","مَجدِ يَرمي عَنِ المَكارِمِ عِرضا",1,"ض",2,0],["كل مسمى كرم حازه","بكافه والراء والميم",2,"م",1,0],["كل مستبرعٍ فأنت من الأر","واح فيه والناس من أجسادِهْ",3,"د",2,0],["كُلُّ مُسرِفٍ جَزَعاً","أَو بُكىً سَيَقتَصِدُ",4,"د",1,0],["كُلٌّ مسرٌّ بِوَجهٍ في أَسِرَّتِهِ","نورٌ إذا ما رماهَ أكبرٌ سَجَدا",5,"د",2,0],["كلّ مُسْوَدّ قَرَاهُ خلقةً","لابساً من ذلك الليلِ إهاب",6,"ب",1,0],["كُلُّ مُستَأنِسٍ إِلى المَوتِ قَد خا","ضَ إِلَيهِ بِالسَيفِ كُلَّ مَخاضِ",7,"ض",1,0],["كُلُّ مُستَخفٍ بِسِرٍّ","فَمِنَ اللَهِ بِمَرأى",8,"ا",1,0],["كُلٌّ مَسُوقٌ لِمَا أُرِيدَ بِهِ","فَفِيمَ هَذَا الْخِصَامُ وَاللَّدَدُ",9,"د",1,0],["كُلُّ مُسْتَأْسَرٍ يَوَدُّ انْطِلاَقاً","وَشَقَائِي بِأَنْ أَكُونَ طَلِيقَا",10,"ق",2,0],["كُلُّ مُسيءٍ إِلى شَفاعَتِهِم","في الحَشرِ يَومَ المَعادِ يَفتَقِرُ",11,"ر",1,0],["كلّ مستقبَلٍ من ال","هَمِّ يُنْسى إذا مَضَى",12,"ض",2,1],["كل مسود طلعة الأفق مب","يض جبين الفعال ينهل سجما",13,"م",2,0],["كلّ مُستبسلٍ تَراه لدى الحر","ب سفيهاً وفي النَّديِّ حليما",14,"م",2,0],["كلِّ مُسترسلٍ إلى القِرْنِ ثَبْتٍ","للمنايا كالصَّخرةِ الصَّيخودِ",15,"د",1,0],["كُلُّ مُستضحِكٍ سَيُبكيكَ وَالبا","كي سيُبكَى فَالكُلُّ قَتلى وَأَسرى",16,"ر",2,0],["كُلُّ مُستَحصِدِ العَزيمَةِ نَستَعيِ","يهِ لِلمَوتِ ما يَرُومُ فَيَسعَى",17,"ع",2,0],["كلُّ مستقتِلٍ إذا هو لم يُق","تَل غِلاباً عافَ الحياةَ حَياء",18,"ا",2,0],["كل مستجمع المكارم ينمى","لمعاليه كل فضل نام",19,"م",1,0],["كلّ مِسكٍ يُؤذي الجَريحَ وَلَكِن","مِسكُ خالِ الحَبيبِ يَشفي الجَريحا",20,"ح",2,0],["كلم سيف همه أكبادنا","إذ هو سيف للخطوب منتضى",21,"ض",2,0],["كلُّ مستصحبٍ يهون على مَن","كان ذا همَّةٍ وذا إِقدامِ",22,"م",1,0],["كل مستعصم بحزم يريه","من بعيد أمامه ما وراءا",23,"ا",3,0],["كلّ مستشيخ وهابط عقب هالطيحه غدى","شيء لا يذكر ومني تاخذ العلم الأكيد",24,"د",1,0],["كلمسةِ الوجعِ المنسيِّ أشهقُه","يذكي سعيراً سرى شوقاً لمن رحلوا",25,"ل",3,0],["كلُّ مُسْتنكِفٍ عَنِ الوِدِّ لا يَعْ","لِقُ حبلاً من الوَلاءِ وثيقا",26,"ق",2,0],["كل مساعيكم بني فاتكٍ","يسمو بها المولود والوالد",27,"د",1,0]]}