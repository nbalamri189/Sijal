على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[551,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"],[551,"يا أسم إن صبابتي","https://www.aldiwan.net/poem47301.html","مجزوء الكامل"],[551,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[551,"كم ذا نخيب وتكذب الأطماع","https://www.aldiwan.net/poem47724.html","الكامل"],[551,"قم فاثن لي فوق الوهاد وسادي","https://www.aldiwan.net/poem47843.html","الكامل"],[551,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[567,"بدت في نسوة مثل المها","https://www.aldiwan.net/poem69764.html","الهزج"],[575,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[575,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"],[575,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"]],"verses":[["وَقَضى جَنانُكَ مُذ قَضَت وَقداتُهُ","أَن لا بَقاءَ لِقَدحِ كُلِّ زِنادِ",0,"د",1,0],["وقضى عدلاً وأعلى ملة","الأعمى وتعمي من تعامى",1,"م",2,0],["وَقَضَت عَلَينا بِالمَنونِ فَعَوَّضَت","بِالكَرهِ مِن بيضِ اللَيالي سودَها",2,"د",3,0],["وَقَضَى قِيَاسُ تُرَاثِهِ عَنْ جَدِّهِ","أَنَّ الْمُقَدَّمَ فِيهِ عَيْنُ الْتَّالِي",3,"ي",1,0],["وَقَضى عاطِفٌ وَكانَ عَظيماً","صادِقَ العَزمِ مُطمَأَنَّ الخِلالِ",4,"ل",1,0],["وَقَضى كافِلُ اليَتامى فَوَيلٌ","لِليَتامى مِنَ الزَمانِ العَتِيِّ",5,"ي",1,0],["وَقَضَى خَالِدُ النَّوَى","يَتَدَاوَى مِن النَّوَى",6,"و",2,0],["وَقَضْيتَ الأَعْوَامَ فِي نُقَلٍ تَقْ","سُو تَصَارِيفُهَا وَآناً تَلِينُ",7,"ن",1,0],["وَقضَتْ عُمْرَهَا إِلَى أَنْ أَجَابَتْ","دَعْوَةَ اللهِ وَهْيَ مِنْ غَيْرِ ذَامِ",8,"م",1,0],["وقضَّى حقوق الفخر في ميعة الصِّبا","وأحسن من ديْن الكالِ التقاضيا",9,"ي",2,0],["وقضى سماحك أن تجود ببعضها","للعبد تُعليه على الجوزاءِ",10,"ا",2,0],["وقضى لها بالحق دون تحكُّم","فيها وعلّمها العلوم وأدّبا",11,"ب",2,0],["وقضى عادم المثيل فأمسى","ما لمنعاه في الخطوب مثيل",12,"ل",1,0],["وَقَضَت لَنا مُضَرٌ عَلَيكَ بِفَضلِنا","وَقَضَت رَبيعَةُ بِالقَضاءِ الفَيصَلِ",13,"ل",1,0],["وقضَّيتها والنيراتُ تمدني","سلاماً وتسليماً إلى مطلعِ الفجر",14,"ر",1,0],["وقضيبْ سيفٍ إن يهزّ تساقطت","ثمراتُ هامٍ كانَ منه لتبّع",15,"ع",1,0],["وقضيتها أوقات لهوٍ كأنما","عفا الدهرُ عنها فهوَ يقظان هاجع",16,"ع",1,0],["وقضَّيت في ظلِّ النعيم ليالياً","لو انْتقضت كانت كواكب تجْتلى",17,"ل",2,0],["وقضاءُ الإله أَحوط للنا","س من الأمهات والآباءِ",18,"ا",2,0],["وقضَى اللّه أنْ يكون سَمِيّاً","وكَنِيّاً لجَدِّه المَجْدودِ",19,"د",1,0],["وقضاءُ القرْضِ فرضٌ","يا أخا المجدِ عليكا",20,"ك",2,0],["وقضيفٍ من الرجال خفيفٍ","راجِحُ الوزن عند وزن الرجالِ",21,"ل",1,0],["وقضيتُ الرضاعَ من دِرة الكر","م لتجريم أربعين تمامِ",22,"م",1,0],["وَقَضَيتُ بَينَكُما قَضاءً فَيصَلاً","في الناسِ مِثلَ تَبَيُّنِ الفُرقانِ",23,"ن",1,0],["وَقَضَينا في الغابِ وَقتاً جَميلاً","في جِوارِ الغُدرانِ وَالأَعشابِ",24,"ب",1,0],["وَقَضَت طِفلَةٌ تَحكي المَلاكَ طَهارَةً","وَأَلحَقَها المَوتُ الزُؤامُ بِمَن عَدا",25,"د",2,0],["وَقَضى العُصورَ الناسُ في تَشِيّدِهِ","أَودَت بِهِ مَقذَفَةٌ وَثَوانِ",26,"ن",1,0],["وَقَضيبٍ ناعِمٍ","لَم أُطِق أَن أَعطِفَه",27,"ف",2,0],["وَقَضى لُبانَتَهُ مُعَيَّةُ مِنكُمُ","وَرَأى عَزيمَةَ أَمرِهِ أَن يَفعَلا",28,"ل",2,0],["وَقَضَتْ أَغاني الحُبُّ","في أَعْماقِهِ لمَّا هوى",29,"ه",3,0],["وقَضَى الحبُّ في سُكونٍ مُريعٍ","ساعَةَ الموتِ بَيْنَ سُخْطٍ وبُؤْسِ",30,"س",1,0],["وقضوا على روحِ الأخُوَّةِ بينهمْ","جَهْلاً وعاشوا عيشةَ الأغرابِ",31,"ب",1,0],["وَقَضَتْ كما شاءَ الخُلودُ","وفي جوانِحِهَا اللَّهيبْ",32,"ب",1,0],["وقضاء دهاك هد بناء ال","بر ركن العفاة والقصاد",33,"د",1,0],["وَقَضى حُقوقَ الأَهلِ يُحسِنُ تارَةً","بِأَبيهِ أَو يَصِلُ القَرابَةَ حينا",34,"ن",2,0],["وقضيبُ ريحان يَهُزُّ قوامَه","طَرَباً بهزِّ أسنَّةِ المُرَّانِ",35,"ن",1,0],["وَقَضى اللَهُ أَن أَذوبَ وَأَبلى","وَالبَلى مِن وَراءِ كُلِّ جَديدِ",36,"د",1,0],["وَقَضاءٌ إِلى الخُصومِ وَشيكٌ","لا يُرَوّى فيها وَلا يُستَشارُ",37,"ر",1,0],["وَقَضيبٍ كَأَنَّهُ نَفحَةُ المِس","كِ عَلى زَهرَةٍ غَدَت بَينَ غُدرِ",38,"ر",1,1],["وَقَضى مَظالِمَ جَدِّهِ مُتَحَرِّياً","فَتَخَلَّصَ اللوطيُّ بِالمَأبونِ",39,"ن",1,0],["وَقَضيباً رُمنا لَذيذَ جَناهُ","فَذَوى حينَ صارَ غُصناً قَويما",40,"م",2,0],["وَقَضَينا بِهِ بِاللَهوِ يَوماً","بِهِ سَمَحَت حَشا الدَهرِ العَقيمِ",41,"م",1,0],["وَقَضيتُ فيها الأَربَعينَ مُجاوِراً","مُلوكَ البَرايا وَالبُحورَ الطَوامِيا",42,"ي",2,0],["وَقَضِيَّةٌ صَمَتَ القُضاةُ تَرَفُّعاً","عَن فَصلِها وَالخَصمُ فيها يَحكُمُ",43,"م",1,0],["وقضائِه بين الذي","حفظ الوفاء ومن سلاه",44,"ا",2,0],["وقضت له الأجيال بالسلطان","اهبط على الأزهار وامسح جفنها",45,"ه",2,0],["وَقُضْباً بضربِ الطّلى مقطرات","وَقُبّاً على الهامِ تعدو هياما",46,"م",2,0],["وقضى له بالنّجْحِ مبدأُ أمرِد","ويدلّكَ الماضي على المستقبلِ",47,"ل",1,0],["وَقَضبٍ مِنَ الشَّمعِ مُصْفَرّةٍ","تُريكَ مِنَ النَّارِ نُوَّارَها",48,"ر",3,0],["وَقَضى الأَوطارَ مِنها بَعدَما","كادَتِ الأَوطارُ أَن لا تَنقَضي",49,"ي",1,0],["وقَضى الأمرَ له فيما ارتضَى","من دساتيرٍ حِسانٍ ونُظُمْ",50,"م",1,0],["وَقَضَيتَ في بَرلينَ حَقَّ شَهيدِها","فَقَضَيتَ حَقَّ اللَهِ وَالمُختارِ",51,"ر",1,0],["وقَضَى أمرَهُ فَعادَ ومنه","حِيلةٌ أُحكمتْ ورأيٌ أَسدُّ",52,"د",1,0],["وَقَضُّوا المناسِكَ مُسْتَبْشرينَ","فلم يبقَ من مأرِبٍ أو وَطَرْ",53,"ر",1,0],["وَقَضيبِ نَبعٍ كَالشُجاعِ مُعَطَّفٍ","لِرَسائِلِ المَوتِ الزُعافِ مُبَلِّغِ",54,"غ",1,0],["وَقَضاءُ شُكرٍ رُبَّما حَمَّلتَهُ","رِفقاً فَقَد أَثقَلتَهُ بِأَيادِ",55,"د",1,0],["وَقَضَتْ شَوْكَةٌ على مَهْجَةِ العا","صِي فللّهِ النَّقْمَة الشَّوْكاءُ",56,"ا",2,0],["وَقَضَتْ مَهَابَتُكُم بِتَرْكِ زيارَتِي","مَنْ ذَا يَزُورُ الأُسْدَ في الآجامِ",57,"م",1,0],["وقَضَيْتَ حَجَّ العامِ مُؤتَنِفاً وقَدْ","وَدّعْتَ عاماً للجِهادِ مُحيلا",58,"ل",2,0],["وَقَضَيتُ مِن وَرَقِ الشَبابِ حَجاً","مِن كُلِّ أَحوَزَ راجِعٍ قَصَبُه",59,"ه",1,1],["وَقَضِّ وَقتَكَ بِالتَقوى تَجَوَّزُهُ","حَتّى تُصادِفَ يَوماً فيهِ مَوقوتا",60,"ت",2,0],["وَقَضَّيتُ زَمانَ الشَر","خِ تَقيِيداً وَتَكبيلا",61,"ل",2,0],["وقَضيبٍ يميسُ فوقَ كثيبٍ","طَيِّبِ المُجْتنى لذيذِ العناقِ",62,"ق",1,1],["وَقضت أنني أَطيل وقوفاً","في ممر الشكوك والأوهام",63,"م",1,0],["وقضى الله للعزيز بنصر","فأتى نصره وكان القضاء",64,"ا",2,0],["وقَضَتْ ب