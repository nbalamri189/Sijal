{"poems":[[55,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[55,"أقول لركب خابطين إلى الندى","https://www.aldiwan.net/poem30195.html","الطويل"],[65,"على عذب الجرعاء من أيمن الحمى","https://www.aldiwan.net/poem46170.html","الطويل"],[79,"حفيد ولي الله ذي الرتبة العليا","https://www.aldiwan.net/poem35713.html","الطويل"],[73,"غياث وعمرو فاسمعوا ما علمته","https://www.aldiwan.net/poem3903.html","الطويل"],[73,"غياث فاسمعوا قولي وعمرو","https://www.aldiwan.net/poem3904.html","الوافر"],[75,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[75,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[95,"أتينا للسلام وفيه عتب","https://www.aldiwan.net/poem11252.html","الوافر"],[74,"إليك مدير الكأس عني إنني","https://www.aldiwan.net/poem18552.html","الطويل"],[53,"وهب خادما لم يوف نعماك شكرها","https://www.aldiwan.net/poem64062.html","الطويل"],[30,"غيا لباهلة التي شقيت بنا","https://www.aldiwan.net/poem1249.html",""],[76,"تشفع بعلق للشباب خطير","https://www.aldiwan.net/poem12959.html","الطويل"],[107,"وإني لأدري أن للأمر مدة","https://www.aldiwan.net/poem43096.html","الطويل"],[107,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[52,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[119,"للغوث عبد القادر الجيلاني","https://www.aldiwan.net/poem41764.html","الكامل"],[132,"سلام يسلى الفؤاد الشغيل","https://www.aldiwan.net/poem50534.html","المتقارب"],[147,"ليهنك ما شادت لك الهمم العلا","https://www.aldiwan.net/poem11807.html","الطويل"],[147,"أما ومناقب عزت مراما","https://www.aldiwan.net/poem11818.html","الوافر"],[151,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[154,"غلا الحب فابذل فيه نفسك طائعا","https://www.aldiwan.net/poem68558.html","الطويل"],[154,"عن الحب في الهادي استحال سلونا","https://www.aldiwan.net/poem68587.html","الطويل"],[254,"أتعرف من هنيدة رسم دار","https://www.aldiwan.net/poem2088.html","الوافر"],[255,"غياث الورى يوم القيامة أحمد","https://www.aldiwan.net/poem15072.html","الطويل"],[276,"متى يستقيم الظل والعود أعوج","https://www.aldiwan.net/poem52083.html","الطويل"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[422,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[422,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[422,"إذا المجد شادته القنا والصوارم","https://www.aldiwan.net/poem54162.html","الطويل"],[466,"دلفت بجيش ذي زهاء كأنه","https://www.aldiwan.net/poem15308.html","الطويل"],[466,"سهرت ونام عن سهري رجال","https://www.aldiwan.net/poem15455.html","الوافر"],[469,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[473,"غياث قد زاد تمصبطرمه","https://www.aldiwan.net/poem59646.html","السريع"],[473,"غياث بن جارود في نفسه","https://www.aldiwan.net/poem60346.html","البسيط"],[484,"راق النشيد ورقت نغمة العود","https://www.aldiwan.net/poem37170.html","البسيط"],[505,"دمعي كسيل تنمنم","https://www.aldiwan.net/poem37779.html","المجتث"],[592,"دع للعبرات تنسجم انسجاما","https://www.aldiwan.net/poem11522.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83308","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122761","المتقارب"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139070",""],[868,"","https://poetry.dctabudhabi.ae/diwan/poem/177868","السريع"],[881,"","https://poetry.dctabudhabi.ae/diwan/poem/21183","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70699","المجتث"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100141","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62466","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107198","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136161","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136336","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112794","الطويل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79456","الطويل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198874","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53204","الوافر"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110625","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132314","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102554","الوافر"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84529","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115817","الهزج"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115526","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84475","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132703","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132527","الوافر"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140031","الطويل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104301","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36735","الطويل"],[3850,"","https://poetry.dctabudhabi.ae/diwan/poem/203590","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133264","الوافر"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102993","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77155","الطويل"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146861","الكامل"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69279","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123510","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123527","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81695","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83383","الطويل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89578","الوافر"],[4575,"","https://poetry.dctabudhabi.ae/diwan/poem/31519","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120433","المتقارب"],[4789,"غياب الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=215397",""],[4884,"سَبْعٌ يَأْكُلُهُنَّ سَبْعْ","https://www.poetsgate.com/ViewPoem.aspx?id=201761",""],[5030,"يا أعز الناس","https://www.poetsgate.com/ViewPoem.aspx?id=215812",""],[5232,"الفاجعة","https://www.poetsgate.com/ViewPoem.aspx?id=213662",""],[5296,"حروف العُرْب","https://www.poetsgate.com/ViewPoem.aspx?id=155352",""],[307,"عاشق الكعبة","https://www.poetsgate.com/ViewPoem.aspx?id=213651",""],[5480,"احساسي","https://www.poetsgate.com/ViewPoem.aspx?id=10894",""],[5512,"يا دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=205119",""],[5550,"لقد وعدتني","https://www.poetsgate.com/ViewPoem.aspx?id=211487",""],[5550,"رحلْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=214912",""],[5582,"كَئِيبٌ ما النَّسِيمُ سَرَى عَلِيلا","https://www.poetsgate.com/ViewPoem.aspx?id=63608",""],[5582,"بريقٌ لاحَ مُؤْتَلِقَا","https://www.poetsgate.com/ViewPoem.aspx?id=63542",""],[5664,"الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=46385",""],[5739,"عطر ٍ نهمني","https://www.poetsgate.com/ViewPoem.aspx?id=126414",""],[5837,"غيث الجهام (هلالية)","https://www.poetsgate.com/ViewPoem.aspx?id=181595",""],[5848,"كثير من السهر","https://www.poetsgate.com/ViewPoem.aspx?id=53155",""],[5848,"ملامح غياب","https://www.poetsgate.com/ViewPoem.aspx?id=52018",""],[5848,"سكرة قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=50627",""],[5848,"صوت ريم","https://www.poetsgate.com/ViewPoem.aspx?id=48851",""],[5862,"فلّسفة .. أفكار : عطّشانه .. !!!","https://www.poetsgate.com/ViewPoem.aspx?id=31097",""],[5957,"تعال أضمكَ","https://www.poetsgate.com/ViewPoem.aspx?id=26100",""],[6093,"تَزيدُ قناعتيْ حِيْناً فحيناً","https://www.poetsgate.com/ViewPoem.aspx?id=177693",""],[6152,"غيابك","https://www.poetsgate.com/ViewPoem.aspx?id=201870",""],[6152,"ذكرتكِ في الهدا","https://www.poetsgate.com/ViewPoem.aspx?id=203177",""],[6152,"باقية بقلبي للأبد","https://www.poetsgate.com/ViewPoem.aspx?id=204658",""]],"verses":[["غِياثُ كُلِّ أَزمَةٍ","إِن عَضَّ عامٌ ماحِلُ",0,"ل",1,0],["غِياثُ النَدى ضُمَّت أَكُفٌّ وَأُغلِقَت","عَلى اللُؤمِ أَبوابُ النُفوسِ الخَسائِسِ",1,"س",1,0],["غَيارَى إذا أرْخى الظّلامُ سُدولَهُ","سَرَوْا في ضَميرِ الليلِ سِراً مُكَتَّما",2,"م",2,0],["غِياثُ مَنِ اسْتَعْدى ونُورُ مَنِ اهْتَدى","ومَلْجَأَ مَنْ أدّتْهُ داهِيَةً دَهْيا",3,"ي",2,0],["غَياثٌ وَعَمروٌ فَاِسمَعوا ما عَلِمتُهُ","لِشَيخَينِ عِندي مِن حَديثِهِما شانُ",4,"ن",1,1],["غَياثٌ نَفى عَن نَفسِهِ الحَدَّ في الزِنى","وَعَمروٌ بِتَوقيعِ الخَليفَةِ قَرنانُ",4,"ن",1,0],["غَياثٌ فَاِسمَعوا قَولي وَعَمروٌ","لَهُم عِندي أَحاديثٌ ظَريفَه",5,"ه",1,1],["غَيارى يَعُدّونَ الغَرامَ جَريرَةً","بِها وَالهَوى ظُلماً يُغيظُ وَيُؤسِفُ",6,"ف",1,0],["غَيارى مِنَ الطَيفِ المُعاوِدِ في الكَرى","مُشيحونَ مِن رَجمِ الظُنونِ غِضابُ",7,"ب",1,0],["غِيَابُكُمْ مِنْ عَاذِلِينا","حَزَازَاتٍ وَأَشْمَتَ مُبْغِضِينَا",8,"ن",2,0],["غياث الورى يومي رجاً ومخافةً","شهاب العلى نجم الهدى كوكب الندى",9,"د",2,0],["غياثكُمُ يا آلَ وهبِ فإنني","وإنْ لم أكن أعمى أضرُّ ضرير",10,"ر",1,0],["غِيّاً لِباهِلَةَ الَّتي شَقِيَت بِنا","غِيّاً يَكونُ لَها كَغُلٍّ مُجلَبِ",11,"ب",1,1],["غَيارى عَلى الأَيدي العَذارى كَأَنَّما","تُزَفُّ مِنَ الكِتمانِ خَلفَ سُتورِ",12,"ر",1,0],["غِياثَكَ ياذا الطَولِ وَالحَولِ كُلِّهِ","فَما لِلَّذي نَشكوهُ غَيرُكَ دافِعُ",13,"ع",1,0],["غِياثَكَ إِنَّ القَومَ قَد دَبَّروا لَنا","مِنَ الأَمرِ ما تَخشى النُفوسُ الجَوازِعُ",13,"ع",1,0],["غِياثَكَ يا رَبَّ البِلادِ لأمةٍ","يُهدَّمُ عالي مجدِها وَيُهضَّمُ",14,"م",1,0],["غِياثَكَ إِنّا قَد سئمنا حَياتَنا","وَمِثلُ حَياةِ الحُرِّ في مِصرَ تُسأَمُ",14,"م",1,0],["غِياثَكَ قَد ضاقَ الخِناقُ وَحَشرَجَت","نُفوسٌ إِذا استبقيتها تتلوَّمُ",14,"م",1,0],["غَيُّ الفَتى وَرُشدُهُ مَقدورُ","بَل ما لِعَيني دَمعُها غَزيرُ",15,"ر",1,0],["غياث من ناداه يوم كريهةٍ","ومغيث نادبه بكل زمان",16,"ن",1,0],["غياثُ اليتامى وليثُ الوغَى","حميدُ المساعى وغَوْث النزِيلْ",17,"ل",1,0],["غِياثِيَّةً تاجِيَّةً ناصِرِيَّةً","إِذا ما سَمَت لَم تَرضَ في الأُفقِ مَنزِلا",18,"ل",2,0],["غِياثَ المُسلِمينَ كَفَفتَ عَنهُم","عَظائِمَ تَسلُبُ اللَحمَ العِظاما",19,"م",2,0],["غياثي من أيدي العداة ومنقذي","منيري مجيري عندما غمّني الغمر",20,"ر",1,0],["غِياباتُ قَلبِي للمحبَّةِ مَطلَعٌ","ولا شَكَّ أنَّ الصَّابَ بالرَّغمِ يُمضَغُ",21,"غ",1,0],["غياثُ الوَرى في مُعضِلِ الدينِ وَالدُنا","فَلا الإِنسُ تَستَشري وَلا الجِنُّ يَنزَغُ",22,"غ",1,0],["غَيايَةُ إِبليسٍ جَلاها صَباحُهُ","فَأُنقِذَ ضُلالٌ وَأُرشِدَ زُيَّغُ",22,"غ",1,0],["غِياثُ المُرمِلينَ إِذا أَناخوا","بِهِ في اللَيلَةِ الغالي قِراها",23,"ا",3,0],["غياثُ الوَرى يومَ القيامة أحمَدُ","لامته جناتُ عدن تُسوغُ",24,"غ",1,1],["غياهبُ أهل الشركِ زالت بنورِهِ","وما زال ضوءُ الصُّبح لليل يدمَغُ",24,"غ",1,0],["غياث لملهوف وَغوث لِرائد","وَليث اذا صال الكمىّ المدجج",25,"ج",1,0],["غياثي إذا ضاقت عليَّ مذاهبي","ومنه أرجى كشف ضري وشدتي",26,"ي",1,0],["غياثٌ لملهوفٍ وأمنٌ لخائفٍ","ومأوًى لمأمونٍ ووِرْدٌ لحائم",27,"م",1,0],["غياث وغوث لا يجارى جواده","وملجأ من آويت كنت ومنجدا",28,"د",2,0],["غياث غوث كلَّما انهلَّ ساجم","تتابع في آثارها منك ساجم",29,"م",1,0],["غياثٌ لدينِ اللهِ حامي عبادهِ","وغيثٌ لأرضِ الله إذ حبُس القطر",30,"ر",1,0],["غياثُ الدين والدُّنيا بِسعْيٍ","يحوزُ الحمدَ أو يحوي الثَّوابا",31,"ب",2,0],["غياث لملهوفٍ وكفٌ لشاغب","وحفظٌ لموجودِ وردٌّ لضائع",32,"ع",1,0],["غَياثُ قَد زادَ تَمَصبَطرُمُه","وَصارَ لا يُكرِمُ مَن يَكرِمُه",33,"م",2,1],["غِياثُ بنُ جارودَ في نَفسِهِ","دَنِيٌّ وَضيعٌ وَفي هِمَّتِه",34,"ت",2,1],["غياك أهوى وغياي ارحمي دنفا","إني وإياك لم نحتج لتوكيد",35,"د",1,0],["غَيابَةُ الجُبِّ طالتْ","يا جوزِيَ الذِئبُ والدَّمْ",36,"م",1,0],["غياثاً للورى غيثاً مريعاً","هزبزاً في الوغى عضباً حساما",37,"م",2,0],["غِياثاً لِمَظلومٍ وَنَصراً لِصارِخٍ","وَضَمداً لِمَجروحٍ وَقوتاً لِصائِمِ",38,"م",1,0],["غياثُ الأَراملِ إن لَم يُعَش","بِبَرضِ النَّدى وَثِمالُ اليَتامَى",39,"م",2,0],["غياض يفيض الماء في عرصاتها","فتزهو جمالا عند ذاك وتزهر",40,"ر",1,0],["غياث دين الله في أرضه","إن أخلف البرق وضن العنان",41,"ن",1,0],["غِياثٌ لِعانٍ لَم يَجِد مَن يُغيثُهُ","وَمُختَبِطٍ يَغشى الدُخانَ غَريبُ",42,"ب",1,0],["غِياث كفيك أندى","مزنا وأغزرُ دِيمه",43,"م",2,0],["غياث البلا وغيث العهاد","وأمن العباد إذا روعوا",44,"ع",3,0],["غياثُ لملهوف أمان لخائف","ثراء لمعتِّر معاش لقان