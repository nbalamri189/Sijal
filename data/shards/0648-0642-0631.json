 ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[462,"حزت المكارم والعلى","https://www.aldiwan.net/poem16153.html","مجزوء الكامل"],[465,"ما على ما لاقيته من مزيد","https://www.aldiwan.net/poem3440.html","عموديه"],[475,"تركت ابن الحريز على ذمام","https://www.aldiwan.net/poem2157.html","الوافر"],[483,"نسيم الصبا عنعن وسلسل بنافح الت","https://www.aldiwan.net/poem24378.html","عموديه"],[501,"والذي علم القلوب المعاني","https://www.aldiwan.net/poem37736.html","الخفيف"],[501,"بين طي الحبيب والنشر معنى","https://www.aldiwan.net/poem37750.html","الخفيف"],[501,"بين النجوم وبين مسبار الضحى","https://www.aldiwan.net/poem37819.html","الكامل"],[501,"ونغمة من أيمن الحي أتت","https://www.aldiwan.net/poem37942.html","الرجز"],[515,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[516,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[516,"أيخفى صحيح الوجد والسقم لائح","https://www.aldiwan.net/poem12052.html","الطويل"],[516,"هل تبلغن لبختيار","https://www.aldiwan.net/poem12133.html","مجزوء الكامل"],[516,"لك الحسب الباقي على عقب الدهر","https://www.aldiwan.net/poem12142.html","الطويل"],[516,"فقت الملوك مهابة وجلالاً","https://www.aldiwan.net/poem12204.html","الكامل"],[538,"أنى تسدت نحونا أم يوسف","https://www.aldiwan.net/poem69412.html","الطويل"],[541,"وقرب طاهينا بلوعا كأنها","https://www.aldiwan.net/poem56738.html","الطويل"],[552,"قل لقوم شنوا المعاتب منهم","https://www.aldiwan.net/poem47170.html","الخفيف"],[552,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[552,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[552,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[552,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[552,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[552,"هل ليالي بالمنقى رجوع","https://www.aldiwan.net/poem47718.html","الخفيف"],[552,"كم ذا نخيب وتكذب الأطماع","https://www.aldiwan.net/poem47724.html","الكامل"],[559,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[559,"لمن أشتكي ما بي وما بي هو الله","https://www.aldiwan.net/poem33587.html","الطويل"],[559,"ربنا الله ذلك المتعالي","https://www.aldiwan.net/poem34231.html","الخفيف"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[559,"بعيد الشبه يا عيني","https://www.aldiwan.net/poem34737.html","الهزج"],[559,"سرينا من التوفيق فوق نجائب","https://www.aldiwan.net/poem34936.html","الطويل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[576,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"],[576,"حسنها كل ساعة يتجدد","https://www.aldiwan.net/poem3089.html","الخفيف"],[587,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"]],"verses":[["وَقَرَّبَ لي وافي العِذارِ تَلَبَّسَت","بِهِ خُيَلاءٌ ما يَزولُ اِفتِنانُها",0,"ن",3,0],["وَقَرَّها وَالرِماحُ طائِشَةٌ","وَكَفَّها وَالسُيوفُ تَزدَحِمُ",1,"م",1,0],["وَقَّرَها السَيرُ وَكانَت حِقبَةً","لَو سَمِعَت حِسُّ القُرادِ راعَها",2,"ع",3,0],["وَقَرَتهُ رَوائِعُ الدَهرِ حَتّى","لَم يُرَع غَيرَ مَرَّةٍ وَاِستَمَرّا",3,"ر",2,0],["وَقَرَ اليَومَ جُموحاً رَأسَهُ","جارَ ما جارَ طَويلاً وَقَصَد",4,"د",1,0],["وَقَرَعتُمُ بِالبيضِ حَت","تى ضاعَ في اللِمَمِ الشَبابُ",5,"ب",1,0],["وَقَرَّرتَ مَبانيهِ","عَلى الذابِلِ وَالعَضبِ",6,"ب",1,0],["وَقَرَّبتُ فَتلاءَ الذِّراعِ لِرِحلَةٍ","بِها تُدفَعُ الجُلَّى وَيُستَمطَرُ الرِّفدُ",7,"د",1,0],["وَقَرِّبْ جَوادي وَانْشُرِ الدِّرْعَ إِنَّها","إِذا الحَرْبُ حَكَّتْ بَرْكَها بِيَ لا تُطْوى",8,"و",2,0],["وَقَرُّ بَردٍ وَقَودُ فَردِ","وَدَبغُ جِلدٍ بِغَيرِ شَمسِ",9,"س",1,0],["وقَرّ سريرُ المُلْكِ لمّا حلَلْتَهُ","ولوْ لمْ تشِدْ أرْجاءَهُ كادَ يرْجُفُ",10,"ف",1,0],["وَقَرَّتْ بِمَرْآكَ الْعُيُوِنُ وَقُيِّدَتْ","بِمِنْطقِكَ الْفَصْلِ الْحِسَانِ الْغَرَائِبُ",11,"ب",1,0],["وَقَرَّبَ بَينَ المَسجِدَينِ تَقَرُّباً","إِلى المَلِكِ الأَعلى فَنِعمَ المُقَرَّبُ",12,"ب",1,0],["وَقَرقَرَت بَطنُهُ فَاِنحازَ ثُمَّ رَمى","بِسَلحَةٍ خضبَت بِالورسِ أَطماري",13,"ر",2,0],["وَقُرِّنَتِ الجُردُ العِتاقُ وَصَفَّقَت","طُبولٌ وَلاحَت لِلفِراقِ عَلاماتُ",14,"ت",1,0],["وقرده يضحكه كاشراً","لكنه يغضبه ساخرا",15,"ر",2,0],["وَقَرَرْنَا مِنَ اشتِجَارِ يَرَاعَا","تٍ تَعَالَى صَرِيرُهَا كَالْهَزِيمِ",16,"م",1,0],["وَقْرُ الحَيَاةِ بِالاشْتِرَاكِ مَخَفَّفٌ","وَبِالانْفِرَادِ بَظَلَّ وَهْوَ ثَقِيلُ",17,"ل",1,0],["وقَرمٍ يُعرِضُ الخُصمان عَنهُ","كَمَا حَادَ البِكارُ عنِ الفَنيقِ",18,"ق",1,0],["وَقَرناءَ يَدعو بِاِسمِها وَهوَ مُظلِمٌ","لَهُ صَوتُها أَو إِن رَآها زِمالُها",19,"ل",3,0],["وَقَرَّبنَ لِلأَحداجِ كُلَّ اِبنِ تِسعَةٍ","تَضيقُ بِأَعلاهُ الحَوِيَّةُ وَالرَحلُ",20,"ل",1,0],["وَقَرَّبنَ بِالزُرقِ الجَمائِلَ بَعدَما","تَقَوَّبَ عَن غِربانِ أَوراكِها الخَطرُ",21,"ر",1,0],["وَقَريَةِ لا جِنٍّ وَلا أَنَسِيَّة","مُداخِلَةٍ أَبوابُها بُنِيَت شَزرا",22,"ر",2,0],["وَقَرَّبنَ لِلأَظعانِ كُلَّ مُوقَّع","مِنَ البُزلِ يوفي بِالحَويِّةِ غارِبُه",23,"ب",2,0],["وقرَّظتكم لو أن تقريظ مادح","يواري عواراً من أديمكم النغل",24,"ل",1,0],["وَقُرصاً قد تناولنا فلاقى","بني ابنةِ مِعْير والأقورينا",25,"ن",2,1],["وَقُربى القَرابَةِ أَرعى لَها","وَفَضلُ أَخي الفَضلِ لا أَجهَلُه",26,"ل",2,0],["وَقَرما بَني البَنّا تَميمَ اِبنِ غالِبٍ","هُمامانِ طَعّانانِ في كُلِّ جَحفَلِ",27,"ل",1,0],["وَقُرَيشٌ تَلوذُ مِنّا لِواذاً","لَم يُقيموا وَخَفَّ مِنها الحُلومُ",28,"م",1,0],["وقربني جنابك بعدَ بعدٍ","ونهنهَ حاسدي بعد الجماح",29,"ح",1,0],["وقريض سلا به كلّ راوٍ","عن حبيبٍ وشاب رأس الوليد",30,"د",1,0],["وقَّرتني عن أهل ودِّي فلا","والله مالي فيهمُ فكره",31,"ر",2,0],["وقرأت في خديك بعد تأمل","خطًّا به حبّ القلوب معلق",32,"ق",1,0],["وقرَّضتَ منه أن يصادَف حِفْظُهُ","كحفظ حياض المورد الملحَ والعذبا",33,"ب",2,0],["وقِّرُوهُ لجاههِ ولسَمْتِهْ","واحفظوهُ أيضاً لحرمة أختِهْ",34,"ت",2,1],["وَقُرْبَى نِحْلَتْي أدبٍ ورأْيٍ","بأبعدَ منهما قَرُبَ البعيدُ",35,"د",1,0],["وقرى يليه لطارق طلب القرى","فجرى له بالعين والأوراق",36,"ق",1,0],["وقرونٌ يسير في سَمكها القم","لُ حِثاثاً والسير حَوْلٌ دكيك",37,"ك",1,0],["وقرنْتَ بالإيجاب أن صفّيْتَه","من كل إذلالٍ كمن يتنفّلُ",38,"ل",1,0],["وقِراها الركن أضحى","يتهاداه اسْتلامُ",39,"م",1,0],["وقرَّب منا الفرقدين ولم نكن","ننال ذراريَّ السماء القوائما",40,"م",2,0],["وَقَرَّت لَهُم عَيني بِيَومِ حُذُنَّةٍ","كَأَنَّهُمُ تَذبيحُ شاءٍ مُعتَّرِ",41,"ر",1,0],["وَقَرَّبَها مِنّي وَقَرَّبَني الهَوى","إِلى أَن ظَنَنّا أَنَّنا واحِدٌ فَردُ",42,"د",1,0],["وَقَرَّبَها مِن صَدرِهِ ثُمَّ هَزَّها","وَكادَ بِها نَحوَ الفُؤادِ يَميلُ",43,"ل",1,0],["وَقَرَّحَ الجَفنَ ماءُ جَفني","في الحُبِ ما فاضَ مِن دُموعي",44,"ي",1,0],["وَقَرَأتُ أَوصافَ المُروأَةِ في السَير","فَظَنَنتُها شَيئاً تَلاشى وَاِندَثَر",45,"ر",1,0],["وَقَرَّبَ جانِبَ الغَربِيِّ يَأدو","مَدَبَّ السَيلِ وَاِجتَنَبَ الشِعارا",46,"ر",2,0],["وَقُربَتِ الجُردُ العِتاقُ وَصُفِّقت","طُبولٌ وَلاحَت لِلفِراق عَلاماتُ",47,"ت",1,0],["وقر بعد قليل كل نابضة","الا دما عربياً كان ينفجر",48,"ر",1,0],["وقرون تلاحقت","وعصور تقضت",49,"ت",1,0],["وَقَرَعَ الساقَ لَها مِن العرب","من لاله في الأَمويين أَرب",50,"ب",1,0],["وَقَرَأَت أَورادَها","وَما دَرَت ما قَرَّتِ",51,"ت",1,0],["وَقَرَّت سُيوفُ الهِندِ وَاِرتَكَزَ القَنا","وَأَقلَعَتِ البَلوى وَأَقشَعَتِ الغُمّى",52,"م",2,0],["وَقَرَّرنَ في أُذُنَيهِ يَومَ فِطامِهِ","أَنَّ الدِماءَ مُهورَةُ العَلياءِ",53,"ا",2,0],["وَقُرىً ضَرَبنَ عَلى المَدائِنِ هالَةً","وَمَدائِنٌ حَلَّينَ أَجيادَ القُرى",54,"ر",2,0],["وقرّبوا الأمر فيه وهو إذا","سَهَّلَه الله ربنا قربا",55,"ب",2,0],["وقِرانُ مضرابٍ وزيرٍ ناطقٍ","بقرانِ لَأْمَةِ فارسٍ وسنانِ",56,"ن",1,0],["وَقُرى طَنجَةَ وَالسُدِّ الَّذي","بِمَغيبِ الشَمسِ شِعري قَد وَرَد",57,"د",1,0],["وَقَريبِ المَزارِ نائي النَوالِ","مانِعٍ وَصلُهُ عَلى كُلِّ حالِ",58,"ل",1,1],["وَقُربى الأَبعَدينَ بِما أَنالوا","تَخُصُّكَ دونَ قُربى الأَقرَبينا",59,"ن",2,0],["وقريض مثل ما تن","طق باللغو الفقاح",60,"ح",1,0],["وقَريبِ مَجنَى العُرفِ إلاّ أَنَّه","تَرمي به الهِمَّاتُ أَبعدَ مُرتمَى",61,"م",2,0],["وقَرَّبَ الحِذقُ لَفْظَها فغَدا","من قُربِهِ مُطمِعاً ومُمتَنِعا",62,"ع",2,0],["وقُرى دِجلةَ تَطفو فوقَه","واضحاتِ النَّهْجِ ما فيه وضَح",63,"ح",1,0],["وقريبةٍ من كلِّ قلبٍ إن بدَتْ","للمَرءِ أدناها إليه وقرَّبَا",64,"ب",2,1],["وقِرْنٍ شامَ صفحتَه فعادَى","صفيحةَ سيفِه عندَ الضِّرابِ",65,"ب",1,0],["وقرعُ الحسامِ الرأسَ من كلّ كافرٍ","أحبّ إلى سمعي من النّقْرِ في البمِّ",66,"م",1,0],["وقرنين أوْفَتْ منهما كلّ عقدةٍ","كَرُمّانتي بابِ الخباءِ المُقَفَّلِ",67,"ل",1,0],["وقُرَّحٍ بكُماةِ الرّوعِ مُقْدِمَةٍ","كَأنَّهُنَّ سَعَالٍ تحمِلُ الأُسُدا",68,"د",2,0],["وَقَرِّب أَنتَ تِلكَ فَإِنَّ هَمّاً","عَراني بِاِشتِجارٍ وَاِرتِفاقِ",69,"ق",1,0],["وُقُرُ النُفوسِ إِذا كَواكِبُ قَعضَبٍ","أَردَينَ عِفريتَ الوَغى المَرّيدا",70,"د",2,0],["وَقَرِينُ السُّوءِ مَجْلَبَةٌ","لِدَواعِي الْهَمِّ وَالْمِحَنِ",71,"ن",1,0],["وَقَرِيضٌ كَمَا وَشَتْ نَسَمَاتٌ","بِضَمِيرِ الأَزْهَارِ إِثْرَ الْغَمَامِ",72,"م",1,0],["وَقُربُكِ لا يُجدى عَلَيَّ وَنَأيُكُم","جَوىً داخِلٌ في القَلبِ يا هِندُ لازِمُ",73,"م",1,0],["وَقُربُكِ إِن قارَبتِ لِلشَملِ جامِعٌ","وَإِن بِنتِ يَوماً بانَ مَن أَنا آلَفُ",74,"ف",1,0],["وَقَرَّبنَ أَسبابَ الهَوى لِمُتَيَّمٍ","يَقيسُ ذِراعاً كُلَّما قِسنَ إِصبَعا",75,"ع",2,0],["وَقَرَّبتِ لي غَيرَ القَريبِ وَأَشرَفَت","هُناكَ ثَنايا ما لَهُنَّ طُلوعُ",76,"ع",1,0],["وَقَرَأنا بابَ المُضافِ عِناقاً","وَحَذَفنا الرَقيبَ كَالتَنوينِ",77,"ن",1,0],["وَقَرَبوا الأَعناق","زُلفى تراق",78,"ق",1,0],["وَقِربَةِ أَقوامٍ جَعَلتُ عِصامَها","عَلى كاهِلٍ مِنّي ذَلولٍ مُرَحَّلِ",79,"ل",1,0],["وَقَرَّتِ العَينُ مِنَ الشَيطانِ","بِما يَرى في أُمَّةِ الإيمانِ",80,"ن",1,0],["وَقُرطاسٌ قَفاهُ يَص","لُحُ في طومارِهِ المَشقُ",81,"ق",1,0],["وَقَرَّبتَ لِيَ الأَمرَ","بِإِطماعٍ وَقَصَّرتا",82,"ت",2,0],["وَقَرَّبتَ وَبَعَّدتا","وَطَوَّلتَ وَعَرَّضتا",82,"ت",2,0],["وَقَرَأْنا السلامَ أكْرَمَ خلق ال","لَه مِنْ حيثُ يُسمَعُ الإقْراءُ",83,"ا",2,0],["وَقَرَأْتُ سُلْوَانَ السَّلامِ فليسَ مِنْ","رَوْمٍ لهُ مِنِّي وَلا إِشْمامِ",84,"م",1,0],["وقَرَّطَها الدُّرَّ الذي خُلقَتْ لهُ","وِفاقاً وكانتْ منه أسْنى وأخْطرا",85,"ر",2,0],["وَقَرا مُعلِناً لِيَصدَعَ قَلبي","