{"poems":[[55,"دعا بالوحاف السود من جانب الحمى","https://www.aldiwan.net/poem29645.html","الطويل"],[79,"جاءت معذبتي في غيهب الغسق","https://www.aldiwan.net/poem61422.html","عموديه"],[74,"وقالوا أحاطت ذقنه بخدوده","https://www.aldiwan.net/poem20348.html","الطويل"],[87,"أحق أنهم دفنوا عليا","https://www.aldiwan.net/poem7117.html","الوافر"],[30,"لم أنس إذ نوديت ما قال مالك","https://www.aldiwan.net/poem1286.html",""],[71,"طول المقام بدار الحرث برح بي","https://www.aldiwan.net/poem29268.html","البسيط"],[35,"دعوني دعوني قد أطلتم عذابيا","https://www.aldiwan.net/poem25752.html","الطويل"],[83,"أشمس في غلالة أرجوان","https://www.aldiwan.net/poem61472.html","الوافر"],[50,"يا نفس كيف لطفت","https://www.aldiwan.net/poem62465.html","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42698","المتقارب"],[111,"أبا الحارث اسمع حديثا جرى","https://www.poetsgate.com/ViewPoem.aspx?id=527",""],[53,"كفى حَزَناً أَنّ الشبابَ مُعَجَّلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=22526",""],[87,"أحقُّ أنهم دفنوا عليَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9637&r=&rc=127",""],[113,"يدير علي كاسات الحميا","https://www.aldiwan.net/poem16389.html","الوافر"],[119,"عجبت لقلبي كيف لا يتفطر","https://www.aldiwan.net/poem41117.html","عموديه"],[121,"لعَينيها","https://www.aldiwan.net/poem24053.html","الوافر"],[136,"تخطى ركبه الظلل القواء","https://www.aldiwan.net/poem54900.html","الوافر"],[164,"إذا ابطات عنا من المحسن الحسنى","https://www.aldiwan.net/poem59008.html","الطويل"],[214,"وقالوا هلال الأفق في الوضع قد حكى","https://www.aldiwan.net/poem13410.html","الطويل"],[234,"رأيت في البستان إنسانة","https://www.aldiwan.net/poem51250.html","السريع"],[275,"إلام تناجيني النجوم الزواهر","https://www.aldiwan.net/poem35685.html","الطويل"],[382,"وشاحك فخر في الأنام جليل","https://www.aldiwan.net/poem59286.html","الطويل"],[382,"وقائلة وذمة ملء فيها","https://www.aldiwan.net/poem66959.html","الوافر"],[409,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[415,"يقولون قد أعولت في الدار ما كفى","https://www.aldiwan.net/poem31658.html","عموديه"],[415,"يقول صحابي قد أطلت وقوفنا","https://www.aldiwan.net/poem31671.html","عموديه"],[415,"وشائمة برقا بفودي راعها","https://www.aldiwan.net/poem31987.html","الطويل"],[415,"يقولون لي أفنيت كل ذخيرة","https://www.aldiwan.net/poem32071.html","الطويل"],[422,"يقول لي النصوح هلكت وجدا","https://www.aldiwan.net/poem53966.html","الطويل"],[463,"حاشاك من عارية ترد","https://www.aldiwan.net/poem56234.html","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38561","الوافر"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123371","المتقارب"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80243","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56252","الوافر"],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140224",""],[1501,"","https://poetry.dctabudhabi.ae/diwan/poem/146657","الوافر"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141279","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48211","الوافر"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42483","السريع"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53127","المتقارب"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53136","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47118","الطويل"],[2602,"","https://poetry.dctabudhabi.ae/diwan/poem/146647","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132688","الطويل"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70397","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74029","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91708","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128909","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128890","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114361","المتقارب"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69937","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77006","الطويل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143861","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136609",""],[4955,"إذا ما الشعر غادرني","https://www.poetsgate.com/ViewPoem.aspx?id=193735",""],[5038,"ترانيم","https://www.poetsgate.com/ViewPoem.aspx?id=189579",""],[5183,"مبعث الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=180278",""],[5273,"رسول النواعير","https://www.poetsgate.com/ViewPoem.aspx?id=215990",""],[5807,"عاتبتُ طيفَ الذي أهوى وقلتُ لتُ له","https://www.poetsgate.com/ViewPoem.aspx?id=187233",""],[6152,"بكاء رجل","https://www.poetsgate.com/ViewPoem.aspx?id=201686",""]],"verses":[["فَقُلتُ نَعَم لَم تَسمَعِ الأَذنُ دَعوَةً","بَلى إِنَّ قَلبي سامِعٌ وَجَناني",0,"ن",2,0],["فَقُلْتُ نَوَّرْتِنِي يَا خَيْرَ زَائِرَةٍ","أمَا خَشِيتِ مِنَ الحُرَّاسِ فِي الطُّرُقِ",1,"ق",1,0],["فقلت نعم ضيفٌ بقلبيَ نازل","أعظِّم مثواه وأكرم ذقنه",2,"ه",1,0],["فقلت نذيرة وبلاغ صدق","وحق لم يفاجئ مسمعيا",3,"ي",2,0],["فَقُلتُ نَعَم وَالراقِصاتِ إِلى مِنىً","لَئِن بَلَغَت بي مُنتَهى كُلِّ راغِبِ",4,"ب",1,0],["فقلتُ نحنُ قضاةَ البرِّ مهملةُ","أقدارُنا فَهْيَ كالأوقاصِ في النصبِ",5,"ب",1,0],["فَقُلتُ نَسيمَ الريحَ أَدِّ تَحِيَّتي","إِلَيها وَما قَد حَلَّ بي وَدَهانِيا",6,"ي",2,0],["فَقُلتُ نَعَم أَنا عَبدٌ ذَليلٌ","لِمَن أَهوى فَخَلّوني وَشاني",7,"ن",2,0],["فَقُلتُ نَفسي وَأَهلي","لَها الفِداءُ وَأَنتِ",8,"ت",1,0],["فَقُلْتُ نَعَمْ سَيِّدِي","وَأَبْرَحُ مِمَّا أَصِفْ",9,"ف",1,0],["فقلت نصحت وطال الوقوف","وهاضت جسوم واصلابها",10,"ب",3,0],["فقلتُ: نهار المرء أهدى لسعيه","ولكنَّ ظِلَّ الليل أندى وأبردُ",11,"د",1,0],["فقلتُ: نذيرة ٌ وبلاغُ صدق","وحقٌّ لم يفاجىء مسمعيَّا",12,"ي",2,0],["فَقُلت نَعم لَو أَنَّ الحَظ حَظ","وَزارَ السَعد نادينا وَحيا",13,"ي",2,0],["فقلت نعم لله في كل لمحة","لطائف لا تحصى ولا هي تحصر",14,"ر",1,0],["فقلتُ: نَعَمْ أَرَقُّ النَّاسِ لُطْفًا","وأخلاقًا وآراءً سَديدةْ",15,"د",2,0],["فَقَلتُ نعم إِخَالُ بِه شفائِي","أَأنتم خِلتُمالغَدَر الوَفَاءَ",16,"ا",2,0],["فقلت نعم والبدر يأخذ كلما","تنقل في النقصان والوهن أو يفنا",17,"ن",2,0],["فقلت نعم يحكي الهلال جبينه","ولكن غدا في الحسن بينهما فرق",18,"ق",1,0],["فقلتُ نِيلُوفَرةٌ هذه","أَمْ بفؤادي أنتِ لعَّابَه",19,"ب",2,0],["فَقُلتُ نَعَم والرّيحُ تنشُرُ شَعرَها","عَليَّ وذاك الشَعرُ للطّيبِ ناشر",20,"ر",1,0],["فقلَّتُنا تنبي بصدق انتخابنا","وكُثْرُهُم يُنفَى وهوَّ رذيل",21,"ل",1,0],["فقلت نعم ولكن لي رجاءٌ","إذا ما تبت تبت إلى رجائي",22,"ي",1,0],["فقلت نعم لكن أتانا مقيداً","بما شاءه فافهم وعَضَّ هنا الأيدي",23,"د",2,0],["فقلت نعم هذي ديار عهدتها","عرين أسود في الخطوب ومعقلي",24,"ل",2,0],["فقلت نعم هذي ديار عهدتها","بها معشري مثل النجوم الشوابك",25,"ك",1,0],["فقلتُ نعَم أصبحتُ طَوعَ عَواذِلي","وأصبحتُ لا أصبُو لِلَهْوٍ ولا أُصبي",26,"ب",2,0],["فقلتُ نعمْ فرَّقْتُ ما جَمَعَتْ يَدي","وأرجو غداً يأتي بما أذهبَ الأمسُ",27,"س",1,0],["فقلتُ نعم ولي جفنٌ قريح","بعبرته ولي قلبٌ جريح",28,"ح",1,0],["فقلتُ نصلٌ لا يُذَمُّ عِتقُهُ","قلنَ فأينَ الماءُ والفِرِندُ",29,"د",1,0],["فَقُلت نَدوسُ فَوقَكَ قالَ حبّاً","وَمِن أَجلي اِجعلوهُ عَلى عُيوني",30,"ي",1,0],["فقلتُ نعم في الحَشا غُلَّةٌ","أُواري بها في فؤادي أُوارا",31,"ر",2,0],["فَقُلتُ نَعَم سَيدي لقاهُ هُوَ المُنى","وَلَكنَّ حَظي دونَ ذاكَ قَصيرُ",32,"ر",1,0],["فقلت نعم صدقتم حيث إني","به شاهدت أحوالاً تعجّبْ",33,"ب",1,0],["فقلت نهار فيه ليل ممازج","وأعجب شيء في الدجنة أنوار",34,"ر",1,0],["فقلت: نهى النهيُّ عن التصابي","وأيام التصابي مستعاره",35,"ر",2,0],["فقلت نعم قالت وأين دليلكم","فقلت لها ما تشهدين دليل",36,"ل",1,0],["فقلتُ نعم وذلك للأعادي","سهامٌ عنه لم يُغْنِ الفِرارُ",37,"ر",1,0],["فقلتُ نظمي علَويٌّ ولي","غدا عليٌّ في البرايا إمامْ",38,"م",1,0],["فقلت نعم عاطفات الوزي","ر بها عزَّ فضلي واشْتَدَّ أزري",39,"ر",2,0],["فقلت نُصُّوا ركاب الحمد واخدة","إلى مقر العلا في أرض نابلس",40,"س",1,0],["فقلت نعم هو الذي أتعب العدا","لغضّ مزاياه فلم يبلغوا قصدا",41,"د",2,0],["فقلت: نذر ذاك أم قربة؟","فقال: بل عدم ورب الأنام",42,"م",1,0],["فقلت نعم ان الهموم عوارض","تزول وهمي لازم لم يفارق",43,"ق",1,0],["فقلت نعم أسعى إذا شئتُ أن أرى","ذليلا مُهانا مستخفا بموضعي",44,"ع",2,0],["فَقُلتُ نَبي فَقالَ أَجَل","حَياة الرَمائِم بُرهانيَه",45,"ي",2,0],["فَقلت نعم أَحسنتمُ في نصيحتي","وَلكنها نفس أَبتها النَفائس",46,"س",1,0],["فقلت نعم والكل منهم مصوب","إلى كبد الأوطان من قوسه نبلا",47,"ل",2,0],["فقلت نعم يحتاج لكن ضمائرا","منزهة عن ريبة الظلم والعسف",48,"ف",1,0],["فَقُلتُ نَعَم وَهوَ قَولُ خَلِيلٍ","وَخَمرٌ تَحَجَّرَ أو خُلِّلا",49,"ل",2,0],["فَقُلتُ نعم إِذا ما ادعموهُ","عَلى ما كانَ يُؤذن بالزوالِ",50,"ل",1,0],["فَقُلتُ نِعمَ إِنَّ الهَوى لا يَحل في","فُؤادِ فَيَخلو مِن هُمومِ تَواعِب",51,"ب",1,0],["فقلت نفسك إنّي وفد مكرمةٍ","واذهب فإنك في حلًّ من الكرم",52,"م",1,0],["فقلت نعم إني قتيلُ صبابةٍ","ولا أنا ممنِّ عن هَواه يحَول",53,"ل",1,0],["فقلتُ ندمتُ فاعذرني","وأرجو أن تلازمَني",54,"ن",2,0],["فقلْتُ نعمْ إذا ما بانَ يوماً","شبابي عادَ حولاً في الْغيابِ",55,"ب",1,0],["فقلت نعم فالبؤس تقفوه أنعم","ولن يغلب اليسرين عسر مطحطح",56,"ح",1,0],["فقلتُ: ناعورَتي في كلِّ مَسألَةٍ","تَخْتَصُّ في بَوحِها الأطفالَ والشُّعَرا",57,"ر",2,0],["فقلتُ: نارُ الجوى معنًى وليس لها","نورٌ يضيءُ وهذا القولُ مقبولُ",58,"ل",1,0],["فقلت: نعم بكيتك من فؤادٍ","شفيفٍ ينفث الآهات نفثا",59,"ث",2,0]]}