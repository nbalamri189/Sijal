poem63781.html","البسيط"],[62,"يا ابن الألى خضعت لملكهم","https://www.aldiwan.net/poem52378.html","أحذ الكامل"],[45,"ألمع برق سرى أم ضوء مصباح","https://www.aldiwan.net/poem62689.html","البسيط"],[45,"قد فقدنا الوفاء فقد الحميم","https://www.aldiwan.net/poem65689.html","الخفيف"],[66,"صال فينا الردى جهارا نهارا","https://www.aldiwan.net/poem40126.html","الخفيف"],[66,"ياعترة المختار يا من بهم","https://www.aldiwan.net/poem41390.html","السريع"],[44,"وثناياك إنها إغريض","https://www.aldiwan.net/poem30475.html","الخفيف"],[69,"رومية الأصل لها مقلة","https://www.aldiwan.net/poem28214.html","السريع"],[69,"قلت لفرا فرا أديمي","https://www.aldiwan.net/poem28309.html","مخلع البسيط"],[69,"رومية الأصل لها مقلة","https://www.aldiwan.net/poem28618.html","السريع"],[69,"قل لبني الناس على زعمهم","https://www.aldiwan.net/poem28736.html","السريع"],[69,"قلت لفرا فرى أديمي","https://www.aldiwan.net/poem29005.html","مخلع البسيط"],[31,"يا من لقلب متيم كلف","https://www.aldiwan.net/poem42524.html","المنسرح"],[102,"برح بي الشوق فلما طغى","https://www.aldiwan.net/poem33000.html","السريع"],[102,"قد فهمنا من الهدية معنى","https://www.aldiwan.net/poem33001.html","الخفيف"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[46,"انفرد الله بسلطانه","https://www.aldiwan.net/poem22038.html","السريع"],[46,"قد فاضت الدنيا بأدناسها","https://www.aldiwan.net/poem22847.html","السريع"],[46,"هذا زمان ليس في أهله","https://www.aldiwan.net/poem23153.html","السريع"],[76,"كم ألحم السيف في أبناء ملحمة","https://www.aldiwan.net/poem39314.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85375","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39556","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43778","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43703","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[90,"النفثة!","https://www.poetsgate.com/ViewPoem.aspx?id=179076",""],[99,"القرط الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=36382",""],[31,"يا منْ لقلبِ متيمٍ، كلفٍ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18877&r=&rc=140",""]],"verses":[["قَد فاتَ مَطلوباً وَأَدرَكَ طالِباً","وَمَقارِعوهُ عَلى الأُمورِ قُعودُ",0,"د",1,0],["قد فَشا فيكَ هُيامي في الوَرى","وهْوَ لوْلا دمْعُ عَيْني ما فَشا",1,"ش",2,0],["قد فَرَّ شيطانُها، لمّا رأى عُمَراً","إنّ الشياطينَ تَخشى بأسَ مُخزيها",2,"ي",3,0],["قَد فَسَدَت صَنعَةُ اِبنِ شيثٍ","منذُ أَزاحوهُ عَن قُمامَه",3,"م",2,1],["قَد فاضَ في هَذا نَدا","كَ وَنَعَّمَت هَذا خِلالُك",4,"ك",1,0],["قد فشي حسن واشتهر","كل قلب به انعمر",5,"ر",1,0],["قد فاتها النطق كالعجماء أرحمها","ولست أعلم أيّ السقم آذاها",6,"ا",3,0],["قد فاجأته المنايا وهو معتدل","كالرمح دقّ على الصفواء فانقصفا",7,"ف",2,0],["قد فقدنا منه خلائق تحكي","زهر الروض غبّ صوب الغمام",8,"م",1,0],["قَد فاتَ بِالغايَةِ العُليا فَأَحرَزَها","سامٍ خُروجٌ إِذا اِصطَكَّ الأَضاميمُ",9,"م",1,0],["قد فقعتْ بالتنائِي مهجةٌ نسبت","في الخاص قدماً وقد عادت من الجرج",10,"ج",1,0],["قد فطراني فما في ذا وذا كبد","شتَّان ما بين تفطيرٍ وتفطير",11,"ر",1,0],["قد فَصلتُ الحكمَ بينكما","فاستريحا طال ذا تَعَبَا",12,"ب",2,0],["قد فاز بالمجلس الشريف فبد","دِلْهُ بلحظ الرضا من الشزر",13,"ر",1,0],["قد فحصنا فوجدنا","ك رَكُوباً للجنائز",14,"ز",1,0],["قد فعلتُ القبيح وهو شبيهي","خطأً فافعلِ الجميلَ بعمدك",15,"ك",1,0],["قَد فارَقَ الدُنيا فَفارَقَها الرَجا","وَهَوَت تُعانِقُهُ فَفارَقَتِ الوَرى",16,"ا",1,0],["قَد فَرَّ بَعضُهُم وَلَكِن جُلَّهُم","طَلَبوا الفِرارَ مِنَ الفِرارِ خَيارا",17,"ر",2,0],["قَد فَتَّ في عَضُدِ القَريضِ وَهَدَّهُ","هَولُ المُصابِ فَعِقدُهُ مَحلولُ",18,"ل",1,0],["قَد فُزتُ مِنهُ بِالوِصا","لِ وَلَم أَكُن عَنهُ بِعاجِز",19,"ز",1,0],["قد فزت منك بمعبد","ورزقت قرب الموصلي",20,"ل",2,0],["قد فرش الأرض بسا","طا ناصعا لم يرقم",21,"م",1,0],["قَد فَرَغ الأَهلُ مِن الغَريبِ","وَاِشتَغَل القَريب بِالقَريب",22,"ب",1,0],["قَد فَقَدنا بِهِ بَقِيَّةَ رَهطٍ","أَيقَظوا النيلَ وادِياً وَنَزيلا",23,"ل",2,0],["قَد فَتَّحَ اللَهُ أَبواباً لَعَلَّ لَنا","وَراءَها فُسَحَ الآمالِ وَالرُحُبا",24,"ب",2,0],["قد فلّتِ الأيامُ ظالمةً","نابي وجَدَّتْ بعدُ في نهسي",25,"ي",1,0],["قَد فَتَّحَ الفَتحُ أَغلاقَ الزَمانِ لَنا","عَمّا نُحاوِلُ مِن بَذلٍ وَإِسماحِ",26,"ح",1,0],["قَد فَقَدنا الوَفاءَ فَقدَ الحَميمِ","وَبَكَينا العُلا بُكاءَ الرُسومِ",27,"م",1,1],["قَد فَقَدنا مِن طيبِ خُلقِكَ أُنساً","عَلَّمَ النَومَ عَن جُفوني النِفارا",28,"ر",2,0],["قَد فُزتُ كُلَّ الفَوزِ إِذ لَم يَزَل","صِراطُ ديني بِكُم مُستَقيم",29,"م",1,0],["قَد فَضَضنا مِن بيدِهِ خاتَمَ الخَو","فِ وَما كُلُّ خاتَمٍ مَفضوضُ",30,"ض",1,0],["قَدْ فضحتني مقلتاها فقلْ","في وجنةٍ فاضحةِ الوردي",31,"ي",1,0],["قدْ فرَّ نومي وفرَّ صبري","قالَ نعمْ مذْ عشقتُ فرّا",32,"ر",2,0],["قَدْ فضحتني وجنتاها فقلْ","في وجنةٍ فاضحةِ الوردي",33,"ي",1,0],["قدْ فَسَدَتْ واللهِ نياتُهمْ","فلا عدمْنا دولةَ التركِ",34,"ك",1,0],["قدْ فرَّ صبري وفرَّ نومي","فقال لما عشقتُ فرّا",35,"ر",2,0],["قَد فُزنَ بِالحُسنِ وَالجَمالِ مَعاً","وَفُزنَ رِسلاً بِالدَلِّ وَالخَفَرِ",36,"ر",1,0],["قد فاته دَلٌّ تعرَّفْتُهُ","فيها ومَطْلٌ كم تذوَّقتُه",37,"ت",2,0],["قَد فهمنا مِن الهَدية مَعنى","غَير مَعنى الرمان مِن كفركنا",38,"ن",2,1],["قدْ فرَّقَ التأوِيلُ بَيْنَ مُقَرَّبٍ","يَوْمَ السُّجُودِ لآدَمٍ ومُبَعَّدِ",39,"د",1,0],["قد فِئتَ من بَرَكاتِ الأبطحيِ إلى","ما لا يفيءُ إليه الظِّلُّ في الأُصُل",40,"ل",1,0],["قد فالَ رأيُكَ في الجلاد ولم تَزَلْ","آراءُ أغمارِ الرّجالِ تَفِيل",41,"ل",1,0],["قَد فُقِدَ الصِدقُ وَماتَ الهُدى","وَاِستُحسِنَ الغَدرُ وَقَلَّ الوَفاء",42,"ف",3,0],["قَد فاضَت الدُنِّيا بِأَدناسِها","عَلى بَراياها وَأَجناسِها",43,"س",3,1],["قَد فَنِيَ الوَقتُ فَما حيلَتي","إِذا اِنقَضى الإِمهالُ وَالمَهلُ",44,"ل",1,0],["قَدْ فُلِّقَتْ بِصَفيحِ الهِندِ هَامُهُمُ","فَهُنَّ بَينَ حَوَامي الخَيْلِ أَعْشارُ",45,"ر",1,0],["قَد فارق الجِسم يَسمو بعدما هبطا","روح به كان قبل الموت مرتبطا",46,"ط",2,1],["قد فاتني الصيف وخان الربيع","وكان همّي كلًُّه في الخريف",47,"ف",1,0],["قد فقدتم نصيرَكم وسُلبتم","عَضُداً شَدّ أن يُغال ويُسلبْ",48,"ب",1,0],["قد فَتّحَ التاريخُ في كتابه","يُصغِي إليهِ ويشرئبُّ المِرْقَمُ",49,"م",1,0],["قد فاجأتك غواشيه التي سكنت","إن اللياليَ ملأى بالمفاجآتِ",50,"ت",1,0],["قد فتحوا قبرس للإمام","بالسفن المزجاة كالغمام",51,"م",1,0],["قَدْ فَرَّطَتْ فِي حَظِّنَا آبَاؤُنَا","فَالخَلْقُ عَلَّ وَنَحْنُ غَيْرُ نِهَالِ",52,"ل",1,0],["قَد فَتَكتَ وَيحَكَ في","صِبيَتي وَمُذكرِها",53,"ر",3,0],["قَد فُلَّ صمصامٌ لَدَيَّ مُهَنَّدٌ","وَاِبتَزَّ عِلقٌ في يَدَيَّ نَفيسُ",54,"س",1,0],["قَد فَرغت فَادِغٌ هُناكَ وَلَو","شاءَ لَشلّت يَمينُ مَن فَدَعا",55,"ع",2,0],["قَد فاتَني مِنكَ يا عَبدَ الغنيّ فَتى","كَأَنَّهُ في سُيوفِ الهِندِ فَولاذُ",56,"ذ",1,1],["قَدْ فَدَيْنَا لِوَاءَهُ في يَدَيْه","وَفَدَيْنَاهُ حَامِلاً لِلِّوَاءِ",57,"ا",2,0],["قد فَقَدْناهُ والمُصَابُ جَلِيلٌ","وجَمِيلُ العَزَاءِ بالْحُرِّ أجْدَى",58,"د",2,0],["قد فقدنا أنطونَ بالأمس والحز","ن على فقده يُجدِّدُ حُزنَا",59,"ن",2,0],["قد فاض في طول البلاد وعرضها","لكنّه في جنبِ فَيْضِك يَصْغُر",60,"ر",1,0],["قد فَوَّضَ الأمرَ لشُبانِهِ","فكُلِّلتْ أعماله بالنجاح",61,"ح",1,0],["قد فُكَّتا.. فانفرطتْ أنجمٌ","على طريق ٍ معشبٍ.. مُزهِر ِ..",62,"ر",1,0],["قَدْ فُزْنَ بِکلْحُسْنِ والجَمَالِ معاً","وَفُزْنَ رِسْلاً بِکلدَّالِّ والخَفَرِ",63,"ر",1,0]]}