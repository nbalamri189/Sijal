oem48262.html","عموديه"],[549,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[556,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[556,"قد فاض نور الإله فيضا","https://www.aldiwan.net/poem34412.html","مخلع البسيط"],[557,"من كسر الطلم عن نفسه","https://www.aldiwan.net/poem69358.html","السريع"],[559,"يا رب إن أخطأت أو نسيت","https://www.aldiwan.net/poem27865.html","الرجز"],[560,"قد فارقت بيت إبراهيم ركن بني","https://www.aldiwan.net/poem52617.html","البسيط"],[560,"قد فارقت بنت السماط ديارها","https://www.aldiwan.net/poem52627.html","الكامل"],[560,"للموت يولد منا كل مولود","https://www.aldiwan.net/poem52755.html","البسيط"],[560,"يا أرض بيروت بشرانا وبشراك","https://www.aldiwan.net/poem52776.html","البسيط"],[560,"نفذ القضا من أوج ذلك المنبر","https://www.aldiwan.net/poem52778.html","الكامل"],[560,"عوجا على غرب لبنان الذي اشتهرا","https://www.aldiwan.net/poem52843.html","البسيط"],[560,"صدر به سعة وشوق أوسع","https://www.aldiwan.net/poem52989.html","الكامل"],[562,"دعني أخي من الأدب","https://www.aldiwan.net/poem823.html",""],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["قَد فاتَ مَطلوباً وَأَدرَكَ طالِباً","وَمَقارِعوهُ عَلى الأُمورِ قُعودُ",0,"د",1,0],["قد فَشا فيكَ هُيامي في الوَرى","وهْوَ لوْلا دمْعُ عَيْني ما فَشا",1,"ش",2,0],["قد فَرَّ شيطانُها، لمّا رأى عُمَراً","إنّ الشياطينَ تَخشى بأسَ مُخزيها",2,"ي",3,0],["قَد فَسَدَت صَنعَةُ اِبنِ شيثٍ","منذُ أَزاحوهُ عَن قُمامَه",3,"م",2,1],["قَد فاضَ في هَذا نَدا","كَ وَنَعَّمَت هَذا خِلالُك",4,"ك",1,0],["قد فشي حسن واشتهر","كل قلب به انعمر",5,"ر",1,0],["قد فاتها النطق كالعجماء أرحمها","ولست أعلم أيّ السقم آذاها",6,"ا",3,0],["قد فاجأته المنايا وهو معتدل","كالرمح دقّ على الصفواء فانقصفا",7,"ف",2,0],["قد فقدنا منه خلائق تحكي","زهر الروض غبّ صوب الغمام",8,"م",1,0],["قَد فاتَ بِالغايَةِ العُليا فَأَحرَزَها","سامٍ خُروجٌ إِذا اِصطَكَّ الأَضاميمُ",9,"م",1,0],["قد فقعتْ بالتنائِي مهجةٌ نسبت","في الخاص قدماً وقد عادت من الجرج",10,"ج",1,0],["قد فطراني فما في ذا وذا كبد","شتَّان ما بين تفطيرٍ وتفطير",11,"ر",1,0],["قد فَصلتُ الحكمَ بينكما","فاستريحا طال ذا تَعَبَا",12,"ب",2,0],["قد فاز بالمجلس الشريف فبد","دِلْهُ بلحظ الرضا من الشزر",13,"ر",1,0],["قد فحصنا فوجدنا","ك رَكُوباً للجنائز",14,"ز",1,0],["قد فعلتُ القبيح وهو شبيهي","خطأً فافعلِ الجميلَ بعمدك",15,"ك",1,0],["قَد فارَقَ الدُنيا فَفارَقَها الرَجا","وَهَوَت تُعانِقُهُ فَفارَقَتِ الوَرى",16,"ا",1,0],["قَد فَرَّ بَعضُهُم وَلَكِن جُلَّهُم","طَلَبوا الفِرارَ مِنَ الفِرارِ خَيارا",17,"ر",2,0],["قَد فَتَّ في عَضُدِ القَريضِ وَهَدَّهُ","هَولُ المُصابِ فَعِقدُهُ مَحلولُ",18,"ل",1,0],["قَد فُزتُ مِنهُ بِالوِصا","لِ وَلَم أَكُن عَنهُ بِعاجِز",19,"ز",1,0],["قد فزت منك بمعبد","ورزقت قرب الموصلي",20,"ل",2,0],["قد فرش الأرض بسا","طا ناصعا لم يرقم",21,"م",1,0],["قَد فَرَغ الأَهلُ مِن الغَريبِ","وَاِشتَغَل القَريب بِالقَريب",22,"ب",1,0],["قَد فَقَدنا بِهِ بَقِيَّةَ رَهطٍ","أَيقَظوا النيلَ وادِياً وَنَزيلا",23,"ل",2,0],["قَد فَتَّحَ اللَهُ أَبواباً لَعَلَّ لَنا","وَراءَها فُسَحَ الآمالِ وَالرُحُبا",24,"ب",2,0],["قد فلّتِ الأيامُ ظالمةً","نابي وجَدَّتْ بعدُ في نهسي",25,"ي",1,0],["قَد فَتَّحَ الفَتحُ أَغلاقَ الزَمانِ لَنا","عَمّا نُحاوِلُ مِن بَذلٍ وَإِسماحِ",26,"ح",1,0],["قَد فَقَدنا الوَفاءَ فَقدَ الحَميمِ","وَبَكَينا العُلا بُكاءَ الرُسومِ",27,"م",1,1],["قَد فَقَدنا مِن طيبِ خُلقِكَ أُنساً","عَلَّمَ النَومَ عَن جُفوني النِفارا",28,"ر",2,0],["قَد فُزتُ كُلَّ الفَوزِ إِذ لَم يَزَل","صِراطُ ديني بِكُم مُستَقيم",29,"م",1,0],["قَد فَضَضنا مِن بيدِهِ خاتَمَ الخَو","فِ وَما كُلُّ خاتَمٍ مَفضوضُ",30,"ض",1,0],["قَدْ فضحتني مقلتاها فقلْ","في وجنةٍ فاضحةِ الوردي",31,"ي",1,0],["قدْ فرَّ نومي وفرَّ صبري","قالَ نعمْ مذْ عشقتُ فرّا",32,"ر",2,0],["قَدْ فضحتني وجنتاها فقلْ","في وجنةٍ فاضحةِ الوردي",33,"ي",1,0],["قدْ فَسَدَتْ واللهِ نياتُهمْ","فلا عدمْنا دولةَ التركِ",34,"ك",1,0],["قدْ فرَّ صبري وفرَّ نومي","فقال لما عشقتُ فرّا",35,"ر",2,0],["قَد فُزنَ بِالحُسنِ وَالجَمالِ مَعاً","وَفُزنَ رِسلاً بِالدَلِّ وَالخَفَرِ",36,"ر",1,0],["قد فاته دَلٌّ تعرَّفْتُهُ","فيها ومَطْلٌ كم تذوَّقتُه",37,"ت",2,0],["قَد فهمنا مِن الهَدية مَعنى","غَير مَعنى الرمان مِن كفركنا",38,"ن",2,1],["قدْ فرَّقَ التأوِيلُ بَيْنَ مُقَرَّبٍ","يَوْمَ السُّجُودِ لآدَمٍ ومُبَعَّدِ",39,"د",1,0],["قد فِئتَ من بَرَكاتِ الأبطحيِ إلى","ما لا يفيءُ إليه الظِّلُّ في الأُصُل",40,"ل",1,0],["قد فالَ رأيُكَ في الجلاد ولم تَزَلْ","آراءُ أغمارِ الرّجالِ تَفِيل",41,"ل",1,0],["قَد فُقِدَ الصِدقُ وَماتَ الهُدى","وَاِستُحسِنَ الغَدرُ وَقَلَّ الوَفاء",42,"ف",3,0],["قَد فاضَت الدُنِّيا بِأَدناسِها","عَلى بَراياها وَأَجناسِها",43,"س",3,1],["قَد فَنِيَ الوَقتُ فَما حيلَتي","إِذا اِنقَضى الإِمهالُ وَالمَهلُ",44,"ل",1,0],["قَدْ فُلِّقَتْ بِصَفيحِ الهِندِ هَامُهُمُ","فَهُنَّ بَينَ حَوَامي الخَيْلِ أَعْشارُ",45,"ر",1,0],["قَد فارق الجِسم يَسمو بعدما هبطا","روح به كان قبل الموت مرتبطا",46,"ط",2,1],["قد فاتني الصيف وخان الربيع","وكان همّي كلًُّه في الخريف",47,"ف",1,0],["قد فقدتم نصيرَكم وسُلبتم","عَضُداً شَدّ أن يُغال ويُسلبْ",48,"ب",1,0],["قد فَتّحَ التاريخُ في كتابه","يُصغِي إليهِ ويشرئبُّ المِرْقَمُ",49,"م",1,0],["قد فاجأتك غواشيه التي سكنت","إن اللياليَ ملأى بالمفاجآتِ",50,"ت",1,0],["قد فتحوا قبرس للإمام","بالسفن المزجاة كالغمام",51,"م",1,0],["قَدْ فَرَّطَتْ فِي حَظِّنَا آبَاؤُنَا","فَالخَلْقُ عَلَّ وَنَحْنُ غَيْرُ نِهَالِ",52,"ل",1,0],["قَد فَتَكتَ وَيحَكَ في","صِبيَتي وَمُذكرِها",53,"ر",3,0],["قَد فُلَّ صمصامٌ لَدَيَّ مُهَنَّدٌ","وَاِبتَزَّ عِلقٌ في يَدَيَّ نَفيسُ",54,"س",1,0],["قَد فَرغت فَادِغٌ هُناكَ وَلَو","شاءَ لَشلّت يَمينُ مَن فَدَعا",55,"ع",2,0],["قَد فاتَني مِنكَ يا عَبدَ الغنيّ فَتى","كَأَنَّهُ في سُيوفِ الهِندِ فَولاذُ",56,"ذ",1,1],["قَدْ فَدَيْنَا لِوَاءَهُ في يَدَيْه","وَفَدَيْنَاهُ حَامِلاً لِلِّوَاءِ",57,"ا",2,0],["قد فَقَدْناهُ والمُصَابُ جَلِيلٌ","وجَمِيلُ العَزَاءِ بالْحُرِّ أجْدَى",58,"د",2,0],["قد فقدنا أنطونَ بالأمس والحز","ن على فقده يُجدِّدُ حُزنَا",59,"ن",2,0],["قد فاض في طول البلاد وعرضها","لكنّه في جنبِ فَيْضِك يَصْغُر",60,"ر",1,0],["قد فَوَّضَ الأمرَ لشُبانِهِ","فكُلِّلتْ أعماله بالنجاح",61,"ح",1,0],["قد فُكَّتا.. فانفرطتْ أنجمٌ","على طريق ٍ معشبٍ.. مُزهِر ِ..",62,"ر",1,0],["قَدْ فُزْنَ بِکلْحُسْنِ والجَمَالِ معاً","وَفُزْنَ رِسْلاً بِکلدَّالِّ والخَفَرِ",63,"ر",1,0],["قَد فَرَّق البين مِنا كُل مُجتَمع","مِن أَبناء البين لقياناً وَأَخبرهُ",64,"ر",2,0],["قد فضَّ شملُهُم عنها وقد نعبت","فيها من الحين غربانٌ غرابيبُ",65,"ب",1,0],["قد فُقْتَ أهل الزمان رأياً","وحِجًى صافيا وصُنْعَا",66,"ع",2,0],["قَد فُقتِ كُلَّ امرِىءٍ يَشدُو أو امرَأةٍ","والصُّبحُ أبلَحُ لاَ تَخفي دَلاَئِلُهُ",67,"ل",2,0],["قَد فَتَّ في الأَعضادِ هَذا المُرتَقى","وَتَفَتَّتَت مِن دونِهِ الأَكبادُ",68,"د",1,0],["قَد فاقَ جَدُّكَ جَدَّ عَمِّكَ وَهوَ مَن","ذَلَّت لِسَطوَةِ عِزِّهِ أُسدُ الشَرى",69,"ر",2,0],["قد فضل العقد النظيم درهُ","بالتبر من زان العقود نثرهُ",70,"ر",2,1],["قد فاز بالحمد إبراهيم دونكم","ونظف العرض مماشان تنظيفا",71,"ف",2,0],["قد فاض بحر سخائه بنوا له","موجوا به فالفضل من موجوبه",72,"ب",2,0],["قَد فاتَ في مُكرِهِ الأَسوا وَحيلَتِهِ","وَظُلمِهِ كُلَّ نَخّاسٍ وَمَكّاسِ",73,"س",1,0],["قَد فاجأَتْهُ المَنايا وَهيَ غادِرةٌ","فَراحَ كَالسَيفِ في الأَكفانِ يَندَرِجُ",74,"ج",1,0],["قَد فارَقَت هَذي الحَياةَ وَغادَرَت","في النّاسِ ذِكرَ فضائلٍ لَم تُكتَمِ",75,"م",1,0],["قَد فارقَت دارَ اليَاسَ الكَريمَ إِلى","دارٍ بِها أَصبَحَت في أَرفعِ الطَبقَهْ",76,"ق",2,0],["قَد فاتَ دُنياهُ فَحَلَ بَجَنةٍ","حَظُّ التُقى بِها رِضىً وَنَعيمُ",77,"م",1,0],["قَد فارَقَت دارَ إبراهيمَ راحلةً","عَن آلِ أَيوبَ وَالأَشجانُ تَردِفُها",78,"ف",3,0],["قَد فارَقَ اليَومَ آلِ الموصِلِيِّ فَتىً","كَالغُصنِ أَصبَحَ تَحتَ التُربِ يَنغَرِسُ",79,"س",1,1],["قد فسد الناس وقل الوفا","فليس من يبقى على حال",80,"ل",1,0],["قد فارق الدنيا على حسرةٍ","وهو غدا في الحشر مجهود",81,"د",1,0],["قَد فاخَرت به السماكَ والسما","محمّدُ النجيبُ والمنتجبُ",82,"ب",1,0],["قَد فَشا في مُضمَرِ الغِسلِ مِنهُ","وَضَحُ الشيبِ بَعدَ غَضِّ الشَبابِ",83,"ب",1,0],["قد فزت بالوصل مذ غاب العذول فلا","تخاف كيداً وجاء النصر والظفر",84,"ر",1,0],["قد فزعنا إليك من قيظ مصر","وبها ما عرفت من أوهام",85,"م",1,0],["قَد فَقَدنا مِنّا ومنكم كَبيراً","كان بِالأَمسِ زينةَ الكُبراءِ",86,"ا",2,0],["قَد فَضَحتَ الطينَ والماءَ 