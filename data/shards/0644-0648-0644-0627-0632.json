{"poems":[[369,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[463,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48640","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73229","الرجز"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146754","الكامل"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96080","الكامل"],[4929,"صحن الفول","https://www.poetsgate.com/ViewPoem.aspx?id=208721",""]],"verses":[["لولا زُهيرٌ والمديحُ لهُ","لم يَدْرِ هذا النّاسُ مَنْ هَرِم",0,"م",1,0],["لَولا زَمانٌ دائِرٌ مَقادُهُ","عَن الأَذى إِلى المَعاشِ الرَغَدِ",1,"د",1,0],["لولا زفيري خلف أجمالهم","ووخزُ أنفاسِيَ لم تَنسقِ",2,"ق",1,0],["لولا زوال هوى قلبي وتوبته","هويت مثلك طوع الموت اضطرب",3,"ب",1,0],["لولاَ زَمان سَلَفا","لَم يَشكُ قَلبي الأَسفا",4,"ف",2,1],["لولا زمان أزمنت حالي له","نوب تراوح تارة وتغادي",5,"د",2,0],["لولا زعيمُ بني المعلّى لم نَبُت","حتى نُصبِّحكم بجيشٍ جحفل",6,"ل",1,0],["لولا زيادة رفع السعر فيه إذا","كشفت عن كلما تحوي خوافيه",7,"ي",2,0]]}