"ر",1,0],["قَد أَمَّنَ اللَهُ مَجراها وَأَبدَلَها","بِحُسنِ عاقِبَةٍ مِن سوءِ مُنقَلَبِ",14,"ب",1,0],["قُدّامَهُم نورُ النَبِيِّ وَخَلفَهُم","هَديُ الإِمامِ القائِمِ المَحمودِ",15,"د",1,0],["قَد أَمِنّا أَن يَأمُنوكَ عَلى حا","لٍ وَلَو صَيَّروا النُجومَ حُصونا",16,"ن",2,0],["قد أمكنَ الطالبَ مطلوبُ","وأسعَدَ الغُرُّ المناجيبُ",17,"ب",1,1],["قد أمَّكَ الهارب الطريد","فآوِه أنتَ والظلام",18,"م",1,0],["قَد أَمطَرَتهُم سَماءُ الحَربِ صائِبَةً","بِالمَشرَفِيَّةِ وَالمُرّانِ كَالرُّجُمِ",19,"م",1,0],["قُدامَةُ أَمسى يَعرُكُ الجَهلُ أَنفَهُ","بِجَدّاءَ لَم يُعرَك بِها أَنفُ فاخِرِ",20,"ر",1,1],["قُدّامَهُ سِهامُهُ","مَبثوثَةٌ مِن نَظرَتِه",21,"ت",2,0],["قد أمِنّا بعَمِيدَيْ هاشِمٍ","نُوَبَ الأيّامِ من مُمْسٍ وغاد",22,"د",1,0],["قدّامهُ الرابعُ المحاكيَ في المش","يةِ قابوسَ مالك العرب",23,"ب",1,0],["قَدِ اِمتَزَجَ العالَمُ الآدَمِيُّ","فَغورِيَّةٌ مَعَ نَجدِيَّه",24,"د",3,0],["قَدِ امتطى مَطيّةً لا تَبرحُ","صائمةً قائمةً لا تَرْمَحُ",25,"ح",1,0],["قَد أَممنا المستنصريَّةَ صبحاً","فوجدناها أَرسماً وَطلولا",26,"ل",2,0],["قُدّام أَرْوعَ مِن قَوْمٍ وجدتهُم","أَرْعى لحقِّ العُلا مِن سالِفِ الأُممِ",27,"م",1,0],["قَدْ أَمَّنَ المُلْكُ عَلَى عَهْدِهِ","بِأْنِجبِ الأبْنَاءِ وَالأفْضَل",28,"ل",1,0],["قُدّامي الهَولُ يا بُنَيَّ","كُنتُ رَفيقاً فَكُن رَفيقي",29,"ق",2,0],["قد أمسَت الطير والأنعام آمنةً","والنونُ في البحرِ لم يخشَ لها فزَعُ",30,"ع",1,0],["قد آمنُوا بإِلَهِ الحُبِّ وارْتَقَبُوا","آياتِهِ بَيْنَ إجْلالٍ وإِكْبار",31,"ر",1,0],["قد أمرَّت حياتَه وشَجَتْه","وأخو الإنتقام ناعمُ بالٍ",32,"ل",1,0],["قد أمرضتهم تخمة","وحدتك سارية العظام",33,"م",1,0],["قد أمكنتك فانتهزها فرصةٌ","بالشكر والشكرُ لذيذُ لبمعتَنْق",34,"ق",1,0],["قدامةٍ وهلال لا نظير لهم","مرارةٍ وأبيّ فضلهم بانا",35,"ن",2,0],["قدّامه حاجب كلب ويتبعه","قرد كبير ودفّ وهو مصحوب",36,"ب",1,0],["قد أمنتُ الدهر أن يق","لب يوما بك ما بي",37,"ب",2,1],["قَدِ اِمتُحنوا حتّى تخلَّص صفوُهم","بِتَعذيبهم طوراً وتغريبهم طورا",38,"ر",2,0],["قَد أَماتَ الهِجرانُ صِبيانُ قَلبي","فَفُؤادي مُعَذَّبٌ في خِبال",39,"ل",1,1],["قَدْ أمّنَتْ في سُبْلها أهْوَالَها","إذْ سَوَّغَت في ظِلِّها أهْواءها",40,"ا",3,0],["قَدْ آمَنَتْكَ الْمَكْرُماتُ الْغُرُّ أَنْ","أُمْسِي لِغَيْرِكَ عافِياً وَنَزِيلا",41,"ل",2,0],["قَدْ أَمْكَنَتْكَ فَما بادَرْتَ فُرْصَتَها","مَنْ شاوَرَ الْعَجْزَ لَمْ يَسْتَنْهِضِ الْفُرَصا",42,"ص",2,0],["قَد أَمكنت فُرَصُ اللذّات فاِقضِ بها","ما فاتَ منك وَبادر نُهزَةَ الغَلَبِ",43,"ب",1,0],["قَد أَمنّا الزَمان باِسمك يا مَن","الأَمين اِسمه نَرى الأمن فاله",44,"ل",2,0],["قَد أَمنا الزَمان فيكَ اِلى أَن","صال فينا الرَدى نَهارا جهارا",45,"ر",2,0],["قد آمن اللَهُ الذي","يقتلُني من قوَدي",46,"د",2,0],["قد أمالتهم رياح من قال وقيل","لعواذل يحسدوني",47,"ي",1,0],["قد أماتت نفسه شهوتها","حين أحيت فرضها والسننا",48,"ن",2,0],["قَد أَمَّنَ اللَهُ مِن خَوفٍ وِمِن عَدَمٍ","مَن كانَ مَعنٌ لَهُ جاراً مِنَ الزَمَنِ",49,"ن",1,1],["قد أمرنا بالبر والعدل والاح","سان لا بالفجور جاء التنزيل",50,"ل",1,0],["قد أمنتْ بحسنها وصونها","عند الرجال كلَّ ما تخشى النِّسا",51,"س",2,0],["قد آمنَ الشعراءُ بعد فسوقهم","بدلائلي في فضلها وشواهدي",52,"د",2,0],["قدامَ لهذا الملكِ حُسناً وعدةً","يجتمع في سحر النُهى ويفرقُ",53,"ق",1,0],["قد أمطَرَ الخِبُّ للرَّائينَ سابِحَةً","وهلْ لهل من رقيقِ الأُفقِ أَنْواءُ",54,"ا",2,0],["قد أمسكته وقالت","حتى توفي ضماني",55,"ن",2,0],["قُدَّامكم يرجُو ابتلاَعَ بلادِكُم","هيهاتَ طعمُ المسلمين زُعَاقُ",56,"ق",1,0],["قَد أُمِّلَت أُمنِيَّةٌ مِنَ الأَمَل","وَبَعضُ ما يُؤمَلُ يُودي في الزَلَل",57,"ل",1,1],["قد أمر النبي أن يختاروا","خليفة فجعل الخيار",58,"ر",1,0],["قد امتازت نوابغنا بعلم","وآداب لهم عصرا فعصرا",59,"ر",2,0],["قد أمها الناس انتجاعا للشفا","من شاسع الاقطار ثم الداني",60,"ن",2,0],["قد أم دار الحق لا يلوي على","احد بدارة باطل ودلاس",61,"س",1,0],["قَد أمّن الكون مِن خَوف ونوّره","أَبناؤهُ الغرّ أَو آباؤُهُ الصيدُ",62,"د",1,0],["قد أمِّن الله عدوي فما","يخاف إرواحي وأسيافي",63,"ف",2,0],["قَد أَماتَ الغمّ إِذ أَحيا النُّفوسْ","وسَقانا الأُنسَ من كأسِ الطربْ",64,"ب",1,0],["قَدْ أَمَرَّ الزَّمَانُ طَوْعاً عَلَيْهِ","فَسَخَا بَعْدَ نَفْرَةٍ وَشُمُوسِ",65,"س",1,0],["قد أمَّها وجنود الله تتبعه","مثلَ الكواكب تقفو بدرَها تَبَعا",66,"ع",2,0],["قد أم بابك قارعا","وعلى علاك قد اعتمد",67,"د",1,0],["قَدِ اِمتَلأت رَوادفُها اِرتكاماً","وَدقّت مِن موشَحها الخصورُ",68,"ر",1,0],["قد آمر اللّه أن يلقى بمعتزم","من الرجال ولم يأمر بمعتزل",69,"ل",1,0],["قُدّامَ ذِئْبِ القَفْرَةِ السَمْسامِ","وَقَبْل أَوْراد القَطا النَأَّامِ",70,"م",1,0],["قد أمرته على الندامى","تيجان شعر بها تكلل",71,"ل",1,0],["قد أمنته ولا أمان لغدرها","فبدت له مما تجن علائم",72,"م",1,0],["قد أمِنوا إلا بحق سيفَكَ","وأمِنوا على الزمان حيفَكَ",73,"ك",1,0],["قد أمنَّا من الصبى بعجوز","ثم خضنا غمار كل عجوز",74,"ز",1,1],["قد أمطرت راحة الساقي الكئوس لنا","فأنبتتها رياضاً ذات نوار",75,"ر",1,0],["قد أمِنَ الناسُ به المحظورا","إذا علا المنبرَ والسريرا",76,"ر",2,0],["قَد أَمنَحُ الوُدَّ الخَلي","لَ بِغَيرِ ما شَيءٍ رُزاتُه",77,"ت",2,0],["قدامها شاؤوشها الفَصيح","بشرحها وَمَدحها يصيح",78,"ح",1,0],["قَد أَمزج حُبّكُم بِلَحمي وَدَمي","قَطعي صلتي وَفي وُجودي عَدَمي",79,"ي",1,0],["قَد أمَّهَا سُحبٌ حَمَلنَ صواعِقا","حُدِيَت إلى الشَّطِّ الخصيبِ المَرتعِ",80,"ع",1,0],["قد امتص شهدي وزعفر وردي","وعاثت يداه برمانتيا",81,"ي",2,0],["قد أملوا نيل الأماني بلا","عزم يهز الكون كالزعزع",82,"ع",1,0],["قد آمن الدنيا بشامل عدله","ونداه في أمواله غاراته",83,"ت",2,0],["قد آمن الله من خوف يروعها","هذي القلوب التي سرت بسيرته",84,"ت",2,0],["قد أمضيت هذا في وصية عبدل","ومثل الذي أوصى به والدي أمضى",85,"ض",2,0],["قَد أَمَّروه عَلى الجُنود فَظَنَّهُم","أَنقاف بَطٍّ أَو فِراخ دَجاج",86,"ج",1,0],["قَد أَمتُّم هَذي الفَضيلة عَمداً","حينَ ماتَت في النُفوس الحَميَّه",87,"ي",2,0],["قُدَّامَهُ في غُروبٍ سَهمُ قَوسِكُمُ","وَفوقَهُ خَمسَةٌ كالقَوسِ في العَينِ",88,"ن",1,0],["قَداميسُ يَقدُمُها الحَوفَزانُ","وَأَبجَرُ تَخفِقُ عِقبانُها",89,"ن",3,0],["قد أمرت البحر أن يهدي لنا","وهو وقف حيثما المولى أمر",90,"ر",1,0],["قد أمه جيش به","رحب البسيطة أظلما",91,"م",2,0],["قد آمن العرب بالقرآن عن أدب","حتى انبروا ينشرون الدين فرسانا",92,"ن",2,0],["قد امتلأنا وعودا","فلات حين مزيد",93,"د",1,0],["قدامه معتدل مائل","وفرقه فرق دقيق جليل",94,"ل",1,0],["قَد اِم