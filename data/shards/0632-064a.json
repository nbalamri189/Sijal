469,"اليوم يا ذا الفخر والمجد","https://www.aldiwan.net/poem60223.html","السريع"],[480,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[496,"راض كلا أو ساخط كالراضي","https://www.aldiwan.net/poem10225.html","الكامل"],[501,"قل للذي فينا تمسك مخلصا","https://www.aldiwan.net/poem37724.html","الكامل"],[501,"زيادة طور المرء عن حده نقص","https://www.aldiwan.net/poem37989.html","الطويل"],[501,"من بات ملتحفا في ذيل منقبتي","https://www.aldiwan.net/poem38000.html","البسيط"],[505,"حكم وعلم وسيادات وتقوا","https://www.aldiwan.net/poem38381.html","عموديه"],[507,"زيادة حسن الصوت في الخلق زينة","https://www.aldiwan.net/poem2427.html","الطويل"],[515,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[515,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[515,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[516,"الحمد للعيس بعد العزم والهمم","https://www.aldiwan.net/poem12243.html","البسيط"],[530,"بالله يا علم الهدى","https://www.aldiwan.net/poem37382.html","مجزوء الكامل"],[539,"ضاءتا كالفرقدين","https://www.aldiwan.net/poem47422.html","عموديه"],[539,"من ذاك ينكر فضل إبراهيم","https://www.aldiwan.net/poem47956.html","عموديه"],[552,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[552,"اسعد سعدت بساعة التحويل","https://www.aldiwan.net/poem47276.html","الكامل"],[552,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[552,"قم فاثن لي فوق الوهاد وسادي","https://www.aldiwan.net/poem47843.html","الكامل"],[559,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[559,"تستر السر بإفشائه","https://www.aldiwan.net/poem33527.html","السريع"],[559,"زينة الله منه حرز حريز","https://www.aldiwan.net/poem33549.html","الطويل"],[559,"ما له عندك كنه","https://www.aldiwan.net/poem33685.html","مجزوء الرمل"],[559,"زينة الله في العوالم رمز","https://www.aldiwan.net/poem34455.html","الخفيف"],[559,"زينة العبد فقره واحتياجه","https://www.aldiwan.net/poem34682.html","الخفيف"],[563,"إذا رمت نظم الشعر في مدح ذي الرشد","https://www.aldiwan.net/poem52781.html","الطويل"],[568,"قد وفينا لك بالوعد","https://www.aldiwan.net/poem69489.html","الرمل"],[568,"بوسى الليالي عقيبة النعم","https://www.aldiwan.net/poem69515.html","المنسرح"],[568,"طرق الزمان بحادث مملق","https://www.aldiwan.net/poem69576.html","الكامل"],[568,"من عذيري من عذارى رشإ","https://www.aldiwan.net/poem69595.html","الرمل"],[576,"أغناك طرفك أن تسل الأبترا","https://www.aldiwan.net/poem2954.html","الكامل"],[576,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[576,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"]],"verses":[["زَيَّنَت أَفعالُنا أَحسابَنا","زينَةَ اللَهذَمِ أُنبوبَ الرُدَيني",0,"ن",2,0],["زِيارَةٌ زَوَّرَها خاطِري","ما أَقنَعَ النَفسَ بِزَورِ المَنام",1,"م",1,0],["زَيداً وَسوداً وَالمُقَطَّعَ أَقصَدَت","أَرماحُنا وَمُجاشِعَ بنَ هِلالِ",2,"ل",1,0],["زَيدٌ مائِتٌ كَمَدَ الحُبارى","إِذا ظَعِنَت لَطيفَةُ أَو مُلِمُّ",3,"م",1,1],["زَيّافَةٍ بِالرَحلِ خَطّارَةٍ","تُلوي بِشَرخَي مَيسَةٍ قاتِرِ",4,"ر",1,0],["زَيّافَةٌ أَرمي بِها","بِاللَيلِ مَعرِضَةَ المَحافِل",5,"ل",1,0],["زَينَ الشَبابِ وَزَينَ طُلّابِ العُلا","هَل أَنتَ بِالمُهَجِ الحَزينَةِ داري",6,"ر",2,0],["زين المشارق آداباً ومعرفةً","أبشر فإنك في سركيس واجده",7,"د",2,0],["زَيْدَانُ قَدْ آنَسْتَنِي مِنْ وَحْشَةٍ","مَا كَانَ أَشْوَقَنِي إِلَى زَيْدَانِ",8,"ن",1,1],["زَيْنُ الشَّبَابِ المُلْبِسُ الْ","آدَابِ أَنْقَى طَيلَسَانِ",9,"ن",1,0],["زَيْنُ الشَّبَابِ أَتَى الحَيَاةَ مُسَلِّماً","أَوْدَاعُهُ فِي مَوْقِفِ التَّسْلِيمِ",10,"م",1,0],["زَينُ الثِيابِ وَإِن أَثوابُها اِستُلِبَت","عَلى الحَشِيَّةِ يَوما زانَها السَلَبُ",11,"ب",1,0],["زيَّنتُمُ حل البيان بسحركم","أَلِيوْمِ زينة سحركم من موعدِ",12,"د",1,0],["زَينُ المَنابِرِ حينَ تَعلو مِنبَراً","وَإِذا رَكِبتَ فَأَنتَ زَينُ المَوكِبِ",13,"ب",1,0],["زَينُ المَجالِسِ وَالفَوارِسِ وَالَّذي","بُنِيَت عَلَيهِ مَكارِمُ الأَحسابِ",14,"ب",1,0],["زَيَّنَت أَحلامُهُم أَحسابُهُم","وَكَذاكَ الحِلمُ زَينٌ لِلكَرَم",15,"م",1,0],["زَينٍ لِرائيهِ وَفَوقَ الزَينِ","يَنظُرُ مِن نارَينِ في غارَينِ",16,"ن",1,0],["زَينُ الشَبابِ أَبو فِرا","سٍ لَم يُمَتَّع بِالشَبابِ",17,"ب",1,0],["زَينِ النَدِيِّ مُعاوِدٍ يَومَ الوَغى","ضَربَ الكُماةِ بِكُلِّ أَبيَضَ سَلجَجِ",18,"ج",1,0],["زيدٌ يظل عبيدُ اللَّه يخفضُهُ","أعجِبْ بذلك والمفعول منصوبُ",19,"ب",1,0],["زينةُ سقفِ الأنامِ لا أَفلُوا","أعلامُهُ مُمطراتُهُ شُهُبُهْ",20,"ب",2,0],["زينتْ بوجه عليه فرع","يحكي ظلاماً على صباحِ",21,"ح",1,0],["زِيدَ في فيْئنا بكُمْ فامْتَطى المُنْ","فق مِنا الإِسرافَ بعد اقتصادِهْ",22,"د",2,0],["زينةُ فخرٍ إذا تَلَبَّسها","سيدُ قوم لفاخرٍ فخَره",23,"ر",2,0],["زئيري نذيري فاهرُبوا قبل وقعةٍ","تُقَضقِضُ أصلاب الرجال وتَفرس",24,"س",1,0],["زيادة من قرونٍ","على عَضُوضٍ مصوص",25,"ص",1,0],["زَيدُ بنُ عَمروٍ صَدَأُ الفُلوسِ","قَبيلَةٌ كَالمِغزَلِ المَنكوسِ",26,"س",1,1],["زينُ المهود اليومَ أن","تِ وفي غد زين الخدور",27,"ر",1,0],["زينت معناه بلفظك شائقا","وأتيت بالمعنى للفظك أزينا",28,"ن",2,0],["زين الملوك الصيد مر بزينتي","كرما وباب الله طاف ببابي",29,"ب",2,1],["زَيدانُ إِنّي مَعَ الدُنيا كَعَهدِكَ لي","رَضِيَ الصَديقِ مُقيلُ الحاسِدِ القالي",30,"ل",2,0],["زينَةٌ وَمَصلَحَةٌ","وَاِستِراحَةٌ وَدَدُ",31,"د",1,0],["زَينُ الشَبابِ قَضى وَلَم تَتَزَوَّدي","مِنهُ وَلَم تَتَمَتَّعي بِقَرابِه",32,"ب",2,0],["زيدَتِ الأَخلاقُ فيهِ حائِطاً","فَاِحتَمى فيها رِواقاً وَقِبابا",33,"ب",2,0],["زَينِ المَقاصِرِ وَالحِجا","لِ وَزَينِ مِحرابِ الصَلاةِ",34,"ه",1,0],["زيدي أَذى مُهجَتي أَزِدكِ هَوىً","فَأَجهَلُ الناسِ عاشِقٌ حاقِد",35,"د",1,0],["زِيادَةُ شَيبٍ وَهيَ نَقصُ زِيادَتي","وَقُوَّةُ عِشقٍ وَهيَ مِن قُوَّتي ضَعفُ",36,"ف",1,0],["زِيادَةً في سُبَّةَ الجُهّالِ","وَالعُضوُ لَيسَ نافِعاً في حالِ",37,"ل",1,0],["زئبق منعقد في جسد","قرّ فيه بعدما كان نفر",38,"ر",1,0],["زِيارَةٌ مِن عَميدٍ لَم يَزَل رَغَباً","يُزدارُ في شَرقِهِ الأَقصى وَيُعتَمَدُ",39,"د",1,0],["زَيَّنَ الدارَ مُشهَدٌ مِنكَ كانَت","قَبلُ تَرضاهُ مِن أَبيكَ الدارُ",40,"ر",1,0],["زَينٌ لِمَملَكَةٍ وَلَم يَعلَم بِهِ","ذيبٌ خُزاعِيُّ الهَوى وَالمَحضَرِ",41,"ر",1,0],["زينَت بِهِ الشُرطَةُ لَمَّ غَدا","إِلَيهِ مِنها النَهيُ وَالأَمرُ",42,"ر",1,0],["زينَت بِخالِدٍ الدُنيا وَزينَتُها","وَأَبسَمَ المُلكُ عَن عِزٍّ وَعَن جَذَلِ",43,"ل",1,0],["زِياداً وَإِن تَبلُغ زِياداً فَقَد أَتَت","فَتىً لِبِناءِ المَجدِ غَيرَ مُضيعِ",44,"ع",1,0],["زِيارَةَ بَيتِ اللَهِ وَاِبنِ خَليفَةٍ","تَحَلَّبُ كَفّاهُ النَدى وَأَنامِلُه",45,"ل",2,0],["زَيدُ الفَوارِسِ وَاِبنُ زَيدٍ مِنهُمُ","وَأَبو قَبيصَةَ وَالرَئيسُ الأَوَّلُ",46,"ل",1,0],["زِيادَ اِبنَ حَربٍ لَو أَظُنُّكَ تارِكي","وَذا الضَغنِ قَد خَشَّمتَهُ غَيرَ ظالِمِ",47,"م",1,0],["زينَتي لِبسُ جارِحتي في زَمانٍ","عَجِزَت راحَتاهُ عَن إِعجازِ",48,"ز",1,0],["زَينُ مَلكٍ فاقَ المَكارِمَ وَاِمتا","زَ بِالهِباتِ أَيَّ اِمتِيازِ",48,"ز",1,0],["زَينُ أَبناءِ أُرتُقَ المَلِكُ الصا","لِحُ شَمسُ الدينِ الرَفيعِ الشانِ",49,"ن",1,0],["زيته في نضوبٍ","ونارهُ في اعتلالِ",50,"ل",1,0],["زَيْنُ الحُضورِ ذَوي الفضائِلِ غائِبٌ","يا طولَ غيبةِ مُعْرِضٍ مُتَمَادِ",51,"د",1,0],["زَيَّنوا الأَرضَ كَما قَد زُيِّنَت","بِنُجومِ اللَيلِ آفاقُ الفَلَك",52,"ك",1,0],["زيادةُ الفضلِ عينُ النقصِ عندهُم","وكثرةُ المالِ فيهمْ أرفعُ الدرجِ",53,"ج",1,0],["زينُ المدارسِ جلابُ النفائسِ غ","لاَّبُ المنافس معطي القاصدِ الجدبِ",54,"ب",1,0],["زِينَتْ محاسنُها وَزِيدتْ فتنةً","فشدا بها الشّاني وغنّى الصّاحبُ",55,"ب",1,0],["زيدوا مَلائكةَ الحضارةِ إنّه","عَملٌ لَكم وَلِعصرِكم فَضّاحُ",56,"ح",1,0],["زَيَّنوها قصةً ناعقةً","زَيَّنتْ للنّاسِ مكروهَ الصَّمَمْ",57,"م",1,0],["زينَةُ الأَخبارِ فيها وَالسِيَرْ","وَجَلالُ الدَهرِ مِنها وَالعِظَمْ",58,"م",1,0],["زيدُ بنُ حارثةٍ زيدُ بنُ حارثةٍ","خَطبٌ جليلٌ وجُرحٌ ليس يَلتامُ",59,"م",1,0],["زَيْدُ بْنُ حارثةٍ يَطيرُ وَرَاءَها","مَا ظَنَّهَا بالنَّسرِ حِينَ يَطيرُ",60,"ر",1,0],["زَيَّنَ الفاحِشةَ الكُبْرَى لهم","فَأَتَوْها لا يخافونَ البَوَارا",61,"ر",2,0],["زَيدٌ وَسَعدٌ في الفوارسِ فانظُروا","إن كان يَصدقُ نفسَه المُرتابُ",62,"ب",1,0],["زِيادةُ دونه سُورٌ عليه","مِن النّفرِ الألى احتضنوه باب",63,"ب",1,0],["زَيَّنتَ مُلكَكَ إذ زَانَتكَ بَهجَتُهُ","وَبَعضُ حُليِ الوَرَى شَاك