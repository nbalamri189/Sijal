,[50,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[50,"ومريضة مرض الهوى","https://www.aldiwan.net/poem64862.html","مجزوء الكامل"],[50,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[7,"نبئت زرعة والسفاهة كاسمها","https://www.aldiwan.net/poem1995.html","الكامل"],[46,"لا تفرحن بفأل إن سمعت به","https://www.aldiwan.net/poem22121.html","البسيط"],[46,"أنسيت حق الله أم أهملته","https://www.aldiwan.net/poem22843.html","الكامل"],[15,"يا دار هند عفاها كل هطال","https://www.aldiwan.net/poem45254.html","البسيط"],[15,"أقفر من أهله ملحوب","https://www.aldiwan.net/poem45286.html","مخلع البسيط"],[76,"كتاب الشوق يطويه الفؤاد","https://www.aldiwan.net/poem39450.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85677","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30441","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55227","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54783","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54571","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55384","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55100","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55036","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54957","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54945","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54789","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54737","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54690","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142048","الرمل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199479","الهزج"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43842","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43640","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54317","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54213","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54240","البسيط"],[106,"شكر عارفة","https://www.poetsgate.com/ViewPoem.aspx?id=179475",""],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[15,"معلقة عبيد بن الأبرص","https://www.poetsgate.com/ViewPoem.aspx?id=11410",""],[45,"لا تَلْحَني، إنْ عَزّني الصّبْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31281",""],[28,"رأتني معد مصحرا فتناذرت","https://www.poetsgate.com/ViewPoem.aspx?id=21963",""],[94,"تحيّة وفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67406&r=&rc=93",""]],"verses":[["زَيَّنَت أَفعالُنا أَحسابَنا","زينَةَ اللَهذَمِ أُنبوبَ الرُدَيني",0,"ن",2,0],["زِيارَةٌ زَوَّرَها خاطِري","ما أَقنَعَ النَفسَ بِزَورِ المَنام",1,"م",1,0],["زَيداً وَسوداً وَالمُقَطَّعَ أَقصَدَت","أَرماحُنا وَمُجاشِعَ بنَ هِلالِ",2,"ل",1,0],["زَيدٌ مائِتٌ كَمَدَ الحُبارى","إِذا ظَعِنَت لَطيفَةُ أَو مُلِمُّ",3,"م",1,1],["زَيّافَةٍ بِالرَحلِ خَطّارَةٍ","تُلوي بِشَرخَي مَيسَةٍ قاتِرِ",4,"ر",1,0],["زَيّافَةٌ أَرمي بِها","بِاللَيلِ مَعرِضَةَ المَحافِل",5,"ل",1,0],["زَينَ الشَبابِ وَزَينَ طُلّابِ العُلا","هَل أَنتَ بِالمُهَجِ الحَزينَةِ داري",6,"ر",2,0],["زين المشارق آداباً ومعرفةً","أبشر فإنك في سركيس واجده",7,"د",2,0],["زَيْدَانُ قَدْ آنَسْتَنِي مِنْ وَحْشَةٍ","مَا كَانَ أَشْوَقَنِي إِلَى زَيْدَانِ",8,"ن",1,1],["زَيْنُ الشَّبَابِ المُلْبِسُ الْ","آدَابِ أَنْقَى طَيلَسَانِ",9,"ن",1,0],["زَيْنُ الشَّبَابِ أَتَى الحَيَاةَ مُسَلِّماً","أَوْدَاعُهُ فِي مَوْقِفِ التَّسْلِيمِ",10,"م",1,0],["زَينُ الثِيابِ وَإِن أَثوابُها اِستُلِبَت","عَلى الحَشِيَّةِ يَوما زانَها السَلَبُ",11,"ب",1,0],["زيَّنتُمُ حل البيان بسحركم","أَلِيوْمِ زينة سحركم من موعدِ",12,"د",1,0],["زَينُ المَنابِرِ حينَ تَعلو مِنبَراً","وَإِذا رَكِبتَ فَأَنتَ زَينُ المَوكِبِ",13,"ب",1,0],["زَينُ المَجالِسِ وَالفَوارِسِ وَالَّذي","بُنِيَت عَلَيهِ مَكارِمُ الأَحسابِ",14,"ب",1,0],["زَيَّنَت أَحلامُهُم أَحسابُهُم","وَكَذاكَ الحِلمُ زَينٌ لِلكَرَم",15,"م",1,0],["زَينٍ لِرائيهِ وَفَوقَ الزَينِ","يَنظُرُ مِن نارَينِ في غارَينِ",16,"ن",1,0],["زَينُ الشَبابِ أَبو فِرا","سٍ لَم يُمَتَّع بِالشَبابِ",17,"ب",1,0],["زَينِ النَدِيِّ مُعاوِدٍ يَومَ الوَغى","ضَربَ الكُماةِ بِكُلِّ أَبيَضَ سَلجَجِ",18,"ج",1,0],["زيدٌ يظل عبيدُ اللَّه يخفضُهُ","أعجِبْ بذلك والمفعول منصوبُ",19,"ب",1,0],["زينةُ سقفِ الأنامِ لا أَفلُوا","أعلامُهُ مُمطراتُهُ شُهُبُهْ",20,"ب",2,0],["زينتْ بوجه عليه فرع","يحكي ظلاماً على صباحِ",21,"ح",1,0],["زِيدَ في فيْئنا بكُمْ فامْتَطى المُنْ","فق مِنا الإِسرافَ بعد اقتصادِهْ",22,"د",2,0],["زينةُ فخرٍ إذا تَلَبَّسها","سيدُ قوم لفاخرٍ فخَره",23,"ر",2,0],["زئيري نذيري فاهرُبوا قبل وقعةٍ","تُقَضقِضُ أصلاب الرجال وتَفرس",24,"س",1,0],["زيادة من قرونٍ","على عَضُوضٍ مصوص",25,"ص",1,0],["زَيدُ بنُ عَمروٍ صَدَأُ الفُلوسِ","قَبيلَةٌ كَالمِغزَلِ المَنكوسِ",26,"س",1,1],["زينُ المهود اليومَ أن","تِ وفي غد زين الخدور",27,"ر",1,0],["زينت معناه بلفظك شائقا","وأتيت بالمعنى للفظك أزينا",28,"ن",2,0],["زين الملوك الصيد مر بزينتي","كرما وباب الله طاف ببابي",29,"ي",1,1],["زَيدانُ إِنّي مَعَ الدُنيا كَعَهدِكَ لي","رَضِيَ الصَديقِ مُقيلُ الحاسِدِ القالي",30,"ي",1,0],["زينَةٌ وَمَصلَحَةٌ","وَاِستِراحَةٌ وَدَدُ",31,"د",1,0],["زَينُ الشَبابِ قَضى وَلَم تَتَزَوَّدي","مِنهُ وَلَم تَتَمَتَّعي بِقَرابِه",32,"ب",2,0],["زيدَتِ الأَخلاقُ فيهِ حائِطاً","فَاِحتَمى فيها رِواقاً وَقِبابا",33,"ب",2,0],["زَينِ المَقاصِرِ وَالحِجا","لِ وَزَينِ مِحرابِ الصَلاةِ",34,"ه",1,0],["زيدي أَذى مُهجَتي أَزِدكِ هَوىً","فَأَجهَلُ الناسِ عاشِقٌ حاقِد",35,"د",1,0],["زِيادَةُ شَيبٍ وَهيَ نَقصُ زِيادَتي","وَقُوَّةُ عِشقٍ وَهيَ مِن قُوَّتي ضَعفُ",36,"ف",1,0],["زِيادَةً في سُبَّةَ الجُهّالِ","وَالعُضوُ لَيسَ نافِعاً في حالِ",37,"ل",1,0],["زئبق منعقد في جسد","قرّ فيه بعدما كان نفر",38,"ر",1,0],["زِيارَةٌ مِن عَميدٍ لَم يَزَل رَغَباً","يُزدارُ في شَرقِهِ الأَقصى وَيُعتَمَدُ",39,"د",1,0],["زَيَّنَ الدارَ مُشهَدٌ مِنكَ كانَت","قَبلُ تَرضاهُ مِن أَبيكَ الدارُ",40,"ر",1,0],["زَينٌ لِمَملَكَةٍ وَلَم يَعلَم بِهِ","ذيبٌ خُزاعِيُّ الهَوى وَالمَحضَرِ",41,"ر",1,0],["زينَت بِهِ الشُرطَةُ لَمَّ غَدا","إِلَيهِ مِنها النَهيُ وَالأَمرُ",42,"ر",1,0],["زينَت بِخالِدٍ الدُنيا وَزينَتُها","وَأَبسَمَ المُلكُ عَن عِزٍّ وَعَن جَذَلِ",43,"ل",1,0],["زِياداً وَإِن تَبلُغ زِياداً فَقَد أَتَت","فَتىً لِبِناءِ المَجدِ غَيرَ مُضيعِ",44,"ع",1,0],["زِيارَةَ بَيتِ اللَهِ وَاِبنِ خَليفَةٍ","تَحَلَّبُ كَفّاهُ النَدى وَأَنامِلُه",45,"ل",2,0],["زَيدُ الفَوارِسِ وَاِبنُ زَيدٍ مِنهُمُ","وَأَبو قَبيصَةَ وَالرَئيسُ الأَوَّلُ",46,"ل",1,0],["زِيادَ اِبنَ حَربٍ لَو أَظُنُّكَ تارِكي","وَذا الضَغنِ قَد خَشَّمتَهُ غَيرَ ظالِمِ",47,"م",1,0],["زينَتي لِبسُ جارِحتي في زَمانٍ","عَجِزَت راحَتاهُ عَن إِعجازِ",48,"ز",1,0],["زَينُ مَلكٍ فاقَ المَكارِمَ وَاِمتا","زَ بِالهِباتِ أَيَّ اِمتِيازِ",48,"ز",1,0],["زَينُ أَبناءِ أُرتُقَ المَلِكُ الصا","لِحُ شَمسُ الدينِ الرَفيعِ الشانِ",49,"ن",1,0],["زيته في نضوبٍ","ونارهُ في اعتلالِ",50,"ل",1,0],["زَيْنُ الحُضورِ ذَوي الفضائِلِ غائِبٌ","يا طولَ غيبةِ مُعْرِضٍ مُتَمَادِ",51,"د",1,0],["زَيَّنوا الأَرضَ كَما قَد زُيِّنَت","بِنُجومِ اللَيلِ آفاقُ الفَلَك",52,"ك",1,0],["زيادةُ الفضلِ عينُ النقصِ عندهُم","وكثرةُ المالِ فيهمْ أرفعُ الدرجِ",53,"ج",1,0],["زينُ المدارسِ جلابُ النفائسِ غ","لاَّبُ المنافس معطي القاصدِ الجدبِ",54,"ب",1,0],["زِينَتْ محاسنُها وَزِيدتْ فتنةً","فشدا بها الشّاني وغنّى الصّاحبُ",55,"ب",1,0],["زيدوا مَلائكةَ الحضارةِ إنّه","عَملٌ لَكم وَلِعصرِكم فَضّاحُ",56,"ح",1,0],["زَيَّنوها قصةً ناعقةً","زَيَّنتْ للنّاسِ مكروهَ الصَّمَمْ",57,"م",1,0],["زينَةُ الأَخبارِ فيها وَالسِيَرْ","وَجَلالُ الدَهرِ مِنها وَالعِظَمْ",58,"م",1,0],["زيدُ بنُ حارثةٍ زيدُ بنُ حارثةٍ","خَطبٌ جليلٌ وجُرحٌ ليس يَلتامُ",59,"م",1,0],["زَيْدُ بْنُ حارثةٍ يَطيرُ وَرَاءَها","مَا ظَنَّهَا بالنَّسرِ حِينَ يَطيرُ",60,"ر",1,0],["زَيَّنَ الفاحِشةَ الكُبْرَى لهم","فَأَتَوْها لا يخافونَ البَوَارا",61,"ر",2,0],["زَيدٌ وَسَعدٌ في الفوارسِ فانظُروا","إن كان يَصدقُ نفسَه المُرتابُ",62,"ب",1,0],["زِيادةُ دونه سُورٌ عليه","مِن النّفرِ الألى احتضنوه باب",63,"ب",1,0],["زَيَّنتَ مُلكَكَ إذ زَانَتكَ بَهجَتُهُ","وَبَعضُ حُليِ الوَرَى شَاكٍ مِنَ العَطَلِ",64,"ل",1,0],["زَيَّنَ اللَهُ خَدَّهُ","لِعَذابي بِشامَتَين",65,"ن",1,0],["زَيَّنَت لي شَواكِلي كُلَّ لَهوٍ","ذاتُ لَوثٍ مِنَ الصَباحِ الوِسام",66,"م",1,0],["زَيَّنَتها غُرَرٌ ضاحِكاتٌ","كَبُدورٍ في وُجوهِ لَيالِ",67,"ل",1,0],["زَيَّنَ اللَهُ خَدَّهُ","بِعِذارٍ مُعَلَّقِ",68,"ق",1,0],["زئيرُ ليوثٍ مُدّ في لهَواتها","وهَدْرُ قُرومٍ في الشقاشق بخبخوا",69,"خ",3,0],["زَينُ يَدِ الحامِلِ وَالقُفّازِ","فَكَم وَكَم مِن طوَّلٍ جَمّازِ",70,"ز",1,0],["زُيِّنَ أَعلاهُ بِإِشرافِهِ","وَاِنضَمَّ مِن أَسفَلِهِ المَشرَعُ",71,"ع",1,0],["زيدي عَلى نَظرَةٍ وَعداً أَعيشُ بِهِ","لا يَشتَفي الهائِمُ الحَرّانُ بِالنَظَرِ",72,"ر",1,0],["زَينُ المَلابِسِ حينَ يَلبَسُها","وَإِذا تَسَلَّبَ زانَهُ سَلَبُه",73,"ه",1,1],["زَينَ الجَواري خُلِقتِ مِن عَجَبٍ","وَالحِرصُ عَجلانُ يَفضَحُ الأَدَبا",74,"ب",2,0],["زَينُ المَجاسِدِ مِثلُها","يُشفى بِهِ ضِغنُ القُلوب",75,"ب",1,0],["زَينُ سَريرِ المُلكِ في المُغتَدى","وَغُرَّةُ المَوكِبِ في المَوكِبِ",76,"ب",1,0],["زَيدُ بنُ زَيدٍ حاضِرٌ بِعُراعِرٍ","وَعَلى كُنَيبٍ مالِكُ بنُ حِمارِ",77,"ر",1,0],["زِيادَةُ الجِسمِ عَنَّت جِسمَ حامِلِهِ","إِلى التُرابِ وَزادَت حافِراً تَعَبا",78,"ب",2,0],["زيدَت بِها أَلفٌ وَنونٌ إِنَّ مَن","فَرسَ الرِقابِ نَطَقَت بِالفِرناسِ",79,"س",1,0],["زَيّافَةٍ بِقُتودِ الرَحلِ ناجِيَةٍ","تَفري الهَجيرَ بِتَبغيلٍ وَإِرقالِ",80,"ل",1,0],["زَيتِيَّةٌ ناعِمٌ عُروقُها","وَلَيِّنٌ أَسرُها رَطيبُ",81,"ب",1,0],["زِيارتُهُ لمن يأتيهِ حَجٌّ","ومِدحتُهُ رِباطٌ أو جهادُ",82,"د",1,0],["زينوا الباطل حتى","ظنَّه الناظر حقا",83,"ق",2,1],["زئيرُ الليثِ يطربُ مسمَعيهِ","وتُشجيهِ بِرَنَّتِها الحمامهْ",84,"م",2,0],["زَيَّنُوا أَعْلاه بالدُّرِّ كما","ثقَّلُوا أَسْفَلَهُ بِالكُثُبِ",85,"ب",1,0],["زِيدُوا وَسَائِلَكُمْ لِيَرْقَى فَنُّكُمْ","وَيَعِزَّ بِالغَرَضِ الْبِعِيدِ السَّامِي",86,"م",2,0],["زِيدَتْ بِطَلْعَتِكَ السَّنِيَّةِ","رَوْعَةُ الْقَصْرِ المُشِيدْ",87,"د",1,1],["زِيدَتْ بِهِ شَرَفاً مَكَانَةُ آلِهِ","وَمَكَانَةُ العُلَمَاءِ وَالكُتَّ