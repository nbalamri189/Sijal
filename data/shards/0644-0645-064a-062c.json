te.com/ViewPoem.aspx?id=204993",""],[4984,"هي القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=175730",""],[5064,"مدُنُ القلب الضّائع","https://www.poetsgate.com/ViewPoem.aspx?id=199173",""],[3271,"دمعة في قلب الليل","https://www.poetsgate.com/ViewPoem.aspx?id=102704",""],[585,"حييت من وطنٍ كالركن مستلم","https://www.poetsgate.com/ViewPoem.aspx?id=161912",""],[585,"لا تلوموا مولعاً مضطربا","https://www.poetsgate.com/ViewPoem.aspx?id=161861",""],[5135,"اليتيم","https://www.poetsgate.com/ViewPoem.aspx?id=201796",""],[5139,"مليط","https://www.poetsgate.com/ViewPoem.aspx?id=68956",""],[5174,"اللغة العربية بين الماضي والحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=184935",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5376,"قصيدة من ملحمة سقوط بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5409,"طرق الباب حالماً بلقاها","https://www.poetsgate.com/ViewPoem.aspx?id=155363",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5550,"أضاع الغنى","https://www.poetsgate.com/ViewPoem.aspx?id=213740",""],[5582,"قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""],[5582,"طَيْفٌ سَرَى وَثِيابُ اللَّيْلِ أَخْلاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=63545",""],[5667,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=214888",""],[5691,"شحرور القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=206593",""],[5691,"الكوكب الأحمر... الوطن القادم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206733",""],[5691,"جِنين","https://www.poetsgate.com/ViewPoem.aspx?id=207074",""],[5717,"ومن شرائط النبي حمله","https://www.poetsgate.com/ViewPoem.aspx?id=170604",""],[5725,"ادمنت حبك","https://www.poetsgate.com/ViewPoem.aspx?id=190606",""],[5725,"لم يجرْني","https://www.poetsgate.com/ViewPoem.aspx?id=216019",""],[5776,"شهيدة مجهولة","https://www.poetsgate.com/ViewPoem.aspx?id=205849",""],[5781,"جمرةٌ في زحمة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=204823",""],[5883,"جند حماس","https://www.poetsgate.com/ViewPoem.aspx?id=23878",""],[5912,"يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=205008",""],[5956,"القناعة كنز لا يفنى","https://www.poetsgate.com/ViewPoem.aspx?id=192382",""],[5956,"الذين رأينا الخير والفخر وأنت منهم","https://www.poetsgate.com/ViewPoem.aspx?id=193435",""],[5956,"هو تلخيص لتاريخ العُلا","https://www.poetsgate.com/ViewPoem.aspx?id=193982",""],[5956,"يا صاحب المجد والنخوات والمُثُلِ","https://www.poetsgate.com/ViewPoem.aspx?id=194145",""],[5956,"أوَ ما نخجل من أنفسنا؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=194418",""],[6152,"تفاؤل وبشرى","https://www.poetsgate.com/ViewPoem.aspx?id=215641",""],[520,"شغل الزمان بما تقول وتفعل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577611",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""],[5001,"جاءت تسيّر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83394&r=&rc=0",""]],"verses":[["لَم يُجرِ يَوماً بِأَطرافِ العِراقِ دَماً","إِلّا وَراعَ دِماءَ القَومِ بِالشامِ",0,"م",1,0],["لَم يُجاوِز مَنازِلَ البَدرِ عَدّاً","مِن بَقايا الصَديقِ وَالأَحبابِ",1,"ب",1,0],["لَم يَجرِ في ناديكَ هُج","رُ القَولِ أَو خَلعُ العِذارِ",2,"ر",1,0],["لَم يَجرِ مُذ خُلِقَت عَلى أَنيابِها","ماءُ السِواكِ وَلَم تَمَسَّ طَهورا",3,"ر",2,0],["لم يَجشَمِ الخالِقاتُ فِريَتَها","ولم يَغِض مِن نِطَافِها السَرِبُ",4,"ب",1,0],["لم يجرِ دمعي في هواه مسلسلا","حتَّى ثوى قلبي لديهِ مقيَّدا",5,"د",2,0],["لم يَجُع ضيفُكم ولا الجار مَزْؤو","دٌ له في جواركم مَبْهوتُ",6,"ت",1,0],["لم يجعل الله فضلاً","شاركتني فيه ضَيقا",7,"ق",2,0],["لم يجمع المال ببذل استه","من فرق شتى وتفريق",8,"ق",1,0],["لم يجْعَلِ الغدْر للوفاءِ أخاً","مُذْ كان في فَتْكه ولا نُسُكهْ",9,"ك",2,0],["لم يجدْ نفسه ألامتْ فيلحا","ها ولم ينصرف بخدٍّ لطيمِ",10,"م",1,0],["لَم يَجرُدها في الشِتا مِن وَشيِها","بَل كَساها رَوعَةً فَوقَ بَهاها",11,"ا",3,0],["لَم يَجحَدِ الفُصحى وَلَم يَهجُم عَلى","أُسلوبِها أَو يُزرِ بِالأَوضاعِ",12,"ع",1,0],["لَم يَجِد أَعوانَهُ وَالخَدَما","جانَبوهُ غَيرَ بَدرِ الكَيِّسِ",13,"س",1,0],["لَم يَجرِ لِلدَهرِ إِعذارٌ وَلا عُرُسٌ","إِلّا بِأَيّامِنا أَو في لَيالينا",14,"ن",2,0],["لَم يَجِئ بِها","شاعِرٌ ذَهَب",15,"ب",1,0],["لم يجتَذِبْ طَرْفاً شَمائلُ طَرْفِه","إلا ثَنَتْه حائراً في المِحجَرِ",16,"ر",1,0],["لم يَجرِ همسٌ لك في خاطرٍ","إلا جرى عندي كأني صداك",17,"ك",1,0],["لَم يُجمَعا قَطُّ لِعَيني وَقَد","يَجتَمِعُ النَرجِسُ وَالوَردُ",18,"د",1,0],["لَم يَجتَمِع قَطُّ في مِصرٍ وَلا طَرَفٍ","مُحَمَّدُ بنُ أَبي مَروانَ وَالنُوَبُ",19,"ب",1,0],["لَم يَجعَلِ اللَهُ في أَشلائِها أَرَباً","لِكُلِّ حُرٍّ أَبِيِّ النَفسِ مِفضالِ",20,"ل",1,0],["لَم يَجِد غالِبٌ وَراءَكَ مَعَدىً","لِتِراتٍ وَلا دَمٌ مَطلولُ",21,"ل",1,0],["لَم يَجهَلوهُ غَيرَ أنَّ سُيُوفَهُ","أَبقَت حُقُوداً عِنْدَهُم وذُحُولا",22,"ل",2,0],["لم يجهل القوْمُ إذ ولّوكَ ثغرَهُمُ","لِما تأشّبَ منه كلُّ حُوذي",23,"ي",1,0],["لم يَجْهلوا ما تُلاقي في التشيُّع من","تحريض شارِيَةٍ أو بأسِ شارِيّ",23,"ي",1,0],["لَم يَجِفَّ المَنزوعُ عَنِّيَ حَتّى","بَلَّتِ العَينُ ذا لِطولِ اِنتِحابِ",24,"ب",1,0],["لَم يَجرِ في البَيتِ مِنهُ وَقَد","عُذتُ بِالأَركانِ وَالحُجُبِ",25,"ب",1,0],["لَم يَجفُها مِبزَلُ القَومِ حَت","تى نَجَمَت مِثلَ نُجومِ السِنانِ",26,"ن",1,0],["لم يجفّ من كبَرٍ عمّا يُراد بهِ","من الأمور ولا أزرى به الصغَر",27,"ر",1,0],["لَم يَجِد عِندَ أَكبَرَيهِ سُموّاً","فَاِعتَزى فَضلُهُ إِلى أَصغَرَيهِ",28,"ر",3,0],["لَم يجدني لَهفي عَلى شَعري الَّذي","بان البياض عليه بعد سواد",29,"د",1,0],["لَمْ يَجْهَلِ الْعَادِي عَلَيْهِ أَنَّهُ","يُودَى بِهِ وَأنْقَضَّ غَيْرَ مُبَالِي",30,"ل",2,0],["لَمْ يَجِدْ نَيْرُون أَبْهَى فَلجاً","مِنْ تشَظِّيها وَلا أَعْذبَ ثَغْرَا",31,"ر",2,0],["لَم يَجهَلِ القَومُ مِنهُ فَضلَ ماعَرِفوا","لَكِن عَرَفتَ مِنَ التَسليمِ ماجَهِلوا",32,"ل",3,0],["لَم يجبر العَظمَ حَتّى هاضَ وا أسفاً","ما اِبتَزَّ لي حَسَناتي غَيرُ إِجرامي",33,"م",2,0],["لم يجِدْ للعُلاَ سواه مَثِيلاً","ولبَدْرِ السماءِ إِلاَّهُ نِدّا",34,"د",2,0],["لم يجنها إلا رقيقُ شعوره","والمرهفُ الحساس من وجدانه",35,"ن",2,0],["لم يجدْ غيرَ بشاشاتِ المُنَى","وارتياحِ للندَى أيَّ ارتيَاح",36,"ح",1,0],["لم يَجنِ شهدَ العلمِ إلا","مَن تجرَّعَ كأس صابه",37,"ب",2,0],["لم يجرعْهُ كُئوسَ الشَّهد، بَلْ","كم كئوس من زُعَاف جَرَّعَه",38,"ع",2,0],["لم يُجْدِهمْ عَرْض اقترا","ح، أو مناقشةُ اقتراح",39,"ح",1,0],["لم يجردها الشتا من وشيها","بل كساها روعة فوق بهاها",40,"ا",3,0],["لَم يجِد مَن أرَادَ مَعنًى قَوِيماً","مِن مَعَانِيهِ فِيهِ مَعنًى قَوِيمَا",41,"م",2,0],["لَم يَجِدِ الراغِبونَ مُنفَسَحاً","عَنكَ وَلا الراهِبونَ مُندَفَعا",42,"ع",2,0],["لَم يَجحَدِ الأَعداءُ واضِحَ مَجدِهِم","كَيفَ الجُحودُ وَسابِقٌ بُرهانُهُ",43,"ن",2,0],["لم يجعل الله الخلافةَ والعلا","فيكم لمعنى كان بل لمعاني",44,"ن",2,0],["لم يَجهل الحُبَّ ولا عابَه","فجاد بِالوَصل على عَبده",45,"د",2,0],["لم يجتمع قطّ قلبي هوى أحد","ممّن هويت وإغباقٌ إلى رفث",46,"ث",1,1],["لَم يجحدِ اللَّهَ لم يجحد نبوّته","إلّا عمٍ عن طريقِ الرشد ضلّيلُ",47,"ل",1,0],["لم يجد للحُبّ في فردَوسهِ","لذَةٌ إن عَبَّ من أنهارِه",48,"ه",1,0],["لم يجد وهو الذي يشكو الصدى","نشوةً مثلَ التي في نارهِ",48,"ه",1,0],["لَمْ يَجِدْ الطالبونَ شبيهاً له","إنْ انجدا أوْ هُمْ حَوَتْهُم حزونُ",49,"ن",1,0],["لم يجاوِز حَدَّ الثلاثين إلا","بليالٍ ليست لها تكثِير",50,"ر",1,0],["لَمْ يَجْنِ تَمْرَ الْعِلْمِ بَلْ","لَمْ يَدْرِ كَيْفَ الْعِلْمُ يُنْشَدْ",51,"د",1,0],["لَمْ يَجْدِهِ الْعِلْمُ حِينَ حَصَّلَهُ","بِالدَّرْسِ لِلنَّفْسِ لاَ لِلَّهِ بِالنُّورِ",52,"ر",1,0],["لم يجمع الجبارُ بين قلوبهم","إلا ليهلك معتد وضليل",53,"ل",1,0],["لَم يُجرِ لي النَدمانُ يَوماً ذِكرَهُ","إِلّا عَضَضتُ أَنامِلَ النَدمانِ",54,"ن",1,0],["لَم يجتَمع في بيوتِ الآلِ معظمُ ما","في بَيتِهم مِن مَزايا كلّها علمُ",55,"م",1,0],["لم يجاهد ليكنز المال أو","يبنى مجداً على رقاب العبيد",56,"د",1,0],["لَمْ يَجِدْ غَيْرَ فُؤَادِي هَدَفاً","عِندَما فَوَّقَ مِن لَحْظٍ سِهَامَا",57,"م",2,0],["لَم يَجرِ ما أَجرى عَلَيهِ لا وَلا","ساواهُ في الرُتبَةِ ما عِندَ صَدَر",58,"ر",1,0],["لم يَجِدْ دمعاً فأكثرَ لَمْعاً","خَوْفَ أنْ يُسْمَى بجَهْمٍ جَهام",59,"م",1,0],["لم يَجتذِبْ لرداء مُلكِكَ هُدْبَه","إلاّ لكأْسِ رداهُ صِرْفاً حاس",