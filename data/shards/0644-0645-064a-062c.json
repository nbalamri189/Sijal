{"poems":[[53,"هل كان يومك إلا بعد أيام","https://www.aldiwan.net/poem29754.html","البسيط"],[86,"دمعة من دموع عهد الشباب","https://www.aldiwan.net/poem10372.html","الخفيف"],[86,"يا كاسي الأخلاق في","https://www.aldiwan.net/poem68899.html","مجزوء الكامل"],[27,"صرم الخليط تباينا وبكورا","https://www.aldiwan.net/poem5774.html","الكامل"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[72,"قمرا نراه أم مليحا أمردا","https://www.aldiwan.net/poem18555.html","الكامل"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[51,"قل للسفيه شنيف","https://www.aldiwan.net/poem65705.html","المجتث"],[51,"سائل أبا الصقر إذا جئته","https://www.aldiwan.net/poem65723.html","السريع"],[51,"نادمت بدر السماء في فلكه","https://www.aldiwan.net/poem65770.html","المنسرح"],[51,"لانتقام المظلوم أربى على الظالم","https://www.aldiwan.net/poem66060.html","الخفيف"],[91,"هذه ملفرد قد لاحت رباها","https://www.aldiwan.net/poem62802.html","عموديه"],[85,"اخترت يوم الهول يوم وداع","https://www.aldiwan.net/poem62860.html","الكامل"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[85,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[61,"غنت تحاوره بطرف أحور","https://www.aldiwan.net/poem51605.html","الكامل"],[97,"إني على كاسي أعيد السنين","https://www.aldiwan.net/poem24921.html","السريع"],[44,"آنسني من بعدك الوجد","https://www.aldiwan.net/poem30262.html","السريع"],[44,"قد نابت الجزع من أروية النوب","https://www.aldiwan.net/poem30576.html","البسيط"],[105,"هي الدراري فأين المطمح العالي","https://www.aldiwan.net/poem43059.html","البسيط"],[21,"إن عمرا وما تجشم عمرو","https://www.aldiwan.net/poem36178.html","الخفيف"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[48,"رب ليل قطعته بانتحاب","https://www.aldiwan.net/poem10793.html","الخفيف"],[48,"يا بني حمالة الحطب","https://www.aldiwan.net/poem62416.html","المديد"],[48,"ومؤاتي الطرف عف اللسان","https://www.aldiwan.net/poem65277.html","المديد"],[48,"من كان يعجبه الأنثى ويعجبها","https://www.aldiwan.net/poem66548.html","البسيط"],[46,"لن تريه إن كنت لما تريه","https://www.aldiwan.net/poem23596.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85344","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/1007","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54246","الرمل"],[106,"تحية وتقدير","https://www.poetsgate.com/ViewPoem.aspx?id=179700",""],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[91,"أم القرى","https://www.poetsgate.com/ViewPoem.aspx?id=53352",""],[133,"جعلت بيننا الرباب النمو ما","https://www.aldiwan.net/poem54747.html","الخفيف"],[144,"دل على المجد من إليه سعى","https://www.aldiwan.net/poem11778.html","المنسرح"],[144,"أما الزمان ففي يديك عنانه","https://www.aldiwan.net/poem11830.html","الكامل"],[161,"جمع الملا يحيى على القرآن","https://www.aldiwan.net/poem58850.html","الكامل"],[162,"الحمد لله على ساعة","https://www.aldiwan.net/poem4114.html","السريع"],[187,"لم يجتمع قط قلبي هوى أحد","https://www.aldiwan.net/poem44091.html","البسيط"],[190,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[198,"أوقديها وذريها في حشايا","https://www.aldiwan.net/poem39942.html","الرمل"],[213,"أتعز على الكريم النون","https://www.aldiwan.net/poem37827.html","المنسرح"],[230,"قسمة الموت قسمة لا تجور","https://www.aldiwan.net/poem51020.html","الخفيف"],[238,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[238,"أشكر لمندوصة خير الأخايير","https://www.aldiwan.net/poem18831.html","البسيط"],[240,"لمقامك التعظيم والتبجيل","https://www.aldiwan.net/poem23840.html","الكامل"],[283,"ومهفهف الأعطاف يشكو خصره","https://www.aldiwan.net/poem32352.html","الكامل"],[306,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[329,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[349,"ليت من أسبل من شعر ظلاما","https://www.aldiwan.net/poem20668.html","الرمل"],[350,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[365,"شام برقا من أقاصي الشآم","https://www.aldiwan.net/poem60641.html","المديد"],[365,"البحر أجمع لو غدا أنقاسي","https://www.aldiwan.net/poem60869.html","الكامل"],[365,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[367,"لقد حلفت ولم أحلف على الكذب","https://www.aldiwan.net/poem16918.html","البسيط"],[407,"إن كنت تصدق في ادعاء وداده","https://www.aldiwan.net/poem50188.html","الكامل"],[454,"وطن الدولار هذا أم ترى","https://www.aldiwan.net/poem61565.html","الرمل"],[459,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[459,"حملت ركاب الغرب شمس شروق","https://www.aldiwan.net/poem56100.html","الكامل"],[459,"طرف نجدية وطرف عراقي","https://www.aldiwan.net/poem56104.html","الخفيف"],[469,"إنا لأهل تقى وأهل عفاف","https://www.aldiwan.net/poem59841.html","الكامل"],[469,"كم من فتى تسفر أفعاله","https://www.aldiwan.net/poem59973.html","السريع"],[480,"اعمل بني فأنت من","https://www.aldiwan.net/poem36911.html","مجزوء الكامل"],[480,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[480,"من بطن أمك للجدث","https://www.aldiwan.net/poem37180.html","مجزوء الكامل"],[480,"لمتى الوقوف بجانب الأسطول","https://www.aldiwan.net/poem37199.html","الكامل"],[501,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[514,"أتذكر اليوم ما لاقيت من كمد","https://www.aldiwan.net/poem67748.html","البسيط"],[516,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[516,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[539,"ويوم عجن جسمه","https://www.aldiwan.net/poem48122.html","عموديه"],[559,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[564,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[570,"لا تجعلني كأَقوام علمتهم","https://www.aldiwan.net/poem52035.html","البسيط"]],"verses":[["لَم يُجرِ يَوماً بِأَطرافِ العِراقِ دَماً","إِلّا وَراعَ دِماءَ القَومِ بِالشامِ",0,"م",1,0],["لَم يُجاوِز مَنازِلَ البَدرِ عَدّاً","مِن بَقايا الصَديقِ وَالأَحبابِ",1,"ب",1,0],["لَم يَجرِ في ناديكَ هُج","رُ القَولِ أَو خَلعُ العِذارِ",2,"ر",1,0],["لَم يَجرِ مُذ خُلِقَت عَلى أَنيابِها","ماءُ السِواكِ وَلَم تَمَسَّ طَهورا",3,"ر",2,0],["لم يَجشَمِ الخالِقاتُ فِريَتَها","ولم يَغِض مِن نِطَافِها السَرِبُ",4,"ب",1,0],["لم يجرِ دمعي في هواه مسلسلا","حتَّى ثوى قلبي لديهِ مقيَّدا",5,"د",2,0],["لم يَجُع ضيفُكم ولا الجار مَزْؤو","دٌ له في جواركم مَبْهوتُ",6,"ت",1,0],["لم يجعل الله فضلاً","شاركتني فيه ضَيقا",7,"ق",2,0],["لم يجمع المال ببذل استه","من فرق شتى وتفريق",8,"ق",1,0],["لم يجْعَلِ الغدْر للوفاءِ أخاً","مُذْ كان في فَتْكه ولا نُسُكهْ",9,"ك",2,0],["لم يجدْ نفسه ألامتْ فيلحا","ها ولم ينصرف بخدٍّ لطيمِ",10,"م",1,0],["لَم يَجرُدها في الشِتا مِن وَشيِها","بَل كَساها رَوعَةً فَوقَ بَهاها",11,"ا",3,0],["لَم يَجحَدِ الفُصحى وَلَم يَهجُم عَلى","أُسلوبِها أَو يُزرِ بِالأَوضاعِ",12,"ع",1,0],["لَم يَجِد أَعوانَهُ وَالخَدَما","جانَبوهُ غَيرَ بَدرِ الكَيِّسِ",13,"س",1,0],["لَم يَجرِ لِلدَهرِ إِعذارٌ وَلا عُرُسٌ","إِلّا بِأَيّامِنا أَو في لَيالينا",14,"ن",2,0],["لَم يَجِئ بِها","شاعِرٌ ذَهَب",15,"ب",1,0],["لم يجتَذِبْ طَرْفاً شَمائلُ طَرْفِه","إلا ثَنَتْه حائراً في المِحجَرِ",16,"ر",1,0],["لم يَجرِ همسٌ لك في خاطرٍ","إلا جرى عندي كأني صداك",17,"ك",1,0],["لَم يُجمَعا قَطُّ لِعَيني وَقَد","يَجتَمِعُ النَرجِسُ وَالوَردُ",18,"د",1,0],["لَم يَجتَمِع قَطُّ في مِصرٍ وَلا طَرَفٍ","مُحَمَّدُ بنُ أَبي مَروانَ وَالنُوَبُ",19,"ب",1,0],["لَم يَجعَلِ اللَهُ في أَشلائِها أَرَباً","لِكُلِّ حُرٍّ أَبِيِّ النَفسِ مِفضالِ",20,"ل",1,0],["لَم يَجِد غالِبٌ وَراءَكَ مَعَدىً","لِتِراتٍ وَلا دَمٌ مَطلولُ",21,"ل",1,0],["لَم يَجهَلوهُ غَيرَ أنَّ سُيُوفَهُ","أَبقَت حُقُوداً عِنْدَهُم وذُحُولا",22,"ل",2,0],["لم يجهل القوْمُ إذ ولّوكَ ثغرَهُمُ","لِما تأشّبَ منه كلُّ حُوذي",23,"ي",1,0],["لم يَجْهلوا ما تُلاقي في التشيُّع من","تحريض شارِيَةٍ أو بأسِ شارِيّ",23,"ي",1,0],["لَم يَجِفَّ المَنزوعُ عَنِّيَ حَتّى","بَلَّتِ العَينُ ذا لِطولِ اِنتِحابِ",24,"ب",1,0],["لَم يَجرِ في البَيتِ مِنهُ وَقَد","عُذتُ بِالأَركانِ وَالحُجُبِ",25,"ب",1,0],["لَم يَجفُها مِبزَلُ القَومِ حَت","تى نَجَمَت مِثلَ نُجومِ السِنانِ",26,"ن",1,0],["لم يجفّ من كبَرٍ عمّا يُراد بهِ","من الأمور ولا أزرى به الصغَر",27,"ر",1,0],["لَم يَجِد عِندَ أَكبَرَيهِ سُموّاً","فَاِعتَزى فَضلُهُ إِلى أَصغَرَيهِ",28,"ر",3,0],["لَم يجدني لَهفي عَلى شَعري الَّذي","بان البياض عليه بعد سواد",29,"د",1,0],["لَمْ يَجْهَلِ الْعَادِي عَلَيْهِ أَنَّهُ","يُودَى بِهِ وَأنْقَضَّ غَيْرَ مُبَالِي",30,"ل",2,0],["لَمْ يَجِدْ نَيْرُون أَبْهَى فَلجاً","مِنْ تشَظِّيها وَلا أَعْذبَ ثَغْرَا",31,"ر",2,0],["لَم يَجهَلِ القَومُ مِنهُ فَضلَ ماعَرِفوا","لَكِن عَرَفتَ مِنَ التَسليمِ ماجَهِلوا",32,"ل",3,0],["لَم يجبر العَظمَ حَتّى هاضَ وا أسفاً","ما اِبتَزَّ لي حَسَناتي غَيرُ إِجرامي",33,"م",2,0],["لم يجِدْ للعُلاَ سواه مَثِيلاً","ولبَدْرِ السماءِ إِلاَّهُ نِدّا",34,"د",2,0],["لم يجنها إلا رقيقُ شعوره","والمرهفُ الحساس من وجدانه",35,"ن",2,0],["لم يجدْ غيرَ بشاشاتِ المُنَى","وارتياحِ للندَى أيَّ ارتيَاح",36,"ح",1,0],["لم يَجنِ شهدَ العلمِ إلا","مَن تجرَّعَ كأس صابه",37,"ب",2,0],["لم يجرعْهُ كُئوسَ الشَّهد، بَلْ","كم كئوس من زُعَاف جَرَّعَه",38,"ع",2,0],["لم يُجْدِهمْ عَرْض اقترا","ح، أو مناقشةُ اقتراح",39,"ح",1,0],["لم يجردها الشتا من وشيها","بل كساها روعة فوق بهاها",40,"ا",3,0],["لَم يجِد مَن أرَادَ مَعنًى قَوِيماً","مِن مَعَانِيهِ فِيهِ مَعنًى قَوِيمَا",41,"م",2,0],["لَم يَجِدِ الراغِبونَ مُنفَسَحاً","عَنكَ وَلا الراهِبونَ مُندَفَعا",42,"ع",2,0],["لَم يَجحَدِ الأَعداءُ واضِحَ مَجدِهِم","كَيفَ الجُحودُ وَسابِقٌ بُرهانُهُ",43,"ن",2,0],["لم يجعل الله الخلافةَ والعلا","فيكم لمعنى كان بل لمعاني",44,"ن",2,0],["لم يَجهل الحُبَّ ولا عابَه","فجاد بِالوَصل على عَبده",45,"د",2,0],["لم يجتمع قطّ قلبي هوى أحد","ممّن هويت وإغباقٌ إلى رفث",46,"ث",1,1],["لَم يجحدِ اللَّهَ لم يجحد نبوّته","إلّا عمٍ عن طريقِ الرشد ضلّيلُ",47,"ل",1,0],["لم يجد للحُبّ في فردَوسهِ","لذَةٌ إن عَبَّ من أنهارِه",48,"ه",1,0],["لم يجد وهو الذي يشكو الصدى","نشوةً مثلَ التي في نارهِ",48,"ه",1,0],["لَمْ يَجِدْ الطالبونَ شبيهاً له","إنْ انجدا أوْ هُمْ حَوَتْهُم حزونُ",49,"ن",1,0],["لم يجاوِز حَدَّ الثلاثين إلا","بليالٍ ليست لها تكثِير",50,"ر",1,0],["لَمْ يَجْنِ تَمْرَ الْعِلْمِ بَلْ","لَمْ يَدْرِ كَيْفَ الْعِلْمُ يُنْشَدْ",51,"د",1,0],["لَمْ يَجْدِهِ الْعِلْمُ حِينَ حَصَّلَهُ","بِالدَّرْسِ لِلنَّفْسِ لاَ لِلَّهِ بِالنُّورِ",52,"ر",1,0],["لم يجمع الجبارُ بين قلوبهم","إلا ليهلك معتد وضليل",53,"ل",1,0],["لَم يُجرِ لي النَدمانُ يَوماً ذِكرَهُ","إِلّا عَضَضتُ أَنامِلَ النَدمانِ",54,"ن",1,0],["لَم يجتَمع في بيوتِ الآلِ معظمُ ما","في بَيتِهم مِن مَزايا كلّها علمُ",55,"م",1,0],["لم يجاهد ليكنز المال أو","يبنى مجداً على رقاب العبيد",56,"د",1,0],["لَمْ يَجِدْ غَيْرَ فُؤَادِي هَدَفاً","عِندَما فَوَّقَ مِن لَحْظٍ سِهَامَا",57,"م",2,0],["لَم يَجرِ ما أَجرى عَلَيهِ لا وَلا","ساواهُ في الرُتبَةِ ما عِندَ صَدَر",58,"ر",1,0],["لم يَجِدْ دمعاً فأكثرَ لَمْعاً","خَوْفَ أنْ يُسْمَى بجَهْمٍ جَهام",59,"م",1,0],["لم يَجتذِبْ لرداء مُلكِكَ هُدْبَه","إلاّ لكأْسِ رداهُ صِرْفاً حاس",60,"س",1,0],["لم يَجْلُ منه ما اعتكَر","ولم يَرَ النّاسُ أَثَر",61,"ر",1,0],["لَم يَجرِ وَاللَهِ في سِرّي وَفي عَلَني","لا في رِضايَ وَلا وَاللَهِ في غَضَبي",62,"ب",2,0],["لَم يَجعَل الآباء مُتَّكلاً وَلا","آباؤُهُ اتَّكَلوا عَلى أَجدادِهِ",63,"د",2,0],["لم يجاوز عنده واسطة","لسموّ عد فيه شرفه",64,"ف",2,0],["لم يُجرِه طمعٌ ولم تَقدَمْ به","حِرصاً على جدواك أوبةُ قافلِ",65,"ل",1,0],["لم يُجدِ لي تعبي بها فكأنني","فيما يخيبُ ولدتُها لعقوقِ",66,"ق",1,0],["لم يجز غيرَه الكمالُ ولكن","ظهرتْ فيه قدرةُ الخلاّقِ",67,"ق",1,0],["لَم يَجرِ قَط إِلَيكَ مِن أَلفاظِهِ","إِلّا أَغَرُّ مُحَجَّلُ الأَطرافِ",68,"ف",1,0],["لَم يَجعَلِ الغَيَّ لَهُ مَتجَراً","فَلَم تَكُن كَرَّتُهُ خاسِرَه",69,"ر",2,0],["لم يجن قط أبي عل","ي ولا جنيت أنا عليك",70,"ك",1,0],["لم يجزها عن صدقها","إلا الأله المبدع",71,"ع",1,0],["لم يجن من خيراتها","إلا الذي فيها حرث",72,"ث",1,0],["لم يجده النفع احتباس سلاحه","اذ لم يجد به عزة المكفول",73,"ل",1,0],["لم يجن رعديد الوغى من سيفه","إلا العناء وكثرة التعطيل",73,"ل",1,0],["لم يجهَلِ العزَّ من عالي يحجُّبِهِ","عن قادَةِ القومِ إِلاَّ كلُّ مَحْجوبِ",74,"ب",1,0],["لم يجن ذنباً فيدري ما يمحصه","ولا يرى أجلاً للصفح منتظرا",75,"ر",2,0],["لم يجهلوا قبح مسعاهم وخيبتهم","وأي عبد عصى المولى فلم يخب",76,"ب",1,0],["لم يجهلوا مهر الوزارة غير ما","ساقوا لها من غدرة لا تجهل",77,"ل",1,0],["لم يَجِدوا في السُّوقِ مِلحاً","يُشتَرى أو سُكَّرا",78,"ر",2,0],["لم يجد في هوى المهفهف صبرا","وبه الشوق قد توقَّد جمرا",79,"ر",2,0],["لَم يَجِدِ الماءَ ما يَفعَلُ ساعَتَهُ","يَمَسُّ لَوحَ كِتابِ اللَهِ أَو هَجَرا",80,"ر",2,0],["لمي جز الحكم له لأنه","خالف فيما قد قضاه السنة",81,"ه",1,0],["لم يجعلِ اللَه قَلبي حين ينزلُ بي","همٌ تضيقني ضيقاً ولا حرجا",82,"ج",2,0]]}