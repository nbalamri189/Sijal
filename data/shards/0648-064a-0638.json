{"poems":[[53,"إلا يكن نصلا فغمد نصول","https://www.aldiwan.net/poem29887.html","الكامل"],[53,"أبثك أني راغب عن معاشر","https://www.aldiwan.net/poem30647.html","الطويل"],[63,"أسمراء عهدي بالخطوب قريب","https://www.aldiwan.net/poem46118.html","الطويل"],[63,"هو ما ترى فأقل من تعنيفي","https://www.aldiwan.net/poem46129.html","الكامل"],[86,"لعب البلى بملاعب الألباب","https://www.aldiwan.net/poem10375.html","الكامل"],[86,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[93,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[93,"عزمات نحاس إذا جاورتها","https://www.aldiwan.net/poem11354.html","الكامل"],[83,"والعود في كف النديم بسر ما","https://www.aldiwan.net/poem54308.html","الكامل"],[4,"سفها عذلت وقلت غير مليم","https://www.aldiwan.net/poem21199.html","الكامل"],[72,"برغم العلى تاج تحلى به الثرى","https://www.aldiwan.net/poem18719.html","الطويل"],[72,"ليهن بنو الآمال أنك قادم","https://www.aldiwan.net/poem19670.html","الطويل"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[92,"عش بالشعور وللشعور فإنما","https://www.aldiwan.net/poem38938.html","البسيط"],[85,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[85,"سمعت بأن طاووساً","https://www.aldiwan.net/poem8029.html","مجزوء الوافر"],[43,"آخر ما الملك معزى به","https://www.aldiwan.net/poem9512.html","السريع"],[43,"لا تحسبوا ربعكم ولا طلله","https://www.aldiwan.net/poem10134.html","المنسرح"],[45,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[45,"لأية حال أعلن الوجد كاتمه","https://www.aldiwan.net/poem65658.html","الطويل"],[28,"كانت منادمة الملوك وتاجهم","https://www.aldiwan.net/poem5480.html","الكامل"],[28,"شعثا قد انتزع القياد بطونها","https://www.aldiwan.net/poem5484.html","الكامل"],[58,"أرقت لنوح آخر الليل غردا","https://www.aldiwan.net/poem31090.html","الطويل"],[58,"صرمت حبالك بعد وصلك زينب","https://www.aldiwan.net/poem31129.html","الكامل"],[66,"عين البرود برود عيني","https://www.aldiwan.net/poem38800.html","مجزوء الكامل"],[97,"أمسي يعذبني ويضنيني","https://www.aldiwan.net/poem24798.html","أحذ الكامل"],[105,"لك من تحيات القلوب مواكب","https://www.aldiwan.net/poem42053.html","الكامل"],[39,"قل في شط نهروان اغتماضي","https://www.aldiwan.net/poem53771.html","الخفيف"],[52,"أسألت طللا","https://www.aldiwan.net/poem26765.html","مجزوء الرمل"],[52,"قطعته يوما وليس يطيعه","https://www.aldiwan.net/poem26842.html","الكامل"],[52,"يا ليالي القديمات ارجعي","https://www.aldiwan.net/poem27075.html","الرمل"],[52,"يا من يجود بموعد من حظه","https://www.aldiwan.net/poem27112.html","الكامل"],[52,"ولقد غدوت على طمر","https://www.aldiwan.net/poem27191.html","مجزوء الكامل"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[46,"ثمل الكبير فظل يحسب أنه","https://www.aldiwan.net/poem22805.html","الكامل"],[46,"يتحارب الطبع الذي مزجت به","https://www.aldiwan.net/poem23147.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39684","الكامل"],[29,"","https://poetry.dctabudhabi.ae/diwan/poem/485","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55156","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54640","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142332","الكامل"],[106,"ميلاد الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179497",""],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[100,"مدرسة الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=11248",""],[90,"لم تُنْصفوا اصوت من النجف","https://www.poetsgate.com/ViewPoem.aspx?id=178980",""]],"verses":[["وَيَظُنُّ أَن لَو طاوَلَتهُ مَنيَّةٌ","لَأَبى إِباءَ المُصعَبِ المَعقولِ",0,"ل",1,0],["وَيُظهِرُ لي قَومٌ بَعاداً وَجَفوَةً","وَما عَلِموا أَنّي بِذَلِكَ أَفرَحُ",1,"ح",1,0],["وَيُظْهِرُ لي نُصْحاً وَلِلْغِلِّ تَحتَهُ","دَواعٍ بِكِلْتا مُقْلَتَيْهِ تُهيبُ",2,"ب",1,0],["ويظَلُّ حِلْفُ الدّمعِ مِلْءَ جُفونِهِ","والوَجْدُ مِلْءَ فُؤادِهِ المَشْغوفِ",3,"ف",1,0],["وَيَظَلُّ يَرقُبُهُ وَيَغزو كِبرَهُ","بِلُيونَةٍ وَلَباقَةٍ وَخِلابِ",4,"ب",1,0],["وَيَظُنُّ الغَوِيُّ أَن لا نِظامٌ","وَيَقولُ القَوِيُّ قَد جَدَّ جِدّي",5,"ي",1,0],["وَيَظَلُّ قَبْلَ النَّشْرِ يُو","سِعُهُمْ ثَوَاباً أَوْ عِقَابَا",6,"ب",2,0],["وَيَظَلُّ مُبْتَعِثَ العَظَائِمِ مَدْفَنٌ","فِيهِ الذَّخِيرَةُ هَامَةٌ وَعِظَامُ",7,"م",1,0],["ويظن أن عذاره من آسه","ونظن تفاح الخدود من الثمَرْ",8,"ر",1,0],["وَيَظَلُّ مُرتَقِباً يُقَلِّبُ طَرفَهُ","كَعَريشِ أَهلِ الثَلَّةِ المَهدومِ",9,"م",1,0],["ويظهر مجداً والتعبد قبله","وإنَّا لنرجو فوق ذلك مظهرا",10,"ر",2,0],["ويظمأ طرفي للقا وهو مدامعٌ","فيا لك ظامٍ وهو في الماء عائم",11,"م",1,0],["ويظلون في المنَاعم واللذ","ذاتِ بين الكواعب الأَترابِ",12,"ب",1,0],["ويظلُّ يسأَلُ نفسه متفلسفاً","متَنَطِّساً في خفَّةٍ وغُرورِ",13,"ر",1,0],["ويظهر كل معجزة","لشانيه فيفحمه",14,"م",2,0],["وَيُظهِرُ ريشَهُ طَوراً","وَيُخفي الريشَ أَحيانا",15,"ن",2,0],["وَيُظهَرُ التَذكيرُ في ذِكرِهِ","وَيُستَرُ التَأنيثُ في حُجبِهِ",16,"ب",2,0],["وَيُظهِرُ الجَهلَ بي وَأَعرِفُهُ","وَالدُرُّ دُرٌّ بِرَغمِ مَن جَهِلَه",17,"ل",2,0],["وَيَظَلُّ يُخشى في الإِلَهِ وَيُتَّقى","فيهِ كَما يَخشى الإِلَهُ وَيَتَّقي",18,"ق",2,0],["وَيَظلِمُكَ المَوتُ الغَشومُ فَتَرتَدي","بِعِزِّ الأُسى حَتّى كَأَنَّكَ ظالِمُه",19,"م",2,0],["وَيَظَلُّ مِن وَهَجِ الهَجيرَةِ عائِذاً","بِالظِلِّ حَيثُ يَزولُ كُلَّ مَزالِ",20,"ل",1,0],["وَيَظَلُّ يَتبَعُهُنَّ وَهوَ مُقَرمِدٌ","مِن خَلفِهِنَّ كَأَنَّهُ بِشكالِ",21,"ل",1,0],["وَيَظهَرُ مِنّا مَنظَرٌ ذو كَريهَةٍ","إِذا ما تَسَربَلنا الحَديدَ المُسرَّدا",22,"د",2,0],["وَيَظَلُّ مَلهوفاً يَرومُ تَحَيُّلاً","وَالرِزقُ لَيسَ بِحيلَةٍ يُستَجلَبُ",23,"ب",1,0],["وَيَظَلُّ يَرفُدُها السَحا","بُ بِصَوبِ وَسَمِيٍّ وَعَينِ",24,"ن",1,0],["ويظل يضرب في أضالعه","وكأنها قضبان مسجون",25,"ن",1,0],["ويظلُّ آخرُ بَيْنَ بينَ فدافعٌ","يعتاقه عما يُريد وجاذبُ",26,"ب",1,0],["وَيَظَلُّ المَلِيَّ يوفي عَلى القَر","نِ عَذوباً كَالحُرضَةِ المُستَفاضِ",27,"ض",1,0],["وَيَظَّلُ لِلخَلا","خالِعاً مُنتَعِلا",28,"ل",2,0],["وَيَظَلُّ مُنتَهِكاً لِعِرضي آمِناً","وَيُسَرُّ حينَ يَخافُ حُسنَ المَربَغِ",29,"غ",1,0],["وَيَظُنُّ الدَهرَ نَقداً كُلَّهُ","ثُمَّ يَلقاني عَلى طولِ البُعادِ",30,"د",1,0],["وَيَظَلُّ صَبّاغُ الحَياءِ بِخَدِّهِ","تَعِباً يُعَصفِرُ تارَةً وَيُوَرِّدُ",31,"د",1,0],["وَيَظَلُّ مُشتَرِكَ الضَمي","رِ مَخافَةَ العَثَراتِ",32,"ت",1,0],["ويظُنُّ إنْ رَكَدَتْ سفينَتُهُ عَلَى","أمْوَاجِها ورِياحِها لَمْ تَرْكُدِ",33,"د",1,0],["وَيَظَلُّ يُهْدِي لِلجَّحِيمِ بِسَيفِهِ","مِمَّنْ عَصَى بعدَ القتيلِ قتيلا",34,"ل",2,0],["وَيَظَلُّ مُرْتَادُ الخَلاصِ مُقَلِّباً","فِي الشَّافِعِينَ لِحَاظَهُ وَمُجِيلا",34,"ل",2,0],["وَيَظُنَّها نارَ الخَليلِ سَليمَةً","وَيَكادُ يَأخُذُ مِن سَناها القابِسُ",35,"س",1,0],["وَيَظَلُّ يَنظُرُ ما سَناهُ بِنافِعٍ","كَالشَمسِ يَستُرُها الغَمامُ وَظِلُّهُ",36,"ل",2,0],["ويظنه الملاح طوع شراعه","فيرد عن غمراته الملاحا",37,"ح",2,0],["وَيَظعَنَ حَتّى يَستَقِرَّ بِبَلدَةٍ","يُجاوِرُ مِنجاباً بِها وَالمُخَذَّعا",38,"ع",2,0],["ويُظْهِرُ لي مَوَدّتَهُ مَقالا","ويُبْغِضُني ضَميراً واعْتِقادا",39,"د",2,0],["ويظهرُ التَّضعِيفُ في الثَّقيلِ","تَعُدُّهُ حَرفَينِ في التَّفصيلِ",40,"ل",1,0],["وَيُظَنُّ عَهَدِي بَدْءَ عَهْدِ وُجَودِهَا","فَيَتِمُّ لِي الفَخْرُ الَّذِي أَتَطَلَّبُ",41,"ب",1,0],["وَيَظَلُّ مَا شَاءَ الوَفَاءُ لِقَوْمِهِ","حَرْبَ العَدُوِّ وَسِلْمَ كُلِّ مُوالِ",42,"ل",1,0],["وَيَظَلُّ مُلْتَمِساً إِنَارَةَ ذِهْنِهِ","بِهُدَى شُمُوسٍ أَوْ بِضَوْءٍ ذُبالِ",43,"ل",1,0],["وَيَظَلُّ بَسَّاماً مَا هُوَ وَجْهَهُ","بَلْ قَلْبُهُ وَسِوَاهُ يَبْسِمُ كَاذِبَا",44,"ب",2,0],["ويظنّ أن عدوّه في غيره","وعدوّه يمسي ويضحي فيه",45,"ي",2,0],["ويظّلُّ يدني أفقَه من شعبه","حتى يكادَ يُظَنُّ من طبقاته",46,"ت",2,0],["ويظَلُّ يدعوهم بصو","تٍ في القلوبِ له رنين",47,"ن",1,0],["ويظن أن عدوه في غيره","وعدوه يضحي ويمسي فيه",48,"ي",2,0],["ويُظلم من كانت تَهَشُ لصوته","سهول الفلا شوقاً وتبكي حُزونه",49,"ن",2,0]]}