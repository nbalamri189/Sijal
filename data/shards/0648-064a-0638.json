ن يكنَّى بالنبيل أو الأمير",245,"ر",1,0],["وَ يَظَلُّ يَلْهَثُ يَقْتَفِي أَهْوَاءَهُ","تَقْتَادُهُ الدُّنْيَا فَيَخْضَعُ طَائِعَا",246,"ع",2,0],["ويظلُّ يوقِظُهُ اليقينُ","بعالَمٍ شكٍّ خُطاهُ",247,"ا",2,0],["ويظلُّ يزعمُ أنّهُ","شيءٌ يطاولُ في سناهُ",247,"ا",2,0],["وَ يَظَلُّ قَوْلُ الذِّكْرَيَاتِ تَقَرُّبًا","فَالوَصْلُ وَلَّى فِي الدُّنَى مَقْطُوعُ",248,"ع",1,0],["ويظل منتظرا لكي لا ينتهي","سرد القصيد ونبضه الوهاج.",249,"ج",1,0],["ويظل أنمارٌ وإخوته لها","نعم الوريث لفارس يترجل",250,"ل",1,0],["ويَظنُّ أنَّ الأرْضَ ممْلَكَةٌ","لأبيهِ وهْوَ وَريثُها الباني !",251,"ن",2,0],["ويظل رهنًا للمذلَّةِ والجفا","يلهو به هذا العدوّ المُغْرِضُ",252,"ض",1,0],["ويظَلُّ في عينيِهِ لَيلٌ أجملُ ،","وَيُقيمُ جَذلاناً بِهِ ، المُستَقبَلُ",253,"ل",1,0],["ويظل بساما فما هو وجهه","بل قلبه وسواه يبسم كاذبا",254,"ب",2,0],["ويظهر من محياها شعاعٌ","كضوء الشمس تجعله دليلا",255,"ل",2,0],["ويظل يملأ خافقي ثقة","أني إلى الرحمن أبتهلُ",256,"ل",1,0],["ويظن بعض القابعين بزهوهم","أن التكبر شيمة العظماء",257,"ا",2,0],["ويظن انه الفذ الوحيد","ما يدري انك تلعبي",258,"ب",2,0],["ويظلُّ هذا الكونُ بعدَ غيابِنا","تَشدو لأزهارِ الصباحِ عنادلُ",259,"ل",1,0],["ويظلُّ ما صانَ الفؤادَ عن الهوى","صلبَ الإرادةِ ساميَ الأحلامِ",260,"م",1,0],["ويظلُّ يغرفُ من رحيقِ هنائِها))","(فإذا ذوت ولدت بذلك أوّلَهْ)",261,"ل",2,0],["ويظل حظه من زمانه باخعُهْ","وتظلُّ أظفارُ الهموم تصارعُهْ",262,"ع",2,0],["ويَظل باقي العمر يرفعُ شاني","ويصونُ أجرَه خالقُ الأكوانِ",263,"ن",1,0],["ويظل فينا جائراً أو منصفاً","ويظل فينا باخلاً وهّابا",264,"ب",2,0],["ويظل يطمع أن يُمَرِّق كِذبةً","في إثر أخرى، يعبد الأنصابا",265,"ب",2,0],["ويظل يمسح أدمعي","ليعود للثغر الهديل",266,"ل",1,0],["ويظل مصلوبا ً بخاطرها","طيف سقاني مهجة العنبِ",267,"ب",1,0],["ويظل الإنسان في الدهر يسعى","ثم نلقاه بعد ألقي السلاحا",268,"ح",2,0],["ويُظهر ودّاً تشهد العين زوره","ويقضي بذاك القلبِ والقلبُ أخبره",269,"ه",1,1],["ويظل مبتسماً يضاحكه","ما في ثغور النور من فلج",270,"ج",1,0],["وَيَظَلَّ يَرْقُبُنَا اللِّقَا","بَيْنَ ابْتِعَادٍ وَاقْتِرَابْ",271,"ب",1,0],["ويظلُّ إ