https://www.aldiwan.net/poem59510.html","الخفيف"],[348,"مولاي أقسم لم تعد في منزلي","https://www.aldiwan.net/poem20633.html","الكامل"],[364,"قضى على جد شانيكم بإتعاس","https://www.aldiwan.net/poem60867.html","البسيط"],[364,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[364,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[364,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[371,"يا أيها المحروم قاصده","https://www.aldiwan.net/poem57267.html","أحذ الكامل"],[377,"ما أحسن العقل يجلو فضل سيده","https://www.aldiwan.net/poem59325.html","البسيط"],[380,"من منصفي من مفرق في عنفه","https://www.aldiwan.net/poem48821.html","الكامل"],[400,"خالي العزيز","https://www.aldiwan.net/poem6746.html","عموديه"],[402,"أمل بهذا الدهر خائب","https://www.aldiwan.net/poem46510.html","مجزوء الكامل"],[402,"كنانة عز فوقت للعدى نصلا","https://www.aldiwan.net/poem46921.html","الطويل"],[402,"لعدلك قد وجهت يا بن محمد","https://www.aldiwan.net/poem46922.html","الطويل"],[403,"سؤالكم وافى لتحقيق مشكل","https://www.aldiwan.net/poem33470.html","الطويل"],[415,"إنتشتكي عنا سمى فإننا","https://www.aldiwan.net/poem1936.html","الكامل"],[437,"أفنيت صبري في الهوى وتجلدي","https://www.aldiwan.net/poem2581.html","الكامل"],[443,"تهتز الأرض ولا تفع","https://www.aldiwan.net/poem55945.html","عموديه"],[453,"بوركت يا شعب الكنانة ثائرا","https://www.aldiwan.net/poem61626.html","الكامل"],[453,"أين ابتسامك يا حبيبي","https://www.aldiwan.net/poem61716.html","مجزوء الكامل"],[453,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[458,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[458,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[464,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[464,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[464,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[464,"أقل عنائي أنني فيه هائم","https://www.aldiwan.net/poem3633.html","عموديه"],[477,"ألم الفراق نفى الرقاد ونفرا","https://www.aldiwan.net/poem15259.html","الكامل"],[500,"تثبت ولا تغضب إذا راح كاذب","https://www.aldiwan.net/poem37559.html","الطويل"],[500,"تجرد من مكابرة وجحد","https://www.aldiwan.net/poem37949.html","الوافر"],[514,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[558,"نحن الجفون نحفظ العيونا","https://www.aldiwan.net/poem33809.html","الرجز"],[558,"عين حق إنسانها الإنسان","https://www.aldiwan.net/poem33815.html","الخفيف"],[558,"إن كنت لم ترض عن النفس","https://www.aldiwan.net/poem34447.html","السريع"],[558,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"],[558,"نهر القضاء بما يختار خالقنا","https://www.aldiwan.net/poem34625.html","البسيط"],[558,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[558,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"],[575,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[575,"أسلفت تقبيلي لسالفتيه","https://www.aldiwan.net/poem2826.html","الكامل"],[575,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[575,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"]],"verses":[["وَيَظُنُّ أَن لَو طاوَلَتهُ مَنيَّةٌ","لَأَبى إِباءَ المُصعَبِ المَعقولِ",0,"ل",1,0],["وَيُظهِرُ لي قَومٌ بَعاداً وَجَفوَةً","وَما عَلِموا أَنّي بِذَلِكَ أَفرَحُ",1,"ح",1,0],["وَيُظْهِرُ لي نُصْحاً وَلِلْغِلِّ تَحتَهُ","دَواعٍ بِكِلْتا مُقْلَتَيْهِ تُهيبُ",2,"ب",1,0],["ويظَلُّ حِلْفُ الدّمعِ مِلْءَ جُفونِهِ","والوَجْدُ مِلْءَ فُؤادِهِ المَشْغوفِ",3,"ف",1,0],["وَيَظَلُّ يَرقُبُهُ وَيَغزو كِبرَهُ","بِلُيونَةٍ وَلَباقَةٍ وَخِلابِ",4,"ب",1,0],["وَيَظُنُّ الغَوِيُّ أَن لا نِظامٌ","وَيَقولُ القَوِيُّ قَد جَدَّ جِدّي",5,"ي",1,0],["وَيَظَلُّ قَبْلَ النَّشْرِ يُو","سِعُهُمْ ثَوَاباً أَوْ عِقَابَا",6,"ب",2,0],["وَيَظَلُّ مُبْتَعِثَ العَظَائِمِ مَدْفَنٌ","فِيهِ الذَّخِيرَةُ هَامَةٌ وَعِظَامُ",7,"م",1,0],["ويظن أن عذاره من آسه","ونظن تفاح الخدود من الثمَرْ",8,"ر",1,0],["وَيَظَلُّ مُرتَقِباً يُقَلِّبُ طَرفَهُ","كَعَريشِ أَهلِ الثَلَّةِ المَهدومِ",9,"م",1,0],["ويظهر مجداً والتعبد قبله","وإنَّا لنرجو فوق ذلك مظهرا",10,"ر",2,0],["ويظمأ طرفي للقا وهو مدامعٌ","فيا لك ظامٍ وهو في الماء عائم",11,"م",1,0],["ويظلون في المنَاعم واللذ","ذاتِ بين الكواعب الأَترابِ",12,"ب",1,0],["ويظلُّ يسأَلُ نفسه متفلسفاً","متَنَطِّساً في خفَّةٍ وغُرورِ",13,"ر",1,0],["ويظهر كل معجزة","لشانيه فيفحمه",14,"م",2,0],["وَيُظهِرُ ريشَهُ طَوراً","وَيُخفي الريشَ أَحيانا",15,"ن",2,0],["وَيُظهَرُ التَذكيرُ في ذِكرِهِ","وَيُستَرُ التَأنيثُ في حُجبِهِ",16,"ب",2,0],["وَيُظهِرُ الجَهلَ بي وَأَعرِفُهُ","وَالدُرُّ دُرٌّ بِرَغمِ مَن جَهِلَه",17,"ل",2,0],["وَيَظَلُّ يُخشى في الإِلَهِ وَيُتَّقى","فيهِ كَما يَخشى الإِلَهُ وَيَتَّقي",18,"ق",2,0],["وَيَظلِمُكَ المَوتُ الغَشومُ فَتَرتَدي","بِعِزِّ الأُسى حَتّى كَأَنَّكَ ظالِمُه",19,"م",2,0],["وَيَظَلُّ مِن وَهَجِ الهَجيرَةِ عائِذاً","بِالظِلِّ حَيثُ يَزولُ كُلَّ مَزالِ",20,"ل",1,0],["وَيَظَلُّ يَتبَعُهُنَّ وَهوَ مُقَرمِدٌ","مِن خَلفِهِنَّ كَأَنَّهُ بِشكالِ",21,"ل",1,0],["وَيَظهَرُ مِنّا مَنظَرٌ ذو كَريهَةٍ","إِذا ما تَسَربَلنا الحَديدَ المُسرَّدا",22,"د",2,0],["وَيَظَلُّ مَلهوفاً يَرومُ تَحَيُّلاً","وَالرِزقُ لَيسَ بِحيلَةٍ يُستَجلَبُ",23,"ب",1,0],["وَيَظَلُّ يَرفُدُها السَحا","بُ بِصَوبِ وَسَمِيٍّ وَعَينِ",24,"ن",1,0],["ويظل يضرب في أضالعه","وكأنها قضبان مسجون",25,"ن",1,0],["ويظلُّ آخرُ بَيْنَ بينَ فدافعٌ","يعتاقه عما يُريد وجاذبُ",26,"ب",1,0],["وَيَظَلُّ المَلِيَّ يوفي عَلى القَر","نِ عَذوباً كَالحُرضَةِ المُستَفاضِ",27,"ض",1,0],["وَيَظَّلُ لِلخَلا","خالِعاً مُنتَعِلا",28,"ل",2,0],["وَيَظَلُّ مُنتَهِكاً لِعِرضي آمِناً","وَيُسَرُّ حينَ يَخافُ حُسنَ المَربَغِ",29,"غ",1,0],["وَيَظُنُّ الدَهرَ نَقداً كُلَّهُ","ثُمَّ يَلقاني عَلى طولِ البُعادِ",30,"د",1,0],["وَيَظَلُّ صَبّاغُ الحَياءِ بِخَدِّهِ","تَعِباً يُعَصفِرُ تارَةً وَيُوَرِّدُ",31,"د",1,0],["وَيَظَلُّ مُشتَرِكَ الضَمي","رِ مَخافَةَ العَثَراتِ",32,"ت",1,0],["ويظُنُّ إنْ رَكَدَتْ سفينَتُهُ عَلَى","أمْوَاجِها ورِياحِها لَمْ تَرْكُدِ",33,"د",1,0],["وَيَظَلُّ يُهْدِي لِلجَّحِيمِ بِسَيفِهِ","مِمَّنْ عَصَى بعدَ القتيلِ قتيلا",34,"ل",2,0],["وَيَظَلُّ مُرْتَادُ الخَلاصِ مُقَلِّباً","فِي الشَّافِعِينَ لِحَاظَهُ وَمُجِيلا",34,"ل",2,0],["وَيَظُنَّها نارَ الخَليلِ سَليمَةً","وَيَكادُ يَأخُذُ مِن سَناها القابِسُ",35,"س",1,0],["وَيَظَلُّ يَنظُرُ ما سَناهُ بِنافِعٍ","كَالشَمسِ يَستُرُها الغَمامُ وَظِلُّهُ",36,"ل",2,0],["ويظنه الملاح طوع شراعه","فيرد عن غمراته الملاحا",37,"ح",2,0],["وَيَظعَنَ حَتّى يَستَقِرَّ بِبَلدَةٍ","يُجاوِرُ مِنجاباً بِها وَالمُخَذَّعا",38,"ع",2,0],["ويُظْهِرُ لي مَوَدّتَهُ مَقالا","ويُبْغِضُني ضَميراً واعْتِقادا",39,"د",2,0],["ويظهرُ التَّضعِيفُ في الثَّقيلِ","تَعُدُّهُ حَرفَينِ في التَّفصيلِ",40,"ل",1,0],["وَيُظَنُّ عَهَدِي بَدْءَ عَهْدِ وُجَودِهَا","فَيَتِمُّ لِي الفَخْرُ الَّذِي أَتَطَلَّبُ",41,"ب",1,0],["وَيَظَلُّ مَا شَاءَ الوَفَاءُ لِقَوْمِهِ","حَرْبَ العَدُوِّ وَسِلْمَ كُلِّ مُوالِ",42,"ل",1,0],["وَيَظَلُّ مُلْتَمِساً إِنَارَةَ ذِهْنِهِ","بِهُدَى شُمُوسٍ أَوْ بِضَوْءٍ ذُبالِ",43,"ل",1,0],["وَيَظَلُّ بَسَّاماً مَا هُوَ وَجْهَهُ","بَلْ قَلْبُهُ وَسِوَاهُ يَبْسِمُ كَاذِبَا",44,"ب",2,0],["ويظنّ أن عدوّه في غيره","وعدوّه يمسي ويضحي فيه",45,"ي",2,0],["ويظّلُّ يدني أفقَه من شعبه","حتى يكادَ يُظَنُّ من طبقاته",46,"ت",2,0],["ويظَلُّ يدعوهم بصو","تٍ في القلوبِ له رنين",47,"ن",1,0],["ويظن أن عدوه في غيره","وعدوه يضحي ويمسي فيه",48,"ي",2,0],["ويُظلم من كانت تَهَشُ لصوته","سهول الفلا شوقاً وتبكي حُزونه",49,"ن",2,0],["وَيَظَل مِن فَرط الغِواية في الهَوى","مُتَقَسِماً بَينَ الرَجا وَالياس",50,"س",1,0],["ويظن ان الكدب يم","حو عنه ما رقم الليالي",51,"ي",1,0],["وَيَظعَنُ أَهلُ المَكَّتَينِ فَيَهرُبوا","فَرائِصُهُم مِن خَشيَةِ الشَرِّ تُرعَدُ",52,"د",1,0],["ويظل بالإصلاح مغرىً كلّما","وجد السبيل إلى صلاح سارا",53,"ر",2,0],["وَيَظلِمُ أَدنى الناسِ مِنكَ زَمانُهُ","وَعَدلُكَ مُخلي الخافِقينَ مِنَ الظُلمِ",54,"م",1,0],["وَيَظَلُّ صبَّاغُ المِزاجِ محكَّماً","في نَقْضِ حُمرتها بأَيدي الماءِ",55,"ا",2,0],["ويُظْهِرُ نطقُهُ إعجازَ عيسى","بردِّ الروحِ في الرّممِ البَوالي",56,"ي",1,0],["وَيُظْهِرُ قَلْبي عُذْرَها ويُعينها","عَلَيَّ فما لي في الفؤادِ نصيبُ",57,"ب",1,0],["وَيْ ظَبْيتي .. رفقا بنا لا تَفْزعي","هو هكذا شأنُ الهوى ..أينَ المَفَرّْ ؟!",58,"ر",1,0],["ويظنُّ أن الناس عن","إدراكِ ذلك في حِجابْ",59,"ب",1,0],["ويظلُّ بيتُ الشعرِ قَفْرا خاليا","ما لم تكن بالمدح من سُكّانه",60,"ه",1,0],["ويظهر حربا بعد سلم وألفة","فخفه وكن طبا بحل المضارب",61,"ب",1,0],["ويظنونها من الحورِ لولا الحو","رُ محجوبةٌ عن الإبصارِ",62,"ر",1,0],["ويظن منشدها لعذب كلامها","أن قد ترشَّف للحبيب رضابا",63,"ب",2,0],["ويظمأ آه وكيف الورود","إذا كان ثغر الهوى لا يجود",64,"د",1,0],["ويظن قسطنطين جه","لاً انه أسد العرين",65,"ن",1,0],["ويظل يطويه نهاية طيه","والسكر ينشره نهاية نشره",66,"ر",2,0],["ويظهر فيه جاهه بشفاعة","إليها لكرب الموقف الخلق يهرع",67,"ع",1,0],["وَيَظلُّ طولَ اللَّيلِ يَقرَأُ آيَةً","مُتَدَبِّراً فيها غُموضَ مَعاني",68,"ن",2,0],["ويظل مفتوح الرتاج مُؤَمَّنَا","حرا لمقدم سائر الحّجاج",69,"ج",1,0],["ويظهر تأثير الهوى في شمالي","فيعلن حالي انه ليس بي سهو",70,"و",1,0],["ويظهر فيّاض المواهب في الخفا","ومنه الملا يملا الإِنا وهو يطفح",71,"ح",1,0],["ويُظمئِنَ القلوبَ إِلى ثغورٍ","فتَلقى النارَ إن تردِ الثغورا",72,"ر",2,0],["وَيَظَلُّ يَجري في جَواشِنِها","حَتّى تَرَوَّحَ مَقصِرَ العَصرِ",73,"ر",1,0],["وَيَظهَرُ السِرُّ الَّذي صُنتَهُ","مِن وُدِّكُم عَن مُبغَضي وَالحَميمُ",74,"م",1,0],["ويظنون أن ذاك على ما","أضمروا من شناعة أو رذيله",75,"ل",2,0],["وَيَظَلُّ يَجمعُ ثُمَّ يَجمَعُ وَهْوَ مِن","حَسَدٍ عَليَّ وَفَرْطِ غَيْظٍ مُمتَلي",76,"ي",1,0],["ويَظلِمُ المالَ للعافِين مجتهِداً","ظُلْماً كَساهُ به حَلْيَ العُلا كاس",77,"س",1,0],["ويَظلُّ راكبُ مَتْنِها","والأرضُ في عَينَيْهِ شِبْر",78,"ر",1,0],["ويُظْهِرُ العَتْبَ إذا امتَدَّ المدى","وهل زَمانٌ مُعتِبٌ لمَنْ عَتَب",79,"ب",1,0],["ويَظَلُّ يكرِم مَن إليه يَنتحي","مِن زائريه كرامَةَ النُّسباء",80,"ا",2,0],["ويَظلُّ نائِكُه وتارِكُهُ","يَتَعاقَبانِ سَعادةً وشَقا",81,"ق",2,0],["ويُظهرُ العالمَ الغرّارَ مَضحكةً","تَنعى ذويها كنَعي السهمِ للهدف",82,"ف",1,0],["وَيَظَلُّ يَتَقن نَظمُهُ في نَظمِهِ","عِقداً وَيَحكُم نَشرُهُ في لَفِهِ",83,"ف",2,0],["ويظلُّ في لغةِ الأسى بابٌ لن","حتَّى نعبِّرَ فيهِ عن شكْوانا",84,"ن",2,0],["ويَظلّ يُخْدَم تائِهاً واللَّيثُ","مضطهدُ الجوانبْ",85,"ب",1,0],["ويُظْهر في الآفاق أنوار دينهِ","ويملكُ في هذَا الورى العَقْدَ والحَلاَّ",86,"ل",2,0],["ويَظْلمي صرفُ الزّمان وأنتمُ","لَعَمري أحمَى مِن أبي الشبلِ للشبِّل",87,"ل",1,0],["ويَظْلمني صرفُ الزّمان وأنتمُ","بكم رُفِعتْ بينَ الورى رايةُ العدلِ",87,"ل",1,0],["ويظهر لي أن لا تعارض فيهما","فكل روى ما علمه فيه غير منجلي",88,"ل",2,0],["وَيَظَلُّ مُقتِرُناً بِحُسنِ عَفافِهِ","حَتّى يُرى وَكأَنَّهُ أَغنانا",89,"ن",2,0],["ويظلّ ينبزّني بكفرٍ دائماً","فكأنّه متعبد في مسجد",90,"د",1,0],["ويظن الجائع لا شبع","ولقد يتخمه الشبع",91,"ع",1,0],["ويظل يسألنا المزيدَ تطهُّراً","من رجسِ ماضينا ويُرشد حائرا",92,"ر",2,0],["ويظلِ شعري بعد أن","فاسيِ كإلهامِ الغروب",93,"ب",1,0],["ويظل الأشرار في الإِثم غادي","نَ مضِّحينَ صفوةَ الأخيار",94,"ر",1,0],["ويُظِلُّني واليومُ أغبرُ مشمسٌ","أتجلَّلُ النكباتِ وهي أُوارُ",95,"ر",1,0],["ويظلمني المولَى وفي فِيَّ ناصرٌ","وكفِّي فلا أشكو ولا أتعتَّبُ",96,"ب",1,0],["ويظنُّ حاسديَ السكونَ جلادةً","والقلبُ ذو الحركاتِ غيرُ جليدِ",97,"د",1,0],["ويظنُّ عاشٍ أنها ما أضرمت","من فحمة الظلماءِ إلا عنبرا",98,"ر",2,0],["ويظمأُ إنساني ودمعي وهدبهُ","كخدِّ غدير في عذارٍ من السحب",99,"ب",1,0],["ويظلم قلبي لحظهُ وهو حاكم","فمن منصفٌ واللحظ خصم وحاكم",100,"م",1,0],["ويَظَلُّ في عرصاتهنَّ محاوراً","ظبياً يقلَّبُ ثَمَّ طرفاً أحورا",101,"ر",2,0],["ويظهر ربي عزَّ عن سرِ حكمةٍ","لمن شين مظلوماً من الغيب سلطانا",102,"ن",2,0],["ويَظْهَرُ من فَوارسِنا أُسودٌ","طَوَوا في الله أجْرامَ العَوائِقْ",103,"ق",1,0],["ويُظهِرُ في لُبْنى الغرامَ مورّياً","ومنهُ إلى ليلى الضّميرُ يعودُ",104,"د",1,0],["ويظهر الوجود منه في الذي","يظهر عنه واضحاً مكنونا",105,"ن",2,0],["ويظنون أنهم في حصول","والذي حصلوا هو الحرمان",106,"ن",1,0],["ويظهر المخفي عنها بها","لها فيبدو العرش والكرسي",107,"س",2,0],["ويظل يهجرهم ويكثر صده","عنهم وما أحد يقول لماذا",108,"ذ",2,0],["ويظهر الأمر في دار 