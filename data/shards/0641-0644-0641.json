{"poems":[[79,"ودرة نور في غلاف زبرجد","https://www.aldiwan.net/poem36618.html","الطويل"],[91,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[58,"شرفي محبة معشر","https://www.aldiwan.net/poem58627.html","مجزوء الكامل"],[47,"يا عارضا متلفعا ببروده","https://www.aldiwan.net/poem63492.html","الخفيف"],[71,"الواعظ الأمرد هذا الذي","https://www.aldiwan.net/poem28313.html","السريع"],[71,"قام على كرسيه واعظا","https://www.aldiwan.net/poem28632.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54735","السريع"],[92,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[227,"لا تنكروا سكري بألفاظه","https://www.aldiwan.net/poem55414.html","السريع"],[422,"الله يعلم والأنام شهود","https://www.aldiwan.net/poem53839.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138329",""],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26671","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125471","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124718","الرمل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88666","البسيط"],[2488,"","https://poetry.dctabudhabi.ae/diwan/poem/31476","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2808,"","https://poetry.dctabudhabi.ae/diwan/poem/105540","الكامل"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110849","السريع"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89163","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48296","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66508","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91823","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205898","السريع"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78289","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127156","الكامل"],[4679,"حتى مَ نلهو والمنية تنذر","https://www.poetsgate.com/ViewPoem.aspx?id=142723",""],[5310,"إِلَى السَّمَاءِ الثَّامِنَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=215363",""],[5661,"بالله يا أحمد بن عمروٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181390",""],[5906,"أُمّة وأئمة","https://www.poetsgate.com/ViewPoem.aspx?id=188216",""],[5906,"هيهات","https://www.poetsgate.com/ViewPoem.aspx?id=188315",""],[6134,"قد حل إنسان الفضائل بالثرى","https://www.poetsgate.com/ViewPoem.aspx?id=169565",""]],"verses":[["فلَفّتْ بمُخْضَرِّ البُرودِ بَنانَها","بُروراً وإجْلالاً عن اللّمْسِ باليَدِ",0,"د",1,0],["فلفته في أكفان خزّ جديدة","ووارته في قبر ولازمت القبرا",1,"ر",2,0],["فَلِفَتْكِهِ ولهَدْيِهِ","سَمّاهُ ذو العَرْشِ الفَتَى",2,"ت",2,0],["فَلِفِضَّةِ السَيفِ المُحَلّى حُسنُهُ","مُتَقَلَّداً وَمَضاؤُهُ لِحَديدِهِ",3,"د",2,0],["فلفظُهُ يأمرُنا بالتّقى","ولحظُهُ يأمرُنا بالخنا",4,"ن",2,0],["فلفظُهُ يأمرنا بالتقى","ولحظُهُ يدعو البرايا إليهْ",5,"ه",1,0],["فَلِفَرِيقٍ أَنْشَأَتْ مَصْنَعاً","وَلِفَرِيقٍ أَنْشَأَتْ مَعْهَدَا",6,"د",2,0],["فَلفَقدِه نَفَساً تَنَفُّسُهُ","ولذِكره نَهداً تَنَهَّده",7,"د",2,0],["فلفظه مرّ على ريقه","وحسنه يعذر من حبَّه",8,"ه",1,0],["فَلِفَقْده في كلِّ قلب لوعة","ولذكره في حمده ترديد",9,"د",1,0],["فلفارحي الافراح هل هلالها","يمحو العناء ضياً له لا يكسف",10,"ف",1,0],["فلفظه العذب لقلبى قوت","كأنه الدرّ أو الياقوت",11,"ت",1,0],["فلفظَتُهُ يومَ المهابةِ خطبةٌ","ولحظتُهُ يومَ اللقاء ضراب",12,"ب",1,0],["فلفقت الأكاذيبَ اختلاقاً","وما فكرت في بطشِ الحسيبِ",13,"ب",1,0],["فلفعلي فاعلان خالق","وسكوني واضطرابي فاقر",14,"ر",1,0],["فلفتة منك تحي قَلبي","او فابعثي الغمض للأَجفان",15,"ن",1,0],["فَلَفَفتُ بَينَهُمُ لِغَيرِ هَوادَةٍ","إِلّا لِسَفكٍ لِلدِّماءِ مُحَلَّلِ",16,"ل",1,0],["فُلفَاسَلاَرُ أنتَ إن تَرَاهُم","يَغيبُ في الغُبَارِ خُذ نَبَاهُم",17,"م",1,0],["فلفقده الأجفان فارقت الكرى","وخياله عنهن ليس يغيب",18,"ب",1,0],["فلفظ أهل العلم در ولا","يزين ذاك الدر إلا النظام",19,"م",1,0],["فلفظك من بردٍ وطبعُك يابسٌ","ورأسك مرطوبٌ واستُكَ في الحرِّ",20,"ر",1,0],["فلَفْظُها الدّرُّ والزهْرُ الأنيقُ إذا","ما راقَ أضوأُهُ أو رقّ أضْوَعُهُ",21,"ع",2,0],["فلفقده كالغيث دمعي قد همى","وجواي شبّ كشعلة المقياس",22,"س",1,0],["فلفوتها متحزنٌ وَلرجعها","متلفتٌ وَبما أُغرّرُ أَغبط",23,"ط",1,0],["فلفظة ينطقها دونها","عشرون في حلقومه قاطنةْ",24,"ن",2,0],["فَلفظك مُطرب سَمعى","وَمبسمك الشَهي قوتي",25,"ي",1,0],["فلفقده كالغيث دمعي قد همى","وجواي شب كشعلة المقباس",26,"س",1,0],["فلفقده شمل الغموم منظم","وببعده در الدموع منثر",27,"ر",1,0],["فَلَفَفْتَنِي كَالْغَيْمِ يَكْ","سُو الطَّوْدَ وَالْأَنْوَاءُ طَلُّ",28,"ل",1,0],["فلفظه منتن المعاني","كأنه فلتة بجحر",29,"ر",1,0],["فَلَفَظْتُها في حِمصَ يَسخُنُ حَرفُها","لِتَلينَ وِدَّاً إذْ طَرَقْتُ وَتَشعُرُ",30,"ر",1,0],["فلَفظتُها في قَعرِ عُمريْ ريثَما","تَرضىْ الحُظوظُ وَتستَقمْ أكوانيْ",31,"ن",2,0],["فلفقده كل القلوب تفطرت","ولهوله صفو الحيوة تكدرا",32,"ر",2,0]]}