{"poems":[[77,"ودرة نور في غلاف زبرجد","https://www.aldiwan.net/poem36618.html","الطويل"],[89,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[56,"شرفي محبة معشر","https://www.aldiwan.net/poem58627.html","مجزوء الكامل"],[45,"يا عارضا متلفعا ببروده","https://www.aldiwan.net/poem63492.html","الخفيف"],[69,"الواعظ الأمرد هذا الذي","https://www.aldiwan.net/poem28313.html","السريع"],[69,"قام على كرسيه واعظا","https://www.aldiwan.net/poem28632.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54735","السريع"],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[223,"لا تنكروا سكري بألفاظه","https://www.aldiwan.net/poem55414.html","السريع"],[417,"الله يعلم والأنام شهود","https://www.aldiwan.net/poem53839.html","الكامل"]],"verses":[["فلَفّتْ بمُخْضَرِّ البُرودِ بَنانَها","بُروراً وإجْلالاً عن اللّمْسِ باليَدِ",0,"د",1,0],["فلفته في أكفان خزّ جديدة","ووارته في قبر ولازمت القبرا",1,"ر",2,0],["فَلِفَتْكِهِ ولهَدْيِهِ","سَمّاهُ ذو العَرْشِ الفَتَى",2,"ت",2,0],["فَلِفِضَّةِ السَيفِ المُحَلّى حُسنُهُ","مُتَقَلَّداً وَمَضاؤُهُ لِحَديدِهِ",3,"د",2,0],["فلفظُهُ يأمرُنا بالتّقى","ولحظُهُ يأمرُنا بالخنا",4,"ن",2,0],["فلفظُهُ يأمرنا بالتقى","ولحظُهُ يدعو البرايا إليهْ",5,"ه",1,0],["فَلِفَرِيقٍ أَنْشَأَتْ مَصْنَعاً","وَلِفَرِيقٍ أَنْشَأَتْ مَعْهَدَا",6,"د",2,0],["فَلفَقدِه نَفَساً تَنَفُّسُهُ","ولذِكره نَهداً تَنَهَّده",7,"د",2,0],["فلفظه مرّ على ريقه","وحسنه يعذر من حبَّه",8,"ه",1,0],["فَلِفَقْده في كلِّ قلب لوعة","ولذكره في حمده ترديد",9,"د",1,0]]}