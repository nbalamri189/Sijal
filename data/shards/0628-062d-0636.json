{"poems":[[53,"هجاني حفيص ولم أهجه","https://www.aldiwan.net/poem61875.html","المتقارب"],[71,"بحضوركم نتشرف","https://www.aldiwan.net/poem28625.html","مجزوء الكامل"],[71,"بحضوركم نتجمل","https://www.aldiwan.net/poem28626.html","مجزوء الكامل"],[242,"يا من مآثره عديده","https://www.aldiwan.net/poem18137.html","مجزوء الكامل"],[342,"كأني كسوت الرحل جونا رباعيا","https://www.aldiwan.net/poem45420.html","الطويل"],[411,"بحضرة سلطاننا عصبة","https://www.aldiwan.net/poem49648.html","المتقارب"],[505,"جدي بواسط أوسط القوم الألى","https://www.aldiwan.net/poem38041.html","الكامل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96356","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112942","الطويل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95379","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102134","الهزج"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132362","الوافر"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102510","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204860","الوافر"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103907","الطويل"],[4691,"أنا ما حييتُ ذكورٌ","https://www.poetsgate.com/ViewPoem.aspx?id=200026",""],[4885,"أما لمحب عندهن وداد","https://www.poetsgate.com/ViewPoem.aspx?id=215718",""],[4898,"إنّا هُنا !","https://www.poetsgate.com/ViewPoem.aspx?id=35811",""],[4935,"صفت في روض حلوان","https://www.poetsgate.com/ViewPoem.aspx?id=129433",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5281,"موكب العظماء","https://www.poetsgate.com/ViewPoem.aspx?id=199663",""],[5355,"لأني أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=196611",""],[5431,"الأنثى(الكلبة)...","https://www.poetsgate.com/ViewPoem.aspx?id=212495",""],[5605,"بكاء الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161345",""],[5850,"كأنيّ كَسَوْتُ الرَّحْلَ جَوْناً رَبَاعياً","https://www.poetsgate.com/ViewPoem.aspx?id=19718",""],[5897,"منصة العرفان","https://www.poetsgate.com/ViewPoem.aspx?id=157484",""],[5939,"معي دائما","https://www.poetsgate.com/ViewPoem.aspx?id=178621",""]],"verses":[["بحضرته كان ما أدَّعي","وما كنت بالزور مستشهدا",0,"د",2,0],["بحضوركم نتشرفُ","وإليكمُ نتشوَّفُ",1,"ف",1,1],["بحضورِكُمْ نتجمَّلُ","وبقربِكُمْ نتأهلُ",2,"ل",1,1],["بِحُضُورِكُمْ إِنْ كانَ لاَ","يُدْنِي مَراتِبَكَ البَعِيدَهْ",3,"د",2,0],["بِحَضرَتِهِ رامٍ أَعَدَّ سَلاجِماً","وَبِالكَفِّ طَوعُ المِركَضَينِ كَتومُ",4,"م",1,0],["بِحضْرَةِ سُلطانِنا عُصْبَةٌ","نزلون عن قَصدِ أنحائهِمْ",5,"م",1,1],["بحضيرَةٍ قُدسيَّةٍ نَبَوِيَّةٍ","وبَلابلُ العِرْفانِ فيها صادحهْ",6,"ح",2,0],["بحضيضِ رابِيةٍ يَهزُّ مُذلّقاً","صَلباً يكونُ له الطِلالُ دِهانا",7,"ن",2,0],["بحضرتهم نرجوا سلوك سبيلهم","وحسن ختام فيه لِلّه اقدام",8,"م",1,0],["بحضرة قوم أوجع الجوع منهم","قلوباً فهم في حيرة وضلال",9,"ل",1,0],["بحضراتي جميعاً","بِدُنيا والنعيم",10,"م",1,0],["بحضرتهِ عصى التسيارِ ألقَت","وفرَّقَتِ اللِّبَادَ مع الرِّحالِ",11,"ل",1,0],["بحضوري قد طاب لي حضراتي","فأديموا براحكم راحاتي",12,"ت",2,0],["بحضرة خالقي كان العشاء","ومن آياته كان الغذاء",13,"ا",2,1],["بحضرة الامام تاج الملّه","ابى شجاع ابن ركن الدولة",14,"ه",1,0],["بحضرة جبار رفيقٍ معاقب","فتحصى المعاصي كبرها وصغارها",15,"ر",3,0],["بحضنك خمّارتي فاسمحي","لأشرب حبّك كاسا فكاسا",16,"س",2,0],["بحضنك تخبو يا سليمى لواعجي","وثغرك شهد والسلو جهاد",17,"د",1,0],["بِحَضَارَةٍ سَلَفَتْ ، بِعُمْقِ تُرَاثِنَا ،","وَبِفِكْرَةِ الإنْجِيْلِ ، بِالقُرآنِ",18,"ن",1,0],["بحضرة أنسنا يذكو","سناها بين أعيان",19,"ن",1,0],["بحضرتك العليا حثى كل متق","محوط بعصري وءادم ابن مريما",20,"م",2,0],["بحضرة أو أدنى دنا بلغ المنى","وكلمه ثم الإله وناجاه",21,"ا",2,0],["بحضارةٍ قد جئتَ تحملُ حِكمةً","فأَضِفْ إليها العلمَ في إِحْكَامِ",22,"م",1,0],["بِحضرةِ عَينَيكِ أهَوىٰ شُرودي","فَلوْ قلتُ شيئًا أذبتُ الجَلِيدَا",23,"د",2,0],["بحضرته استعذتُ من انشغالي","بما قد هان من عزم الأمور",24,"ر",1,0],["بحضن السلم قد سهرت ونامت","وحكم القهر جاوزه القطار",25,"ر",1,0],["بحضرتهِ رامٍ أعدَّ سلاجماً","وبالكفِّ طَوْعُ المركفيْنِ كَتُومُ",26,"م",1,0],["بحضورِ ملهمةِ المساءِ شجونَهُ","في ليلة قدسية الألوانِ",27,"ن",1,0],["بِحِضني أنتَ، بِطَرْفِ المُنَى","وفي قلبي إنْ ثَوَى أو هَمَى",28,"م",2,0]]}