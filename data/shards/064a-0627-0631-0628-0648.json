://www.poetsgate.com/ViewPoem.aspx?id=34867",""],[1920,"العتقاء","https://www.poetsgate.com/ViewPoem.aspx?id=204719",""],[5956,"يا رب وفّقْ زوجتي بأمورها","https://www.poetsgate.com/ViewPoem.aspx?id=182416",""],[5977,"خير الشهور","https://www.poetsgate.com/ViewPoem.aspx?id=212853",""],[5977,"عشر ذي الحجة","https://www.poetsgate.com/ViewPoem.aspx?id=213249",""],[5977,"يا رب","https://www.poetsgate.com/ViewPoem.aspx?id=213290",""],[5977,"جمال الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=213291",""],[6089,"خيلُ العبادِ","https://www.poetsgate.com/ViewPoem.aspx?id=212940",""],[6152,"دعاء صباحي للأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=208533",""],[6213,"القَدَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76315&r=&rc=63",""],[6318,"فلق الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66162&r=&rc=12",""]],"verses":[["يا رَبِّ واجْعَلْ لوْعَتي في قلْبِه","يا رَبِّ واجْعَلْ لِحْيَتي في وجْهِهِ",0,"ه",1,0],["يا رَبُّ وَأَنتَ لي رَحيمٌ","قَد جِئتُكَ راجِياً وَآمِل",1,"ل",1,0],["يا رُبوعَ الدِيارِ إِنّي عَلى ما","قَد أَراهُ مِنكُنَّ غَيرُ جَليدُ",2,"د",1,0],["يَارَبِّ وَاْجْعَلْ مِنَ الخَتْمِ البِدَايَةَ","وَاْنْصُرْنَا وَهَيِّءْ لَنَا مِنْ أَمْرِنَا رَشَدَا",3,"د",2,0],["يارُبَّ وَضّاحِ الجَبينِ كَأَنَّما","رَسمُ العِذارِ بِصَفحَتَيهِ كِتابُ",4,"ب",1,1],["يا رُبوع الفَيحاء أَنتِ عَروس","أَيّمتها طَوارق الحَدثان",5,"ن",1,0],["يارَبِّ وَاجْعَلْ رَجائي غَيرَ مُنْعَكِسِ","لَدَيْكَ وَاجْعَلْ حِسابِي غَيْرَ مُنْخَرِمِ",6,"م",1,0],["يَارَبِّ واغْفِرْ لِتَالِيها وسامِعِها","وَالمُرْسَلِينَ جَمِيعاً أَيْنَمَا حَضَرُوا",7,"ر",3,0],["يا رُبَّ وادٍ يومَ ذاكَ تركْتَهُ","وقطينُهُ فيه أتِيٌّ سائلُ",8,"ل",1,0],["يا ربّ وَفِّ المرَزّا","بِوُلدِهِ ما وَعَدتُه",9,"ت",2,0],["يا رُب وجهِ مشرق","تحتَ الرمال خبا ضياؤه",10,"ا",3,0],["يا رب وقت ينير اللطف ظلمته","فالعتم يزهرو الغياب حضار",11,"ر",1,0],["يَا رَبِّ وَسِّع قَبرَهَا وأملأهُ مِمَّا","تشَتَهِى في سَائِرِ الأَحوَالِ",12,"ل",1,0],["يَا رُبُوعَ الرَّبَابِ هَيَّجتِ شَوقِى","وإِدِّكَارِى ولَوعَتِى وَوُلُوعِى",13,"ع",2,0],["ياربِّ وفقنا إلى","ما فيهِ خير العالمينْ",14,"ن",1,0],["يا رب واشملهم بعفوٍ دائم","كن راضيا عنهم رضا المتفضل",15,"ل",1,0],["يا رب واجعلْ له في القبر منفسحا","وروضةً ترتضى نشراً ومقتَصفا",16,"ف",2,0],["يا رب وفقني وسدد وكن","عوناً لنا في السر والجهر",17,"ر",1,0],["يا رب واجبرنا ووفقنا لما","يرضيك عنا أنت أسمع من دعى",18,"ع",2,0],["يا رب واختم باليقين وبالهدى","أعمارنا والزيغ عنا فادفع",18,"ع",1,0],["يا رب واجمعنا وأحباباً لنا","في دارك الفردوس أطيب موضع",18,"ع",1,0],["يا رب واختم بخير","إن حان حين المسير",19,"ر",1,0],["يا رَب وَاختم بِاليَقين وَتَوبة","مَقبولة لِأَصاغر وَأَكابر",20,"ر",1,0],["يا رَبِّ وَاِعطِف عَلى رَيحانَتي أَثَرٌ","مِنهُ وَزِد لَهُما قَدراً عَلى قَدرِ",21,"ر",1,0],["يارب واختم بخير واكفنا كل ضير","ولا تكلنا لغير وأصلح نفوسا غويه",22,"ه",1,0],["يارب واختم لنا بالخير","لكل من حينه قد حان",23,"ن",1,0],["يارب واختم لنا بالخير","إن حان حين أوان السير",24,"ر",1,0],["يا رب واختم لنا بالخير","إن حان حين انتها الأعمار",25,"ر",1,0],["يا رب وامح الذنوب القاصمات الظهور","وتب علينا بتوبة صدق فيها طهور",26,"ر",1,0],["يا رب واختم بخير يا كريم","لكل من كان حينه قد درج",27,"ج",1,0],["يا رب واحفظ لي أولادي","والأهل والجار والاصحاب",28,"ب",1,1],["يا رب واختم لنا مقالتنا","بقولنا لا إله إلا اللّه",29,"ل",2,0],["يا رب واغفر لنا جميعاً","وأحسن من عمرنا ختامه",30,"م",2,0],["يا رب وال اليوم من والاه","وعاد يا ذا العرش من عاداه",31,"ه",1,0],["يا رُبَّ وَقتٍ مَرَّ لي في ظِلِّهِ","ما كانَ سَيفاً بل نَعيماً قَد ضَفا",32,"ف",2,0],["يا ربُّ وفقني للخير","واقتل عدوي بيديّ غيري",33,"ي",1,1],["يا ربِّ والِ من يوالي حَيدراً","وعادِ مَن عاداه واخذُلْ من خَذَلْ",34,"ل",1,0],["يا ربوعَ الأَوطان حيَّا الحياتُر","بَكِ وليحيَا ساكنوكِ الكِرَامُ",35,"م",1,0],["يا ربوعَ الأنس يا دارَ الصَفَا","يا جنانَ الخلدِ يا أَهنَا مقام",36,"م",1,0],["يا رب واجعله من أمسى بمدخله","للقبر في جنة الفردوس قد دخلا",37,"ل",2,0],["يا رَبِّ وَاِنصُر جُندَهُ","يا رَبِّ أَهلِك ضدَّهُ",38,"ه",1,0],["يا ربّ وَقلِّلْ عِدّتهم","لا تُبقِ لَهم أَدنى عددِ",39,"د",1,0],["يا رَبِّ وَقوِّ عَزائِمَنا","وَاِجعَلهُم ربّي غَنائِمنا",39,"ن",2,0],["يا رَبِّ وَاِجعَل رايتَهْ","بِالرُّعبِ لِلأَعدا تُذيب",40,"ب",1,0],["يا رب واحرس علا الإسلام حيث هفت","أعلامه وتراءت شمس أرجاه",41,"ا",2,0],["يا رب وانصر لوا الإسلام واحم حمى","أئمة الدين واخز الضلل السخفا",42,"ف",2,0],["يا رب واقبل دعائي بالحبيب وهب","لابن الخلوف الرضا واحمل له الخلفا",42,"ف",2,0],["يا رب وانصر لوا الإسلام واحم حماي","رسم الهداية أن يعروه تبطيل",43,"ل",1,0],["يا رب واكلا بجاه المصطفى كرما","مولاي عثمان من شر البليات",44,"ت",1,0],["يا رب واكلا أمير المؤمنين أبا","عمرو الرضا من به ترعى الخلافات",45,"ت",1,0],["يا رب وانصر لو الإسلام واحم به","أئمة الدين واخز الضلل اللؤما",46,"م",2,0],["يا ربوع الهوى بأية كأس","قد سقاني فيك الهوى من سقاني",47,"ن",2,0],["يا رب والأهوال طال عكوفها","بالقلب والضرا عليه تردد",48,"د",1,0],["يا رب والأعظاء مازالت على","ثقل الذنوب وسوء حالي يشهد",48,"د",1,0],["يا رب واتحفنا بحسن وصاله","يا رب واغمرنا بفيض نواله",49,"ه",1,0],["يا رب واغفر لمن أحبنا ولنا","زَلّاتهِ كيفَما يأتي وزلاني",50,"ي",1,0],["يا رب وامنحني رضاك وعافني","من عظم داء في الضلوع دفين",51,"ن",1,0],["يا رب وفقني إلى خير العمل","وعني امح سيدي كل الزلل",52,"ل",1,0],["يا ربّ واشفى للسقام وعافني","وأعِذ من الأحزانِ والأمر الردي",53,"د",2,0],["يا ربّ واسمح للعبيد بحبُكم","واكشف لسرّي عن كلامِك فاقتدي",53,"د",2,0],["يا رب واجعلها بفضلك كاسمها","أنس افطار وسلم الأوطار",54,"ر",1,0],["يا رب وانصر خير حزبينا على","حزب الضلال وعسكر الشيطان",55,"ن",1,0],["يا رب واجعل شر حزبينا فدى","لخيارهم ولعسكر القرآن",55,"ن",1,0],["يا رب واجعل حزبك المنصور أه","ل تراحم وتواصل وتدان",55,"ن",1,0],["يا رب وارحمهم من البدع التي","قد أحدثت في الدين كل زمان",55,"ن",1,0],["يا رب واهدهم بنور الوحي كي","يصلوا اليك فيظفروا بجنان",55,"ن",1,0],["يا ربّ وارجِعنى إليك منها","مَصُونُ سِرِّى إصرِفَنَّ عنها",56,"ه",2,0],["يا ربِّ وأسلُك بى سُلوكَ الجَذبِ","وأهلِهِ من كان أهلَ قُربِ",57,"ب",1,0],["يا رب وفق والذنوب اغفر لنا","وكن الولي لنا وجد برضاء",58,"ا",2,0],["يا رب وصل على طه","من كان رئيسا للرؤسا",59,"س",2,0],["يا رب واحسن عاقبتي","واختم للنفس بما نفسا",59,"س",2,0],["يا ربوعاً كانت معاهد اح","سان وحسن فاصبحت قفراء",60,"ا",2,0],["يا رب واجعل رَجائي غير منعكس","وارفع مضارع فعلي جا كمنجزم",61,"م",1,0],["يا رب واجعل لي الحظ الجسيم","من رحمتك والعطا والاتهاب",62,"ب",1,0],["يا رب وفقنا وأصلح حالنا","ما أنت يا رب الورى بالناسي",63,"س",2,0],["يا رب وفق وثبت واعف عن ذللى","حقق رجاي واتمم سابغ النعم",64,"م",1,0],["يا رب وافتح بوصل لا يمازجه","فصل ورفد عميم غير منفصم",64,"م",1,0],["يا رب واستر عيوبا لا تعد وعد","وامنن بعفو ومحص كل مجترمي",64,"م",2,0],["يا رب واغفر ذنوبا وثفت جلدي","عن المسير بارض العلم والحكم",64,"م",1,0],["يا رب واغفر لنا ما كان من ذلل","واختم بخير وسدد واهد للقوم",64,"م",1,0],["يا ربّ واكحُل ناظري بالنظَر","إلى إمام غائبٍ منتظَرِ",65,"ر",1,0],["يا ربِّ واجعلني لأهلك مخلصاً","في خدمة الشفعاءِ والأحنافِ",66,"ف",1,0],["يا رب ووفق لجوابِ الملكينِ","ونور لي لحدي",67,"د",2,0],["يا ربِّ وفقنا وألهمنا لما","فيهِ لنا الخيرُ فأنتَ المُلهمُ",68,"م",1,0],["يا ربِّ وانصرنا على أعدائنا","يا ربِّ واعصمنا فأنت تعصم",68,"م",1,0],["يا ربوع الحبيب لا اقفرت من","كِ المغاني ولا جمالكِ اخلق",69,"ق",1,0],["يا رب واغفر وارحم","فإنك الغفار",70,"ر",1,0],["يا رب وامنعنا من الشيطان في","صبحٍ لنا من دهرنا ومساء",71,"ا",2,0],["يا رب واكشف عن عبيدك فادحاً","أضحوا به في حالة الضراء",71,"ا",2,0],["يا رب واضرب سور حفظ عنايةٍ","صمدية لعبيدك الضعفاء",71,"ا",2,0],["يا رب واعصمنا من الأشرار مع","محن الزمان وكربة اللأواء",71,"ا",2,0],["يا رب وامهد في القلوب توددا","وتعطفاً من شرة البغضاء",71,"ا",2,0],["يا رَبِّ واكفِنا مهمَّاتنا","فَمَن تَكُن كافِيَهُ يَكتَفِي",72,"ي",1,0],["يا رب وامنح جمعنا","بالمصطفى حسن الختام",73,"م",1,0],["يا رب وانظر لنا برحمةٍ سبقت","ذنوبَنا فالكريم أنت والسَّندُ",74,"د",1,0],["يا رَبِّ وَطّد عَرشَهُ","بِالعزِّ وَالنَصرِ المَديد",75,"د",1,0],["يا ربوعاً أقفرت من","ناطقٍ فيها وقاطن",76,"ن",1,0],["يا ربوع الفَيحاء جادَك غَيثٌ","هاتنٌ من مَحاسِن الأَخلاقِ",77,"ق",1,0],["يا ربِّ وفق لي الرجوع لأرضها","يا رب سهّل اوبة المتناءِي",78,"ا",2,0],["يا رب وفقنا واصلح الحال","وكن لدى العقبى لنا وفي الحال",79,"ل",1,0],["يا رب وفق وأيدنا وسامحنا","وكن لنا في دنانا ثم منقلب",80,"ب",1,0],["يا رب وفقنا وألهمنا الهدى","وتولنا في كل حالٍ أبدا",81,"د",2,0],["يا رب وادفع الوبا","وجاف عنا التعبا",82,"ب",2,0],["يا رب واهلك من علينا قد بغى","واغفر لنا يا سامعاً لدعانا",83,"ن",2,0],["يا رب واختم بخير فى الممات لنا","والمسلمين كذا واختم بايمان",84,"ن",1,0],["يا رب واني شاعرٍ واني أهيم بكل واد","يتبعني الغاوون من نايد ملا واعتى بلد",85,"د",1,0],["يا رب وانت اعلم بما بي والروابع بازدياد","أنت السند وانا إلهي مؤمنٍ بانك سند",85,"د",1,0],["يارب وفق من عن العين غايب","وحقق طموحه في جميع المجالات",86,"ت",1,1],["ياربِّ واجْعلْ بعلِّيِّين مَنْزِلَها","معَ النَّبيِّينَ أصحاباً ومَنْ أَلِفُوا",87,"ف",3,0],["يا رُبَّ وَعْدٍ للخَلِيقةِ باذخٍِ","يَطْوِي أَسَاها ربَّما لا تُظلمُ",88,"م",1,0],["يا رب وفقني لخير عمل","ترضاه وأسعدني على طول الزمن",89,"ن",1,0],["يا ربوع المجد، يا رمز الإباء","يا رِياضَ الفضل، يا أرضَ العطاءْ",90,"ا",2,1],["يَا رَبِّ وَحِّدْ صُفُوفَ الْمُسْلِمِينَ فَهُمْ","فِي ضَعْفِهِمْ قِطَطٌ فِي الثَّدْيِ عُمْيَانُ",91,"ن",1,0],["يا رب واشمل آله كلما","أنعش ذاك الروضَ قطرُ الندى",92,"د",2,0],["يا ربَّ وادٍ في الصباح منضّرٍ","غيسانَ باكرهُ السنا فتأوّدا",93,"د",2,0],["يَا ربوعَ النَّخيلِ أينَ الجَوَارِي","راقصاتٌ وَ أينَ أينَ الظِّبَاءُ ؟؟",94,"ا",2,0],["يَا رُبَّ وَجْهٍ كَأَنَّ اللَّهَ زَيَّنَهُ","مِنْ نُورِ بَدْرِكَ يَا لَيْلاً بِهِ الأَلَقُ",95,"ق",1,1],["يا رب وفقني لأسجد سجدة","سجد النبي بها على أذقانه",96,"ن",2,0],["ياربّ واجعل رجائي غير منعكس","واجعل هواي نقيّ الحبيب والأدم",97,"م",1,0],["يا رب واسق ضعيفا صاديا عطشا","يوم القيامة واغفر زلة الأثم",98,"م",1,0],["يَا رَبِّ واجعله يَومُ الحَشْرِ مَدْخَلنَا","بِفَضلِهِ عَن غَوَايَا النَّفسِ نَنتَصِرُ",99,"ر",1,0],["‎يارب وأن ضاقت فلا غيرك معين،","يأخذ بيدي عن دروب العواجه",100,"ج",2,1],["يَا رَبِّ وَارْوِ ثَرَاهَا مِنْ دِمَاءِ فَتًى","يَرْجُو لِقَاها نَصِيرًا مُوفِيَ الذِّمَمِ",101,"م",1,0],["يَا رَبِّ .. وَفّقْنَا بِهِ .. وَلِخَيْرِهِ","وَاكْتُبْ لَنَا الطَّاعَاتِ .. يَا مَنَّانُ",102,"ن",1,0],["ياربّ وجهك دون الخلق مَلجؤها","والشّام ظمأى لمن بالحب يرويها",103,