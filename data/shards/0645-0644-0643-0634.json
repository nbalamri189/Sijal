{"poems":[[53,"أصل نما بك ربه فرعه","https://www.aldiwan.net/poem65410.html","أحذ الكامل"],[72,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[47,"يا ابنة العامري عما قليل","https://www.aldiwan.net/poem65557.html","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[438,"حي وجها من الرياض وسيما","https://www.aldiwan.net/poem12376.html","الخفيف"],[438,"ما لقلبي على فراقك صبر","https://www.aldiwan.net/poem12459.html","الخفيف"],[438,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[438,"لا تجرد علي مرهف جفني","https://www.aldiwan.net/poem12738.html","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62492","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62488","الرمل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107188","الخفيف"],[1611,"","https://poetry.dctabudhabi.ae/diwan/poem/106718","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67986","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77136","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94819","الكامل"],[4418,"","https://poetry.dctabudhabi.ae/diwan/poem/95777","الكامل"],[5136,"يا لها قبة تلألأ نورا","https://www.poetsgate.com/ViewPoem.aspx?id=121549",""]],"verses":[["مُلكٌ شرَوه من عدوِّهمُ","سفهاً فكنت أحق بالشفعه",0,"ع",2,0],["مَلِكٌ شَمَختُ عَلى المُلوكِ بِقُربِهِ","وَلَبِستُ ثَوبَ العِزِّ مِنهُ مُسبَلا",1,"ل",2,0],["مَلِكٌ شاكَلَت شَمائِلُهُ الرَوضَ ال","مُخَلّى جارَ السَحابِ المُخيلِ",2,"ل",1,0],["مَلِكٌ شَادَ لِلْكنَانةِ مَجْداً","أَحْكَمَتْ وَضْعَ أُسِّهِ آباؤُهْ",3,"ا",3,0],["مَلِكٌ شادَ لِلْكنانةِ مَجْداً","فَسَمَتْ باسْمِهِ عَلَى البُلدانِ",4,"ن",1,0],["ملِكٌ شاعِرُ السّماحَةِ يأْبَى","أَنْ يَمَلَّ التَّسْهِيم والتَّقْسِيما",5,"م",2,0],["ملكٌ شاعرُ السماح تراه","وهو يُبدي لنا دقيقَ المعاني",6,"ي",1,0],["ملكٌ شاكَلَتْ شمائلُهُ الرو","ضَ وأضحَتْ كوجهه الأقمارُ",7,"ر",1,0],["ملكٌ شاعرُ السماحِ تَراهُ","فيه يُبدي لنا دقيقَ المَعاني",8,"ن",2,0],["ملك شهم أيادي","ه تعم الأرض فضلا",9,"ل",2,0],["ملك شيَّد أركان العُلا","وانتهى الأمرُ إليه واستقرْ",10,"ر",1,0],["مَلِكٌ شادَ مِن بِنا المجدِ ما قَد","أَسَّسَتهُ آباؤهُ وَالجُدُودُ",11,"د",1,0],["مَلكٌ شَفا الدينَ مِن أَدوائِه وَكَفى","داءً مِنَ الجَوفِ فيهِ الكُفرُ مَعبودُ",12,"د",1,0],["مَلكٌ شَبَّ فِي السياسةِ طفلاً","وامتطى غاربَ العُلى والسَّناما",13,"م",2,0],["مَلِكُ شَأى كُلَّ المُلوكِ بِعَزمِهِ","وَبِمَجدِهِ وَبِجودِهِ وَالمُحتَدِ",14,"د",1,0],["ملِكٌ شهيرٌ لا بسطوة سُلطَةٍ","لكن بفاخر حلَّة الأطيار",15,"ر",1,0],["مَلِكٌ شَكَكنا أَيُّها أَعلى عُلاً","أولاهُ أم وُسطاه أم أُخراه",16,"ه",1,1],["ملك شهم من يناظله في","المجد نكيس وسهمه المريخ",17,"خ",1,0]]}