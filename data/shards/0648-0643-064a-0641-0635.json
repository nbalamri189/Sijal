{"poems":[[48,"قفي وقفة تعلمي","https://www.aldiwan.net/poem23423.html","مجزوء المتقارب"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/142172","الطويل"],[228,"تذكرني وحقك ما نسيت","https://www.aldiwan.net/poem39692.html","الوافر"],[520,"صفو الحياة وإن طال المدى كدر","https://www.aldiwan.net/poem12141.html","البسيط"],[556,"أفي كل يوم لي حميم أفارقه","https://www.aldiwan.net/poem47369.html","الطويل"],[567,"هل للذي في حشاه حزن يعقوب","https://www.aldiwan.net/poem52873.html","البسيط"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138166",""],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64444","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110282","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138564",""],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33809","السريع"],[4403,"","https://poetry.dctabudhabi.ae/diwan/poem/146622","الطويل"],[4755,"عمر أبو ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=203643",""],[4755,"مأساة سُهَيل اليَمَاني ( 4 )","https://www.poetsgate.com/ViewPoem.aspx?id=210757",""],[4755,"مأساة سُهَيل اليَمَاني ( 5 )","https://www.poetsgate.com/ViewPoem.aspx?id=210758",""],[585,"هل في القطين وراء المنش مستمع","https://www.poetsgate.com/ViewPoem.aspx?id=161904",""],[1043,"بعث ..!","https://www.poetsgate.com/ViewPoem.aspx?id=96829",""],[5730,"كنا حبيبين","https://www.poetsgate.com/ViewPoem.aspx?id=210372",""]],"verses":[["وَكَيفَ صُعودي إِلى","الثُرَيّا بِلا سُلَمِ",0,"م",1,0],["وكيف صحبت الناس حتى عرفتهم","فعدت جريح العين واليد والصدر",1,"ر",1,0],["وَكَيفَ صَواعِقُ الأَفكارِ تَهوي","وَكَيفَ يُجَلجِلُ الشَعبُ الصَموتُ",2,"ت",1,0],["وكيف صدت وجوه كنت قبلتها","وأغلقت دونها الأبواب والحجر",3,"ر",1,0],["وكيف صفاءُ العيش للمرء بعدما","تغيّبَ عنه رَهْطُهُ وأصادِقُهْ",4,"ق",2,0],["وكيفَ صَبرٌ بلا قَلب يقومُ بهِ","فقلبُ كلِّ مُحِبٍّ عِندَ محبوبِ",5,"ب",1,0],["وكيف صحا من نومه بعد حقبة","تحجر فيه لا غرام ولا وُد",6,"د",1,0],["وكيف صعود النفس عن مستقرها","ومن حيث ظنت نالت العز ذلت",7,"ت",1,0],["وكيف صفا البوسفور بعدك ماؤه","وقد كان عجاجاً بامواجه الحمر",8,"ر",1,0],["وكيف صدر ضم على المصطفى","عليه خيل الظالمين تلعب",9,"ب",1,0],["وَكيفَ صَبرُ النَفسِ عَن غادَةٍ","تَظلِمُها إِن قُلتَ طاووسَه",10,"س",2,1],["وكيف صنيع الدهر بعدي فيهم","ولم أر للأحرار أعدى من الدهر",11,"ر",1,0],["وكيف صارُوا هَبَاءً لا صَرِيخَ لَهُم","وكيف مِنهُم عليهِم أَصبَحَ الضَّرَرُ",12,"ر",1,0],["وكيف صار غَريبًا وهو وَالِدُنا","وجَدُّنا، وهو وَالِينَا، ومَولانا",13,"ن",2,0],["وكيف صار عُبَيدًا لِلعَبِيدِ له","وكان أَكثَرَ غاراتٍ وفُرسانا؟!",14,"ن",2,0],["وكيف صح لديكم أن يفارقهم","من ذلك الطبع لؤمٌ فيه منطبع",15,"ع",1,0],["وكيف صحا من نومه بعد حقبة","تحجر فيها لا غرام ولا ود",16,"د",1,0],["وكيف صار حديث الحب مأتمنا","وأشعل الحزن في الأضلاع نيرانا",17,"ن",2,0]]}