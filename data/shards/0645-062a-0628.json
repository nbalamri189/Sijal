1",""],[5281,"مهرجانُ الغيم.. أبها","https://www.poetsgate.com/ViewPoem.aspx?id=199736",""],[5376,"رمضان هلَّ بنوره البراق","https://www.poetsgate.com/ViewPoem.aspx?id=188347",""],[5408,"إليّ ولا أحد","https://www.poetsgate.com/ViewPoem.aspx?id=190738",""],[5725,"نثروا الرماح","https://www.poetsgate.com/ViewPoem.aspx?id=178305",""],[5784,"أنت السجين","https://www.poetsgate.com/ViewPoem.aspx?id=196951",""],[5911,"وَلَقَد بليت بشادن إِن لمته","https://www.poetsgate.com/ViewPoem.aspx?id=188960",""],[5943,"أمراء","https://www.poetsgate.com/ViewPoem.aspx?id=37339",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""],[5956,"أولادي والحمد لله وعقبال أولاد الجميع وأكثر","https://www.poetsgate.com/ViewPoem.aspx?id=192025",""],[5956,"نوعٌ جديد","https://www.poetsgate.com/ViewPoem.aspx?id=192427",""],[5997,"براءة","https://www.poetsgate.com/ViewPoem.aspx?id=214220",""],[6127,"لولاك عدنا في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=188606",""],[6152,"لله أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=203750",""],[658,"عاني الغواية ما له من راحم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=603984",""],[321,"أسعد بمولود اتاك مباركا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=606416",""],[6244,"ربيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=509&r=&rc=2",""]],"verses":[["مُتَبَلِّجٌ كَرَماً إِذا سُئِلَ الجَدا","مَطَرَ النَدى أَمَماً وَلَم يَتَغَيَّمِ",0,"م",1,0],["مُتَبَقِّلاتٌ بِاللَديدِ وَرامَةٍ","بَينَ القَنا المَنزوعِ وَالمُتَلَهذِمِ",0,"م",1,0],["مُتَبارِياتٍ في الأَعِنَّةِ قُطَّباً","حَتّى تُفيءَ عَشِيَّةً أَنفالَها",1,"ل",3,0],["مُتَبَسِّمٌ وَعَلى مَعارِفِ وَجهِهِ","آياتُ ما يَلقى مِنَ الأَوصابِ",2,"ب",1,0],["مُتَبَسِّمٌ في كُلِّ يَومٍ عابِسٍ","مُتَوَضِّحٌ في كُلِّ خَطبٍ أَسفَعِ",3,"ع",1,0],["مُتَبَرِّعٌ بِالجودِ قَبلَ سُؤالِهُ","وَالجودُ جودُ الباديءِ المُتَبَرِّعِ",3,"ع",1,0],["مُتَبَوِّئونَ جَنابَ عَيشٍ مونِقٍ","مُتَفَيِّئونَ ظِلالَ أَمنٍ شائِعِ",4,"ع",1,0],["مُتَبَتِّلٍ لِلْعِلْمِ مَشْغُولٍ بِهِ","عَنْ رَشْفِ كَاسَاتٍ وَعِشْقِ غَوَانِ",5,"ن",1,0],["مُتَبَسِّماً وَمِنَ النَّذِيرِ تَبَسُّمٌ","يَبْدُو قُبَيْلَ تَوَقُّدِ النِّيرَانِ",6,"ن",1,0],["مُتَبَسِّمٌ واليوم أكلحُ عابسٌ","والحربُ تدعو بالكُماةَ نَزَالِ",7,"ل",1,0],["مُتَبَتِّلٍ عَن كُلِّ فاحِشَةٍ","سَكَنَ الصَوامِعَ رَهبَةَ الوِزرِ",8,"ر",1,0],["مُتَبَسِّماً عن شبه مَبْ","سمِك البَرُود إذا ابتسمتا",9,"ت",2,0],["متبادرين قصيفه بوميضه","متناذرين حريقه بقصيفه",10,"ف",2,0],["متبادراتِ دليفِه بزئيره","متناذرات وثوبه بدليفه",10,"ف",2,0],["مُتبلِّجِ الضَّحواتِ مُشرِقِها","متأرِّجِ الأسحار والعَتَمِ",11,"م",1,0],["مُتَبَسِّماً لِعُفاتِهِ عَن واضِحٍ","تَغشى لَوامِعُهُ البُروقَ اللُمَّعا",12,"ع",2,0],["متبرجٌ للوفدِ همَّتُهُ","بينَ الوفُودِ وبينَهُ حُجْبُ",13,"ب",1,0],["مُتبِعٌ كُلَّ مَضيقٍ فَرجَةً","مُمسِكٌ مِن كُلِّ نَفسٍ بِرَمَق",14,"ق",1,0],["مُتَبَيِّنٌ لِلحَقِّ قَبلَ وُقوعِهِ","هَضّامُ جانِبِ مالِهِ ظَلّامُهُ",15,"م",2,0],["مُتَبَسِّمٌ عَن لُؤلُؤٍ مُتَلَألِئٍ","وَنَواعِمٍ مِثلَ البُدورِ حِسانِ",16,"ن",1,0],["مُتَبَذِّياً ذَرِبَ اللِسانِ مُفَوَّهاً","مُتَمَثِّلاً بِغَوابِرِ الأَشعارِ",17,"ر",1,0],["مُتَبَرقِعي لُؤمٍ كَأَنَّ وُجوهَهُم","طُلِيَت حَواجِبُها عَنِيَّةَ قارِ",18,"ر",1,0],["مُتَبَسِّمٌ يَنْهَلُّ في استهلالِه","ماءُ الحياةِ فإن تَلَهَّبَ أصعَقا",19,"ق",2,0],["مُتَبرِّعٌ بنَوالِه جارٍ على","كَرَمِ الطِّباعِ إذا اللَّئيمُ تكلَّفا",20,"ف",2,0],["متبسِّمٌ قبلَ النهارِ كأنما","زَرًّ النهارُ عليه ثَوبَ ضَحائِه",21,"ا",3,0],["مُتَبَرِّئًا مِني إِذا نُضِدَ الثَرى","فَوقي طَوى كَشحاً عَلى هِجراني",22,"ن",2,0],["متبدلينَ موائداً وأحبةً","ما خابَ مِن حبٍّ فآخرُ يفلحُ",23,"ح",1,0],["مُتَبَذِّلٌ في القَومِ وَهوَ مُبَجَّلٌ","مُتَواضِعٌ في الحَيِّ وَهوَ مُعَظَّمُ",24,"م",1,0],["مُتَبَهِّمٌ في غَرسِهِ أَنصارُهُ","عِندَ النِزالِ كَأَنَّهُم أَنصارُ",25,"ر",1,0],["مُتَبَسِّمٌ في هِزَّةٍ فَكَأَنَّهُ","غُصنٌ تَفَتَّقَ نَورُهُ مَيّادُ",26,"د",1,0],["متبلِّج الآثارِ ما ركبَ الهَوى","يوماً ولا خلطَ الهُدى بِضَلالِ",27,"ل",1,0],["مُتبلِّجاتٌ قبل في أزدِيِّهَا","ما قيل في أسْدِيَةِ ابنِ الأبرص",28,"ص",1,0],["مُت بِداءِ الصَمتِ خَيرٌ","لَكَ مِن داءِ الكَلامِ",29,"م",1,0],["مُتَبَرِّجُ المَعروفِ عِرّيضُ النَدى","حَصِرٌ بِلا مِنهُ فَمٌ وَلِسانُ",30,"ن",1,0],["مُتَبارِياتٍ في الأَعِنَّةِ قُطَّباً","يَحمِلنَ كُلَّ مُنازِلٍ قَمقامِ",31,"م",1,0],["مُتَبَصِّراً ذا فِطنَةٍ","تَنفي القُشورَ عَنِ اللُباب",32,"ب",1,0],["مُتَبَيِّناً بِالْحَقِّ كَيْفَ جَوَابُهُ","إِنْ كَانَ يَوْمَ مُهِمِّةٍ مَسْؤُولاَ",33,"ل",2,0],["مُتْبِعاً فِي الْعَلْيَاءِ كُلَّ قَدِيمٍ","بِجَدِيدٍ مِنْ فَضْلِكَ المَشْكُور",34,"ر",1,0],["مُتُّ بَينَ شافِعِها","حَسرَةً وَموتِرِها",35,"ر",3,0],["مُتَبَعِّثَاتٌ بالنُّباحِ وَرَاءَنَا،","حتّى طرَحْنا زَادَنا، فَرَضِينَا",36,"ن",2,0],["مُتَبَسِّمٌ عَنْ لُؤْلُؤٍ مُتَلأْلِىءٍ","ونَوَاعِمٍ مِثلِ الْبُدُورِ حِسَانِ",37,"ن",1,0],["متبتل ببني البتول سما وقد","مدت له يد جده المختار",38,"ر",1,0],["مُتَبَذِّلاً تَبدو مَحاسِنُهُ","يَضَعُ الهِناءَ مَواضِعَ النُقبِ",39,"ب",1,0],["متباريات بالنَّجاء كأنما","وضَعت رهونا سُوقُها والأذرعُ",40,"ع",1,0],["مُتَبايِنُ الأَوصافِ أَمّا عِرضُهُ","فَحِمىً وَأَمّا مالُهُ فَنِهابُ",41,"ب",1,0],["متبسِّمٌ عنِ لؤلؤٍ رَطبٍ حكى","بَرَداً تساقَطَ منْ عُقُودِ سَماءِ",42,"ا",2,0],["مُتَبَيِّناً لِلدينِ غَيرَ مُقَلِّدٍ","يَسمو بِهِمَّتِهِ إِلى الرضوانِ",43,"ن",1,0],["مُتَبَتِّلًا واريْتُ وَقْدَتَهُ","قِدّيسُهُ مُتوهّجًا سَطَعا",44,"ع",2,0],["متبرّم بنهارهِ","قلق إذا ما الليلُ خيّم",45,"م",1,0],["مُتَّ بالشعر يا غلام فأضحى","فوق خديك منكرٌ ونكيرُ",46,"ر",1,1],["مُتَبَرجِّات ناعمات أكملت","خَفَر الذليل ونخوة المتكبر",47,"ر",1,0],["مُتَبلّج بادي الوَضاءَةِ باهِر","في الحُسنِ دانَ لِنورِهِ القَمَرانِ",48,"ن",1,0],["مُتَبَسِّمٌ يَومَ النَدى لِعُفاتِهِ","كَرَماً وَفي وَجهِ الزَمانِ تَجَهُّمُ",49,"م",1,0],["مُتَبَسِّمٌ كَرَماً إِذا","كَلَحَ الزَمانُ وَقَطَّبا",50,"ب",2,0],["متبلج نم الظلام بسره","لما ألم مروعا مجفالا",51,"ل",2,0],["مُتَبَوِّئٌ للْمَجْدِ أَشْمَخَ ذِرْوَةٍ","ولَهُ بِأَعْلاهَا لِواءٌ يُرْفَعُ",52,"ع",1,0],["مُتَبسّماً ورِماحُهُ تَبْكِي دَماً","في اليَوْمِ تُحْجَبُ شَمْسُه بِكُعوبِهِ",53,"ب",2,0],["مُتَبَسِّما يُزْجِي سَحائِبَ عِثْيَرٍ","تَنْهلّ منهُنّ ال