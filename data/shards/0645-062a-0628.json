م","https://www.aldiwan.net/poem16060.html","الكامل"],[462,"يا لامحا شبح المسف الأكحل","https://www.aldiwan.net/poem16270.html","الكامل"],[465,"لهفي على غصن النقا المتمايل","https://www.aldiwan.net/poem3200.html","عموديه"],[465,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"],[465,"قف بالخليج فإنه","https://www.aldiwan.net/poem3518.html","عموديه"],[465,"زحف الصباح وهذه راياته","https://www.aldiwan.net/poem3624.html","عموديه"],[478,"دمن حبسن على الغرام وأربع","https://www.aldiwan.net/poem15253.html","الكامل"],[501,"كم عاشق متلذذ","https://www.aldiwan.net/poem38021.html","مجزوء الكامل"],[501,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[506,"الأجير","https://www.aldiwan.net/poem56765.html","البسيط"],[545,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[559,"ذال الذهاب مقيد طلق الشذا","https://www.aldiwan.net/poem34560.html","الكامل"],[568,"متبرم بغنائه","https://www.aldiwan.net/poem69787.html","مجزوء الكامل"],[576,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[576,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"],[587,"من خد أهيف كالقضيب المايس","https://www.aldiwan.net/poem17562.html","الكامل"]],"verses":[["مُتَبَلِّجٌ كَرَماً إِذا سُئِلَ الجَدا","مَطَرَ النَدى أَمَماً وَلَم يَتَغَيَّمِ",0,"م",1,0],["مُتَبَقِّلاتٌ بِاللَديدِ وَرامَةٍ","بَينَ القَنا المَنزوعِ وَالمُتَلَهذِمِ",0,"م",1,0],["مُتَبارِياتٍ في الأَعِنَّةِ قُطَّباً","حَتّى تُفيءَ عَشِيَّةً أَنفالَها",1,"ل",3,0],["مُتَبَسِّمٌ وَعَلى مَعارِفِ وَجهِهِ","آياتُ ما يَلقى مِنَ الأَوصابِ",2,"ب",1,0],["مُتَبَسِّمٌ في كُلِّ يَومٍ عابِسٍ","مُتَوَضِّحٌ في كُلِّ خَطبٍ أَسفَعِ",3,"ع",1,0],["مُتَبَرِّعٌ بِالجودِ قَبلَ سُؤالِهُ","وَالجودُ جودُ الباديءِ المُتَبَرِّعِ",3,"ع",1,0],["مُتَبَوِّئونَ جَنابَ عَيشٍ مونِقٍ","مُتَفَيِّئونَ ظِلالَ أَمنٍ شائِعِ",4,"ع",1,0],["مُتَبَتِّلٍ لِلْعِلْمِ مَشْغُولٍ بِهِ","عَنْ رَشْفِ كَاسَاتٍ وَعِشْقِ غَوَانِ",5,"ن",1,0],["مُتَبَسِّماً وَمِنَ النَّذِيرِ تَبَسُّمٌ","يَبْدُو قُبَيْلَ تَوَقُّدِ النِّيرَانِ",6,"ن",1,0],["مُتَبَسِّمٌ واليوم أكلحُ عابسٌ","والحربُ تدعو بالكُماةَ نَزَالِ",7,"ل",1,0],["مُتَبَتِّلٍ عَن كُلِّ فاحِشَةٍ","سَكَنَ الصَوامِعَ رَهبَةَ الوِزرِ",8,"ر",1,0],["مُتَبَسِّماً عن شبه مَبْ","سمِك البَرُود إذا ابتسمتا",9,"ت",2,0],["متبادرين قصيفه بوميضه","متناذرين حريقه بقصيفه",10,"ف",2,0],["متبادراتِ دليفِه بزئيره","متناذرات وثوبه بدليفه",10,"ف",2,0],["مُتبلِّجِ الضَّحواتِ مُشرِقِها","متأرِّجِ الأسحار والعَتَمِ",11,"م",1,0],["مُتَبَسِّماً لِعُفاتِهِ عَن واضِحٍ","تَغشى لَوامِعُهُ البُروقَ اللُمَّعا",12,"ع",2,0],["متبرجٌ للوفدِ همَّتُهُ","بينَ الوفُودِ وبينَهُ حُجْبُ",13,"ب",1,0],["مُتبِعٌ كُلَّ مَضيقٍ فَرجَةً","مُمسِكٌ مِن كُلِّ نَفسٍ بِرَمَق",14,"ق",1,0],["مُتَبَيِّنٌ لِلحَقِّ قَبلَ وُقوعِهِ","هَضّامُ جانِبِ مالِهِ ظَلّامُهُ",15,"م",2,0],["مُتَبَسِّمٌ عَن لُؤلُؤٍ مُتَلَألِئٍ","وَنَواعِمٍ مِثلَ البُدورِ حِسانِ",16,"ن",1,0],["مُتَبَذِّياً ذَرِبَ اللِسانِ مُفَوَّهاً","مُتَمَثِّلاً بِغَوابِرِ الأَشعارِ",17,"ر",1,0],["مُتَبَرقِعي لُؤمٍ كَأَنَّ وُجوهَهُم","طُلِيَت حَواجِبُها عَنِيَّةَ قارِ",18,"ر",1,0],["مُتَبَسِّمٌ يَنْهَلُّ في استهلالِه","ماءُ الحياةِ فإن تَلَهَّبَ أصعَقا",19,"ق",2,0],["مُتَبرِّعٌ بنَوالِه جارٍ على","كَرَمِ الطِّباعِ إذا اللَّئيمُ تكلَّفا",20,"ف",2,0],["متبسِّمٌ قبلَ النهارِ كأنما","زَرًّ النهارُ عليه ثَوبَ ضَحائِه",21,"ا",3,0],["مُتَبَرِّئًا مِني إِذا نُضِدَ الثَرى","فَوقي طَوى كَشحاً عَلى هِجراني",22,"ن",2,0],["متبدلينَ موائداً وأحبةً","ما خابَ مِن حبٍّ فآخرُ يفلحُ",23,"ح",1,0],["مُتَبَذِّلٌ في القَومِ وَهوَ مُبَجَّلٌ","مُتَواضِعٌ في الحَيِّ وَهوَ مُعَظَّمُ",24,"م",1,0],["مُتَبَهِّمٌ في غَرسِهِ أَنصارُهُ","عِندَ النِزالِ كَأَنَّهُم أَنصارُ",25,"ر",1,0],["مُتَبَسِّمٌ في هِزَّةٍ فَكَأَنَّهُ","غُصنٌ تَفَتَّقَ نَورُهُ مَيّادُ",26,"د",1,0],["متبلِّج الآثارِ ما ركبَ الهَوى","يوماً ولا خلطَ الهُدى بِضَلالِ",27,"ل",1,0],["مُتبلِّجاتٌ قبل في أزدِيِّهَا","ما قيل في أسْدِيَةِ ابنِ الأبرص",28,"ص",1,0],["مُت بِداءِ الصَمتِ خَيرٌ","لَكَ مِن داءِ الكَلامِ",29,"م",1,0],["مُتَبَرِّجُ المَعروفِ عِرّيضُ النَدى","حَصِرٌ بِلا مِنهُ فَمٌ وَلِسانُ",30,"ن",1,0],["مُتَبارِياتٍ في الأَعِنَّةِ قُطَّباً","يَحمِلنَ كُلَّ مُنازِلٍ قَمقامِ",31,"م",1,0],["مُتَبَصِّراً ذا فِطنَةٍ","تَنفي القُشورَ عَنِ اللُباب",32,"ب",1,0],["مُتَبَيِّناً بِالْحَقِّ كَيْفَ جَوَابُهُ","إِنْ كَانَ يَوْمَ مُهِمِّةٍ مَسْؤُولاَ",33,"ل",2,0],["مُتْبِعاً فِي الْعَلْيَاءِ كُلَّ قَدِيمٍ","بِجَدِيدٍ مِنْ فَضْلِكَ المَشْكُور",34,"ر",1,0],["مُتُّ بَينَ شافِعِها","حَسرَةً وَموتِرِها",35,"ر",3,0],["مُتَبَعِّثَاتٌ بالنُّباحِ وَرَاءَنَا،","حتّى طرَحْنا زَادَنا، فَرَضِينَا",36,"ن",2,0],["مُتَبَسِّمٌ عَنْ لُؤْلُؤٍ مُتَلأْلِىءٍ","ونَوَاعِمٍ مِثلِ الْبُدُورِ حِسَانِ",37,"ن",1,0],["متبتل ببني البتول سما وقد","مدت له يد جده المختار",38,"ر",1,0],["مُتَبَذِّلاً تَبدو مَحاسِنُهُ","يَضَعُ الهِناءَ مَواضِعَ النُقبِ",39,"ب",1,0],["متباريات بالنَّجاء كأنما","وضَعت رهونا سُوقُها والأذرعُ",40,"ع",1,0],["مُتَبايِنُ الأَوصافِ أَمّا عِرضُهُ","فَحِمىً وَأَمّا مالُهُ فَنِهابُ",41,"ب",1,0],["متبسِّمٌ عنِ لؤلؤٍ رَطبٍ حكى","بَرَداً تساقَطَ منْ عُقُودِ سَماءِ",42,"ا",2,0],["مُتَبَيِّناً لِلدينِ غَيرَ مُقَلِّدٍ","يَسمو بِهِمَّتِهِ إِلى الرضوانِ",43,"ن",1,0],["مُتَبَتِّلًا واريْتُ وَقْدَتَهُ","قِدّيسُهُ مُتوهّجًا سَطَعا",44,"ع",2,0],["متبرّم بنهارهِ","قلق إذا ما الليلُ خيّم",45,"م",1,0],["مُتَّ بالشعر يا غلام فأضحى","فوق خديك منكرٌ ونكيرُ",46,"ر",1,1],["مُتَبَرجِّات ناعمات أكملت","خَفَر الذليل ونخوة المتكبر",47,"ر",1,0],["مُتَبلّج بادي الوَضاءَةِ باهِر","في الحُسنِ دانَ لِنورِهِ القَمَرانِ",48,"ن",1,0],["مُتَبَسِّمٌ يَومَ النَدى لِعُفاتِهِ","كَرَماً وَفي وَجهِ الزَمانِ تَجَهُّمُ",49,"م",1,0],["مُتَبَسِّمٌ كَرَماً إِذا","كَلَحَ الزَمانُ وَقَطَّبا",50,"ب",2,0],["متبلج نم الظلام بسره","لما ألم مروعا مجفالا",51,"ل",2,0],["مُتَبَوِّئٌ للْمَجْدِ أَشْمَخَ ذِرْوَةٍ","ولَهُ بِأَعْلاهَا لِواءٌ يُرْفَعُ",52,"ع",1,0],["مُتَبسّماً ورِماحُهُ تَبْكِي دَماً","في اليَوْمِ تُحْجَبُ شَمْسُه بِكُعوبِهِ",53,"ب",2,0],["مُتَبَسِّما يُزْجِي سَحائِبَ عِثْيَرٍ","تَنْهلّ منهُنّ الدّماء سَواكِبا",54,"ب",2,0],["مُتَبَعِّجُ التَيّارِ ذو حَدَبٍ","مُغرَورِبٍ تَيّارُهُ يَعلو",55,"ل",2,0],["مُتبرِّجاً للإحتفالِ كغادةٍ","وُعدت بأنّ حبيبها سيزورُ",56,"ر",1,0],["متبوأ الدنيا ومنتجع المنى","والغيث حيث العارض المتهلل",57,"ل",1,0],["مُتَّبِعاً مَنْ قَالَ مِن قَبْلِهِ","وإِنَّما اللَّيْلُ نُهارُ الأَديبْ",58,"ب",1,0],["مُتَبسِّمٌ في الخَطْبِ تَحسَبُ أَنّه","من حُسْنِه مُتلثِّمٌ بنِعاله",59,"ل",2,0],["مُتَبَيِّناً بَيتي كَحَرفِ مُشكِلٍ","أَعيا بِما أَعطى يَدَ البُنيانِ",60,"ن",1,0],["مُتَبَجبِجٌ بِالمَسِّ أَو","مُستَأذَنٌ بِالنَقرِ مُرهق",61,"ق",1,0],["متبرِّئاً من كل فعلٍ موبقٍ","يرضَى بموتٍ قبل إثمٍ موثِم",62,"م",1,0],["مُتَبَسِّمٌ عَن ذي غُروبٍ واضحٍ","يُعزَى إليه اللؤْلُؤُ الْمنظومُ",63,"م",1,0],["مُتْبِعُ الحُسنى بحسنى مثلها","يَصِلُ الدهر بها والدَّهر قال",64,"ل",1,0],["متبسمٌ للوافدين لبابه","والغيث إنْ قَصَد الهُطولَ تبَسَّما",65,"م",2,0],["مُتَبَاهِيَيْنِ تَلَوُّناً بِتَلَوُّنٍ","متبارِيَيْنِ تنفُّساً بتنفسِ",66,"س",1,0],["مت بالهنا فبنوك نعم خلائفا","بك أسمكوا بيت العلا مرفوعا",67,"ع",2,0],["مت بالهنا فحسين والفتى حسن","والندب مسعود حسبي مذ بقوا نجلي",68,"ل",2,0],["مت بالحبّ شهيدا فعسى","في جنان الخلد أن يقضى دخولي",69,"ل",2,0],["مُتبختراً متشدقاً بجميعِ ما","جَعل السلامِ خُرافَةً للنابهِ",70,"ب",2,0],["متبسم السنوات ضا","في القعب فيها مُتأقُهْ",71,"ق",2,0],["مُتبسمٌ قبل الضِّرابِ وإنه","من بعد فتكته غزيرُ الأدمُعِ",72,"ع",1,0],["مُتَبعِّقٌ كَندى بنانكَ ساكِبٌ","باقٍ كخيرك في الورى لا يُنْجِمُ",73,"م",1,0],["مُتبعِّقاً يَذَرُ الحُزونَ قَرارةً","ويذيبُ وابلُه صليبَ الجَنْدَل",74,"ل",1,0],["متبرعٌ أشكو إليه خصاصتي","شكوى الجدوب إلى الغمام الهاطل",75,"ل",1,0],["متبالهٌ في الحب لو حاققته","ما أنكر الدعوى عليه ولا اعترفْ",76,"ف",1,0],["متباريات سفنهُ","خفضاً براكبها ورفعاً",77,"ع",2,0],["متبلّجٌ والليلُ تحت لوائهِ","والصبحُ ما نشرت عليه ملاته",78,"ت",2,0],["متبلَّداً متلدَّداً لا حزنُهُ","يُغني ولا فرطُ التلهُّفِ ينفعُ",79,"ع",1,0],["مُتَبتِّلاً يَتْلو على ال","مَعنى فَسُبحانَ الذِّي",80,"ذ",2,0],["مُتباعِداً عن أَهلِهِ مُتَحجِّباً","عنهُمْ بمِرْطِ الطَّوْرِ والعاداتِ",81,"ت",1,0],["متّبعٌ أمره في كلّ مهزلةٍ","ويلتقي ساعةَ ميلادهِ عُمَدُ",82,"د",1,0],["مُتَبَتِّلاً للنفْسِ منطلقاً بهِا","يجلو صبابةَ عاشقٍ مُتَأَلِّهِ",83,"ل",2,0],["متبذل فكأنه متمنع","وبه الحجا منه لديه تعوذا",84,"ذ",2,0],["مُتَبَرِّمٌ بغِنائِهِ","مستعذِبٌ لعَذَابِهِ",85,"ب",2,1],["متبرِّجٌ في وَجْهِهِ الخَفَرُ","متَحيِّرٌ في طَرْفِه الحَوَرُ",86,"ر",1,0],["متَبتِّلٌ لِله أَدّ","ى كُلَّ شَيءٍ فيه آدَه",87,"د",2,0],["مُتَباعدٍ بِدَلالِهِ مُتقرِّبٍ","مُسْتَوْحِشٍ بِنفارِهِ مُسْتَأْنِسِ",88,"س",1,0]]}