{"poems":[[72,"فديت من قد أنجزت وعدها","https://www.aldiwan.net/poem42943.html","السريع"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[89,"كل صعب سوى المذلة سهل","https://www.aldiwan.net/poem8345.html","الخفيف"],[71,"إن ملت لي الوشاة عينا عينا","https://www.aldiwan.net/poem28000.html","الدوبيت"],[83,"ظبي من العرب سبا مهجتي","https://www.aldiwan.net/poem61304.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55169","السريع"],[309,"إن كان هذا الذي أكابده","https://www.aldiwan.net/poem16752.html","المنسرح"],[310,"عام سبع صفو لسعد الوزير","https://www.aldiwan.net/poem56544.html","الخفيف"],[422,"إن مليك العصر من قد علا","https://www.aldiwan.net/poem53898.html","السريع"],[445,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[469,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48512","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48504","الرمل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105457","الكامل"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126564","المنسرح"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79849","الرجز"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69361","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109453","الرجز"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46746","السريع"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87313","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87331","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108333",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92454","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91910","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91611","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83119","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72494","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120320","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139702",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139522",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52183","الرمل"],[4858,"طلع الفجرُ أخيراً","https://www.poetsgate.com/ViewPoem.aspx?id=138072",""],[3271,"دمعة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=104119",""],[5186,"أأيهذا الأمير سمعا رعاك","https://www.poetsgate.com/ViewPoem.aspx?id=156488",""],[5187,"قلب بين نارين","https://www.poetsgate.com/ViewPoem.aspx?id=29698",""],[5216,"شَهرَزاد","https://www.poetsgate.com/ViewPoem.aspx?id=187646",""],[5431,"قاصرٌ من ذويه ...","https://www.poetsgate.com/ViewPoem.aspx?id=210853",""]],"verses":[["إِنَّ مَلوكاً مَلَكَت مُهجَتي","لا تَدعُني إِلّا بِيا عَبدَها",0,"د",3,0],["إِن مَلَكتَ النُفوسَ فَاِبغِ رِضاها","فَلَها ثَورَةٌ وَفيها مَضاءُ",1,"ا",2,0],["إِنَّ مُلْكَاً فِيهِ فُلانٌ وَزِيراً","لَمُبَاح لِلْخَائِنِينَ وَبِلُّ",2,"ل",1,0],["إنْ ملَّتْ لي الوشاةُ عيناً عينا","منْ مثلكَ نحوَهم حرْنا وحرْنا",3,"ن",2,1],["إن مِلت يَا قَلبُ إلَى غَيرِهِ","مَا أنت إلاَّ فِي ضَلاَلٍ مُبِين",4,"ن",1,0],["أُنمُلَهُ مِنْ فِضَّةٍ فُجِّرَتْ","عَنْ بَرْقِ نَوْءٍ فَجَرَتْ جَدْوَلاَ",5,"ل",2,0],["إِن مِلتَ يَوماً بِحُكمِ طارِقَةٍ","فَالآنَ مِنها إِلَيكَ أَعتَذِرُ",6,"ر",1,0],["إنّ ملكاً وزيرهُ لا يجارى","لحريّ الهنا بملكٍ كبيرِ",7,"ر",1,0],["إنَّ مليكَ العصر من قد عَلا","على ملوكِ الأرض طُرًّا وَفاقْ",8,"ق",1,1],["أَن مَلَّكتْ مَنْ فِي يديهِ مَماتُها","ونأت عَلَى مَن فِي يَديهِ خُلودُها",9,"د",3,0],["أنملهُ بالنوال حافلةٌ","تُخجلُ صوبَ السحائبِ الُهطل",10,"ل",1,0],["إن ملكاً أحرزته لمنيف","مكَّنته الآباء والأجداد",11,"د",1,0],["إن ملأت الشرق شكوى ونواح","فمن الشرق سقامي والجراح",12,"ح",1,0],["إن ملت عن عهد التصابي والصبا","فعلى هواك لقد طيوت سرائري",13,"ر",2,0],["إن مل لفظ مكرر فمنى","نفسي في لفظةٍ تكررها",14,"ر",3,0],["أنملاً أبدى بها الحسنُ وشاما","وكأَن خدَّيه منها أُشرِبا",15,"ب",2,0],["أَنملُها العشرُ جميعاً حُلَمٌ","أَرضعت الدنيا بها أَولادَها",16,"د",3,0],["إِن مَلَكنا فَنَحنُ مِن نَبعة المُل","كِ وَمِنهُ لُحُومُنا وَالجُلودُ",17,"د",1,0],["ان ملئت بها بطون القصع","تشرقها الأبصار قبل المبلع",18,"ع",1,0],["إِنَّ مِلاكَ الوَصلِ أَن تَفعَلي","ما قُلتِ إِنَّ المُوفيَ الفاعِلُ",19,"ل",1,0],["إِن مِلتَ عَنهُم مَشرِقاً أَو مَغربَا","يزيد زامين على ذا فاحسبَا",20,"ب",2,0],["إن مِلتَ عَنهَا مَغرباً ومَشرِقَا","فَرَاسَ جُلنَارَ تَرَى مُفتَرِقَا",21,"ق",2,0],["إن مِلتَ لليَمينِ رَقَّ المَاء","والغُزرُ صَوبَ البرِّ لا مِرَاء",22,"ا",2,0],["إن مِلتَ للعَقربِ زادَ المَاءُ","أو مِلتَ للسُّهَيلِ يا خَاءُ",22,"ا",2,0],["ان مللنا من ذا المصاب لعمري","ايُّ خطبٍ منه احق وأحرى",23,"ر",2,0],["إن ملت للشنعاء مال معاضدي","وإذا شددت فسمهري وباتري",24,"ر",2,0],["إِن ملت عنها استقامت أَو سهرتُ تَنَمْ","أَو استقمتُ تمل وَتنام في سهري",25,"ر",2,0],["إِن ملت ملن غصونها","من سُجَّدٍ أَو رُكَّع",26,"ع",1,0],["إِن مَلِلتُ الصِياحَ قالوا فَقَدِّر","فنَّهُ قُلتُ قَد مَلِلتُ فُنونَه",27,"ن",2,0],["أنمل من يغدو لهنَّ راقما","ثلاثهنَّ تقضي حكما لازما",28,"م",2,0],["ان مليك العصر سلطاننا","عبد العزيز الشهم غوث العباد",29,"د",1,1],["أنمله العشر إذا ما همت","تهمى البحار السبع من اصبع",30,"ع",1,0],["إن مليكٌ قد سرى في لجب","سار من عزمته في لجب",31,"ب",1,0],["إن ملكْتَ القوم فاملِكْ قلبهم","عَبَثاً تملِكُ حُبَّ الناس قَسْرا",32,"ر",2,0],["إنّ ملياراتِكم حقٌّ لنا","قد غُصبناها بظلمٍ وخيانه",33,"ن",2,0],["أنملات الطبيب راحت تواسي","كَ من الداء وادعاتٍ غرائر",34,"ر",1,0],["إن ملك الثرى لمن دان بالحب","كلا شيء عند ملك الضمير",35,"ر",1,0],["إنْ ملتُ نحو الشَّمسِ ألثُمها","تُغري شِفاهي طلعةُ القَمرِ",36,"ر",1,0],["إن ملأتِ الليلَ شدواً","بالأغاني أسْمِعينا",37,"ن",2,0],["إنْ مللتِ انزياحه ذات هطلٍ","في بوادٍ قريبة فانفخيه",38,"ي",2,0]]}