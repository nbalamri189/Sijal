يدنا بناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=152242",""],[243,"مرئية الآلهة","https://www.poetsgate.com/ViewPoem.aspx?id=50562",""],[6152,"الحِلم سيد الأخلاق","https://www.poetsgate.com/ViewPoem.aspx?id=203590",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6171,"لا فِتَةٌ عَلى بَوابةِ العَام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84672&r=&rc=2",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[1583,"شعاع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73067&r=&rc=24",""],[463,"تعالينَ نعالجْ نف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60213&r=&rc=269",""],[5126,"فلسطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87828&r=&rc=43",""],[572,"أَلاَ أَبْلِغْ أَبَا بَكْرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9291&r=&rc=148",""]],"verses":[["تَرى فيهِ القَريبَينِ","مِنَ البَغضا قَرينَينِ",0,"ن",1,0],["تَرَى فوقَها الطّيْفورَ أسْتاذَ حَلْقَةٍ","مَعاني حُروفِ الحَلْقِ منْ بعْضِ ما يُبْدي",1,"د",2,0],["تُرى فَمَولايَ الحَكي","مُ ما دَرى بِما جَرى",2,"ر",2,0],["تَرَى فِي رَوْضِهَا مَا تشْتهِيهِ","مُنَاكَ مِنَ البَوَاسِقِ وَالنُّجُومِ",3,"م",1,0],["تَرَى فِيهِ ذَكَاءً عَبْقَرِيّاً","وَدَِّقةَ فِطْنَةٍ وَصَفَاءَ خِيمِ",3,"م",1,0],["تَرى فِيهِ أَطرافَ الصَحارى كَأَنَّها","خَياشيمُ أَعلامٍ تَطولُ وَتَقصُرُ",4,"ر",1,0],["ترى في فَروق اليوم قرّاء صحفها","فريقين من ذي حجةٍ ومعاندٍ",5,"د",1,0],["تَرى فَوقَ أَثناءِ الزَرابِيِّ ساقِطاً","نِعالاً وَقَسّوباً وَرَيطاً مُعَضَّدا",6,"د",2,0],["ترى فوقها منه غيابة خضرةٍ","فما مسّها من رفرف الجو أخضر",7,"ر",1,0],["ترى في ذراهم غنى المجتدي","وعز الذليل وأمنَ الفزع",8,"ع",1,0],["تَرى فيها اللَوامِعَ مُبرِقاتٍ","يَكَدنَ يَنِكنَ بِالحَدَقِ الرِجالا",9,"ل",2,0],["تَرى فيهِ أَثلامَ الأَصيصِ كَأَنَّهُ","إِذا بالَ فيهِ القَومُ جَفرٌ مُعَوَّرُ",10,"ر",1,0],["تَرى في الحُبِّ رَأياً غَيرَ رَأيي","وَتَسلُكُ فيهِ فَنّاً غَيرَ فَنّي",11,"ن",2,0],["ترى في منزل ميا","وفي آخر غيلانا",12,"ن",2,0],["تَرى في نَواحيها الفِراخَ كَأَنَّما","جَثَمنَ حَوالي أُمِّ أَربَعَةٍ طُحلِ",13,"ل",1,0],["ترى فوقه للطير جيشا مسالما","إذا الجيش بالخطي كر مقاتلا",14,"ل",2,0],["ترى فيه عينُك غَوْلَ الحِمامِ","يهمّ بِأَكلِ يدِ الصيقلِ",15,"ل",1,0],["تَرى فَرقَدَ اللَيلِ السُرى مِنهُ ثالِثاً","وَتَرعى بِهِ بَدَر الدُجُنَّةِ ثانِيا",16,"ي",2,0],["تَرى فيهِ فَيضَ النيلِ وَالبَدرَ كامِلاً","إِذا لاحَ مَرآهُ وَجادَت أَنامِلُه",17,"ل",2,0],["تَرى فيهِ أَخبارَ القُرونِ الَتي مَضَت","وَأَخبارَ غَيبٍ في القيامَةِ تَنجُدُ",18,"د",1,0],["تَرى فَوقَ مِتنَيهِ الفِرِندَ كَأَنَّما","تَنَفَّسَ فيهِ القَينُ وَهُوَ ثَقيلُ",19,"ل",1,0],["تَرى فَوقَ مَتنَيهِ الفِرِندَ كَأَنَّهُ","بَقِيَّةُ غَيمٍ رَقَّ دونَ سَماءِ",20,"ا",2,0],["تَرى فَخِذَ الأَلواحِ فيها كَأَنَّها","إِلى قَدَمٍ نيطَت تَضُجُّ إِلى الزَمرِ",21,"ر",1,0],["تَرى فيها الحَبابَ وَقَد تَدَلّى","كَمِثلِ الدُرِّ سُلَّ مِنَ النِظامِ",22,"م",1,0],["تَرَى فيه هذا الكَوْنَ صُورَةَ حاذِقٍ","أَحَاطَتْ بأسْرَارِ الحيَاةِ بَصَائِرهْ",23,"ر",2,0],["ترى فوق المنصة رب اصل","تسلق بالظواهر فاستطالا",24,"ل",2,0],["ترى في خباها كالعروس بخدرها","فلا قطع في ذاك المقام ولا وصلا",25,"ل",2,0],["تَرَى فيه أبكارَ المعانِي كأنَّهَا","قلائدُ عقيانٍ بأجيادِ خُرَّدِ",26,"د",1,0],["تَرَي في حَواشي الغُيومِ اصفِرارا","يُشابه وَجهي وما تلك نارا",27,"ر",2,0],["ترى في الثَّغرِ مِنها وَالمُحَيَّا","بَوارِقَ الابتِسامِ والتَّسامي",28,"ي",1,0],["ترى في السلم منه غيث جود","وفي يوم الكريهة ليث غاب",29,"ب",1,0],["ترى فيهِ نفسُ الفتى مثلما","ترى في المرآةِ وجوهَ البشرْ",30,"ر",1,0],["ترى في نواصيها من النصرِ سُورةً","وقد نَمَقَتها من معاركهِ السَّلْبُ",31,"ب",1,0],["تَرى في رَجعِ مِرفَقِها نُتوءاً","إِذا ما الآلُ خَفَّقَ لِاِرتِفاعِ",32,"ع",1,0],["ترى في وجهه البشرى تبدّت","وبالسرَّا يوافي وهو ماكر",33,"ر",1,0],["ترى فوق متنيه الفرند كأنه","قلائد در فوق لبة كاعب",34,"ب",1,0],["تُرى في سَقرِ المَثوى","وَإِبليسَ غَداً جارَك",35,"ك",1,0],["تَرى في قُرْبِهِ مِنْكَ ازْوِراراً","وَفِي إِعْراضِهِ عَنْكَ ابْتِساما",36,"م",2,0],["تَرى فَوقَ الرَهابِ لَها سُموطاً","مَعَ الياقوت فَصَّلَهُ الفَريدُ",37,"د",1,0],["ترى في الطائرات ذباب خصم","يطن وفي مدافعه شموعا",38,"ع",2,0],["تَرى في العَطايا كلَّ جَورٍ مُعدلاً","وبين الرعايا كلَّ عدلٍ مجوَّرا",39,"ر",2,0],["ترى فضلها من نوعها مثلما ترى","سواها إذا ما قسته بالطبيعة",40,"ه",1,0],["تَرى في وَجهِهِ نوراً وَبَشراً","عَلى ما فيهِ مِن كَرَم دَليل",41,"ل",1,0],["ترى فيها البراءة مبتغاه","ويعجبُ من بلاغتها البيانُ",42,"ن",1,0],["تَرى فيهِما نونَينِ عُطِّلَ واحِد","وَآخر مَعجوم بِنُقطَةِ خالِهِ",43,"ل",2,0],["تَرى في سرجِهِ لَيثاً وَغَيثاً","وعند الغَيثِ صاعِقَة تُلالي",44,"ل",2,0],["ترى فيهِ الأسابر بازدحامٍ","تكر على الحجال بلا تواني",45,"ن",2,0],["ترَى فيك الأمانيَّ ال","حسانُ ما تمنَّيْنا",46,"ن",2,0],["تُرى فَرتَنى كانَت بِما بَلَغَ ابنُها","مُصَدِّقَةً لَو قالَ ذَلِكَ قائِلُ",47,"ل",1,0],["ترى في السِّلْمِ منه حَيا الغواني","وفي هيَجانِه أسَدَ العرينِ",48,"ن",1,0],["ترى في لساني ما تشاءُ من التُّقى","ومِنْ حَسَناتٍ ثمّ فعلِيَ ضدُّها",49,"د",3,0],["تَرَى في وَجهِهِ سيماءَ مَجْدٍ","كعُنوانٍ يَبينُ بهِ الكِتابُ",50,"ب",1,0],["تُرَى فِي فَلَكِ الآدَا","بِ كالشَّمْسِ أَوِ البَدْرِ",51,"ر",1,0],["ترى فرْد لونٍ لونَه فإِذا جَرى","أَتاكَ مِنَ الجَرْي الغريبِ بأَلوان",52,"ن",1,0],["تَرَى في كُلِّ عُضوٍ بانَ مِنّي","لِعَقربِ صَدغِها حُمَةً ولَسعا",53,"ع",2,0],["تَرى في العَينِ أمثِلَةً مَجازا","وإن هي حُقّقَت كانت تُيوسا",54,"س",2,0],["ترى فيها وفي القَدحِ احمِرارا","كما استَوكَفتَ بالقَدَحِ الشَّجاجا",55,"ج",2,0],["ترى فاض ما ألقى من الهم والأسى","لبعدكم فاسودّ من صبغه الدهر",56,"ر",1,0],["ترى فيه لا ما ورد فوق وردةٍ","وفصا من الياقوت من فوق خاتم",57,"م",1,0],["ترى فردهم حينما وقفا","ملاكا على ملا أشرفا",58,"ف",2,1],["ترى في المياه الجبال تميد","كشمل العذارى انجلى يوم عيد",59,"د",1,1],["ترى فَرطَ حَولَيها الأثافيَّ كأنّها","لدى موقدِ النارِ الحمامُ الجواثِمُ",60,"م",1,0],["ترى فيه ليثاً فاتكا يوم حربه","وغيثا مغيثا في البر بالة والسلم",61,"م",1,0],["ترى فاهُ إذا أقبَ","ل مثل السّلقِ الجدب",62,"ب",1,0],["ترى فى سنا الماوىّ بالعصر والضحى","على غفلاتِ الزَّينِ والمتجملِ",63,"ل",1,0],["ترى فيه مفرد كل شطر مؤرخاً","وفيه الهوامل أرخت كالعواجمِ",64,"م",1,0],["تَرَى في خدِّها آثارَ عضّي","لغُصْنِ بَنَفْسَجٍ في جُلَّنارَهْ",65,"ر",2,0],["تَرى فيهِ حَدائِقَ ناضِراتٍ","تشبههن أَقْداحُ الغَواني",66,"ن",2,0],["تَرى في وَجْهِهِ وَجْهَ","كَ لِلرِّقَةِ مِنْ ميلِ",67,"ل",1,0],["تُرى فجعت مثلي خليلاً وصاحباً","وقرّة عينٍ كان يُرجى ويُرهب",68,"ب",1,0],["تَرى فَوقَها نَمَشاً لِلمِزاجِ","تَقارَبُ لا تَتَّصِلنَ اِتِّصالا",69,"ل",2,1],["ترى في سَنى وجهيهما من بشاشةٍ","مزيدَ بهاء حين يبتسمانِ",70,"ن",1,0],["ترى في يديه عارض الجود كلّما","أشارت إليه كفّ ظمآن جادَها",71,"د",3,0],["ترى فيه يوم السّلم حسن طلاقةٍ","ويبدي عبوسُ الوجه والنفعُ ثائر",72,"ر",1,0],["ترى في دارها الحمي ساكناً","وثاو ديار حقون جياد",73,"د",1,0],["ترى في رغاء البحر في جنباتها","فتى شيَّبت منه الحوادث قُنزُعا",74,"ع",2,0],["ترى فيه مخايل خندفيٍّ","يسيما الحق يزدان اتساما",75,"م",2,0],["ترى في العدى نبهاً ترائك لم تجد","سبيلاً إلى استخلاصه من يد النهب",76,"ب",1,0],["تَرى فيها الجِيادَ مُسَوَّماتٍ","مَعَ الأَبطالِ يَعلُكنَ الشَكيما",77,"م",2,0],["ترى فيه سيما العبد للضيف وهو في","ندى كفه بالجود يستعبد الحرا",78,"ر",2,0],["ترى فيك منها نورها متلألئاً","وما بك منها في الهجير لهيبها",79,"ب",3,0],["تَرى في المَعالي عِندَه ما يزينها","وَتبصرُ فيها عِندَ قَوم فَضائحا",80,"ح",2,1],["ترى فيك البداءة كيف كانت","قديماً والفناء متى يكون",81,"ن",1,0],["ترى فخذيها يحملان خزانةً","إذا فتحتها إصبعاً ملأت وطبا",82,"ب",2,0],["تَرى فيها إِذا ما بَيَّتَتها","سَواري الزَوجِ وَالتثمَ الرُّضابا",83,"ب",2,0],["تَرى في هَواكُم أَن تَعيشَ ذَليلَةً","وَلَيسَت تَذِلُّ النَفسُ إِلّا لِمَن تَهوى",84,"و",2,0],["تَرى فُصْلانَهُم في الوِرْدِ هُزلى","وَتسمنُ في المَقاري وَالحِبالِ",85,"ل",1,0],["ترى فمه كنادي القوم وسعاً","بوجه ليس في الخيرات ناد",86,"د",1,0],["ترى فلس هذا قصد وجه رفيقه","على حرف حوضٍ وهم بالنتن ملآن",87,"ن",1,0],["ترى فيهم عباسَهم ذا طلاقةٍ","لدى السلم لكن لا يُطاق نزاله",88,"ل",2,0],["تَرى فعلَه يحدو طليعةَ قولِهِ","وكم فيهمُ من قائِلٍ غير فاعِلِ",89,"ل",1,0],["ترى في وجهه لمعات بشر","اذا سخطت على الخلق السنون",90,"ن",1,0],["ترى فيها الغواني سافرات","ولكن قد لبسن الاحتشاما",91,"م",2,0],["ترى فردهم في الطريق هزيرا","وفتخاء ينفر عند المدير",92,"ر",1,0],["ترى في ذراه لسان المنى","طويلا وباع الليالي قصيرا",93,"ر",2,0],["تَرى فَلكاً فيهِ الكواكبُ أشرقت","وهلَ فلكٌ يوماً تضمَّنهُ مرطُ",94,"ط",1,0],["تَرى فُرسانَهُم يُردو","نَ إِرداءً إِذا لَغَبوا",95,"ب",3,0],["ترى فيا القبة الزرقا أموراً","من الإغراب قد لبست بجادا",96,"د",2,0],["ترى فيه اللّبيب جريح قلب","سقتْه عواديَ الأيام صابا",97,"ب",2,0],["ترى فيه رفعَ الطرف خفضا كأنَمَا","لِحَاظُ الرجَالِ رِيبَةٌ يُستَرَابُهَا",98,"ب",3,0],["ترى في صديق الأمس معول هادم","وقد كان يوما للمآثر بانيا",99,"ن",3,0],["تُرَى فِى الْبُعْدِ يَذْكُرُنِى","وَتَغْزُو قَلْبَهُ نَارِى ؟",100,"ر",2,0],["ترى في الناس أجناسٍ شحيحهْ","اتخيّل لك غديرٍ من سرابي",101,"ب",2,0],["ترى في كلِّ أفقٍ جيشَ غدرٍ","وقدْ راموا بهِ واللهِ غدرا",102,"ر",2,0],["ترى في سنة الهادي مناراً","لدرب ليس يسكنه ارتياب",103,"ب",1,0],["ترى في جهدها العاتي بناءً","ففي اللهو المباح لها اجتناءُ",104,"ا",2,0],["ترى فحم إذ يلقاه يلقاه راجفا","وفولاذ من تلماح عينيه مائع",105,"ع",1,0],["ترى في طبعه الدنيا هدوءً","ولا أحد به ذرعا يضيق",106,"ق",1,0],["تَرى فَقدهم وَالوَجد وَالضَيم وَالبَلا","دَعاني عَليل وَعلتي ما دوا لَها",107,"ل",3,0],["تَرَى فَيَه أنفاسَ الوجودِ وجودها","وتَبقى به في عالمِ الطهرِ تَظهرُ",108,"ر",1,0],["ترى في كل ناحية إلها","عديداً من عديد من عديد",109,"د",1,0],["تُرى فاءَ الصباح إلى بلادي ،","أَليس على وجوهكمُ تجلَّى ؟",110,"ل",2,0],["ترى فيك أمانيَّ ال","حسانُ ما تمنَّينا",111,"ن",2,0],["ترى في بريق التبْر أبلغ حجةٍ","فما بالها؟ أفنى الإلهُ حياءَها",112,"ا",3,0],["تُرى فِي فَلَكِ الآدا","بِ كالشَّمْسِ وكالبَدْرِ",113,"ر",1,0]]}