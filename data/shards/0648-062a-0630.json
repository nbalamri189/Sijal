وحي المصلى","https://www.aldiwan.net/poem15265.html","الخفيف"],[479,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[495,"وشاكية تكذب تئن ولا تتعب","https://www.aldiwan.net/poem9771.html","مجزوء المتقارب"],[500,"كيف لا أندب الطلول غراما","https://www.aldiwan.net/poem37782.html","الخفيف"],[500,"خذوني إلى أرض المدينة إنني","https://www.aldiwan.net/poem38043.html","الطويل"],[506,"أيها المستطيل بالبغي اقصر","https://www.aldiwan.net/poem2424.html","الخفيف"],[509,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[515,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[515,"محلك لا يسام ولا يسامى","https://www.aldiwan.net/poem12260.html","الوافر"],[551,"بربك أيها البرق اليماني","https://www.aldiwan.net/poem47166.html","الوافر"],[551,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[558,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[558,"لو تجلى عن ناظريك الغبار","https://www.aldiwan.net/poem34555.html","الخفيف"],[558,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[562,"ورد الكتاب فضاع طيب نشره","https://www.aldiwan.net/poem52956.html","الكامل"]],"verses":[["وَتَذَكَّر عَنّي مُناخَ مَطِيّي","بِأَعالي مِنىً وَمَرسى خِبائي",0,"ي",1,0],["وَتُذكيها عَلى خَفَرٍ","بِأَعوادٍ مِنَ الرَّندِ",1,"د",1,0],["وَتَذودُ عَن قَلبي سِواكِ كَما أَبَى","دَمعي جَوازَ النَّومِ بِالآماقِ",2,"ق",1,0],["وتَذْخَرُ سَلْمى ضَريبَ اللِّقاحِ","لهُ وولائِدُها تَسْغَبُ",3,"ب",1,0],["وتُذْري شَآبيبَ الدّموعِ كأنّما","أذابَتْ بعَيْنَيْها النّوى لُؤلؤاً رَطْبا",4,"ب",2,0],["وتذَكُّري زَمَنَ العُذَيْبِ يَشِفُّني","والوَجْدُ مَمْنُوٌّ بهِ المُتَذَكِّرُ",5,"ر",1,0],["وتذكّرت مصيري والجوى","بين جنبيك جراح في التهاب",6,"ب",1,0],["وتذكّرَتْ عهْداً بمُنْعَرَجِ اللِّوى","لا يسْتَحيلُ وموْقِفاً مَشْهودا",7,"د",2,0],["وَتَذَوَّقوا مَعنى الحَياةِ فَإِنَّها","في مِصرَ أَلفاظٌ بِغَيرِ مَعاني",8,"ن",2,0],["وَتُذكِرُني العِقدَ المُرِنَّ جُمانُهُ","مُرِنّاتُ وُرقٍ في ذُرى الأَيكِ تَهتِفُ",9,"ف",1,0],["وَتَذَكَّرِي أَيَّامَهُ الْغُرَّ الَّتِي","كَانَتْ عُقُودَ بَدَائِعٍ وَمَعَانِ",10,"ن",1,0],["وَتَذُوبُ فِي لَهَبِ الشُّمُوسِ هَوَانِئاً","وَبِهَا الشُّمُوسُ تَذُوبُ وَهْيَ هَوَانِي",11,"ن",2,0],["وتذهب محيار الظلام تخبّطاً","وتعثر في ظلماءها بالجلامد",12,"د",1,0],["وَتَذكُرُ ما بَينَ الضِبابِ وَجَعفَرٍ","وَتَنسَونَ قَتلى لَم تُقَتَّل ثُؤورُها",13,"ر",3,0],["وتذكرنا عهدَ الشهيدِ ودهرَه","سقى الغيثُ عنا ذلك العهد والدهرا",14,"ر",2,0],["وتذكرك الجنَّات بالنسك والتقى","بشيران بالإحسان والعدل في الورى",15,"ر",2,0],["وتذللاً في الخلق بعد تعززٍ","وتحيراً في الأمر قبل توقع",16,"ع",1,0],["وتذكّر مَعاهِدي إنك المرْ","ءُ الذي ما عَهِدْتُهُ نَسَّاءَ",17,"ا",2,0],["وَتَذْهَبُ بالعقول إذا تداعتْ","أَزاملُ جَوِّها الزَّجِلِ الصَّخوبِ",18,"ب",1,0],["وتذكَّر حين تنسى","حِرَ عَمَّتْكَ وأيري",19,"ر",2,0],["وَتَذوبُ أَصباغاً كَأَلوانِ الضُحى","وَتَموجُ أَلحانا وَتَسري عَنبَرا",20,"ر",2,0],["وتذوي وُرَيْداتُ تِلْكَ الشِّفاهِ","وتهوي إلى التُّرْبِ تِلْكَ النَّهودْ",21,"د",1,0],["وتذوبَ في روحي التي لا تنتهي","وتصيرَ بعضَ ألوهتي وشَبابي",22,"ي",1,0],["وتذرف عيناها الدموع وقلبها","تظلُّ به الأحزان تعلو وتسفل",23,"ل",1,0],["وتذود عنه بشامخ","منها وآونة بزاخر",24,"ر",1,0],["وَتَذهَبُ في الخَليجِ لَهُ وَتَأتي","أَنامِلُ تَنثُرُ العِقيانَ خَمسُ",25,"س",1,0],["وَتَذهَبُ النَحلُ خِفا","فاً وَتَجيءُ مُوقَرَه",26,"ر",2,0],["وَتَذرِفُ عَيني إِن تَذَكَّرتُ مُلتَقىً","لَنا وَعُيونُ الحَيِّ فينا هُجودُها",27,"د",3,0],["وَتُذيبُ الأَحشاءَ ساعاتُ هَجرٍ","ضَرِمٍ في الضُلوعِ يَحمى هَجيرُه",28,"ر",2,0],["وَتَذَكَّروا حَربَ الفَسادِ وَما مَرَت","لِلأَبرَهَينِ مِنَ الأُجاجِ الأَكدَرِ",29,"ر",1,0],["وَتَذعَرُ الأَعداءُ مِن فارِسٍ","يَهولُهُم إِشراقَةُ أَو يَروع",30,"ع",1,0],["وَتَذَلَّلتُ جاهِداً لِمَليكي","وَقَليلٌ مِن عاشِقٍ أَن يَذِلّا",31,"ل",2,0],["وَتَذَكَّرتُ وافِدَ الشَيبِ فَاِستَع","جَلتُ حَظّي في الراحِ وَالرَيحانِ",32,"ن",1,0],["وَتَذَكُّريكَ عَلى البِعادِ وَبَينَنا","بَرُّ العِراقِ وَبَحرُها المَشروعُ",33,"ع",1,0],["وتُذكى على الهِرماسِ نارُ قبيلةٍ","لحُمرتِها في الخافِقَين ضِرامُ",34,"م",1,0],["وَتَذَكَّرتُ جيرَةً بِمَغاني","هِ وَنَدباً مِن آلِ سَنبَسَ قَيلا",35,"ل",2,0],["وتذكّرَتْ فتكاتها فكأنّما","أقعتْ على أدبارها لتثورا",36,"ر",2,0],["وَتَذْعَرُ بالبَيداءِ عِيناً شوَارِداً","تُذَكّرُ بالأحداقِ عيناً أوانِسا",37,"س",2,0],["وتُذْهِبُ عنّي همّ نفسي كأنّها","شَفَتْ غُلّةَ الظَمآنِ بالبارِدِ العذبِ",38,"ب",1,0],["وتذكّروا المستعمرينَ فانَّهُمْ","سَوْطٌ على هذي البلادِ وحُوب",39,"ب",1,0],["وَتَذَكَّرتُ ظَبيَةً أُمَّ رِئمٍ","هاجَ لي الشَوقَ ذِكرُها فَشَجاني",40,"ي",1,0],["وَتَذَكَّرتُ قَولَها لي لَدى المَي","لِ وَكَفَّت دُموعَها أَن تَمورا",41,"ر",2,0],["وَتَذَكَّرتُ قَولَ نُعمٍ وَكانَ ال","ذِكرُ مِنها مِمّا يَهيجُ فُؤادي",42,"د",2,0],["وَتَذَكَّرتُ مِن رُقَيَّةَ ذِكراً","قَد مَضى دارِساً عَلى الأَحقابِ",43,"ب",1,0],["وَتَذنُبُ لَيلى ثُمَّ تَزعَمُ أَنَّني","أَسَأتُ وَلا يَخفى عَلى الناسِ ما بِيا",44,"ي",2,0],["وتُذعِنُ للتحكُّمِ فوق عرشٍ","تَدين له قُوى المُتحكِّمينا",45,"ن",2,0],["وَتَذهَبُ في الدَأماءِ تَطلُبُ صَيدَها","فَتَقنُصُ فيها السابِحاتِ الجَوارِيا",46,"ي",2,0],["وَتَذَكَّرا العَهدَ القَديمَ وَجَدِّدا","عَهداً عَنِ الوُدِّ المَتينِ يُبينُ",47,"ن",1,0],["وتذهبُ منّا ذَواتُ الحِجالِ","تُجرجِرُ في الحيِّ أذيالَها",48,"ل",3,0],["وتذكرُ طارقاً دَأْبَ المُلِيمِ","يُسيءُ ويُدَّعَى لأبٍ كريمِ",49,"م",1,0],["وَتَذَكَّرْتُ رَحْمَةَ اللَّهِ فالبِش","رُ لِوَجْهِي أنّى انْتَحَى تِلْقاءُ",50,"ا",2,0],["وَتَذرُفُ العَينُ إِذا ما نَأَوا","وَإِن أَساؤوا الدَهرَ أَن تُجمِلا",51,"ل",2,0],["وَتَذَكَّرتُكِ في الحَي","يِ فَفاضَت عَبَراتي",52,"ي",1,0],["وتذكرت أنني رجلٌ جي","ءَ به كي يراع منه الشعور",53,"ر",1,0],["وَتذكرت سعد العَشير خَطيبها","نجل الرَئيس عَلى بني حردان",54,"ن",1,0],["وَتَذَكَّرتُ عَبلَةً يَومَ جاءَت","لِوَداعي وَالهَمُّ وَالوَجدُ بادي",55,"ي",1,0],["وَتَذُودُ عَنْهَا فِي الْكرِيهَةِ","فَهْيَ لَنْ تَنْسَى ذِيَادَكْ",56,"ك",1,0],["وَتذكُرُكَ الأَوْطَانُ يَوْمَ فخَارِهَا","إِذَا ذكَرَتْ أَفْذَاذَهَا النُّبَغاءَ",57,"ا",2,0],["وتذكّري ماضيكِ فهو مَجادةٌ","قد كان أستاذَ الوَرى ماضيك",58,"ك",1,0],["وتذكرْ من كان يَجْزِي على الشع","ر بِمَنْح الجواهر المكنونة",59,"ن",2,0],["وتذاكروا أدب الممالك؛ فانطوت","في حجرة جمعتهم الأقطار",60,"ر",1,0],["وتَذُوقَ ما ذَاقَ التَّتَارُ عِصَابَةٌ","هي في الشَّراسَةِ مَضْربُ الأمثالِ",61,"ل",1,0],["وتذكرت عهدا بمنعرج اللوى","لا يستحيل وموثقا مشهودا",62,"د",2,0],["وتذكَّروا كَلفَ امرئٍ متشوّقٍ","منزوفِ صبرٍ بالفراق ، قتيله",63,"ل",2,0],["وتذرف عيني إن تذكرت ملتقى","لنا وعيون الحي فينا وجودها",64,"د",3,0],["وتذيع حمّتها عبيرا ربّما","أخذ الشذى القدسيّ عن جبريلا",65,"ل",2,0],["وتذكر العهد القديم وجددا","عهداً عن الود المتين يبين",66,"ن",1,0],["وتذكرتُ قولَ نعمٍ، وكان الذ","ذّكْرُ مِنْهَا مِمَّا يَهيجُ فُؤَادي",67,"د",2,0],["وتذكرتُ قولها لي، لدى الميلِ،","ل وَكَفَّتْ دُمُوعَها أَنْ تَمورا",68,"ر",2,0],["وَتَذَكَّر رَبُّ الخَوَرنَقِ إِذ أَشْ","رفَ يَوماً لِلهُدى تَفكيرُ",69,"ر",1,0],["وتذهبَ مِحيار الظلام تخبطاً","وتعثر في ظلمائها بالجلامد",70,"د",1,0],["وتذكرتُ عبلة َ يومَ جاءت","لوداعي والهمُّ والوجد باد",71,"د",1,0],["وَتَذُوقَ حَتْفاً آلُ بَكْرٍ كُلُّها","وَنَهُدٌ مِنْهَا سَمْكَهَا الْمَرْفُوعَا",72,"ع",2,0],["وَتَذلل في كُل باب مَذَلة","إِذ عَزَّ مَن يُرجى لِأَمر يطرق",73,"ق",1,0],["وتذكر اسمك القدسي زهر","فيسبق قولها منها البكاء",74,"ا",2,0],["وتذكارات آمالي","قضت في جملة الحسبة",75,"ب",2,0],["وتُذكِى خَامِدَ الأشجَانِ حَتَّى","كَأنَّ القَلبَ مَصلِىٌّ بِنَارِ",76,"ر",1,0],["وتَذودُ إرعَوَاءَهُ فتَرَاهُ","مُستَهاماً يبكىِ الرُّبُوعَ اليَبَابَا",77,"ب",2,0],["وتذكري تلك العهود فإِنني","أمسيت مشغوفاً بها مشغولا",78,"ل",2,0],["وتذكرون مقالي اليوم حينئذ","وتشكرون إلها خير من شكرا",79,"ر",2,0],["وتذكُري ما خَلا","مِن نَعيمٍ تَصرّما",80,"م",2,0],["وتَذوي مُهجتي واشتْف لَوني","وتَدمَى مُقلتي وسَلِ الليالي",81,"ي",1,0],["وَتُذنِبُ أَقوامٌ فَتُعزى ذُنوبُها","إِلَيَّ وَأُلحى عِندَكُم وَأُلامُ",82,"م",1,0],["وتذاءبوا في كسبهم","وتكالبوا عند المآكل",83,"ل",1,0],["وَتذكّر رفيقهُ في الغارِ","شيخَ تيمٍ صديقه المعلومُ",84,"م",1,0],["وَتذكّر مِن بعدِ نصرةِ بدر","أُحداً كيفَ كان فيه البلاءُ",85,"ا",2,0],["وتذهبُ نفسي حسرةً إن رأيتُها","وأُصرعُ وجداً كلما قالتْ