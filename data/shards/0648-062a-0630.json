{"poems":[[53,"حي بين النقا وبين المصلى","https://www.aldiwan.net/poem30776.html","الخفيف"],[63,"رأى صحبي بكاظمة","https://www.aldiwan.net/poem45706.html","مجزوء الوافر"],[63,"خطرت لذكرك يا أميمة خطرة","https://www.aldiwan.net/poem45810.html","الكامل"],[63,"أتروى وقد صدح الجندب","https://www.aldiwan.net/poem46138.html","المتقارب"],[63,"أثرها فلا ماء أصابت ولا عشبا","https://www.aldiwan.net/poem46174.html","الطويل"],[63,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[100,"أمي","https://www.aldiwan.net/poem23695.html","عموديه"],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.aldiwan.net/poem36535.html","الكامل"],[86,"أثنى الحجيج عليك والحرمان","https://www.aldiwan.net/poem68941.html","الكامل"],[73,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[93,"أحننت من شوق إلى لبنان","https://www.aldiwan.net/poem11270.html","الكامل"],[93,"أرأيت صوغ الدر في العقيان","https://www.aldiwan.net/poem11278.html","الكامل"],[88,"إذا شئت أن تسري بكافرة الصوى","https://www.aldiwan.net/poem44444.html","الطويل"],[27,"أزرت ديار الحي أم لا تزورها","https://www.aldiwan.net/poem5767.html","الطويل"],[72,"تنبه لما أن رأى شبيه فجرا","https://www.aldiwan.net/poem18702.html","الطويل"],[72,"على حركات اليمن والأمن والهنا","https://www.aldiwan.net/poem18726.html","الطويل"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"أسالم قد سلمت من العيوب","https://www.aldiwan.net/poem8313.html","الوافر"],[51,"قل لعمار بن عما","https://www.aldiwan.net/poem64068.html","مجزوء الرمل"],[91,"الحسن حولك في الوهاد وفي الذرى","https://www.aldiwan.net/poem8867.html","عموديه"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[92,"كان الربيع الحي روحا حالما","https://www.aldiwan.net/poem38969.html","الكامل"],[89,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[85,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[85,"تحية شاعر يا ماء جكسو","https://www.aldiwan.net/poem63712.html","الوافر"],[85,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[45,"سواي مرجي سلوة أو مريدها","https://www.aldiwan.net/poem62760.html","الطويل"],[45,"أوحشت أربع العقيق ودوره","https://www.aldiwan.net/poem63578.html","الخفيف"],[45,"أقصر فإن الدهر ليس بمقصر","https://www.aldiwan.net/poem63625.html","الكامل"],[45,"كلفني فوق الذي أستطيع","https://www.aldiwan.net/poem64668.html","الرجز"],[45,"إن سير الخليط حين استقلا","https://www.aldiwan.net/poem65546.html","الخفيف"],[45,"أدمع قد غرين بالهملان","https://www.aldiwan.net/poem66672.html","الخفيف"],[45,"أغدا يشت المجد وهو جميع","https://www.aldiwan.net/poem64713.html","الكامل"],[61,"محلك مثل الغاب ليس يرام","https://www.aldiwan.net/poem51457.html","الطويل"],[66,"أترى البارق الذي لاح ليلا","https://www.aldiwan.net/poem40649.html","الخفيف"],[80,"واعمر بقصر الملك ناديك الذي","https://www.aldiwan.net/poem31233.html","الكامل"],[80,"لأمر طويل الهم نزجي العرامسا","https://www.aldiwan.net/poem31418.html","الطويل"],[80,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[90,"أرج الشباب وخمره المسكوب","https://www.aldiwan.net/poem60158.html","عموديه"],[31,"إنني اليوم عادني أحزاني","https://www.aldiwan.net/poem41287.html","الخفيف"],[31,"نام صحبي وبات نومي عسيرا","https://www.aldiwan.net/poem42530.html","الخفيف"],[31,"طال ليلي فما أحس رقادي","https://www.aldiwan.net/poem42582.html","الخفيف"],[31,"طال ليلي واعتادني أطرابي","https://www.aldiwan.net/poem42649.html","الخفيف"],[33,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"يقولون لي ماذا قرأت لعلهم","https://www.aldiwan.net/poem43113.html","الطويل"],[105,"سر فالسعادة حيث كنت تكون","https://www.aldiwan.net/poem43406.html","الكامل"],[105,"لمن تجمع الروم أبطالها","https://www.aldiwan.net/poem44030.html","المتقارب"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"عجزت يا مهجور أن تذهلا","https://www.aldiwan.net/poem64974.html","السريع"],[50,"قل لحبى قربيني","https://www.aldiwan.net/poem64739.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9919","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54537","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[106,"هو ليلاي","https://www.poetsgate.com/ViewPoem.aspx?id=179378",""],[106,"سمر الأدباء","https://www.poetsgate.com/ViewPoem.aspx?id=179454",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[45,"سواي مرجي سلوة أو مريدها","https://www.poetsgate.com/ViewPoem.aspx?id=32953",""],[105,"سر فالسعادة حيث كنت تكون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54852&r=&rc=22",""],[31,"طَالَ لَيْلي فَمَا أُحِسُّ رُقَادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18821&r=&rc=84",""],[31,"نامَ صحبي، وباتَ نومي عسيرا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18872&r=&rc=135",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[88,"اذا شئت ان تسرى بكافرة الصوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19534&r=&rc=37",""],[3,"أَحْرَقَتْني نارُ الجَوى والبعادِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10683&r=&rc=37",""],[18,"لما نعى الناعي كليباً أظلمتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26450&r=&rc=16",""]],"verses":[["وَتَذَكَّر عَنّي مُناخَ مَطِيّي","بِأَعالي مِنىً وَمَرسى خِبائي",0,"ي",1,0],["وَتُذكيها عَلى خَفَرٍ","بِأَعوادٍ مِنَ الرَّندِ",1,"د",1,0],["وَتَذودُ عَن قَلبي سِواكِ كَما أَبَى","دَمعي جَوازَ النَّومِ بِالآماقِ",2,"ق",1,0],["وتَذْخَرُ سَلْمى ضَريبَ اللِّقاحِ","لهُ وولائِدُها تَسْغَبُ",3,"ب",1,0],["وتُذْري شَآبيبَ الدّموعِ كأنّما","أذابَتْ بعَيْنَيْها النّوى لُؤلؤاً رَطْبا",4,"ب",2,0],["وتذَكُّري زَمَنَ العُذَيْبِ يَشِفُّني","والوَجْدُ مَمْنُوٌّ بهِ المُتَذَكِّرُ",5,"ر",1,0],["وتذكّرت مصيري والجوى","بين جنبيك جراح في التهاب",6,"ب",1,0],["وتذكّرَتْ عهْداً بمُنْعَرَجِ اللِّوى","لا يسْتَحيلُ وموْقِفاً مَشْهودا",7,"د",2,0],["وَتَذَوَّقوا مَعنى الحَياةِ فَإِنَّها","في مِصرَ أَلفاظٌ بِغَيرِ مَعاني",8,"ن",2,0],["وَتُذكِرُني العِقدَ المُرِنَّ جُمانُهُ","مُرِنّاتُ وُرقٍ في ذُرى الأَيكِ تَهتِفُ",9,"ف",1,0],["وَتَذَكَّرِي أَيَّامَهُ الْغُرَّ الَّتِي","كَانَتْ عُقُودَ بَدَائِعٍ وَمَعَانِ",10,"ن",1,0],["وَتَذُوبُ فِي لَهَبِ الشُّمُوسِ هَوَانِئاً","وَبِهَا الشُّمُوسُ تَذُوبُ وَهْيَ هَوَانِي",11,"ن",2,0],["وتذهب محيار الظلام تخبّطاً","وتعثر في ظلماءها بالجلامد",12,"د",1,0],["وَتَذكُرُ ما بَينَ الضِبابِ وَجَعفَرٍ","وَتَنسَونَ قَتلى لَم تُقَتَّل ثُؤورُها",13,"ر",3,0],["وتذكرنا عهدَ الشهيدِ ودهرَه","سقى الغيثُ عنا ذلك العهد والدهرا",14,"ر",2,0],["وتذكرك الجنَّات بالنسك والتقى","بشيران بالإحسان والعدل في الورى",15,"ر",2,0],["وتذللاً في الخلق بعد تعززٍ","وتحيراً في الأمر قبل توقع",16,"ع",1,0],["وتذكّر مَعاهِدي إنك المرْ","ءُ الذي ما عَهِدْتُهُ نَسَّاءَ",17,"ا",2,0],["وَتَذْهَبُ بالعقول إذا تداعتْ","أَزاملُ جَوِّها الزَّجِلِ الصَّخوبِ",18,"ب",1,0],["وتذكَّر حين تنسى","حِرَ عَمَّتْكَ وأيري",19,"ر",2,0],["وَتَذوبُ أَصباغاً كَأَلوانِ الضُحى","وَتَموجُ أَلحانا وَتَسري عَنبَرا",20,"ر",2,0],["وتذوي وُرَيْداتُ تِلْكَ الشِّفاهِ","وتهوي إلى التُّرْبِ تِلْكَ النَّهودْ",21,"د",1,0],["وتذوبَ في روحي التي لا تنتهي","وتصيرَ بعضَ ألوهتي وشَبابي",22,"ي",1,0],["وتذرف عيناها الدموع وقلبها","تظلُّ به الأحزان تعلو وتسفل",23,"ل",1,0],["وتذود عنه بشامخ","منها وآونة بزاخر",24,"ر",1,0],["وَتَذهَبُ في الخَليجِ لَهُ وَتَأتي","أَنامِلُ تَنثُرُ العِقيانَ خَمسُ",25,"س",1,0],["وَتَذهَبُ النَحلُ خِفا","فاً وَتَجيءُ مُوقَرَه",26,"ر",2,0],["وَتَذرِفُ عَيني إِن تَذَكَّرتُ مُلتَقىً","لَنا وَعُيونُ الحَيِّ فينا هُجودُها",27,"د",3,0],["وَتُذيبُ الأَحشاءَ ساعاتُ هَجرٍ","ضَرِمٍ في الضُلوعِ يَحمى هَجيرُه",28,"ر",2,0],["وَتَذَكَّروا حَربَ الفَسادِ وَما مَرَت","لِلأَبرَهَينِ مِنَ الأُجاجِ الأَكدَرِ",29,"ر",1,0],["وَتَذعَرُ الأَعداءُ مِن فارِسٍ","يَهولُهُم إِشراقَةُ أَو يَروع",30,"ع",1,0],["وَتَذَلَّلتُ جاهِداً لِمَليكي","وَقَليلٌ مِن عاشِقٍ أَن يَذِلّا",31,"ل",2,0],["وَتَذَكَّرتُ وافِدَ الشَيبِ فَاِستَع","جَلتُ حَظّي في الراحِ وَالرَيحانِ",32,"ن",1,0],["وَتَذَكُّريكَ عَلى البِعادِ وَبَينَنا","بَرُّ العِراقِ وَبَحرُها المَشروعُ",33,"ع",1,0],["وتُذكى على الهِرماسِ نارُ قبيلةٍ","لحُمرتِها في الخافِقَين ضِرامُ",34,"م",1,0],["وَتَذَكَّرتُ جيرَةً بِمَغاني","هِ وَنَدباً مِن آلِ سَنبَسَ قَيلا",35,"ل",2,0],["وتذكّرَتْ فتكاتها فكأنّما","أقعتْ على أدبارها لتثورا",36,"ر",2,0],["وَتَذْعَرُ بالبَيداءِ عِيناً شوَارِداً","تُذَكّرُ بالأحداقِ عيناً أوانِسا",37,"س",2,0],["وتُذْهِبُ عنّي همّ نفسي كأنّها","شَفَتْ غُلّةَ الظَمآنِ بالبارِدِ العذبِ",38,"ب",1,0],["وتذكّروا المستعمرينَ فانَّهُمْ","سَوْطٌ على هذي البلادِ وحُوب",39,"ب",1,0],["وَتَذَكَّرتُ ظَبيَةً أُمَّ رِئمٍ","هاجَ لي الشَوقَ ذِكرُها فَشَجاني",40,"ي",1,0],["وَتَذَكَّرتُ قَولَها لي لَدى المَي","لِ وَكَفَّت دُموعَها أَن تَمورا",41,"ر",2,0],["وَتَذَكَّرتُ قَولَ نُعمٍ وَكانَ ال","ذِكرُ مِنها مِمّا يَهيجُ فُؤادي",42,"د",2,0],["وَتَذَكَّرتُ مِن رُقَيَّةَ ذِكراً","قَد مَضى دارِساً عَلى الأَحقابِ",43,"ب",1,0],["وَتَذنُبُ لَيلى ثُمَّ تَزعَمُ أَنَّني","أَسَأتُ وَلا يَخفى عَلى الناسِ ما بِيا",44,"ي",2,0],["وتُذعِنُ للتحكُّمِ فوق عرشٍ","تَدين له قُوى المُتحكِّمينا",45,"ن",2,0],["وَتَذهَبُ في الدَأماءِ تَطلُبُ صَيدَها","فَتَقنُصُ فيها السابِحاتِ الجَوارِيا",46,"ي",2,0],["وَتَذَكَّرا العَهدَ القَديمَ وَجَدِّدا","عَهداً عَنِ الوُدِّ المَتينِ يُبينُ",47,"ن",1,0],["وتذهبُ منّا ذَواتُ الحِجالِ","تُجرجِرُ في الحيِّ أذيالَها",48,"ل",3,0],["وتذكرُ طارقاً دَأْبَ المُلِيمِ","يُسيءُ ويُدَّعَى لأبٍ كريمِ",49,"م",1,0],["وَتَذَكَّرْتُ رَحْمَةَ اللَّهِ فالبِش","رُ لِوَجْهِي أنّى انْتَحَى تِلْقاءُ",50,"ا",2,0],["وَتَذرُفُ العَينُ إِذا ما نَأَوا","وَإِن أَساؤوا الدَهرَ أَن تُجمِلا",51,"ل",2,0],["وَتَذَكَّرتُكِ في الحَي","يِ فَفاضَت عَبَراتي",52,"ي",1,0],["وتذكرت أنني رجلٌ جي","ءَ به كي يراع منه الشعور",53,"ر",1,0],["وَتذكرت سعد العَشير خَطيبها","نجل الرَئيس عَلى بني حردان",54,"ن",1,0],["وَتَذَكَّرتُ عَبلَةً يَومَ جاءَت","لِوَداعي وَالهَمُّ وَالوَجدُ بادي",55,"ي",1,0],["وَتَذُودُ عَنْهَا فِي الْكرِيهَةِ","فَهْيَ لَنْ تَنْسَى ذِيَادَكْ",56,"ك",1,0],["وَتذكُرُكَ الأَوْطَانُ يَوْمَ فخَارِهَا","إِذَا ذكَرَتْ أَفْذَاذَهَا النُّبَغاءَ",57,"ا",2,0],["وتذكّري ماضيكِ فهو مَجادةٌ","قد كان أستاذَ الوَرى ماضيك",58,"ك",1,0],["وتذكرْ من كان يَجْزِي على الشع","ر بِمَنْح الجواهر المكنونة",59,"ن",2,0],["وتذاكروا أدب الممالك؛ فانطوت","في حجرة جمعتهم الأقطار",60,"ر",1,0],["وتَذُوقَ ما ذَاقَ التَّتَارُ عِصَابَةٌ","هي في الشَّراسَةِ مَضْربُ الأمثالِ",61,"ل",1,0],["وتذكرت عهدا بمنعرج اللوى","لا يستحيل وموثقا مشهودا",62,"د",2,0],["وتذكَّروا كَلفَ امرئٍ متشوّقٍ","منزوفِ صبرٍ بالفراق ، قتيله",63,"ل",2,0],["وتذرف عيني إن تذكرت ملتقى","لنا وعيون الحي فينا وجودها",64,"د",3,0],["وتذكر العهد القديم وجددا","عهداً عن الود المتين يبين",65,"ن",1,0],["وتذكرتُ قولَ نعمٍ، وكان الذ","ذّكْرُ مِنْهَا مِمَّا يَهيجُ فُؤَادي",66,"د",2,0],["وتذكرتُ قولها لي، لدى الميلِ،","ل وَكَفَّتْ دُمُوعَها أَنْ تَمورا",67,"ر",2,0],["وَتَذَكَّر رَبُّ الخَوَرنَقِ إِذ أَشْ","رفَ يَوماً لِلهُدى تَفكيرُ",68,"ر",1,0],["وتذهبَ مِحيار الظلام تخبطاً","وتعثر في ظلمائها بالجلامد",69,"د",1,0],["وتذكرتُ عبلة َ يومَ جاءت","لوداعي والهمُّ والوجد باد",70,"د",1,0],["وَتَذُوقَ حَتْفاً آلُ بَكْرٍ كُلُّها","وَنَهُدٌ مِنْهَا سَمْكَهَا الْمَرْفُوعَا",71,"ع",2,0]]}