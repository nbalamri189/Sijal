 يا منى القلب","https://www.aldiwan.net/poem18042.html","الكامل"],[238,"عللوني بالوصل قبل الممات","https://www.aldiwan.net/poem18082.html","الخفيف"],[262,"تحية داع مخلص في دعائه","https://www.aldiwan.net/poem38280.html","الطويل"],[263,"أبعد الخيل أركبها ورادا","https://www.aldiwan.net/poem68196.html","الوافر"],[271,"قل للفرنجة بعد حكم جائر","https://www.aldiwan.net/poem34995.html","الكامل"],[272,"يا راحلين إلى منى بقيادي","https://www.aldiwan.net/poem52045.html","الكامل"],[286,"قل لمن تاه دلالا وهوى","https://www.aldiwan.net/poem39393.html","الرمل"],[298,"يا غزالا يخفي سناه الغزاله","https://www.aldiwan.net/poem33189.html","الخفيف"],[305,"ألا ليت شعري والفؤاد به ثأر","https://www.aldiwan.net/poem16805.html","الطويل"],[343,"شهيد البلاد ألا تسمع","https://www.aldiwan.net/poem55345.html","المتقارب"],[343,"إلى أين في هذه الفانية","https://www.aldiwan.net/poem55382.html","المتقارب"],[354,"وتذكرت عهد الهوى","https://www.aldiwan.net/poem39954.html","مجزوء الكامل"],[362,"مقلتي قد نلت كل الارب","https://www.aldiwan.net/poem68142.html","الرمل"],[372,"لمعت سيوف بني حميد بعد ما","https://www.aldiwan.net/poem57156.html","الكامل"],[378,"إلام إلام ظلما يا حسود","https://www.aldiwan.net/poem59453.html","البسيط"],[381,"لبيك داعية الغرام","https://www.aldiwan.net/poem49199.html","مجزوء الكامل"],[397,"يا جار طلحة هل ترد لبونهُ","https://www.aldiwan.net/poem613.html",""],[404,"أهلا بنظم كالرحيق السلسل","https://www.aldiwan.net/poem33604.html","الرجز"],[406,"سيدي أنت لا تخل بخل","https://www.aldiwan.net/poem50086.html","الخفيف"],[442,"كتابك يا علي زار غبا","https://www.aldiwan.net/poem14295.html","الوافر"],[444,"ما كان ذنبي يا أعز الناس","https://www.aldiwan.net/poem56049.html","عموديه"],[453,"وظبي غرير أودع الله ثغره","https://www.aldiwan.net/poem13774.html","الطويل"],[454,"مرحبا بالمنافس الفاتكان","https://www.aldiwan.net/poem61764.html","الخفيف"],[459,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[459,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[478,"حي عني الحمى وحي المصلى","https://www.aldiwan.net/poem15265.html","الخفيف"],[480,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[496,"وشاكية تكذب تئن ولا تتعب","https://www.aldiwan.net/poem9771.html","مجزوء المتقارب"],[501,"كيف لا أندب الطلول غراما","https://www.aldiwan.net/poem37782.html","الخفيف"],[501,"خذوني إلى أرض المدينة إنني","https://www.aldiwan.net/poem38043.html","الطويل"],[507,"أيها المستطيل بالبغي اقصر","https://www.aldiwan.net/poem2424.html","الخفيف"],[510,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[516,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[516,"محلك لا يسام ولا يسامى","https://www.aldiwan.net/poem12260.html","الوافر"],[552,"بربك أيها البرق اليماني","https://www.aldiwan.net/poem47166.html","الوافر"],[552,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[559,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[559,"لو تجلى عن ناظريك الغبار","https://www.aldiwan.net/poem34555.html","الخفيف"],[559,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[563,"ورد الكتاب فضاع طيب نشره","https://www.aldiwan.net/poem52956.html","الكامل"]],"verses":[["وتذهل عما أرضعت كل مرضع","وتغفل عما أفطمت كل مطفل",0,"ل",1,0],["وَتَذَكَّر عَنّي مُناخَ مَطِيّي","بِأَعالي مِنىً وَمَرسى خِبائي",1,"ي",1,0],["وَتُذكيها عَلى خَفَرٍ","بِأَعوادٍ مِنَ الرَّندِ",2,"د",1,0],["وَتَذودُ عَن قَلبي سِواكِ كَما أَبَى","دَمعي جَوازَ النَّومِ بِالآماقِ",3,"ق",1,0],["وتَذْخَرُ سَلْمى ضَريبَ اللِّقاحِ","لهُ وولائِدُها تَسْغَبُ",4,"ب",1,0],["وتُذْري شَآبيبَ الدّموعِ كأنّما","أذابَتْ بعَيْنَيْها النّوى لُؤلؤاً رَطْبا",5,"ب",2,0],["وتذَكُّري زَمَنَ العُذَيْبِ يَشِفُّني","والوَجْدُ مَمْنُوٌّ بهِ المُتَذَكِّرُ",6,"ر",1,0],["وتذكّرت مصيري والجوى","بين جنبيك جراح في التهاب",7,"ب",1,0],["وتذكّرَتْ عهْداً بمُنْعَرَجِ اللِّوى","لا يسْتَحيلُ وموْقِفاً مَشْهودا",8,"د",2,0],["وَتَذَوَّقوا مَعنى الحَياةِ فَإِنَّها","في مِصرَ أَلفاظٌ بِغَيرِ مَعاني",9,"ن",2,0],["وَتُذكِرُني العِقدَ المُرِنَّ جُمانُهُ","مُرِنّاتُ وُرقٍ في ذُرى الأَيكِ تَهتِفُ",10,"ف",1,0],["وَتَذَكَّرِي أَيَّامَهُ الْغُرَّ الَّتِي","كَانَتْ عُقُودَ بَدَائِعٍ وَمَعَانِ",11,"ن",1,0],["وَتَذُوبُ فِي لَهَبِ الشُّمُوسِ هَوَانِئاً","وَبِهَا الشُّمُوسُ تَذُوبُ وَهْيَ هَوَانِي",12,"ن",2,0],["وتذهب محيار الظلام تخبّطاً","وتعثر في ظلماءها بالجلامد",13,"د",1,0],["وَتَذكُرُ ما بَينَ الضِبابِ وَجَعفَرٍ","وَتَنسَونَ قَتلى لَم تُقَتَّل ثُؤورُها",14,"ر",3,0],["وتذكرنا عهدَ الشهيدِ ودهرَه","سقى الغيثُ عنا ذلك العهد والدهرا",15,"ر",2,0],["وتذكرك الجنَّات بالنسك والتقى","بشيران بالإحسان والعدل في الورى",16,"ر",2,0],["وتذللاً في الخلق بعد تعززٍ","وتحيراً في الأمر قبل توقع",17,"ع",1,0],["وتذكّر مَعاهِدي إنك المرْ","ءُ الذي ما عَهِدْتُهُ نَسَّاءَ",18,"ا",2,0],["وَتَذْهَبُ بالعقول إذا تداعتْ","أَزاملُ جَوِّها الزَّجِلِ الصَّخوبِ",19,"ب",1,0],["وتذكَّر حين تنسى","حِرَ عَمَّتْكَ وأيري",20,"ر",2,0],["وَتَذوبُ أَصباغاً كَأَلوانِ الضُحى","وَتَموجُ أَلحانا وَتَسري عَنبَرا",21,"ر",2,0],["وتذوي وُرَيْداتُ تِلْكَ الشِّفاهِ","وتهوي إلى التُّرْبِ تِلْكَ النَّهودْ",22,"د",1,0],["وتذوبَ في روحي التي لا تنتهي","وتصيرَ بعضَ ألوهتي وشَبابي",23,"ب",2,0],["وتذرف عيناها الدموع وقلبها","تظلُّ به الأحزان تعلو وتسفل",24,"ل",1,0],["وتذود عنه بشامخ","منها وآونة بزاخر",25,"ر",1,0],["وَتَذهَبُ في الخَليجِ لَهُ وَتَأتي","أَنامِلُ تَنثُرُ العِقيانَ خَمسُ",26,"س",1,0],["وَتَذهَبُ النَحلُ خِفا","فاً وَتَجيءُ مُوقَرَه",27,"ر",2,0],["وَتَذرِفُ عَيني إِن تَذَكَّرتُ مُلتَقىً","لَنا وَعُيونُ الحَيِّ فينا هُجودُها",28,"د",3,0],["وَتُذيبُ الأَحشاءَ ساعاتُ هَجرٍ","ضَرِمٍ في الضُلوعِ يَحمى هَجيرُه",29,"ر",2,0],["وَتَذَكَّروا حَربَ الفَسادِ وَما مَرَت","لِلأَبرَهَينِ مِنَ الأُجاجِ الأَكدَرِ",30,"ر",1,0],["وَتَذعَرُ الأَعداءُ مِن فارِسٍ","يَهولُهُم إِشراقَةُ أَو يَروع",31,"ع",1,0],["وَتَذَلَّلتُ جاهِداً لِمَليكي","وَقَليلٌ مِن عاشِقٍ أَن يَذِلّا",32,"ل",2,0],["وَتَذَكَّرتُ وافِدَ الشَيبِ فَاِستَع","جَلتُ حَظّي في الراحِ وَالرَيحانِ",33,"ن",1,0],["وَتَذَكُّريكَ عَلى البِعادِ وَبَينَنا","بَرُّ العِراقِ وَبَحرُها المَشروعُ",34,"ع",1,0],["وتُذكى على الهِرماسِ نارُ قبيلةٍ","لحُمرتِها في الخافِقَين ضِرامُ",35,"م",1,0],["وَتَذَكَّرتُ جيرَةً بِمَغاني","هِ وَنَدباً مِن آلِ سَنبَسَ قَيلا",36,"ل",2,0],["وتذكّرَتْ فتكاتها فكأنّما","أقعتْ على أدبارها لتثورا",37,"ر",2,0],["وَتَذْعَرُ بالبَيداءِ عِيناً شوَارِداً","تُذَكّرُ بالأحداقِ عيناً أوانِسا",38,"س",2,0],["وتُذْهِبُ عنّي همّ نفسي كأنّها","شَفَتْ غُلّةَ الظَمآنِ بالبارِدِ العذبِ",39,"ب",1,0],["وتذكّروا المستعمرينَ فانَّهُمْ","سَوْطٌ على هذي البلادِ وحُوب",40,"ب",1,0],["وَتَذَكَّرتُ ظَبيَةً أُمَّ رِئمٍ","هاجَ لي الشَوقَ ذِكرُها فَشَجاني",41,"ن",2,0],["وَتَذَكَّرتُ قَولَها لي لَدى المَي","لِ وَكَفَّت دُموعَها أَن تَمورا",42,"ر",2,0],["وَتَذَكَّرتُ قَولَ نُعمٍ وَكانَ ال","ذِكرُ مِنها مِمّا يَهيجُ فُؤادي",43,"د",2,0],["وَتَذَكَّرتُ مِن رُقَيَّةَ ذِكراً","قَد مَضى دارِساً عَلى الأَحقابِ",44,"ب",1,0],["وَتَذنُبُ لَيلى ثُمَّ تَزعَمُ أَنَّني","أَسَأتُ وَلا يَخفى عَلى الناسِ ما بِيا",45,"ي",2,0],["وتُذعِنُ للتحكُّمِ فوق عرشٍ","تَدين له قُوى المُتحكِّمينا",46,"ن",2,0],["وَتَذهَبُ في الدَأماءِ تَطلُبُ صَيدَها","فَتَقنُصُ فيها السابِحاتِ الجَوارِيا",47,"ي",2,0],["وَتَذَكَّرا العَهدَ القَديمَ وَجَدِّدا","عَهداً عَنِ الوُدِّ المَتينِ يُبينُ",48,"ن",1,0],["وتذهبُ منّا ذَواتُ الحِجالِ","تُجرجِرُ في الحيِّ أذيالَها",49,"ل",3,0],["وتذكرُ طارقاً دَأْبَ المُلِيمِ","يُسيءُ ويُدَّعَى لأبٍ كريمِ",50,"م",1,0],["وَتَذَكَّرْتُ رَحْمَةَ اللَّهِ فالبِش","رُ لِوَجْهِي أنّى انْتَحَى تِلْقاءُ",51,"ا",2,0],["وَتَذرُفُ العَينُ إِذا ما نَأَوا","وَإِن أَساؤوا الدَهرَ أَن تُجمِلا",52,"ل",2,0],["وَتَذَكَّرتُكِ في الحَي","يِ فَفاضَت عَبَراتي",53,"ت",2,0],["وتذكرت أنني رجلٌ جي","ءَ به كي يراع منه الشعور",54,"ر",1,0],["وَتذكرت سعد العَشير خَطيبها","نجل الرَئيس عَلى بني حردان",55,"ن",1,0],["وَتَذَكَّرتُ عَبلَةً يَومَ جاءَت","لِوَداعي وَالهَمُّ وَالوَجدُ بادي",56,"د",2,0],["وَتَذُودُ عَنْهَا فِي الْكرِيهَةِ","فَهْيَ لَنْ تَنْسَى ذِيَادَكْ",57,"ك",1,0],["وَتذكُرُكَ الأَوْطَانُ يَوْمَ فخَارِهَا","إِذَا ذكَرَتْ أَفْذَاذَهَا النُّبَغاءَ",58,"ا",2,0],["وتذكّري ماضيكِ فهو مَجادةٌ","قد كان أستاذَ الوَرى ماضيك",59,"ك",1,0],["وتذكرْ من كان يَجْزِي على الشع","ر بِمَنْح الجواهر المكنونة",60,"ن",2,0],["وتذاكروا أدب الممالك؛ فانطوت","في حجرة جمعتهم الأقطار",61,"ر",1,0],["وتَذُوقَ ما ذَاقَ التَّتَارُ عِصَابَةٌ","هي في الشَّراسَةِ مَضْربُ الأمثالِ",62,"ل",1,0],["وتذكرت عهدا بمنعرج اللوى","لا يستحيل وموثقا مشهودا",63,"د",2,0],["وتذكَّروا كَلفَ امرئٍ متشوّقٍ","منزوفِ صبرٍ بالفراق ، قتيله",64,"ل",2,0],["وتذرف عيني إن تذكرت ملتقى","لنا وعيون الحي فينا وجودها",65,"د",3,0],["وتذيع حمّتها عبيرا ربّما","أخذ الشذى القدسيّ عن جبريلا",66,"ل",2,0],["وتذكر العهد القديم وجددا","عهداً عن الود المتين يبين",67,"ن",1,0],["وتذكرتُ قولَ نعمٍ، وكان الذ","ذّكْرُ مِنْهَا مِمَّا يَهيجُ فُؤَادي",68,"د",2,0],["وتذكرتُ قولها لي، لدى الميلِ،","ل وَكَفَّتْ دُمُوعَها أَنْ تَمورا",69,"ر",2,0],["وَتَذَكَّر رَبُّ الخَوَرنَقِ إِذ أَشْ","رفَ يَوماً لِلهُدى تَفكيرُ",70,"ر",1,0],["وتذهبَ مِحيار الظلام تخبطاً","وتعثر في ظلمائها بالجلامد",71,"د",1,0],["وتذكرتُ عبلة َ يومَ جاءت","لوداعي والهمُّ والوجد باد",72,"د",1,0],["وَتَذُوقَ حَتْفاً آلُ بَكْرٍ كُلُّها","وَنَهُدٌ مِنْهَا سَمْكَهَا الْمَرْفُوعَا",73,"ع",2,0],["وَتَذلل في كُل باب مَذَلة","إِذ عَزَّ مَن يُرجى لِأَمر يطرق",74,"ق",1,0],["وتذكر اسمك القدسي زهر","فيسبق قولها منها البكاء",75,"ا",2,0],["وتذكارات آمالي","قضت في جملة الحسبة",76,"ب",2,0],["وتُذكِى خَامِدَ الأشجَانِ حَتَّى","كَأنَّ القَلبَ مَصلِىٌّ بِنَارِ",77,"ر",1,0],["وتَذودُ إرعَوَاءَهُ فتَرَاهُ","مُستَهاماً يبكىِ الرُّبُوعَ اليَبَابَا",78,"ب",2,0],["وتذكري تلك العهود فإِنني","أمسيت مشغوفاً بها مشغولا",79,"ل",2,0],["وتذكرون مقالي اليوم حينئذ","وتشكرون إلها خير من شكرا",80,"ر",2,0],["وتذكُري ما خَلا","مِن نَعيمٍ تَصرّما",81,"م",2,0],["وتَذوي مُهجتي واشتْف لَوني","وتَدمَى مُقلتي وسَلِ الليالي",82,"ل",2,0],["وَتُذنِبُ أَقوامٌ فَتُعزى ذُنوبُها","إِلَيَّ وَأُلحى عِندَكُم وَأُلامُ",83,"م",1,0],["وتذاءبوا في كسبهم","وتكالبوا عند المآكل",84,"ل",1,0],["وَتذكّر رفيقهُ في الغارِ","شيخَ تيمٍ صديقه المعلومُ",85,"م",1,0],["وَتذكّر مِن 