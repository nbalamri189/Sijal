{"poems":[[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[90,"يا شهر أيار ما أن أنت أيار","https://www.aldiwan.net/poem44420.html","البسيط"],[74,"بشراك إن السرى والعود مبرور","https://www.aldiwan.net/poem18707.html","البسيط"],[74,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[72,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[91,"الله للعصفور من","https://www.aldiwan.net/poem44654.html","مجزوء الكامل"],[91,"لبيك من آمر يا خير من عزما","https://www.aldiwan.net/poem44739.html","البسيط"],[87,"يا مكس دنياك عاره","https://www.aldiwan.net/poem7115.html","المجتث"],[45,"حتام نحن نساري النجم في الظلم","https://www.aldiwan.net/poem10575.html","البسيط"],[47,"أنزاعا في الحب بعد نزوع","https://www.aldiwan.net/poem64684.html","الخفيف"],[60,"يا طالب الصفو في الدنيا بلا كدر","https://www.aldiwan.net/poem31023.html","البسيط"],[99,"من شاطئ لشواطئ جدد","https://www.aldiwan.net/poem24763.html","أحذ الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[147,"دم بالصيام مهنأ ما داما","https://www.aldiwan.net/poem11821.html","الكامل"],[164,"لله في كل ما يجري به القدر","https://www.aldiwan.net/poem58869.html","البسيط"],[164,"ما للعلى عتب على الأيام","https://www.aldiwan.net/poem58895.html","الكامل"],[173,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[215,"الآكل الشهد من جيوبي","https://www.aldiwan.net/poem46223.html","مخلع البسيط"],[275,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[280,"لا أعصر الخمر بل أغرس العنبا","https://www.aldiwan.net/poem25626.html","البسيط"],[287,"جاء الربيع وروضه الممطور","https://www.aldiwan.net/poem32758.html","الكامل"],[303,"أنا لست أدري كيف أرثي واحدا","https://www.aldiwan.net/poem36266.html","عموديه"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[353,"إليك بالإذن صار الناس والجود","https://www.aldiwan.net/poem20780.html","البسيط"],[369,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[369,"قفا معي في هذه المعاهد","https://www.aldiwan.net/poem60949.html","السريع"],[406,"رسالة اعتذار إلى أم المؤمنين خديجة (رضي الله عنها)","https://www.aldiwan.net/poem10309.html","عموديه"],[412,"الآن قد صح لي حقا بلا كذب","https://www.aldiwan.net/poem50209.html","البسيط"],[453,"لم توف أشواقي ولا لوعاتي","https://www.aldiwan.net/poem53723.html","الكامل"],[466,"وصاحب من بني الآمال خضت به","https://www.aldiwan.net/poem15303.html","البسيط"],[469,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[469,"لنا بسمر الحمى في الحي أسمار","https://www.aldiwan.net/poem3186.html","عموديه"],[469,"لله يوم إذا تبلح وجهه","https://www.aldiwan.net/poem3251.html","عموديه"],[484,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139061",""],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139050",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87273","المجتث"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59043","المواليا"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59044","المواليا"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72330","الرجز"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138063","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26669","الكامل"],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89628","السريع"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26420","الطويل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126643","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124739","الكامل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102127","المجتث"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27852","السريع"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77208","الكامل"],[2395,"","https://poetry.dctabudhabi.ae/diwan/poem/101406","البسيط"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130763","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200462","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203021","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204631","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204577",""],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132794","الرجز"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145049","الطويل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62897","الكامل"],[3546,"","https://poetry.dctabudhabi.ae/diwan/poem/103371","المنسرح"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61283","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59465","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111476","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36628","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36560","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36313","الدوبيت"],[4221,"","https://poetry.dctabudhabi.ae/diwan/poem/132504","البسيط"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52168","السريع"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52139","الطويل"],[4775,"أضغاث ليل...","https://www.poetsgate.com/ViewPoem.aspx?id=180379",""],[4857,"الشاعر الخشن","https://www.poetsgate.com/ViewPoem.aspx?id=53888",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[5186,"لكن لي فيها مجال صراحة","https://www.poetsgate.com/ViewPoem.aspx?id=156463",""],[5232,"قرية النور","https://www.poetsgate.com/ViewPoem.aspx?id=212235",""],[5273,"في الفخر","https://www.poetsgate.com/ViewPoem.aspx?id=215879",""],[5277,"أين المها....أين الصوادحْ","https://www.poetsgate.com/ViewPoem.aspx?id=192053",""],[5376,"وإذا هفتْ قبل الصباحِ ببسمها","https://www.poetsgate.com/ViewPoem.aspx?id=198992",""],[5376,"على مشارفِ عيد اللهِ مبتسمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205890",""],[5449,"عليل","https://www.poetsgate.com/ViewPoem.aspx?id=189265",""],[5525,"العشق والعتب","https://www.poetsgate.com/ViewPoem.aspx?id=964",""],[5535,"في الجانب الأيمن من خدها","https://www.poetsgate.com/ViewPoem.aspx?id=201491",""],[5582,"خَلِّ الكَئِيبَ يُقاسِي ما يُقاسِيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63602",""],[5596,"غزة فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=205674",""],[5638,"ذات النقاب","https://www.poetsgate.com/ViewPoem.aspx?id=199077",""],[5894,"في الجفن كسر تحته تضعيفي","https://www.poetsgate.com/ViewPoem.aspx?id=131429",""],[5956,"انتبه يا جدّي","https://www.poetsgate.com/ViewPoem.aspx?id=193954",""],[6056,"ماكل من يجهد مصيب","https://www.poetsgate.com/ViewPoem.aspx?id=130341",""],[6102,"دِيوانُ العَربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=182739",""]],"verses":[["في الجاهليّةِ والإِسلامِ هَيبَتُه","تَثْني الخُطوبَ فلا تَعدُو عَواديها",0,"ي",3,0],["في الجوّ منك طخارير مبدّدة","كأنما هي أسمال وأطمار",1,"ر",1,0],["في الجودِ غصن جنانٍ غير منقطع","له على الطرسِ توريقٌ وتثمير",2,"ر",1,0],["في الجود والبأس وفي العلمِ وفي","ذلكَ منسوب إليه فاعْرف",3,"ف",1,0],["في الجانِبِ الوَحشِيِّ مِنها مُرتَقىً","ما يستطاع وَسُورَةٌ ما تُغلَبُ",4,"ب",1,0],["في الجو صقر ذو أظا","فير وفوق الارض هر",5,"ر",1,0],["في الجاهلية صرعى لا انتباه لهم","كأنهم شربوا من مرقد جرعا",6,"ع",2,0],["في الجو تخفى عليه","طريقك المختاره",7,"ر",2,0],["في الجاهِلِيَّةِ إِلّا أَنَّ أَنفُسَهُم","مِن طيبِهِنَّ بِهِ في الأَشهُرِ الحُرُمِ",8,"م",1,0],["في الجَنابِ المُخضَرِّ وَالخُلُقِ السَك","بِ الشَآبيبِ وَالفِناءِ الوَسيعِ",9,"ع",1,0],["في الجُبنِ عارٌ وَفي الإِقدامِ مَكرُمَةٌ","وَمَن يَفِرَّ فَلَن يَنجو مِنَ القَدَرِ",10,"ر",1,0],["في الجو معتبقاً بريّاكِ","خطرت ملاعبة رقيق صبا",11,"ب",2,0],["في الجوّ في الماءِ في الثرى","صوني لها العهدَ والودادا",12,"د",2,0],["في الجَوِّ يُؤْنِسُ مَنْ يُحَلِّقُ طَائِراً","وَالدَّوِّ يُؤْنِسُ رَاكِبَ الوَجْنَاءِ",13,"ا",2,0],["في الجودِ وَالإِقدامِ لا يَصغو إِلى","حَزمٍ وَلا يُصغي إِلى مَن لاما",14,"م",2,0],["في الجاهليةِ والإِسلامِ ملكهمُ","باقٍ وملك سواهم ما له أثرُ",15,"ر",1,0],["في الجاهليةِ ما نظرتُم ملككُمْ","فلذاك دامَ ودامَ في الإِسلام",16,"م",1,0],["في الجاهِلِيَّةِ سُدنا كُلَّ ذي شَرَفٍ","بِالمَأثُراتِ وَسُدنا العُربَ وَالعَجَما",17,"م",2,0],["في الجيب باق تعال وانظر","ترجع إلى العهد يا حبيبي",18,"ب",2,0],["في الجامعِ الأمويِّ طنَّ دويُّها","والمسجدِ الأقصى وصحنِ الأزهر",19,"ر",1,0],["في الجَيْشِ منهُ رَبيط الجَأشِ يُؤْمِنُه","والرّوْع يَفْصِلُ عن راياتِها العَذَبا",20,"ب",2,0],["في الجَدبِ وَالحَربِ العَوانِ كَأَنَّهُ","لَيثٌ وَغَيثٌ هامِرٌ وَهَصورُ",21,"ر",1,0],["في الجامعِ الأُمويِّ قُمتَ مكَبِّراً","وذكرْتَ مجدَ بني (أُميَّةَ) ساجدا",22,"د",2,0],["في الجاهِلِيَّةِ وَالتَأديبِ في اليُتمِ","رُحماكَ رَبّي فَقَلبي في تَقَلُّبِهِ",23,"ه",1,0],["فَيَا لَجُدودِ العَوالي والجدودِ معاً","لِواؤُهُ حَيثُ حَلَّ النَّجْمُ مَعْقُودُ",24,"د",1,0],["في الجِيرةِ الغادِينَ بَدْرُ","وَجْهُ الظّلامِ بهِ أَغَرُّ",25,"ر",1,1],["في الجودِ مثلَ خالدٍ والبأس مثْ","لَ خالدٍ والنّطقِ مثْلَ خالد",26,"د",1,0],["في الجاهليةِ كانت الرَّمْزَ الذي","يحلو به للعفَّةِ التَّغريد",27,"د",1,0],["في الجَوِّ زهر علت لي همة سَبَقَت","لَكِن حَظّي بِها في عقدة الذَنَبِ",28,"ب",1,0],["في الجهر يعطى ما يقل وانه","فى السر يكثر منه بالبركات",29,"ت",1,0],["في الجود غير مُغبٍّ للعُفاةِ وفي ال","وغى مُستمرٌ غيرُ فَرّارِ",30,"ر",1,0],["في الجدب غيثٌ ليس تقلع سُحبهُ","والخوفِ ذمرٌِ لا يباح ذمارُه",31,"ر",2,0],["في الجدب والروع والظلماءِ يشملنا","منهم غيوثٌ وآسادٌ وأَقمار",32,"ر",1,0],["في الجو تحسبه جراداً طائراً","وإذا تدانى خلت ورداً ينثر",33,"ر",1,0],["في الجدّ أو في اللعب","أرواحنا في نهب",34,"ب",1,1],["في الجامع الأموي الحسن مجتمع","وبابه فيه للإحداق لذّاتُ",35,"ت",1,1],["في الجوف منها قلوب جمة جمعت","ولا يكون لجوف الشخص قلبان",36,"ن",1,0],["في الجند أَيُّ زَعيمِ","وَيَحتَمي بِمراسِهْ",37,"ه",1,0],["فِي الجو كَحَّالْ كَمْ كَحَّلْ من أجفَانْ","والبرق يقْدَحْ والسحَاب لُو عِينْ",38,"ن",1,1],["فِي الجو صَاغَهْ جَوْهَرِيهَا العَيُّوقْ","والزُّهْر جَوْهَرْ وَالمَجَرَّهْ عِقْيَانْ",39,"ن",1,1],["في الجود والبأس إذا انتقدته","لم يزد أجبن ولا ضنينا",40,"ن",2,0],["فِي الْجُمْعَةِ الْخُلْفُ فَشا هَلْ تَجِبُ","فِي زَمَنِ الْغَيْبَةِ أَوْ بَلْ تُنْدَبُ",41,"ب",1,1],["في الجزء في ثانيه أو في الرابع","أو خامس يليه أو في السابع",42,"ع",1,0],["في الجبّ إذ يحوي سميَّكَ أسوةٌ","لو حُمَّ منك وقد حُجِبتَ لقاء",43,"ا",2,0],["في الجِدِّ إِذ جدَّ شياحي وإِذ","أَصواتُ يَومِ الجَمعِ لم تَصحلِ",44,"ل",1,0],["فَيا لِجُنودٍ ضَيَّعَتها مُلوكُها","وَيا لِمُلوكٍ أَسلَمَتها جُنودُها",45,"د",3,0],["في الجو تحسبهن من","بعض الكواكب والبدور",46,"ر",1,0],["في الجر فاشربه فما في شربه","بأسٌ عليك أراهُ في الآراء",47,"ا",2,0],["في الجنَّة يولى انسه","صَلَّينا عليه",48,"ل",3,0],["في الجرم والمعنى لهم واحد","بينهما الرحمن قد قسما",49,"م",2,0],["في الجانِبِ الغَربِيِّ لِلوادي وَها","ذا النَهرُ يَجري تَحتَها يَتَدَفَّقُ",50,"ق",1,0],["فيا لجسم على صدر النبي ربي","توزعته المواضي من أعاديه",51,"ي",2,0],["فيا لجمالها وأنا محبٌ","ويا لهنائها وأنا سعيد",52,"د",1,0],["في الجسم حمّى قد هدّت الجسما","لها لهيبٌ يبخّر العظما",53,"م",2,1],["في الجو تلك قضت وهذي في الثرى","شتان بين قبورها شتان",54,"ن",1,0],["في الجو حق وديع الطير منتقص","وللكواسر حق غير منقص",55,"ص",1,0],["في الجو تخبط حائرا قلقا","وتدير طرف العاشق الومق",56,"ق",1,0],["في الجاهلية وَالتأديب في اليتم","فَبَينَما هام غيري في تشببه",57,"ه",1,0],["في الجسم واللون حكيت البدرا","فهل تعد مثل هذا فخرا",58,"ر",2,0],["فيا لجريح ظل ينكأ جرحه","ويؤذى بلا ذنب على أعين الناس",59,"س",1,0],["في الجامع الكبير ايام الهشام","وعنده يعطي الاجور بالتمام",60,"م",1,0],["في الجيرةِ الغادينَ جاريةٌ","لا الحليُ زينها ولا العَطَلُ",61,"ل",1,0],["في الجيدِ مِنها طُولٌ إذا التَفت","وفي خُطَاها إذا خَطَت قِصَرُ",62,"ر",1,0],["في الجاهِلِيَّةِ فَضلُه ما فَضله","عريان لَيسَ يغمُّهُ مَن يُحسَدُ",63,"د",1,0],["في الجاهليِة سادوا العالمينَ فهم","لأحمدٍ ولدينِ اللهِ أن