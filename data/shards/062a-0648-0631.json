,""],[4882,"سمّي العراقَ اذا ما اصْلحتْ ذِمما-بهاء الدين الخاق","https://www.poetsgate.com/ViewPoem.aspx?id=11522",""],[4994,"رحيل رجل يشبهني","https://www.poetsgate.com/ViewPoem.aspx?id=208925",""],[5277,"نديانةُ العبق","https://www.poetsgate.com/ViewPoem.aspx?id=197752",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5410,"ولادة","https://www.poetsgate.com/ViewPoem.aspx?id=141277",""],[5431,"كافكا والكابوس الوجودي المرعب....","https://www.poetsgate.com/ViewPoem.aspx?id=199352",""],[5431,"فإنّ الناس كلّهمُ طغاةُ!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200427",""],[5431,"بكف الله ممزوجا بلوني....","https://www.poetsgate.com/ViewPoem.aspx?id=200700",""],[5431,"حب بدائي...","https://www.poetsgate.com/ViewPoem.aspx?id=215203",""],[5459,"تذَكَّرْ..","https://www.poetsgate.com/ViewPoem.aspx?id=202105",""],[5467,"َبَلاَءُ الحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=199827",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[1547,"بروق الغوادي أم بروق المباسم","https://www.poetsgate.com/ViewPoem.aspx?id=17079",""],[5829,"تؤرقني زكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155355",""],[5937,"طَلْقَة","https://www.poetsgate.com/ViewPoem.aspx?id=211807",""],[5957,"وجدتُ الحب","https://www.poetsgate.com/ViewPoem.aspx?id=22601",""],[5969,"مؤامرة","https://www.poetsgate.com/ViewPoem.aspx?id=205051",""],[6114,"ما الحسنُ إلا بطَرْفٍ أحرزَ الدَّعَجا","https://www.poetsgate.com/ViewPoem.aspx?id=120391",""],[6183,"سُدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79863&r=&rc=53",""],[1583,"أنامل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73062&r=&rc=19",""],[6229,"في سكون الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65187&r=&rc=13",""],[6320,"صُرُوفُ الدَّهْر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84358&r=&rc=55",""]],"verses":[["تَوَرَّدَ ذِكري كُلَّ نَجدٍ وَغائِرِ","وَأَلجَمَ خَوفي كُلَّ باغٍ وَظالِمِ",0,"م",1,0],["تَوَرَّدَها قَومٌ فَطاحوا جَهالَةً","وَكانَ عِقالُ المَرءِ عَنهُنَّ عَقلُهُ",1,"ل",2,0],["تَوَرَّثتَ مِن دودانَ مَجداً وَسؤدُداً","وَلَستَ كَمَن يَغبى بِغَيرِ لُصوقِ",2,"ق",1,0],["تَوَرَّعتُ أَن أَغتابَهُ مِن وَرائِهِ","وَما هُوَ أَن يَغتابَني مُتَوَرِّعُ",3,"ع",1,0],["تَورُّدُ خدَّيْه يذكِّرني الورْدا","ولم أر أحلى منه شكلاً ولا قدَّا",4,"د",2,1],["تُؤَرِّقُني وَقَد أَمسَت بَعيداً","وِأَصحابِي بَعيهم أو تَبالة",5,"ه",1,1],["تَوَرَّدُهُ الوُفودُ مِنَ النَواحي","فَيَرضى راغِبٌ أَو مُستَجيرُ",6,"ر",1,0],["تُؤَرِّقُني إِذا الرُقَباءُ ناموا","أَناةُ الخَطوِ فاتِنَةُ الدَلالِ",7,"ل",1,0],["تَوَرَّدَت وَهيَ مُزوَرٌّ فَرائِصُها","إِلى الشَرايِعِ بِالقودِ المَقاديمِ",8,"م",1,0],["توريد وجنتها إذا","ما لاح تحت نقابها",9,"ب",3,0],["تَوَرَّدْتَه والحِلمُ تحتَ رِواقِه","أسيرُ الحِفاظِ المُرِّ والجَهْلُ مُطلَقُ",10,"ق",1,0],["تَوَرَّدُ في الأجيادِ صَفحَةُ سَيفِهِ","وتنهشُ في الأكباد حيّةُ عامِلِه",11,"ل",2,0],["تُورِدُ المِسْواكَ عذباً خَصِراً","كمُجاجِ النّحلِ قد شِيبَ براح",12,"ح",1,0],["تورّعَ يستهوِي الحُلومَ فأَقبلتْ","جَماهيرُها تستنُّ أَيّانَ يَذهبُ",13,"ب",1,0],["تورّطتِ الممالكُ في الخطايا","ونِيطَ بكم جزاءُ الخاطئينا",14,"ن",2,0],["تَورَّعَ عنها مُؤمنٌ ليسَ دينهُ","كدينِ حُبابٍ إنّه كان غاويا",15,"ي",2,0],["تَورَّدَ جوْفَهُ فجَرى نجيعا","وجاء أخوهُ يلتمسُ القَريعا",16,"ع",2,0],["تَوَرَّعَ مَعْشَرٌ مِنْهُمْ وَعُدُّوا","مِنَ الزُّهَّادِ وَالمُتَوَرِّعِينا",17,"ن",2,0],["تورّعتَ عن دنياكَ وهي غَريرةٌ","لها مبسِمٌ بَردٌ وفرعٌ جُثاجِث",18,"ث",1,0],["تَوَرَّدوا النَقعَ لا حَيدٌ وَلا كَشَفٌ","وَباشَروا المَوتَ لا مَيلٌ وَلا عُزُلُ",19,"ل",1,0],["تُوُرَّثنَ مِن أَزمانِ يَومِ حَليمَةٍ","إِلى اليَومِ قَد جُرِّبنَ كُلَّ التَجارِبِ",20,"ب",1,0],["تَوَرَّعوا يا بَني حَوّاءَ عَن كَذِبٍ","فَما لَكُم عِندَ رَبٍّ صاغَكُم خَطَرُ",21,"ر",1,1],["تُوَرّي عنكَ أَلْسِنَةُ اللّيالي","كأنّكَ في ضمائِرهَا اعتِقادُ",22,"د",1,0],["تَوَرِّعُهُ الأَهْوَالُ مِنْ دُونِ هَمِّهِ","كَمَا وَرَّعَ الرَّاعِي الفَنِيقَ المُسَدَّمَا",23,"م",2,0],["تورِي نَوَاظِرُهَا اللَّظَى","وَتَسِيلُ مِنْ فَمِهَا الحُمَمْ",24,"م",1,0],["تُؤَرِّقُني ذِكرى لَهُ وَصَبابَةٌ","وَتَجذُبُني شَوقاً إِلَيهِ الجَواذِبُ",25,"ب",1,0],["تؤرثُ في قلب الجبانِ تشَجعا","ويزدادُ قلبُ الشخص منها تَعَلُّمَا",26,"م",2,0],["تَوْريدُ وَرْدِ الخَدِّ أَلْبَسَ أَدْمُعي","لَمَّا اسْتَهَلَّتْ حُلَّةَ التَّوريدِ",27,"د",1,1],["تؤرّقني أطيافُ ذكراه سحرةً","بروع كأهوال الخطوب الطوارق",28,"ق",1,0],["تؤرِّقني الذّكرى القديمةُ في النّوى","وعِندي إِلى العَلياءِ شوقٌ ومَطمَح",29,"ح",1,0],["تَوَرّسَ مَا تَعْطُو بِهِ مِنْ عَبِيطِهِ","كَمَا طَلَعَ السّوسَانُ فِي صِبْغَةِ الحُصِّ",30,"ص",1,0],["تَوَرَّدَت وَجنَتاهُ","وَالطَرفُ فيهِ مُنَرجَس",31,"س",1,0],["تؤرِّقُني الذِكرى إذا لاحَ بارِقٌ","يَلوحُ بفَود اللَيل من لمعِه وَخطُ",32,"ط",1,0],["تُؤرّقهُ سودُ الليالي لِيَجتلي","بياضَ المَعاني من صحائف سودِ",33,"د",1,0],["تورّد أَدمُعي كَلفاً","بِرَونَق وَردة الخَجَل",34,"ل",1,0],["تَوريد دَمعي كُل يَو","م مِن تَورّد وَجنَتيهِ",35,"ي",2,0],["تورَّد الدَمع مِن تَوريد وَجنَتِهِ","وَرَقّ جِسمي ضَناً مِن فَرط قسوَتِهِ",36,"ت",2,1],["تورث الأحزان في الدنيا وفي","حشرنا والقبر توجب للنكال",37,"ل",1,0],["تُورِثُ القلبَ التهاباً والحشا","حُرَقاً والدَّمع مجرًى ومسيلا",38,"ل",2,0],["تَورَّث علمَهم قَمَرُ الفتاوى","وشمسٌ ما لها أبداً مغيب",39,"ب",1,0],["تورى زنادَ اشتياقٍ ما استطارَ به","لي من مَشِيبي ولكن أَدْمُعِي شَرَرُ",40,"ر",1,0],["توراة موسى على التفضيل شاهدة","له وإنجيل عيسى وهو ناعته",41,"ت",2,0],["تورّطتَه خائضاً نقعَه","بما شاء أبطالُه تُجدَلُ",42,"ل",1,0],["تورَّطْها فإما نلت خيراً","فسعيٌ وافق القدَر المسوقا",43,"ق",2,0],["تورَث فيهم فأنت ينقُلك ال","ميراثُ من كابرٍ إلى كابرْ",44,"ر",1,0],["تؤرَّقُني تلكَ البروقُ كأنَّها","قواضبُ شيمتْ والسحابُ غمودُها",45,"د",3,0],["تُؤرَّقُه تحتَ الظلامِ حمامةٌ","يُهَيَّجها بانُ الحمى وخمائلُه",46,"ل",2,0],["تُؤرَّقها قمريَّةٌ فوقَ بانةٍ","تُداعي هديلاً عندها فيُجيبُ",47,"ب",1,0],["تَوريدُ دَمعي مِن خَدَّيكَ مُختَلسُ","وَسُقمِ جِسمي مِن جَفنَيكَ مُستَرقُ",48,"ق",1,0],["تورّث كلَّ فخرٍ من أبيه","وكلَّ تُقىً وفضلٍ واِمتنانِ",49,"ن",1,0],["تؤرّقُنا ذوائِبُها ولَسنا","نرى لدُجى لياليها قُصارى",50,"ر",2,0],["تَوَرُّدُ وَجْنَةٍ وَفُتُورُ لَحْظٍ","تُمَرِّضُهُ وَأَعْطَافٌ تَمِيْسُ",51,"س",1,0],["تَوْرِيْدُ خَدِّكِ للصِّبَابَةِ مَوْرِدٌ","وَفُتُوْرُ طَرْفِكِ للنُّفُوْس فُتُوْنُ",52,"ن",1,0],["تورَّعُوا بعد ما طال الحزينُ بهم","وكادَ ضاحي مُلاءِ القَزِّ يحترق",53,"ق",1,0],["تَوْرِيدُ خَدِّكِ مُورِدُ الأهْوَا كَمَا","فتاكُ طرفكِ لِلْوَرَى فَتَّاُن",54,"ن",1,0],["تورث الشرب نشطة وفتوراً","وافراً في نفوسهم والعظامِ",55,"م",1,0],["تورّعاً من أن يُرى ظالماً","تورّعَ الكافي أبي النّقص",56,"ص",1,0],["تُؤرقني تحرِّقني","تُعرقني تُغرقني",57,"ن",2,0],["تَوَرّط مِنها نِعمَةً طَمَحَت بِهِ","فَما لَبِثت أَن أَعقَبَته زَوالَها",58,"ه",2,0],["تُؤَرِّقُ وُرقُ الغوطَتَينِ لَواحِظي","وَيُنحِلُ جِسمي حُبُّ غُزلانَ جاسِمِ",59,"م",1,0],["توَرَّثتَها من أبٍ ماجدٍ","تورَّثَها من أبٍ مفنَع",60,"ع",1,0],["تؤرَّخ قل لبدر بني حبيشٍ","لويس سرى لفردوس القدير",61,"ر",1,0],["توراة موسى أتت عنه فصدّقها","إنجي عيسى بحق غير مفتعِل",62,"ل",1,0],["تؤرج أرجاء السلام إذا سرت","بسيرتهم في الأرض ريح شمال",63,"ل",1,0],["تُؤَرِّثُها أُمُّ البَنينَ لِطارِقٍ","عَشِيَّ السُرى بَعدَ المَنامِ طَروقُ",64,"ق",1,0],["تَوراتُها لَوحُ ساقَيها سَناً وَأَنا","أَتلو وَأَدرُسُها كَأَنَّني موسى",65,"س",2,0],["تَوَرَّمَ مِن سَقامٍ جانِباهُ","وَهامَ بِلَذَّةِ الكَسبِ الحَرامِ",66,"م",1,0],["تؤرقه بكر العلوم وكم فتى","لبكر الغواني بات صباً مؤرقا",67,"ق",2,0],["تورق فيهُم عَذبات لِلعُلا","بِحَيث لَولاهُم رمت أَوراقَها",68,"ق",3,0],["تَورث العلم مِن آبائه فَضفت","عَلَيهِ درع علاً مَحبوكة حَلقا",69,"ق",2,0],["تورث مِن أَهليه ثَوب رِياسة","بِهِ لخلوق المكرمات ردوع",70,"ع",1,0],["تورث من عليا أبيه خلافة","وليس لغير الابن ما خلف الأب",71,"ب",1,0],["تَوراةُ موسى وَإِنجيلُ المَسيحِ وَما","لِأَحمَدٍ مِن بَيانِ الذِكرِ فُرقانا",72,"ن",2,0],["توردت وجنتاه من خجل","وقال: قبلتني على عجل",73,"ل",1,1],["تؤرقني لمياء في كل ليلة","بصوت له تحت الظلام زفير",74,"ر",1,0],["توران قل جبل وطاجو مثله","والكز قل جبل على بسطامة",75,"ه",1,0],["توريه جمرة خده","فيفوح منه شذا المجامر",76,"ر",1,0],["تورثها لآباء كِرام","وَطيب عَناصر وَزكاء خيم",77,"م",1,0],["تورث مَجدكم من آل فَخر","جَهابذة غَطارفة كِرام",78,"م",1,0],["تورثها عَن ضيغم نَجل ضَيغم","وَعَن فتية حازوا السَخاوة وَالتُقى",79,"ق",2,0],["تورثتها عَن كابر بَعد كابر","فَسارَت بِها ريح الصبا وَقُبول",80,"ل",1,0],["تُورد المرءَ فِي المهالك عَسْفاً","عِيسُها الجهلُ والغُرور مُناها",81,"ا",3,0],["تورع إن الورع أعظم بانها","وأولى بها حقيقا أهل الحقيقة",82,"ه",1,0],["توردي العزّ واِتركي بلداً","تظما بجنب الحياض موردها",83,"د",3,0],["تُؤَرِّشُ ما بيني وبين معرِّضٍ","لأَقطعه وهو النخاع من الظهرِ",84,"ر",1,0],["تَوراةُ مُوسى انبأَت","عنها وسائرُ انبيائِك",85,"ك",1,0],["تؤر كأفواج الدخان تطلعت","الى علو من قاصي قرار جهنم",86,"م",1,0],["توراة موسى وانجيل المسيح بها","وصحف أحمد والألواح والزبر",87,"ر",1,0],["تورث علياءه عن أبيه","ففاق الورى شرفاً وافتخارا",88,"ر",2,0],["تُؤَرِّقُني الهُمومُ وَأَنتَ خِلوٌ","لَعَمرُكَ ما تُؤَرِّقُكَ الهُمومُ",89,"م",1,0],["تورك منكب العلياء واصدع","بما تهوى السراة بلا تماد",90,"د",1,0],["تورّين أم تورين نار صبابتي","تراكم هذا الشك فيك فصارحي",91,"ح",2,0],["تؤَرِّقُنِي بعدَ العشاءِ همومُ","كأني لما بين الضلوعِ سقيمُ",92,"م",1,1],["توركتما يا سيدي كلاكما","شوارف مجد لم يزلن هجانا",93,"ن",2,0],["توركتماها واجديها نواعماً","إذا ما رآها الناكصون خشانا",93,"ن",2,0],["تؤرق في مناحتها الشجيا","عداها الغمض كم طفقت عشيا",94,"ي",2,0],["تورث علماً من الأنبياء","فكان إماماً بشيراً نذيرا",95,"ر",2,0],["تورِثُ تعبيساً لمن باسَها","وهيَ على ذلكَ مشكورَهْ",96,"ر",2,0],["تُؤرِّجَ أَرجاءَ الرضاءِ كأَنّما","تجاملُ في حملِ التّحيةِ عن جُمْلِ",97,"ل",1,0],["تورَّك في حجر السيادة ناشئا","على حسن خلق توِّج الحسن احسانا",98,"ن",2,0],["توري لنا قبسات","يطير عنها شرار",99,"ر",1,0],["تورِّث علمهم قمر الفتاوى","وجودهم تورِّثه النقيب",100,"ب",1,0],["تورِّثه رقيقا عن أبيه","فحرَّر فيه رق حديث جده",101,"د",2,0],["تورد دمعي إذ جرى ومدامتي","فمن مثل ما في الكأس عيني تسكب",102,"ب",1,1],["تَوَرَّمَت أَقدَامُ رُوحِي.. وما","يَزَالُ مَا أَجنِيهِ \"صَحَّ اللِّسَانْ\"",103,"ن",1,0],["توردني المنايا حين تامر","ولاجلك يحلى في عيني اعتقالي",104,"ل",2,0],["تورد نور ٍ فيك أو ورد روضة ٍ","أِذا هي