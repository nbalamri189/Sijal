ry.dctabudhabi.ae/diwan/poem/105494","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83199","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83187","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83198","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33162","الخفيف"],[5050,"إن جاء نصر الله والفتح","https://www.poetsgate.com/ViewPoem.aspx?id=38195",""],[5060,"ابن المجاز","https://www.poetsgate.com/ViewPoem.aspx?id=214493",""],[5122,"(( لا حرزت راحه ولا مربح أحرزت ))","https://www.poetsgate.com/ViewPoem.aspx?id=26734",""],[5135,"العيد ووسائل التواصل الاجتماعي","https://www.poetsgate.com/ViewPoem.aspx?id=201842",""],[5206,"حياة الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=187335",""],[5213,"يا دار يومك بالغميم محجل","https://www.poetsgate.com/ViewPoem.aspx?id=170533",""],[5213,"أعرّست على العذيب العرب","https://www.poetsgate.com/ViewPoem.aspx?id=170410",""],[5237,"إن شئت عيشا هنيا واتباع هدى","https://www.poetsgate.com/ViewPoem.aspx?id=113119",""],[5277,"زهرةُ المورينگا...","https://www.poetsgate.com/ViewPoem.aspx?id=202272",""],[5358,"يا أم سالم","https://www.poetsgate.com/ViewPoem.aspx?id=202449",""],[5409,"أضحكتنا ورب ضحكٍ بكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155244",""],[5525,"الغراب اللي نعق","https://www.poetsgate.com/ViewPoem.aspx?id=7210",""],[5561,"نجمة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=193221",""],[5725,"جحر ضب","https://www.poetsgate.com/ViewPoem.aspx?id=187234",""],[5751,"مَعارجُ الصعيد","https://www.poetsgate.com/ViewPoem.aspx?id=214714",""],[5756,"الدعاء المستجاب","https://www.poetsgate.com/ViewPoem.aspx?id=5381",""],[6069,"ومجدرٍ عذبت مراشف ثغره","https://www.poetsgate.com/ViewPoem.aspx?id=105708",""],[6102,"تحذير ..","https://www.poetsgate.com/ViewPoem.aspx?id=183311",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[1546,"مرحباً بالخليل فالشوفُ يختالُ","https://diwany.org/%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B-%D8%A8%D8%A7%D9%84%D8%AE%D9%84%D9%8A%D9%84-%D9%81%D8%A7%D9%84%D8%B4%D9%88%D9%81%D9%8F-%D9%8A%D8%AE%D8%AA%D8%A7%D9%84%D9%8F/","الخفيف"],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["وكثّرَ منْ حُسّادِكَ اللّهُ إنّهُ","إنِ اللّهُ أنْمى خيْرَهُ لكَ تُحْسَدِ",0,"د",1,0],["وَكَثِيبٍ سَقَاهُ مِنْ زَادٍ سَفْرٍ","رَشْحُ مَاءٍ فَبشَّ فِيهِ الثُّمَامُ",1,"م",1,0],["وَكَثيرَةٍ غُرَبائُها مَجهولَةٍ","تُرجى نَوافِلُها وَيُخشى ذامُها",2,"م",3,0],["وَكَثيرٌ مِنَ الرِجالِ حَديدٌ","وَكَثيرٌ مِنَ القُلوبِ صُخورُ",3,"ر",1,0],["وكثرت عنديَ ما أشتهي","فالتين من فوقِي ومن تحتي",4,"ي",1,0],["وكثَّفتْ دون الغنى سدَّها","حتّى كأنِّي كنتُ كثَّفْتُها",5,"ت",3,0],["وكثيراً ما كان يفعل ما يح","سن من غير أن يقدّم وعدا",6,"د",2,0],["وكثَّر اللَّهُ من فتاك أبي","إسحاقَ في ظلِّ نعمةٍ عَدَدكْ",7,"ك",1,0],["وكثرةِ ناسليكَ لقد أرانا","سُقوطَك قِلةُ المُتنازِعيكا",8,"ك",2,0],["وكثيراً يُمْنَى بأمثالها البس","تان ما لم يُحصَّنِ البستانُ",9,"ن",1,0],["وكثر الليل عنذ","الانياب كالمغاضب",10,"ب",1,0],["وَكَثُر القَتلى وَراحَ الأَسرى","عَلى فَوات الوَفَياتِ حَسرى",11,"ر",2,0],["وَكَثرَةِ الناقِلِ وَالمُعَرِّبِ","عَن حِكمَةِ الفُرسِ وَعِلم المَغرِبِ",11,"ب",1,0],["وَكَثيرٌ مِنَ السُؤالِ اِشتِياقٌ","وَكَثيرٌ مِن رَدِّهِ تَعليلُ",12,"ل",1,0],["وكثيرة الأحداق إلا أنها","عمياء ما لم تنغمس في ماء",13,"ا",2,1],["وَكَثيرَ عَزَّةَ يَومَ بَينٍ يَنسُبُ","وَاِبنَ المُقَفَّعِ في اليَتيمَةِ يُسهِبُ",14,"ب",1,0],["وَكَثرَةِ دَمعِ العَينِ حَتّى لَوَ أَنَّني","يَراني عَدُوٌّ شامِتٌ لَتَحَوَّبا",15,"ب",2,0],["وَكَثرَةِ دَمعِ العَينِ حَتّى لَو أَنَّني","يَراني عَدُوٌّ كاشِحٌ لَتَحَوَّبا",16,"ب",2,0],["وَكَثُرَت حِدَّتُهُ وَضَجَرُه","وَصارَ كَالحُمّى يَطيرُ شَرَرُه",17,"ه",1,0],["وَكَثرَةُ المالِ شُغلٌ زادَ في نَصَبٍ","وَقِلَّةٌ مِنهُ مَعدولٌ بِها الفَلتُ",18,"ت",1,0],["وَكَثيرٌ لَهُ إِذا قيسَتِ الأَش","ياءُ عَظمٌ يَرميهِ بَعضُ طُهاتِه",19,"ت",2,0],["وَكَثرَةُ القَولِ دَلَّت أَنَّ صاحِبَها","أَلغى وَبَذَّر فَاِهجُر وَاِتَّقِ البُذُرا",20,"ر",2,0],["وَكَثرَةُ المالِ ساقَت لِلفَتى أَشَراً","كَالذَيلِ عَثَّرَ عِندَ المَشيِ ضافيهِ",21,"ف",3,0],["وَكَثِيرٌ مِنَ الخِلاَ","لِ إِذَا حُقِّقَ اخْتَلَفْ",22,"ف",1,0],["وَكَثِيبُ حُلْوَى تَشْتَهِيه","لِحُسْنِ مَنْظَرِهِ الحَدَقْ",23,"ق",1,1],["وَكَثيرُهُمْ مُسْتَهْزيءٌ","وَقَليلُهُمْ إِنْ بَرَّ زَاجرْ",24,"ر",1,0],["وكثرت دعوى الهوى فيهمِ","وحبّذا لو صحّ ما يدعون",25,"ن",1,0],["وكثر من حسادك الله إنه","إن الله أنمى خيره إليك تحسد",26,"د",1,0],["وكثيرة غرباؤها مجهولة","ترجى نوافلها ويخشى ذامها",27,"م",3,0],["وكثيراً ما سرَّه أنَّه بات","جريحاً ورأسًه مشجوب",28,"ب",1,0],["وَكَثِيباً وبَانَةً وقَنَاةً","ومَهَاةً وخَيرُ زَاناً وَرِيمَا",29,"م",2,0],["وكثرةُ المصائبِ","وقلةُ الحبائبِ",30,"ب",1,0],["وَكَثيرَةِ الأَمثالِ إِلّا أَنَّها","في ذا الزَمانِ قَليلَةُ الأَمثالِ",31,"ل",1,0],["وَكُثرُ سِوانا لَيسَ يَعشُر قُلَّنا","وَلَن تُلفي النُظّارُ في الكُتبِ مِثلَنا",32,"ن",2,0],["وكثرة من يدعى على كبد يداً","وينشد قلبا بين جنبيه ضايعا",33,"ع",2,0],["وكثيرُ عَقْلي فرَّ مُضْطَرِبًا","والقلبُ طَوْعًا لِلهَوى خَضَعا",34,"ع",2,0],["وَكثّرَ فيهِ النقلَ من دون حاجةٍ","لِيثبتَ في دعواهُ بالكبرِ الكبرا",35,"ر",2,0],["وكثرة اشواقي اليك ابثها","وما لي وذكر اها وانت بها تدري",36,"ر",2,0],["وَكَثيرُ صَبري في هَوا","كَ إِذا بَعُدت فَما أَقَلَّه",37,"ل",2,0],["وكثيرةَ الفتكاتِ في ألحاظِها","وشديدةَ الحُجَّابِ والحُرَّاسِ",38,"س",1,0],["وَكثنَّا كَزَوجٍ مِن قَطَا في مَفَازَةٍ","لَدَى خَفضِ عَيشٍ ناعِمٍ مُونِقٍ رَغدِ",39,"د",1,1],["وكثرةُ التعهُّدِ","لهم بِكُلِّ معهدِ",40,"د",1,0],["وكثِّرْ قلائلَ إحسانِه","ومهما أساءَ فَلقِّنْه عُذرا",41,"ر",2,0],["وَكَثيرٌ وَالخَيرُ فيهِم كَثيرٌ","ثُمَّ لا خَيرَ بَعدَهُم في كَثيرِ",42,"ر",1,0],["وكثبانٌ ترجْرجَ في مُروطٍ","وقضبانٌ ترنّحُ في بُرودِ",43,"د",1,0],["وكُثِّرتَ بالأولادِ تُرهِف مُنصُلاً","طريراً إلى الدنيا وتَطبعُ مُنصُلا",44,"ل",2,0],["وكثبان مسك نبتها الزعفران وال","حصا ان ترد دُرّا وان شئت جوهرا",45,"ر",2,0],["وكثيرٌ من أمَّهُ فثناهُ","زاهداً في اللُهى ولا مثل زهدي",46,"د",2,0],["وكثرة الاطماع آفات البشر","وفي تصاريف الليالي معتبر",47,"ر",1,0],["وكثنْ ناصِراً في كُ","لّ إبْطائِي وإسْراعِي",48,"ع",2,0],["وكثيراً فإذا اِستَنْ","صرتَهُ عاد قليلا",49,"ل",2,0],["وكثيرُ ما قمنا به","في جَنبِ حقّك مُستَقَلُّ",50,"ل",1,0],["وكثير القول يكثر من","مثله الزلات والسقط",51,"ط",1,0],["وكثير وبعضنا غير بعض","في ثياب اللاهوت والناسوت",52,"ت",1,0],["وكثير من أمة الخير كانوا","بهوى الحسن في فؤاد طروب",53,"ب",1,0],["وَكَثرَةَ التَخبيرِ عَن شُقوري","وَهَل يَرُدُّ ما خَلا تَخبيري",54,"ر",2,0],["وَكَثِيْرٌ مَا قَلَّ عِنْدَكَ عِنْدِي","إِذْ حَبَانِي بِهَا رَئِيْسٌ عَظِيْمُ",55,"م",1,0],["وَكَثِيْرَةِ النَّغَمَاتِ تَحْسَبُهَا","فِي كُلِّ عُضْوٍ أُوتِيَتْ حَلْقَا",56,"ق",2,1],["وَكَثيرٌ حياؤُه والعَطَايا","يَتَبَرَّجْن مِنْهُ للخطَّابِ",57,"ب",1,0],["وكثَّروا ذمِّي وساداتُهم","تقِلُّ عن حَمدِي وعَنْ ذَمِّي",58,"م",2,0],["وكثر عندي قليلو","واستقليت فيه ذنوبي",59,"ي",1,0],["وكثر صهيل الصافنات كأنها","على أهلها من قلة المكث تعتب",60,"ب",1,0],["وَكَثرَةُ العَيشِ في كَدحٍ وفي نصَبٍ","مكثاً وَفَوقَ مُتونِ الأيْنُق الذُّللِ",61,"ل",1,0],["وَكَثيرَةٌ وَغَزيرَةٌ","إِذ أرِّخَت خِبراتُها",62,"ه",2,0],["وَكَثرَ الصِياحُ وَالعياطُ","وَهَلَكَت بَينهما الضُبّاطُ",63,"ط",1,0],["وَكَثر القالُ وَشاعَ اللَغطُ","وَالناس فيهِ اِرتَبَكوا وَاِختَبَطوا",64,"ط",3,0],["وَكُثْبَانُ نَجْدٍ وَالْجِبَالُ الشَّوَاهِقُ","عَوَارِفُهُ مَشْهُورَةٌ وَالْحَقَائِقُ",65,"ق",1,0],["وَكَثير من المُلوك سواه","ذو اِجتهاد لكن أَينَ الاصابه",66,"ب",2,0],["وَكَثرة التَّحلي","تَدعو إِلى التَّسلي",67,"ي",1,0],["وكثر أسمائك عجل المدد","والنصر والتفريج والفتح القريب",68,"ب",1,0],["وكُثْرُ المَعَالِي إِذِ المَجْدُ نَزْرٌ","إِذَا زَهْرَةُ الْحَمْدِ أَعْلَتْ فَخَارَا",69,"ر",2,0],["وكثيرين قد أفاقوا حيارى","ما لهم ملجأ ولا مستقر",70,"ر",1,0],["وَكَثيرَةُ العَبراتِ جلُّ بُكائِها","خطبٌ إِلَيهِ نَفسُها تَتَطَلَّعُ",71,"ع",1,0],["وكثيرٌ من يُحسنُ النظمَ فينا","إنما الشعرُ في الكثيرِ قليل",72,"ل",1,0],["وكُثِّرَ حَشْوُ ما ذَكَرَا ولمَّا","يُصيبا مقتلاً للآفكينا",73,"ن",2,0],["وَكَثِّر بِعِقدِ الدُرِّ فيكَ حَواسِدي","لِيَهلِكن غَيظاً حينَ يامَعُ في صَدري",74,"ر",2,0],["وَكَثُرَت مِن بَعدِهِ الأَحزابُ","وَنَصَبوا بَعلَهُمُ وَعابوا",75,"ب",3,0],["وكثرته واجعلنّ البركه","فيه لدى سكونه والحركه",76,"ه",1,0],["وكثير ما يهتم فيها الناس في","السفر الجليلة في لقا الأضياف",77,"ف",1,0],["وكثر اللَه هداة الامه","ففيهم تكشف عنا الغمه",78,"ه",1,0],["وكثيرٌ قال لا شيء ومن","أثبت الملك بلا وطءٍ قصد",79,"د",1,0],["وَكَثَّرت حُسّادي وَثَمَّرتَ نِعمَتي","وَذَلَّلتِ لِي دَهرِي وَأَوضَحتَ لي رُشدي",80,"د",2,0],["وكثر الخير لدي","نا جوده والممنا",81,"ن",2,0],["وكثرة القبض بها القبح انجلى","والثرم والثلم عليه دخلا",82,"ل",2,0],["وكثير من فرط عشقه عزّة","ذاق العنا ولقد أباد جميلا",83,"ل",2,0],["وَكثرَةٍ الجَربُوبِ وَالطُّيُورِ","والحُوتِ والحَايَة يا نَصيريِ",84,"ي",1,0],["وكثر بكاي","وظهر بلاي",85,"ي",1,0],["وكثيرٌ مِنّي على شيبِ رأسي","حِفظُ هذي الأشياءِ مثلَ الصِّغارِ",86,"ر",1,0],["وكثير فيك أحسدهُ","وكثير فيك يحسدني",87,"ن",2,0],["وَكَثيرٌ مِمَّ تُقَصِّرُ عَنهُ","حَدسَةُ الناظِرِ الَّذي لا يَحارُ",88,"ر",1,0],["وكثيرٌ من الاشارةِ يَغتا","لُ مُعَادَ الحَديثِ بالتَّحريفِ",89,"ف",1,0],["وكثرتَ إخواني وكنتُ مسافراً","غريبَ الهَوى في بلدتي وأقارِبي",90,"ب",2,0],["وكثر ولا تفشل وتلل كثير ما","فعلت فسماء المزن جم وينضب",91,"ب",1,0],["وَكَثيرُ مائِكَ في وُضوئِكَ بِدعَةٌ","يَدعو إِلى الوَسواسِ وَالهملان",92,"ن",1,0],["وَكَثرَة أَشواقٍ إِذا رُمت حَصرَها","أَرى بَعضَها يَربُو عَلى الحَدِّ وَالعَدِّ",93,"د",1,0],["وكثرة التعهد","لها بكل معهد",94,"د",1,0],["وكثِّرنْ بلادنا في الغيبِ","ولتصرفنْ عنها به للغيب",95,"ب",1,0],["وكثِّرنّي ظاهراً وباطنا","وقلِّلَنْ عدوّي حيث كائنا",96,"ن",2,0],["وكثِّرِ المرعى وباركْ فيهِ","وما لنا فباركنْ عليهِ",97,"ه",1,0],["وكثير العلم وهباً","ورسيل الموهبات",98,"ت",1,0],["وكثِّرَنَّ ربي بالعطاءِ","ووالِنا بالشكر للآلاءِ",99,"ا",2,0],["وكثِّر لمجدي يا مجيد لدى العلى","وفي الشُّغل عند الحاضرين وذي سفرِ",100,"ر",1,0],["وكثرة العتاب بغضاً أورثتْ","وقل كما تزرع تحصد ثبتْ",101,"ت",1,0],["وكثرة الضَّحْكِ يقال تُذهبُ","بهيبةٍ وذاك فيه عطبُ",101,"ب",1,0],["وكثر الجار لنا بالعافيات","وكثر الزوجات واجعل صالحاتْ",102,"ت",1,0],["وكثِّر الأولاد لي والبناتْ","وانصر لنا أحسن نصر الكائناتْ",102,"ت",1,0],["وكثِّر الإماء والعبيدا","وكثِّر الأموال والتلميذا",102,"ذ",2,0],["وكثرة الفكرة والذهول","ومسمع قد كل من عذول",103,"ل",1,0],["وكثرة الكلام ليست تجدى","لو لم يكن يقبح بالتصريح",103,"ح",1,0],["وكثير الأعداء مثل قليلٍ","إنما النصر في حراب الصعاد",104,"د",1,0],["وكثيبُ الرَّملِ قد أَخجلَهُ","وقضيبُ البانِ رِدفاً وقَواما",105,"م",2,0],["وكثر فيك أعدائي ولكن","غداة نأيت قل به عديدي",106,"د",2,0],["وَكَثِّرِ الأَيدي عَلى الطَعامِ","فَإِنَّهُ مِن خُلُقِ الكِرامِ",107,"م",1,0],["وَكَثرَةُ الوِصالِ","داعِيَةُ المَلالِ",108,"ل",1,0],["وَكَثُر اللئامُ","وَقَلَّت الكِرامُ",109,"م",1,0],["وكثيبي نقاً وللجيدِ والطر","فِ غزالاً أغنَّ ربيبا",110,"ب",2,0],["وكثر الخير لدى أهلها","وزادت الأرزاق والربح",111,"ح",1,0],["وكثّفِ العشقَ فالأبياتُ شاردةٌ","باللّازَوَرْدِ وبالجفْنَيْنِ إنْ نَطَقا",112,"ق",2,0],["وكثر الوحل في سكتي لين غرزت","في رمل صحراء في الديار خليه",113,"ي",2,0],["وكَثَّرُوْها بِزَعْمً الْوَصْلِ واأسفا","فَرَسَّخَتْ بَيْنَ أَهْلِ الْبَيْتِ هُجْرَانَا",114,"ن",2,0],["وَكَثَايِفُ الأَغيَارِ عَنْ تَحقِيقِهِ","حُجُبٌ بِهَا حُجِبَ الجَهُولُ النَّاكِسُ",115,"س",1,0],["وكثيب رمل سبب فوق تلاعه","شعر يزين المتن منك مرجل",116,"ل",1,0],["وكثب بخد أمت العيس بهم","لا بعدت عن المعنى الكثب",117,"ب",1,0],["وكثرة الحمد من أوصاف أمته","في اليسر والعسر في الكتب العلى وجدا",118,"د",2,0],["وكثيبُ قافيةٍ علا جبلَ السنا","فلذاكَ غابتْ حيرةً كثبانُها",119,"ن",3,0],["وكثيرُ هَمٍّ مَنْ يرى","مَنْ كانَ يطْعَنُهُ طبيبَه",120,"ب",2,0],["وكثيرون لو تطلعت فيهم","كأساقٍ في جوفهن هواء",121,"ا",2,0],["وكثر ما شوه العج الشفق","وقص من جيده عقود العقيق",122,"ق",1,0],["وكثر ما صابني وأخطا التفق","لين ما أصحبت من خوفي طليق",122,"ق",1,0],["وكثر ما نز في كفوفي العرق","من سلام على غير الصديق",122,"ق",1,0],["وكثير جمعنا في ذلةٍ","وتَرَدٍّ وقليل في الفداء",123,"ا",2,0],["وكثيرا نرى المهانة حلما","ماتبعْنا مايبتغي العظماءُ",124,"ا",2,0],["وكثيرُ ما عانيتُ نَجوى عاشقٍ","وصُرِعتُ بالبيضِ الحِسانِ وَسُمْرِهِ",125,"ر",2,0],["وكثر اللي ما بعده عدد.ولا يوصّل له حساب","وكثر اللي ما اعرفه ولا اسمع فيه.ولا راح اسمعه",126,"ع",2,0],["وكثيرة الأحداق تحت وشاحها","شمس الظهيرة في عقود الناظم",127,"م",1,0],["وَ كَثِيرٌ مِنَ الخِيانَةِ تَغفُو","بِعُرَى الحُبِّ فِي ظِلالِ الخَناجِرْ !",128,"ر",1,0],["وَكثر الفَساد بنقطة العز وَالصَفا","وَمِن كُل جيهة الشر غاشي ركونها",129,"ن",3,0],["وَكثر الفَساد بِنقطة العز وَالصَفا","وَصاروا يَروها الناقدين هبال",130,"ل",1,0],["وَكَثير مِمّا وَعى القَلب مغمض","صانَ أَسراره الخِتام فَلا الفض",131,"ض",1,0],["وكثيرٌ من يُحسنُ النٌ علىينا","إنما الشعرُ في الكثيرِ قليل",132,"ل",1,0],["وكُثَيْرٌ وعروةُ ابن حِزام ٍ","في رعيل ٍ مضى من العشاق",133,"ق",1,0]]}