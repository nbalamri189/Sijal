{"poems":[[77,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[93,"فاح ريحانها ولاح الخزام","https://www.aldiwan.net/poem11347.html","الخفيف"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[47,"مغرم مؤلم جريح أسير","https://www.aldiwan.net/poem25262.html","الخفيف"],[72,"جنينة التين وجيرانها","https://www.aldiwan.net/poem18419.html","السريع"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"يا أبا أحمد ومثلك لا يغفل","https://www.aldiwan.net/poem61894.html","الخفيف"],[51,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[51,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[51,"رقعة من معاتب لك ظلت","https://www.aldiwan.net/poem66390.html","الخفيف"],[89,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[85,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[43,"مالنا كلنا جو يا رسول","https://www.aldiwan.net/poem9980.html","الخفيف"],[61,"وكثيرة الأحداق إلا أنها","https://www.aldiwan.net/poem51314.html","الكامل"],[44,"لمكاسر الحسن بن وهب أطيب","https://www.aldiwan.net/poem30585.html","الكامل"],[31,"خليلي عوجا حييا اليوم زينبا ولا","https://www.aldiwan.net/poem42639.html","الطويل"],[40,"خليلي عوجا حييا اليوم زينبا","https://www.aldiwan.net/poem42288.html","الطويل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[46,"إنا حسبنا حسابا لم يصح لنا","https://www.aldiwan.net/poem22146.html","البسيط"],[46,"إنما نحن في ضلال وتعلي","https://www.aldiwan.net/poem22218.html","الخفيف"],[46,"فوارس الدهر جاءت تسبق النذرا","https://www.aldiwan.net/poem22617.html","البسيط"],[46,"الغدر فينا طباع لا ترى أحدا","https://www.aldiwan.net/poem23589.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55035","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55078","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54934","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141925","السريع"],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.poetsgate.com/ViewPoem.aspx?id=33822",""],[4,"معلقة لبيد بن ربيعة العامري","https://www.poetsgate.com/ViewPoem.aspx?id=30298",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""]],"verses":[["وكثّرَ منْ حُسّادِكَ اللّهُ إنّهُ","إنِ اللّهُ أنْمى خيْرَهُ لكَ تُحْسَدِ",0,"د",1,0],["وَكَثِيبٍ سَقَاهُ مِنْ زَادٍ سَفْرٍ","رَشْحُ مَاءٍ فَبشَّ فِيهِ الثُّمَامُ",1,"م",1,0],["وَكَثيرَةٍ غُرَبائُها مَجهولَةٍ","تُرجى نَوافِلُها وَيُخشى ذامُها",2,"م",3,0],["وَكَثيرٌ مِنَ الرِجالِ حَديدٌ","وَكَثيرٌ مِنَ القُلوبِ صُخورُ",3,"ر",1,0],["وكثرت عنديَ ما أشتهي","فالتين من فوقِي ومن تحتي",4,"ي",1,0],["وكثَّفتْ دون الغنى سدَّها","حتّى كأنِّي كنتُ كثَّفْتُها",5,"ت",3,0],["وكثيراً ما كان يفعل ما يح","سن من غير أن يقدّم وعدا",6,"د",2,0],["وكثَّر اللَّهُ من فتاك أبي","إسحاقَ في ظلِّ نعمةٍ عَدَدكْ",7,"ك",1,0],["وكثرةِ ناسليكَ لقد أرانا","سُقوطَك قِلةُ المُتنازِعيكا",8,"ك",2,0],["وكثيراً يُمْنَى بأمثالها البس","تان ما لم يُحصَّنِ البستانُ",9,"ن",1,0],["وكثر الليل عنذ","الانياب كالمغاضب",10,"ب",1,0],["وَكَثُر القَتلى وَراحَ الأَسرى","عَلى فَوات الوَفَياتِ حَسرى",11,"ر",2,0],["وَكَثرَةِ الناقِلِ وَالمُعَرِّبِ","عَن حِكمَةِ الفُرسِ وَعِلم المَغرِبِ",11,"ب",1,0],["وَكَثيرٌ مِنَ السُؤالِ اِشتِياقٌ","وَكَثيرٌ مِن رَدِّهِ تَعليلُ",12,"ل",1,0],["وكثيرة الأحداق إلا أنها","عمياء ما لم تنغمس في ماء",13,"ا",2,1],["وَكَثيرَ عَزَّةَ يَومَ بَينٍ يَنسُبُ","وَاِبنَ المُقَفَّعِ في اليَتيمَةِ يُسهِبُ",14,"ب",1,0],["وَكَثرَةِ دَمعِ العَينِ حَتّى لَوَ أَنَّني","يَراني عَدُوٌّ شامِتٌ لَتَحَوَّبا",15,"ب",2,0],["وَكَثرَةِ دَمعِ العَينِ حَتّى لَو أَنَّني","يَراني عَدُوٌّ كاشِحٌ لَتَحَوَّبا",16,"ب",2,0],["وَكَثُرَت حِدَّتُهُ وَضَجَرُه","وَصارَ كَالحُمّى يَطيرُ شَرَرُه",17,"ه",1,0],["وَكَثرَةُ المالِ شُغلٌ زادَ في نَصَبٍ","وَقِلَّةٌ مِنهُ مَعدولٌ بِها الفَلتُ",18,"ت",1,0],["وَكَثيرٌ لَهُ إِذا قيسَتِ الأَش","ياءُ عَظمٌ يَرميهِ بَعضُ طُهاتِه",19,"ت",2,0],["وَكَثرَةُ القَولِ دَلَّت أَنَّ صاحِبَها","أَلغى وَبَذَّر فَاِهجُر وَاِتَّقِ البُذُرا",20,"ر",2,0],["وَكَثرَةُ المالِ ساقَت لِلفَتى أَشَراً","كَالذَيلِ عَثَّرَ عِندَ المَشيِ ضافيهِ",21,"ف",3,0],["وَكَثِيرٌ مِنَ الخِلاَ","لِ إِذَا حُقِّقَ اخْتَلَفْ",22,"ف",1,0],["وَكَثِيبُ حُلْوَى تَشْتَهِيه","لِحُسْنِ مَنْظَرِهِ الحَدَقْ",23,"ق",1,1],["وَكَثيرُهُمْ مُسْتَهْزيءٌ","وَقَليلُهُمْ إِنْ بَرَّ زَاجرْ",24,"ر",1,0],["وكثرت دعوى الهوى فيهمِ","وحبّذا لو صحّ ما يدعون",25,"ن",1,0],["وكثر من حسادك الله إنه","إن الله أنمى خيره إليك تحسد",26,"د",1,0],["وكثيرة غرباؤها مجهولة","ترجى نوافلها ويخشى ذامها",27,"م",3,0],["وكثيراً ما سرَّه أنَّه بات","جريحاً ورأسًه مشجوب",28,"ب",1,0]]}