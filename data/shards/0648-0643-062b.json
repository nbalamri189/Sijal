{"poems":[[77,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[93,"فاح ريحانها ولاح الخزام","https://www.aldiwan.net/poem11347.html","الخفيف"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[47,"مغرم مؤلم جريح أسير","https://www.aldiwan.net/poem25262.html","الخفيف"],[72,"جنينة التين وجيرانها","https://www.aldiwan.net/poem18419.html","السريع"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"يا أبا أحمد ومثلك لا يغفل","https://www.aldiwan.net/poem61894.html","الخفيف"],[51,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[51,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[51,"رقعة من معاتب لك ظلت","https://www.aldiwan.net/poem66390.html","الخفيف"],[89,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[85,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[43,"مالنا كلنا جو يا رسول","https://www.aldiwan.net/poem9980.html","الخفيف"],[61,"وكثيرة الأحداق إلا أنها","https://www.aldiwan.net/poem51314.html","الكامل"],[44,"لمكاسر الحسن بن وهب أطيب","https://www.aldiwan.net/poem30585.html","الكامل"],[31,"خليلي عوجا حييا اليوم زينبا ولا","https://www.aldiwan.net/poem42639.html","الطويل"],[40,"خليلي عوجا حييا اليوم زينبا","https://www.aldiwan.net/poem42288.html","الطويل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[46,"إنا حسبنا حسابا لم يصح لنا","https://www.aldiwan.net/poem22146.html","البسيط"],[46,"إنما نحن في ضلال وتعلي","https://www.aldiwan.net/poem22218.html","الخفيف"],[46,"فوارس الدهر جاءت تسبق النذرا","https://www.aldiwan.net/poem22617.html","البسيط"],[46,"الغدر فينا طباع لا ترى أحدا","https://www.aldiwan.net/poem23589.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55035","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55078","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54934","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141925","السريع"],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.poetsgate.com/ViewPoem.aspx?id=33822",""],[4,"معلقة لبيد بن ربيعة العامري","https://www.poetsgate.com/ViewPoem.aspx?id=30298",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[132,"جعلت بيننا الرباب النمو ما","https://www.aldiwan.net/poem54747.html","الخفيف"],[135,"أهدي إلى روض السلام","https://www.aldiwan.net/poem49052.html","مجزوء الرجز"],[143,"ما كان قبلك في الزمان الخالي","https://www.aldiwan.net/poem11802.html","الكامل"],[150,"ألا ليت شعري هل أسيرن منجدا","https://www.aldiwan.net/poem68594.html","الطويل"],[160,"قليل لها هجر الجنوب المضاجعا","https://www.aldiwan.net/poem58996.html","الطويل"],[178,"سرّ الهوى","https://www.aldiwan.net/poem50711.html","أحذ الكامل"],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[210,"سلام كعرف المسك يعبق بالنشر","https://www.aldiwan.net/poem13525.html","الطويل"],[232,"يا قبلتي جدلي بقبله","https://www.aldiwan.net/poem14755.html","مجزوء الكامل"],[241,"يا أخت غصن البانة المياس","https://www.aldiwan.net/poem45768.html","الكامل"],[262,"وكثنا كزوج من قطا في مفازة","https://www.aldiwan.net/poem68217.html","الطويل"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[364,"رأيت الطريق إلى الوصل وعرا","https://www.aldiwan.net/poem60911.html","الطويل"],[366,"يا شجاع بن شاور بن مجير","https://www.aldiwan.net/poem17210.html","الخفيف"],[432,"أروه الجلنار من الخدود","https://www.aldiwan.net/poem12608.html","الوافر"],[458,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[463,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[464,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[493,"ذو قصر أحدب من غير كبر","https://www.aldiwan.net/poem67295.html","عموديه"],[529,"رعايا اليمن الميمون","https://www.aldiwan.net/poem37340.html","مجزوء الوافر"],[551,"لعنة الله على من","https://www.aldiwan.net/poem47303.html","مجزوء الرمل"],[551,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[558,"كل من بالناس يختلط","https://www.aldiwan.net/poem34409.html","المديد"],[558,"بوجودي فغذني يا قوتي","https://www.aldiwan.net/poem34717.html","الخفيف"],[558,"خلني في محبة المحبوب","https://www.aldiwan.net/poem34963.html","الخفيف"],[561,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[567,"قد أتانا الذي بعثت إلينا","https://www.aldiwan.net/poem69461.html","الخفيف"],[567,"وكثيرة النغمات تحسبها","https://www.aldiwan.net/poem69583.html","الكامل"],[567,"ضرب في ارتشاف ذاك الرضاب","https://www.aldiwan.net/poem69817.html","الخفيف"],[575,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"]],"verses":[["وكثّرَ منْ حُسّادِكَ اللّهُ إنّهُ","إنِ اللّهُ أنْمى خيْرَهُ لكَ تُحْسَدِ",0,"د",1,0],["وَكَثِيبٍ سَقَاهُ مِنْ زَادٍ سَفْرٍ","رَشْحُ مَاءٍ فَبشَّ فِيهِ الثُّمَامُ",1,"م",1,0],["وَكَثيرَةٍ غُرَبائُها مَجهولَةٍ","تُرجى نَوافِلُها وَيُخشى ذامُها",2,"م",3,0],["وَكَثيرٌ مِنَ الرِجالِ حَديدٌ","وَكَثيرٌ مِنَ القُلوبِ صُخورُ",3,"ر",1,0],["وكثرت عنديَ ما أشتهي","فالتين من فوقِي ومن تحتي",4,"ي",1,0],["وكثَّفتْ دون الغنى سدَّها","حتّى كأنِّي كنتُ كثَّفْتُها",5,"ت",3,0],["وكثيراً ما كان يفعل ما يح","سن من غير أن يقدّم وعدا",6,"د",2,0],["وكثَّر اللَّهُ من فتاك أبي","إسحاقَ في ظلِّ نعمةٍ عَدَدكْ",7,"ك",1,0],["وكثرةِ ناسليكَ لقد أرانا","سُقوطَك قِلةُ المُتنازِعيكا",8,"ك",2,0],["وكثيراً يُمْنَى بأمثالها البس","تان ما لم يُحصَّنِ البستانُ",9,"ن",1,0],["وكثر الليل عنذ","الانياب كالمغاضب",10,"ب",1,0],["وَكَثُر القَتلى وَراحَ الأَسرى","عَلى فَوات الوَفَياتِ حَسرى",11,"ر",2,0],["وَكَثرَةِ الناقِلِ وَالمُعَرِّبِ","عَن حِكمَةِ الفُرسِ وَعِلم المَغرِبِ",11,"ب",1,0],["وَكَثيرٌ مِنَ السُؤالِ اِشتِياقٌ","وَكَثيرٌ مِن رَدِّهِ تَعليلُ",12,"ل",1,0],["وكثيرة الأحداق إلا أنها","عمياء ما لم تنغمس في ماء",13,"ا",2,1],["وَكَثيرَ عَزَّةَ يَومَ بَينٍ يَنسُبُ","وَاِبنَ المُقَفَّعِ في اليَتيمَةِ يُسهِبُ",14,"ب",1,0],["وَكَثرَةِ دَمعِ العَينِ حَتّى لَوَ أَنَّني","يَراني عَدُوٌّ شامِتٌ لَتَحَوَّبا",15,"ب",2,0],["وَكَثرَةِ دَمعِ العَينِ حَتّى لَو أَنَّني","يَراني عَدُوٌّ كاشِحٌ لَتَحَوَّبا",16,"ب",2,0],["وَكَثُرَت حِدَّتُهُ وَضَجَرُه","وَصارَ كَالحُمّى يَطيرُ شَرَرُه",17,"ه",1,0],["وَكَثرَةُ المالِ شُغلٌ زادَ في نَصَبٍ","وَقِلَّةٌ مِنهُ مَعدولٌ بِها الفَلتُ",18,"ت",1,0],["وَكَثيرٌ لَهُ إِذا قيسَتِ الأَش","ياءُ عَظمٌ يَرميهِ بَعضُ طُهاتِه",19,"ت",2,0],["وَكَثرَةُ القَولِ دَلَّت أَنَّ صاحِبَها","أَلغى وَبَذَّر فَاِهجُر وَاِتَّقِ البُذُرا",20,"ر",2,0],["وَكَثرَةُ المالِ ساقَت لِلفَتى أَشَراً","كَالذَيلِ عَثَّرَ عِندَ المَشيِ ضافيهِ",21,"ف",3,0],["وَكَثِيرٌ مِنَ الخِلاَ","لِ إِذَا حُقِّقَ اخْتَلَفْ",22,"ف",1,0],["وَكَثِيبُ حُلْوَى تَشْتَهِيه","لِحُسْنِ مَنْظَرِهِ الحَدَقْ",23,"ق",1,1],["وَكَثيرُهُمْ مُسْتَهْزيءٌ","وَقَليلُهُمْ إِنْ بَرَّ زَاجرْ",24,"ر",1,0],["وكثرت دعوى الهوى فيهمِ","وحبّذا لو صحّ ما يدعون",25,"ن",1,0],["وكثر من حسادك الله إنه","إن الله أنمى خيره إليك تحسد",26,"د",1,0],["وكثيرة غرباؤها مجهولة","ترجى نوافلها ويخشى ذامها",27,"م",3,0],["وكثيراً ما سرَّه أنَّه بات","جريحاً ورأسًه مشجوب",28,"ب",1,0],["وَكَثِيباً وبَانَةً وقَنَاةً","ومَهَاةً وخَيرُ زَاناً وَرِيمَا",29,"م",2,0],["وكثرةُ المصائبِ","وقلةُ الحبائبِ",30,"ب",1,0],["وَكَثيرَةِ الأَمثالِ إِلّا أَنَّها","في ذا الزَمانِ قَليلَةُ الأَمثالِ",31,"ل",1,0],["وَكُثرُ سِوانا لَيسَ يَعشُر قُلَّنا","وَلَن تُلفي النُظّارُ في الكُتبِ مِثلَنا",32,"ن",2,0],["وكثرة من يدعى على كبد يداً","وينشد قلبا بين جنبيه ضايعا",33,"ع",2,0],["وكثيرُ عَقْلي فرَّ مُضْطَرِبًا","والقلبُ طَوْعًا لِلهَوى خَضَعا",34,"ع",2,0],["وَكثّرَ فيهِ النقلَ من دون حاجةٍ","لِيثبتَ في دعواهُ بالكبرِ الكبرا",35,"ر",2,0],["وكثرة اشواقي اليك ابثها","وما لي وذكر اها وانت بها تدري",36,"ر",2,0],["وَكَثيرُ صَبري في هَوا","كَ إِذا بَعُدت فَما أَقَلَّه",37,"ل",2,0],["وكثيرةَ الفتكاتِ في ألحاظِها","وشديدةَ الحُجَّابِ والحُرَّاسِ",38,"س",1,0],["وَكثنَّا كَزَوجٍ مِن قَطَا في مَفَازَةٍ","لَدَى خَفضِ عَيشٍ ناعِمٍ مُونِقٍ رَغدِ",39,"د",1,1],["وكثرةُ التعهُّدِ","لهم بِكُلِّ معهدِ",40,"د",1,0],["وكثِّرْ قلائلَ إحسانِه","ومهما أساءَ فَلقِّنْه عُذرا",41,"ر",2,0],["وَكَثيرٌ وَالخَيرُ فيهِم كَثيرٌ","ثُمَّ لا خَيرَ بَعدَهُم في كَثيرِ",42,"ر",1,0],["وكثبانٌ ترجْرجَ في مُروطٍ","وقضبانٌ ترنّحُ في بُرودِ",43,"د",1,0],["وكُثِّرتَ بالأولادِ تُرهِف مُنصُلاً","طريراً إلى الدنيا وتَطبعُ مُنصُلا",44,"ل",2,0],["وكثبان مسك نبتها الزعفران وال","حصا ان ترد دُرّا وان شئت جوهرا",45,"ر",2,0],["وكثيرٌ من أمَّهُ فثناهُ","زاهداً في اللُهى ولا مثل زهدي",46,"د",2,0],["وكثرة الاطماع آفات البشر","وفي تصاريف الليالي معتبر",47,"ر",1,0],["وكثنْ ناصِراً في كُ","لّ إبْطائِي وإسْراعِي",48,"ي",1,0],["وكثيراً فإذا اِستَنْ","صرتَهُ عاد قليلا",49,"ل",2,0],["وكثيرُ ما قمنا به","في جَنبِ حقّك مُستَقَلُّ",50,"ل",1,0],["وكثير القول يكثر من","مثله الزلات والسقط",51,"ط",1,0],["وكثير وبعضنا غير بعض","في ثياب اللاهوت والناسوت",52,"ت",1,0],["وكثير من أمة الخير كانوا","بهوى الحسن في فؤاد طروب",53,"ب",1,0],["وَكَثرَةَ التَخبيرِ عَن شُقوري","وَهَل يَرُدُّ ما خَلا تَخبيري",54,"ر",2,0],["وَكَثِيْرٌ مَا قَلَّ عِنْدَكَ عِنْدِي","إِذْ حَبَانِي بِهَا رَئِيْسٌ عَظِيْمُ",55,"م",1,0],["وَكَثِيْرَةِ النَّغَمَاتِ تَحْسَبُهَا","فِي كُلِّ عُضْوٍ أُوتِيَتْ حَلْقَا",56,"ق",2,1],["وَكَثيرٌ حياؤُه والعَطَايا","يَتَبَرَّجْن مِنْهُ للخطَّابِ",57,"ب",1,0],["وكثَّروا ذمِّي وساداتُهم","تقِلُّ عن حَمدِي وعَنْ ذَمِّي",58,"ي",1,0]]}