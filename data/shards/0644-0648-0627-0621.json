{"poems":[[79,"سعودك لا ما تدعيه الكواكب","https://www.aldiwan.net/poem36771.html","الطويل"],[87,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[64,"نجوم العلى فيكم تطلع","https://www.aldiwan.net/poem52356.html","المتقارب"],[107,"لواء الله بورك من لواء","https://www.aldiwan.net/poem42133.html","الوافر"],[107,"بني بكر وما يغني الملام","https://www.aldiwan.net/poem44045.html","الوافر"],[107,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[96,"يا وحشة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=12821",""],[119,"لواء المجد والتعظيم يعقد","https://www.aldiwan.net/poem41775.html","الخفيف"],[154,"إذا أملت من مولاك قربا","https://www.aldiwan.net/poem68459.html","الوافر"],[445,"تسمع لدعوة ناء غريب","https://www.aldiwan.net/poem34789.html","المتقارب"],[543,"كما قلتم لن يرتضي السلم مجرم","https://www.aldiwan.net/poem47935.html","عموديه"],[568,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83302","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126797","الطويل"],[833,"","https://poetry.dctabudhabi.ae/diwan/poem/198795","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62533","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96721","الوافر"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102116","الهزج"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109613","البسيط"],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144752","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93843","البسيط"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100286","الطويل"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107021","الرجز"],[3100,"","https://poetry.dctabudhabi.ae/diwan/poem/124293","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140025","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127004","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126989","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132115","المتقارب"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132156","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118005","البسيط"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101354","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90808","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81718","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83654","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83483","الوافر"],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4578,"بأفق العز أشرق بدرُ سعدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49395",""],[5112,"سلام لسلمان","https://www.poetsgate.com/ViewPoem.aspx?id=216003",""],[5277,"هنالكَ... حيثُ يختبئُ النهارُ","https://www.poetsgate.com/ViewPoem.aspx?id=188252",""],[5894,"لولا الهوى ما التوى سقم على رجل","https://www.poetsgate.com/ViewPoem.aspx?id=131432",""]],"verses":[["لِوَاءُكَ مَنْصُورٌ وَحِزْبُكَ ظَافِرٌ","وَمُلْكُكَ مَحْفُوظٌ وَحِزْبُكَ غَالِبُ",0,"ب",1,0],["لواء الحشر بين يد","يك يوم الدين تقدمه",1,"م",2,0],["لواءٌ يُحَطُّ بأيدي الخُطوب","وألويةٌ غيرُه تُرفعُ",2,"ع",1,0],["لواءَ الله بُورِكَ مِن لواءِ","وهل بِجنودِ ربّكِ من خَفاءِ",3,"ا",2,1],["لِواءٌ قامَ للإيمانِ رَمْزا","يَهُزُّ قُلوبُ أهلِ الشِّركِ هَزّا",4,"ز",2,0],["لواءُ الفتحِ في يدهِ رَهِينٌ","بصاحِبه الذي فاقَ الصّحابا",5,"ب",2,0],["لواء عدنان أنت اليوم صاحبه","فاقحم به الشرق : هذا الشرق دنيانا",6,"ن",2,0],["لواء المجد والتعظيم يعقد","بأنواع الثنا للغوث أحمد",7,"د",1,1],["لواء الحمد في يمنى يديه","وكلُّ الناس من دون اللواء",8,"ا",2,0],["لواءَ ثناءٍ كَبَرْقِ الغَمامِ","يُهِلُّ إِلَيْهِ لواءُ الحروبِ",9,"ب",1,0],["لواءٌ تَسامى فِي السَّماءِ هلالُهُ","شعوبُ بني الإسلامِ حَولَهُ أنجُمُ",10,"م",1,0],["لِواءُ الفَخرِ في اللَّأواءِ فُلكٌ","جَميلُ الكُلِّ لألاءُ البُنودِ",11,"د",1,0],["لِواءٌ مِنَ الإِسلامِ قَد عَزَّ نَصرُهُ","أَطَلَّ عَلى الآفاقِ مِن كُلِّ جانِبِ",12,"ب",1,0],["لِواءٌ لَوانَ الأَرضِ طالَ أَثيرُها","لَمّا زالَ حَتّى أَندَقَّ بَينَ الكَواكِبِ",12,"ب",1,0],["لواء رسولِ اللّه كان بكفّهِ","وفي طيّه الإقبال والنصر مودَعُ",13,"ع",1,0],["لواء خليفة في كفها","وأعينها الأمل المعلن",14,"ن",1,0],["لواء الملك معقود بمالٍ","وجندٍ دوّخوا سهلاً ووعرا",15,"ر",2,0],["لواءُ الحمدِ والإجلا","لِ مِن دونِ الورى لهما",16,"م",2,0],["لواءُ الحمد يعقَد","لكَشّافٍ لخطبي",17,"ب",2,0],["لواءُ سعدك فوق النجم مركزه","وأنتَ في كل ما تبديه منصورُ",18,"ر",1,0],["لواءُ وَلائي تحت قَبْضِ يَمينِه","وإن كان عن رِقِّي بغيرِي قد اسْتغْنَى",19,"ن",2,0],["لواء فضلك لما كان منفرداً","ردفته بلواء الفخر والعظم",20,"م",1,0],["لِواء خَيرِ الخَلق طهَ المُصطَفى","وَصاحِب الدَولَة ذات الشّرفا",21,"ف",2,0],["لواء ذرى عزي وصارم عزمتي","وبدر سما سعدي وبطشة ساعدي",22,"ي",1,0],["لواء فخر نشروه فانطوى","الجور به فالعرب فيه تفخر",23,"ر",1,1],["لواء آل لؤى تاج غالبها","نضارة النضر حلي النضر في العطل",24,"ل",1,0],["لواءُ رسولِ اللّه ما دامَ يعتلي","ويُجلْى به ليلُ الخطوب وينجلي",25,"ل",2,1],["لواء خافق بعلا عليها","وهل للحرب فيها من قريع",26,"ع",1,0],["لواء العدل يا فيحاء اضحى","يرف عليك في عز ونصر",27,"ر",1,1],["لواء فرنسا عليك السلام","وإن كنت أشكو ولا أشكر",28,"ر",1,0],["لواء العلم والشرف المصفَّى","لأنتم حوله حرس وجند",29,"د",1,0],["لواء غوثية الأكوان في يده","وخلعة العز والتحكيم عاليه",30,"ي",2,0],["لواء الدين لف فلا جهاد","وباب العلم سد فلا اجتهاد",31,"د",1,1],["لواء فيه ميلادي ومهدي","ومن كبري بلغت به عتيا",32,"ي",2,0],["لواءٌ منيرُ النصل طاوٍ كأَنَّه","منارة مُمْسى راهبٍ متبتّل",33,"ل",1,0],["لواءُ الحمدِ في الدُنيا لواها","وَفي الأُخرى لَواها بِاِصطِلاحي",34,"ح",2,0],["لواء الحبّ أحمله","طرازٌ نورهُ بادِ",35,"د",1,0],["لواء العز منشور عليهم","ومجدهم المؤثل في صمود",36,"د",1,0],["لواءُ فخارها أضحى عليه","لواءُ محامدٍ من كلّ وفدِ",37,"د",1,0],["لِوَاءٌ تَدَفَّق مِنْ عِزّةٍ","فَنَعَمَ العزازُ وَنِعْمَ اللّوَاءْ",38,"ا",2,0],["لواءُ القدسِ ترفعُهُ كفوفٌ","بهنَّ اليومَ منْ صومٍ ضرارُ",39,"ر",1,0],["لواء شكر إلى علياك أرفعه","يا نور عصري ويا من منتهى أملي",40,"ل",2,0]]}