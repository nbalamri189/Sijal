 من ذي سلم","https://www.aldiwan.net/poem2553.html","المتقارب"],[434,"دعا عذلي لم يبق عقلا ولا لبا","https://www.aldiwan.net/poem2607.html","الطويل"],[436,"يا صفوة الأجفان من عبراتها","https://www.aldiwan.net/poem34761.html","الطويل"],[436,"لك البشرى ودمت قرير عين","https://www.aldiwan.net/poem34819.html","الوافر"],[436,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[436,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[436,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[436,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[438,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[438,"هو الحزن حتى ما يماثله حزن","https://www.aldiwan.net/poem14388.html","الطويل"],[438,"أحمل نفسي فوق ما لا تطيقه","https://www.aldiwan.net/poem14396.html","الطويل"],[438,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[438,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[438,"سلوا هل تروا خلقا وإن عز باقيا","https://www.aldiwan.net/poem14491.html","الطويل"],[447,"ربيع العمر","https://www.aldiwan.net/poem1014.html",""],[451,"عرفناك يا يوم عيد الحياة","https://www.aldiwan.net/poem61253.html","المتقارب"],[456,"لمن دار على إضم","https://www.aldiwan.net/poem55893.html","مجزوء الوافر"],[456,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[456,"نأت والأمانِي بها تقرب","https://www.aldiwan.net/poem56282.html","المتقارب"],[459,"تعلقته مشمخر العلى","https://www.aldiwan.net/poem15412.html","المتقارب"],[462,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[462,"خلا منك طرفي والحشا لك أوطان","https://www.aldiwan.net/poem3542.html","عموديه"],[475,"دع العيس ترفل في الفدفد","https://www.aldiwan.net/poem15189.html","المتقارب"],[475,"أرى العيش بعد المالكية لا يحلو","https://www.aldiwan.net/poem15218.html","الطويل"],[475,"أراها عن الجزع تبغي عدولا","https://www.aldiwan.net/poem15225.html","المتقارب"],[475,"ألا حي آثار الرسوم الدوائر","https://www.aldiwan.net/poem15243.html","الطويل"],[475,"كفى حزنا أني أبثك ما عندي","https://www.aldiwan.net/poem15281.html","الطويل"],[477,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[480,"فيا عجبا فرع يتمم أصله","https://www.aldiwan.net/poem24471.html","عموديه"],[491,"ومعصرة أنخت بها","https://www.aldiwan.net/poem67409.html","مجزوء الوافر"],[498,"رآني بمرط الإنكسار أخو الهوى","https://www.aldiwan.net/poem37972.html","الطويل"],[498,"رأى برق العقيق الفجر لاحا","https://www.aldiwan.net/poem38046.html","الوافر"],[504,"أما في الدهر معتبر","https://www.aldiwan.net/poem2430.html","مجزوء الوافر"],[511,"ولما أتونا بالمطايا وقربوا","https://www.aldiwan.net/poem67763.html","الطويل"],[549,"لعل زمانا بالثوية راجع","https://www.aldiwan.net/poem47727.html","الطويل"],[562,"متى يرحم المشتاق والوامق المضنى","https://www.aldiwan.net/poem896.html",""],[565,"طربت إلى المرآة فروعتني","https://www.aldiwan.net/poem69795.html","الوافر"],[573,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"]],"verses":[["فَيا عَجَبا مِمّا يَظُنُّ مُحَمَّدٌ","وَلَلظَنُّ في بَعضِ المَواطِنِ غَرّارُ",0,"ر",1,1],["فَيا عَوني إِذا عَدَّتِ اللَيالي","عَلَيَّ وَيا مِجَني في الحُروبِ",1,"ب",1,0],["فَيا عَجَباً لِلعَينِ أَمّا رُقادُها","فَعانٍ وَأَمّا الدَمعُ مِنها فَمُطلَقُ",2,"ق",1,0],["فَيا عَجَبا مِنّي وَمِنها وَصَبرُنا","عَلى ما نُلاقي كَيفَ نَصبو وَنصبِرُ",3,"ر",1,0],["فَيا عَجَباً لِلعَينِ إِن فاضَ دَمعُها","وَإِن كانَ أَن تَرقى دُموعِيَ أَعجَبُ",4,"ب",1,0],["فَيا عهْدَ الصِّبا سِرْ في أمانِ","ويا وِرْدَ الرّدَى أهْلاً وسَهْلا",5,"ل",2,0],["فَيا عَجَبَ الرَهنِ لِلقائِلا","تِ مِن آخِرِ اللَيلِ ماذا اِحتَجَن",6,"ن",1,0],["فَيا عَزَّ إِن واشٍ وَشى بِيَ عِندَكُم","فَلا تُكرِميهِ أَن تَقولي لَهُ أَهلا",7,"ل",2,0],["فَيا عَزُّ لَيتَ النأَيَ إِذ حالَ بَينَنا","وَبينَكِ باعَ الوِدَّ لي مِنكِ تاجِرُ",8,"ر",1,0],["فَيا عَزَّ صادي القَلبَ حتى يَوَدَّني","فُؤادُكِ أَو رُدّي عَليَّ فُؤادي",9,"ي",1,0],["فَيا عَزَّ أَنتِ البَدرُ قَد حالَ دونَهُ","رَجيعُ تُرابٍ وَالصَفيحُ المضرَّحُ",10,"ح",1,0],["فَيا عَينِ بَكّي لِاِمرِئٍ طارَ ذِكرُهُ","لَهُ تَبكِ عَينُ الراكِضاتِ السَوابِحِ",11,"ح",1,0],["فيا عجباً للعين تمشي طليقةً","ويصبح من جرّائها القلبُ عانيَا",12,"ي",2,0],["فيا عاذراً ما كان أجرأ مثلَه","فمثلُك لا يُدمي الأسود الضواريا",12,"ي",2,0],["فيا عَلَقاً أشجى القلوب لَوَ أنَّنا","فديناك بالأعلاق ما كنت غالبا",13,"ب",2,0],["فيا عجباً للرمح روِّيتَهُ دماً","وقد راق منه العينَ ريّانُ ذابلُ",14,"ل",1,0],["فيا علج أقصر عن نهيقك أنه","أضلّ كاضلال الخوار من العجل",15,"ل",1,0],["فيا عجباً من أمة قدتَ جيشها","تشابه كردينالها والجنيرال",16,"ل",1,0],["فيا عبد العزيز أقِم عزيزاً","بحيث الأرض طيّبة المراد",17,"د",1,0],["فَيا عَجَبي أَتوعِدُني نُمَيرٌ","بِراعي الإِبلِ يَحتَرِشُ الضِبابا",18,"ب",2,0],["فَيا عَجَباً كَيفَ يُعصى الإِلَهُ","أَم كَيفَ يَجحَدُهُ الجاحِدُ",19,"د",1,1],["فيا عجباً للأنثيين تهاديا","أذاتيَ ابراقَ البغايا إلى الشَّرْبِ",20,"ب",1,1],["فيا عجباً للناس يستشرفونني","كان لم يروا قبلي ضروطاً ولا بعدي",21,"ي",1,1],["فيا عجباً منِّي لإنسان مقلني","يحدِّث أخباري وفي فمه ماء",22,"ا",2,0],["فيا عجباً للدمع بثَّ سرائراً","لغيري ودمعي مانعي بثّ أسراري",23,"ي",1,0],["فيا عون المكتفي إذ بدت","علاه ويا خجل الواثق",24,"ق",1,0],["فيا عجباً للشيء هذي خلالهُ","وتاركُ ما فيه من الحظّ أعجبُ",25,"ب",1,0],["فيا عجباً والدهرُ جم صُرُوفه","يَفي ليَ إعساري وجودُكَ يَغدر",26,"ر",1,0],["فيا عجبي أأستحيي لعجزي","وفيك لأن تسامحني اغتنامُ",27,"م",1,0],["فيا عجباً إن كان ذاك وقد طوت","عجائب هذا الدهر قرناً إلى قرن",28,"ن",1,0],["فَيا عَجَباً حَتّى النُجومُ توضِلُّهُ","وَفي نورِها لِلمُدَلجينَ دَليلُ",29,"ل",1,0],["فَياعاذِلي ما أَكبَرَ البُعدَ بَينَنا","حَديثُ غَرامي فَوقَ ما يَتَوَهَّمُ",30,"م",1,0],["فَيا عَينِيَ العَبرى عَلَيَّ فَأَسكِبي","وَيا كَبِدي الحَرّى عَليهِم تَقَطَّعي",31,"ي",1,0],["فَيا عِلَّتي دومي فَأَنت حَبيبَةٌ","وَيا رَبّ سمعا مِن نِدائيَ وَالشَكوى",32,"و",2,0],["فيا عين قري بالذي تشهدينه","ويا نفس قد ولى شقاؤك فاطربي",33,"ب",2,0],["فيا عابراً فوق الصراط أخاف أن","يزجَّك هدا الكبش في الهوة الكبرى",34,"ر",2,0],["فَيا عَلي لا تَلُمني","فَما اِحتِقارُكَ قَصدي",35,"ي",1,0],["في أَعيُنِ الباري وَفَوقَ يَمينِهِ","جَرحى نُجِلُّهُمُ كَجَرحى خَيبَرِ",36,"ر",1,0],["فَيا عَجَباً مِن دائِلٍ أَنتَ سَيفُهُ","أَما يَتَوَقّى شَفرَتَي ما تَقَلَّدا",37,"د",2,0],["فيا عجباً حتى الخلافةُ ما رأتْ","لحقِّيَ أن أُجْزَى به وأُثَابَا",38,"ب",2,0],["فَيا عَجَبي حَتّى كُلَيبٌ تَسُبُّني","كَأَنَّ أَباها نَهشَلٌ أَو مُجاشِعُ",39,"ع",1,0],["فَيا عَجَبا حَتّى كُلَيبٌ تَسُبُّني","وَكانَت كُلَيبٌ مَدرَجاً لِلمَشاتِمِ",40,"م",1,0],["فَيا عَجَباً تَموتُ وَأَنتَ تَبني","وَتَتَّخِذُ المَصانِعَ وَالقِبابا",41,"ب",2,0],["فَيا عَجَباً مِن طولِ سَهوي وَغَفلَتي","وَما هُوَ آتٍ لا مَحالَةَ آتِ",42,"ت",1,0],["فَيا عاتِباً في سَكبِ دَمعٍ أَذالَهُ","فَأَمسى بِأَسرارِ الهَوى يَتَكَلَّمُ",43,"م",1,0],["فيا عَجبَا من زورةٍ زارَ طيفُها","جُفوناً من التهويمِ فيها تَوَهّمُ",44,"م",1,0],["في أعاريضَ قصارٍ خَفِيَتْ","دِقّةً في الوَزْنِ عن فهمِ الخليلِ",45,"ل",1,0],["فيا عجَباً من روض نارٍ مكلَّلٍ","بنوّار ماءٍ في الزجاجَةِ يَسبحُ",46,"ح",1,0],["فَيا عارِضاً لِلعُرفِ أَقلَعَ مُزنُهُ","وَيا وادِياً لِلجودِ جَفَّت مَسائِلُه",47,"ل",2,0],["فَيا عِيَّ مَرحولٍ إِلَيهِ وَراحِلٍ","وَخَجلَةَ مَوفودٍ إِلَيهِ وَوافِدِ",48,"د",1,0],["فَيَا عَجَبَاً لِلْقَوْمِ يَبْغُونَ خُطَّتِي","وَمَا خَطْوُهُمْ خَطْوِي وَلا عَدْوُهُمْ عَدْوِي",49,"ي",1,0],["فَيَا عَجَبَا لِلْقَوْمِ يَبْغُونَ خُطَّتِي","وَمَا شَأْوُهُمْ شَأْوِي وَلا عَدْوُهُمْ عَدْوِي",50,"ي",1,0],["فيا عاذلاً ما أنتَ واللهِ عادلاً","أأحفظُ عهداً سابقاً وأُلامُ",51,"م",1,0],["فَيا عَجَباً لِمَوقِفِنا","يُعاتِبُ بَعضُنا بَعضا",52,"ض",2,0],["فَيا عَجَباً لِمَوقِفِنا","وَغُيِّبَ ثُمَّ مَن كَشَحا",53,"ح",2,0],["فَيا عَجَباً لِلدَهرِ كَيفَ سَطا بِهِ","وَقَد كانَ يُرجى تارَةً وَيُهابُ",54,"ب",1,0],["فَيا عَجَباً لي كَيفَ آنَسُ بِالمُنى","وَغايَةُ ما أَدرَكتُ مِنها إِلى الفَوتِ",55,"ت",1,0],["فَيا عارِضاً يَستَقبِلُ اللَيلَ واكِفاً","وَيَسري فَيَطوي الأَطوَلَينِ وَيَمسَحُ",56,"ح",1,0],["فَيا عارِضاً يَطوي ا