{"poems":[[53,"تواعد ذا الخليط لأن يبينا","https://www.aldiwan.net/poem29647.html","الوافر"],[53,"أيا راكبا ترمي به الليل جسرة","https://www.aldiwan.net/poem29913.html","الطويل"],[53,"رجونا أبا الهيجاء إذ مات حارث","https://www.aldiwan.net/poem30665.html","الطويل"],[77,"مررت بوادي النمل من فوق خده","https://www.aldiwan.net/poem36103.html","الطويل"],[86,"من واجد منقر المنام","https://www.aldiwan.net/poem68846.html","الرجز"],[4,"يا مي قومي في المآتم واندبي","https://www.aldiwan.net/poem21176.html","الطويل"],[37,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[37,"وفي اللزبات إذا ما السنون","https://www.aldiwan.net/poem7325.html","المتقارب"],[72,"أناعسة الأجفان أسهرت مكمدا","https://www.aldiwan.net/poem18553.html","الطويل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[85,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[45,"ليالينا بين اللوى فزرود","https://www.aldiwan.net/poem63519.html","الطويل"],[45,"بأي أسى تثنى الدموع الهوامل","https://www.aldiwan.net/poem65575.html","الطويل"],[61,"أمن المدامة تنثني سكرا","https://www.aldiwan.net/poem51670.html","أحذ الكامل"],[80,"أرأيت لنا ولهم ظعنا","https://www.aldiwan.net/poem31261.html","المتدارك"],[80,"ورد الخدود ونرجس المقل","https://www.aldiwan.net/poem31330.html","أحذ الكامل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[31,"ردوا التحية أيها السفر","https://www.aldiwan.net/poem42513.html","الكامل"],[81,"الأرض قد لبست رداء أخضرا","https://www.aldiwan.net/poem61508.html","الكامل"],[48,"حلت سعاد وأهلها سرفا","https://www.aldiwan.net/poem64408.html","الكامل"],[48,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[46,"الشيب أزهار الشباب فما له","https://www.aldiwan.net/poem22705.html","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43682","الوافر"],[45,"ليالينا بين اللوى فزرود","https://www.poetsgate.com/ViewPoem.aspx?id=31334",""],[80,"أرأيتَ لنَا ولهم ظُعُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=3765",""],[195,"ألا رب لهو آنس ولذاذة","https://www.aldiwan.net/poem54397.html","الطويل"],[195,"شطت بجارتك النوى فتحمل","https://www.aldiwan.net/poem54423.html","الكامل"],[210,"لقد كان لي بغل به رتبتي تعلو","https://www.aldiwan.net/poem13400.html","الطويل"],[229,"يا يوم أسعفنا بكل سرور","https://www.aldiwan.net/poem51043.html","الكامل"],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[275,"الله عن تلك المناقب دافع","https://www.aldiwan.net/poem25488.html","الكامل"],[275,"زار الحيا بمزاره البستانا","https://www.aldiwan.net/poem25506.html","الكامل"],[281,"دعوني وتسكاب الدموع السوافك","https://www.aldiwan.net/poem1379.html",""],[298,"واها لأيام الشباب الغض","https://www.aldiwan.net/poem36825.html","عموديه"],[305,"أجدك هذا مضجع الفخر والمجد","https://www.aldiwan.net/poem56572.html","الطويل"],[316,"خطب طرقت به أمر طروق","https://www.aldiwan.net/poem69430.html","البسيط"],[348,"وكان سداد الباب عن مسلك الهوى","https://www.aldiwan.net/poem20080.html","الطويل"],[349,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[364,"إن قصرت بي عن الأغراض أيامي","https://www.aldiwan.net/poem60648.html","البسيط"],[364,"هل في عتاب الحادثات غناء","https://www.aldiwan.net/poem61013.html","الكامل"],[371,"ما بين أجفاني ملاحم","https://www.aldiwan.net/poem57111.html","مجزوء الكامل"],[371,"جعلت على الطرف السهور","https://www.aldiwan.net/poem57441.html","مجزوء الكامل"],[377,"بمرجلين صادفنا فعالا","https://www.aldiwan.net/poem59223.html","الوافر"],[406,"عصى العواذل إذ لجت عواذله","https://www.aldiwan.net/poem50132.html","البسيط"],[458,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[464,"أصمت فؤادي مقلتاه باسهم","https://www.aldiwan.net/poem3482.html","عموديه"],[464,"شاق الحمام برامتين فغردا","https://www.aldiwan.net/poem3584.html","عموديه"],[468,"كيف السبيل إلى التي هي جنة","https://www.aldiwan.net/poem60516.html","الكامل"],[479,"سلا تونسا عني وعنها سلانيا","https://www.aldiwan.net/poem37589.html","الطويل"],[500,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[514,"يا منة لذ بها السكر","https://www.aldiwan.net/poem20811.html","أحذ الكامل"],[573,"رضى بقضاء الله فهو مصيب","https://www.aldiwan.net/poem3660.html","الطويل"],[586,"وكأن سوسنها سبائك فضة","https://www.aldiwan.net/poem17989.html","الكامل"]],"verses":[["وَكانَ سَوادُهُ عيدَ الغَواني","يُعِدنَ إِلى مَطالِعِهِ العُيونا",0,"ن",2,0],["وَكانَ سِناناً في قَناةِ اِبنِ واصِلٍ","إِلَيكُم وَلِلأَجدادِ ثَمَّ عِراكُ",1,"ك",1,0],["وَكانَ سِناناً أوجَرَ الخَطبَ حَدَّهُ","وَكانَ يَداً أُدري بِها مَن أُلاوِثُ",2,"ث",1,0],["وَكَانَ سُلَيْمَانُ الْجَمالِ بِثَغْرِهِ","يُصِيخُ لِمَا جَاءَتْ بِهِ فَتَبَسَّمَا",3,"م",2,0],["وَكانَ ساقيكُم مِنَ الآرامِ","في لَيلَةٍ وَالبَدرُ في تَمامِ",4,"م",1,0],["وَكانَ سَبيلَ الناسِ مَن كانَ قَبلَهُ","وَذاكَ الَّذي أَفنى إِياداً وَتُبَّعا",5,"ع",2,0],["وكان سِواغاً إذ عثرت بغُصة","يضيق بها ذَرْعاً سواها طبيبها",6,"ب",3,0],["وكان سواء لدى الناتجين","تمام الحوارين والمعجل",7,"ل",1,0],["وكان سرور اليوم في مصر قد فشا","فكيفَ وقد أنشأت أضعافه غدا",8,"د",2,0],["وكان سَنام العيش قبلَ ابن طاهر","أجَبَّ فقد أضحى به وهْو أكْوَمُ",9,"م",1,0],["وكأن سوقهم العصىّ","أو القسىّ أو الصنائر",10,"ر",1,0],["وَكانَ سَوادُ الرَأسِ شَخصاً مُحَبَّباً","إِلى كُلِّ بَيضاءِ التَرائِبِ رُوَّدِ",11,"د",1,0],["وَكانَ سِراجَ الأَرضِ فَالأَرضُ مُظلِمٌ","قَراها وَحَلّى الدَهرَ فَالدَهرُ عاطِلُ",12,"ل",1,0],["وكأَنَّ سابِغَةَ الدُّروعِ ضُحىً","غُدْرٌ تَمرُّ بها الصَّبا مَرَّا",13,"ر",2,0],["وكأنّ سوابغَهُمْ حَبَبٌ","قد جاشَ بهم ماءٌ أجِنا",14,"ن",2,0],["وكأنّ سُمْرَ الخطّ في شَرَقٍ","بالعلّ من دمهمْ وبالنّهَلِ",15,"ل",1,0],["وكان ساحُكِ من ساحي إذا نزلت","به الشدائد، أقريه ويَقريني",16,"ن",2,0],["وَكَأَنَّ سِمطَيها عَلى رَشَإٍ","مُرتادُهُ الغيطانُ وَالخَمرُ",17,"ر",1,0],["وَكَأَنَّ سَوسَنَها يُصافِحُ وَردَها","ثَغرٌ يُقَبِّلُ مِنهُ خَدّاً أَحمَرا",18,"ر",2,0],["وَكَأَنَّ سُعدى إِذ تُوَدِّعُنا","وَقَدِ اِشرَأَبَّ الدَمعُ أَن يَكِفا",19,"ف",2,0],["وَكانَ سَيفُ الرَبيعِ يَأدِبُ ذا ال","سَفهَةِ مِنها وَراكِبَ الموقِ",20,"ق",1,0],["وَكَأَنَّ ساهِرَةَ السَماءِ تَضَمَّنَت","أَنَفاً مِنَ التَسهيدِ وَالإِسهارِ",21,"ر",1,0],["وكانَ سِراجَ قَوم هُمُ","فُوَيقَ سُروجِهِم سُرُجُ",22,"ج",1,0],["وكان سواد الرأس سخصاً محبباً","إلى كل بيضاء الترائب رود",23,"د",1,0],["وكأنّ سوابغهم حببٌ","وقد جاشَ بهم ماءٌ أجِنَا",24,"ن",2,0],["وَكانَ سُلَيمانُ بنُ داوودَ عُبِّدَت","لَهُ الجِنُّ تَبني دونَهُ وَتُسَخَّرُ",25,"ر",1,0],["وَكَأَنَّ سُهكَ المُعصِراتِ كَسَونَها","تُربَ الفَدافِدِ وَاليَفاعِ بِمُنخُلِ",26,"ل",1,0],["وكان سليل الاصل من عربية","نتيجة فحل نعم ما ينتج الفحل",27,"ل",1,0],["وكأنّ سَوْسَنَها خدودٌ قد بدت","للَّثم فيها زُرْقَةُ التأثِير",28,"ر",1,0],["وَكَأَنَّ ساقَيهِ بِغَرزِ رِكابِهِ","جمّارَتا شَماء بَيضاوانِ",29,"ن",1,0],["وَكأَنَّ ساعاتِ الثَّواءِ لِطولِها","حِجَجٌ رَوائِبُ للنُّفوسِ رَوائِعُ",30,"ع",1,0],["وَكَأَنَّ سَيِّدَنا الإمَامَ أَتَى بِها","عَمْداً لِيُرغِب في الجِنانِ جَنانا",31,"ن",2,0],["وكان سما في حضرة القدس حظه","فلم يله عنه بالحظوظ الركائك",32,"ك",1,0],["وَكان سلُّ كفِّها من كفِّي","كخطفِ كأْسِ الشاربِ المشتفِّ",33,"ف",1,0],["وَكانَ سريعاً للصريخِ جوابهُ","فَما بالُهُ ما إن يعيد ولا يبدي",34,"د",2,0],["وكأن سالفتيك تبر سائل","وعلى المفارق منك تاج عقيق",35,"ق",1,0],["وَكانَ سِدَادَ البَابِ عَن مَسْلكِ الهَوَى","وَصَاحِبَ رَأْيٍ كَمْ هَدَى بِسَدادهِ",36,"د",2,1],["وَكانَ سابورُ لَهُ","مِن قَبلُ ذاكَ قَد سَبَر",37,"ر",1,0],["وكان سُودَ ليالٍ كُلُّها فَعُني","بها الزّمانُ فصارتْ بيضَ أيّام",38,"م",1,0],["وكأنّ ساقي الحُزْنِ أنكرَ فَضلةً","في الكأسِ أسْأَرَها له النُدَماء",39,"ا",2,0],["وكأنَّ سَيلَ الدَّمعِ جَر","رَ النَّومَ لمَّا فاضَ ساجِم",40,"م",1,0],["وكأنَّ سُحبَ مَدامعي","يطلعنَ من بَرقِ الثغورِ",41,"ر",1,0],["وكان سحابه فينا جَهاماً","وخُلَّبُ برقِه وعداً لَدَينا",42,"ن",2,0],["وَكانَ سَمحاً جواداً بِالوِصالِ لَهُ","إِن ضَنَّ يَوماً بِوَصلِ الحُبِّ باخِلُهُ",43,"ل",2,0],["وكان سيفاً كابن أي","يوبَ إذا قلت اقطعِ",44,"ع",1,0],["وكأنَّ سائرة النجوم فواقعٌ","زهرٌ تجول على إناء مفعمِ",45,"م",1,0],["وكأنَّ ساري البرق خاف بجنحها","أمراً فسلَّ من الوميض مهنداً",46,"د",2,0],["وَكَأَنَّ سالِفَها طِرازٌ أَسوَدٌ","قَد لااحَ في ديباجَةٍ حَمراءِ",47,"ا",2,0],["وكان سجين الحب قبلي متيما","فقالت لقد أمسيت للشيخ ثانيا",48,"ي",2,0],["وكان سبعونَ فرداً تحتَ رايَتِهِ","غيرَ المُحاذينَ من دانٍ ومَحْبوبِ",49,"ب",1,0],["وكأنّ سرَّ المومياءِ لها","فيها لكَسْرِ قُلوبِنا جَبْرُ",50,"ر",1,0],["وَكانَ سَريعاً حينَ يُدعى إِلى النَدا","وَكَم مِن فَتىً يُدعى وَلَيسَ يُجيبُ",51,"ب",1,0],["وكَأنَّ سَوسَنَهَا سَبائِكُ فِضَّةٍ","وكَأنَّ نَرْجِسَهَا عُيونٌ تَنْظُرُ",52,"ر",1,1]]}