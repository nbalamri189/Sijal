ww.aldiwan.net/poem37589.html","الطويل"],[505,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[519,"يا منة لذ بها السكر","https://www.aldiwan.net/poem20811.html","أحذ الكامل"],[578,"رضى بقضاء الله فهو مصيب","https://www.aldiwan.net/poem3660.html","الطويل"],[591,"وكأن سوسنها سبائك فضة","https://www.aldiwan.net/poem17989.html","الكامل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137640",""],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122310","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63865","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64094","المنسرح"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64018","المنسرح"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18541","الوافر"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75744","الكامل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69217","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64712","الكامل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117716","الكامل"],[1403,"","https://poetry.dctabudhabi.ae/diwan/poem/115350","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118297","الكامل"],[2107,"","https://poetry.dctabudhabi.ae/diwan/poem/203815","المجتث"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28484","الطويل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2643,"","https://poetry.dctabudhabi.ae/diwan/poem/123815","الكامل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101633","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130083","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89164","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48454","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48288","المتقارب"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138700",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92062","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91276","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205759","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131022",""],[3832,"","https://poetry.dctabudhabi.ae/diwan/poem/202306","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135648","المجتث"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103539","الكامل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32421","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119485","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28621","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76745","الكامل"],[4755,"كقصيدة كالضرب بالفأس","https://www.poetsgate.com/ViewPoem.aspx?id=183593",""],[4759,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=207424",""],[4830,"حاطِبُ الليلِ","https://www.poetsgate.com/ViewPoem.aspx?id=196552",""],[585,"تلك القبور وماثل الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161873",""],[5216,"عَبَرْنا لِلْخُلود","https://www.poetsgate.com/ViewPoem.aspx?id=186939",""],[4045,"نفّر نومي الخبر الساري","https://www.poetsgate.com/ViewPoem.aspx?id=200300",""],[5338,"مديحك ما يزان به الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=187945",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5431,"الحب دربٌ آمنٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201942",""],[5725,"امن ربرب الاكام ريم بذي سلم","https://www.poetsgate.com/ViewPoem.aspx?id=198470",""],[5996,"وعلى الكثيب مخمر من تيهه","https://www.poetsgate.com/ViewPoem.aspx?id=181338",""],[6336,"عشاق في الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73561&r=&rc=22",""]],"verses":[["وَكانَ سَوادُهُ عيدَ الغَواني","يُعِدنَ إِلى مَطالِعِهِ العُيونا",0,"ن",2,0],["وَكانَ سِناناً في قَناةِ اِبنِ واصِلٍ","إِلَيكُم وَلِلأَجدادِ ثَمَّ عِراكُ",1,"ك",1,0],["وَكانَ سِناناً أوجَرَ الخَطبَ حَدَّهُ","وَكانَ يَداً أُدري بِها مَن أُلاوِثُ",2,"ث",1,0],["وَكَانَ سُلَيْمَانُ الْجَمالِ بِثَغْرِهِ","يُصِيخُ لِمَا جَاءَتْ بِهِ فَتَبَسَّمَا",3,"م",2,0],["وَكانَ ساقيكُم مِنَ الآرامِ","في لَيلَةٍ وَالبَدرُ في تَمامِ",4,"م",1,0],["وَكانَ سَبيلَ الناسِ مَن كانَ قَبلَهُ","وَذاكَ الَّذي أَفنى إِياداً وَتُبَّعا",5,"ع",2,0],["وكان سِواغاً إذ عثرت بغُصة","يضيق بها ذَرْعاً سواها طبيبها",6,"ب",3,0],["وكان سواء لدى الناتجين","تمام الحوارين والمعجل",7,"ل",1,0],["وكان سرور اليوم في مصر قد فشا","فكيفَ وقد أنشأت أضعافه غدا",8,"د",2,0],["وكان سَنام العيش قبلَ ابن طاهر","أجَبَّ فقد أضحى به وهْو أكْوَمُ",9,"م",1,0],["وكأن سوقهم العصىّ","أو القسىّ أو الصنائر",10,"ر",1,0],["وَكانَ سَوادُ الرَأسِ شَخصاً مُحَبَّباً","إِلى كُلِّ بَيضاءِ التَرائِبِ رُوَّدِ",11,"د",1,0],["وَكانَ سِراجَ الأَرضِ فَالأَرضُ مُظلِمٌ","قَراها وَحَلّى الدَهرَ فَالدَهرُ عاطِلُ",12,"ل",1,0],["وكأَنَّ سابِغَةَ الدُّروعِ ضُحىً","غُدْرٌ تَمرُّ بها الصَّبا مَرَّا",13,"ر",2,0],["وكأنّ سوابغَهُمْ حَبَبٌ","قد جاشَ بهم ماءٌ أجِنا",14,"ن",2,0],["وكأنّ سُمْرَ الخطّ في شَرَقٍ","بالعلّ من دمهمْ وبالنّهَلِ",15,"ل",1,0],["وكان ساحُكِ من ساحي إذا نزلت","به الشدائد، أقريه ويَقريني",16,"ن",2,0],["وَكَأَنَّ سِمطَيها عَلى رَشَإٍ","مُرتادُهُ الغيطانُ وَالخَمرُ",17,"ر",1,0],["وَكَأَنَّ سَوسَنَها يُصافِحُ وَردَها","ثَغرٌ يُقَبِّلُ مِنهُ خَدّاً أَحمَرا",18,"ر",2,0],["وَكَأَنَّ سُعدى إِذ تُوَدِّعُنا","وَقَدِ اِشرَأَبَّ الدَمعُ أَن يَكِفا",19,"ف",2,0],["وَكانَ سَيفُ الرَبيعِ يَأدِبُ ذا ال","سَفهَةِ مِنها وَراكِبَ الموقِ",20,"ق",1,0],["وَكَأَنَّ ساهِرَةَ السَماءِ تَضَمَّنَت","أَنَفاً مِنَ التَسهيدِ وَالإِسهارِ",21,"ر",1,0],["وكانَ سِراجَ قَوم هُمُ","فُوَيقَ سُروجِهِم سُرُجُ",22,"ج",1,0],["وكان سواد الرأس سخصاً محبباً","إلى كل بيضاء الترائب رود",23,"د",1,0],["وكأنّ سوابغهم حببٌ","وقد جاشَ بهم ماءٌ أجِنَا",24,"ن",2,0],["وَكانَ سُلَيمانُ بنُ داوودَ عُبِّدَت","لَهُ الجِنُّ تَبني دونَهُ وَتُسَخَّرُ",25,"ر",1,0],["وَكَأَنَّ سُهكَ المُعصِراتِ كَسَونَها","تُربَ الفَدافِدِ وَاليَفاعِ بِمُنخُلِ",26,"ل",1,0],["وكان سليل الاصل من عربية","نتيجة فحل نعم ما ينتج الفحل",27,"ل",1,0],["وكأنّ سَوْسَنَها خدودٌ قد بدت","للَّثم فيها زُرْقَةُ التأثِير",28,"ر",1,0],["وَكَأَنَّ ساقَيهِ بِغَرزِ رِكابِهِ","جمّارَتا شَماء بَيضاوانِ",29,"ن",1,0],["وَكأَنَّ ساعاتِ الثَّواءِ لِطولِها","حِجَجٌ رَوائِبُ للنُّفوسِ رَوائِعُ",30,"ع",1,0],["وَكَأَنَّ سَيِّدَنا الإمَامَ أَتَى بِها","عَمْداً لِيُرغِب في الجِنانِ جَنانا",31,"ن",2,0],["وكان سما في حضرة القدس حظه","فلم يله عنه بالحظوظ الركائك",32,"ك",1,0],["وَكان سلُّ كفِّها من كفِّي","كخطفِ كأْسِ الشاربِ المشتفِّ",33,"ف",1,0],["وَكانَ سريعاً للصريخِ جوابهُ","فَما بالُهُ ما إن يعيد ولا يبدي",34,"د",2,0],["وكأن سالفتيك تبر سائل","وعلى المفارق منك تاج عقيق",35,"ق",1,0],["وَكانَ سِدَادَ البَابِ عَن مَسْلكِ الهَوَى","وَصَاحِبَ رَأْيٍ كَمْ هَدَى بِسَدادهِ",36,"د",2,1],["وَكانَ سابورُ لَهُ","مِن قَبلُ ذاكَ قَد سَبَر",37,"ر",1,0],["وكان سُودَ ليالٍ كُلُّها فَعُني","بها الزّمانُ فصارتْ بيضَ أيّام",38,"م",1,0],["وكأنّ ساقي الحُزْنِ أنكرَ فَضلةً","في الكأسِ أسْأَرَها له النُدَماء",39,"ا",2,0],["وكأنَّ سَيلَ الدَّمعِ جَر","رَ النَّومَ لمَّا فاضَ ساجِم",40,"م",1,0],["وكأنَّ سُحبَ مَدامعي","يطلعنَ من بَرقِ الثغورِ",41,"ر",1,0],["وكان سحابه فينا جَهاماً","وخُلَّبُ برقِه وعداً لَدَينا",42,"ن",2,0],["وَكانَ سَمحاً جواداً بِالوِصالِ لَهُ","إِن ضَنَّ يَوماً بِوَصلِ الحُبِّ باخِلُهُ",43,"ل",2,0],["وكان سيفاً كابن أي","يوبَ إذا قلت اقطعِ",44,"ع",1,0],["وكأنَّ سائرة النجوم فواقعٌ","زهرٌ تجول على إناء مفعمِ",45,"م",1,0],["وكأنَّ ساري البرق خاف بجنحها","أمراً فسلَّ من الوميض مهنداً",46,"د",2,0],["وَكَأَنَّ سالِفَها طِرازٌ أَسوَدٌ","قَد لااحَ في ديباجَةٍ حَمراءِ",47,"ا",2,0],["وكان سجين الحب قبلي متيما","فقالت لقد أمسيت للشيخ ثانيا",48,"ي",2,0],["وكان سبعونَ فرداً تحتَ رايَتِهِ","غيرَ المُحاذينَ من دانٍ ومَحْبوبِ",49,"ب",1,0],["وكأنّ سرَّ المومياءِ لها","فيها لكَسْرِ قُلوبِنا جَبْرُ",50,"ر",1,0],["وَكانَ سَريعاً حينَ يُدعى إِلى النَدا","وَكَم مِن فَتىً يُدعى وَلَيسَ يُجيبُ",51,"ب",1,0],["وكَأنَّ سَوسَنَهَا سَبائِكُ فِضَّةٍ","وكَأنَّ نَرْجِسَهَا عُيونٌ تَنْظُرُ",52,"ر",1,1],["وكان سقوط منازل شتى","مشيدة خشبا وأجر",53,"ر",1,0],["وكأن سندس عارضي","ندف المشيب عليه قطنا",54,"ن",2,0],["وكان سروري أن أكونَ مقدَّماً","وتبقَيْ إلى أن تُحْسَبي في العجائز",55,"ز",1,0],["وكان ستراً لباب بيتيَ أح","ياناً وحيناً لحافَ طُرّاقي",56,"ق",2,0],["وكان سهلاً عليك قذفيَ إِيّ","اك بما قد قَذفْتُ أو أبشَع",57,"ع",1,0],["وَكانَ سَفاهَةً مِنّي وَجَهلاً","مَسيري لا أَسيرُ إِلى حَميمِ",58,"م",1,0],["وَكأن سهيل خاف صولة جائِر","وَغَدا له نهر المجرة خندق",59,"ق",1,0],["وَكانَ سرورا لَم يدم لي وَغبطةً","وَأَيّ سُرور في الحَياة يَدومُ",60,"م",1,0],["وكَأَنَّ سائِلَ نَصْرِهِ وَصِلاتِهِ","داعٍ دَعا لِصَلاتِهِ وَفَلاحِهِ",61,"ح",2,0],["وكأنَّ سوسنةً بدت في روضها","بيضاءَ ضاعفَ نشرَها وقعُ الندا",62,"د",2,1],["وكأن سوسنها سبائك فضةٍ","غضّ النبات فأزرق أو أحمر",63,"ر",1,1],["وكان سنورا بمجرى ضفرها","تخشاه حين تهم بالابطاء",64,"ا",2,0],["وكان سري لديه","كالنار، والليل داج",65,"ج",1,0],["وَكانَ سَبيلُ الجودِ في الأَرضِ واحِداً","فَما عَرَفَ النَّاسُ اِختِلافَ المَذاهِبِ",66,"ب",1,0],["وكان سيداً رزين العقل","سيرتهُ سيرة أهل العدل",67,"ل",1,0],["وكان سيداً كثير الفضل","أحيا البلاد كلها بالعدلِ",67,"ل",1,0],["وكأنَّ سيفَك في الكريهةِ جَدوَلٌ","ونُحورُهم لوُرودِ ذاك صوادِ",68,"د",1,1],["وكان سكوتٌ ثم ألقى جناحه","فألقى على روحي جناحاً من السحر",69,"ر",1,0],["وكان سراجاً وسط قوم وجلّهم","أخو رمدٍ أو حاسد صدّه الذحلُ",70,"ل",1,0],["وكان سواك منك أشدَّ حرصاً","على المحيا وأنت له نظير",71,"ر",1,0],["وكان سماءً لنورِ الهُدَى","فقدْ قلَبَتْ للثّرى قُطْبَهُ",72,"ب",2,0],["وكان سَحاباً إذا يُرْتَجَى","وكان شِهاباً بهِ يُهْتَدَى",73,"د",2,0],["وكان سيفاً من سيوف المصطفى","واي سيفٍ للنبي قد نبا",74,"ب",2,0],["وَكانَ سهلاً وَحَزْناً في خلائقه","يُرضي الصديقَ كما يُردي المعادينا",75,"ن",2,0],["وَكَأنّ سودَ سطورِه في طرسِها","خدٌّ صَفا وَرَأيتُ فيهِ مآقي",76,"ق",2,0],["وكان سميرًا يملك السمع كلَّما","تبسَّط في أسماره وتشعَّبا",77,"ب",2,0],["وكان سريعا إن دعي لملمة","وكان إلى بذل المواهب اسرعا",78,"ع",2,0],["وكان سليطا مقولي متناذرا","شذاه، فصرت اليوم م العي أبكما",79,"م",2,0],["وكان سهلاً وأهلا","يقول أهلاً وسهلا",80,"ل",2,0],["وكأن ساقِيَها يثير شذا","مسكٍ لدى الأقوام مُنتَهبِ",81,"ب",1,0],["وَكَأَنَّ سَعفَصَ بَطنُهُ","وَالثَغرَ شينُ قُرَيِّشاتِ",82,"ت",1,0],["وكان ساعدي معا وسعدى","حتى اذا أخبر عن ذا الكسر",83,"ر",1,0],["وكان سرير الملك قبلك باكيا","فأبدى لنا من خطة ثغر باسم",84,"م",1,0],["وكان ساكناً بأطراف القرى","وكان نافعاً لأصناف الورى",85,"ر",2,0],["وَكَأَنَّ سَرجَكَ إِذ عَلاكَ غَمامَةٌ","وَكَأَنَّما تَحتَ الغَمامَةِ كَوكَبُ",86,"ب",1,0],["وكأن سطوته معاينة الردى","وغرار صارمه القضاء النازل",87,"ل",1,0],["وكَأنَّ ساحاتِ البلادِ عَلى","صَدري, وشِبرٌ مِن دَمٍ بَأسِي",88,"س",2,0],["وكأن ساعتي التي أوقفتها","عادت ووجه دقائقي ناداك",89,"ك",1,0],["وكانَ سَهمي يُصيبُ الطّيرَ لّبّّتَه","واليومَ قد طاشَ بعدَ الشيبِ مَرماهُ",90,"ا",2,0],["وكأن ساطع نقشها وطلائها","لهب توهج لا بريق صقال",91,"ل",1,0],["وكانَ سِلاحهم فِكرًا وماءً","فصاروا للقِلاعِ الفاتحينا",92,"ن",2,0],["وكان سوّار إلى مدّة","تجري الى الحق بمقدار",93,"ر",1,0],["وَكَانَ سِلاَحُكَ القُرْآنُ نُورًا","فَمَا رَاعَوْا لَهُ قَدْرًا وَصَانُوا",94,"ن",3,0],["وكان سلوكهم حقاً على ما","عليه الشرع دل من الكمال",95,"ل",1,0],["وكأنّ سعريَ باهظٌ","حتى يُقيمَ بلا شَبَعْ!!",96,"ع",1,0],["وكان سليم القلب لا داء عنده","فكيف اسى العشاق في صدره جثمْ",97,"م",1,0],["وكأن سحر بلاغةٍ في لفظه","أخذ يعقدها نوافث بابل",98,"ل",1,0],["وكان سميري البدرُ ثم تضاحكتْ","له نجمةٌ عبر السماء فأسلما",99,"م",2,0]]}