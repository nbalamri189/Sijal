wPoem.aspx?id=214837",""],[5717,"بحار دم أجرت عيون محبيه","https://www.poetsgate.com/ViewPoem.aspx?id=170591",""],[6299,"ألا أمُّ عَمْروٍ أجْمَعَتْ فکسْتَقَلَّتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19677&r=&rc=2",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""],[6341,"ابنة النخل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87280&r=&rc=9",""],[6345,"ارحل ....","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78651&r=&rc=22",""]],"verses":[["فَإِن تَقطَعي مِنكِ الرَجاءَ فَإِنَّهُ","سَيَبقى عَلَيكِ الحُزنُ ما بَقِيَ الدَهرُ",0,"ر",1,0],["فَإِن تَقتُلونا نُقَتِّلُكُم","وَإِن تَقصِدوا لِدَمٍ نَقصُدِ",1,"د",1,0],["فَانْتَقَلْنَا بَيْنَ الزَّمَانَيْنِ كَالنُّقْ","لَةِ بَيْنَ الإِقْلِيمِ وَالإِقْلِيمِ",2,"م",1,0],["فَإِن تَقتُلوني بِالأَميرِ فَإِنَّني","قَتَلتُكُمُ غَصباً بِغَيرِ أَميرِ",3,"ر",1,1],["فَإِن تَقصِدي فَالقَصدُ مِني خَليقَةٌ","وَإِن تَجمَحي تَلقَي لِجامَ الجَوامِحِ",4,"ح",1,0],["فَإِن تَقبَلوا المَعروفَ نَصبِر لِحَقِّكُم","وَلَن يَعدَمَ المَعروفُ خُفّاً وَمَنسِما",5,"م",2,0],["فَإِن تَقعُد فَمُكرَمَةٌ حَصانٌ","وَإِن تَظعَن فَمُحسِنَةُ الكَلامِ",6,"م",1,0],["فإن تُقاصِصْ فغيْرُ ذي شططٍ","وعبدُ مولىً أحقُّ من عذرَهْ",7,"ر",2,0],["فانتقِم إن أثرْتَ من طِيبِ أعْرا","قٍ سقَتْك القبول في أغصانِك",8,"ك",1,0],["فَإِن تُقبِلوا تُقبِل بِمَن نيلَ مِنهُمُ","وَإِن تُدبِروا فَأُمُّ مَن نيلَ فَيأتِ",9,"ت",1,0],["فَإِن تَقطَعوا كَفِّي أَلا رُبَّ ضَربَةٍ","ضَرَبتُ وَقَلبي ثابِتٌ غير مُرعِدِ",10,"د",1,0],["فَإِن تَقتُلوني تَقتُلوا غَيرَ ناكِصٍ","ولا يرم هام عَلَى الحيرِ مُلهَدِ",10,"د",1,0],["فإن تقتلوني تقتلوا غير معتدٍ","عليكم ولا باغٍ عدته المروءات",11,"ت",1,0],["فَاِنتَقَلَت مِن فَنَنٍ إِلى فَنَن","وَجَعَلَت لِكُلِّ نَقلَةٍ زَمَن",12,"ن",1,0],["فَإِن تَقُلِ الرِثاءَ فَقُل دُموعاً","يُصاغُ بِهِنَّ أَو حِكَماً تُراعى",13,"ع",2,0],["فإنْ تَقتليني تَبعثي الحربَ خدعةً","علينا فَرَوِّي وانْظُرِي في العَواقِبِ",14,"ب",1,0],["فَإِن تَقُل ها فَعاداتٌ عُرِفتَ بِها","أَو لا فَإِنَّكَ لا يَسخو بِها فوكا",15,"ك",2,0],["فَإِن تَقُل صُنتُهُ فَما خَلَقَ اللَ","هُ مَصوناً وَأَنتَ تَركَبُهُ",16,"ه",1,0],["فَإِن تَقعُدوا تَقعُد لِئامٌ أَذِلَّةٌ","وَإِن عُدتُمُ عُدنا بِبيضٍ صَوارِمِ",17,"م",1,0],["فَإِن تُقوِيا مِنهُم فَإِنَّ مُحَجِّراً","وَجِزعَ الحِسا مِنهُم إِذاً قَلَّما يَخلو",18,"ل",2,0],["فَإِن تَقتُلي في غَيرِ ذَنبٍ أَقُل لَكُم","مَقَلَةَ مَظلومٍ مَشوقٍ مُتَيَّمِ",19,"م",1,0],["فَإِن تَقبَلي يا عَبدَ تَوبَةَ تائِبٍ","يَتُب ثُمَّ لا يُوجَد لَهُ أَبَداً ذَنبُ",20,"ب",1,0],["فَإِنَّ تَقريبَ خُدّامِ الفَتى حُرُضاً","وَالضَيفُ يَأكُلُ رَأيٌ مِنهُ مَخسورُ",21,"ر",1,0],["فَإِن تَقِفِ الحَوادِثُ دونَ نَفسي","فَما يَترُكنَ إِشمامي وَرَومي",22,"م",2,0],["فَإِن تَقفوا أَثَري تُحمَدا","وَإِن تَعرِفا النَهجَ لا تَقفُوانِ",23,"ن",1,0],["فأنتَ قدَّرتَ عليَّ الشقاء","من حيثُ قدَّرتَ عليّ النعيمْ",24,"م",1,0],["فإن تَقْبَلْ فذاك هَوَى أُناس","وإنْ تَرْدُدْ فلم نألُ اجْتِهادا",25,"د",2,0],["فانتقي أكرم ما يهفو له","معصم غض وجيد أتلع",26,"ع",1,0],["فانتقِم إن آثرْتَ من طِيبِ أعْ","راقٍ سقَتْك القبول في أغضانك",27,"ك",1,0],["فَإن تَقْتُلي في غَيْرِ ذَنْبٍ، أَقُلْ لَكُمْ","مَقَالَة َ مَظْلومٍ مَشُوقٍ مُتَيَّمِ",28,"م",1,0],["فانتق الخبرين صحبا وحاذر","ان ترى اكثر الرجال رجالا",29,"ل",2,0],["فَإِن تَقتُلوا فِتيَةً أُفرِدوا","أَصابَهُمُ الحينُ أَو تَظفَروا",30,"ر",3,0],["فإن تقل لا فهل فزتم بما حرموا","وهل أصبتم وخير الرسل لم يصب",31,"ب",1,0],["فانتقل البعض للزراعة","والبعض الى الغاب راعياً إبله",32,"ل",2,0],["فَأَنتَ قاضٍ وَأَنتَ خَصمٌ","فَاِعدِل كَما تَعدِل القُضاةُ",33,"ه",1,0],["فَإِن تُقصِرا عَنّي تَكُن لِيَ حاجَةٌ","وَإِن تَبسُطا لا تَمنَعاني قَضائِيا",34,"ي",2,0],["فَإِن تُقِرَّ عَلَينا جَورَ مَظلِمَةٍ","لَم تَبنِ بَيتاً عَلى أَمثالِها مُضَرُ",35,"ر",1,0],["فإنت قلت لم أبصرك في كل صورة","أراها أحالت ذاك عين بصيرتي",36,"ي",1,0],["فانتقلَت منه إلى أبيضٍ","شفَّ فأشفَينا على السكرِ",37,"ر",1,0],["فإن تقدمنا منكم ذوو نسبٍ","فكم تقدم يسوع المسيح نبي",38,"ب",2,0],["فإن تقبلوني فهو فضل ومنة","وإن تحجبوني فهو كسب جنايتي",39,"ي",1,0],["فإن تَقَرِّي بِنا عَيناً وتَحتفِضِي","فِينا وَتنتَظِري كَرِّي وتَغريبي",40,"ب",2,0],["فإن تقل أكرهونا كان ذا كذباً","فنحن نعرف أحوال السلاطين",41,"ن",1,0],["فإن تقبلوها فالرجوع إلى الهدى","بأهل النهى والدين أجدى وأجدر",42,"ر",1,0],["فإنْ تقِسْهُمْ بأملاكِ الورى فهُمُ","ماءٌ زلالٌ إذ الأملاكُ كالآلِ",43,"ل",1,0],["فإن تُقِلنِي اللّيالِي عَثْرتِي وأفُز","بالقُربِ منكَ فميعادُ اللّقا الرّدَمُ",44,"م",1,0],["فإِنْ تقبلِ العذرَ المُقَصِّرَ طولَها","فشُغلي بشكرِ اللهِ فِيكَ هو العذرُ",45,"ر",1,0],["فإن تقتنوها بالجميل بَنتْ لكم","حصوناً على الأحساب من أنفَس الذُّخرِ",46,"ر",1,0],["فإن تقض عن علم بلا أخذ رشوه","ولا رفع ذي جاه على من تحقرا",47,"ر",2,0],["فأنت قبله صفر","وبعده تحت صفر",48,"ر",1,0],["فإنْ تقصُرْ فإنْ لها وشيكاً","كما تهواه أمثالا طوالا",49,"ل",2,0],["فإِنْ تَقِسْهُمْ تَجِدْهُمْ منزلاً وبناً","طالوا النّجومَ التّي فوق السّماواتِ",50,"ت",1,0],["فإن تقل فصله اعتبار","في العقل مثل اعتبار ظل",51,"ل",1,0],["فانتقص من ملامتي أو فزدني","يا عذولي فلست من أندادي",52,"د",2,0],["فأنت قد أوجبت فيما تتلو","أن الذين أمروا قد ضلوا",53,"ل",3,0],["فأنت قد صرت إلى الضلالة","وكل أسلافك والجهالة",53,"ه",1,0],["فأنت قل لي أيها المكابر","متى تراهم عند ذا تشاوروا",53,"ر",3,0],["فأنت قد أقررت في المعاشر","أن عليا لم يكن بحاضر",53,"ر",1,0],["فإن تقولوا إنه كان افترض","طاعته فقولكم قد انتقض",53,"ض",1,0],["فإن تقولوا لم يكونا قتلا","وأن يكونا فعلا ما فعالا",53,"ل",2,0],["فإِن تَقُلْ أَين الذينَ اغْتَدَوا","يَقُل صَدَاها لك أَين الذِينْ",54,"ن",1,0],["فإن تَقتُل عُويطفَ وهو أدنى","وأحقرُ في بَواءٍ بالصواب",55,"ب",1,0],["فإن تقدمه في العصر ذو كرم","فكم تقدم خير المرسلين نبي",56,"ب",2,0],["فأنت قذار تبيد الذباب","إذا أنت أوطئتها إخمصا",57,"ص",2,0],["فانتقدني واتخذني بلبلاً","صدحه بين يدي علياك مدح",58,"ح",1,0],["فإن تقطعوا حبلي فإني واصل","وإن تنقضوا عهدي فإني مبرم",59,"م",1,0],["فإن تقحّمت فاصبر","بما تنال بذاذا",60,"ذ",2,0],["فانتقبت وجنته حمرة","يا حسنها من وردة في نقاب",61,"ب",1,0],["فإن تقولوا بأن اللّه قد أمر","الهادي بهذا وما هذا بمحتمل",62,"ل",1,0],["فإن تقل صرح لنا باسمه","فقد قضينا في اسمه بالعجب",63,"ب",1,0],["فإن تقبلوا مني مقالي تعللا","فلا بد أن يبدي حقايقه العلم",64,"م",1,0],["فإن تقل والله ابغض الفتى","كنت محبّا فيه والعكس أتى",65,"ت",2,0],["فإنْ تَقُلْ ما هُما أُجِبْ وأَقُلْ","بابُ خوارِزْمِشَاهَ والأَدَبُ",66,"ب",1,0],["فإن تقضها فالحمد لله وحده","وإن تأبها فالعذر عندي واسع",67,"ع",1,0],["فإن تقبل تحيته فأجدر","فربما تواصلت البحار",68,"ر",1,0],["فَإِنْ تَقْتُلُوا الحُرَّ الكَرِيمَ ابْنَ مُحْصِنٍ","فَنَحْن قَتَلْنَا ذَا الكُلاَعِ وَحَوْشَبَا",69,"ب",2,0],["فإن تقبَّلها كان القبول لهم","نعم البديل وخيرالشيء ما كَرُما",70,"م",2,0],["فان تقصر فما خلى مواف","وان تكثر ففى الصبر ارتياح",71,"ح",1,0],["فَاِنتَقَم يا خَليفَةَ اللَهِ مِمَّن","لَم يَزَل قَلبُهُ عَلَيكَ يَفورُ",72,"ر",1,0],["فانتقمنا منهم وثُرْنا عليهم","ثورةً ليس أَمْرُها باليسيرِ",73,"ر",1,0],["فانتقد إن كنتَ تبغي","ما أتى به لساني",74,"ن",2,0],["فإن تقتصر صم عشرة ثم إن تهن","فتاسعه مع عاشر أو لذا قد",75,"د",1,0],["فَإِن تَقبلِ العُذرَ الضَّعيفَ تَطَوُّلاً","فَإِنَّ رَجائي فيكَ غَيرُ ضَعيفِ",76,"ف",1,0],["فإن تقطعي فالعمر خابٍ منارُه","وإن تَصلي صار الظلامُ نهارا",77,"ر",2,0],["فانت قريبٌ حينَ أدمُ مُطْرق","ونوحٌ على جنبِ الصراطِ قَريبُ",78,"ب",1,0],["فان تقتلوني بعد ذاك فانني","اموتُ بمقدارٍ وتفنى الضغائِنُ",79,"ن",1,0],["فإِن تُقَابِلهُنَّ يا حبيبي","تَبدُ سحائِب قُطبِكَ الجنوبي",80,"ي",1,0],["فَإِن تَقضِها يَوماً فَلَيسَ مُسَلِّماً","عَليكَ وَيَهوى أَن يَرى لَكَ ناعيا",81,"ي",2,0],["فإن تقوى الله من يخلص بها","حلت عقال عقله المعقود",82,"د",1,0],["فإن تقدحوا للدين زنداً فإنني","لذلك ما دمتم مدى الدهر طامع",83,"ع",1,0],["فإن تقل ما لونها واحد","قلت: وهذا سبع أخيف",84,"ف",1,0],["فان تقطع بهجرك جبل وصلى","على رب السموات اعتمادي",85,"د",2,0],["فأنت قلت ونعم القول ما نزلت","فيه المكارم ترجى ضمن آيات",86,"ت",1,0],["فإن تقل مُقلتاي القلب قد حَمتا","من الغَرام وَما بي عاذلي شِمتا",87,"ت",2,0],["فانتقلنا إِلى فضاء من البح","ران هاروت فيه بعض حماته",88,"ت",2,0],["فَإِن تَقبَلي نُصحي فَإِنّي مُبَشِّرٌ","بَأَنَّ جَميعَ الشَرِّ عَنكِ سَيَنجَلي",89,"ل",2,0],["فإن تقطعي وَصْلي فإنك مُخلِف","وإن أَك وصّالاً فإني متمِّم",90,"م",1,0],["فإنْ تَقْتُلُوا بال