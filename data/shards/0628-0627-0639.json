لطويل"],[406,"يلط بالدين من مولاه مسلمه","https://www.aldiwan.net/poem32251.html","البسيط"],[413,"هنيئا لكم هذا الهناء المجدد","https://www.aldiwan.net/poem54042.html","الطويل"],[429,"غناء حمام في معاطف بان","https://www.aldiwan.net/poem12392.html","الطويل"],[434,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[436,"فداؤك من لو كان في وسعه الفدا","https://www.aldiwan.net/poem34785.html","الطويل"],[436,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[451,"مسكينة إن من خانوك أوقحهم","https://www.aldiwan.net/poem61279.html","البسيط"],[456,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[456,"من دل ربات العيون النجل","https://www.aldiwan.net/poem56067.html","الرجز"],[456,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[456,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[456,"صدق الوشاة العهد عندك ضائع","https://www.aldiwan.net/poem56138.html","الكامل"],[456,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[459,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[459,"حسام أنت لكن شفرتاه","https://www.aldiwan.net/poem15300.html","الوافر"],[459,"جلبنا الخيل مشرفة الهوادي","https://www.aldiwan.net/poem16177.html","الوافر"],[461,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[462,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[466,"باعدت بالبعاد بيني وبينى","https://www.aldiwan.net/poem59601.html","الخفيف"],[491,"ما المال إلا ما أفاد ثناء","https://www.aldiwan.net/poem67427.html","الكامل"],[497,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[498,"القلب يفزع في المهمة ضارعا","https://www.aldiwan.net/poem37696.html","الكامل"],[498,"عظم أبا البركات واعرف شأنه","https://www.aldiwan.net/poem38076.html","الكامل"],[512,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[527,"نظام أراه كروح النظام","https://www.aldiwan.net/poem37131.html","المتقارب"],[549,"يا آل خير عباد الله كلهم","https://www.aldiwan.net/poem47180.html","البسيط"],[549,"كم ذا نخيب وتكذب الأطماع","https://www.aldiwan.net/poem47724.html","الكامل"],[549,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"],[549,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[556,"يا طلعة الشمس أو يا طلعة القمر","https://www.aldiwan.net/poem34551.html","البسيط"],[559,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"]],"verses":[["بِأَعيُنٍ تَرَكتُها","عَلى القُلوبِ أَعيُنا",0,"ن",2,0],["بِأَعذَبَ مِمّا نَوَّلَتنيهِ مَوهِناً","وَقَد شيمَ بِالغَورِ النُجومُ الطَوالِعُ",1,"ع",1,0],["باعَت بَصائِرَ دينِها بِضَلالِها","وَشَرَت مَعاطِبَ غَيِّها بِرَشادِها",2,"د",3,0],["باعَدْتِ بيْنِ جُفونِ صبِّكَ والكَرى","حتّى تَساوَى ليْلُهُ ونَهارُهُ",3,"ر",2,0],["بأعْطَرَ عَرْفاً منْ أريجِ ثَنائِهِ","إذا نشَرَتْ آثارَهُ صُحُفُ الحَمْدِ",4,"د",1,0],["بِأَعظَمَ مِنهُ تُقىً في الحِسابِ","إِذا النَسَماتُ نَفَضنَ الغُبارا",5,"ر",2,0],["بِأَعظَمَ مِنهُ في القُلوبِ مَهابَةً","وَإِن غَضَّ مِنها بِالطَلاقَةِ وَالبِشرِ",6,"ر",1,0],["باعَدتِ بِالإِعراضِ غَيرَ مُباعِدِ","وَزَهَدتِ فيمَن لَيسَ فيكِ بِزاهِدِ",7,"د",1,1],["بَاعَتْ جَمَالاً بِمَالِ","وَكَانَ بَيْعاً غَبِينَا",8,"ن",2,0],["بَاعُوا المخلد بِالحُطَامِ الْفَانِي","وَشَرَيْتَ بِالأَغْلَى مِنَ الأَثْمَانِ",9,"ن",1,1],["بَاعَهُمْ تَاجِرٌ عَلَيْكَ بِمَالٍ","بَزَّهُ مِنْهُمُ فَلَسْتَ غَرِيمَا",10,"م",2,0],["بَاعَلَ الحِرْصِ لا عَدِمْتَ القَرَابِي","نَ وَلا فَاتَ شَعْبَكَ التّقْدِيمُ",11,"م",1,0],["بَاعَلَ الحِرْصِ إِنَّ ظِلَّكَ ما دَا","مَ فَهَذَا الشَّقَاءُ فِينَا يَدُومُ",11,"م",1,0],["بِأَعطانِهِ القِردانُ هَزلى كَأَنَّها","نَوادِرُ صَيصاءِ الهَبيدِ المُحَطَّمِ",12,"م",1,0],["بأعطرَ من رَيَّا ثنائكَ في السُّرى","وأبهرَ حُسناً من شمائلك الغُرِّ",13,"ر",1,0],["بِأَعرافِ مَوماةٍ كَأَنَّ سَرابَها","عَلى حَدَبِ البيدِ الأُضاءُ الضَحاضِحُ",14,"ح",1,0],["باعَدنَ أَنَّ وِصالَهُنَّ خِلابَةٌ","وَلَقَد جَمَعنَ مَعَ البِعادِ تَحَقُّدا",15,"د",2,0],["باعَدتِ بِالوَصلِ إِلّا أَن يُجَرَّ لَنا","حَبلُ الشَموسِ فَلا يَأسٌ وَلا طَمَعُ",16,"ع",1,0],["باعَ أَباهُ المُستَنيرُ وَأُمَّهُ","بِأَشخابِ عَنزٍ بِئسَ رِبحُ المُبايِعِ",17,"ع",1,1],["باع صديقي لجام بغلته","ليشتري الخبز منه والأدما",18,"م",2,1],["بأعبق من أوصافه الغرُّ نفحةً","وأبرع من ألفاظِه الزهر مجتلى",19,"ل",2,0],["باعَ المنَاعِمَ بالمكارِمِ رابحاً","وابْتَاعَ حَمْدَ الحامدين فأرْبَحَا",20,"ح",2,0],["باع كلام الأمير مُرتغباً","عنه بقُوَّارَتَي رغيفين",21,"ن",1,0],["بِأَعظَمَ مِمّا كُنتُ حَمَّلتُ خالِداً","وَبَعضُ أَماناتِ الرِجالِ غُرورُها",22,"ر",3,0],["باعوا لِأَجلِ المالِ ماءَ حَيائِهِم","مَدحاً وَبِتُّ أَصونُ ماءَ حَيائي",23,"ا",2,0],["بِأَعطافِها العَرَقُ الأَصفَرُ","فَوَلَّت بِرَوحاءَ مَأطورَةٍ",24,"ه",1,0],["بِأَعلامِ مَركوزٍ فَعَيرٍ فَغُرَّبٍ","مَغانِيَ أُمِّ الوَبرِ إِذ هِيَ ما هِيا",25,"ي",2,0],["بأعماله الإنسان يعرف عقله","فليس سواها للنهى من موازين",26,"ن",1,1],["باعوا من الجهل الذي عندهم","دنياهم بالثمن البخس",27,"س",1,0],["باعِثُ النَفسِ عَلى الهَولِ الَّذي لَي","سَ لِنَفسٍ وَقَعَت فيهِ إِيابُ",28,"ب",1,0],["بأعبقَ من أخلاقهِ الغُرِّ إنها","لطائِمُ فضَّتْها أكفُّ النواهبِ",29,"ب",1,0],["باعٌ تُمَدُّ بِهِ النُبُو","وَةُ وَالخِلافَةُ قَبلَ مَدِّك",30,"ك",1,0],["باعِد دَنيآتِ المَطامِعِ وَاِرضَ بي","في الأَمرِ أُمهَلُ فيهِ أَن أَتَخَيَّرا",31,"ر",2,0],["باعَدَتنا مِنَ الغِنى بَعدَ قُربٍ","نِيَّةٌ مِن أَبي عَلِيٍّ عَليلَه",32,"ل",2,0],["بِإِعطائِكَ البيضَ الكَواعِبَ كَالدُمى","مَعَ الأَعوَجِيّاتِ الكِرامِ عِرابُها",33,"ب",3,0],["بِأَعراضِ قَومٍ خِندِفِيِّينَ مِنهُمُ","لُؤَيُّ اِبنُ فِهرٍ وَالسُعودُ وَدارِمُه",34,"م",2,0],["باعا عرائِسَ شِعْري بالعراقِ فلا","تَبْعَدْ سَباياهُ من عُونٍ وأبكارِ",35,"ر",1,0],["بأَعيُنٍ لم تُؤتَ من إغضاءٍ","كثيرةٍ تُربي على الإحصاءِ",36,"ا",2,0],["بِأَعرَفَ مِنّي لِلمِلاحِ تَوَسُّماً","وَلا جَنَحوا لِلعِشقِ بَعضَ جَنوحي",37,"ح",2,0],["بإعتزامٍ ككوكب الجوّ يرْمي","منهمُ كلَّ ماردٍ بضرامِ",38,"م",1,0],["باعتناقٍ ما اعتنَقْناهُ خَنىً","والتزامٍ ما التزمناهُ سفاح",39,"ح",1,0],["بأعبقَ من نَفحاتِ الجِنانِ","رُوْحَاً ومن مِسْكِها أَضْوَعِ",40,"ع",1,0],["بِأَعلى الوادِ عِندَ البِئ","رِ هَيَّجَ عَبرَةً سَبَلا",41,"ل",2,0],["بِاِعتِذارٍ مِن سُخطِها","عَلَّ أَسماءَ تَقبَلُ",42,"ل",1,0],["باعَ الصَديقُ بِوُدِّ غائِبَةٍ","بِالشامِ في مُتَمَنِّعٍ صَعبِ",43,"ب",1,0],["بِأَعظَمَ مِنّي رَوعَةً يَومَ راعَني","فِراقُ حَبيبٍ ما إِلَيهِ سَبيلُ",44,"ل",1,0],["بَاعَهُ ذئبٌ لذئبٍ غِيلةً","فهو للذّئْبَينِ نَهْبٌ مُقْتَسَمْ",45,"م",1,0],["بِأَعظَم مِن مَصرَ اِكتِئاباً وَحسرَةً","وَقَد زالَ عَنها عِزُّها المُتصرِّمُ",46,"م",1,0],["بِأعظَمَ مِن وَجدِي بِهِ فَلَعَلَّنِي","أرَى طَيفَ مُوسَى في المَنَامِ يُلاعِبُ",47,"ب",1,0],["باعُ سُلُوّي بِهِ قَصيرُ","لَكِنَّ لَيلي بِهِ طَويلُ",48,"ل",1,0],["بِأَعظَمَ مِن وَجدي بِموسى وَإِنَّما","يَرى أَنَّني أَذنَبتُ ذَنباً بِوُدِّهِ",49,"د",2,0],["باعوا البِلادَ إلى أعدائِهمْ طمَعاً","بالمالِ لكِنَّما أوطانَهم باعوا",50,"ع",3,1],["باعَ راحاً بِنَبيذٍ","هَكَذا بَيعاً خَسارا",51,"ر",2,0],["باعِد أَخاكَ بِبُعدِهِ","وَإِذا نَأى شِبراً فَزِده",52,"د",2,0],["بِأَعظَمَ مِنهُ في الرِجالِ مَهابَةً","وَآَخَرَ مَعدُوّاً عَلَيهِ وَعادِيا",53,"ي",2,0],["باعهم طماعيةً","واشتراهم الذهب",54,"ب",1,0],["باعثاً للوفاء ورداً وللقل","ب إلى أعمق السرائر ودّا",55,"د",2,0],["باعث النفس على الهول الذي","ما لنفسٍ وقعت فيه إياب",56,"ب",1,0],["باعُوكِ بَيْعَ الْغَبْنِ فِي سَفَهٍ وَلَوْ","عَقَلُوا لَمَا بَاعُوا هُدًى بِضَلالِ",57,"ل",1,0],["باعثُ الفِكر مثلهُ ناشرُ الفك","رِ له فضلُه ورفعةُ شانِهْ",58,"ن",2,0],["باع فيه تأله الأرض دعواه","وباعت فيه الصلاة' الطهاره",59,"ر",2,0],["بَاعٌ تُمدُّ بِهِ النّبُ وّةُ،","والخِلاَفَةُ قَبْلَ مَدّكْ",60,"ك",1,0],["بَاعَدَتْنَا مَنِ الغِنى، بَعدَ قرْبٍ،","مِنّةٌ مِنْ أبي عَليٍّ عَليلَهْ",61,"ل",2,0],["باعد دنيئات المطامع وأرض بي","في الأمر أمهل فيه أن اتخيرا",62,"ر",2,0],["بِأعْرَاضِ قَوْمٍ خنْدفِيِّينَ مِنهُمُ","لُؤيُّ بنُ فِهْرٍ والسُّعُودُ وَدارِمُهْ",63,"م",2,0],["باعت القلب واشترته اغتصابا","ومحته والبيع لا عن تراضي",64,"ض",2,0],["بأعيان أصحاب كرام وعترة","بمن قطع الأيام والليل باكيا",65,"ي",2,0],["بأعتاب تاج المرسلين التجائيا","ومن فضله الفياض كل رجائيا",66,"ي",2,1],["بأعتابك الفسحا أنخت مطيتي","وخليت أصحاب الزمان وإخواني",67,"ي",1,0],["باع الرجاء ولم يبتع به بدلاً","سوى قنوط طرير الغرب مسنون",68,"ن",1,0],["باعوا البلاد وحضرتي وجنابكم","لكن بلا ثمن إلى حاييم",69,"م",1,0],["باعوا العقائد بالقلائد وانبرى","منهم لبيع تراث يعرب أزعر",70,"ر",1,0],["بِأَعظَمَ مِن بَني سُفيانَ بَغياً","وَكُلُّ عَدوِّهِم مِنهُم مُريحُ",71,"ح",1,0],["باعث الفيض الذي أغرقني","وطفا بي وهو بي برّ رحيم",72,"م",1,0],["باعٌ طويلٌ ويدٌ طَلقةٌ","ومنطق يختال في المجمعِ",73,"ع",1,0],["باعوا التَيَقُّظَ بِالكَرى","فَعُقولُهُم بِذُرى كَراءِ",74,"ا",2,0],["باعوا رِضَى اللَّهِ وَاِبتاعوا مَساخِطَهُ","وَغَيَّروا الشَّرعَ يا للَّهِ لِلدِّينِ",75,"ن",1,0],["باعَدَ المِقْدَارُ بَغْدَا","دَ ضِرَاراً وَنُكُوبَا",76,"ب",2,0],["باعوا نفوسَهُمُ في سوقِ سادَتِهِمْ","بِئْسَ التِّجارةُ مِمَّنْ سُحْتَهُم حَصَدوا",77,"د",3,0],["بِأَعظَمَ منِّى لَوعَةً غَيرَ أَنَّنِى","أجَمجِمُ أَحشائِى على ما أَجّنَّتِ",78,"ت",1,0],["بأَعَمَّ نَفعاً مِن نَدَاكَ لِمَن بَغَى","فَضلاً وَاثمَلَ لِلضَّعِيفِ العائلِ",79,"ل",1,0],["باعوا المنازل والأوطان وانتقلوا","سوء الجوار جلاهم بعد ما صبروا",80,"ر",3,0],["بِأعدادِ ذرّاتِ الوجودِ وعظمهِ","تَدومُ دوامَ اللَّه لا تقبلُ الحَصرا",81,"ر",2,0],["باعوك بالثمن الزهي","د فأين يا ليلى العداله",82,"ه",1,0],["باعَ في لأرضِ انفساً بنفوسٍ","فلذا الموتُ ناصبٌ ميزانهْ",83,"ن",2,0],["باعَ بنوها بعضُهمْ بعضَهم","والويلُ للرابحِ وللخاسرِ",84,"ر",1,0],["بأعراف رعد نحل سبحان مريم","وحج وفرقان ونمل مع الحرز",85,"ز",1,1],["باعوا البلاد بصفقة مغبونة","وكفاهمُ اسمٌ في البلاد ضئيل",86,"ل",1,0],["بأعذب لفظاً من بديه بديعه","وأعذب ما كان البديه بديعا",87,"ع",2,0],["باعوا نَفائسهم منه وأنفسهم","بجنة الخلد بيعا رابحا فَشَرى",88,"ر",2,0],["بأَعبقَ نشراً من لَطيمةِ خلقِه","إِذا فُضَّ عنها من مَكارمه طيبُ",89,"ب",1,0],["باعثا في الوجود وثبة روح","آبد لا تحدّه الآطام",90,"م",1,0],["باعوا الأَمانَةَ بِالخِيا","نَةِ وَاِشتَرَوا بِالأَمنِ جيفَه",91,"ف",2,0],["باعَت عَلى بَيعِكِ أُمَّ مِسكين","مَيمونَةٌ مِن نسوَةٍ ميامين",92,"ن",1,0],[