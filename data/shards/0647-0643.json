هكذا أيها الشقيق أنا اليومَ","كلانا نحاربُ الأقدارا",86,"ر",2,0],["هكذا تصبو كما شا","ءت وتبكي أغنياتي",87,"ي",1,0],["هَكَذَا كُلُّ مَنْ يُرِيدُ خُلُوداً","يَجْعَلُ الْكَوْنَ كلَّهُ مَيْدَانَهْ",88,"ن",2,0],["هَكَذَا فَلْيَسِرْ إِلَى الْمَجْدِ مَنْ شَا","ءَ وَيَرْفَعْ بِذِكْرِهِ أَوْطَانَه",88,"ن",2,0],["هكذا تُمْحلُ القُلوبُ وأَنْكَآ","أن تُباهَى بذلكَ الإِمْحال",89,"ل",1,0],["هكَذا تُقْبَرُ المُروءةُ في النّا","س ويُقْضَى على كَرِيمِ الْخِلال",89,"ل",1,0],["هكذا تقتحم القدس على","غاصبيها هكذا تسترجع",90,"ع",1,0],["هكذا صوَّرهُ بارئهُ","وعلى مقلتهِ قَدْ صنعه",91,"ع",2,0],["هكذا أحسّو يديك إصبعا","إصبعا أطمع لو جاوزن ألفا",92,"ف",2,0],["هكذا الشاعر الشقى يغنى","فيغذى الأفراح من أحزانه",93,"ن",2,0],["هكذا النابغونَ في العُدْمِ لم تُرضِعْهُمُ","الغُنْجَ عاطفاتٌ روائِم",94,"م",1,0],["هكذا ( الفكرةُ ) تزكو ثَمَراً","أن زكت غرساً ، وأن طابت نماء",95,"ا",2,0],["هكذا تُعْلِنُ صرعى أمةٍ","أن شعباً من جديدٍ خُلِقا",96,"ق",2,0],["هكذا يَرجِعُ التقىّ أمامَ","العقلِ وهو المشكِّكُ المغلوب",97,"ب",1,0],["هكذا ينْقَضِي الزّمانُ إلى أنْ","تشملَ العالمين فيه المنون",98,"ن",1,0],["هكذا يَجتني الودودُ من الإخ","وانِ أهلِ الأذهان والآداب",99,"ب",1,0],["هكذا تُمْحلُ القُلوبُ وأَنْكَى","أن تُباَهِي بذلكَ الإِمْحال",100,"ل",1,0],["هكَذا تُقْبَرُ الُمرؤة ُ في النّا","س ويُقْضَى على كرِيمِ الْخِلال",100,"ل",1,0],["هكذا كُنّا بأيّامِ الصَّفا","نَنْهَب اللذّاتِ في الوقتِ الثَّمينْ",101,"ن",1,0],["هكذا بين ليلة وضحاها","نتلاقى شقيقة .. وشقيقا",102,"ق",2,0],["هَكَذا وَصْفُ ما بَدَا لِيَ مِنْها،","لَيْسَ لي بِکلَّذي تُغَيِّبُ عِلْمُ",103,"م",1,0]]}