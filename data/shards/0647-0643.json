970.html","الخفيف"],[420,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[420,"ذكراني عهد الصبا بسعاد","https://www.aldiwan.net/poem54075.html","الخفيف"],[420,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[436,"بركة بوركت فنحن لديها","https://www.aldiwan.net/poem12417.html","الخفيف"],[436,"قام عن قوس حاجبيه","https://www.aldiwan.net/poem12800.html","مجزوء الخفيف"],[441,"أي طود هوى من الأطواد","https://www.aldiwan.net/poem2497.html","البسيط"],[447,"خفف الوطء ان مررت علينا","https://www.aldiwan.net/poem56053.html","عموديه"],[456,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[468,"عَثرَة ُ العُمر","https://www.aldiwan.net/poem36439.html","عموديه"],[481,"لوركا","https://www.aldiwan.net/poem2292.html","عموديه"],[482,"زان طرفها الحور","https://www.aldiwan.net/poem36921.html","المقتضب"],[498,"اذهب الكاس فعرف الفجر","https://www.aldiwan.net/poem9813.html","مجزوء الرمل"],[503,"ما على عاشق الحبيب ملامة","https://www.aldiwan.net/poem37642.html","الخفيف"],[503,"أي راح دارت به الأقداح","https://www.aldiwan.net/poem38045.html","الخفيف"],[503,"ما طوى الركب شقة الأرض يوما","https://www.aldiwan.net/poem38090.html","الخفيف"],[506,"أيها الجاهل المسيء الظن","https://www.aldiwan.net/poem21753.html","الخفيف"],[541,"أرأيت اللئام كيف تكون","https://www.aldiwan.net/poem47922.html","عموديه"],[541,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[541,"نحن في الحمراء أسد","https://www.aldiwan.net/poem47929.html","عموديه"],[541,"هو نصر قد جاء يعقب نصرا","https://www.aldiwan.net/poem48133.html","عموديه"],[561,"صح قولي إن السماع دواء","https://www.aldiwan.net/poem33528.html","الخفيف"],[561,"قلت للعارف النبيل النبيه","https://www.aldiwan.net/poem33631.html","الخفيف"],[561,"نحن قوم نهوى الوجوه الحسانا","https://www.aldiwan.net/poem33816.html","الخفيف"],[561,"إن هذا الأحد الديموم","https://www.aldiwan.net/poem33854.html","الرمل"],[561,"كل قول على العقول يشق","https://www.aldiwan.net/poem34304.html","الخفيف"],[561,"أعط طرفا له وللكون طرفا","https://www.aldiwan.net/poem34343.html","الخفيف"],[561,"نحن عن شمس أمره كالشعاع","https://www.aldiwan.net/poem34395.html","الخفيف"],[561,"قم تأمل في هذه الأنوار","https://www.aldiwan.net/poem34500.html","الخفيف"],[561,"نحن علم الله في الله وما","https://www.aldiwan.net/poem34569.html","الرمل"],[561,"إنما الدين كله تقليد","https://www.aldiwan.net/poem34595.html","الخفيف"],[561,"سق مطاياك بالحدا يا حادي","https://www.aldiwan.net/poem34596.html","الخفيف"],[561,"حق عيني رؤية الوجه المليح","https://www.aldiwan.net/poem34666.html","الرمل"],[565,"كيف هذي الدنيا وهذا الزمان","https://www.aldiwan.net/poem52761.html","الخفيف"],[565,"هكذا هكذا وإلا فلا لا","https://www.aldiwan.net/poem52814.html","الخفيف"],[565,"طال شوقي لطول هذا البعاد","https://www.aldiwan.net/poem52967.html","الخفيف"],[565,"أجمل الله في فؤادك صبرا","https://www.aldiwan.net/poem52990.html","الخفيف"],[583,"أرأيت الحمار يمعن رفساً","https://www.aldiwan.net/poem25197.html","عموديه"],[821,"","https://poetry.dctabudhabi.ae/diwan/poem/198820","الخفيف"]],"verses":[["هَكَذا تُدرِكُ النُفوسُ مِنَ الأَع","داءِ بَردَ القُلوبِ وَالأَكبادِ",0,"د",1,0],["هكذا أحسّو يديك إصبعا","إصبعا أطمع لو جاوزن ألفا",1,"ف",2,0],["هَكَذَا يَذْخَرُ الإِلاَهُ الْمَزَايَا","هَكَذَا يَغْبطُ الْجُدُودُ الْبَنِينَا",2,"ن",2,0],["هَكَذا الميكادُ قَد عَلَّمَنا","أَن نَرى الأَوطانَ أُمّاً وَأَبا",3,"ب",2,0],["هَكَذا كُنّا بِأَيّامِ الصَفا","تَنهَبُ اللَذّاتِ في الوَقتِ الثَمين",4,"ن",1,0],["هَكَذَا يَحْسُنُ القِرَانُ وَقَدْ","وَازَنَتْهُ العُلَى بِمِيزَانِ",5,"ن",1,0],["هَكَذَا سِرُّ كُلِّ حَيٍّ نَرَاهُ","خَلَلَ الشَّكْلِ بَادِياً لِلْعَيَانِ",6,"ن",1,0],["هَكَذَا هَكَذَا الوَفَاءُ","وَقَدْ جَازَ كُلَّ ظَنّْ",7,"ن",1,0],["هَكَذَا الإِحْسَانُ لا يَحْصِيهِ مَنْ","عدَّهُ فَلْتَحْيَ أُمُّ المُحْسِنينُ",8,"ن",1,0],["هَكَذَا المَكْرُمَاتُ إِنْ وُجِدَتْ فِي","بَلَدٍ فَهْوَ أَعْمَرُ الْبُلْدَانِ",9,"ن",1,0],["هَكَذَا تَسْتَغِلُّ إِحْسَانَهَا الأَقْوَا","مُ فِيهِمْ فَتَسْعَدُ الأَقْوَامُ",10,"م",1,0],["هَكَذَا وَالمُحِيطُ غَيْرُ عَظِيمٍ","يَفْقِدُ الحِيلَةَ الذَّكِيُّ العَظِيمُ",11,"م",1,0],["هَكَذَا فَارَقَ الْحَبِيبَانِ دَاراً","هِيَ دَارُ الشَّقَاءِ دَارُ المَغَارِمْ",12,"م",1,0],["هَكَذَا أَنْتَ وَالفُرُوعُ الَّتِي أَنْبَتَّهَا","مَنْبِتَ الحِجَى وَالكَمَالِ",13,"ل",1,0],["هَكَذَا هَكَذَا نُبُوغ الرِّجَالِ","فِي تَوَلِّي جَلاَئِلِ الأعْمَالِ",14,"ل",1,1],["هكذا فلتكن شوارعنا اليو","م وإلاّ فما عمرنا الديارا",15,"ر",2,0],["هكذا فلتكن يد الفن عليا","هكذا فليكن علا الفنّان",16,"ن",1,0],["هكذا شيّدوا بناء المعالي","هكذا أحسنوا لها التأسيسا",17,"س",2,0],["هكذا تكبُر الصغار وتقوى","في نواميس حادثات الحياة",18,"ه",1,0],["هكذا ترسل الأصول فروعاً","عاليات يأتين بالثمرات",18,"ت",1,0],["هكذا الجائف المريب يواري","فَعلة السوء منه بالتغليس",19,"س",1,0],["هكذا يدرك في الدنيا الكمال","هكذا في موتها تحيا الرجال",20,"ل",1,1],["هكذا يشرف موت المبتغي","شرفاً ليس إذا ريم ينال",20,"ل",1,0],["هكذا كونوا وإلا فاعلموا","أنما استقلالكم شيء محال",20,"ل",1,0],["هكذا دار دائر الكون من حي","ث انتهى عاد راجعاً للمبادي",21,"د",2,0],["هكذا ينبتُ الصنيعُ نباتاً","وكذا تحصد المعادي حصدا",22,"د",2,0],["هكذا كلّ الليالي موسمٌ","في حماك الرَّحب والأيام عيد",23,"د",1,0],["هكذا كلّ جموحٍ سائرٍ","لم يدع عنه بُنيَّات الطرق",24,"ق",1,0],["هكذا هكذا تكون تفاصي","ل عطايا يعوذها الملك بالله",25,"ل",2,0],["هكذا عادة الزمان بنوه","بسط ظل كما ترى وزواله",26,"ل",2,0],["هكذا يفخر المحاول فخراً","ليس حسن الوجوه كالتحسين",27,"ن",1,0],["هكذا تبنى المعالي","بمزايا هندسيَّه",28,"ي",2,0],["هكذا ظُلْمُهُمْ لكلّ بريءٍ","دعْ مقالي وسائِل التجريبا",29,"ب",2,0],["هكذا الصخرُ راجحُ الوزن راسٍ","وكذا الذرُّ شائُل الوزنِ هابِ",30,"ب",1,0],["هكذا المنظر الصقيل يؤدِّي","ما يوازي به بليغاً فصيحا",31,"ح",2,0],["هكذا كل لئيمٍ","خالط اللؤمُ مُشاشه",32,"ش",2,0],["هكذا يفضحُ الرجالُ لعمري","وكذا يحلمُ السفيهُ الركيك",33,"ك",1,0],["هكذا يفعلُ الجوادُ إذا كا","ن جواداً بالمنفِسات الغوالي",34,"ل",2,0],["هكذا عهدُنا بآل زُريقٍ","يشترون الثناء بالأثمان",35,"ن",1,0],["هكذا كلُّ كريم ماجد","جعل العرف صُراحاً دَدَنَه",36,"ن",2,0],["هَكَذا أَسكَتَت صُروفُ الزَمانِ","بُلبُلاً كانَ نَوحُهُ إِنشادا",37,"ا",1,0],["هَكَذا أَودَت بِهِ ريحُ الشِتاء","زَهرَةٌ لَم تَنفَتِح عَنها الكَمام",38,"م",1,0],["هَكَذا حَتّى بَدا الصُب","حُ لَنا طَلقَ المُحَيّا",39,"ي",2,0],["هكذا قلتُ للرِّياحِ فقالتْ","سَلْ ضميرَ الوُجُودِ كيف البدايَهْ",40,"ه",1,0],["هكذا المُخْلِصونَ في كلِّ صَوْبٍ","رَشَقَاتُ الرَّدى إليهم مُتَاحَهْ",41,"ح",2,0],["هكذا قالَ شاعرٌ ناولَ النَّاسَ","رحيقَ الحَيَاةِ في خيرِ كأسِ",42,"س",1,0],["هكذا قالَ شاعرٌ فيلسوفٌ","عاشَ في شعبهِ الغبيِّ بتَعْسِ",42,"س",1,0],["هكذا قالَ ثمَّ سارَ إلى الغابِ","ليحيا حياةَ شِعْرٍ وقُدْسِ",42,"س",1,0],["هكذا يَصْرِفُ الحَيَاةَ ويُفْني","حَلَقَاتِ السِّنينِ حَرْساً بحَرْسِ",42,"س",1,0],["هكذا الدَّهرُ بأزياءٍ","غُدُوٍ ورُواحِ",43,"ح",1,0],["هكذا كانت المواليد تحيا","ولها من حياتها افناء",44,"ا",2,0],["هكذا فليتدلل مولد","أخرج الملك الكريم المفضلا",45,"ل",2,0],["هَكَذا طَهَ وَمَن كانَ مَعَه","مِن وَقارِ اللَهِ أَلّا تَخدَعَه",46,"ه",1,0],["هَكَذا الكِرامُ كِرا","مٌ وَإِن هُموا طَرَبوا",47,"ب",3,0],["هَكَذا الدَهرُ حالَةٌ ثُمَّ ضِدٌّ","ما لِحالٍ مَعَ الزَمانِ دَوامُ",48,"م",1,0],["هَكَذا الدَهرُ حالَةٌ ثُمَّ ضِدٌّ","ما لِحالٍ مَعَ الزَمانِ بَقاءُ",49,"ا",2,0],["هَكَذا المُلكُ وَالمُلوكُ وَإِن جا","رَ زَمانٌ وَرَوَّعَت بَلواءُ",49,"ا",2,0],["هَكَذا المُسلِمونَ وَالعَرَبُ الخا","لونَ لا ما يَقولُهُ الأَعداءُ",49,"ا",2,0],["هكذا جاءنا الخفي من العل","م عليه من الرموز ستورُ",50,"ر",1,0],["هَكَذا إِن بَنى المَنازِلَ بانِ","وَثَناها مَشيدَةَ الأَركانِ",51,"ن",1,1],["هكذا كلُّ جميله","ليس لي في الغدر حيله",52,"ل",2,1],["هكذا ينْقضي الزّمانُ إلى أنْ","تَشمَلَ العالمين مِنه المنونُ",53,"ن",1,0],["هَكَذا عِنديَ يَجري مَطْلُهَا","بِخِلافٍ عندها مُطَّردِ",54,"د",1,0],["هكذا الفاضلُ مثلي","عندَ قسمِ الرزقِ فاضلْ",55,"ل",1,0],["هكذا كنْ محبةً واحتفالاً","واعصِ فينا الوشاةَ والعذَّالا",56,"ل",2,1],["هكذا تَعْمَى قُلوبُ الأغبياءْ","الكِفاحُ اشتدَّ والبأسُ احْتَدَمْ",57,"م",1,0],["هَكَذا نَحنُ وَهَذي حالُنا","لَيسَ فينا غَيرُ نِكسٍ مُحجِمِ",58,"م",1,0],["هكذا تصنع الجهالةُ بالنا","سِ ف