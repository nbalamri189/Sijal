,"السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54904","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55342","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54542","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54522","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141979","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141966","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142339","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[95,"هكذا تقتحم القدس","https://www.poetsgate.com/ViewPoem.aspx?id=710",""],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[100,"يداها","https://www.poetsgate.com/ViewPoem.aspx?id=50458",""],[98,"شاعر يترك الخيال كسيحا","https://www.poetsgate.com/ViewPoem.aspx?id=55333",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[90,"يوم فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=179165",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[80,"سَلّمِ الأمرَ منك لله واعلمْ","https://www.poetsgate.com/ViewPoem.aspx?id=3761",""],[51,"أعلمُ الناسِ بالنجوم بنو نُو","https://www.poetsgate.com/ViewPoem.aspx?id=26815",""],[101,"مَنْ مُجِيرِي مِنْ حالِكات اللّيالِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62416&r=&rc=8",""],[86,"فِتَية َ الصَّهباءِ خيرَ الشَّاربينْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13075&r=&rc=30",""],[99,"مهرجة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=362&r=&rc=67",""],[31,"طَالَ لَيْلي، وَکعْتَادَني اليَوْمَ سُقْمُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19069&r=&rc=332",""]],"verses":[["هَكَذا تُدرِكُ النُفوسُ مِنَ الأَع","داءِ بَردَ القُلوبِ وَالأَكبادِ",0,"د",1,0],["هَكَذَا يَذْخَرُ الإِلاَهُ الْمَزَايَا","هَكَذَا يَغْبطُ الْجُدُودُ الْبَنِينَا",1,"ن",2,0],["هَكَذا الميكادُ قَد عَلَّمَنا","أَن نَرى الأَوطانَ أُمّاً وَأَبا",2,"ب",2,0],["هَكَذا كُنّا بِأَيّامِ الصَفا","تَنهَبُ اللَذّاتِ في الوَقتِ الثَمين",3,"ن",1,0],["هَكَذَا يَحْسُنُ القِرَانُ وَقَدْ","وَازَنَتْهُ العُلَى بِمِيزَانِ",4,"ن",1,0],["هَكَذَا سِرُّ كُلِّ حَيٍّ نَرَاهُ","خَلَلَ الشَّكْلِ بَادِياً لِلْعَيَانِ",5,"ن",1,0],["هَكَذَا هَكَذَا الوَفَاءُ","وَقَدْ جَازَ كُلَّ ظَنّْ",6,"ن",1,0],["هَكَذَا الإِحْسَانُ لا يَحْصِيهِ مَنْ","عدَّهُ فَلْتَحْيَ أُمُّ المُحْسِنينُ",7,"ن",1,0],["هَكَذَا المَكْرُمَاتُ إِنْ وُجِدَتْ فِي","بَلَدٍ فَهْوَ أَعْمَرُ الْبُلْدَانِ",8,"ن",1,0],["هَكَذَا تَسْتَغِلُّ إِحْسَانَهَا الأَقْوَا","مُ فِيهِمْ فَتَسْعَدُ الأَقْوَامُ",9,"م",1,0],["هَكَذَا وَالمُحِيطُ غَيْرُ عَظِيمٍ","يَفْقِدُ الحِيلَةَ الذَّكِيُّ العَظِيمُ",10,"م",1,0],["هَكَذَا فَارَقَ الْحَبِيبَانِ دَاراً","هِيَ دَارُ الشَّقَاءِ دَارُ المَغَارِمْ",11,"م",1,0],["هَكَذَا أَنْتَ وَالفُرُوعُ الَّتِي أَنْبَتَّهَا","مَنْبِتَ الحِجَى وَالكَمَالِ",12,"ل",1,0],["هَكَذَا هَكَذَا نُبُوغ الرِّجَالِ","فِي تَوَلِّي جَلاَئِلِ الأعْمَالِ",13,"ل",1,1],["هكذا فلتكن شوارعنا اليو","م وإلاّ فما عمرنا الديارا",14,"ر",2,0],["هكذا فلتكن يد الفن عليا","هكذا فليكن علا الفنّان",15,"ن",1,0],["هكذا شيّدوا بناء المعالي","هكذا أحسنوا لها التأسيسا",16,"س",2,0],["هكذا تكبُر الصغار وتقوى","في نواميس حادثات الحياة",17,"ه",1,0],["هكذا ترسل الأصول فروعاً","عاليات يأتين بالثمرات",17,"ت",1,0],["هكذا الجائف المريب يواري","فَعلة السوء منه بالتغليس",18,"س",1,0],["هكذا يدرك في الدنيا الكمال","هكذا في موتها تحيا الرجال",19,"ل",1,1],["هكذا يشرف موت المبتغي","شرفاً ليس إذا ريم ينال",19,"ل",1,0],["هكذا كونوا وإلا فاعلموا","أنما استقلالكم شيء محال",19,"ل",1,0],["هكذا دار دائر الكون من حي","ث انتهى عاد راجعاً للمبادي",20,"د",2,0],["هكذا ينبتُ الصنيعُ نباتاً","وكذا تحصد المعادي حصدا",21,"د",2,0],["هكذا كلّ الليالي موسمٌ","في حماك الرَّحب والأيام عيد",22,"د",1,0],["هكذا كلّ جموحٍ سائرٍ","لم يدع عنه بُنيَّات الطرق",23,"ق",1,0],["هكذا هكذا تكون تفاصي","ل عطايا يعوذها الملك بالله",24,"ل",2,0],["هكذا عادة الزمان بنوه","بسط ظل كما ترى وزواله",25,"ل",2,0],["هكذا يفخر المحاول فخراً","ليس حسن الوجوه كالتحسين",26,"ن",1,0],["هكذا تبنى المعالي","بمزايا هندسيَّه",27,"ي",2,0],["هكذا ظُلْمُهُمْ لكلّ بريءٍ","دعْ مقالي وسائِل التجريبا",28,"ب",2,0],["هكذا الصخرُ راجحُ الوزن راسٍ","وكذا الذرُّ شائُل الوزنِ هابِ",29,"ب",1,0],["هكذا المنظر الصقيل يؤدِّي","ما يوازي به بليغاً فصيحا",30,"ح",2,0],["هكذا كل لئيمٍ","خالط اللؤمُ مُشاشه",31,"ش",2,0],["هكذا يفضحُ الرجالُ لعمري","وكذا يحلمُ السفيهُ الركيك",32,"ك",1,0],["هكذا يفعلُ الجوادُ إذا كا","ن جواداً بالمنفِسات الغوالي",33,"ل",2,0],["هكذا عهدُنا بآل زُريقٍ","يشترون الثناء بالأثمان",34,"ن",1,0],["هكذا كلُّ كريم ماجد","جعل العرف صُراحاً دَدَنَه",35,"ن",2,0],["هَكَذا أَسكَتَت صُروفُ الزَمانِ","بُلبُلاً كانَ نَوحُهُ إِنشادا",36,"ا",1,0],["هَكَذا أَودَت بِهِ ريحُ الشِتاء","زَهرَةٌ لَم تَنفَتِح عَنها الكَمام",37,"م",1,0],["هَكَذا حَتّى بَدا الصُب","حُ لَنا طَلقَ المُحَيّا",38,"ي",2,0],["هكذا قلتُ للرِّياحِ فقالتْ","سَلْ ضميرَ الوُجُودِ كيف البدايَهْ",39,"ه",1,0],["هكذا المُخْلِصونَ في كلِّ صَوْبٍ","رَشَقَاتُ الرَّدى إليهم مُتَاحَهْ",40,"ح",2,0],["هكذا قالَ شاعرٌ ناولَ النَّاسَ","رحيقَ الحَيَاةِ في خيرِ كأسِ",41,"س",1,0],["هكذا قالَ شاعرٌ فيلسوفٌ","عاشَ في شعبهِ الغبيِّ بتَعْسِ",41,"س",1,0],["هكذا قالَ ثمَّ سارَ إلى الغابِ","ليحيا حياةَ شِعْرٍ وقُدْسِ",41,"س",1,0],["هكذا يَصْرِفُ الحَيَاةَ ويُفْني","حَلَقَاتِ السِّنينِ حَرْساً بحَرْسِ",41,"س",1,0],["هكذا الدَّهرُ بأزياءٍ","غُدُوٍ ورُواحِ",42,"ح",1,0],["هكذا كانت المواليد تحيا","ولها من حياتها افناء",43,"ا",2,0],["هكذا فليتدلل مولد","أخرج الملك الكريم المفضلا",44,"ل",2,0],["هَكَذا طَهَ وَمَن كانَ مَعَه","مِن وَقارِ اللَهِ أَلّا تَخدَعَه",45,"ه",1,0],["هَكَذا الكِرامُ كِرا","مٌ وَإِن هُموا طَرَبوا",46,"ب",3,0],["هَكَذا الدَهرُ حالَةٌ ثُمَّ ضِدٌّ","ما لِحالٍ مَعَ الزَمانِ دَوامُ",47,"م",1,0],["هَكَذا الدَهرُ حالَةٌ ثُمَّ ضِدٌّ","ما لِحالٍ مَعَ الزَمانِ بَقاءُ",48,"ا",2,0],["هَكَذا المُلكُ وَالمُلوكُ وَإِن جا","رَ زَمانٌ وَرَوَّعَت بَلواءُ",48,"ا",2,0],["هَكَذا المُسلِمونَ وَالعَرَبُ الخا","لونَ لا ما يَقولُهُ الأَعداءُ",48,"ا",2,0],["هكذا جاءنا الخفي من العل","م عليه من الرموز ستورُ",49,"ر",1,0],["هَكَذا إِن بَنى المَنازِلَ بانِ","وَثَناها مَشيدَةَ الأَركانِ",50,"ن",1,1],["هكذا كلُّ جميله","ليس لي في الغدر حيله",51,"ل",2,1],["هكذا ينْقضي الزّمانُ إلى أنْ","تَشمَلَ العالمين مِنه المنونُ",52,"ن",1,0],["هَكَذا عِنديَ يَجري مَطْلُهَا","بِخِلافٍ عندها مُطَّردِ",53,"د",1,0],["هكذا الفاضلُ مثلي","عندَ قسمِ الرزقِ فاضلْ",54,"ل",1,0],["هكذا كنْ محبةً واحتفالاً","واعصِ فينا الوشاةَ والعذَّالا",55,"ل",2,1],["هكذا تَعْمَى قُلوبُ الأغبياءْ","الكِفاحُ اشتدَّ والبأسُ احْتَدَمْ",56,"م",1,0],["هَكَذا نَحنُ وَهَذي حالُنا","لَيسَ فينا غَيرُ نِكسٍ مُحجِمِ",57,"م",1,0],["هكذا تصنع الجهالةُ بالنا","سِ فتعمَى العقولُ والأذهانُ",58,"ن",1,0],["هكذا أخبرَ النبيُّ ولكن","ليس للأمرِ حين يُقدَرُ رَدُّ",59,"د",1,0],["هكذا المؤمِنُ الموفَّقُ يُغنِي","في مرُوآتِهِ غَناءَ المواضي",60,"ض",2,0],["هكذا فاز بالكرامةِ حزبُ ال","لَهِ طوبَى لِحزبهِ المفلحينا",61,"ن",2,0],["هكذا قَدَّرَ ربّي وقَضَى","ما الخبيثُ النَّفسِ مثلُ الطّيبِ",62,"ب",1,0],["هكذا يا ابنَ أُبيٍّ هكذا","لا يكن شأنُك شأنَ المسلمين",63,"ن",1,0],["هكذا من يَعبدُ الطاغوتَ لا","يَتَّقِي ربّاً ولا يَرجو مَعادا",64,"د",2,0],["هَكَذا يُصبح الحَبيبُ المَعنّي","بَعدَ حينٍ وَهُوَ المُحب المَعنّى",65,"ن",2,0],["هَكَذا يَسلك المحب طَريق ال","خوف أَمناً وَيحسب الرشد غَيّا",65,"ي",2,0],["هَكَذا يَذهب السُرور","سَريعاً إِذا حَضَر",66,"ر",1,0],["هكذا نُفِّرتْ عن الدور أهلٌ","عمروها إلى كهوف الجبالِ",67,"ل",1,0],["هَكَذا يَنبَغي وَإِلّا فَإِنَّ ال","عَقلَ يُثنى في حالَةِ المَبهورِ",68,"ر",1,0],["هكذا العشق رضيناه ومَنْ","يأتَمِرْ إن تأمري خيرُ مُرَي",69,"ي",1,0],["هَكَذا يفعل من كا","ن لعمري فيلسوفا",70,"ف",2,0],["هَكَذا المسلمون 