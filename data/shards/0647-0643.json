diwan.net/poem36439.html","عموديه"],[476,"لوركا","https://www.aldiwan.net/poem2292.html","عموديه"],[477,"زان طرفها الحور","https://www.aldiwan.net/poem36921.html","المقتضب"],[493,"اذهب الكاس فعرف الفجر","https://www.aldiwan.net/poem9813.html","مجزوء الرمل"],[498,"ما على عاشق الحبيب ملامة","https://www.aldiwan.net/poem37642.html","الخفيف"],[498,"أي راح دارت به الأقداح","https://www.aldiwan.net/poem38045.html","الخفيف"],[498,"ما طوى الركب شقة الأرض يوما","https://www.aldiwan.net/poem38090.html","الخفيف"],[501,"أيها الجاهل المسيء الظن","https://www.aldiwan.net/poem21753.html","الخفيف"],[536,"أرأيت اللئام كيف تكون","https://www.aldiwan.net/poem47922.html","عموديه"],[536,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[536,"نحن في الحمراء أسد","https://www.aldiwan.net/poem47929.html","عموديه"],[536,"هو نصر قد جاء يعقب نصرا","https://www.aldiwan.net/poem48133.html","عموديه"],[556,"صح قولي إن السماع دواء","https://www.aldiwan.net/poem33528.html","الخفيف"],[556,"قلت للعارف النبيل النبيه","https://www.aldiwan.net/poem33631.html","الخفيف"],[556,"نحن قوم نهوى الوجوه الحسانا","https://www.aldiwan.net/poem33816.html","الخفيف"],[556,"إن هذا الأحد الديموم","https://www.aldiwan.net/poem33854.html","الرمل"],[556,"كل قول على العقول يشق","https://www.aldiwan.net/poem34304.html","الخفيف"],[556,"أعط طرفا له وللكون طرفا","https://www.aldiwan.net/poem34343.html","الخفيف"],[556,"نحن عن شمس أمره كالشعاع","https://www.aldiwan.net/poem34395.html","الخفيف"],[556,"قم تأمل في هذه الأنوار","https://www.aldiwan.net/poem34500.html","الخفيف"],[556,"نحن علم الله في الله وما","https://www.aldiwan.net/poem34569.html","الرمل"],[556,"إنما الدين كله تقليد","https://www.aldiwan.net/poem34595.html","الخفيف"],[556,"سق مطاياك بالحدا يا حادي","https://www.aldiwan.net/poem34596.html","الخفيف"],[556,"حق عيني رؤية الوجه المليح","https://www.aldiwan.net/poem34666.html","الرمل"],[560,"كيف هذي الدنيا وهذا الزمان","https://www.aldiwan.net/poem52761.html","الخفيف"],[560,"هكذا هكذا وإلا فلا لا","https://www.aldiwan.net/poem52814.html","الخفيف"],[560,"طال شوقي لطول هذا البعاد","https://www.aldiwan.net/poem52967.html","الخفيف"],[560,"أجمل الله في فؤادك صبرا","https://www.aldiwan.net/poem52990.html","الخفيف"],[578,"أرأيت الحمار يمعن رفساً","https://www.aldiwan.net/poem25197.html","عموديه"]],"verses":[["هَكَذا تُدرِكُ النُفوسُ مِنَ الأَع","داءِ بَردَ القُلوبِ وَالأَكبادِ",0,"د",1,0],["هَكَذَا يَذْخَرُ الإِلاَهُ الْمَزَايَا","هَكَذَا يَغْبطُ الْجُدُودُ الْبَنِينَا",1,"ن",2,0],["هَكَذا الميكادُ قَد عَلَّمَنا","أَن نَرى الأَوطانَ أُمّاً وَأَبا",2,"ب",2,0],["هَكَذا كُنّا بِأَيّامِ الصَفا","تَنهَبُ اللَذّاتِ في الوَقتِ الثَمين",3,"ن",1,0],["هَكَذَا يَحْسُنُ القِرَانُ وَقَدْ","وَازَنَتْهُ العُلَى بِمِيزَانِ",4,"ن",1,0],["هَكَذَا سِرُّ كُلِّ حَيٍّ نَرَاهُ","خَلَلَ الشَّكْلِ بَادِياً لِلْعَيَانِ",5,"ن",1,0],["هَكَذَا هَكَذَا الوَفَاءُ","وَقَدْ جَازَ كُلَّ ظَنّْ",6,"ن",1,0],["هَكَذَا الإِحْسَانُ لا يَحْصِيهِ مَنْ","عدَّهُ فَلْتَحْيَ أُمُّ المُحْسِنينُ",7,"ن",1,0],["هَكَذَا المَكْرُمَاتُ إِنْ وُجِدَتْ فِي","بَلَدٍ فَهْوَ أَعْمَرُ الْبُلْدَانِ",8,"ن",1,0],["هَكَذَا تَسْتَغِلُّ إِحْسَانَهَا الأَقْوَا","مُ فِيهِمْ فَتَسْعَدُ الأَقْوَامُ",9,"م",1,0],["هَكَذَا وَالمُحِيطُ غَيْرُ عَظِيمٍ","يَفْقِدُ الحِيلَةَ الذَّكِيُّ العَظِيمُ",10,"م",1,0],["هَكَذَا فَارَقَ الْحَبِيبَانِ دَاراً","هِيَ دَارُ الشَّقَاءِ دَارُ المَغَارِمْ",11,"م",1,0],["هَكَذَا أَنْتَ وَالفُرُوعُ الَّتِي أَنْبَتَّهَا","مَنْبِتَ الحِجَى وَالكَمَالِ",12,"ل",1,0],["هَكَذَا هَكَذَا نُبُوغ الرِّجَالِ","فِي تَوَلِّي جَلاَئِلِ الأعْمَالِ",13,"ل",1,1],["هكذا فلتكن شوارعنا اليو","م وإلاّ فما عمرنا الديارا",14,"ر",2,0],["هكذا فلتكن يد الفن عليا","هكذا فليكن علا الفنّان",15,"ن",1,0],["هكذا شيّدوا بناء المعالي","هكذا أحسنوا لها التأسيسا",16,"س",2,0],["هكذا تكبُر الصغار وتقوى","في نواميس حادثات الحياة",17,"ه",1,0],["هكذا ترسل الأصول فروعاً","عاليات يأتين بالثمرات",17,"ت",1,0],["هكذا الجائف المريب يواري","فَعلة السوء منه بالتغليس",18,"س",1,0],["هكذا يدرك في الدنيا الكمال","هكذا في موتها تحيا الرجال",19,"ل",1,1],["هكذا يشرف موت المبتغي","شرفاً ليس إذا ريم ينال",19,"ل",1,0],["هكذا كونوا وإلا فاعلموا","أنما استقلالكم شيء محال",19,"ل",1,0],["هكذا دار دائر الكون من حي","ث انتهى عاد راجعاً للمبادي",20,"د",2,0],["هكذا ينبتُ الصنيعُ نباتاً","وكذا تحصد المعادي حصدا",21,"د",2,0],["هكذا كلّ الليالي موسمٌ","في حماك الرَّحب والأيام عيد",22,"د",1,0],["هكذا كلّ جموحٍ سائرٍ","لم يدع عنه بُنيَّات الطرق",23,"ق",1,0],["هكذا هكذا تكون تفاصي","ل عطايا يعوذها الملك بالله",24,"ل",2,0],["هكذا عادة الزمان بنوه","بسط ظل كما ترى وزواله",25,"ل",2,0],["هكذا يفخر المحاول فخراً","ليس حسن الوجوه كالتحسين",26,"ن",1,0],["هكذا تبنى المعالي","بمزايا هندسيَّه",27,"ي",2,0],["هكذا ظُلْمُهُمْ لكلّ بريءٍ","دعْ مقالي وسائِل التجريبا",28,"ب",2,0],["هكذا الصخرُ راجحُ الوزن راسٍ","وكذا الذرُّ شائُل الوزنِ هابِ",29,"ب",1,0],["هكذا المنظر الصقيل يؤدِّي","ما يوازي به بليغاً فصيحا",30,"ح",2,0],["هكذا كل لئيمٍ","خالط اللؤمُ مُشاشه",31,"ش",2,0],["هكذا يفضحُ الرجالُ لعمري","وكذا يحلمُ السفيهُ الركيك",32,"ك",1,0],["هكذا يفعلُ الجوادُ إذا كا","ن جواداً بالمنفِسات الغوالي",33,"ل",2,0],["هكذا عهدُنا بآل زُريقٍ","يشترون الثناء بالأثمان",34,"ن",1,0],["هكذا كلُّ كريم ماجد","جعل العرف صُراحاً دَدَنَه",35,"ن",2,0],["هَكَذا أَسكَتَت صُروفُ الزَمانِ","بُلبُلاً كانَ نَوحُهُ إِنشادا",36,"ا",1,0],["هَكَذا أَودَت بِهِ ريحُ الشِتاء","زَهرَةٌ لَم تَنفَتِح عَنها الكَمام",37,"م",1,0],["هَكَذا حَتّى بَدا الصُب","حُ لَنا طَلقَ المُحَيّا",38,"ي",2,0],["هكذا قلتُ للرِّياحِ فقالتْ","سَلْ ضميرَ الوُجُودِ كيف البدايَهْ",39,"ه",1,0],["هكذا المُخْلِصونَ في كلِّ صَوْبٍ","رَشَقَاتُ الرَّدى إليهم مُتَاحَهْ",40,"ح",2,0],["هكذا قالَ شاعرٌ ناولَ النَّاسَ","رحيقَ الحَيَاةِ في خيرِ كأسِ",41,"س",1,0],["هكذا قالَ شاعرٌ فيلسوفٌ","عاشَ في شعبهِ الغبيِّ بتَعْسِ",41,"س",1,0],["هكذا قالَ ثمَّ سارَ إلى الغابِ","ليحيا حياةَ شِعْرٍ وقُدْسِ",41,"س",1,0],["هكذا يَصْرِفُ الحَيَاةَ ويُفْني","حَلَقَاتِ السِّنينِ حَرْساً بحَرْسِ",41,"س",1,0],["هكذا الدَّهرُ بأزياءٍ","غُدُوٍ ورُواحِ",42,"ح",1,0],["هكذا كانت المواليد تحيا","ولها من حياتها افناء",43,"ا",2,0],["هكذا فليتدلل مولد","أخرج الملك الكريم المفضلا",44,"ل",2,0],["هَكَذا طَهَ وَمَن كانَ مَعَه","مِن وَقارِ اللَهِ أَلّا تَخدَعَه",45,"ه",1,0],["هَكَذا الكِرامُ كِرا","مٌ وَإِن هُموا طَرَبوا",46,"ب",3,0],["هَكَذا الدَهرُ حالَةٌ ثُمَّ ضِدٌّ","ما لِحالٍ مَعَ الزَمانِ دَوامُ",47,"م",1,0],["هَكَذا الدَهرُ حالَةٌ ثُمَّ ضِدٌّ","ما لِحالٍ مَعَ الزَمانِ بَقاءُ",48,"ا",2,0],["هَكَذا المُلكُ وَالمُلوكُ وَإِن جا","رَ زَمانٌ وَرَوَّعَت بَلواءُ",48,"ا",2,0],["هَكَذا المُسلِمونَ وَالعَرَبُ الخا","لونَ لا ما يَقولُهُ الأَعداءُ",48,"ا",2,0],["هكذا جاءنا الخفي من العل","م عليه من الرموز ستورُ",49,"ر",1,0],["هَكَذا إِن بَنى المَنازِلَ بانِ","وَثَناها مَشيدَةَ الأَركانِ",50,"ن",1,1],["هكذا كلُّ جميله","ليس لي في الغدر حيله",51,"ل",2,1],["هكذا ينْقضي الزّمانُ إلى أنْ","تَشمَلَ العالمين مِنه المنونُ",52,"ن",1,0],["هَكَذا عِنديَ يَجري مَطْلُهَا","بِخِلافٍ عندها مُطَّردِ",53,"د",1,0],["هكذا الفاضلُ مثلي","عندَ قسمِ الرزقِ فاضلْ",54,"ل",1,0],["هكذا كنْ محبةً واحتفالاً","واعصِ فينا الوشاةَ والعذَّالا",55,"ل",2,1],["هكذا تَعْمَى قُلوبُ الأغبياءْ","الكِفاحُ اشتدَّ والبأسُ احْتَدَمْ",56,"م",1,0],["هَكَذا نَحنُ وَهَذي حالُنا","لَيسَ فينا غَيرُ نِكسٍ مُحجِمِ",57,"م",1,0],["هكذا تصنع الجهالةُ بالنا","سِ فتعمَى العقولُ والأذهانُ",58,"ن",1,0],["هكذا أخبرَ النبيُّ ولكن","ليس للأمرِ حين يُقدَرُ رَدُّ",59,"د",1,0],["هكذا المؤمِنُ الموفَّقُ يُغنِي","في مرُوآتِهِ غَناءَ المواضي",60,"ض",2,0],["هكذا فاز بالكرامةِ حزبُ ال","لَهِ طوبَى لِحزبهِ المفلحينا",61,"ن",2,0],["هكذا قَدَّرَ ربّي وقَضَى","ما الخبيثُ النَّفسِ مثلُ الطّيبِ",62,"ب",1,0],["هكذا يا ابنَ أُبيٍّ هكذا","لا يكن شأنُك شأنَ المسلمين",63,"ن",1,0],["هكذا من يَعبدُ الطاغوتَ لا","يَتَّقِي ربّاً ولا يَرجو مَعادا",64,"د",2,0],["هَكَذا يُصبح الحَبيبُ المَعنّي","بَعدَ حينٍ وَهُوَ المُحب المَعنّى",65,"ن",2,0],["هَكَذا يَسلك المحب طَريق ال","خوف أَمناً وَيحسب الرشد غَيّا",65,"ي",2,0],["هَكَذا يَذهب السُرور","سَريعاً إِذا حَضَر",66,"ر",1,0],["هكذا نُفِّرتْ عن الدور أهلٌ","عمروها إلى كهوف الجبالِ",67,"ل",1,0],["هَكَذا يَنبَغي وَإِلّا فَإِنَّ ال","عَقلَ يُثنى في حالَةِ المَبهورِ",68,"ر",1,0],["