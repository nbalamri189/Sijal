{"poems":[[73,"لك الفضل مجد الدين","https://www.aldiwan.net/poem3885.html","الطويل"],[90,"إذا ما الفتى في دهره أحسن الظنا","https://www.aldiwan.net/poem45043.html","الطويل"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[53,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[87,"صغار بحلوان تستبشر","https://www.aldiwan.net/poem8065.html","المتقارب"],[87,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[82,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[89,"منحتك ألقاب العلا فادعني باسمي","https://www.aldiwan.net/poem8272.html","الطويل"],[76,"لقد أصخت إلى نجواك من قمر","https://www.aldiwan.net/poem12951.html","البسيط"],[77,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[173,"أظنك خلت الشوق والنأي أبكاني","https://www.aldiwan.net/poem1684.html",""],[189,"وما أنس طيب العناق","https://www.aldiwan.net/poem14529.html","المتقارب"],[369,"رمتني بلحظ واتقتني بمعصم","https://www.aldiwan.net/poem60649.html","الطويل"],[369,"كتاب عبد إلى مولاه يعتذر","https://www.aldiwan.net/poem60915.html","البسيط"],[371,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[409,"أتسأل عن رحيلي يا بن ودي","https://www.aldiwan.net/poem33966.html","الوافر"],[422,"حثثت على عنيف السير نوقي","https://www.aldiwan.net/poem54111.html","الوافر"],[438,"تقدم في الطب عبد العزيز","https://www.aldiwan.net/poem12667.html","المتقارب"],[443,"لهم حب قلبي إن تدانوا وإن صدوا","https://www.aldiwan.net/poem2622.html","الطويل"],[454,"أبا خليفة إن الطبع غلاب","https://www.aldiwan.net/poem981.html",""],[463,"لعلك بالشعب تعلو اليفاعا","https://www.aldiwan.net/poem56128.html","المتقارب"],[469,"أصمت فؤادي مقلتاه باسهم","https://www.aldiwan.net/poem3482.html","عموديه"],[484,"متى يا دهر تجمع شمل أنسى","https://www.aldiwan.net/poem36931.html","الوافر"],[518,"لقد باعدت عنك أخا شقيقا","https://www.aldiwan.net/poem67746.html","الوافر"],[519,"يلوح فتستدعي الفراش وتبسم","https://www.aldiwan.net/poem20798.html","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80036","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52054","الكامل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137945",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53207","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65969","الطويل"],[3123,"","https://poetry.dctabudhabi.ae/diwan/poem/21153","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48429","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102957","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86452","الطويل"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107042","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120469","الوافر"],[4727,"أتى رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=212277",""],[4927,"يا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=12986",""],[4960,"السَّيِّد النُّبْل","https://www.poetsgate.com/ViewPoem.aspx?id=214474",""],[5174,"حوار مع شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=187134",""],[5183,"عواطف الإخاء","https://www.poetsgate.com/ViewPoem.aspx?id=180212",""],[5436,"بغداد .. يا مجد هارون ( علي محمد السليم )","https://www.poetsgate.com/ViewPoem.aspx?id=46675",""],[5442,"تبدت وقد مدت عليها ستورها","https://www.poetsgate.com/ViewPoem.aspx?id=114743",""],[5493,"إعدام أمّة","https://www.poetsgate.com/ViewPoem.aspx?id=197210",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[6189,"أحزان جديدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83596&r=&rc=63",""],[6331,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82025&r=&rc=6",""]],"verses":[["فَلَو جَعَلوا المُعتَلَّ هاءً وَرَخَّموا","لَكانَ عَلى كُلِّ الوَرى حُكمُهُ حلما",0,"م",2,0],["فلو جعلت تبراً سبيكاً بيوتنا","ولسنا بحكام أبينا بها السكنى",1,"ن",2,0],["فَلَو جَهَّزتُ قَافِيَةً شَرُوداً","لَقَد دَخَلَت بُيُوتَ الأَشعَرِينَا",2,"ن",2,0],["فلو جمعت الجبال أتلفها","في غير حقٍ يُقضى ولا وطر",3,"ر",1,0],["فَلَو جيءَ بِالرُسلِ في واحِدٍ","وَبِالكُتبِ في صَفحَةٍ تُنشَرُ",4,"ر",1,0],["فَلَو جَزَيناكِ بِالأَرواحِ غالِيَةً","عَن طيبِ مَسراكِ لَم تَنهَض جَوازينا",5,"ن",2,0],["فَلِوَجهِهِ البادي عَلَيهِ سَنا الهدى","ضَرَبَتْ وُجُوهَ عُداتِهِ الأقدارُ",6,"ر",1,0],["فَلَوْ جَرَّبَ الإِنْسَانُ أَخْلاقَ دَهْرِهِ","لأَمْسَكَ بِالْيَأْسِ الْمُرِيحِ عَنِ الْعسْمِ",7,"م",1,0],["فَلَو جَمَعتَ إِلى حُسنٍ مُحاوَرَةً","حُزتَ الجَمالَينِ مِن خُبرٍ وَمِن خَبَرِ",8,"ر",1,0],["فلوْ جازَ حكميَ في الغابرينَ","وعدّلْتُ أقسامَ هذا الوَرَى",9,"ا",1,0],["فَلَو جاءَكَ الناعِي بِما جاءَني بِهِ","لَما عِشتَ إِلّا لابِساً ثَوبَ أَسفانِ",10,"ن",1,0],["فلو جَهَد الموتُ أن يستب","دّ منا بمنفردٍ ما قَدَر",11,"ر",1,0],["فلو جُسِّمَتْ يوماً لكانتْ كواكباً","من الحُسْنِ إلاّ أنّها لم تُجَسَّم",12,"م",1,0],["فلو جَرى قَلَمُ المَولَى بتَوصيةٍ","في بعضِ كتْبٍ إلى النُّوّابِ يُستَطَر",13,"ر",1,0],["فَلَو جَلَبوا بِجَبري كَسرَ عَظمٍ","لَما طالَبتُهُم فيهِ بِجَبرِ",14,"ر",1,0],["فلو جمعت لكانت عقد در","لجيد الدهر يفضل كل عقد",15,"د",1,0],["فلو جاد النقيب لنا بسمنٍ","حَمِدْنا التمر يعجن بالدَّقيق",16,"ق",1,0],["فلو جازَ في العُرفِ دفعُ الحِمامِ","لكان له طبُّهُ دافِعا",17,"ع",2,0],["فلو جاز في الدنيا خلود لخالدٍ","على حسن ما تأتي لحق له الخلد",18,"د",1,0],["فلو جرى ما جرى من هفوة عبرت","فاعلم يقينا بان الود غلاب",19,"ب",1,0],["فلو جئت تسأله نفسَه","لخالك كلَّفته ما استطاعا",20,"ع",2,0],["فلوجهه ديباجةٌ مرقومة","والثوبُ منقوصٌ إذا لم يرقمِ",21,"م",1,0],["فلو جليت عليك بنات عدن","لكانت بينهن بنات عرس",22,"س",1,0],["فلو جمع الآنام لكنت فرداً","أحبهم الي بكل سعر",23,"ر",1,0],["فلو جلسَ الأقمارُ من حولِه دُجىً","دَرَوا أنّه المَولى وإنْ كان منهُمُ",24,"م",1,0],["فلو جمعتنا الدار من بعد هذه","إذاً لأطلنا يا أُميمُ التشاكيا",25,"ي",2,0],["فَلِوَجْهِهِ الهَشّ الجَمِيلِ كَرَامَةٌ","وإلى شَمَائِلِهِ السَّلامُ يُسَيَّرُ",26,"ر",1,0],["فلو جاءَ فصل الشتاءِ ولم","يمدُّ اليهِ يديهِ القدر",27,"ر",1,0],["فلو جحدت عيناك قتلي وأنكرت","أقر به خطُّ العذار المنمنم",28,"م",1,0],["فلو جبيت إنعامهم بأنامل","لما اختدمت أمثالهم خدمة العسف",29,"ف",1,0],["فَلَو جُعِلَت نَفسٌ لِنَفسٍ وِقايَةً","لَجُدتُّ بِنَفسي أَن تَكونَ فِداكُما",30,"م",2,0],["فلوْ جِئْتُها بالبَدْرِ تاجاً مُكَلَّلاً","بِدُرِّ الدّرارِي أو بجَوْزائِهِ قُرْطا",31,"ط",2,0],["فلو جاورتهم لملئت كبرا","يخيم بين جيدك والنجاد",32,"د",1,0],["فلو جزت رمل المنحنى يوم جازه","لطاحت محاني أضلعي في محانيه",33,"ي",2,0],["فلو جاء دهري بهذا السرور","ولم يمس فيه حسين عفيرا",34,"ر",2,0],["فلو جحد البصير طلوع شمس","ابى لطلوع هذا البدر جحدا",35,"د",2,0],["فلو جأروا للَه لم يبقَ مُمرضٌ","ولكنَهم ظَنُّوا بأن ليسَ وارِدُ",36,"د",1,0],["فَلُّوْجَةُ الأَحْرَاْرِ مَوْئِلُ عِزَّةٍ","مَهْمَاْ طَغَى الأَوْبَاْشُ لاْ تَنْقَاْدُ",37,"د",1,0],["فلو جاز أن تُسمى الرجالُ بِخُلْقِها","لكانَ اسمُ خالي بينها: السيد النُّبلُ",38,"ل",1,0],["فلو جاءَ الخليلُ وسيبويهٌ","لعادا عندنا أدبًا مريضا",39,"ض",2,0],["فلو جزيناك عز الدين غالية","من أعبق الشكر لم تنهض جوازينا",40,"ن",2,0],["فلّوجَة َ النصر ِ كم أثلجْت ِ بي لَهَبا","وكم كَسيْت ِ ابتساما ً وجْه َ محزون",41,"ن",1,0],["فلو جاز قطع الأرض بالسير نحوها","عليك لقد والله كنت أسيرها",42,"ر",3,0],["فلُّوجة الأنبارِ تحْكي ظلمَها","والطفلُ قد شاختْ بهِ الأيامُ",43,"م",1,0],["(فلْوجَةُ) الشَّرَفِ الْمُقَاوِمِ رَايَة","رَفَّتْ عَلى الْودْيَانِ وَالْهَضَبَاتِ",44,"ت",1,0],["فلو جاء مُراً طعمه لا يرعكم","فمِن جُرحكم يا نخلة الحُزن ينزف",45,"ف",1,0],["فلُّوجةُ الخيرِ قد هبَّتْ بواسلُها","والعامريَّةُ بركانٌ من الغضبِ",46,"ب",1,0]]}