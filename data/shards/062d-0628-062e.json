{"poems":[[23,"عين جودي بدمعك المنزور","https://www.aldiwan.net/poem21412.html","الخفيف"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123085","المديد"],[5431,"والحب لا يتقسمُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=198932",""],[5648,"ليال البعد","https://www.poetsgate.com/ViewPoem.aspx?id=154828",""]],"verses":[["حِبَّ خَيرِ الأَنامِ طُرّاً جَميعاً","سَيِّدِ الناسِ حُبُّهُ في الصُدورِ",0,"ر",1,0],["حُبُّ خير الرسل مُذ سكنا","في فؤادي رحّل الوَسَنا",1,"ن",2,1],["حبٌَ خرافيٌ هنا","بل إنّ حبّك أعظمُ",2,"م",1,0],["حبٍ خفي وماخفى داخل الكيس","تراه اعظم ياغزال البوادي",3,"د",2,0]]}