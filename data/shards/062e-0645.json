انت جفوني لما لم تفض بدمي","https://www.aldiwan.net/poem2780.html","البسيط"],[573,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"]],"verses":[["خَميصاً مِنَ الأَشجانِ لا يوضِعُ الهَوى","بَقَلبي فَلا اِجتازَ الغَرامُ بِبالي",0,"ي",1,0],["خِماصاً تُساوِكُ بِالمُجرِمينَ","بِعُقلِ الوَجا وَقُيودِ الكَلالِ",1,"ل",1,0],["خُمُولُ الفَتى خَيرٌ مِنَ الذِكرِ بِالخَنا","وَجَرِّ ذُيولِ المُندِياتِ الفَواضِحِ",2,"ح",1,0],["خَمايِصاً نُحاضِرُ الذَيابا","يَحمِلنَ أُسداً في الوَغى غِضابا",3,"ب",2,0],["خَمسَةٌ لا يَجِدُ الحا","سِدُ فيهِم ما يَعيبُهْ",4,"ب",2,0],["خَميلةُ ذِكْرٍ جادَها واكِفُ الهُدَى","فمِنْ حِكمَةٍ تُرْوَى ومِنْ آيةٍ تُتْلَى",5,"ل",2,0],["خَمرَةٌ في بابِلٍ قَد صُهرِجَت","هَكَذا أَخبَرَ حاخامُ اليَهود",6,"د",1,1],["خَمرَةً قيلَ إِنَّهُم عَصَروها","مِن خُدودِ المِلاحِ في يَومِ عُرسِ",7,"س",1,0],["خَمسونَ عاماً في الجِهادِ كِلاهُما","شاكي اليَراعَةِ طاهِرُ الجِلبابِ",8,"ب",1,0],["خَمراً تَخالُ شُعاعَها في كَأسِها","بَرقاً تَأَلَّقَ أَو نُضاراً سائِلا",9,"ل",2,0],["خَمَدَتْ بِيَ النَّارُ الَّتِي","رَفَعَتْ بِعَيْنِ العَصْرِ شَأْنِي",10,"ن",2,0],["خَمْسُونَ عَاماً تَقَضَّتْ فِي مُجَاهَدَةٍ","شَرِيفَةٍ بَيْنَ تَأثِيلٍ وَبُنْيَانِ",11,"ن",1,0],["خَمسَةُ رَهطٍ دَعا الاِلَهَ بِهِم","آدَمُ مِن ذَنبِهِ فَأَرضاهُ",12,"ه",1,0],["خَميصُ الحَشا مُخلَولِقُ الظَهرِ أَجمَعَت","لَهُ لَقَحاً مِرباعُها وَنَزورُها",13,"ر",3,0],["خمس تجعل الثريّا","والقمر يجعلّ غرّا",14,"ر",2,0],["خمسون قالت لفكرٍ كان ذا أدبٍ","أبعد خمسين منِّي تبتغي الأدبا",15,"ب",2,0],["خمرة بالجام ناهضةٌ","نهضة الأرواح بالجثث",16,"ث",1,0],["خمريّ ثغرٍ فما نفسٌ بصاحبةٍ","تبريّ خدّ فما دمعٌ بمكتنز",17,"ز",1,0],["خِماصٌ بأيديهم خِماصٌ عَفائفٌ","عن الغَيّ لم يخبث لها قطُّ آكالُ",18,"ل",1,0],["خَمساً وَعِشرينَ ثُمَّ اِستَدرَعَت زَغَباً","كَأَنَّهُنَّ بِأَعلى لَعلَعٍ رِجَعُ",19,"ع",1,0],["خمسة طاروا من عيون الشباب","فوق طيارة كمثل العقاب",20,"ب",1,1],["خمسون عاما في البلاد يسوقها","بالعنف عاما والهوادة عاما",21,"م",2,0],["خمسة بالشام بعدك قاموا","ملء عين اللدات والحساد",22,"د",1,0],["خَمائِلاً كَأَنَّها","بَقِيَّةٌ مِن ذي يَزَن",23,"ن",1,0],["خَميلَةُ اللَهِ وَشَّتها يَداهُ لَكُم","فَهَل لَها قَيِّمٌ مِنكُم وَجَنّانُ",24,"ن",1,0],["خَميسٌ بِشَرقِ الأَرضِ وَالغَربِ زَحفُهُ","وَفي أُذُنِ الجَوزاءِ مِنهُ زَمازِمُ",25,"م",1,0],["خَمائصُ طيرٍ تغتدي من وكُورِها","فتلقُطُ حبّاتِ القلوب وتكْرَعُ",26,"ع",1,0],["خميسٌ أقاصي الشرقِ تُرزم تحته","وترتَجُّ منه أُخرياتُ المغاربِ",27,"ب",1,0],["خَمرٌ وَسِحرُ مازَجا ماءَ النَدى","مِن فَضلِ كَأسِكَ يا أَبا العَبّاسِ",28,"س",1,0],["خَمسينَ أَبلَيتُ في التَصابي","كَهلاً وَفي دَولَةِ الغُلامِ",29,"م",1,0],["خَميصٌ مِنَ الوُدِّ المُقَرَّبِ بَينَنا","مِنَ الشُنءِ رابي القُصرَيَينِ بَطينُ",30,"ن",1,0],["خمسون عاماً.. وأجزائي مبعثرةٌ..","فوق المحيط.. وما في الأفق مصباح",31,"ح",1,0],["خَمسونَ أَلفاً كُلُّها راجِحٌ","حُسناً لَها في كُلِّ كيسٍ صَرير",32,"ر",1,0],["خَمِدَت لِفَضلِ وِلادِكَ النيرانُ","وَاِنشَقَّ مِن فَرَحٍ بِكَ الإيوانُ",33,"ن",1,1],["خمسون عاماً وهي وارفةُ الجنى","تحت الربيع دؤوبة الأثمارِ",34,"ر",1,0],["خمائلُ الروض بأعطارها","لم تَشجُني إلا على نفحتك",35,"ك",1,0],["خميلتنا تهفو إليها قلوبنا","وأي فؤاد للخميلة ما هفا",36,"ف",2,0],["خمسونَ زُنَتْ مليئاتٍ حقائبُها","من التجاريب بِعناها بعشرينا",37,"ن",2,0],["خُمصانَةٌ قَلِقٌ مُوَشِّحُها","رَودُ الشَبابِ عِلابُها عَظمُ",38,"م",1,0],["خُمصانَةٌ كَالمَهاةِ آنِسَةٌ","لَم يَغذُها مِن مَعِيشَةٍ رَنَقُ",39,"ق",1,0],["خُمصانَةٌ جائِلٌ رَودٌ مُوَشَّحُها","وَلا يَجُولُ لَها في الساقِ خِلخالُ",40,"ل",1,0],["خَميصَةُ ما تَحتَ الثِيابِ كَأَنَّها","عَسيبٌ نَما في ناضِرٍ لَم يُخَضَّدِ",41,"د",1,0],["خمسةٌ كُلُّهم أُصيبوا بداءٍ","والرَّدَى من جنودِهِ الأَدوَاءُ",42,"ا",2,0],["خمسةٌ طُهِّرَتْ بِقَطْعِهِم الأَر","ضُ فَكَفُّ الأَذى بهم شَلَّاءُ",42,"ا",2,0],["خُمولٌ وإقتارٌ وفي يدِكَ الغِنى","فمَحْياً فإنّي بين هاتينِ هالك",43,"ك",1,0],["خَمرَتُهُ في الكَأسِ مَمزوجَةٌ","كَالذَهَبِ الجاري عَلى فِضَّتِه",44,"ت",2,0],["خَمسينَ مِثلَ العَنَزِ المُشَدَّحِ","ما بَينَ مَذبوحٍ وَما لَم يُذبَحِ",45,"ح",1,0],["خَمسينَ مُستَحيىً إِلى مَذبوحِ","خَمسينَ مُستَحيىً إِلى مَذبوحِ",46,"ح",1,0],["خَمسينَ عاماً حَتّى إِذا هَرِمَت","وَاِخضَرَّ مِن نَبتِ نَبتِها الوَرَقُ",47,"ق",1,0],["خمرةً في عَرفِ مِشكٍ","عُصرت من نهرِ بيلِ",48,"ل",1,0],["خَمسَةُ آبائِهِمُ ما هُمُ","هُم خَيرُ مَن يَشرَبُ صَوبَ الغَمام",49,"م",1,0],["خُمورُ الريقِ لَسنَ بِكُلِّ حالٍ","عَلى طُلّابَهُنَّ مُحَرَّماتِ",50,"ت",1,0],["خُمِرتَ مِنَ الخُمارِ وَذاكَ نِجسٌ","وَأَمّا مِن خِمارِكَ فَهوَ سَعدُ",51,"د",1,1],["خَمِدَت خَواطِرُ مِنهُمُ وَتَكاثَفَت","أَرواحُهُم فَكَأَنَّها أَجسادُ",52,"د",1,0],["خَمسٌ بِراحَتِها تُعانُ وَراحَةٌ","بِأَشاجِعٍ تَدعو لِأَيدٍ ساعِدا",53,"د",2,0],["خَمساً وَعَشَراً أَجادوا في قِراءَتِهِم","وَوَفَّروا المالَ مِن خُمسٍ وَمِن عُشرِ",54,"ر",1,0],["خَمسونَ قَد عِشتُها فَلا تَعِشِ","وَالنَعشُ لَفظٌ مِن قَولِكَ اِنتَعِشِ",55,"ش",1,1],["خَمسَةَ في نَظيرِها خَمسُ خَمساتٍ","تَنَمَّت وَالنِصفُ في النِصفِ رُبعُ",56,"ع",1,0],["خَمسونَ جَرَّت عَلَيها الذَيلَ ذاهِبَةً","تَبّاً لِعَقلِكَ إِن شَيءٌ مَضى تَبَلَك",57,"ك",1,0],["خمَّارُها مُنْشِدٌ وسامرُها","حورٌ تلوَّى وفتيةٌ سكروا",58,"ر",3,0],["خمرةً ما قبَّلتْ غير شفاهِ الأنبياءِ","خمرةً في الغيبِ كانت قطراتٍ من ضياءِ",59,"ا",2,0],["خَمرةُ العشاقِ لا زالتْ ولا","جَفَّ من ينبوعها نهرُ الحياهْ",60,"ه",1,0],["خمرةً روميةً أو بابليهْ","إِسقنيها أنتِ يا أندلسيَّهْ",61,"ه",1,0],["خمسُ ليالٍ وأنت مني","متبوعةُ الظلِّ باشتهائي",62,"ي",1,0],["خَمْرةٌ مِن طيبِها قد سُبيَتْ","قَطَعَتْ نَحْوَكَ عَرْضَ السَّبْسَبِ",63,"ب",1,0],["خَمسةُ أَشطارٍ من الشُّطورِ","يُخرمُ مِنها أَوّلَ الصُّدورِ",64,"ر",1,0],["خَمَدَتْ تِلْكَ الْمَسَاعِي","وانْقَضَتْ تِلكَ النُّعُوتُ",65,"ت",1,0],["خُمَاسِيَّةٌ لَمْ تَدْرِ مَا اللَّيْلُ وَالسُّرَى","وَلَمْ تَنْحَسِرْ عَنْ صَفْحَتَيْهَا السَّتَائِرُ",66,"ر",1,0],["خَمْسُونَ لا تُنْسَى مِنَ الأحْوَالِ","مَرَّتْ وَأَنْتَ بِهَا لِسَانَ الحَالِ",67,"ل",1,1],["خَمْسٌ وَعِشْرُونَ قُمْتَ فِيهَا","بِأَمْرِهِمْ غَيْرَ مُسْتَرِيحِ",68,"ح",1,0],["خَمْسُونَ عَاماً تَقَضَّيْ","نَ ضَحْوَةً وَعِشَاءَ",69,"ا",2,0],["خمسٌ مِنَ السَّنَواتِ السُّودِ لا رجِعَتْ","صَبَّتْ عَلى رأسِ لُبْنانٍ بَلاياها",70,"ا",3,0],["خَمشَت ثُكلاً عَلَيهِ وَجنَةً","لَط