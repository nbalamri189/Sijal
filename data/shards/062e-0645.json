"ليس طيب الحياة غير وفاتك","https://www.aldiwan.net/poem34275.html","الخفيف"],[559,"أطلق الكاس بعد طول احتباس","https://www.aldiwan.net/poem34439.html","الخفيف"],[559,"فرحي يا فرحي يا فرحي","https://www.aldiwan.net/poem34662.html","الرمل"],[560,"طاب شرب المدام في الخلوات","https://www.aldiwan.net/poem69367.html","الخفيف"],[563,"طال شوقي لطول هذا البعاد","https://www.aldiwan.net/poem52967.html","الخفيف"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"خانت جفوني لما لم تفض بدمي","https://www.aldiwan.net/poem2780.html","البسيط"],[576,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"]],"verses":[["خَميصاً مِنَ الأَشجانِ لا يوضِعُ الهَوى","بَقَلبي فَلا اِجتازَ الغَرامُ بِبالي",0,"ل",2,0],["خِماصاً تُساوِكُ بِالمُجرِمينَ","بِعُقلِ الوَجا وَقُيودِ الكَلالِ",1,"ل",1,0],["خُمُولُ الفَتى خَيرٌ مِنَ الذِكرِ بِالخَنا","وَجَرِّ ذُيولِ المُندِياتِ الفَواضِحِ",2,"ح",1,0],["خَمايِصاً نُحاضِرُ الذَيابا","يَحمِلنَ أُسداً في الوَغى غِضابا",3,"ب",2,0],["خَمسَةٌ لا يَجِدُ الحا","سِدُ فيهِم ما يَعيبُهْ",4,"ب",2,0],["خمسة للقات ، خمسون لهم …","وانتهى دخلي ، وأنهى السلّ أمّي",5,"م",2,0],["خَميلةُ ذِكْرٍ جادَها واكِفُ الهُدَى","فمِنْ حِكمَةٍ تُرْوَى ومِنْ آيةٍ تُتْلَى",6,"ل",2,0],["خَمرَةٌ في بابِلٍ قَد صُهرِجَت","هَكَذا أَخبَرَ حاخامُ اليَهود",7,"د",1,1],["خَمرَةً قيلَ إِنَّهُم عَصَروها","مِن خُدودِ المِلاحِ في يَومِ عُرسِ",8,"س",1,0],["خَمسونَ عاماً في الجِهادِ كِلاهُما","شاكي اليَراعَةِ طاهِرُ الجِلبابِ",9,"ب",1,0],["خَمراً تَخالُ شُعاعَها في كَأسِها","بَرقاً تَأَلَّقَ أَو نُضاراً سائِلا",10,"ل",2,0],["خَمَدَتْ بِيَ النَّارُ الَّتِي","رَفَعَتْ بِعَيْنِ العَصْرِ شَأْنِي",11,"ن",2,0],["خَمْسُونَ عَاماً تَقَضَّتْ فِي مُجَاهَدَةٍ","شَرِيفَةٍ بَيْنَ تَأثِيلٍ وَبُنْيَانِ",12,"ن",1,0],["خَمسَةُ رَهطٍ دَعا الاِلَهَ بِهِم","آدَمُ مِن ذَنبِهِ فَأَرضاهُ",13,"ه",1,0],["خَميصُ الحَشا مُخلَولِقُ الظَهرِ أَجمَعَت","لَهُ لَقَحاً مِرباعُها وَنَزورُها",14,"ر",3,0],["خمس تجعل الثريّا","والقمر يجعلّ غرّا",15,"ر",2,0],["خمسون قالت لفكرٍ كان ذا 