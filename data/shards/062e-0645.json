{"poems":[[53,"وقد كنت آبي أن أذل لصبوة","https://www.aldiwan.net/poem29877.html","الطويل"],[53,"ذكرت على بعدها من منالي","https://www.aldiwan.net/poem29904.html","المتقارب"],[53,"ألا من عذيري في رجال تواعدوا","https://www.aldiwan.net/poem30644.html","الطويل"],[53,"لا لوم للدهر ولا عتابا","https://www.aldiwan.net/poem30736.html","الرجز"],[63,"زاهر العود وطيبه","https://www.aldiwan.net/poem45824.html","مجزوء الرمل"],[77,"تذكرت عهدا للشباب الذي ولى","https://www.aldiwan.net/poem35727.html","الطويل"],[86,"خمرة في بابل قد صهرجت","https://www.aldiwan.net/poem10938.html","الرمل"],[86,"أوشك الديك أن يصيح ونفسي","https://www.aldiwan.net/poem10941.html","الخفيف"],[86,"شيخان قد خبرا الوجود وأدركا","https://www.aldiwan.net/poem68877.html","الكامل"],[71,"قم فاسقنيها من سلاف صانها","https://www.aldiwan.net/poem3917.html","الكامل"],[93,"ماذا يريد الشعر مني","https://www.aldiwan.net/poem11203.html","مجزوء الكامل"],[93,"دعا الوفاء وهذا وقت تبيان","https://www.aldiwan.net/poem11236.html","البسيط"],[54,"أعد لله يوم يلقاه","https://www.aldiwan.net/poem27422.html","المنسرح"],[30,"تصابيت في أطلال مية بعدما","https://www.aldiwan.net/poem29578.html","الطويل"],[83,"الأمير بدر المواكب","https://www.aldiwan.net/poem54192.html","مجزوء الرمل"],[72,"يا سيدي يا ملاذ الطالبين ومن","https://www.aldiwan.net/poem18298.html","البسيط"],[72,"رب راح بت أشربها","https://www.aldiwan.net/poem18445.html","المديد"],[72,"قد أمكنت فرص اللذات فانتهز","https://www.aldiwan.net/poem18999.html","البسيط"],[51,"أبا حسن قد قلت لو كان فعال","https://www.aldiwan.net/poem65941.html","الطويل"],[29,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[89,"خمسة طاروا من عيون الشباب","https://www.aldiwan.net/poem44625.html","الخفيف"],[85,"أعطى العهود وأقسم الأقساما","https://www.aldiwan.net/poem7050.html","الكامل"],[85,"راية الموت فوق هام العباد","https://www.aldiwan.net/poem7752.html","الخفيف"],[85,"عصفورتان في الحجاز","https://www.aldiwan.net/poem7997.html","مجزوء الرجز"],[85,"قم ناج جلق وانشد رسم من بانوا","https://www.aldiwan.net/poem63693.html","البسيط"],[43,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[62,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[62,"لقاء الأماني في ضمان القواضب","https://www.aldiwan.net/poem52506.html","الطويل"],[45,"ما أنس من شيء فلست بناس","https://www.aldiwan.net/poem64607.html","الكامل"],[45,"وفي بقايا الفؤاد نار","https://www.aldiwan.net/poem66649.html","مجزوء البسيط"],[28,"أأسلمتني للموت أمك هابل","https://www.aldiwan.net/poem5629.html","الطويل"],[99,"القصيدة الدمشقية","https://www.aldiwan.net/poem6529.html","عموديه"],[49,"من صدق الحب لأحبابه","https://www.aldiwan.net/poem64210.html","السريع"],[66,"خمدت لفضل ولادك النيران","https://www.aldiwan.net/poem41545.html","الكامل"],[97,"شَجنٌ على شَجنٍ وحرقةُ نارِ","https://www.aldiwan.net/poem24753.html","الكامل"],[97,"إني على كاسي أعيد السنين","https://www.aldiwan.net/poem24921.html","السريع"],[97,"دعوت فلبينا ودارك كعبة","https://www.aldiwan.net/poem24932.html","الطويل"],[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[40,"أقوى من آل ظليمة الحزم","https://www.aldiwan.net/poem42256.html","أحذ الكامل"],[40,"إن الخليط الذين كنت","https://www.aldiwan.net/poem42265.html","المنسرح"],[40,"أقوت تعرة فالإصغاء فالخال","https://www.aldiwan.net/poem42276.html","البسيط"],[22,"آثرت إدلاجي على ليل حرة","https://www.aldiwan.net/poem21644.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[48,"يا ذا الذي يخطر في مشيته","https://www.aldiwan.net/poem62467.html","الطويل"],[48,"لا صيد إلا بالصقور اللمح","https://www.aldiwan.net/poem62542.html","الرجز"],[48,"قد أغتدي بزرق صبيح","https://www.aldiwan.net/poem62543.html","الرجز"],[48,"يا ليلة طاب لي بها الأرق","https://www.aldiwan.net/poem64420.html","المنسرح"],[48,"أسقياني من شمول","https://www.aldiwan.net/poem66633.html","مجزوء الرمل"],[7,"هذا غلام حسن وجهه","https://www.aldiwan.net/poem1964.html","السريع"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[46,"خمرت من الخمار وذاك نجس","https://www.aldiwan.net/poem22404.html","الوافر"],[46,"الله أكبر ما اشتريت بضاعة","https://www.aldiwan.net/poem22414.html","الكامل"],[46,"يا صاع لست أريد صاع مكيلة","https://www.aldiwan.net/poem22438.html","الكامل"],[46,"قد باشروك بمكروه أديت به","https://www.aldiwan.net/poem22664.html","البسيط"],[46,"خمسون قد عشتها فلا تعش","https://www.aldiwan.net/poem22869.html","المنسرح"],[46,"إن دمعي نبع وما العود نبع","https://www.aldiwan.net/poem22948.html","الخفيف"],[46,"يا سيد هل لك في ظبي تغازله","https://www.aldiwan.net/poem23105.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39651","المنسرح"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39605","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30442","الرمل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42546","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55156","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54686","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116961","الرمل"],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[106,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[77,"تذكرت عهدا للشباب الذي ولى","https://www.poetsgate.com/ViewPoem.aspx?id=34196",""],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[103,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""]],"verses":[["خَميصاً مِنَ الأَشجانِ لا يوضِعُ الهَوى","بَقَلبي فَلا اِجتازَ الغَرامُ بِبالي",0,"ي",1,0],["خِماصاً تُساوِكُ بِالمُجرِمينَ","بِعُقلِ الوَجا وَقُيودِ الكَلالِ",1,"ل",1,0],["خُمُولُ الفَتى خَيرٌ مِنَ الذِكرِ بِالخَنا","وَجَرِّ ذُيولِ المُندِياتِ الفَواضِحِ",2,"ح",1,0],["خَمايِصاً نُحاضِرُ الذَيابا","يَحمِلنَ أُسداً في الوَغى غِضابا",3,"ب",2,0],["خَمسَةٌ لا يَجِدُ الحا","سِدُ فيهِم ما يَعيبُهْ",4,"ب",2,0],["خَميلةُ ذِكْرٍ جادَها واكِفُ الهُدَى","فمِنْ حِكمَةٍ تُرْوَى ومِنْ آيةٍ تُتْلَى",5,"ل",2,0],["خَمرَةٌ في بابِلٍ قَد صُهرِجَت","هَكَذا أَخبَرَ حاخامُ اليَهود",6,"د",1,1],["خَمرَةً قيلَ إِنَّهُم عَصَروها","مِن خُدودِ المِلاحِ في يَومِ عُرسِ",7,"س",1,0],["خَمسونَ عاماً في الجِهادِ كِلاهُما","شاكي اليَراعَةِ طاهِرُ الجِلبابِ",8,"ب",1,0],["خَمراً تَخالُ شُعاعَها في كَأسِها","بَرقاً تَأَلَّقَ أَو نُضاراً سائِلا",9,"ل",2,0],["خَمَدَتْ بِيَ النَّارُ الَّتِي","رَفَعَتْ بِعَيْنِ العَصْرِ شَأْنِي",10,"ن",2,0],["خَمْسُونَ عَاماً تَقَضَّتْ فِي مُجَاهَدَةٍ","شَرِيفَةٍ بَيْنَ تَأثِيلٍ وَبُنْيَانِ",11,"ن",1,0],["خَمسَةُ رَهطٍ دَعا الاِلَهَ بِهِم","آدَمُ مِن ذَنبِهِ فَأَرضاهُ",12,"ه",1,0],["خَميصُ الحَشا مُخلَولِقُ الظَهرِ أَجمَعَت","لَهُ لَقَحاً مِرباعُها وَنَزورُها",13,"ر",3,0],["خمس تجعل الثريّا","والقمر يجعلّ غرّا",14,"ر",2,0],["خمسون قالت لفكرٍ كان ذا أدبٍ","أبعد خمسين منِّي تبتغي الأدبا",15,"ب",2,0],["خمرة بالجام ناهضةٌ","نهضة الأرواح بالجثث",16,"ث",1,0],["خمريّ ثغرٍ فما نفسٌ بصاحبةٍ","تبريّ خدّ فما دمعٌ بمكتنز",17,"ز",1,0],["خِماصٌ بأيديهم خِماصٌ عَفائفٌ","عن الغَيّ لم يخبث لها قطُّ آكالُ",18,"ل",1,0],["خَمساً وَعِشرينَ ثُمَّ اِستَدرَعَت زَغَباً","كَأَنَّهُنَّ بِأَعلى لَعلَعٍ رِجَعُ",19,"ع",1,0],["خمسة طاروا من عيون الشباب","فوق طيارة كمثل العقاب",20,"ب",1,1],["خمسون عاما في البلاد يسوقها","بالعنف عاما والهوادة عاما",21,"م",2,0],["خمسة بالشام بعدك قاموا","ملء عين اللدات والحساد",22,"د",1,0],["خَمائِلاً كَأَنَّها","بَقِيَّةٌ مِن ذي يَزَن",23,"ن",1,0],["خَميلَةُ اللَهِ وَشَّتها يَداهُ لَكُم","فَهَل لَها قَيِّمٌ مِنكُم وَجَنّانُ",24,"ن",1,0],["خَميسٌ بِشَرقِ الأَرضِ وَالغَربِ زَحفُهُ","وَفي أُذُنِ الجَوزاءِ مِنهُ زَمازِمُ",25,"م",1,0],["خَمائصُ طيرٍ تغتدي من وكُورِها","فتلقُطُ حبّاتِ القلوب وتكْرَعُ",26,"ع",1,0],["خميسٌ أقاصي الشرقِ تُرزم تحته","وترتَجُّ منه أُخرياتُ المغاربِ",27,"ب",1,0],["خَمرٌ وَسِحرُ مازَجا ماءَ النَدى","مِن فَضلِ كَأسِكَ يا أَبا العَبّاسِ",28,"س",1,0],["خَمسينَ أَبلَيتُ في التَصابي","كَهلاً وَفي دَولَةِ الغُلامِ",29,"م",1,0],["خَميصٌ مِنَ الوُدِّ المُقَرَّبِ بَينَنا","مِنَ الشُنءِ رابي القُصرَيَينِ بَطينُ",30,"ن",1,0],["خمسون عاماً.. وأجزائي مبعثرةٌ..","فوق المحيط.. وما في الأفق مصباح",31,"ح",1,0],["خَمسونَ أَلفاً كُلُّها راجِحٌ","حُسناً لَها في كُلِّ كيسٍ صَرير",32,"ر",1,0],["خَمِدَت لِفَضلِ وِلادِكَ النيرانُ","وَاِنشَقَّ مِن فَرَحٍ بِكَ الإيوانُ",33,"ن",1,1],["خمسون عاماً وهي وارفةُ الجنى","تحت الربيع دؤوبة الأثمارِ",34,"ر",1,0],["خمائلُ الروض بأعطارها","لم تَشجُني إلا على نفحتك",35,"ك",1,0],["خميلتنا تهفو إليها قلوبنا","وأي فؤاد للخميلة ما هفا",36,"ف",2,0],["خمسونَ زُنَتْ مليئاتٍ حقائبُها","من التجاريب بِعناها بعشرينا",37,"ن",2,0],["خُمصانَةٌ قَلِقٌ مُوَشِّحُها","رَودُ الشَبابِ عِلابُها عَظمُ",38,"م",1,0],["خُمصانَةٌ كَالمَهاةِ آنِسَةٌ","لَم يَغذُها مِن مَعِيشَةٍ رَنَقُ",39,"ق",1,0],["خُمصانَةٌ جائِلٌ رَودٌ مُوَشَّحُها","وَلا يَجُولُ لَها في الساقِ خِلخالُ",40,"ل",1,0],["خَميصَةُ ما تَحتَ الثِيابِ كَأَنَّها","عَسيبٌ نَما في ناضِرٍ لَم يُخَضَّدِ",41,"د",1,0],["خمسةٌ كُلُّهم أُصيبوا بداءٍ","والرَّدَى من جنودِهِ الأَدوَاءُ",42,"ا",2,0],["خمسةٌ طُهِّرَتْ بِقَطْعِهِم الأَر","ضُ فَكَفُّ الأَذى بهم شَلَّاءُ",42,"ا",2,0],["خُمولٌ وإقتارٌ وفي يدِكَ الغِنى","فمَحْياً فإنّي بين هاتينِ هالك",43,"ك",1,0],["خَمرَتُهُ في الكَأسِ مَمزوجَةٌ","كَالذَهَبِ الجاري عَلى فِضَّتِه",44,"ت",2,0],["خَمسينَ مِثلَ العَنَزِ المُشَدَّحِ","ما بَينَ مَذبوحٍ وَما لَم يُذبَحِ",45,"ح",1,0],["خَمسينَ مُستَحيىً إِلى مَذبوحِ","خَمسينَ مُستَحيىً إِلى مَذبوحِ",46,"ح",1,0],["خَمسينَ عاماً حَتّى إِذا هَرِمَت","وَاِخضَرَّ مِن نَبتِ نَبتِها الوَرَقُ",47,"ق",1,0],["خمرةً في عَرفِ مِشكٍ","عُصرت من نهرِ بيلِ",48,"ل",1,0],["خَمسَةُ آبائِهِمُ ما هُمُ","هُم خَيرُ مَن يَشرَبُ صَوبَ الغَمام",49,"م",1,0],["خُمورُ الريقِ لَسنَ بِكُلِّ حالٍ","عَلى طُلّابَهُنَّ مُحَرَّماتِ",50,"ت",1,0],["خُمِرتَ مِنَ الخُمارِ وَذاكَ نِجسٌ","وَأَمّا مِن خِمارِكَ فَهوَ سَعدُ",51,"د",1,1],["خَمِدَت خَواطِرُ مِنهُمُ وَتَكاثَفَت","أَرواحُهُم فَكَأَنَّها أَجسادُ",52,"د",1,0],["خَمسٌ بِراحَتِها تُعانُ وَراحَةٌ","بِأَشاجِعٍ تَدعو لِأَيدٍ ساعِدا",53,"د",2,0],["خَمساً وَعَشَراً أَجادوا في قِراءَتِهِم","وَوَفَّروا المالَ مِن خُمسٍ وَمِن عُشرِ",54,"ر",1,0],["خَمسونَ قَد عِشتُها فَلا تَعِشِ","وَالنَعشُ لَفظٌ مِن قَولِكَ اِنتَعِشِ",55,"ش",1,1],["خَمسَةَ في نَظيرِها خَمسُ خَمساتٍ","تَنَمَّت وَالنِصفُ في النِصفِ رُبعُ",56,"ع",1,0],["خَمسونَ جَرَّت عَلَيها الذَيلَ ذاهِبَةً","تَبّاً لِعَقلِكَ إِن شَيءٌ مَضى تَبَلَك",57,"ك",1,0],["خمَّارُها مُنْشِدٌ وسامرُها","حورٌ تلوَّى وفتيةٌ سكروا",58,"ر",3,0],["خمرةً ما قبَّلتْ غير شفاهِ الأنبياءِ","خمرةً في الغيبِ كانت قطراتٍ من ضياءِ",59,"ا",2,0],["خَمرةُ العشاقِ لا زالتْ ولا","جَفَّ من ينبوعها نهرُ الحياهْ",60,"ه",1,0],["خمرةً روميةً أو بابليهْ","إِسقنيها أنتِ يا أندلسيَّهْ",61,"ه",1,0],["خمسُ ليالٍ وأنت مني","متبوعةُ الظلِّ باشتهائي",62,"ي",1,0],["خَمْرةٌ مِن طيبِها قد سُبيَتْ","قَطَعَتْ نَحْوَكَ عَرْضَ السَّبْسَبِ",63,"ب",1,0],["خَمسةُ أَشطارٍ من الشُّطورِ","يُخرمُ مِنها أَوّلَ الصُّدورِ",64,"ر",1,0],["خَمَدَتْ تِلْكَ الْمَسَاعِي","وانْقَضَتْ تِلكَ النُّعُوتُ",65,"ت",1,0],["خُمَاسِيَّةٌ لَمْ تَدْرِ مَا اللَّيْلُ وَالسُّرَى","وَلَمْ تَنْحَسِرْ عَنْ صَفْحَتَيْهَا السَّتَائِرُ",66,"ر",1,0],["خَمْسُونَ لا تُنْسَى مِنَ الأحْوَالِ","مَرَّتْ وَأَنْتَ بِهَا لِسَانَ الحَالِ",67,"ل",1,1],["خَمْسٌ وَعِشْرُونَ قُمْتَ فِيهَا","بِأَمْرِهِمْ غَيْرَ مُسْتَرِيحِ",68,"ح",1,0],["خَمْسُونَ عَاماً تَقَضَّيْ","نَ ضَحْوَةً وَعِشَاءَ",69,"ا",2,0],["خمسٌ مِنَ السَّنَواتِ السُّودِ لا رجِعَتْ","صَبَّتْ عَلى رأسِ لُبْنانٍ بَلاياها",70,"ا",3,0],["خَمشَت ثُكلاً عَلَيهِ وَجنَةً","لَطَمَت مِنها صَباحاً وَشَفَق",71,"ق",1,0],["خمدوا فالقومُ صرعى","تحتَ أسقاف الصخورِ",72,"ر",1,0],["خمرةً لم تَطش بلُبِّ لبيبٍ","حُبُّها شُعبةٌ من الإيمان",73,"ن",1,0],["خمسون عامًا قد طواهَا مثلما","تَطْوِى السلافةُ الدِّنَانِ الأَعْصُرا",74,"ر",2,0],["خمسين عامًا تَحْملي","ن بِبَطْنِكِ النصَّر الوليد",75,"د",1,0],["خُمارٌ إذْ جهلْنَاك اعْتَرانا","وفارقَنَا برؤيتك الخُمارُ",76,"ر",1,0],["خميلة ذكر جادها واكف المنى","فمن حكمة تروى ومن آية تتلا",77,"ل",2,0],["خمّنوا مايقول نهدي لنهدي","كيف يُفضي تشوُّقي لُمشيقي",78,"ق",2,0],["خمر وفسق وأصنام مؤلهة","ووأد نفس ومال بات ينتهب",79,"ب",1,0],["خمسٌ وعشرونَ انقضَتْ وكأنَّها","بشخُوصِها خَبَرٌ منَ الأخبارِ",80,"ر",1,0],["خمَدت عبقريةٌ طالما احتيجتْ","لتُلقي على الخطوب شُعاعا",81,"ع",2,0]]}