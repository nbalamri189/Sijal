9360",""],[5277,"فاطمة","https://www.poetsgate.com/ViewPoem.aspx?id=195091",""],[5302,"موطن العز","https://www.poetsgate.com/ViewPoem.aspx?id=201148",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5461,"استريحي يا الظنون الثايرة","https://www.poetsgate.com/ViewPoem.aspx?id=503",""],[5561,"لملمْ عصورَكَ ...","https://www.poetsgate.com/ViewPoem.aspx?id=197720",""],[5776,"فهارس الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199335",""],[402,"أعلى مكانتك الإله وشرفا","https://www.poetsgate.com/ViewPoem.aspx?id=36543",""],[5809,"الثمن","https://www.poetsgate.com/ViewPoem.aspx?id=205289",""],[5873,"واقعنا والقدس","https://www.poetsgate.com/ViewPoem.aspx?id=215784",""],[5969,"روايةٌ صوفية","https://www.poetsgate.com/ViewPoem.aspx?id=207465",""],[6023,"من يبغ بالفضل معاشاً يمت","https://www.poetsgate.com/ViewPoem.aspx?id=123920",""],[6056,"بالخير متبرّع","https://www.poetsgate.com/ViewPoem.aspx?id=156715",""],[6093,"أحفورة","https://www.poetsgate.com/ViewPoem.aspx?id=197812",""],[6097,"أيّار","https://www.poetsgate.com/ViewPoem.aspx?id=186068",""],[5724,"قف يا زمان معي بالله وانتحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55151&r=&rc=18",""],[5355,"من أول الهجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86685&r=&rc=8",""],[572,"منْ يَبْكِ من وجدٍ على هالِكٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9191&r=&rc=48",""]],"verses":[["مَنْ يَبِتْ مِنْ غُرُورِ دُنْيَا بِهَمٍّ","يَلْدَغُ الْقَلْبَ أَكْثَرَ اللهُ هَمَّهْ",0,"م",2,0],["مُنّي بأيْسَرِ نائِلٍ تُحْيي بهِ","قلْباً تقسَّمَ في الهَوى أعْشارُهُ",1,"ر",2,0],["مِنّي بِأَسوَأَ حالاً حينَ قاطَعَني","هَذا الصَديقُ فَهَلّا كانَ يَدَّكِرُ",2,"ر",1,0],["من يباريك سماحاً وندى","من يباريك بديعاً وبيانا",3,"ن",2,0],["مَنْ يَبْتَغِي الشَّمْسَ المُنِيرَةَ بِالأَذَى","تَرْأَفْ بِهِ مَهْمَا يَضِلُّ وَتَهْدِهِ",4,"د",2,0],["مَنْ يَبْتَنِي لِلْعِلْمِ دَاراً إِنَّمَا","هُوَ يَبْتَنِي مُسْتَقَبِلَ الأَوْطَانِ",5,"ن",1,1],["مَنْ يُبَدِّدْ عَنْهُ الغَيَاهِبَ يُطْلِعْ","كَوْكَباً تَهْتَدِي بِهِ الأَحْلامُ",6,"م",1,0],["من يبع بالشباب شيباً فقد با","ع رخيصاً من العُلوق بغالِ",7,"ل",1,0],["منْ يبْذُلُ العُذْرَ في مثْلي لمثلِكُمُ","أوْ يَذْخَرُ النُّصحَ عن لهْفَانَ مجهودِ",8,"د",1,0],["من يبلُهُ اللَّه بتقبيلِها","أشبَّ ما كان يمُتْ عَبطه",9,"ط",2,0],["مِنّي بِأَسعَدَ نَفساً قَد نَزِلَت عَلى","قَومي الصَناديدِ أَبناءَ الصَناديدِ",10,"د",1,0],["مِنّي بِأَسعَدَ حَذّاً نَزَلتُ بِكُم","يا مَعشَرَ السادَةِ الغُرِّ المَيامينِ",11,"ن",1,0],["مَن يَبنِ مُلكاً أَو يَذُد","فَبِالقَنا المُجَرَّرَه",12,"ر",2,0],["مَن يُبلِغُ الخِنزيرَ عَنّي رِسالَةً","نُعَيمَ بنَ صَفوانٍ خَليعَ بَني سَعدِ",13,"د",1,1],["مَن يَبرِمُ الإِنتِقاضَ مِنها وَمَن","يُخمِدُ نيرانَها إِذا اِلتَهَبَت",14,"ت",1,0],["منْ يبعْ ذاتَ جمالٍ","كانَ لا يصبرُ عنها",15,"ه",2,1],["مَن يَبْعَثُ الهِمَمَ الكِبارَ تُعينُها","منّا نُفوسٌ بَرَّةٌ وَخِلالُ",16,"ل",1,0],["مَن يَبكِهِم يَبكِ عَلى","حُزنٍ وَيَصدُقُ كُلُّ مادِح",17,"ح",1,0],["مَن يَبغِ عِندِيَ نَحواً أَو يُرِد لُغَةً","فَما يُساعِفُ مِن هَذا وَلا هَذي",18,"ي",1,1],["مَن يُبدِ أَمرَكَ لا يَذمُمكَ في خَلَفٍ","وَلا جِهارٍ وَلَكِن لامَ مِن جَهِلَك",19,"ك",1,0],["مَنْ يُباريكَ والبيَاذِقُ في كَفْ","فَكَ يَغْلِبْنَ كلّ رُخٍّ وفِيل",20,"ل",1,0],["مَنْ يَبِيعُ الدُّنْيَا لَهُ خيْرُ زَادٍ","وَالَّذِي يَشْتَرِي لَه شَرُّ زَادِ",21,"د",1,0],["مَنْ يُبْرِيءُ الإِسْلاَمَ مِنْ تَهَمِ العِدَى","وَيَرُدُّ نَقْدَ النَّاقِدِينَ مُزَيَّفَا",22,"ف",2,0],["مَنْ يُبَاسِطْ فِيمَا عَلَى النَّاسِ يَنْعِيهِ","يُيَسِّرْ تَثْقِيفَ مَا فِيهِ عُسْرُ",23,"ر",1,0],["مَنْ يَبْغِ فِي الدُّنْيَا مِثَالاً لِمَا","يَبْلغ مِنْهَا الفَطِنُ الجَسْرُ",24,"ر",1,0],["مَنْ يَبْغِ إِرْضَاءَ النَّدَى فَأَوَانُهُ","أَوْ يَبْغِ إِرْضَاءَ الْهُدَى فالمَوْضِعُ",25,"ع",1,0],["من يُباهي من يُضاهِي","ما لمصرٍ في مدَى المجدِ قرينْ",26,"ن",1,0],["مَنْ يبِتْ عِنْدَهُ الْهِزَبْرُ نَزِيلاً","كانَ مِنْ قَبْلِ زادِهِ مَأكُولاَ",27,"ل",2,0],["من يَبْن مُلكًا شامخًا، لم يبْنه","بشُواظ نيرانٍ، وَبيض صِفاح",28,"ح",1,0],["مَنْ يبتغي من خَلفِهِ","جاهًا ومالاً يستحلُّه",29,"ل",2,0],["مَنْ يَبْنِ بالصُّفَّاح صَرْحًا، لم يخفْ","عَصْفَ الرياح الهُوج حولَ قِبابه",30,"ب",2,0],["مني بأيسر نائل تحي به","قلبا تقسم في الهوى أعشاره",31,"ر",2,0],["مني بأسعد حظا مذ نزلت بكم","يا معشر السادة الغرّ الميامين",32,"ن",1,0],["مِنِّي بأسْوَأَ حالاً حِينَ قاطعنِي","هذا الصَّديقُ فهَلاَّ كان يَذَّكِرُ",33,"ر",1,0],["مِن يَبت سَهران في كسب العُلا","حَرم الغَمض عَلَيهِ وَالمَنام",34,"م",1,0],["من يبكِ حَولا يُعذِرْ فكيف بمن","بكَى على رسم دارهم حِجَجا",35,"ج",2,0],["مَنْ يُبْلِغُ الأَهْلَ أَنِّي بَعْدَ بَيْنِهِمُ","جَالَسْتُ بَدْرَ هُدىً بِالشَّمْسِ مُعْتَجِرَا",36,"ر",2,0],["من يُباريكَ يا مُنى النَفس حُسناً","لا وَعينيكَ لست مِمَّن يُبارى",37,"ر",2,0],["مُنىً بَيْنَ الرجا واليأْ","سِ مثل الشمسِ في السحبِ",38,"ب",1,0],["منىً بعثَرتها رياح الزمان","وألقت بها في ضمير اليباب",39,"ب",1,0],["من يبتغ الشمس المنيرة بالأذى","ترأف به مهما يضل وتهده",40,"د",2,0],["من يبتغي منكم الحورا يعانقها","فليسأل اللَه كي يحظى بها سحرا",41,"ر",2,0],["من يبذلُ الحب لا يُجزي عوارفه","إلاّ صدىً في حنايا قلبه ألحاني",42,"ن",2,0],["من يبْكِ من وَجْدٍ على هالِكٍ","فإنما أبكي على شُسْتَجَهْ",43,"ج",2,1],["من يبذل الذات والمجهود عن وطن","حسن الثناء عليه بعض ما وجبا",44,"ب",2,0],["من يبذر الحسنات بشره غدا","بسعادة وحصاد ما كرماً بذر",45,"ر",1,0],["من يباريه بمضمار وفي","كل الميادين الأمير له القصب",46,"ب",1,0],["منيبيت مجدٍ قد سمَت بقبابه","أقيالُ لخم في الزمان الأوّل",47,"ل",1,0],["مَن يُباريه في اِهتِمام وَحَزم","وَعَفاف بِهِ تُصان المَراتب",48,"ب",1,0],["مني بوصلك أو مني بنيل منى","فما اصطباري لا من ولا أمل",49,"ل",1,0],["مَن يَبتَغي المَجدَ فَليَبذُلْ تَواضُعَه","فَفي التواضُعِ يُبنى العِزُّ وَالشّرَفُ",50,"ف",1,0],["مَن يَبِعها في هَواهُ رَبِحا","إِذ لَها باعَ بِأَغلى ثَمنِ",51,"ن",1,0],["مَن يَبعها في الهَوى إِن صَحَّحا","بَيعها فَهوَ الّذي لَم يغبنِ",51,"ن",1,0],["من يبتغي الأنذالَ صحباً له","يجعلْ لهم في بيته قُرْبه",52,"ب",2,0],["من يبرئ الأكْمَة المَحَّيرَ عنْ","إذن إلهي ويَبْرأ النَّسَما",53,"م",2,0],["مني بِسؤلي يا حيوتي وَاِسمَحي","بِشِفاءِ قَلبي قَد كَفاني ما جَرى",54,"ر",2,0],["من يباهي ومن عسى أن يباهي","مثل نامي بنفسه وذويه",55,"ي",2,0],["مَن يُباهي أَو يُضاهي","جدنا خَير الجُدود",56,"د",1,0],["مُنِيبٌ مَتى استَنصرتَهُ لِمُلِمَّةٍ","دَهَتكَ أَتاكَ الغَوثُ يَقدُمُهُ النَصرُ",57,"ر",1,0],["من يَبِت صاحيَ الفؤادِ خَلِيّاً","فَلَقَد بتُّ بالنفاخِ شجِيّا",58,"ي",2,1],["منيبٍ كلما تعبت يداه","لخير الدين والدنيا استراحا",59,"ح",2,0],["من يبتغي هذا المدا","د يحب بنت الجوهري",60,"ر",2,0],["مُنيباً وَقَد أَمسى تَقَدَّمَ وِردَها","أُقَيدِرُ مَحموزُ القِطاعِ نَذيلُ",61,"ل",1,0],["من يباهي يوم الكساء به ال","له وآياته بمن أوجاها",62,"ا",3,0],["مُنّي بِوُقُوفِكِ آمِرَةً","بِطَلاقِ أَسِيرِكِ وَانطَلِقي",63,"ق",2,0],["من يبلغ النائين أن جباهنا","عفرت وان الحبل في الأعناق",64,"ق",1,0],["من يباريك في العلوم إذا ما","جاش آذِيُّ بحرك الرجّاف",65,"ف",1,0],["مني بمن كان لي جليساً","فيه معان وفيه ظرف",66,"ف",1,0],["مَن يبتغي العصمةَ في حالة","دائمة يستلزم الصدقا",67,"ق",2,0],["مُنىً بِمِنىً نِلتُها لَيتَها","تَدومُ إِلى الزَمَنِ الآخِرِ",68,"ر",1,0],["مني بواحدة إن كنت واحدتي","وإنْ شفعتَ فإنَّ الشفع يشفع لي",69,"ل",2,1],["من يبكِ حولاً لا يكون له","عذرٌ لدينا حين يعتذر",70,"ر",1,0],["من يَبغِ حُورَ الخُلد بها","من يخطبُ حُورَ الخُلدِ بها",71,"ه",2,0],["مَن يُبلِني بالوُدِّ يَوماً أجزِهِ","بِالقَرضِ مِثلَ مثالِه بِمِثالي",72,"ل",2,0],["من يبصر الحق يستبصر بأن له","عند الجليل على أكوانه مهَلا",73,"ل",2,0],["من يباريه وهو بين البرايا","طيب الجاش نفسه مطمئنه",74,"ن",2,0],["مني بكم شمها فكان بها","علاج دائي وبرء أسقامي",75,"م",2,0],["من يباري أبا الأئمة فضلاً","وهو فصل القضا بكل قضيه",76,"ي",2,0],["من يبتغي من شدة سواهُ","من يغفرُ الذنوب الا اللَه",77,"ه",1,0],["مَن يبْغِ طُولَ العمرِ لم يضْجَرْ بما","ساق الزمانُ له فكدَّر حُسْنَهُ",78,"ه",1,1],["من يباهيك أو يساويك فخراً","وجميع الورى تسير وراكا",79,"ك",2,0],["مِنْ يِبَدِّلني يا هالناسِ","بْقَلْب لِهْ لِب وعِمَل حِرْفه",80,"ف",2,0],["من يُبيد الأَكدار وَالأَقذاء","وَيعيد الأَنوار وَالأَضواءَ",81,"ا",2,1],["من يباريك في الكلام وما الفا","ضل يوم الرهان كالمفضول",82,"ل",1,0],["من يبتهم ظهر الإسلام فانتكست","لعصبة الشرك أصنام وأوثان",83,"ن",1,0],["مَن يُبلِغ قِصَّتي فَتاةَ الحيِّ","مَن يَنشُرُ أَخباريَ بَعدَ الطيِّ",84,"ي",1,1],["منى بوصال لمن بهجرك صال","ما حال به الحال عن هواك ولا حاد",85,"د",1,0],["مُنّي بِوَصلِكِ يا مُنى لِمُتَيَّمٌ","أَودى بِهِ مِن صَدِّك الإِشفاقُ",86,"ق",1,0],["مَن يَبتَغي طول الحياة بذلَّةٍ","ميتٌ عن الدنيا بحال حياةِ",87,"ه",1,1],["منيباً خاشعاً لله ثبتاً","حميد السعي لأوقات الشناعه",88,"ع",2,0],["مَن يَبغِ بِالمالِ سِوى إِنفاقِه","فَإِنَّهُ يُنفِقُ مِن أَخلاقِه",89,"ه",1,0],["من يبتلي من أهله بمنغص","يصبر فما أحد بغير منغص",90,"ص",1,1],["من يبتغ الود من الناس","يكن لما قالوه بالناسي",91,"ي",1,1],["من يبتغ السؤدد لا بد أن","يرهقه الجهد فلا يضجر",92,"ر",1,1],["من يبغ مقدار الذي يحتاجه","من أخيه يبق مخيبا متروكا",93,"ك",2,0],["من يبذل روحَهُ بسيفٍ وسهام","يستأهل أن يقعد والناسُ قيام",94,"م",1,0],["مَن يباريكم في اعتزازٍ ومجد","وافتخارٍ بسيدِ الشفعاء",95,"ا",2,0],["من يبتغي يأكلُ اللذاتِ مبتهجاً","ويَسْحَبَنَّ ذيولَ اللهوِ في الزمنِ",96,"ن",1,0],["من يبيع الروح مره .. اجزم ان ما منه فود","اتركه ماضيك عنده .. ثم لمه .. واشعله",97,"ل",2,0],["منيبا إلى دار الخلود تأهبا","ليوم نزول الموت أهبة لهفان",98,"ن",1,0],["من يبارزهم يلاقي المنايا","يفترسن الكماة والشجعانا",99,"ن",2,0],["مَنْ يُبذِرِ الخيَرَ لا يُعدَمْ من الثمَرِ","فأنَّ زرعَ النوى في أوّل الشجَرِ",100,"ر",1,1],["من يبي بالله يفتح لي غلق صدره وابوح","ضاقت الدنيا بشاعر طيب قلبه ضيعه",101,"ع",2,0],["من يبتسمْ يبتسمْ في وجهه أمل","إن الأمانيَ طوعا سوف تأتيه",102,"ي",2,0],["مَن يبتغِ العزَّ يسلك دربَ من سبقوا","على طريقِ الهدى فالحقُّ نادانا",103,"ن",2,0],["مُنِّي بطيفِ خَيالٍ لا بنفسِكِ كَي","أرى هَنِيَّ وصالٍ فاقِدَ اللُّومِ",104,"م",1,0],["من يُبلغُ الأعرابَ أن بنفطهم","ناراً ستحرق أرضهم وهم الشُّواءْ",105,"ا",2,0],["مُنيبًا عائدًا وَجِلاً","بعزمِ المؤمنِ المُخشع",106,"ع",1,0],["من يباريه علا علما حجى","كرما فخرا تقي فضلا ومنا",107,"ن",2,0],["منْ يبتغي الحِلَّ يمشي في طرائقهِِ","ومنْ يشذُّ فلا تُنعيهِ سيدتي",108,"ت",2,0],["من يباهي بموطن مثلك اليو","م ومن لا يرى سواك منارا",109,"ر",2,0],["من يبذل النفس ه