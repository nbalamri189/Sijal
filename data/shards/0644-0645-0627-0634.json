{"poems":[[75,"أَما وَأَلحاظٍ مِراضٍ صِحاح","https://www.aldiwan.net/poem11927.html","السريع"],[53,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[53,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[80,"يا غيم عيني أقوى منك تهتانا","https://www.aldiwan.net/poem14211.html","البسيط"],[47,"أحرى الخطوب بأن يكون عظيما","https://www.aldiwan.net/poem65661.html","الكامل"],[47,"أترى الزمان يعيد لي أيامي","https://www.aldiwan.net/poem65674.html","الكامل"],[30,"أنسيت صحبتها ومن يك مقرفا","https://www.aldiwan.net/poem5255.html","الكامل"],[68,"عين حبي أعيذها بالله","https://www.aldiwan.net/poem39639.html","الخفيف"],[68,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[46,"كشفتك الأيام يا إنسان","https://www.aldiwan.net/poem29998.html","الخفيف"],[71,"لما شتت عيني ولم","https://www.aldiwan.net/poem28830.html","مجزوء الكامل"],[71,"يا سائلي عن الكلام المنتظم","https://www.aldiwan.net/poem28850.html","الرجز"],[71,"أغيد سكران نور شرق","https://www.aldiwan.net/poem29079.html","مخلع البسيط"],[77,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[50,"لم أشرك الناس يوم العيد في الفرح","https://www.aldiwan.net/poem62529.html","البسيط"],[52,"قل لفرخ الزنجي لا تشك ليثا","https://www.aldiwan.net/poem64736.html","الخفيف"],[52,"ومريضة مرض الهوى","https://www.aldiwan.net/poem64862.html","مجزوء الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54657","الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[108,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[185,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[208,"لقد توقفت لو أن الهوى وقفا","https://www.aldiwan.net/poem53240.html","البسيط"],[228,"يا من ترى الدنيا بثغر فتاة","https://www.aldiwan.net/poem41887.html","الكامل"],[280,"عندي نزاع ليس عنه نزوع","https://www.aldiwan.net/poem25487.html","الكامل"],[308,"نزهت طرفي في وجه ظبي","https://www.aldiwan.net/poem58024.html","مخلع البسيط"],[443,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[484,"غب التحية أنهي","https://www.aldiwan.net/poem36939.html","المجتث"],[591,"ومهفهف كالغصن في الميل","https://www.aldiwan.net/poem18013.html","أحذ الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97046","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48609","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77567","المتدارك"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77568","المتدارك"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77598","المتدارك"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59812","المجتث"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138112",""],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72307","الكامل"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126605","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65053","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64965","الرمل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77873","المجتث"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105873","الكامل"],[458,"","https://poetry.dctabudhabi.ae/diwan/poem/143128","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108465","الكامل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177823","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27394","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27819","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106876","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121184","السريع"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60873","البسيط"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141204","الدوبيت"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200587","المجتث"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110781","البسيط"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71357","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103981","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48311","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109976","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91377","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92139","الكامل"],[3928,"","https://poetry.dctabudhabi.ae/diwan/poem/131343","الكامل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199077","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36274","الدوبيت"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93304","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123519","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102736","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54393","الكامل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104529","الخفيف"],[5205,"خطرت وقد خطرت هواتف خاطري","https://www.poetsgate.com/ViewPoem.aspx?id=120991",""],[5210,"أتظن أني بعد بعدك باقي","https://www.poetsgate.com/ViewPoem.aspx?id=169358",""],[1043,"الشعر والناس","https://www.poetsgate.com/ViewPoem.aspx?id=93886",""],[5277,"مناجل الخجل","https://www.poetsgate.com/ViewPoem.aspx?id=186030",""],[5612,"هُوَ ذا الطَّريقْ","https://www.poetsgate.com/ViewPoem.aspx?id=179837",""],[5730,"كيف يحزن قلب أنت ساكنهُ","https://www.poetsgate.com/ViewPoem.aspx?id=210334",""],[5770,"هذي الملايين حقًا أمة العربِ","https://www.poetsgate.com/ViewPoem.aspx?id=178708",""],[5956,"الزوجُ أهمُّ شُغل ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182373",""],[5956,"لم أشبع من حب الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=183289",""],[5956,"لَمْ أشبع منك ولن أشبعْ","https://www.poetsgate.com/ViewPoem.aspx?id=206807",""],[6152,"لقاء على الشاطئ","https://www.poetsgate.com/ViewPoem.aspx?id=204740",""],[5309,"إن لم تعظنا الآي والسور","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573556",""],[6211,"تفاهات،تفاهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78242&r=&rc=11",""]],"verses":[["لَم أَشِمِ البَرقَ جَهاماً وَلَم","أَقتَدِحِ الصُمَّ بِبيضِ الصِفاح",0,"ح",1,0],["لمْ أُشكِهَا قطّ بِتَقْصِيرَةٍ","فيها ولا من حَيْفَةٍ حِفْتُهَا",1,"ت",3,0],["لم أشكُ من غيره عتومَ قِرىً","حتى قراني الغنى وما عتما",2,"م",2,0],["لمَّا شفعتَ أَخاكَ الفَتحَ تَتبعُهُ","لقاكُما اللَهُ غُفراناً وَرِضوانا",3,"ن",2,0],["لَم أَشكُ حُبَّكِ بِالنُحولِ وَلَم أُرِد","بِسَقامِ جِسمي أَن أَكونَ سَقيما",4,"م",2,0],["لَمّا شَهَرتَ السَيفَ مُزدَلِفاً بِهِ","قَلِقَ العُبَيدُ وَرامَ كُلَّ مَرامِ",5,"م",1,0],["لَمّا شَبِعتَ ذَكَرتَ ريحَ كِسائِها","وَتَرَكتَها وَشِتاؤُها هَرّارُ",6,"ر",1,0],["لَمّا شَهَرَ الحُبُّ مِنَ اللَحظِ نِصالِ","أَكثَرتُ عِتابَه وَقَد صَدَّ وِصالِ",7,"ل",1,0],["لَم أَشكُ جَورَ الحادِثاتِ وَلَم أَقُل","حالَت بِيَ الأَيّامُ عَن حالاتِها",8,"ت",3,0],["لِمَ أَشقى بِكُم وَيَسعَدُ غَيري","بِهَواكُم حُبّي إِذَن كَشخانُ",9,"ن",1,0],["لما شَتَتْ عيني ولمْ","ترفقْ لتوديعِ الفتى",10,"ت",2,1],["لما شكوتُ صدَّهُ رثى لي","وأقبلَ الغلامُ كالغزالِ",11,"ل",1,0],["لما شممتُ المدامَ منهُ","حددتهُ أربعينَ قُبْلَهْ",12,"ه",1,0],["لمّا شَدَدتَ بعبدِ اللّهِ عُروَتَهُ","أعزَزتَ منه مصونَ العِرض لم يَذِل",13,"ل",1,0],["لَم أَشرَكِ الناسَ يَومَ العيدِ في الفَرَحِ","وَلا هُمُ شَرِكوني في جَوى التَرَحِ",14,"ح",1,1],["لَم أُشَفِّع فيكَ الرِجالَ وَلَو عا","شَ أَخوكَ القَوّاسُ شَفَّعتُ رَتّا",15,"ت",2,0],["لَمّا شَعَبتُ عَلى الوُشا","ةِ وَغُصنُ ناظِرِكِ الشَعوب",16,"ب",1,0],["لم أشاهد بعد التلفت فيها","جاهلاً ليس عنده تفكير",17,"ر",1,0],["لَم أَشك وَخزتها وإن","كانَت سهاماً أَو أشدّا",18,"د",2,0],["لَمْ أَشَأْ أَنْ يَعْلَمَ النَّا","سُ بِمَا صُنْتُ وَصُنْتِ",19,"ت",1,0],["لَمّا شَدَدتُ ساعِدي","وَقيلَ صُل قَد نَصَرَك",20,"ك",1,0],["لما شدا بالنصر شاديهم بدا","لحنُ السُّرور على الشفاهِ غريبا",21,"ب",2,0],["لَمَا شَمِلَ الأَحشاءُ مِنكَ عَلاقَةً","ولا زُرتَنا إِلاّ وأَنتَ تَطِيبُ",22,"ب",1,0],["لم أشكُ حتى طغى شوقي على جلدي","وقال لي اختر الشكوى أو التلفا",23,"ف",2,0],["لمّا شعرتُ بِأَنَّ لِلحُبِّ","قَبراً جَوانِبُهُ مِن التُربِ",24,"ب",1,0],["لَمْ أَشْهَدِ الأَعْيادَ مَسْروراً بِها","لَكِنْ مَخافَة أنْ يُقَالَ جَزوعُ",25,"ع",1,0],["لم أشق من بعدها لأني","نعمت في وجنةٍ وجنه",26,"ه",1,0],["لما شممت أريج عرف صفاتكم","وأضاء منها نورها الوضّاء",27,"ا",2,0],["لما شرعت أصلي","صلاة فرضي ونفلي",28,"ي",1,0],["لَمَّا شَمَمْتُ الخَمْرَ مِنْ فَمِهِ","وَفَّيتُهُ حَدّاً مِنَ القُبَلِ",29,"ل",1,0],["لم أشم قبل وجهه بدرتم","فوق غصن على كثيب مهيل",30,"ل",1,0],["لم أشأ أن أفاجئَ القوم بالنص","ح فجاريتهم لكي يألفوني",31,"ن",2,1],["لَما شافَت العين الحَمره","وَالبيت أَخده ما عاد يَمكن",32,"ن",1,0],["لَما شافها سِيدها تَاكله","حَتّى جلده ما ترمهشي",33,"ش",2,0],["لَما شافه سَمّور جَلِّب","وَاداه جرحين فوق القورَه",34,"ر",2,0],["لَما شافَهُ مِن غيرِ اِودان","روّح وَرقبته مَنحورَه",34,"ر",2,0],["لما شكوت بحبي","وما لقيت بهجره",35,"ه",1,0],["لما شكوت فان القوم في سِنة","ضلوا عن الحق لا حلم وأذها",36,"ه",2,0],["لم أشتغل عن جمع اشتات العلى","بمليح وجه أو بكأس شمولِ",37,"ل",1,0],["لما شحذت لهم عذار تفكري","ما كان فيهم خاطري بكليل",37,"ل",1,0],["لما شكوت صدى إلى برد اللمى","وتيقنوا أني اليه ظامي",38,"م",2,0],["لَمّا شَفَى الشافِي مِنَ الأَسْقامِ","أَحْساسِها وَالرَسِّ وَالبِرْسامِ",39,"م",1,0],["لمّا شَكَا دينُ الهُدَى أَشْكَيْتَهُ","بشَديدِ بأْسِكَ والسِّلاحِ الشِّاكي",40,"ك",2,0],["لم أَشِمْ لبُعْدِكُم","سَلْوةً ولم أَسِمِ",41,"م",1,0],["لما شهدن تجلي","من الصفات عليها",42,"ي",3,0],["لمّا شأى نَورَ الرَبيعِ بِطِيبهِ","وحوى من الشَرف الصريح أثيلا",43,"ل",2,0],["لم أشك قبلك من يقيني هكذا","وكأنما صار (اليقين) مهيلا",44,"ل",2,0],["لم أشك جور الدهر حتى أبصرت","عيني اشد خطوبه المتواليه",45,"ي",2,0],["لما شفها برح الجوى مسها الوجى","ومذ عاينت نجدا بها عانت الوجدا",46,"د",2,0],["لما شهدت الذي في الكون من صور","عين الذي كنت أبغيه بلا صورِ",47,"ر",1,1],["لما شهدت الذي سوّى حقيقته","في ذاتِ أكمل مخلوقٍ من البشرِ",48,"ر",1,1],["لم أشف من ذلك الداءِ الذي فنيت","به الحشاشة مما سامها أَلما",49,"م",2,1],["لم اشكهم الا إلى الباديه","بحرقة واضحة باديه",50,"ي",2,1],["لما شددتُ إليه العيس من بلدي","حَلتْ على الخصب أجمالي وأكواري",51,"ر",2,0],["لم أشك من الوحدة بين الناس","إذ أفردني الزمان من جلاسي",52,"ي",1,1],["لم أشكُ من وضع كونٍ","مهما يقلْ ناقدوه",53,"ه",1,1],["لما شكا الناس من مصر مضايقها","وحار فيها من الحكام أفكارُ",54,"ر",1,0],["لَمَا شَهِدَتْ عَيْنِي جَمَالَكَ جَهْرَةً","وَمَنْ لَمْ تُشَاهِدْ عَيْنُهُ كَيْفَ يَشْهَدُ",55,"د",1,0],["لَم أشكُ صَدَّا وَلَم أذعَر بِهُجرَان","وَلاَ شَعُرتُ مَدَى دَهري بِسُلوَانِ",56,"ن",1,1],["لِما شُدَّ من أزْرٍ وشُيّدَ من حِمىً","وما راقَ من صُنْعٍ وما بانَ من نُجْحِ",57,"ح",1,0],["لما شعرتُ بكم شعرتُ بكم فها أنا","شاعرٌ بسواكمُ لا أشعرُ",58,"ر",1,0],["لَما شَكَوتُ لَهُ فُؤاداً هائِماً","بيديهِ أَضحى لِلهَوان عَلى شَفا",59,"ف",2,0],["لما شكوت صبابتي","لنسيم روض ناد",60,"د",1,1],["لم أشْتغِلْ مُذْ غاب عن","ه في العَشايا والبُكُورِ",61,"ر",1,0],["لم أشك ضيقا من الدنيا ولا خلقي","دان ولا منزلي في منبت القرض",62,"ض",1,0],["لَم أَشتَهِ في مَرضة عِشقي هَذي","إِلّا كَبِدَ العاذِلِ أَو عَينَ رَقيب",63,"ب",1,0],["لم أَشِب غير أَنّ نار فؤادي","أُلهبت فاعتلى الدُّخان شرارُ",64,"ر",1,0],["لما شكوا في طيبة","محلابها أبدى ضرامه",65,"م",2,0],["لما شربت الكاس من خمر الهوى","والقلب مني بالمحبة فسد غذي",66,"ذ",2,0],["لما شفعتَ العزمَ وهو مؤيّدٌ","بالحزمِ أَسفرَ بالمُنى منكَ السّفَرْ",67,"ر",1,0],["لم أشكك اذا التقاني بصدر","إنني قد لقيت فيه رحابه",68,"ب",2,0],["لما شكا لي خصره من ردفه","قلت اصطبر فالذاك اعدل جائر",69,"ر",1,0],["لم أشك من صرف الزمان وخطبه","إلا لبعدك فهو غير مطاق",70,"ق",1,0],["لما شكوت فان القوم في سنة","ضلوا عن الحق لا حلم وأذهان",71,"ن",1,0],["لمّا شكوتُ لها وجدي بها ضحكتْ","وانحازتِ العدوةُ القصوى إلى الجبلِ",72,"ل",1,1],["لمّا شَكَوْتُ الحالَ صاحَ أحِبَّتي :","هل كانَ بابُ العَفْوِ يوْماً مُقْفَلا !!",73,"ل",2,0],["لما شَعَرْتُ بِيَوْمٍ سَوْفَ يَجْمَعُنِي","بِكَ الهَوَى، وَنََأىْ مَا كُنْتُ أَخْشَاهُ",74,"ا",2,1],["لما شهدتَ زمانًا قُلَّبًا نكِدًا","فقلت من ألمٍ مُضنٍ ومن عَتَبِ",75,"ب",1,0],["لم أشه