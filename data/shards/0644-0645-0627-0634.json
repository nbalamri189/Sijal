{"poems":[[73,"أَما وَأَلحاظٍ مِراضٍ صِحاح","https://www.aldiwan.net/poem11927.html","السريع"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[78,"يا غيم عيني أقوى منك تهتانا","https://www.aldiwan.net/poem14211.html","البسيط"],[45,"أحرى الخطوب بأن يكون عظيما","https://www.aldiwan.net/poem65661.html","الكامل"],[45,"أترى الزمان يعيد لي أيامي","https://www.aldiwan.net/poem65674.html","الكامل"],[28,"أنسيت صحبتها ومن يك مقرفا","https://www.aldiwan.net/poem5255.html","الكامل"],[66,"عين حبي أعيذها بالله","https://www.aldiwan.net/poem39639.html","الخفيف"],[66,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[44,"كشفتك الأيام يا إنسان","https://www.aldiwan.net/poem29998.html","الخفيف"],[69,"لما شتت عيني ولم","https://www.aldiwan.net/poem28830.html","مجزوء الكامل"],[69,"يا سائلي عن الكلام المنتظم","https://www.aldiwan.net/poem28850.html","الرجز"],[69,"أغيد سكران نور شرق","https://www.aldiwan.net/poem29079.html","مخلع البسيط"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[48,"لم أشرك الناس يوم العيد في الفرح","https://www.aldiwan.net/poem62529.html","البسيط"],[50,"قل لفرخ الزنجي لا تشك ليثا","https://www.aldiwan.net/poem64736.html","الخفيف"],[50,"ومريضة مرض الهوى","https://www.aldiwan.net/poem64862.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54657","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[181,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[204,"لقد توقفت لو أن الهوى وقفا","https://www.aldiwan.net/poem53240.html","البسيط"],[223,"يا من ترى الدنيا بثغر فتاة","https://www.aldiwan.net/poem41887.html","الكامل"],[275,"عندي نزاع ليس عنه نزوع","https://www.aldiwan.net/poem25487.html","الكامل"],[303,"نزهت طرفي في وجه ظبي","https://www.aldiwan.net/poem58024.html","مخلع البسيط"],[437,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[479,"غب التحية أنهي","https://www.aldiwan.net/poem36939.html","المجتث"],[586,"ومهفهف كالغصن في الميل","https://www.aldiwan.net/poem18013.html","أحذ الكامل"]],"verses":[["لَم أَشِمِ البَرقَ جَهاماً وَلَم","أَقتَدِحِ الصُمَّ بِبيضِ الصِفاح",0,"ح",1,0],["لمْ أُشكِهَا قطّ بِتَقْصِيرَةٍ","فيها ولا من حَيْفَةٍ حِفْتُهَا",1,"ت",3,0],["لم أشكُ من غيره عتومَ قِرىً","حتى قراني الغنى وما عتما",2,"م",2,0],["لمَّا شفعتَ أَخاكَ الفَتحَ تَتبعُهُ","لقاكُما اللَهُ غُفراناً وَرِضوانا",3,"ن",2,0],["لَم أَشكُ حُبَّكِ بِالنُحولِ وَلَم أُرِد","بِسَقامِ جِسمي أَن أَكونَ سَقيما",4,"م",2,0],["لَمّا شَهَرتَ السَيفَ مُزدَلِفاً بِهِ","قَلِقَ العُبَيدُ وَرامَ كُلَّ مَرامِ",5,"م",1,0],["لَمّا شَبِعتَ ذَكَرتَ ريحَ كِسائِها","وَتَرَكتَها وَشِتاؤُها هَرّارُ",6,"ر",1,0],["لَمّا شَهَرَ الحُبُّ مِنَ اللَحظِ نِصالِ","أَكثَرتُ عِتابَه وَقَد صَدَّ وِصالِ",7,"ل",1,0],["لَم أَشكُ جَورَ الحادِثاتِ وَلَم أَقُل","حالَت بِيَ الأَيّامُ عَن حالاتِها",8,"ت",3,0],["لِمَ أَشقى بِكُم وَيَسعَدُ غَيري","بِهَواكُم حُبّي إِذَن كَشخانُ",9,"ن",1,0],["لما شَتَتْ عيني ولمْ","ترفقْ لتوديعِ الفتى",10,"ت",2,1],["لما شكوتُ صدَّهُ رثى لي","وأقبلَ الغلامُ كالغزالِ",11,"ل",1,0],["لما شممتُ المدامَ منهُ","حددتهُ أربعينَ قُبْلَهْ",12,"ه",1,0],["لمّا شَدَدتَ بعبدِ اللّهِ عُروَتَهُ","أعزَزتَ منه مصونَ العِرض لم يَذِل",13,"ل",1,0],["لَم أَشرَكِ الناسَ يَومَ العيدِ في الفَرَحِ","وَلا هُمُ شَرِكوني في جَوى التَرَحِ",14,"ح",1,1],["لَم أُشَفِّع فيكَ الرِجالَ وَلَو عا","شَ أَخوكَ القَوّاسُ شَفَّعتُ رَتّا",15,"ت",2,0],["لَمّا شَعَبتُ عَلى الوُشا","ةِ وَغُصنُ ناظِرِكِ الشَعوب",16,"ب",1,0],["لم أشاهد بعد التلفت فيها","جاهلاً ليس عنده تفكير",17,"ر",1,0],["لَم أَشك وَخزتها وإن","كانَت سهاماً أَو أشدّا",18,"د",2,0],["لَمْ أَشَأْ أَنْ يَعْلَمَ النَّا","سُ بِمَا صُنْتُ وَصُنْتِ",19,"ت",1,0],["لَمّا شَدَدتُ ساعِدي","وَقيلَ صُل قَد نَصَرَك",20,"ك",1,0],["لما شدا بالنصر شاديهم بدا","لحنُ السُّرور على الشفاهِ غريبا",21,"ب",2,0],["لَمَا شَمِلَ الأَحشاءُ مِنكَ عَلاقَةً","ولا زُرتَنا إِلاّ وأَنتَ تَطِيبُ",22,"ب",1,0],["لم أشكُ حتى طغى شوقي على جلدي","وقال لي اختر الشكوى أو التلفا",23,"ف",2,0],["لمّا شعرتُ بِأَنَّ لِلحُبِّ","قَبراً جَوانِبُهُ مِن التُربِ",24,"ب",1,0],["لَمْ أَشْهَدِ الأَعْيادَ مَسْروراً بِها","لَكِنْ مَخافَة أنْ يُقَالَ جَزوعُ",25,"ع",1,0],["لم أشق من بعدها لأني","نعمت في وجنةٍ وجنه",26,"ه",1,0],["لما شممت أريج عرف صفاتكم","وأضاء منها نورها الوضّاء",27,"ا",2,0],["لما شرعت أصلي","صلاة فرضي ونفلي",28,"ي",1,0],["لَمَّا شَمَمْتُ الخَمْرَ مِنْ فَمِهِ","وَفَّيتُهُ حَدّاً مِنَ القُبَلِ",29,"ل",1,0]]}