//www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5376,"دع عنك شعرا بما هيجته أدبا","https://www.poetsgate.com/ViewPoem.aspx?id=189134",""],[5376,"من طيزنٍ لم يراع القوم فاحشة","https://www.poetsgate.com/ViewPoem.aspx?id=198981",""],[5397,"لمن الرواسم بين تلك الأرسم","https://www.poetsgate.com/ViewPoem.aspx?id=157956",""],[5397,"أجريت قلبي بالدموع مذابا","https://www.poetsgate.com/ViewPoem.aspx?id=157905",""],[5408,"أوجاع يوسفية","https://www.poetsgate.com/ViewPoem.aspx?id=190737",""],[5425,"يَا طَاعِنَاً ... والمُستَحِيْلُ حِرَابُهُ (جيش العراق)","https://www.poetsgate.com/ViewPoem.aspx?id=198923",""],[5431,"حق الشعوب","https://www.poetsgate.com/ViewPoem.aspx?id=183088",""],[5431,"القصيدة المقعده!...","https://www.poetsgate.com/ViewPoem.aspx?id=200042",""],[3294,"عجبا لقوم مسلمين بزعمهم","https://www.poetsgate.com/ViewPoem.aspx?id=173277",""],[5490,"عقد الروح","https://www.poetsgate.com/ViewPoem.aspx?id=176377",""],[5528,"حياضُ النّور","https://www.poetsgate.com/ViewPoem.aspx?id=207553",""],[5596,"جامعة نزوى","https://www.poetsgate.com/ViewPoem.aspx?id=206686",""],[5628,"صور من الريف","https://www.poetsgate.com/ViewPoem.aspx?id=178449",""],[5667,"هند","https://www.poetsgate.com/ViewPoem.aspx?id=214871",""],[5691,"وفاق","https://www.poetsgate.com/ViewPoem.aspx?id=206444",""],[5725,"الى رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=177499",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[5851,"ضوء من خفايا الروح","https://www.poetsgate.com/ViewPoem.aspx?id=175293",""],[5887,"سأل الطبيب","https://www.poetsgate.com/ViewPoem.aspx?id=35336",""],[5956,"إني أمين مثل والدكم","https://www.poetsgate.com/ViewPoem.aspx?id=193690",""],[5956,"الصديقُ المريض","https://www.poetsgate.com/ViewPoem.aspx?id=194746",""],[6124,"ليل وموعد","https://www.poetsgate.com/ViewPoem.aspx?id=128746",""],[6124,"رنات عود","https://www.poetsgate.com/ViewPoem.aspx?id=201238",""],[6125,"يا شام مهلاً فالأسى تنكيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=210914",""],[6127,"ظلمة واهمة","https://www.poetsgate.com/ViewPoem.aspx?id=188639",""],[6127,"ناي الكآبات","https://www.poetsgate.com/ViewPoem.aspx?id=207517",""],[6144,"سي المجلس البلدي","https://www.poetsgate.com/ViewPoem.aspx?id=21836",""],[186,"جهد الحزين إذا صرف القضا نزلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55793&r=&rc=56",""],[6189,"السابحون في منطقة انعدام الوزن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83549&r=&rc=16",""],[6327,"لامية الهمج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86571&r=&rc=6",""]],"verses":[["قد أوجب الهم منهم في العلا همماً","تخالها نتقت من فوقهم سينا",0,"ن",2,0],["قَدْ أُوطِنَتْ فِي جُلُودٍ","ذِكْرَاكَ بَيْنَ العَوَالِمْ",1,"م",1,0],["قد أورقَ العودُ الذي أمّلْتُهُ","وحَلاَ جَناهُ لمُجتنيهِ وطابا",2,"ب",2,0],["قد أوى جار الذي جاورته","خير مأْوى ورعى في خير وادِ",3,"د",1,0],["قد أوسع الحِجْلُ والإزار لهُ","فزاد ما ضُمِّنا على الحَزَره",4,"ر",2,0],["قد أوبقتني ذنوبٌ لستُ أعرِفُها","فاجعلْ تغمُّدَها من بعض إحسانكْ",5,"ك",1,0],["قَدْ أوْرَثَتْهُمْ دُواراً","وأعْقَبَتْهُمْ خُمارا",6,"ر",2,0],["قَد أَودَعَتها عَتَلُ الرِجالِ","في كُلِّ كِبدٍ كَبِدي نِصالِ",7,"ل",1,0],["قَد أَورَثَ السَيرُ وَقراً في مَسامِعِهِ","وَفي اللِسانِ إِذا اِستَفهَمتَهُ لَفَفا",8,"ف",2,0],["قد أودعت في فؤاد اثنين كل هوى","في الأرض سارت به أخبارها قدما",9,"م",2,0],["قَد أوتِيَت مِن كُلِّ شَيءٍ بَهجَةً","وَدَداً وَحُسناً في الصِبا مَغموسا",10,"س",2,0],["قَد أَوثَقَتهُ بِغُلّ وَهيَ مُطَلَقَةٌ","هَل يَستوي الموثَقُ المَغلُولُ وَالطَلِقُ",11,"ق",1,0],["قد أُوتِيَتْ من عِلمِهمْ فكأنّها","أحبارُ تلك الكُتبِ أو رُهبانها",12,"ن",3,0],["قَدْ أوْضَحَ اللَّهُ للإِسْلامِ مِنْهاجا","وَالنَّاسُ قَدْ دَخَلُوا في الدِّينِ أَفْواجا",13,"ج",2,1],["قد أوْرَقَتْ عُمْدُ الخِيامِ وأعْشَبَتْ","شُعُبُ الرّحالِ ولونُ رأسي أغْبَر",14,"ر",1,0],["قَد أَوعَدوني بِأَرماحٍ مُعَلَّبَةٍ","سودٍ لُقِطنَ مِنَ الحَومانِ أَخلاقِ",15,"ق",1,1],["قد أوْشَكَتْ شُرُفاتُها","تُومي إليهم باليمين",16,"ن",1,0],["قَد أَودَع اللَهُ السِيادة وَالتُقى","في بُردتيهِ وَآدم في طِينِهِ",17,"ن",2,0],["قد أوسعتكم بني حواء عيشتكم","وطول غفلتكم من كل إزراء",18,"ا",2,0],["قَد أودَعَت إِذ وَدَّعَتنَا حُبَّهَا","في كُلِّ قَلبٍ مَا لَهَا مِن قَالِ",19,"ل",1,0],["قَد أورَثَتكُم وأَولَتكُم أوَائلُكُم","اللُّؤمَ والمَكرَ والعِصيَان والحِيلا",20,"ل",2,0],["قَدْ أَوْرَقَتْ مِنْهُ الظُّنُونُ وَأَثْمَرَتْ","نَيْلاً يَظَلُّ الشَّكُّ فيهِ يَقِينا",21,"ن",2,0],["قد أوعدتني بالزيارة في الكرى","لو خاض منها الطيفُ هذى الأَبحرا",22,"ر",2,1],["قُدّ أَوصاله حَلَفتُ يَمينا","لَيسَ فيها لِمُقسِمٍ تَحليلُ",23,"ل",1,0],["قَد أَوحَشَت دارَ إِبراهيمَ تارِكةً","مِن بَعدِها حَسرةً في القَلبِ وَالبَصرِ",24,"ر",1,0],["قَد أَوجَبَ الفَقَدُ حُزناً لِلفَتى فَبَكى","وَأَوجَب الحُزنُ صَبراً بَعدَهُ فَسَلا",25,"ل",2,0],["قد أودع الحسنُ فيه ما يَضِنُّ به","واحتاط فالخالُ فيه طبعُ خاتَمِهِ",26,"م",2,0],["قد أوصد الأبواب في وجهي فكم","من مأربٍ لي لم أنله ومقصد",27,"د",1,0],["قد أورثوه سيوفَهم وفخارَهم","وشريعةً بين الورى كالمشرع",28,"ع",1,0],["قَدْ أوتِيَتْ من كلّ حسنى سُؤْلها","بَأساً تُسعّرُ نَارُهُ وَسمَاحا",29,"ح",2,0],["قد أوردوه الحتف فهو","من الدمار على شفير",30,"ر",1,0],["قد أوجدَ اللهُ منهم أمّةً بلغتْ","كلّ البقاع وما لم يبْلغ الرَعدُ",31,"د",1,0],["قَد أَورَثاني هُما لا أَغالِبِهِ","إِذ قَلَّداني ما تَخشى عَواقِبُهُ",32,"ه",1,0],["قد أومضت حكمةُ الإنجيل عن رُسُلٍ","وحندسُ الكفر والطغيان جَنَّا",33,"ن",2,1],["قد أوقدت زفراتُه نارَ القِرى","فلذاك تَعشوها ذوو الأَهواءِ",34,"ا",2,0],["قَدْ أولِعَ النَّاس بالتّلاقِ","والمَرْءُ صَبٌّ إلى مُناهُ",35,"ه",1,1],["قد أوجبت ممكنات الحمد راحته","وفي المعالي بها عزٌّ وتمكينُ",36,"ن",1,0],["قد أوضحَ اللهُ به","لنا طريقَ الرَّشَدِ",37,"د",1,0],["قد أوقَدوا نارَ الوغى والقِرى","لذي عنادٍ ولأضيافِ",38,"ف",1,0],["قد أوطنوا بعدك الجرعاء من إضمٍ","علما بأنهم قد انكروا العلما",39,"م",2,0],["قد أوحشوا بعد الأني","س بسكن دارٍ خاليه",40,"ي",2,0],["قد أوْدَعْتُهنَّ البراعةُ أسْطُرا","كُسِرَتْ على روض البَهاء منوّرا",41,"ر",2,0],["قَد أَوقَدَ الزَهرُ مَصابيحَهُ","وَصَيَّرَ القَضبَ فَوانيسا",42,"س",2,1],["قد أورثتْ خاطرَ المشتاقِ يومَ نأتْ","سعادُ أَثَلاثِ المنحنى ولَها",43,"ل",3,1],["قد أودع الله سرا في عوالمها","يدعى الهوى وهو اس في مبانيها",44,"ي",3,0],["قد أودعوها رعاهم ربهم حكماً","قلوبهم عن رسول اللَه تمليها",45,"ي",3,0],["قَدْ أَوْجبَ الْحُبُّ قَضَايا الْهَوَى","فالسَّلْبُ لا أَرْضَاهُ يَوْماً بحَالْ",46,"ل",1,0],["قَد أوقدتْ حُرَقُ الفراق صبابةٍ","لَم تَستعرْ ومَرَيْنَ دمعاً ما جرى",47,"ر",2,0],["قَد أَولَعَتهُ بِطولِ الهَجرِ غِرَّتُهُ","لَو كانَ يَعلَمُ طولَ الهَجرِ ما هَجَرا",48,"ر",2,0],["قد أودع الوتر فيك حكمتَهُ","فمنه لا منك تطرب الفطرُ",49,"ر",1,0],["قد أولَدَ اللهُ سَعداً يومَ مَولِدِهِ","لنا كما تَقتَضيهِ حِكمةُ القَدَرِ",50,"ر",1,0],["قد أوجَدَ اللهُ فيهِ رحمةً ظَهَرَتْ","في كلِّ أرضٍ ففاقَتْ رَحمةَ المَطَرِ",50,"ر",1,0],["قد أودَعَ اللهُ فيهِ خيرَ جَوهَرةٍ","في خيرِ كَنْزٍ بعينِ اللُطفِ مرصودِ",51,"د",1,0],["قد أوحشَ الشَرقَ لَمَّا غابَ عنهُ كما","ألقَى على الغَربِ أُنساً حيثُما حَضَرا",52,"ر",2,0],["قد أوغَلَ النَّاسُ في حُبِّ الغِنَى سفَهاً","وعاشِقُ المالِ عبدٌ خادمُ الصَنَمِ",53,"م",1,0],["قَدْ أَوْقَعَت عُيونُه فُؤادَهُ","في عَثْرةٍ فَمَنْ لَهُ يُقِيلُهُ",54,"ل",2,0],["قد أومأت حقا إلى المجد الذي","بلغوه قدما أيما إيماء",55,"ا",2,0],["قد أَورَدَ القومَ حادِيهم حياضَ ردىً","فما لَهُم بَعدَ ذاكَ الوِردِ إِصدارُ",56,"ر",1,0],["قَد أورثَ الأحشاء في فقدانهِ","ناراً تزيد سناً على جمر الغضا",57,"ض",2,0],["قد أوهمت حكمَ الحدودِ فظنّها","ماء وقد حكمت بحكمٍ خافِ",58,"ف",1,0],["قد أوجزت فيك المديح لأنها","خافت تمل بسمعها أطنابها",59,"ب",3,0],["قَد أُولِعَ الدهرُ إِغراءً بِذي شَرَفٍ","هَل عانَدَ الدّهر إِلّا ما لَهُ خَطَرُ",60,"ر",1,0],["قَد أُولِعَت بِالصّيد غيرَ مَصيدَةٍ","وَمَصيدُها لبُّ الهِزَبرِ الضّيغَمِ",61,"م",1,0],["قَد أورثَ السّحرُ مِن أَجفانِهِ خللاً","في عقلِ صبٍّ علاه منه تَوهينُ",62,"ن",1,0],["قد أوْتر الناس فهو قصدٌ طالبهم","منزَّهٌ عن خصال اللؤمْ والعار",63,"ر",1,0],["قد أوْرثوا مَجْدَهم المولى الذي","ما وضعَتْ مِثْلاً له ذاتُ حَبَلْ",64,"ل",1,0],["قَد أَودَع اللَّه سر الحسن صفحته","وَنَظم الدُر وَالمُرجان في فيه",65,"ي",2,0],["قد أوقفت علياؤه","سيارة الافلاك حيرى",66,"ر",2,0],["قد أورثتك قريش","فخارها النوفليا",67,"ل",3,0],["قد أوشَجت أعراقها في العُلى","من فاطمٍ أعراقُ علياها",68,"ا",3,0],["قد أوهنت جلدي الديار الخالية","من أهلها ما للديار وما ليه",69,"ي",2,1],["قد اوهنت كشحيه مجهدة","اردافه فحذار ان تهوى",70,"و",2,0],["قد أودَعَ الحُبُّ لحظيكِ ابنةَ العِنَبِ","لمَّا تَقَرَّبَ مِنكِ الحُسنُ بالنَّسَبِ",71,"ب",1,1],["قد أودعوها ما استحالَ وجُودُهُ","مهما تولى الأرضَ من عُمرانِ",72,"ن",1,0],["قَد أوبِيَت كُلَّ ماءٍ فَهِيَ طاوِيَةٌ","مَهما تُصِب أُفُقاً مِن بارِقٍ تَشِمِ",73,"م",1,0],["قَد أَورَثَ المَجدَ عَبدَ اللَّهِ شَيبَةُ عَن","عَمروِ بنِ عَبدِ مَنافٍ عَن قُصَيِّهِمِ",74,"م",1,0],["قد أوحشوه من بقية اهله","اما الأُلى فيه فغير عياله",75,"ل",2,0],["قد أورقتْ بنداه دمعةُ روضتى","أعلا السها بالفخر لا كالذاذِ",76,"ذ",1,0],["قَد أَوجَبَ المُصطَفى بِالنَصِّ طاعَتَهُم","لَو أَنَّهُم أَخَذوا لِلمالِ أَو ضَرَبوا",77,"ب",3,0],["قد أوسع الدهر إرغاماً وليس يرى","لما يفاجئ منه ضيق العطن",78,"ن",1,0],["قد أودعَ الله فيه كلَّ مرتبة","تحوي على حزن تحوي على جذل",79,"ل",1,0],["قد أوذي الله مثل هذا","فالوقتُ حلو وقتاً ومرّ",80,"ر",1,0],["قَد أوحِشَت مِنهُم رُبُوعٌ زَادَهَا ال","جَبَّارُ إيحَاشاً مَدَى الأزمَانَِ",81,"ن",1,0],["قد أوشكت تزهق الأرواح فيه وبال","مولى الحسين أعاد الله زاهقها",82,"ق",3,0],["قد أولد السعد لي ما ألقحت هممي","وعاد طفل رجائي بالغ الحلم",83,"م",1,1],["قَد أَودَعوا التُرب مِنهُ أَيَّ جَوهَرَةٍ","كانَت بِسلك العُلى وَالمَجد تَنتَظم",84,"م",1,0],["قد أوثقوا باسم التمدن شعبنا","بسياسة نكراء شر وثاق",85,"ق",1,0],["قد أوعب التكوين كلّ مكوّن","مذ أحكم التقدير كلّ مقدر",86,"ر",1,0],["قَد أَوعَدَتنا مَعَدٌّ وَهيَ كاذِبَةٌ","نَصراً فَكانَ لَها ميعادُ عُرقوبِ",87,"ب",1,1],["قَد أودِعَت مِن قُفِيٍّ ناعِجٍ ثَقِلاً","يَحبو عَلَيهِ حَصى الأُدحِيِّ يَطَّرِقُ",88,"ق",1,0],["قد أوحشت منك داري بعد بهجتها","بنور وجهك إذ ولى فلم يعدِ",89,"د",1,0],["قَدْ أَوْقد الحبُّ فِي سودائِه لهباً","فناله من صروف الدهرِ والِّلمَم",90,"م",1,0],["قد أوقع القلب في نيران وجنته","بقبر سري ولي عيناه فتّانهْ",91,"ه",1,0],["قد أوجبوا القول أَني عن محبَّتهم","قد ملتُ قلتُ إِلى الإتلاف وا