{"poems":[[72,"بعثت طيفها إلينا رسولا","https://www.aldiwan.net/poem20542.html","الخفيف"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"مذ صرت همي في النوم واليقظه","https://www.aldiwan.net/poem65036.html","المنسرح"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[45,"لك بالباب حاجب","https://www.aldiwan.net/poem66655.html","مجزوء الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39594","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54887","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54310","الكامل"],[106,"قالوا أحيل","https://www.poetsgate.com/ViewPoem.aspx?id=179396",""],[90,"لبنان في العراق","https://www.poetsgate.com/ViewPoem.aspx?id=178952",""],[113,"اضرني جفاك يا فلان","https://www.aldiwan.net/poem40438.html","عموديه"],[113,"لك بين سفار الحمى اسماء","https://www.aldiwan.net/poem41467.html","عموديه"],[233,"يا جلال الدين يا ملكا","https://www.aldiwan.net/poem31800.html","المديد"],[233,"سيدي يا ابن جعفر أنت أعلى","https://www.aldiwan.net/poem31899.html","الخفيف"],[280,"ومهفهف حلو الملاحة","https://www.aldiwan.net/poem32830.html","مجزوء الكامل"],[369,"ما استطاعت أن تهجر المهجورا","https://www.aldiwan.net/poem57455.html","الخفيف"],[413,"لك بالمعالي رتبة تختارها","https://www.aldiwan.net/poem54015.html","الكامل"],[413,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[429,"يا برق سق حيا السحاب الأبرقا","https://www.aldiwan.net/poem12682.html","الكامل"],[434,"هي بشرى الإسلام والأيام","https://www.aldiwan.net/poem2569.html","الخفيف"],[477,"سلمى بعيشك واصلي","https://www.aldiwan.net/poem36971.html","مجزوء الكامل"]],"verses":[["لك بيت في الملكِ قد جمع الأوزا","ن جمعاً يوافق التفعيلا",0,"ل",2,0],["لك بَحْرٌ يُمدُّ بْحري فيجْري","غيْرَ ما مُنْزف ولا مَثْمودِ",1,"د",1,0],["لك بطن من الفضول خميصٌ","ووليٌّ من الفضول كظيظ",2,"ظ",1,0],["لك باللَّه اتصالٌ","وانتصار واعتصامُ",3,"م",1,0],["لَكَ بِالبابِ حاجِبٌ","كالِحُ الوَجهِ ساهِمُ",4,"م",1,1],["لكَ بعد موتكَ ذكرياتٌ حيَّةٌ","جوَّابةُ الأشباحِ والأصداءِ",5,"ا",2,0],["لَكَ بَيْنَ الأَسَى وَبَيْنَ التَّأَسِّي","ثُكلُ وَافٍ وَرُشْدُ هَادٍ صَبْورِ",6,"ر",1,0],["لكَ بينَ أعيادِ الزما","نِ سَناً على الأعياد باهرْ",7,"ر",1,0],["لك بعضُ مالي من: صَفَا","ءِ النَّفْسَ، والخُلُق الحميد",8,"د",1,0],["لك بالعراق عن الشآم تصبر","وبأهله عن أهلها سُلوان",9,"ن",1,0],["لك بسره ولب روحه","وفي فجاج قلبه ديوان",10,"ن",1,0],["لك بين سفار الحمى اسماء","طابت بها الاسماع يا اسماء",11,"ا",2,1],["لَكَ بِالإِقبالِ دارٌ وَإِن","رُغِمَت أَعداؤُكَ الفَلَكُ",12,"ك",1,0],["لَكَ بَيتٌ عالي الدَعائِمِ لا يَط","مَعُ في مَجدِهِ المُؤَثَّلِ نَقضُ",13,"ض",1,0],["لَكَ باحَةٌ هِيَ لِلإِنا","خَةِ مِن عُفاتِكَ خَيرُ باحَه",14,"ح",2,0],["لك بأسٌ ردَّ الكبيرَ صغيراً","وندىً ألحقَ الصغيرَ الكبيرا",15,"ر",2,0],["لك بالمعالي رُتبة تختارُها","فافخر فأَنتَ فخارُنا وفخارُها",16,"ر",3,1],["لك بالخير مساعٍ جَمَّةٌ","وبما تعزم مقدار جسور",17,"ر",1,0],["لكَ بالرفاه والبنين تفاؤلاً","طاب الهَناء وقد جَلا متذوّقا",18,"ق",2,0],["لك بالأحمدين عزّ رفيع","بممل علا على بهرام",19,"م",1,0],["لك باذلٌ نفسي فهل","ترضيك نفس الباذل",20,"ل",1,0]]}