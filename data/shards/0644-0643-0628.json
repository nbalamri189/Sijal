/diwan/poem/136050","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86393","الكامل"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136868",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54369","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117284","الكامل"],[4755,"يا غُصنْ طُولَ السَّنَهْ مَمطورْ","https://www.poetsgate.com/ViewPoem.aspx?id=194343",""],[4760,"في ذمتي ..","https://www.poetsgate.com/ViewPoem.aspx?id=35830",""],[4797,"لك بعيني شوق ماله عدد","https://www.poetsgate.com/ViewPoem.aspx?id=178135",""],[4830,"سقيفةُ بني سام","https://www.poetsgate.com/ViewPoem.aspx?id=202263",""],[4876,"نصفُ حيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=207500",""],[4931,"عجاج الظّروف","https://www.poetsgate.com/ViewPoem.aspx?id=31775",""],[4987,"وسيع البال","https://www.poetsgate.com/ViewPoem.aspx?id=49572",""],[5163,"نخيل","https://www.poetsgate.com/ViewPoem.aspx?id=34864",""],[5338,"رمتني في صرفها الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=187598",""],[5376,"ذياك جرحي الذي في القلب يبتسمُ","https://www.poetsgate.com/ViewPoem.aspx?id=192170",""],[5463,"اتركوني في هواها","https://www.poetsgate.com/ViewPoem.aspx?id=25226",""],[5573,"لك البقا مع طول الايام ياخال","https://www.poetsgate.com/ViewPoem.aspx?id=200175",""],[845,"إلى أبي تراب","https://www.poetsgate.com/ViewPoem.aspx?id=159622",""],[5956,"أراكِ لم تسافري","https://www.poetsgate.com/ViewPoem.aspx?id=182152",""],[6288,"بستان الأدب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78521&r=&rc=34",""]],"verses":[["لك بيت في الملكِ قد جمع الأوزا","ن جمعاً يوافق التفعيلا",0,"ل",2,0],["لك بَحْرٌ يُمدُّ بْحري فيجْري","غيْرَ ما مُنْزف ولا مَثْمودِ",1,"د",1,0],["لك بطن من الفضول خميصٌ","ووليٌّ من الفضول كظيظ",2,"ظ",1,0],["لك باللَّه اتصالٌ","وانتصار واعتصامُ",3,"م",1,0],["لَكَ بِالبابِ حاجِبٌ","كالِحُ الوَجهِ ساهِمُ",4,"م",1,1],["لكَ بعد موتكَ ذكرياتٌ حيَّةٌ","جوَّابةُ الأشباحِ والأصداءِ",5,"ا",2,0],["لَكَ بَيْنَ الأَسَى وَبَيْنَ التَّأَسِّي","ثُكلُ وَافٍ وَرُشْدُ هَادٍ صَبْورِ",6,"ر",1,0],["لكَ بينَ أعيادِ الزما","نِ سَناً على الأعياد باهرْ",7,"ر",1,0],["لك بعضُ مالي من: صَفَا","ءِ النَّفْسَ، والخُلُق الحميد",8,"د",1,0],["لك بالعراق عن الشآم تصبر","وبأهله عن أهلها سُلوان",9,"ن",1,0],["لك بسره ولب روحه","وفي فجاج قلبه ديوان",10,"ن",1,0],["لك بين سفار الحمى اسماء","طابت بها الاسماع يا اسماء",11,"ا",2,1],["لَكَ بِالإِقبالِ دارٌ وَإِن","رُغِمَت أَعداؤُكَ الفَلَكُ",12,"ك",1,0],["لَكَ بَيتٌ عالي الدَعائِمِ لا يَط","مَعُ في مَجدِهِ المُؤَثَّلِ نَقضُ",13,"ض",1,0],["لَكَ باحَةٌ هِيَ لِلإِنا","خَةِ مِن عُفاتِكَ خَيرُ باحَه",14,"ح",2,0],["لك بأسٌ ردَّ الكبيرَ صغيراً","وندىً ألحقَ الصغيرَ الكبيرا",15,"ر",2,0],["لك بالمعالي رُتبة تختارُها","فافخر فأَنتَ فخارُنا وفخارُها",16,"ر",3,1],["لك بالخير مساعٍ جَمَّةٌ","وبما تعزم مقدار جسور",17,"ر",1,0],["لكَ بالرفاه والبنين تفاؤلاً","طاب الهَناء وقد جَلا متذوّقا",18,"ق",2,0],["لك بالأحمدين عزّ رفيع","بممل علا على بهرام",19,"م",1,0],["لك باذلٌ نفسي فهل","ترضيك نفس الباذل",20,"ل",1,0],["لك بالسعود الشهر هل هلاله","واضاء فازدهرت به البلدان",21,"ن",1,0],["لك بحت يا خل الورى","أمراً بديهي الأثر",22,"ر",1,0],["لَكَ بالفَتحِ ابنِ خاقانَ وَببالسَّ","هلِ والفَضلَينِ فَضلٌ وَ الحَسَن",23,"ن",1,0],["لك بالملاحة كل كون شاهد","وعليه من أنوار حسنك شاهد",24,"د",1,1],["لَكَ بُشرى مِن ناصر اللَه فَخري","عز مصر بِما يسرّك فهما",25,"م",2,0],["لك بيت يحكي بمكة بيتا","لم نزل حول بابه حجاجا",26,"ج",2,0],["لك بالعذر مشّايه","يا بو هدب نشّاح",27,"ح",1,0],["لَكَ بَرمَةٌ نَزَّهتَها","مِن أَن تُدَنَّسَ بِالدَسَم",28,"م",1,1],["لَكَ بِالإِفطار عيدٌ وَلَنا كُلّ","يَومٍ بِكَ عيدٌ يَستَجد",29,"د",1,0],["لَكَ بِالإِفضالِ صيتٌ ذاعَ مِن بَلَدٍ","في الكَون يَسري لِبَلَد",29,"د",1,0],["لَكَ بِالسِياسَةِ خِبرة تَجلو بِها","ظُلَمَ المَشاكِلِ بِالصَوابِ المُقنِعِ",30,"ع",1,0],["لك بالسبق إذ عن الشعراء","يا محبا قد صح منه الولاء",31,"ا",2,1],["لك بالرياح وبالبوارقِ أسوةٌ","الريحُ تسرقُ والبوارقُ تخطفُ",32,"ف",1,0],["لَكَ بَيْتٌ في الْبُيُوتِ","مِثْلُ بَيْتِ الْعَنْكُبوتِ",33,"ت",1,0],["لك بالثرى لله صوت قد سرى","لما غدوت مشخصا هابيلا",34,"ل",2,0],["لَكَ بِالصَعيدِ عَلى الحَميّةِ قُدوَةٌ","فَاِقدِم إِلى العَليا وَغُص بِعُبابِها",35,"ب",3,0],["لِكْ بالأصلْ ساسٍ معرّبْ","ساسٍ عَلَى ساسٍ على ساسْ",36,"س",1,0],["لكَ بين الأنامِ ديوانُ شعرٍ","بمعانيه حرّك الجلمودا",37,"د",2,0],["لك بالشهباء دوح عُلاً","دام ظل السعد من شجره",38,"ر",2,0],["لك بالحشا يا زين وديان وشعوب","لك بينهن يا زين مسرى ومراحي",39,"ح",2,0],["لَكَ بِالفَصاحة مقول","أَمضى مِن السَّيف الصَّقيل",40,"ل",1,1],["لَكَ بَيعة في عُنق كُل موحد","هِيَ لا تَزال وَلات حينَ مَناص",41,"ص",1,0],["لك بين احبار البلاد مكانة","عليا وفي الدنيا المقام الارفع",42,"ع",1,0],["لك بيت فضل لا يحاكي رفعة","فبنيت داراً للنواظر حاكيه",43,"ي",2,0],["لك بحر حلو المذاق ولكن","لم يذقوا من بحر شعرك طعمه",44,"م",2,0],["لك بيت تعافه النفس لولا","أنه فيك موطن الأريحيه",45,"ي",2,0],["لك بينهم وثباب أغلبَ ضيغم","ولهم كاسراب النمال دبيب",46,"ب",1,0],["لَك بالشَهيد مدافِعاً","أَجر الشَهيد المحرمِ",47,"م",1,0],["لك بالأفراح عرسُ","كله حظٌ وأنسُ",48,"س",1,0],["لك بالكهرباء آية ليل","أطلعت للأنام شمساً وبدرا",49,"ر",2,0],["لَكَ بِالوَفا تُوفَى النُذورُ بقُدس أو","رَشلِيمَ عِرسِكَ والوَفاءُ لَمِن وَفى",50,"ا",1,0],["لكِبرِ السِنِّ لم نَضبُط عَفافاً","ولكن ما أَشارَ بهِ الحكيمُ",51,"م",1,1],["لَكِ بِالفَضلِ المباهي","شَرَفُ النَّفسِ سَليقَه",52,"ق",2,0],["لك بالجمال على الحسان خلافة","أنت الأحق بها وأنت الأليق",53,"ق",1,0],["لك بكل ما به تحبُّ أنْ","تحمد حمدٌ دائمٌ مدى الزمنْ",54,"ن",1,0],["لك بنينا ربّنا ذا المسجدا","نرجوكَ تعميراً له لن ينفدا",55,"د",2,1],["لَكِ بِالإِقبالِ مِن قَبلِ الإِياب","بَسَمَت هيرا لَهُ مُستَبشِرَه",56,"ه",1,0],["لك بالحدوج وأهلها رشأٌ","رشأٌ أقل صفاته الحسن",57,"ن",1,0],["لك بما رأوه مني كل عاقل ومجنون","فألتفت بالذي في عينه السيف مسنون",58,"ن",1,0],["لكَ بيتُ مجدٍ ليس يُدْرَكُ حَدُّهُ","يعيا بذرعِ عُروُضهِ مَسّاحُهُ",59,"ح",2,0],["لك بالعباد عظيم لطفٍ جل أن","نلفيه محدوداً ولا موصوفا",60,"ف",2,0],["لَكْ بَيت في داخِلِي مَعمور","الكون في داخِلِه غُرفَه",61,"ف",2,0],["لك \"بالصدى\" احساس مانيبْ ناسي","لك بالغلا شعر(ن) تبنّاك سيره",62,"ر",2,0],["لك بعيني شوق ماله عدد والى قبل ..","وفي خفوقي لك من الود قامه وقعده ..",63,"د",2,1],["لكَ بخٍّ مرةً أُخرى ولكنْ","قالها الجَمْعُ لمَنْ كانَ عَريفَهْ",64,"ف",2,0],["لك بئرٌ بغير دلوٍ، وسجنٌ","دون خمرٍ فكيف تلهو بحدسكْ ؟",65,"ك",1,0],["لك بديت أكتب قصيدة شوق يا احلى الفاتناتي","واسأل ايدينك بعدها تريد لمستهاالكفوف",66,"ف",1,1],["لك بنات الفكر ربات الخدور","يكشفن لثامهن والجرح عاري",67,"ر",2,0],["لكِ بين آهاتي نما شجنٌ","قد صار يمطرُ نخلتي شهبا",68,"ب",2,0],["لَكِ بِخَيْرِ الوَرَى اعْتِبَارٌ","وَإِسْوَةُ العِزِّ وَالْمَعَالِي",69,"ل",2,0],["لكبوةُ المرءِ ما حلَّتْ نوازلُه","في الصبرِ ظفرٌ على الأيام يختصمُ",70,"م",1,0],["لك بقلبي شي غالي ما أظنّك تعرفينه","شي ضاهى في غلاته المجرّه ومحتواها",71,"ا",3,1],["لك بيض الأيدي محتوي بيض الأفعال","وعمر يتجدد بالواحق شبابه",72,"ب",2,0],["لك بالنفوس إمامةٌ فيهون لو","عصفت بك الشورى أو التعيين",73,"ن",1,0],["‏لك بسمةُ الأزاهرِ","‏ ‏ وطلعة الأكابرِ",74,"ر",1,0],["لكبار في عقول","خطوا للجيل طريقا",75,"ق",2,0]]}