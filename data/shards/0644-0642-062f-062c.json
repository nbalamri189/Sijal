لتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[464,"رسوم ديار باللوى وربوع","https://www.aldiwan.net/poem3499.html","عموديه"],[464,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[468,"لقد جار ما تشكوه في الحكم واعتدا","https://www.aldiwan.net/poem60213.html","الطويل"],[482,"أما لغراب البين ينحل مقتضى","https://www.aldiwan.net/poem24337.html","عموديه"],[513,"لقد جمعت أهواي بعد شتاتها","https://www.aldiwan.net/poem67730.html","الطويل"],[514,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[514,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[515,"أأحبابنا كم تبخلون وكم نسخو","https://www.aldiwan.net/poem12057.html","الطويل"],[515,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[529,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[562,"لكم يا بني الخوري عزاء وسلوة","https://www.aldiwan.net/poem52574.html","الطويل"],[562,"كتاب مثل مصباح صغير","https://www.aldiwan.net/poem52712.html","الوافر"],[562,"دعاني من هوى هند وأسما","https://www.aldiwan.net/poem52779.html","الوافر"],[562,"ألناس في الدهر لفظ أنت معناه","https://www.aldiwan.net/poem52808.html","البسيط"],[562,"قفا بين الثنية والمصلى","https://www.aldiwan.net/poem52929.html","الوافر"],[575,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[575,"ألا فانتبه من أفقها طلع الفجر","https://www.aldiwan.net/poem3064.html","الطويل"]],"verses":[["لَقَد جَثَمَت تَعبيسَةٌ في المَضاحِكِ","تَمُدُّ بِأَضباعِ الدُموعِ السَوافِكِ",0,"ك",1,1],["لَقَد جَبَّ مِنّا ذُروَةً أَيَّ ذُروَةٍ","فَأُبنا بِأَضلاعِ الأَجَبِّ المُوَقَّعِ",1,"ع",1,0],["لَقَد جَلَّ قَدرُ الرُزءِ أَن يَبلُغَ البُكا","مَداهُ وَلَو أَنَّ القُلوبَ دُموعُ",2,"ع",1,0],["لَقَد جَلَّ مابَيني وَبَينَكَ عَن قِلىً","سَواءٌ تَدانى البُعدُ أَو بَعُدَ القُربُ",3,"ب",1,0],["لَقَد جِئتُ الطَبيبَ لِسُقمِ نَفسي","لِيَشفيها الطَبيبُ فَما شَفاها",4,"ا",3,1],["لَقَدْ جُلِيَتْ مِنْكَ الْبِلاَدُ لِخَاطِبٍ","لَقَدْ جُنِيَتْ مِنْكَ الْغُصُونُ إِلَى جَانِي",5,"ي",1,0],["لَقَد جَدَّ في سَلمى الشَكاةُ وَلَلَّذي","يَقولونَ لَو يَبدو لَكَ الرُشدُ أَرشَدُ",6,"د",1,1],["لَقَد جَهِلوا قَدرَ الإِمامِ فَأَودَعوا","تَجاليدَهُ في موحِشٍ بِفَلاةِ",7,"ه",1,0],["لَقَد جَمَعتَ خِلالاً","تَضَمَّنَت كُلَّ حُسنِ",8,"ن",1,0],["لَقَد جَهِلوهُ حِقبَةً ثُمَّ رَدَّهُم","إِلَيهِ الهُدى فَاِستَغفَروا وَتَرَحَّموا",9,"م",3,0],["لَقَد جازَيتَ غَدراً عَن وَفائي","وَبِعتَ مَوَدَّتي ظُلماً بِبَخسِ",10,"س",1,0],["لَقَد جُدتَ حَتّى ما بِنَفسٍ خَصاصَةٌ","وَأَمَّنتَ حَتّى ما بِقَلبٍ تَخَوُّفُ",11,"ف",1,0],["لَقَد جَدَّ إِخباتٌ وَحَقَّ تَبَتُّلٌ","وَبالَغَ إِخلاصٌ وَصَحَّ مَتابُ",12,"ب",1,0],["لَقَد جَزَتهُم جَوازي الدَهرِ عَن مِنَنٍ","عَفَت فَلَم يَثنِهِم عَن غَمطِها وَرَعُ",13,"ع",1,0],["لَقَد جَهَدَ الأَعداءُ فَوتَكَ جُهدَهُم","وَضافَتكَ أَبكارُ الخُطوبِ وَعونُها",14,"ن",3,0],["لَقَدْ جِئْتُمْ بِبُرْهَانٍ عَظِيمٍ","عَلَى أَنَّا نَعُودُ إِلَى التَّمَامِ",15,"م",1,0],["لَقَد جَشَأَت نَفسي عَشيَّةَ مُشرِفٍ","وَيَومَ لِوى حُزوى فَقُلتُ لَها صَبرا",16,"ر",2,1],["لقد جئتم روّاد علم وحكمة","فحيّيتمو أزكى التحيّات من وفد",17,"د",1,0],["لقد جمع الشيخ هذي الكتب","فأنقذها من أكفّ العطب",18,"ب",1,1],["لقد جمع الدهر المكايد كلّها","بقِدرٍ كبيرٍ صيغ من معدن الخبث",19,"ث",1,1],["لقد جاح هذا الشرق بعد اعتزازه","جوائح أودت منه بالكرش والفَرث",20,"ث",1,0],["لقد جدّدت للأوطان عهداً","تُجاري فيه أوطان الفرنج",21,"ج",1,0],["لقد جئت من أفق الصوارم طالعاً","علينا طلوع الشمس من منتهى الأفق",22,"ق",1,0],["لقد جئتني بالقول رَطباً ويابساً","فداويت لي سُقماً وهيّجت ثانيا",23,"ي",2,0],["لقد جَشَمتْ فوق الترابِ وحولها","صغرٌ لها يرنو بعينيْ مُيَتَّم",24,"م",1,0],["لقد جمع الأموال باسمك معشر","لتخليدهم ذكراك في معهد يبنى",25,"ن",2,0],["لَقَد جَنَحَت بِالسِلمِ خِربانُ مالِكٍ","وَتَعلَمُ يا اِبنَ القَينِ أَن لَم أُسالِمِ",26,"م",1,0],["لَقَد جاهَدَ الوَضّاحُ بِالحَقِّ مُعلِماً","فَأَورَثَ مَجداً باقِياً أَهلَ بَربَرا",27,"ر",2,0],["لَقَد جُرِّدَت يَومَ الحِدابِ نِسائُهُم","فَساءَت مَجاليها وَقَلَّت مُهورُها",28,"ر",3,0],["لَقَد جَمَحَت عِرسُ الفَرَزدَقِ وَاِلتَوى","بِحَدراءِ قَومٌ لَم يَرَوهُ لَها أَهلَ",29,"ل",1,0],["لَقَد جَرَّدَ الحَجّاجُ بِالحَقِّ سَيفَهُ","لَكُم فَاِستَقيموا لا يَميلَنَّ مائِلُ",30,"ل",1,0],["لَقَد جَهَدَ الحَجّاجُ في الدينِ وَاِجتَبى","جَباً لَم تَغُلهُ في الحِياضِ الغَوائِلُ",30,"ل",1,0],["لقد جمعت بيني وبينك نسوة","عقائل ما إن مثلهن عقائلُ",31,"ل",1,1],["لَقَد جَمَعَتنا الحَربُ مِن قَبلِ هَذِهِ","فَكُنّا بِها أُسداً وَكُنتَ بِها كَلبا",32,"ب",2,0],["لَقَد جُدِعَت آذانُ كَعبٍ وَعامِرٍ","بِقَتلِ اِبنِ عَبدٍ ثُمَّ خُرَّت أُنوفُها",33,"ف",3,1],["لقد جدَّدت يا خجلي ذكري","لشبعٍ أو لريٍّ زاد غبطه",34,"ه",1,1],["لقد جدت حتى جدت في كلّ ناقلٍ","وحتى أتاكَ الحمد من كلّ منطق",35,"ق",1,0],["لقد جزيتم أباكم حين كرَّمَكُمْ","بالعهد أسْوَأ ما يجزي البنون أبا",36,"ب",2,0],["لقد جُمِعْتَ وإياه على قَدَرٍ","والحمدُ للّه أنْواعَ التَّحاميدِ",37,"د",1,0],["لقد جاء باللؤمِ من فصِّهِ","وتمَّ له البُخلُ كُلَّ التمامِ",38,"م",1,0],["لَقَد جارَيتَ يا اِبنَ أَبي جَريرٍ","عَذوماً لَيسَ يُنظِرُكَ المِطالا",39,"ل",2,1],["لَقَد جارى أَبو لَيلى بِقَحمٍ","وَمُنتَكِثٍ عَلى التَقريبِ واني",40,"ن",2,1],["لَقَد جَزَيتُ بَني بَدرٍ بِبَغيِهِمُ","عَلى الهَباءَةِ يَوماً ما لَهُ قودُ",41,"د",1,0],["لَقَد جُدتَ بِالعِلق الَّذي لَو أُباعُه","بَذَلتُ وَلَم أَغبن بِهِ العَيشَةَ الرَغدا",42,"د",2,0],["لَقَد جَعَلَ اللَيلُ القَصيرُ لَنا بِكُم","عَلَيَّ لِرَوعاتِ الهَوى يَتَطاوَلُ",43,"ل",1,0],["لقد جاء شيطان من الجن داعيا","الى جنة فيها عذارى وغلمان",44,"ن",1,1],["لقد جننت بليلى","فطاب فيها جنوني",45,"ي",1,1],["لقد جاء إبراهيم للناس مرسلا","وموسى وعيسى ثم جاء محمد",46,"د",1,0],["لَقَد جُدتَ حَتّى جُدتَ في كُلِّ مِلَّةٍ","وَحَتّى أَتاكَ الحَمدُ مِن كُلِّ مَنطِقِ",47,"ق",1,0],["لَقَد جَلَّ ما بَيني وَبَينَكَ إِنَّنا","عَلى سَنَنٍ مِن حَربِهِ وَطَريقِ",48,"ق",1,0],["لَقَد جَشِمَ الفَتحُ بنُ خاقانَ خُطَّةً","مِنَ المَجدِ ما يَسطيعُها المُتَجَشِّمِ",49,"م",1,0],["لَقَد جَمَعَ اللَهُ المَحاسِنَ كُلَّها","لِأَبيَضَ مِن آلِ النَبِيِّ هُمامِ",50,"م",1,0],["لَقَد جاءَ البَريدُ يَنُثُّ قَولاً","شَهِيَّ اللَفظِ