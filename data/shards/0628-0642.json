s://www.poetsgate.com/ViewPoem.aspx?id=27205",""],[32,"أتوها بقول لم أكن لأقوله","https://www.poetsgate.com/ViewPoem.aspx?id=122",""],[32,"يقولون مسحور يجن بذكرها","https://www.poetsgate.com/ViewPoem.aspx?id=112",""],[88,"وظبي جاء يطلب جلنارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19547&r=&rc=50",""],[83,"ظلالكم تندو وموردكم عذب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=57164&r=&rc=9",""]],"verses":[["بِقَنّاصٍ أَصابَ وَفي يَدَيهِ","حَبائِلُ قَد مُدِدنَ لِآخَرينا",0,"ن",2,0],["بَقاءَكَ نَهوى وَحدَهُ دونَ غَيرِهِ","فَدَع كُلَّ نَفسٍ ما سِواكَ تَسيلُ",1,"ل",1,0],["بَقيتَ أَميرَ المُؤمِنينَ فَإِنَّما","بَقاؤُكَ بِالعِزِّ المُقيمِ كَفيلُ",1,"ل",1,0],["بَقيتَ اللَيالي ما سَلَبنَ وَهَل فَتىً","يُطالِبُ أَمراً إِن مَضى بِكَفيلِ",2,"ل",1,0],["بَقيتَ وَأَفنَيتَ الأَعادي فَإِنَّهُ","شِفاءُ جَوىً بَينَ الضُلوعِ دَخيلِ",2,"ل",1,0],["بَقيتَ أَمينَ اللَهِ عوداً لِمَفزَعٍ","وَمَرعىً لِإِخفاقٍ وَوِرداً لِمَطمَعِ",3,"ع",1,0],["بِقَوارِعٍ يُمسي الرَمِيُّ بِها","مِن غَيرِ ما طَرَبٍ لَهُ رَقصُ",4,"ص",1,0],["بِقَلبي لِلنَوائِبِ جانِحاتٍ","عِماقُ القَعرِ مُؤنِسَةُ الأَواسي",5,"ي",1,1],["بَقاءُ الفَتى مُستَأنَفٌ مِن فَنائِهِ","وَما الحَيُّ إِلا كالمُغيَّبِ في الرَمسِ",6,"س",1,1],["بَقيتُ مُعَنّىً بِالبَقاءِ خِلافَهُم","وَما بَينَنا إِلّا قُدَيديمَةُ السَفرِ",7,"ر",1,0],["بَقِيَةٌ مِن قِدَمِ ال","أَضلالِ وَقّادُ النَظَر",8,"ر",1,0],["بَقِيَت أُعَيجازٌ يَضِلُّ تَبيعُها","وَمَضَت هَوادٍ لِلرِجالِ هَوادِ",9,"د",1,0],["بَقيتَ بَقاءَ القَولِ فيكَ فَإِنَّهُ","إِذا بَلَغَ الباقي المَدى جاوَزَ المَدى",10,"د",2,0],["بَقِيَّةُ أَسيافٍ طُبِعنَ مَعَ الرَدى","فَجاءَ وَجاءَت عاثِياتٌ وَعائِثُ",11,"ث",1,0],["بِقَدرِ عِزِّ الفَتى رَزيَّتُهُ","مَن وَتَرَ الدَهرُ باتَ مَرعوبا",12,"ب",2,0],["بِقُربِ النَجمِ عالِيَةِ الهَوادي","يَبيتُ عَلى مَناكِبِها السَحابُ",13,"ب",1,0],["بَقِيتَ لمَنْ يَبْغي نَوالَكَ مَلْجَأً","ودُمْتَ لمَنْ يَرجو زمانَكَ مَؤْئِلا",14,"ل",2,0],["بقَصائِدٍ قَسَتِ الليالي واكْتَسَتْ","مِنْها فرقَّتْ بُكْرَةٌ وأصيلُ",15,"ل",1,0],["بَقِيتَ ولا زالَتْ تَروحُ وتَغْتَدي","إليكَ المَساعي غَضّةَ المُتَنَسَّبِ",16,"ب",1,0],["بَقِيتَ مَصونَ العِرْضِ مُبْتَذَلَ الندىً","مَديدَ رِواقِ العِزِّ طَلاّعَ أنْجُدِ",17,"د",1,0],["بَقيتَ ولا أبْقى لكَ اللهُ كاشِحاً","على غَرَرٍ يُرْمَى بهِ الرَّجَوانِ",18,"ن",1,0],["بَقيتَ ضَجيعَ العزِّ في حِضْنِ دَولَةٍ","لَبِسْتَ بِها طَوْقَ الأهِلَّةِ مُفْرَغا",19,"غ",2,0],["بَقيتَ لمَجْدٍ يتَّقِي دونَهُ العِدا","تَناوُشَ رَقَّاصِ الأنابيبِ لَهْذَمِ",20,"م",1,0],["بَقايا جَوًى تحتَ الضُّلوعِ كأنّها","لَظىً بِشآبيبِ الدّموعِ يُؤَرَّثُ",21,"ث",1,0],["بَقيتَ كِناساً للظِّباءِ ومَرْبَعاً","جَنابُكَ لا يشْكو عَفاءً ولا مَحْلا",22,"ل",2,0],["بقِيتَ أخا سعْدٍ جَديدٍ لباسُهُ","وعِزٍّ على الأيّامِ ممْتَنِعِ الصَّوَى",23,"و",2,0],["بَقيتَ رِياضاً للمَحاسِنِ والنُّهَى","إذا صوّحَ الرّوْضُ المؤرَّجُ أو ذَوَى",24,"و",2,0],["بِقُرْبِ أَخِي الْمَحْضِ الْوِدَادِ وَوَاحِدِي","ونورِيَ في داج من الخطب مظلم",25,"م",1,0],["بَقِيتَ عَظِيمَ الْقَدْرِ وَالصِّيتِ مَا سَرَتْ","سِرَاعُ الْمَطَايَا بِالْمُقَامِ الْمُعَظَّمِ",25,"م",1,0],["بَقِيتَ فِي ظِلِّ مُلْكٍ لاَ نَفَادَ لَهُ","وَالدَّهْرُ طَوْعُكَ وَالأَيَّامُ كَالْخَدَمِ",26,"م",1,0],["بَقيتَ في ظِلِّ مُلْكٍ غيْرِ منْصَرِمٍ","مُصاحَبٍ غيْرِ محْصورٍ الى أمَدِ",27,"د",1,0],["بَقيتَ لبَذْلِ نَوالٍ وجُودٍ","ونَشْرِ بُنودِ ونَصْرِ جُنودْ",28,"د",1,0],["بَقيتَ في ظِلِّ عَيْشٍ لا نَفادَ لهُ","مُصاحَباً غيْرَ محْصورٍ الى أمَدِ",29,"د",1,0],["بَقيتَ مُنَى نَفْسٍ وتُحْفَةَ قادِمٍ","ومَوْرِدَ ظَمْآنٍ وكعبَةَ مادِحِ",30,"ح",1,0],["بَقيت قَريرَ العيْنِ ما ذَرّ شارِقٌ","وما طافَ بالبَيْتِ العَتيقِ حَجيجُ",31,"ج",1,0],["بَقِيتَ يا قَمَرَ العَلْياءِ مُنْفَرِداً","بالعِزِّ تُسْعِدُ بَيْتَ المُلْك بالذّاتِ",32,"ت",1,0],["بَقِيتَ إِذَا اسْتكْفَاكَ كُلَّ مُهمَّةٍ","وَلَمْ تَأَلُ في صِيتٍ بَعِيدٍ وَهِمَّة",33,"ه",1,0],["بِقافِيَةٍ حَذّاءَ سَهلٍ رَوِيُّها","كَسَردِ الصَناعِ لَيسَ فيهِ تَواتُرُ",34,"ر",1,0],["بَقى عَنها المَصيفَ وَصارَ صَعلاً","وَقَد كَثُرَ التَذَكُّرُ وَالقُعودُ",35,"د",1,0],["بِقَوامِها الحَسَنِ الَّذي","جَمَعَ المَدادَةَ وَالجَهارَه",36,"ر",2,0],["بَقِيَّةِ خَمسٍ مِنَ الرامِسا","تِ بيضٍ تُشَبِّهُهُنَّ الصِوارا",37,"ر",2,0],["بِقَلائِدٍ ما أُنشِدَت في مَحفَلٍ","إِلّا وَكانَت عُقلَةَ المُستَعجِلِ",38,"ل",1,0],["بَقيتَ عَفيفَ الدينِ تُرجى وَتُتَّقى","وَيَأمَنُ مِن صَرفِ الزَمانِ بِكَ الجارُ",39,"ر",1,1],["بِقَدِّكُما إِن شِئتُما فَتَطاعَنا","بِكُلِّ رُدَينِيِّ القَوامِ مُثَقَّفِ",40,"ف",1,1],["بَقيتَ فَكَم شَرَّفتَ بِاِسمِكَ مِنبِراً","وَكَم نالَ مِن فَخرٍ بِذِكرِكَ خاطِبُ",41,"ب",1,0],["بَقيتَ كَما تَبقى مَعاليكَ إِنَّها","خَوالِدُ حينَ العَيشُ كَالظِلِّ زائِلُ",42,"ل",1,0],["بِقاعِ النَقيعِ فَحِصنِ الحِمى","يُباهينَ بِالرَقمِ غَيماً مُخيلا",43,"ل",2,0],["بقده المقوم الفتان","وصوته المرخم الرنان",44,"ن",1,0],["بَقِيَ الِّذكْرِ وَالرَّغَامُ فَنِي","وَسَيَحْيَى فِي الخَالِدِينَ فِني",45,"ن",2,1],["بِقوَّةِ نَفْسٍ يَكْفُلُ النَّصْرَ غِبهَا","وَهَلْ مَعَ ضَعْفِ النَّفْسِ إِلاَّ الهَزَائِمُ",46,"م",1,0],["بِقَوَافٍ مُجَنَّحَاتٍ تَلاَقَتْ","حَوْلَهُ فِي تَعَاقُبِ الأحْوَالِ",47,"ل",1,0],["بِقَومٍ كَقَومي أَو لَعَلَّكَ فاخِرٌ","بِخالٍ كَزادِ الرَكبِ أَو كَالشَمَردَلِ",48,"ل",1,0],["بِقاعٍ مَنَعناهُ ثَمانينَ حِجَّةً","وَبِضعاً لَنا أَحراجُهُ وَمَسائِلُه",49,"ل",2,0],["بقيتَ للدين والدنيا إمامَ هدى","مبلَّغ النّفس ما ترجو أمانيها",50,"ي",3,0],["بقيتَ متى يبلَ الزمان تجُدَّهُ","وفي كل يوم منك عيدٌ وموسمُ",51,"م",1,0],["بقيتَ لأعلام الزمان تُنيلها","هُدّى ولأحداث الخطوب تروعُها",52,"ع",3,0],["بقيتَ ابنَ خلدونٍ إمام هدايةٍ","ولا زلتَ من دنياك في جنَّة الخُلدِ",53,"د",1,0],["بقيتُم به في ظلِّ جاءِ وغبطةٍ","تَخُبُّ إلي لُقيا نجيبِكُمُ النُّجْبُ",54,"ب",1,0],["بَقِيَّةُ الخُلجِ أَعمى ماتَ قائِدُهُ","قَد أَذهَبَ اللَهُ مِنهُ السَمعَ وَالبَصَرا",55,"ر",2,0],["بَقِيَت طُلولُكِ يا أُمَيمُ عَلى البِلى","لا مِثلَ ما بَقِيَت عَلَيهِ طُلولُ",56,"ل",1,0],["بَقَرٌ أَوانِسُ لَم تُصِب غِرّاتِها","نَبلُ الرُماةِ وَلا رِماحُ المُستَمي",57,"م",2,0],["بَقايا مِن تُراثِ مُقَدِّماتٍ","وَما جَمَعَ المَرابيعُ الثِقالُ",58,"ل",1,0],["بَقَرٌ مَساكِنُها مَسارِبُ عازِبٍ","وَاِرتَبَّهُنَّ شَقائِقٌ وَصَريمُ",59,"م",1,0],["بِقَلبي عَلى جابِرٍ حَسرَةٌ","تَزولُ الجِبالُ وَلَيسَت تَزولُ",60,"ل",1,1],["بَقيتَ ما غَرَّدَت وُرقُ الحَمامِ وَما اِس","تَهَلَّ مِن مونَقِ الوَسمِيِّ باكِرُهُ",61,"ر",2,0],["بِقَوافٍ أَلَذُّ مِن بارِدِ الما","ءِ وَلَفظٍ كَاللُؤلُؤِ المَنثورِ",62,"ر",1,0],["بَقيتَ اِبنَ عَبدِ اللَهِ تُحمى مِنَ الرَدى","وَيَفديكَ مِنّا سَيِّدٌ بَعدَ سَيِّدِ",63,"د",1,0],["بَقاءُ البيضِ عُمرُ السُمرِ فيهِم","وَحَطُّ السَيفِ أَعمارُ اللِقاحِ",64,"ح",1,0],["بِقاعِ نَقيعِ الجِزعِ مِن بَطنِ يَلبَنٍ","تَحَمَّلَ مِنهُ أَهلُهُ فَتَتَهَّما",65,"م",2,0],["بَقِيَّتُكُم عَمرٌ أَبَحناهُ بِالقَنا","بِيَثرِبَ نَحمي وَالحُماةُ قَليلُ",66,"ل",1,1],["بقيت لهذا الدّهر تحملُ صنعهُ","وتغفرُ من زَلاّته حينَ يذنب",67,"ب",1,0],["بقيت مدَى الدُّنيا لمجدٍ تصونه","وأعلاق مالٍ للعفاة تبيحها",68,"ح",3,0],["بقيتَ ممدّحاً في كلِّ نادٍ","مدائحَ كلها وسطى القلاده",69,"د",2,0],["بقيتَ لعادة في الجودِ منكم","ومنّا في مدائحكم شهاده",70,"د",2,0],["بقيت بقا الأيامِ للفضل خالداً","وهنّ الورى في العلم والجود واحدا",71,"د",2,1],["بقيت لنا تعلو عن الشعر رتبة","نعم وعلى هامِ السماكين والشعرى",72,"ر",2,0],["بقيت لداعي المدح وجهك عيده","وأنمل كفيك الكريمة عشره",73,"ر",2,0],["بقيت مدَى الدنيا جمالاً لدولةٍ","لها منك شهمٌ في اللقا ورئيس",74,"س",1,1],["بقيت لحمدٍ مثل فضلك واف","وكافاك عنَّا الله خير مكاف",75,"ف",1,1],["بقيتمُ يا بني العلياء في نعمٍ","ملء الزمان وفي أمنٍ وفي جذل",76,"ل",1,0],["بقيت مدى الدنيا إلى الفضلِ سابقاً","وكلّ امرئٍ فيها بمدحِك تالي",77,"ي",1,0],["بقيت ابن فضل الله في الفضلِ مفرداً","كشهرك أو شعري الذي لك قائله",78,"ل",2,1],["بقّلت وجنة المليح وقد ولّ","ى زمان الضنا الذي كنت أملك",79,"ك",1,1],["بقيتَ مدى الأيام تخدم بالهنا","وكل صناع اللفظ صائبة الرمي",80,"م",2,0],["بقيت على أولادِ آدم منعماً","وعن كلِّ سام قد علوت وحام",81,"م",1,0],["بقيَّة القوم مع قرب النجوم لهم","همّ بمالِ اليتامى والمساكين",82,"ن",1,0],["بقيت لهذا الدهر تبسط إن أسا","يديك فما ينفكُّ أن يتنصَّلا",83,"ل",2,0],["بِقَلبي وَروحي وَالضَميرِ وَخاطِري","وَتَردادِ أَنفاسي وَعَقدِ لِساني",84,"ي",1,0],["بُقعةٌ لا تَني تُفاخر عطَّا","راً وتُشْجي بوَشْيِها وَشَّاءَ",85,"ا",2,0],["بَقْباقةٌ كبقبقات الحُبّ","هدَّار