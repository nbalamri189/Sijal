الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77152","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123521","الطويل"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136822",""],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58012","الكامل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136383",""],[4591,"","https://poetry.dctabudhabi.ae/diwan/poem/144249","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4755,"زوجةُ المُجَنَّد","https://www.poetsgate.com/ViewPoem.aspx?id=184496",""],[4578,"حويت المجد بالهمم العلية","https://www.poetsgate.com/ViewPoem.aspx?id=49616",""],[4992,"كَبُر الهوان","https://www.poetsgate.com/ViewPoem.aspx?id=6008",""],[5183,"الهمة الوثابة","https://www.poetsgate.com/ViewPoem.aspx?id=185637",""],[5186,"ورد الربيع شذا من ربع غسان","https://www.poetsgate.com/ViewPoem.aspx?id=156440",""],[5198,"احساس الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=135383",""],[592,"بهجر أضاء الفجر واستعلن الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128846",""],[592,"سؤال فهل مفت من القوم ينظم","https://www.poetsgate.com/ViewPoem.aspx?id=128819",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5409,"تركت وراءك البلد الأمينا","https://www.poetsgate.com/ViewPoem.aspx?id=155482",""],[5480,"عاضد العز","https://www.poetsgate.com/ViewPoem.aspx?id=9881",""],[5572,"ظبية البان","https://www.poetsgate.com/ViewPoem.aspx?id=53653",""],[5573,"مايجهل التقدير","https://www.poetsgate.com/ViewPoem.aspx?id=200312",""],[5581,"السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=22519",""],[5725,"يغتابنا العصفور","https://www.poetsgate.com/ViewPoem.aspx?id=193602",""],[5853,"ردّ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=175668",""],[5855,"تملكت الفؤاد بدون علمي","https://www.poetsgate.com/ViewPoem.aspx?id=209004",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[2220,"وأحكامها خمسٌ تلوحُ لناظرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11152&r=&rc=26",""]],"verses":[["وَاحْكُمْ عَلَى الدَّهْرِ وَافْعَلْ مَا تَشَاءُ بِهِ","فَالدَّهْرُ طَوْعُكَ وَالأَيَّامُ كَالْخَوَلِ",0,"ل",1,0],["وَأَحْكَمْتَ عَقْدَ السَّلمِ لَمْ تَأَلُ بَعْدَهُ","وَفَاءً فَصَحَّ الْعَقْدُ وَاسْتَوْثَقَ الرَّبْطُ",1,"ط",1,0],["وَأَحْكِمِ السِّلْمَ لَهُمْ عَاقِداً","عُقْدَةَ غِرٍّ ظَاهِرٍ نَابِهِ",2,"ب",2,0],["وَأَحكِم كُلَّ قافِيَةٍ جَديدٍ","تُخَيّرُها غَرائِبَ ما تَقولُ",3,"ل",1,0],["واحكِ الكواكبَ في البقاءِ كمثلِ ما","حاكيتها في بهجةٍ وعلاء",4,"ا",2,0],["وَأَحكَمِ مَن تَحَكَّمَ في يَراعٍ","وَأَبلَغِ مَن تَبَلَّغَ مِن دَواةِ",5,"ه",1,0],["وَاِحكُموا الدُنيا بِسُلطانٍ فَما","خُلِقَت نَضرَتُها لِلضُعَفاء",6,"ا",2,0],["وَاِحكُم بِعَدلِكَ إِنَّ عَدلَكَ لَم يَكُن","بِالمُمتَرى فيهِ وَلا المَشكوكِ",7,"ك",1,0],["وأحكم الناس في صناعته","من اقتدى بالمهيمن الباري",8,"ر",2,0],["وأحكم مغاليق أبوابه","إلى أن يسد عليه السبيلُ",9,"ل",1,0],["وَأَحكَمَتني مِنَ الأَيامِ تَجرِبَةٌ","حَتّى نَهَيتُ الَّذي قَد كانَ يَنهاني",10,"ي",1,0],["وأَحكَمها داودُ عن وَحْيِ ربّهِ","بلطفِ يدٍ قاسي الحديدِ لها شَمْعُ",11,"ع",1,0],["وأحكم الإمامُ في تدبيرهِ","على بني هابلَ في مَسيرهِ",12,"ه",1,0],["وأَحكمَ حكمَ اللَّهِ بينَ عبادهِ","لسانٌ بآياتِ الكتابِ طَليقُ",13,"ق",1,0],["وَأَحْكَمَ الرَّأْيَ فَمَا حِكْمُهُ","إِلاَّ فِعَالٌ أَعْقَبَتُهَا فِعَالْ",14,"ل",1,0],["وأحْكِم اللحنَ يا ساقي وغنِّ لنا","إنَّا محيّوكِ يا سلمى فحيينا",15,"ن",2,0],["واحكِ، يا إيوان كسرى، للوَرَى","ذلك البرج المُعَلَّى: من محاه؟",16,"ا",2,0],["وأحكامُ القضاءِ مغفَّلاتٌ","يُسئنَ إذا انتخبنَ الإِقتراعا",17,"ع",2,0],["واحكموا بالعسف حتّى كأنّا","قد مثلنا أمامكم أنعاما",18,"م",2,0],["واحكمها باحكام تسامت","وصارت في السلوك الحق دينا",19,"ن",2,0],["واحكام القدير لها نفوذ","وليس على القدير من اعتراض",20,"ض",1,0],["واحك احاديث كرام لهم","صح فخار الجد والجد",21,"د",1,0],["واحك للصب شان من","سكنوا لب قلبه",22,"ب",2,0],["وأُحكِمَ تَجرِيبي وشَابَت مَفَارِقِى","وخَامَرني الإِيمانُ والعَقلُ والنَّقلُ",23,"ل",1,0],["واحكُم بِرَأيِكَ فِينَا أنتَ حِاكِمُنَا","والرَّاىُ مِنكَ مُصِيبٌ مَفصِلَ الرَّشَدِ",24,"د",1,0],["وأحكم بالبرهان دعواه واعتلى","مقاماً عن التخمين والقول بالحدسِ",25,"س",1,0],["وَاِحكُم عَلى كُلِّ مَن رامَ العِنادَ لَهُ","بِحُكمِ جَدِّكِ في النُعمانِ إِذ عَنَدا",26,"د",2,0],["وَأَحكامُها قد ضمّنت كلّ حكمةٍ","وَما اِحتَكرت عن طالبٍ فضلها حكرا",27,"ر",2,0],["وَاِحكُم تَجدها بِالذي","تَهوى ملبِّيَةً نِداك",28,"ك",1,0],["وَاحكم فحُكمُك في البَرِي","يَةِ نافذٌ نَهياً وَأَمرا",29,"ر",2,0],["وأحكامه في الأمر والنهي والشرى","وفي البيع تبقى والجبال تصدّع",30,"ع",1,0],["وَاِحكُم جَزاءَ جَميلِ صُن","عِكَ في حَياتي بِاِشتِطاطِ",31,"ط",1,0],["وَاِحكُم عَلى الأَيّامِ مالِكَ أَمرِها","حُكمَ المُطاعِ فَفي يَدَيكَ زِمامُها",32,"م",3,0],["وَاِحكُم عَلى الدُنيا مُطاعَ الأَمرِ مُت","تَبَعَ المَراسِمِ نافِذَ التَوقيعِ",33,"ع",1,0],["واحكم بما تختار في","أمواله وأنا الضمين",34,"ن",1,0],["واحكم أَسباب النجاة وَهم عَلى","شفا جرف هار لانقاذ عاثر",35,"ر",1,0],["وَأَحكَامُ الليالِي جَارِيَاتٌ","عَلَى المَنْخُوبِ قَلباً والجَرِيِّ",36,"ي",1,0],["واحْكُمُوا إنّ البُكَا لَجّ بِنا","فَعَبَرْنا عَبْرَتَيْهِ لُجَجَا",37,"ج",2,0],["وَأَحكمَ عقدةَ التزويج وفقاً","لما كان المسيحُ به أشارا",38,"ر",2,0],["وَأحكمَ ما بينَ البغاةِ وبَيننا","مِنَ الحزمِ عهداً حبلهُ ليسَ يفسخُ",39,"خ",1,0],["وَاِحكُم بِما شِئتَ مَدحاً فيهِ وَاِحتَكِمِ","وَقُل وَناظِر وَفاخِر كُلِّ ذي صَلَفِ",40,"ف",1,0],["وأحكي لمن غيروا قصّتي","وأعصر من حزنهم عبرتي",41,"ي",1,0],["وَأَحُكُّ لَيلي بالمَرا","فِقِ واليَدَيْنِ وَلستُ أَلحَقْ",42,"ق",1,0],["وَأَحكَمَ عَقدُ زِناري بِعَقدٍ","لَحَلَّ عُقودِ إِحرامي يُبيحُ",43,"ح",1,0],["وأحكمهُ شيبُ القَذالِ عن الصبا","فكيف تصابيه وقد صارَ أَشيبا",44,"ب",2,0],["واحْكُمْ مطاعاً بما تَهْوى على زمنٍ","أيّامُ مُلْكِكَ في أيّامِه غرَوُ",45,"ر",2,0],["واحكُمْ بما ترتضِيهِ فَهْوَ إِذا","رضيتَ عنه رِضاً عن الزمنِ",46,"ن",1,0],["وأحكاماً بَثَثْنَ العدلَ حَتَّى","تقاسَمَها الأَباعِدُ بالسَّواءِ",47,"ا",2,0],["واحكمه قافية واختر فرائده","من الروائع إن مدحا وإن غزلا",48,"ل",2,0],["واحْكمِ الوُدَّ بالهُيامِ دَواماً","ما بأَمرِ الهُيامِ قيلٌ وقَالُ",49,"ل",1,0],["واحكم على جور الزمان بعادل","ورث الكفالة عن كفيل هادر",50,"د",2,0],["واحكي فما ثَمَّ آذانٌ وألسنةٌ..","تَبًّا لكلِّ لسانٍ لم يكنْ أُذُنَا!",51,"ن",2,0],["وأحكمت لأناس","بالسر بدل عبسه",52,"س",2,0],["وَاحْكُمْ بِمَا تَرْضَى فَأَنْتَ أَحَقُّ مَنْ","مَلكَ الفُؤَادَ يَجورُ فيهِ ويَعْدِلُ",53,"ل",1,0],["واحكُم لمِثلي بالوفاءِ مُسَجِّلاً","أَن لا أكُونَ عَلى الوَفاءِ مَلوما",54,"م",2,0],["وَاِحكُم إِجراءَ العَدالَةِ في الوَرى","وَعِمتَ لَهُ كُلِّ العِبادِ مَراحِمُ",55,"م",1,0],["وأحكامه في الخلق بالعدل قد مضت","فما منهم من يستطيع لها نقضا",56,"ض",2,0],["واحكمي ما شئت واحتكمي","فحرامي فيك تحليل",57,"ل",1,0],["وأحكمت في صحو النهار وسائلاً","ترامت بها تلك الليالي الرواعد",58,"د",1,0],["واحكم فما لوزارة العمال من","أمر ولا لوزارة الأحرار",59,"ر",1,0],["وَاِحكُم بِما قَد شِئتَ في دَنفٍ","وَاِسلُك بِهِ في أَعدَلِ النهجِ",60,"ج",1,0],["وَاحكُم بِالاعتيادِ فَهوَ أَحكمُ","إِذ كُل شَيءٍ مَعهُ مُسَلَّمُ",61,"م",1,0],["واحكمْ فإنا تخاصمْنا إلى حكمٍ","عدْلٍ يؤلفُ بين الشّاءِ والنمر",62,"ر",1,0],["واحك لنا هل بزغت من بعدنا","في دارة الشهد أقمار الدجا",63,"ا",1,0],["وأحكمت عقد ميثاق الوفاء بها","مَراسمٌ نُزهت عن نقد مُنتقد",64,"د",1,0],["وإحكامُ عقدٍ أثبت الصدق رسمهُ","فمن ذا يردّ الحكمَ واللّه حاكمُ",65,"م",1,0],["وَأَحْكَامُهُ مَقْبُولَةٌ وَهْوَ عَادِلُ","وَمَنْ ذَا يُضَاهِي قَدْرَهُ أَوْ يُمَاثِلُ",66,"ل",1,0],["وَأَحْكَامُهُ بِالْقِسْطِ صَارَتْ مُشَاعَةً","وَمَدْحِي لَهُ يَرْقى وَيَبْقى بِضَاعَةً",67,"ه",1,0],["وأحكم أبوابها المصمتات","على السور بها المستعينا",68,"ن",2,0],["واحك ذلي لعزه وتعطف","فعسى يرحم العزيز الذليلا",69,"ل",2,0],["وأحكمهم عقدا وأمنعهم حمى","وأصدقهم قولا وأوسعهم مغنى",70,"ن",2,0],["وأحكمت مجموع المزايا ففضلها","وتمداحها في ساير الصحف أنزلا",71,"ل",2,0],["واحْكُمْ ولا تَسْتَشِرْ في حالةٍ غَضَباً","فإِنَّه مُسْتَشارٌ غيرُ مُؤْتَمَنِ",72,"ن",1,0],["وأحكم الكوة دون الصبا","وأوصد الباب على الشمأل",73,"ل",1,0],["واحكم على مواضع الأخبار","نصبا ولو عزّ عن الإظهار",74,"ر",1,0],["واحكم به لأول الأجزا وفي","أول شطر ضرب بيت قد يفي",75,"ي",1,0],["وأحك\"م رفع\" الملك إذا نصب العدا","على حال ذل \"نال\" من ضل جهدُه",76,"د",2,0],["وَأَحكمُ في أَهلِ الزَّمانِ كَما أَشا","وَأَملِكُ ما صانوا وأَهدِمُ ما شادوا",77,"د",3,0],["واحكم له يا مصطفى برضا اذا","يوم القيامة قد علت ميزانه",78,"ن",2,0],["واحكم الملك واستحكم","لا يختلف فيه اثنان",79,"ن",1,0],["وَأَحكَمُهُ التَجريبُ حَتّى كَأَنَّما","يُعايِنُ مِن أَسرارِهِ ما تَوَهَّما",80,"م",2,0],["واحكم بنفي الضاد إن تك عينُهُ","راءً ولامُ اللفظ فاءً تُوسمُ",81,"م",1,0],["واحكم بظاءٍ حيثُ توجدُ فاؤه","نوناً ولامُ اللفظِ ميماً تُرسمُ",81,"م",1,0],["وَأَحكم عَلى ماء النَباهة طَبخه","قَليلاً قَليلاً وَاِحذر العُنف وَاِرفق",82,"ق",1,0],["واحكم عليه به إن كنتَ ذا نَصَفٍ","فإنما العلمُ والتحقيق في النسب",83,"ب",1,0],["وأحكامها خمسٌ تلوحُ لناظرٍ","شديدٍ شديدِ البحثِ عن طرق السوا",84,"ا",1,0],["وأحكم الطبعُ بها شهوةً","إذ أحكم الصانعُ بُنيانها",85,"ن",3,0],["وأحكم أشياءَ وأرسلَ حكمةً","وصيرَّ أعمالَ الكيانِ هَباء",86,"ا",2,0],["واحكُم إذَا فِي رُفقَةٍ قَد سَافَرُوا","يَبغُونَ فاطِرَ هَذِهِ الأكوَانِ",87,"ن",1,0],["وَاحكُم بسَفكِ دِمَائِهِم وَبِحَبسِهِم","أو لاَ فشَرِّدهُم عَنِ الأوطَانِ",87,"ن",1,0],["وَاحكُم بأيِّهِمَا تَشَاءُ وَإنَّنِي","لأراكَ تَقبَلُ شَاهِدَ البُطلاَنِ",87,"ن",1,0],["واحكم هداك الله حكما يشهد ال","عقل الصريح به مع القرآن",87,"ن",1,0],["وَاِحكُمونا بِالدِكتاتورِ وَبِالإِر","هاقِ وَالعَسفِ نَنتَبِه مِن رُقودِ",88,"د",1,0],["واحك العصافير صي صي صي صصي صصصي","إذا تجاوبن في الصبح العصافير",89,"ر",1,0],["واحكم بما شئت فالأوطان طائعة","وكل يوم يزيد الملك تمكينا",90,"ن",2,0],["وَأَحكمَ تَرتيبَ مُحكمِهِم","فَسَرَّ العِناج وَسر الكَرَب",91,"ب",1,0],["وأحكم على أهل القريض وقل لهم","لا تمعنوا في نحونا تخريبا",92,"ب",2,0],["واحك لي هل زرت قوما حكما","دهرنا فيهم بأحكام المجوس",93,"س",1,0],["واحكم بِما شئت مدحاً فيه واحتكم","واصرف قواك فَما بالصرف من سَرَف",94,"ف",1,0],["واحكم لبنيان