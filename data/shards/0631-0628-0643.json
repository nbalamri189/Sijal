//www.poetsgate.com/ViewPoem.aspx?id=33893",""],[6237,"عودة إلى الطبيعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77860&r=&rc=2",""]],"verses":[["رُبَّ كَرمٍ مَدَّه الليلُ لنا","فَتواثَبنا له نَبغِي اقتطافَه",0,"ه",1,0],["رَبُّ كفْتيٍ سباني حسنُهُ","لا أرى مِنْ حبهِ لي مخرجا",1,"ج",2,1],["رَبِّ كَلاً حَتَّمتَهُ وَارِدَ النارِ","كِتاباً حَتَّمتَهُ مَقضِيّا",2,"ي",2,0],["رُبَّ كَأسٍ كَالسَلسَبيلِ تَعَلَّل","تُ بِها وَالأَنامُ عَنّي نِيامُ",3,"م",1,0],["رُبَّ كعاب في حجابٍ لم تزلْ","مثلِ الغزالِ عنقاً ومُكتحَلْ",4,"ل",1,1],["ربك كريم فضله واسع","وبردُه تدبيرُه يغْلب",5,"ب",1,0],["رَبِّ كُن عوني وَأَخِّرني إلى","أَن أَرى شمسَ الضحى من عُوَّدي",6,"د",2,0],["ربّ كل الأشياء تبنض فيها حيَ","واتٌ لكنّها خرساءُ",7,"ا",2,0],["رُبّ كربٍ قد عرا ثم انْجَلى","مِثلما انْجابَ عن الصبّحِ الظَّلامُ",8,"م",1,0],["رب كأسٍ له بقبة شاذِكْلا","وفي حجرة الرخام أداره",9,"ر",2,0],["رب كف تكفُّ عادية الض","يق ووجهٍ به تداوى الهموم",10,"م",1,0],["رَبُّكَ بالعقلِ على ال","خَلْقِ الكَثيرِ فضَّلَكْ",11,"ك",1,0],["ربِّ كنْ لي منها لباساً حصيناً","إنّها دون ما كفيتَ قديما",12,"م",2,1],["رب كف ثرة خلقت","ضرة للعارض الهتنِ",13,"ن",1,0],["رُبّ كلْبٍ رأيته في وثاقِ","جعل َ الكلب للأميرِ جمالا",14,"ل",2,1],["رُبَّ كأسٍ قَد كَسَت جُنحَ الدُجى","ثوبَ نورٍ من سَناها أَشرُقا",15,"ق",2,0],["رب كاس من الجمال كما يؤ","ثر عار من الجميل اهابه",16,"ب",2,0],["رب كرمه وأكرمني به","واكفني أفعال عار وشنار",17,"ر",1,0],["رَبٌّ كَريم في خرق","الماء رَيٌ وَشَرق",18,"ق",1,0],["رب كثر جمعهم وأطل","عمرهم بالبؤس والعدم",19,"م",1,0],["ربَّ كأسٍ تسوغُ مناه حياةً","وكؤوسٍ تسوغُ منها حِماما",20,"م",2,0],["ربك أعطى المصطفى نايفاً","غصناً بأَوراق المنى وارفا",21,"ف",2,1],["رَبِّ كَما مَلَّكتَها يوسُفَ","الصِدّيقَ مِن أَولادِ يَعقوبِ",22,"ب",1,0],["رب كريم غافر","ذنب الذي متورطا",23,"ط",2,0],["رب كأس وردية شمت فيها","وجنتيه فساغ منها ورودي",24,"د",2,0],["رُب كوخ مطمئنٍ أهله","وقصور اهلها مضطربون",25,"ن",1,0],["ربّ كف تقبيلها يبسط ال","رزق ويعطي الأمان من حرمانه",26,"ن",2,0],["ربٌ كريمٌ رازقٌ هَداني","لهذِه التحفةِ واحتباني",27,"ي",1,0],["رب كأس تذهب الحز","ن وتأتي بالمراح",28,"ح",1,0],["رب كوخٍ حسبته جوسقاً","فتقاضت ربه مالاً فصاما",29,"م",2,0],["ربِّ كفَّ المصطفى أجعلُها","فوقَ داءٍ منهُ آذى الأبَوي",30,"ي",1,0],["رب كما فرّحتني بالوفا","أسبل علية الستر ياسيدي",31,"ي",1,0],["ربِّ كما أوليتنا من الكرمْ","هذي النعمْ قَيِّدْ علينا ذي النعمْ",32,"م",1,0],["ربِّ كما حفظت روحي في الجسدْ","فاحفظْ لنا إلهِ من كل أحدْ",33,"د",1,1],["ربِّ كما أدخلتنا ذا القرنا","فوالِنا بخيره وزِدْنا",34,"ن",2,1],["ربِّ كما قد صرتُ تحتَ ذا الورى","وذاكَ من ذنوبي ذنبي فاغفرا",35,"ر",2,1],["ربِّ كما أمرتَ بالتوسلِ","لك توسَّلتُ بكلِّ ما ولي",36,"ي",1,1],["ربِّ كما رزقتني هذا الطعامْ","فاجعلْ لي الفِطرَ يفوق ذا الصيامْ",37,"م",1,1],["رُبَّ كَأسٍ تَنَقَّلَت لِحَكيمِ","بَعدَ إِشراقِها بِكَفِّ النَّديمِ",38,"م",1,1],["ربك القهار والغفار جل","مجرياً للفلك حقاً والفلك",39,"ك",1,0],["ربِّ كم اشتَكي الذي ليسَ يخفى","أترى ما يُرى لِقلبي رَحيمُ",40,"م",1,0],["ربِّ كم اكتُم الهَوى وأصونُ","والذي أرتجيهِ ليسَ يكونُ",41,"ن",1,1],["رب كلام وخز ألفاظه","أمض من مضاضة السهم",42,"م",1,0],["ربٍ كريم ٍ مع المظطر مامله","اليا ذكرته رخا يذكرك تعباني",43,"ن",2,0],["ربكتني وألهيتني عن سلامي","مدري وش اللي بآخذه منك وأعطيك",44,"ك",1,0],["رب كأس حبابها","من ثغور الحبائب",45,"ب",1,0],["رب كفر أقر دينا ودين","طاح بين التمويه والتغرير",46,"ر",1,0],["ربك كريم ومانسى خير الافعال","غيرك يموت بدنيته مافعل شي",47,"ي",1,0],["ربِّ كما يوسفَ الصديقَ","ديقَ من أَولاد يعقوبِ",48,"ب",1,0],["رُبَّ كرْبٍ فوقَ صدري جَثَما","وسقاني بيديْهِ العَلْقَما",49,"م",2,1],["ربك اللي سخرك لي تقود وما تقاد","والله الخالق ولله في خلقه شؤون",50,"ن",1,0],["رب كف تكفُّ عادية الض","ضيق ووجهٍ به تداوى الهموم",51,"م",1,0],["ربِّ كُن للشآمِ حِصناً حَصيناً","إنَّ مَن كُنتَ حِصنَه لن يَخِيبا",52,"ب",2,0],["ربك كريم ورؤف","هو الرحيم الحي",53,"ي",1,0],["ربّك عليم ٍ حاكم ٍ في قضاته","لا من قضاها تستوي دون صدّام",54,"م",1,0],["ربَّ كوخٍ يضمّ زوجين كالطفلين","طُهراً ورقةً كالأقداحِ",55,"ح",1,0]]}