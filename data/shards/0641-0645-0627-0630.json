"https://www.aldiwan.net/poem39778.html","الطويل"],[362,"هجر الراء واصل بن عطاء","https://www.aldiwan.net/poem61007.html","الطويل"],[363,"أعباس هل أبصرت مثلي فارسا","https://www.aldiwan.net/poem44373.html","الطويل"],[364,"وقد كنت تستغني بلحظك وحده","https://www.aldiwan.net/poem17012.html","الطويل"],[374,"لقد ضل من قد حاد عن مورد الكشف","https://www.aldiwan.net/poem59322.html","الطويل"],[374,"إذا كانت الأبرار في ذات ربهم","https://www.aldiwan.net/poem59327.html","الكامل"],[403,"ولما طواك البين واجتاحك الردى","https://www.aldiwan.net/poem50151.html","الطويل"],[406,"إذا حل حالك صبغ الشباب","https://www.aldiwan.net/poem31661.html","عموديه"],[413,"سقى الله جيرانا بأكناف حاجر","https://www.aldiwan.net/poem53824.html","الطويل"],[413,"تنفس عن وجد توقد جمره","https://www.aldiwan.net/poem54071.html","الطويل"],[429,"أقول رياض إذ ترصعها زهرا","https://www.aldiwan.net/poem12435.html","الطويل"],[429,"فهمت على البارق الممطر","https://www.aldiwan.net/poem12626.html","المتقارب"],[434,"سلام على الربع من ذي سلم","https://www.aldiwan.net/poem2553.html","المتقارب"],[438,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[438,"هو الرزء حتى خص ريش القوادم","https://www.aldiwan.net/poem14478.html","الطويل"],[456,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[464,"إذا ما الريح نحو الأثل هبت","https://www.aldiwan.net/poem50467.html","الوافر"],[466,"جمالي وزيني إذا ما حضر","https://www.aldiwan.net/poem59983.html","المتقارب"],[475,"يمينا لقد بالغت يا خل في العذل","https://www.aldiwan.net/poem15195.html","الطويل"],[475,"تضاعف ما ألقاه غير بديع","https://www.aldiwan.net/poem15269.html","الطويل"],[475,"صباه الهوى ما أحوج الخلو أن يصبو","https://www.aldiwan.net/poem15336.html","الطويل"],[477,"ألا بالتعاضد فلنبتد","https://www.aldiwan.net/poem37579.html","المتقارب"],[480,"سرى بفؤادي الوجد نحوك هائم","https://www.aldiwan.net/poem24474.html","عموديه"],[493,"أيا دمع إن لم ينجد الصبر أنجد","https://www.aldiwan.net/poem9817.html","الطويل"],[512,"نصال من جفونك أم سهام","https://www.aldiwan.net/poem20794.html","الوافر"],[546,"بكى صُرد لما رأى الحي أعرضت","https://www.aldiwan.net/poem1171.html",""],[549,"هي الدار موقوف عليك بكاها","https://www.aldiwan.net/poem47143.html","الطويل"],[549,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[549,"خيالك يا أميمة كيف زارا","https://www.aldiwan.net/poem47801.html","الوافر"],[549,"سقاني ولم أستسقه فضل خيره","https://www.aldiwan.net/poem47864.html","الطويل"],[556,"تمنيت لي عبدا ثمانون عمره","https://www.aldiwan.net/poem33724.html","الطويل"],[556,"بنا المولى هو الأحرى","https://www.aldiwan.net/poem34525.html","الهزج"],[556,"مقام بني الصديق ذروة فرقد","https://www.aldiwan.net/poem34602.html","الطويل"],[560,"أناس كلها تمسي ترابا","https://www.aldiwan.net/poem52795.html","الوافر"]],"verses":[["فَما ذا الوَرى مِمَّن يُرادُ بَقاؤُهُ","وَلا المَوتُ مَعذولٌ إِذا جارَ حُكمُهُ",0,"م",2,0],["فَما ذاكَ إِلّا أَن يُوَفِّرَ طَعمَها","عَلَيكَ إِذا جَلّى إِلَيها وَحَقَّقا",1,"ق",2,0],["فَما ذاكَ إِن لَم يَلقَ حَتفاً بِخالِدٍ","وَلا ذا مِنَ الحَتفِ المُطِلِّ عَلى بُعدِ",2,"د",1,0],["فَماذا يُشيدُ هُتافُ النَعيِّ","فيكَ وَما يَندُبُ النادِبُ",3,"ب",1,0],["فَما ذاقَ طَعمُ المَوتِ في كَأسِ لَذَّةٍ","وَلا سَهِرَت عَينُ اِمرِئٍ لَيسَ يَعشَقُ",4,"ق",1,0],["فَماذا يُرَجَّى مِنكُمُ إِن عَزَلتُمُ","وَعَضَّتكُمُ الدُنيا بِأَنيابِها عَضّا",5,"ض",2,0],["فما ذُقْتُ أشْهى منْ مُشاهَدَةِ النّوَى","وأعظَمُ منْ بيْنِ الحَبيبِ المُوَدِّعِ",6,"ع",1,0],["فَمَاذَا عَسَى أَنْ يُنْظِرَ الدَّهْرُ مَا عَسَى","فَمَا انْقَادَ لِلزّجْرِ الْحَثِيثِ وَلاَ لاَنَا",7,"ن",2,0],["فَمَاذَا عَسَى أُحْصِي وَمَاذَا عَسَى أَفِي","أَيُنْضِبُ لُجَّ الْيَمِ مُسْتَنْزَرُ الشُّرْبِ",8,"ب",1,0],["فَماذا أَتَيتُ مِنَ الباقِياتِ","وَهَذا شَبابي ضَياعاً ذَهَب",9,"ب",1,0],["فَمَاذَا أَنْزَلَتْ فِيهَا","مِنَ البُؤْسِ أَعَادِيهَا",10,"ي",3,0],["فماذا اليومَ ضَرَّ لو التفتنا","إلى أسلافنا بعضَ الْتِفات",11,"ت",1,0],["فَماذا تَنظُرونَ بِها وَفيكُم","جُسورٌ بِالعَظائِمِ وَاِعتِلاءُ",12,"ا",2,0],["فَماذا أَرَدتَ إِلى رِمَّةٍ","بَدَوِّيَّةٍ صَخِبٍ هامُها",13,"م",3,0],["فما ذكري حبيب لها بباك","ولا عبث الوليد أبا عباده",14,"د",2,0],["فما ذنبُ طفلٍ كان تسبيبَ كونِه","رجاؤك يا مرجُوّ كلِّ فقير",15,"ر",1,0],["فما ذنبه في ذاك إن كان ربّه","قضى أنه أعلى وذو الرغم أسفلُ",16,"ل",1,0],["فما ذرَّ قرنُ الشمسِ حتى رأيتها","تعصفرها مثعنجرات تَهزَّمُ",17,"م",1,0],["فما ذَرفتْ عيني على رسمِ منزلٍ","ولا عكفَتْ نفسي هناك على صنمْ",18,"م",1,0],["فماذا وقوفي فيه اندب ارسما","تقاسي من الدهر العتي الاعاصيرا",19,"ر",2,0],["فماذا يعلم الأحياء عنا","إذا ما قيل عاد لها عرابي",20,"ب",2,0],["فماذا تريد بهذا السكون","وماذا تريد بهذا الوجوم",21,"م",1,0],["فَماذا في طَريقِكَ مِن كُفورٍ","أَجَلُّ مِنَ البُيوتِ بِها الرِجامُ",22,"م",1,0],["فَماذا تَرَكتَ لِمَن لَم يَسُد","وَماذا تَرَكتَ لِمَن كانَ سادا",23,"د",2,0],["فَماذا يَغُرُّ الحائِنينَ وَقَد رَأَوا","ضَرائِبَ ذاكَ المَشرَفِيِّ المُجَرَّبِ",24,"ب",1,0],["فَماذا اِشتَهَيتَ مِنَ الخُتَّلِيِّ","وَهَل لَكَ في الثَورِ مُستَمتَعُ",25,"ع",1,0],["فما ذِمَّةُ الأيامِ فيها ذميمةٌ","ولا جانبُ الدنيا بها متجنَّبا",26,"ب",2,0],["فَماذا حَوَت أَكفانُهُ مِن شَمائِلٍ","مَناهِلَ أَعدادٍ عِذابَ المَوارِدِ",27,"د",1,0],["فَماذا حَضَرتَ بِهِ حاضِراً","وَماذا خَبَأتَ لِأَهلِ الخِباءِ",28,"ا",2,0],["فَما ذِكرُهُ شَنباءَ وَالدارُ غَربَةٌ","عَنوجٌ وَإِن يُجمَع بِضُرٍّ وَيُنحَلِ",29,"ل",1,0],["فماذا به تُكنَى فقال لهم أنا","أبو القاسمِ ادْعونِي بها كُنْيَةٌ تَسُرْ",30,"ر",1,0],["فماذا من أيادِي اللهِ تَلْقَى","لقد جَلَّتْ فليس لها انصرامُ",31,"م",1,0],["فماذا في يَمينكَ يا خُبَيْبٌ","وما بالُ الصَّغيرِ من العيالِ",32,"ل",1,0],["فَما ذِقتُ مِن نَومٍ وَما زالَ عامِلاً","إِلى الصُبحِ ذاكَ البارِقُ المُتَأَلِّقُ",33,"ق",1,0],["فَما ذَرَّ قَرنُ الشَمسِ حَتّى كَأَننا","مِنَ العِيِّ نَحكي أَحمدَ بنَ هِشامِ",34,"م",1,0],["فَماذا أَقولُ وَبَينَ الأَنا","مِ خُلفٌ عَلى جَهلِهِم أَو تَمالي",35,"ي",1,0],["فَما ذَنبُنا في أَن أَداءَت خُصاكُمُ","وَأَن كُنتُمُ في قَومِكُم مَعشَراً أُدرا",36,"ر",2,0],["فَما ذاقَ طعم النوم للصبح عينها","ومن كانَ ينأى إلفه كيف يهجع",37,"ع",1,0],["فَماذا الَّذي جرّ بينهما","منازعة نارها تضرم",38,"م",1,0],["فَما ذُكِرَ الخلّانُ إِلّا ذَكَرتُها","وَلا البُخلُ إِلّا قُلتُ سَوفَ تَجودُ",39,"د",1,0],["فَمَا ذَاقَهَا حَتَّى تَهَلَّلَ ضَاحِكَاً","وَأَقْبَلَ مَسْرُورَاً بِمَا هُوَ آنِسُ",40,"س",1,0],["فَمَاذَا عَسَى الأَعْدَاءُ أَنْ يَتَقَوَّلُوا","عَليَّ وعِرْضِي نَاصِحُ الْجَيْبِ وَافِرُ",41,"ر",1,0],["فَمَاذا اقْتضته حَاله مِن تجَددٍ","وَقدْ يَقْتَضِي عَزْمُ الأُمورِ التَّجَدُّادَ",42,"د",1,0],["فماذا يقومُ لأفواهِهم","تباركَت يا أحسن الخالقينا",43,"ن",2,0],["فماذا ستفعل يا قلب ؟ تجثو","على قدميها .. تذوب ابتهالا ؟",44,"ل",2,0],["فما ذعرت ببدر غير مبتدر","ولا أمرت بأمر غير ممتثل",45,"ل",1,0],["فما ذقت أدهى من مشاهدة النوى","وأعظم من بين الحبيب المودع",46,"ع",1,0],["فماذا يلاقي وماذا يحسّ","وقد دفن الحبّ في البلقع",47,"ع",1,0],["فماذا يعاني ؟ ألا إنّه","جريح الإبا صامت لا يعي",47,"ع",2,0],["فَماذا يَغُرُّ الخَائِنِينَ، وَقَدْ رَأوا","ضَرَائِبَ ذاكَ المَشرَفيّ المُجَرَّبِ",48,"ب",1,0],["فما ذاق طعمَ الرىِّ من لم تُسَقِّه","أناملُه من صوبها المتواترِ",49,"ر",1,0],["فما ذلك الحسنُ مستقبَحا","بشَعرٍ ولو لاح فيه المشيبُ",50,"ب",1,0],["فَما ذَمُّهُ إِذ نالَ بَعضَ تِراتِهِ","وَما حَمدُهُ إِذ لَم يَجِد عَنكَ مَعدِلا",51,"ل",2,0],["فما ذاك مكروهٌ ولا بمحرّم","بشرع الهوى بل ذاك فرضٌ على الصب",52,"ب",1,0],["فما ذاك إلاَّ أن بشرك لم يحل","قطوباً وذاك الجود لم يستحل بخلا",53,"ل",2,0],["فَماذا عَسى يَجري إِلَيهِ المُمَوِّهُ","أَفي الحَقِّ شَكٌّ يَستَقِلُّ بِنَكثِهِ أَفي",54,"ي",1,0],["فَماذا عَسى يَحكي امروءٌ مِن سَنائِهِ","هُبوبُ رياحِ النَصرِ تَحتَ لِوائِهِ",54,"ه",1,0],["فما ذاق طعم الوصل من لم يذق نوى","ولا ارتاح بالتنفيس من لم يذق كربا",55,"ب",2,0],["فَماذَا الّذِى يَشفَى مِن الحُبِّ بَعدَما","تَشَرَّبَهُ بَطنُ الفُؤَادِ وَظاهِرُه",56,"ر",2,0],["فماذا غنمتم من رياء نعيمهُ","جحيمٌ وكتم الداء أنكى وأقتل",57,"ل",1,0],["فماذا دها الدنيا وماذا أصابها","أسفّت فأمست وهي في خمسة القرد",58,"د",1,0],["فما ذنب عبد أطاعك في حب","ه وعصى عاذليه عداك",59,"ك",1,0],["فَمَاذَا عَلى وُدِّهِمْ لَوْ دَنَا","وَمَا ضَرَّ لَوْ نَعَشُونِي يَسِيرَا",60,"ر",2,0],["فما ذاهب أملته غير راجع","ولا غائب أرجوه إلا كايب",61,"ب",1,0],["فماذا تَرتَجونَ إذا مدحتُم","أُناساً عندهم قطعُ الرجاء",62,"ا",2,0],["فَما ذَنبُ صاب ما لَها قَطُّ عَنكُمُ","وَمَا عيب صبَّ فِي هَواكُم لَما يَسلو",63,"ل",2,0],["فَما ذاكَ بِدعاً في دِمَشقَ لِأَنَّها","تَمَلَّكَها في سالِفِ الدَّهرِ زَبّالُ",64,"ل",1,0],["فماذا عساني أَنْ أقول بوصفِها","وما سامعٌ منِّي كمن كان رائيا",65,"ي",2,0],["فما ذات طوقٍ بان عنها أَليفُها","وما مطفلٌ قد ضلَّ منها رضيعها",66,"ع",3,0],["فماذا عسى تبقى عَلى الوجد والأسى","وَشحط النوى نفس عليك تصوب",67,"ب",1,0],["فما ذاك إلاّ نفثةٌ قذفتْ بها","لواعجُ همٍ في فؤادٍ مكلم",68,"م",1,0],["فماذا جنت كفّاي منهم سوى الذي","يطير له قلبي شعاعاً وينفنى",69,"ن",2,0],["فما ذرّة في الكون إلّا وعندها","مكان ركوع أو مكان سجود",70,"د",1,0],["فماذا دعى عينيك فاظلم نورها","وأطبقتها خوفا وأنركتها ذعرا",71,"ر",2,0],["فماذا يكون اتبدو الحياة","بقلب نقي وانف اشم",72,"م",1,0],["فَماذا عَسى أَنّي أَرى ما يَسُرُّني","مِن الدَهر إِلّا زادَ بي برح غَمِّهِ",73,"م",2,0],["فماذا وقد أَعدْتَ رسولي","بانكسارٍ يَمْشي على استِحياء",74,"ا",2,0],["فما ذَرَّ قَرنُ الشمسِ حتى تَوَثَّقَت","سُلَيمُ بن منصورٍ عليها حديدُها",75,"د",3,0],["فَماذا نَرى فيمَن حَوى فيكَ أَربَعاً","بِواحِدَةٍ مِنهُنَّ يَنفَطِرُ الصَخرُ",76,"ر",1,0],["فما ذنبُ شانيه ودينك غامضٌ","وأنَّى يلام العقل والعلمُ مُستَخفِ",77,"ف",1,0],["فماذا نقول اليوم في مجد مريمٍ","وقد جل حتى فاق طُورَ المعارف",78,"ف",1,0],["فَماذا الَّذي أَنعاه مِنكَ وَما الَّذي","أَعدده من كَفِّكَ الباطِشِ السَبطِ",79,"ط",1,0],["فماذا الغرور بزور الخضا","بلولا التعلل بالباطل",80,"ل",1,0],["فما ذكرَتْ نفسي على سفح رامةٍ","من الجزع إلاَّ ما يزيد ولوعها",81,"ع",3,0],["فما ذنبه من بعد ذلك ذنبه","ولا وزره من بعد ذلك وزره",82,"ر",2,0],["فماذا ترى في ناكحٍ بِنْتَ غيرِهِ","بلا غَيْرَةٍ منهُ ولم يَدْفَعِ المَهْرا",83,"ر",2,0],["فماذا تقولُ وعرْفُ الرياضِ","على جمرهِ فاحَ كالعَنْبرِ",84,"ر",1,0],["فماذا أرسم في مدحه","ويمتثل الدهر ما قد رسم",85,"م",1,0],["فما ذل مخفور وأنت خفيره","فكم منع الراشي عن القانص الأدوى",86,"و",2,0],["فما ذل حر عز بالعز جاره","ولا عز من أدناه مرعى اللوائم",87,"م",1,0],["فما ذنبي إذا وقَعتْ عُقابٌ","من الأيّام طار لها غرابي",88,"ي",1,0],["فَماذا يَمنَعُ الأَرواحَ تَسري","بِرَيّا أُمِّ عَمروٍ أَن تَطيبا",89,"ب",2,0],["فَماذا تَرى في ذَوي أَسهُمٍ","تَضيمُ الشَريفَ فَلا يَنتَصِر",90,"ر",1,0],["فما ذكرتْها النفسُ إلا تحدَّرتْ","مدامعُ تُغني الأرضَ عن ساجمِ الهَطْلِ",91,"ل",1,0],["فما ذُخِرَتْ تلكَ الدموعِ واِنْ غلتْ","لغيرهما في حِنْدِسٍ وصديعِ",92,"ع",1,0],["فماذا أرادوا بالفراقِ وبالنوى","لقد كان يكفي منهمُ الصونُ والُحجْبُ",93,"ب",1,0],["فماذا التنافر ماذا التقاط","ع ماذا التأخر بالبلد",94,"د",1,0],["فما ذاق من طعم الغرام لذاذة","وليس له في العشق سهم يساهم",95,"م",1,0],["فماذا عسى الواشون خاضوا على دمي","ومن أي وجه ثار لي أيُّ مؤْيِد",96,"د",1,0],["فما ذا العيدُ إلّا مُستَهامٌ","دعاهُ إلى زيارتِكَ الغَرامُ",97,"م",1,0],["فَما ذَرَّ قَرنُ الشَمسِ حَتّى رَأَيتُهُ","مُضادَ المَنايا وَالغُبارُ يَثوبُ",98,"ب",1,0],["فما ذا الّذي من غير وعدٍ أتى بها","وماذا على بُعدِ المزارِ هَداها",99,"ا",3,0],["فماذا وأنتمْ في الحضيض غباوةً","إذا ضُرِبتْ خيْماتُكمْ في المشارفِ",100,"ف",1,0],["فَماذا غرّهم وَسِواك ممَّنْ","يَزيد به مجرِّبه اِغتِرارا",101,"ر",2,0],["فماذا على مَن خاننِي في ودادِه","إذا لم يكنْ منه الوِدادُ تودّدا",102,"د",2,0],["فماذا تظن الله يفعل بعد ذا","بعبد رقيق يخدم الشرع والدينا",103,"ن",2,0],["فماذا أنت حتى تر","تجي أن تطرق الخدرا",104,"ر",2,0],["فما ذاك إلا رافضيٌّ مخصصُ","وكيف وطول المدح فيهم ملخص",105,"ص",1,0],["فماذا نبتغي فيها بِناءً","وماذا نبتغي منها اكتسابا",106,"ب",2,0]]}