=35427",""],[5805,"متى تصحو بوجداني القصيدة ؟؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=24723",""],[5829,"انت والسحاب وما تعداني","https://www.poetsgate.com/ViewPoem.aspx?id=189840",""],[5842,"تَقَبَّلْ دُعائي / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=137917",""],[5858,"حياة الصغار","https://www.poetsgate.com/ViewPoem.aspx?id=188184",""],[5873,"لوحة المعاني","https://www.poetsgate.com/ViewPoem.aspx?id=215792",""],[5910,"بِمكةَ نورٌ قد سَرَى وضياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=206977",""],[5943,"فماذا بعدُ ياقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=11268",""],[5956,"ومن لم يعف عن ذنب قديم","https://www.poetsgate.com/ViewPoem.aspx?id=192212",""],[5957,"أمد القلب","https://www.poetsgate.com/ViewPoem.aspx?id=204477",""],[5958,"إِلَى كم أمنى النَّفس مَا لَا تناله","https://www.poetsgate.com/ViewPoem.aspx?id=189019",""],[5970,"أتينا للحياة ولا ذنوباً","https://www.poetsgate.com/ViewPoem.aspx?id=130599",""],[5997,"بحرٌ وأطْلس","https://www.poetsgate.com/ViewPoem.aspx?id=214227",""],[5997,"سَرْجٌ وَأكْحَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=214284",""],[6031,"خَلِيلَيَّ مِنْ علْيَا لُؤيِّ بنِ غَالِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=46401",""],[6089,"هاطلات العين","https://www.poetsgate.com/ViewPoem.aspx?id=213027",""],[6117,"أَبَى الْعِيْدُ إلاَّ ..","https://www.poetsgate.com/ViewPoem.aspx?id=182793",""],[6324,"نجوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87950&r=&rc=15",""]],"verses":[["فَما ذا الوَرى مِمَّن يُرادُ بَقاؤُهُ","وَلا المَوتُ مَعذولٌ إِذا جارَ حُكمُهُ",0,"م",2,0],["فَما ذاكَ إِلّا أَن يُوَفِّرَ طَعمَها","عَلَيكَ إِذا جَلّى إِلَيها وَحَقَّقا",1,"ق",2,0],["فَما ذاكَ إِن لَم يَلقَ حَتفاً بِخالِدٍ","وَلا ذا مِنَ الحَتفِ المُطِلِّ عَلى بُعدِ",2,"د",1,0],["فَماذا يُشيدُ هُتافُ النَعيِّ","فيكَ وَما يَندُبُ النادِبُ",3,"ب",1,0],["فَما ذاقَ طَعمُ المَوتِ في كَأسِ لَذَّةٍ","وَلا سَهِرَت عَينُ اِمرِئٍ لَيسَ يَعشَقُ",4,"ق",1,0],["فَماذا يُرَجَّى مِنكُمُ إِن عَزَلتُمُ","وَعَضَّتكُمُ الدُنيا بِأَنيابِها عَضّا",5,"ض",2,0],["فما ذُقْتُ أشْهى منْ مُشاهَدَةِ النّوَى","وأعظَمُ منْ بيْنِ الحَبيبِ المُوَدِّعِ",6,"ع",1,0],["فَمَاذَا عَسَى أَنْ يُنْظِرَ الدَّهْرُ مَا عَسَى","فَمَا انْقَادَ لِلزّجْرِ الْحَثِيثِ وَلاَ لاَنَا",7,"ن",2,0],["فَمَاذَا عَسَى أُحْصِي وَمَاذَا عَسَى أَفِي","أَيُنْضِبُ لُجَّ الْيَمِ مُسْتَنْزَرُ الشُّرْبِ",8,"ب",1,0],["فَماذا أَتَيتُ مِنَ الباقِياتِ","وَهَذا شَبابي ضَياعاً ذَهَب",9,"ب",1,0],["فَمَاذَا أَنْزَلَتْ فِيهَا","مِنَ البُؤْسِ أَعَادِيهَا",10,"ي",3,0],["فماذا اليومَ ضَرَّ لو التفتنا","إلى أسلافنا بعضَ الْتِفات",11,"ت",1,0],["فَماذا تَنظُرونَ بِها وَفيكُم","جُسورٌ بِالعَظائِمِ وَاِعتِلاءُ",12,"ا",2,0],["فَماذا أَرَدتَ إِلى رِمَّةٍ","بَدَوِّيَّةٍ صَخِبٍ هامُها",13,"م",3,0],["فما ذكري حبيب لها بباك","ولا عبث الوليد أبا عباده",14,"د",2,0],["فما ذنبُ طفلٍ كان تسبيبَ كونِه","رجاؤك يا مرجُوّ كلِّ فقير",15,"ر",1,0],["فما ذنبه في ذاك إن كان ربّه","قضى أنه أعلى وذو الرغم أسفلُ",16,"ل",1,0],["فما ذرَّ قرنُ الشمسِ حتى رأيتها","تعصفرها مثعنجرات تَهزَّمُ",17,"م",1,0],["فما ذَرفتْ عيني على رسمِ منزلٍ","ولا عكفَتْ نفسي هناك على صنمْ",18,"م",1,0],["فماذا وقوفي فيه اندب ارسما","تقاسي من الدهر العتي الاعاصيرا",19,"ر",2,0],["فماذا يعلم الأحياء عنا","إذا ما قيل عاد لها عرابي",20,"ب",2,0],["فماذا تريد بهذا السكون","وماذا تريد بهذا الوجوم",21,"م",1,0],["فَماذا في طَريقِكَ مِن كُفورٍ","أَجَلُّ مِنَ البُيوتِ بِها الرِجامُ",22,"م",1,0],["فَماذا تَرَكتَ لِمَن لَم يَسُد","وَماذا تَرَكتَ لِمَن كانَ سادا",23,"د",2,0],["فَماذا يَغُرُّ الحائِنينَ وَقَد رَأَوا","ضَرائِبَ ذاكَ المَشرَفِيِّ المُجَرَّبِ",24,"ب",1,0],["فَماذا اِشتَهَيتَ مِنَ الخُتَّلِيِّ","وَهَل لَكَ في الثَورِ مُستَمتَعُ",25,"ع",1,0],["فما ذِمَّةُ الأيامِ فيها ذميمةٌ","ولا جانبُ الدنيا بها متجنَّبا",26,"ب",2,0],["فَماذا حَوَت أَكفانُهُ مِن شَمائِلٍ","مَناهِلَ أَعدادٍ عِذابَ المَوارِدِ",27,"د",1,0],["فَماذا حَضَرتَ بِهِ حاضِراً","وَماذا خَبَأتَ لِأَهلِ الخِباءِ",28,"ا",2,0],["فَما ذِكرُهُ شَنباءَ وَالدارُ غَربَةٌ","عَنوجٌ وَإِن يُجمَع بِضُرٍّ وَيُنحَلِ",29,"ل",1,0],["فماذا به تُكنَى فقال لهم أنا","أبو القاسمِ ادْعونِي بها كُنْيَةٌ تَسُرْ",30,"ر",1,0],["فماذا من أيادِي اللهِ تَلْقَى","لقد جَلَّتْ فليس لها انصرامُ",31,"م",1,0],["فماذا في يَمينكَ يا خُبَيْبٌ","وما بالُ الصَّغيرِ من العيالِ",32,"ل",1,0],["فَما ذِقتُ مِن نَومٍ وَما زالَ عامِلاً","إِلى الصُبحِ ذاكَ البارِقُ المُتَأَلِّقُ",33,"ق",1,0],["فَما ذَرَّ قَرنُ الشَمسِ حَتّى كَأَننا","مِنَ العِيِّ نَحكي أَحمدَ بنَ هِشامِ",34,"م",1,0],["فَماذا أَقولُ وَبَينَ الأَنا","مِ خُلفٌ عَلى جَهلِهِم أَو تَمالي",35,"ل",2,0],["فَما ذَنبُنا في أَن أَداءَت خُصاكُمُ","وَأَن كُنتُمُ في قَومِكُم مَعشَراً أُدرا",36,"ر",2,0],["فَما ذاقَ طعم النوم للصبح عينها","ومن كانَ ينأى إلفه كيف يهجع",37,"ع",1,0],["فَماذا الَّذي جرّ بينهما","منازعة نارها تضرم",38,"م",1,0],["فَما ذُكِرَ الخلّانُ إِلّا ذَكَرتُها","وَلا البُخلُ إِلّا قُلتُ سَوفَ تَجودُ",39,"د",1,0],["فَمَا ذَاقَهَا حَتَّى تَهَلَّلَ ضَاحِكَاً","وَأَقْبَلَ مَسْرُورَاً بِمَا هُوَ آنِسُ",40,"س",1,0],["فَمَاذَا عَسَى الأَعْدَاءُ أَنْ يَتَقَوَّلُوا","عَليَّ وعِرْضِي نَاصِحُ الْجَيْبِ وَافِرُ",41,"ر",1,0],["فَمَاذا اقْتضته حَاله مِن تجَددٍ","وَقدْ يَقْتَضِي عَزْمُ الأُمورِ التَّجَدُّادَ",42,"د",1,0],["فماذا يقومُ لأفواهِهم","تباركَت يا أحسن الخالقينا",43,"ن",2,0],["فماذا ستفعل يا قلب ؟ تجثو","على قدميها .. تذوب ابتهالا ؟",44,"ل",2,0],["فما ذعرت ببدر غير مبتدر","ولا أمرت بأمر غير ممتثل",45,"ل",1,0],["فما ذقت أدهى من مشاهدة النوى","وأعظم من بين الحبيب المودع",46,"ع",1,0],["فماذا يرى اليوم ؟ جيلا يمور","ويهتف \" لا عاش حكم العدا \"",47,"د",2,0],["فماذا رأت دولة المخجلات ؟","قوى أنذرت عهدها الأنكدا",47,"د",2,0],["فماذا يلاقي وماذا يحسّ","وقد دفن الحبّ في البلقع",48,"ع",1,0],["فماذا يعاني ؟ ألا إنّه","جريح الإبا صامت لا يعي",48,"ع",2,0],["فماذا هنا من صنوف السقوط ؟","أحطّ الصنوف وأخرى الصنوف",49,"ف",1,0],["فَماذا يَغُرُّ الخَائِنِينَ، وَقَدْ رَأوا","ضَرَائِبَ ذاكَ المَشرَفيّ المُجَرَّبِ",50,"ب",1,0],["فما ذاق طعمَ الرىِّ من لم تُسَقِّه","أناملُه من صوبها المتواترِ",51,"ر",1,0],["فما ذلك الحسنُ مستقبَحا","بشَعرٍ ولو لاح فيه المشيبُ",52,"ب",1,0],["فَما ذَمُّهُ إِذ نالَ بَعضَ تِراتِهِ","وَما حَمدُهُ إِذ لَم يَجِد عَنكَ مَعدِلا",53,"ل",2,0],["فما ذاك مكروهٌ ولا بمحرّم","بشرع الهوى بل ذاك فرضٌ على الصب",54,"ب",1,0],["فما ذاك إلاَّ أن بشرك لم يحل","قطوباً وذاك الجود لم يستحل بخلا",55,"ل",2,0],["فَماذا عَسى يَجري إِلَيهِ المُمَوِّهُ","أَفي الحَقِّ شَكٌّ يَستَقِلُّ بِنَكثِهِ أَفي",56,"ي",1,0],["فَماذا عَسى يَحكي امروءٌ مِن سَنائِهِ","هُبوبُ رياحِ النَصرِ تَحتَ لِوائِهِ",56,"ه",1,0],["فما ذاق طعم الوصل من لم يذق نوى","ولا ارتاح بالتنفيس من لم يذق كربا",57,"ب",2,0],["فَماذَا الّذِى يَشفَى مِن الحُبِّ بَعدَما","تَشَرَّبَهُ بَطنُ الفُؤَادِ وَظاهِرُه",58,"ر",2,0],["فماذا غنمتم من رياء نعيمهُ","جحيمٌ وكتم الداء أنكى وأقتل",59,"ل",1,0],["فماذا دها الدنيا وماذا أصابها","أسفّت فأمست وهي في خمسة القرد",60,"د",1,0],["فما ذنب عبد أطاعك في حب","ه وعصى عاذليه عداك",61,"ك",1,0],["فَمَاذَا عَلى وُدِّهِمْ لَوْ دَنَا","وَمَا ضَرَّ لَوْ نَعَشُونِي يَسِيرَا",62,"ر",2,0],["فما ذاهب أملته غير راجع","ولا غائب أرجوه إلا كايب",63,"ب",1,0],["فماذا تَرتَجونَ إذا مدحتُم","أُناساً عندهم قطعُ الرجاء",64,"ا",2,0],["فَما ذَنبُ صاب ما لَها قَطُّ عَنكُمُ","وَمَا عيب صبَّ فِي هَواكُم لَما يَسلو",65,"ل",2,0],["فَما ذاكَ بِدعاً في دِمَشقَ لِأَنَّها","تَمَلَّكَها في سالِفِ الدَّهرِ زَبّالُ",66,"ل",1,0],["فماذا عساني أَنْ أقول بوصفِها","وما سامعٌ منِّي كمن كان رائيا",67,"ي",2,0],["فما ذات طوقٍ بان عنها أَليفُها","وما مطفلٌ قد ضلَّ منها رضيعها",68,"ع",3,0],["فماذا عسى تبقى عَلى الوجد والأسى","وَشحط النوى نفس عليك تصوب",69,"ب",1,0],["فما ذاك إلاّ نفثةٌ قذفتْ بها","لواعجُ همٍ في فؤادٍ مكلم",70,"م",1,0],["فماذا جنت كفّاي منهم سوى الذي","يطير له قلبي شعاعاً وينفنى",71,"ن",2,0],["فما ذرّة في الكون إلّا وعندها","مكان ركوع أو مكان سجود",72,"د",1,0],["فماذا دعى عينيك فاظلم نورها","وأطبقتها خوفا وأنركتها ذعرا",73,"ر",2,0],["فماذا يكون اتبدو الحياة","بقلب نقي وانف اشم",74,"م",1,0],["فَماذا عَسى أَنّي أَرى ما يَسُرُّني","مِن الدَهر إِلّا زادَ بي برح غَمِّهِ",75,"م",2,0],["فماذا وقد أَعدْتَ رسولي","بانكسارٍ يَمْشي على استِحياء",76,"ا",2,0],["فما ذَرَّ قَرنُ الشمسِ حتى تَوَثَّقَت","سُلَيمُ بن منصور