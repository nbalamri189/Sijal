{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[261,"قلت ثقلت إذ أتيت مرارا","https://www.aldiwan.net/poem48325.html","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58353","الخفيف"],[3764,"","https://poetry.dctabudhabi.ae/diwan/poem/124059","الوافر"],[5121,"دولة الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=33514",""]],"verses":[["قلتُ طِفلٌ من قديم الأبد","يمزُجُ الألحانَ مِن خمر وحُبِّ",0,"ب",1,0],["قلتُ طَوَّلْت قال لا بل تَطَوَّ","لت وأَبرمتُ قالَ حَبْلَ ودادِي",1,"ي",1,0],["قُلتُ طبّاخُ ذي الهّريسةِ في العر","سِ وَهذي قِدري وذا دَكسابي",2,"ب",2,0],["قلَت طبعي وفي سوداء قلبي","لها ما راق منظرها انطباع",3,"ع",1,0],["قلتُ طوبى حولَ يومي إذ أنادي","حسبيَ الله ونعمًا بالوكيل ِ",4,"ل",1,0]]}