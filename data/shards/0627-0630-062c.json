{"poems":[[75,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[95,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[90,"نجيت بالسد بغدادا من الغرق","https://www.aldiwan.net/poem44443.html","البسيط"],[87,"بيتكمو أبا لهب","https://www.aldiwan.net/poem7133.html","مجزوء الرجز"],[30,"ألم تريا أن الجواد ابن معمر","https://www.aldiwan.net/poem5572.html","الطويل"],[63,"يا حبذا تحية","https://www.aldiwan.net/poem51611.html","مجزوء الرجز"],[107,"إرفع كتابك يا سرا","https://www.aldiwan.net/poem44031.html","مجزوء الكامل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20988","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55057","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10242","الكامل"],[30,"ألم تريا أن الجواد ابن معمر","https://www.poetsgate.com/ViewPoem.aspx?id=20978",""],[244,"أسرى به في ليلة المعراج","https://www.aldiwan.net/poem23836.html","الكامل"],[290,"سعد الأمين وأزهرت أفراحه","https://www.aldiwan.net/poem39418.html","الكامل"],[376,"آذن صرف الدهر بالبين","https://www.aldiwan.net/poem57067.html","البسيط"],[409,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[422,"شفها السير والأسى والغرام","https://www.aldiwan.net/poem53960.html","الطويل"],[435,"لحاظك يا أخا البدر","https://www.aldiwan.net/poem40770.html","مجزوء الوافر"],[443,"أمن أميمة مصطاف ومرتبع","https://www.aldiwan.net/poem2573.html","البسيط"],[484,"عجائب الدهر شتى","https://www.aldiwan.net/poem36936.html","المجتث"],[484,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[495,"إما ترى رأسي أزرى به","https://www.aldiwan.net/poem658.html",""],[543,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66719","السريع"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66830","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66702","الكامل"],[438,"","https://poetry.dctabudhabi.ae/diwan/poem/58919","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72282","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25350","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126128","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56241","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112854","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18462","الرجز"],[1353,"","https://poetry.dctabudhabi.ae/diwan/poem/124300","الرجز"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104466","الرجز"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52076","المجتث"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76675","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118380","الرجز"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124056","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88665","الرمل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132367","الخفيف"],[2721,"","https://poetry.dctabudhabi.ae/diwan/poem/20678","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93813","البسيط"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201696",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202751","المنسرح"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74216","الرجز"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101607","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65131","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65369","البسيط"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110749","السريع"],[3242,"","https://poetry.dctabudhabi.ae/diwan/poem/124098","البسيط"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89295","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62818","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48395","الرجز"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66412","السريع"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66454","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66362","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91049","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36728","البسيط"],[3788,"","https://poetry.dctabudhabi.ae/diwan/poem/203871",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59513","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69906","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70125","البسيط"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94521","الكامل"],[286,"","https://poetry.dctabudhabi.ae/diwan/poem/47068","الكامل"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117207","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72431","الرجز"],[2177,"عش ما تشاء فغاية الأحياء","https://www.poetsgate.com/ViewPoem.aspx?id=127081",""],[5038,"بوم اللئام","https://www.poetsgate.com/ViewPoem.aspx?id=189927",""],[5038,"الموصل الحدباء","https://www.poetsgate.com/ViewPoem.aspx?id=190135",""],[5281,"ليلة المعراج","https://www.poetsgate.com/ViewPoem.aspx?id=199707",""],[5302,"ما خانك الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=200065",""],[307,"متى نعود أيا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=213657",""],[5409,"منعاك عز على العراق الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=155480",""],[5431,"ميحانةٌ...ميحانه...أغنية","https://www.poetsgate.com/ViewPoem.aspx?id=200018",""],[5431,"في ترامب...","https://www.poetsgate.com/ViewPoem.aspx?id=203730",""],[5691,"الكوكب الأحمر... الوطن القادم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206733",""],[5725,"سرّ منْ رأى","https://www.poetsgate.com/ViewPoem.aspx?id=177530",""],[5897,"زارنا الغيث","https://www.poetsgate.com/ViewPoem.aspx?id=160573",""],[5956,"أ رأيتَ ما يَسُرُّك ؟","https://www.poetsgate.com/ViewPoem.aspx?id=184924",""]],"verses":[["إِذ جانِبُ العَيشِ طَلقٌ مِن تَأَلُّفِنا","وَمَربَعُ اللَهوِ صافٍ مِن تَصافينا",0,"ن",2,0],["إِذَ جَاوَزُوا مِصْراً وَ مِصْرٌ أَسِيفَةٌ","تُقَامُ بِهَا حُزْناً عَلَيْكَ المَآتِمُ",1,"م",1,0],["إذ جئت والسدّ تحت الغمر مكتسحٌ","والنهر يرغو بموج فيه مصطفق",2,"ق",1,0],["إذ جئتهم في جبة","تزرى بأنفس الجبب",3,"ب",1,0],["إِذ جائَهُ السُؤآلُ فادَت عَلَيهِمُ","سِجالُ يَدَيهِ فَاِستَقَلَّ عَديمُها",4,"م",3,0],["إذ جاءَني يَحمِلُها","ظبْيٌ يُباهي الحُورا",5,"ر",2,0],["إذ جئتَ تطلبُ قتلَه","وتُطيعُ فيه هوى الغُواةِ",6,"ه",1,0],["إذ جَاوزوا في الظُّلْمِ والطُّغيانِ","بقَتْلهم لعامِلِ السُّلطانِ",7,"ن",1,0],["إذ جعَلَ القولَ القديمَ أَصلَهُ","ثم أَجازَ ذا وليسَ مثلَهُ",8,"ه",1,0],["إذ جَعَلناهُم تَباذِيرَ كَمَا","فَرَّقَ القابِسُ في اللَّيلِ الشَّرَر",9,"ر",1,0],["إذ جَعَلناهُم بِضيقِ مَأزِقٍ","ثُمَّ نِلنا السَّعيَ مِنهُم والظَّفَر",9,"ر",1,0],["إِذْ جَاءَ رُزْفَلْتُ الْكِنَانَةَ زَائِراً","وَرَمَى لِشُكْرٍ صَدْرَهَا بِنِبَالِ",10,"ل",1,0],["إِذْ جَوْهَرُ الصَّدْقِ فِي كَسَادٍ","وَسِلْعَةُ الإِفْكِ فِي نَفَاقِ",11,"ق",1,0],["إِذْ جَاءَهُ فِي أَوْجِ عُزَّ","تِه مِنَ الغَيْبِ النَّذيرْ",12,"ر",1,0],["إِذ جاءَهُ المِسكينُ حالَ صَلاتِهِ","فَاِمتَدَّ طَوعاً بِالذِراعِ وَبِاليَدِ",13,"د",1,0],["إذْ جاءَهُ السُّؤّالُ فاضَتْ عَلَيْهِمُ","سِجَالُ يَدَيْهِ فَاسْتَقَلّ عَدِيمُهَا",14,"م",3,0],["إذ جنة المأوى وفيها ما اشتهت","نفس وما يهواه كل مزاج",15,"ج",1,0],["إذ جاملوهم في المسرة وامتطوا","خيلا عتاقا من قضاء ثاني",16,"ن",2,0],["إذ جَلسَ الأستاذُ في مَجلسٍ","للمَجدِ ما بَينَ الأميرَينِ",17,"ن",1,0],["إذ جاءني مكتوب من بصفاته","قد كان حبل مودتي موصولا",18,"ل",2,0],["إذ جَلَونا من الحميّا عروساً","بنت كرم لها الزجاج لثام",19,"م",1,0],["إذ جادت أياديهِ","فحدّث عن ندى القطرِ",20,"ر",1,0],["إذ جدّك المصطفى والأم فاطمة","وصيد الدمن ذا الورى نصعوا",21,"ع",3,0],["إذ جلده في حنوط","وعقله في ذهاب",22,"ب",1,0],["إذ جاء في تاريخها","طه الأمين مشفّع",23,"ع",1,0],["إِذ جَمَّعَت عَدوانُ فيها عَلى","عِداتِها مِن سائِسٍ أَو مَسوس",24,"س",1,0],["إذ جِوارُ الباشا التهامي مُنَائي","وجِوارُ الباشا أعَزُّ جِوار",25,"ر",1,0],["إذ جَلل السيفَ على رأسِهِ","أبيضَ عَضباً حدُّه مُبْتِرُ",26,"ر",1,0],["إذ جاء عتبةُ الوليدُ وعمُّه","يَمشون في حَلَقٍ من الأَبدانِ",27,"ن",1,0],["إذ جاءَ جبريلٌ فنادى معلناً","في المسلمين وأسمعَ الأبرارا",28,"ر",2,0],["إذ جوّها يَنْدى وروضُ عِراصِها","يزهو وظلُّ الطيباتِ طليلُ",29,"ل",1,0],["إذ جائهم سائل يتيم","وجاء من بعده أسير",30,"ر",1,0],["إِذْ جَدَّ بِالقَوْمِ نِضالُ النَضْلِ","وَلِي إِذَا نَاضَلْتُ سَهْمُ الخَصْلِ",31,"ل",1,0],["إذ جاءهم رحمة ربهم بهم","حتى يزيل ما بهم من كربهم",32,"م",1,0],["إذ جنس ذا الحيوان جنسٌ مشتهَرْ","في شمّه الموصوف في أخذ الأثرْ",33,"ر",1,0],["إذ جاءت البشرى من المختار أن","المرء مع من قد أحب لدى غد",34,"د",1,0],["إِذ جاءَت الدولة وَالسَّعاده","تَمت لَكَ الحيلة وَالإرادَه",35,"ه",1,0],["إِذ جاوَبوا ذا وَتَرٍ مُشَكَّلِ","يَضرِبُهُ الضارِبُ لِلتَعَلُّلِ",36,"ل",1,0],["إذ جاء يقفو حنقا","كليم رب الفَلق",37,"ق",1,0],["إذ جاءني أخو النجار العالي","محمد الحسن الخصال",38,"ل",1,0],["إذْ جِئْتَ فِيهِ بِصُنعٍ","عَذبِ المَقَالِ نَبِيلِ",39,"ل",1,0],["إذ جناحي ند بظلك طلق","ولساني رطب على التغريد",40,"د",1,0],["اذ جاء يقفو حنقا","كلم رب الفلق",41,"ق",1,0],["إذ جادها الوسميّ جودا مبكرا","فجلا وجوه النجد والقيعان",42,"ن",1,0],["اذ جلا الراح لنا ظبي رخيم","ناعس الجفنين احوى احور",43,"ر",1,0],["إذ جعل القرآن مخلوقاً كما","قال أخوهُ قبلهُ وأثما",44,"م",2,0],["إذ جعلنا أمارةً فاذكريها","بعد وقت النزول حين المقيلِ",45,"ل",1,0],["إِذ جَزَينا قُشَيرَهُم وِهِلالاً","وَأَبرنا قَبيلَةَ اِبنِ الحُبابِ",46,"ب",1,0],["إذ جاءهم يتغشى بطن أودية","على ظهور جياد الخيل والنجب",47,"ب",1,0],["إِذ جاءَ فَوجُ زمرِ الأَكرادِ","بِالمال وَالعِيال وَالأَولادِ",48,"د",1,0],["إِذ جاءَنا مَولى مِن المَوالي","بلا إِفادَة وَلا مَآلي",48,"ي",1,0],["إِذ جاءَنا مُبشِّر السّراءِ","مُخبراً بحامي الشّبهاءِ",48,"ا",2,0],["إِذ جاءَت الرّسل بِهذا القال","وَأَخذ كركوك وَسوء الحالِ",48,"ل",1,0],["اذ جئت عالمكم أُخبّر","ما رأيت بعالمي",49,"م",2,0],["إذ جمعوا الحرب والفنون معاً","لا كمغولٍ قد أحرقوا الكتبا",50,"ب",2,0],["إِذ جَمَعوا جُيوشَهُم وَحارَبوا","وَاِنتَشَرَت بُغاتهم وَضارَبوا",51,"ب",3,0],["إذ جلسنا على بساطٍ من السح","بِ يفوح الغرام من جنباته",52,"ت",2,0],["إذ جاء في التاريخ ولا","يبغون عنها حولا",53,"ل",2,0],["إذ جيفةُ البحر ريحها من","قطاطة مالها ذها ب",54,"ب",1,0],["إذ جاءني أبليسها عارضا","عليّ أنواعاً بها يخلبُ",55,"ب",1,0],["إذ جاء بالخيل مختالا ليوردها","ماء القليب فعاف الخيل والخُيلا",56,"ل",2,0],["اذ جعلوه الانجم اللواتي","يعرفهن أكثر الرواة",57,"ه",1,0],["إذ جئت فيها بالعجائب كلها","ملحونة الألفاظ فاحشة العلل",58,"ل",1,0],["إذْ جاوروكَ فكنتَ أك","رَمَ مَنْ يُجاورُهُ مجاورْ",59,"ر",1,0],["إذْ جاءَ يحْيَى عبْدُهُ","بمُعْجِبٍ بلْ مُعْجِزِ",60,"ز",1,0],["إذ جاء يختال برهط له","ما بين مزهوّ وملعون",61,"ن",1,0],["إذ جلا حمراء كالشَّفَقِ","خمرة في كأسها اليفق",62,"ق",1,0],["إذ جاءه للنصر جند من ال","رحمن لم يدركه طرف حديد",63,"د",1,0],["إِذ جانبُ القُربِ بِالإِيناس يُطربنا","لَم نَدر آدم إِذ يستجلي حَواء",64,"ا",2,0],["إِذ جانبُ العَيشِ طَلقٌ رائِقٌ بِهجٌ","وَالدَهرُ قَد غَضَّ عَنّا الجفن مُنطَبِقا",65,"ق",2,0],["إذ جمع شملك للشتا","ت وربح مالك للخساره",66,"ه",1,0],["إذْ جاءَ مُنتضياً حُساماً كاسمه","عضباً مُلامسُ حدِه لم يأمَنِ",67,"ن",1,0],["إِذ جادَ بِالعَفوِ عَن باغي مذلتِهِ","اضحى مِثالاً بِهِ السادات تَفتخرُ",68,"ر",1,0],["إِذ جاءَ كانُون في تاريخِهِ بَهجاً","قَد راقَ نَظمي لجرجي أَسود العَينِ",69,"ن",1,0],["إذ جَاء لاَ طَاعَةَ للِمَخلُوقِ فِى","ذَاك وفِيمَا عَنهُ لاَ يَخلُو قِفِ",70,"ف",1,0],["إذ جَاءَ فِى القُرانِ مَا يَقضى لَهُم","بِالسَّبقِ فِى آىٍ حَوَت تَفضِيلَهُم",70,"م",1,0],["إذ جفَني كل السقام فاجمعوا","إنّي أنا بين الورى لسقيمُ",71,"م",1,0],["إذ جاد منه بمن بأع","باء المكارمِ يستقل",72,"ل",1