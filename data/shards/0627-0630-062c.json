{"poems":[[73,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[93,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[88,"نجيت بالسد بغدادا من الغرق","https://www.aldiwan.net/poem44443.html","البسيط"],[85,"بيتكمو أبا لهب","https://www.aldiwan.net/poem7133.html","مجزوء الرجز"],[28,"ألم تريا أن الجواد ابن معمر","https://www.aldiwan.net/poem5572.html","الطويل"],[61,"يا حبذا تحية","https://www.aldiwan.net/poem51611.html","مجزوء الرجز"],[105,"إرفع كتابك يا سرا","https://www.aldiwan.net/poem44031.html","مجزوء الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20988","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55057","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10242","الكامل"],[28,"ألم تريا أن الجواد ابن معمر","https://www.poetsgate.com/ViewPoem.aspx?id=20978",""],[237,"أسرى به في ليلة المعراج","https://www.aldiwan.net/poem23836.html","الكامل"],[283,"سعد الأمين وأزهرت أفراحه","https://www.aldiwan.net/poem39418.html","الكامل"],[369,"آذن صرف الدهر بالبين","https://www.aldiwan.net/poem57067.html","البسيط"],[400,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[413,"شفها السير والأسى والغرام","https://www.aldiwan.net/poem53960.html","الطويل"],[426,"لحاظك يا أخا البدر","https://www.aldiwan.net/poem40770.html","مجزوء الوافر"],[434,"أمن أميمة مصطاف ومرتبع","https://www.aldiwan.net/poem2573.html","البسيط"],[477,"عجائب الدهر شتى","https://www.aldiwan.net/poem36936.html","المجتث"],[477,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[488,"إما ترى رأسي أزرى به","https://www.aldiwan.net/poem658.html",""],[536,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"]],"verses":[["إِذ جانِبُ العَيشِ طَلقٌ مِن تَأَلُّفِنا","وَمَربَعُ اللَهوِ صافٍ مِن تَصافينا",0,"ن",2,0],["إِذَ جَاوَزُوا مِصْراً وَ مِصْرٌ أَسِيفَةٌ","تُقَامُ بِهَا حُزْناً عَلَيْكَ المَآتِمُ",1,"م",1,0],["إذ جئت والسدّ تحت الغمر مكتسحٌ","والنهر يرغو بموج فيه مصطفق",2,"ق",1,0],["إذ جئتهم في جبة","تزرى بأنفس الجبب",3,"ب",1,0],["إِذ جائَهُ السُؤآلُ فادَت عَلَيهِمُ","سِجالُ يَدَيهِ فَاِستَقَلَّ عَديمُها",4,"م",3,0],["إذ جاءَني يَحمِلُها","ظبْيٌ يُباهي الحُورا",5,"ر",2,0],["إذ جئتَ تطلبُ قتلَه","وتُطيعُ فيه هوى الغُواةِ",6,"ه",1,0],["إذ جَاوزوا في الظُّلْمِ والطُّغيانِ","بقَتْلهم لعامِلِ السُّلطانِ",7,"ن",1,0],["إذ جعَلَ القولَ القديمَ أَصلَهُ","ثم أَجازَ ذا وليسَ مثلَهُ",8,"ه",1,0],["إذ جَعَلناهُم تَباذِيرَ كَمَا","فَرَّقَ القابِسُ في اللَّيلِ الشَّرَر",9,"ر",1,0],["إذ جَعَلناهُم بِضيقِ مَأزِقٍ","ثُمَّ نِلنا السَّعيَ مِنهُم والظَّفَر",9,"ر",1,0],["إِذْ جَاءَ رُزْفَلْتُ الْكِنَانَةَ زَائِراً","وَرَمَى لِشُكْرٍ صَدْرَهَا بِنِبَالِ",10,"ل",1,0],["إِذْ جَوْهَرُ الصَّدْقِ فِي كَسَادٍ","وَسِلْعَةُ الإِفْكِ فِي نَفَاقِ",11,"ق",1,0],["إِذْ جَاءَهُ فِي أَوْجِ عُزَّ","تِه مِنَ الغَيْبِ النَّذيرْ",12,"ر",1,0],["إِذ جاءَهُ المِسكينُ حالَ صَلاتِهِ","فَاِمتَدَّ طَوعاً بِالذِراعِ وَبِاليَدِ",13,"د",1,0],["إذْ جاءَهُ السُّؤّالُ فاضَتْ عَلَيْهِمُ","سِجَالُ يَدَيْهِ فَاسْتَقَلّ عَدِيمُهَا",14,"م",3,0],["إذ جنة المأوى وفيها ما اشتهت","نفس وما يهواه كل مزاج",15,"ج",1,0],["إذ جاملوهم في المسرة وامتطوا","خيلا عتاقا من قضاء ثاني",16,"ن",2,0],["إذ جَلسَ الأستاذُ في مَجلسٍ","للمَجدِ ما بَينَ الأميرَينِ",17,"ن",1,0],["إذ جاءني مكتوب من بصفاته","قد كان حبل مودتي موصولا",18,"ل",2,0],["إذ جَلَونا من الحميّا عروساً","بنت كرم لها الزجاج لثام",19,"م",1,0],["إذ جادت أياديهِ","فحدّث عن ندى القطرِ",20,"ر",1,0],["إذ جدّك المصطفى والأم فاطمة","وصيد الدمن ذا الورى نصعوا",21,"ع",3,0],["إذ جلده في حنوط","وعقله في ذهاب",22,"ب",1,0],["إذ جاء في تاريخها","طه الأمين مشفّع",23,"ع",1,0],["إِذ جَمَّعَت عَدوانُ فيها عَلى","عِداتِها مِن سائِسٍ أَو مَسوس",24,"س",1,0],["إذ جِوارُ الباشا التهامي مُنَائي","وجِوارُ الباشا أعَزُّ جِوار",25,"ر",1,0]]}