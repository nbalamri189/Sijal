{"poems":[[93,"عادت رياض القوافي وهي حالية","https://www.aldiwan.net/poem8742.html","عموديه"],[91,"افتحوا للفتى الهضيم الطريقا","https://www.aldiwan.net/poem44844.html","الخفيف"],[111,"بصائرنا في القضا خامدة","https://www.poetsgate.com/ViewPoem.aspx?id=522",""],[93,"شاعر الدير","https://www.poetsgate.com/ViewPoem.aspx?id=14221",""],[53,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[154,"لا تضق ذرعا بخطب نازل","https://www.aldiwan.net/poem68508.html","الرمل"],[406,"شموخ الصابري","https://www.aldiwan.net/poem6716.html","عموديه"],[556,"صدت وما صدها إلا على ياس","https://www.aldiwan.net/poem47749.html","البسيط"],[556,"ودهم كسون الليل سود ثيابه","https://www.aldiwan.net/poem47820.html","الطويل"],[556,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17589","السريع"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26435","الطويل"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142895","الطويل"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138748",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62935","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28681","البسيط"],[4463,"","https://poetry.dctabudhabi.ae/diwan/poem/144938","البسيط"],[5409,"نحن في كل غدوةٍ ورواح","https://www.poetsgate.com/ViewPoem.aspx?id=155258",""],[5444,"إيمان","https://www.poetsgate.com/ViewPoem.aspx?id=205072",""],[5956,"اسمُ والدكم أحمد صفَّى النفوس","https://www.poetsgate.com/ViewPoem.aspx?id=194656",""],[5956,"يا ليتك تعطي بلدي كنزا","https://www.poetsgate.com/ViewPoem.aspx?id=208053",""],[4442,"أناخ على ذكا فخبت ضياء","https://www.poetsgate.com/ViewPoem.aspx?id=171228",""]],"verses":[["يَحُزُّ نَفسِيَ أَنّي اليَومَ مُبتَعِدٌ","وَأَنتَ مِن حَولِكَ الأَنصارُ وَالصُحُبُ",0,"ب",1,0],["يحزن العندليب ان يجد الجو","جميلا ولا يكون طليقا",1,"ق",2,0],["يحز الحياة شبا قارظ","ولم تنتبه هذه الراقده",2,"د",2,0],["يحزّ في نفسي أني اليوم مبتعد","وأنت من حولك الأنصار والصّحب",3,"ب",1,0],["يحزُق أنياباً لهُ حدائدا","وشحن بأطراف الغنى المراصدا",4,"د",2,0],["يحزن العاقل لكن عقده","أنه لا بدَّ من جَريِ القضا",5,"ض",2,0],["يحزن القلب ولكنَّا على","حُزنه نَبني شموخ الصابرين",6,"ن",1,0],["يَحُزُّ في الجلد منّا ثمّ نَحملُهُ","بُقياً عليكمْ على العينين والرّاسِ",7,"س",1,0],["يُحزنَ لأضياف الشّتاء فكلُّ مَن","أراد القِرى منهنّ فهْوَ قديرُ",8,"ر",1,0],["يَحُزّ فلا يدرِي لمن هو جارحٌ","ويقدح لا يدرِي بما هو قادحُ",9,"ح",1,0],["يَحزنُني عِلمي بِنَفسِي إِذا","قالَ خَليلي أَنتَ مَهجورُ",10,"ر",1,0],["يَحزُنُني أَن لا أَرى مَن أُحِبُّهُ","وَأَنَّ مَعي مَن لا أُحِبُّ مُقيمُ",11,"م",1,1],["يحز بنفسي أن أبيع مودتي","وأعرض غالي القلب بالثمن البخس",12,"س",1,0],["يحز بقلبي وهو يلعب لاهيا","ألا بأبي من صاحب اللعب واللهوا",13,"و",2,0],["يَحُزُّ فلا يُخطى المفاصلَ حَزَّهُ","ويَفتلُ أَفواهَ العروقِ المباضعَا",14,"ع",2,0],["يُحزِنُني أَن أَراكَ تَعطو","إِلَيَّ مِنها وَأَنتَ عاني",15,"ن",2,0],["يحزنني أن وقفتماني","وليس عندي سوى الكلام",16,"م",1,0],["يحزن الناس برهةً ثم يسلو","ن وتفنى الأحزان بالأفراح",17,"ح",1,0],["يَحُزُّ سيفُ بني صهيونَ عزتَها","وهَمُّهُم كسبُ مليونٍ من اللعب",18,"ب",1,0],["يحُزُّ في الصدرِ شلال التحانينِ","إلى أبيكم كتحزيزِ السكاكينِ",19,"ن",1,1],["يحزنني دهرٌ أحوجني","والوطنَ إليك أبا البخلِ",20,"ل",1,0],["يحز بهن أعناق المعاني","إذا خفيت فيوردها الجلاء",21,"ا",2,0]]}