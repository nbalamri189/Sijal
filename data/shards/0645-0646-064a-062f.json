يخ تراب","https://www.poetsgate.com/ViewPoem.aspx?id=152682",""],[5455,"باب النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=213952",""],[5458,"أحببت مستعمري","https://www.poetsgate.com/ViewPoem.aspx?id=113368",""],[5525,"الروح الجريحة","https://www.poetsgate.com/ViewPoem.aspx?id=922",""],[5596,"تقريظ كتاب التاريخ الإباضي","https://www.poetsgate.com/ViewPoem.aspx?id=206483",""],[5644,"هل تراني سوف ألقى بغيتي","https://www.poetsgate.com/ViewPoem.aspx?id=211268",""],[4623,"لا تلوموني إني أطلت المقالا ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146608",""],[5781,"أناقة العشق...وتصبُّري","https://www.poetsgate.com/ViewPoem.aspx?id=210380",""],[5823,"درب الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=59186",""],[5957,"إن بعد العسر يسرا","https://www.poetsgate.com/ViewPoem.aspx?id=180664",""],[6004,"واستباح العُرى","https://www.poetsgate.com/ViewPoem.aspx?id=33753",""],[6008,"شفت الخبل","https://www.poetsgate.com/ViewPoem.aspx?id=59161",""],[6056,"القناعة كنز بايد","https://www.poetsgate.com/ViewPoem.aspx?id=130344",""],[6177,"لن أعود إليك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79464&r=&rc=24",""]],"verses":[["مَن يُداوي داءَ أَحشا","ئِكَ وَالداءُ عُقامُ",0,"م",1,0],["مِن يَدي كُلُّ مُترَفٍ ساحِرِ الطَر","فِ جَميلِ الأَوصافِ كَالدينارِ",1,"ر",1,0],["مَن يَدعُني مِهُمُ يَبغي مُحارَبَتي","فَاِستَيقِنَنَّ أُجِبهُ غَيرَ وَسنانا",2,"ن",2,0],["مِن يَدٍ مَوهوبَةٍ مُلهَمَةٍ","تَغرِسُ الإِحسانَ أَو تَبني العَلاء",3,"ا",2,0],["من يدع رائدة الندى من كفه","فندى ابن عبد الله يدعو الرائدا",4,"د",2,0],["مِن يَدَي شادِنٍ يَكادُ يُعيدُ ال","راحَ سَكرى بِخُلقِهِ المَأنوسِ",5,"س",1,0],["مَن يَدفَعِ الكُرَبَ العِظامَ إِذا اِلتَقَت","في مَأزِقٍ حَلَقاتُ كُلِّ بِطانِ",6,"ن",1,0],["مَن يَدَّعِي شرفَ الحياةِ لمعشرٍ","كَفَروا بمن يَهبُ الحياةَ ويَخلُقُ",7,"ق",1,0],["مَن يدفعِ الطُّوفانَ لا يعتاقُه","سُورٌ ولا يُعْدَى عليه مَصادُ",8,"د",1,0],["مَن يدفعِ الطُّوفانَ أقبلَ من عَلٍ","يستنُّ في لُجَجٍ له وسُيولِ",9,"ل",1,0],["مَن يَدفَعُ الغاراتِ بَعدَكَ إِن دَعا","يا للحُماةِ وَلَجَّ في الإِعوالِ",10,"ل",1,0],["مُنىً دُونَها غَيثُ البِلادِ وَغوثُها","مَليكُ الوَرى عَبدُ الحَميدِ المعظَّمُ",11,"م",1,0],["مَنْ يَدَعْهُ لا يَنَلْ مَجداً وإن","فَتَحَ الأرضَ وأقطَارَ السَّماءْ",12,"ا",2,0],["مِن يَدَي ساقٍ ظَريفٍ","كَسِيَ الحُسنَ شِعارا",13,"ر",2,0],["مَن يُدنِ لِلشّاكَةِ أَثوابَهُ","يُصِبهُ مِنها غُصُنٌ هارِدُ",14,"د",1,0],["مَنْ يَدْعُ هِنْداً يَعْنِ مِنْ","أَسْنَى مَعَانِي الشِّعْرِ عَدَّا",15,"د",2,0],["مَنْ يَدْعَ مثلك، يا نجي","ب، دعا سميعًا يستجيب",16,"ب",1,0],["من يدير الحرب عن رأي له","سعة البحر إذا ضاق المحل",17,"ل",1,0],["من يدفع الغارات بعدك إن طغت","أهوالها ودعا المغير نزال",18,"ل",1,0],["من يدّعي جهلا وجودَ نظيره","في العالمينِ فقوله تضليلُ",19,"ل",1,0],["من يَدَيْ أدعج اللواحظ ألمي","أهيف القدّ ربّ خصر هضيمِ",20,"م",1,0],["مَن يَدفَعُ الشَرَفَ الَّذي أوتيتَهُ","مِن بَعدِ أَن أَعيا الوَرى إِنكارُهُ",21,"ر",2,0],["مَن يَدعُ يَوماً أَبا زَيدٍ لِحاجَتِهِ","فَقَد دَعا دَعوَةً ما خابَ داعيها",22,"ي",3,0],["مِن يَدي حَتّى شَوَى كَبدي","كيدٌ مِنَ الدَهرِ لا تَعدي مَراميهِ",23,"ي",2,0],["من يداه بالجود مغرقة","ونداه اندى من السحب",24,"ب",1,0],["من يداه قد اعربت عن نداه","وتحلى باحسن الاوصاف",25,"ف",1,0],["مِن يَدي مَهضومَةِ الكَش","حَينِ بَيضاءَ رَداحِ",26,"ح",1,0],["من يداوي لي فؤاداً","قد شكا داء وداء",27,"ا",2,1],["من يدٍ عذراء لها وجنةٌ","تحار فيها أعينُ الحور",28,"ر",1,0],["مِن يَدِ السَيِّدِ الحَبيبِ الَّذي جا","ءَ بِقِسطِ الهُدى وَقامَ بِوَزنِك",29,"ك",1,0],["مِن يَداهُ يا أَرضَ جُهدِ الطاعَه","زَلزَلَتكَ في بُرهَةٍ مِن ساعَه",30,"ه",1,0],["مِن يَدَي ساقٍ سُقينا","مِن لَماهُ ما سُقينا",31,"ن",2,0],["من يَدِن يسقطْ قصاصاً","عادلاً فالمرء ناقصْ",32,"ص",1,0],["مَن يدُ التَّوفيقِ مسَّتْ قَلبَهُ","فهو مَشغولٌ بِنا مُنْهَمِكُ",33,"ك",1,0],["من يدعى ان النوابغ قد خلت","منهم ضفاف النيل ليس يصدق",34,"ق",1,0],["مِن يَدَي رَخصَةِ البَنانِ كَقَرنِ الشَّ","مسِ حُسناً في الضَّوءِ والإشراق",35,"ق",1,0],["مَن يُدانيه في مَيادين سَبق","مِن أَهالي بِلاده وَالأَجانب",36,"ب",1,0],["من يدي ساقٍ يُحاكي خدُّهُ","قهوةً فيها حَبابٌ كالنَّمش",37,"ش",1,0],["من يدعه لنصرة","على العدو يُجِب",38,"ب",1,0],["من يدخل الافيون بيت لهاته","فليلق بين يديه نقد حياته",39,"ت",2,1],["مَن يَدّعي أَنّه بِالزّعمِ عارَضَها","عَلَيهِ قَد حَكَموا بِالجَهلِ وَالحمقِ",40,"ق",1,0],["مَن يُدانيكَ لِكَي أَسْتَشْفعا","أَنتَ وَاللّه الشَّفيعُ الأعظمُ",41,"م",1,0],["مَنْ يَدَّعي مَثلاً لَهُ يا وَيلَه","هَل كانَ غَيرَ مُكذَّبٍ وَمُفنَّدِ",42,"د",1,0],["مَن يَدخُل الأَعداء بَينَ صَفِّهِ","فَباحثٌ عَن حَتفِهِ بِظِلفه",43,"ه",1,0],["من يدَّعي الفضلَ بين الناسِ وهْو أخو","نقصٍ فذلك وغْدٌ غيرُ مصدوق",44,"ق",1,0],["من يدرِ أنّ لقاءه لحبيبه","حتمٌ ايحسن أن يلاقي بالزللْ",45,"ل",1,0],["من يدنُ من هذي المها","لك كان منها في خَطَرْ",46,"ر",1,0],["مِنْ يديه وسيفِه للرعايا","والأعادي الإِنعامُ والانتقامُ",47,"م",1,0],["من يد عون الدين صدر الزمان","يحيي المرجّى تخجل المرزمان",48,"ن",1,1],["من يَدي أحوى رَخيم","لَحظه حَد الحسام",49,"م",1,0],["من يدعي الفضل محتاج لبينة","وفضله واضح من غير برهان",50,"ن",1,0],["من يداوي لبنان عنك بصبر","من يعزي عن فقدك الأهراما",51,"م",2,0],["من يَديْ أهيفِ الشّمائل بالخا","لِ له نونُ صُدغِه منقوطُ",52,"ط",1,1],["من يدمنِ الخمرةَ يُقتَل بها","فالخمر سُمٌّ لا شفيع لديه",53,"ي",2,1],["من يدي مخطف المعاطف معشوق","التثني مجدول مجرى الوشاح",54,"ح",1,0],["مِنْ يَدَيْ أَغلبٍ لأغْلَبَ لا فُرْ","قانَ بين الموصوفِ والمرسوم",55,"م",1,0],["مَن يُداوي الدُنيا وَمَن يَكلَأُ المُل","كَ لَدى فادِحِ الخُطوبِ العِظامِ",56,"م",1,0],["مِن يَدِّها هذِى الكَرِيمَة سُيِّدَت","فَلَها عَلَينا حُرمَة وَذِمامُ",57,"م",1,0],["من يَدَيْ أهيف مهضوم الحشا","ثمل الأعطاف مجدول الوشاح",58,"ح",1,0],["من يدَّعي علمَ الصفاتِ فإنه","لا يعرفُ الإدبار والإقبالا",59,"ل",2,0],["من يدَّعي التصريف في أحكامه","قد ظنَّ ظَناً أنَّ فيه مُحالا",59,"ل",2,0],["من يدَّرعْ يطلعْ صوناً على الحرمِ","وليس يدري به إلا أولوا الكرمِ",60,"م",1,1],["من يدَّعي أن الحبيب أنيسه","في حاله فدليله استبشارُه",61,"ر",2,0],["من يدَّعي حكم الكيان فإنه","قد تيمته بحبها أغياره",61,"ر",2,0],["من يدَّعي حُبَّ الإمام فإنما","قذفت به نحو المنون بحارُه",61,"ر",2,0],["من يدعي وداً بغير بقيةٍ","من غيرنا فوداده لن يحمدا",62,"د",2,0],["مَن يَدفَعُ السَيلَ اِستَمَدَّ جُنونَهُ","مُتَحَدِّراً مِن عالِياتِ نِجادِ",63,"د",1,0],["مَن يَدَع نار ذكاه","فَقَد اِستَقرى الرَمادا",64,"د",2,0],["من يدعى انه يدرى مكانته","بنفسه فهو مغرور بدعواه",65,"ا",2,1],["مِن يَدي ثُمَّ عَلى يَدِهِ","تَجتَني الأَوطانُ أَثمارا",66,"ر",2,0],["منْ يَدَي مُرْدَفِ الرّوادفِ تَشْتا","قُ إلى الغَرفِ من خراهُ الأنوفُ",67,"ف",1,0],["من يدعُني جَداً لشيبي لم أُجبْ","من يدعُني جداً أَراني العجَبا",68,"ب",2,0],["من يد ساق مقرطق غنج","مكحّل بالفتور والكحل",69,"ل",1,0],["من يدي ساق غرير","خنث الدل رخيم",70,"م",1,0],["من يدَى ظبي غريرٍ","غنج المقلةِ ساجي",71,"ج",2,0],["من يدي أهيف عذيب الثنايا","ينفث السحر من عيون سواجي",72,"ج",2,0],["من يد الّظبي الغرير","مالهُ في الحسن ثان",73,"ن",1,0],["مِنْ يَدَيْ حُلْوِ التثَنيِّ","فَاتِنٍ أَهْيَفِ قَدِّ",74,"د",1,0],["من يده اليسرى وان كانت يمين","وذا اعتقاد كل ذي عقل ودين",75,"ن",1,0],["منيدلا للكم أو سكِّينة","أو طاسة التكعيب أو قنينة",76,"ه",1,0],["من يدٍ للظلم أَقوى من يَدٍ","لَم تَنَل إِلّا العباد الضُعَفاءَ",77,"ا",2,0],["من يد تولى ندى وردى","فلذاها الأرى والصبر",78,"ر",1,0],["من يدعي بكرم الأرومة فليقم","حجباً كما قدمت أنت نواصعا",79,"ع",2,0],["من يدق الحرب يجد طعمها","مراً وتحبسه بجعجاع",80,"ع",1,0],["من يدّرع بالصفات الغرّ باهرة","وجدّ في طلب العلياء لم يخب",81,"ب",1,0],["مِن يَدِ ساقٍ ساقَ نَحوي الحَتفا","بِمُقلَةٍ تَفري الدّلاصَ الزّغفا",82,"ف",2,0],["مَن يَدي كُلِّ فاتِن اللّحظِ عَينا","ه عَلى فِعل كَأسِهِ عَوناهُ",83,"ا",2,0],["من يدرِ داري ومن لم يدرِ سوف يرى","عمّا قليلٍ نديماً للندامات",84,"ت",1,0],["من يدي كل ساحر الطرف يجني","الورد من وجنتيه والتفاحا",85,"ح",2,0],["من يَدَيْ ساحرِ اللواحظِ قلبي","بهواهُ مُسْتَهْتَرٌ مَسْحُورُ",86,"ر",1,0],["مَن يَدرِ الجِدِّ والإِقدامِ لَم","يُحجِم وَلَم يُخلدِ إلى ظِلِّ الوَنى",87,"ا",1,0],["من يدَي فاترِ اللَّواحظِ معسُو","لِ الثَّنايا أحوى دقيقِ الخَصرِ",88,"ر",1,0],["من يديكَ النَدى اِلتَمَستُ فَجُد لي","منك بِالفَضلِ وَالفُتوحِ الحسّي",89,"س",2,0],["من يدي قاضي النار بشراك أرخ","أنجد الحق حكم قاضي الجنه",90,"ن",2,0],["من يديه للعرب تجرى حياة","وباعناق الروم يمضي حمامه",91,"م",2,0],["مِن يَدِي يا بابُ أَخرُجُ أَم","مِن دَمِي يا ريحُ أَنطَلِقُ؟!",92,"ق",1,0],["مِن يدور في حياتي ما لَقى مَعنى الخَساره","حتى نظراتي وجفوني تمتلك وجدانِ صافي",93,"ف",2,1],["من يدوجه يتهيأ للجواب البديل","مسهله في بعيده مصعبه مقربه",94,"ب",2,0],["من يدي لازم يجي عيشك","ولازم قبل نومك آظمك",95,"ك",1,0],["من يديهآ لو تذوق الشآذليّه","ضعت مابين الرخآوه والسطآوه",96,"ا",3,0],["من يداوي جرحي اللي ما يطيب","من يرد اللي من أيامي انسرق",97,"ق",1,0],["مَنْ يُدَاْوِيْ جِرَاْحَنَاْ فِي الْمَنَاْفِيْ","فِيْ بِلاْدٍ شَرْقِيَّةٍ غَرْبِيَّةْ",98,"ي",2,0],["من يدانِيْكَ بين أصحابِ خيرِ ال","مرسلينَ في رفعةِ المقدار ؟",99,"ر",1,0],["مِنْ يدينا اليومَ نبني عَالما ً","مُفعما ً بالحبِّ يزهو بالإخاءْ",100,"ا",2,0],["مَن يُدرِكُ السِّرَّ العَظيمَ لِقَولِهِ؟!","والجَاهِلُونَ لِقولِهِ أَعدَاءُ",101,"ا",2,0],["من يدرى أنى مصرى","لى صوت كالحب الطاهر",102,"ر",1,0],["من يدرى أنى وطنى","ذو عزم كالموج الهادر",102,"ر",1,0],["من يدرى أنى وطنى","أوطانى فردوس عاطر",102,"ر",1,0],["من يدعي أمرا ليستر غيره","فغدا ستنبيء سره الاخبار.",103,"ر",1,0],["مَن يُدرِكُ السوءَ لايدنو لسيئةٍ","والمدركُ الخيرَ يسعى دونما قَدَمِ",104,"م",1,0],["مَنْ يُدركُ الرُّشْدَ لولا لَمْحُ بارقِهِ؟","مَنْ يعرِفُ الجودَ لولا مُجتدى الكَرَمِ؟",105,"م",1,0],["من يدّعي السِلْمَ لم يعرفه في لغةٍ","تُحرّقُ الحرث تُدمي غصنَ زيتونِ",106,"ن",1,0],["من يُدرك الله لن يخشى من العدمِ","فالصفرُ ليسَ سوى من منه عنه عميّ",107,"م",2,1],["من يدّعي أن السماء تمده","يا سخفها نفخت به الأوهام",108,"م",1,0],["من يدّثر صوتي الليله ويكسب له ثواب ؟!","مالها يالشعر غيرك أنت .. ياجبر الكسور",109,"ر",1,0],["من يدنو يرمى بسهم قاتل أبداً","لا يخطئ السهم فالتوجيه بالنظر",110,"ر",1,0],["من يداوي علة الروح الجريحه","ومن يسلي دمعة العين الشقيه",111,"ي",2,0],["من يد المختار دارت","فاستداروها شرابا",112,"ب",2,0],["من يداوي جرح صبٍّ نازفا","من سيحيي نبض قلبي حينها",113,"ه",2,0],["من يديه كل الأيادي جرت في","السر والجهر للورى تتوالى",114,"ل",2,0],["من يدفعِ الدمعَ المُلاقي طَرْفَهُ","إنْ كانَ منْ أهواهُ حلَّ بِمَحْجَري",115,"ر",2,0],["من يديها ذقت الهوى المستطابا","وتجرَّعْتُ هجرها والعذابا",116,"ب",2,1],["من يديها قطفت ورد الأماني","وجنيت العشق النديَّ المذابا",116,"ب",2,0],["من يد ِ الأحجار تأتي","شمسنا الجذلى تدور",117,"ر",1,0],["مَنْ يُدَاني( رَسولَ الْهدى)","فِي شِموخٍ وَفِي حُسنِهِ",118,"ه",1,0],["من يدور بالبشر شد الحبال","شد حبله وان اقطعه مايطول",119,"ل",1,0],["من يدوّر عز ّ نفسه والمعالي والطموح","فحلهّا في ايديه ويقدر يدركه كانه ولد",120,"د",1,0],["من يدعي عشق المحاسن قُل له :","جبهاتهن تفُلّ كل سلاح",121,"ح",1,0]]}