َ فَانظُرني فَإِن جَهِلتَني","فَرُبَّما دَلَّ عَلَيَّ مَنظَري",4,"ي",1,0],["دونَكُمُ فَاِبتَدِروا غُنمَها","دُمىً مُباحاتٍ وَمالٌ مُباح",5,"ح",1,0],["دَوامُ الهَوى في ضَمانِ الشَبابِ","وَما الحُبُّ إِلّا زَمانُ التَصابي",6,"ب",2,1],["دونَ أَن أَترُكَ السُيوفَ كَقَتلا","ها رَزايا مِن حَرِّ قَرعٍ وَضَربِ",7,"ب",1,0],["دوَما نَزَحَت لِلعَينِ بَعدَكِ عَبرَةٌ","إِذا اِنحَدَرَت قادَت لَها أَخَواتِ",8,"ت",1,1],["دَوامُ مُدامَةٍ وَدَوامُ وَطءٍ","وَإِدخالُ الطَعامِ عَلى الطَعامِ",9,"م",1,0],["دوّخوا نازِحَ البَسيطةِ حتّى","نالَ ما شاءَ ذابِلٌ وصَفيحُ",10,"ح",1,0],["دَوِيَ الجُرحُ وَلَم يُقدَر لَهُ","بَعدَ ثاوي عَينِ شَمسٍ مِن طَبيبِ",11,"ب",1,0],["دومي عَلى العَهدِ ما دُمنا مُحافِظَةً","فَالحُرُّ مَن دانَ إِنصافاً كَما دينا",12,"ن",2,0],["دَواعي نِفاقٍ أَنذَرَتكَ بِأَنَّهُ سَيَشرى","وَيَذوي العُضوُ مِن حَيثُ يَشأَفُ",13,"ف",1,0],["دونَكَ الراحَ جامِدَه","وَفَدَت خَيرَ وافِدَه",14,"د",2,1],["دونَنا في الناسِ مَسعىً واسِعٌ","لا يُدانينا وَفي الناسِ كَرَم",15,"م",1,0],["دَوافِعَ بِالرَوحاءِ طَوراً وَتارَةً","مَخارِمَ رَضوى مَرجَها فَرِمالَها",16,"ل",3,0],["دول حرة تجدد فيها","تالد المجد بعد الإضمحلال",17,"ل",1,0],["دوموا وأيامكم بالألف زاهرةً","ولا عدته عوادي الخلف والأحن",18,"ن",1,0],["دومُوا وَدَامَتْ بِلا عَدٍّ مَفَاخِرُكُمْ","مُخَلَّدَاتٍ لأَزْمَانٍ فَأَزْمَانِ",19,"ن",1,0],["دَوَّتْ زَوَايَاهُ بِإِنْشَادِهِمْ","وَعَقَدَ التَّبْخِيرُ شِبْهَ الْغَمَامْ",20,"م",1,0],["دُونَهُ الْحَازِبَانِ مِنْ","بَذْلِ مَالٍ وَسَفْكِ دَمْ",21,"م",1,0],["دَوِّيَّةٌ وَدُجى لَيلٍ كَأَنَّهُما","يَمٌّ تَراطَنَ في حافاتِهِ الرومُ",22,"م",1,0],["دَوَّمَ فيها رَزَّهُ وّأّرعَدا","إِذ جاوَرَت أُمُّ الهَديرِ الأَرأَدا",23,"د",2,0],["دولتو دولا شريفا","بالوجب تشكر وتحمد",24,"د",1,0],["دونه كلّ من مضى","دونه كل من غبر",25,"ر",1,0],["دون الوصول إليه كلّ مُشعِلَة","شعواء تترك وجه الشمس مَكتمنا",26,"ن",2,0],["دَويَّةٌ قَزَفٌ تُضحي جَنادِبُها","وُرقاً وَحِربائُها صَديانُ مَهيومُ",27,"م",1,0],["دَوارِجَ قَد غَيَّرنَ ظاهِرَ تُربِهِ","وَغَيَّرَتِ الأَيّامُ ما كانَ مُعلَما",28,"م",2,0],["دواة لها جنس الحديد وبأسه","وزادت عليه في الندى فهي أبهر",29,"ر",1,1],["دونكَ إن عشقتهُ بين الورَى","معظماً لقدره مكبرا",30,"ر",2,0],["دونكَ والمدح ذكيًّا معجبا","نحو لقيت القاضيَ المهذَّبا",30,"ب",2,0],["دونكها معسولة الآداب","ممزوجة بملحةِ الإعراب",30,"ب",1,0],["دُونك الكَشْفَ والعتابَ فقوِّم","بهمَا كُلَّ خَلَّةٍ عَوْجاءِ",31,"ا",2,0],["دوام احتجابك عن رائدي","ولولاي لم يَرَ منك احتجابا",32,"ب",2,0],["دونكموها يا بني مَرثدٍ","لا تعدَموا أمثالَها مكسبا",33,"ب",2,0],["دونكها كأساً وأمثالها","صِرفاً من المكروه لم تُقطبِ",34,"ب",1,0],["دولةٌ يغمِرُ الزمانُ فتاها","سَوَّمَتْ بالسواد سيما الشبابِ",35,"ب",1,0],["دونكم مستقيمةَ السمتِ فيكم","حين تَعوجُّ بالكلام السُّموتُ",36,"ت",1,0],["دوني وأَعدى هجرهُ الهفْشرَّجا","ولم أزل بالطيبات مُلْهجا",37,"ج",2,0],["دولةٌ عاد نرْجِسُ الروْضِ فيها","من عُيُون وَوَرْدُهُ من خُدُودِ",38,"د",1,0],["دونك يا سيِّدَ أكفائه","عزف الحسان الخرَّد الغيدِ",39,"د",1,0],["دون ما قد مَطَلْتَ يُنتَجُ فيه","مثل بِرْذَوْنِكَ الذي أنت مُهْدي",40,"د",2,0],["دون أن صرتُ أشتهي","بعض ما يشتهي البشرْ",41,"ر",1,0],["دونَكها حُلّةً محبرةً","تَطرِف من كل حاسد بصره",42,"ر",2,0],["دونكها من صنعةِ الفَلافسه","وانظر أجمَّتك الأكفُّ الخالسه",43,"س",2,0],["دونَكَها تَكْسوك ثوباً أطْلسا","يُخاوضُ المجلس فيها المجْلِسا",44,"س",2,0],["دونك رأيي فما كواكبه","في الظُلَم الداجياتِ بالطُمُس",45,"س",1,0],["دونك عزمي فما مَعاوِلُهُ","عند قيام الخطوبِ بالجُلُس",45,"س",1,0],["دُونَكمْ منطِقاً يسيراً عسيراً","قَرْضُ أمثاله على القُرَّاض",46,"ض",1,0],["دولةٌ سبَّبها ذو كنيةٍ","وسم الملك بها وهو جذعْ",47,"ع",1,0],["دوَّخن شيبان أمّا في رؤوسهمُ","تُدوِي الطبيب إذا أغشاه مجرافا",48,"ف",2,0],["دوني الدروع إذا ما كنت لي وزراً","والبَيض والبِيض والخطيُّ والحجف",49,"ف",1,0],["دُونَكَهَا ناظراً بغَفْلَتكَ ال","حرَّةِ لا الألمعيِّ من طبنِك",50,"ك",1,0],["دولةٌ ليس يُعدَمُ الدهر فيها","باطلٌ مزهقٌ وحقٌّ مُدالُ",51,"ل",1,0],["دونكموها وما أَمُنُّ بها","غراءَ تحكي اللآلئَ التُّؤما",52,"م",2,0],["دونكم مُشكل الهجاء نذيراً","بفصيحٍ من الهجاء مبين",53,"ن",1,0],["دَوَت صَيحاتُهُم في كُلِّ صِقعٍ","فَكادَت تَنشُرُ المَوتى الرِماما",54,"م",2,0],["دَوَتِ المَدافِعُ كَالرُعودِ قَواصِفاً","نَطَقَ الحَديدُ فَعِيَّ كُلُّ لِسانِ",55,"ن",1,0],["دَولَةٌ كَم قَد سَألَنا","رَبَّنا التَعويضَ عَنها",56,"ه",2,1],["دونَ السَماءِ وَفَوقَ الأَرضِ مَسلَكُها","تيهٌ نَفانِفُ لا بَحرٌ وَلا بَلَدُ",57,"د",1,0],["دونَ أنْ تَبْلَعَ النُّفو","سُ رُضاباً مُرَوَّقا",58,"ق",2,0],["دوروا مع الحق الذي","يرنو اليكم حيث دارا",59,"ر",2,0],["دول منقّلة وحق ثابت","دول السياسة ما أقل بقاءها",60,"ا",3,0],["دونكم يا قوم إيقاد البخور","وألفظوا ألفاظ سحر لا يبور",61,"ر",1,0],["دول قد تصرمت","دولة إثر دولة",62,"ه",1,0],["دَولَةٌ مالَت وَسُلطانٌ خَلا","دُوِّلَت نُعماهُ بَينَ الأَقرَبين",63,"ن",1,0],["دونَ النُبوغِ وَأَوجِهِ","ما لا تَعُدُّ مِنَ الصِعابِ",64,"ب",1,0],["دونَ الجَلاءِ وَدونَ يانِعِ وَردِهِ","خُطُواتُ شَعبٍ في القَتادِ تُسارُ",65,"ر",1,0],["دَولَةُ الشَرقِ وَهيَ في ذِروَةِ العِزِّ","تَحارُ العُيونُ فيها فَخامَه",66,"م",2,0],["دُوَلٌ لَم تَبِد وَلَكِن تَوارَت","خَلفَ سِترٍ مِنَ الزَمانِ رَقيقِ",67,"ق",1,0],["دُوَلٌ كَالرِجالِ مُرتَهَناتٌ","بِقِيامٍ مِنَ الجُدودِ وَتَعسِ",68,"س",1,0],["دونَ عِزِّهِ","تُبَّعُ الغَلَب",69,"ب",1,0],["دونَهُنَّ لا","يَثبُتُ اليَلَب",69,"ب",1,0],["دونَها الرَشيدُ وَما","أَخلَدَت لَهُ الكُتُبُ",70,"ب",1,0],["دَولَةٌ في الثَرى وَأَنقاضُ مُلكٍ","هَدَمَ الدَهرُ في العُلا بُنيانَه",71,"ن",2,0],["دَولَةٌ شادَ رُكنَها أَلفُ عامٍ","وَمِئاتٌ تُعيدُها أَعوامُ",72,"م",1,0],["دَواليكَ يا سَيفَها دَولَةً","وَأَمرَكَ يا خَيرَ مَن يَأمُرُ",73,"ر",1,0],["دونَ السِهامِ وَدونَ القُرِّ طافِحَةً","عَلى نُفوسِهِمِ المُقوَرَّةُ المُزُعُ",74,"ع",1,0],["دونَ الحَلاوَةِ في الزَمانِ مَرارَةٌ","لا تُختَطى إِلّا عَلى أَهوالِهِ",75,"ل",2,0],["دونَ التَعانُقِ ناحِلَينِ كَشَكلَتَي","نَصبٍ أَدَقَّهُما وَصَمَّ الشاكِلُ",76,"ل",1,0],["دونَ أَن يَشرَقُ الحِجازُ وَنَجدٌ","وَالعِراقانِ بِالقَنا وَالشَآمُ",77,"م",1,0],["دون جدوى أبي الحسين إذا ما اش","تغل الشعر بالعطايا الرغاب",78,"ب",1,0],["دونَ إِدراكِ أَحمَدِ بنِ سُلَيما","نَ عُلوٌّ يُعيي الرِجالَ اِرتِقاؤُه",79,"ا",3,0],["دَوحَةٌ مِن فُروعِها اِنشَعَبَ المَج","دُ