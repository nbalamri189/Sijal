an/poem/55197","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54509","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55086","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141968","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43793","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43697","الطويل"],[104,"لك الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=37376",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[106,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""],[77,"ذكروا العهود فهاج من أشجاني","https://www.poetsgate.com/ViewPoem.aspx?id=34168",""],[3,"َجِبَت عُبَيلَةُ مِن فَتىً مُتَبَذِّلِ","https://www.poetsgate.com/ViewPoem.aspx?id=10317",""],[90,"ذكرى الهاشمي","https://www.poetsgate.com/ViewPoem.aspx?id=179163",""],[45,"أبَرَّ عَلى الألْوَاءِ نَائِلُكَ الغَمْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31285",""],[80,"أمسكَ الصبا أهدتْ إلي صبا نجدِ","https://www.poetsgate.com/ViewPoem.aspx?id=3155",""],[80,"أين مني عتبُ أحبابٍ هجود","https://www.poetsgate.com/ViewPoem.aspx?id=3156",""]],"verses":[["جَبَلٌ تَسَنَّمَتِ البِلادُ هِضابَهُ","حَتّى إِذا مَلَأَ الأَقالِمَ زالا",0,"ل",2,0],["جَبَلٌ هَوى لَو خَرَّ في البَحرِ اِغتَدى","مِن وَقعِهِ مُتَتابِعَ الإِزبادِ",1,"د",1,0],["جبَلُ الوَقارِ رَسا وأشْرَقَ واعْتَلَى","وسَما فطأطأتِ الجِبالُ رُؤوسا",2,"س",2,0],["جَبرْتَ بِجَبْرِكَ كُلَّ نَفْسٍ حُرَّةٍ","وَشَدَا بِشُكْرِ اللَّهِ كُلُّ لِسَانِ",3,"ن",1,0],["جَبَلٌ تَضَاحَكَتِ الْبُرُوقُ بِجَوِّهِ","فَبَكَتْ عِذَابُ عُيُونِهِ بِعُيُونِ",4,"ن",1,0],["جَبَلاً لِطَارِقٍ مُذْ أَقَلَّ رِكَابَهُ","لَمْ تَنْأَ عَنْهُ طَوَارِقُ الْحَدَثَانِ",5,"ن",1,0],["جَبَهناهُمُ بِالطَعنِ حَتّى تَوَجَّهوا","وَهَزّوا صُدورَ السَمهَرِيِّ المُقَوَّمِ",6,"م",1,0],["جَبَلَ النارِ لَقَد رُعتَ الوَرى","أَنتَ في حالَيكَ لا تَرعى ذِماما",7,"م",2,0],["جَبَينا السُحبَ في عَهدِ الرَشيدِ","وَباتَ الناسُ في عَيشٍ رَغيدِ",8,"د",1,0],["جبريل يا ابن الماجدين إلى","أسمى المناسب في ذرى الفخر",9,"ر",1,0],["جِبَالٌ تَرَامَتْ فِي الفَضَاءِ خُطُوطُهَا","يُرَقِّقُهَا رَسَّامُهَا وَيُضَخِّمُ",10,"م",1,0],["جبرت مهيضاً من جناحي ورشتَهُ","وَسَهَّلْت لي من جانب الزمن الوعرِ",11,"ر",1,0],["جبل سمت منه الفروع وأصله","تحت البسيطة راسخ الأركان",12,"ن",1,0],["جبلت نفسه على الخير حتى","لم تجده إلا لخير مريدا",13,"د",2,0],["جُبلنا على حبّ الحياة وإنها","مخيفة أحلام أطافت بحالم",14,"م",1,0],["جَبَيتَ جَبا عَبدٍ فَأَصبَحتَ مورِداً","غَرائِبَ يَلقى ضَيعَةً مَن يَذودُها",15,"د",3,0],["جبين سلطاننا المرجى","مبارك المطلع البديع",16,"ع",1,1],["جبراً لها مدحة لولاك ما انسلكت","نظماً به سار قوم أية سلكوا",17,"ك",3,0],["جبريل راوي نصّه الأحلى وفي","ورق الجنان كتابه مرقوم",18,"م",1,0],["جبلتُ روحكَ في روحي كَما","يُجبَلُ العَنبَرُ بِالمِسكِ الفَتِق",19,"ق",1,1],["جبانٌ ولكنَّ استَهُ ذاتُ جرأةٍ","ولو لَقِيتْ عمرو القنا في كتيبتِهْ",20,"ت",2,0],["جبى الفيْء للسلطان والفيء فاغتدى","له الرتبةُ العلياءُ فوق جُباتِهِ",21,"ت",2,0],["جبل بناه اللَّه حول حريمِهِ","لِيَحُوطَ من يرعى ويُثْبِتَ ما دَحا",22,"ح",2,0],["جَبَلِ الحلْم لُجَّة العِلْم لا يُطْ","مَعُ في نسْفِهِ ولا استنفادِهْ",23,"د",2,0],["جبسٌ يهرُّ على الأحرار حاجبه","وآفةُ الناس أن تستأسِد البقر",24,"ر",1,0],["جبانٌ من السوءات عنهنَّ ناكصٌ","ويلقى المنايا مُقدماً غير ناكص",25,"ص",1,0],["جَبَرتْني يدا أبي الحسن المح","سانِ حتى جُبرتُ بعد انهياض",26,"ض",1,0],["جبت الخروق بكل خرق ماجد","إن الخروق مسالك الأخراق",27,"ق",1,0],["جبلٌ عاصم ووادٍ خصيبٌ","لا ترى الدهرَ في جنابيه مَحلا",28,"ل",2,0],["جَبُنَ البخيلُ من الزمان وصَرْفِهِ","فتهيَّبَ الإفضالَ والتنويلا",29,"ل",2,0],["جبلُ الأرضِ ذو الشماريخِ والأط","وادِ والناسُ حوله كالرُّضام",30,"م",1,0],["جُبِلَ الفَقيرُ أَخوكَ مِن طينٍ وَمِن","ماءٍ وَمِن طينٍ جُبِلتَ وَماءِ",31,"ا",2,0],["جُبِلوا عَلى الإِسلامِ إِلّا أَنَّهُم","فُتِنوا بِنارِ الحَربِ أَو نارِ القِرى",32,"ر",2,0],["جبَّلتْها الحَيَاةُ في ثورة اليأ","سِ من الشَّرِّ كيْ تُجِنُّ جُنُونَهْ",33,"ه",1,0],["جبران كان بخالدات قصيده","لا بالثياب قشيبة يتأنق",34,"ق",1,0],["جبران فارقها روحا مرفرفة","وعاد يصبو اليها وهو جثمان",35,"ن",1,0],["جبران يحضنه قبر كمشفقة","والقبر تحضنه كالام لبنان",35,"ن",1,0],["جبل تقلقله الربى","فيلٌ تطارده الجآذر",36,"ر",1,0],["جِبالُهُ أَشراكُ","وَقُربُهُ هَلاكُ",37,"ك",1,0],["جُبتَ السَماواتِ أَو ما فَوقَهُنَّ بِهِم","عَلى مُنَوَّرَةٍ دُرِّيَّةِ اللُجُمِ",38,"م",1,0],["جَبّارُ ذِهنٍ أَو شَديدُ شَكيمَةٍ","يَمضي مُضِيَّ العاجِزِ المُنصاعِ",39,"ع",1,0],["جَبَلٌ عَن آذارَ يُزرى صَيفُهُ","وَشِتائُهُ يَئِدِ القُرى جَبَروتُهُ",40,"ت",2,0],["جِبريلُ أَنتَ هُدى السَما","ءِ وَأَنتَ بُرهانُ العِنايَه",41,"ا",3,1],["جُبنٌ أَقَلَّ وَحَطَّ مِن قَدرَيهِما","وَالمَرءُ إِن يَجبُن يَعِش مَرذولا",42,"ل",2,0],["جِبريلُ هَلِّل في السَماءِ وَكَبِّرِ","وَاِكتُب ثَوابَ المُحسِنينَ وَسَطِّرِ",43,"ر",1,1],["جِبريلُ يَعرُضُ وَالمَلائِكُ باعَةٌ","أَينَ المُساوِمُ في الثَوابِ المُشتَري",43,"ر",2,0],["جِبالَ مَلونا لا تَخوري وَتَجزَعي","إِذا مالَ رَأسٌ أَو تَضَعضَعَ مَنكِبُ",44,"ب",1,0],["جَبينُكَ والمُقَلَّدُ والثّنايا","صَبَاحٌ في صَباحٍ في صَباحِ",45,"ح",1,0],["جَبابِرَةُ الأَرضِ اِستَكانَت لِضَربَةِ","أَرَت قَيِّمَ النَهجِ الَّذي ذاقَ ناكِبُه",46,"ب",2,0],["جِبالُ حَضيدٍ تَحتَها الناسُ في الوَغى","وَفيها الضِرابُ الهَبرُ وَالعَدَدُ الدَثرُ",47,"ر",1,0],["جَبَلي أَعَزُّ إِذا الحُروبُ تَكَشَّفَت","مِمّا بَنى لَكَ والِداكَ وَأَفضَلُ",48,"ل",1,0],["جَباناً وَلَم يَعقِد لِسَيفٍ حِمالَةً","وَلَكِن عِصامُ القِربَتَينِ حَمائِلُه",49,"ل",2,0],["جِبالٌ إِذا شَدّوا الحُبى مِن وَرائِهِم","وَجِنٌّ إِذا طاروا بِكُلِّ عِنانِ",50,"ن",1,0],["جبهة حرة .. كما انسرح النور","وثغر فيه اعتداد وقسوة",51,"و",2,0],["جِبالُ أعدائِه بَرٌّ يَسِيحُ به","وَبرُّه لامتِناعٍ عندَهم جَبَلُ",52,"ل",1,0],["جَبَرَ المُلْكَ فيه جَبَّارُ حَرْبٍ","رافعٌ من لِوائِهِ الجَبَّارُ",53,"ر",1,0],["جبرَ الوليَّ نواله وتناهَبتْ","أسيافُه جَبَرِيِّةَ المتجبِّرِ",54,"ر",1,0],["جِبالٌ رسَتْ في لُجَّةٍ غيرَ أنها","تُحاذرُ أنفاسَ الرياحِ اللَّواعبِ",55,"ب",1,0],["جبالٌ تؤلِّفُها حِكمةٌ","فتَحبو البحارَ بها لا السُّهوبا",56,"ب",2,0],["جُبِلَ الأَنامُ مِن العِبا","دِ عَلى الشَريفَةِ وَالوَضيعَة",57,"ع",2,0],["جَبَرتَ كَسرَ المَعالي يا اِبنَ بَجدَتِها","بِها وَقَوَّمتَ ما بِالدينِ مِن عِوَجِ",58,"ج",1,0],["جُبِلَت عَلى سَفكِ الدِما أَلحاظُهُ","وَنِبالُهُ فَكِلاهُما لَم يُشفِقِ",59,"ق",1,0],["جَبانٌ عَنِ الفَحشا شَحيحٌ بِعِرضِهِ","إِذا عَيبَ بَعضُ الناسِ بِالشُحِّ وَالجُبنِ",60,"ن",1,0],["جِبالٌ بِأَرياحِ المَنِيَّةِ تُنسَفُ","غَدَت وَهيَ قاعٌ في الوَقائِعِ صَفصَفُ",61,"ف",1,1],["جِبالٌ إِذا ما الهَضبُ دُكَّت جِبالُها","بِحارٌ إِذا ما الأَرضُ غارَت بُحورُها",62,"ر",3,0],["جُبتُ البِلادَ وَلَستُ مُتَّخِذاً بِها","سَكَناً وَلَم أَرضَ الثُرَيّا مَسكِنا",63,"ن",2,0],["جبابرةٌ في الرّوْع تعْدو جيادُهُمْ","بهمْ فوق ما سحّ الوشيج المُقوَّمُ",64,"م",1,0],["جَبَلانِ يَقتَرِنانِ للرأيِ الَّذي","لِعِداكَ منه مذلّةٌ وصَغارُ",65,"ر",1,0],["جُبْتُهَا في مَتنِ ريحٍ تَنبَري","للسُّرَى بين سَيُوعٍ وَقتود",66,"د",1,0],["جبالٌ طَفَتْ فَوقَ المِياهِ وغُيّضَتْ","بِسُمر القَنا والمَرهفاتِ على الأُسدِ",67,"د",1,0],["جَبَلُ الجِبالِ غَدَت عَلَيهِ مُلِمَّةٌ","تَرَكَتهُ وَهوَ مُهَدَّمُ الأَركانِ",68,"ن",1,0],["جَبَلٌ مِنَ المَعروفِ مَعروفٌ لَهُ","تَقيِيدُ عادِيَةِ الزَمانِ العادي",69,"ي",1,0],["جبرْتِ يا عائدتي بالصلَهْ","فتممي الإحسانَ تنفي الولَهْ",70,"ه",1,1],["جُبْ أُربُعَ النقد، واسألْ عن ملاحمها","فهل ترى من نبيغٍ غيرِ مطعون",71,"ن",1,0],["جَبَلٌ يَزيدُ عَلى الجِبالِ إِذا بَدا","بَينَ الذَرائِعِ وَالحُثومِ مُقيمُ",72,"م",1,0],["جبريلُ يهتف والنبيُّ كعهدِه","بين الصُّفوفِ يرى الوجوهَ وينظرُ",73,"ر",1,0],["جبابرةٌ يأكلونَ الشُّعوبَ","وَيُمسونَ مِن سَغبٍ في سُعُرْ",74,"ر",1,0],["جبانُ اللّسانِ جبانُ الجَنان","على أنّه البطلُ الباسلُ",75,"ل",1,0],["جِبريلُ يهبط بالتَّحيّةِ فانْهَضُوا","مِلءَ السُّرادقِ هاتفين وقُوفا",76,"ف",2,0],["جِبريلُ ثالِثُنا وَعَينُ مُحَمَّدٍ","تَرنو إِلَينا مِن بَقيعِ الغَرقَدِ",77,"د",1,0],["جبريلُ يَدلِفُ بِاللواءِ وَأَحمدٌ","بَينَ الوَصيِّ وَبَينَ حَمزَةَ يَزحَفُ",78,"ف",1,0],["جُبارُ اسْتَقِمْ واشه