{"poems":[[53,"ومعتذر من نعمة قد أفادها","https://www.aldiwan.net/poem65998.html","الطويل"],[87,"رأى خدك الفتان اشهى من المنى","https://www.aldiwan.net/poem7539.html","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[164,"هذا التأني وهذا الحلم قد فعلا","https://www.aldiwan.net/poem58892.html","البسيط"],[369,"أعد نظرة تبصر صنيع هواكا","https://www.aldiwan.net/poem60818.html","الطويل"],[469,"رأى خط من يهوى فأرسل دمعه","https://www.aldiwan.net/poem3321.html","عموديه"],[755,"","https://poetry.dctabudhabi.ae/diwan/poem/121044","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77534","المنسرح"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117423","الطويل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82512","الطويل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82535","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204876","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89378","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62880","الوافر"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29323","الطويل"]],"verses":[["رأى خيرَها لمّا التقينا ولم يزلْ","يرى خير ما في الدسْتِ رأيةَ عاقِلِ",0,"ل",1,0],["رأى خدّك الفتان اشهى من المنى","فمال إليه ميل صب مولّع",1,"ع",1,1],["رَأَى خَلاَئِقَ زُهْراً","كَالْمِسْك طَابَتْ وَطَابا",2,"ب",2,0],["رأى خوارقَ عاداتٍ لك اتفقت","أمسى بها كل ملك يضربِ المثلا",3,"ل",2,0],["رأى خِلَلاً تَشريفَه معَ عزِّه","فأَوْلاكَها للصّونِ حينَ بلاكا",4,"ك",2,0],["رأى خطَّ من يهوى فأرسل دمعهُ","كما خان سلكٌ واثقاتِ المراسلِ",5,"ل",1,1],["رأى خدّه ميدان حسن وخاله","به كرةً فاستعمل الصدغ جوكانا",6,"ن",2,0],["رَأى خَيال الهِلال في الما","فَظَنَ أَن الهِلالَ أَرنَب",7,"ب",1,0],["رأى خطَّهُ ذا عِلَّةٍ فأعادَهُ","ومن يشتري ذا علةٍ بصحيح",8,"ح",1,0],["رَأى خلّتي من حَيثُ يَخفى مَكانها","فَكانَت قَذى عَينَيهِ حَتّى تَجَلّت",9,"ت",1,0],["رَأى خلّة مِنهُم تُسَدّ بِمالِه","فَساهَمَهُم حَتّى اِستَوَت بِهِم الحال",10,"ل",1,0],["رأى خلي بوحدتي انفرادا","عن الدنيا وعن باقي الشؤون",11,"ن",1,1],["رأى خليفتك الشرق المضاب بكم","فقال للبين حسبي اللَه منك أَحَنّْ",12,"ن",1,0],["رأَى خَوَرَ الأَسِنَّةِ في التَّنادي","فعدَّك قسمةَ الضَّرْبِ المثَاعِ",13,"ع",1,0],["رَأى خَلفَ أَسوارِ المَدينَةِ دَوحَةً","حَنَت فَوقَهُ بِالظِلِّ وَاليَومُ ناجِرُ",14,"ر",1,0]]}