ابا","https://www.poetsgate.com/ViewPoem.aspx?id=170413",""],[5431,"وجهٌ له الأنوارحتما تُشرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=187197",""],[5691,"فقير...!","https://www.poetsgate.com/ViewPoem.aspx?id=207554",""],[5751,"شَكوى مُسافر","https://www.poetsgate.com/ViewPoem.aspx?id=214716",""],[402,"آية في تسلسل الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=35359",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5855,"بوادر دمعك ما تنزف","https://www.poetsgate.com/ViewPoem.aspx?id=186553",""],[5885,"حيث سفينتي تأسى","https://www.poetsgate.com/ViewPoem.aspx?id=194836",""],[5906,"مَشَقة نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=188069",""],[5917,"يلذ بهذا العيش من ليس يعقل","https://www.poetsgate.com/ViewPoem.aspx?id=106531",""],[5943,"تعلَّم يافتى","https://www.poetsgate.com/ViewPoem.aspx?id=34437",""],[5957,"تعال أضمكَ","https://www.poetsgate.com/ViewPoem.aspx?id=26100",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6167,"أمام البيت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85535&r=&rc=18",""],[572,"تُرِيكَ مُرورُ الليالي العِبَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9276&r=&rc=133",""]],"verses":[["فَنَفَّضَ عَن أَجْفانِهِ غُبَّرَ الكَرى","وقد مالَ تَرْنيقُ النُّعاس بِلِيتهِ",0,"ت",2,0],["فنَفَضْتُ منهُ يدي مَخافَةَ كَيْدِهِ","إنَّ الكَريمَ على الأذى لا يَصْبِرُ",1,"ر",1,0],["فَنَفسُهُ مَوقوفَةٌ","بَينَ الرِضا وَالغَضَبِ",2,"ب",1,0],["فَنَفسي الفِداءُ لِهَذا الكِتا","بِ إِن كانَ خُطَّ بِإِملائِها",3,"ه",2,0],["فَنفَى حُسْنُهَا الأَسَى عَنْ ضَمِيرِي","وَجَلاَ نَاظِرِي وَسَرَّ جنَانِي",4,"ن",2,0],["فنفرّغ كاس ونمله","ونسقيه من نحب",5,"ب",1,0],["فنَفْخ منك يجعلهم هباءً","ويُسقِطهم إلى سُفلى المهاوي",6,"ي",1,0],["فَنَفسي وَالنُفوسُ فِداءُ قَومٍ","بَنوا لي فَوقَ مُرتَقَبٍ جَسيمِ",7,"م",1,0],["فَنَفسَكَ أَكرِمها فَإِنَّكَ إِن تَهُن","عَلَيكَ فَلَن تُلفي لَكَ الدَهرَ مُكرِما",8,"م",2,0],["فنفَّقتمُ سوق الثنا بضنائع","معجّلة للوفد من سبقها وفدُ",9,"د",1,0],["فنفَّر عن طرفي الكرَى وأعادَ لي","رسيس غرام وانْقضى وهو غضبان",10,"ن",1,0],["فنُفّلتِ الأيدي غِناها بمدحِهِ","ونُفِّلتِ الأفواهُ طيب المساوِك",11,"ك",1,0],["فنفسي في مقامهما","إلى الرحمن مُبْتَهِلَهْ",12,"ل",2,0],["فنفِسْتُ ذاك عليهمُ وأرَدْتُهُ","من دونهم وحْدي بغير قسيمِ",13,"م",1,0],["فنفتْهنَّ عن قلوبٍ وقدْ كن","نَ تبوَّأْنَ حبها أوطانا",14,"ن",2,0],["فنفثن السماعَ في أذْنِ خِرق","أريحيّ عليه ثَرِّ البنان",15,"ن",1,0],["فَنَفسَكَ فَاِحفَظها وَلا تُفشِ لِلعِدى","مِنَ السِرِّ ما يُطوى عَلَيهِ ضَميرُها",16,"ر",3,0],["فَنَفَرتُمُ كَالنَحلِ ما مِن زَهرَةٍ","فيها جَنى إِلّا وَفيها مَغنَمُ",17,"م",1,0],["فنفوا فانتفى فصادف خظا","حبذا الجِد إن أعين بِجد",18,"د",1,0],["فنفوس الأموال غير رواضٍ","عنه والسائلون غير غضاب",19,"ب",1,0],["فَنَفسي فَريقا قِسمَةٍ أَغفَلَ الهَوى","فَريقاً وَأَودى شُغلُهُ بِفَريقِ",20,"ق",1,0],["فنفرت عن نفر خطبت نوالهم","فغدوا علي حوادثا وخطوبا",21,"ب",2,0],["فَنَفَينا الرُقادَ عَن كُلِّ عَينٍ","فَجَّرَتها دُموعُها تَفجيرا",22,"ر",2,0],["فنفضتُ عني الموتَ وَهوَ ملازمي","حيث التفتُ فما أراكِ أمامي",23,"م",2,0],["فنفسُ الشيخ تضعف كلّ حينٍ","وقوّتُهُ على طَرَفِ الذّهابِ",24,"ب",1,0],["فَنَفسُكَ قَطُّ أَصلِحها","وَدَعني مِن قَديمِ أَبِ",25,"ب",1,0],["فَنَفى عَنكَ زُخرُفَ القَولِ سَمعٌ","لَم يَكُن فُرصَةً لِغَيرِ السَدادِ",26,"د",1,0],["فنفى بتفريكٍ وصقلٍ مذهبٍ","عنه القذى ريحُ الصّبا ومرورُها",27,"ر",3,0],["فنفسَكَ فَاحْمِلْها على البرِّ إنّه","لأَربَحُ مِمّا تَحمِلُ الأرضُ مَتْجَرَا",28,"ر",2,0],["فَنَفرنَ حينَ عَرَفنَ شَخ","صِيَ ماثِلاً دونَ الرَواحِل",29,"ل",1,0],["فَنَفَّضَ عَن سِربالِهِ لُؤلُؤَ النَدى","وَآيَسَ ذُعراً قَلبُهُ فَتَأَمَّلا",30,"ل",2,0],["فَنَفَضَت ريشَها وَاِنتَفَضَت","وَهيَ مِن نَهضَةٍ قَريبُ",31,"ب",1,0],["فَنفسَكَ فاحفَظها مِنَ الغَيِّ والخَنَى","مَتَى تُغوِها يَغوَ الَّذي بِكَ يَقتَدي",32,"د",2,0],["فَنَفَ فِي شُرُوحِهِ لِمُتُونِ ال","وَحْي مَا رَابَهُ بِغَيْرِ افْتِئَاتِ",33,"ت",1,0],["فنفدّيه وهو يغمد فينا","صارما مدمنا ويستلّ صارم",34,"م",1,0],["فنفت وادّعت كما شاء داع","لبست وجهها وأخفت ضميره",35,"ر",2,0],["فَنَفَّضَتْ رِيشَها ووَلَّتْ","وَهْيَ مِنْ نَهْضَةٍ قَريبُ",36,"ب",1,0],["فنْ فُقدَتْ لم يشعَ الأريبُ","الا ليخبو كلمحِ البَصَر",37,"ر",1,0],["فنفتْهنَّ عن قلوبٍ وقدْ","كُنَّ تبوأْنَ حبها أوطانا",38,"ن",2,0],["فَنَفسَكَ فَاِحفَظها عَنِ الغَيِّ وَالرَدى","مَتى تُغوِها يَغوَ الَّذي بِكَ يَهتَدي",39,"د",2,0],["فنفسك باعدها عن الضيم انها","حياتك فامنع كل ضيم يسومها",40,"م",3,0],["فنفسي بالبشارة إن ترمها","فخذها بالطريف وبالتلاد",41,"د",1,0],["فنفضت عنه الترب حين أقمتُه","وألبستهُ ما لا يدنسهُ وصمُ",42,"م",1,0],["فنَفَّس الدنّ عن صهباءَ صافيةٍ","عن القناديل أَعنتْ والفوانيس",43,"س",1,0],["فنفذ حاجة الأعمى بجهد","وبصّرهُ الطريق المستقيما",44,"م",2,0],["فنفسي بذيَاكَ البُدَيْرِ قَتِيْلةٌ","ولو أنَّها تَحْيا لزَادٍ سَقَامُها",45,"م",3,0],["فنفسي بمسيالِ النُجيد قتيلةٌ","وتحيا بأسبابِ الدُّجى تَتَشَبَّثُ",46,"ث",1,0],["فنفرنا إلى اللقاء خفافاً","لنهين الهوى بعزم الكرام",47,"م",1,0],["فنفى قنوطهم بدعوته ومن","كان الرسول سفيره لا يقنط",48,"ط",1,0],["فنفسُكَ سالت كنفسِ الهَزار","على نغمِ الشَّوقِ والاغتمام",49,"م",1,0],["فنفسي لجسمي كاللّهيبِ لِشَمعةٍ","وكم حلَّ همٌّ مهجةً فأسالها",50,"ل",3,0],["فنفوسُنا في بؤسِها ونعيمِها","تَشتاقُ مِنهنَّ الرِّضا واللّينا",51,"ن",2,0],["فنفسي كلها طربٌ وشوقٌ","لرؤيا بين أنوار الحبيّ",52,"ي",1,0],["فَنَفَّرَ البيضَ بَياضُ الشَيبِ وَال","بيضُ يُعادينَ العِذارَ الأَشيَبا",53,"ب",2,0],["فنفحتْ من الترابِ ريّا","أفعل في النفسِ من الحميّا",54,"ي",2,0],["فنفسك سق مما أحبته بالجفا","الى كل مشكور لدى أهل ايمان",55,"ن",1,0],["فنفسُك وحْدَك إصلاحُها","عليكَ وإنْ فَسَدَ النّاسُ طُرّا",56,"ر",2,0],["فنفَوا بقايا غُمضِهمْ وقَضَوا","فَرْضَ الصّلاةِ وأخلَصوا السِّرّا",57,"ر",2,0],["فَنفَى الخوارجَ عنْوةً عن أرضِها","نَفْياً أقامَ عليِهمُ النُّوّاحا",58,"ح",2,0],["فنفس الفتى إن داومت برَّ ربِّها","تموت وتحيا وهي بالبر تكلف",59,"ف",1,0],["فنفس الفتى تزهو 