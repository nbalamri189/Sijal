ام لا يقبل الطب","https://www.aldiwan.net/poem22816.html","الخفيف"],[46,"عد عن شارب كأس أسكرت","https://www.aldiwan.net/poem22973.html","الرمل"],[46,"خاب الذي سار عن دنياه مرتحلا","https://www.aldiwan.net/poem22981.html","البسيط"],[46,"يتحارب الطبع الذي مزجت به","https://www.aldiwan.net/poem23147.html","الكامل"],[46,"كم تنصح الدنيا ولا نقبل","https://www.aldiwan.net/poem23149.html","السريع"],[46,"لم لا أؤمل رحمة من قادر","https://www.aldiwan.net/poem23247.html","الكامل"],[46,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[19,"طلس العشاء إذا ما جن ليلهم","https://www.aldiwan.net/poem352.html",""],[15,"بان الخليط الؤولى شاقوك إذ شحطوا","https://www.aldiwan.net/poem45261.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85646","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85550","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85568","الكامل"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1149","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20985","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55524","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54893","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55018","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141927","الخفيف"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10367","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[72,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[106,"أدب الوزراء","https://www.poetsgate.com/ViewPoem.aspx?id=179506",""],[106,"تراشق القادة","https://www.poetsgate.com/ViewPoem.aspx?id=179639",""],[106,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[77,"لمن طلل نائي المزار بعيده","https://www.poetsgate.com/ViewPoem.aspx?id=33818",""],[58,"هي حالان شدة ورخاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=10043",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"شباب ضائع","https://www.poetsgate.com/ViewPoem.aspx?id=179161",""],[90,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[91,"ضرة جلق","https://www.poetsgate.com/ViewPoem.aspx?id=53143",""],[91,"تلك المنازل","https://www.poetsgate.com/ViewPoem.aspx?id=53242",""],[51,"يا أخي يا أخا الدماثة والرقة","https://www.poetsgate.com/ViewPoem.aspx?id=25882",""]],"verses":[["وَالفالِقينَ الصُبحَ عَن مَغيرَةٍ","لَها مِنَ النَقعِ ظَلامٌ مُرجَحِن",0,"ن",1,0],["وَالفَتى مَن جَعَلَ الأَم","والَ أَثمانَ المَعالي",1,"ل",2,0],["وَالفَتى ذو الشَبابِ يَبسُطُ في التَق","صيرِ عُذرَ الشَيخِ العَليلِ الضَعيفِ",2,"ف",1,0],["وَأَلفِظُ صَفوَ أَحشاءِ الغَوادي","وَأَجرَعُ رَنقَ أَحشاءِ الثَمادِ",3,"د",1,0],["وَالفَنيقَ الَّذي تَدَرَّعَ طولَ ال","أَرضِ خَوّى بِهِ الرَدى فَأَناخا",4,"خ",2,0],["وَأَلفُظُ غَيرَكُم وَيَسوغُ عِندي","وَدادُكُمُ مَعَ الماءِ الشَروبِ",5,"ب",1,0],["وَالفَحلُ إِن وافَقَت طَروقَتُهُ","أَبدَلَ مِن مُنجِبٍ مَناجيبا",6,"ب",2,0],["وَأَلفاظٌ كَما لَعِبَت شَمالٌ","مَلاعِبَها عَلى الرَوضِ الخَصيبِ",7,"ب",1,0],["وَالفَجرُ في أَثَرِ الظَلا","مِ يَهُزُّهُ العَنَقُ الحَثيثُ",8,"ث",1,0],["وَآلِفَةٍ لِلخِدرِ ظاهِرَةِ التُّقَى","لأُسرَتِها في عامِرٍ ما تَمَنَّتِ",9,"ت",1,1],["وَالفَقْرُ تُطْفَأُ أَنْوارُ الكِرامِ بِهِ","كَما يَقِلُّ وَميضُ السَّيْفِ بِالصَّدَإِ",10,"ا",1,0],["وألَّفَ ما بينَ التَّبَسُّمِ والبُكا","سُلُوٌّ ووَجْدٌ عِيلَ بَينُهُما الصَّبْرُ",11,"ر",1,0],["وَأَلفُ أَلفِ صَلاَةٍ لاَ نَفَادَ لَهَا","مَضرُوبَةٌ فِي ثَمَانِ أَلْفِ تِسْعِينِ",12,"ن",1,0],["والفَلَكُ الدّوّارُ منْ دَوّارِهِ","والنارُ تمْضي حُكْمَهُ ضَرورَهْ",13,"ر",2,0],["وألِفْتُ في شَرَكِ الجُفونِ تخبُّطي","فحَذارِ منْ فِتَنِ العُيونِ حَذارِ",14,"ر",1,0],["وألّفَ أسْرارَ النّفوسِ على الُدَى","فأوْشَكَ منْ وَقدِ الشَّتاتِ خُمودُهُ",15,"د",2,0],["وألّفْتَ بالعَدْلِ بيْنَ القُلوبِ","وفرّقْتَ بينَ الظُّبا والغُمودْ",16,"د",1,0],["وَالفَتى المُحتال فيما نابَهُ","رُبَما ضاقَت عَلَيهِ حِيَلُه",17,"ل",2,0],["وَأَلفَيتُهُ حينَ جَرَّبتُهُ","كَذوبَ الحَديثِ سَؤولاً بَخيلا",18,"ل",2,0],["وَأَلفَيتَنا سِلماً فَصَدَّعتَ بَينَنا","كَما صَدَّعَت بَينَ الأَديمِ خَوالِقُه",19,"ق",2,0],["والفؤاد طاوعها","وهو مكره وجل",20,"ل",1,0],["والفتح ياتيك على عجل","يسوق رؤسهم على العجل",21,"ل",1,0],["والفلك قد أجرا","لها بما تختار",22,"ر",1,0],["والفكر منهكة فباستمراره","تهن العقول وتهزل الأجسام",23,"م",1,0],["والفتى الحرّ له في موته","سعةٌ إن ضاق بالنفس المجال",24,"ل",1,0],["وَأُلفى لِأَعراضِ العَشيرَةِ حافِظ","وَحَقِّهِمِ حَتّى أَكونَ المُسَوَّدا",25,"د",2,0],["وَأَلفَيتُهُ بَحراً كَثيراً فُضولُهُ","جَواداً مَتى يُذكَر لَهُ الخَيرُ يَزدَدِ",26,"د",1,0],["وَالفَقرُ يَزري بِأَقوامٍ ذَوي حَسَبٍ","وَيُقتَدى بِلِئامِ الأَصلِ أَنذالِ",27,"ل",1,0],["والفضل لو سكتَ الورى لاسْتنطقت","غرَرُ الثنا حقباً به وحقائِبا",28,"ب",2,0],["والفاتحينَ بأقلام لهم وطناً","ممالكاً لم يحلها عزم فتاح",29,"ح",1,0],["والفضل في الناسِ كم لذَّت له شيمٌ","وكم عطفت على لهفان لوَّاذ",30,"ذ",1,0],["والفضل واللفظ الرفيع الذي","من دارة البدر انْثنى داره",31,"ر",2,0],["وألفاظٌ بأفضالٍ توالت","علينا أم قلائد في نحور",32,"ر",1,0],["والفاضل الآن عائزٌ لحلىً","كم كنست من حديث مكناس",33,"س",1,0],["والفضل ما بين موروثٍ ومكتسب","فحبذا هو نعتٌ لازم وسم",34,"م",1,0],["والفُؤادُ الذكيُّ للمطرق المُع","رِضِ عينٌ يَرى بها من وراءِ",35,"ا",2,0],["والفارعينَ المجدَ وال","بانينَ فوقهُمُ قِبابهْ",36,"ب",2,0],["والفحلُ يطعَنُ فيهِ غيرَ مُحتشمٍ","ولا مُجِلٍّ مكانَ الشِّعرِ والخطَبِ",37,"ب",1,0],["والفتى المُرتجَى لفصل القَضايا","عند إشكالها وفصلِ الخطابِ",38,"ب",1,0],["وألفى لديه عِفّةً وأمانةً","وإحداهما يكفي امرَأً من ثِقاتِهِ",39,"ت",2,0],["والفلْجُ للحقِّ والمُدْلي بحجَّتِهِ","إذا الخصيم هناكم للخصيم جَثَا",40,"ث",2,0],["وأُلِّفَتْ في ذراه","من العلا كل فَرْدَهْ",41,"د",2,0],["وألفيتُمُ المرْعى كثيراً أُسُودُهُ","فأَنصفتُمُ خِرْفانه من أسودِهِ",42,"د",2,0],["والفتى مُلْبسٌ من الأمر يسعى","فيه برداً مُقَلَّدٌ منه عِقْدا",43,"د",2,0],["والفسق إن قَحَّبت جِهارٌ","والصوت إن كَرَّعت سريره",44,"ر",2,0],["والفلس رب يخر الساجدون له","والشعر منصرف عنه ومصروف",45,"ف",1,0],["والفتى الأوسع صدراً","يفضل الأوسع خلقا",46,"ق",2,0],["والفضلُ من كفيك مشتركٌ","لكنّ فضلك غيرُ مُشتركِ",47,"ك",1,0],["والفَتى الحازِمُ الحصين حصوناً","مَنْ تُلاقيهِ والأيادي حصونه",48,"ن",2,0],["والفتكُ إلقاءُ الدروعِ بأسْرها","والحزمُ تعليةُ الدروعِ جواشنا",49,"ن",2,0],["وَالفَتى العَبقَرِيُّ يولَدُ إِذ يولَدُ","في مَهدِه وَيَومَ مَماتِه",50,"ت",2,0],["وَالفَحمُ لَيسَ يُضيءُ إِن لَم يَضطَرِم","وَالنَدُّ لَيسَ يَضوعُ إِن لَم يُحرَقِ",51,"ق",1,0],["وَالفُلكُ جارِيَةٌ تَشُقُّ عُبابَهُ","شَقّاً كَما تَفري رِداءً أَخلَقا",52,"ق",2,0],["وَالفَجرُ يَرقُصُ في السُهولِ وَفي الذَرى","مُتَمَهِّلاً فَتَهَشُّ بَعدَ وُجومِها",53,"م",3,0],["وَالفَجرُ مِلءُ جُيوبِهِ أَرَجٌ","وَالطَيرُ يَملَءُ شَدوُها الوُكُنا",54,"ن",2,0],["وَالفَراشاتِ وَثبَةً وَسُكوناً","وَالعَصافيرِ بَل أَلَذُ نَجِيّا",55,"ي",2,0],["وَآلَفَ وَجهَ الأَرضِ عِندَ افتِراشِها","بِأَهدَأ تُنبيهِ سَناسِنُ قُحَّلُ",56,"ل",1,0],["وَإِلفُ هُمومٍ ما تَزالُ تَعودُهُ","عِياداً كَحُمّى الرَبعِ أَو هِيَ أَثقَلُ",56,"ل",1,0],["وَإِلفٍ صَبَرتُ النَفسَ عَنهُ وَقَد أَرى","غَداةَ فِراقِ الحَيِّ أَلّا تَلاقِيا",57,"ي",2,0],["والفَراشُ الجميلُ رَفْرَفَ في الرَّوْضِ","يناجي زهورَهُ المطلولهْ",58,"ه",1,0],["والفن للروح العصي مروض","والفن للطبع الغليظ ملطف",59,"ف",1,0],["والفراش الذي يطو","ف جميلا على الزهر",60,"ر",1,0],["والفرق بينهما في كل ناحية","باد اذا نظرت تستشرف المقل",61,"ل",1,0],["والفن لا يبنى اذا","اختلف الزمان على وتيره",62,"ر",2,0],["وألفيت في نفسي العزاء كمعبدٍ","قد انهد منه جانب ثم جانب",63,"ب",1,0],["والفيت قسماً قد تداعى جداره","وقسماً على ما كان من قبل باقيا",64,"ي",2,0],["والفطر والأضحى كعادتيهما","يتردّيان بشاشة الأعياد",65,"د",1,0],["والفلك يرقص والرياح عوازف","والليل ليل والعباب مثار",66,"ر",1,0],["وَالفُرسُ وَالتُركُ جَميعاً شِيعَةٌ","لَهُم يَرونَ حُبَّهُم رَأس التُقى",67,"ا",1,0],["وَالفَنُّ رَيحانُ المُلوكِ وَرُبَّما","خَلَدوا عَلى جَنَباتِهِ أَسماءَ",68,"ا",2,0],["وَأَلَّفوا بَعدَ اِنفِراطٍ عِقدَها","وَجَعَلوا صَحراءَ ليبيا حَدَّها",69,"د",3,0],["وَالفَتحُ بَغيٌ لا يُهَوِّنُ وَقعَهُ","إِلّا العَفيفُ حُسامُهُ المُتَرَفِّقُ",70,"ق",1,0],["وَالفُلكُ في ظِلِّ البُيوتِ مَواخِراً","تَطوي الجَداوِلَ نَحوَها وَالأَنهُرا",71,"ر",2,0],["وَالفُلكُ مُشرِقَةُ الجَوانِبِ في الدُجى","يَبدو لَها ذَيلٌ مِنَ الأَنوارِ",72,"ر",1,0],["وَالفَردُ يُؤمَنُ شَرُّهُ في قَبرِهِ","كَالسَيفِ نامَ الشَرُّ خَلفَ قِرابِهِ",73,"ب",2,0],["والفَيْلقُ الجَرّارُ بينَ يديهِ من","سطواتِ بأسِكَ فيلَقٌ جَرَّارُ",74,"ر",1,0],["وَالفَتى مَن رَأى القُبورَ لِما طا","فَ بِهِ مِن بَناتِهِ أَكفاءَ",75,"ا",2,0],["وَأَلفَيتُ القَوافي كَالأَواخي","ضَمَنَّ غَوابِرَ الشَرَفِ التَليدِ",76,"د",1,0],["وَالفَتى مَن إِذا تَزَيَّدَ خَطبٌ","أَشرَقَت راحَتاهُ وَاِهتَزَّ عودُه",77,"د",2,0],["وَالفاضِلاتُ ضَرائِباً وَخَلائِقاً","لِلفاضِلينَ مَناسِباً وَمَحاتِدا",78,"د",2,0],["وَالفَسلُ يَسلُبُهُ عَزيمَتَهُ","أَدنى وُجودِ كِفايَةٍ تَسَعُه",79,"ع",2,0],["وَأَلفانِ ما يَنفَكُّ يَدنو مَداهُما","فَمِن مالِهِ أَلفٌ وَمِن جاهِهِ أَلفُ",80,"ف",1,0],["وَالفَتى كادِحٌ لِفِعلَةِ دَهرٍ","يَرتَضيها أَو عيشَةٍ مَملولَه",81,"ل",2,0],["وَالفَخرُ فَهوَ اِثنانِ أَحرَزَ واحِداً","أَخوالُهُ وَالآخَرَ الأَعمامُ",82,"م",1,0],["وَآلِفَةٍ بَردَ الحِجالِ اِحتَوَيتُها","وَقَد نامَ مَن يَخشى عَلَيها وَأَسحَرا",83,"ر",2,1],["وَالفَحلُ عَلقَمَةُ الَّذي كانَت لَهُ","حُلَلُ المُلوكِ كَلامُهُ لا يُنحَلُ",84,"ل",1,0],["والفَجرُ مَصقولُ الرِّداءِ كأنَّه","جِلبابُ خُوْدٍ أشبَعَتْهُ خَلُوقا",85,"ق",2,0],["والفجرُ كالراهبِ قد مُزِّقَتْ","من طَرَبٍ عنه الجلابيبُ",86,"ب",1,0],["وألفاظٍ له عَذُبَتْ فأغَنتْ","غِناءَ الرَّاحِ بالنُّطَفِ العِذابِ",87,"ب",1,0],["وَالفَقرُ شَينٌ لِلرِجالِ فَإِنَّهُ","يُزري بِهِ الشَهمُ الأَديبُ الأَنسَبُ",88,"ب",1,0],["وَالفَتى الحاذِقُ الأَريبُ إِذا ما","خانَهُ الدَهرُ لَم يَخُنهُ عَزاءُ",89,"ا",2,0],["وَالفِعلُ مَنسوبٌ إِلى أَهلِهِ","كَلشَيءِ تَدعوهُ بِأَسمائِهِ",90,"ا",3,0],["وَالفَقرُ ذُلٌّ عَلَيهِ بابٌ","مِفتاحُهُ العَجزُ وَالتَواني",91,"ي",1,0],["وَالفُلكُ فَوقَ لُجِّهِ كَأَنَّها","عَقارِبٌ تَدُبُّ فَوقَ مِبرَدِ",92,"د",1,0],["وَأَلَّفتَ شَملَ المُلكِ بَعدَ شَتاتِهِ","وَقَد صاحَ فيهِ بِالتَفَرُّقِ صائِحُ",93,"ح",1,0],["والفنُّ ما حاكى الطبيعةَ آخذاً","منها ومن إعجازها بغرارِ",94,"ر",1,0],["وألَّفَ اللَّهُ في الأوطانِ شَملهُمُ","فنُظّموا في المغاني بعدما نُثروا",95,"ر",3,0],["والفتحُ من فَضْلِ الإله ويومُهُ","مُتَقدّمٌ بِالنَّصرِ أو مُتأخِّرُ",96,"ر",1,0],["والفَنشُ يَحصِبُ ناظريه وقلبَهُ","بقوارعِ الأحزانِ يوْمٌ مُعْوِرُ",96,"ر",1,0],["وألفيتُ الجليسَ على خلافي","فلسْتُ مجالِساً إلّا كِتابَا",97,"ب",2,0],["وَالفَتى مَن تَعَرَّقَتهُ اللَيالي","وَالفَيافي كَالحَيَّةِ النَضناضِ",98,"ض",1,0],["وَالْفَخْرُ بِالآبَاءِ لَيْسَ بِنَافِعٍ","إِنْ كَانَتْ الأَبْنَاءُ خُورَ الأَعْظُمِ",99,"م",1,0],["وَالفَجرُ يَنظُرُ مِن وَراءِ غَمامَةٍ","عَن مُقلَةٍ كُحِلَت بِها زَرقاءِ",100,"ا",2,0],["وَأَلَّفَ أَشتاتَ الفَضائِلِ أَروَعٌ","وَقامَ بِأَعباءِ المَكارِمِ أَيِّدُ",101,"د",1,0],["وَالفَضلُ يَأبى أَن تَفوتَ لُبانَةٌ","وَأَبو مُدافِعٍ الشَفيعُ الأَكرَمُ",102,"م",1,0],["وَالفِطرُ قَد وافاكَ يُعلِنُ بِالرِضى","فَالصَحوُ فيهِ تَبَسُّمٌ مَقصودُ",103,"د",1,0],["وَالفَجرُ يَكتُبُ في صَحيفَةِ أُفقِهِ","أَلِفاً مَحَت نورَ الهِلالِ المُذهَبا",104,"ب",2,0],["وألف جوازٍ ثم ألف وسيلةٍ","لتسهيل ما يلقونه من مصاعبِ",105,"ب",1,0],["وَالفِتيَةُ الشُعثُ قَد خَفَّت حَقائِبُهُم","شُمُّ العَرانَينِ قَد ساروا إِلى الأُصُلِ",106,"ل",1,0],["وَالفَضلُ مَحرومٌ يَرى ما يَرى","كَما يَرى الوارِثُ عَينَ المَريض",107,"ض",1,0],["وَالفضلُ ليسَ يَنالُهُ مُتَوَسِّلٌ","بِتَوَرُّعٍ حَرِجٍ وَلا بِتَزَهُّدِ",108,"د",1,0],["وَالفَوْزُ فِي أَمَّةٍ ضَوْءُ الوُضوءِ لها","قَدْ زانَهَا غُرَرٌ منه وَتحْجِيلُ",109,"ل",1,0],["والفَتْكُ فَتْكٌ في صميمِ المالِ لا","ما حدّثوا عن عُرْوَةَ الصُّعْلوك",110,"ك",1,0],["والفَرْعُ مَردودٌ إلى أصْلِهِ","كالسيْفِ مَردودٌ إلى العِتْق",111,"ق",1,0],["والفجرُ من تلك المُلاءةِ ساحِبٌ","والليلُ في مُنقَدِّ تلك الأقمُص",112,"ص",1,0],["والفرقُ بين الوَرَى جمْعاً وبينَهُمُ","كالفرْقِ ما بينَ مَعدومٍ وموجود",113,"د",1,0],["والفُلْكُ والفَلَكُ المُدارُ وسعدُهُ","والغَزْوُ في الدّأماءِ والدّأماء",114,"ا",2,0],["وَالفَمُ مِن ضيقِهِ إِذا اِبتَسَمَت","كَأَنَّهُ قَصعَةُ المَساكينِ",115,"ن",1,0],["وَالفَتى الأَرقَطِ يَحيى","وَعُبَيدِ العاشِقينِ",116,"ن",1,0],["وَالفَضلُ عِندَ اِبنِ عَبّاسٍ تُعَدُّ لَهُ","في دَعوَةِ الدينِ آثارٌ وَمُحتَسَبُ",117,"ب",1,0],["وَالفَتى كَاِسمِهِ المُصَرِّفِ هَذا ال","جِسمِ يَلقى التَغييرَ وَالتَقليبا",118,"ب",2,0],["وَأُلفِيا عُنصُرَي زَمانٍ","لَيسَ لِأَسرارِهِ ظُهورُ",119,"ر",1,0],["وَالفَقرُ مَوتٌ غَيرَ أَنَّ حَليفَهُ","يُرجى لَهُ بِتَمَوُّلٍ إِنشارُ",120,"ر",1,0],["وَالفَتى وَالرَدى كَراكِبِ لُجٍّ","إِنَّما نَفسُهُ مِنَ المَوتِ فِترُ",121,"ر",1,0],["وَالفَتى غَيرُ آمِنٍ مِن أَذى الدَه","رِ وَلَو كانَ شَخصُهُ البِرجيسا",122,"س",2,0],["وَالفَتى ساعٍ لِأَقصى أَمَلٍ","لَم يَزَل يَطلُبُهُ حَتّى بَلَغ",123,"غ",1,0],["وَالفَقرُ أَحمَدُ مِن مالٍ تُبَذِّرُهُ","إِنَّ اِفتِقارَكَ مَأمونٌ بِهِ السَرَفُ",124,"ف",1,0],["وَالفَقرُ بَكرٌ تَرتَقيهِ شَذاتُهُ","وَاليُسرُ عَودٌ ما تَسَوَّرَ عَلُّهُ",125,"ل",2,0],["وَالفَذُّ يَكفيكَ إِذا فاتَكَ الرَ","قيبُ وَالنافِسُ وَالمُسبِلُ",126,"ل",1,0],["وَالفَقرُ أَروَحُ في الحَياةِ مِنَ الغِنى","وَالمَوتُ يَجعَلُ خائِلاً كَمُخَوَّلِ",127,"ل",1,0],["والفَتَى ظاعِنٌ ويَكفيهِ ظِلُّ السْ","سَدْرِ ضَرْبَ الأطْنابِ والأوْتادِ",128,"د",1,0],["وَالفارِسِيَّةُ فيهِم غَيرُ مُنكَرَةٍ","فَكُلُّهُم لِأَبيهِ ضَيزَنٌ سَلِفُ",129,"ف",1,0],["وَالفارِجو الكَربِ وَالغُمّى بِرَأيِهِمُ","إِذا تَشابَهَتِ الأَهواءُ وَالصُرُطُ",130,"ط",1,0],["وَألفت نعيماً وَالخَيال مصور","لَها واقفاً من حيث لا تَتَوقَّع",131,"ع",1,0],["وَالفَرق أن لَيسَ الشكاة من الأذى","فيه تباح كَما بمصر تباح",132,"ح",1,0],["وَالفضل أَجمعه لمن هو سابق","والخزيُ كلُّ الخزي للمسبوق",133,"ق",1,0],["والفرع منها في العرا","ق ومصر يسمو والشآم",134,"م",1,0],["وَالفَضلُ إِن شَمِلَ الإِظلامُ ساحَتَها","مِصباحُها المُتَجَلّي مِن مَصابِحِها",135,"ح",3,0],["والفكرُ صحوٌ والجبينُ شُعاعَةٌ","ألَّاقةٌ والروحُ في إِيقادِ",136,"د",1,0],["والفَقيرُ الوَقيرُ مَنْ هُوَ مُخْتا","رٌ عليها مِن السّوامِ وَقيرا",137,"ر",2,0],["وَأَلفَيتُ تَيماً لَم أَجِد حَسَباً لَهُم","وَعَدَّدتُ سَعداً وَالقَبائِلَ مِن عَمروِ",138,"ر",2,0],["وآلفُ ألخُطَّةَ ألُضمَّنَةَ أل","خَيرِ إذ بَعُضُهم مُجانِبُها",139,"ب",3,0],["وَالفُلْكُ فِي شَتَّى مَجَالاَتِهَا","رَوَائِحٌ تُلْقِي شِبَاكاً عوَادْ",140,"د",1,0],["والْفَخْرُ فِي رَايَاتِهِ مُتَمَثِّلٌ","وَطَلاَئِعُ الْعُقْبَانِ فِي تَرْدَادِ",141,"د",1,0],["وَالْفَوْزُ فِي كُلِّ حَالٍ","خَطِيرَةٍ ظَلَّ حِلْفَهْ",142,"ف",2,0],["وَالفَنُّ يَأْبَى أَنْ تُفَ","رِّقَهُ المَوَاطِنُ وَالشُّعُوبُ",143,"ب",1,0],["وأَلْفاظٌ تَنُمُّ عنِ السَّجَايَا","كَما نَمَّ النَّسِيمُ عَنِ العبِيرِ",144,"ر",1,0],["وَالفُصُحُ المُنْتَقَاةُ تُمْلِي","بَيَانَكَ النَّاصِعَ الرَّفِيعَا",145,"ع",2,0],["وَالفَنُّ يَسْتَنْزِفُ الدَّمْ","عَ حُرْقَةً وَاسْتِياءَ",146,"ا",2,0],["والفراشات ملت الزهر لما","حدثتها الأنسام عن شفتيك",147,"ك",1,0],["وَأُلفى لِأَعراضِ العَشيرَةِ حافِظاً","وَحَقِّهِمِ حَتّى أَكونَ المُسَوَّدا",148,"د",2,0],["والفَتَى في الْحَياةِ رهْنُ عَوَادٍ","لا يَرَى دُونَ مُلْتَقَاهُن بُدّا",149,"د",2,0],["والفرق فيه قد بان","مثل الهدى في الطغيان",150,"ن",1,0],["والفكر إن ساس الأمورَ رجاله","كانت بأيديهم أسدَّ وأحكما",151,"م",2,0],["والفُلكُ تحت رحمة الأقْدارِ","بين الرياح الهُوج والتَّيَّارِ",152,"ر",1,0],["والفنُّ يطلب راهبًا متفرِّغًا","ووددتُّ أني كنت من رُهَّابه",153,"ب",2,0],["وألف أسرار النفوس على الهوى","فأوشك من وقد الشتات خموده",154,"د",2,0],["والفتى الحاذق الاديب اذا ما","خَانَهُ الدَّهْرُ لَمْ يَخُنْهُ عَزَاْءُ",155,"ا",2,0],["والفَصلُُ ، دونَ الفَصلِ ، يُنْعشُهُ","والأرضُ ، دون الأرض ، تُسعِده",156,"د",2,0],["وألَّفَ بين الضدِ والضدِ مغنمٌ","وفرَّقَتِ الاطماعُ بين النظائر",157,"ر",1,0],["والفاتحاتِ على الخلودِ نوافذاً","والمجرياتِ مع الحياة روافدا",158,"د",2,0],["والفتى ما استطاعَ مُندفِعٌ نحو","الصباباتِ والفتاةُ لَعوب",159,"ب",1,0],["والفجرُ لو لم يلُذْ بالصبح يَشربه","من المطايا ظِماءً شُرَّعاً شُربا",160,"ب",2,0],["والفاتلونَ عثانيناً مُهرّأةً","ساءتْ لمحتطِبٍ مَرعى ومحتطَبا",160,"ب",2,0],["والفجرُ ينصُرُ لا محالةَ \" ديكَهُ \"","ويُطيرُ من ليلٍ \" غراباً \" ناعبا !",161,"ب",2,0],["وألفيتُني في كلِّ خطبٍ يَنُوبُه","أُدافعُ عنه ما استطعتُ دِفاعا",162,"ع",2,0],["وألْفَيتُني إذ علَّ قومٌ وأنهلوا","حريصاً على سُؤرِ الحياةِ المُنازَع",163,"ع",1,0],["والفحم ليس يضيء إن لم يضطرم","والّد ليس يضوع إن لم يحرق",164,"ق",1,0],["والفجر يرقص في السهول وفي الذرى","متمهّلا فتهشّ بعد وجوهما",165,"م",2,0],["والفؤاد الذكيّ للمطرق المعرض","رض عينٌ يرَى بهامن وراء",166,"ا",2,0]]}