{"poems":[[55,"تواعد ذا الخليط لأن يبينا","https://www.aldiwan.net/poem29647.html","الوافر"],[55,"أقول لها بين الغديرين والنقا","https://www.aldiwan.net/poem29961.html","الطويل"],[55,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[95,"ما عين فيجتها وصافي مائها","https://www.aldiwan.net/poem11154.html","الكامل"],[95,"يا من لها شرف الأصالة","https://www.aldiwan.net/poem11458.html","مجزوء الكامل"],[32,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[90,"إذا ما الفتى في دهره أحسن الظنا","https://www.aldiwan.net/poem45043.html","الطويل"],[29,"أراح الحي من إرم الطراد","https://www.aldiwan.net/poem5709.html","الوافر"],[29,"كاد مجيب الخبث تلقى يمينه","https://www.aldiwan.net/poem5964.html","الطويل"],[74,"كمال الدين عشت لنا ملاذا","https://www.aldiwan.net/poem20210.html","الوافر"],[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[53,"قل للأمير أدام الله غبطته","https://www.aldiwan.net/poem10869.html","البسيط"],[53,"وقع الفراق وما يزال يروعني","https://www.aldiwan.net/poem65389.html","الكامل"],[53,"رثت الأمانة للخيانة إذ رأت","https://www.aldiwan.net/poem66725.html","الكامل"],[31,"عفا واسط من آل رضوى فنبتل","https://www.aldiwan.net/poem6022.html","الطويل"],[31,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[31,"صرمت أمامة حبلها ورعوم","https://www.aldiwan.net/poem6063.html","الكامل"],[93,"في ذلك الروض الأغن بدى فتى","https://www.aldiwan.net/poem8735.html","عموديه"],[93,"وقعت نحلة على الأقحوان","https://www.aldiwan.net/poem8795.html","عموديه"],[93,"قالت سكت وما سكت سدى","https://www.aldiwan.net/poem8813.html","عموديه"],[93,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[93,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[40,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[87,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[87,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[87,"أنا من بدل بالكتب الصحابا","https://www.aldiwan.net/poem63724.html","الكامل"],[45,"في الخد أن عزم الخليط رحيلا","https://www.aldiwan.net/poem10125.html","الكامل"],[47,"أصبا الأصائل إن برقة منشد","https://www.aldiwan.net/poem63446.html","الكامل"],[30,"لعمري لقد أوفى وزاد وفاؤه","https://www.aldiwan.net/poem1239.html",""],[30,"ألم يك جهلاً بعد سبعين حجة","https://www.aldiwan.net/poem1285.html",""],[63,"لحظ عينيك للردى أنصار","https://www.aldiwan.net/poem51681.html","الخفيف"],[82,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[82,"أيا رشاقة غصن البان ما هصرك","https://www.aldiwan.net/poem31444.html","البسيط"],[46,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[71,"قال عذولي كف عن","https://www.aldiwan.net/poem28680.html","مجزوء الرجز"],[92,"نامي جياع الشعب نامي","https://www.aldiwan.net/poem59037.html","عموديه"],[107,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[104,"كفكف دموعك ليس ينفعك","https://www.aldiwan.net/poem33114.html","مجزوء الكامل"],[41,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[22,"وقعت بعبس ثم أنعمت فيهم","https://www.aldiwan.net/poem21696.html","الطويل"],[69,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[77,"فتكات طرفك أم سيوف أبيك","https://www.aldiwan.net/poem69051.html","الكامل"],[52,"نأتك على طول التجاور زينب","https://www.aldiwan.net/poem64821.html","الطويل"],[48,"وقعنا في الحياة بلا اختيار","https://www.aldiwan.net/poem22882.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62294","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42569","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54634","الكامل"],[22,"وقعتَ بعبسٍ ثمّ أنعمتَ فيهمُ","https://www.poetsgate.com/ViewPoem.aspx?id=19765",""],[102,"المنتحر","https://www.poetsgate.com/ViewPoem.aspx?id=50189",""],[102,"الآتون .. من الأزمة","https://www.poetsgate.com/ViewPoem.aspx?id=50340",""],[92,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[92,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[92,"الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=179088",""],[93,"لمن الديار؟","https://www.poetsgate.com/ViewPoem.aspx?id=53211",""],[90,"أطلَّ صباح العيد في الشرق يسمع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19511&r=&rc=14",""],[132,"أنت يا مقلتي أسقمت حالي","https://www.aldiwan.net/poem50549.html","الخفيف"],[132,"سير لهم طابت فما خبثت","https://www.aldiwan.net/poem50616.html","أحذ الكامل"],[164,"لك خارقات عوائد لن تعرفا","https://www.aldiwan.net/poem58902.html","الكامل"],[164,"غدرت فيا باني الغزال الغادر","https://www.aldiwan.net/poem58938.html","الكامل"],[164,"انجزت في الأعداء ميعاد المنى","https://www.aldiwan.net/poem59087.html","الكامل"],[173,"بالسيف يفتح كل باب مقفل","https://www.aldiwan.net/poem1657.html",""],[189,"قل للذي فارق الشبابا","https://www.aldiwan.net/poem14097.html","مخلع البسيط"],[189,"يا راغبا في غنى وكنز","https://www.aldiwan.net/poem14550.html","مخلع البسيط"],[210,"لقد الجأتني دائرات الدوائر","https://www.aldiwan.net/poem922.html",""],[214,"بقوامه والطلعة الغراء","https://www.aldiwan.net/poem13313.html","الكامل"],[214,"خل من لام وفيه نصحا","https://www.aldiwan.net/poem13352.html","الرمل"],[239,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[260,"كأنما باب استها","https://www.aldiwan.net/poem48363.html","مجزوء الرجز"],[313,"وقعنا في الخطايا والبلايا","https://www.aldiwan.net/poem50229.html","الوافر"],[324,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[341,"ألا ناديا أظعان ليلى تعرج","https://www.aldiwan.net/poem45434.html","الطويل"],[368,"وقع رعاك الله من ملك","https://www.aldiwan.net/poem60883.html","السريع"],[370,"روحات وصلتها بابتكار","https://www.aldiwan.net/poem17775.html","الخفيف"],[381,"من ذا ابن رعد وهو ليس بصاعقه","https://www.aldiwan.net/poem59317.html","الكامل"],[384,"أيد الله أسعد الوزراء","https://www.aldiwan.net/poem48764.html","الخفيف"],[395,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[409,"صح بالحاكم ما أو","https://www.aldiwan.net/poem49460.html","مجزوء الرمل"],[413,"أبني السرى والبيد لا","https://www.aldiwan.net/poem32254.html","مجزوء الكامل"],[414,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[420,"علموا يا سعد جيران الغضا","https://www.aldiwan.net/poem53837.html","الرمل"],[420,"يا ليلة في آخر الشهر","https://www.aldiwan.net/poem54175.html","أحذ الكامل"],[436,"الى الحظ الجليل تتوق نفسي","https://www.aldiwan.net/poem12648.html","الوافر"],[455,"لله يوم في طلائعه لنا","https://www.aldiwan.net/poem13845.html","مجزوء الكامل"],[461,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[461,"رحِمت قوما وما مالت رقابهم","https://www.aldiwan.net/poem55985.html","البسيط"],[471,"وقع الحريق بموضع لم أسمه","https://www.aldiwan.net/poem60396.html","الكامل"],[480,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[517,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[518,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[518,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[530,"كتابي أبا نصر إليك وحالتي","https://www.aldiwan.net/poem46019.html","الطويل"],[532,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[543,"وقعقعت القداح ففزت منها","https://www.aldiwan.net/poem56865.html","الوافر"],[554,"لك الليل بعد الذاهبين طويلا","https://www.aldiwan.net/poem47299.html","الطويل"],[556,"وقعدت أرتقب الفناء كراكب","https://www.aldiwan.net/poem68254.html","الكامل"],[561,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[589,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"],[589,"لم أنسه لما أتى مقبلا","https://www.aldiwan.net/poem17846.html","السريع"]],"verses":[["وَقَعنَ بِغارَةٍ وَطَلَبنَ أُخرى","يُماطِلنَ الإِقامَةَ وَالصُفونا",0,"ن",2,0],["وَقَعتُ بِها في أَوَّلِ الفَجرِ وَقعَةً","غِشاشاً كَما أَقضى أَلِيَّةَ حالِفِ",1,"ف",1,0],["وَقَعَت مَوقِعَ العَوانِ مِنَ الدَه","رِ وَإِن كانَتِ الرَزِيَّةُ بِكرا",2,"ر",2,0],["وَقَعَاتُ أَبْطَالٍ يَصُولُ عَلَى العِدَى","فِيهَا أُبَاةُ الضَّيْمِ مِنْ أَبْنَائِهَا",3,"ا",3,0],["وَقَعَتْ إِلَيْكَ صَحِيفَةٌ","سَنْتِيسُ خَطٍّ بِهَا مِثَالِي",4,"ل",2,0],["وَقَعنَ اِثنَتَينِ وَاِثنَتَينِ وَفَردَةً","حَريداً هِيَ الوُسطى بِصَحراءَ حائِرِ",5,"ر",1,0],["وقعت بأعباء السياسة ناهضاً","يهمّة لاوانٍ ولا ناكصٍ جبنا",6,"ن",2,0],["وَقَعنَ جَوانِحاً في ظِلِّ لَيلٍ","عَلى مَطوِيَّةٍ وَالصُبحُ بادي",7,"د",2,0],["وَقَعتَ بِأَيدي المُحرِزِيِّينَ وَقعَةً","نَهَت باسِلاً عَنّا وَأَصحابَ باسِلِ",8,"ل",1,0],["وقعت على الجواد وأنتَ غيث","وقمت مسلماً خصب الجنان",9,"ن",1,0],["وَقَع اسْمٌ من السلامة والسِّل","مِ عليه وُقُوعَ لا مَقْصُودِ",10,"د",1,0],["وقْعُ الكرُاعِ ولمْعُ البيض يوقِدُهُ","لألاءُ وجهك فيه أيَّ إيقادِ",11,"د",1,0],["وقع الفراق وما يزال يروعني","فكأن واقع شره متوقعُ",12,"ع",1,1],["وقعتْ قوارعُ دهرِه بصَفاتِه","فتعلّلتْ عن مَصْدَقٍ سَهْلِيِّ",13,"ل",2,0],["وَقَعنَ وُقوعَ الطَيرِ فيها وَما بِها","سِوى جِرَّةٍ يَرجِعنَها مُتَعَلَّلُ",14,"ل",1,0],["وَقَعنَ أُصلاً وَعُجنا مِن نَجائِبِنا","وَقَد تُحُيِّنَ مِن ذي حاجَةٍ سَفَرُ",15,"ر",1,0],["وَقَعوا وَقَد طالَت سُراهُم وَقعَةً","فَهُمُ إِلى رُكَبِ المَطِيِّ جُثومُ",16,"م",1,0],["وَقَعَت غَدائِرُها عَلى أَقدامِها","فَكَأَنَّها قَد عَضَّها نابُ الهَوى",17,"ا",1,0],["وَقَعَت نَحلَةٌ عَلى الأُقحُوانِ","فَإِذا في القَفيرِ شُهدُ",18,"د",1,1],["وَقعُ الخُطوبِ عَلَيَّ أَخرَسَني","وَكَذا العَواصِفُ تُسكِتُ الغَرِدا",19,"د",2,0],["وَقَعَ الَّذي كُنّا نَخافُ وُقوعَهُ","فَعَلى المَنازِلِ وَحشَةٌ لا تَرحَلُ",20,"ل",1,0],["وَقَعَ الأَمرُ الَّذي لا يُدفَعُ","وَجَنى الجاني عَلى تِلكَ الرُبوع",21,"ع",1,0],["وَقَعَ الرَبيعُ وَقَد تَقارَبَ خَطوُهُ","وَرَأى بِعَقوَتِهِ أَزَلَّ نَسولا",22,"ل",2,0],["وَقَعَ الرُسلُ عَلَيهِ وَاِلتَوَت","أَرجُلُ الأَحرارِ فيهِ فَعَفاها",23,"ا",3,0],["وَقَعَت ناحِيَةً فَاِحتَرَقَت","مِثلَ قُرصِ الشَمسِ بِالأُفقِ اِضطِراما",24,"م",2,0],["وَقعَةُ الأَهرامِ جَلَّت مَوقِعاً","وَتَعالَت في المَغازي أَن تُرابا",25,"ب",2,0],["وَقَعَت عَلى الأُردُنِّ مِنهُ بَلِيَّةٌ","نُضِدَت بِها هامُ الرِفاقِ تُلولا",26,"ل",2,0],["وَقَعَدتُ عَنكَ وَلَو بِمُهجَةِ آخَر","غَيري أَقومُ إِلَيهِمُ لَم أَقعُدِ",27,"د",1,0],["وَقَعنَ وَقَد صاحَ العَصافيرُ إِذ بَدا","تَباشيرُ مَعروفٍ مِنَ الصُبحِ مُغرَبِ",28,"ب",1,0],["وَقَعتُم بِصُفرَيِّ الخَضارِمِ وَقعَةً","فَجَلَّلتُموها عارَها لَيسَ يَذهَبُ",29,"ب",1,0],["وَقعةٌ باللِّوى استباحَتْ نُفوساً","قَمَرَتْها غَرَّاءَها الأقمارُ",30,"ر",1,0],["وَقَعتْ لَحظَةٌ على القَلبِ منها","أَفلا يَترُك الحَشا ويَطيرُ",31,"ر",1,0],["وَقَعتُ في الدَّمعِ إِذ أُغْرِقتِ في لُجَجٍ","قَد كادَ يَغمِرُني مِنهُ الَّذي غَمَرَك",32,"ك",1,0],["وَقعَةٌ زَعزَعَت مَدينَةَ قُسطَن","طينَ حَتّى اِرتَجَّت بِسورِ فُروقِ",33,"ق",1,0],["وقعتُ في عينِ الخطا","فقلتُ في عينِ الخطا",34,"ط",2,0],["وَقَعي على البلوى كما","وَقَعَ “الحُسامُ” على الحُسامِ",35,"م",1,0],["وَقَعَ الطّائِرُ المُسِفُّ على النَّس","رِ الذي يملأُ السماواتِ عَزْما",36,"م",2,0],["وقعدتَ مكتوفَ اليديْ","ن تقولُ حاربني الزَّمنْ",37,"ن",1,0],["وَقَعنَ اِثنَتَين واِثنَتَينِ وَفَردَةً","يُبادِرنَ تَغليساً سِمالَ المَداهِنِ",38,"ن",1,0],["وَقَعتَ بِعَبسٍ ثُمَّ أَنعَمتَ فيهِمُ","وَمِن آلِ بَدرٍ قَد أَصَبتَ الأَكابِرا",39,"ر",2,1],["وَقعاتٌ تُنْسي المُؤرِّخَ ما كا","نَ مِنْ سُنْبسٍ وَمِنْ زُنَّارَهْ",40,"ر",2,0],["وَقَعتُ بَينَ يَدَيْهِ مِنْ مَهابَتِهِ","وقالتِ الناسُ مَيْتٌ مَسَّهُ كِبَرُ",41,"ر",1,0],["وقعاتُ نَصرٍ في الأعادي حدّثَتْ","عن يوم بدرٍ قَبْلها وتَبوك",42,"ك",1,0],["وَقَعنَ فَريصاتِ السَديسِ كَما دَعا","عَلى فَنَنٍ مِن ضالَةِ الأَيكِ أَخطَبُ",43,"ب",1,0],["وَقَعنا في الحَياةِ بِلا اِختِيارٍ","وَخالِقُنا يُعَجِّلُ بِالخَلاصِ",44,"ص",1,1],["وقُعُودِي عِنْدَ ذِي غَادِيَةٍ","تَقْذِفُ الأَعْدَاءَ عَنِّي بِالكَلِمْ",45,"م",1,0],["وقعدوا ناحية كمينا","ليغدروا في داره الأمينا",46,"ن",2,0],["وَقَعُوا بَيْنَ رِيفِهَا وَقُرَاهَا","بِضُرُوبِ الْفَسَادِ وَقْعَ الجَرَادِ",47,"د",1,0],["وَقَعَتْ نِهَايَةُ دَائكَ المُنْتَابِ","وَقْعَ الفُجَاءَةِ فِي انْقِضَاضِ شِهَابِ",48,"ب",1,1],["وقعتَ بعبسٍ ثمّ أنعمتَ فيهمُ","ومِنْ آلِ بَكْرٍ قَدْ أَصَبْتَ الأَكَابِرا",49,"ر",2,1],["وقع المتعب الكئيب على الموت","فماذا جرى وكيف وقوعه ؟",50,"ع",2,0],["وقّعوا مشروع تقنين الهوى","بالبطاقات ، لكلّ العاشقين",51,"ن",1,0],["وقَّعْتُ أُنشودتي والحزنُ يملُؤها","مَهابَةً ونياطُ القلبِ أوتاري",52,"ر",2,0],["وقَعرُ السجن حيثُ مشتْ \" فرنسا \"","من \" البستيل \" ترتَفِعُ ارتفاعا",53,"ع",2,0],["وقِّعْ كما تهوىَ على وتر الهوى","فلأنت \" مَعْبدُ \" لحنه و\" غريضه \"",54,"ض",2,0],["وقع الّذي كنّا نخاف وقوعه","فعللى المنازل وحشة لا ترحل",55,"ل",1,0],["وقعت اجيل الطرف فيهم فراعني","هناك صبى بينهم مُترعرع",56,"ع",1,0],["وقعَ اللومُ والتنازعُ مِنْ ه","ذا وهذا واشتدَّ أَمْرُ الجِدالِ",57,"ل",1,0],["وقعوا وما شَانَتْ لهم خُلُقٌ","نِعَمٌ لهم شُهرتْ فما فَخَرُوا",58,"ر",3,0],["وقعوا ورِبك في فتوح مالها","رقع ولا لخروق خرقتها رفا",59,"ف",2,0],["وقّع وأوقع واغز واقن فهاهنا","مالٌ ملا الدينا وسيفُ باترُ",60,"ر",1,0],["وقعوا عداك أيا مليك وقيعة","شنعاء كانوا قبل عنها في غنا",61,"ن",2,0],["وَقعُ الصَفيحَةِ وَالقَناةِ بِمَتنِها","وَقعُ الحُفاةِ وَريشَةٍ مِن أَجدَلِ",62,"ل",1,0],["وقَعتَ لا شكَّ في عيوبٍ","لما توهمتَ أن تُعابا",63,"ب",2,0],["وقعتَ عندَ الخبير فاسمعْ","نصيحتي غيرَ مستفَز",64,"ز",1,0],["وقعت بها بين الهنود محيرّاً","ومفتكراً هل من أديب مسامر",65,"ر",1,0],["وقعت مواهبه على فقري كما","يقع الدواء على عظيم الداء",66,"ا",2,0],["وقع الحسن على وجنته","يا له سطرا على ما شرحا",67,"ح",2,0],["وَقعَةٌ بِالثُغورِ أَمسى لِكَلبِ ال","رومِ فيها مِنَ الزَئيرِ عُواءُ",68,"ا",2,0],["وقع لمن علمه","جودك حذق العقعقه",69,"ق",2,0],["وَقَعنا في الخَطايا وَالبَلايا","وَفي زَمَنِ اِنتِقاضٍ وَاِشتِباهِ",70,"ا",2,1],["وَقَعتُ وَاللَهِ تَحتَ النَقدِ وَالشِبهِ","إِن كُنتَ أَو خُذ أَو قَولي بِموجَبِهِ",71,"ه",1,0],["وَقَعنَ بِهِ مِن أَوَّلِ اللَيلِ وَقعَةً","لَدى مُلقَحٍ مِن عودِ مَرخٍ وَمُنتَجِ",72,"ج",1,0],["وَقّعْ رعَاكَ اللهُ مِن مَلِكٍ","في قَصَّتي وتَغنَّمِ الأجْرا",73,"ر",2,1],["وَقَعوا في خَنادِقٍ مِن قُبورِ","وَبَنَوها مِن فَوق كَالأَسوارِ",74,"ر",1,0],["وقع الخلاف بموته مع أنه","بالطبع ميتٌ والحياة مفارقه",75,"ق",2,0],["وَقعة ذِكرها عَلى الأَرض يَبقى","لاعتبار الأَبناءِ بِالآباءِ",76,"ا",2,0],["وقع له كل سول","وفاز بالسعادات",77,"ت",1,0],["وقعَ القولُ علَينا","إذ تَولَّى الحُكمَ فينا",78,"ن",2,0],["وقَّعنَ غَارِبَه الخُطو","بُ ولم يزل يأبَى الظُّلاَمَهْ",79,"م",2,0],["وَقَعَت مَواقِعها بِعَفوِكَ أَنفُسٌ","أَذهَبتَ بَعدَ مَخافَةٍ أَوجالَها",80,"ل",3,0],["وقع الهجر وما كانَ لكم","ذلك الهجران مأمونَ الوقوع",81,"ع",1,0],["وقع البلاء فلم يُفِدْ جزع","فتعلّلاً بعواقب الصبر",82,"ر",1,0],["وقعتُ به فمن دمعٍ طليقٍ","بمغناهُ ومن وَجْدٍ حبيسِ",83,"س",1,0],["وقعت بها وقع العشور","المذهبات من المصاحف",84,"ف",1,0],["وقعتَ ذُنابى في العلا وأكارعا","فأخفتك فيها أظهر وبطونُ",85,"ن",1,0],["وقعقعوا دونه الأبوابَ فاعتقدوا","بطول ما قروعها أنهم وصلوا",86,"ل",3,0],["وَقَعَ الحَريقُ بِمَوضِعٍ لَم أُسمِهِ","وَلَنا حَريقٌ غَيرَ ذي إِلهابِ",87,"ب",1,1],["وقعقعتْ بعدَ سكونٍ","طالَ منها عُمُدُه",88,"د",2,0],["وقعةٌ وقعُها يهدُّ الرّواسي","ويُذيبُ الحديدَ حَرُّ صَلاها",89,"ا",3,0],["وقع القصاص بهم وليسوا مقنعاً","برضى وأين من السماء غبار",90,"ر",1,0],["وقعودهم في رتبة نبوية","لم يبنها لهم أبو سفيان",91,"ن",1,0],["وقعت بفخ الخوف في يد طاهرِ","وقوع سليك في حبائل خثعمِ",92,"م",1,0],["وقَعَدْتَ في عَرْصاتِهِ مُتَمايلاً","مُتَبَسِّماً نَشْوانَ مِنْ إطْرابِهِ",93,"ب",2,0],["وَقَعقَعتُ القِداحَ فَفُزتُ مِنها","بِما أَخَذَ السَمينُ مِن القِداحِ",94,"ح",1,1],["وقعقعتُمُ أبوابَه تختِلونَه","ومَن لم يردْ خَتْلاً أصاب خُتولا",95,"ل",2,0],["وَقَعَدتُ أَرتَقِبُ الفِناءَ كَراكِبٍ","عَرَفَ المَحَلَّ فَباتَ دونَ المَنزِلِ",96,"ل",1,1],["وقعت قطرتاي في","بحر أمر تموجا",97,"ج",2,0],["وقعْتِ بي وبآمالي عَلى خِدَعٍ","مِنَ المُنَى بَيْنَ تَصْدِيقِ وتكْذيبِ",98,"ب",1,0],["وَقعْتُ بِالرَّشْفِ على ثَغْرِهِ","وَقْعَ المَساطِيلِ على الحَلْوَى",99,"ل",3,0]]}