,""],[5064,"أحزَان الشّارع اللّيلي","https://www.poetsgate.com/ViewPoem.aspx?id=199144",""],[5072,"نجاة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=52564",""],[5092,"سيمفونية قصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=139889",""],[5183,"قرينة البطل","https://www.poetsgate.com/ViewPoem.aspx?id=186604",""],[5273,"وقعت بفاحشة","https://www.poetsgate.com/ViewPoem.aspx?id=215877",""],[5327,"طِفلٌ عَلَى حَيْدِ الطَّريق","https://www.poetsgate.com/ViewPoem.aspx?id=156128",""],[5413,"إياك أعني واسمعي ياجاره","https://www.poetsgate.com/ViewPoem.aspx?id=200544",""],[5461,"بنت الكحيلة","https://www.poetsgate.com/ViewPoem.aspx?id=5038",""],[5523,"وقفات","https://www.poetsgate.com/ViewPoem.aspx?id=201355",""],[5542,"مشاهد من يوم القيامة","https://www.poetsgate.com/ViewPoem.aspx?id=10202",""],[5572,"الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=53485",""],[5573,"جمة البير","https://www.poetsgate.com/ViewPoem.aspx?id=200345",""],[5582,"أَبَى اللهُ إِلاّ أَنْ أَرَى الحَقَّ غالِبا","https://www.poetsgate.com/ViewPoem.aspx?id=186674",""],[5725,"ودق السما","https://www.poetsgate.com/ViewPoem.aspx?id=215842",""],[5885,"خطوتي","https://www.poetsgate.com/ViewPoem.aspx?id=194732",""],[5956,"قصة‎ ‎اللص والبَصَل","https://www.poetsgate.com/ViewPoem.aspx?id=184623",""],[5956,"صوت الروح الحربية","https://www.poetsgate.com/ViewPoem.aspx?id=192179",""],[5956,"معركة بدر الفلسطينية","https://www.poetsgate.com/ViewPoem.aspx?id=192325",""],[6024,"أنياب المنايا","https://www.poetsgate.com/ViewPoem.aspx?id=186354",""],[6147,"مشروع حلال","https://www.poetsgate.com/ViewPoem.aspx?id=151492",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[6213,"نغم المذاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85455&r=&rc=90",""],[6340,"غادة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85846&r=&rc=11",""],[572,"وَقَعَتْنِي ما بينَ حُزْنٍ وبؤسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9352&r=&rc=209",""]],"verses":[["وَقَعنَ بِغارَةٍ وَطَلَبنَ أُخرى","يُماطِلنَ الإِقامَةَ وَالصُفونا",0,"ن",2,0],["وَقَعتُ بِها في أَوَّلِ الفَجرِ وَقعَةً","غِشاشاً كَما أَقضى أَلِيَّةَ حالِفِ",1,"ف",1,0],["وَقَعَت مَوقِعَ العَوانِ مِنَ الدَه","رِ وَإِن كانَتِ الرَزِيَّةُ بِكرا",2,"ر",2,0],["وَقَعَاتُ أَبْطَالٍ يَصُولُ عَلَى العِدَى","فِيهَا أُبَاةُ الضَّيْمِ مِنْ أَبْنَائِهَا",3,"ا",3,0],["وَقَعَتْ إِلَيْكَ صَحِيفَةٌ","سَنْتِيسُ خَطٍّ بِهَا مِثَالِي",4,"ل",2,0],["وَقَعنَ اِثنَتَينِ وَاِثنَتَينِ وَفَردَةً","حَريداً هِيَ الوُسطى بِصَحراءَ حائِرِ",5,"ر",1,0],["وقعت بأعباء السياسة ناهضاً","يهمّة لاوانٍ ولا ناكصٍ جبنا",6,"ن",2,0],["وَقَعنَ جَوانِحاً في ظِلِّ لَيلٍ","عَلى مَطوِيَّةٍ وَالصُبحُ بادي",7,"د",2,0],["وَقَعتَ بِأَيدي المُحرِزِيِّينَ وَقعَةً","نَهَت باسِلاً عَنّا وَأَصحابَ باسِلِ",8,"ل",1,0],["وقعت على الجواد وأنتَ غيث","وقمت مسلماً خصب الجنان",9,"ن",1,0],["وَقَع اسْمٌ من السلامة والسِّل","مِ عليه وُقُوعَ لا مَقْصُودِ",10,"د",1,0],["وقْعُ الكرُاعِ ولمْعُ البيض يوقِدُهُ","لألاءُ وجهك فيه أيَّ إيقادِ",11,"د",1,0],["وقع الفراق وما يزال يروعني","فكأن واقع شره متوقعُ",12,"ع",1,1],["وقعتْ قوارعُ دهرِه بصَفاتِه","فتعلّلتْ عن مَصْدَقٍ سَهْلِيِّ",13,"ل",2,0],["وَقَعنَ وُقوعَ الطَيرِ فيها وَما بِها","سِوى جِرَّةٍ يَرجِعنَها مُتَعَلَّلُ",14,"ل",1,0],["وَقَعنَ أُصلاً وَعُجنا مِن نَجائِبِنا","وَقَد تُحُيِّنَ مِن ذي حاجَةٍ سَفَرُ",15,"ر",1,0],["وَقَعوا وَقَد طالَت سُراهُم وَقعَةً","فَهُمُ إِلى رُكَبِ المَطِيِّ جُثومُ",16,"م",1,0],["وَقَعَت غَدائِرُها عَلى أَقدامِها","فَكَأَنَّها قَد عَضَّها نابُ الهَوى",17,"ا",1,0],["وَقَعَت نَحلَةٌ عَلى الأُقحُوانِ","فَإِذا في القَفيرِ شُهدُ",18,"د",1,1],["وَقعُ الخُطوبِ عَلَيَّ أَخرَسَني","وَكَذا العَواصِفُ تُسكِتُ الغَرِدا",19,"د",2,0],["وَقَعَ الَّذي كُنّا نَخافُ وُقوعَهُ","فَعَلى المَنازِلِ وَحشَةٌ لا تَرحَلُ",20,"ل",1,0],["وَقَعَ الأَمرُ الَّذي لا يُدفَعُ","وَجَنى الجاني عَلى تِلكَ الرُبوع",21,"ع",1,0],["وَقَعَ الرَبيعُ وَقَد تَقارَبَ خَطوُهُ","وَرَأى بِعَقوَتِهِ أَزَلَّ نَسولا",22,"ل",2,0],["وَقَعَ الرُسلُ عَلَيهِ وَاِلتَوَت","أَرجُلُ الأَحرارِ فيهِ فَعَفاها",23,"ا",3,0],["وَقَعَت ناحِيَةً فَاِحتَرَقَت","مِثلَ قُرصِ الشَمسِ بِالأُفقِ اِضطِراما",24,"م",2,0],["وَقعَةُ الأَهرامِ جَلَّت مَوقِعاً","وَتَعالَت في المَغازي أَن تُرابا",25,"ب",2,0],["وَقَعَت عَلى الأُردُنِّ مِنهُ بَلِيَّةٌ","نُضِدَت بِها هامُ الرِفاقِ تُلولا",26,"ل",2,0],["وَقَعَدتُ عَنكَ وَلَو بِمُهجَةِ آخَر","غَيري أَقومُ إِلَيهِمُ لَم أَقعُدِ",27,"د",1,0],["وَقَعنَ وَقَد صاحَ العَصافيرُ إِذ بَدا","تَباشيرُ مَعروفٍ مِنَ الصُبحِ مُغرَبِ",28,"ب",1,0],["وَقَعتُم بِصُفرَيِّ الخَضارِمِ وَقعَةً","فَجَلَّلتُموها عارَها لَيسَ يَذهَبُ",29,"ب",1,0],["وَقعةٌ باللِّوى استباحَتْ نُفوساً","قَمَرَتْها غَرَّاءَها الأقمارُ",30,"ر",1,0],["وَقَعتْ لَحظَةٌ على القَلبِ منها","أَفلا يَترُك الحَشا ويَطيرُ",31,"ر",1,0],["وَقَعتُ في الدَّمعِ إِذ أُغْرِقتِ في لُجَجٍ","قَد كادَ يَغمِرُني مِنهُ الَّذي غَمَرَك",32,"ك",1,0],["وَقعَةٌ زَعزَعَت مَدينَةَ قُسطَن","طينَ حَتّى اِرتَجَّت بِسورِ فُروقِ",33,"ق",1,0],["وقعتُ في عينِ الخطا","فقلتُ في عينِ الخطا",34,"ط",2,0],["وَقَعي على البلوى كما","وَقَعَ “الحُسامُ” على الحُسامِ",35,"م",1,0],["وَقَعَ الطّائِرُ المُسِفُّ على النَّس","رِ الذي يملأُ السماواتِ عَزْما",36,"م",2,0],["وقعدتَ مكتوفَ اليديْ","ن تقولُ حاربني الزَّمنْ",37,"ن",1,0],["وَقَعنَ اِثنَتَين واِثنَتَينِ وَفَردَةً","يُبادِرنَ تَغليساً سِمالَ المَداهِنِ",38,"ن",1,0],["وَقَعتَ بِعَبسٍ ثُمَّ أَنعَمتَ فيهِمُ","وَمِن آلِ بَدرٍ قَد أَصَبتَ الأَكابِرا",39,"ر",2,1],["وَقعاتٌ تُنْسي المُؤرِّخَ ما كا","نَ مِنْ سُنْبسٍ وَمِنْ زُنَّارَهْ",40,"ر",2,0],["وَقَعتُ بَينَ يَدَيْهِ مِنْ مَهابَتِهِ","وقالتِ الناسُ مَيْتٌ مَسَّهُ كِبَرُ",41,"ر",1,0],["وقعاتُ نَصرٍ في الأعادي حدّثَتْ","عن يوم بدرٍ قَبْلها وتَبوك",42,"ك",1,0],["وَقَعنَ فَريصاتِ السَديسِ كَما دَعا","عَلى فَنَنٍ مِن ضالَةِ الأَيكِ أَخطَبُ",43,"ب",1,0],["وَقَعنا في الحَياةِ بِلا اِختِيارٍ","وَخالِقُنا يُعَجِّلُ بِالخَلاصِ",44,"ص",1,1],["وقُعُودِي عِنْدَ ذِي غَادِيَةٍ","تَقْذِفُ الأَعْدَاءَ عَنِّي بِالكَلِمْ",45,"م",1,0],["وقعدوا ناحية كمينا","ليغدروا في داره الأمينا",46,"ن",2,0],["وَقَعُوا بَيْنَ رِيفِهَا وَقُرَاهَا","بِضُرُوبِ الْفَسَادِ وَقْعَ الجَرَادِ",47,"د",1,0],["وَقَعَتْ نِهَايَةُ دَائكَ المُنْتَابِ","وَقْعَ الفُجَاءَةِ فِي انْقِضَاضِ شِهَابِ",48,"ب",1,1],["وقعتَ بعبسٍ ثمّ أنعمتَ فيهمُ","ومِنْ آلِ بَكْرٍ قَدْ أَصَبْتَ الأَكَابِرا",49,"ر",2,1],["وقع المتعب الكئيب على الموت","فماذا جرى وكيف وقوعه ؟",50,"ع",2,0],["وقّعوا مشروع تقنين الهوى","بالبطاقات ، لكلّ العاشقين",51,"ن",1,0],["وقَّعْتُ أُنشودتي والحزنُ يملُؤها","مَهابَةً ونياطُ القلبِ أوتاري",52,"ر",2,0],["وقَعرُ السجن حيثُ مشتْ \" فرنسا \"","من \" البستيل \" ترتَفِعُ ارتفاعا",53,"ع",2,0],["وقِّعْ كما تهوىَ على وتر الهوى","فلأنت \" مَعْبدُ \" لحنه و\" غريضه \"",54,"ض",2,0],["وقع الّذي كنّا نخاف وقوعه","فعللى المنازل وحشة لا ترحل",55,"ل",1,0],["وقعت اجيل الطرف فيهم فراعني","هناك صبى بينهم مُترعرع",56,"ع",1,0],["وقعَ اللومُ والتنازعُ مِنْ ه","ذا وهذا واشتدَّ أَمْرُ الجِدالِ",57,"ل",1,0],["وقعوا وما شَانَتْ لهم خُلُقٌ","نِعَمٌ لهم شُهرتْ فما فَخَرُوا",58,"ر",3,0],["وقعوا ورِبك في فتوح مالها","رقع ولا لخروق خرقتها رفا",59,"ف",2,0],["وقّع وأوقع واغز واقن فهاهنا","مالٌ ملا الدينا وسيفُ باترُ",60,"ر",1,0],["وقعوا عداك أيا مليك وقيعة","شنعاء كانوا قبل عنها في غنا",61,"ن",2,0],["وَقعُ الصَفيحَةِ وَالقَناةِ بِمَتنِها","وَقعُ الحُفاةِ وَريشَةٍ مِن أَجدَلِ",62,"ل",1,0],["وقَعتَ لا شكَّ في عيوبٍ","لما توهمتَ أن تُعابا",63,"ب",2,0],["وقعتَ عندَ الخبير فاسمعْ","نصيحتي غيرَ مستفَز",64,"ز",1,0],["وقعت بها بين الهنود محيرّاً","ومفتكراً هل من أديب مسامر",65,"ر",1,0],["وقعت مواهبه على فقري كما","يقع الدواء على عظيم الداء",66,"ا",2,0],["وقع الحسن على وجنته","يا له سطرا على ما شرحا",67,"ح",2,0],["وَقعَةٌ بِالثُغورِ أَمسى لِكَلبِ ال","رومِ فيها مِنَ الزَئيرِ عُواءُ",68,"ا",2,0],["وقع لمن علمه","جودك حذق العقعقه",69,"ق",2,0],["وَقَعنا في الخَطايا وَالبَلايا","وَفي زَمَنِ اِنتِقاضٍ وَاِشتِباهِ",70,"ا",2,1],["وَقَعتُ وَاللَهِ تَحتَ النَقدِ وَالشِبهِ","إِن كُنتَ أَو خُذ أَو قَولي بِموجَبِهِ",71,"ه",1,0],["وَقَعنَ بِهِ مِن أَوَّلِ اللَيلِ وَقعَةً","لَدى مُلقَحٍ مِن عودِ