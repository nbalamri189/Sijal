"https://poetry.dctabudhabi.ae/diwan/poem/100860","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91715","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91304","الكامل"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124072","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133248","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135433","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103007","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102932","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40086","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44698","البسيط"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136943",""],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136907",""],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90824","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136673",""],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77694","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72787","الكامل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104903","الكامل"],[5057,"حدثت عنكِ الله","https://www.poetsgate.com/ViewPoem.aspx?id=197227",""],[5213,"صدقتك سلمى وعدها وودادها","https://www.poetsgate.com/ViewPoem.aspx?id=170455",""],[307,"بمن الوذ","https://www.poetsgate.com/ViewPoem.aspx?id=213702",""],[470,"هذي ذُرى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=63614",""],[5721,"أعظم من أسلافي الأول","https://www.poetsgate.com/ViewPoem.aspx?id=215232",""],[5741,"لله ليالٍ أقبلت بالنعم","https://www.poetsgate.com/ViewPoem.aspx?id=187439",""],[402,"يا من يقيمون لاستقلالهم عيدا","https://www.poetsgate.com/ViewPoem.aspx?id=35355",""],[6152,"الله لطيف بعباده","https://www.poetsgate.com/ViewPoem.aspx?id=213229",""]],"verses":[["لِلّهِ لِلأَوْطَانِ لِلْفَارُوقِ","قُمْتَ بِمَا وَجَبْ",0,"ب",1,0],["لله لله عيناً من رأى سحراً","تلك المنارة قد رقَت حواشيها",1,"ي",3,0],["للّه لبنان الذي هضباته","ضحكت مغازلةً مع الوديان",2,"ن",1,0],["للَّهِ لحيةُ حائكٍ أبصرتُها","ما أبصرتْ عيناي في مقدارِها",3,"ه",2,1],["لِلَّهِ لَيلَةَ بِتنا وَالرَقيبُ بِها","ناءٍ فَلا عَينَهُ نَخشى وَلا أَثَرَه",4,"ر",2,0],["لِلَّهِ لَيلَتُنا بِالمَجمَعَينِ وَقَد","حالَت وَتَذكارُها في القَلبِ لَم يَحُلِ",5,"ل",1,0],["لِلَّهِ لَذَّةُ عَيشٍ بِالحَبيبِ مَضَت","فَلَم تَدُم لي وَغَيرُ اللَهِ لَم يَدُمِ",6,"م",1,0],["لِلَّهِ لَيلَةُ أُنسٍ قُلتُ إِذ ذُكِرَت","يا لَيلَةَ الوَصلِ مِن ذاتِ اللَمى عودي",7,"د",2,0],["لِلَّهِ لَيلَتُنا بِالقَصرِ كَم قَصُرَت","فَظَلتُ مُصطَبِحاً في زِيِّ مُغتَبِقِ",8,"ق",1,0],["لِلَّهِ لَيلَتُنا وَكانَت لَيلَةً","ذُخِرَت لَنا بَينَ اللِوى فَالشُربُبِ",9,"ب",1,0],["لِلَّهِ لِطفٌ خَفيٌّ في بَريَّتِهِ","أَعيا دَواءٌ المَنايا كُلَّ نِطَّيسِ",10,"س",1,1],["لله لبنان الذي هضباته","شيئاً يُضيع كرامة البُلدان",11,"ن",1,0],["للَه للَه يا سر الوجود أغث","قليل كربي قد طالت دقائقه",12,"ق",2,1],["للَه لطف سر برهانه","يدفع عن قلب الحزين الحرج",13,"ج",1,1],["للَّهِ للَّهِ مَا أَحْلى رِضَاكِ وَمَا","أَمَرَّ سُخْطَكِ يا مَوْلاةَ مَوْلاهَا",14,"ا",3,1],["لله ليلة هب نحوى زائرا","يدعوه نحوى ما إليه دعاني",15,"ن",2,0],["لله ليلتنا التي استجدى بها","فَلَقُ الصباحِ لسدفةِ الإظلامِ",16,"م",1,1],["لله ليلة أنس لا يعادلها","خضر الرياض إذا ما جاءها المطر",17,"ر",1,0],["للّه لذة اوقات نعمت بها","بالبسط دهرا على بسط من الزهر",18,"ر",1,0],["للّه ليلة زارني متكتماً","حذر المراقب والعذول الاحمق",19,"ق",1,0],["لِلَّهُ لَيلاتٌ خَلَت","مِنهُ وَأَيّامٌ سَوالِف",20,"ف",1,0],["لِلَه لِلَه من رجال","ساروا على منهج الرشادِ",21,"د",1,0],["للَه للَه من عبرة ودمعة تسيل","ومن تحسر عليهم ليس يشفى غليل",22,"ل",1,0],["للَه للَه مسعود بوادره","من حضرة القدس لا بالغافل الناسي",23,"س",2,0],["لِلَهِ لَيثٌ هاصِرُ زِيادُهُ","إِذا سَطا يَثنى العَدُوَّ المُعتَدي",24,"د",2,0],["لِلَهِ لَيلٌ هُناكَ أَوحَشَني","وَلا كَما أَوحَشَتهُ نُوّامُهُ",25,"م",2,0],["لِلَهِ لَيلاتٌ قَرَنَّ نُجومَها","بَل بَدرَها بِوُجوهٍ عَيشٍ أَقمَرَت",26,"ت",1,0],["للّه لا غير جميع الثنا","وكل حمد يستطيع اللسان",27,"ن",1,1],["للهِ ليلتُنا التي رَحُبَتْ لَنا","فيها المسرّةُ في مجالٍ ضَيّقِ",28,"ق",1,1],["للَه للَه يوم في السفينة إذ","هزّت أسابرنا بيضاً وسمرقنا",29,"ن",2,1],["للَه لبنان إذ شرفت قمتهُ","باخمصيك فاضحى مورد الأممِ",30,"م",1,0],["لله ليلٌ بات فيه مُضاجعي","ظبيٌ لواحظُه لها فعل الظُبى",31,"ب",2,0],["للّه ليلة طاف الطيف بي فغدا","مورّقا لجفوني حيثما يضع",32,"ع",1,0],["للّه ليلة زارني من نحوهم","طيف عليه من الظلام رداء",33,"ا",2,0],["لِلَّه لا لِغَيرِهِ","نَضرَع أَن تَبقى لَنا",34,"ن",2,0],["للَّهِ لِلهِ إبراهيمُ تُبصرُه","يَنهَى ويَامرُ في ناهٍ وأمَّارِ",35,"ر",1,0],["لله ليلتنا في صحن صحنايا","لما امتلا بالصفا والبسط هايا",36,"ي",2,1],["لله لله راجي","مما سوى الله يأسه",37,"س",2,0],["لله ليلةُ وصل قاتلتي","ما كانَ أَقْصَرها وأَطْولها",38,"ل",3,0],["لله لا لهوى يدعوه أو طمع","أكرم به من محب صادق حام",39,"م",1,0],["لله ليل كالنهار قطعته","بالوصل لا أخشى به ما يرهب",40,"ب",1,0],["للهِ ليلتُنا بحَمّةِ صالِحَهْ","والنّفسُ فيها بالتّنعّم فارحَهْ",41,"ح",2,1],["للَه ليلة زار الحب مختفياً","لولا الخمار لظنوه من الشهب",42,"ب",1,0],["لله ليلة أقبلت والطيب من","اردانها يحيي الكئيب الفاني",43,"ن",2,0],["لله ليلتُنا بزورته وقد","سَمَلت يدُ الغَفَلات عينَ الكاشحِ",44,"ح",1,0],["لله لوعة بطرس كم اَّججت","في مهجتي الحراء جمراً مضرما",45,"م",2,0],["لله لله ابتهاجٌ شاملٌ","جلّ الذي قد جاد فيه وزوّدهْ",46,"د",2,0],["لله لله ما أحلى شمايلهُ","كل السعودات طراً فيه تحتكرُ",47,"ر",1,0],["لله لله يوم عاد يرفل في","ثوب الفخار وفي مرآه يحيينا",48,"ن",2,0],["لله ليل بت فيه على الصفا","من راح خمرتها الشريفة أشرب",49,"ب",1,0],["للهِ ليلٌ بالحريم خلَستُه","والحزمُ كوْني للسّرور خَلوسا",50,"س",2,0],["لله لله أسلاف لنا سلفت","تقضي الحوائج لا بيعاً ولا سلفا",51,"ف",2,0],["لله ليلٌ به قد بات يشفيني","من الهوى مبسمٌ عند ابنة الدين",52,"ن",1,1],["لله لَيل به مع بنت معلوم","الدين قد باتَ نَجلُ الشيخ معلوم",53,"م",1,1],["لِلَّهِ لَيلَةَ بِتنا وَهوَ ثالِثُنا","مِن مُسلِمٍ وَيَهودِيٍّ وَنَصراني",54,"ن",2,0],["للَه ليث وزارة منه اغتدى","بصر الوزارة بعده مكفوفا",55,"ف",2,0],["للَه ليلتنا بجلق والدجى