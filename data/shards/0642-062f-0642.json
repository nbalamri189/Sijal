/poetry.dctabudhabi.ae/diwan/poem/85344","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39659","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55147","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55039","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54909","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67353","البسيط"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10208","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54226","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54252","الخفيف"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50069","البسيط"],[72,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[77,"هذي ثمان قد قطعن الحجا","https://www.poetsgate.com/ViewPoem.aspx?id=33640",""],[18,"إن تحت الأحجار حزما وعزما","https://www.poetsgate.com/ViewPoem.aspx?id=27785",""],[88,"يا ساكناً وهو مشنوق على عمد","https://www.poetsgate.com/ViewPoem.aspx?id=25554",""],[88,"لَقِيتُها لَيْتَنِي مَا كُنْتُ أَلْقَاهَا","https://www.poetsgate.com/ViewPoem.aspx?id=1235",""],[90,"في ذكرى الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179047",""],[90,"تأبين الغراف الميت","https://www.poetsgate.com/ViewPoem.aspx?id=179098",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[34,"وَيْلي وَعَوْلي وما لي حِينَ تُفلِتُني","https://www.poetsgate.com/ViewPoem.aspx?id=22461",""],[45,"نحنُ الفِداءُ، فمَأخُوذٌ وَمُرْتَقَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31563",""],[51,"بدرٌ وشمس وَلَدَا كوكبا","https://www.poetsgate.com/ViewPoem.aspx?id=27044",""],[31,"يا ربِّ، إنكَ قد علمتَ بأنها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19098&r=&rc=360",""],[31,"قد أبلتنيَ الذكرُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18857&r=&rc=120",""]],"verses":[["قَد قُلتُ لِلرَجُلِ المُقَسِّمِ أَمرَه","فَوِّض إِلَيهِ تَنَم قَريرَ العَينِ",0,"ن",1,1],["قَد قُلتُ لِلرَكبِ الهُجو","دِ عَلى الأَماعِزِ وَالإِكامِ",1,"م",1,0],["قَد قُلتُ لِلحُسّادِ حينَ تَقارَضوا","حُرَقَ القُلوبِ جَوىً وَحَرقَ الأُرَّمِ",2,"م",1,0],["قَد قَدَحتَ العِزَّ زَنداً غَيرَ كابٍ","وَلَبِستَ المَجدَ بُرداً غَيرَ بالي",3,"ي",1,0],["قَد قَصَرَ الدَهرُ عَجزاً عَن لِحاقِهِمُ","فَأَينَ أَينَ ذَميلُ الدَهرِ وَالرَتَكُ",4,"ك",1,0],["قَد قُلتُ لِلمُتَعَرِّضينَ لِسَطوِهِ","خَلّوا وِجارَ الأَرقَمِ المُتَطَلِّعِ",5,"ع",1,0],["قَد قَلِقَ الجَنبُ وَطالَ الكَرى","وَأَظلَمَ الجَوُّ وَضاقَ الفَضا",6,"ض",2,0],["قَد قُلتُ لِلرَكبِ الطِلاحِ كَأَنَّهُم","رُبدُ النُسورِ عَلى ذُرى أَطوادِها",7,"د",3,0],["قَد قُلتُ لِلإِبِلِ الطِلاحِ حَدَوتُها","غَلَسَ الظَلامِ بِسائِقٍ غَريدِ",8,"د",1,0],["قَد قُلتُ لِلعادي عَلَيَّ بِبَغيِهِ","مَهلاً فَما يَلحو القَتادَةَ لاحي",9,"ي",1,0],["قَد قُلتُ لِلنَفسِ الشَعاعِ أَضُمُّها","كَم ذا القِراعُ لِكُلِّ بابٍ مُصمَتِ",10,"ت",1,1],["قَد قُلتُ لِلباغي عَلَيَّ وَدونَهُ","مِن فَضلِ أَحلامي ذُرىً وَذَوائِبُ",11,"ب",1,0],["قَد قُلِّبَت أَعيانُهُ وَتَنَكَّرَت","أَعلامُهُ وَتَكَسَّفَت أَضواؤُهُ",12,"ا",3,0],["قَد قُلتُ لَمّا فَقَدتُ كُتبَكُمُ","كَعَهدِكُم وَالزَمانُ مُؤتَلِفُ",13,"ف",1,0],["قَد قُلتُ لَمّا رَأَيتُ المَوتَ يَقصِدُني","وَكادَ يَهتِفُ بي داعيهِ أَو هَتَفا",14,"ف",2,0],["قَد قالَ قَلبي لِطَرفي وَهوَ يَعذِلُهُ","هاذا جَزاأُكَ مِنّي فَاِكدُمِ الحَجَرا",15,"ر",2,0],["قَد قُلتُ لِلقَلبِ لا لُبناكَ فَاِعتَرِفِ","وَاِقضِ اللُبانَةَ ما قَضَّيتَ وَاِنصَرِفِ",16,"ف",1,1],["قَدْ قَبِلْنَا جِيَادَكَ الدُّهْمَ لَمَّا","أَنْ بَلَونَا مِنْهَا الْعِتَاقَ الْحِسَانَا",17,"ن",2,1],["قَدْ قَرَّ أَمْرُكَ وَاسْتَقَرَّ عِمَادُهُ","وَالْحَقُّ بَانَ فَلَمْ يَدَعْ مَا يُشْكِلُ",18,"ل",1,0],["قدْ قَطَعَ البَرَّ فقال الوَجَى","واقْتَحَمَ البحْرَ فقالَ النَّجا",19,"ج",2,0],["قَدْ قُمْتُ منْ خَلْفِ دارِ السّعْدِ خادِمةً","فَكُنْهُ حاليَ أنّي يا أُخَيّاتِي",20,"ت",2,0],["قَد قُلتُ قَولاً فَقَضى بَينَكُم","وَاِعتَرَفَ المَنفورُ لِلنافِرِ",21,"ر",1,0],["قَد قامَ ما بَينَ العُيونِ وَبَينَها","سِترٌ مِنَ الأَحزانِ وَالأَكدارِ",22,"ر",1,0],["قَد قالَ عَمرٌو في ثَراها آيَةً","مَأثورَةً نُقِشَت عَلى الأَلواحِ",23,"ح",1,0],["قَد قامَ سَعدٌ بِها حيناً وَأَسلَمَها","إِلى أَمينٍ فَلَم يُحجِم وَلَم يَهَبِ",24,"ب",1,0],["قَد قامَ بَينَهُمُ وَبَي","نَ العِلمِ ضيقُ الحالِ سَدّا",25,"د",2,0],["قَد قَرَأنا ظِلالَكُم فَاِشتَفَينا","بارَكَ اللَهُ في ظِلالِ الدُموعِ",26,"ع",1,1],["قَد قَرَأناكُمُ فَهَشَّت نُهانا","فَاِقتَبَسنا نوراً يُضيءُ السَبيلا",27,"ل",2,1],["قَد قُلتُ إِذ قيلَ السَريرُ يُقِلُّهُ","هَل لِلسَريرِ بِقَدرِهِ اِستِقلالُ",28,"ل",1,0],["قَد قُلتُ لِلتالي ثَناءَكَ سورَةً","ما لِلوَرى في نَصِّها إِلحادُ",29,"د",1,0],["قَد قالَ شاعِرُ كِندَةٍ في ما مَضى","بَيتاً عَلى مَرِّ اللَيالي يُعلَمُ",30,"م",1,0],["قَد قَرَّتِ العَينانِ مِن مالِكٍ","وَمِن بَني عَمروٍ وَمِن كاهِلِ",31,"ل",1,0],["قد قلدوك قلائد الدرر","وتنافسوا في النظم والنثر",32,"ر",1,1],["قَدْ قَامَ عَرْشُكَ فِي أَعَزِّ مَكَانِ","وَعَلَيهِ هَامَاتُ الْجِبَالِ حَوَانِي",33,"ن",2,1],["قَدْ قُمِّعَتْ بِالعَاجِ أمَّا عُودُهَا","فَأُصُولُهُ مِنْ أَقٌدَمِ الأَزْمانِ",34,"ن",1,0],["قد قيّدته لأُنسنا أوتاره","كالظبي قُيِّد في الكناس إذا نَفَرْ",35,"ر",1,0],["قد قلَّدتْه نقوشي","دُرَّ الدراري العوالي",36,"ي",1,0],["قد قمت بالحزم فيها والياً فجرت","أمورها في نظام منك متّسِق",37,"ق",1,0],["قد قمّطتها بأهدام ممزّقة","في العين منثرها سمبحٌ ومطواها",38,"ا",3,0],["قد قضى الكاظمي وهو جدير","أن تعزّى في موته الشعراء",39,"ا",2,0],["قد قتلت الحياة خبراً ولكن","أنا منها بحيرتي مقتول",40,"ل",1,0],["قَد قَرَّبَ الحَيُّ إِذ هاجوا لِإِصعادِ","بُزلاً مُخَيَّسَةً أَرمامَ أَقيادِ",41,"د",1,1],["قَد قَطَّعَت نَفسَ المُجَرِّبِ غايَتي","وَتُضِرُّ بِالمُتَكَلِّفِ الزِمّامِ",42,"م",1,0],["قَد قُدتُ في غَلَسِ الظَلامِ وَطَيرُهُ","عُصَبٌ عَلى فَنَنِ العِضاهِ جُثومُ",43,"م",1,0],["قد قلت لما جدَّتِ العقاب","قد ضمها والبدن الحقاب",44,"ب",1,1],["قَد قَنِعنا بِذَلِكَ النَزرِ مِنهُ","وَغَفَرنا لَهُ الذُنوبَ لِذَلِك",45,"ك",1,0],["قد قدّمته على السادات همّته","في الفضلِ تقديم بسم الله في الصحف",46,"ف",1,0],["قَد قامَ بَعضي بِبَعضِ بَعضي","وَهامَ كُلّي بِكُلِّ كُلّي",47,"ل",2,0],["قد قضينا لُبانةً من عتاب","وجميلٌ تَعاتُبُ الأكفاءِ",48,"ا",2,0],["قد قلتُ إذ خُبِّرتُ عن","ك بما أشبتَ من الأُشابهْ",49,"ب",2,0],["قد قلتُ إذ خُبِّرت عن تبليحهِ","وأنه في زفراتٍ وكُرَبْ",50,"ب",1,0],["قد قلتُ إِذ بشِّرتُ بالمُشتري","قولَ امرئٍ لم يَخْشَ أن يُكذَبا",51,"ب",2,0],["قد قلتُ قولاً فيكُمُ مُعْجِباً","أن لم أكنْ ذا حُمُقٍ مُعجَبا",51,"ب",2,0],["قد قلتُ إذ نحلوهُ الشعرَ حَاشَ له","إنَّ البُرُوكَ به أولى من الخبَبِ",52,"ب",1,0],["قد قلت للعذَّالِ عند تَتَبُّعي","بالقصِّ شيباً كلَّ يوم يَحدثُ",53,"ث",1,1],["قد قُلْتُهُ فيكم ولم أر قائلاً","أنْبَأتَ عن غيبٍ فما إيضاحُه",54,"ح",2,0],["قد قلت إذ قالوا بجهلهمُ","ما حبُ أيرِك كُوَّةً قذرَهْ",55,"ه",1,1],["قد قُرن المشتري إلى البدرِ","ووافق السؤلُ ليلةَ القدرِ",56,"ر",1,1],["قد قلت حين رأيتُ باطن كفِّه","أندى منَ المتحلِّب الرجاس",57,"س",1,0],["قد قُمتُ يا بيهقيُّ معتذراً","عنك بشعرٍ بنفسه واش",58,"ش",1,0],["قد قبضَ الجندُ والمكلَّفُ لم","يقبض على أنه قد اعترضا",59,"ض",2,0],["قد قلتُ إذ قيل قد زُفَّت حليلتُه","صبراً كأني بقرن الشيخ قد طلعا",60,"ع",2,0],["قد قلتُ حين ملكت أمرهم","شمل أراد مليكهم جمعه",61,"ع",2,0],["قد قلت إذا حاولتها","بلغ المحاول ما ابتغى",62,"غ",2,0],["قد قلت إذ طلعت نعماك تخبرني","إني بفضلك ما عُمِّرت ملحوف",63,"ف",1,0],["قد قلت إذ مدحوا الحياة فأكثروا","للموت ألف فضيلة لا تعرفُ",64,"ف",1,1],["قد قلتُ بيتاً لك تلقاءه","نادرة توجب إحناقي",65,"ق",2,1],["قد قرأنا كتابك الحسن النظ","م فخلناه لؤلؤاً منسوقا",66,"ق",2,0],["قد قلت للدهر الملحِّ بصرفه","لما اعتصمت بحبلكم ستفيق",67,"ق",1,0],["قد قضى الله موتَه منذ حين","واحتوى الموتُ نفسه وهو باق",68,"ق",1,0],["قد قرضناك في التقاضي بمزحٍ","ليس من مثلِه يضيقُ خِناقُك",69,"ك",1,0],["قد قضى قول لَبيدٍ بيننا","إنما يجزي الفتى ليس الجمل",70,"ل",1,0],["قد قلتُ إذا بلغتْني","لعاً برغم الجِمامِ",71,"م",1,0],["قد قلتُ للمتكلّفي مَسعاتِكم","إن الخوافي لن تكون قوادما",72,"م",2,0],["قد قال قومٌ وغاظتهم كتابتُه","لو شئت يا ربِّ ما علَّمتَ بالقلمِ",73,"م",1,0],["قد قُلتُ حين أهَبَّ اللَّهُ ريحَكُمُ","الآن يَعْدِلُ فينا السَّيْفُ والقلمُ",74,"م",1,0],["قد قضى قبلنا بذلك بيتٌ","حملته الرواة عن حسان",75,"ن",1,0],["قد قلتُ إذ قالوا هجاك تعجباً","أنى تفرغ خالد فهجاني",76,"ن",2,0],["قد قُلتُ إذ قَذِيتْ به","عَيْني وأعينُ مُبصريهِ",77,"ي",2,0],["قد قلتُ إذ حَذَّروني","كَ ناكَ أم أبيهِ",78,"ي",2,0],["قَد قادَها طوغو فَقادَ ذُلولَةً","تَهوى الصِعاب وَتَعشَقُ الأَسفارا",79,"ر",2,0],["قَد قَلَّدوا الغَربِيَّ في آفاقِهِ","تَقليدُهُ الشَرقِيُّ فيما يُعصِمُ",80,"م",1,0],["قَد قيلَ لي إِنَّ بَعضَ الناسِ يَعتِبَني","عِرضي لَهُ دونَ كُلِّ الناسِ مَجّانُ",81,"ن",1,0],["قدْ قَنَّعَتْ كَفُّ المَساءِ","الموتَ بالصَّمْتِ الرَّهيبْ",82,"ب",1,0],["قد قلت ان العقل لي","يهدى فكان مضللي",83,"ل",2,1],["قد قلت حقا فلم تقبله أذهان","وحاربتك سياسات وأديان",84,"ن",1,1],["قد قاومت بعدك الرزايا","لم تألُ في دفعهن جهدا",85,"د",2,0],["قد قلت في وفاتها مؤرخاً","عابدة سارت إلى معبودها",86,"ه",2,1],["قَد قالَ مَن أَدَّبَهُ اِختِبارُه","السَعيُ لِلمَوتِ وَلا اِنتِظارُه",87,"ه",1,0],["قَد قالَ في هَذا المَقامِ مَن سَبَق","أَكذبُ ما يُلفي الكَذوبُ إِن صَدَق",88,"ق",1,0],["قَد قامَ غَليومٌ خَطيباً فَما","أَعطاكَ مِن مُلكِكَ إِلّا القَليل",89,"ل",1,0],["قَد قَضى اللَهُ أَن يُؤَلِّفَنا الجُر","حُ وَأَن نَلتَقي عَلى أَشجانِه",90,"ن",2,0],["قد قلت للتلميذ أذهله","عما سواه مراسه الأرقا",91,"ق",2,1],["قد قلتُ لما نبتْ عنه عيونُهُمُ","وهُم بطِمرَيْهِ عن خَدَّيهِ في شُغُلِ",92,"ل",1,0],["قد قلتُ لمَّا سَلَّ فيه لسانَهُ","سَفَهاً وعارضَ بالمصونِ مُذالَهُ",93,"ل",2,0],["قد قال حينَ بلاكَ بعدَ عِصابةٍ","من قبلُ كلُّ الصيدِ في جوف الفَرا",94,"ر",2,0],["قد قالتِ الريحُ إذْ رأت سَقَمِي","باللّهِ ما تحتَ ثوبهِ جَسَدُ",95,"د",1,0],["قد قلتُ للمُزجِي قلائِصَهُ","حُدْباً تَعرَّق لحمَها الحُدْبُ",96,"ب",1,0],["قَد قابَلَتكَ سُ