{"poems":[[79,"من طلب الود من سلاوي","https://www.aldiwan.net/poem35838.html","مخلع البسيط"],[99,"يا أيها العالي الغفور الصفوح","https://www.aldiwan.net/poem24918.html","السريع"],[107,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[128,"الناس ما الناس عبدان القوى بهم","https://www.aldiwan.net/poem23728.html","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70819","البسيط"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32668","الخفيف"],[3998,"","https://poetry.dctabudhabi.ae/diwan/poem/34827","الرجز"],[4940,"روح من جنون","https://www.poetsgate.com/ViewPoem.aspx?id=205646",""],[5268,"ما يقتلُ العصفور","https://www.poetsgate.com/ViewPoem.aspx?id=207014",""],[5277,"الساحرةُ","https://www.poetsgate.com/ViewPoem.aspx?id=192014",""],[5431,"حمقاء...","https://www.poetsgate.com/ViewPoem.aspx?id=190711",""],[5431,"والحب مصيدة فيها سترديه!!","https://www.poetsgate.com/ViewPoem.aspx?id=197129",""],[5431,"قصيدة تفكيكية (2)","https://www.poetsgate.com/ViewPoem.aspx?id=215499",""],[514,"إِلَّا إِلَيكَ تَسَابَقنَا إِلَى الغَرَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=155918",""],[6068,"حمقاء -02-","https://www.poetsgate.com/ViewPoem.aspx?id=175942",""],[6108,"رحلة","https://www.poetsgate.com/ViewPoem.aspx?id=192588",""]],"verses":[["حَمْقا فَما شِئْتَ منْ دِماغٍ","قدْ عدِمَ المُخَّ فهْوَ خاوِي",0,"ا",3,0],["حَمقَى قُصارَى كلِّ غاياتنا","عزمٌ مَهيضٌ وجَناحٌ كسيح",1,"ح",1,0],["حَمْقاءَ يَطغى الغيظُ بين سُطورِها","وتَشُبُّ بالشَّنآنِ منها الأحرفُ",2,"ف",1,0],["حمقى يجارون أفراداً ومجتمعاً","وأمة وشعوباً كل تيار",3,"ر",1,0],["حمقاءُ إنْ سمعتْ نُصْحاً لها نخرت","كأنها سمَجٌ قد ريع مِنْ ريعِ",4,"ع",1,0],["حُمقِيَ اليَومَ قائِمٌ بِعِيالي","وَيَموتونَ إِن تَعاقَلتُ ذُلّا",5,"ل",2,0],["حُمقِيَ قَد صَيَّرَ ذا ال","عالَمَ خَولاً لَلَلي",6,"ل",2,0],["حمقى بكل لغاتِ العقل لو وُصِفا","فالفكرٌ في سُرُرٍ مصفوفةٍ حِقَبَا",7,"ب",2,0],["حمقى يصفٌّونَ الجماجمَ سُلَّمًا","للمجدِ فاصعَدْ إن أردتَ ليعزفوا",8,"ف",3,0],["حمقاءُ لمْ تدرِ أنَّي عاشقٌ فطنٌ","وطالما كنتُ للعشاقِ أستاذا",9,"ذ",2,0],["حمقاء جاحدة ..كم أشركت فيه","مذْ بتُ أعبده جاءت لتفديه!",10,"ه",1,1],["حمقاء جاحدة كم أشركت فيه","مذْ بتُ أعبده قالت ستفديه!",11,"ي",2,1],["حمقا بذات غوى تلقى القطاف وما","قد صان ميسمها بل قصّه قصّا",12,"ص",2,0],["حَمقَى هُمُ حِينَمَا سَارُوا إِلى ظُلَمِ","الأَهوَاءِ تَقتَاتُهُم مُعوَجَّةُ الطُّرِقِ",13,"ق",1,0],["حمقاء قد رحلت على تبع","من نصح بعض الصديقات",14,"ت",1,1],["حمقٌ هيَ الدنيا وأكبرُ ذنبِها","أنّ المسافةَ بالجنون محمّلةْ",15,"ل",2,0]]}