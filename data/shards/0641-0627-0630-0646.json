{"poems":[[75,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[74,"أهلا بها صحف الإمام المسند","https://www.aldiwan.net/poem18563.html","الكامل"],[53,"يا من جلا دهرنا دجاه به","https://www.aldiwan.net/poem65808.html","المنسرح"],[53,"على الطائر الأيمن المرتجى","https://www.aldiwan.net/poem66336.html","المتقارب"],[80,"أوجه البدر يشرق في الظلام","https://www.aldiwan.net/poem14061.html","الوافر"],[87,"ذاد الكرى عن مقلتيك حمام","https://www.aldiwan.net/poem63014.html","الكامل"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[52,"منع النوم طارق من حبابه","https://www.aldiwan.net/poem64856.html","الخفيف"],[48,"دنياك تكنى بأم دفر","https://www.aldiwan.net/poem22338.html","مجزوء البسيط"],[128,"هبلتك أمك والحديث شجون","https://www.aldiwan.net/poem23731.html","الكامل"],[203,"ببابك العالي ذووا حاجة","https://www.aldiwan.net/poem45176.html","السريع"],[272,"كن مثل مولاك إذ قال المليكُ له","https://www.aldiwan.net/poem1144.html",""],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[369,"يا معرضا قد آن أن تتلفتا","https://www.aldiwan.net/poem60975.html","الكامل"],[376,"لا بتماديك على هجري","https://www.aldiwan.net/poem57430.html","السريع"],[382,"أيا أغنياء الروح صونوا كنوزَكم","https://www.aldiwan.net/poem59426.html","الطويل"],[463,"نعم من جميلة إحدى النعم","https://www.aldiwan.net/poem55877.html","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48679","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77640","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77473","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64980","الكامل"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82289","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88707","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94282","الكامل"],[3054,"","https://poetry.dctabudhabi.ae/diwan/poem/124076","الطويل"],[409,"","https://poetry.dctabudhabi.ae/diwan/poem/60283","الكامل"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199170","المتدارك"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133217","الكامل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32451","السريع"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107526","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83577","السريع"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[1012,"السجسج","https://www.poetsgate.com/ViewPoem.aspx?id=186252",""],[4830,"ياسُلطانَ روحي","https://www.poetsgate.com/ViewPoem.aspx?id=209158",""],[5135,"يا ربِّ لطفكَ بالعبادِ","https://www.poetsgate.com/ViewPoem.aspx?id=211015",""],[5431,"طوفان عروبي...","https://www.poetsgate.com/ViewPoem.aspx?id=215568",""],[5937,"الكَمَانيّة","https://www.poetsgate.com/ViewPoem.aspx?id=211898",""],[5939,"جحود","https://www.poetsgate.com/ViewPoem.aspx?id=178579",""],[5939,"دستور العشق","https://www.poetsgate.com/ViewPoem.aspx?id=186983",""],[6212,"طائفية أو فيفية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1624&r=&rc=5",""],[463,"نعمْ منجميلة َ إحدى النِّعمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60321&r=&rc=377",""]],"verses":[["فَإِذ نَحنُ طالَعناهُ وَالأُفقُ لابِسٌ","عَجاجَتَهُ وَالأَرضُ بِالخَيلِ تَرجُفُ",0,"ف",1,0],["فأذن لناظمها وإبراهيمها","تصفى قعودهما بفضلِ محمد",1,"د",1,0],["فأْذنْ له في علاج علَّته","واقبلْ من العُذْر ما نثا وحكى",2,"ك",2,0],["فآذنَ بالفرجِ المُرْتَجَى","وصدَّق رُؤْيَايَ في الخاتم",3,"م",1,0],["فَإِذنُك فيهِ وَاِسلَم لِلأعادي","تُديرُ عَلَيهِمُ كأسَ الحِمامِ",4,"م",1,0],["فَأذَن لِطَيفِكَ أَن يُلِمَّ مُجامِلاً","وَمُؤَمَلٌ مِن طَيفِكَ الإِلمامُ",5,"م",1,0],["فآذَنَتْ بِزَوالٍ عنه مُسْرِعَةً","كما يَزُولُ بِحَلْقِ العانَةِ الشَّعَرُ",6,"ر",1,0],["فَاِذَني لي أَزُركِ أَو سَكِّنيني","بِاِنتِيابٍ لا شَيءَ بَعدَ اِنتِيابَه",7,"ب",2,0],["فَأذَن إِلى هاتِفٍ مُجيدٍ","قامَ عَلى غُصنِهِ الرَطيبِ",8,"ب",1,0],["فإذن ورب الراقصات إلى منى","لا بد من أن يورق الدحنون",9,"ن",1,0],["فأْذُنْ لعل القومَ مثلَ الذي","قادتهُ تلكَ النارُ نحو الهدى",10,"د",2,0],["فأذن بحربٍ يغصُ الماءُ شاربَها","أو أن ندين إلى إحدى التحاسير",11,"ر",1,0],["فأذَن بالانصرافِ","لنا بلا تجافي",12,"ي",1,0],["فأْذَنْ جُعِلْتُ لكَ الفدىمن ماجدٍ","فالأَمْرُ أمرُك نافِياً أو مُثْبِتا",13,"ت",2,0],["فآذنت إمَّا بكفارةٍ","منَّا على الحِلفةِ أو كُفرِ",14,"ر",1,0],["فأذنبتُ واستأنفتُ ذنبي فلم أجد","لنفسي وقد تابت خلاصاً من الحشر",15,"ر",1,0],["فَإِذْناً سلمتَ لهذا الوداع","وإن قلتُها عن فؤاد وجَمْ",16,"م",1,0],["فَأْذَنْ لها أن تستريح فإنه","أضحى خليفتها الحديد الجائل",17,"ل",1,0],["فَأذن كَما وَلَّيتني بعزلي","فَالعزُّ قَد رَأَيت فيهِ ذُلّي",18,"ي",1,0],["فَأذن لِعَبد الذل أَن يَقولا","وَأَن يُؤدي خَطه المَنقولا",19,"ل",2,0],["فأَذَنْ لهُ بالعَدْلِ فيَّ فإِنَّما","صَرْفُ الزِّمانِ كعَبْدِكَ المَأْذونِ",20,"ن",1,0],["فَأُذناكَ إِقواءٌ وَأَنفُكَ مُكفَأٌ","وَعَيناكَ إيطاءٌ فَأَنتَ المُرَقَّعُ",21,"ع",1,0],["فاذن لنا بالسير او فارتحل","لا نسنا عن وحشة الشاطي",22,"ط",2,0],["فأذن بمحو السيات تكرما","فبمحوها أنباء فضلك آدنت",23,"ت",1,0],["فأذناي صماوان عما يقوله","عمير وعمرو والعلا ويزيد",24,"د",1,0],["فأذن غدا شيء يراد به هنا","جسم وذلك ليس بالمستشكل",25,"ل",1,0],["فإذن قاموا معه صدقاً","وأزالوا كل من استعرض",26,"ض",1,0],["فإذن أراني ناجيا","من هول فصلك في القضا",27,"ض",2,0],["فَأَذنِبي إِن كُنتِ لَم تَذنُبي","فِيَّ ذُنوباً إِنَّ رَبّي غَفورُ",28,"ر",1,0],["فأذَن لروحك أن تشارفَ منطقي","فيشوقَ منهُ رونقٌ وشبابُ",29,"ب",1,0],["فَأذن بِفَتحِ القَلبِ عَلّي أَرى","فيهِ محيّاك رَفيعَ الجناب",30,"ب",1,0],["فَأُذنِيَ لَم تَسمَع سِوى نَغمَةِ الهَوى","وَمِنكُم فَإِنّي لا مِنَ الطَيرِ سامِعُ",31,"ع",1,0],["فأذني تطرب في سمعه","إذا ما لساني به تلهج",32,"ج",1,0],["فأذَنْ واِنْ كانت بغمزةِ واحدٍ","كي أدخلَنَّ بَلاطَ حُسنِكَ في ضمانْ",33,"ن",1,0],["فاذنْ بعافيةٍ يزوْلُ بها البلا","إنَّا بعفوكَ يا إلٰهي نطمعُ",34,"ع",1,0],["فأذّن للهبوب بكل فجٍّ","لطوفانٍ عروبيٍّ : أفيقوا",35,"ق",3,0],["فأذن في المدى أمطر نضالا","لقد نشبت بساحتنا حريقُ",35,"ق",1,0],["فإذن ، لنقفزَ ، لا يهم بحبنا","من بعدُ ، أن تتمنطقَ الأذهانُ",36,"ن",1,0],["فإذنْ لها سأقولُها:","أنا لنْ أظلَّ المُرْتَهَنْ",37,"ن",1,0],["فإذنْ لها سأقولُها -","لي في الغرامِ المَعذِرَةْ:",38,"ر",2,0],["فإذنْ.. كيف المعرِّي يشتكي،","ذاتَ شكوى: \"أمْحَلَ الروحُ وشَنّا\"؟",39,"ن",2,0],["فإذناسلمتَ لهذا الوداع","وإن قلتها عن فؤاد وجمء",40,"م",2,0]]}