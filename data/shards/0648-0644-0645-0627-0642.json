33",""],[5038,"حان الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=188122",""],[5277,"منْ أوراق عاشقٍ بغداديٍّ..","https://www.poetsgate.com/ViewPoem.aspx?id=202037",""],[5302,"ما أعذب العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200599",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5409,"تهللت كالعارض الباكر","https://www.poetsgate.com/ViewPoem.aspx?id=155493",""],[5431,"حجار نرد ...","https://www.poetsgate.com/ViewPoem.aspx?id=202747",""],[5616,"وثن","https://www.poetsgate.com/ViewPoem.aspx?id=203456",""],[5672,"صمت النوى","https://www.poetsgate.com/ViewPoem.aspx?id=206499",""],[5690,"لواؤك سيدي عبد الحميد","https://www.poetsgate.com/ViewPoem.aspx?id=172136",""],[6102,"السِّفر اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=186268",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""],[5309,"أيا جارتا نادي الهوى كان نادينا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573874",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6266,"الحب والسور العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82752&r=&rc=0",""]],"verses":[["وَلَمّا قَسا قَلبي وَضاقَت مَذاهِبي","جَعَلتُ الرَجا مِنّي لِعَفوِكَ سُلَّما",0,"م",2,1],["ولمّا قضى المخْتارُ هلْ قامَ بعْدَهُ","بضمِّ شَتاتِ الدّينِ غيْرُ أبي بَكْرِ",1,"ر",1,0],["وَلَمّا قَدَمتَ الجَيشَ بِالأَمسِ أَشرَقَت","إِلَيكَ مِنَ الآمالِ آفاقُها الغُبرُ",2,"ر",1,0],["ولما قضى من سنة اله ما قضى","وقد حسدت منه النجوم المساعيا",3,"ي",2,0],["ولما قضى المولى الإمام محمدٌ","تحكم في الناس الأسى والتأسُّفُ",4,"ف",1,0],["ولما قضيتَ النسكَ عاودت طيبة","وسعيك مبرورٌ وقصدُك منجبُ",5,"ب",1,0],["ولم أقلْ عند ذاك من أسفٍ","سَقياً لدهرٍ تخاذلتْ نُوَبُهْ",6,"ب",2,0],["ولم أقل من ذاك ما قلتُه","إلا بتوفيق وتسديدِ",7,"د",1,0],["ولمَا قلتُ ذاك مُلْتَذَّ مكرو","هك جهلاً ومُسْتَهيناً شديدَكْ",8,"ك",1,0],["ولم أقطع الأدنى مخافةَ شينه","ومني سَماراً كان أو غيره رُضِّي",9,"ض",2,0],["ولما قلتُ هذه مستزيداً","صلةً مستجدةً بل وِصالا",10,"ل",2,0],["ولما قضى الحاثونَ حَثْوَ ترابِهم","عليها وحالتْ دونها مِرَّة الوذمْ",11,"م",1,0],["ولم أْقَصِّرْ بشيبانَ التي بلغتْ","بها المبالغَ أعراقٌ وأغصان",12,"ن",1,0],["وَلَم أَقِف في الرَوضِ عِندَ الضُحى","يُذهِلُني لَونٌ وَشَكلٌ وَطيب",13,"ب",1,0],["وَلَم أَقُل ما كُنتُ مِن قَبَلَما","كُنتُ وَلا ما في سِجِلِّ الغُيوب",13,"ب",1,0],["وَلَمّا قَضى التَوديعُ فينا قَضاءَهُ","رَجَعتُ وَلَكِن لا تَسَل كَيفَ مَرجِعي",14,"ع",2,0],["وَلَمّا قَلَّتِ الإِبلُ اِمتَطينا","إِلى اِبنِ أَبي سُلَيمانَ الخُطوبا",15,"ب",2,0],["وَلَم أَقُل مِثلُكَ أَعني بِهِ","سِواكَ يا فَرداً بِلا مُشبِهِ",16,"ب",2,0],["وَلِما قَد تُقاوِيانِ مَنَ اللَه","وِ بَيانٌ في بيضِ فَودٍ وَسودِه",17,"د",2,0],["وَلَمّا قَصَدنا سُرَّ مَن را تَضاءَلا","وَلا خِضرَ يَقري فيهِما البَدوُ وَالحَضرُ",18,"ر",1,0],["ولَمَّا قابَلَتْ طَرسوسُ غُرّاً","مُحجَّلةً تُقابِلُها السُّعودُ",19,"د",1,0],["وَلَم أَقصِد بِذاكَ سِوى قَبولي","لِمَرسومٍ أَشارَ بِهِ وَأَمري",20,"ر",2,0],["وَلَمّا قَتَلناها بِسَيفِ مِزاجِها","فَبُرَّدَ مِنها الحَرُّ وَاِعتَدَلَ اليَبسُ",21,"س",1,0],["وَلَم أَقرِ بِالمِقراةِ طَرفي بِمِثلِها","فَتَسرَحُ فيها العَينُ وَالصَدرُ يُشرَحُ",22,"ح",1,0],["وَلَمْ أَقُمْ فِي مَقَامَاتٍ وَأَنْدِيَةٍ","شَتَّى الْهَوَى غَيْرَ رِعْدِيدٍ وَلا وَانِي",23,"ن",2,0],["ولمْ أقصدْ بمدحِكَ غيرَ ودٍّ","أروضُ بهِ الزمانَ عن الجماحِ",24,"ح",1,0],["ولما قام ناعيه استطارَتْ","عقولُ الناسِ واضطربَ الأنامُ",25,"م",1,0],["ولما قيلَ للكفارِ خُشْبٌ","تَحَكَّمَ فيهمُ السيفُ الخشِيبُ",26,"ب",1,0],["ولم أقِسْكَ بشيبانٍ وما جَمَعَتْ","لكنّما أنتَ عندي كلُّ رَبْعيّ",27,"ي",1,0],["وَلَمّا قُرِّبَت لِبُكورِ ثَنيٍ","جِمالُ الحَيِّ فَاِنقَعَرَ العَمودُ",28,"د",1,0],["وَلَم أَقنَط لِسوءِ الفِعلِ مِنّي","وَحُقَّ لِمِثلِ فاعِلُها القُنوطُ",29,"ط",1,0],["وَلَم أَقضِ فَرضاً في مِنىً وَبِلادِها","وَكَم عاجِزٍ قَد زارَها مُتَنَفِّلا",30,"ل",2,0],["ولما قضى المختار قام مقامه","واحكم امر الدين في المدن والقفر",31,"ر",1,0],["ولما قرعتمْ بابَ عتبى فتحتُه","وإلا فادخلاه وافبلا ما حييتمُا",32,"م",2,1],["ولما قرأناهُ فرحنا وسرَّنا","كما سرَّ مأنوس الفؤاد وِصَالُ",33,"ل",1,0],["ولما قَرأْتُ النظمَ جاشَتْ قريحتِي","كآذىِّ بحْرِ بالفصاحةٍ مُزْبِدِ",34,"د",1,0],["ولَم أَقرِ الوُفُودَ الشُّمَّ مَهمَا","تُنِخ إِلاَّ المُكَلَلَةَ الجِفَانَا",35,"ن",2,0],["ولَمَّا قِيلَ لِى مَا قِيلَ عَنهُ","عَنِ الإنصَاتِ كَنتُ أخَا امتِنَاعِ",36,"ع",1,0],["ولم أقل إنّها قالت منطقة","إلا على جهة التشبيه والمثل",37,"ل",1,0],["ولم أقل في وقت شبعي بسّي","هذا هو الجهل وعين الوكس",38,"س",1,0],["وَلم أَقُل بِالجَفنِ تخديده","لِأَنَّهُ زاد على الحَدِّ",39,"د",1,0],["ولم أقل السباع لضنّ نفسي","عليه بالجريء من السباع",40,"ع",1,0],["ولم أقضِ في حق الصلاة فريضة","على ذي مقام في الحساب مرفَّع",41,"ع",1,0],["وَلما قصدنا من (حماة) سبيلَها","علونا متونَ الصافناتِ عواديا",42,"ي",2,0],["وَلَم أَقِف يَوماً عَلى سِرِّهِم","ذاكَ الَّذي فيهِ الرِجالُ تَهيمُ",43,"م",1,0],["وَلَم أُقابِلهُ في سَخطٍ بِغِيرِ رِضا","لَيسَ السَليمُ كَمَن ساءَت سَريرَتُهُ",44,"ت",2,0],["ولما قضيت بكاك الصحاب","وأولوك عطفاً لهم يشفع",45,"ع",1,0],["ولمّا قلعْتَ قِلاعَ البُغاةِ","بسَيْفكَ من كُلِّ طَوْدٍ أشَمّ",46,"م",1,0],["ولَمَّا قُلتُ إنَّ الشعر يَسعَى","لقَلبي في الخَلاصِ سَعَى عَليهِ",47,"ي",2,0],["ولما قَسَمنا الليلَ قِسمَينِ قرَّبا","مَزارَ التي شَطَّت عنِ العينِ دورُها",48,"ر",3,0],["ولما قضى من كل شيء مرامه","وزاد له حباً قضى عنده نحْبا",49,"ب",2,0],["وَلَمّا قضى دون أَترابِهِ","تَيَقَّنتُ أَنَّ الرَدى يَنتَقي",50,"ق",2,0],["ولمّا قَضَتَ منِّي الحياةُ مآرباً","وقد تركوني في المقابر أعْظُما",51,"م",2,1],["ولما قضى نودي تنعم مؤرخاً","ونل فرحاً في جنة الخلد جرجسُ",52,"س",1,0],["ولما قل من عسر دخاني","وفرغنا الجراب مع الخبيّه",53,"ي",2,0],["ولمّا قلّ عنها التبغ صارت","له ماسورة تبغي المنيّه",53,"ي",2,0],["ولم أُقَلْقِلْ رِكابي إِنْ نَبَا وطَنٌ","ولا أَطَلْتُ اغترابي إِنْ نَأَى وَطَر",54,"ر",1,0],["ولم أَقِسْ منظرَ الرياضِ به","حُسْناً ولكن ضَرَبْتُها مَثَلا",55,"ل",2,0],["ولم أقتنعْ بالفرْضِ فالفضلُ إنّما","يكونُ إذا حققتَهُ للتّطوّعِ",56,"ع",1,0],["ولما قرّ لم يعهَدْ نُزولاً","ولما فرّ لم يحْمِدْ نِزالا",57,"ل",2,0],["ولم أقُلْهُ سبباً","لطائلٍ من نشَبِ",58,"ب",1,0],["ولم اقترف ذنبا وأجن جناية","ولكن سعت للسع في الأراقم",59,"م",1,0],["ولما قضينا بالدعاء طوافنا","نقعنا الصدى من زمزم قبل غسلنا",60,"ن",2,0],["ولما قضى سيرُها ما قضى","لنا الله من نيل أسنَى القِسمْ",61,"م",1,0],["ولم أقف باكياً على حقف نع","مان ولا شاكياً إلى غصنه",62,"ن",2,0],["وَلَم أَقضي لِإِنسانٍ حُقوقُها","إِذا ما كانَ لا يَقضي حُقوقي",63,"ق",2,0],["ولمَّا قبلتُمْ عبدَكُمْ يا أحبَّتي","غَدا طوْلُكُمْ في طَوْرِ سرِّي مُراقِبي",64,"ب",2,0],["ولمّا قدرتُمْ بعد عَجْزٍ أسأتُمُ","وكم عفّ عن سوءٍ بنا غيرُ قادِرِ",65,"ر",1,0],["ولمّا قُرعنا بالنّوى حين غفلةٍ","تجلّدتُ مشتاقاً لتحسبني جَلْدا",66,"د",2,0],["ولمّا قضَوْا أوطارَهمْ منه ودّعوا","وأرزاقُهمْ من ضيقهنّ فرُوجُ",67,"ج",1,0],["وَلَم أَقضِ أَدنى حَقِّهِ غَيرَ أَنَّني","أُبَهرِجُ في تَأبينِهِ وَأُزَخرِفُ",68,"ف",1,0],["ولم أقل هذا على الإنكار","لقتله بل لادعا الأشرار",69,"ر",1,0],["ولم أَقصِّرْ دونَ نَيْلِ المنى","لأَنَّني مَا كُنْتُ في سُخْرَه",70,"ر",2,0],["ولم أَقُلْ لَيْت قَوْمِي يعلمُون بِما","أَضْحَى عَليه ثَرائِي بَعْدَ إِفْلاَسِي",71,"س",2,0],["وَلَما قَضوا حَق العِناق وَكَفكَفوا","غَوارب دَمع قَد أَزالوه فَانهلا",72,"ل",2,0],["ولم أقل مناصل تجردت","وأكرزت بجانب الأغماد",73,"د",1,0],["وَلَمّا قَعِنت أَنّ الكِرامَ قَليلةٌ","فَقُلتُ لَها إِنّ الكِرامَ قَليلُ",74,"ل",1,0],["وَلَمّا قَضى نَحباً فَأَمطَرَتِ السّما","وَجادَت عقيبَ الدفنِ سَحّاً عَلى الرمسِ",75,"س",1,0],["ولما قضى بالبيت ما كان واجباً","عليه وأضحى فارهاً بنعيمها",76,"م",3,0],["ولم أقصد بهَا تعيينَ","لا رِقَة ولا تِبْرِ",77,"ر",1,0],["ولما قدمت رأيت النّدى","يرف عليك أماما وخلفات",78,"ف",3,0],["وَلَمَّا قَدمْنَا الثَّغْرَ خِلْنَا بروجَهُ","كَأكْمَامِ أزْهارٍ وآفَاقِ شُهْبَانِ",79,"ن",1,1],["ولما قَفلت إلى ما وراءَ","الغُيومِ وَحجَّبك الكَوكَبُ",80,"ب",1,0],["ولما قضى أن تكون الدليل","لنفي المثيل له مثلك",81,"ك",1,0],["ولم أقضِ حَقَّ العلمِ إن كان كُلَّمَا","بدا طَمَعٌ صَيَّرتُه لي سُلَّما",82,"م",2,0],["ولما قضى التعريف والشمس آذنت","وقد أزف الترحال أن تتحجبا",83,"ب",2,0],["ولما قضى نسكاً مناسك حجه","نحا يثرباً لا أبعد الله يثربا",83,"ب",2,0],["ولما قضوا منهم لباناتهم قضوا","وخروا لشكر الله فوق السباسب",84,"ب",1,0],["وَلَمَّا قَضَتْ حَقَّهُ أَسْرَعَتْ","بِرُجْعَى امْتِثَالاً لَهُ وَائْتِمَارَا",85,"ر",2,0],["ولما قد نعى إسماعيل ناعٍ","له الدمع استهل دماً مذابا",86,"ب",2,0],["ولمَّا قضى للعُلى حقَّها","وشيَّد بالسيف بُنيانَها",87,"ن",3,0],["ولما قضى في حفظ ملك مليكه","مدى عمره الوافى الى منتهى الحد",88,"د",1,0],["ولم أقض اللبانة من كلاب","غداة غدوأذن بالفراق",89,"ق",1,0],["ولم أقدر على إخفاء حال","يحول بها الأسى دون التأسي",90,"س",2,0],["وَلَم أَقُل إِن جَفَتني مَن أَهيمُ بِها","يا قَلبُ ذُب أَلَماً يا أَدمُعُ اِنهَمِري",91,"ر",2,0],["ولما قضينا للإله مناسكاً","ذكرناه والمطلوب منه سألناه",92,"ن",3,0],["ولما قضى عبد العزيز بن جعفر","وأردفه رزء النصير محمد",93,"د",1,1],["ولما قضى نحبه بغتةً","أخونا أبو بكر اليوسفي",94,"ي",1,1],["ولما قضوا حق المكارم والعلى","بيض المواضي والمطهمة الجرد",95,"د",1,0],["ولما قضينا الليل إلا اقله","ونحن كما شاءَ الهوى الغافل الغر",96,"ر",1,1],["ولَم أقصِد ذُرا فَضلٍ سواكُم","ولو نَشِبَت بِضَبعيَّ الحمامُ",97,"م",1,0],["ولم أقضِ لُباناتي","من البِيضِ الرَّعابيبِ",98,"ب",1,0],["ولم أقل ذاك عن سوءٍ يخالجني","بل قلته أدبا مع سيِّدٍ صمد",99,"د",1,0],["ولم أقل فيه ذاك إلا","من أجل من لم ينل بضده",100,"د",2,0],["ولم أقتل القبطيّ لكنْ زجرتُه","بعلمي فلم تعسر عليَّ المواضع",101,"ع",1,0],["ولم أقل عجّل لنا قطنا","سخرية يا خيرَ مشهودِ",102,"د",1,0],["ولم أقل بحلولٍ","بل كنتُ منه بريّا",103,"ي",2,0],["ولما قدمت الآن زاد سرورنا","ومقدمك الأسنى بذاك قمين",104,"ن",1,0],["ولما قضيت الفرض من لثم تربةٍ","مطهرةٍ تطوي على كل طاهر",105,"ر",1,0],["ولما قفلنا منه كان نزولنا","على لابن في حي موسى وتامر",105,"ر",1,0],["ولما قضينا فرضنا وتحدثت","بضائعنا عن متجر غير خاسر",105,"ر",1,0],["وَلَم أَقُل لَم أُساقِ المَوتَ شارِبَهُ","في كَأسِهِ وَالمَنايا شُرَّعٌ وُرُدُ",106,"د",1,0],["ولما قضينا من منى كل حاجة","وتمت لنا فيها المنى والمنايح",107,"ح",1,1],["ولما قادنا معه هواه","وازمعنا الخروج من الخيام",108,"م",1,0],["ولما قضى حكم الهوى للفواطِمِ","وكلٌّ بذا فخراً سمت للنعائمِ",109,"م",1,1],["ولمَّا قد رأيتُ الشيبَ وَافَى","رجعت بعزمتي عن ذي الجَنابِ",110,"ب",1,0],["وَلَما قَضى مَكشوفُ جُحرٍ سَعى إِلى","جَنازتِهِ مَشياً ذوو العَقدِ وَالحلِّ",111,"ل",1,0],["وَلَما قَضى ذو السَطحِ قامَ مَشايخٌ","بِدَعوتِهِ فَوقَ السُطوحِ فَيَستَعلِي",111,"ل",2,0],["وَلَمّا قَضى الرَحمَنُ إِنفاذ حُكمِهِ","وَكُلُّ الَّذي قَد حُمَّ لا شَكَّ واقِعُ",112,"ع",1,0],["ولم أقترف إثما يميت معاذري","ولا جئت ذنبا يترك العفو عاجزا",113,"ز",2,0],["ولما قضى نسكاً وادي زيارة","ولاحت على الأوطان منه تباشير",114,"ر",1,0],["ولم أقم بالذي قاموا به كسلا","وليس إلا الهوى لي عائق ربثا",115,"ث",2,0],["ولم أقفُ غثر الظعن والليلُ شامل","بوهم إذا كلّ المراسيل خذرَفا",116,"ف",2,0],["وَلَم أقطَع الوطواطَ بخُلاً بكُحْله","ولا أنا مَنْ يُعييه يوماً تَرَدُّدُ",117,"د",1,1],["ولم أقصد هجا شخص ولكن","هجوت بهجوه ضعة الطباع",118,"ع",1,0],["وَلَما قَصَدناه تَرَكنا عيالنا","وَأَولادنا الأَطفال وَالبَلدة الزورا",119,"ر",2,0],["ولما قضينا الحج جئنا بعمرة","بها تم ما رمنا بشد الرواحل",120,"ل",1,0],["ولما قلعت الباب لم يبق باذخ","لتلك الحصون الشم الاتزلزلا",121,"ل",2,0],["ولما قضى قامت بنوه مقامه","لرد الأعادي عنه بالبيض والسمر",122,"ر",1,0],["ولمّا قَطَعنا مُروج الشّبابِ","ونهر التّصابي ووادي الغرام",123,"م",1,0],["ولما قضوا من ذمة المجد حقها","وصانوا حمى التوحيد من شعث شاعث",124,"ث",1,0],["ولمْ أقْرَعْ لهُ أسَفاً ثَنيَّهْ","فكمْ قد بتُّ فيه رَهينَ وجْدِ",125,"د",1,0],["ولما قضى أوحى الجليل لأحمدٍ","عدمت نصيراً في جواري فهاجر",126,"ر",1,0],["وَلما قَضى صَبري عَلى البُعد بَعده","وَأَصبَح تاريخاً حسين مَضى صَبري",127,"ر",2,0],["ولمَّا قضى التوديعِ فينا قضاءهُ","وزفَت مطايا البين رَكب الترحُّل",128,"ل",1,1],["ولم أقف بينكم والعين تحدقني","حتى يقال فتى الأشعار بازيها",129,"ي",3,0],["ولما قضى المختار نحباً تنفست","نفوس كثير رغبة في انتقامها",130,"م",3,0],["ولما قضى سعد الرضى في قريضة","بان يستر قوا والرجال تقتل",131,"ل",1,0],["ولم أقطع أخاً لأخٍ طريف","ولم يذمم لطرفته وصالي",132,"ل",2,0],["وَلَمْ أَقُلْ لِيَدِ السَّاقي وَوَجْنَتِهِ","جَلَّ المُؤَلِّفُ بَينَ المَاءِ وَاللَّهَبِ",133,"ب",1,0],["وَلَم اِقتُلُكُم سِرّاً وَلَكِن","عَلانِيَةً وَقَد سَطَعَ الغُبارُ",134,"ر",1,0],["ولما قيل محيي الدين أودى","عرفنا صولة الدهر الغشوم",135,"م",1,0],["ولم أقدر على تأليفِ ما في","فُؤادي من غرامٍ واشتياقِ",136,"ق",1,0],["ولم أقدم على وصل التصابي","مخافة أن أدنسه بعاب",137,"ب",1,0],["ولم أقصر لدى حفظ الوداد ولا","جرت إلى نحو إخلاصي لك التهم",138,"م",1,0],["ولما قضت منه ارتشافاً وأرجعت","لهيرا فزفسٌ صاح يبلغ ما القصد",139,"د",1,0],["ولما قضت منك الليالي بأوبه","غفرنا لها ما كان من سالف الذنب",140,"ب",1,0],["ولما قضى اللَه العليم بأنه","سيرمي من المقدور سهما مسددا",141,"د",2,0],["ولما قضى المحمود ذكراً أقره","عليه ابنه عبدالمجيد وأبقاه",142,"ا",2,0],["ولما قصدْنا من دمشقَ غباغباً","وبتنا من الشوقِ الممض على الجمرِ",143,"ر",1,0],["ولما قد أجادَ عليهِ ملكٌ","بنيشانٍ حوى سعدَ السعودِ",144,"د",1,0],["ولما قد حدا الحادي فحنَّت","وجدَت بالمسير كما الطيورِ",145,"ر",1,0],["ولما قد تَسامَت بَعلبَكٌّ","على الأمصار في عدم النظيرِ",146,"ر",1,0],["ولمّا قد توى وثوى برمسٍ","وغاب البدر وانسدل الحجابُ",147,"ب",1,0],["ولما قد تغرَّب عن ديارً","كشمس أوحشت عند المغيبِ",148,"ب",1,0],["ولما قد أتى الجنات نادى","لهُ جبريل أهلاً يا عَسوبُ",149,"ب",1,0],["ولمَّا قطعنا جسر بالس عرَّجت","صدور ركابي نحوها غير محجم",150,"م",1,0],["ولما قضت منه أمينة ما قضت","نبا بصري عنه وكل لساني",151,"ن",2,0],["ولما قَضَوا حقَّ السَّلام عليكم","وقضِّيَ من تقبيل يُمناك واجبه",152,"ب",2,0],["وَلَم أَقُد غارَةً مُلَملَمَةً","فيها بَناتُ الصَريحِ تَنتَحِبُ",153,"ب",1,0],["ولم أقل سقام جسمي عرض","به يشان جوهر اعتقادي",154,"د",2,0],["وَلمّا قرأْتُ بها لَوْعَتي","عَلَيْها انْهِمارُ هُمومِي بَدا",155,"د",2,0],["ولما قضى سعد الرضى في قريظة","بأن يسترقوا والرجال تقتل",156,"ل",1,0],["ولَمَّا قَصِيرُ العُمرِ ألْقَى برأسِهِ","على البابِ, نادَونا وقالوا تَمَخَّضَا !",157,"ض",2,0],["ولما قمت منصرفاً لشأني","تذكرت الصلاة على الطريق",158,"ق",1,0],["ولمْ أقْطفْ رياحينَ التّهاني","ولمْ أُطْعمْ رحيقاً مِنْ لَماكا",159,"ك",2,0],["ولمْ أُقبلْ على \"بغدادَ\" إلَّا","كعيدٍ يبتغي في الأهلِ عيدا",160,"د",2,0],["ولم أقل للفؤاد اقض اللبانة من","خل وعاتبه واستأذنه وانصرف",161,"ف",1,0],["ولم أقصر بتفريط الحقوق بلى","قصرت عند رجوعهم يوم سيرهم",162,"م",1,0],["ولمَّا قد أحسَّ الموت داني","إلى الشيخ العجوز وكان نائي",163,"ا",2,0],["ولما قتلت إذا بالزما","ن يميط اللثام عن الظافر",164,"ر",1,0],["ولم أقرأ سوى حظٍ يتيمٍ","على حدّ العناقِ المستبدِ!!",165,"د",1,0],["ولم أقل إنه عبءٌ على لغتي","وصخرة تحتها ظهري الشديد حنى",166,"ن",2,0],["ولم اقدر على السلوى","ولو شئت...ولو رمتُ",167,"ت",1,0],["ولما قام منصور بحرب","شرارتها بأحشاء الحسود",168,"د",1,0],["وَلَمَّا قِيلَ لِي: (اصعَدْ), قُلتُ: (كَلَّا","غَرِيمُكُ- أَيُّها الطُّوفانُ- نُوحُ!)",169,"ح",1,0],["ولما قضى للهندواني حقه","وفت بأجناد ابن حرب بوارها",170,"ر",3,0],["وَلَمّا قَضَينا العُمرَ إِلا سُوَيعَةً","تَراءَى لَنا أَنّا بَلَغنا أَمانِينا",171,"ن",2,0],["ولم أقدم صالحاً من العمل","أجاهر النعمة مني بالبطر",172,"ر",1,0],["ولِمَ اقترفتِ الحرب، ثم تركتني..","لأخوض وحدي في هواك نزالي؟!",173,"ل",2,0]]}