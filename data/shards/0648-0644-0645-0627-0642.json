{"poems":[[57,"ولما قسا قلبي وضاقت مذاهبي","https://www.aldiwan.net/poem24634.html","الطويل"],[77,"هنيئا بما خولت من رفعة القدر","https://www.aldiwan.net/poem36504.html","الطويل"],[73,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[83,"معاذ الهوى أن أصحب القلب ساليا","https://www.aldiwan.net/poem54225.html","الطويل"],[83,"عزاء فإن الشجو قد كان يسرف","https://www.aldiwan.net/poem54270.html","الطويل"],[72,"قدمت قدوم الغيث والحي مجذب","https://www.aldiwan.net/poem18238.html","الطويل"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"عيدان مجموعان في عيد","https://www.aldiwan.net/poem11441.html","السريع"],[51,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[51,"لئن كنت في حفظي لما أنا مودع","https://www.aldiwan.net/poem64943.html","الطويل"],[51,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[70,"رويدك قد أفنيت يا بين أدمعي","https://www.aldiwan.net/poem42833.html","الطويل"],[43,"ضروب الناس عشاق ضروبا","https://www.aldiwan.net/poem9501.html","الوافر"],[43,"آخر ما الملك معزى به","https://www.aldiwan.net/poem9512.html","السريع"],[45,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[45,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[61,"وقائع مثل ما بدأت تعود","https://www.aldiwan.net/poem51729.html","الوافر"],[66,"أجزت لسيدي ومليك رقي","https://www.aldiwan.net/poem38509.html","الوافر"],[66,"تشارك فيها الشم والذوق واللمس","https://www.aldiwan.net/poem39209.html","الطويل"],[66,"صفاح عيون لحظها ليس يصفح","https://www.aldiwan.net/poem40986.html","الطويل"],[87,"ما أطيب العيش لولا أنه فاني","https://www.aldiwan.net/poem8209.html","البسيط"],[69,"أأقتل بين جدك والمزاح","https://www.aldiwan.net/poem28551.html","الوافر"],[69,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[50,"أعادك طيفها وبما يعود","https://www.aldiwan.net/poem63923.html","الوافر"],[46,"تنوط بنا الحوادث كل ثقل","https://www.aldiwan.net/poem22902.html","الوافر"],[46,"دع الراح في راح الغواة مدارة","https://www.aldiwan.net/poem23160.html","الطويل"],[113,"بعزم امير المؤمنين ابي بكر","https://www.aldiwan.net/poem41100.html","عموديه"],[126,"ولما قرعتم باب عتبى فتحته","https://www.aldiwan.net/poem50522.html","الطويل"],[126,"يتم سروري إن رأيتك مقبلا","https://www.aldiwan.net/poem50541.html","الطويل"],[126,"أتاني كتاب من سليل محمد","https://www.aldiwan.net/poem50631.html","الطويل"],[130,"أجدك أن بينهم أن آنا","https://www.aldiwan.net/poem54722.html","الوافر"],[130,"دعا للبين من أسماء داع","https://www.aldiwan.net/poem54804.html","الوافر"],[184,"باتت تلوم على طول الونى وغدت","https://www.aldiwan.net/poem43360.html","البسيط"],[184,"وليلة حسبت فيها نفسي","https://www.aldiwan.net/poem43726.html","الرجز"],[223,"تبسمت عن جوهر العقد","https://www.aldiwan.net/poem55243.html","السريع"],[227,"عدلت عن المقال إلى السماع","https://www.aldiwan.net/poem50959.html","الوافر"],[279,"أيذهب يوم لم أكفر ذنوبه","https://www.aldiwan.net/poem1372.html",""],[296,"ذر النفس لا يود الأسى بذمائها","https://www.aldiwan.net/poem36289.html","عموديه"],[302,"يا من هواهم في فؤادي مقيم","https://www.aldiwan.net/poem16774.html","الخفيف"],[318,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[340,"شهيد البلاد ألا تسمع","https://www.aldiwan.net/poem55345.html","المتقارب"],[362,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60657.html","المتقارب"],[369,"ومعتذر العذار إلى فؤادي","https://www.aldiwan.net/poem56975.html","الوافر"],[369,"لئن حجبت نجل العيون وحورها","https://www.aldiwan.net/poem57450.html","الطويل"],[400,"خليلي هبا فالنسيم بكم هبا","https://www.aldiwan.net/poem34164.html","الطويل"],[403,"أتى الدهر من حيث لا أتقي","https://www.aldiwan.net/poem50144.html","المتقارب"],[413,"ولما قضت مني الحياة مآربا","https://www.aldiwan.net/poem53866.html","الطويل"],[426,"بني لابيلا بذا اللحد قد ثوى","https://www.aldiwan.net/poem39831.html","الطويل"],[426,"وجارية لطهماز ربية","https://www.aldiwan.net/poem40857.html","الوافر"],[429,"زهرن فاعجب لروض ماله زهر","https://www.aldiwan.net/poem12341.html","البسيط"],[429,"يا حافظا طاول السماك علا","https://www.aldiwan.net/poem12400.html","المنسرح"],[429,"طلعت ربيعا من ربيع وأربع","https://www.aldiwan.net/poem12659.html","الطويل"],[429,"أظن البدر نازعك الكمالا","https://www.aldiwan.net/poem12760.html","الوافر"],[429,"راخ لها في السبب","https://www.aldiwan.net/poem12774.html","مجزوء الرجز"],[434,"أشاقتك من أطلال ليلى معالم","https://www.aldiwan.net/poem2587.html","الطويل"],[438,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[456,"نعم من جميلة إحدى النعم","https://www.aldiwan.net/poem55877.html","المتقارب"],[462,"من هم المضنى ومن شجنه","https://www.aldiwan.net/poem3411.html","عموديه"],[466,"إذا احتجب الصديق عن الصديق","https://www.aldiwan.net/poem59796.html","الوافر"],[498,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[549,"ألوما على لوم وأنتم بنجوة","https://www.aldiwan.net/poem47775.html","الطويل"],[549,"وخبرتها يوم التقينا بذي النقا","https://www.aldiwan.net/poem47857.html","الطويل"],[549,"سقى دارها حيث استقرت بها النوى","https://www.aldiwan.net/poem47910.html","الطويل"],[561,"هو الأجل الموقوت لا يتخلف","https://www.aldiwan.net/poem13603.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"يا ليلة مرت لنا حلوه","https://www.aldiwan.net/poem2949.html","السريع"],[573,"نسيم ربعك أفديه بأنفاسي","https://www.aldiwan.net/poem3057.html","البسيط"]],"verses":[["وَلَمّا قَسا قَلبي وَضاقَت مَذاهِبي","جَعَلتُ الرَجا مِنّي لِعَفوِكَ سُلَّما",0,"م",2,1],["ولمّا قضى المخْتارُ هلْ قامَ بعْدَهُ","بضمِّ شَتاتِ الدّينِ غيْرُ أبي بَكْرِ",1,"ر",1,0],["وَلَمّا قَدَمتَ الجَيشَ بِالأَمسِ أَشرَقَت","إِلَيكَ مِنَ الآمالِ آفاقُها الغُبرُ",2,"ر",1,0],["ولما قضى من سنة اله ما قضى","وقد حسدت منه النجوم المساعيا",3,"ي",2,0],["ولما قضى المولى الإمام محمدٌ","تحكم في الناس الأسى والتأسُّفُ",4,"ف",1,0],["ولما قضيتَ النسكَ عاودت طيبة","وسعيك مبرورٌ وقصدُك منجبُ",5,"ب",1,0],["ولم أقلْ عند ذاك من أسفٍ","سَقياً لدهرٍ تخاذلتْ نُوَبُهْ",6,"ب",2,0],["ولم أقل من ذاك ما قلتُه","إلا بتوفيق وتسديدِ",7,"د",1,0],["ولمَا قلتُ ذاك مُلْتَذَّ مكرو","هك جهلاً ومُسْتَهيناً شديدَكْ",8,"ك",1,0],["ولم أقطع الأدنى مخافةَ شينه","ومني سَماراً كان أو غيره رُضِّي",9,"ي",1,0],["ولما قلتُ هذه مستزيداً","صلةً مستجدةً بل وِصالا",10,"ل",2,0],["ولما قضى الحاثونَ حَثْوَ ترابِهم","عليها وحالتْ دونها مِرَّة الوذمْ",11,"م",1,0],["ولم أْقَصِّرْ بشيبانَ التي بلغتْ","بها المبالغَ أعراقٌ وأغصان",12,"ن",1,0],["وَلَم أَقِف في الرَوضِ عِندَ الضُحى","يُذهِلُني لَونٌ وَشَكلٌ وَطيب",13,"ب",1,0],["وَلَم أَقُل ما كُنتُ مِن قَبَلَما","كُنتُ وَلا ما في سِجِلِّ الغُيوب",13,"ب",1,0],["وَلَمّا قَضى التَوديعُ فينا قَضاءَهُ","رَجَعتُ وَلَكِن لا تَسَل كَيفَ مَرجِعي",14,"ي",1,0],["وَلَمّا قَلَّتِ الإِبلُ اِمتَطينا","إِلى اِبنِ أَبي سُلَيمانَ الخُطوبا",15,"ب",2,0],["وَلَم أَقُل مِثلُكَ أَعني بِهِ","سِواكَ يا فَرداً بِلا مُشبِهِ",16,"ب",2,0],["وَلِما قَد تُقاوِيانِ مَنَ اللَه","وِ بَيانٌ في بيضِ فَودٍ وَسودِه",17,"د",2,0],["وَلَمّا قَصَدنا سُرَّ مَن را تَضاءَلا","وَلا خِضرَ يَقري فيهِما البَدوُ وَالحَضرُ",18,"ر",1,0],["ولَمَّا قابَلَتْ طَرسوسُ غُرّاً","مُحجَّلةً تُقابِلُها السُّعودُ",19,"د",1,0],["وَلَم أَقصِد بِذاكَ سِوى قَبولي","لِمَرسومٍ أَشارَ بِهِ وَأَمري",20,"ي",1,0],["وَلَمّا قَتَلناها بِسَيفِ مِزاجِها","فَبُرَّدَ مِنها الحَرُّ وَاِعتَدَلَ اليَبسُ",21,"س",1,0],["وَلَم أَقرِ بِالمِقراةِ طَرفي بِمِثلِها","فَتَسرَحُ فيها العَينُ وَالصَدرُ يُشرَحُ",22,"ح",1,0],["وَلَمْ أَقُمْ فِي مَقَامَاتٍ وَأَنْدِيَةٍ","شَتَّى الْهَوَى غَيْرَ رِعْدِيدٍ وَلا وَانِي",23,"ي",1,0],["ولمْ أقصدْ بمدحِكَ غيرَ ودٍّ","أروضُ بهِ الزمانَ عن الجماحِ",24,"ح",1,0],["ولما قام ناعيه استطارَتْ","عقولُ الناسِ واضطربَ الأنامُ",25,"م",1,0],["ولما قيلَ للكفارِ خُشْبٌ","تَحَكَّمَ فيهمُ السيفُ الخشِيبُ",26,"ب",1,0],["ولم أقِسْكَ بشيبانٍ وما جَمَعَتْ","لكنّما أنتَ عندي كلُّ رَبْعيّ",27,"ي",1,0],["وَلَمّا قُرِّبَت لِبُكورِ ثَنيٍ","جِمالُ الحَيِّ فَاِنقَعَرَ العَمودُ",28,"د",1,0],["وَلَم أَقنَط لِسوءِ الفِعلِ مِنّي","وَحُقَّ لِمِثلِ فاعِلُها القُنوطُ",29,"ط",1,0],["وَلَم أَقضِ فَرضاً في مِنىً وَبِلادِها","وَكَم عاجِزٍ قَد زارَها مُتَنَفِّلا",30,"ل",2,0],["ولما قضى المختار قام مقامه","واحكم امر الدين في المدن والقفر",31,"ر",1,0],["ولما قرعتمْ بابَ عتبى فتحتُه","وإلا فادخلاه وافبلا ما حييتمُا",32,"م",2,1],["ولما قرأناهُ فرحنا وسرَّنا","كما سرَّ مأنوس الفؤاد وِصَالُ",33,"ل",1,0],["ولما قَرأْتُ النظمَ جاشَتْ قريحتِي","كآذىِّ بحْرِ بالفصاحةٍ مُزْبِدِ",34,"د",1,0],["ولَم أَقرِ الوُفُودَ الشُّمَّ مَهمَا","تُنِخ إِلاَّ المُكَلَلَةَ الجِفَانَا",35,"ن",2,0],["ولَمَّا قِيلَ لِى مَا قِيلَ عَنهُ","عَنِ الإنصَاتِ كَنتُ أخَا امتِنَاعِ",36,"ع",1,0],["ولم أقل إنّها قالت منطقة","إلا على جهة التشبيه والمثل",37,"ل",1,0],["ولم أقل في وقت شبعي بسّي","هذا هو الجهل وعين الوكس",38,"س",1,0],["وَلم أَقُل بِالجَفنِ تخديده","لِأَنَّهُ زاد على الحَدِّ",39,"د",1,0],["ولم أقل السباع لضنّ نفسي","عليه بالجريء من السباع",40,"ع",1,0],["ولم أقضِ في حق الصلاة فريضة","على ذي مقام في الحساب مرفَّع",41,"ع",1,0],["وَلما قصدنا من (حماة) سبيلَها","علونا متونَ الصافناتِ عواديا",42,"ي",2,0],["وَلَم أَقِف يَوماً عَلى سِرِّهِم","ذاكَ الَّذي فيهِ الرِجالُ تَهيمُ",43,"م",1,0],["وَلَم أُقابِلهُ في سَخطٍ بِغِيرِ رِضا","لَيسَ السَليمُ كَمَن ساءَت سَريرَتُهُ",44,"ت",2,0],["ولما قضيت بكاك الصحاب","وأولوك عطفاً لهم يشفع",45,"ع",1,0],["ولمّا قلعْتَ قِلاعَ البُغاةِ","بسَيْفكَ من كُلِّ طَوْدٍ أشَمّ",46,"م",1,0],["ولَمَّا قُلتُ إنَّ الشعر يَسعَى","لقَلبي في الخَلاصِ سَعَى عَليهِ",47,"ي",2,0],["ولما قَسَمنا الليلَ قِسمَينِ قرَّبا","مَزارَ التي شَطَّت عنِ العينِ دورُها",48,"ر",3,0],["ولما قضى من كل شيء مرامه","وزاد له حباً قضى عنده نحْبا",49,"ب",2,0],["وَلَمّا قضى دون أَترابِهِ","تَيَقَّنتُ أَنَّ الرَدى يَنتَقي",50,"ي",1,0],["ولمّا قَضَتَ منِّي الحياةُ مآرباً","وقد تركوني في المقابر أعْظُما",51,"م",2,1],["ولما قضى نودي تنعم مؤرخاً","ونل فرحاً في جنة الخلد جرجسُ",52,"س",1,0],["ولما قل من عسر دخاني","وفرغنا الجراب مع الخبيّه",53,"ي",2,0],["ولمّا قلّ عنها التبغ صارت","له ماسورة تبغي المنيّه",53,"ي",2,0],["ولم أُقَلْقِلْ رِكابي إِنْ نَبَا وطَنٌ","ولا أَطَلْتُ اغترابي إِنْ نَأَى وَطَر",54,"ر",1,0],["ولم أَقِسْ منظرَ الرياضِ به","حُسْناً ولكن ضَرَبْتُها مَثَلا",55,"ل",2,0],["ولم أقتنعْ بالفرْضِ فالفضلُ إنّما","يكونُ إذا حققتَهُ للتّطوّعِ",56,"ع",1,0],["ولما قرّ لم يعهَدْ نُزولاً","ولما فرّ لم يحْمِدْ نِزالا",57,"ل",2,0],["ولم أقُلْهُ سبباً","لطائلٍ من نشَبِ",58,"ب",1,0],["ولم اقترف ذنبا وأجن جناية","ولكن سعت للسع في الأراقم",59,"م",1,0],["ولما قضينا بالدعاء طوافنا","نقعنا الصدى من زمزم قبل غسلنا",60,"ن",2,0],["ولما قضى سيرُها ما قضى","لنا الله من نيل أسنَى القِسمْ",61,"م",1,0],["ولم أقف باكياً على حقف نع","مان ولا شاكياً إلى غصنه",62,"ن",2,0],["وَلَم أَقضي لِإِنسانٍ حُقوقُها","إِذا ما كانَ لا يَقضي حُقوقي",63,"ي",1,0],["ولمَّا قبلتُمْ عبدَكُمْ يا أحبَّتي","غَدا طوْلُكُمْ في طَوْرِ سرِّي مُراقِبي",64,"ب",2,0],["ولمّا قدرتُمْ بعد عَجْزٍ أسأتُمُ","وكم عفّ عن سوءٍ بنا غيرُ قادِرِ",65,"ر",1,0],["ولمّا قُرعنا بالنّوى حين غفلةٍ","تجلّدتُ مشتاقاً لتحسبني جَلْدا",66,"د",2,0],["ولمّا قضَوْا أوطارَهمْ منه ودّعوا","وأرزاقُهمْ من ضيقهنّ فرُوجُ",67,"ج",1,0],["وَلَم أَقضِ أَدنى حَقِّهِ غَيرَ أَنَّني","أُبَهرِجُ في تَأبينِهِ وَأُزَخرِفُ",68,"ف",1,0],["ولم أقل هذا على الإنكار","لقتله بل لادعا الأشرار",69,"ر",1,0],["ولم أَقصِّرْ دونَ نَيْلِ المنى","لأَنَّني مَا كُنْتُ في سُخْرَه",70,"ر",2,0],["ولم أَقُلْ لَيْت قَوْمِي يعلمُون بِما","أَضْحَى عَليه ثَرائِي بَعْدَ إِفْلاَسِي",71,"ي",1,0]]}