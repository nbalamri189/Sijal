{"poems":[[47,"يا حسن مبدى الخيل في بكورها","https://www.aldiwan.net/poem63629.html","الرجز"],[47,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[47,"ألا شعرت برحلة الأظعان","https://www.aldiwan.net/poem66685.html","الكامل"],[107,"يا بريد النيل إن جئت الشآما","https://www.aldiwan.net/poem42115.html","الرمل"],[154,"أسير الخطايا عند بابك واقف","https://www.aldiwan.net/poem68446.html","الطويل"],[310,"أفاطم لو شهدت ببطن","https://www.aldiwan.net/poem56516.html","الوافر"],[370,"أفاطم لو شهدت ببطن خبت","https://www.aldiwan.net/poem44361.html","الوافر"],[463,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[520,"دنا العيد هنيت أمثاله","https://www.aldiwan.net/poem12240.html","المتقارب"],[563,"توبة النفس في الهوى أن تموتا","https://www.aldiwan.net/poem33557.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63716","البسيط"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132329","الطويل"],[5111,"حَيَاةُالشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=212302",""]],"verses":[["تَبهى بِهِ وَهوَ عَلى سَريرِها","خِلافَةٌ وُفِّقَ في تَدبيرِها",0,"ر",3,0],["تَبهَشُ النَفسُ إِلى زَورِ الكَرى","وَمَتاعُ النَفسِ في زَورِ الأَرَق",1,"ق",1,0],["تَبهى المَواكِبُ وَالمَجالِسُ مِنهُمُ","بِمُبَجَّلينَ عَلى الوَقارِ رِزانِ",2,"ن",1,0],["تَبهرُ الأرضَ وتعلو صُعُداً","فَتُضيءُ الشُّهبَ أو تَسقِي الغماما",3,"م",2,0],["تبهرج بعد الأربعين وإنها","لغاية ما يجري إليه المخالف",4,"ف",1,0],["تَبهنسَ إِذ تقاعسَ عنهُ مُهري","وَأقبلَ نحوهُ أُذنيهِ ذُعرا",5,"ر",2,0],["تَبَهنَسَ إِذ تقاعسَ عنه مُهري","مُحاذَرَةً فقلتُ عُقِرتَ مُهرا",6,"ر",2,0],["تبهَر في الأسماع كلَّ جائفٍ","إذا استقامت لُحمة الجُرح فسدْ",7,"د",1,0],["تبهرج في راحتي سبكه","فأولى له ثم أولى له",8,"ل",2,0],["تبهر العقل إن أميطت فزالت","عن سنا وجهها الذي لن يفوتا",9,"ت",2,0],["تَبْهَى سَبيْعُ بمولودٍ يَتيهُ به","مَنْ كان من بدوِ قحطانٍ ومن مُضَرِهْ",10,"ر",2,0],["تَبَهرجُ حُسناً لم يُعَب عندَ ناظرٍ","وتلهُو بهِ عن حُسنِهنَّ الخرائدُِ",11,"د",1,0],["تُبْهِجُ الألْحَانُ قَلْبِي ْ","مِنْ جَمِيْلِ اللغْوِ صِدْقَا",12,"ق",2,0]]}