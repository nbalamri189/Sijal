{"poems":[[95,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[51,"قال لي أحمد ولم يدر ما بي","https://www.aldiwan.net/poem64248.html","الخفيف"],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[136,"يالدهر قمنا به في أمان","https://www.aldiwan.net/poem54711.html","الخفيف"],[333,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[469,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[580,"إنك المخلوق في كبدي","https://www.aldiwan.net/poem2816.html","المديد"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53173","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100291","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201636","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138555",""],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93293","الرمل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/145921","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139497",""],[5183,"الحمول","https://www.poetsgate.com/ViewPoem.aspx?id=186488",""],[5183,"الحمول","https://www.poetsgate.com/ViewPoem.aspx?id=186610",""],[402,"في أي جو بالأسى مفعم","https://www.poetsgate.com/ViewPoem.aspx?id=36328",""]],"verses":[["يَا لَدَمِي أَشْعُرُ أَنَّ الأَسَى","يَصُبُّ جَمْراً سَائِلاً فِي دَمِي",0,"م",2,0],["يا لِدَمعي عَدِمتُهُ لَيسَ يَرقا","إِنَّما يَستَهِلُّ عَسقاً فَغَسقا",1,"ق",2,0],["يا لدات الشباب لو ينفع الدم","ع جزتكم مدامعي والعويل",2,"ل",1,0],["يَالَدَهرٍ قُمنَا بِهِ في أَمَانِ","مِن صُرُوفِ الزَّمَانِ في كُل آنِ",3,"ن",1,1],["يا لدينا أقامها يا لفنٍّ","شاده بالخواطر الملهمات",4,"ت",1,0],["يا لداءٍ سقاه من كأسه المرّ","شراب الدموع والحسرات",4,"ت",1,0],["يا لدمعي ما كان في الحب دمعاً","كلٌّ حسن يروق منهُ بريقُ",5,"ق",1,0],["يَا لَدِينارٍ بوجْنتِه","كم بكتبها عينُ مُنْتقِد",6,"د",1,0],["يا لدهرٍ من اذاهُ","طاب بالجسم بلاهُ",7,"ه",1,0],["يا لِدَمٍ طاحَ ولم ألقَ له","من ناصر يدفع عني ما نزل",8,"ل",1,0],["يا لدمع عن الخدود مراقٍ","أجرت الفلك في الصعيد بحاره",9,"ر",2,0],["يا لدنيا النفس ما أرحبَها","إنما الدنيا كسجنٍ مظلم",10,"م",1,1],["يالدم في الطف مسفوح","أسال من وجدٍ حشى الروح",11,"ح",1,1],["يا لَدَمْعٍ حار في أَجفانه","أَنْ يُسمّى بوفِيٍّ أَو خؤون",12,"ن",1,0],["يا لدمشق المكث إذ جاءها","فقلت غاب ابن النقيب سمها",13,"ه",2,0],["يا لدهرٍ مرّاً غدا الحلوُ منه","لا ترى الحلوَ منه والداءُ داء",14,"ا",2,0],["يا لدهري إذا سبحت بفجري","فأنا منك سابح بالمغيب",15,"ب",1,0],["يا لدهري إذا سنحت بفجري","فأنا منك سابح بالمغيب",16,"ب",1,0],["يا لدمي أشعر أن اطلسى","يصب جمر سائلا في دمي",17,"م",2,0]]}