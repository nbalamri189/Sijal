{"poems":[[65,"نهج الثناء إلى ناديك مختصر","https://www.aldiwan.net/poem46122.html","البسيط"],[64,"إن آثارك الجميلة عمت","https://www.aldiwan.net/poem52381.html","الخفيف"],[46,"أنا في ذمة الكريم سليما","https://www.aldiwan.net/poem30361.html","الخفيف"],[107,"عيد الفداء جرى باليمن طائره","https://www.aldiwan.net/poem42105.html","البسيط"],[48,"صوفية ما رضوا للصوف نسبتهم","https://www.aldiwan.net/poem22984.html","البسيط"],[398,"أنا من شيعة الرضا","https://www.aldiwan.net/poem53655.html","مجزوء الخفيف"],[468,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[520,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[563,"خفض عدوي في الهوى ومصادقي","https://www.aldiwan.net/poem34337.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48884","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202075","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64911","البسيط"],[1420,"","https://poetry.dctabudhabi.ae/diwan/poem/100699","الرمل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111803","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111866","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27424","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27983","الطويل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140294",""],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145539","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48368","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205889",""],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136926",""],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35058","الخفيف"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117256","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52159","البسيط"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204315","الطويل"],[5121,"الْمَجْهُولَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=186621",""],[5365,"لا تحزني ياعبلُ","https://www.poetsgate.com/ViewPoem.aspx?id=191268",""],[5408,"أقسمت إني لا أخونك","https://www.poetsgate.com/ViewPoem.aspx?id=190872",""],[5431,"حجرٌ بكفي..._(أنشودة للأطفال)","https://www.poetsgate.com/ViewPoem.aspx?id=194545",""],[5431,"أمنية ....(ع)","https://www.poetsgate.com/ViewPoem.aspx?id=206102",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5956,"تهِز الريح جلبابي","https://www.poetsgate.com/ViewPoem.aspx?id=182715",""],[5956,"شكراً دعوتِ لطفلتي أن تشتفي","https://www.poetsgate.com/ViewPoem.aspx?id=202659",""],[6019,"الأَربَعُونَ ... رِوَايَةٌ أُخرَى","https://www.poetsgate.com/ViewPoem.aspx?id=71121",""],[6160,"غَزَالةُ المَجَازاتِ البَعِيْدَة ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87085&r=&rc=2",""]],"verses":[["إنْ أثّلوا لَكَ والدنيا بُعذْرَتِها","عُلاً فهذي عُلاً أثّلْتَها أُخَرُ",0,"ر",1,0],["إنّ آثاركَ الجميلةَ عمَّتْ","فهي تبقى وتُنْفِدُ الأعمارا",1,"ر",2,1],["أَنا ثاوٍ بِحِمصَ في كُلِّ ضَربٍ","مِن ضُروبِ الإِكثارِ وَالإِفحامِ",2,"م",1,0],["إنْ آثرَ الصَّمتَ يُغريهِ الوَقارُ بهِ","ضَجَّتْ بِمكتومِ ما تُخْفِي سرَائرُهُ",3,"ر",2,0],["إِن أَثمَرَ الغُصنُ فَاِمتَدَّت إِلَيهِ يَدٌ","تَجنيهِ ظُلماً فَلَيتَ الغُصنَ مَقصوفُ",4,"ف",1,0],["انَّ آثارَهُ منا","قِبُ في الناسِ مُؤثَرَه",5,"ر",2,0],["ان أثبتت خلدي عزائم همتي","فهموم قلبي للمسرة نافيه",6,"ي",2,0],["إن آثرت ثروة الدنيا مجانبتي","فإنها ابنة أم الغي والخطل",7,"ل",1,0],["أنا ثوبها روحاً وجسماً وهي في","خلعي ولبسي مثل لمحة بارق",8,"ق",1,0],["إن أثمرت حكمتي في أهل مصر فقد","رضيت منهم بتسليم وترحيب",9,"ب",1,0],["إنْ أثمرَ الِجذْعُ اليَبيسُ بِفَضلهِ","رُطَباً فأحرى به المسيح وأجْدَر",10,"ر",1,0],["إِنْ أَثَّرتْ نَظْرَتي في وَجْنَتَيْكَ فقد","نَكَأْتَ قَلْبي بِها أَضعافَ ما نَكَأَكْ",11,"ك",1,0],["أنا ثكلان لفقدتها فلِم","لبس الليل ولم يثكل حداد",12,"د",1,1],["انَّ آثارنا تدلُّ علينا","فانظروا بعدَنا الى الآثارِ",13,"ر",1,0],["انَّ آثارك التي قد رأينا","ما رأتها عيونُ اهل الامامه",14,"م",2,0],["أنا ثابتٌ لستُ عن مثبت","كما أنا عن موجِدٍ ماجد",15,"د",1,0],["إناثاً وذكرانا لمعنى بصورةٍ","بها قيدته مثل ما قيد الأعشى",16,"ش",2,0],["إن أثمرت طيباً في راحة فكفى","أولا فما فات هدراً ذلك التعب",17,"ب",1,0],["إن أثير الحديث والرأي منه","لم يمت مالك ولا النخعي",18,"ي",1,0],["أنا ثوبٌ أُجْتَلى","كجَهامِ السُّحُبِ",19,"ب",1,1],["أنا ثائر أبدًا وما","في ثورتي أبدًا صعوبة",20,"ب",2,0],["إِنا ثبتنا ثبات الأرزِ في جبلٍ","قد جاور الله في اعلى عليينا",21,"ن",2,0],["إنّ آثارنا لأثبت منّا","تِلكَ آثارنا تدوم قرونا",22,"ن",2,0],["إن أثقلت أعباء ذنبٍ ظهرَهُ","فبفضلها الأعباء عنه تطرح",23,"ح",1,0],["إنّا ثلاثةُ خوانٍ ورابِعُنا","فريدةُ العِقد موسى الساكن الحدقا",24,"ق",2,0],["إناث وذكران أبيت من أجلهم","على كمد بين الحجابين مقلق",25,"ق",1,0],["أَنَا ثَوْرَةُ النِّسْرِيِنِ طَيَّ خَمِيِلَةٍ","وَالطِّيِنُ فَوْقَيَ بِالأَرِيِجِ مُكَلَّلُ",26,"ل",1,0],["إن أثقلتْ متني الحياةُ وأوصَدَتْ","أبوابَها والغَيُّ راحَ يجورُ",27,"ر",1,0],["أنا ثائرٌ وبثورتي","أرقى لتنشِدَني فنونُكْ",28,"ك",1,0],["أنا ثائرٌ ..أنا صامدٌ ..أنا مؤمنٌ","للنور دربٌ شقه كفي!",29,"ف",2,0],["أنا ثلث الإله وبي اشتهاءٌ","لأقهر موت أزماني فأبرا !!!",30,"ر",2,0],["إناث أسماؤهم ذكور","ليس بمعنى مؤنثات",31,"ت",1,0],["إن آثروا حالة الدنيا لتكن لهم","أو عصمة عصموا من سائر النكد",32,"د",1,0],["إناثُ الإنس لم تُكرِمْ‎","فدقَّ الجِنُّ أبوابي‎",33,"ب",2,0],["أنا ثرثراتي ما تزال كثيرةً","ولديَّ جمهورٌ يراها عَسْجدا",34,"د",2,0],["إِنْ آثَرتْ بِالصَّمتِ كُلُّ جَدَاوِلِي","فَهُنَاكَ مَنطِقُ حَقلِهَا يَنهَارُ",35,"ر",1,0],["أَنا ثَوبُ قَلبِي مِثلُ ثَوبِكِ أَبْيَضٌ","وما كانَ يومًا قاتِمَ اللَّونِ أَسْوَدَا",36,"د",2,0]]}