{"poems":[[63,"نهج الثناء إلى ناديك مختصر","https://www.aldiwan.net/poem46122.html","البسيط"],[62,"إن آثارك الجميلة عمت","https://www.aldiwan.net/poem52381.html","الخفيف"],[44,"أنا في ذمة الكريم سليما","https://www.aldiwan.net/poem30361.html","الخفيف"],[105,"عيد الفداء جرى باليمن طائره","https://www.aldiwan.net/poem42105.html","البسيط"],[46,"صوفية ما رضوا للصوف نسبتهم","https://www.aldiwan.net/poem22984.html","البسيط"],[393,"أنا من شيعة الرضا","https://www.aldiwan.net/poem53655.html","مجزوء الخفيف"],[463,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[515,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[558,"خفض عدوي في الهوى ومصادقي","https://www.aldiwan.net/poem34337.html","الكامل"]],"verses":[["إنْ أثّلوا لَكَ والدنيا بُعذْرَتِها","عُلاً فهذي عُلاً أثّلْتَها أُخَرُ",0,"ر",1,0],["إنّ آثاركَ الجميلةَ عمَّتْ","فهي تبقى وتُنْفِدُ الأعمارا",1,"ر",2,1],["أَنا ثاوٍ بِحِمصَ في كُلِّ ضَربٍ","مِن ضُروبِ الإِكثارِ وَالإِفحامِ",2,"م",1,0],["إنْ آثرَ الصَّمتَ يُغريهِ الوَقارُ بهِ","ضَجَّتْ بِمكتومِ ما تُخْفِي سرَائرُهُ",3,"ر",2,0],["إِن أَثمَرَ الغُصنُ فَاِمتَدَّت إِلَيهِ يَدٌ","تَجنيهِ ظُلماً فَلَيتَ الغُصنَ مَقصوفُ",4,"ف",1,0],["انَّ آثارَهُ منا","قِبُ في الناسِ مُؤثَرَه",5,"ر",2,0],["ان أثبتت خلدي عزائم همتي","فهموم قلبي للمسرة نافيه",6,"ي",2,0],["إن آثرت ثروة الدنيا مجانبتي","فإنها ابنة أم الغي والخطل",7,"ل",1,0],["أنا ثوبها روحاً وجسماً وهي في","خلعي ولبسي مثل لمحة بارق",8,"ق",1,0]]}