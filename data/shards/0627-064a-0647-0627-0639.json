{"poems":[[55,"آب الرديني والحسام معا","https://www.aldiwan.net/poem30137.html","المنسرح"],[74,"واحيلتي بظلام الطرة الداجي","https://www.aldiwan.net/poem18450.html","البسيط"],[47,"أبا سعيد وفي الأيام معتبر","https://www.aldiwan.net/poem63565.html","البسيط"],[78,"بكرت علي عواذلي يلحينني","https://www.aldiwan.net/poem38873.html","الكامل"],[146,"من علم القلب ما يملى من الغزل","https://www.aldiwan.net/poem58449.html","البسيط"],[173,"سقها ولو ذهب السرى بسراتها","https://www.aldiwan.net/poem1609.html",""],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133783","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48285","الكامل"],[1012,"فتح جعلان","https://www.poetsgate.com/ViewPoem.aspx?id=124501",""],[5061,"ياوطن","https://www.poetsgate.com/ViewPoem.aspx?id=147162",""],[5433,"سيف العشق","https://www.poetsgate.com/ViewPoem.aspx?id=36119",""],[5455,"الدلوعه","https://www.poetsgate.com/ViewPoem.aspx?id=35554",""],[5458,"العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=72384",""],[5652,"مازلت اهذري في شموخ العزيزين !","https://www.poetsgate.com/ViewPoem.aspx?id=177734",""],[5652,"عُذرآ أعلم حاسدي ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=178410",""]],"verses":[["أَيّها عُقَيلٌ وَأَيُّ مَنقَصَةٍ","كَوَضعِ مَولى الأَقوامِ مَن رَفعَه",0,"ع",2,0],["إيهاً عذولي وباعدْ فيهِ عن بصرِي","فما أظنُّك من سيلِ البكى ناجي",1,"ج",2,0],["إيهاً عَزاءَكَ لا تُغلَب عَلَيهِ فَما","يَستَعذِبُ الصَبرَ إِلّا الحَيَّةُ الذَكَرُ",2,"ر",1,0],["إِيهاً عليكَ فقد كبرتَ عن الصِّبا","ونَهى المشيبُ عنِ الذي يَنْهَيْنَني",3,"ن",2,0],["إيها عقيل إذا غابت كتائبُهُ","فُزتم وإن طلعتْ طِرتم مع الحَجَلِ",4,"ل",1,0],["إِيهاً عِمادَ الدينِ يَقظَةَ ماجِدٍ","فَذَوو مَكارِمِها وَذُو يَقظاتِها",5,"ت",3,0],["إيه اعبسي دنيايَ أو","بشي فلست بقيّد",6,"د",1,0],["إيهٍ أعِدْ ذكْر المَعاهِدِ جادَها","عهْدُ الحَيا من دمْعيَ المُتوكِّفِ",7,"ف",1,0],["أية أعجزت ملوك البرايا","وأرت للأئمة البرهانا",8,"ن",2,0],["إيه أعشقك يَ دار عشق الهايم","إلي مواجيع الجفا تغتا لہ",9,"ل",1,0],["اية اعرفك واعرف اني من غلاك اجهلك","مرات اضمك واخاف اني مشبة عليك",10,"ك",1,0],["إيه أعرفك بنت عز وكلمتك مسموعه","وأدري إنك من خلقتي في ظلال وفيّه",11,"ي",2,1],["إيه أعرفك وأعرف إن الناس لك متبوعه","وأدري إن أمرك مجاب وحاجتك مقضيه",11,"ي",2,0],["آية اعذريني إن اسماً لا يفي","هل يحتوي البحرَ العظيمَ إناء",12,"ا",2,0],["ايه اعترف والله للحين للحين","للحين انا طفلٍ ويذكر قديمه ..!",13,"م",2,0],["إيه اعترف ماكان تدريه عني","ان الكرامه تعتلي لقمة العيش",14,"ش",1,0]]}