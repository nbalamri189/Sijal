{"poems":[[63,"النجح تحت خطا المهرية النجب","https://www.aldiwan.net/poem46090.html","البسيط"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"قل لأمير المؤمنين المعتاد","https://www.aldiwan.net/poem10882.html","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[98,"مؤتمر الجماد","https://www.poetsgate.com/ViewPoem.aspx?id=55343",""],[45,"لَمَّا تَذَكَّر ،وانْهَلَّتْ مَدَامِعُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32165",""],[51,"أنَّى هجوتَ بني ثوابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=26855",""],[164,"يا من طلعت طلوع الشمس من فلك","https://www.aldiwan.net/poem46901.html","البسيط"],[303,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[456,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[456,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[536,"يا أيها البحر الذي","https://www.aldiwan.net/poem48142.html","عموديه"],[551,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"]],"verses":[["أَقْذَى الزَّمانُ بِها شِرْبي وَرَنَّقَهُ","ماذا تُريدُ اللَّيالي مِنْ فَتىً غُرُبِ",0,"ب",1,0],["أَقْذِرْ وأخبِثْ بالمني","يِ إذا عبيطُ السَّلح شابهْ",1,"ب",2,0],["أقذى به اللَّهُ عيونَ الحسّادْ","وعاش في حالة نامٍ مُزْدادْ",2,"د",1,0],["أَقْذَى الْعُيُونَ فأَسْبَلَتْ بِمَدَامِعٍ","تَجْرِي عَلَى الْخَدَّيْنِ كَالْفِرْصَادِ",3,"د",1,0],["أقذف المدفع في أحشائه","للمنايا زمزمات الهول",4,"ل",1,0],["أَقْذَى المَآقي لِيُخْفِي أَمْرَهُ عُصَباً","فَبَادَرَتْهُ أَكُفُّ القَوْمِ في نَسقِ",5,"ق",1,0],["أقْذِر وأخبثْ بالمنى","إذا عبيطُ السَّلح شابهْ",6,"ب",2,0],["أقذى عيونَ أَعاديهم حسايِكُهُمْ","كأن أجفانَهم خِيطتْ على الحَسَك",7,"ك",1,0],["أقذفتم في البحر جمرة غيظكم","ونفختم هل أنتم عقلاءُ",8,"ا",2,0],["أقذيتُ أبصارَ العدا بمدحكم","فساوَروني أحْوصاً وأخزرا",9,"ر",2,0],["إِقذاعُها على عِداكم ولكم","منها يدُ الراضي ولفظُ الشاكرِ",10,"ر",1,0],["إقذف بِدُرٍّ كامِنٍ","فالبَحرُ يَقذِفُ الدُّرَر",11,"ر",1,0],["اِقذِف أَبا مَلِكٍ فيها يَكُنكَ بِها","وَيَسعَ فيها بِجَدٍّ مِنكَ مَجدودِ",12,"د",1,0]]}