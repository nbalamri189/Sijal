{"poems":[[65,"النجح تحت خطا المهرية النجب","https://www.aldiwan.net/poem46090.html","البسيط"],[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[53,"قل لأمير المؤمنين المعتاد","https://www.aldiwan.net/poem10882.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[100,"مؤتمر الجماد","https://www.poetsgate.com/ViewPoem.aspx?id=55343",""],[47,"لَمَّا تَذَكَّر ،وانْهَلَّتْ مَدَامِعُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32165",""],[53,"أنَّى هجوتَ بني ثوابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=26855",""],[170,"يا من طلعت طلوع الشمس من فلك","https://www.aldiwan.net/poem46901.html","البسيط"],[310,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[463,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[543,"يا أيها البحر الذي","https://www.aldiwan.net/poem48142.html","عموديه"],[558,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104975","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204463","الرمل"],[3677,"","https://poetry.dctabudhabi.ae/diwan/poem/35066","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86353","الرمل"],[4684,"غزة","https://www.poetsgate.com/ViewPoem.aspx?id=202388",""],[5431,"إلا التوحش معنى من معانيه","https://www.poetsgate.com/ViewPoem.aspx?id=196469",""]],"verses":[["أَقْذَى الزَّمانُ بِها شِرْبي وَرَنَّقَهُ","ماذا تُريدُ اللَّيالي مِنْ فَتىً غُرُبِ",0,"ب",1,0],["أَقْذِرْ وأخبِثْ بالمني","يِ إذا عبيطُ السَّلح شابهْ",1,"ب",2,0],["أقذى به اللَّهُ عيونَ الحسّادْ","وعاش في حالة نامٍ مُزْدادْ",2,"د",1,0],["أَقْذَى الْعُيُونَ فأَسْبَلَتْ بِمَدَامِعٍ","تَجْرِي عَلَى الْخَدَّيْنِ كَالْفِرْصَادِ",3,"د",1,0],["أقذف المدفع في أحشائه","للمنايا زمزمات الهول",4,"ل",1,0],["أَقْذَى المَآقي لِيُخْفِي أَمْرَهُ عُصَباً","فَبَادَرَتْهُ أَكُفُّ القَوْمِ في نَسقِ",5,"ق",1,0],["أقْذِر وأخبثْ بالمنى","إذا عبيطُ السَّلح شابهْ",6,"ب",2,0],["أقذى عيونَ أَعاديهم حسايِكُهُمْ","كأن أجفانَهم خِيطتْ على الحَسَك",7,"ك",1,0],["أقذفتم في البحر جمرة غيظكم","ونفختم هل أنتم عقلاءُ",8,"ا",2,0],["أقذيتُ أبصارَ العدا بمدحكم","فساوَروني أحْوصاً وأخزرا",9,"ر",2,0],["إِقذاعُها على عِداكم ولكم","منها يدُ الراضي ولفظُ الشاكرِ",10,"ر",1,0],["إقذف بِدُرٍّ كامِنٍ","فالبَحرُ يَقذِفُ الدُّرَر",11,"ر",1,0],["اِقذِف أَبا مَلِكٍ فيها يَكُنكَ بِها","وَيَسعَ فيها بِجَدٍّ مِنكَ مَجدودِ",12,"د",1,0],["أقذى جفوني إذ جفاني أرقاً","ذو وجنة من ورق الورد أرق",13,"ق",1,0],["اقذفوني في الفلا من بعد موتي","حبذا عيشي وموتي في الفلاة",14,"ه",1,1],["أَقذى بِعَينِكَ ما يُفارِقُها","أَم عائِرٌ أَم ما لَها تذري",15,"ر",2,0],["أقذف الدمع عليهن دما","من جفون شفها ما ذهبا",16,"ب",2,0],["*اقذف فديتك بالذرا قسامها","حتى تدك صروح وهم زائلة",17,"ل",2,0],["اقذفه يمّاً لقعر الحزن ليس هنا","جنٌ لتنقذه ممّا يُعانيه",18,"ي",2,0]]}