{"poems":[[63,"سوداء لم تنتسب لحام","https://www.aldiwan.net/poem51456.html","مخلع البسيط"],[89,"عم الحيا واستنت الجداول","https://www.aldiwan.net/poem8367.html","الرجز"],[203,"على الطرسين من خد وجيد","https://www.aldiwan.net/poem45223.html","الوافر"],[287,"يا هند لا تسخري بي","https://www.aldiwan.net/poem32891.html","المجتث"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70834","الوافر"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44827","الطويل"],[1501,"","https://poetry.dctabudhabi.ae/diwan/poem/146657","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101039","الطويل"],[2305,"","https://poetry.dctabudhabi.ae/diwan/poem/143197","الطويل"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18047","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137246",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87335","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137379",""],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122480","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131088",""],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45950","الوافر"],[4268,"","https://poetry.dctabudhabi.ae/diwan/poem/144269","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83672","البسيط"],[5183,"الخد النضر","https://www.poetsgate.com/ViewPoem.aspx?id=186378",""]],"verses":[["لها دُخانٌ تَضِلُّ فيه","عَجاجةُ الجحفَلِ اللُّهَامِ",0,"م",1,0],["لَهَا دُمُوعٌ ذُرَّفٌ هَوَامِلُ","كَأَنَّهَا أُمُّ بَنِينَ ثَاكِلُ",1,"ل",1,0],["لها دينٌ ولي دينٌ ولكن","أرى القلبين في دينٍ جديدِ",2,"د",1,0],["لَها دَبيبٌ بِجِسمي","يا حسنَهُ مِن دَبيبِ",3,"ب",1,0],["له أدب وأخلاقٌ","تضمَّنَ كل أسرار",4,"ر",1,0],["لَهُ أَدَبٌ سَمحٌ كَمَا رَقَّتِ الصَّبَا","إِلَى أَدَبٍ كَسبٍ كَعَهدِكَ بِالشِّحرِ",5,"ر",1,0],["له أدب لو الآداب أعدت","لأعدت شيمة اللؤم الطهاره",6,"ر",2,0],["لها دارةٌ بالقبتين تزاورت","عن الرمل في روضٍ لها وحقول",7,"ل",1,0],["لها دَلّ معشوق لها ذل عاشق","لها ضحك مسرور لها دمع مكتئب",8,"ب",1,0],["لَها دَولَجٌ دَوحٌ مَتى ما تَنَل بِهِ","مَدى الغِبِّ أَو تَربَع بِهِ الغَدَ تَخمِسِ",9,"س",1,0],["لها دعاءان فيدعو الداعي","في وقتي الأخذ والابتلاع",10,"ع",1,0],["لها دولة والحسن معقد تاجها","ولله في تأييد دولتها سر",11,"ر",1,0],["لَهَا دَخلَة عندَ النهارِ سليمةٌ","ودَخلَتُهَا في الليلِ فيها كريهتي",12,"ي",1,0],["له أدب يحيى النفوس لطافة","وفكر ينير الخطب ان هو أشكللا",13,"ل",2,0],["لَهَا دينٌ علينا بَل وِثُاقٌ","وحتمٌ أَن يُوفَّى بالوِثَاقِ",14,"ق",1,0],["له أدب غض ورائع فطنة","محلى بحبات الغمام أنيق",15,"ق",1,0],["لَهُ أَدَبٌ يُحَيِّرُ كُلَّ لُبٍّ","وَيُدهِشُهُ إِذا أَنشا يَقولُ",16,"ل",1,0],["لها دُروعٌ تَقيها من سهامِ يدٍ","فهل دروعٌ تَقيها أَسْهُمَ المُقَلِ",17,"ل",1,0],["لَها دَعاني الهَوى لِلَّهِ دَعوَتهُ","مُنذُ الصبا فَغَدَوت المُدلجَ الساري",18,"ر",2,0],["له أدب يزكيه","ولي أدب ومصطبر",19,"ر",1,0]]}