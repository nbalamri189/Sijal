083,"خمرةُ الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=53881",""],[5183,"ألف أهلا","https://www.poetsgate.com/ViewPoem.aspx?id=185692",""],[5213,"انشقاني من ربع مية طيبا","https://www.poetsgate.com/ViewPoem.aspx?id=170409",""],[1043,"في مرقص","https://www.poetsgate.com/ViewPoem.aspx?id=94864",""],[5307,"يا هِبوب الوَرد والفِلّي","https://www.poetsgate.com/ViewPoem.aspx?id=10535",""],[592,"إن الأمور التي الأعداء تبديها","https://www.poetsgate.com/ViewPoem.aspx?id=128826",""],[5431,"جدّ باهظ...","https://www.poetsgate.com/ViewPoem.aspx?id=202658",""],[5459,"عَابُوكَ ..","https://www.poetsgate.com/ViewPoem.aspx?id=212859",""],[5526,"دومة الجندل","https://www.poetsgate.com/ViewPoem.aspx?id=207021",""],[5701,"عاب النساء عائب فقلت ما","https://www.poetsgate.com/ViewPoem.aspx?id=164667",""],[5829,"إنما الله غفور","https://www.poetsgate.com/ViewPoem.aspx?id=171624",""],[5839,"الشعر بعدك","https://www.poetsgate.com/ViewPoem.aspx?id=62048",""],[6001,"كلمه ومعناها","https://www.poetsgate.com/ViewPoem.aspx?id=411",""],[6069,"بمثل ذا لا يعالج البرح","https://www.poetsgate.com/ViewPoem.aspx?id=105652",""],[6069,"أهلاً بطيف خيال زارني سحراً","https://www.poetsgate.com/ViewPoem.aspx?id=105648",""],[6096,"ياترى","https://www.poetsgate.com/ViewPoem.aspx?id=202963",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[5724,"ومعوقين عن الجهاد كتائبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55139&r=&rc=6",""],[6201,"تشكّلٌ أولي لزهرة ..على شاهد قبر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87488&r=&rc=12",""],[6225,"سميرُ الصمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80929&r=&rc=198",""],[463,"منَ العارِلولا أنَّ طيفكِ يطرقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60159&r=&rc=215",""],[6328,"تاء التأنيث","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84884&r=&rc=25",""],[6345,"نشيد الوصل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78661&r=&rc=32",""]],"verses":[["عابُوا وقالوا بساقِهِ شعرٌ","لقدْ عَداهُ الكَمالُ منْ ساقِي",0,"ي",1,1],["عابوا سُكوتي وَلَولاهُ لَما نَطَقوا","وَلا جَرَت خَيلُهُم شَوطاً بِمَيدانِ",1,"ن",1,0],["عاب عليها قومها ِضلّةً","أن تكسِب القُوت وأن تَطْعَمَه",2,"م",2,0],["عاب العدى منك أصداغاً مجعدة","عيب المقصر عن نيلِ العناقيدِ",3,"د",1,0],["عابوا وعبْتَ بغير حقٍّ منطقاً","لو طال رميُك لم تكن لتصيبَهُ",4,"ب",2,0],["عاب أشعاري وفي منزله","كلُّ عيبٍ ومخازٍ ورِيَبْ",5,"ب",1,0],["عابوا قريضي وما عابوا بمعرفةٍ","ولن ترى الشمس أبصارُ الخفافيش",6,"ش",1,0],["عابَنا البيضُ أَنَّنا غَيرُ عُجُمٍ","وَالعِبَدّى بِالسِحنَةِ البَيضاءِ",7,"ا",2,0],["عاب في الروض العندليب غراب","قائلا صه فانت غير مجيد",8,"د",1,0],["عابدين ركنك موئل ومثابة","لا زال يُستذرى به ويزار",9,"ر",1,0],["عابوك إذ وجدوا صنيعك بارعا","ورأوا سبيلك في الحياة قويما",10,"م",2,0],["عابِدينَ أَم","هالَةٌ عَجَب",11,"ب",1,0],["عابِسٌ في حَياطَةِ الفَيءِ يَلقى","مُبتَغى نَقصِهِ بِوَجهٍ شَتيمِ",12,"م",1,0],["عابِساتٍ يَحمِلنَ يَوماً عَبوساً","لِأُناسٍ عَن خَطبِهِ غافِلينا",13,"ن",2,0],["عابوا اِبتِهاجي بِالغَرامِ وَأَنَّني","ما عِشتُ مِن سُكرِ المَحَبَّةِ مائِدُ",14,"د",1,0],["عابدةُ النارِ سنا نورِها","أوضحَ لي في الحبِّ إعذارا",15,"ر",2,1],["عابَ عن عيني نهاراً كاملاً","ليتني أعلمُ مَنْ علَّمْهُ",16,"ه",1,0],["عَابوكَ إذ قُلتَ الصَّوابَ جَهالةً","أَيُعابُ مَن يأبى النِّفاقَ ويُوصَمُ",17,"م",1,0],["عابراً عرض البحر وَالبحر عجا","ج بأَمواجه عَلى الأرماث",18,"ث",1,0],["عابِسَةٌ لم يَجُد بها الأسَدُ الظْ","ظَبْيَةُ إلاّ ضَعَائِفَ الرِّهَم",19,"م",1,0],["عابوه بالشدة وهي حسنُ","في رجل للحقّ منه حصنُ",20,"ن",1,0],["عاب كأسي ولم يذق عطر كأسي","لا تعبها بالله حتّى تذوقا",21,"ق",2,0],["عَابُوا عَلَيَّ حَمِيَّتِي وَنِكَايَتِي","وَالنَّارُ لَيْسَ يَعِيبُهَا الإِحْرَاقُ",22,"ق",1,0],["عَابِسَاتِ الوُجُوهِ غَيْرَ غِضَابٍ","بَادِيَاتِ الأَنْيَابِ غَيْرَ ضَوَارِي",23,"ر",2,0],["عاب على البلبل ما يطرحه","من ريشه وهو به يأتزر",24,"ر",1,0],["عابَهُ العِدا صِغَراً","وَهوَ فَوقَ أَكبَرِها",25,"ر",3,0],["عابِثٌ بالزَّهْرِ مُغْتَبِطٌ","ناعِمٌ في الْحلِّ والظَّعَن",26,"ن",1,0],["عابوا على صمته فهل سمعوا","تهتزُّ فوقه نذره",27,"ر",2,0],["عابوا السكوتَ عليهِ وهو فضيلةٌ","لغَطُ الحديثِ مَطيّةُ الإسفافِ",28,"ف",1,0],["عابِثٌ بالغُصُونِ في ظِلِّ رَوْضٍ","حَاكَ أَفْوافَه مُلِثُّ الرَّبَاب",29,"ب",1,0],["عابدينُ كعبةُ مصرٍ ركْنُها حَرَمٌ","للخائفينَ إذا خَطْبٌ بهم نَزَلا",30,"ل",2,1],["عابوا الصراحة منك لما استعظموا","أن يستوي الاسرارُ والاعلان",31,"ن",1,0],["عابوه إذ نبت العذار بخدّه","وتمايلت أعطافه عن قدّه",32,"د",2,1],["عابس كالليل ليس به","أمل إلا سنا قمره",33,"ر",2,0],["عابوه عندي قديماً وهو يهجرني","وزاحموني عليه وهو طوع يدي",34,"د",2,0],["عاب الوشاة قناعها فاجبتهم","لا تخرج الأقمار عن هالااتها",35,"ت",3,0],["عاب قومٌ عليّ أني فخورٌ","أجد الناس في الفضائل دوني",36,"ن",2,0],["عابَت عَلَيَّ خَصاصَتي فَأَجَبتُها","مِنَنُ الرِجالِ مِنَ الخَصاصَةِ أَثقَلُ",37,"ل",1,0],["عابوك حقداً شأن كل مهذب","ذي نعمة والله يجزي من ظلم",38,"م",1,0],["عابَ الكواشحُ مَينَه في وعده","هبهُ يَمينُ أَلَستُ ملكَ يمينهِ",39,"ن",2,0],["عابِدُ الرَحمَنِ قاضي طَنطَدا","هُوَ قاضٍ قَدرُهُ عالٍ أَبَر",40,"ر",1,1],["عابثات بالقلوب","مضحكات مبكيات",41,"ت",1,0],["عابَ لَمّا غابَ عَن مَشهَدِ قَلبي","فَرضَ حُبّي أَكمَهٌ عَن قُرطِ حُبّي",42,"ب",2,1],["عابَ اِشتِهاري قَومٌ","عَن مِشهَدي فيهِ غابوا",43,"ب",3,0],["عابوا اِشتِهاري في مَحَبَّتِكُم","وَتَهَتُّكي جَهلاً بِما عِندي",44,"د",2,0],["عابوهُ اِذ لجَّ في تَصَلُّفِهِ","وَالحُسنُ ثَوبٌ طِرازُهُ الصَلَفُ",45,"ف",1,0],["عابُوا هَوَى شادِنٍ في رجله قِصَرٌ","من سُكْرِ ألحَاظِه في مَشْيِه ثَمَلُ",46,"ل",1,1],["عابَ عَذولي جُدَريّاً بدا","منتظماً منه على الخدِّ",47,"د",1,0],["عابوا الحقيقة في شعري وما سكنت","سوى الحقيقة أسمى شعري السامي",48,"م",2,0],["عابقات بشذى ال","فرحةِ كالسحر الموسَّد",49,"د",1,0],["عابوا علىَّ تغربّي","وأنا ببعدي كالتريب",50,"ب",1,0],["عابوا وفائي لمن أهوى وقد علموا","أن الخيانة ذنبٌ لا أواقعُهُ",51,"ع",2,0],["عابوا ومالي بصرف الحادثات يدٌ","أني جزعت ولا بالدهر من قبلِ",52,"ل",1,0],["عابوا قضيب البان لدناً أهيفاً","والبدر تمّاً والكثيب ترهرها",53,"ه",2,0],["عاب بالسيرة النَبيِّ وما ها","بَ صنوف المخاطرات الشديده",54,"د",2,0],["عابَني مِن مَعايبٍ هُنَّ فيهِ","حَكَمٌ فَاِشتَفى بِها مَن هَجاني",55,"ي",1,1],["عابد من فكره صنماً","هائمٌ بالجهل في الصنم",56,"م",1,0],["عَابُوا مِنَ المَحْبُوبِ حُمْرَةَ شَعْرِهِ","وَأَظُنُّهُمْ بِدَليلِهِ لَمْ يَشْعُرُوا",57,"ر",3,1],["عابوا العِذارَ وقالوا الحسنَ غيّره","صلّوا بقولِهِم عن أوضحِ الطُّرُقِ",58,"ق",1,1],["عابَ الكراهةَ لابنِ أحولِهم","من لَمْ يُميّزْه من الصّحْبِ",59,"ب",1,1],["عابَ العَواذِلُ من حَبِيبي سُمْرَةً","كَلّا فِرَنْدُ السَّيفِ لَيْسَ بعائِبِهْ",60,"ه",1,1],["عابَ مِنْهُ اللُّحاةُ لَمّا رأَوْهُ","سُمْرَةً لي في سِرِّها أذواقُ",61,"ق",1,0],["عاب هذا سبيلَ هذا فكل","من أخيه مطارد مذموم",62,"م",1,0],["عابِدُ الرَّحمنِ الإمامُ الَّذي قَد","قَبَضت كَفُّه المَعارفَ قَبضا",63,"ض",2,0],["عابِد اللَّه شَمس كلِّ وَزيرٍ","في سَما المَجدِ نالَ أَرفَع شَانِ",64,"ن",1,0],["عابوا عَلَيها حُمرةً في شَعرِها","مِن غَيرِ علمٍ وَالدّليل يكذِّبُ",65,"ب",1,1],["عابوه باللحية لما رأوا","أن الهوى أشرب في مهجتي",66,"ي",1,1],["عابس الطرف لا يكلم شيئا","غير هوج الرياح والأنواء",67,"ا",2,0],["عابت عليه عبوسا غير منسجم","مع السرور الذي رفَّت حواشيه",68,"ي",2,0],["عابوا قُطوبي أَن تَعَذَّرَ مَطلَبي","أَرَأَيتَ بَدراً لَيسَ فيهِ قُطوبُ",69,"ب",1,0],["عابوا المَليحَ بِلِحيَةٍ مِسكِيَّةٍ","كَالغَيمِ لاحَ عَلى الهِلالِ المُسفِرِ",70,"ر",1,1],["عابث في المروج يضحك للدو","ح الغني فينثني بغناء",71,"ا",2,0],["عاب من غيه وأنكر ان انكرت","مستنكرا وعبت معيبا",72,"ب",2,0],["عابُوا خِلاليَ واغْتابوا فَوقَّرَني","عِلْمي بأَنَّهمُ لَيسوا باَنظاري",73,"ر",2,0],["عابثة بِالفَضل وَالمَحاسن","لجهلها بِزائن وَشائن",74,"ن",1,0],["عابد الخلاق","نَسل خَير الخَلق الأَكرَم",75,"م",1,0],["عابوا عليّ البكا يا ليتهم علموا","ما هاج نوحك لي يا طائر البان",76,"ن",1,0],["عَابُوا على الظَّاهِرِ احتِفالاً","بَزَّتْكَ سَبْعٌ بهِ يُراعُ",77,"ع",1,0],["عابوا الجِهادَ وَلَيسَ عاباً إِنَّما","خَفِيَت فَضائِله عَلى الأَذهانِ",78,"ن",1,0],["عاب التّفَقُّه قومٌ لا عقولَ لهم","وما عَلَيه إِذا عابوه من ضرَرِ",79,"ر",1,1],["عابساتٍ يبسم الناس لها","كم عَبُوس كلَّف المرءًَ ابتساما",80,"م",2,0],["عابقة الربط اذا ما مشت","عطَّرت الارض باذيالها",81,"ل",3,0],["عابوا وقالوا تسل عنه","فقلتُ هذا أوان حبي",82,"ب",2,1],["عابوا جمود المسلمين وصرحوا","ان لا نعد مع الانام اناما",83,"م",2,0],["عابوا علينا ان نناضل وافتروا","انا على الوطن المحبب عار",84,"ر",1,0],["عاب خلقي وكم تمنى بأن ين","عت بين الورى بما هو عائب",85,"ب",1,0],["عابُوه في حَلْقٍ لها عَبَثاً","مع أنَّها من أحْرُفِ الحَلْقِ",86,"ق",1,0],["عابَ قومٌ كانَ ماذا","ليتَ شعري لِمَ هذا",87,"ذ",2,1],["عابوه لما التحى فَقُلنا","عِبتُم وغِبتثم عن الجمال",88,"ل",1,1],["عابوا الذي أعشقه بالنحول","فلم أطع فيه مقال العذول",89,"ل",1,1],["عابها العذال قالوا شعرها","فاحم والخال والخد أسيل",90,"ل",1,0],["عابِدوا النيران في تلكَ الطُقُوس","قُل لنا ما هم قُسوسٌ ام مَجُوس",91,"س",1,0],["عابت لديهِ فجُوزِيَت","بالهجر والمفارقه",92,"ق",2,0],["عابِقُ الطِّيبُ وَمنشُورُ الشَّذَى","فَوقَ أُزرٍ زَانَها الوَشيُ الجَمِيل",93,"ل",1,0],["عابدَ الله والمجالُ طغاةٌ","فَتَنَتْهم عبادةُ الأوثانِ",94,"ن",1,0],["عابثا أَنمله في ذقنه","حيرة الضائق فيما يزهد",95,"د",1,0],["عابرات لها مجادف أيد","نزعت دانيا وأدنت نزيعا",96,"ع",2,0],["عابوهُ فَقالوا نُسَخَت آياتُه","وَالخَطُّ أَتى وَما دَنا ميقاتُه",97,"ه",1,1],["عابَ الذي لم ينل في الوقتِ تجربةً","لِصحبةٍ لهمُ والعيبُ لم يزَل",98,"ل",1,0],["عابدٌ زاهد تقي نقيٌ","غوثُ داعٍ وغيث عامٍ محيل",99,"ل",1,0],["عابثا يمحق آمال الربى","يقطع الوصل بأسياف الشظايا",100,"ا",3,0],["عابثاً بالقيد لا يحسبهُ","في سبيل الحقِّ شراً أو هوانا",101,"ن",2,0],["عابر سبيلٍ ما عرف شالإقامة","دواه يلحق بالوسيمة وسيمة",102,"م",2,0],["عابسٌ هذا الزمانُ مُكْفَهِرْ","لم يَعُدْ للعُربِ من أمرٍ يسرْ",103,"ر",1,1],["عابرات الدهر تطويك وما","حزت من مجد سيغدو سهم طي",104,"ي",1,0],["عابر سبيل وغربة أهلي والأحباب","اليوم راحل عن ديارك لداري",105,"ر",2,1],["عابر سبيل ولا بقى فيك أصحاب","والنفس ما تشره على شخص عاري",105,"