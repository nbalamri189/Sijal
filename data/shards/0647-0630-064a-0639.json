5",""],[5122,"الكذب","https://www.poetsgate.com/ViewPoem.aspx?id=31517",""],[5183,"الجلال","https://www.poetsgate.com/ViewPoem.aspx?id=186602",""],[5183,"إلى الباكستان","https://www.poetsgate.com/ViewPoem.aspx?id=185671",""],[5183,"ذكرى ابن زيدون","https://www.poetsgate.com/ViewPoem.aspx?id=180225",""],[5213,"بني لوي وهل يجدي البكاء دما","https://www.poetsgate.com/ViewPoem.aspx?id=170509",""],[5246,"سلّ القؤادَ بوصل الصحب معتمداً","https://www.poetsgate.com/ViewPoem.aspx?id=187071",""],[5324,"فكأنّما خلق الزمان لأجلها .","https://www.poetsgate.com/ViewPoem.aspx?id=207308",""],[5397,"هلا سألت مرابعا وطلولا","https://www.poetsgate.com/ViewPoem.aspx?id=157941",""],[5409,"للحر بطن الأرض أجدى","https://www.poetsgate.com/ViewPoem.aspx?id=155492",""],[5431,"يضحك الشفق...","https://www.poetsgate.com/ViewPoem.aspx?id=203089",""],[5444,"قبلة الأشواق والإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=205445",""],[5561,"في ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=193375",""],[5582,"ما لِلْحَمائِمِ لا يَنْفَكُّ نائِحُها","https://www.poetsgate.com/ViewPoem.aspx?id=186834",""],[5648,"العلم مده والصدر هات مافيه","https://www.poetsgate.com/ViewPoem.aspx?id=156417",""],[5690,"هذي عصابة ذات الحسن قد لمعت","https://www.poetsgate.com/ViewPoem.aspx?id=172207",""],[5690,"جرمانوس الحبر أهدي من معادنهِ","https://www.poetsgate.com/ViewPoem.aspx?id=172185",""],[5756,"نار وبارود","https://www.poetsgate.com/ViewPoem.aspx?id=5363",""],[5821,"يوم السبت - مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=114115",""],[5962,"العقل","https://www.poetsgate.com/ViewPoem.aspx?id=205968",""],[5974,"نفحة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=207485",""],[161,"بارك الله لكما","https://www.poetsgate.com/ViewPoem.aspx?id=175728",""],[6079,"يا تعسَ قلبك","https://www.poetsgate.com/ViewPoem.aspx?id=207048",""],[6115,"نصايح عشر","https://www.poetsgate.com/ViewPoem.aspx?id=180461",""],[6228,"نبحث عن بقيتنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85967&r=&rc=4",""],[6268,"يبكيكم الأقصى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82924&r=&rc=10",""],[2220,"تجري الأمورُ إلى آجالِها ركضاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11512&r=&rc=386",""]],"verses":[["هَذِي عَرْوسُ قَصَائِدِي حَلَّيْتُهَا","وَزَفَفَتُهَا بِالسَّعْدِ مِنْ سَاعَاتِهَا",0,"ت",3,0],["هَذِي عُكَاظٌ وَذَاكَ مَعْهَدُهَا","أَنْبَغُ فِتْيَانِهَا مُجَدِّدُهَا",1,"د",3,1],["هَذِي عَلَى أَنَّ وَقْتِي غَيْرُ ذي سَعَةٍ","عُجَالَةٌ لَيْسَ تَعْدُو بَثَّ أَحْزَانِي",2,"ن",2,0],["هَذِي عَرُوسٌ أُوتِيَتْ مِنْ ربِّهَا","فَضْلاً لَهُ مِنْهَا بِهَا تَكْمِيلُ",3,"ل",1,0],["هذي عجائب تثني النفس حائرةً","وتقعد العقلَ من عيّ على ضمدِ",4,"د",1,0],["هَذى عِبارَةُ أَهلِ الأَنفِرادِ بِهِ","ذَوي المَعارِفِ في سِرٍّ وَإِعلانِ",5,"ن",1,0],["هذي عُقوبةُ منْ يكدُّ عبِيده","حتى يُعرِّقَ مِنْهمُ الآباطا",6,"ط",2,0],["هَذي عَصايَ الَّتي فيها مَآرِبُ لي","وَقَد أُهُشُّ بِها طَوراً عَلى غَنَمي",7,"م",2,0],["هذي عروسُ الزَّنجِ ليلتهُ التي","أومَتْ بكفٍّ حُلّيَت بأساورِ",8,"ر",1,0],["هَذِي عَرُوسُ قُرْبُهَا نِعْمَةٌ","سَابِغَةٌ تُجْدَرُ بِالشُّكْرِ",9,"ر",1,0],["هَذِي عَزَائِمنَا جَلْوْنَاهَا وَقَدْ","خَلُصَتْ مِنَ الشَّهَوَاتِ وَالأَحقَادِ",10,"د",1,0],["هَذِي عَجَائِبُهَا وَأَعْجَبُهَا","أَنْ يَسْتَقِرَّ بِقرْبِهَا كَدَرُ",11,"ر",1,0],["هذي عروس البحر أم أنا حالم","ما بالها ليست كما أتوهم؟",12,"م",1,0],["هَذي عقيدُتنا في اللَّه خالقنا","لم نحشُ لَم نَعتزل فيما ندين بهِ",13,"ب",2,0],["هذي عقوبةُ مَوطني وجنايَتي","هيَ أنّني لتيوسِهِ لم أركَعِ",14,"ع",1,0],["هذي عِباراتُ الأَسى سُطِّرَت","بِالدَمعِ من أَجفاني الزهَّدِ",15,"د",1,0],["هذي عقاقير العطارة كلها","لم يحترق منهن إلا المندل",16,"ل",1,0],["هذي عبادةُ حسنٍ","فيها خلاصُ النفوس",17,"س",1,0],["هَذى عَلامته وَهذا نعته","وَالوَقت في الكتب القَديمة وَقته",18,"ه",1,0],["هَذي عَلى تَقوى تأسّس مَجدُها","وَعلى الضّرارِ أَشادت القدماءُ",19,"ا",2,0],["هَذي عَلاماتٍ لِخَيرٍ قَد بَدا","وَلَعَلَّهُ مُتَتابِعٌ بِمَزيدِ",20,"د",1,0],["هذي عناصر كرهنا موروثة","لكم ونورثها إلى الاعقاب",21,"ب",1,0],["هذي عصا داودَ أكبرُ شاهدٍ","في قتله جالوت ذا الصمصام",22,"م",1,0],["هذي عقيداتي التي ألْقَى بها","ربَّ الأنام إذا أتيتُ المحشرا",23,"ر",2,0],["هذي عمى بصيرة لا ناظر","هذا انسداد القلب لا الآذان",24,"ن",1,0],["هذي عقابيلُ داءٍ كانَ يمطُلُنِي","ولم أزَلْ مُشْفِياً مِنهُ على الهُلُكِ",25,"ك",1,0],["هذي عرى الصبر التي عهدتها","قد فُصِمَتْ بالوجد هاتيك العرى",26,"ا",1,0],["هذى عدالة عاَلمٍ مُتبجحٍ","بالشرّ بل عدل الآله السامى",27,"م",2,0],["هذي عرائسنا اللاتي استوين على","عرش السعادة في استجلائها جشعا",28,"ع",2,0],["هذي عيوني نرجس","والورد هذا من خدودي",29,"د",2,0],["هذي عواطف لا تعارضها يد","ومجازف من عارض التيارا",30,"ر",2,0],["هذي عقيدتكم وذاك يقينكم","تتغير الدنيا ولا يتغير",31,"ر",1,0],["هذي على جبهة العلا رقم","وتلك في ميسم المنى شنب",32,"ب",1,0],["هذي عروسُ يومِها","جاءتكم مستجدية",33,"ي",2,0],["هَذي عُيونَكِ غازَلت لَحظاتِها","عَيني تُجاوبها عَلى سرٍّ سَرى",34,"ر",2,0],["هذي عمايل من نودّه","ونحنا عنهم ما نلقط اليد",35,"د",1,0],["هَذِي عَجَائِبُ لَمْ تَخُطَّ بِمِثْلِهَا","أَقْلاَمُ أَهْلِ الأَرْضِ فِي الأَطْرَاسِ",36,"س",1,0],["هَذِي عِنَايَةُ رَبِّنَا بِمَعَاشِرٍ","أَفْضَالُهُمْ لِسُؤَالِهِمْ لَمْ تُحوِجِ",37,"ج",1,0],["هذي عروسُ القضا تهتزُّ من طربٍ","فكيف حال القضا لو عمّه الخبر",38,"ر",1,0],["هذي عُكاظٌ مِن فتاها خلتْ","وأغرورقتْ رهنَ السكونِ العميقْ",39,"ق",1,0],["هذي عروسُ الزَّهرِ قد برزتْ","تتلو الغَرام بروضةِ الشِّعْر",40,"ر",1,0],["هذي عُكاظُ ففاخرْ يا فتى الحِكَمِ","بحكمةٍ أصبحت ناراً على عَلَمِ",41,"م",1,1],["هذي عبارة خُبر لا عَلى خَبَر","وَقصَةٌ شاهداها الهم وَالحزن",42,"ن",1,0],["هَذي عروس الجمال وَالجمل","لاحَت لَنا بالحلي وَالحلل",43,"ل",1,1],["هذي علية والمعالي جندها","لمعت بوارق سعدها بالمولد",44,"د",1,0],["هذي عكاظ وسوقها معقودة","والشيخ راحته على ميزانها",45,"ن",3,0],["هذي عواطف والد فتكت به","أيدي الزمان فغادرته عانيا",46,"ي",2,0],["هذي علوم الحياةِ لاحتْ","على وجودي من النباتِ",47,"ت",1,0],["هذي علومٌ إنْ تناولتها","كنتَ بها الواحدَ في خلقه",48,"ق",2,0],["هذي عمومٌ يعم الكون أجمعه","ولا يخُّ به نفلاً وفرضا",49,"ض",2,0],["هَذِي عِبَارَاتٌ لَهُم مَضمُونُهَا","مَا ثَمَّ قَطُّ فِي الأعيَانِ",50,"ن",1,0],["هَذِي عًُلُومُكُمُ التَي مِن أجلِهَا","عَادَيتُمُونَا يَا أولِي العِرفَانِ",50,"ن",1,0],["هَذي عَقيدَتُنا وَهَذا شَرعُنا","أَكرِم بِشَرعِ العَدلِ وَالإِحسانِ",51,"ن",1,0],["هذي عرائسك الجميلة أنها","مشمولة بالحسن والإحسان",52,"ن",1,0],["هذي عَوائده وَهنَّ دَواؤه","لَو كُنت تَدفَع يا طَبيب شُعوبا",53,"ب",2,0],["هذي علوم الذوق كال","محسوس بالحس الندي",54,"د",2,0],["هذي عروس فضائل","رفعت ستائر حجبها",55,"ب",3,1],["هذي عيوني عليك تبكي","فهل يكون الرثا بكاء",56,"ا",2,0],["هذي عجائب هذا القطر من زمن","وتلك حالات وادي النيل من قدم",57,"م",1,0],["هذِي عصا موسى الكَليم استلْقَفتْ","مَا زَخرفتْه كفُّ غاوٍ قَدْ سَحَرْ",58,"ر",1,0],["هذي عَجائِبُ الاختِراع","ما وَصفُها بِالمُستَطاع",59,"ع",1,0],["هذي عجالتنا خذها مقدمة","فإن قنعت وإلا الشرح مسطور",60,"ر",1,0],["هَذى عَزائمك الَّتي قَد أَصبَحَت","تَنبو العَزائم دونَها وَتَخورُ",61,"ر",1,0],["هذي عرُوسُ مَشيبٍ منك قد جُلِيت","ودأيتانِ لها مُزِيلَتا اللُّثُمِ",62,"م",1,0],["هذي عواطفُ أَهل بيروتِ لقد","رُفِعَت إِليك مصوغةً بنظامي",63,"م",2,0],["هذي عمان سمت في ظلكم شرفا","كما شرفت بإخلاصي وشكران",64,"ن",1,0],["هذي عمان في ربوعك عينها","قرت وسرت بها علوا يسمع",65,"ع",1,0],["هذي عزائم عتبي تفرق ما","بين الجماجم والأعناق إن عتبا",66,"ب",2,1],["هذي عصاي التي فيها مآرب لي","وقد أهشى بها طورا على غنمي",67,"م",2,0],["هذي ((عُمانُ)) العُلى فِيهِ مُمنَّعَةٌ","ووطَّدَ العَزمَ فَاشتدَّتْ ضوافرها",68,"ر",3,0],["هذي عقيدةُ مخلص لله هل","نال المنى فلينظر النظَّارُ",69,"ر",1,0],["هذي عهود الدَّمِ أنّى يا تُرى","محو عتاة الغاشمين كلامُ",70,"م",1,0],["هذي علاماتُ القِيامَةِ.. لم تعد مِنها علامة","تَمَّت علاماتُ القيامةِ كُلُّها.. أَين القيامة؟!",71,"م",2,0],["هذى عروس تُجْتَلي","جمالها زان الجلا",72,"ا",1,0],["هذي عمانُ فطَيَّبَ المولى","أيامَها في الرملِ والمدرِ",73,"ر",1,0],["هذي عهود أهل الوفا والمواثيق","ورجلٍ يحدّه للمواقيف صيته",74,"ت",2,0],["هذي عروبتُنا يا مصرُ تَجمعُنا","كَدَوْحةٍ فوقَها زهرٌ وأغصانُ",75,"ن",1,0],["هذي علية من علت أنوارها","فوق النجوم على المحيط الاطلسي",76,"س",2,0],["هَذِي عُمَانُ غدَتْ بِالْحزنِ مُثْقَلةٌ","ياسْاكُن الْقَلبَ ان القلب مثواكا",77,"ك",2,0],["هذي عصى موسى ملك مع أموالي","احوش فيها الذيب واهذب أذنابه",78,"ب",2,0],["هٰذي عُكاظٌ تسوقُ الشِّعرَ موردَهُ","كلُّ الرُّواةِ قضتْ في مُلكِهِ فيها",79,"ي",3,0],["هَذِي عُرُوقٌ تَحْتَمِي فِي أَصْلِنَا","لَنْ نَهْتَدِي مِنْ غَيْرِهَا أَوْ نَرْصُدَا",80,"د",2,0],["هذي عيوبي ماليات جيوبي","من صغر سني لين غطاني الشيب",81,"ب",1,0],["هذي عمان وشعبها ومليكها","لكم تحية وامق وثناؤه",82,"ا",3,0],["هذى عُمان ومن ربتّه نجدتها","من الأساود أهل الفخر بانيه",83,"ي",2,0],["هذي عمان لتاج الشرق مفرقه","وللعروبة عرش والغنى مينا",84,"ن",2,0],["هذي عواهر حرب في قصورهم","ونسوة المصطفى بالأمر تنتهك",85,"ك",1,0],["هذي عمان وحب الغيث عادتها","تدعو وترقب حتى جاء موسمه",86,"م",2,0],["هذي عصور الحيف تشهد بأسها","مهما تُضام فأهلها أمجادُ",87,"د",1,0],["هذي عقائل أحمد لك قد غدت","ذي تشكو والهة وتلك ثكولا",88,"ل",2,0],["هذي عقوبة كل من","لا يتقي للفعل ردا",89,"د",2,0],["هذي عيوني رأتك معجزة","غمرتَها والإحساس يندفقُ!",90,"ق",1,0],["هذي عمان، فقف إذا هي سطَّرَتْ","تاريخَها وانثرْ عقودَ جُمان",91,"ن",1,0],["هذي عروشُ الظالمينَ تناثَرَت","صرعى فزادَ بها الثرى استئصالا",92,"ل",2,0],["هذِي عَشِيرَتُكَ الأَدْنَوْنَ حَوْلَكَ قَدْ","لاحَتْ كَشَمْسِ الضُّحَى مِنْها نَصائِحُها",93,"ح",3,0],["هذي علامه للكرم والذرابه","العلم مده والصدر هات مافيه",94,"ي",2,0],["هذي عصابة ذات الحسن قد لمعت","في ليلة الوصل أم ترصيع إكليلِ",95,"ل",1,1],["هذي عطاياك يا هذا الهمام لنا","قد قلت ألبستنا فخاراً غير منصرمِ",96,"م",1,0],["هذي عوايد طبعنا واكتفينا","الله خلقنا ازهود ونفني له ازهود",97,"د",1,0],["هذي عوايد اميرنا مابه انكار","شجاعته ماهي شهاده دراسه",98,"س",2,0],["هذي عظايم صنعتك فالكون تلهج بالذكر","والآدمي لو يبصر آياتِك ف نفسه حارها",99,"ر",3,0],["هذي عبادة بالإتقان قد وصلوا","معاقل المجد ، والإبداعُ يكتملُ",100,"ل",1,1],["هذِي عَرُوسُ البَدْرِ زَانتْ خِدْرِهَا","هَيْفَاءُ فِي سِتْرٍ غَلا مَغْزَاهُ",101,"ا",2,0],["هذي عطاياهمْ فيا ويحَ الذي","يرضى على الشعراءِ ظُلمًا مُدقِعا",102,"ع",2,0],["هذي عشر والنصح بابه واسع","ونشد سديد الرأي والفهمان",103,"ن",1,0],["هذي عيون المجد مطرقة","مذ غاب عن أحداقها البصرُ",104,"ر",1,0],["هذي عصاً مرفوعةٌ تنتشي","وتحتها ظهرُ سَجينٍ طريحْ",105,"ح",1,0],["هذي عمومٌ يعمّ الكونَ أجمعهُ","ولا يخصُّ به نفْلاً ولا فرضا",106,"ض",2,0]]}