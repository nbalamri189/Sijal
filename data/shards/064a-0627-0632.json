{"poems":[[53,"بيني وبين الصوارم الهمم","https://www.aldiwan.net/poem29775.html","المنسرح"],[53,"عجلت يا شيب على مفرقي","https://www.aldiwan.net/poem29876.html","السريع"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[63,"يا زورة بمصاب المزن من إضم","https://www.aldiwan.net/poem45800.html","البسيط"],[55,"يا زين من رأت العيون إذا بدت","https://www.aldiwan.net/poem26254.html","الكامل"],[55,"يا زين من ولدت حواء من ولد","https://www.aldiwan.net/poem26490.html","البسيط"],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.aldiwan.net/poem35921.html","البسيط"],[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[77,"هل كنت تعلم في هبوب الريح","https://www.aldiwan.net/poem36635.html","الكامل"],[77,"صاب مزن الدموع من جفن صبك","https://www.aldiwan.net/poem36705.html","الخفيف"],[77,"يا طلعة الشوم التي مهما بدت","https://www.aldiwan.net/poem36765.html","الكامل"],[86,"جل الأسى فتجملي","https://www.aldiwan.net/poem10486.html","مجزوء الكامل"],[86,"هذا الظلام أثار كامن دائي","https://www.aldiwan.net/poem10942.html","الكامل"],[86,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[83,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[83,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[23,"قد أصبح القلب عنها كاد يصرفه","https://www.aldiwan.net/poem21263.html","البسيط"],[72,"يا زائري قاضي القضاة ليهنكم","https://www.aldiwan.net/poem18358.html","الكامل"],[72,"لحظك في الفتك هو البادي","https://www.aldiwan.net/poem18557.html","السريع"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[72,"قل لوزير الملك يا من له","https://www.aldiwan.net/poem19192.html","السريع"],[72,"مدمع سائل لغير رحيم","https://www.aldiwan.net/poem19679.html","الخفيف"],[72,"أعيذ ريم الترك بالروم","https://www.aldiwan.net/poem19684.html","السريع"],[51,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[51,"أبا حفيص رويدا","https://www.aldiwan.net/poem62881.html","الطويل"],[51,"أأبي يوسف دعوة المستصغر","https://www.aldiwan.net/poem63998.html","الكامل"],[51,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[51,"أصل نما بك ربه فرعه","https://www.aldiwan.net/poem65410.html","أحذ الكامل"],[51,"يا راغبا نزعت به الآمال","https://www.aldiwan.net/poem65921.html","الكامل"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[51,"يا واحد الناس في الآلاء والمننِ","https://www.aldiwan.net/poem66389.html","البسيط"],[70,"يا زيد كيف نسيت عمرك","https://www.aldiwan.net/poem42912.html","مجزوء الكامل"],[70,"أنا في الحب صاحب المعجزات","https://www.aldiwan.net/poem42992.html","الخفيف"],[92,"يا لاابتسامة قلب","https://www.aldiwan.net/poem38892.html","مجزوء الكامل"],[92,"بل يا بهاء هذا الوجود","https://www.aldiwan.net/poem38952.html","الخفيف"],[89,"ما انت الا نادره","https://www.aldiwan.net/poem44632.html","مجزوء الرجز"],[89,"ورد يطيح وبلبل اسوان","https://www.aldiwan.net/poem44907.html","الكامل"],[85,"في ذي الجفون صوارم الأقدار","https://www.aldiwan.net/poem7894.html","الكامل"],[85,"هل تيم البان فؤاد الحمام","https://www.aldiwan.net/poem63018.html","السريع"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[97,"هل تأمرين فأفتدي وأقيك","https://www.aldiwan.net/poem24413.html","الكامل"],[97,"هل في العصيب المدلهم","https://www.aldiwan.net/poem24783.html","مجزوء الكامل"],[44,"يا زوجة المسكين مقران التي","https://www.aldiwan.net/poem30059.html","الكامل"],[69,"فجعت بكتانيها مصر","https://www.aldiwan.net/poem28055.html","أحذ الكامل"],[69,"يا زيد ما عاشرت عمرا سدى","https://www.aldiwan.net/poem28076.html","السريع"],[105,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[105,"بني سليم أعدوا الخيل واحترسوا","https://www.aldiwan.net/poem43997.html","البسيط"],[105,"أرأيت حكمة سيد الكرماء","https://www.aldiwan.net/poem44034.html","الكامل"],[105,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[105,"من ينم عن لهذم أو مخذم","https://www.aldiwan.net/poem44193.html","الرمل"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[102,"يا زهرة الوادي أتيت بزهرة","https://www.aldiwan.net/poem33104.html","الكامل"],[52,"يا رب قد أبلاني","https://www.aldiwan.net/poem26628.html","المجتث"],[46,"لا يعجبن الفتى بفضل","https://www.aldiwan.net/poem22473.html","مجزوء البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85430","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39671","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39606","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54803","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54676","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55021","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10226","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54263","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[106,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[106,"ترقية شاعرين بالأقدمية","https://www.poetsgate.com/ViewPoem.aspx?id=179770",""],[77,"يا طلعَة َ الشُّوم التي مهما بدَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=33203",""],[100,"حين يصحو الشعب","https://www.poetsgate.com/ViewPoem.aspx?id=50112",""],[90,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[45,"باللهِ أُقسِمُ لو مُلِّكْتُ أَلْسِنَةً","https://www.poetsgate.com/ViewPoem.aspx?id=32030",""],[99,"ترصيع بالذهب على سيف دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=587",""],[99,"ترصيع بالذهب على سيف دمشقي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=204&r=&rc=18",""]],"verses":[["يا زَهرَةَ الغَوطَتَينِ تَبخُلُ بِالبِش","رِ وَما مَسَّ أَرضَكِ العَدَمُ",0,"م",1,0],["يا زائِراً ما جاءَ حَتّى مَضى","وَعارِضاً ما غامَ حَتّى اِنجَلى",1,"ل",2,0],["يا زَفرَةً هَيَّجَها","حادٍ مِنَ الغَورِ حَدا",2,"د",2,0],["يا زَورَةً بِمَصابِ المُزنِ مِن إِضَمٍ","مَحفوفَةً مِن عَذارى الحَيِّ بالمُقَلِ",3,"ل",1,1],["يا زَينَ مَن رَأَتِ العُيونُ إِذا بَدَت","وَسطَ النِساءِ وَلَفَّهُنَّ المَجمَعُ",4,"ع",1,1],["يا زَينَ مَن وَلَدَت حَوّاءُ مِن وَلَدٍ","لَولاكَ لَم تَملُحِ الدُنيا وَلَم تَطِبِ",5,"ب",1,1],["يا زاجرَ العيسِ أنْضاءً مُضَمّرَةً","كأنّها أسْهمٌ يمرُقْنَ عنْ فوَقِ",6,"ق",1,0],["يا زاجِرَ البُدْنِ القِلاصِ يُقيمُهُ","أنْجادُهُ وتُقيمُهُ أغْوارُهُ",7,"ر",2,0],["يا زاجِرَ الوَجْناءِ يعْتَسِفُ الفَلا","والليْلُ يَعْثُرُ في فُضولِ مُسوحِ",8,"ح",1,0],["يَا زَمَاناً أغْرَى الْفِرَاقَ بِشَملِي","لَيْتنِي أُهْبَتي أَخَذْتُ لِحَرْبِكْ",9,"ك",1,0],["يَا زَوْرَةَ الأَلَمِ الَّذِي مَهْمَا يُرَى","جَاءَتْ رِكَابُ الْمَوْتِ فِي أَعْقَابِهِ",10,"ب",2,0],["يا زَهرَةَ الماضي وَيا","رَيحانَةَ المُستَقبَلِ",11,"ل",1,0],["يا زَوجَةَ اِبنِ المُزنِ يا أُختَ الهَنا","يا ضَرَّةَ الأَحزانِ في الأَحشاءِ",12,"ا",2,0],["يا زَهرَ مِصرَ وَزَينَها وَحُماتَها","مَدحي لَكُم بَعدَ الرَئيسِ فُضولُ",13,"ل",1,0],["يا زاجر الأظعان يحفزها السُّرى","قف بي عليها وقفة المتلوِّمِ",14,"م",1,0],["يا زاجر الأظعان وهي مشوقة","أشبهتها في زفرة وأوارِ",15,"ر",1,0],["يا زَيْنَ قلبي لست أبرح عانياً","أرضى بسقمي في الهوى وعناني",16,"ا",3,0],["يا زَيدُ يا سَيِّدَ النَجّارِ إِنَّ لِما","أَحدَثَ قَومُكَ في عُثمانَ لي خَبَرا",17,"ر",2,0],["يا زَيدُ هَل لَكَ فيهِم قَبلَ موبِقَةِ","تُسَعِّرُ النارَ في أَفنائِهِم سَعَرا",17,"ر",2,0],["يا زَيدُ أَهدِ لَهُم رَأياً يُعاشُ بِهِ","يا زَيدُ زَيدَ بَني النَجّارِ مُقتَصَرا",17,"ر",2,0],["يا زَيدُ أَخرِج بَني النَجّارِ إِذ عَمِيَت","وَاِرفِض طَوائِفَ غَسّانٍ لَها الأُخَرا",17,"ر",2,0],["يا زائِري قاضي القضاة ليهْنكم","ما حقَّقَ التجريب من أبوابه",18,"ه",1,1],["يا زمن اللهو وعصرَ الصبى","سقاكَ صوب الرَّائح الغادي",19,"ي",1,0],["يا زائد الأشواق زائر قبره","سلّم على خير البرية يسمع",20,"ع",1,0],["يا زارعاً مني النبات الذي","يعجب بالأمداح من يزرع",21,"ع",1,0],["يا زمان الصبا سقتك الغوادِي","أينَ كأسي وروضتي ونديمي",22,"م",2,0],["يا زمن الوصل سقاك الحيا","ودمع أشواقي بمركوم",23,"م",1,0],["يا زماناً عُكسَتْ أحواله","فسُروج الخيل تعلوها اللُّبُودُ",24,"د",1,0],["يا زوجَ تلك التي زو","جُها البريةُ غيري",25,"ي",1,0],["يا زوجة الأعمى المباحِ حريمُهُ","يا عرس ذي القرنين لا الإسكندر",26,"ر",1,0],["يا زوجَ زيّافةٍ مُقَرْقرةٍ","ذات فراخٍ وذاتِ أعشاش",27,"ش",1,0],["يا زينهم إذ كان أشأمهم","شيناً وليس الأنف كالسلعه",28,"ع",2,0],["يا زينةَ الدنيا وزينةَ أهلِها","وثمالَ من أعيا عليه ثمالُ",29,"ل",1,0],["يا زمانَ الرضاع أرضعكَ المُزْ","نُ وأكدى على زمانِ الفِطام",30,"م",1,0],["يا زينةَ الدين والدنيا إذا احتفلا","وأظهرا ما أعدَّاهُ مِنَ الزِّيَنِ",31,"ن",1,0],["يا زَيدُ كَيفَ نَسيتَ عَمرَكَ","وَأَطَلتَ بَعدَ الوَصلِ هَجرَك",32,"ك",1,1],["يا زَماني الَّذي مَضى يا زَماني","لَكَ مِنّي تَواتُرُ الزَفَراتِ",33,"ت",1,0],["يا زهرةً سامَها العَا","برونَ خَسْفاً وهونَا",34,"ن",2,0],["يا زهورَ الحياةِ للحبِّ أنتنَّ","ولكنَّهُ مخيفُ الورودِ",35,"د",1,0],["يا زهرتي حيتك انداء","الربيع الماطره",36,"ر",2,0],["يا زهرة الروض الجميلة انني","لمن الفراق وويله خشيان",37,"ن",1,0],["يا زهرة البستان ان قصيدتي","تبكى كمن احبابه قد بانوا",37,"ن",3,0],["يا زينة الإصباح والإمساء بل","يا رونق الآصال والأسحار",38,"ر",1,0],["يا زَمَنَ الوَصلِ لَأَنتَ المُنى","وَلِلمُنى عِقدٌ وَأَنتَ النِظام",39,"م",1,0],["يا زَمانَ البِحارِ لَولاكَ لَم تُف","جَع بِنُعمى زَمانِها الوَجناءُ",40,"ا",2,0],["يا زهرتي لم أدرِ هل عَرَقُ الضنى","هذا عليكِ أم الندَى يعلوكِ",41,"ك",1,0],["يا زائراً عجلان لَم","يطل اللقاء ولَم يقم",42,"م",1,0],["يا زَوجَةَ المِسكينِ مُقرانَ الَّتي","عَظُمَت عَلى المُتَطَرِّقينَ وَفاتُها",43,"ت",3,1],["يا زينَ مذهبِهِ كفى أسفاً","أنَّ الصدورَ بموتِكَ انسروا",44,"ر",3,0],["يا زيدُ ما عاشرتَ عَمْراً سدى","لكنْ طواشيهِ صبيحٌ مليحْ",45,"ح",1,1],["يا زاجِرَ الطَيرِ أَمسِك عَن بَوارِحِها","ماذا تَهيجُ سِوى تَنعابِ غِربانِ",46,"ن",1,0],["يا زيدُ ما حقّ مَن دَلَّتكَ إذ صَدَقتْ","أسْرٌ تَضِيقُ به ذَرعاً وإرغامُ",47,"م",1,0],["يا زَيْدُ قُمْ بالأمرِ وَاكْتُبْ وَاجْتَنِبْ","خَطَأ الغُواةِ وكَبْوَةَ الجُهَلاءِ",48,"ا",2,0],["يا زَيْدُ أدَّيْتَ حقَّ اللهِ فامْضِ على","نَهْجِ الأُلَى انتقلوا من قبلُ وانْتَقلِ",49,"ل",1,0],["يا زعيمَ القومِ أيقِنْ وَاسْتَفِقْ","إنّه الحقُّ الذي لم تَزعُمِ",50,"م",1,0],["يا زعيمَ القومِ هل من نادمٍ","إنّما يَهلكُ مَن لم يندمِ",50,"م",1,0],["يا زيدُ من صنع الثَّريدَ وما عسى","ترجو بما حَملتْ يداك وتأمُل",51,"ل",1,0],["يا زَهرَةَ الوادي أَتيتُ بِزَهرة","لَكِ مِن رُبى لُبنان فاحَ شَذاها",52,"ا",3,1],["يا زَهرَةَ البُستانِ","يا نَفحَةَ الرَيحانِ",53,"ن",1,0],["يا زَينَباً حُلِّيَت وَدَعداً","كَم مَرَّ مِن زَينَبٍ وَدَعدِ",54,"د",1,0],["يا زهرة الشرق الَّتي قد أزهرت","حيناً كأحسن كوكب نوراني",55,"ن",2,0],["يا زمان البخار حسبك فخراً","أنه فيك تنقضي الحاجات",56,"ت",1,0],["يا زهرةً عذراء تنشر عِطرَها","وتُذيعُ في جفنِ الضُّحى أحلامَها",57,"ه",2,0],["يا زعيمَ الشعب هذي محنةٌ","فوق ما يحمل طوقُ الزعماءْ",58,"ا",2,0],["يا زهراتي ويكِ لا تسأمي","لا يَرُعكِ الزّمنُ الدائرُ",59,"ر",1,0],["يا زهراتي كم حديثٍ لنا","عن موعد في ليلة أو نهارْ",59,"ر",1,0],["يا زماناً يمرُّ كالطير مهلاً","طائر أنتَ ويك قِفْ طيرانكْ",60,"ك",1,0],["يَا زيْدَ كلِّ مُسرَجٍ ومُلجَمِ","كيف علا غُرَّتَك ابنُ ملجم",61,"م",1,0],["يَا زَائِرَ الْحَسْنَاءِ فِي عِيدِهَا","إِنْ تُهْدِ فَانْظُرْ مَا الَّذِي تُهَدِي",62,"ي",1,1],["يَا زِينَةَ الْبَيْتِ تَزْهُو","كَوَرْدَةٍ فِي سِيَاجِ",63,"ج",1,0],["يَا زَائِريَّ تَمَتَّعَاً","أَبَداً بَشَمْلِكُمَا الجَّمِيعْ",64,"ع",1,1],["يا زَمانُ لا جَلَدٌ","بِع شَعوبُ أَشتَرِها",65,"ر",3,0],["يا زَمان اِتّئد إِلى كَم تُرَزّي","جَدَّ وَجدي وَأَنتَ بي مُتَهَزّي",66,"ي",1,1],["يا زانِيَ اِبنَ الزاني اِب","نَ الزاني اِبنَ الزانِيَه",67,"ي",2,0],["يَا زَهْرَةَ الصحْراءِ رُدِّ","ي 