ldiwan.net/poem48262.html","عموديه"],[549,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[551,"لم أصح من لذة لا لا ولا طرب","https://www.aldiwan.net/poem68405.html","البسيط"],[551,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[560,"عناية الله في بيروت قد وضعت","https://www.aldiwan.net/poem52654.html","البسيط"],[560,"قد أشرق النور أكناف لبنان","https://www.aldiwan.net/poem52928.html","البسيط"],[560,"أعطى محمد عزة من فضله","https://www.aldiwan.net/poem52936.html","الكامل"],[584,"يا زائرا جعل الدجنة مركبا","https://www.aldiwan.net/poem17424.html","الكامل"],[584,"يا راقدا لم يدر عمر الدجى","https://www.aldiwan.net/poem17514.html","السريع"],[584,"من سحر طرفك يا علي","https://www.aldiwan.net/poem17665.html","مجزوء الكامل"]],"verses":[["يا زَهرَةَ الغَوطَتَينِ تَبخُلُ بِالبِش","رِ وَما مَسَّ أَرضَكِ العَدَمُ",0,"م",1,0],["يا زائِراً ما جاءَ حَتّى مَضى","وَعارِضاً ما غامَ حَتّى اِنجَلى",1,"ل",2,0],["يا زَفرَةً هَيَّجَها","حادٍ مِنَ الغَورِ حَدا",2,"د",2,0],["يا زَورَةً بِمَصابِ المُزنِ مِن إِضَمٍ","مَحفوفَةً مِن عَذارى الحَيِّ بالمُقَلِ",3,"ل",1,1],["يا زَينَ مَن رَأَتِ العُيونُ إِذا بَدَت","وَسطَ النِساءِ وَلَفَّهُنَّ المَجمَعُ",4,"ع",1,1],["يا زَينَ مَن وَلَدَت حَوّاءُ مِن وَلَدٍ","لَولاكَ لَم تَملُحِ الدُنيا وَلَم تَطِبِ",5,"ب",1,1],["يا زاجرَ العيسِ أنْضاءً مُضَمّرَةً","كأنّها أسْهمٌ يمرُقْنَ عنْ فوَقِ",6,"ق",1,0],["يا زاجِرَ البُدْنِ القِلاصِ يُقيمُهُ","أنْجادُهُ وتُقيمُهُ أغْوارُهُ",7,"ر",2,0],["يا زاجِرَ الوَجْناءِ يعْتَسِفُ الفَلا","والليْلُ يَعْثُرُ في فُضولِ مُسوحِ",8,"ح",1,0],["يَا زَمَاناً أغْرَى الْفِرَاقَ بِشَملِي","لَيْتنِي أُهْبَتي أَخَذْتُ لِحَرْبِكْ",9,"ك",1,0],["يَا زَوْرَةَ الأَلَمِ الَّذِي مَهْمَا يُرَى","جَاءَتْ رِكَابُ الْمَوْتِ فِي أَعْقَابِهِ",10,"ب",2,0],["يا زَهرَةَ الماضي وَيا","رَيحانَةَ المُستَقبَلِ",11,"ل",1,0],["يا زَوجَةَ اِبنِ المُزنِ يا أُختَ الهَنا","يا ضَرَّةَ الأَحزانِ في الأَحشاءِ",12,"ا",2,0],["يا زَهرَ مِصرَ وَزَينَها وَحُماتَها","مَدحي لَكُم بَعدَ الرَئيسِ فُضولُ",13,"ل",