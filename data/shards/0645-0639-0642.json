{"poems":[[65,"أهاجك شوق بعدما هجع الركب","https://www.aldiwan.net/poem46205.html","الطويل"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[31,"ومحبوسة في الحي ضامنة القرى","https://www.aldiwan.net/poem6056.html","الوافر"],[93,"من أسود تسربلت بالحديد","https://www.aldiwan.net/poem8806.html","عموديه"],[63,"أخلق بغائب رشده أن يقدما","https://www.aldiwan.net/poem51455.html","الكامل"],[99,"بي نزوع إلى الدموع الهوامي","https://www.aldiwan.net/poem24764.html","الخفيف"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[77,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[50,"بادر شبابك قبل الشيب والعار","https://www.aldiwan.net/poem63284.html","البسيط"],[50,"معقرب الصدغ ملبوس عوارضه","https://www.aldiwan.net/poem64403.html","البسيط"],[154,"سبحان من في كل شيء شاهد","https://www.aldiwan.net/poem68495.html","الكامل"],[178,"سقيا للذات وطيب","https://www.aldiwan.net/poem46063.html","مجزوء الكامل"],[185,"أمن طلل بالجزع قو المعارف","https://www.aldiwan.net/poem58844.html","الطويل"],[193,"خير البلاد علا وعيشا","https://www.aldiwan.net/poem35161.html","مجزوء الكامل"],[261,"عمرك الله يا ابن عمرو","https://www.aldiwan.net/poem48441.html","مخلع البسيط"],[303,"كم في أزاهير الرياض لناظر","https://www.aldiwan.net/poem36839.html","عموديه"],[356,"إن القفول الذي أوفى بعيدين","https://www.aldiwan.net/poem68964.html","البسيط"],[362,"ما عسى تبلغ شكراً ما عسى","https://www.aldiwan.net/poem4166.html","الرمل"],[369,"روحا ساعة متون القلاص","https://www.aldiwan.net/poem60864.html","الخفيف"],[369,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[415,"لو أحسنوا في ملكنا أو أعتقوا","https://www.aldiwan.net/poem32423.html","الكامل"],[463,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[556,"أرقت للبرق بالعلياء يضطرم","https://www.aldiwan.net/poem47247.html","البسيط"],[558,"أغرى به الشوق ليل الساهر الرمد","https://www.aldiwan.net/poem68425.html","البسيط"],[581,"يا آل بكر ألا لله أمكم","https://www.aldiwan.net/poem1798.html","البسيط"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2516","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122785","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119895","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119989","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56379","المجتث"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112819","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69378","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110297","الرمل"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95280","المديد"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109386","البسيط"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28093","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65983","الرجز"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99323","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62941","الوافر"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101242","السريع"],[3763,"","https://poetry.dctabudhabi.ae/diwan/poem/124162","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44705","الخفيف"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""],[4816,"البارحة","https://www.poetsgate.com/ViewPoem.aspx?id=199483",""],[4849,"عاجبك يعني","https://www.poetsgate.com/ViewPoem.aspx?id=53503",""],[4869,"مرثيه في الامير سلطان بن عبدالعزيز","https://www.poetsgate.com/ViewPoem.aspx?id=151548",""],[4869,"انتي سما لكن بها تجري الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=151608",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[5664,"لا يالقصيده","https://www.poetsgate.com/ViewPoem.aspx?id=176686",""],[5664,"حفيف الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=176687",""],[5664,"اوراق","https://www.poetsgate.com/ViewPoem.aspx?id=46532",""],[5689,"حطمت لي يد القضا كل فلس","https://www.poetsgate.com/ViewPoem.aspx?id=143434",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5848,"ماعاد الايام بيض","https://www.poetsgate.com/ViewPoem.aspx?id=48846",""],[5848,"شهرك مبارك","https://www.poetsgate.com/ViewPoem.aspx?id=50618",""],[1793,"لَعائِنُ اللَهِ مُتابَعاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=14816",""]],"verses":[["مُعَقّلَةً والبَحْرُ طامٍ عُبابُهُ","على الخَسْفِ لا ماءٌ لَدَيْها ولا عُشْبُ",0,"ب",1,0],["معقلُ الخائفينَ عند اللُّتيَّا","والتي بعدها وأزمِ أزامِ",1,"م",1,0],["مُعَقَّرَةٍ لا تُنكِرُ السَيفَ وَسطَها","إِذا لَم يَكُن فيها مَعَسٌّ لِحالِبِ",2,"ب",1,0],["مَعقِلٌ أَصبَحَت جَحافِلُ هيتو","حَولَهُ كَالعُقودِ حَولَ الجيدِ",3,"د",1,0],["معقودةٌ غُرَرُ الجيادِ لنَقعِه","وحُجولُها مما يخوضُ به الدِّما",4,"م",2,0],["معقبٌ لذة لنفسي","وإحساس هناء لديّ بعد التئام",5,"م",1,0],["معقل يعصم النفوس ويأبى","أن يميل الهوى بها أو يجورا",6,"ر",2,0],["مُعَقِّرُ الهَجْمةِ ليلَ القِرَى","إذا عِجافُ المالِ لم تُنْق",7,"ق",1,0],["مُعَقرَبُ الرَأسِ كَالمِسراجِ صَنعَتُهُ","سِحرٌ وَما مَسَّهُ تَعقيدُ سَحّارِ",8,"ر",1,0],["مُعَقرَبُ الصُدغِ مَلبوسٌ عَوارِضُهُ","جِلبابُ خَزٍّ عَلَيهِ النَورُ مَقطوفُ",9,"ف",1,1],["معقود أزرار القميص على التُّقى","واللهُ حافظه له والعاقد",10,"د",1,0],["معْقُولَةٍ بِيَدِ الْهَوَى","مَرْبُوبَةٍ بِيَدِ الرَّبِيبِ",11,"ب",1,0],["مُعَقرَبَةِ الأَنسَاءِ لُزَّت فُرُوعُها","إِلَى مِثلِ أَقرَاء الصُّفِىِّ الزّحَالِفِ",12,"ف",1,0],["مَعَ قربهِ من ربّهِ","ما زالَ يَرجوهُ ويَخشى",13,"ش",2,0],["مع قينةٍ لا تريد غيري","فهي تجيني بغير حذر",14,"ر",1,0],["معقودةُ الإكليل زهراء الحلى","خفاقةُ الأقراط ذات أساور",15,"ر",1,0],["معقربين كنوني كاتبٍ نقطا","فقابلا من مداد المسك راءين",16,"ن",1,0],["مَعقلٌ قالَ لَهُ النَّصرُ ألا","كُن عِقَالاً لَهُمُ أَو مَحبِسَا",17,"س",2,0],["مُعقِياً فيه للجَميلِ حديثاً","تَتَهاداه ألسُنُ القُصّاص",18,"ص",1,0],["مُعَقْرَبُ الصُّدغِ يَحِكي نُورُ غُرَّتِه","بَدْراً بدا بظلامِ اللّيلِ مُعتَجِرا",19,"ر",2,0],["مَعْقُولةٌ بِيَد الغَرامِ طليقةٌ","هَل يُفتَدى ذاكَ الأسيرُ المطْلقُ",20,"ق",1,0],["معقودةً بالخلود طرّتُها","فما تقول الدنيا لها انفصِمي",21,"م",2,0],["مَعقولةٌ باِزدِحامِ الخيل تُعثِرها","ولا عِثارَ بها الأحشاءُ والقِمَمُ",22,"م",1,0],["مُعَقِّرُ الكُومِ لِلأَضيافِ لَيسَ لَها","إِلّا المَكارِمَ مِن ذي عَقلٍ وَلا قَوَدِ",23,"د",1,0],["مَعقولَةٌ يَنظُرُ التَشريقَ راكِبُها","كَأَنَّها مِن هَوىً لِلرَّملِ مَسلوسُ",24,"س",1,0],["مَعقِلُ القَومِ مِن قُرَيشٍ إِذا ما","فازَ بِالجَهلِ مَعشَرٌ آخَرونا",25,"ن",2,1],["مُعَقرَبَ الصَّدغ يَحمي لَثمَ وَجنتَهِ","مِن شَعرِه عَقرَبٌ فيهِ وَثُعبانُ",26,"ن",1,0],["معقولة بنداك سائرة","ماسار يوما سيرها القمر",27,"ر",1,0],["معقولة بنداكَ شاردةً","سهلُ عليها قطعها الحَزنا",28,"ن",2,0],["مع قاسم خير شبلٍ","به استهام الفؤادُ",29,"د",1,0],["مع قيل السلام وأشمل الآل","مع صحاب نحو طريق الرشاد",30,"د",1,0],["مع قصد نفي الجنس نصّا ثملا","يفصل بينها وبين اسم تلا",31,"ل",2,0],["معقلي صاحب الزمان فإني","أختشي من صروفه برحاها",32,"ا",3,0],["مَعقُودَةٌ بِالعِزِّ إِلّا أَنَّها","عَذَبٌ لِحاسِدِكُم بِهِنَّ عَذابُ",33,"ب",1,0],["معقلٌ ردَّ دواهيهِ فما","باءَ إلا بالأماني الخائباتِ",34,"ت",1,0],["مَع قِسيٍّ للحواجبِ قَد","جُذبا للرَّميِ واِقترنَا",35,"ن",2,0],["معقود شالٍ بخصر مثل خنصره","يا سعد صب تولَّى حلَّ عقدته",36,"ت",2,0],["مَعقومَةً لاحَمَ الدأياتُ جُوشَنها","في كاهِلٍ لَم يَخُن صُلباً وَلا عُنُقا",37,"ق",2,1],["مع قاصف من ريح موج هب في","موج الخطايا الهائل اللطام",38,"م",1,0],["معقلي نهر معقل فإن ارتح","ت الى منزل فدير نجاح",39,"ح",1,0],["معقدة السبيبِ على قطاها","دِلاصٌ في مطاويها غُصونُ",40,"ن",1,0],["معقرب الصدغ على خده","دبت عذاراه دبيب النمال",41,"ل",1,0],["معقل الحسن في محياك لا يطم","ع فيه والثغر ثغر محصن",42,"ن",1,1],["مَعقِلاً يَمنَعُ أَن جَدَّ الطِلاب","ذَلِكَ الجُرفُ العَريضُ المثتَّسِع",43,"ع",1,0],["مَعقِلُ الودِّ دائِماً في خَرابٍ","وَغرابُ الشقاق فيهِ يَحومُ",44,"م",1,1],["مَعقِلٌ يَأمَنُ مَن كانَ بِهِ","غَلَبَت مَن قَبلَهُ أَن تُقتَلَع",45,"ع",1,0],["معقلا كل رفعةٍ بعلاها","يستظلُّ العلا فيأبي اجتنابا",46,"ب",2,0],["مع قبلة الشمس حزة وقت مغربها","اضفى علي الاصيل ووقتي قْصيّر",47,"ر",1,0],["معقول مالي مكان ف قلبك الخالي","والنوم يحرم لعيني وأنت يهنالك ؟",48,"ك",1,0],["معقول والا بس هذي اشآعه","يآنآآآس يآعآلم يا / آآآهٍ وآآآه",49,"ا",2,0],["معقول اقول انك عجيبه ومعقول","جنبك بنات الناس شبه الرجاجيل",50,"ل",1,0],["معقب دنياه أخرا","ه خسارا فخسارا",51,"ر",2,0],["معقول ما اقدر اكتب اليوم بيتن","ولا من الطعنات روحي جريحه",52,"ح",2,1],["معقول فوق الجرح دايم يغنون","ولافيهم اللي شاف زرقة طعوني",53,"ن",2,0],["معقول ما مرّوا على بحر الاحداق","ولا شافوا دموعي من الشوق غرقى!",54,"ق",2,0],["معقل الظلام والظلم ومثوى","كل طلس من الذاب وشرس",55,"س",1,0],["معقربة الأصداغ منها جفونها","تردد فيها غنجها وفتورها",56,"ر",3,0],["معقول تنسى ولا تذكر سواياهم","غلطاتهم حبر ! ليش تكون محايه",57,"ا",3,0],["معقول يعني ما تطاوعك اناملك !","تدق رقم اللي فقد له فقيدة",58,"د",2,0],["مُعَقَّداتٍ كَرُقى الحَيّاتِ","سُبحانَ مَن جَلَّ عَنِ الصِفاتِ",59,"ت",1,0]]}