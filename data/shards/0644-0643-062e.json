{"poems":[[74,"كم عذول على هواك أداجي","https://www.aldiwan.net/poem18451.html","الخفيف"],[87,"قيل ما الفن قلت كل جميل","https://www.aldiwan.net/poem7122.html","الخفيف"],[87,"لك خد كأنه قطعة الجلد","https://www.aldiwan.net/poem7561.html","الخفيف"],[87,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[99,"عجباً لعارية كساها","https://www.aldiwan.net/poem25001.html","مجزوء الكامل"],[71,"لك خد كل من قبله","https://www.aldiwan.net/poem28740.html","الرمل"],[164,"لك خارقات عوائد لن تعرفا","https://www.aldiwan.net/poem58902.html","الكامل"],[197,"يا من يعد لسانه","https://www.aldiwan.net/poem13135.html","مجزوء الكامل"],[240,"يا من رأى حد الحسام مضاءه","https://www.aldiwan.net/poem31747.html","الكامل"],[447,"شوقي إليك على نواك أهامني","https://www.aldiwan.net/poem14321.html","الكامل"],[458,"من فؤادي يا أم هذي التحية","https://www.aldiwan.net/poem61332.html","الخفيف"],[567,"طال شوقي لطول هذا البعاد","https://www.aldiwan.net/poem52967.html","الخفيف"],[591,"قمر يجلو دجى الغلس","https://www.aldiwan.net/poem17971.html","المديد"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96985","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99975","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79924","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79862","الخفيف"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47154","الكامل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67957","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137323",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137259",""],[2677,"","https://poetry.dctabudhabi.ae/diwan/poem/147752","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100379","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115485","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132763","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74045","الخفيف"],[3511,"","https://poetry.dctabudhabi.ae/diwan/poem/202632","الخفيف"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86502","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133278","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103011","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77121","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136676",""],[4630,"","https://poetry.dctabudhabi.ae/diwan/poem/145253","الخفيف"],[4782,"الى معلمتي \" الملاك الحارس\"","https://www.poetsgate.com/ViewPoem.aspx?id=208645",""],[4968,"قل ياسميرة","https://www.poetsgate.com/ViewPoem.aspx?id=206750",""],[5368,"أحبابنا هجروا","https://www.poetsgate.com/ViewPoem.aspx?id=184852",""]],"verses":[["لك خدّ سناه يوهج قلبي","حزني من سراجك الوهَّاج",0,"ج",1,0],["لك خط لو كان يغنى عن الحظ","جميل من الأمور لأغنى",1,"ن",2,0],["لك خدّ كأنه قطعة الجل","مد ثقلا فمن تراه استخفه",2,"ه",1,1],["لَكِ خَيلٌ بِجَناحٍ أَشبَهَت","خَيلَ جِبريلَ لِنَصرِ الأَنبِياء",3,"ا",2,0],["لك خفة الطير المحل","لق طائراً أو واقعا",4,"ع",2,0],["لك خفة البطل المجل","لي مقبلاً أو راجعا",4,"ع",2,0],["لكَ خدٌّ كلُّ مَنْ قَبَّلَهُ","أَضْمَنُ الجنةَ والنارَ لهُ",5,"ه",1,1],["لكَ خارقاتُ عوائد لن تعرَفا","في مقتفٍ أثراً ولا في مقتضى",6,"ض",2,1],["لَكَ خاطِرٌ لِبَدائِعِ ال","أَلفاظِ وَالمَعنى مسنّى",7,"ن",2,0],["لَكَ خَلَّتانِ صَرامَةٌ وَسَماحَةٌ","يَتَعاقَبانِ سِياسَةً وَتَكَرُّما",8,"م",2,0],["لك خاطر ومبارك يا خنجر","ودّاً على ودي صفاكم زادني",9,"ن",2,0],["لك خلّصته من الكدر الشائع مر","آة كل ما صنت فيّه",10,"ي",2,0],["لكَ خَوفٌ لو صادَفَ العينَ في الحُلْ","مِ لَصارَتْ تَخافُ طيبَ الرُقادِ",11,"د",1,0],["لَكَ خَدّ يَا أَبَا الفَرَجِ","زُيِّنَ بِالتَّوْرِيدِ وَالضَّرَجِ",12,"ج",1,0],["لك خد بمهر خالٍ عليه","خطب القلب للغرام فانعم",13,"م",1,0],["لكَ خَدٌّ مُوَرَّدُ اللَّوْن سَهْلٌ","وَفَمٌ طَيِّبُ الْمُجَاجَةِ عَذْبُ",14,"ب",1,0],["لك خُلقٌ به الرضى لمحبٍّ","ولذي البُغض والقِلى فيه سُخط",15,"ط",1,0],["لك خلقٌ لو ذاقه مُجتني النحلِ","دعى ما جنيتُ ما عشتُ نحلا",16,"ل",2,0],["لك خطّة الشّرَف التي لم يَحْوِها","مَلِكٌ وإنْ عَظُمَتْ خِصَال كماله",17,"ل",2,0],["لكَ خيرُ البيتينِ من مسجدي جَدِّ","كَ والمنشأين والمسكنينِ",18,"ن",1,0],["لك خير ذكر في البلاد تضوعت","نفحاته كاريج ورد عاطر",19,"ر",1,0],["لك خلتان فصاحة وبلاغة","بهما الفصيح غدا امامك ابكما",20,"م",2,0],["لكِ خد تذيبه الأبصار","يخجل الورد منه والجلنار",21,"ر",1,1],["لك خدّ ارقُّ من دمعة الصب","واصفى من النمير زلالا",22,"ل",2,0],["لكَ خدٌ كأنه التفّاحُ","وثنايا كأنهنَّ الأقاحُ",23,"ح",1,1],["لك خل على الوداد أمين","صادق العهد بالوفاء قمين",24,"ن",1,1],["لكَ خلق زاكٍ شَذاه وَخلق","تَركَ الصبح خلفه وَتلالا",25,"ل",2,0],["لك خُلْق كأَنّه عَرْفُ مِسْكٍ","دُونه في مَذاقِهِ السَّلسبيلُ",26,"ل",1,0],["لَكَ خالِدُ الشِعرِ الَّذي ما قالَهُ","مِن أَهلِ عَصرِكَ ناطِقٌ بِالضادِ",27,"د",1,0],["لك خير جاه في المكارم يرتجى","وجنابك المقصود للرواد",28,"د",1,0],["لك خير صيت في الكرامة ذائع","ومناقب جلت عن التعداد",28,"د",1,0],["لك خد ومبسم علّم الور","د ابتهاجاً والاقحوان ابتساما",29,"م",2,0],["لَكَ خَلقُ الرِياضِ دَبجَها الطَ","لُّ بَندُ فَعَبَرتَ عَن عَبيرِ",30,"ر",1,0],["لك خصرٌ يشكو النُحول كجسمي","لا تَراه العيون الا خَيالا",31,"ل",2,0],["لك خد كأنه جلنار","وثغور كأنهن لآل",32,"ل",1,0],["لكِ خافقٌ يهمي كَوَبْلِ غَمامةٍ","تروى الفؤادَ وتٌنبتُ الزهرَ الخُزام",33,"م",1,0],["لَكَ خَافِقِي واللهُ يَعلَمُ أنّني","بمداكَ أحيا درّةً بمَحارِ",34,"ر",1,0],["لكَ خالِقٌ إِنْ تَدْعُهُ وَجِلاً","تَلْقَ الرِّضا بالصَّبْر والجَلَدِ",35,"د",1,0]]}