{"poems":[[72,"كم عذول على هواك أداجي","https://www.aldiwan.net/poem18451.html","الخفيف"],[85,"قيل ما الفن قلت كل جميل","https://www.aldiwan.net/poem7122.html","الخفيف"],[85,"لك خد كأنه قطعة الجلد","https://www.aldiwan.net/poem7561.html","الخفيف"],[85,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[97,"عجباً لعارية كساها","https://www.aldiwan.net/poem25001.html","مجزوء الكامل"],[69,"لك خد كل من قبله","https://www.aldiwan.net/poem28740.html","الرمل"],[160,"لك خارقات عوائد لن تعرفا","https://www.aldiwan.net/poem58902.html","الكامل"],[193,"يا من يعد لسانه","https://www.aldiwan.net/poem13135.html","مجزوء الكامل"],[235,"يا من رأى حد الحسام مضاءه","https://www.aldiwan.net/poem31747.html","الكامل"],[441,"شوقي إليك على نواك أهامني","https://www.aldiwan.net/poem14321.html","الكامل"],[453,"من فؤادي يا أم هذي التحية","https://www.aldiwan.net/poem61332.html","الخفيف"],[562,"طال شوقي لطول هذا البعاد","https://www.aldiwan.net/poem52967.html","الخفيف"],[586,"قمر يجلو دجى الغلس","https://www.aldiwan.net/poem17971.html","المديد"]],"verses":[["لك خدّ سناه يوهج قلبي","حزني من سراجك الوهَّاج",0,"ج",1,0],["لك خط لو كان يغنى عن الحظ","جميل من الأمور لأغنى",1,"ن",2,0],["لك خدّ كأنه قطعة الجل","مد ثقلا فمن تراه استخفه",2,"ه",1,1],["لَكِ خَيلٌ بِجَناحٍ أَشبَهَت","خَيلَ جِبريلَ لِنَصرِ الأَنبِياء",3,"ا",2,0],["لك خفة الطير المحل","لق طائراً أو واقعا",4,"ع",2,0],["لك خفة البطل المجل","لي مقبلاً أو راجعا",4,"ع",2,0],["لكَ خدٌّ كلُّ مَنْ قَبَّلَهُ","أَضْمَنُ الجنةَ والنارَ لهُ",5,"ه",1,1],["لكَ خارقاتُ عوائد لن تعرَفا","في مقتفٍ أثراً ولا في مقتضى",6,"ض",2,1],["لَكَ خاطِرٌ لِبَدائِعِ ال","أَلفاظِ وَالمَعنى مسنّى",7,"ن",2,0],["لَكَ خَلَّتانِ صَرامَةٌ وَسَماحَةٌ","يَتَعاقَبانِ سِياسَةً وَتَكَرُّما",8,"م",2,0],["لك خاطر ومبارك يا خنجر","ودّاً على ودي صفاكم زادني",9,"ن",2,0],["لك خلّصته من الكدر الشائع مر","آة كل ما صنت فيّه",10,"ي",2,0],["لكَ خَوفٌ لو صادَفَ العينَ في الحُلْ","مِ لَصارَتْ تَخافُ طيبَ الرُقادِ",11,"د",1,0],["لَكَ خَدّ يَا أَبَا الفَرَجِ","زُيِّنَ بِالتَّوْرِيدِ وَالضَّرَجِ",12,"ج",1,0]]}