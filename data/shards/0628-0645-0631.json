,"الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91008","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54408","المتقارب"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136472",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33265","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72651","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72809","الرمل"],[382,"","https://poetry.dctabudhabi.ae/diwan/poem/112010","الوافر"],[4755,"رثاء مريم","https://www.poetsgate.com/ViewPoem.aspx?id=199851",""],[4767,"مأساة مضخة الماء","https://www.poetsgate.com/ViewPoem.aspx?id=181851",""],[4829,"التوابع والزوابع","https://www.poetsgate.com/ViewPoem.aspx?id=34253",""],[4994,"مسيح لم تقرأه صلبانه","https://www.poetsgate.com/ViewPoem.aspx?id=210812",""],[5136,"شمس الهدى وسراج الظلم","https://www.poetsgate.com/ViewPoem.aspx?id=121670",""],[5353,"ملحمة فجر الصابرين","https://www.poetsgate.com/ViewPoem.aspx?id=212649",""],[1920,"الوطن القلب","https://www.poetsgate.com/ViewPoem.aspx?id=191447",""],[6093,"نسيمٌ خادع (الطويل)","https://www.poetsgate.com/ViewPoem.aspx?id=188632",""],[2220,"إذا حسنتَ ظنكّ بالرجالِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11711&r=&rc=581",""],[572,"شَارفَتْنَا طَلائعُ المهرجانِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9486&r=&rc=343",""]],"verses":[["بِمَرثِيَةٍ فيها ثَناءٌ مُحَبَّرٌ","لأزهَرَ مِن أَولادِ مُرَّةَ مُعرِقِ",0,"ق",1,0],["بِمِرْقَمِهِ فَاضَ الْبَيَانُ مَآثِراً","وَمِنْ قَبْلِهِ غَاضَتْ بِهِنَّ المَرَاقِمُ",1,"م",1,0],["بِمُرهَفٍ ذي بارِقِ","أَخلَصَهُ الصَياقِلُ",2,"ل",1,0],["بمرآة حسن قد جَلَتْها يدُ النهى","فأوصافه يلتاحُ فيه بديعُها",3,"ع",3,0],["بِمُرهَفَةٍ بيضٍ إِذا هِيَ جُرِّدَت","تَأَلَّقُ فيهِنَّ المَنايا اللَوامِعُ",4,"ع",1,0],["بِمَرضِيِّ السِّيَاسَةِ هَاشِمِيٍّ","يَكُونُ حَيَاً لأُمَّتِهِ رَبِيعَا",5,"ع",2,0],["بمرأى من الدنيا جميلٍ ومَسْمعٍ","لدى ملكٍ بالحق لا مُتمالك",6,"ك",1,0],["بِمُرتَجِزٍ داني الرَبابِ كَأَنَّهُ","عَلى ذاتِ مِلحٍ مُقسِمٌ لا يَرَيمُها",7,"م",3,0],["بمَراشِفِ الأَحلامِ مُنْطلقاً","يسيرُ على مَهَلْ",8,"ل",1,0],["بِمَراثٍ كَتَبنَ بِالدَمعِ عَنّا","أَسطُراً مِن جَوىً وَأُخرى غَليلا",9,"ل",2,0],["بمرقومةٍ تُصْبِي العقولَ كأنَّما","تخايلتَ منها بين قولِكَ والفِعْلِ",10,"ل",1,0],["بِمُرهَفَةٍ يُذري السَواعِدَ وَقعَها","وَيَفلِقُ هامَ الدارِعينَ ذُكورُها",11,"ر",3,0],["بمرخَّم الساحاتِ تحسبُ أنّهُ","فُرِشَ المَها وتَوَشّحَ الكافورا",12,"ر",2,0],["بمراتبٍ تُبْنى وبأسٍ يُتّقَى","وسعادةٍ تَنْمى وكعبٍ يعتلي",13,"ل",2,0],["بِمُرَوَّقِ الأَخلاقِ لَو عاشَرتَهُ","لَرَأَيتَ نُجحَكَ مِن جَميعِ خِصالِهِ",14,"ل",2,0],["بمروءةٍ طائيةٍ منكَ اقتدي","هي أولٌ وهو المحلُّ الثاني",15,"ن",2,0],["بمَرْقَبَةٍ مثلَ السِّنانِ تَقَدّمَتْ","خياشِيمُهُ واستُرْدِفَ العاملُ الأصَمّ",16,"م",1,0],["بمر دغدي إذا يتلو بصوتٍ","كصوتِ الزير مع وتَر نطوقِ",17,"ق",1,0],["بِمَرجٍ كَسا القُريانُ ظَاهِرَ لِيطِها","جِساداً مِنَ القُرَّاصِ أَحوَى وأَصفَرا",18,"ر",2,0],["بمرأى ً من الدنيا جيملٍ ومَسْمعٍ","لدى ملكٍ بالحق لامُتمالك",19,"ك",1,0],["بمرشفها لقد هام المعنى","ولو لم يرتشف منها لماها",20,"ا",3,0],["بمرشفها يتامى الدر اكرم","فخير البر اكرام اليتيم",21,"م",1,0],["بِمُرتَشَفٍ كَالأُقحُوانَةِ بارِدٍ","وَمُعتَنَقٍ كَالخيزُرانَةِ أُملودِ",22,"د",1,0],["بمرآتي أراه إذ يراني","أسامره بما أمسى يسامر",23,"ر",1,0],["بمروتها تمرين كل حقيقة","بمشهد حق لا يرام بقاصر",24,"ر",1,0],["بمرآة نفس لاح في صقالها","المقابل للكونين كل حقيقة",25,"ه",1,0],["بمُرهقاتٍ يثبُتن في الحَلَق الس","سَردِ وما تحتَه شَواهدُها",26,"د",3,0],["بِمَرْجَلِّينَ صادفنا فعالاً","تذكِّرنا فعالَ المفترينا",27,"ن",2,1],["بمريم عنوان العفاف اُمِّكَ التي","لديك غدت وهي الشفيعُ المُشفَّع",28,"ع",1,0],["بمريمٍ التي إليها","نشير في ملتقى الصعاب",29,"ب",1,0],["بمرهم التوبة الصدق النصوح فذا","هو الدواء لذاك الداء لو فطنوا",30,"ن",3,0],["بمرعاها الشِّفاءُ وثمّ مرعىً","وبيلٌ مع نضارتِه وبيُّ",31,"ي",1,0],["بمرأَىً هَداهُمْ إِلَى هَدْي هُودٍ","وعادَ إِلَيْهِمْ بأحلامِ عادِ",32,"د",1,0],["بمرهفٍ جرَّدهُ مرهفٌ","بجريد لا مُبْقٍ ولا راحِمِ",33,"م",1,0],["بمُرزَّأ لم يألُ جُهْداً ساعةً","في فعلِ خيرٍ وارتْيادِ صَلاحِ",34,"ح",1,0],["بمرنّحينَ منَ السُّهادِ كأنما","ضنّوا بفضلهِ كأسهِ أنْ تهرقا",35,"ق",2,0],["بِمُرتَج ٍ نَفْثَة ً حَرَّى تُسَعِّرُنا","وَمُرتََج ٍ نَثَّة ً رَيَّا تُهَدِّينا",36,"ن",2,0],["بِمِرَآةٍ إِلى مِرَآةٍ تَهَادَى ال","حُسْنُ مِنْهَا وَمِنْهُ مِرْآتَانِ",37,"ن",1,0],["بمرآهُ يغدو السَّهدُ أَشهى من الكرى","اليها وجنحُ الليلِ ازهى من الفجر",38,"ر",1,0],["بمُرُوج اللَّهْو ألقت","عير لَذَّاتي عصاها",39,"ا",3,0],["بمركزِ أجداثٍ كأنّ شخوصَها","شخوصُ خيامٍ دانياتِ المراكز",40,"ز",1,0],["بمرازب من خلوة ورياضة","وبهمة من تحت كالسندان",41,"ن",1,0],["بمرقبة علياءَ يرفَعُ طَرفَهُ","بها عَلَمٌ دون السماءَ حسيمُ",42,"م",1,0],["بِمُرْسَلِ الشَّعْرِ شَرْعُ الصبُّحِ مُنْتسَخٌ","وجَحْفلُ الَّليلِ بالكاساتِ مَهْزومُ",43,"م",1,0],["بمربع فيه تلقى الوفد عاكفة","كأنه كعبة أضحى إلى البشر",44,"ر",1,0],["بِمُرتَجِزٍ كَأَنَّ عَلى ذُراهُ","رِكابَ الشامِ يَحمِلنَ البُهارا",45,"ر",2,0],["بِمِرْوَحَةٍ راحَةٍ لِلقُلوبِ","لَها نِسْبَتانِ إِذا تَنْتَسِبْ",46,"ب",1,0],["بمرتاح قلبي لوعة مطمئنة","وأعلاق وجد برحها ليس يبرح",47,"ح",1,0],["بِمُرسيةٍ أَلقَى عَصَاهُ وَخَيّما","فَأَنجَدَ بالنَّاسِ السُّرُورُ وَأَتهَما",48,"م",2,0],["بمَرادٍ لكُلِّ هوجاءَ مَرَّت","ليسَ فيهِ لِغَيرِها من مجالِ",49,"ل",1,0],["بِمَرمَرَةٍ وَأَعلاهُ رُخامٌ","تَحامَ لا يُغَيَّبُ بِالشُقوقِ",50,"ق",1,0],["بِمُرْتَجةِ الأرْدافِ هِيفٌ خُصورُها","عِذابٌ ثَناياها لِطافٌ قُيودُها",51,"د",3,0],["بمراعي الدين الحنيفيّ لم يو","صِ وفي قطع بنته أوصاها",52,"ا",3,0],["بِمُرهَفَةٍ مَأثُورَةٍ مَشرَفِيّةٍ","تُؤمُّ غَرَارِتها رُدَينَّةٌ سُمرُ",53,"ر",1,0],["بمراشف منها الأماني تشتهى","ولواحظ منها المنايا تتقى",54,"ق",2,0],["بمرآه الذي عاينت منه","وفيه ما يذم من الفعال",55,"ل",1,0],["بمرآة المحاسن صورته","واهدت كل من يهواه صوره",56,"ه",1,0],["بمرتضاك عليّ وابنه حسن","وبالحسين وبالزهراء فاطمة",57,"ه",1,0],["بمراكش سل عنه تعلَم غناءهُ","وقد ساءهُم يوم هناك عصيب",58,"ب",1,0],["بمرتسناتٍ بمثل الارا","قم جذبا تحارش آذانها",59,"ن",3,0],["بمرِّ الجديدين شعري جديد","له أول دونما آخر",60,"ر",1,0],["بمرور السنين يزددن حسنا","ثم يزدد