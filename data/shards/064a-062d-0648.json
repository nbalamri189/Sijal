مي","https://www.poetsgate.com/ViewPoem.aspx?id=16199",""],[4119,"الحق مبتهج والسيف مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=16222",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5277,"حبّها","https://www.poetsgate.com/ViewPoem.aspx?id=185615",""],[5376,"طار الفؤاد كأنَّ الطير ساكنه","https://www.poetsgate.com/ViewPoem.aspx?id=188319",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5533,"حُلْم","https://www.poetsgate.com/ViewPoem.aspx?id=176768",""],[5582,"دَعْهُ يَحِنُّ لِشَجْوِهِ وَشُجُونِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63583",""],[5739,"رسالة شاعر ...!","https://www.poetsgate.com/ViewPoem.aspx?id=127065",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5829,"حينا فحينا","https://www.poetsgate.com/ViewPoem.aspx?id=214903",""],[5944,"2020","https://www.poetsgate.com/ViewPoem.aspx?id=213794",""],[6127,"فداءٌ وإباء","https://www.poetsgate.com/ViewPoem.aspx?id=215939",""],[6259,"حكمُ المنيَّة في البريَّة جارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59422&r=&rc=70",""]],"verses":[["يَحورُ إِلَيها بِالبُغامِ فَتَنثَني","كَما اِلتَفَتَ المَطلوبُ يَخشى الأَعادِيا",0,"ي",2,0],["يَحوطُ الدَهرُ مُهجَتَهُ","وَتَكلؤُها مَقادِرُه",1,"ر",2,0],["يَحومُ عَلَيْها صَارِمِي وَغِرارُهُ","وَتَصْبو إِلَيْها صَعْدَتي وَسِنانُها",2,"ن",3,0],["يحوي رَغائِبَ مالِهِ وُرّاثُهُ","منْ بَعْدِهِ ويَبوءُ بالآثامِ",3,"م",1,0],["يَحوطُ حِماها غِلْمَةٌ أُمويّةٌ","بخَطّيَّةٍ مُلْسِ المُتونِ طِوالِ",4,"ل",1,0],["يَحوطُ أقاليمَ البِلادِ بكَفّهِ","يَراعٌ على أرْبابِهِنَّ احْتِكامُهُ",5,"م",2,0],["يَحوطُكَ مَن يَحوطُ ذِمارَ قَيسٍ","وَمَن وَسَطَ القَماقِمَ مِن تَميمِ",6,"م",1,0],["يحول الحول في الوصلِ","ويبقى لي تذكارُهْ",7,"ه",1,1],["يحوَلُّ أو يثوَلُّ من صُفرةٍ","حتى تراه عازبَ العقلِ",8,"ل",1,0],["يُحَوِّزُ عَشراً لا يَرى العَيشَ غَيرَها","مُشيحاً عَلَيها في المَراغِ وَحاظِلا",9,"ل",2,0],["يحور إليها بالبكاء فتنحني","عليه وتُسلى قلبه وتقبل",10,"ل",1,0],["يَحوطُكَ إِن خانَ الحُماةَ اِنتِباهُهُم","مَلائِكُ مِن عِندِ الإِلَهِ حُماةُ",11,"ه",1,0],["يَحولُ بَينَ الكَلبِ وَالتَأَمُّلِ","فَحَلَّ كَلّابي وَثاقَ الأَحبُلِ",12,"ل",1,0],["يحوزُ المُنَى من دونهِ كلُّ وادعٍ","ويُحرَمُ ما دونَ الرِضا وهو جاهدُ",13,"د",1,0],["يَحوي المُنى قبلَ بَذْلِ الوجهِ آمِلُه","إذا الملوكُ انثَنى باليأسِ رَاجِيها",14,"ي",3,0],["يَحوي له الأسَدُ البعيدُ نِجارَهُ","ويعوقُها عمَّا حَواه نجارُها",15,"ر",3,0],["يَحولُ عَلى المَرءِ حَتّى تَرا","هُ يَشرَبُ بَعدَ الصَفاءِ الكَدَر",16,"ر",1,0],["يَحولُ الفَتى كَالعودِ قَد كانَ مَرَّةً","لَهُ وَرَقٌ مُخضَرَّةٌ وَغُصونُ",17,"ن",1,0],["يَحُومُ عَلَيْهِ وَالْمَنَايَا مُسِفَّةٌ","وَيَدْرَأُ عَنْهُ فِي صُدُورِ اللَّهَادِمِ",18,"م",1,0],["يَحوي الكَريمُ المالَ لا يَبغي بِهِ","شَيئاً سِوى أُكرومَةٍ يَحويها",19,"ي",3,0],["يَحوزُ مِنها كُلَّ يَومٍ حَظّا","حَتّى تَرى نَجيعَها مُفتَظّا",20,"ظ",2,0],["يَحومُ عَلَيها العَنكَبوتُ بِنَسجِها","وَلَيسَ عَلى أَمثالِ تِلكَ يَحومُ",21,"م",1,0],["يَحوطُ ذِمارَها مِن كُلِّ خَطبٍ","وَيَمنَعُها مَصاعِبَ مُقرَماتِ",22,"ت",1,0],["يحول عنها العين ثم يعيدُها","حذار عدى تَغلي عليه حقودُها",23,"د",3,1],["يحول قَلبيَ دمعاً من حرارته","وَذلك الدمع من عينيَّ ينهمل",24,"ل",1,0],["يَحومُ عَلَيهِ عِقبانُ المَنايا","وَتَحجُلُ حَولَهُ غِربانُ بَينِ",25,"ن",1,0],["يَحُومُ علَيهَا الطَّيْرُ مِنْ كُلِّ جانِبٍ","وَيَسْرِي عَلَيْهَا الطّارِقُ الْمُتَأَوِّبُ",26,"ب",1,0],["يحوطُ حماكِ أبيضَ أَحْوَذيَاً","كما جرَدتِ من غمدٍ حُساما",27,"م",2,0],["يحوك لها البخار رداء ند","ويكسوها الحباب وشاح در",28,"ر",1,0],["يحوم على قتلي وغيرَ مُواربِ","وما فيه من آذيّة المتراكب",29,"ب",1,0],["يحومُ عليهِ وَ المنايا مسفة ٌ","وَ يدرأُ عنهُ في صدورِ اللهاذمِ",30,"م",1,0],["يَحوي النَباهَةَ مَن تَقَدَّمَ فَضلُهُ","لا مَن تَقَدَّمَ عَصرُهُ وَأَوانُهُ",31,"ن",2,0],["يحوطونه من كل سوء يناله","ويرعونه والله يرعاه من علو",32,"ل",2,0],["يحول ما بين الفتى ودينه","وينفث السم لمن خلا به",33,"ب",2,0],["يَحُومُ بها صادٍ يَرَى دُونَها الرّدَى","مُحيطاً فَيهوَى ورِدَها ويَهابُها",34,"ب",3,0],["يحول لها هذا وتقضى لغيره","فتأتي الذي تقضى له وهو آيس",35,"س",1,0],["يحومُ عليها الموتُ من كلِّ جانبٍ","وقد نطرَ الأرواح أقبلتَ حوّما",36,"م",2,0],["يحومُ عليك الروح في كل لحظة","كما ينظر الصادى إلى المشرع العذب",37,"ب",1,0],["يحوم عليه العاشقون وإنهم","لأمهر خلق اللَه في صنعة الصيد",38,"د",1,0],["يَحُوزُ مَنِ انْتَشَى مِنْهَا ثَنَاءٌ","وَيُوسَمُ مَنْ صَحَا مِنْهَا بِذَامِ",39,"م",1,0],["يَحوي لرحْبِ الباعِ طُولَ الساعِد","لَيس يَؤُودُهُ احتِمالُ الآيد",40,"د",1,0],["يحومون حولك والحتف دان","تقضقض من هوله الأضلع",41,"ع",1,0],["يَحوي بنصفيهِ ومهملهِ ومع","جَمِهِ منَ التاريخِ أيّ مصنّعِ",42,"ع",1,0],["يُحَوَّلُ عَن قَريبٍ مِن قُصورٍ","مُزَخرَفَةٍ إِلى بَيتِ التُرابِ",43,"ب",1,1],["يَحوزُها كَالعَزيزِ عَن عُرُضٍ","يَهُزُّ رَوقاً كَأَنَّهُ رُمُحُ",44,"ح",1,0],["يَحوي سُبِيّاً فَيُعطيها وَيَقسِمُها","وَمن عَطّيتِهِ الجُردُ السَراعيفُ",45,"ف",1,0],["يَحوم حَول السرب لَكنّه","لا يَعرف الظَبيَ مِن الأَرنَبِ",46,"ب",1,0],["يَحوزُ من الدّهرِ حُسْنَ الحديثِ","وكُلُّ جليلٍ سِواهُ جَلل",47,"ل",1,0],["يحولُ حجابُ العِزِّ دون لقائه","وإن كان لا يُعْيِي على طالبٍ رِفدا",48,"د",2,0],["يَحُولونَ دُونَ الصَّبر والحربُ خدعَةٌ","ولا سِيمَا حَربُ الحِسانِ النَّواعِمِ",49,"م",1,0],["يحوي بجسمٍ ذي هيولَى نَعتُهُ","طُهرُ الملائك ضمن عقلٍ مع فم",50,"م",1,0],["يحويه منها حشى قد جاء منحبساً","فيه وفي كفه الأكوان تنسحب",51,"ب",1,0],["يحوز كلٌّ من الأبرار أجمعهم","سعادةً نالها في قدر ما نصبا",52,"ب",2,1],["يَحول الهَوى بَينَ المُحب وَقَلبُهُ","وَتَفضحهُ الأَشواق مَهما تَسَترا",53,"ر",2,0],["يحوط الذمار ويخلي الديا","ر ويسبي ذراريهم والنسا",54,"ا",1,0],["يَحوز المَنايا وَالمنى مِنه أَنمِلٌ","طِوال القَنا تَزهى بِها وَقِصارُها",55,"ر",3,0],["يَحوي المَعالي كاسِباً أَو غالِباً","أَبداً يُدارى دونَها وَيُداري",56,"ر",2,0],["يحولُ نداك ما بين الرَّزايا","إذا هَطَلَتْ يداك به وبيني",57,"ن",2,0],["يحوك في كل معنى","يعز برداً قشيبا",58,"ب",2,0],["يحوب مُطري قوم وشعري","في مدحكم ذو الشهادتينِ",59,"ن",1,0],["يحوطُ جوانبي ويذبُّ عني ال","أذى ذبَّ الجفونِ عن النصالِ",60,"ل",1,0],["يحوطهما ما اسطاعَ وحفُ جناحهِ","شِعارُهما دون التراب ترائبُهْ",61,"ب",2,0],["يحوزونَ فخر الوغي والنَّدى","اذا أطلقوا مالهم والأعِنَّهْ",62,"ه",1,0],["يَحوزُ الأسْودانِ لهُ المَعالي","كثيفُ الجَيْش والسَّطْرُ الرَّقيم",63,"م",1,0],["يحوز له الفخريْنِ يومَ سَلامِهِ","ويومَ وَغاهُ نَجْدَةٌ ونَوالُ",64,"ل",1,0],["يحْوي مودَّتهُ من غير سابقةٍ","مَلْقىً وجيزٌ ويبني العهد تسليم",65,"م",1,0],["يحول سوادُ النِّقْس منها إذا جرت","إلى الأحمريْنِ عَسْجَدٍ ودِماءِ",66,"ا",2,0],["يَحوسُهُم أَهلُ اليَقينِ فَكُلُّهُم","يَلوذُ حِذارَ المَوتِ والمَوتُ كانِعُ",67,"ع",1,1],["يحوم كل فؤاد قبل مبعثه","حتى يحيى أمانيه ويحيها",68,"ي",3,0],["يَحومُ حَولَ غَرضٍ مَعلوم","وَمَقصَدٍ في شِعرِهِ مَفهومِ",69,"م",1,0],["يَحُوزُ السَّبْقَ في أَمْنٍ وخَوْفٍ","ويُكْرِمُ عِنْدَ فَقْرٍ أو غِناءِ",70,"ا",2,0],["يحوِي رجالاً لا يبالون الرّدى","إلّا ردىً في غير يومِ هياجِ",71,"ج",1,0],["يَحوزُ عَفوَكَ مَن سالَمتَ مُغتَبِطاً","وَلا يُقالُ لِمَن عادَيتَ ما فَعَلوا",72,"ل",3,0],["يَحُولُ الدَمعُ دُون الدَمعِ جرياً","فيُوشكُ أَن يُكفكِفَهُ الزِّحامُ",73,"م",1,0],["يحوُون بين جلوسه وركوبِهِ","شرفاً بِلَثْم بساطه وركابِهِ",74,"ب",2,0],["يَحُومُ تقبِيلي على ثغْرِه","ولم يَنلْ شيئاً سِوَى الحَوْم",75,"م",1,0],["يحومُ لثْمِي على مَرَاشِفِهِ","ويشْتهِي أَن يَعُوم في الرِّيقِ",76,"ق",1,0],["يحومُ مديحُ الناسِ حول نَدَاهُمُ","وحَوْلَ النَّدى حام المديحُ ودَنْدَنا",77,"ن",2,0],["يحوي الحسان محافل حفلت بها","فيها الجمال لواؤه معقود",78,"د",1,0],["يحوي اللآليء لمن قد غاص يطلبها","في لجه حيث يلفى ما كفى ووفى",79,"ف",2,0],["يحوي الجمان لمن يغوص وإنه","في القدر أنفس ما يباع ويشتري",80,"ر",2,0],["يحوي قصور الأتقياء تجل عن","وصف وهل قصر كتلك مشيد",81,"د",1,0],["يحوي الجهول المال لم ينصب فلا","يدري المغبة إن تمادى في الدعر",82,"ر",1,0],["يَحوي بأنمُلِهِ المَنايا والمُنَى","مِن راعِفاتِ رِماحِه ويَراعِه",83,"ع",2,0],["يحول الزمان وحق البلا","د ليس بفان ولا نافد",84,"د",1,0],["يَحوزُ فَصلَ خِطابٍ ضِمنه حكمٌ","مَعَ السّلاسَةِ لا التعقيدِ والقلقِ",85,"ق",1,0],["يَحوي الفَضائِلَ وَالفَواضِل كُلَّها","وَأَخو المَحاسنِ لِلمَحامِدِ يَجمَعُ",86,"ع",1,0],["يَحْوِي بحُسن سَوادِه","فَضْ