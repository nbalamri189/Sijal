{"poems":[[55,"شرف الخلافة يا بني العباس","https://www.aldiwan.net/poem30200.html","الكامل"],[65,"ومتيم زهرت بواقصة له","https://www.aldiwan.net/poem46148.html","الكامل"],[57,"عبث الحبيب وكان منه صدود","https://www.aldiwan.net/poem26371.html","الكامل"],[29,"ألا أيها القلب الطروب المكلف","https://www.aldiwan.net/poem5922.html","الطويل"],[23,"إذا تذكرت شجوا من أخي ثقة","https://www.aldiwan.net/poem21264.html","البسيط"],[23,"وكأن حافرها بكل خميلة","https://www.aldiwan.net/poem21524.html","الكامل"],[53,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[93,"وربت أمريكية خلت ودها","https://www.aldiwan.net/poem8794.html","عموديه"],[72,"أضنى الفؤاد فمن يريحه","https://www.aldiwan.net/poem42980.html","مجزوء الكامل"],[80,"تبدلت من عز ظل البنود","https://www.aldiwan.net/poem14213.html","المتقارب"],[87,"سما يناغي الشهبا","https://www.aldiwan.net/poem8091.html","مجزوء الرجز"],[45,"حتام نحن نساري النجم في الظلم","https://www.aldiwan.net/poem10575.html","البسيط"],[47,"أمنك تأوب الطيف الطروب","https://www.aldiwan.net/poem10650.html","الوافر"],[47,"لا الدهر مستنفذ ولا عجبه","https://www.aldiwan.net/poem10901.html","المنسرح"],[47,"لو كان يعتب هاجر في واصل","https://www.aldiwan.net/poem65544.html","الكامل"],[30,"طرقت نوار ودون مطرقها","https://www.aldiwan.net/poem5126.html","الكامل"],[30,"لئن خرمت عني المنايا محمدا","https://www.aldiwan.net/poem5503.html","الطويل"],[82,"من كان يعذب عندها تعذيبي","https://www.aldiwan.net/poem31542.html","الكامل"],[54,"الدار أعرفها ربى وربوعا","https://www.aldiwan.net/poem26866.html","الكامل"],[54,"قد حثني بالكأس أو في فجره","https://www.aldiwan.net/poem26999.html","الكامل"],[48,"تمنيت أني من هضاب يلملم","https://www.aldiwan.net/poem23362.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62220","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16661","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19689","الرجز"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[108,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[92,"الزهَاوي","https://www.poetsgate.com/ViewPoem.aspx?id=179155",""],[47,"لَوْ كَانَ يُعْتَبُ هاجرٌ في وَاصِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32196",""],[80,"تبدَّلتُ مِن عزِّ ظلِّ البُنودِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86666&r=&rc=8",""],[132,"سلام كريح المسك بل هو أطيب","https://www.aldiwan.net/poem50665.html","الطويل"],[159,"أرضى صبابته فلم لم ترضه","https://www.aldiwan.net/poem55646.html","البسيط"],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[203,"سلي بعدك الواشين هل ذاع لي سر","https://www.aldiwan.net/poem45584.html","الطويل"],[214,"يا رب عفواً فإني خائف وجل","https://www.aldiwan.net/poem13305.html","البسيط"],[234,"نعم المعين على الوغى في مأزق","https://www.aldiwan.net/poem50885.html","الكامل"],[264,"الحمد للإله هادي الناسك","https://www.aldiwan.net/poem35806.html","الرجز"],[347,"شباب العرب بوركتم شبابا","https://www.aldiwan.net/poem55363.html","الوافر"],[371,"أستودع الله في أظعانهم قمرا","https://www.aldiwan.net/poem17355.html","الوافر"],[443,"حججت باشر خلق الله كلهم","https://www.aldiwan.net/poem2513.html","البسيط"],[466,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[469,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[520,"يا دار عليك سعد المشتري","https://www.aldiwan.net/poem12135.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"رضى بقضاء الله فهو مصيب","https://www.aldiwan.net/poem3660.html","الطويل"],[580,"تركت حبيب القلب لا عن ملالة","https://www.aldiwan.net/poem2897.html","الطويل"],[580,"أضحى هلالاً بدر ذاك النادي","https://www.aldiwan.net/poem2962.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126845","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122817","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34408","البسيط"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137755",""],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70809","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46523","الرجز"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20003","الطويل"],[1489,"","https://poetry.dctabudhabi.ae/diwan/poem/177999","المجتث"],[1660,"","https://poetry.dctabudhabi.ae/diwan/poem/72162","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49565","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114772","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69402","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27729","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93647","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93666","البسيط"],[2449,"","https://poetry.dctabudhabi.ae/diwan/poem/115387","الطويل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147337","الكامل"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131896","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48454","المتقارب"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138713",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108294","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92062","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91244","المجتث"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131134",""],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18830","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33260","البسيط"],[4755,"مأساة سُهَيل اليَمَاني ( 1 )","https://www.poetsgate.com/ViewPoem.aspx?id=209084",""],[1901,"رويْدَكَ لا تُشمتْ بصاحِبكَ العِدَى","https://www.poetsgate.com/ViewPoem.aspx?id=160420",""],[5038,"حذار صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=189662",""],[5136,"ما بال نفسي كالفراش إذا رأت","https://www.poetsgate.com/ViewPoem.aspx?id=121490",""],[5183,"الخال","https://www.poetsgate.com/ViewPoem.aspx?id=186611",""],[5186,"ورد الربيع شذا من ربع غسان","https://www.poetsgate.com/ViewPoem.aspx?id=156440",""],[5277,"حواء..ولدتني شمساً..وأولدتُها قمرين","https://www.poetsgate.com/ViewPoem.aspx?id=192760",""],[5358,"قالوا نساك","https://www.poetsgate.com/ViewPoem.aspx?id=21900",""],[5582,"أَسْيانُ نارُ غَرامِهِ تَتَسَعَّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187103",""],[5628,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=178442",""],[5939,"جحود","https://www.poetsgate.com/ViewPoem.aspx?id=178579",""],[5956,"فانوسُ أبي و(جلّ)* الصَّبي","https://www.poetsgate.com/ViewPoem.aspx?id=184561",""]],"verses":[["وَكَأَنَّ حَملَ السَيفِ يَقطُرُ غَربُهُ","أَنسى يَمينَ يَدَيهِ حَملَ الكاسِ",0,"س",1,0],["وكأنّ حائِمَةَ النّسورِ إذا غَزا","تأوي منَ القَتْلى إِلى أعْشاشِ",1,"ش",1,0],["وَكَأَنَّ حُبَّ الناسِ عِندِيَ ساكِنٌ","وَكَأَنَّهُ بِجَوانِحي مَشدودُ",2,"د",1,0],["وَكانَ حَديثَ الرَكبِ غَدرُ مُجاشِعٍ","إِذا اِنحَدَروا مِن نَخلَتَينِ وَأَوجَفوا",3,"ف",3,0],["وَكانَ حِبَّ رَسولِ اللَهِ قَد عَلِموا","مِنَ البَرِيَّةِ لَم يَعدِل بِهِ رَجُلا",4,"ل",2,0],["وَكَأَنَّ حافِرَها بِكُلِّ خَميلَةٍ","صاعٌ يَكيلُ بِهِ صَحيحٌ مُعدِمُ",5,"م",1,1],["وكأَنَّ حُبْوته تُلاث بشامخ","يَنْحطُّ عنه الصخرُ في دَهْداه",6,"ه",1,0],["وَكانَ حَديثٌ خِلتُ أَنّي حَفِظتُهُ","فَأَذهَلَني عَنهُ الَّذي كانَ مِن بَعدُ",7,"د",1,0],["وَكَأَنَّ حاسِدَ مَجدِهِ","يَحويهِ مِن غَمٍّ ضَريحُه",8,"ح",2,0],["وَكانَ حَديدي سناناً ذَليقاً","وَعضبا دَقيقاً صَقيل الحَديد",9,"د",1,0],["وَكانَ حارِسُ الفَنا","رِ رَجُلاً مُهَذَّبا",10,"ب",2,0],["وَكانَ حالُهُما في الحُكمِ واحِدَةً","لَوِ اِحتَكَمنا مِنَ الدُنيا إِلى حَكَمِ",11,"م",1,0],["وَكانَ حَديثُها فيها غَريباً","فَصارَ قَديمُها حَقَّ الغَريبِ",12,"ب",1,0],["وَكانَ حَقّاً عَلَيَّ أَفعَلُهُ","إِذا تَأَبّى الصَديقُ أَجتَنِبُه",13,"ب",2,0],["وَكَأَنَّ حيطانَ الزُجاجِ بِجَوِّهِ","لُجَجٌ يَمُجنَ عَلى جُنوبِ سَواحِلِ",14,"ل",1,0],["وَكَأَنَّ حَيّاتٍ مُعَلَّقَةً","تَثني أَزِمَّتَها إِلى الصُفرِ",15,"ر",1,0],["وَكانَ حَياً لِلمُمحِلينَ وَعِصمَةً","إِذا السَنَةُ الشَهباءُ حَلَّ حَرامُها",16,"م",3,0],["وكأنّ حدّة طرفه وفؤادِه","من خَلْقِهِ في الأذنِ والعرقوبِ",17,"ب",1,0],["وَكَأَنَّ حَدَّ سِنانِهِ مِن عَزمِهِ","هَذا وَهَذا يَمضِيانِ جَميعا",18,"ع",2,0],["وَكَأَنَّ حُمرَةَ خَدِّهِ في لَونِها","وَكَأَنَّ طَيبَ رِياحِها مِن نَشرِه",19,"ر",2,0],["وَكانَ حُلولُ الروحِ في الجِسمِ نَكبَةً","عَلى خَيرِ مَعيا أَو عَلى شَرِّ مَعلَمِ",20,"م",1,0],["وكان حرب وضرب","وَغارة ودفاع",21,"ع",1,0],["وكَانَ حَيا بِالشَّامِ أَيْسَرُ صَوْبِهِ","وأَحْيَا حَيَا عَامَيْنِ فِي أَرضِ حمْيَرَا",22,"ر",2,0],["وكأنّ حُبّكِ قال حظُّكَ في السُّرَى","فالْطُمْ بأيدي العِيسِ وَجْهَ السَّبْسَب",23,"ب",1,0],["وكان حارس المنا","ر رجلا مهذبا",24,"ب",2,0],["وكانَ حرفاً شانُهُ السُّكونُ","فإنَّه عندي اسمُهُ مَخْبونُ",25,"ن",1,0],["وَكَأَنَّ حِسِّيَ حِسُّهُمْ فَرَحاً بِمَا","يَقْضِي الحِمَى مِنْ حَقِّهِمْ ويُوَالِي",26,"ل",2,0],["وكان حجيجُها وفدًا، فوفدًا","تضيقُ بهم -على سَعةٍ- «صَلاحُ»",27,"ح",1,0],["وكان حياةً للنفوس ورحمةً","تُغاثُ بها هذي النفوسُ الهوامد",28,"د",1,0],["وَكَأَنَّ حِيطَانَ الزُّجَاجِ بَجَوِّهِ","لُجَجٌ يَمْحُنَ عَلَى جُنُوبِ سَوَاحِل",29,"ل",1,0],["وَكانَ حَديدي سنانًا ذَليقًا","وَعَضْبًا رقيقًا صَقيل الحَديدِ",30,"د",1,0],["وكان حديراً أن نزور دياركم","على الراسِ نَسْعَى لا على الإبل نركَبُ",31,"ب",1,0],["وكأَنَّ حُمرةَ خَدِّهِ وعِذارِهِ","وردٌ تعلَّقَ بعضُه في بَعضِهِ",32,"ض",2,0],["وَكانَ حقّاً سالماً من نقدِ","وَلَو يصلِّي اللَّه ربّي واحده",33,"ه",1,0],["وكانَ حماماتُ اللواحظِ بيننا","تروحُ وتعدو والقلوبُ لها وكرُ",34,"ر",1,0],["وكان حصنا لهم طه البشير اذا","فرّ الجياد وكلّ الفرس البطل",35,"ل",1,0],["وكأن حافِرهُ إذا وطئ الحصى","شَدّاً يَخُطّ به حساب الجُمَّلِذ",36,"ل",2,0],["وكان حلّ كالهلال في الحرمْ","وكان للحطيم خير ملتزمْ",37,"م",1,0],["وكان حياته ليثاً هصورا","فأضحى بعد ميتته شهابا",38,"ب",2,0],["وَكانَ حَقُّكُمُ لَو كانَ لي قِبَلٌ","أَن يَنصُرَ السَيفُ لا أَن يَنصُرَ القَلَمُ",39,"م",1,0],["وكان حجك يا من لا خلاق له","خوف المعظم لا خوفا من الله",40,"ه",1,0],["وكان حِمى العافينَ في كل أزْمةٍ","اذا العامُ مُغْبرُّ المَطالعِ أقْتَمُ",41,"م",1,0],["وكأن حيالة الحسان بربعها","نظمت عقود الدر من حصبائها",42,"ا",3,0],["وكأن حسن بياضه وسواده","ليل تبسم عن صباح مسفر",43,"ر",1,0],["وكان حين مات طفلا فوصل","إليه قيل الأمر بعد واتصل",44,"ل",1,0],["وَكانَ حَياً في المَحلِ يَعلَمُ ضَيفُهُ","إِذا أَمَّهُ أَنَّ المَحَلَّ خَصيبُ",45,"ب",1,0],["وكان حَبِيبي سِلْكَ عقْدِ مَوَدَّتِي","فيا وَيْلَتَا وَاوَحْشَةَ العِقْدِ للسِّلْكِ",46,"ك",1,0],["وكأَنَّ حُمَّاه لشدَّة وقْدِها","أَلقَتْ عليه حَرارةَ الأَكْباد",47,"د",1,0],["وكانَ حبراً عالماً فضلا","مُحافظاً لنهجه المستقيم",48,"م",1,0],["وَكأَنَّ حُمرةَ وَجهِهِ وَجَناتُها","وَكَأنَّ رِقَّة لَفظِهِ خَدّاها",49,"ا",3,0],["وَكانَ حاليَ لا يَرضى بِيَوم جَفا","فَصارَ تَعديدُ هجراني بأَحوالِ",50,"ل",1,0],["وكان حديثهم أن تشاد ال","مساكن ذات أساس متينه",51,"ن",2,0],["وكان حَفِيّاً بالضيوف وغيرهِمْ","وكان له كلبٌ يهرُّ على البشرْ",52,"ر",1,0],["وَكانَ حُسادي بِها صنفين","كِلاهُما مُجتَهد في حيني",53,"ي",1,0],["وَكانَ حَمَيدٌ مَعقِلاً رَكَعَت بِهِ","قَواعِدٌ ما كانَت عَلى الضَيمِ تَركَعُ",54,"ع",1,0],["وكان حظّي منه","خمول ذكرٍ وياس",55,"س",1,0],["وَكانَ حَبيبُ النَّفْسِ للقَلْبِ وَاتراً","وكيْف يُحِبُّ القَلْبُ مَنْ هُوَ وَاتِرُهْ",56,"ر",2,0],["وكان حراماً أن تجودَ بدمعةٍ","وقد تركتْها الحادثاتُ بلا شَفر",57,"ر",1,0],["وكانَ حديثاً للوفدِ مُعَرّفا","فأصبحَ وحشَ المُنتدى يُتَجَنَّبُ",58,"ب",1,0],["وَكَأَنَّ حاجِبَها حَنِيَّةُ ثائِرٍ","بِأَخِيهِ فَوَّقَ سَهمَهُ وَرَماني",59,"ن",2,0],["وكان حقاً بلا خلافٍ","في بطنه دائماً وظهره",60,"ر",2,0],["وَكان حَقاً إِذا ما قالَ قائلهم","مَجدي أَخيراً وَمَجدي أولا شرع",61,"ع",1,0],["وَكانَ حَظ الَّذي باراك مِنسفه","عَض الأَباهم مِما نالَ وَالأَسَف",62,"ف",1,0],["وكان حسين لافاء لفضله","وجد أبي كان الرئيس المشيعا",63,"ع",2,0],["وَكَأنَّ حُورَ اللهِ فِي آيَاتِهِ","مِن وَرْدِ قَلبِكِ كَان رَبِّي يَخْلقُ!",64,"ق",1,0],["وكان حصول السير من أرض جدة","بسبع مع العشرين من شهر آمل",65,"ل",1,0],["وكان حُساماً لحَرْبِ العِدَى","ففلَّتْ أكُفُّ الرّدَى غرْبَهُ",66,"ب",2,0],["وكأن حرات الهدى","منها به انتهكت مح