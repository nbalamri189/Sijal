{"poems":[[57,"توافق معشوقان من غير موعد","https://www.aldiwan.net/poem26426.html","الطويل"],[79,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[79,"أصابتك يا عين عين الحسد","https://www.aldiwan.net/poem36551.html","المتقارب"],[73,"وكلت الكندي مولاتنا","https://www.aldiwan.net/poem3772.html","السريع"],[73,"مثلي وقد وافيت أطلب رفدكم","https://www.aldiwan.net/poem3909.html","الكامل"],[95,"علام يقام تمثالي","https://www.aldiwan.net/poem9164.html","مجزوء الوافر"],[23,"قد تعفى بعدنا عاذب","https://www.aldiwan.net/poem21403.html","المديد"],[74,"سبحان من وكل بي مشفعا","https://www.aldiwan.net/poem19583.html","السريع"],[53,"نفرٌ من الخلطاءِ والأصحابِ","https://www.aldiwan.net/poem8329.html","الكامل"],[53,"حبذا حشمة الصديق إذا ما","https://www.aldiwan.net/poem65492.html","البسيط"],[53,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[30,"وأضياف ليل قد نقلنا قراهم","https://www.aldiwan.net/poem5339.html","البسيط"],[50,"قد عذب الحب هذا القلب ما صلحا","https://www.aldiwan.net/poem62533.html","البسيط"],[52,"آب ليلي ليت ليلي لم يأب","https://www.aldiwan.net/poem64814.html","الرمل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62206","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/29858","الطويل"],[108,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[102,"أصيل القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50335",""],[135,"أرث جديد الحبل من أم معبد","https://www.aldiwan.net/poem24162.html","الطويل"],[154,"حمل الفؤاد على الهوى وتحملا","https://www.aldiwan.net/poem68463.html","الكامل"],[164,"من عوض الصبر عما فاته ربحا","https://www.aldiwan.net/poem58909.html","البسيط"],[173,"بع واسطاً بالنأي والهجر","https://www.aldiwan.net/poem1629.html",""],[190,"وكلت الحسود إلى خالقه","https://www.aldiwan.net/poem43547.html","المتقارب"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[203,"مشى الجهل في طين ولكن","https://www.aldiwan.net/poem45401.html","الوافر"],[213,"غار مثل النجم من خلف البحور","https://www.aldiwan.net/poem26480.html","عموديه"],[236,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[264,"عرائس حسن بالجمال تجلت","https://www.aldiwan.net/poem35563.html","الطويل"],[264,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[285,"بنفسي على قربه النازح","https://www.aldiwan.net/poem60778.html","المتقارب"],[310,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[353,"مولاي شمس الدين يا من ضوؤه","https://www.aldiwan.net/poem20169.html","الكامل"],[369,"أساير ركب الجو وهو كواكب","https://www.aldiwan.net/poem60997.html","الطويل"],[371,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[376,"معي كلمات ما يطاق احتمالها","https://www.aldiwan.net/poem57213.html","الكامل"],[396,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[422,"عفت المنازل رقة ونحولا","https://www.aldiwan.net/poem54062.html","الكامل"],[438,"فهمت على البارق الممطر","https://www.aldiwan.net/poem12626.html","المتقارب"],[443,"خذ من قياد الدهر خير زمام","https://www.aldiwan.net/poem2495.html","الكامل"],[443,"عقت دارها إلا ثلاثا بها سحما","https://www.aldiwan.net/poem2592.html","الطويل"],[447,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[558,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[563,"ولعت بذاك الحي والمورد الحلو","https://www.aldiwan.net/poem33533.html","الطويل"],[563,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[563,"رويدك أيها البرق اللموع","https://www.aldiwan.net/poem34391.html","الوافر"],[563,"لو خلق الله وجودا للورى","https://www.aldiwan.net/poem34491.html","الرجز"],[622,"","https://poetry.dctabudhabi.ae/diwan/poem/130717","الوافر"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143291","الوافر"],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206071","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48680","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48826","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38943","الوافر"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96356","الكامل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17584","الخفيف"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203659","الطويل"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124166","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53215","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104982","السريع"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124777","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93701","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137372",""],[2758,"","https://poetry.dctabudhabi.ae/diwan/poem/31508","الطويل"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131026",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102965","الوافر"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35492","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76441","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78221","الوافر"],[4129,"","https://poetry.dctabudhabi.ae/diwan/poem/205347","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81717","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33206","الكامل"],[1663,"الى امرئ نصبت قحطان رايتها","https://www.poetsgate.com/ViewPoem.aspx?id=93229",""],[4961,"النصفُ الثاني للإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=33329",""],[3591,"أناني منديل الحبيبة مرسلا","https://www.poetsgate.com/ViewPoem.aspx?id=149399",""],[3591,"تقرب كل للكريم أخي الجدا","https://www.poetsgate.com/ViewPoem.aspx?id=149402",""],[5125,"مساجلة حب","https://www.poetsgate.com/ViewPoem.aspx?id=188623",""],[5397,"سموت أبا السجاد صيد الورى فخرا","https://www.poetsgate.com/ViewPoem.aspx?id=157916",""],[5550,"يحبُّ الحرُّ","https://www.poetsgate.com/ViewPoem.aspx?id=211130",""],[5582,"أَلا هَلْ تَوَلَّتْ نَوارٌ نَوارا","https://www.poetsgate.com/ViewPoem.aspx?id=186999",""],[5677,"ميثاق غلا ...!","https://www.poetsgate.com/ViewPoem.aspx?id=179806",""],[5842,"تَقَبَّحَ قومٌ بالجهالة أُولِعوا .. !","https://www.poetsgate.com/ViewPoem.aspx?id=176656",""]],"verses":[["وَكَلَّت جُفونُ العَين عَن حَملِ مائِها","فَما مَلَكَت فَيضَ الدُموعِ السَوافِحِ",0,"ح",1,0],["وَكَلْتُ بِهَا هَمِّي وَأَغْرَيْتُ هِمَّتِي","فَسَاعَدَهَا هَاءُ الرَّويِّ وَمِيمُهُ",1,"م",2,0],["وُكِلت لكُلِّ شَهيرٍ خَطيرٍ","فقُمْتَ بهِ وسَدَدْتَ المَسَدْ",2,"د",1,0],["وَكَّلتِ الكِندِيَّ مَولاتُنا","فَضَلَّتِ القَصدَ وَساءَت سَبيل",3,"ل",1,1],["وَكَّلتَ بي صَعبَ المِراسِ مُلازِماً","كَالظِلِّ يَتبَعُني بِكُلِّ مَكانِ",4,"ن",1,0],["وكلتم بي أخاً براً","صناعاً غير مكسال",5,"ل",1,0],["وَكَّلَت قَلبي بِذِكرَتِها","فَالهَوى لي فادِحٌ غالِبُ",6,"ب",1,0],["وكَّلته في كلّ ما أرتجي","وحسبيَ الله ونعمَ الوكيل",7,"ل",1,0],["وكَّلْتُمُ زُحَلاً بأمري وحدَهَ","وكذاك حقُّ الجاهل الخَيّابِ",8,"ب",1,0],["وكلت حاجتي إليك فأضحت","وهي مني بموضع العَيّوق",9,"ق",1,0],["وكّلتُ مجدَك باقتضائك حاجتي","وكفى به متقاضياً ووكيلا",10,"ل",2,0],["وَكِلتاهُما فينا إِلى حَيثُ تَلتَقي","عَصائِبُ لاقى بَينَهُنَّ المُعَرَّفُ",11,"ف",1,0],["وَكَلتَ بِالدَهرِ عَيناً غَيرَ غافِلَةٍ","مِن جودِ كَفِّكَ تَأسو كُلَّما جُرِحا",12,"ح",2,0],["وَكَلَت بي جارَتي أَسهودَةً","شَرَّ ما وُكِّلَ بِالجارِ الجُنُب",13,"ب",1,0],["وكل تغريد الهوى والشباب","أغنيّةٌ حامت على مبسمك",14,"ك",1,0],["وكِلْتَاهُمَا قَدْ خُطَّ لي في صَحِيفتي","فَلَلعَيشُ أَشْهَى لي وللْمَوْتُ أرْوَحُ",15,"ح",1,0],["وَكِلْتاهُما حَيثُ الصَّبابَةُ بَرّحَتْ","بِقَلْبٍ إِذا ما اعْتادَهُ الشَّوْقُ يَخْفُقُ",16,"ق",1,0],["وكل تِيه من الحسناء مُحْتَمَلٌ","وكل ذنب جَنتْه كان مغفورا",17,"ر",2,0],["وكلّت رياح ،وجنّت رياح","ونجم تأنّى ، ونجم طفر",18,"ر",1,0],["وَكُلَّ تَباريحِ المُحِبِّ لَقيتَهُ","سِوى أَنَّني لَم أَلقَ حَتفي بِمَرصَدِ",19,"د",1,0],["وكُلت بالأعداء قلباً لم يزل","مستسلماً في أمره متوكلا",20,"ل",2,0],["وكلتُموني إلى خلِّ فضيّعني","حفظاً لكم وهو جدٌّ يشبهُ المِزحا",21,"ح",2,0],["وكَّلت عُثماناً فَوافَقني","فيها وَتابَعَهُ أَبو بَكرِ",22,"ر",1,0],["وكلتُ الحسود إلى خالقه","وقلّدته البغي في عاتقه",23,"ق",2,1],["وَكِلتاهُما فازَت بفضلِ جِهادها","وَليسَت بهِ مِن هذهِ هذهِ أحرى",24,"ر",2,0],["وكلُّ تطرفِ العلماءِ جهلٌ","وبعضُ الجهلِ بالعلماءِ يودي",25,"د",2,0],["وكلت صم الجلاميد به","بعد ما هذه تكرار العصور",26,"ر",1,0],["وكلتا يديه جلّ عن مشبه له","يمين إلى خير البرية يرفع",27,"ع",1,0],["وكلتا يدي ربّي يمينٌ وإنّما","شمال ضلال الحجب عين القطيعة",28,"ه",1,0],["وكلّ تابعٍ لهم السير","وجامعٍ بهم صنوفَ الخير",29,"ر",1,0],["وَكُلُّ تَمادٍ إِلى غايَةٍ","وَإِنْ جَرَّ أَرْسانَهُ الْجامِحُ",30,"ح",1,0],["وكلت إليك فلو هممت بدفعها","شفعت لها الخضراء والغبراءُ",31,"ا",2,0],["وَكَّلْتُ عَيني بِالطَّرِيقِ لِمَوْعِدٍ","قَدَّمْتُهُ لازِلْتَ تُنَجِزُ مَوْعِدا",32,"د",2,0],["وَكلْتُ بهنَّ الفكْرَ حتى تَهذَّبتْ","على النّقدِ إلا ما تَعلّلَ جادِب",33,"ب",1,0],["وَكَّلتُمُ السَعدَ يا أَبناءَهُ لَكُمُ","فَلَن يُضيعَ حُقوقاً أَصلُها النَسَبُ",34,"ب",1,0],["وكِلتاهُما نارٌ تُشَبُّ وإنَّني","لأَعرِفُ أخرَى لا يَبينُ اشتِعالُها",35,"ل",3,0],["وكل تارك لها","فيه أتت هائلات",36,"ت",1,0],["وكَّلْت بالدّنف الضنى لك شاهداً","وكفى بذلك شاهداً ووكيلا",37,"ل",2,0],["وكلتا يديك هما الغايتان","على المُفتري أو على المُقْترِ",38,"ر",1,0],["وكلت طرفك بالحوادث جاهدا","تأسو بجود يديك كل كلام",39,"م",1,0],["وكلّ تراه نجل جون موقّع","أزبّ وتلقى لي أياما جدا قرما",40,"م",2,0],["وكل تقية فلها محل","وعين اللَه ناظرة تراها",41,"ا",3,0],["وَكَّلتَ نَفسَكَ بِالمَحامِدِ وَالعُلى","فَجَعَلتَها لَكَ دَهرَها أَشغالا",42,"ل",2,0],["وكلتُ إليه الأمرَ في كل ساعة","وجئت بلا سعي إليه ولا عدو",43,"و",1,0],["وكلتُ أموري يا وكيل إليك يا","قوي فكن عني الأعادي مقاويا",44,"ي",2,0],["وكل تجنب عنك التفات","إليك وكل إقبالٍ رجوع",45,"ع",1,0],["وكل تقدير بلا مقدر","هو المحال المحض في عقل الورى",46,"ر",2,0],["وكلتُ جميع آمالي إليهِ","وواليتُ النداءَ لخيرِ والِ",47,"ل",1,0],["وكل تعجبي طول الليالي","لذلة ماجد يسعى لوغد",48,"د",1,0],["وكل تراثالمجد أورثني أبي","إذا ذكر الغالي من الحسب الجزل",49,"ل",1,0],["وكلت بالأحكام أكرم حوله","متعاونون على الصلاح أكارم",50,"م",1,0],["وكل تقاض واحتكام موفقٌ","إذا لم يعالج بالضغينة والذم",51,"م",1,0],["وَكلٌّ تَحتَ أَمرِكَ ذو وقوفٍ","يُريدونَ الرّضاءَ وَيَطلُبونا",52,"ن",2,0],["وَكَلت فقلت لها النَّجاءَ تناولي","بي حاجَتي وتنكَّبي هَمدانا",53,"ن",2,0],["وَكَّلَتني الأَيّامُ فيك إِلى نَف","سي فَأَعيَيتُ وَاِنتَهى مَجهودِي",54,"د",2,0],["وكلتاهما قد جَرَّدتْ من نظامها","موشحةً كالسيف راق فرندُه",55,"د",2,0],["وكلتَ جفني بالسُّهادِ صبابةً","ورقدتَ عن ليل الكئيب الساهر",56,"ر",1,0],["وكَلْتُمُ بالرعايا عين عدلكم","حتى جفت وتناست لذَّةَ الوسن",57,"ن",1,0],["وكلت طرفي بنجوم الدجى","فحسبي الله ونعم الوكيل",58,"ل",1,0],["وكلتا يديك أرفع لرؤية كعبة","معظمة عليا وكبر ومجد",59,"د",1,0],["وَكُل تاج يَزين العلم رَونَقه","أَو لا فَإن دراريه تُرى فَحَما",60,"م",2,0],["وكلت بى الضنى فأسلمت روحي","في يديه ولم أجد لي مفرا",61,"ر",2,0],["وَكِلتاهُما مِمّا عَدا قَبلُ أَهلُها","عَلى خَيرِ ما ساقوا وَرَدّوا لِمَزحَلِ",62,"ل",1,0],["وَكُلّ تلٍّ كانَ في قُرب البَلَد","ساواهُ إِذ فازَ بأحسنِ الرشَد",63,"د",1,0],["وكلتاهما حسناء صاف اديمها","ولا غرو فالأمُّ الجميلة تنجب",64,"ب",1,0],["وكل تنعم عقباه بؤس","وهل نار تكون بلا رماد",65,"د",1,0],["وَكّلتَ فِكركَ بِالأُمورِ مراعِيا","وَأَقمتَ مِنهُ عَلى القُلوب رَقيبا",66,"ب",2,0],["وَكلتا يديها في اِنبساط مذلة","وَمقلتها في الافق لا تتحول",67,"ل",1,0],["وكُلٌّ تُجَاهَ ذَوِيهِ انَقَلَب","وَبَينَ الطَّرَاوِدِ فَاضَ الطَّرَب",68,"ب",1,0],["وَكل تَجلدي بِالصَبر لما","أَباحَت في الهَوى عَرضي وَديني",69,"ن",2,0],["وكلّ تهنّأ إقباله","ولا كإياب الأمير الهمام",70,"م",1,0],["وكلت إلى رأْدِ الضحى إقرابها","ولرمي أحداق العدا إعراكها",71,"ك",3,0],["وكَّلْتَ بالدهرِ عيناً غير غافلةٍ","من جودِ كفّك تأسو كل من كُلِما",72,"م",2,0],["وكلته بمدللٍ","فرماه في وضح السوادِ",73,"د",1,0],["وكل تلعاء تعلو كف ملجمها","ومخطف خطوه دفق وتكديس",74,"س",1,0],["وكلُّ تلاوةٍ مِِنْ فيكِ سالتْ","زلالاً يُسكِرُ الألحانَ لحنا",75,"ن",2,0],["وكلت إلى أنفي انتشاء عبيره","لعلي أرى فيه من الطيب مندلا",76,"ل",2,0],["وكل تمنى أن ينال رضاءَهُ","ويجعل روحاً لو أصيب له فدى",77,"د",2,0],["وكِلتا. يَدي َّ بيضاءٌ وسُوئِي","تسرّب مِنْ مُلامسةِ انتِشاكَا",78,"ك",2,0],["وكلتاهما طوع بكفيك لم تزل","على الخلق تجري فيهما النهي والأمرا",79,"ر",2,0],["وكلُّ تجمّعٍ بالصدْق يغدو","بهيًّا واضحًا جمَّ السعود",80,"د",1,0],["وَكِلْتاهُما صارَتا فِي زِنا","دِ نارِ الوَغَى لِلأَعادِي عَفارا",81,"ر",2,0],["وِكِّلْت ولفك ياوليفي وشِرِّبْت","كنه على ولفك وليفي وصايه",82,"ا",3,0],["وكلّ تبنى من هواه شريعةً","وجانبَ ذِكراً فوحه يتضوّعُ",83,"ع",1,0]]}