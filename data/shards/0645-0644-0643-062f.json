{"poems":[[75,"ما طول عذلك للمحب بنافع","https://www.aldiwan.net/poem11925.html","الكامل"],[133,"أنامل النسيان مري على","https://www.aldiwan.net/poem67432.html","السريع"],[469,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[572,"عادات طيفك أن يعاود","https://www.aldiwan.net/poem69711.html","مجزوء الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53030","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137051",""],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48367","الخفيف"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66577","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72803","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52156","الخفيف"],[4679,"أية عيد الجلوس يا خير عيد","https://www.poetsgate.com/ViewPoem.aspx?id=142750",""]],"verses":[["مَلِكٌ دَرى أَنَّ المَساعِيَ سُمعَةٌ","فَسَعى فَطابَ حَديثُهُ لِلسامِعِ",0,"ع",1,0],["مَلكٌ دونَ مَقدَرة","مُلكهُ ضِمنَ مَقبَرة",1,"ه",1,0],["ملكٌ دينهُ السماح فما ينفكُّ","منهُ ما بين وترٍ وشفع",2,"ع",1,0],["مَلَكٌ درارِيُّ النُّجو","مِ لبيتِ سُؤْدَدِهِ قَوَاعِدْ",3,"د",1,0],["ملك دوخ الجبابرة الصيد بع","زّ ما شَانَه كبرياء",4,"ا",2,0],["ملك دونه الملوك علواً","ومضاءً في كل خطب شديد",5,"د",1,0],["ملكٌ دامَ حمْدُهُ","كُلَّ ملْكٍ يُشَرّفُ",6,"ف",1,0],["مَلِكٌ دِينُهُ الوَفاءُ إِذْا دَا","نَ مُلُوكُ الدُّنْيَا بِنُكْثٍ وَغَدْرِ",7,"ر",1,0],["ملكٌ دأبه أغانة عان","ونوالٌ ما بين عربٍ وعجمِ",8,"م",1,0],["ملِكٌ دولتاه مالٌ وعلمٌ","قامتا في الورى على عَزَماته",9,"ت",2,0],["ملك دونه الملوك علاءً","ومضاءً في كل خطبٍ شديدِ",10,"د",1,0]]}