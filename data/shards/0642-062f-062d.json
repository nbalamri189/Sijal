ae/diwan/poem/85423","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85411","المتدارك"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85376","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54233","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54280","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54252","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[106,"إلى القائد المظفر","https://www.poetsgate.com/ViewPoem.aspx?id=179595",""],[106,"من للموظف","https://www.poetsgate.com/ViewPoem.aspx?id=179515",""],[106,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[77,"أمن جانب الغربي نفحة بارح","https://www.poetsgate.com/ViewPoem.aspx?id=33654",""],[77,"أنت فظٌّ والعطف","https://www.poetsgate.com/ViewPoem.aspx?id=33265",""],[45,"بَرْقٌ أضَاءَ العَقيقُ منْ ضَرَمهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32046",""],[51,"قد حال لموعد المأمولِ حولانِ","https://www.poetsgate.com/ViewPoem.aspx?id=30607",""],[51,"قد حَلفنَا على الصفاء جميعاً","https://www.poetsgate.com/ViewPoem.aspx?id=29909",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""]],"verses":[["قَد حَرَمَ الناظِرَ مِن حُسنِها","قائِلُها ما رَزَقَ الأُذنا",0,"ن",2,0],["قَدَحَت زَفيري فَاِعتَصَرتُ مَدامِعي","لَو لَم يَؤُل جَزَعي إِلى السُلوانِ",1,"ن",1,0],["قَد حَشَدَ الدَهرُ عَلَيَّ كَيدَهُ","وَجاءَتِ الأَيّامُ بِالزَلازِلِ",2,"ل",1,0],["قَدحُ لِحاظٍ كَمُطاراتِ الشَرَر","يُلهِبُ في إِزارِهِ إِذا نَظَر",3,"ر",1,0],["قَد حَلَبَ الدَهرَ أَفاويقَهُ","وَأَتبَعَ الشارِدَ بِالطارِدِ",4,"د",1,0],["قَدْ حَلَّ حُبُّكَ مِنْ قَلْبِي بِمَنْزِلهٍ","لاَ الْمَاءُ يَجْرِي مَجَارِيهَا وَلاَ اللَّبَنُ",5,"ن",1,0],["قدَحَتْ زنادُ الشّوْقِ نارَ شُجونِهِ","وإذا قدَحْتُ الزّنْدَ طارَ شَرارُهُ",6,"ر",2,0],["قدْ حلّ في جبَلٍ للفَتْحِ مُنْتَسِبٍ","بالفَتْحِ مفْتَخِرٍ بالفتْحِ موْعودِ",7,"د",1,0],["قَدَحَتْ بِها زَنْدَ الغَرامِ وإنّما","تجافَيْتُ في دينِ السّلوِّ لِقادِحِ",8,"ح",1,0],["قَد حَمَّلوهُ فَتِيَّ السِنِّ ما حَمَلَت","ساداتُهُم فَأَطاقَ الحِملَ وَاِضطَلَعا",9,"ع",2,0],["قَد حارَتِ الأَفهامُ في أَمرِهِم","إِن لَمَّحوا بِالقَصدِ أَو صَرَّحوا",10,"ح",3,0],["قَد حَرَّموا الرِقَّ وَلَكِنَّهُم","ما حَرَّموا رِقَّ الهَوى عِندَكا",11,"ك",2,0],["قَدْ حَلَّ مِنْ أَغْلَى مَكَا","نٍ فِي ذُرَى أَعْلَى مَكَانِ",12,"ن",1,0],["قد حكى كومة من اللؤلؤ الرَط","ب وإن كان فائقاً أثمانه",13,"ن",2,0],["قد حار فيه الترب المعسر","إذ لم يجد فيه له مرفقاً",14,"ق",2,0],["قد حِرت في الأمر أني حين أسخطهم","يرضَون عني وإن أرضيتهم سخطوا",15,"ط",3,0],["قد حكّموا الدين فيها فعي مُعربَة","عمّا يكون لدعوى القوم تكذيبا",16,"ب",2,0],["قد حاولوا الحق واشتطّوا بمطلبه","حتى بدا وجهه كالليل غِربيبا",16,"ب",2,0],["قد حكاها طولاً وشؤماً وبغياً","وتلظّى بحرّ نار المجوس",17,"س",1,0],["قَد حانَ قَبلَكَ أَقوامٌ فَقُلتُ لَهُم","جَدَّ النِضالُ وَقَلَّت بَينَنا العِذَرُ",18,"ر",1,0],["قَد حَذِرتُ المِلاحَ دَهراً وَلَكِن","ساقَني نَحوَ حُبِّهِ المِقدارُ",19,"ر",1,0],["قَد حانَ قَولُ قَصيدَةٍ مَشهورَةٍ","شَنعاءَ أَرصُدُها لِقَومٍ رُضَّعِ",20,"ع",1,1],["قد حرَّمت حالتي طيب الحياة بها","كأن طيبَ حياتي طيبُ إحرام",21,"م",1,0],["قد حمدَ القوم بهِ عقبى السفر","عند اقْتران القوس منهُ بالقمر",22,"ر",1,0],["قد حَدَثَتْ في دهرنا أنفُسٌ","تسْتبردُ السُّخْنةَ لا الباردَهْ",23,"د",2,0],["قد حلفنا على الصفاء جميعاً","فاجتهدنا وذاك جهد المطيقِ",24,"ق",1,1],["قد حمل الله بحُملانه","من حملته نحوه ساقه",25,"ق",2,0],["قد حاز ما في الشبابِ من أنقِ ال","حُسْنِ وما في المشيبِ من حُنَكهْ",26,"ك",2,0],["قدْحي فقيرٌ إلى رياشك مس","تغنٍ بما قد براه من سَفَنكِ",27,"ك",1,0],["قد حَتَمَ اللَّهُ أَنْ يبورَ أعا","ديهِ فأَنّى تردُّ ما حَتما",28,"م",2,0],["قد حال للموعد المأمولِ حولانِ","وقد تلا ذنيك الحولَيْن شهرانِ",29,"ن",1,1],["قَد حَمَلوا الهونَ غَيرَ ما سَأَمٍ","لَولا الهَوى لِلهَوانِ ما صَبَروا",30,"ر",3,0],["قَد حاوَلَ القَمَرُ المُنيرُ بِها","ما حاوَلَ الإيماُ في الكُفرِ",31,"ر",1,0],["قَد حانَ أَن تَستَيقِظوا فَاِستَيقِظوا","كَم تَخجَلونَ وَكُلُّهُم لا يَخجَلُ",32,"ل",1,0],["قَد حارَبَ الدينَ خَوفاً مِن زَواجِرِهِ","كَأَنَّ بَينَ الوَرى وَالدينِ عُدوانا",33,"ن",2,0],["قَد حانَ قِدحُ عِيالِ الحَيِّ إِذ شَبِعوا","وَآخَرٌ لِذَوي الجِيرانِ مَمنوحُ",34,"ح",1,0],["قَدْ حَجَّبَتْهُ غُيومُ","أَحزانِ الوُجُودِ القاتِمهْ",35,"ه",1,0],["قد حان ان ييقظ من","هذا الرقاد النوم",36,"م",1,0],["قد حرمت النفس من لذ","ذاتها وهي تريد",37,"د",1,1],["قد حكى فيصل المعظم الا","نطقه آمراً به والمقالا",38,"ل",2,0],["قد حال بين هضيمها وعظيمها","ما قد اقام الا فك من اسداد",39,"د",1,0],["قد حمدت الشباب اذ كان غضا","وذممت المشيب والاوجاعا",40,"ع",2,0],["قد حازها ولم يحز","ما حازه محاول",41,"ل",1,0],["قد حسنت في العين من","جنابه الشمائل",41,"ل",1,0],["قد حكيت الشمس حتى غضبت","من نحاس تجعل الصيف شتاء",42,"ا",2,0],["قَد حسّنَ المُلكَ المُعِزُّ وَغَدت","أَيامُهُ لِلدين وَالدُنيا حُلى",43,"ا",1,0],["قَد حَمَلَت إِحدى نِسا الأَرانِبِ","وَحَلَّ يَومُ وَضعِها في المَركَبِ",44,"ب",1,1],["قَد حِرنَ في بَشَرٍ في تاجِهِ قَمَرٌ","في دِرعِهِ أَسَدٌ تَدمى أَظافِرُهُ",45,"ر",2,0],["قد حوت خير عنصر","حجر ليس بالحجر",46,"ر",1,0],["قد حلّ فيها قوة","أضحت تقول وتسمع",47,"ع",1,0],["قِدحانِ قد نَبَتِ الحوادثُ عنهما","فالعودُ صُلْبٌ والغِرارُ سنينُ",48,"ن",1,0],["قَد حَطَطنا بِدَيرِ قُنّى وَما نَب","غي قِرىً غَيرَ أَن يَكونَ العُقارُ",49,"ر",1,0],["قَد حَطَطناكَ بَعضَ ماكانَ في الوَع","دِ لَنا واجِباً لِتُنجِزَ بَعضا",50,"ض",2,0],["قَد حَسَّنَ اللَهُ في عَينَيَّ ما صَنَعَت","حَتّى أَرى حَسَناً مالَيسَ بِالحَسَنِ",51,"ن",1,0],["قد حُلِّيَتْ بزَهرِها أشجارُها","وصُندِلَتْ بمَدِّها أنهارُها",52,"ر",3,0],["قَد حَمَلَ القَولَ فَبركاً بَرَكا","لا يَدخُلُ القَومَ عَلى ما شَكا",53,"ك",2,1],["قَدَحٌ دارَ في يَدي ذي احوِرارٍ","فَسَكِرنا بِالطَردِ وَالمَعكوسِ",54,"س",1,0],["قَد حارَبَ الصَبرَ وَالسَلوانَ بَعدَكُمُ","قَلبي وَصالِحَ طَرفي الدَمعُ وَالأَرَقُ",55,"ق",1,0],["قَد حَمَلَ الحِقدَ عَلى الأَطيارِ","فَهوَ إِذا اِنقَضَّ مِنَ الأَوتارِ",56,"ر",1,0],["قَدَحتَ فيهِ مِنَ الآراءِ نارَ وَغىً","فَأَحرَقَت فِئَةً في المُلكِ قَد قَدَحَت",57,"ت",1,0],["قَد حَمَلَ البَحرَ في سَفينَتِهِ","وَعادَةُ البَحرِ يَحمِلُ السُفُنا",58,"ن",2,0],["قَد حَمى رَبعُهُ الحُصون","فَهوَ لِلناسِ مُلتَجا",59,"ج",2,0],["قدحي ترنَّق فاسقني","قدح الشعاع مطهّر",60,"ر",1,0],["قدح يستحم فيه الضياء","لم تزل تسكب السلاف وللأقداح فيها تجدد وامتلاء",61,"ا",2,0],["قد حنت رأسي ولو كل القوى","تشتري عزة نفسي لم أبعها",62,"ه",2,0],["قد حازها البعدُ فَمِن دونها","ركوبُ طامٍ موجُهُ ذو سنام",63,"م",1,0],["قَدَحَ المَشيبُ بِمَفرِقَيهِ زِنادَا","لا يَستَطيعُ لِنارِهِ إِخمادَا",64,"د",2,1],["قَد حَلَّ في صَخرَةٍ صَمّاءَ مُعنِقَةٍ","فَاِنحِت بِرَأيِكَ في أَوعارِها دَرَجا",65,"ج",2,0],["قَدْ حَبَّبَ الْمَوْتَ كُرْهُ الضَّيْمِ فِي نَفَرٍ","لَوْلاهُمُ لَمْ تَدُمْ فِي الْعَالَمِ النِّعَمُ",66,"م",1,0],["قد حضرَ العقدَ الصحيحَ أحمدُ","ابنُ رسولِ وبذاكَ يَشْهَدُ",67,"د",1,0],["قد حثثناها مطايا صبوة","لكُمُ أوشك يعروها الكلال",68,"ل",1,0],["قَد حانَ مِنكِ فَلا تَبعُد بِكِ الدارُ","بَينٌ وَفي البَينِ لِلمَتبولِ إِضرارُ",69,"ر",1,1],["قَد حَلَفَت لَيلَةَ الصَورَينِ جاهِدَةً","وَما عَلى المَرءِ إِلّا الحَلفُ مُجتَهِدا",70,"د",2,0],["قَدَحَت يَدُ الهَيجاءِ مِنهُ بارِقاً","مُتَلَهِّباً يُزجي القَتامَ سَحابا",71,"ب",2,0],["قَدَحَ الرَكضُ زَندَهُ فَاِستَطارَت","في دُخانِ العَجاجِ مِنهُ شَرارَه",72,"ر",2,0],["قَد حالَ مِن دونِ لَيلى مَعشَرٌ قَزَمٌ","وَهُم عَلى ذاكَ مِن دوني مَواليها",73,"ه",2,1],["قَدَحَت لَواحِظُكَ الهَوى في خاطِري","حَقّاً لَقَد وَرِيَت زِنادُ القادِحِ",74,"ح",1,0],["قَد حَمَتها أَشواكُها مَشرعاتٍ","حَولَها دونَ عابث أَو غَصوبِ",75,"ب",1,0],["قَد حُمِّلا مِثلَ الَّذي حُمِّلَت","نَفسي مِنض الوَجدِ وَأَهوانا",76,"ن",2,0],["قَد حَوَتهُ وَأَغلَقتُ دُونَ وُدِّي","فَهوَ في سِجنِها عَنِ الناسِ قُفلا",77,"ل",2,0],["قَدَحتُ زِنادَ الوَصلِ بَيني وَبَينَهُم","فَأَذكَيتُ ناراً غَيرَ ذاتِ شُعاعِ",78,"ع",1,0],["قَد حَثَّني بِالكَأسِ أَو في فَجرِهِ","ساقٍ عَلامَةُ دينِهِ في خَصرِه",79,"ر",2,1],["قَد حَما غُصنَ النَقا أُسُدُه","ريقُهُ عَذبٌ وَمَن يَرِدُه",80,"د",2,1],["قَد حَثَّني بِكُؤوسِها ذو غُنَّةٍ","صامَت لَهُ صَومَ المَلامِ وَصَلَّتِ",81,"ت",1,0],["قَد حَذاها الدَهرُ جِلدَتَهُ","وَكَساها اللَيلُ أَثوابا",82,"ب",2,0],["قد حاكمتْهُ ملوكُ الرّوم في لَجِبٍ","وكانَ للّهِ حكمٌ غيرُ مردود",83,"د",1,0],["قَد حَكى البَدرُ بَهاكا","فَرَآهُ مَن رَآكا",84,"ك",2,1],["قَد حَلَّ سَهواً أَو عامِداً أَحَدَ ال","زَرَّينِ لَمّا اِستَفَزَّهُ السَأَمُ",85,"م",1,0],["قَد حُمَّ مَن أَنا أَحميهِ فَأَفقَدَهُ","وَرداً بِوَجنَتِهِ وِردٌ لِحُمّاهُ",86,"ا",2,1],["قَد حَصحَصَ الحَقُّ وَاِنجابَت دُجُنَّتُهُ","وَعَرَّضَ الدَهرُ شَطرَيهِ لِمَن حَلَبا",87,"ب",2,0],["قَد حُجِبَ النورُ وَالضِياءُ","وَإِنَّما دينُنا رِياءُ",88,"ي",3,1],["قَدَحنَ زِنادَ شَوقٍ مِن زُنودٍ","بِنارِ حُلِيِّها مُتَوَقِّداتُ",89,"ت",1,0],["قَد حاطَتِ الزَوجَ حُرَّةٌ سَأَلَت","مَليكَها العَونَ في حِياطَتِها",90,"ت",3,1],["قَد حارَ آدَمُ في القَضاءِ وَآلُهُ","أَفَلِلمَلائِكِ في السَماءِ تَحَيُّرُ",91,"ر",1,0],["قَد حَمَلنا مِن رَزايا","دَهرِنا عِبأً ثَقيلا",92,"ل",2,0],["قَد حَدَّثَت سِرَّكَ طِلابَهُ","عَينٌ بِما في الصَدرِ نَمّامَه",93,"م",2,0],["قَد حاوَلَ الناسُ رِزقَ اللَهِ فَاِبتَكَروا","مُجاهِدينَ بِأَرقاحٍ وَأَقلامِ",94,"م",1,0],["قَد حَلَّأَت ناقَتي بُردٌ وَراكِبَها","عَن ماءِ بَصوَةَ يَوماً وَهوَ مَجهورُ",95,"ر",1,0],["قَدَحت لِلشّوْقِ ناراً","عَيْنُهُ في كَبدِهْ",96,"د",2,0],["قد حف ليلي الغمامُ","واشتد فيه الظلامُ",97,"م",1,0],["قَد حَلَلنا طيف النجوم عَلى بع","دٍ بعيد بآلة صماء",98,"ا",2,0],["قدحت في السماء بالزند فابيض","ضت من النار فحمة الظلماء",98,"ا",2,0],["قد حازَ القَوم بحومتها","ظفراً لا يشبهه ظفر",99,"ر",1,0],["قد حدَّدوه ل