{"poems":[[58,"يا طلعة طلع الحمام عليها","https://www.aldiwan.net/poem58454.html","الكامل"],[99,"ليالي الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=17271",""],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80192","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132722","البسيط"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35875","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48309","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91435","الكامل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199100","البسيط"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78310","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120413","الكامل"],[4929,"عروبة الزمن الأجنبي","https://www.poetsgate.com/ViewPoem.aspx?id=215675",""],[5296,"لك السلام","https://www.poetsgate.com/ViewPoem.aspx?id=154776",""]],"verses":[["لكنْ ضَنَنْتُ على العيونِ بِحُسْنِها","وأَنِفْتُ مِنْ نَظَرِ الحَسُود إِليها",0,"ي",3,0],["لك نضرةُ الفجر الجميل","على الدوائبِ والقممْ",1,"م",1,0],["لَكنَّ ضعفاً في فُؤادِكَ يَقتَضي","التَسليم ذُلّاً لِلأُولى حَجَبوكِ",2,"ك",1,0],["لكن ضميري وهو الحي متبع","حقيقة حبها من افضل القسم",3,"م",1,0],["لَكِنَّ ضِدَّكَ ضَلَّ في سُبُلِ الردى","فَمُرادُهُ ضَربٌ مِنَ الهذيانِ",4,"ن",1,0],["لكنّ ضيّعَ بعضَ الحزْمِ حينَ أرَى","مَيْلاً إلى فئةٍ غَشّتْ وما نصحَتْ",5,"ت",1,0],["لَكن ضللت بشعره في ظلمة","يا لَيته بسنا الجبين هداني",6,"ن",2,0],["لكن ضرورة أوقات مراغمة","ترنق العيش أحيانا على سأم",7,"م",1,0],["لكن ضَمير التَهاني غَير مُستَتِر","وَنور أُنسي بَدا لِلنّاسِ كَالفَلق",8,"ق",1,0],["لكن ضر الحر من","عسر يعيد اليسر اسرا",9,"ر",2,0],["لكنْ ضلالتَها في عزفِها رقصَتْ","أهلُ الهدى قبلَ أهلِ الغَيِّ في طربِ",10,"ب",1,0],["لَكِّنَ ضيفي في القصيدةِ سَيِّدٌ","ما أنجَبَتْ في الكونِ منهُ نِساءُ",11,"ا",2,0]]}