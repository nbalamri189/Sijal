{"poems":[[29,"لم أر مثلك يا أمام خليلا","https://www.aldiwan.net/poem5969.html","الكامل"],[82,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[77,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[164,"من زاحم الأسد في غاباتها وقعا","https://www.aldiwan.net/poem58923.html","البسيط"],[543,"من كليلى في الصبايا","https://www.aldiwan.net/poem48265.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122640","المديد"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96300","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118375","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48438","الكامل"]],"verses":[["مِن كُلِّ يَعمَلَةِ النَجاءِ تَكَلَّفَت","جَوزَ الفَلاةِ تَأَوُّهاً وَذَميلا",0,"ل",2,0],["من كلّ يعبوبٍ كريح الصّبا","يطير جرياً ما أراد اللجام",1,"م",1,0],["من كلّ يَعْبُوب يَحيدُ فلا ترى","إلاّ قَذالاً سامِياً وتَليلا",2,"ل",2,0],["من كلِّ يعْبوبٍ سَبوحٍ سلْهَبٍ","حَصُّ السّياطِ عِنانُه الطيّار",3,"ر",1,0],["من كل يومٍ سافكِ الدماءِ","تعوذ منه الأرضُ بالسماءِ",4,"ا",2,0],["من كلِّ يوم يرينا من مكارمهِ","خوارقاً سنَّها في الجود وابتدعا",5,"ع",2,0],["مَن كَلَيلَى في الصَّبَايا","في السَّجَيا والمَزَايا",6,"ي",2,1],["مَن كُلَيبٌ في رِئاسَتِه","مَن أبو شاسٍ ومَن شاسُ",7,"س",1,0],["من كلِّ يعملَةِ النِّجاءِ شِملَّةٍ","قَوداءَ يملأُ نحرُها التصديرا",8,"ر",2,0],["من كل يعملة في البيد جافلة","عدو المصك رأى القناص فانحرفا",9,"ف",2,0],["من كُلّ يقْظانِ الفؤادِ حديثُهُ","يزَعُ المنامَ عنِ العُيون النُّوَّمِ",10,"م",1,0]]}