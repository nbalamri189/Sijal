بسحير","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577675",""],[5001,"همس الأهداب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80719&r=&rc=9",""]],"verses":[["إِذا دَنَتِ البَيضاءُ مِنّي لِحاجَةٍ","أَبى الأَبيَضُ الماضي فَأَبعَدَها عَنّي",0,"ن",2,0],["إِذا دَبَّرَ الطَعنَ أوهِمتُهُ","تَنِمُّ إِلى النَجمِ خِرصانُهُ",1,"ن",2,0],["أَذادُ أَن أَرفُلَ في أَرضِهِ","وَيَرتَعي ذاكَ الجَنابَ العَميم",2,"م",1,0],["إِذا دَعَوا وَالوِردُ مُستَوبَلٌ","دَفّوا إِلى الطَعنِ دَفيفَ النَعام",3,"م",1,0],["إِذا دُعوا لِلطَعنِ وَالخَطبُ جَلَل","حَسِبتَ أَيديهِم مِنَ القَنا الذُبُل",4,"ل",1,0],["إذا دلَفوا إِلى الهَيْجاءِ عَفّتْ","على الأعْداءِ داهِيَةٌ نَآدُ",5,"د",1,0],["إذا دَعَوتُ لها المُستَظهِرَ ابتدَرَتْ","مِن كفِّهِ سُحُبُ الجَدْوى تُلَبّيني",6,"ن",2,0],["إِذ أَدبَروا فَعَمِلنا في ظُهورِهِمُ","ما تَعمَلُ النارُ في الحَلفا فَتَحتَرِقُ",7,"ق",1,0],["إِذَا دَانَتِ اللَّهَ النُّفُوسُ وَأَمَّلَتْ","إِقَالَةَ ذَنْبٍ أَوْ إِنَالَةَ غُفْرَانِ",8,"ن",1,0],["إِذَا دَعَتْنَا إِلَى السَّلْوَانِ بَعْدَكُمُ","نُفُوسَنَا قَامَتِ الأَشْوَاقُ تَنْهَانَا",9,"ن",2,0],["إذا دَهَمَ الرَّوْعُ استَقَلّ دِفاعُهُ","وإنْ أخْلَفَ الغَيْثُ استهَلّ سَماحُهُ",10,"ح",2,0],["إِذا دَعا القَولُ أَتى طائِعاً","وَإِن دَعاهُ العِيُّ لَم يَسمَعِ",11,"ع",1,0],["إِذا دَبَرانٌ مِنكِ يوماً لَقِتُهُ","أُؤَمِّلُ أَن أَلقاكِ بَعدُ بِأَسعُدِ",12,"د",1,0],["إذا دهتك من الأيام داهية","فلا رعى الله عيناً تألف الوَسَنا",13,"ن",2,0],["إذا دُفِع الشرُّ القبيحُ بمثله","تَحصَّل شرّ ثالث وتَوَلَّدا",14,"د",2,0],["إِذا دَعا الصارِخُ المَلهوفُ هِجتُ بِهِ","مِثلَ اللُيوثِ جَلا عَن غُلبِها الغيلُ",15,"ل",1,0],["إِذا دَخَلَ المَدينَةَ فَاِرجُموهُ","وَلا تَدنوهُ مِن جَدَثِ الرَسولِ",16,"ل",1,0],["إِذا دَجا اللَيلُ وَغابَ شارِقُه","وَضاقَ عَن عَينِ الصَوابِ مُرافِقُه",17,"ق",2,0],["إذا دَعتِ الحربُ العوانُ حسامه","جلا أفقها والرُّمح للسن يقرع",18,"ع",1,0],["إذا دعَا خادم شجوٍ إلى","دمعٍ جرَى في الحالِ مرجانه",19,"ن",2,0],["إذا دعت للنهوضِ ميلها عطفا","كانَ سحر الجفون حملها ضعفا",20,"ف",2,0],["إِذا دَهَمَتكَ خُيولُ البِعاد","وَنادى إِلاياسُ بِقَطعِ الرَجا",21,"ا",1,1],["إذا دام للمرء السوادُ ولم تَدُمْ","غَضارتُهُ ظنَّ السوادَ خضابا",22,"ب",2,1],["إذا دعا الشِعر مادِحوه لهُ","جاء مجيءَ المَرُوضِ مُقْتَضَبُهْ",23,"ب",2,0],["إذا درجت فيه الشّمال تتابعت","ذوائبهُ حتى تقول غدير",24,"ر",1,0],["إذا دعا الشِّعرَ مادحوه له","أقبل مُعتاصُه كمرتاضه",25,"ض",2,0],["إذا دفعتْ ألبانُها عن دمائِها","أبى ذاك خِرق سيفُهُ الدهرَ عابِطُ",26,"ط",1,0],["إذا دعا لك داع قلت حينئذ","لا زال من وصب الشكوى على ساق",27,"ق",1,0],["إذا دُفعتْ أيدي الزناةِ بسُحرةٍ","رفعن لمرتادِ الزنا أرجُلَ الزنا",28,"ن",2,0],["إِذا دارَت عَلى الجُلّاسِ هَشّوا","كَأَنَّ كُؤوسَها أَخبارُ نَصرِ",29,"ر",1,0],["إِذا دَنا رَغِبَت أَن لا يُفارِقَها","وَإِن نَأى أَصبَحَت تَشتاقُ لَو ذُكِرا",30,"ر",2,0],["إذا دهمت والليل من كل جانب","فنومي قتيل والصباح أسير",31,"ر",1,0],["إذا دنت الديار به فناء","وإن نأت الديار به فداني",32,"ن",2,0],["إِذا دَعا الشَوقُ لَم نَبرَح بِمُنصَدِعٍ","مِنَ الجَناحَينِ عَيٍّ لا يُلَبّينا",33,"ن",2,0],["أَذا داءٌ هَفا بُقراطُ عَنهُ","فَلَم يُعرَف لِصاحِبِهِ ضَريبُ",34,"ب",1,0],["إِذا دَرى الحِصنُ مَن رَماهُ بِها","خَرَّ لَها في أَساسِهِ ساجِد",35,"د",1,0],["إِذا دَعا العِلجُ عِلجاً حالَ بَينَهُما","أَظمى تُفارِقُ مِنهُ أُختَها الضِلَعُ",36,"ع",1,0],["إِذا دُعِيَت عَيناءُ أَيقَنتُ أَنَّني","بِشَربَةَ رَيٍّ لا مَحالَةَ شارِبُ",37,"ب",1,1],["إِذا دَخَلوا النِباجَ بَنَوا عَلَيها","بُيوتَ اللُؤمِ وَالعَمَدَ القِصارا",38,"ر",2,0],["إِذا دَمَعَت عَيناكَ وَالشَوقُ قائِدُن","لِذي الشَوقِ حَتّى تَستَبينَ المُكَتَّما",39,"م",2,1],["إذا دَغْدَغَتِ العُودَ","رأيناه يُناغِيها",40,"ي",3,0],["إذا دَنَتِ الخِيامُ بهِمْ فأهلاً","بذاكَ الخِيمِ والخِيَمِ الدَّواني",41,"ن",2,0],["إذا دَجَى اللَّيلُ كان لي قمراً","وإن بدا الصُّبحُ كان لي صَنَما",42,"م",2,0],["إذا داوى به شَبَقُ السْ","ريرَةِ داءَه انحسَما",43,"م",2,0],["إذا دخلناه زِدنا من محاسِنه","وطيبِه في نعيمٍ غيرِ مملولِ",44,"ل",1,0],["إذا دعَتِ الملوكُ إليه يوماً","فإذعانُ الملوكِ له جَوابُ",45,"ب",1,0],["إِذا دُرِئَت بِها الأَدواءُ جاءَت","بِما يُغنيكَ عَن شُربِ الدَواءِ",46,"ا",2,0],["إذا دُعيَ الموتُ بالهزّ منه","أجابَ بصلصلةِ الجلجَلِ",47,"ل",1,0],["إِذا دُجاها أَحاطَت بي أَحَطتُ بِها","قَلباً مَتى أَسرِ في مِصباحِهِ يَقِدِ",48,"د",1,0],["إِذا دَرَجَت فيهِ الصَبا كَفكَفَت لَها","وَقامَ لُباريها أَبو الفَضلِ جَعفَرُ",49,"ر",1,0],["إذا درى الحصنُ مَنْ رماهُ بها","خرَّ لهُ في أساسهِ ساجدْ",50,"د",1,0],["إذا دجا الخطبُ شعَّت في ضمائرهم","أضواء حرفٍ بليل البؤس مرهون",51,"ن",1,0],["إِذا دَبَّ أَخفى مِن خَيالِ مَكيدَةٍ","تَصَوَّبَ أَسرى مِن شِهابٍ وَأَطلَعا",52,"ع",2,0],["إذا دَأبَ القضاءُ يُريد أمراً","تقاصرَ عنه سَعْيُ الدّائبينا",53,"ن",2,0],["إِذا دارَت بِهِم ذَهَبوا وَجاءوا","أَذِلّاءَ النُفوسِ مُسخَّرينا",54,"ن",2,0],["إِذا داهَمَتها لَم تُفِدها ضَراعَةٌ","وَلَو خَرَّ عاتيها عَلى الأَرضِ يَسجُدُ",55,"د",1,0],["إِذا دانَت مَكانَ النَجمِ هاجَت","وَساوِسُهُ وَلَجَّ بِهِ الخُفوقُ",56,"ق",1,0],["إِذا دَلَفَ الأَعمى تَلَفَّتَ حَولَهُ","يَظُنُّ فُضولَ الثَوبِ كَفّاً وَمِعصَما",57,"م",2,0],["إِذا دَعا باِسمِها الإِنسانُ أَو سَمِعَت","ذَاتَ الآلهِ يُرى في سَعيِها رَزَمُ",58,"م",1,0],["إِذا دُعِينَ بِأَسماءٍ أَجَبنَ بِها","لِنافثٍ يَعتَريهِ اللَهُ والكَلِمُ",58,"م",1,0],["إِذا دَعا بِشِعارِ الأَزدِ نَفَّرَهُم","كَما يُنَفِّرُ صَوتُ اللَيثِ بالنَقَدِ",59,"د",1,0],["إِذا دَعَت هاجَ ذا الأَشجانِ مَنطِقُها","كَأَنَّها قَينَةٌ غَنَّت عَلى عُودِ",60,"د",1,0],["إِذا دَعَتهُنَّ لضم يَقعُدنَ وَانِيَةً","صَفدَ الجِيادِ عَلى أَرسانِها الصُفُنِ",61,"ن",1,0],["إِذا دَقَّ أَعناقَ المَطِيِّ وَأَفضَلَت","نُسوعٌ عَلى الأَكوارِ بَعدَ نُسوعِ",62,"ع",1,0],["إذا درَعُوا كانتْ عُيُونُ دُرُوعِهِم","قلوباً لها في الرَّوْعِ مِنْ بَأْسِهِمْ سَرْدُ",63,"د",1,0],["إِذا دَعا الصاحِبَ يَهيا بِهِ","وَيُتبِعُ اليَهياءَ يَهياءَ",64,"ا",2,0],["إِذا دارَت عَلى قَومٍ رَحانا","تَنادَوا بِالجَلاءِ أَوِ اِستَداروا",65,"ر",3,0],["إِذا دَعانا ذَبَبنا عَن مَحارِمِهِ","ذَبَّ البَنينَ عَنِ الآباءِ أَحشادِ",66,"د",1,0],["إِذا دَنا العَيشُ فَمَعروفُهُ","دانٍ بِعَيشِ القانِعِ المُترِبِ",67,"ب",1,0],["إِذا دَرَجَت في العالَمينَ قَبيلَةٌ","فَخَيرٌ لَها مِن أَن تَئِثَّ خُروجُها",68,"ج",3,1],["إِذا دَفَنَت في الثَرى هالِكاً","تَناسَت عُهوداً لِأَحبابِها",69,"ب",3,0],["إِذا دَنَوتِ لِشامٍ أَو مَرَرتِ بِهِ","فَنَكِّبيهِ وَراءَ الظَهرِ أَو حيدي",70,"ي",1,1],["إِذا دَخَلَ الهِرماسُ جِلَّقَ والِياً","فَما كَذَبَت فيما تَقولُ الهَرامِسُ",71,"س",1,0],["إِذا دُعيتُ لِأَمرٍ عادَني بِأَذىً","أَو رُزءِ دينٍ فَإِبطائي هُوَ السَرَعُ",72,"ع",1,0],["إِذا داعٍ دَعاكَ لِرُشدِ أَمرٍ","فَلَبِّ وَلا يَفُتكَ لَهُ اِتِّباعُ",73,"ع",1,1],["إِذا دارَتِ الكَأسُ في دارِهِم","فَقَد رَحَلَ الدينُ عَن دارِهِم",74,"م",1,1],["إِذا دَخَلُوا بُيُوتَهُمُ أَكَبُّوا","عَلى الرُّكباتِ مِن قِصَرِ العِمادِ",75,"د",1,0],["إِذا دَنا حَتفي","تَزول أَسقامي",76,"ي",1,0],["إذا دعا علجاً حال بينهما","أظمى تفارق منه أختها الضّلع",77,"ع",1,0],["إذا داعبَ الماءُ ظلّ الشَّجرْ","وغازلتِ السُّحبُ ضوءَ القمرْ",78,"ر",1,1],["إذا دعا بوجهه مشيراً","نحو السماء استقبل البشيرا",79,"ر",2,0],["إذا دجا النّور في غمر الضحى ائتلقا","وإن سطا الظّلم مخمور الظّبى صمدا",80,"د",2,0],["إِذَا دَعَا الصِّدْقُ لَبَّى طَيِّعاً وَإِذَا","دَعَتُ مُصَانعَةٌ يوْماً عتَى وجفَا",81,"ف",2,0],["إِذَا دَبَّ خُلفٌ مُوهِنٌ فِي جَمَاعَةٍ","أَيُبْلِغُهَا أَدْنَى الأَمَانِيِّ قَائِدُ",82,"د",1,0],["إذَا دَعَاهُ صَرِيخٌ كَانَ دَعْوَتَهُ","وَإنْ دَعَتْهُ دَوَاعِي الذُّعْرِ لَمْ يُجِبِ",83,"ب",1,0],["إذا دَعَا الحقُّ لبَّتْهُ جحافِلُنا","وإن سَطَا الجَوْرُ ردَّتهُ مَواضِينا",84,"ن",2,0],["إذا دَجَت الحوادث؛ فاستضيئي","بنور اللهِ في الليل البَهِيم",85,"م",1,0],["اذا دبر الله أمرا جرى","برغم تدابيرنا الفاسدة",86,"د",2,0],["اذا دعا المجد تفادى ناقصا","وان دعاه بذخ قال انا",87,"ا",1,0],["إذا دعانا ذببنا عن محارمه","ذب البنين عن البنين عن الآباء أحشاد",88,"د",1,0],["إذا دنا رغبت لا يفارقها","وإن نأى أصبحت تشتاق لو ذكرا",89,"ر",2,0],["إذا دَبَرَانٌ مِنْكِ يَوماً لَقِيتُهُ","أؤمِّلُ أنْ ألقاكِ بعدُ بأسعُدِ",90,"د",1,0],["إذا دَمَعَتْ عَيْناكَ وَالشّوْقُ قائِدٌ","لذي الشّوْقِ، حتى تَستَبِينَ المُكَتَّما",91,"م",2,1],["إذا درجت فيه السّمال تتابعت","ذوائبهُ حتى تقول غدير",92,"ر",1,0],["إذا داهمتها لم تفدها ضراعة ٌ","ولو خر عاتبها على الأرض يسجد",93,"د",