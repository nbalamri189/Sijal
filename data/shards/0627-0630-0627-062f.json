َيْنا","فَهل دارت علينا بالخُمُورِ !",297,"ر",1,0],["إذا دقّ هدّاب الصبير حسبته","حواشي مصقول الغرار يماني",298,"ن",2,0],["إذا درست من حياتي صحفا","درست ما يغبطني بين الورى",299,"ا",1,0],["اذا داريت روح الحب يا مودي","ملازيم الوعود الصادقة فيها",300,"ي",3,0],["إذا داعَبْتَ في الميناءِ جُزءا","ً رأيتَ الماءَ من حدّيْهِ سالا",301,"ل",2,0],["إذا دمّرت أرزاقَ شعبٍ قذيفةٌ","فحاكمها الملعون للبِرّ يقمعُ",302,"ع",1,0],["إذا دَخَلَ المعانِدُ في جِدَالٍ","فَلا رَأْيٌ يُفِيدُ ولا دَلِيلُ",303,"ل",1,1],["إذا داسوا كرامتنا","فماذا ينفع الذهب",304,"ب",1,0],["إذا دعت الرحمن أرض أقامهم","إليها فلن يكشف لأثوابها ستر",305,"ر",1,0],["إذا دخلَ الحلالُ على الحرامِ","وضاعَ الحقُ مابينَ الأنامِ",306,"م",1,1],["اذا دنا نحو ناد صاح عل يرى","مجيب دعوته من ذلك النادي",307,"د",2,0],["إذا دنا النَّصرُ يحمر الفضاء له","مثل احمرار خدود الناعم الطَّفَلِ",308,"ل",1,0],["إذا دعا مجتديه حمدا","له جميع الأنام أمن",309,"ن",1,0],["أُذادُ كما شَاءَ الدلال فلا أرى","بخدّك روضاً أو بثغرك منهلا",310,"ل",2,0],["إذا دهتني فيه خطوب الليالي","ورمتني عن قوسها المرنان",311,"ن",1,0],["إذا دنوت تشب النار في جسدي","وإن نأيت .. بعيني يسهر السهر",312,"ر",1,0]]}