{"poems":[[53,"تضاجعني الحسناء والسيف دونها","https://www.aldiwan.net/poem29728.html","الطويل"],[53,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[53,"لا عادت الكأس عليل النسيم","https://www.aldiwan.net/poem29774.html","السريع"],[53,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[53,"أغر أيامي مني ذا الطلل","https://www.aldiwan.net/poem29853.html","الرجز"],[63,"علوت فدونك السبع الشداد","https://www.aldiwan.net/poem46157.html","الوافر"],[63,"أهذه خطرات الربرب العين","https://www.aldiwan.net/poem46216.html","البسيط"],[3,"لقد وجدنا زبيداَ غير صابرة","https://www.aldiwan.net/poem177.html",""],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[77,"هات الحديث عن الركب الذي بانا","https://www.aldiwan.net/poem36075.html","البسيط"],[77,"هو النصر باد للعيون صباحه","https://www.aldiwan.net/poem36646.html","الطويل"],[86,"هجعت يا طير ولم أهجع","https://www.aldiwan.net/poem68946.html","السريع"],[35,"تظل ابنة الضمري في ظل نعمة","https://www.aldiwan.net/poem39160.html","الطويل"],[88,"يا قوم إن العدى قد هاجموا الوطنا","https://www.aldiwan.net/poem44462.html","البسيط"],[88,"تريد لي الأيام أن أتقيد","https://www.aldiwan.net/poem45016.html","الطويل"],[27,"خف القطين فقلبي اليوم متبول","https://www.aldiwan.net/poem5952.html","البسيط"],[27,"أتنسى يوم حومل والدخول","https://www.aldiwan.net/poem5965.html","الوافر"],[47,"أشاقك الطيف ألم طارقه","https://www.aldiwan.net/poem25220.html","الرجز"],[72,"سرى طيفها حيث العواذل هجع","https://www.aldiwan.net/poem19163.html","الطويل"],[72,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[72,"لهفي على غادة إذا أسفرت","https://www.aldiwan.net/poem20618.html","المنسرح"],[64,"إذا دهمتك خيول البعاد","https://www.aldiwan.net/poem67673.html","المتقارب"],[51,"إذا دام للمرء السواد ولم تدم","https://www.aldiwan.net/poem8323.html","الطويل"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"وحلس من الكتان أخضر ناعم","https://www.aldiwan.net/poem62900.html","الوافر"],[51,"أنهضه في أوان إنهاضه","https://www.aldiwan.net/poem64941.html","المنسرح"],[51,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[51,"لا يكشف الله عن وهب بن إسحاق","https://www.aldiwan.net/poem65708.html","البسيط"],[51,"أقول لراجي خالدٍ إذ رأيته","https://www.aldiwan.net/poem66530.html","الطويل"],[91,"شربناها على سر القوافي","https://www.aldiwan.net/poem8849.html","عموديه"],[91,"من الفرنسيس قيد العين صورتها","https://www.aldiwan.net/poem8873.html","عموديه"],[85,"شجوني إذا جن الظلام كثير","https://www.aldiwan.net/poem7520.html","الطويل"],[85,"ألا هل لي بلقياه يدانِ","https://www.aldiwan.net/poem7802.html","الوافر"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[43,"أيدري ما أرابك من يريب","https://www.aldiwan.net/poem9458.html","الوافر"],[43,"أزائر يا خيال أم عائد","https://www.aldiwan.net/poem9559.html","المنسرح"],[43,"غيري بأكثر هذا الناس ينخدع","https://www.aldiwan.net/poem9719.html","البسيط"],[28,"إذا دعيت عيناء أيقنت أنني","https://www.aldiwan.net/poem1250.html",""],[28,"ترجي أن تزيد بنو فقيم","https://www.aldiwan.net/poem5184.html","الوافر"],[28,"إذا دمعت عيناك والشوق قائدن","https://www.aldiwan.net/poem5589.html","الطويل"],[61,"غداة الشك ندعوك","https://www.aldiwan.net/poem51402.html","الهزج"],[61,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[61,"أفي دمى أبكت العيون دما","https://www.aldiwan.net/poem51428.html","المنسرح"],[61,"غدت لذاتنا أمما","https://www.aldiwan.net/poem51435.html","مجزوء الوافر"],[61,"إذا المجرة مالت بعد تعديل","https://www.aldiwan.net/poem51485.html","البسيط"],[61,"أكان لقلبه عنك انقلاب","https://www.aldiwan.net/poem51816.html","الوافر"],[66,"رسائل صدق إخوان الصفاء","https://www.aldiwan.net/poem39063.html","الوافر"],[80,"وأبيض تحسب فيه الفرند","https://www.aldiwan.net/poem31325.html","المتقارب"],[44,"قلبت أمري في بدء وفي عقب","https://www.aldiwan.net/poem30054.html","البسيط"],[44,"شجا في الحشى ترداده ليس يفتر","https://www.aldiwan.net/poem30502.html","الطويل"],[69,"طارت لقلع القلاع زلزلة","https://www.aldiwan.net/poem29209.html","المنسرح"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[74,"سجعت وقد غنى الحمام فرجعا","https://www.aldiwan.net/poem13173.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"أمن عرش الشآم إلى أثينا","https://www.aldiwan.net/poem43065.html","الوافر"],[105,"حماة الوغى أين السلام الموطد","https://www.aldiwan.net/poem43104.html","الطويل"],[105,"صبوح دم يساجله غبوق","https://www.aldiwan.net/poem43115.html","الوافر"],[105,"يهين رجال في الحياة نفوسهم","https://www.aldiwan.net/poem43134.html","الطويل"],[21,"والحية الحتفة الرقشاء أخرجها","https://www.aldiwan.net/poem36160.html","البسيط"],[39,"إن الفؤاد للبائن الغرد","https://www.aldiwan.net/poem53795.html","البسيط"],[40,"يا من لقلب شديد الهم معمود","https://www.aldiwan.net/poem42280.html","البسيط"],[40,"ما هاج قلبك يوم العرج من ظعن","https://www.aldiwan.net/poem42333.html","البسيط"],[22,"تبينت ما فيه بخفان إنني","https://www.aldiwan.net/poem21695.html","الطويل"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[48,"يا راكبا أقبل من ثهمد","https://www.aldiwan.net/poem10416.html","السريع"],[50,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[50,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[50,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[46,"إذا درجت في العالمين قبيلة","https://www.aldiwan.net/poem22241.html","الطويل"],[46,"معاص تلوح فأوصيكم","https://www.aldiwan.net/poem22364.html","المتقارب"],[46,"إذا دنوت لشام أو مررت به","https://www.aldiwan.net/poem22474.html","البسيط"],[46,"نراقب ضوء الفجر والليل دامس","https://www.aldiwan.net/poem22783.html","الطويل"],[46,"النفس في العالم العلوي مركزها","https://www.aldiwan.net/poem22943.html","البسيط"],[46,"إذا داع دعاك لرشد أمر","https://www.aldiwan.net/poem22945.html","الوافر"],[46,"إذا دارت الكأس في دارهم","https://www.aldiwan.net/poem23439.html","المتقارب"],[8,"أضل الله سعي بني قريع","https://www.aldiwan.net/poem21782.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85479","الرجز"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140974",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39545","المتقارب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55040","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[106,"صفاء النفس!","https://www.poetsgate.com/ViewPoem.aspx?id=179324",""],[50,"أمن وقوف على شام بأحماد","https://www.poetsgate.com/ViewPoem.aspx?id=21772",""],[35,"تظلُّ ابنة ُ الضَّمريِّ في ظلِّ نعمة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22010",""],[28,"إذا دَمَعَتْ عَيْناكَ وَالشّوْقُ قائِدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=17962",""],[51,"وحِلْسٍ من الكتّاب أخضر ناعمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=29026",""],[105,"حماة الوغى أين السلام الموطد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54957&r=&rc=127",""],[3,"لقد وجدنا زَبيداً غيرَ صابرة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10720&r=&rc=74",""]],"verses":[["إِذا دَنَتِ البَيضاءُ مِنّي لِحاجَةٍ","أَبى الأَبيَضُ الماضي فَأَبعَدَها عَنّي",0,"ي",1,0],["إِذا دَبَّرَ الطَعنَ أوهِمتُهُ","تَنِمُّ إِلى النَجمِ خِرصانُهُ",1,"ن",2,0],["أَذادُ أَن أَرفُلَ في أَرضِهِ","وَيَرتَعي ذاكَ الجَنابَ العَميم",2,"م",1,0],["إِذا دَعَوا وَالوِردُ مُستَوبَلٌ","دَفّوا إِلى الطَعنِ دَفيفَ النَعام",3,"م",1,0],["إِذا دُعوا لِلطَعنِ وَالخَطبُ جَلَل","حَسِبتَ أَيديهِم مِنَ القَنا الذُبُل",4,"ل",1,0],["إذا دلَفوا إِلى الهَيْجاءِ عَفّتْ","على الأعْداءِ داهِيَةٌ نَآدُ",5,"د",1,0],["إذا دَعَوتُ لها المُستَظهِرَ ابتدَرَتْ","مِن كفِّهِ سُحُبُ الجَدْوى تُلَبّيني",6,"ي",1,0],["إِذ أَدبَروا فَعَمِلنا في ظُهورِهِمُ","ما تَعمَلُ النارُ في الحَلفا فَتَحتَرِقُ",7,"ق",1,0],["إِذَا دَانَتِ اللَّهَ النُّفُوسُ وَأَمَّلَتْ","إِقَالَةَ ذَنْبٍ أَوْ إِنَالَةَ غُفْرَانِ",8,"ن",1,0],["إِذَا دَعَتْنَا إِلَى السَّلْوَانِ بَعْدَكُمُ","نُفُوسَنَا قَامَتِ الأَشْوَاقُ تَنْهَانَا",9,"ن",2,0],["إذا دَهَمَ الرَّوْعُ استَقَلّ دِفاعُهُ","وإنْ أخْلَفَ الغَيْثُ استهَلّ سَماحُهُ",10,"ح",2,0],["إِذا دَعا القَولُ أَتى طائِعاً","وَإِن دَعاهُ العِيُّ لَم يَسمَعِ",11,"ع",1,0],["إِذا دَبَرانٌ مِنكِ يوماً لَقِتُهُ","أُؤَمِّلُ أَن أَلقاكِ بَعدُ بِأَسعُدِ",12,"د",1,0],["إذا دهتك من الأيام داهية","فلا رعى الله عيناً تألف الوَسَنا",13,"ن",2,0],["إذا دُفِع الشرُّ القبيحُ بمثله","تَحصَّل شرّ ثالث وتَوَلَّدا",14,"د",2,0],["إِذا دَعا الصارِخُ المَلهوفُ هِجتُ بِهِ","مِثلَ اللُيوثِ جَلا عَن غُلبِها الغيلُ",15,"ل",1,0],["إِذا دَخَلَ المَدينَةَ فَاِرجُموهُ","وَلا تَدنوهُ مِن جَدَثِ الرَسولِ",16,"ل",1,0],["إِذا دَجا اللَيلُ وَغابَ شارِقُه","وَضاقَ عَن عَينِ الصَوابِ مُرافِقُه",17,"ق",2,0],["إذا دَعتِ الحربُ العوانُ حسامه","جلا أفقها والرُّمح للسن يقرع",18,"ع",1,0],["إذا دعَا خادم شجوٍ إلى","دمعٍ جرَى في الحالِ مرجانه",19,"ن",2,0],["إذا دعت للنهوضِ ميلها عطفا","كانَ سحر الجفون حملها ضعفا",20,"ف",2,0],["إِذا دَهَمَتكَ خُيولُ البِعاد","وَنادى إِلاياسُ بِقَطعِ الرَجا",21,"ا",1,1],["إذا دام للمرء السوادُ ولم تَدُمْ","غَضارتُهُ ظنَّ السوادَ خضابا",22,"ب",2,1],["إذا دعا الشِعر مادِحوه لهُ","جاء مجيءَ المَرُوضِ مُقْتَضَبُهْ",23,"ب",2,0],["إذا درجت فيه الشّمال تتابعت","ذوائبهُ حتى تقول غدير",24,"ر",1,0],["إذا دعا الشِّعرَ مادحوه له","أقبل مُعتاصُه كمرتاضه",25,"ض",2,0],["إذا دفعتْ ألبانُها عن دمائِها","أبى ذاك خِرق سيفُهُ الدهرَ عابِطُ",26,"ط",1,0],["إذا دعا لك داع قلت حينئذ","لا زال من وصب الشكوى على ساق",27,"ق",1,0],["إذا دُفعتْ أيدي الزناةِ بسُحرةٍ","رفعن لمرتادِ الزنا أرجُلَ الزنا",28,"ن",2,0],["إِذا دارَت عَلى الجُلّاسِ هَشّوا","كَأَنَّ كُؤوسَها أَخبارُ نَصرِ",29,"ر",1,0],["إِذا دَنا رَغِبَت أَن لا يُفارِقَها","وَإِن نَأى أَصبَحَت تَشتاقُ لَو ذُكِرا",30,"ر",2,0],["إذا دهمت والليل من كل جانب","فنومي قتيل والصباح أسير",31,"ر",1,0],["إذا دنت الديار به فناء","وإن نأت الديار به فداني",32,"ن",2,0],["إِذا دَعا الشَوقُ لَم نَبرَح بِمُنصَدِعٍ","مِنَ الجَناحَينِ عَيٍّ لا يُلَبّينا",33,"ن",2,0],["أَذا داءٌ هَفا بُقراطُ عَنهُ","فَلَم يُعرَف لِصاحِبِهِ ضَريبُ",34,"ب",1,0],["إِذا دَرى الحِصنُ مَن رَماهُ بِها","خَرَّ لَها في أَساسِهِ ساجِد",35,"د",1,0],["إِذا دَعا العِلجُ عِلجاً حالَ بَينَهُما","أَظمى تُفارِقُ مِنهُ أُختَها الضِلَعُ",36,"ع",1,0],["إِذا دُعِيَت عَيناءُ أَيقَنتُ أَنَّني","بِشَربَةَ رَيٍّ لا مَحالَةَ شارِبُ",37,"ب",1,1],["إِذا دَخَلوا النِباجَ بَنَوا عَلَيها","بُيوتَ اللُؤمِ وَالعَمَدَ القِصارا",38,"ر",2,0],["إِذا دَمَعَت عَيناكَ وَالشَوقُ قائِدُن","لِذي الشَوقِ حَتّى تَستَبينَ المُكَتَّما",39,"م",2,1],["إذا دَغْدَغَتِ العُودَ","رأيناه يُناغِيها",40,"ي",3,0],["إذا دَنَتِ الخِيامُ بهِمْ فأهلاً","بذاكَ الخِيمِ والخِيَمِ الدَّواني",41,"ي",1,0],["إذا دَجَى اللَّيلُ كان لي قمراً","وإن بدا الصُّبحُ كان لي صَنَما",42,"م",2,0],["إذا داوى به شَبَقُ السْ","ريرَةِ داءَه انحسَما",43,"م",2,0],["إذا دخلناه زِدنا من محاسِنه","وطيبِه في نعيمٍ غيرِ مملولِ",44,"ل",1,0],["إذا دعَتِ الملوكُ إليه يوماً","فإذعانُ الملوكِ له جَوابُ",45,"ب",1,0],["إِذا دُرِئَت بِها الأَدواءُ جاءَت","بِما يُغنيكَ عَن شُربِ الدَواءِ",46,"ا",2,0],["إذا دُعيَ الموتُ بالهزّ منه","أجابَ بصلصلةِ الجلجَلِ",47,"ل",1,0],["إِذا دُجاها أَحاطَت بي أَحَطتُ بِها","قَلباً مَتى أَسرِ في مِصباحِهِ يَقِدِ",48,"د",1,0],["إِذا دَرَجَت فيهِ الصَبا كَفكَفَت لَها","وَقامَ لُباريها أَبو الفَضلِ جَعفَرُ",49,"ر",1,0],["إذا درى الحصنُ مَنْ رماهُ بها","خرَّ لهُ في أساسهِ ساجدْ",50,"د",1,0],["إذا دجا الخطبُ شعَّت في ضمائرهم","أضواء حرفٍ بليل البؤس مرهون",51,"ن",1,0],["إِذا دَبَّ أَخفى مِن خَيالِ مَكيدَةٍ","تَصَوَّبَ أَسرى مِن شِهابٍ وَأَطلَعا",52,"ع",2,0],["إذا دَأبَ القضاءُ يُريد أمراً","تقاصرَ عنه سَعْيُ الدّائبينا",53,"ن",2,0],["إِذا دارَت بِهِم ذَهَبوا وَجاءوا","أَذِلّاءَ النُفوسِ مُسخَّرينا",54,"ن",2,0],["إِذا داهَمَتها لَم تُفِدها ضَراعَةٌ","وَلَو خَرَّ عاتيها عَلى الأَرضِ يَسجُدُ",55,"د",1,0],["إِذا دانَت مَكانَ النَجمِ هاجَت","وَساوِسُهُ وَلَجَّ بِهِ الخُفوقُ",56,"ق",1,0],["إِذا دَلَفَ الأَعمى تَلَفَّتَ حَولَهُ","يَظُنُّ فُضولَ الثَوبِ كَفّاً وَمِعصَما",57,"م",2,0],["إِذا دَعا باِسمِها الإِنسانُ أَو سَمِعَت","ذَاتَ الآلهِ يُرى في سَعيِها رَزَمُ",58,"م",1,0],["إِذا دُعِينَ بِأَسماءٍ أَجَبنَ بِها","لِنافثٍ يَعتَريهِ اللَهُ والكَلِمُ",58,"م",1,0],["إِذا دَعا بِشِعارِ الأَزدِ نَفَّرَهُم","كَما يُنَفِّرُ صَوتُ اللَيثِ بالنَقَدِ",59,"د",1,0],["إِذا دَعَت هاجَ ذا الأَشجانِ مَنطِقُها","كَأَنَّها قَينَةٌ غَنَّت عَلى عُودِ",60,"د",1,0],["إِذا دَعَتهُنَّ لضم يَقعُدنَ وَانِيَةً","صَفدَ الجِيادِ عَلى أَرسانِها الصُفُنِ",61,"ن",1,0],["إِذا دَقَّ أَعناقَ المَطِيِّ وَأَفضَلَت","نُسوعٌ عَلى الأَكوارِ بَعدَ نُسوعِ",62,"ع",1,0],["إذا درَعُوا كانتْ عُيُونُ دُرُوعِهِم","قلوباً لها في الرَّوْعِ مِنْ بَأْسِهِمْ سَرْدُ",63,"د",1,0],["إِذا دَعا الصاحِبَ يَهيا بِهِ","وَيُتبِعُ اليَهياءَ يَهياءَ",64,"ا",2,0],["إِذا دارَت عَلى قَومٍ رَحانا","تَنادَوا بِالجَلاءِ أَوِ اِستَداروا",65,"ر",3,0],["إِذا دَعانا ذَبَبنا عَن مَحارِمِهِ","ذَبَّ البَنينَ عَنِ الآباءِ أَحشادِ",66,"د",1,0],["إِذا دَنا العَيشُ فَمَعروفُهُ","دانٍ بِعَيشِ القانِعِ المُترِبِ",67,"ب",1,0],["إِذا دَرَجَت في العالَمينَ قَبيلَةٌ","فَخَيرٌ لَها مِن أَن تَئِثَّ خُروجُها",68,"ج",3,1],["إِذا دَفَنَت في الثَرى هالِكاً","تَناسَت عُهوداً لِأَحبابِها",69,"ب",3,0],["إِذا دَنَوتِ لِشامٍ أَو مَرَرتِ بِهِ","فَنَكِّبيهِ وَراءَ الظَهرِ أَو حيدي",70,"ي",1,1],["إِذا دَخَلَ الهِرماسُ جِلَّقَ والِياً","فَما كَذَبَت فيما تَقولُ الهَرامِسُ",71,"س",1,0],["إِذا دُعيتُ لِأَمرٍ عادَني بِأَذىً","أَو رُزءِ دينٍ فَإِبطائي هُوَ السَرَعُ",72,"ع",1,0],["إِذا داعٍ دَعاكَ لِرُشدِ أَمرٍ","فَلَبِّ وَلا يَفُتكَ لَهُ اِتِّباعُ",73,"ع",1,1],["إِذا دارَتِ الكَأسُ في دارِهِم","فَقَد رَحَلَ الدينُ عَن دارِهِم",74,"م",1,1],["إِذا دَخَلُوا بُيُوتَهُمُ أَكَبُّوا","عَلى الرُّكباتِ مِن قِصَرِ العِمادِ",75,"د",1,0],["إِذا دَنا حَتفي","تَزول أَسقامي",76,"ي",1,0],["إذا دعا علجاً حال بينهما","أظمى تفارق منه أختها الضّلع",77,"ع",1,0],["إذا داعبَ الماءُ ظلّ الشَّجرْ","وغازلتِ السُّحبُ ضوءَ القمرْ",78,"ر",1,1],["إذا دعا بوجهه مشيراً","نحو السماء استقبل البشيرا",79,"ر",2,0],["إِذَا دَعَا الصِّدْقُ لَبَّى طَيِّعاً وَإِذَا","دَعَتُ مُصَانعَةٌ يوْماً عتَى وجفَا",80,"ف",2,0],["إِذَا دَبَّ خُلفٌ مُوهِنٌ فِي جَمَاعَةٍ","أَيُبْلِغُهَا أَدْنَى الأَمَانِيِّ قَائِدُ",81,"د",1,0],["إذَا دَعَاهُ صَرِيخٌ كَانَ دَعْوَتَهُ","وَإنْ دَعَتْهُ دَوَاعِي الذُّعْرِ لَمْ يُجِبِ",82,"ب",1,0],["إذا دَعَا الحقُّ لبَّتْهُ جحافِلُنا","وإن سَطَا الجَوْرُ ردَّتهُ مَواضِينا",83,"ن",2,0],["إذا دَجَت الحوادث؛ فاستضيئي","بنور اللهِ في الليل البَهِيم",84,"م",1,0],["إذا دعانا ذببنا عن محارمه","ذب البنين عن البنين عن الآباء أحشاد",85,"د",1,0],["إذا دَبَرَانٌ مِنْكِ يَوماً لَقِيتُهُ","أؤمِّلُ أنْ ألقاكِ بعدُ بأسعُدِ",86,"د",1,0],["إذا دَمَعَتْ عَيْناكَ وَالشّوْقُ قائِدٌ","لذي الشّوْقِ، حتى تَستَبِينَ المُكَتَّما",87,"م",2,1],["إذا درجت فيه السّمال تتابعت","ذوائبهُ حتى تقول غدير",88,"ر",1,0],["إذا داهمتها لم تفدها ضراعة ٌ","ولو خر عاتبها على الأرض يسجد",89,"د",1,0],["إذ أدبروا فعلمنا في ظهورهم","ما تعمل النار في الحلفي فتحترقُ",90,"ق",1,0]]}