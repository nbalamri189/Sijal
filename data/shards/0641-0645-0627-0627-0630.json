{"poems":[[53,"يا سيدا لم تزل فروع","https://www.aldiwan.net/poem65943.html","مخلع البسيط"],[48,"ليشغلك ما أصبحت مرتقبا له","https://www.aldiwan.net/poem22055.html","الطويل"],[108,"آهة طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=179661",""],[376,"وراءك إن زندك غير واري","https://www.aldiwan.net/poem57454.html","الوافر"],[463,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[558,"أدهرا تولى هل نعيمك مقبل","https://www.aldiwan.net/poem68391.html","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89424","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91717","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[5002,"عودة الحنين...","https://www.poetsgate.com/ViewPoem.aspx?id=212601",""],[5628,"زهور ذابلة","https://www.poetsgate.com/ViewPoem.aspx?id=178513",""]],"verses":[["فما إذاً سادة الندامى","إلا البلاليعُ والفُيولُ",0,"ل",1,0],["فَما أَذنَبَ الدَهرُ الَّذي أَنتَ لائِمٌ","وَلَكِن بَنو حَوّاءَ جاروا وَأَذنَبوا",1,"ب",3,0],["فما أذبَلَ الداءُ وردَ الخدودِ","ولا أطفأَ السُّقم نورَ الجبين",2,"ن",1,0],["فما أذكيتَ نارَ اللوم لَّما","بكرتَ عليَّ بل أذكيتَ ناري",3,"ر",2,0],["فما أذمَّ الحظَّ إلا قمتَ لي","بمنّةٍ تكسبه أَحمادي",4,"د",2,0],["فَما أَذكُرُ اللَذاتِ إِلّا كَأَنَّما","يُمَثِّلُها لي في النَدِيِّ مُمَثِّلُ",5,"ل",1,0],["فما أذن العلا تصغي لشادٍ","إذا صهل الأصم لك الصفي",6,"ي",1,0],["فما أَذكر اللقيا التباعد للنهى","وَما أَدنى تفريق لتذكار جامع",7,"ع",1,0],["فَما إِذا هُوَ واقيهِم بِمَنعَتِه","مِنَ الأَعدي إِذا كَرّوا وَإِن حَمَلوا",8,"ل",3,0],["فَما أذْنبوا حينَ قالوا سَئِمنا","منَ الذُّلِ والعِز ُّ فينا خَصِيبُ",9,"ب",1,0],["فما أذْهل القلبَ وَقْعُ الصعابِ","ولكنَّ غدْرَكِ قدْ أذْهَلهْ",10,"ل",2,0]]}