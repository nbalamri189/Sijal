{"poems":[[65,"ألا من لنفس لا تزال مشيحة","https://www.aldiwan.net/poem46142.html","الطويل"],[95,"أريه وجه مبتسم","https://www.aldiwan.net/poem11400.html","مجزوء الوافر"],[90,"لقد جمع الشيخ هذي الكتب","https://www.aldiwan.net/poem44432.html","المتقارب"],[90,"تبلج أفق الشرق من بعدما اغبرا","https://www.aldiwan.net/poem44824.html","الطويل"],[72,"أحدثه إذا غفل الرقيب","https://www.aldiwan.net/poem43023.html","الوافر"],[94,"ما قدس المثل الأعلى وجمله","https://www.aldiwan.net/poem38909.html","البسيط"],[80,"أرية أنت فائدة الزمان","https://www.aldiwan.net/poem14271.html","الوافر"],[91,"أعاشر قوما عندهم لي عداوة","https://www.aldiwan.net/poem45081.html","الطويل"],[63,"أرى همة تختال بين الكواكب","https://www.aldiwan.net/poem51785.html","الطويل"],[107,"ألا لا أرى في مصر إلا دعاويا","https://www.aldiwan.net/poem43396.html","الطويل"],[48,"لقد برحت طير ولست بعائف","https://www.aldiwan.net/poem22279.html","الطويل"],[48,"لقد كرمت عليك فتاة قوم","https://www.aldiwan.net/poem23402.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39592","الهزج"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43890","الطويل"],[108,"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[92,"الوطن والشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179071",""],[94,"أرى هيكلَ الأيامُ، مشيَّداً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14596&r=&rc=41",""],[173,"إلى كم مناجاة الهموم العوازب","https://www.aldiwan.net/poem1604.html",""],[173,"طما بحر الهموم به فمادا","https://www.aldiwan.net/poem1620.html",""],[190,"أحل دمي الظبي الغرير تعمدا","https://www.aldiwan.net/poem43311.html","الطويل"],[208,"لقد توقفت لو أن الهوى وقفا","https://www.aldiwan.net/poem53240.html","البسيط"],[275,"تغنيت بالأشعار عند المخاوف","https://www.aldiwan.net/poem35640.html","الطويل"],[409,"تشابه حالنا في كل فن","https://www.aldiwan.net/poem33386.html","الوافر"],[409,"عسى توبة تمحى بها كل زلة","https://www.aldiwan.net/poem34112.html","الطويل"],[409,"خليلي هبا فالنسيم بكم هبا","https://www.aldiwan.net/poem34164.html","الطويل"],[422,"أرى هذي النياق لها حنين","https://www.aldiwan.net/poem53913.html","الوافر"],[422,"هو البرق مما راعها وشجاها","https://www.aldiwan.net/poem54106.html","الطويل"],[463,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[463,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[469,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[482,"ليبجح الدهر لما ردني جزعا","https://www.aldiwan.net/poem15210.html","البسيط"],[510,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[411,"","https://poetry.dctabudhabi.ae/diwan/poem/30574","الهزج"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122594","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122739","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38090","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145943","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62497","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79949","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/199440","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201003","الطويل"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/106477",""],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87381","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74059","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62777","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91703","الوافر"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142948","الوافر"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117319","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57980","الوافر"],[4755,"هَدِيرٌ على الأَطلالِ","https://www.poetsgate.com/ViewPoem.aspx?id=207775",""],[4836,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=205524",""],[5135,"خَيلُ البشائر","https://www.poetsgate.com/ViewPoem.aspx?id=201871",""],[5183,"حائم المنية","https://www.poetsgate.com/ViewPoem.aspx?id=180264",""],[5183,"المستميت على الأوطان","https://www.poetsgate.com/ViewPoem.aspx?id=180173",""],[5190,"عندليب البيان","https://www.poetsgate.com/ViewPoem.aspx?id=56113",""],[5362,"أرى هذي العصا خضراء تزهو","https://www.poetsgate.com/ViewPoem.aspx?id=170348",""],[5628,"زفرة على نعش غسان كنفاني","https://www.poetsgate.com/ViewPoem.aspx?id=178759",""],[5642,"مُذكرات طفل سوري","https://www.poetsgate.com/ViewPoem.aspx?id=131268",""],[5913,"في غاية الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=177074",""],[5913,"بئر الناس","https://www.poetsgate.com/ViewPoem.aspx?id=183199",""],[5992,"أرى هالةَ البدر وَسْطَ السماءِ","https://www.poetsgate.com/ViewPoem.aspx?id=41830",""]],"verses":[["أرى هِمّتي هَمّاً تَخَوَّنَ مُهْجَتي","فَقُلْ يا شَقيقَ النّفْسِ لي ما شِفاؤُها",0,"ا",3,0],["أُريهِ وَجْهَ مُبْتَسِمِ","وَأُخْفِي فِي الحَشَى ضَرَمِي",1,"م",2,1],["أرى هؤلاء ضعاف العقو","ل وإن قد نراهم غلاظ الرقب",2,"ب",1,0],["أرى هَبوة سوداء في الجوّ أسبلت","حجاباً بآفاق العراقَيْن مُمترّا",3,"ر",2,0],["أَرى هَذا الجَمالَ دَليلَ خَيرٍ","يُبَشِّرُني بِأَنّي لا أَخيبُ",4,"ب",1,0],["أَرى هيكَلَ الأَيَّامِ يعلُو مُشيَّداً","ولا بدَّ أن يأتي على أُسِّهِ الهَدْمُ",5,"م",1,0],["أُريَّة أَنتِ فائِدَةُ الزمانِ","فَقَد فُقتِ المَمالِكَ في مَعانِ",6,"ن",1,1],["أريهم بنصحى وجهة الحق مثلما","تريك عيانا صورة الشيء مرآة",7,"ه",1,0],["أرى هِمَّةً تختالُ بينَ الكواكبِ","وطَوْداً من العلياء صعْبَ الجَوانبِ",8,"ب",1,1],["أَرى هِمَماً يَعصِفَنَّ بِالنَجمِ رِفعَةً","وَهُنَّ جِثِيٌّ ما رَفَعنَ النَواصِيا",9,"ي",2,0],["أَرى هَذَياناً طالَ مِن كُلِّ أُمَّةٍ","يُضَمَّنُهُ إيجازُها وَشُروحُها",10,"ح",3,0],["أَرى هَرِماً يُعيدُ نَباتَ نَبعٍ","وَإِن كانَ الصَليبُ كَنَبتِ هَرمِ",11,"م",1,0],["أريها مَوضِعَ السَّهْ","مِ الذي سدَّدهُ الرَّامي",12,"ي",1,0],["أريّةُ مرعايَ المَرِيعُ وأَيْنُقي","وأَنتِ اِبنَةٌ فِي عِصمةِ ابنِ عِياضِ",13,"ض",1,0],["أرى هرمًا في بهو فرعون هاويًا","ومازالت الأهرام شمًّا كما هيا",14,"ي",2,1],["أريهم واجبَ الوطنِ المفدَّى","لكيما يُحسنوا عنه الجهادا",15,"د",2,0],["أريهمْ أننا بالعلم ننمو","كما ينمو الثرى سُقِي العهادا",15,"د",2,0],["أريهم أننا نبغي رجالاً","نسود بها الممالك لا سوادا",15,"د",2,0],["أرى هيكلَ الأيامُ، مشيَّداً","ولا بدَّ أنْ يأتي على أُسِّهِ الهَدْمُ",16,"م",1,1],["أَرى هِمَّتي لا تَقتَضيني سِوى العُلى","وَلَيسَ العُلى دونَ النُّجومِ الثَواقِبِ",17,"ب",1,0],["أُريهِم مَنطِقاً عَيّاً وَإِنّي","لَأُفحِمُ في بلاغَتِهِ زِيادا",18,"د",2,0],["أريه انحرافا عنه والقلب عنده","يراعيه إشفاقا إلى حيث يمّما",19,"م",2,0],["أرى هواي جليلاً في لطافته","كمثل جسمك فيما جلَّ أو لطفا",20,"ف",2,0],["أرى هذه الأبياتَ أرماقَ مُهجتي","وفي كلِّ بيتٍ دَمعُ آسٍ وآسف",21,"ف",1,0],["أرى هذا عقوبة ما تقضَّى","من التقصير عن شكر لمن",22,"ن",1,0],["أرى هذه الأعمار أحلام نائم","ولذتها طيفاً ألمَّ بمقلتي",23,"ي",1,0],["أرى هذه الدنيا تَصيَّدُ أهلَها","فكم نصبتْ فيهم حبائِلَها نَصْبَا",24,"ب",2,0],["أرى هذي النياقَ لها حنينٌ","إلى إلْفٍ لها ولها رُغاءُ",25,"ا",2,1],["أرى هذه الدُّنيا لمن ذلّ أصبحَتْ","ذَلولاً ولو كانَ الأَبيُّ أباها",26,"ا",3,0],["أريها نُدوبي كي ترِقَّ وأشتكي","إليها فلا تأوي بعينٍ ولا أذْنِ",27,"ن",1,0],["أُرِيهم بأني ثابتُ الريش ناهضٌ","وتحت جَناحي جانفاتُ المخالبِ",28,"ب",1,0],["أريهم بأقمار السماء صبابةً","وبلواي أقمارُ الديار الأوافل",29,"ل",1,0],["أُريهِ منّي إذا ما هاجَني أسداً","صعبَ العريكةِ لللأْواءِ ما خَضَعا",30,"ع",2,0],["أرىْ هلاليْنِ فوْقَ نُوريْ","نِ قامَ تحْتَهُما صليبُ",31,"ب",1,0],["أرى هذي المقاديرَ","على المَكروهِ تجري بي",32,"ي",1,1],["أرَى هِمَّتي لا يَنقَضي لي حاجَةٌ","إذا لَم تَكُن عِندَ العُيلي أحمد",33,"د",1,0],["أرَى هِمَتّي تَأبَى السُّؤالَ وَفَضلُها","عَلَى غَيرِها مِن أحمَدٍ وَسُؤالِهِ",34,"ل",2,0],["أَرى هَذِهِ الدُّنيا مِنَ الإِنسِ ما بِها","سِوى جاهِلٍ عاتٍ لَئيمٍ وَعابِثِ",35,"ث",1,1],["أرَى هَذهِ الأرضَ مَحنيِّةً","وألفُ حضيضٍ بها عالقُ",36,"ق",1,0],["أريه الدُرَّ من عيني","فيبدي البرق من فيه",37,"ي",2,0],["أريهم بأنِّي عن دهاهم مغفلٌ","وعندي لهم خبٌّ من العزم رادع",38,"ع",1,0],["أرى هذه تفنى ويفنى متاعها","ويأبى عليها الناس إلا تفانيا",39,"ي",2,0],["أريهم نقود الشعر لا يقبلونها","يقولون هذا نقد سوق عكاظ",40,"ظ",1,0],["ارى هذه الدنيا على كل خير","تجود وان والته وان باللفظ",41,"ظ",1,1],["ارى هَذِهِ الدنيا فتُخدَشُ مقلَتي","كأَنَّ شِعاعَ الشمس تبلُ مُذَرِّبِ",42,"ب",1,0],["أَرى هياماً بكلّ واد","وَلست أَسطيع أَن أَهيما",43,"م",2,0],["أرى هِمَمَ المرءِ اكتئاباً وحسرةً","عليه إذا لم يُسْعِدِ اللهُ جدَّهُ",44,"د",2,0],["أَرى هذا أُخَيّ وَذا حَبيبي","وَكُلٌّ بِالهَنا نَحوي يشير",45,"ر",1,0],["أرى هذر الكلام المحض غثاً","فيردعني عن الغث السمين",46,"ن",1,0],["أرى همم الألباب تصرف للدنا","وترتاح للرحات فيها وللهنا",47,"ن",2,0],["أرى هذا الزمانَ عَدَا علينا","وإن عَادَى زمانك لا يحابي",48,"ب",2,1],["أَرَى هَجْمَةً أُخرَى,وأُخرَى, كَأَنَّمَا","على الرُّوحِ قَبلَ العَينِ تُلْقَى القَذَائِفُ",49,"ف",1,0],["أرى هالةً من حَنانٍ ندي","يَزيدُ المحبةَ بين الجُدُر",50,"ر",1,0],["أرى هذي الْمساجدَ عامراتٍ","تُمَرَّغُ في جوانبها الْجباهُ",51,"ا",2,0],["أرى هذه الدنيا سبيلا لسالك","فكل إلى قصد له هو قادم",52,"م",1,0],["أريه وجهي فلا يلوي على مقتي","حتى أجيش فيرعى ذمتي رهبا",53,"ب",2,0],["أَرَى \"هِندَ\" تَحكِي ، و\" زِيشانَ\" تَبكِي","و\"دَعدٌ\" تريق دَماً أسودا",54,"د",2,0],["أرى هذي العصا خضراء تزهو","أهل لبست ثيابا سندسيه",55,"ه",1,1],["أريهم أنّ في النيرانِ طُهْرا ً","لأنفسهمْ وفي الأفياءِ عارا",56,"ر",2,0],["أرى هذا ولا يرآهُ ذاكَ العالمُ الأعمَى","لأنَّ الظُّلمةَ احتلَّتْهُ لمَّا ساندَ الظُّلْما",57,"م",2,0],["أرى هي الحسن لا حسن سواه ومن","قالوا حوى الكون حسناً غيرها كذبوا",58,"ب",3,0],["أرى هكذا الدنيا قصيرٌ طويلُها","طريقٌ وكلٌ في الذي يشتهي مشى",59,"ش",2,0],["أرى هالةَ البدر وَسْطَ السماءِ","وسيفَ الدجى قابلاً دوسهُ",60,"ه",1,1]]}