{"poems":[[44,"يقول الأرذلون بنو قشير","https://www.aldiwan.net/poem50350.html","الوافر"],[88,"أجل هذه أعلامه ومواكبه","https://www.aldiwan.net/poem10687.html","الطويل"],[90,"يدل على لؤم الغزالة أنها","https://www.aldiwan.net/poem44409.html","الطويل"],[87,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[47,"تظن شجوني لم تعتلج","https://www.aldiwan.net/poem62675.html","المتقارب"],[54,"ألم تعلم بما صنع الفراق","https://www.aldiwan.net/poem26808.html","الوافر"],[69,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10269","المنسرح"],[108,"كأس تفيض","https://www.poetsgate.com/ViewPoem.aspx?id=179509",""],[154,"اعد ذكر خير الخلق فالعود أحمد","https://www.aldiwan.net/poem68577.html","الطويل"],[154,"ألا ليت شعري هل أسيرن منجدا","https://www.aldiwan.net/poem68594.html","الطويل"],[190,"أيا مازحا بالشر أقصر","https://www.aldiwan.net/poem43288.html","الوافر"],[203,"لكل فتى من الدنيا كمال","https://www.aldiwan.net/poem45676.html","الوافر"],[214,"يا مانحي طيب مواعيده","https://www.aldiwan.net/poem13550.html","السريع"],[226,"أتستقبل الدهر مستبشرا","https://www.aldiwan.net/poem55293.html","المتقارب"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[276,"سمعت سويجع الاثلاث غنى","https://www.aldiwan.net/poem52085.html","الوافر"],[276,"عسى من خفي اللطف سبحانه لطف","https://www.aldiwan.net/poem52135.html","الطويل"],[287,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[325,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[353,"لا تأخذن عنها السروج واللجم","https://www.aldiwan.net/poem20682.html","الرجز"],[358,"نداماي هيا بي إلى الروضة الغنا","https://www.aldiwan.net/poem39776.html","الطويل"],[358,"قلوب الورى في مطمح الفكر قلب","https://www.aldiwan.net/poem40825.html","الطويل"],[382,"أمكرديج زد فضلا","https://www.aldiwan.net/poem59380.html","مجزوء الوافر"],[422,"لفقدان عبد الواحد الدمع قد جرى","https://www.aldiwan.net/poem54022.html","الطويل"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[445,"تبلج عن إشراق غرتك الصبح","https://www.aldiwan.net/poem34816.html","الطويل"],[445,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[445,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[457,"إِذا ما مضى للمرء يوم من البشر","https://www.aldiwan.net/poem13763.html","الطويل"],[463,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[463,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[463,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[463,"ذكرت وما وفاي بحيث أنسى","https://www.aldiwan.net/poem56157.html","الوافر"],[466,"جزى الله غمر الجود من آل هاشم","https://www.aldiwan.net/poem15645.html","الطويل"],[468,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[511,"تأن في الأمر لا تكن عجلا","https://www.aldiwan.net/poem2445.html","المنسرح"],[563,"في كل جنس من الأجناس معلوم","https://www.aldiwan.net/poem34094.html","البسيط"],[591,"كم شمل صبر هجركم فرقه","https://www.aldiwan.net/poem17625.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138215",""],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102038","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87207","الطويل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18520","الطويل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59741","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105456","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138113",""],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145106","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144159","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46702",""],[1901,"","https://poetry.dctabudhabi.ae/diwan/poem/216574","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48199","البسيط"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42489","الطويل"],[2087,"","https://poetry.dctabudhabi.ae/diwan/poem/104435","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89543","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53125","الرجز"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121913","الطويل"],[2360,"","https://poetry.dctabudhabi.ae/diwan/poem/119152","المنسرح"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93619","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93563","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137082",""],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129843","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83235","المتقارب"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94287","المتقارب"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109789","الطويل"],[2934,"","https://poetry.dctabudhabi.ae/diwan/poem/205193","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204901","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204480","الوافر"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112364","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74104","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48454","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48442","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48327","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108110","الوافر"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45815","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91189","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91374","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133311","البسيط"],[3916,"","https://poetry.dctabudhabi.ae/diwan/poem/122212","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78308","البسيط"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106731","الطويل"],[129,"","https://poetry.dctabudhabi.ae/diwan/poem/203066","المتقارب"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83190","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58019","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139554",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139553",""],[4767,"مجنون العرب","https://www.poetsgate.com/ViewPoem.aspx?id=178506",""],[4843,"مسبّحٌ من لهُ في الخلقِ آياتُ","https://www.poetsgate.com/ViewPoem.aspx?id=142689",""],[4940,"سهام الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=210455",""],[4984,"دوامة الفتن","https://www.poetsgate.com/ViewPoem.aspx?id=180639",""],[4984,"تظن وفي بعض الظن","https://www.poetsgate.com/ViewPoem.aspx?id=215389",""],[585,"بلغنا من الآمال ما كان قاصيا","https://www.poetsgate.com/ViewPoem.aspx?id=161842",""],[5111,"حُرَّة","https://www.poetsgate.com/ViewPoem.aspx?id=212373",""],[5397,"تخادعك الدنيا وتبدي اغترارها","https://www.poetsgate.com/ViewPoem.aspx?id=157907",""],[5449,"عن القصيدة الفاضلة","https://www.poetsgate.com/ViewPoem.aspx?id=188871",""],[5736,"تساقط","https://www.poetsgate.com/ViewPoem.aspx?id=208235",""],[6082,"كنّا صغارا","https://www.poetsgate.com/ViewPoem.aspx?id=61277",""]],"verses":[["فَكَم رَشداً أَصَبتُ وَحُزتُ مَجداً","تَقاصَرَ دونَهُ هامُ الثُرَيّا",0,"ي",2,0],["فَكَم رُعتَ جَبّاراً وَأَرهَقتَ ظالِماً","وَأَنصَفتَ مَظلوماً تَوالَت مَصائِبُه",1,"ب",2,0],["فكم راع نومي عند كل صبيحة","طنين ذبابات توالى وقوعها",2,"ع",3,0],["فكم ركبت للمعا","صى متن ليل أدهم",3,"م",1,0],["فَكَم رَوضَةٍ بِفِناءِ الرَبي","عِ يُضاحِكُها البَرقُ مِن كُلِّ فَج",4,"ج",1,0],["فَكَم رَدَّ الأَعِنَّةِ مِن جُموحٍ","وَرَدَّ دموعُ حُزنٍ لا تُطاقُ",5,"ق",1,0],["فَكَمْ رَكِبُوا لِخِدْمَتِمْ نهاراً","ولَيْلاً يَسْأَلُونَ وَيَضْرَعُونا",6,"ن",2,0],["فَكَم رَأَينا في الدَهرِ مِن أَسَدٍ","بالَت عَلى رَأسِهِ ثَعالِبُهُ",7,"ه",1,0],["فكم رصد الأفلاكَ في مصر أكمهٌ","وزلزل أعوادَ المنابر أبكم",8,"م",1,0],["فَكَم راحَ في ذاتِ الإِلَهِ وَكَم غَدا","يَقودُ منِ اِستَعصى وَيَقمَعُ مَن عَدا",9,"د",2,0],["فَكَم رُتبَةٍ في المضجدِ حازَ سَنيَّةٍ","بإِصلاحِ أَعمالٍوَإِخلاصِ نيَّةٍ",10,"ه",1,0],["فكم رام رمى كلبا فعادت","رميّتهُ إلى عين كريمه",11,"م",2,0],["فكم رجلٍ ترى فيهِ صبياً","وكم من صبْيةٍ وهمُ رجالُ",12,"ل",1,0],["فكم روت يمناك لي عن عطا","وحدثت في الجود عن سهل",13,"ل",1,0],["فكم رفع الصوت مستنجداً","لقومي وللحق مستنصرا",14,"ر",2,0],["فكم رغبوتٍ كان من رهبوتِها","لدن خشعت أبصارُ أهل القطيعة",15,"ه",1,0],["فَكَم رفعت لهم همم العَوالي","مَراتب في عراص النجم تبنى",16,"ن",2,0],["فَكَم راحَ روح اللَه في خلقه وَكَم","غَدا قبل أَن يرتد لِلناظر الطرف",17,"ف",1,0],["فَكَم رَوضَةٍ وَغَديرٍ بِها","وَقَد صَفَّقَت مَتنَهُ الريحُ صَفقا",18,"ق",2,0],["فَكَم رَفيقٍ بِإِبهامٍ يُبينُ صَفا","وَهوَ الحَميمُ الَّذي تَسلى مَوَدَّتُهُ",19,"ت",2,0],["فَكَمْ رَأَيْنا مِن بَناتِ مَاءِ","مُضَرَّجَاتٍ ثَمَّ بِالدِّماءِ",20,"ا",2,0],["فَكَم رفعة قَد نالَها غَير جاهِدٍ","فَأَكسَبَها عزّاً وَكانَ لَها حِصنا",21,"ن",2,0],["فَكَم راحة لِلناس مِنهُ بِراحَةٍ","بِها لِلظما وَالجوع زادٌ وَمَشرَبُ",22,"ب",1,0],["فكم راسٍ به راسٍ","وليس الراسِ كالراسِ",23,"س",1,0],["فكم راغب فيها وكم طامع بها","أمدَّ لها الباعَ الطويلَ فقصَّرا",24,"ر",2,0],["فكم راكب فوق الكُمَيْتِ وسابقِ","بحَلبَة مجراه غدا غيرَ لاحق",25,"ق",1,0],["فَكَمْ رَوَّعَتْ لِلْغَيِّ فِي عُقْرِ دارِهِ","حِمىً لَمْ يُرَعْ من قَبْلِهِنَّ لَهُ سَرْحُ",26,"ح",1,0],["فكمْ رَأْسِ كُفْرٍ قَدْ أَنافَتْ بِرَأْسِهِ","من الصَّرْعَةِ السُّفْلى إِلَى الصَّعْدَةِ العُلْيا",27,"ي",2,0],["فكَمْ رَحَّبَتْ أَرْضُ العِراقِ بمقدمي","وأَجْزَلَتِ البُشْرى عَليَّ خُراسانُ",28,"ن",1,0],["فكم رِفقة قد أحكموا عقد أنسهم","به وتجلّوا بالطلاقة والبشْر",29,"ر",1,0],["فكم راحةٍ بيضاءَ ثَمَّ وسَحنةٍ","ترى الرزقَ في صِفاحِها وابتسامِها",30,"م",3,0],["فكم راش مثلُك مثلي فطار","وإن كان مثلك لا يفعلُ",31,"ل",1,0],["فكم رِحمٍ ثَمَّ مقطوعةٍ","ولو ربَّها الحزمُ لم تُقطَعِ",32,"ع",1,0],["فكم رَدَّتْ نُيوبَ الدهر دُرداً","يداهُ وقد فغرنَ إليَّ نهسا",33,"س",2,0],["فكم راح يولي نعمةً بعد نعمةٍ","كصوبِ غَمامٍ ما تَغِبُّ نوافِلُهْ",34,"ل",2,0],["فكم ركبوا البحار وكابدوها","وان كانت تروع أو تخيف",35,"ف",1,0],["فكم رَجاهُ فنالَ بغيتَه","عبدٌ مسيءٌ بنفسه كادا",36,"د",2,0],["فكم رأيت أناساً لا خلاق لهم","وظالماً ظاهراً في زيِّ مظلوم",37,"م",1,0],["فَكَمْ رَنَا طَرْفُ عَليلٍ بِكُمْ","وَكَمْ ترَكْتُمْ مُهْجَةً شَيِّقَهْ",38,"ق",2,0],["فكم ربات علم حاصنات","رأيت وفاضلات طاهرات",39,"ت",1,0],["فكم راضه للرشد رأي مسدد","فيستن في الغن استنان الشوامس",40,"س",1,0],["فَكَم رام سلواني وَعيّي بِلومه","وَلَكن هُدى دين المَحبة يَأباه",41,"ا",2,0],["فَكَم رَدَّ مِن ذي حاجَةٍ لا يَنالُها","جَديعُ العَتيكِ رَدَّهُ اللَهُ أَبرَصا",42,"ص",2,0],["فَكَم رَأَينا من بَدائِع بِها","وَمن صَنائِع وَمِن عَجبها",43,"ه",2,0],["فكم راعتِ الأهوالَ مني عزائم","وعهدٌ بكرّات الخطوب وثيق",44,"ق",1,0],["فكم رفعت فيها مصابيح للقرى","نضا ضوؤها صبغ الدجنة للساري",45,"ر",2,0],["فكم رقصت شهب السماء لحسنكم","وحياكمو بين الغصون رشيق",46,"ق",1,0],["فكم رأت فيه من الأهوال","والنُّوَب الفظيعة الثقال",47,"ل",1,0],["فكم رأيت في الهوى","أسود من ذا ونصل",48,"ل",1,0],["فكم رأينا قبلَها","أسودَ من ذا ونَصَل",49,"ل",1,0],["فكم رجالٍ أولي عِزًّ ومكرمةٍ","هانوا ولولا اعتزازُ الحبِّ ما هانوا",50,"ن",3,0],["فكم رؤوسٍ تهاوَتْ من قواضِبِه","دماً يُفَجَّرُ من خيشومِها التَّرِبِ",51,"ب",1,0],["فكم رمتُ أن أسعى إليكَ مُهرِولاً","وبي مِن جوى الأشواقِ ما يسلبُ اللُّبا",52,"ب",2,0],["فكم رماني بسهم النائبات وكم","صبرت والصبر حقا أمنع الجنن",53,"ن",1,0],["فَكَم رَفَعتُم جُدوداً قَبلُ عاثِرَةً","وَكم غَمَرتُم بَني الحاجاتِ بِالنِعَمِ",54,"م",1,0],["فكم رفعت قدر آمالي إذا","ما سقطت منك على الخبير",55,"ر",1,0],["فكم روضة للهو غناء غضة","بها الغيد أزهار لها كنت جانيا",56,"ي",2,0],["فكم رأينا في الدهر من أسد","بالت على رأسه ثعاليه",57,"ه",1,0],["فَكَم رَكضت بِالبَغي رَجل قَبيلة","وَما راكض بِالبَغي إِلّا وَيعثر",58,"ر",1,0],["فَكم رَد عَنكَ اللَه كيد حَواسد","وَما ضرت اللَيث الكِلاب النَوابح",59,"ح",1,0],["فكم رددت سهام الدهر طائشة","عنا ولولاك اصبحنا له هدفا",60,"ف"