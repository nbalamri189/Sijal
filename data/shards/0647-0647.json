{"poems":[[93,"ههنا من بني المدور ثاو","https://www.aldiwan.net/poem11184.html","الخفيف"],[93,"يا أميراً دعا ومن لا يلبي","https://www.aldiwan.net/poem11287.html","الخفيف"],[93,"أنا في الروض ساهر وهو نائم","https://www.aldiwan.net/poem11410.html","الخفيف"],[91,"هذه ملفرد قد لاحت رباها","https://www.aldiwan.net/poem62802.html","عموديه"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[92,"كل ما هب وما دب وما","https://www.aldiwan.net/poem38957.html","الرمل"],[85,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[31,"راح صحبي ولم أحي النوارا","https://www.aldiwan.net/poem42529.html","الخفيف"],[102,"لم تزل تهجرني منذ سنين","https://www.aldiwan.net/poem32920.html","الرمل"],[102,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85428","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39648","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54919","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54787","الخفيف"],[100,"رسالة إلى صديق في قبره","https://www.poetsgate.com/ViewPoem.aspx?id=183584",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[91,"أم القرى","https://www.poetsgate.com/ViewPoem.aspx?id=53352",""],[31,"رَاحَ صَحبي وَلَمْ أُحَيِّ النَّوارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18873&r=&rc=136",""],[96,"الطريد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66355&r=&rc=31",""],[130,"الطبول الطبول إِنا انتصرنا","https://www.aldiwan.net/poem67451.html","الخفيف"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[200,"كان لي قلب فيا عجبي","https://www.aldiwan.net/poem45139.html","المديد"],[559,"هذه الكائنات أم هي حانه","https://www.aldiwan.net/poem33691.html","الخفيف"],[559,"نحن عن شمس أمره كالشعاع","https://www.aldiwan.net/poem34395.html","الخفيف"],[563,"قف بالعقيق وسل نسيم رياحه","https://www.aldiwan.net/poem52903.html","الكامل"]],"verses":[["هَهُنَا مِنْ بَنِي المُدَوَّرِ ثَاوٍ","كَانَ وَجْهُ الدُّنْيَا وَحُسْنَ الدِّينْ",0,"ن",1,1],["هَهُنَا يُكَرَّمُ الرَّئِيسَانِ لَكِنْ","لِبِلادَيْنِ ذَلِكَ التَّكْرِيمُ",1,"م",1,0],["هَهُنَا أَجْتَلِي مِثَالَيْنِ بَاتَا","فِي سَمَاءٍ صَفَت وَرَاءَ الغَمَائِمْ",2,"م",1,0],["هَهُنَا أَلْتَقِي بِطَيْفِيْ حَبِيبَ","يَّ الدَّفِيْنَيْنِ فِي فُؤَادِي الوَاجِمْ",2,"م",1,0],["هَهُنا أَودَعتُ أَحلامَ الصِبا","أَفَما تَلمَحُ نوراً في ثَراها",3,"ا",3,0],["هَهُنا بَِلأَمسِ في دارَتِها","كُنتُ مِثلَ النَسرِ حُرّاً في ذُراها",3,"ا",3,0],["هَهُنا الإِنسانُ يَلقى ذاتَهُ","هَهُنا لا يَحجِبُ المال الإَِلهَ",3,"ا",3,0],["هَهُنا في خمائل الغابِ تَحْتَ الزَّا","نِ والسِّنديان والزَّيتونِ",4,"ن",1,1],["ههُنَا في قلبيَ الرَّحْبِ العميقْ","يرقُصُ الموتُ وأَطيافُ الوجودْ",5,"د",1,0],["ههُنَا تَعْصِفُ أَهوالُ الدُّجى","ههُنَا تخفُقُ أَحلامُ الورودْ",5,"د",1,0],["ههُنَا تهتُفُ أَصداءُ الفَنا","ههُنَا تُعزَفُ أَلحانُ الخلودْ",5,"د",1,0],["ههُنَا تَمْشي الأَماني والهوى","والأَسى في موكبٍ فخْمِ النَّشيدْ",5,"د",1,0],["ههُنَا الفجرُ الَّذي لا ينتهي","ههُنَا اللَّيلُ الَّذي لَيْسَ يَبيدْ",5,"د",1,0],["ههُنَا ألفُ خِضَمٍّ ثَائرٍ","خالدِ الثَّورَةِ مجهولِ الحُدودْ",5,"د",1,0],["ههُنَا في كلِّ آنٍ تَمَّحي","صُوَرُ الدُّنيا وتبدو مِنْ جديدْ",5,"د",1,0],["هَهُنا تَمشي الجَواري مَرَحاً","وَجَواري الدَهرِ يَمشينَ الخَمَر",6,"ر",1,0],["هَهُنا فَاِحبِسِ البَعيرَينِ وَاِحذَر","رائِداتِ العُيونِ أَن تُستَنارا",7,"ر",2,0],["ههنا نرجسةٌ قبَّلها","عاشق هام بها يُدعى نسيمْ",8,"م",1,0],["ههنا نسوة جياع بلا مأ","وى سترن الجسوم بالأَسمال",9,"ل",1,0],["ههنا أسرة تهاجر والغم","م بديل الأَثاث فوق الرحالِ",9,"ل",1,0],["ههنا مبتلىً بفقد ذويه","ههنا معدم كثير العيال",9,"ل",1,0],["هَهُنا كانَ الشعب يُلفي دَليلا","كُلَّما رام لِلمَعالي وصولا",10,"ل",2,1],["هَهُنا كانَ العلم يَجلو السَجايا","وَيُنير الحجى وَيَهدي السَبيلا",10,"ل",2,0],["هَهُنا في ظلال هذي المَباني","لبس الشرقُ غرة وَحجولا",10,"ل",2,0],["هَهُنا كانَت الحَضارَةُ تَبني","للحكومات في البلاد أُصولا",10,"ل",2,0],["ههنا تحت ظُلَّةِ الغابة الشجرا","ءِ سِرْنا والفجرُ يحنو علينا",11,"ن",2,0],["ههنا يا ابنةَ البحيراتِ والأوْ","دِيةِ الخُضْرِ والرُّبى والجبالِ",11,"ل",1,0],["ههنا عُشُّنا على الشاطئِ المسْ","حورِ نبنِيهِ من غصونِ الغابِ",11,"ب",1,0],["ههُنا يَشعُرُ الجما","دُ ويوحي لمن شعَرْ",12,"ر",1,0],["هَهُنَا أَهْلُنَا وَفِينَا قلُوبٌ","لَمْ تَحُلَ بَيْنَهَا الرُّبَى وَالصَّحَارَى",13,"ر",2,0],["هَهُنَا تَمْلُكُ الْمَهَابَةُ قَلْبِي","لِدُنُوِّي مِنَ الضَّريِحِ الْمُفَدَّى",14,"د",2,1],["هَهُنَا أَشْعُرُ الشُّعُورَ كَبِيراً","بِحَيَاةٍ مِنْ ذَلِكَ الْقَبْرِ تهْدَى",14,"د",2,0],["ههنا عندي غريبات العوادي","عندك الإنصات والهجس الرمادي",15,"د",2,1],["ههنا يرقُدُ من ظَلّوا على","هامِشِ \" التاريخ \" كَلاًّ وعِيالا",16,"ل",2,0],["ههنا الإنسان يلقى ذاته","ههنا لا يحجب المال الإلها",17,"ا",1,0],["هَهُنا فکحْبِسِ البَعِيرَيْنِ وکحْذَرْ","زَائِدَاتٍ العُيونِ أَنْ تُسْتَنارا",18,"ر",2,0],["هة الحقّ في الكوج الحقير فحيّه","وليس بما تزهي هناك المقاصف",19,"ف",1,0],["ههنا ههنا لقد قبَّلَتني","ههنا الصَولجانُ لا بل سِنانُ",20,"ن",1,0],["هَهُنا يتركُ الخليلُ خليلاً","أَينَ ذاكَ الصفاءُ أين الوفاءُ",21,"ا",2,0],["ههنا قلب وحامله","ميت الأمن على حذره",22,"ر",2,0],["ههنا سر نشأةٍ كلُّ عبدٍ","ذاق منه لم يستطع كتمانه",23,"ن",2,0],["ههنا مغرم به قذفته","عنه أشواقه لخير بقاع",24,"ع",1,0],["هَهياتِ لا يَهْدِي ضِياءُ الصُبحِ مَنْ","لا يَهتدي بالضَوءِ من مِصباحهِ",25,"ح",2,0]]}