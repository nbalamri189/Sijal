24273","الرجز"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32416","المنسرح"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70105","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101357","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45036","الكامل"],[5064,"مدُنُ القلب الضّائع","https://www.poetsgate.com/ViewPoem.aspx?id=199173",""],[5701,"قلت يوما لامرئٍ رحّالة","https://www.poetsgate.com/ViewPoem.aspx?id=164631",""],[5937,"لا يُجيدُ الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=211809",""],[5939,"يا حسنا كثيرَ الذنوب!","https://www.poetsgate.com/ViewPoem.aspx?id=138043",""],[5970,"منزل من منازل الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=130577",""],[6202,"أي يوم يكون للشعراء ..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86712&r=&rc=13",""]],"verses":[["ذاهِلٍ مِن فَرطِ ما حَلَّ بِهِ","بَينَ أَترابِكَ يَمشي كَالغَريبِ",0,"ب",1,0],["ذاهِلُ النَفسِ بِالرُأى","عَن حُطامٍ وَذي حُطام",1,"م",1,0],["ذاهِلُ الطَرفِ شارِدُ الفِكرِ لا يَل","مَحُ حُسناً في الأَرضِ إِلّا رَآها",2,"ا",3,0],["ذاهباً بالشياه يجرفها جر","ف وبالزرع وهو في ريعانه",3,"ن",2,0],["ذا هُوَ الجَنا","بُ الَّذي خَصَب",4,"ب",1,0],["ذاهِبٌ في عَمائِرِ الغَرشِ وَالغَو","رِ إِلى مَنكَبٍ زَكَت أَعياصُه",5,"ص",2,0],["ذا هُمومٍ قَلبُهُ في اِشتِغالٍ","وَلَظى أَحزانِهِ في اِشتِعالِ",6,"ل",1,0],["ذاهِبُ الصَوتِ ساعَةَ الأَمرِ وَالنَه","يِ إِذا قَلَّ ثُمَّ هَدرُ الفَنيقِ",7,"ق",1,0],["ذا هَيدَبٍ دانٍ يَحِن","نُ إِلى مَناصِفِهِ قِلاصُه",8,"ص",2,0],["ذاهِبَ اللُبِّ إِلَيها","مُعلِناً بِالزَفَراتِ",9,"ت",1,0],["ذَاهِباً آيِباً يُوَاجِهُ أَوْ يَلوِي","فَصِيحَ الأَدَاءِ فَخْمَ النَّبْرِ",10,"ر",1,0],["ذاهل النفس بالرؤى","عن حطام وذي حطام",11,"م",1,0],["ذا هيدبٍ دانٍ، يحنُّ","إلى مناصفهِ قلاصه",12,"ص",2,0],["ذَاهِلٌ يَاساً فَما مِن مَطلَبٍ","بَعدَ مَا فَاتَ لِمَا كُنتَتَعِد",13,"د",1,0],["ذاهل لا تضمه","حفلات ولا سمر",14,"ر",1,0],["ذا همَّةٍ قد تَناهَت","وتَستَلذُّ الصُّعودا",15,"د",2,0],["ذا همةٍ في ذلةٍ وصِغار","أضحى النبيل الفرد منفصم العرى",16,"ر",2,0],["ذاهِبٌ هذا وهذا","من ضَميرِ الغيبِ قابلْ",17,"ل",1,0],["ذاهِلاً يأكُلُ الطَّعامَ وإنْ ما","يشرَبِ الماءَ فهو شُربُ الغَريق",18,"ق",1,0],["ذا هو القُرُّ هو الضُرُّ هذا الصَ","رُّ هذا الدَّمارُ هذا البَوار",19,"ر",1,0],["ذا هو طرفُ العزِّ إنسانه","وذاكَ راحُ البرِّ يمناها",20,"ا",3,0],["ذاهبة في صببٍ","قادمة من صعد",21,"د",1,0],["ذاهِباً طوراً وَطوراً آيباً","وَالجَوى بَين ذَهاب وَإِياب",22,"ب",1,0],["ذاهباّ في الخيال تترى مجالي","ه على طرفك الكفيف الحزين",23,"ن",1,0],["ذاهباً في العُلا بنفسكَ لا تج","عل شمس الضُّحى لرجلِك نَعْلا",24,"ل",2,0],["ذا هفوات كثرت وعلل","قد ظهرت وبطنت وذا وذا",25,"ذ",2,0],["ذا هَودَةَ لا يُخافُ نَبوَتُها","وَدينُهُ لا يُشابُ بِالريبِ",26,"ب",1,0],["ذا هَيكلٌ للبكر مريم شادهُ","قَومٌ كرامٌ مِن ذُرى لُبنانِ",27,"ن",1,1],["ذا هلال السما لجيدك طوق","ولاذنيك فرقد الشهب شنف",28,"ف",1,0],["ذاهل اللب عناه ما عنى","فالتجا حيث يغاث الملتحي",29,"ي",1,0],["ذا هِمَّةٍ عُليا فَلَسنا دونَهُ","بَل جَدّ في التَحصيل حَتّى أَبصَرا",30,"ر",2,0],["ذاهِبٌ يسألُ عَنْ أرِصفَةٍ","قِطُّها يشبَعُ والإنسَانُ جائِعْ",31,"ع",1,0],["ذاهب بالدين والعقل معا","جارف في سيره كل قوانا",32,"ن",2,0],["ذاهبٌ مذهبَ الطيور ، إذا ما","مات غصنٌ بكى عليهِ نشيدا",33,"د",2,0],["ذا هجرٌ كفانا افتتانا","إحسانًا لقلبٍ لَعوبِ!",34,"ب",1,0],["ذاهب في الصباح يطلب عيشا","آئب في المساء والجسم عان",35,"ن",1,0],["ذاهبات بما يجود سروري","مترعات أسى غزا أحشائي",36,"ا",2,0]]}