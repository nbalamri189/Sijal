.aspx?id=190081",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5150,"أي قلب تملكين ...؟!","https://www.poetsgate.com/ViewPoem.aspx?id=203781",""],[5183,"لن تراني","https://www.poetsgate.com/ViewPoem.aspx?id=180161",""],[5268,"أعوذُ بالحبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=207013",""],[5277,"لعيدنا طعمٌ مختلفٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205780",""],[5431,"أهمي بعشقٍ فيك يكتملُ","https://www.poetsgate.com/ViewPoem.aspx?id=194856",""],[5431,"تحول الشهوة إلى فن....","https://www.poetsgate.com/ViewPoem.aspx?id=207322",""],[5452,"مفتاح (2) ","https://www.poetsgate.com/ViewPoem.aspx?id=120912",""],[5596,"فقيد العلماء والأولياء","https://www.poetsgate.com/ViewPoem.aspx?id=206687",""],[5674,"نبضتي متوقده","https://www.poetsgate.com/ViewPoem.aspx?id=198686",""],[5691,"ليالي شهرزاد","https://www.poetsgate.com/ViewPoem.aspx?id=205893",""],[5736,"أخشى عليك","https://www.poetsgate.com/ViewPoem.aspx?id=208205",""],[5906,"أصالة","https://www.poetsgate.com/ViewPoem.aspx?id=188232",""],[5906,"عدالة جائرة","https://www.poetsgate.com/ViewPoem.aspx?id=188523",""],[5991,"ته على المستهام فيك جمالاً","https://www.poetsgate.com/ViewPoem.aspx?id=116381",""],[6102,"وهم الحب","https://www.poetsgate.com/ViewPoem.aspx?id=185329",""],[6127,"كنز اليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=190114",""],[6280,"لاَمَ في أُمِّ مَالِكٍ عاذِلاكَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27897&r=&rc=52",""]],"verses":[["إِذ تَمَنّونَهُم غُروراً فَساقَت","هُمِ إِلَيكُم أُمنِيَّةٌ أَشراءُ",0,"ا",2,0],["إِذ تَستَبيكَ بِذي غُروبٍ واضِحٍ","عَذبٍ مُقَبَّلُهُ لَذيذِ المَطعَمِ",1,"م",1,0],["إِذْ تُنْثَرُ الشُّهُبُ المُنِيرَةُ مِثْلَمَا","تَنْهَلُّ أَدْمُعُ عَاشِقٍ وَلْهَانِ",2,"ن",1,0],["إذ ترسل النظرات في أطرافها","حيث ابن هند قائم بحيالها",3,"ل",3,0],["إِذ تُوَلّونَ عَلى أَعقابِكُم","هَرَباً في الشَعبِ أَشباهَ الرَسَل",4,"ل",1,0],["إِذ تَرَكوهُ وَهوَ يَدعوهُمُ","بِالنَسَبِ الأَقصى وَبِالجامِعِ",5,"ع",1,0],["إِذ تَمتَطي سُرُحَ اليَدَينِ نَجيبَةً","مَرَطى الجِراءِ خَفيفَةَ الأَقرابِ",6,"ب",1,0],["إذْ تَنَقَّصْتَني بصعلكة الرأ","س سفاهاً فاذَّمَمت غير ذميم",7,"م",1,0],["إذْ تعديتُ لا حياءٌ من اللَّ","هِ نهاني ولا اتِّقاءُ انتقام",8,"م",1,0],["إذ تعجب الهند والديار بنا","ويعجب الناظرون والأهل",9,"ل",1,0],["إِذ تَغَدّى العُلوجُ مِنهُم غُدُوّاً","فَتَعَشَّتهُمُ يَداكَ عِشاءَ",10,"ا",2,0],["إذ تلاقَى بأرضِها الحَطَبُ الجَزْ","لُ ونارٌ يَحُثُّها إعصارُ",11,"ر",1,0],["إِذ تَستَبيكَ بِجيدِ آدَمَ عاقِدٍ","يَقرو طُلوحَ الأَنعَمينِ فَثَهمَدِ",12,"د",1,0],["إذْ تَخْتَفِينَ بلا اهتمامٍ","أو تُسْفِرينَ بلا لِثَامِ",13,"م",1,0],["إذْ تَحْمِلِينَ الشرَّ صابرةً","مِنَ الهُوجِ الطَّغامِ",13,"م",1,0],["إذْ تُسْقِطُ (الهامَةُ) الإصْباحُ يُرْقِصُنا","و(قاسيُونُ) علينا يَنْشُرُ الشَّفَقا",14,"ق",2,0],["إِذ تَستَبيكَ بِمَصقولٍ عَوارِضُهُ","وَمُقلَتَي شادِنٍ لَم يَعدُ أَن شَدَنا",15,"ن",2,0],["إِذ تَبَدَّت لَنا فَأَبدَت أَثيثاً","حَلِكاً لَونُهُ وَجيداً أَسيلا",16,"ل",2,0],["إِذ تَمَنَّيتِ أَنَّني لَكِ بَعلٌ","آهٍ بَل لَيتَني بِخَدَّكِ خالا",17,"ل",2,0],["إِذ تَبَدَّت لي فَأَبدَت","واضِحَ اللَونِ نَحيضا",18,"ض",2,0],["إِذ تَمَشَّينَ بِجَوٍّ مُؤنِقٍ","نَيِّرِ النَبتِ تَغَشّاهُ الزَهَر",19,"ر",1,0],["إِذ تَذَكَّرتُ قَولَ هِندٍ لِتِربَي","ها وَرُحنا نِيَمِّمُ التَجميرا",20,"ر",2,0],["إِذ تَستَبيكَ بِجيدِ آدَمَ شادِنِ","دُرٌّ عَلى لَبّاتِهِ وَشُذورُ",21,"ر",1,0],["إِذ تَستَبيكَ بِمَصقولٍ عَوارِضُهُ","حُمشِ اللِثاتِ تَرى في غَربِهِ شَنَبا",22,"ب",2,0],["إذ تُقسِمونَ بَرأسِ العَيرِ أنّكُمُ","شافَهْتُموهُ فهل شافَهتم الحَجَرا",23,"ر",2,0],["إذ تجْنِبُ الحُصُنَ الجُرْدَ العِتاقَ بها","وإذ تُصَبّحُ أهلَ السّرجِ والجلَب",24,"ب",1,0],["إِذ تَرَكتُ الماءَ فيها","وَشَرِبتُ الخُسرَوِيّا",25,"ي",2,0],["إِذ تَحسَبُ البَدرَ مَنقوصاً لِلَيلَتِهِ","وَلا تَرى الشَمسَ إِلّا دونَها غِيَرُ",26,"ر",1,0],["إِذ تَعاطَينا وَوَهبٌ نائِمُ","بَرَدَ المُزنَةِ يَسقي البَرَدا",27,"د",2,0],["إِذ تَقولينَ جَهرَةً","لَيتَ ذا دامَ سَرمَدا",28,"د",2,0],["إِذ تَستَبيكَ بِمَصقولٍ عَوارِضُهُ","حَمشِ اللِثاتِ عِذابٍ غَيرِ مِملاحِ",29,"ح",1,0],["إِذ تَستَحِبّونَ عِندَ الخَذلِ أَنَّ لَكُم","مِن آلِ جَعدَةَ أَعماماً وَأَخوالا",30,"ل",2,0],["إذ تَواصَوا بِالكَبشِ لَمّا أَحَسُّ","وهُ وقالُوا مَعَ الحِذارِ حَذارِ",31,"ر",1,0],["إِذْ تَسْكُنُ البَيْدَاءُ وَهْناً فمَا","يَنبِضُ إِلاِّ مُهَجُ السَّفْرِ",32,"ر",1,0],["إِذْ تُرَى الأَمْواجُ فِيهِ أَعْرَضَتْ","مالِئاتٍ صَفحَاتِ المَاءِ سِحْرَا",33,"ر",2,0],["إِذْ تَوَلَّى قِيَادَ قَوْمٍ لِحِينٍ","ثُمَّ أَلْقى لِخَصْمِهِ بِالْقِيَادِ",34,"د",1,0],["إِذ تَرومُ الثُرَيّا","في الغُروبِ مَراما",35,"م",2,0],["إذ تلعب الناكة في متنه","ما بين تزليق وتسليق",36,"ق",1,0],["إذ تستبيكَ بمصقولٍ عوارضهُ","حَمْشِ اللَّثاثِ ترى في غربه شنبا",37,"ب",2,0],["إذ تميلين يَمنة ويَساراً","مثلما لاعبت صَباً خيزُرانه",38,"ن",2,0],["أذ تلهَّتْ بمَحزِمٍ منك بُغيا النفس","من أن تستطيع منكِ احتضانه",38,"ن",2,0],["إذْ تبدتْ لنا، فابدتْ أثيثاً،","حالكاً لونه، وجيداً أسيلا",39,"ل",2,0],["أذ تلك في نص حديث النبي","جنة خلدي تحت أقدامها",40,"م",3,0],["إذ تُحَلُّ القُيود","تلكَ نارُ القِرى",41,"ر",2,0],["إِذ تَنادَت يا آلَ قُرَّةَ آسا","دٌ وَنَدَّت كَأَنَّها آرامُ",42,"م",1,0],["إِذ تَفَجَّرتُ بِمَاءٍ","سَلسَلٍ عَذبٍ بَرُودِ",43,"د",1,0],["إذ تتثتَّى جوىً وحسناً","وإذ تجنَّى هوىً وكبرا",44,"ر",2,0],["إِذ تَنادى بِذُلِّ حَيِّ قُرَيشٍ","وَاِبنِ حَربٍ بَذاً مِنَ الشُهداءِ",45,"ا",2,0],["إذ تلاقى الدهر في أمثاله","بخمور رققت كالغزل",46,"ل",1,0],["إِذْ تَسَنَّمَتْ فِي رِعَانِ الْمَعَالِي","وَسِوَاكَ عَنِ الْمَعَالِي نَئِيمُ",47,"م",1,0],["إذ تنجلي عرائسُ الأسماءِ","بحسنها في المشهد الأسماءِ",48,"ا",2,0],["إِذ تَستَبيكَ بِأَصلَتِيٍّ ناعِمٍ","قامَت لِتَفتِنَهُ بِغَيرِ قِناعِ",49,"ع",1,0],["إِذ تزفرُ النارُ مِن غيظٍ وتُسفرُ عن","هولٍ تكادُ بِه الأصلاب تنقصمُ",50,"م",1,0],["إِذ تُحشرُ الأرواحُ طبقَ علومها","وَتُرى الجسومُ بشكلِ فعلٍ تطبعُ",51,"ع",1,0],["إذ تَوالى طُلوعها وأتمَّت","وادلهمَّت فقلتُ إحدَى الدَّواهي",52,"ي",1,0],["إذ تراه بحالةٍ","لا تُجيب المُمَخرِقا",53,"ق",2,0],["اِذ تَيَقَّنتُ اِنَّها","عَن ذُنوبي مُكَفِّرَه",54,"ر",2,0],["إِذ تَوَلَّت جُموعُهُم عَن مَحَلٍ","حَلَّ صَبري وَهاجَ وَجداً رَسيسا",55,"س",2,0],["إِذ تُلاقي مِنَ الصَبابَةِ بَرحاً","وَتُجيبُ الهَوى إِذا ما دَعاكا",56,"ك",2,0],["إذ تصدَّى لمغرم مات صدَّا","وتولَّى حرّ الغرام وولَّى",57,"ل",2,0],["إذ تصدَّيت لأمرٍ لم نجد","قبل علياك له من يتصدَّى",58,"د",2,0],["إذ تذكرين جلاجلاً سرقت","ولقد نسيت الجوع في شهر",59,"ر",1,0],["إِذ ترامى بحب كوثر حتى","سكن الحب قلبه واستخاره",60,"ر",2,0],["إِذ تولى بأمره مهج الخا","دم عند اصطباحه إِسكاره",60,"ر",2,0],["إِذ تَقولينَ لِلوَليدَةِ قومي","فانظُري مَن تَرينَ بالأَبوابِ",61,"ب",1,0],["إذ تظاهرنا يومها باحتجاج","وهو يوم على المحامي عسير",62,"ر",1,0],["إذ تغنيك فوق سجف رقيقٍ","نَغَماتٍ تحبُّها بصوابِ",63,"ب",1,0],["إذ تعيد المجد الؤثل فينا","ويرى كيف ودّنا المقطاع",64,"ع",1,0],["اذ تناجي صبَّها مخمورةً","بالهوى والصبُّ وجداً يسجدُ",65,"د",1,0],["إِذ تَحلّيت بامتداح أَميرٍ","هَوَ في المَجد وَالمَعالي فَريدُ",66,"د",1,0],["إِذ تَقاريرك المُفيدة للأش","ياخ وَالطالبين بَعدك ذخر",67,"ر",1,0],["إذ تجلّتْ للصباحِ غُرَّةٌ","نُورُها مثلُ جَبِينِ ابنِ الحَسَنْ",68,"ن",1,0],["إِذ تدير الكؤوسَ كلُّ هضيم ال","كشح ريّا السوار غَرثى الوشاح",69,"ح",1,0],["إذ تلا مُطَّبَخُ الحِيتان","منها مُشْتَواها",70,"ا",3,0],["إذ تقدمت في الصفوف بشيراً","بانتصار الحياة والإِنسان",71,"ن",1,0],["إِذ تَستَوي عِندك رَأس القاضي","بِرَأسِ كَلبٍ نابح عَضّاض",72,"ض",1,0],["إِذ تَراءَت عَلى البَلاطِ فَلَمّا","واجَهَتنا كَالشَّمسِ تَغشى العُيونا",73,"ن",2,0],["إذ تستحل، وكان ذاك مجرماً،","جلدي وتنزع ظالماً أثوابي",74,"ب",2,0],["إذ تدفقت خطيباً لسناً","قائم الحجة معقود اللواء",75,"ا",2,0],["إذ تنادى الرفاق فليها ببين","مزعجٍ فالجفون بالدمع تجري",76,"ر",2,0],["إِذْ تَسْتَبِي الهَيَّابَةَ المُرَهَّقا","بِمُقْلَتَيْ رِيمٍ وَجِيد أَرْشَقَا",77,"ق",2,0],["إذ تظهرنَّ فعايلاً من هولها","تتحير الأخصام والأضدادُ",78,"د",1,0],["إذ تجلّى من مشرق البيت بدرٌ","يحمل الشمس في عمودِ صباحِ",79,"ح",1,0],["إذ ترقّى به إلى قاب قوسي","ن أو أدنى من الإله تعالى",80,"ل",2,0],["إِذ تَرانِي لَو رَأَتني","عُذَّلِي رَقُّوا لِحَالي",81,"ل",2,0],["إذ تلقونه بغير قلوبٍ","ذهب الخوف بالقلوب ولى",82,"ل",2,0],["إذ تهادى النسيمُ يحملُ شَدواً","رجعته الآفاقُ بالألحانِ",83,"ن",1,0],["إذ تنادوا إلى الرحيل صباحا","يا صباح الرحيل يوم التنادي",84,"د",2,0],["إذ تجلى نوره في آدم","كشف الستر عن الحق المبين",85,"ن",1,0],["إذ تنص الركاب يجرين شوقا","يتخللن بين بيض القباب",86,"ب",1,0],["إذ تصعق الأرواح من وحيه","ولم تجد شيئاً له يستندْ",87,"د",1,0],["إذ تِلكَ مَلزُومَاتُ كَونِ العَبدِ مُح","تَاجاً وَتِلكَ لَوازِمُ النُّقصَانِ",88,"ن",1,0],["إذ تِلكُمُ الألفَاظُ غَيرُ مُفِيدَةٍ","لِلِعِلمِ بَل لِلظَّنِّ ذِي الرُّجحَانِ",88,"ن",1,0],["إذ تَنفِرُ الأسمَاعُ مِن ذَا اللَّفظِ نُف","رَتَهَا مِنَ التَّشبِيهِ وَالنُّقصَانِ",88,"ن",1,0],["إذ تجلى قمر الحسن التمام","من ليالي الشعر في جنح الظلام",89,"م",1,0],["إِذ تَستَبيكَ بِمَيّالٍ لَه حَبَكٌ","وَواضِحٍ زانَهُ اللباتُ وَالجيدُ",90,"د",1,0],["إِذ تَستَغيثُ وما لِنَفسِكَ مانِعٌ","عَبدٌ تَرَدُّدُهُ بِدارِ ضَياعِ",91,"ع",1,0],["إذ تم نظم هذه الأرجوزه","وهي مع اشتمالها وجيزه",92,"ه",1,0],["إذ ترجى من مائهم ري أرض","زادها خلف نوءهم تعطيشا",93,"ش",2,0],["إذ تلوا مولد خير الأنبيا","من سناه نور الكونين",94,"ن",1,0],["إذْ تَبَدَّتْ كالبَدْر بينَ نُجوم","منْ نساء وَقْيْنها أتراب",95,"ب",1,0],["إِذ تَلا تَوراتَهُ أَعظِم بِها","مُنيَةً كانَت لَهُ فَوقَ المُنى",96,"ن",2,0],["إذ توارى يوم نفي ما توارى","وتبدى يوم عود ما تبدى",97,"د",2,0],["إذ تنسمن من خفوق جناحي","في السديم ريح أنسِ",98,"س",1,0],["إذ تجول المدرعات الذواكي","كالمذاكي تبثها الحلبات",99,"ت",1,0],["آذتْكَ عَوداً على بَدءِ محبَّتُهُ","والنُّكْسُ في كل داءٍ واعدُ التَّلفِ",100,"ف",1,0],["آذت الرجل العملاق واعجبا","تلك الجراثيم أعيت طبنا فيها",101,"ي",3,0],["إذ تحمل الجرة مملوءةً","تمشي بها ما ساندتها يدُ",102,"د",1,0],["إذ تجلّى كأنّه ظُلمة الشّعر","تبدّى على نحور العذارى",103,"ر",2,0],["إذ تطردُ الاحلامُ جيشَ الهموم","إذ تنجلي الآمالُ تحت الظلام",104,"م",1,0],["إذ ترَاهُ يذرف الدمع دما","شَرقاً من حزنِه بالعبَرَات",105,"ت",1,0],["إذ تثبت فيه أو تمحو","ما كان لنا من مقدور",106,"ر",1,0],["إِذ تَراهم لَدى الضُّحى عظماءً","قَد أَهابوا وَفي الدُجى سمّارا",107,"ر",2,0],["إذ تجلّتْ من الخُدورِ بدورٌ","فانجلَتْ فيه من دُجاها حَنادِسْ",108,"س",1,0]