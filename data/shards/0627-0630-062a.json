{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[93,"أرأيت صوغ الدر في العقيان","https://www.aldiwan.net/poem11278.html","الكامل"],[88,"عندي حديث عن دمشق فأنصتوا","https://www.aldiwan.net/poem44802.html","الكامل"],[23,"ذهبت بابن الزبعرى وقعة","https://www.aldiwan.net/poem21243.html","الرمل"],[23,"سائل بني الأشعر إن جئتهم","https://www.aldiwan.net/poem21385.html","السريع"],[23,"يا حار قد عولت غير معول","https://www.aldiwan.net/poem21415.html","الكامل"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[85,"آشيم يا من بحبه نعلو","https://www.aldiwan.net/poem7804.html","المنسرح"],[45,"يا أخا الأزد ما حفظت الإخاء","https://www.aldiwan.net/poem10196.html","الخفيف"],[61,"لحظ عينيك للردى أنصار","https://www.aldiwan.net/poem51681.html","الخفيف"],[2,"لمن الديار غشيتها بالفدفد","https://www.aldiwan.net/poem25034.html","الكامل"],[90,"نامي جياع الشعب نامي","https://www.aldiwan.net/poem59037.html","عموديه"],[90,"شممت تربك لا زلفى ولا ملقا","https://www.aldiwan.net/poem60156.html","عموديه"],[31,"هل تعرف الدار والأطلال والدمنا","https://www.aldiwan.net/poem41274.html","الخفيف"],[31,"سائلا الربع بالبلي وقولا","https://www.aldiwan.net/poem41839.html","الخفيف"],[31,"يا خليلي سائلا الأطلالا","https://www.aldiwan.net/poem41846.html","الخفيف"],[31,"أصبح القلب مريضا","https://www.aldiwan.net/poem42471.html","مجزوء الرمل"],[31,"هيج القلب مغان وصير","https://www.aldiwan.net/poem42520.html","الرمل"],[31,"نام صحبي وبات نومي عسيرا","https://www.aldiwan.net/poem42530.html","الخفيف"],[31,"لمن الديار كأنهن سطور","https://www.aldiwan.net/poem42539.html","الكامل"],[22,"طافت أمامة بالركبان آونة","https://www.aldiwan.net/poem21638.html","البسيط"],[75,"تنبأ المتنبي فيكم عصرا","https://www.aldiwan.net/poem69075.html","البسيط"],[75,"حلفت بالسابغات البيض واليلب","https://www.aldiwan.net/poem69102.html","البسيط"],[48,"فتكتني طيزناباذ","https://www.aldiwan.net/poem66209.html","مجزوء الرمل"],[50,"لاح الهوى واستنار العدل والبصر","https://www.aldiwan.net/poem63824.html","البسيط"],[50,"يا ابنة الخير عدينا موعدا","https://www.aldiwan.net/poem63924.html","الرمل"],[50,"يا خليلي أسعدا","https://www.aldiwan.net/poem63945.html","مجزوء الخفيف"],[19,"ودع لميس وداع الصارم اللاحي","https://www.aldiwan.net/poem326.html",""],[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21047","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54880","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9485","الرمل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24207","السريع"],[22,"طافت أُمامة ُ بالرُكبان آوِنَة ً","https://www.poetsgate.com/ViewPoem.aspx?id=19728",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[31,"","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19030&r=&rc=293",""],[115,"والدة لله كم مرة","https://www.aldiwan.net/poem41728.html","السريع"],[129,"صاح قل هل ترى","https://www.aldiwan.net/poem67441.html","مجزوء المتدارك"],[143,"لا تجز في الذي بلغت الأنام","https://www.aldiwan.net/poem11812.html","الخفيف"],[173,"أنا أنس لقعود","https://www.aldiwan.net/poem4382.html","عموديه"],[199,"أما كفاك الفراق غدرا","https://www.aldiwan.net/poem45579.html","مخلع البسيط"],[203,"يا نبي الهدى إليك لجا حي","https://www.aldiwan.net/poem68171.html","الخفيف"],[221,"أمل قطع حبل الأمل","https://www.aldiwan.net/poem55299.html","الرمل"],[237,"هل لذي البعد من تدان يدوم","https://www.aldiwan.net/poem19071.html","الخفيف"],[259,"الحمد للمذكور وهو الذاكر","https://www.aldiwan.net/poem35951.html","الرجز"],[287,"أرحلت من سلمى بغير متاع","https://www.aldiwan.net/poem1916.html","الكامل"],[305,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[371,"وحديثي مع الحوادث أني","https://www.aldiwan.net/poem56981.html","الخفيف"],[377,"دهرنا قد تزندقا","https://www.aldiwan.net/poem59319.html","مجزوء الخفيف"],[393,"أنا من شيعة الرضا","https://www.aldiwan.net/poem53655.html","مجزوء الخفيف"],[406,"أوقد البين في الخميس خميسا","https://www.aldiwan.net/poem50154.html","الخفيف"],[410,"لام في أم مالك عاذلاكا","https://www.aldiwan.net/poem67486.html","الخفيف"],[416,"أي نار بها الجوانح تصلى","https://www.aldiwan.net/poem54098.html","الخفيف"],[416,"سعدت نجد إذا وافيت نجدا","https://www.aldiwan.net/poem54161.html","الرمل"],[416,"يا ليلة في آخر الشهر","https://www.aldiwan.net/poem54175.html","أحذ الكامل"],[452,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[470,"جعل الله جعفرا لك بعلا","https://www.aldiwan.net/poem4646.html","الخفيف"],[479,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"]],"verses":[["إِذ تَمَنّونَهُم غُروراً فَساقَت","هُمِ إِلَيكُم أُمنِيَّةٌ أَشراءُ",0,"ا",2,0],["إِذ تَستَبيكَ بِذي غُروبٍ واضِحٍ","عَذبٍ مُقَبَّلُهُ لَذيذِ المَطعَمِ",1,"م",1,0],["إِذْ تُنْثَرُ الشُّهُبُ المُنِيرَةُ مِثْلَمَا","تَنْهَلُّ أَدْمُعُ عَاشِقٍ وَلْهَانِ",2,"ن",1,0],["إذ ترسل النظرات في أطرافها","حيث ابن هند قائم بحيالها",3,"ل",3,0],["إِذ تُوَلّونَ عَلى أَعقابِكُم","هَرَباً في الشَعبِ أَشباهَ الرَسَل",4,"ل",1,0],["إِذ تَرَكوهُ وَهوَ يَدعوهُمُ","بِالنَسَبِ الأَقصى وَبِالجامِعِ",5,"ع",1,0],["إِذ تَمتَطي سُرُحَ اليَدَينِ نَجيبَةً","مَرَطى الجِراءِ خَفيفَةَ الأَقرابِ",6,"ب",1,0],["إذْ تَنَقَّصْتَني بصعلكة الرأ","س سفاهاً فاذَّمَمت غير ذميم",7,"م",1,0],["إذْ تعديتُ لا حياءٌ من اللَّ","هِ نهاني ولا اتِّقاءُ انتقام",8,"م",1,0],["إذ تعجب الهند والديار بنا","ويعجب الناظرون والأهل",9,"ل",1,0],["إِذ تَغَدّى العُلوجُ مِنهُم غُدُوّاً","فَتَعَشَّتهُمُ يَداكَ عِشاءَ",10,"ا",2,0],["إذ تلاقَى بأرضِها الحَطَبُ الجَزْ","لُ ونارٌ يَحُثُّها إعصارُ",11,"ر",1,0],["إِذ تَستَبيكَ بِجيدِ آدَمَ عاقِدٍ","يَقرو طُلوحَ الأَنعَمينِ فَثَهمَدِ",12,"د",1,0],["إذْ تَخْتَفِينَ بلا اهتمامٍ","أو تُسْفِرينَ بلا لِثَامِ",13,"م",1,0],["إذْ تَحْمِلِينَ الشرَّ صابرةً","مِنَ الهُوجِ الطَّغامِ",13,"م",1,0],["إذْ تُسْقِطُ (الهامَةُ) الإصْباحُ يُرْقِصُنا","و(قاسيُونُ) علينا يَنْشُرُ الشَّفَقا",14,"ق",2,0],["إِذ تَستَبيكَ بِمَصقولٍ عَوارِضُهُ","وَمُقلَتَي شادِنٍ لَم يَعدُ أَن شَدَنا",15,"ن",2,0],["إِذ تَبَدَّت لَنا فَأَبدَت أَثيثاً","حَلِكاً لَونُهُ وَجيداً أَسيلا",16,"ل",2,0],["إِذ تَمَنَّيتِ أَنَّني لَكِ بَعلٌ","آهٍ بَل لَيتَني بِخَدَّكِ خالا",17,"ل",2,0],["إِذ تَبَدَّت لي فَأَبدَت","واضِحَ اللَونِ نَحيضا",18,"ض",2,0],["إِذ تَمَشَّينَ بِجَوٍّ مُؤنِقٍ","نَيِّرِ النَبتِ تَغَشّاهُ الزَهَر",19,"ر",1,0],["إِذ تَذَكَّرتُ قَولَ هِندٍ لِتِربَي","ها وَرُحنا نِيَمِّمُ التَجميرا",20,"ر",2,0],["إِذ تَستَبيكَ بِجيدِ آدَمَ شادِنِ","دُرٌّ عَلى لَبّاتِهِ وَشُذورُ",21,"ر",1,0],["إِذ تَستَبيكَ بِمَصقولٍ عَوارِضُهُ","حُمشِ اللِثاتِ تَرى في غَربِهِ شَنَبا",22,"ب",2,0],["إذ تُقسِمونَ بَرأسِ العَيرِ أنّكُمُ","شافَهْتُموهُ فهل شافَهتم الحَجَرا",23,"ر",2,0],["إذ تجْنِبُ الحُصُنَ الجُرْدَ العِتاقَ بها","وإذ تُصَبّحُ أهلَ السّرجِ والجلَب",24,"ب",1,0],["إِذ تَرَكتُ الماءَ فيها","وَشَرِبتُ الخُسرَوِيّا",25,"ي",2,0],["إِذ تَحسَبُ البَدرَ مَنقوصاً لِلَيلَتِهِ","وَلا تَرى الشَمسَ إِلّا دونَها غِيَرُ",26,"ر",1,0],["إِذ تَعاطَينا وَوَهبٌ نائِمُ","بَرَدَ المُزنَةِ يَسقي البَرَدا",27,"د",2,0],["إِذ تَقولينَ جَهرَةً","لَيتَ ذا دامَ سَرمَدا",28,"د",2,0],["إِذ تَستَبيكَ بِمَصقولٍ عَوارِضُهُ","حَمشِ اللِثاتِ عِذابٍ غَيرِ مِملاحِ",29,"ح",1,0],["إِذ تَستَحِبّونَ عِندَ الخَذلِ أَنَّ لَكُم","مِن آلِ جَعدَةَ أَعماماً وَأَخوالا",30,"ل",2,0],["إذ تَواصَوا بِالكَبشِ لَمّا أَحَسُّ","وهُ وقالُوا مَعَ الحِذارِ حَذارِ",31,"ر",1,0],["إِذْ تَسْكُنُ البَيْدَاءُ وَهْناً فمَا","يَنبِضُ إِلاِّ مُهَجُ السَّفْرِ",32,"ر",1,0],["إِذْ تُرَى الأَمْواجُ فِيهِ أَعْرَضَتْ","مالِئاتٍ صَفحَاتِ المَاءِ سِحْرَا",33,"ر",2,0],["إِذْ تَوَلَّى قِيَادَ قَوْمٍ لِحِينٍ","ثُمَّ أَلْقى لِخَصْمِهِ بِالْقِيَادِ",34,"د",1,0],["إِذ تَرومُ الثُرَيّا","في الغُروبِ مَراما",35,"م",2,0],["إذ تلعب الناكة في متنه","ما بين تزليق وتسليق",36,"ق",1,0],["إذ تستبيكَ بمصقولٍ عوارضهُ","حَمْشِ اللَّثاثِ ترى في غربه شنبا",37,"ب",2,0],["إذ تميلين يَمنة ويَساراً","مثلما لاعبت صَباً خيزُرانه",38,"ن",2,0],["أذ تلهَّتْ بمَحزِمٍ منك بُغيا النفس","من أن تستطيع منكِ احتضانه",38,"ن",2,0],["إذْ تبدتْ لنا، فابدتْ أثيثاً،","حالكاً لونه، وجيداً أسيلا",39,"ل",2,0],["أذ تلك في نص حديث النبي","جنة خلدي تحت أقدامها",40,"م",3,0],["إذ تُحَلُّ القُيود","تلكَ نارُ القِرى",41,"ر",2,0],["إِذ تَنادَت يا آلَ قُرَّةَ آسا","دٌ وَنَدَّت كَأَنَّها آرامُ",42,"م",1,0],["إِذ تَفَجَّرتُ بِمَاءٍ","سَلسَلٍ عَذبٍ بَرُودِ",43,"د",1,0],["إذ تتثتَّى جوىً وحسناً","وإذ تجنَّى هوىً وكبرا",44,"ر",2,0],["إِذ تَنادى بِذُلِّ حَيِّ قُرَيشٍ","وَاِبنِ حَربٍ بَذاً مِنَ الشُهداءِ",45,"ا",2,0],["إذ تلاقى الدهر في أمثاله","بخمور رققت كالغزل",46,"ل",1,0],["إِذْ تَسَنَّمَتْ فِي رِعَانِ الْمَعَالِي","وَسِوَاكَ عَنِ الْمَعَالِي نَئِيمُ",47,"م",1,0],["إذ تنجلي عرائسُ الأسماءِ","بحسنها في المشهد الأسماءِ",48,"ا",2,0],["إِذ تَستَبيكَ بِأَصلَتِيٍّ ناعِمٍ","قامَت لِتَفتِنَهُ بِغَيرِ قِناعِ",49,"ع",1,0],["إِذ تزفرُ النارُ مِن غيظٍ وتُسفرُ عن","هولٍ تكادُ بِه الأصلاب تنقصمُ",50,"م",1,0],["إِذ تُحشرُ الأرواحُ طبقَ علومها","وَتُرى الجسومُ بشكلِ فعلٍ تطبعُ",51,"ع",1,0],["إذ تَوالى طُلوعها وأتمَّت","وادلهمَّت فقلتُ إحدَى الدَّواهي",52,"ي",1,0],["إذ تراه بحالةٍ","لا تُجيب المُمَخرِقا",53,"ق",2,0],["اِذ تَيَقَّنتُ اِنَّها","عَن ذُنوبي مُكَفِّرَه",54,"ر",2,0],["إِذ تَوَلَّت جُموعُهُم عَن مَحَلٍ","حَلَّ صَبري وَهاجَ وَجداً رَسيسا",55,"س",2,0],["إِذ تُلاقي مِنَ الصَبابَةِ بَرحاً","وَتُجيبُ الهَوى إِذا ما دَعاكا",56,"ك",2,0],["إذ تصدَّى لمغرم مات صدَّا","وتولَّى حرّ الغرام وولَّى",57,"ل",2,0],["إذ تصدَّيت لأمرٍ لم نجد","قبل علياك له من يتصدَّى",58,"د",2,0],["إذ تذكرين جلاجلاً سرقت","ولقد نسيت الجوع في شهر",59,"ر",1,0],["إِذ ترامى بحب كوثر حتى","سكن الحب قلبه واستخاره",60,"ر",2,0],["إِذ تولى بأمره مهج الخا","دم عند اصطباحه إِسكاره",60,"ر",2,0],["إِذ تَقولينَ لِلوَليدَةِ قومي","فانظُري مَن تَرينَ بالأَبوابِ",61,"ب",1,0],["إذ تظاهرنا يومها باحتجاج","وهو يوم على المحامي عسير",62,"ر",1,0]]}