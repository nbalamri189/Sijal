{"poems":[[9,"أترحل من ليلى ولما تزود","https://www.aldiwan.net/poem21924.html","الطويل"],[71,"جاءت تودعني والدمع يغلبها","https://www.aldiwan.net/poem3963.html","البسيط"],[93,"دع الخمر نصح أخ إنها","https://www.aldiwan.net/poem11112.html","المتقارب"],[93,"سلام عليكم والفواد المسلم","https://www.aldiwan.net/poem11363.html","الطويل"],[72,"بكى الشعر أيام المنى والمنائح","https://www.aldiwan.net/poem18477.html","الطويل"],[72,"وزير الملك دمت لنا ملاذا","https://www.aldiwan.net/poem18604.html","الوافر"],[72,"نبي الهدى في موقف الحشر شافعي","https://www.aldiwan.net/poem18626.html","الطويل"],[72,"تبسم عن حلو الرضاب شهيه","https://www.aldiwan.net/poem20563.html","الطويل"],[91,"ليطرب من شاء أن يطربا","https://www.aldiwan.net/poem8759.html","عموديه"],[91,"كمنجةي الشوا عليك السلام","https://www.aldiwan.net/poem62744.html","عموديه"],[70,"جاءت تودعني والدمع يغلبها","https://www.aldiwan.net/poem42994.html","البسيط"],[85,"لكل زمان مضى آية","https://www.aldiwan.net/poem63760.html","المتقارب"],[45,"لتهنئ أمير المؤمنين عطية","https://www.aldiwan.net/poem10899.html","الطويل"],[80,"كتابك راق الوشي من خط كاتبه","https://www.aldiwan.net/poem31552.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39576","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42552","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55159","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54899","السريع"],[96,"إِلَى رَاقِصَةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=187825",""],[90,"فلسطين الدامية","https://www.poetsgate.com/ViewPoem.aspx?id=179033",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""],[107,"فواد صبا لم يرجعنه حذار","https://www.aldiwan.net/poem16295.html","الطويل"],[158,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[208,"تهللت الأفراح وابتسم الدهر","https://www.aldiwan.net/poem13466.html","الطويل"],[209,"سلام على الشط الذي كنت نوره","https://www.aldiwan.net/poem46252.html","الطويل"],[235,"أريح الصبا هبت على زهر الربا","https://www.aldiwan.net/poem18041.html","الطويل"],[269,"لك الحمد يا مستوجب الحمد دائما","https://www.aldiwan.net/poem52131.html","الطويل"],[269,"مقيل العاثرين أقل عثارى","https://www.aldiwan.net/poem52134.html","الوافر"],[278,"أتاني أن المجد عني سائل","https://www.aldiwan.net/poem60728.html","الطويل"],[296,"لله وللمثل الأعلى","https://www.aldiwan.net/poem36299.html","عموديه"],[362,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[362,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[400,"يا عاتبا لي ما الذي","https://www.aldiwan.net/poem34113.html","مجزوء الرجز"],[413,"ملكت فؤاد صبك في جمالك","https://www.aldiwan.net/poem54024.html","الوافر"],[436,"تناضل عنك أقدار السماء","https://www.aldiwan.net/poem34803.html","الوافر"],[438,"أيا رباه دعوة مستضيق","https://www.aldiwan.net/poem14335.html","الوافر"],[438,"أيا شارباً كأس خمر الرقاد","https://www.aldiwan.net/poem14364.html","المتقارب"],[438,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[462,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[477,"حللت قلبي يا ابني","https://www.aldiwan.net/poem37055.html","المجتث"],[493,"خلقت كما ترى صعب الثقاف","https://www.aldiwan.net/poem10241.html","الوافر"],[498,"وآيات ألواح رقمن مع العما","https://www.aldiwan.net/poem37957.html","الطويل"],[513,"عطية إن صادفت روح محمد","https://www.aldiwan.net/poem12220.html","الطويل"],[527,"رعايا اليمن الميمون","https://www.aldiwan.net/poem37340.html","مجزوء الوافر"],[556,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[562,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[584,"أما ولآل من شتيت ابتسامه","https://www.aldiwan.net/poem17501.html","الطويل"],[585,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["فَيا فَرَحا بِالنارِ إِذ يَهتَدي بِها","إِلَيهِم وَإِضرامِ السَعيرِ المُوَقَّدِ",0,"د",1,0],["فَيا فُؤادِيَ كَم وَجدٍ وَكَم حَزَنٍ","وَيا زَمانِيَ ذا جَورٌ وَذا عَنَتُ",1,"ت",1,0],["فَيَا فِتْيَةَ الخَيْرِ يَا خَيْرَ مَنْ","تُقِيمُ بِهِمْ أُمَّةٌ وَزْنَهَا",2,"ن",3,0],["فَيَا فِئَةً عَزَّتْ بِفَضْلِ اتِّحَادِهَا","وَكَانَ لَهَا الإِحْسَانُ نِعْمَ الْمُتَمِّمُ",3,"م",1,0],["فيا فرخ ضعفي حيث صرت فريسة","وصار حمامُ الأيك في الطير جارحي",4,"ح",2,0],["فيا فخرَ الوزارةِ يا ختاماً","لها يا ذا المحاسن والإفاده",5,"د",2,0],["فيا فوز آمالي وفوزي إذا غدا","شفيعيَ في هذا وهذا محمد",6,"د",1,0],["فيا فوز قوم آمنوا تحت رقه","ويا ويح من لا آمنوا برقيه",7,"ي",2,0],["فَيا فَرَحاً بِمَجيءِ السِنينِ","تَجيءُ السُنونُ لِكَي تَذهَبا",8,"ب",2,0],["فَيا فَتى الشَهباءِ يا شاعِراً","قَد رَفَعَ الفَنَّ لِأَسمى مُقام",9,"م",1,0],["فَيا فُؤادي كَم وَجدٍ وَكَم حُرَقٍ","وَيا زَماني ذا جَورٌ وَذا عَنَتُ",10,"ت",1,0],["فَيا فِتيَةَ الصُحفُ صَبراً إِذا","نَبا الرِزقُ فيها بِكُم وَاِختَلَف",11,"ف",1,0],["فَيا فَرحَةً جاءَت عَلى إِثرِ تَرحَةٍ","وَبُشرى أَتَت بَعدَ النَعِيِّ تَؤوبُ",12,"ب",1,0],["فيا فارس الشعر الذي ماتَ قِرْنُه","بموتِ زهيرٍ في ارتجالِ غرائبه",13,"ب",2,0],["فيا فِتنةً من وراءِ البحارِ","لقِيتُ بها القَدَرَ الساخرا",14,"ر",2,0],["فَيَافٍ يَضِلُّ النَّجْمُ فِي قُذُفاتِها","وتَظْلَعُ فِيها النَّائِجَاتُ الْبَوَارِحُ",15,"ح",1,0],["فَيَا فَرْعاً زكَا مِنْ خَيْرِ أَصْلٍ","وَغَانِيَةً نَمَاهَا خَيْرُ آلِ",16,"ل",1,0],["فَيَا فقِيداً سَيَلِي ثَأْرُهُ","مُلْحَقَةَ المَتْبُوعِ بِالتَّابِعِ",17,"ع",1,0],["فَيَا فَتَى الْفِتْيَانِ بِالصِّدْقِ فِي","أَخْلاقِهِ وَالرِّفْقِ وَالْبِرِّ",18,"ر",1,0],["فيا فتنةً من وراءِ البحار","لَقِيتُ بها القَدَرض السَّاخِرَا",19,"ر",2,0],["فيا فِلَسْطينُ إن نَعْدمْكِ زاهرةً","فلستِ أولَّ حقٍ غيلةً هُضِما",20,"م",2,0],["فيا فِتْنَة ً بَعدَ النبيِّ بها غَدَا","يهدََّم إيمانٌ وتبنى مساجدُ",21,"د",1,0],["فَيا فارس الهَيجاءِ دُمتَ مُكرَماً","تقاد لَهُ طول الزَمان مهارُ",22,"ر",1,0],["فيا فرحة الإسلام إن كشف الغطا","لأحمد عن من بالغرور لنا دلا",23,"ل",2,0],["فيا فارس الاسلام في كل معرك","ويا ذخر يوم الروع من لا له ذخر",24,"ر",1,0],["فيا فارس الفرسان ما أنت صانع","إذا أنت لم تركب جوادي ولا مهري",25,"ي",1,0],["فيا فرحَةَ الدُّنيا وَفَرحَةَ أهلها","بِيَوْمٍ له مِنْ وَجْهِ عثمانَ أعربا",26,"ب",2,0],["فَيا فالق الاصباح وَالحب وَالنوى","وَيا قاسِم الارزاق بين العَوالِم",27,"م",1,0],["فَيا فردا بلا ثان اجرني","بعز علاك من ثان ودار",28,"ر",1,0],["فَيَا فَخْرَ شَخْصٍ حَلَّ سِرَّكَ ذِكْرُهُ","وَيا سَعْدَ نَفْسٍ سَرَّ مِثْلَكَ قُرْبُها",29,"ب",3,0],["في أُفقِ (دمشق) لقد بزغتْ","شمسٌ هَتَكَتْ حجبَ الظلمِ",30,"م",1,0],["فيا فُرُطي والوِرْدُ وِرْدُ مَنيّةٍ","تنظَّرْ قليلاً فالمسافةُ تُستَدْنى",31,"ن",2,0],["فيا فاضِلاً يُولي الفواضلَ للورَى","ويا عارِفاً يَروِي العوارِفَ للحُرّ",32,"ر",1,0],["فيا فؤادي هل سوى","هواهم قد غلبك",33,"ك",1,0],["فيا فرع النّبوَّة طِبْتَ أصلاً","ثمار الفضل تُجنى من كمالك",34,"ك",1,0],["فيا فَتْحاً لمُفْتَتِحٍ وبُشرى","لمنتظِرٍ ويا مَرْأَىً لِراءِ",35,"ا",2,0],["فيا فوز امرئٍ ألقى عصاه","بباب محمد الطهر الشفيق",36,"ق",1,0],["فيا فوز من قد حوى قطه","بيمناه يلقى به اللَه هاد",37,"د",1,0],["فيا فوزي أراك اللَه","ه في الجنات ملقيني",38,"ي",1,0],["فيا فيضَ ذاك الماء لو برَّد الحشا","ويا حسن ذاك النثر لو كان ينظم",39,"م",1,0],["في أفق بيتي تجلى","منك المحيا الوضي",40,"ي",1,0],["فياف لا الُز بهن إلا","إلى صدر كأعطاف الفيافي",41,"ي",1,0],["فَيا فِتْنَةَ العُشَّاقِ ارْحَمْ ضَليعَهُمْ","كَئيباً يُنادي آمِلاً بالعَوارفِ",42,"ف",1,0],["فيا فرقتي منكم ويا حرقتي لكم","لقد أطلقا دمعي وقد أعقلا عقلي",43,"ي",1,0],["فَيَا فَتّاحُ جُدْ بالفَتْ","حِ للبابِ لقَرّاعِ",44,"ع",1,0],["فيا فوز عبد تراءت له","إلى أن رآها لها فالتزم",45,"م",1,0],["فيا فائق الأقران جودا وسؤدداً","وأسنى أبي في دبي له العلو",46,"ل",2,0],["فَيا فَرْقَدَ الحيِّ الَّذي مُذْ هَويتُهُ","تَكَفَّلَ طَرْفي رَعْي نَسْرٍ وفَرْقَدِ",47,"د",1,0],["فيا فرداً بلا ثان أجرني","وثبتني بعزك ذا الجلال",48,"ل",1,0]]}