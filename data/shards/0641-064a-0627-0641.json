بِالدِّيارِ وَكُثْبانِها","https://www.poetsgate.com/ViewPoem.aspx?id=187312",""],[5759,"قلادة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=213395",""],[5776,"فَصْلٌ..... لمْ يَقُلْهُ ال...بُكَاء","https://www.poetsgate.com/ViewPoem.aspx?id=199340",""],[5781,"سُهدٌ على سَفَر","https://www.poetsgate.com/ViewPoem.aspx?id=202838",""],[5939,"أنا فيها","https://www.poetsgate.com/ViewPoem.aspx?id=156540",""],[5956,"تصدُّ النفسُ","https://www.poetsgate.com/ViewPoem.aspx?id=215870",""],[5997,"دمع الورود","https://www.poetsgate.com/ViewPoem.aspx?id=214320",""],[6019,"دعيني","https://www.poetsgate.com/ViewPoem.aspx?id=53054",""],[6084,"عز الهدى والندى والعلم والعلما","https://www.poetsgate.com/ViewPoem.aspx?id=170871",""],[6084,"خطب ألم بركن الدين فانهدما","https://www.poetsgate.com/ViewPoem.aspx?id=170875",""],[6213,"أرض ونجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76296&r=&rc=44",""],[6222,"عام مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1932&r=&rc=3",""]],"verses":[["فَيا فَرَحا بِالنارِ إِذ يَهتَدي بِها","إِلَيهِم وَإِضرامِ السَعيرِ المُوَقَّدِ",0,"د",1,0],["فَيا فُؤادِيَ كَم وَجدٍ وَكَم حَزَنٍ","وَيا زَمانِيَ ذا جَورٌ وَذا عَنَتُ",1,"ت",1,0],["فَيَا فِتْيَةَ الخَيْرِ يَا خَيْرَ مَنْ","تُقِيمُ بِهِمْ أُمَّةٌ وَزْنَهَا",2,"ن",3,0],["فَيَا فِئَةً عَزَّتْ بِفَضْلِ اتِّحَادِهَا","وَكَانَ لَهَا الإِحْسَانُ نِعْمَ الْمُتَمِّمُ",3,"م",1,0],["فيا فرخ ضعفي حيث صرت فريسة","وصار حمامُ الأيك في الطير جارحي",4,"ح",2,0],["فيا فخرَ الوزارةِ يا ختاماً","لها يا ذا المحاسن والإفاده",5,"د",2,0],["فيا فوز آمالي وفوزي إذا غدا","شفيعيَ في هذا وهذا محمد",6,"د",1,0],["فيا فوز قوم آمنوا تحت رقه","ويا ويح من لا آمنوا برقيه",7,"ي",2,0],["فَيا فَرَحاً بِمَجيءِ السِنينِ","تَجيءُ السُنونُ لِكَي تَذهَبا",8,"ب",2,0],["فَيا فَتى الشَهباءِ يا شاعِراً","قَد رَفَعَ الفَنَّ لِأَسمى مُقام",9,"م",1,0],["فَيا فُؤادي كَم وَجدٍ وَكَم حُرَقٍ","وَيا زَماني ذا جَورٌ وَذا عَنَتُ",10,"ت",1,0],["فَيا فِتيَةَ الصُحفُ صَبراً إِذا","نَبا الرِزقُ فيها بِكُم وَاِختَلَف",11,"ف",1,0],["فَيا فَرحَةً جاءَت عَلى إِثرِ تَرحَةٍ","وَبُشرى أَتَت بَعدَ النَعِيِّ تَؤوبُ",12,"ب",1,0],["فيا فارس الشعر الذي ماتَ قِرْنُه","بموتِ زهيرٍ في ارتجالِ غرائبه",13,"ب",2,0],["فيا فِتنةً من وراءِ البحارِ","لقِيتُ بها القَدَرَ الساخرا",14,"ر",2,0],["فَيَافٍ يَضِلُّ النَّجْمُ فِي قُذُفاتِها","وتَظْلَعُ فِيها النَّائِجَاتُ الْبَوَارِحُ",15,"ح",1,0],["فَيَا فَرْعاً زكَا مِنْ خَيْرِ أَصْلٍ","وَغَانِيَةً نَمَاهَا خَيْرُ آلِ",16,"ل",1,0],["فَيَا فقِيداً سَيَلِي ثَأْرُهُ","مُلْحَقَةَ المَتْبُوعِ بِالتَّابِعِ",17,"ع",1,0],["فَيَا فَتَى الْفِتْيَانِ بِالصِّدْقِ فِي","أَخْلاقِهِ وَالرِّفْقِ وَالْبِرِّ",18,"ر",1,0],["فيا فتنة في الدين ثار دخانها","وذاك إلى يوم النشور يثور",19,"ر",1,0],["فيا فتنة عظمى تحرشتم بها","تقضكم أنيابها والملاهم",20,"م",1,0],["فيا فتنةً من وراءِ البحار","لَقِيتُ بها القَدَرض السَّاخِرَا",21,"ر",2,0],["فيا فِلَسْطينُ إن نَعْدمْكِ زاهرةً","فلستِ أولَّ حقٍ غيلةً هُضِما",22,"م",2,0],["فيا فِتْنَة ً بَعدَ النبيِّ بها غَدَا","يهدََّم إيمانٌ وتبنى مساجدُ",23,"د",1,0],["فَيا فارس الهَيجاءِ دُمتَ مُكرَماً","تقاد لَهُ طول الزَمان مهارُ",24,"ر",1,0],["فيا فرحة الإسلام إن كشف الغطا","لأحمد عن من بالغرور لنا دلا",25,"ل",2,0],["فيا فارس الاسلام في كل معرك","ويا ذخر يوم الروع من لا له ذخر",26,"ر",1,0],["فيا فارس الفرسان ما أنت صانع","إذا أنت لم تركب جوادي ولا مهري",27,"ر",2,0],["فيا فرحَةَ الدُّنيا وَفَرحَةَ أهلها","بِيَوْمٍ له مِنْ وَجْهِ عثمانَ أعربا",28,"ب",2,0],["فَيا فالق الاصباح وَالحب وَالنوى","وَيا قاسِم الارزاق بين العَوالِم",29,"م",1,0],["فَيا فردا بلا ثان اجرني","بعز علاك من ثان ودار",30,"ر",1,0],["فَيَا فَخْرَ شَخْصٍ حَلَّ سِرَّكَ ذِكْرُهُ","وَيا سَعْدَ نَفْسٍ سَرَّ مِثْلَكَ قُرْبُها",31,"ب",3,0],["في أُفقِ (دمشق) لقد بزغتْ","شمسٌ هَتَكَتْ حجبَ الظلمِ",32,"م",1,0],["فيا فُرُطي والوِرْدُ وِرْدُ مَنيّةٍ","تنظَّرْ قليلاً فالمسافةُ تُستَدْنى",33,"ن",2,0],["فيا فاضِلاً يُولي الفواضلَ للورَى","ويا عارِفاً يَروِي العوارِفَ للحُرّ",34,"ر",1,0],["فيا فؤادي هل سوى","هواهم قد غلبك",35,"ك",1,0],["فيا فرع النّبوَّة طِبْتَ أصلاً","ثمار الفضل تُجنى من كمالك",36,"ك",1,0],["فيا فَتْحاً لمُفْتَتِحٍ وبُشرى","لمنتظِرٍ ويا مَرْأَىً لِراءِ",37,"ا",2,0],["فيا فوز امرئٍ ألقى عصاه","بباب محمد الطهر الشفيق",38,"ق",1,0],["فيا فوز من قد حوى قطه","بيمناه يلقى به اللَه هاد",39,"د",1,0],["فيا فوزي أراك اللَه","ه في الجنات ملقيني",40,"ن",2,0],["فيا فيضَ ذاك الماء لو برَّد الحشا","ويا حسن ذاك النثر لو كان ينظم",41,"م",1,0],["في أفق بيتي تجلى","منك المحيا الوضي",42,"ي",1,0],["فياف لا الُز بهن إلا","إلى صدر كأعطاف الفيافي",43,"ف",2,0],["فَيا فِتْنَةَ العُشَّاقِ ارْحَمْ ضَليعَهُمْ","كَئيباً يُنادي آمِلاً بالعَوارفِ",44,"ف",1,0],["فيا فرقتي منكم ويا حرقتي لكم","لقد أطلقا دمعي وقد أعقلا عقلي",45,"ل",2,0],["فَيَا فَتّاحُ جُدْ بالفَتْ","حِ للبابِ لقَرّاعِ",46,"ع",1,0],["فيا فوز عبد تراءت له","إلى أن رآها لها فالتزم",47,"م",1,0],["فيا فائق الأقران جودا وسؤدداً","وأسنى أبي في دبي له العلو",48,"ل",2,0],["فَيا فَرْقَدَ الحيِّ الَّذي مُذْ هَويتُهُ","تَكَفَّلَ طَرْفي رَعْي نَسْرٍ وفَرْقَدِ",49,"د",1,0],["فيا فرداً بلا ثان أجرني","وثبتني بعزك ذا الجلال",50,"ل",1,0],["فيا فلذة الاكباد ربك وحده","عليم بما في النفس من ألم البلوى",51,"و",2,0],["فَيا فرع غصن المجد والشرف الّذي","له شيّدت مِن قبل أقوى دعائمِ",52,"م",1,0],["فَيا فُؤاديَ دَعني مِن مَحبته","وَأَنتِ يا نَفس كفِّي وَاِنظري لِغَد",53,"د",1,0],["فيا فؤاديَ كُنْ للأسْرِ مُصْطَبِراً","وارْجُ السَّراحَ عساهُ أن يكون عَسَى",54,"س",2,0],["فيافي لا جَزرُ الثّمادِ مُقتَّرٌ","لديها ولا مدُّ الفراتِ بذي وفرِ",55,"ر",1,0],["فيافي إرقالٍ وركضً بغيرِ ما","مُرحَّلةٍ صُهبٍ ومُسرجةٍ شُقرِ",55,"ر",1,0],["فَيا فَردَ أَهلِ العَصرِ يا عَينَ مَجدِهِم","وَأَكرَمِهم أَصلاً وَأَكثَرِهم عَطفا",56,"ف",2,0],["فَيا فَخرَ مَنظومٍ يَكونُ خِتامُهُ","عَلَيهِ صَلاةُ اللَّهِ ثمَّ سلامُهُ",57,"ه",1,0],["فيا فَوزَ عبدٍ مؤمنٍ قد جَنَى بهِ","ثِمَارَ أُجورٍ من رياضِ جَنَابِهِ",58,"ب",2,0],["فِي أفْقِ وجنَتِهِ المُنيرة كوْكَبٌ","نَادى بِهَا العشاقَ يا للمُشْتَرِي",59,"ر",2,0],["فيا فوزه إِذ جرى في لماها","وقبّل منها الثنايا العذابا",60,"ب",2,0],["في أُفُقِ كَفكَ فَوقَ الخَلقِ مُرتَفِعٌ","يَراعُ فَضلٍ فَماذا تَنفَع الأَسلُ",61,"ل",1,0],["فَيا فاضِح البَدر في ضوئِه","أَرَدت بفعلك أَن تعذرا",62,"ر",2,0],["فيا فلَكاً بالخير والشرّ دائراً","ويا ملِكاً في راحتيه العوارفُ",63,"ف",1,0],["فَيا فَوزَ الَّذي وَالى","وَيا بُؤسى أَخي الذَنبِ",64,"ب",1,0],["فيا فقيداً فقدنا حسن طلعته","فقد الرياض لصوب العارض الهطل",65,"ل",1,0],["فيا فقيداً من الدنيا تفقده","أهل السموات قبل البدو والحضر",66,"ر",1,0],["فيا فداءً لك مَن كان له","وجهٌ من الصخر وعِرضٌ من سرد",67,"د",1,0],["في أُفق بغدادٍ يلوحُ لناظرٍ","عرشٌ له ماضٍ أغرُّ محجّلُ",68,"ل",1,1],["فيا فرقداً أَهوى باحبولةِ الردى","وقد نُصبت للفرقدين الحبائل",69,"ل",1,0],["في أُفق بغداٍد سما","عرشٌ أغرُّ محجّلُ",70,"ل",1,1],["فيا فوز بالإقبال أرخ لسيدي","يدوم افتخار الدار بالسكان",71,"ن",1,0],["فَيا فُؤادي تَصبّر","عَلى الَّذي فارَقوني",72,"ن",2,0],["فَيا فَوزَ المُصابِ منَ الإلاهِ","بداهيَةِ دَهَتهُ عَنِ الملاهي",73,"ي",1,1],["فيا فتى ما فاتني","ببابه نيل أمل",74,"ل",1,0],["فيا فتى المجد الذي وعوده","لا تحوج الراجي إلى التذكر",75,"ر",1,0],["فيا فؤاداً أسروه تُرَى","أُخِذت قهراً أم وضعت السلاحْ",76,"ح",1,0],["فيا فوزها عند رفع الحج","اب إذا أخذت من سطاك اعتصاما",77,"م",2,0],["فيا فتى ما عداه إرث مكرمة","من قومه النجب الشمّ الصناديد",78,"د",1,0],["فَيا فَجعَةَ الدُنيا بِمَن شِبتُ بَعدَهُ","فَسِيَّانِ مَضنونٌ بهِ وضَنينُ",79,"ن",1,0],["فيا فجر خديه المبين ضياؤه","أعيذك من ليل العذار إذا يسري",80,"ر",2,0],["فيا فكرى اشتغل فيما تراه","ويا حال التعجب فالزميه",81,"ي",2,0],["في أفق دمياط شكل العلم رقد رسما","أم ذا على به ثغر المنى بسما",82,"م",2,1],["فيا فتياتنا من ذاتُ سمعٍ","فتلقيه ليقرعه النداء",83,"ا",2,0],["فيا فارس إِن الجنان وحورها","مزخرفة للشاريين الأفاضل",84,"ل",1,0],["فيا فارس ناداك من جل عنده","جلالك حقاً فاستجب واسمع الندا",85,"د",2,0],["فيا فارغاً من كل شيء سوى الوفا","بربّك ماذا إن عدمِتَ الوفا تبقى",86,"ق",2,0],["فَيا فَرقداً ضاءَ الوُجود بِنوره","فَلا بَعده نَلقى ضياء وَفَرقَدا",87,"د",2,0],["فَيا فرع الأَئمة مِن قُريش","وَكُل منكُم فَرد إِمام",88,"م",1,0],["فيا فَتَياتنا اللاتي توانَت","وهنَّ أحقّ بالعليا اِتّصالا",89,"ل",2,0],["فيا فخر وادي النيل هل أنت قانعٌ","بما كَسَبَت يُمناكَ