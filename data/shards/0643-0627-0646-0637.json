{"poems":[[55,"لقد طال هزي من قوائم معشر","https://www.aldiwan.net/poem29850.html","الطويل"],[55,"يا ظبية البان ترعى في خمائله","https://www.aldiwan.net/poem29919.html","البسيط"],[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[74,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[74,"يا أديبا في نظمه لا يجارى","https://www.aldiwan.net/poem19057.html","الخفيف"],[93,"رب ليل نجومه ضاحكات","https://www.aldiwan.net/poem62801.html","عموديه"],[64,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[30,"تضاحكت أن رأت شيباً تفرعني","https://www.aldiwan.net/poem1241.html",""],[99,"أليلاى ما أبقى الهوى في من رشد","https://www.aldiwan.net/poem24350.html","الطويل"],[99,"رب ليلٍ قد صفا الأفق به","https://www.aldiwan.net/poem24358.html","الرمل"],[22,"يا ليت كل خليل كنت آمله","https://www.aldiwan.net/poem21674.html","البسيط"],[54,"أما ترى النرجس المياس يلحظنا","https://www.aldiwan.net/poem26953.html","البسيط"],[50,"كل محب سواي مستور","https://www.aldiwan.net/poem63346.html","المنسرح"],[52,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147606","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54223","البسيط"],[96,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[159,"زمان الرياض زمان أنيق","https://www.aldiwan.net/poem55612.html","المتقارب"],[159,"رض يا غلام على الروض النضير لنا","https://www.aldiwan.net/poem55667.html","البسيط"],[287,"إذا جزتما بالعيس دورة آبل","https://www.aldiwan.net/poem32646.html","الطويل"],[327,"ألا هاج قلبي العام ظعن بواكر","https://www.aldiwan.net/poem56358.html","الطويل"],[369,"رمتني بلحظ واتقتني بمعصم","https://www.aldiwan.net/poem60649.html","الطويل"],[371,"سقني يا بدر شمسا","https://www.aldiwan.net/poem17305.html","مجزوء الرمل"],[447,"على الذنب لي قلب شجاع مجرب","https://www.aldiwan.net/poem14379.html","الطويل"],[463,"لمن ظعن سوائر لو","https://www.aldiwan.net/poem55846.html","مجزوء الوافر"],[466,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[473,"تاهت على القاصرات القيصريات","https://www.aldiwan.net/poem60354.html","الطويل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129526","الطويل"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75749","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96725","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64625","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93139","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108831","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46475","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89548","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93822","الوافر"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136961",""],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113679","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100843","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100794","الخفيف"],[3204,"","https://poetry.dctabudhabi.ae/diwan/poem/203639",""],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104340","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48442","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48314","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48287","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91774","الطويل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141526","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131276",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33541","الخفيف"],[4717,"كفيفٌ في الصحاري من يقوده","https://www.poetsgate.com/ViewPoem.aspx?id=204367",""],[4857,"الشاعر الخشن","https://www.poetsgate.com/ViewPoem.aspx?id=53888",""],[4968,"كان ظلي","https://www.poetsgate.com/ViewPoem.aspx?id=206572",""],[4978,"سلمت يداك أبا بلال","https://www.poetsgate.com/ViewPoem.aspx?id=177179",""],[5376,"كأنَّ طوداً من الآمالِ يرتحلُ","https://www.poetsgate.com/ViewPoem.aspx?id=191878",""],[5376,"في غوطةِ الشامِ أحزانٌ وآلامُ","https://www.poetsgate.com/ViewPoem.aspx?id=192672",""],[5431,"مات طفلي...","https://www.poetsgate.com/ViewPoem.aspx?id=202275",""],[5582,"أَغِزْلانَ رِيمٍ فِي الهَوادِجِ أَمْ دُمَى","https://www.poetsgate.com/ViewPoem.aspx?id=63578",""],[5690,"قم ودع الغرب أن الشرق ناداكا","https://www.poetsgate.com/ViewPoem.aspx?id=172169",""],[5956,"الوالي والحمار","https://www.poetsgate.com/ViewPoem.aspx?id=184584",""],[5956,"مذْ زُرتَ بيتي","https://www.poetsgate.com/ViewPoem.aspx?id=194142",""],[6068,"فارقتني في صموتْ -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175938",""],[6097,"أهملتني","https://www.poetsgate.com/ViewPoem.aspx?id=194686",""],[6102,"مراهقة ..","https://www.poetsgate.com/ViewPoem.aspx?id=185048",""]],"verses":[["كَأَنَّ طُروقَ الحَيِّ يُخرِجُ مِنهُمُ","إِذا غَضِبوا الداءَ المُجَنَّةَ وَالخَبلا",0,"ل",2,0],["كَأَنَّ طَرفَكِ يَومَ الجِزعِ يُخبِرُنا","بِما طَوى عَنكِ مِن أَسماءِ قَتلاكِ",1,"ك",1,0],["كَأَنَّ طَعمَ الزَنجَبيلِ وَتُف","فاحاً عَلى أَريِ الدَبورِ نَزَل",2,"ل",1,0],["كأن طروسه بين الأعادي","نذيرُ الشيب بالأجل المبير",3,"ر",1,0],["كانَ طعما فأحسنوا حين زادو","ه فأضحى ذاك الطعام قماشا",4,"ش",2,0],["كانَ طَرفي يَجولُ في العالَمِ الأَع","لى وَروحي تَجولُ في مَغناها",5,"ا",3,0],["كأن طيبَ هواكمْ في حماطتِهِ","ترنيقَةُ النومِ في أجفانِ وسنانِ",6,"ن",1,0],["كَأَنَّ طَيراً مِنَ الراياتِ فَوقُهُمُ","في قاتِمٍ لَيطُها حُمرُ الأَنابيبِ",7,"ب",1,0],["كأنَّ طيوفَ الرعبِ والبين موشكٌ","ومزدحم الآلامِ والوجدِ في حَشدِ",8,"د",1,0],["كان طيفاً من ظنونٍ لم يدم","وسحاباً من جنونٍ وعبر",9,"ر",1,0],["كَأَنَّ طَرفَ قَطامِيٍّ بِمُقلَتِهِ","إِذا يَحارُ هُداةُ الناسِ لَم يَحِرِ",10,"ر",1,0],["كَأَنَّ طَلَّ النَدى فيهِ لِمُبصِرِهِ","دَمعٌ تَرَقرَقَ مِن أَجفانِ مَهجورِ",11,"ر",1,0],["كَأَنَّ طَرفي عَينٌ عَلَيَّ لَهُم","فَكُلُّ طَيٍّ لَدَيَّ مَنشورُ",12,"ر",1,0],["كَأَنَّ طُلّابَهُ لِحاجَتِهِم","حَجٌّ يَأُمّونَ مَشعَراً شُزُبا",13,"ب",2,0],["كأن طفلا خائفاً","في أضلعي حَلَّ الحُبى",14,"ب",2,0],["كأن طرحي في لظى مالكٍ","يدخله جنة رضوان",15,"ن",1,0],["كانَ طِفلاً لَو غَزا مائَةً","لَم يَهُلهُ لِلعِدا عَدَدُ",16,"د",1,0],["كَأنَّ طَلْعَتَهُ وَالشَّوْقُ يَرْقُبُهَا","وَجْهُ الصَّباحِ يُحَيِّي نِضْوَ أَسْفَارِ",17,"ر",1,0],["كأنّ طباع الغيد فيه فإن دنا","قليلا . نأى حتّى لقد عزّ مطلبا",18,"ب",2,0],["كأَنَّ طَيالِسَ غُدْرانِها","عَلى هَيْكَلِ الْماءِ فيها خُروقُ",19,"ق",1,0],["كَأنَّ طَلَّ النَّدى فيهِ لِمُبصِرِه","دمعٌ تَحَيَّرَ في أَجْفانِ مَهْجُورِ",20,"ر",1,0],["كَأَنَّ طُيورَ الماءِ فيهِ عَرائِسٌ","جُلينَ عَلى شاطيهِ خُضرَ الغَلائِلِ",21,"ل",1,0],["كَأَنَّ طُبولاً فَوقَ أَعجازِ مُزنِهِ","يُجاوِبُها مِن آخِرِ اللَيلِ زامرُ",22,"ر",1,0],["كأنّ طريقَ الوفْدِ نحْوَ فِنائه","تَغيُّبُ سِلْكٍ في جُمانٍ مُنظَّم",23,"م",1,0],["كَاِنطِواءِ الخَوفِ عَنّا","حينَ وَلَّى اللَهُ طَيّا",24,"ي",2,0],["كأن طريقي فيه لا خوف عنده","ونهجي إلى فعل الصلاح مخوف",25,"ف",1,0],["كأن طريقَها المروي","يَ مما لاق بالأذنِ",26,"ن",1,0],["كأن طِرْفك إذ يجري بأربعةٍ","بنانُ كفكَ إذ يجري به الكَرَمُ",27,"م",1,0],["كَأَنَّ طُرَّتَها مِن فَوقِ طَلعَتِها","لَيلُ الهُمومِ عَلى صُبحِ المَسَرّاتِ",28,"ت",1,0],["كأن طلابي المجد والدهر دونه ترقب","طيف حال من دونه السهد",29,"د",1,0],["كأن طائِر النسرين قَد خافَ بازياً","من الصبح فازدادت جوانحه شرعا",30,"ع",2,0],["كأنّ طريَّ الوردِ في صحنِ خدّها","تقطّر زهراً بعدما قد تكتّما",31,"م",2,0],["كان طه أنزلت واصفة","يمينه لما على الملك استوى",32,"ا",1,0],["كأن طيب شذاها إذ يمر بنا","ريا أريج علي القدر مولانا",33,"ن",2,0],["كأن طرتها ليل وغرتها","صبح وقامتها غصن على جبل",34,"ل",1,0],["كان طالوتُ قد تَملَّكَ فيهم","وهو بَدنٌ وكلُّهمن ضُعفاء",35,"ا",2,0],["كَأَن طُلوع الشعريين باثرها","رَقيب بِاحدى مُقلَتيهِ مُصاب",36,"ب",1,0],["كَأَنَّ طُرَّتَهُ مِن فَوقِ غَرَّتِهِ","لَيلٌ تَأَلَّقَ فيهِ ضَوءُ مِصباحِ",37,"ح",1,0],["كأن طباعه حسناً ولطفا","عروس تنجلي ذات ابتسام",38,"م",1,0],["كان طرفي في الخطب يدمع لكن","يوم خطب الفوآد قلبي أدمى",39,"م",2,0],["كان طول القناة ودُّك عندي","فانبرى من جفاك عرض النِّجادِ",40,"د",1,0],["كأن طينته في بدءها عجنت","بماء الأم أمّ معقب وأب",41,"ب",1,0],["كان طرف الحسود اعور حتى","وقع الداء في اسمه وتحكم",42,"م",1,0],["كان طرفي قبل","أن ينظر ميا فارقنا",43,"ن",2,1],["كأن طيب شذاها إذ تمر بنا","ريا اريج علي القدر مولانا",44,"ن",2,0],["كأنّ طُيوراً في ذَرى الجوّ حَوَّمَتْ","وثابَتْ لأوْكارٍ بهنّ وِثابُها",45,"ب",3,0],["كأنّ طوالِعَ شهْبانِها","طلائِعُ شُهْبٍ مَلأْنَ الفَضا",46,"ض",2,0],["كأنّ طلوعَ البدْرِ عندَ تمامِهِ","مُحَيّا ابنِ نصرٍ والكواكِبَ جُنْدُهُ",47,"د",2,0],["كَأَنّ طُلولاً قَد تعفّت رُسومُها","وَأَقوت عَن الأَحباب بَعد التحابب",48,"ب",1,0],["كأنَّ طُرَّةَ غيمٍ في جوانبهِ","خافي الخطوط سطورٌ في أناجيلِ",49,"ل",1,0],["كأن طياراتهم انسرٌ","تعلو بها اجنحةٌ خفق",50,"ق",1,0],["كان طي الخفاء هكطور يرعى","فوقاه شر المنون الطواري",51,"ي",1,0],["كانَ طرفي على فؤادي بلاءً","إنَّ طرفي على فؤادي مَشُومُ",52,"م",1,0],["كأنَّ طريقَه قُفلتْ برمزٍ","فشفَّرها .. وعزَّ عليه كوده",53,"د",2,0],["كَأنْ طُلُوعِيَ بَيْنَ النّاسِ أرَّقَهَمْ","فِي جَنَّةِ الكَوْنِ فَانْهَارُوا وَمَا وَثِقُوا",54,"ق",3,0],["كانَ طيفُ الوصلِ ظلّي وملاذي","باتَ أسري فيه كابدْتُ الحصارا",55,"ر",2,0],["كأن طهاة قبّاني طهوهُ","يجاور مستطيلٌ مستديره",56,"ر",2,0],["كأنَّ طوداً من الآمالِ يرتحلُ","نشكو وتشكو بها أيامنا الأولُ",57,"ل",1,1],["كأن طيراً على أشهادهم وقفتْ","لكلِّ قبرٍ لهم سودٌ وأعلامُ",58,"م",1,0],["كان طفلي وكنت طفلة قلبٍ","مورق الحسّ نهره ليس ينضب",59,"ب",1,0],["كأَنَّ طَرِيَّ الوَرْدِ فِي صَحْنِ خَدِّها","تَقَطَّرَ زَهْراً بَعْدَما قَدْ تَكَمَّمَا",60,"م",2,0],["كان طير المعالي فيك وكنتها","وفكرتي نصبت للصيد أشرا كا",61,"ك",2,0],["كان طفلاً يركب الدابَّة هذي","مَعَ (نجوى) رمزِ حبٍّ ما أْتَفَكْ",62,"ك",1,0],["كأنَّ طينتكم من غير طينتنا","من نخبة فوق ما يشدو به قلمُ",63,"م",1,0],["كان طيفا من خيال","كان بيت العنكبوتْ",64,"ت",1,0],["كَأنّ طَيفكَ أَورَى النَّارَ في خَلَدي","وُأطِفئُ النّارَ إذْ أسْتَشرِفُ الطَّيفَا؟!",65,"ف",2,0],["كانَ طِيبُ الكَلامِ خَيرَ خِصالٍ","نَسِيَتها , فَأَقذَعَتْ ثُمَّ سَبَّتْ",66,"ت",1,0]]}