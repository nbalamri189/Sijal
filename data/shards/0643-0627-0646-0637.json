{"poems":[[53,"لقد طال هزي من قوائم معشر","https://www.aldiwan.net/poem29850.html","الطويل"],[53,"يا ظبية البان ترعى في خمائله","https://www.aldiwan.net/poem29919.html","البسيط"],[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[72,"يا أديبا في نظمه لا يجارى","https://www.aldiwan.net/poem19057.html","الخفيف"],[91,"رب ليل نجومه ضاحكات","https://www.aldiwan.net/poem62801.html","عموديه"],[62,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[28,"تضاحكت أن رأت شيباً تفرعني","https://www.aldiwan.net/poem1241.html",""],[97,"أليلاى ما أبقى الهوى في من رشد","https://www.aldiwan.net/poem24350.html","الطويل"],[97,"رب ليلٍ قد صفا الأفق به","https://www.aldiwan.net/poem24358.html","الرمل"],[22,"يا ليت كل خليل كنت آمله","https://www.aldiwan.net/poem21674.html","البسيط"],[52,"أما ترى النرجس المياس يلحظنا","https://www.aldiwan.net/poem26953.html","البسيط"],[48,"كل محب سواي مستور","https://www.aldiwan.net/poem63346.html","المنسرح"],[50,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147606","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54223","البسيط"],[94,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[156,"زمان الرياض زمان أنيق","https://www.aldiwan.net/poem55612.html","المتقارب"],[156,"رض يا غلام على الروض النضير لنا","https://www.aldiwan.net/poem55667.html","البسيط"],[283,"إذا جزتما بالعيس دورة آبل","https://www.aldiwan.net/poem32646.html","الطويل"],[323,"ألا هاج قلبي العام ظعن بواكر","https://www.aldiwan.net/poem56358.html","الطويل"],[365,"رمتني بلحظ واتقتني بمعصم","https://www.aldiwan.net/poem60649.html","الطويل"],[367,"سقني يا بدر شمسا","https://www.aldiwan.net/poem17305.html","مجزوء الرمل"],[442,"على الذنب لي قلب شجاع مجرب","https://www.aldiwan.net/poem14379.html","الطويل"],[459,"لمن ظعن سوائر لو","https://www.aldiwan.net/poem55846.html","مجزوء الوافر"],[462,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[469,"تاهت على القاصرات القيصريات","https://www.aldiwan.net/poem60354.html","الطويل"]],"verses":[["كَأَنَّ طُروقَ الحَيِّ يُخرِجُ مِنهُمُ","إِذا غَضِبوا الداءَ المُجَنَّةَ وَالخَبلا",0,"ل",2,0],["كَأَنَّ طَرفَكِ يَومَ الجِزعِ يُخبِرُنا","بِما طَوى عَنكِ مِن أَسماءِ قَتلاكِ",1,"ك",1,0],["كَأَنَّ طَعمَ الزَنجَبيلِ وَتُف","فاحاً عَلى أَريِ الدَبورِ نَزَل",2,"ل",1,0],["كأن طروسه بين الأعادي","نذيرُ الشيب بالأجل المبير",3,"ر",1,0],["كانَ طعما فأحسنوا حين زادو","ه فأضحى ذاك الطعام قماشا",4,"ش",2,0],["كانَ طَرفي يَجولُ في العالَمِ الأَع","لى وَروحي تَجولُ في مَغناها",5,"ا",3,0],["كأن طيبَ هواكمْ في حماطتِهِ","ترنيقَةُ النومِ في أجفانِ وسنانِ",6,"ن",1,0],["كَأَنَّ طَيراً مِنَ الراياتِ فَوقُهُمُ","في قاتِمٍ لَيطُها حُمرُ الأَنابيبِ",7,"ب",1,0],["كأنَّ طيوفَ الرعبِ والبين موشكٌ","ومزدحم الآلامِ والوجدِ في حَشدِ",8,"د",1,0],["كان طيفاً من ظنونٍ لم يدم","وسحاباً من جنونٍ وعبر",9,"ر",1,0],["كَأَنَّ طَرفَ قَطامِيٍّ بِمُقلَتِهِ","إِذا يَحارُ هُداةُ الناسِ لَم يَحِرِ",10,"ر",1,0],["كَأَنَّ طَلَّ النَدى فيهِ لِمُبصِرِهِ","دَمعٌ تَرَقرَقَ مِن أَجفانِ مَهجورِ",11,"ر",1,0],["كَأَنَّ طَرفي عَينٌ عَلَيَّ لَهُم","فَكُلُّ طَيٍّ لَدَيَّ مَنشورُ",12,"ر",1,0],["كَأَنَّ طُلّابَهُ لِحاجَتِهِم","حَجٌّ يَأُمّونَ مَشعَراً شُزُبا",13,"ب",2,0],["كأن طفلا خائفاً","في أضلعي حَلَّ الحُبى",14,"ب",2,0],["كأن طرحي في لظى مالكٍ","يدخله جنة رضوان",15,"ن",1,0],["كانَ طِفلاً لَو غَزا مائَةً","لَم يَهُلهُ لِلعِدا عَدَدُ",16,"د",1,0],["كَأنَّ طَلْعَتَهُ وَالشَّوْقُ يَرْقُبُهَا","وَجْهُ الصَّباحِ يُحَيِّي نِضْوَ أَسْفَارِ",17,"ر",1,0],["كأنّ طباع الغيد فيه فإن دنا","قليلا . نأى حتّى لقد عزّ مطلبا",18,"ب",2,0],["كأَنَّ طَيالِسَ غُدْرانِها","عَلى هَيْكَلِ الْماءِ فيها خُروقُ",19,"ق",1,0],["كَأنَّ طَلَّ النَّدى فيهِ لِمُبصِرِه","دمعٌ تَحَيَّرَ في أَجْفانِ مَهْجُورِ",20,"ر",1,0],["كَأَنَّ طُيورَ الماءِ فيهِ عَرائِسٌ","جُلينَ عَلى شاطيهِ خُضرَ الغَلائِلِ",21,"ل",1,0],["كَأَنَّ طُبولاً فَوقَ أَعجازِ مُزنِهِ","يُجاوِبُها مِن آخِرِ اللَيلِ زامرُ",22,"ر",1,0],["كأنّ طريقَ الوفْدِ نحْوَ فِنائه","تَغيُّبُ سِلْكٍ في جُمانٍ مُنظَّم",23,"م",1,0],["كَاِنطِواءِ الخَوفِ عَنّا","حينَ وَلَّى اللَهُ طَيّا",24,"ي",2,0],["كأن طريقي فيه لا خوف عنده","ونهجي إلى فعل الصلاح مخوف",25,"ف",1,0],["كأن طريقَها المروي","يَ مما لاق بالأذنِ",26,"ن",1,0],["كأن طِرْفك إذ يجري بأربعةٍ","بنانُ كفكَ إذ يجري به الكَرَمُ",27,"م",1,0],["كَأَنَّ طُرَّتَها مِن فَوقِ طَلعَتِها","لَيلُ الهُمومِ عَلى صُبحِ المَسَرّاتِ",28,"ت",1,0]]}