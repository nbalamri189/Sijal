5725,"انوار محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177543",""],[5725,"قلبي يقيناً بالمحبة ينبض","https://www.poetsgate.com/ViewPoem.aspx?id=213436",""],[5758,"أَحْلَامٌ عَربيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=200513",""],[5829,"الصوم عن المفاسد","https://www.poetsgate.com/ViewPoem.aspx?id=212595",""],[5906,"أجراس الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=188073",""],[5956,"أدعو إلهي أن يعيدك هانئاً","https://www.poetsgate.com/ViewPoem.aspx?id=194106",""],[5956,"تكاد البنت نحو الموت أن تثبا","https://www.poetsgate.com/ViewPoem.aspx?id=194711",""],[5966,"رفاق العلا","https://www.poetsgate.com/ViewPoem.aspx?id=158436",""],[6070,"العنيد","https://www.poetsgate.com/ViewPoem.aspx?id=187816",""],[6102,"فرات وذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=184550",""],[6124,"سواد الهدب","https://www.poetsgate.com/ViewPoem.aspx?id=109744",""],[563,"رأينا النور في الظلما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56277&r=&rc=7",""],[6259,"حكمُ المنيَّة في البريَّة جارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59422&r=&rc=70",""],[6290,"خُلِقْتُ كَبِيرًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85162&r=&rc=8",""]],"verses":[["وَأَخفَتَ زَمجَرَةَ المُشرِكينَ","يَفري الجَماجِمَ قَطّاً وَقَدّا",0,"د",2,0],["وأُخْفي الصّدى والماءُ زُرْقٌ جِمامُهُ","فهُنَّ على الذُّلِّ السِّمامُ المُثَمَّلُ",1,"ل",1,0],["وأخْفَيتُ ما بي من هَوًى ومَطِيُّنا","يُلَبِّسُ أُخْراهُ بأُولاهُ إعْجالُ",2,"ل",1,0],["وأخْفَقَ مسْعَى كلِّ آمِلِ غايَةٍ","وأخْلَقَ منْ عَصْبِ الزّمانِ جَديدُهُ",3,"د",2,0],["وأخفت ليَ الأسقام جسماً كأنه","خلال الأسى والبين عود خلال",4,"ل",1,0],["وَاِخفِض جَناحَكَ في الأَرضِ الَّتي حَمَلَت","موسى رَضيعاً وَعيسى الطُهرَ مُنفَطِما",5,"م",2,0],["وَاِخفِض جَبينَكَ هَيبَةً","لِلخُرَّدِ المُتَخَفِّراتِ",6,"ت",1,0],["وَأَخِفُّ عَن كَتِفِ الصَديقِ نَزاهَةً","مِن قَبلِ أَن يَتَلَوَّنَ الأَلوانا",7,"ن",2,0],["وَاِخفِض جَناحَكَ لِلأَقارِبِ كِلِّهِم","بِتَذَلُّلٍ وَاِسمَح لَهُم إِن أَذنَبوا",8,"ب",3,0],["وَاِخفِض جَناحَكَ لِلصَديقِ وَكُن لَهُ","كَأَبٍ عَلى أَولادِهِ يَتَحَدَّبُ",9,"ب",1,0],["وَاِخفِض جَناحَكَ إِن رُزِقتَ تَسَلُّطاً","وَاِرغَب بِنَفسِكَ عَن هَنٍ وَهَناتِ",10,"ت",1,0],["وَأَخَفُّ ما يُلفى الفَتى ثِقلاً عَلى","إِخوانِهِ ما كَفَّ عَن إِخوانِهِ",11,"ن",2,0],["وَأَخَفُّ ما جَشِمَ اِمرُؤٌ وَسَعى لَهُ","يَوماً لِذي النُعمى الثَناءُ الصادِقُ",12,"ق",1,0],["وَأَخفافُ المُخَيَّسَةِ المَهارى","يُشَدُّ لَها السَرائِحُ وَالنُقولُ",13,"ل",1,0],["وَأخَفتَ أَهلَ الشِركِ حَتّى إِنَّهُ","لَتَخافُكَ النُطَفُ الَّتي لَم تُخلَقِ",14,"ق",1,0],["وأَخفي هواي عن المرجف","فإني سأخفى هواك معي",15,"ي",1,0],["وَأُخِفْتَ صوْتُهَا الأَعْلَى","وَأُغْمِدَ نَصْلُهَا الأَمْضى",16,"ض",2,0],["واخفضوا بالصمت في محرابه","أفصح الألسن صمت الخاشعين",17,"ن",1,0],["وَ أَخْفَافُ المُخَيَّسَة ِ المَهَارَى","يُشَدُّ لها السَّرَائِحُ والنَّقِيلُ",18,"ل",1,0],["وأخفى (عليا) مضيق طويل","ووراى (ثقى) شارع مختصر",19,"ر",1,0],["واخفضوا أبصاركم في هيبة ٍ","إن رأت أبصاركم نور اليقين",20,"ن",1,0],["واخفضْ جناحَك دأْباً للمعلمِ فَهْو","الوالدُ المُشْفِق المشهور في الخبرِ",21,"ر",1,0],["واخفِ سرّاً عن البرية طُرّاً","لا تُعالم حيّاً من الأحياءِ",22,"ا",2,0],["وأُخفِضُه مِن بَعدِ عِزٍّ وَرِفعَةٍ","وأجعَلُهث في ذِلَّةٍ وَهَوَانِ",23,"ن",1,0],["وَأَخَفتَ ذا الزَمَنَ المُضاعَفَ جَورُهُ","حَتّى اِتَّقاكَ بِطاعَةِ المُستَخدَمِ",24,"م",1,0],["وأخفاؤكم في المسلمين اعتقادكم","وجحد رجال منكم فيه عوتبوا",25,"ب",3,0],["وأخفاه لكن ما المغطى بعورة","إذا كشف الباري غطاها بساتر",26,"ر",1,0],["وَاِخفِض جَناحَكَ لِلعَشيرَةِ وَاِرعَها","بِرِعايَةِ الإِجلالِ وَالإِعظامِ",27,"م",1,0],["وأَخفْتَ شاسعةَ العِدَا فقبورُهم","أوطانهم وثيابهم أكفان",28,"ن",1,0],["وأخَف من نسَماتِ نيسانٍ وَقد","خَطَرت مُداعبَةً غُصونَ البانِ",29,"ن",1,0],["وَأَخفَيتُم نِفاقَكُمُ إِلى أَن","وَثَبتُم وَثبَةَ الذِئبِ الضَرِيِّ",30,"ي",1,0],["وَأَخفَتَ سَربَ الحادِثاتِ وَثَقَّفَت","سَطواتُكَ الأَيّامَ أَيَّ ثِقافِ",31,"ف",1,0],["واخفض العين إن سمت لازدهاءٍ","وغض النفس إن طمت باغتياظ",32,"ظ",1,0],["وأخفُّ ما حُمّلتُ من عِبْءِ الهوى","أنْ أسْتريحَ إلى مَطامع تُتْعبُ",33,"ب",1,0],["وَأَخفَقُ الناسِ مَسعىً كُلُّ مُختَبِلٍ","يَهذي بِصاحِبِ قَلبٍ غَيرِ مُختَبِلِ",34,"ل",1,0],["وأخف أقاويلا عليها بشاعة","وما يقشعرّ الجلد منها برهبان",35,"ن",1,0],["وَأَخفى حُلاها في طلسمٍ من اِسمه","يُشيرُ لبرٍّ طالَ إن فكّ رمزهُ",36,"ز",2,0],["وَأُخفي الشَيبَ جهدي وَهوَ يَبدو","كَما غَطّى عَلى الرَيبِ المُريبُ",37,"ب",1,0],["واخفض جناحك في التماسك بغيةً","إن الأبيَّ يفوته ما شاء",38,"ا",2,0],["واخفضُ عن فضلٍ جناحي لصحْبتي","وأصفحُ عن ذنبٍ كأن لم يكن ذنبُ",39,"ب",1,0],["وأخف خلق اللّه روحاً جاءني","وأراد إتياني إلى بستانه",40,"ه",1,1],["وَأُخَفِّضُ الزَفرات وَهيَ صَواعِدٌ","وَأُكَفكِفُ العَبرات وَهيَ جَواري",41,"ر",2,0],["واخفض جناحا لديه عند رؤيته","واشرح غرامي الذي فيه أعانيه",42,"ي",2,0],["وأخفَّهم سَرْجاً إلى ظَفَرٍ","متعجَّلٍ ويداً إلى نصلِ",43,"ل",1,0],["وأخفُّهم في صدر موكبه","سَرْجاً وأثقلُهم على الصدرِ",44,"ر",1,0],["وأَخفَى الحسينُ خطفَهم بشُعاعِه","كما أَخفت الشمسُ النَجوم اللوائحا",45,"ح",2,0],["وَأُخفِي إِذا استَخبَرتُ أَشياءَ كارِهاً","وَفِي النَفسِ حاجاتٌ إِلَيها تَطَلَّعُ",46,"ع",1,0],["وأخفُّ ما يلقى نوائبَ حتفِهِ","جللاً إذا كانَ الفِراقُ نوائبا",47,"ب",2,0],["وإخفاءِ مزايانا","وإبرازِ مساوينا",48,"ن",2,0],["وأخفر الصارم في يمينه","عند الجلاد ذمة المغافر",49,"ر",1,0],["واخفض جناح العز فهو تحية","أمر الإله بها النبي المرسلا",50,"ل",2,0],["واخفِض لِداوُودٍ جَناحَكَ واغتَفِر","ما كانَ يا ذا العَفوِ والغُفرانِ",51,"ن",1,0],["وأخفى ذوات الوهم عن كل ناظر","وأبدى خيالاً ثم أثبته عينا",52,"ن",2,0],["وأخفى أماني في خفي مخاوفي","وأستر كشفي في استتار مكاشفي",53,"ي",1,0],["واخفوا على تلك المطايا مسيرهم","فنمّ عليها في الظلام التبسّمُ",54,"م",1,0],["وأخفي الذي ألقى من الحزن والأسى","وظاهرُ حالي الدهر يؤذن بالصفحِ",55,"ح",1,0],["وأخفرا لاعتقاد السوء ذمته","مع عاضد لهما يا بئس ما اعتقدوا",56,"د",3,0],["وأخفى الدخان محيّا العنان","فلم تبصر العين شمس العيان",57,"ن",1,1],["وأخفق من شاء بيع البلا","د بالحكم بغياً وبئس الثمن",58,"ن",1,0],["واخفف مرورك يا نسي","م فقد خدشت الخد لثما",59,"م",2,0],["وأخفق مَسْعايَ الذي قد رجوته","وأعتبه من كنت أخشى عِتابَه",60,"ب",2,0],["وَأخْفَيْتُ مَا ألْقَاهُ صَوْناً لِسِرَّكُمْ","وَمَالي أنِيٍسٌ فِي الدُّجى غَيْرَ ذِكْرِكُمْ",61,"م",1,0],["واخفض عدوك لا تنصب مصادره","لا انجر جازمه واعتل ناصبه",62,"ب",2,0],["وأَخفي ترجمات الحبّ منّي","وَسقمي نائبٌ عن ترجمانِ",63,"ن",1,0],["وأخفى صهيل الخيل أصوات أهلها","فعاقت نواقيس الفرنج عن الضرب",64,"ب",1,0],["وأخفين حرقتها الكاويةْ...","وكان اعتزاز وحلم جميلْ",65,"ل",1,0],["واخفيت مصباح الهدى متطلبا","ضلالة قوم في الجهالة قد تاهوا",66,"ا",1,0],["وأخ في اللَه لكل أَخ","كلف بالدين وَبالسنن",67,"ن",1,0],["وَأَخفَرَت في الأمينِ العَهدِ وَاِنتَدَبَت","لِجَعفَرٍ بِاِبنِهِ وَالأَعبُدِ الغُدُرِ",68,"ر",1,0],["واخفى كماله فضل كل كامل","كالبدر يخفى ضوء نجم الإظلام",69,"م",1,0],["واخفض جناح الذل منك لعزهم","ان الذليل هو العزيز لديهمو",70,"م",2,0],["وأخفيته عن أعين الخلقِ رحمة","بهم للذي يعطى الجحود من الكفر",71,"ر",1,0],["وَاخفوا سَير هاتيك المَطايا","فَلَيسَ حداؤهم إِلّا تُناجي",72,"ج",2,0],["وَأَخفَيت مِنا ماجِداً بَعدَ ماجد","بِسقط اللَوى بَينَ الدُخول فَحومل",73,"ل",1,0],["وَاِخفِض جَناحَكَ رَحمَةً لِكِلَيهِما","تَمهَد لِنَفسِكَ لَو فَعَلتَ وَتذخرِ",74,"ر",1,0],["وَاِخفِض كَلامَكَ وَاِمشِ هوناً وَاِلقِ مَن","لاقَيتَ طَلقاً لا بِخَدٍّ أَصعَرِ",74,"ر",1,0],["وأخف عني سلاحا فيه تقتلني","واقتل اذا شئت قتلي دون اعلامي",75,"م",2,0],["وأخفيت شوقي على كثوه","وليس المقام مقام الخفا",76,"ف",2,0],["وأخفَيتَ قَيدَ المَعانِي عَلَى","مواكِبِ أغرَاضِك الظَّافِرَه",77,"ر",2,0],["وأخفيتُ عنكُم حاجتي وهي خلةٌ","تلوحُ لعينِ الناظرِ المتوسمِ",78,"م",1,0],["وأخفق نعلَهُ بالصَّفع رأسي","إلى أن أوجس القلبَ الخَفوقا",79,"ق",2,0],["وأخفيت من أهوى وألقيت دونه","من الحب أستاراً فعدن جهارا",80,"ر",2,0],["واخفاه بغياً إذ أردن وداعه","تشم له ثغراً وتلثم منحرا",81,"ر",2,0],["وأخفيت النوال بمبدعاتٍ","لو اعترضت لحاتم قال قدكا",82,"ك",2,0],["وَاخفض جناحَ الذل تنجو بِهِ","وَاخضع لمن لم تدره ابن من",83,"ن",1,0],["وأخِفْ ما استطعت منهم يَخالوا","أمنَهم من أَذاكَ غنمًا يُعَدُّ",84,"د",1,0],["واخفِضْ جناحكَ للرَّعية لاطفاً","بهمْ يعنكَ بلطفه الدَّيانُ",85,"ن",1,0],["وأخفي لمن أهوى هواها وإنه","عليّ بها مني أجلُّ من الكتمِ",86,"م",1,0],["وَأَخفَت أَثِينا ثائرَ الغَيظِ تَلتَظِي","حَزَازَة صَدرٍ مُستَشِيطٍ تَوَهَّجا",87,"ج",2,0],["وَأَخفى مقامات البَديع بيانه","فاوجهه فيها التفات إِلى الفهم",88,"م",1,0],["وأخفيتُ أمري خوف واشٍ يذيعه","فَهَمَت وأبدته العيون الهواطل",89,"ل",1,0],["وأخفض جناح الذل ثم وقل وقل","يا عين هذا سيد السادات",90,"ت",1,0],["واخفِضْ جَناحَكَ ، إنّ ربّكَ كَارِهٌ","مَنْ كانَ في دربِ الغرورِ وَلِيْجَا",91,"ج",2,0],["وأخفيت في نسكي خيبتيْنا","لكيما يقال ، نراه تقيا",92,"ي",2,0],["وأخفوا على تلك المطايا مسارهم","فنم عليهم في الظلام التبسم",93,"م",1,0],["وَاخْفِضْ جَنَاحَكَ لِلصَّغيرِ مُدَاعِباً","فَتَبيعُ ذِي الشَّمْسِ العَظيمةِ كَوكَبُ",94,"ب",1,0],["واخفض له يا خافض الطاغوت ما","قد طال بالسلطان من أعدائه",95,"ا",3,0],["وأخفى بها عنها حقيقة ذاتها","فلم تر إلا هالة بين جثمان",96,"ن",1,0],["واخفض الصوت إن نطقت بليل","والتفت بالنهار قبل الكلام",97,"م",1,0],["واُخفي ما بقلبي من شجونٍ","لكيلا تفزعي من ذي الهديّهْ",98,"ي",2,0],["وأخفى مراماً رمتموه ببغيكم","أبى الله إلا أنه لن يتمما",99,"م",2,0],["واخْفضْ جَناحَكَ ذلاً ْعندَه ورعا","وارْفعْ يديْكَ أناء الليلِ وامْتثلِ",100,"ل",1,0],["وَأخْفَيْتَ خُبْثًا في مَداكَ مُعَشّشا","وأبْرَحْتَ لُؤْماً والنِّفاق تُبيحُ",101,"ح",1,0],["واخْفِضْ جَنَاحَكَ في ذلٍّ ومَرْحَمَةٍ","للوَالِدَينِ فَكَمْ قاسَوا وَكَمْ صَبَرُوا",102,"ر",3,0],["واخفي الوجه والجسم النحيل","وسرنا يالحبيبه لا يذاع",103,"ع",1,0],["وأخفْت قيصر اذ نعئ املاكه","شدّ الرحال وآثر الترحالا",104,"ل",2,0],["وأخفض جناحاً للحبيب وطر به","من طار صباً بالجوى لا يخفضُ",105,"ض",1,0],["وَأخْفَيْتُ دَمْعي فِيكِ طِفلا صبيَّا","سأتْلُوا عَليْكِ الآنَ بَوْحًا نديَّا",106,"ي",2,1],["واخفضْ جناحَكَ للعبادِ تواضعأً","ما فازَ منْ سامَ الأنامَ تَكبُرا",107,"ر",2,0],["وَاخفِض جَناحَكَ لِلسَّلامِ فَما انتَهَت","فيكَ المُروءَةُ لو حَقَنتَ نِِكالا",108,"ل",2,0],["واخفض جناحك عنده متأدباً","يبقيك طول العمر عنده مفخرة",109,"ر",2,0],["وأخفيتُ النّبا عن أمها وأخٍ","أخاف عليهما أن يُعدَما الطَّربا",110,"ب",2,0],["واخفض جناحك للأيتامِ في أدبٍ","وارحم ضعيفاً شكى من لوعةِ السقمِ",111,"م",1,0],["واخفضْ جناحك للورى","ستنالُ خيراً يا (فَريدْ)",112,"د",1,0],["وَ أَخفَيتُ فِي جَنبَيَّ مَا هَدَّ أَعظُمِي","وَ مَا عَجِزَتْ عَنْ حَملِ أَثقَالِهِ الصَّخرُ )",113,"ر",1,0],["وأُخفِي فِي مَجَامِرِها","مَشَاوِيرِي عَن البَصَرِ",114,"ر",1,0],["وأخفانا وأبدانا","بتصريح وإيماء",115,"ا",2,0],["وأخفِّضُ الزفراتِ هي صواعد","وأُكفكفُ العبراتِ وهي جوار",116,"ر",1,0],["وَ أَخْفِضُ لِلْأَقْرَبِينَ جَنَاحًا","مُمِدًّا إِلَيْهِمْ يَدَ الْكَرَمِ",117,"م",1,0]]}