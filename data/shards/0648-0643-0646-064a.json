{"poems":[[55,"تشاهقن لما أن رأين بمفرقي","https://www.aldiwan.net/poem30118.html","الطويل"],[49,"وكنى الرسول عن الجواب تظرفا","https://www.aldiwan.net/poem25119.html","الكامل"],[63,"تصابى فأضحى بعد سلوته صبا","https://www.aldiwan.net/poem51769.html","الطويل"],[48,"أفوق البدر يوضع لي مهاد","https://www.aldiwan.net/poem23638.html","الوافر"],[102,"أحزان .. وإصرار","https://www.poetsgate.com/ViewPoem.aspx?id=50332",""],[128,"إن الزمان ولا أقول زماني","https://www.aldiwan.net/poem23705.html","الكامل"],[276,"أفي نيابتي برع تقيم","https://www.aldiwan.net/poem52116.html","الوافر"],[302,"نأى ففرق بين الطرف والوسن","https://www.aldiwan.net/poem33078.html","البسيط"],[310,"إلى بيتك اللهم بالعزم أقبلنا","https://www.aldiwan.net/poem56383.html","الطويل"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[563,"بحمد الله خلاق الوجود","https://www.aldiwan.net/poem34612.html","الوافر"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83309","الطويل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199616","المسحوب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/39004","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38194","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81892","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52046","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133938","المتقارب"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74098","الرمل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119676","الوافر"],[4384,"","https://poetry.dctabudhabi.ae/diwan/poem/145271","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133092",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58177","الطويل"],[4869,"رمح جساس","https://www.poetsgate.com/ViewPoem.aspx?id=151701",""],[4875,"موجات الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=133586",""],[4927,"الْحُبُّ وَ الْوُشَاْة","https://www.poetsgate.com/ViewPoem.aspx?id=29735",""],[5189,"كنْ يا أخي","https://www.poetsgate.com/ViewPoem.aspx?id=190549",""],[5455,"الأسرار","https://www.poetsgate.com/ViewPoem.aspx?id=34367",""],[5461,"لوعة العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=1322",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5751,"شَكوى مُسافر","https://www.poetsgate.com/ViewPoem.aspx?id=214716",""]],"verses":[["وَكُنَّ يُخَرِّقنَ السُجوفَ إِذا بَدا","فَصِرنَ يُرَقِّعنَ الحُروقَ إِذا طَلَع",0,"ع",1,0],["وَكَنى الرَسولُ عَنِ الجَوابِ تَظَرُّفاً","وَلَئِن كَنى فَلَقَد عَلِمنا ماعَنى",1,"ن",2,1],["وكنْ يا ابْنَ فَهْدٍ في الفُتوَّةِ عاذري","فما زِلتَ خِدْناً للفُتوَّةِ أو تِربَا",2,"ب",2,0],["وكُنّ يَرَيْنَ نارَ الزّنْدِ فيه","فلم يُبْصِرْنَ إذ وَرَتِ الزّنادُ",3,"د",1,0],["وكنيسان انطلقنا في الذّرى","نسفح الطيب يمينا وشمال",4,"ل",1,0],["وكنيسة العذراء أين مكانها","سيكون إن بعث اليهود مكاني",5,"ن",2,0],["وَكن يد نصرَتي وأَمان خَوفي","وَبلغني بجاهك ما أَروم",6,"م",1,0],["وكنّيا عن غَرامي في نشيدكما","فإن صَبا فاِذكراني لا رُزئتكما",7,"م",2,0],["وَكُن يا رسولَ اللّه مُستنجزاً لنا","مِنَ اللّه وَعدَ الفوزِ إذ بك قد لذنا",8,"ن",2,0],["وكن يا رب للحي","واغفر للذي مات",9,"ت",1,0],["وكن يا أيها الإنسان فيما","علمت من البطون إلى اللحود",10,"د",1,0],["وَكُن يَقِظاً لا تَستَنِم لِمَكيدَةٍ","وَلا لِكَلامٍ يُشبِهُ الحَقَّ باطِلُه",11,"ل",2,0],["وكنّي مواجع فيصلٍ وسعودي","واليوم ظاهر من خلاف كسيره",12,"ه",1,0],["وَكُن يا أَخا المَعروفِ في ذاكَ مُحسِناً","فَتَشكر عِندَ اللَّه ربّي وتُحمدا",13,"د",2,0],["وَكُن يا خَدينَ العَقلِ في الدَّهرِ راضِياً","بِما فيكَ شاءَ اللَّه رَبّي وَسلّمِ",14,"م",1,0],["وكنيتي أبو المعالي وكفى","من وضع آل البيت من آل الوفا",15,"ف",2,0],["وَكُنْ يَا مُرِيدِي حَافِظَاً لِعُهُودِنَا","أَكُنْ حَاضِرَ الْميِزَانِ يَوْمَ الْوَقِيعَةِ",16,"ه",1,0],["وَكَنَيْتُ عَنْهَا بِاللِّباسِ وإنَّهَا","لَيَّاشَةٌ قَالَ الحَكِيمُ مُجُرَّدِ",17,"د",1,0],["وكن يا رؤوف معيناً له","وأنقذه من كل أمرٍ وخيم",18,"م",1,0],["وكَنينا عنه تخواف العدى","تلفت الطرف لكانيه اِشتِفاءَ",19,"ا",2,0],["وَكَنِيَابَةٍ عَنِ الفِعلِ بِلاَ","تَأَثُّرِ وَكَافِتقَارٍ أُصِّلا",20,"ل",2,0],["وكن يوم القيامة لنا شفيعا","وسلِّكنا على أنقى زُقاق",21,"ق",1,0],["وكنيته بؤس وعيد كلاهما","ويوماي بؤس في هواه وعيد",22,"د",1,0],["وكن يا صاح حذراً من الوقت المقلب","فأزمانك عجيبه وشان أهليها أعجب",23,"ب",1,0],["وكنْ يا إلهي سيئاتي مبدِّلاً","بها حسناتٍ إنْ لهذا رجائيه",24,"ي",2,0],["وكنّي مآعآد احتآج بالوقت درّاس","دنيآي في بحرٍ .. وفكري غرفهآ",25,"ف",3,0],["وكنّي على متني توهّقت بطويق","عيب ان حذفته وان تناسيت ما طاح",26,"ح",1,0],["وَكُنْ يَقِظاً نَبِيْهاً، بَلْ جَلُوْداً","وَدَعْ ذَا النَّفْسِ، وَالْعَقْلِ الْمُطَاْشِ",27,"ش",1,0],["وكنْ يا أخي في الحياةِ نَصوحاً","وعبداً تقيّاً منَ الأكرمينْ",28,"ن",1,1],["وكني اللي .. كل ما أناديك بالاسم الفلاني","أطلب النسيان .. يترك منه شي تذكرينه !!",29,"ن",2,0],["وكني على غيره من الناس مغصوب","وكن العمر ياقف بليا ظنيني",30,"ن",2,0],["وكنيت ماحطم به الجوف ونتي","تناهيد من فرقاك بالجوف غايبه",31,"ب",2,0],["وكُنَّ يَطلُعنَ مِنْ أردانِ غربَتِهِ","وقُبلةً قُبلةً ألْقَينَهُ زَبَدا",32,"د",2,0]]}