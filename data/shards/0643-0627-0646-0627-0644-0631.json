poetry.dctabudhabi.ae/diwan/poem/103534","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3999,"","https://poetry.dctabudhabi.ae/diwan/poem/111596","الطويل"],[4155,"","https://poetry.dctabudhabi.ae/diwan/poem/178109","الطويل"],[4217,"","https://poetry.dctabudhabi.ae/diwan/poem/123954","الوافر"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18977","الطويل"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103133","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120355","الوافر"],[4767,"اختفاء المختار","https://www.poetsgate.com/ViewPoem.aspx?id=187661",""],[4802,"الرجولة","https://www.poetsgate.com/ViewPoem.aspx?id=32344",""],[4888,"زف الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=207759",""],[5044,"إذا لله لم يسق إلا الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=52088",""],[5105,"وإني لأستشفي بطيفٍ مُسَلِّمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=135340",""],[5213,"تنشقت بالدارات من مية عرفا","https://www.poetsgate.com/ViewPoem.aspx?id=170503",""],[5277,"عيد اليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=189702",""],[572,"كأن الرعود خلال البوق","https://www.poetsgate.com/ViewPoem.aspx?id=25011",""],[5409,"وطن يرانا الخير من غربائه","https://www.poetsgate.com/ViewPoem.aspx?id=155247",""],[5535,"عندي هوىً لك طال عمر زمانه","https://www.poetsgate.com/ViewPoem.aspx?id=201504",""],[5561,"إطلالة على الماضي والحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=197572",""],[5628,"حنين واشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=178259",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[5943,"سقم","https://www.poetsgate.com/ViewPoem.aspx?id=34295",""],[6068,"رشيد تونس -18-","https://www.poetsgate.com/ViewPoem.aspx?id=177481",""],[4701,"بلاغة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87361&r=&rc=1",""]],"verses":[["كَأَنَّ الرِماحَ بِأَعجازِها","يَمانِيَةٌ تَستَهِلُّ الغَماما",0,"م",2,0],["كَأَنَّ الرُمحَ يَصدُرُ مِنهُ عَدواً","عَنِ الأَجَمِيِّ ذي اللِبَدِ الكَليمِ",1,"م",1,0],["كَأَنَّ الرِياضَ الغُرَّ حَولَ بُيوتِهِم","ذِئابُ الغَضا يَمرَحنَ في كُلِّ مَروَدِ",2,"د",1,0],["كَأَنَّ الرُبى زَرَّت عَلَيهِ جُيوبَها","وَرَدَّتهُ مِن بَوغائِها بِرِداءِ",3,"ا",2,0],["كأنّ الرّبيعَ الطّلْقَ في حَجَراتِها","يُجَرِّرُ ذَيْلَ الأتْحَميِّ المُعَضَّدِ",4,"د",1,0],["كأنّ الرِّياضَ الحُوَّ يَنفُضْنَ فوقَها","شَقائِقَ فِيها مِن دُموعِ الحَيا نَقْطُ",5,"ط",1,0],["كَأَنَّ الرَحلَ مِنها فَوق جَأبٍ","يُقَلِّبُ آتُناً خُلُجاً حِيالا",6,"ل",2,0],["كانَ الرِضى وَأُعيذُهُ","أَن يَعقِبَ الكَونَ الفَسادُ",7,"د",1,0],["كأَنَّ الرَدى نَذرٌ عَلَيها مُؤَكَّدٌ","فَإِن أُسعِفَت بِالحَظِّ فيكَ وَفى النَذرُ",8,"ر",1,0],["كَأَنَّ الرِياحَ الذارِياتِ عَشِيَّةً","بِأَطلالِها يَنسِجنَ ريطاً مُسَهَّما",9,"م",2,0],["كَأَنَّ الريحَ تَثني حينَ هَبَّت","وَلَو ضَعُفَت بِهِنَّ فَروقَ ضالِ",10,"ل",1,0],["كأن الروح تمشي في تجاليدي","وأوصالي",11,"ل",2,0],["كَأَنَّ الرِياحَ الذارِياتِ عَشِيَّةً","بِأَطلالِها يَنسُجنَ رَيطاً مُرَسَّما",12,"م",2,1],["كَأَنَّ الرِقاقَ المُلحَماتِ ارتَجَعنَها","عَلى حَنوَةِ القُريانِ تَحتَ الهَمآئِمِ",13,"م",1,0],["كَأَنَّ الرَحلَ فَوقَ قَرا جَفولٍ","أَقامَ الماتِحانِ لَهُ الشِراعا",14,"ع",2,0],["كَأَنَّ الراحَ شُعشِعَ في زُجاجٍ","بِماءِ المُزنِ في رَصَفٍ ظَليلِ",15,"ل",1,0],["كَأَنَّ الرَحلَ فَوقَ أَقَبَّ جَأبٍ","بِأَجمادِ الشُرَيفِ لَهُ مَصامُ",16,"م",1,0],["كان الرذاذ الضَّحْل حول كِناسة","أشارير مِلح يَتَبعْنَ الرَّوامسا",17,"س",2,1],["كأن الرأس منها لم","يركَّب تحته عنق",18,"ق",1,0],["كَأَنَّ الرَيطَ فَوقَ ظِباءِ فَلجٍ","غَداةَ لَبِسنَ لِلبَينِ الثِيابا",19,"ب",2,0],["كان الربيعُ الحيُّ روحاً حالماً","غضَّ الشَّبابِ مُعَطَّرَ الجلبابِ",20,"ب",1,1],["كأن الريح جبار عنيد","يريد ليقلع الا كم الثقالا",21,"ل",2,0],["كَأَنَّ الراقِدينَ بِكُلِّ قاعٍ","هُمُ الأَيقاظُ وَاليَقظى النِيامُ",22,"م",1,0],["كَأَنَّ الرِمالَ عَلى جانِبَيكَ","وَبَينَ يَدَيكَ ذُنوبُ البَشَر",23,"ر",1,0],["كَأَنَّ الرَدى عادٍ عَلى كُلِّ ماجِدٍ","إِذا لَم يُعَوِّذ مَجدَهُ بِعُيوبِ",24,"ب",1,0],["كَأَنَّ الريشَ مِنهُ في سِهامٍ","عَلى جَسَدٍ تَجَسَّمَ مِن رِياحِ",25,"ح",1,0],["كَأَنَّ الرَدى يُسقى المُضَلَّلُ صِرفَهُ","مِنَ السَيفِ دَينٌ أَرهَقَ الوَقتُ واجِبُه",26,"ب",2,0],["كَأَنَّ الرِياحِيِّينَ حَيثُ لَقيتَهُم","وَإِن لَؤُموا أَصلاً قُرَيشُ بِطاحِ",27,"ح",1,0],["كَأَنَّ الريحَ وَالمَطَرَ المُناجي","خَواطِرَها عِتابٌ وَاِعتِذارُ",28,"ر",1,0],["كَأَنَّ الرِياضَ الحُوَّ يُكسَينَ حَولَها","أَفانينَ مِن أَفوافِ وَشيٍ مُلَفَّقِ",29,"ق",1,0],["كَأَنَّ الرُدَينِيّاتِ كانَ بُرودُهُم","عَلَيهِنَّ في أَيدٍ طِوالَ الأَجاشِعِ",30,"ع",1,0],["كَأَنَّ الرَحلَ مِنها فَوقَ صَعلٍ","مِنَ الظِلمانِ جُؤجُؤُهُ هَواءُ",31,"ا",2,0],["كانَ الرَجاءُ بِلُقياهُ يُعَلِّلُني","وَحادِثاتُ اللَيالي دونَ إِدراكي",32,"ك",2,0],["كانَ الرِضى بِدُنُوّي مِن خَواطِرِهِم","فَصارَ سُخطي لِبُعدي عَن جِوارِهِمِ",33,"م",1,0],["كأنّ الرياحَ الهوجَ راضوا شدادَها","أما ركبوها وهي لِينُ الشكائمِ",34,"م",1,0],["كَأَنَّ الرَبعَ أُلبِسَ عَبقَرِيّاً","مِنَ الجَنَدِيِّ أَو بَزِّ الجَروبِ",35,"ب",1,0],["كَأَنَّ الرَبابَ الجَونَ وَالفَجرُ ساطِعٌ","دُخانُ حَريقٍ لا يُضيءُ لَهُ جَمرُ",36,"ر",1,0],["كَأَنَّ الرَبابَ الجَونَ دونَ سَحابِهِ","خَليعٌ مِنَ الفِتيانِ يَسحَبُ مِئزَرا",37,"ر",2,0],["كَأَنَّ الرَوحَ وَالرَيحا","نَ فيهِ المِسكُ مَفتوتُ",38,"ت",1,0],["كَأَنَّ الرَحلَ شُدَّ بِهِ خَذوفٌ","مِنَ الجَوناتِ هادِيَةٌ عَنونُ",39,"ن",1,0],["كأنّ الرّكضَ أبْدى المحْضَ منه","فمَجّ لَبانُه لَبَناً صَريحَا",40,"ح",2,0],["كَأَنَّ الرَدى يَومَ العُروبَةِ إِذ مَضى","أَراني جِبال الأَرضِ فَوقَ أَرانِ",41,"ن",1,0],["كأنّ الرمالَ الْجاثماتِ بأرضِها","جِمالٌ أناختْ لا تُساقُ ولا تُحدَى",42,"د",2,0],["كأن الردى حاسد للمعا","ش وحتى على شظف الهابده",43,"د",2,0],["كأنَّ الرجال الأوس تحت لَبانِه","وما جَمعتْ جَلٌّ ، معاً ، وعتيبُ",44,"ب",1,0],["كأنَّ الرَّيحَ تثني حين هبّتْ","-ولو ضعفت- بهنَّ فروعَ ضالِ",45,"ل",1,0],["كَأنّ الرّدُيْنِيّاتِ، كانَ بُرُودُهُم","عَلَيْهِنّ في أيْدٍ طِوَالِ الأشَاجِعِ",46,"ع",1,0],["كأن الربيع الطلق جاد بنفسه","وغال قوى هذي الطبيعة غول",47,"ل",1,0],["كَأَنَّ الريقَ مِن فيها","سَحيقٌ بَينَ جِريالِ",48,"ل",1,0],["كأنّ الرسولَ المُسمِعِى نَغماتِها","رسولٌ تلا وحْياً من الله مُحكما",49,"م",2,0],["كأَن الرُّقَى مما عدِمت شفاءَها","تَعلَّمها الراقون من بعد وَسواسي",50,"س",2,0],["كَأَنَّ الرَزايا وَالمَنايا تَحالَفا","عَلى عَكسِ آمالي وَبَثِّ مَآلي",51,"ل",2,0],["كأن الرُّبا في الزهرِ والماء حولَها","قَلانسُ وَشْىٍ حولَهن طَيالِس",52,"س",1,0],["كأن الريح تنثره","على الأرضين في وَشْك",53,"ك",1,0],["كأن الردى إذ حجلَ الجندُ حولهُ","وقد عطشوا حوضٌ من الماءِ مترعُ",54,"ع",1,0],["كأنّ الراح وَردةُ جُلَّنارٍ","تبدّت في غِلالَةِ ياسَمِينِ",55,"ن",1,0],["كأنّ الرايَ حين أتَى طرياً","بأذناب كَمُحْمَرِّ العقيقِ",56,"ق",1,1],["كأنَّ الرِّماحَ سُكَارَى تجول","بها الخيلُ في النَّقْع قُبَّ الكُلَى",57,"ا",1,0],["كَأَنَّ الرَحلَ مِنها فَوقَ جَأبَ","شَنونٍ حينَ يُفزِعُها القَطيعُ",58,"ع",1,0],["كان الرشيدُ عليكِ يبسطُ ظلَّه","وإلى إشارتِه الورى ينقاد",59,"د",1,0],["كَأنَّ الرَّدَى آسٍ وهُنَّ مَبَاضِعٌ","تُريقُ دَمَ الباغِينَ مَهْمَا تَبَيَّغا",60,"غ",2,0],["كَأَنَّ الرِّياضَ عَذارى جَلَوْنَ","عَلَيْكَ مَلابِسَهُنَّ الْمِلاحا",61,"ح",2,0],["كَأَنّ الرُبى خودٌ وَقَد جادَها الحَيا","فَزادَ بِها تَوريد وَجنتها حُسنا",62,"ن",2,0],["كَأنّ الرّيحَ تَجري فِيهِ خَيلٌ","بِأيدِي الرَّاكِضَاتِ لَهَا شُموعُ",63,"ع",1,0],["كَأَنَّ الرِعاثَ وَالسُلوسَ تَصَلصَلَت","عَلى خُشَشاوَي جَأبَةِ القَرنِ مُغزِلِ",64,"ل",1,0],["كأنّ الرّبيعَ الطّلقَ والطّيرَ أصبحَتْ","لأيّامهِ تَدعو بمُخْتلِفِ اللُّغا",65,"غ",2,0],["كانَ الرَسولُ مَدينَةً هو بابُها","لَو أَثبَتَ النُصّابُ قَول المُرسَل",66,"ل",1,0],["كأنَّ الريحَ تأتيها برياً","حبيٍب قد تباعد منه شخصُ",67,"ص",1,0],["كأنَّ الرذاذَ الُحلوَ أشواقُ رفقةٍ","تعالوا وَحيُّونا وقد سكبوا المزنة",68,"ن",2,0],["كأنّ الربيعَ من صِفاتِك يمترِي","وشائعَهُ ومن سجاياك يَستقري",69,"ر",2,0],["كأَنَّ الرماح الذابلات مخاصر","لهم والدّلاص السابري غلائل",70,"ل",1,0],["كأن الربا كُوم كأن هزالها","لكثرة ما يغتالها الخف والنعل",71,"ل",1,0],["كَأَنَّ الرَكبَ إِذ طَرَقَتكَ باتوا","بِمَندِلَ أَو بِقارِعَتي قَمارا",72,"ر",2,0],["كأنّ الرّياحَ شَنَنّ النُّضار","وإمّا نَضَحْنَ سماءً بدَمْ",73,"م",1,0],["كأنّ الرَّبْعَ والخِرِّي","تَ يهديهمْ بلا هادِ",74,"د",1,0],["كَأَنّ الرّدى ما حُمّ إلّا لِصَلْوتي","وَلا خُلقتْ إلّا لِأَجلي العجائبُ",75,"ب",1,0],["كانَ الرَبيعُ إِذا ضَنَّ السَحابُ لَهُم","وَفي اللَوازِبِ مُرتاداً لِمُمتارِ",76,"ر",1,0],["كأن الرعود بأرجائه","هدير مقاليت في بطن واد",77,"د",1,1],["كأنّ الرياضَ الخضرَ فيه إِذا جرى","عليها بياضُ الطلِّ في صُفْرةِ الشمس",78,"س",1,0],["كأن الرزايا تجس الخلايا","تفتش عن أوحدي الزمن",79,"ن",1,1],["كأنَّ الرمي والمرميُّ شهب","تخر على شياطين بلمسِ",80,"س",1,0],["كأنَّ الرياح الهوج تُزجي غُديّةً","غمائمَ يملأن الفَلا وفَضاها",81,"ا",3,0],["كأنّ الريقَ منها سلسبيلٌ","يشابُ بماءِ غاديةٍ زلالِ",82,"ل",1,0],["كَأَن الرذاذ عَلى زَهرِهِ","يَفت مِن المسك أَو يَنثر",83,"ر",1,0],["كأن الرسوم البوالي بها","بقية شمس قبيل الافول",84,"ل",1,0],["كَأَنَّ الرَحلَ أَسأَرَ مِن قَرها","هِلالَ عَشِيَّةٍ بَعدَ السرارِ",85,"ر",1,0],["كأنَّ الروحَ منهُ طيبُ ذكرِ ال","عميدِ السيِّدِ الفردِ الأديبِ",86,"ب",1,0],["كانَ الرَّبيع لَهُم إِذا انتَجَعوا النَّدى","وَخَبَت لَوامِعُ كُلِّ بَرقٍ لامِحِ",87,"ح",1,0],["كأن الربى قد كن يبكين فرقتي","اشتياقا كمإ القطر من اعين الزهر",88,"ر",1,0],["كانَ الرَشيدُ المُعتَلي أَمرهُ","وَلّى عَلَيها المُشرِقُ الأَبلَجا",89,"ج",2,0],["كان الركاب انيخت على","جفوني فلما تزايلن زال",90,"ل",1,0],["كَأَنَّ الرُمحَ حينَ يُسَلُّ مِنهُ","وِجارٌ سُلّ مِنهُ الأُفعُوانُ",91,"ن",1,0],["كَأَنَّ الرَدى تَلقى بِهِ كُلَّما التَقَت","أَنامِلُهُ في مَعرَكٍ أَو حُسامُهُ",92,"م",2,0],["كأن الراح في يده عقيق","جرى في الكأس أو ذهب مذاب",93,"ب",1,0],["كأن الربيع له خالدٌ","فلا ينتهي عمرُ نيسانه",94,"ن",2,0],["كَأَنَّ الريشَ وَالفوقَينِ مِنهُ","خِلافَ النَصلِ سيطَ بِهِ مَشيجُ",95,"ج",1,0],["كَأَنَّ الرَحلَ مِنهُ فَوقَ جَأبٍ","أَطاعَ لَهُ بِمَعقلَةَ التِلاعُ",96,"ع",1,0],["كأنَّ الربيع غدا ناشراً","بمقدم موسى برود الهنا",97,"ن",2,0],["كَأَنَّ الرُعودَ لِلَمعِ البُروقِ","وَسَيرِ الغَمامِ لِصَوبِ المَطَر",98,"ر",1,0],["كَانَ الرُّقِيُّ إلَى الثُّرَيَّا مُصعِداً","مِن دُونِ تِلكَ النَّارِ فِي الإِمكَانِ",99,"ن",1,0],["كان الرَجاء بان يكون لنا","بهم العزاء فخيب الامل",100,"ل",1,0],["كَأَنَّ الرَّبا