ewPoem.aspx?id=206922",""],[5410,"ألوان باهتة","https://www.poetsgate.com/ViewPoem.aspx?id=133055",""],[3294,"وإذا ما سألت عني فإني","https://www.poetsgate.com/ViewPoem.aspx?id=173274",""],[3294,"ربع محا الحدثان رسمه","https://www.poetsgate.com/ViewPoem.aspx?id=173276",""],[5581,"فزورة","https://www.poetsgate.com/ViewPoem.aspx?id=22515",""],[5660,"ألا فَابْكِ يا عَيْنايَّ ما سَحَّ دَمْعُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=23707",""],[5690,"دع عنك تشبيباً بوصف محاجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=172161",""],[5691,"يعرب","https://www.poetsgate.com/ViewPoem.aspx?id=206081",""],[5694,"البيعة","https://www.poetsgate.com/ViewPoem.aspx?id=129888",""],[4623,"ذكر فان النفع في التذكار ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146607",""],[5939,"ظامئٌ لارتشافِكِ شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=178620",""],[5956,"من صفات الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=185778",""],[5976,"لبّاسة الكبّوس","https://www.poetsgate.com/ViewPoem.aspx?id=30397",""],[5984,"ان عثمان الكدود بن رشد","https://www.poetsgate.com/ViewPoem.aspx?id=200378",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[6093,"لاشَكَّ أنَّكِ مُلهِمَتي","https://www.poetsgate.com/ViewPoem.aspx?id=195415",""],[5309,"دهاني الهوى كاللص حاول","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573608",""],[6237,"عودة إلى الطبيعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77860&r=&rc=2",""]],"verses":[["يَمِلنَ مِنَ اللُغوبِ كَما تَهادى","نِساءُ الحَيِّ يُثقِلُها الخِدامُ",0,"م",1,0],["يَملَأُ عَيني فَيضُ الدُموعِ وَلا","عُذرَ لِعَينٍ حَتّى تَفيضَ دَما",1,"م",2,0],["يُمَلُّ الجُلوسُ وَيَفنى الحَديثُ","فَهَذا النَعيمُ وَإِلّا فَلا",2,"ا",1,0],["يُملي عَلَيها عَقلُهُ وَجَنانُهُ","ما لَيسَ يُنكِرُهُ هَوى وِجدانِهِ",3,"ن",2,0],["يَملَأُ الجَفنَةَ شَحماً","فَتَراها سَدِفَه",4,"ف",2,0],["يملك البت في الأمور ولكن","لا يقولون إنه مستشار",5,"ر",1,0],["يملأُ القلبَ صامتاً وتراهُ","يملأُ الصدرَ سائلاً ومجيبا",6,"ب",2,0],["يملأ رَوْحاً فؤاد سامعهِ","ويُصطلى حرُّه من القِررِ",7,"ر",1,0],["يملأ الآفاق من إس","دائه فيكم ونَيْره",8,"ر",2,0],["يملُّ القطيعةَ مُعتادُها","كما ملَّ من قبلِ ذاك الوصالا",9,"ل",2,0],["يَملُّ كلَّ شرابٍ من يُعاقِرُهُ","وشاربُ الراح مشعوفٌ بها عاني",10,"ن",2,0],["يملأ الدنيا هدى وندى","شيمَتي عثمان أو عمر",11,"ر",1,0],["يَملَأُ الأَسحارَ تَغريداً إِذا","صَرَفَ الطَيرَ إِلى الأَيكِ العِشاء",12,"ا",2,0],["يَملَأُ الجَوَّ عَزيفاً كُلَّما","ضَرَبَ الريحَ بِسَوطٍ وَالغَماما",13,"م",2,0],["يَملَأُ الآفاقَ صَوتاً وَصَدىً","كَعَزيفِ الجِنِّ في الأَرضِ العَراء",14,"ا",2,0],["يَملَأُ أَفواهَ مَدّاحيهِ مِن حَسَبٍ","عَلى السِماكَينِ وَالنَسرَينِ مَحسوبِ",15,"ب",1,0],["يَملَأُ الكُتبَ مِن مَعانٍ تُؤامٍ","وَفُرادى كَاللُؤلُؤِ المَعدودِ",16,"د",1,0],["يَملَأُ الواشي جَناني ذُعراً","وَيَعنيني الحَديثُ المُختَلَق",17,"ق",1,0],["يَمَلُّ هَذا الناسُ مَن قَد هَوَوا","وَوَصلُنا باقٍ كَما كانا",18,"ن",2,0],["يُمَلِّكُهُ خَزائِنَ كُلَّ أَرضٍ","وَلَم أَكُ يائِساً مِن أَن تُدالا",19,"ل",2,1],["يُملي عَلَينا المَعاني حُسنُ أَنعُمِهِ","كَأَنَّما عَلَّمَتنا ما بِهِ مُدِحَت",20,"ت",1,0],["يملأ جنبَ القرنِ من طعنةٍ","نَجْلاءَ يَرْغُو شِدْقُها وهو دام",21,"م",1,0],["يُمْلي لمن يُغْرَى به نقمَةً","بالبطءِ في النزعِ نفوذُ السهام",21,"م",1,0],["يملأون الظلامَ هَوْلاً فإن وضحَ الصب","حُ تولَّوا عن جانبيهِ انسِلالا",22,"ل",2,0],["يَمِلنَ بأهواء الغويِّ عن الهدى","ويَعلقنَ أسباب التقيِّ المتاركِ",23,"ك",1,0],["يَمَلُّ المرءُ صاحِبَهُ فَيشقَى","بِصُحْبَتِهِ وما بِكَ مِن مَلالِ",24,"ل",1,0],["يَملَأونَ السَماءَ مِن قَسطَلِ الحَر","بِ وَفي الأَرضِ مِن دَمٍ مَصبوبِ",25,"ب",1,0],["يُمِلّ بها السّباسِبَ والمَوَامي","فتىً لم تَخْشَ هِمّتُه مَلالا",26,"ل",2,0],["يَمِلنَ عَلَيَّ بِالأَقرابِ طَوراً","وَبِالأَجيادِ كَالرَيطِ المَصونِ",27,"ن",1,0],["يُملى له الحيف من حزب التقهقر ما","يمليهِ قسراً لسان النار للحطب",28,"ب",1,0],["يملأون الجوّ في الركضِ غُبارا","وقُبوراً ملأوا وجْهَ الصحارى",29,"ر",2,0],["يملأُ الدُّنيا فأَنَّى سِرْتُ","في الدُّنيا أَراهْ",30,"ا",2,0],["يَمْلأُ السَّمْعَ مُطْرِبَاتٍ وَمَهْمَا","يُسْتَعَدْ زَادَ لَذَّةَ المُسْتَعِيدِ",31,"د",1,0],["يَمْلأُ الْمَجْلِسَ احْتِشَاماً وَظَرْفاً","وَوِقاراً وَرِقَّةً وَدُعَابَا",32,"ب",2,0],["يَمَلُّ هَذا مِثلَ ما مَلَّ ذا","فَيَرجِعُ الوَصلُ كَما كانا",33,"ن",2,0],["يَمْلأُ الأرضَ وَالسَّماءَ رِيَاءً","وَعُيُوبُ الزَّمَانِ مِلءُ عِيابِهْ",34,"ب",2,0],["يَمْلِكُ النَّفْسَ أينَما نَظَرَتْه","فَهْوَ قَيْدُ النُّفُوسِ والنَّظَرَاتِ",35,"ت",1,0],["يملأ الدنيا حياةً إن بدا","كوكباً يسطع فيَّاضَ الضياء",36,"ا",2,0],["يملأُ السمع إن تحدَّثَ، والعيْ","نَ إذا لاح رَوْنَقًا، وَوَسَامه",37,"م",2,0],["يملأُ القلبَ حين يَبْدو لرائي","ه؛ فلا يستطيعُ إلا احترامه",37,"م",2,0],["يملي ويكتب والأشغال عارضة","ويوجز القول اعجاز فلم يرما",38,"م",2,0],["يملأ من دموع اليتامى","ويغنّي على نشيج الحزانى",39,"ن",2,0],["يملأ الكتب من معان تؤام","وفرادى كالؤلؤ المعدود",40,"د",1,0],["يَملي عَلى عَذب الغُصون الوكةً","مِن مُغرَم لِلعَهد لَيسَ بِناسي",41,"س",2,0],["يملك المرء قوله ولعمري","في الشؤنات ليس يملك قلبه",42,"ب",2,0],["يملُّ الدهرُ من يأسٍ وبأسٍ","وليس يمَلُّ من خيرٍ وخيرِ",43,"ر",1,0],["يملأ السمع والقلوب كما يز","عم رطب اللسان عذب الأداء",44,"ا",2,0],["يمُلْكٍ أثيلٍ في نعيمٍ مخلَّدٍ","وعيشٍ رغيدٍ بالتهاني مُجْملِ",45,"ل",1,0],["يَملِكُ المالَ ولكن","هو للمالِ أجِير",46,"ر",1,0],["يُمَلِّؤني وَعظاً هُزَالُ بِلاَلِ","واطعامُه للَّحمِ غيرَ حَلالِ",47,"ل",1,1],["يملن إلى الهجرانِ والبعدِ والنوى","ولا الميل إلاّ عادة الأغصُنِ الملدِ",48,"د",1,0],["يملؤونَ الوجود حُباً وحرباً","ويجوبونه بخُضْر الثِّيابِ",49,"ب",1,0],["يملّ ثواه الأقربون ويتدي","طريدا وقد ضاقت عليه المسالك",50,"ك",1,0],["يملي الَّذي أَملاهُ غَيرُ يراعه","وَيَقولُ ذا شعري ووحيُ رشادِهِ",51,"د",2,0],["يُملي عَلى الريحِ الهَبوبِ فِرارُهُ","وَيُعَلِّمُ الرِقَّ الخُفوقَ فُؤادُهُ",52,"د",2,0],["يَملَأُ الصَدرَ مَعاً وَال","عَينَ رَأياً وَرُواءا",53,"ا",3,0],["يُمِلُّ مَقاتِلَ الفُرسانِ قِدماً","بِأَلحاظٍ عَجيباتِ الأَمالي",54,"ل",2,0],["يملأُ العينَ فتغضي فَرَقاً","ويهولُ النفسَ حتى تستكينْ",55,"ن",1,0],["يَملا النديِّ سماحةً ورجاحةً","وَفصاحةً وفكاهةً بتحشّمِ",56,"م",1,0],["يملأ البشر وجهه الغضّ حسنا","ويزين الضياء منه جبينه",57,"ن",2,0],["يملأُ الحبّ قلبَه","من سنا وجهك المبين",58,"ن",1,0],["يَملأ لِبيدَ بأشياخهمْ","كُلُّ عيديٍّ نَجيبٍ وعُصَيْني",59,"ن",2,0],["يَملأُ عينَيْ مَن نظَر","فيه على العيسِ الخِيَر",60,"ر",1,0],["يُمِلي وأيدِي القَطْرِ تَنْسَخُ جودَه","ولَما يفوتُكِ يا قِطارُ الأكثَر",61,"ر",1,0],["يَملؤها شَرقُها ويَشربُها","جُنْحُ دُجاها والغَرْبُ يَكفْؤُها",62,"ا",3,0],["يَملي عَليَّ شُجونَهُ وَيَخطها","بِالدَمع طَرف بِالبُكاءِ خَليق",63,"ق",1,0],["يَملِكُ رقَّ القَريضِ قائِلُها","مُلكَ سليمانُ صَرح بلقيس",64,"س",1,0],["يَملأن جَوف مُتالعٍ ضرطاً","فضّاً يرُدُّ فضيضهُ الهضبُ",65,"ب",1,0],["يُملي عَلى مَن ليس يسمعُ قولَهُ","في الحبّ قولاً كله مطروحُ",66,"ح",1,0],["يملي علينا علمه","فَنُفِيدُ منه ونستفيد",67,"د",1,0],["يملأ القلبَ سروراً ويرى","منه في البحر إذا ما سار طائر",68,"ر",1,0],["يُمْلى وقد يملأ مسترسلاً","حقائبَ المُنجِدِ والمُتْهِمِ",69,"م",1,0],["يملّ ثواء أن يدوم له النوى","ويرجو لقاء أن يسجتمع الشمل",70,"ل",1,0],["يُملُّ عليه مؤتَمَنُ المعالي","مساعيَهُ فيَستَملي ويُملي",71,"ل",2,0],["يملُّني من حيثُ كاثرتهُ","ولو تفرَّقنا تمنَّانيا",72,"ي",2,0],["يملأ الصدرَ لساناً ويداً","ويصيب الرأيَ رَيْثاً وعَجَلْ",73,"ل",1,0],["يُمَلُّ مدحي ولا يُصغَى لمعتبتي","ولا يراقَبُ تخويفي وإنذاري",74,"ر",2,0],["يملأون الحُبا جُلوساً فإن ثا","روا ملأتَ الفضاءَ بِيضاً وسُمرا",75,"ر",2,0],["يملُّ خليلي طولِ جِدي تبرُّماً","ويكرهني من مِرَّتي خُلَصائي",76,"ا",2,0],["يملُّ هواهُ كلُّ سرْجٍ وسابحٍ","وتشكوا لياليه جَفاءَ النَّمارقِ",77,"ق",1,1],["يملأ الأنفسَ والأيدي اذا","هِيجَ أو سيلَ ردىً أو كَرَما",78,"م",2,0],["يمْلأُ اليومينِ سَلْماً وَوَغىً","شَرَفُ الدين نَوالاً وعَطَبْ",79,"ب",1,0],["يَمَلُّ هوايَ وبي لوعةً","تكلَّفُني أن أُحبَّ المَلُولا",80,"ل",2,0],["يملأُ الأَرضَ من رَقائِقِ حالي","بالطَّريقِ المُقَوَّمِ الأَحْمَدِيِّ",81,"ي",1,0],["يُمْلأُ من جُهْدِ روحي","صاعٌ ويُفْرَغُ صاعُ",82,"ع",1,0],["يَملأُ العينَ شخصُه حين يبدو","مِثلَما يَملأُ القُلوبَ حُبورا",83,"ر",2,0],["يملأ الدلو قبل دلو أخي النمرِ","وما حوضُ جار