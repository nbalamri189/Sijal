{"poems":[[75,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[53,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[72,"لك الله من وال ولي مقرب","https://www.aldiwan.net/poem43025.html","الطويل"],[45,"هو الزمان مننت بالذي جمعا","https://www.aldiwan.net/poem10628.html","البسيط"],[46,"أما إنه لولا الخليط المودع","https://www.aldiwan.net/poem30466.html","الطويل"],[119,"طريق المحبة كل الطريق","https://www.aldiwan.net/poem41706.html","المتقارب"],[280,"ألم ترها تسمو لأشرف غاية","https://www.aldiwan.net/poem25624.html","الطويل"],[280,"ظهيراك التوكل والمضاء","https://www.aldiwan.net/poem25645.html","الوافر"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[309,"خل إدكارك ربعا دارس الطلل","https://www.aldiwan.net/poem16847.html","البسيط"],[447,"على تالد الأيام لي طارف الحزن","https://www.aldiwan.net/poem14484.html","الطويل"],[466,"قريشي به تفخر","https://www.aldiwan.net/poem15689.html","الهزج"],[482,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[500,"حديقة الجو غضي هذه الحدقا","https://www.aldiwan.net/poem10251.html","البسيط"],[556,"ألا قل للوزير مقال مثن","https://www.aldiwan.net/poem47206.html","الوافر"],[556,"هو الزمان فلا عيش يطيب به","https://www.aldiwan.net/poem47772.html","البسيط"],[556,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[568,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[584,"رجواك في الله لاتخطأ مراميه","https://www.aldiwan.net/poem56780.html","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126896","المنسرح"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126856","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126771","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87183","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63723","الهزج"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107193","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59149","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72269","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48987","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100364","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100352","الرجز"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109789","الطويل"],[3008,"","https://poetry.dctabudhabi.ae/diwan/poem/103198","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109995","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114147","المتقارب"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127109","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58009","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139627",""],[5183,"المستميت على الأوطان","https://www.poetsgate.com/ViewPoem.aspx?id=180173",""],[5431,"تسلل ضوئي...","https://www.poetsgate.com/ViewPoem.aspx?id=202580",""],[5616,"شيخوخة","https://www.poetsgate.com/ViewPoem.aspx?id=203235",""]],"verses":[["هُوَ الزَورُ لَو تُعطى المُنى وَضَعَ القصا","لِيَزدادَ مِن حُسنِ الثَوابِ مُثابُ",0,"ب",1,0],["هو الزمنُ الذي أضحى وأمسى","أقلَّ اللَّه فيه مُنافسيكا",1,"ك",2,0],["هُوَ الزَهَرُ الغَضُّ الَّذي في كِمامِهِ","أَوِ اللُؤلُؤُ الرَطبُ الَّذي لَم يُثَقَّبِ",2,"ب",1,0],["هو الزمانُ منَنتَ بالذي جمَعا","في كل يومٍ ترى من صرفهِ بدَعا",3,"ع",2,1],["هُوَ الزَورُ يُجفى وَالمُعاشَرُ يُجتَوى","وَذو الإِلفِ يُقلى وَالجَديدُ يُرَقَّعُ",4,"ع",1,0],["هو الزاد في السير والمركب ال","قوي الموصل من قد تنبه",5,"ه",1,0],["هُوَ الزّمَنُ المَضروبُ للنّصْرِ مَوْعِداً","ومازالَ وَعْدُ اللّهِ ضَرْبَةَ لازِبِ",6,"ب",1,0],["هُو الزّمنُ الذي كُنْتُمْ وُعِدتم","تجلّى الحقّ فارتفع المراءُ",7,"ا",2,0],["هو الزاهد الملقى لدنياه خلفه","هو المجتزي منها بزاد المسافر",8,"ر",1,0],["هو الزمان الذي قد كان تحذره","أثمة الحق من حبر ومن بدل",9,"ل",1,0],["هو الزمان الذي لا خير فيه ولا","عرف تراه على التفصيل والجمل",9,"ل",1,0],["هو الزمان الذي عم الحرام به","والظلم من غير ما شك ولا جدل",9,"ل",1,0],["هو الزهد حتى خفت أن جهنما","لغيرك لم تخلق من الأنس والجن",10,"ن",1,0],["هو الزَّعْزَعُ في العَزْ","مِ وعند الحِلْمِ ثَهْلانُ",11,"ن",1,0],["هو الزمنُ الذي لم يُلْفَ فيه","مع الاحبابِ ضيرُ وامتهانُ",12,"ن",1,0],["هو الزمان أتى إلا على رمقي","وقد تطاول يبغي ذلك الرمقا",13,"ق",2,0],["هو الزّمنُ الّذي ما صحّ يوماً","لعانٍ في يديه من السَّقامِ",14,"م",1,0],["هُو الزّمان فَلا عيشٌ يطيب بهِ","ولا سرورٌ ولا صفوٌ بلا كَدَرِ",15,"ر",1,1],["هو الزّمنُ الّذي يُدْني ويُنئِي","ويُقعِي حين يُقعِي للوِثابِ",16,"ب",1,0],["هُوَ الزَكِيُّ الذَكِيُّ ال","حُسّانُ زينُ المَعالي",17,"ل",2,0],["هو الزَّمانُ هو الأَنحاءُ أَجمعُها","هو الوجودُ الذي تسمو مبانيهِ",18,"ي",2,0],["هو الزعيمُ الكريمُ سادَ على","أهلِ العلا فهو خيرة السدنِ",19,"ن",1,0],["هو الزعيمُ المفدّى من نؤمّله","يكونُ كَهفاً لنا دوماً ومُعتصما",20,"م",2,0],["هو الزعيمُ المُفدّى مَن له نسبٌ","زاكٍ وأصل عريق من بني مُضرِ",21,"ر",1,0],["هُوَ الزَمان وَلَكن كَم يَرى ترحاً","كَأَنَّهُ لِجَميع السُوء وَزّان",22,"ن",1,0],["هَوُ الزَمان إِذا ما رمت تَسأله","عَن نسبة قال جدي اليَوم مُطران",22,"ن",1,0],["هو الزهرُ وما الزهرُ","إذا ما قيسَ بالزَّهْر",23,"ر",1,0],["هُوَ الزاهِدُ المُبتاعُ خُلدَاً بِزائِلٍ","فيا رِبحَها مِن صَفقَةٍ ساعَةَ الحَشرِ",24,"ر",1,0],["هو الزهر لا والله بل هو أطيب","من الزهر حال الانتشاق وأنسم",25,"م",1,0],["هُوَ الزَّمَنُ المَضْرُوبُ لِلْحَقّ مَوْعِداً","وَمَا زَالَ وَعْدُ اللَّهِ ضربةَ مُحْكِمِ",26,"م",1,0],["هو الزاهد الموفى على كل زاهد","فما قطع الأيام بالشهوات",27,"ت",1,1],["هو الزارع الإصلاح في النيل فاْحصدي","سنابِلهُ لَّما تَشيبُ السَّنابِل",28,"ل",1,0],["هو الزبرقان البدر في غلَس الدجى","تهلل للساري على قتب الرحل",29,"ل",1,0],["هو الزمان اختشيه طارقاً","وهل فتى لا يختشي طوارقه",30,"ق",2,0],["هو الزهر لا يسقى ندى الزهر في الفلا","ولكنه يسقى الندى للخلائق",31,"ق",1,0],["هو الزر الذي إن بات ضيفاً","بصدرك لم تزل لك عولتان",32,"ن",1,0],["هو الزميعُ زَجَا رَكبَ المَنُونِ ضُحىً","وازمعَ السيرَ حُبّاً يُؤمِنُ الزَّمعا",33,"ع",2,0],["هُوَ الزَّادُ زَاداً تَزِيدُ بِهِ","إِلَيهَا وَتَقطَعُ غَوراً وَنَجدَا",34,"د",2,0],["هو الزاهد البكاء في خلواته","ولكنه البسام في ساعة الندى",35,"د",2,0],["هو الزهد في الدنيا وأن يملك الفتى","هواه فيغدو سيداً وهو ماجد",36,"د",1,0],["هو الزاخر الطامي الذي بعض ما به","أبى الحصرَ كالأعداد فالفضل واحدُه",37,"د",2,0],["هو الزمان كبير في إرادته","فيعتلي فإذا لا حظته هربا",38,"ب",2,0],["هو الزمان كبير في ارادته","لكن إذا ساعد التوفيق كان هبا",38,"ب",2,0],["هو الزهرُ والإدهاشُ حقلُ عذوبة","هو الجوع والإشباع خبزٌ مقرمشُ",39,"ش",1,0],["هو الزمان الذي عشناه فاكهة","وقبّراتٍ ولحناً رائعاً وصبا",40,"ب",2,0]]}