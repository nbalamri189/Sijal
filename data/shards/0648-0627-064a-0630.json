{"poems":[[55,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[69,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[96,"الكعبة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=12696",""],[203,"إن لم يكن عندك ما عندنا","https://www.aldiwan.net/poem45236.html","السريع"],[276,"صدوا عن الصب الكئيب واعرضوا","https://www.aldiwan.net/poem52111.html","الكامل"],[411,"شأنك يا دمع وانحدارك","https://www.aldiwan.net/poem49957.html","مخلع البسيط"],[556,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4679,"أيدري الدهر ما فعلت يداه","https://www.poetsgate.com/ViewPoem.aspx?id=142734",""],[4119,"هذي العزائم لا ما تدعي القضب","https://www.poetsgate.com/ViewPoem.aspx?id=16061",""],[5628,"يا ساكب الروح","https://www.poetsgate.com/ViewPoem.aspx?id=178466",""],[5689,"لا تنس أنا بأفق الغرب في قلق","https://www.poetsgate.com/ViewPoem.aspx?id=143417",""]],"verses":[["وَأَيُّ ذَنبٍ لِلَونٍ راقَ مَنظَرُهُ","إِذا أَراكَ خِلافَ الصِبغَةِ الأَثَرُ",0,"ر",1,0],["وَائْذَنْ لِسُحْبِ صلاةٍ مِنكَ دائِمةً","عَلَى النَّبيِّ بِمُنْهَلٍّ ومُنْسَجِمِ",1,"م",1,0],["وأيّ ذنوب ليس تمحى لشاعر","معنى بألوان الجمال طروب",2,"ب",1,0],["وأيُّ ذنبٍ للإناءِ الذي","يفيضُ إن أنتَ ملأتَ الإنا",3,"ن",2,0],["وائذن لمشتاق يزرك فانه","لا يَستَطيع من الكَبائر ينهض",4,"ض",1,0],["وأيَّ ذَنبٍ أتيتُ حتَّى","سُلِبْتُ من شِقْوَتي جِوارَكْ",5,"ك",1,0],["وأيُّ ذي خنْزُواناتٍ يُدِلُّ بها","بعُقْرِ دارك لم يُعْدَدْ من الخَوَلِ",6,"ل",1,0],["وَإيذومِنٌ مُذ رَآهُ تَقَدَّم","وَزَجَّ فَتَحتَ المِجَنِّ تَلَملَم",7,"م",1,0],["وَإِيذومِنٌ ظَلَّ في حَزمِهِ","يَكُرُّ بِعَزمٍ عَلى عَزمِهِ",7,"ه",1,0],["وَإيذومِنٌ مُستَجيشاً مَكَث","وَلَم يَرتَعِد كَالغُلامِ الحَدَث",7,"ث",1,0],["وَإيذومِنُ اِجتَرَّ ذاكَ المُثَقَّف","وَهَمَّ يُجَرِّدُهُ فَتَوَقَّف",7,"ف",1,0],["وإِيذِيُسٌ لِحِماهُ رَجَع","وقد غَصَّ بالنُّبَلا المُجتَمَع",8,"ع",1,0],["وَإِيذُمِنٌ مَع تِبعهِ مِريُنَ الذي","حَكى شِدَّةً آرِيسَ مُستَنزِفَ الدِّما",9,"م",2,0],["وإيذومنٌ إرماس أصاب","بفيه وفيه السرية غيب",10,"ب",1,0],["وأي ذوي العلاء سطا عليه","وأي عماد مكرمةٍ دهاهُ",11,"ا",2,0],["وائذن لموجك في تطهير ساحله","فإنما أنت بحر لجة لجب",12,"ب",1,0],["وأيّ ذكرى سرتْ نحوي تظللني","من أمسِ قد راح مفتونا بها خَلَدُ",13,"د",1,0],["وأي ذي عثرة تسليك زورته","كمثل وحي الأماني الحاذق اللبق",14,"ق",1,0]]}