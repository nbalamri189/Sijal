2,"إلى متى ؟","https://www.poetsgate.com/ViewPoem.aspx?id=202594",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[242,"جبل جللت ذراه الرياحين","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563764",""],[6210,"قالت لي الريح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7244&r=&rc=16",""],[6237,"الليل في الريف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77891&r=&rc=33",""],[4983,"أسرى بها الحبُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82961&r=&rc=1",""],[6311,"نغم المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63488&r=&rc=7",""],[6312,"خيبةٌ متكرِّرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82952&r=&rc=2",""],[5190,"إشارة حمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85037&r=&rc=112",""],[5567,"أبدو .. ولا أبدو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81749&r=&rc=21",""],[5567,"يغشى الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81772&r=&rc=40",""],[572,"قَدْ عَزَمْنَا على مباكَرَة ِ الشّر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9474&r=&rc=331",""]],"verses":[["يَمْتَطي أَبْطالُهُمْ مِنْ","هُنَّ أَثْباجَ الرِّياحِ",0,"ح",1,0],["يَمتَطونَ الخُطوبَ في طَلَبِ العَي","شِ وَيَبرونَ لِلنِضالِ السِهاما",1,"م",2,0],["يَمتّ للعرب ماضيها وحاضرها","بنسبة غضة في المجد والحسب",2,"ب",1,0],["يَمتَلُّ مَوفوراً وَيَمشي جانِباً","رَبِذاً يُسَلّي حاجَةَ الخَشيانِ",3,"ن",1,0],["يَمتارُ فِيَّ وَناظِري","ماشِئتَ مِن خَمرٍ وَوَردِ",4,"د",1,0],["يمتار من دمعي عليك ذوو البكا","فاعجب له من سائلٍ يتصدّق",5,"ق",1,0],["يمتاحُ من بحرٍ يهو","لُ العين حين ترى حِدابهْ",6,"ب",2,0],["يَمتَدُّ في جُنحِ الظَلامِ تَأَوُّهي","وَيَطولُ في أُذنِ الزَمانِ عِتابي",7,"ب",2,0],["يَمتُتنَ بِالقُربى إِلَيهِ وَعِندَهُ","فِعلُ القَريبِ وَهُنَّ غَيرُ قَرائِبِ",8,"ب",1,0],["يَمتَريهِ الثَناءُ وَالمَجدُ ما لَم","تَمرِ أَطباءَ ما يَليها الجَنوبُ",9,"ب",1,0],["يَمُتُّ بِكَفٍّ مِن عُتَيبَةَ أَن رَأى","أَنامِلَهُ رُكِّبنَ في شَرِّ ساعِدِ",10,"د",1,1],["يُمْتِعُ الطَّرْفَ من طَرائِفِ حُسْنٍ","يَتَجافى بها عن الإطراقِ",11,"ق",1,0],["يمتاحها ماضي الشباة مذلق","يجري بميدان الطروس فيسرع",12,"ع",1,0],["يَمُتُّ إليكم بالقَرابَةِ إنَّنا","عَشائِرُ قُربى حينَ تنأى العشائرُ",13,"ر",1,0],["يَمتَنُّ لِلقابِلي عَطاهُ وَلا","يُقَلِّدُ الوَفدَ في النَدى مِنَنَه",14,"ن",2,0],["يمتدُّ في الآفاقِ أو","يثوي على وجه الغُدُر",15,"ر",1,0],["يَمتَدُّ حَبلُ الأَسمَرِ الخَطِّيِّ في","يَدِهِ وَباعُ الأَبيَضِ البَتّارِ",16,"ر",1,0],["يَمتاحُ أَرواحَ الكُماةِ بِكَفِّهِ","شَطنٌ يُمَرُّ مِنَ القَنا مَفتولُ",17,"ل",1,0],["يَمتَريهِ جَذلانُ مُهتَبِلُ الغِرَّ","ةِ يُبدي حُزناً عَلى هابيلِ",18,"ل",1,0],["يمتلئ السطح على ضيقه","والوقت عندي كانفساح الأبد",19,"د",1,0],["يمتطي العْبقَرِيُّ ناجيةَ العز","مِ حثيثَ الْخُطا إلى غاياته",20,"ت",2,0],["يمتصّ بالقتل الحريريّ كما","يحتاج ، بالوحشة المسرفه",21,"ف",2,0],["يمتطي نفسه الضباب ، ويأتي","كالمسجّى ، يلقّن الصمت همسّا",22,"س",2,0],["يُمْتع الشاربين بالشُّرب فيه","وبلذَّات كلِّ قصفٍ وعَزفِ",23,"ف",1,0],["يَمتطي الشمسَ وَيَسعى","فوقَ هامات البُدور",24,"ر",1,0],["يمتون من نعماك فيهم بحرمة","إليك بها ما خاب من يتوصل",25,"ل",1,0],["يَمتاحُهُ راشِفُ بَردِ ريقِها","بَينَ بَياضِ الظَلمِ مِنها وَاللمى",26,"ا",1,0],["يَمُتُّ بِوُدٍّ مِن ضَميرٍ تَحُوطُهُ","عَواطِفُ أَرحامٍ إِلَيكُم شَوابِكِ",27,"ك",1,0],["يمتنع التمييز في جوره","ويصدا المسمع والناظر",28,"ر",1,0],["يَمتَطي كُلِّ صَعبَةٍ وَذَلولٍ","سَمِنٌ خالِدٌ عَلى الأَصلابِ",29,"ب",1,0],["يمتاز فعلُك بين أفعال الورى","تبراً ويترك ما سواه ترابا",30,"ب",2,0],["يَمتَدِحُ الكَنّافَ إِس","فافاً وَلا يَستَنكِفُ",31,"ف",1,0],["يَمُتُّ إِلَيكَ بِما لا يَمُتُّ","بِهِ اليَومَ مَولى إِلى صاحِبِ",32,"ب",1,0],["يَمْتَلِي قَلْبُ مَنْ رَآه ُسُرُوراً","وَتُدَلِّي لَهُ مُنَاهُ الأَفَانِينْ",33,"ن",1,0],["يمتد من بحر البحور محيطها","خير الأنام بعاجل وبآجل",34,"ل",1,0],["يَمَّتُهُ فَعَقَدتَ نِيَّةَ قاطِنٍ","أَوصافُهُ يَعقِدنَ نِيَّةَ راحِلِ",35,"ل",1,0],["يمتطي البحر والهواء","كما يركب طرق الحديد بل كل ركب",36,"ب",1,0],["يمتريك الشكُّ في راصعها","أجْمدَ العسجدَ فيها أم أسالَهْ",37,"ل",2,0],["يُمتَرَى ماؤه عُقاراً ويُستا","ف ثراه أَلُوَّةً وعبيرا",38,"ر",2,0],["يمت سيوفُ البرق وهي قواضبُ","فجرحنَ جفناً بالسهد كليلا",39,"ل",2,0],["يَمُتُّ عِندَ حُبولِ","إِلَيهِم بِالجِبالِ",40,"ل",1,0],["يَمْتَطِيْنَ الخِوَانَ أَرْؤسَ خِرْفَانٍ","وَيَنْزِلْنَ عَنْهُ بِيْضَ نَعَامِ",41,"م",1,0],["يَمتَصُّ أَفواهَ الأُيورِ بِفَقحَةٍ","وَيَبُثُّها في أَوجُهِ الجُلَساءِ",42,"ا",2,0],["يمتُّ بنفسٍ بل ببيتٍ مؤثّلٍ","وأفعالِ طاعاتٍ تفلُّ بها العِدا",43,"د",2,0],["يمتد للدين منه ما يشد وقد","تشاد منه لنشر العلم أبياتُ",44,"ت",1,0],["يَمتاحُ بالجودِ للممتاحِ كلّ لنا","فَلن يَزال منَ الممتاحِ مُمتاحا",45,"ح",2,0],["يمت في ملأ شم معاطسهم","أهل العبا وصفايا آل عدنان",46,"ن",1,0],["يمت بالنسب الوضاح من مضر","فهكذا حسنت صنعاً سجاياه",47,"ا",2,0],["يمتاز حبّي بالصدق والنصاعه","ماني من اللي في هواهم مراوين",48,"ن",1,0],["يمتد منها سره بلطايف","يقوى بها الإيمان والإسلام",49,"م",1,0],["يمتُّ في كل فن من شبيبته","إلى الحسانِ بحَبل غير مبتوتِ",50,"ت",1,0],["يمتدُّ منها لسانٌ","إلى السما متجلي",51,"ل",2,0],["يمتصصن الأزهار مبتلة من","شفة النهر أو فم الينبوع",52,"ع",1,0],["يمتد لو خلي ميدانه","وهل يخلى لينام القطا",53,"ط",2,0],["يمتاز ما بين المحالي إنه","سلطانها وجميعها أمراء",54,"ا",2,0],["يمتَدُّ عِثْيَرُهُ دُخاناً كلَّما","بَدَتِ الصَّوارمُ فيه ناراً تُحْتَضى",55,"ض",2,0],["يمتاز ختم الحقِّ عن ختمتنا","بما نرى فيه من النقش",56,"ش",1,0],["يمتص ماء لزرع مع تضييقه","أبدا عليه وليس ذا قنوان",57,"ن",1,0],["يمتصّ من هذا ويجري على","هذا لكي يقذف ما امتصه",58,"ص",2,0],["يمتطين الخوان أرؤس خرفا","ن وينزلن عنه بعض نعام",59,"م",1,1],["يمتحون الماء في أَذنبة","أَو تحييهم ملثات الغَوادي",60,"د",2,0],["يمت بالشرف الوضاح من فئة","توارثوا العلم أشياخا وشبانا",61,"ن",2,0],["يمتد في شرق يحد جزايرا","صلبين يمناه وأرض الموجة",62,"ه",1,0],["يَمُتّ بالثَلب والرَقاعة والسُ","خف وأمّا ما سِواه فَلا",63,"ل",2,0],["يَمتارُني ما يَشتهي ويُمِيرني","منه حَديثاً تارةً ونَشيدا",64,"د",2,0],["يمتّ بالثلب والرقاعة وال","سّخف وأمّا بغير ذاك فلا",65,"ل",2,0],["يمتدّ طرف الرشد نحوك شاخِصاً","يرتدّ طرف الغيّ عنك منكسا",66,"س",2,0],["يمتاز عن أقرانه في المكتبِ","تشمله بركةُ المؤدب",67,"ب",1,0],["يَمتطي في طِلابها فِقَرَ الاس","دِ ويمشي على نُيُوبِ الأَفاعِي",68,"ع",2,0],["يَمتَدُّ شأوُ القَول وَهوَ مقصِّرٌ","عَنهُ وَيُطلَقُ فيهِ وَهوَ مُقيَّدُ",69,"د",1,0],["يمت بفخر عن الوي بن غالب","اذا افتخرت قوم بقيس وكهلان",70,"ن",1,0],["يمتد فوق الشبر قدرَ الأصبع","والشبر قدر الباع صوب محبتي",71,"ي",1,0],["يمتاحه السيف عريانا فيصدره","مقمصاً بقميص أرجوانيّ",72,"ي",1,0],["يَمتَصُّ لا مُكتَفِياً دِماءَهُ","يَزرَدُ لا مُشتَفِياً أَحشاءَهُ",73,"ه",1,0],["يَمتازُ مَصروعُ اللِحاظِ عَنِ الَّذي","اِرداهُ مَطبوع الفُؤاد كَفور",74,"ر",1,0],["يَمتَدِرُ بابُها عَلى الخَضراءِ","كالقُطنِ عَلى بطانَةٍ زَرقاءِ",75,"ا",2,0],["يمتص كاسات الهوى مستحلياً","لو أن فيها مثل طعم العلقمِ",76,"م",1,0],["يَمْتاحُ من قلبِ القلوبِ دماءَها","بالسُّمرِ مَتْحَ الماءِ بالأشطانِ",77,"ن",1,0],["يُمِتنَ وَيُحيِينا الرضى فَزمانُنا","وَإِن جَلّ ما يَأتينَ يَأسٌ وَمَطمَعُ",78,"ع",1,0],["يمت من عامر في خير محتدها","ومن بني جمح في حية البلد",79,"د",1,0],["يَمتَنِع الجَيشُ بهِ ويحتمي","إذا امرؤٌ بالجيش والجُندِ احتمَى",80,"ا",1,0],["يمتلي إن حصل قصده طفيت التهابه","أو نقص شيء تراه مختبط في حسابه",81,"ب",2,0],["يمٌّ تدفَّق بالعلوم وإنما","فاض العراقُ برشحه والشام",82,"م",1,0],["يَمتطون الدربَ خيلاً حين تُحمَى","كم عليها صالَ ذو الْحق وجالا",83,"ل",2,0],["يمتد بدر التم من نوره","والشمس في الإشراق تحكي ضياه",84,"ا",2,0],["يَمْتدُّ طَوْراً ثُمَّ يُثْنى تَارَةً","مُتَعَرِّجاً كَتَعَرُّجِ الثُّعْبَانِ",85,"ن",1,0],["يَمتَطي صَهوةَ حرفٍ","مُعدمٍ يركضُ زُلفى",86,"ف",2,0],["يمتصني الصمت والأحزان تغزلني","في غيهب الليل ،سور الصبر ينهار",87,"ر",1,0],["يمتد ليلي واشعلك شمعة غلا بين اضلعي","ويمر بي طيفك ويتناثر بصدري واجمعه",88,"ع",2,0],["يَمْتَدُّ جُرْحيَ في فَضَائِكِ غَيْمَةً","أمطرْتُهَا وشذى العَواطِفِ زَاخِرُ",89,"ر",1,0],["يمتص فضل دمي ويرتع في","لحمي الزكي كأنه النسر",90,"ر",1,0],["يمتدُ طولاً وعرضاً","كي يملأ الأرض عدلا",91,"ل",2,0],["يمتطي المجدَ كلَ قلبٍ جسورٍ","شامخٍ في تأهبٍ للجهادِ",92,"د",1,0],["يمتصني وجع الحنين","مكثّفا وبلا عدَد",93,"د",1,0],["يمتّع من قطبٍ يُداخل قطبه","بجذبٍ كمونيٍّ من الغيب شاحنه",94,"ن",2,0],["يمتدّ حُزنٌ على أطرافِ بهجتنا","نمسي نُكفكفه فينا وينهرقُ",95,"ق",1,0],["يَمْتَرِي فِيهِ كُلُّ آسٍ وَ يُغْضِي","فَعُرَى البُرْءِ عَيْنُهَا إغْضَاءُ",96,"ا",2,0],["يَمْتاحُ بِالْجُودِ للمُمْتاحِ كُلَّ ثَنا","فَلَنْ يَزالَ مِنَ المُمْتاحِ مُمْتاحَا",97,"ح",2,0],["يمْتطي صَهْوَتَهُ مُمْتَشِقاً","في وجوهِ المُدَّعينَ القلَما",98,"م",2,0],["يمتَدُّ لا يستطيعُ النَّيلَ أيُّ مَدىً","مِنهُ ويجفِلُ حتماً مِنْ تَمَدُّدِهِ",99,"د",2,0],["يَمْتَدُّ بَحْراً في العُيونِ وَفِيهِ مِنْ","حُزنٍ يُشِيعُ على المَدى صَحراءَهُ",100,"ا",3,0],["يمتصُّ منكَ رحيقَ عمرٍ مزهرٍ","حتى يجفَّ العودُ فيك وينحني",101,"ن",2,0],["يمتدّ موجٌ في القلوب وراءه","موجٌ من الذكرى له استئنافُ..",102,"ف",1,0],["يَمتَدُّ كالثُّعبانِ - خَلفَ خَيالِهِ -","خَوفٌ ، وأكثرُ ما عَياكَ تَرَدُّدُهْ",103,"د",2,0],["يمتُّ إذا استَنْسَبْتَهُ بأبوَّةٍ","تمُدُّ بِبَاعٍ في الفخارِ طويلِ",104,"ل",1,0],["ى متى وحنينُ الشَّوْقِ يقتلني","ومن يداوي جِراح الروح بالتَّلفِ؟",105,"ف",1,1],["يمُت قبل أن يموتَ يحيى بربه","وما كان بعدَ الموتِ ذاك هو النقلا",106,"ل",2,0],["يَمتَلي قَلبُ مَن رَءاهُ سُروراً","وَتُدلّى لَهُ مُناهُ الأَفانينِ",107,"ن",1,0],["يمتد وادي الريح تحتي معتما","الريح تسكنه وفيه تغيب",108,"ب",1,0],["يمتد فوق تجاعيد وأفئدةٍ","فطرية العيش والعادات والسننِ",109,"ن",1,0],["يمتاح من صهوة الأحلام دهشتها","على ضفاف الهوى ترسو أمانيه",110,"ي",2,0],["يمتد ملحمة هواك فتلتقي","في كل شبر من فضائه مشربا",111,"ب",2,0],["يمتصُّني الحِبرُ والأفكارُ تَصرَعُني","حتَّى الكَواكبَ تُدميها اهتِزازاتي",112,"ت",2,0],["يَمتَدُّ بِي صَمتُ الكَلاَمِ ، ووِجهَتِي","مَا عُدتُ أَذكُرُهَا وأَينَ مَسَارُ",113,"ر",1,0],["يمتدُّ بي بصري فلا جهةٌ","تغتاله .. يعمى فأمتدُّ",114,"د",1,0],["يمتد في نزعات مضطربي","والنفس تنبش نشوتي نبشا",115,"ش",2,0],["يمتطينَ الحُوارَ أرْؤُسَ خِرْقا","نٍ وينزلنَ عنه بيضَ نَغَامِ",116,"م",1,0]]}