{"poems":[[55,"وذي ضغن معسولة كلماته","https://www.aldiwan.net/poem29846.html","الطويل"],[55,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[55,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[65,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[3,"إذا لعب الغرام بكل حُرٍّ","https://www.aldiwan.net/poem158.html","الوافر"],[3,"إذا ريح الصبا هبت أصيل","https://www.aldiwan.net/poem186.html",""],[3,"فؤاد ليس يثنيه العذول","https://www.aldiwan.net/poem193.html",""],[88,"يا كاسي الأخلاق في","https://www.aldiwan.net/poem68899.html","مجزوء الكامل"],[82,"في كنه قدرك للعقول تحير","https://www.aldiwan.net/poem31455.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[164,"في الصلح راسل دهر راح غضبانا","https://www.aldiwan.net/poem59080.html","البسيط"],[190,"عركتني الأيام عرك الدابغ","https://www.aldiwan.net/poem43622.html","الكامل"],[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[463,"نقيل مع الدنيا وقد أورقت لنا","https://www.aldiwan.net/poem55852.html","الطويل"],[463,"إذا لم يرع عندكم الوداد","https://www.aldiwan.net/poem56241.html","المتقارب"],[520,"يا أحسن الناس وجهاً","https://www.aldiwan.net/poem12067.html","المجتث"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48804","الرمل"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123694","الخفيف"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80220","الوافر"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79545","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95556","الكامل"],[2761,"","https://poetry.dctabudhabi.ae/diwan/poem/45537","الطويل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101236","الخفيف"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75716","الخفيف"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96064","الطويل"],[5302,"سأمضي","https://www.poetsgate.com/ViewPoem.aspx?id=200676",""],[5930,"شوك الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=92220",""],[520,"يا اكرم الناس وجها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577477",""]],"verses":[["عَرَكتُ بِحِلمي جَهلَهُ فَكَدَدتُهُ","عِراكاً إِلى أَن ماتَ حِلي وَجَهلُهُ",0,"ل",2,0],["عَرَكَت جَوانِبَنا الفَلاةُ وَأَسرَعَت","في العَظمِ وَاِقتاتَت شُحومَ البُزَّلِ",1,"ل",1,0],["عَرَكوا أَديمَ الأَرضِ قَبلَ نَباتِها","وَاِستَفسَحوا أَعطانَها وَتَفَيَّحوا",2,"ح",3,0],["عَرَكْتُ ذُنوبَ الحادِثاتِ بِجَنْبِهِ","فَهَبَّ مُشيحاً لا يُلائِمُ مَضْجَعا",3,"ع",2,0],["عَرَكتُ نَوائِبَ الأَيّامِ حَتّى","عَرَفتُ خَيالَها مِن حَيثُ يَسري",4,"ر",2,0],["عَرَكتُ نَوائِبَ الأَيّامِ حَتّى","رَأَيتُ كَثيرَها عِندي قَليلا",5,"ل",2,0],["عَرَكتُ النائِباتِ فَهانَ عِندي","قَبيحُ فِعالِ دَهري وَالجَميلُ",6,"ل",1,0],["عَرَكوا الزَمانَ وَأَهلَهُ","وَتَحَصَّنوا مِن كُلِّ طاري",7,"ر",2,0],["عَرَكَتْ أَديم الأَرضِ تَحتَ حَوافرٍ","صَخْرُ البلادِ بِوَطئِهِنَّ مُسَخَّرُ",8,"ر",1,0],["عَرَكَتْهُ عَارِكَةُ الصُّرُوفِ فَعَزْمُهُ","مُتَمَكِّنٌ كَشَوَامِخِ الأَجْبَالِ",9,"ل",1,0],["عركتني بالاذى عرك الاديم فما","راجيت في مؤمن بالله إيمانا",10,"ن",2,0],["عركتني الأيام عرك الدابغ","فلبستُ عنها ثوب حلم سايغ",11,"غ",1,1],["عركنا الدهر جيلا بعد جيل","وكابدنا الألوف من الصعاب",12,"ب",1,0],["عُرِكتَ بقرنٍ لا هَوادةَ عندَه","فعمَّق ما اسطاعَ الجروحَ وأثخنا",13,"ن",2,0],["عركتُ يدَ الخطوبِ وفيَّ ضعفٌ","فَلِنَّ وهنَّ أَعباءٌ شِدادُ",14,"د",1,0],["عركت آذان شعري","لما طغى وتحدى",15,"د",2,0],["عركوا الكل فساوى ال","آخرون الأولينا",16,"ن",2,0],["عركتنا عرك الأديم الكروب","وبسهم الردى رمتنا الخطوب",17,"ب",1,1],["عَركتَ الدَهرَ حَتّى صارَ عَبداً","لَدَيكَ لَهُ اِنقيادٌ وَاِمتِثالُ",18,"ل",1,0],["عركتني الأيامُ عَرْكَ الأديمِ","وتجاوَزْنَ بي مدى التقويم",19,"م",1,1],["عرك الزمان وكم أفا","ض بخبرة الدهر وتأه",20,"ا",2,0],["عَرَكناهُمُ عَركَ الأَديمِ فَمِنهُمُ","مُقَصٌّ بِأَيدينا وَآخَرُ مُزهَقُ",21,"ق",1,0],["عركتني الردى وأيدي الرزايا","فجرت من نواظري ينبوعا",22,"ع",2,0],["عركتني نَوائب الدهر حَتّى","تركتني مثقلا بالجراح",23,"ح",1,1],["عركتُ بجنبي قول خدني وصاحبي","ونحن على صهباءَ طيبّة النشر",24,"ر",1,0],["عركت النائبات ولي جهاد","يخف بفعله الحمل الثقيل",25,"ل",1,0],["عركتُ الحياةَ سنينا طِوالا","كشفتُ بها من أُناسٍ نفوسَا",26,"س",2,0],["عركت آذان شعري","لما طغى وتعدى",27,"د",2,0]]}