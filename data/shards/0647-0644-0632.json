{"poems":[[53,"يا ذا الذي كنيته كنيتي","https://www.aldiwan.net/poem64998.html","السريع"],[77,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[111,"ريب المنون مقارض الأعمار","https://www.poetsgate.com/ViewPoem.aspx?id=521",""],[111,"ريب المنون مقارض الأعمار","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545633",""],[123,"هل زيدت الشمس للأنوار أنوارا","https://www.aldiwan.net/poem4350.html","البسيط"],[398,"قلت وقد قيل بدا شعره","https://www.aldiwan.net/poem53533.html","السريع"],[463,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37859","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62460","الرمل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64592","الكامل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137861",""],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128005","الكامل"],[1852,"","https://poetry.dctabudhabi.ae/diwan/poem/141949","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96025","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77332","البسيط"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205435","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140080",""],[2974,"","https://poetry.dctabudhabi.ae/diwan/poem/198750","الكامل"],[3142,"","https://poetry.dctabudhabi.ae/diwan/poem/74136","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89107","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36242","الدوبيت"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94462","البسيط"],[4888,"حلب الشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=207762",""],[4984,"\" ليس الأدل \" 3","https://www.poetsgate.com/ViewPoem.aspx?id=175836",""],[5155,"أين الفتى السياب!؟","https://www.poetsgate.com/ViewPoem.aspx?id=176271",""],[307,"هلْ زجّ في الأملِ القنوطُ سقاما","https://www.poetsgate.com/ViewPoem.aspx?id=213805",""],[5413,"أحد عشر كوكبا","https://www.poetsgate.com/ViewPoem.aspx?id=208597",""],[5582,"نَهَكَ الغَرامُ فُؤادَهُ وَحَشاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187332",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6048,"مَا زِلتُ أَهّواهُ !","https://www.poetsgate.com/ViewPoem.aspx?id=198532",""],[6317,"هذا الجمال !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86083&r=&rc=1",""]],"verses":[["هل زائدٌ فيها على فسوةٍ","هل زائدٌ فيها على ضرطه",0,"ط",2,0],["هل زلّتِ الأقدامُ بعد ثبوتها","أمْ زاغتِ الأبْصارُ وهي تأمَّل",1,"ل",1,0],["هل زاد عيشك ذرة عن هذه","لو كنت في الدنيا على استبصار",2,"ر",1,0],["هل زاد في \" الخنساء\" الا كربها","شعر تردد ولبس صدار",2,"ر",1,0],["هل زاد في الخنساء إلا كربها","شعر تردده ولبس صدار",3,"ر",1,0],["هل زيدت الشمسُ للأنوار أنوارا","أم عادت الشُهبُ في الأفلاك أقمارا",4,"ر",2,1],["هَل زَغَبُ الحُسنِ لَهُ ضائِرٌ","ذا القَمرُ التمُّ بِهِ يَقمُرُ",5,"ر",1,0],["هل زورةٌ تُمتِعنا منكُمُ","وهناً بميعاد الكرى الباطلِ",6,"ل",1,0],["هَل زَوْرَةٌ تُحيي قَتيلَكَ بِالهَوى","فَهيَ الشِّفاءُ لِمَن بحبِّكَ قد دوي",7,"و",2,0],["هل زمان من بني برمك أو","من بني حمدان فينا يُستردّ",8,"د",1,0],["هل زاد أم نقصَ الحجاب أم استوى","وتراه من أي الجهات تَكَنَّفَه",9,"ف",2,0],["هل زدته لتسد موضع ما بدا","بأوامر الزحمان من نقصان",10,"ن",1,0],["هل زائل ذاك الجفا","ولذيذ وصلى راجع",11,"ع",1,0],["هل زَلزل الزلزال أم قد أُخرج الد","جّال أم عدمِ الرجالُ ذوو الهُدَى",12,"د",2,0],["هل زل رأيك أم رماك بخطبة","صرف الزمان وطارق المقدار",13,"ر",1,0],["هَل زارَ إثيوبيا مِن قَبلِها مَلَكٌ","حالي الذَوامِلِ باهي مَضربِ الخِيَمِ",14,"م",1,0],["هل زال من دنياي حسنٌ هزني","أم قر في قلبي لهيب النار",15,"ر",1,0],["هل زار الكرى مذ غبت عن نظري","وهل يزور الكرى جفنا ينافره",16,"ر",2,0],["هل زمَّلوا الجسد الطهور بعشقهم","أم إن نعي حبيبنا منحولُ",17,"ل",1,0],["هَل زورة تَشفي فُؤاد متيّم","يا أَهل مَكّة وَالحَطيم وَزَمزَم",18,"م",1,1],["هل زاجرٌ من ربه في خُلقه","إذ ما له عن ربه من زاجر",19,"ر",1,0],["هَل زين خُضرَةٌ نُجومٌ صُحُفٌ","أَم خُضرُ صَحائفٍ عشورَ الذَهَبِ",20,"ب",1,0],["هَل زار وجهاً عيونٌ مثل طلعتها","لها السوادُ وَالوجه الزهي الزَهَرُ",21,"ر",1,0],["هل زُلزلتْ زلزالَها وتمزّقتْ","أوصالُها وهوتْ ببئرٍ عاثرةْ",22,"ر",2,0],["هل زهرة في الدار عانقتها","تُبقي أريج الزهر لما ذبل",23,"ل",1,0],["هل زار(ديرته) المشوق","بعيد صد واغتراب؟!",24,"ب",1,0],["هلْ زجّ في الأملِ القنوطُ سقاما","وانسابَ في وهجِ الدما آلاما",25,"م",2,1],["هل زال شكك بالذي قلنا فقلتُ","نعمْ بشكٍّ يستمرُّ شهورا",26,"ر",2,0],["هَلْ زارَهُ بَعْدَ المَلا أَحَدٌ وَهَلْ","أَحَدٌ أَناخَ عَلَيْهِ أَوْ حَيَّاهُ",27,"ا",2,0],["هَلْ زَارَ بعدَكُمُ الرُّقَادُ مَحَاجِرِي","أو مَرَّ مُجْتازاً بها التهويمُ",28,"م",1,0],["هَلْ زالَ مَا كَان أمْ مَا زِلتُ أَهّواهُ ؟","قَلبي وَفِيٌّ وَذاكَ الحُب أَضْنَاهُ",29,"ا",2,1],["هل زارها الشعر .. حتى في مخيلة","وهل تنبه من قبلي .. لها العرب؟",30,"ب",1,0]]}