{"poems":[[53,"يا ذا الذي كنيته كنيتي","https://www.aldiwan.net/poem64998.html","السريع"],[77,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[111,"ريب المنون مقارض الأعمار","https://www.poetsgate.com/ViewPoem.aspx?id=521",""],[111,"ريب المنون مقارض الأعمار","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545633",""],[123,"هل زيدت الشمس للأنوار أنوارا","https://www.aldiwan.net/poem4350.html","البسيط"],[397,"قلت وقد قيل بدا شعره","https://www.aldiwan.net/poem53533.html","السريع"],[461,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"]],"verses":[["هل زائدٌ فيها على فسوةٍ","هل زائدٌ فيها على ضرطه",0,"ط",2,0],["هل زلّتِ الأقدامُ بعد ثبوتها","أمْ زاغتِ الأبْصارُ وهي تأمَّل",1,"ل",1,0],["هل زاد عيشك ذرة عن هذه","لو كنت في الدنيا على استبصار",2,"ر",1,0],["هل زاد في \" الخنساء\" الا كربها","شعر تردد ولبس صدار",2,"ر",1,0],["هل زاد في الخنساء إلا كربها","شعر تردده ولبس صدار",3,"ر",1,0],["هل زيدت الشمسُ للأنوار أنوارا","أم عادت الشُهبُ في الأفلاك أقمارا",4,"ر",2,1],["هَل زَغَبُ الحُسنِ لَهُ ضائِرٌ","ذا القَمرُ التمُّ بِهِ يَقمُرُ",5,"ر",1,0],["هل زورةٌ تُمتِعنا منكُمُ","وهناً بميعاد الكرى الباطلِ",6,"ل",1,0]]}