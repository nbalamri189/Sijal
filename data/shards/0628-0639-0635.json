{"poems":[[79,"بشرى يقوم لها الزمان خطيبا","https://www.aldiwan.net/poem36781.html","الكامل"],[90,"قضوا شهداء ليس لهم بواء","https://www.aldiwan.net/poem45035.html","الوافر"],[83,"طاول بجدك فالأقدار عنوان","https://www.aldiwan.net/poem61481.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85475","الطويل"],[132,"توفى بحر الجود والزهد والتقى","https://www.aldiwan.net/poem50512.html","الطويل"],[132,"توفى محمود الفضال ولينا","https://www.aldiwan.net/poem50622.html","الطويل"],[132,"توفى ركن الدين والعلم والهدى","https://www.aldiwan.net/poem50627.html","الطويل"],[132,"أيا سوقا فلو صورت شخصا","https://www.aldiwan.net/poem50670.html","الوافر"],[186,"دع مجلس الغيد الأوانس","https://www.aldiwan.net/poem67054.html","مجزوء الكامل"],[266,"يا ابن السرى والليل والبيداء","https://www.aldiwan.net/poem38377.html","الكامل"],[409,"قال عبد مسه طول الضرر","https://www.aldiwan.net/poem33934.html","الرمل"],[435,"بدا ينجلي تحت الغلالة والبرد","https://www.aldiwan.net/poem40517.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83316","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83313","الكامل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103064","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38964","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56285","الكامل"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143131","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203471","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129406","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129411","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129387","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117879","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77179","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123485","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91005","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94901","الوافر"],[5273,"معنى","https://www.poetsgate.com/ViewPoem.aspx?id=190510",""],[5273,"أضغاث معنى","https://www.poetsgate.com/ViewPoem.aspx?id=192312",""],[5363,"بعصى الجهاد تفجِّر الصحواتِ","https://www.poetsgate.com/ViewPoem.aspx?id=144288",""],[5387,"وقفة مع الذات","https://www.poetsgate.com/ViewPoem.aspx?id=53778",""],[5430,"وداعا سماحة الشيخ","https://www.poetsgate.com/ViewPoem.aspx?id=1444",""],[5776,"مسّني الشعرُ","https://www.poetsgate.com/ViewPoem.aspx?id=199457",""],[5956,"خوفٌ على الروحِ الوطنية","https://www.poetsgate.com/ViewPoem.aspx?id=192328",""]],"verses":[["بِعِصَابَةٍ يَمَنِيَّةٍ مَهْمَا انْتَمَتْ","فِي العُرْبِ كَانَ لَهَا الحُسَامُ نَسِيبَا",0,"ب",2,0],["بعصر الكهرباء أتت فأمسى","لعصر الكهرباء بها ازدهاء",1,"ا",2,0],["بِعُصبَةٍ أُنهِضوا لِلمَوتِ وَاِئتُمِنوا","عَلى الحِفاظِ فَما خانوا وَلا حانوا",2,"ن",3,0],["بعصر به الأقوام تنشط للعلى","أَرى البعض لا يَزداد غير جمود",3,"د",1,0],["بعصرِ إمامِ المسلمين وليِّنا","هو الشهم مولى عُرْبِها والأعاجِمِ",4,"م",1,0],["بعصرِ ابن سلطانِ بن سيفِ بن مالكٍ","إمام الهدَى سيف أخي العدّ والعددْ",5,"د",1,0],["بعصرِ ابن سلطان بن سيف بن مالكٍ","إمام الهدى سيف الكريم المؤيَّدِ",6,"د",1,0],["بعصر إمامنا ربِّ المعالي","بَلَعْرُبَ نسلِ سلطانَ الحسيبَا",7,"ب",2,0],["بَعَصائبٍ أَنِفُوا فَجا","دوا بِالنُفوسِ وَبِالنَفائِسْ",8,"س",1,0],["بعصابة يتسارعون إلى الوغى","سرد الوقايع شيّب الآراء",9,"ا",2,0],["بعصاه وبها البحر غدا","وهو قاع صفصف لما عبر",10,"ر",1,0],["بعصمه الفضي شاهدت صورةً","غداة وضعنا الكف بالكف للعهدِ",11,"د",1,0],["بِعَصرٍ يَفوتُ القوتَ فيهِ مُعِدَّهُ","وَيَعدِمُ وَردَ الماءِ مَن لا يُزاحِمُ",12,"م",1,0],["بِعُصبَةٍ غَرّاءَ كُلَّ مُهَذَّبٍ","هُوَ سِرُّ صُنعِ اللَهِ في الطافِهِ",13,"ف",2,0],["بعصمة غوث بل وفرد مخصص","وجمعهما قطب ضمين لما ظنا",14,"ن",2,0],["بِعُصبَةٍ مِن فسادٍ كانَ مَولِدهم","مِن كلِّ عاثٍ بِإِفراطِ الفَسادِ بَغى",15,"غ",2,0],["بعصا حديدٍ حيث تسحقهم بها","كأواني الفخار سحق الباسلِ",16,"ل",1,0],["بعصابة عرفت نباهة قدرها","في أن يمور على القنا ثامورها",17,"ر",3,0],["بعصم لا إله إلا اللّه","وعصم أسمائك عجل المدد",18,"د",1,0],["بعصر نور أفدّي أعصُرَ الظلم","إن راح يصبغ نور العصر لون دم",19,"م",1,1],["بعصر مليك صير الدهر منصفا","ولولا أياديه لما كان ينصف",20,"ف",1,0],["بعصر وزير العصر كم ذي جناية","تمسك في حبل من الصفح واثق",21,"ق",1,0],["بعصر ولي العصر كم من إجازة","تحرى له من فضله ليس ينكر",22,"ر",1,0],["بعصبة من ذويه الغر إن ركبوا","يوم الكريهة جالت خيلهم طربا",23,"ب",2,0],["بِعَصر تَقَضَّت فيهِ أَيّامُ صَبوتي","أُطارِح فيهِ مَن أَشاءُ بِلا اِزدِرا",24,"ر",2,0],["بعصبة إيمان حمتك من العدا","وباعتك نفسا فى رضا الله بالحرب",25,"ب",1,0],["بعصر بنوه الأكثرون قلوبهم","من الفقر أرض تربها الجيم والصاد",26,"د",1,0],["بعصر السّد الدبسِّ تمَّت","وفاقت بالزُهى عن كل زين",27,"ن",1,0],["بعصا التأوُّهِ شَقَّ بحرَ قصيدتي","وبمُهجَتى اثنيْ عَشْرَ جُرحاً فَجَّرا",28,"ر",2,0],["بِعَصَا التَّحَسُّرِ شَقَّ بحرَ قصيدتي","وبمُهجَتي اثْنيْ عَشْرَ جُرحاً فَجَّرا",29,"ر",2,0],["بعصى الجهاد تفجِّر الصحواتِ","تستنهض الإسلام بعد سباتِ",30,"ت",1,1],["بعصر الفلسِ ينسى الخل صاحبه","وينسى الإبن من رباه بالأمسِ",31,"س",1,0],["بعصرٍ كله همجٌ","رعاعٌ كلهم جزرُ",32,"ر",1,0],["بعصا الروحِ كم توكأتُ ،عكا","زُ دموعي إليّ عادَ حسيرا",33,"ر",2,0],["بعصرٍ لا يحاسَبُ فيه غازٍ","ولكنْ يرتجونه للغياثِ",34,"ث",1,0]]}