{"poems":[[57,"ألا أسعديني بالدموع السواكب","https://www.aldiwan.net/poem26543.html","الطويل"],[24,"ألا أسماء صرمت الحبالا","https://www.aldiwan.net/poem21875.html","الوافر"],[53,"أأبكتك المعاهد والمغاني","https://www.aldiwan.net/poem66430.html","الوافر"],[93,"لا نبغيض الروس لكن لا نحبهم","https://www.aldiwan.net/poem62766.html","عموديه"],[93,"ألا اسلمي يا دار من دار","https://www.aldiwan.net/poem62986.html","البسيط"],[40,"ألا اسلمي اليوم ذات الطوق والعاج","https://www.aldiwan.net/poem7694.html","البسيط"],[58,"ألا إسقنيها صاحبي وخليلي","https://www.aldiwan.net/poem58523.html","الطويل"],[30,"ألا استهزأت مني هنيدة أن رأت","https://www.aldiwan.net/poem5472.html","الطويل"],[17,"ألا أيها الضيفُ الذي عاب سادتي","https://www.aldiwan.net/poem1202.html",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[47,"ألا أسعديني بالدموع السواكب","https://www.poetsgate.com/ViewPoem.aspx?id=31397",""],[146,"ترى رائح يأتى بأخبار من غدا","https://www.aldiwan.net/poem58445.html","الطويل"],[193,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[240,"حث كؤوس الراح","https://www.aldiwan.net/poem32118.html","مجزوء الرجز"],[242,"ألا اسمع قد أجابتك الهداة","https://www.aldiwan.net/poem18096.html","الوافر"],[264,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[303,"أقول لصاحبي والشيخ يجثو","https://www.aldiwan.net/poem36285.html","عموديه"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62723","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122019","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122034","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95565","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48239","الوافر"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77335","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106879","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111270","المتقارب"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76044","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75881","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100184","الوافر"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46987","الوافر"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123925","السريع"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126969","الطويل"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21500","الطويل"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66107","الطويل"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132191","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139629",""],[5376,"مررْتُ الدارَ اسألُ عنْ صحابي","https://www.poetsgate.com/ViewPoem.aspx?id=188387",""],[5431,"طوفان عروبي...","https://www.poetsgate.com/ViewPoem.aspx?id=215568",""]],"verses":[["أَلا أَسعِديني بِالدُّموعِ السَواكِبِ","عَلى الوَجدِ مِن صَرمِ الحَبيبِ المُغاضِبِ",0,"ب",1,1],["أَلا أَسماءُ صَرَّمتِ الحِبالا","فَأَصبَحَ غادِياً عَزَمَ اِرتِحالا",1,"ل",2,1],["ألا أسقي دموعي دارَ ظَبْي","لو اسْتَسْقَيْتُ رِيقَتَه سقاني",2,"ن",2,0],["أَلا اِسمَعوا أَيُّها الأَلمانُ وَاِعتَبِروا","فَأَنتُمُ أَهلُ أَلبابٍ وَأَذهانِ",3,"ن",1,0],["ألا اسلمي يا دارُ من دارِ","تهيج أطرابي وأذكاري",4,"ر",2,1],["أَلا اِسلَمي اليَومَ ذاتَ الطَوقِ وَالعاجِ","وَالدَلِّ وَالنَظَرِ المَستَأنِسِ الساجي",5,"ج",2,1],["أَلاَ إِسْقِنِيها صاحبِي وخَليلي","شَمُولاً وهلْ أَحْيا بغيرِ شَمولِ",6,"ل",1,1],["أَلا اِستَهزَأَت مِنّي هُنَيدَةُ أَن رَأَت","أَسيراً يُداني خَطوَهُ حَلَقُ الحِجلِ",7,"ل",1,1],["أَلا اِسمَع لِفَخرٍ يَترُكُ القَلبَ مولِهاً","وَيُنشِبُ ناراً في الضُلوعِ الدَواخِلِ",8,"ل",1,0],["ألَّا استمعتَ إلى رفاقكَ ليلةً","والنارُ في مهجٍ وفي أكبادِ",9,"د",1,0],["ألا أسعديني بالدموع السواكب","على الوجد من صرم الحبيب المغاصب",10,"ب",1,1],["ألاَ استوهِبا لى الأرحبيَّةَ هَبَّة","لنُحدثَ عهدا أو لنضربَ موعدا",11,"د",2,0],["أَلا اِستحيتَ منَ المختار فيه وفي","آبائهِ وهم أنصارُ موكبهِ",12,"ب",2,0],["إِلّا اِستَباحوا عَنوَةً","مَعاقِلَ الأَرواحِ",13,"ح",1,0],["أَلاَ اسْمَعْ قَدْ أجَابَتْكَ الْهُدَاةُ","بِمَا تَعْنُو لِحُجَّتِهِ الْغُوَاةُ",14,"ه",1,1],["إلّا استعطفت على عبدٍ","يدعوك بمدمعه الذَّرِف",15,"ف",1,0],["أَلا استرها سُتِرْتَ فَضَحْتَ صبّا","أهاجَ بقلبِه الحبُّ السعيرا",16,"ر",2,0],["إِلا اِستَلَمَت النَدى مِن خَيرِ مُستَلِمِ","عَجَبَت مِن عابِثٍ في الصِدقِ قَولَهُ",17,"ه",1,0],["الا استباح الشوق هتكَ سرائري","شربت هواك جوارحي وستائري",18,"ي",1,0],["ألا اسمعوا ما قاله القصاب","قوم أجابوه لقد أصابوا",19,"ب",3,0],["أَلاَ أَسْدَتِ الأَحْلاَمُ فِي سِنَةِ الكَرَى","يَداً مَدَّ شُكْرِي كُلُّ شُكْرِي لَهَا يَدَا",20,"د",2,0],["أَلاَ أَسْعِدَا عَيْنِي عَلَى السُّهْدِ وَالْبُكَا","فَقَدْ وَاصَلَ السُّهْد الْمُبَرِّح تَذْكَارِي",21,"ي",1,1],["ألا أسبغ الله الشآبيب رحمة","على جدث فى جوفه الخلق الغرُ",22,"ر",1,0],["ألا اسلمْ ما شدا شادٍ طروبٌ","شكاني الكأسُ إذ عِفْتُ الزُّجاجا",23,"ج",2,0],["إِلا أَسارى وَصَرعى مِن حُماتِهِمُ","مِلءَ القليبِ وَتَحتَ النارِ لا الرجَمِ",24,"م",1,0],["إلا استقبليه صادق العهد وافياً","أميناً بلا وعد أتاك ولا نِدا",25,"د",2,0],["الا أسبلت وهو يشكو الظما","بغيث فتسقيه اسبالها",26,"ل",3,0],["أَلا اسمع أَخي وَاحفَظهُ إِن كُنتَ ذا عَقل","كَلامَ نَصيحٍ فاهَ بِالجَدِّ لا الهَزلِ",27,"ل",1,1],["أَلا أَسَداً يُردي الكلابَ زَئيرهُ","يَكون لَهُم بِالهنداونيِّ ماسِحا",28,"ح",2,0],["إلا استلمت الندى من خير مستَلم","جل الَّذي ببَديع الحسن جمَّله",29,"ه",1,0],["ألا أسعد بالسرور وبت","من النعمى على سرر",30,"ر",1,0],["أَلا اسْمَعْ فِي الأَميرِ مَقَالَ صدْقٍ","وَخُذْهُ عَنِ امْرِئٍ خدَم الأَمِيرا",31,"ر",2,1],["ألا اسلمي يا ربة الدمالج","ويا مهاة الرمل رمل عالج",32,"ج",1,1],["ألا اسعداني والسعادة منكما","وان لم أنها لن أكون سعيدا",33,"د",2,0],["أَلا اِستَأذَنَت لَيلى فَقُلتُ لَها لِجي","وَمالِكِ أَلّا تَدخُلي بَسلامِ",34,"م",1,1],["إِلاّ اسْتَلَمْتُ النَّدَى مِن خَيْرِ مُسْتَلَمِ","يَنامُ مُنْتَبِهَاً لِلْوَحْيِ مُجْمَلَهُ",35,"ه",1,0],["ألاَ أسَدٌ يَحْمِي العَرِينَ غَضَنْفَرٌ","صَبُورٌ على الأَهْوالِ يَلْظَى وَقِيدُها",36,"د",3,0],["ألا استودع الرحمن بدراً مكملاً","بفاس من الدرب الطويل مطالعه",37,"ع",2,1],["ألا اسلم فما يبقى على الدهر حاسدٌ","وذكرك ما بين البرية خالد",38,"د",1,0],["ألا أسفي على دارٍ أراها","بنارِ الوجدِ يحرقها لهيبُ",39,"ب",1,0],["ألا استكبارهم في الأرض بغيٌ","ومكرُ السوء بالباغي يحيقُ",40,"ق",1,0]]}