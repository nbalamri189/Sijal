{"poems":[[93,"أيار يا شاعر الشهور","https://www.aldiwan.net/poem8836.html","عموديه"],[30,"كالسامري يقول إن حركته","https://www.aldiwan.net/poem5243.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[93,"شاعر الشهور","https://www.poetsgate.com/ViewPoem.aspx?id=53070",""],[189,"لمن الشموس غربن في الأحداج","https://www.aldiwan.net/poem14137.html","الكامل"],[189,"وصادح في ذرى الأغصان نبهني","https://www.aldiwan.net/poem14615.html","البسيط"],[208,"يالك من معركة بالحاسي","https://www.aldiwan.net/poem53125.html","الرجز"],[308,"من منصفي من حبيب في محبته","https://www.aldiwan.net/poem57997.html","البسيط"],[463,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[469,"سل بين بانات الحمى وقدوده","https://www.aldiwan.net/poem3490.html","عموديه"],[511,"عيد بما يهوى الإمام يعود","https://www.aldiwan.net/poem2467.html","الكامل"],[556,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48770","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119879","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27883","البسيط"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105400","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58257","المجتث"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86315","الرجز"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118774","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135806","الرجز"],[4217,"","https://poetry.dctabudhabi.ae/diwan/poem/123949","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73286","الكامل"],[4830,"يازينب","https://www.poetsgate.com/ViewPoem.aspx?id=195354",""],[4858,"أوَ بعدَ دارِكَ في الدّنا من دارِ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=138208",""],[5277,"لولا","https://www.poetsgate.com/ViewPoem.aspx?id=198394",""],[5376,"لليل في سكناته أملُ","https://www.poetsgate.com/ViewPoem.aspx?id=188544",""],[5512,"الأم ( غفوت )","https://www.poetsgate.com/ViewPoem.aspx?id=204345",""],[5790,"لولا ادكار قدود أهل المنحنى","https://www.poetsgate.com/ViewPoem.aspx?id=112150",""],[5956,"المجدُ يركع","https://www.poetsgate.com/ViewPoem.aspx?id=192924",""],[5956,"ألمي عليك يفوق قدرة وصفي","https://www.poetsgate.com/ViewPoem.aspx?id=194552",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""]],"verses":[["لَولا لَظاهُ رَقَصتُ فيها","بِغَيرِ دُفٍّ عَلى سَريرِ",0,"ر",1,0],["لَولا لِساني حَيثُ كُنتُ رَفَعتُهُ","لَرَمَيتُ فاقِرَةً أَبا سَيّارِ",1,"ر",1,0],["لولا لوامِعُ من نُهىً وبصائر","تغزو كُهوفاً أو تَؤُمُّ وهادا",2,"د",2,0],["لولا لظاه رقصت فيها","بغير دفّ على سريري",3,"ر",2,0],["لولا لقاؤُك ما تَحمَّل كُلْفةً","في السيرِ بين مَهامِه وفِجاج",4,"ج",1,0],["لولا ليالٍ لنا بالبانِ سالفةٌ","كررتُ من زَفراتي فيه فاحترقا",5,"ق",2,0],["لولا لحاقي في الشديد الباسِ","الأسود السعديِّ ذي المراسِ",6,"س",1,0],["لولا لواحظه المرضى لما وجدت","لها المنايا إلى ارواحنا سبلا",7,"ل",2,0],["لولا لماها لما شفاني","بزمزمٍ ما سقىَ القليبُ",8,"ب",1,0],["لولا لطافتها ونشوةُ فضلها","ما اسودَّ وجهُ الخمر في عنقوده",9,"د",2,0],["لولا لزومُ الشَّرعِ لم نَحفَل بِهِ","إِذ كُلُّ يَومٍ في ذُراه لعيدُ",10,"د",1,0],["لولا ليالِي الخَيْفِ ما كان لنا","قلبٌ على حبِّ الغواني مُرْتَهَنْ",11,"ن",1,0],["لولا لقاء القوم فيك معوَّضاً","عنه لطال أساهمُ وتمادى",12,"د",2,0],["لولا لحاظ لها مراض","ماعرنت أعين النلبساء",13,"ا",2,0],["لولا لبانة موسى النور ما انقلبا","نارا وما أحرقت نبتاً وما التهبا",14,"ب",2,1],["لولا ليالٍ مال فيهن المنى","من أدركت فيه العلى آمالها",15,"ل",3,0],["لولا لماكَ لما كانَ","تَطّبيني المدامُ",16,"م",1,0],["لَولا لِمِصر نِصفُه","فيها لما خَيرٌ بَدا",17,"د",2,0],["لولا لعلّ وكذا كي قبل مه","وجرّ هذي بعضهم ما سلمه",18,"ه",1,0],["لولا لنا الدخولُ فيما يُنتَسَبْ","لك من العبيد والحمدُ وجبْ",19,"ب",1,0],["لولا لباس يقيه طرفي","لكان من لحظه يذوب",20,"ب",1,0],["لَولا لَواحِظُه لما حكمض الهوى","يوماً عليهِ ولا تعلَّلَ بالُمنى",21,"ن",2,0],["لولا ، لقلتُ بحقها معصومةٌ","لكنَّ حكمَ اللهِ فيهِ مأربُ",22,"ب",1,0],["لولا لقاءُ أحبّتي في سفرتي","ما كنتُ أختارُ النوى عن داري",23,"ر",2,0],["لولا لطائفُ خالقٍ بي راحمٌ","ماكنتُ ممّا مرّ بي فيمن نجا",24,"ج",2,0],["لولا ليال العشق من زمنٍ","لا الشعرُ كان ولا بدا الغزلُ",25,"ل",1,0],["لولا لنا قِبلةٌ في الدّين قد نَزَلتْ","لأسجدّنَ إلى الأحضان أقتبلُ",26,"ل",1,0],["لولا لواحظها لما حكم الهوى","يوما عليه ولا تعلل بالمنى",27,"ن",2,0],["لولا لديَّ مراسِمٌ وَدفاترٌ","لَمَضَتْ أحاسيسي وأشعاري سُدَىْ",28,"د",2,0],["لولا لديّ إيميلكم وجميلكم","لَأمُوتُ من كتْمي بما أنا أخفي",29,"ف",2,0],["لولا لم تكن لم تقم للدين قائمة","ولا اهتدى للهدى من أخطأ السبلا",30,"ل",2,0]]}