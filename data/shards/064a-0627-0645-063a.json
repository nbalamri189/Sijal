{"poems":[[51,"الطرف يقطف من خديك تفاحا","https://www.aldiwan.net/poem9422.html","البسيط"],[85,"ساجع الشرق طار عن أوكاره","https://www.aldiwan.net/poem62880.html","الخفيف"],[43,"أركائب الأحباب إن الأدمعا","https://www.aldiwan.net/poem9723.html","الكامل"],[45,"يا مغاني الأحباب صرت رسوما","https://www.aldiwan.net/poem65684.html","الخفيف"],[44,"يا مغرس الظرف وفرع الحسب","https://www.aldiwan.net/poem30569.html","الطويل"],[69,"بعلة السل توفي أخي","https://www.aldiwan.net/poem28563.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85470","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140861",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54828","الكامل"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5727","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[115,"يا مغيثي وعدتي ورجائي","https://www.aldiwan.net/poem41475.html","عموديه"],[115,"سيد الأولياء يا جداه","https://www.aldiwan.net/poem41776.html","الخفيف"],[135,"يا مغرما بالصرف","https://www.aldiwan.net/poem49037.html","المجتث"],[150,"كم في الدياجير من ذخر وفائدة","https://www.aldiwan.net/poem68518.html","البسيط"],[154,"خلال رحيل العمر","https://www.aldiwan.net/poem933.html",""],[231,"عدتي للحياة والموت والحشر","https://www.aldiwan.net/poem44583.html","الخفيف"],[235,"هل أنت يا أخت القضيب الناضر","https://www.aldiwan.net/poem31983.html","الرجز"],[270,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[364,"كتاب عبد إلى مولاه يعتذر","https://www.aldiwan.net/poem60915.html","البسيط"],[371,"دنا فزاد اشتعال الشوق بالبلل","https://www.aldiwan.net/poem57208.html","البسيط"],[403,"قال عبد مسه طول الضرر","https://www.aldiwan.net/poem33934.html","الرمل"],[432,"يا مغرما بنفيس الدر يجمعه","https://www.aldiwan.net/poem12658.html","البسيط"],[437,"راح يخشى في حبه الرقباء","https://www.aldiwan.net/poem2550.html","الخفيف"],[441,"نجمع والمجموع يكلا ويترك","https://www.aldiwan.net/poem14471.html","الطويل"],[448,"يا مغانى الوصل من سفح الغوير","https://www.aldiwan.net/poem53766.html","الرمل"],[458,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[556,"إلفان كانا في حياتهما وقد","https://www.aldiwan.net/poem2486.html","الكامل"],[562,"زر تربة في الحمى يا أيها المطر","https://www.aldiwan.net/poem52838.html","البسيط"]],"verses":[["يا مُغْلِقاً كلَّ بَابٍ منْه عن فَرَجِي","تركتَ للسُّقْمِ في أحْشَايَ مفْتَاحا",0,"ح",2,0],["يا مُغيثاً بِصَوتِهِ في الرَزايا","وَمُعيناً بِمالِهِ في المَكارِهِ",1,"ر",2,0],["يا مُغنِياً أَمَلَ الفَقيرِ لِقائُهُ","وَدُعائُهُ بَعدَ الصَلاةِ إِذا دَعا",2,"ع",2,0],["يا مَغاني الأَحبابِ صِرتِ رُسوما","وَغَدا الدَهرُ فيكِ عِندي مَلوما",3,"م",2,1],["يا مَغرِسَ الظَرفِ وَفَرعَ الحَسَب","وَمَن بِهِ طالَ لِسانُ الأَدَب",4,"ب",1,1],["يا مغمداً في التربِ مِنْ بيننا","أبكيكَ مسلولاً ومغمودا",5,"د",2,0],["يا مغاني الصبا وأرض شبابي","ما طلبت الفراق لَولا الدواعي",6,"ي",1,0],["يا مغنياً أمل الفقير لقاؤه","ودعاؤه بعد الصلاة إذا دعا",7,"ع",2,0],["يَا مَغْربَ المَاضي أَمَا مِنْ آيَةٍ","فَتَعُودَ فِي سَحَرٍ مِنَ الأَسْحَارِ",8,"ر",1,0],["يا مُغرَماً بِالسُمرِ ما","أَنا فيهِمُ لَكَ مُتَّبِع",9,"ع",1,1],["يَا مَغْرِبَ الأَمَلِ الْقَديمِ","وَمَشْرِقَ الأَملِ الْجَدِيدِ",10,"د",1,0],["يا مغيثي وعدتي ورجائي","ودوائي ان اوهن الجسم دائي",11,"ا",2,1],["يا مغيث الضعيف والعاجز ال","مذنب يا سيداه يا مرشداه",12,"ا",2,0],["يا مغرماً بالصرف","والنحوِ يكفي يكفي",13,"ف",2,1],["يا مُغنِيَ اللّيل نوماً والنهار عمى","متى تَفِيقُ ولا سمعٌ ولا بصرُ",14,"ر",1,0],["يا مغمدا ًفي الجوف كي تغتالني","ما ضر لو تهب المشيب ركامي",15,"م",2,0],["يا مغيث العطاش في الظمأ الأك","أخبرنا والناس في صدىً وكظاظ",16,"ظ",1,0],["يا مُغمِداً في القَلبِ سَيفَ لَحظِهِ","أَلِلَّهُ في دَمٍ بِغَيرِ ثائِرِ",17,"ر",1,0],["يا مغربيّةُ يا ذات الخفارةِ يا","ذات الحجابِ الذي فيه تُصانينا",18,"ن",2,0],["يا مُغْنِياً لي بآلاءٍ يُواصِلُها","إنّي إليك وإن أغنَيْتَ مُفتَقِر",19,"ر",1,0],["يا مُغرَماً بِالمَعالي لا سُلوَّ له","هذا وبينَكُما وصلٌ بِلا مَللِ",20,"ل",1,0],["يا مغيثاً كل من لاذ به","قد ذكرنا بعضهم ممن ظهر",21,"ر",1,0],["يا مُغْرماً بنفيسِ الدرِّ يجمعُهُ","ومولعاً بجميلِ البرِّ يصنعُهُ",22,"ع",2,1],["يا مغاني الأحباب حيث الغواني","أو طنو الهضب منك فالجرعاء",23,"ا",2,0],["يا مغرور وكيف تطيع الغرور انما","الحياة الدنيا إلا متاع الغرور",24,"ر",1,0],["يا مغانى الوصل من سفح الغوير","ذكر الله لياليك بخير",25,"ر",1,1],["يا مَغانِي الحمى سُقيتِ وما ين","فعُني الغيثُ أن يجودَكِ قَفْرا",26,"ر",2,0],["يا مَغرِبَ القَمَرَينِ لَيتَكَ مَطلِعٌ","أَولَيتَ أَولَيتَ الَّذي تُستَودَعُ",27,"ع",1,0],["يا مُغرَمينَ بها إن لم يكُنْ لكُمُ","خُبْرٌ فهل لم يأتِكم خَبَرُ",28,"ر",1,0]]}