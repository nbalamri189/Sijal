الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90869","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54385","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83444","الخفيف"],[4690,"وطني المَغْرِب","https://www.poetsgate.com/ViewPoem.aspx?id=179922",""],[4755,"هَا قَدْ أَسَالَ دَمِي.. وخَطَّا","https://www.poetsgate.com/ViewPoem.aspx?id=187695",""],[5283,"قلبان","https://www.poetsgate.com/ViewPoem.aspx?id=207571",""],[5452,"بلد الأخيار","https://www.poetsgate.com/ViewPoem.aspx?id=148454",""],[5652,"آل رشيد من شمر","https://www.poetsgate.com/ViewPoem.aspx?id=177737",""],[402,"أترون فوق مناكب الأدهار","https://www.poetsgate.com/ViewPoem.aspx?id=35550",""],[5848,"نكهة اعنابك","https://www.poetsgate.com/ViewPoem.aspx?id=53332",""],[6056,"قتيل البناتي","https://www.poetsgate.com/ViewPoem.aspx?id=130340",""],[6056,"الوجيه المكفهرّه","https://www.poetsgate.com/ViewPoem.aspx?id=156694",""],[463,"حيها أوجهاً على السفحِ غرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60067&r=&rc=123",""]],"verses":[["يا مُغْلِقاً كلَّ بَابٍ منْه عن فَرَجِي","تركتَ للسُّقْمِ في أحْشَايَ مفْتَاحا",0,"ح",2,0],["يا مُغيثاً بِصَوتِهِ في الرَزايا","وَمُعيناً بِمالِهِ في المَكارِهِ",1,"ر",2,0],["يا مُغنِياً أَمَلَ الفَقيرِ لِقائُهُ","وَدُعائُهُ بَعدَ الصَلاةِ إِذا دَعا",2,"ع",2,0],["يا مَغاني الأَحبابِ صِرتِ رُسوما","وَغَدا الدَهرُ فيكِ عِندي مَلوما",3,"م",2,1],["يا مَغرِسَ الظَرفِ وَفَرعَ الحَسَب","وَمَن بِهِ طالَ لِسانُ الأَدَب",4,"ب",1,1],["يا مغمداً في التربِ مِنْ بيننا","أبكيكَ مسلولاً ومغمودا",5,"د",2,0],["يا مغاني الصبا وأرض شبابي","ما طلبت الفراق لَولا الدواعي",6,"ع",2,0],["يا مغنياً أمل الفقير لقاؤه","ودعاؤه بعد الصلاة إذا دعا",7,"ع",2,0],["يَا مَغْربَ المَاضي أَمَا مِنْ آيَةٍ","فَتَعُودَ فِي سَحَرٍ مِنَ الأَسْحَارِ",8,"ر",1,0],["يا مُغرَماً بِالسُمرِ ما","أَنا فيهِمُ لَكَ مُتَّبِع",9,"ع",1,1],["يَا مَغْرِبَ الأَمَلِ الْقَديمِ","وَمَشْرِقَ الأَملِ الْجَدِيدِ",10,"د",1,0],["يا مغيثي وعدتي ورجائي","ودوائي ان اوهن الجسم دائي",11,"ا",2,1],["يا مغيث الضعيف والعاجز ال","مذنب يا سيداه يا مرشداه",12,"ا",2,0],["يا مغرماً بالصرف","والنحوِ يكفي يكفي",13,"ف",2,1],["يا مُغنِيَ اللّيل نوماً والنهار عمى","متى تَفِيقُ ولا سمعٌ ولا بصرُ",14,"ر",1,0],["يا مغمدا ًفي الجوف كي تغتالني","ما ضر لو تهب المشيب ركامي",15,"م",2,0],["يا مغيث العطاش في الظمأ الأك","أخبرنا والناس في صدىً وكظاظ",16,"ظ",1,0],["يا مُغمِداً في القَلبِ سَيفَ لَحظِهِ","أَلِلَّهُ في دَمٍ بِغَيرِ ثائِرِ",17,"ر",1,0],["يا مغربيّةُ يا ذات الخفارةِ يا","ذات الحجابِ الذي فيه تُصانينا",18,"ن",2,0],["يا مُغْنِياً لي بآلاءٍ يُواصِلُها","إنّي إليك وإن أغنَيْتَ مُفتَقِر",19,"ر",1,0],["يا مُغرَماً بِالمَعالي لا سُلوَّ له","هذا وبينَكُما وصلٌ بِلا مَللِ",20,"ل",1,0],["يا مغيثاً كل من لاذ به","قد ذكرنا بعضهم ممن ظهر",21,"ر",1,0],["يا مُغْرماً بنفيسِ الدرِّ يجمعُهُ","ومولعاً بجميلِ البرِّ يصنعُهُ",22,"ع",2,1],["يا مغاني الأحباب حيث الغواني","أو طنو الهضب منك فالجرعاء",23,"ا",2,0],["يا مغرور وكيف تطيع الغرور انما","الحياة الدنيا إلا متاع الغرور",24,"ر",1,0],["يا مغانى الوصل من سفح الغوير","ذكر الله لياليك بخير",25,"ر",1,1],["يا مَغانِي الحمى سُقيتِ وما ين","فعُني الغيثُ أن يجودَكِ قَفْرا",26,"ر",2,0],["يا مَغرِبَ القَمَرَينِ لَيتَكَ مَطلِعٌ","أَولَيتَ أَولَيتَ الَّذي تُستَودَعُ",27,"ع",1,0],["يا مُغرَمينَ بها إن لم يكُنْ لكُمُ","خُبْرٌ فهل لم يأتِكم خَبَرُ",28,"ر",1,0],["يا مُغيثي بِرَدِّ نحسيَ سَعدا","طالما قد رددتَ نحسيَ سعدا",29,"د",2,0],["يا مغرقي بالدمع لو يجري دمي","تحت اللواء هناك رحت سعيدا",30,"د",2,0],["يا مغرب الإسلام كيف غفلت عن","غرب النصارى في بلاد المشرقِ",31,"ق",1,1],["يا مغرب الإسلام فيك تعلةٌ","تسلي أخاك المشرق المغبونا",32,"ن",2,0],["يا مغرياً نفسي بوصفٍ غريرةٍ","أَغريتَ عاصيةً على مغريها",33,"ي",3,0],["يا مغاني اللهو والطرب","بأبي أفدي ثراك وبي",34,"ب",2,1],["يا مغيثي إذا ادلهمت خطوبي","جد بغوث به الرضا والإجابه",35,"ب",2,0],["يا مغيثي إذا ادلهمت خطوب","الدهر غثني وجد علي بالتفات",36,"ت",1,0],["يا مغيثي إذا ادلهمت خطوبي","بك قد لذت فاستجب دعواتي",36,"ت",2,0],["يا مغيث الخلق قد أودى البلا","ببني بنتك قد صاروا طير",37,"ر",1,0],["يا مغيث الملهوف يا راحم العب","رة يا منجي الغريق استجب لي",38,"ل",2,0],["يا مغضب اللاهي ومرضي اللَه ما از","دادت صفاتك بالثنا إيضاحا",39,"ح",2,0],["يا مغرقاً في الظلال","دنياك طيف خيال",40,"ل",1,1],["يا مغاني بيروت تيهي فخارا","واجر يا دهر أنت ملء العنان",41,"ن",1,0],["يا مغيث الملهوف يا من بعليا","ه التجأنا في البؤس والضراء",42,"ا",2,0],["يا مغرمين بمعجزات مؤلف","قد عز في هذي البلاد نظيره",43,"ه",1,1],["يا مغاني الصِّبا بباب حُناكِ","لا بوادي الغضا ووادي الأراكِ",44,"ك",1,1],["يا مُغيثا وكنت غيثا مريعا","صوت مستصرخ وربعا محيلا",45,"ل",2,0],["يا مَ غَقُّوا أَوطانهمُ","وَتَولّوا فيها الأَعلاجا",46,"ج",2,0],["يا مغني إن عندي كلّ غمّ","قم وألق النار فيها بالنغم",47,"م",1,0],["يا مغني قم فإنّ العمر ضاع","لا يطيب العيش إلاّ بالسماع",47,"ع",1,0],["يا مُغفِلاً نفسَهُ في جَنب منفعةٍ","للآخرين جُزيتَ الخيرَ والنِعَما",48,"م",2,0],["يا مغضي الأَجفان قم","لِلأمرِ واِنظر مِن كثب",49,"ب",1,0],["يا مُغصَّ البَيْداءِ كيفَ تبدَّلْ","تَ بها ضيقاً من الاوطَانِ",50,"ن",1,0],["يا مغيثي لدى الخطوب وغوثي","من زماني متى دهاني مريعا",51,"ع",2,0],["يا مُغِيثِي والنَّارُ تُوقَدُ بِالنَّا","سِ وَتَرْمِي شَرارَها المُسْتَطِيرَا",52,"ر",2,0],["يا مُغلياً بمديحِهِ لمحابِرٍ","والطرسِ والأقلامِ والأنقاسِ",53,"س",1,0],["يا مغرقي بنواله لا زال في","بحر الثناءُ على مقامك عومي",54,"م",2,1],["يا مُغزياً شملَ العدَى واللُّهَى","في جمعهِ الحمدَ بتَبْديدِ",55,"د",1,0],["يا مُغيثاً ما لي سِواهُ مُغيثُ","أَنتَ غَوثٌ لكلِّ من يَستَغيثُ",56,"ث",1,1],["يا \"مَغْربُ\" يَحميكَ المَوْلى","مَنْ رامَ أذًى شُلّتْ يَدُهُ",57,"د",2,0],["يا مُغمِضَ الأَرواحِ هَل","شَاهَدتَ مَنْ نادَى ونَطَّا؟",58,"ط",2,0],["يا مُغرقي في الحبِّ هلَّا صُغتَ لي","قلبًا كقلبكَ كي يكونَ المرصَدا",59,"د",2,0],["يا مَغْرِزَ الأخيار يا شام الذي","أثنى عليه الله بالآلاءِ",60,"ا",2,0],["يامغالطة هرج الصحيح ومعانيه","لحن البدو منا ليا قيل منا",61,"ن",2,0],["يا مغرب الماضي أما من آية","فتعود من سحر من الأسحار",62,"ر",1,0],["يا مغيّبتني وانا حاضر عن حضوري","ب اعلّم الشمس لا غابت عن غيابك",63,"ك",1,0],["يامغرّب ٍعني وأنا وجهتي شرق","ملفاك لي لو درت كل الجهاتي",64,"ت",2,1],["يامغيث اللي ببطن الحوت يا كاشف لضرّة","ترحم ، اللي بالعنا ، نفسه لنفسه مشقية",65,"ي",2,0],["يا مغاني الحمى سقيتِ وما ين","فعني الغيثُ أن يحودكِ فقرا",66,"ر",2,0]]}