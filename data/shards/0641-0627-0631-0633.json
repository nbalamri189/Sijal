المقيد","https://www.poetsgate.com/ViewPoem.aspx?id=104118",""],[5121,"كالفلك","https://www.poetsgate.com/ViewPoem.aspx?id=37452",""],[5121,"عُصْفُورُ الْجَنَّة","https://www.poetsgate.com/ViewPoem.aspx?id=49543",""],[5121,"ناي","https://www.poetsgate.com/ViewPoem.aspx?id=215580",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[5145,"سقى السرح من وادي الآراك هطول","https://www.poetsgate.com/ViewPoem.aspx?id=108051",""],[5183,"من طرائف المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180285",""],[5183,"بين القبر والمنبر","https://www.poetsgate.com/ViewPoem.aspx?id=180164",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5302,"ما أثلج الصدرا","https://www.poetsgate.com/ViewPoem.aspx?id=201896",""],[592,"سلام عيلكم كلما ذر شارق","https://www.poetsgate.com/ViewPoem.aspx?id=128853",""],[5397,"سالمت دهرا لا يريك التهانيا","https://www.poetsgate.com/ViewPoem.aspx?id=157960",""],[5397,"أهل بسط كف تحجب الشمس والبدرا","https://www.poetsgate.com/ViewPoem.aspx?id=157931",""],[5431,"وضمات الحنان فتلك نفلي","https://www.poetsgate.com/ViewPoem.aspx?id=185242",""],[5431,"وصلّت مع الضحكة التاسعة","https://www.poetsgate.com/ViewPoem.aspx?id=197802",""],[5533,"رسالةٌ للطُّغاة","https://www.poetsgate.com/ViewPoem.aspx?id=177314",""],[5544,"عمان اسعدي","https://www.poetsgate.com/ViewPoem.aspx?id=213441",""],[5582,"لِمَنْ بِطُلُولِ الأَبْرَقَيْنِ مُقامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187300",""],[5596,"السحمية","https://www.poetsgate.com/ViewPoem.aspx?id=206361",""],[5605,"مرثية محمود درويش","https://www.poetsgate.com/ViewPoem.aspx?id=159623",""],[5691,"طغى الجوْر","https://www.poetsgate.com/ViewPoem.aspx?id=206098",""],[5720,"الشعرُ رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=200844",""],[5742,"تهنئة زواج","https://www.poetsgate.com/ViewPoem.aspx?id=206898",""],[5785,"هيّج الشوق قمري في الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=131569",""],[5822,"تَمَادى الْقطر وَانْقطع السَّبِيل","https://www.poetsgate.com/ViewPoem.aspx?id=191659",""],[5842,"يا شام (د. جمال مرسي)","https://www.poetsgate.com/ViewPoem.aspx?id=65846",""],[5847,"تبسم","https://www.poetsgate.com/ViewPoem.aspx?id=14323",""],[5887,"أحيمد","https://www.poetsgate.com/ViewPoem.aspx?id=35261",""],[6004,"في يومها الوطني","https://www.poetsgate.com/ViewPoem.aspx?id=59596",""],[6046,"أنا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=35208",""],[6097,"إذا ضاقَتْ...","https://www.poetsgate.com/ViewPoem.aspx?id=197428",""],[5309,"من اعد العيش فوق السحب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573523",""],[6189,"مرثية للفارس المستقيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83558&r=&rc=25",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""],[6202,"سبعون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86728&r=&rc=29",""],[6262,"بقسوةٍ رُبَّما قصدوها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80106&r=&rc=4",""],[6265,"المهاجرة اليمنية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84177&r=&rc=0",""],[5567,"ذات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69072&r=&rc=10",""]],"verses":[["فَأَرسَلَها شَعواءَ تَقدَحُ نارَها","عَلى جَنَباتِ الأَمعَزِ المُتَزاوِرِ",0,"ر",1,0],["فَأَرسَلَ سَهماً عَلى فُقرَةٍ","وَهُنَّ شوارِعُ ما يَتَّقينا",1,"ن",2,0],["فارِسٌ في النَدى إِذا قَصَّرَ الفُر","سانُ عَنهُ وَفارِسٌ في الجَوابِ",2,"ب",1,0],["فارسلها تهوي رعالاً كانَّها","جَرَادٌ زَفَتْهُ ريحُ نَجْدٍ فأتْهَمَا",3,"م",2,0],["فارِسٌ يَضرِبُ الكَتيبَةَ بِالسَي","فِ إِذا أَردَفَ العَويلُ الصُياحا",4,"ح",2,0],["فارِسُ الحَربِ وَالمُعَمَّمُ فيها","مِدرَهُ الحَربِ حينَ يَلقى نِطاحا",4,"ح",2,0],["فأرسلت نظرةً رعشاءَ راجفةً","ترمي السهام وقلبي من رماياها",5,"ا",3,0],["فأرسلت اللحاظ إليه شَزْراً","وقلت له روَيدك يا غلام",6,"م",1,0],["فَأَرسِل في الضِئينَ مُجاشِعِيّاً","أَزَبَّ المِنخَرَينِ أَبا رِخالِ",7,"ل",1,0],["فارِسَي خَيلٍ إِذا ما أَمسَكَت","رَبَّةُ الخِدرِ بِأَطرافِ السِتِر",8,"ر",1,0],["فأرسلته مثل نهد الشباب","وودّي لو كانَ مثل الهرم",9,"م",1,0],["فارسُ المجدِ لم يزلْ غيرَ نُكرٍ","يركبُ المجدَ صعبهُ وذلولَهْ",10,"ل",2,0],["فَأَرسَلوهُنَّ يُذرينَ التُرابَ كَما","يُذري سَبائِخَ قُطنٍ نَدفُ أَوتارِ",11,"ر",1,0],["فارِسٌ ما غادَروه مُلحَماً","غَيرَ زُمَّيَلٍ وَلا نِكسٍ وَكَل",12,"ل",1,1],["فَأَرسَلَ النَبِيُّ كُلَّ مَن حَضَر","فَلَم يَرَوا كَما رَأى القِردُ خَطَر",13,"ر",1,0],["فَأَرسَلَت دُهاتَها وَلُدَّها","في الغَربِ سَدّوا عِندَهُ مَسَدَّها",14,"د",3,0],["فارِسَ الجَوِّ سَلامٌ في الذُرى","وَعَلى الماءِ وَمِن كُلِّ النَواح",15,"ح",1,0],["فارِسِيَّةً","بَزَّتِ العَرَب",16,"ب",1,0],["فارِسِيٌّ لَهُ مِنَ المَجدِ تاجُ","كانَ مِن جَوهَرٍ عَلى أَبرَوازِ",17,"ز",1,0],["فارِسٌ يَشتَري بِرازَكَ لِلفَخ","رِ بِقَتلٍ مُعَجَّلٍ لا يُلامُ",18,"م",1,0],["فارِسٌ يَضرِبُ الفَوارِسَ بِالسَي","فِ إِذا ما اِتَقَت جِبالُ الحَديدِ",19,"د",1,0],["فارِسٌ يُحسِنُ البَقِيَّةَ إِن أو","طِئَ أَعقابَ عَسكَرٍ مَهزومِ",20,"م",1,0],["فَأَرسَلَ في عَينَيهِ ماءً عَلاهُما","وَقَد عَلِموا أَنّي أَطَبُّ وَأَعرَفُ",21,"ف",1,0],["فأرسلَها على الصَّفصافِ يُخفي","سَنا أوضاحِها عنه الكَديدُ",22,"د",1,0],["فَأَرسَلتُهُ راجِياً أَنَّهُ","يُمَحِّصُ عَن زَلَّةِ المُرسِلِ",23,"ل",1,0],["فارسُ الماءِ والثرى والفتى المح","ضُ وصنوُ المروءة الأريحيِّ",24,"ي",1,0],["فأرسلْ لهُ الدينارَ فهْوَ طبيبُهُ","ومِنْ عجبِ الدنيا طبيبٌ مصفَّرُ",25,"ر",1,0],["فَأَرسَلَت أَروى وَقالَت لَها","مِن قَبلِ أَن تَرضى وَأَن تَقبَلا",26,"ل",2,0],["فَأَرسَلتُ أَن لا أَستَطيعُ فَأَرسَلَت","تُؤَكِّدُ أَيمانَ الحَبيبِ المُؤَنِّبِ",27,"ب",1,0],["فَأَرْسَلَ ما هذا الذي أنتَ قائِلٌ","قُلِ الحقَّ يا حَجّاجُ وَانْقَعْ بِهِ الصَّدَى",28,"د",2,0],["فارس الشَقراء يَجلو باسمها","غمرةً لَيلتُها ما تَنجَلي",29,"ل",2,0],["فاَرسل مِن فَوقَهُم حاصِباً","فَلفَّهمُ مِثلَ لفِّ القَزَم",30,"م",1,0],["فَأَرسَلَها رَهواً وَسَمّى كَأَنَّها","يَعاسيبُ ريحٍ عارِضاتُ الجَواشِنِ",31,"ن",1,0],["فَأَرسَلتُ مُنبَتّاً مِنَ الشَدِّ والِهاً","وَقُلتُ تَزَحزَح لا تَكونَنَّ حائِنا",32,"ن",2,0],["فارِسِ الخَيلِ العالِمِ العامِلِ ال","حبرِ الهمامِ الحُلاحِلِ النِّحْرِيرِ",33,"ر",1,0],["فَأَرسَلَت مِن فَمِ الإِبريقِ صافِيَةً","كَأَنَّما أَخذُها بِالعَينِ إِغفاءُ",34,"ا",2,0],["فَأَرسَلَت فيهِ فَغالَطتُها","بِخاتَمٍ مِن فِضَّةٍ أَخضَرِ",35,"ر",1,0],["فَأَرسَلَت حينَ كَلَّ الطَرفُ إِنَّهُمو","قَد نَوَّموا فَأتِنا إِن كُنتَ مُفتَأَدا",36,"د",2,0],["فَأَرسَلتُ دَمعي وَاِستَتَرتُ مِنَ الفَتى","مَخافَةَ نَمّامٍ عَلَيَّ كَذوبِ",37,"ب",1,0],["فَأَرسِل في بَني ذُبيانَ فَاِسأَل","وَلا تَعجَل إِلَيَّ عَنِ السُؤالِ",38,"ل",1,0],["فارِساً كانَ رُبَّ فارِسِ كِسرى","رَحَلَتهُ الخُطوبُ عَن شيدازِ",39,"ز",1,1],["فَأَرسَلتُهُ يَستَنهِضُ الماءَ سائِحاً","وَقَد غاضَ أَو يَستَنضِبُ البَحرَ إِذ طَما",40,"م",2,0],["فَأَرسَلَهُ مُستَيقِنَ الظَنِّ أَنَّهُ","مُخالِطُ ما تَحتَ الشَراسيفِ جائِفُ",41,"ف",1,0],["فَأُرسِلَ في دُهمٍ كأَنَّ حَنِيَنها","فَحِيحُ الأَفاعِي أُعجِلَت أَن تَحجَّرا",42,"ر",2,0],["فارس يضرب الكتيبة بالسي","ف دراكا كلاعب المخراق",43,"ق",1,0],["فارسُها يَسْبَحُ في لُجّةٍ","من دجْلَةَ الزّرْقاءِ أو مِن دُجَيْل",44,"ل",1,0],["فأرسلتْ مصرُ بنتُ النيل من دمِها","وَرداً تَزينُ به هامَ الصناديد",45,"د",1,0],["فأرسل العينَ في صمتٍ بلاغتُه","بكلِّ ما قال في دنياه سَحْبانُ",46,"ن",1,0],["فأرْسلَتْ مِنْ فَم الإبْريق صافيَة","كأنَّما أخذُها بالعينِ إعفاءُ",47,"ا",2,0],["فَأَرْسَلْتُ مثنياً عَنِ الشَّرِّ عَاطِفاً","وَقُلْتُ تَزَحْزَحْ لاَ تَكُونَنَّ حَائِنَا",48,"ن",2,0],["فارِسٌ أينَ وأُلافُ الصِّبا","أوَ هلْ يبقى على النأيِ أليف ؟",49,"ف",1,0],["فَارِسٌ يُحْسِنُ البَقِيّةَ إنْ أو","طِىءَ أعْقَابَ عَسْكَرٍ مَهْزُومِ",50,"م",1,0],["فارس يضرب الفوارس بالسي","ف إذا ما التقت جبال الحديد",51,"د",1,0],["فارسُ الماءِ والثرى والفتى المح","ضُ والمروءة الأريحيّ",52,"ي",1,0],["فارسٌ يضربُ الكتيبة َ بالسَّيف م","اذا ازدفَ العويلُ الصُّياحا",53,"ح",2,0],["فَأَرسَل الفتيا مَليك الوَرى","لِنَجل فَرفور عَلى رسلها",54,"ل",3,0],["فارس الغيب قطب دائرة القو","م امام الورى عظيم الشان",55,"ن",1,0],["فأرسلها سَهما على أمِّ رأسه","فتهوِى به سفلاً إلى أعمق القَعْرِ",56,"ر",1,0],["فَارسِل جَواباً سَالِماً مِن رَكَاكَةٍ","وَسُوءَ اتَّزَانٍ واجعَلَنَّ الرَّوِىًّ يَا",57,"ي",2,0],["فَأرسَلَ بِالهِجَاءِ ِإلَىَّ أيضاً","وذَلِكَ فِيهِ إيقَاظُ النِّيَامِ",58,"م",1,0],["فأرسلتَها من بابلٍ وكأنما","تُقلِقلُ من تحت السروج قَطاً كُدْرا",59,"ر",2,0],["فأرسِلِ الدَّمع عن خوفٍ وعن نَدَمٍ","يَمحُ الخلافَ الذي مازال يُستَطَرُ",60,"ر",1,0],["فَأَرسَلَهُ مَولاهُ لِلخَلقِ قُدوَةً","وَحينَ سَطا بالإِفكِ وَالزورِ سَطوَةً",61,"ه",1,0],["فأرسلت فيها من سعودك فيلقا","فمزقها شرقا ومزقها غربا",62,"ب",2,0],["فَأَرسلهُ بالحقِّ لِلخلقِ رحمةً","لِمُؤمِنهم كُبرى وكافرِهم صغرى",63,"ر",2,0],["فَأَرسَلَ وَحفاً حالِكاً وَحَمامَةً","وَما مُتَبَغّي الخَير إِلّا مُغَرِّرُ",64,"ر",1,0],["فَأَرسَلتَ فيهِ نَظرَةً نَفَذَت إلى","صَميمِ مُرادِ اللَهِ إِذ قُمتَ هاديا",65,"ي",2,0],["فارِسٌ مِن عَتادِهِ القُضُبُ الهِن","دِيَّةُ البيضُ وَالعِتاقُ الصُفونُ",66,"ن",1,0],["فأرسل عبد الله بالجيش غازياً","يحف به من قاذفي النار موكب",67,"ب",1,0],["فأرسل للغرب الدهينة داعياً","فكان غراباً بالمصائب ينعب",68,"ب",1,0],["فَأَرسَلَها مُستَيقِنَ الظَنِّ أَنَّها","سَتَحدِسُهُ في الغَيبِ أَقرَبَ مَحدِسِ",69,"س",1,0],["فأرسل خراجي ضمن خرجك سرعةً","ترى الروح يا ممنوح عجّل إسراعه",70,"ع",2,0],["فارِسٌ لَولا جُمودُ الدَّمِ في","سَيفِهِ أَجرى بِهِ في البَرِّ سُفنا",71,"ن",2,0],["فأرسلوا رسولا","يسأَله الوصولا",72,"ل",2,0],["فَأَرسَلَتْ لُؤْلُؤاً رَطْباً تُكفكِفُهُ","مِن فَوقِ مُخْتضِبٍ قَانٍ لِمُخْتَضِبِ",73,"ب",1,0],["فَأَرسلَ التَّيهمَ والطَّاوِى الحشَا","والجَوُّ ما قلَّصَ عَنه الغبشَا",74,"ش",2,0],["فارس الخَيل لا تَخال لَهُ في","مَجدِهِ غَير سَعدِهِ مِن قَرينِ",75,"ن",1,0],["فارساً ناظرَيْهِ قد أخَذا لي","صَوْلَجانَيْ صُدْغَيْهِ يرتكِضان",76,"ن",1,0],["فارِسٌ في مَواقفِ الجودِ ثَبْتٌ","تَقتُلُ المالَ كَفُّه والفَقرا",77,"ر",2,0],["فارِسُ مِنهُ عامِرُ بِلادُهُ","فَلا عَفا مِن بَيتِ مَجدٍ أَتلَدِ",78,"د",1,0],["فأَرسلنا رَبيئَتَنا فأَوفى","فقال ألا أُولى خَمسٌ رُتُوعُ",79,"ع",1,0],["فَأَرسَلتُ فَوقَ الريحِ مِنها طَوافِياً","وَأَمسَكتُ تَحتَ البَحرِ مِنها طَوافِيا",80,"ي",2,0],["فارِسُ ميدانِهِ الوَسيعِ وَما","يَجحَدُ ما أَدَّعي لَهُ الكُتُبُ",81,"ب",1,0],["فأَرسَلْتُ في تلْكَ الرَّيَا