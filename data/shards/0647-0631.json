{"poems":[[53,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[9,"بانت سعاد وأمسى حبلها رابا","https://www.aldiwan.net/poem21909.html","البسيط"],[9,"ودع هريرة إن الركب مرتحل","https://www.aldiwan.net/poem21969.html","البسيط"],[9,"هريرة ودعها وإن لام لائم","https://www.aldiwan.net/poem21978.html","الطويل"],[73,"شحطنا وما بالدار نأي ولا شحط","https://www.aldiwan.net/poem11909.html","الطويل"],[10,"ألا يا عين فانهمري بغدر","https://www.aldiwan.net/poem21078.html","الوافر"],[10,"هريقي من دموعك أو أفيقي","https://www.aldiwan.net/poem21116.html","الوافر"],[93,"ألشرق طال سباته الروحاني","https://www.aldiwan.net/poem11226.html","الكامل"],[30,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[88,"قد كانت الأغصان مخضرة","https://www.aldiwan.net/poem44411.html","السريع"],[72,"سهرت عليك لواحظ الرقباء","https://www.aldiwan.net/poem18175.html","الكامل"],[51,"زلقت في سلاحها","https://www.aldiwan.net/poem65472.html","مجزوء الخفيف"],[51,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[85,"رضاكم بالعلاقة لي كفيل","https://www.aldiwan.net/poem7893.html","الوافر"],[85,"هرتي جد أليفه","https://www.aldiwan.net/poem7999.html","مجزوء الرمل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[43,"لجنية أم غادة رفع السجف","https://www.aldiwan.net/poem9728.html","الطويل"],[45,"مغنيك للبغض فيه سمه","https://www.aldiwan.net/poem66635.html","البسيط"],[28,"وإن نقدت يداه فزل عنها","https://www.aldiwan.net/poem5240.html","الوافر"],[97,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[69,"أنا في حال نقيص","https://www.aldiwan.net/poem28679.html","مجزوء الرمل"],[69,"قف وقفة المتألم المتأمل","https://www.aldiwan.net/poem28749.html","الكامل"],[102,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[46,"إستنبط العرب لفظا وانبرى نبط","https://www.aldiwan.net/poem22204.html","البسيط"],[46,"عيشتي سلتي ورمسي غمدي","https://www.aldiwan.net/poem23542.html","الخفيف"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72201","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142069","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43655","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54250","الرمل"],[3,"هَلْ غَادَرَ الشُّعَرَاءُ منْ مُتَرَدَّمِ(معلق","https://www.poetsgate.com/ViewPoem.aspx?id=10032",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[9,"معلقة الأعشي","https://www.poetsgate.com/ViewPoem.aspx?id=11407",""],[72,"سهرت عليكِ لواحظُ الرقباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=57649&r=&rc=7",""]],"verses":[["هَرَقتَ دِماءً ما لَها الدَهرَ طالِبٌ","كَما هَرَقَت خَرقاءُ قَعبَ لِبانِ",0,"ن",1,0],["هِرٍ جَنيبٍ كُلَّما عَطَفَت لَهُ","غَضَبى اِتَّقاها بِاليَدَينِ وَبِالفَمِ",1,"م",1,0],["هِركَولَةٌ مِثلُ دِعصِ الرَملِ أَسفَلُها","مَكسُوَّةٌ مِن جَمالِ الحُسنِ جِلبابا",2,"ب",2,0],["هِركَولَةٌ فُنُقٌ دُرمٌ مَرافِقُها","كَأَنَّ أَخمَصَها بِالشَوكِ مُنتَعِلُ",3,"ل",1,0],["هُرَيرَةَ وَدَّعها وَإِن لامَ لائِمُ","غَداةَ غَدٍ أَم أَنتَ لِلبَينِ واجِمُ",4,"م",1,1],["هَرِمتُ وَما لِلشَيبِ وَخطٌ بِمَفرِقي","وَكائِن لِشَيبِ الهَمِّ في كَبِدي وَخطُ",5,"ط",1,0],["هَرَيتِ الشَدقِ رِئبالٍ إِذا ما","عَدا لَم تُنهَ عَدوَتُهُ بِزَجرِ",6,"ر",1,0],["هَريقي مِن دُموعِكِ أَو أَفيقي","وَصَبراً إِن أَطَقتِ وَلَن تُطيقي",7,"ق",2,1],["هُرِعَ الزَّمَانُ بِنَا فَمَا مِنْ مُهْلَةٍ","لِلوَادِعِ الرَّاضِي وَلا لِلوَانِي",8,"ن",2,0],["هَرَقناهُ في بادي النَشيئَةِ داثِرٍ","قَديمٍ بِعَهدِ الناسِ بُقعٍ نَصائِبُه",9,"ب",2,0],["هرّب منه تلكم الأنجما","علام قد غيّم ليل الشتا",10,"ت",2,0],["هرَقتْ دمَ المحلِي المروِّعِ والعدَى","حتى بدَتْ في أهبةٍ حمراء",11,"ا",2,0],["هرمت فهي في قيو","د من الكبر ترسُف",12,"ف",1,0],["هربت منك المودّا","ت على ظهر البراق",13,"ق",1,0],["هرعنا والقلوب يثبن وثبا","وللعبرات بالبشرى مسيل",14,"ل",1,0],["هِرَّتي جِدُّ أَليفَه","وَهيَ لِلبَيتِ حَليفَه",15,"ف",2,1],["هَرِمَت دَولَةُ القَياصِرِ وَالدَو","لاتُ كَالناسِ داؤُهُنَّ الفَناءُ",16,"ا",2,0],["هَراقَت دَمي مَن بي مِنَ الوَجدِ ما بِها","مِنَ الوَجدِ بي وَالشَوقُ لي وَلَها حِلفُ",17,"ف",1,0],["هِراشٌ نُعانيهِ طولَ النَهارِ","فَمَجلِسُنا مَعَهُ مَلحَمَه",18,"م",2,0],["هَرَبنَ إِلى مَداخِلِهِنَّ مِنهُ","وَجاءَ يُقَلِّعُ الصَخرَ اِنحِدارا",19,"ر",2,0],["هربتُ من عالمٍ أضرَّا","وجئت يا كعبتي أزور",20,"ر",1,0],["هرَبتُ من عالم الشقاء","وجئت عليَّ لديكِ أحيا",20,"ي",2,0],["هَرِمتَ بَعدِيَ وَالرَبعُ الَّذي أَفَلَت","مِنهُ بُدورُكَ مَعذورٌ عَلى الهَرَمِ",21,"م",1,0],["هرمَ الصبرُ عليكم","والمنى دونَ البلوغِ",22,"غ",1,0],["هرماسُها لما تخضَّبَ سيفُهُ","بعثوا إليهِ منَ النسيم بصيقلِ",23,"ل",1,0],["هَرم خالد يَغشّيه ظل","مِن عُبودية لَكُم لا تَريم",24,"م",1,0],["هَريتُ شُدوق الأُسْدِ يُطوَى عجاجه","على عَنْقَفيرٍ يأكلُ الناسَ صَيلَم",25,"م",1,0],["هَرَبتُ مِن بَينِ إِخواني لِتَحسِبَني","في مَعشَرٍ مِن لِباسِ الذامِ هُرّابِ",26,"ب",1,0],["هَرمَ البازِلُ الَّذي يَحمِلُ العِب","أَ فَأَمسى يَعُزُّهُ اِبنُ اللَبونِ",27,"ن",1,0],["هَرَبَ النّوْمُ عن جُفونيَ فيها","هَرَبَ الأمْنِ عن فؤادِ الجَبانِ",28,"ن",1,0],["هَرَبْتِ من ضجَّة الحياةِ","فكيف من نفسِك الهربْ",29,"ب",1,0],["هَراقَتْ بَنو عَوْفٍ دَماً غَيْرَ واحِدٍ","لَهُ نَبأ نَجْدِيُّهُ سَيَغُورُ",30,"ر",1,1],["هرمٌ تجْثِمُ العظائم فيه","وسفينٌ على البحار يُدلُّ",31,"ل",1,0],["هَريقوا دَمي في حَقِّ حُبِّكُمُ فَما","أَرى الحبَّ إِلّا أَن يبيحَ أَخاهُ",32,"ا",2,0],["هَرِمتُ وَشابَت لِمَّتي غَيرَ أَنَّني","فَتى الحُبِّ وَالشَيخ الظَريف فَتاهُ",32,"ا",2,0],["هَرَعَتْ ساعةَ الوَداعِ تُفِيضُ الدَّمْعَ","بَحْراً وتُرسِلُ الشَّوقَ وقْدَا",33,"د",2,0],["هُرِعُوا نَحْوَكَ كَالْبَحْرِ إِذَا","سُجِّرَتْ أَمْواجُهُ أوْ زَخَرَا",34,"ر",2,0],["هِرٍّ جَنيبٍ كُلَّما عَطَفَتْ لهُ","غَضَبَ اتَّقاهَا بِاليَدَينِ وَبِالفَمِ",35,"م",1,0],["هُرِعَ الشعب إلى مُنقذِه","مُلقِياً في الساحة الكبرى الرّجالا",36,"ل",2,0],["هركولةٌ ، فنقٌ ، درمٌ مرافقها","كأن أخمصها بالشوك ينتعل",37,"ل",1,0],["هرقت دم المحل المروع والعدى","حتى بدت في أهبة ٍ حمراء",38,"ا",2,0]]}