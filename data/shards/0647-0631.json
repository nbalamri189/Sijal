النبي","https://www.poetsgate.com/ViewPoem.aspx?id=211577",""],[5732,"حل الرحيل وفرقوا شمل الاحباب","https://www.poetsgate.com/ViewPoem.aspx?id=177871",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5770,"الفجر موعده اقترب","https://www.poetsgate.com/ViewPoem.aspx?id=178700",""],[5943,"رقصَ العقالُ","https://www.poetsgate.com/ViewPoem.aspx?id=52930",""],[5956,"ذكرى شبه حب","https://www.poetsgate.com/ViewPoem.aspx?id=192128",""],[5956,"مجاهد في سبيل الله","https://www.poetsgate.com/ViewPoem.aspx?id=192254",""],[5956,"ضربتْ سكوني يا إلهُ شجونُها","https://www.poetsgate.com/ViewPoem.aspx?id=192384",""],[5960,"بغدادُ أغلى انتماءاتي","https://www.poetsgate.com/ViewPoem.aspx?id=30808",""],[6008,"السلف والفخر","https://www.poetsgate.com/ViewPoem.aspx?id=59157",""],[6031,"أَبا هَاشمٍ أُنهِي إليكَ تحيةً","https://www.poetsgate.com/ViewPoem.aspx?id=46265",""],[6043,"اختِباء","https://www.poetsgate.com/ViewPoem.aspx?id=215589",""],[6093,"كالحق ينزل في ضيافة باطل","https://www.poetsgate.com/ViewPoem.aspx?id=205866",""],[6102,"كلميني","https://www.poetsgate.com/ViewPoem.aspx?id=184858",""],[6125,"هَتَفْنَا بأنَّ الشَّعبَ لا بُدَّ أنْ يَرضَىٰ","https://www.poetsgate.com/ViewPoem.aspx?id=210807",""],[6127,"عذبٌ لَمَاك","https://www.poetsgate.com/ViewPoem.aspx?id=188486",""],[6142,"بسطت لشبك المرتضى راحة السؤل","https://www.poetsgate.com/ViewPoem.aspx?id=155757",""],[6142,"أغضض اللحظ عن محبك غمزا","https://www.poetsgate.com/ViewPoem.aspx?id=155732",""],[6142,"فزعت إليك من الورى الآمال","https://www.poetsgate.com/ViewPoem.aspx?id=155678",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[5309,"هرجوا يا ايها الحكام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573919",""],[469,"ومن العجائب والعجائب جمة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574847",""],[6178,"مرافي محطمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85529&r=&rc=5",""],[186,"دع عنك ذكر المنحنى وزرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55750&r=&rc=13",""],[6189,"قراءة لعوامل التعرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83585&r=&rc=52",""],[6239,"من ذاكرة الصقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75978&r=&rc=29",""],[6323,"زلزال الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82178&r=&rc=9",""]],"verses":[["هَرَقتَ دِماءً ما لَها الدَهرَ طالِبٌ","كَما هَرَقَت خَرقاءُ قَعبَ لِبانِ",0,"ن",1,0],["هِرٍ جَنيبٍ كُلَّما عَطَفَت لَهُ","غَضَبى اِتَّقاها بِاليَدَينِ وَبِالفَمِ",1,"م",1,0],["هِركَولَةٌ مِثلُ دِعصِ الرَملِ أَسفَلُها","مَكسُوَّةٌ مِن جَمالِ الحُسنِ جِلبابا",2,"ب",2,0],["هِركَولَةٌ فُنُقٌ دُرمٌ مَرافِقُها","كَأَنَّ أَخمَصَها بِالشَوكِ مُنتَعِلُ",3,"ل",1,0],["هُرَيرَةَ وَدَّعها وَإِن لامَ لائِمُ","غَداةَ غَدٍ أَم أَنتَ لِلبَينِ واجِمُ",4,"م",1,1],["هَرِمتُ وَما لِلشَيبِ وَخطٌ بِمَفرِقي","وَكائِن لِشَيبِ الهَمِّ في كَبِدي وَخطُ",5,"ط",1,0],["هَرَيتِ الشَدقِ رِئبالٍ إِذا ما","عَدا لَم تُنهَ عَدوَتُهُ بِزَجرِ",6,"ر",1,0],["هَريقي مِن دُموعِكِ أَو أَفيقي","وَصَبراً إِن أَطَقتِ وَلَن تُطيقي",7,"ق",2,1],["هُرِعَ الزَّمَانُ بِنَا فَمَا مِنْ مُهْلَةٍ","لِلوَادِعِ الرَّاضِي وَلا لِلوَانِي",8,"ن",2,0],["هَرَقناهُ في بادي النَشيئَةِ داثِرٍ","قَديمٍ بِعَهدِ الناسِ بُقعٍ نَصائِبُه",9,"ب",2,0],["هرّب منه تلكم الأنجما","علام قد غيّم ليل الشتا",10,"ت",2,0],["هرَقتْ دمَ المحلِي المروِّعِ والعدَى","حتى بدَتْ في أهبةٍ حمراء",11,"ا",2,0],["هرمت فهي في قيو","د من الكبر ترسُف",12,"ف",1,0],["هربت منك المودّا","ت على ظهر البراق",13,"ق",1,0],["هرعنا والقلوب يثبن وثبا","وللعبرات بالبشرى مسيل",14,"ل",1,0],["هِرَّتي جِدُّ أَليفَه","وَهيَ لِلبَيتِ حَليفَه",15,"ف",2,1],["هَرِمَت دَولَةُ القَياصِرِ وَالدَو","لاتُ كَالناسِ داؤُهُنَّ الفَناءُ",16,"ا",2,0],["هَراقَت دَمي مَن بي مِنَ الوَجدِ ما بِها","مِنَ الوَجدِ بي وَالشَوقُ لي وَلَها حِلفُ",17,"ف",1,0],["هِراشٌ نُعانيهِ طولَ النَهارِ","فَمَجلِسُنا مَعَهُ مَلحَمَه",18,"م",2,0],["هَرَبنَ إِلى مَداخِلِهِنَّ مِنهُ","وَجاءَ يُقَلِّعُ الصَخرَ اِنحِدارا",19,"ر",2,0],["هربتُ من عالمٍ أضرَّا","وجئت يا كعبتي أزور",20,"ر",1,0],["هرَبتُ من عالم الشقاء","وجئت عليَّ لديكِ أحيا",20,"ي",2,0],["هَرِمتَ بَعدِيَ وَالرَبعُ الَّذي أَفَلَت","مِنهُ بُدورُكَ مَعذورٌ عَلى الهَرَمِ",21,"م",1,0],["هرمَ الصبرُ عليكم","والمنى دونَ البلوغِ",22,"غ",1,0],["هرماسُها لما تخضَّبَ سيفُهُ","بعثوا إليهِ منَ النسيم بصيقلِ",23,"ل",1,0],["هَرم خالد يَغشّيه ظل","مِن عُبودية لَكُم لا تَريم",24,"م",1,0],["هَريتُ شُدوق الأُسْدِ يُطوَى عجاجه","على عَنْقَفيرٍ يأكلُ الناسَ صَيلَم",25,"م",1,0],["هَرَبتُ مِن بَينِ إِخواني لِتَحسِبَني","في مَعشَرٍ مِن لِباسِ الذامِ هُرّابِ",26,"ب",1,0],["هَرمَ البازِلُ الَّذي يَحمِلُ العِب","أَ فَأَمسى يَعُزُّهُ اِبنُ اللَبونِ",27,"ن",1,0],["هَرَبَ النّوْمُ عن جُفونيَ فيها","هَرَبَ الأمْنِ عن فؤادِ الجَبانِ",28,"ن",1,0],["هَرِيتٍ قَصِير عِذَارِ اللجَامِ","أسِيلٍ طَوِيلِ عِذَارِ الرَّسَنْ",29,"ن",1,0],["هَرْجَ الوَلِيدِ بِخَيْطٍ مُبْرَمٍ خَلَقٍ","بَيْنَ الرَّوَاجِبِ في عُودٍ مِنَ العُشَرِ",30,"ر",1,0],["هَرَبْتِ من ضجَّة الحياةِ","فكيف من نفسِك الهربْ",31,"ب",1,0],["هَراقَتْ بَنو عَوْفٍ دَماً غَيْرَ واحِدٍ","لَهُ نَبأ نَجْدِيُّهُ سَيَغُورُ",32,"ر",1,1],["هرمٌ تجْثِمُ العظائم فيه","وسفينٌ على البحار يُدلُّ",33,"ل",1,0],["هَريقوا دَمي في حَقِّ حُبِّكُمُ فَما","أَرى الحبَّ إِلّا أَن يبيحَ أَخاهُ",34,"ا",2,0],["هَرِمتُ وَشابَت لِمَّتي غَيرَ أَنَّني","فَتى الحُبِّ وَالشَيخ الظَريف فَتاهُ",34,"ا",2,0],["هَرَعَتْ ساعةَ الوَداعِ تُفِيضُ الدَّمْعَ","بَحْراً وتُرسِلُ الشَّوقَ وقْدَا",35,"د",2,0],["هُرِعُوا نَحْوَكَ كَالْبَحْرِ إِذَا","سُجِّرَتْ أَمْواجُهُ أوْ زَخَرَا",36,"ر",2,0],["هِرَّةُ البيت إِن يَطْفْ بِبَنِيها","طائِفُ السُّوءِ حَيَّةٌ رَقْطَاءُ",37,"ا",2,0],["هراشا على الدنيا وطيشا على الهوى","وذلك سم في الحقيقة ناقع",38,"ع",1,0],["هرب الجدار من الجدار","هوى النفور على النفور",39,"ر",1,0],["هِرٍّ جَنيبٍ كُلَّما عَطَفَتْ لهُ","غَضَبَ اتَّقاهَا بِاليَدَينِ وَبِالفَمِ",40,"م",1,0],["هُرِعَ الشعب إلى مُنقذِه","مُلقِياً في الساحة الكبرى الرّجالا",41,"ل",2,0],["هركولةٌ ، فنقٌ ، درمٌ مرافقها","كأن أخمصها بالشوك ينتعل",42,"ل",1,0],["هرقت دم المحل المروع والعدى","حتى بدت في أهبة ٍ حمراء",43,"ا",2,0],["هربت لباب خير الخلق طه","بباب محمد تمحي الذنوب",44,"ب",1,0],["هِرْكَوْلَةٌ ورداح طَفْلَةٌ صدرت","جسمي وروداً بحبٍّ لا يُرى صَدَرَا",45,"ر",2,0],["هربت لديهم إذ هدوني إلى الهُدى","وأهدوا هدايا من هِباتٍ تُعَجَّلُ",46,"ل",1,0],["هَرَبي إِلى الإِنْصافِ مِن خَوْفِ النَّوى","وإِليْكَ مِنْكَ وَمِنْ فِراقِكَ أَهْرُبُ",47,"ب",1,0],["هرباً من القوم الأولى يسعون في","إهلاكه في السر والإعلان",48,"ن",1,0],["هَرِسٌ يَفرِسُ الأُمورَ وَلا يَع","روهُ مِنها الإِفراطُ وَالتَفريطُ",49,"ط",1,0],["هرب الحسون من غاباته","وشدا البومُ بها والقبرة",50,"ر",2,0],["هَرَاقُوا ذَوِي السُمِّ الزُعافِ وَأَولَجوا","بِأَيدِيهِمُ تَحتَ الثِيابِ الأَفاعيا",51,"ي",2,0],["هرٌّ لَهُ في عَينِها جاذِب","وَفي حَشاها جاذِبٌ آخرُ",52,"ر",1,0],["هَرِم الحَظُّ فَقَد ق","ارَبَ في الحاجاتِ خَطوَه",53,"و",2,0],["هربتُ بذنبي قاصداً نحو مدحهِ","وطوبى لمن قدامة ونحاهُ",54,"ا",2,0],["هَرقتُ دُموعَ العين مِنّي تأسُّفاً","على عُمرٍ ما كنتَ أعرفَ ما هو",54,"ا",3,0],["هروباً من ثرى لبنان ..يجري","وقد ضاقت به كل النواحي",55,"ح",2,0],["هروب المجرم الباغي بليلٍ","يفرّ بريشه.. قبل الصباح",55,"ح",1,0],["هر يراني وفي فمي غددٌ","والهر بالطبع يألف الغددا",56,"د",2,0],["هربتُ من موطني إلى بلدٍ","قد صفر الجوع فيه منقاري",57,"ر",2,1],["هَرَبتِ إلى حجرِ اليَقينِ من الشكِّ","ولمّا طغى الطوفانُ سِرتِ على فُلكِ",58,"ك",1,1],["هَرَبْنا بِأَنْفُسِنا وَالْقَضا","ءُ يَسْبِقُ بِالْمَشْي إِحْضارَها",59,"ر",3,0],["هَرَبْتُ مِنَ ارْتِياحِكَ حِينَ أَنْحى","عَلَى حَمْدِي بِعَضْبِ نَدىً صَقِيلِ",60,"ل",1,0],["هُريقَ شَبابي وَاِستُشِنَّ لِشَقوَتي","أَديمي فَلَم أَملِك شَباباً وَلا وَفرا",61,"ر",2,0],["(هرقل) ذعراً رمى بالصولجان لهم","وَتاجُ كسرى لديهمْ بات مطّرحا",62,"ح",2,0],["هربت بتقصيري وفقري وفاقتي","إليه وعذري راجياً نيل رحمة",63,"ه",1,0],["هَرِيتِ الشِدقِ يُقعِصُ كُلَّ قِرنٍ","عَلى كَتفَيهِ مِن لِبَدٍ لَبودُ",64,"د",1,0],["هَرَبَتْ هِرَّةُ بَيْتي يَوْمَ عِيدِى","قَانظُروا هَلْ تَمَّ هذا السَّعِيدِ",65,"د",1,1],["هَرِمٌ كان قبل أن هَرِم الدّه","رُ له في العبادِ فَضلُ القَضاء",66,"ا",2,0],["هَرَّ عَلَ