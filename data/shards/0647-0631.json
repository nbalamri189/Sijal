{"poems":[[55,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[9,"بانت سعاد وأمسى حبلها رابا","https://www.aldiwan.net/poem21909.html","البسيط"],[9,"ودع هريرة إن الركب مرتحل","https://www.aldiwan.net/poem21969.html","البسيط"],[9,"هريرة ودعها وإن لام لائم","https://www.aldiwan.net/poem21978.html","الطويل"],[75,"شحطنا وما بالدار نأي ولا شحط","https://www.aldiwan.net/poem11909.html","الطويل"],[10,"ألا يا عين فانهمري بغدر","https://www.aldiwan.net/poem21078.html","الوافر"],[10,"هريقي من دموعك أو أفيقي","https://www.aldiwan.net/poem21116.html","الوافر"],[95,"ألشرق طال سباته الروحاني","https://www.aldiwan.net/poem11226.html","الكامل"],[32,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[90,"قد كانت الأغصان مخضرة","https://www.aldiwan.net/poem44411.html","السريع"],[74,"سهرت عليك لواحظ الرقباء","https://www.aldiwan.net/poem18175.html","الكامل"],[53,"زلقت في سلاحها","https://www.aldiwan.net/poem65472.html","مجزوء الخفيف"],[53,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[87,"رضاكم بالعلاقة لي كفيل","https://www.aldiwan.net/poem7893.html","الوافر"],[87,"هرتي جد أليفه","https://www.aldiwan.net/poem7999.html","مجزوء الرمل"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"لجنية أم غادة رفع السجف","https://www.aldiwan.net/poem9728.html","الطويل"],[47,"مغنيك للبغض فيه سمه","https://www.aldiwan.net/poem66635.html","البسيط"],[30,"وإن نقدت يداه فزل عنها","https://www.aldiwan.net/poem5240.html","الوافر"],[99,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[46,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[71,"أنا في حال نقيص","https://www.aldiwan.net/poem28679.html","مجزوء الرمل"],[71,"قف وقفة المتألم المتأمل","https://www.aldiwan.net/poem28749.html","الكامل"],[104,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[77,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[48,"إستنبط العرب لفظا وانبرى نبط","https://www.aldiwan.net/poem22204.html","البسيط"],[48,"عيشتي سلتي ورمسي غمدي","https://www.aldiwan.net/poem23542.html","الخفيف"],[48,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62240","المتقارب"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72201","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142069","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43655","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54250","الرمل"],[108,"مشاعر الآباء!","https://www.poetsgate.com/ViewPoem.aspx?id=179320",""],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[102,"صنعاء والحلم والزمان","https://www.poetsgate.com/ViewPoem.aspx?id=50404",""],[3,"هَلْ غَادَرَ الشُّعَرَاءُ منْ مُتَرَدَّمِ(معلق","https://www.poetsgate.com/ViewPoem.aspx?id=10032",""],[92,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[9,"معلقة الأعشي","https://www.poetsgate.com/ViewPoem.aspx?id=11407",""],[74,"سهرت عليكِ لواحظُ الرقباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=57649&r=&rc=7",""],[119,"ذنوبي أثقلت ظهري وإني","https://www.aldiwan.net/poem42013.html","الوافر"],[125,"أصبحت لا بد لي أن أنفث الصدرا","https://www.aldiwan.net/poem23810.html","البسيط"],[132,"شربت شمولا من شتيت مشوبة","https://www.aldiwan.net/poem50539.html","الطويل"],[159,"ومن البلية أنني بك مغرم","https://www.aldiwan.net/poem55753.html","الكامل"],[164,"الفسح يطلب منكم الكرماني","https://www.aldiwan.net/poem59188.html","الكامل"],[168,"جزعت أن يقال دام عبيط","https://www.aldiwan.net/poem67813.html","الخفيف"],[171,"أمتي","https://www.aldiwan.net/poem1064.html","عموديه"],[173,"أبت نوب الأيام إلا تماديا","https://www.aldiwan.net/poem1691.html",""],[227,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[239,"بأبي من ذبت في الح","https://www.aldiwan.net/poem31630.html","مجزوء الرمل"],[254,"هنيئا لعين قد رأت قبر أحمد","https://www.aldiwan.net/poem15078.html","الطويل"],[255,"رُبى لبنان","https://www.aldiwan.net/poem39738.html","عموديه"],[260,"أخشى على حسبتي العدو وفي","https://www.aldiwan.net/poem48523.html","المنسرح"],[260,"هربت من موطني إلى بلد","https://www.aldiwan.net/poem48525.html","المنسرح"],[274,"هربت إلى حجر اليقين من الشك","https://www.aldiwan.net/poem35234.html","الطويل"],[284,"لقد جاوزت فيك مقدارها","https://www.aldiwan.net/poem60757.html","المتقارب"],[284,"أرى العلياء واضحة السبيل","https://www.aldiwan.net/poem60777.html","الطويل"],[286,"لحاظ المهى لا بابل تنفث السحرا","https://www.aldiwan.net/poem32789.html","الطويل"],[302,"إن كان باليمن هذا اليوم قد سنحا","https://www.aldiwan.net/poem36252.html","عموديه"],[308,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[326,"أتصرم أم تواصلك النجود","https://www.aldiwan.net/poem56354.html","الوافر"],[352,"هربت هرة بيتي يوم عيدى","https://www.aldiwan.net/poem20061.html","الرمل"],[368,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[370,"برذوننا اليوم ما به عجب","https://www.aldiwan.net/poem17361.html","المنسرح"],[375,"هل هائم دنف كما أنا هائم","https://www.aldiwan.net/poem57114.html","الكامل"],[420,"من يحاول في الدهر مجدا أثيلا","https://www.aldiwan.net/poem54123.html","الخفيف"],[438,"كم كان فيها من كرام سادة","https://www.aldiwan.net/poem25692.html","الكامل"],[443,"هربنا إليكم فآويتمونا","https://www.aldiwan.net/poem34765.html","المتقارب"],[455,"لقد ثوب الداعي لربوة جلق","https://www.aldiwan.net/poem13861.html","الطويل"],[455,"سقى الله أيام العذيب وبارقه","https://www.aldiwan.net/poem13862.html","الطويل"],[456,"هتف العابثون بالسلم للسلم","https://www.aldiwan.net/poem61306.html","الخفيف"],[461,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[461,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[482,"قم بالمهمة في حل ومرتحل","https://www.aldiwan.net/poem36964.html","البسيط"],[547,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216937","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/29494","الوافر"],[1023,"","https://poetry.dctabudhabi.ae/diwan/poem/28824","الطويل"],[1083,"","https://poetry.dctabudhabi.ae/diwan/poem/97677","الكامل"]],"verses":[["هَرَقتَ دِماءً ما لَها الدَهرَ طالِبٌ","كَما هَرَقَت خَرقاءُ قَعبَ لِبانِ",0,"ن",1,0],["هِرٍ جَنيبٍ كُلَّما عَطَفَت لَهُ","غَضَبى اِتَّقاها بِاليَدَينِ وَبِالفَمِ",1,"م",1,0],["هِركَولَةٌ مِثلُ دِعصِ الرَملِ أَسفَلُها","مَكسُوَّةٌ مِن جَمالِ الحُسنِ جِلبابا",2,"ب",2,0],["هِركَولَةٌ فُنُقٌ دُرمٌ مَرافِقُها","كَأَنَّ أَخمَصَها بِالشَوكِ مُنتَعِلُ",3,"ل",1,0],["هُرَيرَةَ وَدَّعها وَإِن لامَ لائِمُ","غَداةَ غَدٍ أَم أَنتَ لِلبَينِ واجِمُ",4,"م",1,1],["هَرِمتُ وَما لِلشَيبِ وَخطٌ بِمَفرِقي","وَكائِن لِشَيبِ الهَمِّ في كَبِدي وَخطُ",5,"ط",1,0],["هَرَيتِ الشَدقِ رِئبالٍ إِذا ما","عَدا لَم تُنهَ عَدوَتُهُ بِزَجرِ",6,"ر",1,0],["هَريقي مِن دُموعِكِ أَو أَفيقي","وَصَبراً إِن أَطَقتِ وَلَن تُطيقي",7,"ق",2,1],["هُرِعَ الزَّمَانُ بِنَا فَمَا مِنْ مُهْلَةٍ","لِلوَادِعِ الرَّاضِي وَلا لِلوَانِي",8,"ن",2,0],["هَرَقناهُ في بادي النَشيئَةِ داثِرٍ","قَديمٍ بِعَهدِ الناسِ بُقعٍ نَصائِبُه",9,"ب",2,0],["هرّب منه تلكم الأنجما","علام قد غيّم ليل الشتا",10,"ت",2,0],["هرَقتْ دمَ المحلِي المروِّعِ والعدَى","حتى بدَتْ في أهبةٍ حمراء",11,"ا",2,0],["هرمت فهي في قيو","د من الكبر ترسُف",12,"ف",1,0],["هربت منك المودّا","ت على ظهر البراق",13,"ق",1,0],["هرعنا والقلوب يثبن وثبا","وللعبرات بالبشرى مسيل",14,"ل",1,0],["هِرَّتي جِدُّ أَليفَه","وَهيَ لِلبَيتِ حَليفَه",15,"ف",2,1],["هَرِمَت دَولَةُ القَياصِرِ وَالدَو","لاتُ كَالناسِ داؤُهُنَّ الفَناءُ",16,"ا",2,0],["هَراقَت دَمي مَن بي مِنَ الوَجدِ ما بِها","مِنَ الوَجدِ بي وَالشَوقُ لي وَلَها حِلفُ",17,"ف",1,0],["هِراشٌ نُعانيهِ طولَ النَهارِ","فَمَجلِسُنا مَعَهُ مَلحَمَه",18,"م",2,0],["هَرَبنَ إِلى مَداخِلِهِنَّ مِنهُ","وَجاءَ يُقَلِّعُ الصَخرَ اِنحِدارا",19,"ر",2,0],["هربتُ من عالمٍ أضرَّا","وجئت يا كعبتي أزور",20,"ر",1,0],["هرَبتُ من عالم الشقاء","وجئت عليَّ لديكِ أحيا",20,"ي",2,0],["هَرِمتَ بَعدِيَ وَالرَبعُ الَّذي أَفَلَت","مِنهُ بُدورُكَ مَعذورٌ عَلى الهَرَمِ",21,"م",1,0],["هرمَ الصبرُ عليكم","والمنى دونَ البلوغِ",22,"غ",1,0],["هرماسُها لما تخضَّبَ سيفُهُ","بعثوا إليهِ منَ النسيم بصيقلِ",23,"ل",1,0],["هَرم خالد يَغشّيه ظل","مِن عُبودية لَكُم لا تَريم",24,"م",1,0],["هَريتُ شُدوق الأُسْدِ يُطوَى عجاجه","على عَنْقَفيرٍ يأكلُ الناسَ صَيلَم",25,"م",1,0],["هَرَبتُ مِن بَينِ إِخواني لِتَحسِبَني","في مَعشَرٍ مِن لِباسِ الذامِ هُرّابِ",26,"ب",1,0],["هَرمَ البازِلُ الَّذي يَحمِلُ العِب","أَ فَأَمسى يَعُزُّهُ اِبنُ اللَبونِ",27,"ن",1,0],["هَرَبَ النّوْمُ عن جُفونيَ فيها","هَرَبَ الأمْنِ عن فؤادِ الجَبانِ",28,"ن",1,0],["هَرِيتٍ قَصِير عِذَارِ اللجَامِ","أسِيلٍ طَوِيلِ عِذَارِ الرَّسَنْ",29,"ن",1,0],["هَرْجَ الوَلِيدِ بِخَيْطٍ مُبْرَمٍ خَلَقٍ","بَيْنَ الرَّوَاجِبِ في عُودٍ مِنَ العُشَرِ",30,"ر",1,0],["هَرَبْتِ من ضجَّة الحياةِ","فكيف من نفسِك الهربْ",31,"ب",1,0],["هَراقَتْ بَنو عَوْفٍ دَماً غَيْرَ واحِدٍ","لَهُ نَبأ نَجْدِيُّهُ سَيَغُورُ",32,"ر",1,1],["هرمٌ تجْثِمُ العظائم فيه","وسفينٌ على البحار يُدلُّ",33,"ل",1,0],["هَريقوا دَمي في حَقِّ حُبِّكُمُ فَما","أَرى الحبَّ إِلّا أَن يبيحَ أَخاهُ",34,"ا",2,0],["هَرِمتُ وَشابَت لِمَّتي غَيرَ أَنَّني","فَتى الحُبِّ وَالشَيخ الظَريف فَتاهُ",34,"ا",2,0],["هَرَعَتْ ساعةَ الوَداعِ تُفِيضُ الدَّمْعَ","بَحْراً وتُرسِلُ الشَّوقَ وقْدَا",35,"د",2,0],["هُرِعُوا نَحْوَكَ كَالْبَحْرِ إِذَا","سُجِّرَتْ أَمْواجُهُ أوْ زَخَرَا",36,"ر",2,0],["هِرَّةُ البيت إِن يَطْفْ بِبَنِيها","طائِفُ السُّوءِ حَيَّةٌ رَقْطَاءُ",37,"ا",2,0],["هراشا على الدنيا وطيشا على الهوى","وذلك سم في الحقيقة ناقع",38,"ع",1,0],["هرب الجدار من الجدار","هوى النفور على النفور",39,"ر",1,0],["هِرٍّ جَنيبٍ كُلَّما عَطَفَتْ لهُ","غَضَبَ اتَّقاهَا بِاليَدَينِ وَبِالفَمِ",40,"م",1,0],["هُرِعَ الشعب إلى مُنقذِه","مُلقِياً في الساحة الكبرى الرّجالا",41,"ل",2,0],["هركولةٌ ، فنقٌ ، درمٌ مرافقها","كأن أخمصها بالشوك ينتعل",42,"ل",1,0],["هرقت دم المحل المروع والعدى","حتى بدت في أهبة ٍ حمراء",43,"ا",2,0],["هربت لباب خير الخلق طه","بباب محمد تمحي الذنوب",44,"ب",1,0],["هِرْكَوْلَةٌ ورداح طَفْلَةٌ صدرت","جسمي وروداً بحبٍّ لا يُرى صَدَرَا",45,"ر",2,0],["هربت لديهم إذ هدوني إلى الهُدى","وأهدوا هدايا من هِباتٍ تُعَجَّلُ",46,"ل",1,0],["هَرَبي إِلى الإِنْصافِ مِن خَوْفِ النَّوى","وإِليْكَ مِنْكَ وَمِنْ فِراقِكَ أَهْرُبُ",47,"ب",1,0],["هرباً من القوم الأولى يسعون في","إهلاكه في السر والإعلان",48,"ن",1,0],["هَرِسٌ يَفرِسُ الأُمورَ وَلا يَع","روهُ مِنها الإِفراطُ وَالتَفريطُ",49,"ط",1,0],["هرب الحسون من غاباته","وشدا البومُ بها والقبرة",50,"ر",2,0],["هَرَاقُوا ذَوِي السُمِّ الزُعافِ وَأَولَجوا","بِأَيدِيهِمُ تَحتَ الثِيابِ الأَفاعيا",51,"ي",2,0],["هرٌّ لَهُ في عَينِها جاذِب","وَفي حَشاها جاذِبٌ آخرُ",52,"ر",1,0],["هَرِم الحَظُّ فَقَد ق","ارَبَ في الحاجاتِ خَطوَه",53,"و",2,0],["هربتُ بذنبي قاصداً نحو مدحهِ","وطوبى لمن قدامة ونحاهُ",54,"ا",2,0],["هَرقتُ دُموعَ العين مِنّي تأسُّفاً","على عُمرٍ ما كنتَ أعرفَ ما هو",54,"ا",3,0],["هروباً من ثرى لبنان ..يجري","وقد ضاقت به كل النواحي",55,"ح",2,0],["هروب المجرم الباغي بليلٍ","يفرّ بريشه.. قبل الصباح",55,"ح",1,0],["هر يراني وفي فمي غددٌ","والهر بالطبع يألف الغددا",56,"د",2,0],["هربتُ من موطني إلى بلدٍ","قد صفر الجوع فيه منقاري",57,"ر",2,1],["هَرَبتِ إلى حجرِ اليَقينِ من الشكِّ","ولمّا طغى الطوفانُ سِرتِ على فُلكِ",58,"ك",1,1],["هَرَبْنا بِأَنْفُسِنا وَالْقَضا","ءُ يَسْبِقُ بِالْمَشْي إِحْضارَها",59,"ر",3,0],["هَرَبْتُ مِنَ ارْتِياحِكَ حِينَ أَنْحى","عَلَى حَمْدِي بِعَضْبِ نَدىً صَقِيلِ",60,"ل",1,0],["هُريقَ شَبابي وَاِستُشِنَّ لِشَقوَتي","أَديمي فَلَم أَملِك شَباباً وَلا وَفرا",61,"ر",2,0],["(هرقل) ذعراً رمى بالصولجان لهم","وَتاجُ كسرى لديهمْ بات مطّرحا",62,"ح",2,0],["هربت بتقصيري وفقري وفاقتي","إليه وعذري راجياً نيل رحمة",63,"ه",1,0],["هَرِيتِ 