{"poems":[[53,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[9,"بانت سعاد وأمسى حبلها رابا","https://www.aldiwan.net/poem21909.html","البسيط"],[9,"ودع هريرة إن الركب مرتحل","https://www.aldiwan.net/poem21969.html","البسيط"],[9,"هريرة ودعها وإن لام لائم","https://www.aldiwan.net/poem21978.html","الطويل"],[73,"شحطنا وما بالدار نأي ولا شحط","https://www.aldiwan.net/poem11909.html","الطويل"],[10,"ألا يا عين فانهمري بغدر","https://www.aldiwan.net/poem21078.html","الوافر"],[10,"هريقي من دموعك أو أفيقي","https://www.aldiwan.net/poem21116.html","الوافر"],[93,"ألشرق طال سباته الروحاني","https://www.aldiwan.net/poem11226.html","الكامل"],[30,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[88,"قد كانت الأغصان مخضرة","https://www.aldiwan.net/poem44411.html","السريع"],[72,"سهرت عليك لواحظ الرقباء","https://www.aldiwan.net/poem18175.html","الكامل"],[51,"زلقت في سلاحها","https://www.aldiwan.net/poem65472.html","مجزوء الخفيف"],[51,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[85,"رضاكم بالعلاقة لي كفيل","https://www.aldiwan.net/poem7893.html","الوافر"],[85,"هرتي جد أليفه","https://www.aldiwan.net/poem7999.html","مجزوء الرمل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[43,"لجنية أم غادة رفع السجف","https://www.aldiwan.net/poem9728.html","الطويل"],[45,"مغنيك للبغض فيه سمه","https://www.aldiwan.net/poem66635.html","البسيط"],[28,"وإن نقدت يداه فزل عنها","https://www.aldiwan.net/poem5240.html","الوافر"],[97,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[69,"أنا في حال نقيص","https://www.aldiwan.net/poem28679.html","مجزوء الرمل"],[69,"قف وقفة المتألم المتأمل","https://www.aldiwan.net/poem28749.html","الكامل"],[102,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[46,"إستنبط العرب لفظا وانبرى نبط","https://www.aldiwan.net/poem22204.html","البسيط"],[46,"عيشتي سلتي ورمسي غمدي","https://www.aldiwan.net/poem23542.html","الخفيف"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72201","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142069","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43655","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54250","الرمل"],[106,"مشاعر الآباء!","https://www.poetsgate.com/ViewPoem.aspx?id=179320",""],[100,"صنعاء والحلم والزمان","https://www.poetsgate.com/ViewPoem.aspx?id=50404",""],[3,"هَلْ غَادَرَ الشُّعَرَاءُ منْ مُتَرَدَّمِ(معلق","https://www.poetsgate.com/ViewPoem.aspx?id=10032",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[9,"معلقة الأعشي","https://www.poetsgate.com/ViewPoem.aspx?id=11407",""],[72,"سهرت عليكِ لواحظُ الرقباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=57649&r=&rc=7",""],[115,"ذنوبي أثقلت ظهري وإني","https://www.aldiwan.net/poem42013.html","الوافر"],[121,"أصبحت لا بد لي أن أنفث الصدرا","https://www.aldiwan.net/poem23810.html","البسيط"],[128,"شربت شمولا من شتيت مشوبة","https://www.aldiwan.net/poem50539.html","الطويل"],[155,"ومن البلية أنني بك مغرم","https://www.aldiwan.net/poem55753.html","الكامل"],[160,"الفسح يطلب منكم الكرماني","https://www.aldiwan.net/poem59188.html","الكامل"],[164,"جزعت أن يقال دام عبيط","https://www.aldiwan.net/poem67813.html","الخفيف"],[167,"أمتي","https://www.aldiwan.net/poem1064.html","عموديه"],[169,"أبت نوب الأيام إلا تماديا","https://www.aldiwan.net/poem1691.html",""],[223,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[235,"بأبي من ذبت في الح","https://www.aldiwan.net/poem31630.html","مجزوء الرمل"],[250,"هنيئا لعين قد رأت قبر أحمد","https://www.aldiwan.net/poem15078.html","الطويل"],[251,"رُبى لبنان","https://www.aldiwan.net/poem39738.html","عموديه"],[256,"أخشى على حسبتي العدو وفي","https://www.aldiwan.net/poem48523.html","المنسرح"],[256,"هربت من موطني إلى بلد","https://www.aldiwan.net/poem48525.html","المنسرح"],[270,"هربت إلى حجر اليقين من الشك","https://www.aldiwan.net/poem35234.html","الطويل"],[280,"لقد جاوزت فيك مقدارها","https://www.aldiwan.net/poem60757.html","المتقارب"],[280,"أرى العلياء واضحة السبيل","https://www.aldiwan.net/poem60777.html","الطويل"],[282,"لحاظ المهى لا بابل تنفث السحرا","https://www.aldiwan.net/poem32789.html","الطويل"],[298,"إن كان باليمن هذا اليوم قد سنحا","https://www.aldiwan.net/poem36252.html","عموديه"],[304,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[322,"أتصرم أم تواصلك النجود","https://www.aldiwan.net/poem56354.html","الوافر"],[348,"هربت هرة بيتي يوم عيدى","https://www.aldiwan.net/poem20061.html","الرمل"],[363,"هريت قصير عذار اللجام","https://www.aldiwan.net/poem1706.html","المتقارب"],[364,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[366,"برذوننا اليوم ما به عجب","https://www.aldiwan.net/poem17361.html","المنسرح"],[371,"هل هائم دنف كما أنا هائم","https://www.aldiwan.net/poem57114.html","الكامل"],[416,"من يحاول في الدهر مجدا أثيلا","https://www.aldiwan.net/poem54123.html","الخفيف"],[434,"كم كان فيها من كرام سادة","https://www.aldiwan.net/poem25692.html","الكامل"],[439,"هربنا إليكم فآويتمونا","https://www.aldiwan.net/poem34765.html","المتقارب"],[452,"لقد ثوب الداعي لربوة جلق","https://www.aldiwan.net/poem13861.html","الطويل"],[452,"سقى الله أيام العذيب وبارقه","https://www.aldiwan.net/poem13862.html","الطويل"],[453,"هتف العابثون بالسلم للسلم","https://www.aldiwan.net/poem61306.html","الخفيف"],[458,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[458,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[479,"قم بالمهمة في حل ومرتحل","https://www.aldiwan.net/poem36964.html","البسيط"],[544,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"]],"verses":[["هَرَقتَ دِماءً ما لَها الدَهرَ طالِبٌ","كَما هَرَقَت خَرقاءُ قَعبَ لِبانِ",0,"ن",1,0],["هِرٍ جَنيبٍ كُلَّما عَطَفَت لَهُ","غَضَبى اِتَّقاها بِاليَدَينِ وَبِالفَمِ",1,"م",1,0],["هِركَولَةٌ مِثلُ دِعصِ الرَملِ أَسفَلُها","مَكسُوَّةٌ مِن جَمالِ الحُسنِ جِلبابا",2,"ب",2,0],["هِركَولَةٌ فُنُقٌ دُرمٌ مَرافِقُها","كَأَنَّ أَخمَصَها بِالشَوكِ مُنتَعِلُ",3,"ل",1,0],["هُرَيرَةَ وَدَّعها وَإِن لامَ لائِمُ","غَداةَ غَدٍ أَم أَنتَ لِلبَينِ واجِمُ",4,"م",1,1],["هَرِمتُ وَما لِلشَيبِ وَخطٌ بِمَفرِقي","وَكائِن لِشَيبِ الهَمِّ في كَبِدي وَخطُ",5,"ط",1,0],["هَرَيتِ الشَدقِ رِئبالٍ إِذا ما","عَدا لَم تُنهَ عَدوَتُهُ بِزَجرِ",6,"ر",1,0],["هَريقي مِن دُموعِكِ أَو أَفيقي","وَصَبراً إِن أَطَقتِ وَلَن تُطيقي",7,"ق",2,1],["هُرِعَ الزَّمَانُ بِنَا فَمَا مِنْ مُهْلَةٍ","لِلوَادِعِ الرَّاضِي وَلا لِلوَانِي",8,"ن",2,0],["هَرَقناهُ في بادي النَشيئَةِ داثِرٍ","قَديمٍ بِعَهدِ الناسِ بُقعٍ نَصائِبُه",9,"ب",2,0],["هرّب منه تلكم الأنجما","علام قد غيّم ليل الشتا",10,"ت",2,0],["هرَقتْ دمَ المحلِي المروِّعِ والعدَى","حتى بدَتْ في أهبةٍ حمراء",11,"ا",2,0],["هرمت فهي في قيو","د من الكبر ترسُف",12,"ف",1,0],["هربت منك المودّا","ت على ظهر البراق",13,"ق",1,0],["هرعنا والقلوب يثبن وثبا","وللعبرات بالبشرى مسيل",14,"ل",1,0],["هِرَّتي جِدُّ أَليفَه","وَهيَ لِلبَيتِ حَليفَه",15,"ف",2,1],["هَرِمَت دَولَةُ القَياصِرِ وَالدَو","لاتُ كَالناسِ داؤُهُنَّ الفَناءُ",16,"ا",2,0],["هَراقَت دَمي مَن بي مِنَ الوَجدِ ما بِها","مِنَ الوَجدِ بي وَالشَوقُ لي وَلَها حِلفُ",17,"ف",1,0],["هِراشٌ نُعانيهِ طولَ النَهارِ","فَمَجلِسُنا مَعَهُ مَلحَمَه",18,"م",2,0],["هَرَبنَ إِلى مَداخِلِهِنَّ مِنهُ","وَجاءَ يُقَلِّعُ الصَخرَ اِنحِدارا",19,"ر",2,0],["هربتُ من عالمٍ أضرَّا","وجئت يا كعبتي أزور",20,"ر",1,0],["هرَبتُ من عالم الشقاء","وجئت عليَّ لديكِ أحيا",20,"ي",2,0],["هَرِمتَ بَعدِيَ وَالرَبعُ الَّذي أَفَلَت","مِنهُ بُدورُكَ مَعذورٌ عَلى الهَرَمِ",21,"م",1,0],["هرمَ الصبرُ عليكم","والمنى دونَ البلوغِ",22,"غ",1,0],["هرماسُها لما تخضَّبَ سيفُهُ","بعثوا إليهِ منَ النسيم بصيقلِ",23,"ل",1,0],["هَرم خالد يَغشّيه ظل","مِن عُبودية لَكُم لا تَريم",24,"م",1,0],["هَريتُ شُدوق الأُسْدِ يُطوَى عجاجه","على عَنْقَفيرٍ يأكلُ الناسَ صَيلَم",25,"م",1,0],["هَرَبتُ مِن بَينِ إِخواني لِتَحسِبَني","في مَعشَرٍ مِن لِباسِ الذامِ هُرّابِ",26,"ب",1,0],["هَرمَ البازِلُ الَّذي يَحمِلُ العِب","أَ فَأَمسى يَعُزُّهُ اِبنُ اللَبونِ",27,"ن",1,0],["هَرَبَ النّوْمُ عن جُفونيَ فيها","هَرَبَ الأمْنِ عن فؤادِ الجَبانِ",28,"ن",1,0],["هَرَبْتِ من ضجَّة الحياةِ","فكيف من نفسِك الهربْ",29,"ب",1,0],["هَراقَتْ بَنو عَوْفٍ دَماً غَيْرَ واحِدٍ","لَهُ نَبأ نَجْدِيُّهُ سَيَغُورُ",30,"ر",1,1],["هرمٌ تجْثِمُ العظائم فيه","وسفينٌ على البحار يُدلُّ",31,"ل",1,0],["هَريقوا دَمي في حَقِّ حُبِّكُمُ فَما","أَرى الحبَّ إِلّا أَن يبيحَ أَخاهُ",32,"ا",2,0],["هَرِمتُ وَشابَت لِمَّتي غَيرَ أَنَّني","فَتى الحُبِّ وَالشَيخ الظَريف فَتاهُ",32,"ا",2,0],["هَرَعَتْ ساعةَ الوَداعِ تُفِيضُ الدَّمْعَ","بَحْراً وتُرسِلُ الشَّوقَ وقْدَا",33,"د",2,0],["هُرِعُوا نَحْوَكَ كَالْبَحْرِ إِذَا","سُجِّرَتْ أَمْواجُهُ أوْ زَخَرَا",34,"ر",2,0],["هِرَّةُ البيت إِن يَطْفْ بِبَنِيها","طائِفُ السُّوءِ حَيَّةٌ رَقْطَاءُ",35,"ا",2,0],["هرب الجدار من الجدار","هوى النفور على النفور",36,"ر",1,0],["هِرٍّ جَنيبٍ كُلَّما عَطَفَتْ لهُ","غَضَبَ اتَّقاهَا بِاليَدَينِ وَبِالفَمِ",37,"م",1,0],["هُرِعَ الشعب إلى مُنقذِه","مُلقِياً في الساحة الكبرى الرّجالا",38,"ل",2,0],["هركولةٌ ، فنقٌ ، درمٌ مرافقها","كأن أخمصها بالشوك ينتعل",39,"ل",1,0],["هرقت دم المحل المروع والعدى","حتى بدت في أهبة ٍ حمراء",40,"ا",2,0],["هربت لباب خير الخلق طه","بباب محمد تمحي الذنوب",41,"ب",1,0],["هِرْكَوْلَةٌ ورداح طَفْلَةٌ صدرت","جسمي وروداً بحبٍّ لا يُرى صَدَرَا",42,"ر",2,0],["هربت لديهم إذ هدوني إلى الهُدى","وأهدوا هدايا من هِباتٍ تُعَجَّلُ",43,"ل",1,0],["هَرَبي إِلى الإِنْصافِ مِن خَوْفِ النَّوى","وإِليْكَ مِنْكَ وَمِنْ فِراقِكَ أَهْرُبُ",44,"ب",1,0],["هرباً من القوم الأولى يسعون في","إهلاكه في السر والإعلان",45,"ن",1,0],["هَرِسٌ يَفرِسُ الأُمورَ وَلا يَع","روهُ مِنها الإِفراطُ وَالتَفريطُ",46,"ط",1,0],["هرب الحسون من غاباته","وشدا البومُ بها والقبرة",47,"ر",2,0],["هَرَاقُوا ذَوِي السُمِّ الزُعافِ وَأَولَجوا","بِأَيدِيهِمُ تَحتَ الثِيابِ الأَفاعيا",48,"ي",2,0],["هرٌّ لَهُ في عَينِها جاذِب","وَفي حَشاها جاذِبٌ آخرُ",49,"ر",1,0],["هَرِم الحَظُّ فَقَد ق","ارَبَ في الحاجاتِ خَطوَه",50,"و",2,0],["هربتُ بذنبي قاصداً نحو مدحهِ","وطوبى لمن قدامة ونحاهُ",51,"ا",2,0],["هَرقتُ دُموعَ العين مِنّي تأسُّفاً","على عُمرٍ ما كنتَ أعرفَ ما هو",51,"ا",3,0],["هروباً من ثرى لبنان ..يجري","وقد ضاقت به كل النواحي",52,"ح",2,0],["هروب المجرم الباغي بليلٍ","يفرّ بريشه.. قبل الصباح",52,"ح",1,0],["هر يراني وفي فمي غددٌ","والهر بالطبع يألف الغددا",53,"د",2,0],["هربتُ من موطني إلى بلدٍ","قد صفر الجوع فيه منقاري",54,"ي",1,1],["هَرَبتِ إلى حجرِ اليَقينِ من الشكِّ","ولمّا طغى الطوفانُ سِرتِ على فُلكِ",55,"ك",1,1],["هَرَبْنا بِأَنْفُسِنا وَالْقَضا","ءُ يَسْبِقُ بِالْمَشْي إِحْضارَها",56,"ر",3,0],["هَرَبْتُ مِنَ ارْتِياحِكَ حِينَ أَنْحى","عَلَى حَمْدِي بِعَضْبِ نَدىً صَقِيلِ",57,"ل",1,0],["هُريقَ شَبابي وَاِستُشِنَّ لِشَقوَتي","أَديمي فَلَم أَملِك شَباباً وَلا وَفرا",58,"ر",2,0],["(هرقل) ذعراً رمى بالصولجان لهم","وَتاجُ كسرى لديهمْ بات مطّرحا",59,"ح",2,0],["هربت بتقصيري وفقري وفاقتي","إليه وعذري راجياً نيل رحمة",60,"ه",1,0],["هَرِيتِ الشِدقِ يُقعِصُ كُلَّ قِرنٍ","عَلى كَتفَيهِ مِن لِبَدٍ لَبودُ",61,"د",1,0],["هَرَبَتْ هِرَّةُ بَيْتي يَوْمَ عِيدِى","قَانظُروا هَلْ تَمَّ هذا السَّعِيدِ",62,"د",1,1],["هَريتٍ قَصيرِ عِذارِ اللِجام","أَسيلٍ طَويلِ عِذارِ الرَسَن",63,"ن",1,1],["هَرِمٌ كان قبل أن هَرِم الدّه","رُ له في العبادِ فَضلُ القَضاء",64,"ا",2,0],["هَرَّ عَلَينا فَقالَ قائِلُنا","هَل يَقَعُ الشَيخُ قُلتُ بَل يَثِبُ",65,"ب",1,0],["هَربَت أُسودُ الوَحشِ عنه فلَن تَرى","فيهِ سِوى أسَدٍ أبُوهُ آدَمُ",66,"م",1,0],["هربوا قبل أن بروا صولة اللَّي","ث وإن يشهروا دماً مطولا",67,"ل",2,0],["هَرَبُوا بِكُلِّ وَليدَةٍ وَفَطيمَةٍ","وَبِكُلِّ أَرْمَلَةٍ وَكُلِّ حَصانِ",68,"ن",1,0],["هَرَبْنا إِليكمْ فآوَيْتُمُونَا","وخفْنا الحُتُوفَ فأَمَّنْتُمُونا",69,"ن",2,1],["هرقنا به للزقِّ في رِّيق الصِبا","نجيعَ سُلاف البابليّ المعتق",70,"ق",1,0],["هرقنا به للزَّقِّ في رِّيق الصِبا","نجيعَ سُلاف البابلي وعاتقه",71,"ق",2,0],["هرب الطير حينما عجز","الخلق ومات النبات بل والرغام",72,"م",1,0],["هربتُ بلبيّ أتّقى سحرَ لفظهِ","ولم أدر أنّ السحرَ عيناه بابلُهْ",73,"ل",2,0],["هرِم الزمانُ وحُوّلت عن شكلها","شيمُ الرجال وحالت الأوصافُ",74,"ف",1,0],["هريو تقبل بترحاب تحيتنا","فأنت للوفد حقا خير مقتبل",75,"ل",1,0],["هرّبتهِ طيفاً بذاكرة المُنى","يزهو وهيهات الفتوح تُهَرَّب",76,"ب",1,0]]}