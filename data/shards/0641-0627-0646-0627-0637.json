{"poems":[[63,"هل لك يا ابن غاليه","https://www.aldiwan.net/poem51315.html","مجزوء الرجز"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[310,"نفسي الفداء لمن حل الحشا فرأى","https://www.aldiwan.net/poem56361.html","البسيط"],[563,"صورة إن نظرتها كلفتني","https://www.aldiwan.net/poem33731.html","الخفيف"],[803,"","https://poetry.dctabudhabi.ae/diwan/poem/146133","البسيط"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122311","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70651","المجتث"],[1017,"","https://poetry.dctabudhabi.ae/diwan/poem/45204","المتقارب"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128755","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52052","الطويل"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34715","المتقارب"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112302","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86300","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110060","الكامل"],[5444,"يمن المحن","https://www.poetsgate.com/ViewPoem.aspx?id=185390",""],[5503,"هِيَ النَّفس بَين الْعقل الطَّبْع والهوى","https://www.poetsgate.com/ViewPoem.aspx?id=194724",""],[6031,"أبا هاشِمٍ إنِّي إلى ما يَنَالُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46411",""],[6102,"مَرسُوم ..","https://www.poetsgate.com/ViewPoem.aspx?id=185051",""],[6344,"طُقُوسُ العاشِقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87967&r=&rc=7",""]],"verses":[["فإن أطعت أمرهم","لبست درعا ضافيه",0,"ي",2,0],["فإن أَطعتُم نُصحي","ظفرتُم بالنُجحِ",1,"ح",1,0],["فَإِن أطعتُ فَما أَمري إِليّ وإن","عَصيتهُ فَبهِ قد كنتُ أعصيهِ",2,"ي",2,0],["فأنا طائع ولست بعاص","هكذا دائماً كما خلقتني",3,"ن",2,0],["فإنّ أطل أو أقصر في مدائحه","فليس بعد بلاغ الله تبليغ",4,"غ",1,0],["فإن اطرق الغضبان او خط في الثرى","فقولوا فقد القى اليكم سماعه",5,"ع",2,0],["فإن أطعْه بصدقٍ","أظفرْ بجَزْلِ حِباءِ",6,"ا",2,0],["فَإِن أَطمَعاكَ فَقَد قارَبا","وَإِن أَخَّراكَ فَكُن زامِلَةْ",7,"ل",2,0],["فان اطقت زماناً كتم عالجتي","عَلَى هواك فقد نمت باسراري",8,"ر",2,0],["فَإنْ أطْلَقَتنِي مِنْ وِثَاقِكَ رُبَّمَا","بِيُمنٍ عَلَى يَأسِ الفَتَى سَنَحَ الطِّيرُ",9,"ر",1,0],["فَإِن أَطلَعَت رَأسَها فَأَرةٌ","فَلَيسَت إَلى جُحرِها عائِدَه",10,"د",2,0],["فأن اطاعوك فاشكر او عصوك فلا","تطع وصاحبهما بالعرف من شيم",11,"م",1,0],["فإنّا طَرَدنا الفَقرَ عَنكُمُ والجدبا","ولاحَ لَنَا بَرقٌ على البعدِ ضاحِكٌ",12,"ا",3,0],["فَاِن اِطرَق الغضبان او خط في الثَرى","فَناجوهُ قَد اِلقى الَيكُم سَماعَهُ",13,"ه",1,0],["فاناط عَقدَ حُبى الأَمانِ عليهمِ","وأَماطَ عقدَ حُبَى المخاوفِ عنهمُ",14,"م",1,0],["فأنا طبيبُ جراحِه، وأنا الذي","!يسعى لكي يلتام جرحُ الأُسرة",15,"ه",1,0],["فَإِن اطلقت من غير قيد توثبت","على حظها الْأَدْنَى وَزَاد جنونها",16,"ن",3,0],["فإنْ أُطَّرَحْ بَعدَ الكَمَالِ فإنَّمَا","تُحَامي العُيُونُ البَدْرَ وهو كَبيرُ",17,"ر",1,0],["فَإِنْ أَطَلَّ لَهُمْ رَأسٌ أَطَحتُ بِهِ","وَ إِنْ أَغارَ جَحُودٌ آبَ مَرجُوما",18,"م",2,0],["فَإِنْ أَطْفَأْتِ بِيْ شَغَفِي أَعِيدِي","إِلَى ثَلْجِ انْطِفَائِي نَارَ جَمْرِكْ",19,"ك",1,0]]}