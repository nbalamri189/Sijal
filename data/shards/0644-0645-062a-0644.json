www.poetsgate.com/ViewPoem.aspx?id=155272",""],[5431,"كابوس خيمته بالنازحين عدا ...","https://www.poetsgate.com/ViewPoem.aspx?id=201008",""],[5459,"طال الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=205766",""],[5691,"سجال(3)","https://www.poetsgate.com/ViewPoem.aspx?id=206442",""],[5703,"إبعد","https://www.poetsgate.com/ViewPoem.aspx?id=207493",""],[5776,"مُبَاغَتة","https://www.poetsgate.com/ViewPoem.aspx?id=199378",""],[5861,"إلى مغرور","https://www.poetsgate.com/ViewPoem.aspx?id=188092",""],[6069,"ما من أحدٍ يزيد إلا نقصا","https://www.poetsgate.com/ViewPoem.aspx?id=105677",""],[6070,"قولي بربكِ ما الذي أبكاكِ","https://www.poetsgate.com/ViewPoem.aspx?id=189501",""],[6093,"والسهم يقتل مجبورا على القتل","https://www.poetsgate.com/ViewPoem.aspx?id=204998",""],[6142,"كلما اغصوصبوا عليه دحاهم","https://www.poetsgate.com/ViewPoem.aspx?id=155706",""],[6190,"في موكب العطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87009&r=&rc=15",""],[6198,"الموجةُ الطروبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79239&r=&rc=13",""],[406,"نقش على حائط الجراح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63257&r=&rc=76",""]],"verses":[["لَمْ تَلْقَ مُجْتَمَعاً لِكُفْرٍ بَعْدَهَا","قَدْ حِيلَ بَيْنَ الْعَيْرِ وَالنَّزَوَانِ",0,"ن",1,0],["لَم تَلِدنا حَوّاءُ إِلّا لِنَشقى","لَيتَها عاطِلٌ مِنَ الأَولادِ",1,"د",1,0],["لَم تُلفَ صاغِيَتي لَدَيكَ مُضاعَةً","كَلّا وَلا خَفِيَ اِصطِناعي الأَقدَمُ",2,"م",1,0],["لم تَلْقَ عندكم الحياة كرامةً","في حالة فكأنكم أموات",3,"ت",1,0],["لَم تَلقَ جَدّاً كَأَجدادٍ يَعُدُّهُمُ","مَروانُ ذو النورِ وَالفاروقُ وَالحَكَمُ",4,"م",1,0],["لم تُلفِ عبدَ اللَّهِ بل","ألفيتَ زيداً وانتصابهْ",5,"ب",2,0],["لم تلهُ عن حقّ المليكِ ولم تُضعْ","حقَّ الملوكِ فأيُّ حقّ يبطُلُ",6,"ل",1,0],["لم تُلْهِه خَمرُ المرا","شفِ لا ولا خَمْرُ الكروم",7,"م",1,0],["لم تُلْهِهِ عن سُؤددٍ لذةٌ","متى تُغازِلُ غيرَه تُلْهِهِ",8,"ه",2,0],["لَم تَلقَ حَولَكَ غَيرَ كَر","تَرَ وَالنِطاسِيِّ المُعين",9,"ن",1,0],["لَم تَلقَ إِصلاحاً يُهابُ وَلَم تَجِد","مِن كُتلَةٍ ما كانَ أَعيا مِلنَرا",10,"ر",2,0],["لَم تَلقَ غَيرَ الرِقِّ مِن","عُسرٍ عَلى الشَرقِيِّ عاتِ",11,"ت",1,0],["لَم تَلقَ هَذا الوَجهَ شَمسُ نَهارِنا","إِلّا بِوَجهٍ لَيسَ فيهِ حَياءُ",12,"ا",2,0],["لم تلقكَ الأعداءُ تشكو حادثاً","حتى رأوا رُكناً لِيذبُلَ زُلزلا",13,"ل",2,0],["لَم تَلقَ مِثلَ مَساعيهِ الَّتي اِتَّصَلَت","وَما تَقَيَّلَ مِنها عَن أَبٍ فَأَبِ",14,"ب",1,0],["لَم تَلقَهُم زَحفاً وَلَكِن حَملَةً","جاءَت كَضَربَةِ ثائِرٍ لَم يُنجَدِ",15,"د",1,0],["لَم تَلُمني أَنّي سَمَحتُ وَلَكِن","لُمتَ أَنّي أَحسَنتُ بِاللَهِ ظَنّا",16,"ن",2,0],["لمتَ لا لمتَ عميداً قَلْبُهُ","عن سماعِ اللوم فيها ذو انقلاب",17,"ب",1,0],["لم تُلْهِه الدُّنيا ولم يلعبْ بهِ","منها مَتاعٌ زائلٌ وحُطامُ",18,"م",1,0],["لَم تَلقَ مِن حُرَقِ الهَوى","ما قَد لَقيتُ عَلى عِنانِ",19,"ن",1,0],["لَم تُلقِ وابِلَها وَلَكِن خِلتُها","خَيلاً مُسَوَّمَةً مَعَ العُلّاقِ",20,"ق",1,0],["لَم تَلقَ إِلّا جاهِلاً مُتَعاقِلاً","مُتَجَمِّلاً مِنهُم بِغَيرِ جَمالِ",21,"ل",1,0],["لَم تَلقَ في الأَيّامِ إِلّا صاحِباً","تَأَذّى بِهِ طولَ الحَياةِ وَتَألَمُ",22,"م",1,1],["لَمْ تَلْقَ مِنْهُمْ سَلِيماً فِي مَوَدَّتِهِ","كَأَنَّ كُلَّ امْرِئٍ فِي قَلْبِهِ دَخَنُ",23,"ن",1,0],["لَمْ تُلْهِنِي عَنْ طِلابِ الْمَجْدِ غَانِيَةٌ","فِي لَذَّةِ الصَّحْوِ مَا يُغْنِي عَنِ الثَّمَلِ",24,"ل",1,0],["لَمْ تُلْفَ قبْلَكَ أُمَّةٌ فِي مَشْهَدٍ","يُذْرِي الرِّجَالُ بِهِ المَدامعَ ذرَّفا",25,"ف",2,0],["لَمْ تَلْتَمِسْ يَوْماً لَهَا شِهْرَةً","كَلاَّ وَلَمْ تَهْمُمْ بِأَنْ تَفْعَلاَ",26,"ل",2,0],["لم تَلْمَحِ العَيْنُ الطَّمُوحُ شُعَاعَه","حَتَّى رَأَتْ ذَاكَ الشُّعاعَ ظَلامَا",27,"م",2,0],["لم تلق مثل محمد جدًا، ولا","كحفيده -زين الشباب- حفيدا",28,"د",2,0],["لم تَلِدْ أمُّهُ سواهُ غُلامًا","قيمةُ الدرِّ أن يكونَ فريدا",29,"د",2,0],["لم تلههم زهرة الدنيا وزخرفها","اذ همهم صالح يتلوه رضوان",30,"ن",1,0],["لم تلتفت دار ولا بقعة","بدّت على أمن ولا خائفه",31,"ف",2,0],["لم تلقَ إلاّ خيبة","ونسيت صندوقَ السجارة",32,"ر",2,0],["لم تلْقَ فيها صَدُوقاً صادِقاً أَبداً","ولاَ أَخاً يَبْذُلُ الإِنصافَ إِنْ صافَى",33,"ف",2,0],["لم تُلْحه النارُ التي طبختْه","بل أفادته صِبغة َ الأُرجوان",34,"ن",1,0],["لَمْ تَلْقَ مِنْهُمْ سَلِيماً فِي مَوَدَّتِهِ","كَأَنَّ كُلَّ امْرِىء ٍ فِي قَلْبِهِ دَخَنُ",35,"ن",1,0],["لَم تَلقَ إِلّا مُدرِكاً أَو آخِراً","يَروي وَيَنقل مُخبِراً عَن أَول",36,"ل",1,0],["لَم تَلقَ غَير كَبير في مَهابَتِهِ","أَو بَدر داجية يَمشي بِهِ غُصن",37,"ن",1,0],["لم تلد هذه الليالي الحبالي ال","غد والأمس له الكفن",38,"ن",1,0],["لم تلمني أني هويتك لكن","لمت أني رعيت عهداً وإلّا",39,"ل",2,0],["لم تلق في دُنياكَ أعظم فَرْحَةً","ومسَرَّةً من زوجةٍ حسناءِ",40,"ا",2,0],["لم تُلفِ فِيهِ أرِيماً إِن وَقفتَ بِه","إلاَّ رَمَاداً كَكُحلِ العَينِ أو حُمَمَه",41,"م",2,0],["لَم تُلفَ في العُبّادِ وَالزُهّادِ في","هَذا الوَرى فَضلاً عَنِ الأُمَراءِ",42,"ا",2,0],["لَم تُلفَ فيهِ وَهوَ مُلكُكَ شامِخاً","وَسِواكَ يَستَعلي أَوانَ يُعارُهُ",43,"ر",2,0],["لَم تَلقَ إِلّا عارِياً سَبَقَت بِهِ","رَوعاءُ أَو مُستَلئِماً مُستَسلِما",44,"م",2,0],["لم تلمِس البدرَ المنيرَ يدٌ","ولقد ملأتُ يدي من البدر",45,"ر",1,0],["لَم تلهه بهجة الدنيا وَزخرفها","وَلا التفاخر بالاتباعوَالخدم",46,"م",1,0],["لَمْ تَلْحَظ الأَبْصارُ يَوْمَ طَهُورِهِ","إِلاّ كُؤوساً لِلسُّرُور تُدارُ",47,"ر",1,0],["لَم تَلقَ غُرَّتَهُ الشَمسُ المُنيرَةُ في ال","نَهارِ إِلّا بِوَجهٍ غَير مُتَّئِبِ",48,"ب",1,0],["لم تلهم الأبراج قل","بك بعض إلهام المقابر",49,"ر",1,0],["لم تلوم العاشقين الأ","صفياء الأوفياء",50,"ا",2,0],["لَم تَلقَ صَبّاً والِهاً إِلّا سَلا","بِجَمالِها حُبَّ الجَميلِ المُجَمِّلِ",51,"ل",1,0],["لم تَلْبِسِ القُرْطَ أُذْني قَطُّ من كَلِمٍ","إلاّ إذا خَبرٌ من شَطْرِه وَرَدا",52,"د",2,0],["لم تُلف مِنها صديقاً صادقاً أبداً","ولا أخاً يبذُلُ الإنصافَ إنْ صافي",53,"ف",2,0],["لم تلقَ مثلي من يكاد يريه حس","ن الرأي ما قد كان عنه مغيّبا",54,"ب",2,0],["لم تُلههم زينةُ الدنيا وزُخرُفُها","ولا جناها ولا حليٌّ ولا حلَلُ",55,"ل",1,0],["لم تلق غير اله الخلق من سند","ان كنت ذا فطنة أو كنت ذا رشد",56,"د",1,0],["لم تلق سمحا مثله","في القادمين ولا القدم",57,"م",1,0],["لَمْ تَلْقَكَ الضَّرَّاءُ نابيَ حَدِّهِ","كَلّا ولا السَّرَّاءُ ثانِيَ عِطْفِهِ",58,"ف",2,0],["لم تلق إلا حامدا","منا اياديه وشاكر",59,"ر",1,0],["لم تلق منه ولا محاكمة آمرىء","عات فاسرف بطشه المتوالي",60,"ل",2,0],["لم تلق غير مناهل خصرت","لعفاتهِ ومراجل تغلي",61,"ل",2,0],["لَم تُلقِهِ الريحُ سَبطاً","إِلّا اِنثَنى وَهوَ جَعدُ",62,"د",1,0],["لم تلقَ غيرَ حشاً للبينِ مُضْطَرِبٍ","ومدمعٍ مِنْ اتيَّ الدمعِ مُغْترفِ",63,"ف",1,0],["لم تُلقِ يوماً إلى غيري لها بيدٍ","لما رأتْهُ بماً لا تشتهي قَمنَا",64,"ن",2,0],["لم تلثم كافاتها لما انثنت","في الطاء من هاء الهواء المظلم",65,"م",1,0],["لم تَلزمِ الرُّشدَ يابنَ رشدِ","لما عَلا في الزَّمان جَدُّك",66,"ك",1,1],["لم تلقَهُم إلّا وفاجاكَ الرّدى","من جَفنِ غُصْنٍ هُزَّ أو ريمٍ رَنا",67,"ن",2,0],["لم تلْقَ غُصْناً قبلَها من فِضّةٍ","يهتزُّ في ورَقٍ من العِقْيانِ",68,"ن",1,0],["لَم تَلومونا عَلى رَيثِ القُوى","بِخَزارٍ يَومَ ضَمَّتنا الدِيارُ",69,"ر",1,0],["لم تلتئم بأكفّكْم حتّى رأتْ","تصديعكمْ فيها رؤوس الزُّمَّلِ",70,"ل",1,0],["لَم تَلقَ إلّا مَعشراً روّاهُمُ","غِبَّ العِطاشِ تفضُّلٌ وتطوّلُ",71,"ل",1,0],["لم تَلْقَ عيني لها عَيناً ولا أثراً","فلاحَ في الوَهمِ رأيُ الشِرْكِ من ألمِ",72,"م",1,0],["لم تَلقَ أهلاً للإقامةِ عِندَنا","فأقَمْتَ في القُدسِ الشريفِ بمَعزِلِ",73,"ل",1,0],["لم تَلْتَفِتْ قَطُّ للدُّنْيَا لتُحْرِزَها","لكن لتُحْرِزَ فيها مَغْنَمَ الكَرَمِ",74,"م",1,0],["لم تُلاقِ الجيوشَ منهم ولك","نَّكَ لاقيتَهُم بلاداً ومُدْنا",75,"ن",2,0],["لم تلتفتْ عنِّي فأَعْطِفَها","طلباً ولا مُنِعت فأَرْسلها",76,"ل",3,0],["لَم تَلتَفِت لِلِداتِها","وَمَضَت عَلى غُلَوائِها",77,"ا",3,0],["لم تلتبس حكم ولا حكم ولا","نبأن في الحكم الخفي تشابها",78,"ب",3,0],["لم تلاحظْ هذا السنانَ بكفِّي","والمنايا منه يُلاحِظْنَ شَزْرَا",79,"ر",2,0],["لم تلق في معشوقها","صوناً فصانت عشقها",80,"ق",3,0],["لَمْ تَلِدْ مِثْلَهُ الْمُلُوكُ كَمَالاً","فَهُوَ ثَأْرٌ مِنَ الْعَدُوّ مُنِيمُ",81,"م",1,0],["لم تلق شِبْها له في كل منقصةٍ","في الفرسِ والعربِ العرباء والروم",82,"م",1,0],["لم تُلف غير حشاشة ذهبت بها","أيدي النوى لو آذنتْ برجوع",83,"ع",1,0],["لم تَلقَ قوماً هُمُ شَرِّ لاخوتهم","منا عَشيةً يجري بالدَّمِ الوادي",84,"د",2,0],["لم تلقَ نجم النحس إلاَّ غاربا