{"poems":[[30,"تحن بزوراء المدينة ناقتي","https://www.aldiwan.net/poem5618.html","الطويل"],[54,"أيا ويحه ما ذنبه إن تذكرا","https://www.aldiwan.net/poem27049.html","الطويل"],[7,"لقد قلت للنعمان يوم لقيته","https://www.aldiwan.net/poem1993.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[463,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[556,"إن على رمل العقيق خيما","https://www.aldiwan.net/poem47229.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48773","الوافر"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56616","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128707","الوافر"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67203","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65937","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100788","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59466","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[5186,"عهد الولا للآل والصحب","https://www.poetsgate.com/ViewPoem.aspx?id=156449",""],[5691,"بيت الغرابيب","https://www.poetsgate.com/ViewPoem.aspx?id=206248",""]],"verses":[["هُمُ طَلَبوها بِالسُيوفِ وَبِالقَنا","وَجُردٍ شَجٍ أَفواهُها بِالشَكائِمِ",0,"م",1,0],["هُمُ طَرَدوا عَن مُقلَتَي رائِدَ الكَرى","وَشَكّوا سَوادَ القَلبِ حَتّى تَفَطَّرا",1,"ر",2,0],["هُمُ طَرَدوا عَنها بَليّاً فَأَصبَحَت","بَليٌّ بِوادٍ مِن تِهامَةَ غائِرِ",2,"ر",1,0],["هم طردوا الكليمَ كلّ مَطرَدِ","وأتعبوا عَصاه بالتمرُّدِ",3,"د",1,0],["هم طرقوا بسودها وحُمرها","نوائبا خُرْساً وخَطْباً أعجما",4,"م",2,0],["هُمْ طَردوا الإِمْلاقَ عن دِيارهمْ","وأمطروا في المُعتَفين النِّعَما",5,"م",2,0],["همُ طلبوا مكان العيب مني","فأعياهم فقالوا مستفيد",6,"د",1,0],["هم طاردوا العاصين حتى أجفلت","عنه نعائمهم بطول طراد",7,"د",1,0],["هم طلبوا الجميل غنى فأعطى","عطاء ليس يخشى من نفاد",8,"د",1,0],["هُم طلَّقوا لرضا الباري حلائلهم","وواصلوا الحور بالعسالةِ الذُبل",9,"ل",1,0],["هم طلقا دنياهما وتزوجا","مكارهها إِذ فيه مهر الكواعب",10,"ب",1,0],["همُ طرقوا باباً من الحقد موصدا","وهم فتحوا باباً من الكيد مغلقا",11,"ق",2,0],["همطنا عديّاً هَمْطةً يمنيةً","خَلطنا بها مُنهاضَهم بالمجَّبرِ",12,"ر",1,0],["هم طفقير بالحنية والجع","بة يهمي السهام كالأمطار",13,"ر",1,0],["هم طفقير رامياً فتبتت","وتر القوس وهي للأرض فرت",13,"ت",1,0],["هم طوحوا بجمالهم فعلوا","متن النجوم وهامة الشهب",14,"ب",1,0],["همْ طينَةٌ خَبُثَتْ جِبِلَّتُها","نُفِخَتْ بها روحُ الألاعيبِ !",15,"ب",1,0]]}