{"poems":[[55,"ردوا الغليل لقلبي المشغوف","https://www.aldiwan.net/poem29970.html","الكامل"],[74,"تعشقتها في الحلي غصناء منثورا","https://www.aldiwan.net/poem18770.html","الطويل"],[74,"أعيذ ريم الترك بالروم","https://www.aldiwan.net/poem19684.html","السريع"],[64,"لقياك من غير الزمان أمان","https://www.aldiwan.net/poem52256.html","الكامل"],[54,"عصيت في شر فما أنساها","https://www.aldiwan.net/poem27317.html","الرجز"],[50,"لا والتفات الظباء بالمقل","https://www.aldiwan.net/poem66275.html","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[202,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[234,"صبر المحب أحق بالإحجام","https://www.aldiwan.net/poem50808.html","الكامل"],[234,"بلغت بلاغتك البديع وأكثرا","https://www.aldiwan.net/poem51017.html","الكامل"],[261,"ولقد عهدتك تشتهي","https://www.aldiwan.net/poem48568.html","مجزوء الكامل"],[264,"يمم ندى غيث الكرام العلي","https://www.aldiwan.net/poem35740.html","السريع"],[325,"نيشان مجد للخليل أسنى","https://www.aldiwan.net/poem67180.html","الرجز"],[398,"قل للوزير أبي محمد الذي","https://www.aldiwan.net/poem53584.html","الكامل"],[445,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[445,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[457,"ليت عندي الحبيب أو","https://www.aldiwan.net/poem13719.html","مجزوء الخفيف"],[473,"يا موردا من جود","https://www.aldiwan.net/poem60181.html","المجتث"],[520,"رميت يا دهر كف المجد بالشلل","https://www.aldiwan.net/poem12225.html","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126815","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34404","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56338","البسيط"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31620","المتقارب"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128287","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64636","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108851","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108974","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109419","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28587","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65947","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205878","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132676","المنسرح"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92026","الخفيف"],[3913,"","https://poetry.dctabudhabi.ae/diwan/poem/198355","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111469","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119644","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141677","الكامل"],[5431,"كليّ معك ...","https://www.poetsgate.com/ViewPoem.aspx?id=199533",""],[5431,"سبحان الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=208038",""],[5953,"ألا يا رجال الحق بالحق أبشروا","https://www.poetsgate.com/ViewPoem.aspx?id=93852",""],[5001,"الرسم بالحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80718&r=&rc=8",""]],"verses":[["وَفَطَمتُكُم بِالزَجرِ عَن عاداتِكُم","وَرَدَدتُ مُنكَرَكُم إِلى المَعروفِ",0,"ف",1,0],["وفطر أفواهاً ولولاه لم نجد","سوى في سماوات القلوب فتورا",1,"ر",2,0],["وفطّري أكباد أنداده","وعن سوى إمداده صومي",2,"م",2,0],["وفطِنتَ للعلياءِ حين تحيَّرتْ","فيها العقولُ وضلَّتِ الأذهانُ",3,"ن",1,0],["وَفَطَنَت أَعيُنُ مَن يَكلاها","وَشَغَلَ العُيونُ عَنّي فاها",4,"ا",3,0],["وفطنةِ الشاعرِ الأريبِ إذا","حلّ سراويلَ مُطرقٍ خجِل",5,"ل",1,0],["وَفِطْنَةٍ سَاهِرَةٍ لِلْعُلَى","عَلَّمَتِ الشُّهْبَ جَمِيلَ السُّهَادْ",6,"د",1,0],["وَفِطْنَةٌ شِبْهُ سَنىً","فِي دُرَّةٍ مُشْتَعِلِ",7,"ل",1,0],["وفطنةٍ قصَّرَ عن نَعْتِها","أو بعضِها المُطْنِبُ والمسهب",8,"ب",1,0],["وفطانةً نبويّةً وحَزامةً","عَلَويّة لم تتّفق لإمام",9,"م",1,0],["وفطانة عَلَوية قد فجَّرت","للناس من طُرُق البلاغة أبحرا",10,"ر",2,0],["وفطائر عجنت بلا المل","ح الجريش ولا الخمير",11,"ر",1,0],["وفطنةٍ تكشف ما يختفي","من عارضٍ في الحادث المشكل",12,"ل",1,0],["وَفِطنَةً زَكِيَّةً جَلِيَّةً","وَعِزَّةً في نَفسِهِ سَجِيَّة",13,"ه",1,0],["وَفَطَمتَني مِن بَعدِها عَنها فَقَد","أَصبَحتُ ذا حزنٍ يُقيم وَيُقعِد",14,"د",1,0],["وفِطرٌ تحلَّى بالصلاةِ إلى الَّذي","دَعَوْناهُ ألّا يُوحِشَ الأرْضَ مِنكُما",15,"م",2,0],["وَفُطِمْتَ يوْمَ فُطِمتَ فِي رَهَجِ الوَغى","عند التفافِ كتائبٍ بكتائبِ",16,"ب",1,0],["وفِطامي عن الهوى","رامَ فاخترتُ قصْدَه",17,"د",2,0],["وَفَطنَةٌ هِيَ صُبحٌ","في المُشكِلاتِ السودِ",18,"د",1,0],["وفطرة الصوم إن أصغت مكارمكم","تشكو من الدهر حيفاً غير محتمل",19,"ل",1,0],["وفطرس لاذَ فيه وهوَ مُعتصمٌ","بهِ فنالَ الرِضى من واحد أزلِ",20,"ل",1,0],["وَفُطِّرَ القَلب مَمّا صام عَن فرح","فيهِ وَيَومَ أَرى ناديك لي عيدُ",21,"د",1,0],["وفطنةً واختباراً في الأمور وفي","حال الزمان ورأياً منك لم يخبِ",22,"ب",1,0],["وفِطْرٍ تَواصَلَ إِقْبالُهُ","لأَنَّ لَهُ بِالسُّعودِ اتِّصالا",23,"ل",2,0],["وفطنة جوال وبطأة غائص","ليأخذ من طيب الصفا بنصيب",24,"ب",1,0],["وفطرة النفس في أيدي بصيرتها","فارم البصيرة حيث النفس تقتحم",25,"م",1,0],["وفطانةٌ لو كنتُ ممن آمنوا","بخرافة التنجيم قلتُ منجما",26,"م",2,0],["وفطاحلاً ما شاركوا بفخارهم","بشراً وفي أموالهم شركاء",27,"ا",2,0],["وفطنته تبدي متى شأ حكمةً","لها أثر في جبهة الدهر يرسم",28,"م",1,0],["وَفَطِنتَ بي فَلَبِستُ ما لَم يَلبَسوا","مِن وَشيهِ وَغَنِمتُ ما لَم يَغنَموا",29,"م",3,0],["وفطر ليث في العجاج لظهره","يرى ضاحكاً مستلقياً غير عامد",30,"د",1,0],["وفطنة لمعاني ما تردده","بترنيمها أسرار خافيها",31,"ي",3,0],["وفطنة يبرق الذكاء بها","فلو بها البرق مرّ لاحترقا",32,"ق",2,0],["وَفِّ طُولَ البكا بدمعٍ مديدِ","وَالقَ يَومَ النَوى ببأس شَديدْ",33,"د",1,1],["وفطنة علم تحتها إن دجا الوغى","جهالة رمح أو سفاهة صارم",34,"م",1,0],["وفَطرُقلُ ذُو الهِمَّاتِ يُضرِمُ وَقدَهُ","إِلى أَن لَهِيبُ النَّارِ بُدِّدَ واضمَحَل",35,"ل",1,0],["وفطرقلٌ صريعٌ لا يفي","ض عليه دمع أسى",36,"س",2,0],["وفطرقل شك وأفطمذٌ","وقد برز الإلتقاء الدراهس",37,"س",1,0],["وفطرقل يصرخ مذ أقبلوا","يعج الفضاء بضجتهم",37,"م",1,0],["وفطرقل يزهو وأفطمذٌ","بصدرهم ببهي الحلى",37,"ل",2,0],["وفطرقل في صدر جند الأخاء","على عرليق السنان أطار",37,"ر",1,0],["وفطرقل ينخي كتائبه","لسحق جيوش العدى ويغير",37,"ر",1,0],["وفطرقل بين الصدو صدر","وساق إلى الفلك تلك الزمر",37,"ر",1,0],["وفطرقل داس على صدره","لينتزع العامل الممتهي",37,"ي",1,0],["وفطرقل أفطمذا والخيول","وراء العدى حث فوق السهول",37,"ل",1,0],["وفطرقل صاح به ساخراً","فيا للباقته كيف يجري",37,"ي",1,0],["وفطنةٍ نفذت في كل مجملةٍ","لحَبر فاراب قد يعزى مفصَّلها",38,"ه",2,0],["وفطرت قلبي بالجفا عمداً فلا","عجب إذا ما قلت أنك فاطري",39,"ر",2,0],["وفطائر الوجد اللذيذ","معّدةٌ كي تشبعك",40,"ك",1,0],["وفطرتنا تومي بعيني قصيدة","مكحلة المعنى من الحسن تلمعُ",41,"ع",1,0],["وفطحية وسمعليون دمروا","وبنجية حيرانة ومعذقر",42,"ر",1,0],["وفطنت يوماً والزمان يميل بي","إن الجميع لميله قد مالوا",43,"ل",3,0]]}