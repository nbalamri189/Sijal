{"poems":[[53,"ردوا الغليل لقلبي المشغوف","https://www.aldiwan.net/poem29970.html","الكامل"],[72,"تعشقتها في الحلي غصناء منثورا","https://www.aldiwan.net/poem18770.html","الطويل"],[72,"أعيذ ريم الترك بالروم","https://www.aldiwan.net/poem19684.html","السريع"],[62,"لقياك من غير الزمان أمان","https://www.aldiwan.net/poem52256.html","الكامل"],[52,"عصيت في شر فما أنساها","https://www.aldiwan.net/poem27317.html","الرجز"],[48,"لا والتفات الظباء بالمقل","https://www.aldiwan.net/poem66275.html","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[196,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[227,"صبر المحب أحق بالإحجام","https://www.aldiwan.net/poem50808.html","الكامل"],[227,"بلغت بلاغتك البديع وأكثرا","https://www.aldiwan.net/poem51017.html","الكامل"],[254,"ولقد عهدتك تشتهي","https://www.aldiwan.net/poem48568.html","مجزوء الكامل"],[257,"يمم ندى غيث الكرام العلي","https://www.aldiwan.net/poem35740.html","السريع"],[318,"نيشان مجد للخليل أسنى","https://www.aldiwan.net/poem67180.html","الرجز"],[390,"قل للوزير أبي محمد الذي","https://www.aldiwan.net/poem53584.html","الكامل"],[436,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[436,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[450,"ليت عندي الحبيب أو","https://www.aldiwan.net/poem13719.html","مجزوء الخفيف"],[466,"يا موردا من جود","https://www.aldiwan.net/poem60181.html","المجتث"],[513,"رميت يا دهر كف المجد بالشلل","https://www.aldiwan.net/poem12225.html","البسيط"]],"verses":[["وَفَطَمتُكُم بِالزَجرِ عَن عاداتِكُم","وَرَدَدتُ مُنكَرَكُم إِلى المَعروفِ",0,"ف",1,0],["وفطر أفواهاً ولولاه لم نجد","سوى في سماوات القلوب فتورا",1,"ر",2,0],["وفطّري أكباد أنداده","وعن سوى إمداده صومي",2,"م",2,0],["وفطِنتَ للعلياءِ حين تحيَّرتْ","فيها العقولُ وضلَّتِ الأذهانُ",3,"ن",1,0],["وَفَطَنَت أَعيُنُ مَن يَكلاها","وَشَغَلَ العُيونُ عَنّي فاها",4,"ا",3,0],["وفطنةِ الشاعرِ الأريبِ إذا","حلّ سراويلَ مُطرقٍ خجِل",5,"ل",1,0],["وَفِطْنَةٍ سَاهِرَةٍ لِلْعُلَى","عَلَّمَتِ الشُّهْبَ جَمِيلَ السُّهَادْ",6,"د",1,0],["وَفِطْنَةٌ شِبْهُ سَنىً","فِي دُرَّةٍ مُشْتَعِلِ",7,"ل",1,0],["وفطنةٍ قصَّرَ عن نَعْتِها","أو بعضِها المُطْنِبُ والمسهب",8,"ب",1,0],["وفطانةً نبويّةً وحَزامةً","عَلَويّة لم تتّفق لإمام",9,"م",1,0],["وفطانة عَلَوية قد فجَّرت","للناس من طُرُق البلاغة أبحرا",10,"ر",2,0],["وفطائر عجنت بلا المل","ح الجريش ولا الخمير",11,"ر",1,0],["وفطنةٍ تكشف ما يختفي","من عارضٍ في الحادث المشكل",12,"ل",1,0],["وَفِطنَةً زَكِيَّةً جَلِيَّةً","وَعِزَّةً في نَفسِهِ سَجِيَّة",13,"ه",1,0],["وَفَطَمتَني مِن بَعدِها عَنها فَقَد","أَصبَحتُ ذا حزنٍ يُقيم وَيُقعِد",14,"د",1,0],["وفِطرٌ تحلَّى بالصلاةِ إلى الَّذي","دَعَوْناهُ ألّا يُوحِشَ الأرْضَ مِنكُما",15,"م",2,0],["وَفُطِمْتَ يوْمَ فُطِمتَ فِي رَهَجِ الوَغى","عند التفافِ كتائبٍ بكتائبِ",16,"ب",1,0],["وفِطامي عن الهوى","رامَ فاخترتُ قصْدَه",17,"د",2,0],["وَفَطنَةٌ هِيَ صُبحٌ","في المُشكِلاتِ السودِ",18,"د",1,0],["وفطرة الصوم إن أصغت مكارمكم","تشكو من الدهر حيفاً غير محتمل",19,"ل",1,0]]}