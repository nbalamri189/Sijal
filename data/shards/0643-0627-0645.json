{"poems":[[93,"تحت قدس الأقداس نم بسلام","https://www.aldiwan.net/poem11383.html","الخفيف"],[27,"أصاح أليس اليوم منتظري صحبي","https://www.aldiwan.net/poem5684.html","الطويل"],[27,"قالوا نصيبك من أجر فقلت لهم","https://www.aldiwan.net/poem5959.html","البسيط"],[37,"كأم البيض تلحفه غدافا","https://www.aldiwan.net/poem7420.html","الوافر"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"ليس يدري الهم غير المبتلي","https://www.aldiwan.net/poem9064.html","عموديه"],[70,"خذ فارغا وهاته ملآنا","https://www.aldiwan.net/poem42685.html","الرجز"],[70,"سيدي يومك هذا","https://www.aldiwan.net/poem42727.html","مجزوء الرمل"],[70,"دمت في أرغد عيش","https://www.aldiwan.net/poem42945.html","مجزوء الرمل"],[85,"مصاب بني الدنيا عظيم بأدهم","https://www.aldiwan.net/poem62830.html","الطويل"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[28,"لعمري لأعرابية في مظلة","https://www.aldiwan.net/poem5368.html","الطويل"],[39,"أصاح ألا هل من سبيل إلى هند","https://www.aldiwan.net/poem53784.html","الطويل"],[46,"أقاتلي الزمان قصاص عمد","https://www.aldiwan.net/poem22628.html","الوافر"],[1,"سائلوا عنا الذي يعرفنا","https://www.aldiwan.net/poem34017.html","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67325","الوافر"],[51,"وَلِحْيَة ِ سُوءٍ وَلكنَّهَا","https://www.poetsgate.com/ViewPoem.aspx?id=30777",""],[51,"أما الزمانُ إلى سلمى فقد جَنَحا","https://www.poetsgate.com/ViewPoem.aspx?id=27419",""],[51,"يمَّنَ اللهُ طلعة المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=30807",""],[141,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[180,"عرجا في ربوعها وسلاها","https://www.aldiwan.net/poem67021.html","الخفيف"],[208,"يا فتى بالبديع حل كلامه","https://www.aldiwan.net/poem13391.html","الخفيف"],[210,"ونشوانة الأعطاف غرثاء بضة","https://www.aldiwan.net/poem37848.html","الطويل"],[233,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[248,"أبروق يلوح منها وميض","https://www.aldiwan.net/poem14988.html","الخفيف"],[273,"من الملك المحيا في الرواق","https://www.aldiwan.net/poem25475.html","الوافر"],[273,"لرأيك كانت الأزمان تصغي","https://www.aldiwan.net/poem25481.html","الوافر"],[273,"ظهيراك التوكل والمضاء","https://www.aldiwan.net/poem25645.html","الوافر"],[302,"يا نديمي فؤادي مرتهن","https://www.aldiwan.net/poem16783.html","الطويل"],[362,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[436,"جهز لنا في الأرض غزوة محتسب","https://www.aldiwan.net/poem34905.html","الكامل"],[459,"تعدتك أعراض الخطوب وجانبت","https://www.aldiwan.net/poem15441.html","الطويل"],[556,"طلع امبدر في دياجي امظلام","https://www.aldiwan.net/poem33869.html","الخفيف"],[560,"بين رئم الحمى وآرام رامه","https://www.aldiwan.net/poem52971.html","الخفيف"]],"verses":[["كَامِلُ الخُطْوَتَيْنِ دِيناً وَدُنْيَا","بَالِغاً مِنْهُمَا أجَلَّ مُرَامِ",0,"م",1,0],["كَأُمِّ الطَلا تَعتادُ وَهيَ غَريرَةٌ","بِأَجمَدَ رَهبى عاقِدَ الجيدِ كَالقُلبِ",1,"ب",1,0],["كَأُمِّ بَوٍّ عَجولٍ عِندَ مَعهَدِهِ","حَنَّت إِلى جِلَدٍ مِنهُ وَأَوصالِ",2,"ل",1,0],["كأم البيض تُلحفه غُدافاً","وتفرشه من الدمث المهيلِ",3,"ل",1,1],["كامرئ القيس قَرْمِهِم وزُهيرٍ","وزِيادٍ أخي بني ذبيانِ",4,"ن",1,0],["كامِناً فَاِنصاعَ يُدنيهِ الظَما","ثُمَّ يُقصيهِ اِتِّقاءُ الأَجَلُ",5,"ل",1,0],["كامِلَةَ الحُسنِ حَكَت غُصنَ النَقا","الرَيّانَ أَو غَزالَهُ العَطشانا",6,"ن",2,0],["كامِلُ الظَرفِ أَديبٌ","شامِخُ الأَنفِ أَشَمُّه",7,"م",2,0],["كامِلُ الحُسنِ فَما أَغ","ناهُ عَن حُسنِ النَشيدِ",8,"د",1,0],["كَأُمِّ شَهيدٍ قَد أَتاها نَعيُّهُ","فَخَفَّت لَهُ بَينَ البُكا وَالتَبَسُّمِ",9,"م",1,0],["كَأُمِّ موسى عَلى اِسمِ اللَهِ تَكفُلُنا","وَبِاِسمِهِ ذَهَبَت في اليَمِّ تُلقينا",10,"ن",2,0],["كَأُمُّ غَزالٍ أَو كَدُرَّةِ غائِصٍ","إِذا ما بَدَت مِثلَ الغَمامَةِ تُشرِقُ",11,"ق",1,0],["كَأُمِّ حُبَينٍ لَم يَرَ الناسُ غَيرَها","وَغابَ حُبَينٌ حيث غابَت بَنو سَعدِ",12,"د",1,0],["كَأُمِّ القَزِّ يَخرُجُ مِن حَشاها","ذُرى بَيتٍ لَها فَيَعودُ قَبرا",13,"ر",2,0],["كامِلٍ يَحمِلُ آلاءَ الفَتى","نَبِهٍ سَيِّدِ ساداتٍ خِضَم",14,"م",1,0],["كأمسِ كعهدها لم يغْفُ عيناً","بليلٍ أَقسمتْ ألَّاَ تنامهْ",15,"م",2,0],["كأمواج بحرٍ زاخرٍ متلاطمٍ","ينابيعُهُ شتَّى ذُرىً ورِعانِ",16,"ن",1,0],["كأمْثالِ العَقَائقِ أَخْلَصَتْهَا","قُيُونُ الهندِ لم تُضْرَبْ كَتِيفَا",17,"ف",2,0],["كامل إن كنت تمقتُ من أساءَ لأنَّه","مِمّنْ أساءَ وإن سَلمتَ عليهِ",18,"ي",2,0],["كامل تتجمل الحسناءُ كلَّ تجملٍ","حتى إذا ما أُبرز المفتاحُ",19,"ح",1,0],["كامرىء القيس قَرْمِهِم وزُهيرٍ","وزِيادٍ أخي بني ذبيانِ",20,"ن",1,0],["كَاِمتِناعِ النُجومِ في حَيثُ حَلَّت","لا اِمتِناعِ اللُيوثِ في الأَغيالِ",21,"ل",1,0],["كاملُ الفَضلِ في اِقتِبالِ شَبابٍ","هانَ فيهِ عَلى الشُيوخِ نُهاها",22,"ا",3,0],["كامل وافر مديد بسيط","جاء تخليعه عليه علامه",23,"م",2,0],["كأمثالِ طيفٍ قد ألَمَّ بِمَضْجَعي","ولا قَبَضَتْهُ راحتي وأنَامِلِي",24,"ي",1,0],["كامِنٌ في سِرارِ أَعطافِهِ المَج","دُ وَلِلنارِ في الزِنادِ كَمونُ",25,"ن",1,0],["كاملُ الفضل ذو نوالٍ سريعٍ","يَتَحَلَّى بالوصف منه العَرُوضُ",26,"ض",1,0],["كأَمْثَالِ الخَمَائِلِ نَاضِراتٌ","وَقَاهَا مِنْ جُفُوف المَحْلِ وَاقِ",27,"ق",1,0],["كَإمْساكِ السَّحابِ لطُول سَحٍّ","وَإِجْبَالِ البَليغِ لِفَرْطِ نَبْغِ",28,"غ",1,0],["كأمثالِ المَذَاكي سابحاتٍ","لها عَدْوٌ لِمَنْ فيهِ اعتِداءُ",29,"ا",2,0],["كامل الوصف ذي الوجه الحسن","يخجل البدر نوره والسنا",30,"ن",2,0],["كاملُ الفَضْلِ والنهى وهْو ينْمى","هل رأَيتُم تكاملاً في نماء",31,"ا",2,0],["كأَمير لُونَةَ قَدْ تطلَّعَ إِذْ دَنا","عبدُ الملِيكِ إِلَيْهِ فِي جَيشٍ لَجبْ",32,"ب",1,0],["كأمِّ الوحيد الفرد من بعد كَبْرة","تُصدِّق من اِشفاقها كلَّ كاذبِ",33,"ب",1,0],["كامل امخلقِ في امخليقةِ إني","في امهوى عنده أسيرُ امغرام",34,"م",1,0],["كإِمام القُضاةِ مولى الموالي","كَعْبةِ الفضلِ العالمِ العَلاَّمَهْ",35,"م",2,0]]}