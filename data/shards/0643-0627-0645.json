abudhabi.ae/diwan/poem/103038","الخفيف"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45030","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45029","الطويل"],[4239,"","https://poetry.dctabudhabi.ae/diwan/poem/102201","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120513","الرمل"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4691,"طفلة اسمها (ليان)","https://www.poetsgate.com/ViewPoem.aspx?id=114274",""],[4859,"ليس لي في الهوى وربك أمر!","https://www.poetsgate.com/ViewPoem.aspx?id=204286",""],[4961,"ليسَ في أوَّل ِ الطريق ِ يُكتشَفُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=40462",""],[5136,"حبه بالروح ممتزج","https://www.poetsgate.com/ViewPoem.aspx?id=121535",""],[5277,"الأميرة","https://www.poetsgate.com/ViewPoem.aspx?id=191241",""],[5307,"صوتِك الموسِيقْ","https://www.poetsgate.com/ViewPoem.aspx?id=10532",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5376,"بدرٌ به للهائمين ضياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=204770",""],[5431,"لستَ مثلي!","https://www.poetsgate.com/ViewPoem.aspx?id=200646",""],[5453,"أم(بك)وت","https://www.poetsgate.com/ViewPoem.aspx?id=28016",""],[5480,"خزني بالعين","https://www.poetsgate.com/ViewPoem.aspx?id=1587",""],[5582,"أَتَعْلَمُ ذاتُ الغُنْجِ أَمْ لَيْسَ تَعْلَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=187302",""],[5739,"قلبي وكر ...!","https://www.poetsgate.com/ViewPoem.aspx?id=155476",""],[5756,"تزعلين وتقعدين","https://www.poetsgate.com/ViewPoem.aspx?id=34908",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[6056,"شعاع الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=130143",""],[6056,"نجاحي بعيد الإحتمال .....!","https://www.poetsgate.com/ViewPoem.aspx?id=130158",""],[6093,"لو تراه سيدي خضر ( المديد)","https://www.poetsgate.com/ViewPoem.aspx?id=176023",""],[6113,"نوال","https://www.poetsgate.com/ViewPoem.aspx?id=12877",""],[6113,"السالفه...............!!!","https://www.poetsgate.com/ViewPoem.aspx?id=41916",""],[6152,"عودة روح","https://www.poetsgate.com/ViewPoem.aspx?id=202042",""],[6152,"يد الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=203390",""],[520,"يا سيدا يشهد لي خلقه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577693",""],[5555,"راقصة الجاز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87419&r=&rc=14",""]],"verses":[["كأماني ظالم يرنو إلى","مقلتيه شبح من ثائر",0,"ر",1,0],["كَامِلُ الخُطْوَتَيْنِ دِيناً وَدُنْيَا","بَالِغاً مِنْهُمَا أجَلَّ مُرَامِ",1,"م",1,0],["كَأُمِّ الطَلا تَعتادُ وَهيَ غَريرَةٌ","بِأَجمَدَ رَهبى عاقِدَ الجيدِ كَالقُلبِ",2,"ب",1,0],["كَأُمِّ بَوٍّ عَجولٍ عِندَ مَعهَدِهِ","حَنَّت إِلى جِلَدٍ مِنهُ وَأَوصالِ",3,"ل",1,0],["كأم البيض تُلحفه غُدافاً","وتفرشه من الدمث المهيلِ",4,"ل",1,1],["كامرئ القيس قَرْمِهِم وزُهيرٍ","وزِيادٍ أخي بني ذبيانِ",5,"ن",1,0],["كامِناً فَاِنصاعَ يُدنيهِ الظَما","ثُمَّ يُقصيهِ اِتِّقاءُ الأَجَلُ",6,"ل",1,0],["كامِلَةَ الحُسنِ حَكَت غُصنَ النَقا","الرَيّانَ أَو غَزالَهُ العَطشانا",7,"ن",2,0],["كامِلُ الظَرفِ أَديبٌ","شامِخُ الأَنفِ أَشَمُّه",8,"م",2,0],["كامِلُ الحُسنِ فَما أَغ","ناهُ عَن حُسنِ النَشيدِ",9,"د",1,0],["كَأُمِّ شَهيدٍ قَد أَتاها نَعيُّهُ","فَخَفَّت لَهُ بَينَ البُكا وَالتَبَسُّمِ",10,"م",1,0],["كَأُمِّ موسى عَلى اِسمِ اللَهِ تَكفُلُنا","وَبِاِسمِهِ ذَهَبَت في اليَمِّ تُلقينا",11,"ن",2,0],["كَأُمُّ غَزالٍ أَو كَدُرَّةِ غائِصٍ","إِذا ما بَدَت مِثلَ الغَمامَةِ تُشرِقُ",12,"ق",1,0],["كَأُمِّ حُبَينٍ لَم يَرَ الناسُ غَيرَها","وَغابَ حُبَينٌ حيث غابَت بَنو سَعدِ",13,"د",1,0],["كَأُمِّ القَزِّ يَخرُجُ مِن حَشاها","ذُرى بَيتٍ لَها فَيَعودُ قَبرا",14,"ر",2,0],["كامِلٍ يَحمِلُ آلاءَ الفَتى","نَبِهٍ سَيِّدِ ساداتٍ خِضَم",15,"م",1,0],["كأمسِ كعهدها لم يغْفُ عيناً","بليلٍ أَقسمتْ ألَّاَ تنامهْ",16,"م",2,0],["كأمواج بحرٍ زاخرٍ متلاطمٍ","ينابيعُهُ شتَّى ذُرىً ورِعانِ",17,"ن",1,0],["كأمْثالِ العَقَائقِ أَخْلَصَتْهَا","قُيُونُ الهندِ لم تُضْرَبْ كَتِيفَا",18,"ف",2,0],["كامل إن كنت تمقتُ من أساءَ لأنَّه","مِمّنْ أساءَ وإن سَلمتَ عليهِ",19,"ي",2,0],["كامل تتجمل الحسناءُ كلَّ تجملٍ","حتى إذا ما أُبرز المفتاحُ",20,"ح",1,0],["كامرىء القيس قَرْمِهِم وزُهيرٍ","وزِيادٍ أخي بني ذبيانِ",21,"ن",1,0],["كأمس ، كعهدها ، لم بغف عينا","بليل أقسمت ألا تنامه",22,"م",2,0],["كَاِمتِناعِ النُجومِ في حَيثُ حَلَّت","لا اِمتِناعِ اللُيوثِ في الأَغيالِ",23,"ل",1,0],["كاملُ الفَضلِ في اِقتِبالِ شَبابٍ","هانَ فيهِ عَلى الشُيوخِ نُهاها",24,"ا",3,0],["كامل وافر مديد بسيط","جاء تخليعه عليه علامه",25,"م",2,0],["كأمثالِ طيفٍ قد ألَمَّ بِمَضْجَعي","ولا قَبَضَتْهُ راحتي وأنَامِلِي",26,"ل",2,0],["كامِنٌ في سِرارِ أَعطافِهِ المَج","دُ وَلِلنارِ في الزِنادِ كَمونُ",27,"ن",1,0],["كاملُ الفضل ذو نوالٍ سريعٍ","يَتَحَلَّى بالوصف منه العَرُوضُ",28,"ض",1,0],["كأَمْثَالِ الخَمَائِلِ نَاضِراتٌ","وَقَاهَا مِنْ جُفُوف المَحْلِ وَاقِ",29,"ق",1,0],["كَإمْساكِ السَّحابِ لطُول سَحٍّ","وَإِجْبَالِ البَليغِ لِفَرْطِ نَبْغِ",30,"غ",1,0],["كأمثالِ المَذَاكي سابحاتٍ","لها عَدْوٌ لِمَنْ فيهِ اعتِداءُ",31,"ا",2,0],["كامل الوصف ذي الوجه الحسن","يخجل البدر نوره والسنا",32,"ن",2,0],["كاملُ الفَضْلِ والنهى وهْو ينْمى","هل رأَيتُم تكاملاً في نماء",33,"ا",2,0],["كأَمير لُونَةَ قَدْ تطلَّعَ إِذْ دَنا","عبدُ الملِيكِ إِلَيْهِ فِي جَيشٍ لَجبْ",34,"ب",1,0],["كأمِّ الوحيد الفرد من بعد كَبْرة","تُصدِّق من اِشفاقها كلَّ كاذبِ",35,"ب",1,0],["كامل امخلقِ في امخليقةِ إني","في امهوى عنده أسيرُ امغرام",36,"م",1,0],["كإِمام القُضاةِ مولى الموالي","كَعْبةِ الفضلِ العالمِ العَلاَّمَهْ",37,"م",2,0],["كأمين وصفى الشهم من لم يرتكب","كسواه متن الاثم والاوزار",38,"ر",1,0],["كأمير أندلس وناصرها الذي","أفنى العداة حسامه السفاح",39,"ح",1,0],["كامل عاقل أَمير حليم","لِلمَعالي في دَولة السَعد خاطب",40,"ب",1,0],["كامِلٌ كلَّ الكمالِ فما","تَرتقي في وصفهِ الفِكَرُ",41,"ر",1,0],["كامِلُ الذّاتِ حَميدُ الشَّيَمِ","حَسَنُ الخلقِ عَلى حُسنِ كَمالْ",42,"ل",1,0],["كامِلٌ بَدرُ تَمامٍ","قَمرٌ يَنقُصُ شَهرا",43,"ر",2,0],["كامِلُ الأَوصافِ حاوي الهَيَفِ","خُصَّ بِالحُسْنِ تَعالَى مَنْ حَباهْ",44,"ه",1,0],["كامل ما مثله أحد","كل وصف فيه قد كملا",45,"ل",2,0],["كامل الحسن ظاهر البشر أضفى","بسناه الشموس والأقمارا",46,"ر",2,0],["كاملُ الحسنِ بديعٌ حسنهُ","يعجزُ الواصفَ مِن حيثُ وصف",47,"ف",1,0],["كأُمنية المَلهوف حَزماً وَنائِلاً","وَعَوناً عَلى عَمياءِ أَمرٍ يُكيدها",48,"د",3,0],["كأمير العصر لا ندّ لهُ","في الورى سبحانه المعطي المجيزْ",49,"ز",1,0],["كامل الاوصاف وهي به","شرفت بالمكرمات سمى",50,"م",2,0],["كَامرَأة الراعي فَقُلت من هِي","جئني مِن قصتها بِالكنه",51,"ه",1,0],["كَاِمرَأة التاجر ضعف عَقلها","وَالجَهل أَغراها بِعَيب بعلها",52,"ه",2,0],["كاملها بمتفاعلن برد","على الولا سنا كما عنهم عهد",53,"د",1,0],["كامل ما فيهِ مِن عَيب سِوى","أَنَّهُ في مِثلِهِ الدَهر يَشح",54,"ح",1,0],["كامل المجد رأيه كحسامٍ","عاملٍ يقطع الأمور العصيه",55,"ي",2,0],["كامل حل من ذرى فلك المج","د مقاماً بحسن رأى مصيب",56,"ب",1,0],["كامل بنفسه عديم الإشتباه","تكون إليه الإشاره بالبنان",57,"ن",1,0],["كَأَمانَةٍ أَدَّيتَها لَم تَرزَها","حَتّى أَتاكَ مُعَجَّلاً ما توعَدُ",58,"د",1,0],["كامل إرث جده واقتفاه","قصرت عن مقامه الفضلاء",59,"ا",2,0],["كامِلُ الأوصافِ حُسناً يا لَهُ","إِن تَبَدَّى طَالِعاً وَامُقلَتَى",60,"ا",1,0],["كاملُ المجدِ تاركٌ كلَّ خَصْمٍ","يتنامى علاه بالنُّقصانِ",61,"ن",1,0],["كاملة في ذاتها مثل ما","يشهدها السافل في الأسفل",62,"ل",1,0],["كاملٍ كل المعاني","حاويٍ كل الصِفاه",63,"ا",2,0],["كامل الآوصاف اِن قام وْقَعَدْ","وان مشَى في الآرض لَهْ مَشْيَه بْهود",64,"د",1,0],["كامل الحسن وافر ظل وجدي","فيه يا عاذلي مديدا طويلا",65,"ل",2,0],["كأمثال الصلال بكل شعب","نوافث بالسمام نسور سورا",66,"ر",2,0],["كامِنٍ في التُربِ مُندفنٍ","وَضَئيلِ الجِسمِ مُحتَقَرِه",67,"ر",2,0],["كاملة لا النهار يكسبها","نوراً ولا ليله يغيبها",68,"ب",3,0],["كأمثالكم كُنّا نُسرُّ بعيشنا","ونغترُّ في ظلِّ النعيم بدهرنا",69,"ن",2,1],["كامِنُ الحقدِ فِي النفوس وأَنَّى","يذهبُ الضِّغْنُ من فؤادِ المُناصِب",70,"ب",1,0],["كامل في صفاته حل مرقى","في المعالي من دونه الفرقدان",71,"ن",1,0],["كامن الحسن فمن لي","منه بالثغر المبرد",72,"د",1,0],["كامن الوجد له العذل أثارا","إذ أراد العاذل النصح فجارا",73,"ر",2,1],["كامل الوصف جامعٌ همة الضر","غام فيه للطف ذات الحجال",74,"ل",1,0],["كامل حسن ردفه وافر","طويل شعر لي جفاه مديد",75,"د",1,0],["كامل لما سرى ألهمه","علم ما اللوح حواه الصمد",76,"د",1,0],["كامل يكتسي الجليس لديه","ثوب أنس وبهجة ومهابه",77,"ب",2,0],["كامِلُ رِدفِهِ وَقَد حازَ خَصراً","ناقِصاً بِالإِبهامِ يُمكِنُ عِقدَه",78,"د",2,0],["كامِلَةِ الأَردافِ لَكِن لَها","خَصرٌ وَمِن نُقصانِهِ ما يُبانِ",79,"ن",1,0],["كاملُ حاملُ وكاليء اكلأَ","لنا بحفظٍ عنّا شرّا فادرأَ",80,"ر",2,0],["كامل كله كمال وحلم","أسد وارد دم الآساد",81,"د",1,0],["كَأَمثال هَذا الجِسر حُسناً وَبَهجَةً","وَإِحكام رَصفٍ لا يَبيدُ مَدى الخُلد",82,"د",1,0],["كَأَمثال هَذا الجِسر حُسناً وَبَهجَةً","وَإِحكام رَصفٍ لا يَبيدُ عَلى الدَهر",83,"ر",1,0],["كامل خلقة عريق مغرس","جميل هندام نظيف ملبس",84,"س",1,0],["كامل الأوصاف ذو أصل زكا","واصل الآلاف ذو قدر مكين",85,"ن",1,0],["كإمام الهدى نيوتن نبراس","ذوي الفضل كاشف الجاذبية",86,"ي",2,0],["كامتطاء الفؤاد صهوة حلمٍ","والرحيل الجميل نحو الأماني",87,"ن",2,0],["كاملٌ وافرٌ ومن ثمّ رمل","وخفيف يثير في شجوني",88,"ن",2,0],["كأمطارٍ على أوتارِ قلبي","تمنَّتْ أن أكونَ لها مُضَافا",89,"ف",2,0],["كامن في النفس صورته","يزدهيها الحسن والبهج",90,"ج",1,0],["كأميرةٍ تلكَ الَّتي أحببْتُها","تمشي الهوينى في سنا الأمراءِ",91,"ا",2,1],["كامِلْ الأوصَاف في فِكري اوْذِهاني","أنتِظِر شُوفِك كما عِيد الِضّحِيّه",92,"ي",2,0],["كأمة عباد المسيح وقد غلو","فنالا بما قالوا الخسارة والوزرا",93,"ر",2,0],["كأميرةٍ ريشُ النعامة عرشُها","والحُلْمُ فيها ما رأى العظماءُ",94,"ا",2,0],["كاملَ الوصف ما أردتُ ابتعادي","عنك يوما ولا فُطرْتُ عصيّا !!",95,"ي",2,0],["كامل وربي مكملك في جمالك","غالي ومنك مرتفع سعر الالماس",96,"س",1,0],["كامل الأوصاف وأطرافه تميل","عود موزن رابين تحت الغمام",97,"م",1,0],["كأُمَّةِ خَيْرِ المُرْسَلِينَ مُحَمَّدٍ","وَخاتِمِها بِالحَقِّ وَالدِّينِ يُخْتَمُ",98,"م",1,0],["كامله سبحان ربي ذا الجلال.","ولو تزيد اسنينها تبقى بدر.",99,"ر",1,0],["كاملينٍ في عطانا بس لله الكمال","والرجل فينا غرامه لو يعين ويستعين",100,"ن",1,0],["كاميراتٌ صُنْعُ ربي لم تَفُقْها","آلةٌ مِن عِلْم ربي للعبيدِ",101,"د",1,0],["كامله بالمحاسن ،، ما حوتك العيوب","خصك الله بكل الزين ، دون الأنام",102,"م",1,0],["كامل ٍ وصفه على ما فيه من حسن ٍ ودّل","جمّله رب الخلايق ، حط به ذوق ودلال",103,"ل",1,0],["كاملٌ كالحُوْرِ صنعتهُ","قد شكََكْنا أنَّهُ بشَرُ",104,"ر",1,0],["كامله بالزين ولله الكمال","شيٍ تشوفه وشيٍ مايبين",105,"ن",1,0],["كامله بالزين والعقل الرزين","ماتحب الاّ الكريم ابن الأصول",106,"ل",1,0],["كأم موسى غدا قلبي بغيبتكم","فالكون فرعون والساعات هامان",107,"ن",1,1],["كأم موسى فؤادي بعد فقدكم","ونار هجرك في النيران تلقينا",108,"ن",2,0],["كاملة الحقل ولكنها","إذا خلت في الفرش مجنونه",109,"ن",2,0],["كأمطارِ تِشرِينَ لا نوتة","تدوزنُ تَسْكابَها الأَهْيَغا",110,"غ",2,0]]}