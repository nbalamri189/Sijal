{"poems":[[99,"البحر أسأله ويسألني","https://www.aldiwan.net/poem24909.html","أحذ الكامل"],[534,"أنا أطلب التعجيل منك وقد","https://www.aldiwan.net/poem37231.html","الكامل"],[910,"","https://poetry.dctabudhabi.ae/diwan/poem/95785","البسيط"],[923,"","https://poetry.dctabudhabi.ae/diwan/poem/205145",""],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100889","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204506","الخفيف"]],"verses":[["أنّا أطعناه مُلبّينا","من أنت من أنا من يُنبِّينا",0,"ن",2,0],["أَنَا أَطْلُبُ التَّعْجِيلَ مِنْكَ وَقَدْ","أَخْطَأتُ في قَوْلِي وفي عَمَلي",1,"ي",1,1],["أنا أُطرّي الأَنامَ طُرّاً","وأنتِ تَبغى النَوالَ عِندي",2,"ي",1,0],["أنا أطوي حُبَّه حَذِراً","غيرَ أنَّ الدمعَ يَنشره",3,"ر",2,0],["إنَّا أطعنَا وإن بنَّيتنا جَبَلاً","وليسَ فى طاعةِ المعبود من عار",4,"ر",1,0],["أنا أطعمتها لتحيا وقومي","أطعموها لتجرع الموت مرّا",5,"ر",2,0]]}