{"poems":[[88,"ملكتم علي عنان الخطب","https://www.aldiwan.net/poem68863.html","المتقارب"],[66,"لأنوار نور النور في الخلق أنوار","https://www.aldiwan.net/poem67652.html","الطويل"],[53,"أخالد لا تكذب فلست بخالد","https://www.aldiwan.net/poem61873.html","الطويل"],[53,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[46,"أظن دموعها سنن الفريد","https://www.aldiwan.net/poem30546.html","الوافر"],[46,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[111,"سقى الله سوحا منبتي من جنابها","https://www.poetsgate.com/ViewPoem.aspx?id=518",""],[92,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[115,"وللكفات في المجهول وجه","https://www.aldiwan.net/poem2366.html","الرجز"],[164,"إِذا سفك الدماء لديك حلا","https://www.aldiwan.net/poem58931.html","الوافر"],[275,"من أين للكوكب السيار أن يقفا","https://www.aldiwan.net/poem35062.html","البسيط"],[463,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[542,"إذا مت فادفني إلى أصل كرمة","https://www.aldiwan.net/poem69400.html","الطويل"],[563,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[563,"عيون العلا نحو السعيد نواظر","https://www.aldiwan.net/poem34548.html","الطويل"],[563,"دع المنكرين الجاحدين فإنهم","https://www.aldiwan.net/poem34944.html","الطويل"],[569,"لشمس مجدك في الآفاق أضواء","https://www.aldiwan.net/poem820.html",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87092","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86956","الوافر"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137620",""],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70748","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70681","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62603","الرجز"],[1019,"","https://poetry.dctabudhabi.ae/diwan/poem/123317","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202123","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132876","المنسرح"],[1459,"","https://poetry.dctabudhabi.ae/diwan/poem/138019",""],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128000","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87856","البسيط"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76832","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121003","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93520","الطويل"],[3245,"","https://poetry.dctabudhabi.ae/diwan/poem/143685","المتقارب"],[3325,"","https://poetry.dctabudhabi.ae/diwan/poem/115031","الطويل"],[3546,"","https://poetry.dctabudhabi.ae/diwan/poem/103381","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45867","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91689","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101350","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54410","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94357","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83132","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58172","الطويل"],[585,"من ذا المطل يعاني العريَ والسقما","https://www.poetsgate.com/ViewPoem.aspx?id=161923",""],[585,"بربك يا دسيسة خبرينا","https://www.poetsgate.com/ViewPoem.aspx?id=161869",""]],"verses":[["وَلِلكاشِحينَ نَكالُ الزَمانِ","وَنَحسُ النُجومِ ذَواتِ الذَنَب",0,"ب",1,0],["وَلِلكَونِ في الأَكوانِ كَونُ مُكَوِّنٍ","يُكِنُّ لَهُ قَلبي وَيُهدي وَيَختارُ",1,"ر",1,0],["ولَلكلْبُ خير منك لؤمك شاهدي","بذلك دهري ما أُباعد شاهدي",2,"د",2,0],["وللكأس أخرى أن تكون تعلَّةً","لذي الشيب عن ذكر الشباب المزايلِ",3,"ل",1,0],["وَلِلكَذَجاتِ كُنتَ لِغَيرِ بُخلٍ","عَقيمَ الوَعدِ مِنتاجَ الوَعيدِ",4,"د",1,0],["وَلِلكَذَجِ العُليا سَمَت بِكَ هِمَّةٌ","طَموحٌ يَروحُ النَصرُ فيها وَيَغتَدي",5,"د",2,0],["وللكل منه طعنة فوق نحره","ولا تنثني للبرء الا ثنى بها",6,"ب",3,0],["وللكآبةِ ألوانٌ ، وأفجعُها","أنْ تُبصرَ الفيلسوفَ الحُرَّ مكتئِبا",7,"ب",2,0],["وَللكَفّاتِ في المجهولِ وجهٌ","إذا هُوَ قَد بَدا لم يُبقِ جَهلا",8,"ل",2,1],["وللكوسات في الآذان وحي","نشبهه بصوت الرعد مثلا",9,"ل",2,0],["وللكريم افتِقارٌ من مكارِمهِ","حيث اللئيمُ غدا للمالِ مُغترفا",10,"ف",2,0],["وللكاتم الشحناء يرهبُ حدّه","إذا اهتزَّ دوني والمكاشفِ بالضَّغنِ",11,"ن",1,0],["وللكأسِ والصهباءِ حقُّ منعَّمٍ","فمن حقّها أن لا تُضاعَ حُقُوقُها",12,"ق",3,0],["وللكمال والمعا","رف العلى والتمكين",13,"ن",1,0],["وللكون معنى دق عن فهم عارف","تشير إليه الباطنات الظواهر",14,"ر",1,0],["وللكنز أرصادٌ وفيه طلاسم","يصان بها في الناس عن نيل طالب",15,"ب",1,0],["وللكرم إذا تتلى فضائلكم","في كل محفلٍ إطراق وإصغاء",16,"ا",2,0],["وَللكتب في دار الطِباعة رَونَق","بِتقليده في الخَط يَهتمُّ راقم",17,"م",1,0],["وَللكوبري عَلى النيل انتصاب","كَطود شامخ في الارتفاع",18,"ع",1,0],["وللكهرباء المقام العلي","ولكن للغاز سعرا دنا",19,"ن",2,0],["وللكريم علاماتٌ تدل على","أخلاقه إنْ تداني منك أو نزحا",20,"ح",2,0],["وللكواعبِ تَلعابٌ وأَلسِنَةٌ","يُطرِبْنَ بالسَّجْعِ رُهْبَاناً وزُهَّادا",21,"د",2,0],["وللكلام كالثمار زهوَهْ","وزهرة كجنة برَبْوهْ",22,"و",2,0],["وللكل من كأس المحبة شربة","سرى فيه سرى الماء في الغصن النضر",23,"ر",1,0],["وللكوكب الدري فيكم ولينا","معد سليل المصطفى صاحب العصر",24,"ر",1,0],["وللكَرىَ في الجفونِ داعيةٌ","وقد حَدَاها حادٍ له عَجِلُ",25,"ل",1,0],["وللكرارِ فضلٌ بعدَ هذا","على الأغيارِ طُراً لا تُبَالي",26,"ل",2,0],["وللكُفَّارِ والفُسَّاقِ يُقضَى","عَذَابُ القَبرِ من سوءِ الفِعَالِ",26,"ل",1,0],["وللكمنج مع القانون معركة","لولا مداركة المثقال مااصطلحا",27,"ح",2,0],["وَلِلكُؤوسِ الَّتي ما في قَرارَتِها","إِلّا شُعاعُ الضُحى أَو مَدمَعُ الزَهَرِ",28,"ر",1,0],["وَللكؤوسِ الَّتي عليهِ","منها عروسُ المُدامِ زُفَّت",29,"ت",1,0],["وللكِمام انشقاق عن أزاهرِها","كما بَدَت لك من خِلٍّ ضمائرُهُ",30,"ر",2,0],["وَللكل مِنا زَفرة بَرّحت بِهِ","تَعطّ حَواياه بِها وَترائبه",31,"ب",2,0],["وللكرد منك إذا زرتهم","بكيدك يوم كيوم الجمل",32,"ل",1,0],["وللكلب لما أن هداه الى القرى","نصيبُ وللنور الدليل نصيبُ",33,"ب",1,0],["وللكفِّ عن شَتمِ اللئيمِ تَكَرُّماً","أَضرّ به مِن شَتمِه حِين يُشتَمُ",34,"م",1,0],["وَلِلكَواكب تَكدير بِهِ اِنكَدَرَت","وَلِلصِبا نَفس في الجَوّ مَطرود",35,"د",1,0],["وَللكأس فيما بَيننا ثَغرُ ضاحكٍ","يقابلنا من دَهرنا بِالبَشائر",36,"ر",1,0],["وللكروم وراء القصر مثمرة","عقص الجعود وللأعشاب ترجيل",37,"ل",1,0],["وللكُماةِ على أَهوالها نَهَمٌ","نامٍ كأنَّ بها نحو الرَّدى لعصا",38,"ص",2,0],["وَللكرماءِ في الدنيا ثناءٌ","وفي الأخرى الكرامة من كَريمِ",39,"م",1,0],["وللكلامِ كلامٌ في حقيقته","فإن تردْ حَدَّه فاسمعه منتظما",40,"م",2,0],["وَلِلكاشف المَعنى الَّذي خَطَراتُهُ","صِعابٌ عَلى من رامَها تَتَعذَّرُ",41,"ر",1,0],["وللكافرينَ الجاحدينَ جهنمٌ","فيا بئسَ مثوَى الظالمينَ ومَنْ عتَوْا",42,"و",2,0],["وللكرامة جرحٌ غير مندملٍ","في النفس فهو جديدٌ كلما قدما",43,"م",2,0],["وللكلمات أنيابٌ حدادٌ","تعض وتنهش المتخاصمينا",44,"ن",2,0]]}