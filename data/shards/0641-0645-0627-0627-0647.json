{"poems":[[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[87,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[89,"وما مصر عمر الدهر إلا غنيمة","https://www.aldiwan.net/poem8245.html","الطويل"],[71,"رعى الله عيشا بالمعرة لي مضى","https://www.aldiwan.net/poem28441.html","الطويل"],[50,"ألا لا أشتهي الأمطار","https://www.aldiwan.net/poem66120.html","الهزج"],[244,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[343,"فما أهل الحياة لنا بأهل","https://www.aldiwan.net/poem68761.html","الوافر"],[382,"يسر العالم العلوي","https://www.aldiwan.net/poem59355.html","مجزوء الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122703","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38067","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77628","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27554","المتقارب"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93686","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100401","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202003","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202773","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203486","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133963","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68000","الوافر"],[3555,"","https://poetry.dctabudhabi.ae/diwan/poem/35026","الوافر"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35052","الوافر"],[4717,"كفرتُ بأمنها القومي","https://www.poetsgate.com/ViewPoem.aspx?id=199698",""]],"verses":[["فَمَا أَهوَى بِاَهزَعَ من بَعِيدٍ","لَنَا إِلاَّ التَّكَهُّم يَبتَغِينَا",0,"ن",2,0],["فما اهتدى ولا عقل","ولا درى كنه الحِيل",1,"ل",1,0],["فَمَا أَهْلُهَا إِلَّا عَبِيدٌ لِمَنْ سَطَا","وَلا رَيْعُهَا إِلَّا لِمَنْ شَاءَ مَغْنَمُ",2,"م",1,0],["فما أهيبَ الهرماسَ إنْ عجَّ مزبداً","بها وإلى قطعِ الطريقِ تعرَّضا",3,"ض",2,0],["فَما أَهواكَ في الغِبِّ","وَما أَهواكَ في الحينِ",4,"ن",1,0],["فما اهتز حلم أنت شامخ طوده","بوقت به ذو الحلم لا شك يغضب",5,"ب",1,0],["فَما أَهلُ الحَياةِ لَنا بِأَهلِ","وَلا دارُ الحَياةِ لَنا بِدارِ",6,"ر",1,1],["فما أهناه من عدلٍ","وفَى عن ذلكَ القرض",7,"ض",1,0],["فَما أُهمِلَ العُودُ إلاَّ عَصَى","وَلا أكرِمَ العَبدُ إلاَّ أبَق",8,"ق",1,0],["فَما أَهلهُ إِلّا الذّئابُ وَعَقربٌ","وَأَفعى وَحيّاتٌ وَأَضعَفُهم وزغُ",9,"غ",1,0],["فَما اِهتَدوا بِقَولِهِ المَليح","وَراحَ ما يَخطبه في الريح",10,"ح",1,0],["فما أهملوا حين ما أمهلوا","وجاء الرجوعُ ومن يندم",11,"م",1,0],["فَما أَهلَها لا وَالهوى آل عامر","وَلَكن غزلان الصَريم لَها أَهل",12,"ل",1,0],["فما اهتدى قائف فيها على اثرٍ","ولا تعسَّفها ذئبٌ وسرحان",13,"ن",1,0],["فما أهملت دنياهم لعجز","ولكن همت في دنيا النبيِّ",14,"ي",1,0],["فما أهنا الفراشة في فضاها","ترفرف بعض حينٍ ثم تقضي",15,"ض",2,0],["فما أهل العواطف خامداتٍ","كأصحاب العواطف هائجات",16,"ت",1,0],["فما أهلها إلا شموس معارف","لها الضوء زاه ظاهر النفع شامله",17,"ل",2,0],["فما أَهْنَى وأَحسنَه زماناً","ألم شُذّاذَنا بعد الشَّتاتِ",18,"ت",1,0],["فَما أَهلُ الدِيارِ لَنا بِأَهلٍ","وَما المالُ المُراحُ لَنا بِمالِ",19,"ل",1,0],["فَما أَهناك مِن صوتٍ رخيمٍ","وما أصفاه من خلٍّ ودودِ",20,"د",1,0],["فما أهديكمو إلا سبيلَ ال","رشادِ .. وما أريكمْ غيرَ ما (أرْ..)",21,"ر",1,0]]}