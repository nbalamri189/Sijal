{"poems":[[11,"لا نطرق الجارات من بعد هجعة","https://www.aldiwan.net/poem265.html",""],[47,"بجودك يدنو النائل المتباعد","https://www.aldiwan.net/poem63521.html","الطويل"],[90,"لقد طوَّحتني في البلادُ مُضاعَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19522&r=&rc=25",""],[119,"إلا أن بعد القوم عن جاهل بهم","https://www.aldiwan.net/poem41712.html","الطويل"],[469,"أما واللمى وجداً بساكنه الملا","https://www.aldiwan.net/poem3589.html","عموديه"],[505,"لنا بنفي شؤون الغير إثبات","https://www.aldiwan.net/poem38062.html","البسيط"],[567,"لانطون المدور لوح رمس","https://www.aldiwan.net/poem52683.html","الرمل"],[580,"قلبي يقول لطيف منك يطرقني","https://www.aldiwan.net/poem2997.html","البسيط"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203796","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46523","الرجز"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44833","الرمل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87332","الرجز"],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131460",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201561","الطويل"],[3564,"","https://poetry.dctabudhabi.ae/diwan/poem/127836","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119447","الرجز"],[4119,"تفي بضمانها البيض الحداد","https://www.poetsgate.com/ViewPoem.aspx?id=16114",""],[5075,"قلبي على أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=196818",""],[5409,"أرسلوها في الفضا قبا مهارا","https://www.poetsgate.com/ViewPoem.aspx?id=155278",""],[5777,"قم فَقد لاح بريق الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=157258",""],[5956,"تحزّ حربة أحزاني لفرقتكم","https://www.poetsgate.com/ViewPoem.aspx?id=193442",""],[5957,"ضوء قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=11304",""],[6093,"نقش ناطق","https://www.poetsgate.com/ViewPoem.aspx?id=200483",""]],"verses":[["لا نَطرُقُ الجاراتِ مِن بَعدِ هَجعَةٍ","مِنَ اللَيلِ إِلّا بِالهَدِيَّةِ تُحمَلُ",0,"ل",1,1],["لِأَن طالَ حِرمانُ الزَمانِ فَإِنَّهُ","سَيُسليهِ يَومٌ مِن عَطائِكَ واحِدُ",1,"د",1,0],["لأنطق إلا أمراً ومطاعا","زجرت كلاباً أم قحمت سباعا",2,"ا",1,0],["لأن طريق الصدق صعب وهين","ولكن كاس القطع مر وعلقم",3,"م",1,0],["لأنطق أفواه المهاد بشكره","وطوَّقَ أجياد النجاد وكلّلا",4,"ل",2,0],["لإنْ طغَى الدَّهرُ أو جارَتْ نَوائبُهُ","فللرِّفاعِيِّ برهانٌ وغاراتُ",5,"ت",1,0],["لانطونَ المدوَّرِ لوحُ رَمسٍ","كتبنا فوقهُ بدمِ العُيونِ",6,"ن",1,1],["لا نُطْقَ إِلا عَليهِ من مَحَبَّتِه","يُثنى ولا مَدْحَ إِلاَّ في عُلاه ثَني",7,"ن",2,0],["لأن طالت ظلالُ الشيح يوماً","أتغمرُ دوحةً أفياء شيح",8,"ح",1,0],["لأَن طَبعي كانَ يَنبو عَنهُم","سَجية وَيَشمَئز مِنهُم",9,"م",1,0],["لانطَوَى فَوقَ يَدَيهِ أَلَماً","وَتَوَلّى قَائِلاً وَا أَسَفَا",10,"ف",2,0],["لأنَّ طَنبَ آخرُ الجزاير","منَ المشارق كُن بذاكَ خَابر",11,"ر",1,0],["لأنّ طرفه يا حبيب مسهّد","ومدمعه يسقي بكل نيّه",12,"ي",2,0],["لأن طريقي طال والبصر ارتمى","بأسرع من سير الضياء وأبعد",13,"د",1,0],["لأَنطونِ الهُ العرش اعطى","علاماً أولا يُدعى حبيبا",14,"ب",2,1],["لا نطيل القول فالخطب يسير","وحياة الإنس والجن هدرْ",15,"ر",1,0],["لا نطيل القول فالقول هذر","وحياة الإنس والجن هباء",15,"ا",2,0],["لا نطيل القول أما المنتهي","فقريب وجرى ما قد جرى",15,"ر",2,0],["لانطق الله له قصوره","وقلن أقوالا له مأثوره",16,"ر",2,0],["لأنطاكية يحمي ذراها","وقد دانت لسطوتك البلاد",17,"د",1,0],["لَا نَطْلُبُ العَدْلَ مِمَّنْ بَاتَ يَظْلِمُنَا","إِنَّ المَظَالِمَ يَا مَوْلَايَ تَكْفِينَا",18,"ن",2,0],["لا نطيق العيش فيها خولاً","ولو الأيدي غدت منا قصارا",19,"ر",2,0],["لا نطقنا لا عقلنا لا ولا","قام منا قائم في محفلِ",20,"ل",1,0],["لأنِّ طُهْرَك قد صفَّى النفوس فما","شخص يظل لعيناً دون تحسينِ",21,"ن",1,0],["لان طريقي كثير الشقاء","كثير البكاء كسيل يسيل",22,"ل",1,0],["لأنْطقَ الحبُّ شعراً في دواخلِهِ","ألا ترى النَّقشَ في الأحجارِ أنطقَها",23,"ق",3,0]]}