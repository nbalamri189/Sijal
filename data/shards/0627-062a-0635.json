{"poems":[[53,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[34,"كأنك لم تغنه إذ لم تلاقها","https://www.aldiwan.net/poem4902.html","الطويل"],[9,"أتصرم ريا أم تديم وصالها","https://www.aldiwan.net/poem21968.html","الطويل"],[24,"أمن دمنة قفر تعاورها البلى","https://www.aldiwan.net/poem21859.html","الطويل"],[27,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[27,"أتصحو بل فؤادك غير صاح","https://www.aldiwan.net/poem5698.html","الوافر"],[37,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[51,"أجد بربات الحجال صدودها","https://www.aldiwan.net/poem61836.html","الطويل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[89,"كنت طاغور ماثلا في خيالي","https://www.aldiwan.net/poem44752.html","الخفيف"],[89,"الشمس قد غربت فلاح وراءها","https://www.aldiwan.net/poem44892.html","الكامل"],[45,"وجدنا خلال أبي صالح","https://www.aldiwan.net/poem63487.html","المتقارب"],[45,"شيد بفضلك مشرف البنيان","https://www.aldiwan.net/poem66837.html","الكامل"],[28,"وكانت يدا بشر يد تمطر الندى","https://www.aldiwan.net/poem5086.html","الطويل"],[28,"أتصرف عن ليلى بنا أم تزورها","https://www.aldiwan.net/poem5110.html","الطويل"],[28,"أتصرف أجمال النوى شاجنية","https://www.aldiwan.net/poem5245.html","الطويل"],[28,"ولم تك تخشى جعفر أن يصيبها","https://www.aldiwan.net/poem5248.html","الطويل"],[58,"أتصبر للبلوى عزاء وحسبة","https://www.aldiwan.net/poem30860.html","الطويل"],[44,"دمن ألم بها فقال سلام","https://www.aldiwan.net/poem30368.html","الكامل"],[105,"يا أيها الناس إن الله يأمركم","https://www.aldiwan.net/poem43081.html","البسيط"],[105,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[105,"صريع هوى أفقت وما أفاقا","https://www.aldiwan.net/poem43151.html","الوافر"],[105,"بني الملوح لا حام ولا واق","https://www.aldiwan.net/poem43577.html","البسيط"],[40,"أقول غداة استقل الجمي","https://www.aldiwan.net/poem42301.html","المتقارب"],[40,"لقد أرسلت ليلى رسولا بأن أقم","https://www.aldiwan.net/poem42342.html","الطويل"],[48,"تعاتبني على شرب اصطباح","https://www.aldiwan.net/poem62513.html","الوافر"],[46,"أتصح توبة مدرك من كونه","https://www.aldiwan.net/poem22138.html","الكامل"],[46,"للخير منزلتان عند معاشر","https://www.aldiwan.net/poem23251.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85331","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5177","الرمل"],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[109,"القافلة","https://www.poetsgate.com/ViewPoem.aspx?id=8380",""],[100,"صنعاء .. في طائرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67705&r=&rc=192",""],[116,"قل للشريف بزعمه مع انه","https://www.aldiwan.net/poem41187.html","عموديه"],[129,"بعادك يا عذب الثنايا ولا الصد","https://www.aldiwan.net/poem50635.html","الطويل"],[133,"خليلى لا لا تبديبا لى التلكيا","https://www.aldiwan.net/poem54683.html","الطويل"],[133,"سالت القطرة من كأسي التي","https://www.aldiwan.net/poem54931.html","الرمل"],[182,"ألا هل من البين المفرق من بد","https://www.aldiwan.net/poem58877.html","الطويل"],[323,"أتصرم أم تواصلك النجود","https://www.aldiwan.net/poem56354.html","الوافر"],[454,"خبرتكم فوجدت الجبن آيتكم","https://www.aldiwan.net/poem61357.html","البسيط"],[467,"ألا يا صبا نجد لقد هجت من نجد","https://www.aldiwan.net/poem50438.html","الطويل"],[480,"قرنت قلوصك ربها بزميله","https://www.aldiwan.net/poem37580.html","الكامل"],[517,"أتصبر عن سعدى وأنت صبور","https://www.aldiwan.net/poem48677.html","الطويل"]],"verses":[["أَتَصُدُّ عَن طَلَلٍ رَعَيتَ بِهِ","ما شِئتَ مِن هَيفٍ وَمِن غَيدِ",0,"د",1,0],["أَتَصبُرُ لِلبَينِ المُشِتِّ مَعَ الجَوى","أَمَ اِنتَ اِمرُؤٌ ناسي الحَياءِ فَجازِعُ",1,"ع",1,0],["أَتَصرِمُ رَيّا أَم تُديمُ وِصالَها","بَلِ الصَرمَ إِذ زَمَّت بِلَيلٍ جِمالَها",2,"ل",3,1],["أَتَصبو إِلى سَلمى وَمِن دونِ أَهلِها","مَهامِهُ يَغتالُ المَطِيَّ سُهوبُها",3,"ب",3,0],["أَتُصَدِّقونَ بِمارِ سَرجِسَ وَاِبنِهِ","وَتُكَذِّبونَ مُحَمَّدَ الفُرقانِ",4,"ن",1,0],["أَتَصحو بَل فُؤادُكَ غَيرُ صاحِ","عَشِيَّةَ هَمَّ صَحبُكَ بِالرَواحِ",5,"ح",1,1],["أتَصلُحُ دُنياناَ جميعاً ودِينُنا","على ما بِه ضَاع السَّوَامُ المُؤَبَّلُ",6,"ل",1,0],["أتصبحُ موفوراً سليماً وهذه","قُرومُ بني العباس تخطِرُ صِيدُها",7,"د",3,0],["أتصَابٍ إلى ذوي إسعادِهْ","أم تَناهٍ إلى ذوي إرْشادِهْ",8,"د",2,1],["اتصلنا ثم انفصلنا فمن لي","باتصال يبقى بغير انفصال",9,"ل",1,0],["أتصان للشعب الهضيم حقوقه","ام ليس للشعب الضعيف حقوق",10,"ق",1,0],["أَتَصطَنِعُ اليَومَ أُكرومَةً","إِلى مُثمِرٍ لَكَ مِن وُدِّهِ",11,"د",2,0],["أَتَصونُ لي شِعراً وَأُخلِقُ قَدرَهُ","في الناسِ ماأُمّي إِذاً بِحَصانِ",12,"ن",1,0],["أَتَصهِلُ عِندي بَعدَ بِشرٍ وَلَم تَذُق","ذُكورَةَ قَطّاعِ الضَريبَةِ ذي أَثرِ",13,"ر",1,0],["أَتَصرِفُ عَن لَيلى بِنا أَم تَزورُها","وَما صُرمُ لَيلى بَعدَ ما ماتَ زيرُها",14,"ر",3,1],["أَتَصرِفُ أَجمالَ النَوى شاجِنِيَّةٌ","أَمِ الحَفَرُ الأَعلى بِفَلجٍ مَصيرُها",15,"ر",3,1],["أَتَصبِرُ لِلعادي ضَغابيثُ جَعفَرٍ","وَثَورَةِ ذي الأَشبالِ حينَ يَثورُها",16,"ر",3,0],["أَتَصبِر لِلبَلوى عَزاءً وَحِسبَةً","فَتُؤجَرُ أَم تَسلو سُلوَّ البِهائِمِ",17,"م",1,1],["أَتَصَعصَعَت عَبَراتُ عَينِكَ أَن دَعَت","وَرقاءُ حينَ تَصَعصَعَ الإِظلامُ",18,"م",1,0],["أَتصِدفونَ عَنِ الآياتِ ساطِعَةً","تَجلو العَمى وَتُضيءُ القَلبَ إيمانا",19,"ن",2,0],["أَتَصدِفونَ بِأَبصارٍ وَأَفئِدَةٍ","وَتَجمَحونَ بِأَسماعٍ وَأَذهانِ",20,"ن",1,0],["أَتَصحو مِن خُمارِ الحُبِّ دوني","وَأَهذي فيكِ وَجداً وَاِشتِياقا",21,"ق",2,0],["أتَصْدِفُونَ عَنِ المُثلى وقد هَتَفَتْ","بها الدُّعاةُ فَلَبَّى كلُّ سَبَّاقِ",22,"ق",1,0],["أَتَصبِرُ لِلبَينِ أَم تَنتَحي","لِسَلمى فَذاكَ إِذَن أَروَحُ",23,"ح",1,0],["أَتَصدُرُ بِالداءِ الَّذي وَرَدَت بِهِ","فَتَهلكُ أَم تَثوي كَذا لا تُنَوَّلُ",24,"ل",1,0],["أَتَصحو أَم فُؤادُكَ غَيرُ صاحٍ","عَشِيَّةَ هَمَّ صَحبُكَ بِالرَواحِ",25,"ح",1,0],["أَتَصِحُّ تَوبَةُ مُدرِكٍ مِن كَونِهِ","أَو أَسوَدٍ مِن لَونِهِ فَيَتوبا",26,"ب",2,1],["أَتَصَدَّقَت بِالخَيطِ ثُمَّ هَوَت إِلى ال","حَمراءِ فَاِعتَصَمَت بِخَيطِ الغازِلِ",27,"ل",1,0],["اتصلح في الشرق الحكومات شأنها","لعل الغنى والعلم يجتمعنان",28,"ن",1,0],["أتصرخ ويحْكَ إنَّ السماء","لتأخذُها صرخاتُ الألَمْ",29,"م",1,0],["أَتَصَدّى لِلتَفاريقِ وَلَو","أُبتُ قَومي لَتَصَدَّت لي الجُمَل",30,"ل",1,0],["أتُصلِحُ ما الطبائعُ أفسدتَه","قوانينٌ مفسَّخةٌ هُراء",31,"ا",2,0],["أتصدق؟ ان الوقت هاذا غير.؟ وأن.؟ الناس.؟ غير؟","وأتصدق أن ماعاد باقيشي حتى؟ أتخافله؟",32,"ل",2,0],["أتصغين ..؟ لا صوت غير الضجيج","وغير اختلاج الكؤوس المطيفه",33,"ف",2,0],["اتصح نسبتك التي قد اوضحت","ما فيك مطوي من الاوشاج",34,"ج",1,0],["أتُصفِى الهوى يا قلبُ من لا يودُّني","فما يستحقُّ الودَّ من لا له ودُ",35,"د",1,0],["أتصبُو وَقَد لاَحَت بِفَودِكَ شَيبَةٌ","وَطِرفُ التَّصابي والصَّبَابَةِ عُرِّيَا",36,"ي",2,0],["أتصبّاها لتحلو مثلما","يتصبى مرّة الرأى حميم",37,"م",1,0],["أَتَصرِمُ لِلاّئى الّذينَ هُمُ العِدَى","وَتُشمِتُهُم بى اُمُّ عَمرِو عَلَى وُدِّى",38,"د",2,0],["أَتَصرِمُ أَم تُواصِلُكَ النَجودُ","وَلَيسَ لَها وَإِن وَصَلَتكَ جودُ",39,"د",1,1],["أتصغرون الألى ضحوا لمبدئكم","وتكبرون اثيما كان مأجورا",40,"ر",2,0],["أَتَصرُمُني عِندَ الَّذينَ هُمُ العِدا","لِتُشمِتَهُم بي أَم تَدومُ عَلى الوِدِ",41,"د",1,0],["أتصده عني السجون وإنه","في القلب مثل النور في قنديله",42,"ل",2,0],["أتصبِر عَن سعدى وَأَنتَ صَبور","وَأَنتَ بِحُسن الصَبرِ مِنكَ جَدير",43,"ر",1,1]]}