عنود","https://www.poetsgate.com/ViewPoem.aspx?id=130505",""],[6102,"منفى \"المتنبي\" الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=182749",""],[6102,"الوطن المنفى","https://www.poetsgate.com/ViewPoem.aspx?id=182760",""],[6102,"بَراءَةُ الذِّئب !!","https://www.poetsgate.com/ViewPoem.aspx?id=183166",""],[5309,"أتصوغ اشعارا وجل الناس","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573836",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[6323,"يا ساكن الأعماق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82169&r=&rc=0",""],[5126,"روض وشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87814&r=&rc=29",""],[2944,"الفلّاح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86012&r=&rc=5",""],[6355,"أتصدقين؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66629&r=&rc=89",""]],"verses":[["أَتَصُدُّ عَن طَلَلٍ رَعَيتَ بِهِ","ما شِئتَ مِن هَيفٍ وَمِن غَيدِ",0,"د",1,0],["أَتَصبُرُ لِلبَينِ المُشِتِّ مَعَ الجَوى","أَمَ اِنتَ اِمرُؤٌ ناسي الحَياءِ فَجازِعُ",1,"ع",1,0],["أَتَصرِمُ رَيّا أَم تُديمُ وِصالَها","بَلِ الصَرمَ إِذ زَمَّت بِلَيلٍ جِمالَها",2,"ل",3,1],["أَتَصبو إِلى سَلمى وَمِن دونِ أَهلِها","مَهامِهُ يَغتالُ المَطِيَّ سُهوبُها",3,"ب",3,0],["أَتُصَدِّقونَ بِمارِ سَرجِسَ وَاِبنِهِ","وَتُكَذِّبونَ مُحَمَّدَ الفُرقانِ",4,"ن",1,0],["أَتَصحو بَل فُؤادُكَ غَيرُ صاحِ","عَشِيَّةَ هَمَّ صَحبُكَ بِالرَواحِ",5,"ح",1,1],["أتَصلُحُ دُنياناَ جميعاً ودِينُنا","على ما بِه ضَاع السَّوَامُ المُؤَبَّلُ",6,"ل",1,0],["أتصبحُ موفوراً سليماً وهذه","قُرومُ بني العباس تخطِرُ صِيدُها",7,"د",3,0],["أتصَابٍ إلى ذوي إسعادِهْ","أم تَناهٍ إلى ذوي إرْشادِهْ",8,"د",2,1],["اتصلنا ثم انفصلنا فمن لي","باتصال يبقى بغير انفصال",9,"ل",1,0],["أتصان للشعب الهضيم حقوقه","ام ليس للشعب الضعيف حقوق",10,"ق",1,0],["أَتَصطَنِعُ اليَومَ أُكرومَةً","إِلى مُثمِرٍ لَكَ مِن وُدِّهِ",11,"د",2,0],["أَتَصونُ لي شِعراً وَأُخلِقُ قَدرَهُ","في الناسِ ماأُمّي إِذاً بِحَصانِ",12,"ن",1,0],["أَتَصهِلُ عِندي بَعدَ بِشرٍ وَلَم تَذُق","ذُكورَةَ قَطّاعِ الضَريبَةِ ذي أَثرِ",13,"ر",1,0],["أَتَصرِفُ عَن لَيلى بِنا أَم تَزورُها","وَما صُرمُ لَيلى بَعدَ ما ماتَ زيرُها",14,"ر",3,1],["أَتَصرِفُ أَجمالَ النَوى شاجِنِيَّةٌ","أَمِ الحَفَرُ الأَعلى بِفَلجٍ مَصيرُها",15,"ر",3,1],["أَتَصبِرُ لِلعادي ضَغابيثُ جَعفَرٍ","وَثَورَةِ ذي الأَشبالِ حينَ يَثورُها",16,"ر",3,0],["أَتَصبِر لِلبَلوى عَزاءً وَحِسبَةً","فَتُؤجَرُ أَم تَسلو سُلوَّ البِهائِمِ",17,"م",1,1],["أَتَصَعصَعَت عَبَراتُ عَينِكَ أَن دَعَت","وَرقاءُ حينَ تَصَعصَعَ الإِظلامُ",18,"م",1,0],["أَتصِدفونَ عَنِ الآياتِ ساطِعَةً","تَجلو العَمى وَتُضيءُ القَلبَ إيمانا",19,"ن",2,0],["أَتَصدِفونَ بِأَبصارٍ وَأَفئِدَةٍ","وَتَجمَحونَ بِأَسماعٍ وَأَذهانِ",20,"ن",1,0],["أَتَصحو مِن خُمارِ الحُبِّ دوني","وَأَهذي فيكِ وَجداً وَاِشتِياقا",21,"ق",2,0],["أتَصْدِفُونَ عَنِ المُثلى وقد هَتَفَتْ","بها الدُّعاةُ فَلَبَّى كلُّ سَبَّاقِ",22,"ق",1,0],["أَتَصبِرُ لِلبَينِ أَم تَنتَحي","لِسَلمى فَذاكَ إِذَن أَروَحُ",23,"ح",1,0],["أَتَصدُرُ بِالداءِ الَّذي وَرَدَت بِهِ","فَتَهلكُ أَم تَثوي كَذا لا تُنَوَّلُ",24,"ل",1,0],["أَتَصحو أَم فُؤادُكَ غَيرُ صاحٍ","عَشِيَّةَ هَمَّ صَحبُكَ بِالرَواحِ",25,"ح",1,0],["أَتَصِحُّ تَوبَةُ مُدرِكٍ مِن كَونِهِ","أَو أَسوَدٍ مِن لَونِهِ فَيَتوبا",26,"ب",2,1],["أَتَصَدَّقَت بِالخَيطِ ثُمَّ هَوَت إِلى ال","حَمراءِ فَاِعتَصَمَت بِخَيطِ الغازِلِ",27,"ل",1,0],["اتصلح في الشرق الحكومات شأنها","لعل الغنى والعلم يجتمعنان",28,"ن",1,0],["أتصرخ ويحْكَ إنَّ السماء","لتأخذُها صرخاتُ الألَمْ",29,"م",1,0],["أَتَصَدّى لِلتَفاريقِ وَلَو","أُبتُ قَومي لَتَصَدَّت لي الجُمَل",30,"ل",1,0],["أتُصلِحُ ما الطبائعُ أفسدتَه","قوانينٌ مفسَّخةٌ هُراء",31,"ا",2,0],["أتصدق؟ ان الوقت هاذا غير.؟ وأن.؟ الناس.؟ غير؟","وأتصدق أن ماعاد باقيشي حتى؟ أتخافله؟",32,"ل",2,0],["أتصغين ..؟ لا صوت غير الضجيج","وغير اختلاج الكؤوس المطيفه",33,"ف",2,0],["اتصح نسبتك التي قد اوضحت","ما فيك مطوي من الاوشاج",34,"ج",1,0],["أتُصفِى الهوى يا قلبُ من لا يودُّني","فما يستحقُّ الودَّ من لا له ودُ",35,"د",1,0],["أتصبُو وَقَد لاَحَت بِفَودِكَ شَيبَةٌ","وَطِرفُ التَّصابي والصَّبَابَةِ عُرِّيَا",36,"ي",2,0],["أتصبّاها لتحلو مثلما","يتصبى مرّة الرأى حميم",37,"م",1,0],["أَتَصرِمُ لِلاّئى الّذينَ هُمُ العِدَى","وَتُشمِتُهُم بى اُمُّ عَمرِو عَلَى وُدِّى",38,"د",2,0],["أَتَصرِمُ أَم تُواصِلُكَ النَجودُ","وَلَيسَ لَها وَإِن وَصَلَتكَ جودُ",39,"د",1,1],["أتصغرون الألى ضحوا لمبدئكم","وتكبرون اثيما كان مأجورا",40,"ر",2,0],["أَتَصرُمُني عِندَ الَّذينَ هُمُ العِدا","لِتُشمِتَهُم بي أَم تَدومُ عَلى الوِدِ",41,"د",1,0],["أتصده عني السجون وإنه","في القلب مثل النور في قنديله",42,"ل",2,0],["أتصبِر عَن سعدى وَأَنتَ صَبور","وَأَنتَ بِحُسن الصَبرِ مِنكَ جَدير",43,"ر",1,1],["اتصال فوحدة فهي حي","ذو شعور ففرقة فانفصال",44,"ل",1,0],["أتُصَرِّفانِ عَنِ اللِّوى وَطُلُولُهُ","نَظَريكُما هَذا اللوَى وَطُلُولُه",45,"ل",2,0],["أتصدر وراداً لكم عن كيها","محلأة والقوم منهن تنزف",46,"ف",1,0],["أَتصبِر عنّي واصطبارُكَ راحلٌ","وتستُر منّي ما ثوى منكَ بالصّدْر",47,"ر",1,0],["أتصنع ما لا يملك المرء صنعَه","ويمنحها ربع الجزاء أو الثمنا",48,"ن",2,0],["أتَصْبِرُ عنّي ولا أصْبِرُ","وتهجرُني حينَ لا أهْجُرُ",49,"ر",1,1],["أَتصابى وقد أمضَّنَي الشو","قُ ليخفَى ما بي من الامضاض",50,"ض",1,0],["أَتَصابى بِها وَإِنْ كُنتُ شَيخاً","وَحَميدٌ مِن الشّيوخِ التّصابي",51,"ب",2,0],["أتصمتُ لا عِشتَ فالحاصِدون","يَرَونَ بكَ الكفَّ والمِنجَلا",52,"ل",2,0],["أتصبر مستزيداً بعد صبر","وليس وراء صبرك من مزيد",53,"د",1,0],["أَتُصدِّق الواشي الكذوبَ وطالما","كذَّبْتَ صَادقَ مَنْ وشَى حتى خَذا",54,"ذ",2,0],["أتصبر والمتيم غير صابر","وتهجر والمتيم غير هاجر",55,"ر",1,1],["اتصلت من بعد ما فصلتا","ونَبَتَتْ من بعد ما استأصلتا",56,"ت",2,0],["أَتَصبِرُ يا قَلبُ أَم تَجزَع","فَإِنَّ الدِيارَ غَداً بَلقَعُ",57,"ع",1,1],["أتصفرُّ من رعبٍ ولم تنض بيضكم","فيحمرَّ من سُود المنايا إهابُها",58,"ب",3,0],["أَتَصبِر إِن هَجَرنا أَو بَعُدنا","فَقُلتُ نَعَم نَعَم وَالقَلبُ لا لا",59,"ل",2,0],["أَتَصبِرُ إِن أَتَتكَ بِحارُ خَيلٍ","وَقِدماً ما صَبَرتَ عَلى السَواقي",60,"ق",2,0],["أَتصحين بغاث الطير وَهي على","دود المزابل زهداً بالشواهين",61,"ن",1,0],["اتصالك وَيْن وارسالك","وَيْن دارك شاقني فَنَّك",62,"ك",1,0],["أتصد عنها من إذا لاحت له","كأس الثريا ظنها عنقودا",63,"د",2,0],["أَتصرِمُ لَهواً أَم تُجِدُّ لَها وَصلا","وَما صَرَمَت لَهوٌ لِذي خُلَّةٍ حَبلا",64,"ل",2,1],["أتصرع شيبة في يوم بدر","وتردفه بعتبة والوليد",65,"د",1,0],["أتصرع في الحروب أسود غاب","عليهم كل ضيقة الزرود",65,"د",1,0],["أتصرع في الوغى في يوم أحد","كماة العبدرين ذوي البنود",65,"د",1,0],["أتصرع في الوغى عمرو بسيف","صقيل مضارب ماضي الحدود",65,"د",1,0],["أتصرع في الوغى ابن ود","علج لغير اللَه يعلن بالسجود",65,"د",1,0],["أتصرع في الوغى ابن ود","ولم تسلبه ضافية البرود",65,"د",1,0],["أتصرع في الوغى عمرو ابن ود","وتأسر قومه أسر العبيد",65,"د",1,0],["أتصرع في الوغى عمرو ابن ود","وتقتل كل شيطان مريد",65,"د",1,0],["أتصرع في الوغى عمرو ابن ود","وتقتل مرحباً زجل الرعود",65,"د",1,0],["أتصرع في الوغى عمرو ابن ود","وتقتل مرحباً بطل الجنود",65,"د",1,0],["أتصرع في الوغى عمرو ابن ود","وتقتل مرحباً بطل اليهود",65,"د",1,0],["أتصرع في الوغى عمرو ابن ود","وتقتل مرحباً بطل الأسود",65,"د",1,0],["أتصرع في الوغى عمرو ابن ود","وتقتل مرحباً بادي الحقود",65,"د",1,0],["أتصرع في الوغى عمرو ابن ود","وتقتل كل جبار عنيد",65,"د",1,0],["أتصرع في الوغى عمرو ابن ود","وتتركه لقاً فوق الصعيد",65,"د",1,0],["أتصرع في الوغرى عمرو ابن ود","وتقلع باب ذا لحصن الشديد",65,"د",1,0],["أتصرع في الوغى عمرو وتنجو","بكشف خ ما بين الجنود",65,"د",1,0],["أتصرع في الوغى كَقريشَ أُسداً","هم فيها ذووا بأس شديد",65,"د",1,0],["أتصرع في مهندك الأعادي","ولم يرهبك أكثار العديد",65,"د",1,0],["أتصرع كل من يدعو شريكاً","ويوم الطعن عندك يوم عيد",65,"د",1,0],["أَتَصُدُّني أَم لِلغَرامِ تَرُدُّني","وَتَلومُني في الحُبِّ أَم تُغريني",66,"ن",2,0],["أتصفح الأجفان منك صفائحاً","صقلت لها أيدي القيون صفاحا",67,"ح",2,0],["أتصبح هاتيك الحقائق أوهاما","وتحكمنا صهيونُ عربا واسلاما",68,"م",2,1],["اتصبح ارض القدس دار خلاعة","وتبدل من طهر العبادة آثاما",68,"م",2,0],["أتصبرون وهذا بدء بطشهم","وأول الغيث قطر ثم ينهمر",69,"ر",1,0],["أتصبح قدّيساً لتفسق بالندى","وتهبط بالأخلاق عن شرف القلب",70,"ب",1,0],["أتصغى الى الزور من قولهم","وما هو منهم بقول مبين",71,"ن",1,0],["أَتصبر غدوا أَم لِعَينَيكَ سافِحُ","كَما شَلشَل الماءَ الشّنانُ النَّواضِحُ",72,"ح",1,1],["أتصد والأعدا أحاطت بي وما","عودتني من قبل ذاك صدودا",73,"د",2,0],["اتصحّ لي الدعوى بأني خادمٌ","علماً ولا أرثي الأديب العالما",74,"م",2,0],["أتصبو بعدما انصرم الشباب","وتغريك النواهد والكعاب",75,"ب",1,1],["أتصح دعوى حب أحمد مع قلى","أولاده أم هل لها من قابل",76,"ل",1,0],["أتصبح الأعبد الخزم المخطمة ال","لأنوف حاكمة في السادة العرب",77,"ب",1,0],["أتصبر صبرَ الأكرمينَ على البَلى","فتؤجرَ في ذا الصبر أم أنت جازعُ",78,"ع",1,0],["أتصهره الشمس وهو ابن من","بمرأى من الناس كم رد يوحا",79,"ح",2,0],["أتصبو لذكرى عافيات المنازل","وتسلو عفيرَ الخدّ فوقَ الجنادل",80,"ل",1,1],["اتْصير سيفي لا قْدحت بيض السيوف","وحبر قْلمي على الفخر مبري بري",81,"ر",2,0],["أتصبّر ولكن الصبر ما يفيد","والهقاوي تساقط دون رأسٍ رفيع",82,"ع",1,0],["إتصدق إني عارفك قبل لا ألقاك","يعني لو أشوفك بشارع عرفتك",83,"ك",1,1],["أتصدّقون هراءهم ونفاقهم؟","كذبوا وأيمُ الله والسُّوَرات",84,"ت",1,0],["اتصدق اني كتبت بدون يديني","واني قريت لسواد الهم مراسيله",85,"ل",2,0],["أتَصَنَّعُ الفرحَ الصغيرَ ومهجتي","في كلِّ شوقٍ قُطّعَتْ أفلاذا",86,"ذ",2,0],["أَ تَصُدُّ مِنْ بَعْدِ الْوِصَالِ ، وَتَرْتَدِيْ","لَيْلَ التَّغَافِلِ ، نَاكِصًا ، مُتَكَبِّرَا",87,"ر",2,0],["أ تصدقينَ بأنّ بَعْضَ سِنيني","ضمأٌ إلى كأسٍ مِنْ اللّيْمونِ؟!",88,"ن",1,1],["أ تُصدّقينَ بأنّ أَكْبرَ ثرْوتي","بَيتٌ أعودُ إليهِ بيْنَ جفوني؟!",88,"ن",2,0],["أتصامم والذكر فيكم","للمسامع قد قرع",89,"ع",1,0],["اتصير ظلي وأنا بعد معك كني","كني غيومن تغطي ۆجّهگْ البادي",90,"د",2,0],["أَتَصِيرُ اللُّحُونُ فِي القَوْلِ نَبْضاً","دُونَ حُبٍّ يُرَاقِصُ الأَنْسَامَا",91,"م",2,0],["أتصفوني في حكمكم، إنما","الإنصاف نصف الدين القويم الطهور",92,"ر",1,0],["اتصاغر كلمتي لن قلت ذوق","يا(نصيب) العمر مرة يمنحه",93,"ح",2,0],["أتصبر موتورا مدى الدهر والألى","بحد الظبى في ساعة قتلوا صبرا",94,"ر",2,0],["أتصيّد خاطر(ن) عند السحر","او وميض الفكر في جنح الظلام",95,"م",1,0],["اتصافحك عيني وأنا كفي أعمى","مَالي جدى إلا مصافح الموق للموق",96,"ق",1,0],["أتصدقين بأنني في لحظةٍ","عنْ كلِّ هذا الحبِّ انْ أتحوّلا",97,"ل",2,1],["اتصبو في غرامك ياغريبُ","وليل الشعر يهتكه ال