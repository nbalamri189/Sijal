{"poems":[[53,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[53,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[77,"أجلك أن يلم بك العتاب","https://www.aldiwan.net/poem36763.html","الوافر"],[86,"رجعت لنفسي فاتهمت حصاتي","https://www.aldiwan.net/poem10924.html","الطويل"],[71,"أرى يحيى تعرض لي بسوء","https://www.aldiwan.net/poem3760.html","الوافر"],[93,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[93,"سلام عليكم والفواد المسلم","https://www.aldiwan.net/poem11363.html","الطويل"],[51,"أبدر السماء وغيث السماء","https://www.aldiwan.net/poem66000.html","المتقارب"],[89,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[89,"ذهب الشباب وانت بعد ذهابه","https://www.aldiwan.net/poem44726.html","الكامل"],[89,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"حياة ما نريد لها زيالا","https://www.aldiwan.net/poem62956.html","الوافر"],[85,"يا ناشر العلم بهذي البلاد","https://www.aldiwan.net/poem63771.html","السريع"],[45,"مهرج صبوحك سعده لم ينحس","https://www.aldiwan.net/poem64611.html","الكامل"],[28,"وقد مد حولي من المالكين","https://www.aldiwan.net/poem5044.html","المتقارب"],[105,"شجن بقلبك يطمئن ويفزع","https://www.aldiwan.net/poem43093.html","الكامل"],[105,"هل الحرب إلا أن تطير الجماجم","https://www.aldiwan.net/poem43156.html","الطويل"],[105,"كيف القرار ونار الحرب تستعر","https://www.aldiwan.net/poem43164.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85649","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9991","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54723","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141954","الكامل"],[45,"مَهْرِجْ صَبُوحَك سَعْدُه ُلم يُنْحَسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31143",""]],"verses":[["أَيُّ طَودٍ دُكَّ مِن أَيِّ جِبالِ","لَقَحَت أَرضٌ بِهِ بَعدَ حِيالِ",0,"ل",1,1],["أَيَطلُعُ لي عَزمٌ إِلى ما أُريدُهُ","وَصاحِبُ سِرّي في الرِجالِ مُذيعُ",1,"ع",1,0],["أَيُطنِبُ فِي مَعَانِيهَا الْمَعَالِي","بِرَبْعِكُمُ وَيُخْتَصَرُ الْكِتَابُ",2,"ب",1,0],["أَيُطرِبُكُم مِن جانِبِ الغَربِ ناعِبٌ","يُنادي بِوَأدي في رَبيعِ حَياتي",3,"ي",1,0],["أَيَطمَعُ أَنَّني أَهجوهُ كَلّا","كَفاني أَن يُقالَ أَخو رُقَيَّه",4,"ه",1,0],["أَيْ طَيْفَ عُثْمَانَ لَمْ يَبْرَحْ بِهَيْبَتِهِ","حَيّاً عَلَى أَنَّهُ بِالذِّكْرِ مُرْتَسِمُ",5,"م",1,0],["أَيُطْرِبُكُمْ نَظْمُ الْخَيَالِ وَهَلْ لَهُ","قِوَامٌ بِهِ عِنْدَ الْفِعَالِ يُقَوَّمُ",6,"م",1,0],["أيطلبني سيدٌ لا أزا","ل أبغي بجهدي إليه سبيلا",7,"ل",2,0],["أي طرف عليك لم يك يا","سعد بمصر وغيرها والباك",8,"ك",1,0],["أيطيب عيش الروح بعد عيائه","ويطيب عيش الجسم بعد خرابه",9,"ه",1,0],["أي طب في حفيرك","يشفى شللك",10,"ك",1,0],["أَيطلُبون الأَمرَ وَالأَمرُ لَهُم","قَد قَرَّ في بَيت النَبيِّ وَرَسا",11,"ا",1,0],["أَيُطلَبُ حَقَّهُم بِالروحِ قَومٌ","فَتَسمَعُ قائِلاً رَكِبوا الضَلالا",12,"ل",2,0],["أَيَطلُبُ المَجدَ وَيَبغي العُلا","قَومٌ لِسوقِ العِلمِ فيهِم كَساد",13,"د",1,0],["أَيَطيبُ مِنكَ تَكاسُلٌ عَن فِتيَةٍ","قَد عاقَروا الصَهباءَ جِنحَ الحِندِسِ",14,"س",1,0],["أَيَطلُبُ مَجدَ بَني دارِمٍ","عَطِيَّةُ كَالجُعَلِ الأَسوَدِ",15,"د",1,0],["أَيُطيقُ عِبءَ النَومِ جَفنٌ مُتعَبٌ","وَيُطيعُ حُكمَ الصَبرِ قَلبٌ موجَعُ",16,"ع",1,0],["أَيَطلُبُ مُلكاً أَم يُريدُ خِلافَةً","تُقامُ لَها في المشعَرَينِ المَواسِمُ",17,"م",1,0],["أَيَطرَبُ البَيتُ أَم تَبكي جَوانِبُهُ","حُزناً وَيُعوِلُ فيهِ الرُكنُ وَالحَجَرُ",18,"ر",1,0],["أَيطعن مصراً في صميم فؤادها","أناس إلى مصر يمتّون بالقربى",19,"ب",2,0],["أَيَطلُبُ عَبلَةً مِنّي رِجالٌ","أَقَلُّ الناسِ عِلماً بِاليَقينِ",20,"ن",1,0],["أَيَطْعُنُ فِي شَيْنٍ فَإنَّكَ وَاجِدٌ","دَماً وَصَرِيعاً وَالسِّنَانَ المُسَدَّدَا",21,"د",2,0],["أيطوف الساقي هنا بكؤوسه","ويزمجر الجابي هناك ويرزم",22,"م",1,0],["أَيَطيبُ مِنك تكَاسُلٌ عَن فِتْيةٍ","قَد عاقُرواالصَّهْبَاءَ جِنحَ الجِنْدِسِ",23,"س",1,0]]}