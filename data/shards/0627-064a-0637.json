"الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205917","المتدارك"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131257",""],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95354","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95331","الرجز"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142948","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111460","الطويل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101386","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97075","الطويل"],[4171,"","https://poetry.dctabudhabi.ae/diwan/poem/203803","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73153","الوافر"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73101","الوافر"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73326","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73135","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83132","الطويل"],[4449,"","https://poetry.dctabudhabi.ae/diwan/poem/143719","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66219","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58155","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33319","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33380","الخفيف"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89597","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139512",""],[4699,"ويبقى الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=193392",""],[4727,"أتقضي كل عمرك في العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=208829",""],[4830,"لُغةُ العشق","https://www.poetsgate.com/ViewPoem.aspx?id=214827",""],[4980,"نَبضُ قَلبِي","https://www.poetsgate.com/ViewPoem.aspx?id=197049",""],[5121,"فرفوري","https://www.poetsgate.com/ViewPoem.aspx?id=37467",""],[5121,"عُصْفُورُ الْجَنَّة","https://www.poetsgate.com/ViewPoem.aspx?id=49543",""],[5388,"لتكن","https://www.poetsgate.com/ViewPoem.aspx?id=206918",""],[5401,"سوار الليل","https://www.poetsgate.com/ViewPoem.aspx?id=142367",""],[5431,"تونس الحب...","https://www.poetsgate.com/ViewPoem.aspx?id=198948",""],[5528,"عذرا رسول الله ! - صلى الله عليه وسلم -","https://www.poetsgate.com/ViewPoem.aspx?id=201136",""],[5545,"ثغر الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=191688",""],[5690,"أما ينقضي هذا التدلل والصدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=172154",""],[5804,"الوردة والنار","https://www.poetsgate.com/ViewPoem.aspx?id=191787",""],[5997,"بيّاع الأضاحي","https://www.poetsgate.com/ViewPoem.aspx?id=215045",""],[6068,"في نصر أحمد -08-","https://www.poetsgate.com/ViewPoem.aspx?id=175895",""],[6097,"طيفٌ غابرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=191557",""],[6102,"حَبو","https://www.poetsgate.com/ViewPoem.aspx?id=182762",""],[6102,"ذَبح !!","https://www.poetsgate.com/ViewPoem.aspx?id=183996",""],[6149,"سبحان من صاغه وكون","https://www.poetsgate.com/ViewPoem.aspx?id=169628",""],[6152,"أنتِ طبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=203093",""],[5309,"أيطلب رب السيف من صاحب القلم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573945",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""]],"verses":[["أَيُّ طَودٍ دُكَّ مِن أَيِّ جِبالِ","لَقَحَت أَرضٌ بِهِ بَعدَ حِيالِ",0,"ل",1,1],["أَيَطلُعُ لي عَزمٌ إِلى ما أُريدُهُ","وَصاحِبُ سِرّي في الرِجالِ مُذيعُ",1,"ع",1,0],["أَيُطنِبُ فِي مَعَانِيهَا الْمَعَالِي","بِرَبْعِكُمُ وَيُخْتَصَرُ الْكِتَابُ",2,"ب",1,0],["أَيُطرِبُكُم مِن جانِبِ الغَربِ ناعِبٌ","يُنادي بِوَأدي في رَبيعِ حَياتي",3,"ت",2,0],["أَيَطمَعُ أَنَّني أَهجوهُ كَلّا","كَفاني أَن يُقالَ أَخو رُقَيَّه",4,"ه",1,0],["أَيْ طَيْفَ عُثْمَانَ لَمْ يَبْرَحْ بِهَيْبَتِهِ","حَيّاً عَلَى أَنَّهُ بِالذِّكْرِ مُرْتَسِمُ",5,"م",1,0],["أَيُطْرِبُكُمْ نَظْمُ الْخَيَالِ وَهَلْ لَهُ","قِوَامٌ بِهِ عِنْدَ الْفِعَالِ يُقَوَّمُ",6,"م",1,0],["أيطلبني سيدٌ لا أزا","ل أبغي بجهدي إليه سبيلا",7,"ل",2,0],["أي طرف عليك لم يك يا","سعد بمصر وغيرها والباك",8,"ك",1,0],["أيطيب عيش الروح بعد عيائه","ويطيب عيش الجسم بعد خرابه",9,"ه",1,0],["أي طب في حفيرك","يشفى شللك",10,"ك",1,0],["أَيطلُبون الأَمرَ وَالأَمرُ لَهُم","قَد قَرَّ في بَيت النَبيِّ وَرَسا",11,"ا",1,0],["أَيُطلَبُ حَقَّهُم بِالروحِ قَومٌ","فَتَسمَعُ قائِلاً رَكِبوا الضَلالا",12,"ل",2,0],["أَيَطلُبُ المَجدَ وَيَبغي العُلا","قَومٌ لِسوقِ العِلمِ فيهِم كَساد",13,"د",1,0],["أَيَطيبُ مِنكَ تَكاسُلٌ عَن فِتيَةٍ","قَد عاقَروا الصَهباءَ جِنحَ الحِندِسِ",14,"س",1,0],["أَيَطلُبُ مَجدَ بَني دارِمٍ","عَطِيَّةُ كَالجُعَلِ الأَسوَدِ",15,"د",1,0],["أَيُطيقُ عِبءَ النَومِ جَفنٌ مُتعَبٌ","وَيُطيعُ حُكمَ الصَبرِ قَلبٌ موجَعُ",16,"ع",1,0],["أَيَطلُبُ مُلكاً أَم يُريدُ خِلافَةً","تُقامُ لَها في المشعَرَينِ المَواسِمُ",17,"م",1,0],["أَيَطرَبُ البَيتُ أَم تَبكي جَوانِبُهُ","حُزناً وَيُعوِلُ فيهِ الرُكنُ وَالحَجَرُ",18,"ر",1,0],["أَيطعن مصراً في صميم فؤادها","أناس إلى مصر يمتّون بالقربى",19,"ب",2,0],["أَيَطلُبُ عَبلَةً مِنّي رِجالٌ","أَقَلُّ الناسِ عِلماً بِاليَقينِ",20,"ن",1,0],["أَيَطْعُنُ فِي شَيْنٍ فَإنَّكَ وَاجِدٌ","دَماً وَصَرِيعاً وَالسِّنَانَ المُسَدَّدَا",21,"د",2,0],["أيطوف الساقي هنا بكؤوسه","ويزمجر الجابي هناك ويرزم",22,"م",1,0],["أَيَطيبُ مِنك تكَاسُلٌ عَن فِتْيةٍ","قَد عاقُرواالصَّهْبَاءَ جِنحَ الجِنْدِسِ",23,"س",1,0],["أيطمع الشعر بالإحسان يغمره","والشعر يغمر الدّنيا الله إحسانا",24,"ن",2,0],["أيطيع داعي البشر أم داعي الأسى","قلبي ويحلو الصفو أم يتمزق",25,"ق",1,0],["أَيُّ طَرفٍ سَما إِلَيكُم بِكَيدٍ","لَم تَرُدّوهُ وَهوَ مِنكُم كَليلُ",26,"ل",1,0],["أيطمَع أنْ يكونَ غلامَ وَجْهي","وليسَ لكاذبِ الأطماعِ وَجْهُ",27,"ه",1,0],["أَيُّ طِرسٍ كَأَنَّهُ رَوضُ حَزنٍ","جَادَتِ السُّحبُ بِالعَشِيِّ رُبَاهُ",28,"ا",2,0],["أَيَطْلُبُ كَيْدِي مَنْ يَهُونُ كِيَادُهُ","فَيُوقِدُ نَاراً مِثْلَ نارِ الحُباحِبِ",29,"ب",1,1],["أيطرق عين همتنا سهاد","وهمّتنا تجلُّ عن البيان",30,"ن",1,0],["أَيَّ طَيفٍ أَرى خِلالَ شُكوكي","لَم يَذُب بَعدُ في لَهيبِ غنايا",31,"ا",3,0],["أَيَطمَعُ أَن يُساجِلَكَ السَحابُ","وَهَل في الفَرقِ بَينَكُما اِرتِيابُ",32,"ب",1,1],["أَيَطمَعُ في إِدراكِ شَأويَ مُفحَمٌ","وَأَينَ الدَنّيُ النِكسُ وَالفاضِلُ النَدبُ",33,"ب",1,0],["أَيطمَعُ في صَبري العذولُ وإنَّ مَن","يصاحب قلباً في الهوى يَعرف الصَبرا",34,"ر",2,0],["أَيطربُنا من القدَّاس لحنٌ","يُردِّدُهُ لنا صوتٌ رخيم",35,"م",1,0],["أَيُّ طَبٍّ لِداءِ دارٍ حِماها","وِردُهُ يورِدُ الحِمامَ الطَبيبا",36,"ب",2,1],["أَيَطيب أَصلاً وَهوَ أَقبَح مِن قَذىً","لا أَصَل يُدعى للدعيّ فيأرسا",37,"س",2,0],["أيُطاقُ معْ قٌرْبِ الجِوا","ر كذا الجَفاءُ على اتِّصال",38,"ل",1,0],["أيُطيقُ كتمانَ الصَّبابةِ من له","في كلِّ جارِحةٍ لِسانٌ يَنطِقُ",39,"ق",1,0],["أَيَطيبُ ليْ زَمني ولم أُجْرِي بهِ","في حَلْبةِ العِلم الشّريفِ جوادي",40,"د",2,0],["أيطرق الطيف فتى","منامه قد غصبا",41,"ب",2,0],["أَيطَّلِبُ المُلكَ مَن لَيسَ مِنهُ","وَلا من بنيه وَلا صِنفِهِ",42,"ف",2,0],["أَيُطلَبُ إلاَّ من مفاخرك العُلى","ويسأل إلاَّ من أَنامِلكَ النَّدى",43,"د",2,0],["أيّ طودٍ هوى من الأطواد","أيّ هدي ولّى وأيّ رشاد",44,"د",1,1],["أيطمع أقوام بنعمة عيشة","متى عطشوا فالموت دونهم وردُ",45,"د",1,0],["إيطاليا قيل قالت","إفريقيا من حقوقي",46,"ق",2,1],["إيطاليا قد تصدت","لحربنا بارتعاش",47,"ش",1,1],["أَيطلعُ فَجْر سُعُودِي وَلاَ","أَفِرُّ إِليه من الغَيْهَبِ",48,"ب",1,0],["أيُطلَبُ لِلعَلياءِ غَيرُكَ ناكِحاً","وتَرغَبُ عَن خِطبٍ وَأنتَ لَها بَعلُ",49,"ل",1,0],["أيطلب النيلُ يسقي زرعَه رجل","منكم ولا يملك الحقل الذي زرعا",50,"ع",2,0],["أيطاع في قومي رشيد معسر","ولو اَنَّهُ فيهم نبي مرسل",51,"ل",1,0],["أيطيق السوار معصمك الغ","ولولاه خفت من ان يميلا",52,"ل",2,0],["أَيُطيقُ حَمْلَ السُّقْمِ جِسْمُكِ وهو لم","يكُ للغلائلِ والعقودِ مُطيقا",53,"ق",2,0],["أيطرد مروان ابن بنت محمد","ويقرب داراً للنبي وأربعا",54,"ع",2,0],["أي طود من الرواسي العظام","فجعتنا به يد الأيام",55,"م",1,1],["أيطيقُ مُثْنٍ حصرَ وَصْفكِ بَعْدَمَا","أثْنَى عَلَيْكَ اللَّهُ فِي التَّكْوِينِ",56,"ن",1,0],["أيطيق محص حصر عشر صفاته","لا والذي قد سد عن ذا مسمعي",57,"ع",2,0],["أي طود من بني عدنان ثلا","وحسام لبني غالب فلا",58,"ل",2,1],["ايطمع من في الجهل كان مقامه","لتحصيل أمر ماله فيه مقدره",59,"ر",2,0],["إيطاؤهم في البيت عود الكلمه","باللفظ والمعنى معا مختتمه",60,"ه",1,0],["أَيطمع مبيَضُّ العذارَين أَنه","تُسوّله حُباً كواَعبُ خُرَّدُ",61,"د",1,0],["أَيَطلُبُ شَأوي وَما زالَ لي","عَتادُ المُقدّمِ في الحَلبَه",62,"ب",2,0],["أَيُّ طَودٍ ثوى من الأَطوادِ","ومُصابٍ قد فتَّ في الأعضادِ",63,"د",1,1],["أيطربني هذا الزمان وكله","عراك على الدنيا يثور غباره",64,"ر",2,0],["أيطمعني في سلم قدك لينه","وخدك في لام العذار المزرد",65,"د",1,0],["أيّ طود عند الهزاهز لا تط","مع فيه عواصف الإرجاف",66,"ف",1,0],["أيُّ طودٍ وإن تشامخ أنفاً","يا ابن ودي لا يصدع الدهرُ صخره",67,"ر",2,0],["أي طود أشمَّ صدَّعه الخط","بُ وعرش أركانَه الحتفُ ثلاَّ",68,"ل",2,0],["أيطيب بعدك مجلس لي أم","عيشي الهنيُّ وقد فقدت هني",69,"ن",2,0],["ايطربكم باللّه نوح قرابتي","اذا عددت يوما خصالي النوادب",70,"ب",1,0],["أي طيوب ليس يوحى بها","إلا محيا في شباب الزهر",71,"ر",1,0],["أي طريق اسلك","وأي قلب أملك",72,"ك",1,0],["أي طرفٍ منا يبيت قريراً","لم تفجر أنهاره تفجيرا",73,"ر",2,1],["أيّ طيفٍ عانقته في منامي","لم يكلله دمع عيني السجامً",74,"م",1,0],["أيُّ طيبٍ ولذةٍ لخليعٍ","شَرِبَ الماءَ شَهوَةً للنبيذِ",75,"ذ",1,0],["أيطيب عيشي أم تقر عيوني","والدهر صيرني حليف شجون",76,"ن",1,1],["أيطمع في سبا حرقاء كسرى","وذلك مطمع منه بعيد",77,"د",1,0],["أَيَطلبُ مني القَومُ مشيةَ خاضعٍ","وَأَنفَ ذَليلٍ بئس ما قد دَعاهم",78,"م",1,0],["أيُطمعكم منه ذاك الدلال","أَمْ حَسَمَ الشَّكُ فيما حسم",79,"م",1,0],["أيطلب لبنان أن يستقل","وقد بذ عاليه السافل",80,"ل",1,0],["أي طال والصق بابي فلان","فقد لصقت أمس بالإنسان",81,"ن",1,0],["أي طلعت وخالد زيداً حبَس","حبساً وأحبست سلاحي والفرس",82,"س",1,0],["أيطمع أن يشق غبار مهري","ذليل تحته عير حرون؟",83,"ن",1,0],["أيَطلُبُ سَرفِيدُونَ أَم جُندَ قَومِهِ","لِتَفتُكَ فِيهِم مِن يَدَيهِ البَوَاتِرُ",84,"ر",1,0],["أى طَلَبُ الصِّفَات زَائِدٌ عَلَى","قِيَامِهَا بِذَاتِ مَوصُوفٍ عَلاَ",85,"ل",2,0],["ايطعنني قوامك وهو خوطٌ","ويصرعني هواك وأنت ريم",86,"م",1,0],["أيطمع فهري يشمر للوغى","وقد جذ من فهر عرانينها شمر",87,"ر",1,0],["أي طيف من لامعات البروق","بات يسري بين الحمى والعقيق",88,"ق",1,1],["أَيطرقُ في الدُّجا منكم خيالُ","وَطرفي ساهرٌ هذا مُحالُ",89,"ل",1,1],["أَيُطمعُني الهوى منه بوصلٍ","ودونَ وصالهِ صَيدُ النُّجومِ",90,"م",1,0],["أَيُطمِعُني مِنَّهُ الهوَى بوصالِهِ","وَصَيدُ نجومِ الأُفقِ دونَ خيالِهِ",91,"ل",2,1],["أيُّ طيفٍ يزورُني منك في اللَّي","لِ وعيني لم تدرِ كيفَ الَمنامُ",92,"م",1,0],["أَيَطوي هَوىً يُبديهِ لِلناس مَدمَعٌ","وَجفنٌ إِذا نامَ الخَليُّون يَسهَرُ",93,"ر",1,0],["أيَطمعُ الدهرُ في عطفي وقد سفرتْ","عنّي الثلاثونَ واعتضْتُ الزمان أبا؟",94,"ب",2,0],["أَيَطْغَى أَنْ رَأَى والعَيْشُ رَغْدٌ","وُجُوهَ الدَّهْرِ تَخْدَعُ باسِماتِ",95,"ت",1,0],["أَيطِيبُ عيشاً عاقلٌ بحياته","متنعماً بمشاربٍ ومطاعمِ",96,"م",1,0],["أيطيبُ العيشُ في الدن","يا وفي الأحشاءِ نارُ",97,"ر",1,0],["أيُطيقُ العَزاءَ من جفن عيني","هِ طويلٌ سُهادُهُ والدُّموعُ",98,"ع",1,0],["أَي طَهَ نِمتَ فَنامَ كُلٌّ مِن أَسىً","أَي طَهَ نِمتَ فَذابَ جُلودُ الحَجَر",99,"ر",1,0],["أَي طَهَ نِمتَ فَصُبَّ سوطُ مُصيبَةٍ","مِنها لَقَد عَمَّ الرَدى وَدَنا العُمُر",99,"ر",1,0],["أيطلب الإنسانُ من باخلٍ","رزقاً ولا يطلب من واهبِ",100,"ب",1,1],["أيطربكِ الحنين؟ فِداكِ قلبي","لأجلك أحملُ الأشواق عُمراً",101,"ر",2,0],["أيطمع معشر في نيل عز","وقد ركنوا إلى عيش خَيَابِ",102,"ب",1,0],["أيُّ طرفٍ اِذا الكَميُّ رآهُ","عِوَضاً في الوغى عن الأرماحِ",103,"ح",1,0],["أيَطوِي المَوتُ حيًّا بَأسَ هَجرٍ","أمِ المَوتُ انطَوَى بِي لَستُ أدرِي",104,"ر",2,0],["أَيُّ طَيْرٍ حَطَّ فيِ حُضْنِي صَغِيِراً","وَاحْتَوَانِي فِي الْبَسَاتِينِ اتِّزَانَا؟",105,"ن",2,0],["أَيُّ طَيْرٍ إِلَى السَّمَاءِ اسْتَدَارَا ؟","وَجَنَاحٌ لَفَّ الْمَدَى وَتَوَارَى ؟!!",106,"ر",2,1],["أيُّ طلٍّ منكَ يهمي","يُرعِشُ الشّوقَ الخصِيبَا ؟!",107,"ب",2,0],["أي طعنه ماتهدد لي حياتي","لو زأر منها الأسد داخل عرينه",108,"ن",2,0],["أيّ طيبٍ معتّق في قلوبٍ","تتسامى نقيّة وتقيّة",109,"ي",2,0],["أَيَطُولُ مَنْ حَمِدَ الحَمِيدُ صِفَاتِهِ","في سُورَةِ القَلَمِ اجْتَبَاهُ وَمَجَّدَا ؟",110,"د",2,0],["أَيَطُولُ مَنْ شَغَلَ العَوَالِمَ ذِكْرُهُ","إنْسًا وَجِّنَّا غَائِبِينَ وشُهَّدَا ؟",110,"د",2,0],["أيطمئنُ وفيهِ النبضُ مضطربٌ","ولا شفاءَ لنبضٍ حينَ يضطربُ",111,"ب",1,0],["أيطلب مجداً من غد العشق دين