{"poems":[[53,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[53,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[77,"أجلك أن يلم بك العتاب","https://www.aldiwan.net/poem36763.html","الوافر"],[86,"رجعت لنفسي فاتهمت حصاتي","https://www.aldiwan.net/poem10924.html","الطويل"],[71,"أرى يحيى تعرض لي بسوء","https://www.aldiwan.net/poem3760.html","الوافر"],[93,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[93,"سلام عليكم والفواد المسلم","https://www.aldiwan.net/poem11363.html","الطويل"],[51,"أبدر السماء وغيث السماء","https://www.aldiwan.net/poem66000.html","المتقارب"],[89,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[89,"ذهب الشباب وانت بعد ذهابه","https://www.aldiwan.net/poem44726.html","الكامل"],[89,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"حياة ما نريد لها زيالا","https://www.aldiwan.net/poem62956.html","الوافر"],[85,"يا ناشر العلم بهذي البلاد","https://www.aldiwan.net/poem63771.html","السريع"],[45,"مهرج صبوحك سعده لم ينحس","https://www.aldiwan.net/poem64611.html","الكامل"],[28,"وقد مد حولي من المالكين","https://www.aldiwan.net/poem5044.html","المتقارب"],[105,"شجن بقلبك يطمئن ويفزع","https://www.aldiwan.net/poem43093.html","الكامل"],[105,"هل الحرب إلا أن تطير الجماجم","https://www.aldiwan.net/poem43156.html","الطويل"],[105,"كيف القرار ونار الحرب تستعر","https://www.aldiwan.net/poem43164.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85649","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9991","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54723","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141954","الكامل"],[45,"مَهْرِجْ صَبُوحَك سَعْدُه ُلم يُنْحَسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31143",""],[94,"يا وحشة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=12821",""],[135,"جل المصاب وجاء عيد مشرق","https://www.aldiwan.net/poem49168.html","الكامل"],[164,"وله نابه وخطب جليل","https://www.aldiwan.net/poem67814.html","الخفيف"],[166,"إذا اقتبس الهلال النور منه","https://www.aldiwan.net/poem46836.html","الوافر"],[173,"أنكر العبد بزه وحلاه","https://www.aldiwan.net/poem4381.html","عموديه"],[174,"أيطلب كيدي من يهون كياده","https://www.aldiwan.net/poem46068.html","الطويل"],[222,"بشير السعد أم ثغر التهاني","https://www.aldiwan.net/poem55409.html","الوافر"],[223,"كل ما في الحياة أنت فقد","https://www.aldiwan.net/poem41443.html","الخفيف"],[235,"أيطمع أن يساجلك السحاب","https://www.aldiwan.net/poem32176.html","الوافر"],[235,"أبثكم أني مشوق بكم صب","https://www.aldiwan.net/poem32178.html","الطويل"],[250,"سرى في دجى من شعره فحكا البدرا","https://www.aldiwan.net/poem14966.html","الطويل"],[270,"سلام أيها الدير القديم","https://www.aldiwan.net/poem35238.html","الوافر"],[349,"أي طب لداء دار حماها","https://www.aldiwan.net/poem15524.html","الخفيف"],[353,"لا تعتب الوغد اللئيم إذا أسا","https://www.aldiwan.net/poem40167.html","الكامل"],[364,"هبني أقصر بالخطا","https://www.aldiwan.net/poem60794.html","مجزوء الكامل"],[371,"جفن على شوك القتادة يطبق","https://www.aldiwan.net/poem57276.html","الطويل"],[402,"كم ذا يذوب أسى وكم يتجلد","https://www.aldiwan.net/poem46938.html","الكامل"],[403,"بالله يا ريح الصبا","https://www.aldiwan.net/poem34157.html","مجزوء الرجز"],[406,"أيا من نعاه لسان القريض","https://www.aldiwan.net/poem50146.html","المتقارب"],[416,"سقاها الهوى من راحة الوجد صرخدا","https://www.aldiwan.net/poem54030.html","الطويل"],[437,"أي طود هوى من الأطواد","https://www.aldiwan.net/poem2497.html","البسيط"],[437,"لهم حب قلبي إن تدانوا وإن صدوا","https://www.aldiwan.net/poem2622.html","الطويل"],[479,"إيطاليا قيل قالت","https://www.aldiwan.net/poem37202.html","المجتث"],[479,"إيطاليا قد تصدت","https://www.aldiwan.net/poem37203.html","المجتث"],[575,"أيدفعني الدهر عن مطلبي","https://www.aldiwan.net/poem2750.html","المتقارب"]],"verses":[["أَيُّ طَودٍ دُكَّ مِن أَيِّ جِبالِ","لَقَحَت أَرضٌ بِهِ بَعدَ حِيالِ",0,"ل",1,1],["أَيَطلُعُ لي عَزمٌ إِلى ما أُريدُهُ","وَصاحِبُ سِرّي في الرِجالِ مُذيعُ",1,"ع",1,0],["أَيُطنِبُ فِي مَعَانِيهَا الْمَعَالِي","بِرَبْعِكُمُ وَيُخْتَصَرُ الْكِتَابُ",2,"ب",1,0],["أَيُطرِبُكُم مِن جانِبِ الغَربِ ناعِبٌ","يُنادي بِوَأدي في رَبيعِ حَياتي",3,"ي",1,0],["أَيَطمَعُ أَنَّني أَهجوهُ كَلّا","كَفاني أَن يُقالَ أَخو رُقَيَّه",4,"ه",1,0],["أَيْ طَيْفَ عُثْمَانَ لَمْ يَبْرَحْ بِهَيْبَتِهِ","حَيّاً عَلَى أَنَّهُ بِالذِّكْرِ مُرْتَسِمُ",5,"م",1,0],["أَيُطْرِبُكُمْ نَظْمُ الْخَيَالِ وَهَلْ لَهُ","قِوَامٌ بِهِ عِنْدَ الْفِعَالِ يُقَوَّمُ",6,"م",1,0],["أيطلبني سيدٌ لا أزا","ل أبغي بجهدي إليه سبيلا",7,"ل",2,0],["أي طرف عليك لم يك يا","سعد بمصر وغيرها والباك",8,"ك",1,0],["أيطيب عيش الروح بعد عيائه","ويطيب عيش الجسم بعد خرابه",9,"ه",1,0],["أي طب في حفيرك","يشفى شللك",10,"ك",1,0],["أَيطلُبون الأَمرَ وَالأَمرُ لَهُم","قَد قَرَّ في بَيت النَبيِّ وَرَسا",11,"ا",1,0],["أَيُطلَبُ حَقَّهُم بِالروحِ قَومٌ","فَتَسمَعُ قائِلاً رَكِبوا الضَلالا",12,"ل",2,0],["أَيَطلُبُ المَجدَ وَيَبغي العُلا","قَومٌ لِسوقِ العِلمِ فيهِم كَساد",13,"د",1,0],["أَيَطيبُ مِنكَ تَكاسُلٌ عَن فِتيَةٍ","قَد عاقَروا الصَهباءَ جِنحَ الحِندِسِ",14,"س",1,0],["أَيَطلُبُ مَجدَ بَني دارِمٍ","عَطِيَّةُ كَالجُعَلِ الأَسوَدِ",15,"د",1,0],["أَيُطيقُ عِبءَ النَومِ جَفنٌ مُتعَبٌ","وَيُطيعُ حُكمَ الصَبرِ قَلبٌ موجَعُ",16,"ع",1,0],["أَيَطلُبُ مُلكاً أَم يُريدُ خِلافَةً","تُقامُ لَها في المشعَرَينِ المَواسِمُ",17,"م",1,0],["أَيَطرَبُ البَيتُ أَم تَبكي جَوانِبُهُ","حُزناً وَيُعوِلُ فيهِ الرُكنُ وَالحَجَرُ",18,"ر",1,0],["أَيطعن مصراً في صميم فؤادها","أناس إلى مصر يمتّون بالقربى",19,"ب",2,0],["أَيَطلُبُ عَبلَةً مِنّي رِجالٌ","أَقَلُّ الناسِ عِلماً بِاليَقينِ",20,"ن",1,0],["أَيَطْعُنُ فِي شَيْنٍ فَإنَّكَ وَاجِدٌ","دَماً وَصَرِيعاً وَالسِّنَانَ المُسَدَّدَا",21,"د",2,0],["أيطوف الساقي هنا بكؤوسه","ويزمجر الجابي هناك ويرزم",22,"م",1,0],["أَيَطيبُ مِنك تكَاسُلٌ عَن فِتْيةٍ","قَد عاقُرواالصَّهْبَاءَ جِنحَ الجِنْدِسِ",23,"س",1,0],["أيطمع الشعر بالإحسان يغمره","والشعر يغمر الدّنيا الله إحسانا",24,"ن",2,0],["أيطيع داعي البشر أم داعي الأسى","قلبي ويحلو الصفو أم يتمزق",25,"ق",1,0],["أَيُّ طَرفٍ سَما إِلَيكُم بِكَيدٍ","لَم تَرُدّوهُ وَهوَ مِنكُم كَليلُ",26,"ل",1,0],["أيطمَع أنْ يكونَ غلامَ وَجْهي","وليسَ لكاذبِ الأطماعِ وَجْهُ",27,"ه",1,0],["أَيُّ طِرسٍ كَأَنَّهُ رَوضُ حَزنٍ","جَادَتِ السُّحبُ بِالعَشِيِّ رُبَاهُ",28,"ا",2,0],["أَيَطْلُبُ كَيْدِي مَنْ يَهُونُ كِيَادُهُ","فَيُوقِدُ نَاراً مِثْلَ نارِ الحُباحِبِ",29,"ب",1,1],["أيطرق عين همتنا سهاد","وهمّتنا تجلُّ عن البيان",30,"ن",1,0],["أَيَّ طَيفٍ أَرى خِلالَ شُكوكي","لَم يَذُب بَعدُ في لَهيبِ غنايا",31,"ا",3,0],["أَيَطمَعُ أَن يُساجِلَكَ السَحابُ","وَهَل في الفَرقِ بَينَكُما اِرتِيابُ",32,"ب",1,1],["أَيَطمَعُ في إِدراكِ شَأويَ مُفحَمٌ","وَأَينَ الدَنّيُ النِكسُ وَالفاضِلُ النَدبُ",33,"ب",1,0],["أَيطمَعُ في صَبري العذولُ وإنَّ مَن","يصاحب قلباً في الهوى يَعرف الصَبرا",34,"ر",2,0],["أَيطربُنا من القدَّاس لحنٌ","يُردِّدُهُ لنا صوتٌ رخيم",35,"م",1,0],["أَيُّ طَبٍّ لِداءِ دارٍ حِماها","وِردُهُ يورِدُ الحِمامَ الطَبيبا",36,"ب",2,1],["أَيَطيب أَصلاً وَهوَ أَقبَح مِن قَذىً","لا أَصَل يُدعى للدعيّ فيأرسا",37,"س",2,0],["أيُطاقُ معْ قٌرْبِ الجِوا","ر كذا الجَفاءُ على اتِّصال",38,"ل",1,0],["أيُطيقُ كتمانَ الصَّبابةِ من له","في كلِّ جارِحةٍ لِسانٌ يَنطِقُ",39,"ق",1,0],["أَيَطيبُ ليْ زَمني ولم أُجْرِي بهِ","في حَلْبةِ العِلم الشّريفِ جوادي",40,"ي",1,0],["أيطرق الطيف فتى","منامه قد غصبا",41,"ب",2,0],["أَيطَّلِبُ المُلكَ مَن لَيسَ مِنهُ","وَلا من بنيه وَلا صِنفِهِ",42,"ف",2,0],["أَيُطلَبُ إلاَّ من مفاخرك العُلى","ويسأل إلاَّ من أَنامِلكَ النَّدى",43,"د",2,0],["أيّ طودٍ هوى من الأطواد","أيّ هدي ولّى وأيّ رشاد",44,"د",1,1],["أيطمع أقوام بنعمة عيشة","متى عطشوا فالموت دونهم وردُ",45,"د",1,0],["إيطاليا قيل قالت","إفريقيا من حقوقي",46,"ق",2,1],["إيطاليا قد تصدت","لحربنا بارتعاش",47,"ش",1,1],["أَيطلعُ فَجْر سُعُودِي وَلاَ","أَفِرُّ إِليه من الغَيْهَبِ",48,"ب",1,0]]}