{"poems":[[89,"سلام على عهد الرقي المحبب","https://www.aldiwan.net/poem44927.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[346,"ترهبت لما أن غدا اللحم غاليا","https://www.aldiwan.net/poem20380.html","الطويل"],[367,"ليس في التقويم مايرغب","https://www.aldiwan.net/poem4273.html","مجزوء الرمل"],[560,"بين رئم الحمى وآرام رامه","https://www.aldiwan.net/poem52971.html","الخفيف"]],"verses":[["ترهب يرعى العلم خمسين حجة","فاكبر به من عالم مترهب",0,"ب",1,0],["تَرْهَبُ العَيْنُ طَرْفَةَ الجَفْنِ مِنْ حِرْ","صٍ عَلَى لَحْظَةٍ لهُ تُسْتَفَاد",1,"د",1,0],["تَرْهبُ الرِّيحُ أن تَخدَّ لَهَا","خَدّاً فَتَجْرِي في خَشْيةٍ وَأَنَاةِ",2,"ه",1,0],["تَرَهَّبْتُ لَمَّا أَنْ غَدا اللَّحْمُ غَالِياً","وَرَهَّبْتُ عِرْسي فَهْيَ لا تَتَزفَرُ",3,"ر",1,1],["ترهات طوّروها ال","غيب بأحكام قبيحه",4,"ح",2,0],["تُرهِبُ النَّفسَ نظرةٌ منهُ إِجلا","لاً وتُحيى القُلوبَ منهُ ابتِسامَهْ",5,"م",2,0]]}