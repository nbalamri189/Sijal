{"poems":[[91,"سلام على عهد الرقي المحبب","https://www.aldiwan.net/poem44927.html","الطويل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29339","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[353,"ترهبت لما أن غدا اللحم غاليا","https://www.aldiwan.net/poem20380.html","الطويل"],[374,"ليس في التقويم مايرغب","https://www.aldiwan.net/poem4273.html","مجزوء الرمل"],[567,"بين رئم الحمى وآرام رامه","https://www.aldiwan.net/poem52971.html","الخفيف"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83310","المنسرح"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34764","الرمل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133764","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95495","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80053","الكامل"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26662","المنسرح"],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89628","السريع"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53044","الرمل"],[2360,"","https://poetry.dctabudhabi.ae/diwan/poem/119159","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201274","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202824","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202763","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202592","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62817","المنسرح"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29273","الخفيف"],[5409,"خسرتك البلادُ ركنا قويا","https://www.poetsgate.com/ViewPoem.aspx?id=155487",""]],"verses":[["ترهب يرعى العلم خمسين حجة","فاكبر به من عالم مترهب",0,"ب",1,0],["ترهبني الخثى بكعب وسالم","وعندي لخثى خطة ما تريدها",1,"د",3,0],["تَرْهَبُ العَيْنُ طَرْفَةَ الجَفْنِ مِنْ حِرْ","صٍ عَلَى لَحْظَةٍ لهُ تُسْتَفَاد",2,"د",1,0],["تَرْهبُ الرِّيحُ أن تَخدَّ لَهَا","خَدّاً فَتَجْرِي في خَشْيةٍ وَأَنَاةِ",3,"ه",1,0],["تَرَهَّبْتُ لَمَّا أَنْ غَدا اللَّحْمُ غَالِياً","وَرَهَّبْتُ عِرْسي فَهْيَ لا تَتَزفَرُ",4,"ر",1,1],["ترهات طوّروها ال","غيب بأحكام قبيحه",5,"ح",2,0],["تُرهِبُ النَّفسَ نظرةٌ منهُ إِجلا","لاً وتُحيى القُلوبَ منهُ ابتِسامَهْ",6,"م",2,0],["تُرهِقَهُم ذِلَّةً وَتَحسَبُهُم","قَوماً سُكارى كَأَنَّهُم حُشِروا",7,"ر",3,0],["تُرهِجُ الطُرقَ عَلى مُجتازِها","بِيَدٍ في المَشيِ وَالخَطوِ القَطِف",8,"ف",1,0],["ترها والخشوع هدهد عطفيها","تهادت بالاثمد المتهادي",9,"د",2,0],["ترهبُ الأرضُ عزمه من مضاءٍ","وتدينُ الملوكُ باستغفارِ",10,"ر",1,0],["ترَها عقائل فكرةٍ","أخذ النهى ميثاقَها",11,"ق",3,0],["تُرهِبُ في كفّه يراعته","كلّ أصمّ الكعوب مرهوب",12,"ب",1,0],["تُرهِقُهُ ضَرباً وَتَنجو عَلى","وَحشيِّها قارِبَةَ المَنهَلِ",13,"ل",1,0],["ترهب الأملاك منه ضيغماً","سمره الآجام والبيض النُّيوب",14,"ب",1,0],["ترهّب بعدك الحسن بن سهل","فأغلق بابه دون المديح",15,"ح",1,1],["ترّهبتُ خوف قيود الحياة","فكيف الترهب عن أسرتي",16,"ي",1,0],["ترهّبتُ عن حريةٍ لا تنسكٍ","فلست لنسّاكٍ ولست لزهّاد",17,"د",1,1],["ترهّبت بعداً عن طباعك لا تقىً","فما كنت ممن في أغاويك غررت",18,"ت",1,0],["ترهبت في الدنيا ويا ليت أنني","ترهبت عن دنيا بها الشر قائم",19,"م",1,0],["ترهبكَ الطيرُ في مواكبِها","ودونَها شاهِقُ وتيّارُ",20,"ر",1,0],["تُرهَفُ الأُذنُ نَحوَها ثُمَّ تُرخى","في ذُهولٍ يُجيبُ بِالإِغضاءِ",21,"ا",2,0],["ترهف السمع في البيان فيصغي","لك شوقاً وتحجم اللسن عيا",22,"ي",2,0]]}