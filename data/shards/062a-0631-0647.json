{"poems":[[91,"سلام على عهد الرقي المحبب","https://www.aldiwan.net/poem44927.html","الطويل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29339","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[351,"ترهبت لما أن غدا اللحم غاليا","https://www.aldiwan.net/poem20380.html","الطويل"],[372,"ليس في التقويم مايرغب","https://www.aldiwan.net/poem4273.html","مجزوء الرمل"],[564,"بين رئم الحمى وآرام رامه","https://www.aldiwan.net/poem52971.html","الخفيف"],[759,"","https://poetry.dctabudhabi.ae/diwan/poem/89628","السريع"]],"verses":[["ترهب يرعى العلم خمسين حجة","فاكبر به من عالم مترهب",0,"ب",1,0],["ترهبني الخثى بكعب وسالم","وعندي لخثى خطة ما تريدها",1,"د",3,0],["تَرْهَبُ العَيْنُ طَرْفَةَ الجَفْنِ مِنْ حِرْ","صٍ عَلَى لَحْظَةٍ لهُ تُسْتَفَاد",2,"د",1,0],["تَرْهبُ الرِّيحُ أن تَخدَّ لَهَا","خَدّاً فَتَجْرِي في خَشْيةٍ وَأَنَاةِ",3,"ه",1,0],["تَرَهَّبْتُ لَمَّا أَنْ غَدا اللَّحْمُ غَالِياً","وَرَهَّبْتُ عِرْسي فَهْيَ لا تَتَزفَرُ",4,"ر",1,1],["ترهات طوّروها ال","غيب بأحكام قبيحه",5,"ح",2,0],["تُرهِبُ النَّفسَ نظرةٌ منهُ إِجلا","لاً وتُحيى القُلوبَ منهُ ابتِسامَهْ",6,"م",2,0],["تُرهِقُهُ ضَرباً وَتَنجو عَلى","وَحشيِّها قارِبَةَ المَنهَلِ",7,"ل",1,0]]}