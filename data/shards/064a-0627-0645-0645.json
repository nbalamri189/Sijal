{"poems":[[55,"أحق من كانت النعماء سابغة","https://www.aldiwan.net/poem29814.html","البسيط"],[139,"الراح يحسن في الصفا مسعاها","https://www.aldiwan.net/poem49131.html","الكامل"],[159,"يا ممرض الجسم مني عند صحته","https://www.aldiwan.net/poem55601.html","البسيط"],[240,"آه للبرق أضاءا","https://www.aldiwan.net/poem32197.html","مجزوء الرمل"],[276,"بكى الغريب لفقد الدار والجار","https://www.aldiwan.net/poem52093.html","البسيط"],[366,"يفديك يا بدر صب ما بخلت على","https://www.aldiwan.net/poem68124.html","البسيط"],[422,"أرأيت مثلي في الهوى","https://www.aldiwan.net/poem53911.html","مجزوء الكامل"],[443,"ته فلو قستك بالظبي الغرير","https://www.aldiwan.net/poem2516.html","الرمل"],[591,"يا ممرض جسمه ويا متلفه","https://www.aldiwan.net/poem17602.html","الدوبيت"],[591,"يا ممرض صبه بكثر التيه","https://www.aldiwan.net/poem17839.html","الدوبيت"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122656","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48825","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63740","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59239","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59089","الكامل"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75733","الكامل"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143130","الكامل"],[1420,"","https://poetry.dctabudhabi.ae/diwan/poem/100680","البسيط"],[1496,"","https://poetry.dctabudhabi.ae/diwan/poem/131414","البسيط"],[1845,"","https://poetry.dctabudhabi.ae/diwan/poem/132181","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123299","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65129","البسيط"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103799","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135737","الرجز"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81299","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139747",""],[4702,"أمي .. عتاب وولاء","https://www.poetsgate.com/ViewPoem.aspx?id=155213",""],[4755,"قَيِّدْ فَضَائِي.. وهَبْ لِي مَسْلَكًا وعَصَا","https://www.poetsgate.com/ViewPoem.aspx?id=183782",""],[4755,"قَلَقُ السّفِينة","https://www.poetsgate.com/ViewPoem.aspx?id=184355",""],[4755,"جَاءَ الذي راحَ أو رَاحَ الذي جَاءَ","https://www.poetsgate.com/ViewPoem.aspx?id=190325",""],[5005,"هوّن عليك..","https://www.poetsgate.com/ViewPoem.aspx?id=204897",""],[5045,"سجل حديث النصر","https://www.poetsgate.com/ViewPoem.aspx?id=185179",""],[5277,"يا ممطل الوعد","https://www.poetsgate.com/ViewPoem.aspx?id=191087",""],[5358,"طرقتُ بابَك","https://www.poetsgate.com/ViewPoem.aspx?id=183427",""],[5370,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=87420",""],[5525,"الله اقوى","https://www.poetsgate.com/ViewPoem.aspx?id=867",""],[5606,"يامملكتنا","https://www.poetsgate.com/ViewPoem.aspx?id=197809",""],[5790,"أنظرت أم فوقت سهما","https://www.poetsgate.com/ViewPoem.aspx?id=112135",""],[6125,"للهُ أكبرُ منْ جُرْمي وزلَّاتي","https://www.poetsgate.com/ViewPoem.aspx?id=210904",""],[6147,"الدّفق الغامر.. في مدح الرسول الأعظم","https://www.poetsgate.com/ViewPoem.aspx?id=212925",""]],"verses":[["يا مُمرِضاً بِالمَساعي قَلبَ حاسِدِهِ","عَلى العُلى وَمُداوي الفَقرِ وَالعَدَمِ",0,"م",1,0],["يا ممْرضاً مهجَ الورى بجفونهُ","إني لأعلم في الشفاهِ شفاها",1,"ا",3,0],["يا مُمْرِضَ الجِسْمِ مِنِّي عِنْدَ صِحَّتِهِ","هَبْ لِي عَلى طُولِ ما أَفْنى عَلَيْكَ بَقَا",2,"ق",2,1],["يا مُميتَ العُدمِ أَحيَي","تَ بِجَدواكَ الرَجاءا",3,"ا",3,0],["يا ممرضي بربا نجد أَعد مَرضى","عَسى يَعودون عوادى وزوّاري",4,"ر",2,0],["يا ممرضي بِشَقيق عَمّ وَجنته","وَجاعِل عَنكَ وَلا عقد الهَوى فسخا",5,"خ",2,0],["يا ممرضي بجفوته","لا تَرْكَنَنَّ إلى شفائي",6,"ا",2,0],["يا مماتي وعذابي غضبا","وحياتي حين يرضى وسروري",7,"ر",2,0],["يا مُمْرِضَ جِسْمِهِ وَيَا مُتْلِفَهُ","كَمْ تُتْلِفُهُ هَجْراً وَلاَ تُنْصِفُهُ",8,"ه",1,1],["يَا مُمْرِضَ صَبِّهِ بِكثر التِّيه","أَوْردْتَ فُؤادَهُ بِحارَ التِّيهِ",9,"ه",1,1],["يا ممرضي عَن صَريحِ اللَّومِ عَن غَرضٍ","ومُمرضي خَلِّ إمراضي وإرماضي",10,"ض",2,0],["يا مُمدّ النيلين من فيض كفي","ه يجوبُ الربى ويحيي البيدا",11,"د",2,0],["يا ممضياً قلماً وسيفاً ذا وذا","قَدَرٌ إِذا تَمْضِي الأمورُ مُقَدَّر",12,"ر",1,0],["يَا مُمْرِضِي بِجُفُونٍ كُنْتُ أحْسبهَا","لَمَّا عَدَتْنِي سَقَاماً أنَّهَا تَشْفِي",13,"ف",2,0],["يَا مُمْرِضِي بسقَام مُقْلَتِهِ الَّتِي","فِيهَا الدَّوَاءُ وَمِنْ دَوَاهَا الدَّاءُ",14,"ا",2,0],["يا ممطر الذهب الغَزير عَطائه","المجتدي يَزهو فَتَحزَن أسحب",15,"ب",1,0],["يا ممطيا طرف البراعة عبده","لما أعاد اليه طرف مخرِّج",16,"ج",1,0],["يا ممرضي بجفون لأمراض بها","صحّت ومن طبعها التمريض والمرض",17,"ض",1,1],["يا ممسكا بعرا الدنيا إذا خشيت","منها الزلازل والأمر الذي يقعُ",18,"ع",1,0],["يا ممرضي بجفونه","صل مدنفاً أسهرت جفنه",19,"ن",2,0],["يا مُمغص الناس من ضحك كُقلقاس","أمست عليكم حزانى أنفس الناس",20,"س",1,1],["يا مُمطرا روض فكري من مكارمه","فأصبحت بزُهُور المدح في حُلل",21,"ل",1,0],["يا ممطري بفعاله ومقاله","ومحافظي بوداده لا محفظي",22,"ظ",2,0],["يا ممرضٌ مضرُّ يا مداوي","بك اشفني أنت الذي تداوي",23,"ي",1,0],["يا ممتري أَدب الحَياة وَمُجتَلي","صُور الشَباب اليَوم في أَقطابه",24,"ب",2,0],["يا ممكناً تمجيده واجبٌ","أنشا به الواجب امكانا",25,"ن",2,0],["يا مملكتنا لك الارواح درعٍ حصين","وقفة شجاعٍ ليا حان الفدا برهنه",26,"ن",2,0],["يا مُمْسِكِي مِن ذِرَاعِي لَم أَعُدْ حَدَثًا","مَرَّتْ ثَلاثُونَ.. دَعنِي أُهدِرِ الفُرَصَا",27,"ص",2,0],["يا مُمسِكًا بيدِ الغَريقَةِ.. مَن لَهَا","إنْ رُحْتَ تَلْهُو كالصِّغارِ وتَعبَثُ؟",28,"ث",1,0],["يا مُمْسِكَ الحُبِّ مِن حَرفَيْهِ في لُغَتِيْ","بأيِّ عَينٍ تَرَى الأوهامَ أشياءَ؟!",29,"ا",2,0],["يا ممسكَ الأشياءِ من أنصافها","أفلتْ ودعها كالمياه تسيلُ",30,"ل",1,0],["يامملكة سلمان دام الله السرور","جاكم عريس الموت من توشكار اغار",31,"ر",1,0],["يا مُمطلَ الوعدِ كم أعياك تبريحُ","كالنارِ تسعرُها من عصفِها ريحُ",32,"ح",1,1],["يامُمطلَ الوعدِ ﻻ زالت محبتُنا","فيها من الوجدِ في الصوبينِ تطويحُ",32,"ح",1,0],["يا مُمْطراً في الصّيْفِ جَفْنَكَ","كيفَ لمْ تَفْقِدْ سَحابَكْ؟",33,"ك",1,0],["يا مملكة عطف يا عطر الرياحيني","براثن الهم والهوجاس تلسعني",34,"ن",2,0],["يا ممنى حياتي .. بالسحاب","وين غيث المحبه .. ما هما",35,"م",2,0],["يامملكتنا وصلتي كوكب المشتري","وأنتي على قمة الأمجاد متربعه",36,"ع",2,1],["يا ممرضي ومعذبي","أوما تراقب فيّ إثما",37,"م",2,0],["يا مُمسكَ الأرضِ والسَّبعِ الشِّدادِ على","عظيمِ خِلْقَتِها يَسِّرْ مَطِيَّاتي",38,"ت",2,0],["يا مُمسكَ الماء في الأبحار تُلجِمه","يا فالقَ الرّوح بالأسرار تَحجُبها",39,"ب",3,1]]}