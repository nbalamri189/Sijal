{"poems":[[53,"أحق من كانت النعماء سابغة","https://www.aldiwan.net/poem29814.html","البسيط"],[135,"الراح يحسن في الصفا مسعاها","https://www.aldiwan.net/poem49131.html","الكامل"],[155,"يا ممرض الجسم مني عند صحته","https://www.aldiwan.net/poem55601.html","البسيط"],[235,"آه للبرق أضاءا","https://www.aldiwan.net/poem32197.html","مجزوء الرمل"],[271,"بكى الغريب لفقد الدار والجار","https://www.aldiwan.net/poem52093.html","البسيط"],[361,"يفديك يا بدر صب ما بخلت على","https://www.aldiwan.net/poem68124.html","البسيط"],[416,"أرأيت مثلي في الهوى","https://www.aldiwan.net/poem53911.html","مجزوء الكامل"],[437,"ته فلو قستك بالظبي الغرير","https://www.aldiwan.net/poem2516.html","الرمل"],[586,"يا ممرض جسمه ويا متلفه","https://www.aldiwan.net/poem17602.html","الدوبيت"],[586,"يا ممرض صبه بكثر التيه","https://www.aldiwan.net/poem17839.html","الدوبيت"]],"verses":[["يا مُمرِضاً بِالمَساعي قَلبَ حاسِدِهِ","عَلى العُلى وَمُداوي الفَقرِ وَالعَدَمِ",0,"م",1,0],["يا ممْرضاً مهجَ الورى بجفونهُ","إني لأعلم في الشفاهِ شفاها",1,"ا",3,0],["يا مُمْرِضَ الجِسْمِ مِنِّي عِنْدَ صِحَّتِهِ","هَبْ لِي عَلى طُولِ ما أَفْنى عَلَيْكَ بَقَا",2,"ق",2,1],["يا مُميتَ العُدمِ أَحيَي","تَ بِجَدواكَ الرَجاءا",3,"ا",3,0],["يا ممرضي بربا نجد أَعد مَرضى","عَسى يَعودون عوادى وزوّاري",4,"ي",1,0],["يا ممرضي بِشَقيق عَمّ وَجنته","وَجاعِل عَنكَ وَلا عقد الهَوى فسخا",5,"خ",2,0],["يا ممرضي بجفوته","لا تَرْكَنَنَّ إلى شفائي",6,"ا",2,0],["يا مماتي وعذابي غضبا","وحياتي حين يرضى وسروري",7,"ي",1,0],["يا مُمْرِضَ جِسْمِهِ وَيَا مُتْلِفَهُ","كَمْ تُتْلِفُهُ هَجْراً وَلاَ تُنْصِفُهُ",8,"ه",1,1],["يَا مُمْرِضَ صَبِّهِ بِكثر التِّيه","أَوْردْتَ فُؤادَهُ بِحارَ التِّيهِ",9,"ه",1,1]]}