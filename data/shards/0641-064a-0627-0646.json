.net/poem17330.html","الطويل"],[366,"إذا أقفرت للعمر دار فبعدها","https://www.aldiwan.net/poem17777.html","الطويل"],[377,"سمعت بأذني رنة السهمِ في قلبي","https://www.aldiwan.net/poem66952.html","الطويل"],[403,"يا أيها البدر الذي بعلومه","https://www.aldiwan.net/poem33472.html","الكامل"],[403,"عساه يرضى المغضب","https://www.aldiwan.net/poem34160.html","مجزوء الرجز"],[412,"وقالوا لن تنأل الدهر فقر","https://www.aldiwan.net/poem36.html","الوافر"],[429,"باح الفؤاد بسر كنت أخفيه","https://www.aldiwan.net/poem41067.html","البسيط"],[432,"ما يقول الفقيه أبقاه ذو العر","https://www.aldiwan.net/poem12602.html","الخفيف"],[432,"أنجد الصب وغاروا","https://www.aldiwan.net/poem12645.html","مجزوء الرمل"],[432,"ثنت عنك يوم الرحيل العنانا","https://www.aldiwan.net/poem12741.html","المتقارب"],[437,"فؤاد عصاه صبره وهو طالبه","https://www.aldiwan.net/poem2577.html","الطويل"],[441,"لقد برك السهاد على عيوني","https://www.aldiwan.net/poem14390.html","الوافر"],[449,"حديث الحب","https://www.aldiwan.net/poem1016.html",""],[453,"أتاني كتاب الصديق العزيز","https://www.aldiwan.net/poem61796.html","المتقارب"],[458,"كالشمس من جمرة عبد شمس","https://www.aldiwan.net/poem56156.html","الرجز"],[458,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[464,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[464,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[464,"خليلي ما بال الكؤوس عواطلا","https://www.aldiwan.net/poem3524.html","عموديه"],[477,"لمن دمن بالرقمتين وأطلال","https://www.aldiwan.net/poem15250.html","الطويل"],[515,"إلى كم أحوك الشعر في الذم والمدح","https://www.aldiwan.net/poem12053.html","الطويل"],[544,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[551,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[558,"لقد أوقعت دعوى المحبة في البلا","https://www.aldiwan.net/poem33884.html","الطويل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"كم أعدمتني مشبها أو نظير","https://www.aldiwan.net/poem2723.html","السريع"],[575,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[575,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"]],"verses":[["فَيا نَفسِ اِذهَبي أَسَفاً عَليهِم","فَبُعدُهُم كَموتِكَ أَن تَعيشي",0,"ش",2,0],["فَيا نازِلي رَملَ الحِمَى هَل لَدَيكُمُ","شِفاءٌ لِصَبٍّ داؤُهُ مِن طَبيبِهِ",1,"ب",2,0],["فَيا نَفْسُ صَبْراً إِنَّ لِلْهَمِّ فُرْجَةً","وَما لَكِ إَلّا العِزُّ عِنْدِي أَو القَبْرُ",2,"ر",1,0],["فيا نِضْوُ لا يَجْمَحْ بكَ الشّوقُ واصْطَبِرْ","قَليلاً وكَفْكِفْ منْ دُموعِكَ يا سَعْدُ",3,"د",1,0],["فَيا نَسَماتِ البانِ بِاللَهِ خَبِّري","عُبَيلَةَ عَن رَحلي بِأَيِّ المَواضِعِ",4,"ع",1,0],["فَيا نَفسُ صَبراً لَستِ وَاللَهِ فَاِعلَمي","بِأَوَّلِ نَفسٍ غابَ عَنها حَبيبُها",5,"ب",3,0],["فَيَا نَاصِرَ الإِسْلاَمِ دُمْ فِي حُلَى الْعُلَى","وَجَارُكَ فِي أَمْنٍ وَقُطْرُكَ فِي سِلْمِ",6,"م",1,0],["فَيا ناصِرَ المُستَضعَفينَ إِذا عَدا","عَلَيهِم زَمانٌ بِالعَداوَةِ مولَعُ",7,"ع",1,0],["فَيا نيلُ إِن لَم تَجرِ بَعدَ وَفاتِهِ","دَماً أَحمَراً لا كُنتَ يا نيلُ جارِيا",8,"ي",2,0],["فَيا نَفسُ إِن كُنتِ لا توقِنينَ","بِمَعقودِ أَمرِكِ فَاِستَيقِني",9,"ن",2,0],["فَيا نادِياً ضَمَّ أُنسَ النَديمِ","وَلَهوَ الكَريمِ وُقيتَ البِلى",10,"ا",1,0],["فَيَا نُخَباً هَبَّتْ تُجَدِّدُ مَجْدَهَا","وَتَأْتِي بِمَا لَمْ تَسْتَطِعْ قَبْلَهَا النُّخَبْ",11,"ب",1,0],["فَيا نَفسُ طيبي ثُمَّ يا نَفسُ أَبشِري","فَغَيرُ بَعيدٍ كُلُّ ما هُوَ آتِ",12,"ت",1,0],["فَيا نَفسُ ذِلّي بَعدَ مَيٍّ وَسامِحي","فَقَد سامَحَت مَيٌّ وَذَلَّ قَرينُها",13,"ن",3,0],["فَيا نَدَمَاً غَداةَ تَرَكتُ زَيدَاً","وَرائي لابنِ آمِنَةَ الأَمينِ",14,"ن",1,0],["فَيا نَفسُ مالاقَيتِ مِن لاعِجِ الهَوى","وَياقَلبُ ماجَرَّت عَلَيكَ النَواظِرُ",15,"ر",1,0],["في أن تكون الذي يتيه","من نعمةٍ كمن لؤما",16,"م",2,0],["في أَنفُسِ الناس وَأَلبابُهُم","وَفي بُطونِ السَيرِ الخالِدات",17,"ت",1,0],["فَيا نَسيمَ الصَبا أَنتَ الرَسولُ لَهُ","وَاللَهُ يَعلَمُ أَنّي مِنكَ غَيرانُ",18,"ن",1,0],["فَيا نَيسانُ ما أَبقَي","تَ في الفِعلِ لَتَمّوزِ",19,"ز",1,0],["فيا ندمائي الظلماء والشهب قبلها","أرى الجام مهتزا بها متوقدا",20,"د",2,0],["فَيا نَخلَةَ الرَملِ لَم تَبخَلي","وَلا قَصَّرَت نَخَلاتُ التُرَب",21,"ب",1,0],["فَيا ناقِليهِم لَو تَرَكتُم رُفاتَهُم","أَقامَ يَتيماً في حِراسَةِ لَئآلِ",22,"ل",1,0],["فَيا نَكَدَ الحُرِّ هَل تَنقَضي","وَيا فَرَحَ الحُرِّ هَل تَكمُلُ",23,"ل",1,0],["فيا نومُ لا تعمُرْ وِسادي ولا تَطُر","بمقلةِ مرهوم الإزارين بالقَطْرِ",24,"ر",1,0],["فَيا ناصِرَ الإِسلامِ لَو أَنَّ ناصِراً","يُرافِدُهُ في حِفظِهِ وَيُناوِبُه",25,"ب",2,0],["فيا نُوَبَ الخُطوبِ إليكِ عَنها","كفَاها ما أَلمَّ بها كفَاها",26,"ا",3,0],["في اناسِ مَن تَسهُلُ المَطالِبُ أَح","ياناً عَلَيهِ وَرُبَّما صَعُبَت",27,"ت",1,0],["فَيا نَفسُ خافي اللَهَ وَاجتَهِدي لَهُ","فَقَد فاتَتِ الأَيّامُ وَاقتَرَبَ الوَعدُ",28,"د",1,0],["فَيا نازِحاً يُدنيهِ حُسنُ اِدِّكارِهِ","فَفي بُعدِهِ قُربٌ وَفي قُربِهِ بُعدُ",29,"د",1,0],["فيا ندوة السمار هل من مسجل","يدوّن إعجاز القرائح منصفا",30,"ف",2,0],["فيا نجوم الليل لا نجم لي","ولا أرى لي أفقاً بعده",31,"ه",1,0],["في أناشيد تغنّى للبشر","ليس في الأحياء من يسمعنا",32,"ن",2,0],["فيا نارَ وجدي كيف عشتِ تضرّماً","بماءٍ من الأجفان للنّار قاتلِ",33,"ل",1,0],["فَيا نَظرَةً لا تَنظُرُ العَينُ أُختَها","إِلى الدارِ مِن رَملِ اللَوى المُتَقاوِدِ",34,"د",1,0],["فَيا نَدامَةَ نَفسي في المَعادِ إِذا","تَعَوَّذَ المَرءُ خَوفَ النُطقِ بِالبَكمِ",35,"م",1,0],["فَيَا نِعْمَ مَا وَلَّتْ بِهِ دَوْلَةُ الصِّبَا","وَلَمْ تَرْعَهُ مِنْ عَهْدِنَا الْمُتَقَادِمِ",36,"م",1,0],["فيا ناظراً في اللغزِ لو رمتَ كشفَهُ","رجعْتَ إلى القولِ الذي قالَهُ عمرْ",37,"ر",1,0],["فَيا نُعمُ قَلبي في الأَسارى إِلَيكُم","رَهينٌ وَقَد شَطَّ المَزارُ بِكُم عَنّي",38,"ن",2,0],["فَيا نيلُ أَنتَ الهَوى وَالحَياةُ","وَأَنتَ الأَميرُ وَأَنتَ الأَبُ",39,"ب",1,0],["فَيا نَفسِ إِنَّ الرِزقَ نَحوَكِ قاصِدٌ","فَلا تَتعَبي حَسبي مِنَ الرِزقِ أَتعابا",40,"ب",2,0],["فَيا نورَ عَيني لَو كَفَفتَ مِنَ البُكا","وَنادَيتَ مَن أَبكاكَ قامَ مِنَ القَبرِ",41,"ر",1,0],["في أُناسٍ تَعُدُّهُم مِن عَديدٍ","فَإِذا فُتِّشوا فَلَيسوا بِناسِ",42,"س",1,0],["فَيا نفحات الروض ضوعي ذكية","وَيا نسمات الصبح باردة هبّي",43,"ي",1,0],["في انتحابِ الرياح تعول في ال","وِديان إعوال قلبيَ المفؤودِ",44,"د",1,0],["فَيَا نَسَماتِ الْفَجْرِ أَدِّي تَحِيَّتِي","إِلَى ذَلِكَ الْبُرْجِ الْمُطِلِّ عَلَى النَّهْرِ",45,"ر",1,0],["في أُنْسها مَا يُجْلبُ الْسَ","رَّاءَ أَوْ يَنْفي الْكَمَدْ",46,"د",1,0],["فَيَا نُخْبَةَ السَّيِّدَاتِ اللَّوَا","تِي نَمَتْ مَجْدَهُنَّ أَعَزُّ الأُسَرْ",47,"ر",1,0],["فيا نُعْمُ وافاكِ النَّعِيمُ فأنعمِي","ويا جُمْلُ وَالاكِ الجمَالُ فَأَجْمِلِي",48,"ل",2,0],["فيا ناصر الإسلام دم في حلى العلا","وجارك في أمن وقطرك في سلم",49,"م",1,0],["فيا نجلَ مصرَ وفَتْ برَّةً","بذكراكَ \" مصرُ \" وأنتَ الأبَّر",50,"ر",1,0],["فيا نفسُ صبراً لستِ والله فاعلمني","بِأَوَّلِ نَفْسٍ غَابَ عَنْهَا حَبِيبُها",51,"ب",3,0],["في أن مَهرتُ كامخاً عقائلا","حواليَ الأجيادِ لا عواطلا",52,"ل",2,0],["فيا نفسي عن الشهوات كفيّ","فأنت عليك يا نفسي جنيْتِ",53,"ت",1,0],["فيا ناقليهم، لو تركتم رفاتهم","أقام يتيماً في حِراسة ِ لآلِ",54,"ل",1,0],["فيا نفحة البشرى من الله سرعة","ويا غارة الجبار من حيث لا ندري",55,"ي",1,0],["فيا نور عيشي أن في القلب ظلمةٌ","فلح لي فقد أدجى السماء مغيب",56,"ب",1,0],["فيا نكبةً في دَهْرِنا ما أجلَّها","وأعظمَ منها وهي جُلُّ العَظَائمِ",57,"م",1,0],["فيا نسلَ سلطان بن سيفِ بن مالك","فأنتَ أخُو علياءَ عالٍ صعودُها",58,"د",3,0],["فيا نبهاء القوم جدوا كتدرسٍ","فما للفتى من دون آدابهِ قدر",59,"ر",1,0],["فيا نائم الجفنين في حال يقظةٍ","وكم نائم معنى ولم يغشَهُ نومُ",60,"م",1,0],["في انسحابٍ مِثْل السَّحَاب وشَمْسِي","في فضائي مِثْل النجُوم تبسَّمْ",61,"م",1,0],["فيا نجل إسماعيل يامن نظيره","من الخلق لا يحويه شرق ولا غربُ",62,"ب",1,0],["فيا ناصر الإسلام يا من حلا العما","بآرائه والحق ابلج واضح",63,"ح",1,0],["فيا ناصر الإِسلام صبرا فانه","متى طاب طعم الصبر سرت عواقبه",64,"ب",2,0],["فيا ناهيا عن هتك عرض وغيبة","وما هو عنها للسان بقاصر",65,"ر",1,0],["فَيا نَحسُ سِر بُعداً وَسُحقاً وَلا تَجُز","بِداري مَدى الأَيّامِ أُمُّكَ هابِلُ",66,"ل",1,0],["فَيا نَفسهُ أَرَّخَتْ في الأَوجِ فَاِنعمي","وَيا قَبرهُ بَشرى بِخَيرِ نَزيلِ",67,"ل",1,0],["فيا نعمةَ اللهِ التي عَمَّت الوَرَى","فإنعامُها لم يُغْنِ عنه مَناب",68,"ب",1,0],["فيا نفس هذا أولُ العهدِ بالعُلَى","ويا حظّ هذا الوعدُ أنْ سأَسود",69,"د",1,0],["فيا نومي امتنعت عليّ حتّى","عصيت على المعاتب والشفيع",70,"ع",1,0],["في أَنَّ عِندَهُمُ وَاللَهُ فَضَّلَهُم","لِلحَمدِ سوقٌ وَلِلمَظلومِ مُنتَقِمُ",71,"م",1,0],["فيا نفس صبراً إن تَعِيشي تُظَفَّري","وإن متِّ وجداً كنتِ في الشهداءِ",72,"ا",2,0],["فيا نعمةً فاتت ويا محنةً أتت","فموتٌ على فَوتٍ وقتلٌ على كفرِ",73,"ر",1,0],["فَيا نائِيا وَالهوى ما نَأى","وَذِكراهُ في البالِ لا تَعزُب",74,"ب",1,0],["في انسكاب يغض من كبريائي","واضطراب يرتاع منه سكوني",75,"ن",2,0],["فيا نُزْهَةَ الأبْصَارِ سُميت نُزَهةً","لكيْ يُوضِحَ المَعْنى بَيانٌ وتَبْيينُ",76,"ن",1,0],["فَيا نَجمَ سَعدي الَّذي لا يَغيبُ","وَيا غَيثَ أَرضي الَّذي لا يَغِب",77,"ب",1,0],["فَيَا نَسِيماً مِنْ حِمَاهُمْ سَرَى","شَمِمْتُ عَرْفَ الْمِسْكِ مِنْ هَبَّتِهِ",78,"ت",2,0],["فَيَا نَهْرَ الْكِيتَانِ جَادَتْكَ دِيمَةٌ","مِنَ الْوَابِلِ الْهَتَّانِ غَيْرِ مُصَدَّعِ",79,"ع",1,0],["فيا نفس إن صحّت لك منه نسبةٌ","لخدمته بشراك أن كنت ناسبت",80,"ت",1,0],["فَيا نفس للاحسان عودى فربما","أقلت عثارا فابن آدم معثار",81,"ر",1,0],["فَيا نَهْرَ ثَوْرا قَدْ أَثَرْتَ مِنَ الْهَوى","دَفِيناً أَجَنَّتْهُ الْجَوانِحُ وَالصَّدْرُ",82,"ر",1,0],["فيا نظرةً عادتْ عَلى النفسِ حسرةً","وَأوردتْ بقلبي من محبَّتِها زَنْدا",83,"د",2,0],["في انبلاجِ الفجر من صدعِ الدجى","زَهَقَ الباطلُ وَالحقُ سما",84,"ا",1,0],["فيا نفحات اللَه يا عطفاته","ويا جذبات الحق جودي بزورة",85,"ه",1,0],["فيا نسيمات نجد إحملي خبراً","إلى الأحبة أما جزت في السحر",86,"ر",1,0],["فَيا نُصَحاءَ اللَهِ أَنتُم وُلاتُهُ","وَأَنتُم عَلى أَديانِهِ أُمَناءُ",87,"ا",2,0],["فيا نفس صبراً في مقيلك إنما","تحر ذراه بانقضاض القواعد",88,"د",1,0],["فَيا نَسمَةً يَحدو بِها الشَوق لِلحمى","خُذي خَبر الأَشجان عَنّي دُعا عينِ",89,"ن",1,0],["فيا نسمة مِن سَفحِ لُبنان طيبُها","يروّح روحَ الصَبّ مَهما تَنَسَّما",90,"م",2,0],["فَيا نَفس اِقطَعي صِلة التَداني","فَحَسبك لا تكيد وَلا تكاد