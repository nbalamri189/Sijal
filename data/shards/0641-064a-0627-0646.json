"أرى لهم نارا تلوح على علم","https://www.aldiwan.net/poem17265.html","الكامل"],[369,"أما فوقها إلا نجود وأنهم","https://www.aldiwan.net/poem17330.html","الطويل"],[369,"إذا أقفرت للعمر دار فبعدها","https://www.aldiwan.net/poem17777.html","الطويل"],[380,"سمعت بأذني رنة السهمِ في قلبي","https://www.aldiwan.net/poem66952.html","الطويل"],[406,"يا أيها البدر الذي بعلومه","https://www.aldiwan.net/poem33472.html","الكامل"],[406,"عساه يرضى المغضب","https://www.aldiwan.net/poem34160.html","مجزوء الرجز"],[415,"وقالوا لن تنأل الدهر فقر","https://www.aldiwan.net/poem36.html","الوافر"],[432,"باح الفؤاد بسر كنت أخفيه","https://www.aldiwan.net/poem41067.html","البسيط"],[435,"ما يقول الفقيه أبقاه ذو العر","https://www.aldiwan.net/poem12602.html","الخفيف"],[435,"أنجد الصب وغاروا","https://www.aldiwan.net/poem12645.html","مجزوء الرمل"],[435,"ثنت عنك يوم الرحيل العنانا","https://www.aldiwan.net/poem12741.html","المتقارب"],[440,"فؤاد عصاه صبره وهو طالبه","https://www.aldiwan.net/poem2577.html","الطويل"],[444,"لقد برك السهاد على عيوني","https://www.aldiwan.net/poem14390.html","الوافر"],[451,"حديث الحب","https://www.aldiwan.net/poem1016.html",""],[455,"أتاني كتاب الصديق العزيز","https://www.aldiwan.net/poem61796.html","المتقارب"],[460,"كالشمس من جمرة عبد شمس","https://www.aldiwan.net/poem56156.html","الرجز"],[460,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[466,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[466,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[466,"خليلي ما بال الكؤوس عواطلا","https://www.aldiwan.net/poem3524.html","عموديه"],[479,"لمن دمن بالرقمتين وأطلال","https://www.aldiwan.net/poem15250.html","الطويل"],[517,"إلى كم أحوك الشعر في الذم والمدح","https://www.aldiwan.net/poem12053.html","الطويل"],[546,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[553,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[560,"لقد أوقعت دعوى المحبة في البلا","https://www.aldiwan.net/poem33884.html","الطويل"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[577,"كم أعدمتني مشبها أو نظير","https://www.aldiwan.net/poem2723.html","السريع"],[577,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[577,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"]],"verses":[["فيأنس شجوي كل صب ومولهٍ","ويجزع وجدي ثاكلات وواجد",0,"د",1,0],["فيا نَقيبًا تحرَّى بالأهلَّةِ من","شهرِ المحرمِ عُرجونًا له وُلِدا",1,"د",2,0],["فَيا نَفسِ اِذهَبي أَسَفاً عَليهِم","فَبُعدُهُم كَموتِكَ أَن تَعيشي",2,"ش",2,0],["فَيا نازِلي رَملَ الحِمَى هَل لَدَيكُمُ","شِفاءٌ لِصَبٍّ داؤُهُ مِن طَبيبِهِ",3,"ب",2,0],["فَيا نَفْسُ صَبْراً إِنَّ لِلْهَمِّ فُرْجَةً","وَما لَكِ إَلّا العِزُّ عِنْدِي أَو القَبْرُ",4,"ر",1,0],["فيا نِضْوُ لا يَجْمَحْ بكَ الشّوقُ واصْطَبِرْ","قَليلاً وكَفْكِفْ منْ دُموعِكَ يا سَعْدُ",5,"د",1,0],["فَيا نَسَماتِ البانِ بِاللَهِ خَبِّري","عُبَيلَةَ عَن رَحلي بِأَيِّ المَواضِعِ",6,"ع",1,0],["فَيا نَفسُ صَبراً لَستِ وَاللَهِ فَاِعلَمي","بِأَوَّلِ نَفسٍ غابَ عَنها حَبيبُها",7,"ب",3,0],["فَيَا نَاصِرَ الإِسْلاَمِ دُمْ فِي حُلَى الْعُلَى","وَجَارُكَ فِي أَمْنٍ وَقُطْرُكَ فِي سِلْمِ",8,"م",1,0],["فَيا ناصِرَ المُستَضعَفينَ إِذا عَدا","عَلَيهِم زَمانٌ بِالعَداوَةِ مولَعُ",9,"ع",1,0],["فَيا نيلُ إِن لَم تَجرِ بَعدَ وَفاتِهِ","دَماً أَحمَراً لا كُنتَ يا نيلُ جارِيا",10,"ي",2,0],["فَيا نَفسُ إِن كُنتِ لا توقِنينَ","بِمَعقودِ أَمرِكِ فَاِستَيقِني",11,"ن",2,0],["فَيا نادِياً ضَمَّ أُنسَ النَديمِ","وَلَهوَ الكَريمِ وُقيتَ البِلى",12,"ا",1,0],["فَيَا نُخَباً هَبَّتْ تُجَدِّدُ مَجْدَهَا","وَتَأْتِي بِمَا لَمْ تَسْتَطِعْ قَبْلَهَا النُّخَبْ",13,"ب",1,0],["فَيا نَفسُ طيبي ثُمَّ يا نَفسُ أَبشِري","فَغَيرُ بَعيدٍ كُلُّ ما هُوَ آتِ",14,"ت",1,0],["فَيا نَفسُ ذِلّي بَعدَ مَيٍّ وَسامِحي","فَقَد سامَحَت مَيٌّ وَذَلَّ قَرينُها",15,"ن",3,0],["فَيا نَدَمَاً غَداةَ تَرَكتُ زَيدَاً","وَرائي لابنِ آمِنَةَ الأَمينِ",16,"ن",1,0],["فَيا نَفسُ مالاقَيتِ مِن لاعِجِ الهَوى","وَياقَلبُ ماجَرَّت عَلَيكَ النَواظِرُ",17,"ر",1,0],["في أن تكون الذي يتيه","من نعمةٍ كمن لؤما",18,"م",2,0],["في أَنفُسِ الناس وَأَلبابُهُم","وَفي بُطونِ السَيرِ الخالِدات",19,"ت",1,0],["فَيا نَسيمَ الصَبا أَنتَ الرَسولُ لَهُ","وَاللَهُ يَعلَمُ أَنّي مِنكَ غَيرانُ",20,"ن",1,0],["فَيا نَيسانُ ما أَبقَي","تَ في الفِعلِ لَتَمّوزِ",21,"ز",1,0],["فيا ندمائي الظلماء والشهب قبلها","أرى الجام مهتزا بها متوقدا",22,"د",2,0],["فَيا نَخلَةَ الرَملِ لَم تَبخَلي","وَلا قَصَّرَت نَخَلاتُ التُرَب",23,"ب",1,0],["فَيا ناقِليهِم لَو تَرَكتُم رُفاتَهُم","أَقامَ يَتيماً في حِراسَةِ لَئآلِ",24,"ل",1,0],["فَيا نَكَدَ الحُرِّ هَل تَنقَضي","وَيا فَرَحَ الحُرِّ هَل تَكمُلُ",25,"ل",1,0],["فيا نومُ لا تعمُرْ وِسادي ولا تَطُر","بمقلةِ مرهوم الإزارين بالقَطْرِ",26,"ر",1,0],["فَيا ناصِرَ الإِسلامِ لَو أَنَّ ناصِراً","يُرافِدُهُ في حِفظِهِ وَيُناوِبُه",27,"ب",2,0],["فيا نُوَبَ الخُطوبِ إليكِ عَنها","كفَاها ما أَلمَّ بها كفَاها",28,"ا",3,0],["في اناسِ مَن تَسهُلُ المَطالِبُ أَح","ياناً عَلَيهِ وَرُبَّما صَعُبَت",29,"ت",1,0],["فَيا نَفسُ خافي اللَهَ وَاجتَهِدي لَهُ","فَقَد فاتَتِ الأَيّامُ وَاقتَرَبَ الوَعدُ",30,"د",1,0],["فَيا نازِحاً يُدنيهِ حُسنُ اِدِّكارِهِ","فَفي بُعدِهِ قُربٌ وَفي قُربِهِ بُعدُ",31,"د",1,0],["فيا ندوة السمار هل من مسجل","يدوّن إعجاز القرائح منصفا",32,"ف",2,0],["فيا نجوم الليل لا نجم لي","ولا أرى لي أفقاً بعده",33,"ه",1,0],["في أناشيد تغنّى للبشر","ليس في الأحياء من يسمعنا",34,"ن",2,0],["فيا نارَ وجدي كيف عشتِ تضرّماً","بماءٍ من الأجفان للنّار قاتلِ",35,"ل",1,0],["فَيا نَظرَةً لا تَنظُرُ العَينُ أُختَها","إِلى الدارِ مِن رَملِ اللَوى المُتَقاوِدِ",36,"د",1,0],["فَيا نَدامَةَ نَفسي في المَعادِ إِذا","تَعَوَّذَ المَرءُ خَوفَ النُطقِ بِالبَكمِ",37,"م",1,0],["فَيَا نِعْمَ مَا وَلَّتْ بِهِ دَوْلَةُ الصِّبَا","وَلَمْ تَرْعَهُ مِنْ عَهْدِنَا الْمُتَقَادِمِ",38,"م",1,0],["فيا ناظراً في اللغزِ لو رمتَ كشفَهُ","رجعْتَ إلى القولِ الذي قالَهُ عمرْ",39,"ر",1,0],["فَيا نُعمُ قَلبي في الأَسارى إِلَيكُم","رَهينٌ وَقَد شَطَّ المَزارُ بِكُم عَنّي",40,"ن",2,0],["فَيا نيلُ أَنتَ الهَوى وَالحَياةُ","وَأَنتَ الأَميرُ وَأَنتَ الأَبُ",41,"ب",1,0],["فَيا نَفسِ إِنَّ الرِزقَ نَحوَكِ قاصِدٌ","فَلا تَتعَبي حَسبي مِنَ الرِزقِ أَتعابا",42,"ب",2,0],["فَيا نورَ عَيني لَو كَفَفتَ مِنَ البُكا","وَنادَيتَ مَن أَبكاكَ قامَ مِنَ القَبرِ",43,"ر",1,0],["في أُناسٍ تَعُدُّهُم مِن عَديدٍ","فَإِذا فُتِّشوا فَلَيسوا بِناسِ",44,"س",1,0],["فَيا نفحات الروض ضوعي ذكية","وَيا نسمات الصبح باردة هبّي",45,"ب",2,0],["في انتحابِ الرياح تعول في ال","وِديان إعوال قلبيَ المفؤودِ",46,"د",1,0],["فَيَا نَسَماتِ الْفَجْرِ أَدِّي تَحِيَّتِي","إِلَى ذَلِكَ الْبُرْجِ الْمُطِلِّ عَلَى النَّهْرِ",47,"ر",1,0],["في أُنْسها مَا يُجْلبُ الْسَ","رَّاءَ أَوْ يَنْفي الْكَمَدْ",48,"د",1,0],["فَيَا نُخْبَةَ السَّيِّدَاتِ اللَّوَا","تِي نَمَتْ مَجْدَهُنَّ أَعَزُّ الأُسَرْ",49,"ر",1,0],["فيا نُعْمُ وافاكِ النَّعِيمُ فأنعمِي","ويا جُمْلُ وَالاكِ الجمَالُ فَأَجْمِلِي",50,"ل",2,0],["فيا ناصر الإسلام دم في حلى العلا","وجارك في أمن وقطرك في سلم",51,"م",1,0],["فيا نجلَ مصرَ وفَتْ برَّةً","بذكراكَ \" مصرُ \" وأنتَ الأبَّر",52,"ر",1,0],["فيا نفسُ صبراً لستِ والله فاعلمني","بِأَوَّلِ نَفْسٍ غَابَ عَنْهَا حَبِيبُها",53,"ب",3,0],["في أن مَهرتُ كامخاً عقائلا","حواليَ الأجيادِ لا عواطلا",54,"ل",2,0],["فيا نفسي عن الشهوات كفيّ","فأنت عليك يا نفسي جنيْتِ",55,"ت",1,0],["فيا ناقليهم، لو تركتم رفاتهم","أقام يتيماً في حِراسة ِ لآلِ",56,"ل",1,0],["فيا نفحة البشرى من الله سرعة","ويا غارة الجبار من حيث لا ندري",57,"ي",1,0],["فيا نور عيشي أن في القلب ظلمةٌ","فلح لي فقد أدجى السماء مغيب",58,"ب",1,0],["فيا نكبةً في دَهْرِنا ما أجلَّها","وأعظمَ منها وهي جُلُّ العَظَائمِ",59,"م",1,0],["فيا نسلَ سلطان بن سيفِ بن مالك","فأنتَ أخُو علياءَ عالٍ صعودُها",60,"د",3,0],["فيا نبهاء القوم جدوا كتدرسٍ","فما للفتى من دون آدابهِ قدر",61,"ر",1,0],["فيا نائم الجفنين في حال يقظةٍ","وكم نائم معنى ولم يغشَهُ نومُ",62,"م",1,0],["في انسحابٍ مِثْل السَّحَاب وشَمْسِي","في فضائي مِثْل النجُوم تبسَّمْ",63,"م",1,0],["فيا نجل إسماعيل يامن نظيره","من الخلق لا يحويه شرق ولا غربُ",64,"ب",1,0],["فيا ناصر الإسلام يا من حلا العما","بآرائه والحق ابلج واضح",65,"ح",1,0],["فيا ناصر الإِسلام صبرا فانه","متى طاب طعم الصبر سرت عواقبه",66,"ب",2,0],["فيا ناهيا عن هتك عرض وغيبة","وما هو عنها للسان بقاصر",67,"ر",1,0],["فَيا نَحسُ سِر بُعداً وَسُحقاً وَلا تَجُز","بِداري مَدى الأَيّامِ أُمُّكَ هابِلُ",68,"ل",1,0],["فَيا نَفسهُ أَرَّخَتْ في الأَوجِ فَاِنعمي","وَيا قَبرهُ بَشرى بِخَيرِ نَزيلِ",69,"ل",1,0],["فيا نعمةَ اللهِ التي عَمَّت الوَرَى","فإنعامُها لم يُغْنِ عنه مَناب",70,"ب",1,0],["فيا نفس هذا أولُ العهدِ بالعُلَى","ويا حظّ هذا الوعدُ أنْ سأَسود",71,"د",1,0],["فيا نومي امتنعت عليّ حتّى","عصيت على المعاتب والشفيع",72,"ع",1,0],["في أَنَّ عِندَهُمُ وَاللَهُ فَضَّلَهُم","لِلحَمدِ سوقٌ وَلِلمَظلومِ مُنتَقِمُ",73,"م",1,0],["فيا نفس صبراً إن تَعِيشي تُظَفَّري","وإن متِّ وجداً كنتِ في الشهداءِ",74,"ا",2,0],["فيا نعمةً فاتت ويا محنةً أتت","فموتٌ على فَوتٍ وقتلٌ على كفرِ",75,"ر",1,0],["فَيا نائِيا وَالهوى ما نَأى","وَذِكراهُ في البالِ لا تَعزُب",76,"ب",1,0],["في انسكاب يغض من كبريائي","واضطراب يرتاع منه سكوني",77,"ن",2,0],["فيا نُزْهَةَ الأبْصَارِ سُميت نُزَهةً","لكيْ يُوضِحَ المَعْنى بَيانٌ وتَبْيينُ",78,"ن",1,0],["فَيا نَجمَ سَعدي الَّذي لا يَغيبُ","وَيا غَيثَ أَرضي الَّذي لا يَغِب",79,"ب",1,0],["فَيَا نَسِيماً مِنْ حِمَاهُمْ سَرَى","شَمِمْتُ عَرْفَ الْمِسْكِ مِنْ هَبَّتِهِ",80,"ت",2,0],["فَيَا نَهْرَ الْكِيتَانِ جَادَتْكَ دِيمَةٌ","مِنَ الْوَابِلِ الْهَتَّانِ غَيْرِ مُصَدَّعِ",81,"ع",1,0],["فيا نفس إن صحّت لك منه نسبةٌ","لخدمته بشراك أن كنت ناسبت",82,"ت",1,0],["فَيا نفس للاحسان عودى فربما","أقلت عثارا فابن آدم معثار",83,"ر",1,0],["فَيا نَهْرَ ثَوْرا قَدْ أَثَرْتَ مِنَ الْهَوى","دَفِيناً أَجَنَّتْهُ الْجَوانِحُ وَالصَّدْرُ",84,"ر",1,0],["فيا نظرةً عادتْ عَلى النفسِ حسرةً","وَأوردتْ بقلبي من محبَّتِها زَنْدا",85,"د",2,0],["في انبلاجِ الفجر من صدعِ الدجى","زَهَقَ الباطلُ وَالحقُ سما",86,"ا",1,0],["فيا نفحات اللَه يا عطفاته","ويا جذبات الحق جودي بزورة",87,"ه",1,0],["فيا نسيمات نجد إحملي خبراً","إلى الأحبة أما جزت في السحر",88,"ر",1,0],["فَيا نُصَحاءَ اللَهِ أَنتُم وُلاتُهُ","وَأَنتُم عَلى أَديانِهِ أُمَناءُ",89,"ا",2,0],["فيا نفس صبراً في مقيلك إن