{"poems":[[95,"تمضي وأنت مضنة الأوطان","https://www.aldiwan.net/poem11245.html","الكامل"],[87,"جبريل أنت هدى السماء","https://www.aldiwan.net/poem63729.html","مجزوء الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[354,"كم صرعت من أسد العرين","https://www.aldiwan.net/poem15976.html","الرجز"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101541","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63944","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46530","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27515","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106855","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137353",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137543",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94023","الرجز"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66485","الخفيف"],[3763,"","https://poetry.dctabudhabi.ae/diwan/poem/124149","السريع"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102956","الكامل"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35063","الكامل"],[5183,"بين العزاء والبكاء","https://www.poetsgate.com/ViewPoem.aspx?id=180220",""],[6056,"القناااع","https://www.poetsgate.com/ViewPoem.aspx?id=156703",""],[5190,"فاض الكيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78342&r=&rc=55",""]],"verses":[["أَلمِثْلِ مَا أَفْضَتْ إلَيْهِ حَالُكُمْ","يَا قَوْمُ مِنْ خُلْفٍ وَمِنْ خِذْلاَنِ",0,"ن",1,0],["المُثكِلونَ الموتِمو","نَ الهادِمونَ بِلا نِهايَه",1,"ا",3,0],["أَلِمِثلِ هَذا ذُقتَ في الدُنيا الطَوى","وَاِنشَقَّ مِن خَلَقٍ عَلَيكَ رِداءُ",2,"ا",2,0],["المُثرِياتُ مِن جَمالٍ وَحياً","الماطِلاتُ بِقَضا الدُيونِ",3,"ن",1,0],["ألمثل قلبيَ تتهمينَ بسلوةٍ","يا مَن لها عنت الرؤُوس سجودا",4,"د",2,0],["المثيبين مَنْ أَثابوا وإِنْ لم","يَستَثِبْ بالعِشارِ أو بالمخاض",5,"ض",1,0],["المثل القَديم","حَرره الحَكيم",6,"م",1,0],["المثلُ يعقلُ ما يحوي مماثلُه","في النفس من كلّ ما تعطى حقيقته",7,"ت",2,1],["ألمثل هذا جئتُ مسعفة","يا ليته ما قادني الحب",8,"ب",1,0],["ألمثل ذا فعل الملوك الصيد","أم أنت في تلك الصفات وحيد",9,"د",1,1],["المثل ما بي من تباريح الجفا","صنع الغرام بأهله وتصرفا",10,"ف",2,1],["المثنوي الذي به الصادي روى","تجري المنى في نظمه مجرى روي",11,"و",2,1],["ألمثلي كمثله معجزات","بدليل تأتي وغير دليل",12,"ل",1,0],["المثل السائر يا سيّدي","صنفت فيه الفلك الدائرا",13,"ر",2,1],["المثقب الزندين يوم سماحة","يحيى بها ويميت يوم جلاد",14,"د",1,0],["أَلِمثل هَذا قَد حَشَدتم جُندنا","وَلِمثل هَذا قدتم الأمراءَ",15,"ا",2,0],["المثقلين الأرض من نزق بها","لولاهم لتراقصت كالأحرف",16,"ف",1,0],["المثل يقول إذا طاح الفصيح ، فلا يصيح","وأنت ماسمى عليك بطيحتك أحد ٍ حضر",17,"ر",1,0],["المثلِ هذا الحدِّ جاوزتَ المدى","يا من سقيْتَ القدسَ الردى",18,"د",2,1]]}