https://www.poetsgate.com/ViewPoem.aspx?id=63509",""],[5589,"حريٌ بأن لا أكون السماء","https://www.poetsgate.com/ViewPoem.aspx?id=187986",""],[5596,"رد على خليل الجابري","https://www.poetsgate.com/ViewPoem.aspx?id=206719",""],[5596,"جامع الإمام الخليل بن شاذان","https://www.poetsgate.com/ViewPoem.aspx?id=206784",""],[5628,"عيناك مرفئي","https://www.poetsgate.com/ViewPoem.aspx?id=179812",""],[5688,"لكِ الرحمن يا قدسي","https://www.poetsgate.com/ViewPoem.aspx?id=214216",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6068,"مسكتْ بحدّ الخنجر -06-","https://www.poetsgate.com/ViewPoem.aspx?id=175933",""],[6069,"سرى طيف الأحبة من بعيد","https://www.poetsgate.com/ViewPoem.aspx?id=105657",""],[6185,"باختصار !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87029&r=&rc=15",""]],"verses":[["فَجَلا صَباحَ الشَّيْبِ حِينَ حَكى","لَيْلَ الشَّبيبَةِ ثَغْرُهُ الرَّتَلُ",0,"ل",1,0],["فَجَلَّتْ لِيَ النُّعْمَى بِمَا أَنْعَمَتْ بِهِ","عَلَيَّ فَحَيَّاهَا الإِلاَهُ وَحَيَّاكَا",1,"ك",2,0],["فَجُلنا جَولَةً ثُمَّ اِرعَوَينا","وَأَمكَنّا لِمَن شاءَ الجِلادا",2,"د",2,0],["فَجَلَّتْ وَهْيَ قَدْ قَلَّتْ عَدِيداً","عَلَى أَنَّ القَلِيلَ هُمُ الكِرَامُ",3,"م",1,0],["فجلاها في الروع راياتِ رأي","ونضاها صحائفاً كالصفاح",4,"ح",1,0],["فجلى الدجى واسْتوثق الدِّين واضحاً","وقام بنصر الله داعٍ مظفر",5,"ر",1,0],["فجلَوا عورةً لطرفٍ جَليٍّ","حَسِبوا شمسَه تَغَشَّت عَماءَ",6,"ا",2,0],["فجلَّ ذلك حتى","مثَّلْتُ قدرَك عندَهْ",7,"د",2,0],["فجلّ عن المظلوم كل ظلامةٍ","وقتْك نفوسُ الكاشحين المهالكا",8,"ك",2,0],["فجلتهم مثقّفاتٌ ظِماءٌ","تتقيها النُّحورُ بالإرغالِ",9,"ل",1,0],["فَجَلاهُ الحُبُّ عَنّي فَاِنجَلى","مِثلَما يَجلو سَنا الشَمسُ الدُجى",10,"ج",2,0],["فجلَّ لفقدان الوليّ مصابها","وباتت تناجي الهم والعين تهمل",11,"ل",1,0],["فجل الخطب واضطربت أمور","عييت بأن تكون لها نظاما",12,"م",2,0],["فَجَلسا يَوماً عَلى الخِوانِ","وَجيءَ في الأَكلِ بِباذِنجانِ",13,"ن",1,0],["فجلَّى شباباً كنتُ أخبِطُ ليلَهُ","سنا قمرٍ من جانب الغَوْرِ يطلُعُ",14,"ع",1,0],["فجلَّى بالسرورِ هُمومَ قلبي","وطاردَ بالنشاطِ بناتِ صدري",15,"ر",2,0],["فَجَلَّيْتَ مِنْ ظَلمائِه وهو حالِكٌ","ووَسَّعْتَ من أرْجائِهِ وهو ضَيِّقُ",16,"ق",1,0],["فجلوتَ ما لم يشهدوا ورسمت ما","لَم يعهدوا من معجز الأفكارِ",17,"ر",1,0],["فجلَّلَ بالسحر هذي الدُّنى","وصيَّرها جنة زاهره",18,"ر",2,0],["فَجَلَّلَ قَحطاً آلَ قَحطانَ وَاِنثَنَت","نِزارٌ بِمَنزورٍ مِنَ العَيشِ جاحِدِ",19,"د",1,0],["فَجَلا القِناعُ سَحابَةً مَشهورَةً","غَرّاءَ تُعشى الطَرفِ أَن يَتَأَمَّلا",20,"ل",2,0],["فَجَلَّلَها قَديمَ الأَثرِ عَضباً","يَصِلُّ بهِ الَحواجِبَ والَجبينا",21,"ن",2,0],["فجلوتها وهي الدجى","ورددتها بعد الجماح",22,"ح",1,0],["فجل في مجاري حكمه وشئونه","تبن لك فيها حكمة وبدايع",23,"ع",1,0],["فجلجلة الفخار لها سناء","واقلام الفتوح لها صرير",24,"ر",1,0],["فجلا منهج الطريق فقالوا","طلع الفجر واستنار النهار",25,"ر",1,0],["فجل كرماً بقبلة شمس خد","علي كأنها بلد حرام",26,"م",1,0],["فجلت غيهب العمى بجلال","قد غشاه الجمال بالأنوار",27,"ر",1,0],["فجلا ظلام الشرك وال","بهتان بالدد المديد",28,"د",1,0],["فجلَستِ في سجنِ الرَّجاء","نحوَ الأعالي تَنظُرِين",29,"ن",1,0],["فَجَليلُها مُتَعالَمٌ وَدَقيقُها","قَد أَلحَقَ العُلَماءَ بِالجُهّالِ",30,"ل",1,0],["فَجَلَّلَ الأُفقَ فَكُلُّ جانِبٍ","مِنها كَأَن مِن قطرِهِ المُزنُ حَيا",31,"ا",1,0],["فَجلّت بُنو ذُهلِ بن شَيبانَ هَمَّهُ","بِمَلمومَةٍ تُزجي العِتاقُ الشَوازِبا",32,"ب",2,0],["فجليتها عنهم برأي موفق","وقول سديد عن قريحة عالم",33,"م",1,0],["فَجلّى بنورِ الحقِّ ما كانَ مُظلِما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",34,"م",2,0],["فجليتَ عنها ما أدلهمَّ وأبرقتْ","أسارير كانتْ قبلَ ذلكَ تقطبُ",35,"ب",1,0],["فَجَلَّلتُها حَصى جَنادَةَ غَدرَةٍ","وَأَيقَنتُ ما أَندى حُلَيسا وَجابِرا",36,"ر",2,1],["فجل الورى الاك من ينكرونه","كما نكرت لطف القبول دبورها",37,"ر",3,0],["فجلُّستانُ أو بستانُ سَعدي","يشَوّقُني إِلى عهدٍ سعيد",38,"د",1,0],["فَجلّى في رِهان الفضل سَبقاً","وَجلّى عن سَماء الحقِّ دَجنا",39,"ن",2,0],["فَجَلا مِن كَأْسِها القَارَ كَمَا","شَقَّ نُورُ الصُّبْحِ جَيْبَ الظُلُماتِ",40,"ت",1,0],["فَجَلا اليَقينُ الظَنَّ عَن","هُ بِحَقِّهِ وَجَلا غُبارَه",41,"ر",2,0],["فَجَلا عَن ناظِري الكَوكَبِ وَالبَد","رِ وَالشَمسُ بِهِ كَشفُ الغُطَي",42,"ي",1,0],["فَجَلا لَيلَهُ سَنى فَرج اللَ","هِ وَخابَت مَقاصِد الأَشقِياءِ",43,"ا",2,0],["فجَلّيتَ ليلَ الخَطبِ عنّا بغُرّةٍ","غدَتْ تَقبِسُ الأبصارُ أَنوارَها قَبسا",44,"س",2,0],["فجليس الله من يذكره","هكذا عن ربه المختار قال",45,"ل",1,0],["فجُلُّ نارِ فؤادي","من جلّنار خدودِكْ",46,"ك",1,0],["فجلّى بأنوار الهدى كل ظلمة","وأطلع في الآفاق للدين أنجما",47,"م",2,0],["فَجلت لَهُ الأَيام بَعد عُبوسِها","وَجهاً كَوجهِكَ مُشرِقاً وَضّاحا",48,"ح",2,0],["فجَلَوْتَ من صَدَفِ المقاصِرِ دُرَّةً","حلَّيْتَ منها أَرْبُعاً وقُصُورا",49,"ر",2,0],["فجلّى سناه العدْوَتَيْنِ وَبَشَّرَتْ","خوافقُ راياتٍ لَهُ وَطبولُ",50,"ل",1,0],["فجلا لنا من كل فن سورة","حازت من الابداع كل نصيب",51,"ب",1,0],["فجلّلها نورُ الخمائِلِ بعْدَ ما","تَفتَّح فيها بالعشيّ كِمامُه",52,"م",2,0],["فجلجلت فيه فكاهاتهم","كأنهم باتوا فراعينا",53,"ن",2,0],["فجلَّلَ منكِبيك لباسَ فخرٍ","يدُلُّ على التناسب في الجلالِ",54,"ل",1,0],["فَجَلَّ عن الهجاء بذاك عندي","وقَلَّ بما أتاه عن العتابِ",55,"ب",1,0],["فجلاهُ مِن عُلْيا زُهيرِ فارسٌ","جمُّ الرمادِ بكل عامٍ مُصْرمِ",56,"م",1,0],["فجلا العجاج عنِ العراءِ بحملةٍ","لولا صَدوقُ طِعانها لم يُنْجِمِ",56,"م",1,0],["فجلوت كالدنيا في كف الكرى","والبدر تجلوه الدجنة درهما",57,"م",2,0],["فجلا ثراك الغفلَ في","حللِ تدلُّ على ثرايك",58,"ك",1,0],["فَجَلَدتُهُ بِدُموعِهِ","وَالحَدُّ يَلزَمُ مَن زَنى",59,"ن",2,0],["فَجَلتَها لَنا لُبابَةُ لَمّا","وَقَذَ النَومُ سائِرَ الحُراسِ",60,"س",1,1],["فجلست في حسن البسوط مفاخرا","في قبة تحت الأساطين ناجح",61,"ح",1,0],["فجلا ظلام الظلم عنها واكتست","أنوار صبح القول فيها صفاح",61,"ح",1,0],["فجلجلة الوحي في بيتنا","وأخذ الشريعة عن جدنا",62,"ن",2,0],["فجُلْتُ واللَّمعَةُ البيضاءُ تسبِقُني","أَنَّى ذهبْتُ وهذا بُرْءُ أَيُّوبي",63,"ب",2,0],["فجلودُهمْ ببنانِ كلِّ ممزِّقٍ","وعظامهمْ في ماضِغَيْ متعرِّقِ",64,"ق",1,0],["فجلست في قصري عليه وكان لي","قلب به ولكل قلب ما نوى",65,"و",2,0],["فجلسوا إليه حتى ينظروا","ماذا يرى في أمرهم ويأمر",66,"ر",1,0],["فجل عزيزاً ذا انتقام وغيرة","فسبحانه من قاهر ذي تفرد",67,"د",1,0],["فجليل فعلك واضح للعين في","مصر كما وضح النهار المشمس",68,"س",1,0],["فجليل فعلك في المواطن واضح","ولواء نصرك فوقنا معقود",69,"د",1,0],["فجل رجال هذا العصر قوم","أفاضل يعشقون الفضليات",70,"ت",1,0],["فجلا على الأبصار صورة يوسف","وتلا على الأسماع سورة مريم",71,"م",1,0],["فجلال عزك للجمال ولطفه","طوعاً لأرباب الصبابة قائد",72,"د",1,0],["فجلى الأغر وصلّى الكميت","وسلى فلم يذمم الأدهم",73,"م",1,0],["فَجَلَست وَاتجهت لِجبهتِه","وَرَأَت الذُباب فَوقَ جَبهَته",74,"ه",1,0],["فَجَلَسوا مَعاً بِشَطّ نَهر","بِساعَةٍ قَبلَ صَلاة الظُهر",75,"ر",1,0],["فجلجلت في سما الشهباء عاصفة","عرباء تحطم انصابا وأوثانا",76,"ن",2,0],["فَجَلاكَ في دارِ السَعادَةِ قائِلاً","خورشيد أَرّخ ناظِرٌ لِلمالِ",77,"ل",1,0],["فجلال أستاذي وقدس علومه","حالا فلم أظفر بأيّ منال",78,"ل",1,0],["فَجَل في نَفس العِقاب قَدره","كَذا ولي كُل مَن والاكا",79,"ك",2,0],["فَجَلَسوا في مَسجد وَسوق","وَمجمع النسك أَو الفسوق",80,"ق",1,0],["فجلوتُ فيه على الهموم وطوّفتْ","بابنِ المُنى بنتَ الكروم عروسا",81,"س",2,0],["فَجَلَسَ الشَّيخ قَريباً يَبكي","وَالضرب في أَضلاعِهِ وَالفَك",82,"ك",1,0],["فجَلَّلَ الأُفقَ فَكُلُّ جانِبِ","مِنها كَأن مِن قُطرِهِ المُزنُ حَبا",83,"ب",2,0],["فجلاله وجماله وكماله","شاهدته في الذات أم فعل الصفه",84,"ف",2,0],["فجلا برق مواضيهم دياجير الظلام","والعدى من بأسهم بين قتيل وطريد",85,"د",1,0],["فَجُلُّ مُنائِي أن تراكم نَواظِري","عسى يُدرِكُ المُشتاقُ ما يتمنَّاهُ",86,"ا",2,0],["فجلى عنه أوضار المعادي","وزحزح عنه ما قد كان ضاره",87,"ر",2,0],["فجلا أحمدُ كربي","فأنا أحمدُ أحمَد",88,"د",1,0],["فجلت عليَّ غزالةً","روحي بها تتغزل",89,"ل",1,0],["فجل من صاغه من نور رحمته","وصاغ من راحتيه الفوز والظفرا",90,"ر",2,0],["فجل من صاغه في ذات هيكله","وأبدع الحسن في ذرات صورته",91,"ه",1,0],["فجلا عن الحرمين من خبث ال","أطماع ما أشرى به الجهد",92,"د",1,0],["فَجَلَّلَتهُ بِعِزٍّ بَعدَ مَخمَلَةٍ","وَرَتَّبَتهُ مِنَ الإِفضالِ في الرُتَبِ",93,"ب",1,0],["فجلالة الصديق والخلفاء لم","تنقص فضيلة ال