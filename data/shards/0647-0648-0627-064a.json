{"poems":[[55,"أمن ذكر فار بالمصلى إلى منى","https://www.aldiwan.net/poem29947.html","الطويل"],[65,"سرى طيفها والملتقى متدان","https://www.aldiwan.net/poem46182.html","الطويل"],[79,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[75,"هواي وإن تناءت عنك داري","https://www.aldiwan.net/poem11962.html","الوافر"],[85,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[54,"أطلت وعذبتني يا عذول","https://www.aldiwan.net/poem26738.html","المتقارب"],[50,"نفر النوم واحتمى","https://www.aldiwan.net/poem65232.html","مجزوء الخفيف"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[119,"فؤادي بالركب اليماني مقيد","https://www.aldiwan.net/poem40873.html","عموديه"],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[154,"ألا فاشكروا نعمى الإله يزدكم","https://www.aldiwan.net/poem68580.html","الطويل"],[168,"هنيئا لعينك ورد الكرى","https://www.aldiwan.net/poem67852.html","المتقارب"],[181,"متى تكشفا عني القميص تبينا","https://www.aldiwan.net/poem4499.html","الطويل"],[185,"ألا هل من البين المفرق من بد","https://www.aldiwan.net/poem58877.html","الطويل"],[189,"هواى وعقلي فيك ضدان لم يزل","https://www.aldiwan.net/poem14598.html","الطويل"],[193,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[215,"مرت الأيام والروح الحزين","https://www.aldiwan.net/poem46613.html","الرمل"],[215,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[358,"هيجت أشجان صب للربوع هفا","https://www.aldiwan.net/poem40141.html","البسيط"],[358,"هواي سليم الود لا متشاعث","https://www.aldiwan.net/poem40551.html","الطويل"],[376,"هواي الذي أبدي واضمره يحيى","https://www.aldiwan.net/poem56924.html","الطويل"],[445,"دواليك من دهر يواليك بالنجح","https://www.aldiwan.net/poem34846.html","الطويل"],[471,"ألا يا صبا نجد لقد هجت من نجد","https://www.aldiwan.net/poem50438.html","الطويل"],[484,"هذا الابى التونسي","https://www.aldiwan.net/poem36965.html","مجزوء الكامل"],[580,"هواي لمحبوبي الأول","https://www.aldiwan.net/poem3036.html","المتقارب"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126672","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122820","الوافر"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67843","الطويل"],[973,"","https://poetry.dctabudhabi.ae/diwan/poem/206191","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62680","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1169,"","https://poetry.dctabudhabi.ae/diwan/poem/145288","السريع"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56583","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79987","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80002","الكامل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199812","المسحوب"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103468","الطويل"],[3054,"","https://poetry.dctabudhabi.ae/diwan/poem/124076","الطويل"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138748",""],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140007","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123932","الطويل"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35895","الخفيف"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101253","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205920","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103022","البسيط"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76500","الرمل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77006","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123487","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123516","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97097","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73262","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66185","الطويل"],[5121,"هَدِيَّتِي إِلَيْكَ","https://www.poetsgate.com/ViewPoem.aspx?id=209063",""],[5145,"أسير وقلبي في هواك أسير","https://www.poetsgate.com/ViewPoem.aspx?id=108064",""],[5194,"بحر الأسرار","https://www.poetsgate.com/ViewPoem.aspx?id=30631",""],[5310,"مِدَادُ الْقَلْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=211267",""],[5452,"هواك لها جهل","https://www.poetsgate.com/ViewPoem.aspx?id=112518",""],[5511,"خطاب لن يصل","https://www.poetsgate.com/ViewPoem.aspx?id=151403",""],[5518,"وسل القصائد/صباح الحكيم","https://www.poetsgate.com/ViewPoem.aspx?id=193963",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5758,"أَحْلَامٌ عَربيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=200513",""],[5758,"تراتيل الغيم","https://www.poetsgate.com/ViewPoem.aspx?id=207926",""],[5956,"جلادُ بيتي ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182553",""],[5956,"بدمع الذل","https://www.poetsgate.com/ViewPoem.aspx?id=185265",""],[5956,"ناجيتُ ناجي","https://www.poetsgate.com/ViewPoem.aspx?id=207203",""],[6008,"ياحيف والله","https://www.poetsgate.com/ViewPoem.aspx?id=60801",""],[6068,"ويَوْم لَا كَيَوْم أَحُلّ بُوحَي -08-","https://www.poetsgate.com/ViewPoem.aspx?id=175806",""],[6148,"أشواق القبة الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=202096",""]],"verses":[["هَوايَ يَمانٍ كَيفَ لا كَيفَ نَلتَقي","وَرَكبِيَ مُنقادُ القَرينَةِ مُعرِقُ",0,"ق",1,0],["هَوايَ لَعَمْري ما هَوِيْتَ وإنما","يُجاذِبُني رَيْبُ الزّمانِ عِناني",1,"ن",2,0],["هَوَايَ هُدىً فِيكَ أَهْتَدَيْتُ بِنُورِهِ","وَمُنْتَسَبِي لِلصَّحْبِ مِنْكَ نَسِيبُ",2,"ب",1,0],["هَوايَ وَإِن تَناءَت عَنكَ داري","كَمِثلِ هَوايَ في حالِ الجِوارِ",3,"ر",1,1],["هو آيةُ اللهِ التي أنوارُها","تجلو ظلامَ الشكِّ أيَّ جلاءِ",4,"ا",2,0],["هَوايَ هَوىً باطِنٌ ظاهِرٌ","قَديمٌ حَديثٌ لَطيفٌ جَليلُ",5,"ل",1,0],["هُوَ أَيضاً مِنَ الحَبي","بِ جَفاءً تَعَلَّما",6,"م",2,0],["هَوايَ لَهُ وَهَوَى قَلبِهِ","سِوايَ وَمَا ذاكَ بِالأَصوَبِ",7,"ب",1,0],["هواي مع الركب اليمانين مصعد","جنيب وجثماني بمكة موثق",8,"ق",1,0],["هو آية النصر العزيز","وغاية النصر المبين",9,"ن",1,0],["هَوايَ مَعَ الاَعذارِ لَثمُ تُرابِهِ","وَمِن أَينَ لي ذاكَ التُرابُ المُفَوَّهُ",10,"ه",1,0],["هَوائي رَقيبٌ عَلَيَّ فَما","يعطفُ قَلبي إِلّا عَلَيهِ",11,"ي",2,0],["هوايَ عراقيٌّ وتَثْني زِمامَها","لِبَرْقٍ إذا لاحَ النجومُ يَمانِ",12,"ن",1,0],["هوايَ أمامي ليس خلفي مُعَرِّجٌ","وشَوْقُ قَلوصي في الغُدُوِّ يَمانِ",12,"ن",1,0],["هَوَاىَ بِهذَا الغَورِ غَورِ تِهَامَةٍ","وَلَيسَ بِهَذا الحَيِّ مِن مُستوَى نَجدِ",13,"د",1,0],["هواىَ وعقلي فيك ضِدَّانِ لم يَزَلْ","عليكَ طوالَ الدهرِ بينَهما خُلْفُ",14,"ف",1,1],["هوايَ طيبةُ لا بيضاءُ عطبولُ","وَمُنيَتي عينُها الزرقاءُ لا النيلُ",15,"ل",1,1],["هوايَ لا تعرف الأقدار مصدره","إن الفتى الحر للأسرار كتّام",16,"م",1,0],["هوايَ ما أمره إني لأحسبه","طيفا تجود به في النوم أحلام",16,"م",1,0],["هواي هو الجمر الذي تعرفونه","وللجمر سلطان على الحجر الصلد",17,"د",1,0],["هَواي ما زالَ بِالآرام مؤتلفاً","وَالجسم ما زالَ بِالآلام مُختَلِفا",18,"ف",2,0],["هوايَ سَليم الودّ لا متشاعث","هوىً لا تُدانيهِ الظنون الخَبائثُ",19,"ث",1,1],["هَوايَ الَّذي أبدي واضمُره يَحيى","وسُؤليَ في دارِ الخلودِ وفي الدُّنيا",20,"ي",2,1],["هوائِمُ بِيضٌ لا يُصَدُّ بِهَا الرِّوى","وسُمْرٌ ظِماءٌ لا يُعَلَّلْنَ بالنَّشْحِ",21,"ح",1,0],["هَوايَ بِهَذا الغَورِ غَورِ تَهامَةٍ","وَلَيسَ بِهَذا الجَلسِ مِن مُستَوى نَجدِ",22,"د",1,0],["هو آية الآيات ير","كع للاله به ويسجد",23,"د",1,0],["هَوَايَ لمحبوبي الأَولِ","فقصِّر من العَذْلِ أَو طوِّلِ",24,"ل",1,1],["هو آيةُ اللّه المعظّم من سَما","شرفاً وفضلاً هامة الجوزاءِ",25,"ا",2,0],["هَوايَ لِغَيرِكُم لَعِبٌ وَلَهُوُ","وَأَيماني لَهُ كَذِبٌ وَلَغوُ",26,"و",1,1],["هَوَايَ لأَرْضٍ حَلَّ فِيهَا بِجِسْمِهِ","سَقى تُرْبَهَا مَاءُ الْحَيَاةِ وَحَيَّاهُ",27,"ه",1,0],["هواي ورائي والمسير خلافه","فقلبي إلى كرخٍ ووجهي إلى بلخ",28,"خ",1,0],["هَوايَ كالأول في عهده","لكنه ليس لهُ آخِرُ",29,"ر",1,0],["هواي يماني وحبي معرق","ووجدي نجدي وشوقي متهم",30,"م",1,0],["هواي في صهباء يسعى بها","ساق بما أهوى مليٌّ مليح",31,"ح",1,1],["هواي هوى لم يذخر الناس مثله","به طبت ما بين الكرام وطابا",32,"ب",2,0],["هو آيةُ الله التي","كست الهدى لألاءها",33,"ا",3,0],["هو آيةُ الله التي قد أبطلت","في العالمين عنادَ كلِّ جحود",34,"د",1,0],["هوايته لا مهار من سبّق الخيل","والسّبق والنّاموس للضمّر القود",35,"د",1,0],["هواي وعقلي فيك ضِدّان لم يزل","عليك طول الدهر بينهما خلفُ",36,"ف",1,1],["هواي بأم المؤمنين يزيد","على إذا قلت استحال مزيد",37,"د",1,1],["هواي رضاكم إن تفرقت الأهوا","ودائي جفاكم إن تنوعت الأدوا",38,"و",2,1],["هوائج أشواقي ركائبُ باكرتْ","إلى جدث بعد الحياة حواه",39,"و",3,0],["هوائمُ من حرِّ الهجير فلا ترى","سوى رمضٍ تشوي الرمال شواه",39,"و",3,0],["هواي إلى مصر ألا هذه مصر","أعود الرجا ذا ووعود الهوى نضر",40,"ر",1,1],["هُوَ أَيضاً مِن هاشِمٍ غَيرَ أَلّا","يَستَوي حَبلُ قُنَّبٍ وَشَريطُ",41,"ط",1,0],["هوايَ في ذلك الوجه المليح حكى","هوى أبي طالب في سيّد الامم",42,"م",1,0],["هو أيضًا قد طوى ليل الردى","وطوى ليل الغواشي والكِذَاب",43,"ب",1,0],["هوائج يسلسل الملك الجموح بها","كأنهن لخيل النصر أرسان",44,"ن",1,0],["هُوَ آيات الهنا هُوَ الَّذي","ما له مَهما سعينا من أَرف",45,"ف",1,0],["هَوايَ زباري وَلَستُ بِكاتِم","هَوايَ وَلا مَضغ للاح وَعائِب",46,"ب",1,0],["هواى وشيطان ونفس تميل مع","مرادهما والقلب معها دلاهث",47,"ث",1,0],["هواى وشيطانى ونفسى وقلبى","المقلب حزبا لا أطيق له لقا",48,"ق",2,0],["هو آية أوصافها جلت عن","الإحصاء بل عزت عن التبيين",49,"ن",1,0],["هَوايَ ما إِن يُرامُ فيكُم","كَلاّ ووجدي فَما يريم",50,"م",1,0],["هَوايَ عَلَى غِيدِ المَعالي وَقَفْتُهُ","وذلِكَ دابي مُنْذُ زالَتْ تَماامي",51,"م",2,0],["هِوَايَتِي ظَلَّتْ عَلَىْ صَفْحَةٍ","وَمَرْسَمِي بِهَا كَمَا الْمَتْحَفِ",52,"ف",1,0],["هواي ورائي والمسير خلافه","لشتان ما شئنا هوى ومسير",53,"ر",1,0],["هوايتي نظم القصايد والأشعار","ما في قوافيها مسمى وظيفه",54,"ف",2,1],["هَوَاي يَقُدُّ الْبُعْدَ يَسْتَبِقُ الْمَدَى","إِلَيْكِ فَلَا بعْدٌ يُرَامُ؛ وَلَا صَبْرُ",55,"ر",1,0],["هواي لها جهل وهجري لها جهلُ","وأنّى لنا في مثل فاتنتي عقلُ",56,"ل",1,1],["هواي بلاد.. لم تعانق قصائدي","يمر (عبيري) بالدُّجَى يتعثر",57,"ر",1,0],["هو آية الرحمن سرّ بيانه","لغة تحيرَ في تهجدِها الصفا",58,"ف",2,0],["هواي الوفا والحق والصدق مطلبي","ولو الفنا منهال تاتي سبايبه",59,"ب",2,0],["هَوايَ يَمانيٌّ بسدِّ مَآربي","أُوَحِّدُ في عيْنَيْكِ وَجْهًا بَكِيَّا",60,"ي",2,0],["هُوَ آيَةُ الأَكْوانِ ، مُذْ شَقَّ المَلَا","كُ فَمَ المَدَى ،وَمَضَى يُضَمِّدُ نُورَا",61,"ر",2,0],["هوايته الأوامرُ مثل مفتي ‏‎","وينشط دائما ليديم كبتي‎",62,"ت",2,0],["هواي هو الهوان لغىً","ومضمونا ومنحرفُ",63,"ف",1,0],["هو آية اليُسرَى لكل منافعٍ","للناسِ مفطورٌ على التيسيرِ",64,"ر",1,0],["هواي باللي مركبه جايز لي","ولاقيل بأن محركه يصرف زيوت",65,"ت",1,0],["هواي الْغَادِيَاتُ بِكُلّ حُسْن","وأَحَباب بِتَدْمُرَ مستقرّي",66,"ر",2,0],["هَوَايَ طبيْبي وخيرُ الوَرَى","وأسْعَدُ نوْرٍ سَعَى بالقدَم",67,"م",1,0]]}