{"poems":[[53,"ألا ليت أذيال الغيوث السواجم","https://www.aldiwan.net/poem29766.html","الطويل"],[77,"سعودك لا ما تدعيه الكواكب","https://www.aldiwan.net/poem36771.html","الطويل"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[73,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[93,"عاش هذا الفتى محبا شقيا","https://www.aldiwan.net/poem11096.html","الخفيف"],[54,"سيبكي البم من جزع عليه","https://www.aldiwan.net/poem27458.html","الوافر"],[88,"يا قوم لا تتكلموا","https://www.aldiwan.net/poem44818.html","مجزوء الكامل"],[27,"بان الخليط فعينه لا تهجع","https://www.aldiwan.net/poem5801.html","الكامل"],[32,"أبثين إنك قد ملكت فأسجحي","https://www.aldiwan.net/poem27808.html","الكامل"],[85,"قلب يذوب ومدمع يجري","https://www.aldiwan.net/poem63661.html","أحذ الكامل"],[85,"هنيئا أمير المؤمنين فإنما","https://www.aldiwan.net/poem63777.html","الطويل"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[48,"مرحبا يا سمي من كلم الله","https://www.aldiwan.net/poem10813.html","الخفيف"],[46,"قفي وقفة تعلمي","https://www.aldiwan.net/poem23423.html","مجزوء المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54532","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[77,"حديثٌ على رغم العلا غيرُ كاذبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33316",""],[98,"مؤتمر الجماد","https://www.poetsgate.com/ViewPoem.aspx?id=55343",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[54,"سيبكي البمُّ منْ جزعٍ عليهِ","https://www.poetsgate.com/ViewPoem.aspx?id=14504",""]],"verses":[["وَتَثبُتُ في عَليا مَعَدٍّ غُصونُهُم","ثَباتَ بَنانٍ في قُلوبِ البَراجِمِ",0,"م",1,0],["وَتُثْنِي بِعَلْيَاكَ الَّركَائِبُ في السُّرىَ","وَلَوْ سَكَتُوا أثْنَتْ عَلَيْكَ الْحَقَائِبُ",1,"ب",1,0],["وَتُثيبُ أَحياناً فَتُط","مِعُ ثُمَّ تُدرِكُها الغَرارَه",2,"ر",2,0],["وَتَثَنَّت بِعِطفِهِ إِذ تَهادى","خَطرَةٌ تَمزُجُ الدَلالَ بِكِبرِ",3,"ر",1,0],["وَتُثِيرِي مِنْ رُوحِهِ نَسَمَاتٍ","وَتُفِيحِي مِنْهَا عَبِيراً ذَكِيَّا",4,"ي",2,0],["وَتَثكِلُهُ القِيانُ وَحافِظوها","وَتَنعاهُ الزِقاقُ إِلى الدِنانِ",5,"ن",1,0],["وتَثّبتُّوا في جهلكم","فالشرّ أن تتعلَموا",6,"م",3,0],["وَتُثيرُ مُظهِرَةً وَقَد وَقَدَ الحَصى","شاةَ الكِناسِ إِذا اِسمَأَلَّ التُبَّعُ",7,"ع",1,0],["وَتَثاقَلَت لَمّا رَأَت كَلَفي بِها","أَحبِب إِلَيَّ بِذاكَ مِن مُتَثاقِلِ",8,"ل",1,0],["وَتَثورُ فَهوَ عَلى الغُصونِ يَدٌ","عَلِقَت أَنامِلُها مِنَ الجَمرِ",9,"ر",1,0],["وَتُثني مِنَ الجَرحى عَلَيكَ جِراحُهُم","وَتَأتي مِنَ القَتلى لَكَ الدَعَواتُ",10,"ت",1,0],["وَتُثني عَلى مُزجي الجُيوشِ بِيَلدِزٍ","وَمُلهِمِها فيما تَنالُ وَتَكسِبُ",11,"ب",1,0],["وَتُثيرُ الخِيامُ آسادَ هَيجا","ءَ تَراها آسادَها الهَيجاءُ",12,"ا",2,0],["وَتَثَنّى مُوَلِّياً كَهِلالٍ","فَوقَ غُصنٍ يَجُرُّ دِعصاً كَثيبا",13,"ب",2,0],["وَتَثنيكَ في راحَةٍ","كَأَنَّكَ لَم تُؤلَمِ",14,"م",1,0],["وَتَثَاقَلَتْ أَشْبَاهُهمْ وتَخَفَّفَتْ","أَرْوَاحُهُمْ مِنْ نَشْوَةِ الصَّهْبَاءِ",15,"ا",2,0],["وَتَثْوِي المُرُوءَةُ فِي دَارِهِمْ","وَتَرْضَى المُرُوءَةُ أَن تُذْكَرَا",16,"ر",2,0],["وتُثِيرُ الحروبَ شَعْواءَ جهْلاً","وتدُسُّ الوَئيدَ إِثْرَ الوَئيدِ",17,"د",1,0],["وتثني لعلياكَ الرّكائب في السُّرى","ولو سكتوا أثنَتْ عليك الحقائب",18,"ب",1,0],["وتثنيني نسيمات الصبا","ويسليني غناء البلبل",19,"ل",1,0],["وتُثيرُ فيه الذكرياتُ شجاً","يَعيا به فيَخُورُ أيِّده",20,"د",2,0],["وَتَثكلُهُ القِيانُ وحافِظُوهَا","ويَنعاهُ الزِّقاقُ إِلى الدِّنانِ",21,"ن",1,0]]}