{"poems":[[53,"ألا ليت أذيال الغيوث السواجم","https://www.aldiwan.net/poem29766.html","الطويل"],[77,"سعودك لا ما تدعيه الكواكب","https://www.aldiwan.net/poem36771.html","الطويل"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[73,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[93,"عاش هذا الفتى محبا شقيا","https://www.aldiwan.net/poem11096.html","الخفيف"],[54,"سيبكي البم من جزع عليه","https://www.aldiwan.net/poem27458.html","الوافر"],[88,"يا قوم لا تتكلموا","https://www.aldiwan.net/poem44818.html","مجزوء الكامل"],[27,"بان الخليط فعينه لا تهجع","https://www.aldiwan.net/poem5801.html","الكامل"],[32,"أبثين إنك قد ملكت فأسجحي","https://www.aldiwan.net/poem27808.html","الكامل"],[85,"قلب يذوب ومدمع يجري","https://www.aldiwan.net/poem63661.html","أحذ الكامل"],[85,"هنيئا أمير المؤمنين فإنما","https://www.aldiwan.net/poem63777.html","الطويل"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[48,"مرحبا يا سمي من كلم الله","https://www.aldiwan.net/poem10813.html","الخفيف"],[46,"قفي وقفة تعلمي","https://www.aldiwan.net/poem23423.html","مجزوء المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54532","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[77,"حديثٌ على رغم العلا غيرُ كاذبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33316",""],[98,"مؤتمر الجماد","https://www.poetsgate.com/ViewPoem.aspx?id=55343",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[54,"سيبكي البمُّ منْ جزعٍ عليهِ","https://www.poetsgate.com/ViewPoem.aspx?id=14504",""],[132,"فت بين الرباب في العين صابا","https://www.aldiwan.net/poem54893.html","الطويل"],[197,"بأبي وأمي من مددت لها يدي","https://www.aldiwan.net/poem39903.html","الكامل"],[221,"بعد أن طال في هواه صدودي","https://www.aldiwan.net/poem55280.html","الخفيف"],[222,"روح الروح واسقني بمدام","https://www.aldiwan.net/poem55471.html","الخفيف"],[235,"أتجزع للفراق وهم جوار","https://www.aldiwan.net/poem31988.html","الوافر"],[270,"شجاني من دجى ليلي سكون","https://www.aldiwan.net/poem35204.html","الوافر"],[270,"أغنى التقى عن برقع وخباء","https://www.aldiwan.net/poem35588.html","الكامل"],[275,"تناضل عن دين الهدى وتدافع","https://www.aldiwan.net/poem25485.html","الطويل"],[304,"يا ربنا يا ربنا","https://www.aldiwan.net/poem16747.html","مجزوء الكامل"],[305,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[377,"لقد ضل من قد حاد عن مورد الكشف","https://www.aldiwan.net/poem59322.html","الطويل"],[397,"عاش هذا الفتى محبا شقيا","https://www.aldiwan.net/poem10960.html","عموديه"],[439,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[458,"أقريش لا فلم أراك ولا يد","https://www.aldiwan.net/poem56235.html","الكامل"],[461,"تأرج عرض الدهر من نشر منطقي","https://www.aldiwan.net/poem16146.html","الطويل"],[470,"سرى ذا الهم بل طرقا","https://www.aldiwan.net/poem4770.html","مجزوء الوافر"],[551,"أضنا بالتواصل والتصافي","https://www.aldiwan.net/poem47391.html","الوافر"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[558,"أطلق الكاس بعد طول احتباس","https://www.aldiwan.net/poem34439.html","الخفيف"],[558,"من لصب متيم ملتاح","https://www.aldiwan.net/poem34681.html","الخفيف"],[562,"أخاف إذا أشار براحتيه","https://www.aldiwan.net/poem52973.html","الوافر"],[567,"طلعت كالقمر التم بدر","https://www.aldiwan.net/poem69676.html","الرمل"]],"verses":[["وَتَثبُتُ في عَليا مَعَدٍّ غُصونُهُم","ثَباتَ بَنانٍ في قُلوبِ البَراجِمِ",0,"م",1,0],["وَتُثْنِي بِعَلْيَاكَ الَّركَائِبُ في السُّرىَ","وَلَوْ سَكَتُوا أثْنَتْ عَلَيْكَ الْحَقَائِبُ",1,"ب",1,0],["وَتُثيبُ أَحياناً فَتُط","مِعُ ثُمَّ تُدرِكُها الغَرارَه",2,"ر",2,0],["وَتَثَنَّت بِعِطفِهِ إِذ تَهادى","خَطرَةٌ تَمزُجُ الدَلالَ بِكِبرِ",3,"ر",1,0],["وَتُثِيرِي مِنْ رُوحِهِ نَسَمَاتٍ","وَتُفِيحِي مِنْهَا عَبِيراً ذَكِيَّا",4,"ي",2,0],["وَتَثكِلُهُ القِيانُ وَحافِظوها","وَتَنعاهُ الزِقاقُ إِلى الدِنانِ",5,"ن",1,0],["وتَثّبتُّوا في جهلكم","فالشرّ أن تتعلَموا",6,"م",3,0],["وَتُثيرُ مُظهِرَةً وَقَد وَقَدَ الحَصى","شاةَ الكِناسِ إِذا اِسمَأَلَّ التُبَّعُ",7,"ع",1,0],["وَتَثاقَلَت لَمّا رَأَت كَلَفي بِها","أَحبِب إِلَيَّ بِذاكَ مِن مُتَثاقِلِ",8,"ل",1,0],["وَتَثورُ فَهوَ عَلى الغُصونِ يَدٌ","عَلِقَت أَنامِلُها مِنَ الجَمرِ",9,"ر",1,0],["وَتُثني مِنَ الجَرحى عَلَيكَ جِراحُهُم","وَتَأتي مِنَ القَتلى لَكَ الدَعَواتُ",10,"ت",1,0],["وَتُثني عَلى مُزجي الجُيوشِ بِيَلدِزٍ","وَمُلهِمِها فيما تَنالُ وَتَكسِبُ",11,"ب",1,0],["وَتُثيرُ الخِيامُ آسادَ هَيجا","ءَ تَراها آسادَها الهَيجاءُ",12,"ا",2,0],["وَتَثَنّى مُوَلِّياً كَهِلالٍ","فَوقَ غُصنٍ يَجُرُّ دِعصاً كَثيبا",13,"ب",2,0],["وَتَثنيكَ في راحَةٍ","كَأَنَّكَ لَم تُؤلَمِ",14,"م",1,0],["وَتَثَاقَلَتْ أَشْبَاهُهمْ وتَخَفَّفَتْ","أَرْوَاحُهُمْ مِنْ نَشْوَةِ الصَّهْبَاءِ",15,"ا",2,0],["وَتَثْوِي المُرُوءَةُ فِي دَارِهِمْ","وَتَرْضَى المُرُوءَةُ أَن تُذْكَرَا",16,"ر",2,0],["وتُثِيرُ الحروبَ شَعْواءَ جهْلاً","وتدُسُّ الوَئيدَ إِثْرَ الوَئيدِ",17,"د",1,0],["وتثني لعلياكَ الرّكائب في السُّرى","ولو سكتوا أثنَتْ عليك الحقائب",18,"ب",1,0],["وتثنيني نسيمات الصبا","ويسليني غناء البلبل",19,"ل",1,0],["وتُثيرُ فيه الذكرياتُ شجاً","يَعيا به فيَخُورُ أيِّده",20,"د",2,0],["وَتَثكلُهُ القِيانُ وحافِظُوهَا","ويَنعاهُ الزِّقاقُ إِلى الدِّنانِ",21,"ن",1,0],["وتُثيرُ الغرامَ للراهبِ الأش","مَطِ حتى يَرَى التَّرَهُّبَ عَابَا",22,"ب",2,0],["وتثيرُ في أغوارها ميتَ الهوى","لتعيشَ في نور الإله وتهتدي",23,"ي",1,0],["وتثنى كالمستجير من اللو","عة أو ضم قده الأملود",24,"د",1,0],["وتثنى فما ثنيت عنان النف","س حتى دانت لسمر القوام",25,"م",1,0],["وَتَثبُتُ في أَكُفِّهِمُ العَوالي","وَتَزلُقُ فَوقَها البِدرُ النِضارُ",26,"ر",1,0],["وتثنيهِ الغصونُ إذا تثنّت","وتحملهُ النسورُ أو السنونو",27,"ن",2,0],["وتُثيرُ فيهم همَّةً مَدفونةً","فالبَحرُ يُخشى بعدَ طولِ صَفاء",28,"ا",2,0],["وتَثْبتُ يَوْمَ الرَّوْعِ في حَوْمَةِ الوَغَى","كَأنَّكَ ثَهْلانٌ بِها أَوْ مُتَالِعُ",29,"ع",1,0],["وَتَثبِطُ المُتَشَكِّكو","نَ وَكَأَنَّهُ لَيسوا هُنا",30,"ن",2,0],["وَتُثني إِذا تُصغي لِوسواسِ حَليها","عَمودُ صباحٍ بالثريّا صغى قرطا",31,"ط",2,0],["وتثلب أقواماً شنَوهُ لجهلهم","به وهو مخفيٌّ وناهيك من مخفي",32,"ف",2,0],["وتثيري من روحه نسمات","وتفيحي منها عبيرا ذآيا",33,"ي",2,0],["وتُثْمِرُ من طَعْمِهِنَّ الغصونُ","وتُغدِقُ فِي سَقْيِهِنَّ الأَرُومُ",34,"م",1,0],["وتُثير عارمةُ الرياح سحابتي","من مُبرِقٍ في فضلِ وصفك مُرعِدِ",35,"د",1,0],["وتُثْني عِتاقُ الطير صبحاً بفضله","إذا جُثَثُ الأبطال أضحتْ تميرُها",36,"ر",3,0],["وَتُثقِلُها عَجيزَتُها","إِذا وَلَّت لِتَنطَلِقا",37,"ق",2,0],["وتثنِي عِطْفَك المزوَرَّ عنّي","وَما لِسواك حظٌّ في اِنعطافي",38,"ي",1,0],["وتثليث هذا الغسل شكل مثلث","به ظهرت ممن براه صنائع",39,"ع",1,0],["وتثنت سقاتها كغصون","بعيون سبت ظباء الكناس",40,"س",1,0],["وتثنت تيهاً وقد ألبستني","ثوبها وهو موذن بافتضاحي",41,"ي",1,0],["وتُثنِي المكرُماتُ عليهِ ممَّا","يُعظّمُها وتَحمَدُ أَصغَرَيهِ",42,"ي",2,0],["وَتَثَنَّتْ كَتَثَنِّي الغُصْنِ فِي","يَوْمه رِيْحٍ وَغَمَامٍ وَمَطَرْ",43,"ر",1,0]]}