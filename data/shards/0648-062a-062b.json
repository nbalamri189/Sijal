oetsgate.com/ViewPoem.aspx?id=155302",""],[5464,"حكاية في ليل بهيّ","https://www.poetsgate.com/ViewPoem.aspx?id=27916",""],[5542,"لغة الحجارة","https://www.poetsgate.com/ViewPoem.aspx?id=10192",""],[5573,"اتعبني التقسيم والطرح والضرب","https://www.poetsgate.com/ViewPoem.aspx?id=200090",""],[5582,"أَمِنْ بارِقٍ أَعْلَى الأُبَيْرِقِ يُلْمَحُ","https://www.poetsgate.com/ViewPoem.aspx?id=186780",""],[5650,"اعتذارٌ جديدٌ لخجلِ الخيول!","https://www.poetsgate.com/ViewPoem.aspx?id=134786",""],[5691,"تناقضات","https://www.poetsgate.com/ViewPoem.aspx?id=206156",""],[3216,"المنسي","https://www.poetsgate.com/ViewPoem.aspx?id=28890",""],[402,"كانوا ثمانية من الندماء","https://www.poetsgate.com/ViewPoem.aspx?id=35048",""],[5830,"يا وهم مالي ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=201912",""],[5881,"أيقظت جذوتها","https://www.poetsgate.com/ViewPoem.aspx?id=183803",""],[5956,"الحب العاقرُ","https://www.poetsgate.com/ViewPoem.aspx?id=182020",""],[5956,"وتثور نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=182639",""],[5997,"طيرٌ ذبيحٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215430",""],[6031,"أَبا هَاشمٍ أُنهِي إليكَ تحيةً","https://www.poetsgate.com/ViewPoem.aspx?id=46265",""],[6093,"قصيدة تمشي","https://www.poetsgate.com/ViewPoem.aspx?id=197547",""],[6093,"حِيَلُ الطَّرِيقِ","https://www.poetsgate.com/ViewPoem.aspx?id=207120",""],[6097,"دموع دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=190673",""],[6097,"فيحاءُ تبكي","https://www.poetsgate.com/ViewPoem.aspx?id=190695",""],[6102,"طيب","https://www.poetsgate.com/ViewPoem.aspx?id=184439",""],[6117,"متاهةُ حُلم","https://www.poetsgate.com/ViewPoem.aspx?id=182783",""],[5190,"حكايتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78304&r=&rc=17",""],[572,"طَلَعَتْ كالقَمَرِ التّمَّ بَدَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9270&r=&rc=127",""]],"verses":[["وَتَثبُتُ في عَليا مَعَدٍّ غُصونُهُم","ثَباتَ بَنانٍ في قُلوبِ البَراجِمِ",0,"م",1,0],["وَتُثْنِي بِعَلْيَاكَ الَّركَائِبُ في السُّرىَ","وَلَوْ سَكَتُوا أثْنَتْ عَلَيْكَ الْحَقَائِبُ",1,"ب",1,0],["وَتُثيبُ أَحياناً فَتُط","مِعُ ثُمَّ تُدرِكُها الغَرارَه",2,"ر",2,0],["وَتَثَنَّت بِعِطفِهِ إِذ تَهادى","خَطرَةٌ تَمزُجُ الدَلالَ بِكِبرِ",3,"ر",1,0],["وَتُثِيرِي مِنْ رُوحِهِ نَسَمَاتٍ","وَتُفِيحِي مِنْهَا عَبِيراً ذَكِيَّا",4,"ي",2,0],["وَتَثكِلُهُ القِيانُ وَحافِظوها","وَتَنعاهُ الزِقاقُ إِلى الدِنانِ",5,"ن",1,0],["وتَثّبتُّوا في جهلكم","فالشرّ أن تتعلَموا",6,"م",3,0],["وَتُثيرُ مُظهِرَةً وَقَد وَقَدَ الحَصى","شاةَ الكِناسِ إِذا اِسمَأَلَّ التُبَّعُ",7,"ع",1,0],["وَتَثاقَلَت لَمّا رَأَت كَلَفي بِها","أَحبِب إِلَيَّ بِذاكَ مِن مُتَثاقِلِ",8,"ل",1,0],["وَتَثورُ فَهوَ عَلى الغُصونِ يَدٌ","عَلِقَت أَنامِلُها مِنَ الجَمرِ",9,"ر",1,0],["وَتُثني مِنَ الجَرحى عَلَيكَ جِراحُهُم","وَتَأتي مِنَ القَتلى لَكَ الدَعَواتُ",10,"ت",1,0],["وَتُثني عَلى مُزجي الجُيوشِ بِيَلدِزٍ","وَمُلهِمِها فيما تَنالُ وَتَكسِبُ",11,"ب",1,0],["وَتُثيرُ الخِيامُ آسادَ هَيجا","ءَ تَراها آسادَها الهَيجاءُ",12,"ا",2,0],["وَتَثَنّى مُوَلِّياً كَهِلالٍ","فَوقَ غُصنٍ يَجُرُّ دِعصاً كَثيبا",13,"ب",2,0],["وَتَثنيكَ في راحَةٍ","كَأَنَّكَ لَم تُؤلَمِ",14,"م",1,0],["وَتَثَاقَلَتْ أَشْبَاهُهمْ وتَخَفَّفَتْ","أَرْوَاحُهُمْ مِنْ نَشْوَةِ الصَّهْبَاءِ",15,"ا",2,0],["وَتَثْوِي المُرُوءَةُ فِي دَارِهِمْ","وَتَرْضَى المُرُوءَةُ أَن تُذْكَرَا",16,"ر",2,0],["وتُثِيرُ الحروبَ شَعْواءَ جهْلاً","وتدُسُّ الوَئيدَ إِثْرَ الوَئيدِ",17,"د",1,0],["وتثني لعلياكَ الرّكائب في السُّرى","ولو سكتوا أثنَتْ عليك الحقائب",18,"ب",1,0],["وتثنيني نسيمات الصبا","ويسليني غناء البلبل",19,"ل",1,0],["وتُثيرُ فيه الذكرياتُ شجاً","يَعيا به فيَخُورُ أيِّده",20,"د",2,0],["وَتَثكلُهُ القِيانُ وحافِظُوهَا","ويَنعاهُ الزِّقاقُ إِلى الدِّنانِ",21,"ن",1,0],["وتُثيرُ الغرامَ للراهبِ الأش","مَطِ حتى يَرَى التَّرَهُّبَ عَابَا",22,"ب",2,0],["وتثيرُ في أغوارها ميتَ الهوى","لتعيشَ في نور الإله وتهتدي",23,"د",2,0],["وتثنى كالمستجير من اللو","عة أو ضم قده الأملود",24,"د",1,0],["وتثنى فما ثنيت عنان النف","س حتى دانت لسمر القوام",25,"م",1,0],["وَتَثبُتُ في أَكُفِّهِمُ العَوالي","وَتَزلُقُ فَوقَها البِدرُ النِضارُ",26,"ر",1,0],["وتثنيهِ الغصونُ إذا تثنّت","وتحملهُ النسورُ أو السنونو",27,"ن",2,0],["وتُثيرُ فيهم همَّةً مَدفونةً","فالبَحرُ يُخشى بعدَ طولِ صَفاء",28,"ا",2,0],["وتَثْبتُ يَوْمَ الرَّوْعِ في حَوْمَةِ الوَغَى","كَأنَّكَ ثَهْلانٌ بِها أَوْ مُتَالِعُ",29,"ع",1,0],["وَتَثبِطُ المُتَشَكِّكو","نَ وَكَأَنَّهُ لَيسوا هُنا",30,"ن",2,0],["وَتُثني إِذا تُصغي لِوسواسِ حَليها","عَمودُ صباحٍ بالثريّا صغى قرطا",31,"ط",2,0],["وتثلب أقواماً شنَوهُ لجهلهم","به وهو مخفيٌّ وناهيك من مخفي",32,"ف",2,0],["وتثيري من روحه نسمات","وتفيحي منها عبيرا ذآيا",33,"ي",2,0],["وتُثْمِرُ من طَعْمِهِنَّ الغصونُ","وتُغدِقُ فِي سَقْيِهِنَّ الأَرُومُ",34,"م",1,0],["وتُثير عارمةُ الرياح سحابتي","من مُبرِقٍ في فضلِ وصفك مُرعِدِ",35,"د",1,0],["وتُثْني عِتاقُ الطير صبحاً بفضله","إذا جُثَثُ الأبطال أضحتْ تميرُها",36,"ر",3,0],["وَتُثقِلُها عَجيزَتُها","إِذا وَلَّت لِتَنطَلِقا",37,"ق",2,0],["وتثنِي عِطْفَك المزوَرَّ عنّي","وَما لِسواك حظٌّ في اِنعطافي",38,"ف",2,0],["وتثليث هذا الغسل شكل مثلث","به ظهرت ممن براه صنائع",39,"ع",1,0],["وتثنت سقاتها كغصون","بعيون سبت ظباء الكناس",40,"س",1,0],["وتثنت تيهاً وقد ألبستني","ثوبها وهو موذن بافتضاحي",41,"ح",2,0],["وتُثنِي المكرُماتُ عليهِ ممَّا","يُعظّمُها وتَحمَدُ أَصغَرَيهِ",42,"ي",2,0],["وَتَثَنَّتْ كَتَثَنِّي الغُصْنِ فِي","يَوْمه رِيْحٍ وَغَمَامٍ وَمَطَرْ",43,"ر",1,0],["وتثنيك ذا الذي أذهل العق","ل وأبقى بين الجوانح كيا",44,"ي",2,0],["وتَثنَّى ليناً فَيرتَجُّ رَدفا","بين أترابِهِ ويَهتَزُّ قَدّا",45,"د",2,0],["وَتُثيرُ طافيةَ الحصى فكأنّها","ولت على الساعاتِ فَهمَ بليد",46,"د",1,0],["وَتُثني عَلَيهِ مِنهُمُ الآن ألسنٌ","بِما قَدّمت يمناه في الأَمس وَالغَد",47,"د",1,0],["وتثبيت نطقي عند ذاك لسائلي","ورجلي إذا ما كان موقفها الجسر",48,"ر",1,0],["وتثلط أيضاً ولا بد أن","تُلَقَّمَ ثَلْطَكَ يا ثالط",49,"ط",1,0],["وَتَثنّت كقضيبِ ال","بان مهتزّ القوامِ",50,"م",1,0],["وتُثقلها عندَ النهوضِ روادفٌ","ثقالٌ كَأحقافٍ من الرمل يرجحُ",51,"ح",1,0],["وتثنت حيطانه فأمالتها","شمال بزمرها وجنوب",52,"ب",1,0],["وتثنّت فيها الجداول سكرى","وترامت في ربعها الأفياءُ",53,"ا",2,0],["وتثمر أعصان الأماني بصالحٍ","ويبسم لي ثغرٌ من الدهر قد فعر",54,"ر",1,0],["وتثنَّى كالغصنِ فوق كثيبٍ","تفتدي ميل قدّهِ كلَّ قامه",55,"م",2,0],["وَتَثَبَّت وَلتَعلَمَن أَنَّها إِن","خَفِيَت مَنظَراً فَلَم تَخفَ نَشرا",56,"ر",2,0],["وَتُثبِتُ سِحرَ البَلاغَةِ في","مَهارِقَ ظَلَّت لَكُم شاكِرَه",57,"ر",2,0],["وتثنت وأبعدت","وهي في حالة الفزع",58,"ع",1,0],["وتثبتني عند النزوع وكن معي","وعند مماتي والتوجه للحفر",59,"ر",1,0],["وَتَثُرُ الخَيلُ في الأَقيادِ آوِنَةً","تَحوي النِهابَ إِلى طِلابِ أَوتارِ",60,"ر",1,0],["وتثنت ملد الغصون اختيالاً","وهي في ملبس الشباب الجديد",61,"د",1,0],["وتثني العلا كرماً عطفها","إذا أنا قمت بما فيك أثني",62,"ن",2,0],["وتثمين أصنافِ الزكاةِ محقَّقٌ","ليحملَ عرشَ الاستواء بلا مِرا",63,"ا",1,0],["وتثنى بقوامٍ فوقهُ","طائر الحسن لقد غنىَّ وغرَّد",64,"د",1,0],["وتثني عطفه خطرات دلًّ","إذا لم تثنه نشوات راح",65,"ح",1,0],["وتثيرها شهباء تملأ جوها","نقعا يحط الطير من وكناتها",66,"ت",3,0],["وَتَثور أَحياناً فَتغمُرُني","فَكَأنَّني في الجَمر مَدفون",67,"ن",1,0],["وتثن في روض الملاحة مائسا","حتى تشاهد ذلة الأغصان",68,"ن",1,0],["وتثمَّ نهرٌ اسمه الوسطاني","ومقسم الغربي نهرٌ ثاني",69,"ي",1,0],["وَتَثَلَّثَت بِالغانِيا","تِ فَقُل عَلى الدينِ السَلام",70,"م",1,0],["وتثنى معجبا من حسنه","أين منه الغصن في روض الدلال",71,"ل",1,0],["وتَثَنّى مثلَ القَضيبِ وكادَتْ","فوقَه تَصْدَحُ الحمائِمُ صَدْحا",72,"ح",2,0],["وتثيره ذكرى بلادي","والمآسي والنوب",73,"ب",1,0],["وتُثير في الأرض الغبار مرفرفاً","مرحاً فأنشقُ في الغبار عبيري",74,"ر",2,0],["وتثني على شأواك كل ادارة","توليتها فاستقبلتها العوارف",75,"ف",1,0],["وَتثنت كأَنَّها غصنُ بانٍ","ليسَ ماءٌ يَسقيهِ لكن بهاءُ",76,"ا",2,0],["وتثنى نسماتُ الغور حاكية","علم الفريق فأدري ما تترجمه",77,"م",2,0],["وتثمِرُ حاجةُ المحتاجِ نجْحاً","إذا ما كانَ فيه ذا احتِيالِ",78,"ل",1,0],["وتُثيرُ سُحْبُ النّقْعِ منْ وقْعِ الظُّبا","فوقَ الدّروعِ بوارقاً ورُعودا",79,"د",2,0],["وَتَثنَّى كَي أَرى من قدِّك ال","لَدْنِ غُصناً فَوقه البَدرُ المُنير",80,"ر",1,0],["وَتُثمر أَغصان الأَماني بصالح","وَيبسم لي ثَغر من الدَهر قَد فغر",81,"ر",1,0],["وتَثَنّت الأعواد من تحريكها","وشَدَت على عذباتها وَرْقاها",82,"ا",3,0],["وتثنَّتْ فوق رأْسي","أَغصنُ البَانِ النحيله",83,"ل",2,0],["وَتَثبتي يا مُهجتى أَو فَاِجزَعى","وَتَفطري أَو فَاِصبِري لِقَضاء",84,"ا",2,0],["وتثنى الغصون على هزة","كأن بها سكرات المدام",85,"م",1,0],["وتثني تارةً تدعو مشائخها","من شيبة الحمد أشياخاً وشبانا",86,"ن",2,0],["وتثنَّى عجُباً وماسض دَلاَلاً","وانثنَى مُعرضاً وصالَ وقَالا",87,"ل",2,0],["وتثنَى غصناً فلجَّت عليه","طائراتُ القلوب بالتَغريد",88,"د",1,0],["وتثني الفاحص المذعور","عن دغدغة النهد",89,"د",1,0],["وتَثُورُ أيتَامُ الرَّمَادِ إلى","أنْ يُثْمِرَ البَارُودُ والغَازُ",90,"ز",1,0],["وتَثُورُ مُنتَصِبَ الجَبينِ على","مَن لِلمَهَانَةِ سُجَّدًا خَرُّوا",91,"ر",3,0],["وتُثمِرَ أخلاقاً وعلماً ومنطقاً","بِها جَنْيُ كل الحاصدين سليمُ",92,"م",1,0],["وَتُثِيْرُ ثَوْرَةَ ثَاْئِرٍ عَشِقَ الْوَغَىْ","عِشْقاً ، وَتُوْمِضُ حَوْلَهَا الأَنْوَاْرُ",93,"ر",1,0],["وَتَثْمُلُ مِنْ سِمْطَي رُضابِكَ قُبْلَةٌ","وَيَصْحو بِداراً في فُؤادي عَذابُ",94,"ب",1,0],["وتثاقل الميزان بالشعر تهليل","منبع هل الطولات غرسه وفسله",95,"ل",2,0],["وتثاقل أف ممشاه دعواه بالغيب","يارب ترحم من عليك أتكاله",96,"ل",2,0],["وتُثيرُني وأنا جناحُ فَراشةٍ","مُتوجِّعٌ يشكو انْتِشارَ ضبابِها",97,"ب",3,0],["وَتَثُورُ فَتُقْصُرُ قَامَاتٌ","مِنْ حَوْلِكَ طَالَتْ بِالْضُّرِ",98,"ر",1,0],["وتثور أعداه علىه ويلتقي","يوعود منهزماً بصفقة خاسر",99,"ر",1,0],["وتُثيرُ الشرورَ بينَ بَنيه","تحت ( فرق تسد ) بلا استحياء",100,"ا",2,0],["وتثورُ أمّتنا على حكّامِها","وتدكُّ عرشَ اليأسِ بالإيمانِ",101,"ن",1,0],["وتثيره الأنوار ساطعة","ويهش في يوم متى غربا",102,"ب",2,0],["وتثور تثور بذاكرتي","رؤياكِ كعصفِ الإعصارِ",103,"ر",1,0],["وتثبت منه الكف قائم سيفه","ومضربه في مزلق اللهام يعثر",104,"ر",1,0],["وتثنت ريانة العود نشوى","برحيق من الندى لا الشمول",105,"ل",1,0],["وتَثاقَلتْ في الخطو ِ تفتعِل ُ الضَّنى","فودَدْتُ لو كانتْ ضلوعي هَوْدَجا",106,"ج",2,0],["وتثائب الصمت الطويل ومقلتي","ترنو الى الافق البعيد وتذرفُ",107,"ف",1,0],["وتثورمعك الروم والفرس والصرب","والراوي اللي تنشده..ماروالك",108,"ك",1,0],["وَتُثْقِلُ