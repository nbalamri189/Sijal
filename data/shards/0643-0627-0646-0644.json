 وَجَمَل","نالَهُما يَوماً مِنَ الرِقِّ مَلَل",72,"ل",1,1],["كانَ لِبَعضِ الناسِ بَبَّغاءُ","ما مَلَّ يَوماً نُطقَها الإِصغاءُ",73,"ا",2,1],["كانَ لِبَعضِ الناسِ نَعجَتان","وَكانَتا في الغَيطِ تَرعَيانِ",74,"ن",1,1],["كانَ لِلغربانِ في العَصرِ مَليك","وَلَهُ في النَخلَةِ الكُبرى أَريك",75,"ك",1,1],["كانَ لِسُلطانٍ نَديمٌ وافِ","يُعيدُ ما قالَ بِلا اِختِلافِ",76,"ف",1,1],["كانَ لي مِنكَ في المَجامِعِ راوٍ","عَجَزَ اِبنُ الحُسَينِ عَن أَمثالِه",77,"ل",2,0],["كَأَن لَم تَضِق بِالأَمسِ عِنّى كَنيسَةٌ","وَلَم يُؤوِني دَيرٌ هُناكَ طَهورُ",78,"ر",1,0],["كانَ لِلناسِ لَيلُهُ حينَ تَشدو","لَحَقَ اليَومَ لَيلُهُ بِنَهارِهِ",79,"ر",2,0],["كَأَن لَم يَملَإِ الدُنيا فِعالاً","وَلا هَتَفَت بِدَولَتِهِ الرُواةُ",80,"ه",1,0],["كأنْ لم يكن بعد أن كان لي","كما كان لي بعد أن لم يكُن",81,"ن",1,0],["كأن لم يكنْ بالمرء من قبلُ عَثْرةٌ","إِذا انتعشتْ تلك الجدودُ العواثرُ",82,"ر",1,0],["كَأَنَّ لَها عَلى قَلبي رَقيباً","مِنَ الصَدِّ المُبَرِّحِ وَالجَفاءِ",83,"ا",2,0],["كَأَن لَم يَرَوا سيما الطَويلَ وَجَمعَهُ","وَما فَعَلَت فيهِ وَفي جَمعِهِ الحَربُ",84,"ب",1,0],["كانَ لَهُ اللَهُ حَيثُ كانَ وَإِن","كانَ مُخِلّاً بِبَعضِ ما يَجِبُ",85,"ب",1,0],["كَأَن لَم يُنِف نَجدَ المَعالي وَلَم تُغِر","زَراياهُ في أَرضِ العَدُوِّ المُغاوِرِ",86,"ر",1,0],["كَأَن لَم تَبِت فيهِ الخِلاَفَةُ تَلقَةً","بَشاشَتُها وَالمُلكُ يُشرِقُ زاهِرُه",87,"ر",2,0],["كَأَنَّ لَهُ في أَيطَلَيهِ كِلَيهِما","جَناحَينِ خَفّاقَينِ لَم يَتَصَوَّعا",88,"ع",2,0],["كَأَن لَم يَكُن فيها لِعَينَيكِ مَنظَرٌ","إِذِ الدارُ دارٌ وَالحُلولُ حُلولُ",89,"ل",1,0],["كانَ لَهُ اللَهُ حَيثُ كانَ وَلا","أَخلاهُ مِن طَولِهِ وَمِن نِعَمِه",90,"م",2,0],["كَأَن لَم يُحَوِّض أَهلُها الثَورَ يَجتَني","بِحافاتِها الخَطمِيَّ غَضّاً نَضيرُها",91,"ر",3,0],["كَأَن لَم تُرَفِّع بِالأُكَيمَةِ خَيمَةً","عَلَيها نَهاراً بِالقُنِيِّ ثُمامُها",92,"م",3,0],["كأنْ لم تَغْنَ عَرصَتُها بخُضرٍ","يُقَيِّدُ لَحْظَ مُبصِرها غِناها",93,"ا",3,0],["كأنَّ للرَّعْدِ تحتَه صَخَباً","يَعْلو وللبَرْقِ فوقَه ضَرَما",94,"م",2,0],["كان لِقَعْرِ لُجَّةٍ حَليفا","لاقى وقد فارقَه 