ctabudhabi.ae/diwan/poem/54270","المديد"],[104,"الصيف وأنا","https://www.poetsgate.com/ViewPoem.aspx?id=16827",""],[106,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[106,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[22,"ألا طرقت هندُالهنود وصحبتي","https://www.poetsgate.com/ViewPoem.aspx?id=19727",""],[50,"كَأنَّ لهم دَيْناً عليه ومالهم","https://www.poetsgate.com/ViewPoem.aspx?id=30976",""],[50,"يا بنَ موسى ماذا يقول الإمام","https://www.poetsgate.com/ViewPoem.aspx?id=31093",""],[90,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[90,"صحو بعد سكر","https://www.poetsgate.com/ViewPoem.aspx?id=178933",""],[90,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[90,"سلام على أرض الرصافة","https://www.poetsgate.com/ViewPoem.aspx?id=178976",""],[45,"مَحَلٌّ على القَاطُولِ أخْلَقَ داثِرُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31192",""],[45,"عَذيرِيَ مِنْ صَرْفِ اللّيالي الغَوَادِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31280",""],[91,"كل من عليها فان","https://www.poetsgate.com/ViewPoem.aspx?id=53027",""],[99,"إلى بيروت الأنثى مع الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=215333",""],[39,"بَرَتْ لَكَ حَمَّاءُ العِلاطِ سَجُوعُ","https://www.poetsgate.com/ViewPoem.aspx?id=4262",""],[29,"ومحبوسة ٍ في الحيّ ضامنة ِ القرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17428&r=&rc=1",""],[20,"ويح عمرِو بن عدي من رجل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70016&r=&rc=38",""],[88,"تذكرت في أوطاني الأهلَ والصحبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19533&r=&rc=36",""],[18,"أَعَينَيَّ جودا بِالدُموعِ السَوافِحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69557&r=&rc=44",""]],"verses":[["كَأَنَّ لِساني نِسعَةٌ حَضرَمِيَةٌ","طَواها وَلَم تَبلُغ لَها السومَ بائِعُ",0,"ع",1,0],["كَأَنَّ لَها ديناً عَلَيَّ وَإِنَّني","سَيَطلُبُها سَيفي وَديني خَراجُها",1,"ج",3,0],["كَأَنَّ لِواءً يَزدَحِمنَ وَراؤَهُ","إِذا اِختَلَجَ البَرقُ اِزدِحامَ المَقانِبِ",2,"ب",1,0],["كَأَن لَم يَكُن بَيني وَبَينَهُمُ هَوىً","وَلَم يَكُ مَوصولاً بِحَبلِهِمُ حَبلي",3,"ي",1,0],["كانَ لي قَلبٌ أَعيشُ بِهِ","فَاِصطَلى بِالحُبِّ فَاِحتَرَقا",4,"ق",2,0],["كَأَن لَم تَكُن فَوزٌ لِأَهلِكَ جارَةً","بِأَكنافِ شَطٍّ أَو تَكُن بِنَسيبِ",5,"ب",1,0],["كَانَ لاَ يَرْتَضِي الْحِيَاضَ لِوَرْدٍ","فَهُوَ الْيَوْمَ قَانِعٌ بِبُلاَلَهْ",6,"ل",2,0],["كأنّ لسانَ الدّهْرِ نفْثُ يَراعِهِ","يتَرْجِمُ عمّا أضْمرتْهُ المَقاديرُ",7,"ر",1,0],["كأنْ لم يكُنْ منْ قبْلِ يومِكَ عاشِقٌ","ولا واقِفٌ بالرَّبْعِ وقْفَةَ مُكْمَدِ",8,"د",1,0],["كأنّ لِطافَ القُضْبِ منْ فوْقِ وَرْدِها","مَراوِدُ تَسْتَشْفي بِها أعْيُنٌ رُمْدُ",9,"د",1,0],["كَأَنَّ لَها رَأماً تَراهُ أَمامَها","مَدى العَينِ تُستَهوى إِلَيهِ وَتَذهَبُ",10,"ب",1,0],["كَأَنَّ لَنا مِنهُ بُيوتاً حَصينَةً","مَسوحٌ أَعاليها وَساجٌ كُسورُها",11,"ر",3,0],["كانَ لا يَعرِفُ القَرارَ بِلَيلٍ","لا وَلا يَستَلِذُّ طَعمَ الهُجودِ",12,"د",1,0],["كانَ لا يَنحَني لِغَيرِكَ إِجلا","لاً وَلا يَشتَهي سِواكَ حَبيبا",13,"ب",2,0],["كانَ لي قدرَةٌ عَلى اللُغزِ إِذ حَب","لي مَتينٌ وَزَندُ فِكرِيَ واري",14,"ي",1,0],["كَأَن لَيسَ في نُعمى الهُمامِ مُحَمَّدٍ","مُسَلٍّ وَفي مَثنى أَياديهِ شاغِلُ",15,"ل",1,0],["كَأَن لَم تَسِر حُمرُ المَنايا تُظِلُّها","إِلى مُهَجِ الأَقيالِ راياتُهُ الحُمرُ",16,"ر",1,0],["كَأَن لَم تَكُن سُعدى بِأَعناءِ غَيقَةٍ","وَلَم تُرَ مِن سُعدى بِهِنَّ مَنازِلُ",17,"ل",1,0],["كَأَن لَم يُدَمِّنها أَنيسٌ وَلَم يَكُن","لَها بَعدَ أَيّامِ الهِدَملَةِ عامِرُ",18,"ر",1,0],["كَأَن لَم يُوافِقُ حِجَّ عزَّةَ حَجُّنا","وَلَم يَلقَ رَكبًا بِالمحصَّبِ أَركَبُ",19,"ب",1,0],["كَأَن لَم أَقُل وَاللَيلُ ناجٍ بَريدُهُ","وَقَد غالَ أَميالَ الفِجاجِ الرَكائِبُ",20,"ب",1,0],["كَأَن لَم يَقُل أَهلاً لِطالِبِ حاجَةٍ","وَكانَ بَليجَ الوَجهِ مُنشَرِحَ الصَدرِ",21,"ر",1,0],["كَأَن لَم يَكونوا حِمىً يُتَّقى","إِذِ الناسُ إِذ ذاكَ مَن عَزَّ بَزّا",22,"ز",2,0],["كَانَ لاَ يُعْطِي الحَيَاةَ سِوَى","قَدْرِ مَا يُعْطِي أَخُو اللُّبِّ",23,"ب",1,0],["كان لنا مجدٌ نزلنا به","من السموات العلى منزلا",24,"ل",2,0],["كَانَ لَهُ قَبْلَهَا مُقَامٌ","غَدَا بِأَضْعافِهِ حرِيَّا",25,"ي",2,0],["كَانَ لِلنَّأْيِ فِي النُّفُوسِ انْقِبَاضٌ","بَسَطَتْهُ يَدٌ لِهَذَا الزَّمَانِ",26,"ن",1,0],["كَأَنْ لَمْ يَكُنْ عِلْمٌ هُنَاكَ وَلا نُهىً","وَلَمْ يَكُ فَضْلٌ يُسْتَفَادُ مُيَمَّمَا",27,"م",2,0],["كَأَنْ لَمْ يَكُنْ حُبٌّ فَصَدُّ حَبِيبَةٍ","فَيَأْسٌ كَبُرَكَانٍ يَثُورُ تَضَرُّمَا",27,"م",2,0],["كَأَنَّ لَم يَكُن إِلّا حَديثاً وَقَد أَتى","لَهُ ما أَتى لِلمُزمِنِ المُتَقادِمِ",28,"م",1,0],["كَأَن لَم يَرُعكَ الدَهرُ بِالبَينِ قَبلَها","لِمَيٍّ وَلَم تَشهَد فِراقاً يُزيلُها",29,"ل",3,0],["كَأَن لَم تَحُلَّ الزُرقَ مَيٌّ وَلَم تَطَأ","بِجَرعاِء حُزوى ذَيلَ مَرطٍ مُرَجَّلِ",30,"ل",1,0],["كَأَن لَم يَكُنها الحَيُّ إِذ أَنتَ مَرَّةً","بِها مَيِّتُ الأَهواءِ مُجتَمِعُ الشَملِ",31,"ل",1,0],["كَأَن لَم يَكُن مِن أَهلِ مَيَّ مَحَلَّةَ","يُدَمِّنُها رُعيانُها وَرَبيضُها",32,"ض",3,0],["كأن لم تُصبني فيها كعاب","ولم يضرب بساحتها رواق",33,"ق",1,0],["كان له عند كلّ بادهة","بدائع في القريض مرتجله",34,"ل",2,0],["كأن لم يقم من بينهم ناعرٌ بها","ولم يك ضرّانا بها أمسَ من ضرّى",35,"ر",2,0],["كان للعلم في القديم طريق","غير رحب يَشُقّ أن نجتازه",36,"ز",2,0],["كأن ليالي الدهر غضبي على الورى","فتنظر شزراً بالنجوم الشوارق",37,"ق",1,0],["كأن لم يرح في موكب العزّ راكباً","عتاق المذاكي مالك النهي والأمر",38,"ر",1,0],["كَأَنَّ لَوناً بِهِ مِن زَيتِ سامِرَةَ","وَلَونَ وَردٍ مِنَ الحِنّاءِ مَعصورِ",39,"ر",1,0],["كَأَن لَم تَرُقني الرائِحاتُ عَشِيَّةً","وَلَم تُمسِ في أَهلِ العِراقِ وَميقُ",40,"ق",1,0],["كَأَن لَم يَكُن بِالشِرعِ مِنهُم طَلائِعٌ","فَلَم تَرعَ سَحّاً في الرَبيعِ القَنابِلُ",41,"ل",1,0],["كانَ لمولانا كما قد درَى","جدّ يرى للودِّ إثباتا",42,"ت",2,1],["كأن لم يقم بالمكرمات مطوَّق","لدى الباب يشدوا بالثنا شدو صادح",43,"ح",1,0],["كأن لم يسر والكاتبون أمامه","يجهز وفداً أو يجهز عسكرا",44,"ر",2,0],["كأن لم يجل يومي وغى وسماحة","يراعاً كما سُل القضيب وأزهرا",44,"ر",2,0],["كأَنْ لم يهزّ القصد منه شمائلاً","ولا قلماً يعزى إلى الخضر أخضرا",44,"ر",2,0],["كان لي مال ولبسٌ","قبل تهيامي وسكري",45,"ي",1,1],["كأنَّ لهم فيها طريقاً مفسراً","و