,"ر",2,0],["كأنْ لَمْ يُنِفْ نَجدَ المَعَالي، وَلَمْ تُغِرْ","سَرَاياهُ في أرْضِ العَدُوّ المُغاوِرِ",185,"ر",1,0],["كأنّ لها نذرا أرادت قضاءه","كأنّك أنت الصوت جاوبه الصدى",186,"د",2,0],["كَان لُبنَانُ لَكُم مَروَحَةٌ","تَنشُرُ الأَلوَانَ وَالظِلَّ الظَلِيلاَ",187,"ل",2,1],["كَأَنْ لَمْ يَرُعْكَ الظَّاعِنُونَ، ألاَ بَلى","ومِثْلُ فِرَاقِ الظَّاعِنينَ يَرُوعُ",188,"ع",1,0],["كأنَّ لَهاها في بلاعيمِ جِنّة ٍ","وأشداقَها السُّفْلى مَغارُ الثّعالبِ",189,"ب",1,0],["كانَ لا يَعقِلُ حَتّى ما إِذا","جاءَ يَومٌ يَأكُلُ الناسَ عَقَل",190,"ل",1,0],["كأن لم نكن سفراً على ظهرها ركبا","تغالبت يا عصر البخار مفضلا",191,"ا",1,0],["كَأَن لَم يَكُن في الحِمى حَيّاً وَلَم يَرُح","إِلَيهِ عُفاةُ الناسِ أَوكُلُّ رابِحِ",192,"ح",1,0]]}