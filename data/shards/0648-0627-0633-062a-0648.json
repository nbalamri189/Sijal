اك يوما، في الهوى كذبا","https://www.poetsgate.com/ViewPoem.aspx?id=177182",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5055,"صفوف الظل","https://www.poetsgate.com/ViewPoem.aspx?id=101655",""],[5106,"هٰذي الشُّموسُ بَدتْ","https://www.poetsgate.com/ViewPoem.aspx?id=150488",""],[5145,"حكم اعتساف قضية الأزمان","https://www.poetsgate.com/ViewPoem.aspx?id=108117",""],[5145,"حثوا المطي فهذا الصبح قد جشرا","https://www.poetsgate.com/ViewPoem.aspx?id=108048",""],[5174,"لغة الضاد ليلة الزفاف","https://www.poetsgate.com/ViewPoem.aspx?id=184937",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5410,"همسات ناعمة","https://www.poetsgate.com/ViewPoem.aspx?id=152343",""],[5431,"حق الشعوب","https://www.poetsgate.com/ViewPoem.aspx?id=183088",""],[5431,"حق الشعوب","https://www.poetsgate.com/ViewPoem.aspx?id=185118",""],[5561,"غضب القدس","https://www.poetsgate.com/ViewPoem.aspx?id=194360",""],[5582,"هَلْ مِنْ مُجِيدٍ لِي بِأَنْباءِ","https://www.poetsgate.com/ViewPoem.aspx?id=186648",""],[243,"وحي النيروز","https://www.poetsgate.com/ViewPoem.aspx?id=20962",""],[5644,"أنا المقيم بغربتي","https://www.poetsgate.com/ViewPoem.aspx?id=213597",""],[5661,"واستوف عمر الدهر في نعمةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181403",""],[5689,"هل طي عرفك لي يا نسمة السحر","https://www.poetsgate.com/ViewPoem.aspx?id=143428",""],[5725,"عرس بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=177970",""],[5750,"كوني مع الليل","https://www.poetsgate.com/ViewPoem.aspx?id=214629",""],[5768,"نَفَحَاتُ عَرَفَاتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=215345",""],[5897,"إلى .. اليمن الذي كان سعيداً !","https://www.poetsgate.com/ViewPoem.aspx?id=176758",""],[6050,"الشّمسُ تُنسَجُ مِنْ فَم الشُّعراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=103311",""],[6075,"نهر اشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=201155",""],[6127,"قد يَصدُقُ السيف!","https://www.poetsgate.com/ViewPoem.aspx?id=188485",""],[6142,"مل بنا يا هديت ننتجع الحق","https://www.poetsgate.com/ViewPoem.aspx?id=155693",""],[520,"لو اطلعت على سري وإضماري","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577530",""],[6265,"المهاجرة اليمنية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84177&r=&rc=0",""]],"verses":[["واستَوْطَؤوا ثَبَجَ البَغْضاءِ واجتَذَبوا","حَبْلاً أُمِرَّ على الشّحْناءِ فانْجذَما",0,"م",2,0],["وَاِستَوكَفوا ماءَ العُيونِ بِأَعيُنٍ","مَكحولَةٍ بِالسِحرِ لا بِالإِثمِدِ",1,"د",1,0],["واستُوقِفَتْ دَهَشاً فإنّ قُلوبَنا","نهَضَتْ بكُلّ وظيفَةِ الآماقِ",2,"ق",1,0],["واسْتَوْتَرَتْ شبَحاً خلاءً لمْ يزَلْ","لخَفيّ مَعْناها الأثيرِ ضَديدا",3,"د",2,0],["وَاِستَوفِرِ الحَظِّ مِن نُصحٍ وَصاغِيَةٍ","كِلاهُما العِلقُ لَم يوهَب وَلَم يُعَرِ",4,"ر",1,0],["وَاِستَوحَشَت لِفِراقِهِ","يَومَ الوَغى سِربُ الخُيولِ",5,"ل",1,0],["وأستوضح العلياء فيك فراسة","بملكك لا أعطى عليها منجّما",6,"م",2,0],["واسْتوطنوا عقدات الرمل واحْتملوا","بين المآزر من يبرين كثبانا",7,"ن",2,0],["واسْتوثق العدل في الدنيا فليسَ بها","جانٍ سوى راتع في الروضِ يجنيه",8,"ي",2,0],["واستوطأ الرحلَ منه راكبُهُ","وطال ما قد نَبَا به قَتَبُهْ",9,"ب",2,0],["واستوت الأقدار في خُطَّةٍ","فليس محسودٌ ولا حاسدُ",10,"د",1,0],["وَاِستَوى اللَيلُ مَليكَا","لابِساً تاجَ النُجوم",11,"م",1,0],["واستوى اللَّيلُ بِرَغْمِ الشَّمْ","سِ في العَرْشِ الفُساحِ",12,"ح",1,0],["واستوى الصاحبان هذا إلى الرع","د تولى وذا إلى الإبعاد",13,"د",1,0],["وَاِستَوهِبوهُ يَداً في العُمرِ واحِدةً","وَمَهِّدا عُذرَهُ عَنّي إِذا حَرَما",14,"م",2,0],["واستوقفتْ عجلَى الركاب فمُقلةٌ","للركبِ شاخصةٌ وقلبٌ ذاهِلُ",15,"ل",1,0],["واستوفِ حظَّكَ منهُ قبل فُرقَتِه","بحيثُ لا أثَرٌ يبقَى ولا خَبَرُ",16,"ر",1,0],["وَاِستُؤنِفَ الظُلمُ في الصَديقِ فَهَل","حُرٌّ يَبيعُ الإِنصافُ أَو يَهِبُه",17,"ب",2,0],["وَاِستَوى الناسُ فَالقَريبُ قَريبٌ","عِندَهُ وَالبَعيدُ غَيرُ بَعيدِ",18,"د",1,0],["واستَوثَقَت من نقابٍ فَوقَ وَجنَتِها","وَإِنَّما أَشْفَقَتْ أَنْ أَلثُمَ الشَّفَقا",19,"ق",2,0],["وَاِستوى جالِساً عَلى رفرف خض","ر غوال وَعَبقريٍ حِسان",20,"ن",1,0],["وَاِستَوطَنَتهُ العُفرُ قاطِنَةً","وَلَقَد يَكونُ مَرابِعَ الإِنسِ",21,"س",1,0],["وَاِستَودَعوا تيجانَهُم تِمثالَهُ","وَاللَهُ يَعلَمُهُ مَعَ الأَقوامِ",22,"م",1,0],["وَاِستَوقِفِ الرَكبَ عَلى رَسمِها","بَل حُلَّ بِالرَسمِ وَلا تَركَبِ",23,"ب",1,0],["واستَوْدَعَ الحُكَماءُ فيها حِكْمَةً","قَدُمَتْ فخافوا مِن حُدوثِ ضَياعها",24,"ع",3,0],["وَاسْتَوْدِعُوهُ تُرَابَهُ","مَيْتاً وَقُولُوا لا رُحِمْ",25,"م",1,0],["واسْتَوْفَتِ الْحُسْنَيْنِ مِنْ دَعَةٍ وَمِنْ","خُيَلاَءَ فِي الأَغوَارِ وَالأَنْجَادِ",26,"د",1,0],["واستووا عند مليكٍ","بمساويهم خبيرِ",27,"ر",1,0],["واستوى؛ فهْو كالقُدود واعتدالاً","وثنى العطف؛ فهْو من خيرزُان",28,"ن",1,0],["واستودِعوه مساجدًا وكنائسًا","وضعوا هلالاً فوقه وصليبا",29,"ب",2,0],["واستَوحِ مَنْ طبَّب الدُّنيا بحكْمَتَهِ","ومَنْ على جُرحها مِن روُحه سَكَبا",30,"ب",2,0],["واستوحشت عرصاتُها ولقد تُرى","دارَ الُوفادة كعبة الوُفاد",31,"د",1,0],["واستوحِ كُوفاناً وبصرةَ إذ هُما","يتصدَّرانِ العالَمَ المأهولا",32,"ل",2,0],["واستودعت حمص قبرا لو مررت به","لهشّ لي منه حبّ مترف عطر",33,"ر",1,0],["واستوف بين سلامة من فعلها","وسلامة من تركها حق النظر",34,"ر",1,0],["واسْتوْقفُوا ماءَ العُيونِ بأعينٍ","مَكحولة بالسِّحْر لا بالإثمِدِ",35,"د",1,0],["واستوضحي وادي الشتا وتلاعه","لم أخطات أصمى السهام شعابي",36,"ب",2,0],["واستوقفته قليلاً حينما التفتت","تبدي لنا من جمال السحر ألوانا",37,"ن",2,0],["واستودع التنزيل تاريخه","نصر من الله وفتح قريب",38,"ب",1,0],["واستوقف الطَّرف إذ تبدى","في الزَّهر والزُّهر واللآلى",39,"ل",2,0],["واستوقفت طرفي خصور الدما","وانتهضت عقلي حضور الدنان",40,"ن",1,0],["واستوضحت نهجَ الرجاء فاعتقتْ","بي أوصل الإِدلاجِ بالإِسراء",41,"ا",2,0],["واستوى من يعبد ال","لَه لديهم والحجارا",42,"ر",2,0],["وَاِستَوحَشَت بَعدَهُ للعلمِ أَنديةٌ","كانَت تَرِنُّ بِها الأَشعارُ وَالخُطَبُ",43,"ب",1,0],["وَاِستَوى المَيتُ وَالتُرابُ وَبَين ال","مَيتِ وَالحَيِّ نسبةٌ وَالتِئامُ",44,"م",1,0],["واستوتِ الجنةُ فيما أرى","عند ذوي التخليط والنار",45,"ر",1,0],["وَاِستَوت شمسُ عُلاه عندَما","قالَ مَولاهُ على العرش اِجلسِ",46,"س",1,0],["وَاِستَوى منهمُ لديه جفاءٌ","وَوفاءٌ والضرّ والسرّاءُ",47,"ا",2,0],["واستوحه واستلهمنه","فكم وكم أوحى وألهم",48,"م",1,0],["واستودَعوه بعدَهم أبناءَهمْ","فبنوا عليه وشيَّدوا المستودعا",49,"ع",2,0],["وَاِستَوصِ عَلى الَّذي فارَقَني","وَالتافَ بِهِم فَإِنَّهُ ضَيفُهُم",50,"م",1,0],["وَاِستَوطَنوا الجُردَ السَوابِقَ ضُمَّراً","قُبَّ البُطونِ سَوامِيَ الأَعرافِ",51,"ف",1,0],["وَاِستَوفِ لي بِالعُنفِ وَالعَسفِ ما","حَواهُ بِالخَدعَةِ وَالمَكرِ",52,"ر",1,0],["وَاسْتَوْفِ أُنْسَكَ عِنْدَ خَيْرِ قَبِيلِ","وَاظْفَرْ بِمَا قَدْ شِئْتَ مِنْ مَأْمُولِ",53,"ل",1,0],["وَاسْتَوْهِبَنْ دَعْوَةً لِي مِنْهُ صَالِحَةً","يَحْيَا بِهَا مِنْ رَشَادِي كُلُّ مَرْمُوسِ",54,"س",1,0],["واستوفى عمر الدهر في نعمةٍ","دون مداها موقف الحشر",55,"ر",1,1],["واستوت فوق عرش روحي وقلبي","واسعٌ بالشهود كالكرسيّ",56,"ي",1,0],["واستوطنت مصراً وأفريقيةً","وبنت على الأمواجِ أضخمَ دولة",57,"ه",1,0],["واِستوطنت رحمة الرحمن تربكما","تَفيض بالفضل والاصباح والاصل",58,"ل",1,0],["وَاسْتَوْضَحَتْ سبُلً الآمالِ حائِدَةً","عَنِ الْمُلُوكِ إِلى أَعْلاهُمُ حَسَبا",59,"ب",2,0],["واستوهب الغفران منه فإنه","يعفو ويغفر زلة الخطَّاء",60,"ا",2,0],["واستوهب الرحمن صادق حبِّه","فبحبه فاز الهداةُ السّبق",61,"ق",1,0],["وَاِستَودِعوا مِن فَمي أَصدافَ سَمعِكُمُ","دُرّاً تَنَظَّمَ شِعراً غَيرَ مُنتَحَلِ",62,"ل",1,0],["وَاِستَوطَنوا مِن العلا","ءِ وَالعُلى أَعلى الذُرا",63,"ر",2,0],["واستوحشت نفسي حتى لقد","نفرت لو أمكن من ظلى",64,"ل",2,0],["وَأَستودعُ الرحمنَ عهداً مبرءاً","تجنّت له عينُ الجفا وصمة الذنبِ",65,"ب",1,0],["واستوينا أنا ومجدي على الخل","قِ نثسوّى ما بينهم من خصام",66,"م",1,0],["وَاِستَوَت نِسبَةُ الجِهاتِ إِلَيهِ","مَع تَعاليهِ عَن حُدودِ الفَضاءِ",67,"ا",2,0],["واستَوَت حَلبةُ الدُّموع فَفي الش","شُهبِ سباقٌ والكمت فيها لحاقُ",68,"ق",1,0],["واسْتَوجَسوا مِن عِقاب خالِقهمْ","ما أُوعِدوا في قَطيعةِ الرَّحِمِ",69,"م",1,0],["واستوطَنَتْ بشُعاعها","بيتاً ولا بيتَ العناكِبْ",70,"ب",1,0],["واستوْدع الأرواحَ كلَّ عشيّةٍ","نفَسَ الرياضِ مغرِّباً ومُشرِّقا",71,"ق",2,0],["واستوطِني وَحْشَ الفلاةِ وَوَطِّنِي","نفساً لِبَرْحِ تَوَدُّعٍ وتَرَحُّلِ",72,"ل",1,0],["واستودَعُوكَ شمائِلاً 