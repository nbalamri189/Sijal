{"poems":[[53,"زمان الهوى ما أنت لي بزمان","https://www.aldiwan.net/poem29719.html","الطويل"],[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[53,"تناسيت إلا باقيات من الذكر","https://www.aldiwan.net/poem30441.html","الطويل"],[53,"لبست الوغى قبل ثوب الغبار","https://www.aldiwan.net/poem30457.html","المتقارب"],[63,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[3,"فؤاد ليس يثنيه العذول","https://www.aldiwan.net/poem193.html",""],[77,"ومنتقش المتن كالمبرد","https://www.aldiwan.net/poem36586.html","المتقارب"],[93,"هذا أديب العرب","https://www.aldiwan.net/poem9794.html","عموديه"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[30,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[88,"ما للديار تراءى وهي أطلال","https://www.aldiwan.net/poem44390.html","البسيط"],[88,"لعمرك لو كانت حديدا جسومنا","https://www.aldiwan.net/poem45054.html","الطويل"],[51,"أبو الحسين معجب برائه","https://www.aldiwan.net/poem7992.html","الرجز"],[51,"أكف الغواني بالخنا خضرات","https://www.aldiwan.net/poem9201.html","الطويل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"كفي الدموع وإن كان الفراق غدا","https://www.aldiwan.net/poem10879.html","البسيط"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[51,"تظلّم شِعري إلى القاسمِ","https://www.aldiwan.net/poem66302.html","المتقارب"],[51,"أبا العباس ما هذا التواني","https://www.aldiwan.net/poem66343.html","الوافر"],[51,"إني أراك بعين لا يراك بها","https://www.aldiwan.net/poem66345.html","البسيط"],[51,"يا باني الحصن أرساه وشيده","https://www.aldiwan.net/poem66379.html","البسيط"],[51,"مكر الزمان علينا غير مأمون","https://www.aldiwan.net/poem66416.html","البسيط"],[29,"صحا القلب إلا من ظعائن فاتني","https://www.aldiwan.net/poem6052.html","الطويل"],[29,"أتعرف من أسماء بالجد روسما","https://www.aldiwan.net/poem6156.html","الطويل"],[16,"هل ما علمت وما استودعت مكتوم","https://www.aldiwan.net/poem27694.html","البسيط"],[70,"علا حس النواعير","https://www.aldiwan.net/poem42906.html","الهزج"],[92,"إذا الشعب يوما أراد الحياة","https://www.aldiwan.net/poem38947.html","المتقارب"],[89,"في الغرب حيث كلا الجنسين يشتغل","https://www.aldiwan.net/poem44869.html","الطويل"],[85,"أحق أنهم دفنوا عليا","https://www.aldiwan.net/poem7117.html","الوافر"],[85,"أبو الحصين جال في السفينه","https://www.aldiwan.net/poem8021.html","الرجز"],[85,"بني مصر ارفعوا الغار","https://www.aldiwan.net/poem8078.html","الهزج"],[85,"ألا حبذا صحبة المكتب","https://www.aldiwan.net/poem62987.html","المتقارب"],[85,"يا ناشر العلم بهذي البلاد","https://www.aldiwan.net/poem63771.html","السريع"],[85,"إلى عرفات الله يا خير زائر","https://www.aldiwan.net/poem63776.html","الطويل"],[85,"إثن عنان القلب واسلم به","https://www.aldiwan.net/poem63782.html","السريع"],[43,"فديناك من ربع وإن زدتنا كربا","https://www.aldiwan.net/poem9455.html","الطويل"],[43,"يا أخت خير أخ يا بنت خير أب","https://www.aldiwan.net/poem9460.html","البسيط"],[43,"حاشى الرقيب فخانته ضمائره","https://www.aldiwan.net/poem9571.html","البسيط"],[43,"ومنتسب عندي إلى من أحبه","https://www.aldiwan.net/poem9730.html","الطويل"],[62,"طبيعتنا التي لا ظل فيها","https://www.aldiwan.net/poem52197.html","الوافر"],[62,"يا نفس إياك إن نابتك نائبة","https://www.aldiwan.net/poem52483.html","البسيط"],[45,"بودي لو يهوى العذول ويعشق","https://www.aldiwan.net/poem65199.html","الطويل"],[45,"قولوا لسرجس يا ابن القحبة الشبقه","https://www.aldiwan.net/poem65212.html","الخفيف"],[45,"مغنيك للبغض فيه سمه","https://www.aldiwan.net/poem66635.html","البسيط"],[28,"ولكني اطمأن حشاي لما","https://www.aldiwan.net/poem5060.html","الوافر"],[28,"إلى ابن أبي الوليد عدت ركابي","https://www.aldiwan.net/poem5170.html","الوافر"],[28,"ألم خيال من علية بعدما","https://www.aldiwan.net/poem5318.html","الطويل"],[28,"لعمري لقد نبهت يا هند ميتا","https://www.aldiwan.net/poem5649.html","الطويل"],[28,"لعمرك ما تجزي مفداة شقتي","https://www.aldiwan.net/poem5651.html","الطويل"],[66,"لا أوحش الله ممن حل في خلدي","https://www.aldiwan.net/poem38449.html","البسيط"],[66,"من لم تضم الضيوف ساحته","https://www.aldiwan.net/poem38549.html","المنسرح"],[66,"تحجر فيك طبع الشح يبسا","https://www.aldiwan.net/poem38616.html","الوافر"],[66,"أطعت ما سن أعدائي وما فرضوا","https://www.aldiwan.net/poem40104.html","البسيط"],[97,"لا القوم راحوا بأخبارٍ ولا جاؤوا","https://www.aldiwan.net/poem24349.html","البسيط"],[97,"لعينيك احتملنا ما احتملنا","https://www.aldiwan.net/poem24770.html","الوافر"],[44,"أتدري أي بارقة تشيم","https://www.aldiwan.net/poem30002.html","الوافر"],[44,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[69,"في حلب قاض على مالك","https://www.aldiwan.net/poem29149.html","السريع"],[74,"وتيقن أن الله أكرم جيرة","https://www.aldiwan.net/poem13224.html","الطويل"],[74,"أفي ما تؤدي الريح عرف سلام","https://www.aldiwan.net/poem13260.html","الطويل"],[81,"يا محسنا حسنا قد صال منظره","https://www.aldiwan.net/poem61356.html","الكامل"],[102,"سل جنة الشعر ما ألوى بدوحتها","https://www.aldiwan.net/poem32925.html","البسيط"],[102,"إلى الحبيب الذي فا","https://www.aldiwan.net/poem33094.html","المجتث"],[22,"لا يبعد الله إذ ودعت أرضهم","https://www.aldiwan.net/poem22065.html","البسيط"],[52,"ألا ما لقلب لا تقضى حوائجه","https://www.aldiwan.net/poem27179.html","الطويل"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[48,"عاج الشقي على دار يسائلها","https://www.aldiwan.net/poem62547.html","البسيط"],[48,"أسير الهم نائي الصبر عان","https://www.aldiwan.net/poem65309.html","الوافر"],[48,"ومنتبه بين الندامى رأيته","https://www.aldiwan.net/poem66274.html","الطويل"],[48,"راح الشقي على دار يسائلها","https://www.aldiwan.net/poem66592.html","البسيط"],[50,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[46,"سحائب مبرقات مرعدات","https://www.aldiwan.net/poem22152.html","الوافر"],[46,"قلمت ظفري تارات وما جسدي","https://www.aldiwan.net/poem22292.html","البسيط"],[46,"لعمري الخير الذخر في كل شدة","https://www.aldiwan.net/poem23557.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39556","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16634","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19247","الوافر"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30453","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42644","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42504","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54724","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54572","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23663","الوافر"],[106,"صحا الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179625",""],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[77,"إخواننا لا تنسوا الفضل والعطفا","https://www.poetsgate.com/ViewPoem.aspx?id=34184",""],[84,"ويح الكتابة من شيخ هبنقة","https://www.poetsgate.com/ViewPoem.aspx?id=26322",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[45,"أعجب لظلم زماننا المتواتر","https://www.poetsgate.com/ViewPoem.aspx?id=31274",""],[51,"ومُنْزل الوحْي علي نبيِّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30760",""],[51,"كُفي الدموع وإن كان الفراقُ غَدَاً","https://www.poetsgate.com/ViewPoem.aspx?id=27698",""]],"verses":[["وَمُنتَزِعٍ مِن بَينِ جَنبَيهِ زَفرَةً","تُخَلّي دُموعَ العَينِ في الهَمَلانِ",0,"ن",1,0],["وَمُنتَصِرٍ يَرعى بِحِلمٍ حُقودَهُ","وَيَطرُدُ أَضغانَ العِدا بِالتَكَرُّمِ",1,"م",1,0],["وَمُنتَجِعٍ أَرضَ العَدوِّ تَخالُهُ","جِبالَ شَرَورى طُلنَ مَيثاً وَأَجرَعا",2,"ع",2,0],["وَمُنتَزِحٍ جَمّاتِ عَينَيكَ راجِعاً","إِلى غَزرِ ماءٍ لا بَكِيءٍ وَلا نَزرِ",3,"ر",1,0],["وَمُنتَجِعينَ دِيارَ العَدُوِّ","في كُلِّ مُضطَرِمٍ ذي أُوارِ",4,"ر",1,0],["ومنْ تمنّى أنْ يَنالَ شأْوَها","هَوى بهِ إِلى العَناءِ ما هَوى",5,"ا",1,0],["ومُنتَعِلاتٍ بالنَّجيعِ زَجَرْتُها","وهُنَّ بقايا هَجْمَةٍ سَوْطُها الزَّجْرُ",6,"ر",1,0],["وَمَن تُسبى حَليلَتُهُ وَتُمسي","مُفَجَّعَةً لَها دَمعٌ يَسيلُ",7,"ل",1,0],["ومُنْتَقِشِ المَتْنِ كالمِبْرَدِ","إذا هبّ عرْفُ النّسيمِ النّدي",8,"ي",1,1],["وَمَنْ تُنِيرُ الدُّجَى","آرَاؤُهُ إِنْ كَتَبْ",9,"ب",1,0],["وَمُنتابٍ أَناخَ إِلى بِلالٍ","فَلا زَهِداً أَصابَ وَلا اِعتِلالا",10,"ل",2,0],["وَمُنتَزِعٍ مِن بَينِ نِسعَيهِ جِرَّةً","نَشيجِ الشَجا جآءَت إِلى ضِرسِهِ نَزرا",11,"ر",2,0],["ومَن تك الحال فيها لا تساعده","فليُسعِد النطق أن لم تسعد الحال",12,"ل",1,0],["ومن تفن بعد الموت آثار مجده","فآثار روحي الخالديّ خوالد",13,"د",1,0],["ومِنْ تَعَدِّيه ومن إلوائِهِ","بالحق إذ جَارَ على أعدائِهِ",14,"ا",3,0],["ومُنتقباتٌ بالضياءِ وضاءةً","كما هنَّ بالظَّلْماء مُعتجراتُ",15,"ت",1,0],["ومَنْ تُنقِذُوهُ تَضْمَنُوا ما يُعِيشُهُ","وما تَغْرِسُوه لا يَزَلْ يُتعهّدُ",16,"د",1,0],["ومن تحلّى من الآداب أحسنها","فما يرى أحدٌ في ظَرفِهِ أحدا",17,"د",2,0],["ومِن تَعدّيه أنه أبداً","يعتدُّ نفعاً لعبده ضرره",18,"ر",2,0],["ومن تسوَّقَ مرتاعاً بسلعته","مستشعرَ الخوفِ مملوءاً من الوجلِ",19,"ل",1,0],["ومن تُسْلِموهُ لأيّامِهِ","ففي شظفٍ لازبٍ لازمِ",20,"م",1,0],["ومن تَحْرِمْهُ رِفدكَ بعد مَدْح","فحسبُكَ مدْحُه من كلّ شتم",21,"م",1,0],["ومنْ تَحلَّى بعين أبصرها","من حيث لا يتوارى شخصها العمم",22,"م",1,0],["ومن تحصن منخوباً على وَجَلٍ","فإنما حِصنهُ سجنٌ لمسجونِ",23,"ن",1,0],["ومن تَحصَّنَ محبوساً على أجلٍ","فإنما حِصنه سجْنٌ لمسجون",24,"ن",1,0],["وَمُنتَقِمٍ لا يَأمَنُ الناسُ فَجعَهُ","وَلا سَورَةَ العادي إِذا هُوَ أَوعَدا",25,"د",2,0],["وَمُنتَحِلٍ مِنّي العَداوَةَ نالَهُ","عَناجيجُ أَفراسٍ إِذا شاءَ أَلجَما",26,"م",2,0],["وَمَن تَعَرَّضَ لِلغِربانِ يَزجُرُها","عَلى سَلامَتِهِ لابُدَّ مَشؤومُ",27,"م",1,0],["وَمِن تَحتِ الزَنانيرِ","خُصورٌ كَالزَنابيرِ",28,"ر",1,0],["ومن تَعْبُدُ النُّورَ أَحلامهُ","يُبارِكُهُ النُّورُ أَنَّى ظَهَرْ",29,"ر",1,0],["ومن تزوج لا عن خبرة سبقت","فانما خطبه في داره جلل",30,"ل",1,0],["ومن تتراخ مدته فيكثر","من الأحباب لا يحص النعيا",31,"ي",2,0],["وَمَن تَخافُ أَن يَبيعَ دينَه","تَكفيكَ مِنهُ صُحبَةُ السَفينَه",32,"ه",1,0],["وَمَن تركَبُ ساقَيهِ","مِنَ الهِندِ إِلى السِندِ",33,"د",1,0],["وَمَن تُظهِرِ النارُ في دارِهِ","وَفي زَرعِهِ مِنهُمو يَرعَبِ",34,"ب",1,0],["وَمِن تَلاميذي موسى الَّذي","أوحِيَ مِن بَعدُ إِلَيهِ فَهاد",35,"د",1,0],["وَمَن تَضحَكِ الدُنيا إِلَيهِ فَيَغتَرِر","يَمُت كَقَتيلِ الغيدِ بِالبَسَماتِ",36,"ت",1,0],["وَمِن تَثَنّي الغيدِ عَن بانِهِ","مُرتَجَّةَ الأَردافِ عَن كُثبِهِ",37,"ب",2,0],["وَمَن تَكُنِ الأُسدُ الضَواري جُدودَهُ","يَكُن لَيلُهُ صُبحاً وَمَطعَمُهُ غَصبا",38,"ب",2,0],["وَمَن تَفَكَّرَ في الدُنيا وَمُهجَتِهِ","أَقامَهُ الفِكرُ بَينَ العَجزِ وَالتَعَبِ",39,"ب",1,0],["وَمَن تَوَهَّمتُ أَنَّ البَحرَ راحَتُهُ","جوداً وَأَنَّ عَطاياهُ جَواهِرُهُ",40,"ر",2,0],["وَمُنتَسِبٍ عِندي إِلى مَن أُحِبُّهُ","وَلِلنُبلِ حَولي مِن يَدَيهِ حَفيفُ",41,"ف",1,1],["ومن تقليبنا طبقات هذي ال","أراضي لاحت السبل الفجاجُ",42,"ج",1,0],["ومن تَطامنُ للدنيا غواربُهُ","لم يخلُ من نَصَبٍ فيها ومن وَصَبِ",43,"ب",1,0],["وَمُنتَسِباتٍ لِلوَجيهِ وَلاحِقٍ","كُمَيتٌ يَسُرُّ الناظِرينَ وَأَبلَقُ",44,"ق",1,0],["وَمَن تَذَلُّ لِوَقعِ الصَفعِ هامَتُهُ","ذُلَّ الحُلوقِ الَّتي بِالحَبلِ مُختَنِقَه",45,"ق",2,0],["وَمُنتَشِرُ الحَلقِ واهي اللَهاةِ","إِذا ما شَدا فاحِشُ الغَلصَمَه",46,"م",2,0],["وَمَن تَعقِد لَهُ بِيَدَيكَ حَبلاً","فَقَد أَخَذَت يَداهُ لَهُ الخِيارا",47,"ر",2,0],["وَمَن تَطلُب مَساعيكُم يَداهُ","إِلى بَعضِ العُلى يَومَ الفَخارِ",48,"ر",1,0],["وَمُنتَحِرٍ بِالبيدِ يَصدَعُ بَينَها","عَنِ القورِ أَن مَرَّت بِها مُتَجانِفِ",49,"ف",1,0],["وَمُنتَكِثٍ عَلَّلتُ مُلتاثَهُ بِهِ","وَقَد كَفَّنَ اللَيلُ الخُروقَ الخَوالِيا",50,"ي",2,0],["وَمُنتَجِعٍ دارَ العَدُوِّ كَأَنَّهُ","نَشاصُ الثُرَيّا يَستَظِلُّ العَوالِيا",51,"ي",2,0],["ومن تباعد عن عيني فلو نظرت","إليه كادت لفرط البعد تنكره",52,"ه",1,0],["وَمَن تَمادى في شُحِّهِ نَفَرَت","مِن قُربِهِ الناسُ أَيَّما نَفرَه",53,"ر",2,0],["وَمَن تَكُ هَذِهِ الأَعراضُ فيهِ","وَلَم يُعرَف لَهُ بِالعَذلِ عِرضُ",54,"ض",1,0],["وَمَن تَعَرَّضَ لي حَتّى أُعارِضُهُ","يَوماً فَيُعرِضُ عَنّي ثُمَّ يَعتَرِضُ",55,"ض",1,0],["ومَن تنفستُ حرَّ الوجدِ في فمه","فما ارتويتُ وهذا الريُّ إِظماءُ",56,"ا",2,0],["ومنتظرٌ بأبصاري وسمعي","كما انتظرتكَ أيامي جميعا",57,"ع",2,0],["وَمِن تَقليبِ قَلبي عَن لِساني","إِذا باتَت تُقَلِّبُهُ الهُمومُ",58,"م",1,0],["وَمَن تَيَّمَت سُمرُ الحِسانِ وَأُدمُها","فَمازِلتَ بِالسُمرِ العَوالي مُتَيَّما",59,"م",2,0],["ومَنْ تَلَكّا معهُ قال قمْ","قدْ قيلَ لي إنكَ زنديقُ",60,"ق",1,0],["وَمَن تَكُ أَيّامُ السُرورِ قَصيرَةً","بِهِ كانَ لَيلُ الحُزنِ فيهِ طَويلا",61,"ل",2,0],["وَمُنتَصِبٍ كَالرُمحِ هِزَّةَ عِزَّةٍ","وَفَتكَةَ بَأسٍ وَاِستِواءَ قَوامِ",62,"م",1,0],["وَمُنتَقِلٍ مُستَقبِلٍ كَعبَةَ العُلى","يُصَلّي بِأَهليها صَلاةَ زُؤامِ",62,"م",1,0],["وَمَن تُحَدّثُ جَدوَاهُ وَسِيرَتُهُ","فِي الجُودِ وَالعَدلِ عن كعبِ وَعن عُمَرِ",63,"ر",1,0],["وَمَن تَصَدّى يَردُّ السَيلَ مُزدَحِماً","لَما تَحَدَّر مِن شُمِّ الأَهاضيبِ",64,"ب",1,0],["وَمَن تَعلّمَ مِنهُ الص","صُدودَ طَيفُ خَيالِه",65,"ل",2,0],["وَمَن تُلاقيهِ بِالمَعروفِ مُبتَهِجاً","إِذا اِجرَهَدَّ صَفا المَذمُومِ أَو صَلَدا",66,"د",2,0],["وَمُنتَصِرٍ بِالغُصنِ وَالحُسنِ وَالنَقا","وَصُدغٍ أُديرَت فَوقَ وَردٍ صَوالِجُه",67,"ج",2,0],["ومَنْ تَكُنْ بِرَسُولِ اللهِ نُصْرَتُهُ","إنْ تَلْقَهُ الأُسْدُ في أجامِها تَجِمِ",68,"م",1,0],["وَمَن تَميمٌ وَمَن قَيسٌ وَإِخوَتُهُم","لَيسَ الأَعاريبُ عِندَ اللَهِ مِن أَحَدِ",69,"د",1,0],["وَمُنتَسِبٍ إِلى آباءِ صِدقٍ","خَطَبتُ لَهُ مُعَتَّقَةَ الدِنانِ",70,"ن",1,0],["ومنتبهٍ بين الندامى رأيتهُ","وقد نام أهلُ البيت دبّ إلى الساقي",71,"ق",2,1],["ومن تميم ومن بكرٌ وجمعُها","ليس الأعاريبُ عند اللِه من أحدِ",72,"د",1,0],["وَمُنتَهى غايَةِ الوُفودِ إِذا","ساروا يُرَجّونَ وَصلَهُ رَغَبا",73,"ب",2,0],["وَمَن تُخلِقهُ أَيّامٌ طِوالٌ","فَإِنَّ شُجونَهُ مُتَجَدِّداتُ",74,"ت",1,0],["وَمِن تَأَمَّل أَقوالي رَأى جُمَلاً","يَظَلُّ فيهِنَّ سِرُّ الناسِ مَشروحا",75,"ح",2,0],["وَمَن تُرِكَ العِلجُ المُعَرِّدُ راتِعاً","بِأَفيَحَ يَقرو في الخَلاءِ خَلاهُ",76,"ل",3,0],["ومن تَلَهُّفِ أحنائي وثارتها","يا للجوانح من وجدي وثاراتي",77,"ي",1,0],["ومن تعلق به حمة الأفاعي","يعش إن فاته أجل عليلا",78,"ل",2,0],["وَمَن تَتَراخَ مُدَّتُهُ فَيُكثِر","مِنَ الأَحبابِ لا يُحصي النَعِيّا",79,"ي",2,0],["ومُنْتِنِ الرِّيحِ إِنْ نَاجَيتَهُ أَبداً","كأَنَّما مات في خَيْشُومِهِ فارُ",80,"ر",1,0],["وَمَنَّت عَلى تَيمٍ تَميمٌ بِنِعمَةٍ","وَما عِندَ تَيمٍ مِن وَفاءٍ وَلا شُكرِ",81,"ر",1,0],["وَمَنْ تَرَبَّصَ بِالإِخْوَانِ بَادِرَهً","مِنَ الزَّمَانِ فَإِنَّ اللَّهَ قَاهِرُهُ",82,"ر",2,0],["وَمَنْ تَكُنِ العَلْياءُ هِمَّةَ نَفْسِهِ","فَكُلُّ الَّذِي يَلْقَاهُ فيها مُحَبَّبُ",83,"ب",1,0],["وَمَنْ تَدْعُهُ يِرْدُدْ نِدَاءَكَ لاَ يُجِبْ","كَمَا رَجَّعَالصَّخْرُ الأَصَم لَكَ الصَّدَى",84,"د",2,0],["وَمَنْ تَفَيَأَ ظِلاًّ مِنْ مُروءَتِهِ","أَوَى إلى مَأْمَنٍ مِنْ صَوْلَةِ الْنُّوَبِ",85,"ب",1,0],["وَمَن تَلا تَسمَع عَلى","ضَعفكَ حَتّى أَسَرَك",86,"ك",1,0],["ومن تسخط عليه فذو اغترابٍ","وإن لم يمسِ في بلدٍ شطير",87,"ر",1,0],["ومن تَمَّ بالله إيمانُهُ","رأى الصخْرَ في يده عِثْيَرا",88,"ر",2,0],["ومن تُربها يُنضجون الطعامَ","ومن عشبها يَنسجون الرداء",89,"ا",2,0],["ومنتجز فينا من الله وعده","فلا نكث في وعد الإله ولا خلفا",90,"ف",2,0],["ومنتن الريح إن ناحيته أبدا","كأنما مات في خيشومه فار",91,"ر",1,0],["ومنتحلينَ سِماتِ الأديبِ","يظنّونها جُبَباً تُرتدى",92,"ا",1,0],["ومن تبعات النُّفوس الكبار","بسِنِّ اليَراعِ الرخيصِ احتمى",92,"ا",1,0],["ومَنْ تُبَرِّحْ تَكاليفُ الحياةِ به","ويَلْمِسُ الرَّوْحَ في مَوتٍ تمنَّاه",93,"ا",2,0],["ومنتعتني الإنصاف منك، ولم تكن","تأباه في بر ولا في فاجر",94,"ر",1,0],["ومن تعديِّه على ذئبيه","ليَجتني لي الصَّفْوَ من مَجْنيه",95,"ه",1,0],["ومن تحلى من الآداب أحسنها","فما يرى أحدٌ في ظَرفِهِ حدا",96,"د",2,0]]}