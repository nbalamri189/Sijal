 دهور","https://www.aldiwan.net/poem48177.html","عموديه"],[536,"شبل القساور من أبناء مزوار","https://www.aldiwan.net/poem48190.html","عموديه"],[536,"عرفت مقام القوم إذ بت تجهد","https://www.aldiwan.net/poem48236.html","عموديه"],[549,"يا حامل الكأس ناولني مشعشعة","https://www.aldiwan.net/poem47138.html","البسيط"],[549,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[549,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[549,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[549,"دع الغنى لبنيه","https://www.aldiwan.net/poem47302.html","المجتث"],[549,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[549,"ومنتقبات بالجمال على منى","https://www.aldiwan.net/poem47763.html","الطويل"],[549,"ومنتقبات بالجمال أتيننا","https://www.aldiwan.net/poem47839.html","الطويل"],[549,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[549,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[551,"ومنتجع حمدي بأكرم رائد","https://www.aldiwan.net/poem68386.html","الطويل"],[556,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[556,"من حينا جاءنا طيب الهوى ناشق","https://www.aldiwan.net/poem33511.html","المواليا"],[556,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[556,"إياك أن تحتقر بين الورى ذره","https://www.aldiwan.net/poem34463.html","المواليا"],[556,"عيون العلا نحو السعيد نواظر","https://www.aldiwan.net/poem34548.html","الطويل"],[556,"إن رمت بالمثل التقريب مقتصدا","https://www.aldiwan.net/poem34599.html","البسيط"],[560,"لكل قلب حبيب ظل يهواه","https://www.aldiwan.net/poem52742.html","البسيط"],[560,"عوجا على غرب لبنان الذي اشتهرا","https://www.aldiwan.net/poem52843.html","البسيط"],[560,"وقفت مدحي فلا يطمع به أحد","https://www.aldiwan.net/poem52857.html","البسيط"],[561,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[565,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"تداركه قبل البين فاليوم عهده","https://www.aldiwan.net/poem17487.html","الطويل"],[585,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[585,"بعزك يا ذا الكبرياء والمراحم","https://www.aldiwan.net/poem11517.html","عموديه"]],"verses":[["وَمُنتَزِعٍ مِن بَينِ جَنبَيهِ زَفرَةً","تُخَلّي دُموعَ العَينِ في الهَمَلانِ",0,"ن",1,0],["وَمُنتَصِرٍ يَرعى بِحِلمٍ حُقودَهُ","وَيَطرُدُ أَضغانَ العِدا بِالتَكَرُّمِ",1,"م",1,0],["وَمُنتَجِعٍ أَرضَ العَدوِّ تَخالُهُ","جِبالَ شَرَورى طُلنَ مَيثاً وَأَجرَعا",2,"ع",2,0],["وَمُنتَزِحٍ جَمّاتِ عَينَيكَ راجِعاً","إِلى غَزرِ ماءٍ لا بَكِيءٍ وَلا نَزرِ",3,"ر",1,0],["وَمُنتَجِعينَ دِيارَ العَدُوِّ","في كُلِّ مُضطَرِمٍ ذي أُوارِ",4,"ر",1,0],["ومنْ تمنّى أنْ يَنالَ شأْوَها","هَوى بهِ إِلى العَناءِ ما هَوى",5,"ا",1,0],["ومُنتَعِلاتٍ بالنَّجيعِ زَجَرْتُها","وهُنَّ بقايا هَجْمَةٍ سَوْطُها الزَّجْرُ",6,"ر",1,0],["وَمَن تُسبى حَليلَتُهُ وَتُمسي","مُفَجَّعَةً لَها دَمعٌ يَسيلُ",7,"ل",1,0],["ومُنْتَقِشِ المَتْنِ كالمِبْرَدِ","إذا هبّ عرْفُ النّسيمِ النّدي",8,"ي",1,1],["وَمَنْ تُنِيرُ الدُّجَى","آرَاؤُهُ إِنْ كَتَبْ",9,"ب",1,0],["وَمُنتابٍ أَناخَ إِلى بِلالٍ","فَلا زَهِداً أَصابَ وَلا اِعتِلالا",10,"ل",2,0],["وَمُنتَزِعٍ مِن بَينِ نِسعَيهِ جِرَّةً","نَشيجِ الشَجا جآءَت إِلى ضِرسِهِ نَزرا",11,"ر",2,0],["ومَن تك الحال فيها لا تساعده","فليُسعِد النطق أن لم تسعد الحال",12,"ل",1,0],["ومن تفن بعد الموت آثار مجده","فآثار روحي الخالديّ خوالد",13,"د",1,0],["ومِنْ تَعَدِّيه ومن إلوائِهِ","بالحق إذ جَارَ على أعدائِهِ",14,"ا",3,0],["ومُنتقباتٌ بالضياءِ وضاءةً","كما هنَّ بالظَّلْماء مُعتجراتُ",15,"ت",1,0],["ومَنْ تُنقِذُوهُ تَضْمَنُوا ما يُعِيشُهُ","وما تَغْرِسُوه لا يَزَلْ يُتعهّدُ",16,"د",1,0],["ومن تحلّى من الآداب أحسنها","فما يرى أحدٌ في ظَرفِهِ أحدا",17,"د",2,0],["ومِن تَعدّيه أنه أبداً","يعتدُّ نفعاً لعبده ضرره",18,"ر",2,0],["ومن تسوَّقَ مرتاعاً بسلعته","مستشعرَ الخوفِ مملوءاً من الوجلِ",19,"ل",1,0],["ومن تُسْلِموهُ لأيّامِهِ","ففي شظفٍ لازبٍ لازمِ",20,"م",1,0],["ومن تَحْرِمْهُ رِفدكَ بعد مَدْح","فحسبُكَ مدْحُه من كلّ شتم",21,"م",1,0],["ومنْ تَحلَّى بعين أبصرها","من حيث لا يتوارى شخصها العمم",22,"م",1,0],["ومن تحصن منخوباً على وَجَلٍ","فإنما حِصنهُ سجنٌ لمسجونِ",23,"ن",1,0],["ومن تَحصَّنَ محبوساً على أجلٍ","فإنما حِصنه سجْنٌ لمسجون",24,"ن",1,0],["وَمُنتَقِمٍ لا يَأمَنُ الناسُ فَجعَهُ","وَلا سَورَةَ العادي إِذا هُوَ أَوعَدا",25,"د",2,0],["وَمُنتَحِلٍ مِنّي العَداوَةَ نالَهُ","عَناجيجُ أَفراسٍ إِذا شاءَ أَلجَما",26,"م",2,0],["وَمَن تَعَرَّضَ لِلغِربانِ يَزجُرُها","عَلى سَلامَتِهِ لابُدَّ مَشؤومُ",27,"م",1,0],["وَمِن تَحتِ الزَنانيرِ","خُصورٌ كَالزَنابيرِ",28,"ر",1,0],["ومن تَعْبُدُ النُّورَ أَحلامهُ","يُبارِكُهُ النُّورُ أَنَّى ظَهَرْ",29,"ر",1,0],["ومن تزوج لا عن خبرة سبقت","فانما خطبه في داره جلل",30,"ل",1,0],["ومن تتراخ مدته فيكثر","من الأحباب لا يحص النعيا",31,"ي",2,0],["وَمَن تَخافُ أَن يَبيعَ دينَه","تَكفيكَ مِنهُ صُحبَةُ السَفينَه",32,"ه",1,0],["وَمَن تركَبُ ساقَيهِ","مِنَ الهِندِ إِلى السِندِ",33,"د",1,0],["وَمَن تُظهِرِ النارُ في دارِهِ","وَفي زَرعِهِ مِنهُمو يَرعَبِ",34,"ب",1,0],["وَمِن تَلاميذي موسى الَّذي","أوحِيَ مِن بَعدُ إِلَيهِ فَهاد",35,"د",1,0],["وَمَن تَضحَكِ الدُنيا إِلَيهِ فَيَغتَرِر","يَمُت كَقَتيلِ الغيدِ بِالبَسَماتِ",36,"ت",1,0],["وَمِن تَثَنّي الغيدِ عَن بانِهِ","مُرتَجَّةَ الأَردافِ عَن كُثبِهِ",37,"ب",2,0],["وَمَن تَكُنِ الأُسدُ الضَواري جُدودَهُ","يَكُن لَيلُهُ صُبحاً وَمَطعَمُهُ غَصبا",38,"ب",2,0],["وَمَن تَفَكَّرَ في الدُنيا وَمُهجَتِهِ","أَقامَهُ الفِكرُ بَينَ العَجزِ وَالتَعَبِ",39,"ب",1,0],["وَمَن تَوَهَّمتُ أَنَّ البَحرَ راحَتُهُ","جوداً وَأَنَّ عَطاياهُ جَواهِرُهُ",40,"ر",2,0],["وَمُنتَسِبٍ عِندي إِلى مَن أُحِبُّهُ","وَلِلنُبلِ حَولي مِن يَدَيهِ حَفيفُ",41,"ف",1,1],["ومن تقليبنا طبقات هذي ال","أراضي لاحت السبل الفجاجُ",42,"ج",1,0],["ومن تَطامنُ للدنيا غواربُهُ","لم يخلُ من نَصَبٍ فيها ومن وَصَبِ",43,"ب",1,0],["وَمُنتَسِباتٍ لِلوَجيهِ وَلاحِقٍ","كُمَيتٌ يَسُرُّ الناظِرينَ وَأَبلَقُ",44,"ق",1,0],["وَمَن تَذَلُّ لِوَقعِ الصَفعِ هامَتُهُ","ذُلَّ الحُلوقِ الَّتي بِالحَبلِ مُختَنِقَه",45,"ق",2,0],["وَمُنتَشِرُ الحَلقِ واهي اللَهاةِ","إِذا ما شَدا فاحِشُ الغَلصَمَه",46,"م",2,0],["وَمَن تَعقِد لَهُ بِيَدَيكَ حَبلاً","فَقَد أَخَذَت يَداهُ لَهُ الخِيارا",47,"ر",2,0],["وَمَن تَطلُب مَساعيكُم يَداهُ","إِلى بَعضِ العُلى يَومَ الفَخارِ",48,"ر",1,0],["وَمُنتَحِرٍ بِالبيدِ يَصدَعُ بَينَها","عَنِ القورِ أَن مَرَّت بِها مُتَجانِفِ",49,"ف",1,0],["وَمُنتَكِثٍ عَلَّلتُ مُلتاثَهُ بِهِ","وَقَد كَفَّنَ اللَيلُ الخُروقَ الخَوالِيا",50,"ي",2,0],["وَمُنتَجِعٍ دارَ العَدُوِّ كَأَنَّهُ","نَشاصُ الثُرَيّا يَستَظِلُّ العَوالِيا",51,"ي",2,0],["ومن تباعد عن عيني فلو نظرت","إليه كادت لفرط البعد تنكره",52,"ه",1,0],["وَمَن تَمادى في شُحِّهِ نَفَرَت","مِن قُربِهِ الناسُ أَيَّما نَفرَه",53,"ر",2,0],["وَمَن تَكُ هَذِهِ الأَعراضُ فيهِ","وَلَم يُعرَف لَهُ بِالعَذلِ عِرضُ",54,"ض",1,0],["وَمَن تَعَرَّضَ لي حَتّى أُعارِضُهُ","يَوماً فَيُعرِضُ عَنّي ثُمَّ يَعتَرِضُ",55,"ض",1,0],["ومَن تنفستُ حرَّ الوجدِ في فمه","فما ارتويتُ وهذا الريُّ إِظماءُ",56,"ا",2,0],["ومنتظرٌ بأبصاري وسمعي","كما انتظرتكَ أيامي جميعا",57,"ع",2,0],["وَمِن تَقليبِ قَلبي عَن لِساني","إِذا باتَت تُقَلِّبُهُ الهُمومُ",58,"م",1,0],["وَمَن تَيَّمَت سُمرُ الحِسانِ وَأُدمُها","فَمازِلتَ بِالسُمرِ العَوالي مُتَيَّما",59,"م",2,0],["ومَنْ تَلَكّا معهُ قال قمْ","قدْ قيلَ لي إنكَ زنديقُ",60,"ق",1,0],["وَمَن تَكُ أَيّامُ السُرورِ قَصيرَةً","بِهِ كانَ لَيلُ الحُزنِ فيهِ طَويلا",61,"ل",2,0],["وَمُنتَصِبٍ كَالرُمحِ هِزَّةَ عِزَّةٍ","وَفَتكَةَ بَأسٍ وَاِستِواءَ قَوامِ",62,"م",1,0],["وَمُنتَقِلٍ مُستَقبِلٍ كَعبَةَ العُلى","يُصَلّي بِأَهليها صَلاةَ زُؤامِ",62,"م",1,0],["وَمَن تُحَدّثُ جَدوَاهُ وَسِيرَتُهُ","فِي الجُودِ وَالعَدلِ عن كعبِ وَعن عُمَرِ",63,"ر",1,0],["وَمَن تَصَدّى يَردُّ السَيلَ مُزدَحِماً","لَما تَحَدَّر مِن شُمِّ الأَهاضيبِ",64,"ب",1,0],["وَمَن تَعلّمَ مِنهُ الص","صُدودَ طَيفُ خَيالِه",65,"ل",2,0],["وَمَن تُلاقيهِ بِالمَعروفِ مُبتَهِجاً","إِذا اِجرَهَدَّ صَفا المَذمُومِ أَو صَلَدا",66,"د",2,0],["وَمُنتَصِرٍ بِالغُصنِ وَالحُسنِ وَالنَقا","وَصُدغٍ أُديرَت فَوقَ وَردٍ صَوالِجُه",67,"ج",2,0],["ومَنْ تَكُنْ بِرَسُولِ اللهِ نُصْرَتُهُ","إنْ تَلْقَهُ الأُسْدُ في أجامِها تَجِمِ",68,"م",1,0],["وَمَن تَميمٌ وَمَن قَيسٌ وَإِخوَتُهُم","لَيسَ الأَعاريبُ عِندَ اللَهِ مِن أَحَدِ",69,"د",1,0],["وَمُنتَسِبٍ إِلى آباءِ صِدقٍ","خَطَبتُ لَهُ مُعَتَّقَةَ الدِنانِ",70,"ن",1,0],["ومنتبهٍ بين الندامى رأيتهُ","وقد نام أهلُ البيت دبّ إلى الساقي",71,"ق",2,1],["ومن تميم ومن بكرٌ وجمعُها","ليس الأعاريبُ عند اللِه من أحدِ",72,"د",1,0],["وَمُنتَهى غايَةِ الوُفودِ إِذا","ساروا يُرَجّونَ وَصلَهُ رَغَبا",73,"ب",2,0],["وَمَن تُخلِقهُ أَيّامٌ طِوالٌ","فَإِنَّ شُجونَهُ مُتَجَدِّداتُ",74,"ت",1,0],["وَمِن تَأَمَّل أَقوالي رَأى جُمَلاً","يَظَلُّ فيهِنَّ سِرُّ الناسِ مَشروحا",75,"ح",2,0],["وَمَن تُرِكَ العِلجُ المُعَرِّدُ راتِعاً","بِأَفيَحَ يَقرو في الخَلاءِ خَلاهُ",76,"ل",3,0],["ومن تَلَهُّفِ أحنائي وثارتها","يا للجوانح من وجدي وثاراتي",77,"ي",1,0],["ومن تعلق به حمة الأفاعي","يعش إن فاته أجل عليلا",78,"ل",2,0],["وَمَن تَتَراخَ مُدَّتُهُ فَيُكثِر","مِنَ الأَحبابِ لا يُحصي النَعِيّا",79,"ي",2,0],["ومُنْتِنِ الرِّيحِ إِنْ نَاجَيتَهُ أَبداً","كأَنَّما مات في خَيْشُومِهِ فارُ",80,"ر",1,0],["وَمَنَّت عَلى تَيمٍ تَميمٌ بِنِعمَةٍ","وَما عِندَ تَيمٍ مِن وَفاءٍ وَلا شُكرِ",81,"ر",1,0],["وَمَنْ تَرَبَّصَ بِالإِخْوَانِ بَادِرَهً","مِنَ الزَّمَانِ فَإِنَّ اللَّهَ قَاهِرُهُ",82,"ر",2,0],["وَمَنْ تَكُنِ العَلْياءُ هِمَّةَ نَفْسِهِ","فَكُلُّ الَّذِي يَلْقَاهُ فيها مُحَبَّبُ",83,"ب",1,0],["وَمَنْ تَدْعُهُ يِرْدُدْ نِدَاءَكَ لاَ يُجِبْ","كَمَا رَجَّعَالصَّخْرُ الأَصَم لَكَ الصَّدَى",84,"د",2,0],["وَمَنْ تَفَيَأَ ظِلاًّ مِنْ مُروءَتِهِ","أَوَى إلى مَأْمَنٍ مِنْ صَوْلَةِ الْنُّوَبِ",85,"ب",1,0],["وَمَن تَلا تَسمَع عَلى","ضَعفكَ حَتّى أَسَرَك",86,"ك",1,0],["ومن تسخط عليه فذو اغترابٍ","وإن لم يمسِ في بلدٍ شطير",87,"ر",1,0],["ومن تَمَّ بالله إيمانُهُ","رأى الصخْرَ في يده عِثْيَرا",88,"ر",2,0],["ومن تُربها يُنضجون الطعامَ","ومن عشبها يَنسجون الرداء",89,"ا",2,0],["ومنتجز فينا من الله وعده","فلا نكث في وعد الإله ولا خلفا",90,"ف",2,0],["ومنتن الريح إن ناحيته أبدا","كأنما مات في خيشومه فا