.aldiwan.net/poem52742.html","البسيط"],[563,"عوجا على غرب لبنان الذي اشتهرا","https://www.aldiwan.net/poem52843.html","البسيط"],[563,"وقفت مدحي فلا يطمع به أحد","https://www.aldiwan.net/poem52857.html","البسيط"],[564,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[568,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[587,"تداركه قبل البين فاليوم عهده","https://www.aldiwan.net/poem17487.html","الطويل"],[588,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[588,"بعزك يا ذا الكبرياء والمراحم","https://www.aldiwan.net/poem11517.html","عموديه"]],"verses":[["ومن تَبِعات لازمتها ولم تزل","بها أشكل الأتباع بعد التأول",0,"ل",1,0],["وَمُنتَزِعٍ مِن بَينِ جَنبَيهِ زَفرَةً","تُخَلّي دُموعَ العَينِ في الهَمَلانِ",1,"ن",1,0],["وَمُنتَصِرٍ يَرعى بِحِلمٍ حُقودَهُ","وَيَطرُدُ أَضغانَ العِدا بِالتَكَرُّمِ",2,"م",1,0],["وَمُنتَجِعٍ أَرضَ العَدوِّ تَخالُهُ","جِبالَ شَرَورى طُلنَ مَيثاً وَأَجرَعا",3,"ع",2,0],["وَمُنتَزِحٍ جَمّاتِ عَينَيكَ راجِعاً","إِلى غَزرِ ماءٍ لا بَكِيءٍ وَلا نَزرِ",4,"ر",1,0],["وَمُنتَجِعينَ دِيارَ العَدُوِّ","في كُلِّ مُضطَرِمٍ ذي أُوارِ",5,"ر",1,0],["ومنْ تمنّى أنْ يَنالَ شأْوَها","هَوى بهِ إِلى العَناءِ ما هَوى",6,"ا",1,0],["ومُنتَعِلاتٍ بالنَّجيعِ زَجَرْتُها","وهُنَّ بقايا هَجْمَةٍ سَوْطُها الزَّجْرُ",7,"ر",1,0],["وَمَن تُسبى حَليلَتُهُ وَتُمسي","مُفَجَّعَةً لَها دَمعٌ يَسيلُ",8,"ل",1,0],["ومُنْتَقِشِ المَتْنِ كالمِبْرَدِ","إذا هبّ عرْفُ النّسيمِ النّدي",9,"ي",1,1],["وَمَنْ تُنِيرُ الدُّجَى","آرَاؤُهُ إِنْ كَتَبْ",10,"ب",1,0],["وَمُنتابٍ أَناخَ إِلى بِلالٍ","فَلا زَهِداً أَصابَ وَلا اِعتِلالا",11,"ل",2,0],["وَمُنتَزِعٍ مِن بَينِ نِسعَيهِ جِرَّةً","نَشيجِ الشَجا جآءَت إِلى ضِرسِهِ نَزرا",12,"ر",2,0],["ومَن تك الحال فيها لا تساعده","فليُسعِد النطق أن لم تسعد الحال",13,"ل",1,0],["ومن تفن بعد الموت آثار مجده","فآثار روحي الخالديّ خوالد",14,"د",1,0],["ومِنْ تَعَدِّيه ومن إلوائِهِ","بالحق إذ جَارَ على أعدائِهِ",15,"ا",3,0],["ومُنتقباتٌ بالضياءِ وضاءةً","كما هنَّ بالظَّلْماء مُعتجراتُ",16,"ت",1,0],["ومَنْ تُنقِذُوهُ تَضْمَنُوا ما يُعِيشُهُ","وما تَغْرِسُوه لا يَزَلْ يُتعهّدُ",17,"د",1,0],["ومن تحلّى من الآداب أحسنها","فما يرى أحدٌ في ظَرفِهِ أحدا",18,"د",2,0],["ومِن تَعدّيه أنه أبداً","يعتدُّ نفعاً لعبده ضرره",19,"ر",2,0],["ومن تسوَّقَ مرتاعاً بسلعته","مستشعرَ الخوفِ مملوءاً من الوجلِ",20,"ل",1,0],["ومن تُسْلِموهُ لأيّامِهِ","ففي شظفٍ لازبٍ لازمِ",21,"م",1,0],["ومن تَحْرِمْهُ رِفدكَ بعد مَدْح","فحسبُكَ مدْحُه من كلّ شتم",22,"م",1,0],["ومنْ تَحلَّى بعين أبصرها","من حيث لا يتوارى شخصها العمم",23,"م",1,0],["ومن تحصن منخوباً على وَجَلٍ","فإنما حِصنهُ سجنٌ لمسجونِ",24,"ن",1,0],["ومن تَحصَّنَ محبوساً على أجلٍ","فإنما حِصنه سجْنٌ لمسجون",25,"ن",1,0],["وَمُنتَقِمٍ لا يَأمَنُ الناسُ فَجعَهُ","وَلا سَورَةَ العادي إِذا هُوَ أَوعَدا",26,"د",2,0],["وَمُنتَحِلٍ مِنّي العَداوَةَ نالَهُ","عَناجيجُ أَفراسٍ إِذا شاءَ أَلجَما",27,"م",2,0],["وَمَن تَعَرَّضَ لِلغِربانِ يَزجُرُها","عَلى سَلامَتِهِ لابُدَّ مَشؤومُ",28,"م",1,0],["وَمِن تَحتِ الزَنانيرِ","خُصورٌ كَالزَنابيرِ",29,"ر",1,0],["ومن تَعْبُدُ النُّورَ أَحلامهُ","يُبارِكُهُ النُّورُ أَنَّى ظَهَرْ",30,"ر",1,0],["ومن تزوج لا عن خبرة سبقت","فانما خطبه في داره جلل",31,"ل",1,0],["ومن تتراخ مدته فيكثر","من الأحباب لا يحص النعيا",32,"ي",2,0],["وَمَن تَخافُ أَن يَبيعَ دينَه","تَكفيكَ مِنهُ صُحبَةُ السَفينَه",33,"ه",1,0],["وَمَن تركَبُ ساقَيهِ","مِنَ الهِندِ إِلى السِندِ",34,"د",1,0],["وَمَن تُظهِرِ النارُ في دارِهِ","وَفي زَرعِهِ مِنهُمو يَرعَبِ",35,"ب",1,0],["وَمِن تَلاميذي موسى الَّذي","أوحِيَ مِن بَعدُ إِلَيهِ فَهاد",36,"د",1,0],["وَمَن تَضحَكِ الدُنيا إِلَيهِ فَيَغتَرِر","يَمُت كَقَتيلِ الغيدِ بِالبَسَماتِ",37,"ت",1,0],["وَمِن تَثَنّي الغيدِ عَن بانِهِ","مُرتَجَّةَ الأَردافِ عَن كُثبِهِ",38,"ب",2,0],["وَمَن تَكُنِ الأُسدُ الضَواري جُدودَهُ","يَكُن لَيلُهُ صُبحاً وَمَطعَمُهُ غَصبا",39,"ب",2,0],["وَمَن تَفَكَّرَ في الدُنيا وَمُهجَتِهِ","أَقامَهُ الفِكرُ بَينَ العَجزِ وَالتَعَبِ",40,"ب",1,0],["وَمَن تَوَهَّمتُ أَنَّ البَحرَ راحَتُهُ","جوداً وَأَنَّ عَطاياهُ جَواهِرُهُ",41,"ر",2,0],["وَمُنتَسِبٍ عِندي إِلى مَن أُحِبُّهُ","وَلِلنُبلِ حَولي مِن يَدَيهِ حَفيفُ",42,"ف",1,1],["ومن تقليبنا طبقات هذي ال","أراضي لاحت السبل الفجاجُ",43,"ج",1,0],["ومن تَطامنُ للدنيا غواربُهُ","لم يخلُ من نَصَبٍ فيها ومن وَصَبِ",44,"ب",1,0],["وَمُنتَسِباتٍ لِلوَجيهِ وَلاحِقٍ","كُمَيتٌ يَسُرُّ الناظِرينَ وَأَبلَقُ",45,"ق",1,0],["وَمَن تَذَلُّ لِوَقعِ الصَفعِ هامَتُهُ","ذُلَّ الحُلوقِ الَّتي بِالحَبلِ مُختَنِقَه",46,"ق",2,0],["وَمُنتَشِرُ الحَلقِ واهي اللَهاةِ","إِذا ما شَدا فاحِشُ الغَلصَمَه",47,"م",2,0],["وَمَن تَعقِد لَهُ بِيَدَيكَ حَبلاً","فَقَد أَخَذَت يَداهُ لَهُ الخِيارا",48,"ر",2,0],["وَمَن تَطلُب مَساعيكُم يَداهُ","إِلى بَعضِ العُلى يَومَ الفَخارِ",49,"ر",1,0],["وَمُنتَحِرٍ بِالبيدِ يَصدَعُ بَينَها","عَنِ القورِ أَن مَرَّت بِها مُتَجانِفِ",50,"ف",1,0],["وَمُنتَكِثٍ عَلَّلتُ مُلتاثَهُ بِهِ","وَقَد كَفَّنَ اللَيلُ الخُروقَ الخَوالِيا",51,"ي",2,0],["وَمُنتَجِعٍ دارَ العَدُوِّ كَأَنَّهُ","نَشاصُ الثُرَيّا يَستَظِلُّ العَوالِيا",52,"ي",2,0],["ومن تباعد عن عيني فلو نظرت","إليه كادت لفرط البعد تنكره",53,"ه",1,0],["وَمَن تَمادى في شُحِّهِ نَفَرَت","مِن قُربِهِ الناسُ أَيَّما نَفرَه",54,"ر",2,0],["وَمَن تَكُ هَذِهِ الأَعراضُ فيهِ","وَلَم يُعرَف لَهُ بِالعَذلِ عِرضُ",55,"ض",1,0],["وَمَن تَعَرَّضَ لي حَتّى أُعارِضُهُ","يَوماً فَيُعرِضُ عَنّي ثُمَّ يَعتَرِضُ",56,"ض",1,0],["ومَن تنفستُ حرَّ الوجدِ في فمه","فما ارتويتُ وهذا الريُّ إِظماءُ",57,"ا",2,0],["ومنتظرٌ بأبصاري وسمعي","كما انتظرتكَ أيامي جميعا",58,"ع",2,0],["وَمِن تَقليبِ قَلبي عَن لِساني","إِذا باتَت تُقَلِّبُهُ الهُمومُ",59,"م",1,0],["وَمَن تَيَّمَت سُمرُ الحِسانِ وَأُدمُها","فَمازِلتَ بِالسُمرِ العَوالي مُتَيَّما",60,"م",2,0],["ومَنْ تَلَكّا معهُ قال قمْ","قدْ قيلَ لي إنكَ زنديقُ",61,"ق",1,0],["وَمَن تَكُ أَيّامُ السُرورِ قَصيرَةً","بِهِ كانَ لَيلُ الحُزنِ فيهِ طَويلا",62,"ل",2,0],["وَمُنتَصِبٍ كَالرُمحِ هِزَّةَ عِزَّةٍ","وَفَتكَةَ بَأسٍ وَاِستِواءَ قَوامِ",63,"م",1,0],["وَمُنتَقِلٍ مُستَقبِلٍ كَعبَةَ العُلى","يُصَلّي بِأَهليها صَلاةَ زُؤامِ",63,"م",1,0],["وَمَن تُحَدّثُ جَدوَاهُ وَسِيرَتُهُ","فِي الجُودِ وَالعَدلِ عن كعبِ وَعن عُمَرِ",64,"ر",1,0],["وَمَن تَصَدّى يَردُّ السَيلَ مُزدَحِماً","لَما تَحَدَّر مِن شُمِّ الأَهاضيبِ",65,"ب",1,0],["وَمَن تَعلّمَ مِنهُ الص","صُدودَ طَيفُ خَيالِه",66,"ل",2,0],["وَمَن تُلاقيهِ بِالمَعروفِ مُبتَهِجاً","إِذا اِجرَهَدَّ صَفا المَذمُومِ أَو صَلَدا",67,"د",2,0],["وَمُنتَصِرٍ بِالغُصنِ وَالحُسنِ وَالنَقا","وَصُدغٍ أُديرَت فَوقَ وَردٍ صَوالِجُه",68,"ج",2,0],["ومَنْ تَكُنْ بِرَسُولِ اللهِ نُصْرَتُهُ","إنْ تَلْقَهُ الأُسْدُ في أجامِها تَجِمِ",69,"م",1,0],["وَمَن تَميمٌ وَمَن قَيسٌ وَإِخوَتُهُم","لَيسَ الأَعاريبُ عِندَ اللَهِ مِن أَحَدِ",70,"د",1,0],["وَمُنتَسِبٍ إِلى آباءِ صِدقٍ","خَطَبتُ لَهُ مُعَتَّقَةَ الدِنانِ",71,"ن",1,0],["ومنتبهٍ بين الندامى رأيتهُ","وقد نام أهلُ البيت دبّ إلى الساقي",72,"ق",2,1],["ومن تميم ومن بكرٌ وجمعُها","ليس الأعاريبُ عند اللِه من أحدِ",73,"د",1,0],["وَمُنتَهى غايَةِ الوُفودِ إِذا","ساروا يُرَجّونَ وَصلَهُ رَغَبا",74,"ب",2,0],["وَمَن تُخلِقهُ أَيّامٌ طِوالٌ","فَإِنَّ شُجونَهُ مُتَجَدِّداتُ",75,"ت",1,0],["وَمِن تَأَمَّل أَقوالي رَأى جُمَلاً","يَظَلُّ فيهِنَّ سِرُّ الناسِ مَشروحا",76,"ح",2,0],["وَمَن تُرِكَ العِلجُ المُعَرِّدُ راتِعاً","بِأَفيَحَ يَقرو في الخَلاءِ خَلاهُ",77,"ل",3,0],["ومن تَلَهُّفِ أحنائي وثارتها","يا للجوانح من وجدي وثاراتي",78,"ت",2,0],["ومن تعلق به حمة الأفاعي","يعش إن فاته أجل عليلا",79,"ل",2,0],["وَمَن تَتَراخَ مُدَّتُهُ فَيُكثِر","مِنَ الأَحبابِ لا يُحصي النَعِيّا",80,"ي",2,0],["ومُنْتِنِ الرِّيحِ إِنْ نَاجَيتَهُ أَبداً","كأَنَّما مات في خَيْشُومِهِ فارُ",81,"ر",1,0],["وَمَنَّت عَلى تَيمٍ تَميمٌ بِنِعمَةٍ","وَما عِندَ تَيمٍ مِن وَفاءٍ وَلا شُكرِ",82,"ر",1,0],["وَمَنْ تَرَبَّصَ بِالإِخْوَانِ بَادِرَهً","مِنَ الزَّمَانِ فَإِنَّ اللَّهَ قَاهِرُهُ",83,"ر",2,0],["وَمَنْ تَكُنِ العَلْياءُ هِمَّةَ نَفْسِهِ","فَكُلُّ الَّذِي يَلْقَاهُ فيها مُحَبَّبُ",84,"ب",1,0],["وَمَنْ تَدْعُهُ يِرْدُدْ نِدَاءَكَ لاَ يُجِبْ","كَمَا رَجَّعَالصَّخْرُ الأَصَم لَكَ الصَّدَى",85,"د",2,0],["وَمَنْ تَفَيَأَ ظِلاًّ مِنْ مُروءَتِهِ","أَوَى إلى مَأْمَنٍ مِنْ صَوْلَةِ الْنُّوَبِ",86,"ب",1,0]