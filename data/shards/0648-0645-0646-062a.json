,"ق",2,0],["ومن تبهر الراجي عطاياه كثرة","فيرتاع جبنا عند أخذ العطية",116,"ه",1,0],["ومن تكن يا ابن إسمعيل مفزعه","قضى له بالنجاة النجم والفلك",117,"ك",1,0],["ومن تكن من عقاب الله دولته","فان ملكك من غفرانه جعلا",118,"ل",2,0],["ومن تره يمشى على الماء في الهوى","ولم تعتبر بالشرع حرما ولا حلا",119,"ل",2,0],["وَمُنتجٍ أُمُّ أَبيهِ أُمُّهُ","لَم يَتَخَوَّن جِسمَهُ مَسّ الضوى",120,"ا",1,0],["وَمَن تَكُ نُزهَتهُ قَينَةٌ","وَكَأسٌ تُحَثُّ وَأُخرى تُصَب",121,"ب",1,1],["وَمَن تلكُمُ آباؤُهُ وَجدودُهُ","فَمَن ذا يُسامي فَخرَهُ أَو يُقارِبُهْ",122,"ب",2,0],["وَمَن تَكُن صُحبَةُ الأَملاكِ هِمَّتُهُ","مَضى على الهَولِ مَمضى البازِلِ السَدِمِ",123,"م",1,0],["ومن تقلّب أطوار الزمان بكم","كأنما هو حرباء بأعواد",124,"د",1,0],["وَمَن تَرَكْتَ لِفعلِ المُكرَماتِ تُرى","إِذا الأَكُفُّ شَكَت مِن دونِهِ شَلَلا",125,"ل",2,0],["وَمَن تَرَكْتَ لَنا بَعدَ ابنِ بجدتِها","يَحلُّ مُستَغلِقَ المَعنى إِذا اِشتَكَلا",125,"ل",2,0],["ومن تك بئره في دار قوم","تعود وماؤُها أبداً حبيسُ",126,"س",1,0],["ومن تعجّب من أحداثه عجبي","عن قوله وهو ذو علم بمنقلبه",127,"ب",2,0],["ومنتظر موتي ليحلس موضعي","فقلت انتظر ما شئت فالله لي حسبي",128,"ي",1,1],["ومن تؤوِهِ دارٌ فيجحدُ فضلها","يكن حيواناً فوقه كل أعجمِ",129,"م",1,0],["ومن تنفس من أنفاسه نَفَساً","لم يرضَ ما عاش أن يشتمَّ ريحانا",130,"ن",2,0],["ومن تكن انت في الدارين ملجأه","فليس خوف عليه لا ولا وجل",131,"ل",1,0],["ومن تجانس فقري بالنوال اذا","ما عنه اعربت الاسجاع والفقر",132,"ر",1,0],["ومن تبع جسمها بشيءٍ","فقلبها مقفرٌ جديبُ",133,"ب",1,0],["ومن تصاريف ليلٍ","بالداء يدجو نجوت",134,"ت",1,0],["ومنتشر بالمتنِ أسودُ طائلٌ","يَفُّت الغوالي من عقيصتهِ المِشْطُ",135,"ط",1,0],["ومن تراب خلقنا","ما في تراب كمال",136,"ل",1,0],["ومن تكدَّر عندي","لرزئه صفوُ دهري",137,"ي",1,0],["وَمَنَّت مُحالاً وَغَنَّت مِطالا","وَصَدَّت مَلالاً وَمَلَّت دِلالا",138,"ل",2,0],["وَمَن تَخِفُّ حُلومُ ال","رِجالِ وَهوَ وَقورُ",139,"ر",1,0],["وَمَن تَبَقّاهُ الرَدى مِنهُم","في الأَسرِ مَكبوكٌ وَمَصفودُ",140,"د",1,0],["وَمَن تَنفُرُ الجِنُّ مِن وَجهِهِ","وَتَخشى المَكارِهِ مِن وَجنَتَه",14