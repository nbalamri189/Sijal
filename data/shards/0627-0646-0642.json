,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"حفل المولد","https://www.poetsgate.com/ViewPoem.aspx?id=179555",""],[106,"في ربا الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179685",""],[106,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[106,"أنف كبير","https://www.poetsgate.com/ViewPoem.aspx?id=179740",""],[106,"مصر تناجي المعلمين","https://www.poetsgate.com/ViewPoem.aspx?id=179599",""],[106,"سمر الأدباء","https://www.poetsgate.com/ViewPoem.aspx?id=179454",""],[106,"ديك غير وديك","https://www.poetsgate.com/ViewPoem.aspx?id=179736",""],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[50,"منَعَ النَّوْمَ طارقٌ منْ «حُبابهْ»","https://www.poetsgate.com/ViewPoem.aspx?id=17108",""],[98,"مؤتمر الجماد","https://www.poetsgate.com/ViewPoem.aspx?id=55343",""],[54,"ماذا أَقولُ إِذا أَتيتُ مَعَاشِري","https://www.poetsgate.com/ViewPoem.aspx?id=14465",""],[45,"طَفِقَتْ تَلومُ وَلاتَ حينَ مَلامِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=185700",""],[80,"قُمْ هَاتِها من كف ذاتِ الوِشاحْ","https://www.poetsgate.com/ViewPoem.aspx?id=3054",""],[46,"سُبحانَ ربّكَ! هل يزولُ، كغيرِه،","https://www.poetsgate.com/ViewPoem.aspx?id=20281",""],[99,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[51,"للناس عيدٌ ولي عيدانِ في العيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=27703",""],[31,"لَيْتَ شِعْرِي هَلْ أَذُوقَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18779&r=&rc=42",""],[31,"","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18967&r=&rc=230",""]],"verses":[["إِن قَلَّصَ الدَهرُ ما أَضفاهُ مِن جِدَةٍ","فَصَنعَةُ الدَهرِ إِعطاءٌ وَحِرمانُ",0,"ن",1,0],["أَنقاهُمُ جَيباً إِذا","عُدّوا وَأَملَسُهُم أَديما",1,"م",2,0],["إِن قيلَ إِقدامٌ فَأَنتَ شُجاعُها","أَو قيلَ إِعطاءٌ فَأَنتَ كَريمُها",2,"م",3,0],["إِن قامَ خَفَّت بِهِ شَمائِلُهُ","أَو سارَ خَفَّت بِوَطئِهِ القَدَمُ",3,"م",1,0],["إِن قَعَدَ الخَطبُ إِلَيهِ قاما","حَتّى يُرَوّي الرُمحَ وَالحُساما",4,"م",2,0],["إِن قَطَّعَ الآمالَ مِنكَ فَإِنَّهُ","مِن بَعدِ يَومِكَ قَطَّعَ الأُمّالا",5,"ل",2,0],["إِنَّ قِوامَ الدينِ عَن","ثَغرِ العُلى مُناضِلُ",6,"ل",1,0],["اِن قالَ فيكَ عِداكَ مَنقَصَةً","قالوا السَماءُ أَديمُها نَغِلُ",7,"ل",1,0],["إِنَّ قَولَ الجَوادِ يَتبَعُهُ الفِع","لُ كَما يَتبَعُ الوَظيفَ الوَظيفُ",8,"ف",1,0],["إِن قَطَعَ الراعي عَليها لَم تُبَل","أَشبَعَها الخِذرافُ أَم أَجاعَها",9,"ع",3,0],["إِن قارَبوا فَهُمُ الشِهادُ المُجتَنى","وَإِذا أَبوا فَهُمُ السِمامُ المُنقَعُ",10,"ع",1,0],["إِنَّ قَومي صَدَّعَتهُم نَوبَةٌ","شِقَقَ البُردِ اليَمانِيِّ يُعَطّ",11,"ط",1,0],["أُنَقِّلُ النَفسَ من صَبرٍ إِلى جَزَعٍ","وَالصَبرُ أَعوَدُ إِلّا أَنَّهُ صَبِرُ",12,"ر",1,0],["إِنَّ قِوامَ الدينِ أَو","لى بِالعُلى مِنَ البَشَر",13,"ر",1,0],["إِن قُوَّضَت تِلكَ القِبابُ فَإِنَّما","خَرَّت عِمادُ الدينِ قَبلَ عِمادِها",14,"د",3,0],["إِن قَطَعَ المَوتُ بَينَنا فَلَقَد","عِشنا وَما حَبلُنا بِمُنقَضِبِ",15,"ب",1,0],["إنْ قصّرَتْ أجْفانُنا عنْ أنْ تُرَى","تَبْكي النّجيعَ علَيْكَ باستِحْقاقِ",16,"ق",1,0],["إِنْ قَالَ حُكْمِيَ فِيهَا بِالسَّوَاءِ فَقَدْ","أَمِنْتُ مَا يَحْذَرُ الْقَاضِي مِنَ الْغُصَصِ",17,"ص",1,0],["إِنَّ قَيساً قَيسَ الفِعالِ أَبا الأَش","عَثِ أَمسَت أَعداؤُهُ لِشَعوبِ",18,"ب",1,0],["اِنقِر فَقَد بَلَغتَ قَعرَ اللَحدِ","وَهامَةً وَشِقَّةً مِن بُردِ",19,"د",1,0],["أَن قَد أَجُدُّ الحَبلَ مِنهُ إِذا","يا قَتلُ ما حَبلُ القَرينِ شَكَل",20,"ل",1,0],["أَنَقِمتَ مِنّا أَن نُحِسَّ وَإِنَّما","هَذا الَّذي تَدعو إِلَيهِ وَتَندُبُ",21,"ب",1,0],["إِنَّ قَومي اسِتَعذَبوا وِردَ الرَدى","كَيفَ تَدعونِيَ أَلّا أَشرَبا",22,"ب",2,0],["إِن قامَ مِنّا مُنادٍ قالَ قائِلُهُم","لا تَصخَبوا فَهَلاكُ الشَعبِ في الصَخَبِ",23,"ب",1,0],["إِنَّ قَومي تَروقُهُم جِدَّةُ الثَو","بِ وَلا يَعشَقونَ غَيرَ الرُواءِ",24,"ا",2,0],["إِن قالَ شِعراً فَراحٌ","تُدارُ في يَومِ دَجنِ",25,"ن",1,0],["إِن قالَ شِعراً أَو تَسَنَّمَ مِنبَراً","فَتَعَوُّذاً بِاللَهِ مِن شَيطانِهِ",26,"ن",2,0],["أَنقَذتَها مِن خُطَّةِ الخَسفِ الَّتي","كانَت أَحلَّتها الحَضيضَ الأَوهَدا",27,"د",2,0],["إِن قَرَّتِ العَينُ بِأَن أَؤوبا","لَم آلُ أَن أَستَرضِيَ الغَضوبا",28,"ب",2,0],["إِن قَسا الدَهرُ فَلِلماءِ","مِنَ الصَخرِ انبِجاسُ",29,"س",1,0],["أَنْقَذَهَا مُحْتَسِباً رَبَّهُ","بِهَا وَنِعْمَتْ حِسْبَةُ الآخِرَهْ",30,"ر",2,0],["إِنْ قَصَّرَ الجَيْشُ أَغْرَى الرَّأْيَ أَمْكِنَةً","مَا فَازَ خَاتِلُهَا مِنْهَا بِإِمْكَانِ",31,"ن",1,0],["إِنَّ قَبْراً تُزَارُ فِيهِ لَرَوْضٌ","قَدْ كَسَاهُ الرَّيْحَانُ وَالنِّسْرِينُ",32,"ن",1,0],["إِنْ قَالَ مَا قَالَ إِخْوَانِي لِتَكْرِمَتِي","فَهَلْ أَنَا غَيْرُ مِرْآةٍ إِخْوَانِي",33,"ي",1,0],["أَنْقَذْتُمَا مَجْدَ الْحِمَى مِنْ رِيبَةٍ","وَأَرَحْتُمَا الصَّرْعَى مِنَ الأَقْرَانِ",34,"ن",1,0],["إِن قُلتُ أَعطاني كَذَبتُ وَإِن أَقُل","ضَنَّ الجَوادُ بِمالِهِ لَم يَجمُلِ",35,"ل",1,0],["إِنَّ قَلبي مُعلَّقٌ بِنِساءٍ","وَاضحَاتِ الخُدُودِ لَسنَ بِهُجنِ",36,"ن",1,1],["أَنقاءُ سارِيَةٍ حَلَّت عَزالِيَها","مِن آخِرِ اللَيلِ ريحٌ غَيرُ جُرجوجِ",37,"ج",1,0],["أن قدس القداس يغضب من أن","تتوارى وسامة الأجسام",38,"م",1,0],["إن قيل هذا شهدكم","مُرّ فقولوا علقم",39,"م",1,0],["أن قام للحَرْث ردّ الأرض مُمرعة","أو قام للحرب دكّ السهل والجبَلا",40,"ل",2,0],["إن قلبي قد استطير بمنعا","ه اختطافاً بمنسر الآلام",41,"م",1,0],["إِن قيلَ لِلرَكبِ سيروا وَالمَها حَرِجٌ","هَزَّت عَلابِيَها الهوجُ الهَراجيبُ",42,"ب",1,0],["إِن قالَ صُحبَتُكَ الرَواحَ فَقُل لَهُم","حَيّوا الغُزَيزَ وَمَن بِهِ مِن حاضِرِ",43,"ر",1,0],["انقَذَ الله شِلوَنَا من شَفا النَّ","ار بِهِ نِعمَةً من المِنعَامِ",44,"م",1,0],["إن قِيلَ قِيلُوا فَفَوقَ أرحُلِها","أو عَرِّسُوا فالذَّمِيلُ والخَبَبُ",45,"ب",1,0],["إِن قَصَّرَ الجُهدُ عَن إِدراكِ غايَتِهِ","فَأَعذَرُ الناسِ مَن أَعطاكَ ماوَجَدا",46,"د",2,0],["إِن قالَ سيروا أَجَدّوا السَيرَ جَهدَهُمُ","أَو قالَ عوجوا عَلَينا ساعَةً رَبَعوا",47,"ع",3,0],["إن قلتُ ذا الشرط منك شرطي","قال وهذا الجزا جزائي",48,"ي",1,0],["إنَّ قلبي لكم لَكَالكبدِ الح","رّي وقلبي لغيركم كالقلوب",49,"ب",1,0],["إن قلت ما أقبحها","قلت وما أحرُّها",50,"ه",2,0],["إن قصَّرت في مدحةٍ مع بذلها","جهداً فلا والله ما قصرَ الدّعا",51,"ع",2,0],["إن قلتُ لا كذَّبني الناس أو","قلتُ نعم كذَّبني حالي",52,"ل",2,0],["إن قيل إنَّ سمنديار لشخصه","نسبٌ فللعرب الخلاص لسانه",53,"ن",2,0],["إن قيل للظبيِ هنا إلمام","فاكْسر وقل ليقم الغلام",54,"م",1,0],["إن قالَ قولاً بين الغرائبا","وقام قسّ في عكاظ خاطبا",54,"ب",2,0],["إن قَضَى طبَّقَ المفاصلَ أو سا","ءَلَ أعيا أو قال قال مصيبا",55,"ب",2,0],["إن قال لا قالها للآمرين بها","ولم يقلْها لمن يستمنِح المِنحا",56,"ح",2,0],["إن قاد صنُوُكَ جَيْشَ العيدِ عُقْبَتَهُ","فما اخْتَلَلْتَ لفقْدِ الجيش في العيدِ",57,"د",1,0],["إن قِيلَ سَيْفَان يأبى الغِمْدُ جمْعَهُما","فأنْتُما مُنْصَلا سَلٍّ وتجْريدِ",57,"د",1,0],["إن قال إن النفس وا","حدةٌ فإنَّ الموتَ واحدْ",58,"د",1,0],["أن قد تولَّى الزمامَ صاحبُهُ","بحكمةٍ أحكمت له مِرَره",59,"ر",2,0],["إن قوماً أصبحت تَنفُق فيهم","لعلى خُطّةٍ من التسخير",60,"ر",1,0],["أنقضتَ عزمكَ ليت شعري فيهما","حاشا لعزمكِ في الندى أن يُنقضا",61,"ض",2,0],["أنَّ قدْري لديْكَ مَنْعِيَ بَغْلاً","ذاك أمْرٌ أبَتْهُ لي أعْراقُك",62,"ك",1,0],["إنْ قال قالوا ما يقولُ وإن أبى","فضلاً أبَوْه فما عداهُ تثقُّلُ",63,"ل",1,0],["أن قد نزعتُ عن انبساطي نادماً","ولتنزعنَّ عن اعتدائك نادما",64,"م",2,0],["أنقذ الصُّبْحُ شِلْوَهُ من شفا المو","تِ فأضحى يعلو رؤوس الأكام",65,"م",1,0],["أنقِذُوا سَبْيَهُمْ وقلَّ لهُمْ ذا","ك حفاظاً ورعْيَةً للذِّمام",66,"م",1,0],["إن قعدتُمْ عن اللعينِ فأنْتُمْ","شركاءُ اللَّعينِ في الآثامِ",66,"م",1,0],["إنْ قال لا قالها للآمريهِ بها","ردَّاً لآمرِهِ الغاوِي وعِصيانا",67,"ن",2,1],["إِن قيلَ إِنَّكَ صِرتَ شَيخاً","قُل أَجَل شَيخُ الشَباب",68,"ب",1,0],["إِنَّ قَصراً سَمَكتُهُ سَوفَ يَندَكُّ","وَثَوباً حَبَكتَهُ سَوفَ يَنقَد",69,"د",1,0],["إِن قَسا الدَهرُ فَإِن","نَ اللَهَ بِالناسِ رَحيمُ",70,"م",1,0],["إِنَّ قَلبي لَو تَجَنّى","وَهُوَ قَلبي ماصَحِبتُهُ",71,"ت",2,0],["أنقذيني من الأَسى فلقدْ أَمْسَ","يْتُ لا أستطيعُ حملَ وجودي",72,"د",2,0],["أنْقذيني فقد سئمتُ ظلامي","أنقذيني فقدْ مَلِلْتُ ركودي",72,"د",2,0],["إنَّ قَلْبِي مَلَّ أَصْداءَ النُّوَاحْ","غَنِّنِي يَا صَاحْ",73,"ح",1,0],["أَنقى مِنَ الموج الوضيءِ","ومِنْ نَشيد العَندليبْ",74,"ب",1,0],["انقاد للموت الزؤام ومن يعش","عمرا طويلا لا ابالك ينقد",75,"د",1,0],["انقدوا نفسي آخذين عليها","كونها في حب الحياة تغالي",76,"ي",1,0],["انقضت ظهري الحياة فلا اد","ري متى ارمي عبئها الممقوتا",77,"ت",2,1],["ان قلب الشيخ الكبير كطفل","لم يشأ عن غلوائه اقلاعا",78,"ع",2,0],["أن قلب الذين وُلُّوا علينا","حجرٌ من أقسى الحجارة صلد",79,"د",1,0],["إن قلت كذبا فنفسي","تعضني بالملامه",80,"م",2,0],["انقضت تلكم العهود فآهٍ","ثم آهٍ مني لتلك العهود",81,"د",1,0],["اِنقَلب العَمُّ فَصارَ غَمّا","وَفَدح الأَمرُ بِهِ وَطَمّا",82,"م",2,0],["إِن قُلتَ في الأَمرِ لا أَو قُلتَ فيهِ نَعَم","فَخيرَةُ اللَهِ في لا مِنكَ أَو نَعَمِ",83,"م",1,0],["إِن قُلتُ تِمثالَ الجَمالِ مُنَصَّباً","قالَ الجَمالُ بِراحَتَيَّ مَثَلتُهُ",84,"ت",2,0],["إِنْ قِيدَ جاءكَ زينةً أَوْ ريضَ رِيْ","ضَ بِنَيّةً أو رِيعَ رِيعَ ظَلِيما",85,"م",2,0],["إِن قُلتَ في ذا البَخورِ سَوقاً","فَهَكَذا قُلتَ في النَوالِ",86,"ل",1,0],["إنّ قوماً فارقتُهم ملكوا الأم","رَ وبيني وبينهم شحناءُ",87,"ا",2,1],["إِن قيلَ رِبعِيُّ الفَخارِ فَإِنَّهُم","مُطِروا بِأَوَّلِ ذَلِكَ الشُؤبوبِ",88,"ب",1,0],["إِن قالَ أَو قُلتُ لَم يُخَف كَذِبي","في حِفظِ أُكرومَةٍ وَلا كَذِبُه",89,"ب",2,0],["إِنَّ قَومي قَومُ الشَريفِ قَديماً","وَحَديثاً أُبُوَّةً وَجُدودا",90,"د",2,0],["إِن قَصَّرَت هِمَمُ العافينَ جاشَ لَهُم","جِحافُ أَغلَبَ في حافاتِهِ الزَبَدُ",91,"د",1,0],["إِن قَلَّ حَمدٌ عادَ في تَكثيرِهِ","أَو رَثَّ مَجدٌ عادَ في تَجديدِهِ",92,"د",2,0],["إِن قَلَّ شُكرُ الأَبعَدينَ فَإِنَّهُ","وَهّابُ عُظمِ طَريفِهِ وَتِلادِهِ",93,"د",2,0],["أَنقَذتَهُم يا أَمينَ اللَهِ مُفتَلِتاً","وَهُم عَلى جُرُفٍ مِن أَمرِهِم هارِ",94,"ر",1,0],["إِنَ قُوَيقاً لَهُ عَلّى يَدٌ","بِالأَمسِ بَيضاءُ لَستُ أَكفُرُها",95,"ر",3,0],["إِن قُدتَهُ يَأبى عَلَيكَ حِرانُهُ","أَو لِنتَ عَضَّ عَلى شَكيمِ الفاسِ",96,"س",1,0],["إِن قُلتَ في خَلقِهِ فَإِنَّكَ لا","تَقولُ إِلّا الجَميلَ في خُلقِه",97,"ق",2,0],["إِن قَلَّلَ المَعروفَ تَأخيرُهُ","كَثَّرَ جَدواهُ بِتَعجيلِها",98,"ل",3,0],["إِن قَلَّلوا هَيبَةً أَو أَكثَروا لَغَطاً","أَصغى بِحِلمٍ وَرَدَّ القَولَ عَن فَهَمِ",99,"م",1,0],["إِن قيلَ رِبعِيٌّ فَمِن آبائِهِ","أَو قيلَ قَحتَبَةٌ فَمِن أَعمامِهِ",100,"م",2,0],["أَن قَد مَضَت لي مِنكَ حُسنُ صَنيعَةٍ","وَالراقِصاتِ بِنُمرُقٍ وَشَليلِ",101,"ل",1,0],["أَنُقتَلُ فيكُم إِذ قَتَلنا عَدُوَّكُم","عَلى دينِكُم وَالحَربُ بادٍ قَتامُها",102,"م",3,0],["إنْ قَالَ قَالَ بمِا يَهْوَي‌ جَمِيعُهُمُ","وَإنْ تَكَلَّمَ يَوْماً زَانَهُ الكَلِمُ",103,"م",1,0],["أنقذوا ماء وجهنا يوم لاحو","فأضاءت وجوهنا السوداء",104,"ا",2,0],["إنْ قَطَّبَ البُخَلاءُ أسفرَ وجههُ","أو أسرَفُوا في المَنْعِ جارَ فأسرَفا",105,"ف",2,0],["إِنقِطاعُ الأَيّامِ عَنّي سَريعُ","إِنَّ ما عِندَ اللَهِ لَيسَ يَضيعُ",106,"ع",1,1],["إِن قَدَّرَ اللَهُ أَمراً كانَ مَفعولا","وَكَيفَ نَجهَلُ أَمراً لَيسَ مَجهولا",107,"ل",2,1],["إِن قَلَّ نَفعُكَ في أَرضٍ حَلَلتَ بِها","سافِر لِتُدرِكَ قَصداً أَو تَرى أَمَلا",108,"ل",2,1],["إِن قالَ هُبّوا لَها كانَ السُرورُ لَهُ","في النائِباتِ عَلى ما قالَ بُرهانا",109,"ن",2,0],["إِن قالَ لَهُ اِمرُؤٌ سَلامٌ","قالَت وَعَلَيكُمُ السَلامُ",110,"م",1,0],["إِن قيلَ قَد رُمتَ في الهَوى بَدَلاً","فَاِنظُر فَليسَ العِيانُ كَالخَبَرِ",111,"ر",1,0],["إِنَّ قَتلَ المُحِبِّ في","هِ حَلالٌ وَطَيِّبُ",112,"ب",1,0],["إِن قَضَيتُ فيهِ أَسىً","فَهوَ بَعضُ ما يَجِبُ",113,"ب",1,0],["إِن قَصَّرَ لَفظي فَإِنَّ طَولَكَ قَد طال","ما مَن فَعَلَ البِرَّ الجَميلَ كَمَن قال",114,"ل",1,1],["إِن قُلتُ مِلتَ عَلى المُتَيَّمِ قالَ لي","أَرأَيتَ غُصناً لا يَميلُ وَيَنثَني",115,"ي",1,0],["إِن قَصُرَت مِنّي إِلَيكَ الخُطى","ما قَصُرَت مِنّي يَدُ الإِمتِداح",116,"ح",1,0],["إِن قَلتَ في الشِعرِ حُكمٌ وَالبَيانُ بِهِ","سِحرٌ فَرَغَّبتَ فيهِ كُلِّ ذي فَرَقِ",117,"ق",1,0],["إنَّ قلب العظيم ياقوتةً تس","مو سمواً وتزدهي بالنارِ",118,"ر",1,0],["أنقذني البحر غير أني","غريق فضل بلا قرار",119,"ر",1,0],["إنْ قيل بَدّلْ بُدّلَتْ نَغْمَةٌ","منه كأنّ الجِدّ منها مُزاح",120,"ح",1,0],["إِنَّ قَلبي عَلَيكَ في كُلِّ وَصلٍ","وَصُدودٍ أَرَقُّ مِن خَدَّيكا",121,"ك",2,0],["إِنَّ قَلبي لَكُم لَكالكَبِدِ الحَر","رى وَقَلبي لِغَيرِكُم كَالقُلوبِ",122,"ب",1,0],["إِنْ قَالَ بَرَّ وَإِنْ أَتَاهُ مُطَرَّدٌ","آوَى وَإِنْ سُئِلَ الْكَرَامَةَ لانَا",123,"ن",2,0],["إنْ قلَّعتْ في البرِّ أشجاراً فكمْ","في البحرِ يوماً شجَّرتْ أقلاعا",124,"ع",2,0],["إنْ قيلَ عنها مالها قامةٌ","فالشمسُ والبدرُ بلا قامَهْ",125,"ه",1,0],["إنْ قالَ صفْ لي عذاري وَصْفَ مبتكر","ووجنتي قلتُ خذْ يا صنعةَ الباري",126,"ي",1,1],["إنَّ قصابَكُمْ لهُ حسنُ وجهٍ","يفتنُ الناسَ فهْو يذكي ويذبحْ",127,"ح",1,1],["إنْ قلتُ قدْ سلبتَني","يقولُ شغْلُ الفقرا",128,"ر",2,0],["إنْ قلتُ قدِّم بغلتي قالَ بغلتي","ويشخرُ لي بالموصليِّ ويَزْوُرُ",129,"ر",1,0],["إنَّ قبراً قدْ حواها","قدْ حوى بدراً وغُصنا",130,"ن",2,0],["إنْ قَطَّعَ الشوقُ قلباً أنتَ ساكنُهُ","فالغمدُ يبليهِ صونُ الصارمِ الذكرِ",131,"ر",1,0],["إنْ قلتَ رشفُ ريقهِ ما حُلِّلا","تقلْ بلا علمٍ ولا تحسُ الطلا",132,"ل",2,0],["إنْ قبلَتْ منْ بعدهم ساكناً","فلا سقاها وابلُ القطْرِ",133,"ر",1,0],["إن قالَ صفني وصِفْ رفيقي","قلتُ لهُ تاركَ التحابي",134,"ي",1,1],["إن قال لي صفْ عذاري وصفَ مبتكرِ","ووجنتي قلتُ خذْ يا صنعةَ الباري",135,"ي",1,1],["انقلبَ الحبرُ على","ثوبكَ فابْشر بالأدبْ",136,"ب",1,1],["إنْ قلت قدُّكِ غصنٌ","قالتْ له الغصنُ ساجدْ",137,"د",1,1],["إنْ قيلَ هلْ أنتَ برا","يقلْ نعمْ أنا بغّا",138,"غ",2,0],["إِنَّ قَلبي بَعدَ الَّذي نالَ مِنها","كَالمُعَنّى عَن سائِرِ النِسوانِ",139,"ن",1,0],["إِنَّ قَلبي لَفيكُمُ اليَومَ رَهنٌ","لِشَقائي وَحُبِّ أَهلِ العِراقِ",140,"ق",1,0],["إِنَّ قَلبي إِخالُهُ","عَنكُمُ غَيرَ عائِقِ",141,"ق",1,0],["إِنَّ قَصري أَن يُشعَرَ القَلبُ سُقماً","مِن سُلَيمى مُخامِراً وَاِشتِياقا",142,"ق",2,0],["إِن قَد فَخَرتَ وَقَفتَ كُلِّ مُفاخِرٍ","وَإِلَيكَ في الشَرَفِ الرَفيعِ المَقصَدُ",143,"د",1,0],["إِنَّ قَلبي ما زالَ مِن أُمِّ عَمروٍ","ضَمِناً بَعدَ لَيلَةِ التَحصيبِ",144,"ب",1,0],["إِنَّ قَلبي فَاِعلَميهِ","كُلَّ يَومٍ في وَجيبِ",145,"ب",1,0],["إِن قَد سَلَوتُ عَنِ النِساءِ سِواكُمُ","وَهَجَرتُهُنَّ فَحُبُّكُم طِبّي",146,"ي",1,0],["إِن قالَ عُذّالُهُ مَهلاً فُلانٌ لَهُم","قالَ الهَوى غَيرُ هَذا القَولِ يُعنيني",147,"ي",1,0],["إنْ قَالَ قائلُكم ما كان أكْرَمَهُ","لو زادنا زِدْتُكم حُبَّا وإجلالا",148,"ل",2,0],["أنقذتَ هذي الأرضَ من آلامِها","وشفيتَ هذا العالمَ المحموما",149,"م",2,0],["أنقذوا العالمَ من أرزائه","وأَذاقوه أفاويقَ النَّعمْ",150,"م",1,0],["أنْقِذِي العالمَ مِن آلامِهِ","واكْشِفي ما اعْتادَ مِن أوهامِهِ",151,"ه",1,0],["أَنقِذوا الأَوطانَ مِن غَمرَتِها","وَاِكشِفوها غُمَّةً ما تَنحَسِرْ",152,"ر",1,0],["إِن قامَ عَرشُ المُستَبِدِّ فَإِنَّما","قامَت قَواعِدُهُ عَلى بُركانِ",153,"ن",1,0],["انقلبْ يا أبا بَصيرَ فليسَ ال","دينُ دينُ الهُدَاةِ غَدْراً وإثما",154,"م",2,0],["أنقتلهم بأيدينا فعفواً","رسولَ اللَّهِ إن أَثِمَ الضَّلولُ",155,"ل",1,0],["إِن قاسَمَتهُ الكَلمَ أَنفُسُنا فَكَم","شُفِيَت لَنا بِنَدى يَدَيهِ كِلامُ",156,"م",1,0],["إِن قُلتُ فيهِ هُوَ الكَليمُ فَخَدُّهُ","يُهديكَ مُعجِزَةَ الخَليلِ بِنارِهِ",157,"ر",2,0],["إن قلبي لبلادي","لا لحزبٍ أو زعيمِ",158,"م",1,1],["أَنقذته فَهبَّ يَشدو شَكوراً","مَرِحاً هاتفاً لَها بِالتَحيَّه",159,"ه",1,0],["أَن قَد تَغَيَرَّ بَطنُ مَكَ","ةَ فَهيَ موحِشَةُ الأَباطِح",160,"ح",1,0],["أَنقاءَ وَحشِيِّ الأَلا أَسكانُهُ","فِيها يَقيلُ وَرَعيُها إِخصابُهُ",161,"ب",2,0],["إنَّ قَوْلاً أَطْلَقْتُمُوهُ عَلَى الل","هِ تعالى ذِكْرا لقَوْلٌ هُراءُ",162,"ا",2,0],["أَنقذَ الدينَ بعدَ ما كان للد","دينِ عَلَى كلِّ كُرْبَةٍ إشْفَاءُ",162,"ا",2,0],["أَنْقَذَ الهَلْكَى ورَبَّى اليَتَامى","وفَدَى الأسْرَى وفَكَّ الرِّقابا",163,"ب",2,0],["إنَّ قوماً رَضِيَ اللَّهُ عنهم","ما لنا نُلقَى عليهم غِضَابا",163,"ب",2,0],["إنْ قَالَ ذاكَ هُوَ الدَّوَاءُ فَقُلْ لهُ","كُحْلُ الصَّحِيحِ خِلافَ كُحْلِ الأرْمَدِ",164,"د",1,0],["إنَّ قَلْبِي أَضْحَى إلى ساكِنِيهَا","باشتِياقٍ وَمُهْجَتِي مُسْتَطارَهْ",165,"ر",2,0],["إنَّ قَوْلِي هَزْلاً وَفِعْلَكَ جَدَّاً","مِثْلُ نَبْلِ الحَصَى وَرَشْقِ النِّبَالِ",166,"ل",1,0],["إن قيل مَن خيرُ البريّة لم يكُنْ","إلاّكُمُ خَلْقٌ إليه يُشار",167,"ر",1,0],["إِنَّ قُرَيشاً إِذا هِيَ اِنتَسَبَت","كانَ لَها الشَطرُ مِن مَناسِبِها",168,"ب",3,0],["إِن قُلتُ كُذِّبتُ أَو شَكَوتُ","هانَت عَلى نَفسِهِ شَكاتي",169,"ت",2,0],["إِن قُلتِ مُت مِتُّ في مَكاني","أَو قُلتِ عِش عِشتُ مِن مَماتي",169,"ت",2,0],["إِن قُمتُ لَم يَنتَظِرني","وَغابَ عَنّي السُرورُ",170,"ر",1,0],["إِن قُلتَ ما تَترُكُ قالَ بِرّا","أَو قُلتَ ما تَرهَبُ قالَ بَحرا",171,"ر",2,0],["إِن قالَ لَبَّيكَ لَم تَقنَع بِواحِدَةٍ","حَتّى يُضيفَ إِلى لَبَّيكَ سَعدَيكَ",172,"ك",1,0],["أَنقَذتَنا مِن خَبالِ المُستَعارِ وَقَد","أَوبا البِلادَ عَلَينا رَأيُهُ الخَطِلُ",173,"ل",1,0],["اِنقَضَت شِرَّتي فَعِفتُ المَلاهي","إِذ رَمى الشَيبُ مَفرِقي بِالدَواهي",174,"ه",2,1],["إِن قُلتِ أَقصِر عَنكَ أَقصَرَ قَلبُهُ","وَبَدا عَلَيهِ مِن العَزاءِ نَذيرُ",175,"ر",1,0],["أَن قَد نَصَحتُ لَكُم بِالجودِ مِن جِدَتي","وَهَل تَجودُ يَدٌ إِلّا بِما تَجِدُ",176,"د",1,0],["أَنقَدَت عَينِيَ الكَرى","مَن رَعى الهَمَّ أَنقَدا",177,"د",2,0],["إِنَّ قَد شَفَّني هَواكِ فَأَقصَي","تُ نَصيحي وَالأَلطَفَ المَودودا",178,"د",2,0],["إِن قَلبي آلى وَفيهِ لَجاجٌ","يَومَ بَصَّرتِهِ الهَوى مُستَفيدا",178,"د",2,0],["إِنَّ قَلبي مَلآنُ مِن حُبِّكِ المَح","ضِ فَحَسبي مِن حُبّي ثِنتَينِ حَسبا",179,"ب",2,0],["إِن قامَ يُسرِجُهُ الغُلامُ زَجَرتُهُ","لِزِيادَةٍ مِنهُ وَحَقٍّ واجِبِ",180,"ب",1,0],["إِن قيلَ مَن حَلَبَ الصِبا لِفُؤادِهِ","فَاِذكُر عُبَيدَةَ لَيسَ مِن جُلّابِهِ",181,"ب",2,0],["إِنَّ قَلبي مِثلُ الجَناحِ إِلى مَن","باتَ يَدعو وَأَنتَ غَيرُ مُجيبِ",182,"ب",1,0],["إِنَّ قَلبي يَشُكُّ فيما تُمَنيّ","ني وَنَفسي حَزينَةٌ مُرتابَه",183,"ب",2,0],["اِنقَضَّ كَالكَوكَبِ الدُرِّيِّ مُنصَلِتاً","يَهوي وَيَخلِطُ تَقريباً بِإِحضارِ",184,"ر",1,0],["إِن قُمتُ مِن وبرَةِ هَذا الثَرى","أُهدى إِلى خَضراءَ مِئراجِ",185,"ج",1,0],["إِن قُلتُ صُفّوا بِإِلغازٍ فَمُعتَمَدي","صُفّوا مِنَ الصَفِّ لا صُفّوا مِنَ الكَدَرِ",186,"ر",1,0],["إِن قَلَّتِ السَمراءُ عِندَكَ بُرهَةً","فَاِجزَء بِمَحَضٍ مَرَّةً وَسِمارِ",187,"ر",1,0],["إِن قالَتِ الشُهبُ نَحنُ رَهطٌ","أَقدَمُ مِنهُ فَهُنَّ مانَه",188,"ن",2,0],["أَن قيلَ إِنَّ الرَحيلَ بَعدَ غَدٍ","وَالدارُ بَعدَ الجَميعِ مُفتَرِقَه",189,"ق",2,0],["إِنَّ قَومِي عَزَّ نَصرُهُمُ","قَد شفَوني مِن بَنِي عَنَمَه",190,"م",2,1],["إنْ قرِّبتْ مُرِّطتْ طوابعُها","ما فُضَّ طينٌ لها ولا كُسِرا",191,"ر",2,0],["إِنَّ قلبي يُحِبُّ مِنْ لا أُسَمِّي","في عَنَاءٍ أَعْظِمْ بِهِ مِنْ عَناءِ",192,"ا",2,0],["إن قُلْتُ عندي فيكَ كُلُّ صَبَابَةٍ","قالَ المَلاحةُ لي وكُلُّ الحُسْنِ في",193,"ي",1,0],["إن قُلْتُ خُذِ الرّوح يَقُلْ لي عَجَبَاً","ألرّوحُ لنا فهاتِ من عندِك شَيْ",194,"ي",1,0],["إنَّ قول الحقِّ الصراح على الأح","رار حتى في قبرهم محظور",195,"ر",1,0],["إن قوا جهل البا","طلَ والحقَّ ليشقى",196,"ق",2,0],["إن قد فشلت فَسلوتي","هي أنني لَم آلُ جهدا",197,"د",2,0],["إن قَومي قَد أَفسَدوا لا تذر رب","ب عَلى الأَرض منهمُ ديارا",198,"ر",2,0],["إن قد وزرت بإعلاني مساوئهم","فَلَيسَ يسلم إنسان من الوزر",199,"ر",1,0],["انقلب الألى قد اغتروا","فساء المنقلب",200,"ب",1,0],["إن قستهم بجبال","فَما يَمينُ قياسي",201,"ي",1,0],["أنقاضُها تملأ وجه الثرى","وكنَّ بالأمس مثارَ الفتون",202,"ن",1,0],["أنقنع من حقٍّ وجامعةٍ له","بجمعٍ يديرُ الرأيَ حولَ خوانِ",203,"ن",1,0],["أَنقِذوا الطِفلَ إِنَّ في شَقوَةِ الطِف","لِ شَقاءً لَنا عَلى كُلِّ حالِ",204,"ل",1,0],["أَنقِذوهُ فَرُبَّما كانَ فيهِ","مُصلِحٌ أَو مُغامِرٌ لا يُبالي",204,"ل",2,0],["انقطع النَّظمُ والانقيادُ","وحكمتْ في الشُّكُمِ الجياد",205,"د",1,0],["إنْ قلتُ بحرٌ وجدتُ البحرَ مُنْحَسراً","وبحرُ جودِكَ ممتدُّ العُبابَينِ",206,"ن",1,0],["إِنْ قَالَ خَيْراً فَعَنْ سَهْوٍ أَلَمَّ بِهِ","أَوْ قَالَ شَرَّاً فَعَنْ قَصْدٍ وَإِمْضَاءِ",207,"ا",2,0],["إِنَّ قَلْبِي وَهْوَ الأَبِيُّ دَهَتْهُ","فُرْقَةٌ صَيَّرَتْهُ نَهْبَاً مُشَاعَا",208,"ع",2,1],["إِنْ قَالَ بَرَّ وَإِنْ نَادَاهُ مُنْتَصِرٌ","لَبَّى وَإِنْ هَمَّ لَمْ يَرْجِعْ بِلا نَفَلِ",209,"ل",1,0],["إِنَّ قُلُوباً مُحِيطَةً بِكَ مِنْ","كَرَامَةٍ شَارَكَتْكَ فِي الْكمَد",210,"د",1,0],["إِنْ قُلْتُ لاَ تَبْعَدْ فَإِنَّكَ بَيْنَََََنَا","هَلْ مَائِتٌ مَنْ يُخْلِفُ الأَنْجَابَا",211,"ب",2,0],["أَنْقذْتَنا مِن أَشدِّ ثُكْلِ","فَمَنْ لَنا بِالكَفَاءِ شُكْرَا",212,"ر",2,0],["أَنْقَذْتِهِ حِسّاً وَمَعْنَىٍ فَاسْلَمِي","وَتَقَبَّلِي مِنِّي تطَوُّعَ شاكِرِ",213,"ر",1,0],["أَنْ قَدْ فَعَلْتُمْ فِعْلَةً مُذْكُورَةً","كَسَتِ الفُضُوحَ وأبْدَتِ الشّنآنا",214,"ن",2,0],["أنْ قَدْ قَتَلْنَا بقَتْلاَنَا سَرَاتَكُمُ","أهلَ اللواءِ فَفيمَ يكثرُ القِيلُ",215,"ل",1,0],["إن قلبا تدوسه قدماها","ودماه تبلّ ذيلَ رداها",216,"ه",2,0],["أنقى من الفجر الضحوك","فهل أعرت الفجر خدك",217,"ك",1,0],["إن قال قالت أمةٌ بلسانه","وتقطعت لسماعه أجيادا",218,"د",2,0],["إِن قُلتُ وَاللَهِ ما أَبقى الزَمانُ لَهُ","في القَومِ شِبهاً أَبَت عَلياهُ تَحنيثي",219,"ث",2,0],["إِنَّ قُلوباً وَجَبَت","حُقَّ لَها أَن تَجِبا",220,"ب",2,1],["إنَّ قريضاً يكون حاملُهُ","في الناس كالبيهقيِّ والبَين",221,"ن",1,0],["أنقِذُوا العَاجزَ الفَقيرَ وصُونُوا","وَجْهَهُ عن مَذلَّةٍ وابْتِذَالِ",222,"ل",1,0],["إنْ قوِينا عَقْلاً ضعُفنا جُسوماً","ورأينا في الموتِ بُرءاً وأمْنَا",223,"ن",2,0],["أنْقَى من الدُّرِّ الفَر","يدِ يزَينُ صدرَ الحاليات",224,"ت",1,0],["أنقذتهم بعد يأسٍ مُغرِقٍ","سفُن الآمال يُزجيها الرجَاءْ",225,"ا",2,0],["إن قال مال له الوجودُ برأسهِ","ورنَت له الأسماعُ والأفهامُ",226,"م",1,0],["إنْ قَامَ يَخْطُبُ قُلْتَ حَيْدَرَةُ انْبَرَى","لِلْقَوْل في سَمْتٍ وَصِدْقِ مَقَالِ",227,"ل",1,0],["إن قاد بعضُ المصلحي","ن زمامه، لم ينقد",228,"د",1,0],["إنْ قضى نحبَهُ كمالٌ وحيدًا","فكمالٌ في مصر غيرُ وحيد",229,"د",1,0],["إن قدَّروا مجهوده","قالوا: النجاح، أو الرسوب",230,"ب",1,0],["إن قام بعدك من يصيح، فإنما","قد كنتَ مبتدئًا، وكان معيدا",231,"د",2,0],["إن قسا الدهرُ، يا وزيرُ، علينا","فلنا فيك أنت خيرُ عَزاء",232,"ا",2,0],["إن قامت الحرب غاب فيه","من خوف غارتِها ألوف",233,"ف",1,0],["إن قمتُ أشكرُ أجنادي، فإنكمو","في كل حربٍ وسلمٍ بعضُ أجنادي",234,"د",2,0],["إن قال، خلتَ الأصمعيَّ أعارهُ","شَفَتَيْهْ، لوْ أن الشفاه تُعار",235,"ر",1,0],["إنْ قلتَ: إنَّ حساءَه الم","ساءُ القَراحُ، فلا جرم",236,"م",1,0],["إن قيَّدوك فقد أُصِي","بوا بعد قيدكَ بالكُساح",237,"ح",1,0],["أنقذتمو شرفَ العروبةِ بعدمَا","أمسى على وجهِ التُّراب مُعَفَّرا",238,"ر",2,0],["إن قلتُ: صوَّرها، وأَبَدَعَ خَلْقَهَا","لم يُغضِب الرَّحمنَ صِدقُ مقالِي",239,"ل",2,0],["إن قال، أرهفت النيا","بةُ سمعَها، وصغا القضاة",240,"ا",2,0],["إِنَّ قلْبي يشُك فيما تُمنِّي","ي ونفسي حزينة ٌ مرتابهْ",241,"ب",2,0],["أنقذ الإنسان من آلامه","ولقد أدرأ بعض العلل",242,"ل",1,0],["إِنْ قلتُ: أَعطاني، كَذِبْتُ وَإِنْ أَقُلْ","ضَنَّ الأميرُ بمالِهِ لم يَجْمُلِ",243,"ل",1,0],["إنْ قيلَ رَبْعيٌّ فَمِنْ آبَائِهِ؛","أوْ قيلَ قَحْطَبَةٌ فَمِنْ أعْمَامِهِ",244,"م",2,0],["إنْ قيل بُدلتْ نغمة","ٌ منه كأن الجدّ منها مُزاح",245,"ح",1,0],["إن قَلّتِ السّمراءُ عندك، بُرهةً،","فاجزأ بمحضٍ، مرّةً، وسِمار",246,"ر",1,0],["أنقذوا ماءَ وجهنا يومَ لاحوا","فأضاءت وجوهُنا السوداءُ",247,"ا",2,0],["إن قيل سفيان يأبى الغمدُ جَمعهما","فأنتما مُنصلا سلٍّ وتجريدِ",248,"د",1,0],["إنَّ قَلْبي فَکعْلَميهِ","كلَّ يومٍ في وجيب",249,"ب",1,0],["إنَّ قَصْري أَنْ يُشْعَرَ القَلْبُ سُقْماً","ماً من سليمى مخامراً واشتياقا",250,"ق",2,0]]}