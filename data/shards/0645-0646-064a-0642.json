https://poetry.dctabudhabi.ae/diwan/poem/36710","الدوبيت"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94350","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28622","المنسرح"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83124","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52154","المقتضب"],[4733,"راحلةُ السّنين","https://www.poetsgate.com/ViewPoem.aspx?id=206870",""],[4755,"سِيرَةُ أَيلُول","https://www.poetsgate.com/ViewPoem.aspx?id=183562",""],[4755,"مَن يُقْنِعُ الشُّهَدَاءَ","https://www.poetsgate.com/ViewPoem.aspx?id=183639",""],[4755,"ولَقَد رَأَيتُ.. لَقَد رَأَيتُ مُحَالا","https://www.poetsgate.com/ViewPoem.aspx?id=184349",""],[4755,"يا حافِيَ العَينَينِ والخاطِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=186419",""],[4767,"مولد الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=179941",""],[4858,"موكب النور","https://www.poetsgate.com/ViewPoem.aspx?id=29798",""],[4858,"إلى كل معلم فاضل","https://www.poetsgate.com/ViewPoem.aspx?id=30114",""],[4916,"مجروحه","https://www.poetsgate.com/ViewPoem.aspx?id=135385",""],[5012,"كف شالت شموع","https://www.poetsgate.com/ViewPoem.aspx?id=22795",""],[5057,"لولا الحرب .","https://www.poetsgate.com/ViewPoem.aspx?id=184012",""],[5277,"طهورُ الروحِ","https://www.poetsgate.com/ViewPoem.aspx?id=207040",""],[5411,"القَصيدةُ المحَمدية","https://www.poetsgate.com/ViewPoem.aspx?id=186387",""],[5442,"رأى الركائب تحدى فإنني كلفا","https://www.poetsgate.com/ViewPoem.aspx?id=114755",""],[5461,"من يقول الزين ما يكمل","https://www.poetsgate.com/ViewPoem.aspx?id=8547",""],[5493,"الآن قد خانني الإلهام.","https://www.poetsgate.com/ViewPoem.aspx?id=205969",""],[5525,"ليل التجافي","https://www.poetsgate.com/ViewPoem.aspx?id=7193",""],[5526,"مالك لوى","https://www.poetsgate.com/ViewPoem.aspx?id=199668",""],[5561,"الجمرُ صبرُ النار","https://www.poetsgate.com/ViewPoem.aspx?id=195029",""],[5561,"مَن للعقال؟","https://www.poetsgate.com/ViewPoem.aspx?id=208899",""],[5561,"بلدي","https://www.poetsgate.com/ViewPoem.aspx?id=211443",""],[5562,"قارئ الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=190067",""],[5608,"أدري ما عندك إجابة","https://www.poetsgate.com/ViewPoem.aspx?id=34582",""],[5725,"قتيل العيون","https://www.poetsgate.com/ViewPoem.aspx?id=198567",""],[5736,"من أغمد النصل بأضلعك","https://www.poetsgate.com/ViewPoem.aspx?id=208284",""],[5756,"لمباني","https://www.poetsgate.com/ViewPoem.aspx?id=5420",""],[5756,"الدنيا بخير","https://www.poetsgate.com/ViewPoem.aspx?id=5434",""],[5789,"مغازلة الجِراح","https://www.poetsgate.com/ViewPoem.aspx?id=201410",""],[5837,"أعداء النجاح","https://www.poetsgate.com/ViewPoem.aspx?id=181808",""],[192,"الشاعر الأول","https://www.poetsgate.com/ViewPoem.aspx?id=16339",""],[5922,"قبضة من أثر الذهول","https://www.poetsgate.com/ViewPoem.aspx?id=185115",""],[5943,"إحساسُ الأمة في سقمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=45273",""],[5943,"القاتلُ المجنونُ","https://www.poetsgate.com/ViewPoem.aspx?id=61843",""],[6093,"من يقنع الروح","https://www.poetsgate.com/ViewPoem.aspx?id=192262",""],[6093,"الزورق المنكوب","https://www.poetsgate.com/ViewPoem.aspx?id=200240",""],[6100,"حصه اللوغان","https://www.poetsgate.com/ViewPoem.aspx?id=52550",""],[6225,"صلاة ودعاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80906&r=&rc=175",""],[2220,"من كان تكملُ ذاتُه بسواها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11870&r=&rc=739",""],[6344,"غُرباء يُعاندون الخطوات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87965&r=&rc=5",""]],"verses":[["مَنْ يُقَلِّدْهُ نِعْمَةً يَوْمَ عُسْرٍ","فَعَلَى قَوْمِهِ لَهُ الأَنْعَامُ",0,"م",1,0],["مَن يقرأ الدستور يعلمْ أنه","وَفقاً لصكّ الانتداب مصنَّف",1,"ف",1,0],["مُنى قلبي أرى قلبكِ","لا يبقى على عَهْدِ",2,"د",1,0],["مَن يَقتَرِب مِن أَمسِ يَبعُد عَن غَدٍ","وَيَعِش مَعَ المَوتى وَيُصبِحُ مِنهُمُ",3,"م",1,0],["مَن يَقتُلُ الجوعَ بَعدَ اِبنِ الشَهيدِ وَمَن","بِالسَيفِ يَقتُلُ كَبشَ القَومِ إِذ عَكَرا",4,"ر",2,0],["مَن يقل ماتَ حافظٌ ضلَّ رأياً","البلى لا يكونُ للشعراءِ",5,"ا",2,0],["مَن يَقتُلِ النَفسَ كَذا ظالِماً","وَلَم يُقِدها نَفسَهُ يَظلِمِ",6,"م",1,0],["مَن يُقِم في السَوادِ وَاليَدِ وَالإِغ","رامِ زيراً فَإِنَّني غَيرُ زيرِ",7,"ر",1,0],["من يقصد النجمَ في عُلْيا سماوتِه","نأى بجانبِه عن كلِّ مقصود",8,"د",1,0],["من يقود الأرعن الجرار في","نصرة اللّه على عزم الرسل",9,"ل",1,0],["من يقوّينا ، وكنا زمنا","كبغال (الروم) أوخيل (جمع)",10,"ع",1,0],["مَن يَقتلُ الجوعَ بعد ابنِ الشهيدِ وَمن","بالسّيفِ يَقتلُ كبشَ القوْم إذا عكرَا",11,"ر",2,0],["مَن يَقيس بِكَ الشُموس بَهاءً","حاشَ لِلّه أَنتَ أَبهى وَأَسنا",12,"ن",2,0],["مَن يَقُل فِيهِ قُلتُ فِيهِ وسَدَّد","تُ إِلَيهِ مِنَ الهِجَاءِ النِّبَالا",13,"ل",2,0],["مَن يَقفُ ما قَالَ كِتَابُ الخَضِرِ","فَقَد قَفَا سُنَّةَ خَيرِ مُضَرِ",14,"ر",1,1],["من يقبل الصب من عاذله","لم يجد في الأرض من يعذله",15,"ل",2,1],["من يقظة بالفتى إظهار غفلته","مع التحفظ من عذر ومن ختل",16,"ل",1,0],["من يقل في الكون شيء","غيره مان وجارا",17,"ر",2,0],["من يقمْ في الأمورِ بالجد يهنأ","والشفا للذين قاموا كسالى",18,"ل",2,0],["من يقيم الليل احياءا له","بركوع من تحاشى وارعوى",19,"و",2,0],["منّي قَلَقٌ ومن سُلَيمَى مَلَقُ","مُذْ مَفْرِقُها دُجىً وفَرْقي فَلَقُ",20,"ق",1,1],["مَن يَقِسْهُ في مَجدِه بأبيه","لم يَخفْ في القياسِ نَقْضاً وكَسرا",21,"ر",2,0],["من يقيني من فخاخٍ","جئتها واِبليس قانصْ",22,"ص",1,0],["من يقيني من عدوٍّ","عن وَلاه ليس بُدَّهْ",23,"د",2,0],["مَنْ يَقُلْ تَحْكيكَ رَوْضَةُ حاتِم","فَهُوَ مِنْ أَشْعَبَ في عِلْمٍ وظَنِّ",24,"ن",1,0],["مَنْ يَقْصِدُ اللهَ في حَوائِجِهِ","يَظْفَرُ بالنُّجْح والثّوابِ معَا",25,"ع",2,0],["مَنْ يَقرَعُ الذِّكرُ والأورادُ مِسَمعَهُ","لا ناقةُ العَطَنِ الهَوجاءُ والجَمَلُ",26,"ل",1,0],["مَنْ يقرَبِ النَّارَ لا يَسلمْ منَ الحَرَقِ","فابعُدْ عنِ النَّاسِ واحذَرْهم ولا تَثِقِ",27,"ق",1,1],["من يقس نيله بنيلٍ سواه","فلقد قاس بالسراب الماءا",28,"ا",3,0],["من يقل للجبال كوني جبالاً","فلقد فاه بالمقال هذاءا",28,"ا",3,0],["منْ يقِسْ غيرَه بهِ في جوابٍ","أو سؤالٍ يخطئْ طريقَ القياس",29,"س",1,0],["مَن يَقِسها بِسواها عدما","عَقلُهُ فَهوَ خَدينُ الهَوسِ",30,"س",1,0],["مَن يَقولُ الحَقَّ وَاللَّهِ يَسود","مَن يَقولُ الحقّ كانَ العاقِلا",31,"ل",2,0],["من يقل تهواه قلت نعم","أو يقل تسلوه قلت بلى",32,"ل",2,0],["من يقدمه الرعب حيث سار بشهر","من عززه النصر حيث صال بفصال",33,"ل",1,0],["من يقصدون سواه بعد مماته","عقر الركاب يقاطع الأسياف",34,"ف",1,0],["من يقرع الظُنبوبَ حزماً لم يزل","ما بين أَوشاظِ الورى يتقدَّمُ",35,"م",1,0],["من يقضِ في تعب الغرام شبابه","شدَّ المشيبُ عليه بالاتعاب",36,"ب",1,0],["من يقدرَن قدرَك","من يعلمَن امرك",37,"ك",1,0],["من يقبل الفاضح في ساتر","فهات ليلاي وخذ مريمك",38,"ك",1,0],["من يقبلِ الأإيار كان سواها","وهي التي ثبتْ لمن سوَّاها",39,"ا",3,0],["من يقل نحن به وله","فليقل أيضاً بنا ولنا",40,"ن",2,0],["مَن يَقُل إِنّي إِلَهٌ مِنهُمُ","أَملِكُ الأَمرَ فَمَثواهُ الجَحيمُ",41,"م",1,0],["من يقتل الغلس الحصيف ويدخل ال","باب اللطيف إذا أدلهمّ الغيهب",42,"ب",1,0],["من يقم وزن غيره بوفاء","يلق في نفسه إقامة وزن",43,"ن",1,0],["من يقسه بمن مضى من ملوك","قاس عقد الجمان بالأصداف",44,"ف",1,0],["مَن يقاسي وَمَن يُسابِقني بال","قَملِ في بوصتي وكعبي ونردي",45,"د",2,0],["من يقيم العزاء حزناً على من","رزؤهم أحزن البشير النذيرا",46,"ر",2,0],["مني قريبون رغم بعدهمُ","ولي بذا العمر عيش مغترب",47,"ب",1,0],["من يقاضيك ومن لم يحتكم","لك يستعدى بك الخصم الألدا",48,"د",2,0],["من يُقسم المذخور","بين الحال والمستقبل",49,"ل",1,0],["من يقدم غير الحسام نذيراً","يجد الناس آثماً أو كفورا",50,"ر",2,1],["مَن يَقل غَيرَ ما تَيَقَّنَ فِكرا","كانَ عندي مِنَ الجَحَيمِ أَشرَّا",51,"ر",2,0],["من يقبل الرفد والهدية من","قائل شعر فذاك ذقن خرا",52,"ر",2,0],["مَن يُقرِئها السَلامَ عَن ذي شغفٍ","في العشق يَرى الرشادَ عَينَ الغيِّ",53,"ي",1,0],["من يقتدي في الدين في مَن توقه","يزداد في التقوى ينال كمالا",54,"ل",2,1],["مَن يَقتُلُ النَّاسَ إِن هَلَكت وَمَن","لِلخَيلِ وَالبيضِ وَالقنا القُطُفِ",55,"ف",1,0],["مَن يَقتل الجُهدَ يَقتل فيهِ أُمَّتَه","وَأُمَّةُ الجُهدِ تُحييه فَيُحييها",56,"ي",3,0],["مَنْ يُقيلُ عثرتَهُ","إن كَبَا بِكَ القَلمُ",57,"م",1,0],["من يقنعُ الغافي على الأمسِ","مَحتْ مناهُ طلعةُ الشّمسِ",58,"س",1,1],["مَن يَقطعُ التَّيَّارَ عَن لَيلِنا","يا صُبحَنَا, مَن يَقتُلُ 