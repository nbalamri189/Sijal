{"poems":[[86,"يا ليلة ألهمتني ما أتيه به","https://www.aldiwan.net/poem68834.html","البسيط"],[93,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[93,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[88,"وتروق من بعد بها فوارة","https://www.aldiwan.net/poem44441.html","الكامل"],[69,"أقول قد لاح مداد على","https://www.aldiwan.net/poem29029.html","السريع"],[100,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[100,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[100,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[88,"ناح الحمام وغرّد الشحرور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19535&r=&rc=38",""],[161,"سم سمة تحمد آثارها","https://www.aldiwan.net/poem59021.html","السريع"],[286,"هل ذا اغتياب عن هوى","https://www.aldiwan.net/poem39360.html","مجزوء الرجز"],[321,"وسيع صدري انقضت في ضيقه حيلي","https://www.aldiwan.net/poem67221.html","البسيط"],[362,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[365,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[410,"حمائم الأيك هيجتن أشجانا","https://www.aldiwan.net/poem31850.html","البسيط"],[459,"نفرها عن وردها بحاجر","https://www.aldiwan.net/poem56177.html","الرجز"],[501,"الله يا هلا لهم","https://www.aldiwan.net/poem37702.html","مجزوء الرجز"],[530,"إن لموكا علي مكرمة","https://www.aldiwan.net/poem37433.html","المنسرح"],[530,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"]],"verses":[["هَل ذاكَ ما وَعَدَ الرَحمَنُ صَفوَتَهُ","رَوضٌ وَحورٌ وَوِلدانٌ وَأَمواهُ",0,"ا",2,0],["هَلْ ذَاكَ مُغْنِينَا إِذَا","لَمْ نُكْمِلِ المَجْدَ اكْتِسَابَا",1,"ب",2,0],["هَلْ ذَادَ عَنْ أُمِّ اللُّغَاتِ ابْنٌ لَهَا","كَذِيَادِكَ الْحُرِّ البَلِيغِ المُفْحِمِ",2,"م",1,0],["هل ذاك الماس يجمد صاعداً","أم قد تجسّم في الهواء النور",3,"ر",1,0],["هلْ ذاكَ طلسمٌ على مطلبٍ","أم خَنَمُ القارِ على الخمْرِ",4,"ر",1,0],["هل ذاك مخدعها ؟ تومى النجوم على","جبينه ، وعلى عينيه تعتكف",5,"ف",1,0],["هل ذكرنا بعد الأوان؟ اطمئني","ما ذكرنا، لأننا ما نسينا",6,"ن",2,0],["هَلْ ذَا أَوْ ذَاكَ لَهُ خَطَرٌ؟","إسْتَجْلَىْ مَكْرَهُمَا «صَبْرِيْ»",7,"ر",2,0],["هل ذاك ذوب الماس يجمد صاعدا","أم قد تجسم في الهواء النور",8,"ر",1,0],["هل ذاع مهذاك فنادى نعم","قالوا فما لبثك هل ذاعمه",9,"م",2,0],["هل ذا اغتياب عن هوى","حرمه من قد روى",10,"ر",3,1],["هَل ذا جَزاءُ اِمرِئٍ كانَت سَجينُهُ","حُبُّ التَعاوُنِ في خَصبٍ وَفي مَحلِ",11,"ل",1,0],["هَل ذاكَ ثغر تَبسم","أَم ذاكَ لُطف تجسم",12,"م",1,1],["هل ذاك إلاّ لأنَّ المُستَجيرَ بهِ","يُعيضُه الدَّهرُ إعزازاً بإهْوان",13,"ن",1,0],["هل ذا العويلُ على غيرِ الهَديلِ وهل","فقيدكُنَّ أعزُّ الخلقِ فِقدانا",14,"ن",2,0],["هل ذَخَرتْهم دون من فوق الثرى","إلا ليومِ النفع بالذخائرِ",15,"ر",1,0],["هل ذكروا عبداً لهم","لا ينتمي إلا لهم",16,"م",1,0],["هَل ذَاكَ للبَيْن عَنْ أزَالَ أم ال","حجّاج فاعْلَمْ بذَاكَ مَوْرِدُها",17,"د",3,0],["هَلْ ذا لِنُقْصان حَظِّي أَمْ لِطَرْحِكُمْ","تِلْكَ الْحُقُوقَ بلا جُرْمٍ ولا سَبَبِ",18,"ب",1,0]]}