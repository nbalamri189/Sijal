{"poems":[[86,"يا ليلة ألهمتني ما أتيه به","https://www.aldiwan.net/poem68834.html","البسيط"],[93,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[93,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[88,"وتروق من بعد بها فوارة","https://www.aldiwan.net/poem44441.html","الكامل"],[69,"أقول قد لاح مداد على","https://www.aldiwan.net/poem29029.html","السريع"],[100,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[100,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[88,"ناح الحمام وغرّد الشحرور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19535&r=&rc=38",""],[158,"سم سمة تحمد آثارها","https://www.aldiwan.net/poem59021.html","السريع"],[283,"هل ذا اغتياب عن هوى","https://www.aldiwan.net/poem39360.html","مجزوء الرجز"],[318,"وسيع صدري انقضت في ضيقه حيلي","https://www.aldiwan.net/poem67221.html","البسيط"],[359,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[362,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[406,"حمائم الأيك هيجتن أشجانا","https://www.aldiwan.net/poem31850.html","البسيط"],[456,"نفرها عن وردها بحاجر","https://www.aldiwan.net/poem56177.html","الرجز"],[498,"الله يا هلا لهم","https://www.aldiwan.net/poem37702.html","مجزوء الرجز"],[527,"إن لموكا علي مكرمة","https://www.aldiwan.net/poem37433.html","المنسرح"],[527,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"]],"verses":[["هَل ذاكَ ما وَعَدَ الرَحمَنُ صَفوَتَهُ","رَوضٌ وَحورٌ وَوِلدانٌ وَأَمواهُ",0,"ا",2,0],["هَلْ ذَاكَ مُغْنِينَا إِذَا","لَمْ نُكْمِلِ المَجْدَ اكْتِسَابَا",1,"ب",2,0],["هَلْ ذَادَ عَنْ أُمِّ اللُّغَاتِ ابْنٌ لَهَا","كَذِيَادِكَ الْحُرِّ البَلِيغِ المُفْحِمِ",2,"م",1,0],["هل ذاك الماس يجمد صاعداً","أم قد تجسّم في الهواء النور",3,"ر",1,0],["هلْ ذاكَ طلسمٌ على مطلبٍ","أم خَنَمُ القارِ على الخمْرِ",4,"ر",1,0],["هل ذاك مخدعها ؟ تومى النجوم على","جبينه ، وعلى عينيه تعتكف",5,"ف",1,0],["هل ذكرنا بعد الأوان؟ اطمئني","ما ذكرنا، لأننا ما نسينا",6,"ن",2,0],["هل ذاك ذوب الماس يجمد صاعدا","أم قد تجسم في الهواء النور",7,"ر",1,0],["هل ذاع مهذاك فنادى نعم","قالوا فما لبثك هل ذاعمه",8,"م",2,0],["هل ذا اغتياب عن هوى","حرمه من قد روى",9,"ر",3,1],["هَل ذا جَزاءُ اِمرِئٍ كانَت سَجينُهُ","حُبُّ التَعاوُنِ في خَصبٍ وَفي مَحلِ",10,"ل",1,0],["هَل ذاكَ ثغر تَبسم","أَم ذاكَ لُطف تجسم",11,"م",1,1],["هل ذاك إلاّ لأنَّ المُستَجيرَ بهِ","يُعيضُه الدَّهرُ إعزازاً بإهْوان",12,"ن",1,0],["هل ذا العويلُ على غيرِ الهَديلِ وهل","فقيدكُنَّ أعزُّ الخلقِ فِقدانا",13,"ن",2,0],["هل ذَخَرتْهم دون من فوق الثرى","إلا ليومِ النفع بالذخائرِ",14,"ر",1,0],["هل ذكروا عبداً لهم","لا ينتمي إلا لهم",15,"م",1,0],["هَل ذَاكَ للبَيْن عَنْ أزَالَ أم ال","حجّاج فاعْلَمْ بذَاكَ مَوْرِدُها",16,"د",3,0],["هَلْ ذا لِنُقْصان حَظِّي أَمْ لِطَرْحِكُمْ","تِلْكَ الْحُقُوقَ بلا جُرْمٍ ولا سَبَبِ",17,"ب",1,0]]}