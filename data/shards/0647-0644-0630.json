{"poems":[[88,"يا ليلة ألهمتني ما أتيه به","https://www.aldiwan.net/poem68834.html","البسيط"],[95,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[95,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[90,"وتروق من بعد بها فوارة","https://www.aldiwan.net/poem44441.html","الكامل"],[71,"أقول قد لاح مداد على","https://www.aldiwan.net/poem29029.html","السريع"],[102,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[102,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[102,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[90,"ناح الحمام وغرّد الشحرور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19535&r=&rc=38",""],[164,"سم سمة تحمد آثارها","https://www.aldiwan.net/poem59021.html","السريع"],[290,"هل ذا اغتياب عن هوى","https://www.aldiwan.net/poem39360.html","مجزوء الرجز"],[325,"وسيع صدري انقضت في ضيقه حيلي","https://www.aldiwan.net/poem67221.html","البسيط"],[366,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[369,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[415,"حمائم الأيك هيجتن أشجانا","https://www.aldiwan.net/poem31850.html","البسيط"],[463,"نفرها عن وردها بحاجر","https://www.aldiwan.net/poem56177.html","الرجز"],[505,"الله يا هلا لهم","https://www.aldiwan.net/poem37702.html","مجزوء الرجز"],[534,"إن لموكا علي مكرمة","https://www.aldiwan.net/poem37433.html","المنسرح"],[534,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138418",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138226",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138279",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138304",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138300",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48509","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77558","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96726","الكامل"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118172","الكامل"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118102","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77965","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128005","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109298","المتدارك"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[139,"","https://poetry.dctabudhabi.ae/diwan/poem/39760","البسيط"],[2852,"","https://poetry.dctabudhabi.ae/diwan/poem/142919","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204899","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100827","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130053","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112636","الرجز"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71335","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53028","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110048","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117958","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69930","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94808","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81696","الكامل"],[4852,"بوتقة","https://www.poetsgate.com/ViewPoem.aspx?id=214306",""],[4852,"بلوغ السحر","https://www.poetsgate.com/ViewPoem.aspx?id=214537",""],[4927,"مُعلَّقةُ الجبهة اللاوطنية اللاتقدمية السورية","https://www.poetsgate.com/ViewPoem.aspx?id=80806",""],[5457,"الطفل","https://www.poetsgate.com/ViewPoem.aspx?id=213388",""],[5459,"يا من صددتم..","https://www.poetsgate.com/ViewPoem.aspx?id=191516",""],[5459,"هَذِي الجِنان ..","https://www.poetsgate.com/ViewPoem.aspx?id=200767",""],[5512,"كيمياء أم خيانة","https://www.poetsgate.com/ViewPoem.aspx?id=204425",""],[5512,"خلف السواتر ..قمحانة","https://www.poetsgate.com/ViewPoem.aspx?id=204501",""],[5785,"يا نازح الدار ماغيرك سكن","https://www.poetsgate.com/ViewPoem.aspx?id=131571",""],[5831,"عيد الاستقلال","https://www.poetsgate.com/ViewPoem.aspx?id=20394",""],[5943,"نشوة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=41591",""],[5956,"أنا لم أعد لك هاويا","https://www.poetsgate.com/ViewPoem.aspx?id=182510",""],[5956,"إن كان عبد الله أصبح ساليا","https://www.poetsgate.com/ViewPoem.aspx?id=194611",""],[1376,"صدوا وقد دب العذار بحده","http://www.aldiwanalarabi.com/poemDescription.do?poemId=599358",""],[6302,"رَهْناً لِدَاعيَةِ الحَنينْ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86222&r=&rc=20",""]],"verses":[["هَل ذاكَ ما وَعَدَ الرَحمَنُ صَفوَتَهُ","رَوضٌ وَحورٌ وَوِلدانٌ وَأَمواهُ",0,"ا",2,0],["هَلْ ذَاكَ مُغْنِينَا إِذَا","لَمْ نُكْمِلِ المَجْدَ اكْتِسَابَا",1,"ب",2,0],["هَلْ ذَادَ عَنْ أُمِّ اللُّغَاتِ ابْنٌ لَهَا","كَذِيَادِكَ الْحُرِّ البَلِيغِ المُفْحِمِ",2,"م",1,0],["هل ذاك الماس يجمد صاعداً","أم قد تجسّم في الهواء النور",3,"ر",1,0],["هلْ ذاكَ طلسمٌ على مطلبٍ","أم خَنَمُ القارِ على الخمْرِ",4,"ر",1,0],["هل ذاك مخدعها ؟ تومى النجوم على","جبينه ، وعلى عينيه تعتكف",5,"ف",1,0],["هل ذكرنا بعد الأوان؟ اطمئني","ما ذكرنا، لأننا ما نسينا",6,"ن",2,0],["هَلْ ذَا أَوْ ذَاكَ لَهُ خَطَرٌ؟","إسْتَجْلَىْ مَكْرَهُمَا «صَبْرِيْ»",7,"ر",2,0],["هل ذاك ذوب الماس يجمد صاعدا","أم قد تجسم في الهواء النور",8,"ر",1,0],["هل ذاع مهذاك فنادى نعم","قالوا فما لبثك هل ذاعمه",9,"م",2,0],["هل ذا اغتياب عن هوى","حرمه من قد روى",10,"ر",3,1],["هَل ذا جَزاءُ اِمرِئٍ كانَت سَجينُهُ","حُبُّ التَعاوُنِ في خَصبٍ وَفي مَحلِ",11,"ل",1,0],["هَل ذاكَ ثغر تَبسم","أَم ذاكَ لُطف تجسم",12,"م",1,1],["هل ذاك إلاّ لأنَّ المُستَجيرَ بهِ","يُعيضُه الدَّهرُ إعزازاً بإهْوان",13,"ن",1,0],["هل ذا العويلُ على غيرِ الهَديلِ وهل","فقيدكُنَّ أعزُّ الخلقِ فِقدانا",14,"ن",2,0],["هل ذَخَرتْهم دون من فوق الثرى","إلا ليومِ النفع بالذخائرِ",15,"ر",1,0],["هل ذكروا عبداً لهم","لا ينتمي إلا لهم",16,"م",1,0],["هَل ذَاكَ للبَيْن عَنْ أزَالَ أم ال","حجّاج فاعْلَمْ بذَاكَ مَوْرِدُها",17,"د",3,0],["هَلْ ذا لِنُقْصان حَظِّي أَمْ لِطَرْحِكُمْ","تِلْكَ الْحُقُوقَ بلا جُرْمٍ ولا سَبَبِ",18,"ب",1,0],["هل ذا ملاك هابط من فوق او","هذا نبىٌ طاهر قد جاءنا",19,"ن",2,0],["هل ذو حجى منكم لمال زائل","أفلاذه بين لاضواري طارح",20,"ح",1,0],["هل ذاك مجرى التبر ينعم أوملا","ثكة ترتل بيننا أبرار",21,"ر",1,0],["هل ذا قران محمد البنداري","رب السماح الشهم في الأحرار",22,"ر",1,1],["هل ذاك إنسان لإنسانية","بارى الأنام أعدَّه لما برا",23,"ر",2,0],["هل ذكَّرتك بمن أحببت بارقة","تألقت في الدجى من نحو حيِّهِمِ",24,"م",1,0],["هَل ذَلِكَ الجسم الغَليظُ عَجب","فيلٌ لَهُ قَوائِمٌ وَذنبُ",25,"ب",1,0],["هَل ذاكَ بدرٌ لاحَ تحتَ غمامِ","أَم ذاكَ وجه أميم تحت لثامِ",26,"م",1,1],["هل ذاك غير نباتِ روضٍ قد حلا","لكنهم لما حلا هجروه",27,"ه",1,0],["هل ذاك برقٌ بالغوير أنارا","أم أضرموا بلوى المحصب نارا",28,"ر",2,1],["هَل ذقت من تلك المطاعم مذقة","أَم لا فَكن للطاعمين غلاما",29,"م",2,0],["هل ذاك بدر طالع","أم نور وجهك ساطع",30,"ع",1,1],["هل ذاك السحر كما قالوا","من لي بالسحر أعوده",31,"د",2,0],["هَل ذَاتُ رَبِّ العَالَمِينَ وُجُودُهُ","أم غَيرُهُ فَهُمَا إذاً شَيئَانِ",32,"ن",1,0],["هل ذو فم لعلاهُ غير ممتدحٍ","أو منتدى من ثناه غير معتطرِ",33,"ر",1,0],["هل ذنبه أنه يخشى الظلام إذا","وافى فألقى به في لجه العاري",34,"ر",2,0],["هل ذاك وجه لابنِ آدم ينتمي","أو ذاك وجه حجارة لم تصقل",35,"ل",1,1],["هل ذاك ليل مقمرُ","أم وجه ليلى مسفرُ",36,"ر",1,1],["هل ذاك ما ذكروهُ من إنصافهم","بئس الخلال وبئس ما نتوهّمُ",37,"م",1,0],["هل ذائدٌ عن حُرم الرساله","يَدفَعُ أهلَ البغي والضلاله",38,"ه",1,0],["هَلْ ذاكَ لاَمِعُ بَرْقٍ لاَحَ مِنْ إِضمِ","أَمْ ابْتَسَمْتِ فَهَذَأ بَارِقُ الشَّنَبِ",39,"ب",1,0],["هل ذَلَّ الناس عبدٌ يقنعُ","أو عزَّ سيدٌ لديهم يَطمعُ",40,"ع",1,0],["هل ذي الحيوة سِوَى دُخانٍ بائدٍ","فكأنها حالٌ لدينا حائلُ",41,"ل",1,0],["هل ذاك إلا من عناية مالك","أيامه مفقودة أمثالها",42,"ل",3,0],["هَل ذا سليمان الحَكيم متوَّجٌ","مِن امِهِ وَوِشاحهُ الاستَبرَقُ",43,"ق",1,0],["هَل ذَاكَ عَن تَفرِيقِ تِلكَ الأجزَا","أَو عَدمٍ مَحض إلَيهَا يُعزَى",44,"ز",2,0],["هل ذاك من غلط التسآل حين تَلَت","إنّا عطاشى فخالوا الأمر تحريفا",45,"ف",2,0],["هل ذاك إلاّ لاعتناءٍ يقتضي","إسعادَ آمالٍ ونُجح مقاصد",46,"د",1,0],["هل ذاكَ عمرٌ .. ذا الذي","لا أنتَ فيهِ ولا أنا !؟",47,"ن",2,0],["هل ذا لأنك يا من بتَّ تسكنني","قطَّرتَ منك على أبياته قِطْرا؟",48,"ر",2,0],["هلْ ذَاْكَ \"عَفْلَقُ\"، رَاْسِفٌ بِقُيُوْدِهِ؟؟؟","أَعْضَاْؤُهُ، وَثِيَاْبُهُ حَمْرَاْءُ",49,"ا",2,0],["هل ذلكَ الحقُّ أم وحشٌ أتى حُلمي ؟!","فالشرُ سارَ بعزٍّ غيرَ محتشمِ",50,"م",1,1],["هَلْ ذَنْبُهُ الصِّدْقُ كَيْ يُجَازَى","بِالهَجْرِ ..فَالسَّعْدُ فِي تَدَاعِ..?",51,"ع",1,0],["هل ذنبُهُم أن ترَى استقامَتَهم","تُبْدِي عُيوبًا تَلوحُ في العِوَجِ ..؟!",52,"ج",1,0],["هل ذابَ قلبكِ أمْ شابتْ ضفائِرُهُ","أمِ الفؤادُ قضى من مهجتي وطرا",53,"ر",2,0],["هل ذابَ عقلٌ أم تحطَّمَ قلبُهمْ","أمْ باسمِ حُوريَّاتِهمْ مفتونُ",54,"ن",1,0],["هل ذكر من غاب عنكم وامتحن","خاطر على البال يا كل المرام",55,"م",1,0],["هل ذاك ما قالوا لنا","يا أم صندوق العجب؟!",56,"ب",1,0],["هل ذاك علمٌ أم الآمالُ تسعدني","برحلةِ الشوقِ حيثُ القلبُ قد علقا؟",57,"ق",2,0],["هل ذا جزاء محبّتي","ومعيشتي لك وافيا؟",58,"ي",2,0],["هل ذاكرٌ أيام نعمتنا معاً","بممالكٍ أفضالها ترعانيا..؟",59,"ي",2,0],["هل ذاك غير نبات خد قد حلا","لكنهم لما حلا هجروه",60,"ه",1,0],["(هل ذِيع سري إذْ تماهى والشّجَا..",".. صوتي؟!)..أَثِبْ وَجْدي.. (أَزَلَّ لساني؟!)",61,"ن",2,0]]}