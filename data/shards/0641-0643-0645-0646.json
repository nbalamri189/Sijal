ر (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=175996",""],[6142,"أهاشم هل للبيض سلة ثائر","https://www.poetsgate.com/ViewPoem.aspx?id=155748",""],[6304,"الشمس الجريحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1611&r=&rc=1",""]],"verses":[["فَكَم نَفحَةٍ مِن أَرضِها بَرَّدَت حَشىً","وَبَلَّ غَليلاً مِن فُؤادٍ بَليلُها",0,"ل",3,0],["فكَمْ نُصْرَةٍ للّهِ جَهْراً قَضَيْتَها","وكمْ نِعْمَةٍ نَعْماءَ قضّيْتَها خَفْيا",1,"ي",2,0],["فَكَم نَهنَهتَ مِن غَربِ العَوادي","وَكَم لَكَ في رُبوعِ النيلِ فَضلُ",2,"ل",1,0],["فكم نوعٍ من الآفا","تِ مصروفٍ عن الحوتِ",3,"ت",1,0],["فكم نفحة في كفه أريحيّة","طوت أملاً قد كاد يخلقه النشر",4,"ر",1,0],["فَكَم نُزهَةٍ فيكَ لِلناظِرينَ","وَكَم راحَةٍ فيكَ لِلأَنفُسِ",5,"س",1,0],["فَكَم نَذورٍ أَصبَحَت","عَلَيَّ لِلمَساجِدِ",6,"د",1,0],["فَكَم نافَسوا في حُرقَةٍ إِثرَ فُرقَةٍ","تَعَجَّبُ مِن أَنفاسِنا وَاِمتِدادِها",7,"د",3,0],["فَكَم نَظرَةً قادَت إِلِى القَلبِ شَهوَةً","فَأَصبَحَ مِنها القَلبُ في حَسَراتِ",8,"ت",1,0],["فَكَم نَوءٍ مِنَ الصَهباءِ سارٍ","وَآخَرَ مِنكَ بِالمَعروفِ غادِ",9,"د",1,0],["فكمْ ناقصٍ ثغرُهُ باسمٌ","وكمْ فاضلٍ سنَّهُ يقرعُ",10,"ع",1,0],["فَكَمِنا حَتّى إِذا فُقِدَ الصَو","تُ دُجى المُظلِمِ البَهيمِ فَحارا",11,"ر",2,0],["فَكَم نَشَرا مِن ذَلِكَ الحُسن ما اِنطَوى","وَكَم آيةٍ في ذَلِكَ السحر جَدَّدا",12,"د",2,0],["فكم نظمِ قُرطٍ كالثُّريّا مُعَلَّقٍ","يزيدُ بها حُسناً إذا ما تمَرمَر",13,"ر",1,0],["فَكَم نِعمَةٍ أُلبِستُها بَعدَ نِعمَةٍ","وَكَم نَفحَةٍ في جَودَةٍ حَصَلت عِندي",14,"د",2,0],["فَكَمْ نُكَتٍ كَالسِّحْرِ فِي حَرَكَاتِهِ","تُرِيكَ مَدَبَّ الرُّوحِ في مُهْجَةِ الذَّرِّ",15,"ر",1,0],["فكم نصرة لله جهرا قضيتها","وكم نعمة غماء قضيتها خفيا",16,"ي",2,0],["فَكَم نِعمَةٍ قَد سُوّغَت بِكتابِهِ","غَنائِمُ أَهلِ الشِركِ حَلَّت لَنابِهِ",17,"ه",1,0],["فكم ندمت على ما كنت قلت به","وما ندمت على ما لم تكن تقل",18,"ل",1,0],["فَكَم ناصِحٍ قَد عُدَّ في الناسِ خائِناً","وَكَم غادِرٍ قَد عُدَّ في الناسِ وافيا",19,"ي",2,0],["فكم نلتُ نعمى أحمد اللَه عندها","وقد تعب الشيطان فيها بلا حمد",20,"د",1,0],["فَكَم نَبيهٍ قَد رَأَيناهُ بِال","أَمسِ وَضيعاً خامِلَ الذِكرِ",21,"ر",1,0],["فكم نفحاتٍ في الغيوب لربّنا","تهبّ سحيراً في الحشا فيفحفح",22,"ح",1,0],["فكم نسخت حبَّ المنازلِ غربةٌ","ولكنَّ هذا الحبِّ ليس لهُ نسخ",23,"خ",1,0],["فكم نفَخنا وقال الشّامتونَ بنا","هَذي القلوبُ كثلجٍ غيرِ مُضطرم",24,"م",1,0],["فكم نازحٍ بينَ الأجانبِ ضائعٍ","وكم نائحٍ عندَ الخرابِ شَجاك",25,"ك",1,0],["فَكَم نَتَفتَ إِلى أَن","أَبدَيتَ صَفحَةَ مَينِك",26,"ك",1,0],["فَكَم نِقمَةٍ مِنهُ صُبَّت عَلى","لُيوثِ العَرينِ بِثَأرِ الغَنَم",27,"م",1,0],["فَكَم نِعَمٍ أَهدى وَكَم مِن عَمٍ هَدى","فَبورِكَ من هادٍ وَمن ماجِدٍ مُهدي",28,"د",2,0],["فكم نظموا جيشا وكم نشر واعدلا","وكم هند واسيفاوكم ضربوا تبرا",29,"ر",2,0],["فكم نعمة أسدى وكم محنة زوى","وكم كربة أجلى بسر ظاهر",30,"ر",1,0],["فكم ناظرٍ في شاسعٍ من مكانه","إلى البيتِ لم يَنْظُرْ إليه مِنَ الثّاني",31,"ن",2,0],["فكم نَطْوي المَنازلَ في هَوانا","وآخِرُ مَنزِلٍ تحتَ الرِّمال",32,"ل",1,0],["فَكَم نِعمَةٍ مَدَّها مِثلُها","وَفائِدَةٍ بَعدَها فائِدَه",33,"د",2,0],["فكم نرى قلماً في كفّ صاحبه","غدا بأفكاره السوداءِ منّشارا",34,"ر",2,0],["فكم نبهت طرفاً كان نائم","وكم أيقظت قلباً كان هائم",35,"م",1,0],["فكم ناطق بالكفر أصبح أخرساً","وكم أخرسٍ بالشعر أصبح ناطقا",36,"ق",2,0],["فكم نطأ الرماد ونحن ندري","ونعلم أنَّ جمراً في الرماد",37,"د",1,0],["فكم نادمتني ليلاً طويلاً","وفي سحرٍ وصبح والعشيّه",38,"ي",2,0],["فكم نظرةٍ قادت إلى القلب حسرةٍ","يقطع أنفاس الحياة ورودها",39,"د",3,0],["فكم نائم في راحة صدر ليله","وأخراه في الأرماس يرمى ويترك",40,"ك",1,0],["فكم نهيتُ بأُولَى الزجر سائقَهم","حتى تشابَه مهتوكٌ ومستورُ",41,"ر",1,0],["فكم نائمٍ عنّي وثيرٍ مِهادُهُ","وجنبي له عن لين مَضجَعه ينبو",42,"ب",2,0],["فكم نعمةٍ للأعوجيَّة حمدها","وكم منَّةٍ مشكورةٍ للمناسمِ",43,"م",1,0],["فَكَم نَزَلَت بِي مِن أُمورٍ مُهِمَّةٍ","خَذَلتُم عَلَيها ثُمَّ لَم أَتَخَشَّعِ",44,"ع",1,0],["فَكم نرتّقُ خَرْقاً ليس مُرْتَتِقاً","فيها ونحرسُ شيئاً ليس ينحرسُ",45,"س",1,0],["فكم نَظَمْنَا فوقه قُبْلةً","وكم نَثَرْنَا فَوْقَه بَدْرَه",46,"ر",2,0],["فكم نكبةٍ جلَّى الشيوخُ غيومها","ولولاهمُ ضاقت بها حيلُ القُطر",47,"ر",1,0],["فَكَم ناظر سال في دمعه","عليك وَكَم ناظر أَرمد",48,"د",1,0],["فكم نكبة جلبت نعمة","وكم ظفر قد أتى عن فشل",49,"ل",1,0],["فَكَم نَهَبنا ثَمينَ الدُّرِّ مِن فَمِهِ","مِن نَثرهِ درّه آذاننا نهبَت",50,"ت",1,0],["فكم ناهدٍ صادني حُسنها","بصوتٍ رخيم وغنج ودل",51,"ل",1,0],["فكَم نَظرَةٍ لِي نَحوكم وَالتِفاتَةٍ","إِليكُم كأنَّ البُعدَ عَن أَرضِكُم قُربُ",52,"ب",1,0],["فكم نازحٍ أدناهُ حسنُ وِدادِه","وإن لم تزَلْ أيدي المطيّ به تمطو",53,"ط",2,0],["فكم نهى عن سيء اللحن عمر","وكم بإصلاح اللسان قد أمر",54,"ر",1,0],["فكم نعمة أسبغتها قل عندها","لحقك شكري قابلتها خطيئتي",55,"ي",1,0],["فكم نزعت ضرّاً وكم صرعت رياً","وكم زرعت خيراً وكم قلعت شرا",56,"ر",2,0],["فكم نادمته بالليل وحدي","فيغنيني عن الخود الكعاب",57,"ب",1,0],["فَكَم نفس تعاطتها المَزايا","وَكَم قلب تقلبه الظنون",58,"ن",1,0],["فكم نصبت له من مقلتي شركا","فاصطاد قلبي غزالا ساكنا فيه",59,"ي",2,0],["فَكَم ناكِثٍ أَهوى لِسَيفِكَ ساجِداً","وَلَم يَكُ ذا طُهرٍ وَلا مُتَيِّما",60,"م",2,0],["فَكَم نَظَمتُ بِها وَالأُنسُ مُنتَظِمٌ","عَذراءِ يَشكرُ مِن أَلفاظِها الصاحي",61,"ح",2,0],["فكم نشرت عقبان جوٍّ بظله","بسفك دم الأنداد ثعلب أرقم",62,"م",1,0],["فكم نعمة فرعت منها تبسمت","فُروض الندى عنها وعمت فواضله",63,"ل",2,0],["فكم نفس حر قد أتت مستجيرةً","به فاستفادت من نداه طلابها",64,"ب",3,0],["فكم نلت من ميّ بها ما يسرني","من الوصل في يوم هنالك صالح",65,"ح",1,0],["فكم نفع الاسلام منه مؤلف","وكم قدّم الطلاب منه مجلد",66,"د",1,0],["فكم نفع الطلاب بالعلزم والهدى","وكز وضحت بعد الخفاء مسائل",67,"ل",1,0],["فكم نبيٍ ضمّه قسيونُ","وكم وليٍ عنده مدفونُ",68,"ن",1,0],["فَكَم نَماهُ مِنَ الصَيدِ الَّذينَ هُمُ","عِزُّ الأَنامِ وَغاياتٌ لِمُنتابِ",69,"ب",1,0],["فكم نبي جمال","له الملالة مله",70,"ل",2,0],["فكم نعمة أسديتها وصنيعة","إليّ ولكن لا تصادف مصنعا",71,"ع",2,0],["فكم نصحت وقد حادت بعقلك في","حب العناد عن النصح المداما",72,"م",2,0],["فَكَم نفس لها ذَلّت وَدانت","وكم مِن مُهجَةٍ نَوَتِ اِرتحالا",73,"ل",2,0],["فكم نَفَعَ البلاد وكم حَماها","وكم أبدى بها الرأيَ السديدا",74,"د",2,0],["فكمْ نائحاتٍ للنُّحورِ ضَواربٍ",