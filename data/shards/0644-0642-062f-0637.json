em41392.html","الطويل"],[429,"صدرنا وقد نادى السماح بنا ردوا","https://www.aldiwan.net/poem12450.html","الطويل"],[429,"لهن ربوع بالعقيق دواثر","https://www.aldiwan.net/poem12468.html","الطويل"],[429,"دع العذل إني أكره العذل والغدرا","https://www.aldiwan.net/poem12480.html","الطويل"],[429,"لقد طال ما أسهب الناس فيك","https://www.aldiwan.net/poem12788.html","المتقارب"],[434,"دعا فأجابه الدمع العصي","https://www.aldiwan.net/poem2606.html","الوافر"],[450,"لقد طال سعيا للصبا بالرسائل","https://www.aldiwan.net/poem13877.html","الطويل"],[456,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[462,"أطاع فما إلى صبر سبيل","https://www.aldiwan.net/poem3168.html","عموديه"],[475,"تعطر من دياركم النسيم","https://www.aldiwan.net/poem15337.html","الوافر"],[477,"متى يا دهر تجمع شمل أنسى","https://www.aldiwan.net/poem36931.html","الوافر"],[480,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[480,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[513,"مضى بدر فأغنى عنه طي","https://www.aldiwan.net/poem12237.html","الوافر"],[513,"الله أعلى وأعلم","https://www.aldiwan.net/poem12267.html","المجتث"],[536,"لقد طغى بصحة في جسمه","https://www.aldiwan.net/poem47944.html","عموديه"],[548,"لقد طوفت في الآفاق حتى","https://www.aldiwan.net/poem1885.html","عموديه"],[549,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[560,"عوجا على غرب لبنان الذي اشتهرا","https://www.aldiwan.net/poem52843.html","البسيط"],[560,"هوى في القلب يعذب وهو داء","https://www.aldiwan.net/poem52983.html","الوافر"],[565,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[571,"لقد طهر الرحمان آل محمد","https://www.aldiwan.net/poem3643.html","الطويل"],[583,"نواحي الأرض ضاحكة الربوع","https://www.aldiwan.net/poem1568.html",""]],"verses":[["لَقَد طالَ عَتبي عَلى ناظِرٍ","رَأى بارِقاً غَيرَ دانٍ فَشاما",0,"م",2,0],["لَقَد طالَ هَزّي مِن قَوائِمِ مَعشَرٍ","كِلالِ الظُبى لَم أَرضَ مِن بَينِها نَصلا",1,"ل",2,1],["لَقَد طُفتُ في تِلكَ المَعاهِدِ كُلِّها","وَسيَّرْتُ طَرفي بَينَ تِلكَ المَعالِمِ",2,"م",1,1],["لقد طَرَقَتْني النّائِباتُ بِحادِثٍ","لَوَ انَّ الصَّفا يُرْمَى بهِ لتَصَدّعا",3,"ع",2,0],["لَقَد طابَت بِكِ الدُنيا","وَلَولا أَنتِ لَم تَطِبِ",4,"ب",1,0],["لَقَدْ طَابَ مِنْ مثْوَاكَ فِي البِرِّ مّشْهَدٌ","غَدَا الْحُسْنُ فِيهِ ذَا فُنُونٍ وَأَقْسَامِ",5,"م",1,0],["لَقَدْ طَوَّقَ الأَذْفُنْشَ سَعْدُكَ خزْيَةً","تَجِدُّ عَلَى مَرِّ الْعُصُورِ الذَّوَاهِبِ",6,"ب",1,0],["لَقَد طالَ الحِيادُ وَلَم تَكُفّوا","أَما أَرضاكُمُ ثَمَنُ الحِيادِ",7,"د",1,1],["لَقَد طالَ عَهدي بِالمُصَلّى فَلَيتَني","رَأَيتُ المُصَلّى أَو سَمِعتُ لَهُ خَبَر",8,"ر",1,0],["لَقَد طَمِحَ الطَمّاحُ مِن بُعدِ أَرضِهِ","لِيُلبِسَني مِن دائِهِ ما تَلَبَّسا",9,"س",2,0],["لَقَد طَالَ مَا أَضحَيتِ فَقراً ومَألَف","ومُنتظَراً لِلحَىِّ مَن حَلَّ أَو رحَل",10,"ل",1,0],["لَقَد طَرَقَتنَا في التَنائي وَإِنَها","على القُربِ عِلمي للسُّرى لَهَيُوبُ",11,"ب",1,0],["لقد طارت بشهرته شَمال","كما طارت بشهرته جَنوب",12,"ب",1,0],["لقد طَوَّحَتْني في البلاد مُضاعا","طوائح جاءت بالخطوبِ تباعا",13,"ع",2,1],["لقد طغت حيرة أهل النهى","هل فيك يا علم لها مردع",14,"ع",1,0],["لَقَد طالَ خِزيُ التَيمِ غَيرَ مَهيبَةٍ","وَآنُفُ تَيمٍ لَم تُفَقَّء عُيونُها",15,"ن",3,0],["لَقَد طَرِبَ الحَمامُ فَهاجَ شَوقاً","لِقَلبٍ ما يَزالُ بِكُم مُصابا",16,"ب",2,0],["لَقَد طَيَّبتَ نَفسي عَن صَديقي","وَقَد طَيَّبتَ نَفسي عَن بِلادي",17,"ي",1,0],["لَقَد طَلَبَت قُيونُ بَني عِقالٍ","أَغَرَّ يَجيءُ مِن مِئَةٍ جَوادا",18,"د",2,0],["لَقَد طالَ ما صِدنَ القُلوبَ بِأَعيُنٍ","إِلى قَصَبٍ زَينِ البُرى وَالمَعاضِدِ",19,"د",1,0],["لَقَد طَرَقَت عَينَيَّ في الدارِ دِمنَةٌ","تَعاوَرَها الأَزمانُ وَالريحُ بِالقَطرِ",20,"ر",1,0],["لَقَد طالَ لَومُ العاذِلينَ وَشَفَّني","تَناءٍ طَويلٌ وَاختِلافٌ مِنَ النَجرِ",20,"ر",1,0],["لَقَد طالَت مَنابَتُكُم فَطابَت","فَطابَ لَكَ العُمومَةُ وَالخُؤولُ",21,"ل",1,0],["لَقَد طالَ كِتماني أُمامَةَ حُبَّها","فَهَذا أَوانُ الحُبِّ تَبدو شَواكِلُه",22,"ل",2,0],["لقد طاف بالأركانِ ركنُ سماحةٍ","يُقام بها شرعُ السماح وينصب",23,"ب",1,0],["لقد طوى الموتُ من ذاكَ الفرندِ حلى","كانت حلى الدّين والأحكام والرتب",24,"ب",1,0],["لقد طلعت علينا من سناه","نجومُ اليمن بالخصب المريع",25,"ع",1,0],["لقد طاوَلَ إعراضُ","كَ بالمعروفِ إقبالي",26,"ل",2,0],["لَقَد طَرِبَ التاج وَالصَولَجانُ","وَحُقَّ لِهَذَينِ أَن يَطرَبا",27,"ب",2,0],["لَقَد طَرَحَ الغُصنُ أَوراقَهُ","مِنَ الذُعرِ وَاِضطَرَبَ الجَدوَلُ",28,"ل",1,0],["لَقَد طالَ السُهادُ وَطالَ لَيلي","فَلا أَدري الرُقادَ مَتى يَكونُ",29,"ن",1,0],["لَقَد طَوَتِ الحَوادِثُ مِنهُ جِسماً","وَلَيسَ لِذِكرِهِ في الناسِ طَيُّ",30,"ي",1,0],["لَقَد طابَ لِيَ فيكَ هَذا الغَرا","مُ وَإِن صَحَّ لي أَنَّهُ مُتلِفي",31,"ي",1,0],["لَقَد طالَ شَرحُ القالِ وَالقيلِ بَينَنا","وَما طالَ ذاكَ الشَرحُ إِلّا لِيَقصُرا",32,"ر",2,0],["لقد طوّقت جيد الشكر مني","بها فكأنها العقد النظيم",33,"م",1,0],["لقد طال ليل المؤمن القانع الذي","ثوى في ظلام القبر ينتظر الفجرا",34,"ر",2,0],["لَقَد طَلَعَ البَدرُ مِن جُنحِها","وَأَوما إِلى صُبحِها أَن يَقِف",35,"ف",1,0],["لقد طالَ عهدي بالحِمَى وحلولِهِ","ولولا شقائِي لم يَطُلْ بِهمُ عهدي",36,"ي",1,0],["لَقَد طَلَبَتكَ مِن غُرِّ المَراثي","قَوافٍ مِثلَ أَفوافِ البُرودِ",37,"د",1,0],["لَقَد طَلَبَت بِالذَحلِ غَيرَ ذَميمَةٍ","إِذا ذُمَّ طُلّابُ الذُحولِ الأَخاضِرُ",38,"ر",1,1],["لَقَد طَرَقَت لَيلاً نَوارٌ وَدونَها","مَهامِهُ مِن أَرضٍ بَعيدٍ خُروقُها",39,"ق",3,1],["لقد طَمِعَ البِشريُّ فيَّ ولم يكنْ","لِيَطْمَعَ فيَّ المرءُ وهو لبيبُ",40,"ب",1,1],["لَقَد طالَبتُها وَلِكُلِّ شَيءٍ","وَإِن طالَت لَجاجَتُهُ اِنتِهاءُ",41,"ا",2,0],["لَقَد طالَ يا دُنيا إِلَيكِ رُكوني","وَدامَ لُزومي ضِلَّتي وَفُتوني",42,"ن",2,1],["لقد طاب الوجود بحالتيه","شقائي فيك أجملُ من هنائي",43,"ا",2,0],["لَقَد طَلَعَت في وَجهِ مِصرَ بِوَجهِهِ","بِلا طالِعٍ سَعدٍ وَلا طائِرٍ سَهلِ",44,"ل",1,0],["لقدْ طمع البِرِنْسُ بمستحيلٍ","فَجَرَّ لقومِهِ سفكَ الدماءِ",45,"ا",2,1],["لقد طالَ بالهرماسِ عهدي وماؤُهُ","إذا ما جرى كالسيفِ أحمرَ منتضى",46,"ض",2,0],["لَقَد طالَ صَدرُ الرُمحِ مِنّي بِهِمَّةٍ","تَهُزُّ بِها العَلياءُ صَفحَةَ صارِمِ",47,"م",1,0],["لَقَد طُفتُ سَبعاً قُلتُ لَمّا قَضَيتُها","أَلا لَيتَ هَذا لا عَلَيَّ وَلا لِيا",48,"ي",2,1],["لَقَد طَرَقَتني أُمُّ خِشفٍ وَإِنَّها","إِذا صَرَعَ القَومَ الكَرى لَطَروقُ",49,"ق",1,1],["لَقَد طالَ لَيلي وَاِستَهَلَّت مَدامِعي","وَفاضَت جُفوني وَالغَرامُ يَزيدُ",50,"د",1,0],["لَقَد طالَت مُعاقَرَةُ المَنايا","فَما تَصحو السُيوفُ وَما تَفيقُ",51,"ق",1,0],["لَقَد طَلَبَت عَلى يَدِكَ الرَّعايا","طَريفَ الخَيرِ وَالشَرَفَ التِلادا",52,"د",2,0],["لقد طافَ طائِفُها بالفتاةِ","فأرَّقها ما عَنَا آلها",53,"ل",3,0],["لَقَد طالَ حَربُ النَومِ فيكَ لِناظِري","أَلا هُدنَةً مِنهُ وَدَعها عَلى دَخَن",54,"ن",1,0],["لَقَد طالَ في رَسمِ الدِيارِ بُكائي","وَقَدطالَ تَردادي بِها وَعَنائي",55,"ي",1,1],["لَقَد طابَتِ الدُنيا بِطيبِ مُحَمَّدٍ","وَزيدَت بِهِ الأَيّامُ حُسناً إِلى حُسنِ",56,"ن",1,0],["لَقَد طالَ في هَذا الأَنامُ تَعَجُّبي","فَيا لِرَواءٍ قوبِلوا بِظِماءِ",57,"م",3,0],["لَقَد طالَ العَناءُ فَكَم يُعاني","سُطوراً عادَ كاتِبُها بِطَمسِ",58,"س",1,0],["لَقَد طالَ الزَمانُ عَلَيَّ حَتّى","غَدَوتُ وَلي إِلى الدُنيا رُكونُ",59,"ن",1,1],["لَقَد طلعت شمس النهار مضيئة","عَلى أَوجه تَحكي صحائف أَحزان",60,"ن",1,0],["لَقَد طالَ حتى خلته غير منقضٍ","وَحتى كأَنَّ الليل لَيسَ له فجر",61,"ر",1,0],["لَقَد طالَ صبر الشرق يا غرب فازدجر","فإنك إن لم تزدجر سوف تندم",62,"م",1,0],["لقد طفت عشراً حول قبرك لاثماً","تراباً عليهِ ما له قبل ذا قدرُ",63,"ر",1,0],["لَقَد طالَ يا لَيلى إليك نزوعي","فأَرسلت عَن بعد إليك دموعي",64,"ي",1,1],["لَقَد طالَ فيما بيننا الطعن موجعاً","فدنّا كَما دانوا ودانوا كما دنا",65,"ن",2,0],["لَقَد طلعت علينا","ككَوكبٍ في الصباحِ",66,"ح",1,0],["لَقَد طلبت أن لا أَبوح بحبها","وَلكنني قد بحت حتّى فشا أَمري",67,"ي",1,1],["لَقَد طرقت ليلى بليلٍ تزورني","فَيا حبذا لَيلى وَيا حبذا الطرقُ",68,"ق",1,1],["لَقَد طالَ ليلُ اليأس حتىّ أملني","وَلا بد لليل الَّذي طالَ من فجر",69,"ر",1,0],["لَقَد طابَ لبنان وَطابَ هواؤه","وَطاب به أهل وَطابَ ربوعُ",70,"ع",1,1],["لقد طَلعَ الفجرُ يا شاعري","وكادتْ تزولُ نجومُ الصباحْ",71,"ح",1,0],["لَقَدْ طَالَ عَهْدِي بِالشَّبَابِ وَإِنَّهُ","لأَدْعَى لِشَوْقِي أَنْ يَطُولَ بِهِ 