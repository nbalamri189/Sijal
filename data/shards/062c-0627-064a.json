{"poems":[[74,"قام يرنو بمقلة كحلاء","https://www.aldiwan.net/poem18165.html","الخفيف"],[47,"جائر في الحكم لو شاء قصد","https://www.aldiwan.net/poem63483.html","الطويل"],[71,"جائع طامع طلوع غشوم","https://www.aldiwan.net/poem28683.html","الخفيف"],[33,"عاود القلب يا لقومي سقما","https://www.aldiwan.net/poem41338.html","الخفيف"],[54,"لا ورمان النهود","https://www.aldiwan.net/poem27094.html","مجزوء الرمل"],[48,"قد ندمنا على القبيح فأمسي","https://www.aldiwan.net/poem23435.html","الخفيف"],[102,"الأيام الخضر","https://www.poetsgate.com/ViewPoem.aspx?id=50342",""],[92,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[119,"سر الغيوب افاض اللارواح","https://www.aldiwan.net/poem41185.html","عموديه"],[133,"أنامل النسيان مري على","https://www.aldiwan.net/poem67432.html","السريع"],[136,"كلف العيس بالسرى فذراها","https://www.aldiwan.net/poem54692.html","الخفيف"],[259,"أعلنت ضعفي","https://www.aldiwan.net/poem24946.html","مجزوء الرمل"],[385,"مزجت دموع جفونه بدماء","https://www.aldiwan.net/poem49210.html","الكامل"],[463,"أَصاب أو أخطأني راميا","https://www.aldiwan.net/poem55810.html","السريع"],[466,"كبت جفان الحي من دارم","https://www.aldiwan.net/poem15098.html","السريع"],[466,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[466,"وفقير عصف المحل به","https://www.aldiwan.net/poem15697.html","الرمل"],[466,"وعلى الأيام من نعمائه","https://www.aldiwan.net/poem16075.html","الرمل"],[466,"أسدي البأس عذري الوفا","https://www.aldiwan.net/poem16229.html","الرمل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123405","المديد"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96754","المتدارك"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96632","الرمل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55956","الرمل"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111174","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64885","الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145106","الرجز"],[1399,"","https://poetry.dctabudhabi.ae/diwan/poem/143713","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87825","الخفيف"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114037","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48246","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137024",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137258",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137018",""],[2656,"","https://poetry.dctabudhabi.ae/diwan/poem/124603","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200612","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205045","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117967","الخفيف"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66577","الخفيف"],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139843",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102956","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86413","الرجز"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136910",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90831","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73429","الرمل"],[4750,"قبة الفرو","https://www.poetsgate.com/ViewPoem.aspx?id=180419",""],[4829,"غارت الخيل الاصايل","https://www.poetsgate.com/ViewPoem.aspx?id=34422",""],[4578,"تجلَّت فيها شمس النهار على رُمحٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49377",""],[4896,"بخت الرضا","https://www.poetsgate.com/ViewPoem.aspx?id=180891",""],[4931,"هموم القلب","https://www.poetsgate.com/ViewPoem.aspx?id=30868",""],[4984,"إذا رأيت الناس من جهلهم","https://www.poetsgate.com/ViewPoem.aspx?id=215825",""],[5357,"ولو زعل","https://www.poetsgate.com/ViewPoem.aspx?id=16501",""],[5386,"بين ضلوعنا","https://www.poetsgate.com/ViewPoem.aspx?id=35004",""],[5431,"لستَ مثلي!","https://www.poetsgate.com/ViewPoem.aspx?id=200646",""],[5442,"سرى والدحى شوق إليه وتذكار","https://www.poetsgate.com/ViewPoem.aspx?id=114746",""],[5455,"المدينة والغريب","https://www.poetsgate.com/ViewPoem.aspx?id=213960",""],[5455,"انت زعلان","https://www.poetsgate.com/ViewPoem.aspx?id=213962",""],[5495,"اريد ابجي على صدرك","https://www.poetsgate.com/ViewPoem.aspx?id=175460",""],[5537,"فيها حاجه حلوة","https://www.poetsgate.com/ViewPoem.aspx?id=214540",""],[5997,"جائحة","https://www.poetsgate.com/ViewPoem.aspx?id=214297",""],[5396,"لمعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65505&r=&rc=4",""]],"verses":[["جائر الحكم قلبه ليَ صخرٌ","وبكائي له بكى الخنساء",0,"ا",2,0],["جائِرٌ في الحُكمِ لَو شاءَ قَصَد","أَخَذَ النَومَ وَأَعطانِيَ السُهُد",1,"د",1,1],["جائعٌ طامعٌ طلوعٌ غشومٌ","عمَّ في جورِهِ الأنامَ جميعا",2,"ع",2,1],["جائَها قالَ ما الَّذي كانَ بَعدي","حَدِّثيني فَقَد تَحَمَّلتِ إِثما",3,"م",2,0],["جائَهُم بَحرُ حَديدٍ","تَحتَ أَظلالِ بُنودِ",4,"د",1,0],["جائِزٌ أَن يَكونَ آدَمُ هَذا","قَبلَهُ آدَمٌ عَلى إِثرِ آدَم",5,"م",1,0],["جائعا .. من صدى (ابن علوان) خبزي","ظامئا من ذبول (أروى) سقاتي",6,"ت",2,0],["جائيا ذاهبا يقسِّم في الأوجه","لحظَيهِ من هُناكَ وهَنْا",7,"ن",2,0],["جائتك من عبد يجيك هائم","يشدو بآيات الغرام صراح",8,"ح",1,0],["جائعٌ خُبزُهُ المُحال","يَشغَلُهُ الماضي عن الآتيات",9,"ت",1,0],["جَائِلاَتٍ نُسُوعُهَا تَتَغَالَى","فَوقَ عُوجٍ قَد أُسنِدَت لِقَرَاهَا",10,"ا",3,0],["جائرٌ خصمٌ عنيدٌ","لم يُقَدِّرْ حق ظَرْفي",11,"ف",2,0],["جايتهم وَأَنا مُقيم بَينَهُم","وَكَتَمت أَحزاني وَعظم بَلائي",12,"ا",2,0],["جائلة واصلة ما علتْ","ثَنيَّةً أو هبطَتْ واديا",13,"ي",2,0],["جائرةٍ في الطعن ظلامةٍ","تخلطُ بَرَّ القومِ بالآثم",14,"م",1,0],["جائرٍ لو هَتفَ النَّهْجُ بهِ","لأضاعَ القصْدَ ضُرّاً وأضَلْ",15,"ل",1,0],["جائرٌ في الطَّعنِ اِن خاض الوغى","واذا يحكمُ في السَّلْمِ عَدَلْ",16,"ل",1,0],["جائرٌ في المالِ إذْ يَبْذلهُ","فإذا ما مَلَكَ الحُكْمَ عَدَلْ",17,"ل",1,0],["جائرُ الطَّعْنِ إذا جَدَّ الوَغى","وإذا يحْكُمُ في السَّلْمِ عَدَلْ",18,"ل",1,0],["جائرُ الألْحاظ كلُّ دمٍ","سَفَكَتْه عندها هَدَرُ",19,"ر",1,0],["جايز جايز في تألّدهِ","عادل في ممالكه عدلا",20,"ل",2,0],["جائر كلّ طريدٍ ماصع","كلّ باغٍ بشبا السيفِ وعادِ",21,"د",1,0],["جائني العقد الذي خوّلني","منكم الفضل المزيد المعتبرْ",22,"ر",1,0],["جائر الأعطاف كم قد هزها","فاسال النفس فوق الأسل",23,"ل",1,0],["جائرةٌ عَدِمْتُ فيها مُنْصِفي","وأَيْنَ مِنْ ذاتِ النَّصيفِ النَّصَفُ",24,"ف",1,0],["جائعةً والقوت كالرمال","فقيرةً وهي ركاز المال",25,"ل",1,0],["جائباً للبحار أهدى لعرسي","فلفُلا مجتنًى وهضمة عطرِ",26,"ر",1,0],["جائِعٌ لَفَّهُ الضَنى بِرِدائِهْ","أَينَ نارُ الجَحيمِ مِن أَحشائِهْ",27,"ا",3,1],["جائِرُ الطرف حائز الظرف ما أعدل","في دولةِ الجَمَال قوامه",28,"م",2,0],["جائزٌ ذلك في الحكم ولو","بها جاز جميعاً وقعد",29,"د",1,0],["جائرُ الحكم حائزٌ كلَّ ما يقْ","ضي وما ذاك بالجميلِ بِجازِي",30,"ز",2,0],["جائت كما شاء الوفاء ومثلما","يهوى فؤادك يا امير ويعشق",31,"ق",1,0],["جائتك كالشمس المنيرة في الضحى","وتوشحت بردا العفاف الطاهر",32,"ر",1,0],["جائته من دولتنا رتبة","لائقة بذاته الساميه",33,"ي",2,0],["جا ي الكتاب الذي قد جاء تبيانا","لكل شيء وتفصيلا وبرهانا",34,"ن",2,0],["جائزة الشعر قديماً غنى","وإنما جائزتي الفاهم",35,"م",1,0],["جائلا في أزقّة ضيقات","وعليه علائم الأوصاب",36,"ب",1,0],["جائِعٌ إِلى","أَكلنا نَهِم",37,"م",1,0],["جائل في البلاد في حلة العز","وبرد التعظيم والإجلال",38,"ل",1,0],["جائِرُ السَّيْفِ عادِلُ الحُكْمِ لا يَبْ","رَحُ فِي حَالَتَيْهِ طَالِبَ أَجْرِ",39,"ر",1,0],["جائر في قضائه جور رد في","ه على خصره على العاشقينا",40,"ن",2,0],["جائين كالسفر الطلاح أطاحهم","سفر من الهيمان قد بلغ المدى",41,"د",2,0],["جائلة الوشاح مدت معصما","ضاق به سواره فانقضما",42,"م",2,0],["جائش الصدر بالسعال كان","الصوت في حلقه علاه فدام",43,"م",1,0],["جائرا بل جائلا في مهمه","ما لغير الجن فيه جولان",44,"ن",1,0],["جائِرُ الأَلحاظِ يثني قامَةً","قَدُّهُ المائِلُ ما أَعدلَهُ",45,"ل",2,0],["جايزة سود البكار اللي عواتقهن عرايا","البكار اللي يقلط من نوادرهن عواين",46,"ن",1,0],["جايز يطول الظلام ولكن العقل اللبيب","يعلم ان الله حي والشرع له يومن يقام",47,"م",1,0],["جايم أفنان اليراع تفننت","على فنن من روض علياء بالصَّدحِ",48,"ح",1,0],["جائت تحييك الوفود فحيهم","مدت اليك يدا فمد لها يدا",49,"د",2,0],["جائتك من طول البلاد وعرضها","وسعت لارضك عندما روى الندى",49,"د",2,0],["جائت جِنودُ الليلِ من غير ميثاق","حطّت على صدر الامل بانجرافي",50,"ف",2,0],["جائحة العصر الحديث احتمي","لهولها الشجعان من دكه",51,"ك",2,0],["جا يطيّب خاطري في كلمتين ... يحسب ان رضاي مضمون وسهل","عذره اللي رجّعه شوق وحنين ... يحسب ان رضاي بشوية غزل",52,"ل",1,1],["جايز يعلمك الزمان .. إني ... ولو تزعل معاك","وان الخرافة في الهوى .. انت وأنا وحمولنا!",53,"ن",2,0],["جائع القلب قمح روحي معنّى","صام دهرا ومايزالُ بليّا",54,"ي",2,0],["جاى وجهه ليلي وجلي حديثه","همومي فقل بدر حات منه اسمار",55,"ر",1,0],["جا يشوف الحال كيفه بعد ماهزه حنينه","وقبل يسألني سألته : كيف حالك يالحبيب ؟",56,"ب",1,1],["جايز إنك في غيابي تقلب الدنيا علي","بس انا من قبل اعرفك قالب الدنيا عليك",57,"ك",1,0],["جاي انزع ابجفك سهم الاصحاب","تبروا من طحت عافوني مطروح",58,"ح",1,0],["جايز إن عنيا عايش","بيها حوله ومطروفين",59,"ن",1,0],["جائحْةُ الدُّنيا كورونا","جاءت للمولى تدعونا",60,"ن",2,1],["جائعات تلوك ما قطع الزارع","من زهره الهزيل الصريع",61,"ع",1,0]]}