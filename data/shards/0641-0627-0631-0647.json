{"poems":[[90,"أصبحت أوسعهم لوما وتثريبا","https://www.aldiwan.net/poem44832.html","البسيط"],[93,"وقفت ضحى في شاطء النيل وقفة","https://www.aldiwan.net/poem8826.html","عموديه"],[254,"أمن دمنة عادية لم تأنس","https://www.aldiwan.net/poem2113.html","الطويل"],[466,"أسد الدين والنداء لغيرا","https://www.aldiwan.net/poem16178.html","الخفيف"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82790","الطويل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108492","الكامل"],[2177,"","https://poetry.dctabudhabi.ae/diwan/poem/138796",""],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26117","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48440","المتقارب"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133146","الطويل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147262","المتقارب"],[4840,"رأى طلعة الباشا المشير تحفها","https://www.poetsgate.com/ViewPoem.aspx?id=129157",""],[5273,"اشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=178281",""],[5273,"وساوس شعرية","https://www.poetsgate.com/ViewPoem.aspx?id=180052",""]],"verses":[["فأرهجوا الشرّ حتى أن هَبْوَتَه","مَدّت سُرادقها في اللوح مضروبا",0,"ب",2,0],["فَأُرهِقَ حَتّى ما يَبينُ كَلامُهُ","وَقُيِّدَ حَتّى لَيسَ تَسري خَواطِرُه",1,"ر",2,0],["فَأَرهَقَ زِنباعاً وَأَتلَفَ فارِغاً","وَأَنفَذَهُ مِنها بِطَعنَةِ مُخلِسِ",2,"س",1,0],["فارِهاً زانَهُ التَّبَرُّعُ والإِفْضالُ","فيه من غيرِ ذُلِّ سُؤالِ",3,"ل",1,0],["فَأَرهق بَعضاً في السُجون مكبلا","وَفَرق بَعضاً في البِلاد مشردا",4,"د",2,0],["فارهب سبينس وارتعد فلديه قد","امست جبال النائبات سهولا",5,"ل",2,0],["فأرهفوا لبني بنت النبي شبا","حد السيوف ودان اللب خوان",6,"ن",1,0],["فارهِز أَباكَ بُنيَّ الخَيطَفى طَلَقا","هَذا إِلَيكَ بُنيَّ الخَيطفى العِذَرُ",7,"ر",1,0],["فأرْهفَ من سيْفِهِ النّصْرُ غرْباً","وسدّدَ من سهْمِهِ العزُّ فُوقا",8,"ق",2,0],["فأرهقني من بين أهلي صبابةً","وتيمني منه سوارٌ وخاتمه",9,"م",2,0],["فإرهاص عصري ظلال التجافي","أزالت وصالا وحبا عظيما",10,"م",2,0],["فارهب أعداء الإله بصولة","لو انبسطت لم تبق في الأرض مجرما",11,"م",2,0],["فأرهقَ فرضَ القوافي حنينٌ","وأتعبَ نبضُ الحروفِ النوافلْ",12,"ل",1,0],["فَأرْهَقَتْ كَلِماتِ الشِّعْرِ دَمْعَتُها","وهلْ فؤادي لظى الآهاتِ يَحْتَمِلُ؟",13,"ل",1,0]]}