54270","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[106,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[90,"لبنان في العراق","https://www.poetsgate.com/ViewPoem.aspx?id=178952",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[45,"قُلْ للوَزِيرِ الذي مَناقِبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=31291",""],[45,"إنْ رَقّ لِي قَلْبُكِ مِمّا أُلاقْ","https://www.poetsgate.com/ViewPoem.aspx?id=33091",""],[51,"لا يكشفُ الله عن وهب بن إسحاق","https://www.poetsgate.com/ViewPoem.aspx?id=29906",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[88,"اشر فعل البرايا فعل منتحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19521&r=&rc=24",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""]],"verses":[["إِنَّ رِماحَ الدَهرِ يَلقَينَ الفَتى","بِغَيرِ عِرفانِ الدُروعِ وَالجُنَن",0,"ن",1,0],["إِن رَأى المَغرَمَ طاطا وَلَهُ","حاجِبٌ مِن حافِزِ اللُئمِ يُمَطّ",1,"ط",1,0],["إِنَّ ريمَ السُربِ أَدنى لي الجَوى","وَنَأى بِالصَبرِ عَنّي وَالجَلَد",2,"د",1,0],["إِنَّ رَيبَ الدَهرِ أَمسى","لَكَ مَأمونَ المَغيبِ",3,"ب",1,0],["إِن راضَها الماءُ أَذعَنَتْ وَجَنَتْ","مِنها النُّفوسُ السُّرورَ وَالطَّرَبا",4,"ب",2,0],["إِنْ رَثَّ بُرْدِي فَلَيْسِ السَّيْفُ مُحْتَفِلاً","بِالغِمْدِ وَهْوَ رَميضُ الغَرْبِ باتِرُهُ",5,"ر",2,0],["إِنَّ روحي عَلى يَدِ الدَهرِ رَهنٌ","إِن تَوَلَّت فَقَد تَوَلّى الرَهينُ",6,"ن",1,0],["إِنَّ رَبّاً كَفاكَ بِالأَمسِ ماكا","نَ سَيَكفيكَ في غَدٍ ما يَكونُ",7,"ن",1,0],["إنْ رأَى الحقُّ فيكَ منْكَ بقيّةْ","فاتّقِ البُعْدَ منْهُ حقَّ التّقِيّهْ",8,"ه",1,1],["إِنْ رَاعَ مِنْ يَوْمِ الْوَغَى عَبَّاسُهُ","فِي الْحَرْبِ كَانَ جَبِينُكَ الضَّحَّاكَا",9,"ك",2,0],["إنْ راعَ خطْبٌ أو عَرا جَدْبٌ تُرى","كفّاهُ تدْرأُ ذا وذاك تُداري",10,"ر",2,0],["إِنْ رَامَ بِالْتَدْبِيرِ حِيلَةَ بُرْئِهَا","أُبْدَتْ مَنَافِعَهَا لَهُ الأَعْضَاءُ",11,"ا",2,0],["إِن راعَنا صَوتُ النَعِ","يِ وَفاتَنا نَبَأُ البَشيرِ",12,"ر",1,0],["إِن رَيتَ رَأياً في الحِجابِ وَلَم","تُعصَم فَتِلكَ مَراتِبُ الرُسُلِ",13,"ل",1,0],["أَنَروى وَلا تَروى وَأَنتَ أَحَقُّنا","بِرِيٍّ فَيا قَلبَ النُبوغِ تَقَطَّعِ",14,"ع",1,0],["إِن رَشَّحوكَ فَأَنتَ مِن بَيتٍ رَمى","بِسِهامِهِ عَن حَوزَةِ الأَوطانِ",15,"ن",1,0],["إِن رُمتَ أَن تَعكِسَهُ","فَلَستَ تَستَطيعُهُ",16,"ه",1,0],["إِن رامَ يَوماً وَصفَ عَليائِهِ","مُفَوَّهٌ مُقتَدِرٌ أُخرِسا",17,"س",2,0],["إِنَّ رِيَاضاً أَخْرَجَتْ لِلنُّهَى","هَذِي الثِّمَارَ الغَضَّةَ الْيَانِعَهْ",18,"ع",2,0],["إِنْ رَشَدْتُمْ حَمِيَّةً وَاعْتِزَامَا","أَيُّهَا النَّاخِبُونَ أَمرُ البِلادِ",19,"د",1,0],["إِن رامَ يَكسِرُها بِالسِنِّ تَثلِمُهُ","وَكَسرُها راحَةٌ لِلهائِمِ الدَنِفِ",20,"ف",1,0],["إن رب ذا البنيّا","قد عطاه دول هنيّا",21,"ي",2,0],["إن رُدَّت الشمس من بعد الغروب له","قد ظلَّلَتُهُ غمامُ الجوِّ حيث نَحا",22,"ح",2,0],["أنريد أن يقفو الزمان أمورنا","وأمورنا هي للزمان قوافي",23,"ي",1,0],["إن رمت تشبع من مجد فكُلْ همماً","كأكلك السَمنَ ملبوكاً به الأقِط",24,"ط",1,0],["أن رُمت عزاً على فقر تُكابده","فأستغنِ عن مال أهل البَذْخ والبَطَر",25,"ر",1,0],["إن رمت عيشاً ناعماً ورقيقاً","فاسلك إليه من الفنون طريقا",26,"ق",2,1],["إِن رُمتَ عِندَ بَني أُسَيدَةَ عِزَّنا","فَاِنقُل مَناكِبَ يَذبُلٍ وَذِقانِ",27,"ن",1,0],["إن رآني هذا وذاك ممن","أنعم الله صبحه ومساه",28,"ه",1,0],["أنَّ رأيي لذو الرجاحةِ وزناً","دَعْ يميني وزِنْهُ والآراءَ",29,"ا",2,0],["إنْ رجع الطَّرفُ متى رِبْتَنِي","وأنتَ من عِرْضك لم تُسْلخِ",30,"خ",1,0],["إن رُمتُ مدحاً لم أجدْ أهله","أورمتُ هجواً لم أجد عِرضا",31,"ض",2,0],["إنْ رأت نِعمةٌ نظيرَ أخيكم","وابنَه فلْتبدّلِ الأبدالا",32,"ل",2,0],["إن رئيساً يراك يوماً","لصابرٌ للأذى حمولُ",33,"ل",1,0],["إنْ رَبَّيا قَتَلا أو أسْمنا أكَلا","فما دَمٌ طَمِعا فيه بمحقون",34,"ن",1,0],["إنَّ ربَّ العبادِ يرزقُ من يَخْ","لُق فليُحْسنَنَّ ظنَّاً ظَنُونه",35,"ن",2,0],["إِنَّ رَبيعَةَ لَن تَنفَكَّ صالِحَةً","ما أَخَّرَ اللَهُ عَن حَوبائِكَ الأَجَلا",36,"ل",2,0],["ان رمت في اليتم ابا","فانه المعلم",37,"م",1,0],["ان رزء البلاد بالملك الرا","حل من غير اوبة لثقيل",38,"ل",1,0],["أنريد في تعليله","ارضاء قوم جهل",39,"ل",1,0],["إن رأتني تميل عني كأن لم","يجتذبها يوماً إليَّ الولاء",40,"ا",2,0],["إن رام عني الحبيب بعدا","لم ينأَ عن مقلتي خياله",41,"ه",1,0],["إن ركب الحضارة اخترق الأر","ض وشق السماء ريحا ومزنا",42,"ن",2,0],["إن رأى أبقى على مملوكه","أو رأى أتلفه واحتسبا",43,"ب",2,0],["إِن رُزِقتَ العِلمَ زِنهُ بِالبَيان","ما يُفيدُ العَقلُ إِن عَيَّ اللِسان",44,"ن",1,0],["إِن رَأَتني تَميلُ عَنّي كَأَن لَم","تَكُ بَيني وَبَينَها أَشياءُ",45,"ا",2,0],["إِنَّ رَيْبَ الزَّمانِ طالَ انْتِكائُهْ","كَمْ رَمَتْني بحادِثٍ أَحْداثُهْ",46,"ه",1,1],["إِن رُفِعَت لِلعِدى قَساطِلُها","أَنجَزَ صَرفُ الزَمانِ ما يَعِدُه",47,"د",2,0],["إِنَّ رَدَّها السَعيُ وَالدَأوبُ","فَقَد وَفَيتُ في السَعيِ أَشهُراً عَشَرَه",48,"ر",2,0],["إِنَّ رَيّا لَم تَسقِ رَيّا مِنَ الوَص","لِ وَلَم تَدرِ ماجَوى العُشّاقِ",49,"ق",1,0],["إِن رَقَّ لي قَلبُكِ مِمّا أُلاقي","مِن فَرطِ تَعذيبٍ وَفَرطِ اِشتِياق",50,"ق",1,1],["إِن رَأى عِندَكَ إِعتِزامَةَ جِدٍّ","لَم يُقَلِّل ما كَثَّرَ أَذكوتِكينُ",51,"ن",1,0],["إِنَّ رِجالَ الرومِ يَعرِفُ أَهلُها","حَديثي وَمَعروفٌ أَبي في المَنازِلِ",52,"ل",1,1],["إِنَّ رَأياً دَعا إِلى طاعَةِ اللَ","هِ لَرَأيٌ مُبارَكٌ مَيمونُ",53,"ن",1,0],["إِنَّ روحي لَبِبَغدا","دَ وَفي الكوفَةِ جِسمي",54,"م",2,0],["إِنَّ روحي لَم يَبقَ مِنها سِوى شَي","ءٍ يَسيرٍ مُعَلَّقٍ بِلِساني",55,"ي",1,0],["إِن رُمتُ بِالنَظمِ البَديعِ صِفاتِهِ","لَم أَلقَ غَيرَ نِهايَةِ الإِعجازِ",56,"ز",1,0],["إِن رُمتَ تَصديقَ ذاكَ يا أَعوَرُ الد","دَجالُ فَاِلحَظهُمُ وَلا تَذُبِ",57,"ب",1,0],["إِنَّ رَيبَ الزَمانِ يُحسِنُ أَن يُه","دي الرَزايا إِلى ذَوي الأَحسابِ",58,"ب",1,0],["إِن رَفرَفَت سَكَنَت ظِلّاً وَإِن هَبَطَت","رَوَت غَليلَ الصَّدى مِن حائِرٍ شَبِمِ",59,"م",1,0],["إِنْ رَابَكَ الدَّهْرُ لَمْ تَفْشَلْ عَزَائِمُهُ","أَوْ نَابَكَ الْهَمُّ لَمْ تَفْتُرْ وَسَائِلُهُ",60,"ل",2,0],["إنْ رمتَ تذكرُ في زمانِكَ عالياً","متواضِعاً فابدأ بذكر القونوي",61,"ي",1,1],["إنْ رامَ ردفُكِ قتلي","فقاتلُ النفسِ يُقتلْ",62,"ل",1,1],["أَنَرى نِعمَةً نَراها عَلَينا","مِنكَ يَوماً قَبلا المَماتِ وَمِنّا",63,"ن",2,0],["إِن رُمتُ صَبراً أَو سُلُوّاً بِغَيرِها","رَأَيتُ جَميعَ الناسِ مِن دونِها بَعضا",64,"ض",2,0],["أَنُريدُ رحمةَ رَبِّنا وكِتَابُهُ","يُجْفَى على مَرِّ الزَّمانِ ويُهْجَرُ",65,"ر",1,0],["أَنَروحُ صُمّاً والحوادثُ رُجَّفٌ","أَنظلُّ بُكماً والخُطوبُ فِصَاحُ",66,"ح",1,0],["إن رسا البنيانُ يوماً أو سَمَا","فَهِيَ الأركانُ فيه والدُّعُمْ",67,"م",1,0],["أَنَرى المَمالِكَ كُلَّ يَومٍ حَولَنا","تَسعى وَنَحنُ عَلى الرَجاءِ قُعودُ",68,"د",1,0],["إِن رُمتُ مِنهُ الوَصلَ فِعلاً حاضِراً","أَومَت لِلاِستِئنافِ سينُ جَبينِهِ",69,"ن",2,0],["أَن رُبَّ لَيلَةِ مِشفارٍ مُزَعزِعَةٍ","طَخياءَ لَيسَ بِها لِلنِسعِ مُلتَمَسُ",70,"س",1,0],["أَن رَأَت رَوعَةً مِنَ الشَيبِ صارَت","في قذالي مُبِينَةً كِالشِهابِ",71,"ب",1,0],["إِن رَقَدوا فَإِنَّهُ لا يَرقُدُ","أَو قَعَدوا فَإِنَّهُ لا يَقعُدُ",72,"د",1,0],["إِنَّ رَأياً أَراكَ تَقديمَ بَدرٍ","لَعَجيبٌ مُوَفَّقٌ لِلصَوابِ",73,"ب",1,0],["إِن رُمتَ أَكبرَ آياتٍ وأكمَلها","كفاكَ مِن مُحكَمِ القُرآنِ تَنزِيلُ",74,"ل",1,0],["إنّ رأياً تُديره لَمُعَنّىً","بضَلالِ الإمضاءِ والتّوقيف",75,"ف",1,0],["إِن رامَ إِعجالاً أَبى رَدفُهُ","أَو رامَ عَطفاً جُرَّ لِلعَطفِ",76,"ف",1,0],["إِنَّ رَفّاءَكَ هَذا","أَحذَقُ الأُمَّةِ كَفّا",77,"ف",2,0],["إِن رابَهُ مِن أَمرِهِ رائِبٌ","فَما لَهُ مِن دونِها واقِ",78,"ق",1,0],["أَنَّ رَوحَ بنَ حاتِمٍ وَرَدَ البَح","رَ فَأَضحى يَنتابُهُ الطُلّابُ",79,"ب",1,0],["إِنَّ رَبَّ الحِصنِ المَشيدِ بِتَيما","ءَ تَوَلى وَخُلِّفَت تَيماءُ",80,"م",3,0],["إِن رابَنا الدَهرُ بِأَفعالِهِ","فَكُلُّنا بِالدَهرِ مُرتابُ",81,"ب",1,0],["إِن رازَ عاذِلُكَ الرازِيَّ مُختَبِراً","أَوِ الحِجازِيِّ لَم يُعجِبهُ ما رازا",82,"ز",2,1],["إِن رُمتَ مِن شَيخٍ رَهطٍ في دِيانَتِهِ","دَليلَ عَقلٍ عَلى ما قالَهُ خَرَقا",83,"ق",2,0],["أَنَرهَبُ هَذِهِ الغَبراءَ ناراً","تُطَبِّقُ مِثلَ ما تَهوي سَراها",84,"ا",3,0],["إِن رَأَتني تَغَيَّرَ اللَونُ مِنّي","وَعَلا الشَيبُ مَفرِقي وَقَذالي",85,"ي",1,0],["إنْ رَضِيْتُمْ بأنْ أَمُو","تَ فَموتِي حَقيرُ",86,"ر",1,0],["إنْ رُمْتَ إصْلاَحِي فإنّي لم أُرِدْ","لفَسَادِ قَلبي في الهوَى إصلاحا",87,"ح",2,0],["إن رمت تفقه معنى الشعر مكتنهاً","فاسأل عن الشعر أَهل العلم والنظر",88,"ر",1,0],["أنرت يا فجر لَيلي","وَكانَ ذا ظلمات",89,"ت",1,0],["إن رمت في الأمر اعتصاماً بالحجى","فامسك بحبل منه غير رمام",90,"م",1,0],["إِن راعَنا صَوتُ النَعِي","يِ وَفاتَنا نَبَأُ البَشيرِ",91,"ر",1,0],["إِنَّ رُوحِي مِنْ أَمْرِ رَبِّي","وَمَا يَكْشِفُ عَنْهَا الحِجَابَ إِلاَّ الضَّمِيرُ",92,"ر",1,0],["أَنرْتجِلُ الأَشْعَارَ فِي فَرْعِ هَاشِمٍ","وَهَل لِيَ فِي بَيْتَيْنِ أَنْ أَجْمَعَ الْمَجْدَ",93,"د",1,1],["أَنَرْتَ بِهَا الأَذْهَانَ أَيَّ إِنَارَةٍ","مُفَرِّقَةٍ بَيْنَ الحَقِيقةِ وَالبُطْلِ",94,"ل",1,0],["إِنَّ رُزْءَ الجُمَيِّلِ العَلَمِ الفَرْ","دِ لَرُزْءٌ فِي المَشْرِقيْنِ كَبِيرُ",95,"ر",1,0],["إِنْ رَسَا فِي موْضِعٍ طَمَّ الأَسَى","أَوْ مَضى فاظْنُنْ بِسَيْفِ اللّهِ بَترَا",96,"ر",2,0],["إِنَّ رومَا جَعَلَتْ نيرْونَهَا","وَهْوَ شَرُّ القوْمِ مِمَّا كَانَ شَرَّا",96,"ر",2,0],["إِنَّ رُوْحَيْكُمَا تَنَاشَدَتَا في الغَيْبِ","حَتَّى اطْمَأَنَّتَا بِاللِّقَاءِ",97,"ا",2,0],["إن راح يُنكرني الجهول عذرته","ورحمته أيُلام من لا يفهم",98,"م",1,0],["إن رأَوْا صفحةً بها بيتُ شعرٍ","تركوه يبكي على كلِّ باني",99,"ي",1,0],["إن رأيتم أُخُوّةَ العودِ للجز","بنِد فابكوا سُلالةَ العيدان",99,"ن",1,0],["إِنْ رَأَيتَ الْعَيْنَ ناعِسَةً","فَتَرَقَّبْ يَقْظَةَ الْفِتَنِ",100,"ن",1,0],["إن رقّ أبصرت حلم عاشقة","وليلها والحنين يعتصرهْ",101,"ر",2,0],["إن رمَى الشكَ رأيُهُ فَرّ حيْرا","ن يجِرُّ الذيولَ من شُبُهاته",102,"ت",2,0],["أنرتَضِي أنْ نَرى مِيراثَنا بَدَداً","وتكتفي بدموعٍ في مآقِينَا",103,"ن",2,0],["إن رُمْتَ للشعب الحياة فَغَذِّه","بالفنِّ، قبل طعامه، وشرابه",104,"ب",2,0],["إن رأيتِ الحديثَ يمتازُ بالرقةِ","والُلطف فيكِ عمَّن عَداك",105,"ك",1,0],["أنِر العُقول من الجهالة يستبنْ","وضحَ السبيلِ ويهتدي الحيران",106,"ن",1,0],["إن ردَّ الكريم عارٌ على النَفس","وحاشاي انني صُنتُ نَفسْا",107,"س",2,0],["إنْ رَدّها السّعْيُ وَالدُّؤوبُ، فقَدْ","وَفَيْتُ في السّعيِ أشهُراً عَشَرَهْ",108,"ر",2,0],["إنْ رَقّ لِي قَلْبُكِ مِمّا أُلاقْ","مِنْ فَرْطِ تَعذِيبٍ، وفرْطَِ اشتياقْ",109,"ق",1,1],["إنْ رأيت حَيائي خِلْته خُنثاً","قد غُرَّ من غُرَّ من أفعى بإطراقِ",110,"ق",1,0],["أَنَرْنَ نُهَاها فِي اعْتِكَارِ التَّجَارِبِ","بِنِيرَانِهِنَّ المُحْرِقَاتِ الثَّوَاقِبِ",111,"ب",1,0],["إن رمت عزاً على فقر تكابده","فاستغن عن مال اهل البذخ والبظفر",112,"ر",1,0],["إن ركوبَ البحرِ ما لمْ يكنْ","ذا مصدرٍ منْ تهلكاتِ الغريقْ",113,"ق",1,0]]}