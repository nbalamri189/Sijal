iwan.net/poem15097.html","البسيط"],[465,"أما وبنات الفكر حلفة فاضل","https://www.aldiwan.net/poem3336.html","عموديه"],[469,"أنر بصبح الوصل عيشي فقد","https://www.aldiwan.net/poem59676.html","السريع"],[469,"نحن الليوث التي تسيل دما","https://www.aldiwan.net/poem60436.html","المنسرح"],[480,"زان طرفها الحور","https://www.aldiwan.net/poem36921.html","المقتضب"],[480,"الخفيف","https://www.aldiwan.net/poem36924.html","الخفيف"],[480,"إن رمت إرضاء الخصوم فلا تقل","https://www.aldiwan.net/poem36959.html","الكامل"],[480,"وجه غادتي القمر","https://www.aldiwan.net/poem37069.html","المقتضب"],[483,"خود رمت عن قوس حاجبها سها","https://www.aldiwan.net/poem24485.html","عموديه"],[483,"ما لنا في الإمكان أبدع مما","https://www.aldiwan.net/poem24486.html","عموديه"],[501,"إن راعك الخصم الحقود بصولة","https://www.aldiwan.net/poem37791.html","الكامل"],[501,"وحي السماء منزل ببيوتنا","https://www.aldiwan.net/poem37804.html","الكامل"],[501,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[501,"متكين بصرتنا وأحمد أحمد","https://www.aldiwan.net/poem38030.html","الكامل"],[505,"أفنى الضنا جسدي وابلى بالي","https://www.aldiwan.net/poem38411.html","الكامل"],[516,"المدح يدري أنكم أكبر","https://www.aldiwan.net/poem12115.html","السريع"],[516,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[516,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[530,"إن رضى كل الورى لا مرا","https://www.aldiwan.net/poem37240.html","السريع"],[539,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[552,"قل لعيني لا تملا الدموعا","https://www.aldiwan.net/poem47711.html","الخفيف"],[552,"إن قطعتني علتي عن قصدي","https://www.aldiwan.net/poem47845.html","الرجز"],[559,"طرف الذي طلب التحقيق سهران","https://www.aldiwan.net/poem33823.html","البسيط"],[559,"لم يفه يا ذا الوجه فم","https://www.aldiwan.net/poem34084.html","المديد"],[559,"إن روحي بجسمها مصبوغه","https://www.aldiwan.net/poem34362.html","الخفيف"],[559,"يشف ثوب عنه لي مخيط","https://www.aldiwan.net/poem34404.html","الرجز"],[559,"قوم بهم ينفخ الشيطان نفخ الزمر","https://www.aldiwan.net/poem34514.html","المواليا"],[559,"إن رمت بالمثل التقريب مقتصدا","https://www.aldiwan.net/poem34599.html","البسيط"],[559,"من لعبد بجسمه السقم بادي","https://www.aldiwan.net/poem34600.html","الخفيف"],[559,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[559,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[564,"يا عاصمي يا سالمي يا قاسمي","https://www.aldiwan.net/poem13606.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"دع قضب نعمان أو كثبان يبرين","https://www.aldiwan.net/poem2851.html","البسيط"],[576,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[576,"لست الملوم بما تجني علي بصري","https://www.aldiwan.net/poem3066.html","البسيط"],[576,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[587,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"],[587,"أقلب قلبي شوقا إليه","https://www.aldiwan.net/poem17993.html","المتقارب"],[587,"لا ولين المعاطف المياله","https://www.aldiwan.net/poem18012.html","الخفيف"]],"verses":[["إِنَّ رِماحَ الدَهرِ يَلقَينَ الفَتى","بِغَيرِ عِرفانِ الدُروعِ وَالجُنَن",0,"ن",1,0],["إِن رَأى المَغرَمَ طاطا وَلَهُ","حاجِبٌ مِن حافِزِ اللُئمِ يُمَطّ",1,"ط",1,0],["إِنَّ ريمَ السُربِ أَدنى لي الجَوى","وَنَأى بِالصَبرِ عَنّي وَالجَلَد",2,"د",1,0],["إِنَّ رَيبَ الدَهرِ أَمسى","لَكَ مَأمونَ المَغيبِ",3,"ب",1,0],["إِن راضَها الماءُ أَذعَنَتْ وَجَنَتْ","مِنها النُّفوسُ السُّرورَ وَالطَّرَبا",4,"ب",2,0],["إِنْ رَثَّ بُرْدِي فَلَيْسِ السَّيْفُ مُحْتَفِلاً","بِالغِمْدِ وَهْوَ رَميضُ الغَرْبِ باتِرُهُ",5,"ر",2,0],["إِنَّ روحي عَلى يَدِ الدَهرِ رَهنٌ","إِن تَوَلَّت فَقَد تَوَلّى الرَهينُ",6,"ن",1,0],["إِنَّ رَبّاً كَفاكَ بِالأَمسِ ماكا","نَ سَيَكفيكَ في غَدٍ ما يَكونُ",7,"ن",1,0],["إنْ رأَى الحقُّ فيكَ منْكَ بقيّةْ","فاتّقِ البُعْدَ منْهُ حقَّ التّقِيّهْ",8,"ه",1,1],["إِنْ رَاعَ مِنْ يَوْمِ الْوَغَى عَبَّاسُهُ","فِي الْحَرْبِ كَانَ جَبِينُكَ الضَّحَّاكَا",9,"ك",2,0],["إنْ راعَ خطْبٌ أو عَرا جَدْبٌ تُرى","كفّاهُ تدْرأُ ذا وذاك تُداري",10,"ر",2,0],["إِنْ رَامَ بِالْتَدْبِيرِ حِيلَةَ بُرْئِهَا","أُبْدَتْ مَنَافِعَهَا لَهُ الأَعْضَاءُ",11,"ا",2,0],["إِن راعَنا صَوتُ النَعِ","يِ وَفاتَنا نَبَأُ البَشيرِ",12,"ر",1,0],["إِن رَيتَ رَأياً في الحِجابِ وَلَم","تُعصَم فَتِلكَ مَراتِبُ الرُسُلِ",13,"ل",1,0],["أَنَروى وَلا تَروى وَأَنتَ أَحَقُّنا","بِرِيٍّ فَيا قَلبَ النُبوغِ تَقَطَّعِ",14,"ع",1,0],["إِن رَشَّحوكَ فَأَنتَ مِن بَيتٍ رَمى","بِسِهامِهِ عَن حَوزَةِ الأَوطانِ",15,"ن",1,0],["إِن رُمتَ أَن تَعكِسَهُ","فَلَستَ تَستَطيعُهُ",16,"ه",1,0],["إِن رامَ يَوماً وَصفَ عَليائِهِ","مُفَوَّهٌ مُقتَدِرٌ أُخرِسا",17,"س",2,0],["إِنَّ رِيَاضاً أَخْرَجَتْ لِلنُّهَى","هَذِي الثِّمَارَ الغَضَّةَ الْيَانِعَهْ",18,"ع",2,0],["إِنْ رَشَدْتُمْ حَمِيَّةً وَاعْتِزَامَا","أَيُّهَا النَّاخِبُونَ أَمرُ البِلادِ",19,"د",1,0],["إِن رامَ يَكسِرُها بِالسِنِّ تَثلِمُهُ","وَكَسرُها راحَةٌ لِلهائِمِ الدَنِفِ",20,"ف",1,0],["إن رب ذا البنيّا","قد عطاه دول هنيّا",21,"ي",2,0],["إن رُدَّت الشمس من بعد الغروب له","قد ظلَّلَتُهُ غمامُ الجوِّ حيث نَحا",22,"ح",2,0],["أنريد أن يقفو الزمان أمورنا","وأمورنا هي للزمان قوافي",23,"ف",2,0],["إن رمت تشبع من مجد فكُلْ همماً","كأكلك السَمنَ ملبوكاً به الأقِط",24,"ط",1,0],["أن رُمت عزاً على فقر تُكابده","فأستغنِ عن مال أهل البَذْخ والبَطَر",25,"ر",1,0],["إن رمت عيشاً ناعماً ورقيقاً","فاسلك إليه من الفنون طريقا",26,"ق",2,1],["إِن رُمتَ عِندَ بَني أُسَيدَةَ عِزَّنا","فَاِنقُل مَناكِبَ يَذبُلٍ وَذِقانِ",27,"ن",1,0],["إن رآني هذا وذاك ممن","أنعم الله صبحه ومساه",28,"ه",1,0],["أنَّ رأيي لذو الرجاحةِ وزناً","دَعْ يميني وزِنْهُ والآراءَ",29,"ا",2,0],["إنْ رجع الطَّرفُ متى رِبْتَنِي","وأنتَ من عِرْضك لم تُسْلخِ",30,"خ",1,0],["إن رُمتُ مدحاً لم أجدْ أهله","أورمتُ هجواً لم أجد عِرضا",31,"ض",2,0],["إنْ رأت نِعمةٌ نظيرَ أخيكم","وابنَه فلْتبدّلِ الأبدالا",32,"ل",2,0],["إن رئيساً يراك يوماً","لصابرٌ للأذى حمولُ",33,"ل",1,0],["إنْ رَبَّيا قَتَلا أو أسْمنا أكَلا","فما دَمٌ طَمِعا فيه بمحقون",34,"ن",1,0],["إنَّ ربَّ العبادِ يرزقُ من يَخْ","لُق فليُحْسنَنَّ ظنَّاً ظَنُونه",35,"ن",2,0],["إِنَّ رَبيعَةَ لَن تَنفَكَّ صالِحَةً","ما أَخَّرَ اللَهُ عَن حَوبائِكَ الأَجَلا",36,"ل",2,0],["ان رمت في اليتم ابا","فانه المعلم",37,"م",1,0],["ان رزء البلاد بالملك الرا","حل من غير اوبة لثقيل",38,"ل",1,0],["أنريد في تعليله","ارضاء قوم جهل",39,"ل",1,0],["إن رأتني تميل عني كأن لم","يجتذبها يوماً إليَّ الولاء",40,"ا",2,0],["إن رام عني الحبيب بعدا","لم ينأَ عن مقلتي خياله",41,"ه",1,0],["إن ركب الحضارة اخترق الأر","ض وشق السماء ريحا ومزنا",42,"ن",2,0],["إن رأى أبقى على مملوكه","أو رأى أتلفه واحتسبا",43,"ب",2,0],["إِن رُزِقتَ العِلمَ زِنهُ بِالبَيان","ما يُفيدُ العَقلُ إِن عَيَّ اللِسان",44,"ن",1,0],["إِن رَأَتني تَميلُ عَنّي كَأَن لَم","تَكُ بَيني وَبَينَها أَشياءُ",45,"ا",2,0],["إِنَّ رَيْبَ الزَّمانِ طالَ انْتِكائُهْ","كَمْ رَمَتْني بحادِثٍ أَحْداثُهْ",46,"ه",1,1],["إِن رُفِعَت لِلعِدى قَساطِلُها","أَنجَزَ صَرفُ الزَمانِ ما يَعِدُه",47,"د",2,0],["إِنَّ رَدَّها السَعيُ وَالدَأوبُ","فَقَد وَفَيتُ في السَعيِ أَشهُراً عَشَرَه",48,"ر",2,0],["إِنَّ رَيّا لَم تَسقِ رَيّا مِنَ الوَص","لِ وَلَم تَدرِ ماجَوى العُشّاقِ",49,"ق",1,0],["إِن رَقَّ لي قَلبُكِ مِمّا أُلاقي","مِن فَرطِ تَعذيبٍ وَفَرطِ اِشتِياق",50,"ق",1,1],["إِن رَأى عِندَكَ إِعتِزامَةَ جِدٍّ","لَم يُقَلِّل ما كَثَّرَ أَذكوتِكينُ",51,"ن",1,0],["إِنَّ رِجالَ الرومِ يَعرِفُ أَهلُها","حَديثي وَمَعروفٌ أَبي في المَنازِلِ",52,"ل",1,1],["إِنَّ رَأياً دَعا إِلى طاعَةِ اللَ","هِ لَرَأيٌ مُبارَكٌ مَيمونُ",53,"ن",1,0],["إِنَّ روحي لَبِبَغدا","دَ وَفي الكوفَةِ جِسمي",54,"م",2,0],["إِنَّ روحي لَم يَبقَ مِنها سِوى شَي","ءٍ يَسيرٍ مُعَلَّقٍ بِلِساني",55,"ي",1,0],["إِن رُمتُ بِالنَظمِ البَديعِ صِفاتِهِ","لَم أَلقَ غَيرَ نِهايَةِ الإِعجازِ",56,"ز",1,0],["إِن رُمتَ تَصديقَ ذاكَ يا أَعوَرُ الد","دَجالُ فَاِلحَظهُمُ وَلا تَذُبِ",57,"ب",1,0],["إِنَّ رَيبَ الزَمانِ يُحسِنُ أَن يُه","دي الرَزايا إِلى ذَوي الأَحسابِ",58,"ب",1,0],["إِن رَفرَفَت سَكَنَت ظِلّاً وَإِن هَبَطَت","رَوَت غَليلَ الصَّدى مِن حائِرٍ شَبِمِ",59,"م",1,0],["إِنْ رَابَكَ الدَّهْرُ لَمْ تَفْشَلْ عَزَائِمُهُ","أَوْ نَابَكَ الْهَمُّ لَمْ تَفْتُرْ وَسَائِلُهُ",60,"ل",2,0],["إنْ رمتَ تذكرُ في زمانِكَ عالياً","متواضِعاً فابدأ بذكر القونوي",61,"ي",1,1],["إنْ رامَ ردفُكِ قتلي","فقاتلُ النفسِ يُقتلْ",62,"ل",1,1],["أَنَرى نِعمَةً نَراها عَلَينا","مِنكَ يَوماً قَبلا المَماتِ وَمِنّا",63,"ن",2,0],["إِن رُمتُ صَبراً أَو سُلُوّاً بِغَيرِها","رَأَيتُ جَميعَ الناسِ مِن دونِها بَعضا",64,"ض",2,0],["أَنُريدُ رحمةَ رَبِّنا وكِتَابُهُ","يُجْفَى على مَرِّ الزَّمانِ ويُهْجَرُ",65,"ر",1,0],["أَنَروحُ صُمّاً والحوادثُ رُجَّفٌ","أَنظلُّ بُكماً والخُطوبُ فِصَاحُ",66,"ح",1,0],["إن رسا البنيانُ يوماً أو سَمَا","فَهِيَ الأركانُ فيه والدُّعُمْ",67,"م",1,0],["أَنَرى المَمالِكَ كُلَّ يَومٍ حَولَنا","تَسعى وَنَحنُ عَلى الرَجاءِ قُعودُ",68,"د",1,0],["إِن رُمتُ مِنهُ الوَصلَ فِعلاً حاضِراً","أَومَت لِلاِستِئنافِ سينُ جَبينِهِ",69,"ن",2,0],["أَن رُبَّ لَيلَةِ مِشفارٍ مُزَعزِعَةٍ","طَخياءَ لَيسَ بِها لِلنِسعِ مُلتَمَسُ",70,"س",1,0],["أَن رَأَت رَوعَةً مِنَ الشَيبِ صارَت","في قذالي مُبِينَةً كِالشِهابِ",71,"ب",1,0],["إِن رَقَدوا فَإِنَّهُ لا يَرقُدُ","أَو قَعَدوا فَإِنَّهُ لا يَقعُدُ",72,"د",1,0],["إِنَّ رَأياً أَراكَ تَقديمَ بَدرٍ","لَعَجيبٌ مُوَفَّقٌ لِلصَوابِ",73,"ب",1,0],["إِن رُمتَ أَكبرَ آياتٍ وأكمَلها","كفاكَ مِن مُحكَمِ القُرآنِ تَنزِيلُ",74,"ل",1,0],["إنّ رأياً تُديره لَمُعَنّىً","بضَلالِ الإمضاءِ والتّوقيف",75,"ف",1,0],["إِن رامَ إِعجالاً أَبى رَدفُهُ","أَو رامَ عَطفاً جُرَّ لِلعَطفِ",76,"ف",1,0],["إِنَّ رَفّاءَكَ هَذا","أَحذَقُ الأُمَّةِ كَفّا",77,"ف",2,0],["إِن رابَهُ مِن أَمرِهِ رائِبٌ","فَما لَهُ مِن دونِها واقِ",78,"ق",1,0],["أَنَّ رَوحَ بنَ حاتِمٍ وَرَدَ البَح","رَ فَأَضحى يَنتابُهُ الطُلّابُ",79,"ب",1,0],["إِنَّ رَبَّ الحِصنِ المَشيدِ بِتَيما","ءَ تَوَلى وَخُلِّفَت تَيماءُ",80,"م",3,0],["إِن رابَنا الدَهرُ بِأَفعالِهِ","فَكُلُّنا بِالدَهرِ مُرتابُ",81,"ب",1,0],["إِن رازَ عاذِلُكَ الرازِيَّ مُختَبِراً","أَوِ الحِجازِيِّ لَم يُعجِبهُ ما رازا",82,"ز",2,1],["إِن رُمتَ مِن شَيخٍ رَهطٍ في دِيانَتِهِ","دَليلَ عَقلٍ عَلى ما قالَهُ خَرَقا",83,"ق",2,0],["أَنَرهَبُ هَذِهِ الغَبراءَ ناراً","تُطَبِّقُ مِثلَ ما تَهوي سَراها",84,"ا",3,0],["إِن رَأَتني تَغَيَّرَ اللَونُ مِنّي","وَعَلا الشَيبُ مَفرِقي وَقَذالي",85,"ل",2,0],["إنْ رَضِيْتُمْ بأنْ أَمُو","تَ فَموتِي حَقيرُ",86,"ر",1,0],["إنْ رُمْتَ إصْلاَحِي فإنّي لم أُرِدْ","لفَسَادِ قَلبي في الهوَى إصلاحا",87,"ح",2,0],["إن رمت تفقه معنى الشعر مكتنهاً","فاسأل عن الشعر أَهل العلم والنظر",88,"ر",1,0],["أنرت يا فجر لَيلي","وَكانَ ذا ظلمات",89,"ت",1,0],["إن رمت في الأمر اعتصاماً بالحجى","فامسك بحبل منه غير رمام",90,"م",1,0],["إِن راعَنا صَوتُ النَعِي","يِ وَفاتَنا نَبَأُ البَشيرِ",91,"ر",1,0],["إن رعى صحبتي وأوردها الصفو","فقد كان بالمعالي خليقا",92,"ق",2,0],["إِنَّ رُوحِي مِنْ أَمْرِ رَبِّي","وَمَا يَكْشِفُ عَنْهَا الحِجَابَ إِلاَّ الضَّمِيرُ",93,"ر",1,0],["أَنرْتجِلُ الأَشْعَارَ فِي فَرْعِ هَاشِمٍ","وَهَل لِيَ فِي بَيْتَيْنِ أَنْ أَجْمَعَ الْمَجْدَ",94,"د",1,1],["أَنَرْتَ بِهَا الأَذْهَانَ أَيَّ إِنَارَةٍ","مُفَرِّقَةٍ بَيْنَ الحَقِيقةِ وَالبُطْلِ",95,"ل",1,0],["إِنَّ رُزْءَ الجُمَيِّلِ العَلَمِ الفَرْ","دِ لَرُزْءٌ فِي المَشْرِقيْنِ كَبِيرُ",96,"ر",1,0],["إِنْ رَسَا فِي موْضِعٍ طَمَّ الأَسَى","أَوْ مَضى فاظْنُنْ بِسَيْفِ اللّهِ بَترَا",97,"ر",2,0],["إِنَّ رومَا جَعَلَتْ نيرْونَهَا","وَهْوَ شَرُّ القوْمِ مِمَّا كَانَ شَرَّا",97,"ر",2,0],["إِنَّ رُوْحَيْكُمَا تَنَاشَدَتَا في الغَيْبِ","حَتَّى اطْمَأَنَّتَا بِاللِّقَاءِ",98,"ا",2,0],["إن راح يُنكرني الجهول عذرته","ورحمته أيُلام من لا يفهم",99,"م",1,0],["إن رأَوْا صفحةً بها بيتُ شعرٍ","تركوه يبكي على كلِّ باني",100,"ن",2,0],["إن رأيتم أُخُوّةَ العودِ للجز","بنِد فابكوا سُلالةَ العيدان",100,"ن",1,0],["إِنْ رَأَيتَ الْعَيْنَ ناعِسَةً","فَتَرَقَّبْ يَقْظَةَ الْفِتَنِ",101,"ن",1,0],["إن رقّ أبصرت حلم عاشقة","وليلها والحنين يعتصرهْ",102,"ر",2,0],["إن رمَى الشكَ رأيُهُ فَرّ حيْرا","ن يجِرُّ الذيولَ من شُبُهاته",103,"ت",2,0],["أنرتَضِي أنْ نَرى مِيراثَنا بَدَداً","وتكتفي بدموعٍ في مآقِينَا",104,"ن",2,0],["إن رُمْتَ للشعب الحياة فَغَذِّه","بالفنِّ، قبل طعامه، وشرابه",105,"ب",2,0],["إن رأوني أبدو رصينا أشاروا","علّمته تلك البتول ! .. الرصانه",106,"ن",2,0],["إن رأيتِ الحديثَ يمتازُ بالرقةِ","والُلطف فيكِ عمَّن عَداك",107,"ك",1,0],["أنِر العُقول من الجهالة يستبنْ","وضحَ السبيلِ ويهتدي الحيران",108,"ن",1,0],["إن ردَّ الكريم عارٌ على النَفس","وحاشاي انني صُنتُ نَفسْا",109,"س",2,0],["إنْ رَدّها السّعْيُ وَالدُّؤوبُ، فقَدْ","وَفَيْتُ في السّعيِ أشهُراً عَشَرَهْ",110,"ر",2,0],["إنْ رَقّ لِي قَلْبُكِ مِمّا أُلاقْ","مِنْ فَرْطِ تَعذِيبٍ، وفرْطَِ اشتياقْ",111,"ق",1,1],["إنْ رأيت حَيائي خِلْته خُنثاً","قد غُرَّ من غُرَّ من أفعى بإطراقِ",112,"ق",1,0],["أَنَرْنَ نُهَاها فِي اعْتِكَارِ التَّجَارِبِ","بِنِيرَانِهِنَّ المُحْرِقَاتِ الثَّوَاقِبِ",113,"ب",1,0],["إن رمت عزاً على فقر تكابده","فاستغن عن مال اهل البذخ والبظفر",114,"ر",1,0],["إن ركوبَ البحرِ ما لمْ يكنْ","ذا مصدرٍ منْ تهلكاتِ الغريقْ",115,"ق",1,0],["إِن رُحت أَرجوغَيرَهُ","خابَ الرواح مَع المَجي",116,"ج",2,0],["إن رُمت تُبصر فالِحاً مِن فالحِ","يَمم جَناب أَبي المَواهب صالح",117,"ح",1,1],["إِن رُمت أَذكُر شَيئاً مِن مَآثره","فَشَرحُهُ بِلِساني غَير مَشروح",118,"ح",1,0],["إِن رُمت صَيدي في الهَوى","فَاِنصب شِراكاً مِن ذَهَب",119,"ب",1,0],["إن راق عينيك روضةٌ أنف","منه لقد راع قلبك الثكل",120,"ل",1,0],["إن رمت أجحدُ ما ادّعاه مخالفاً","شهدتْ عدولُ الدمع سرك عندنا",121,"ن",2,0],["إن ربي أهلُ عفوٍ واغتفارِ","قادرٌ ينزلني خيرَ قرارِ",122,"ر",1,0],["إن رام يكتم سرَّه عن صحبه","دلَّت على ما كنَّه عَبَراتُه",123,"ت",2,0],["إنَّ رَآءَ صانعَ جفنةٍ حَكَّ أُستَهُ","وأتاه يسأله عن الأخبار",124,"ر",1,0],["إِن رآهُ اللَّبِيبُ نَالَ سُرُوراً","وَهوَ إِن لَم يَظفَر بِهِ مُغَتَمُّ",125,"م",1,0],["إِن رَصَدتُ البَدِيعَ في قَترِ ال","أَرصادِ واصطَدتُ مَعنًى جَسِيمَا",126,"م",2,0],["إن رُمتَ نَهجَ المُصطفي خَالِياً","مِن غَرَضٍ عن نَهجِهِ صَارِفِ",127,"ف",1,1],["إِن رَآءَ خَطًّا بِرَقٍّ","بَادِى البَيَاضِ مَشُوفِ",128,"ف",1,0],["إن رأو قبحاً به هشوا لهُ","أو بهاءً أغمضو عنه الحداقْ",129,"ق",1,0],["إن رامها لمقال مه مرتجلٍ","لبّت وإن تدعُها أقلامهُ تُجب",130,"ب",1,0],["إن رثَّ غِمدى لم ترِثَّ مَضاربي","أو فُلَّ لم تُفَلَّ بصائري",131,"ر",2,0],["إِنَّ روضَ الخدودِ ليس لرعىٍ","وخمورَ الثغور ليست لشُربِ",132,"ب",1,0],["إِنَّ رَيبَ المَنونِ أَلوى بِمَلكٍ","لَو رَماهُ غَيرُ الرَدى ما أَصابا",133,"ب",2,0],["إِن راقَكَ السُكرُ الحَلالُ فَإِنَّني","سَأُديرُ كاساتِ الثَناءِ لِتَسكَرا",134,"ر",2,0],["إِن رامَ نائِلَهُ العُفاةُ أَمَدَّهُ","كَرَماً وَإِن رامَ الخَميسُ مُغارا",135,"ر",2,0],["إِن راعَ إِذ أَلِمَ القُلوبَ جَميعَها","فَهُوَ اِبنُ مَن أَمِنَت بِهِ أَن تَهلَعا",136,"ع",2,0],["إِنَّ رَأيَ الوَزيرِ أَسَّسَ عِزّاً","أَنتَ أَعلَيتَهُ بِذي الأَسيافِ",137,"ف",1,0],["أَنَرتَ لَيالِيَ أَهلِ الشَآمِ","وَكانَ نَهارُهُمُ مُدلَهِمّ",138,"م",1,0],["إن رابكم شيب القذال فان في","صقل الحسام أثارة من حده",139,"د",2,0],["إن ربَّ العرش ألقى حبهم","لك في الماء وفي ما يشربونا",140,"ن",2,0],["إن رب العرض قد بغضهم","نحو عبد الله بغضا لم يهن",141,"ن",1,0],["إنْ رُمتُ سَعدًا لا","يُهْدَى إلى العُنوانْ",142,"ن",1,0],["إنْ رامَني قرْحٌ","أتى بِلا اسْتئذانْ",142,"ن",1,0],["ان رُمتَ تاريخَهُ سَطِّر بِمضجَعِهِ","في دارِ مَولاهُ عَبدِ اللَهِ قَد نَزَلا",143,"ل",2,0],["إنَّ ربّي لما يشاءُ لطيفٌ","وَعلى ما يشاءُ ربّي قديرُ",144,"ر",1,0],["إن رنا يفضحُ النسا وإن قي","ل تأبى تغارُ منه النساءُ",145,"ا",2,0],["إن رضيتم أبت الروح وإن","بقي البعد فشوقي في اشتعال",146,"ل",1,0],["ان رق جسمي عليه من شغف","فادمعي في هواه منسجمه",147,"م",2,0],["إن رآك اشتهى فراقك كرها","واشتهاء الفراق مما تشوق",148,"ق",1,0],["إن رزئي فيك يا حلو المعاني","كان كأس الغدر من خمر زماني",149,"ي",1,0],["إن راقك الشعر تسبيني عرائسُه","كالحور ترقص في أحلام رضوان",150,"ن",1,0],["إنْ رام أمراً فلا تُثْنَى عَزَائِمُهُ","عمّا يَرُوم ولا بالحادثاتِ رُمِي",151,"م",2,0],["إنْ رمتَ منها وِصالاً فهي تَمْطُلُني","وإنْ تَعَتَبْتُ أبْدَتْ بالمَحَاليفِ",152,"ف",1,0],["إن رِيمَ يهتز عند البذل من رَغَبٍ","لأنه لعظيمِ الأجرِ طَلاَّبُ",153,"ب",1,0],["إن رمتَ منه قضاءَ شُغل واجبٍ","أبداكَ بالمعروفِ والسَّراءِ",154,"ا",2,0],["إن رُمتَ شعرا هذه أَفنانُه","يَحمِلن من طيب الكلامِ زُهورا",155,"ر",2,0],["إِن رابَهُ رَيبُ المَنونِ فَقَبلَهُ","هَجَمَ الحِمامُ عَلى الكِرامِ وَغالا",156,"ل",2,0],["إِنَّ رَوْضَ الْكِيتَانِ رَوْضٌ أَرِيضُ","وَمَدَى اللَّهْوِ فِي ذُرَاهُ عَرِيضُ",157,"ض",1,1],["إِنَّ رِجَالاً زَيَّنُوا الْحِلْيَهْ","حَلاَّهُمُ الزَّمَانُ بِالْحِلْيَهْ",158,"ي",2,1],["إن رمت في السلوك للمزيد","فانحُ إذاً لبلغة المريد",159,"د",1,0],["إِن رَمى بي الأَميرُ أَصلَحَهُ اللَهُ","رِماحاً صَدَمتُ حَدَّ الرِماحِ",160,"ح",1,0],["ان راحى وَروحي","حيث يحمى حماها",161,"ا",3,0],["إنْ رُمْتُ سُلْواناً لَهُ عَجِب الهَوى","مِنِّي وَقَالَ سَلاهُ ما سَلاهُ",162,"ا",2,0],["إِنَّ رُزءَ الإِسلامِ بِالحافِظِ العا","لِمِ أَمسى مِن أَعظَم الأَرزاءِ",163,"ا",2,0],["إِنَّ رِياحَ اللُؤمِ مِن شَحمِهِ","لا يَطمَحُ الخِنزير في سَلحِه",164,"ه",1,1],["إن رمتَ أَن تُحدِّثا","بِما مَضى أَو حَدَثا",165,"ث",2,0],["إِن رامَ منه قَرضا","رأَى البِعاد فَرضا",165,"ض",2,0],["إِن رمتَ تكتمُ ما تكابدُه","بعدَ النَوى فلرأيكَ الغَبَنُ",166,"ن",1,0],["إِن رمت فخراً فَقُل ما شئتَ من هِمَمٍ","أَو رمتَ مشياً فطأ ما شئت من قمَمِ",167,"م",1,0],["إِن رامَ نالَ وإن يقُل","فالقَولُ يتبعُه فِعالُه",168,"ل",2,0],["إِن رمت نولاً لمن أَمَّلت زَورتَه","وَهوَ الإمامُ الرِضا والسيِّدُ القمرُ",169,"ر",1,0],["إِن راحَ يَرتاحُ من ماءِ الشَباب فَلي","قَلبٌ عليه بنارِ الوَجدِ يَلتاحُ",170,"ح",1,0],["إنَّ رعدَها كشكا","لى تصيحُ تنتحب",171,"ب",1,0],["إِنّ ريبَ المنونِ ليس بريبٍ","لا على سوقةٍ ولا سلطانِ",172,"ن",1,0],["إنّ رزء المشير أحمد قد كش","شَف منك عن ضيغم ليث غابِ",173,"ب",1,0],["إن رنم الحادي بذكرك رددوا","أنفاس مشتاق إليك طروب",174,"ب",1,0],["إِن رامَها لَم تَقِرَّ وَاِمتَنَعَت","مِنهُ عَلى كُلِّ فائِلٍ جُرُحُ",175,"ح",1,0],["إن رأيت السهوم في نظراتي","والبكاء الحزين في كلماتي",176,"ي",1,0],["إن رأيت المجنون يعبث بالنا","ر فلا تقرعى بنان الندامه",176,"ه",1,0],["ان رقصن فرقصهن وثوب","او تغنين فالغناء نباح",177,"ح",1,0],["إنْ رُحِّلَتْ عن أَثافيها فَقَد رَجعَتْ","تلكَ الأَماني سُروجاً تحتَ فُرسانِ",178,"ن",1,0],["إِن رُمت يا ريم الصَريم تصارما","فاِذكر عُهوداً بَينَنا لَن تخلفا",179,"ف",2,0],["اِن رُمتُه أَرخن ند زَكا وَغَلا","أَو جندُه أَرخن كم فاضِل حنفى",180,"ف",2,0],["إن راقَكَ الرَّوضُ مَصقولاً جوانبُه","فلا يَرعْكَ إذا قيلَ النّدىَ سَقَطا",181,"ط",2,0],["إِن رَضوا عَنّي فَأَهونُ ما","كانَ مَن يَلحى إِذا غَضِبا",182,"ب",2,0],["إِن راعَنا المَرَضُ الخَفيفُ فَبَعدَهُ","قَد راقَنا هَذا الشِفاءُ الراجِحُ",183,"ح",1,1],["إن رمتَ تشبيهاً بربك بعدما","ناداك طع واخضع وضع بُعدَ الأمل",184,"ل",1,0],["إن رقى سُلَّمَ الفضائلِ راقٍ","فيه عُجبٌ به تمامُ شروطِهْ",185,"ط",2,1],["إن رُمتَ مركزَه فدونَك درةً","من بحر مأنوسٍ تراه أنيسا",186,"س",2,0],["إن رمت فوزاً فاستعن","بملاذِ مريم فهي حارس",187,"س",1,0],["إن رمت شرح مصابه","مضمومنه لا ينشرح",188,"ح",1,0],["إن رفضت غدا المَلا","فأنت في البئر المِلا",189,"ل",2,0],["إِن رَنى تَيّم بِالأَل","حاظَ غُزلان الصَريم",190,"م",1,0],["أن رأَيتَ الدارَ موحِشَةً","بِلغاطٍ كَم لَها رَجَبا",191,"ب",2,0],["إِن رَأى ظُعناً لِلَيلى غُدوَةً","قَد عَلا الحَزماءَ مِنهُنَّ أُسَر",192,"ر",1,0],["إن رؤا يذكر المولى بهم حين يراؤن","ذكرهم تنزل الرحمه به حين يحكون",193,"ن",1,0],["إن رقى المنبر يوماً خاطباً","عاد سحبان لديه بَاقِليَّا",194,"ي",2,0],["إن رمت تفصيلاً لأوصافه","رمت محالاً فلذا أجمل",195,"ل",1,0],["إن ربي لكريم يستحي","أن يرد العبد من غير ظفر",196,"ر",1,0],["إن رُمْتُ عنكَ تَصبُّراً فالصبَّرُ أوّ","لُ خاذِلٍ والعَدْلُ أولُ عادلِ",197,"ل",1,0],["إن رده الله بعد غيبته","فكل مالي لوجهه صدقه",198,"ه",1,0],["إن رابهُ منكُمُ أمرٌ فلا وَزَرٌ","لكُم ولا عاصِمٌ من سيلِهِ العَرِمِ",199,"م",1,0],["إن راعَ قلبَكَ هَجرُهُ","فغداً يَلينُ لهُ أَشَدُّهْ",200,"د",2,0],["إن رُمْتُ منك مراماً نلت غايته","وإن طلبتُ منىً أدرَكْتُها طلبا",201,"ب",2,0],["أنرت أنرت الشرق يا خير ماجد","ولا غرو اذ يبدو الهلال من الغرب",202,"ب",1,1],["ان رآه الغصن يصبو مائلا","أو رآه البدر يوما لاحتجب",203,"ب",1,0],["إن رأى المكروهَ يقصدُني","هزّ عِطفَيْهِ له فرَحا",204,"ح",2,0],["إن راقَ أو راعَ قلبي صلُّ عارضِه","فقد تحقَقْتُ أنّ الخدّ بُسْتانُ",205,"ن",1,0],["إن رأى شرّاً معلى صاعداً","أو رأى خيرا إلى الأرض تدلى",206,"ل",2,0],["إن رمت مدحكم جاءت فواضله","في هل أتى وتلته آل عمران",207,"ن",1,0],["إن رام أن يمنعني عامدا","طيب وصال حاد عني وصال",208,"ل",1,0],["إن رحت في إثر الخليط فطالما","خلط التفرّقُ صحبتي بسقام",209,"م",1,0],["إن رمت تجديد عهدي يوم كاظمة","فخذ فديتك أيمانا وأيمانا",210,"ن",2,0],["إن رنقت وردى الحوادث لم يزل","وردي لدى جدواه عذب زلالهِ",211,"ل",2,0],["إنَّ رَوْضاً لَمْ تَسْقِهِ مُنْذُ عامِ","لمخوفٌ عليهِ حَرُّ الأوامِ",212,"م",1,1],["إِن راقَ حاجِبُها فَيَحْيى حاجِبٌ","وَرِثَ الحجابَةَ والرِّياسَةَ والِدَهْ",213,"د",2,0],["إِن رنا أثخن القلوبَ بنبلٍ","عوَّذتها أشلاؤها في الشغاف",214,"ف",1,0],["إِنْ رنا أرشق الندامى بلحظٍ","تتداعى قلوبهم لنبالِه",215,"ل",2,0],["إن روحي تبر بالطائش الها","وي كأني مسدد بعض ديني",216,"ن",2,0],["إن رمى شاكلةً فهو مصيبٌ","أو جزَى يومَ عطاءٍ فهو مُسْني",217,"ن",2,0],["إن راعه من يومه رائعٌ","قال عُدُوّاً فَرسُ الذلّ عادْ",218,"د",1,0],["أن رمتم خفض عيشٍ نام عاذله","فرجِّعوا بمطاياكم إلى نَظَرِ",219,"ر",1,0],["أنر صاحبي كوم المطايا إلى السُّرى","فقد كسدت في مصر سوق الفضائل",220,"ل",1,0],["أَنِر بِصُبحِ الوَصلِ عَيشي فَقَد","صَيَّرَهُ لَيلُ القِلى مُظلِما",221,"م",2,1],["إِن رَكِبَت جودَها تَؤُمُّ عُلاً","فَإِنَّما زادُها مَواهِبُها",222,"ب",3,0],["إن رنت وإن خطرت","الغزال والقمر",223,"ر",1,0],["إن رأتني تميل عني كأن لم","تتناول حديثا الأنباء",224,"ا",2,0],["إن رمت إرضاء الخصوم فلا تقل","وطني ولا تنسب إلى الدستور",225,"ر",1,1],["إن رنت وإن خطرت","يمتلي بها النظر",226,"ر",1,0],["إن رمت ناسوتا وجدت مهامه","اللاهوت تنبو عن سنا الإمكان",227,"ن",1,0],["إن روح الأملاك تبلغكم عني","السلام لا في برقاع التواني",228,"ن",2,0],["إنْ راعَكَ الخَصمُ الحَقودُ بصَوْلَةٍ","في مَعْرَكٍ قَطَرَتْ به سُحْبُ الدِّما",229,"م",2,1],["إنْ راحَ منَّا سيِّدٌ جاءَ ابنُهُ","والحالُ مَوْصولٌ به لا يُفْصَلُ",230,"ل",1,0],["إنَّ ربِّي يستَوْدِعُ السِّرَّ من شَا","ءَ برمزِ المجْموعِ والمَفْرُوق",231,"ق",1,0],["إِن راحَ يجهَلُها الحَسودُ لحُمْقِهِ","فاللهُ يشهَدُ والبريَّةُ تَشهَدُ",232,"د",1,0],["ان رمت لي بضرا يشاهد ما يرى","لا تخف عن نظري سواد الخالي",233,"ل",2,0],["إن رشح الليث له شبله","فهو بها من غيره أجدر",234,"ر",1,0],["إن رمت مدحاً على مقدار ما بلغت","بك المعالي فإني لست أقتدر",235,"ر",1,0],["إن راق معناها الشريف ولفظها","فلذلك الصفح الجميل جميل",236,"ل",1,0],["إنَّ رِضَى كُلِّ الوَرَى لا مِرا","فيما أَرَاهُ غايَةٌ لا تُنالْ",237,"ل",1,1],["أنرتَ مَن الإسلامِ سُدفَة لَيلِه","ولولاكَ للإسلام ما أبصَر الفَجرا",238,"ر",2,0],["إِنّ رَوْعاً ألقيتَ في الرُّوعِ مِنِّي","يوم خبّرتَ لم يدعْ لِيَ رُوعا",239,"ع",2,0],["إنْ ركبوا يوماً لداءٍ معدِ","رأيتَ جُرداً فوق خيلٍ جُردِ",240,"د",1,0],["إن رمت أخلاقه الحسنى تعددها","فلتصغ منك لما أبديه آذان",241,"ن",1,0],["إن ربي عند قدرته","تستوي الأنوار والظلم",242,"م",1,0],["إن روحي بجسمها مصبوغَهْ","وهي في قالب به مفروغَهْ",243,"غ",2,1],["إن رسوم الكائنات دائماً","محوٌ وإثباتٌ هي التخطيط",244,"ط",1,0],["إن رمت أوصافهم تدري بهم يا عمرو","لا يشربون التُتُنْ بل يشربون الخمرْ",245,"ر",1,0],["إن رمت بالمثل التقريب مقتصدا","فخذ مقالة من للحق قد وجدا",246,"د",2,1],["إن ربي حسبي عليهم جميعاً","وهو نعم الوكيل وهو اعتمادي",247,"د",2,0],["إن رام ينظر ثانياً جرحته في","أحشائه النجل العيون جراحا",248,"ح",2,0],["إن رمت إصلاحي فإني لم أرد","ما رمته لي بالملام كفاحا",248,"ح",2,0],["إن رحماننا له","نفس قد تأرجا",249,"ج",2,0],["إِن راجَعَ المُفتي الصَوابَ تَراجَعَت","فيهِ اِعتِقاداتي وَكُنتُ كَخادِمِ",250,"م",1,0],["أن رسول الله كان يبتعث","بعض السرايا للعدو إن لبث",251,"ث",1,0],["إِنْ رُمْتُ صبراُ فَنفْسِي لا تطاوِعُني","أَو رمت هجراً فَقلْبي لا يخلِّيني",252,"ن",2,0],["إِنْ رَنَا فالْغَزالُ أَحولُ إِن قي","سَ إِلَيْه والنَّرجِسُ الغَضُّ أَعْورْ",253,"ر",1,0],["إِنْ رَامَ أَمْراً عظِيماً سَاقَه قدرٌ","إِلَيْه أَو جَاءَهُ يَسْعى عَلى قَدَرِ",254,"ر",1,0],["إِنَّ رُكْبِي بِنَابِ دَهْرِيَ مَهْدُو","دٌ وشِلوي بِظُفْره مَقْدُودُ",255,"د",1,0],["إِنْ رُمْتَ مَجْداً فاسْتَدِلّ بِفعلِهِ","أَوْ رُمْتَ رُشْداً فاسْتَفِدْ بِمَقالِهِ",256,"ل",2,0],["إنْ رُمتْمُوني نَدِيما فَارْفَعُوا كَمَدِي","واسْتَنْجِدوا جَلدي واسْتَوْقِفُوا سَهَري",257,"ر",2,0],["إنْ رَنَا مِنْهُ طَرْفُه فَغزالٌ","أَوْ بَدا مِنْهُ وَجْهُهُ فَغَزالَهْ",258,"ل",2,0]]}