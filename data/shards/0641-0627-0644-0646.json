],[512,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[513,"جاوز بمجدك أنجم الجوزاء","https://www.aldiwan.net/poem11996.html","الكامل"],[527,"لا تغضبن لذم من أخي حسد","https://www.aldiwan.net/poem37156.html","البسيط"],[549,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[549,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[549,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[551,"إن يقعدوا فوقي بغير نزاهة","https://www.aldiwan.net/poem68245.html","الكامل"],[556,"إن غبت عن عياني","https://www.aldiwan.net/poem33831.html","المجتث"],[556,"كلامنا نعرفه","https://www.aldiwan.net/poem33845.html","مجزوء الرجز"],[556,"إنما وحدة الوجود لدينا","https://www.aldiwan.net/poem34218.html","الخفيف"],[556,"يا مدعي العرفان فجرك كاذب","https://www.aldiwan.net/poem34926.html","الكامل"],[565,"داو خماري بكأس خمر","https://www.aldiwan.net/poem69458.html","مخلع البسيط"]],"verses":[["فَالناسُ فيهِ مُعَلَّلٌ طَرِبٌ","يَرجو الأُوارَ وَشارِبٌ ثَمِلُ",0,"ل",1,0],["فالنَّثْرَةُ الحَصْداءُ لمْ تَسُنَّها","إلا على عَبْلِ الذِّراعِ باسِلِ",1,"ل",1,0],["فالنّاسُ منْ غادٍ علَيهِ ورائِحٍ","ولِمَنْ تأخَّرَ عنهُما الإسْراءُ",2,"ا",2,0],["فالنوكُ خَيرٌ في ظِلا","لِ العَيشِ مِمَّن عاشَ كَدّا",3,"د",2,0],["فالنّجْمُ في كَبِدِ السّماءِ مُسامِري","والسُّقْمُ في قلَقِ الفِراشِ ضَجيعي",4,"ي",1,0],["فَالنَّارُ أَوَّلُ مَا تَكُونُ شَرَارَةً","وَالْغَيْثُ بَعْدَ رَذَاذِهِ يَسْتَرْسِل",5,"ل",1,0],["فَالناسُ قَد صاروا بَهائِمَ كُلُّهُم","وَمِنَ البَهائِمَ قائِدٌ وَزَعيمُ",6,"م",1,0],["فَالناسُ في شِدَّةٍ وَالدَهرُ في كَلَبٍ","وَالعَيشُ قَد حارَ فيهِ الحاذِقُ الفَهِمُ",7,"م",1,0],["فَالناسُ هَذا حَظُّهُ مالٌ وَذا","عِلمٌ وَذاكَ مَكارِمُ الأَخلاقِ",8,"ق",1,0],["فَالناسُ مِن بغضٍ لَهُ كُلَّما","مَرَّ عَلَيهِم لَعَنوا شاوَرا",9,"ر",2,0],["فَالنَّقْصُ في المُتَجَنِّي أَنْ تُنَقِّصُهَا","وَالْعَيْبُ في رَأْيهِ الْمَأْفُونَ أَنْ يَعِبِ",10,"ب",1,0],["فالنار ما برحت تفوه بألسن","ذرب وأن كلامها لفصيح",11,"ح",1,0],["فالنار تَلهَب من سقوط شرارة","والماء تَجمع سَيْله القَطَرات",12,"ت",1,0],["فَالنَفسُ جاهِدَةٌ وَالعَينُ ساهِدَةٌ","وَالجَيشُ مُنهَمِكٌ وَالمالُ مُبتَذَلُ",13,"ل",1,0],["فالناس تعلم أنني","في النَّظمِ أو في الفضلِ أنّكْ",14,"ك",1,0],["فَالنارُ ما اِشتَمَلَت عَلَيهِ ضُلوعُهُ","وَالماءُ ما سَحَّت بِهِ أَجفانُهُ",15,"ن",2,0],["فالنفس تسمو نحو علو مليكها","والجسم نحو السفلِ هاوٍ هاري",16,"ر",2,0],["فالناس تحت سماءٍ منك مشمِسةٍ","والناس تحت سماءٍ منك مِدْرار",17,"ر",1,0],["فالناس من تكرارِ وصفك بالحجا","ومن الثناء عليك في مدراس",18,"س",1,0],["فالناس والأنعام طراً قد غدوا","في المرتعين الممرعَين رتوعا",19,"ع",2,0],["فالناس طراً بين مرتقب","سطواته ومؤمل نفعه",20,"ع",2,0],["فالنُجح ما ينجح إمضاؤه","والحزم ما ينتج إطراقه",21,"ق",2,0],["فالنظامُ المَضْحكُ الوا","ضحُ والنثرُ الكلامُ",22,"م",1,0],["فالنفس في عيشةٍ مُغفَّلةٍ","تَمُرُّ لي كالشهورِ أعوامي",23,"م",2,0],["فَالنورُ سِحرٌ دافِق وَالماءُ شِعرٌ","رائِق وَالعِطرُ أَنفاسُ الثَرى",24,"ر",2,0],["فَالناسُ إِخوانٌ وَلَيسَ مِنَ النُهى","أَن يَفتِكَ الإِخوانُ بِالإِخوانِ",25,"ن",1,0],["فَالنِدُّ لا يَعدَمُ مَع نِدِّهِ","ذَريعَةً لِلسِلمِ أَو لِلجِهاد",26,"د",1,0],["فَالناسُ بِالناسِ وَالدُنيا مُكافَأَةٌ","وَالخَيرُ يُذكَرُ وَالأَخبارُ تَنتَقِلُ",27,"ل",1,0],["فالنَفسُ جازِعَةٌ وَالعَينُ دامِعَةٌ","وَالصَوتُ مُرتَفِعٌ وَالسِرُّ منتشِرُ",28,"ر",1,0],["فَالنِصفُ لِلجِرمانِ في زَعمِهِ","وَالنِصفُ لِلرومانِ فيما يَقول",29,"ل",1,0],["فَالنَدا بِالرَحيلِ حينَ يُنادى","بِحُلولٍ عَلى الشَبابِ مُشيبُ",30,"ب",1,0],["فَالنَيلُ لِلمُعتَفي يَلقَونَهُ أَبَداً","لَدَيكَ مُقتَبَلاً وَالفَكُّ لِلعاني",31,"ي",1,0],["فَالنَقعُ لَيلٌ وَالسُيوفُ كَواكِبٌ","تَنقَضُّ فَوقَ جَماجِمِ الأَقرانِ",32,"ن",1,0],["فَالناسُ بَعدَكَ يا اِبنَ موسى أَصبَحوا","كَقَناةِ حَربٍ غَيرِ ذاتِ سِنانِ",33,"ن",1,0],["فالناسُ مِنْكَ مُحَيَّرونَ تَخوُّفاً","أن تَمْتَحِي سُنَنَ النَّبيِّ المُرسَلِ",34,"ل",1,0],["فالنخلُ من باسقٍ فيه وباسِقَةٍ","يُضاحِكُ الطَّلْعَ في قُنْوانِهِ الرُّطَبا",35,"ب",2,0],["فَالناسُ فَوجانِ في مَعروفِهِ شَرَعٌ","فَمِنهُمُ صادِرٌ أَو قارِبٌ يَرِدُ",36,"د",1,0],["فَالناسُ وَالمَلكُ المُتَوَّجُ واحِدٌ","لا آمِرٌ يَبقى وَلا مَأمورُ",37,"ر",1,0],["فَالناسُ تَعجَبُ إِذ نَظَّمتُ مَرثِيَةً","وَهَل سَمِعتَ بِمَيّتٍ نَظَّمَ الكَلِما",38,"م",2,0],["فَالناسُ تَحسُدُكُم فيهِ وَتَحسُدهُ","فيكُم وَلَيسَ لَهُ في غَيرِكُم طَلَبُ",39,"ب",1,0],["فَالناسُ تَدعوها مَفاتِحَ رِزقِها","وَتَعُدُّها الأَموالُ مِن آفاتِها",40,"ت",3,0],["فَالناسُ تَستَسقي الغَمامَ وَمَن بِها","يَدعو الإِلَهَ بِأَنَّهُ لا يَغرَقُ",41,"ق",1,0],["فالنّفسُ تهزل بالمَآ","كلِ كلّما سَمِنَ الجَسَدْ",42,"د",1,0],["فَالنُّورُ مُنْقَبِضٌ وَالظِّلُّ مُنْبَسِطٌ","وَالطَّيْرُ مُنْشَرِحٌ وَالْجَوُّ مُدَّلِهُ",43,"ه",1,0],["فَالنُّورُ لَوْ بَيَّنْتَ أَمْرَكَ ظُلْمَةٌ","وَالْبَدْءُ لَوْ فَكَّرْتَ فِيهِ خِتَامُ",44,"م",1,0],["فالنقشُ نقصٌ ومن الرأيِ أن","ترتشفَ الصافي منَ الصافي",45,"ي",1,0],["فَالناسُ نَهبٌ وَالعَوالِمُ ساحَةٌ","عِزريلُ فيها دائِمُ الجَوَلانِ",46,"ن",1,0],["فالنفَّسُ بين تهيبُّبٍ ممَّا ترى","وتلهّبٍ فاْحترتُ في أمريْها",47,"ي",3,0],["فَالنارُ تَأكُلُ بَعضَها","إِن لَم تَجِد ما تَأكُلُه",48,"ه",1,0],["فالنَّظْمُ مِثلَ جَوَاهِرٍ بِقَلائِدٍ","والنُّثْرُ مِثْلَ أَزاهِرٍ بِكِمامِ",49,"م",1,0],["فالنَّجْدُ في لَهَواتِها والغورُ وال","فلَقُ المُلَّمعُ والظّلامُ الحائل",50,"ل",1,0],["فالنّاسُ غيرَك أتباعٌ له خَوَلٌ","وأنت ثانيه في العَليا من الرّتب",51,"ب",1,0],["فالنّظرَةِ الخزْراءِ تحتَ اللامةِ ال","بَيْضاء تحتَ الرّايةِ الحمراء",52,"ا",2,0],["فَالناسُ أَبناءُ الحَذَر","فَرَّجتَ هاتيكَ الغُمَر",53,"ر",1,0],["فَالنَعتُ ذا لا نَعتُ دارٍ خَلَت","يَهيمُ في أَطلالِها أَحمَقُ",54,"ق",1,0],["فَالناسُ يَسعَونَ لِلعُلى قُدُماً","وَهُم وَراءَ مُكَسَّرو السوقِ",55,"ق",1,0],["فالناس من كوَيتهِ في تعبٍ","فمٌ بذيءٌ وفقحةٌ غلمَه",56,"م",2,0],["فَالنَفسُ إِن هِيَ أُطلِقَت مِن سِجنِها","فَكَأَنَّها في شَخصِها لَم تُحصَرِ",57,"ر",1,0],["فالنَّاسُ إِثنانِ وَاحِدٌ أعشَقُهُ","وَالآخَرُ لَم أَحسَبهُ في الأَحياءِ",58,"ا",2,0],["فالنّفْسُ تَبْغي الحياةَ جاهِدةً","وفي يَمِين المَليكِ مِقْوَدها",59,"د",3,0],["فَالنَّاسُ مِنْ طَرَبٍ فِي نَشْوَةٍ أَخَذَتْ","بِهِمْ فَمَالُوا ك