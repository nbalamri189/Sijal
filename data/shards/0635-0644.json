],[106,"قطان","https://www.poetsgate.com/ViewPoem.aspx?id=179571",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[77,"هل كنت تعلم في هبوب الريح","https://www.poetsgate.com/ViewPoem.aspx?id=33811",""],[77,"ما على القلب بعدكم من جناح","https://www.poetsgate.com/ViewPoem.aspx?id=33823",""],[50,"أمن وقوف على شام بأحماد","https://www.poetsgate.com/ViewPoem.aspx?id=21772",""],[90,"ذكرى الهاشمي","https://www.poetsgate.com/ViewPoem.aspx?id=179163",""],[90,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[45,"أمَوَاهِبٌ هَاتِيكَ أمْ أنْوَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=32874",""],[46,"أستقبحُ الظاهرَ من صاحبيº","https://www.poetsgate.com/ViewPoem.aspx?id=18276",""],[28,"صُلْ يا جُنَيْدَ الخَيرِ لله صَوْلَةً","https://www.poetsgate.com/ViewPoem.aspx?id=17954",""],[38,"يا أهلِ ما بالُ هذا اللّيلِ في صفرِ","https://www.poetsgate.com/ViewPoem.aspx?id=21195",""],[99,"الى ضفيرتي ماس","https://www.poetsgate.com/ViewPoem.aspx?id=36371",""],[51,"أصلعٌ يُكنى بأبي الجَلَّحْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=27195",""]],"verses":[["صِلِ اليَأسَ وَاِنهَض بِعِبءِ الخُطوبِ","فَما يُثقِلُ الظَهرَ إِلّا الهَرَم",0,"م",1,0],["صَلينا بِحَمرَةِ ذاكَ الهَجيرِ","وَعُدنا بِفَحمَةِ هَذي العُتُم",0,"م",1,0],["صَلعاءُ لا يُعطى الهُدى","دَليلُها فَلا جَرَم",1,"م",1,0],["صَلّى الإِلَهُ عَلَيكَ مِن مُتَوَسِّدٍ","بَعدَ المِهادِ جَنادِلاً وَرِمالا",2,"ل",2,0],["صَلّى الرَدى لَو يَستَطيعُ إِلى","نَصلٍ بِراحَتِهِ مُخَلَّقُهُ",3,"ق",2,0],["صِل بِفَخرِ المُلكِ الأَغَرِّ حُساماً","تَجمَعِ الماضِيَينِ عَضباً وَكَفّا",4,"ف",2,0],["صَليبٌ عَلى قَرعِ الخُطوبِ كَأَنَّما","يُرادينِ طوداً مِن عَمايَةَ أَفرَعا",5,"ع",2,0],["صَلاةُ اللَهِ تَخفُقُ كُلَّ يَومٍ","عَلى تِلكَ المَعالِمِ وَالقِبابِ",6,"ب",1,0],["صَلّى عَلَيكِ وَما فَقَدتِ صَلاتَهُ","قَبلَ الرَدى وَجَزاكِ أَيُّ جَزاءِ",7,"ا",2,0],["صِلي يا بنَةَ الأَشرافِ أَروَعَ ماجِداً","بَعيدَ مَناطِ الهَمِّ جَمَّ المَسالِكِ",8,"ك",1,0],["صِل إِذا ما وَصَلتَ حُرَّةَ قَومٍ","شَرَّفَتها آباؤُها وَالجُدودُ",9,"د",1,0],["صَلَّى عَلَيْكَ إِلاَهُ الْعَرْشِ مَا صَدَحَتْ","قُمْرِيَّةٌ فَوْقَ أَفْنَانِ الرَّيَاحِينِ",10,"ن",1,0],["صَلَّى عَلَيْكَ إِلاَهُ الْعَرْشِ مَا غَرَّدَت","حَمَائِمُ فَوْقَ أَغْصَانِ الْبَسَاتِينِ",10,"ن",1,0],["صَلَّى عَلَيْكَ إِلاَهُ الْعَرْشِ مَا وَفَدَتْ","نُوَيْقَةٌ لِحِمَى الأَطْلاَلِ تَبْرِينِي",10,"ي",1,0],["صَلَّى عَلَيْكَ إِلاَهُ الْعَرْشِ مَا هَطَلَتْ","مَدَامِعُ السُّحْبِ أَوْ عَيْنُ المُحِبِّينِ",10,"ن",1,0],["صَلَّى عَلَيْكَ إِلاَهُ الْعَرْشِ مَا ضَحِكَتْ","مَبَاسِمُ الزَّهْرِ فِي ثَغْرِ الأَفَانِينِ",10,"ن",1,0],["صلّى عليْكَ اللهُ ما هفتِ الصَّبا","وَهْناً فهزّتْ مائِساً أمْلودا",11,"د",2,0],["صَلَواتُ الإلاهِ يا نُكْتَةَ الكَوْ","نِ على مجْدِكَ اللُّبابِ الصُّراحِ",12,"ح",1,0],["صَلّى عليْكَ الله ما هَبّتْ صَبا","فهَفَتْ بغُصْنٍ للرّياضِ مَروحِ",13,"ح",1,0],["صَلَّى عَلَيْهِ الَّذي أَهْدَاهُ نُورَ هُدَىً","مَا هَبَّتِ الِّريحُ مِنْ بَعْدِ الْجَنُوبِ صَباً",14,"ب",2,0],["صَليفِيَّةً طَيِّباً طَعمُها","لَها زَبَدٌ بَينَ كوبٍ وَدَن",15,"ن",1,0],["صَلّى الطَهورُ مَعَ الأُمِيِّ أَوَّلَهُم","قَبلَ المَعادَ وَرَبُّ الناسِ مَكفورُ",16,"ر",1,0],["صَلاحَ الدينِ يا خَيرَ البَرايا","وَمَن قَد عَمَّ بِالفَضلِ الرَعايا",17,"ا",3,1],["صَليلُ المَواضي وَاِهتِزازُ القَنا السُمرِ","بِغَيرِهِما لا يُجتَنى ثَمرُ النَصرِ",18,"ر",1,1],["صِلينِيَ بَعضَ الوَصلِ حَتّى تَبَيَّني","حَقيقَةَ حالي ثُمَّ ماشِئتِ فَاصنَعي",19,"ع",2,0],["صَلتٌ تَوَدُّ الشَمسُ لَو صيغَت لَهُ","تاجاً تُرَصِّعُ جانِبَيهِ الأَنجُمُ",20,"م",1,0],["صَليتُ غَمامَةٍ بِجَناةِ نَحلٍ","صَفاةِ اللَونِ طَيِّبَةَ المَذاقِ",21,"ق",1,0],["صُلبُ النَحيزَةِ وَهّابٌ إِذا مَنَعوا","وَفي الحُروبِ جَريءُ الصَدرِ مِهصارُ",22,"ر",1,0],["صَلّى الاِلَهُ عَلَيكُمُ يا مَن","ما دامَ طَيرٌ في السَماءِ يُغَرِّدُ",23,"د",1,0],["صَلِّ لِذِي العَرشِ وَاتَّخِذ قَدَمَاً","تُنجيكَ يَومَ العِثَارِ والزَّلَلِ",24,"ل",1,0],["صلّى عليك إلهٌ أنت صفوته","ما طُيِّبتْ بلذيذ الذكر أفواهُ",25,"ا",2,0],["صلّى عليك الله ما ركبٌ سرى","فأجدَّ وخْداً في المفازة ميلا",26,"ل",2,0],["صَلّى الإلهُ على المختار صفوته","ما العارض انهلَّ أو ما البارقُ التَمَحَا",27,"ح",2,0],["صَلّى المَلائِكَةُ الَّذينَ تُخُيُّروا","وَالصالِحونَ عَلَيكِ وَالأَبرارُ",28,"ر",1,0],["صَلّى الإِلَهُ عَلَيكَ مِن ذي حُفرَةٍ","خَلَتِ الدِيارُ لَهُ فَهُنَّ قِفارُ",29,"ر",1,0],["صَلّى القَبائِلُ مِن قُرَيشٍ كُلُّهُم","بِالمَوسِمَينِ عَلَيكَ وَالأَنصارُ",30,"ر",1,0],["صِلوا كَنَفي الغَداةَ وَشَيِّعوني","فَإِنَّ عَلَيكُمُ مِنّي زِماما",31,"م",2,0],["صَلّى الإِلَهُ عَلَيهِم أَينَما ذُكِروا","لِأَنَّهُم لِلوَرى كَهفٌ وَمُعتَصَمُ",32,"م",1,0],["صَلّى الإِلَهُ عَلى الَّذينَ تَتابَعوا","يَومَ الرَجيعِ فَأُكرِموا وَأُثيبوا",33,"ب",3,1],["صَلّى الإِلَهُ وَمَن يَحُفُّ بِعَرشِهِ","وَالطَيِّبونَ عَلى المُبارَكِ أَحمَدِ",34,"د",1,0],["صَلى عَلَيكَ اللَهُ في جَنَّةٍ","عالِيَةٍ مُكرَمَةِ الداخِلِ",35,"ل",1,0],["صَلّى الإِلَهُ عَلى اِبنِ عَمرٍ إِنَّهُ","صَدَق الِقاءَ وَصِدقُ ذَلِكَ أَوفَقُ",36,"ق",1,1],["صَلَواتُ المَسيحِ في ذَلِكَ الدَي","رِ دُعاءُ القِسّيسِ وَالرُهبانِ",37,"ن",1,0],["صلَّى وراءَ أياديهِ الحياء فعلى","تلك الأيادِي من السحبِ التحيات",38,"ت",1,0],["صلَّى عليك الذي أعطاك منزلةً","شفيعها في مقامِ الحشر مقبول",39,"ل",1,0],["صِلنا بأن تُكمل الرضا لأبي","إسحاق تَسعد بالحمد والأجرِ",40,"ر",1,0],["صُلْ على الناس جميعاً","وتَخَمَّطْهُمْ بسيْرِكْ",41,"ك",1,1],["صلّى الغُدوُّ عليك والآصالُ","وتغمدتكَ بظلّها الأظلالُ",42,"ل",1,0],["صِلني برزقي وفائتي صِلةً","ألذَّ من نَشْطةِ السراويلِ",43,"ل",1,0],["صِلوني بأعراضٍ لكم قد تمزقتْ","تمزُّقَ أطمارٍ على ابن سبيلِ",44,"ل",1,0],["صِلُوا نِصْفَ كنيته باسمه","إذا اجتمعا وانظروا ما هما",45,"م",2,1],["صَلتُ الجَبينِ رَشيدُ الأَمرِ تَعرِفُهُ","إِذا تَكَشَّفَ عَن عِرنينِهِ القَتَرُ",46,"ر",1,0],["صُلبِ الحَيازيمِ لا هَذرِ الكَلامِ إِذا","هَزَّ القَناةَ وَلا مُستَعجِلٌ رَهِقُ",47,"ق",1,0],["صُلبُ النُسورِ فَلَيسَ المَروُ يَرهَصُهُ","وَلا المَضائِغُ مِن رُصغَيهِ تَنتَشِرُ",48,"ر",1,0],["صَلَّ الحَديدُ وَشَمَّرَت عَن ساقِها","وَتَنَكَّرَ الإِخوانُ لِلإِخوانِ",49,"ن",1,0],["صِلاتُهُمُ في الجودِ أَضحَت 