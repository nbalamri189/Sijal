124","الطويل"],[4526,"","https://poetry.dctabudhabi.ae/diwan/poem/75839","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141678","الطويل"],[4815,"صُراخ","https://www.poetsgate.com/ViewPoem.aspx?id=210474",""],[4984,"صلابة الرأي","https://www.poetsgate.com/ViewPoem.aspx?id=191136",""],[5064,"قوافل الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=199088",""],[5135,"تتابعت الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=206411",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5376,"قصيدة من ملحمة سقوط بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5431,"بصبر الصالحين شفاء جرحي","https://www.poetsgate.com/ViewPoem.aspx?id=187206",""],[5442,"تذكر بالحمي عهداً برامه","https://www.poetsgate.com/ViewPoem.aspx?id=114756",""],[5582,"أَرَى ماءَ الجُفُونِ جَرَى وَفاضَا","https://www.poetsgate.com/ViewPoem.aspx?id=187175",""],[4623,"كتمت الهوى لكن نحولي به باحا ومن (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146769",""],[5845,"أنسمة ُ طيبٍ أمْ صبا طيبة ً هبا","https://www.poetsgate.com/ViewPoem.aspx?id=198483",""],[5953,"ولي صاحب إذا كان تقديره الغنى","https://www.poetsgate.com/ViewPoem.aspx?id=93864",""],[5956,"تعالوا","https://www.poetsgate.com/ViewPoem.aspx?id=195019",""],[6225,"حسد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80895&r=&rc=164",""],[6259,"يهن علاك مداها القصي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59408&r=&rc=56",""]],"verses":[["وَلَم يَنجُ إِلّا مَن تَخاطَت سُيوفُنا","وَذاقَ الرَدى مَن عَمَّمَت شَفَراتُها",0,"ت",3,0],["ولمْ يَنْتَجِعْ عَذَباتِ اللِّوى","إذا لاحَ بارِقُها الخُلَّبُ",1,"ب",1,0],["وَلَم يَنتَكِس يَوماً فَيُظلِمَ وَجهُهُ","لِيَركَبَ عَجزاً أَو يُضارِعَ مَأثَما",2,"م",2,0],["وَلَم يَنتَجِعهُ المُعتَفونَ فَأَقبَلَت","عَطايا كَما والى شَآبيبَهُ القَطرُ",3,"ر",1,0],["وَلَم يُنسِني ما قَد لَقيتُ ظَعائِن","وَخَملاً لَها كَالقَرِّ يَوماً مُخَدَّرا",4,"ر",2,0],["وَلَم يُنسِني مَيّاً تَراخي مَزارِها","وَصَرفُ اللَيالي مَرُّها وَاِنفِتالُها",5,"ل",3,0],["وَلَم يَنقُضوا التَوريكَ عَن كُلِّ ناعِج","وَرَوعاءَ تَعمي بِالُلغام سِنادِ",6,"د",1,0],["ولم يُنسب إلى الريحان إلاّ","وريحان الرياض له نسيب",7,"ب",1,0],["ولم ينبح الكلب العقور ولم يُخَف","على الحاطبين الأسود المتقوِّبُ",8,"ب",1,1],["ولم ينفكك منهم الفاعلو","ن والقائل المحسن المجملُ",9,"ل",1,0],["ولم ينهَهُ التأنيبُ بل جودُ قادرٍ","رأى أنه منهُ على حدّ مَغضَبِ",10,"ب",1,0],["ولم ينفه إلا النساء إذا امترى","صرَى كلِّ أير والغيارى تُغَيَّر",11,"ر",1,0],["ولم ينكر له الإِخوان","لاظفرا ولا عقلا",12,"ا",1,0],["وَلَم يَنَلهُ فَمُهُ السَقيمُ","فَعاشَ دَهراً في الفَلا يَهيمُ",13,"م",1,0],["وَلَم يَندَمِل مِن طَعنَةِ القَدِّ جُرحُهُ","فَرِفقاً بِهِ مِن طَعنَةِ البَينِ دامِيا",14,"ي",2,0],["وَلَم يَنِكها وَلَكِن","عِجانُها ناكَ زُبَّه",15,"ب",2,0],["وَلَم يُنخَس عَلى الحاجاتِ بَطأً","كَما نُخِسَ الثَفالُ مِنَ الرِكابِ",16,"ب",1,0],["وَلَم يَنتَسِب مِن وائِلٍ في وَشيظَةٍ","وَلا باتَ مِنها ضارِبَ البَيتِ في صِرمِ",17,"م",1,0],["وَلَم يَنجُ اِبنُ جَستانٍ لِشَيءٍ","سِوى الأَقدارِ غالَبَتِ المَنونا",18,"ن",2,0],["وَلَم يَنقَلِب مِن بُستَ إِلّا وَرَأيُهُ","شَعاعٌ وَإِلّا رَوعُهُ شُغلُ روعِهِ",19,"ع",2,0],["ولم يُنذِرهُمُ مِقَةً ولكنْ","ترفَّعَ أن يصيبَهمُ اغِتيَالا",20,"ل",2,0],["وَلَم يُنجِ مَخلوقاً مِنَ المَوتِ حيلَةٌ","وَلو كانَ في حِصنٍ وَثيقٍ وَأَحراسِ",21,"س",1,0],["ولم ينل منه أكول البلى","وإنما غاب إلى موسمِ",22,"م",1,0],["وَلَم يُنسِني لَيلى اِفتِقارٌ وَلا غِنى","وَلا تَوبَةٌ حَتّى اِحتَضَنتُ السَوارِيا",23,"ي",2,0],["ولَمْ يَنْفَعْهُمُ البَرْطِيلُ شَيئاً","وما ازْدَادُوا بهِ إلاَّ دُيُونا",24,"ن",2,0],["وَلَم يُنَط بِحِبالِ الشَمسِ مِن نَظَرٍ","إِلّا لَهُ في حِبالِ الشَرِّ مُجتَذِبُ",25,"ب",1,0],["وَلَم يُنسِني ما قَد لَقيتُ وَشَفَّني","مِنَ الوَجدِ أَنّي غَيرُ ناسٍ لِقاءَكِ",26,"ك",1,0],["وَلَم ينف رشد المرأة الدين نفسه","ولكن غلاة الدين ليس لهم رشد",27,"د",1,0],["وَلَم يُنسِني ما قَد لَقيتُ ظَعائِناً","وَخَملاً لَها كَالقَرِّ يَوماً مُخَدَّرا",28,"ر",2,0],["ولم يُنتجِ السُوَرَ الخالداتِ","من المُلحقاتِ بأمِّ السُّوَر",29,"ر",1,0],["ولم يَنقُص مِنَ الوَاشِينَ وَاشٍ","نَقِيراً مِن هَوَاكِ ولاَ فَتِيلا",30,"ل",2,0],["ولم ينل طالبً مراده","بلا عناء ولا سهادِ",31,"د",1,0],["ولم ينسب إلى أحد","سواه النَّفع والضَّرر",32,"ر",1,0],["وَلَم يَنأَ في حالٍ عَنِ الحَقِّ غَيبَة","كَساهُ إِلَهُ الناسِ في الناسِ هَيبَةً",33,"ه",1,0],["وَلَم يَنشَعِ الأحبوشَ كَأساً مَريرَةً","وَيَجمَع في غُمدانَ شَملاً مُبَدَّدا",34,"د",2,0],["وَلَم يُنجِ مِنهُم لُجُّ بَحرٍ وَلا حَمَت","حُصونٌ أُديرَت حَولَهُنَّ الخَنادِقُ",35,"ق",1,0],["وَلَم يُنَجِّ اِبنَ عَيّاشٍ بِمُهجَتِهِ","يَمٌّ إِذا ما يَراهُ الناظِرُ اِرتَسَما",36,"م",2,0],["وَلَم ينفرِد شذّاذُ مذهبِ أحمدٍ","فَقَد ضَلّ قَومٌ من مذاهِبنا الأخرى",37,"ر",2,0],["وَلَم ينفكَّ يَغزو الناسَ حتّى","تَولّاهم وأمرُ الكفرِ ولّى",38,"ل",2,0],["ولم ينتفع بي غير إبليس وحده","وإن متُّ لم يظهر على غيره فقدي",39,"د",2,0],["ولم ينتقم في الدهر يوما لنفسه","ويعفو عن الجاني المسيء ويحلم",40,"م",1,0],["وَلم يُنَكِّر وَجنَتَيهِ السَقَم","وَتَسلخِ الأَوجاعُ مِنهُ حِطَم",41,"م",1,0],["ولم ينافسك في أصل سما بشرٌ","ولم ينل رتبة نالت يداك يد",42,"د",1,0],["وَلم ينلكَ عِزاءٌ في الوَرى كَرَماً","إِنَّ الوَرى وارِدُ والحَوضَ الَّذي وَرَدا",43,"د",2,0],["وَلَم ينكروا من آل وهب بن زهرة","خؤلتهم اذ كان أَكرَمهم وهبا",44,"ب",2,0],["وَلَم يَنعَق بِفُرقَتِنا غُرابٌ","وَلَونُ الشَّعرِ أَسوَدُ كَالغُرابِ",45,"ب",1,0],["وَلَم يَنهَ رِحلَتَهُم في السَما","ءِ نَحسُ الخَراتَينِ وَالعَقرَبُ",46,"ب",1,0],["وَلَم يُنِل فيكُم الأَرواحَ راحَتَها","إِلّا اِجتِثاثُ دَواعيها مِنَ الجُثَثِ",47,"ث",1,0],["وَلَم يَنَل أَحَدٌ عِلمَ الإِحاطَةِ بِالغَي","بِ المَشاهِدَ في الأَكوانِ إِلّاكِ",48,"ك",1,0],["ولم يَنْجُ مُستَعصِمٌ بالنَّوى","فَينْجَو مُستهدَفٌ مِنْ أَمَم",49,"م",1,0],["وَلَم يَنتَقِصهُ الثَغرُ مِثقالَ ذَرَّةٍ","وَشُهدُ اللَمى جَرَّ الدَبيبَ مِنَ الذَرِّ",50,"ر",1,0],["وَلَم يَنعَطِف يَوماً كعَطفَةِ صُدغِهِ","عَلى خَدِّهِ أَو مِثلِ عَطفَةِ غُصنِهِ",51,"ن",2,0],["ولم ينهش التنينُ جسماً مسمَّماً","بأنيابه حتى رأى الموتَ ناهش",52,"ش",1,0],["ولم ينهه شيب بفوديه قد غدا","ولم ينهه ضعف تضاعف في الأعضا",53,"ا",1,0],["وَلَم يَنُجُ مِنهُنَّ حَدُّ الظُبى","وَلا الزُعف وَالزَرد التُبَعيّ",54,"ي",1,0],["وَلَم يَنَلِ العَلياء بِالجَدِّ وَحدَهُ","وَلَكِن بعالي جِدِّهِ وَاِعتِزامِهِ",55,"م",2,0],["ولم ينأ عن دار القلى باختياره","ولكن جَفَتْهُ أهلها فجفاها",56,"ا",3,0],["ولم ينزل الأرض الَّتي قد تطامنت","ولو أن ذاك الربع مسكاً ترابه",57,"ب",2,0],["ولم ينالوا نِعما","تلَذُّ فيما تصِمُ",58,"م",1,0],["ولم يُنْسَبْ إلى الْمَسْؤولِ شَخْصٌ","ولمْ يَخْطُرْ لَهُمْ هَذَا ببالِ",59,"ل",1,0],["ولم يَنَلْ مِنْهُ ما يَرْجُوهُ مِنْ ظَفَرٍ","بِذلِكَ الحَرْبِ لا بَلْ نالَهُ الحَرَبُ",60,"ب",1,0],["وَلَم يُنسِنيها الدَهرُ إِلّا وَذِكرُها","بِحَيثُ تَحَنَّت دونَ نَفسي ضُلوعُها",61,"ع",3,0],["وَلَم يَنسَ أظعاناً عَرضنَ عَشيَّةً","طَوالِعَ مِن هَرشى قَواصِد عَزورا",62,"ر",2,0],["ولم يُنجهمْ منه عديدٌ مُجمّع","ولم يَثْنِهمْ عنه مَشيدٌ مُرَفَّعُ",63,"ع",1,0],["ولم يَنَلْكَ سوى ما نال كلّ فتىً","عالي المكان ولاقى كلّ جبّارِ",64,"ر",1,0],["ولم ينتقل شيء إلى البدر في السما","من الشمس بل طي الضياء له نشر",65,"ر",1,0],["ولم ينقسم حاشاه بل هو مطلقٌ","أراد بأن يبدو لنا بقيود",66,"د",1,0],["ولم ينقسم بل قام كلٌّ بأمره","على حده إذ لا يقيده الحد",67,"د",1,0],["ولم يَنْشُرِ القومُ غِلِّ الصُّدو","رِ حَتّى طَوَاهُ الرّدى في رِداءِ",68,"ا",2,0],["ولم ينم طَرفي في لَيْلَتي","كأَنَّه يَسْهَرُ بالأُجْره",69,"ر",2,0],["وَلَم يَنهك الشَيب عَن مقعد","بِهِ كُنت في خلوة تقعد",70,"د",1,0],["وَلَم ينظر الفهم يَوماً","إِلى أَدَبي وَمَعرفتي وَفَضلي",71,"ل",2,0],["ولم ينأ عني الركب بالراحل الذي","تقدم حتى كان ركبك تاليا",72,"ي",2,0],["ولم يُنب عن سَلْعٍ ولا رمل عالج","ولم يُنبِ عن ذيالك الرشَأ الأحوى",73,"و",2,0],["ولم يُنْبِ عن أهلِ العقيقِ ولَعْلَع","ولا عن أُهيْل المنْحَنى أظهرَ الفتوى",73,"و",2,0],["وَلَم يَنج مِنهُ طالِبٌ قَبلَ طالِبِ","وَقَد أَوسَعا في الطَعنِ هاكٍ وَهاتِ",74,"ت",1,0],["ولم يُنْفَ عن بابهم طائفٌ","من الشرك طاف ببيت الوثن",75,"ن",1,0],["ولم يُنْجِنا مِمَّا جَنَى غيرَ أَنَّنا","بعَدْلِكَ مِنْ ظُلْمِ الزَّمانِ لنا عُذْنا",76,"ن",2,0],["ولم ينج قلب قط من رشق سهمه","ولا مهجة في الناس من لسع افعاه",77,"ا",2,0],["وَلَم يُنزِلوا لَزَباتِ السِنينِ","بِهِ فَيَكونوا عَلَيهِ عِيالا",78,"ل",2,0],["وَلَم يَنحَر بِمَكَّةَ يَومَ نَحرٍ","وَلَم يَبهَج بِهِ البَلَدُ الحَرامُ",79,"م",1,0],["ولم ينسها التوديع موقف شامت","يقلب في الغادين أجفان محنق",80,"ق",1,0],["ولم ينجهم أن قام بالأمر قيصر","مقام دعيٍّ في القيادة ملصق",80,"ق",1,0],["ولم ينسني حظى من الحلم والنهى","جبينٌ يروع الشمس بالحسن أبلج",81,"ج",1,0],["ولم ينجهم إذا مزق الرعب شملهم","من الخزي وخدفي السرى ونجاء",82,"ا",2,0],["ولم ينسني وجدي به أن لي هوى","يحن إلى طرفٍ بمصر كحيل",83,"ل",1,0],["ولم يُنسني عهدي به منزلُ الغضا","وغرَّ ليال فيه مزدهرات",84,"ت",1,0],["ولم ينو الطلاق فما بهذا","على من زل فيه من طلاق",85,"ق",1,0],["ولم ينسَ حسّانٌ لأَولادِ جَفنةٍ","أَواصِرَ إِحسانٍ على الدَّهرِ تَمتَدُّ",86,"د",1,0],["ولم ينسَهُ ابنُ الأيهم النَّدبُ بالنّدى","وَلِلأَرضِ والإسلامِ بينَهُما بُعدُ",86,"د",1,0],["ولم ينكروا للأنبياء مزية","ولا لرجال الله والله فاعل",87,"ل",1,0],["ولم ينالوا بِدَعْواهم ولا كسبوا","عِلْماً ونِلْتُ المعالي قَبْلَ أَحْتَلِمُ",88,"م",1,0],["ولم ينقلبْ للهمِّ والبؤسِ قلبُهُ","ولمَ يخْشَ دهراً صرفُهُ يتقَلَّبُ",89,"ب",1,0],["ولم ينزل بدارٍ ثمّ يمسي","ولما يستمع لطم الخدود",90,"د",1,0],["ولم يندب الإسلام إلا لأنه","يخاف بأن تمسي فقيداً فيُفقدا",91,"د",2,0],["ولم ينتفع ما لم يسر في شهوده","مراع له من غير مين وعلة",92,"ه",1,0],["وَلَم يُنكر شَذاكُم غَيرُ أَنفٍ","شَكى مِن نتن صاحبه زكاما",93,"م",2,0],["وَلَم ينازعك يا اِبن الطَيبين بِهِ","إِلّا الَّذي نَفسه اِشتاقَت إِلى العطب",94,"ب",1,0],["ولم ينل غير قتل في جمعته","والكل في عدد القتلى قد اختلفا",95,"ف",2,0],["ولم ينالوا حبة من خير","بفقدهم اياك يا ذا الخير",96,"ر",1,0],["ولم ينقلوا ان الخطوب تهوله","ويكفيك هذا في المآثر والفخر",97,"ر",1,0],["ولم ينتقم ممن تفوه بالأسى","ولم يدر عمن مات بالغيظ والقهر",98,"ر",1,0],["ولم ينج من سامهُ خطة","وإن جرّ مجرىً وسوّمُ جردا",99,"د",2,0],["ولَم يَنظُر لعِزِّ المُلكِ مُوسَى","وَلاَ مِن بَعدُ هَارونُ الرَّشيدُ",100,"د",1,0],["ولم ينكفئ حتى أذل عزيزه","وحكم في الهام المهندة 