{"poems":[[53,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[63,"وظلماء من ليل التمام طويتها","https://www.aldiwan.net/poem45727.html","الطويل"],[63,"خليلي مس المطايا لغب","https://www.aldiwan.net/poem46120.html","المتقارب"],[63,"خضاب على فودي للدهر ما نضا","https://www.aldiwan.net/poem46185.html","الطويل"],[35,"عفا ميث كلفى بعدنا فالأجاول","https://www.aldiwan.net/poem39113.html","الطويل"],[93,"وارحمتاه لقوم فارقوا النعما","https://www.aldiwan.net/poem11304.html","البسيط"],[30,"ما هاج عينيك من الأطلال","https://www.aldiwan.net/poem29544.html","الرجز"],[72,"لو كان غيرك مخدوما ألوذ به","https://www.aldiwan.net/poem19661.html","البسيط"],[64,"والله ما طلعت شمس ولا غربت","https://www.aldiwan.net/poem67558.html","البسيط"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"قرأت على أهلي كتابك إذا أتى","https://www.aldiwan.net/poem62922.html","الطويل"],[51,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[26,"أبالصرم من أسماء حدثك الذي","https://www.aldiwan.net/poem24096.html","الطويل"],[91,"وربت أمريكية خلت ودها","https://www.aldiwan.net/poem8794.html","عموديه"],[89,"إليك تتوق أيتها السماء","https://www.aldiwan.net/poem44967.html","الوافر"],[43,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[44,"أجفان خوط البانة الأملود","https://www.aldiwan.net/poem30531.html","الكامل"],[69,"والله لا كنت مادحا طرفا","https://www.aldiwan.net/poem28970.html","المنسرح"],[69,"تذكرت بالبرق إذ يلمع","https://www.aldiwan.net/poem28985.html","المتقارب"],[74,"ألا ليت أنفاس الرياح النواسم","https://www.aldiwan.net/poem13258.html","الطويل"],[105,"أكل متوج يحمي البلادا","https://www.aldiwan.net/poem43373.html","الوافر"],[105,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[13,"أقسمت لا أنسى وإن طال عيشنا","https://www.aldiwan.net/poem2209.html","الطويل"],[40,"رد الخليط الجمال فانتقلا","https://www.aldiwan.net/poem42312.html","المنسرح"],[22,"عفا مسحلان من سليمى فحامره","https://www.aldiwan.net/poem21639.html","الطويل"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[50,"غدا سلف فأصعد بالرباب","https://www.aldiwan.net/poem64835.html","الوافر"],[46,"عبيط ضوائن نحير جزر","https://www.aldiwan.net/poem22680.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85592","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16623","البسيط"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10976","الطويل"],[106,"آهة طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=179661",""],[22,"عَفَا مُسْحَلانُ عن سُلَيْمَى فَحَامِرُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=19750",""],[90,"الصَبر الجَميل","https://www.poetsgate.com/ViewPoem.aspx?id=179152",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"]],"verses":[["وَلا هَجَرَ السُمرَ العَوالي لِلَذَّةٍ","وَلا عاتَبَ البيضَ الغَواني عَلى الصَدِّ",0,"د",1,0],["وَلا هاجَ شَوقي نَفحَةٌ غَضَوِيَّةٌ","غَداةَ تَلَقَّتها العَرانينُ مِن نَجدِ",1,"د",1,0],["ولا هَزَّني طَمَعٌ لِلْقَريضِ","ولكِنَّهُ تَرْجُمانُ الأَدَبْ",2,"ب",1,0],["ولا هِمّتي تَرْضى بتَقْبيلِ أنْمُلٍ","نَشَأْنَ على فَقْرٍ وإنْ كُنَّ فُيَّضا",3,"ض",2,0],["وَلا هُوَ مَسبوقٌ بِشَيءٍ أَرادَهُ","وَلا هُوَ مُلهيهِ عَن الحَقِّ باطِلُ",4,"ل",1,0],["وُلاةُ أَرْزَاقِهِمْ وَلَّوْا فَمَا رَجَعُوا","وَغَادَرُوهُمْ عُرَاةً جُوَّعاً هُضُمَا",5,"م",2,0],["وَلا هِزاتُ الصَيفِ بِاِنفِصالِ","وَلَيسَ إِذ حاذَينَ بِالأَقوالِ",6,"ل",1,0],["ولا هجيت فلا أمسيت مفتقراً","وباركَ الله في عرضِي وفي مالي",7,"ي",1,0],["وَلا هَمَمتُ بِشُربِ الماءِ مِن عَطَشٍ","إِلّا رَأَيتُ خَيالاً مِنكَ في الكَأسِ",8,"س",1,0],["ولأهلِ العقول فِيه رجاءٌ","وعزاء يقاوم العَزَّاءَ",9,"ا",2,0],["ولا هو نسَّاني أسايَ عليهمُ","بلى هاجه والشجوُ للشجو أَهْيجُ",10,"ج",1,0],["ولا هي أقصى ما أُرجِّيه منكما","وكيف وأدناه الجسيمُ من الأمر",11,"ر",1,0],["ولّاهما رأياً له ومروءةً","فالرأيُ يُشحذُ والمروءةُ تُصقَلُ",12,"ل",1,0],["وَلا هَرَّها كَلبي لِيُبعِدَ نَفرَها","وَلَو نَبَحَتني بِالشَكاةِ كِلابُها",13,"ب",3,0],["وَلا هَزَّنا شَدوُ الحَمائِمِ في الضُحى","وَلا ضَمَّنا بَيت وَلَم يَحوِنا بُردُ",14,"د",1,0],["ولا هي في الجسامة لو علمنا","ولا في بعدها عنا سواءُ",15,"ا",2,0],["وَلا هِزَبراً لَهُ مِن دِرعِهِ لِبَدٌ","وَلا مَهاةً لَها مِن شِبهِها حَشَمُ",16,"م",1,0],["وَلّاهُ مَنصورٌ سَماحَ يَمينِهِ","وَمَضى فَقيدَ المِثلِ غَيرَ فَقيدِ",17,"د",1,0],["ولا هجوت اللئيمَ في عمري","منْ ذا يطيقُ الوقوعَ في جُورَهْ",18,"ه",1,0],["ولا هزَّ لي أمردٌ عطفه","يُشبَّه بالبدرِ إذْ يطلعُ",19,"ع",1,0],["وَلا هالَني إِلا نَذيرٌ بِرِحلَةٍ","مَسَحتُ لَهُ مِن رَوعَةٍ جَفنَ نائِمِ",20,"م",1,0],["وَلا هُوَ مالِكٌ كَشَفاً لِضُرٍّ","إِذا ما كائِدُ الحَدَثانِ كادا",21,"د",2,0],["وُلاةُ الزَّرْعِ للإسلامِ منهم","شَرِيكٌ ليس يُظلمُ أو يُحابى",22,"ب",2,0],["وَلا هَلَعٍ لاعٍ إِذا الشَولُ حارَدَت","وَضَنَّت بِباقي دَرِّها المُتَنَزِّلِ",23,"ل",1,0],["وَلا هَناهُ حَتّى يَشُوبَ بِهِ","وُدّاً أُراهُ لِوُدِّنا دَخَلا",24,"ل",2,0],["وَلا هادِمٌ بُنيانَ مَن شُرِّفَت لَهُ","قُرَيعُ بنُ عَوفٍ خَلفُهُ وَأَكابِرُه",25,"ر",2,0],["ولا هَيَّجَتْ شَوْقِي ظِباءٌ بِوَجْرَةٍ","ولا بَعَثَتْ وصْفِي نَقَانِقُها الرُّبْدُ",26,"د",1,0],["وَلأَهْدِيَنَّ إلى الوَزِيرِ وآلِهِ","درَّ المدائحِ في أَجَلِّ نِظامِ",27,"م",1,0],["وُلاةُ العِزِّ وَالشَرَفِ المُعَلّى","يَرُدّونَ الفُضولَ عَلى المُصابِ",28,"ب",1,0],["وُلاةُ العالَمينَ ذِئابٌ خَتلٍ","تَكونُ مِنَ الشَقاءِ رَعاةَ فِزرِ",29,"ر",1,0],["ولأهل الجحيم تمَّ بإنجا","د الشياطين في القتال الظهور",30,"ر",1,0],["ولا هو إلا بالجناحين طائر","وكل جناح منه يظهر في شطر",31,"ر",1,0],["ولا هَدِيّةَ عِنْدي غيرُ ما حَمَلَتْ","عن المُسيَّبِ أرْواحٌ لقَعْقاعِ",32,"ع",1,0],["وَلا هَبَّتِ الريحُ الجُنوبُ لِأَرضِها","مِنَ اللَيلِ إِلّا بِتُّ لِلريحِ حانِيا",33,"ي",2,0],["ولا هُو للجيد عقدٌ فريدٌ","ولا هو للأُذْن قُرطٌ ثمين",34,"ن",1,0],["ولا هو في السوق حلوى تُباعُ","ولا دُميةٌ تُشتَرَى بالمئين",34,"ن",1,0],["ولا هادِمٌ بُنْيَانَ ما شَرَّفَتْ لهم","قريعُ بن عوفٍ خلفهُ وأكابرهْ",35,"ر",2,0],["ولا هو بالشئ المشرِّفِ أهلَه","إذا لم تكنْ عُقباه غيرَ التوجّع",36,"ع",1,0],["ولا هي أوّلُ \" أغلوطةٍ \"","محا شاطبٌ رسمَها فامَّحى",37,"ا",1,0],["ولاهِينَ عن جِدِّهم بالفراغِ","زوايا المقاهي لهم مُنتدى",37,"ا",1,0],["ولاَ هنأتَ بما لَقِيت أناسٌ","على قبريكما رَفَعوا القِبابا",38,"ب",2,0],["وَلاَ هِيَ مِنْ فَقْدِ البَكَارَةِ رَهْبةٌ","وَلَكِنَّهُ عِلْمٌ لَدَيْهَا وَدُرْبةٌ",39,"ه",1,0]]}