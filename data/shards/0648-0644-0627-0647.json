,"سواي بهذه الدنيا يبالي","https://www.aldiwan.net/poem48852.html","الوافر"],[143,"هل فوق مجدك غاية لطلاب","https://www.aldiwan.net/poem11731.html","الكامل"],[143,"تمني العلى سهل ومنهجها وعر","https://www.aldiwan.net/poem11763.html","الطويل"],[147,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[147,"أقول لمحبوب تخلف من بعدي","https://www.aldiwan.net/poem47681.html","الطويل"],[160,"يا من بنعماه لحمي نابت ودمي","https://www.aldiwan.net/poem58990.html","البسيط"],[160,"قد صرت منا واحدا يا جعفر","https://www.aldiwan.net/poem59018.html","الكامل"],[163,"أرسم ديار لإبنة القين تعرف","https://www.aldiwan.net/poem397.html",""],[169,"العز ما خضعت لهيبته العدى","https://www.aldiwan.net/poem1618.html",""],[186,"باتت تلوم على طول الونى وغدت","https://www.aldiwan.net/poem43360.html","البسيط"],[186,"معز الدولة الوهناء","https://www.aldiwan.net/poem43751.html","مجزوء الوافر"],[186,"إلى الله أشكو حر نار تضرمت","https://www.aldiwan.net/poem44160.html","الطويل"],[193,"يا شادنا غاب وجه الحسن لولاه","https://www.aldiwan.net/poem13149.html","البسيط"],[199,"مضى والتقى نجمين في أفق جدا","https://www.aldiwan.net/poem45160.html","الطويل"],[199,"صبا للقصور وغزلانها","https://www.aldiwan.net/poem45545.html","المتقارب"],[204,"روض المحاسن نزهة الأبصار","https://www.aldiwan.net/poem53142.html","الكامل"],[204,"حلل المحاسن نزهة الأبصار","https://www.aldiwan.net/poem53256.html","الكامل"],[210,"هل لصب قد غير السقم حاله","https://www.aldiwan.net/poem13303.html","الخفيف"],[211,"رأيت ومن يعش ما عشت يشهد","https://www.aldiwan.net/poem46759.html","الوافر"],[229,"الحر لا يأتي الدنيه","https://www.aldiwan.net/poem50732.html","مجزوء الكامل"],[231,"سبح لربك في الظلام الداجي","https://www.aldiwan.net/poem44595.html","الكامل"],[237,"مظنة إتلاف المحب العواذل","https://www.aldiwan.net/poem18855.html","الطويل"],[241,"سقاها وحيا تربها وابل القطر","https://www.aldiwan.net/poem45764.html","الطويل"],[259,"كل شهم لذاته المدح صالح","https://www.aldiwan.net/poem35564.html","الخفيف"],[270,"عجبا أيودي بالشعوب بلوغ","https://www.aldiwan.net/poem34986.html","الكامل"],[275,"أما الكثيب فما يطار حماه","https://www.aldiwan.net/poem25463.html","الكامل"],[275,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[280,"أظن الدهر جاءك مستثيرا","https://www.aldiwan.net/poem60698.html","الوافر"],[298,"تحية طيبة","https://www.aldiwan.net/poem36305.html","عموديه"],[328,"أطرقت في ضراعة تذكر الله","https://www.aldiwan.net/poem55062.html","الخفيف"],[348,"كانون مطبخنا في العيد كانون","https://www.aldiwan.net/poem20727.html","البسيط"],[349,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[364,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[364,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[370,"وما نظرت مقلتي مذ طغت","https://www.aldiwan.net/poem1328.html",""],[371,"أرى في عراصي راكبا مترنما","https://www.aldiwan.net/poem57161.html","الطويل"],[371,"مزيدي أسى ما عندكم أنه يسلي","https://www.aldiwan.net/poem57215.html","الطويل"],[377,"ما لي بأوطان أخص صفاتها","https://www.aldiwan.net/poem59260.html","الكامل"],[402,"عزمت باليمن تحمي حوزة اليمن","https://www.aldiwan.net/poem46916.html","البسيط"],[402,"يهنا المعالي قدوم منك ميمون","https://www.aldiwan.net/poem46917.html","البسيط"],[402,"لو كان يعلم أنها الأحداق","https://www.aldiwan.net/poem46984.html","الكامل"],[403,"ولأهل هذي الهجرتين من الأذى","https://www.aldiwan.net/poem33397.html","الكامل"],[403,"لقد سار الإِمام أبو المعالي","https://www.aldiwan.net/poem33478.html","الوافر"],[410,"خلت بعدنا من آل ليلى المصانع","https://www.aldiwan.net/poem67491.html","الطويل"],[416,"أتنكر منك ما تطوي الضلوع","https://www.aldiwan.net/poem54084.html","الوافر"],[443,"أهي الجنة التي وعد الله","https://www.aldiwan.net/poem55987.html","عموديه"],[458,"خصيماي من ظمياء واش وشامت","https://www.aldiwan.net/poem56262.html","الطويل"],[470,"ولكنني وكلت من كل باخل","https://www.aldiwan.net/poem4736.html","الطويل"],[477,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[500,"جلا سر الغيوب لنا الصباح","https://www.aldiwan.net/poem37682.html","الوافر"],[538,"رعى الله أيام الصبا واللياليا","https://www.aldiwan.net/poem47491.html","عموديه"],[551,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[558,"ولعت بذاك الحي والمورد الحلو","https://www.aldiwan.net/poem33533.html","الطويل"],[558,"يا شرفي بأنه يعلمني","https://www.aldiwan.net/poem33732.html","الرجز"],[558,"نحن قوم نهوى الوجوه الحسانا","https://www.aldiwan.net/poem33816.html","الخفيف"],[558,"قضى الأمر وجف القلم","https://www.aldiwan.net/poem34195.html","الرمل"],[558,"دوائر أوهام بها شغل الفكر","https://www.aldiwan.net/poem34532.html","الطويل"],[558,"تفاخر الماء والهواء","https://www.aldiwan.net/poem35076.html","مخلع البسيط"],[564,"أعاد لها من مجدها ما تهدما","https://www.aldiwan.net/poem892.html",""],[575,"أقاموا بالمواخير","https://www.aldiwan.net/poem2950.html","الهزج"]],"verses":[["وَلا هَجَرَ السُمرَ العَوالي لِلَذَّةٍ","وَلا عاتَبَ البيضَ الغَواني عَلى الصَدِّ",0,"د",1,0],["وَلا هاجَ شَوقي نَفحَةٌ غَضَوِيَّةٌ","غَداةَ تَلَقَّتها العَرانينُ مِن نَجدِ",1,"د",1,0],["ولا هَزَّني طَمَعٌ لِلْقَريضِ","ولكِنَّهُ تَرْجُمانُ الأَدَبْ",2,"ب",1,0],["ولا هِمّتي تَرْضى بتَقْبيلِ أنْمُلٍ","نَشَأْنَ على فَقْرٍ وإنْ كُنَّ فُيَّضا",3,"ض",2,0],["وَلا هُوَ مَسبوقٌ بِشَيءٍ أَرادَهُ","وَلا هُوَ مُلهيهِ عَن الحَقِّ باطِلُ",4,"ل",1,0],["وُلاةُ أَرْزَاقِهِمْ وَلَّوْا فَمَا رَجَعُوا","وَغَادَرُوهُمْ عُرَاةً جُوَّعاً هُضُمَا",5,"م",2,0],["وَلا هِزاتُ الصَيفِ بِاِنفِصالِ","وَلَيسَ إِذ حاذَينَ بِالأَقوالِ",6,"ل",1,0],["ولا هجيت فلا أمسيت مفتقراً","وباركَ الله في عرضِي وفي مالي",7,"ي",1,0],["وَلا هَمَمتُ بِشُربِ الماءِ مِن عَطَشٍ","إِلّا رَأَيتُ خَيالاً مِنكَ في الكَأسِ",8,"س",1,0],["ولأهلِ العقول فِيه رجاءٌ","وعزاء يقاوم العَزَّاءَ",9,"ا",2,0],["ولا هو نسَّاني أسايَ عليهمُ","بلى هاجه والشجوُ للشجو أَهْيجُ",10,"ج",1,0],["ولا هي أقصى ما أُرجِّيه منكما","وكيف وأدناه الجسيمُ من الأمر",11,"ر",1,0],["ولّاهما رأياً له ومروءةً","فالرأيُ يُشحذُ والمروءةُ تُصقَلُ",12,"ل",1,0],["وَلا هَرَّها كَلبي لِيُبعِدَ نَفرَها","وَلَو نَبَحَتني بِالشَكاةِ كِلابُها",13,"ب",3,0],["وَلا هَزَّنا شَدوُ الحَمائِمِ في الضُحى","وَلا ضَمَّنا بَيت وَلَم يَحوِنا بُردُ",14,"د",1,0],["ولا هي في الجسامة لو علمنا","ولا في بعدها عنا سواءُ",15,"ا",2,0],["وَلا هِزَبراً لَهُ مِن دِرعِهِ لِبَدٌ","وَلا مَهاةً لَها مِن شِبهِها حَشَمُ",16,"م",1,0],["وَلّاهُ مَنصورٌ سَماحَ يَمينِهِ","وَمَضى فَقيدَ المِثلِ غَيرَ فَقيدِ",17,"د",1,0],["ولا هجوت اللئيمَ في عمري","منْ ذا يطيقُ الوقوعَ في جُورَهْ",18,"ه",1,0],["ولا هزَّ لي أمردٌ عطفه","يُشبَّه بالبدرِ إذْ يطلعُ",19,"ع",1,0],["وَلا هالَني إِلا نَذيرٌ بِرِحلَةٍ","مَسَحتُ لَهُ مِن رَوعَةٍ جَفنَ نائِمِ",20,"م",1,0],["وَلا هُوَ مالِكٌ كَشَفاً لِضُرٍّ","إِذا ما كائِدُ الحَدَثانِ كادا",21,"د",2,0],["وُلاةُ الزَّرْعِ للإسلامِ منهم","شَرِيكٌ ليس يُظلمُ أو يُحابى",22,"ب",2,0],["وَلا هَلَعٍ لاعٍ إِذا الشَولُ حارَدَت","وَضَنَّت بِباقي دَرِّها المُتَنَزِّلِ",23,"ل",1,0],["وَلا هَناهُ حَتّى يَشُوبَ بِهِ","وُدّاً أُراهُ لِوُدِّنا دَخَلا",24,"ل",2,0],["وَلا هادِمٌ بُنيانَ مَن شُرِّفَت لَهُ","قُرَيعُ بنُ عَوفٍ خَلفُهُ وَأَكابِرُه",25,"ر",2,0],["ولا هَيَّجَتْ شَوْقِي ظِباءٌ بِوَجْرَةٍ","ولا بَعَثَتْ وصْفِي نَقَانِقُها الرُّبْدُ",26,"د",1,0],["وَلأَهْدِيَنَّ إلى الوَزِيرِ وآلِهِ","درَّ المدائحِ في أَجَلِّ نِظامِ",27,"م",1,0],["وُلاةُ العِزِّ وَالشَرَفِ المُعَلّى","يَرُدّونَ الفُضولَ عَلى المُصابِ",28,"ب",1,0],["وُلاةُ العالَمينَ ذِئابٌ خَتلٍ","تَكونُ مِنَ الشَقاءِ رَعاةَ فِزرِ",29,"ر",1,0],["ولأهل الجحيم تمَّ بإنجا","د الشياطين في القتال الظهور",30,"ر",1,0],["ولا هو إلا بالجناحين طائر","وكل جناح منه يظهر في شطر",31,"ر",1,0],["ولا هَدِيّةَ عِنْدي غيرُ ما حَمَلَتْ","عن المُسيَّبِ أرْواحٌ لقَعْقاعِ",32,"ع",1,0],["وَلا هَبَّتِ الريحُ الجُنوبُ لِأَرضِها","مِنَ اللَيلِ إِلّا بِتُّ لِلريحِ حانِيا",33,"ي",2,0],["ولا هُو للجيد عقدٌ فريدٌ","ولا هو للأُذْن قُرطٌ ثمين",34,"ن",1,0],["ولا هو في السوق حلوى تُباعُ","ولا دُميةٌ تُشتَرَى بالمئين",34,"ن",1,0],["ولا هادِمٌ بُنْيَانَ ما شَرَّفَتْ لهم","قريعُ بن عوفٍ خلفهُ وأكابرهْ",35,"ر",2,0],["ولا هو بالشئ المشرِّفِ أهلَه","إذا لم تكنْ عُقباه غيرَ التوجّع",36,"ع",1,0],["ولا هي أوّلُ \" أغلوطةٍ \"","محا شاطبٌ رسمَها فامَّحى",37,"ا",1,0],["ولاهِينَ عن جِدِّهم بالفراغِ","زوايا المقاهي لهم مُنتدى",37,"ا",1,0],["ولاَ هنأتَ بما لَقِيت أناسٌ","على قبريكما رَفَعوا القِبابا",38,"ب",2,0],["ولا هناء بنعمى لا تخاف لها","فقدا ولا تبتلى منها بحرمان",39,"ن",1,0],["ولأهتفنّ بها فأسمع فيصلا","وأحرّك المنصور والسفّاحا",40,"ح",2,0],["وَلاَ هِيَ مِنْ فَقْدِ البَكَارَةِ رَهْبةٌ","وَلَكِنَّهُ عِلْمٌ لَدَيْهَا وَدُرْبةٌ",41,"ه",1,0],["ولأهجرن من الرقاد لذيذه","اذ راح اصناف العواذل نوما",42,"م",2,0],["ولأهل البيت سادتنا","والصحاب السادة الأسد",43,"د",1,0],["ولا هذا الذي قد خل","ته تقواك فحوانا",44,"ن",2,0],["ولا هوى رسه يبكي فتدمغه","بذكرياتك وادي السير ألحاني",45,"ي",1,0],["ولأهل التُّقى مآلا وذِي الفا","قةِ مالاً وللأنام عِمادا",46,"د",2,0],["ولا هو واقف بسبيل نهر","فليجئهم له صفر القلالِ",47,"ل",1,0],["وَلِأُهدِيَنَّ المَدحَ عَزَّ نَظيرُهُ","لِأَعَزِّ فَرعٍ في أَجَلِّ نِصابِ",48,"ب",1,0],["وَلا هُوَ عِندَ الفَخرِ ذو السُؤدُدِ الَّذي","يُقِرُّ بِهِ زَيدٌ وَيَجحَدُهُ عَمرو",49,"ر",2,0],["ولا هو بعد المزج أصفر فاقع","ولا هو قبل المزج قانٍ ومحمر",50,"ر",1,0],["ولا هالني زحف الصفوف وصوتها","بيوم يشيب الطفل فيه مع المرد",51,"د",1,0],["ولا هجمت على ما أنت تكرهه","فاقرع السن حيرانا من الندم",52,"م",1,0],["ولا هممت ولا حابيت متهما","لا والذي علم الإِنسان بالقلم",52,"م",1,0],["ولإهلها في ما لديه مكانة","لا ترتقى ومواهب لا تحصر",53,"ر",1,0],["وَلا هِندَ إِلّا أَن تَذَكَّرَ ما مَضى","تَقادُمَ عَهدٍ وَالتذكُرُ يَشعَفُ",54,"ف",1,0],["وَلَأُهدِيَنَّ إِلى عُلاكَ مَدائِحاً","يُنسيكَ شاديها الغَريضَ وَمَعبَدا",55,"د",2,0],["ولا هممت بأمر عزّ مطلبُه","إلا استعنت بباس غير منخزل",56,"ل",1,0],["ولا هذا بقوّته","ولا ذا بعد ينصرها",57,"ر",3,0],["ولا هو ممّن يعطف الشعر قلبهُ","إذا قلتُ فيه المدح بالكلم العذب",58,"ب",1,0],["وَلّاه رِقى ظَرفٍ في شَمائِلِهِ","فَاِشتَطَّ في الحُكمِ لَما أَن تَولّاهُ",59,"ه",1,0],["ولا هو شعري يا أبي ان تركتهُ","ولم تحفظ الأيام منهً لك الحمدا",60,"د",2,0],["ولا هو في طلعةِ النيِّرينِ","ولا في النجومِ وكيوانِها",61,"ن",3,0],["ولأهله شَرَطٌ أذاه وعيبُه","مَن أعجَبَته مذاهبُ الشُّطّارِ",62,"ر",1,0],["ولأهلِه شَرَطٌ أذاهُ وغَيُّه","مَن أعجبَته مذاهبُ الشطّارِ",63,"ر",1,0],["ولاهل القليب ازرى ببدر","ولكل منهم اراه وباله",64,"ل",2,0],["ولاة الأمر منطقهم عجيب","وهل في مصر يا قومي عجيب",65,"ب",1,0],["ولأهجرنّ لذِيذ كلْ","لِ معِيشةٍ عندي هَنِيّه",66,"ي",2,0],["ولأهل بدر والحديبية أعترف","بالفضل واحذر من يسيء ويداجي",67,"ج",2,0],["وَلاَ هِمَمٌ مَا لَمْ تَكُنْ أَدَبِيَّةً","وَلاَ مُنْجِدٌ إِلاَّ الْقَنَا وَالْقَنَابِلُ",68,"ل",1,0],["ولا هاجَني وجدٌ ولا رسمُ مَنزلٍ","عَفاءٍ ولكن هكذا سنَّةُ الشِّعرِ",69,"ر",1,0],["ولأهل القلوب فيه اعتناءٌ","وعليه الأنظار منهم لوامح",70,"ح",1,0],["ولأهلهِ فضلُ التقدمِ والهُدى","فتأخروا إذ للأمورِ فروغ",71,"غ",1,0],["وَلاهُ أَمْرَ عِبَادِهِ وَبِلادِهِ","لَمَّا ارْتَضَاهُ لِحَمْلِ ما وَلاهُ",72,"ا",2,0],["وَلاهُ الحُسْنُ وأمّرَهُ","وأتَاهُ السّحْرُ يُؤَيّدُهُ",73,"د",2,0],["وَلا هَجْراً يَوَدُّ وَلا وِصالاً","وَلا بَرْداً يُحِسُّ وَلا هَجِيرا",74,"ر",2,0],["وُلاةُ أَمرِ الأَدبِ","وَلّوكِ مُلكَ الأَدب",75,"ب",1,0],["ولأهدابها الرقاق قضاء","عبقري أحكامه خرساء",76,"ا",2,0],["وَلا هَدَتْ نَارُهُ السَّارِي ولا رُفِعَتْ","قِدْرٌ وَلا نُصِبَتْ فيهِ مَواعِينُ",77,"ن",1,0],["وَلِأَهلِها في كُلِّ حَيٍّ مَأهَلٌ","وَبِهِ لَها في كُلِّ رَبعٍ مَسجِدُ",78,"د",1,0],["ولا هو في ابنٍ إن سَطا يَتَّقى أباً","ولا في أبٍ يرعَى فيَصفَحُ عَن أَبْنا",79,"ن",2,0],["وُلاةُ البِيضِ أحلاسُ المَذَاكي","هِضابُ الطَّعْنِ أَقْرانُ النِّضال",80,"ل",1,0],["ولا هَجَعَتْ قَطٌّ إلاَّ رَأتْكَ","كَأَنَّك فِيْ جَفْنِها حَاضِرُ",81,"ر",1,0],["وَلا هُو إِلا أَن تَجودي بِنَظرَةٍ","يُجَدِّدُ فيها عَهدَهُ المُتَقَدِّما",82,"م",2,0],["ولا هُو قَلبي يومَ لا يَنتَهي به","وِصالٌ إلى شُغلٍ وهَجرٌ إلى خَتلِ",83,"ل",1,0],["ولأهجرنَّ ربوعَها فلأنها","بلدٌ تضيق على الكرام رسومها",84,"م",3,0],["ولأهم اللهُ مَلْكاً من بني حسنٍ","نظيره في قديم الدَّهر لم يكنِ",85,"ن",1,0],["ولاّه أحمدُ عن أمرٍ أتاهُ بهِ","عن الإِله أمينُ الله جبرينُ",86,"ن",1,0],["ولاَه أحمدُ في الغديرِ ولايةً","أَضحتْ مطوَّقةً بها الأعناقُ",87,"ق",1,0],["ولأهل هذي الهجرتين من الأذى","من كل مبتدع وذي شأن",88,"ن",1,1],["ولا هل كان فيهم أشعري","ولا هل كان من ذي الاعتزال",89,"ل",1,0],["وَلا هُوَ عِندَ السُخطِ مِنهُ وَلا الرِضا","بِغَيرِ الَّذي يَرضى بِهِ لِيَ صانِعُ",90,"ع",1,0],["ولا هاجَتْ شجونك هاتفات","تُكَتَّم ما تكابد أو تذيع",91,"ع",1,0],["ولأهل العلوم شادوا تماثي","لا لاعظامها تخر الرؤوس",92,"س",1,0],["ولا هو منها حيث يُجمَعُ شاردٌ","ولا يُرتَجَى للعَودِ إن عاد فالتُ",93,"ت",1,0],["وَلا هوَ إِمّا عاتِبٌ كانَ قابِلاً","مِنَ الهائِمِ الصَبِّ الَّذي يَتَضَرَّعُ",94,"ع",1,0],["ولا هدوئي ممكناً بعدَما","أصبحَ مِن دونكمُ الفَدْفَدُ",95,"د",1,0],["ولا هزَّت لأخذ الثأر سمرٌ","ولا لمعت بجذبتها الصفاح",96,"ح",1,0],["ولاَ هَمَّ لي إلاَّ دُروسِي وفَهمُهَا","وتَثقيفُ عقلِي واغتِنامُ شَبابيَا",97,"ي",2,0],["ولا هَناك الّذي أتاك ولا","أمنتَ فيما جنيتَه النِّقَما",98,"م",2,0],["ولاه هو الأمثال تضرب للورى","ولم يدرها إلا المجانب للهو",99,"و",1,0],["ولا هو الله أنا حاشاي أن","أقول ذا في السر أو في العلن",100,"ن",1,0],["ولأهل الخصوص مني مقام","كل حال في ذاته يتفانى",101,"ن",2,0],["ولأهل الأرض طراً ولمن","بالتقى تحفظ منه الذمم",102,"م",1,0],["ولا هي حلت فيه إذ لم يكن لها","وجود سواه وهي منه لها قدر",103,"ر",1,0],["ولا هواء إلا وفيه","نفع كما ربنا يشاء",104,"ا",2,0],["ولاها فأولاها السرور أبو الندى","من النعمى بها واكف هما",105,"م",2,0],["ولاهم في نفير النا","س تلقاهم ولا العيرْ",106,"ر",1,0]]}