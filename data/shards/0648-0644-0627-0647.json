273,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[278,"أظن الدهر جاءك مستثيرا","https://www.aldiwan.net/poem60698.html","الوافر"],[296,"تحية طيبة","https://www.aldiwan.net/poem36305.html","عموديه"],[326,"أطرقت في ضراعة تذكر الله","https://www.aldiwan.net/poem55062.html","الخفيف"],[346,"كانون مطبخنا في العيد كانون","https://www.aldiwan.net/poem20727.html","البسيط"],[347,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[362,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[362,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[368,"وما نظرت مقلتي مذ طغت","https://www.aldiwan.net/poem1328.html",""],[369,"أرى في عراصي راكبا مترنما","https://www.aldiwan.net/poem57161.html","الطويل"],[369,"مزيدي أسى ما عندكم أنه يسلي","https://www.aldiwan.net/poem57215.html","الطويل"],[374,"ما لي بأوطان أخص صفاتها","https://www.aldiwan.net/poem59260.html","الكامل"],[399,"عزمت باليمن تحمي حوزة اليمن","https://www.aldiwan.net/poem46916.html","البسيط"],[399,"يهنا المعالي قدوم منك ميمون","https://www.aldiwan.net/poem46917.html","البسيط"],[399,"لو كان يعلم أنها الأحداق","https://www.aldiwan.net/poem46984.html","الكامل"],[400,"ولأهل هذي الهجرتين من الأذى","https://www.aldiwan.net/poem33397.html","الكامل"],[400,"لقد سار الإِمام أبو المعالي","https://www.aldiwan.net/poem33478.html","الوافر"],[407,"خلت بعدنا من آل ليلى المصانع","https://www.aldiwan.net/poem67491.html","الطويل"],[413,"أتنكر منك ما تطوي الضلوع","https://www.aldiwan.net/poem54084.html","الوافر"],[441,"أهي الجنة التي وعد الله","https://www.aldiwan.net/poem55987.html","عموديه"],[456,"خصيماي من ظمياء واش وشامت","https://www.aldiwan.net/poem56262.html","الطويل"],[468,"ولكنني وكلت من كل باخل","https://www.aldiwan.net/poem4736.html","الطويل"],[475,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[498,"جلا سر الغيوب لنا الصباح","https://www.aldiwan.net/poem37682.html","الوافر"],[536,"رعى الله أيام الصبا واللياليا","https://www.aldiwan.net/poem47491.html","عموديه"],[549,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[556,"ولعت بذاك الحي والمورد الحلو","https://www.aldiwan.net/poem33533.html","الطويل"],[556,"يا شرفي بأنه يعلمني","https://www.aldiwan.net/poem33732.html","الرجز"],[556,"نحن قوم نهوى الوجوه الحسانا","https://www.aldiwan.net/poem33816.html","الخفيف"],[556,"قضى الأمر وجف القلم","https://www.aldiwan.net/poem34195.html","الرمل"],[556,"دوائر أوهام بها شغل الفكر","https://www.aldiwan.net/poem34532.html","الطويل"],[556,"تفاخر الماء والهواء","https://www.aldiwan.net/poem35076.html","مخلع البسيط"],[562,"أعاد لها من مجدها ما تهدما","https://www.aldiwan.net/poem892.html",""],[573,"أقاموا بالمواخير","https://www.aldiwan.net/poem2950.html","الهزج"]],"verses":[["وَلا هَجَرَ السُمرَ العَوالي لِلَذَّةٍ","وَلا عاتَبَ البيضَ الغَواني عَلى الصَدِّ",0,"د",1,0],["وَلا هاجَ شَوقي نَفحَةٌ غَضَوِيَّةٌ","غَداةَ تَلَقَّتها العَرانينُ مِن نَجدِ",1,"د",1,0],["ولا هَزَّني طَمَعٌ لِلْقَريضِ","ولكِنَّهُ تَرْجُمانُ الأَدَبْ",2,"ب",1,0],["ولا هِمّتي تَرْضى بتَقْبيلِ أنْمُلٍ","نَشَأْنَ على فَقْرٍ وإنْ كُنَّ فُيَّضا",3,"ض",2,0],["وَلا هُوَ مَسبوقٌ بِشَيءٍ أَرادَهُ","وَلا هُوَ مُلهيهِ عَن الحَقِّ باطِلُ",4,"ل",1,0],["وُلاةُ أَرْزَاقِهِمْ وَلَّوْا فَمَا رَجَعُوا","وَغَادَرُوهُمْ عُرَاةً جُوَّعاً هُضُمَا",5,"م",2,0],["وَلا هِزاتُ الصَيفِ بِاِنفِصالِ","وَلَيسَ إِذ حاذَينَ بِالأَقوالِ",6,"ل",1,0],["ولا هجيت فلا أمسيت مفتقراً","وباركَ الله في عرضِي وفي مالي",7,"ي",1,0],["وَلا هَمَمتُ بِشُربِ الماءِ مِن عَطَشٍ","إِلّا رَأَيتُ خَيالاً مِنكَ في الكَأسِ",8,"س",1,0],["ولأهلِ العقول فِيه رجاءٌ","وعزاء يقاوم العَزَّاءَ",9,"ا",2,0],["ولا هو نسَّاني أسايَ عليهمُ","بلى هاجه والشجوُ للشجو أَهْيجُ",10,"ج",1,0],["ولا هي أقصى ما أُرجِّيه منكما","وكيف وأدناه الجسيمُ من الأمر",11,"ر",1,0],["ولّاهما رأياً له ومروءةً","فالرأيُ يُشحذُ والمروءةُ تُصقَلُ",12,"ل",1,0],["وَلا هَرَّها كَلبي لِيُبعِدَ نَفرَها","وَلَو نَبَحَتني بِالشَكاةِ كِلابُها",13,"ب",3,0],["وَلا هَزَّنا شَدوُ الحَمائِمِ في الضُحى","وَلا ضَمَّنا بَيت وَلَم يَحوِنا بُردُ",14,"د",1,0],["ولا هي في الجسامة لو علمنا","ولا في بعدها عنا سواءُ",15,"ا",2,0],["وَلا هِزَبراً لَهُ مِن دِرعِهِ لِبَدٌ","وَلا مَهاةً لَها مِن شِبهِها حَشَمُ",16,"م",1,0],["وَلّاهُ مَنصورٌ سَماحَ يَمينِهِ","وَمَضى فَقيدَ المِثلِ غَيرَ فَقيدِ",17,"د",1,0],["ولا هجوت اللئيمَ في عمري","منْ ذا يطيقُ الوقوعَ في جُورَهْ",18,"ه",1,0],["ولا هزَّ لي أمردٌ عطفه","يُشبَّه بالبدرِ إذْ يطلعُ",19,"ع",1,0],["وَلا هالَني إِلا نَذيرٌ بِرِحلَةٍ","مَسَحتُ لَهُ مِن رَوعَةٍ جَفنَ نائِمِ",20,"م",1,0],["وَلا هُوَ مالِكٌ كَشَفاً لِضُرٍّ","إِذا ما كائِدُ الحَدَثانِ كادا",21,"د",2,0],["وُلاةُ الزَّرْعِ للإسلامِ منهم","شَرِيكٌ ليس يُظلمُ أو يُحابى",22,"ب",2,0],["وَلا هَلَعٍ لاعٍ إِذا الشَولُ حارَدَت","وَضَنَّت بِباقي دَرِّها المُتَنَزِّلِ",23,"ل",1,0],["وَلا هَناهُ حَتّى يَشُوبَ بِهِ","وُدّاً أُراهُ لِوُدِّنا دَخَلا",24,"ل",2,0],["وَلا هادِمٌ بُنيانَ مَن شُرِّفَت لَهُ","قُرَيعُ بنُ عَوفٍ خَلفُهُ وَأَكابِرُه",25,"ر",2,0],["ولا هَيَّجَتْ شَوْقِي ظِباءٌ بِوَجْرَةٍ","ولا بَعَثَتْ وصْفِي نَقَانِقُها الرُّبْدُ",26,"د",1,0],["وَلأَهْدِيَنَّ إلى الوَزِيرِ وآلِهِ","درَّ المدائحِ في أَجَلِّ نِظامِ",27,"م",1,0],["وُلاةُ العِزِّ وَالشَرَفِ المُعَلّى","يَرُدّونَ الفُضولَ عَلى المُصابِ",28,"ب",1,0],["وُلاةُ العالَمينَ ذِئابٌ خَتلٍ","تَكونُ مِنَ الشَقاءِ رَعاةَ فِزرِ",29,"ر",1,0],["ولأهل الجحيم تمَّ بإنجا","د الشياطين في القتال الظهور",30,"ر",1,0],["ولا هو إلا بالجناحين طائر","وكل جناح منه يظهر في شطر",31,"ر",1,0],["ولا هَدِيّةَ عِنْدي غيرُ ما حَمَلَتْ","عن المُسيَّبِ أرْواحٌ لقَعْقاعِ",32,"ع",1,0],["وَلا هَبَّتِ الريحُ الجُنوبُ لِأَرضِها","مِنَ اللَيلِ إِلّا بِتُّ لِلريحِ حانِيا",33,"ي",2,0],["ولا هُو للجيد عقدٌ فريدٌ","ولا هو للأُذْن قُرطٌ ثمين",34,"ن",1,0],["ولا هو في السوق حلوى تُباعُ","ولا دُميةٌ تُشتَرَى بالمئين",34,"ن",1,0],["ولا هادِمٌ بُنْيَانَ ما شَرَّفَتْ لهم","قريعُ بن عوفٍ خلفهُ وأكابرهْ",35,"ر",2,0],["ولا هو بالشئ المشرِّفِ أهلَه","إذا لم تكنْ عُقباه غيرَ التوجّع",36,"ع",1,0],["ولا هي أوّلُ \" أغلوطةٍ \"","محا شاطبٌ رسمَها فامَّحى",37,"ا",1,0],["ولاهِينَ عن جِدِّهم بالفراغِ","زوايا المقاهي لهم مُنتدى",37,"ا",1,0],["ولاَ هنأتَ بما لَقِيت أناسٌ","على قبريكما رَفَعوا القِبابا",38,"ب",2,0],["وَلاَ هِيَ مِنْ فَقْدِ البَكَارَةِ رَهْبةٌ","وَلَكِنَّهُ عِلْمٌ لَدَيْهَا وَدُرْبةٌ",39,"ه",1,0],["ولأهجرن من الرقاد لذيذه","اذ راح اصناف العواذل نوما",40,"م",2,0],["ولأهل البيت سادتنا","والصحاب السادة الأسد",41,"د",1,0],["ولا هذا الذي قد خل","ته تقواك فحوانا",42,"ن",2,0],["ولا هوى رسه يبكي فتدمغه","بذكرياتك وادي السير ألحاني",43,"ي",1,0],["ولأهل التُّقى مآلا وذِي الفا","قةِ مالاً وللأنام عِمادا",44,"د",2,0],["ولا هو واقف بسبيل نهر","فليجئهم له صفر القلالِ",45,"ل",1,0],["وَلِأُهدِيَنَّ المَدحَ عَزَّ نَظيرُهُ","لِأَعَزِّ فَرعٍ في أَجَلِّ نِصابِ",46,"ب",1,0],["وَلا هُوَ عِندَ الفَخرِ ذو السُؤدُدِ الَّذي","يُقِرُّ بِهِ زَيدٌ وَيَجحَدُهُ عَمرو",47,"ر",2,0],["ولا هو بعد المزج أصفر فاقع","ولا هو قبل المزج قانٍ ومحمر",48,"ر",1,0],["ولا هالني زحف الصفوف وصوتها","بيوم يشيب الطفل فيه مع المرد",49,"د",1,0],["ولا هجمت على ما أنت تكرهه","فاقرع السن حيرانا من الندم",50,"م",1,0],["ولا هممت ولا حابيت متهما","لا والذي علم الإِنسان بالقلم",50,"م",1,0],["ولإهلها في ما لديه مكانة","لا ترتقى ومواهب لا تحصر",51,"ر",1,0],["وَلا هِندَ إِلّا أَن تَذَكَّرَ ما مَضى","تَقادُمَ عَهدٍ وَالتذكُرُ يَشعَفُ",52,"ف",1,0],["وَلَأُهدِيَنَّ إِلى عُلاكَ مَدائِحاً","يُنسيكَ شاديها الغَريضَ وَمَعبَدا",53,"د",2,0],["ولا هممت بأمر عزّ مطلبُه","إلا استعنت بباس غير منخزل",54,"ل",1,0],["ولا هذا بقوّته","ولا ذا بعد ينصرها",55,"ر",3,0],["ولا هو ممّن يعطف الشعر قلبهُ","إذا قلتُ فيه المدح بالكلم العذب",56,"ب",1,0],["وَلّاه رِقى ظَرفٍ في شَمائِلِهِ","فَاِشتَطَّ في الحُكمِ لَما أَن تَولّاهُ",57,"ه",1,0],["ولا هو شعري يا أبي ان تركتهُ","ولم تحفظ الأيام منهً لك الحمدا",58,"د",2,0],["ولا هو في طلعةِ النيِّرينِ","ولا في النجومِ وكيوانِها",59,"ن",3,0],["ولأهله شَرَطٌ أذاه وعيبُه","مَن أعجَبَته مذاهبُ الشُّطّارِ",60,"ر",1,0],["ولأهلِه شَرَطٌ أذاهُ وغَيُّه","مَن أعجبَته مذاهبُ الشطّارِ",61,"ر",1,0],["ولاهل القليب ازرى ببدر","ولكل منهم اراه وباله",62,"ل",2,0],["ولاة الأمر منطقهم عجيب","وهل في مصر يا قومي عجيب",63,"ب",1,0],["ولأهجرنّ لذِيذ كلْ","لِ معِيشةٍ عندي هَنِيّه",64,"ي",2,0],["ولأهل بدر والحديبية أعترف","بالفضل واحذر من يسيء ويداجي",65,"ج",2,0],["وَلاَ هِمَمٌ مَا لَمْ تَكُنْ أَدَبِيَّةً","وَلاَ مُنْجِدٌ إِلاَّ الْقَنَا وَالْقَنَابِلُ",66,"ل",1,0],["ولا هاجَني وجدٌ ولا رسمُ مَنزلٍ","عَفاءٍ ولكن هكذا سنَّةُ الشِّعرِ",67,"ر",1,0],["ولأهل القلوب فيه اعتناءٌ","وعليه الأنظار منهم لوامح",68,"ح",1,0],["ولأهلهِ فضلُ التقدمِ والهُدى","فتأخروا إذ للأمورِ فروغ",69,"غ",1,0],["وَلاهُ أَمْرَ عِبَادِهِ وَبِلادِهِ","لَمَّا ارْتَضَاهُ لِحَمْلِ ما وَلاهُ",70,"ا",2,0],["وَلاهُ الحُسْنُ وأمّرَهُ","وأتَاهُ السّحْرُ يُؤَيّدُهُ",71,"د",2,0],["وَلا هَجْراً يَوَدُّ وَلا وِصالاً","وَلا بَرْداً يُحِسُّ وَلا هَجِيرا",72,"ر",2,0],["وُلاةُ أَمرِ الأَدبِ","وَلّوكِ مُلكَ الأَدب",73,"ب",1,0],["ولأهدابها الرقاق قضاء","عبقري أحكامه خرساء",74,"ا",2,0],["وَلا هَدَتْ نَارُهُ السَّارِي ولا رُفِعَتْ","قِدْرٌ وَلا نُصِبَتْ فيهِ مَواعِينُ",75,"ن",1,0],["وَلِأَهلِها في كُلِّ حَيٍّ مَأهَلٌ","وَبِهِ لَها في كُلِّ رَبعٍ مَسجِدُ",76,"د",1,0],["ولا هو في ابنٍ إن سَطا يَتَّقى أباً","ولا في أبٍ يرعَى فيَصفَحُ عَن أَبْنا",77,"ن",2,0],["وُلاةُ البِيضِ أحلاسُ المَذَاكي","هِضابُ الطَّعْنِ أَقْرانُ النِّضال",78,"ل",1,0],["ولا هَجَعَتْ قَطٌّ إلاَّ رَأتْكَ","كَأَنَّك فِيْ جَفْنِها حَاضِرُ",79,"ر",1,0],["وَلا هُو إِلا أَن تَجودي بِنَظرَةٍ","يُجَدِّدُ فيها عَهدَهُ المُتَقَدِّما",80,"م",2,0],["ولا هُو قَلبي يومَ لا يَنتَهي به","وِصالٌ إلى شُغلٍ وهَجرٌ إلى خَتلِ",81,"ل",1,0],["ولأهجرنَّ ربوعَها فلأنها","بلدٌ تضيق على الكرام رسومها",82,"م",3,0],["ولأهم اللهُ مَلْكاً من بني حسنٍ","نظيره في قديم الدَّهر لم يكنِ",83,"ن",1,0],["ولاّه أحمدُ عن أمرٍ أتاهُ بهِ","عن الإِله أمينُ الله جبرينُ",84,"ن",1,0],["ولاَه أحمدُ في الغديرِ ولايةً","أَضحتْ مطوَّقةً بها الأعناقُ",85,"ق",1,0],["ولأهل هذي الهجرتين من الأذى","من كل مبتدع وذي شأن",86,"ن",1,1],["ولا هل كان فيهم أشعري","ولا هل كان من ذي الاعتزال",87,"ل",1,0],["وَلا هُوَ عِندَ السُخطِ مِنهُ وَلا الرِضا","بِغَيرِ الَّذي يَرضى بِهِ لِيَ صانِعُ",88,"ع",1,0],["ولا هاجَتْ شجونك هاتفات","تُكَتَّم ما تكابد أو تذيع",89,"ع",1,0],["ولأهل العلوم شادوا تماثي","لا لاعظامها تخر الرؤوس",90,"س",1,0],["ولا هو منها حيث يُجمَعُ شاردٌ","ولا يُرتَجَى للعَودِ إن عاد فالتُ",91,"ت",1,0],["وَلا هوَ إِمّا عاتِبٌ كانَ قابِلاً","مِنَ الهائِمِ الصَبِّ الَّذي يَتَضَرَّعُ",92,"ع",1,0],["ولا هدوئي ممكناً بعدَما","أصبحَ مِن دونكمُ الفَدْفَدُ",93,"د",1,0],["ولا هزَّت لأخذ الثأر سمرٌ","ولا لمعت بجذبتها الصفاح",94,"ح",1,0],["ولاَ هَمَّ لي إلاَّ دُروسِي وفَهمُهَا","وتَثقيفُ عقلِي واغتِنامُ شَبابيَا",95,"ي",2,0],["ولا هَناك الّذي أتاك ولا","أمنتَ فيما جنيتَه النِّقَما",96,"م",2,0],["ولاه هو الأمثال تضرب للورى","ولم يدرها إلا المجانب للهو",97,"و",1,0],["ولا هو الله أنا حاشاي أن","أقول ذا في السر أو في العلن",98,"ن",1,0],["ولأهل الخصوص مني مقام","كل حال في ذاته يتفانى",99,"ن",2,0],["ولأهل الأرض طراً ولمن","بالتقى تحفظ منه الذمم",100,"م",1,0],["ولا هي حلت فيه إذ لم يكن لها","وجود سواه وهي منه لها قدر",101,"ر",1,0],["ولا هواء إلا وفيه","نفع كما ربنا يشاء",102,"ا",2,0],["ولاها فأولاها السرور أبو الندى","من النعمى بها واكف هما",103,"م",2,0],["ولاهم في نفير النا","س تلقاهم ولا العيرْ",104,"ر",1,0]]}