.aspx?id=941",""],[5573,"ياسعود لاصكت علي الغلايب","https://www.poetsgate.com/ViewPoem.aspx?id=200079",""],[5573,"بدينا بذكر الي سماه اعتلى بها - مجالسي","https://www.poetsgate.com/ViewPoem.aspx?id=206494",""],[5606,"العام الأول قلت باروح للصيد","https://www.poetsgate.com/ViewPoem.aspx?id=197740",""],[5616,"مزاج","https://www.poetsgate.com/ViewPoem.aspx?id=203198",""],[5652,"العيد هذا غير ..!","https://www.poetsgate.com/ViewPoem.aspx?id=150040",""],[5652,"تعددت احوالنا","https://www.poetsgate.com/ViewPoem.aspx?id=165350",""],[5652,"ياعبيد حدوني كثير المقاريد","https://www.poetsgate.com/ViewPoem.aspx?id=208684",""],[5660,"لَعَمرُكَ ما يُغني البُكى وَ التَوَجُّعُ","https://www.poetsgate.com/ViewPoem.aspx?id=28435",""],[5689,"هل طي عرفك لي يا نسمة السحر","https://www.poetsgate.com/ViewPoem.aspx?id=143428",""],[5691,"لاتحزني ياقدس...!","https://www.poetsgate.com/ViewPoem.aspx?id=206251",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5694,"البيعة","https://www.poetsgate.com/ViewPoem.aspx?id=129888",""],[5718,"صروف الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=213982",""],[5756,"ثامن السبع العجايب","https://www.poetsgate.com/ViewPoem.aspx?id=5422",""],[5756,"الجريمة","https://www.poetsgate.com/ViewPoem.aspx?id=5418",""],[5837,"راس جسّاس","https://www.poetsgate.com/ViewPoem.aspx?id=182881",""],[5843,"خيل الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=51277",""],[5848,"أروح اصور معك في المنتدى العام","https://www.poetsgate.com/ViewPoem.aspx?id=48845",""],[5908,"لي لا لغيري آلت نوبة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=170970",""],[5947,"ممكن؟!!","https://www.poetsgate.com/ViewPoem.aspx?id=23331",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5956,"الكورونا وباءٌ قد يحسِّن العالم","https://www.poetsgate.com/ViewPoem.aspx?id=210865",""],[6008,"من الجوف","https://www.poetsgate.com/ViewPoem.aspx?id=60806",""],[6115,"قليل المواقف بينت لي وجوه الناس","https://www.poetsgate.com/ViewPoem.aspx?id=181804",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[242,"مظنة اتلاف المحب العواذل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563706",""],[6177,"شرايين التراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79077&r=&rc=20",""],[415,"بَأبِي شَخصُكَ الذي لا يَغيبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7784&r=&rc=14",""],[402,"وارحمتاه لقوم فارقوا النعما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54062&r=&rc=914",""]],"verses":[["ولا هالني في سمه جرم عرسه","كما هالني صفح تحراه غاضبه",0,"ب",2,0],["وَلا هَجَرَ السُمرَ العَوالي لِلَذَّةٍ","وَلا عاتَبَ البيضَ الغَواني عَلى الصَدِّ",1,"د",1,0],["وَلا هاجَ شَوقي نَفحَةٌ غَضَوِيَّةٌ","غَداةَ تَلَقَّتها العَرانينُ مِن نَجدِ",2,"د",1,0],["ولا هَزَّني طَمَعٌ لِلْقَريضِ","ولكِنَّهُ تَرْجُمانُ الأَدَبْ",3,"ب",1,0],["ولا هِمّتي تَرْضى بتَقْبيلِ أنْمُلٍ","نَشَأْنَ على فَقْرٍ وإنْ كُنَّ فُيَّضا",4,"ض",2,0],["وَلا هُوَ مَسبوقٌ بِشَيءٍ أَرادَهُ","وَلا هُوَ مُلهيهِ عَن الحَقِّ باطِلُ",5,"ل",1,0],["وُلاةُ أَرْزَاقِهِمْ وَلَّوْا فَمَا رَجَعُوا","وَغَادَرُوهُمْ عُرَاةً جُوَّعاً هُضُمَا",6,"م",2,0],["وَلا هِزاتُ الصَيفِ بِاِنفِصالِ","وَلَيسَ إِذ حاذَينَ بِالأَقوالِ",7,"ل",1,0],["ولا هجيت فلا أمسيت مفتقراً","وباركَ الله في عرضِي وفي مالي",8,"ي",1,0],["وَلا هَمَمتُ بِشُربِ الماءِ مِن عَطَشٍ","إِلّا رَأَيتُ خَيالاً مِنكَ في الكَأسِ",9,"س",1,0],["ولأهلِ العقول فِيه رجاءٌ","وعزاء يقاوم العَزَّاءَ",10,"ا",2,0],["ولا هو نسَّاني أسايَ عليهمُ","بلى هاجه والشجوُ للشجو أَهْيجُ",11,"ج",1,0],["ولا هي أقصى ما أُرجِّيه منكما","وكيف وأدناه الجسيمُ من الأمر",12,"ر",1,0],["ولّاهما رأياً له ومروءةً","فالرأيُ يُشحذُ والمروءةُ تُصقَلُ",13,"ل",1,0],["وَلا هَرَّها كَلبي لِيُبعِدَ نَفرَها","وَلَو نَبَحَتني بِالشَكاةِ كِلابُها",14,"ب",3,0],["وَلا هَزَّنا شَدوُ الحَمائِمِ في الضُحى","وَلا ضَمَّنا بَيت وَلَم يَحوِنا بُردُ",15,"د",1,0],["ولا هي في الجسامة لو علمنا","ولا في بعدها عنا سواءُ",16,"ا",2,0],["وَلا هِزَبراً لَهُ مِن دِرعِهِ لِبَدٌ","وَلا مَهاةً لَها مِن شِبهِها حَشَمُ",17,"م",1,0],["وَلّاهُ مَنصورٌ سَماحَ يَمينِهِ","وَمَضى فَقيدَ المِثلِ غَيرَ فَقيدِ",18,"د",1,0],["ولا هجوت اللئيمَ في عمري","منْ ذا يطيقُ الوقوعَ في جُورَهْ",19,"ه",1,0],["ولا هزَّ لي أمردٌ عطفه","يُشبَّه بالبدرِ إذْ يطلعُ",20,"ع",1,0],["وَلا هالَني إِلا نَذيرٌ بِرِحلَةٍ","مَسَحتُ لَهُ مِن رَوعَةٍ جَفنَ نائِمِ",21,"م",1,0],["وَلا هُوَ مالِكٌ كَشَفاً لِضُرٍّ","إِذا ما كائِدُ الحَدَثانِ كادا",22,"د",2,0],["وُلاةُ الزَّرْعِ للإسلامِ منهم","شَرِيكٌ ليس يُظلمُ أو يُحابى",23,"ب",2,0],["وَلا هَلَعٍ لاعٍ إِذا الشَولُ حارَدَت","وَضَنَّت بِباقي دَرِّها المُتَنَزِّلِ",24,"ل",1,0],["وَلا هَناهُ حَتّى يَشُوبَ بِهِ","وُدّاً أُراهُ لِوُدِّنا دَخَلا",25,"ل",2,0],["وَلا هادِمٌ بُنيانَ مَن شُرِّفَت لَهُ","قُرَيعُ بنُ عَوفٍ خَلفُهُ وَأَكابِرُه",26,"ر",2,0],["ولا هَيَّجَتْ شَوْقِي ظِباءٌ بِوَجْرَةٍ","ولا بَعَثَتْ وصْفِي نَقَانِقُها الرُّبْدُ",27,"د",1,0],["وَلأَهْدِيَنَّ إلى الوَزِيرِ وآلِهِ","درَّ المدائحِ في أَجَلِّ نِظامِ",28,"م",1,0],["وُلاةُ العِزِّ وَالشَرَفِ المُعَلّى","يَرُدّونَ الفُضولَ عَلى المُصابِ",29,"ب",1,0],["وُلاةُ العالَمينَ ذِئابٌ خَتلٍ","تَكونُ مِنَ الشَقاءِ رَعاةَ فِزرِ",30,"ر",1,0],["ولأهل الجحيم تمَّ بإنجا","د الشياطين في القتال الظهور",31,"ر",1,0],["ولا هو إلا بالجناحين طائر","وكل جناح منه يظهر في شطر",32,"ر",1,0],["ولا هَدِيّةَ عِنْدي غيرُ ما حَمَلَتْ","عن المُسيَّبِ أرْواحٌ لقَعْقاعِ",33,"ع",1,0],["وَلا هَبَّتِ الريحُ الجُنوبُ لِأَرضِها","مِنَ اللَيلِ إِلّا بِتُّ لِلريحِ حانِيا",34,"ي",2,0],["ولا هُو للجيد عقدٌ فريدٌ","ولا هو للأُذْن قُرطٌ ثمين",35,"ن",1,0],["ولا هو في السوق حلوى تُباعُ","ولا دُميةٌ تُشتَرَى بالمئين",35,"ن",1,0],["ولا هنئت بفضل لا تراقبني","من الرزايا عليه خطة جلل",36,"ل",1,0],["ولا هو بالاعجال يحذر فائتا","سواه تعالى قبل فوت يسارع",37,"ع",1,0],["ولا هادِمٌ بُنْيَانَ ما شَرَّفَتْ لهم","قريعُ بن عوفٍ خلفهُ وأكابرهْ",38,"ر",2,0],["ولا هو بالشئ المشرِّفِ أهلَه","إذا لم تكنْ عُقباه غيرَ التوجّع",39,"ع",1,0],["ولا هي أوّلُ \" أغلوطةٍ \"","محا شاطبٌ رسمَها فامَّحى",40,"ا",1,0],["ولاهِينَ عن جِدِّهم بالفراغِ","زوايا المقاهي لهم مُنتدى",40,"ا",1,0],["ولاَ هنأتَ بما لَقِيت أناسٌ","على قبريكما رَفَعوا القِبابا",41,"ب",2,0],["ولا هناء بنعمى لا تخاف لها","فقدا ولا تبتلى منها بحرمان",42,"ن",1,0],["ولأهتفنّ بها فأسمع فيصلا","وأحرّك المنصور والسفّاحا",43,"ح",2,0],["وَلاَ هِيَ مِنْ فَقْدِ البَكَارَةِ رَهْبةٌ","وَلَكِنَّهُ عِلْمٌ لَدَيْهَا وَدُرْبةٌ",44,"ه",1,0],["ولأهجرن من الرقاد لذيذه","اذ راح اصناف العواذل نوما",45,"م",2,0],["ولأهل البيت سادتنا","والصحاب السادة الأسد",46,"د",1,0],["ولا هذا الذي قد خل","ته تقواك فحوانا",47,"ن",2,0],["ولا هوى رسه يبكي فتدمغه","بذكرياتك وادي السير ألحاني",48,"ن",2,0],["ولأهل التُّقى مآلا وذِي الفا","قةِ مالاً وللأنام عِمادا",49,"د",2,0],["ولا هو واقف بسبيل نهر","فليجئهم له صفر القلالِ",50,"ل",1,0],["وَلِأُهدِيَنَّ المَدحَ عَزَّ نَظيرُهُ","لِأَعَزِّ فَرعٍ في أَجَلِّ نِصابِ",51,"ب",1,0],["وَلا هُوَ عِندَ الفَخرِ ذو السُؤدُدِ الَّذي","يُقِرُّ بِهِ زَيدٌ وَيَجحَدُهُ عَمرو",52,"ر",2,0],["ولا هو بعد المزج أصفر فاقع","ولا هو قبل المزج قانٍ ومحمر",53,"ر",1,0],["ولا هالني زحف الصفوف وصوتها","بيوم يشيب الطفل فيه مع المرد",54,"د",1,0],["ولا هجمت على ما أنت تكرهه","فاقرع السن حيرانا من الندم",55,"م",1,0],["ولا هممت ولا حابيت متهما","لا والذي علم الإِنسان بالقلم",55,"م",1,0],["ولإهلها في ما لديه مكانة","لا ترتقى ومواهب لا تحصر",56,"ر",1,0],["وَلا هِندَ إِلّا أَن تَذَكَّرَ ما مَضى","تَقادُمَ عَهدٍ وَالتذكُرُ يَشعَفُ",57,"ف",1,0],["وَلَأُهدِيَنَّ إِلى عُلاكَ مَدائِحاً","يُنسيكَ شاديها الغَريضَ وَمَعبَدا",58,"د",2,0],["ولا هممت بأمر عزّ مطلبُه","إلا استعنت بباس غير منخزل",59,"ل",1,0],["ولا هذا بقوّته","ولا ذا بعد ينصرها",60,"ر",3,0],["ولا هو ممّن يعطف الشعر قلبهُ","إذا قلتُ فيه المدح بالكلم العذب",61,"ب",1,0],["وَلّاه رِقى ظَرفٍ في شَمائِلِهِ","فَاِشتَطَّ في الحُكمِ لَما أَن تَولّاهُ",62,"ه",1,0],["ولا هو شعري يا أبي ان تركتهُ","ولم تحفظ الأيام منهً لك الحمدا",63,"د",2,0],["ولا هو في طلعةِ النيِّرينِ","ولا في النجومِ وكيوانِها",64,"ن",3,0],["ولأهله شَرَطٌ أذاه وعيبُه","مَن أعجَبَته مذاهبُ الشُّطّارِ",65,"ر",1,0],["ولأهلِه شَرَطٌ أذاهُ وغَيُّه","مَن أعجبَته مذاهبُ الشطّارِ",66,"ر",1,0],["ولاهل القليب ازرى ببدر","ولكل منهم اراه وباله",67,"ل",2,0],["ولاة الأمر منطقهم عجيب","وهل في مصر يا قومي عجيب",68,"ب",1,0],["ولأهجرنّ لذِيذ كلْ","لِ معِيشةٍ عندي هَنِيّه",69,"ي",2,0],["ولأهل بدر والحديبية أعترف","بالفضل واحذر من يسيء ويداجي",70,"ج",2,0],["وَلاَ هِمَمٌ مَا لَمْ تَكُنْ أَدَبِيَّةً","وَلاَ مُنْجِدٌ إِلاَّ الْقَنَا وَالْقَنَابِلُ",71,"ل",1,0],["ولا هاجَني وجدٌ ولا رسمُ مَنزلٍ","عَفاءٍ ولكن هكذا سنَّةُ الشِّعرِ",72,"ر",1,0],["ولأهل القلوب فيه اعتناءٌ","وعليه الأنظار منهم لوامح",73,"ح",1,0],["ولأهلهِ فضلُ التقدمِ والهُدى","فتأخروا إذ للأمورِ فروغ",74,"غ",1,0],["وَلاهُ أَمْرَ عِبَادِهِ وَبِلادِهِ","لَمَّا ارْتَضَاهُ لِحَمْلِ ما وَلاهُ",75,"ا",2,0],["وَلاهُ الحُسْنُ وأمّرَهُ","وأتَاهُ السّحْرُ يُؤَيّدُهُ",76,"د",2,0],["وَلا هَجْراً يَوَدُّ وَلا وِصالاً","وَلا بَرْداً يُحِسُّ وَلا هَجِيرا",77,"ر",2,0],["وُلاةُ أَمرِ الأَدبِ","وَلّوكِ مُلكَ الأَدب",78,"ب",1,0],["ولأهدابها الرقاق قضاء","عبقري أحكامه خرساء",79,"ا",2,0],["وَلا هَدَتْ نَارُهُ السَّارِي ولا رُفِعَتْ","قِدْرٌ وَلا نُصِبَتْ فيهِ مَواعِينُ",80,"ن",1,0],["وَلِأَهلِها في كُلِّ حَيٍّ مَأهَلٌ","وَبِهِ لَها في كُلِّ رَبعٍ مَسجِدُ",81,"د",1,0],["ولا هو في ابنٍ إن سَطا يَتَّقى أباً","ولا في أبٍ يرعَى فيَصفَحُ عَن أَبْنا",82,"ن",2,0],["وُلاةُ البِيضِ أحلاسُ المَذَاكي","هِضابُ الطَّعْنِ أَقْرانُ النِّضال",83,"ل",1,0],["ولا هَجَعَتْ قَطٌّ إلاَّ رَأتْكَ","كَأَنَّك فِيْ جَفْنِها حَاضِرُ",84,"ر",1,0],["وَلا هُو إِلا أَن تَجودي بِنَظرَةٍ","يُجَدِّدُ فيها عَهدَهُ المُتَقَدِّما",85,"م",2,0],["ولا هُو قَلبي يومَ لا يَنتَهي به","وِصالٌ إلى شُغلٍ وهَجرٌ إلى خَتلِ",86,"ل",1,0],["ولأهجرنَّ ربوعَها فلأنها","بلدٌ تضيق على الكرام رسومها",87,"م",3,0],["ولأهم اللهُ مَلْكاً من بني حسنٍ","نظيره في قديم الدَّهر لم يكنِ",88,"ن",1,0],["ولاّه أحمدُ عن أمرٍ أتاهُ بهِ","عن الإِله أمينُ الله جبرينُ",89,"ن",1,0],["ولاَه أحمدُ في الغديرِ ولايةً","أَضحتْ مطوَّقةً بها الأعناقُ",90,"ق",1,0],["ولأهل هذي الهجرتين من الأذى","من كل مبتدع وذي شأن",91,"ن",1,1],["ولا هل كان فيهم أشعري","ولا هل كان من ذي الاعتزال",92,"ل",1,0],["وَلا هُوَ عِندَ السُخطِ مِنهُ وَلا الرِضا","بِغَيرِ الَّذي يَرضى بِهِ لِيَ صانِعُ",93,"ع",1,0],["ولا هاجَتْ شجونك هاتفات","تُكَتَّم ما تكابد أو تذيع",94,"ع",1,0],["ولأهل العلوم شادوا تماثي","لا لاعظامها تخر الرؤوس",95,"س",1,0],["ولا هو منها حيث يُجمَعُ شاردٌ","ولا يُرتَجَى للعَودِ إن عاد فالتُ",96,"ت",1,0],["وَلا هوَ إِمّا عاتِبٌ كانَ قابِلاً","مِنَ الهائِمِ الصَبِّ الَّذي يَتَضَرَّعُ",97,"ع",1,0],["ولا هدوئي ممكناً بعدَما","أصبحَ مِن دونكمُ الفَدْفَدُ",98,"د",1,0],["ولا هزَّت لأخذ الثأر سمرٌ","ولا لمعت بجذبتها الصفاح",99,"ح",1,0],["ولاَ هَمَّ لي إلاَّ دُروسِي وفَهمُهَا","وتَثقيفُ عقلِي واغتِنامُ شَبابيَا",100,"ي",2,0],["ولا هَناك الّذي أتاك ولا","أمنتَ فيما جنيتَه النِّقَما",101,"م",2,0],["ولاه هو الأمثال تضرب للورى","ولم يدرها إلا المجانب للهو",102,"و",1,0],["ولا هو الله أنا حاشاي أن","أقول ذا في السر أو في العلن",103,"ن",1,0],["ولأهل الخصوص مني مقام","كل حال في ذاته يتفانى",104,"ن",2,0],["ولأهل الأرض طراً ولمن","بالتقى تحفظ منه الذمم",105,"م",1,0],["ولا هي حلت فيه إذ لم يكن لها","وجود سواه وهي منه لها قدر",106,"ر",1,0],["ولا هواء إلا وفيه","نفع كما ربنا يشاء",107,"ا",2,0],["ولاها فأولاها السرور أبو الندى","من النعمى بها واكف هما",108,"م",2,0],["ولاهم في نفير النا","س تلقاهم ولا العيرْ",109,"ر",1,0],["ولا هممت بشرب الماء من عطش","إلاّ وجدت خيالاً منك في الماء",110,"ا",1,0],["ولأهلهِ التاريخُ جدَّ مبشراً","قد صارَ ميخائيلُ في أُوج السَّما",111,"م",2,0],["وَلا هَز عَطفي للنَسيب أَهلةٌ","تَلوح عَلى أَغصانِها كَبدور",112,"ر",1,0],["ولا هبة ما إليك انتهى","ولا ما احتفظت به عاريه",113,"ي",2,0],["ولأهلك النجوى وأنت نزيلهم","ولمصر ما حمل البشير القادم",114,"م",1,0],["وَلا هَزَّني وَجداً مِنَ الغِيدِ غادَةٌ","يَزينها عِقدٌ كَما زانَها نَهدُ",115,"د",1,0],["وَلأَهلِ الفَضلِ بُرج وَسَما","لا تُضاهيها سَماء الخنَّسِ",116,"س",1,0],["وَلِأَهلِ العِشقِ شَرع","يَعلَمُ الوَلهان حُكمه",117,"م",2,0],["ولا هِي إلا أن تُرَى يومَ غارة","كؤود قَيدُومُها السرعان",118,"ن",1,0],["ولا هي إلا أن يقرب أرضها","تدافع وهم طيِّب الوشجان",118,"ن",1,0],["ولا هاجَ أشواقي وَوَجدي وَلَوعَتي","قُدُودُ غَوانٍ أو خدودٌ نواعِمُ",119,"م",1,0],["ولا هَنِئْتُ طعامي","ولا بمشرب مائي",120,"ا",2,0],["ولا هاجَ لي البرقُ اللموعُ صبابةً","يجدد لي تذكار سَلْع وحاجر",121,"ر",1,0],["ولاّه أمرَ المسلمينَ أولو التقى","فغدا لأهل الأرضِ أرشدَ مُرشد",122,"د",1,0],["ولا هُمْ على ما بهمْ شِيْعَةٌ","مُوَالونَ لابنِ أبي طالِبِ",123,"ب",1,0],["وَلا هَواءٍ صاعِدٍ","وَلا حَضيضٍ أَسفَلِ",124,"ل",1,0],["ولأهدينَّ إليك يا بكر العلى","والمجد أبكار الثناء صرائحا",125,"ح",2,0],["ولا هدمت صروف الدهر يوما","من الأيام مجدا أنت باني",126,"ن",2,0],["وَلاَ هُزِمَتْ لِلَّيْلِ فِي الغَرْبِ رَايَةٌ","وَلاَ قَام لِلإصْبَاحِ فِي الشَّرْقِ ثَائِرُ",127,"ر",1,0],["ولأهل الغري لما تجلت","تركوا ما لديهم من شقاق",128,"ق",1,0],["ولأهل الصفاء ما منهم الآن","خليل إذا دعوت يجيب",129,"ب",1,0],["ولأهلها قلقُ الغما","ئم تستبد بهن ريحُ",130,"ح",1,0],["وَلا هِيَ شَخص وَلا هِيَ روح","وَلا هِيَ يَقظى وَلا نائمه",131,"م",2,0],["وَلا هُوَ حي إِن طَلَبت حَقيقة","وَلا هُوَ مَيت مُسلم للنوائب",132,"ب",1,0],["وَلا هوَ مِن فرط النكال بِقائل","عَلى أَي ذَنب يا موالي أضرب",133,"ب",1,0],["ولا هماماً أخا بطشٍ يماثله","إذا لخوض المنايا جرد الهمما",134,"م",2,0],["ولأَهلُ الخُلْدِ في الخُلْ","دِ ولِلهِ البَقَاءُ",135,"ا",2,0],["ولأهل الكون انس","وسرور قد تجدد",136,"د",1,0],["ولأهل الاقبال وارد ذوقي","اطرب القوم منه داعي الفلاح",137,"ح",1,0],["ولأهل الاذواق معنى شريف","استفادوه من صفاء العقيده",138,"د",2,0],["ولا هو موعود بوصل وعطفة","ولا هو ممنون عليه فيعشق",139,"ق",1,0],["ولا هذه ولا تلكَ","فاين العهدُ بالصحبه",140,"ب",2,0],["ولأهل مملكتي بهول جرائمي","وبقدوتي يللظالم المفتون",141,"ن",1,0],["ولا هوى يعقب الأهوال تدفعه","ولا مراشد تأتيها وتحويها",142,"ي",3,0],["ولا هو يبدي لي عليَّ تغافُلاً","ولا هو يرثي لي ولا هو يعنُفُ",143,"ف",1,0],["ولا هوى خُلَّةٍ تُلِمُّ بها","ولا رضى فتنةٍ فتصحَبُها",144,"ب",3,0],["ولا هاشميًّا هاشماً أنفَ واترٍ","لدى يوم رَوع بالحسام المُهنّد