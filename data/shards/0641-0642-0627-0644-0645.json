https://www.aldiwan.net/poem47767.html","السريع"],[564,"شهدت حقيتي عظيم شاني","https://www.aldiwan.net/poem69263.html","الوافر"],[567,"لقد حل الأمين ضريح مجد","https://www.aldiwan.net/poem52620.html","الوافر"],[567,"قضى بالله لطف الله طفلا","https://www.aldiwan.net/poem52657.html","الوافر"],[567,"ثوى في اللحد أسقفنا المفدى","https://www.aldiwan.net/poem52685.html","الوافر"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66847","الوافر"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66777","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66766","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66734","السريع"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110472","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86714","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48630","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63937","المنسرح"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18493","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77587","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77632","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77506","البسيط"],[917,"","https://poetry.dctabudhabi.ae/diwan/poem/34516","البسيط"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59188","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72311","المنسرح"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111177","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64767","المجتث"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46513","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46519","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46522","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109153","البسيط"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104466","الرجز"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96038","البسيط"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88698","البسيط"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100117","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93637","الرجز"],[2480,"","https://poetry.dctabudhabi.ae/diwan/poem/138769",""],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58371","السريع"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99521","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112619","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112669","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112637","الرجز"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97937","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48428","البسيط"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26969","المجتث"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86338","البسيط"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101250","البسيط"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199024","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131033",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131023",""],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114630","الوافر"],[354,"","https://poetry.dctabudhabi.ae/diwan/poem/44074","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77179","الطويل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78340","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54493","الرجز"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28648","المجتث"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28644","البسيط"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/143311","البسيط"],[4626,"","https://poetry.dctabudhabi.ae/diwan/poem/102862","الطويل"],[4578,"ضريحٌ أحله مصباح فضلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49512",""],[4935,"قرانك يا خليل بدا مبارك","https://www.poetsgate.com/ViewPoem.aspx?id=129501",""],[5136,"فديت من رقت لما شفني","https://www.poetsgate.com/ViewPoem.aspx?id=121773",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5200,"أبصرته غدوة سطيحا","https://www.poetsgate.com/ViewPoem.aspx?id=200801",""],[5565,"وساحِرِ المقلتين تحسَبُه","https://www.poetsgate.com/ViewPoem.aspx?id=110220",""],[5691,"حمار الحطاب","https://www.poetsgate.com/ViewPoem.aspx?id=205825",""],[5703,"ستبقى أميراً","https://www.poetsgate.com/ViewPoem.aspx?id=214518",""]],"verses":[["فقالَ مَهِبطُ وَحيِ اللهِ مُبتَسِماً","وفي ابتِسامَتِهِ مَعنىً يُواسيها",0,"ي",3,0],["فَقَالَ مِنْهُمْ رَجُلٌ صَالِحٌ","ثَارَ بِهِ الشَّوْقُ وَجَدَّ الْغَرَامْ",1,"م",1,0],["فَقالَ مِنهُم رَشَأٌ أَنا أَنا","وَلَو دَرى مابِيَدي لَأَذعَنا",2,"ن",2,0],["فقال من خاصمتَ مستهلَكٌ","ليست على أمثالهِ عَدْوى",3,"و",2,0],["فقال ما زالت نجومُ الدجى","تهديك في غَوْرٍ وفي نجدِ",4,"د",1,0],["فقال مجيباً وهو في سكراته","له نخرات بينهن شهيق",5,"ق",1,0],["فَقالَ ما أَنتَ ذو جُنونٍ","وَإِنَّما أَنتَ ذو وَفاء",6,"ا",2,0],["فَقالَ مَقالاً لم أَجِد عَن مَقالِهِ","مَناباً وَعَن بَعضِ الأُمورِ سَحابُ",7,"ب",1,0],["فَقالَ ما تَرينَ فَالأَمرُ لَكِ","لِلمَوت أَمضى أَم لِعَبد المَلِكِ",8,"ك",1,0],["فَقالَ مَهلاً يا أَخا الأَحمالِ","وَيا طَويلَ الباعِ في الجِمالِ",9,"ل",1,0],["فَقالَ مَن في جُدودي","مِثلي عَديمُ الوَقارِ",10,"ر",1,0],["فَقالَ مَهلاً يا بَني الأَوطانِ","إِنَّ مَحَلّي لَلمَحَلُّ الثاني",11,"ي",1,0],["فَقالَ مَهلاً يا كَبيرَ النُهى","ما هَكَذا أَنظارُ أَهلِ الرَشاد",12,"د",1,0],["فَقالَ مَعَ ذا المَدحِ هَل أَنعُمٌ","بِضَيعَةٍ عامِرَةٍ أَو فِدانِ",13,"ن",1,0],["فقالَ ما قولُكَ في","حشيشةٍ منتَخَبَهْ",14,"ب",2,0],["فَقالَ مَضَوا وَاِستودَعوني بِلادَهُم","وَمَن ذا الَّذي يَبقى مَعَ الحَدَثانِ",15,"ن",1,0],["فقال معاذَ اللَّهِ لستُ بفاعلٍ","ومِثْلِيَ يأبَى ما تُريدُ ويأنَفُ",16,"ف",1,0],["فَقالَ مَهلاً تَبِعتُهُم أَبَداً","إِن نَزِلوا مَنزِلاً وَإِن رَحَلوا",17,"ل",3,0],["فقال ما حُكمُكَ يا سيدي","فإنني من بعدِ ها لا أعُود",18,"د",1,0],["فَقالَ مَن أَنتَ في رُفقٍ فَقُلتُ لَهُ","بَعضُ الكِرامِ وَلي في النَعتِ أَسماءُ",19,"ا",2,0],["فَقالَ مُدامٌ خِلطُ ماءِ سَحابَةٍ","قَرينَةُ أُمِّ الدَهرِ تِربَينِ في المَهدِ",20,"د",1,0],["فقالَ من أنت قلتُ القسّ زارَولا","به كديرِكَ من تشميس قسّيس",21,"س",1,0],["فقال ما أسمع قالت طه","فلم يصوّبها ولا خطّاها",22,"ه",2,0],["فَقالَ مَكاني حَيثُ جِئتَ بِجَنَّةٍ","مُذلَّلَةٍ مِنها القُطوفُ دَواني",23,"ن",2,0],["فقال ما ذا ترى في أمر ذى وَلَهٍ","أَقْوَى وأفقرَ مِن مال ومَاعُونِ",24,"ن",1,0],["فَقالَ مَوقفُ تاريخٍ بِهِ طَلَعَت","إِنَّ المَلائكَ في الفَردوسِ مَرتَعُها",25,"ع",3,0],["فَقالَ مُؤرِّخاً يا قَوم إِني","نَزَلتُ بعرشهِ وَأَنا البَشيرُ",26,"ر",1,0],["فَقالَ مِن مَنطِقِ التاريخِ صادِقُهُ","لِمثل هَذا نَعيمُ اللَهِ مَوعودُ",27,"د",1,0],["فقال من ذاتي أقول النهى","أنظم من شعري وأبياته",28,"ت",2,0],["فَقالَ ما قالَ في السبكيّ مِن سَفهٍ","قُبحاً لهُ مِن سفيهِ القول أكذبهِ",29,"ب",2,0],["فَقالَ مَولاهُ له اِشفع عبدي","فَحَملت بالسيّدِ المسعودِ",30,"د",1,0],["فقال محالٌ ما ادّعيتَ وإنما","قطفتَ بعينيك التورُّدَ من خدّي",31,"ي",1,0],["فقال منهم قائل هُجْرُها","في هَجْرِها لا يَبْسطُ العُذْرا",32,"ر",2,0],["فَقالَ مَن قاتِلُ ذا واهاً لَهُ","قُلتُ لَهُ القائِلُ مَن قاتِلُ ذا",33,"ذ",2,0],["فقال مُرني أَئتمِر","عَداك نحسٌ مُستَمِر",34,"ر",1,0],["فَقال مَولاها لها","أُشهِدُ أَربابَ النُهى",34,"ه",2,0],["فَقال ما لي صَدقَه","واِمرأَتي مُطَلَّقه",34,"ه",1,0],["فقال من قال قدي مثل غصن نقا","قلت النسيم الذي ما زال يعطفه",35,"ه",1,0],["فَقالَ مِن فورهِ اِبن الغوث مبتدراً","الشأنُ كونك إيّاه فأنت سمُ",36,"م",1,0],["فَقالَ مَن أَنتِ بِهِ","قُلتُ الشَهيدُ المُنتَظِر",37,"ر",1,0],["فقال ماذا فقلتُ هذا","يُرخى على الحُسنِ منه سِترُ",38,"ر",1,0],["فقال مهلاً كم فتى","فارقه لا يندب",39,"ب",1,0],["فقال من قد رآها حين أرّخها","دارٌ لسلمانَ قد فاقت بسلمان",40,"ن",1,0],["فقال مِن هُنا طلع","ن وغربن من هُنا",41,"ن",2,0],["فقال مُرتجلاً والدمعُ في صبَبٍ","من خشية اللّه والأنفاسُ في صَعَد",42,"د",1,0],["فَقالَ مَنِ الفَتى فَأَجَبتُ ضَيفٌ","تَسَربَلَ بِالمَكارِمِ وَالسَماحِ",43,"ح",1,0],["فَقالَ ما قَصَّرتَ في عِشقِهِ","يا أَحذَقَ الناسِ بِعِشقِ المِلاح",44,"ح",1,0],["فَقالَ ما قَصَّرَ هَذا الفَتى","لَكِنَّ هَذا الحَرفَ كَيفَ اِنتَصَب",45,"ب",1,0],["فقال ما لعبت أيدي النوى بهم","مثلي ولا كل من رق لعلياها",46,"ا",3,0],["فقال مُجِيبا بابتسَامةِ هازِئ","أمَا قد علمتُم أنها ليلةُ السَّبتِ",47,"ت",1,0],["فقالَ مُجِيبا قد ضَللتَ عن الهُدَى","هلِ المرءُ إلا فعلُه أيها الأغبَى",48,"ب",2,0],["فقال ما أبعدَ ما بيننا","ونازحٌ أمرُكَ من أمري",49,"ر",2,0],["فقالَ مُتَرْجِما عَنِّي لِسانِي","أنَا القُرآنُ والسَّبْعُ الْمَثانِي",50,"ي",1,0],["فقالَ مؤرِّخوهُ لقد تَلاقَى","إمامُ الحقِّ بالرُّوح الأمينِ",51,"ن",1,0],["فقالَ مؤرِّخاً كُفُّوا فإنِّي","حَصَلتُ على السّعادةِ مِن قريبِ",52,"ب",1,0],["فقالَ مؤرِّخاً أبكي فِراقاً","مَضَى الرَّاعي إلى الحَمَلِ الوَديعِ",53,"ع",1,0],["فقال من عادلها في فعله","فأنتم في سعة من قتله",54,"ه",1,0],["فقال ماذا أنتم تبغونا","قالوا نريد أن عرفونا",54,"ن",2,0],["فقالَ مخالفٌ منهم عُتُلّ","لأولاهم به قولاً خَفِيّا",55,"ي",2,0],["فقال مختبراً من ذا له أنَسٌ","فقال جاء عليٌّ جُدْ بفتحِكَ لي",56,"ل",2,0],["فقالَ ما بكَ قل لي يا أبا حسنٍ","اجلس فداك أبي يا مؤنسي فَكُلِ",56,"ل",1,0],["فقالَ من كنتُ له مولىً فذا","مَولاه رَبّي اشهدْ مِراراً قالَها",57,"ل",3,0],["فقال ما عندي سوى تمرةٍ","بكلّ دلوٍ غيرَ ما غادرِ",58,"ر",1,0],["فقال ما هذا الذي جئتَنا","به هداكَ اللهُ من زائرِ",58,"ر",1,0],["فَقالَ مَن بالدعَا والسعد أرخَها","تبقَى أليس بحفظِ الله باريها",59,"ه",2,0],["فَقالَ مَجدي عَنكَ في تاريخه","جَعفَر فَخري أَحب وَلَد",60,"د",1,0],["فقال من وبحد السيف بادرها","وليتها جاوبته قبلما ابتدرا",61,"ر",2,0],["فقال ما بيننا وبين سوى ال","بيرِ والبكشُ من عَوَّص",62,"ص",1,0],["فَقالَ مَعاذَ اللَهُ لَستُ بِهارِبٍ","أَأَهرُبُ إِن دَهرٌ بِنا حادَ عَن أَبي",63,"ب",2,0],["فَقالَ مَن أَنت وَمن ذا أَدخلك","وَمن إِلى مَملَكَتي قَد أَوصلَك",64,"ك",1,0],["فَقالَ ما لي هَكَذا وَدائي","قَد كَثرت بَينَ الوَرى أَعدائي",65,"ي",1,0],["فَقالَ مُذ رآهُمُ في نَفسِهِ","ما بَينَ شدقيهِ وَبَينَ ضرسِهِ",65,"ه",1,0],["فَقالَ ما ضَرّه ضيق وَلا صغر","سمُّ الخياط مَع الأَحباب ميدان",66,"ن",1,0],["فَقالَ ما حَلَّهُ شَمسٌ وَلا قَمَرٌ","لَكِن تَقَرَّبَ فيهِ اليَومَ قوريرُ",67,"ر",1,0],["فقال مملوك فقلت بل ملك","ان صح فيك يا جميل حزري",68,"ي",1,0],["فَقَالَ مَا بِالقِصَاصِ أقْضِي","فَقُلْت مَالِي بِذَاكَ مِنْ يَدْ",69,"د",1,0],["فقال محتشما زدت الشفاعة لي","فضن له المصطفى فانقاد مغتنما",70,"م",2,0],["فقال ما قاله هناك أبو سفيا","ن حتى رشوه بالجمل",71,"ل",1,0],["فقال ما تلكموا عدول","تجرح هذي وتلك تطعن",72,"ن",1,0],["فقالَ ما ذاكَ عُذْرٌ","لُذْ بالدِّماءِ مَلاذا",73,"ذ",2,0],["فَقالَ ما هَذا فَقالَت مقنب","مروا عَلَينا وَالرِّجال غيب",74,"ب",1,0],["فَقال من هَذي وَكَيفَ القصه","وَلم بِنا أَمثالها مُختَصه",75,"ه",1,0],["فَقالَ ما أَعجَب ما مَرَّ بِكا","وَشَر ما لَقيته مِن دَهركا",76,"ك",2,0],["فَقالَ ما أصنع قَد وَقَعت","وَكدت لَكِني ما انتفَعت",77,"ت",1,0],["فقال ما نحن ممن يطعمون هنا","زيدٌ لزيد وعباس لعباس",78,"س",1,0],["فقال ما عدتها الأفعال","وفيم تلك يعرف الجهال",79,"ل",1,0],["فقال من حين عليهم اقبلا","هذا علي منكم غير ابتلا",79,"ل",2,0],["فقال منتدب في اللَه محتسب","في اللَه معتصم بِاللَه ملتزم",80,"م",1,0],["فَقالَ من عادتي ان لا اجيب لها","ولست في ترك عاداتي بمعذور",81,"ر",1,0],["فَقال مَولايَ طبخ ليس تحسنه","اهلي وذاك قصور غير تقصير",81,"ر",1,0],["فقال من كنت مولاه وسيده","فحسبه من علي سيد وولي",82,"ل",2,0],["فَقالَ مَولاه الرضا","يا عَبد جئنا بِالعشا",83,"ش",2,0],["فقال مجيبا للسؤال ودمعه","كسيل جرى من شاهق وتحدرا",84,"ر",2,0],["فَقالَ منمْ غَيظٍ هلويابسي","لا وانكا كرَّبِسي قَهْبَه",85,"ب",2,0],["فقال من بعد حين قلت يا عجباً","من يضمن العمر لي يا بارد الحجج",86,"ج",1,0],["فقالَ مروانُ وأبدى غَدرَهُ","لا تقبلن من الحسين عذرَهُ",87,"ه",1,0],["فقالَ مُذ تكاثروا عليهِ","ومالَهُ من ناصِرٍ لَدَيهِ",88,"ه",1,0],["فقالَ ما تقولُ في عُثمانِ","والأمرُ لا يحتاجُ للبَيان",88,"ن",1,0],["فقال ما هذا الذي منك بدا","ولم أجِد أشجَعَ منكَ أحدا",89,"د",2,0],["فقال مالي من الاحسان سيدتي","لو كنت في رغبتي أخرجتها آها",90,"ا",3,0],["فقال ما لَكَ والشُهْبانَ ترْقُبُها","فقلتُ فيهنَّ منها خِلتُ أشباها",91,"ا",3,0],["فقال ما لَكَ والأطْلالَ تَنْشُدُها","فقلتُ هِمتُ بمغْناها لمَعْناها",91,"ا",3,0],["فقال منْ بحْرِهِ ألْقى بها دُرَراً","فقلْتُ أبْدَعَها نظْماً وأبْداها",91,"ا",3,0],["فَقالَ مَن قالَ هَذا","هَذا لِعَمرِيَ شاعِر",92,"ر",1,0],["فَقالَ مَهلاً أَبا مَغرور في طَلَبٍ","فَهل وِصال الظَبي تَرجى وَسائلهُ",93,"ا",3,0],["فقال من كنت مولاه وواليه","هذا علي له مولى وواليه",94,"ي",2,0],["فقال ما يروى من القريض","آدم قول الأسف المهيض",95,"ض",1,0],["فقال مولها لها","أشهد أرباب النهى",96,"ه",2,0],["فقال مه أي زانيه","وطيت ناراً أنيه",96,"ه",1,0],["فقال مالي بهذي الزهر من ارب","كل له في الهوى يا صاحبي خبر",97,"ر",1,0],["فقال ملكت القلب مني فاحرصي","عليه فقالت ان اردت فخذ قلبي",98,"ب",2,0],["فقال متى أراك أبا حسين","فقلت له اذا اتسخت ثيابى",99,"ب",2,0],["فَقالَ مَن أتى بِهِ","قُلتُ الشَهيدُ المُنتَظِر",100,"ر",1,0],["فقال منعماً حديد النظر","كفاك يا غلوكسٌ أن تفتري",101,"ي",1,0],["فقال من هكطور يخشاك إذا","حاذرت من سطوة أتريذ الأذى",101,"ذ",2,0],["فقال محتجّاً على قوله","أوذيس ذو الحكمة رب السداد",102,"د",1,0],["فقال من أنت من أي الأرومة يا","من ذكر حتف ابني المنتاب يبسط لي",103,"ي",1,0],["فَقالَ مَسيحي ثُمَّ في البَيتِ موسوي","بِتَسكين ياء النسبة القول يُزدَرى",104,"ر",2,0],["فَقال مَهلا وَلا تَغررك شَوكَتِهِم","فَالصَحو يَعقُبه سود الغَمامات",105,"ت",1,0],["فقال مَن قاتِلُه","قلتُ له قائلُ منْ",106,"ن",1,0],["فَقالَ ما تَمَّ شَيءٌ","يَنامُ عَنهُ رَقيبُك",107,"ك",1,0],["فَقال ما زِلتُ في لَيل وَفي لَثَقِ","وَفي أُمورٍ أَذاقَتني الرَّدى جُرَعا",108,"ع",2,0],["فقال مَن منهمُ جَفانا","واعتاضَ عنّا؟ فقلتُ: كُلُّ",109,"ل",1,0],["فقال مقالاً لم أجد عن مقاله","مناباً وعن بعض الأمور مناب",110,"ب",1,0],["فقال منظم التاريخ وافٍ","سنا مصباح مشكاة المعالي",111,"ل",2,0],["فقال محمد الحموي أرخ","قرانك يا خليل بدا مبارك",112,"ك",1,0],["فقال مولاتي حيتك بي","واشمتني قالت على ذكرها",113,"ر",3,0],["فقال من جلَّق من عند حاكمها","فقال ما الشأن قل لي عن مطاويها",114,"ي",3,0],["فقال ماذا [و] همّ لولا","مخافة الناس أن يصيحا",115,"ح",2,0],["فقال منّي إليك شيْمُ سَنا","يسوم ذا الشوقِ في الهوى عنَتا",116,"ت",2,0],["فقالَ : مولايَ ، إنَّ الجوَّ يخْبُرُني","بأنَّهُ جِدُّ صافٍ عبْر َمِرقابي",117,"ب",2,0],["فقال مبتسماً : قد كنتُ أعلم أنْ","ستمطرُ اليومَ حقاً غيرَ مرتابِ",117,"ب",1,0],["فقالَ من الحُبِّ والإشتياق","تموتُ المسافةُ ما بيننا...",118,"ن",2,0]]}