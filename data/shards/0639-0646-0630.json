{"poems":[[53,"رثت الأمانة للخيانة إذ رأت","https://www.aldiwan.net/poem66725.html","الكامل"],[31,"يا مي هلا يجازي بعض ودكم","https://www.aldiwan.net/poem6157.html","البسيط"],[87,"برز الثعلب يوماً","https://www.aldiwan.net/poem8033.html","مجزوء الرمل"],[45,"لا الحلم جاد به ولا بمثاله","https://www.aldiwan.net/poem9931.html","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30435","الخفيف"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116988","البسيط"],[382,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[529,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[566,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[572,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122812","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95514","الخفيف"],[1636,"","https://poetry.dctabudhabi.ae/diwan/poem/131361","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108516","البسيط"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20448","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129875","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76166","البسيط"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113874","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140089",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111042","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36515","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36378","الدوبيت"],[4139,"","https://poetry.dctabudhabi.ae/diwan/poem/198737","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73418","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139732",""],[4680,"نشوة الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=185094",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5528,"كيد النساء","https://www.poetsgate.com/ViewPoem.aspx?id=201194",""]],"verses":[["عن ذي الشهامة والصرامةِ والذي","ما عيبَ قطُّ بمذهب هَزْلِيِّ",0,"ل",2,0],["عن ذي المرارة والحلاوة والذي","لم يؤت من خُلق له مَقْلِيِّ",0,"ل",2,0],["عَن ذُبَّلِ اللَحمِ تَهديهِنَّ مُعجَلَةٌ","إِذا تَفَصَّدَ مِن أَقرابِها العَرَقُ",1,"ق",1,0],["عَن ذَوي التيجانِ مِمَّن","دَخَلَ البَطنَ اللَعينا",2,"ن",2,0],["عَن ذا الَّذي حُرِمَ اللُيوثُ كَمالَهُ","يُنسي الفَريسَةَ خَوفَهُ بِجَمالِهِ",3,"ل",2,0],["عَنَّ ذِكْرِي لمُدْلجِيهِمْ فتاهُوا","مِن حَدِيثِي في عُرْضِ أَمْرٍ عُجَابِ",4,"ب",1,0],["عن ذكرٍ قومٍ مضوا كانوا لنا سلفاً","وللنبي على الإسلام أعوانا",5,"ن",2,0],["عن ذلك الجسد الذي قد حزتَه","من مريمٍ وبه الأنام تُصان",6,"ن",1,0],["عَن ذمِّ مِثلِكَ تبياني أنزّهُهُ","إِذ أَنتَ عِندِيَ مَعدودٌ مِن النعمِ",7,"م",1,0],["عَن ذي حَيازيمَ ضَبَطرٍ لَو هَصَر","صَعبَ الفُيولِ ألحَمَ الفيلَ العَفَر",8,"ر",1,0],["عَنْ ذاكَ مندوحَةٌ لمُعْتَبِرِ","فَذُو النُّهَى جَمَّةٌ مَنَادِحُهْ",9,"ح",2,0],["عَن ذي المَنارِ وَذي نُواسَ","وَذي رُعَينَ وَذي يَزَن",10,"ن",1,0],["عن ذكاء وفطنة ومضاء","وعلاء وهمة مبذولَه",11,"ل",2,0],["عن ذاك فاعدل وزر من لم يزل وزرا","تمحو زيارته أوزرا زوّاره",12,"ر",2,0],["عن ذاته عزت المريخ ما أفلت","وبهجة الزهرة الزهراء لم تغب",13,"ب",1,0],["عَن ذاتِ أَولِيَةٍ أَساوُد رَيَّها","وَكَأَنَّ لَونَ المِلحِ فَوقَ شِفارِها",14,"ر",3,0],["عَن ذِي المَقَالَةِ مَع تَفَاقُمِ أمرِهَا","وَظُهُورِهَا فِي سَائِرِ الأديَانِ",15,"ن",1,0],["عن ذكرهِ لا حلتُ عنه لحظة","ومديحَهُ في كلّ حفلٍ أسرُدُ",16,"د",1,0],["عن ذينكَ الخَطَّينِ وَسطَ الدايرَه","وآحرِص عليها لِثَوابِ الآخرَه",17,"ه",1,0],["عَن ذَلِكَ المِنهاج","وَعَن هَوىً يا صاح",18,"ح",1,0],["عن ذلة في نظمها يا صاح","فاخلع عليها خلعة من ستر",19,"ر",1,0],["عن ذابح بلح لسعد سعودها","يروي حديثاً مسنداً عن صحة",20,"ه",1,0],["عن ذلك الكمين غافلين","فوثبوا وقتلوا الغرين",21,"ن",1,0],["عن ذاك لست مفندا","وأقول فيك مردداً",22,"د",2,0],["عَن ذِكرك لَم يَخلُ لِساني أَبَداً","عَن غيرك قَيَّدَ الهَوى أَلحاظي",23,"ي",1,0],["عَن ذِكرِك مَهما نَذَروا الصَومَ أَبى","إِمساكهُم عيدُ غَرامٍ عادا",24,"د",2,0],["عن ذلك البطلِ الذي امتدَّتْ به","حلوُ الرؤى من سالفِ الأجدادِ",25,"د",1,0],["عَن ذي جبينٍ بالبشاشةِ سافرٍ","طَلقِ الضِّياءِ لِكلِّ ذَنبٍ غَافِرِ",26,"ر",1,0],["عن ذاته في الجود يلهو والعدى","ألهتهُم الأنصابُ والأزلام",27,"م",1,0],["عن ذكرى أمسٍ غادرهُ","صفوٌ وبهاءٌ يسعدهُ",28,"د",2,0],["عن ذاك في مريم والأنبياء وفى","ص أتا ذاك بل في آل عمرانا",29,"ن",2,0],["عَنْ ذِكْرِهِنَّ مَجَالُ القَوْلِ مُتَّسِعٌ","فَلَسْنَ أهْلاً لإجْلاَلٍ وَتَقْدِيسِ",30,"س",1,0]]}