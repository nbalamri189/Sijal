{"poems":[[95,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[53,"ولحية سائلة منصبه","https://www.aldiwan.net/poem8291.html","الرجز"],[53,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[47,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[47,"يمزج خمرا بجنى ريقه","https://www.aldiwan.net/poem65194.html","السريع"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[50,"إنني أبصرت شخصا","https://www.aldiwan.net/poem62580.html","مجزوء الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[108,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179510",""],[53,"رأس أبي حفصٍ عظيم المَنْفعهْ","https://www.poetsgate.com/ViewPoem.aspx?id=29551",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[264,"شمس ذات الحبيب ليست تغيب","https://www.aldiwan.net/poem35768.html","الخفيف"],[264,"إن قلبي لديغ رقط الفراق","https://www.aldiwan.net/poem35937.html","الخفيف"],[309,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[376,"أحمد النازح المفارق أمره","https://www.aldiwan.net/poem57465.html","البسيط"],[409,"وعلى نظم وقفنا رائق","https://www.aldiwan.net/poem33596.html","الرمل"],[409,"غصن شوق علاه قلبي وغرد","https://www.aldiwan.net/poem33977.html","الخفيف"],[415,"أتهم فيكم لائمي وأنجدا","https://www.aldiwan.net/poem32486.html","الرجز"],[457,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[470,"عَثرَة ُ العُمر","https://www.aldiwan.net/poem36439.html","عموديه"],[505,"روحينا يا نسيمات الصبا","https://www.aldiwan.net/poem38091.html","الرمل"],[514,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[563,"من به قد تكاثرت أمراضي","https://www.aldiwan.net/poem34413.html","الخفيف"],[563,"عندنا سر عجيب خطرا","https://www.aldiwan.net/poem34522.html","الرمل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48547","الخفيف"],[841,"","https://poetry.dctabudhabi.ae/diwan/poem/199363","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37876","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62504","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62475","الخفيف"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75741","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55956","الرمل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46511","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109078","الخفيف"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79900","الخفيف"],[1611,"","https://poetry.dctabudhabi.ae/diwan/poem/106722","الرمل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127969","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110240","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109300","الرمل"],[2259,"","https://poetry.dctabudhabi.ae/diwan/poem/144722","الخفيف"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113029","الخفيف"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107007","الخفيف"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45698","السريع"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68665","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112626","الرجز"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97913","الخفيف"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118741","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91429","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111440","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111424","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86356","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139714",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52131","الرمل"],[4670,"","https://poetry.dctabudhabi.ae/diwan/poem/143600","الخفيف"],[4767,"لا تلمني","https://www.poetsgate.com/ViewPoem.aspx?id=178897",""],[4767,"فرحة المؤمنين","https://www.poetsgate.com/ViewPoem.aspx?id=179465",""],[5039,"المسامح كريم","https://www.poetsgate.com/ViewPoem.aspx?id=48114",""],[5150,"مقدمة للحب","https://www.poetsgate.com/ViewPoem.aspx?id=202787",""],[259,"ما لعيني لم تعني","https://www.poetsgate.com/ViewPoem.aspx?id=214199",""],[5414,"حوار مع منافق","https://www.poetsgate.com/ViewPoem.aspx?id=12929",""],[5596,"من وحي \"بون\"","https://www.poetsgate.com/ViewPoem.aspx?id=206482",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5961,"الدعاء في عرفات","https://www.poetsgate.com/ViewPoem.aspx?id=199815",""],[6004,"يا زماني","https://www.poetsgate.com/ViewPoem.aspx?id=33683",""],[6084,"زارني ليلا وقد نام الرقيب","https://www.poetsgate.com/ViewPoem.aspx?id=170819",""],[6262,"العائد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80128&r=&rc=26",""],[6292,"إلى إديت سودرجران","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6872&r=&rc=75",""]],"verses":[["ثُمَّ هَذَا وَصْفٌ بِهِ تُكْحَلُ العَيْنُ","أَتَى مِنْ أَخٍ كَتُومِ النَّوَالِ",0,"ل",1,0],["ثُمَّةَ يعلو رأسَهُ بضَرْبَهْ","يَشفي بها قلُوبنا وقلبَهْ",1,"ب",2,0],["ثم هجَّرْتَ في الهجِير وقد شُبْ","بَ على جَمرِهِ من الرضراض",2,"ض",1,0],["ثَمَّةَ حُجّابُكَ الجُفاةُ إِذا إِستَأ","ذَنتُ هَرّوا عَلَيَّ أَو قَطَبوا",3,"ب",3,0],["ثَمَّةَ يَسقيني دِراكاً وَقَد","صَوَّبَ نَجمٌ بَعدَ تَحليقِهِ",4,"ق",2,0],["ثُمَّةَ قُمنا وَالظَلامُ مُطرِقُ","وَالطَيرُ في أَوكارِها لا تَنطِقُ",5,"ق",1,0],["ثُمَّ هالوهُ بِسَيرٍ","لَيِّنٍ ما فيهِ عودُ",6,"د",1,0],["ثم هكْلٌ وبُخْنُرٌ وجِسَنْدي","ويليهم سبنْسرُ المشهور",7,"ر",1,0],["ثم هذا أبو دلامةَ منهم","بعده الراوندي ثم نصير",7,"ر",1,0],["ثم هذي الأرض الَّتي نحن نحيا","فَوقها خاضعين للأهواء",8,"ا",2,0],["ثم هوى أقمارها وأبعدوا","فحلفتْ بعدهمو لا تسعد",9,"د",1,0],["ثُمَّ هَبَّتْ حَوْلَها عاصِفَةٌ","خَلَطَ الذُّعْرُ ضُحاها بِمَساها",10,"ا",3,0],["ثم هَبَّت زَعازِعٌ تَرَكَتْها","بَيْنَ مُرِّ الأسَى وذُلِّ الهَوانِ",11,"ن",1,0],["ثم هنيئًا، يرعاك من شق عيني","ك، وأجرى بين العروق دماءك",12,"ك",1,0],["ثم هوتْ فيها يدٌ كالمِقْمَعه","بصفعة ٍ هائلة ٍ مشعشَه",13,"ع",3,0],["ثمَّ هاجَت خزاعةٌ بالمريسي","عِ فَأخزَت جُموعَها الهيجاءُ",14,"ا",2,0],["ثمّ هيموا بحضرة الذكر عمّا","قاله ذو الملام وهو مريب",15,"ب",1,0],["ثمّ همنا لمّا فهمنا رموزاً","معجزٌ دركُها نُهى الحذّاق",16,"ق",1,0],["ثم هذا المسير والعود منه","نحو ما قد سمعت أقصى المرام",17,"م",1,0],["ثم هامت به المعالي فصارت","تَتقي صدَّه وتحذرُ هجرَه",18,"ر",2,0],["ثم هذا مقتضى قولكم","في جواب راق مثل السلسل",19,"ل",1,0],["ثم هذا تحسر ليس أخبا","راً ولكن شواظ نار تَوقَّد",20,"د",1,0],["ثُمّ هَبَبْتُ لاَ بكَ الوجدُ الذي","حرّكهُ طيفهُمُ وجدّدَا",21,"د",2,0],["ثم هام المعتز بابن بُغاءٍ","عندما شام وجهه وعذارهْ",22,"ر",2,0],["ثُمَّ ها نَحنُ ، والعراقُ يُعاصي","وَدِماءُ المُقاوِمينَ تُلا لي",23,"ل",2,0],["ثمَّ هُبِّي برُبانا صَنْدَلاً","وانْشُري مِسكاً علينا طَيِّبَا",24,"ب",2,0],["ثُمَّ هالَت عَلَيهِ مِنها سِجالاً","مُكفَهِرّاً فَتَستَقيهِ سَجيلا",25,"ل",2,0],["ثم هيهات لا جسوم ولا أع","راض فيها فلتقض ما أنت قاضي",26,"ض",2,0],["ثم هذا كله قام بمن","هو منشيه علاً فاقتدرا",27,"ر",2,0],["ثم هل نفسك عن حالتها","غيرت إن هي أبدت أثرا",27,"ر",2,0],["ثم هم بعد على ما وصفوا","تفرقوا من بعده واختلفوا",28,"ف",3,0],["ثم هب المريد لا يجد العج","ل وعاد ابنه إليه وأنّبْ",29,"ب",1,0],["ثم هبنا قرير عين فمنا","كل عين من البكا مداء",30,"ا",2,0],["ثمّ هلّا يرَى بعينِ اِعتبارٍ","حادثاتِ الأيّام ثمَّ اللَّيالي",31,"ل",2,0],["ثمَّ هبّت عزَمات","منه للسير اهتماما",32,"م",2,0],["ثم هذي حشاشتي فتّشوها","تجدوا أنكم أصولُ بَلاها",33,"ا",3,0],["ثم هب عَلى اللَطيم عَقيماً","عاصِفاً ذارياً له فتالا",34,"ل",2,0],["ثم هنّْوا عزة المولى بما","جاءَ ه من كل طير معتبرْ",35,"ر",1,0],["ثَم هَجَمت في مَكاني جاثِماً","وَكُنتُ في ذاكَ الهُجوم حازِما",36,"م",2,0],["ثُم هَمَمت بِالجَواب ناصِراً","جنسي فَقَد ألزَمنا المعايرا",37,"ر",2,0],["ثم هاتيك وهي أشرف من برَّ","بعهد الهوى وأطهر من حب",38,"ب",1,0],["ثُمَّة جاءَ المَروَتَينِ فَسَعى","فَتارَةً يَبكِي وَيَدعو مَرَّةً",39,"ه",1,0],["ثمَّ هنُّوهُ وقالوا لا خبا","نورُ هذا الفرحِ المؤتلقِ",40,"ق",1,0],["ثم هب لي جناية الدهرِ يا من","لم يلد مثلَك الزمانُ وهوبا",41,"ب",2,0],["ثُمَّ هَذا القَصرُ فَاِسكُنهُ عَلى","حُسنِ حالٍ بِدوامِ المُلكِ لَك",42,"ك",1,0],["ثم هذى مدائح قد تجلت","بوداد لسيد من رقيق",43,"ق",1,0],["ثم هاجت دارُ الجحيمِ وماجَت","تقذفُ الرُّعبَ والقُلوبُ هَواء",44,"ا",2,0],["ثم هلل وكبر الله جهاراً","وعجا إذا علوت الجبالا",45,"ل",2,0],["ثم هموا بضربها فكان الأرض","مادت من هولِ ما أنا راءِ",46,"ا",2,0],["ثم هزت لي بعجب","ودلال منكبيها",47,"ي",3,0],["ثم هجنا للحرب إذ شبت الحر","ب ففزنا فيها بسبق الرهان",48,"ن",1,0],["ثم هجِّد بنا نقيل قليلاً","عند غمز الصَّهباء عود قناتك",49,"ك",1,0],["ثم هزت قوامها سمهريا","عن مضاه تندق سمر قناها",50,"ا",3,0],["ثُم هَرَبنا نَحوَ بُستانِهِ","خَوفاً مِن المَنية العازِمَه",51,"م",2,0],["ثُمَّ هَرَامِيزٍ مَعَ الأطوَاحِ","فَافعَل بِصُنعِ خَالِقي يَا صَاحِ",52,"ح",1,0],["ثم همّوا بقتله فوقاه ال","لَهُ بالرفع مشهداً لن يطيقه",53,"ق",2,0],["ثم هَوَت مغشَيّةً عليها","فقامَ جُلُّ صبرِهِ إليها",54,"ه",2,0],["ثم هيأت لي الجميل","وبي الذوق والبصر",55,"ر",1,0],["ثم هنا المحدث الشرابي","عبد الكريم رحلة الطلاب",56,"ب",1,0],["ثُمَّ هاكُم خَيرُ نُصح صُغتُهُ","مِن بَهِيِّ الدُر في هذي الجُمَل",57,"ل",1,0],["ثم ها نحن نبذنا بالعرا","وحرمنا انس ذاك الموكبِ",58,"ب",1,0],["ثم هاتوا وَروّعوني وَقولوا","وَاحكموا لَومَكم بِهِ لَو يَقيني",59,"ن",2,0],["ثُمَّ هيرا اِنبَعَثَت مُنحَدِرَه","مِن ذُرى الأولِمبِ كَالبَرقِ تَطير",60,"ر",1,0],["ثُمَّةَ عُنقَ فارِسَينِ ضَربا","وَاِستَلَبا مَركَبَةً قَد رَكِبا",61,"ب",2,0],["ثمة ما عتم أن عرجا","يعرج أوذيس إمام الحجا",62,"ج",2,0],["ثُمَّ هاجَ البَلا ورَجَّ المِجنَّا","هُوَ للنَّاسِ حُرمَةَ العَهدِ سَنَّا",63,"ن",2,0],["ثَمَّ هَكطُورُ قامَ يَنظِمُهُم بَي","نَ أَصيلٍ بِقَومهِ ودَخِيلِ",64,"ل",1,0],["ثم هز القنا وهكطور يغري","صحبه بالمقابس الناريه",65,"ه",1,0],["ثم هن الغر آل المصطفى","بأبي فضل وفرعٍ مورق",66,"ق",1,0],["ثم هنِّ الملا عموماً وخُصَّ ال","مصطفى مَن صفا اخاءاً وصافى",67,"ف",2,0],["ثم هذا ثم هذا ثُمَّ ثُمّ","فأجابته فنادها نعمْ",68,"م",1,0],["ثم هبّت رُويحةُ الفجر والكا","شحُ ناءٍ والعاذلاتُ رُقود",69,"د",1,0],["ثم هادي الأنامِ مِن بعد هادٍ","ناصعَ الْمَحتِدِ الإمامَ النقيا",70,"ي",2,0],["ثم هنوا آل طه","بابن زين العابدينا",71,"ن",2,0],["ثم هل التراب وصار فوقي رزيم","شبر ٍ أو دون ما تمراه غير النصايب",72,"ب",1,0],["«ثمةً» تبدو خيالاً","مثلَ طيفي حينَ ألمحْ",73,"ح",1,0],["«ثمةً» تجتازُ نحوي","بعبيرِ الشوقِ تنفحْ",73,"ح",1,0],["ثم هَبْني صرتُ أبغي","منك وعْداً بالتمني",74,"ن",2,0],["ثم هانت عليه نفس تمادت","فرأى في النفاق خيرَ طريق",75,"ق",1,0],["ثم هيما وأهيما معه","كل صب ساهرٍ في نصب",76,"ب",1,0],["ثم هبني سلوتُ صبح (سَلوتٍ)","كيف أنسى (الصبيحي) من سُكناها",77,"ا",3,0],["ثم هموا بالإياب نلتموا خير الثواب","ما عليكم من حساب فاقصدوا مزدلفات",78,"ت",1,0],["ثمّ هذاْ بَريقٌ دنا","ْكانَ كالْبدرِ في ليْلتي",79,"ت",2,0],["ثم هن أحمدا ذاك الذي","من أرى كل الثنا فيه يطيب",80,"ب",1,0],["ثمَّة مِرآة ٌغامضةٌ","تتراءى في ماءٍ شائبْ",81,"ب",1,0],["ثمَّة ما يشبهُ أحصنةً","من موجٍ وصهيلَ كواكبْ",81,"ب",1,0],["ثمَّة حُلْمٌ في وحشتِها","يصحو مندهشاً أو غاضبْ",81,"ب",1,0],["ثمةَ شاهدةٌ لغريبٍ","ونايٌ تصفّر فيه الرياح",82,"ح",1,0]]}