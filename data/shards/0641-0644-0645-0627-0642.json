{"poems":[[65,"أثرها فلا ماء أصابت ولا عشبا","https://www.aldiwan.net/poem46174.html","الطويل"],[79,"سقى دارهم هام من السحب هامع","https://www.aldiwan.net/poem35996.html","الطويل"],[79,"لمن طلل نائي المزار بعيده","https://www.aldiwan.net/poem36615.html","الطويل"],[24,"ما برح الرسم الذي بين حنجر","https://www.aldiwan.net/poem21860.html","الطويل"],[75,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[32,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[29,"عرفت الدار بعد بلى الخيام","https://www.aldiwan.net/poem5986.html","الوافر"],[29,"لمن طلل هاج الفؤاد المتيما","https://www.aldiwan.net/poem6019.html","الطويل"],[39,"كأم البيض تلحفه غدافا","https://www.aldiwan.net/poem7420.html","الوافر"],[39,"فلما قضى نحب من لا يخا","https://www.aldiwan.net/poem7438.html","المتقارب"],[74,"أحسن بها يا سيدي أنعما","https://www.aldiwan.net/poem18307.html","السريع"],[40,"على الدار بالرمانتين تعوج","https://www.aldiwan.net/poem7693.html","الطويل"],[40,"تبصر خليلي هل ترى من ظعائن","https://www.aldiwan.net/poem7707.html","الطويل"],[40,"ماذا ذكرتم من قلوص عقرتها","https://www.aldiwan.net/poem7710.html","الطويل"],[87,"عظيم الناس من يبكي العظاما","https://www.aldiwan.net/poem8092.html","الوافر"],[47,"ضمان على عينيك أني لا أسلو","https://www.aldiwan.net/poem65536.html","الطويل"],[99,"سألتك يا صخرة الملتقى","https://www.aldiwan.net/poem24403.html","المتقارب"],[50,"لنا خمر وليس بخمر نخل","https://www.aldiwan.net/poem62463.html","الوافر"],[50,"وأحور ذمي طرقت فنائه","https://www.aldiwan.net/poem63278.html","الطويل"],[50,"لا تبك للذاهبين في الظعن","https://www.aldiwan.net/poem65299.html","المنسرح"],[50,"لمن طلل لم أشجه وشجاني","https://www.aldiwan.net/poem66140.html","الطويل"],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[8,"ومولى جفت عنه الموالي كأنما","https://www.aldiwan.net/poem21767.html","الطويل"],[8,"تذكرت والذكرى تهيج للفتى","https://www.aldiwan.net/poem21786.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85390","الطويل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125640","المتقارب"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62224","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54895","الطويل"],[108,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[228,"أجيبيه أني ما أزال مقربا","https://www.aldiwan.net/poem41600.html","الطويل"],[234,"ومظهرة عقد هميانها","https://www.aldiwan.net/poem50757.html","المتقارب"],[261,"وذي همة في حضيض الكنيف","https://www.aldiwan.net/poem48566.html","المتقارب"],[285,"هو الرسم لو أغنى الوقوف على الرسم","https://www.aldiwan.net/poem60704.html","الطويل"],[285,"إذا عز نفسي عن هواك قصورها","https://www.aldiwan.net/poem60737.html","الطويل"],[325,"إلى الله شكرا آل مصر إليكم","https://www.aldiwan.net/poem67175.html","الطويل"],[371,"وأنزل بي بعض الأخلاء حاجة","https://www.aldiwan.net/poem17780.html","الطويل"],[445,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[469,"وقفت على قبر العزيز بن يوسف","https://www.aldiwan.net/poem3138.html","عموديه"],[475,"فلما قضاه الله لم يدع مسلما","https://www.aldiwan.net/poem4808.html","الطويل"],[520,"هي الصدمة الأولى فمن بان صبره","https://www.aldiwan.net/poem12130.html","الطويل"],[580,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66745","الطويل"],[710,"","https://poetry.dctabudhabi.ae/diwan/poem/104428","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63749","الخفيف"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96372","الوافر"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61117","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56597","المتقارب"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124458",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49993","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35738","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26420","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69406","الوافر"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177827","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27259","الطويل"],[2230,"","https://poetry.dctabudhabi.ae/diwan/poem/101791","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21465","الطويل"],[2376,"","https://poetry.dctabudhabi.ae/diwan/poem/115208","الوافر"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45586","الهزج"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205803","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103408","الطويل"],[3100,"","https://poetry.dctabudhabi.ae/diwan/poem/124294","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87448","الوافر"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71345","البسيط"],[3411,"","https://poetry.dctabudhabi.ae/diwan/poem/79761","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89317","الوافر"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/13","الوافر"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20560","الطويل"],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18724","الطويل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32487","الهزج"],[4045,"","https://poetry.dctabudhabi.ae/diwan/poem/34755","الهزج"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104517","المجتث"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72477","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4951,"كتمت هواك حتى عيل صبري","https://www.poetsgate.com/ViewPoem.aspx?id=105059",""],[5956,"تعالوا","https://www.poetsgate.com/ViewPoem.aspx?id=195019",""],[6097,"لأيًا بعدَ جيرةْ","https://www.poetsgate.com/ViewPoem.aspx?id=190694",""]],"verses":[["فلمّا قَضَتْ منهُ اللُّبانَةَ راجَعَتْ","طَلاها فألْفَتْهُ قَضى بَعْدَها نَحْبا",0,"ب",2,0],["فلمّا قضَيْتَ العيدَ سُنّةَ نحْرِهِ","وأُطعِمَ مُعْتَرُّ هُناك وقانِعُ",1,"ع",1,0],["فلمّا قَضَيْتَ النّحْرَ أقْبَلْتَ راضِياً","عنِ اللهِ تُعْلي ذِكْرَهُ وتُشيدُهُ",2,"د",2,0],["فَلَمّا قَضَينا مِن مِنىً كُلَّ حاجَةٍ","وَمَسَّحَ رُكنَ البَيتِ مَن هُوَ ماسِحُ",3,"ح",1,0],["فَلَمّا قَضَينا ما عَنانا أَداؤُهُ","وَكُلٌّ بِما يُرضيكَ داعٍ فَمُلحِفُ",4,"ف",1,0],["فَلَم أَقذِف لِمؤُمِنَةٍ حَصَانٍ","بِحَمدِ اللهِ موجِبِةً عضُالا",5,"ل",2,0],["فَلَمّا قَتَّلَ الشُعَراءَ غَمّاً","أَضَرَّ بِهِم وَأَمسَكَ بِالكِظامِ",6,"م",1,0],["فَلَمّا قَضى عَوفٌ أَشَطَّ عَلَيكُمُ","فَأَقسَمتُمُ لا تَفعَلونَ وَأَقسَما",7,"م",2,0],["فلما قيض عن حَتَك لصوق","بأزعر تحت أهدب كالخميل",8,"ل",1,0],["فلما قضى نحب من لا يخا","فه اقران ظهر ولم يفشلِ",9,"ل",1,1],["فلم أقلْ حين فشا عرْفها","من أين هذا النفَسُ الطيب",10,"ب",1,0],["فَلَمّا قَضَينَ الحاجَ أَزمَعنَ نِيَّةً","لِخَلجِ النَوى إِنَّ النَوى لَخَلوجُ",11,"ج",1,0],["فَلَمّا قَضَينا مِل أَحاديثِ سَلوَةً","وَخِفنا عُيونَ الكاشِحِ المُتَفَقِّدِ",12,"د",1,0],["فَلَمّا قَضَت مِن ذي الإِناءِ لُبانَةً","أَرادَت إِلَينا حاجَةً لا نُريدُها",13,"د",3,0],["فَلَمّا قُلتَ ما قَد قُلتَ عَنهُ","وَأَسمَعتَ المَمالِكَ وَالأَناما",14,"م",2,0],["فَلَمّا قَضَوا صَدرَ السِماطِ تَهافَتوا","عَلى يَدِ بَسّامٍ سَجِيَّتُهُ البَذلُ",15,"ل",1,0],["فلما قضى الحظُّ فكَّ الإِسار","حنَّ إلى أسره مطلقَا",16,"ق",2,0],["فَلَمّا قيلَ قَد بَلَغَت وَلَمّا","وَتوشِكُ أَن تُقَرُّ وَأَن تُواني",17,"ي",1,0],["فَلَمّا قيلَ قَد بَلَغَت كَشَفنا ال","عَمائِمَ عَن وُجوهٍ مُشرِقاتِ",17,"ت",1,0],["فَلَمّا قَرَعنا بابَهُ هَبَّ خائِفاً","وَبادَرَ نَحوَ البابِ مُمتَلِئً ذُعرا",18,"ر",2,0],["فَلَم أَقُل بَعدَما ظَفِرتُ بِهِ","يا لَيتَ ما كانَ مِنهُ لَم يَكُنِ",19,"ن",1,0],["فَلَمّا قَضَت نَفسي مِنَ السَيرِ ما قَضَت","عَلى ما بَلَت مِن شِدَّةٍ وَلَيانِ",20,"ن",1,0],["فَلَمّا قَضى مِمّا يُريدُ قَضاءَهُ","وَصَلَّبَها حِرصاً عَلَيها فَأَطوَلا",21,"ل",2,0],["فَلَمّا قَضى في الصُنعِ مِنهِنَّ فَهمَهُ","فَلَم يَبقَ إِلّا أَن تُسَنَّ وَتُصقَلا",21,"ل",2,0],["فلَمّا قَضَيتُم كُلَّ وِترٍ وَدِمنَةٍ","وَأَدرَكَكُم نَصرٌ مِن اللَهِ مُعجِبُ",22,"ب",1,0],["فَلَمّا قَرَعنا النّبعَ بِالنّبعِ بَعضَهُ","بِبَعضٍ أَبَت عِيدَانُهُ أَن تُكسَرا",23,"ر",2,0],["فلما قضى نحباً وَطارَ نعيُّهُ","إلى أبويه ضيَّعا الرشدَ من ذهل",24,"ل",1,0],["فلمّا قضى الحظ فك الأسير","حنَّ إلى أسره مطلقا",25,"ق",2,0],["فَلَمَّا قَلَّصَ الحَوْذَانُ عَنْهُ","وآلَ لَوِيُّهُ بَعْدَ المُتُوعِ",26,"ع",1,0],["فَلَمَّا قضَتْ دَالَ الظَّلامُ مِنَ السَّنَى","أَجَلْ دَالَ حِيناً لكِنِ النُّورُ يَثْأَرُ",27,"ر",1,0],["فلما قضيتَ بردِّ الحقوق","إلى أهلها، أجهَشُوا بالبُكاء",28,"ا",2,0],["فَلمّا قَطَرتُ الصِدقَ خُبثاً بِصَدرِهِ","قَطرتُ لَهُ في نَسلِهِ قَطرَةً أُخرى",29,"ر",2,0],["فلمّا قضت حَقَّ قُرْبانِها","وأدّت فريضةَ صُلْبانها",30,"ن",3,0],["فلما قعدت فسا فسوةً","فلم تخط عصفتها منخري",31,"ر",2,0],["فَلَمْ أَقْضِ إِبْلاً أَوْصَلَتْنِيهِ حَقَّها","وَلوْ عُفِّيَتْ مِنْها الْمَناسِمُ بِاللَّثْمِ",32,"م",1,0],["فَلَمّا قضَى التَّفْرِيقُ بِالْبُعْدِ بَيْنَنا","وَجَدْتُ اللَّيالِي كَانَ حُلْواً مَرِيرُها",33,"ر",3,0],["فَلَمّا قُضِيَ التَوفيقُ وَالأَمرُ قَد بَدا","وَطارَت بِهِ وَرقُ البَشائِرِ ساجِعَهُ",34,"ع",2,0],["فَلَمّا قَضاها اللَهُ عَرَّجَ شاكِراً","فَقُلتُ لَهُ بَل أَنتَ أَجدَرُ بِالشُكرِ",35,"ر",1,0],["فلما قَضَوْا بِكَ حقَّ السَّلامِ","ثَنَوْا لَكَ حقَّ سلامٍ مُعادِ",36,"د",1,0],["فلم أقضهِ حقَّ السماحة والندى","ولا حقَّ هاتيكَ البشاشةِ والقُربِ",37,"ب",1,0],["فَلَمّا قَضاهُ اللَهُ لَم يَدعُ مُسلِماً","لِبَيعَتِهِ إِلا أَجابَ وَسَلَّما",38,"م",2,1],["فلما قضى نحبي حياة ودولة","بأمرك في إدراكها ثم أمره",39,"ر",2,0],["فلم أَقُلْ فيه لاَ أَنَّ الصبابةَ لِي","يومَ الرَّحيلِ ولا أَنَّ المليحةَ بِي",40,"ب",2,0],["فلمّا قضى وحي النبيّ دعا له","ولم يكُ صلّى العصرَ والشمسُ تَنْزِعُ",41,"ع",1,0],["فلما قضت أوطارها بعدما دعت","إليك دعاها الاشتياق فشمرت",42,"ت",1,0],["فَلِما قَدْ عَلِمتَ من بُغْضِ تَشْرِي","نَ وَبُغْضِيهِ دونَ كلِّ الشهور",43,"ر",1,0],["فلما قامَ كبّرَ من يليها","وقالوا خالطَ الجملُ انكسارا",44,"ر",2,0],["فَلَما قَضينا ما نرجي ثَوابه","وَلَم يَبقَ بَعدَ الوَرد شَيء سِوى الصدر",45,"ر",1,0],["فلما قرأت الذي قلنهُ","غدوتُ بوادٍ وظني بواد",46,"د",1,0],["فلَمَّا قضينا نحبنا من شرابها","فقُلتُ ودمع العين يجري على النَّحر",47,"ر",1,0],["فلَمَّا قضى من حجّه واعتماره","مناسكَ يغشى موقفا ثمّ موقفا",48,"ف",2,0],["فَلَمّا قَضى النَحبَ العِراقيَّ عاجَها","إِلى نَحبِهِ بِالشامِ قَبَّ الخَواصِرِ",49,"ر",1,0],["فَلَمّا قَضَت حَقَّ العِراقِ وَأَهلِهِ","أَتاها مِنَ الريحِ الشَمالِ بَريدُها",50,"د",3,0],["فَلَمّا قابَلُوا حَلَباً وَحَلُّوا","بِأَخصَبِ ما يُحَلُّ مِنَ المَغاني",51,"ن",2,0],["فلما قضى منها هواك شجونه","دفعت إلى جمع بطائر يمنكا",52,"ك",2,0],["فلما قضيتُ الحج أعلنتُ مُنشداً","بسيري بين الجهر للذات والهمس",53,"س",1,0],["فلما قضى ارتدوا وصدوا عن الهدى","وهدوا على علم شريعته الغرا",54,"ر",2,0],["فَلمّا قَضينَ النُّسكَ مِن كُل مَشعَرٍ","خَرَجنَ عَجالى وَقعهنَّ رَشيقُ",55,"ق",1,0],["فلما قام سيف اللَه فيهم","زيادٌ قامَ أبلج مستنير",56,"ر",1,0],["فَلَم اِقتضك المَركب","إِلا بَعدَ اِحراج",57,"ج",1,0],["فلما قطعت اليوم حبل مودّتي","رجعت لنفسي فاحتملت نواك",58,"ك",1,0],["فلما قرأناهُنَّ سِرّاً طوينَها","حِذار الأعادي بازوِرار المناكبِ",59,"ب",1,0],["فلما قضت نحبا وعلّت ظماءها","حياض قتَيم واشمأزّ تواعس",60,"س",1,0],["فَلَمّا قابَل البَدرُ المُحَيّا","رَأَيتُ بعينها وَرأَت بعيني",61,"ي",1,0],["فَلَمْ أَقُلْ لِلصَّبَا مِنْ بَعْدِهَا احْتَمِلِي","لِلَمِّ شَخْصِي وَلاَ نَحْوَ الخِيَامِ عُجِي",62,"ج",2,0],["فلما قذفتَ الرعْبَ عنكَ لقيتَنا","بوجه كوجهِ الليثِ والليثُ ضائلُ",63,"ل",1,0],["فلم أقنع بضم الجسم منه","إذا ما الغير يقنع بالخيال",64,"ل",1,0],["فَلَمّا قَلَّصَت عَنهُ البَقايا","وَأَعوَزَ مِن مَراتِعِهِ اللَوِيّا",65,"ي",2,0],["فَلمّا قَضَينَ الشَدَّ مِن كُلِّ عُقدَةٍ","وَكانَت نَوى عُلويَّةً مِن نَواهُما",66,"م",2,0],["فَلَمّا قَضى أَصحابُنا كُلَّ حاجَةٍ","وَخَطَّ كِتاباً في المَدينَةِ ساطِرُ",67,"ر",1,0],["فَلَمّا قَدِمَ الحيرَ","ةَ حادي جَملي حارا",68,"ر",2,0],["فَلَمّا قالَ ذا كُنتُ","كَسَيفٍ هُزَّ فَاِهتَزّا",69,"ز",2,0],["فلم أقل ليت شعري","فيه ولا قلت لون",70,"ن",1,0],["فلم أقل استولى ولست مكلفا","بتأويله كلا ولم أقل احتوى",71,"و",2,0],["فَلَمّا قَضَينا النُسكَ مِن حَجَّة الهَوى","وَتَمَّت لَنا مِن حَيِّ لَيلى مَطامِعُ",72,"ع",1,0],["فَلَمّا قَبَضتُ الإِرثَ مِن مَخزَنِ الهَوى","تَناقَضَ عَن جُدرانِهِ فهوَ واقِعُ",72,"ع",1,0],["ف