{"poems":[[79,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[10,"كنا كغصنين في جرثومة بسقا","https://www.aldiwan.net/poem21094.html","البسيط"],[56,"تأسفت جارتي لما رأت زوري","https://www.aldiwan.net/poem27564.html","البسيط"],[53,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[31,"بنو أسد رجلان رجل تذبذبت","https://www.aldiwan.net/poem6071.html","الطويل"],[93,"هذي الوغى مشبوبة النيران","https://www.aldiwan.net/poem62764.html","عموديه"],[93,"لو أستطيع كتبت بالنيران","https://www.aldiwan.net/poem62773.html","عموديه"],[93,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[93,"كم بين طيات العصور الخاليه","https://www.aldiwan.net/poem62819.html","عموديه"],[87,"أجل وإن طال الزمان موافي","https://www.aldiwan.net/poem62840.html","الكامل"],[87,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[87,"في الموت ما أعيا وفي أسبابه","https://www.aldiwan.net/poem63779.html","الكامل"],[30,"أجندل لولا خلتان أناختا","https://www.aldiwan.net/poem5387.html","الطويل"],[68,"ما للجبال الراسيات تسير","https://www.aldiwan.net/poem40122.html","الكامل"],[89,"أترى الصبا خطرت بوادي المنحنى","https://www.aldiwan.net/poem8205.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[92,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[56,"تأسَّفَتْ جَارتي لمَّا رَأْتْ زَوَري","https://www.poetsgate.com/ViewPoem.aspx?id=14275",""],[93,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[93,"عصر الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=53398",""],[93,"ميامي فلوريدا","https://www.poetsgate.com/ViewPoem.aspx?id=53319",""],[111,"المجد لا يملك عن وراثة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66826&r=&rc=5",""],[93,"عصر الرشيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68002&r=&rc=278",""],[135,"حيوا تماضر واربعوا صحبي","https://www.aldiwan.net/poem24172.html","الكامل"],[240,"مولاي فخر الدين أنت إلى الندى","https://www.aldiwan.net/poem31588.html","الكامل"],[240,"يالك من ليل حجا","https://www.aldiwan.net/poem31597.html","مجزوء الرجز"],[240,"يا نائب الله في الأر","https://www.aldiwan.net/poem31745.html","المجتث"],[240,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[275,"أغنى التقى عن برقع وخباء","https://www.aldiwan.net/poem35588.html","الكامل"],[415,"إذا بكى باد ساكنها","https://www.aldiwan.net/poem31629.html","عموديه"],[415,"حمائم الأيك هيجتن أشجانا","https://www.aldiwan.net/poem31850.html","البسيط"],[469,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[484,"يا حادي الشوق يمم دار ماريانو","https://www.aldiwan.net/poem36918.html","البسيط"],[518,"أمولاي لم تبعد عليك مطالبي","https://www.aldiwan.net/poem67775.html","الطويل"],[556,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[556,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110447","البسيط"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100147","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96658","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202122",""],[1361,"","https://poetry.dctabudhabi.ae/diwan/poem/104407","السريع"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79591","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115955","الكامل"],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206242",""],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87835","الكامل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100464","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69424","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106844","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87763","البسيط"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105662","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137393",""],[2769,"","https://poetry.dctabudhabi.ae/diwan/poem/98163","المنسرح"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94304","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100346","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109817","الكامل"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107028","السريع"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100789","الكامل"],[3123,"","https://poetry.dctabudhabi.ae/diwan/poem/21157","الكامل"],[3170,"","https://poetry.dctabudhabi.ae/diwan/poem/115118","البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130043","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62825","الكامل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123916","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86280","البسيط"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118749","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36772","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131243",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131231",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131276",""],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125812","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125915","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119658","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119636","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119620","الكامل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105122","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28727","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117288","الكامل"],[4429,"","https://poetry.dctabudhabi.ae/diwan/poem/138862",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58084","الطويل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89600","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72457","المنسرح"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204298","البسيط"],[4978,"رد على قصيدة زُبر القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=177228",""],[585,"يا رائد القوم إن القوم أنضاء","https://www.poetsgate.com/ViewPoem.aspx?id=161878",""],[5121,"الأخيل","https://www.poetsgate.com/ViewPoem.aspx?id=34713",""],[5338,"دار النبي ومن بها ولد الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=187758",""],[5582,"أَخُنْسَ مَهاً أَمْ أَنْجُمٌ وَدَرارِ","https://www.poetsgate.com/ViewPoem.aspx?id=187012",""],[5582,"هذِي مَنازِلُهُمْ هَلْ أَنْتَ تُبصِرُها","https://www.poetsgate.com/ViewPoem.aspx?id=187141",""],[5691,"أسير الذئب","https://www.poetsgate.com/ViewPoem.aspx?id=205764",""],[5691,"ديار أهلها رحلوا...!","https://www.poetsgate.com/ViewPoem.aspx?id=206526",""],[5790,"أخنساء ما قلب المتيم من صخرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=111918",""],[6018,"أسمعت يامولاى دهري","https://www.poetsgate.com/ViewPoem.aspx?id=181198",""],[4442,"مآذن النجف اهتزت أعاليها","https://www.poetsgate.com/ViewPoem.aspx?id=171229",""]],"verses":[["أخْنى على آثارِهِمْ فأبادَهُمْ","فَلَكٌ يكرُّ عليْهِمُ دوّارُهُ",0,"ر",2,0],["أَخنى عَلى واحِدٍ رَيبُ الزَمانِ وَما","يُبقي الزَمانُ عَلى شَيءٍ وَلا يَذَرُ",1,"ر",1,0],["أَخنى الزَمانُ عَلى أَهلي فَصَدَّعَهُم","تَصَدُّعَ القَعبِ لاقى صَدمَةَ الحَجَرِ",2,"ر",1,0],["أخنَى على لِمَّتي ويُتبعُها","ديباجتي غيرَ مُنتهٍ كَلَبُهْ",3,"ب",2,0],["أَخَنجَرُ لَو كُنتُم قُرَيشاً شَبِعتُمُ","وَما هَلَكَت جوعاً بِلَغوى المَعاصِرُ",4,"ر",1,0],["أَخَنجَرُ قَد أَخزَيتَ قَومَكَ بِالَّتي","رَمَتكَ فُوَيقَ الحاجِبَينِ السَنابِرُ",4,"ر",1,0],["أَخنى عَلى الأَتراكِ دَهرٌ حُوَّلٌ","أَخنى عَلى اليونانِ وَالرومانِ",5,"ن",1,0],["أَخنى عَلى ذِكرِ الخَوَرنَقِ ذِكرُهُ","وَسَما عَلى الحَمراءِ وَالإِيانِ",6,"ن",1,0],["أَخَنتُ عَلى القَصرِ المَنيفِ فَلا","الجُدرانُ قائِمَةٌ وَلا العُمُدُ",7,"د",1,0],["أَخنَت عَلَيها الحادِثاتُ فَدورُها","خِرَبٌ تُعاوِدُها الرِياحُ السافِيَه",8,"ي",2,0],["أَخَنتَ عَلى الفَلَكِ المُدارِ فَلَم يَدُرِ","وَعَلى العُبابِ فَقَرَّ في الرَجّافِ",9,"ف",1,0],["أَخنى عَلَيها ما أَنا","خَ عَلى الخَوَرنَقِ وَالسَدير",10,"ر",1,0],["أَخنى الحِمامُ عَلى اِبنِ هِمَّةِ نَفسِهِ","في المَجدِ وَالباني عَلى أَحسابِهِ",11,"ب",2,0],["أَخِندِفُ أَم قَيسٌ إِذا ما اِلتَقى بِهِم","إِلى مَوقِفِ الهَديِ المَطِيُّ المُنَعَّلُ",12,"ل",1,0],["أَخَنَت عَلَينا الحَدِثاتُ بِرُزئِهِ","وَالرُزءُ بِالمَلِكِ الكَبيرِ كَبيرُ",13,"ر",1,0],["أَخْنَى عَلَيَّ مَعَ الزَّمَانِ وَلَيْتَهُ","لَمَّا أَسَاءَ الدَّهْرُ صُنْعَاً أَحْسَنَا",14,"ن",2,0],["أَخْنَى الزَّمَانُ عَلَى فُرْسَانِها فَغَدَتْ","مِنْ بَعْدِ مَنْعَتِهَا مَطْرُوقَةَ السُّبُلِ",15,"ل",1,0],["أخنى عليها المرزمان حقبة","وعاثت الشمأل فيها والصبا",16,"ا",1,0],["أخنَى بوحشتِه على جيرانِه","وهَفَا به ، رعباً ، فطارَ حَمام",17,"م",1,0],["أخنى الزَّمانُ على نادٍ \" زها \" زَمناً","بحافِظٍ واكتسى بالحُزنِ مغناه",18,"ا",2,0],["أخنى الزمانُ على أهلي فصدعهم","تَصدعَ الشَّعْبِ لاقَى صَدمة َ الحجرِ",19,"ر",1,0],["أخنى على ذكر ((الخورنق)) ذكره","وسما على ((الحمراء)) و((الإيوان))",20,"ن",1,0],["أخنت عليها ، فدروها","خرب تعاودها الرياح السّافية",21,"ي",2,0],["أخنى على الأتراك دهر حول","أخنى على يونان والرّومان",22,"ن",1,0],["أخنى عليها المرزمان حقبة","وعثت الشمأل فيها والصبا",23,"ا",1,0],["أخنت عليها النائبات، فدروها","خرب تعاودها الرياح السّافية",24,"ي",2,0],["أَخُناسُ قَد هامَ الفُؤادُ بِكُم","وَأَصابَهُ تَبَلٌ مِنَ الحُبِّ",25,"ب",1,0],["أَخنَت عَليهِ الحادِثاتُ وَأَفرَطَت","فيها الغَداةُ وَأَيَّما إِفراطِ",26,"ط",1,0],["أَخنَت عَلى أَيّامِها","أَيّامُ دَهرٍ غُدُرُ",27,"ر",1,0],["أَخنَت عَلَيهِ اللَيالي","وَعَزمُهُ لَم يَخُنهُ",28,"ن",2,0],["أَخنَت لَياليهِ عَلى رَبِّ غُم","دانَ وَأَودَت بِأَخي الخِضرِ",29,"ر",1,0],["أخنى الزمانُ على فَتاكِ وطالما","أخنى على الأحرارِ والشُّرَفاء",30,"ا",2,0],["أخنى الزمان على قومي وملك أو","طاني سواي فلا أهل ولا وطن",31,"ن",1,0],["أخْنَتْ على مَعشري الأدنَيْنَ فاصطَلَمَتْ","منهم كُهولاً وشُبّاناً ووِلدانا",32,"ن",2,0],["أخنتْ على لبدء ولقمانٍ وأوقعَ","صرفُها بربيعةٍ ولبيدِ",33,"د",1,0],["أخنى عليها الذي أخنى على لبد","فاستقدمتنا إلى الأطلال أشجان",34,"ن",1,0],["أخنتك كان العفو أولى بذي الهوى","أم أبلغت زوراً لم شفيت وشاني",35,"ي",1,0],["أَخْنى على إثْرائهمْ فأبادَهُ","جودٌ لَهم لا يَنثنِي وتكرُّمُ",36,"م",1,0],["أَخنَى الزّمان عليهمُ وسقاهُمُ","كأسَ الحِمامِ فما ترى من نابِسِ",37,"س",1,0],["أَخنى الزمانُ علَينا مثل عادتهِ","واغتال مَن هو ركنُ البيت والسَنَدُ",38,"د",1,0],["أخنى عليها فلم تألف مساكنها","إلا ندى الطل أو إلا صدى الطلل",39,"ل",1,0],["أخنّس مهى أَم أنجمٌ ودراري","حَوتهنَّ سفن في السراب جوارِ",40,"ر",1,1],["أخْنَى عليه زمانه","فغدا حَصيداً كل قائمْ",41,"م",1,0],["أخنى بعبد اللَه صرف الردى","وابتزنا القاسم من بعده",42,"د",2,0],["اخنى عليه الشهر والدهر","ومحسا محاسن وجهه الشعر",43,"ر",1,1],["أخنى عليهم ثم بدَّدَ شملَهُم","زمنٌ يُفرِّقُ تارةً ويُجمِّعُ",44,"ع",1,0],["آخن من در البكار المشاعيف","ومن قهوةٍ بالهيل صافي شرابها",45,"ب",3,0],["أَخنَت عَلَيها الحادِثاتُ فَمَزَّقَت","أَوصالَ آهِلِها بِنَهشِ قَنابِها",46,"ب",3,0],["أخنى على الشرف الرفيع به الردى","عمداً وأخرس للمعالي مقول",47,"ل",1,0],["أَخنَوا عَلى المالِ حَتّى ما يَعِيشُ لَهُم","ذَودٌ يُراحُ وَلا عَينُ وَا وَرِقُ",48,"ق",1,0],["أخنى الزمانُ على جسمي فَفَتَّتَه","سقماً وأَشرقني بالسائغ الخصر",49,"ر",1,0],["أَخَنت عَلَيهِ صُروف الدَهر فَاِنتَزَعَت","عَن جسمه مِن بُرود العزّ ما لَبِسا",50,"س",2,0],["أخنت على أفكارهم عاداتهم","جهلا فمالوا نحوها وانقادوا",51,"د",3,0],["أخنت عليه الليالي حسبما رغبت","حتى غدا المرامى قوسها هدفا",52,"ف",2,0],["اخنى على الدار فيه بالامس","ومن قبلها على لبد",53,"د",1,0],["أخنى على من سار أحسن سيرة","نفحاتها بالسر فيه أعلنت",54,"ت",1,0],["اخنى فرنَّق مشرباً","بالامس صفِّق بالرّحيق",55,"ق",1,0],["اخنى الزمان على فؤادي وهو لا","يشكو وما الشكوى لمن لا يرحم",56,"م",1,0],["أخنى عليها الدهر من بعدما","كانت لمن وافى حماها حمى",57,"م",2,0],["أخنى الحمام على أبر إمام","فكأَنه أخنى على الإسلام",58,"م",1,1],["أَخنى عَلى صَيفي بِحادِثِ صَرفِهِ","مُستَأثِراً بِجَذيمَةَ الوَضّاحِ",59,"ح",1,0],["أخن