{"poems":[[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[10,"كنا كغصنين في جرثومة بسقا","https://www.aldiwan.net/poem21094.html","البسيط"],[54,"تأسفت جارتي لما رأت زوري","https://www.aldiwan.net/poem27564.html","البسيط"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[29,"بنو أسد رجلان رجل تذبذبت","https://www.aldiwan.net/poem6071.html","الطويل"],[91,"هذي الوغى مشبوبة النيران","https://www.aldiwan.net/poem62764.html","عموديه"],[91,"لو أستطيع كتبت بالنيران","https://www.aldiwan.net/poem62773.html","عموديه"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[91,"كم بين طيات العصور الخاليه","https://www.aldiwan.net/poem62819.html","عموديه"],[85,"أجل وإن طال الزمان موافي","https://www.aldiwan.net/poem62840.html","الكامل"],[85,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[85,"في الموت ما أعيا وفي أسبابه","https://www.aldiwan.net/poem63779.html","الكامل"],[28,"أجندل لولا خلتان أناختا","https://www.aldiwan.net/poem5387.html","الطويل"],[66,"ما للجبال الراسيات تسير","https://www.aldiwan.net/poem40122.html","الكامل"],[87,"أترى الصبا خطرت بوادي المنحنى","https://www.aldiwan.net/poem8205.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[54,"تأسَّفَتْ جَارتي لمَّا رَأْتْ زَوَري","https://www.poetsgate.com/ViewPoem.aspx?id=14275",""],[91,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[91,"عصر الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=53398",""],[91,"ميامي فلوريدا","https://www.poetsgate.com/ViewPoem.aspx?id=53319",""],[91,"عصر الرشيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68002&r=&rc=278",""],[131,"حيوا تماضر واربعوا صحبي","https://www.aldiwan.net/poem24172.html","الكامل"],[235,"مولاي فخر الدين أنت إلى الندى","https://www.aldiwan.net/poem31588.html","الكامل"],[235,"يالك من ليل حجا","https://www.aldiwan.net/poem31597.html","مجزوء الرجز"],[235,"يا نائب الله في الأر","https://www.aldiwan.net/poem31745.html","المجتث"],[235,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[270,"أغنى التقى عن برقع وخباء","https://www.aldiwan.net/poem35588.html","الكامل"],[409,"إذا بكى باد ساكنها","https://www.aldiwan.net/poem31629.html","عموديه"],[409,"حمائم الأيك هيجتن أشجانا","https://www.aldiwan.net/poem31850.html","البسيط"],[464,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[479,"يا حادي الشوق يمم دار ماريانو","https://www.aldiwan.net/poem36918.html","البسيط"],[513,"أمولاي لم تبعد عليك مطالبي","https://www.aldiwan.net/poem67775.html","الطويل"],[551,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[551,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"]],"verses":[["أخْنى على آثارِهِمْ فأبادَهُمْ","فَلَكٌ يكرُّ عليْهِمُ دوّارُهُ",0,"ر",2,0],["أَخنى عَلى واحِدٍ رَيبُ الزَمانِ وَما","يُبقي الزَمانُ عَلى شَيءٍ وَلا يَذَرُ",1,"ر",1,0],["أَخنى الزَمانُ عَلى أَهلي فَصَدَّعَهُم","تَصَدُّعَ القَعبِ لاقى صَدمَةَ الحَجَرِ",2,"ر",1,0],["أخنَى على لِمَّتي ويُتبعُها","ديباجتي غيرَ مُنتهٍ كَلَبُهْ",3,"ب",2,0],["أَخَنجَرُ لَو كُنتُم قُرَيشاً شَبِعتُمُ","وَما هَلَكَت جوعاً بِلَغوى المَعاصِرُ",4,"ر",1,0],["أَخَنجَرُ قَد أَخزَيتَ قَومَكَ بِالَّتي","رَمَتكَ فُوَيقَ الحاجِبَينِ السَنابِرُ",4,"ر",1,0],["أَخنى عَلى الأَتراكِ دَهرٌ حُوَّلٌ","أَخنى عَلى اليونانِ وَالرومانِ",5,"ن",1,0],["أَخنى عَلى ذِكرِ الخَوَرنَقِ ذِكرُهُ","وَسَما عَلى الحَمراءِ وَالإِيانِ",6,"ن",1,0],["أَخَنتُ عَلى القَصرِ المَنيفِ فَلا","الجُدرانُ قائِمَةٌ وَلا العُمُدُ",7,"د",1,0],["أَخنَت عَلَيها الحادِثاتُ فَدورُها","خِرَبٌ تُعاوِدُها الرِياحُ السافِيَه",8,"ي",2,0],["أَخَنتَ عَلى الفَلَكِ المُدارِ فَلَم يَدُرِ","وَعَلى العُبابِ فَقَرَّ في الرَجّافِ",9,"ف",1,0],["أَخنى عَلَيها ما أَنا","خَ عَلى الخَوَرنَقِ وَالسَدير",10,"ر",1,0],["أَخنى الحِمامُ عَلى اِبنِ هِمَّةِ نَفسِهِ","في المَجدِ وَالباني عَلى أَحسابِهِ",11,"ب",2,0],["أَخِندِفُ أَم قَيسٌ إِذا ما اِلتَقى بِهِم","إِلى مَوقِفِ الهَديِ المَطِيُّ المُنَعَّلُ",12,"ل",1,0],["أَخَنَت عَلَينا الحَدِثاتُ بِرُزئِهِ","وَالرُزءُ بِالمَلِكِ الكَبيرِ كَبيرُ",13,"ر",1,0],["أَخْنَى عَلَيَّ مَعَ الزَّمَانِ وَلَيْتَهُ","لَمَّا أَسَاءَ الدَّهْرُ صُنْعَاً أَحْسَنَا",14,"ن",2,0],["أَخْنَى الزَّمَانُ عَلَى فُرْسَانِها فَغَدَتْ","مِنْ بَعْدِ مَنْعَتِهَا مَطْرُوقَةَ السُّبُلِ",15,"ل",1,0],["أخنَى بوحشتِه على جيرانِه","وهَفَا به ، رعباً ، فطارَ حَمام",16,"م",1,0],["أخنى الزَّمانُ على نادٍ \" زها \" زَمناً","بحافِظٍ واكتسى بالحُزنِ مغناه",17,"ا",2,0],["أخنى الزمانُ على أهلي فصدعهم","تَصدعَ الشَّعْبِ لاقَى صَدمة َ الحجرِ",18,"ر",1,0],["أخنى على ذكر ((الخورنق)) ذكره","وسما على ((الحمراء)) و((الإيوان))",19,"ن",1,0],["أخنت عليها ، فدروها","خرب تعاودها الرياح السّافية",20,"ي",2,0],["أخنى على الأتراك دهر حول","أخنى على يونان والرّومان",21,"ن",1,0],["أخنت عليها النائبات، فدروها","خرب تعاودها الرياح السّافية",22,"ي",2,0],["أَخُناسُ قَد هامَ الفُؤادُ بِكُم","وَأَصابَهُ تَبَلٌ مِنَ الحُبِّ",23,"ب",1,0],["أَخنَت عَليهِ الحادِثاتُ وَأَفرَطَت","فيها الغَداةُ وَأَيَّما إِفراطِ",24,"ط",1,0],["أَخنَت عَلى أَيّامِها","أَيّامُ دَهرٍ غُدُرُ",25,"ر",1,0],["أَخنَت عَلَيهِ اللَيالي","وَعَزمُهُ لَم يَخُنهُ",26,"ن",2,0],["أَخنَت لَياليهِ عَلى رَبِّ غُم","دانَ وَأَودَت بِأَخي الخِضرِ",27,"ر",1,0],["أخنى الزمانُ على فَتاكِ وطالما","أخنى على الأحرارِ والشُّرَفاء",28,"ا",2,0],["أخنى الزمان على قومي وملك أو","طاني سواي فلا أهل ولا وطن",29,"ن",1,0],["أخْنَتْ على مَعشري الأدنَيْنَ فاصطَلَمَتْ","منهم كُهولاً وشُبّاناً ووِلدانا",30,"ن",2,0],["أخنتْ على لبدء ولقمانٍ وأوقعَ","صرفُها بربيعةٍ ولبيدِ",31,"د",1,0],["أخنى عليها الذي أخنى على لبد","فاستقدمتنا إلى الأطلال أشجان",32,"ن",1,0],["أخنتك كان العفو أولى بذي الهوى","أم أبلغت زوراً لم شفيت وشاني",33,"ي",1,0],["أَخْنى على إثْرائهمْ فأبادَهُ","جودٌ لَهم لا يَنثنِي وتكرُّمُ",34,"م",1,0],["أَخنَى الزّمان عليهمُ وسقاهُمُ","كأسَ الحِمامِ فما ترى من نابِسِ",35,"س",1,0]]}