{"poems":[[55,"لعمرك ما جر ذيل الفخار","https://www.aldiwan.net/poem29861.html","المتقارب"],[49,"إذا كان منا واحد في قبيلة","https://www.aldiwan.net/poem25105.html","الطويل"],[23,"لمن منزل عاف كأن رسومه","https://www.aldiwan.net/poem21242.html","الطويل"],[74,"أفدي قمر","https://www.aldiwan.net/poem18700.html","منهوك الرجز"],[93,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[87,"سماؤك يا دنيا خداع سراب","https://www.aldiwan.net/poem62924.html","الطويل"],[47,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[30,"لعمرك ما في الأزد بالملك قائم","https://www.aldiwan.net/poem5392.html","الطويل"],[63,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[82,"شددت على صدر الزماع حزامي","https://www.aldiwan.net/poem31296.html","الطويل"],[33,"قرب جيراننا جمالهم","https://www.aldiwan.net/poem42239.html","المنسرح"],[77,"ألا أيها الوادي المقدس بالندى","https://www.aldiwan.net/poem69025.html","البسيط"],[52,"خليلي إن العسر سوف يفيق","https://www.aldiwan.net/poem62322.html","الطويل"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[30,"لعمرك ما في الأزد بالملك قائم","https://www.poetsgate.com/ViewPoem.aspx?id=21756",""],[173,"أمن دمنة بين اللوى والدكادك","https://www.aldiwan.net/poem1642.html",""],[173,"انزل لتلثم ذا الصعيد مقبلاً","https://www.aldiwan.net/poem1658.html",""],[203,"نصبت لي في الكرى حباله","https://www.aldiwan.net/poem45141.html","مخلع البسيط"],[203,"تغيرت الدنيا فهل هي زور","https://www.aldiwan.net/poem45156.html","الطويل"],[240,"هي الأيام صحتها سقام","https://www.aldiwan.net/poem31759.html","الوافر"],[240,"حتام مطلك يا ظلوم","https://www.aldiwan.net/poem31762.html","مجزوء الكامل"],[240,"أبثك مجد الدين حالا سماعها","https://www.aldiwan.net/poem32199.html","الطويل"],[276,"قفا برياض الشعب شعب القرنفل","https://www.aldiwan.net/poem52096.html","الطويل"],[280,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[280,"نفوس العالمين لك الفداء","https://www.aldiwan.net/poem25644.html","الوافر"],[287,"أومض البرق بعلياء منين","https://www.aldiwan.net/poem32401.html","الرمل"],[310,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[354,"عاب لما غاب عن مشهد قلبي","https://www.aldiwan.net/poem15517.html","الرمل"],[354,"وما ساءني جهل العمي برتبتي","https://www.aldiwan.net/poem15576.html","الطويل"],[376,"أرى في عراصي راكبا مترنما","https://www.aldiwan.net/poem57161.html","الطويل"],[445,"كذا ينتهي البدر المنير إلى الشمس","https://www.aldiwan.net/poem34773.html","الطويل"],[556,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[556,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122747","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120012","الوافر"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61174","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56296","السريع"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56098","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108715","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71071","الطويل"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20473","الوافر"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124058","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100346","الكامل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67583","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132695","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109929","البسيط"],[3707,"","https://poetry.dctabudhabi.ae/diwan/poem/124640","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206138","المتقارب"],[3777,"","https://poetry.dctabudhabi.ae/diwan/poem/145652","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131013",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102944","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70165","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101350","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127072","المتقارب"],[4862,"قبحاً لهم","https://www.poetsgate.com/ViewPoem.aspx?id=55626",""],[5122,"يا كويت","https://www.poetsgate.com/ViewPoem.aspx?id=25310",""],[2365,"ظربت وشاقتك البروق اللوامع","https://www.poetsgate.com/ViewPoem.aspx?id=200652",""],[5314,"رسول الله وانبثقت حياة","https://www.poetsgate.com/ViewPoem.aspx?id=214860",""],[5358,"عسى ألا غيابَ","https://www.poetsgate.com/ViewPoem.aspx?id=27544",""],[5431,"أنا الكُردي","https://www.poetsgate.com/ViewPoem.aspx?id=183030",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5818,"لاجئ","https://www.poetsgate.com/ViewPoem.aspx?id=196530",""],[5956,"لو أنّ الانسانَ","https://www.poetsgate.com/ViewPoem.aspx?id=184324",""],[6115,"ودك تبيع الهلايم وسط سوق الحراج","https://www.poetsgate.com/ViewPoem.aspx?id=196480",""]],"verses":[["وَلا ضَيرَ بَعدَ مَجيءِ الغَما","مِ إِن أَبطَأَ الوابِلُ الهاطِلُ",0,"ل",1,0],["وَلا ضُرِبَت بَينَ القِبابِ قِبابُهُ","وَأَصبَحَ مَأوى الطارِقينَ سِواها",1,"ا",3,0],["وَلا ضِقتُ ذَرعاً بِالهَوى إِذ ضَمِنتُهُ","وَلا كُظَّ صَدري بِالحَديثِ المُكَتَّمِ",2,"م",1,0],["وَلا ضَيفُنا عِندَ القِرى بِمُدَفَّعٍ","وَلا جارُنا في النائِباتِ بِمُسلَمِ",2,"م",1,0],["ولا ضرر","علمٌ مهر",3,"ر",1,0],["وَلا ضَعفي وَلا عَزمي","وَلا قُبحي وَلا حُسني",4,"ي",1,0],["وَلا ضَلَّ رَأيُ الناشِيءِ الغِرِّ في الصِبا","وَلا كَرَّ بَعدَ الفُرصَةِ المُتَصابي",5,"ب",2,0],["وَلا ضَرَّ أَرضاً جادَها جودُ كَفِّهِ","فَأَمرَعَها أَلّا يَصوبَ بِها القَطرُ",6,"ر",1,0],["وَلا ضَمَّها السُلطانُ قَسراً لِدَعوَةٍ","فَتَرضى بِهَذا الحِلفِ بَكرُ اِبنُ وايِلِ",7,"ل",1,0],["ولأَضْرِبَنَّكُما على ما خُنْتُما","بصوارمٍ للشِّعرِ غيرِ نَوَابِي",8,"ب",2,0],["ولا ضحكتْ منّي وهل ضحكتْ وما","وضعتُ على فَضّ الدموعِ ختامي",9,"م",2,0],["وَلا ضَنِنّا عَنهُم بِنائِلِنا","وَلا خَشينا الَّتي بِها وَقَعوا",10,"ع",3,0],["ولا ضيرَ في أن تحسدوا إن ذلكم","ليجمل في عليائكم ويليق",11,"ق",1,0],["وَلا ضاقَ فَضلُ اللَهِ عَن مُتَعَفِّفٍ","وَلَكِنَّ أَخلاقَ الرِجالِ تَضيقُ",12,"ق",1,0],["ولا ضبحت تعلو بأسباب وهمها","على غير ذي ثبت جداه القوارع",13,"ع",1,0],["وَلا ضَمّها السّلطانُ قَسْراً لدَعْوَةٍ،","فَتَرْضَى بهَذا الحِلْفِ بكرُ بنُ وَايلِ",14,"ل",1,0],["ولا ضارِعٍ طَوعَ المُنى يَستَفِزُّني","إِلى مُقرِفٍ رَجمُ الظُنونِ الأَوافِكِ",15,"ك",1,0],["وَلَأَضرِبَنَّ بِجُودِهِ الأَمثالَ كَي","يَشدُو بِها مَن شاءَ أَن يَتَمثّلا",16,"ل",2,0],["ولا ضوء بلا شبيه","إلا حبيبي تبسما",17,"م",2,0],["ولا ضحِكٌ في الارض الاَّ ابتسامة","لها القاضباتُ اللامعاتُ ثغورُ",18,"ر",1,0],["وَلا ضَحِكَ الثَرى مُذ بِنتِ عَنهِ","بِنُوّارٍ وَلا هَطَلَ الغَمامُ",19,"م",1,0],["وَلَأَضحَتِ الآدابُ في","ها وَهيَ سوقٌ لا تَقومُ",20,"م",1,0],["وَلا ضامَني دَهرٌ وَرَأيُكَ عُدَّتي","وَلا خابَ لي سَعيٌ وَأَنتَ رَجائي",21,"ي",1,0],["وَلا ضمت الاقطار مثل ابن هاشم","بحسن واحسان وَمجد مؤثل",22,"ل",1,0],["وَلا ضَار شَمساً أشْرَقَت منكر الضُّحى","وَلا جَحْدُ جافٍ لِلبُدورِ مِن الرُّمدِ",23,"د",1,0],["ولا ضَحِكتْ بُروقٌ في سحاب","لَها من عارض الشّكْوى بُكاء",24,"ا",2,0],["وَلأَضحَت وَهيَ في الدُنيا وَفي ال","دِينِ قُرباناً بِأَيدي المُجتَنين",25,"ن",1,0],["وَلا ضَحتِ المكارمُ عن ظلالٍ","لِدولتكَ الحقيق لها الخلودُ",26,"د",1,0],["وَلَأَضحى مِثلَ قَولي قائِلاً","رَبُّ ذَينِ الكَوكَبَينِ الحَقُّ رَبّي",27,"ب",2,0],["وَلا ضَرَّني شُربُ الحَميمِ لِمُنكَري","وَمِن سَلسَبيلِ الخُلدِ في الخُلدِ مَورِدي",28,"ي",1,0],["ولا ضَلَّ فاستَهدى ولا ذَلَّ فالتَجا","لكَي تَمنَعي مِنهُ الكميَّ المُصَمّما",29,"م",2,0],["ولا ضاعَتِ الأنسابُ بالغَدر والقِلى","ولا بِيعَتِ الأحسابُ بالثَّمَنِ البَخْسِ",30,"س",1,0],["ولا ضيمَ للجار المقيم ببابه","وإنْ كانتِ الأموالُ فيه تُضامُ",31,"م",1,0],["وَلا ضرَبتمْ ونَقْعُ الحَربِ مُلتبِسٌ","في فَيلقٍ كَزُهاءِ اللّيل جرّارِ",32,"ر",1,0],["وَلا ضَمّ بُردٌ مِثلَ عَيسَى وَال ارتَدَى","بِثَوبِ أبي يَحيَى فَصيحٌ وَأعجَمُ",33,"م",1,0],["ولا ضاقت على القصاد يوما","من الدنيا مغانيك الرحابُ",34,"ب",1,0],["وَلا ضارِبوه معتبوه وَإِن شَكا","فَفي ضَربه نَفع وَإِن كانَ يعتب",35,"ب",1,0],["ولا ضجيج الرعد ذاك الذي","يرجف منه القلب إذ يصعقُ",36,"ق",1,0],["ولا ضاء في العليا شهابٌ نظيره","وجوه البرايا فيه أضحت بواسما",37,"م",2,0],["ولا ضطرار أو لتمثيل وفي","تناسب ما كان ممنوعا يفي",38,"ي",1,0],["ولاضطرارٍ وتناسُبٍ وُضع","ذو المنعِ والممنوع قد لا يمتنع",39,"ع",1,0],["ولاضطرار ذيلها قد اختلس","كغيرها من الحروف فاقتبس",39,"س",1,0],["ولا ضمت الدنيا أميراً نظيره","كما ضمت الأصداف لؤلؤها البكرا",40,"ر",2,0],["ولا ضاق لولا كيدهم حوض سينها","ولا شرقت أرض العراق بمشرق",41,"ق",1,0],["ولا ضاقَ بي رَحْبُ الدِّيار ولا نَبَتْ","بحُبيّ حَجورٌ وَهْيَ فَيْحٌ فسائِحُ",42,"ح",1,0],["وَلا ضَيَّعتُهُ فَألام فيها","فَإِنَّ ضَياعَ مالِكَ غَيرُ مَعنِ",43,"ن",1,0],["ولا ضاء وجه الأرض الا بوجهه","ولا طاب إلا من شذاه ترابها",44,"ب",3,0],["ولأضربنَّ بقلَّصي","عن ذا الورى وذميل نوقي",45,"ق",2,0],["ولأضرِبَنَّ الهامَ دونَ حريمِهم","ضربَ القُدارِ نَقِيعةَ القُدامِ",46,"م",1,0],["ولا ضير في خطب على الحرّ انما","يهذب بالنار النضار ويسبك",47,"ك",1,0],["وَلاِضطِرَارٍ كَبَنَاتِ الأوبَرِ","كَذَا وَطِبتَ النَّفسَ يَا قَيسُ السُرِى",48,"ر",2,0],["وَلاِضطِرَارٍ رَخَّمُوا دُونَ نِدَا","مَا لِلنِّدَا يَصلُحُ نَحوُ أحمَدَا",48,"د",2,0],["وَلاِضطِرارٍ أو تَنَاسُبٍ صُرِف","ذُو المَنعِ وَالمَصرُوفُ قد لاَ يَنصَرِف",48,"ف",1,0],["وَلأَضربَنَّكُم بِصارِمٍ مِقوَلي","ضَرباً يزَعزِعُ أَنفُسَ الشَجعانِ",49,"ن",1,0],["ولا ضَحايا تُضحَّى عن مآثِمِهِم","من بعدِ ما قُدسُهُم مادت مَوائِدهُ",50,"د",2,0],["وَلاَ ضنَّ نُصحاً عَنك بالغَيبِ مُؤمِنٌ","تَقيٌّ وَلاَ عَادَاكَ إلاَّ مُنَافِقُ",51,"ق",1,0],["ولا ضير أنك حلو المذاق","شهي العناق سريُّ الحُلى",52,"ل",2,0],["ولا ضمّخت تضخ العبير وإن غدت","تؤخّره لوناً وتفضحه نشرا",53,"ر",2,0],["ولا ضاحكتنا الغيد ترنو باعين","سواج كما يرنو من العفر جؤذر",54,"ر",1,0],["ولا ضير إن قابلت بالمكر أهله","فغي يزاح الغي فيه هو الرشد",55,"د",1,0],["وَلا ضيعتُ ما قَد ضا","عَ مِن زيدٍ وَمِن عمرو",56,"ر",2,0],["ولا ضحاكم له نور فنعرفه","لكنه غشوة فيها الأباطيل",57,"ل",1,0],["ولا ضير للمنتأي والقريب","لقد طالعتنا بأمر عجيب",58,"ب",1,0],["ولأضربن وجوه قوم قد خلت","من حسنها وتعفرت بترابِ",59,"ب",1,0],["ولاضيع فنونها وأخلف روايعها","واثر على شكلها الظاهر والاوزاني",60,"ن",2,0],["ولا ضرعت نفسي لشيء أناله","وبعض الرّجال خاشع متضارع",61,"ع",1,0],["وَلاَ ضَيْمٌ يُعَاشُ وَلَا سَبَايَا","بِحَرْبٍ لِلْجُحُودِ تُثِيرُ حَرْبَا",62,"ب",2,0],["ولا ضاقَ المَضِيفُ ولا تَلاشى","ولا طالَ الوَجِيفُ ولا النِّزالُ",63,"ل",1,0],["ولاضيرَ إذا صِرنا","لحكمٍ واحدٍ يجمعْ",64,"ع",1,0],["ولا ضعف النفس العزيزه الجارته","ولاهروولت للمحصنات إخطاه",65,"ا",2,0],["ولا ضجّ الفؤاد وبحّ صوتي","وخلّيت البلاد ولا ذرفت",66,"ت",1,0],["ولَأضْحَى إنساناً فَرِحاً","لا يشكو جوعاً أو عِلَلا",67,"ل",2,0],["ولاّ ضعاف الروابع يشبهون النعاج","لوكان من غالي الاعلاف سمنتها",68,"ت",3,0]]}