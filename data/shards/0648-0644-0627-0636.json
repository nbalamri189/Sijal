{"poems":[[53,"لعمرك ما جر ذيل الفخار","https://www.aldiwan.net/poem29861.html","المتقارب"],[47,"إذا كان منا واحد في قبيلة","https://www.aldiwan.net/poem25105.html","الطويل"],[23,"لمن منزل عاف كأن رسومه","https://www.aldiwan.net/poem21242.html","الطويل"],[72,"أفدي قمر","https://www.aldiwan.net/poem18700.html","منهوك الرجز"],[91,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[85,"سماؤك يا دنيا خداع سراب","https://www.aldiwan.net/poem62924.html","الطويل"],[45,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[28,"لعمرك ما في الأزد بالملك قائم","https://www.aldiwan.net/poem5392.html","الطويل"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[80,"شددت على صدر الزماع حزامي","https://www.aldiwan.net/poem31296.html","الطويل"],[31,"قرب جيراننا جمالهم","https://www.aldiwan.net/poem42239.html","المنسرح"],[75,"ألا أيها الوادي المقدس بالندى","https://www.aldiwan.net/poem69025.html","البسيط"],[50,"خليلي إن العسر سوف يفيق","https://www.aldiwan.net/poem62322.html","الطويل"],[28,"لعمرك ما في الأزد بالملك قائم","https://www.poetsgate.com/ViewPoem.aspx?id=21756",""],[167,"أمن دمنة بين اللوى والدكادك","https://www.aldiwan.net/poem1642.html",""],[167,"انزل لتلثم ذا الصعيد مقبلاً","https://www.aldiwan.net/poem1658.html",""],[197,"نصبت لي في الكرى حباله","https://www.aldiwan.net/poem45141.html","مخلع البسيط"],[197,"تغيرت الدنيا فهل هي زور","https://www.aldiwan.net/poem45156.html","الطويل"],[233,"هي الأيام صحتها سقام","https://www.aldiwan.net/poem31759.html","الوافر"],[233,"حتام مطلك يا ظلوم","https://www.aldiwan.net/poem31762.html","مجزوء الكامل"],[233,"أبثك مجد الدين حالا سماعها","https://www.aldiwan.net/poem32199.html","الطويل"],[269,"قفا برياض الشعب شعب القرنفل","https://www.aldiwan.net/poem52096.html","الطويل"],[273,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[273,"نفوس العالمين لك الفداء","https://www.aldiwan.net/poem25644.html","الوافر"],[280,"أومض البرق بعلياء منين","https://www.aldiwan.net/poem32401.html","الرمل"],[303,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[347,"عاب لما غاب عن مشهد قلبي","https://www.aldiwan.net/poem15517.html","الرمل"],[347,"وما ساءني جهل العمي برتبتي","https://www.aldiwan.net/poem15576.html","الطويل"],[369,"أرى في عراصي راكبا مترنما","https://www.aldiwan.net/poem57161.html","الطويل"],[436,"كذا ينتهي البدر المنير إلى الشمس","https://www.aldiwan.net/poem34773.html","الطويل"],[549,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[549,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"]],"verses":[["وَلا ضَيرَ بَعدَ مَجيءِ الغَما","مِ إِن أَبطَأَ الوابِلُ الهاطِلُ",0,"ل",1,0],["وَلا ضُرِبَت بَينَ القِبابِ قِبابُهُ","وَأَصبَحَ مَأوى الطارِقينَ سِواها",1,"ا",3,0],["وَلا ضِقتُ ذَرعاً بِالهَوى إِذ ضَمِنتُهُ","وَلا كُظَّ صَدري بِالحَديثِ المُكَتَّمِ",2,"م",1,0],["وَلا ضَيفُنا عِندَ القِرى بِمُدَفَّعٍ","وَلا جارُنا في النائِباتِ بِمُسلَمِ",2,"م",1,0],["ولا ضرر","علمٌ مهر",3,"ر",1,0],["وَلا ضَعفي وَلا عَزمي","وَلا قُبحي وَلا حُسني",4,"ي",1,0],["وَلا ضَلَّ رَأيُ الناشِيءِ الغِرِّ في الصِبا","وَلا كَرَّ بَعدَ الفُرصَةِ المُتَصابي",5,"ب",2,0],["وَلا ضَرَّ أَرضاً جادَها جودُ كَفِّهِ","فَأَمرَعَها أَلّا يَصوبَ بِها القَطرُ",6,"ر",1,0],["وَلا ضَمَّها السُلطانُ قَسراً لِدَعوَةٍ","فَتَرضى بِهَذا الحِلفِ بَكرُ اِبنُ وايِلِ",7,"ل",1,0],["ولأَضْرِبَنَّكُما على ما خُنْتُما","بصوارمٍ للشِّعرِ غيرِ نَوَابِي",8,"ب",2,0],["ولا ضحكتْ منّي وهل ضحكتْ وما","وضعتُ على فَضّ الدموعِ ختامي",9,"ي",1,0],["وَلا ضَنِنّا عَنهُم بِنائِلِنا","وَلا خَشينا الَّتي بِها وَقَعوا",10,"ع",3,0],["ولا ضيرَ في أن تحسدوا إن ذلكم","ليجمل في عليائكم ويليق",11,"ق",1,0],["وَلا ضاقَ فَضلُ اللَهِ عَن مُتَعَفِّفٍ","وَلَكِنَّ أَخلاقَ الرِجالِ تَضيقُ",12,"ق",1,0],["وَلا ضَمّها السّلطانُ قَسْراً لدَعْوَةٍ،","فَتَرْضَى بهَذا الحِلْفِ بكرُ بنُ وَايلِ",13,"ل",1,0],["ولا ضارِعٍ طَوعَ المُنى يَستَفِزُّني","إِلى مُقرِفٍ رَجمُ الظُنونِ الأَوافِكِ",14,"ك",1,0],["وَلَأَضرِبَنَّ بِجُودِهِ الأَمثالَ كَي","يَشدُو بِها مَن شاءَ أَن يَتَمثّلا",15,"ل",2,0],["ولا ضوء بلا شبيه","إلا حبيبي تبسما",16,"م",2,0],["ولا ضحِكٌ في الارض الاَّ ابتسامة","لها القاضباتُ اللامعاتُ ثغورُ",17,"ر",1,0],["وَلا ضَحِكَ الثَرى مُذ بِنتِ عَنهِ","بِنُوّارٍ وَلا هَطَلَ الغَمامُ",18,"م",1,0],["وَلَأَضحَتِ الآدابُ في","ها وَهيَ سوقٌ لا تَقومُ",19,"م",1,0],["وَلا ضامَني دَهرٌ وَرَأيُكَ عُدَّتي","وَلا خابَ لي سَعيٌ وَأَنتَ رَجائي",20,"ي",1,0],["وَلا ضمت الاقطار مثل ابن هاشم","بحسن واحسان وَمجد مؤثل",21,"ل",1,0],["وَلا ضَار شَمساً أشْرَقَت منكر الضُّحى","وَلا جَحْدُ جافٍ لِلبُدورِ مِن الرُّمدِ",22,"د",1,0],["ولا ضَحِكتْ بُروقٌ في سحاب","لَها من عارض الشّكْوى بُكاء",23,"ا",2,0],["وَلأَضحَت وَهيَ في الدُنيا وَفي ال","دِينِ قُرباناً بِأَيدي المُجتَنين",24,"ن",1,0],["وَلا ضَحتِ المكارمُ عن ظلالٍ","لِدولتكَ الحقيق لها الخلودُ",25,"د",1,0],["وَلَأَضحى مِثلَ قَولي قائِلاً","رَبُّ ذَينِ الكَوكَبَينِ الحَقُّ رَبّي",26,"ب",2,0],["وَلا ضَرَّني شُربُ الحَميمِ لِمُنكَري","وَمِن سَلسَبيلِ الخُلدِ في الخُلدِ مَورِدي",27,"ي",1,0],["ولا ضَلَّ فاستَهدى ولا ذَلَّ فالتَجا","لكَي تَمنَعي مِنهُ الكميَّ المُصَمّما",28,"م",2,0],["ولا ضاعَتِ الأنسابُ بالغَدر والقِلى","ولا بِيعَتِ الأحسابُ بالثَّمَنِ البَخْسِ",29,"س",1,0],["ولا ضيمَ للجار المقيم ببابه","وإنْ كانتِ الأموالُ فيه تُضامُ",30,"م",1,0],["وَلا ضرَبتمْ ونَقْعُ الحَربِ مُلتبِسٌ","في فَيلقٍ كَزُهاءِ اللّيل جرّارِ",31,"ر",1,0]]}