{"poems":[[53,"لعمرك ما جر ذيل الفخار","https://www.aldiwan.net/poem29861.html","المتقارب"],[47,"إذا كان منا واحد في قبيلة","https://www.aldiwan.net/poem25105.html","الطويل"],[23,"لمن منزل عاف كأن رسومه","https://www.aldiwan.net/poem21242.html","الطويل"],[72,"أفدي قمر","https://www.aldiwan.net/poem18700.html","منهوك الرجز"],[91,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[85,"سماؤك يا دنيا خداع سراب","https://www.aldiwan.net/poem62924.html","الطويل"],[45,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[28,"لعمرك ما في الأزد بالملك قائم","https://www.aldiwan.net/poem5392.html","الطويل"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[80,"شددت على صدر الزماع حزامي","https://www.aldiwan.net/poem31296.html","الطويل"],[31,"قرب جيراننا جمالهم","https://www.aldiwan.net/poem42239.html","المنسرح"],[75,"ألا أيها الوادي المقدس بالندى","https://www.aldiwan.net/poem69025.html","البسيط"],[50,"خليلي إن العسر سوف يفيق","https://www.aldiwan.net/poem62322.html","الطويل"],[28,"لعمرك ما في الأزد بالملك قائم","https://www.poetsgate.com/ViewPoem.aspx?id=21756",""]],"verses":[["وَلا ضَيرَ بَعدَ مَجيءِ الغَما","مِ إِن أَبطَأَ الوابِلُ الهاطِلُ",0,"ل",1,0],["وَلا ضُرِبَت بَينَ القِبابِ قِبابُهُ","وَأَصبَحَ مَأوى الطارِقينَ سِواها",1,"ا",3,0],["وَلا ضِقتُ ذَرعاً بِالهَوى إِذ ضَمِنتُهُ","وَلا كُظَّ صَدري بِالحَديثِ المُكَتَّمِ",2,"م",1,0],["وَلا ضَيفُنا عِندَ القِرى بِمُدَفَّعٍ","وَلا جارُنا في النائِباتِ بِمُسلَمِ",2,"م",1,0],["ولا ضرر","علمٌ مهر",3,"ر",1,0],["وَلا ضَعفي وَلا عَزمي","وَلا قُبحي وَلا حُسني",4,"ي",1,0],["وَلا ضَلَّ رَأيُ الناشِيءِ الغِرِّ في الصِبا","وَلا كَرَّ بَعدَ الفُرصَةِ المُتَصابي",5,"ب",2,0],["وَلا ضَرَّ أَرضاً جادَها جودُ كَفِّهِ","فَأَمرَعَها أَلّا يَصوبَ بِها القَطرُ",6,"ر",1,0],["وَلا ضَمَّها السُلطانُ قَسراً لِدَعوَةٍ","فَتَرضى بِهَذا الحِلفِ بَكرُ اِبنُ وايِلِ",7,"ل",1,0],["ولأَضْرِبَنَّكُما على ما خُنْتُما","بصوارمٍ للشِّعرِ غيرِ نَوَابِي",8,"ب",2,0],["ولا ضحكتْ منّي وهل ضحكتْ وما","وضعتُ على فَضّ الدموعِ ختامي",9,"ي",1,0],["وَلا ضَنِنّا عَنهُم بِنائِلِنا","وَلا خَشينا الَّتي بِها وَقَعوا",10,"ع",3,0],["ولا ضيرَ في أن تحسدوا إن ذلكم","ليجمل في عليائكم ويليق",11,"ق",1,0],["وَلا ضاقَ فَضلُ اللَهِ عَن مُتَعَفِّفٍ","وَلَكِنَّ أَخلاقَ الرِجالِ تَضيقُ",12,"ق",1,0],["وَلا ضَمّها السّلطانُ قَسْراً لدَعْوَةٍ،","فَتَرْضَى بهَذا الحِلْفِ بكرُ بنُ وَايلِ",13,"ل",1,0]]}