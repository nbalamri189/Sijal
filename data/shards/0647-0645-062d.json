,"لا تعذل العين أن أرخت عزاليها","https://www.poetsgate.com/ViewPoem.aspx?id=187832",""],[5410,"صرخات من أعلى المنارة","https://www.poetsgate.com/ViewPoem.aspx?id=142533",""],[5444,"موكب العز","https://www.poetsgate.com/ViewPoem.aspx?id=205068",""],[5674,"لست مغرورة","https://www.poetsgate.com/ViewPoem.aspx?id=190971",""],[5956,"الإسرائيليون","https://www.poetsgate.com/ViewPoem.aspx?id=192309",""],[5956,"ديمقراطية الدمويِّين","https://www.poetsgate.com/ViewPoem.aspx?id=192364",""],[5956,"الكافورُ الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=192937",""],[5956,"قد رحبتْ قَطَنا بخيرِ مُفكِّر","https://www.poetsgate.com/ViewPoem.aspx?id=207490",""],[5956,"أشكو لمن ليخففَ الأحزانا؟","https://www.poetsgate.com/ViewPoem.aspx?id=215830",""],[6005,"إصطفي خلف الأخريات","https://www.poetsgate.com/ViewPoem.aspx?id=161459",""],[6127,"صوتك النور","https://www.poetsgate.com/ViewPoem.aspx?id=191300",""],[6127,"إلى موسى(ع)","https://www.poetsgate.com/ViewPoem.aspx?id=203675",""],[6160,"قناديلُ عراقيَّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87104&r=&rc=21",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""],[572,"لهُ شُغُلٌ عنْ سؤالِ الطّلَلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9447&r=&rc=304",""]],"verses":[["هُمُ حَمَلوا لَكَ الإِحسانَ عَفواً","فَدونَكَهُنَّ وَلغاً وَاِستِراطا",0,"ط",2,0],["هُمُ حَلّوا مِنَ الشَرَفِ المُعَلّى","وَمِن حَسَبِ العَشيرَةِ حَيثُ شاؤوا",1,"ا",1,0],["هُمُ حَبَسوا بِذي نَجَبٍ حِفاظاً","وَهُم ذادوا الخَميسَ بِوارِداتِ",2,"ت",1,0],["هُمُ حَدَروكَ مِن نَجدٍ فَأَمسَت","مَعَ الخِنزيرِ قاصِيَةً نَواكا",3,"ك",2,0],["هُمُ حَدَبوا عَلَيَّ وَمَكَّنوني","بِأَفيَحَ لا يَزِلُّ بِهِ المَقامُ",4,"م",1,0],["هُمُ حَيَّةُ الوادي فَإِن كُنتَ راقِياً","فَدونَكَ أَدرِك ما اِزدَهوا مِن فَنائِكا",5,"ك",2,0],["هم حدّثوني فما صدّقت ما نقلوا","وأوهموني فما حققت ما زعموا",6,"م",3,0],["هُم حَدَّدوا القُبحَ فَكانَ الجَمال","وَعَرَّفوا الخَيرَ فَكانَ الطَلاح",7,"ح",1,0],["هُمُ حِزبٌ وَسائِرُ مِصرَ حِزبٌ","وَأَنتَ أَصَمُّ عَن داعي الوِئامِ",8,"م",1,0],["هُم حَسَّنوا لِلسَوادِ البُلهِ مَملَكَةً","مِن لِبدَةِ اللَيثِ أَو مِن غيلِهِ الأَشِبِ",9,"ب",1,0],["هُم حُماةُ الإِسلامِ وَالنَفَرُ البي","ضُ المُلوكُ الأَعِزَّةُ الصُلَحاءُ",10,"ا",2,0],["هُمُ حُلَفاأُكَ الأَدنَونَ غَمّوا","أُنوفَ عَدُوِّ قَومِكَ بِالرُغومِ",11,"م",1,0],["هُمُ حَفَظوا غَيبي كَما كُنتُ حافِظاً","لِقَومِيَ أُخرى مِثلَها إِذ تَغَيَّبوا",12,"ب",3,0],["هُمُ حَسَدوهُ لا مَلومينَ مَجدَهُ","وَما حاسِدٌ في المَكرُماتِ بِحاسِدِ",13,"د",1,0],["هُمْ حسدوهُ لما لم ينالوا","مناقبَهُ فقد مكروا وشاطوا",14,"ط",3,0],["هم حَلَّلوا البغيَ المحرّمَ باسمهِ","وجنوا عليه جناية المتعمِّدِ",15,"د",1,0],["هُم حارَبوهُ وَما خافوا عُقوبَتَهُ","حَتّى رَماهُم فَأَمسى القَومُ قَد صَعِقوا",16,"ق",3,0],["هم حِزبُهُ لا حِزْبَ إلا دونهم","وَلَو اَنَّهُ اتَّخَذَ الكواكبَ سُلَّما",17,"م",2,0],["هم حاربوا اللهَ لا يَخشَوْنَ نَقمتَه","في موطنٍ تتلاقَى عنده النقمُ",18,"م",1,0],["هم حماةُ البلادِ مِن كلَّ سوءٍ","وهُمُ معْقِلُ الحمى ودِعامُهْ",19,"م",2,0],["هُمُ حَمَلوا الأَلفَ الَّتي جَرَّ جارِمٌ","وَرَدّوا جِيادَ الخَيلِ ضاحِيَةً تَعدو",20,"و",1,0],["هُمُ حَمَلوا فَوقَ المَنابِرِ صالِحاً","أَخاكَ فَضَجَّت مِن أَخيكَ المَنابِرُ",21,"ر",1,1],["هُمُ حَرمَلٌ أَعيا عَلى كُلِّ آكِلٍ","مُبيرٌ وَلَو أَمسى سَوامُهُمُ دَثرا",22,"ر",2,0],["هُمُ حَيُّ ذِي البُرْدَيْنِ لاَ حَيَّ مِثْلُهُمْ","إِذَا أَصْبَحَتْ شَهْبَاءُ بِالثَّلْجِ تَنْضَحُ",23,"ح",1,0],["هُمْ حَكَّمُوهُ فَاسْتَبَدَّ تَحَكُّماً","وَهُمُ أَرَادُوا أَنْ يَصُولَ فَصَالاَ",24,"ل",2,0],["هم حَاكَمُوكِ أمامَ مح","كَمَة الثَّعَالب والقرود",25,"د",1,0],["هم حجة الله أهل الاستقامة ما","خامت عزائمهم عن آية الزمر",26,"ر",1,0],["همُ حملوا الألف التي جرَّ جازمٌ","وردّوا جياد الخيل ضاحية ً تعدو",27,"د",2,0],["هم حفظوا غيبي كما كنت حافظاً","لقومي اخرى مثلها اذا تغيبوا",28,"ب",3,0],["هم حاولوها لأغراض مُذمَّمَةٍ","حتى إذا سُعِّرَتْ كانوا لها حطبا",29,"ب",2,0],["هُمُ حُلَفَاؤكَ الأدْنَوْنَ غَمّوا","أُنُوفَ عَدُوّ قَوْمِكَ بالرُّغُومِ",30,"م",1,0],["همُ حيّة ُ الوادي فإنْ كنتَ راقياً","فدونَكَ أدْرِكْ ما ازدهَوْا من فينائكَا",31,"ك",2,0],["هم حماتي كلما شد الوثاق","ولهم ألجأ في كل الأمور",32,"ر",1,0],["هم حبل كل العالمين لوصلة ال","إله وباب للذي أمل البرا",33,"ر",2,0],["هُمُ حاوَلوا الحَمدَ الَّذي أَنتَ أَهلُهُ","بِكُلِّ فِعالٍ يوجِبُ الذَمَّ وَاللَعنا",34,"ن",2,0],["هم حفظوا ميثاقه في حياته","وفي موته لم ينقضوا عهد والث",35,"ث",1,0],["هُم حَمَّلوني في الهَوى فَوقَ طاقَتي","فَمِن أَجلِهِم قامَت عَلَيَّ قِيامَتي",36,"ت",2,1],["هُمُ حُمرٌ تَناهَقُ خَوفَ زَأرِ ال","أُسودِ وَهُم لَدى الطَيرِ الطَّعامُ",37,"م",1,0],["هُم حِليَةُ المُلكِ لا زالوا بِهِ أَبَداً","لَولا هُمُ فيهِ كانَ المُلكُ ذا عَطَلِ",38,"ل",1,0],["هُمُ حامو الحَقيقَةِ يومَ يَدعو","حماةُ الحيِّ حيَّ على البِرازِ",39,"ز",1,0],["همْ حكَّموا فإذا التحكيمُ عندهمُ","تحكّمٌ وإذا التخييرُ إجبار",40,"ر",1,0],["هُمُ حجَّةُ اللَّهِ في أرضِهِ","وإن جَحدَ الحجَّةَ الجاحِدُونا",41,"ن",2,0],["هُم حُلَّة المَجدِ القَديم وَجعفر","ما بينهم مثل الطرازِ المذهَّبِ",42,"ب",1,0],["هُمُ حَمَوهَا فلو شاهدتَها وهُمُ","بها لشاهدتَ آساداً وخَفّانا",43,"ن",2,0],["هم حرَّفوا كَلِمَ النَّبيّ وخالفوا","هم بدَّلوا الأَحكام فيه وغيَّروا",44,"ر",3,0],["هُمُ حماةُ عَدِيٍّ في شدائِدِها","وهم أُولُو الحِلْمِ وقتَ الحِلْمِ والضَّغَنِ",45,"ن",1,0],["هم حَموني وما حمى حدّ سيفي","ووقَوني ما لا تقينيَ درعي",46,"ع",2,0],["همُ حملوا وسوقَ الدهر عنّي","وهم نشطوا عرى نِسعي وغَرْضي",47,"ض",2,0],["هم حملوا على الصراط أرجلاً","لولا هداهم عثرتْ بالأرؤسِ",48,"س",1,0],["هُمُ حولي مع النُّعمى قيامٌ","وهم عنّي مع الجُلَّى قُعودُ",49,"د",1,0],["همُ حَلاَّوْا الظمآنَ عن رشفاتِه","وذادوه لا ذادوه عن باردِ الظَّلْمِ",50,"م",1,0],["هم حركوها عليهم وهي ساكنة","والسلم قد ينبت الأوراق في السلم",51,"م",1,0],["هم حجاب لنا عليهم كثيف","حاجب من ظهور شمس النهار",52,"ر",1,0],["هم حَكَّموه فقَضَى بينَهم","لاَ بَلْ عليهم بالْقَضاءِ الْجَائِر",53,"ر",1,0],["هُمُ حَسَدُوكَ عَطاءَ الإلَهِ","وَسامُوكَ نَقصاً فَحُزتَ الكَمالا",54,"ل",2,0],["هم حجج اللهِ في يخلقِه","عليهم هُدى كلِّ مستَرْشِدِ",55,"د",1,0],["هم حجبوا ما الفجر إلا ابتسامه","وما الروضة الميثاء إلا شمائله",56,"ل",2,0],["هُمُ حملوا رَحلي وأدوا أمانتي","إِليَّ وردوا فيَّ رِيشَ القوادِمِ",57,"م",1,0],["هُمُ حِصني الحَصينُ وَلَيسَ خَلقٌ","سِواهُم لي غَداً ظِلّاً ظَليلا",58,"ل",2,0],["هُم حمّلوا النفسَ ما طاقوا وما اِحتَملوا","أَم حمّلوا النفسَ منهم فوقَ ما طاقوا",59,"ق",3,0],["هم حشو جنات النعي","م على الأسرة والمنابر",60,"ر",1,0],["همُ حملونا على العُرف كرهاً","وهم صرفونا عن المنكر",61,"ر",1,0],["هم حسدوني عليك فاختلفوا","بكل زور عليك واختلقوا",62,"ق",3,0],["هم حِزبهُ السّادات من آل خِنْدفِ","له منهمُ حصن وسيفٌ وساعِدُ",63,"د",1,0],["همُ حَمَوا ملَّة الإسلام واتبعوا","دين الرّسول وهم آوَوْا وهم نَصَروا",64,"ر",3,0],["هم حموا بالحمى عقيلة خدر","فتنت باللحاظ غزلان رامه",65,"م",2,0],["هُمُ حَامَوا عن الاحساب لمّا","رَأوا شَهباءَ مَائِلةَ الهلال",66,"ل",1,0],["هم حصني وهم سيف اعتمادي","اصول به على الدهر الخصيم",67,"م",1,0],["هُمُ حَفِظوا العَهدَ الذي خُنتُمُ به","فَكانوا لِأَهلِ الدينِ مُذ هاجَروا صَحبا",68,"ب",2,0],["هُمُ حلَفُوا عند الحليس ومُدرك","وعند بلالٍ لا أسيرٌ ويَشربُوا",69,"ب",3,0],["هُمُ حَسَنٌ ثم الحسينُ ونجلُه","عليُّ الذي زان العبادة بالزّهدِ",70,"د",1,0],["هم حماة الشرع الشريف وأكرم","بحماة حمى الأسود حماها",71,"ا",3,0],["همُ حرّفُوا القُرآنَ تَحريفَ كافِرٍ","بِهِ وَادَّعَوا فيهِ لَدَيهِم فَضائِحا",72,"ح",2,0],["هم حالمون حلمهم جبّارُ","بكل شيء لهم عثارُ",73,"ر",1,0],["هم حمّلوني غراماً كاد أيسره","يفني حياتي فقد بت الهوى حيلي",74,"ل",2,0],["هُم حاولوا إنزال قدري إلى الثرى","ومنزل قدري للثريا مُتاخم",75,"م",1,0],["هم حكموا باعنات كأنا","حرام ان نكون من الشعوب",76,"ب",1,0],["هم حاولوا أن يحرجوك فكادهم","صدر كترجيم الظنون رحيب",77,"ب",1,0],["هم حجة الله العليّ على الورى","وبهم أبان حرامها وحلالها",78,"ل",3,0],["هم حزب الأحزاب من كل جانب","كما حزبت أحزابها أهل خيبرا",79,"ر",2,0],["هُمْ حَسَدُوا تَطَاوُلَه","وَقَصْرُ القَاصِرِ الحَسَدُ",80,"د",1,0],["هُمُ حَفظوها للنفوسِ ذَخيرةً","فما حفظوها والنفوسُ تَضيعُ",81,"ع",1,0],["هُمُ حينَ يَدمى من أَديمكَ مُلدَغٌ","ذئابٌ على شَمِّ الدماءِ لَغَاوسُ",82,"س",1,0],["هم حُسنُ هذي الأرض والأرض أقفرت","بدونهم من كل حسن توسما",83,"م",2,0],["هم حفظوا الإل القديم وحالفوا","أباك فكانوا دون قومك من فهر",84,"ر",1,0],["هم حكَّموه قَبل بعثته فَما","أَغراهم إِذ حَقَّت الأَنباء",85,"ا",2,0],["هُمُ حارَبوا النُعمانَ في عَصرِ دَهرِهِ","فَما اِسطاعَ أَن يَستَطلِعَ الحَربَ مَطلَعا",86,"ع",2,0],["هم حجج الرحمن بين عباده","هم الحبل حبل اللّه لم يتصرم",87,"م",1,0],["هم حجةُ الرحمن بين عباده","همُ الحبلُ حبل اللّه لم يتصرَّم",88,"م",1,0],["همُ حيَّروني حيثُ ساروا يمَّموا","وحيثُ ثَوَوا بعدَ الفراقِ وخيَّموا",89,"م",3,1],["هم حصوني من شآبيب البلا","وثنائي لهم روح أصغري",90,"ي",1,0],["هُم حِليَةُ المُعطَّلِ","وَهُم سِلاحُ الأَعزَلِ",91,"ل",1,0],["هُم حَربُ مَن يُقارِبُ","فَكَيفَ مَن يُحارِبُ",92,"ب",1,0],["هُمُ حَلَفُوا أَنْ لا يُخُونُوا عُهُودَنا","فما بالُ ادْراجِ المَواثِيقِ تَنْشَقُّ",93,"ق",1,0],["هم حُجَّةُ الرحمنِ في الأرضِ كلِّها","همُ الغَوثُ والغيثُ الملثُّ المعاجِلُ",94,"ل",1,0],["هُمْ حَوَّلُوا ثَورَتَكْ أَزمَه","وَقَّعْ لهذا, وذا بَصَّمْ",95,"م",1,0],["هم حجج الله في خلقه","عليهم هدى كل مسترشد",96,"د",1,0],["هُمْ حَرَّرُوْهَاْ مِنَ الطُّغْيَاْنِ، وَانْتَصَرُوْا","فَنَّوَّهَ(4) النَّاْسُ بِالتَّحْرِيْرِ تَنْوِيْهَاْ",97,"ي",3,0],["هم حاولوا دَرْئي لكي يَتَنَفَّسوا","لكنّهم عجزوا وشعري قد سَمَقْ",98,"ق",1,0],["هم حنطوه على شواطيء حلمهم","بحراً فذاب على الضلوع عناقا",99,"ق",2,0],["هُم حُمَاةُ البِلادِ فِي كُلِّ عَصرٍ","مُنذُ صَالَ الهُكْسُوسُ والإِغرِيقُ",100,"ق",1,0],["هُمُ حُصْنُ البَرَايَا في الرَّزايَا","إذا ظُلمَ الأيَامَى والأرَامِل",101,"ل",1,0],["هم حملوا العلم فطالوا به","وغيرهم يحمل اسفارا",102,"ر",2,0],["هُمْ حَيْدَرُ الطُّهْرِ وَالزَّهْرَاءُ فَاطِمَةٌ","وَالْمُجْتَبَانِ مِنَ الدُّنَيا لِهَاديهَا",103,"ي",3,0],["هُم حرَّروا..، هم عمَّروا.. ما دمَّروا","بل ورّثوا الأجيال خصباً منعما",104,"م",2,0],["هم حرَّقوا في ربوعِ الأرضِ زهرتَنا","حتى اختنقنا كأنا تحتَ أغوار",105,"ر",1,0],["هم حنَّطونا على مقهى نفايتِهم","وألبسونا قميصا خِيطَ في بار",105,"ر",1,0],["هُم حاسدوكٓ بِحُبّي ليتهمْ عرفوا","كمْ يعشقُ الآسِرُ الملهوفُ مأسورٓهْ",106,"ر",2,0],["هم حثالاتُ شعوب غُرَبا","رفعوا أعناقهم ف