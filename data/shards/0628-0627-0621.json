{"poems":[[48,"قد نال خيرا في المعاشر ظاهرا","https://www.aldiwan.net/poem22018.html","الكامل"],[199,"إن الخليط أجدوا البين فانقذفوا","https://www.aldiwan.net/poem54398.html","البسيط"],[202,"ألف ألا انعم بالمحبة حالا","https://www.aldiwan.net/poem51903.html","الكامل"],[310,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122736","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100988","الكامل"],[1870,"","https://poetry.dctabudhabi.ae/diwan/poem/20045","البسيط"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113776","البسيط"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84900","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117848","الخفيف"],[3908,"","https://poetry.dctabudhabi.ae/diwan/poem/138053","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77053","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[3464,"ألفٌ أمعاني من يذكرْ","https://www.poetsgate.com/ViewPoem.aspx?id=158742",""],[5431,"القصيدة المقعده!...","https://www.poetsgate.com/ViewPoem.aspx?id=200042",""],[5829,"ليلة العدوان","https://www.poetsgate.com/ViewPoem.aspx?id=210434",""],[6031,"بَاءَتْ حَنيفَةُ بالخُسْرانِ إذْ عَكَفَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=46333",""]],"verses":[["باءَ الكَلامُ بِمَأثَمٍ وَالصَمتُ لَم","يَكُ في الأَعَمِّ بِمَأثَمٍ لِيَبوءا",0,"و",3,0],["باءَ القَتيلُ الَّذي اِختانوهُ غائِلَةً","ما كُلِّفوا دِيَّةً فيهِ وَما حَلَفوا",1,"ف",3,0],["باء بدا شفق المغيب وأوقدت","سرج النجوم فعاطني الجريالا",2,"ل",2,0],["باءَ الحسودُ بِما يقولُ ولا ذوى","غَرسُ الولاءِ المثمرِ المتنعّمِ",3,"م",1,0],["باءت مَعَدُّ بِكَسرٍ غَيرَ مُنجَبِر","أُخرَى الزَّمانِ وَجُرحٍ غَيرَ مُندَمِلِ",4,"ل",1,0],["باء ومن إن زيدتا لولا لعل","والكاف علّق ما سواها بالجمل",5,"ل",1,0],["باءٌ وياءٌ ثم تاءٌ بعدها","نونٌ فخُذ ترتيبها في وردها",6,"ه",2,0],["باء البخار لقد علمنا أصبحت","في شعرة التاريخ فاء فخار",7,"ر",1,0],["باءَت عَرارِ بِكَحلٍ وَالرِفاقِ مَعاً","فَلا تَمَنّوا أَمانِيَّ الأَضاليلِ",8,"ل",1,0],["باءت بخُسرٍ وتَطفيفٍ ومنقَصَةٍ","فكيفَ تحسَبُ أوفى الناسِ ميزانا",9,"ن",2,0],["باءَت تُبشر بِالعُلا","لَيسَت لِغَيرك تُوجد",10,"د",1,0],["باء بالسخط فلا شيعته","رضيت عنه ولا أرضى العدى",11,"د",2,0],["باء بالمقت في الحياة من الل","ه الذي صير الجحيم مهاده",12,"د",2,0],["باءُوا بِمَقْتَلِهِ ظُلْماً فَقَدْ هُدِّمَت","لِفَقْدِهِ مِنْ ذُرَىالاِسْلامِ أرْكانُ",13,"ن",1,0],["باء بِالوَيل وَالخَسارَة نَكس","قَد تَراءى لِذلِكَ القرم ضدا",14,"د",2,0],["باء منه أهل الكتب قدرا","وحبانا بأصدق الانباء",15,"ا",2,0],["باءٌ بل تلك مدائح من","نادته العليا يا مظهر",16,"ر",1,0],["باء الأغرُّ بغربة","جعلته يفقد مقصده",17,"د",2,0],["باءت بخزي لم تحقق مأربا","وسعى سلاح الجوّ فيها كالشفق",18,"ق",1,0],["بَاءَتْ حَنيفَةُ بالخُسْرانِ إذْ عَكَفَتْ","دُونَ الأَنَامِ من الحَلْوى على صَنَمِ",19,"م",1,1]]}