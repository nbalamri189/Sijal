الْفَرَجِ","https://www.poetsgate.com/ViewPoem.aspx?id=201878",""],[5145,"لبيك يا صاحب النشيد","https://www.poetsgate.com/ViewPoem.aspx?id=108177",""],[5149,"أَنينُ الغُربةِ","https://www.poetsgate.com/ViewPoem.aspx?id=211295",""],[5149,"سَقَتْنِي بِنَارِ الصَّدِّ","https://www.poetsgate.com/ViewPoem.aspx?id=212975",""],[307,"خَرِيفُ العُمْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=215587",""],[592,"ألم تر أن الصبر أجمل بالفتى","https://www.poetsgate.com/ViewPoem.aspx?id=128852",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5376,"وقامت أُخيَّة تلقي السلام......من حماه","https://www.poetsgate.com/ViewPoem.aspx?id=188421",""],[5829,"إذا شاء الاله","https://www.poetsgate.com/ViewPoem.aspx?id=160205",""],[5861,"جدال الروح","https://www.poetsgate.com/ViewPoem.aspx?id=190862",""],[5970,"حسان المنى من دونهن المصاعب","https://www.poetsgate.com/ViewPoem.aspx?id=130580",""],[5988,"تقاضاك دهركَ ما آسلفا","https://www.poetsgate.com/ViewPoem.aspx?id=99716",""],[6070,"تَنَزَّهْ عَنْ مرافقةِ الكذوبِ","https://www.poetsgate.com/ViewPoem.aspx?id=190542",""],[6070,"أسيرُ معَ الحروفِ إلى الخيالِ","https://www.poetsgate.com/ViewPoem.aspx?id=191744",""],[6152,"حرام عليّ النساء غيركِ","https://www.poetsgate.com/ViewPoem.aspx?id=203711",""],[164,"بعثت ببرد بما زادكم نوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=608104",""],[6256,"بنغازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65923&r=&rc=11",""],[6312,"للمائسِ المدْهوش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82953&r=&rc=3",""],[572,"شكوتُ إلى مرحبٍ علّة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9457&r=&rc=314",""]],"verses":[["فَلا تَجزَعَن مِن شِدَّةٍ إِنَّ بَعدَها","فَوارِجَ تَلوي بالخُطوبِ العَظائِمِ",0,"م",1,0],["فَلا تَجزَعي لَمّا نَأَت وَتَزَحزَحَت","بِعَزَّةَ دوراتُ النَوى وَرُجومُها",1,"م",3,0],["فَلا تَجعَلَنّي في الأُمورِ كَعُصبَةٍ","تَبَرَّأَتُ مِنها إِذا رَأَيتُ ضلالَها",2,"ل",3,0],["فَلا تَجبَهيهِ وَيبَ غيرِكِ إِنَّهُ","فَتىً عَن دَنِيّاتِ الخَلائِقِ نازِحُ",3,"ح",1,0],["فَلا تَجزَع فَإِنَّ بَني نُمَيرٍ","كَأَقوامٍ نَفَحتَ لَهُم ذِنابا",4,"ب",2,0],["فَلا تَجمَعي ذِكرَ الذُنوبِ لِتَبخَلي","عَلَينا وَهِجرانَ المُدِلِّ المُباعِدِ",5,"د",1,0],["فَلا تَجعَلوا لِلَّهِ نِدّاً وَأَسلِموا","وَلا تَلبَسوا زَيّاً كَزَيِّ الأَعاجِمِ",6,"م",1,0],["فلا تجعلوني في العفاةِ نعامة","غدت تبتغي قرناً فعادت بلا أذن",7,"ن",1,0],["فلا تجزعَنْ منها وإن كان مثلها","زعيماً بنفرِ الجأشِ ذي السكناتِ",8,"ت",1,0],["فلا تجلسوا وسط المجالس حُسَّراً","ولا تركبوا إلا ركائِبَ تُحْدَجُ",9,"ج",1,0],["فلا تجعلنَّ الموت نُكراً فإنما","حياةُ الفتى سَيْرٌ إلى الموت قاصدُ",10,"د",1,0],["فلا تجعل الحرمان أمراً مقدراً","فيلقاك من قولي ملام مقدر",11,"ر",1,0],["فلا تجعلنَّ الهجر دَأباً فإنهُ","بإتمام ما أَسْدَى إليَّ جدير",12,"ر",1,0],["فلا تجرب على الحياة فما","كل التجاريب فيه منتفع",13,"ع",1,0],["فلا تجفُني حيّاً ولا تبكِ رمَّتي","كمنصرِفٍ عني يسائلُ أطلالي",14,"ل",2,0],["فلا تجرحنّ القولَ فيك فإنه","وإن لم يكن عدلاً عليك مُعدّلُ",15,"ل",1,0],["فَلا تَجزَعنَ مِن سُنَّةٍ أَنتَ سِرتَها","وَأَوَّلُ راضي سُنَّةٍ مِن يَسيرُها",16,"ر",3,0],["فَلا تَجعَلَنّي يا اِبنَ مَروانَ كَاِمرِئٍ","غَلَت في هَوى آلِ الزُبَيرِ مَراجِلُه",17,"ل",2,0],["فَلا تَجزَع لِحادِثَةِ اللَيالي","وَقُل لي إِن جَزِعتَ فَما عَساكا",18,"ك",2,0],["فَلا تَجحَدَنَّ يَدَ الغارِسينَ","وَهَذا الجَنى في يَدَيكَ اِعتَرَف",19,"ف",1,0],["فَلا تَجمَعي هَجراً وَعَتباً فَلَم أَجِد","جَليداً عَلى هَجرِ الأَحِبَّةِ وَالعَتبِ",20,"ب",1,0],["فَلا تَجفُوَنَّ الدَهرَ مادامَ مُسعِداً","وَمَدَّ السُرى ما قَد حَباكَ بِهِ يَدا",21,"د",2,0],["فَلا تَجعَلِ المَعروفَ رِقّاً فَإِنَّنا","خُلِقنا نُجوماً لَيسَ يُملَكنَ بِالعُرفِ",22,"ف",1,0],["فَلا تَجزَعي إِنّي سَأَجعَلُ رِحلَتي","إِلى اللَهِ وَالباني لَهُ وَهوَ عامِلُه",23,"ل",2,0],["فَلا تَجعَلَنَّ العِرضَ لِلمالِ جُنَّةً","وَكُن كَالفَتى الكِنديَّ حينَ يَقولُ",24,"ل",1,0],["فَلا تَجعَل جَوابَكَ في يَدَي لا","فَأَكتُبَ ما رَجَوتُ عَلى الجَليدِ",25,"د",1,0],["فلا تجزمْ بالاستفهامِ عنهُ","وهبْ أخبارَهُ أخبارَ لولا",26,"ل",2,0],["فَلا تُجرِ كَفَّكَ مِن مُهرَقٍ","بِما لايَسُرُّ هُناكَ الكِتاب",27,"ب",1,0],["فَلا تَجرِ إِلّا دَماً أَو ذُعافاً","وَلا تَحفَل القَومَ أَن يَعطَبوا",28,"ب",3,0],["فَلا تَجزَع مِنَ النَقَماتِ وَاِترُك","رُواةَ الشِعرِ تَطَّرِدُ القَوافي",29,"ف",2,0],["فَلا تُجمِعي أَن تَحبِسيني وَتمطلي","أَأُححبَس عَن أَرضي هُديتِ وَأُمطَلُ",30,"ل",1,0],["فَلا تَجعَلوا فيها الغَوِيَّ مُسَلَّطاً","كَما سُلِّطَ البازي عَلى القَطَواتِ",31,"ت",1,0],["فَلا تَجزَعَنَّ إِذا ما الحِمامُ","صاحَ بِوَفدِ الضَنى هِيَّ بي",32,"ب",2,0],["فلا تجزَعنْ ، نِعم عُقبى الفتى","تَحَّملُ ما لم يُطِقْ فاصْطَبر",33,"ر",1,0],["فلا تجزَعَنْ مِنْ شِدَّة ٍ إنَّ بَعْدَها","فوارجَ تلوي بالخُطوبِ العوارمِ",34,"م",1,0],["فلا تجعلنّي في الأمورِ كَعُصْبَة ٍ","تبرَّأتُ منها إذْ رأيتُ ضلالَها",35,"ل",3,0],["فلا تجالسْ أُهيلَ السوء يا وَلَدى","وفرَّ عنهم وكن مِنهم عَلَى حَذَرِ",36,"ر",1,0],["فَلا تَجعَلوا لِلَّهِ نِدّاً وَأَسلِموا","وَإِنَّ طَريقَ الحَقِّ لَيسَ بِمُظلِمِ",37,"م",1,0],["فلا تجزعي إنا سنُقري ضيوفنا","ونكرم مثواهم ولا بدع أن نُقري",38,"ر",2,0],["فَلا تَجعَل لِمَقدِمِهِ أَواناً","عَلَيهِ الطالِعُ المُختارُ دَلّا",39,"ل",2,0],["فلا تجزعي يا نفس من صدعة النوى","ستشعب من كفي أخيى شعبان",40,"ن",1,0],["فلا تجز عن مما قضى وكرهته","ففيما قضاه الله أعظم خيرةِ",41,"ه",1,0],["فَلا تَجزَعوا آل المُغيرَةِ وَاِصبِروا","عَلَيهِ وَمَن يَجزَع عَلَيهِ فَلَم يُلَم",42,"م",1,0],["فلا تُجدي الإغاثةُ منكَ نفعاً","وما لكَ في بلائكَ من مُغيث",43,"ث",1,0],["فلا تجحدي دَمعي الذي نوَّرَ الدُّجى","فكان كشعلاتٍ من النجمات",44,"ت",1,0],["فلا تجحدي قلباً وكفّاً كِلاهُما","وَفاكِ على رغم العدى ووقاك",45,"ك",1,0],["فلا تجرحي قلبي الكريمَ تدلُّلاً","فمثلُكِ لا ترضى التذلُّلَ من مِثلي",46,"ل",2,0],["فلا تجزعْ لداهِيَة بِنَادٍ","أما ناديه للجُلّى جَلاءُ",47,"ا",2,0],["فَلا تَجْهَلَنَّكَ زُهْرُ النُّجُومِ","فَإِنَّكَ مِنْها عَلى الْبُعْدِ دانِ",48,"ن",1,0],["فَلا تَجلِسوا غَرَضاً لِلمَنو","نِ حَذفاً كَما تُحذَفُ الأَرنَبُ",49,"ب",1,0],["فلا تجدي عَلَى صبٍّ","لحبّك زلَّ في سبِّك",50,"ك",1,0],["فَلا تَجزَع وَإِن أَعسَرتَ يَوماً","فَقَد أَيسَرتَ في الزَمَنِ الطَويلِ",51,"ل",1,1],["فلا تَجْعَلْ إذا نابَتْ خُطوبٌ","شِعارَكَ ما لِنائبةٍ ومالي",52,"ل",2,0],["فَلا تَجلِب عَلَيَّ بِنَقصِ مالي","فَلَم أَجلِب عَلَيكَ بِنَقصِ عُمري",53,"ر",2,0],["فَلا تَجمَعوا الحِرمانَ مِنكُم وَمِنهُم","فإِنَّ ذَوي الأَمرِ القَدى لِذَوي الأَمرِ",54,"ر",1,0],["فَلا تَجمَعوا لِلدَهرِ في ذاتِ بَينكُم","سَبيلاً فَإِنَّ الدَهرَ خَصمُ المَكارِمِ",55,"م",1,1],["فلا تجزع إذا ما شِمتَ برقاً","ولا تهلع لرعدٍ في الأعالي",56,"ل",2,0],["فلا تجزعوا من حادثٍ حباء فادحاً","فذا الدين للحرمن في نصره يد",57,"د",1,0],["فلا تجعلوها عن كريم استماعكم","بمزلقةٍ إن الكريم أذينُ",58,"ن",1,0],["فلا تجشّمْ ثقل احتشامي","ولا تحف قلّة احتمالي",59,"ل",2,0],["فلا تجعلنَ كثرةَ الزائرين","لها فترةً وعليها اعتلالا",60,"ل",2,0],["فَلا تَجزَعَنَّ لَها عِلَّةً","فَلا بُدَّ لِلبَدرِ أَن يَنكَسِف",61,"ف",1,0],["فلا تجسر على أمرٍ قوي","عليك فربما هلك الجسور",62,"ر",1,0],["فَلا تَجعلي ما كانَ منكِ مِنَ الأَذى","عِقاباً لِما لَمْ آتِهِ وَجَزاءا",63,"ا",3,0],["فَلا تجمعوا في يومِكمْ شملَ معشرٍ","يكونُ غداً يا قومُ طوعَ شتاتِ",64,"ت",1,0],["فَلا تَجزَعا يا والِدَيهِ فَرَبُّهُ","أَبَرُّ بِهِ مِن والِديهِ وأَرأَفُ",65,"ف",1,0],["فَلاَ تَجْمَعَنًّ عَلَيْكَ الضَّنَى","بِنَارِ المِزَاجِ وَنَارِ المُدَامِ",66,"م",1,0],["فلا تجحدي إِن قلت قبرُك جَنَّةٌ","فرائحةُ الفردوسِ منه شمَمْتُها",67,"ت",3,0],["فلا تجمع إلى الحَلْفاءِ ناراً","فإن النارَ تُسرعُ في الحلافي",68,"ف",2,0],["فلا تجعلنْ إلا أخا الصدق صاحباً","وكن صادقا فالحق يعلو ولا يُعْلى",69,"ل",2,0],["فلا تجعلوا الأيام تجري مضاعةً","تعالوا بنا نسرق من الحب ساعةً",70,"ه",1,0],["فلا تجعل النجم تاجاً فعن","قليل يهالُ عليك المدر",71,"ر",1,0],["فلا تجزعن لخد أرن","وجد أجن بحرب ورد",72,"د",1,0],["فَلا تَجزَع لَها وَاِصبِر عَلَيها","فَإِنَّ الصَبرَ عُقباهُ النَجاحُ",73,"ح",1,0],["فلا تجعل معاوية بن حرب","كشيخ في الحوادث غير نكس",74,"س",1,0],["فَلا تُجْهِزْ عَلى روحي وَدَعْني","أُرَجِّي مِنْ ذَماها ما اُرَجِّي",75,"ج",2,0],["فلا تَجز عَن تلك السماءُ تَغَيَّمَت","فَعَمَّا قليل تَبتَدِي فَتَصُوبُ",76,"ب",1,0],["فلا تجزعن لطريق سلك","ت انبّ غيرك في وسطه",77,"ط",2,0],["فَلا تَجعَلَنِّي مِن بَنِي الدَّهرِ إِنَّهُم","لِنَعلِي عَلَى أَنِّي تَسَامَحتُ عَبدَانُ",78,"ن",1,0],["فلا تجورن مجد الدين مقتدرا","فالجور أقبح ما يستحسن الملك",79,"ك",1,1],["فَلا تَجزَع لِأَمرٍ ضاقَ شَيئاً","فَكَم صَعبٍ تَشَدَّدَ ثُمَّ لانا",80,"ن",2,0],["فَلا تَجزَعي إِمّا رَأَيتِ قُيودَهُ","فَإِنَّ خَلاخيلَ الرِجالِ قُيودُها",81,"د",3,0],["فلا تجعلوا بين المضاف وبين من","يضاف له فصلا وإن زلّ أو عثر",82,"ر",1,0],["فلا تَجزَ عضن للبين كلُ جماعة","وجَدِّك مكتوبٌ عليها التفرقُ",83,"ق",1,0],["فلا تجنيت عليه بعد ما","رقى إلى ذاك المحل الأرفع",84,"ع",1,0],["فلا تجهدن نفسا بعلمك شانه","لقد خاب عن مس السماك مزاحمه",85,"م",2,0],["فلا تجزعوا من كتب عشرة أحرفٍ","محرَّمةٍ مكتوبَة ببنان",86,"ن",1,0],["فلا تجزَعَن فالأمرُ والشانُ واحد","ولا تلتفت إلى يساري وإعساري",87,"ر",2,0],["فَلا تَجمَعي بَذلي وَوُدِّي وَنُصرَتي","وَأَن تَجعَلي فَوقي لِسانَكِ مِبرَدا",88,"د",2,0],["فلا تجزع لهجر بعد وصل","فأيام الهوى بيض وسود",89,"د",1,0],["فَلا تَجزَع فَدَيتك بَعد حبر","تُوفي فَهوَ للجنّات وافى",90,"ف",2,0],["فلا تجفونَّ الدهر مادام مسعدا","ومدَّ إلى ما قد حباك به يدا",91,"د",2,0],["فلا تجعل الهيجاءَ عذراً على الندى","فما ذكت الهيجاءُ إِلاَّ لتخمدا",92,"د",2,0],["فَلا تَجعَلوا حَرباتِكُم في نُحورِكُم","كَما شَدَّ أَلواحَ الرِتاجِ المَسامِرُ",93,"ر",1,0],["فلا تجزعي مما لقيت من الأذى","فإن الأذى حتم على كل قائم",94,"م",1,0],["فلا تجزع ابا المهديّ وانظر","الى امم مضوا امماً قرونا",95,"ن",2,0],["فلا تجعلوا غير العزائم عصمة","ولا تطلبوا غير الصوارم منجدا",96,"د",2,0],["فلا تجف بحر الوجد عبرتها","ولا تبوخ بفيض الأدمع الحرق",97,"ق",1,0],["فلا تجنحي للسلم ما دامت الوغى","وما دام في أيام عمرك طول",98,"ل",1,0],["فلا تجب داعياً يدعو لمعشرهم","ولا فتاة بلا جرم من الحرم",99,"م",1,0],["فَلا تَجزَعَن قَيّارُ مِن حَبسِ لَيلَةٍ","قَضِيَّةَ ما يُقضي لَنا فَنَؤوبُ",100,"ب",1,0],["فلا تجزعي يَا هندُ إنّ شَبيبتي","تولتْ فإن المرءَ بالشيبِ يحلُم",101,"م",1,0],["فلا تجزعي","فما بال نفسيَ بنت الخلود",102,"د",1,0],["فلا تجزَعي يا أمَّ أوسٍ فإنَّهُ","تُصِيبُ المنَايَا كُلَّ حَافٍ وذِي ن