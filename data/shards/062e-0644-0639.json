ن يا من نهتدي","https://www.aldiwan.net/poem12646.html","الرمل"],[435,"جرر على القمرين ذيل التيه","https://www.aldiwan.net/poem2652.html","الكامل"],[439,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[439,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[458,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[458,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[461,"أي الخطوب من الزمان أزل","https://www.aldiwan.net/poem15110.html","الكامل"],[464,"قل لمن يبتغي مناواة شعري","https://www.aldiwan.net/poem3129.html","عموديه"],[464,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[464,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[464,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[464,"ولقد نزلت من الجزيرة منزلاً","https://www.aldiwan.net/poem3551.html","عموديه"],[464,"شاق الحمام برامتين فغردا","https://www.aldiwan.net/poem3584.html","عموديه"],[464,"سرى موهناً والأنجم الزهر لا تسري","https://www.aldiwan.net/poem3632.html","عموديه"],[468,"إذا الفتى مرة كساني","https://www.aldiwan.net/poem59641.html","مخلع البسيط"],[477,"يقر بعيني أن أرى الربع والدارا","https://www.aldiwan.net/poem15252.html","الطويل"],[479,"قرنت قلوصك ربها بزميله","https://www.aldiwan.net/poem37580.html","الكامل"],[495,"غضي جفونك يا رياض","https://www.aldiwan.net/poem9883.html","مجزوء الكامل"],[500,"خل عنك الأوهام يا أم عمرو","https://www.aldiwan.net/poem37717.html","الخفيف"],[500,"خذ شهودا عن شهود الكائنات","https://www.aldiwan.net/poem38068.html","الرمل"],[504,"سروري وذوقي من جمالك صادر","https://www.aldiwan.net/poem38406.html","الطويل"],[504,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[506,"خلعت العذار بشيب العذار","https://www.aldiwan.net/poem2383.html","المتقارب"],[514,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[514,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[515,"خلعت عليك مواسم الأيام","https://www.aldiwan.net/poem12251.html","الكامل"],[538,"ما أبصرت عيني بها عيناك","https://www.aldiwan.net/poem48002.html","عموديه"],[538,"أنت ماذا دهاك قل لي حتى","https://www.aldiwan.net/poem48307.html","عموديه"],[551,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[553,"أيا سرور وأنت يا حزن","https://www.aldiwan.net/poem68412.html","المنسرح"],[558,"نحن بالأمر الإلهي","https://www.aldiwan.net/poem33646.html","مجزوء الرمل"],[559,"إذا لم يكن معنى حديثك لي يدرى","https://www.aldiwan.net/poem69370.html","الطويل"],[562,"نزع القريض إلى حمى نقاشه","https://www.aldiwan.net/poem52908.html","الكامل"],[562,"هوى في القلب يعذب وهو داء","https://www.aldiwan.net/poem52983.html","الوافر"],[564,"خل عنك الصد يا بدر الدجى","https://www.aldiwan.net/poem832.html",""],[575,"إن أكن أشجعا فأنت الرشيد","https://www.aldiwan.net/poem3083.html","الخفيف"],[575,"راحت وحق الله روحي","https://www.aldiwan.net/poem3090.html","مجزوء الكامل"]],"verses":[["خَلَعتُ عَلى عِطفَيكَ بُردَ شَبيبَتي","جَواداً بِعُمري وَاِقتِبالِ زَماني",0,"ي",1,0],["خَلَعنا طاعَةَ الحُبِّ","فَلا عَهدٌ وَلا إِلُّ",1,"ل",1,0],["خَلَعَ الرَدى ذاكَ الرِداءَ نَفاسَةً","عَنّا وَقَلَّصَ ذَلِكَ السِربالا",2,"ل",2,0],["خَلَعَ الحَياءَ جُناتُهُ وَصَوارِمي","خَلَعَت عَلَيهِ يَلقَماً لَم يُزرَرِ",3,"ر",1,0],["خلَعَ الرَّبيعُ منْ أنوارِهِ","حَلياً تَوَشَّحَهُ ثَراكَ العاطِلُ",4,"ل",1,0],["خَلَعتَ الشَبابَ فَلَم تَبكِهِ","وَساءَكَ أَنَّكَ لَم تُختَضَر",5,"ر",1,0],["خَلَعَت عَلَيهِ الشَمسُ حُلَّةَ عَسجَدٍ","وَحَباهُ آذارٌ أَرَقَّ وِشاحِ",6,"ح",1,0],["خَلَعوا الشَبابَ عَلى البَشيرِ وَأَخلَقوا","بِاللَثمِ عَهدَ خَليفَةِ الرَحمَنِ",7,"ن",1,0],["خَلَعَ اللَهوَ وَأَضحى مُسبِلاً","لِلنُهى فَضلَ قَميصٍ وَرِدا",8,"ا",1,0],["خلعتَ على هذا الرسول ملابساً","بها تتسنّى في عُلاكَ المآملُ",9,"ل",1,0],["خلعت ثوبها وأغضت حياءً","فأرتنا خلاعة في احتشام",10,"م",1,0],["خَلَعَ المُلوكَ وَسارَ تَحتَ لِوائِهِ","شَجَرُ العُرى وَعُراعِرُ الأَقوامِ",11,"م",1,1],["خلعة قاضي القضاة لا برحت","بكِ التهاني أوفى رَجا الراجي",12,"ي",1,1],["خلع الصباح على المجرة سجفه","أم قسمت شمس النهار دراري",13,"ر",2,0],["خلع أنشرت زمان الرياض","باخْضرارٍ من نورها في ابْيضاض",14,"ض",1,1],["خُلِعَتْ عليه من المحا","سنِ خِلعةٌ لا تُسلَبُ",15,"ب",1,0],["خِلَعٌ عليك جمالُها وجلالُها","أيامُها للناس كالأعيادِ",16,"د",1,0],["خَلَعَ الإله عليك يوم لبستها","هَدْيَ الشَّكور وبهجة المُزدادِ",16,"د",1,0],["خلعوا فيكم عِذار المُعْتدي","وغَدوْا بين اعتراضٍ وأَرَن",17,"ن",1,0],["خَلَعتُ عِنانَ الفَودَجِيَّةِ بَعدَما","رَمَت بِشُعَيثٍ فَوقَ غُبرِ المَخارِمِ",18,"م",1,1],["خَلَعَ الشَبابُ عَلى الكِنانَةِ مُطرَفاً","هُوَ كَالرَبيعِ عَلى رُبىً وَوِهادِ",19,"د",1,0],["خَلَعَ الزَمانُ شَبابَهُ في أَرضِها","فَهوَ اِشضِرارٌ في السُفوح وَفي الذُرى",20,"ر",2,0],["خَلَعَت عَنها لِباسَ الحُكَما","فَرَأَت عَينايَ بَدراً نَيِّرا",21,"ر",2,0],["خَلَعتُ ثَوباً لَم تُفَضِّلُهُ يَدي","وَهُمتُ في الوادي بِلا سِربالِ",22,"ل",1,0],["خَلَعتَ الصِبا في حَومَةِ المَجدِ ناصِعاً","وَنُزِّهَ فيكَ الشَيبُ عَن لَوثَةِ الأَفنِ",23,"ن",1,0],["خَلَعتُ عِذاري بَل لَبِستُ خَلاعَتي","وَصَرَّحتُ حَتّى لا يُقالَ مُريبُ",24,"ب",1,0],["خلِّ عبءَ الحَيَاةِ عنكَ وَهَيَّا","بمحيًّا كالصُّبحِ طَلْقٍ أَديمُهْ",25,"م",2,0],["خَلَعتَ ثَوبَ الصِفيّ","عَلى العُبَيد الوَفيِّ",26,"ي",1,1],["خلعوك واستلوا إليك يراعهم","فإذا نبا استلوا إليك نعالا",27,"ل",2,0],["خلع الأسرار كاهنه","وبغير الحسن لم يدن",28,"ن",1,0],["خَلَعَ الشَبابَ عَلى القَنا","وَبَذَلتَهُ لِلمُعضِلِ",29,"ل",1,0],["خَلَعَ الزَمانُ عَلى الوَرى أَيّامَهُ","فَإِذا الضُحى لَكَ حِصَّةٌ وَالرَونَقُ",30,"ق",1,0],["خَلَعَت عَلَيكَ حَياءَها وَحَياتَها","أَأَعَزُّ مِن هَذَينِ شَيءٌ يُنفَقُ",30,"ق",1,0],["خَلَعَت عَلَيكِ جَمالَها وَتَأَمَّلَت","فَإِذا جَمالُكِ فَوقَ ما تَكسوكِ",31,"ك",1,0],["خَلَعوكِ مِن سُلطانِهِم فَسَليهِمُ","أَمِنَ القُلوبِ وَمُلكِها خَلَعوكِ",31,"ك",1,0],["خَلَعَتهُ دونَ المُسلِمينَ عِصابَةٌ","لَم يَجعَلوا لِلمُسلِمينَ وُجودا",32,"د",2,0],["خلعتُ بها ريعانَ مجدٍ مؤثَّلٍ","وألبستُ فيها الكأسَ ثوبَ عنادمِ",33,"م",1,0],["خلعتُ عليها نورَ وجهِك فارتدتْ","رداءً من الإحسانِ بالكبر مُعْلَما",34,"م",2,0],["خلعتَ عليه نورَ وجهِكَ فارتدَى","بنورٍ كفاهُ أن يُحادثَ بالصقلِ",35,"ل",1,0],["خَلِّ عَنكَ الناسَ لاتُغرَر بِهِم","وَاِعتَمِد بَحرَ الإِمامِ المُعتَمِد",36,"د",1,0],["خَلِّ عَنّا فَإِنَّما أَنتَ فينا","واوُ عَمرٍو أَو كَالحَديثِ المُعادِ",37,"د",1,0],["خَلَعنا بِها عُذرَ الدُموعِ فَأَقبَلَت","تَلومُ وَتَلحى كُلَّ لاحٍ وَلائِمِ",38,"م",1,0],["خَلِّ عَنّي فَما إِلَيكَ رَشادي","مِن ضَلالي وَلا عَلَيكَ ضَماني",39,"ن",2,0],["خلعت عليك وشي الحمد إني","رأيتك تشتري حمدا بمال",40,"ل",1,0],["خَلَعَ السُّرورُ بِعَرصَتَيْكَ عِذارَه","ما اقتادَ فيك جوى الصَّبابةِ خالِعا",41,"ع",2,0],["خلَعَتْ لواحِظُها على وَجَناتِها","خِلَعَ الجَوانحِ بالدُّموعِ الهُمَّرِ",42,"ر",1,0],["خلَعَتْ عليه من الحريرِ يَلامِقاً","صُفْراً فبينَ مُحلَّلٍ ومُزرَّرِ",43,"ر",1,0],["خلعتُ عليه من ثنائيَ خِلعةً","تَحِنُّ إليها أنفُسٌ وقلوبُ",44,"ب",1,0],["خَلَعَتكَ الدُنيا مِنَ الدينِ حَتّى","صِرتَ تَبغي الدُنيا وَأَنتَ خَليعٌ",45,"ع",1,0],["خَلَعتُ نِعالَ الشَكِّ في قُدسِ رَبعِهِ","فَمِن تُربِهِ كَفّي لِخَدِّيَّ لاطِخُ",46,"خ",1,0],["خَلَعَ الصَباحُ عَليهِ سائِلَ غُرَّةٍ","مِنهُ وَقَمَّصَهُ الظَلامُ بِجِلدِهِ",47,"د",2,0],["خَلَعَ لرَبيعُ عَلى غُصونِ البانِ","حُلَلاً فَواضِلُها عَلى الكُثبانِ",48,"ن",1,1],["خلعتُ إيماني على شكِّها","وبدَّدته السارياتُ الثِّقال",49,"ل",1,0],["خلعت الآدمية فيه عني","ولكن ما خلعت به الإباء",50,"ا",2,0],["خَلَعَتْ عليه غلائلاً ورسيَّةً","شمسٌ تردّ الطرفَ عنه حسيرا",51,"ر",2,0],["خلع اللواءُ عليك عزّ مُمَلَّكٍ","تَخْشَى سُطاهُ أجِنّةُ الأرحامِ",52,"م",1,0],["خلعتُ على بُنيّاتِ الكرومِ","محاسنَ ما خُلِعْنَ على الرسومِ",53,"م",1,1],["خَلَعَتْ معانيها على أَلفاظِها","ألحانَ أشعارٍ ونَقْرَ شَوَادِ",54,"د",1,0],["خَلَعنا عَلى الأَجيادِ أَطواقَ أَذرُعٍ","كَأَنّ لَنا رُوحَينِ في جَسَدٍ فَرْدِ",55,"د",1,0],["خَلَعَ الخصبُ عليه حُلَلاً","لبديع الرقمِ فيهنّ جُدُد",56,"د",1,0],["خِلعَةً مِن أَغَرِّ أَروَعَ رَحبِ الصَد","رِ رَحبِ الفُؤادِ رَحبِ الذِراعِ",57,"ع",1,0],["خَلَعْتُ فِي حُبِّ غِزْلانِ 