{"poems":[[49,"المجد بالرقة مجموع","https://www.aldiwan.net/poem25233.html","السريع"],[53,"مسقم عن سقم جفن","https://www.aldiwan.net/poem66696.html","مجزوء الرمل"],[31,"ما زال فينا رباط الخيل معلمة","https://www.aldiwan.net/poem6162.html","البسيط"],[47,"صبابة راح عنها غير مزجور","https://www.aldiwan.net/poem63640.html","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20991","السريع"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142048","الرمل"],[108,"نعي الشتاء !!","https://www.poetsgate.com/ViewPoem.aspx?id=179458",""],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[230,"بعض هذا الجفاء والعدوان","https://www.aldiwan.net/poem55111.html","الخفيف"],[343,"القول ما صدقه الفعل","https://www.aldiwan.net/poem68707.html","السريع"],[520,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[567,"تقارن اليوم طيب السمع والبصر","https://www.aldiwan.net/poem52782.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122719","البسيط"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87867","البسيط"],[139,"","https://poetry.dctabudhabi.ae/diwan/poem/39760","البسيط"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11341","المنسرح"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87351","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35420","البسيط"],[4767,"الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=179781",""],[592,"يا طالب العلم الشريف الأقوم","https://www.poetsgate.com/ViewPoem.aspx?id=128811",""],[5376,"قفْ ودِّعِ الكفرَ فالإسلامُ في نهم","https://www.poetsgate.com/ViewPoem.aspx?id=188508",""],[5829,"ولد السلام","https://www.poetsgate.com/ViewPoem.aspx?id=178915",""],[6036,"قصيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=84095",""]],"verses":[["لايَثبُتُ العِزُّ عَلى فُرقَةٍ","غَيرُكَ بِالباطِلِ مَخدوعُ",0,"ع",1,0],["لائثٌ مِئْزَرَهُ فَوْ","قَ كثيبٍ تحتَ غُصن",1,"ن",1,0],["لا يَثأَرونَ بِقَتلاهُم إِذا قُتِلوا","وَلا يَكُرّونَ يَوماً عِندَ إِجحارِ",2,"ر",1,0],["لا يَثلِمُ الحَمدَ بِالتَسويفِ في عِدَةٍ","وَلا يُطيلُ المَعالي بِالمَعاذيرِ",3,"ر",1,0],["لا يُثمِنُ البَيعَ ولا يَحمِلُ ال","رِّدفَ ولا يُعطي بهِ قَلبَ خُوص",4,"ص",1,0],["لا يثور المجد في أعراقها","أمة تغدو على النوح وتمسي",5,"س",2,0],["لا يُثلجُ الغيثُ حين يهمي","صدري ولو جفَّت الثمار",6,"ر",1,0],["لا يثقلون وان خفت عيابهم","عن الندى ولهم بالحلم رجحان",7,"ن",1,0],["لا يَثِق بَعضُنا بِبَعضٍ وَهذا","ما أَعدَّ الإِنسانُ لِلإِنسانِ",8,"ن",1,0],["لا يَثبُتُ الفَرعُ إِذا لَم يَكُن","يُقِلُّهُ مِن تَحتِهِ الأَصلُ",9,"ل",1,0],["لا يثقل الروع إلا أن يخف بها","داعي النزال عن التقريب والخبب",10,"ب",1,0],["لا يثبتُ الدَّهرُ في حالٍ فإن كَدِرَتْ","مياهُهُ فانتَظِروا صَفواً من الكَدَرِ",11,"ر",1,0],["لا يَثلُمُ الدّهرُ حَدَّيهِ وَجِدَّتَهُ","والحادِثاتُ وأمّاها صَياقِلُه",12,"ل",2,0],["لا يُثمرُ الشوكُ تمراً تلك طينتُهُ","ان الوحوشَ بهِ أَزكي لعاطفةٍ",13,"ه",1,0],["لايثنيّنك عن كسب الثناء فتىً","يراك مِن حسدٍ بالمنظرِ الشزرِ",14,"ر",1,0],["لا يَثبُتُ الحُرُّ في مَكانٍ","يُنسَبُ فيهِ إِلى الهَوانِ",15,"ن",1,0],["لا يثقُلنَّ علينا ان نُصابَ بِهِ","فالبَدر في كبدِ العلياءِ ينخسفُ",16,"ف",1,0],["لإيثاره الحلالَ آثرَهُ الجلا","لُ جل ومثلما طعمته تُطعمُ",17,"م",1,0],["لا يُثبِتونَ وَلا يَنفونَ ما لَهُمُ","لَعَلَّهُم بِحَقيقِ الأَمرِ آواءُ",18,"ا",2,0],["لا يثني عزمك يا قلمي","كُتَّابُ الجهل وإن غنموا",19,"م",3,0],["لا يثنه صولات باغ إن بغى","كلا ولا جور العداة اللثم",20,"م",1,0],["لا يثْقلنَّ على أزواجِه أبدا","لو شاءَ كان له جيش من الحشمِ",21,"م",1,0],["لا يثنينك عن كريم خصاله","أحد فبادر واطرد الوسواسا",22,"س",2,0],["لا يثنني لوم على شغفي بها","مهما أصر العاذلون وتمتموا",23,"م",3,0]]}