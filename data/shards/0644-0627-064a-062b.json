{"poems":[[47,"المجد بالرقة مجموع","https://www.aldiwan.net/poem25233.html","السريع"],[51,"مسقم عن سقم جفن","https://www.aldiwan.net/poem66696.html","مجزوء الرمل"],[29,"ما زال فينا رباط الخيل معلمة","https://www.aldiwan.net/poem6162.html","البسيط"],[45,"صبابة راح عنها غير مزجور","https://www.aldiwan.net/poem63640.html","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20991","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142048","الرمل"],[106,"نعي الشتاء !!","https://www.poetsgate.com/ViewPoem.aspx?id=179458",""],[223,"بعض هذا الجفاء والعدوان","https://www.aldiwan.net/poem55111.html","الخفيف"],[336,"القول ما صدقه الفعل","https://www.aldiwan.net/poem68707.html","السريع"],[513,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[560,"تقارن اليوم طيب السمع والبصر","https://www.aldiwan.net/poem52782.html","البسيط"]],"verses":[["لايَثبُتُ العِزُّ عَلى فُرقَةٍ","غَيرُكَ بِالباطِلِ مَخدوعُ",0,"ع",1,0],["لائثٌ مِئْزَرَهُ فَوْ","قَ كثيبٍ تحتَ غُصن",1,"ن",1,0],["لا يَثأَرونَ بِقَتلاهُم إِذا قُتِلوا","وَلا يَكُرّونَ يَوماً عِندَ إِجحارِ",2,"ر",1,0],["لا يَثلِمُ الحَمدَ بِالتَسويفِ في عِدَةٍ","وَلا يُطيلُ المَعالي بِالمَعاذيرِ",3,"ر",1,0],["لا يُثمِنُ البَيعَ ولا يَحمِلُ ال","رِّدفَ ولا يُعطي بهِ قَلبَ خُوص",4,"ص",1,0],["لا يثور المجد في أعراقها","أمة تغدو على النوح وتمسي",5,"س",2,0],["لا يُثلجُ الغيثُ حين يهمي","صدري ولو جفَّت الثمار",6,"ر",1,0],["لا يَثِق بَعضُنا بِبَعضٍ وَهذا","ما أَعدَّ الإِنسانُ لِلإِنسانِ",7,"ن",1,0],["لا يَثبُتُ الفَرعُ إِذا لَم يَكُن","يُقِلُّهُ مِن تَحتِهِ الأَصلُ",8,"ل",1,0],["لا يثقل الروع إلا أن يخف بها","داعي النزال عن التقريب والخبب",9,"ب",1,0],["لا يثبتُ الدَّهرُ في حالٍ فإن كَدِرَتْ","مياهُهُ فانتَظِروا صَفواً من الكَدَرِ",10,"ر",1,0]]}