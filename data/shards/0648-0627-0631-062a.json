],[458,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[458,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[458,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[458,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[458,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[458,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[458,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[461,"مظفر الدين والنداء لذي","https://www.aldiwan.net/poem16414.html","المنسرح"],[468,"خمر بدار الفناء","https://www.aldiwan.net/poem60493.html","المجتث"],[477,"تضاعف ما ألقاه غير بديع","https://www.aldiwan.net/poem15269.html","الطويل"],[479,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[482,"أدر المدامة يا نديم إلى الصباح","https://www.aldiwan.net/poem24333.html","عموديه"],[500,"قد تداعت من الأقاح خيوط","https://www.aldiwan.net/poem37784.html","الخفيف"],[500,"وآيات ألواح رقمن مع العما","https://www.aldiwan.net/poem37957.html","الطويل"],[505,"نحن لا نكذب ولكن نتجمّل","https://www.aldiwan.net/poem27793.html","الخفيف"],[505,"الحبّ","https://www.aldiwan.net/poem42456.html","مخلع البسيط"],[510,"وإني ليدعوني السلو فأنثني","https://www.aldiwan.net/poem1593.html",""],[514,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[527,"بسمت فأبدت جيدها فتكشفت","https://www.aldiwan.net/poem45997.html","الكامل"],[529,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[538,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[538,"نحن في الحمراء أسد","https://www.aldiwan.net/poem47929.html","عموديه"],[538,"رب الندى والجود والمجد","https://www.aldiwan.net/poem47953.html","عموديه"],[538,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[551,"يا حادي العيس عرج بي على الدمن","https://www.aldiwan.net/poem47163.html","البسيط"],[551,"يا آل خير عباد الله كلهم","https://www.aldiwan.net/poem47180.html","البسيط"],[551,"من ذا يؤمل بعدك الأياما","https://www.aldiwan.net/poem47233.html","الكامل"],[551,"كم للنواظر من دم مطلول","https://www.aldiwan.net/poem47277.html","الكامل"],[551,"إن العقيق يزيدني خبلا","https://www.aldiwan.net/poem47321.html","أحذ الكامل"],[551,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[551,"كم ذا نخيب وتكذب الأطماع","https://www.aldiwan.net/poem47724.html","الكامل"],[551,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[551,"يا سقى الله ليلتي ليلة السب","https://www.aldiwan.net/poem48082.html","الخفيف"],[551,"ضنت عليك بوصلها لك زينب","https://www.aldiwan.net/poem48104.html","الكامل"],[558,"أنت الذي طول عمري الهم تكفيني","https://www.aldiwan.net/poem33806.html","البسيط"],[558,"بسط الله لي بساط الوجود","https://www.aldiwan.net/poem34593.html","الخفيف"],[558,"من لصب متيم ملتاح","https://www.aldiwan.net/poem34681.html","الخفيف"],[567,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"],[567,"وصب الهوى ما كان من أوصابه","https://www.aldiwan.net/poem69816.html","الكامل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[575,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"]],"verses":[["وَاِرتاحَتِ الآمالُ في","أَطرافِها جَذَلٌ وَلينُ",0,"ن",1,0],["وَاِرتَعتُ حَتّى إِذا لَم يَبقَ لي طَمَعٌ","أَمَلتُ نَهجَ دُموعي غَيرَ مُرتاعِ",1,"ع",1,0],["وَاِرتَجَّ بَعدَكَ كُلُّ حَيٍّ باكِياً","فَكَأَنَّما قُلِبَ الصَهيلُ رُغاءَ",2,"ا",2,0],["وأرْتاحُ للبَرْقِ اليَماني صَبابَةً","وأنْشَقُ خَفّاقَ النّسيمِ تَعَلُّلا",3,"ل",2,0],["وارْتَحَلَ القَلْبُ على إثْرِه","فصِرْتُ أبكِيهِ وقَلبي مَعا",4,"ع",2,0],["وأرَت لهُ الأشياءَ شيئاً واحداً","فَغَدا يُخاطِبُ نَفْسَهُ ويُناجِي",5,"ي",1,0],["وَأَرَتكَ كَفّاً في الخِضا","بِ وَساعِداً مِثلَ الجِبارَه",6,"ر",2,0],["وَأَرَتنا مِنَ الجَديدِ بَياناً","لَم يَكُن قَبلَها كَثيرَ الشُيوعِ",7,"ع",1,0],["وَاِرتَشِف مَعسولَ نَصرٍ أَشنَبٍ","تَجتَنيهِ مِن عَجاجٍ أَلعَسِ",8,"س",1,0],["وَاِرتَفِق بِالسَعدِ في دَستِ المُنى","تُصبِحِ الصُنعَ دِهاقَ الأَكؤُسِ",8,"س",1,0],["وارتدى فيهم رداءً من الع","زِّ وأما حسودُه فترَدَّى",9,"د",2,0],["وارتمت خشعة على اللات","والعزى وهزت ركنيهما بالدعاء",10,"ا",2,0],["وارتضاهُ الأميرُ حين رآه","وارتأى فيه رؤيةً وارتياءَ",11,"ا",2,0],["وارتفاعي عن الجُفاةِ المُسَوِّيْ","نَ بِشَدْوِ المُجيدة الضوضاءَ",11,"ا",2,0],["وارتفعْ أن يراك تكسو الفتى الحُر","رَ إذا ما ملكتَهُ الإزراءَ",11,"ا",2,0],["وارتكابُ الديون إياي في ظِل","لِك يهجوك باللسان الفصيحِ",12,"ح",1,0],["وأرتجي أن تدوم لي دِيَمٌ","من عارض في السماء ذي وَطَف",13,"ف",1,0],["وارتشتُ ريشَ غنىً أطار جديدُه","ما رثَّ من حالي فطار نسيلا",14,"ل",2,0],["وارتياعي في كلّ يومٍ من الإز","عاجِ عن منزلٍ أُحِبُّ نزولهْ",15,"ل",2,0],["وَأَرتاعُ لِلبَرقِ الَّذي مِن دِيارِهِ","فَيَحسَبُ طَرفي أَنَّ ذاكَ اِبتِسامُهُ",16,"م",2,0],["وارتشفْ من فمي الأَناشيدَ سَكرَى","فالهوى ساحرُ الدَّلالِ وَسيمُهْ",17,"م",2,0],["وارتَوَى مِنْ قَطَراتِ الظَّلِّ","في وقتِ السَّحَرْ",18,"ر",1,0],["وارتضى القبرَ مسكناً تتلاشى","فيه أيَّامُ عُمرِهِ المتشابِهْ",19,"ه",1,0],["وأرتمى ثديها وفيه جَفاف","لم يكن للرضيع فيهِ غذاء",20,"ا",2,0],["وارتق الأحجار واصعد منبرا","لم يُسَخَّر لأمير المؤمنين",21,"ن",1,0],["وَاِرتَضى المَلا","مِن بَني الصُلُب",22,"ب",1,0],["وَاِرتَفَعَت كَأَنَّها","شَرارَةٌ مُطَيَّرَه",23,"ر",2,0],["وَاِرتَوى سَيفُها فَعاجَلَها ال","لَهُ بِسَيفٍ ما إِن لَهُ إِرواءُ",24,"ا",2,0],["وَأَرَتكَ أَعقابَ الأُمورِ رَوِيَّةً","مِن حازِمٍ ماضي العَزيمِ مُجَرِّبِ",25,"ب",1,0],["وَأَرتَكَ الهَيجاءُ مِنهُم غُروراً","لِنُجومِ الرِماحِ مِنها وُجوبُ",26,"ب",1,0],["وَأَرَتنا خَدّاً يَراحُ لَهُ الوَر","دُ وَيَشتَمُّهُ جَنى التُفّاحِ",27,"ح",1,0],["وَأَرَتنا السَجّادَ سيما طَويلِ اللَ","يلِ في وَجهِهِ لَها آثارُ",28,"ر",1,0],["وَاِرتِباطُ البِغالِ أُنسٌ مُقيمٌ","لِمُقامٍ وَعُدَّةٌ لِلمَسيرِ",29,"ر",1,0],["وَأَرَتكَ كافوراً وَتِبراً مُشرِقاً","في قائِمِ مِثلِ الزُمُرُّدِ أَملَسِ",30,"س",1,0],["وأرتني المرآة يوما صورتي","فطفقت أبصق للسماجة فيها",31,"ه",2,0],["وأَرَتْهُ خيفَةُ سَيفِه وسِنانِه","لينَ المِهادِ أسِنَّةً وسُيوفا",32,"ف",2,0],["وارتَدَّ مسوَدَّ النَّها","رِ وكانَ مُبيَضِّ الحَنادِس",33,"س",1,0],["وارتدَّ مَنْ جَاراه مُضمِرَ حسرةٍ","لمَّا جرَى للمَجدِ في مِضْمارِه",34,"ر",2,0],["وأَرَتْه بَرْقَ الثُّغورِ فأبدى","بارقَ الشَّوقِ في حَشاه لَهيبا",35,"ب",2,0],["وَأَرَتكَ قَبرَكَ في القُبو","رِ وَأَنتَ حَيٌّ لَم تَمُت",36,"ت",1,0],["وَاِرتاحَتِ النَفسُ إِلى شُربِ راح","قُم هاتِها مِن كَفِّ ذاتِ الوِشاحِ",37,"ح",1,0],["وَأَرتَجيكَ لِعَينٍ أَنتَ مانِعُها","طيبَ الرَقادِ وَقَلبٍ أَنتَ مُتلِفُهُ",38,"ف",2,0],["وَاِرتِشافي مِن خَمرِ فيكِ وَقَلبي","آمِنٌ مِن طَوارِقِ الحادِثاتِ",39,"ت",1,0],["وارتد يضرب وجهي","ضرباً عنيفاً مثيرا",40,"ر",2,0],["وَاِرتِكاضِ الكَرى بِعَينَيكِ في النَو","مِ فُنوناً وَما لِعَينَي غُموضُ",41,"ض",1,0],["وَارَت فَمَ الغارِ عَن عَينٍ تُلِمُّ بِهِ","فَصارَ يَحكي خَفاءً وَجهَ مُلتَثِمِ",42,"م",1,0],["وأرتجي بكَ من ذي العرشِ عافيةً","في الآلِ والحالِ والعلياءِ والعمرِ",43,"ر",1,0],["وَاِرتَجَزَ الرَعدُ يَمُجُّ النَدى","رَيّا وَيَحدو بِمَطايا الرِياح",44,"ح",1,0],["وَاِرتَدَّ لِلشَمسِ طَرفٌ","بِهِ مِنَ السُقمِ فَترَه",45,"ر",2,0],["وَاِرتَجَّ يَعثُرُ في أَذيالِ خَجلَتِهِ","غُصنٌ بِعَطفَيهِ مِن إِستَبرَقٍ وَرَقُ",46,"ق",1,0],["وَاِرتَدَّ يَنظُرُ في نِقابِ غَمامَةٍ","طَرفٌ يُمَرِّضُهُ النُعاسُ كَليلُ",47,"ل",1,0],["وَاِرتَدى مِنهُ عَلى غَضَبٍ","بِحُسامٍ غَيرِ مُنثَلِمِ",48,"م",1,0],["وارتمت هوجاءَ ما يردعُها","فاجعُ الثُّكلِ ولا عادي اليَتَمْ",49,"م",1,0],["وَأَرتبت في الأَقدار لَيلة نَعيه","وَلحدت ريبي يَوم قيل سَيُلحد",50,"د",1,0],["وَاِرتَثَّ حَبلُكَ إِذ نَأَي","تِ بِما يَرِثُّ مِنَ الحَبائِل",51,"ل",1,0],["وَاِرتَفَعَت أَيدي العِبادِ شُرَّعا","بَعدَ الصَلاةِ جُمَعاً فَجُمَعا",52,"ع",2,0],["وَاِرتاحَ مِن حُسنِ الظَفَر","وَمَسَّهُ جِنُّ الأَشَر",53,"ر",1,0],["وَاِرتِواءٌ مِن مُدامٍ في شِفاهٍ","وَاِعتِناقٌ لِغُصونٍ مِن قُدودِ",54,"د",1,0],["وأرَتْنَا فيه غوامضَ فضلٍ","رِقَّةٌ 