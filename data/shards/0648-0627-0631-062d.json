"https://www.aldiwan.net/poem33973.html","مجزوء الكامل"],[406,"من كان لي من حماه خيس ذي لبد","https://www.aldiwan.net/poem32214.html","البسيط"],[426,"فانزل بحضرة يونس","https://www.aldiwan.net/poem40693.html","مجزوء الكامل"],[429,"أبدى شمائل جفوة وبعاد","https://www.aldiwan.net/poem12600.html","الكامل"],[429,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[434,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[438,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[459,"هنيئا لأيام المناسك والتي","https://www.aldiwan.net/poem16025.html","الطويل"],[480,"يا ربنا اجعل خير عمري آخره","https://www.aldiwan.net/poem24529.html","عموديه"],[498,"وحياتكم يا أهل منعرج اللوى","https://www.aldiwan.net/poem37677.html","الكامل"],[498,"جسمي من الكرب المبرح قد عفا","https://www.aldiwan.net/poem37690.html","الكامل"],[498,"القلب يفزع في المهمة ضارعا","https://www.aldiwan.net/poem37696.html","الكامل"],[498,"هب النسيم فسار بالأسرار","https://www.aldiwan.net/poem38018.html","الكامل"],[498,"ليل المحب إذا تطاول بالسهر","https://www.aldiwan.net/poem38019.html","الكامل"],[498,"لله موقفنا بأم عبيدة","https://www.aldiwan.net/poem38028.html","الكامل"],[498,"بين بطاح حيهم والأبطح","https://www.aldiwan.net/poem38037.html","الرجز"],[498,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[512,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[513,"قل للمنية شوى","https://www.aldiwan.net/poem12003.html","مجزوء الكامل"],[513,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[513,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[513,"خطبتني الخطوب بالهم لما","https://www.aldiwan.net/poem12295.html","الخفيف"],[527,"ربنا اشهد لي عليهم","https://www.aldiwan.net/poem37117.html","مجزوء الرمل"],[536,"يا من تكفل لمن دعاه","https://www.aldiwan.net/poem47447.html","عموديه"],[562,"اذكرونا مثل ذكرانا لكم","https://www.aldiwan.net/poem836.html",""],[573,"إني ثنيت عن الحبيب عناني","https://www.aldiwan.net/poem2848.html","الكامل"],[573,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"]],"verses":[["وأرْحَبُ باعاً منكَ كَعْبُ بنُ مُدْلِجٍ","متى ما أُزِرْهُ مِدْحَةً لا أوَبَّخِ",0,"خ",1,0],["وأرْحَبُهُمْ باعاً عَليٌّ ومَزْيَدٌ","إذا السّنَواتُ الشُّهْبُ قَلَّ بها القَطْرُ",1,"ر",1,0],["وَأَرحَمُ خَدَّيها إِذا ما لَحَظتُها","حِذاراً لِلَحظي أَن يُؤَثِّرَ في الخَدِّ",2,"د",1,0],["وَاِرحَمَن صَبّاً شَجِيّاً","قَد أَذابَتهُ الشُجونُ",3,"ن",1,0],["وأرحمتا للثاكليك وكم لهم","ذكرى تحرك من شجون الذاكر",4,"ر",1,0],["وَارَحْمَتَا لِمُصَابٍ","دَامِي الحَشَى مَقْرُوحِهْ",5,"ح",2,1],["وَارَحْمَتَاه قَدْ قَضَى","ذَاكَ المُحِبُّ الأَمِينْ",6,"ن",1,1],["وَارَحْمَتَا لِي مِنْ صُرُوفِ زَمَانِي","أَنَّى رَمَتْ سِهَامَ مَكَانِي",7,"ن",2,1],["وَارَحْمَتَاهُ لِقَومٍ فَارَقوا النِّعَمَا","مِنْ غَيْرِ ذَنْبٍ لَهُمْ وَاسْتَقْبَلُوا النِّقَمَا",8,"م",2,1],["وا رحمتا لشبابي ضاع أطيبُهُ","فما فرحتُ به قد عاد لي تَرَحا",9,"ح",2,0],["وارَحمَتا لِلبائِسينَ فَإِنَّهُم","مَوتى وَتَحسَبُهُم مِنَ الأَحياءِ",10,"ا",2,0],["وَاِرحَم صِباكَ الغَضَّ إِنَّهُمُ","لا يَحمِلونَ وَتَحمِلُ الأَلَما",11,"م",2,0],["وارَحمَتاهُ لِأُرُبّا فَما فَتَكَت","أَفعى بِأَفعى كَأَهليها بِأَهليها",12,"ي",3,0],["وارَحمَتاهُ لِصَبٍّ قَلَّ ناصِرُهُ","فيكُم وَضاقَ عَلَيهِ السَهلُ وَالجَبَلُ",13,"ل",1,0],["وَأَرحُلُها بِالجَوِّ عِندَ حَوارَةٍ","بِحَيثُ يُلاقي الآبِداتِ العَسَلَّقِ",14,"ق",1,0],["وارحميني فقد تهدَّمتُ في كو","نٍ من اليأْسِ والظَّلامِ مَشيدِ",15,"د",1,0],["واِرحَم طُفَيلاً طائِشاً لُبّهُ","جَرّعتَهُنَّ عَلَيهِ لِلبُكاء العَمى",16,"م",2,0],["وَأَرِح جَنبَكَ مِن داءِ الحَسَد","كَم حَسودٍ قَد تَوَفّاهُ الكَمَد",17,"د",1,0],["وَأَرِح شُيوخَكَ مِن تَكاليفِ الوَغى","وَاِحمِل عَلى فِتيانِكَ الأَعباءَ",18,"ا",2,0],["وَأَرحَمُ أَقواماً مِنَ العِيِّ وَالغَبا","وَأَعذِرُ في بُغضي لِأَنَّهُمُ ضِدُّ",19,"د",1,0],["وارحلْ إذا كانت الأوطانُ مَضْيَعَةً","فالمَنْدَلُ الرَّطبُ في أوطانِه حَطَبُ",20,"ب",1,0],["وَارحَم لِرَبِّكَ خَلقَهُ","فَلَيَرحَمَنَّكَ إِن رَحِمتا",21,"ت",2,0],["وارحمتاه للقويّ الصبور","يقضي الليالي في كفاح سخيف",22,"ف",1,0],["وارحمتا وأنا العُبَيْ","دُ من الهوى لِشَجٍ عميدِ",23,"د",1,0],["وا رحمتا للصبّ من لَوعةٍ","بكلّ ريّا الحقف صِفرِ الوشاح",24,"ح",1,0],["وا رحمتاهُ لهُ فإن مصابَهُ","بابنٍ يبرِّحُهُ فكيفَ ابنانِ",25,"ن",1,1],["وارحمتا لحاسدي إذ يدري","ماضيَ أو مضارعي أو أمري",26,"ي",1,0],["وارحمتا للحاسدين فنارُهُمْ","قَدْ سعِّرَتْ بُعْداً لها منْ نارِ",27,"ر",1,0],["وارحمتا لكَ ضاعت في الغرام سُدىً","دُموعُ عينٍ لها سَحٌّ وتهتانُ",28,"ن",1,0],["وارحمتا لكَ ذُبْتَ من حَرِّ الجَوى","في حُبِّ مِصرَ ولم نَفُزْ بِمُرادِ",29,"د",1,0],["وَارَحمتا للمسلمينَ تفرّقوا","وتباعدوا في الأرضِ بعد تَدانِ",30,"ن",1,0],["وارَحمَتا لِلمُسلِمينَ كَأَنَّما","نَزَلوا مِنَ الدُنيا بَوادٍ بَلقَعِ",31,"ع",1,0],["وَارحمتا للرُومِ أَبقَينا بِهم","جُرحاً مَدى الأَيّامِ لا يَلتامُ",32,"م",1,0],["وارَحْمَتا لِمُصَوِّرٍ مَتَطَوِّر","في كلِّ طَوْرٍ صورَةَ المُتَردِّدِ",33,"د",1,0],["وَأَرَحتَهُم مِن فِتنَةٍ تَحيي لهُم","في كُلِّ يَوْمٍ داحِساً وبَسُوسا",34,"س",2,0],["وارَحمَتا لِلأَنامِ كُلِّهِمُ","فَإِنَّهُم مِن هَوى الحَياةِ أُتوا",35,"ت",3,1],["وَأَرَحتُ أَولادي فَهُم في نِعمَةِ ال","عَدَمِ الَّتي فَضَلَت نَعيمَ العاجِلِ",36,"ل",1,0],["وارَحمَتا لِشَبيهي في حَوادِثِهِ","يَنكيهِ ما كانَ في الأَيّامِ يَنكيني",37,"ن",2,0],["وأرحَمُ البرْقَ في مَسراهُ مُنْتَسِباً","لثَغْرِهِ وهوَ مُسْتَحيٍ من الفلَجِ",38,"ج",1,0],["وارحَمْ تَعَثُّرَ آمالي ومُرْتَجَعي","إلى خِداعِ تَمَنّي الوَعْدِ بالفرَجِ",38,"ج",1,0],["وارحل الى أخرى إذا","أَنكَرت يوما بلدا",39,"د",2,0],["وارحمتا للنسر يخفُق قلبهُ","بصبابة القُمريّة البيضاءِ",40,"ا",2,0],["وَارْحَمِيهَا كَرَحْمَتِي وَاذْكُرِيهَا","بَعْدَ هَذَا المُصَابِ ذِكْرَ وَدُودِ",41,"د",1,0],["وَارْحَمَتَا لصِبَاكِ يَا","شِبهَ الأَمَاليدِ النَّوَاضرْ",42,"ر",1,0],["وارَحْمَتَا لِلْمُسْتَقِرِّ بِرِغْمِهِ","وَالْعَزْمُ بَيْنَ ضُلُوعِهِ لَمْ يَهْمُدِ",43,"د",1,0],["وَارَحْمَتَا لَكَ مِنْ قَتِيلٍ","لَمْ يَزَلْ غَضَّ الإِهَابْ",44,"ب",1,0],["وارحمتاهُ من فؤادٍ دامِ!","للطفل بين فكَّي الحِمامِ!",45,"م",1,0],["وا رحمتاه لأوربا فما فتكت","أفعى بأفعى كأهليها بأهليها",46,"ي",3,0],["وارحمتا لليأسين فانهم","موتى وتحسبهم من الاحياء",47,"ا",2,0],["واِرحَم أُخيّاتٍ له مِثلَه","جَرّعتَهُنَّ السُّمَّ والعَلْقَمَا",48,"م",2,0],["وارحم بفضلك غفلتي وتذللي","فالعمد منه دهيت والنسيان",49,"ن",1,0],["وارحم فكم لي بين اسجفة الدجا","نوح عليك تقول نوح حمام",50,"م",1,0],["وارحم ولا تحسد ولاتك حاقدا","فالشهم يطوي الطيبات بباله",51,"ل",2,0],["وارحم فللحب أحوال وتعرفها","والحب احلاه احناه والطفه",52,"ف",2,0],["وارحم لهيفا والها ذا انة","تغنيك انته عن الافصاح",53,"ح",1,0],["وأرحمه فضلاً ولاحظه بمغفرةٍ","فدمعه الفيض قد زادت سوابقه",54,"ق",2,0],["وارحم فقيراً غريباً مادحاً وغدا","ينمي إليك وقد لاذت بك الرسل",55,"ل",1,0],["وارحم غريباً ضعيفاً لاذ فيك فما","إلاك أرجو لعزي بين أقراني",56,"ي",1,0],["وارحم أبي وبنى عمى وطائفتي","وأهل بيتي وأولادي وجيراني",56,"ي",1,0],["وارحم خضوعي وواصل رأفة رحمى","واجبر بفضلك قلباً روحه جزعت",57,"ت",1,0],["وارحم عبداً أتى يدعوك مفتقرا","وأنت واللَه حامه وراحمه",58,"م",2,0],["وارحم عبيداً حين يحشر في غد","من غير حبك ما لديه فتيل",59,"ل",1,0],["وارحم إذا داعى الحساب دعا فأن","ت المرتجي والسيد المأمول",59,"ل",1,0],["وارحل بحبك حيث استبين","لغوث الورى ذاك نجل مامين",60,"ن",1,0],["وارحمتا للكوخ كيف تبرمت","ضجراً صوى اللذات في عنوانه",61,"ن",2,0],["وارحمتا للكوخ إن حضيضه","قد ضم إشفاقاً ذرى بنيانه",61,"ن",2,0],["وارحمتا للكوخ كيف تجهمت","من بعد إشراق وجوه زمانه",61,"ن",2,0],["وَأَرحَضُها غَيرَ مَذمومَةٍ","بِلَبّاتِها العَلَقَ الأَحمَرُ",62,"ر",1,0],["وارحم وَجُدْ حتى يقولَ الناسُ ذا","أَغْنَى الوَرَى من كثْرَةِ الإعطاءِ",63,"ا",2,0],["وارَحمَتا لِمُتَيَّمٍ مَصفودِ","يَسقِي الهوى من قلبه الجُلمودِ",64,"د",1,0],["وأرحْ بذكر البان مهجة مدنفٍ","أضحى عليه العشقُ فرضاً لازما",65,"م",2,0],["وأرِح بها أرواحِ أربابِ الهوى","فالراحُ جُل مرامها وهواها",66,"ا",3,0],["وَاِرحَم عَليلاً ما أَصابَ مُعَلِّلا","وَأَغِث طَريداً لَم يُصادِف مَوئِلا",67,"ل",2,0],["وارح على الفقهاء منه بسيره","وعليه منهم يا فتى قحطان",68,"ن",1,0],["واِرحَلا مِن قَبلِ أَن لا تَرحَلا","فَالبَلايا كُلَّ يَومٍ في اِزديادِ",69,"د",1,0],["وأرحت الفؤاد من كرب ال","همِّ بفكري في مقصر ومطيل",70,"ل",1,0],["وارحل إلى بلد إذا","ما ضاق رزقك في بلد",71,"د",1,0],["وَاِرحَم بهِ علماءَ الدين قاطبةً","مِن أهلِ سنّته ساهٍ ومنتبهِ",72,"ب",2,0],["وَاِرحَم إِلهي أمّة المختارِ","أولِ عِداها غاية الصغارِ",73,"ر",1,0],["وَأَرَحتُ حِلماً كانَ عَنّي عازِباً","وَلَقَد يَؤولُ إِلى ضَريبَتِهِ الفَتى",74,"ا",1,0],["وأرحتها من عربدا","تِ الشكّ والألم الأليم",75,"م",1,0],["وارحمتاهُ لها فقد","زفت إلى السجن الرهيب",76,"ب",1,0],["وارحمتاه له فلم ير راحماً","في قومه ومواسياً ومقيلا",77,"ل",2,0],["وارحمتا للمجد أقوى رَبْعُهُ","من ماجدٍ محضِ النجارِ لباب",78,"ب",1,0],["وارحم محبا في الغرام إليك قد","جذبته أيدي الشوق من أطواقه",79,"ق",2,0],["وارحم الوب العشّاء","دا شيء يجنن",80,"ن",1,0],["وَاِرحَمتى لجناتِهم ماذا جَنَوا","وَقُضاتِهم ما عاقَهُم أَن يَتَّقوا",81,"ق",3,0],["وارحم كئيبا فيك يقضي نحبه","أسفا علي وما انقتض أوطاره",82,"ر",2,0],["وارَحمَتا لِعَزيزٍ","في السِجنِ أَضحى ذَليلا",83,"ل",2,1],["وَأَرحَلُ نافِضاً عَن حُرِّ وَجهي","غُبارَ الذُلِّ مُنتَحِياً بِرُدني",84,"ي",1,0],["وَأَرَحتَ الزَوراءَ مِن جورِ مُزوَر","رٍ عَنِ الخَيرِ فاجِرٍ مَكّاسِ",85,"س",1,0],["وَأَرحَبَ ساحَةً مِنهُ وَداراً","إِذا ضاقَت بِساكِنِها الدِيارُ",86,"ر",1,0],["وَأَرحَلُ عَنكُم إِلى بَلدَةٍ","بِها في الشَدائِدِ مَن يَرفِدُ",87,"د",1,0],["وارحم صغاراً كفراخ القطا","من نادِبٍ حولي ومن مُعوِلِ",88,"ل",1,0],["وارحمتاهُ لمهجتي من غادةٍ","لم تُبقِ غيرَ تردُّدِ الأنفاس",89,"س",1,0],["وأَرحتَني من حِرفَةٍ","تُردى بصاحبها وتُزرى",90,"ر",2,0],["وارحمي قلباً كليماً","لم يجدْ عند الطبيبِ",91,"ب",1,0],["وارحميني ياعيوني","أدْمُعي تِبْرٌ ثمينُ",92,"ن",1,0],["وارحمي بلوى فؤادي","قبل وضعي ضِمْنَ لحدي",93,"د",2,0],["وارحموا صباً إذا جن الدجا","حن مشتاقاً لري ودواء",94,"ا",2,0],["وارحم نبيّ وآبائي وَحاشيَتي","يعمهم با الهي منك اقبال",95,"ل",1,0],["وارحم مَساكين في السجن اِستمر بهم","دهر مَضى وَغَريم الدين مَمطول",96,"ل",1,0],["وارحم مؤلفها عَبد الرَحيم ومن","يَليه من أَهله وأنعشه وافتقد",97,"د",1,0],["وارحمتا لمتيَّمٍ قذفَت به","أ