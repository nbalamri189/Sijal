{"poems":[[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[87,"كان لبعضهم حمار وجمل","https://www.aldiwan.net/poem8010.html","الرجز"],[68,"وكامل العارض قبلته","https://www.aldiwan.net/poem38458.html","السريع"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62227","الطويل"],[102,"كلمة كل نهار","https://www.poetsgate.com/ViewPoem.aspx?id=50427",""],[228,"أتجهل قدر بشر إن بشرا","https://www.aldiwan.net/poem39691.html","الوافر"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[376,"أفردتني وأرى العشاق أقرانا","https://www.aldiwan.net/poem57010.html","البسيط"],[563,"هما الضدان في الأشياء آلا","https://www.aldiwan.net/poem33576.html","الوافر"],[563,"خذوا علمكم بالله لا تتأخروا","https://www.aldiwan.net/poem34489.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77639","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77611","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77575","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77515","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77640","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77544","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77637","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77501","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77497","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77646","الرجز"],[1151,"","https://poetry.dctabudhabi.ae/diwan/poem/204383","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46523","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109255","البسيط"],[1421,"","https://poetry.dctabudhabi.ae/diwan/poem/117111","الرجز"],[1677,"","https://poetry.dctabudhabi.ae/diwan/poem/198592","السريع"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112668","الرجز"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127015","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135254","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75705","البسيط"],[3271,"من مرج عبقر","https://www.poetsgate.com/ViewPoem.aspx?id=104125",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5628,"رثاء صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178672",""],[5736,"نامت على حسرة","https://www.poetsgate.com/ViewPoem.aspx?id=208227",""],[4455,"أنا الصلتاني الذي قد عَلْمتِمُ","https://www.poetsgate.com/ViewPoem.aspx?id=82290",""]],"verses":[["وَقالَ كُلُّ خَليلٍ كُنتُ آمُلُهُ","لا أُلفِيَنَّكَ إِنّي عَنكَ مَشغولُ",0,"ل",1,0],["وَقالَ كَربٌ يا أَخي عَظيمُ","فَقِف فَمشي كُلُّهُ عَقيمُ",1,"م",1,0],["وقال كم أنهاك عن فعل ذا","وأنت ما تفكر في لحيتي",2,"ي",1,0],["وقال كُن منَّا وأوطنْ قُرْطبه","نُدنيكَ فيها من أجلِّ مَرْتبه",3,"ه",1,0],["وقَالَ كُلَيْبٌ اخْضِبُوا لِيَ لحْيَتِي","لَوَ أَنِّي غُدُوٍّاً عِنْدَ مَرْوَانَ أَعْرِفُ",4,"ف",1,0],["وقال كل نهار : لن تنال بد","من ثورة ، مات في ميلادها ، الخطر",5,"ر",1,0],["وَقالَ كَفاكَ تَفَخرُ يا عِصاماً","فَفَخرُكَ مَرَّ في أُذُنَيَّ فَجرا",6,"ر",2,0],["وقال كلا من شجرة النهى مطمعا","له ولها ف الخلد والملكية",7,"ه",1,0],["وقالَ كلّ امرىءٍ مرَّت بمَسمعِهِ","لمَّا رأى عَجباً للنَّاسِ فَتَّانا",8,"ن",2,0],["وقال كذاك وهو الله يعني","لدينا في السموات اشتمالا",9,"ل",2,0],["وقال كتاب الله قدّمه على","عليكم لينفي غيره فتدبروا",10,"ر",3,0],["وقال كنت قد أحب أنسكا","وأشتهي تلذّذي بقربكا",11,"ك",2,0],["وَقالَ كُل مِنهُم رَضينا","بِما أَشاعَهُ الأَمير فينا",12,"ن",2,0],["وَقالَ كَيفَ طارِقٌ يطرقني","مِن بَعدِ راحَةٍ أَتى يُقلقني",13,"ي",1,0],["وَقالَ كُنت عِندَ شاه العَجَم","مِن طرف السُلطان فَخر الأُمَم",14,"م",1,0],["وَقالَ كُلٌّ لَم يَزل مَغلولا","في الحَبس حَتّى يَدفَع المَحصولا",15,"ل",2,0],["وَقالَ كُلّ إِن هَذا القاضي","لَظالِم في هَذِهِ الأَراضي",16,"ي",1,0],["وَقالَ كَم أَمسى بِسوءِ حال","وَكَم بَرى ظَهري مِن الأَحمال",17,"ل",1,0],["وَقالَ كَيفَ العَيش بَعدَ الكنز","يا ذل نَفسي بَعد هَذا العزِّ",18,"ز",1,0],["وَقالَ كُل مِنهُما اِمسِكي الوَسَط","بِالفَم وَاحذَري الكَلام وَاللغط",19,"ط",1,0],["وَقالَ كُل مِنهُم رَضينا","بِما جَرى مِن القَضاء فينا",20,"ن",2,0],["وَقالَ كَم تَسخر بي الأَفراخ","أَلا شراكٌ لي أَلا فخاخ",21,"خ",1,0],["وقال كل لسان في فضائله","قولاً وإن نحروا في الوصف عن لسن",22,"ن",1,0],["وَقالَ كُل إِن عِندي حَقا","للَّه حَسبي منع ذاكَ فسقا",23,"ق",2,0],["وقال كل صحافيّ غدا جرساً","في عنق بغلةِ قاضينا لقد علقا",24,"ق",2,0],["وقال كل منهما لصاحبه","وجهك كالديجور في غياهبه",25,"ه",1,0],["وقال كم عاش وكم حبّني","وحبّه إيّاي قد عذّبه",26,"ب",2,0],["وقالَ كيف قد رأيت ما وَقَع","وفي ذويك اليومَ ما اللَهُ صنَع",27,"ع",1,0],["وقاً لك يا غريب الدار نفسي","وقل بها اذا ما كنت واق",28,"ق",1,0],["وقال كفرٌ راحلٌ إلى العراق","قال النفاق وأنا مَعْكَ وفاقْ",29,"ق",1,0],["وقال كلهم شفاء ذا الجنانْ","قراءة القرآن في كل زمانْ",30,"ن",1,0],["وَقالَ كَم ذا البكا صحي فَقلت لهم","أَنا الغَريق فَما خَوفي من البلل",31,"ل",1,0],["وقال كمَ مرّت الأجيال عابرةً","ولحنهُ في فمِ الأجيال غرّيد",32,"د",1,0],["وقال كتابي وهو لا شك قد حوى","من الشرك بالمعبود خالقنا شرا",33,"ر",2,0],["وقال كبيرهم للبيت ربٌّ","شديد البطش مرهوب الجزاءِ",34,"ا",2,0],["وقالَ كُنْ سيّدَ الأشياء أجمعها","أنتَ القويّ وكلٌّ عاجزٌ ضَرَعُ(5)",35,"ع",1,0],["وقالَ كوني بخيرٍ، دمتِ في ألقٍ","أبغِضْْ به ألقاً لم يشتهِ جمرَهْ",36,"ر",2,0],["وقال كليبٌ قد شرفنا عليكُمُ","فقلتُ لها سُدتْ عليك المطالعُ",37,"ع",1,0]]}