om/ViewPoem.aspx?id=202863",""],[5002,"لغة الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=202661",""],[5135,"حَسْناء","https://www.poetsgate.com/ViewPoem.aspx?id=202011",""],[5187,"وجيه في التسعين","https://www.poetsgate.com/ViewPoem.aspx?id=29067",""],[5219,"ذكريات العيد","https://www.poetsgate.com/ViewPoem.aspx?id=193952",""],[5277,"الحبُّ أمةٌ ووطن وإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=190813",""],[5351,"شكوى سعد","https://www.poetsgate.com/ViewPoem.aspx?id=202099",""],[5376,"ملأ الربيع دماؤنا ونجيعنا","https://www.poetsgate.com/ViewPoem.aspx?id=191854",""],[5397,"الدين في مثل هذا اليوم قد كملا","https://www.poetsgate.com/ViewPoem.aspx?id=157899",""],[5533,"دُوْمَا في القَلْب","https://www.poetsgate.com/ViewPoem.aspx?id=176715",""],[5533,"يا أُمَّةَ المِلْيَار","https://www.poetsgate.com/ViewPoem.aspx?id=180269",""],[5674,"الدروب تخونني","https://www.poetsgate.com/ViewPoem.aspx?id=189654",""],[5701,"يا أيها المُشرق أنى بدا","https://www.poetsgate.com/ViewPoem.aspx?id=164702",""],[5829,"عوراتكم ظهرت","https://www.poetsgate.com/ViewPoem.aspx?id=195347",""],[5887,"رُغمَ الجراح الداميات بغزّةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27996",""],[5956,"سابقاني نحو السما","https://www.poetsgate.com/ViewPoem.aspx?id=192101",""],[5956,"لقاء في مركز مطروح الثقافي","https://www.poetsgate.com/ViewPoem.aspx?id=194006",""],[5956,"أ نَسِيتَ يا قيسٌ مُحِبك خالدا؟","https://www.poetsgate.com/ViewPoem.aspx?id=215382",""],[6093,"يوماً وقفتُ بسَفْحِ الرِّيمِ مُخْتار (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=175996",""],[6093,"يا شاعر الريح","https://www.poetsgate.com/ViewPoem.aspx?id=190885",""],[6093,"لا تقلقي","https://www.poetsgate.com/ViewPoem.aspx?id=196757",""],[6093,"أدعياء الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=198902",""],[6093,"ثعالب النقد","https://www.poetsgate.com/ViewPoem.aspx?id=202605",""],[6093,"لا تلعن النص إن أعيتك قافية","https://www.poetsgate.com/ViewPoem.aspx?id=204337",""],[6093,"طفلا تعلق في المسير بمعصمك","https://www.poetsgate.com/ViewPoem.aspx?id=210879",""],[6160,"أقنِعَةُ الظِّلِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87099&r=&rc=16",""],[6220,"القَلمُ الذّهَبيُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86695&r=&rc=0",""],[6237,"حسناء الريف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77879&r=&rc=21",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""],[6304,"في الشام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82502&r=&rc=9",""]],"verses":[["في الشَرقِ وَالغَربِ أَنفاسٌ مُسَعَّرَةٌ","تَهفو إِلَيكَ وَأَكبادٌ بِها لَهَبُ",0,"ب",1,0],["في الشَرقِ فَاُنظُر هَل تَرى","حَسَباً كَإِسماعيلَ عُدّا",1,"د",2,0],["في الشرق والغرب كم رايٍ لهم ركزت","في مدة هي بين الوِرْد والقَرَب",2,"ب",1,0],["في الشعرِ والإنشاءِ بابنِ نباتةٍ","تزهو على الخطباء والشعراء",3,"ا",2,0],["في الشرق والغرب كلّ ذي قلم","كان شهيراً بذكرها خاسي",4,"س",2,0],["في الشعر أشياءُ يرتاح الكريم لها","مثل اهتزاز قويم المتن خَطّار",5,"ر",1,0],["في الشَرقِ قَومٌ لَم يَسَلّوا صارِماً","وَالسَيفُ فَوقَ رُؤوسِهِم مَسلولُ",6,"ل",1,0],["في الشرق اشجى مشهد","عطف الهضيم على الهضيم",7,"م",1,0],["في الشعر تُحكى الحياة","والنفس والنزعات",8,"ت",1,1],["في الشُموسِ الزُهرِ بِالشامِ اِنتَمى","وَنَمى الأَقمارَ بِالأَندَلُسِ",9,"س",1,0],["في الشَربِ جارِيَةٌ مِن تَحتِها خَشَبٌ","ما كانَ والِدَها جِنٌّ وَلا بَشَرُ",10,"ر",1,0],["في الشَيبِ زَجرٌ لَهُ لَو كانَ يَنزَجِرُ","وَواعِظٌ مِنهُ لَولا أَنَّهُ حَجَرُ",11,"ر",1,1],["في الشِركِ قَد سَبَقا بِكُلِّ كَريمَةٍ","تَعلو القَبائِلَ كُلَّ يَومِ فَخارِ",12,"ر",1,0],["في الشَمعِ أَوصافٌ كَوَصفي أَوجَبَت","حُبّي لَهُ وَالبُعدَ عَن أَضدادِهِ",13,"ه",1,1],["في الشعرِ أم في النحرِ أم في مائس","متمايلٍ أم في الجمالِ الساحرِ",14,"ر",1,0],["في الشَرخِ مِن حِجاهُ","وَالشَرخِ مِن شَبابِه",15,"ب",2,0],["في الشرقِ والشامِ وملكِ مصرِ","يُسمعُ ذكرُ عمرَ المعري",16,"ر",2,0],["فَيا لِشَجا قَلبٍ مِنَ الصَبرِ فارِغٍ","وَيا لِقَذى طَرفٍ مِنَ الدَمعِ مَلآنِ",17,"ن",1,1],["في الشَطرِ مِن حِملاقِهِ المَقلوبِ","عَلى رَفَلٍّ بِالضُحى ضَغوبِ",18,"ب",1,0],["في الشرق والغرب بنت أميّة","سلطنة ليس لها سميّهْ",19,"ه",1,0],["فِي الشَّرْقِ أَوْ فِي الغَرْبِ لاَ عَجَبٌ إذَا","لُقِّيْتَ مَا تَلْقَى مِنَ الإكْرَامِ",20,"م",1,0],["في الشَّامِ فِي لُبْنَانَ جَاءَتْ آيَةٌ","غَرَّاءُ لِلْفَتْحِ الْجَدِيدِ الأَنْوَرِ",21,"ر",1,0],["فِي الشَّرْقِ وَالغَرْبِ يذَاعُ اسْمُهَا","مقْتَرِناً بِالشُّكْرِ مَا رَدَّدَا",22,"د",2,0],["فِي الشرْقِ آفَاقٌ تُرَدِّدُهَا فَمَا","جُدْرَانُ دَارٍ أَوْ سُتُورُ سُرَادِقِ",23,"ق",1,0],["فِي الشَّرْقِ أَوْ فِي الْغرْبِ إِنْ تؤْنِسْ لنَا","دَاراً فثمَّةَ شَمْلُنَا وَالدَّارُ",24,"ر",1,0],["في الشرق والغرب منها رجة رجفت","تكاد تقلب هذا الكون منعدما",25,"م",2,0],["فيا لِشقاء شعبٍ مَشرقيٌٍّ","إذا وجدوا به ملِكاً مُطاعا",26,"ع",2,0],["في الشعر شَحْذٌ لعَزْماتٍ ومُحتَسَبٌ","لطارئآتٍ وترويضٌ لأذهان",27,"ن",1,0],["في الشرق والغرب كراماته","معروفة بين الرجال الكرام",28,"م",1,0],["في الشّامِ جائِحَةٌ تَمورُ بِها","والشَّيْخُ في لبنانَ كَمْ عانى",29,"ن",2,0],["في الشَّكْل والنَّكْهة والرُّضاب","مَلْمَسُهاَ كوَجْنَةِ الكَعاب",30,"ب",1,0],["في الشفاهِ اللُّعسِ ما يشفي الألمْ","ودوا القلبِ فمٌ من فوقِ فمْ",31,"م",1,1],["في الشَّامِ أشتاقُ عيشاً طيباً بهجا","فالقلبُ فيهِ مع الأثمارِ قد نضَجا",32,"ج",2,1],["في الشرقِ والغربِ لاذَ المؤمنونَ بها","واستجمعوا حولَها جنداً وحجّابا",33,"ب",2,0],["في الشقصِ لو تعصي المنى مقنَعٌ","وأنت لا يقنعكَ الشقص",34,"ص",1,0],["في الشربِ ما النَّدمانُ إِذ","يَشرَبُها نَدمانُ",35,"ن",1,0],["في الشامِ ما يدع الحليمَ محمّقاً","جمحتْ به خيلُ الأَناةِ جماحا",36,"ح",2,0],["في الشّرقِ والغَربِ لا يُفْضي إلى سَعَةٍ","ذو الذَّنْبِ إلاّ إذا ما كنتَ مُغتَفِرا",37,"ر",2,0],["فَيا لَشُجاعٍ إِن لَقيتُ بِهِ الهَوى","وَإِن أَلقَ أَحباباً فَيا لِجَبانِ",38,"ن",1,0],["في الشرع يلقاه لها يقاتل","فرحان ما يرجع لقول قائل",39,"ل",1,0],["في الشرق والغرب منها والتهائم بل","والبحر قد خافهم في البحر حيتان",40,"ن",1,0],["فِي الشمس والبدرِ المينرِ إِذَا","جاءَا بِنجمٍ صِحَّةُ النَّسْلِ",41,"ل",1,0],["في الشام دار الكتب مجد لنا","نود ان نجعلها جنه",42,"ن",2,1],["في الشتاءِ العويلُ والأشجانُ","للألى هان حظهم منذ هانوا",43,"ن",3,1],["فيا لشهادةٍ بالجود زوراً","جرت ومدائح ذهبت ضَياعا",44,"ع",2,0],["في الشيبِ زَجرٌ لَهُ لَو كانَ يَنزجِرُ","وَبالِغٌ منه لَولا أَنَّهُ حَجَرُ",45,"ر",1,1],["في الشِّعرِ يحتفلُ الوجودُ بقِصَّةِ ال−","تكوينِ.. فادخلْ بي مجَرَّةَ حَفْلِهِ",46,"ل",2,0],["في الشمعدانِ رأى أعوامَهُ جُثَثاً","صرعَى فمال على نعشٍ يُشَيِّعُهُ",47,"ع",2,0],["فيا لشجاعةٍ بك ما أفادتْ","من النّعماء عندك للموالي",48,"ل",2,0],["في الشَّرْقِ غَرْبٌ للبلادِ كَشَرقِها","يَجُلو بهِ القَمرانِ عينَ الرائي",49,"ا",2,0],["في الشعر نبغي نابغاً ليجيدا","مدحاً كنظم الدر فيك نضيدا",50,"د",2,1],["في الشرق والغربِ كَم أبقيت مِن أثرٍ","وفيك كَم علَم للمَجد قد رُفِعا",51,"ع",2,0],["في الشرقِ شمسٌ للنهارِ نظيرُها","في الغربِ شمسٌ ليسَ يغربُ نورُها",52,"ر",3,1],["في الشرقِ كاسٌ وفي مغاربها","قُرْطٌ وفي أوْسَطِ السما قدَم",53,"م",1,0],["في الشَهر نَفسه لِيَوم أَكا","سُبحانَ مَن أَضحَكنا وَأَبكى",54,"ك",2,0],["في الشاطئ الرجراج حي","ث تضرج الحق الصريحُ",55,"ح",1,0],["في الشرع دورانِ غير وهم","دور حساب ودور حكمي",56,"م",2,1],["في الشتوة الغبراء لا","تغني الكرام غناءها",57,"ا",3,0],["في الشيب جاء به سروراً لم يجئ","في مثله مُذ كان مقتبلُ الصِبا",58,"ب",2,0],["في الشَرقِ وَالغَربِ غَدا ذِكرُهُ","يَسيرُ مِن بَلخٍ إِلى فاسِ",59,"س",1,0],["في الشم من أَصنافنا","أَهلاً وَسَهلاً مرحبا",60,"ا",1,0],["في الشرق والغرب آيات تطوف بها","رسل البشائر من شادٍ ومرتسم",61,"م",1,0],["في الشرق كان شروقها وامتدّ في","كل الدنى وغدا الغروب حبيسا",62,"س",2,0],["في الشرق والغرب من أخباره أرج","ما نورها قط في أفق بمكتمن",63,"ن",1,0],["فَيا لشهيد مثلت فيه هندكم","فَجاءَت بما لا تعرف الناس منكرا",64,"ر",2,0],["فيا لشقاءِ العلم ذل تواضعاً","ويالهناءِ الجهل حين تعالى",65,"ل",2,0],["في الشام أَلقاب مُوزَّعَةٌ","لَم تَعدُ فيها القال وَالقِيلا",66,"ل",2,1],["في الشَرطَينِ وكذا العَنَاقِ","ثُمَّ الحمارينِ على الإطلاقِ",67,"ق",1,0],["في الشَّرقِ مَع ساحِلِ برِّ الهَمَجِ","والبَحرِ فيما بينهُم للمنتجِ",68,"ج",1,0],["في الشَّامِ أنتَ هَوَىً وفي بَيْرُوتَ أغنيةٌ ورَاحُ","أهلي وأهلُكَ وَالحَضَارَةُ وَحَّدَتْنا وَالسَّمَاحُ",69,"ح",1,0],["فيال شبام أنتم الجنة التي","يلاقى بها جيش العدو المغالب",70,"ب",1,0],["في الشعر تأسائي وفيه رفاهتي","وإليه أشكو قسوة الأقدار",71,"ر",1,0],["في الشعر تبدو لي مناظر جمةٌ","فتكاد تُمسك لي الفؤادَ وتأسرُ",72,"ر",1,0],["في الشيب هل تصلح لي حالةٌ","ما صلُحتْ والشّعر مسوَدُّ",73,"د",1,0],["في الشام لم أسكن ورّبك لحظة","لو لم تقيّدني بها أسقامي",74,"م",2,0],["في الشّعر إن أفرغت روحك لم يمت","فله بروحك دائماً إحياء",75,"ا",2,1],["فيا لشيخ قد هاج مصطخبا","وما اشتكى من هياجه نصبا",76,"ب",2,0],["في الشّعر قدماً قد أتى متنبّئٌ","وشعاع شعري للتنبؤ ماحِ",77,"ح",1,1],["في الشّعر معنىً مصلحٌ يسمو على","معنى يعظّم شأنه القرّاء",78,"ا",2,1],["في الشرقِ والغرب يُرى ظاهراً","ومثله في الفتح والفاتحه",79,"ح",2,0],["فيا لشبيب هاكم الخَيل ضحوة","علت في هضاب المَجد بِالفارس القرم",80,"م",1,0],["في الشمس والبدر وريم النقا","نظائر منه واشباه",81,"ا",2,0],["في الشفة العليا وفي السفلى","في الغنج أو في المشية الكسلى",82,"ا",1,0],["في الشرفة الصبح كنت","على وجوم وصمت",83,"ت",1,0],["في الشَرعِ وَالقُرآنِ حُرِّمَ شُربُها","وَكِلاهُما لا شَكَّ مُتَّبَعانِ",84,"ن",1,0],["في الشَرق مَنزله وَفي الغَرب الهَوى","بَعداً كَما قَرب الهَوى لهوانه",85,"ن",2,0],["في الشمس، أو في الروض أو في الطير أو","في الجدول المترقرقِ",86,"ق",1,0],["في الشمسُ حَلَّت والبُدُورُ وأنجُمٌ","تَجَلَّت مُبِيناتٍ سَنَاها لِمُغسِفِ",87,"ف",1,0],["في الشافعي حبر الورى","سر الشريعة قد سرى",88,"ر",2,1],["فيا لشقا ابنةٍ وشقا","أبٍ بنشوئها ابتهجا",89,"ج",2,0],["في الشَرِّ تَرانيَ ابنَ حَربٍ بَطَلاً","لَكنّيَ مِن شيعَةِ مَولايَ علي",90,"ي",1,0],["في الشَمسِ يَروم عاذِلي مصباحا","يَكفينيَ ما شاهده الإِفصاحا",91,"ح",2,1],["في الشَوكَةِ أَطرافُ رِماح نَفذت","كَي يعقدَ تيجان نُضارِ الوَردِ",92,"د",1,0],["في الشِبهِ وَالتَرتيبِ وَالمَفاعَلَهْ","وَكُلُّ هذي لا شِتقاقَ آئِلَهْ",93,"ه",1,0],["فيا لشموس تزين الرحاب","ويا لبدور تزين الحرابا",94,"ب",2,0],["في الشام سحر بيانه فتن النهى","وصباله في بابل الملكان",95,"ن",1,0],["في الشَرق تَنطلق القَرائح فَجة","وَالشَرق مُنقَلب عَلى أَعقابه",96,"ب",2,0