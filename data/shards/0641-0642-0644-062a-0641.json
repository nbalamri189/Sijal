{"poems":[[88,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[74,"رب أديب رأى كتابا","https://www.aldiwan.net/poem18633.html","مخلع البسيط"],[53,"قالوا ابن يوسف مستوه فقلت لهم","https://www.aldiwan.net/poem8509.html","البسيط"],[53,"وقائل كيف تهجو","https://www.aldiwan.net/poem61920.html","المجتث"],[53,"أبا علي طلبت عيبك ما اسطعت","https://www.aldiwan.net/poem65452.html","المنسرح"],[53,"أيا ابن المعلى كن معلى ولا تكن","https://www.aldiwan.net/poem65791.html","الطويل"],[91,"هل الرزايا يا ترى عالمه","https://www.aldiwan.net/poem44956.html","السريع"],[91,"ليس البليد الجاهل","https://www.aldiwan.net/poem45078.html","مجزوء الرجز"],[87,"يقولون لم تطرى عليا وأخته","https://www.aldiwan.net/poem7248.html","الطويل"],[87,"فأر رأى القط على الجدار","https://www.aldiwan.net/poem8031.html","الرجز"],[58,"وليلة بات طل الغيث ينسجها","https://www.aldiwan.net/poem58473.html","البسيط"],[30,"ومن حين قحطاني سجستان أصبحوا","https://www.aldiwan.net/poem5106.html","الطويل"],[68,"شكوت إلى الحبيب أنين قلبي","https://www.aldiwan.net/poem39679.html","الوافر"],[50,"وأحور ذمي طرقت فنائه","https://www.aldiwan.net/poem63278.html","الطويل"],[71,"","https://poetry.dctabudhabi.ae/diwan/poem/57715","المجتث"],[50,"فُؤادي صَبورٌ وَاللِسانُ كَتومُ","https://www.poetsgate.com/ViewPoem.aspx?id=11860",""],[125,"مييمن سائمتي بمتين","https://www.aldiwan.net/poem23823.html","المتقارب"],[132,"وقلت له لقياك خير علالة","https://www.aldiwan.net/poem50574.html","الطويل"],[139,"يا مغرما بالصرف","https://www.aldiwan.net/poem49037.html","المجتث"],[203,"أبصرته تحت ظلام الدجى","https://www.aldiwan.net/poem45595.html","السريع"],[208,"وذي فطنة نكته في استه","https://www.aldiwan.net/poem53231.html","المتقارب"],[261,"ضربت في الإبرام يا سيدي","https://www.aldiwan.net/poem48502.html","البسيط"],[275,"فتاتي الصغيرة تهوى النقارا","https://www.aldiwan.net/poem35454.html","المتقارب"],[302,"بنفسي هيفاء المعاطف ناهد","https://www.aldiwan.net/poem33285.html","الطويل"],[358,"هواي سليم الود لا متشاعث","https://www.aldiwan.net/poem40551.html","الطويل"],[369,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[422,"إن مليك العصر من قد علا","https://www.aldiwan.net/poem53898.html","السريع"],[473,"وعاشق باح لي بما باحا","https://www.aldiwan.net/poem60280.html","المتقارب"],[567,"قد بات داود عيسى الحلو في حلل","https://www.aldiwan.net/poem52573.html","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66712","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34481","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34420","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130183","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96741","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202130","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78121","المواليا"],[1455,"","https://poetry.dctabudhabi.ae/diwan/poem/198840",""],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49072","السريع"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49068","الرجز"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26566","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52114","الوافر"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60968","الوافر"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113882","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204758","المنسرح"],[3092,"","https://poetry.dctabudhabi.ae/diwan/poem/216350","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87649","البسيط"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/2","الطويل"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199168",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92235","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91315","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117962","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85271","السريع"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44891","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136621",""],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/143324","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120289","الطويل"],[5102,"التلاميذ القدوة","https://www.poetsgate.com/ViewPoem.aspx?id=14906",""],[5273,"مأساة العاصي","https://www.poetsgate.com/ViewPoem.aspx?id=28757",""],[5277,"الهوى العراقي...","https://www.poetsgate.com/ViewPoem.aspx?id=194162",""],[5582,"أَلا هَلْ رأَتْ عَيْناكَ لِلْحَيِّ أَظْعانَا","https://www.poetsgate.com/ViewPoem.aspx?id=63594",""],[3469,"أرى جارتي خَفّتْ، وخفّ نَصيحُها","https://www.poetsgate.com/ViewPoem.aspx?id=5339",""],[5587,"ماذا أقول","https://www.poetsgate.com/ViewPoem.aspx?id=195385",""],[5672,"تدلع","https://www.poetsgate.com/ViewPoem.aspx?id=206542",""],[5770,"إلى التي خطرت بالبال","https://www.poetsgate.com/ViewPoem.aspx?id=178677",""]],"verses":[["فَقُلتُ في غِبطَةٍ لِلَّهِ دَرُّهُمُ","لَيسَ الفَلاحُ لِوانٍ غَيرِ يَقظانِ",0,"ن",1,0],["فقلت في الحال يا كتابي","غيب وإلا سلخت جلدك",1,"ك",1,0],["فقلت في دون هذا الأمر بيِّنةٌ","للمُستدِلِّ وعلمُ الغيب محجوبُ",2,"ب",1,0],["فقلتُ في الله ربِّي","وقاسمٍ لي رَدُّ",3,"د",1,0],["فقلت في الله ما وقى رجلاً","إن ميح أعفى وإن أريب عفا",4,"ف",2,0],["فقلتُ فكلِّف منْ رأيتَ انتساخَهُ","فماطَلْتني حَولاً بذاك دكيكا",5,"ك",2,0],["فقلت في وفاتها أرِّخوا","لقد ثوت وا أسفا سالمه",6,"م",2,0],["فقلت في جوابه","وقد يجيد القائل",7,"ل",1,0],["فقلت فؤادى للثلاثة منزل","هما طُنُباه والحسين صميم",8,"م",1,0],["فَقُلتُ في المَقامِ قَولاً شاعا","مَن حَفِظَ الأَعداءَ يَوماً ضاعا",9,"ع",2,0],["فقلتُ فيها لِسَاقينا وفي يَدِهِ","كَأْسٌ كَشُعْلَةِ نارٍ باتَ يُوهِجُها",10,"ج",3,0],["فَقُلتُ فِدىً أُمّي لَهُ حينَ صاوَلَت","بِهِ الحَربُ نابَي رَأسِها حينَ شَمَّرا",11,"ر",2,0],["فَقُلتُ فَإِنَّكُم لَوُلاةُ أَمرٍ","عَلى أَهلِ الغَرامِ فَقالَ إِنّا",12,"ن",2,0],["فَقُلتُ فَماذا مَهرُها قالَ مَهرُها","إِلَيكَ فَسُقنا نَحوَهُ خَمسَةً صُفرا",13,"ر",2,0],["فقلتُ فرعٌ منيفٌ","قالتْ وأصلٌ شريفُ",14,"ف",1,0],["فقلت فزدني قال إن سمت ربها","فبالرطل ديناراً عليك يسوم",15,"م",1,0],["فقلت فلا تعذلي لرهين","هواك فإن الملام يقين",16,"ن",1,0],["فقلت فهلْ من راحةٍ قال لي فلا","أرَى راحةً إلا لمن يؤالفُ",17,"ف",1,0],["فقلت في تاريخهِ","أبهج بطبع الظرفِ",18,"ف",1,0],["فقلتُ في الخدينِ نارُ الحشا","فقالَ لكنْ فيهما جنتانِ",19,"ن",1,0],["فقلتُ فديتُكَ من أحمقٍ","فقال وأحمقُ لا ينصرفْ",20,"ف",1,0],["فقلت في ذلك لا تعجبوا","من متخمٍ يفسو على جائع",21,"ع",1,0],["فقلتُ فَديتُكِ لا تنفُري","ولو كنتُ منكِ أحبُّ النفارا",22,"ر",2,0],["فَقُلتُ فدتكِ النَفسُ صَبراً فإنَّها","مواردُ لا يُصدِرنَ من لا يجالدُ",23,"د",1,0],["فَقُلت فَدَتكَ النَفس لَوني وارس","فَقال ليَ اِذهَب إِنَّني لَكَ وارثُ",24,"ث",1,0],["فقلتُ في جُنْحِ ليلٍ وهْي واقفةٌ","ونحن في حَضْرة جَلَّتْ أَياديها",25,"ي",3,0],["فقلتُ في نعمة سلطاننا","من كَلِمي ما رقَّ منها وراق",26,"ق",1,0],["فَقُلتُ في مَعرِضٍ أُمازِحُهُ","فيهِ وَما كُنتُ قَطُّ مَزّاحا",27,"ح",2,0],["فقلتُ في نظمِ تأريخٍ لعُصبتِهِ","يدومُ في آلِ عيسَى ذِكرُ داودُ",28,"د",1,0],["فقلتُ فهَبني قد تهوّدتُ برهةً","وإلاّ فدِيني دينُ من يَتَنَصَّرُ",29,"ر",1,0],["فَقُلتُ فدتكَ النَفسُ سَمعاً وَطاعَة","وَلَم أَرَ نَهياً منه أَهنا وَلا أَمرا",30,"ر",2,0],["فقلت فقدتُ العَينَ إِن لَم أَجد بِها","جفانَ جُفون للدموع جَوابي",31,"ب",2,0],["فقلت في نفسي ألا","ليتك قبلت فمي",32,"ي",1,0],["فَقلت فما واللّه لم تكُ رِحلتي","ليحدثَ لي عنكم فراغاً وسلوانا",33,"ن",2,0],["فقلت فضلا من إله مفضل","وُيمْن جد لمليك مقبل",34,"ل",1,0],["فَقُلتُ فَرط الضَناء وَالعَنا سيان","شَواهد الصدق لي حَيوهُما حَيّا",35,"ا",1,0],["فقلت في كلّهم","قول امرئ مقتصد",36,"د",1,0],["فقلت في تاريخه بشروا","عاش وليد المصطفى نائفا",37,"ف",2,0],["فقلتُ في التاريخ زِدْ يا قارئاً","نِعمَ الفتى الدكتورُ إبراهيم",38,"م",1,0],["فَقُلتُ فَتىً إِن شِئتُما كَتَمَ الهَوى","وَإِلّا فَخَلّاعُ الأَعنَّةِ وَالعُذرِ",39,"ر",1,0],["فقلت فتحت من أمري عويصا","فضمّ الميم أعجل بالبشاره",40,"ر",2,0],["فقلتُ فما سَهامُ اللحظ منهاَ","فقال إذا رنتْ رمتِ الفؤادا",41,"د",2,0],["فقلتُ فخِلِها عنا فغنَّا","أردتُ وغير قلبك ما أرادا",41,"د",2,0],["فقلت في وصفه الباهي أؤرخه","بزارع الود تبدو زينة العيد",42,"د",1,0],["فقلت في النفس شاعر كولد","ذو طلبات ما ان تحد بحد",43,"د",1,0],["فقلت فهل يسخو الزمان بعودهم","فقال لعل الدهر يسخو خؤونه",44,"ن",2,0],["فَقُلتُ في يوم بِشرٍ ارَّخوهُ لها","انتَ النَسيبُ اليك المجد يَنتَسِبُ",45,"ب",1,0],["فَقُلتُ فِراقُ الدارِ أَجمَلُ بَينَنا","وَقَد يَنتَئي عَن دارِ سَوءٍ نَزيحُها",46,"ح",3,0],["فقلت في تاريخه","خليل باشا في كلاحْ",47,"ح",1,0],["فَقلت فديتُكم يا قَومُ هاتوا","أَروني غيرَها من قال صدقا",48,"ق",2,0],["فَقُلت فَدتك الرُوحُ دَعنا لما دَعَت","إِلَيهِ الأَماني مِن وِصالٍ وَنَشوة",49,"ه",1,0],["فقلت فجرتم في الذي تزعمونه","بتجويزكم ما كان ممتنعاً عقلا",50,"ل",2,0],["فقلت في الأعتاب ماذا الجفا","أن الوفا بالعهد دين الكرام",51,"م",1,0],["فَقُلتُ في نَفسي إِذا","اسألها في أَدبِ",52,"ب",1,0],["فقلت فدتك النفس بشِّر أحبتي","بأني إن شاء الآله لَقادم",53,"م",1,0],["فقلتُ فلو نفَّسْتِ عنّي كربةً","بقربِكِ قالت ذاك يُغري بك الكربا",54,"ب",2,0],["فقلت فهل لي في وصالكِ مَطمعٌ","فقالت إذا ما شمسنا طلعَتْ غَربا",54,"ب",2,0],["فقلتُ فهل من زَورةٍ يجتني بها","ثمارَ المُنى ظمآنُ قد مُنِعَ الشُّرْبا",54,"ب",2,0],["فقلت فهم يشكونني ان شكوتهم","فقالت اذا فالصمت للمبتلى آسى",55,"س",2,0],["فقلتُ في نفسي أنعِم بِهِمْ","ومِمَّنْ يُربُّونهم من كِرامْ",56,"م",1,0],["فَقُلتُ في غُصَّةٍ تغتالُ أحْرفَها","واليأسُ عاصفةٌ يفنى بها الأملُ",57,"ل",1,0],["فقلتُ: \"فديتُها أرضاً وأهلاً","وما قد فاءَ عنها العمرَ وفَّى\"",58,"ف",2,0],["فَقُلْتُ ( فَما ) وَاللهِ لَمْ تَكُ رِحْلَتِي","لِتُحْدِثَ لِي عَنْكُمْ فَراغاً وَسُلْوانَا",59,"ن",2,0],["فقلت: فراقُ الدارِ أجملُ بينِنا","وقضدْ يَنْتَئِ عن دَارِ سَوْءٍ نَزِيحُهَا",60,"ح",3,0],["فَقُلْتُ فِي حَرْفِ شِعْرٍ مَا يُرَاوِدُنِي","فِي سَهْرَةِ الحَرْفِ تِذْكَارُ بِهِ قَلَمُ",61,"م",1,0],["فقلت : \"فدتك الخمر ... بل انت كرمة","تنازعني في العصر....والموعد العصرُ\".",62,"ر",1,0],["فقلت فاتنتي : رفقاً ومعذرةً","إنّ القوافي تُوافي من يوافيها",63,"ي",3,0]]}