{"poems":[[53,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[77,"النصر نصك والحسام دليله","https://www.aldiwan.net/poem36377.html","الكامل"],[88,"كان أبو الطيب امرأ قوله","https://www.aldiwan.net/poem44436.html","المنسرح"],[4,"درس المنا بمتالع فأبان","https://www.aldiwan.net/poem21206.html","الكامل"],[89,"الشعر ما قاله الكرخي عبود","https://www.aldiwan.net/poem44750.html","البسيط"],[62,"وذوات أجساد نكهن ضعائف","https://www.aldiwan.net/poem52219.html","الكامل"],[97,"دينٌ وهذا اليومُ يومُ وفاءِ","https://www.aldiwan.net/poem24752.html","الكامل"],[97,"ها هنا حفل وذكرى ووفاء","https://www.aldiwan.net/poem24983.html","الرمل"],[52,"منزل أقوى بسلمى وربوع","https://www.aldiwan.net/poem26865.html","الرمل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[46,"السعد يجعل ذري الدبى نعما","https://www.aldiwan.net/poem22663.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55019","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54967","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54543","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[129,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[129,"هجرت بعدك العيون الرقادا","https://www.aldiwan.net/poem50641.html","الطويل"],[129,"من لصب تصاعدت حسراته","https://www.aldiwan.net/poem50653.html","الخفيف"],[283,"أنت في الدهر للعديل عديم","https://www.aldiwan.net/poem32453.html","الخفيف"],[301,"عوجوا فحيوا أيها السفر","https://www.aldiwan.net/poem45485.html","أحذ الكامل"],[329,"أعيش أم أدع الأيام للناس","https://www.aldiwan.net/poem55006.html","البسيط"],[343,"صرفند معقل الاحرار ما","https://www.aldiwan.net/poem55320.html","الرمل"],[343,"الضحايا معناهم الشهداء","https://www.aldiwan.net/poem55366.html","الخفيف"],[367,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[403,"وافاك يصحبه الإسعاد والظفر","https://www.aldiwan.net/poem46940.html","البسيط"],[417,"إنما هذا لعمري مركب","https://www.aldiwan.net/poem53833.html","الرمل"],[417,"يا بني الشيخ والغياث المرجى","https://www.aldiwan.net/poem53846.html","الخفيف"],[430,"يا خليلا لم أكن عنه خلي","https://www.aldiwan.net/poem41022.html","الرمل"],[433,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[459,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[539,"يوم أناخ بباب خير إمام","https://www.aldiwan.net/poem47941.html","عموديه"],[539,"ذا اليوم تحسد مجده الأيام","https://www.aldiwan.net/poem47942.html","عموديه"]],"verses":[["خَلِّ دَمعي وَطَريقَه","أَحَرامٌ أَن أُريقَه",0,"ق",2,1],["خَلَّدْتَ سِرَّ النَّصْرِ فِي أَعْقَابِهِ","وَسَلَكْتَ قَصْداً لاَ يُضَلُّ سَبِيلُهُ",1,"ل",2,0],["خلّد ذكراً لسيف دولتها","أيام وشى بمدحه خلله",2,"ل",2,0],["خَلَدَت وَلَم يَخلُد بِها مَن حَلَّها","وَتَبَدَّلَت خَيطاً مِنَ الأُحدانِ",3,"ن",1,0],["خلدت شعرك اذ جددت كسوته","من البيان وفي التجدبد تخليد",4,"د",1,0],["خلدت فلا نار على إحراقها","قدرت ولا ماء على إغراقها",5,"ق",3,0],["خلدت على الدنيا وزادت روعةً","ممّا كساها سيدُ الشعراءِ",6,"ا",2,0],["خلدت على الدنيا وزادت روعةً","من جودة التمثيل والإلقاءِ",6,"ا",2,0],["خلدت أنوارهم رغم البلى","وبها المدلج في الليل استضاء",7,"ا",2,0],["خَلَدَ الغَدرُ وَلَم يَبقَ وَفاً","لَيسَ إِلّا كاذِبُ العَهدِ قَطوعُ",8,"ع",1,0],["خَلّدتُمُ في العبشمِيّةِ لَعْنَةً","خلقت وما خلقوا لها تعجيلا",9,"ل",2,0],["خَلَّدتُهُنَّ بِسِجنِ السِرِّ مِن خَلَدٍ","سَوداؤُهُ مِن أَعادي البيضِ في الخُمُرِ",10,"ر",1,0],["خَلَّدْتَ بِالشَّعْرِ لَهَا صُورَةً","مِنَ الطِّرَازِ العَبْقرِيِّ البَدِيعْ",11,"ع",1,0],["خلدْتمَاهُ فِي الْفَرِيقِ الأَولى","بَنَوا فَخَارَ الزمَنِ الحَاضِرِ",12,"ر",1,0],["خُلِّدَتْ بالجُودِ ذِكْرَاكَ التي","خُلِّدَتْ بالنُّبْلِ قبلاً وَالذَّكاءِ",13,"ا",2,0],["خَلَدَتْ عَلَى الأْيَّامِ ذِكْرَى رُفْقَةٍ","كَنِظَامِ شُهْبٍ أَوْ كَعِقْدِ لآلِي",14,"ل",2,0],["خُلِّدْتِ سامراءُ ، لم أوصِلْكِ مِن","فَضْلٍ حَشَدتِ عليَّ غيرَ قليله",15,"ل",2,0],["خلّد اللْهُ مُلكه وَوَقاهُ","اللَّهُ من شر يومه القمطريرِ",16,"ر",1,0],["خلّدَ الله مُلككمُ واصْطفاكم","واجْتباكمْ إذْ صِرتمُ أَمجادَا",17,"د",2,0],["خلَّدَ الله ملككم وارتضاكُم","في زمانٍ زانت بكم جُمْعَاتُه",18,"ت",2,0],["خَلَّدَ اللَهُ دَولَةَ المَلِكِ العا","دِلِ ما زانَتِ السَماءَ النُجومُ",19,"م",1,0],["خَلَدَ الجُبَيبُ وَبادَ حاضِرُهُ","إِلّا مَنازِلَ كُلُّها قَفرُ",20,"ر",1,0],["خلّدت شعري في نفسي وأحسَبُه","سينتهي حينما تنشقّ أرماسي",21,"س",2,0],["خلدته مسحة صوفية","ذات سحر بابلي مجتنى",22,"ن",2,0],["خلدتهم بطولة وارتخاص","للمنايا وهمة قعساء",23,"ا",2,0],["خَلَّدتَ جودَكَ في أَهلي فَأَذكَرَني ال","دُنيا وَأَمَّنَني تَخليدُكَ الأَجَلا",24,"ل",2,0],["خُلدٍ وافاها الورى فرأوا","فوقَ الذي سَمعوا منها الَّذي نَظَروا",25,"ر",3,0],["خلَّد الله تعالى ملكه","وَوَقاه ربّه مما يحاذر",26,"ر",1,0],["خَلَّدَتْ بالثناء عصراً فعصراً","سؤدد المجد في بياض الطروس",27,"س",1,0],["خلّد اللَه لنا أيامه","في هناء وسرور مقبل",28,"ل",1,0],["خلّد الله مُلكَ مالِكِنا الصا","لحِ فهْو السميدَعُ المختارُ",29,"ر",1,0],["خُلِّدتَ للحسناتِ تنثُرها يدا","فيداً وينظِمُها لسانُ الشاعرِ",30,"ر",1,0],["خَلَّدتَ مجدَ جُدودِكَ الصِّيدِ الأُلى","ساروا منَ الأيَّامِ فوقَ الهامِ",31,"م",1,0],["خلَّدتَ مجدَ جدُودِكَ الصِّيدِ الأُلى","نامُوا بلى وكَأنَّهم ما ناموا",32,"م",3,0]]}