{"poems":[[55,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[79,"النصر نصك والحسام دليله","https://www.aldiwan.net/poem36377.html","الكامل"],[90,"كان أبو الطيب امرأ قوله","https://www.aldiwan.net/poem44436.html","المنسرح"],[4,"درس المنا بمتالع فأبان","https://www.aldiwan.net/poem21206.html","الكامل"],[91,"الشعر ما قاله الكرخي عبود","https://www.aldiwan.net/poem44750.html","البسيط"],[64,"وذوات أجساد نكهن ضعائف","https://www.aldiwan.net/poem52219.html","الكامل"],[99,"دينٌ وهذا اليومُ يومُ وفاءِ","https://www.aldiwan.net/poem24752.html","الكامل"],[99,"ها هنا حفل وذكرى ووفاء","https://www.aldiwan.net/poem24983.html","الرمل"],[54,"منزل أقوى بسلمى وربوع","https://www.aldiwan.net/poem26865.html","الرمل"],[77,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[48,"السعد يجعل ذري الدبى نعما","https://www.aldiwan.net/poem22663.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62217","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55019","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54967","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54543","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[92,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[132,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[132,"هجرت بعدك العيون الرقادا","https://www.aldiwan.net/poem50641.html","الطويل"],[132,"من لصب تصاعدت حسراته","https://www.aldiwan.net/poem50653.html","الخفيف"],[287,"أنت في الدهر للعديل عديم","https://www.aldiwan.net/poem32453.html","الخفيف"],[305,"عوجوا فحيوا أيها السفر","https://www.aldiwan.net/poem45485.html","أحذ الكامل"],[333,"أعيش أم أدع الأيام للناس","https://www.aldiwan.net/poem55006.html","البسيط"],[347,"صرفند معقل الاحرار ما","https://www.aldiwan.net/poem55320.html","الرمل"],[347,"الضحايا معناهم الشهداء","https://www.aldiwan.net/poem55366.html","الخفيف"],[371,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[408,"وافاك يصحبه الإسعاد والظفر","https://www.aldiwan.net/poem46940.html","البسيط"],[422,"إنما هذا لعمري مركب","https://www.aldiwan.net/poem53833.html","الرمل"],[422,"يا بني الشيخ والغياث المرجى","https://www.aldiwan.net/poem53846.html","الخفيف"],[435,"يا خليلا لم أكن عنه خلي","https://www.aldiwan.net/poem41022.html","الرمل"],[438,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[463,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[543,"يوم أناخ بباب خير إمام","https://www.aldiwan.net/poem47941.html","عموديه"],[543,"ذا اليوم تحسد مجده الأيام","https://www.aldiwan.net/poem47942.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126821","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122605","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110454","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86827","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86615","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38937","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120071","المجتث"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56344","الرمل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56101","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56069","الرمل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56214","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64697","الكامل"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124698","السريع"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95595","الخفيف"],[1482,"","https://poetry.dctabudhabi.ae/diwan/poem/198789","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80005","الخفيف"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105426","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125483","الرمل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110340","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108462","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53242","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77198","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77301","الرمل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137165",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94317","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202755","المتقارب"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134023","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65139","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132728","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132550","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74069","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74063","الكامل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123930","الخفيف"],[3533,"","https://poetry.dctabudhabi.ae/diwan/poem/145896","المديد"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85023","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128922","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128914","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102964","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29311","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76446","الرمل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119651","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54498","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83158","السريع"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89570","المديد"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123868","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139749",""],[4679,"قل للذي حل الضريح مغادراً","https://www.poetsgate.com/ViewPoem.aspx?id=142777",""],[4767,"تضحية","https://www.poetsgate.com/ViewPoem.aspx?id=181217",""],[182,"فيحاء ،،،","https://www.poetsgate.com/ViewPoem.aspx?id=72839",""],[585,"خلا المجال وأودى الشاعر العلم","https://www.poetsgate.com/ViewPoem.aspx?id=161942",""],[5072,"في قاعة المناقشة","https://www.poetsgate.com/ViewPoem.aspx?id=53674",""],[5130,"راحة الصب غيبة الرقباء","https://www.poetsgate.com/ViewPoem.aspx?id=152663",""],[5136,"يا لها قبة تلألأ نورا","https://www.poetsgate.com/ViewPoem.aspx?id=121549",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""],[5216,"الأول والأخير","https://www.poetsgate.com/ViewPoem.aspx?id=187648",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5442,"خل دمعي فقد اصاب مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=114777",""],[5444,"عروق التبر","https://www.poetsgate.com/ViewPoem.aspx?id=203348",""],[5516,"من أجل من يارسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=212477",""],[5544,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=213413",""],[402,"يأحسن ما أتحفتماني به","https://www.poetsgate.com/ViewPoem.aspx?id=35907",""],[5956,"سدادُ الدين شعاري الأعمق","https://www.poetsgate.com/ViewPoem.aspx?id=192929",""],[5956,"الكافورُ الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=192937",""],[6102,"الشهيد ..","https://www.poetsgate.com/ViewPoem.aspx?id=182893",""],[5309,"خلدت فنك في بيان صفاتي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573785",""]],"verses":[["خَلِّ دَمعي وَطَريقَه","أَحَرامٌ أَن أُريقَه",0,"ق",2,1],["خَلَّدْتَ سِرَّ النَّصْرِ فِي أَعْقَابِهِ","وَسَلَكْتَ قَصْداً لاَ يُضَلُّ سَبِيلُهُ",1,"ل",2,0],["خلّد ذكراً لسيف دولتها","أيام وشى بمدحه خلله",2,"ل",2,0],["خَلَدَت وَلَم يَخلُد بِها مَن حَلَّها","وَتَبَدَّلَت خَيطاً مِنَ الأُحدانِ",3,"ن",1,0],["خلدت شعرك اذ جددت كسوته","من البيان وفي التجدبد تخليد",4,"د",1,0],["خلدت فلا نار على إحراقها","قدرت ولا ماء على إغراقها",5,"ق",3,0],["خلدت على الدنيا وزادت روعةً","ممّا كساها سيدُ الشعراءِ",6,"ا",2,0],["خلدت على الدنيا وزادت روعةً","من جودة التمثيل والإلقاءِ",6,"ا",2,0],["خلدت أنوارهم رغم البلى","وبها المدلج في الليل استضاء",7,"ا",2,0],["خَلَدَ الغَدرُ وَلَم يَبقَ وَفاً","لَيسَ إِلّا كاذِبُ العَهدِ قَطوعُ",8,"ع",1,0],["خَلّدتُمُ في العبشمِيّةِ لَعْنَةً","خلقت وما خلقوا لها تعجيلا",9,"ل",2,0],["خَلَّدتُهُنَّ بِسِجنِ السِرِّ مِن خَلَدٍ","سَوداؤُهُ مِن أَعادي البيضِ في الخُمُرِ",10,"ر",1,0],["خَلَدَتْ ولَمْ يَخْلُدْ بِهَا مَنْ حَلّهَا","ذَاتُ النِّطَاقِ فَبُرْقَةُ الإمْهَارِ",11,"ر",1,0],["خَلَّدْتَ بِالشَّعْرِ لَهَا صُورَةً","مِنَ الطِّرَازِ العَبْقرِيِّ البَدِيعْ",12,"ع",1,0],["خلدْتمَاهُ فِي الْفَرِيقِ الأَولى","بَنَوا فَخَارَ الزمَنِ الحَاضِرِ",13,"ر",1,0],["خُلِّدَتْ بالجُودِ ذِكْرَاكَ التي","خُلِّدَتْ بالنُّبْلِ قبلاً وَالذَّكاءِ",14,"ا",2,0],["خَلَدَتْ عَلَى الأْيَّامِ ذِكْرَى رُفْقَةٍ","كَنِظَامِ شُهْبٍ أَوْ كَعِقْدِ لآلِي",15,"ل",2,0],["خُلِّدْتِ سامراءُ ، لم أوصِلْكِ مِن","فَضْلٍ حَشَدتِ عليَّ غيرَ قليله",16,"ل",2,0],["خلّد اللْهُ مُلكه وَوَقاهُ","اللَّهُ من شر يومه القمطريرِ",17,"ر",1,0],["خلّدَ الله مُلككمُ واصْطفاكم","واجْتباكمْ إذْ صِرتمُ أَمجادَا",18,"د",2,0],["خلَّدَ الله ملككم وارتضاكُم","في زمانٍ زانت بكم جُمْعَاتُه",19,"ت",2,0],["خَلَّدَ اللَهُ دَولَةَ المَلِكِ العا","دِلِ ما زانَتِ السَماءَ النُجومُ",20,"م",1,0],["خَلَدَ الجُبَيبُ وَبادَ حاضِرُهُ","إِلّا مَنازِلَ كُلُّها قَفرُ",21,"ر",1,0],["خلّدت شعري في نفسي وأحسَبُه","سينتهي حينما تنشقّ أرماسي",22,"س",2,0],["خلدته مسحة صوفية","ذات سحر بابلي مجتنى",23,"ن",2,0],["خلدتهم بطولة وارتخاص","للمنايا وهمة قعساء",24,"ا",2,0],["خَلَّدتَ جودَكَ في أَهلي فَأَذكَرَني ال","دُنيا وَأَمَّنَني تَخليدُكَ الأَجَلا",25,"ل",2,0],["خُلدٍ وافاها الورى فرأوا","فوقَ الذي سَمعوا منها الَّذي نَظَروا",26,"ر",3,0],["خلَّد الله تعالى ملكه","وَوَقاه ربّه مما يحاذر",27,"ر",1,0],["خَلَّدَتْ بالثناء عصراً فعصراً","سؤدد المجد في بياض الطروس",28,"س",1,0],["خلّد اللَه لنا أيامه","في هناء وسرور مقبل",29,"ل",1,0],["خلّد الله مُلكَ مالِكِنا الصا","لحِ فهْو السميدَعُ المختارُ",30,"ر",1,0],["خُلِّدتَ للحسناتِ تنثُرها يدا","فيداً وينظِمُها لسانُ الشاعرِ",31,"ر",1,0],["خَلَّدتَ مجدَ جُدودِكَ الصِّيدِ الأُلى","ساروا منَ الأيَّامِ فوقَ الهامِ",32,"م",1,0],["خلَّدتَ مجدَ جدُودِكَ الصِّيدِ الأُلى","نامُوا بلى وكَأنَّهم ما ناموا",33,"م",3,0],["خلّدَ اللّه مُلكهُ وحماهُ","وَوقاهُ الأرزاءَ والأهوالا",34,"ل",2,0],["خُلِّدتَ يا شَمسَ المُلوكِ وبَدرَها","ما مُتِّع القَمرانِ بالتَّخليدِ",35,"د",1,0],["خلَّدتَ ذكر الصحافيين فيهِ كما","أَوليتَهُم مِنَّةً من أَعظَم المنَن",36,"ن",1,0],["خلد اللَه مَعاليك الَّتي","لَم تُقَس يا صَدر فيها بِالنَظير",37,"ر",1,0],["خَلد اللَه ملكه في دِيار","قَد حَباها مِن بَحره بِالمَواهب",38,"ب",1,0],["خَلَّدَ اللَّه عَدلَ هَذا الزّمان","وَحَباهُ دَوم اللّيالي الحِسانِ",39,"ن",1,1],["خلدت تبني المعالي","ما خُلِّد ابنا سيرِ",40,"ر",1,0],["خلَّد الله بنا أركانها","ووقاها ببشير المؤمنينْ",41,"ن",1,0],["خلد الله اجره حيث ما قد","ردّ عني القضاء ردًّا جميلا",42,"ل",2,0],["خلّد الله علينا عزه","ما اضا بدرٌ بجنح الغلسِ",43,"س",1,0],["خلَّد الله عليك النعما","ما تجلّت أنجمٌ في حندسِ",44,"س",1,0],["خَلَّدْتُ فيهِ قَصائِداً","تُغني المدى سَبْتاً فَسَبْتاً",45,"ت",2,0],["خلّدها الليل على مفرقي","في ليلة مجنونة خاطيه",46,"ي",2,0],["خلدت فى القلوب ذكرى هناءٍ","ولعمرى فتلك أحسن ذكرى",47,"ر",2,0],["خلدت نبلاً في الورى وتواضعاً","شهماً تُجسّد نخوةً عرباء",48,"ا",2,0],["خلَّد المصطفى به لكم الفخرَ","وزدتم بالمصطفى اليومَ فخرا",49,"ر",2,0],["خلدت في قلوبنا حزناً لا","ينجلي فجره مدى الآباد",50,"د",1,0],["خَلَّدت علياه ذكراً","لم تغيرهُ الدهور",51,"ر",1,0],["خلد الفخر في مهارقها سيا","رةً تنضح البيان الوضيا",52,"ي",2,0],["خلد اللَه ذكرها في قلوب","تسأل الصبر وهو عين المحال",53,"ل",1,0],["خلدت شربة الأيادي كعباً","ضعف ما خلَّدَتْ صَبَا الجعفريِّ",54,"ي",1,0],["خُلدُ أَسلافِكُم نَعيمُ ذَراري","كُم مَقاصيرُ حورِكُم وَالخُدورُ",55,"ر",1,0],["خُلِّدَت آثارُهُ في هَرَمٍ","يَنطَحُ الأَفلاكَ أَو كَنزٍ دَفين",56,"ن",1,0],["خلدت يا واصا المعظم قدره","ذكراً بالسنة الثناء يردد",57,"د",1,1],["خل دنا خشف رنا جمر ذكا","ليل غسا عبد فسا مال زكا",58,"ك",2,0],["خلدتُ فأمّنتُ مستقبلي","فدعني أنل متعة الحاضر",59,"ر",1,1],["خلدت لتركيَ فكر الخلود","سوى الصدق في العرض للخاطر",59,"ر",1,0],["خلد 