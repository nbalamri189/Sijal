{"poems":[[55,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[55,"أرى ركدة ريحها يرتجى","https://www.aldiwan.net/poem30421.html","المتقارب"],[55,"مثال عينيك في الظبي الذي سنحا","https://www.aldiwan.net/poem30655.html","البسيط"],[59,"أرى راحة للحق عند قضائه","https://www.aldiwan.net/poem24700.html","الطويل"],[9,"كفى بالذي تولينه لو تجنبا","https://www.aldiwan.net/poem21907.html","الطويل"],[88,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[53,"أرى رجالا قد خولوا نعما","https://www.aldiwan.net/poem64106.html","المنسرح"],[87,"تولستوي تجري آية العلم دمعها","https://www.aldiwan.net/poem62870.html","الطويل"],[99,"أهب ببيانك الصافي تدفق","https://www.aldiwan.net/poem24394.html","الوافر"],[82,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16638","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54976","الطويل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116992","البسيط"],[92,"أمان الله","https://www.poetsgate.com/ViewPoem.aspx?id=179030",""],[9,"كَفَى بِالّذِي تُولِينَهُ لَوْ تَجَنّبَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17253&r=&rc=0",""],[147,"ظن الأراك لدى واديه أظعانا","https://www.aldiwan.net/poem11832.html","عموديه"],[190,"تبارك الله لا حزم ولا جلد","https://www.aldiwan.net/poem43862.html","البسيط"],[284,"أيحسن بعد ضنك حسن ظني","https://www.aldiwan.net/poem2631.html","الوافر"],[358,"طريفا كان مجدك أم تليدا","https://www.aldiwan.net/poem40396.html","الوافر"],[369,"أحن إلى تلك الضحى والأصائل","https://www.aldiwan.net/poem60806.html","الطويل"],[369,"ألم تريا أن الحمول تسير","https://www.aldiwan.net/poem60891.html","الطويل"],[376,"ألم فأذكره ما نسي","https://www.aldiwan.net/poem57365.html","المتقارب"],[376,"أرته الليالي كل مستقبل ذاهب","https://www.aldiwan.net/poem57531.html","الطويل"],[406,"رؤية","https://www.aldiwan.net/poem6782.html","عموديه"],[469,"أما وبنات الفكر حلفة فاضل","https://www.aldiwan.net/poem3336.html","عموديه"],[567,"لما رأيتك ترعى ذمة العرب","https://www.aldiwan.net/poem52875.html","البسيط"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107210","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96728","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136164","الطويل"],[1368,"","https://poetry.dctabudhabi.ae/diwan/poem/203526","الطويل"],[1857,"","https://poetry.dctabudhabi.ae/diwan/poem/97606","الطويل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147323","البسيط"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103816","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54501","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81255","المجتث"],[4493,"","https://poetry.dctabudhabi.ae/diwan/poem/20656","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139701",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52181","البسيط"],[4755,"أَرَى أُمَّةً فِي الدُّرِّ تَطوِي شِرَاعَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=190645",""],[4832,"نظرت الزمان يعين الرضا","https://www.poetsgate.com/ViewPoem.aspx?id=166703",""],[5186,"تسآءلني فتاة الحي ما بي","https://www.poetsgate.com/ViewPoem.aspx?id=156495",""],[5913,"نجوى نسيم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=177075",""],[6164,"صراع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66057&r=&rc=66",""]],"verses":[["أَرى راشِداً يُصغي وَليسَ مُكَلَّمٌ","وَمُستَرشَدٌ يَدعو وَليسَ سَميعُ",0,"ع",1,0],["أَرى رَكدَةً ريحُها يُرتَجى","وَمُظلِمَةً صُحبُها يُنتَظَر",1,"ر",1,1],["أَرى رِجالاً كَبُهمِ القاعِ عِندَهُمُ","سَيّانِ مِن مَزقَ الآراءِ أَو صَرَحا",2,"ح",2,0],["أَرى راحَةً لِلحَقِّ عِندَ قَضائِهِ","وَيَثقُلُ يَوماً إِن تَرَكتَ عَلى عَمدِ",3,"د",1,1],["أَرى رَجُلاً مِنكُم أَسيفاً كَأَنَّما","يَضُمُّ إِلى كَشحَيهِ كَفّاً مُخَضَّبا",4,"ب",2,0],["أَرى رِجالاً مِنَ الدُنيا الجَديدَةِ في ال","دُنيا القَديمَةِ تَبني خَيرَ بُنيانِ",5,"ن",1,0],["أرى رجالاً قد خُوِّلوا نِعَماً","في خفة الحلم كالعصافيرِ",6,"ر",1,1],["أَرى راحَةً بَينَ الجَنادِلِ وَالحَصى","وَكُلُّ فِراشٍ قَد أَراحَ وَثيرُ",7,"ر",1,0],["أرى روحَ الحياة تفيض فيكم","وعزمكمو يفيض على الليالي",8,"ي",1,0],["أرى رسمي غداً بيدي كرسمٍ","عَفَا وَعَفَتْ له بالمحلِ دارُ",9,"ر",1,0],["أرى راحَ المَسَرَّةِ أثْمَلتْني","وتلكَ لَعَمْريَ الراحُ الحَلال",10,"ل",1,0],["أَرَى رَوْضَةً لكِنْهَا رَوْضَةُ الرَّدَى","وَأُصْغِي وَمَا فِي مَسْمَعِي غيْرُ وَسْوَاسِ",11,"س",1,0],["أرى رجالاً بدون الدين قد قنَعوا","ولا أراهُم رضوا في العيشِ بالدون",12,"ن",1,1],["أرى رأسَ \" ابنَ سقاءٍ \" محالاً","يُطيق بتاجكَ الألِقِ اضطلاعا",13,"ع",2,0],["أرى رجلاً منكمْ أسيفاً كأنّما","سضمّ إلى كشيحهٍ كفّاً مخضَّبا",14,"ب",2,0],["أَرى رَعاياكَ حَلَّت رَوضَةً أُنُفاً","يَجودُها الأَمنُ وَالإِنصافُ تَهتانا",15,"ن",2,0],["أرى رجالا على خيل مسومّة","يشيد ملكهم الأتراك والخزر",16,"ر",1,0],["أَرى رأى التناسخ مِصْرَ حقّاً","بضمّ اسمٍ إِلى عَدْلٍ وحُسْن",17,"ن",1,0],["أَرى رتب العُلى تَزهو جَمالاً","وَتَسمو حَيث كنت لَها عَميدا",18,"د",2,0],["أرَى رائدَ الآمالِ فيكَ مُبَشِّراً","بأَمْرٍ إليه الدَّهْرُ كالمُتَطاول",19,"ل",1,0],["أرَى رائدَ التّوفيقِ في كلِّ مَنْزِلٍ","يَصيرُ معَ الإقبالِ حيث تَصير",20,"ر",1,0],["أرَى روضةً من رياضِ الحُزو","نِ مُفَصَّلةَ النورِ بالسُّندسِ",21,"س",1,0],["أرى رميَ جفنيها من الضعف ناقصاً","فيُطمِعُني حتى أحسّ به صائِب",22,"ب",1,0],["أرى ربعك اليوم قد انكروك","ومن عادة الناس أن تنكرا",23,"ر",2,0],["أرى ربَّ نقصٍ مثل ربّ فضيلةٍ","وبينهما ما بين قسٍّ وباقل",24,"ل",1,0],["أرَى رَسائلَكَ البَيضاءَ لو عُصِرَت","منها المَوَدَّةُ سالتْ بالنَّدَى الرَّطِبِ",25,"ب",1,0],["أَرى رَبعَ الأَحِبَّةِ قَد تَعاصَى","إِذا قُلنا دَنا مِنّا تَقاصَى",26,"ص",2,1],["أَرى رسمَ سعدى في فؤادي راسما","لَها وله رسمٌ ولم يكُ طاسما",27,"م",2,1],["ارى روحه طوافة في حريضة","تمد بها من جاء يسعى على قصد",28,"د",1,0],["أرى رفضَ بعرانٍ فأحسب أنها","لحصنٍ فأدنو دنوة فأخيبُ",29,"ب",1,0],["أَرى روضةً قد حانَ منها قطافها","وَلستُ أرى جانٍ يمدّ لها يدا",30,"د",2,1],["أَرَى رُفَاتِيَ نَعشًا فَاغِرًا فَمَهُ","عَلَيَّ حَتى كَأنّ المَوتَ مِن طَبقِي!",31,"ق",2,0],["أرى ريقها ماء الحياة تَيقُّناً","على أنها لم تبق لي في الهوى حشا",32,"ش",2,1],["أَرى ربحي إذا أَنفقتُ مالي","وما أَنا بالغَبيِّ ولا الغبينِ",33,"ن",1,0],["أَرى رُؤاك وَأَلقى لِلذ","يذ مِن مَخزونك",34,"ك",1,0],["أَرى رَهبَةَ الأَعداءِ مِنّي جَراءَةً","وَيَبكي إِذا ما النَفسُ يُوحي ضَميرُها",35,"ر",3,0],["أرى رأسه وهو سرُّ الإله","برأس سنانِ سنانٍ أذيعا",36,"ع",2,0],["أرى رؤىً عند فجرِ العمر نائيةً","شتّى المباهجِ أَشكالاً وألوانا",37,"ن",2,0],["أرَى رَايَةً تَهوِي على إثْرِ رَايَةٍ","فَلَا تَمْلِكُ الأعرابُ إلَّا وَدَاعَهَا",38,"ع",3,0],["أرى رحمة الله قد خيلت","وبرق سحائبها أو مضا",39,"ض",2,0],["أرى روح الفضيلة في سبات،","وصل السوء ينفخ في الإهاب",40,"ب",1,0],["أرى رياحين وصلي الحِبَّ ذابلةً","ما عدت أشتم عطراً من رياحيني",41,"ن",2,0],["أرى رِفاقي بعد ما أَمْعَنُوا","في اللَّهْو عادُوا خُشَّعاً للصَّوابْ!",42,"ب",1,0]]}