{"poems":[[55,"بروم السيوف وغرب الرماح","https://www.aldiwan.net/poem30653.html","المتقارب"],[32,"أللأربع الدهم اللواتي كأنها","https://www.aldiwan.net/poem29555.html","الطويل"],[85,"هناء له ثغر الهدى يتبسم","https://www.aldiwan.net/poem54244.html","الطويل"],[85,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[90,"لقد طوحتني في البلاد مضاعا","https://www.aldiwan.net/poem45009.html","الطويل"],[74,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[93,"ليطرب من شاء أن يطربا","https://www.aldiwan.net/poem8759.html","عموديه"],[93,"كانت قبيل العصر مركبة","https://www.aldiwan.net/poem8852.html","عموديه"],[87,"سل الليل عن أفلاكه هل جرت سدى","https://www.aldiwan.net/poem7892.html","الطويل"],[45,"عواذل ذات الخال في حواسد","https://www.aldiwan.net/poem9528.html","الطويل"],[47,"لأخي الحب عبرة ما تجف","https://www.aldiwan.net/poem65151.html","الخفيف"],[47,"يائبنة الدهر هل رأيت كمثلي","https://www.aldiwan.net/poem65532.html","الخفيف"],[68,"نفوس الصيد أثمان المعالي","https://www.aldiwan.net/poem40137.html","الوافر"],[82,"أيا خلج المدامع لا تغيضي","https://www.aldiwan.net/poem31397.html","الوافر"],[82,"وأشقر من خيل الدنان ركبته","https://www.aldiwan.net/poem31512.html","الطويل"],[76,"وأشقر تضرم منه الوغى","https://www.aldiwan.net/poem12966.html","السريع"],[76,"من موقف أفصحت بيض السيوف به","https://www.aldiwan.net/poem13190.html","البسيط"],[13,"على الشنفرى ساري الغمام فرائح","https://www.aldiwan.net/poem2227.html","الطويل"],[50,"إرفض إخوة من نسك","https://www.aldiwan.net/poem66605.html","مجزوء الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141936","الطويل"],[102,"عذاب ولحن","https://www.poetsgate.com/ViewPoem.aspx?id=50120",""],[82,"وأشقر من خيل الدنان وكبته","https://www.poetsgate.com/ViewPoem.aspx?id=3062",""],[96,"الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=13789",""],[90,"لقد طوَّحتني في البلادُ مُضاعَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19522&r=&rc=25",""],[123,"له حلبة الخيل العتاق كأنها","https://www.aldiwan.net/poem4343.html","الطويل"],[132,"ثلاث خصال يفسد الملك عندها","https://www.aldiwan.net/poem50651.html","الطويل"],[151,"توسد بمهد الأمن قد مرت النوى","https://www.aldiwan.net/poem47688.html","الطويل"],[164,"عدوك مما عنك يسمع يا يحيى","https://www.aldiwan.net/poem58856.html","الطويل"],[164,"جرى لك في خرق العوائد والعرف","https://www.aldiwan.net/poem58901.html","الطويل"],[164,"أقمن على قلبي رقيبا من الحب","https://www.aldiwan.net/poem58937.html","الطويل"],[164,"عليك برأي السيف فهو سديد","https://www.aldiwan.net/poem58940.html","الطويل"],[173,"إلى م أرجي ضر عيش منكدا","https://www.aldiwan.net/poem1615.html",""],[190,"تحن إلى الغنى النفس الفقيره","https://www.aldiwan.net/poem43786.html","الوافر"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[228,"إجرح القلب واسق شعرك منه","https://www.aldiwan.net/poem39702.html","الخفيف"],[240,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[246,"يا يراعي لولا يد لك عندي","https://www.aldiwan.net/poem45751.html","الخفيف"],[308,"وأشقر نبت عارضه تراه","https://www.aldiwan.net/poem57906.html","الوافر"],[358,"وأشقر ذي سبق على الأين طالما","https://www.aldiwan.net/poem39967.html","الطويل"],[422,"تنفس عن وجد توقد جمره","https://www.aldiwan.net/poem54071.html","الطويل"],[543,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[556,"طلبت الغنى حرصا على بذلي الغنى","https://www.aldiwan.net/poem47268.html","الطويل"],[556,"رضينا من عدانك بالمطال","https://www.aldiwan.net/poem47296.html","الوافر"],[556,"يا خير باد في الأنام وحاضر","https://www.aldiwan.net/poem47789.html","الكامل"],[580,"وأشقر ما زلت من جريه","https://www.aldiwan.net/poem2746.html","السريع"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129521","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59408","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35385","الوافر"],[1203,"","https://poetry.dctabudhabi.ae/diwan/poem/28285","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115951","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108505","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106904","المتقارب"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101689","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/130005","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201770","المتقارب"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/204159","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112547","الكامل"],[3649,"","https://poetry.dctabudhabi.ae/diwan/poem/203521","الطويل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141554","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114457","البسيط"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107525","الخفيف"],[4918,"نجيب العيد","https://www.poetsgate.com/ViewPoem.aspx?id=31103",""],[5302,"أودت بقلبي المتاعب","https://www.poetsgate.com/ViewPoem.aspx?id=204914",""],[5561,"حبٌّ في زمن الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=192736",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5612,"جَفاني","https://www.poetsgate.com/ViewPoem.aspx?id=180616",""]],"verses":[["وَأَشقَرَ يَسرِقُ صِبغَ المُدا","مِ أَنهَبتُ جِلدَتَهُ لِلسِلاحِ",0,"ح",1,0],["وَأَشقَرَ بَلّى وَشيَهُ خَفَقانُهُ","عَلى البيضِ في أَغمادِها وَالعَطائِفِ",1,"ف",1,0],["وأَشقرَ أعدى البرقَ لوناً وسرعةً","ولكنْ له دون البروق التقدُّمُ",2,"م",1,0],["وأشقرُ مهما حاول البرقَ في مدى","يفوتُ جوادَ البرق منه المحاولُ",3,"ل",1,0],["وأشقَى الورى نفساً وأضيعهم نُهىً","لبيبٌ يداري في نُهاه رَعاعا",4,"ع",2,0],["واشقوتي منه بخصر مخطف","نهب السلوّ وناظرٍ خطَّاف",5,"ف",1,0],["وَأَشقى نُفوسُ بَني آدَمٍ","لِيُرضي السَراحين وَالأَعقُبا",6,"ب",2,0],["وا شَقوَتي إِنَّ الطَريقَ إِلى","سَكَني عَلى مُستَحسَنِ النَكرِ",7,"ر",1,0],["وأشقى بها هما وأعيا مطالبا","وأتعب فيها بالمحبين حسدا",8,"د",2,0],["وَأَشقى بِلادِ اللَهِ ما الرومُ أَهلُها","بِهَذا وَما فيها لِمَجدِكَ جاحِدُ",9,"د",1,0],["وَأَشَّقُّ الأَفعالِ أَن تَهَبَ الأَن","فُسُ ما أُغلِقَت عَلَيهِ الأَكُفُّ",10,"ف",1,0],["وَأَشُقُّ الجُيوبَ مِن خَلعِ اللَي","لِ بِكَفٍّ مِنَ الزَماعِ بَتوكِ",11,"ك",1,0],["وَأَشقي مِن دِماءِ عِداكَ نَفساً","تَنوطُ القَولَ مِنها بِالفِعالِ",12,"ل",1,0],["وأشقى الناس في الأُخرى ابن دنيا","يقول لِنَفسِهِ في الغيِّ خُوضي",13,"ض",2,0],["وأشقرَ من خيل الدنانِ ركبتُهُ","فأصبحَ بي في غايةِ السكر يجْمَحُ",14,"ح",1,1],["وَأَشقَرٍ تُضرَمُ مِنهُ الوَغى","بِشُعلَةٍ مِن شُعَلِ الباسِ",15,"س",1,1],["وَأَشقَرٍ سائِلٍ في وَجهِهِ وَضَحٌ","كَما تَصَوَّبَ نَجمُ الرَجمِ في الشَفَقِ",16,"ق",1,0],["وَأَشقَرُ غَيداقُ الجِراءِ كَأَنَّهُ","عُقابٌ تَدَلّى بَينَ نيقَينِ كاسِرُ",17,"ر",1,0],["واشقق سراويلاتهم","لا تنتظر حلّ التِكَك",18,"ك",1,0],["وَأَشْقَى شَقِّيٍ في الوَرَى قَلْبُ شَاعِرٍ","نَبَا الحَظُّ عَنْهُ وَ الْتَقَى الحُبُّ وَ الفَقْرُ",19,"ر",1,0],["وأشقى ويشقى بي الحاسدون","وما نلت ما يخلق الحسّدا",20,"د",2,0],["وأشقر من خيل الدنان وكبته","فأصبحَ في غاية ِ السكر يَجْمَحُ",21,"ح",1,1],["وأشقى إذا أعرضت عمّن أحبّه","ولكن دواء الكبر عندي هو الكبر",22,"ر",1,0],["وأشقى الورى نفساً وأضيعهم نهى ً","لبيبٌ بداري في نُهاه رعاعا",23,"ا",1,0],["وأشقرَ مجَّ الراحَ صرفاً أديمُهُ","وأصفرَ لم يمسح بها جلدَهُ صِرفا",24,"ف",2,0],["وأشقى بجمع المالِ من كل وجهةٍ","وأبخلُ عن نفسي لأُسعِدَ وارِثي",25,"ي",1,0],["وأشقر تحتي كلمته رماحهم","ثمان ولم يشك الجوى بل وما التوى",26,"و",2,0],["واشقى البرايا حاسد كلما رأى","رأى في نفسه الوهن والوهيا",27,"ي",2,0],["واشقى الورى هذا المعذب نفسه","بما خاض من موج ومن مسلك عنف",28,"ف",1,0],["واشقى الورى صب يذوب فؤاده","بحب امريء خالي الفوآد من الحب",29,"ب",1,0],["واشقى الورى باغ له النحس طالع","يهمُّ به ملك أغرُّ سعيد",30,"د",1,0],["وَأَشقى بَني الدُنيا كَريمٌ يَسوسُهُ","لَئيمٌ إِذا ما نالَ شبعاً تَمَرَّدا",31,"د",2,0],["وأشقى الناس في الدنيا كريم","يذلّ لمبغضيه على بصيره",32,"ر",2,0],["وَأَشقى الوَرى من ضلَّ في ليلِ غيّهِ","وَما قلّدَ الساري الّذي شاهدَ البَدرا",33,"ر",2,0],["واشقَ ما شِئتَ فَالشَقا مُحرَقاتٌ","صَعِدَت مِن مَذابِح الأَرحامِ",34,"م",1,0],["وَأَشقَرٍ ذي حافِرٍ","فَيروزَجِيٍّ أَزرَقِ",35,"ق",1,0],["واشقاءَ الأَديبِ هل وَتَرَ الده","رَ فلا زَالَ طالباً مِنهُ ثَارا",36,"ر",2,0],["وأشقر نبت عارضه تراه","كأن شعاع وجنته تلالا",37,"ل",2,1],["وَأَشقر ذي سَبقٍ عَلى الأَين طالَما","صدمتَ بِهِ مِن جَحفَلٍ بَعدَ جَحفَلِ",38,"ل",1,1],["وأشقى بني هذا الزمان أريبه","وأتعبُ من فيه من النَّاس حرُّه",39,"ر",2,0],["وأشقرُ في لَونِ الضُّحَى غيرَ أنَّه","يَجُرُّ على الأعداءِ ليلَ الرَّدى جَرَّا",40,"ر",2,0],["وأشقى الورى مَن كان أكبرَ همّه","هجاءُ ضَنينٍ أو مديحُ مُنيلِ",41,"ل",1,0],["وأشقى النّاسِ مَن يُضحى ويُمسي","يبالي في الهوى مَن لا يبالي",42,"ل",2,0],["وأشقَّ من وطأ الكواكب مُرتقىً","وأعزَّ من ليث العرينِ الخادرِ",43,"ر",1,0],["وأَشقرٍ ما زِلْتُ من جَرْيِه","أَطْوِي به البيدَ كطيِّ الكِتَابْ",44,"ب",1,1],["وأشقاء الآداب في حلب","بعدك أودى بعقدها الانحلال",45,"ل",1,0],["وأشقر ما انبرى إلا وجالت","على عطفيه نيران استعار",46,"ر",1,0],["وأشق البحار عرضا وطولا","وأجوب الفلاة دارا فدار",47,"ر",1,0],["وأَشقى الناسِ مَن يَعصي إِماماً","وَلِيّاهُ عَلِيٌّ وَالرَسولُ",48,"ل",1,0],["وَأَشقَرَ مَحبوكٍ يَجُرُّ عَنانَهُ","إِلى الماءِ لَم يَترُك لَهُ المَوتُ ساقِيا",49,"ي",2,0],["وَاشِقوَتى كم صَباباتٍ وكم شغفٍ","وكم غرامٍ وكم شوقٍ وكم ولَعُ",50,"ع",1,0],["وأشق أثواب العفاف بصارمٍ","من غنج تلك المقلة السوداء",51,"ا",2,0],["وأشقى البرية مثلي طريدٌ","يكونُ الظلامُ له ملجأَ",52,"ا",1,0],["وأشقى الورى من باع أخراه ضلة","بدنيا سواه وهو للغبن مشترى",53,"ر",2,0],["وأشقرَ مثلِ البرق لوناً وسرعةً","قصَدت عليه عارض الجود فانهمى",54,"م",2,1],["وأشقى بعيشهم الأنكد","وأرفع ساقطَهم باليد",55,"د",1,0],["واشقائي من ذل بختي عليكم","من إليكم يا قوم كان شفيعي؟",56,"ع",2,0],["وأشقى الربع جانبه الحيا","وفي الكون آلاف بعلمي تسعد",57,"د",1,0],["وأشقر صفياناً وسوداء جعدة","محددة الأنياب مأفونة الحسب",58,"ب",1,0],["وأشقى الناس ذو حزم توالت","مصائبه عليه من يديه",59,"ي",2,0],["وأشقراً شاطحاً دأباً بهامتهِ","كأنما به نزغاتُ الشياطينِ",60,"ن",1,0],["وأشقايَ لهف قلبي عليهم","كيف ذاقوا هذا الفراق الشقيا",61,"ي",2,0],["واشِق البسمَهْ وانسى من دموع الغيد","ولكن اسمي يا عالم يجي في الحال",62,"ل",1,0],["وأشقى بظلم من قريب وكم جرت","طويلا على خدي الدموع السواكب",63,"ب",1,0],["وأشقُّ ما فيها كلامٌ قلتَهُ","حين الوصالِ وحرفُ لَسنِكَ جارحُ",64,"ح",1,0],["وأشقُّ الفضاء ومضة نورٍ","لبس الأفق بُردها إحراما",65,"م",2,0],["وأشْقاني وما لِيَ من سَبيلٍ","وصَبَّ بمُهْجَتي الأحْزانَ صَبّا",66,"ب",2,0]]}