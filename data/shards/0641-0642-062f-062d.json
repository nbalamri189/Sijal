الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36773","البسيط"],[3720,"","https://poetry.dctabudhabi.ae/diwan/poem/146963","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[4259,"","https://poetry.dctabudhabi.ae/diwan/poem/145310","السريع"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81718","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28714","الهزج"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136410",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120477","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204312","الطويل"],[4830,"همسات الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=193596",""],[4884,"حروفٌ أربعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202264",""],[4954,"هلْ لي منْ غزالٍ سماحةً","https://www.poetsgate.com/ViewPoem.aspx?id=208832",""],[5002,"روح الحبِّ.....","https://www.poetsgate.com/ViewPoem.aspx?id=210695",""],[585,"سمعت صريف الباب وهو يسبح","https://www.poetsgate.com/ViewPoem.aspx?id=161931",""],[5121,"كأس الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=33579",""],[592,"تلألأ نور الحق في الخلق واستما","https://www.poetsgate.com/ViewPoem.aspx?id=128815",""],[592,"أقول نعم هذا هو الحق والهدى","https://www.poetsgate.com/ViewPoem.aspx?id=128810",""],[5362,"أهنيك بالعيد أم بالظفر","https://www.poetsgate.com/ViewPoem.aspx?id=170387",""],[5378,"ترى يتألف الشمل الصديع","https://www.poetsgate.com/ViewPoem.aspx?id=182684",""],[5431,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=190113",""],[5545,"قلبًا مؤازرًا","https://www.poetsgate.com/ViewPoem.aspx?id=184777",""],[5688,"وهكذا تآخينا","https://www.poetsgate.com/ViewPoem.aspx?id=200931",""],[6102,"عودة اضطرارية","https://www.poetsgate.com/ViewPoem.aspx?id=184458",""],[6237,"إغراء الحُب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77862&r=&rc=4",""]],"verses":[["فَقَد حالَ مِن حَزمِ الحَماتَينِ دونَهُم","وَأَعرَضَ مِن وادي البُليدِ شُجونُ",0,"ن",1,0],["فَقَد حَلَفَت جَهدًا بِما نَحَرَت لَهُ","قُرَيشٌ غَداةَ المَأزَمينِ وَصَلّتِ",1,"ت",1,0],["فَقَد حَمَلَتهُ لِلقُبورِ مَطِيَّةٌ","أَنافَت بِهاديهِ عَلى شَخصِ بابَكِ",2,"ك",1,0],["فَقَد حَلَّت يَمينُكَ إِن إِمامٌ","أَقامَ الحَدَّ وَاِتَّبَعَ الكِتابا",3,"ب",2,0],["فَقَد حَمَلَت ثَمانِيَةً وَوَفَّت","بِتاسِعِها وَتَحسِبُها كَعابا",3,"ب",2,0],["فقد حزتم دمعي عقيقاً ومهجتي","غضاً وسكنتم من ضلوعيَ منحنى",4,"ن",2,0],["فقد حكى العداة بالوقوف","فاعْطف على سائلك الضعيف",5,"ف",1,0],["فقد حطّها عني الإله بمحنةٍ","أراني بها رُشْدي وما زال مُنعما",6,"م",2,0],["فَقَد حُمَّت الحاجاتُ واللَيلُ مُقمِرٌ","وَشُدَّت لِطِيّاتٍ مَطايا وَأَرُحلُ",7,"ل",1,0],["فَقَد حَوى مَجلسي تَماما","إِن تَكُ مِن ريقِهِ عُقاري",8,"ر",2,0],["فَقَد حالَفَت قَيسٌ عَلى الناسِ كُلِّهِم","تَميماً فَهُم مِنها وَمِنها تَميمُها",9,"م",3,0],["فقَدْ حَفِظَتْ صَحائِفُهُنَّ حقّاً","ولستُ لما احتفَظْنَ به مُضِيعا",10,"ع",2,0],["فَقَد حَلَفَ البُخلُ أَلّا يُرى","بِها مَن يَتِمُّ لَهُ مَوعِدُ",11,"د",1,0],["فَقَد حَلَفَت لَنا أَن لَيسَ تَصحو","وَأَقسَمنا لَها أَن لَيسَ نَصحو",12,"ح",2,0],["فقد حضّهُ سكرُ المدام على النّدى","ولكنّه حضٌّ بريّ من الذمِّ",13,"م",1,0],["فقد حَملتْ لكم أسفاً طويلا","دعا صفوانُ شاعِرَه فلبَّى",14,"ب",2,0],["فقد حَمَلتُمْ عليهِ في قَصائِدِهِ","ما يُضْحِكُ الثَّقَلَينِ الجِنَّ والبشَرا",15,"ر",2,0],["فَقَد حَلَّ لَنا عَقداً","مِنَ التِكَّةِ تَستَعقِد",16,"د",1,0],["فَقَد حَمَوني الرَيحانَ خَوفاً عَلى","نَفسِيَ تَقضي لِذِكرِ حَيّانِ",17,"ن",1,0],["فقد حَلَفتُ يميناً","مبرورةً لا تُكَذّب",18,"ب",1,0],["فقد حلَّ لنا عقداً","من الأنعامِ واستسعد",19,"د",1,0],["فَقَد حازَتا فَضلَ الحَياةِ وَعُدَّتا","مَكانَ الثُرَيّا في المَكارِمِ وَالشَمسِ",20,"س",1,0],["فقد حس رعباً مَن جنى إذ أصابه","وَما حس سعد من إصابته رعبا",21,"ب",2,0],["فقد حَنّ سَوْطي في يدي من غرامِها","وحنّ اشْتِياقاً في حشاها جَنينها",22,"ن",3,0],["فَقَدْ حَاطَني في ظُلْمَةِ الْحَبْسِ بَعْدَما","تَرَامَتْ بِأَفْلاذِ الْقُلُوبِ الْحَنَاجِرُ",23,"ر",1,0],["فقد حلَفوا بأنَّك ما استطاعوا","ستبقى أقصرَ الأقوامِ باعا",24,"ع",2,0],["فقد حرمت عيني التلفت للسوى","كما حرمت من اجل موسى المراضع",25,"ع",1,0],["فقد حارَ عقلي الكليل","أمام الظلامِ المُحِيق",26,"ق",1,0],["فَقد حَانَ انتِبَهُكَ بَعدَ نَومٍ","وكَم نَومٍ لِصَاحِبِهِ إنتِبَاهُ",27,"ا",2,0],["فَقَد حَسِبُوا نُفُوسَهُم سِوَاهُم","وقَد حَسِبُوا شَمالِيُهم يَمِينَا",28,"ن",2,0],["فقد حقق الله آمالها","وفاءَ لها بانشراحِ الصدورْ",29,"ر",1,0],["فَقَد حَلَلتَ بِما تَأتي ذُرى شَرَفٍ","لَو يُدَّعى لَاِدَّعَتهُ السَبعَةُ الشُهُبُ",30,"ب",1,0],["فَقَد حازَ هَذا العَصرُ مِنكَ وَمِنهُما","فَضائِلَ لَم يَظفَر بِأَيسَرِها عَصرُ",31,"ر",1,0],["فَقَد حَمَلَت جَمالاً وَاِعتِدالاً","تُجِنُّهُما البَراقِعُ وَالغَلائِل",32,"ل",1,0],["فقد حتم الفناء عليك ربٌ","له وجب التفرُّد والدوام",33,"م",1,0],["فَقَد حازَ أَقصى المَجدِ في الطولِ وَالعَرضِ","وَماذا عَسى أُبديهِ مِن وَصفِ سَيِّدٍ",34,"د",1,0],["فقد حوى مازان من شبابه","أبهة الشيب وعظم القدر",35,"ر",1,0],["فقد حدثت في المسلمين حوادث","كبار المعاصي عندها كالصغائر",36,"ر",1,0],["فَقَد حالَ فَضلٌ دونَ ما أَنتَ طالِبٌ","لَدَيَّ وَذُو الإِحسانِ وَالجُودِ فاضِلُ",37,"ل",1,0],["فَقَد حَكت إِلى علاه سلّما","نَظمتُها في سبعةٍ أيّامِ",38,"م",1,0],["فقد حسبوا نحولكَ من نحولي","فخيفَ عليكَ عاقبةُ الغرامِ",39,"م",1,0],["فقد حسِنتْ هناكَ كلُّ أنثى","كأنَّ الحسنَ قُسِّمَ في الجميعِ",40,"ع",1,0],["فقد حَسَّناكَ وقد ملَّحاكَ","وما أحسَنا بي ولا أنصفا",41,"ف",2,0],["فقد حلّ بُولاقَ وَفْدُ السُّرورِ","وطاب لنا في رُبَاها النَّعِيم",42,"م",1,0],["فقد حَسَر الصِبَا عن ساعديه","وناغي بَمُّنَا مَثْنىً وزِيرا",43,"ر",2,0],["فَقَد حانَ الصَبوحُ وَحَنَّ قَلبي","إِلى عَذراءَ تَرقُصُ في الزُجاجِ",44,"ج",1,0],["فَقَدْ حَاجَيْتَ فِي صَرَمَتْكَ أَسْمَا","ءُ بَعْدَ وِصَالِهَا فَبَدَا الشَّمَاتُ",45,"ت",1,0],["فَقَدْ حَقَّقَ الْجَبَّارُ جَبْراً لِجَابِرٍ","بِمَا حَسَنٌ أَوْلاَهُ سِبْطُ مُحَمَّدِ",46,"د",1,0],["فَقَدْ حَكَى وَجْدُهُ عَلَيْهَا","وَجْدَ مُغِيثٍ عَلَى بَرِيرَهْ",47,"ر",2,0],["فَقَد حي المعَلّى في اجادةِ نَظمِه","وَلكنَّه في الحَظِّ مِنه مَنيح",48,"ح",1,0],["فَقَدْ حَمَلا عَنْهُ أحَادِيثَ بَأسِهِ","يُشَافِهُ ذا خَدّاً لِخَدٍّ وَذَا قَصَّا",49,"ص",2,0],["فَقَد حُمَّ ما قَد كُنتُ أَخشى وُقوعَهُ","فَقَلبي لِبَينَ الظاعِنينَ قَريحُ",50,"ح",1,0],["فقد حقق الدعوى القياس وأين من","كثافة جسم الخمر لطف المحبة",51,"ه",1,0],["فَقَد حَلَفتُ يَميناً غَيرَ كاذِبَةٍ","يَومَ المَغيبَةِ لَم يُقطَع لَها سَبَبُ",52,"ب",1,0],["فقد حَثَثْتُ في عِقالِ أَملي","على النّوى إلى المَحَلِّ القُذُف",53,"ف",1,0],["فقد حارَتِ الأفهام فيما سنَنْتَه","من الجودِ حتّى ما لِمفقودِهمْ ذِكر",54,"ر",1,0],["فقد حسَدتْ عَيْني كتابي صبَابةً","تَقولُ إذا الأشواقُ جَدّ اشتِدادها",55,"د",3,0],["فقد حان لي منها الذي كنت أبتغي","ووافى ربانا خير خل وصاحب",56,"ب",1,0],["فقد حال لا حال اشتياق لهم","مراحلُ فيما بيننا ورحيل",57,"ل",1,0],["فقد حقّقت فيك الظنون فاصبحت","من الخبر المأثور عنك على خبر",58,"ر",1,0],["فَقَدْ حانَ يومُ الفتحِ واهْتَزَّتِ المُنى","وصَحَّ رَجاءُ السَّيْفِ واستبشَرَ الرُّمْحُ",59,"ح",1,0],["فقد حانَ من بُرَحَاءِ الضُّلوعِ","رَحيلٌ تَنادى بِبَرْحِ الخَفاءِ",60,"ا",2,0],["فقد حتمَ الدهرُ الَّذِي حَلَّ خطبُهُ","بأَنْ لَيْسَ إِلّا بالمُظَفَّرِ يَجْلُوهُ",61,"و",2,0],["فقد حمت الحاجات من بعد موته","وكانت به إِلا له فهي حمت",62,"ت",1,0],["فقد حبب الأموات عندي نزوله","لديهم بأطباق الجنادل واللبن",63,"ن",1,0],["فقد حَصِرتْ حياءً عن نظيم","فمجّته نَثاراً مقلتاها",64,"ا",3,0],["فقد حملَتْ ونجت أنفساً","كرائمَ جبنَ الأماني سريعا",65,"ع",2,0],["فقد حار لحظِيَ بين اثنتين","هوىً منجدٍ وخليط يغورُ",66,"ر",1,0],["فقد حُوِّلتْ تلك المحاسنُ وانتهتْ","إلى غيرها في الأرض تلك المَنائحُ",67,"ح",1,0],["فَقَدْ حَدَّثْتْني النَّفْسُ أنْ اجْتِماعَنا","قَريبٌ وفي اللهِ الرَّجا والْمُعَوَّلُ",68,"ل",1,0],["فَقَدْ حَكَيْتُ فِيهِ","كِفَايَةَ النَّبِيهِ",69,"ه",1,0],["فَقَد حزتَ بِالورهاءِ أخبث خبثةٍ","فَدَع عنكَ ما قد قلت يا سعد واِحذرِ",70,"ر",1,0],["فقد حَسَّنَ عبدُالله","من دهرك ما سَمَّج",71,"ج",1,0],["فَقَد حَكَتِ الأَرضُ السَماءَ بَنَورِها","فَلَم أَدرِ في التَشبيهِ أَيُّهُما السَما",72,"م",2,0],["فقد حوى شَرَفَ الدنيا وإن صَفِرَتْ","كَفّاه من فِضّة فيها ومن ذَهَبِ",73,"ب",1,0],["فقد حدَّث الفِطر عن كل ما","فعلت من الصالحات الصيامُ",74,"م",1,0],["فقد حبسوها مَحبِسَ البُدنِ وابتغى","بها الرِّبحَ أَقوامٌ تساخَف مالُها",75,"ل",3,0],["فقد حسدت قبلي رجال أفاضل","وما عندنا للحاسدين سوى الصبر",76,"ر",1,0],["فقد حَسِبوا أن يجعلونا أكُولَةٌ","بها لَطَفٌ بين الجآجئ والصَّدْرِ",77,"ر",1,0],["فَقَد حَيَّ الحَلالُ بِهِ فَدَرَّت","لَنا التَقوى وَماتَ بِهِ الحَرامُ",78,"م",1,0],["فقد حوى مجلسي تماماً","إن كان من ريقه عقاري",79,"ر",2,0],["فقد حباك وسام المجد مبتسماً","وقد دعاك ابنَه في السر والعلن",80,"ن",1,0],["فقد حرروا جمع العلوم التي رووا","بتدريسها حتى تولوا الى الغرف",81,"ف",1,0],["فَقَد حَضَرُوا فَما نابُوا مَنابِي","وَلا سَدُّوا وَإِن كَثُرُوا مَكاني",82,"ن",2,0],["فَقَد حَكَمَ الرَّحمَنُ في نُظَرائِهِم","وَبَيَّنَهُ آيُ الكِتابِ المُصَرّفُ",83,"ف",1,0],["فَقَد حَمدوا في بَعضِ ما قَد مَضى لَهُم","فَإِن رَجَعوا فَالعَودُ لِلذَّنبِ قَد جَبّا",84,"ب",2,0],["فَقَد حَقَّقَ التَوحيدَ بِالنَصِّ قائِلاً","بِما قالَهُ خَيرُ الأَنامِ وَتابِعُه",85,"ع",2,0],["فقد حال من دون ذاكَ الزَّمانُ","وطالَ وطالَ عليَّ المدى",86,"ا",1,0],["فقد حلَّ حيث اشتهى وارتقى","بأعلى محَلٍّ وأسنى مَقِيل",87,"ل",1,0],["فَقَد حَلِيَت عَيني بِها وَهَويتُها","هَوى عَرضٍ ما زالَ مُذ كُنتُ أَمرَدا",88,"د",2,0],["فقد حار فكري في بدائع فضله","ومَن ذا الذي للقَطْر والرمل يحصف",89,"ف",1,0],["فَقَد حَجبت لِلسَماح انملا","كانَت وَلَيسَ عَن نداها حاجب",90,"ب",1,0],["فقد حملت شعرِى الركابُ شوارداً","فاتهمَ فى عَرضِ البلادِ وأنجدا",91,"د",2,0],["فقد حطمت غناه","فصار بالفقر مغري",92,"ر",2,0],["فقد حصّلتِ نقصاً فوق نقصٍ","ومن بعد التعالي قد سفلت",93,"ت",1,0],["فَقَدَّ حِجابَهُ بِمُذَرَّباتٍ","يُرينَ الحائِناتِ بِهِ الحِماما",94,"م",2,0],["فقد حصحص الاضواء وانجاب غيهب","فهل بعد هذا يرقد المرء حالما",95,"م",2,0],["فقد حسد الشّامُ فيه العراقَ","وظلّتْ به جِلّقٌ تستَنيرُ",96,"ر",1,0],["فَقَد حَصُلتُ عَلَى الآمَالِ أجمَعِهَا","وَخَابَ مَن فِي سِوَى ذَا كَانَ ذا تَعَبِ",97,"ب",1,0],["فقد حلّت فناء قراك ضيفاً","فاجمل منك بالحسنى قراها",98,"ا",3,0],["فقد حبى القلب بما يشتهي","وجاد في ابّانه القطر",99,"ر",1,0],["فقد حرمت على من كان يمشي","بمكة غير مدخل سقيم",100,"م",1,0],["فَقَد حلّ مِنّا كُل قَلب وَناظر","كَما شاقنا ذا