om/ViewPoem.aspx?id=31577",""],[91,"كلوا واشربوا","https://www.poetsgate.com/ViewPoem.aspx?id=53344",""],[28,"أحار أبت كفاك إلا تدفقا","https://www.poetsgate.com/ViewPoem.aspx?id=21715",""],[2,"معلقة هير بن أبي سلمى","https://www.poetsgate.com/ViewPoem.aspx?id=11406",""],[51,"أخفُّ مناطاً في الرقاب وأوْكَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=25837",""],[105,"ذراني أقم للشعر في مصر مأتما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54890&r=&rc=60",""],[23,"عفتْ ذاتُ الأصابعِ فالجواءُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=12796&r=&rc=0",""]],"verses":[["وَإِن سَحَبوا خِرصانَهُم لِكَريهَةٍ","تَصَدَّعَ صَدرُ الأَرضِ عَن قَلبِ واجِمِ",0,"م",1,0],["وَإِن سَرى أَسفَرَت صَوارِمُهُ","وَاِلتَثَمَت بِالحَوافِرِ الأَكَمُ",1,"م",1,0],["وَإِنَّ سَجلاً مِن دَمٍ آمِنٍ","أَفرَغَهُ الطَعنُ بِوادي العَقيق",2,"ق",1,0],["وَإِن سَمِعتَ فَقُل ما كانَ عَن أُذُنٍ","وَإِن نَظَرتَ فَقُل ما كانَ عَن نَظَرِ",3,"ر",1,0],["وَأَنسى كُلَّ ما جَنَتِ الرَزايا","عَلَيَّ مِنَ الفَوادِحِ وَالنُدوبِ",4,"ب",1,0],["وَإِن سَلَكَ البَرَّ هَزَّ الرَعا","نَ حَتّى يُنَفَّرَ ذَودَ القَطا",5,"ا",1,0],["وَإِن سَرى البَرقُ مِن تِلقائِها غَرِضَت","عِيسِي بِذي سَلَمٍ مِن مَبرَكٍ خَشِنِ",6,"ن",1,0],["وآنَسَها المرْعى الأنيقُ وصادَفَتْ","مَدى العَيْنِ في أرجائِهِ بَلَداً خِصْبا",7,"ب",2,0],["وإنْ سُئِلوا عمّنْ يُديرُ على العِدا","رَحى الحَرْبِ فيهمْ أو يكونُ لَها قُطْبا",7,"ب",2,0],["وإنْ سَرى بارِقٌ منْ أرضِها طَمَحَتْ","عَيْنٌ تُقَلِّصُ جَفْنَيْها عنِ الوَسَنِ",8,"ن",1,0],["وإنْ سَرَتْ نَمَّ بالمَسْرى تَبَرُّجُها","فالمِسْكُ في أرَجٍ والحَلْيُ في زَجَلِ",9,"ل",1,0],["وأنّسْتَ نفْساً طالَما لقِيَتْ بِها","صُروفُ اللّيالي في مُصاحَبَةِ النّوى",10,"و",2,0],["وإنْ سَمِعوا العَوْراءَ فرّوا بأنْفُسٍ","كِرامِ السّجايا لا تفِرُّ منَ الزّحْفِ",11,"ف",1,0],["وَأَنَّسَهُمْ وَالرَّوْعُ يُوحِشُ هَوْلُهُ","وَأَمَّنَهُمْ وَالْحَشْرُ تُذْكَى جَحِيمُهُ",12,"م",2,0],["وَأَنَّ سُؤَالَ الرَّبْعِ يَنْقَعُ غُلَّةً","فَيَحْصُلُ مِنْ أَنْبَاءِ مَنْ ظَعَنَ الْعِلْمُ",13,"م",1,0],["وَأَنْسَتْ غَرِيبَ الدَّارِ مَسْقَطَ رَأْسِهِ","وَمِنْ دُونِ فَرْخَيْهِ الْقَتَادَةُ وَالْخَرْطُ",14,"ط",1,0],["وإنْ سَمِعوا العَوْراءَ فرّوا بأنْفُسٍ","حَرامٌ على هاماتِها في الوَغى الفَرُّ",15,"ر",1,0],["وأنّسَ قَلْبي فهْوَ للعَهْدِ حافِظٌ","وقَلّ على الأيّامِ مَنْ يحْفَظُ العَهْدا",16,"د",2,0],["وآنَسْتَ نُوراً منْ جَنابِ محمّدٍ","يُداوي القُلوبَ الغُلْبَ والأعْيُنَ الرُّمْدا",16,"د",2,0],["وَإِنَّ سَبيلَنا لَسَبيلُ قَومٍ","شَهِدنا الأَمرَ بَعدَهُمُ وَغابوا",17,"ب",3,0],["وَإِن سَكَنَت تَقوى المُهَيمِنِ قَلبَهُ","فَقَد كانَ مِنها قَلبُ تَوفيقَ مُفعَما",18,"م",2,0],["وَاِنسابَ غُرمولهُ وَلا دَقَلٌ","في رَأسِهِ مِثلُ مِيسَمِ البَكرِ",19,"ر",1,0],["وَإِن سَقَت رَوضَةَ القِرطاسِ راحَتُهُ","رَأَيتَ سَيفيَّ وادٍ مِنهُ تَعتَجِبُ",20,"ب",1,0],["وَآنَستُ سوقَ اِحتِمالٍ أَبى","لِمُستَبضِعِ العُذرِ أَن يُكسِدا",21,"د",2,0],["وَإِن سِرتُ في الأَرضِ الفَضاءِ حَسِبتُني","أُدارِئُ رَحلي أَن تَميلَ حِباليا",22,"ي",2,0],["وَإِنسانُ عَيني يَحسِرُ الماءَ تارَةً","فَيَبدو وَتاراتٍ يَجُمُّ فَيَغرَقُ",23,"ق",1,0],["وَاِنسَمَرَت أَطلالُهُ وَأَلبَدا","وَهَدَّ إِذ أَزأَرَ ثُمَّ هَدهَدا",24,"د",2,0],["وإنْ سلَّ في غمد الغمام حُسامهُ","بَرَى كهدي الشوقُ الملمُّ وأضناني",25,"ن",2,0],["وإن سال ماء البشر فوق جبينه","فليس بمدفوع عن الورد سائلُ",26,"ل",1,0],["وإن ساءني أَنْ قَوْضَتْ رحلَك النوى","وعُوِّضت منها بالذَّميل وبالوَخْدِ",27,"د",1,0],["وَإِنَّ سَوادَ اللَيلِ لا يَستَفِزُّني","وَلا الجاعِلاتُ العاجَ فَوقَ المَعاصِمِ",28,"م",1,0],["وَاِنسَلَّتِ الهُندُوانِيّاتُ لَيسَ لَها","إِلّا جَماجِمَ هامِ القَومِ أَغمادُ",29,"د",1,0],["وأنسى في الحروب مذمريكم","نتاح اليتن ماحقة السليل",30,"ل",1,1],["وَأَن سَيَمنَعُهُم مِمّا نَوَوا حَسَبٌ","لَن يَبلُغَ المَجدَ وَالعَلياءَ مَقطوعُ",31,"ع",1,0],["وَإِن سَمِعوا سوءً بَدا في وُجوهِهِم","لِما سَمِعوا مِمّا يُقالُ لَنا البِشرُ",32,"ر",1,0],["وَإِنَّ سَناءَ المَجدِ مِن آلِ هاشِمٍ","بَنو بِتِ مَخزومٍ وَوالِدُكَ العَبدُ",33,"د",1,0],["وآنسة قد كان لي لينُ عطفها","فلم يبق لي إلا نِداها ونعتها",34,"ت",3,0],["وإنسان عيني إلى كم كذا","بحينٍ من الدهر لا يُذكر",35,"ر",1,0],["وإن ساجعَ الوُرقَ مال الحيا","بها خلفَ أوراقها تستر",35,"ر",1,0],["وإن سُمي بزهير صيغةً فعسى","يسمو بنبت له بالشبه تعليل",36,"ل",1,0],["وآنسة أعرضت عنها وقد جلت","عليَّ هضيم الكشح ريَّا المخلخل",37,"ل",1,0],["وآنسة قد فرَّق الدهر بيننا","فلله قلبي ما أحنّ وما أحنى",38,"ن",2,1],["وآنست ما قد قالَ غيريَ شاكياً","ومثليَ من غنى ومثلك من أغنى",38,"ن",2,0],["وإن سخا أتى على ذي العددِ","والكيل والوزن ومذروع اليدِ",39,"د",1,0],["وآنَسَ اللَّهُ نفساً أنت صاحبها","فإنها من معاليها بمُغتَرَبِ",40,"ب",1,0],["وإن سطوْتَ فكَمْ قَوَّمْتَ ذا أَوَدٍ","تَقْوِيمَ لَدْنٍ من الخطِّيِّ أمْلُودِ",41,"د",1,0],["وآنستُه فازداد نفراً كأنه","وإيايَ ظَبي قد أحسَّ بصائدِ",42,"د",1,0],["وإنّ سهامي لمَبريةٌ","كهمِّك من عُدة الثائرِ",43,"ر",1,0],["وأن سَيريش ما أبريه منها","بشحم مثل هُدَّاب الدِمَقس",44,"س",1,0],["وإن سُمته مطلاً رأى بك عارضاً","من الغيثِ ألقى بَرْكه وتمخَّضا",45,"ض",2,0],["وإن سكوتها عندي لبشرى","وإن غناءها عندي لمنعى",46,"ع",2,0],["وإن سقى أرض أخرى صوب راحته","هزت جناناً من النعماء ألفافا",47,"ف",2,0],["وإنْ سكتَّ ذليلاً غير منتصرٍ","ورتْك وارِيَةُ الأحقاد والحسكِ",48,"ك",1,0],["وإن سترَتْ وجهَ الحقائِق شبهةٌ","رمى سِترها بالصائباتِ الهواتك",49,"ك",1,0],["وإن سبق الرأيَ وعدٌ له","بمُنفسِه جلَّ أن يستقيلا",50,"ل",2,0],["وأنْ سوف يحييه بما هو فاعلٌ","إذا هو واراه الضريحُ المطمطمُ",51,"م",1,0],["وأن سوف يلقى أرْكُبَ البرِّ رَكْبُها","لديه مُنيخي كلِّ ناج عُزاهمِ",52,"م",1,0],["وأن ستفيء تامكة الأعالي","كأن سنامها الرعِنُ الخُشامُ",53,"م",1,0],["وآنسني فقدُ الجليسِ وأوْحَشتْ","مشاهدُه نفسي ولم أدرِ ما اجترمْ",54,"م",1,0],["وإنْ سَقَطاتي في كتابي تَتَابَعَتْ","فلا تَلْحنِي فيما جنيتُ على ذهني",55,"ي",1,0],["وإن سألنا ابنه ماذا أتاك به","أبوك قال لنا إكرارُ حرمان",56,"ن",1,0],["وَأَنسى نُشَيبَةَ وَالجاهِلُ ال","مُغَمَّرُ يَحِسَبُ أَنّي نَسِيُّ",57,"ي",1,0],["وَإِن سَأَلتَ قُرَيشاً عَن أَوائِلِها","فَهُم ذُؤابَتُها الأَعلَونَ وَالسَنَدُ",58,"د",1,0],["وَاِنسابَ نَحوَ النَهرِ لا","يَلوي عَلى المَرجِ النَضير",59,"ر",1,0],["وَاِنسابَ كُلُّ مُصَفِّقٍ عَذبٍ","وَاِهتَزَّ كُلُّ مُهَفهَفٍ مَضِرِ",60,"ر",1,0],["وَاِنسَ الهُمومَ فَلَيسَ يَسعُدُ ذاكِرٌ","وَاِسقِ النُجومَ فَإِنَّها جُلّاسي",61,"ي",1,0],["وَإِن ساءَكُم أَنَّهُم في الوُجودِ","وَأَزعَجَكُم أَنَّهُم يُعوِلون",62,"ن",1,0],["وَأَنسَيتَ أَملاكَ الزَمانِ الَّذي خَلا","فَلا قُدرَةٌ مِنهُم تُعَدُّ وَلا قَدرُ",63,"ر",1,0],["وَإِنَّ سُكوتي إِن عَرَتني ضَرُورَةٌ","وَكِتمانَها مِمَّن أُحِبُّ قَبيحُ",64,"ح",1,0],["وَإِن سَمِعَت رِزَّ الفَنيقِ تَكَشَّفَت","بِأَذنابِ صُهبٍ قُرَّحٍ كَالمَجادِلِ",65,"ل",1,0],["وإنْ سَكَبَ الدَّهْرُ في مسمعيْكِ","نَحيبَ الدُّجَى وأَنينَ الأَمَلْ",66,"ل",1,0],["وانسَ فيَّ الحَيَاةَ فالعمرُ قفرٌ","مرعبٌ إنْ ذَوَى وجَفَّ نَعيمُهْ",67,"م",2,0],["وانس ايامك التي كنت فيها","تتملى الحياة في كأس ساق",68,"ق",1,0],["وَإِن سُئِلتُ عَنهُ","وَعَن مَكاني مِنهُ",69,"ه",1,0],["وَإِن سَأَلَتهُمو الأَوطانُ أَعطَوا","دَماً حُرّاً وَأَبناءً وَمالا",70,"ل",2,0],["وَأُنسُ أَوقاتٍ ظَفِرنا بِها","في غَفلَةِ الأَيّامِ لَو دُمتَ دام",71,"م",1,0],["وَآنَستَ موسى وَتابوتَهُ","وَنورَ العَصا وَالوَصايا الغُرَر",72,"ر",1,0],["وإِنْ سَكَبَتْ يومَ الفِراقِ دُموعَها","فليس لَعَمْرُ اللّهِ ذاكَ يَقينُ",73,"ن",1,0],["وآنِسَةٍ عَذْبِ الثّنايا وجدتُها","على خُطّةٍ فيها لِذي اللُّبِّ مَتْلَفُ",74,"ف",1,1],["وَإِن سَرَرنَ بِمَحبوبٍ فَجَعنَ بِهِ","وَقَد أَتَينَكَ في الحالَينِ بِالعَجَبِ",75,"ب",1,0],["وَإِنَّ سَحاباً جَودُهُ مِثلُ جودِهِ","سَحابٌ عَلى كُلِّ السَحابِ لَهُ فَخرُ",76,"ر",1,0],["وآنساتٍ إِذا لاح الوميضُ لها","نصَّتْ إِلى لمعِها أجيادَ غِزلانِ",77,"ن",1,0],["وآنستِنَا حتى إِذا ما بَهَرْتِنَا","سناً وسناءً غِبْتِ غَيبوبةَ البَدْرِ",78,"ر",1,0],["وَإِن سَكَنَت عَنهُ حَسِبتَ صَفاءَهُ","حُساماً صَقيلاً صافِيَ المَتنِ جُرِّدا",79,"د",2,0],["وَآنَسَني عِلمي بِأَن لا تَقَدُّمي","مُفيدي وَلا مُزرٍ بِحَظّي تَأَخُّري",80,"ر",2,0],["وَإِن سَأَلوا أَينَ الدَنيئَةُ أَعوَزَت","لَدى أَحوَزِيٍّ لِلدَنيئَةِ مُنكِرِ",80,"ر",1,0],["وَآنَسَت مِن خُطوبِ الدَهرِ كَثرَتُها","فَلَيسَ يُرتاعُ مِن خَطبٍ إِذا طَلَعا",81,"ع",2,0],["وَآنَسَت لَهَواتي بَعدَ ما لَفَظَت","طَعمَ الصِيامِ حَديثاً طَعمَ شَوّالِ",82,"ل",1,0],["وَإِنَّ سِبابيكُم لَجَهلٌ وَأَنتُمُ","تُباعونَ في الأَسواقِ بَيعَ الجَلايِبِ",83,"ب",1,0],["وَإِنَّ سُكَيناً وَاِبنَهُ بَنَيا لَكُم","شَماريخَ في عَيطاءَ صَعبٍ جِبالُها",84,"ل",3,0],["وَإِن سُدَّت بِهِ لَهواتُ ثَغرٍ","يُشارُ إِلَيهِ جانِبُهُ سَقيمُ",85,"م",1,0],["وَإِن سَرَّني لَم اَبتَهج بِسُروره","فَكُلُّ سُرورٍ لا يَدومُ حَقيرُ",86,"ر",1,0],["وَآنَسونا بِها إِن عَزَّ قُربُكُمُ","فَالأُنسُ بِالسَمعِ مِثلُ الأُنسِ بِالنَظَرِ",87,"ر",1,0],["وَإِن سامَحوها في المِزاجِ تَمَرَّدَت","وَمالَت فَكادَت أَنفُسُ الصَحبِ تَهلَكُ",88,"ك",1,0],["وَإِنْ سَلْسَلَتْهَا الرِّيحُ أَبْدَتْ سَبَائِكَاً","مُقَدَّرَةٌ كَالْوَشْمِ فَوْقَ الْمَعَاصِمِ",89,"م",1,0],["وأنسى منزلاً رحباً","بزاويةٍ منَ الخصِّ",90,"ص",1,0],["وإنْ ساويتُ مَنْ قبلي فحسبي","مساواةُ القديمِ وذا لخيري",91,"ر",2,0],["وآنِسٌ أنْ بَئِسنا فهو مادِحُنا","أغَمَّهُ أن نَعَمنا فهو هاجينا",92,"ن",2,0],["وانساب حشدُ الرمال السافياتِ بها","يُحصى الأناسيَّ منها والأحايينا",92,"ن",2,0],["وَآنِساتٍ عَقإِلٍ","كَالظِباءِ الرَبائِبِ",93,"ب",1,0],["وَاِنسابَ بي نَهرٌ يَعُبُّ وَزَورَقٌ","فَتَحَمَّلَتني عَقرَبٌ وَحُبابُ",94,"ب",1,0],["وَاِنسابَ ثاني مَعطِفَيهِ كَأَنَّهُ","هَيمانُ نَشوانٌ هُناكَ مُذالُ",95,"ل",1,0],["وَإِنَّ سُقمي لَمِن طَرفٍ بِهِ سَقَمٌ","خُلوٍ مِنَ الكُحلِ مَملوءٍ مِنَ الكَحَلِ",96,"ل",1,0],["وَإِن سَأَلوا إِحدى يَدَيَّ فَأَعطِيا","يَميني وَإِن زادوا فَزيدوا شِمالِيا",97,"ي",2,0],["وانسابَ يأبى أن يَعيبَ زَمانَهُ","قِيلٌ يضيعُ به الزّمانُ وقالُ",98,"ل",1,0],["وَإِن سَلَكوا خُطَّةً أَقبَلَت","تَسيرُ الجُموعُ وَتَمشي الزُمَرْ",99,"ر",1,0],["وَإنَّ سَبيلَينا سَواءٌ وَكُلُّنا","بَنو مِصرَ نَأبى أَن تُضامَ وَتُهضَما",100,"م",2,0],["وَأَنَّ سَريرَ المُلكِ راصِدُ حَتفِهِ","يُخاتِلُهُ عَن نَفسِهِ وَيُوارِبُه",101,"ب",2,0],["وَإِنَّ سَيفَكَ وَالآمالُ خادِعَةٌ","لَكالمَنِيَّةِ يُطوى عِندَها الأَمَلُ",102,"ل",1,0],["وَانْساقَ يَتبَعُه أخوهُ وإنّه","لَمُهَذَّبٌ سَمْحٌ الخِلالِ مُثقَّفُ",103,"ف",1,0],["وَإِن سَدَّ بابَ الصَبرِ حادِثُ فَقدِهِ","لَقَد فَتَحَت بابَ الجِنانِ وَسائِلُه",104,"ل",2,0],["وَآنستَ بي مِن فَيض نورك لَمحةً","فَأَعليتَ مِن شَأني مَعيناً وَمرشدا",105,"د",2,0],["وَإِن سرَّك أَن يَبقى","فَأَنوارك وَهّاجه",106,"ج",2,0],["وأنسى ليلةً سلفتْ","وطرفي ساهر باكِ",107,"ك",1,0],["وَاِنسابَ حَيّاتُ الكَثيبِ وَأَقبَلَت","أُرقُ الفَراشِ لِما يَشُبُّ الموقِدُ",108,"د",1,0],["وَأَنَّ سَوامَ المَوتِ تَجري خِلالَنا","رَوائِحُ مِن أَحداثِهِ وَبَواكِرُ",109,"ر",1,0],["وَإِنَّ سُعاتَهُم لَكُمُ سُعاةٌ","وَإِنَّ نَمائَهُم لَكُمُ نَماءُ",110,"ا",2,0],["وَإِنَّ سَنائَهُم لَكُمُ سَناءٌ","وَإِنَّ وَفائَهُم لَكُمُ وَفاءُ",110,"ا",2,0],["وَإِنْ سَأَلتَهُم عَنهُ فَلا حَرَجٌ","إِنَّ المَحَكَّ عَنِ الدِّينارِ مَسْؤُولُ",111,"ل",1,0],["وانْسُبْ إلى ذانه ما شئْتَ مِنْ شَرَفٍ","وَانْسُبْ إلى قَدْرِهِ ما شِئْتَ منْ عِظَمِ",112,"م",1,0],["وإن سبقت منك المواعدُ أنجزَت","وإن أخذ الميثاق فهو وثيق",113,"ق",1,0],["وآنَسْتُ من أنصارِ دولةِ هاشمٍ","جَحاجِحَةً تَسْعَى لدولةِ هاشم",114,"م",1,0],["وأنساهمُ الإخشيدَ مَن شِسْعُ نَعلِهِ","أعزُّ من الإخشيدِ قدْراً وأرفَع",115,"ع",1,0],["وَآنِسٍ لا أَمَلُّ مَجلِسَهُ","قامَ لِوَقتٍ دَنا لِيَنقَلِبا",116,"ب",2,0],["وَاِنسابَ نَحوي يُغَنّي","مُطَرِّباً وَيُنادي",117,"ي",1,0],["وَآنَسَ الظَبيَ بِتَلٍّ عالِ","فَاِنسَلَّ قَلبي ساعَةَ الإِرسالِ",118,"ل",1,0],["وانسبي إن طلبتِ حُسنَ نسيبٍ","بغزالٍ من بعدِ وصف مُدام",119,"م",1,0],["وَإِن سَنَحَ الخِشفُ عارَضتَهُ","كَما اِندَفَعَ السابِحُ الأَجرَدُ",120,"د",1,0],["وَأَنسَيتُهُ لَونَ السَماءِ وَلَم يَكُن","يَرى غَيرَها مِن شِدَّةِ الكِبرِ وَالأَوَد",121,"د",1,0],["وَإِن سُرَّ حُسّادي فَسَيبُكَ واسِعٌ","عَلى الناسِ لا يَسطيعُهُ المُتَفَجفِجُ",122,"ج",1,0],["وَإِن سَلَّ سَيفاً مِن كَلامٍ مُسَفَّهٌ","عَلَيكَ فَقابِلهُ بِصَبرِكَ تُنبِهِ",123,"ب",2,0],["وَإِن سَعِدَت فَما تَنفَكُّ في تَعَبٍ","وَإِن شَقيتَ فَمَن لِلجِسمِ لَو هَمَدا",124,"د",2,0],["وَإِن سَأَلوا عَن مَذهَبي فَهُوَ خَشيَةٌ","مِنَ اللَهِ لا طَوقاً أَبُثُّ وَلا جَبرا",125,"ر",2,0],["وَإِِنَّ سَبيلَ الخَيرِ لِلمَرءِ واضِحٌ","إِلى يَومٍ يَقضي ثُمَّ تَنقَطِعُ السُبُل",126,"ل",1,0],["وانسمي بالغرام يا نسمةَ الْ","ليلِ وكوني إلى الأحبة رُسْلي",127,"ي",1,0],["وانْسِني وحشةَ الليالي","بقُبْلةٍ منكَ يا حبيبي",128,"ي",1,0],["وأنسيتُ حتى كأن لم يَكنْ","على الأمس ما كان أو مرَّ بي",129,"ي",1,0],["وإن سَكَبَتْ زهرةٌ دمعةً","فمن قلبه انحدرتْ دمعتانْ",130,"ن",1,0],["وإنْ سدّدَ الأعداءُ نحوَكَ أسْهُماً","نكَصْنَ على أفْواقِهِنَّ المَعابل",131,"ل",1,0],["وآنستْ سكينة الحواري","من رجل في صحوه سوّار",132,"ر",1,0],["وَأَنِسَ الطَّيْرُ إِلَى قُرْبِهِ","وَأَلِفَتْ كَرَّاتهِ الزُّهْرُ",133,"ر",1,0],["وَإنْ سِرْتُ بَرّاً يُجَارِي خُطَايَ","فَفِي الشَّرْقِ آناً وَفِي المَغْربِ",134,"ب",1,0],["وإن سارتِ الريحُ الهَبُوبُ بجَرْسِهِ","فآخِرُ أكنَافِ الوُجُودِ مَراحِلُهْ",135,"ل",2,0],["وأن سمعوا اللغو فروا بأنفس","كرام السجايا لا تفر من الزحف",136,"ف",1,0],["وآنست نورا من جناب محمد","يداوي القلوب الغلف والأعين الرمدا",137,"د",2,0],["وإن سعاتُهمْ لكُمُ سُعاة","ٌ وإنّ نَمَاءَهُمْ لكُمُ نَمَاءُ",138,"ا",2,0],["وإنَّ «سُلَيْمَى » في اللِّقاء لَحُرَّة","ٌ وإنِّي بَغيٌّ عنْدها لمُصابُ",139,"ب",1,0],["وانسُبْ الى ذاتِهِ ما شئتَ مِن شَرَفٍ","وانسُب الى قَدْرِهِ ما شئتَ مِن عِظَمِ",140,"م",1,0],["وآنسها بؤسُ الأديبِ وأُعْجِبَتْ","بِشِعرٍ عليه مهجةٌ تتناثر",141,"ر",1,0],["وإنَّ سواداً يحمِلُ الجَوْرَ مُكْرَهاً","فقيرٌ لِهادٍ بَينِ النُصْحِ حازِم",142,"م",1,0],["وانسَبْتَ في غُدرُ اللذائذ خائضاً","وخَبَرتَهن مصادِراً ومَواردا",143,"د",2,0],["وآنسَتْ لَهَواتِي بَعْد ما لَفَظَتْ","طَعْمَ الصيِّيَام حَدِيثاً طَعْمَ شوَّال",144,"ل",1,0],["وأنَسَ لَيْلَتَنَا في العِنَا","قِ لَفُّ الصِّبَا بِقَضِيبٍ قَضِيبَا",145,"ب",2,0],["وإن ساءكم في الوجود","وأزعجكم أنّهم يولون",146,"ن",1,0],["وَإنّ سُكَيْناً وَابْنَهُ لَكُمْ","شَمارِيخَ في عَيْطاءَ صَعبٍ جِبَالُها",147,"ل",3,0],["وَإَنَّ سَفَاهَ الشَّيْخِ لا حِلْمَ بَعْدَهُ","وَإِنَّ الفَتَى بَعْدَ السَّفَاهَةِ يَحْلُمِ",148,"م",1,0],["وإن سُلَّ منها فالْفَرائضُ تُرْعَدُ","ولكنّ ظلّ الليل أندى وأبرد",149,"د",1,0],["وإن سبيلنا سواءٌ وكلنا","بنو مصر نأبى أن تضام وتهضما",150,"م",2,0],["وأن سيوفنا تركتك عبدا","وعبد الدار سادتها الإماء",151,"ا",2,0]]}