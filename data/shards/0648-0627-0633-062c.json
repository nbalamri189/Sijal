{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55093","الكامل"],[215,"سر قاصدا سرعا يا حادي النجب","https://www.aldiwan.net/poem37918.html","البسيط"],[274,"دم المحب على الاطلال مطلول","https://www.aldiwan.net/poem52067.html","البسيط"],[274,"لم يبق في الحي من ربع ولا طلل","https://www.aldiwan.net/poem52078.html","البسيط"],[274,"صل الرغائب عشرا واثنتين وكن","https://www.aldiwan.net/poem52079.html","البسيط"],[285,"إن تغن الورقاء في الأوراق","https://www.aldiwan.net/poem32690.html","الخفيف"],[331,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[394,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[432,"هذي الديار ديار بيت الدين","https://www.aldiwan.net/poem40289.html","الكامل"],[517,"أيخفى صحيح الوجد والسقم لائح","https://www.aldiwan.net/poem12052.html","الطويل"],[531,"عصى أبو العالم وهو الذي","https://www.aldiwan.net/poem37077.html","السريع"],[560,"خفض عدوي في الهوى ومصادقي","https://www.aldiwan.net/poem34337.html","الكامل"],[560,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[560,"من الجسوم إلى الأرواح إسراء","https://www.aldiwan.net/poem35087.html","البسيط"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/21465","الطويل"],[1120,"","https://poetry.dctabudhabi.ae/diwan/poem/123622","المنسرح"]],"verses":[["وأْسُ جُرْحِ المِسْكِينِ وَامْسَحْ قَذَاهُ","أَنَا بِالحَمْدِ مَا اشْتَهَيْتَ كَفِيلُ",0,"ل",1,0],["وَاسْجُدْ وَقُلْ يَا رَبِّ إِنَّ","رِضَايَ مَا فِيهِ رِضاكْ",1,"ك",1,0],["واسجدْ هنالك إجلالاً لرؤيتها","وامضِ إلى سدرةِ الوادي مع الأثبِ",2,"ب",1,0],["واسجد لربك شكرا عند رؤيته","وَالئم بنان يد في باعها طول",3,"ل",1,0],["واسجد لربك شكرا وادع مبتهلا","فَكَم هناك من داع وَمبتهل",4,"ل",1,0],["واسجد لربك واخلص في السجود وَسل","تعطى فمن جد في اخلاصه وَجَدا",5,"د",2,0],["وَاِسجَعي تَفجَعي المحبَّ بِصَبرٍ","غَير باقٍ بَل مولَعٍ بِالإِباقِ",6,"ق",1,0],["واسجدي إن ألمّ يجمعه الل","ه مذيبُ الجفون والأحشاء",7,"ا",2,0],["واسجد وأحسن وسبح من تعالى علاه","واجلس ورض واسأل الغفران ربك عساه",8,"ا",2,0],["واسجد لدى سلسالها وارشف هناً","ان كان دينك بالمحبة ديني",9,"ن",2,0],["وأسجح لها ماء البشاشة وحده","فما قصدها إلا السجايا السجائح",10,"ح",1,0],["وأَسْجَدَ الأَمْلاكَ مِنْ أَجْلِهِ","وكانَ في الجَنَّةِ مَأْواهُ",11,"ه",1,0],["واسجد هناك لوجه حبك سجدة","من بعدها أخرى سجود الوامق",12,"ق",1,0],["وأسجدت أملاكي بأمري لمظهري","فكان سجودي لي وآدم قبلتي",13,"ي",1,0],["واسجد له سجدة أخرى بمسجده ال","أقصى يزل عنك بالتقريب إقصاء",14,"ا",2,0],["وأَسجحَ يَسمو في نشاصٍ جرت بِهِ","رَوائِحُ في أَعناقِهِنَّ بُسوق",15,"ق",1,0],["واسجحي اذ ملكت في مهل","وارعي جواراً حباله علقه",16,"ق",2,0]]}