{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55093","الكامل"],[216,"سر قاصدا سرعا يا حادي النجب","https://www.aldiwan.net/poem37918.html","البسيط"],[276,"دم المحب على الاطلال مطلول","https://www.aldiwan.net/poem52067.html","البسيط"],[276,"لم يبق في الحي من ربع ولا طلل","https://www.aldiwan.net/poem52078.html","البسيط"],[276,"صل الرغائب عشرا واثنتين وكن","https://www.aldiwan.net/poem52079.html","البسيط"],[287,"إن تغن الورقاء في الأوراق","https://www.aldiwan.net/poem32690.html","الخفيف"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[396,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[435,"هذي الديار ديار بيت الدين","https://www.aldiwan.net/poem40289.html","الكامل"],[520,"أيخفى صحيح الوجد والسقم لائح","https://www.aldiwan.net/poem12052.html","الطويل"],[534,"عصى أبو العالم وهو الذي","https://www.aldiwan.net/poem37077.html","السريع"],[563,"خفض عدوي في الهوى ومصادقي","https://www.aldiwan.net/poem34337.html","الكامل"],[563,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[563,"من الجسوم إلى الأرواح إسراء","https://www.aldiwan.net/poem35087.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38120","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96737","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96653","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136154","الكامل"],[1318,"","https://poetry.dctabudhabi.ae/diwan/poem/145328","الكامل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6758","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141294","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48239","الوافر"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109335","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53073","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53103","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27791","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77325","الرجز"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110613","الرمل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21465","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112679","الرجز"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71301","المنسرح"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91834","الكامل"],[4160,"","https://poetry.dctabudhabi.ae/diwan/poem/123622","المنسرح"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83170","الكامل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4767,"ارحميني","https://www.poetsgate.com/ViewPoem.aspx?id=212596",""],[4955,"عالج أحزانك بالتقوى","https://www.poetsgate.com/ViewPoem.aspx?id=188771",""],[4955,"ما لي ألقاك بلا أملٍ","https://www.poetsgate.com/ViewPoem.aspx?id=188772",""],[5038,"إنبطح يا عنترة","https://www.poetsgate.com/ViewPoem.aspx?id=195230",""],[5043,"وعد العرس الآتي","https://www.poetsgate.com/ViewPoem.aspx?id=203387",""],[5122,"أول كلامي","https://www.poetsgate.com/ViewPoem.aspx?id=24265",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5183,"نَبْعُ الفضلِ","https://www.poetsgate.com/ViewPoem.aspx?id=186454",""],[5183,"طوى","https://www.poetsgate.com/ViewPoem.aspx?id=180160",""],[5376,"عمَّ السماءَ فضائلٌ وسناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=188367",""],[5414,"حوار مع منافق","https://www.poetsgate.com/ViewPoem.aspx?id=12929",""],[5449,"عن القصيدة الفاضلة","https://www.poetsgate.com/ViewPoem.aspx?id=188871",""],[5455,"العيش والملح","https://www.poetsgate.com/ViewPoem.aspx?id=36404",""],[5493,"مساجدُ الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=205714",""],[5582,"قُمْ يا نَدِيمِي أَدِرْ ما فِي القَوارِيرِ","https://www.poetsgate.com/ViewPoem.aspx?id=63506",""],[5649,"سامر الحى","https://www.poetsgate.com/ViewPoem.aspx?id=151472",""],[5829,"قم لرمضان","https://www.poetsgate.com/ViewPoem.aspx?id=212930",""],[5956,"طقوس الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=182261",""],[6056,"القلب والنفس خضراء","https://www.poetsgate.com/ViewPoem.aspx?id=130182",""],[6127,"يا ماشياً نحو الطفوف","https://www.poetsgate.com/ViewPoem.aspx?id=192767",""],[6293,"ترنيمةُ المدَدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83639&r=&rc=1",""]],"verses":[["وأْسُ جُرْحِ المِسْكِينِ وَامْسَحْ قَذَاهُ","أَنَا بِالحَمْدِ مَا اشْتَهَيْتَ كَفِيلُ",0,"ل",1,0],["وَاسْجُدْ وَقُلْ يَا رَبِّ إِنَّ","رِضَايَ مَا فِيهِ رِضاكْ",1,"ك",1,0],["واسجدْ هنالك إجلالاً لرؤيتها","وامضِ إلى سدرةِ الوادي مع الأثبِ",2,"ب",1,0],["واسجد لربك شكرا عند رؤيته","وَالئم بنان يد في باعها طول",3,"ل",1,0],["واسجد لربك شكرا وادع مبتهلا","فَكَم هناك من داع وَمبتهل",4,"ل",1,0],["واسجد لربك واخلص في السجود وَسل","تعطى فمن جد في اخلاصه وَجَدا",5,"د",2,0],["وَاِسجَعي تَفجَعي المحبَّ بِصَبرٍ","غَير باقٍ بَل مولَعٍ بِالإِباقِ",6,"ق",1,0],["واسجدي إن ألمّ يجمعه الل","ه مذيبُ الجفون والأحشاء",7,"ا",2,0],["واسجد وأحسن وسبح من تعالى علاه","واجلس ورض واسأل الغفران ربك عساه",8,"ا",2,0],["واسجد لدى سلسالها وارشف هناً","ان كان دينك بالمحبة ديني",9,"ن",2,0],["وأسجح لها ماء البشاشة وحده","فما قصدها إلا السجايا السجائح",10,"ح",1,0],["وأَسْجَدَ الأَمْلاكَ مِنْ أَجْلِهِ","وكانَ في الجَنَّةِ مَأْواهُ",11,"ه",1,0],["واسجد هناك لوجه حبك سجدة","من بعدها أخرى سجود الوامق",12,"ق",1,0],["وأسجدت أملاكي بأمري لمظهري","فكان سجودي لي وآدم قبلتي",13,"ي",1,0],["واسجد له سجدة أخرى بمسجده ال","أقصى يزل عنك بالتقريب إقصاء",14,"ا",2,0],["واسجاشَ الربيعُ فيها جيوشاً","من جيوشِ الربيع فيها استجاشا",15,"ش",2,0],["وَاِسجَعْ عَلى الشّرفِ الأعلى بِجِلَّقِنا","فطَرْفُ جلَّق بالأفراح وَسْنانُ",16,"ن",1,0],["واِسجد لغرّةِ وجههِ في دستهِ","شكراً لمن قد كوّن الكونينِ",17,"ن",1,0],["وَاِسجد لَها إِن بدا في الكأسِ جوهرها","بَينَ الأغاني وتغريد المزاميرِ",18,"ر",1,0],["واسجع وغطرف بالاماكن والربى","فبذكرها يحيى رميم فوادي",19,"د",2,0],["واسجع بشعرك ما شدا متصلصلاً","شادي الحمام الورق في الغيطان",20,"ن",1,0],["وَأَسجُدُ تَعظيماً لَهُ وَتَذَلُّلاً","وَأَعبُدُهُ في الجَهرِ وَالخَلَواتِ",21,"ت",1,0],["واسجد لغابة أرزه فهي الّتي","تزهو على كلّ الرّبى برباها",22,"ا",3,0],["وأسجمَ للعفاةِ بكلِّ أرْض","نَوالاً يفضَحُ المزْنَ انثجاجا",23,"ج",2,0],["واسجن كل آن في مكان","كأني كل ذنب قد أتيت",24,"ت",1,0],["واسجد إذا رفع الحجاب وغض من","عينيك إذ يبدو السنى متوقدا",25,"د",2,0],["واسجد بهاتيك المواقف واقترب","منها فإن عظيم ذنبك يغفر",26,"ر",1,0],["وأسجدتُ أملاكي وكانوا أئمة","لرتبتك العليا فأمسيت معبدا",27,"د",2,0],["وَاِسجُد لِمَن أَلبَسَني","تاجَ بَيانِ العَربِ",28,"ب",1,0],["واسجعي اللحن عراقا وحجاز","حيث اضحى معرقا ركب الحجاز",29,"ز",1,0],["وأَسجحَ يَسمو في نشاصٍ جرت بِهِ","رَوائِحُ في أَعناقِهِنَّ بُسوق",30,"ق",1,0],["واسجُد إذا شِئتَ سجودَ شُكرِ","للَهِ فُزتَ بهذا الأجر",31,"ر",1,0],["وَاسْجُدْ لَهُمْ وَاْقَتَرِبْ فَعَاشِقُهُمْ","يَسْجُدُ شَوْقاً لهُمْ وَيَقْتَرِبُ",32,"ب",1,0],["واسجد لرب الأمر تحظى عنده","وَاخفض جناحك ما استطعت لمن سفه",33,"ف",2,0],["واسجحي اذ ملكت في مهل","وارعي جواراً حباله علقه",34,"ق",2,0],["وَاِسجَع عَلى أَيكِ النِيابَةِ بُلبلاً","جَعَل الرُواةَ لِسحرِهِ الأَحقابا",35,"ب",2,0],["وَأَسجُدُ أَي أَفنى وَأَفني عَنِ الفَنا","فَأَسجُدُ أُخرى وَالمُتَيَّمُ والِعُ",36,"ع",1,0],["واسجُنيني واحكِمي إغلاقَ بابِ ال","قلبِ كم لي طاب فيه اليوم سجنا",37,"ن",2,0],["واسجد في جوفِ الليلِ وقل","ودموعُ العينِ على الخدِّ",38,"د",1,0],["واسجدْ لإلهكَ في ليلٍ","خاطبه وقل أنتَ الأخبرْ",39,"ر",1,0],["وَاسْجُدْ لِأَصْنامِ الْغُزاةِ تَعَبُّداً","وَاقْبَلْ بِما يَقْضي زَعيمُ الْغَشْمَرَهْ",40,"ر",2,0],["وأسجدُ للهِ شكراً وأبكي","إلى ما يشاءُ الحنينُ البكاءْ",41,"ا",2,0],["واسجد أبوجهي لك وباسمك ناديت","تجعل لنا من نور هديك بصيره",42,"ر",2,0],["وأسجدت في نوم له الأنجم التي","لها حسدا إخوانه اغتشموا الغشما",43,"م",2,0],["واسجد لربك عالقاً في آيه","حيث العلا والعزة القعساء",44,"ا",2,0],["واسجُد السجدتين حيث المصلَّى","يتجلى تحت المصلِّي ذمِاما",45,"م",2,0],["واسجدْ لربِّك خاشعاً متذللاً","متوسلاً إنَّ الدعاءَ رجاءُ",46,"ا",2,0],["واسجدنَّ الغداةَ نذلا ذليلاً","في زفيرٍ مسبِّحٍ وشهيق",47,"ق",1,0],["واسْجُدْ لِرَبِّكَ طولَ العُمْرِ مُحْتَسِبَاً","واسْجُدْ بِقَلْبِكَ قَبْلَ الجِّسْمِ يا بَشَرُ",48,"ر",1,0],["واسجّ فيها عن هوى كل طامن","وأروي بها عروقٍ عليها معاطيش",49,"ش",1,0],["واسجُدْ إذا وجَّهتَ قلبَكَ طائعًا","نحوَ المنابرِ سجدةَ الإلهامِ",50,"م",1,0],["وَاسْجُدْ لَها إِنْ بَدا فِي الكأْسِ جَوْهَرُها","بَيْنَ الأَغانِي وَتَرْجِيعِ المَزامِيرِ",51,"ر",1,0],["واسجع على روضة الأشعار قافية","واشد العفية آكاما وشطانا",52,"ن",2,0],["واسجدْ هناكَ تذللاً فلقدْ طمى","خطبٌ يزلزلُ والهمومُ نوازل",53,"ل",1,0],["وأسجد لله حمداً كثيراً","‏ وأذرف دمعا يسمَّى غرامْ",54,"م",1,0],["وأسّج إلى مرت ، بفكري تخطرا","مشاعري ، لاجت على البال ، يبكون",55,"ن",1,0],["واسجدْ بجنبِ أنينه متخشّعاً","ومعفّراً خديك عند الكُمَّلِ",56,"ل",1,0],["وأسجدتْ كُلَّ أوجاعِ الهوى أبداً","هل خلَّدَتْ في الليالي البيضِ من أحدِ ؟",57,"د",1,0]]}