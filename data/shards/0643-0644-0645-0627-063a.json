ولة الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=33514",""],[5121,"رُبّان","https://www.poetsgate.com/ViewPoem.aspx?id=215582",""],[5155,"الى معجزة الغناء العربي (ام كلثوم)","https://www.poetsgate.com/ViewPoem.aspx?id=176242",""],[5550,"مُلئ الدهرُ","https://www.poetsgate.com/ViewPoem.aspx?id=212116",""],[5573,"يكرم لعينك مهو ب واحد بلد","https://www.poetsgate.com/ViewPoem.aspx?id=204552",""],[5616,"مهر شموس","https://www.poetsgate.com/ViewPoem.aspx?id=207462",""],[5853,"الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=175698",""],[5916,"أيُّهَا الْسَارِحُ","https://www.poetsgate.com/ViewPoem.aspx?id=190588",""],[5936,"ليت حلمي","https://www.poetsgate.com/ViewPoem.aspx?id=184774",""],[6102,"ذَبح !!","https://www.poetsgate.com/ViewPoem.aspx?id=183996",""],[6102,"يَفعَلُ البُعدُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=185335",""],[6142,"يا له خاطباً رقي صهوة ال","https://www.poetsgate.com/ViewPoem.aspx?id=155686",""]],"verses":[["كُلَّما غابَ مِن بَني خَلَفٍ بَد","رٌ يُضيءُ الظَلامَ أَخلَفَ بَدرا",0,"ر",2,0],["كُلَّما غازَلَتهُ مِنهُ فَتاةٌ","ماسَ عُجباً وَأَرسَلَ الزَنكَلوني",1,"ي",1,0],["كُلَّما غَنَّت الحَمائِمُ قُلنا","مَعبَدٌ إِذ شَدا أَجابَ الغَريضُ",2,"ض",1,0],["كلما غرَّد كأسٌ شربوا الخمرةَ لحنا","يا حبيبي كلُّ ما في الليل روحٌ يتغنَّى",3,"ن",2,0],["كلّما غبت عنه وغاب عنّي","لاح في خاطري وسيما أنيقا",4,"ق",2,0],["كلما غنّيت لحنا في ديار البلبل","سرق اللحن وألقاهُ بأُذن الجدول",5,"ل",1,0],["كُلَّمَا غَنَّتِ الْبلاَدُ بِسَعْدٍ","رَدَّدَتْ في السمَاءِ لَحْنَ الْغِنَاءِ",6,"ا",2,0],["كلَّما غامَ كُربةً من ضَبابٍ","فرَّجَتْ عنه قُبْلةٌ من شِهاب",7,"ب",1,0],["كلّما غبت عنه أو غاب عنّي","لاح في خاطري وسيما أنيقا",8,"ق",2,0],["كُلَّما غَرَّقَ الظَلامُ عُيوني","أَطلَعَ الحُبُّ في دَمي أَنوارا",9,"ر",2,0],["كلّما غَيّبَ الحوادثُ عنّي","وجْهَ رأْيٍ ولم تُقمْه إزائي",10,"ا",2,0],["كُلَّما غَنَت الحَمائِم في الفَجر","سَقَتني ذِكراه كَأس الحَمام",11,"م",1,0],["كُلَّما غاضَ لنا بحرٌ بَدا","خِضْرِمٌ طامٍ كَريمُ المَوْرِدِ",12,"د",1,0],["كلَّما غيَّبْتَ قومي بَرَزوا","كلَّما أصغرْتَ قومي كَبُروا",13,"ر",3,0],["كلما غاب كوكب","أطلعت فيه كوكبا",14,"ب",2,0],["كلما غرد الكريم ترجَّى","عفوه وابتغى لقاك بجلق",15,"ق",1,0],["كلما غُيِّبَت بفيك مجازاً","أشرقت من سماء خدك بالحق",16,"ق",1,0],["كُلَّما غَنّى بَنانٌ","اِسمَعي أَو خَبِّرينا",17,"ن",2,1],["كلما غنت على أشجارها","سلمت نفسي إلى أشجانها",18,"ه",2,0],["كلما غردت قيان رباها","غطتها الأغصان بالأزهار",19,"ر",1,0],["كلما غنى المغني بالذي","صغته كدنا من الوجد نذوب",20,"ب",1,0],["كلما غني نسيم","نالها منه انتشاء",21,"ا",2,0],["كلما غادة تولت ظفرناً","بسواها تجاوز الحسن حدا",22,"د",2,0],["كلّما غَصَّ هواكم من جفوني","سكنَ اللَّوْمُ اغتراراً لسكوني",23,"ن",2,1],["كلما غنَّت الحمائم شَبت","لك في القلب زفرةٌ وضرام",24,"م",1,0],["كُلَّما غابَ ظالِمٌ, جاءَ أَطغَى","مِنهُ ظُلمًا, بما مَضَى مُستَهِلَّا",25,"ل",2,0],["كلما غرد طيرٌ مُصبحاً","بين أغصانٍ تسامى وارتقى",26,"ق",2,0],["كلّما غابتْ هُنا شمسُ الأصيل ِ","أو تناءتْ في غروب ٍبالزّويل ِ",27,"ل",1,1],["كُلَّمَا غَرَّدَتْ طُيُورُ رِيَاضِي","رَقَصَ الْوَرْدُ فَوْقَ غُصْنِ الْعَطَايَا",28,"ا",3,0],["كلما غردت وداست اسانا","الهمتنا الصفاء والسلوانا",29,"ن",2,0],["كلما غُلِّفَ الوجودُ بصمْتٍ","فاسْمعي خافقي عليكِ ينادي",30,"د",2,0],["كل ما غنيت في وصلك جديد","غنت الامزان من وصلك بعد",31,"د",1,0],["كلما غردت بلابل روحي","أسقطتها تلك اليمين. الغموس٠٠",32,"س",1,0],["كلما غنى بلحنٍ رددت","لحنه الدنيا ليبقى في الأفق",33,"ق",1,0],["كُلَّمَا غَنَّى فُؤاديْ رَاقَصَاً","أسْبَغَ الْلَيْلُ غَنُوْجَاً فيْ ضَلَالِ",34,"ل",1,0],["كل ما غمضت عيني .. لو دقيقه","شفت طب القلب.. سلواه ... ومتاعه",35,"ع",2,0],["كُلَّما غِبتَ رَمانِي","مِنْ ثَقِيفِ الوَجدِ رُمحُ",36,"ح",1,0],["كُلَّما غِبتِ عَن عُيُونِيَ فاضَتْ","عَبَراتِي وَهَزَّنِي تَحنانُ",37,"ن",1,0],["كلما غص بالتلاوة حلقا","قطعتها مقامعٌ من حديد",38,"د",1,0]]}