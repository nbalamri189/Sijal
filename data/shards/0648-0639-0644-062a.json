{"poems":[[55,"إنا نعيب ولانعاب","https://www.aldiwan.net/poem30746.html","مجزوء الكامل"],[39,"وعلتها بتركها تحفش الأ","https://www.aldiwan.net/poem7055.html","الخفيف"],[23,"إن النضيرة ربة الخدر","https://www.aldiwan.net/poem21240.html","الكامل"],[53,"عيد يطابق أول الأسبوع","https://www.aldiwan.net/poem65060.html","الكامل"],[93,"هيهات بعدك ما يفيد تصبر","https://www.aldiwan.net/poem8822.html","عموديه"],[80,"فديت أبا عمرو من فتى","https://www.aldiwan.net/poem14181.html","المتقارب"],[47,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[63,"بين الشنوف الحمر والأقراط","https://www.aldiwan.net/poem51578.html","البسيط"],[46,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[102,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[96,"ما شأن هذا الأشعث الجواب","https://www.poetsgate.com/ViewPoem.aspx?id=15610",""],[193,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[234,"يا من به تزهى الدهور","https://www.aldiwan.net/poem51062.html","مجزوء الكامل"],[266,"لمن المهارى اليعملات القود","https://www.aldiwan.net/poem38338.html","الكامل"],[266,"أعيونهن أم بيض الصفاح","https://www.aldiwan.net/poem38347.html","الرمل"],[287,"أنى يسوغ لعاشق كتمانه","https://www.aldiwan.net/poem32399.html","الكامل"],[303,"واها لأيام الشباب الغض","https://www.aldiwan.net/poem36825.html","عموديه"],[308,"لما تناهت في البلاغةِ ربتة","https://www.aldiwan.net/poem57653.html","الكامل"],[347,"شارد اللب والفكر","https://www.aldiwan.net/poem55314.html","مجزوء الخفيف"],[382,"رقت البتولة في معارف ربها","https://www.aldiwan.net/poem59299.html","الكامل"],[422,"أتراك تعرف علتي وشفائي","https://www.aldiwan.net/poem54187.html","الكامل"],[435,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[466,"أي الخطوب من الزمان أزل","https://www.aldiwan.net/poem15110.html","الكامل"],[466,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[520,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[543,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[556,"قل للنوائب قد أصبت المقتلا","https://www.aldiwan.net/poem47316.html","الكامل"],[556,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[567,"كيف هذي الدنيا وهذا الزمان","https://www.aldiwan.net/poem52761.html","الخفيف"],[572,"أصبحت لا مال لي سوى الأمل","https://www.aldiwan.net/poem69539.html","المنسرح"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126899","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39070","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62543","الكامل"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47408","الرجز"],[1409,"","https://poetry.dctabudhabi.ae/diwan/poem/130250","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79978","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125460","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125364","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125360","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52046","الكامل"],[2115,"","https://poetry.dctabudhabi.ae/diwan/poem/116641","الرمل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100210","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58287","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127365","الرمل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127368","الرمل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74155","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132781","الخفيف"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35875","الكامل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82807","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112297","الرمل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74069","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138598",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110047","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91797","الرمل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132167","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135682","المجتث"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102732","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94784","الكامل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198189","الكامل"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115326","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133150","الكامل"],[4441,"","https://poetry.dctabudhabi.ae/diwan/poem/138772",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120505","الكامل"],[4767,"سهم الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=180942",""],[4767,"مسحة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=210249",""],[4978,"تشطير من الكفيل","https://www.poetsgate.com/ViewPoem.aspx?id=178201",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5397,"أطربتني نغمات لحن المنشد","https://www.poetsgate.com/ViewPoem.aspx?id=157934",""],[5436,"شوق التراب(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=34912",""],[5582,"أَسْيانُ ما فِي الأَيْكِ ناحَ حَمامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=63573",""],[5691,"الشيخ والحاخام والبابا","https://www.poetsgate.com/ViewPoem.aspx?id=205928",""],[402,"ظهرت حياة في البلاد جديدة","https://www.poetsgate.com/ViewPoem.aspx?id=36037",""],[5861,"عواصف الروح","https://www.poetsgate.com/ViewPoem.aspx?id=188578",""],[6045,"أملٌ ممتنع !","https://www.poetsgate.com/ViewPoem.aspx?id=125350",""],[6237,"حطم المارد القيود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77882&r=&rc=24",""],[2638,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87865&r=&rc=22",""]],"verses":[["وَعَلَت إِلى أَوكارِها العِق","بانُ وَاِنحَطَّ العُقابُ",0,"ب",1,0],["وعلتها بتركها تحفِش الأ","كمّ ويكفي المُضبب التفجيرا",1,"ر",2,1],["وَعَلَت مَساوِئُها مَحاسِنَها","مِمّا أَضَرَّ بِها مِنَ الضُمرِ",2,"ر",1,0],["وعلتْ وجوهَهُمُ التي بيَّضْتَها","قتراتُ ذُلٍّ قامع وخشوع",3,"ع",1,0],["وَعَلَت عَلى تِلكَ الوُجوهِ سَحابَةٌ","كَدراءُ لا تَصفو وَلا تُستَمطَرُ",4,"ر",1,0],["وَعَلَّتكَ بالريقِ لَو أَنَّهُ","أُبيحَ لِذي الزُهدِ لَم يَزهَدِ",5,"د",1,0],["وَعَلَت أَريَحِيَّةٌ مِنهُ تُدني","هِ لِأُنسٍ عَنِ الحِجى وَالمَهابَه",6,"ب",2,0],["وعَلَتْ ثِمارُ صُدورِها أجسادَها","فحُرِمْنَ مَسَّ مَجاسِدٍ ورِياطِ",7,"ط",1,0],["وَعَلَت قُراها غَبرَةٌ وَلَقَد تُرى","في ظِلِّهِ وَكَأَنَّما هِيَ أَنجُمُ",8,"م",1,0],["وَعَلَتْ شِكَايَةُ رَاسِفٍ فِي قَيْدِهِ","مِنْ أَلْفِ وَعْدٍ أُعْقِبَتْ بِمِطَالِ",9,"ل",1,0],["وَعَلَتْ نَغْمَةُ السُّرورِ وَرَقَّتْ","جَأَرَاتُ الْخِضَمِّ ذِي الإِزْبَادِ",10,"د",1,0],["وَعَلَتْ بفَضْل مَلِيك مِصرَ مَكَانةً","لم تَقْتَعِدْها في السَّماءِ الأَنْسُر",11,"ر",1,0],["وعلت جبهة (الحورنق) تاجا","يا (سنمّار) أيّ مثيره ؟!",12,"ر",2,0],["وعلت مع الأوراد في غلس الدّجى","أغنيّة للحبّ من زرياب",13,"ب",1,0],["وَعَلت فوقَ عُلا الخلقِ علاه","شَرَفاً أينَ الثريّا والثرى",14,"ر",2,0],["وعلت طِباعيَ نَبْوةٌ","واعتاد أخلاقي فتور",15,"ر",1,0],["وعلت بهم في العالمين علومهم","والعلم ليس على علاه مزيد",16,"د",1,0],["وعلت شهباؤنا الشهب علا","منه في الأفق وفاقت في البطاح",17,"ح",1,0],["وَعَلَت عَلَيهِ هِمَّةٌ صَفَوِيَّةٌ","فَهِيَ السماءُ وَأَرضُها كيوانُهُ",18,"ن",2,0],["وَعلّتِ الأنفاسُ والتراقي","وَدرَّتِ العروقُ والمآقي",19,"ي",1,0],["وعلت على أوج الفصاحة تزدهي","بمحاسن الإغراء والإغراب",20,"ب",1,0],["وعلته كآبة","مرة الخبر والخبر",21,"ر",1,0],["وعلَت بحب اللَه مولاها العلي","أعلى من الأفهام والإدراكِ",22,"ك",1,0],["وعلت على أفهامنا ألفاظه","فتمثَّلت بكواكب الجوزاء",23,"ا",2,0],["وعلت الضجة من نداهُ","إياك ها هو يا أخيَّ ها هو",24,"و",1,0],["وعلتْ رؤوسٌ بالضراب صواعداً","ثم انثنتْ في الجو وهي نوازلُ",25,"ل",1,0],["وعلَتْ به نُعْماهُ صهوةَ سابحٍ","نهدٍ مراكلُه عَلَنْدى جُرْشُعِ",26,"ع",1,0],["وعلت فشامخ مجدها لا يرتقى","وغلت فباذخ قدرها لا يشترى",27,"ر",2,0],["وعَلَتِ الأَذكَارُ","لِلوَاحدِ الرَّحمَانِ",28,"ن",1,0],["وَعَلتْ ديارَك كلُّ هَوجاءِ الخُطا","تدع الكميَّ معفَّراً ومجدَّلا",29,"ل",2,0],["وعَلَتْ بهمْ لمّا جَذَبتُهُمُ","بيَدَيَّ قَسْراً تلكُمُ الوَهْدُ",30,"د",1,0],["وعَلَتْ رَنَّةُ النُّواحِ وسالتْ","دُرَرُ الدَّمعِ بينها المَرْجانُ",31,"ن",1,0],["وَعَلَتْهَا حُمْرَةٌ فِي لَعَسٍ","تَسْتَعِيْرُ اللَّوْنَ مِنْ صِبْغِ الخَجَلْ",32,"ل",1,0],["وعَلَت له فوقَ الثريّا هامة","وعنِ المكارمِ والعلا لم يجبنِ",33,"ن",1,0],["وعَلَتْ عَلى شُمِّ الغُصونِ طُيورُها","تَشدوكَ سَجْعاً مُشْجيا أو مُطْرِبا",34,"ب",2,0],["وعلت به هِمَاته هامَ العُلا","حتى استوى بأسرَّة الأقمارِ",35,"ر",1,0],["وَعَلَت لأَصْحابِ السَّفينَةِ ضَجَّةٌ","وَأَنا وَذِكْرُكِ في أَلَذِّ تَناجي",36,"ج",2,0],["وعلتْ علُوَّ الشمسِ في غُلَوائِها","حين استقلّ على دِمَاغ الأصيدِ",37,"د",1,0],["وعَلَتْ عُرُوق بنِي الزبير من الثَّرى","حتى رجَعن إلى جِمَامِ المَوْرِدِ",37,"د",1,0],["وعلتْ رياحُ الموتِ خافقةً","بأجشّ قسطله لها زجلُ",38,"ل",1,0],["وعلت صيحةٌ تجمَّعَ منها","بالياتُ الرُّفاتِ والأشلاءِ",39,"ا",2,0],["وعَلَت على عَرشِ الجمال وَأَرسلت","شَرَكَ الغرام وأبعدَت طيف الكرى",40,"ر",2,0],["وعلَت على عرشِ الجمالِ بعزِّها","فكَسَت أديمَ الأرضِ ثوباً أخضَرَا",41,"ر",2,0],["وعلت إلى الجمات تطلبُ أن ترى","هل في السماءِ لها شبيه ثانِ",42,"ن",1,0],["وَعَلَتْ لَدَيْكَ على المِلاحِ بِحُرمَةِ","حقٍ لكونْك كفأها في المْحَتِدِ",43,"د",1,0],["وعَلت عن حرِّ أُخرى","تُلهبِ النَّارَ التِهابا",44,"ب",2,0],["وَعَلت عَلى مَتنِ الهَوَى وتزودَت","ذِكرَ الحبيبِ وَوَصلَهُ المَتدَانِ",45,"ن",1,0],["وَعَلَت عَلَيهَا النَّارُ حَتَّى ظُنَّ أن","يَعلُو عَلَيهَا الخَلقُ مِن نِيرَانِ",45,"ن",1,0],["وعلت في الكرامِ منهُ سجايا","كُتبَت في صحائِفِ الأَزمانِ",46,"ن",1,0],["وعلت علو النجم حلتكم بكم","فسمت لكم أرض بها وسماء",47,"ا",2,0],["وَعَلتَ ضجّةُ المواصِلِ حُزناً","والنّدامى على السُّرورِ عُكوفُ",48,"ف",1,0],["وعلت منهم هتافا","ت تدوي كالرعود",49,"د",1,0],["وعلت في الجو صيحات القرود","والذي في باطن الأرض ظهر",50,"ر",1,0],["وَعلت عَلى شَرف الجَمال وَإنها","وَلعت بفت مَرائر العُشاق",51,"ق",1,0],["وعلت باتحادها والترقي","ذروة المجد والمعالي السنيه",52,"ي",2,0],["وَعَلَت مَناقِبكَ السَمَاواتِ العُلا","وَغَدَوتُ مَمدوحاً بِكُلِّ لِسانِ",53,"ن",1,0],["وَعلت دولَةُ الهدى فَرَأَينا","دَولَةَ الشِركِ أَصبَحَت في اِنهِزام",54,"م",1,0],["وَعَلَت شكوَايَ من قلبي المريض","خلياني",55,"ي",1,0],["وَعَلَت صَراحته فَكانَت حجّة","لا لبس تسترهُ وَلا إِبهاما",56,"م",2,0],["وعلت ضجة المشاعر حتى","لو وعتها الورى من الرعب ماتوا",57,"ت",3,0],["وعلت إلى أَوج العُلى بتواضُعٍ","قِدَماً تَنَكَّبَ عنهُ ساطانيلُ",58,"ل",1,0],["وَعلت فينا صعاوٍ","أَسفلت منا الرخاخ",59,"خ",1,0],["وعلَّت طفلتي وأنا عليلٌ","ولاح بوجهها شبح الحمام",60,"م",1,0],["وعلّتي هي قولي","سرتم بجسمي وقلبي",61,"ب",2,0],["وعلته من بعد الكآبة بهجة","فغدا يميس ونشره يتأرج",62,"ج",1,0],["وعلت على الأطواد منهُ رآفةٌ","وسرادقاً بالأمن أعلاها نشر",63,"ر",1,0],["وَعَلَتْ ((أبو ظَبْيٍ)) سَحَابَةُ نِعْمَةٍ","هَطَلَتْ وَسَحَّتْ كالسُّيولِ سِجالاَ",64,"ل",2,0],["وعَلَته أبهةُ الجَلال كأنَّه","قَمرٌ بدا لك من خِلال غَمامِ",65,"م",1,0],["وعلت ولاةُ الظلم في ظلماتها","وخبت عن الأقطار منه أنوارُ",66,"ر",1,0],["وعلت بها فوق الجنا","ن مراتبا أعلى المراتب",67,"ب",1,0],["وعلت معاليه فهن كواكب","وجلت معانيه فهن جواهر",68,"ر",1,0],["وعَلتْ صرخةُ الفراقِ تدوي","وتبث الحنين في كل واد",69,"د",1,0],["وعلَتْها مسحةُ الحزن وعنْ","كلِّ ما طاب مِن العيش انزوت",70,"ت",1,0],["(وعلت منابرنا النوابح جهرةً )","مِن كُلِّ زِنْديقٍ وَمَوْتورٍ عَميلْ",71,"ل",1,0],["وعلت بآفاق الحياة حميدة","وتضوعت مسكا بكل مكان",72,"ن",1,0],["وعلت بهيكلك الشريعة مسندا","والسمك يعلو بارتفاع الأعمد",73,"د",1,0],["وعلتْ هِمَّةٌ تَزيَّتْ بدرعٍ","من نسيجِ القلوبِ صارتْ حزاما",74,"م",2,0],["وَعَلَتْ عَلَى خَضْرائِها غَبْراؤُهُ","وَيَخِفُّ يَوْمَ السِّلْمِ عَنْهُ شَمامُهُ",7