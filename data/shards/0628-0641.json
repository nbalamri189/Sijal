,"فيا ليت أنا قد تعشقت الملا","https://www.aldiwan.net/poem4738.html","الطويل"],[478,"ليبجح الدهر لما ردني جزعا","https://www.aldiwan.net/poem15210.html","البسيط"],[480,"يا علوة ما كان ظني أن أجزى","https://www.aldiwan.net/poem37875.html","الطويل"],[501,"رأت رفرف الأكوان هند فولت","https://www.aldiwan.net/poem37718.html","الطويل"],[501,"يا آلهي بدولة الأسماء","https://www.aldiwan.net/poem37720.html","الخفيف"],[501,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[501,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[515,"هلم بنا إلى أرض الحجون","https://www.aldiwan.net/poem20805.html","الوافر"],[515,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[516,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[516,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[525,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[552,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[559,"يا مثمرا قبل ينبت","https://www.aldiwan.net/poem34535.html","المجتث"],[568,"ضرب في ارتشاف ذاك الرضاب","https://www.aldiwan.net/poem69817.html","الخفيف"],[574,"حذار حذار من ركون إلى الزمن","https://www.aldiwan.net/poem3640.html","الطويل"],[587,"صاحي الجوانح لست منه بصاحي","https://www.aldiwan.net/poem17472.html","الكامل"],[588,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["بِفَواقِرٍ تَدَعُ الرُؤوسَ أَميمَةً","وَقَوارِعٍ تَدَعُ العَزيزَ ذَليلا",0,"ل",2,0],["بِفَمٍ إِذا رَفَعَ الكَلامُ سِجافَهُ","أَوحى بِنائِلِهِ وَإِن لَم يُسأَلِ",1,"ل",1,0],["بِفُؤادِهِ وَبِصَفحَتَيهِ مِنَ الصَدى","وَمِنَ الرِماءِ عَنِ الحِياضِ نُدوبُ",2,"ب",1,0],["بِفَترَةِ أَلحاظٍ هِيَ السَّيفُ مُنتَضىً","وَرِقَّةِ أَلفاظٍ هيَ اللؤلؤُ الرَطْبُ",3,"ب",1,0],["بِفيهِ الثَّرَى قد فَرَّقَتْ بَيْنَنا النَّوَى","نَأَى عَنْهُ فَرخاهُ فَفيمَ يَصيحُ",4,"ح",1,0],["بفِتيةِ صِدْقٍ إنْ دَجا ليْلُ حادِثٍ","فهُمْ سُرُجٌ آفاقُهُنّ سُروجُ",5,"ج",1,0],["بِفَتىً جَميعِ القَلبِ غَيرِ مُشَتَّتٍ","إِن مالَتِ الأَهرامُ لَيسَ يَميلُ",6,"ل",1,0],["بِفَضْلِكِ فِي بِلادِ الضَّادِ هَبَّتْ","عَقَائِلُهَا تُجَاهِدُ بِسَعْدِ لأْيِ",7,"ي",1,0],["بِفَصَاحَةٍ لَيْسَتْ لِتُبْقِيَ حَاجَةً","فِي نَفْسِ مُطَّلِعٍ إِلَى تِبْيَانِ",8,"ن",1,0],["بِفِتيَةٍ كَسُيوفِ الهِندِ لا وَرِعٍ","مِنَ الشَبابِ وَلا خورٍ صَفاريتِ",9,"ت",1,1],["بفضلك يا ابن فضل الله عادت","وعاد حديثها أهل السيادة",10,"د",2,0],["بفضل يديه أو بفضل دعائه","تشيم وتستسقي الغمائم والقطرا",11,"ر",2,0],["بفتاةٍ تسرنا في المثاني","وعجوزٍ تسرُّنا في الزجاجِ",12,"ج",1,0],["بِفَيشَةٍ مَمْلُوءةٍ تسْتَسلحُهْ","مُفْسِدَةٍ تحسبها تَسْتَصْلِحُهْ",13,"ح",2,0],["بفعله لا بأقاويلنا","أربت على الأطلاق أطلاقه",14,"ق",2,0],["بِفؤادي لك حُبُّ يَقتَضي","أَن تُرى تُحمَلُ فَوقَ الأرؤسِ",15,"س",1,0],["بفوز جنودنا الفوز العجيبا","بعيد الفتح قد أضحى قريبا",16,"ا",1,0],["بِفاتِحٍ غازٍ عَفيفِ القَنا","لا يَحمِلُ الحِقدَ وَلا يَعتَدي",17,"د",2,0],["بِفارِسِ المَجروحِ وَالشَمالِ","أَبي شُجاعٍ قاتِلِ الأَبطالِ",18,"ل",1,0],["بِفَرعٍ يُعيدُ اللَيلَ وَالصُبحُ نَيِّرٌ","وَوَجهٍ يُعيدُ الصُبحَ وَاللَيلُ مُظلِمُ",19,"م",1,0],["بفرائدٍ حُذٍّ مثقَّفَةٍ","مُلْسِ المُتونِ نوافرٍ شُمْسٍ",20,"س",1,0],["بِفَضيلَةٍ في النَفسِ توصَلَ عِندَهُ","بِفَضائِلِ الآباءِ وَالأَجدادِ",21,"د",1,0],["بِفَنائِهِم رَكَزَ السَماحُ لِواءَهُ","وَالبَأسُ سَيفَ النَصرِ وَالتَأييدِ",22,"د",1,0],["بِفاتِرِ اللَحظِ وَالأَلفاظِ جاءَ عَلى","تَخَوُّفٍ وَعُيونُ الناسِ تَرمُقُهُ",23,"ق",2,0],["بِفَوارِسٍ مِثلِ الصُقورِ وَضُمَّرٍ","مَجدولَةٍ كَكَواسِرِ العُقبانِ",24,"ن",1,0],["بِفَوارِسٍ لَحِقوا أَبوهُم دارِمٌ","بيضُ الوُجوهِ عَلى العَدُوِّ ثِقالِ",25,"ل",1,0],["بِفي الشامِتينَ الصَخرُ إِن كانَ مَسَّني","رَزِيَّةُ شِبلي مُخدِرٍ في الضَراغِمِ",26,"م",1,1],["بفوائد تجلي الولي جليلة","ومكائد تردي العدو دقاق",27,"ق",1,0],["بفَرْعٍ من عَدِيٍّ بينَ ماضي","غِرارِ العَزْمِ أو واري الزِّنادِ",28,"د",1,0],["بِفِتيَةٍ كَسُيوفِ الهِندِ يَبعَثُهُم","هَمٌّ فَكُلُّهُمُ ذو حاجَةٍ يَقِدُ",29,"د",1,0],["بِفِتيَةٍ أَسكَنوا أَطرافَ سُمرِهِمِ","مِنَ الكُماةِ مَقَرَّ الضَغنِ وَالأَضَمِ",30,"م",1,0],["بِفَضلٍ يُخجِلُ السُحُبَ الغَوادي","وَلَفظٍ يَفجُرُ الصُمَّ الجِلادا",31,"د",2,0],["بِفاحِمٍ سَبطٍ إِذا ما رَجَّلَه","قَبَّلَ في حالِ القِيامِ أَرجُلَه",32,"ل",2,0],["بِفَضائِلٍ وَفَواضِلٍ وَشَمائِلٍ","قَيدُ الخَوَطِرِ وَالثَنا وَالأَعيُنِ",33,"ن",1,0],["بِفَضائِلٍ شَهِدَت بِهِنَّ السُحبُ وَالت","تَوراةُ وَالإِنجيلُ وَالفُرقانُ",34,"ن",1,0],["بفضلك الماحق الدياجي","كأنه واضح النهار",35,"ر",1,0],["بفَوّاحَةِ الزّهْرِ مُخْضَلّةٍ","تُجادُ معَ الصّبْحِ أو تُرْهُمُ",36,"م",1,0],["بفوّاحةِ النَّوْر مُكّاؤها","يُرَجّعُ في كلّ غُصْنٍ صَفيرَه",37,"ر",2,0],["بِفارِسِ دُعمِيٍّ وَهَضبَةِ وائِلٍ","وَكَوكَبِ عَتّابٍ وَجَمرَةِ هاشِمِ",38,"م",1,0],["بِفَضلِكَ صِرتُ أَكثَرَهُم عَطاءً","وَقَبلَكَ كُنتُ أَكثَرَهُم سُؤالا",39,"ل",2,0],["بِفَتى بَني العَبّاسِ وَالقَمَرِ الَّذي","حَفَّتهُ أَنجُمُ يَعرُبٍ وَنِزارِ",40,"ر",1,0],["بفتحِ الدينِ شُرِّفنا","رفيقٌ وافرُ الفضلِ",41,"ل",1,1],["بِفاحِمٍ مُكرَعٍ سودٍ غَدائِرُهُ","تَثني عَلى المَتنِ مِنهُ وارِداً جَثَلا",42,"ل",2,0],["بِفَرعِ النَبيتِ فَالشَرى خَفَّ أَهلُهُ","وَبُدِّلَ أَرواحاً جَنوباً وَشَمأَلا",43,"ل",2,0],["بفيه من البيان العذب ورد","تطيب نطافه والعيش صاب",44,"ب",1,0],["بِفِكرِهِ مِن مَصيفٍ شَبَّ لَفحَتُهُ","وَكَفِّهِ مِن رَبيعٍ رَبَّ مَربَعُهُ",45,"ع",2,0],["بفضلكم قد طغى طوفانُ هجرتهم","وكان وعداً تلقَّيناه إيعاداً",46,"د",2,0],["بِفارِسِ ذي الأَدراعِ بَعلِكِ فَاِندُبي","مَناقِبَ خِرقٍ بِالثَأى غَيرِ مُفدَحِ",47,"ح",1,0],["بِفِتيانٍ ذَوي كَرَمٍ وَصِدقٍ","وَهُم أَهلُ المُعَصَّبِ وَالثُمالِ",48,"ل",1,0],["بِفِناءِ بَيتِكِ وَاِبن مُشعَبَ حاضِرٌ","في سامِرٍ عَطِرٍ وَلَيلٍ مُقمِرِ",49,"ر",1,0],["بِفَناءِ مَكَّةَ لِلحَجيجِ مَواسِمٌ","وَالياسِريَّةُ مَوسِمُ العُشّاقِ",50,"ق",1,1],["بِفَضلِ بنِ يَحيى أَشرَقَت سُبُلُ الهُدى","وَأَمَّنَ رَبّي خَوفَ كُلِّ بِلادِ",51,"د",1,0],["بِفِتيانِ صِدقٍ مِن سَراةِ ابنِ مالِكٍ","وَأَزدِ عُمانٍ ذي العُلى وَالمَفاخِرِ",52,"ر",1,0],["بِفِتيانٍ يَرَونَ القَت","لَ في اللَذَّةِ قُربانا",53,"ن",2,0],["بفقرٍ غير ذي ريش تراه","سريعاً ح