1.html","الوافر"],[40,"يا دار عاتكة التي بالأزهر","https://www.aldiwan.net/poem42273.html","الكامل"],[52,"بفناء مكة للحجيج مواسم","https://www.aldiwan.net/poem26810.html","الكامل"],[48,"أربع البلى إن الخشوع لباد","https://www.aldiwan.net/poem62604.html","الطويل"],[48,"طربت إلى خمر وقصف الدساكر","https://www.aldiwan.net/poem63297.html","الطويل"],[48,"إذا عبا أبو الهيجاء","https://www.aldiwan.net/poem65307.html","الهزج"],[48,"دخلن عواذلي من كل باب","https://www.aldiwan.net/poem66249.html","الوافر"],[48,"إن كان يحيى يقدر","https://www.aldiwan.net/poem66289.html","المجتث"],[46,"إصبر فمن حيث أهين الحصى","https://www.aldiwan.net/poem22595.html","السريع"],[46,"سباك الله يا دنيا عروسا","https://www.aldiwan.net/poem22964.html","الوافر"],[46,"بفي الحصى هل تملأ الخلد التي","https://www.aldiwan.net/poem23212.html","الطويل"],[76,"أما الهدى فاستقام من أوده","https://www.aldiwan.net/poem39449.html","المنسرح"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54312","البسيط"],[106,"فقيد القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179682",""],[106,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[91,"في القطار","https://www.poetsgate.com/ViewPoem.aspx?id=53084",""],[91,"فلسطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67966&r=&rc=244",""]],"verses":[["بِفَواقِرٍ تَدَعُ الرُؤوسَ أَميمَةً","وَقَوارِعٍ تَدَعُ العَزيزَ ذَليلا",0,"ل",2,0],["بِفَمٍ إِذا رَفَعَ الكَلامُ سِجافَهُ","أَوحى بِنائِلِهِ وَإِن لَم يُسأَلِ",1,"ل",1,0],["بِفُؤادِهِ وَبِصَفحَتَيهِ مِنَ الصَدى","وَمِنَ الرِماءِ عَنِ الحِياضِ نُدوبُ",2,"ب",1,0],["بِفَترَةِ أَلحاظٍ هِيَ السَّيفُ مُنتَضىً","وَرِقَّةِ أَلفاظٍ هيَ اللؤلؤُ الرَطْبُ",3,"ب",1,0],["بِفيهِ الثَّرَى قد فَرَّقَتْ بَيْنَنا النَّوَى","نَأَى عَنْهُ فَرخاهُ فَفيمَ يَصيحُ",4,"ح",1,0],["بفِتيةِ صِدْقٍ إنْ دَجا ليْلُ حادِثٍ","فهُمْ سُرُجٌ آفاقُهُنّ سُروجُ",5,"ج",1,0],["بِفَتىً جَميعِ القَلبِ غَيرِ مُشَتَّتٍ","إِن مالَتِ الأَهرامُ لَيسَ يَميلُ",6,"ل",1,0],["بِفَضْلِكِ فِي بِلادِ الضَّادِ هَبَّتْ","عَقَائِلُهَا تُجَاهِدُ بِسَعْدِ لأْيِ",7,"ي",1,0],["بِفَصَاحَةٍ لَيْسَتْ لِتُبْقِيَ حَاجَةً","فِي نَفْسِ مُطَّلِعٍ إِلَى تِبْيَانِ",8,"ن",1,0],["بِفِتيَةٍ كَسُيوفِ الهِندِ لا وَرِعٍ","مِنَ الشَبابِ وَلا خورٍ صَفاريتِ",9,"ت",1,1],["بفضلك يا ابن فضل الله عادت","وعاد حديثها أهل السيادة",10,"د",2,0],["بفضل يديه أو بفضل دعائه","تشيم وتستسقي الغمائم والقطرا",11,"ر",2,0],["بفتاةٍ تسرنا في المثاني","وعجوزٍ تسرُّنا في الزجاجِ",12,"ج",1,0],["بِفَيشَةٍ مَمْلُوءةٍ تسْتَسلحُهْ","مُفْسِدَةٍ تحسبها تَسْتَصْلِحُهْ",13,"ح",2,0],["بفعله لا بأقاويلنا","أربت على الأطلاق أطلاقه",14,"ق",2,0],["بِفؤادي لك حُبُّ يَقتَضي","أَن تُرى تُحمَلُ فَوقَ الأرؤسِ",15,"س",1,0],["بفوز جنودنا الفوز العجيبا","بعيد الفتح قد أضحى قريبا",16,"ا",1,0],["بِفاتِحٍ غازٍ عَفيفِ القَنا","لا يَحمِلُ الحِقدَ وَلا يَعتَدي",17,"د",2,0],["بِفارِسِ المَجروحِ وَالشَمالِ","أَبي شُجاعٍ قاتِلِ الأَبطالِ",18,"ل",1,0],["بِفَرعٍ يُعيدُ اللَيلَ وَالصُبحُ نَيِّرٌ","وَوَجهٍ يُعيدُ الصُبحَ وَاللَيلُ مُظلِمُ",19,"م",1,0],["بفرائدٍ حُذٍّ مثقَّفَةٍ","مُلْسِ المُتونِ نوافرٍ شُمْسٍ",20,"س",1,0],["بِفَضيلَةٍ في النَفسِ توصَلَ عِندَهُ","بِفَضائِلِ الآباءِ وَالأَجدادِ",21,"د",1,0],["بِفَنائِهِم رَكَزَ السَماحُ لِواءَهُ","وَالبَأسُ سَيفَ النَصرِ وَالتَأييدِ",22,"د",1,0],["بِفاتِرِ اللَحظِ وَالأَلفاظِ جاءَ عَلى","تَخَوُّفٍ وَعُيونُ الناسِ تَرمُقُهُ",23,"ق",2,0],["بِفَوارِسٍ مِثلِ الصُقورِ وَضُمَّرٍ","مَجدولَةٍ كَكَواسِرِ العُقبانِ",24,"ن",1,0],["بِفَوارِسٍ لَحِقوا أَبوهُم دارِمٌ","بيضُ الوُجوهِ عَلى العَدُوِّ ثِقالِ",25,"ل",1,0],["بِفي الشامِتينَ الصَخرُ إِن كانَ مَسَّني","رَزِيَّةُ شِبلي مُخدِرٍ في الضَراغِمِ",26,"م",1,1],["بفوائد تجلي الولي جليلة","ومكائد تردي العدو دقاق",27,"ق",1,0],["بفَرْعٍ من عَدِيٍّ بينَ ماضي","غِرارِ العَزْمِ أو واري الزِّنادِ",28,"د",1,0],["بِفِتيَةٍ كَسُيوفِ الهِندِ يَبعَثُهُم","هَمٌّ فَكُلُّهُمُ ذو حاجَةٍ يَقِدُ",29,"د",1,0],["بِفِتيَةٍ أَسكَنوا أَطرافَ سُمرِهِمِ","مِنَ الكُماةِ مَقَرَّ الضَغنِ وَالأَضَمِ",30,"م",1,0],["بِفَضلٍ يُخجِلُ السُحُبَ الغَوادي","وَلَفظٍ يَفجُرُ الصُمَّ الجِلادا",31,"د",2,0],["بِفاحِمٍ سَبطٍ إِذا ما رَجَّلَه","قَبَّلَ في حالِ القِيامِ أَرجُلَه",32,"ل",2,0],["بِفَضائِلٍ وَفَواضِلٍ وَشَمائِلٍ","قَيدُ الخَوَطِرِ وَالثَنا وَالأَعيُنِ",33,"ن",1,0],["بِفَضائِلٍ شَهِدَت بِهِنَّ السُحبُ وَالت","تَوراةُ وَالإِنجيلُ وَالفُرقانُ",34,"ن",1,0],["بفضلك الماحق الدياجي","كأنه واضح النهار",35,"ر",1,0],["بفَوّاحَةِ الزّهْرِ مُخْضَلّةٍ","تُجادُ معَ الصّبْحِ أو تُرْهُمُ",36,"م",1,0],["بفوّاحةِ النَّوْر مُكّاؤها","يُرَجّعُ في كلّ غُصْنٍ صَفيرَه",37,"ر",2,0],["بِفارِسِ دُعمِيٍّ وَهَضبَةِ وائِلٍ","وَكَوكَبِ عَتّابٍ وَجَمرَةِ هاشِمِ",38,"م",1,0],["بِفَضلِكَ صِرتُ أَكثَرَهُم عَطاءً","وَقَبلَكَ كُنتُ أَكثَرَهُم سُؤالا",39,"ل",2,0],["بِفَتى بَني العَبّاسِ وَالقَمَرِ الَّذي","حَفَّتهُ أَنجُمُ يَعرُبٍ وَنِزارِ",40,"ر",1,0],["بفتحِ الدينِ شُرِّفنا","رفيقٌ وافرُ الفضلِ",41,"ل",1,1],["بِفاحِمٍ مُكرَعٍ سودٍ غَدائِرُهُ","تَثني عَلى المَتنِ مِنهُ وارِداً جَثَلا",42,"ل",2,0],["بِفَرعِ النَبيتِ فَالشَرى خَفَّ أَهلُهُ","وَبُدِّلَ أَرواحاً جَنوباً وَشَمأَلا",43,"ل",2,0],["بفيه من البيان العذب ورد","تطيب نطافه والعيش صاب",44,"ب",1,0],["بِفِكرِهِ مِن مَصيفٍ شَبَّ لَفحَتُهُ","وَكَفِّهِ مِن رَبيعٍ رَبَّ مَربَعُهُ",45,"ع",2,0],["بفضلكم قد طغى طوفانُ هجرتهم","وكان وعداً تلقَّيناه إيعاداً",46,"د",2,0],["بِفارِسِ ذي الأَدراعِ بَعلِكِ فَاِندُبي","مَناقِبَ خِرقٍ بِالثَأى غَيرِ مُفدَحِ",47,"ح",1,0],["بِفِتيانٍ ذَوي كَرَمٍ وَصِدقٍ","وَهُم أَهلُ المُعَصَّبِ وَالثُمالِ",48,"ل",1,0],["بِفِناءِ بَيتِكِ وَاِبن مُشعَبَ حاضِرٌ","في سامِرٍ عَطِرٍ وَلَيلٍ مُقمِرِ",49,"ر",1,0],["بِفَناءِ مَكَّةَ لِلحَجيجِ مَواسِمٌ","وَالياسِريَّةُ مَوسِمُ العُشّاقِ",50,"ق",1,1],["بِفَضلِ بنِ يَحيى أَشرَقَت سُبُلُ الهُدى","وَأَمَّنَ رَبّي خَوفَ كُلِّ بِلادِ",51,"د",1,0],["بِفِتيانِ صِدقٍ مِن سَراةِ ابنِ مالِكٍ","وَأَزدِ عُمانٍ ذي العُلى وَالمَفاخِرِ",52,"ر",1,0],["بِفِتيانٍ يَرَونَ القَت","لَ في اللَذَّةِ قُربانا",53,"ن",2,0],["بفقرٍ غير ذي ريش تراه","سريعاً حين يُرسل في الطلاب",54,"ب",1,0],["بفعل كفّ جلوبٍ","عليك أمراً مقدّر",55,"ر",1,0],["بِفَضلِ مَولانا وَإِحسانِهِ","يُماطُ عَنّا البُؤسُ وَالضُرُّ",56,"ر",1,0],["بِفَقدِ غَرائِزي شَمّي وَذَوقي","وَلَمسي تابِعاً بَصَري وَسَمَعي",57,"ي",1,0],["بِفَيِّ الحَصى هَل تَملَأُ الخَلَدَ الَّتي","بِفيها لِرائي العَينِ سِمطُ لَآلي",58,"ل",2,1],["بفتحِ قَرْمونةَ التي سَبَقتْ","ما عدَّ كفُّ الخلافِ من عددِهْ",59,"د",2,0],["بفَطانةِ الصحفيِّ وهي بصيرَةٌ","تغزُو وتفتَح مُغلقَ الأسدادِ",60,"د",1,0],["بِفُؤَادٍ وَهْوَ نِعْمَ الفَ","رْعُ عَادَ الأَصلُ يَنْمُو",61,"م",2,0],["بِفتوحٍ تَرُدًّ فِي كُلِّ يَوْمٍ","مِنْ حُقُوقٍ مَا ضَيَّعَتْ أَعْوَامُ",62,"م",1,0],["بفَيصلٍ مِن سُيوفِ اللَهِ مُنصَلِتٍ","ماضي الغِرارِ وَإِن لَم يَمضِ في الهامِ",63,"م",1,0],["بِفُؤادي مِنكَ أَودى","وَبِصَبري عَنكَ أَلوى",64,"و",2,0],["بِفَضْلِهِ صِرْتِ في الشُّعُوبِ","مَهِيبَةَ الْقَدْرِ في الْقُلُوبِ",65,"ب",1,0],["بفضِلكَ صينَتُ حقوقُ البلاد","ورُدَّ «القنالُ» إلى من حفر",66,"ر",1,0],["بفضلهم عاد للشَّهباء أحمدُها","بل أحمداها، وزارَ الشام حَسانُ",67,"ن",1,0],["بفيتم في سلام واغتباط","تضيء وجوهكم هذي الدّيارا",68,"ر",2,0],["بفسي \" أردنّها \" السلسبيل","ومن جاوروا ذلك الأردنا",69,"ن",2,0]]}