{"poems":[[55,"قليل من الخلان من لا تذمه","https://www.aldiwan.net/poem29759.html","الطويل"],[55,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[37,"أأطلال دار من سعاد بيلبن","https://www.aldiwan.net/poem38818.html","الطويل"],[37,"أأطلال دار بالنياع فحمت","https://www.aldiwan.net/poem39176.html","الطويل"],[53,"أقول مرت ظبيتان فصدتا","https://www.aldiwan.net/poem66781.html","الطويل"],[72,"أأرحل من مصر وطيب نعيمها","https://www.aldiwan.net/poem42799.html","الطويل"],[45,"غيري بأكثر هذا الناس ينخدع","https://www.aldiwan.net/poem9719.html","البسيط"],[64,"سقى دارها بالجزع صوب غمائم","https://www.aldiwan.net/poem52283.html","الطويل"],[47,"رحلوا فأية عبرة لم تسكب","https://www.aldiwan.net/poem10645.html","الكامل"],[47,"بعينيك ضوء الأقحوان المفلج","https://www.aldiwan.net/poem62674.html","الطويل"],[47,"سلام عليكم لا وفاء ولا عهد","https://www.aldiwan.net/poem63506.html","الطويل"],[47,"سطوات هجرك قطعت أنفاسي","https://www.aldiwan.net/poem64616.html","الكامل"],[30,"أمير المؤمنين وأنت","https://www.aldiwan.net/poem5270.html","الوافر"],[63,"قضى بوقوف الركب حق المواقف","https://www.aldiwan.net/poem51551.html","الطويل"],[46,"أأطلال هند ساء ما اعتضت من هند","https://www.aldiwan.net/poem30544.html","الطويل"],[71,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[13,"أبعد قتيل العوص آسى على فتاً","https://www.aldiwan.net/poem2217.html","الطويل"],[13,"أَبَعْدَ قَتِيلِ الْعَوْصِ آسِي عَلَى فَتىً","https://www.poetsgate.com/ViewPoem.aspx?id=180772",""],[69,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""],[190,"أقول لمنكر فقري قنوعا","https://www.aldiwan.net/poem43650.html","الوافر"],[234,"سقياني فلست أصغي لعذل","https://www.aldiwan.net/poem50859.html","الخفيف"],[237,"سليمي وإن لم أقض منها مآربا","https://www.aldiwan.net/poem14739.html","الطويل"],[240,"أعيذك من لوعتي واشتياقي","https://www.aldiwan.net/poem31811.html","المتقارب"],[242,"يا بدورا لست عنها بصاح","https://www.aldiwan.net/poem18118.html","المديد"],[284,"أيحسن بعد ضنك حسن ظني","https://www.aldiwan.net/poem2631.html","الوافر"],[287,"أيا من ثغره نور الأقاحي","https://www.aldiwan.net/poem32827.html","الوافر"],[369,"أثرها فقد طال الغداة وقوعها","https://www.aldiwan.net/poem60849.html","الطويل"],[371,"وأرضيت فيك الحب والحب جائر","https://www.aldiwan.net/poem17170.html","الطويل"],[408,"أأطيع العذول في السلوان","https://www.aldiwan.net/poem46429.html","الخفيف"],[591,"أأطلب يا محمد أن يؤولا","https://www.aldiwan.net/poem17660.html","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87189","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87140","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64369","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63770","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120025","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65004","البسيط"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137846",""],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122053","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128001","الوافر"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87843","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200641","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200166","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204632","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202398","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107070","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89342","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48354","الطويل"],[3687,"","https://poetry.dctabudhabi.ae/diwan/poem/200314","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205917","المتدارك"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131087",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111392","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83406","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204369","الكامل"],[4755,"غَفوةٌ على سَرير البَرزَخ","https://www.poetsgate.com/ViewPoem.aspx?id=215432",""],[4818,"طمع","https://www.poetsgate.com/ViewPoem.aspx?id=203510",""],[5183,"فخري","https://www.poetsgate.com/ViewPoem.aspx?id=186477",""],[5431,"أيا خير من صافى وياخير من عفّا","https://www.poetsgate.com/ViewPoem.aspx?id=191456",""],[5953,"أيصحو فؤادي والفراق عظيم","https://www.poetsgate.com/ViewPoem.aspx?id=93865",""]],"verses":[["أَأَطمَعُ أَن أَنساكَ يَوماً وَإِنَّما","هَواكَ ضَجيعُ القَلبِ مِنّي وَحُلمُهُ",0,"م",2,0],["أَأَطمَعَكُم أَنَّ الحُسامَ قَضى المُنى","وَلَم يَبقَ عِندَ الدَهرِ ثَأراً فَأَغمَدا",1,"د",2,0],["أَأَطلالُ دارٍ مِن سُعادَ بِيَلبَنِ","وَقَفتُ بِها وَحشاً كَأَن لَم تُدَمَّنِ",2,"ن",1,1],["أَأَطلالَ دارٍ بالنِياعِ فَحُمَّتِ","سَأَلتُ فَلَمّا اِستَعجَمَت ثُمَّ صُمتِ",3,"ت",1,1],["أأطيش ما كانت سهامي عنكما","تصدان عني إنّ ذا لعجيب",4,"ب",1,0],["أَأَطلُبُ رِزقَ اللَهِ مِن عِندِ غَيرِهِ","وَأَستَرزِقُ الأَقوامَ وَاللَهُ رازِقُ",5,"ق",1,0],["أَأَطرَحُ المَجدَ عَن كِتفي وَأَطلُبُهُ","وَأَترُكُ الغَيثَ في غِمدي وَأَنتَجِعُ",6,"ع",1,0],["أأطمعُ منكم بالوفاءِ وقبلكم","علمتُ بأنّ الغدرَ ضربةُ لازمِ",7,"م",1,0],["أَأُطيعُ فيكِ العاذِلاتِ وَكِسوَتي","وَرَقُ الشَبابِ وَشِرَّتي لَم تَذهَبِ",8,"ب",1,0],["أَأَطلُبُ أَنصاراً عَلى الدَهرِ بَعدَما","ثَوى مِنهُما في التُربِ أَوسى وَخَزرَجي",9,"ج",2,0],["أَأَطلالَ دارِ العامِرِيَّةِ بِاللِوى","سَقَت رَبعَكِ الأَنواءُ ما فَعَلَت هِندُ",10,"د",1,0],["أَأُطيقُ هَجرَكِ وَهوَ لَو حَمَّلتُهُ","رُكنَ الزَمانِ لَما سَرى في الناسِ",11,"س",1,0],["أَأَطعَمتَ العِراقَ وَرافِدَيهِ","فَزارِيّاً أَحَذَّ يَدِ القَميصِ",12,"ص",1,0],["أَأَطلُبُ إسعافَ الزَّمانِ وقد ثَنى","إلى العاجزِ المأفونِ عَطْفَ مُساعفِ",13,"ف",1,0],["أَأَطلالَ هِندٍ ساءَ ما اِعتَضتِ مِن هِندِ","أَقايَضتِ حورَ العينِ بِالعونِ وَالرُبدِ",14,"د",1,1],["أأطيلُ في أرضٍ مقامي لاهياً","وقرارُ داري غيرُ دارِ قراري",15,"ر",2,0],["أَأَطرُدُ نَهباً آخِرَ اللَيلِ أَبتَغي","عُلالَةَ يَومٍ أَن تَعوقَ العَوائِقُ",16,"ق",1,0],["أَأَطْرِدُ نَهْبَاً آخِرَ الَّليْلِ أَبْتَغِي","عُلاَلَةَ يَوْمٍ أَوْ تَعُوق الْعَوَائِقُ",17,"ق",1,0],["أَأَطْلُبُ مِنْ قَوْمٍ سِواكُمْ مُساعِداً","وقد صَدَّهم حِرْمانُهُم أنْ يُساعِدُوا",18,"د",3,0],["أأطلبُ الغنى عن غير حظّ","وهل أغنى بلا ربح سراع",19,"ع",1,0],["أَأُطيع العذولَ في ضِدّ ما أَهْ","وَى كأنّي أتَّهمتُ رأي وعَقْلي",20,"ل",2,0],["أَأَطلُبُ مِن سَلمى بَديلاً وَاِبتَغى","سُلُوّاً أَلا لانِلتُ قَصدي طالِبا",21,"ب",2,0],["أَأَطلُبُ وِرداً بِأَرضِ الشَآمِ","وَدونيَ بَحرٌ بِأَرضِ العِراقِ",22,"ق",1,0],["أَأُطِيعُ عاذِلاً فِي هَوَى","مَنْ أَنَا مِنْ حُبِّهِمْ غَيْرُ صَاحْ",23,"ح",1,0],["أَأَطْمَعُ أَن أَكون شهيدَ حُبٍّ","فأَصْحبَ منك حُوريّاً بعَدْن",24,"ن",1,0],["أَأَطمَعُ في الخَيالِ وَطِرفُ طَرفي","يَبيتُ عَلى الكَرى جَمَّ الجِماحِ",25,"ح",1,0],["أَأطلُبُ إبدالَ الكرامِ وقد مضَوْا","على حينَ أضحَتْ مُقْفِراتٍ رُبوعها",26,"ع",3,0],["أَأَطَمَعُ أَن يَجري عَلى السُّحبِ ساحِبٌ","وَآمُلُ أَن يَأتي عَلى البَحرِ سابِحُ",27,"ح",1,0],["أأطيعُ العذولَ في السّلوانِ","لا ومَنْ قَد أضلَّهُ وهدَاني",28,"ن",2,1],["أَأَطْلُبُ يا مُحَمَّدُ أَنْ يَؤُولا","لِغَيرِكَ وِدُّ قَلْبي أو يَمِيلا",29,"ل",2,1],["أَأَطمَع في الدُنيا وَلَستِ مَعي بِها","وَأَنتَ لِعَيني نُورُها وَضِياها",30,"ا",3,0],["أَأَطمَع مِنكَ في وَعد بوصلٍ","وَدينُك مطلُ صبٍّ غَير جاني",31,"ن",2,0],["أأطلال سعدى باللوى تتعهدُ","اتبكي على الأيام أم تتجلدُ",32,"د",1,0],["أَأُطيلُ في وَصْفِ الهوى أَمْ أُقْصِرُ","وأُذيعُ مكتومَ الأسى أم أَسْتُرُ",33,"ر",1,1],["أأطلالِ الحمى حيتك عنّا","مع الأسحار أنداء الظلالِ",34,"ل",1,0],["أَأَطْلُبُ المالَ والبنينا","مِنْ بَعْدِ إِحْدَى وأَرْبعيناً",35,"ن",2,1],["أأطمع منها بالوصال ولم اكن","سمت بخود في الورى رحمت صبا",36,"ب",2,0],["أَأَطْلُبُ مِنْ لَيْلِي الصَّبَاحَ وَدُونَهُ","لَيَالِي هُمُومٍ لاَ يُتَاحُ زَوَالُهَا",37,"ل",3,0],["أأطمع في خلاصى وهو صعب","من المقل التى منعت منامى",38,"م",2,0],["أَأُطعِمُهُ قَلبي وَيُهلِكُني الطَوى","وَأُنهِلُهُ دَمعي وَيَقتُلُني الظَما",39,"م",2,0],["أأطفالُ المدارك لا السنينا","وآحادٌ وإن كنتم مئينا",40,"ن",2,1],["أإطلاق السجين يُعدُّ خيراً","ويُنسى شر إمساك السجين",41,"ن",1,0],["أأطيع وعظك ان وعظت ولم أجد","من مبصر لأخي العماية تابع",42,"ع",1,0],["أأطردها ضيفا خفيف مؤونةٍ","صغيرة حجم لا تكلفني مأوى",43,"ا",1,0],["أأطريك يا بغداد بالمدح والثنا","وحسنك يا بغداد للمدح يطريه",44,"ي",2,0],["أأطلب في الوجوه سواه وجهاً","وأترك منظر الوجه الوسيم",45,"م",1,0],["أأطْمَعُ يوماً في جَنى ورْدِ خدّهِ","ومن فوقِه حُورُ العُيونِ حوارِسُ",46,"س",1,0],["أأطمَعُ أن أسْلو عنِ الحُبِّ ساعةً","وبيْنَ ضلوعي من هَواهُ وساوِسُ",46,"س",1,0],["أأطمعك العديد ففي رحالي ال","كفاية والنكاية والعديد",47,"د",1,0],["أأطلب حرية للعبيد","وألقي بحريتي عن رَغَم",48,"م",1,0],["أأطربه نظم يضارع لؤلوءا","نضيدا ونثر مثل ما ينثر الورد",49,"د",1,0],["أأطرق خدر العامرية والشقا","رفيقي ومالي من مجاراته بد",49,"د",1,0],["أَأَطمَعَ كُلِّ مَخلُوقٍ أَتَرجُو","مُكَافأَةَ الأَراغَسةِ العظَامِ",50,"م",1,0],["أَأَطمَعُ بِالوَصلِ الَّذي قَد حُرمتُهُ","زَماناً وَلم يَخطر سِواكَ بِخاطِري",51,"ر",2,0],["أأطلب منك الرفد عمرى كله","وأطلبه والجنب منى معفر؟",52,"ر",1,0],["أَأَطِيرُ مِن هذي القِيامَةِ، قاصِدًا","تِلكَ القِيَامَةَ؟! إِنَّهُ لَوُقُوعُ",53,"ع",1,0],["أأطمعُ أن تكونَ بقدرِ ظنّي","وتبعدَ هاجسَ الخُسرانِ عنّي؟!",54,"ن",2,1],["أأطلب للاكتناز الغنى","وأصبح عبداً لديناريه ؟",55,"ي",2,0],["أأطمع في ملك الإله وخيره","وكلّيَ أخطاءٌ لُففتُ بها لفّا",56,"ف",2,0],["أأطلب في قعر الجحيم نعائماً","ومن أين في قعر الجحيم نعيم",57,"م",1,0]]}