oWhat=shqas&qid=87684&r=&rc=18",""],[6318,"الفجر الدامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66161&r=&rc=11",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""],[6318,"الهند .. تقاوم الاحتلال البريطاني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65940&r=&rc=0",""],[6318,"السهم الأخير وفتىًُ يفَجَّر نفسَهَّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66168&r=&rc=18",""]],"verses":[["المَجدُ أَنوَطُ مِن كَفٍّ إِلى عَضُدٍ","فيهِم وَأَقوَمُ مِن رَأسٍ عَلى بَدَنِ",0,"ن",1,0],["المَجدُ يَعلَمُ أَنَّ المَجدَ مِن أَرَبي","وَلَو تَمادَيتُ في غيٍّ وَفي لَعِبِ",1,"ب",1,1],["المَجدُ يَعلَمُ أَيُّنا خَيرٌ أَباً","فَاسأَلْهُ تَعلَم أَيَّ ذي حَسَبٍ أَبي",2,"ب",2,0],["المَجدُ عُذرٌ في الفِراقِ لِمَن نَأى","لِيَرى المَصانِعَ مِنهُ كَيفَ تُشادُ",3,"د",1,0],["المَجدُ حُلَّتُهُ وَالجودُ عِلَّتُهُ","وَالصِدقُ حَوزَتُهُ إِن قِرنُهُ هابا",4,"ب",2,0],["أَلمَجْدُ لِلآثَارِ خَيْرٌ حَافِظاً","فِي كُلِّ عَصْرٍ مِنْهُ لِلأعْيَانِ",5,"ن",1,0],["أَلمَجْدُ رَاضٍ عَنْكَ وَالْبَلَدُ الَّذِي","أَشْكَيْنَ مِنْ سُقْمٍ وَفِيكَ سَقَامُ",6,"م",1,0],["المجتبى وزناد النور ما قُدحتْ","ولا ذكا من نسيم الروض مراهُ",7,"ا",2,0],["المَجدُ بِالرَقَّةِ مَجموعُ","وَالفَضلُ مَرئِيٌّ وَمَسموعُ",8,"ع",1,1],["المُجتبو الحمدَ بعد الأجرِ غايتُهم","صَوْنُ الإمام عن الآثام والسُّبَبِ",9,"ب",1,0],["المَجدُ مَطلَبُكُم وَأَنتُم سُهَّدٌ","وَالمَجدُ حِلمَكُمُ وَأَنتُم نُوَّمُ",10,"م",1,0],["المَجدُ إِدراكُ النَفيسِ وَعِندَهُم","ما المَجدُ إِلّا شادِنٌ أَو شادِيَه",11,"ي",2,0],["المجمعون على التوحيد ما عبدوا","من المقابر دون اللَه أوثانا",12,"ن",2,1],["المَجدُ وَالشَرَفُ الرَفيعُ صَحيفَةٌ","جُعِلَت لَها الأَخلاقُ كَالعُنوانِ",13,"ن",1,0],["المَجلِسانِ عَلى التَميِيزِ بَينَهُما","مُقابِلانِ وَلَكِن أَحسَنا الأَدَبا",14,"ب",2,1],["المَجدُ أَخسَرُ وَالمَكارِمُ صَفقَةً","مِن أَن يَعيشَ لَها الكَريمُ الأَروَعُ",15,"ع",1,0],["المَجدُ عوفِيَ إِذ عوفِيتَ وَالكَرَمُ","وَزالَ عَنكَ إِلى أَعدائِكَ الأَلَمُ",16,"م",1,1],["المجدُ ما سَلِمَتْ خِلالُكَ سالِمٌ","والجُودُ ما بَقِيَتْ يَمينُكَ بَاقي",17,"ق",2,0],["المَجدُ في غَيرِهِم لَولا مَآثِرُهُ","وَصَبرُهُ نَفسَهُ وَالحَربُ تَستَعِرُ",18,"ر",1,0],["المَجدُ أَعنَقُ وَالدِيارُ فَسيحَةٌ","وَالعِزُّ أَقعَسُ وَالعَديدُ عَرَمرَمُ",19,"م",1,0],["المجرمُ الوَرعُ الذي يَدَعُ الحمى","حَذَر الجريمةِ والأثيمُ التّائبُ",20,"ب",1,0],["المجدُ والخطرُ العظيمُ لأُمَّةٍ","وَعَتِ الأُمورَ فَعظَّمتْ أحرارَها",21,"ر",3,0],["المجدُ للبطلِ المصونِ لِواؤُه","عن أن يُعَلِّ من الدّماءِ ويُنهَلا",22,"ل",2,0],["المجدُ إقدامٌ ونهضةُ ثائرٍ","ما المجدُ مسكنةٌ وطولُ قرارِ",23,"ر",1,0],["المَجدُ أَجمَعُ وَالجَلالُ لِأُمَّةٍ","صَدَقَت عَزيمَتُها وَعَزَّ الشانُ",24,"ن",1,0],["المجدُ والشرفُ الرفيعُ وما ترى","من نعمةٍ خضراءَ دانيةِ الجَنى",25,"ن",2,0],["المجد عوفي إذا عوفيت والكرم","وزال عنك إلى أعدائك الألم",26,"م",1,1],["المجاديفُ بأيديهمْ هتافٌ ونشيدُ","ومُصَلُّونَ لهم في النهرِ محرابٌ عتيدُ",27,"د",1,0],["أَلمَجْدُ رَهْنُ إِشَارَةٍ بِيَمِينِهِ","وَالنَّصْرُ بَيْنَ يَدَيْهِ كَالْمُنْقَادِ",28,"د",1,0],["المَجْدُ في الدُّنْيا سِجِلٌّ خَالِدٌ","تَتَعاقَبُ الأَجْيالُ مِنْ قُرَّائه",29,"ا",3,0],["الْمَجدُ أَنْ تَتَوثَّبِي","وَإِذَأ وَثَبْتِ فَلاَ تَحِيدِي",30,"د",2,0],["المجدُ لا يُلْقي العِنا","نَ لغيرِ ذي العزم المثابرْ",31,"ر",1,0],["الْمَجْدُ فَوْقَ مُتُونِ الضُّمَّرِ الْقُودِ","تَطْوِي الْفَلاَ بَيْنَ إِيجَافٍ وتَوْخِيدِ",32,"د",1,1],["الْمَجْدُ بالسيْفِ إِنْ عَزَّتْ وَسَائِلُهُ","لاَ يُغْمِدُ الْحَقَّ سَيْفٌ غَيْرُ مَغْمُودِ",32,"د",1,0],["المجدُ بابٌ إن تعاصَى فتحُه","فاسألْ كتائبهم عن المفتاح",33,"ح",1,0],["المجدُ فوقكُمُ دنتْ أفنانُه","فتلقّفوا ثمراتِه بالرّاح",33,"ح",1,0],["اَلْمَجْدُ أَبْقَى لَهُمْ ذِكْرَى مُخَلَّدَةً","أَعْمارُهُمْ وُصِلَتْ مِنْها بِأَعْمَارِ",34,"ر",1,0],["الْمَجْدُ وَهْوَ مُنَى الْحَيَا","ةِ أعِدَّ لِلْبَطَلِ الْمُجِدِّ",35,"د",1,0],["المجد إذ تُهدى لكم ألقابُه","كالدر إذ يهدي إلى النقاد",36,"د",1,0],["المجد لا يبنيه با","نيه بطين أو بماء",37,"ا",2,0],["المجد: إما سطوةٌ، أو غنىً","ما العاجز المعدم بالماجد",38,"د",1,0],["المجدُ ينبُتُ في الصحاري والعلا","بدلَ المروج الخُضْر والأشجار",39,"ر",1,0],["المجد ليس لفاتكٍ ولو أنه","بذَّ النُّسورَ مخالبًا ونيوبا",40,"ب",2,0],["المجاراة لا التّحدي، لماذا؟","كيف أقوى إن لم أُغالبْ مُعيقي؟",41,"ق",2,0],["المجد للشعب والحكم المطاع له","والفعل والقول وهو القائل اللّسن .",42,"ن",1,0],["المجلِسُ المفجوعُ رُوِّع أهلُهُ","وبكتْكَ أروقةٌ له وقِباب",43,"ب",1,0],["المجد ما روجت فيه بضائعاً","للمكرُمات فما عُكاظُ وسوقه",44,"ق",2,0],["المجتني الحمدَ بعد الأجرِ غايتُهم","صَوْنُ الإمام عن الآثام والسُّبَبِ",45,"ب",1,0],["المجد والوجد بقاماتها","عن غاية اللطف لقد أعربا",46,"ب",2,0],["المجيرَ الجاني إذا جاءَ عذْرا","والسخيَّ المعظَّم المصمودَا",47,"د",2,0],["المَجدُ طَعنٌ في النُحورِ يَمُدُّهُ","ضَربٌ يُقامُ لِوَقعِهِ صَعرُ العِدا",48,"د",2,0],["المَجدُ أَعتَقُ وَالآدابُ بارِعَةٌ","وَذِروَةُ المَجدِ مُصطافي وَمُرتَبَعي",49,"ع",2,0],["المَجدُ أَمسى دَفيناً بِالعذارِ فَقُم","كَيما تُقيمَ لَهُ نَوحاً وَإِرنانا",50,"ن",2,0],["المجدُ بينَ موروثٍ ومكتسبِ","والقطرُ في الأرضِ لا كالقطر في السحُبِ",51,"ب",1,1],["المجد بسّامٌ إلى ماجدٍ","أروعَ بسّامٍ إلى المجد",52,"د",1,0],["المَجدُ جِسمٌ وَهوَ روحٌ لَهُ","وَصورَةٌ وَهوَ لَها نَفسُ",53,"س",1,0],["المجدُ عندَ الأكرمينَ أخو الهوى","من لم يحبَّ قضى حَزيناً خائبا",54,"ب",2,0],["المَجدُ مِن شَكواكَ شاكٍ بَثَّهُ","وَاللَهُ شافٍ مُبدِئاً وَمُعيدا",55,"د",2,0],["المجتبي المنتقي من هاشم","بحر الندى والفضل والإيثار",56,"ر",1,0],["المجد منك فعش له رغم","التعاسةِ والكروب",57,"ب",1,0],["المَجد كبَّر بِالسُرور وَهَلَّلا","لِبُزوغ شَمس العزّ مِن فلك العُلى",58,"ل",2,1],["المجدُ قلبٌ للزّما","نِ وقد حَواهُ منه صَدر",59,"ر",1,0],["المَجدُ أَجمَعُ ما حَوَتهُ يَميني","وَالفَخرُ يَصغُرُ أَن يَكون خَديني",60,"ن",2,1],["المَجد شرب لَم يَزَل ماؤُهُ","مُرَقرِقاً فَوقَ صفاح الصفاح",61,"ح",1,0],["المُجمَلُ المنعِمُ إن حبّرَتْ","مدائِحُ في المُجمَلِ المنعّمِ",62,"م",1,0],["المجد في شهر زور طاب موردهُ","وما سواه فزور غير مورود",63,"د",1,0],["المجدُ ممنوعٌ بسيفِكَ عِزُّهُ","والأَرضُ معمورٌ بِمُلْكِكَ دارُها",64,"ر",3,0],["المجد في جَدثٍ ثوى أم كوكبُ ال","دنيا هوى أم ركن ضبَّةَ مائلُ",65,"ل",1,0],["المجدُ ألق