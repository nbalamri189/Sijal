ه","https://www.poetsgate.com/ViewPoem.aspx?id=33840",""],[5550,"وردةٌ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=213309",""],[5573,"ساقه الله فوق ساقه والقدم","https://www.poetsgate.com/ViewPoem.aspx?id=200221",""],[5606,"العام الأول قلت باروح للصيد","https://www.poetsgate.com/ViewPoem.aspx?id=197740",""],[5612,"في ساحةِ الوَجْد","https://www.poetsgate.com/ViewPoem.aspx?id=179431",""],[5629,"جت سلامات","https://www.poetsgate.com/ViewPoem.aspx?id=184604",""],[5648,"وش فيك ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=154660",""],[5664,"خلف سيار","https://www.poetsgate.com/ViewPoem.aspx?id=176684",""],[5732,"الله كفيل الناس وارضه وسيعه","https://www.poetsgate.com/ViewPoem.aspx?id=177863",""],[5830,"يا ظبية تختال ما بين الربى","https://www.poetsgate.com/ViewPoem.aspx?id=200690",""],[5845,"دمي طللٌ بينَ الطلولِ بحاجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=16706",""],[5848,"رصاصة الرحمه","https://www.poetsgate.com/ViewPoem.aspx?id=53103",""],[5848,"طعنتينك","https://www.poetsgate.com/ViewPoem.aspx?id=49222",""],[5861,"غازل الروح","https://www.poetsgate.com/ViewPoem.aspx?id=188261",""],[5910,"حيِّ الطلولَ ونبِّ عن أخبارِها","https://www.poetsgate.com/ViewPoem.aspx?id=206239",""],[5956,"مارستُ حُبك بالقصائد","https://www.poetsgate.com/ViewPoem.aspx?id=182610",""],[6008,"احترتُ بالحاير","https://www.poetsgate.com/ViewPoem.aspx?id=59158",""],[6008,"ياحيف والله","https://www.poetsgate.com/ViewPoem.aspx?id=60801",""],[6045,"وثبة قلب طروب","https://www.poetsgate.com/ViewPoem.aspx?id=181560",""],[1362,"حتام نلهو والنفوس رهينة","https://www.poetsgate.com/ViewPoem.aspx?id=127723",""],[6084,"زارني ليلا وقد نام الرقيب","https://www.poetsgate.com/ViewPoem.aspx?id=170819",""],[6102,"مَيس ..","https://www.poetsgate.com/ViewPoem.aspx?id=185073",""],[6102,"عَلَى الدُّنيا السَّلام","https://www.poetsgate.com/ViewPoem.aspx?id=186281",""],[520,"ليست صفات علاك مما يمترى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577514",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[5957,"يا ملاكاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82581&r=&rc=123",""],[6237,"إفاقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77866&r=&rc=8",""],[572,"يَقِظٌ يَلمَحُ الخطوبَ بتدبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9215&r=&rc=72",""]],"verses":[["وَشِفاهُ الغَمامِ تَج","لو ثُغورَ البَوارِقِ",0,"ق",1,0],["وَشَفَيتَ مُمتَرِضَ الهُدى مِن مَعشَرٍ","سَدّوا مِنَ الآراءِ غَيرَ سَديدِ",1,"د",1,0],["وَشِفائي مِنهُ نَسيمٌ يُغادي","ني وَطَرفٌ يَرنو إليَّ كَليلا",2,"ل",2,0],["وَشَفَى مَنْ يَشْتَكِي","الغُلَّةَ فِي زُرْقِ الْحِيَاضِ",3,"ض",1,0],["وَشِفَاءٍ لصُدُورٍ","مِنْ ضَنَى الْجَهْلِ مِرَاض",3,"ض",1,0],["وَشَفَينا النَفسَ مِن كُلِّ رَشاً","نَطَقَت عَيناهُ بِالسِحرِ المُبين",4,"ن",1,0],["وَشَفى المَوتُ غِلَّهُ مِن نُفوسٍ","لا تُباليهِ في مَجالِ الطِعانِ",5,"ن",1,0],["وَشَفوفُ حَظٍّ لَيسَ يَفتَأُ يُجتَلى","غَضَّ الشَبابِ وَكُلُّ حَظٍّ يَهرَمُ",6,"م",1,0],["وَشَفَّفنَ عَن أَجيادِ غِزلانِ رَملَةٍ","فَلاةٍ فَكُنَّ القَتلَ أَو شَبَهَ القَتلِ",7,"ل",1,0],["وشفّعها بالصافنات كأنها","وقد راق مرآها جآذرُ مَكْنِسِ",8,"س",1,0],["وشفاهم بهَديهِ من ضلال","كل فرد منهم به مَعلول",9,"ل",1,0],["وشفوفُ البدن النا","عم في الثوب الرقيقِ",10,"ق",1,1],["وشفيعي إليك حاملُ شعرِي","وهْو من لا تراهُ للرد أهلا",11,"ل",2,0],["وَشَفَيتُ نَفسي مِن لَواعِجَها","وَثَأَرتُ بَِلتَصريحِ مِن سِرّي",12,"ر",2,0],["وشفَّ الدُّجى عن جمالٍ عميقٍ","يُشِبُّ الخيالَ ويُذكي الفِكَرْ",13,"ر",1,0],["وَشَفَّت وَما شَفَّ مِنّي الضَميرُ","وَأَينَ الجَمادُ مِنَ العاقِلِ",14,"ل",1,0],["وَشَفاءُ هَذي الروحِ مِن آلامِها","وَدَواءُ هَذا الجِسمِ مِن أَوصابِهِ",15,"ب",2,0],["وشفَى من الداءِ العُضَالِ وقدْ","عجزَ الرُقَاةُ وأبلسَ الطِّبُ",16,"ب",1,0],["وَشَفَعتُ في الأَمرِ الجَليلِ إِلَيهِمِ","بَعدَ الجَليلِ فَأَنجَحوا طَلَباتي",17,"ت",2,0],["وَشِفاءُ ما تَجِدُ الضُلوعُ مِنَ الجَوى","سَيرٌ يَشُقُّ عَلى الهَدانِ وَجيفُهُ",18,"ف",2,0],["وشفيت وهمي من رضا","كِ وربَّ ذي يأسٍ وهم",19,"م",1,0],["وشفاكَ الإلهُ من كلّ داءٍ","صحّ منه الجلالُ بعد السقامِ",20,"م",1,0],["وَشَفَيتَ وَجدَ شَهيدِها وَحَبَوتَهُ","فيها بِدارِ إِقامَةٍ وَقَرارِ",21,"ر",1,0],["وشَفَاهَا بذِي الحُلَيْفَةِ نَفْساً","أوشكَتْ أن تزولَ هَمّاً وغَمّا",22,"م",2,0],["وشَفَتْهُ مِنكَ بضربةٍ ما أقلعتْ","حتَّى رمتكَ بِعلَّةٍ ما تُقلِعُ",23,"ع",1,0],["وَشَفَّ عَنِ النورِ الظَلامُ كَأَنَّهُ","حِدادٌ عَلى بيضِ الصُدورِ يُمَزَّقُ",24,"ق",1,0],["وَشِفاءُ القَلبِ مِنها","إِذ تَواعَدنا الكَثِيبا",25,"ب",2,0],["وشفَى جميعَ المُؤْلِمَاتِ بِريقِه","يا طِيبَ ما يَرْقي به ويُطَيِّبُ",26,"ب",1,0],["وَشَفَى أَيُّوبَ مِنْ ضُرٍّ كما","سَرَّ يَعْقُوبَ وَقد كانَ حَزِينا",27,"ن",2,0],["وشَفَعْتَ في وَفْدِ الحجيجِ كأنّما","نَفّلْتَهُمْ إخلاصَكَ المقُبولا",28,"ل",2,0],["وَشِفاءُ العَيِّ السُؤالُ فَقوما","سائِلا وَالبيانُ عِندَ الخَبيرِ",29,"ر",1,0],["وَشَفَّ بَقاءٌ صِرتُ مِن سوءِ فِعلِهِ","أَهَشُّ إِلى المَوتِ الزُؤامِ وَأَطرَبُ",30,"ب",1,0],["وشَفْرَتُه حَذامِ فلا ارْتِيابٌ","بأنّ القَوْلَ ما قالتْ حَذامِ",31,"م",1,0],["وشَفيعٍ مُنجحِ يَنظُرُنا","بِيَديهِ اليَومَ تَيسِيرُ العُسُر",32,"ر",1,0],["وَشَفَيْتَ قَبْلَ الجِسْمِ عِلَّةَ رُوحِهِ","بِاللَّفْظِ عَذْباً وَالعِلاَجِ رَفِيقَا",33,"ق",2,0],["وشفتها بسمات من مناهلهِ","عذراءَ يرشحُ منها الطهرُ والخجَلُ",34,"ل",1,0],["وشفى الزمانُ جِراحَها ولطالما","ضاق الزمانُ وطِبّهُ بجراحها",35,"ح",3,0],["وشَفَتَا «جنيفَ» في ابتسام","إنْ رضيََ القاضي عن الإجرام",36,"م",1,0],["وَشَفقت حَتّى كادَ سَيفَك راحِماً","يَبكيهم وَيَذُم فعل الفاتك",37,"ك",1,0],["وشفائي لو دروا يا منيتي","ريقك العذب ولكن أين إين",38,"ن",1,0],["وشفَّهُمُ الصَّدَى حتى تَوَانَوا","وصَدُّوا عَن عزَائِمِهم صُدودَأ",39,"د",2,0],["وشفى النفوس من العدا في مأزق","يقتات أرواح الكماة تآكلا",40,"ل",2,0],["وشفعك الإله وأنت أهل","لذلك في بنى حام وسام",41,"م",1,0],["وَشِفَائِي فِي شَمُولِ","عُصِرَت فِي عَهدِ شِيثِ",42,"ث",1,0],["وَشَفت ثَنايا الثَّغر أفواه الصَّبا","أُصُلا وَبرَّدها الندى برضابه",43,"ب",2,0],["وشفيع الحبيب عندي شفيعٌ","وشفيعي إليه شرّ شفيعِ",44,"ع",1,0],["وَشفَى منَ الضلّال وال","جهّالِ أَمواتاً ومرضى",45,"ض",2,0],["وَشَفتَرُوا في دِينِهِم ومَرَقُوا","فَصَبَّحَتهُم ذاتَ رِزٍّ فَيلَقُ",46,"ق",1,0],["وَشَفشَفَ حَرُّ القَيظِ كُلَّ بَقِيَّةٍ","مِنَ النَبتِ إِلّا سَيكَراناً وَحُلَّبا",47,"ب",2,0],["وشفينا إذ سكرنا الغللا","وتغنّت بهوانا كيف لا",48,"ل",2,0],["وشفاهكِ الحمراءُ والخم","رُ الذي لم احتسِ",49,"س",1,0],["وشفاها بنسمةٍ","كان طبا هبوبُها",50,"ب",3,0],["وشفاه من تلك الثنايا قبلة","ايحل في شرع الهوى ام يحرم",51,"م",1,0],["وشفاء الفؤاد رشف شفاه","قوت روحي ياقوتها المرجاني",52,"ن",2,0],["وَشُفيت غَلواءُ من أَوهامِها","لكِنَّها لَم تُشفَ من آلامِها",53,"ه",2,0],["وَشُفِيَت غَلواءُ من آلامِها","لكِنَّها لَم تَشفَ من أَوهامِها",54,"ه",2,1],["وَشفاهٌ يَقُلنَ أهلاً وَلو أَدَّ","ينَ ما في الحشا لما قُلنَ خيرا",55,"ر",2,0],["وشفَوا بِسِبْطيهِ الحقُو","دَ وحارَبوا ظُلمْاً وصِيَّه",56,"ي",2,0],["وشفى نوالي النَاس من عَدَمٍ","وَشفَى مَقالي الصُّمَّ مِن صَمَمِ",57,"م",1,0],["وَشِفائي في نَشوَةٍ تَذَرُ الأَح","زانَ عَنّي مِن سِلسَبيلٍ رَحيقِ",58,"ق",1,0],["وَشَفَت غَليلاً نَقعُهُ","بَينَ الغَلائِلِ وَالشُفوفِ",59,"ف",1,0],["وَشَفِيعِي إِلَيْكَ مَنْ أَنْتَ يَارَ","بِّ شَفِيعِي إِلَى تَرَشُّفَ مَثِّهُ",60,"ث",2,0],["وَشَفِيعِي أَنْ كَانَ لاَ بُدَّ لِي مِنْ","شُفَعَاءَ إِلَى جَنَاهُ الآسِ",61,"س",1,0],["وشفيعا غيركم","يا آل طه والبتول",62,"ل",1,0],["وشَفَتاها وردةٌ نوَّرَت","وثغرُها سمطٌ من الجَوهَر",63,"ر",1,0],["وَشفعه الاله بكل عاص","وكل مقصر يَخشى الجَزاء",64,"ا",2,0],["وَشفعه في المذنبين مدائحا","خَصائص أخرى لا تعد لحاصر",65,"ر",1,0],["وَشَفَّعَ نَجْلَهُ الأزكَى إمَامٌ","لِمَنْ صُرِمَتْ وسائِلُهُ وَصُولُ",66,"ل",1,0],["وَشَفَتْ مَا شَفَّني فَإذَا","صَعْبُ تَسْهِيدي لِتَسْهِيلِي",67,"ل",2,0],["وَشَفاكَ الإِلهُ مِنْ كُلِّ داءٍ","وَوَقاكَ الْمَخُوفَ مِنْ كُلِّ طارِي",68,"ر",2,0],["وشفعت للضعفاء في البلواء","لا ترجو الثواب",69,"ب",1,0],["وشفَت فؤاداً لم يَزَلِ","من حَرِّ شَوقِكَ في سَعيرِ",70,"ر",1,0],["وَشَفى قَرحاً بأسنى هِمَّةٍ","من عُلاهُ حين مَسَّ القومَ قَرحُ",71,"ح",1,0],["وشَفاهُ مِمّا شكاهُ فأَمْسَوا","وهمُ دون ما أَرادوا هُمود",72,"د",1,0],["وَشَفَيتُ بِهِ غَليلَ","فُؤادٍ أُمَنّيهِ وَقَد بَلَغَ الظَما",73,"م",2,0],["وشَفيقاً عَلى العُلى وعَلى ما","مَلكَته يَداهُ غَيرُ شَفيقِ",74,"ق",1,0],["وَشَفتنيَ الأَسقام إِذ أَعوز اللقا","فَلَم تَبقَ لي إِلّا المَدامع وَالفِكرا",75,"ر",2,0],["وشفاعة في يوم بدر كل ما","كسب الفتى بدقيقه وجليله",76,"ل",2,0],["وشفيت الصدور منَّا فقلنا","صحّ جسم العُلى وكانَ عليلا",77,"ل",2,0],["وشفائي قُربُ من أسْقَمَني","بسقام الطرف والخصر النحيل",78,"ل",1,0],["وشَفَيْتُ سُمَّ عَقارِبٍ بأَساوِدٍ","ودَفَعْتُ سُمَّ أَساوِدٍ بعقارِبِ",79,"ب",1,0],["وشَفى سُيُوفَكَ من عِدَاكَ وَقَدْ سَطَا","هَمٌّ أَموتُ بِدَائِهِ فَشَفَيْتَنِي",80,"ن",2,0],["وشفَي أدواءَها من معشرٍ","قبلُ طَبُّوها فزادوها سَقاما",81,"م",2,0],["وشفعاً لأسلافٍ لديك شفيعها","مطاع وقاضيها له الحكم والأمرُ",82,"ر",1,0],["وشفَتْ سيوفُك من بني أعمامها","داءً تَضيقُ به الصدورُ وتَبرحُ",83,"ح",1,0],["وشفَعتْ نفسي لكم","فحال عتبي مدحا",84,"ح",2,0],["وشَفَّها الذَّميلُ وانْتضاها","فلا تَلوماها على شَقاها",85,"ا",3,0],["وشَفَعْتَ كُلَّ قَديمةٍ","بحديثِ مجدكَ من فِعالِك",86,"ك",1,0],["وشفى ضنايَ وما شكوتُ سقامهُ","وسقى ثنايَ ندى يديهِ فأخصبا",87,"ب",2,0],["وشفع بالافراج عنك مبرءا","فلن يستطيع ساس الأمور وطبقا",88,"ق",2,0],["وشفَيْتَ علّتَهُ بكُتبٍ قد غدَتْ","مثلَ الطّبائِعُ لاِعتدالِ مِزاجهِ",89,"ج",2,0],["وشفعتها من منطقي بمهند","تفري مضاربه الطلى مغمودا",90,"د",2,0],["وشفعتها بعزائم لولا التقى","أذكت على الآفاق جمراً مسعرا",91,"ر",2,0],["وشفعتها بمكارم جاءت ولم","يعبث بهز غصونها التذكار",92,"ر",1,0],["وَشَفَوا العليلا","وأَرْوَوا الْغَلِيلا",93,"ل",2,0],["وشَفَيْتُ نَفْسِي بَعْدَ طُولِ عَنائِها","في قَطْعِ حَزْنِ فَلاتِهِ وهِضابِهِ",94,"ب",2,0],["وشَفَّعَ وهَّابُ المُنى عيدَ عَرشِهِ","قَريباً بشعيدِ النّضصرِ واللهُ أَكرَمُ",95,"م",1,0],["وشفيتُ بالطّعنِ المبرِّحِ بالقنا","داءَ الحقودِ ووعْكَةَ الأضغانِ",96,"ن",1,0],["وشفاني في غير ما دافه الساقِي","وَراءَ المَشيبِ مِن أَوصابي",97,"ب",2,0],["وشَفَى من البَلوَى و