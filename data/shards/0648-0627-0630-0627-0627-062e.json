{"poems":[[65,"ومتيم زهرت بواقصة له","https://www.aldiwan.net/poem46148.html","الكامل"],[56,"وإذا آخيت من تقذى به","https://www.aldiwan.net/poem27525.html","الرمل"],[53,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[87,"ولد الهدى فالكائنات ضياء","https://www.aldiwan.net/poem20977.html","الكامل"],[87,"عادت أغاني العرس رجع نواح","https://www.aldiwan.net/poem21008.html","الكامل"],[30,"بين إذا نزلت عليك مجاشع","https://www.aldiwan.net/poem5311.html","الكامل"],[63,"حرق تمتري الدموع سجالا","https://www.aldiwan.net/poem51461.html","الخفيف"],[63,"جنح الملحي للسلم","https://www.aldiwan.net/poem51482.html","مجزوء الرمل"],[15,"أنبئت أن بني جديلة أوعبوا","https://www.aldiwan.net/poem45285.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85298","الكامل"],[146,"هل تعرف الحسناء تفخر","https://www.aldiwan.net/poem58354.html","مجزوء الكامل"],[190,"وإذا أخذت عفا القلوب","https://www.aldiwan.net/poem43513.html","مجزوء الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[266,"زد علا ما لحده من تناه","https://www.aldiwan.net/poem38145.html","الخفيف"],[385,"عظمت من الله المواهب","https://www.aldiwan.net/poem48755.html","مجزوء الكامل"],[401,"وإذا أخلائي تنكّت ودهم","https://www.aldiwan.net/poem592.html",""],[415,"ثلج النبات فراق لون مشيبه","https://www.aldiwan.net/poem31965.html","الكامل"],[415,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[422,"كف الملام فما يفيد ملامي","https://www.aldiwan.net/poem53993.html","الكامل"],[422,"لو كنت حاضر طرفه وفؤاده","https://www.aldiwan.net/poem54051.html","الكامل"],[463,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[463,"ما على منجد رأى ما أهمه","https://www.aldiwan.net/poem55903.html","الخفيف"],[520,"الشعر يعلم أن قدرك أكبر","https://www.aldiwan.net/poem12099.html","الكامل"],[556,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"],[556,"قل للذين إذا دعوا","https://www.aldiwan.net/poem48036.html","مجزوء الكامل"],[580,"تدعي العقل وهو أشرف ما فيك","https://www.aldiwan.net/poem2757.html","الخفيف"],[580,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122762","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122815","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122772","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48760","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63944","الخفيف"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123692","الرمل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17053","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109327","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93832","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205422","الخفيف"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136983",""],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58415","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201048","الخفيف"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70361","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67975","الكامل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123530","الكامل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202340","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103012","الخفيف"],[4984,"الْأَحْدَاثُ","https://www.poetsgate.com/ViewPoem.aspx?id=201165",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""]],"verses":[["وإذا اخْتَبَرْتُهُمُ ظَفِرْتُ بباطِنٍ","متجهِّمٍ وبِظاهِرٍ نَشّاشِ",0,"ش",1,0],["وَإِذا آخَيتَ مَن تَقذى بِهِ","فَاِطلُبِ الراحَةَ مِنهُ وَالدَعَه",1,"ه",1,1],["وإذا اختُبرتَ فللعُفاة تعوّدٌ","يدعو إليك وللعِداةِ تنكُّلُ",2,"ل",1,0],["وَإِذا أَخَذتَ العَهدَ أَو أَعطَيتَهُ","فَجَميعُ عَهدِكَ ذِمَّةٌ وَوَفاءُ",3,"ا",2,0],["وَإِذا أَخَذتَ المَجدَ مِن أُمِّيَّةٍ","لَم تُعطَ غَيرَ سَرابِهِ اللَمّاحِ",4,"ح",1,0],["وَإِذا أَخَذتَ بِقاصِعائِكَ لَم تَجِد","أَحَداً يُعينُكَ غَيرَ مَن يَتَقَصَّعُ",5,"ع",1,0],["وإذا اختالتِ السَّحابُ عليها","خِلتَه كِلَّةً لها وحِجالا",6,"ل",2,0],["وإذا اختالَ خلالَ الشْ","شَرْبِ عَذْراءٌ شَمولُ",7,"ل",1,0],["وَإِذا أَخوكَ تَرَكتَهُ وَأَخا اِمرِئٍ","أَودى أَخوكَ وَكُنتَ أَنتَ تَتَبَّبُ",8,"ب",1,0],["وإذا اِختَفى فكأَنّه","روح تلفّع بالظلال",9,"ل",1,0],["وإذا اختفت في خِدرها","جُلِدتْ لتَظهَر في الحقوقِ",10,"ق",1,0],["وإذا أخذت عفا القلو","ب وما تيسّر من زمانك",11,"ك",1,1],["وَإِذا أخلَّ بِذِكرِهِ في مَجلِسٍ","فَأولَئِكَ الأَمواتُ في الحيّانِ",12,"ن",1,0],["وإذا اخترتني نموت على النامي","وأزهو على افتخار الزاهي",13,"ي",1,0],["وَإِذا اِختِبار منقب","كَشف النِقاب عَن المَناقب",14,"ب",1,0],["وإذا أخلائي تنكّت ودهم","فأبو الكدادة ما له لي مضرعُ",15,"ع",1,1],["وإذا أخُو الشَّيبِ استَجاب للذَّةٍ","ومسرَّةٍ فسرورُهُ مسروقُ",16,"ق",1,0],["وإذا اُخطأَتْكَ الحادثاتُ فكلُّ ما","ألقَاهُ محمولٌ على الأَحدَاقِ",17,"ق",1,0],["وإذا أخَذْتُ الكأس قلت لصاحبي","العيش في دنياك كأس مدام",18,"م",1,0],["وإذا أخَذْتَ بما يبوحُ به الجوَى","أخذ الجوى إذ ذاك في إيقاده",19,"د",2,0],["وإذا اختصت وفودا منكُمُ","عمَّت العالَمَ إفضالا ومَنَّا",20,"ن",2,0],["وإذا أخدج النساءُ تمطَّتْ","عنهُ في المنجباتِ أمٌّ متِمَّهْ",21,"م",2,0],["وإذا اختصرت القول في تشبيهها","فكأنها الفلك المحيط مصور",22,"ر",1,0],["وَإِذا اِختبرت ففي الزّمان أكايسٌ","حازوا الكمالَ وفيه غيرُ أكايسِ",23,"س",1,0],["وَإِذا اِختصَرْتُ فإنّني","روّيت جهدي أو غَطَيْتُ",24,"ت",1,0],["وإِذا اختال فوق أَرْضِكَ مِنْك ال","عِطْفُ فاذكُرْ هَوَانَهُ تَحْتَ رَمْسِكْ",25,"ك",1,0],["وإِذا اختبرتَ فقد وجدت مؤَنثاً","وإِذا نَظرتَ فقد نَظَرت مُذكَّرَا",26,"ر",2,0],["وَإذا اختُبِرتَ فَأنتَ أُغزَرُ ديمَةً","وَأجَلُّ أُبَّهَةً وَأكرَمُ خيما",27,"م",2,0],["وَإذا اختَبَرتَ بَني زَمانِكَ فاختَبِر","أفعالَهُم فَجُسُومُهُم أشباهُ",28,"ا",2,0],["وَإذا اختَبَرتُ النّاسَ بَعدكُما وَجَد","تُ النّاس أَجمَعَ كالسَّوامِ السائِمِ",29,"م",1,0],["وإذا أخ رضى الوشاية في أخ","فهو الأحق بطعنة العذال",30,"ل",1,0],["وإذا أخلفَ السحابُ استعضنا","من نداهم أجلَّ ما مُستَعاض",31,"ض",1,0],["وإذا اخترت بعادي","فأنا أكره بعدك",32,"ك",1,0],["وَإِذا اِختَبَرتَ حَميدَهُم","أَلفَيتُهُ دونَ الذَميمِ",33,"م",1,0],["وإذا اختارت عليه نفسها","طلقت واحدةً لم تسترد",34,"د",1,0],["وإذا اختارت عليه نفسها","خرجت منه بشد وبهد",34,"د",1,0],["وإذا اختصرت بوصفها","عجزاً فان الحب ساتر",35,"ر",1,0],["وإذا اختاره العزيز ليقضي","في أمور عسيرة تتيسر",36,"ر",1,0],["وإذا أخطأتْ ظنون فيا رب","ب ظنونٍ تريح قلب العاني",37,"ن",2,0],["وإذا اخترت ان تظل ذليلا","يا سماء اهبطي ويا أرض ميدي",38,"د",2,0],["وإذا اختَرْتَ غيرَ ذي الصّبغِ فاسَمعْ","وَصفةً عن شَمَنْدخِ المزْارِ",39,"ر",1,0],["وإذا أخمد الوجودُ زفيري","فبقايا الزفير تمضي لقبري",40,"ر",2,0],["وإذا اخْتفتْ طُرقُ المَسير وظَلّ من","أشكالِها نَظرُ البصير محيرا",41,"ر",2,0],["وإِذا اختفى ضوءُ الصبا","حِ عَلَى الضَّريرِ هو السبب",42,"ب",1,0],["وإذا اخْتبرْتَ وَجَدْتَ مِحْ","نةَ مَن يُحِبُّ هِيَ الحِمامْ",43,"م",1,0],["واذا أخلف السماء بأرض","أخلفت راحتاه ذاك السماء",44,"ا",2,0],["وإذا أخر الفوارس إقدا","م المنايا وجدته المقداما",45,"م",2,0],["وإذا أخفق كانت حجة","قدرة المرء بما يعلمه",46,"م",2,0],["وإذا اختبزت عجينةً","ذهب اللبان مع اللهب",47,"ب",1,0]]}