"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39638","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39634","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39620","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16661","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19271","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54653","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55046","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55014","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54934","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141998","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141986","الكامل"],[106,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[106,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[15,"معلقة عبيد بن الأبرص","https://www.poetsgate.com/ViewPoem.aspx?id=11410",""],[98,"سلمى الكورانية","https://www.poetsgate.com/ViewPoem.aspx?id=53904",""],[90,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[51,"هبّتْ لوهبٍ ريحُ سوءٍ عاصفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=29390",""],[85,"لحظها لَحظها، رُوَيْداً رُوَيْدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9539&r=&rc=29",""]],"verses":[["أَوفى كَما جَلّى عَلى رَهوَةٍ","أَزرَقُ والى نَظَراتٍ بِنيق",0,"ق",1,0],["أَوفيتُ مُعتَلِياً عَلَيكُم واضِعاً","قَدَمي عَلى قَمَرِ السَماءِ الموفي",1,"ي",1,0],["أَوفى الصَباحُ فَشَقَّ كُلَ دُجُنَّةٍ","وَعَلا الزَئيرُ فَغَضَّ كُلَّ نِباحِ",2,"ح",1,0],["أَو فَريدٍ طاوٍ تَضَيَّفَ أَرطا","ةً يَبيتُ في دَفِّها وَيُضاقُ",3,"ق",1,0],["أَو فَاِخلُقوها قادِرينَ فَإِنَّما","فُرَصُ الحَياةِ خَليقَةٌ أَن تُخلَقا",4,"ق",2,0],["أَو فَاِبعَثي قَلباً إِلى أَضلُعٍ","راحَ بِهِ الوَجدُ وَأَودى السَقام",5,"م",1,0],["أَو فَترَةٍ أَضاعَها ال","قامِرُ عِندَ المَيسِرِ",6,"ر",1,0],["أَوفى إِلى الخَدِّ ثُمَّ اِنصاعَ مُنعَطِفاً","كَالعُقرُبانِ اِنثَنى مِن خَوفِ مُحتَرِشِ",7,"ش",1,0],["أو فاعذر الأحرار إن هانت لهم","دون السؤال مصاعب الأعذار",8,"ر",1,0],["أَوْفَى مُلَبٍّ إِنْ دَعَا","حَقٌّ وَأَكْفَى مُسْتَعَانِ",9,"ن",1,0],["أَوْفِ البِلادَ بِمِثْلِ أَجْرِكَ حَقَّهَا","مِنْ خِدْمَةٍ وَمَحَبَّةٍ وَتَكَرُّمِ",10,"م",1,0],["أَوْ فِي المَتَاجِرِ وَهْوَ طَالِبُ حَاجَةٍ","نَفُسَتْ فَلَيْسَتْ تُشْتَرَى بِسَوَامِ",11,"م",1,0],["أَوْ فِي المَصَانِعِ وَالمَزَارِعِ بَاحِثاً","عَنْ مَبْعَثِ الإِثْرَاءِ لِلأَقْوَامِ",11,"م",1,0],["أوفني وحد البسيبا","من رضاب بنت الدنان",12,"ن",1,0],["أوفى بهادِ كالظليم وخلفه","كَفَلٌ كما ماجَ الكثيبُ الأهيلُ",13,"ل",1,0],["أو فوخروا في المكرمات فإِنّهم","نظموا بأسلاك الفخار شذورا",14,"ر",2,0],["أوفى على وجه الصباح بغرّة","فغدا الصباح بنوره يتجمَلُ",15,"ل",1,0],["أَوْف بهادِ كالظليم وخلفه","كفَلٌ كما ماج الكثيب الأهْيلُ",15,"ل",1,0],["أَو فارِسٍ كَشُرَيحٍ يَومَ تَحمِلُهُ","نَهدُ المَراكِلِ يَحمي عَورَةَ الجارِ",16,"ر",1,0],["أو فوق طاوية الحشا رمليَّةٍ","إن تَدْنُ من فنن الأَلأَةِ تعلُقُ",17,"ق",1,1],["أو فوق طاوية الحشا رملية","إن تَدنُ من فَنَن الألاءَة تَعلُقِ",18,"ق",1,0],["أَوفَت بَنو عَمروِ بنِ عَوفٍ نَذرَها","وَتَلَوَّثَت غَدراً بَنو النَجّارِ",19,"ر",1,1],["أَو في الذُؤابَةِ مِن تَيمٍ رَضيتُ بِهِم","أَو مِن بَني جُمَحَ الخُضرِ الجَلاعيدِ",20,"د",1,0],["أوفر العالمين عزًّا وعزماً","وهو أوفى العباد نسكاً وزهدا",21,"د",2,0],["أوفى السراة على المفاخرِ مفرداً","فانْظر إذا عدّ الجنود وجيَّشا",22,"ش",2,0],["أوفى النبيِّين سيفاً واتضاح علىً","كأنه غرَّةٌ والقوم تحجيل",23,"ل",1,0],["أوْفى الملوك إذا عدُّوا لسابقةٍ","تلوَ الزمان وتلوَ الأعصر الأول",24,"ل",1,0],["أوفى الورَى علماً وأسماهمُ","إلى العلى عزماً وأبهى سِمهْ",25,"م",2,0],["أو فرَغماً له هناك ودَغْماً","ألحمَ اللَّهُ أنفَه البَوْغاءَ",26,"ا",2,0],["أو فادْعُهُمْ ثم اهْجُهم راشداً","وأنت أنت الجابر الحاربُ",27,"ب",1,0],["أو فردُّوا المدح مستوراً ولا","تُشْمِتوا بي أَعيناً نحوي تَقِدْ",28,"د",1,0],["أو فقصِّر منها فحسبُك منها","نصفُ شبرٍ علامةَ التذكيرِ",29,"ر",1,0],["أو فاسمحُوا بضراطِكُم ونوالكُم","هيهاتَ لستُمْ للنَّوال نِشاطا",30,"ط",2,0],["أوفى بأعلى رتبة وتواضعت","آلاؤه فأحطن بالأعناق",31,"ق",1,0],["أو فأعتبْ فليس يجتمع الده","رَ وفورُ الأعراض والأموالِ",32,"ل",1,0],["أو فلَّ فيه حُرُّ وجهك فلّةً","في حُرّ وجهك ريعَ منه وهيلا",33,"ل",2,0],["أَوفِ مغبونَك يا غابنَه","لا يكن عذلك فيمن غبنه",34,"ن",2,0],["أَو فَكوني غَيرَ راحِمَةٍ","حِمَماً حَمراءَ لا سُحُبا",35,"ب",2,0],["أَوفى عَلى الشُهبِ الدُجى فَتَأَلَّقَت","لَولا اِعتِكارُ اللَيلِ لَم تَتَأَلَّقِ",36,"ق",1,0],["أَو في خَيالِ مَنازِلٍ أَشتاقُها","كَم مِن جَمالٍ في خَيالِ مَكانِ",37,"ن",1,0],["أَو فَراشاً أَحومُ حولكِ مسحوراً","غريقاً في نشوتي وذُهُولي",38,"ل",2,0],["او فوق كبش قرنه","في رأسه كالمعول",39,"ل",1,0],["أو فبدلهمُ بأرحم منهم","إنهم ربّ عن سبيلك صدوا",40,"د",3,0],["أو في جناحيَ عبقري مارد","يفرى السماء بِجنةٍ مراد",41,"د",1,0],["أو فتاة هينةٍ فوق الثرى","ولَدت من بالثريا يستهين",42,"ن",1,0],["أو فابتغي فلكا تأوينه ملَكا","لم يتخذ شركا في العالم الفاني",43,"ي",1,0],["أَوفَرلاندُ يُنَبّيكَ","بِها القُنصُلُ طَمّارَه",44,"ر",2,0],["أَوفى عَلى الشَيءِ الَّذي لا يُذكَرُ","وَأَدخَلَ الأصبُعَ فيهِ يَخبُرُ",45,"ر",1,0],["أَو في اِشتِهاءِ السِحرِ مِن","لَحظِ العُيونِ الساجِيَه",46,"ي",2,0],["أَو في المَسارِحِ فَهيَ بِالن","فسِ اللَطيفَةِ راقِيَه",46,"ي",2,0],["أَوفى الرِجالِ لِعَهدِهِ وَلِرَأيِهِ","وَأَبَرَّهُم بِصَديقِهِ وَالجارِ",47,"ر",1,0],["أَو فَدى المَيِّتَ حَيٌّ فُدِيَت","بِوَقاحٍ في الجَواري وَخِفَر",48,"ر",1,0],["أَو فَصُغ لي مِنَ الحِجارَةِ قَلبا","ثُمَّ صُغ لي مِنَ الحَدائِدِ كِبدا",49,"د",2,0],["أَو فَمُ الحَبيبِ جَلا","عَن جُمانِهِ الشَنَبُ",50,"ب",1,0],["أَوفَدتُمُ وَفداً وَأَوفَدَ رَبُّكُم","مَعَهُ العِنايَةَ فَهيَ مِن أَعوانِهِ",51,"ن",2,0],["أَوْفَى بِصَبْغِ أبي قَابُوسَ مَفْرقُهُ","كَدُرَّةِ التّاجِ لَمّا عُولِيَتْ شَرَفَا",52,"ف",2,0],["أَوفى فَكُنتُ إِذا رَمَيتُ بِمُقلَتي","بَشَراً رَأَيتُ أَرَقَّ مِن عَبَراتِها",53,"ت",3,0],["أَوفى فَظَنّوا أَنَّهُ القَدَرُ الَّذي","سَمِعوا بِهِ فَمُصَدِّقٌ وَمُكَذِّبُ",54,"ب",1,0],["أَوفى بِها كَالعِقدِ فُصِّلُ نَظمُهُ","بِالدُرِّ إِلّا أَنَّهُ لَم يُثقَبِ",55,"ب",1,0],["أَوفى بِعُرفٍ أَسوَدٍ مُتَغَربِبٍ","فيما يَليهِ وَحافِرٍ فَيروزَجي",56,"ج",2,0],["أَوفى فَأَعشاكَ الصَباحُ بِضَوئِهِ","وَجَرى فَغَرَّقَكَ الفُراتُ الزائِدُ",57,"د",1,0],["أَوفى عَلى ظُلَمِ الشُكوكِ فَشَقَّها","كَالصُبحِ يَضرِبُ في الدُجى بِعَمودِهِ",58,"د",2,0],["أَوفى ضِياءً بِطَلعَةٍ بَهَرَت","شَمسَ الضُحى إِذ أَضاءَ نَيِّرُها",59,"ر",3,0],["أَوفى عَلَيهِ فَظَنَّ مِن دَهَشٍ بِهِ","البَرَّ بَحراً وَالفَضاءَ مَضيقا",60,"ق",2,0],["أَوفى فَأَضمَرَتِ القُلوبُ مَهابَةً","لِمُوَقِّرِ اللَحَظاتِ فَخمِ المَنطِقِ",61,"ق",1,0],["أَوفَيتَ عاشِرُهُم فَإِن نُدِبوا إِلى","كَرَمٍ وَإِحسانِ فَأَنتَ الأَوَّلُ",62,"ل",1,0],["أَو فَعالاً كُنتَ مِن عُذ","رِ حَبيبٍ وَاِعتِلالِه",63,"ل",2,0],["أَو فِضَّةٍ فاضَت بِأَرضِ زُمُرُّدٍ","أَو ماءِ دُرٍّ دارَ في مَرجانِ",64,"ن",1,0],["أوفَىعلى طُرُقٍ أقا","مَ فَليسَ يُؤذَنُ بانطِلاقِ",65,"ق",1,0],["أوفى فكان مُحلِّقَاً ومضى فكا","نَ مُزلَّقاً وسَطا فكانَ مُحرِّقا",66,"ق",2,0],["أوفَى عليه مُقارِعاً حتى إذا","أعطى القِيادَ أجارَه مَلهوفا",67,"ف",2,0],["أوفَى فأشرقَ بينَ نَشْرٍ ساطعٍ","قمرٌ يُعيدُ اللَّيلَ فَجْراً ساطِعا",68,"ع",2,0],["أوفى عليَّ فما انجلَتْ غَمَراتُه","إلا بصِدْقِ كِفاحِه وجِلادِه",69,"د",2,0],["أوفى فَلَمْ تَثْنِهِ حربُ الشَّمالِ وقد","لاقَتْه فاعتَركا في الجوِّ واحترَبا",70,"ب",2,0],["أوفى فسدَّ شِعابَهم بعَرَمْرَمٍ","يغشى الفضاءَ الرَّحْبَ سَيلُ عُبابِه",71,"ب",2,0],["أو فاغنموا السِّلْمَ قبلَ الحَيْنِ واستلموا","ركناً تَحِنُّ إليه العُجْمُ والعَرَبُ",72,"ب",1,0],["أوفى على بطنِ هنزيطٍ فأمطره","وَدْقاً خلالَ بروقِ البيضِ يَنسكِبُ",72,"ب",1,0],["أَوفى عَلى شَرَفٍ نَشزٍ فَأَزعَجَهُ","قَلبٌ إِلى آلِ سَلمى تائِقٌ كَمِدُ",73,"د",1,0],["أو فاهمٍ فنَّ الصَّناعِ الذي","أبدَع الاثنين الحِجا والجسد",74,"د",1,0],["أوْفتْ على حوْضٍ لها فكأنّها","منها إلى العَجَبِ العُجابِ رواني",75,"ن",2,0],["أَوفى عليٌّ فَسِنُّ المَلكِ ضاحِكَةٌ","وعينُهُ من أبيه دَمْعُها هَمِرُ",76,"ر",1,0],["أَوْ فَابْعَثِي قَلْبِي إِلَيَّ فَإِنَّهُ","جَارَى هَوَاكِ فَقَادَهُ بِزِمَامِهِ",77,"م",2,0],["أوْ فاضَ دمعي مِنْ يتامى ولْدِهِ","فالدرُّ يُوصَفُ باليتيمِ فيُرْفَعُ",78,"ع",1,0],["أوفى الرّجالِ على الحوادثِ مَن له","قَلبٌ بِحُبّ بِلادِه مَعْمورُ",79,"ر",1,0],["أَوْفىَ على الدُّنيا وملءُ فِجاجِها","بَغيٌ يُزلزِلُها وظُلمٌ مُوبِقُ",80,"ق",1,0],["أَوْفَى على الوادي فَكبَّرَ واحْتَفَى","بالمُصطَفى المختارِ من زُعمائِهِ",81,"ا",3,0],["أَوْفَتْ على الأُفُقِ المُسْوَدِّ فانْصدَعَتْ","سُودُ الغياهبِ عنه والدّياجيرِ",82,"ر",1,0],["أوفى بَحمزَةَ والعبّاسِ مَجدُهُما","يا أختَ زَوْجَيْهِما والنَّاسُ أَشْباهُ",83,"ا",2,0],["أَوفى في الجَمالِ وَفي السِحرِ","عَلى يوسُفٍ وَهاروت",84,"ت",1,0],["أَو فَوقَ أَخنَسَ ناشِطٍ بِشَقيقَةٍ","لَهَقٌ بِغائِطِ قَفرَةٍ مَحبورُ",85,"ر",1,0],["أَوفى عَلى عَقدِ الكَثيبِ كَأَنَّهُ","وَسطَ القِداحِ مُعَقَّبٌ مَشهورُ",85,"ر",1,0],["أَو فَإِنّي مُسرِعٌ إِن شِئتُمُ","بِحُسامٍ مَشرَفيٍّ وَجَوادِ",86,"د",1,0],["أوفى فماسَ على غُصْنٍ وماجَ على","دِعْصٍ وقامَ على أُنبوبِ بَرديّ",87,"ي",1,0],["أو في دروُعِ البأسِ من مُستَلْئِمٍ","أو في ثِيابِ الخَزّ من نَشوانِ",88,"ن",1,0],["أو فاسقِنِيه فإنّني أولى به","من أن يُرَاقَ على ثَرىً وصَعيد",89,"د",1,0],["أَوفى عَلى شَعَفِ الجِدارِ بِسُدفَةٍ","غَرِداً يُصَفِّقُ بِالجَناحِ جَناحا",90,"ح",2,0],["أَوفَقُ الأَشهُرِ لي أَب","عَدُها مِن رَمَضانِ",91,"ن",1,0],["أَو فَذَريني وَصِلي جاهِلاً","يَلقى مِنَ الغَيرَةِ فيكِ الهَوان",92,"ن",1,0],["أَوفِ دُيوني وَخَلِّ أَقراضي","مِثلُكَ لا يَهتَدي لِأَغراضي",93,"ض",2,1],["أَوفى عَلى رُكنَينِ فَوقَ مَثابَةٍ","عَن جولِ نازِحَةِ الرِشاءِ شَطونِ",94,"ن",1,0],["أَو فَلَجٌ ما بِبَطنِ وادٍ","لِلماءِ مِن بَينِهِ سُكوبُ",95,"ب",1,0],["أو فكرة هي في ذا","تها خيال وساع",96,"ع",1,0],["أو فاطرقي بالبثِّ أبوابها","لعلّها ترفعُ عنكِ الشقاءْ",97,"ا",2,0],["أو فاملأوا من زهرها اليانعِ","مجامرَ النارِ وألقوا البخورْ",97,"ر",1,0],["أوفى على الوادي بضاحكِ ثغرهِ","وجهٌ تُقبِّلهُ السماءُ وترأمُ",98,"م",1,0],["أو فضَعْ منْكَ على النصْل وريدا","فدمي يَخنِقُكَ اليومَ طَريدا",99,"د",2,0],["أو فقُمْ للغابِ من غِرِّيدها","نسمّعِ الرُّوح الطليقَ المرِحا",100,"ح",2,0],["أو فكوني في حُلمهِ الزَّهرَ والأنْ","غامَ والخمرَ والعروس الشَّمُوعا",101,"ع",2,0],["أَوْفَى بها الحِرْباءُ عُودَيْ مِنْبَرٍ","للظُّهْرِ إلاّ أنّه لم يَخطُب",102,"ب",1,0],["أوفتْ على اليرموك تطغى من طرب","يا مأتم الروم ويا عرس العرب",103,"ب",1,0],["أَو في المَسارِحِ فَهيَ بِالن","نَفسِ اللَطيفَةِ راقِيَه",104,"ي",2,0],["أوفى على القوم فريع البرجُ","بفارس له السماء سرجُ",105,"ج",1,0],["أَوْ فَاسْمَحُوا لِي بِوَعْدٍ إِنْ وَنَتْ صِلَةٌ","فَالْوَعْدُ مِنْكُمْ بِطِيبِ الْعَيْشِ مُقْتَرِنُ",106,"ن",1,0],["أَوْ فَاسْتَقِيدُونِي بِبَعْضِ قِيَانِكُمْ","حَتَّى ترُدَّ إِلَيَّ نَفْسِي أَوْ تَدِي",107,"د",2,0],["أَوْفَى عَلَى جيْشٍ غَدا وَنِظَامُهُ","أَرْقَى مِثَالٍ فِي نِظَامِ العَسْكرِ",108,"ر",1,0],["أَوْفَى عَلَى السَّدِّ الأَخِيرِ وَدُونَهُ","قُرْبَ المَصِيرِ إلىَ مُحِيطِ عَفَاءِ",109,"ا",2,0],["أَوْ فَاقْرَعِ السَّوْطَ الَّذِي فِي صَوْتِهِ","إِيقَاظُ غَافِلِهِ وَبَعْثُ الْبَالي",110,"ل",2,0],["أوْفَى عَلَى عَدْنٍ وَمَا","هُوَ عَنْ مَحَاسِنِها غَرِيبُ",111,"ب",1,0],["أَوْفَى السعَادَاتِ لِمَنْ بَاتَ فِي","أَمْنٍ وَقَدْ أَدْرَكَ مَا يؤْثِرُ",112,"ر",1,0],["أَوْفَى فَلَمْ يُحْجَبْ هُدَى نوِرهِ","إِلاَّ وَإِصْبَاحُ الْهُدَى مُسْفِرُ",112,"ر",1,0],["أَوْفَي الْبُعُوْلَةِ لِلْحَلِيلَةِ ذِمَّةٌ","وَأَسَرُّ ذِي وُلْدٍ وَأَكْرَمُ صَاحِبِ",113,"ب",1,0],["أَوْفَى المَلِيكُ عَلَيْهِ فِي تَعَهُّدِهِ","صَرْحاً مُشِيداً عَلَى الإِحْسَانِ قَدْ وَقَفَا",114,"ف",2,0],["أَوْفَى عَلَيْهِمْ بِالحَصَافَةِ وَالنَّدَى","وَبِسُؤْددٍ مِلءِ النَّوَاظِرِ نَاصِعِ",115,"ع",1,0],["أَوْ فُرِّقُوا سلَعاً وَفَرَّ","قَهُمْ منَ الفُسَّاقِ تَاجِرْ",116,"ر",1,0],["أو فعد للحقول دغدغ بها","الزهر ونبّه في صدرها الأشواقا",117,"ق",2,0],["أوفى وأكرضمُ فهو يشفِقُ أن ترى","عطف العذول ورحمةَ الأضداد",118,"د",1,0],["أو في المآذنِ باسِقاتٍ، أينما","أرسلتَ طرْفَكَ نحوهُنَّ تحيَّرا",119,"ر",2,0],["أو في السماء مرفرِفٌ","بجناحه مثلَ الحمام",120,"م",1,0],["أو فانقشوا بدم الضحايا خطَّهُ","وتذكروا يومًا قضوْه عصيبا",121,"ب",2,0],["أو فَلْجُ وادٍ بِبَطْنِ أرضٍ","لِلماءِ مِنْ تَحْتِها قَسيبُ",122,"ب",1,0],["أو فأمري الطرس يغدو للهوى قبلاً","حمراً ترصع أجياداً وأفواها",123,"ا",3,0],["أو فلا يُرتَجى نهوضٌ لشعبٍ","ان يُقدِّمْ شبراً يُعيَقْ أشبارا",124,"ر",2,0],["أوفى عليه يَقيهِ حَرَّ هاجرةٍ","سُرادِقٌ من لطيفِ الظلِّ ممدود",125,"د",1,0],["أو فاسمحُوا بضراطِكُم ونوالكُمْ","هيهلتَلستُمْ للنَّوالِ نِشاطا",126,"ط",2,0],["أو فضع لي من الحجارة قلبا","ثم صُغ لي من الحدائدِ كِبْدا",127,"د",2,0]]}