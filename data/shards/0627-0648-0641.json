html","الكامل"],[459,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[459,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[459,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[459,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[459,"لا تلمس الشمس يد","https://www.aldiwan.net/poem56236.html","مجزوء الرجز"],[462,"حي نجدا وأين من مرو نجد","https://www.aldiwan.net/poem15112.html","الخفيف"],[462,"لله در قبيلة","https://www.aldiwan.net/poem16136.html","مجزوء الكامل"],[465,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[465,"ومشمر للحرب عن أذياله","https://www.aldiwan.net/poem3448.html","عموديه"],[476,"ما بال عينك تبكي دمعها خضل","https://www.aldiwan.net/poem1820.html","البسيط"],[480,"حي الصبا حي سلمى فلنحييه","https://www.aldiwan.net/poem36925.html","البسيط"],[515,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[515,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[516,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[516,"أيها القارئ إذا مت","https://www.aldiwan.net/poem12157.html","مجزوء الرمل"],[516,"أصبح عبد الحضرة العالية","https://www.aldiwan.net/poem12306.html","السريع"],[552,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[554,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[559,"قلبي الذي في ذاتكم يتقلب","https://www.aldiwan.net/poem34938.html","الكامل"],[561,"من يعرف الشوق ؟","https://www.aldiwan.net/poem67275.html","عموديه"],[562,"يا رب إن أخطأت أو نسيت","https://www.aldiwan.net/poem27865.html","الرجز"],[563,"ما بال تلك الشامة الخضراء","https://www.aldiwan.net/poem52869.html","الكامل"],[568,"الثلج يسقط أم لجين يسبك","https://www.aldiwan.net/poem69558.html","الكامل"],[574,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"],[574,"أحق ما كان من قلبي تباريح","https://www.aldiwan.net/poem3654.html","البسيط"],[576,"يا طرف من فتن الأنام بفتنة","https://www.aldiwan.net/poem3002.html","الكامل"],[576,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[576,"ليس لي منه سوى لا","https://www.aldiwan.net/poem3032.html","مجزوء الرمل"]],"verses":[["أَوفى كَما جَلّى عَلى رَهوَةٍ","أَزرَقُ والى نَظَراتٍ بِنيق",0,"ق",1,0],["أَوفيتُ مُعتَلِياً عَلَيكُم واضِعاً","قَدَمي عَلى قَمَرِ السَماءِ الموفي",1,"ف",2,0],["أَوفى الصَباحُ فَشَقَّ كُلَ دُجُنَّةٍ","وَعَلا الزَئيرُ فَغَضَّ كُلَّ نِباحِ",2,"ح",1,0],["أَو فَريدٍ طاوٍ تَضَيَّفَ أَرطا","ةً يَبيتُ في دَفِّها وَيُضاقُ",3,"ق",1,0],["أَو فَاِخلُقوها قادِرينَ فَإِنَّما","فُرَصُ الحَياةِ خَليقَةٌ أَن تُخلَقا",4,"ق",2,0],["أَو فَاِبعَثي قَلباً إِلى أَضلُعٍ","راحَ بِهِ الوَجدُ وَأَودى السَقام",5,"م",1,0],["أَو فَترَةٍ أَضاعَها ال","قامِرُ عِندَ المَيسِرِ",6,"ر",1,0],["أَوفى إِلى الخَدِّ ثُمَّ اِنصاعَ مُنعَطِفاً","كَالعُقرُبانِ اِنثَنى مِن خَوفِ مُحتَرِشِ",7,"ش",1,0],["أو فاعذر الأحرار إن هانت لهم","دون السؤال مصاعب الأعذار",8,"ر",1,0],["أَوْفَى مُلَبٍّ إِنْ دَعَا","حَقٌّ وَأَكْفَى مُسْتَعَانِ",9,"ن",1,0],["أَوْفِ البِلادَ بِمِثْلِ أَجْرِكَ حَقَّهَا","مِنْ خِدْمَةٍ وَمَحَبَّةٍ وَتَكَرُّمِ",10,"م",1,0],["أَوْ فِي المَتَاجِرِ وَهْوَ طَالِبُ حَاجَةٍ","نَفُسَتْ فَلَيْسَتْ تُشْتَرَى بِسَوَامِ",11,"م",1,0],["أَوْ فِي المَصَانِعِ وَالمَزَارِعِ بَاحِثاً","عَنْ مَبْعَثِ الإِثْرَاءِ لِلأَقْوَامِ",11,"م",1,0],["أوفني وحد البسيبا","من رضاب بنت الدنان",12,"ن",1,0],["أوفى بهادِ كالظليم وخلفه","كَفَلٌ كما ماجَ الكثيبُ الأهيلُ",13,"ل",1,0],["أو فوخروا في المكرمات فإِنّهم","نظموا بأسلاك الفخار شذورا",14,"ر",2,0],["أوفى على وجه الصباح بغرّة","فغدا الصباح بنوره يتجمَلُ",15,"ل",1,0],["أَوْف بهادِ كالظليم وخلفه","كفَلٌ كما ماج الكثيب الأهْيلُ",15,"ل",1,0],["أَو فارِسٍ كَشُرَيحٍ يَومَ تَحمِلُهُ","نَهدُ المَراكِلِ يَحمي عَورَةَ الجارِ",16,"ر",1,0],["أو فوق طاوية الحشا رمليَّةٍ","إن تَدْنُ من فنن الأَلأَةِ تعلُقُ",17,"ق",1,1],["أو فوق طاوية الحشا رملية","إن تَدنُ من فَنَن الألاءَة تَعلُقِ",18,"ق",1,0],["أَوفَت بَنو عَمروِ بنِ عَوفٍ نَذرَها","وَتَلَوَّثَت غَدراً بَنو النَجّارِ",19,"ر",1,1],["أَو في الذُؤابَةِ مِن تَيمٍ رَضيتُ بِهِم","أَو مِن بَني جُمَحَ الخُضرِ الجَلاعيدِ",20,"د",1,0],["أوفر العالمين عزًّا وعزماً","وهو أوفى العباد نسكاً وزهدا",21,"د",2,0],["أوفى السراة على المفاخرِ مفرداً","فانْظر إذا عدّ الجنود وجيَّشا",22,"ش",2,0],["أوفى النبيِّين سيفاً واتضاح علىً","كأنه غرَّةٌ والقوم تحجيل",23,"ل",1,0],["أوْفى الملوك إذا عدُّوا لسابقةٍ","تلوَ الزمان وتلوَ الأعصر الأول",24,"ل",1,0],["أوفى الورَى علماً وأسماهمُ","إلى العلى عزماً وأبهى سِمهْ",25,"م",2,0],["أو فرَغماً له هناك ودَغْماً","ألحمَ اللَّهُ أنفَه البَوْغاءَ",26,"ا",2,0],["أو فادْعُهُمْ ثم اهْجُهم راشداً","وأنت أنت الجابر الحاربُ",27,"ب",1,0],["أو فردُّوا المدح مستوراً ولا","تُشْمِتوا بي أَعيناً نحوي تَقِدْ",28,"د",1,0],["أو فقصِّر منها فحسبُك منها","نصفُ شبرٍ علامةَ التذكيرِ",29,"ر",1,0],["أو فاسمحُوا بضراطِكُم ونوالكُم","هيهاتَ لستُمْ للنَّوال نِشاطا",30,"ط",2,0],["أوفى بأعلى رتبة وتواضعت","آلاؤه فأحطن بالأعناق",31,"ق",1,0],["أو فأعتبْ فليس يجتمع الده","رَ وفورُ الأعراض والأموالِ",32,"ل",1,0],["أو فلَّ فيه حُرُّ وجهك فلّةً","في حُرّ وجهك ريعَ منه وهيلا",33,"ل",2,0],["أَوفِ مغبونَك يا غابنَه","لا يكن عذلك فيمن غبنه",34,"ن",2,0],["أَو فَكوني غَيرَ راحِمَةٍ","حِمَماً حَمراءَ لا سُحُبا",35,"ب",2,0],["أَوفى عَلى الشُهبِ الدُجى فَتَأَلَّقَت","لَولا اِعتِكارُ اللَيلِ لَم تَتَأَلَّقِ",36,"ق",1,0],["أَو في خَيالِ مَنازِلٍ أَشتاقُها","كَم مِن جَمالٍ في خَيالِ مَكانِ",37,"ن",1,0],["أَو فَراشاً أَحومُ حولكِ مسحوراً","غريقاً في نشوتي وذُهُولي",38,"ل",2,0],["او فوق كبش قرنه","في رأسه كالمعول",39,"ل",1,0],["أو فبدلهمُ بأرحم منهم","إنهم ربّ عن سبيلك صدوا",40,"د",3,0],["أو في جناحيَ عبقري مارد","يفرى السماء بِجنةٍ مراد",41,"د",1,0],["أو فتاة هينةٍ فوق الثرى","ولَدت من بالثريا يستهين",42,"ن",1,0],["أو فابتغي فلكا تأوينه ملَكا","لم يتخذ شركا في العالم الفاني",43,"ن",2,0],["أَوفَرلاندُ يُنَبّيكَ","بِها القُنصُلُ طَمّارَه",44,"ر",2,0],["أَوفى عَلى الشَيءِ الَّذي لا يُذكَرُ","وَأَدخَلَ الأصبُعَ فيهِ يَخبُرُ",45,"ر",1,0],["أَو في اِشتِهاءِ السِحرِ مِن","لَحظِ العُيونِ الساجِيَه",46,"ي",2,0],["أَو في المَسارِحِ فَهيَ بِالن","فسِ اللَطيفَةِ راقِيَه",46,"ي",2,0],["أَوفى الرِجالِ لِعَهدِهِ وَلِرَأيِهِ","وَأَبَرَّهُم بِصَديقِهِ وَالجارِ",47,"ر",1,0],["أَو فَدى المَيِّتَ حَيٌّ فُدِيَت","بِوَقاحٍ في الجَواري وَخِفَر",48,"ر",1,0],["أَو فَصُغ لي مِنَ الحِجارَةِ قَلبا","ثُمَّ صُغ لي مِنَ الحَدائِدِ كِبدا",49,"د",2,0],["أَو فَمُ الحَبيبِ جَلا","عَن جُمانِهِ الشَنَبُ",50,"ب",1,0],["أَوفَدتُمُ وَفداً وَأَوفَدَ رَبُّكُم","مَعَهُ العِنايَةَ فَهيَ مِن أَعوانِهِ",51,"ن",2,0],["أَوْفَى بِصَبْغِ أبي قَابُوسَ مَفْرقُهُ","كَدُرَّةِ التّاجِ لَمّا عُولِيَتْ شَرَفَا",52,"ف",2,0],["أَوفى فَكُنتُ إِذا رَمَيتُ بِمُقلَتي","بَشَراً رَأَيتُ أَرَقَّ مِن عَبَراتِها",53,"ت",3,0],["أَوفى فَظَنّوا أَنَّهُ القَدَرُ الَّذي","سَمِعوا بِهِ فَمُصَدِّقٌ وَمُكَذِّبُ",54,"ب",1,0],["أَوفى بِها كَالعِقدِ فُصِّلُ نَظمُهُ","بِالدُرِّ إِلّا أَنَّهُ لَم يُثقَبِ",55,"ب",1,0],["أَوفى بِعُرفٍ أَسوَدٍ مُتَغَربِبٍ","فيما يَليهِ وَحافِرٍ فَيروزَجي",56,"ج",2,0],["أَوفى فَأَعشاكَ الصَباحُ بِضَوئِهِ","وَجَرى فَغَرَّقَكَ الفُراتُ الزائِدُ",57,"د",1,0],["أَوفى عَلى ظُلَمِ الشُكوكِ فَشَقَّها","كَالصُبحِ يَضرِبُ في الدُجى بِعَمودِهِ",58,"د",2,0],["أَوفى ضِياءً بِطَلعَةٍ بَهَرَت","شَمسَ الضُحى إِذ أَضاءَ نَيِّرُها",59,"ر",3,0],["أَوفى عَلَيهِ فَظَنَّ مِن دَهَشٍ بِهِ","البَرَّ بَحراً وَالفَضاءَ مَضيقا",60,"ق",2,0],["أَوفى فَأَضمَرَتِ القُلوبُ مَهابَةً","لِمُوَقِّرِ اللَحَظاتِ فَخمِ المَنطِقِ",61,"ق",1,0],["أَوفَيتَ عاشِرُهُم فَإِن نُدِبوا إِلى","كَرَمٍ وَإِحسانِ فَأَنتَ الأَوَّلُ",62,"ل",1,0],["أَو فَعالاً كُنتَ مِن عُذ","رِ حَبيبٍ وَاِعتِلالِه",63,"ل",2,0],["أَو فِضَّةٍ فاضَت بِأَرضِ زُمُرُّدٍ","أَو ماءِ دُرٍّ دارَ في مَرجانِ",64,"ن",1,0],["أوفَىعلى طُرُقٍ أقا","مَ فَليسَ يُؤذَنُ بانطِلاقِ",65,"ق",1,0],["أوفى فكان مُحلِّقَاً ومضى فكا","نَ مُزلَّقاً وسَطا فكانَ مُحرِّقا",66,"ق",2,0],["أوفَى عليه مُقارِعاً حتى إذا","أعطى القِيادَ أجارَه مَلهوفا",67,"ف",2,0],["أوفَى فأشرقَ بينَ نَشْرٍ ساطعٍ","قمرٌ يُعيدُ اللَّيلَ فَجْراً ساطِعا",68,"ع",2,0],["أوفى عليَّ فما انجلَتْ غَمَراتُه","إلا بصِدْقِ كِفاحِه وجِلادِه",69,"د",2,0],["أوفى فَلَمْ تَثْنِهِ حربُ الشَّمالِ وقد","لاقَتْه فاعتَركا في الجوِّ واحترَبا",70,"ب",2,0],["أوفى فسدَّ شِعابَهم بعَرَمْرَمٍ","يغشى الفضاءَ الرَّحْبَ سَيلُ عُبابِه",71,"ب",2,0],["أو فاغنموا السِّلْمَ قبلَ الحَيْنِ واستلموا","ركناً تَحِنُّ إليه العُجْمُ والعَرَبُ",72,"ب",1,0],["أوفى على بطنِ هنزيطٍ فأمطره","وَدْقاً خلالَ بروقِ البيضِ يَنسكِبُ",72,"ب",1,0],["أَوفى عَلى شَرَفٍ نَشزٍ فَأَزعَجَهُ","قَلبٌ إِلى آلِ سَلمى تائِقٌ كَمِدُ",73,"د",1,0],["أو فاهمٍ فنَّ الصَّناعِ الذي","أبدَع الاثنين الحِجا والجسد",74,"د",1,0],["أوْفتْ على حوْضٍ لها فكأنّها","منها إلى العَجَبِ العُجابِ رواني",75,"ن",2,0],["أَوفى عليٌّ فَسِنُّ المَلكِ ضاحِكَةٌ","وعينُهُ من أبيه دَمْعُها هَمِرُ",76,"ر",1,0],["أَوْ فَابْعَثِي قَلْبِي إِلَيَّ فَإِنَّهُ","جَارَى هَوَاكِ فَقَادَهُ بِزِمَامِهِ",77,"م",2,0],["أوْ فاضَ دمعي مِنْ يتامى ولْدِهِ","فالدرُّ يُوصَفُ باليتيمِ فيُرْفَعُ",78,"ع",1,0],["أوفى الرّجالِ على الحوادثِ مَن له","قَلبٌ بِحُبّ بِلادِه مَعْمورُ",79,"ر",1,0],["أَوْفىَ على الدُّنيا وملءُ فِجاجِها","بَغيٌ يُزلزِلُها وظُلمٌ مُوبِقُ",80,"ق",1,0],["أَوْفَى على الوادي فَكبَّرَ واحْتَفَى","بالمُصطَفى المختارِ من زُعمائِهِ",81,"ا",3,0],["أَوْفَتْ على الأُفُقِ المُسْوَدِّ فانْصدَعَتْ","سُودُ الغياهبِ عنه والدّياجيرِ",82,"ر",1,0],["أوفى بَحمزَةَ والعبّاسِ مَجدُهُما","يا أختَ زَوْجَيْهِما والنَّاسُ أَشْباهُ",83,"ا",2,0],["أَوفى في الجَمالِ وَفي السِحرِ","عَلى يوسُفٍ وَهاروت",84,"ت",1,0],["أَو فَوقَ أَخنَسَ ناشِطٍ بِشَقيقَةٍ","لَهَقٌ بِغائِطِ قَفرَةٍ مَحبورُ",85,"ر",1,0],["أَوفى عَلى عَقدِ الكَثيبِ كَأَنَّهُ","وَسطَ القِداحِ مُعَقَّبٌ مَشهورُ",85,"ر",1,0],["أَو فَإِنّي مُسرِعٌ إِن شِئتُمُ","بِحُسامٍ مَشرَفيٍّ وَجَوادِ",86,"د",1,0],["أوفى فماسَ على غُصْنٍ وماجَ على","دِعْصٍ وقامَ على أُنبوبِ بَرديّ",87,"ي",1,0],["أو في دروُعِ البأسِ من مُستَلْئِمٍ","أو في ثِيابِ الخَزّ من نَشوانِ",88,"ن",1,0],["أو فاسقِنِيه فإنّني أولى به","من أن يُرَاقَ على ثَرىً وصَعيد",89,"د",1,0],["أَوفى عَلى شَعَفِ الجِدارِ بِسُدفَةٍ","غَرِداً يُصَفِّقُ بِالجَناحِ جَناحا",90,"ح",2,0],["أَوفَقُ الأَشهُرِ لي أَب","عَدُها مِن رَمَضانِ",91,"ن",1,0],["أَو فَذَريني وَصِلي جاهِلاً","يَلقى مِنَ الغَيرَةِ فيكِ الهَوان",92,"ن",1,0],["أَوفِ دُيوني وَخَلِّ أَقراضي","مِثلُكَ لا يَهتَدي لِأَغراضي",93,"ض",2,1],["أَوفى عَلى رُكنَينِ فَوقَ مَثابَةٍ","عَن جولِ نازِحَةِ الرِشاءِ شَطونِ",94,"ن",1,0],["أَو فَلَجٌ ما بِبَطنِ وادٍ","لِلماءِ مِن بَينِهِ سُكوبُ",95,"ب",1,0],["أو فكرة هي في ذا","تها خيال وساع",96,"ع",1,0],["أو فاطرقي بالبثِّ أبوابها","لعلّها ترفعُ عنكِ الشقاءْ",97,"ا",2,0],["أو فاملأوا من زهرها اليانعِ","مجامرَ النارِ وألقوا البخورْ",97,"ر",1,0],["أوفى على الوادي بضاحكِ ثغرهِ","وجهٌ تُقبِّلهُ السماءُ وترأمُ",98,"م",1,0],["أو فضَعْ منْكَ على النصْل وريدا","فدمي يَخنِقُكَ اليومَ طَريدا",99,"د",2,0],["أو فقُمْ للغابِ من غِرِّيدها","نسمّعِ الرُّوح الطليقَ المرِحا",100,"ح",2,0],["أو فكوني في حُلمهِ الزَّهرَ والأنْ","غامَ والخمرَ والعروس الشَّمُوعا",101,"ع",2,0],["أَوْفَى بها الحِرْباءُ عُودَيْ مِنْبَرٍ","للظُّهْرِ إلاّ أنّه لم يَخطُب",102,"ب",1,0],["أوفتْ على اليرموك تطغى من طرب","يا مأتم الروم ويا عرس العرب",103,"ب",1,0],["أَو في المَسارِحِ فَهيَ بِالن","نَفسِ اللَطيفَةِ راقِيَه",104,"ي",2,0],["أوفى على القوم فريع البرجُ","بفارس له السماء سرجُ",105,"ج",1,0],["أَوْ فَاسْمَحُوا لِي بِوَعْدٍ إِنْ وَنَتْ صِلَةٌ","فَالْوَعْدُ مِنْكُمْ بِطِيبِ الْعَيْشِ مُقْتَرِنُ",106,"ن",1,0],["أَوْ فَاسْتَقِيدُونِي بِبَعْضِ قِيَانِكُمْ","حَتَّى ترُدَّ إِلَيَّ نَفْسِي أَوْ تَدِي",107,"د",2,0],["أَوْفَى عَلَى جيْشٍ غَدا وَنِظَامُهُ","أَرْقَى مِثَالٍ فِي نِظَامِ العَسْكرِ",108,"ر",1,0],["أَوْفَى عَلَى السَّدِّ الأَخِيرِ وَدُونَهُ","قُرْبَ المَصِيرِ إلىَ مُحِيطِ عَفَاءِ",109,"ا",2,0],["أَوْ فَاقْرَعِ السَّوْطَ الَّذِي فِي صَوْتِهِ","إِيقَاظُ غَافِلِهِ وَبَعْثُ الْبَالي",110,"ل",2,0],["أوْفَى عَلَى عَدْنٍ وَمَا","هُوَ عَنْ مَحَاسِنِها غَرِيبُ",111,"ب",1,0],["أَوْفَى السعَادَاتِ لِمَنْ بَاتَ فِي","أَمْنٍ وَقَدْ أَدْرَكَ مَا يؤْثِرُ",112,"ر",1,0],["أَوْفَى فَلَمْ يُحْجَبْ هُدَى نوِرهِ","إِلاَّ وَإِصْبَاحُ الْهُدَى مُسْفِرُ",112,"ر",1,0],["أَوْفَي الْبُعُوْلَةِ لِلْحَلِيلَةِ ذِمَّةٌ","وَأَسَرُّ ذِي وُلْدٍ وَأَكْرَمُ صَاحِبِ",113,"ب",1,0],["أَوْفَى المَلِيكُ عَلَيْهِ فِي تَعَهُّدِهِ","صَرْحاً مُشِيداً عَلَى الإِحْسَانِ قَدْ وَقَفَا",114,"ف",2,0],["أَوْفَى عَلَيْهِمْ بِالحَصَافَةِ وَالنَّدَى","وَبِسُؤْددٍ مِلءِ النَّوَاظِرِ نَاصِعِ",115,"ع",1,0],["أَوْ فُرِّقُوا سلَعاً وَفَرَّ","قَهُمْ منَ الفُسَّاقِ تَاجِرْ",116,"ر",1,0],["أو فعد للحقول دغدغ بها","الزهر ونبّه في صدرها الأشواقا",117,"ق",2,0],["أوفى وأكرضمُ فهو يشفِقُ أن ترى","عطف العذول ورحمةَ الأضداد",118,"د",1,0],["أو في المآذنِ باسِقاتٍ، أينما","أرسلتَ طرْفَكَ نحوهُنَّ تحيَّرا",119,"ر",2,0],["أو في السماء مرفرِفٌ","بجناحه مثلَ الحمام",120,"م",1,0],["أو فانقشوا بدم الضحايا خطَّهُ","وتذكروا يومًا قضوْه عصيبا",121,"ب",2,0],["أو فَلْجُ وادٍ بِبَطْنِ أرضٍ","لِلماءِ مِنْ تَحْتِها قَسيبُ",122,"ب",1,0],["أَوفَى على الوادي بضاحكِ ثغرِهِ","وجهٌ تباركهُ السماءُ وترأمُ",123,"م",1,0],["أو فأمري الطرس يغدو للهوى قبلاً","حمراً ترصع أجياداً وأفواها",124,"ا",3,0],["أو فلا يُرتَجى نهوضٌ لشعبٍ","ان يُقدِّمْ شبراً يُعيَقْ أشبارا",125,"ر",2,0],["أوفى عليه يَقيهِ حَرَّ هاجرةٍ","سُرادِقٌ من لطيفِ الظلِّ ممدود",126,"د",1,0],["أو فاسمحُوا بضراطِكُم ونوالكُمْ","هيهلتَلستُمْ للنَّوالِ نِشاطا",127,"ط",2,0],["أو فضع لي من الحجارة قلبا","ثم صُغ لي من الحدائدِ كِبْدا",128,"د",2,0],["أَو فاضرِب الأموالَ في الأعدادِ","وكن عَلى ما مَرَّ ذا اعتِمادِ",129,"د",1,0],["أو فارق المغرورُ منهم كهفَهُ","يوماً فكان له إليه إيابُ",130,"ب",1,0],["أوفى بذمة قومه","من منقذ العرب الأَمين",131,"ن",1,0],["أَو فَوقَ أَحقَبَ يَقرو رَملَ واقِصَةٍ","في رَعلَةٍ كَشَقيقِ التَجرِ أَمثالِ",132,"ل",1,0],["أوفى بِذِمَّةِ رَبعِ الرِّيعِ أن تَقِفَا","فِيهِ المَطَايَا فَعُوجَاها بِهِ وقِفَا",133,"ف",2,1],["أوفى الملوكِ وأكفاهم لمعضلةٍ","تعيي الكفاة وأهداهم إلى اللقمِ",134,"م",1,0],["أوفَى بما تَرَك النَبيُّ مُحمَّدٌ","والقائِمُ المَهديُّ والخُلَفاءُ",135,"ا",2,0],["أوْ فاسقني خمر الثنايا صرفةً","إذ ليس لي أرب فُديتَ سواها",136,"ا",3,0],["أو فادْنُ مني خُطوةً","فالشيءُ عند القرب يُدركْ",137,"ك",1,0],["أَو فَتَرَبَّث فَقَد ظَفِرتَ مَعَ ال","خَفضِ بِأَقصى ما يَبلُغُ النَصَبُ",138,"ب",1,0],["أَوفى عَلى قَوسِ الغَمامِ مُعَمَّماً","مِنهُ بِناحِيَةٍ لِأُخرى مُسدِلا",139,"ل",2,0],["أَو فَاِرقُبوا وَشكَ الرَدى في عَزمَةٍ","بَينَ العَزائِمِ وَالقُلوبِ تَحولُ",140,"ل",1,0],["أَوفى مِنَ الشَمسِ المُنيرَةِ بَهجَةً","وَأَشَفُّ مَنزِلَةً وَأَبعَدُ مُرتَما",141,"م",2,0],["أَوفى البَرِيَّةِ في قِراعِ مُلِمَّةٍ","حَزماً وَأَوسَعُهُم لَها حَيزوما",142,"م",2,0],["أَوفى البَرِيَّةِ نائِلاً وَحَمِيَّةً","في عامِ مَسغَبَةٍ وَيَومِ طِعانِ",143,"ن",1,0],["أو فصدِّي العُباب، وهو مُحالٌ","أو فميدي، وآذني بالخرابِ",144,"ب",1,0],["أَو فعلَ توبةِ مخلصٍ","في مَحْوِ أَوْزارِ الذنوبِ",145,"ب",1,0],["أو في حدود الله ترعى فيكم","لأخ أواصر حرمة وذمام",146,"م",1,0],["أوفَيتُ وَالشَمسُ تَمُجُّ ريقَها","وَالظِلُّ مِن تَحتِ الحِذاءِ مُحتَذى",147,"ا",1,0],["أَوفى بِعَهدٍ وَأَورى عِندَ مَظلَمَةٍ","زَنداً وَآكَدُ إِبراماً وَتَأديبا",148,"ب",2,0],["أَوفى نِزارٍ وَأَكفاها وَأَمنَعها","عِندَ اللّقاءِ وَأَحماها عَلى الحَسَبِ",149,"ب",1,0],["أَو فاتِرِ الطَرفِ مَعسُولِ الرُضابِ لَهُ","دَلٌّ يُنَبِّهُ وَسني الباهِ تَنبِيها",150,"ي",3,0],["أو فهت عن أدب أو ذكر مكرمة","سبّوا ابن قيس وسبّوا الشعر والحنفا",151,"ف",2,0],["أَوفى الجدالَ بغيرِ الحقّ مُختلقاً","ما شاءَ مِن كَذبٍ وهو الخليق بهِ",152,"ب",2,0],["أو فاكفليه يا سماء فإنَّه","ما اعتاد نجم في سواك أفولا",153,"ل",2,0],["أوفتْ على الأُفْقِ له ذروةٌ","لاذتْ به الجوزاءُ والعَقرَبُ",154,"ب",1,0],["أو فعد للسماءِ إن الشياطي","نَ عليهمْ بابُ السماءِ حرامُ",155,"م",1,0],["اوفى واوفر في الندى من حاتم","جودا وفي الامثال اضحى امثلا",156,"ل",2,0],["أو فهبني قد عتبت من أسى","أو ما كنت جديراً بالعزاء",157,"ا",2,0],["أَوفَدتَهُ البِلادُ لِلذودِ عَنها","في فُروق فَكانَ فَخرَ الوُفودِ",158,"د",1,0],["أو فاِسألي اللَهَ سُلواناً وَمُصطَبَراً","إن كانَ يَجمُلُ سُلوانٌ وَمصطَبَر",159,"ر",1,0],["أو فلأحبك حب من ألهمته","شرعا يضيء سناه كل شعور",160,"ر",1,0],["أو فإن الحب نقّا","ه ، بوحي منه سام",161,"م",1,0],["أو فعوذها ودعني","لتعاويذ غرامي",161,"م",2,0],["أو فابعَثي مِن جَنَى رُضابِك ما","يَشْفِي غليلي في رَأْسِ مِسْواكِ",162,"ك",1,0],["أو فلوموا الإله في أن برانا","فوقكم واغضبوا على المِقدار",163,"ر",1,0],["أَو في المَراكِبِ كَالعَفيرِ وَدَلدَلٍ","وَالناقَةِ العَضباءِ يَومَ رِهانِ",164,"ن",1,0],["أَو في الرّماحِ الشّارعاتِ كَرُمحهِ ال","يزنيّ ذي التّثقيفِ وَالعسلانِ",164,"ن",1,0],["أَو في الحِرابِ كَمثلِ حربتِهِ الّتي","شَرفت بِها الجمعات وَالعيدانِ",164,"ن",1,0],["أَو في الدُّروعِ السّابِغاتِ كَدرعهِ","ذاتِ الفضولِ مَظنّة الإِحصانِ",164,"ن",1,0],["أَوفى كُميَتي بَعدَ ضَيعتَها","وَاللَهُ أَغناهُ وَأَحوَجَها",165,"ج",3,0],["أَو فَلَّ مِنّي الدَهرُ ذا","شُطبٍ رَقيقَِ الشَفرَتَين",166,"ن",1,0],["أَو فَلُّ جَيشٍ عَلى الأَعقابِ مُنهَزِمٍ","مالَت بِأَيديهِمُ لِلطَعنِ خِرصانُ",167,"ن",1,0],["أَو فَاِحسِمي شَكواهُ مِن داءِ الهَوى","إِن كانَ داءُ هَواكِ مِمّا يُحسَمُ",168,"م",1,0],["أَو فَاِزجُروا عَن خِصامي صَرفَهُ فَعَسى","خُطوبُهُ تَنتَهي عَنّي وَتَنزَجِرُ",169,"ر",1,0],["أَو فَدَعها وَلايَةً أَنتَ فيها","غَرَضٌ لِلهُمومِ وَالآفاتِ",170,"ت",1,0],["أوْ فابْعثِ الأوْراقَ مَعْ","مَنْ رَاقَ ذَا سِيَرٍ حَميدَهْ",171,"د",2,0],["أَوْ فَارِسَ الْيَرْمُوكِ سَيْ","فَ اللهِ خَالِداً الْمُخَلَّدْ",172,"د",1,0],["أَوْ فَارَةٌ مِنْ أَحَمِّ الْمِسْكِ شَقَّقَهَا","عِنْدَ مَهَبِّ الصَّبَا الْمِعْطَارِ عَطَّارُ",173,"ر",1,0],["أوفاق عني قوس حاجبه فلي","كبد أمام النزع من نبالهِ",174,"ل",2,0],["أوفيهِ خلاص التبر وزناً","فيسبكه ويعطينيه كيلاً",175,"ل",2,0],["أوْفَدْتُه فَلَم يُفِدْ","مِنْ فِضّةٍ ولا ذَهَبْ",176,"ب",1,0],["أَوْ فَاسْتَمِحْ لِي مِنْ خَلِيٍّ سَلْوَةً","إِنْ كانَ ذُو الإِثْراءِ يُسْعِفُ مُمْلِقا",177,"ق",2,0],["أَوْفى وَأَشْرَفُ ما يُؤَمِّلُ آمِلٌ","أَنْ لا يُرى مِنْ رِقِّ جُودِكَ مُعْتَقا",177,"ق",2,0],["أو فآجبر اليومَ بالبكاء معي","إن كان يجبر قلبٌ بعدما تَلَفا",178,"ف",2,0],["أَوفى سَطاً في الوَغى مِن","عَمرِو بنِ مَعدي وَأَفرَس",179,"س",1,0],["أو فارس الشرق الاما","م الحضرمي ذاك الشهير",180,"ر",1,0],["أَو فارِسُ اليَحمومِ يَتبَعُهُم","كَالطَلقِ يَتبَعُ لَيلَةَ البَدرِ",181,"ر",1,0],["أو فخافت به إلى أن يواتي","نا صباح متوج بالسعود",182,"د",1,0],["أو فباك الأيام وابك مع الأيّا","م حتى تنسى وأنت العليم",183,"م",1,0],["أو فناموا وانسوا الشكاة فما","تجدي ولم تجد آدما بعد وقعه",184,"ه",1,0],["أو فقولي ألست ترجين أن لو","لم يكن كي لا يثقل الأياما",184,"م",2,0],["أو فغيبي عنّي فما أنتِ إلّا","ردّةٌ في خواطرِ النساكِ",184,"ك",1,0],["أو فخلوا الدهر يسقيني","فيروى أصغريا",185,"ي",2,0],["أو فدعني أنزع لبابك يا قش","ر تمت سالما من الأوصاب",186,"ب",1,0],["أَو فَسِّرِ الإِسراءَ وَالحَرامَ وَالأَق","صى إِلى أَسِرَّةِ الخُلدِ",187,"د",1,0],["أَو فُزتَ بِالعَدلِ وَبِالإِحسانِ بِالقُر","بى فَعَن قَصدِ السَبيلِ لا تَجُر",187,"ر",1,0],["أَوفاه بِالحَمد لِساني قائِلاً","حَمداً لَكَ اللَهُمّ يا مَن قَد قَضى",188,"ا",1,0],["أَو فهبنى كما ظننت وحاشا","ك ميأ فها أنا جئت أَبرا",189,"ر",2,0],["أَو فُصِّلَت جَواهِرُ تَنضادُهُ","يُهدي السَنا في جيدِهِ المُقَلَّد",190,"د",1,0],["أوفَيْتَ تاجَ الحَضْرتَيْنِ بهِمّةٍ","قطَعَتْ نياطَ الحاسدِ المَكْبود",191,"د",1,0],["أو فَقل لي فيمَ اجتِنابي وأخلا","قُكَ تَدنُو إلى سِوايَ وتُدني",192,"ن",2,0],["أو فَقُل إنَّك لا تُل","زِمني ما يَفعَلانِ",193,"ن",1,0],["أو فَإن لاحَ مِنهُما","في البُكا بَعضُ سِرِّنا",194,"ن",2,0],["أو في حصونٍ وأبراجٍ مشيدة","محروسةٍ بسياجاتٍ وحيطانِ",195,"ن",1,0],["أو فاعتبر سقمي ودمعي في الهوى","واعذلْ هنالك ما بدا لك أو دَعِ",196,"ع",1,0],["أو فرقة قد صار بين ظهورهم","من كاذب ومختل حلاف",197,"ف",1,0],["أو فم ولهان على خَدِّ مَنْ","يقول خذ من قُبَلِي ما اشتهيت",198,"ت",1,0],["أو فَابعَثُوا نَغْمَةً منه يعيشُ بها","قَلبي فقد مَات مُذْ حِينٍ وأَزمانِ",199,"ن",1,0],["أَو فَاِطْفِ جَمرةَ خَدَّيهِ وأَيقِظْ جَفْ","نَيْهِ اللّذينِ أَراقَا ماءَ أَجفاني",200,"ن",2,0],["أو فاسترحْ وأرِحْ لسانك واتخذ","للنطق من صمت أجلّ نطاق",201,"ق",1,0],["أو فكانا كجوادي حلبةٍ","راح يتلو أشقرٌ آثار أدهم",202,"م",1,0],["أو فضح الصبُّ فكم مغرم","أسلَمَه الحب إلى الافتضاح",203,"ح",1,0],["أوفى همامٍ بل وزيرٍ حازمٍ","لم يخشَ من ضيمٍ ومن املاق",204,"ق",1,0],["أوفى جوادٍ قد روت عن جوده","ديمُ الحياءِ بأفصح الأفواهِ",205,"ا",2,0],["أوفى همامٍ على أقدامه شهدت","بيض القواضب والخطيّة الميد",206,"د",1,0],["أو في كريم له من جدهِ شرفٌ","ومن أبيه جمالُ المجد والجود",207,"د",1,0],["أو فعلَي نهدٍ سريعٍ أشقرٍ","ينقضّ كالنجم إذا النجمُ هوى",208,"ا",1,0],["أو فأكفٌّ صُوِّرَت من بَرَدِ","قد حُمِّلتْ مَداهِناً من عسجَدِ",209,"د",1,0],["أوفى عَلَى مَوْعِدٍ منهُ تُراقِبُهُ","تَدْعُو هَلُمَّ إلى مُسْتَودَعِ الغَدَرَهْ",210,"ر",2,0],["أَوْفى بِهِ فِي رِداءِ الحِلمِ لابسُهُ","وَعَلَّهُ بلِبانِ الحَرْبِ راضِعُهُ",211,"ع",2,0],["أَوْ فأَدْنى مواعِدِ المَوْتِ منها","إِنْ تُضِعْها عَشِيَّةً أَوْ ضُحاها",212,"ا",3,0],["أَوْفَوْا بِهَا فوفَتْ بأُلْفَةِ شملِهِمْ","فِي دولةٍ مستقبَلٍ تأْييدُها",213,"د",3,0],["أَو في الفُروع وفي أَصول الفرع أَو","أَصل الفروع وَأَصلها المتناء",214,"ا",2,0],["او فؤادٌ يَرِقّ منها لشاك","يشتكي هجرها وفقد ولاها",215,"ا",3,0],["أوفى سويجعها على","غصن الأراكةِ كالخطيب",216,"ب",1,0],["أوفى على الغصن الرطي","بِ فأوسعَ الأحشاء وقْدا",217,"د",2,0],["أو فقفْ في الطريق إِن لم تزره","وقفهٌ في الطريق نصفُ الزياره",218,"ر",2,0],["أو فاه دان له الغصَّان في كَلمٍ","أبهى من الروض غِبَّ العارضِ الغدق",219,"ق",1,0],["أوفى وحوض النيل أصبح كله","حرا ففاض بحبه المعطاء",220,"ا",2,0],["أو في الصَّبا لك مَخبَرٌ عن مقلَتَيْ","هادِي الضلوعِ وموقِظٍ وسنانِ",221,"ن",1,0],["أوفَى على مَرقبةٍ من عزمهِ","مَرقَى النسورِ تطلُب الوُكونا",222,"ن",2,0],["أوفَى على مَرقَبةِ الملكِ فتىً","يرى خفيَّ المشكلات بيِّنا",223,"ن",2,0],["أوفِضْ سهامَك يا زمانُ فإنه","ترمِي الحنيَّةُ والرميُّ سليمُ",224,"م",1,0],["أو فاتت اليومَ نطافُ جوده","فلي غداً ما شئتُ من جِمامِها",225,"م",3,0],["أوفَى بنارٍ أعجبته وما درى","جهلاً أيوقد مَندَلاً أم ضالا",226,"ل",2,0],["أو فردُّوا عليَّ حيرانَ أعشى","ناظراً قد أخذتموه بصيرا",227,"ر",2,0],["أو فادّعُوا مثلَ أيّام له بهرتْ","والحقُّ أبلجُ والبهتانُ مدحورُ",228,"ر",1,0],["أوفَى على مَرقَبِه","لكفّه ما يرصُدُ",229,"د",1,0],["أوفِ فضلي حقوقه أنَّ فضلي","راح فرداً وأنت في الناس فَرْدُ",230,"د",1,0],["أو في الخُطوبِ إذا دَجَتْ","فكَشَفْتَ عنْ دَهْمائها",231,"ا",3,0],["أو فمعد القضاء مضمونها ال","بيض المواضي تزداد بالنَّقص صقلا",232,"ل",2,0],["أو فتَّشت قلبي أنامل سلوةٍ","وجدت بقلبي نافذاتِ نباله",233,"ل",2,0],["أَوفى يَبيتُ عَلى أَقذافِ شاهِقَةٍ","جَلسٍ يَزِلُّ بِها الخُطّافُ وَالحَجَلُ",234,"ل",1,0],["أوفدته بدلا مني لفاتنتي","لعلها عوضا عني توافينه",235,"ي",3,0],["أو في السماء تكون قوّةُ بأسهِ","في الروعِ يومَ البعثِ لم تتفطّرِ",236,"ر",1,0],["أو في الدُجى عن نورِه كُشِفَ الغطا","قامت له الحِرباءُ ليلاً ترقُبُ",237,"ب",1,0],["أوفى أبو حسن بعهدك عندما","خذلت يمين أختها ويسار",238,"ر",1,0],["أو فقل ما شئت إني","عنك مشغول بقبري",239,"ر",2,0],["أو فتدارك عرضها منعماً","بعرض تلك القطعة الداليه",240,"ل",3,0],["أَو فائتٍ يوماً وقَد بلغَ المَدا","لَهَواتِ ذاك الفاغِرِ الفَرَّاسِ",241,"س",1,0],["أَوفى بِيَ الحِلمُ وَاِقتادَ النُهى طَلَقاً","شَأوى وَعِفتُ الصِبا مِن غَيرِ تَفنيدِ",242,"د",1,0],["أو في الوصال مكانة مخصوصة","إلا ومنزلتي أعز وأقرب",243,"ب",1,0],["أوفى وأكرمُ من يسامرنا","أقسى عدوٍّ طبعُهُ سمْحُ",244,"ح",1,0],["أَو فِضَّةٌ أَو ذَهَبٌ كِبريتُ","مِنهُم وَمِن خَيلٍ لَها صَتيتُ",245,"ت",1,0],["أوفَى وزادَ على القديمِ حديثُهُ","كصناعةِ التَخْميسِ للشُعراءِ",246,"ا",2,0],["أَوْ فِي عَلَى خُضْرِ الغُصُوْنِ فَأَصْبَحَتْ","كَالدُّرِّ فِي قُضُبِ الزَّبَرْجَدِ يُسْلَكُ",247,"ك",1,0],["أَو فَاِحمِلوا بَعضَ الَّذي هُوَ حامِلٌ","لِيَرُدَّكُم مِنهُ يَلَملَمُ قَدرَسا",248,"س",2,0],["أَوفى عَلى مَعرَكِ الأَبطالِ مُحتَسِباً","لَيثُ شِعاراهُ تَهليلٌ وَتَسبيحُ",249,"ح",1,0],["أَوْفَاتَه التِّيجَانُ إِنَّ برأْيِه","تَرْوِي الممالكُ عن ذوي التيجان",250,"ن",1,0],["أَوْ في الغمامِ لكان يُمْ","طِرُهُمْ بساحَتِكَ الغمامُ",251,"م",1,0],["أَوْ فأَحضرني بعيني","كَ فقد عُدْتُ خيالا",252,"ل",2,0],["أَوْ فإِنِّي قد تَسيَّبْ","تُ وقَطَّعْتُ الحبالا",252,"ل",2,0]]}