{"poems":[[57,"قلت غداة السبت إذا قيل لي","https://www.aldiwan.net/poem26033.html","السريع"],[228,"نام إلا الهوى فأهلك ناموا","https://www.aldiwan.net/poem39722.html","الخفيف"],[354,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[440,"شكوت بالحب إلى ظالمي","https://www.aldiwan.net/poem25680.html","السريع"],[543,"أنت ماذا دهاك قل لي حتى","https://www.aldiwan.net/poem48307.html","عموديه"],[572,"واحربا منك ومن","https://www.aldiwan.net/poem69733.html","مجزوء الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63952","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29312","الخفيف"],[5324,"قلت غني.","https://www.poetsgate.com/ViewPoem.aspx?id=215111",""]],"verses":[["قُلتُ غَداةَ السَبتِ إِذ قيلَ لي","إِنَّ الَّتي أَحبَبتَها شاكِيَه",0,"ي",2,1],["قُلتِ غَرِّق عَينَيكَ فيَّ فَغَرَّق","تُ وَعينٌ جوعٌ وَعينٌ أُوامُ",1,"م",1,0],["قُلتُ غَيباً لَكَ كُلٌّ شَهِدوا","قالَ باغٍ شاهِدُ الغَيبِ لِدَي",2,"ي",1,0],["قُلْتُ غَرامٌ ثابِتٌ قالَ لي","إِقْرَأْ عَلَيْهِ قُلْ هُوَ اللهُ",3,"ه",1,0],["قُلتُ غَابَ الرقيبُ يا كلَّ سُؤلي","قالَ يا حسنَ غيبةِ الرُّقبَاء",4,"ا",2,0],["قُلتَ غداً أُنْجِزُهُ","والموتُ مِنْ دُونِ غَدِكْ",5,"ك",1,0],["قلتَ غيدٌ بَرَزنَ في يوم عيدٍ","بين لُبْسَي مُعَصفَرْ وبياض",6,"ض",1,0],["قُلتُ غَنّي فَفي غَنائِكِ لَحنٌ","سَوفَ تَصغي إِلى صَداهُ السَماءُ",7,"ا",2,0],["قلتُ غنّي..قالت البسمةُ منّي","الفُ موالٍ... ولحنٍ وقصيدة",8,"ه",1,1]]}