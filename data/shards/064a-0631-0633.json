{"poems":[[88,"دمعة من دموع عهد الشباب","https://www.aldiwan.net/poem10372.html","الخفيف"],[53,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[87,"كل يوم مهرجان كللوا","https://www.aldiwan.net/poem62933.html","الرمل"],[64,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[82,"أصبحت جذلان طيب العربه","https://www.aldiwan.net/poem31562.html","المنسرح"],[107,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[107,"هو مرتمى الأبطال مالك دونه","https://www.aldiwan.net/poem44209.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141956","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54246","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54328","الرمل"],[101,"بالأحمرِ فقَط","https://www.poetsgate.com/ViewPoem.aspx?id=16902",""],[101,"بالأحمر فقط","https://www.poetsgate.com/ViewPoem.aspx?id=14387",""],[124,"غشى الأرض في شباب الزمان","https://www.aldiwan.net/poem49332.html","الخفيف"],[168,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[407,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[420,"بلغ الشوق لعمري ما أراد","https://www.aldiwan.net/poem53890.html","الرمل"],[503,"أهلا بليلى قد جلت هلالها","https://www.aldiwan.net/poem37710.html","الرجز"]],"verses":[["يُرسِلُ النُكتَةَ الطَريفَةَ تَمشي","في رَقيقِ الشُعورِ مَشيَ الشَرابِ",0,"ب",1,0],["يرسمُ للعُرْجِ ما يقوّمُهُمْ","تقويمَ كَفّ المقوّم الزُّلَمَا",1,"م",2,0],["يُرسِلُ اللَهُ بِهِ الرُسلَ عَلى","فَتَراتٍ مِن ظُهورٍ وَخَفاء",2,"ا",2,0],["يرسُفْنَ في قيدِ الكَلالِ كأنما","حركاتُهنَّ وقد جَهِدنَ سكونُ",3,"ن",1,0],["يرسلُ عن منخريه من فمِهِ","ريحاً لها نغمةٌ من القصَبَه",4,"ب",2,0],["يُرسِلُ الطرفَ ويَمشِي نحوها","مِشيةَ المُرتابِ في رِفقٍ ولينْ",5,"ن",1,0],["يرسو وأهوالُ الوقائعِ عُصَّفٌ","تذرو الفوارسَ والمنايا وُثَّب",6,"ب",1,0],["يرسل الفكرة النقية عذرا","ء ويرخى الضحى عليها إزارا",7,"ر",2,0],["يُرسِلُ العينَ فلا يلقَى سوى","لُججٍ خُضْرٍ دميماتٍ شِحاح",8,"ح",1,0],["يُرْسِلُ الطَّيْرُ في مَداه نَشِيداً","مُوْصِليَّ الأدَاءِ والنَّبَراتِ",9,"ت",1,0],["يُرسل الأشعارَ حمراء اللّظى","والأغاريدَ صفاءً وليانا",10,"ن",2,0],["يُرسل الصيحةَ بالحق كما","يُرسل الناعي إلى اللّه الأذانا",10,"ن",2,0],["يرسم أسماكا من ذهب","ونساء .. من قصب السكر",11,"ر",1,0],["يرسم طاحونا ، وحصانا",".. يرسم طاووسا يتبختر",11,"ر",1,0],["يرسم عصفورا من نار","مشتعل الريش ، ولا يحذر",11,"ر",1,0],["يرسم بالورد وبالياقوت","ويترك جرحا في الدفتر",11,"ر",1,0],["يرسم عصفورا من نار","مشتغل الريش ولا يحذر",12,"ر",1,0],["يرسل الصوت ضاجعاً فيميد السا","معوه تمايد النشوان",13,"ن",1,0],["يَرسُبنَ في بَحرِ الدُجى وَبِالضحى","يَطفونَ في الآلِ إِذا الآلُ طَفا",14,"ا",1,0],["يرسل في الذم له أمثالا","محبراً في هجوه المقالا",15,"ل",2,0],["يُرسِلُ الوَجْدَ إلى أجفانه","رُسُلَ الأدمع مثنى وفرادى",16,"د",2,0],["يرسم فكر الصب في خيالها","صار وطيب عيشها خبالها",17,"ل",3,0]]}