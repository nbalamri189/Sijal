028","الرجز"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125937","الرمل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136900",""],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126337","السريع"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81250","المجتث"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136538",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83122","الخفيف"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147296","الخفيف"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147287","الرمل"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124652","السريع"],[4702,"اشتكي لوسادتي دنياي واسمعها تنوح","https://www.poetsgate.com/ViewPoem.aspx?id=155113",""],[4767,"اغضبي","https://www.poetsgate.com/ViewPoem.aspx?id=178809",""],[4767,"السيرة العظيمة","https://www.poetsgate.com/ViewPoem.aspx?id=204762",""],[4778,"ليت هذا العام قد سنحا","https://www.poetsgate.com/ViewPoem.aspx?id=208690",""],[4929,"المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=199256",""],[4929,"لصوص في منعطف التأريخ","https://www.poetsgate.com/ViewPoem.aspx?id=199532",""],[4988,"فوح الألم","https://www.poetsgate.com/ViewPoem.aspx?id=180846",""],[4988,"فوح الألم","https://www.poetsgate.com/ViewPoem.aspx?id=182957",""],[5106,"الطَّيَِبُوْنَ .. شَرِبْنَا المِسْكَ وَالصَ","https://www.poetsgate.com/ViewPoem.aspx?id=148667",""],[5111,"راحِلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212316",""],[5155,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=176566",""],[5183,"أم هابيل","https://www.poetsgate.com/ViewPoem.aspx?id=186487",""],[5183,"الدهر الفظ","https://www.poetsgate.com/ViewPoem.aspx?id=180206",""],[5183,"النافقاء","https://www.poetsgate.com/ViewPoem.aspx?id=186606",""],[5281,"علِّميني","https://www.poetsgate.com/ViewPoem.aspx?id=199316",""],[5351,"ألا تتذكر","https://www.poetsgate.com/ViewPoem.aspx?id=202241",""],[5431,"دجلة الحب-للعراق الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=198264",""],[5434,"رجتني الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=37621",""],[5573,"لوبنيتي مابنيتي يا إرم ذات العماد","https://www.poetsgate.com/ViewPoem.aspx?id=200077",""],[5573,"لاهبت الريح بقلوب الهواويه","https://www.poetsgate.com/ViewPoem.aspx?id=200306",""],[5573,"جمة البير","https://www.poetsgate.com/ViewPoem.aspx?id=200345",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5736,"مرار","https://www.poetsgate.com/ViewPoem.aspx?id=208181",""],[5747,"منار","https://www.poetsgate.com/ViewPoem.aspx?id=61607",""],[5830,"طَيْفٌ وَ وَعْدٌ وَ أَمَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=200906",""],[5879,"السودان","https://www.poetsgate.com/ViewPoem.aspx?id=215936",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[6160,"على نَوافِذِ الغَيبِ ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87103&r=&rc=20",""],[6171,"بيت شعري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86322&r=&rc=0",""],[6268,"إضاءة في خيمة الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82915&r=&rc=1",""],[6300,"عالمي وكفُّ المنجنيق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82871&r=&rc=42",""],[5190,"إشارة حمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85037&r=&rc=112",""]],"verses":[["يُرسِلُ النُكتَةَ الطَريفَةَ تَمشي","في رَقيقِ الشُعورِ مَشيَ الشَرابِ",0,"ب",1,0],["يرسمُ للعُرْجِ ما يقوّمُهُمْ","تقويمَ كَفّ المقوّم الزُّلَمَا",1,"م",2,0],["يُرسِلُ اللَهُ بِهِ الرُسلَ عَلى","فَتَراتٍ مِن ظُهورٍ وَخَفاء",2,"ا",2,0],["يرسُفْنَ في قيدِ الكَلالِ كأنما","حركاتُهنَّ وقد جَهِدنَ سكونُ",3,"ن",1,0],["يرسلُ عن منخريه من فمِهِ","ريحاً لها نغمةٌ من القصَبَه",4,"ب",2,0],["يُرسِلُ الطرفَ ويَمشِي نحوها","مِشيةَ المُرتابِ في رِفقٍ ولينْ",5,"ن",1,0],["يرسو وأهوالُ الوقائعِ عُصَّفٌ","تذرو الفوارسَ والمنايا وُثَّب",6,"ب",1,0],["يرسل الفكرة النقية عذرا","ء ويرخى الضحى عليها إزارا",7,"ر",2,0],["يُرسِلُ العينَ فلا يلقَى سوى","لُججٍ خُضْرٍ دميماتٍ شِحاح",8,"ح",1,0],["يُرْسِلُ الطَّيْرُ في مَداه نَشِيداً","مُوْصِليَّ الأدَاءِ والنَّبَراتِ",9,"ت",1,0],["يُرسل الأشعارَ حمراء اللّظى","والأغاريدَ صفاءً وليانا",10,"ن",2,0],["يُرسل الصيحةَ بالحق كما","يُرسل الناعي إلى اللّه الأذانا",10,"ن",2,0],["يرسم أسماكا من ذهب","ونساء .. من قصب السكر",11,"ر",1,0],["يرسم طاحونا ، وحصانا",".. يرسم طاووسا يتبختر",11,"ر",1,0],["يرسم عصفورا من نار","مشتعل الريش ، ولا يحذر",11,"ر",1,0],["يرسم بالورد وبالياقوت","ويترك جرحا في الدفتر",11,"ر",1,0],["يرسم عصفورا من نار","مشتغل الريش ولا يحذر",12,"ر",1,0],["يرسل الصوت ضاجعاً فيميد السا","معوه تمايد النشوان",13,"ن",1,0],["يَرسُبنَ في بَحرِ الدُجى وَبِالضحى","يَطفونَ في الآلِ إِذا الآلُ طَفا",14,"ا",1,0],["يرسل في الذم له أمثالا","محبراً في هجوه المقالا",15,"ل",2,0],["يُرسِلُ الوَجْدَ إلى أجفانه","رُسُلَ الأدمع مثنى وفرادى",16,"د",2,0],["يرسم فكر الصب في خيالها","صار وطيب عيشها خبالها",17,"ل",3,0],["يُرسل اللحظة سَهماً نافِذا","وَإِذا اِستاءَ فَسَيفاً مُرهفا",18,"ا",1,0],["يرسل الماءَ فوق جرداء مَيتٍ","فيردُّ الحياةَ للوديانِ",19,"ن",1,0],["يُرسِلُ الغيثَ هاطلا في الروابي","فتعجُّ الأنهارُ بالفيضانِ",19,"ن",1,0],["يرسل البحر علينا ريحه","ونداه كل صبح وعشى",20,"ش",2,0],["يرسل النور لنا من ذهنه","حبذا النور الذي منه انجلى",21,"ل",2,0],["يرسم فوق المياه ظلّا","مضطرباً عابس الوراء",22,"ا",2,0],["يُرسَم على كُلِّ إسطِرلابِ مُجتَنِبٍ","في خَنِّ عَقرَبِكُم ما بَينَ قَوسَينِ",23,"ن",1,0],["يرسبُ فى النَّقعِ ويطفو به","كأنهُ الغوَّاص فى الخِضرم",24,"م",1,0],["يَرسمُ الجلا","كلّما رسم",25,"م",1,0],["يرسخُ في الذهن وليس يُمحا","جرِّبه بالتقسيم واقبل نصحا",26,"ح",2,0],["يرسل الرحمة تنفى","قسوة الشوق القديم",27,"م",1,0],["يرسل السجع عند منبثق الفجر","كهمس النسيم في اسحاره",28,"ر",2,0],["يرسم من كيوانَ خطَّا الى","يوحى بلا نفس ولا مرسم",29,"م",1,0],["يُرسي وَيُقلع وَالشَط","هادئ مُستَقر",30,"ر",1,0],["يرسلُ اللحظَ ثم يلفتُ جيداً","شِيمة الظَبي نافراً في زَرود",31,"د",1,0],["يُرسِلُ النُورَ في عُيونِ الخَفافي","شِ فَتَأبى العُيونُ إلّا احتجابَه",32,"ب",2,0],["يرسل الطيب فالرياحين تشدو","إننا اليوم قد هجرنا الذبولا",33,"ل",2,0],["يرسم الزهر بأطياب الكلمْ","محبك السبك بهي منتظمْ",34,"م",1,1],["يرسل فوق الخد ليل جعده","اذا بدا الصبح حذار الرقبا",35,"ب",2,0],["يرسم اوجاعي على قتل الأمل والليل لوح","مضفي استاره ويبني في ظلامه له ضريح",36,"ح",1,0],["يرسل الْمَوت إلى مَن شاء مِن","مَن لغير الحق لَم ينتسب",37,"ب",1,0],["يرسلُ النورَ ما دجا ليلُ عقلٍ","جاثمٍ لا يرى مِن الحق شيَّا",38,"ي",2,0],["يرسم الآمال باسمة","إن أطاع الدهر أو جمحا",39,"ح",2,0],["يُرْسِي المفاهيمَ والأفهامَ في غسقٍ","فيبزغُ الفهمُ كالأفلاقِ إفصاحَا",40,"ح",2,0],["يُرْسون في التأريخ دورًا لهم","بالقتل والإجرام والقلقله",41,"ل",2,0],["يرسم حياته بيت وافراح ويضمّ","احلام عمره والأماني تشااابه",42,"ب",2,0],["يرسم حياته بيت وافراح ويضمّ","احلام عمره والأماني تشابه",43,"ب",2,0],["يُرْسِي السَّمَاحَة َ وَالأَخْلاقَ فِي دَأَبٍ","وَيَذْرَعُ الأَرضَ بالإِحسَانِ مُنتَصِرا",44,"ر",2,0],["يُرْسِلُ الآهَاتِ وَجْدًا","فِيْ لَظَى دَاوودَ يَشْجُو",45,"و",1,0],["يرسم الروض لجة من فتون","موجها السحر والشذى والضياء",46,"ا",2,0],["يرسم الشرق حوله أحرف النو","ر وتتلو آي السطور النساء",47,"ا",2,0],["يرسل النظرة تيها","ويثنيها جُحوظا",48,"ظ",2,0],["يرسل الغدر تحت بادرة الذع","ر وسيف الظلال بادي العداء",49,"ا",2,0],["يُرسِلُ الآهَاتِ لَحنًا","لم تَمُتْ إلاَّ لِتُخْلَق",50,"ق",1,0],["يرسخ في أرض عشقي قصوراً","بذاخاً لحضرة قلبٍ مظفرْ",51,"ر",1,0],["يرسل البرق ومضه في مرايا","نازفات مقعرات الإخاء",52,"ا",2,0],["يرسي كما مينا البواخر على الموج","ومنين ماصك البحر يرتكيله",53,"ل",2,0],["يرسل سهوم الدعاوي لانزف فيه الفؤاد","يشتكي قو المكيده عند كيد الضالمين",54,"ن",1,0],["يرسل بها الشوق من مشتاق برقيه","تسقيه الآمال في لقياه وأسقاها",55,"ا",3,0],["يرسل شواهيبه على النجم ويثير","درب المعاني ويتحدى المجره",56,"ر",2,1],["يرسل اللحظ ناطقاً بكلامٍ","يذر القلب والشغاف كِلاما",57,"م",2,0],["يرسم الحرف في دفاتر احلا","مي وينساه إن لهى أو ناما",57,"م",2,0],["يرسو المرارُ على ثغري وأجرعهُ","فإن جرى ذكرهمْ تحلو به شفتي",58,"ي",1,1],["يرسم على صمتي ملامح دليلي","يستخدم ../ الوانه من الليل والضيّ",59,"ي",1,0],["يُرْسِلُ البُشْرَى تُنَاجِي مُهْجَتِي","يَغْسِلُ الرُّوحَ بِحُبٍّ مُنْهَمِرْ",60,"ر",1,0],["يُرسِّمُ في مدى الأيام موقعَه","ويحفظُ النّيلَ في الأزمانِ والحقبِ",61,"ب",1,0],["يَرسم فُنون محبكات القَوافي","مَرسولة تَهدي الناس فَهام",62,"م",1,0],["يَرسم قَوافي مِن ضَميري جَنيتها","جَني الطَرد مِن زَهر شمخ جبالها",63,"ل",3,0],["يَرسم على صَرف الزَمان الَّذي غَدر","فينا وَدَعانا كُل ناس بِحال",64,"ل",1,0],["يرسُمُ الحتفُ للرجالِ طريقًا","بيدَ أنَّ الشهيدَ يرسُمُ حَتَفهْ",65,"ف",2,0],["يرسم السحر على أنغامه","وعلى أنغامه أقتات سحره",66,"ر",2,0],["يَرسمُ الصبحَ على مِحْرَاثِهِ","ويُوَشِّي بالحواديت مساءه",67,"ا",3,0],["يرسمُ الجرحَ على جوعي شفاها","ترْشُفُ النار لتوليد الحريقْ",68,"ق",1,0],["يُرسِِي شِرَاعِيَ فَوقَ شَاطِئِ أَمسِِهَا","لِيَتُوهَ .. بَعدَ إِيابِهِ .. البَحَّارُ",69,"ر",1,0]]}