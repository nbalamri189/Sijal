[4767,"رجب الأصب","https://www.poetsgate.com/ViewPoem.aspx?id=199714",""],[5136,"يا بروحي المدلل البتاه","https://www.poetsgate.com/ViewPoem.aspx?id=121772",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5186,"طاب يا نشء في نهاك الثناء","https://www.poetsgate.com/ViewPoem.aspx?id=156455",""],[5198,"سحابة جفافي","https://www.poetsgate.com/ViewPoem.aspx?id=135530",""],[5376,"طار صقر في السما ثم وقعْ","https://www.poetsgate.com/ViewPoem.aspx?id=191734",""],[5431,"يكاد يُضيئ...","https://www.poetsgate.com/ViewPoem.aspx?id=214558",""],[5790,"يا عجبا للمرء مع علمه","https://www.poetsgate.com/ViewPoem.aspx?id=111973",""],[5956,"قممُ الوعي","https://www.poetsgate.com/ViewPoem.aspx?id=185610",""],[5961,"اضرب عن الناس","https://www.poetsgate.com/ViewPoem.aspx?id=199763",""],[4442,"أهوت به علته فانتدب","https://www.poetsgate.com/ViewPoem.aspx?id=171003",""],[4442,"لم يمت من يعيش في جناته","https://www.poetsgate.com/ViewPoem.aspx?id=171233",""],[4442,"آبر لم يزل يشق ويرفو","https://www.poetsgate.com/ViewPoem.aspx?id=170997",""],[6115,"حييت ياشاعر يثمن كلامه","https://www.poetsgate.com/ViewPoem.aspx?id=196487",""],[6144,"عزرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=21837",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6198,"عرس الطبيعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79233&r=&rc=7",""],[572,"الحمدُ للهِ قَدْ وَجَدْتُ أَخاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9238&r=&rc=95",""],[572,"جُدْلِي ببر كارِكَ الذي صَنَعَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9167&r=&rc=24",""]],"verses":[["يَنظُرُ الدَهرَ بَعدَ يَومِكَ وَالنا","سَ بِعَينٍ وَحشِيَّةِ الإِنسانِ",0,"ن",1,0],["يَنظُرُ الدُنيا بَعَينَي ناهِضٍ","مَطَرٌ يَنفُضُ أَنداءَ الطِلالِ",1,"ل",1,0],["يَنظُرُ مَولاها إِلى وَجهِها","فَقَلَّما يَهتَمُّ مَولاها",2,"ا",3,0],["يَنْظُرُ فِي الْمِرْآةِ مِنْ وَجْههِ","بَيْنَ مَوَالِيهِ وَأَحْزَابِهِ",3,"ب",2,0],["يَنْظُرُ الشَّرْقُ مِنْ قَصِيِّ النَّوَاحِي","كَيْفَ تَسْتَقْبِلونَ عَصْرَ الفَلاحِ",4,"ح",1,0],["يُنظم الدرُّ في السلوك وتأبى","عزةُ الدرّ نظمهُ في الحبالِ",5,"ل",1,0],["ينظم الأكمهُ القلائد فيه","ويرى الذرَّ في الظلامِ البهيم",6,"م",1,0],["يَنظُرنَ مِن خَلَلِ السُتورِ إِذا بَدا","نَظَرَ الهِجانِ إِلى الفَنيقِ المُصعَبِ",7,"ب",1,0],["يَنظُرنَ عَن كَثَبٍ إِلَيهِ خِلسَةً","نَظَرَ المِلاحِ إِلى الغَريرِ الأَمرَدِ",8,"د",1,0],["ينظر السيل وهو ضخم مخيف","يتنزى كأنه عفريت",9,"ت",1,0],["يَنظُرُ في دَعواهُما بِالدِقَّه","عَساهُ يُعطي الحَقَّ مُستَحِقَّه",10,"ه",1,0],["يَنْظُرْنَ مِنْ خَلَلِ النِّقابِ ومِنْ","تَحْتِ النِّقَابِ ضَواحِكٌ فُلْجُ",11,"ج",1,0],["يَنظُرنَ مِن مُقَلٍ أَدمى أَحِجَّتَها","قَرعُ الفَوارِسِ بِالعَسّالَةِ الذُبُلِ",12,"ل",1,0],["يَنظُمُ الدُرُّ في بُطونِ القَراطي","سِ كَنَظمِ النَظّامِ دُرَّ العُقودِ",13,"د",1,0],["يَنظِمُ المَجدَ مِثلَ ما تَنظِمُ العِق","دَ يَدُ الصانِعِ الصَناعِ الرَقيقِ",14,"ق",1,0],["يُنظَمُ الطَّعنُ على أبطالِهِ","وعُقودُ الهامِ فيه تنتشِر",15,"ر",1,0],["يَنظُرُ فُرسانُهُم أَمرَ الرَئيسِ وَقَد","شَدَّ السُروجَ عَلى أَثباجِها الحُزُمُ",16,"م",1,0],["ينظرُ الأسوارَ تهوِي حوله","فَيُقِيمُ السُّورَ من نارٍ ودَمْ",17,"م",1,0],["يَنظُرُ مَولاهُ إِلى وَجهِهِ","يا لَيتَني عَينٌ لِمَولاهُ",18,"ل",3,0],["يَنظُرنَ شَزراً إِلى مَن جاءَ عَن عُرُضٍ","بِأَوجُهٍ مُنكِراتِ الرِقِّ أَحرارِ",19,"ر",1,0],["ينظمن في سمط الحَرير أزاهراً","فينطنها بالرأس كالتيجان",20,"ن",1,0],["يَنْظُرُ مِنْ لِبْدِهِ لَدَيْنَا","بَحْرُ دَمٍ تَحْتَه يَسِيلُ",21,"ل",1,0],["يَنْظُرُ الْغَاشِمُ فِي أَقْسَامِهَا","حِذْقهُ رَسْماً وَمُوسِيقى وَشِعْرَا",22,"ر",2,0],["ينظِمُ الشعرَ وهو يلقى الأحادي","ثَ فيأتي بآبداتِ البيان",23,"ن",1,0],["ينظرون الفِرْدَوْسَ في ساحةِ الْحَرْ","بِ فيستعجلون أجْرَ الشَّهيدِ",24,"د",1,0],["ينظرُ في المرآة من وجهها","بين مواليهِ وأحزابِه",25,"ب",2,0],["يَنظِمُ المَجدَ مثلَ ما تَنظِمُ العِقْ","دَ يَدُ الصّائغِ الصَّنَاعِ الرّقيقِ",26,"ق",1,0],["ينظرون عن كثب إليه خلسة","نظر الملاح إلى الغرير الأمرد",27,"د",1,0],["يَنْظُرْنَ مِن خَلَلِ السُّتورِ، إذا بَدا","نظرَ الهجانِ إلى الفينقِ المصعبِ",28,"ب",1,0],["ينظُرُ الصَبُّ إِليها كَلِفاً","حَسبُهُ من نَظرَةٍ بعضُ الوَطَر",29,"ر",1,0],["يَنْظُرُ مِنْكَ الأَنَامُ بَدْرَ دُجىً","وَصارِماً فَاتِكَ الغِرَارَيْنِ",30,"ن",1,0],["يُنَظِّمُ أَوْراقَها دُرّهُ","وَيَنْثُرُ مِنْها الَّذي لا يُطِيقُ",31,"ق",1,0],["ينظّمُ نثرَ الطَّعن في وجه طاعنٍ","وينثرُ نظم الضَّرب في نحر ضاربِ",32,"ب",1,0],["ينظّفون طريق السابلين ولا","يرون في طرُق الدنيا المساكينا",33,"ن",2,0],["ينظرن مني قيصراً في قصره","ويخفنَ من همي عزيمةَ تبَّعِ",34,"ع",1,0],["ينظِم فيها ماؤها لؤلؤاً","كأنّه نَظمُ ثغُورِ القِيان",35,"ن",1,0],["يَنظُرُ مِن طَعنَتِهِ ثانِياً","وَراءها بِالرُمحِ مَطعونا",36,"ن",2,0],["ينظمُ شعراً كالخرا خطهُ","مشعث الأحرف مستكره",37,"ه",1,1],["ينظر الرحمن يشهده","ويجاور خاتم الرسل",38,"ل",1,0],["يَنظمُ الدرّ إِذا ما اِبتَسما","ثمّ يُلقيهِ بلفظٍ أنفسِ",39,"س",1,0],["يَنظرُ البحرُ لَنا مُحتَشِما","فَيرى بحرَ الندى في المجلسِ",40,"س",1,0],["ينظرن نظرات سدادا ولا","يغضضن الا بعد رمي القسي",41,"س",2,0],["يَنظّم أَنفاس التباغ وَلَيته","يجنّبها مِن علّة الخرم وَالوَقصِ",42,"ص",1,1],["يَنظُرنَ وَخزاً في القُلوبِ وَتارَةً","غَمزاً وَراءَ الذَّاهبِ المُتَغافِلِ",43,"ل",1,0],["ينظر بين القوم من طَرفٍ خَفي","ويتبعُ الأهة بالتأفف",44,"ف",1,0],["ينظم المجد من مناقب علياه","بجيد الأنام عقداً فعقدا",45,"د",2,0],["ينظر النجم إلى عليائه","نظر المعجب بالطرف الكليل",46,"ل",1,0],["ينظم الدر في سلكٍ ويرسلهُ","شعراً يتيه على منظوم حسان",47,"ن",1,0],["ينظرُ نشّ المياهِ منثغِباً","وكان من قبلُ غيرَ منثغِبِ",48,"ب",1,0],["ينظِمُ الكعكَ فيه نظمَكَ للسلْ","كِ على لَبّةِ الفتاةِ الكعابِ",49,"ب",1,0],["ينظمنَ أبكارَ المعاني شُرَّدا","بيد الفصاحة في القوافي العُونِ",50,"ن",1,0],["ينظِّمون العلا اتصالاً","نظمَ الأنابيب في العوالي",51,"ل",2,0],["ينظرُ من أيامهِ دولةً","بقلم الأقدارِ لم تُكتَبِ",52,"ب",1,0],["ينظر الدنيا بعيني واجدٍ","كلَّ شيء فانياً إلاَّ الثنا",53,"ن",2,0],["يُنَظِّمُ وجداً كلَّ بِكرٍ رقيقةٍ","بحكمٍ على أهلِ القريضِ منفَّذِ",54,"ذ",1,0],["يَنظِمُ في الأسحَارِ","مِن شَعرِه الفَتَّانِ",55,"ن",1,0],["ينظر المحبوب من طاقته","ما لنا من طاقة في ذا الهُوَيّ",56,"ي",1,0],["يَنْظُرُ في الجُزْءِ والخطوطِ ولا","ينتقِدُ النُّطْقَ مثْلُهُ ناقِدْ",57,"د",1,0],["يُنْظَر منها إلى الصّوابِ فما","يزال منها الصوابُ مطلوبا",58,"ب",2,0],["ينظم الامر بالرأي السديد كما","قد نظم الري في مصر وسودان",59,"ن",1,0],["ينظمها بدرِّ الآي سراً","حباهُ به الموحدُ بالتعالي",60,"ل",2,0],["ينظر في فعل العبا","د والزمان القُلَّب",61,"ب",1,0],["يُنظِمُها في شأوِهِ","كأنها نَظْمُ سُمُط",62,"ط",1,0],["ينظرن من خِللَ السجو","ف وأين منهنَّ السجوف",63,"ف",1,0],["ينظرنَ من خَلَلِ السجوف جآذرا","ويمسن في ورق الشباب الناضرِ",64,"ر",1,0],["ينظم فيك المديح عضا","منضدا كانتظم يام درِ",65,"ر",1,0],["يَنظُر في الآفاق","تلفت المُشتاق",66,"ق",1,0],["ينظر في مرآتها ما خفي","من كل تروون عن فضله",67,"ل",2,0],["ينظر الأعداء في بحبوحة الحرب النزال","أشرعوا سمر العوالي والمواضي والنبال",68,"ل",1,0],["ينظم الشعر حاليا باللآلى","فعليه من القوافى الثناءُ",69,"ا",2,0],["ينظر إِلى تصويرها في قبره","ثعبان ينفث وَجهه في النار",70,"ر",1,0],["يَنظِمُ الحُجَّةَ السَنِيَّةَ في السَل","دِ مُقيماً وَالمُسنَدِ المَروِيِّ",71,"ي",1,0],["ينظرن أرؤس قتلاهن سائرةً","أمامها بينها السجاد مأسورا",72,"ر",2,0],["ينظُرُ البدر بَينَ بُرجٍ وبُرجٍ","هكذا البَدرُ دائبُ الدَّوَرَانِ",73,"ن",1,0],["يَنظُرُ الكامِنَ الخَفِيَّ وَما طا","رَ إِلى الجَوِّ فَاحتَساهُ الهَواءُ",74,"ا",2,0],["ينظر عن فاتك طرف ما عدا","مُهْجَةَ إنسان سَطا سنانه",75,"ه",1,0],["ينظرن عن لواحظ محمية","إذا سفكن للمحبين دما",76,"م",2,0],["ينظرون الأمر من سيدهم","لخيالٍ عندهم قد نجما",77,"م",2,0],["يَنظُرنَ مِن خَلَلِ الخُدورِ كَما","نَظَرَت دَوامِجُ أَيكَةٍ كُحلُ",78,"ل",1,0],["يَنظر الرُوس حَوله زاهِرات","تَتَثنى بِها الرِماح الميد",79,"د",1,0],["ينظر اللَه للقلوب اللواتي","قد صفت وأكملت جميل الصفات",80,"ت",1,0],["ينظر الراس فيبكي ثم يب","كي ليتامى عن بكاً لا تتسلى",81,"ل",2,0],["يُنَظِّمُ الاجتماعَ شَملٌ","نَظمَ الثُّرَيّا مَعَ الهلالِ",82,"ل",1,0],["ينظر الناس زروعاً مُطرت","وترى عيني جمال المطر",83,"ر",1,0],["ينظرني شزراً كما تنظرني","مصوّباً مثلك لي نبل الحدق",84,"ق",1,0],["ينظم الحمد في علاه ولكن","في الندى شمل وفره يتبدد",85,"د",1,0],["ينظر الناس صغاراً وهوَ في","اعين الناس صَغيرٌ لَم يَزل",86,"ل",1,0],["ينظَرُن أجساماً على الرمالِ","وأرؤُسا ترفعُ بالعوالي",87,"ي",1,0],["ينظر في المرآة قعرَ الحلَّهْ","سحنةَ بغلٍ وعليه حُلَّهْ",88,"ه",1,0],["يَنظرن إِن غفل المراقب خلسةً","عَن أَعين إِنسانها مزؤودُ",89,"د",1,0],["يَنْظُرُ في هِزَّةِ أَعْطَافِهِ","بمثلِ طَرْفِ الأسدِ الحارِدِ",90,"د",1,0],["ينظرن من طرفٍ خفي خشعاً","ابصارها لما اضيع ذمامها",91,"م",3,0],["ينظر الكون نظرة بازدراء","اذ تساوى مسوسه والسائس",92,"س",1,0],["ينظرن عن حدق الظباء سواحرا","فتخال في النظرات فتك أسود",93,"د",1,0],["ينظرن منه مفرجا لكروبها","لا زال يمسح عن مرائيها الصدا",94,"د",2,0],["ينظر بالبشر لوفر الذخر","وتحت سنديانةٍ قام الندل",95,"ل",1,0],["ينظر من خلف حجاب الفرد","خل الطبيب واسأل المجربا",96,"ب",2,0],["يَنظُرُ في أَوجُهِ الرِجالِ فَلا","يَعرَفُ شَيئاً فَالوَجهُ مُلتَمَعُ",97,"ع",1,0],["ينظر الوالهات عترة طه","من ظماً تندب الشراب الشرابا",98,"ب",2,0],["ينظر القينة ذي عن شغف","وهو لم يدر بمن ينتظر",99,"ر",1,0],["ينظم اللوح بين سقي ورعي","لكتاب يروق في تدوينه",100,"ن",2,0],["ينظر العاقل الأمور فيأبى","أن يرى منه غير ما هو أولى",101,"ل",2,0],["ينظر عيب الناس طرا ولا","ينظر عيبا فيه مشهورا",102,"ر",2,1],["ينظرها قد اعجلت خيرها","له فلا ينظر في الآجل",103,"ل",1,0],["ينظم منها المزج سلكاً كأنه","إذا ما بدا في الكأس در منصف",104,"ف",1,0],["ينظر الناس كالسواد حشوداً","باهتٌ جمعها ويحتاج لونا",105,"ن",2,0],["ينظر إليك بعين رحمته التي","ما أشغلتها كثرةُ السُّؤَّال",106,"ل",1,0],["ينظر الله فضل حمره حمر الله","بها مسك طيبه أو براه",107,"ا",2,0],["ينظر شزراً فإذا ناظرته","ففته قطّب وجهاً ولوى",108,"ا",1,0],["ينظر الشمس والنهار نهار","فينادي هذي هي الظلماء",109,"ا",2,0],["ينظر بعين الكبر ويقول لاحووول","يجحد وعينه تعلن الإعترافي",110,"ف",2,0],["ينظر الأطيار تعلو حوله","إنه مثلهم (و) لا ما اقتنع",111,"ع",1,0],["يُنظّرُ كالفلاسفة اشتغالا","ويألوهم ضميرا وامتثالا",112,"ل",2,0],["ينظر في عين أخيه القذى","ولا يرى في عينه الساريه",113,"ه",1,0],["ينظر الحاسد في حقدٍ لشِعري","وهو لا يقرأ ماذا قد كَتبْتُ",114,"ت",1,0],["ينظرك ربك حالا ثم يوم غد","تفز مع الانبياء والرسل لله",115,"ل",2,0],["ينظر فيم ذهبت أيامه","وما اكتسى من عمل وما اكتسب",116,"ب",1,0],["ينظم الطرس من سطور اللئالي","فكأن الوسمي حبر دوانه",117,"ه",1,0],["ينظم اللوح بين سقي ورعي","ككتاب يروق في تدونه",118,"ن",2,0],["ينظم بيوتٍ بالجزاله جديده","شاعر على الجزلات علّق وسامه",119,"ه",1,0],["ينظر في منجم عميق","فيه فحم بلجيكي",120,"ي",1,0],["يَنظر جمالا ما خَفته البَراقع","وَلا زانَها مثل المِلاح وشام",121,"م",1,0],["ينظم عَلى صَرف الزَمان الَّذي غَدر","فينا وَدَعانا كُل ناس بشان",122,"ن",1,0],["ينظُمْنَ أفراحَ الربيع... قلائداً","حباتُهنَّ... لآلئُ... وجمانُ",123,"ن",1,0],["ينظُرُ في الجدِّ والخُطُوطِ ولاَ","ينتقِدُ النّطقَ مثلَهُ نَاقِدْ",124,"د",1,0],["ينظرُ منها إلى الصوابِ بِهِ","فَمَا يزالُ الصّوابُ مَطْلوبا",125,"ب",2,0]]}