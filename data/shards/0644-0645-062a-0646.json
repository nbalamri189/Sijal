"عاشوا","https://www.poetsgate.com/ViewPoem.aspx?id=211568",""],[5956,"الأغلَيان تُوُفِّيا وفتاهما..","https://www.poetsgate.com/ViewPoem.aspx?id=183597",""],[5956,"كم من نتائج حققت لقيانا","https://www.poetsgate.com/ViewPoem.aspx?id=192239",""],[5956,"الله علّمنا الكثير لنهتدى","https://www.poetsgate.com/ViewPoem.aspx?id=192648",""],[6019,"عتاب على هامش الشوق ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=53042",""],[6031,"حَسَّنَتْ غَيَّهُ لَهُ وفَسَادَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=46340",""],[6147,"لغة الضاد في شهر العسل/الجزء 2 الرحلة الجغرافية","https://www.poetsgate.com/ViewPoem.aspx?id=153630",""],[6239,"المؤتلفة/ المختلفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76056&r=&rc=107",""],[463,"في الظباء الغادين أمسِ غزالُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60186&r=&rc=242",""],[6256,"أقفر الساح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65925&r=&rc=13",""],[6260,"جيش الحبائب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68361&r=&rc=53",""],[6349,"من قبو ذاكرتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85446&r=&rc=0",""]],"verses":[["لَم تُنسِنا ذِكرَهُ الدُنيا وَإِن نَسَجَت","لِلراحِلينَ مِنَ النِسيانِ أَكفانا",0,"ن",2,0],["لم تُنبِت الأرضُ كابن العاصِ داهيةً","يَرمي الخُطوبَ بَرأيٍ ليسَ يُخطِيها",1,"ي",3,0],["لَم تَنأَ عَنهُ وَإِن فارَقتَ شاطِئَهُ","وَقَد نَأَينا وَإِن كُنّا مُقيمينا",2,"ن",2,0],["لَم تَنبُ في يَومِ الهياجِ سُيوفُهُم","عَن مَضرِبٍ وَنَبَت عَنِ الأَغمادِ",3,"د",1,0],["لم تنقبض عنها يداك وقد","بسطت إليك تعوذا يدها",4,"د",3,0],["لَمْ تنْكِري عَنَتَ الرَّحِيْ","لِ وَعَيْشُكِ الرَّغِدِ الهَنِيّ",5,"ي",1,0],["لَمْ تَنْسَ مَا أَوْدَعْتَهُ فِيهَا","مِنْ نَغَمَاتِ طَيْرِ الجَنَانِ",6,"ن",1,0],["لم تُنْسِني الأَيامُ يومَ وداعِهِ","والركبُ قد أوفَى على الزوراءِ",7,"ا",2,0],["لَم تَنأَ عَنّا لَهُم قُلوبٌ","وَإِن نَأَت مِنهُمُ جُسومُ",8,"م",1,0],["لم تَنشُري قطُّ نائكاً وكذا","وجهُك حقاً يا نُشرةَ النشر",9,"ر",1,0],["لَم تُنصِفينا وَقَد كُنّا نُؤَمِّلُ أَن","لا تُنصِفينا لِهَذا لا نَرى عَجَبا",10,"ب",2,0],["لم تنلها باحتيالٍ","لا ولا مشيٍ رويْدِ",11,"د",1,0],["لم تنقُص الأيام من إيمانها","من سنَّة الأيام أن تتغيرا",12,"ر",2,0],["لم تنس ذلك كله","لم تنس جدّك أو أباك",13,"ك",1,0],["لَم تُنسِهِ الهِندُ العَزيزَةُ رِقَّةً","لِلشَرقِ أَو سَهَراً عَلى أَشيائِهِ",14,"ا",3,0],["لَم تَنعَ لِلأَحياءِ غَيرَ ذَخيرَةٍ","وَلَّت وَغَيرَ بَقِيَّةِ الكُبَراءِ",15,"ا",2,0],["لَم تَنزِلِ الشَمسُ ميزاناً وَلا صَعَدَت","في مُلكِها الضَخمِ عَرشاً مِثلَ وادينا",16,"ن",2,0],["لم تَنْجُ منهم إلّا مخَدَّرةٌ","دافعَ عنها الرِّعاثُ والقُلبُ",17,"ب",1,0],["لَم تَنَم عَن دُعائِهِم حينَ نادَوا","وَالقَنا قَد أَسالَ فيهِم قَناءَ",18,"ا",2,0],["لَم تُنكِرِ الخَرَزاتُ إِلفَ ذُؤابَةٍ","يَحتَلُّ في الخَزَرِ الذَوائِبَ وَالذُرى",19,"ر",2,0],["لَم تَنصَرِف عَنها النُفوسُ وَلَم تَزِغ","فيها القُلوبُ وَلَم تَزِلَّ الأَرجُلُ",20,"ل",1,0],["لُمتَني أَن رَمَيتُ في غَيرِ مَرمىً","وَعَزيزٌ عَلَيَّ تَضِيّعُ سَهمي",21,"م",2,0],["لم تَنْكَشِفْ عنها البَراقعُ لوعةً","إلا وأَلبسَها الحياءُ بَراقِعا",22,"ع",2,0],["لم تَنْضُ أثوابَ الصيِّامِ مُودّشعاً","حتى كساكَ الفِطْرُ ثَوبَ ثَوابِ",23,"ب",1,0],["لَم تَنتَفِع إِلّا بِفِعلٍ","صالِحٍ إِن كانَ عِندَك",24,"ك",1,0],["لَم تَنسَ نَفسُكَ يَومَها","إِلّا لِقِلَّةِ عَقلِها",25,"ل",3,0],["لَم تَنتَقِصني إِذ أَسَأتُ وَزِدتَني","حَتّى كَأَنَّ إِساءَتي إِحسانُ",26,"ن",1,1],["لم تُنصِفيني في مُعامَلَةِ الهوى","وأعزُّ شيءٍ في الدمى الإنصافُ",27,"ف",1,0],["لم تَنَمْ عِندَهُ الظُبا في جُفُونٍ","فَالهُدى بانتِباهِها ذو انتِصارِ",28,"ر",1,0],["لَم تَنتَقِض عُروَةٌ مِنهُ وَلا سَبَبٌ","لَكِنَّ أَمرَ بَني الآمالِ يَنتَقِضُ",29,"ض",1,0],["لِم تُنكِرينَ مَعَ الفِراقِ تَبَلُّدي","وَبَراعَةُ المُشتاقِ أَن يَتَبَلَّدا",30,"د",2,0],["لم تنصفيني أنتِ في جنةٍ","ومهجتي بعدَكِ في نارِ",31,"ر",1,0],["لم تَنْسَها والظلمُ مُنتصِرٌ بها","والعدل مُنهزمُ الفيالقِِ هاربُ",32,"ب",1,0],["لَم تُنصِفيهِ وَلا ذَكَرتِ عُهودَهُ","بَينَ الوُلوعِ الجَمِّ وَالهَيَمانِ",33,"ن",1,0],["لُمتَني يا مُسيءُ وَالذَنبُ ذَنبُك","وَيحَ نَفسي حَسيبُكَ اللَهُ رَبُّك",34,"ك",1,1],["لَم تَنظُرِ العَينُ إِلى مَنظَرٍ","في الحُسنِ وَالظَرفِ يُدانيها",35,"ي",3,0],["لَم تَنَم عَينُهُ وَلَم يَزَلِ الدَم","عُ نِظاماً يَستَنُّ فَوقَ التَريبِ",36,"ب",1,0],["لَم تَنَلها يَدي بِحَولي وَلَكِن","قُضِيَت لي وَهَل يُرَدُّ القَضاءُ",37,"ا",2,0],["لم تَنْصَدِع كَبِدِي عَلَيْكَ لِضَعْفها","لكِنَّها ذابَتْ فما تَتَصَدَّعُ",38,"ع",1,0],["لم تنزل الأطيارُ فيءَ ظلالها","أو تَبْنِ عُشّاً أو تَحُمْ بغناءِ",39,"ا",2,0],["لم تَنْسَ في نزْع الحياةِ الغرورْ","ضراعةً ترسمها للإلهْ",40,"ه",1,0],["لم تنأَ بغدادُ عن مصر ولا بَعُدَتْ","لبنانُ والمسجدُ الأقصى وشهباءُ",41,"ا",2,0],["لم تُنْصِفي غُذّيتِ أطيَبَ مَطْعَمٍ","وغِذاؤهُنّ الشَّتُّ والطُّبّاق",42,"ق",1,0],["لَمْ تَنْبُتِ الأَرْضُ إِلَّا بَعْدَمَا اخْتَمَرَتْ","أَقْطَارُهَا بِدَمِ الأَعْنَاقِ وَالْقُلَلِ",43,"ل",1,0],["لَمْ تَنَلْ مِنْهُمْ مَنَالاً فِرَقٌ","غَلَبُوا فِيهَا قُرُومَ الغُرَبَاءْ",44,"ا",2,0],["لَمْ تَنْزِلِ الأَديَانُ إِلاَّ هَادِياً","لِلعَالَمِينَ وَرَادِعاً وَمُثَقِّفَا",45,"ف",2,0],["لم تُنْصِتي وَمَشَيْتِ غَيْرَ مُجيبَةٍ","حَتَّى كأَنَّ حَديِثَها لِسِواكِ",46,"ك",1,0],["لم تُنصفوا يوم آوُيْتُم -بلا حذر-","شعبًا على النَّفْي والتشريد مفطورا",47,"ر",2,0],["لم تنتقل عبد شمس من نكارتها","دم الكبود على أنيابها القذر",48,"ر",1,0],["لم تنهل بالغيث ديمة","ولا راق من زهر الرياض مجوده",49,"د",2,0],["لم تنم عيني ولم يزل الدَّم","عُ نظَاماً يَسْتَنُّ فَوْقَ التَّريب",50,"ب",1,0],["لم تنكر الخرزات إلف ذؤابة","يحتل في الخرز الذوائب والذرى",51,"ر",2,0],["لم تنلهم يد المنيّة ظلما","ولدوا قبل أن يحين الأوان",52,"ن",1,0],["لم تنزل الشمس ميزانا ولا صعدت","فى ملكها الضخ عرشا مثل وادينا",53,"ن",2,0],["لم تُنْصفوا الأمم الضِعافَ ، ورَدَتُمُ","عذْب الحياة وأُرِدت غَسْاقها",54,"ق",3,0],["لم تنزل الأطيار فئ ظلالها،","أو تبن عشّا، أو تحم بالغناء",55,"ا",2,0],["لم تنظر العين الى غيركم","لولاح بدرا في سماواته",56,"ت",2,0],["لم تنتثر شهب السماء ولم يَطل","مرضٌ ولم يُبد الغراب نُعاقا",57,"ق",2,0],["لَم تَنفَتِق عَنهُ كَمائِمُ نورِهِ","في ظِلِّكَ المَمدودِ حَتّى أَينَعا",58,"ع",2,0],["لم تَنفرِدْ مصرٌ به عن غيرِها","سِيّانِ مصرٌ فيه والأَمْصار",59,"ر",