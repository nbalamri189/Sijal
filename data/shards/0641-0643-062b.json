{"poems":[[53,"كم ذميل إليكم ووجيف","https://www.aldiwan.net/poem29963.html","الخفيف"],[92,"راعها منه صمته ووجومه","https://www.aldiwan.net/poem38890.html","الخفيف"],[43,"أين أزمعت أيهذا الهمام","https://www.aldiwan.net/poem10141.html","الخفيف"],[45,"يا ابنة العامري عما قليل","https://www.aldiwan.net/poem65557.html","الخفيف"],[126,"ثلاث يحار العقل عند نزولها","https://www.aldiwan.net/poem50555.html","الطويل"],[126,"ثلاث هلاك المرء فيهما فخلها","https://www.aldiwan.net/poem50650.html","الطويل"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[413,"قد ذكرناكم على بعد المزار","https://www.aldiwan.net/poem53843.html","الرمل"],[456,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["فَكَثيرٌ إِلى الحُمولِ اِلتِفاتي","وَطَويلٌ عَلى الدِيارِ وُقوفي",0,"ف",2,0],["فكَثيرٌ عليكَ أن تحمِلَ الدُّن","يا وتمشي بوقْرِها لا تَريمُهْ",1,"م",2,0],["فَكَثيرٌ مِنَ الشُجاعِ التَوَقّي","وَكَثيرٌ مِنَ البَليغِ السَلامُ",2,"م",1,0],["فَكَثيرُ العَطاءِ غَيرُ كَثيرٍ","وَقَليلُ الثَناءِ غَيرُ قَليلِ",3,"ل",1,0],["فكثرةُ نومِ المرء ليلاً وغدوةً","وكثرته للراحِ مَع كثرةٍ للأكْلِ",4,"ل",1,0],["فكثرةُ وطْءِ للغواني وتخمة","وكثرةُ نومِ المرءِ في غُدواتِه",5,"ه",1,0],["فكثرةُ الدُعابَه","تذهبُ بالمَهابَه",6,"ه",1,0],["فكثيراً ما تمنّى قربكم","ذائبُ الدَّمع قليل الاصطبار",7,"ر",1,0],["فكثيرُ الجزاءِ منك قليلٌ","وقليلٌ من آخرين كثير",8,"ر",1,0],["فكثرت واجتمعت للدعوة","وكان بعضها لبعض قدوة",9,"ه",1,0]]}