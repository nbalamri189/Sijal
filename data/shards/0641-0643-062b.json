{"poems":[[55,"كم ذميل إليكم ووجيف","https://www.aldiwan.net/poem29963.html","الخفيف"],[94,"راعها منه صمته ووجومه","https://www.aldiwan.net/poem38890.html","الخفيف"],[45,"أين أزمعت أيهذا الهمام","https://www.aldiwan.net/poem10141.html","الخفيف"],[47,"يا ابنة العامري عما قليل","https://www.aldiwan.net/poem65557.html","الخفيف"],[132,"ثلاث يحار العقل عند نزولها","https://www.aldiwan.net/poem50555.html","الطويل"],[132,"ثلاث هلاك المرء فيهما فخلها","https://www.aldiwan.net/poem50650.html","الطويل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[422,"قد ذكرناكم على بعد المزار","https://www.aldiwan.net/poem53843.html","الرمل"],[463,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44607","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70836","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62461","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46539","الرجز"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88693","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100381","الخفيف"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[4337,"","https://poetry.dctabudhabi.ae/diwan/poem/114009","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83187","الرجز"],[5237,"حسامي ومنهاجي القويم وشرعتي","https://www.poetsgate.com/ViewPoem.aspx?id=113120",""],[5302,"يا عجولا","https://www.poetsgate.com/ViewPoem.aspx?id=201222",""],[5725,"هاك قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177424",""]],"verses":[["فَكَثيرٌ إِلى الحُمولِ اِلتِفاتي","وَطَويلٌ عَلى الدِيارِ وُقوفي",0,"ف",2,0],["فكَثيرٌ عليكَ أن تحمِلَ الدُّن","يا وتمشي بوقْرِها لا تَريمُهْ",1,"م",2,0],["فَكَثيرٌ مِنَ الشُجاعِ التَوَقّي","وَكَثيرٌ مِنَ البَليغِ السَلامُ",2,"م",1,0],["فَكَثيرُ العَطاءِ غَيرُ كَثيرٍ","وَقَليلُ الثَناءِ غَيرُ قَليلِ",3,"ل",1,0],["فكثرةُ نومِ المرء ليلاً وغدوةً","وكثرته للراحِ مَع كثرةٍ للأكْلِ",4,"ل",1,0],["فكثرةُ وطْءِ للغواني وتخمة","وكثرةُ نومِ المرءِ في غُدواتِه",5,"ه",1,0],["فكثرةُ الدُعابَه","تذهبُ بالمَهابَه",6,"ه",1,0],["فكثيراً ما تمنّى قربكم","ذائبُ الدَّمع قليل الاصطبار",7,"ر",1,0],["فكثيرُ الجزاءِ منك قليلٌ","وقليلٌ من آخرين كثير",8,"ر",1,0],["فكثرت واجتمعت للدعوة","وكان بعضها لبعض قدوة",9,"ه",1,0],["فَكَثيرُ البَغيضِ غَيرُ كَثيرٍ","وَقَليلُ الحَبيبِ غَيرُ قَليلِ",10,"ل",1,0],["فكُثر النوم يورث أه","لَه همّاً وبلْبالا",11,"ل",2,0],["فكثيف صفحك ساتري وطريق","فضلك ناصري وشريف ذاتك عامري",12,"ر",2,0],["فَكَثرَة البَطاله","ضَرّارة قَتاله",13,"ه",1,0],["فَكَثُرَت مِن بَعدِ نوحٍ عادُ","وَشاعَ مِنها العَيثُ وَالفَسادُ",14,"د",1,0],["فَكَثِيرَةٌ جِدًّا فَمَن يَكُ رَاغِباً","فِيهَا يَجِد فِيها هُدَى الحَيرَانِ",15,"ن",1,0],["فكَثير ممن تولى النصارى","بلغ القصد من فلوس الهنود",16,"د",1,0],["فكثير لدى الصبابة لقيا","دون ذي الرمث لو اراثو قليلا",17,"ل",2,0],["فكثمك العلم عمن يستحق له","ظلم وبذل لغير مثل ذاك نمي",18,"م",2,0],["فكثر العلف واحثث العنف به","واسقها بالفضل ماء زلل",19,"ل",1,0],["فَكَثرَةُ الإِخوانِ","أَمنٌ مِنَ الزَمانِ",20,"ن",1,0],["فكثره ذكر الشيء آية حبه","وحسب الفتى تشريفه بالمحبة",21,"ه",1,0],["فكثير بالشح يصبح صاعا","وقليل بالبذل يصبح طنا",22,"ن",2,0],["فكثيرٌ من اللقاء قليل","وقليلٌ من الجفاءِ جليلُ",23,"ل",1,0]]}