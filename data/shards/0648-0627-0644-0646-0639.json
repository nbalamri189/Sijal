{"poems":[[106,"","https://poetry.dctabudhabi.ae/diwan/poem/199476","المنسرح"],[119,"يا آل الرسول ويا طه","https://www.aldiwan.net/poem41955.html","مجزوء الكامل"],[287,"فك أسري طيف لعلوة أسرى","https://www.aldiwan.net/poem32769.html","الخفيف"],[367,"سر منقلبًا","https://www.aldiwan.net/poem11643.html","عموديه"],[457,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87203","البسيط"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146221","المجتث"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87320","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87331","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134025","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100743","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131241",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72517","الرمل"],[5174,"لغة الضاد ليلة الزفاف","https://www.poetsgate.com/ViewPoem.aspx?id=184937",""],[5385,"قوس المنون بسهم البين قدر رشقا","https://www.poetsgate.com/ViewPoem.aspx?id=144222",""],[5573,"النعش فوق الثريا له منصه","https://www.poetsgate.com/ViewPoem.aspx?id=206497",""],[5792,"يصير خير","https://www.poetsgate.com/ViewPoem.aspx?id=180358",""],[6038,"الاقصى","https://www.poetsgate.com/ViewPoem.aspx?id=27219",""],[6115,"حييت ياشاعر يثمن كلامه","https://www.poetsgate.com/ViewPoem.aspx?id=196487",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["والنعق في الأطلال كالغربان","لأنني أمجد الحياة",0,"ه",1,0],["والنعمة العظمى التي ال","جبار في الغيب اصطفاها",1,"ا",3,0],["وَالنُّعامى تَهُزُّ عِطفَ الخُزامى","بَينَ يُمنى مِنَ التَّثَنّي وَيُسرى",2,"ر",2,0],["والنَّعجَةُ تقتاتُ لحومً","والذِّئبُ حَشائشَ وعُشُوبا",3,"ب",2,0],["والنعامى بشذاها خفقت","وانجلت من وشيها في زبرج",4,"ج",1,0],["وَالنَعي تودي بِهِ حالاً صَوارمُه","في يَوم نحس بِهِ مَولاه يَأتيه",5,"ه",1,0],["وآل نعشٍ ركوعٌ","طوراً طوراً سجود",6,"د",1,0],["والنعت وصف تمم المتبوع به","طبقا وفي إعرابه بحسبه",7,"ه",1,0],["والنَّعشُ فيهم كلِّهم إحدى عَشَرَ","فغايةُ الفالِ هنا عندَ الورى",8,"ر",2,0],["والنَّعشُ ذُبَّانانِ قد شاعَ على","جزيرةِ العَنبَرِ مع كلِّ المَلا",8,"ل",2,0],["وَالنَّعشُ كُلٌّ ستَّةٌ بستَه","والجاهُ فيها عَشرَةٌ خُذ نَعتَه",9,"ه",1,0],["وَالنَّعش أَحَد عَشِر وَنِصفُ وَافِي","إن جِيتَ لِلبَاحَه فَذَاكَ كَافِي",10,"ي",1,0],["وَالنَّعيمَ وَحَمَلَةَ الاَرْكانِ","وَقْعَةٌ أَوْهَنَتْ بِسَبْعِ شِدادِ",11,"د",1,0],["والنعمة العظمى على الإنسان ان","يحظى برؤية صنعة الخلاق",12,"ق",1,0],["والنعل حاضرة اذا","عادت اليك العقرب",13,"ب",1,0],["والنعش في وسط الجموع تقله","مثل الشهاب به يحيط غمام",14,"م",1,0],["والنعامى قد أصرت يدها","من دجا صرة مسك أذفر",15,"ر",1,0],["والنعتُ مِن منعوته مستنْفَرٌ","متعقِّب خبرالنّوى عسّاسا",16,"س",2,0],["والنعش حفته اهل الله قاطبة","لما غدوت على الهامات منطلقا",17,"ق",2,0],["والنعش فوق الثريا له منصّه","نجم مابين المعلا والسواري",18,"ر",2,0],["والنعم فيه وفي صدك وعذروبيك","مافارق النور عتمه جابتك لمي",19,"م",2,0],["والنعم في باقي العرب وامة التكبير","اللي في توحيدها يا اقصى استقلالك",20,"ك",1,0],["والنعم وعلوم الوفاء من رصيده","وانا تهامي من ضواحي تهامه",21,"ه",1,0],["والنعيمَ المقيمَ والرَّغَدَ الدا","ئمَ فيها حِكراً على المُرّاقِ",22,"ق",1,0]]}