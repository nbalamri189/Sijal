{"poems":[[3,"يا أيها الملك الذي راحاته","https://www.aldiwan.net/poem213.html","الكامل"],[29,"حيوا الديار وأهلها بسلام","https://www.aldiwan.net/poem6005.html","الكامل"],[87,"هز اللواء بعزك الإسلام","https://www.aldiwan.net/poem63742.html","الكامل"],[45,"شغلي عن الربع أن أسائله","https://www.aldiwan.net/poem10614.html","المنسرح"],[396,"يا طالب السكنى بوادي الأحقاف","https://www.aldiwan.net/poem54551.html","عموديه"],[463,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101231","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123494","السلسلة"],[4934,"ماني بشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=32780",""],[5595,"ويبْسُطُ العَدْلَ عُنواناً لدولتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=177507",""],[5739,"أمواق الغمام ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127362",""]],"verses":[["المُظهِرُ الإِنصافَ في أَيّامِهِ","بِخِصالِهِ وَالعَدلَ في بُلدانِهِ",0,"ن",2,0],["المُظعِنينَ مِنَ الرَمادَةِ أَهلَها","بَعدَ التَمَكُّنِ في دِيارِ مُقامِ",1,"م",1,0],["المُظهِرينَ لِنورِ بَدرٍ بَعدَما","خيفَ المَحاقُ عَلَيهِ وَالإِظلامُ",2,"م",1,0],["المظهر العدل في رعيته","والمعتدى حلمه على نزقِهْ",3,"ق",2,0],["المظهرين الكبر والتعجراف","الظالمين بالفعل والتخواف",4,"ف",1,0],["ألمِّظُ نفسي عتبَكم وهو حنظلٌ","وأُورَدُ ما استَطْيَبْتُمُ وهو علقمُ",5,"م",1,0],["المظهر التوحيد من لولاه ما","كانت محاريب ولم يك منبر",6,"ر",1,0],["المظهر للدين والمبيد عداه","والملبس للملبسين ملبس احداد",7,"د",1,0],["المظاهر ماتفيدك من مواتر والعطور","مافي احلى من تواضع والتواضع للجواد",8,"د",1,0],["المُظلِماتُ دَياجيرٌ تطالعُنا","اذْ تحملُ الخَوْفَ أمْشَاجَاً بها الحَنقُ",9,"ق",1,0],["المظاهر ..! لو يغطيها الظلام.","واضح ٍ وجه الخديعه لو سحى.",10,"ح",2,0]]}