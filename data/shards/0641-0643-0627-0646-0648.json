{"poems":[[65,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[74,"كفاني المؤيد عتب الزمان","https://www.aldiwan.net/poem19390.html","المتقارب"],[53,"العين لا تنفك من نظر","https://www.aldiwan.net/poem62930.html","أحذ الكامل"],[87,"خطونا في الجهاد خطى فساحا","https://www.aldiwan.net/poem7108.html","الوافر"],[87,"قفي يا أخت يوشع خبرينا","https://www.aldiwan.net/poem63733.html","الوافر"],[45,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[46,"أجفان خوط البانة الأملود","https://www.aldiwan.net/poem30531.html","الكامل"],[71,"بأبي مجدرة محببة","https://www.aldiwan.net/poem29097.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19254","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43682","الوافر"],[92,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[90,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""],[132,"إذا ما بدا برق بنعمان لامع","https://www.aldiwan.net/poem50583.html","الطويل"],[136,"أراني القبض لم أر فيه عابا","https://www.aldiwan.net/poem54888.html","الطويل"],[164,"لصومك شهر الصوم يكسى من الفجر","https://www.aldiwan.net/poem59111.html","الطويل"],[189,"تأملت بحر النيل طولا وخلفه","https://www.aldiwan.net/poem14542.html","الطويل"],[189,"هذا الخليج فمرحبا بزمانه","https://www.aldiwan.net/poem14669.html","الكامل"],[190,"بلوت المسلمين بكل أرض","https://www.aldiwan.net/poem43946.html","الوافر"],[199,"أهم سرى أم عاد للعين عائر","https://www.aldiwan.net/poem54405.html","الطويل"],[199,"لمن رسم دار كالكتاب المنمنم","https://www.aldiwan.net/poem54416.html","الطويل"],[214,"ودي لكم صدق بغير تملق","https://www.aldiwan.net/poem13520.html","الكامل"],[254,"عفت من سليمى رامة فكثيبها","https://www.aldiwan.net/poem2131.html","الطويل"],[257,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[369,"قليل لهم أن يحن المشوق","https://www.aldiwan.net/poem60831.html","المتقارب"],[376,"على طرفك برهان","https://www.aldiwan.net/poem57032.html","الهزج"],[382,"حلول حال أفرقنا مجالا","https://www.aldiwan.net/poem59176.html","الوافر"],[415,"لا تغترر بنحول خصر أهيف","https://www.aldiwan.net/poem32566.html","الكامل"],[445,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[463,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[463,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[473,"لما رأت دمعي غداة وداعها","https://www.aldiwan.net/poem60175.html","الكامل"],[487,"طريقتنا قطع العلائق والخطو","https://www.aldiwan.net/poem24360.html","عموديه"],[487,"نيل الجفون أذاب قلب العاشق","https://www.aldiwan.net/poem24457.html","عموديه"],[534,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[563,"معان بدت فينا حروف سطورها","https://www.aldiwan.net/poem34471.html","الطويل"],[574,"إذا صحبتني من أناس ثعالب","https://www.aldiwan.net/poem52020.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138441",""],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96996","الطويل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104008","الكامل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137697",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48518","الوافر"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122352","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59294","الكامل"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118102","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21669","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108762","الطويل"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124298","الطويل"],[1822,"","https://poetry.dctabudhabi.ae/diwan/poem/128329","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106846","المتقارب"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93643","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93619","الطويل"],[2562,"","https://poetry.dctabudhabi.ae/diwan/poem/123450","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87337","الطويل"],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94003","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203043","الكامل"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107027","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132764","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48299","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86312","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138713",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129435","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131989","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91115","الوافر"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85243","الطويل"],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18710","الوافر"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95322","الطويل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88556","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90797","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94341","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94342","الوافر"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135105","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66134","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120433","المتقارب"],[4927,"وفاء عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=29604",""],[5183,"إلى الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=180189",""],[5213,"فلأجلبن على العذيب جحافلا","https://www.poetsgate.com/ViewPoem.aspx?id=170425",""],[5280,"تراءت","https://www.poetsgate.com/ViewPoem.aspx?id=189574",""],[5582,"أَلا حَيِّ مِنْ دارِ سُعْدَى مُقامَا","https://www.poetsgate.com/ViewPoem.aspx?id=63572",""],[5725,"إمام العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=215791",""],[5770,"إلى صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178681",""],[5842,"تَقَبَّحَ قومٌ بالجهالة أُولِعوا .. !","https://www.poetsgate.com/ViewPoem.aspx?id=176656",""],[6102,"عَجِيب !!","https://www.poetsgate.com/ViewPoem.aspx?id=184446",""],[6127,"فداءٌ وإباء","https://www.poetsgate.com/ViewPoem.aspx?id=215939",""],[572,"أخٌ لي كُنتُ أُغبَطُ باعتقادِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9249&r=&rc=106",""]],"verses":[["فكأنّ وَفْدَ الرّيحِ شافَهَ أرْضَها","بثَرًى تُعَفَّرُ عندَهُ التّيجانُ",0,"ن",1,0],["فكانَ ولائي له مخلصاً","لأنَّ الولاءَ لمن أعتقا",1,"ق",2,0],["فكأن وجهك من تجدُّده","متنقلٌ للعينِ في صور",2,"ر",1,0],["فكانوا الحق منقبضا حيِيّا","تحدى السيف منصلتا وقاحا",3,"ح",2,0],["فَكانوا الشُهبَ حينَ الأَرضُ لَيلٌ","وَحينَ الناسُ جَدُّ مُضَلَّلينا",4,"ن",2,0],["فَكانوا الأُسدَ لَيسَ لَها مَصالٌ","عَلى طَيرٍ وَلَيسَ لَها مَطارُ",5,"ر",1,0],["فَكَأَنَّ وَهيَ نِظامِها نَظمٌ وَهى","مِن يارِقٍ وَقَلائِدٍ وَعُقودِ",6,"د",1,0],["فكأنَّ وجهَكِ فوقَهُ جُدَريُّهُ","ذَهَبٌ بِسِمْطَيْ لؤلؤٍ قَدْ رُصِّعا",7,"ع",2,0],["فَكانوا الحَقَّ مُنقَبِضاً حَيِيّاً","تَحَدّى السَيفَ مُنصَلِتاً يَقاحا",8,"ح",2,0],["فَكانَ وَكُلُّهُ كَرَمٌ","ثماماً وَالوَرى خُدُجُ",9,"ج",1,0],["فكانوا منه في العَوْراتِ سِتراً","وكانوا فوق جمرتهِ رمادا",10,"د",2,0],["فكانوا الجيش الف من جنود","مجندة ومن متطوعين",11,"ن",1,0],["فكانوا وكنَّا في نعيمٍ ولذةٍ","وزهرة عيشٍ والزمانُ متابعُ",12,"ع",1,0],["فَكانُوا أنجُمَّا تُهدَى الحَيَارَى","بِهِنَّ فَلَن تُرَابَ ولَن تُعَابَا",13,"ب",2,0],["فكانوا وهم حوليك مقدار نعمة","من الله جلت أن تقابل بالكفر",14,"ر",1,0],["فكان وَقد لاحتْ بشَطَّيْهِ خُضْرة","وكانتْ وَفيها الماءُ باقٍ مُوَفَّر",15,"ر",1,0],["فكأنّ وسوسةَ الغصونِ أحبَّةٌ","كلٌّ يُبثُّ أخاه من ألحانه",16,"ن",2,0],["فكانوا في القياس أقل شيء","وعالمهم تصادفه حقودا",17,"د",2,0],["فَكانو هُم الأَظفارُ وَالرَأسُ فَوقَهُم","وَلَولا مَكانُ الرَأسِ طاحَ الأَظافِرُ",18,"ر",1,0],["فَكانوا لَنا نوراً بِإِذنِ الَّذي لَهُ","عَلَيها إِيادٍ مِن فُضولٍ وَأَنعُمِ",19,"م",1,0],["فكأن وجنته ونبت عذاره","طرس به آثار سطر ملحق",20,"ق",1,0],["فَكانوا كَذاتِ القِدرِ لَم تَدرِ إِذ غَلَت","أَتُنزِلُها مَذمومَةً أَم تُذيبُها",21,"ب",3,0],["فَكانوا هَولوا بالحشدِ جَهلاً","وَما تَخشى الأُسود مِن النِباحِ",22,"ح",1,0],["فكانوا صديقاً كما يَزْعُمون","ولكنْ تَعذَّر منهمْ صَدوق",23,"ق",1,0],["فكانُوا لي كما كنتُ","وقد كنتُ كما كانُوا",24,"ن",3,0],["فكانوا ينطقون بكل فنٍّ","لغاتٌ عدُّها يُفضي الكلالا",25,"ل",2,0],["فكانوا كالشهور الغر عدّاً","أو الأبراج حكماً واعتدالا",25,"ل",2,0],["فكأَنَّ وشْيَ عِذارِهِ في خدِّهِ","نَملٌ تسرَّبَ فَوقَ وردٍ مُضْعَفِ",26,"ف",1,0],["فكَأَنَّ وجهَكَ غُرَّةُ الفِطْرِ الَّذِي","وافى بِفِطْرِيَ بَعْدَ طُولِ صِيامِي",27,"م",2,0],["فكانوا مُزنها شِيماً","وكانوا شُهبَها قِسَما",28,"م",2,0],["فكان وما باراه من عَبَراتنا","نصيبَ مَحلٍّ بالجنابِ تأبَّدا",29,"د",2,0],["فَكَأَنَّ وَجنَتَها غُلالَةُ فَضَّةٍ","وَكَأَنَّ غُرَّتَها طِرازُ زَبَرجَدِ",30,"د",1,0],["فكانوا لهذا الدير قفص ما لهم","وساطية إلا هم هم أعمد",31,"د",1,0],["فكانوا مرايا للكمال المحمدي","ليوث الوغى أسد الشرى هم سجد",31,"د",1,0],["فكأن ولد","ورد تفتح في رياض فائق",32,"ق",1,0],["فَكَانُوا كالّذِي اعْتاضَتْ ذُباباً","أَنامِلُ راحَتَيْهِ عَن الْعَنانِ",33,"ن",1,0],["فكانوا بها في جنة عجلت لهم","تمتعهم منهم بهم في قصورها",34,"ر",3,0],["فَكانوا كعنز السوء تثغو لحينها","وتحفر بالأَظلاف عن حتفها حفرا",35,"ر",2,0],["فكانوا في الجبال أو البراري","مثالا يرشد النفس الغويه",36,"ي",2,0],["فكانوا نجوماً في سماء سماحةٍ","أنالت شياطين الأشحاء رجمها",37,"م",3,0],["فكأنّ وترَ الموصليَّ ومَعبدٍ","بيديهِ فَهو يصوغ كُلَّ نشيدِ",38,"د",1,0],["فكانوا يلاقون صدرا رحيبا","وكل محيا حكى قمرا",39,"ر",2,0],["فكان وقد نهضت به وحيداً","عليك صلاح أهليها ضمانا",40,"ن",2,0],["فكأن وردا أو كأن بنفسجا","يمسى ويصبح بالحيا مطلول",41,"ل",1,0],["فَكَأنَّ وَجْنَتَهُ وَآسَ عِذَارِهِ","طلعُ الشَّقَائق تَحْتَ لَيْلٍ أدْكَنِ",42,"ن",1,0],["فكأن ورساً ذيب في أجفانها","فحكى النضار وحير النظارا",43,"ر",2,0],["فكانوا دعاة اللّه في خير دعوة","ترقوا بفيض اللّه ارفع ذروة",44,"ه",1,0],["فَكانوا خَلى حَربٍ لَنا اِلتَهَمَتهُم","وَنَحنُ بَنو عُصلِ الحُروبِ الكَواهِمِ",45,"م",1,0],["فكان وأيم اللَه أحلى من المنى","وأملحَ من وجه الضحى ذلك القفا",46,"ف",2,0],["فكانوا كمن أعيى بحمل سلاحه","بمعترك يوصى الذي كان يقدر",47,"ر",1,0],["فكان وإياك الخليل مع ابنه","فذو الجهل معذورٌ وذو العلم يعذر",47,"ر",1,0],["فكانوا ملوك العلم حازوا لواءه","فما إن عليهم سوقةٌ يتأمّر",47,"ر",1,0],["فكان وداعا لا تلاقي بعدَهُ","وبينا إلى يوم القيامة والحشر",48,"ر",1,0],["فكانوا طعامَك في الحالتين","لهم وعليهم بكَ المصرع",49,"ع",1,0],["فَكانوا مِثلَما حدست أَسوَدا","حمام عدوّهم يَوم القراع",50,"ع",1,0],["فَكانَ وَزيراً لِلأَمير بِقَوله","وَعَن أَمره يَنهي الأَنام وَيامر",51,"ر",1,0],["فكانوا لكم إزرراً على كل خارجٍ","عدوٍ وما كانوا وحقكم وزرا",52,"ر",2,0],["فكانوا على فَرسانَ تِسعاً زوايدَا","وكانوا على سَيبَانَ تِسعاً قَوَاصِر",53,"ر",1,0],["فكان واجبا على العِباد","جميعهم من حاضِر وباد",54,"د",1,0],["فكانون به ختمت وثاني","به ابتدئت ويمتد الصراط",55,"ط",1,0],["فكأن وسط الجو منبع فضة","أو أرحياً تذري طحيناً في الفضا",56,"ض",2,0],["فكانوا له حرزاً وكان لهم غناً","وكانوا له عزاً وكان لهم ذخرا",57,"ر",2,0],["فكأن وجدي بارق متالق","وكان دمعي عارض هتان",58,"ن",1,0],["فكان وليُّ الكُفْرِ يُبْدي تجلُّداً","إلى أن أراهُ حرْبَهُ وجِلادَهُ",59,"د",2,0],["فَكان وَجه الاِرض وَجه ابلَج","قَد زانَهُ زَهرٌ زَها وَخزام",60,"م",1,0],["فكأن وقعة كربلاء","وقوعها ما هل لازم",61,"م",1,0],["فكأن وجهك والوجوه عوابس","قمراً بدا إشراقه وتهللا",62,"ل",2,0],["فكانوا في الوغى آساد حرب","وفي العرفان قد نشروا الكنابا",63,"ب",2,0],["فَكانوا دوننا سَهلاً مهيداً","وَكنا فَوقَهُم مثل الشماخ",64,"خ",1,0],["فكانوا إلى التوحيد يدعون دأبهم","فكم قد أفادوا من يروح ومن يغد",65,"د",1,0],["فَكانوا بَينَ مَكبولٍ أَسيرٍ","وَمُنعفِرِ المَضاحِكِ في التُرابِ",66,"ب",1,0],["فَكانَ وكَانُوا كالقُطاميّ نَاهَضَ ال","بُغَاثَ فَصرَّى شِلوَهُ في الأَظافِر",67,"ر",1,0],["فكانوا كالهشيم يشبُّ فيه","حريق شِبه لَفحٍ في الشمال",68,"ل",1,0],["فكانوا كالحصيد غدت عليهم","طماطم ليس توصَف بالنكال",68,"ل",1