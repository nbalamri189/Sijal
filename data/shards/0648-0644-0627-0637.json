tsgate.com/ViewPoem.aspx?id=7190",""],[5525,"نسيم الليل","https://www.poetsgate.com/ViewPoem.aspx?id=7271",""],[5582,"أَلا حَدِّثا عَنْ عَهْدِ ناقِضَةِ العَهْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186936",""],[5616,"أبا الطيب عذراً","https://www.poetsgate.com/ViewPoem.aspx?id=203454",""],[5689,"حمام أم تنور أم بركان","https://www.poetsgate.com/ViewPoem.aspx?id=143412",""],[5756,"اثنا عشر شهر","https://www.poetsgate.com/ViewPoem.aspx?id=5433",""],[5756,"اقرب الناس","https://www.poetsgate.com/ViewPoem.aspx?id=5436",""],[5975,"نفى الشوقُ","https://www.poetsgate.com/ViewPoem.aspx?id=53295",""],[6056,"القلب والنفس خضراء","https://www.poetsgate.com/ViewPoem.aspx?id=130182",""],[6093,"لولا المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=191822",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""],[6229,"في سكون الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65187&r=&rc=13",""]],"verses":[["وَلا طالِباً مِن دَهرِهِ فَوقَ قُوَتِهِ","كَفاني مِنَ الغُدرَانِ ما نَقَعَ الصَدى",0,"د",2,0],["وَلا طِوَلُ النَعماءِ فيهِم مُقَلِّصٌ","إِذا عَلِقَتهُ المُعصِماتُ الشَوابِثُ",1,"ث",1,0],["ولا طلبنا ربيع برّ","وكان جودكم جمادى",2,"د",2,0],["ولا طريقاً تخاف غَيلته","تركبه تارة وترتدع",3,"ع",1,0],["ولأطربنّك أو تميدَ مُرنَّحاً","حتى كأنك للغريض نديمُ",4,"م",1,0],["ولأطْياركَ لا تلغو فأينَ النَّغَماتْ","ما لمِزْمارِكَ لا يشدو بغير الشَهَقاتْ",5,"ت",1,0],["ولا طاردت مفكوكا","ولا ضايقت محصورا",6,"ر",2,0],["ولا طِبْتُ نفساً بالفراق وإِنَّما","أضيفَ إِلى ذاك الغَرامِ غَرامُ",7,"م",1,0],["ولأطلِعَنّك إن بقيتُ على مدى","سِرٍّ تقاصَرُ دونَه الأسرارُ",8,"ر",1,0],["ولا طرقت أُمُّ الحفاظِ بماجدٍ","ولا حضَنَتْ ظِئرُ العفافِ كِعابَا",9,"ب",2,0],["ولاطِفْهُ بالشَّهْدِ المُخَلَّقِ وَجهُه","وإن كانَ بالألطافِ غيرَ خَليقِ",10,"ق",1,0],["ولا طَفْلَةُ العيش وهنانَةٌ","أروجٌ بنفحَةِ مِسْكٍ وعودِ",11,"د",1,0],["وَلاطَمَ مِن نُكبِ الرِياحِ مَعاطِفي","وَزاحَمَ مِن خُضرِ البِحارِ غَوارِبي",12,"ب",2,0],["وَلا طَلَعَ النَجمُ الَّذي يُهتَدى بِهِ","وَلا البَرقُ إِلّا هَيَّجا ذِكرَها لِيا",13,"ي",2,0],["ولا طَعِمَتْ إلاّ غِراراً منَ الكَرَى","حِذارَ كَلُوءِ العينِ غيرِ مُهَوِّم",14,"م",1,0],["وَلا طَعِمتُ بِكَ السُلوانَ يا أَمَلي","وَحَلَّ حُبُّكَ في قَلبي وَما خَرَجا",15,"ج",2,0],["وَلا طَوَتهُ المَنونُ حَتّى","أَرى بَني بَرمَكٍ جَميعا",16,"ع",2,0],["ولا طلقنّ به جواري ادمعي","ولا جرين من كل عين جدولا",17,"ل",2,0],["وَلا طَرَقتُم بوَبلِ النَبلِ طارِقَةً","وَلا تَغَلغَلَت الأَسيافُ في القُلَلِ",18,"ل",1,0],["وَلاطفه وارحم من يَليه رحامة","وَصحبا فان البعض للبعض يحمل",19,"ل",1,0],["وَلا طف أَطيفالي واخوتهم فقد","رمتهم خطوب ما أَطاقوا لَها صَبرا",20,"ر",2,0],["وَلاطَمتُ بِالوَجناءِ وَجنَةَ مَهمَهٍ","تَلا وَخدَها وَسطَ الفَلاةِ ذَميلُ",21,"ل",1,0],["وَلا طاعَةً حَتّى تُشاجِرَ بِالقَنا","قَناً وَرِجالاً عاقِدينَ النَواصِيا",22,"ي",2,0],["وَلا طَنين مِن ذُباب نَبا","بِهمّة القسور عَن مَطلَبِ",23,"ب",1,0],["ولأطيارهن من لحن إسحاق","معان منها الصخور تميل",24,"ل",1,0],["ولأطفأت لظى نار الجوى","ولعفت الماء عذباً والمداما",25,"م",2,0],["ولا طرابلسٍ الفيحا","ءِ وال لا يضام",26,"م",1,0],["ولا طرقتَ غاشياً أبوابَها","بين غداياها إلى آصالها",27,"ل",3,0],["ولا طلبتُ وقد أودى السهادُ بنا","مِن نازلِ الجِزعِ أعواناً على السَّهَرِ",28,"ر",1,0],["ولا طافت على زمر فعيشٌ","كؤسٌ من معتَّقةٍ طفاحُ",29,"ح",1,0],["ولا طُرِقَتُ برَمْشٍ حينَ أَنْدُبُهُمْ","إِلاَّ لَمَسْتُ بطَرْفي زِيقَ ذَيْلِهِمِ",30,"م",1,0],["ولا طَابت حَياةٌ لي اذا لم","أزر في طَيبة خيرَ الأنَام",31,"م",1,0],["وَلا طَمحت إِلى نَيلٍ مِن الكَرَمِ","إِلّا وَبَلَّغَني فَوقَ الَّذي أرُمِ",32,"م",1,0],["وَلا طَلعتْ يوماً على دولةٍ بها","بَلغنا بها إلّا كَواكبُ أسعُدِ",33,"د",1,0],["وَلا طالعاً إِلّا مخارمَ لم يكنْ","ليطلعها إلّا الشّجاعُ المُشايحُ",34,"ح",1,0],["وَلا طارِقِي يرجو ثوابِيَ عائداً","بعسرٍ ولا يُسرٍ بغير ثوابِ",35,"ب",1,0],["وَلا طُويتْ عَلى أَوَدٍ قناتي","وَغلّس في مفارِقيَ المشيبُ",36,"ب",1,0],["ولا طاهر سراً وجهراً بمشبه","لذي نجس سراً وجهراً مدى العمر",37,"ر",1,0],["وَلأَطْلَعَنَّ شُمُوسَ كُلّ مَسرَّةٍ","وَأَكُونَ مَشْرِقَ أُفْقِهَا والمَغْرِبَا",38,"ب",2,0],["ولاطف باللطائف والعنايا","ضعيفاً في جنابك ذا اتكال",39,"ل",1,0],["ولا طيور حقل","تهزج في الأوكار",40,"ر",1,0],["وَلا طالَ سهدي في لَيالي ذَوائبٍ","وَلا في لآلي مبسم وَنُحور",41,"ر",1,0],["ولا طاب لي طعم الرقاد ولا اجتنت","لحاظي مذ فارقتكم حسن منظر",42,"ر",1,0],["ولاطفته حتى استلمت فؤاده","فيا لك سعداً بعضة لين جلمد",43,"د",1,0],["ولا طلاق منهما","إلى بلوغ وجبا",44,"ب",2,0],["ولا طيب في غرضٍ عارض","إذا كان مرجعه للذهابْ",45,"ب",1,0],["ولا طمحت الى العلياء أَنشُدها","وكان لي بخمول الذكر قنعان",46,"ن",1,0],["وَلا طلعة الشمس المنيرة إِذ بدت","بِصالحة الإقبال للأعيُنِ الرمدِ",47,"د",1,0],["ولا طاب نشر الروض إلا لأنه","يجر عليه من جلابيبها مرطُ",48,"ط",1,0],["ولا طار ذكر الظبي إلا وقد غدا","يصد كما صدت ويعطو كما تعطو",48,"ط",2,0],["وَلا طَلَعَت شَمسُ الهُدى غِبَّ دُجيَةٍ","تَجَهَّمَ مِن دَيجورِها لَيلُ كُفرانِ",49,"ن",1,0],["ولا طلسمٌ كلا ولا حكمة ولا","فنونٌ ولا علمٌ ولا السحر يمنعُ",50,"ع",1,0],["ولاطفي مُهْجَةً إِذا وُقِيَتْ","تَفْديكِ مِنْ حادثٍ وثقي",51,"ق",2,0],["ولأطبقت ظلمُ الرزيَّة واختفى","ضوءُ السلوِّ بذلك الإطباقِ",52,"ق",1,0],["ولا طرَّز الطلُّ منه حُلَل","وفيهنَّ جسمُ الثرى ما اشتمَل",53,"ل",1,0],["وَلا طاعَ لي حُرُّ الكَلامِ يزينُهُ","مَديحُ الإِمامِ حَيثُما أَتَكَلَّمُ",54,"م",1,0],["ولا طمع في عود ما هو فائت","فما ذو حجا في عود ماض بطامع",55,"ع",1,0],["ولا طَلَباً للشُّكْر من آخِذٍ بها","ولا الذِّكْر لي إِنِّي من الفُصَحاءِ",56,"ا",2,0],["ولا طَرَقَتْكم نَكْبَةٌ وعليكمُ","سلامٌ ومن بعد السلام سلامُ",57,"م",1,0],["ولا طاب بعدك عيش لنا","ولو شيب مطمعنا بالعسل",58,"ل",1,0],["وَلا طالِبٌ أَمراً سِوى ما أَفادَهُ","بِهِ عَزمُهُ أَو سَيفُهُ أَو عَوامِلُه",59,"ل",2,0],["ولا طرى ذكره مذمات في خلد","إلا وكان بنار الحزن موقودا",60,"د",2,0],["ولا طرباً مني إلى شرب قهوة","ولا لحبيب إن نأى لم أطق صبرا",61,"ر",2,0],["ولا طاردتنا الحادثات مغيرة","فكان لنا إلا جنابك مفزع",62,"ع",1,0],["ولا طغى الخطب إلا","ورد سورة صعبه",63,"ب",2,0],["ولا طغى الدهر إلا","وكنت رائض صعبه",63,"ب",2,0],["ولا طاب مشمومٌ ولا راق منظر","ولا لذّ من غر الثنايا عذابها",64,"ب",3,0],["وَلا طابَ في الحَي المَقام لحاضر","وَلا أَرقلت بِالسَفَر نجب الأَيانق",65,"ق",1,0],["وَلا طفه الباري بِنسمة لُطفه","وَحياه صوب العَفو في كُل شارق",65,"ق",1,0],["وَلا طف زهر رَوضته نَسيم","مِن الفَردوس باكره مَضوعا",66,"ع",2,0],["وَلا طفه نَسيم العَفو يَحكي","شَمالاً نَفحَها لاقى شَمولا",67,"ل",2,0],["ولا طالب يطلب هوانا وقربنا","ويشرك فيه غيرنا أن ينل منا",68,"ن",2,0],["ولاطلقن بذكرها عي الورى","ولابكمن فصاحة البلغاء",69,"ا",2,0],["ولا طِرفٌ لديَّ ولا حُسامُ","ولا آلاتُ أبناء الخميسِ",70,"س",1,0],["ولا طاقة فينا لقمع مقامع","ولا حمل أغلال وسحب سلاسل",71,"ل",1,0],["ولا طفنى لطفاً أرى من وفائه","سكرتُ ولم أشرب مدامة ثامل",72,"ل",1,0],["ولا طويتُ الليالي فيك ساهرة","أكدّ لا أشتكي ضعفاً ولا نصبا",73,"ب",2,0],["وَلا طَرْفَ إِلا مُسْتَهِلٌّ غَمَامَةً","إِذا هُوَ بَلَّ الذَّيْلَ أتْبَعَهُ الرُّدْنا",74,"ن",2,0],["ولا طلعت في قطرها الشمس بعده","ولا غرب النجم ولا بزغ البدر",75,"ر",1,0],["ولا طِرفاً يُقَحِّمُهُ مَهولاً","ولا ملِكاً يُغادِرُهُ ذَليلا",76,"ل",2,0],["ولا طلع النجم الذي يهتدي به","ولا الصبح حتى هيجا ذكرها ليا",77,"ي",2,0],["ولا طلَبٌ إلا عن المنْحِ حاجزٌ","ولا سبَبٌ إلا لهُ المنْعُ فارِثُ",78,"ث",1,0],["وَلا طَرِبت نَفسي إِلى مِزهِرٍ وَلا","تَحَنَّنَ قَلبي نَحوَ عودٍ وَلا زَمرِ",79,"ر",1,0],["وَلا طربي اِلّا بِنوح الحَمائِمِ","حَليف الجَوى فَليَتَّقِ اللَه لائِمي",80,"ي",1,0],["ولأطلاء الظبي مرتبع","فيه ما أبهج للظبي احتراشي",81,"ش",2,0],["وَلا طربتُ لغرّيدٍ وَغانيةٍ","إِلا وَعاوَدَ قَلبي بارِحُ الشجن",82,"ن",1,0],["ولا طمع الحرص الذميم يقودني","إلى كل حر قاده طمع عبد",83,"د",1,0],["ولا طول مكث بين أم ووالد","رحيمين يحلولي لدى من له عقل",84,"ل",1,0],["ولا طوت الدنيا بكم عمر ساعة","طيوركم بعد النياق الطلايح",85,"ح",1,0],["ولا طلعت وليل الجهل معتكر","منارة للهدى وضّاءة الشهب",86,"ب",1,0],["ولا طيار المنى في ظله","صدح تبريك وتغريد تهان",87,"ن",1,0],["ولا طافه طيف الخيال المخامر","حنانيك هلا شمرت لك همة",88,"ه",1,0],["ولا طارقٌ إلاَّ أَسيرٌ لأَنعُمِ","وَلا مارقٌ إلاَّ عقيرٌ لقَشعَمِ",89,"م",1,0],["وَلا طَفقتُ اليَوم أَبكي على","عيشٍ رَغيدٍ ساءَني مُنتَهاه",90,"ا",2,0],["وَلا طَمعنا لَكُم في","وِلايَةٍ خلدِيَّهْ",91,"ي",2,0],["ولا طَعِمُوا المَنَامَ على خُنُوعٍ","وكَيفَ يَنَامُ ذُو الشَّرَفِ الغَيُورُ؟!",92,"ر",1,0],["وَلا طَلَّ بَدْرٌ فِي نَوَاضِرَدُونَنا","وَمَا نَاحَ قُمْرِيٌّ سِوَى بِعَزَائِيَا",93,"ي",2,0],["ولاطف وسامح واعف واصفح تجاوزاً","إذا نحن فارقنا الخطيئة والجرما",94,"م",2,0],["ولا طويت على نصل لقطعهما","يد ازهير بما أثنت على هرم",95,"م",1,0],["ولا طفلاً قتلنا في عِراقٍ","ولا عن جائعٍ مُنِعٍ الطعام",96,"م",1,0],["ولا طَرِيقٌ تَهَادَت فِيهِ خُطوَتنُاَ","يُغرِي خُطَايَ ولَو فِي المُنتَهَى مَجدُ",97,"د",1,0],["وَلَا طَرَبٌ يَكُونُ وَلا عِجَابٌ","بِغَيرِ تَبَاعُلٍ جَزمًا قَويَّا",98,"ي",2,0],["ولا طيفٌ يسوؤكَ في منامٍ","ولا ضُرٌّ يَمَسُّكَ أو يَطالُ",99,"ل",1,0],["ولاطفها واسْتأنست ثمَّ عاودا","يجاذبها بعض الهوى وتجاذِبُهْ",100,"ب",2,0],["ولا طار شوقاً جناح الكناري","وغرد في الكون من غردا",101,"د",2,0],["ولا طيرٌ يرفُّ ولا ربيعٌ","ولا عطرٌ يفوحُ بكلِّ جنَّة",102,"ن",2,0],["ولاطورَ في أرضٍ طهورٍ وكلنا","ذنوب وفي طور المعاصي التوضّعُ",103,"ع",1,0],["ولا طرف إلا وهو بالدمع مغرق","ولا قلب إلا وهو بالوجد محرق",104,"ق",1,0],["ولا طويت الياس بذرف دمعتين","للهوى الغالي وبا وادع هلي",105,"ل",2,0],["ولا طاب لي غصن من الغى مياح","أروي غليل القلب لا صار صادي",106,"د",2,0],["وَلا طَلْعَةُ الشَّمْسِ المُنِيرَةِ إِنْ بَدَتْ","بِصالِحَةِ الإِقْبالِ لِلأَعْيُنِ الرُّمْدِ",107,"د",1,0],["ولا طير في الأقفاص يجتّر حزنه","ولا قيد تشكو من أذاه المعاصم",108,"م",1,0],["ولاطير في اجوائها مثل الهبا","يزجى به طي اللظى الطيران",109,"ن",1,0],["ولا طوت رجلي مسافة ولا اثر فيني شهور","ولا كوت قلبي حريقة ولا طفلي ضوى نهر",110,"ر",1,0],["ولاطلبت من المخاليق يبكون","ولا بغيت من الحزين ابتسامه",111,"م",2,0],["ولاطفته حتى ذللت فحسبه","هواني وذلي بالعذاب تعدَّا",112,"د",2,0],["ولا طاب لك ، وقتك ، بإنس ٍ وسمرا","ترى ، مقابيل الليالي ،، يدورون",113,"ن",1,0],["وَلا طَبِيبَ لِداءِ الجَهلِ يَحسُمُهُ","إلا المعلِّم إذْ يَشفِيْهِ بِالحِكَمِ",114,"م",1,0],["وَلا طايفة إِلا كلت لَحم وَاِكتَفَت","مِن طايفه وَصار الحَرام حَلال",115,"ل",1,0],["وَلا طَمَعٌ وَلا أَلَمُ احتِياجٍ","وَلا هَمُّ ارتحالٍ وَاصطِراعِ",116,"ع",1,0],["ولا طيرَ إلا وهْو طاوٍ جناحَهُ","على الرأس حتى المنكبين.. كبائس",117,"س",1,0]]}