{"poems":[[53,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[53,"رجونا أبا الهيجاء إذ مات حارث","https://www.aldiwan.net/poem30665.html","الطويل"],[72,"مولاي لا هدت الليالي","https://www.aldiwan.net/poem18669.html","مخلع البسيط"],[51,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[51,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[92,"ما لآفاقك يا قلبي سودا حالكات","https://www.aldiwan.net/poem38965.html","مجزوء الرمل"],[85,"يود الناس لو يدورن","https://www.aldiwan.net/poem7358.html","مجزوء الوافر"],[62,"هو العتب حتى ما يرد سلام","https://www.aldiwan.net/poem52295.html","الطويل"],[62,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[62,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[61,"إذا شئت أن تجتاح حقا بباطل","https://www.aldiwan.net/poem51517.html","الطويل"],[80,"هفا القلب عن وصل هيف القدود","https://www.aldiwan.net/poem31501.html","المتقارب"],[74,"بعيشك هل تدري أهوج الجنائب","https://www.aldiwan.net/poem12863.html","الطويل"],[33,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[48,"سماه مولاه لاستملاحه السمجا","https://www.aldiwan.net/poem62489.html","البسيط"],[48,"إني لولا شقاء جدي","https://www.aldiwan.net/poem64386.html","مجزوء البسيط"],[211,"ما بال ربعك يا حماة لقد خلا","https://www.aldiwan.net/poem13393.html","الكامل"],[253,"ظبى المواضي وأطراف القنا الذبل","https://www.aldiwan.net/poem1419.html",""],[272,"اليه به سبحانه أتوسل","https://www.aldiwan.net/poem52130.html","الطويل"],[272,"لك الحمد حمدا نستلذ به ذكرا","https://www.aldiwan.net/poem52136.html","الطويل"],[283,"ألا هل إلى باب البريد سبيل","https://www.aldiwan.net/poem32669.html","الطويل"],[301,"لعمري ما خلفت إلا لما أرى","https://www.aldiwan.net/poem45449.html","الطويل"],[354,"تب يا لحاك الله من خادع","https://www.aldiwan.net/poem40575.html","السريع"],[404,"بث سر الهوى عليه النحول","https://www.aldiwan.net/poem33486.html","الخفيف"],[417,"بارق لاح فأبكاني ابتساما","https://www.aldiwan.net/poem54109.html","الرمل"],[430,"حي دارا للمعالي","https://www.aldiwan.net/poem40800.html","مجزوء الرمل"],[459,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[478,"يا راقد الطرف طرفي في يد السهر","https://www.aldiwan.net/poem15249.html","البسيط"],[501,"جلا سر الغيوب لنا الصباح","https://www.aldiwan.net/poem37682.html","الوافر"],[501,"غنى الهزار على روض العرار بكم","https://www.aldiwan.net/poem37798.html","البسيط"],[507,"أقول وقد دعا للخير داع","https://www.aldiwan.net/poem2398.html","الوافر"],[525,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[552,"أيا ملك الأملاك قد جاءني الذي","https://www.aldiwan.net/poem47842.html","الطويل"],[552,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[552,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[552,"أذم إليك كلما ليس يؤسى","https://www.aldiwan.net/poem48090.html","الوافر"],[559,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[587,"يا حبذا نهر القصير ومغربا","https://www.aldiwan.net/poem17431.html","الكامل"],[588,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["وَلا طالِباً مِن دَهرِهِ فَوقَ قُوَتِهِ","كَفاني مِنَ الغُدرَانِ ما نَقَعَ الصَدى",0,"د",2,0],["وَلا طِوَلُ النَعماءِ فيهِم مُقَلِّصٌ","إِذا عَلِقَتهُ المُعصِماتُ الشَوابِثُ",1,"ث",1,0],["ولا طلبنا ربيع برّ","وكان جودكم جمادى",2,"د",2,0],["ولا طريقاً تخاف غَيلته","تركبه تارة وترتدع",3,"ع",1,0],["ولأطربنّك أو تميدَ مُرنَّحاً","حتى كأنك للغريض نديمُ",4,"م",1,0],["ولأطْياركَ لا تلغو فأينَ النَّغَماتْ","ما لمِزْمارِكَ لا يشدو بغير الشَهَقاتْ",5,"ت",1,0],["ولا طاردت مفكوكا","ولا ضايقت محصورا",6,"ر",2,0],["ولا طِبْتُ نفساً بالفراق وإِنَّما","أضيفَ إِلى ذاك الغَرامِ غَرامُ",7,"م",1,0],["ولأطلِعَنّك إن بقيتُ على مدى","سِرٍّ تقاصَرُ دونَه الأسرارُ",8,"ر",1,0],["ولا طرقت أُمُّ الحفاظِ بماجدٍ","ولا حضَنَتْ ظِئرُ العفافِ كِعابَا",9,"ب",2,0],["ولاطِفْهُ بالشَّهْدِ المُخَلَّقِ وَجهُه","وإن كانَ بالألطافِ غيرَ خَليقِ",10,"ق",1,0],["ولا طَفْلَةُ العيش وهنانَةٌ","أروجٌ بنفحَةِ مِسْكٍ وعودِ",11,"د",1,0],["وَلاطَمَ مِن نُكبِ الرِياحِ مَعاطِفي","وَزاحَمَ مِن خُضرِ البِحارِ غَوارِبي",12,"ب",2,0],["وَلا طَلَعَ النَجمُ الَّذي يُهتَدى بِهِ","وَلا البَرقُ إِلّا هَيَّجا ذِكرَها لِيا",13,"ي",2,0],["ولا طَعِمَتْ إلاّ غِراراً منَ الكَرَى","حِذارَ كَلُوءِ العينِ غيرِ مُهَوِّم",14,"م",1,0],["وَلا طَعِمتُ بِكَ السُلوانَ يا أَمَلي","وَحَلَّ حُبُّكَ في قَلبي وَما خَرَجا",15,"ج",2,0],["وَلا طَوَتهُ المَنونُ حَتّى","أَرى بَني بَرمَكٍ جَميعا",16,"ع",2,0],["ولا طلقنّ به جواري ادمعي","ولا جرين من كل عين جدولا",17,"ل",2,0],["وَلا طَرَقتُم بوَبلِ النَبلِ طارِقَةً","وَلا تَغَلغَلَت الأَسيافُ في القُلَلِ",18,"ل",1,0],["وَلاطفه وارحم من يَليه رحامة","وَصحبا فان البعض للبعض يحمل",19,"ل",1,0],["وَلا طف أَطيفالي واخوتهم فقد","رمتهم خطوب ما أَطاقوا لَها صَبرا",20,"ر",2,0],["وَلاطَمتُ بِالوَجناءِ وَجنَةَ مَهمَهٍ","تَلا وَخدَها وَسطَ الفَلاةِ ذَميلُ",21,"ل",1,0],["وَلا طاعَةً حَتّى تُشاجِرَ بِالقَنا","قَناً وَرِجالاً عاقِدينَ النَواصِيا",22,"ي",2,0],["وَلا طَنين مِن ذُباب نَبا","بِهمّة القسور عَن مَطلَبِ",23,"ب",1,0],["ولأطيارهن من لحن إسحاق","معان منها الصخور تميل",24,"ل",1,0],["ولأطفأت لظى نار الجوى","ولعفت الماء عذباً والمداما",25,"م",2,0],["ولا طرابلسٍ الفيحا","ءِ وال لا يضام",26,"م",1,0],["ولا طرقتَ غاشياً أبوابَها","بين غداياها إلى آصالها",27,"ل",3,0],["ولا طلبتُ وقد أودى السهادُ بنا","مِن نازلِ الجِزعِ أعواناً على السَّهَرِ",28,"ر",1,0],["ولا طافت على زمر فعيشٌ","كؤسٌ من معتَّقةٍ طفاحُ",29,"ح",1,0],["ولا طُرِقَتُ برَمْشٍ حينَ أَنْدُبُهُمْ","إِلاَّ لَمَسْتُ بطَرْفي زِيقَ ذَيْلِهِمِ",30,"م",1,0],["ولا طَابت حَياةٌ لي اذا لم","أزر في طَيبة خيرَ الأنَام",31,"م",1,0],["وَلا طَمحت إِلى نَيلٍ مِن الكَرَمِ","إِلّا وَبَلَّغَني فَوقَ الَّذي أرُمِ",32,"م",1,0],["وَلا طَلعتْ يوماً على دولةٍ بها","بَلغنا بها إلّا كَواكبُ أسعُدِ",33,"د",1,0],["وَلا طالعاً إِلّا مخارمَ لم يكنْ","ليطلعها إلّا الشّجاعُ المُشايحُ",34,"ح",1,0],["وَلا طارِقِي يرجو ثوابِيَ عائداً","بعسرٍ ولا يُسرٍ بغير ثوابِ",35,"ب",1,0],["وَلا طُويتْ عَلى أَوَدٍ قناتي","وَغلّس في مفارِقيَ المشيبُ",36,"ب",1,0],["ولا طاهر سراً وجهراً بمشبه","لذي نجس سراً وجهراً مدى العمر",37,"ر",1,0],["وَلأَطْلَعَنَّ شُمُوسَ كُلّ مَسرَّةٍ","وَأَكُونَ مَشْرِقَ أُفْقِهَا والمَغْرِبَا",38,"ب",2,0],["ولاطف باللطائف والعنايا","ضعيفاً في جنابك ذا اتكال",39,"ل",1,0]]}