{"poems":[[53,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[53,"رجونا أبا الهيجاء إذ مات حارث","https://www.aldiwan.net/poem30665.html","الطويل"],[72,"مولاي لا هدت الليالي","https://www.aldiwan.net/poem18669.html","مخلع البسيط"],[51,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[51,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[92,"ما لآفاقك يا قلبي سودا حالكات","https://www.aldiwan.net/poem38965.html","مجزوء الرمل"],[85,"يود الناس لو يدورن","https://www.aldiwan.net/poem7358.html","مجزوء الوافر"],[62,"هو العتب حتى ما يرد سلام","https://www.aldiwan.net/poem52295.html","الطويل"],[62,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[62,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[61,"إذا شئت أن تجتاح حقا بباطل","https://www.aldiwan.net/poem51517.html","الطويل"],[80,"هفا القلب عن وصل هيف القدود","https://www.aldiwan.net/poem31501.html","المتقارب"],[74,"بعيشك هل تدري أهوج الجنائب","https://www.aldiwan.net/poem12863.html","الطويل"],[33,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[48,"سماه مولاه لاستملاحه السمجا","https://www.aldiwan.net/poem62489.html","البسيط"],[48,"إني لولا شقاء جدي","https://www.aldiwan.net/poem64386.html","مجزوء البسيط"]],"verses":[["وَلا طالِباً مِن دَهرِهِ فَوقَ قُوَتِهِ","كَفاني مِنَ الغُدرَانِ ما نَقَعَ الصَدى",0,"د",2,0],["وَلا طِوَلُ النَعماءِ فيهِم مُقَلِّصٌ","إِذا عَلِقَتهُ المُعصِماتُ الشَوابِثُ",1,"ث",1,0],["ولا طلبنا ربيع برّ","وكان جودكم جمادى",2,"د",2,0],["ولا طريقاً تخاف غَيلته","تركبه تارة وترتدع",3,"ع",1,0],["ولأطربنّك أو تميدَ مُرنَّحاً","حتى كأنك للغريض نديمُ",4,"م",1,0],["ولأطْياركَ لا تلغو فأينَ النَّغَماتْ","ما لمِزْمارِكَ لا يشدو بغير الشَهَقاتْ",5,"ت",1,0],["ولا طاردت مفكوكا","ولا ضايقت محصورا",6,"ر",2,0],["ولا طِبْتُ نفساً بالفراق وإِنَّما","أضيفَ إِلى ذاك الغَرامِ غَرامُ",7,"م",1,0],["ولأطلِعَنّك إن بقيتُ على مدى","سِرٍّ تقاصَرُ دونَه الأسرارُ",8,"ر",1,0],["ولا طرقت أُمُّ الحفاظِ بماجدٍ","ولا حضَنَتْ ظِئرُ العفافِ كِعابَا",9,"ب",2,0],["ولاطِفْهُ بالشَّهْدِ المُخَلَّقِ وَجهُه","وإن كانَ بالألطافِ غيرَ خَليقِ",10,"ق",1,0],["ولا طَفْلَةُ العيش وهنانَةٌ","أروجٌ بنفحَةِ مِسْكٍ وعودِ",11,"د",1,0],["وَلاطَمَ مِن نُكبِ الرِياحِ مَعاطِفي","وَزاحَمَ مِن خُضرِ البِحارِ غَوارِبي",12,"ب",2,0],["وَلا طَلَعَ النَجمُ الَّذي يُهتَدى بِهِ","وَلا البَرقُ إِلّا هَيَّجا ذِكرَها لِيا",13,"ي",2,0],["ولا طَعِمَتْ إلاّ غِراراً منَ الكَرَى","حِذارَ كَلُوءِ العينِ غيرِ مُهَوِّم",14,"م",1,0],["وَلا طَعِمتُ بِكَ السُلوانَ يا أَمَلي","وَحَلَّ حُبُّكَ في قَلبي وَما خَرَجا",15,"ج",2,0],["وَلا طَوَتهُ المَنونُ حَتّى","أَرى بَني بَرمَكٍ جَميعا",16,"ع",2,0]]}