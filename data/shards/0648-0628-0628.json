ارضَ الملْبنِ والعسلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188545",""],[5442,"ليس بعد السبعين إلا الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114787",""],[5459,"صبابة ..","https://www.poetsgate.com/ViewPoem.aspx?id=196539",""],[5618,"في جبة التأويل ..عراق الصمود","https://www.poetsgate.com/ViewPoem.aspx?id=208921",""],[5648,"الا ياليتني شعره على ذيك الكتوف تميل","https://www.poetsgate.com/ViewPoem.aspx?id=157235",""],[5689,"حطمت لي يد القضا كل فلس","https://www.poetsgate.com/ViewPoem.aspx?id=143434",""],[5691,"حواء","https://www.poetsgate.com/ViewPoem.aspx?id=205898",""],[5756,"الذيب والراعي","https://www.poetsgate.com/ViewPoem.aspx?id=5419",""],[402,"ألغرس غرسك أيها البستاني","https://www.poetsgate.com/ViewPoem.aspx?id=36486",""],[5790,"ما للجمال بوجنتيك معين","https://www.poetsgate.com/ViewPoem.aspx?id=112147",""],[5829,"إلى روح الشهيد العلامة البوطي","https://www.poetsgate.com/ViewPoem.aspx?id=153911",""],[5953,"ليس حبسي بضائري إن أتاح الل","https://www.poetsgate.com/ViewPoem.aspx?id=93880",""],[5956,"بِظِلال نخلهما أنخُّ رواحلي","https://www.poetsgate.com/ViewPoem.aspx?id=193693",""],[6023,"العتب منك موَجّه مقبول","https://www.poetsgate.com/ViewPoem.aspx?id=123911",""],[6031,"قُلْ لأعْلَى الوَرَى مَحَلاّ ورُتْبَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=46345",""],[6127,"لولاك عدنا في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=188606",""],[6160,"هَلْوسَات فِي غُرْفَة سَودَاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87108&r=&rc=25",""],[572,"لَمْ أرْضَ عَنْ نَفْسْي مخافَة َ سخطِهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9175&r=&rc=32",""]],"verses":[["وَبِبَابِ مَوْلاَنَا الْمُؤَيَّدِ يُوسُفٍ","مَاشِئْتَ مِن حُسْنَى وَمِنْ إِحْسَانِ",0,"ن",1,0],["وَبِبعْضِ مَا أًسْدَيْتَ عظَّ مَقَامُهُمْ","فِيمَا نَأَى وَدَنَا مِنَ البُلْدَانِ",1,"ن",1,0],["وَبِبِنتِ الرَسولِ فاطِمَةِ الطُه","رِ وَسِبطَيهِ وَالإِمامِ عَلِيِّ",2,"ل",2,0],["وببعض ما فعلت بقلبي في الهوى","عيناك صارَ الليثُ صيداً للرشا",3,"ش",2,0],["وبباطني منها وسا","وس من هموم كالخصومِ",4,"م",1,0],["وببأسك انْصُرْنا وزَلْزِلْ جَمْعَهم","تَزُلِ الهمومُ وتَذهبِ الأوصابُ",5,"ب",1,0],["وبباقِي أصحابِكَ المُظْهِرِ التَّرْ","تيبِ فينا تَفْضِيلُهم والولاءُ",6,"ا",2,0],["وَببَذْل هَاتِيكَ الْقُوَى","أَنْفَذْتَ فِي عَجَلٍ قوَاكْ",7,"ك",1,0],["وَبِبَذْلِ جُهْدِكَ فِي الَّذِي","يُرضِيهِ صِرْتَ كَمَا أَرَادَك",8,"ك",1,0],["وَبِبَعْضِ الإِصْلاَحِ مِنْ شَأْنِ عَافٍ","يُتَّقَى طَائِلٌ مِنَ الإِفْسَادِ",9,"د",1,0],["وَبِبَأْسِهِ فِي الْحَرْبِ أَثْبَتَ أَنَّهُ","بَطَلُ الجِهَادِ البَاسِلُ الصِّنْدِيدُ",10,"د",1,0],["وبِبِئرِ بَدْرٍ إذْ يَرُدُّ وُجُوهَهُمْ","جِبْريلُ تَحْتَ لوائِنا وَمُحَمَّدُ",11,"د",1,0],["وَبَبِيتُ يَهْدِي بالدَرُوسِ، كأَنَّه","في الفَصْل بين إجابةٍ وسُؤال",12,"ل",1,0],["وببيتِ إبراهيمَ، وهْ","وَ من العروبة في الصميم",13,"م",1,0],["وَببشر وَجه المُكرَما","ت وَسَعد أَبناء المَوالي",14,"ل",2,0],["وبباب الجيلي قف مستفيضا","فهو سامي الذرى الهزبر الجواد",15,"د",1,0],["وببصرة صاد السباع بلفتة","ولوى ببأس شوكة الآساد",16,"د",1,0],["وببابه وقفت صدور الأصفيا","ومشت ملائكة السما بركابه",17,"ب",2,0],["وَبِبَعضِ ما بَلَغَت مَساعي رافِعٍ","تُحوى النَباهَةُ وَالمَحَلُّ الأَرفَعُ",18,"ع",1,0],["وَبِبَعضِ الَّذي أَنالَ مِنَ الإِك","رامِ رَبَّ النَوالِ رَبُّ النَوالِ",19,"ل",1,0],["وَببدرٍ لَدى عكاشةَ صارَت","منهُ سَيفاً جريدةٌ جرداءُ",20,"ا",2,0],["وببعده تدنو الكآ","بة والصبابة والزفير",21,"ر",1,0],["وببطشٍ يَفْري الجماجمَ والأَعْ","ناق فَرْيّ لحومَ الأضاحي",22,"ح",2,0],["وَبِبأسِهِ المَرهوب آلَة حَربِهِ","فَتَكَت بِكُلِّ مُسايِفٍ مِطعانِ",23,"ن",1,0],["وببرهة عم البسيطة كلها","دين لأحوال العباد منظم",24,"م",1,0],["وببعض عشقي عشق خضراء الدمن","وإذا غفلت بكم فلا سلوى ومن",25,"ن",1,0],["وببحر القدرة والمرَجِ","بسنا الرضوان وجنّته",26,"ه",1,0],["وببدر سماء رسالتهم","طه ذي الرفعة والشرف",27,"ف",1,0],["وَبِباقي الأَصحابِ مَن أَقرَضوا اللَ","هَ بِأَرواحِهِم لِدينِكَ قَرضا",28,"ض",2,0],["وَبِبَطن كفك سبحت صم الحصى","وَكَذاكَ حن الجذع يوم المنبر",29,"ر",1,0],["وَبِبَحرَ العِلمِ وَطَودِ الحِل","مِ كَبَت وَسِواهُ اخبر تَقلَه",30,"ل",2,0],["وَبِبَعلَبَكَّ كَأَنَّني","ما كُنتُ قَطُّ عَرَفتُها",31,"ت",3,0],["وَببذلِ الروحِ تواصينا","بالدمِ والدمع لك السقيا",32,"ي",2,0],["وَ (ببعلبكَ) حوادثٌ لو أنها","تنمى لعمرو ما أساغَ الراحا",33,"ح",2,0],["وَبِباهر الحَمد الَّذي","عَنهُ لِساني تَرجَما",34,"م",2,0],["وَببيض الهند مُهجته","سَلَبتها الأَعيُن السودُ",35,"د",1,0],["وببَطْنِ وَجْرةَ والمَهامِهُ دونَه","رَشأٌ يُصابِحُني هوىً ويُماسي",36,"س",2,0],["وَبِبنتِ المُصطَفى مَن","أَشبَهَت فَضلاً أَباها",37,"ا",3,0],["وببابلٍ سَقَتِ الغوادي بابلاً","مُلقىً بآثارِ الخيام طريحُ",38,"ح",1,0],["وبِبابِكَ المحروسِ منهم عصبَةٌ","مستِّهُمُ البأساءُ والضرّاءُ",39,"ا",2,0],["وببغدادَ من أُحاولُ فيها","أشْرَفُ الحاضرين في بغداد",40,"د",1,0],["وببغداد ما حللت مقيماً","فالمقام المحمود في بغداد",41,"د",1,0],["وببرك المأمون قد برئت","روح التهاني وانتشى الطرب",42,"ب",1,0],["وببذله وبعدله وبفضله","غيث وغوث مع ثناء أوفر",43,"ر",1,0],["وببابها بسمت معالم جوده","كرما وحازت بالبها مرقاها",44,"ا",3,0],["وبباب عفوك قد وقف","ت وباب عفوك أي باب",45,"ب",1,0],["وببأسهم قد دوّخوا","دول القياصر والأكاسر",46,"ر",1,0],["وببَلخ لم تبدُ الذيو","لُ من الهِضابِ ولا القِنانُ",47,"ن",1,0],["وَبِبَطنِ مَكَّةَ لا أَبوحُ بِهِ","قُرشيَّةٌ غَلَبَت عَلى قَلبي",48,"ب",2,0],["وببيت حيدرة الأمير تسلَّقت","أفواجنا في كونها أبطالا",49,"ل",2,0],["وبِباهِرِ الحُسْنِ الَّذي منكَ انْجَلى","جَهْراً فكانَ من الكَواكِبِ أَحْسَنَا",50,"ن",2,0],["وببدرٍ ضاءَ كالبدرِ وقد","جفَلَتْ أَصحابُهُ فانْفَرَدَا",51,"د",2,0],["وببرّهِ لا تَسْتَعزَّ فإنّه","فخٌّ بحبّتِهِ يَكيدُ ويخدَعُ",52,"ع",1,0],["وبِبَيْنٍ بَعْدَ بَيْنٍ","مِنْكَ ما عِشْتُ بَلاني",53,"ن",2,0],["وَببَعضِ الأحيَانِ يَرسُبُ مِنهم","كم ثَقِيلٍ كأَنَّه ريبُ المَنونِ",54,"ن",1,0],["وببحر العلم عليٍّ مَنْ","قد فاح كروض مفترج",55,"ج",1,0],["وببعْضِ بأْسِك كم غَزوْ","تَ وكم قتلتَ بِكُلِّ غَلْبِ",56,"ب",1,0],["وَبِبَرقَةِ العَلَمَينِ ريمٌ لَم يَزَل","يُصمي بِناظِرَتَيهِ قَلبَ رَميِّهِ",57,"ي",2,0],["وَبِبَغداد شاعَ أَيضاً فَتاقت","لِلقاهُ وَحلمهِ وَلُهاهُ",58,"ا",2,0],["وَببحثه جَيش الخُطوبْ","يَفنى وَتحصده العللْ",59,"ل",1,0],