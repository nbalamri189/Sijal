{"poems":[[77,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[93,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[47,"لست أرجو النجاة","https://www.aldiwan.net/poem24816.html","الخفيف"],[72,"مذ قيل فرعك بالذوائب عرشا","https://www.aldiwan.net/poem19056.html","الكامل"],[51,"هل حاكم عدل الحكومة","https://www.aldiwan.net/poem66013.html","مجزوء الكامل"],[105,"مضت السيوف وولت الأرباب","https://www.aldiwan.net/poem44194.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55104","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54766","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67300","الكامل"],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""],[107,"شكرا فإنك قد رزق","https://www.aldiwan.net/poem16324.html","مجزوء الكامل"],[113,"اوقف العيس هذه بغداد","https://www.aldiwan.net/poem41171.html","عموديه"],[113,"لمعت بوارق دولة الإرشاد","https://www.aldiwan.net/poem41762.html","الكامل"],[113,"يا مرسلاً لاذ الورى بجنابه","https://www.aldiwan.net/poem42163.html","الكامل"],[141,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[141,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[227,"يا من به تزهى الدهور","https://www.aldiwan.net/poem51062.html","مجزوء الكامل"],[227,"ليس من ساد عن وراثته جد","https://www.aldiwan.net/poem51189.html","الخفيف"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[237,"بمحمد صلوا عليه وسلموا","https://www.aldiwan.net/poem23835.html","الكامل"],[257,"أصبحت مرآة لحسن مثالكم","https://www.aldiwan.net/poem35538.html","الكامل"],[257,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[257,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[257,"عند قطب التصريف طولا وعرضا","https://www.aldiwan.net/poem35966.html","الخفيف"],[269,"ضربوا الخيام على الكثيب الاخضر","https://www.aldiwan.net/poem52100.html","الكامل"],[280,"من لام لأن كبت البغله","https://www.aldiwan.net/poem32647.html","المتدارك"],[280,"كم من قطائف كالأما","https://www.aldiwan.net/poem32847.html","مجزوء الكامل"],[296,"لله وللمثل الأعلى","https://www.aldiwan.net/poem36299.html","عموديه"],[296,"أرأيت كيف ذرى الدموع وناحا","https://www.aldiwan.net/poem36810.html","عموديه"],[351,"وتذكرت عهد الهوى","https://www.aldiwan.net/poem39954.html","مجزوء الكامل"],[351,"منهل العشاق مورود","https://www.aldiwan.net/poem40392.html","المديد"],[362,"البحر أجمع لو غدا أنقاسي","https://www.aldiwan.net/poem60869.html","الكامل"],[390,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[399,"حتام أكتم ما الدموع تبيح","https://www.aldiwan.net/poem46754.html","الكامل"],[399,"مولاي للشعراء حق لازم","https://www.aldiwan.net/poem46923.html","الكامل"],[413,"ذكراني عهد الصبا بسعاد","https://www.aldiwan.net/poem54075.html","الخفيف"],[413,"هل تركتم غير الجوى لفؤادي","https://www.aldiwan.net/poem54177.html","الخفيف"],[426,"عوفي الندى والمجد والأدب","https://www.aldiwan.net/poem40710.html","أحذ الكامل"],[426,"حي الإله أمير نارب الندى","https://www.aldiwan.net/poem41006.html","الكامل"],[426,"انشا العلي بفضله دار العلى","https://www.aldiwan.net/poem41414.html","الكامل"],[438,"هل لي إلى عصر الشباب","https://www.aldiwan.net/poem14350.html","مجزوء الكامل"],[441,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[456,"إن تسأليني بعد قومي","https://www.aldiwan.net/poem55856.html","مجزوء الكامل"],[468,"قالت وقلت تحرجي وصلي","https://www.aldiwan.net/poem4643.html","أحذ الكامل"],[498,"قمنا لنساوت النبي مثالا","https://www.aldiwan.net/poem37629.html","الكامل"],[498,"ظهر بأعباء الغرام قد انحنى","https://www.aldiwan.net/poem37761.html","الكامل"],[498,"أيها المستحلف الليل أفق","https://www.aldiwan.net/poem38032.html","الرمل"],[512,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[527,"لم أزل أرقب وعدا","https://www.aldiwan.net/poem37113.html","مجزوء الرمل"],[536,"إسألوني عما رأيت بعيني","https://www.aldiwan.net/poem47588.html","عموديه"],[556,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[573,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"]],"verses":[["وَبِبَابِ مَوْلاَنَا الْمُؤَيَّدِ يُوسُفٍ","مَاشِئْتَ مِن حُسْنَى وَمِنْ إِحْسَانِ",0,"ن",1,0],["وَبِبعْضِ مَا أًسْدَيْتَ عظَّ مَقَامُهُمْ","فِيمَا نَأَى وَدَنَا مِنَ البُلْدَانِ",1,"ن",1,0],["وَبِبِنتِ الرَسولِ فاطِمَةِ الطُه","رِ وَسِبطَيهِ وَالإِمامِ عَلِيِّ",2,"ل",2,0],["وببعض ما فعلت بقلبي في الهوى","عيناك صارَ الليثُ صيداً للرشا",3,"ش",2,0],["وبباطني منها وسا","وس من هموم كالخصومِ",4,"م",1,0],["وببأسك انْصُرْنا وزَلْزِلْ جَمْعَهم","تَزُلِ الهمومُ وتَذهبِ الأوصابُ",5,"ب",1,0],["وبباقِي أصحابِكَ المُظْهِرِ التَّرْ","تيبِ فينا تَفْضِيلُهم والولاءُ",6,"ا",2,0],["وَببَذْل هَاتِيكَ الْقُوَى","أَنْفَذْتَ فِي عَجَلٍ قوَاكْ",7,"ك",1,0],["وَبِبَذْلِ جُهْدِكَ فِي الَّذِي","يُرضِيهِ صِرْتَ كَمَا أَرَادَك",8,"ك",1,0],["وَبِبَعْضِ الإِصْلاَحِ مِنْ شَأْنِ عَافٍ","يُتَّقَى طَائِلٌ مِنَ الإِفْسَادِ",9,"د",1,0],["وَبِبَأْسِهِ فِي الْحَرْبِ أَثْبَتَ أَنَّهُ","بَطَلُ الجِهَادِ البَاسِلُ الصِّنْدِيدُ",10,"د",1,0],["وبِبِئرِ بَدْرٍ إذْ يَرُدُّ وُجُوهَهُمْ","جِبْريلُ تَحْتَ لوائِنا وَمُحَمَّدُ",11,"د",1,0],["وَبَبِيتُ يَهْدِي بالدَرُوسِ، كأَنَّه","في الفَصْل بين إجابةٍ وسُؤال",12,"ل",1,0],["وببيتِ إبراهيمَ، وهْ","وَ من العروبة في الصميم",13,"م",1,0],["وَببشر وَجه المُكرَما","ت وَسَعد أَبناء المَوالي",14,"ي",1,0],["وبباب الجيلي قف مستفيضا","فهو سامي الذرى الهزبر الجواد",15,"د",1,0],["وببصرة صاد السباع بلفتة","ولوى ببأس شوكة الآساد",16,"د",1,0],["وببابه وقفت صدور الأصفيا","ومشت ملائكة السما بركابه",17,"ب",2,0],["وَبِبَعضِ ما بَلَغَت مَساعي رافِعٍ","تُحوى النَباهَةُ وَالمَحَلُّ الأَرفَعُ",18,"ع",1,0],["وَبِبَعضِ الَّذي أَنالَ مِنَ الإِك","رامِ رَبَّ النَوالِ رَبُّ النَوالِ",19,"ل",1,0],["وَببدرٍ لَدى عكاشةَ صارَت","منهُ سَيفاً جريدةٌ جرداءُ",20,"ا",2,0],["وببعده تدنو الكآ","بة والصبابة والزفير",21,"ر",1,0],["وببطشٍ يَفْري الجماجمَ والأَعْ","ناق فَرْيّ لحومَ الأضاحي",22,"ح",2,0],["وَبِبأسِهِ المَرهوب آلَة حَربِهِ","فَتَكَت بِكُلِّ مُسايِفٍ مِطعانِ",23,"ن",1,0],["وببرهة عم البسيطة كلها","دين لأحوال العباد منظم",24,"م",1,0],["وببعض عشقي عشق خضراء الدمن","وإذا غفلت بكم فلا سلوى ومن",25,"ن",1,0],["وببحر القدرة والمرَجِ","بسنا الرضوان وجنّته",26,"ه",1,0],["وببدر سماء رسالتهم","طه ذي الرفعة والشرف",27,"ف",1,0],["وَبِباقي الأَصحابِ مَن أَقرَضوا اللَ","هَ بِأَرواحِهِم لِدينِكَ قَرضا",28,"ض",2,0],["وَبِبَطن كفك سبحت صم الحصى","وَكَذاكَ حن الجذع يوم المنبر",29,"ر",1,0],["وَبِبَحرَ العِلمِ وَطَودِ الحِل","مِ كَبَت وَسِواهُ اخبر تَقلَه",30,"ل",2,0],["وَبِبَعلَبَكَّ كَأَنَّني","ما كُنتُ قَطُّ عَرَفتُها",31,"ت",3,0],["وَببذلِ الروحِ تواصينا","بالدمِ والدمع لك السقيا",32,"ي",2,0],["وَ (ببعلبكَ) حوادثٌ لو أنها","تنمى لعمرو ما أساغَ الراحا",33,"ح",2,0],["وَبِباهر الحَمد الَّذي","عَنهُ لِساني تَرجَما",34,"م",2,0],["وَببيض الهند مُهجته","سَلَبتها الأَعيُن السودُ",35,"د",1,0],["وببَطْنِ وَجْرةَ والمَهامِهُ دونَه","رَشأٌ يُصابِحُني هوىً ويُماسي",36,"س",2,0],["وَبِبنتِ المُصطَفى مَن","أَشبَهَت فَضلاً أَباها",37,"ا",3,0],["وببابلٍ سَقَتِ الغوادي بابلاً","مُلقىً بآثارِ الخيام طريحُ",38,"ح",1,0],["وبِبابِكَ المحروسِ منهم عصبَةٌ","مستِّهُمُ البأساءُ والضرّاءُ",39,"ا",2,0],["وببغدادَ من أُحاولُ فيها","أشْرَفُ الحاضرين في بغداد",40,"د",1,0],["وببغداد ما حللت مقيماً","فالمقام المحمود في بغداد",41,"د",1,0],["وببرك المأمون قد برئت","روح التهاني وانتشى الطرب",42,"ب",1,0],["وببذله وبعدله وبفضله","غيث وغوث مع ثناء أوفر",43,"ر",1,0],["وببابها بسمت معالم جوده","كرما وحازت بالبها مرقاها",44,"ا",3,0],["وبباب عفوك قد وقف","ت وباب عفوك أي باب",45,"ب",1,0],["وببأسهم قد دوّخوا","دول القياصر والأكاسر",46,"ر",1,0],["وببَلخ لم تبدُ الذيو","لُ من الهِضابِ ولا القِنانُ",47,"ن",1,0],["وَبِبَطنِ مَكَّةَ لا أَبوحُ بِهِ","قُرشيَّةٌ غَلَبَت عَلى قَلبي",48,"ي",1,0],["وببيت حيدرة الأمير تسلَّقت","أفواجنا في كونها أبطالا",49,"ل",2,0],["وبِباهِرِ الحُسْنِ الَّذي منكَ انْجَلى","جَهْراً فكانَ من الكَواكِبِ أَحْسَنَا",50,"ن",2,0],["وببدرٍ ضاءَ كالبدرِ وقد","جفَلَتْ أَصحابُهُ فانْفَرَدَا",51,"د",2,0],["وببرّهِ لا تَسْتَعزَّ فإنّه","فخٌّ بحبّتِهِ يَكيدُ ويخدَعُ",52,"ع",1,0],["وبِبَيْنٍ بَعْدَ بَيْنٍ","مِنْكَ ما عِشْتُ بَلاني",53,"ن",2,0],["وَببَعضِ الأحيَانِ يَرسُبُ مِنهم","كم ثَقِيلٍ كأَنَّه ريبُ المَنونِ",54,"ن",1,0],["وببحر العلم عليٍّ مَنْ","قد فاح كروض مفترج",55,"ج",1,0],["وببعْضِ بأْسِك كم غَزوْ","تَ وكم قتلتَ بِكُلِّ غَلْبِ",56,"ب",1,0]]}