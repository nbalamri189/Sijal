{"poems":[[77,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[93,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[47,"لست أرجو النجاة","https://www.aldiwan.net/poem24816.html","الخفيف"],[72,"مذ قيل فرعك بالذوائب عرشا","https://www.aldiwan.net/poem19056.html","الكامل"],[51,"هل حاكم عدل الحكومة","https://www.aldiwan.net/poem66013.html","مجزوء الكامل"],[105,"مضت السيوف وولت الأرباب","https://www.aldiwan.net/poem44194.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55104","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54766","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67300","الكامل"],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""]],"verses":[["وَبِبَابِ مَوْلاَنَا الْمُؤَيَّدِ يُوسُفٍ","مَاشِئْتَ مِن حُسْنَى وَمِنْ إِحْسَانِ",0,"ن",1,0],["وَبِبعْضِ مَا أًسْدَيْتَ عظَّ مَقَامُهُمْ","فِيمَا نَأَى وَدَنَا مِنَ البُلْدَانِ",1,"ن",1,0],["وَبِبِنتِ الرَسولِ فاطِمَةِ الطُه","رِ وَسِبطَيهِ وَالإِمامِ عَلِيِّ",2,"ل",2,0],["وببعض ما فعلت بقلبي في الهوى","عيناك صارَ الليثُ صيداً للرشا",3,"ش",2,0],["وبباطني منها وسا","وس من هموم كالخصومِ",4,"م",1,0],["وببأسك انْصُرْنا وزَلْزِلْ جَمْعَهم","تَزُلِ الهمومُ وتَذهبِ الأوصابُ",5,"ب",1,0],["وبباقِي أصحابِكَ المُظْهِرِ التَّرْ","تيبِ فينا تَفْضِيلُهم والولاءُ",6,"ا",2,0],["وَببَذْل هَاتِيكَ الْقُوَى","أَنْفَذْتَ فِي عَجَلٍ قوَاكْ",7,"ك",1,0],["وَبِبَذْلِ جُهْدِكَ فِي الَّذِي","يُرضِيهِ صِرْتَ كَمَا أَرَادَك",8,"ك",1,0],["وَبِبَعْضِ الإِصْلاَحِ مِنْ شَأْنِ عَافٍ","يُتَّقَى طَائِلٌ مِنَ الإِفْسَادِ",9,"د",1,0],["وَبِبَأْسِهِ فِي الْحَرْبِ أَثْبَتَ أَنَّهُ","بَطَلُ الجِهَادِ البَاسِلُ الصِّنْدِيدُ",10,"د",1,0],["وبِبِئرِ بَدْرٍ إذْ يَرُدُّ وُجُوهَهُمْ","جِبْريلُ تَحْتَ لوائِنا وَمُحَمَّدُ",11,"د",1,0],["وَبَبِيتُ يَهْدِي بالدَرُوسِ، كأَنَّه","في الفَصْل بين إجابةٍ وسُؤال",12,"ل",1,0],["وببيتِ إبراهيمَ، وهْ","وَ من العروبة في الصميم",13,"م",1,0]]}