2,"قالوا قحوم","https://www.poetsgate.com/ViewPoem.aspx?id=177824",""],[3856,"قَالُوا: الزَّمانُ كفيلٌ أنْ يُسَلِّينا","https://www.poetsgate.com/ViewPoem.aspx?id=215908",""],[5794,"قلب جدا ..","https://www.poetsgate.com/ViewPoem.aspx?id=80286",""],[5821,"رجل المواقف","https://www.poetsgate.com/ViewPoem.aspx?id=114116",""],[5879,"خماسيات (3)","https://www.poetsgate.com/ViewPoem.aspx?id=215442",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[5956,"يسبح البحر إلى الشط الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=181893",""],[5956,"صور أشواق زوجتي إليّ","https://www.poetsgate.com/ViewPoem.aspx?id=182397",""],[5956,"من فضائل الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=192552",""],[5956,"يُسَبِّح الطير ربّه","https://www.poetsgate.com/ViewPoem.aspx?id=192609",""],[6117,"شَهْرُ رَمَضَانْ الْمُبَارَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=182798",""],[6239,"النشيد العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75976&r=&rc=27",""],[6275,"الشاردة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83618&r=&rc=10",""],[6318,"الجمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66160&r=&rc=10",""],[5190,"للأرض وجهٌ آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78324&r=&rc=37",""],[572,"حَسْبي مِنَ البزاة ِ والزدادِق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9407&r=&rc=264",""]],"verses":[["يسبي القلوب بلفظه وبلحظه","وَافِتْنَتي بين التكلم والنظرْ",0,"ر",1,0],["يَسُبُّهُمُ بِسَبّي كُلُّ قَومٍ","إِذا اِبتُدِرَت مُحاوَرَةُ الجَوابِ",1,"ب",1,0],["يسبحن إن جئت حتى أقوم","ويحمدن إن قمت حمداً كثيراً",2,"ر",2,0],["يسبقُ الوعدَ بالنوالِ فلا يح","وِجُ قصَّادهُ إلى الشفعاء",3,"ا",2,0],["يسبِّح الله حين يبصرها","فيا له عابداً على حرف",4,"ف",1,0],["يسبح في الجهل وفي طَخْيائِهِ","وهو لدى الإخوان من جفائِهِ",5,"ا",3,0],["يسبق معروفُهُ العِدات وإن","قدّم وعداً حسبتَه نذره",6,"ر",2,0],["يسبي القلوبَ بمقلةٍ مكحولةٍ","بفتورِ غُنْجٍ لا فتور نعاس",7,"س",1,0],["يسبطرّون ثم يُولجُ فيهم","مدمَجاتٌ تشفي الحُلاق الدفينا",8,"ن",2,0],["يسبطرون تارةً ليُناكوا","ويُحبّون تارةً مُذعنينا",8,"ن",2,0],["يَسبينَ قَلبي بِأَطرافٍ مُخَضَّبَةٍ","وَبِالعُيونِ وَما وارَينَ بِالخُمُرِ",9,"ر",1,0],["يَسبِقنَ بِالقَصدِ وَالإيغالِ كَرَّتَهُ","إِذا تَفَرَّقنَ عَنهُ وَهوَ مُندَفِعُ",10,"ع",1,0],["يسبها لا لذنب ثم يركلها","بالرجل منه مهينا وهي تحتمل",11,"ل",1,0],["يسبح في عرض السماء وطولها","ملائكة لِلّه غير ميامين",12,"ن",1,1],["يسبق شأو الريح في الصفوف","فالهارب المطلق كالمكتوف",13,"ف",1,0],["يُسبِّحُ ربَّهُ غِبَّ ارتياحِ","ويحمَدُه بألسنةٍ فِصاحِ",14,"ح",1,0],["يَسبُقُ شَأوَ النَظَرِ الرَحيبِ","أَسرَعُ مِن ماءٍ إِلى تَصويبِ",15,"ب",1,0],["يَسُبُّ عِرضي وَأَقي عِرضَهُ","كَذالِكَ المَحبوبُ مَسبوبُ",16,"ب",1,0],["يَسبي القُلوبَ بِدَلِّهِ","وَالطَرفِ مِنهُ إِذا نَظَر",17,"ر",1,0],["يَسبَحنَ في عَدرَةِ السَماءِ كَما","شَقَّ العَدَولِيُّ زاخِراً صَخِبا",18,"ب",2,0],["يُسَبِّحنَ المَليكَ بِكُلِّ جُنحٍ","وَيَركَعنَ الضُحى مُتَأَثِّمَتِ",19,"ت",1,0],["يُسَبِّحُ كَيما يَغفِرُ اللَهُ ذَنبَهُ","رُوَيدَكَ في عَهدِ الصِبا مُلِىءَ الطِرسُ",20,"س",1,0],["يَسبُكُ الصائِغُ الزُجاجَ وَلا يَس","تَطيعُ سَبكاً لِلدُرِّ إِن يَتَشَظّى",21,"ظ",2,0],["يُسبَبنَ بِالفِعلِ فَأَمّا إِذا","قيلَ فَما يَعلَمنَ يَوماً سُبِبنَ",22,"ن",1,0],["يَسبِقُ الأَلفَ بِالمُدَجَّجِ ذي القَو","نَسِ حَتّى يَؤوبَ كَالتِمثالِ",23,"ل",1,0],["يسبح النور على أرجائها","ويفيضُ الحق من ينبوع قدس",24,"س",1,0],["يَسبِقُني لِذِكرِهِ","دَمعٌ إِذا غيضَ وَثم",25,"م",1,1],["يَسُبُّني الحَسودُ وَلا أُبالي","بَقائي مُهجَتهُ بَقائي",26,"ا",3,0],["يسبحُ المرءُ في محيطِ الأماني","والمنايا منه كحبل الوريد",27,"د",1,0],["يَسبِي العيُونَ بلدنِ قا","مته ودقَّةِ خَصره",28,"ر",2,0],["يُسبّحنَ المليكَ بكلّ جُنحٍ،","ويركعنَ الضّحى متأثّمات",29,"ت",1,0],["يَسْبون أبكارَ المعاني حيثما","شنُّوا الإغارةَ وهي غيرُ حرامِ",30,"م",1,0],["يُسب إله العرش فيكم وكلكم","حضور ألا لا قدست من محاضر",31,"ر",1,0],["يسبق البرقَ وينأى وادِعا","عنه بالتقريب أو بالْخَبَب",32,"ب",1,0],["يَسْبيهِ طَرْفٌ للسِّنانِ وأجردٌ","طِرْفٌ ولا يسبيه طَرْفٌ أدعَج",33,"ج",1,0],["يسبي برقة سمرةٍ دريَّةٍ","فاللون درٌّ والغشاوة جوهرُ",34,"ر",1,0],["يسبيك لحظا قد حماه فاترا","ويروق ثغرا باردا ومفلجا",35,"ج",2,0],["يسبح في بحر خرا","إذا جرى تموجا",36,"ج",2,0],["يسبُّ ويلعنُ الورقاتِ سخطاً","ويرميها فتسقطُ كالشرار",37,"ر",1,0],["يَسبِقانِ المَنونَ طَعناً وَضَرباً","وَيَفُكّانِ كُلَّ كَبلٍ وَعانِ",38,"ن",1,0],["يسبق فيها القدم الخاطر","والحي والميتُ لديها سواء",39,"ا",2,0],["يَسبِقُ الرَّعدَ ببَرقٍ مثْلَما","يَبْدُر الزَّجْرُ بلَمْعِ الحاجبَيْن",40,"ن",1,0],["يُسبِّبُ لي في كلِّ أرضٍ مَودَّةً","ويَعزمُ بي عَنها إذا تَمَّ عَزمُها",41,"ه",2,0],["يسبت راعيها وهي رضارض","سبت الوقيض والوريد نابض",42,"ض",1,0],["يُسْبِي القلوبَ بِمقْلَةٍ سَحّارةٍ","هاروتُ فِتْنَتِها يحلّ ويعقدُ",43,"د",1,0],["يسبق البرق إن جرى يدرك الفا","ية من قبل تنتهي الأوهام",44,"م",1,0],["يسبِقُ القولَ إذا قال نعم","في رهانِ الجودِ شَوطاً بالفعالِ",45,"ل",1,0],["يسبِقني سعياً لما أُريده","حتى لقد أدرك بي ما لم أُرِدْ",46,"د",1,0],["يَسْبقُ الجودَ بعُذْرٍ فإذا","جادَ لم يُتْبِعْ نَداهُ المِنَنا",47,"ن",2,0],["يسبحته التي أعلا وأغلا","من الياقوت قدراً واللجين",48,"ن",1,0],["يسبح النونُ بالهضاب ولو","جاوزنَ قافاً إذ يهتكون اللاذما",49,"م",2,0],["يسبح اسمك زلفى","الى جلالة مجدك",50,"ك",1,0],["يسبقُ بالفضلِ ظَنَّ صاحبهِ","وَيقتلُ الريثَ عرفهُ العَجلُ",51,"ل",1,0],["يَسبِي العيونَ بحُسنِ خدٍّ مونقٍ","حاز الجمالَ وغضِّ قَدٍّ مورقِ",52,"ق",1,0],["يَسبِقُ الفعلُ منهُ قولي فما أُد","ركُهُ لو رَكبتُ مَتْنَ النَعامَهْ",53,"م",2,0],["يسبقُ الخَلْقَ في طريقِ المَعَالي","وجَرى كُلُّ مَنْ جَرى فتَعَثَّرْ",54,"ر",1,0],["يَسبِقُ القَولَ مِنكَ فِعلٌ إِذا ما","سَبَقَ القَولُ في الأَنامِ الفِعالا",55,"ل",2,0],["يسبحها السبوح في سبحاته","بتسبيح روح الروح في السبحية",56,"ه",1,0],["يسبّح لا من تُقىً أحمدٌ","يحبّ التطرّف بالسبحةِ",57,"ح",2,1],["يسبق منه الأنعام سائله","فلا يرى ممطلا ولا واعد",58,"د",1,0],["يَسبيك منها إِن نظرتَ مخلخلٌ","وَموشّحٌ وَمدملجٌ ومجلببُ",59,"ب",1,0],["يَسبيكَ مِنهُ مُفلِجٌ وَمُضَرِّجُ","وَمُقَوَّمٌ وَمُعَوَّجٌ وَمُهَفهَفُ",60,"ف",1,0],["يسبح البدْر فيه بين الدرارى","والصبايا بمائه تتمرّى",61,"ر",2,0],["يَسبَحُ في بَحرٍ طَما لُجُّهُ","أَضحى يُنادي مِنهُ يا لِلغَريق",62,"ق",1,0],["يَسْبقُ طَرْفَ العينِ مِنْ طِرْفِهِ","بِسابقٍ يُعْزَى إلى لاحقِ",63,"ق",1,0],["يَسْبي العَقائلَ والعُقولَ جميعُها","مِنْ صائغ لنُضارِها سَبّاكِ",64,"ك",1,0],["يسبي عقول ذوي الهوى","إن في شمائله خطر",65,"ر",1,0],["يسبي ويقتل ما يلقاه من أحد","كأنما ألبس الإسلام خذلانا",66,"ن",2,0],["يَسبِقُ الوَعدَ بِالنَوالِ كَما يَس","بِقُ بَرقُ الغُيوثِ صَوبَ الغَمامِ",67,"م",1,0],["يسبي الورى مهما دنا وانثنى","بصارم اللحظ ولدْن القوام",68,"م",1,0],["يسبي العيون بغنجٍ","افدي بروحي غنجه",69,"ج",2,0],["يسبك الألْفَاظَ تِبْراً","بَعْدَمَا كَانَتْ لُجَيْن",70,"ن",1,0],["يَسُبُّهُمُ القَومُ اللِئامُ وَإِنَّما","يَزيدُهُمُ في قَدرِهِم ذَلِكَ السَبُّ",71,"ب",1,0],["يسبي العقول إذا ما ماس في حلل","من الجمال وكم قلب به علقا",72,"ق",2,0],["يسب بها عقبي خلافي إذا دعوا","وليس بماح عارها عني القبر",73,"ر",1,0],["يسبق بالحلم الوعيد مثلما","منه النوال للوعود يسبق",74,"ق",1,0],["يسبق عن ردفه النطاق وقد","جالت على خصره الزنانير",75,"ر",1,0],["يسبح في بحر بلا ساحلٍ","في حِندِسِ الغيب وظلمائه",76,"ا",3,0],["يَسبي فُؤادَكَ مِنها","دَلالُها وَالمِزاجُ",77,"ج",1,0],["يَسبِقُ السَّمهَرِيُّ طولاً وَطَولاً","وَيَفوتُ الهِندِيَّ أَثراً وَأَثرا",78,"ر",2,0],["يسبي الظبا في لفتات جيده","في لفتات جيده يسبي الظبا",79,"ب",2,0],["يسبقني اليراع مدحا فارى","من اليراع ما يريني العجبا",79,"ب",2,0],["يسبح اللَه مستقلّا","لواحفيه ملكُ الهواء",80,"ا",2,0],["يسبق الطرف ان جرى الطرف منه","ويفوت السهام عند المروق",81,"ق",1,0],["يسبي الخواطر حسنه ببديعه","يصبي النفوس جماله بأنيقه",82,"ق",2,0],["يَسبِقُ الخَيلَ بِتَقري","بٍ وَشَدٍّ كَالرِّياحِ",83,"ح",1,0],["يسبَحْن طوراً في الدِّماء وتارةً","يركُضْنَ فوق جماجمِ الشّجعانِ",84,"ن",1,0],["يسبيك بالخصر النحي","ل ويأخذ الأسباب نحله",85,"ل",2,0],["يسبي النهى بصوارم اللحظ التي","أجفانها الوسنى نفت عني الوسن",86,"ن",1,0],["يسبي ويفتك باللحا","ظ كأنها بيض الصوارم",87,"م",1,0],["يسبي العقول بكاسيه ومقلته","فما يناديه الا كل مفتون",88,"ن",1,0],["يسبح فوق العود بلبلها لمن","براه كما غنى ع