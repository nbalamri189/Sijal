{"poems":[[3,"ضحكت عبيلة إذ رأتني عارياَ","https://www.aldiwan.net/poem170.html",""],[86,"بالذي أجراك يا ريح الخزامى","https://www.aldiwan.net/poem10684.html","الرمل"],[93,"كانت عيون الريب الساهره","https://www.aldiwan.net/poem11137.html","السريع"],[51,"وهب يا واهب الهبات اللواتي","https://www.aldiwan.net/poem8310.html","الخفيف"],[51,"كم نسام الأذى كأنا كلاب","https://www.aldiwan.net/poem8534.html","الخفيف"],[51,"ما لمن حسنه الله وأعلى درجاته","https://www.aldiwan.net/poem8696.html","مجزوء الرمل"],[51,"يا أبا نصر وما للمرء في","https://www.aldiwan.net/poem64966.html","الرمل"],[51,"يا أبا المستهل ماذا تقول","https://www.aldiwan.net/poem65846.html","الخفيف"],[51,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[91,"قالت لجارتها يوما تسائلها","https://www.aldiwan.net/poem62759.html","عموديه"],[85,"أيها القصر أترعى عهدنا","https://www.aldiwan.net/poem7047.html","الرمل"],[45,"بين أفق الصبا وأفق الدبور","https://www.aldiwan.net/poem63589.html","الخفيف"],[58,"لا تضع المعروف في ساقط","https://www.aldiwan.net/poem30976.html","السريع"],[58,"إصبر على مضض الإدلاج في السحر","https://www.aldiwan.net/poem31066.html","البسيط"],[49,"الله أكرم من يناجى","https://www.aldiwan.net/poem62026.html","مجزوء الكامل"],[21,"اصبر النفس عند كل ملم","https://www.aldiwan.net/poem36167.html","الخفيف"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[48,"إن كان يحيى يقدر","https://www.aldiwan.net/poem66289.html","المجتث"],[46,"تلا كتاب الله من حفظه","https://www.aldiwan.net/poem23001.html","السريع"],[15,"صبر النفس عند كل ملم","https://www.aldiwan.net/poem45248.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85581","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54999","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142021","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43720","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[51,"يا كريماً لم يزل محتمِلا","https://www.poetsgate.com/ViewPoem.aspx?id=30692",""],[51,"ما لمن حَسَّنَهُ اللَّ","https://www.poetsgate.com/ViewPoem.aspx?id=27198",""]],"verses":[["لا تَضحَكي مِنّي عُبَيلَةُ وَاِعجَبي","مِنّي إِذا اِلتَفَّت عَلَيَّ جُيوشُ",0,"ش",1,0],["لا تَضِق ذَرعاً بِما قالَ العِدا","رُبَّ ذي لُبٍّ عَنِ الحَقِّ تَعامى",1,"م",2,0],["لا تُضْمِرُ المِرْآةُ فِي زَعْمِهَا","شَيْئاً وَرَاءَ الصُّورَةِ الظَّاهِرَهْ",2,"ر",2,0],["لا تُضِعْني فإن شكريَ كنزٌ","يتهادَى تُراثَهُ الأعقابُ",3,"ب",1,0],["لا تُضِلَّنَّ باحتجابك آما","لاً هداها إليك منك اجتلابُ",4,"ب",1,0],["لا تُضِعْ إحسانَ ذي الإح","سانِ يا خير رعاتِهْ",5,"ت",2,0],["لا تُضيِّع مثل وُدّي إنه","صادقُ الصحة ما فيه مَرَض",6,"ض",1,0],["لا تُضِعْهُ فإنك ابنُ دلالٍ","والدَّجاجُ السمينُ طعمٌ ثقيلُ",7,"ل",1,0],["لا تُضِق عفوك عني واجْزني","يا فسيحَ العفوِ يا رحبَ العَطَن",8,"ن",1,0],["لا تَضحَكوا وَبِأَرضِ الشامِ نائِحَةٌ","وَلا تَناموا وَفي لُبنانَ سَهرانُ",9,"ن",1,0],["لا تُضع عندك أسرار الهوى","واختزنها في الزوايا والحنِى",10,"ا",1,0],["لا تُضامُنَّ حاجَتي وَأَبو طَلحَةَ مَن","صورُكَ الشَريفُ نَصيري",11,"ر",2,0],["لا تَضَعِ المَعروفَ في ساقِطٍ","فَذاكَ صِنعُ ساقِطٍ ضائِعُ",12,"ع",1,1],["لا تَضجَرَنَّ وَلا يَحزُنكَ مَطلَبُها","فَالنَجحُ يَتلَفُ بَينَ العَجزِ والضَجَرِ",13,"ر",1,0],["لا تَضجَرَنَّ لِضيقَةٍ","يَوماً فَإِنَّ لَها انفِراجا",14,"ج",2,0],["لا تَضيقَنَّ بِالأُمورِ فَقَد","يُكشَفُ غَمّاؤُها بِغَيرِ اِحتيالِ",15,"ل",1,0],["لا تُضْحِكُ الدُّنيا لهُ سِنّاً وَما","لَمْ يُؤْتَ منها عَدَّهُ تَنوِيلا",16,"ل",2,0],["لا تضمر الهجرَ إنّي","حلفتُ إن أنتَ تهجر",17,"ر",1,0],["لا تَضِفِ الشارِبَ في سُكرِهِ","وَلا تُنَزِّلهُ وَلا تُلحِفِ",18,"ف",1,0],["لا تَضيقَنَّ في الأُمورِ فَقَد تُك","شَفُ غَمّاؤُها بِغَيرِ اِحتِيالِ",19,"ل",1,0],["لا تضمري يأساً فَلا","يَبقى الزَمان على قرار",20,"ر",1,0],["لاَ تضِنُّوا يَا أَحِبَّائِي فَمَا","مَنْ يُضِيعُ المَالَ فِي الخَيْرِ مُضِيعْ",21,"ع",1,0],["لا تضنّي على الحراب وإن آذتك","بل عطري رؤوس الحراب",22,"ب",1,0],["لا تَضعَنَّ المُشتَري في الثَرى","وَاِجعَل لَهُ أَوجُهَنا بُسطا",23,"ط",2,0],["لا تضُمُّوا إلى أَسَاهُ عَمَى الْجَهْ","لِ فيلْقَى النكَالَ بَعْد النكَالِ",24,"ل",1,0],["لا تَضِلُّ الشُعُوبُ مِصْباحُها العِلْمُ","يُؤاخِيهِ راسِخُ الإيمانِ",25,"ن",1,0],["لا تُضِق عفوك عني واجْزني","يا فسيخَ العفوِ يا رحبَ العَطَنْ",26,"ن",1,0],["لا تُضع إحسانَ في الإح","سانِ يا خير رعاتِهْ",27,"ت",2,0]]}