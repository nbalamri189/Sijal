dctabudhabi.ae/diwan/poem/136642",""],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28755","الكامل"],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130263","الكامل"],[4797,"يالعقاب","https://www.poetsgate.com/ViewPoem.aspx?id=51280",""],[4888,"مدرسة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=207751",""],[4929,"أين المفر","https://www.poetsgate.com/ViewPoem.aspx?id=199259",""],[4929,"بين الموتين","https://www.poetsgate.com/ViewPoem.aspx?id=201011",""],[5145,"من لبرقٍ على البراق أنارا","https://www.poetsgate.com/ViewPoem.aspx?id=108062",""],[5344,"ان شفت طبع البشر كدرك..","https://www.poetsgate.com/ViewPoem.aspx?id=183174",""],[5356,"إصبعي مخدوش","https://www.poetsgate.com/ViewPoem.aspx?id=205813",""],[5431,"القصيدة الكونية ..وثقبُ الكون سبّاقُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=199015",""],[5689,"ما بال دمعك ينهمر","https://www.poetsgate.com/ViewPoem.aspx?id=143433",""],[5722,"الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=12682",""],[5730,"قرارٌ سياديّ","https://www.poetsgate.com/ViewPoem.aspx?id=210356",""],[402,"كانت عيون الريب الساهرة","https://www.poetsgate.com/ViewPoem.aspx?id=36585",""],[5784,"زمن العجب","https://www.poetsgate.com/ViewPoem.aspx?id=202250",""],[5956,"لا تضربوا الحيوان","https://www.poetsgate.com/ViewPoem.aspx?id=183383",""],[6099,"زهد","https://www.poetsgate.com/ViewPoem.aspx?id=35164",""]],"verses":[["لا تَضحَكي مِنّي عُبَيلَةُ وَاِعجَبي","مِنّي إِذا اِلتَفَّت عَلَيَّ جُيوشُ",0,"ش",1,0],["لا تَضِق ذَرعاً بِما قالَ العِدا","رُبَّ ذي لُبٍّ عَنِ الحَقِّ تَعامى",1,"م",2,0],["لا تُضْمِرُ المِرْآةُ فِي زَعْمِهَا","شَيْئاً وَرَاءَ الصُّورَةِ الظَّاهِرَهْ",2,"ر",2,0],["لا تُضِعْني فإن شكريَ كنزٌ","يتهادَى تُراثَهُ الأعقابُ",3,"ب",1,0],["لا تُضِلَّنَّ باحتجابك آما","لاً هداها إليك منك اجتلابُ",4,"ب",1,0],["لا تُضِعْ إحسانَ ذي الإح","سانِ يا خير رعاتِهْ",5,"ت",2,0],["لا تُضيِّع مثل وُدّي إنه","صادقُ الصحة ما فيه مَرَض",6,"ض",1,0],["لا تُضِعْهُ فإنك ابنُ دلالٍ","والدَّجاجُ السمينُ طعمٌ ثقيلُ",7,"ل",1,0],["لا تُضِق عفوك عني واجْزني","يا فسيحَ العفوِ يا رحبَ العَطَن",8,"ن",1,0],["لا تَضحَكوا وَبِأَرضِ الشامِ نائِحَةٌ","وَلا تَناموا وَفي لُبنانَ سَهرانُ",9,"ن",1,0],["لا تُضع عندك أسرار الهوى","واختزنها في الزوايا والحنِى",10,"ا",1,0],["لا تُضامُنَّ حاجَتي وَأَبو طَلحَةَ مَن","صورُكَ الشَريفُ نَصيري",11,"ر",2,0],["لا تَضَعِ المَعروفَ في ساقِطٍ","فَذاكَ صِنعُ ساقِطٍ ضائِعُ",12,"ع",1,1],["لا تَضجَرَنَّ وَلا يَحزُنكَ مَطلَبُها","فَالنَجحُ يَتلَفُ بَينَ العَجزِ والضَجَرِ",13,"ر",1,0],["لا تَضجَرَنَّ لِضيقَةٍ","يَوماً فَإِنَّ لَها انفِراجا",14,"ج",2,0],["لا تَضيقَنَّ بِالأُمورِ فَقَد","يُكشَفُ غَمّاؤُها بِغَيرِ اِحتيالِ",15,"ل",1,0],["لا تُضْحِكُ الدُّنيا لهُ سِنّاً وَما","لَمْ يُؤْتَ منها عَدَّهُ تَنوِيلا",16,"ل",2,0],["لا تضمر الهجرَ إنّي","حلفتُ إن أنتَ تهجر",17,"ر",1,0],["لا تَضِفِ الشارِبَ في سُكرِهِ","وَلا تُنَزِّلهُ وَلا تُلحِفِ",18,"ف",1,0],["لا تَضيقَنَّ في الأُمورِ فَقَد تُك","شَفُ غَمّاؤُها بِغَيرِ اِحتِيالِ",19,"ل",1,0],["لا تضمري يأساً فَلا","يَبقى الزَمان على قرار",20,"ر",1,0],["لاَ تضِنُّوا يَا أَحِبَّائِي فَمَا","مَنْ يُضِيعُ المَالَ فِي الخَيْرِ مُضِيعْ",21,"ع",1,0],["لا تضنّي على الحراب وإن آذتك","بل عطري رؤوس الحراب",22,"ب",1,0],["لا تَضعَنَّ المُشتَري في الثَرى","وَاِجعَل لَهُ أَوجُهَنا بُسطا",23,"ط",2,0],["لا تضُمُّوا إلى أَسَاهُ عَمَى الْجَهْ","لِ فيلْقَى النكَالَ بَعْد النكَالِ",24,"ل",1,0],["لا تَضِلُّ الشُعُوبُ مِصْباحُها العِلْمُ","يُؤاخِيهِ راسِخُ الإيمانِ",25,"ن",1,0],["لا تضيقوا فإنّ للشرف العالي","رجالا وللدنايا رجالا",26,"ل",2,0],["لا تضيفوا \"إنّ العروبه تدري","من \" جمال \" وتعرف \" السلالا \"",26,"ل",2,0],["لا تضيقي فلم يعد ذاك سرا","إن أقوى الرياح ريح القذارة",27,"ر",2,0],["لا تُضِق عفوك عني واجْزني","يا فسيخَ العفوِ يا رحبَ العَطَنْ",28,"ن",1,0],["لا تُضع إحسانَ في الإح","سانِ يا خير رعاتِهْ",29,"ت",2,0],["لا تضيقي فلم يعد ذاك سرا","إن أقوى الرياح ريح القذراه",30,"ر",3,0],["لَا تَضع سَهم مُقلَتيهِ فَوادي","ضِمنَ تِلكَ السِهام أَلف شَهادَه",31,"ه",1,0],["لا تَضيعوا من إَلَيكُم سَلموا","أَمرَهُم لَما عَلَيكُم أَقدموا",32,"م",3,1],["لا تضيعني وخذ لي بيدي","فلك المختار اعطى خير يد",33,"د",1,0],["لا تضيعوا عهد المحبة إني","ضعت وجداً فيكم وآهى طالا",34,"ل",2,0],["لا تضيعني وخذ لي بيدي","إنني منتظر منك انتصارك",35,"ك",1,0],["لا تضيعني وخذ لي بيدي","وصل الحبل وعاملني بما",36,"م",2,0],["لا تُضمِروا حَسَداً مَحصولُهُ عَطَبٌ","إِنَّ التَحاسُدَ أَفنى آلَ ذُبيانا",37,"ن",2,0],["لا تضق ذرعاً بخطب نازلٍ","ربما جاءك خطبٌ ومضى",38,"ض",2,1],["لا تضمرنَّ على ذي نعمة حسداً","إنَّ الحسود من الرحمن مبتعد",39,"د",1,0],["لا تُضِعْ يا صاحِ لذَّا","تِكَ فالعُمْرُ قَصيرُ",40,"ر",1,0],["لا تضّني يا ظبيةٌ إن تحيي","عاشقاً هامَ في النقا والكثيبِ",41,"ب",1,0],["لا تضحك الجاهلَ في نفسهِ","إلا بكى في نفسهِ العاقلُ",42,"ل",1,0],["لا تضِق بالدهر ذَرعا","واقتل الدهر جِهارَا",43,"ر",2,1],["لاَ تُضَيِّعْ خُطىً وَصَلْنَا بِهَا مَثْ","وَاكَ مَثْوَى السَّنَا الْمُزِيحِ النُّحُوسَا",44,"س",2,0],["لا تضحَكي ممَّن عواطفُهُ","ظهرت بألحاظٍ وأقوال",45,"ل",1,0],["لا تضني بالدمع يا عين ما الدمعُ","إذا جلّ حادثُ الدهر غالي",46,"ل",2,1],["لا تضعني فلست منك مضيعاً","ذمة الحب والأيادي الجميله",47,"ل",2,0],["لا تضجّى ولا تضيقي بصمتي","فهو زادي وعدّتي وعتادي",48,"ي",1,0],["لا تضني وارفقي بفتى","بالحمى المنكوب مفتتن",49,"ن",1,0],["لا تضطربْ عند الخطوبِ فإنّما","يَصفو إذا ما أُمِهلَ المُتكَدَّر",50,"ر",1,0],["لا تَضجَرَن مِمّا أَتَيتُ فَإِنَّهُ","صَدرٌ لِأَسرارِ الصَبابَةِ يَنفِثُ",51,"ث",1,1],["لا تضع فترةً بها فتر القل","بُ فإن الصِغارَ منا صِعاب",52,"ب",1,0],["لا تَضجَرَنَّ وَلا تَدخُلكَ مُعجِزَةُ","فَالنُجُحُ يَهلِكَ بَينَ العَجزِ وَالضَجرِ",53,"ر",1,1],["لا تضجرنَّ إذا عرتك مصيبةٌ","نوب الزمان صياقل الأحرارِ",54,"ر",1,0],["لا تضرِبِ الطائعَ يوم دهره","فإنما هذي العَصا لمَنْ عصا",55,"ا",1,0],["لا تضعْ منْ عظيمِ قدرٍ وان كُن","تَ مُشاراً اليه بالتَّعظيمِ",56,"م",1,1],["لا تَضَعِ المِنجَلَ في وُدِهِّ","إِلّا إِذا سَمّاكَ حَصّادا",57,"د",2,0],["لا تضيعوا فرصة سنحت","عارف بالوقت آتيه",58,"ي",2,0],["لا تُضِعْنِي وقد جعلتُك في الأخ","طار حِرْزاً من الأذى وحريما",59,"م",2,0],["لا تضربوا الأمثال لله الذي","قد قال ذلك في الكتاب المنزلِ",60,"ل",1,0],["لا تَضْحكُ الأوراقُ حتى تنتحِبُ","ترمي بها يُمناي أغراضَ الكتبْ",61,"ب",1,0],["لا تضجروا إن طال فيها السيراو","لغبت مطايا الجهد من وعثاء",62,"ا",2,0],["لا تَضرِبَنَّ لَها مِن هالِكٍ مَثَلاً","مِنهُ فَلَيسَ لَها في الخَلقِ مِن مَثَلِ",63,"ل",1,0],["لا تُضاهيها أسودٌ","لو بَدا منها اِجتِراءُ",64,"ا",2,0],["لا تَضجَرنَّ بِفَقدِك النّجلَ الّذي","في فَقدِهِ قَد كانَ شقُّ مرائِرِ",65,"ر",1,0],["لا تضع أيامنا في عتب","يشرب الحمرة من وردة وجنه",66,"ن",2,0],["لا تضحكوا من مثَل رامه","فكم عظيم حالم بالمحال",67,"ل",1,0],["لا تضق ذرعاً بِمهنته","فَاعتِزاز الصب في المهن",68,"ن",1,0],["لا تُضْرِبَنْ عَن بَني هَمْدانَ واقْذِفْهُمْ","ضَرْباً إِذا ما تَغشَّى أُمًّةً هَمَدوا",69,"د",3,0],["لا تضع قدر ذي النباهة ان قد","ر اعساره ورثت ثيابه",70,"ب",2,0],["لا تضيقن ذرعاً بعاجل مكرو","هٍ توافى حميدةً أعقابُه",70,"ب",2,0],["لا تَضربن للغضب","تَشفياً بَل لِلأَدب",71,"ب",1,0],["لا تضجّوا فوق السرير عويلا","بل دعوني أنام ملء جفوني",72,"ن",2,0],["لا تضربنّ له الطبول تجلة","أبداً ويأبى عيشه النقلانِ",73,"ن",1,0],["لا تضع الباطل فرق ال","حق بل فاعكس تُصِب",74,"ب",1,0],["لا تضمروا قتلي","وخففوا ثقلي",75,"ي",1,0],["لا تضنُّوا على العليلِ بكَأسٍ","رُبَّ كأسٍ تُعيدُ للعَيشِ عَهدَا",76,"د",2,0],["لا تضره الذنوب مني ولا","ينقصه العفو إذا تبت إليه",77,"ي",2,0],["لا تُضمري حِقداً عليَّ فاننّي","لكلاب حبّك دون قومك تابعُ",78,"ع",1,0],["لا تضجر يوما من عسرٍ","فبه سهمُ اليُسرَين رُمى",79,"م",2,0],["لا تضني بما اروم فعهدي","بك يا مي اكرم الغانيات",80,"ت",1,0],["لا تضيعوا مجد الجدود بوضح الش","ح في موضع النوال الشافي",81,"ف",2,0],["لا تضعفوا جبنا ولا تتهيبوا","من شأنه الإذلال والإرغام",82,"م",1,0],["لا تضمخ منك الترائب طيبا","بل تضمخ بطيب ذاك التراب",83,"ب",1,0],["لا تضِلّوا العِبادَ فَالخَمرُ رِجسٌ","قَد نَهى اللَهُ عَنهُ وَالأَنبِياءُ",84,"ا",2,0],["لا تَضِلّي لا تَخسَري لا تَخيبي","أَنتِ أَهلٌ لِلذُلِّ وَالتَعذيبِ",85,"ب",1,0],["لاَ تضِربَنّ بهم في فضلِهم مثلاً","فما لهم في البرايا يُضْرَبُ المَثَل",86,"ل",1,0],["لا تضق ذرعا إذا ما","لم يكن ما تشتهيه",87,"ه",1,1],["لا تَضّني بِسَلام","أَنتِ بِالجُود حَريَّه",88,"ه",1,0],["لا تضحكُ الكأس فيه","وينظمُ الشربُ شملَه",89,"ل",2,0],["لا تضق بالحياة فالسحب لا يحجبن","شمساً وليس يخفين ومضا",90,"ض",2,0],["لا تضجرنّ وإن أُصبت بفادح","جلل فقد زلزلتّ عرش الحوب",91,"ب",1,0],["لا تضيق السجون بالفكر رحباً","والفضا ضيّق بما ضاق عقلا",92,"ل",2,0],["لا تَضِق بِالهَمِّ ذَرعاً","كُلُّ هَمٍّ لِاِنفِراجِ",93,"ج",1,0],["لا تضجع ابدا يا صاح منبطحا","للوجه تمقت لدى مولاك فاختشم",94,"م",1,0],["لا تُضَيِّع حَقِّي بشاهدِ زُورٍ","هو أعْمَى بَصِيرةٍ أو تَعامَى",95,"م",2,0],["لا تضيعي الوقت في القول سدى","ليس بالأقوال تحطيم القيود",96,"د",1,0],["لا تضع بالفصاد من دمك الطي","يب واستبقه فما ذاك رشد",97,"د",1,1],["لا تَضرِبَن أَمَةً وَلا عَبداً جَنى","فَكِلاهُما في الشَرعِ مَلعونانِ",98,"ن",1,0],["لا تَضبُطَنَّ حِسابَ سقطتِهِ فهل","تدري بشمس الضحو عند جِلائهِ",99,"ا",3,0],["لا تضيع وقت التهاني ففيه","حضرة علوة وغاب الرقيب",100,"ب",1,0],["لاَ تَضِقْ ذَرْعاً بِأعْدَاءٍ فَكَمْ","جَنَّبُوا المَرْءَ وُقُوعاً فِي الزَّلَلْ",101,"ل",1,0],["لاَ تَضِق ذَرعاً بفَقرٍ فَلَكَم","صَدَّ فَقرٌ عَن مَنَاهِجِ الرَّدَى",102,"د",2,1],["لا تُضِع أنفاسا بِأنفاسِ عُمرٍ","فِي سَوَى تَقوى اللهِ فهيَ الوِقاءُ",103,"ا",2,0],["لا تَضحَكُ في وَجهِ سماءٍ أَرضٌ","أَو تُعطيَ حَقَّها مِنَ الأَنداءِ",104,"ا",2,0],["لا تضاهيها مهاةٌ بالفلا","وكذا في الحَضر ربّاتُ الدلالُ",105,"ل",1,0],["لا تَضني بردِّه اليومَ إني","لم أكن فيه يوم كان ضَنينا",106,"ن",2,0],["لا تُضجِرَنَّكَ صَبوَتي","وَاِرفِق فديتُك بي وَلَن",107,"ن",1,0],["لا تضعفن إذا طلبت جلالة","حتى تجاوز منكب الجوزاء",108,"ا",2,1],["لا تضيق من التشاؤم واحتمالات الأناني","خايف(ن) اشرب بعد كاس النصر كاس المذله",109,"ل",2,0],["لا تضربوا عند السؤال لريقها","مثلًا بخمرٍ في الدِّنانِ تُعتَّقُ",110,"ق",1,0],["لاتضربْ بعصَاكَ البحرَا","أو تُبحرْ لنجاتِكَ بَرَّا",111,"ر",2,1],["لا تضمنُ الحربُ إيواءً لمن فرَّا","وتضمنُ الدَّارَ للباقي به قبرَا",112,"ر",2,1],["لا تضيفن من أعاديك ذرعاً","إنّ جرح العجماء كان جبارا",113,"ر",2,0],["لاتضغط أكثر على خاطرك،،","لو تترك أشياء داخلهم..",114,"م",1,0],["لا تضحكوا .. هذي قصيدةُ شاعرٍ","فوقَ المنابرِ صادحٍ ويعيشُ",115,"ش",1,0],["لاتضغط الحب كنْه العشق نيزكه","لنيزك العشق إشعاعٌ وآفاقُ",116,"ق",1,0],["لا تضجرن فقد كفى","ما ناله منا الضجر",117,"ر",1,0],["لا تضمده يذك شوقاً وشجواً","واترك ناره تشبّ شبوبا",118,"ب",2,0],["لا تضحكي فَيُجَنُّ المسكُ مندهشا","أو يُحرجُ النَّاي في عزفِ المواويلِ",119,"ل",1,0],["لا تضمر المرآة في زعمها","شيئا وزراء الصورة الظاهرة",120,"ر",2,0],["لا تضحكنَّ من الغبيِّ إذا","ما ظن أن السخفَ يحترمُ",121,"م",1,0],["لا تضربوا الحيوان فهو جميلُ","وعليكمُ الإطعامُ والتبجيلُ",122,"ل",1,1],["لا تضحكي فغدا تأتي بشائره","ورِضا الإلهِ بذي الجنات يؤويني",123,"ن",2,0]]}