{"poems":[[3,"ضحكت عبيلة إذ رأتني عارياَ","https://www.aldiwan.net/poem170.html",""],[86,"بالذي أجراك يا ريح الخزامى","https://www.aldiwan.net/poem10684.html","الرمل"],[93,"كانت عيون الريب الساهره","https://www.aldiwan.net/poem11137.html","السريع"],[51,"وهب يا واهب الهبات اللواتي","https://www.aldiwan.net/poem8310.html","الخفيف"],[51,"كم نسام الأذى كأنا كلاب","https://www.aldiwan.net/poem8534.html","الخفيف"],[51,"ما لمن حسنه الله وأعلى درجاته","https://www.aldiwan.net/poem8696.html","مجزوء الرمل"],[51,"يا أبا نصر وما للمرء في","https://www.aldiwan.net/poem64966.html","الرمل"],[51,"يا أبا المستهل ماذا تقول","https://www.aldiwan.net/poem65846.html","الخفيف"],[51,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[91,"قالت لجارتها يوما تسائلها","https://www.aldiwan.net/poem62759.html","عموديه"],[85,"أيها القصر أترعى عهدنا","https://www.aldiwan.net/poem7047.html","الرمل"],[45,"بين أفق الصبا وأفق الدبور","https://www.aldiwan.net/poem63589.html","الخفيف"],[58,"لا تضع المعروف في ساقط","https://www.aldiwan.net/poem30976.html","السريع"],[58,"إصبر على مضض الإدلاج في السحر","https://www.aldiwan.net/poem31066.html","البسيط"],[49,"الله أكرم من يناجى","https://www.aldiwan.net/poem62026.html","مجزوء الكامل"],[21,"اصبر النفس عند كل ملم","https://www.aldiwan.net/poem36167.html","الخفيف"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[48,"إن كان يحيى يقدر","https://www.aldiwan.net/poem66289.html","المجتث"],[46,"تلا كتاب الله من حفظه","https://www.aldiwan.net/poem23001.html","السريع"],[15,"صبر النفس عند كل ملم","https://www.aldiwan.net/poem45248.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85581","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54999","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142021","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43720","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[51,"يا كريماً لم يزل محتمِلا","https://www.poetsgate.com/ViewPoem.aspx?id=30692",""],[51,"ما لمن حَسَّنَهُ اللَّ","https://www.poetsgate.com/ViewPoem.aspx?id=27198",""],[107,"تخذ الجور والجناية عاده","https://www.aldiwan.net/poem16600.html","الخفيف"],[107,"لا تضيعوا من إليكم سلموا","https://www.aldiwan.net/poem16724.html","الرمل"],[113,"يا امام القوم يا عالي السند","https://www.aldiwan.net/poem41148.html","عموديه"],[113,"قطعوا من فؤادي الأوصالا","https://www.aldiwan.net/poem41685.html","الخفيف"],[113,"أسد الله فتى العزم أبا السا","https://www.aldiwan.net/poem41783.html","الطويل"],[113,"يا رسول الله دارك كرما","https://www.aldiwan.net/poem42174.html","الرمل"],[141,"ظن الأراك لدى واديه أظعانا","https://www.aldiwan.net/poem11832.html","عموديه"],[148,"لا تضق ذرعا بخطب نازل","https://www.aldiwan.net/poem68508.html","الرمل"],[148,"إن الكبائر للطاعات مفسدة","https://www.aldiwan.net/poem68517.html","البسيط"],[153,"يومنا يوم مطير ولذاذات","https://www.aldiwan.net/poem55688.html","مجزوء الرمل"],[197,"سحر عينيك سال في تشبيبي","https://www.aldiwan.net/poem45600.html","الخفيف"],[197,"كيف فؤادي والهوى شاغل","https://www.aldiwan.net/poem45637.html","السريع"],[227,"لا تضق بالدهر ذرعا","https://www.aldiwan.net/poem51100.html","مجزوء الرمل"],[235,"أعضلت علتي فجئت رئيسا","https://www.aldiwan.net/poem19700.html","الخفيف"],[268,"يا ذات خدر قدرها عال","https://www.aldiwan.net/poem35453.html","أحذ الكامل"],[288,"لا تضني بالدمع يا عين ما الدمع","https://www.aldiwan.net/poem11695.html","الخفيف"],[308,"سيدي والظنون فيك جميلة","https://www.aldiwan.net/poem59510.html","الخفيف"],[326,"أطرقي أطرقي فقد ضمك","https://www.aldiwan.net/poem54948.html","الخفيف"],[340,"دمعة حرى على وطن","https://www.aldiwan.net/poem55385.html","المديد"],[362,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[364,"لا تضجرن مما أتيت فإنه","https://www.aldiwan.net/poem17864.html","الكامل"],[374,"أسلاف سلامكم أم خطاب","https://www.aldiwan.net/poem66943.html","الخفيف"],[417,"لا تضجرن ولا تدخلك معجزة","https://www.aldiwan.net/poem4853.html","البسيط"],[426,"صابر على الأخطار في طلب العلى","https://www.aldiwan.net/poem40724.html","الكامل"],[429,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[459,"لا تضع من عظيم قدر وان كن","https://www.aldiwan.net/poem15946.html","الخفيف"],[466,"إذا بدت من صاحب نبوة","https://www.aldiwan.net/poem60230.html","السريع"],[477,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[549,"رب كن لي منها لباسا حصينا","https://www.aldiwan.net/poem47226.html","الخفيف"],[556,"إنا فهمنا عنه أمثالا لنا","https://www.aldiwan.net/poem34234.html","الكامل"],[565,"حسبي من اللهو وآلات الطرب","https://www.aldiwan.net/poem69818.html","الرجز"]],"verses":[["لا تَضحَكي مِنّي عُبَيلَةُ وَاِعجَبي","مِنّي إِذا اِلتَفَّت عَلَيَّ جُيوشُ",0,"ش",1,0],["لا تَضِق ذَرعاً بِما قالَ العِدا","رُبَّ ذي لُبٍّ عَنِ الحَقِّ تَعامى",1,"م",2,0],["لا تُضْمِرُ المِرْآةُ فِي زَعْمِهَا","شَيْئاً وَرَاءَ الصُّورَةِ الظَّاهِرَهْ",2,"ر",2,0],["لا تُضِعْني فإن شكريَ كنزٌ","يتهادَى تُراثَهُ الأعقابُ",3,"ب",1,0],["لا تُضِلَّنَّ باحتجابك آما","لاً هداها إليك منك اجتلابُ",4,"ب",1,0],["لا تُضِعْ إحسانَ ذي الإح","سانِ يا خير رعاتِهْ",5,"ت",2,0],["لا تُضيِّع مثل وُدّي إنه","صادقُ الصحة ما فيه مَرَض",6,"ض",1,0],["لا تُضِعْهُ فإنك ابنُ دلالٍ","والدَّجاجُ السمينُ طعمٌ ثقيلُ",7,"ل",1,0],["لا تُضِق عفوك عني واجْزني","يا فسيحَ العفوِ يا رحبَ العَطَن",8,"ن",1,0],["لا تَضحَكوا وَبِأَرضِ الشامِ نائِحَةٌ","وَلا تَناموا وَفي لُبنانَ سَهرانُ",9,"ن",1,0],["لا تُضع عندك أسرار الهوى","واختزنها في الزوايا والحنِى",10,"ا",1,0],["لا تُضامُنَّ حاجَتي وَأَبو طَلحَةَ مَن","صورُكَ الشَريفُ نَصيري",11,"ر",2,0],["لا تَضَعِ المَعروفَ في ساقِطٍ","فَذاكَ صِنعُ ساقِطٍ ضائِعُ",12,"ع",1,1],["لا تَضجَرَنَّ وَلا يَحزُنكَ مَطلَبُها","فَالنَجحُ يَتلَفُ بَينَ العَجزِ والضَجَرِ",13,"ر",1,0],["لا تَضجَرَنَّ لِضيقَةٍ","يَوماً فَإِنَّ لَها انفِراجا",14,"ج",2,0],["لا تَضيقَنَّ بِالأُمورِ فَقَد","يُكشَفُ غَمّاؤُها بِغَيرِ اِحتيالِ",15,"ل",1,0],["لا تُضْحِكُ الدُّنيا لهُ سِنّاً وَما","لَمْ يُؤْتَ منها عَدَّهُ تَنوِيلا",16,"ل",2,0],["لا تضمر الهجرَ إنّي","حلفتُ إن أنتَ تهجر",17,"ر",1,0],["لا تَضِفِ الشارِبَ في سُكرِهِ","وَلا تُنَزِّلهُ وَلا تُلحِفِ",18,"ف",1,0],["لا تَضيقَنَّ في الأُمورِ فَقَد تُك","شَفُ غَمّاؤُها بِغَيرِ اِحتِيالِ",19,"ل",1,0],["لا تضمري يأساً فَلا","يَبقى الزَمان على قرار",20,"ر",1,0],["لاَ تضِنُّوا يَا أَحِبَّائِي فَمَا","مَنْ يُضِيعُ المَالَ فِي الخَيْرِ مُضِيعْ",21,"ع",1,0],["لا تضنّي على الحراب وإن آذتك","بل عطري رؤوس الحراب",22,"ب",1,0],["لا تَضعَنَّ المُشتَري في الثَرى","وَاِجعَل لَهُ أَوجُهَنا بُسطا",23,"ط",2,0],["لا تضُمُّوا إلى أَسَاهُ عَمَى الْجَهْ","لِ فيلْقَى النكَالَ بَعْد النكَالِ",24,"ل",1,0],["لا تَضِلُّ الشُعُوبُ مِصْباحُها العِلْمُ","يُؤاخِيهِ راسِخُ الإيمانِ",25,"ن",1,0],["لا تُضِق عفوك عني واجْزني","يا فسيخَ العفوِ يا رحبَ العَطَنْ",26,"ن",1,0],["لا تُضع إحسانَ في الإح","سانِ يا خير رعاتِهْ",27,"ت",2,0],["لَا تَضع سَهم مُقلَتيهِ فَوادي","ضِمنَ تِلكَ السِهام أَلف شَهادَه",28,"ه",1,0],["لا تَضيعوا من إَلَيكُم سَلموا","أَمرَهُم لَما عَلَيكُم أَقدموا",29,"م",3,1],["لا تضيعني وخذ لي بيدي","فلك المختار اعطى خير يد",30,"د",1,0],["لا تضيعوا عهد المحبة إني","ضعت وجداً فيكم وآهى طالا",31,"ل",2,0],["لا تضيعني وخذ لي بيدي","إنني منتظر منك انتصارك",32,"ك",1,0],["لا تضيعني وخذ لي بيدي","وصل الحبل وعاملني بما",33,"م",2,0],["لا تُضمِروا حَسَداً مَحصولُهُ عَطَبٌ","إِنَّ التَحاسُدَ أَفنى آلَ ذُبيانا",34,"ن",2,0],["لا تضق ذرعاً بخطب نازلٍ","ربما جاءك خطبٌ ومضى",35,"ض",2,1],["لا تضمرنَّ على ذي نعمة حسداً","إنَّ الحسود من الرحمن مبتعد",36,"د",1,0],["لا تُضِعْ يا صاحِ لذَّا","تِكَ فالعُمْرُ قَصيرُ",37,"ر",1,0],["لا تضّني يا ظبيةٌ إن تحيي","عاشقاً هامَ في النقا والكثيبِ",38,"ب",1,0],["لا تضحك الجاهلَ في نفسهِ","إلا بكى في نفسهِ العاقلُ",39,"ل",1,0],["لا تضِق بالدهر ذَرعا","واقتل الدهر جِهارَا",40,"ر",2,1],["لاَ تُضَيِّعْ خُطىً وَصَلْنَا بِهَا مَثْ","وَاكَ مَثْوَى السَّنَا الْمُزِيحِ النُّحُوسَا",41,"س",2,0],["لا تضحَكي ممَّن عواطفُهُ","ظهرت بألحاظٍ وأقوال",42,"ل",1,0],["لا تضني بالدمع يا عين ما الدمعُ","إذا جلّ حادثُ الدهر غالي",43,"ل",2,1],["لا تضعني فلست منك مضيعاً","ذمة الحب والأيادي الجميله",44,"ل",2,0],["لا تضجّى ولا تضيقي بصمتي","فهو زادي وعدّتي وعتادي",45,"ي",1,0],["لا تضني وارفقي بفتى","بالحمى المنكوب مفتتن",46,"ن",1,0],["لا تضطربْ عند الخطوبِ فإنّما","يَصفو إذا ما أُمِهلَ المُتكَدَّر",47,"ر",1,0],["لا تَضجَرَن مِمّا أَتَيتُ فَإِنَّهُ","صَدرٌ لِأَسرارِ الصَبابَةِ يَنفِثُ",48,"ث",1,1],["لا تضع فترةً بها فتر القل","بُ فإن الصِغارَ منا صِعاب",49,"ب",1,0],["لا تَضجَرَنَّ وَلا تَدخُلكَ مُعجِزَةُ","فَالنُجُحُ يَهلِكَ بَينَ العَجزِ وَالضَجرِ",50,"ر",1,1],["لا تضجرنَّ إذا عرتك مصيبةٌ","نوب الزمان صياقل الأحرارِ",51,"ر",1,0],["لا تضرِبِ الطائعَ يوم دهره","فإنما هذي العَصا لمَنْ عصا",52,"ا",1,0],["لا تضعْ منْ عظيمِ قدرٍ وان كُن","تَ مُشاراً اليه بالتَّعظيمِ",53,"م",1,1],["لا تَضَعِ المِنجَلَ في وُدِهِّ","إِلّا إِذا سَمّاكَ حَصّادا",54,"د",2,0],["لا تضيعوا فرصة سنحت","عارف بالوقت آتيه",55,"ي",2,0],["لا تُضِعْنِي وقد جعلتُك في الأخ","طار حِرْزاً من الأذى وحريما",56,"م",2,0],["لا تضربوا الأمثال لله الذي","قد قال ذلك في الكتاب المنزلِ",57,"ل",1,0],["لا تَضْحكُ الأوراقُ حتى تنتحِبُ","ترمي بها يُمناي أغراضَ الكتبْ",58,"ب",1,0]]}