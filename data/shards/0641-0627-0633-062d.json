{"poems":[[37,"لعزة هاج الشوق فالدمع سافح","https://www.aldiwan.net/poem39173.html","الطويل"],[64,"وبنفسي الرشأ الذي خاصرته","https://www.aldiwan.net/poem52344.html","الكامل"],[71,"وافى كتاب العبد ضمن كتابكم","https://www.aldiwan.net/poem29128.html","الكامل"],[147,"إن لم أقل فيك ما يردي العدى كمدا","https://www.aldiwan.net/poem11753.html","البسيط"],[240,"يا مهدي الورد الجني لنا","https://www.aldiwan.net/poem31780.html","السريع"],[240,"الدست من لألاء وجهك مشرق","https://www.aldiwan.net/poem31812.html","الكامل"],[240,"وبخيلة سمح الرقا","https://www.aldiwan.net/poem32174.html","مجزوء الكامل"],[240,"حتام أرضى في هواك وتغضب","https://www.aldiwan.net/poem32181.html","الكامل"],[280,"إلى وعدها أصبو وهل ينجز الوعد","https://www.aldiwan.net/poem25588.html","الطويل"],[411,"وسائل الناس شتى عند سادتهم","https://www.aldiwan.net/poem49788.html","البسيط"],[438,"تنفس الروض عن نواره الأرج","https://www.aldiwan.net/poem12315.html","البسيط"],[473,"الطل من فوق الشقيق","https://www.aldiwan.net/poem59801.html","مجزوء الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46436","الكامل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128238","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74264","السريع"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67981","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66498","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127139","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127200","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72458","الكامل"],[5152,"عندي ألف فن","https://www.poetsgate.com/ViewPoem.aspx?id=185862",""],[5612,"رسالة إلى عنترة","https://www.poetsgate.com/ViewPoem.aspx?id=197096",""]],"verses":[["فَأَسحَقَ بُرداهُ وَمَحَّ قَميصَه","فَأَثوابُهُ لَيسَت لَهُنَّ مَضَارِحُ",0,"ح",1,0],["فأسحْتُ من ماء الجُفونِ وساعدتْ","حتى لقد كِدنا نصيرُ دموعَا",1,"ع",2,0],["فاسحبْ ذيولَ سعادةٍ إنعامُها","لا ينقضي وسحابُها لا يقلعُ",2,"ع",1,0],["فَاِسحَب ذُيولَ بُرودٍ لا فَناءَ لَها","مَنسوجَةٍ مِن مَديحٍ تَسبِقُ البُرُدا",3,"د",2,0],["فَاِسحَب ذُيولَ سَعادَةٍ فُضُلا","في ظِلِّ عَيشٍ ناعِمٍ خَضِلِ",4,"ل",1,0],["فَاِسحَب فُضولَ سَعادَةٍ أَيّامُها","لاتَنقَضي وَجَديدُها لا يُخلِقُ",5,"ق",1,0],["فَاِسحَب ذُيولَ سَعادَةٍ","تَثني عَدُوَّكَ أَخيَبا",6,"ب",2,0],["فَاِسحَب ثَيابَ سَعادَةٍ فُضُلاً لِسا","بِغِها عَلى ظَهرِ المَجَرَّةِ مُسحَبُ",7,"ب",1,0],["فَأَسْحَارُهَا تُهْدي لها الطيبَ مَنْبِجٌ","وآصالُها تَهْدِي الصَّبا نَحْوَها نَجْدُ",8,"د",1,0],["فاسحَبْ ببِرِّكَ أذيالاً على أملي","أسحَبْ بشُكرِكَ ما عُمِّرْتُ أذيالي",9,"ي",1,0],["فاسْحَبْ على النجمِ ذَيْلَ التِّيهِ مفتخراً","فَأَنتَ بالتِّيهِ والفخرِ القديمِ حَجِ",10,"ج",1,0],["فَاِسحَب ذُيولَ الإِنخِلا","عِ مِنَ الصَبوحِ إِلى الغِبوقِ",11,"ق",1,0],["فَاِسحَب ذُيولَ المُكرَمات سَوابِقاً","وَانعم وَحيدَ الفَضل وَالآلاء",12,"ا",2,0],["فَاِسَحب ذُيولَ قِيادة وَسِيادَةٍ","كسياك بُردي هَيبَةٍ وَعلاء",12,"ا",2,0],["فاسحب على الفلك إلا على ذيول على","فقد حويت من العلياء علياها",13,"ا",3,0],["فَاسحب ذيال العز في رفعة","تزهق مِنها أَنفُس الحاسِدين",14,"ن",1,0],["فاسحبْ ذيولَ التِّيه يَا دهري فقد","أَصبحتَ فِي كفّي مليكٍ مقتدِرْ",15,"ر",1,0],["فاسحب ذيول الفخرِ يا كلّ المنى","من فوق ذروة هامة الجوزاء",16,"ا",2,0],["فاسحب ذبول العز في عيشة","راضية ليس عليها غبار",17,"ر",1,0],["فاسحب ذيول الفخر يا غيث الندى","وابن على أعلى السماء دارك",18,"ك",1,0],["فاسح المسجد المؤسس بالتقوى","وملقى الاملاك باستحياء",19,"ا",2,0],["فاسحب ذيول الفخر في مدحوَّة","عضد الجلال بساعديه دحاها",20,"ا",3,0],["فأسْحَرُ بالرَّصانةِ حينَ تشدو","حروفُ حديثِ دافقة اللسانِ",21,"ن",1,0],["فاسْحَبْ يديْكَ ولا تُصالِحْ ثانياً","واطْلُبْ مِنَ اللهِ الهُدَى والمَغْفِرَةْ",22,"ر",2,0]]}