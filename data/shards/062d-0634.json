{"poems":[[79,"وجودك حي الملك والدين والدنيا","https://www.aldiwan.net/poem35717.html","الطويل"],[79,"جعلت إليك الله والملأ الأعلى","https://www.aldiwan.net/poem35720.html","الطويل"],[79,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[79,"أنور سناء لاح في مشرق الغرب","https://www.aldiwan.net/poem36773.html","الطويل"],[79,"وليلة أنس باح منا بها الهوى","https://www.aldiwan.net/poem36778.html","الطويل"],[32,"أخرقاء للبين استقلت حمولها","https://www.aldiwan.net/poem29537.html","الطويل"],[32,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[4,"تمنى ابنتاي أن يعيش أبوهما","https://www.aldiwan.net/poem21169.html","الطويل"],[53,"قد حلفنا على الصفاء جميعا","https://www.aldiwan.net/poem65697.html","الخفيف"],[53,"ليهنك أن أفطرت لا متطلعا","https://www.aldiwan.net/poem66008.html","الطويل"],[53,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[31,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[91,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[87,"لم يمت من له أثر","https://www.aldiwan.net/poem62861.html","مجزوء الخفيف"],[45,"حشاشة نفس ودعت يوم ودعوا","https://www.aldiwan.net/poem9720.html","الطويل"],[47,"لك عهد لدي غير مضاع","https://www.aldiwan.net/poem64657.html","الخفيف"],[47,"عهد لعلوة باللوى قد أشكلا","https://www.aldiwan.net/poem65545.html","الكامل"],[47,"أترى الزمان يعيد لي أيامي","https://www.aldiwan.net/poem65674.html","الكامل"],[47,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[99,"آه من لحن سماوي","https://www.aldiwan.net/poem24608.html","مجزوء الرمل"],[82,"لي قلب من جلمد الصخر أقسى","https://www.aldiwan.net/poem31374.html","الخفيف"],[82,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[82,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[46,"وأخ بشعت بعرفه ومذاقه","https://www.aldiwan.net/poem29714.html","الكامل"],[71,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[107,"وفت الظنون وبرت الآمال","https://www.aldiwan.net/poem42085.html","الكامل"],[107,"هل ليم نضو صبابة فأفاقا","https://www.aldiwan.net/poem43377.html","الكامل"],[54,"يا صاحبي شيبت عفوا","https://www.aldiwan.net/poem26585.html","مجزوء الكامل"],[52,"حشاشة ودعتني يوم بينهم","https://www.aldiwan.net/poem24525.html","البسيط"],[52,"لا تعد لي كليلة بالجماد","https://www.aldiwan.net/poem63953.html","الخفيف"],[48,"ألم ترني مع الأيام أمسي","https://www.aldiwan.net/poem22684.html","الوافر"],[48,"وبالي فيك يا دنيا وبالي","https://www.aldiwan.net/poem23231.html","الوافر"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125686","الرمل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62239","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140816",""],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54241","الطويل"],[102,"صنعاني يبحث عن صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=50407",""],[100,"مصرع النسر","https://www.poetsgate.com/ViewPoem.aspx?id=55338",""],[92,"ذات الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=179215",""],[92,"النشيد الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=178973",""],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[92,"ماهذه النفوس قداح","https://www.poetsgate.com/ViewPoem.aspx?id=178947",""],[47,"أتَرَاهُ يَظُنُّني، أوْ يَرَانِي","https://www.poetsgate.com/ViewPoem.aspx?id=32077",""],[53,"ليهنَكَ أن أفطرتَ لا متطلعاً","https://www.poetsgate.com/ViewPoem.aspx?id=30406",""],[53,"قد حَلفنَا على الصفاء جميعاً","https://www.poetsgate.com/ViewPoem.aspx?id=29909",""],[102,"صنعاني يبحث عن صنعاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67683&r=&rc=170",""],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[136,"ربع أسماء إذ هي الأنس آلا","https://www.aldiwan.net/poem54778.html","الطويل"],[147,"قصر عن سعيك الألى جهدوا","https://www.aldiwan.net/poem11756.html","المنسرح"],[154,"حننت إلى العهد الذي كان فانقضى","https://www.aldiwan.net/poem68571.html","الطويل"],[154,"تركنا زهيرا للبقيع فثهمد","https://www.aldiwan.net/poem68579.html","الطويل"],[154,"أصبت من الحساد أنفذ مقتل","https://www.aldiwan.net/poem68600.html","الطويل"],[164,"خذوا لي من الألحاظ أمنا على عقلي","https://www.aldiwan.net/poem58987.html","الطويل"],[185,"أمن طلل بالجزع قو المعارف","https://www.aldiwan.net/poem58844.html","الطويل"],[193,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[216,"حشا في حشائي الهم والشوق ما حشا","https://www.aldiwan.net/poem37871.html","الطويل"],[227,"كم سهرت الساعات في الظلماء","https://www.aldiwan.net/poem41868.html","الخفيف"],[229,"إن الذي أبقيت في مهجتي","https://www.aldiwan.net/poem55157.html","السريع"],[233,"حشت بالكحل عينيها وبانت","https://www.aldiwan.net/poem51119.html","الوافر"],[233,"حشوا بفراقهم نارا حشاه","https://www.aldiwan.net/poem51261.html","الوافر"],[239,"يا قاصدا بغداذ جذ عن بلدة","https://www.aldiwan.net/poem32161.html","الكامل"],[274,"شجاني ظلام الليل والبرق يومض","https://www.aldiwan.net/poem35175.html","الطويل"],[307,"أتاني كتاب منك أذكى جوى الحشا","https://www.aldiwan.net/poem57670.html","الطويل"],[308,"عجبا للمطمئنين بدنيا","https://www.aldiwan.net/poem16767.html","الخفيف"],[357,"من لعين اروقة لا تنام","https://www.aldiwan.net/poem40589.html","عموديه"],[368,"حشو فؤادي فرح","https://www.aldiwan.net/poem60967.html","مجزوء الرجز"],[370,"حشد الذنوب علي يوم عتابي","https://www.aldiwan.net/poem16919.html","الكامل"],[370,"بعد المعاطف والروادف لم ترق","https://www.aldiwan.net/poem17156.html","الكامل"],[375,"قلت للخفض والخمول استقيما","https://www.aldiwan.net/poem57164.html","الخفيف"],[407,"ما على الصب في الصبابة وصمه","https://www.aldiwan.net/poem33405.html","الخفيف"],[407,"يا من إليه صبوتي تنسب","https://www.aldiwan.net/poem34144.html","السريع"],[420,"تنقلت مثل البدر يا طلعة البدر","https://www.aldiwan.net/poem54158.html","الطويل"],[461,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[464,"أقم يا حسامي في صوانك واهجم","https://www.aldiwan.net/poem15092.html","الطويل"],[467,"لقد لج دمعي ليلة السفح بالسفح","https://www.aldiwan.net/poem3581.html","عموديه"],[541,"حشلاف قد مات ابنه مرددا","https://www.aldiwan.net/poem47959.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/29492","الطويل"],[1173,"","https://poetry.dctabudhabi.ae/diwan/poem/20965","الكامل"]],"verses":[["حَشاياهُمُ عندَ الكَرى صهَواتُها","فأحْلامُهُمْ بالسّبْيِ صادِقَةُ الرّؤيا",0,"ي",2,0],["حَشاكَ بأنْ تَبْدو لهُمْ منْكَ وحْشَةٌ","ومِنْ دونِهِم عُرِّفْتَهُ البِرَّ والفَضْلا",1,"ل",2,0],["حشَرَ الأنامَ فَما يؤمَّلُ حصْرُهُ","بشَبا اليَراعِ ولا يُطاقُ حِصارُهُ",2,"ر",2,0],["حَشَا بَاهِظَ الأَجْزَالِ وَقْدَ ضِرَامِهَا","فَأَوْرَتْ جَحِيماً لاَفِحاً أَوْجُهَ السُّحْبِ",3,"ب",1,0],["حَشَدْنَا جُمُوعَ اللَّحْنِ مِنْهُ فَأَقْبَلَتْ","كَتَائِبَ تَقْفُوْ إِثْرَهُنَّ كَتَائِبُ",4,"ب",1,0],["حَشَتها الزُبانى حِرَّةً في صُدورِها","وَسَيَّرَها مِن صُلبِ رَهبى ثَميلُها",5,"ل",3,0],["حَشَوتُ الِقلاصَ اللَيلَ حَتّى وَرَدنَهُ","بِنا قَبلَ أَن تَخفى صِغارُ الكَواكِبِ",6,"ب",1,0],["حَشودٌ عَلى المِقرى إِذا البُزلُ حارَدَت","سَريعٌ إِلى الداعي مُطاعٌ إِذا أَمَر",7,"ر",1,0],["حشمتي خلقة وليس من الحك","مة أن تستقيد للمخلوق",8,"ق",1,0],["حَشاً لم يزلْ تقوَى الإله يكفُّهُ","بما خفَّ من زاد وما آب مطعما",9,"م",2,0],["حشد الربيعُ مع الربيع لهُ","فغدا يهُزُّ أثائثَ الجُممِ",10,"م",1,0],["حُشدٌ عَلى الحَقِّ عَيّافو الخَنا أُنُفٌ","إِذا أَلَمَّت بِهِم مَكروهَةٌ صَبَروا",11,"ر",3,0],["حشروني والجامدين على ما","اخذوا من آبائهم في صعيد",12,"د",1,0],["حَشَرَ الناسَ تَحتَهُ","زُمَراً إِثرَها زُمَر",13,"ر",1,0],["حُشاشَةُ نَفسٍ وَدَّعَت يَومَ وَدَّعوا","فَلَم أَدرِ أَيَّ الظاعِنَينِ أُشَيِّعُ",14,"ع",1,1],["حَشايَ عَلى جَمرٍ ذَكِيٍّ مِنَ الهَوى","وَعَينايَ في رَوضٍ مِنَ الحُسنِ تَرتَعُ",14,"ع",1,0],["حَشَدَت حَولَها سِباعُ المَوالي","وَالعَوالي غابٌ لِتِلكَ السِباعِ",15,"ع",1,0],["حَشَدَت لَهُ الأَمواجُ فَضلَ دَوافِعٍ","أَعجَلنَ دولابَيهِ أَن يَتَمَهَّلا",16,"ل",2,0],["حَشَدَت مَواليهِ لَهُ فَتَرادَفَت","عُصَباً تُسايِفُ دونَهُ وَتُرامي",17,"م",2,0],["حَشَدَت مَربَعاءُ فيهِ مَردٌ","وَقُصورُ البَليخِ وَالمازِجانِ",18,"ن",1,0],["حشدَ العالم كالعُ","باد قاموا للصلاة",19,"ه",1,0],["حشوُها من فُلولِ عَضْبي شَظَايا","كَنُيوبٍ عَنْهُنَّ قَلّصَ شِدْقُ",20,"ق",1,0],["حَشوها على الأَعداءِ بالبيضِ والقَنا","وبالزّرَدِ المَوضونِ والضُمّر الجُرْدِ",21,"د",1,0],["حَشَوْا من عجاجاتِ الجهادِ وسائداً","تُعَدّ لهم في الدّفن تَحتَ المَناكِبِ",22,"ب",1,0],["حَشَمُ الصَديقِ عُيونُهُم بَحّاثَةٌ","لِصَديقِهِ عَن صِدقِهِ وَنِفاقِهِ",23,"ق",2,0],["حشا أذنِي بِدُرٍّ ساقَطَتْهُ","عيوني يومَ حُمَّ لهُ الحمامُ",24,"م",1,0],["حَشدَ الحواريّينَ حَولَ جُموعهِ","وَرَمى فتلك صُروحُه تنهالُ",25,"ل",1,0],["حَشَدوا المَلاوِمَ وَاِنبَرى بِلِوائِهِ","يُزجي العُهودَ وَيَحشُدُ الأَشواقا",26,"ق",2,0],["حُشِيَت عَقارِبُ صُدغِهِ","بِالمِسكِ في خَدَّيهِ حَشوا",27,"و",2,0],["حُشاشَةٌ وَدَّعَتني يَومَ بَينِهِمُ","وَشَيَّعَتهُم وَخَلَّتني وَأَحزاني",28,"ي",1,1],["حَشرُ عَينٍ يَلقى البَغيضَ وَلا يَل","قى مُحِبّاً عَينانِ دونَ اِزدِيادِ",29,"د",1,0],["حَشَدتُ أَو اِنفَرَدتُ فَلِلَّيالي","كَتائِبٌ سَوفَ تَطرِقُني بِمَجرِ",30,"ر",1,0],["حُشاشَةُ عائِشٍ وَنَجيعُ نَحضٍ","وَهَيكَلُ مَيتٍ وَعُروقُ بالي",31,"ل",2,0],["حشدَ العالم كالعُب","باد قاموا للصلاة",32,"ه",1,0],["حَشَا ضِغْثَ شُقَّارَى شَرَاسِيفَ ضُمَّراً","تَخَذَّمَ مِنْ أَطْرَافِهَا مَا تَخَذَّمَا",33,"م",2,0],["حشاشة نفسٍ ودعت يوم ودعوا","فلم أدر أي الظاعنين أشبع؟",34,"ع",1,1],["حُشاشةُ نفسٍ صُوِّرتْ في مدامعٍ","وجَذْوةُ نارٍ في الْحَشا سُمِّيتْ وجدا",35,"د",2,0],["حُشُودٌ على الآلامِ والحزن تلتقي","يقاسمُ حَشْدٌ في رَزيئتهِ حشدا",35,"د",2,0],["حشد من العجلات يلهث","في السباق وفي التوالي",36,"ل",2,0],["حشد العُرْبَ تحت رايته السَّمْ","حاءِ والعدلَ والعُلا والمكارم",37,"م",1,0],["حَشَدْتُ له من عَبيدِ الهَوَى","عَطاشَى مُحَلأةً جُوعا",38,"ع",2,0],["حُشاشةُ نفسٍ أجهدت فيك والهوى","يطاردها عن قصدها وتطارد",39,"د",1,0],["حشَدوا عليَّ المُغرِياتِ مُسيلةً","صغراً لُعابُ الأرذلينَ رغائبا",40,"ب",2,0],["حَشدوا عليه الجُوعَ يَنْشِبُ نابَهُ","في جلدِ \" أرقطِ \" لا يُبالي ناشبا !",40,"ب",2,0],["حشى أفسحت فيه المنى خطواتها","فضاقت به الأرجاء وهي فساح",41,"ح",1,0],["حُشِدَتْ مَرْبَعَاءُ فيهِ وَمَرْدٌ،","وَقُصُورُ البَلّيخِ والمَازِجانِ",42,"ن",1,0],["حَشًا لم يزلْ تقوَى اله يكفُّهُ","بما خفَّ من زاد وما آب مطعما",43,"م",2,0],["حِشمتي خلقة ٌ ولي من الخِل","قة ِ أن تستقيدَ للمخلوق",44,"ق",1,0],["حشد من العجلات يلهث في السياق وفي التوالي","وهناك (نصرانية) كحصان (مسعود الهلالي)",45,"ل",2,0],["حشدوا جندهم وأقبل سعد","يحشد البأس والعقيدة جندا",46,"د",2,0],["حَشَّ مِنَّا حَرباً فَنَحنُ عِيَالُ الشَّي","خِ نَبأى بِأن نَكُونَ عِيَالا",47,"ل",2,0],["حَشوَ جُيوشٍ إِذا اِنتَحَت بَلَداً","فَقائِداها النَجاحُ وَالرَشَدُ",48,"د",1,0],["حَشايَ وأجفَانِي لَهِيبٌ وأدمُعٌ","فآونَةً سَحَّاً وآوِنَةً لَفحَا",49,"ح",2,0],["حَشا اللَهُ مِنهُ أَنفُس القَومِ رَهبَةً","فَجاؤا وَمَن لَم يأتِ أَصبَحَ نُهبَةً",50,"ه",1,0],["حَشا رَبُّهُ مِنهُ السَرآئِرَ رأفَةً","كَما قَد كَسى مِنهُ الظواهِرَ عِفَّةً",51,"ه",1,0],["حشدتهم في قفر حاشد للردى","وما صدع الأحشا كصادعة الشمل",52,"ل",1,0],["حَشايا وَأَرمِيميَّةً وقَواتِراً","مُقَسَّمَةَ الأَلباسِ حِنوَ الكَتائِفِ",53,"ف",1,0],["حَشا عَقيدتهُ حشواً يُخلُّ بما","قَد صحّ للَّه من وصفٍ يليق بهِ",54,"ب",2,0],["حشا في حشائي الهمَّ والشوقَ ما حشا","غزالٌ من الأتراكِ ليس به حشى",55,"ش",2,1],["حَشرَجَت روحُه صَباحَ نَهارٍ","بِعَذابٍ فَقاءَها في المَساءِ",56,"ا",2,0],["حُشاشَةٌ لو أَنّها قَطرَةٌ","تجولُ في عَينَيكَ لم تُنظَرِ",57,"ر",1,0],["حشَتْ بالكحْل عينيها وبانت","غداة غدت بها العِيسُ الشدادُ",58,"د",1,1],["حَشَوْا بفراقهم ناراً حَشَاهُ","فأخلَوْا مُقْلَتَيْهِ من كَراهُ",59,"ا",2,1],["حَشرٌ وَميزانٌ وَعَرضُ جَرائِدٍ","وَصَحائِفٌ مَنشورَةٌ وَحِسابُ",60,"ب",1,0],["حشايَ كنارٍ يُصطلى بلهيبها","وهَل تبردُ الأحشاءُ والرأسُ يرمض",61,"ض",1,0],["حشاي على جمرٍ ذكى من الجوى","وعيناي في روضٍ من الحسن ترتع",62,"ع",1,0],["حَشَيتَ بِالمُنَغَّصاتِ وما فيها","يا أَخي مِنَ السُرورِ فَتيلُ",63,"ل",1,0],["حشوها الجمر لم تطب برقاد","ولحزن فدمعها سجام",64,"م",1,0],["حَشْوُ فؤادي فَرَحُ","في صَحْنِ كَفّي قَدَحُ",65,"ح",1,1],["حَشَدَ الذُنوبَ عَلَيَّ يَومَ عِتابي","حَتّى لَأَذكَرَني بَيَومِ حِسابي",66,"ب",2,1],["حَشَدَت لَنا جَيشَ البَلاغَةِ سائِراً","وَمِنَ السُطورِ لِواؤُهُ مَنصوبُ",67,"ب",1,0],["حِشمَة مِن جَميعِ ما سارَ عنِّي","غيرَ ما كانَ في ابنِ إبراهيما",68,"م",2,0],["حشم المسلمون قد أخذوها","وسبوها بلا حياء وحشمه",69,"م",2,0],["حشاشة القلب حشيش لها","ومدمع العين لها مشرب",70,"ب",1,0],["حشرت لسدّ الماء كلَّ قبيلةٍ","لها وقفة ترضيك في وقفة الحشر",71,"ر",1,0],["حُشِدوا على جنباتِ نعشِك وُقَّعاً","حشدَ العطاش على شفيرِ المنهلِ",72,"ل",1,0],["حشايا رحال من دمقس وثيرةٌ","وغرُّ جفانٍ من نضيدٍ مهشَّم",73,"م",1,0],["حشا كلَّ قلب لوعة صمتُ قلبهِ","وضاعفها نطق النطاقين والوشح",74,"ح",1,0],["حَشلافُ قد ماتَ ابنه مُردِّداً","لسانَ حالِه لفَرطِ غَمِّه",75,"ه",1,1],["حشاه السِّنانُ ثم خرَّ لأنفِه","كما قطَّرَ الكَعبَ المؤرِّبَ ناهدُ",76,"د",1,0],["حَشَرَ الإِلهُ مَعَ القُرودِ مُحَلِّماً","وَأَبا رَبيعَةُ أَلأَمَ الأَقوامِ",77,"م",1,1]]}