{"poems":[[77,"وجودك حي الملك والدين والدنيا","https://www.aldiwan.net/poem35717.html","الطويل"],[77,"جعلت إليك الله والملأ الأعلى","https://www.aldiwan.net/poem35720.html","الطويل"],[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[77,"أنور سناء لاح في مشرق الغرب","https://www.aldiwan.net/poem36773.html","الطويل"],[77,"وليلة أنس باح منا بها الهوى","https://www.aldiwan.net/poem36778.html","الطويل"],[30,"أخرقاء للبين استقلت حمولها","https://www.aldiwan.net/poem29537.html","الطويل"],[30,"خليلي عوجا بارك الله","https://www.aldiwan.net/poem29611.html","الطويل"],[4,"تمنى ابنتاي أن يعيش أبوهما","https://www.aldiwan.net/poem21169.html","الطويل"],[51,"قد حلفنا على الصفاء جميعا","https://www.aldiwan.net/poem65697.html","الخفيف"],[51,"ليهنك أن أفطرت لا متطلعا","https://www.aldiwan.net/poem66008.html","الطويل"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[89,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[85,"لم يمت من له أثر","https://www.aldiwan.net/poem62861.html","مجزوء الخفيف"],[43,"حشاشة نفس ودعت يوم ودعوا","https://www.aldiwan.net/poem9720.html","الطويل"],[45,"لك عهد لدي غير مضاع","https://www.aldiwan.net/poem64657.html","الخفيف"],[45,"عهد لعلوة باللوى قد أشكلا","https://www.aldiwan.net/poem65545.html","الكامل"],[45,"أترى الزمان يعيد لي أيامي","https://www.aldiwan.net/poem65674.html","الكامل"],[45,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[97,"آه من لحن سماوي","https://www.aldiwan.net/poem24608.html","مجزوء الرمل"],[80,"لي قلب من جلمد الصخر أقسى","https://www.aldiwan.net/poem31374.html","الخفيف"],[80,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[80,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[44,"وأخ بشعت بعرفه ومذاقه","https://www.aldiwan.net/poem29714.html","الكامل"],[69,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[105,"وفت الظنون وبرت الآمال","https://www.aldiwan.net/poem42085.html","الكامل"],[105,"هل ليم نضو صبابة فأفاقا","https://www.aldiwan.net/poem43377.html","الكامل"],[52,"يا صاحبي شيبت عفوا","https://www.aldiwan.net/poem26585.html","مجزوء الكامل"],[50,"حشاشة ودعتني يوم بينهم","https://www.aldiwan.net/poem24525.html","البسيط"],[50,"لا تعد لي كليلة بالجماد","https://www.aldiwan.net/poem63953.html","الخفيف"],[46,"ألم ترني مع الأيام أمسي","https://www.aldiwan.net/poem22684.html","الوافر"],[46,"وبالي فيك يا دنيا وبالي","https://www.aldiwan.net/poem23231.html","الوافر"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125686","الرمل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140816",""],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54241","الطويل"],[98,"مصرع النسر","https://www.poetsgate.com/ViewPoem.aspx?id=55338",""],[90,"ذات الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=179215",""],[90,"النشيد الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=178973",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"ماهذه النفوس قداح","https://www.poetsgate.com/ViewPoem.aspx?id=178947",""],[45,"أتَرَاهُ يَظُنُّني، أوْ يَرَانِي","https://www.poetsgate.com/ViewPoem.aspx?id=32077",""],[51,"ليهنَكَ أن أفطرتَ لا متطلعاً","https://www.poetsgate.com/ViewPoem.aspx?id=30406",""],[51,"قد حَلفنَا على الصفاء جميعاً","https://www.poetsgate.com/ViewPoem.aspx?id=29909",""]],"verses":[["حَشاياهُمُ عندَ الكَرى صهَواتُها","فأحْلامُهُمْ بالسّبْيِ صادِقَةُ الرّؤيا",0,"ي",2,0],["حَشاكَ بأنْ تَبْدو لهُمْ منْكَ وحْشَةٌ","ومِنْ دونِهِم عُرِّفْتَهُ البِرَّ والفَضْلا",1,"ل",2,0],["حشَرَ الأنامَ فَما يؤمَّلُ حصْرُهُ","بشَبا اليَراعِ ولا يُطاقُ حِصارُهُ",2,"ر",2,0],["حَشَا بَاهِظَ الأَجْزَالِ وَقْدَ ضِرَامِهَا","فَأَوْرَتْ جَحِيماً لاَفِحاً أَوْجُهَ السُّحْبِ",3,"ب",1,0],["حَشَدْنَا جُمُوعَ اللَّحْنِ مِنْهُ فَأَقْبَلَتْ","كَتَائِبَ تَقْفُوْ إِثْرَهُنَّ كَتَائِبُ",4,"ب",1,0],["حَشَتها الزُبانى حِرَّةً في صُدورِها","وَسَيَّرَها مِن صُلبِ رَهبى ثَميلُها",5,"ل",3,0],["حَشَوتُ الِقلاصَ اللَيلَ حَتّى وَرَدنَهُ","بِنا قَبلَ أَن تَخفى صِغارُ الكَواكِبِ",6,"ب",1,0],["حَشودٌ عَلى المِقرى إِذا البُزلُ حارَدَت","سَريعٌ إِلى الداعي مُطاعٌ إِذا أَمَر",7,"ر",1,0],["حشمتي خلقة وليس من الحك","مة أن تستقيد للمخلوق",8,"ق",1,0],["حَشاً لم يزلْ تقوَى الإله يكفُّهُ","بما خفَّ من زاد وما آب مطعما",9,"م",2,0],["حشد الربيعُ مع الربيع لهُ","فغدا يهُزُّ أثائثَ الجُممِ",10,"م",1,0],["حُشدٌ عَلى الحَقِّ عَيّافو الخَنا أُنُفٌ","إِذا أَلَمَّت بِهِم مَكروهَةٌ صَبَروا",11,"ر",3,0],["حشروني والجامدين على ما","اخذوا من آبائهم في صعيد",12,"د",1,0],["حَشَرَ الناسَ تَحتَهُ","زُمَراً إِثرَها زُمَر",13,"ر",1,0],["حُشاشَةُ نَفسٍ وَدَّعَت يَومَ وَدَّعوا","فَلَم أَدرِ أَيَّ الظاعِنَينِ أُشَيِّعُ",14,"ع",1,1],["حَشايَ عَلى جَمرٍ ذَكِيٍّ مِنَ الهَوى","وَعَينايَ في رَوضٍ مِنَ الحُسنِ تَرتَعُ",14,"ع",1,0],["حَشَدَت حَولَها سِباعُ المَوالي","وَالعَوالي غابٌ لِتِلكَ السِباعِ",15,"ع",1,0],["حَشَدَت لَهُ الأَمواجُ فَضلَ دَوافِعٍ","أَعجَلنَ دولابَيهِ أَن يَتَمَهَّلا",16,"ل",2,0],["حَشَدَت مَواليهِ لَهُ فَتَرادَفَت","عُصَباً تُسايِفُ دونَهُ وَتُرامي",17,"م",2,0],["حَشَدَت مَربَعاءُ فيهِ مَردٌ","وَقُصورُ البَليخِ وَالمازِجانِ",18,"ن",1,0],["حشدَ العالم كالعُ","باد قاموا للصلاة",19,"ه",1,0],["حشوُها من فُلولِ عَضْبي شَظَايا","كَنُيوبٍ عَنْهُنَّ قَلّصَ شِدْقُ",20,"ق",1,0],["حَشوها على الأَعداءِ بالبيضِ والقَنا","وبالزّرَدِ المَوضونِ والضُمّر الجُرْدِ",21,"د",1,0],["حَشَوْا من عجاجاتِ الجهادِ وسائداً","تُعَدّ لهم في الدّفن تَحتَ المَناكِبِ",22,"ب",1,0],["حَشَمُ الصَديقِ عُيونُهُم بَحّاثَةٌ","لِصَديقِهِ عَن صِدقِهِ وَنِفاقِهِ",23,"ق",2,0],["حشا أذنِي بِدُرٍّ ساقَطَتْهُ","عيوني يومَ حُمَّ لهُ الحمامُ",24,"م",1,0],["حَشدَ الحواريّينَ حَولَ جُموعهِ","وَرَمى فتلك صُروحُه تنهالُ",25,"ل",1,0],["حَشَدوا المَلاوِمَ وَاِنبَرى بِلِوائِهِ","يُزجي العُهودَ وَيَحشُدُ الأَشواقا",26,"ق",2,0],["حُشِيَت عَقارِبُ صُدغِهِ","بِالمِسكِ في خَدَّيهِ حَشوا",27,"و",2,0],["حُشاشَةٌ وَدَّعَتني يَومَ بَينِهِمُ","وَشَيَّعَتهُم وَخَلَّتني وَأَحزاني",28,"ي",1,1],["حَشرُ عَينٍ يَلقى البَغيضَ وَلا يَل","قى مُحِبّاً عَينانِ دونَ اِزدِيادِ",29,"د",1,0],["حَشَدتُ أَو اِنفَرَدتُ فَلِلَّيالي","كَتائِبٌ سَوفَ تَطرِقُني بِمَجرِ",30,"ر",1,0],["حُشاشَةُ عائِشٍ وَنَجيعُ نَحضٍ","وَهَيكَلُ مَيتٍ وَعُروقُ بالي",31,"ي",1,0],["حشدَ العالم كالعُب","باد قاموا للصلاة",32,"ه",1,0],["حشاشة نفسٍ ودعت يوم ودعوا","فلم أدر أي الظاعنين أشبع؟",33,"ع",1,1],["حُشاشةُ نفسٍ صُوِّرتْ في مدامعٍ","وجَذْوةُ نارٍ في الْحَشا سُمِّيتْ وجدا",34,"د",2,0],["حُشُودٌ على الآلامِ والحزن تلتقي","يقاسمُ حَشْدٌ في رَزيئتهِ حشدا",34,"د",2,0],["حشد العُرْبَ تحت رايته السَّمْ","حاءِ والعدلَ والعُلا والمكارم",35,"م",1,0],["حَشَدْتُ له من عَبيدِ الهَوَى","عَطاشَى مُحَلأةً جُوعا",36,"ع",2,0],["حُشاشةُ نفسٍ أجهدت فيك والهوى","يطاردها عن قصدها وتطارد",37,"د",1,0],["حشَدوا عليَّ المُغرِياتِ مُسيلةً","صغراً لُعابُ الأرذلينَ رغائبا",38,"ب",2,0],["حَشدوا عليه الجُوعَ يَنْشِبُ نابَهُ","في جلدِ \" أرقطِ \" لا يُبالي ناشبا !",38,"ب",2,0],["حشى أفسحت فيه المنى خطواتها","فضاقت به الأرجاء وهي فساح",39,"ح",1,0],["حُشِدَتْ مَرْبَعَاءُ فيهِ وَمَرْدٌ،","وَقُصُورُ البَلّيخِ والمَازِجانِ",40,"ن",1,0],["حَشًا لم يزلْ تقوَى اله يكفُّهُ","بما خفَّ من زاد وما آب مطعما",41,"م",2,0],["حِشمتي خلقة ٌ ولي من الخِل","قة ِ أن تستقيدَ للمخلوق",42,"ق",1,0]]}