""],[5329,"أمنيات ...","https://www.poetsgate.com/ViewPoem.aspx?id=215067",""],[5335,"الموعد الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=35186",""],[5338,"إن لم تثر في نصر أهلك في اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=187944",""],[5351,"عذاب اليوم..","https://www.poetsgate.com/ViewPoem.aspx?id=203746",""],[5397,"هلا سألت مرابعا وطلولا","https://www.poetsgate.com/ViewPoem.aspx?id=157941",""],[5409,"علموا الميسر العروب وقالوا","https://www.poetsgate.com/ViewPoem.aspx?id=155317",""],[5409,"أضحكتنا ورب ضحكٍ بكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155244",""],[5431,"ليت الهوى ماروعك!!","https://www.poetsgate.com/ViewPoem.aspx?id=196930",""],[5431,"هي لم تعد لليوم تهواه!","https://www.poetsgate.com/ViewPoem.aspx?id=201336",""],[5431,"عنه الظلامُ بحول الله منكفئُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=201569",""],[5431,"رقص أفريقي...","https://www.poetsgate.com/ViewPoem.aspx?id=202486",""],[5431,"إلى أختي أميمة ...","https://www.poetsgate.com/ViewPoem.aspx?id=206056",""],[5431,"على لسان الحرية...","https://www.poetsgate.com/ViewPoem.aspx?id=209177",""],[5480,"لي عزه","https://www.poetsgate.com/ViewPoem.aspx?id=9891",""],[5512,"شجون فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=204171",""],[470,"حشودٌ من الحب والكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=194105",""],[5582,"ثَنَتْ لِوَداعِي جِيدَها غُدْوَةً يُسْرَا","https://www.poetsgate.com/ViewPoem.aspx?id=187150",""],[5582,"سُطُورُ هَوَىً ما فِي حَقِيقَتِها لَغْوُ","https://www.poetsgate.com/ViewPoem.aspx?id=187334",""],[5595,"شِيباً شَباباً نعتليها عَنْوَةً","https://www.poetsgate.com/ViewPoem.aspx?id=177053",""],[1547,"تضاعف ضَعفي بَعد الحبائبِ","https://www.poetsgate.com/ViewPoem.aspx?id=16710",""],[5638,"رثاء وأمل في اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=198247",""],[5691,"بيت الغرابيب","https://www.poetsgate.com/ViewPoem.aspx?id=206248",""],[5691,"عروش الطغاة","https://www.poetsgate.com/ViewPoem.aspx?id=207075",""],[5723,"ينابيع للشهادة والزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=190280",""],[5741,"هذي القطيفة التي","https://www.poetsgate.com/ViewPoem.aspx?id=187494",""],[5797,"عجبًا لابن آدم","https://www.poetsgate.com/ViewPoem.aspx?id=187797",""],[5879,"الوجد لي","https://www.poetsgate.com/ViewPoem.aspx?id=215458",""],[5956,"الموج يعزف لحنه ويجيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=183296",""],[6031,"يا سَاكِنِيْ الخَطِّ في قَلْبي لَكُمْ خِطَطٌ","https://www.poetsgate.com/ViewPoem.aspx?id=46308",""],[6142,"حشدوا كل واحدٍ من قبيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155696",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[5051,"سَقْطُ القريض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87709&r=&rc=3",""],[2638,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87865&r=&rc=22",""]],"verses":[["حَشاياهُمُ عندَ الكَرى صهَواتُها","فأحْلامُهُمْ بالسّبْيِ صادِقَةُ الرّؤيا",0,"ي",2,0],["حَشاكَ بأنْ تَبْدو لهُمْ منْكَ وحْشَةٌ","ومِنْ دونِهِم عُرِّفْتَهُ البِرَّ والفَضْلا",1,"ل",2,0],["حشَرَ الأنامَ فَما يؤمَّلُ حصْرُهُ","بشَبا اليَراعِ ولا يُطاقُ حِصارُهُ",2,"ر",2,0],["حَشَا بَاهِظَ الأَجْزَالِ وَقْدَ ضِرَامِهَا","فَأَوْرَتْ جَحِيماً لاَفِحاً أَوْجُهَ السُّحْبِ",3,"ب",1,0],["حَشَدْنَا جُمُوعَ اللَّحْنِ مِنْهُ فَأَقْبَلَتْ","كَتَائِبَ تَقْفُوْ إِثْرَهُنَّ كَتَائِبُ",4,"ب",1,0],["حَشَتها الزُبانى حِرَّةً في صُدورِها","وَسَيَّرَها مِن صُلبِ رَهبى ثَميلُها",5,"ل",3,0],["حَشَوتُ الِقلاصَ اللَيلَ حَتّى وَرَدنَهُ","بِنا قَبلَ أَن تَخفى صِغارُ الكَواكِبِ",6,"ب",1,0],["حَشودٌ عَلى المِقرى إِذا البُزلُ حارَدَت","سَريعٌ إِلى الداعي مُطاعٌ إِذا أَمَر",7,"ر",1,0],["حشمتي خلقة وليس من الحك","مة أن تستقيد للمخلوق",8,"ق",1,0],["حَشاً لم يزلْ تقوَى الإله يكفُّهُ","بما خفَّ من زاد وما آب مطعما",9,"م",2,0],["حشد الربيعُ مع الربيع لهُ","فغدا يهُزُّ أثائثَ الجُممِ",10,"م",1,0],["حُشدٌ عَلى الحَقِّ عَيّافو الخَنا أُنُفٌ","إِذا أَلَمَّت بِهِم مَكروهَةٌ صَبَروا",11,"ر",3,0],["حشروني والجامدين على ما","اخذوا من آبائهم في صعيد",12,"د",1,0],["حَشَرَ الناسَ تَحتَهُ","زُمَراً إِثرَها زُمَر",13,"ر",1,0],["حُشاشَةُ نَفسٍ وَدَّعَت يَومَ وَدَّعوا","فَلَم أَدرِ أَيَّ الظاعِنَينِ أُشَيِّعُ",14,"ع",1,1],["حَشايَ عَلى جَمرٍ ذَكِيٍّ مِنَ الهَوى","وَعَينايَ في رَوضٍ مِنَ الحُسنِ تَرتَعُ",14,"ع",1,0],["حَشَدَت حَولَها سِباعُ المَوالي","وَالعَوالي غابٌ لِتِلكَ السِباعِ",15,"ع",1,0],["حَشَدَت لَهُ الأَمواجُ فَضلَ دَوافِعٍ","أَعجَلنَ دولابَيهِ أَن يَتَمَهَّلا",16,"ل",2,0],["حَشَدَت مَواليهِ لَهُ فَتَرادَفَت","عُصَباً تُسايِفُ دونَهُ وَتُرامي",17,"م",2,0],["حَشَدَت مَربَعاءُ فيهِ مَردٌ","وَقُصورُ البَليخِ وَالمازِجانِ",18,"ن",1,0],["حشدَ العالم كالعُ","باد قاموا للصلاة",19,"ه",1,0],["حشوُها من فُلولِ عَضْبي شَظَايا","كَنُيوبٍ عَنْهُنَّ قَلّصَ شِدْقُ",20,"ق",1,0],["حَشوها على الأَعداءِ بالبيضِ والقَنا","وبالزّرَدِ المَوضونِ والضُمّر الجُرْدِ",21,"د",1,0],["حَشَوْا من عجاجاتِ الجهادِ وسائداً","تُعَدّ لهم في الدّفن تَحتَ المَناكِبِ",22,"ب",1,0],["حَشَمُ الصَديقِ عُيونُهُم بَحّاثَةٌ","لِصَديقِهِ عَن صِدقِهِ وَنِفاقِهِ",23,"ق",2,0],["حشا أذنِي بِدُرٍّ ساقَطَتْهُ","عيوني يومَ حُمَّ لهُ الحمامُ",24,"م",1,0],["حَشدَ الحواريّينَ حَولَ جُموعهِ","وَرَمى فتلك صُروحُه تنهالُ",25,"ل",1,0],["حَشَدوا المَلاوِمَ وَاِنبَرى بِلِوائِهِ","يُزجي العُهودَ وَيَحشُدُ الأَشواقا",26,"ق",2,0],["حُشِيَت عَقارِبُ صُدغِهِ","بِالمِسكِ في خَدَّيهِ حَشوا",27,"و",2,0],["حُشاشَةٌ وَدَّعَتني يَومَ بَينِهِمُ","وَشَيَّعَتهُم وَخَلَّتني وَأَحزاني",28,"ي",1,1],["حَشرُ عَينٍ يَلقى البَغيضَ وَلا يَل","قى مُحِبّاً عَينانِ دونَ اِزدِيادِ",29,"د",1,0],["حَشَدتُ أَو اِنفَرَدتُ فَلِلَّيالي","كَتائِبٌ سَوفَ تَطرِقُني بِمَجرِ",30,"ر",1,0],["حُشاشَةُ عائِشٍ وَنَجيعُ نَحضٍ","وَهَيكَلُ مَيتٍ وَعُروقُ بالي",31,"ل",2,0],["حشدَ العالم كالعُب","باد قاموا للصلاة",32,"ه",1,0],["حَشَا ضِغْثَ شُقَّارَى شَرَاسِيفَ ضُمَّراً","تَخَذَّمَ مِنْ أَطْرَافِهَا مَا تَخَذَّمَا",33,"م",2,0],["حشاشة نفسٍ ودعت يوم ودعوا","فلم أدر أي الظاعنين أشبع؟",34,"ع",1,1],["حُشاشةُ نفسٍ صُوِّرتْ في مدامعٍ","وجَذْوةُ نارٍ في الْحَشا سُمِّيتْ وجدا",35,"د",2,0],["حُشُودٌ على الآلامِ والحزن تلتقي","يقاسمُ حَشْدٌ في رَزيئتهِ حشدا",35,"د",2,0],["حشد من العجلات يلهث","في السباق وفي التوالي",36,"ل",2,0],["حشد العُرْبَ تحت رايته السَّمْ","حاءِ والعدلَ والعُلا والمكارم",37,"م",1,0],["حَشَدْتُ له من عَبيدِ الهَوَى","عَطاشَى مُحَلأةً جُوعا",38,"ع",2,0],["حُشاشةُ نفسٍ أجهدت فيك والهوى","يطاردها عن قصدها وتطارد",39,"د",1,0],["حشَدوا عليَّ المُغرِياتِ مُسيلةً","صغراً لُعابُ الأرذلينَ رغائبا",40,"ب",2,0],["حَشدوا عليه الجُوعَ يَنْشِبُ نابَهُ","في جلدِ \" أرقطِ \" لا يُبالي ناشبا !",40,"ب",2,0],["حشى أفسحت فيه المنى خطواتها","فضاقت به الأرجاء وهي فساح",41,"ح",1,0],["حُشِدَتْ مَرْبَعَاءُ فيهِ وَمَرْدٌ،","وَقُصُورُ البَلّيخِ والمَازِجانِ",42,"ن",1,0],["حَشًا لم يزلْ تقوَى اله يكفُّهُ","بما خفَّ من زاد وما آب مطعما",43,"م",2,0],["حِشمتي خلقة ٌ ولي من الخِل","قة ِ أن تستقيدَ للمخلوق",44,"ق",1,0],["حشد من العجلات يلهث في السياق وفي التوالي","وهناك (نصرانية) كحصان (مسعود الهلالي)",45,"ل",2,0],["حشدوا جندهم وأقبل سعد","يحشد البأس والعقيدة جندا",46,"د",2,0],["حَشَّ مِنَّا حَرباً فَنَحنُ عِيَالُ الشَّي","خِ نَبأى بِأن نَكُونَ عِيَالا",47,"ل",2,0],["حَشوَ جُيوشٍ إِذا اِنتَحَت بَلَداً","فَقائِداها النَجاحُ وَالرَشَدُ",48,"د",1,0],["حَشايَ وأجفَانِي لَهِيبٌ وأدمُعٌ","فآونَةً سَحَّاً وآوِنَةً لَفحَا",49,"ح",2,0],["حَشا اللَهُ مِنهُ أَنفُس القَومِ رَهبَةً","فَجاؤا وَمَن لَم يأتِ أَصبَحَ نُهبَةً",50,"ه",1,0],["حَشا رَبُّهُ مِنهُ السَرآئِرَ رأفَةً","كَما قَد كَسى مِنهُ الظواهِرَ عِفَّةً",51,"ه",1,0],["حشدتهم في قفر حاشد للردى","وما صدع الأحشا كصادعة الشمل",52,"ل",1,0],["حَشايا وَأَرمِيميَّةً وقَواتِراً","مُقَسَّمَةَ الأَلباسِ حِنوَ الكَتائِفِ",53,"ف",1,0],["حَشا عَقيدتهُ حشواً يُخلُّ بما","قَد صحّ للَّه من وصفٍ يليق بهِ",54,"ب",2,0],["حشا في حشائي الهمَّ والشوقَ ما حشا","غزالٌ من الأتراكِ ليس به حشى",55,"ش",2,1],["حَشرَجَت روحُه صَباحَ نَهارٍ","بِعَذابٍ فَقاءَها في المَساءِ",56,"ا",2,0],["حُشاشَةٌ لو أَنّها قَطرَةٌ","تجولُ في عَينَيكَ لم تُنظَرِ",57,"ر",1,0],["حشَتْ بالكحْل عينيها وبانت","غداة غدت بها العِيسُ الشدادُ",58,"د",1,1],["حَشَوْا بفراقهم ناراً حَشَاهُ","فأخلَوْا مُقْلَتَيْهِ 