{"poems":[[53,"أيعلم قبر بالجنينة أننا","https://www.aldiwan.net/poem29621.html","الطويل"],[53,"ما أسرع الأيام في طينا","https://www.aldiwan.net/poem29723.html","السريع"],[53,"قال الضمير بما علم","https://www.aldiwan.net/poem29764.html","مجزوء الكامل"],[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[53,"عجلت يا شيب على مفرقي","https://www.aldiwan.net/poem29876.html","السريع"],[53,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[53,"ردي مر الورود ولا تعافي","https://www.aldiwan.net/poem29969.html","الوافر"],[53,"حططت المكارم عن عاتقي","https://www.aldiwan.net/poem30520.html","المتقارب"],[53,"خير الهوى ما نجا من الكمد","https://www.aldiwan.net/poem30628.html","المنسرح"],[77,"أيام قربك عندي ما لها ثمن","https://www.aldiwan.net/poem36028.html","البسيط"],[77,"أدارهم بين الأجارع فالسدر","https://www.aldiwan.net/poem36515.html","الطويل"],[9,"أصرمت حبلك من لمي","https://www.aldiwan.net/poem21911.html","مجزوء الكامل"],[86,"سلام على الإسلام بعد محمد","https://www.aldiwan.net/poem10494.html","الطويل"],[86,"حطمت اليراع فلا تعجبي","https://www.aldiwan.net/poem10923.html","المتقارب"],[73,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[37,"نفى عن عينك الأرق الهجوعا","https://www.aldiwan.net/poem7654.html","الوافر"],[72,"مدمع سائل لغير رحيم","https://www.aldiwan.net/poem19679.html","الخفيف"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[51,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[91,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[92,"غنني أنشودة الفجر الضحوك","https://www.aldiwan.net/poem38961.html","الرمل"],[85,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[85,"كاتب محسن البيان صناعه","https://www.aldiwan.net/poem62841.html","الخفيف"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[45,"هبل الواشي بها أنى أفك","https://www.aldiwan.net/poem65215.html","الرمل"],[45,"أكثرت في لوم المحب فأقلل","https://www.aldiwan.net/poem65591.html","الكامل"],[45,"أنظر إلى العلياء كيف تضام","https://www.aldiwan.net/poem65657.html","الكامل"],[45,"لامت علي أنها في الدمع لم تلم","https://www.aldiwan.net/poem66653.html","البسيط"],[28,"لا فضل إلا فضل أم على ابنها","https://www.aldiwan.net/poem5365.html","الطويل"],[61,"غنت تحاوره بطرف أحور","https://www.aldiwan.net/poem51605.html","الكامل"],[66,"أخلاي بالفيحاء إن طال بعدكم","https://www.aldiwan.net/poem40651.html","الطويل"],[97,"يا ساعة الحسرات والعبرات","https://www.aldiwan.net/poem24911.html","الكامل"],[97,"بطل الأبطال من أرض الهرم","https://www.aldiwan.net/poem24965.html","الرمل"],[80,"لم نؤت ليلتنا الغراء من قصر","https://www.aldiwan.net/poem31448.html","البسيط"],[44,"إن عهدا لو تعلمان ذميما","https://www.aldiwan.net/poem30357.html","الخفيف"],[44,"ما لي بعادية الأيام من قبل","https://www.aldiwan.net/poem30374.html","البسيط"],[44,"عفت أربع الحلات للأربع الملد","https://www.aldiwan.net/poem30536.html","الطويل"],[44,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[74,"يا رب مائسة المعاطف تزدهي","https://www.aldiwan.net/poem12885.html","الكامل"],[105,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[102,"أهلا برب المهرجان","https://www.aldiwan.net/poem33112.html","مجزوء الكامل"],[40,"رأتني خضيب الرأس شمرت مئزري","https://www.aldiwan.net/poem42314.html","البسيط"],[22,"طافت أمامة بالركبان آونة","https://www.aldiwan.net/poem21638.html","البسيط"],[52,"ومشمولة قد طال بالقفص حبسها","https://www.aldiwan.net/poem27087.html","الطويل"],[48,"غدوت وما يشجي فؤادي خوادش","https://www.aldiwan.net/poem63271.html","الطويل"],[48,"وخيمة ناطور برأس منيفة","https://www.aldiwan.net/poem64489.html","الوافر"],[50,"مللت مبيتي بالقرين وشاقني","https://www.aldiwan.net/poem63905.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55437","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54829","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[104,"جمرة العطر","https://www.poetsgate.com/ViewPoem.aspx?id=37412",""],[106,"عودة إلى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=179678",""],[106,"من وحي الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=179738",""],[106,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[22,"طافت أُمامة ُ بالرُكبان آوِنَة ً","https://www.poetsgate.com/ViewPoem.aspx?id=19728",""],[45,"هُبِلَ الوَاشِي بهَا، أنّى أفَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=33095",""]],"verses":[["حَطَطنا فَحَيَّينا مَساعيهِ أَنَّها","عِظامُ المَساعي لا العِظامَ البَوالِيا",0,"ي",2,0],["حَطَّ رِجالٌ وَرَكِبنا الذُرى","وَعُقبَةُ السَيرِ لِمَن بَعدَنا",1,"ن",2,0],["حَطَّت إِلَيكَ مِنَ الضَم","ئِرِ في رِشاءٍ مِن نَدَم",2,"م",1,0],["حُطَّت بِأَطرافِ البِلادِ قُبورُهُم","رُقُمُ النُجومِ سُقوفُ لَيلٍ مُظلِمِ",3,"م",1,0],["حَطَّ بِرَأسي يَقَقاً أَبيَضاً","كَأَنَّما حَطَّ بِهِ مُنصُلا",4,"ل",2,0],["حَطَطتَهُ مِن ذُرى صَمّاءَ شاهِقَةٍ","مِنَ الزَمانِ عَلَيها غَيرُ مُحتَفِلِ",5,"ل",1,0],["حَطَمتُ صِعادَهُم حَتّى اِستَقاموا","مُجاوَزَةً بِهِم حَدَّ الثِقافِ",6,"ف",1,0],["حَطَطتُ المَكارِمَ عَن عاتِقي","وَجَرَّدَني الذُلُّ عَن مَحتِدي",7,"ي",1,1],["حَطَطتَ فيهِ الرِحالَ مُحتَزِماً","وَأَنتَ ثاني المُهَنَّدِ الفَرَدِ",8,"د",1,0],["حَطَطْتُ بَعْدَكَ يَاأَهْلِي وَيَاوَطَنِي","رَحْلَ الْغَرِيبِ فَلاَ أَهْلٌ وَلاَ وَطَنُ",9,"ن",1,0],["حطَطْتُ بآلِ اللهِ عُوجَ رَكائِبي","فلُقّيتُ بالتّرْحيبِ والسّهْلِ والبِرِّ",10,"ر",1,0],["حَطَّت لَهُ ريحٌ كَما","حُطَّت إِلى مَلِكٍ عِيابُه",11,"ب",2,0],["حَطَمتِ لَنا سَيفاً وَعَطَّلتِ مِنبَراً","وَأَذوَيتِ رَوضاً ناضِرَ الزَهَراتِ",12,"ت",1,0],["حَطَمتُ اليَراعَ فَلا تَعجَبي","وَعِفتُ البَيانَ فَلا تَعتَبي",13,"ي",1,1],["حَطَطتُم بِحَيثُ اسلَنطَحَت ساحَةُ العُلا","وَأَوفَت لِإِخطارِ السَناءِ هِضابُ",14,"ب",1,0],["حُطتَ البلاد ومن حوته ثغورها","وكفى بسعدك حامياً لذمارِ",15,"ر",1,0],["حَطُوطَاً في مَسَرَّتِهِ وَمَولَىً","الى مَرضَاةِ خَالِقِهِ سَرِيعَا",16,"ع",2,0],["حطَّم الوجد ركن دمعي وطافت","لوعتي بين زمزمٍ والحطيم",17,"م",1,0],["حططتُ إلى النُّهى رحلي وكلَّتْ","مطيّةُ باطلي بعد الهِبابِ",18,"ب",1,0],["حططنَ بواسطٍ من بعد سبعٍ","وقد مال الشروقُ إلى الغروبِ",19,"ب",1,0],["حطَّ ثِقلَ الخراجِ عنِّي وقد كا","ن كأركانِ يَذْبُلٍ وشمام",20,"م",1,0],["حَطَّمَ السَيف وَما أَبقى الدُروع","وَتَداعى دونَهُ السورُ المَنيع",21,"ع",1,0],["حَطَّمَتْ كَفُّ الأَسَى قِيثارَتي","فِي يَدِ الأَحْلامْ",22,"م",1,0],["حطوا على الأرض السرير وغيبوا","قمر السماء ووسدوا جوزاءها",23,"ا",3,0],["حَطَّهُم بِالإِمامِ لِلمَوتِ رَكبٌ","يَتَلاقى بِطاؤُهُ وَسِراعُه",24,"ع",2,0],["حَطّى غَدَت جُشَمُ بنِ بَكرٍ تَبتَغي","إِرثَ النَبِيِّ وَتَدَّعيهِ حُقوقا",25,"ق",2,0],["حَطَّ في طَلحَتَ أَو في","مُصعَبٍ لا يُبالي أَيَّ أُسلُبٍ سَلَك",26,"ك",1,0],["حَطَّت عَلى تِلكَ الأَجارِعِ وَالرُبى","مِنهُنَّ أَعباءُ الغَمامِ المُثقَلِ",27,"ل",1,0],["حُطَّت سُروجُ أَبي سَعيدٍ وَاِغتَدَت","أَسيافُهُ دونَ العَدُوِّ تُشامُ",28,"م",1,0],["حَطَّمتَ مَنكِبَهُم لَمّا حَلَلتَ بِهِم","بِمَنكِبٍ مِنكَ أَضحى غَيرَ مُنحَطِمِ",29,"م",1,0],["حَطَمتَ قُيودي حَطمَةً لَم تَدَع لَها","بِساقَيَّ إِذ حَطَّمتَها مِن مُعَلَّقِ",30,"ق",1,0],["حُطِّي رِحالَكِ بينَ خَمْسِ يمينِه","فلقد تقومُ مقامَ سبعةِ أبحرِ",31,"ر",1,0],["حَطَطتُ رِحالي في رَبيعِ رُبوعِهِ","وَلَولاهُ لَم أَثنِ الأَعِنَّةَ عَن مِصري",32,"ي",1,0],["حطمت من جبروتهن فقلن لي","أَزِفَ الفراق فقلتُ ويحك هاتي",33,"ي",1,0],["حطموا القيد الذي حطمكم","واجعلوا أمتكم فوق الأمم",34,"م",1,0],["حَطّتْ إليه حُداةُ العيسِ أرْحُلَنا","فَالعَزم صِفْرٌ بِمَثواهُ مِنَ السَّفَرِ",35,"ر",1,0],["حَطَمَ الشِركَ حَطمَةً ذَكَّرَتهُ","في دُجى اللَيلِ زَمزَماً وَالحَطيما",36,"م",2,0],["حُطَّت إِلى عُمدَةِ الإِسلامِ أَرحُلُهُ","وَالشَمسُ قَد نَفَضَت وَرساً عَلى الأُصُلِ",37,"ل",1,0],["حَطَطتُ إِلى أَرضِ الجُدَيدِيِّ أَرحُلي","بِمَهرِيَّةٍ تَنباعُ في السَيرِ أَو تَخدي",38,"د",2,0],["حَطَطتَ بِها يَومَ العَروبَةِ عِزَّهُ","وَكانَ مُقيماً بَينَ نَسرٍ وَفَرقَدِ",39,"د",1,0],["حَطَّ الرَبيعُ قِناعَها عَن مَفرِقٍ","شَمطٍ كَما تَرتَدُّ كاسُ الراحِ",40,"ح",1,0],["حَطَّ عنكِ الإصْرَ بَرَّاً ورثى","لك من ضُرٍّ شديدٍ مُرهقِ",41,"ق",1,0],["حِطَّينُ يومُك ليس ين","كر شاهديه الخافقانِ",42,"ن",1,0],["حَطُوطاً إِلى اللَذاتِ جَرَرتُ مِقوَدي","كَإِجرارِكَ الحَبلَ الجَوادَ المُجَلَّلا",43,"ل",2,0],["حَطَّت بِهِ مِن بِلادِ الطورِ عادِيَةٌ","حَصّاءُ لَم تَتَّرِك دونَ العَصا شَذَبا",44,"ب",2,0],["حَطَطنا إِلى خَمّارِها بَعدَ هَجعَةٍ","رِحالَ مَطايا لَم تَزَل يَومَها تَخدي",45,"د",2,0],["حَطَطنا عَلى خَمّارِها جُنحَ لَيلَةٍ","فَلاحَ لَنا فَجرٌ وَلَم يَطلُعِ الفَجرُ",46,"ر",1,0],["حَطَطنا بِها الأَثقالَ فَلَّ هَجيرَةٍ","عَبورِيَّةٍ تُذكى بِغَيرِ فَتيلِ",47,"ل",1,0],["حَطوطٌ إِلى قَودِ الجِيادِ عَلى الرَحا","وَفي السَنَةِ الحَمراءِ جَمُّ المَوارِدِ",48,"د",1,0],["حَطِّمِ العُودَ إِنْ كَرَّ اللَّيَالِي","لَمْ يُغَادِرْ فِي العُودِ إِلاَّ الأَنِينَا",49,"ن",2,0],["حَطَمْتِ الْقَيْدَ فِيهِ وَلَمْ تُرَاعِي","سِوَى قَيْدِ الْفَضِيلَةِ فِي الْمَسِيرِ",50,"ر",1,0],["حَطَطتَني يَومَ أَودَي","تَ مِن مُنيفٍ صَعَدته",51,"ت",2,0],["حَطَطتَ جِوارَ اللَهِ رَحلَك آمِناً","وَشقت المعزّى هَل إِلَيكِ رَحيلُ",52,"ل",1,0],["حطباً يرقص تاريخي","على جمر انتظارك",53,"ك",1,0],["حطَّم قيدَ الأسد السَّجينِ","مُحَطِّمُ الفولاذِ باليمين",54,"ن",1,1],["حطِّم كئوسَك، واشرب يا أبا حسنٍ","سلافةً عُصِرت من كَرم أشعاري",55,"ر",2,0],["«حِطَّينُ» تَشهدُ أننا عَربٌ؛ إذا","فَرِقَ الأسودُ من الردى، لَنْ نَفْرَقَا",56,"ق",2,0],["حَطَّتْ به من بلاد الطَّوْدِ عارية","ٌ حَصَّاءُ لم تَتَّرِكْ دون العَصَا شَذَبا",57,"ب",2,0],["حَطَّ في طَلْحَةَ أَو في مصعَبٍ","لاَ يُبَالي أَيَّ أُسْلبٍ سَلَكْ",58,"ك",1,0]]}