ابك منك كف","https://www.aldiwan.net/poem3352.html","عموديه"],[482,"حط الرحال بروض الأنس والأرب","https://www.aldiwan.net/poem24289.html","البسيط"],[514,"يلوح فتستدعي الفراش وتبسم","https://www.aldiwan.net/poem20798.html","الطويل"],[515,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[551,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[551,"كم للنواظر من دم مطلول","https://www.aldiwan.net/poem47277.html","الكامل"],[553,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[575,"ولما مررت بدار الحبيب","https://www.aldiwan.net/poem2852.html","المتقارب"],[575,"ليس لي منه سوى لا","https://www.aldiwan.net/poem3032.html","مجزوء الرمل"]],"verses":[["حَطَطنا فَحَيَّينا مَساعيهِ أَنَّها","عِظامُ المَساعي لا العِظامَ البَوالِيا",0,"ي",2,0],["حَطَّ رِجالٌ وَرَكِبنا الذُرى","وَعُقبَةُ السَيرِ لِمَن بَعدَنا",1,"ن",2,0],["حَطَّت إِلَيكَ مِنَ الضَم","ئِرِ في رِشاءٍ مِن نَدَم",2,"م",1,0],["حُطَّت بِأَطرافِ البِلادِ قُبورُهُم","رُقُمُ النُجومِ سُقوفُ لَيلٍ مُظلِمِ",3,"م",1,0],["حَطَّ بِرَأسي يَقَقاً أَبيَضاً","كَأَنَّما حَطَّ بِهِ مُنصُلا",4,"ل",2,0],["حَطَطتَهُ مِن ذُرى صَمّاءَ شاهِقَةٍ","مِنَ الزَمانِ عَلَيها غَيرُ مُحتَفِلِ",5,"ل",1,0],["حَطَمتُ صِعادَهُم حَتّى اِستَقاموا","مُجاوَزَةً بِهِم حَدَّ الثِقافِ",6,"ف",1,0],["حَطَطتُ المَكارِمَ عَن عاتِقي","وَجَرَّدَني الذُلُّ عَن مَحتِدي",7,"ي",1,1],["حَطَطتَ فيهِ الرِحالَ مُحتَزِماً","وَأَنتَ ثاني المُهَنَّدِ الفَرَدِ",8,"د",1,0],["حَطَطْتُ بَعْدَكَ يَاأَهْلِي وَيَاوَطَنِي","رَحْلَ الْغَرِيبِ فَلاَ أَهْلٌ وَلاَ وَطَنُ",9,"ن",1,0],["حطَطْتُ بآلِ اللهِ عُوجَ رَكائِبي","فلُقّيتُ بالتّرْحيبِ والسّهْلِ والبِرِّ",10,"ر",1,0],["حَطَّت لَهُ ريحٌ كَما","حُطَّت إِلى مَلِكٍ عِيابُه",11,"ب",2,0],["حَطَمتِ لَنا سَيفاً وَعَطَّلتِ مِنبَراً","وَأَذوَيتِ رَوضاً ناضِرَ الزَهَراتِ",12,"ت",1,0],["حَطَمتُ اليَراعَ فَلا تَعجَبي","وَعِفتُ البَيانَ فَلا تَعتَبي",13,"ي",1,1],["حَطَطتُم بِحَيثُ اسلَنطَحَت ساحَةُ العُلا","وَأَوفَت لِإِخطارِ السَناءِ هِضابُ",14,"ب",1,0],["حُطتَ البلاد ومن حوته ثغورها","وكفى بسعدك حامياً لذمارِ",15,"ر",1,0],["حَطُوطَاً في مَسَرَّتِهِ وَمَولَىً","الى مَرضَاةِ خَالِقِهِ سَرِيعَا",16,"ع",2,0],["حطَّم الوجد ركن دمعي وطافت","لوعتي بين زمزمٍ والحطيم",17,"م",1,0],["حططتُ إلى النُّهى رحلي وكلَّتْ","مطيّةُ باطلي بعد الهِبابِ",18,"ب",1,0],["حططنَ بواسطٍ من بعد سبعٍ","وقد مال الشروقُ إلى الغروبِ",19,"ب",1,0],["حطَّ ثِقلَ الخراجِ عنِّي وقد كا","ن كأركانِ يَذْبُلٍ وشمام",20,"م",1,0],["حَطَّمَ السَيف وَما أَبقى الدُروع","وَتَداعى دونَهُ السورُ المَنيع",21,"ع",1,0],["حَطَّمَتْ كَفُّ الأَسَى قِيثارَتي","فِي يَدِ الأَحْلامْ",22,"م",1,0],["حطوا على الأرض السرير وغيبوا","قمر السماء ووسدوا جوزاءها",23,"ا",3,0],["حَطَّهُم بِالإِمامِ لِلمَوتِ رَكبٌ","يَتَلاقى بِطاؤُهُ وَسِراعُه",24,"ع",2,0],["حَطّى غَدَت جُشَمُ بنِ بَكرٍ تَبتَغي","إِرثَ النَبِيِّ وَتَدَّعيهِ حُقوقا",25,"ق",2,0],["حَطَّ في طَلحَتَ أَو في","مُصعَبٍ لا يُبالي أَيَّ أُسلُبٍ سَلَك",26,"ك",1,0],["حَطَّت عَلى تِلكَ الأَجارِعِ وَالرُبى","مِنهُنَّ أَعباءُ الغَمامِ المُثقَلِ",27,"ل",1,0],["حُطَّت سُروجُ أَبي سَعيدٍ وَاِغتَدَت","أَسيافُهُ دونَ العَدُوِّ تُشامُ",28,"م",1,0],["حَطَّمتَ مَنكِبَهُم لَمّا حَلَلتَ بِهِم","بِمَنكِبٍ مِنكَ أَضحى غَيرَ مُنحَطِمِ",29,"م",1,0],["حَطَمتَ قُيودي حَطمَةً لَم تَدَع لَها","بِساقَيَّ إِذ حَطَّمتَها مِن مُعَلَّقِ",30,"ق",1,0],["حُطِّي رِحالَكِ بينَ خَمْسِ يمينِه","فلقد تقومُ مقامَ سبعةِ أبحرِ",31,"ر",1,0],["حَطَطتُ رِحالي في رَبيعِ رُبوعِهِ","وَلَولاهُ لَم أَثنِ الأَعِنَّةَ عَن مِصري",32,"ي",1,0],["حطمت من جبروتهن فقلن لي","أَزِفَ الفراق فقلتُ ويحك هاتي",33,"ي",1,0],["حطموا القيد الذي حطمكم","واجعلوا أمتكم فوق الأمم",34,"م",1,0],["حَطّتْ إليه حُداةُ العيسِ أرْحُلَنا","فَالعَزم صِفْرٌ بِمَثواهُ مِنَ السَّفَرِ",35,"ر",1,0],["حَطَمَ الشِركَ حَطمَةً ذَكَّرَتهُ","في دُجى اللَيلِ زَمزَماً وَالحَطيما",36,"م",2,0],["حُطَّت إِلى عُمدَةِ الإِسلامِ أَرحُلُهُ","وَالشَمسُ قَد نَفَضَت وَرساً عَلى الأُصُلِ",37,"ل",1,0],["حَطَطتُ إِلى أَرضِ الجُدَيدِيِّ أَرحُلي","بِمَهرِيَّةٍ تَنباعُ في السَيرِ أَو تَخدي",38,"د",2,0],["حَطَطتَ بِها يَومَ العَروبَةِ عِزَّهُ","وَكانَ مُقيماً بَينَ نَسرٍ وَفَرقَدِ",39,"د",1,0],["حَطَّ الرَبيعُ قِناعَها عَن مَفرِقٍ","شَمطٍ كَما تَرتَدُّ كاسُ الراحِ",40,"ح",1,0],["حَطَّ عنكِ الإصْرَ بَرَّاً ورثى","لك من ضُرٍّ شديدٍ مُرهقِ",41,"ق",1,0],["حِطَّينُ يومُك ليس ين","كر شاهديه الخافقانِ",42,"ن",1,0],["حَطُوطاً إِلى اللَذاتِ جَرَرتُ مِقوَدي","كَإِجرارِكَ الحَبلَ الجَوادَ المُجَلَّلا",43,"ل",2,0],["حَطَّت بِهِ مِن بِلادِ الطورِ عادِيَةٌ","حَصّاءُ لَم تَتَّرِك دونَ العَصا شَذَبا",44,"ب",2,0],["حَطَطنا إِلى خَمّارِها بَعدَ هَجعَةٍ","رِحالَ مَطايا لَم تَزَل يَومَها تَخدي",45,"د",2,0],["حَطَطنا عَلى خَمّارِها جُنحَ لَيلَةٍ","فَلاحَ لَنا فَجرٌ وَلَم يَطلُعِ الفَجرُ",46,"ر",1,0],["حَطَطنا بِها الأَثقالَ فَلَّ هَجيرَةٍ","عَبورِيَّةٍ تُذكى بِغَيرِ فَتيلِ",47,"ل",1,0],["حَطوطٌ إِلى قَودِ الجِيادِ عَلى الرَحا","وَفي السَنَةِ الحَمراءِ جَمُّ المَوارِدِ",48,"د",1,0],["حَطِّمِ العُودَ إِنْ كَرَّ اللَّيَالِي","لَمْ يُغَادِرْ فِي العُودِ إِلاَّ الأَنِينَا",49,"ن",2,0],["حَطَمْتِ الْقَيْدَ فِيهِ وَلَمْ تُرَاعِي","سِوَى قَيْدِ الْفَضِيلَةِ فِي الْمَسِيرِ",50,"ر",1,0],["حَطَطتَني يَومَ أَودَي","تَ مِن مُنيفٍ صَعَدته",51,"ت",2,0],["حَطَطتَ جِوارَ اللَهِ رَحلَك آمِناً","وَشقت المعزّى هَل إِلَيكِ رَحيلُ",52,"ل",1,0],["حطباً يرقص تاريخي","على جمر انتظارك",53,"ك",1,0],["حطَّم قيدَ الأسد السَّجينِ","مُحَطِّمُ الفولاذِ باليمين",54,"ن",1,1],["حطِّم كئوسَك، واشرب يا أبا حسنٍ","سلافةً عُصِرت من كَرم أشعاري",55,"ر",2,0],["«حِطَّينُ» تَشهدُ أننا عَربٌ؛ إذا","فَرِقَ الأسودُ من الردى، لَنْ نَفْرَقَا",56,"ق",2,0],["حَطَّتْ به من بلاد الطَّوْدِ عارية","ٌ حَصَّاءُ لم تَتَّرِكْ دون العَصَا شَذَبا",57,"ب",2,0],["حطّمنا الكؤوس ولم نرتوي","وعدت أمدّ إليها اليدا",58,"د",2,0],["حَطَّ في طَلْحَةَ أَو في مصعَبٍ","لاَ يُبَالي أَيَّ أُسْلبٍ سَلَكْ",59,"ك",1,0],["حطّموا المرهفات وهي رقاق","ثمّ شاؤوا فحطّموا الأقلاما",60,"م",2,0],["حطمت كأسي واعتصمت بتوبة","قد ألهبت صفعاً قفا شيطانه",61,"ن",2,0],["حُطتَ الرَعيةَ بِالرِعايَةِ رَأفَةً","فاضَت عَلى القُرَباءِ وَالبُعَداءِ",62,"ا",2,0],["حُطّا رِحالَ المُزنِ فَوقَ مَعالِمٍ","جَعَلَ الهَوى مَجهولَها مَعلوما",63,"م",2,0],["حُطُّوا الرِحالَ فَقَد أَودى بِها الرَحلُ","ما كُلِّفَت سَيرَها خَيلٌ وَلا إِبلُ",64,"ل",1,1],["حُطنا نِزاراً وَذُدنا عَن مَحارِمِها","وَلَم نَدَع لِمُناوي عزِّها حَرَما",65,"م",2,0],["حُطى النِّقابَ لعلّ سَرْحَ لِحاظِنا","في روضٍ وجهِك يَرتْعَينَ قليلا",66,"ل",2,0],["حطاما يا بني شيبان فابكوا","كما يبكي لدرّته الفطيم",67,"م",1,0],["حطّموا العود والكؤوس فلا","حاجة بالعود أو كؤوس المدام",68,"م",1,0],["حطمت جسمه صروف الليالي","ورمته بالبؤس دنيا الطغام",68,"م",1,0],["حطموا بها استبداد جبار الورى","والارض لاستبدادهِ تتجلدُ",69,"د",1,0],["حُطي نقابكِ لحظةً","فالحسنُ أجمعُ في نقابِكْ",70,"ك",1,1],["حططنا الحمل منه في دبي","بلاد المسلمين الأكرمينا",71,"ن",2,0],["حُطَّ وِقْرَالرَّجاءِ حَوْلَ حِمَاه ُ","فَعَسى يَأْتِيَنْكَ مِنْهُ الشِّفاءُ",72,"ا",2,0],["حُطْهُ وَحُصْهُ بِالتُّقَى يَا سَيِّدِي","مَنْ لِي سِوَاكَ يَحُوطُهُ وَيَحُوصُهُ",73,"ص",2,0],["حَطَّتْ بِفَاسٍ رَحْلَهَا عِنْدَ امْرِئٍ","أَقْرَا لَهَا التَّمْجِيدَ وَالتَّقْدِيسَا",74,"س",2,0],["حطّينُ ليست يا غدارِ بَعيدةً","أو ليسَ في التّذكارِ ما يُنهيك",75,"ك",1,0],["حطت بسوح رَسول اللَه واطرحت","أَثقالها وَلديه طاب مَثواها",76,"ا",3,0],["حَطُّوا رِحالَ الْعِيسِ مِنْهُ بِخَيْرِ مَنْ","هَزُّوا إِلَيْهِ رِقابَها وَالأَسْؤُقا",77,"ق",2,0],["حَطَطْنا رِحالَ الْعِيسِ فِي ظِلِّ جُودِهِ","إِلى خَيْرِ مَنْ تُحْدى إِلَيْهِ وَتُحْدَجُ",78,"ج",1,0],["حَطَّ عَلى أَعدائِكَ اللَهُ ما","حَطَّ عَلى العِدا بِحِطّينا",79,"ن",2,0],["حطَّمتُ أَغلالَ يدي","برأْسِ كلِّ معتدِ",80,"د",1,1],["حَطَّت وَلَو عَلِمَت عِلمي لَما عَزَفَت","حَتّى تَلَينَ واهٍ كَرُّها بَسَرُ",81,"ر",1,0],["حَطَطناهُمُ مِنها وَقَد كادَ عَرشُهُم","يَميلُ بهِم فِعلَ الجَبانِ المُخالِفِ",82,"ف",1,0],["حَطَّت عَلَيهِ بِمِقدارٍ مَنِيَّتُهُ","كَذاكَ تَصنَعُ بِالناسِ المَقاديرُ",83,"ر",1,0],["حطّموا مزهري وذرّوا بقايا","ه وصلّوا في مأتم الذكريات",84,"ت",1,0],["حطَبْتُ ضلوعي ثُمّ أقبلتُ قابساً","من البَرْقِ لَمّا بات يَقْدحُ زنْده",85,"د",2,0],["حَطَبْتُ ضلُوعي ثمَّ أقبسْتُها الهوى","فإن راحَ عَذْلٌ نارَها تَتأجّج",86,"ج",1,0],["حطَطْت لثاماً عن مَجودٍ مُوَرَّسٍ","وألقَتْ نقاباً عن أسيلٍ مُضَرَّج",86,"ج",1,0],["حُطّي النِقابَ لَعَلَّ سرحَ لحاظِنا","في رَوضِ وجهك يرتعنَّ قَليلا",87,"ل",2,0],["حَطَمتْ قوَايَ وأوهَنتُ من نَهضتي","وكَذا بمَنْ طلبَ السّلامَةَ تَفعلُ",88,"ل",1,0],["حَطُّوا فقاموا تحتَ طاعَتِه","لما رأَوْهُ قامَ بالتِّقْلِ",89,"ل",1,0],["حطت فيه حمى الشريعة لمّا","كاد أن تسرع الحتوف زياله",90,"ل",2,0],["حطت الحمى ورددت الفي مجتمعا","من بعدما كان فينا غير مردود",91,"د",1,0],["حططتُ عليك أوساقي وظهري","بهنّ موقَّعٌ عُرّاً وعِيَّا",92,"ي",2,0],["حطّوا فكلُّ حوِيّة نَمطٌ","ولكلّ خدٍّ ساعدٌ يُثنَى",93,"ن",2,0],["حطت بها خلائفاً","بهم تحاط الأممُ",94,"م",1,0],["حَطَّ وقد أعتمتْ مذاهبُهُ","ينظر رُشْداً أقمرتَ فارتحلِ",95,"ل",1,0],["حَطَّهُمُ وارتفعتَ عنهم","أنّك خاطرتَ في الكمال",96,"ل",1,0],["حطت البلاد وما سللت لحفظها","سيفاً ورعت وماهززت مثقفا",97,"ف",2,0],["حططتُ لثامهُ فإذا شبابٌ","من الآداب يصحبهُ يسار",98,"ر",1,0],["حط الرحال بروض الأنس والأرب","تشفي الفؤاد من التسهيد واللهب",99,"ب",1,1],["حطَمْنَ عَواليهِ قَنا كُلِّ فتنةٍ","فكِدْنَ لِقاماتِ الدُمى البِيضِ تُحطَمُ",100,"م",1,0],["حط على المبارك بن كامل","تمام ما ينقص من كماله",101,"ل",2,0],["حُطّوا بعَقْوَةِ ركنِ الدّين واِبتَهِجوا","بالمَنهلِ العَذْبِ أو في المنبَتِ الخَضِلِ",102,"ل",1,0],["حُطّوا إلى ملكِ الملوكِ رحالَكْم","فَفِناؤه للرّكبِ خيرُ مَقيلِ",103,"ل",1,0],["حَطَّ الرِكابَ إِلى جَنابِ مُحَمَّدٍ","مِن جُنحِ لَيلٍ كَالغَمامَةِ أَربَدِ",104,"د",1,0],["حَطَتُ همومَ جُفُونِي بها","لأَنَّ الدموعَ همُومُ الجُفُون",105,"ن",1,0],["حطَّني الشَّيْبُ ولكن","بِعليٍّ أَتَعالَى",106,"ل",2,0]]}