{"poems":[[90,"رقت بوصف جمالك الأقوال","https://www.aldiwan.net/poem44405.html","الكامل"],[45,"كفرندي فرند سيفي الجراز","https://www.aldiwan.net/poem9609.html","الخفيف"],[63,"بين الشنوف الحمر والأقراط","https://www.aldiwan.net/poem51578.html","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140903",""],[92,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130883","الخفيف"]],"verses":[["ولقطّعت دون الأكفّ قلوبها","شوقاً إليك مع النساء رجال",0,"ل",1,0],["وَلِقَطعي بِكَ الحَديدَ عَلَيها","فَكِلانا لِجِنسِهِ اليَومَ غازي",1,"ز",2,0],["ولقطت يانعة الثمار فلم أجد","كثمار دوحتها أوان لقاط",2,"ط",1,0],["ولقطعي بك الحديد عليها","فكلانا لجنسه اليوم غاز",3,"ز",1,0],["ولقَّطتُ مِن زَبدٍ طافحٍ","بثَغرك شهداً هو العَلْقَم",4,"م",1,0],["ولقطر الشام زفت عروسا","فجعلنا صداقها الأمصارا",5,"ر",2,0]]}