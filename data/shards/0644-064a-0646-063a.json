[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105624","الوافر"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97965","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100187","الطويل"],[3433,"","https://poetry.dctabudhabi.ae/diwan/poem/145084","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89004","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48354","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48437","الطويل"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26974","الطويل"],[3884,"","https://poetry.dctabudhabi.ae/diwan/poem/142886","الطويل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103577","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44683","البسيط"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107296","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83671","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120385","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139553",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139549",""],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101938","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204285","الطويل"],[2177,"شجاني منهم ربع خلاء","https://www.poetsgate.com/ViewPoem.aspx?id=127080",""],[5455,"نديم الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=34411",""],[709,"مضى خلفُ الأبرارِ والسيدُ الطهرُ","https://www.poetsgate.com/ViewPoem.aspx?id=2960",""],[243,"شهداء الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=50492",""],[6100,"مات النمل ياواد النمل","https://www.poetsgate.com/ViewPoem.aspx?id=52591",""],[6152,"لا شيء بعدكِ","https://www.poetsgate.com/ViewPoem.aspx?id=203011",""],[6152,"ذكرك لي حياة","https://www.poetsgate.com/ViewPoem.aspx?id=206727",""],[6152,"ذكراكِ لا تهون","https://www.poetsgate.com/ViewPoem.aspx?id=215644",""]],"verses":[["لَئِنْ غِبْتِ عَنْ عَيْنِي فَشَخْصُكِ حَاضِرٌ","يُلاَزِمُ فِكْرِي شَكْلُهُ وَمِثَالُهُ",0,"ل",2,0],["لَئِنْ غَرّ بَدْرَ الأفْقِ فَضْلُ انفِرادِهِ","فبَيْنَ القُصورِ البيضِ ثانٍ وثالِثُ",1,"ث",1,0],["لَئِن غابَ هَذا اللَيثُ عَنكَ لِعِلَّةٍ","لَقَد لَبِثَت آثارُهُ فيكَ شُهَّدا",2,"د",2,0],["لَئِن غَدا الدَهرُ بِنا مُدبِراً","لا بُدَّ لِلمُدبِرِ أَن يُقبِلا",3,"ل",2,0],["لَئِنْ غَرَبَ البدرُ المنيرُ محمّدٌ","لقد طلعَ البدرُ المكمّلُ يوسُفُ",4,"ف",1,0],["لئن غَيبت عنا مرائية في الثرى","فما غُيّبت عنا معاليه في اللحد",5,"د",1,0],["لَئِن غَرَّني مَطلُ البَخيلِ لَقَبلَهُ","غُرِرتُ بِإِسعافِ الخَيالِ الَّذي يَسري",6,"ر",2,0],["لَئِن غَدَرَت في الرَوعِ أَيّامُهُ بِهِ","لَما زالَتِ الأَيّامُ شيمَتُها الغَدرُ",7,"ر",1,0],["لَئِن غَرَّبتَها في الأَرضِ بِكراً","لَقَد جُلِيَت عَلى سَمعٍ كَفِيِّ",8,"ي",1,0],["لَئِن غَدا شاحِباً تَخدي القِلاصُ بِهِ","لَقَد تَخَلَّفتُ عَنهُ شاحِبَ الأَمَلِ",9,"ل",1,0],["لَئِن غُلِبنا عَدَدا","لَقَد غَلَبنا عُدَدا",10,"د",2,0],["لَئِن غَدَوتُ إِلى الإِحسانِ أَصرُفُها","فَإِنَّ ذَلِكَ أَجرى مِن مَعاليها",11,"ي",3,0],["لَئِن غِبتِ عَن عَينَيَّ يا اِبنَةَ مالِكٍ","فَشَخصُكِ عِندي ظاهِرٌ لِعِياني",12,"ن",2,0],["لئنْ غطى على كَبدي اديمٌ","فكم من جمرةٍ كُسِيَتْ رَمادا",13,"د",2,0],["لَئِن غَضِبتَ لِسَومِ الخَسفِ حينَ رَضوا","لَقَد رَضيتَ بِحُكمِ الجودِ إِذ غَضِبوا",14,"ب",3,0],["لئن غاب هذا لليث عنه فهذه","ضراغمة قد ضوعفت في سطا الشبل",15,"ل",1,0],["لَئن غَرِقتْ بِفَضلِكَ أَرضُ مَصرٍ","لَقَد لَحِقَ الشآمَ نداكَ هَمْعا",16,"ع",2,0],["لئن غُلِبَ الليثُ الهصورُ وشِبْلُهُ","فما لهما يوماً سوى اللهِ غالب",17,"ب",1,0],["لئن غاب عن انسان عيني خيالكم","فشخصكم بالعين ما غاب عن قلبي",18,"ب",2,0],["لَئِن غَبَرَت حيناً مِنَ الدَهرِ حائِلاً","لَقَد طَرَّقَت بَعدَ الحِيالِ بِرِئبالِ",19,"ل",1,0],["لَئِن غادَرَت قَصرَ الخِلافَةِ موحِشاً","فَكائِن لَها في جَنَّةِ الخُلدِ مِن قَصرِ",20,"ر",1,0],["لَئِنْ غَرُبَتْ شَمْسٌ تَبَدَّتْ مِنَ الشَّرْقِ","فَفِي الْغَرْبِ شَمْسٌ لاَ تَغِيبُ مِنَ الشَّرْقِي",21,"ق",2,1],["لَئِنْ غَرُبَتْ شَمْسُ العُلى فَهِلالُنَا","يُنيرُ لَنَا اللَّيْلَ البَهِيمَ إِذَا جَنَّا",22,"ن",2,0],["لئن غصَّ من عين الرَقيب محبُّها","فمشربُه من مَنهلِ الحبِّ سائغُ",23,"غ",1,0],["لئن غِبتَ عَن عَيني فشخصُك حاضِرٌ","بِباليَ لم أَبرَح أَراك وأَسمَعُ",24,"ع",1,0],["لئن غز زمتْ نظمَ الروائعِ صبيةٌ","فما البازل الهدّار كابن لبونها",25,"ن",3,0],["لئنْ غُلبوا عَلَى حقٍ مبينٍ","فليس لمن تغلّب أن يطولا",26,"ل",2,0],["لَئِن غَرَّت منابِرُها","فَقَد وَعَظَت مَقابِرُها",27,"ر",3,0],["لئن غَرّبَتْ شمسِي المنيرةُ في النّوى","فَلَيْلِي وصُبحِي في الظّلامِ سَواءُ",28,"ا",2,1],["لئنْ غِبتُم عن ناظري وحُجبتم","فما غابَ منكم عن فؤادي تمثال",29,"ل",1,0],["لئنْ غيَّبوهُ في التُّراب وأَظلَمَتْ","معالم كانت تفضح الصبح مسفرا",30,"ر",2,0],["لئنْ غابَ عن أبصارنا بوفاتِه","فما زالَ في الأَفكار منَّا مفوَّرا",30,"ر",2,0],["لئن غاب عن عيني أمين فضائلٍ","ففي نجله سرٌّ يسرّ ويحمدُ",31,"د",1,1],["لئن غاله ريب المنون فنشره","مدى الدهر من معروفه يتضوّع",32,"ع",1,0],["لئِنْ غَلَبتْ مناقِبُكمْ لِساني","فإنَّ العُذْرَ من بعضِ السِّدادِ",33,"د",1,0],["لَئِنْ غَوَّرَتْ فِي شَغافِ الشّمالِ","لقد أَنْجَدَ الفَتْحُ مِنْها وغَارا",34,"ر",2,0],["لئن غرق الشهيد فنحن غرقى","أشُّد ولا رجاءُ ولا نجاء",35,"ا",2,0],["لئن غِبتُ عن نادي عُلاكَ فانني","بقلبي ومدحي حاضرُ النفس ماثلُ",36,"ل",1,1],["لئن غاب عنا يوسفُ الملك والعلى","لقد حلّ فينا يوسفُ الجود والفضل",37,"ل",1,0],["لَئِن غَرَّني مِمّا تَسَربَلتَ رَنَقُ","وَجِئتُكَ مَلهوفاً فَضَجَّعتَ في أَمري",38,"ر",2,1],["لئنْ غابَ تلكَ العينُ ذا أَثرٌ لها","وإنْ شطَّ ذاكَ الحيُّ هذا ظِلالُهُ",39,"ل",2,0],["لَئِنْ غدرَتْ فيه اللّيالي فإنّها","بكُلِّ وفيِّ العهدِ شيمَتُها الغَدْرُ",40,"ر",1,0],["لئن غبت عن عيني فإنك حاضر","بقلبي كنقش في أصم صفاة",41,"ه",1,0],["لئِن غبتِ عن عيني فربّ مُغيَّبٍ","يروحُ وأبصارُ القلوبِ روامقُهْ",42,"ق",2,0],["لئن غابَ عنّا كوكب من بني العلى","فمِن بعده بالأفق قد لاح كوكبُ",43,"ب",1,0],["لَئِن غبت عن عيني فشخصُكَ لم يزل","يمثّله في كلّ آونة قلبي",44,"ب",2,0],["لَئِن غابَ مظهر من بيننا","فزيدان مِن بعدهِ قد ظهَر",45,"ر",1,0],["لَئِن غاب عنّا كوكب من بني العُلا","فَمن بعده بالأفق قد لاحَ كوكبُ",46,"ب",1,0],["لئن غادرتك الأرض حملاً ببطنها","فإنا حملنا