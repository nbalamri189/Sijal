{"poems":[[88,"منى نلتها يا لابس المجد معلما","https://www.aldiwan.net/poem68939.html","الطويل"],[53,"بكاؤكما يشفي وإن كان لا يجدي","https://www.aldiwan.net/poem10863.html","الطويل"],[53,"حليف سهاد ليله كنهاره","https://www.aldiwan.net/poem64079.html","الطويل"],[45,"عواذل ذات الخال في حواسد","https://www.aldiwan.net/poem9528.html","الطويل"],[107,"خزاعة أبشري بالعهد سمحا","https://www.aldiwan.net/poem44065.html","الوافر"],[8,"كأن رعالهن بواردات","https://www.aldiwan.net/poem21837.html","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[242,"أعدت نبالا للحشا وهي ألحاظ","https://www.aldiwan.net/poem18845.html","الطويل"],[303,"تلاقوا بعد ما افترقوا طويلا","https://www.aldiwan.net/poem36818.html","عموديه"],[308,"ألح عذولي في هواه وزاد في","https://www.aldiwan.net/poem58132.html","الطويل"],[558,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110426","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49602","الوافر"],[1785,"","https://poetry.dctabudhabi.ae/diwan/poem/198829","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115426","الطويل"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76551","الطويل"],[3259,"","https://poetry.dctabudhabi.ae/diwan/poem/147547","المتقارب"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121356","الطويل"],[3912,"","https://poetry.dctabudhabi.ae/diwan/poem/131355","الطويل"],[4723,"تزوَّدْ من الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=61934",""],[585,"سل الأرض كم خاضت قديم المآزق","https://www.poetsgate.com/ViewPoem.aspx?id=161964",""],[5126,"أعَاذلتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87835&r=&rc=49",""]],"verses":[["أَلَحَّ عَلى أَوعارِهِم وَسُهولِهِم","وَحَيّا عَبوسَ القَفرِ حَتّى تَبَسَّما",0,"م",2,0],["ألَحَّ عليه النَّزْفُ حتَّى أحالَهُ","إلى صُفْرَة الجاديِّ عن حُمْرَةِ الوَرْدِ",1,"د",1,0],["ألحَّ علينا مولَعاً بسَراتنا","كما أولع الجاني بخير ثِماره",2,"ر",2,0],["أَلَحَّ عَلَيَّ السُقمُ حَتّى أَلِفتُهُ","وَمَلَّ طَبيبي جانِبي وَالعَوائِدُ",3,"د",1,0],["ألحَّ على بني بكرٍ شَقَاءٌ","تَزِلُّ له العُقُولُ إذا ألَحَّا",4,"ح",2,0],["أَلحَّ عَلى الصِيحَةِ فَاِنتَحاها","بِسِكِّينٍ لَهُ ذَكَرٍ هُذامِ",5,"م",1,0],["أَلَحَّ عَلَيهِ ما أَلاحَ بِنورِهِ","وَأَعيا حَكيماً أَن يُجيب بِأَحرُفِ",6,"ف",1,0],["أُلِحُّ عَلَيْهَا مَا حَيِيتُ بِذِكْرِهَا","وَإِنِّي عَلَى عَيْنِ الْحَيَاةِ لَمِلْظَاظُ",7,"ظ",1,0],["ألحّ عليَّ حبُّ الشامِ حتى","رجعتُ إلى الحمى نضواً هزيلا",8,"ل",2,0],["ألح عذولي في هواه وزاد في","ملامي فقلت احتل على غير مسمعي",9,"ي",1,1],["أَلَحَّ عَلى الأَيّامِ يَفري خُطوبَها","عَلى مَنهَجٍ أَلفى أَباهُ بِهِ قَبلُ",10,"ل",1,0],["الحَّ عليَّ الحزن من كل جانبٍ","فشنَّ على صبرا الحشا غارةً شَعوا",11,"و",2,0],["ألحَّ على الرَّدى فيها غريمٌ","قليلاً ما تُعَنّيه الديون",12,"ن",1,0],["ألحَّ عليَّ السُّقمُ حتَّى كأنَّما","حُشاشةُ جسمي رقةً بعدكم ذِهني",13,"ي",1,1],["ألحّ عليه السقمُ حتى أذابهُ","وقد ملّهُ عوّادهُ وطبيبه",14,"ب",2,0],["أَلَحَّ عَذُولي بِالمَلامِ وَلَو رَأى","حَبِيبيَ لاستَحيى مِن العَذلِ وَارعَوى",15,"و",2,0],["ألح عليك بروعاته","وأقبل يرميك مستهدفا",16,"ف",2,0],["ألحُّ على مولىً كريمٍ كأنما","يباكَرُ مني بالغريمِ اليلندد",17,"د",1,0],["ألح عليها المزن فابتزّ ثوبها","فألقى عليها النور ملحفةً حبرا",18,"ر",2,0],["ألحَّ عليَّ الداءُ أسْقمَ مرقدي","كأنّيَ قد حُمِّلْتُ روحي على يدي",19,"د",2,1],["ألح عليها الخفض والرفع فالذرى","تخر ويطغى السهل فوق الشواهق",20,"ق",1,0],["ألَحَّ علينا في هدوءٍ.. على السُرى","وقد كان قد جلَّى الضلالَ عن الهدى",21,"د",2,0]]}