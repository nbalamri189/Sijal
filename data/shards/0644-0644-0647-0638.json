{"poems":[[65,"من لي بنجد وأيام بها سلفت","https://www.aldiwan.net/poem45540.html","البسيط"],[74,"لله ظبي كنيسة لاحظته","https://www.aldiwan.net/poem19033.html","الكامل"],[139,"تكاملت المسرة لي وأبدت","https://www.aldiwan.net/poem49015.html","الوافر"],[369,"يا معرضا قد آن أن تتلفتا","https://www.aldiwan.net/poem60975.html","الكامل"],[438,"لم يلف للهون عاشق جاحد","https://www.aldiwan.net/poem12471.html","المنسرح"],[438,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62508","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119926","السريع"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107313","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77283","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74188","المنسرح"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65299","المجتث"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65349","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65221","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86301","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86342","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86338","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85116","المجتث"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75721","المنسرح"],[6318,"الهند .. تقاوم الاحتلال البريطاني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65940&r=&rc=0",""]],"verses":[["لِلَّهِ ظَمياءُ وَالأَيّامُ مُسعِدَةٌ","بِالوَصلِ مِنها بِلا مَنْعٍ وَلا حَرَجِ",0,"ج",1,0],["لله ظبي كنيسةٍ لاحظته","فكأنما لاحظت ظبي كناسي",1,"س",2,1],["لله ظبي مهفهفْ","مثل الغزال وألطفْ",2,"ف",1,0],["للهِ ظَبْيٌ كلّما عَرَضوا له","صَرَعَ الرُّماةَ بمقلتَيْهِ وأفلَتا",3,"ت",2,0],["لله ظبيٌ أغرُّ مختصَرُ ال","خصْر غريرٌ عني غدا شارِدْ",4,"د",1,0],["لله ظبيٌ من ظباءِ يثبرب","جفا الجفونَ مُذ جفا طيفُ الكرى",5,"ا",1,0],["لله ظبي أتاني ليلة الأحدِ","وليس عندي غيرُ الله من أحدِ",6,"د",1,1],["لله ظلم تحت ذاك اللمى","لوم عذولي فيبه ظلم صراح",7,"ح",1,0],["لِلَّهِ ظَبيٌ رَمي قلبي بأسهُمِهِ","ومنهُ سَهمٌ لقلبي كانَ يكفِيهِ",8,"ي",2,0],["لِلَهِ ظَبيُ المُنحَنى مِن أَغيدِ","يَسبي النُهى بِمُوَرَّدٍ وَمُنَضَّدِ",9,"د",1,1],["للّه ظَبي بِذات سلع","يَميد كَالغُصن في صَعيد",10,"د",1,0],["للّه ظبي بقلبي","من حاجبيه نبالُ",11,"ل",1,1],["لله ظبي سبا عقلي بلامين","من عارضيه وجرّاني إلى حيني",12,"ن",2,1],["لله ظبي عن جُفوني شارد","أتُرى أفُوزُ بوصل ذلك الشّارد",13,"د",1,0],["لِلَّهِ ظَبيٌ اِذا ما ثَغره اِبتَسَما","غَيظاً نَرى البَدر مِنهُ اِنشق وَاِنقَسَما",14,"م",2,0],["لِلَّهِ ظَبيٌ من سَلافةٍ ريقِه","إِن قامَ يُعطي الكَأسَ يَوماً اِم مَلا",15,"ل",2,0],["لِلَّهِ ظَبيٌ إِذا ما اِفتَرَّ مُبتَسِماً","أَبدَت اِلَينا ثَنايا ثَغرِهِ بَرَدا",16,"ا",1,0],["للَه ظبي كحيل","عنه التسلي محاله",17,"ل",2,0],["لِلَّه ظبي هَواه يظني","وصاله في الهَوى تجني",18,"ن",2,1],["لله ظاهِرةُ تُقاتِلُ مَنْ طَغَى","في الأرضِ أَو تُعْلي لِواءَ مُحَمَّدِ",19,"د",1,0]]}