,"https://www.aldiwan.net/poem68420.html","الكامل"],[566,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[572,"شطت لليلى باللوى","https://www.aldiwan.net/poem69615.html","مجزوء الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138402",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138364",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63760","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56582","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144155","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46537","الرجز"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49566","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28587","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137068",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100361","الرجز"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109813","الكامل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103942","السريع"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59493","الكامل"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32629","الكامل"],[3892,"","https://poetry.dctabudhabi.ae/diwan/poem/97708","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125810","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90852","الكامل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52182","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52154","المقتضب"],[402,"جبر القلوب مقيلك الجبار","https://www.poetsgate.com/ViewPoem.aspx?id=35741",""],[5897,"إلى ذات الحرير الأخضر","https://www.poetsgate.com/ViewPoem.aspx?id=160572",""],[5956,"ما إن يرفُّ على رؤاكِ البالُ","https://www.poetsgate.com/ViewPoem.aspx?id=192386",""],[5994,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=184664",""],[5064,"نرجِسَةُ المعَانِي الزُّجاجِيَّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87539&r=&rc=34",""]],"verses":[["كَالكَوكَبِ اِنتَشَرَت مِنهُ ذَوائِبُهُ","وَموقِدُ النارِ يُذكيها عَلى أَضَمِ",0,"م",1,0],["كَالكَلبِ لا يَسأَمُ الكَلبُ الهَريرَ وَلَو","لاقَيتَ بِالكَلبِ لَيثاً مُخدِراً ذَرَقا",1,"ق",2,0],["كالكلب يَعْذِمُ أعلى الرَّوْقِ مُنقبِضاً","في حالك اللون صَدْقٍ غير ذي أَوَدِ",2,"د",1,0],["كَالكَلبِ يَنبِحُ مَرَّةً عَن أَهلِهِ","وَيَهِرُّ وَهوَ عَلى الهَوانِ ذَلولُ",3,"ل",1,0],["كَالكاسِ باشَرَها المِزاجُ فَأَبرَزَت","زَبَداً يَدورُ عَلى شَرابٍ أَسوَدِ",4,"د",1,0],["كَالكَوكَبِ الدُرِيِّ أَخلَصَ ضَوءَهُ","حَلَكُ الدُجى حَتّى تَأَلَّقَ وَانجَلى",5,"ل",2,0],["كَالكاعِبِ الرودِ يَخفى في تَرائِبِها","رَدعُ العَبيرِ وَيَبدو في تَراقيها",6,"ي",3,0],["كَالْكَهْرَبَاءَةِ دَرْكُهَا مُتَعَذِّرٌ","وَنَسِيمُهَا مَتَحَدِّرٌ سَيَّالُ",7,"ل",1,0],["كَالكَوكَبِ الدُرِيِّ في اِنخِراطِهِ","عِندَ تَهاوي الشَدِّ وَاِنبِساطِهِ",8,"ط",2,0],["كَآلِ كِسرى وَكَآلِ بُردِ","أَنكَبَ جافٍ عَن طَريقِ الرُشدِ",9,"د",1,0],["كَالكَوكَبِ الدِرّيءِ يَشرَقُ مَتنُهُ","خَرِصاً خَميصاً صُلبُهُ يَتَأَوَّدُ",10,"د",1,0],["كالكعبة الرفيعة الدعام","ما حجّ إلا مرة في العام",11,"م",1,0],["كَالْكَوْكَبِ الدُّريِّ","لِلأَبْصَارِ يَبدُو مِنْ عَلِ",12,"ل",1,0],["كَالْكَوْكَبِ الثَّابِتِ فِي قُطْبِهِ","يَسْطَعُ فِي فِكْرِي وَفِي مَنْظَرِي",13,"ر",2,0],["كَآلِكَ لَمْ تَزَلْ في كُلِّ جُلىَّ","تَسُدُّ الثَّلْمَ أَو تُسْدِي الرَّغِيبا",14,"ب",2,0],["كَالْكَوْكَبِ السَّيَّارِ مَا طَالَعْتَهَا","وَأَخُوكَ فِيهَا الْكَوْكَبُ السَّيَّارُ",15,"ر",1,0],["كالكرم طاب جنيً في كف قاطعه","وزاد من طيبه في الدَّن عاصره",16,"ر",2,0],["كَالكَرمِ يُؤخَذُ مَن أَطرافِهِ طَمَعاً","في أَن يُضاعَفَ مِنهُ الأَكلُ وَالثَمَرُ",17,"ر",1,0],["كَالكَرمِ لَم يَمنَعهُ بُعدُ عَريشِهِ","مِن أَن يُقرّبَ لِلجُناةِ قُطُوفَهُ",18,"ه",1,0],["كَالكَوكَبِ الدُرِيِّ في","سَمائِهِ المُحَلِّقِ",19,"ق",1,0],["كالكِذب أَوهى سَبَبا","ولا أَضلَّ مَذهَبا",20,"ب",2,0],["كَالكَوكَبِ الأَزهَرِ اِنشَقَّت دُجُنَّتُهُ","في الناسِ لا رَهَقٌ فيهِ وَلا بَخَلُ",21,"ل",1,0],["كالكلب يُقلق بالنباح ضبارما","والكبر يمنعه عليه مصالا",22,"ل",2,0],["كالكُحل أسودَ لأياً ما تكلمنا","مما عفاه سحابُ الصَيّف الرجسُ",23,"س",1,0],["كالكركدنّ الذي يزدهى","في قبحهِ يُسخرُ من قدّه",24,"د",2,0],["كَالكَهلِ مُقتَبَلُ الشَبابِ يُزِيِّنُهُ","حِلمُ التَكَهُّلِ وَالشَبابُ أَريبُ",25,"ب",1,0],["كَالكَرمِ إِذ نادى مِنَ الكافورِ","في خُشَشاوَي حُرَّةِ التَحريرِ",26,"ر",1,0],["كالْكَوْكَبِ المُنْقَضِّ أَوْ","سَهْمٍ مِنَ القَوْسِ انْخَرَطْ",27,"ط",1,0],["كالكهرباء إلى الدنيا السرور سرى","من قصر ملك سما يُزرى بغمدان",28,"ن",1,0],["كالكامل العقل الرزين فانه","يأبى التظاهر والفعال جلائل",29,"ل",1,0],["كالكَوكبِ الدُرِيِّ حَفَّ","تْهُ كواكبُهُ الدَّراري",30,"ر",2,0],["كالكهرباء إذا الأيدي بها اتصلت","ينساب منها إلى الأجسام تيّارُ",31,"ر",1,0],["كالكوكب العلويّ لا يضرّه","حوادث الجوّ وإن قيل اخترق",32,"ق",1,0],["كَالكَلب حينَ يَنبح","بِكسرة يستصلح",33,"ح",1,0],["كالكاسِ طاف بها المديرُ فلم يكنْ","ليَ ظئرها وغداً صريعَ الكاس",34,"س",1,0],["كالكلب يتبعهم يشمشم أعظما","يرمونها والقوم للحمان",35,"ن",1,0],["كَالكاعِبِ الحَسناء إِلّا أَنَّها","مِن فَقدِها الأَكفاء قَبلَكَ أيِّمُ",36,"م",1,0],["كالكونت دميان ده مارتل من شغلت","بغر آثاره الاقلام والكتب",37,"ب",1,0],["كالكوكب الشرقي قي شروقهِ","بالجانب الغىبي في المناهل",38,"ل",1,0],["كالكوكب الدري الا انها","جاءت بابهى من سناه واسطعا",39,"ع",2,0],["كالكلب في الآري لا يعتلف","ولا يخلي الغير أن يعتلف",40,"ف",1,0],["كالكْرمِ مال على الدَّعائم فاجمٌ","أو مثل قِنْوِ النخلةِ المتعثكلِ",41,"ل",1,0],["كَالكَلبِ إِن تَحمِل عَلَي","هِ الدَهرَ أَو تَترُكهُ يَلهَث",42,"ث",1,0],["كَالكوكبِ الدرّيّ في","ظلماء لا يَخفى بِها",43,"ب",3,0],["كَالكَشفِ بِالعِلمِ وَكالدِّلاَلَه","مِنَ الكلاَمِ وَصفِ ذِى الجَلاَلَه",44,"ه",1,0],["كالكهرباء إذا سرت في سلكها","أحيته وانطلقت به حركاته",45,"ت",2,0],["كالكوكب السيار من","فلك إلى فلك إلى",46,"ل",2,0],["كَالكَوكَبِ الدُرِّيُّ مُسَّدِلاً","سَدّاً كَحِسِّ النارِ مَقمَعُهُ",47,"ع",2,0],["كالكهرباءةِ في أَسمى طبائِعها","روحٌ تَحجَّبُ خَلف النّيرِ الساني",48,"ن",2,0],["كالكرى يطوفُ به","ثم ينقضي الحُلُمُ",49,"م",1,0],["كالكوب السيار ما طالعتها","وأخوك فيها الكوكب السيار",50,"ر",1,0],["كالكوكب الدري يسطع هاتكا","ليل الضلالة بالشعاعِ المبهرِ",51,"ر",1,0],["كالكلب أنبح دون أي نتيجة","لا أرتضي لفريسةٍ أغتالُ",52,"ل",1,0],["كالكوكب الدري في عليائه","قد زينته سلاسل بيضاءُ",53,"ا",2,0],["كالكَهرُبَاءِ هوَاكِ سارَ فِي جسَدِي","لمَّا أدرْتِ الطَّواحِينَ الهوَائِيَّةْ",54,"ي",2,0]]}