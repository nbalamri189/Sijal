ViewPoem.aspx?id=206773",""],[5596,"إلى آل الفلاح في مصابهم","https://www.poetsgate.com/ViewPoem.aspx?id=206783",""],[5616,"شيخوخة","https://www.poetsgate.com/ViewPoem.aspx?id=203235",""],[5688,"سلّم لربك","https://www.poetsgate.com/ViewPoem.aspx?id=200911",""],[5781,"قلبٌ وذرَّاتُ رماد ...","https://www.poetsgate.com/ViewPoem.aspx?id=176650",""],[402,"أعلى مكانتك الإله وشرفا","https://www.poetsgate.com/ViewPoem.aspx?id=36543",""],[5842,"أبكي مصاب الجامعة \\ محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=130029",""],[5906,"في الأخلاق","https://www.poetsgate.com/ViewPoem.aspx?id=187980",""],[5906,"دع عنك أجواء الغرور","https://www.poetsgate.com/ViewPoem.aspx?id=188018",""],[5906,"في الحكمة / الإحسان / الخير فطرة","https://www.poetsgate.com/ViewPoem.aspx?id=189958",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[5973,"ولماذا الخصام؟","https://www.poetsgate.com/ViewPoem.aspx?id=15893",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6143,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=176851",""],[6213,"مغارات السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76300&r=&rc=48",""],[6300,"في رحاب الذات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82837&r=&rc=8",""],[6305,"أجِزْ حَرَامَاً ...!!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87338&r=&rc=11",""],[5164,"أنت الطريق..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75657&r=&rc=11",""],[6323,"زلزال الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82178&r=&rc=9",""]],"verses":[["فَالْخَمْرُ تَحْكُمُ فِي الْعُقُولِ مُسِنَّةً","وَتُدَاسُ أَوَّلَ عَصْرِهَا بِالأَرْجُلِ",0,"ل",1,0],["فالخَيْلُ عنْ أعْراقِهِ والتّمْرُ عنْ","أخْلاقِهِ والطِّيبُ عنْ أمْداحِهِ",1,"ح",2,0],["فالخزي قد أُسلفتَهُ عاجلاً","فأتِ الذي تهوى من الأمرِ",2,"ر",1,0],["فَالخَيلُ غاضِبَةٌ عَلى أَرسانِها","وَالبيضُ غاضِبَةٌ عَلى الأَجفانِ",3,"ن",1,0],["فالخلد صفنان خلد الناس بعدهم","بالذكر والخلد عند الله مرتقبا",4,"ب",2,0],["فالخَلْقُ في الأرضِ يَعْجَلُونَ ومَوْ","لاكِ على تَوْأَدٍ ومُرْتَقَبِ",5,"ب",1,0],["فَالخَيلُ وَاللَيلُ وَالبَيداءُ تَعرِفُني","وَالسَيفُ وَالرُمحُ وَالقِرطاسُ وَالقَلَمُ",6,"م",1,0],["فالخيرُ والشرُّ منه جاريانِ على","ما شاء لا حيلةٌ تُغْنِي ولا حَذَرُ",7,"ر",1,0],["فَالخِمسُ بَعدَ الخِمسِ يَذهَبُ عِرضُهُ","في سَيرِها وَالبيدُ بَعدَ البيدِ",8,"د",1,0],["فَالخَوفُ مِن خَلفِ العُلَيجِ وَدونَهُ","مِن موبِقاتِ الحَربِ أَوحاها رَدى",9,"د",2,0],["فَالخَيلُ تَصهَلُ وَالفَوارِسُ تَدَّعي","وَالبَيضُ تَلمَعُ وَالأَسِنَّةُ تَزهَرُ",10,"ر",1,0],["فَالخَيرُ لَيسَ بِمَولودٍ لَهُ وَلَدٌ","لَكِن لَهُ مِن بَناتِ الشَرِّ أَولادُ",11,"د",1,0],["فَالخِلُّ يُصفي وُدَّهُ مُتَكَدِّراً","وَالضِدِّ أَكدَرُ ما يَكونُ إِذا صَفا",12,"ف",2,0],["فَالخَلقُ تُقسِمُ بِاِسمِ اللَهِ مُخلِصَةً","وَبِاِسمِكَ أَقسَمَ رَبُّ العَرشِ لِلصَدَقِ",13,"ق",1,0],["فالخيلُ والليلُ حقاً عاشقي وأنا","وأنتِ والعاشقُ القرطاسُ والقلمُ",14,"م",1,0],["فَالخُضرُ قُضبٌ لَها الأَعلامُ عَن وَرَقٍ","لَو أَثمَرَت قَبلَها بِالحَتفِ قُضبانُ",15,"ن",1,0],["فَالخَطبُ لا يُعيِي مُروءَةَ ماجِدٍ","رُكناهُ نَبعٌ وَالخُطوبُ ثُمامُ",16,"م",1,0],["فَالخَدُّ يَغرَقُ في مَعينِ دُموعِهِ","وَالقَلبُ يَصلى في جَحيمِ أُوارِهِ",17,"ر",2,0],["فَالخَمرُ فينا كَالبِجادي حُمرَةً","وَالكَأسُ مِن ياقوتَةٍ بَيضاءِ",18,"ا",2,0],["فَالخَمرُ ياقوتَةٌ وَالكَأسُ لُؤلُؤَةٌ","مِن كَفِّ جارِيَةٍ مَمشوقَةِ القَدِّ",19,"د",1,0],["فَالخَطبُ أَفظَعُ مِن سَرّاءَ تَأمُلُها","وَالأَمرُ أَيسَرُ مِن أَن تُضمِرَ الرُعُبا",20,"ب",2,0],["فَالخُنَّسُ الكُنَّسُ الأَفرادُ خالِقُها","مُدَبِّرٌ لِاِحتِقارِ الخُنُسِ في الكُنُسِ",21,"س",1,0],["فالخيل واللّيل والبيداء تعرفني","والحرب والضّرب والقرطاس والقلم",22,"م",1,0],["فَالْخِصْبُ في الدُّنْيَا عَلامَةُ عَدْلِهِ","والْغَيْثُ فَضْلَةُ جُودِهِ الْمَسْكُوبِ",23,"ب",1,0],["فَالْخَيْرُ مُنْقَبِضٌ وَالشَّرُّ مُنْبَسِطٌ","وَالْجَهْلُ مُنْتَشِرٌ وَالْعِلْمُ مُنْدَفِنُ",24,"ن",1,0],["فَالْخَيْرُ وَالنِّعْمَةُ فِي بُعْدِهِ","والشَرُّ وَالنِقْمَةُ فِي قُرْبِهِ",25,"ب",2,0],["فَالخيْرُ كُلُّ الخَيْرِ فِيهِ مُقْبِلاً","وَالشَّرُّ كُلُّ الشَّرِّ أَنْ يَتَخَلَّفَا",26,"ف",2,0],["فَالخَيْرُ فِي السَّيْرِ عَنْ","رَوِيَّةٍ لا عَجَلْ",27,"ل",1,0],["فالخفايا عليك في لوحك المحف","وظ لو ما كشفت عنها غطاها",28,"ا",3,0],["فالخيل عن أعراقه والتمر عن","أخلاقه والطيب عن أقداحه",29,"ح",2,0],["فالخود تمنع ان يقص ذراعها","وتثيب حفظا للذراع سوارها",30,"ر",3,0],["فالخلقُ طوعُ يديكمُ","والدهرُ صارَ لكم خَديمَا",31,"م",2,0],["فالخير كلُّ الخيرِ كفّ نفوسنا","عن زيفها والشرُّ في إنكارها",32,"ه",2,0],["فالخدُّ صبحٌ وهذا الشعر غيهبه","والثغرُ فيه الطلا أحلى من العسلِ",33,"ل",1,0],["فَالخِلُّ مَن أَصفى مَوَدَّةَ قَلبِهِ","لِذَوي مَوَدَّتِهِ وَأَهل صَفائِهِ",34,"ا",3,0],["فَالخَيلُ تَعرِفُ في الهَيجاءِ صَولَتهُ","بِحَيثُ يَأخُذُ سامي النَقعِ بِالكَظَمِ",35,"م",1,0],["فالخير في النادر إلمامُه","والشرُّ ليلا ونهارا يَكُرّْ",36,"ر",1,0],["فالخَلْق في عرسٍ يدوم سرورُه","أَبدا كأنّ الليل فيه نهار",37,"ر",1,0],["فالخوف في أثوابه","والحرف حشو فراشه",38,"ش",2,0],["فالخطوب الغبر لم تت","رك بكفي غير كوبي",39,"ي",1,0],["فَالخَوابي فَرَغنَ من كُلِّ شَيءٍ","وَمنَ الخُبزِ لا نُصادِفُ نَزرا",40,"ر",2,0],["فالخمرُ لو لم تكن كمقلتها","في الطّبْع ما أسكرتْ نَدَامَاها",41,"ا",3,0],["فالخطّةُ الحُسنى بُحسنِ تَشبُّهٍ","ليكونَ مِن نسلِ الكِرامِ كِرام",42,"م",1,0],["فالخَيل تصهل والارماح شاحرة","وَالبيض وَالبيض مسراها العجاجات",43,"ت",1,0],["فالخصْرُ يُنْهضُها ظَمآنَ مُندمِجاً","والرِّدف يُنْبِضُها رَيَّانَ مُنْتَفجا",44,"ج",2,0],["فَالخَيرُ ساعٍ مَعهُ حَيثُ سَعى","مُصاحِباً وَنازِلٌ أَينَ نَزَل",45,"ل",1,0],["فَالخَدُّ وَالخالُ في قَتلي قَدِ اِشتَرَكا","وَيلاهُ مِمّا جَناهُ الخَدُّ وَالخالُ",46,"ل",1,0],["فَالخَيلُ تَعَثَّرُ بِالتيجا","نِ وَبِالأَشلاءِ وَبِالقُلَلِ",47,"ل",1,0],["فَالخَصرُ يُنحِلُ عاشِقيهِ نُحولُهُ","وَالبُرءُ في خَصرِ اللَّمى لَو يُنحَلُ",48,"ل",1,0],["فَالخَيلُ لا تَمشي بِها إِلّا عَلى","هامٍ مُنَضَّدَةٍ وَشَعرٍ أَشقَرِ",49,"ر",1,0],["فالخَيرُ فيه طَبعُ","وأَصلُه وَالفَرعُ",50,"ع",1,0],["فالخَلقُ من خلقه في نزهةٍ عجبٍ","ومن خلائقه في روضةٍ أُنفِ",51,"ف",1,0],["فالخَلقُ من يُمنى يَدَيه 