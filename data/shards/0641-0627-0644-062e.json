{"poems":[[77,"لا تعجبن لطالب نال العلا","https://www.aldiwan.net/poem36129.html","الخفيف"],[77,"عبد العزيز خليفة الله الذي","https://www.aldiwan.net/poem36624.html","الكامل"],[51,"أقول إذ قابلني وجهه","https://www.aldiwan.net/poem63994.html","السريع"],[91,"لو أستطيع كتبت بالنيران","https://www.aldiwan.net/poem62773.html","عموديه"],[85,"فيم ابتسامك للدنيا وغايتها","https://www.aldiwan.net/poem7530.html","البسيط"],[56,"يا عين لا للغضا ولا الكثب","https://www.aldiwan.net/poem58644.html","المنسرح"],[43,"واحر قلباه ممن قلبه شبم","https://www.aldiwan.net/poem10521.html","البسيط"],[62,"تفرد الله بالتقدير ما اشتركت","https://www.aldiwan.net/poem52418.html","البسيط"],[45,"شغلان من عذل ومن تفنيد","https://www.aldiwan.net/poem63493.html","الكامل"],[45,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[45,"أخفي هوى لك في الضلوع وأظهر","https://www.aldiwan.net/poem63638.html","الكامل"],[49,"الخير والشر مزداد ومنتقص","https://www.aldiwan.net/poem64149.html","البسيط"],[66,"حاشاك تسمع في ما نقل العدى","https://www.aldiwan.net/poem38653.html","الكامل"],[66,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[69,"سوداء قالت لبيضاء الأديم إذا","https://www.aldiwan.net/poem28205.html","البسيط"],[81,"طاول بجدك فالأقدار عنوان","https://www.aldiwan.net/poem61481.html","البسيط"],[81,"يلحى الزمان وما عليه ملام","https://www.aldiwan.net/poem61489.html","الكامل"],[81,"من لي بأن يدنو بعيد مزاره","https://www.aldiwan.net/poem61514.html","الكامل"],[48,"لا تبك بعد تفرق الخلطاء","https://www.aldiwan.net/poem10406.html","الكامل"],[48,"لا تبك ليلى ولا تطرب إلى هند","https://www.aldiwan.net/poem62546.html","البسيط"],[46,"لا تفرحن بفأل إن سمعت به","https://www.aldiwan.net/poem22121.html","البسيط"],[46,"لعالم العلو فعل لاخفاء به","https://www.aldiwan.net/poem22828.html","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140979",""],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42534","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55024","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55178","السريع"],[77,"عبد العزيز خليفة الله الذي","https://www.poetsgate.com/ViewPoem.aspx?id=33544",""],[116,"صدور القوم سيدنا الرفاعي","https://www.aldiwan.net/poem41092.html","عموديه"],[129,"حي المعاليم والرسوما","https://www.aldiwan.net/poem50515.html","مجزوء الكامل"],[129,"يا صاح نصحا للنصيحة فاقبلا","https://www.aldiwan.net/poem50592.html","الكامل"],[136,"لقد تبدى كغصن البان في الميل","https://www.aldiwan.net/poem47410.html","البسيط"],[170,"عذل المشوق يهيج في برحائه","https://www.aldiwan.net/poem1595.html",""],[170,"أنخ فهذي قباب العز والكرم","https://www.aldiwan.net/poem1676.html",""],[186,"ما أبعد الأشياء مما يسر","https://www.aldiwan.net/poem14532.html","السريع"],[186,"عبقت بطيب ثنائك الأقطار","https://www.aldiwan.net/poem14538.html","الكامل"],[187,"إن المنجم يغتدي","https://www.aldiwan.net/poem43691.html","مجزوء الكامل"],[198,"أيهذا الشاعر المغ","https://www.aldiwan.net/poem39872.html","مجزوء الرمل"],[224,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[230,"ما قال أوه لفقده واها","https://www.aldiwan.net/poem51256.html","المنسرح"],[271,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[272,"بالابرق الفرد اطلال قديمات","https://www.aldiwan.net/poem52092.html","البسيط"],[276,"ذكرت بلجاء بالإصباح منبلجا","https://www.aldiwan.net/poem25609.html","البسيط"],[283,"ما فتكات البيض والسمر الأسل","https://www.aldiwan.net/poem32648.html","الرجز"],[283,"أما كفاني طرف منك نبال","https://www.aldiwan.net/poem32665.html","البسيط"],[283,"أنا بالغزلان وبالغزل","https://www.aldiwan.net/poem32672.html","المتدارك"],[283,"إن الهوى إن كنت عنه تسأل","https://www.aldiwan.net/poem32675.html","الكامل"],[283,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[298,"جلا الكؤوس فجلى ظلمة السدف","https://www.aldiwan.net/poem33219.html","البسيط"],[298,"شق الدجى عن نحره الفجر","https://www.aldiwan.net/poem33263.html","أحذ الكامل"],[306,"صبحا بدا من رأي خير الدين","https://www.aldiwan.net/poem56390.html","الكامل"],[321,"رزء به كل القلوب انكوت","https://www.aldiwan.net/poem61622.html","الطويل"],[347,"ومدامة صفراء في قارورة","https://www.aldiwan.net/poem24124.html","الكامل"],[367,"إن كنت تترعه كأسا لمكتئب","https://www.aldiwan.net/poem17314.html","البسيط"],[372,"لا تستطل بالذي تأتي به السحب","https://www.aldiwan.net/poem57528.html","البسيط"],[378,"ورد الله الرحيم","https://www.aldiwan.net/poem59269.html","مجزوء الرمل"],[378,"رب الورى في عرشه","https://www.aldiwan.net/poem66957.html","مجزوء الكامل"],[392,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[404,"هذا وقتل النفس ذاك وغيره","https://www.aldiwan.net/poem33492.html","الكامل"],[406,"يا قوم إني مرزا","https://www.aldiwan.net/poem49553.html","المجتث"],[406,"احذر صديقك إن تغير إنه","https://www.aldiwan.net/poem49889.html","الكامل"],[413,"إن كنت ساقية ببزل","https://www.aldiwan.net/poem43.html","مجزوء الكامل"],[438,"حتام تقطع بالقطيعة والجفا","https://www.aldiwan.net/poem2551.html","الكامل"],[459,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[465,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[501,"الخب ميال مع الشبهات","https://www.aldiwan.net/poem37714.html","الكامل"],[506,"النسيان","https://www.aldiwan.net/poem42457.html","السريع"],[539,"أبخير عيد أم بخير إمام","https://www.aldiwan.net/poem47940.html","عموديه"],[563,"لما تولى تخت مصر سعيدها","https://www.aldiwan.net/poem52645.html","الكامل"],[576,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"]],"verses":[["فَالْخَمْرُ تَحْكُمُ فِي الْعُقُولِ مُسِنَّةً","وَتُدَاسُ أَوَّلَ عَصْرِهَا بِالأَرْجُلِ",0,"ل",1,0],["فالخَيْلُ عنْ أعْراقِهِ والتّمْرُ عنْ","أخْلاقِهِ والطِّيبُ عنْ أمْداحِهِ",1,"ح",2,0],["فالخزي قد أُسلفتَهُ عاجلاً","فأتِ الذي تهوى من الأمرِ",2,"ر",1,0],["فَالخَيلُ غاضِبَةٌ عَلى أَرسانِها","وَالبيضُ غاضِبَةٌ عَلى الأَجفانِ",3,"ن",1,0],["فالخلد صفنان خلد الناس بعدهم","بالذكر والخلد عند الله مرتقبا",4,"ب",2,0],["فالخَلْقُ في الأرضِ يَعْجَلُونَ ومَوْ","لاكِ على تَوْأَدٍ ومُرْتَقَبِ",5,"ب",1,0],["فَالخَيلُ وَاللَيلُ وَالبَيداءُ تَعرِفُني","وَالسَيفُ وَالرُمحُ وَالقِرطاسُ وَالقَلَمُ",6,"م",1,0],["فالخيرُ والشرُّ منه جاريانِ على","ما شاء لا حيلةٌ تُغْنِي ولا حَذَرُ",7,"ر",1,0],["فَالخِمسُ بَعدَ الخِمسِ يَذهَبُ عِرضُهُ","في سَيرِها وَالبيدُ بَعدَ البيدِ",8,"د",1,0],["فَالخَوفُ مِن خَلفِ العُلَيجِ وَدونَهُ","مِن موبِقاتِ الحَربِ أَوحاها رَدى",9,"د",2,0],["فَالخَيلُ تَصهَلُ وَالفَوارِسُ تَدَّعي","وَالبَيضُ تَلمَعُ وَالأَسِنَّةُ تَزهَرُ",10,"ر",1,0],["فَالخَيرُ لَيسَ بِمَولودٍ لَهُ وَلَدٌ","لَكِن لَهُ مِن بَناتِ الشَرِّ أَولادُ",11,"د",1,0],["فَالخِلُّ يُصفي وُدَّهُ مُتَكَدِّراً","وَالضِدِّ أَكدَرُ ما يَكونُ إِذا صَفا",12,"ف",2,0],["فَالخَلقُ تُقسِمُ بِاِسمِ اللَهِ مُخلِصَةً","وَبِاِسمِكَ أَقسَمَ رَبُّ العَرشِ لِلصَدَقِ",13,"ق",1,0],["فالخيلُ والليلُ حقاً عاشقي وأنا","وأنتِ والعاشقُ القرطاسُ والقلمُ",14,"م",1,0],["فَالخُضرُ قُضبٌ لَها الأَعلامُ عَن وَرَقٍ","لَو أَثمَرَت قَبلَها بِالحَتفِ قُضبانُ",15,"ن",1,0],["فَالخَطبُ لا يُعيِي مُروءَةَ ماجِدٍ","رُكناهُ نَبعٌ وَالخُطوبُ ثُمامُ",16,"م",1,0],["فَالخَدُّ يَغرَقُ في مَعينِ دُموعِهِ","وَالقَلبُ يَصلى في جَحيمِ أُوارِهِ",17,"ر",2,0],["فَالخَمرُ فينا كَالبِجادي حُمرَةً","وَالكَأسُ مِن ياقوتَةٍ بَيضاءِ",18,"ا",2,0],["فَالخَمرُ ياقوتَةٌ وَالكَأسُ لُؤلُؤَةٌ","مِن كَفِّ جارِيَةٍ مَمشوقَةِ القَدِّ",19,"د",1,0],["فَالخَطبُ أَفظَعُ مِن سَرّاءَ تَأمُلُها","وَالأَمرُ أَيسَرُ مِن أَن تُضمِرَ الرُعُبا",20,"ب",2,0],["فَالخُنَّسُ الكُنَّسُ الأَفرادُ خالِقُها","مُدَبِّرٌ لِاِحتِقارِ الخُنُسِ في الكُنُسِ",21,"س",1,0],["فالخيل واللّيل والبيداء تعرفني","والحرب والضّرب والقرطاس والقلم",22,"م",1,0],["فَالْخِصْبُ في الدُّنْيَا عَلامَةُ عَدْلِهِ","والْغَيْثُ فَضْلَةُ جُودِهِ الْمَسْكُوبِ",23,"ب",1,0],["فَالْخَيْرُ مُنْقَبِضٌ وَالشَّرُّ مُنْبَسِطٌ","وَالْجَهْلُ مُنْتَشِرٌ وَالْعِلْمُ مُنْدَفِنُ",24,"ن",1,0],["فَالْخَيْرُ وَالنِّعْمَةُ فِي بُعْدِهِ","والشَرُّ وَالنِقْمَةُ فِي قُرْبِهِ",25,"ب",2,0],["فَالخيْرُ كُلُّ الخَيْرِ فِيهِ مُقْبِلاً","وَالشَّرُّ كُلُّ الشَّرِّ أَنْ يَتَخَلَّفَا",26,"ف",2,0],["فَالخَيْرُ فِي السَّيْرِ عَنْ","رَوِيَّةٍ لا عَجَلْ",27,"ل",1,0],["فالخيل عن أعراقه والتمر عن","أخلاقه والطيب عن أقداحه",28,"ح",2,0],["فالخود تمنع ان يقص ذراعها","وتثيب حفظا للذراع سوارها",29,"ر",3,0],["فالخلقُ طوعُ يديكمُ","والدهرُ صارَ لكم خَديمَا",30,"م",2,0],["فالخير كلُّ الخيرِ كفّ نفوسنا","عن زيفها والشرُّ في إنكارها",31,"ه",2,0],["فالخدُّ صبحٌ وهذا الشعر غيهبه","والثغرُ فيه الطلا أحلى من العسلِ",32,"ل",1,0],["فَالخِلُّ مَن أَصفى مَوَدَّةَ قَلبِهِ","لِذَوي مَوَدَّتِهِ وَأَهل صَفائِهِ",33,"ا",3,0],["فَالخَيلُ تَعرِفُ في الهَيجاءِ صَولَتهُ","بِحَيثُ يَأخُذُ سامي النَقعِ بِالكَظَمِ",34,"م",1,0],["فالخير في النادر إلمامُه","والشرُّ ليلا ونهارا يَكُرّْ",35,"ر",1,0],["فالخَلْق في عرسٍ يدوم سرورُه","أَبدا كأنّ الليل فيه نهار",36,"ر",1,0],["فالخوف في أثوابه","والحرف حشو فراشه",37,"ش",2,0],["فالخطوب الغبر لم تت","رك بكفي غير كوبي",38,"ي",1,0],["فَالخَوابي فَرَغنَ من كُلِّ شَيءٍ","وَمنَ الخُبزِ لا نُصادِفُ نَزرا",39,"ر",2,0],["فالخمرُ لو لم تكن كمقلتها","في الطّبْع ما أسكرتْ نَدَامَاها",40,"ا",3,0],["فالخطّةُ الحُسنى بُحسنِ تَشبُّهٍ","ليكونَ مِن نسلِ الكِرامِ كِرام",41,"م",1,0],["فالخَيل تصهل والارماح شاحرة","وَالبيض وَالبيض مسراها العجاجات",42,"ت",1,0],["فالخصْرُ يُنْهضُها ظَمآنَ مُندمِجاً","والرِّدف يُنْبِضُها رَيَّانَ مُنْتَفجا",43,"ج",2,0],["فَالخَيرُ ساعٍ مَعهُ حَيثُ سَعى","مُصاحِباً وَنازِلٌ أَينَ نَزَل",44,"ل",1,0],["فَالخَدُّ وَالخالُ في قَتلي قَدِ اِشتَرَكا","وَيلاهُ مِمّا جَناهُ الخَدُّ وَالخالُ",45,"ل",1,0],["فَالخَيلُ تَعَثَّرُ بِالتيجا","نِ وَبِالأَشلاءِ وَبِالقُلَلِ",46,"ل",1,0],["فَالخَصرُ يُنحِلُ عاشِقيهِ نُحولُهُ","وَالبُرءُ في خَصرِ اللَّمى لَو يُنحَلُ",47,"ل",1,0],["فَالخَيلُ لا تَمشي بِها إِلّا عَلى","هامٍ مُنَضَّدَةٍ وَشَعرٍ أَشقَرِ",48,"ر",1,0],["فالخَيرُ فيه طَبعُ","وأَصلُه وَالفَرعُ",49,"ع",1,0],["فالخَلقُ من خلقه في نزهةٍ عجبٍ","ومن خلائقه في روضةٍ أُنفِ",50,"ف",1,0],["فالخَلقُ من يُمنى يَدَيه لهم","يُمنٌ ومن يُسراهُما يُسرُ",51,"ر",1,0],["فَالخلقُ مرعيٌّ وراعٍ نظّموا","نَظم الدِّلاصِ وسَردها الموضونِ",52,"ن",1,0],["فَالخَطبُ قَد جَلَّ وَغَطّى النُهى","وَالصَبرُ قَد عَزَّ وَضاعَ اليَقينِ",53,"ن",1,0],["فَالخَمرُ شَمسٌ وَالحَبابُ كَواكِب","وَالكَفُّ قُطبٌ وَالزُجاجُ سَماءُ",54,"ا",2,0],["فَالخَمرُ كانَت سُيوفُ المَزجِ تَقتُلُها","وَقَتلُ ساحِرَةٍ مِن أَفضَلِ القُرَبِ",55,"ب",1,0],["فالخيل مرتبطاتٌ وهي فاعلةٌ","في الشكلِ ما يفعل التقريبُ والخَببُ",56,"ب",1,0],["فالختان التام للنا","سوتِ عنوانٌ أليم",57,"م",1,0],["فالخير خيرك إن بدا","والشر شرك إن جرى",58,"ا",1,0],["فالخليل كخله في الخلال","والجليس جليسه له مثال",59,"ل",1,0],["فالخمر مسكرها مزيل للحجى","من غير نفع يقتضي التحليلا",60,"ل",2,0],["فالخرْجُ لا يتناهى","وَالدّخلُ لا يتخَزَّى",61,"ز",2,0],["فالخمرُ يمتَعُ ذوقُها ونَسيمُها","فإذا استحالَتْ فهْيَ خَلٌ حامِضُ",62,"ض",1,0],["فالخيلُ تَعلَمُ كَيفَ نَلح","قُهَا غَداةَ لحِاقِهَا",63,"ق",3,0],["فالخدّ ورد زانه في وجهه","ماء الحياء فمنيتي أن أقطفا",64,"ف",2,0],["فالخسفُ للجاثمِ في وكرِهِ","والخِصبُ للقاطعِ والكاسبِ",65,"ب",1,0],["فالخلُّ من ناش في الخطوب بضبع","يك ومن سدَّ رتقهُ خللك",66,"ك",1,0],["فالخير في الأخيار لم يبرح لهم","إلفاً أليف تمكنٍ وثبات",67,"ت",1,0],["فالخير كلّ الخير لكِ ولي","أنْ تقبلي بالمرِّ أو ترحلِيْ",68,"ل",2,0],["فالخَلقُ بين مُضَرَّجٍ بِدِمائِهِ","مُتبعثرِ الأشلاءِ فوقَ رَغامِ",69,"م",1,0],["فالخيرُ مِن أيدي سعيدٍ يُجْتَنَى","والحَمدُ في قلبِ المؤرِّخِ يُغرَسُ",70,"س",1,0],["فالخلقُ لمَّا كنتَ لي والداً","تشهَدُ أَنِّي طاهرُ المولِد",71,"د",1,0]]}