{"poems":[[95,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[50,"ومحكم في مهجتي","https://www.aldiwan.net/poem65239.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54968","المجتث"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[129,"قوس الشيب قناتي","https://www.aldiwan.net/poem4062.html","مجزوء الرمل"],[129,"قوس ظهري المشيب والكبر","https://www.aldiwan.net/poem4092.html","المنسرح"],[132,"كتب الحسن في محياك سطرا","https://www.aldiwan.net/poem50510.html","الخفيف"],[182,"أماه","https://www.aldiwan.net/poem50693.html","البسيط"],[228,"كان شفيق لم يزل مختلي","https://www.aldiwan.net/poem39703.html","السريع"],[369,"ألم صبحا وجمر الحلي قد بردا","https://www.aldiwan.net/poem60940.html","البسيط"],[371,"قوست إذا شعرت شيبي أسهم","https://www.aldiwan.net/poem17837.html","الكامل"],[563,"طيب محي الدين مسك في الورى","https://www.aldiwan.net/poem33886.html","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38578","الكامل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78045","الرجز"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47177","الرمل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60885","الرمل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102571","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93783","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140089",""],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126950","المديد"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101217","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111440","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86359","الرمل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136912",""],[5055,"ثارت الفتنة","https://www.poetsgate.com/ViewPoem.aspx?id=101192",""],[5151,"هَمساتُ حُبك في الهوى ميلادُ","https://www.poetsgate.com/ViewPoem.aspx?id=185181",""],[307,"القطار","https://www.poetsgate.com/ViewPoem.aspx?id=215236",""],[5385,"قوس المنون بسهم البين قدر رشقا","https://www.poetsgate.com/ViewPoem.aspx?id=144222",""],[5739,"خيط الازرّه تشنّج ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131234",""],[6262,"بقسوةٍ رُبَّما قصدوها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80106&r=&rc=4",""]],"verses":[["قُوسِمْتُ فِي حُزْنِي عَلَيْهِ فَمَا","بَالِي كَأَنَّ الْحُزْنَ لَمْ يُقْسَمِ",0,"م",1,0],["قَوسُ المَنايا طَرفُهُ","وَاللَحظُ جُلُّ سِهامِهِ",1,"م",2,0],["قَوْسٌ أَرَنَّتْ فَهَاجَتْ","بِهِ هَوَى لِلْبِرَازِ",2,"ز",1,1],["قوّسوا من ظهرِهِ فيما جنوا","فهو قد شاب ولم يكتهِل",3,"ل",1,0],["قوسٌ من النور ماجت تحتَهُ أمَمٌ","وغابَةٌ من ظبي غنّى الردى فيها",4,"ي",3,0],["قَوّسَ الشِّيبُ قَناتي","بَعدَ أَن كَانَت سَوِيَّه",5,"ه",1,1],["قَوّسَ ظَهري المشيبُ والكبَرُ","والدَّهرُ يا عَمرو كُلُّه عبَرُ",6,"ر",1,1],["قوسُه حاجباه والأنفُ تشا","بتُه تحتهن جَفنٌ سقيمُ",7,"م",1,0],["قَوْسُ الرَّزايا تمادى في تَصيُّدِنا","وسَعدُنا قَدْ غَفا أوّاهُ ما أشْقاهْ",8,"ا",2,0],["قَوساً من الحُبِّ فَيَبقى مَعي","ما بَقِيَ العُمرُ وَأَبقى مَعَه",9,"ه",1,0],["قَوْساً وسَهْماً معاً يُمسى مَجازُهما","حقيقةً في حَشا المُخْفِي له حَسَدا",10,"د",2,0],["قُوِّستُ إِذا شَعَرتُ شَيبِيَ أَسهُمٌ","تَرمي فَيَنجَحُ رَميُها وَمَرامُها",11,"ه",2,1],["قوسه أين الذي يرمي بها","غرض التحقيق يا قوم هلمّوا",12,"م",3,0],["قَوسُ السّماءِ بِهِ السّحابُ مُطوَّق","وَالنّفسُ قَد أَبدَت إِلَيهِ شوقَها",13,"ه",2,1],["قَوس العُيون النجلِ","تَرمي الحَشا بِالنَبلِ",14,"ل",1,0],["قَوَّسَ النّونَ لِعَيْنٍ حاجباً","وبِميمِ الثّغر في الخّط خَتَمْ",15,"م",1,0],["قَوّستْ لي حَجبيْها عرضاً","وَرَمِتْني فأصَابتْ مقتلي",16,"ل",2,0],["قوس حاجبك المقوس","قد رمى قلبي بسهمين",17,"ن",1,0],["قوسين أو أدنى دنا","حقاً ودان بخير دين",18,"ن",1,0],["قوس ونصف القوس أو جيبية","أو نصف جيب أو كعشر عشيرة",19,"ه",1,0],["قوس لوسط الشمس تقويم لها","وكذاك قل في كوكب بالنسبة",19,"ه",1,0],["قوسه في الرمي حاجبه","راق مما فيه من زجج",20,"ج",1,0],["قوس الحواجب يرمي المستهام إذا","ما الوجه أسفر أنبالاً من الهدب",21,"ب",1,0],["قُوِّسَت قَوسُهُ وَلم تَتَفَكَّك","فرَمى رُنِّنَت وفي السَّهمِ نَيزَك",22,"ك",1,0],["قوس رام راح يدعى قزحا","وهو في غير الحيا لم يرشش",23,"ش",1,0],["قوَّست ظهره صروف الليالي","فغدا نصف حلقةٍ أو كنون",24,"ن",1,0],["قوسنا الشاهد على ضرم اللهب","عند كسرى يوم جلجل للخشير",25,"ر",1,0],["قوسي أصابِعُ رميتين تَجاوزت","قلبي وأخطأ سهمَها الصَّيَّادُ",26,"د",1,0],["قوسُ المنيّة لم يُخطئ ضحيّته","بل انّ سيفاً لها للعنقِ بتّارُ",27,"ر",1,0],["قوس المنون بسهم البين قدر رشقا","فلا تسل ما اصاب القلب والحدقا",28,"ق",2,1],["قوسين معكوسه...! المعروف منثنيه.","مبرومة ٍ ..! خصرها مقفول بيديها.",29,"ي",3,0],["قوسَ أسطورةٍ..دُمَى","من طيورِ اللظى السجينْ",30,"ن",1,0]]}