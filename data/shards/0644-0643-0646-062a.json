64693",""],[5573,"أشكر على حسن التعامل جنابك","https://www.poetsgate.com/ViewPoem.aspx?id=204547",""],[5764,"عصفورتي","https://www.poetsgate.com/ViewPoem.aspx?id=137053",""],[5764,"الشارع","https://www.poetsgate.com/ViewPoem.aspx?id=174220",""],[5809,"تنهيدة","https://www.poetsgate.com/ViewPoem.aspx?id=205318",""],[5907,"تعب ضيقه!","https://www.poetsgate.com/ViewPoem.aspx?id=176258",""],[5956,"أيها البحر العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=183229",""],[5956,"كُوَّةٌ في باب السجن","https://www.poetsgate.com/ViewPoem.aspx?id=183640",""],[5956,"أحداث غزة علّمتْنا","https://www.poetsgate.com/ViewPoem.aspx?id=192183",""],[5956,"هل أنا أكبرُ المعمَّرين؟","https://www.poetsgate.com/ViewPoem.aspx?id=192731",""],[5956,"لا نفْعَ تفعلهُ","https://www.poetsgate.com/ViewPoem.aspx?id=192935",""],[5956,"الجانبان","https://www.poetsgate.com/ViewPoem.aspx?id=193911",""],[5956,"سنَدُ الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=194378",""],[5956,"شفاك الله","https://www.poetsgate.com/ViewPoem.aspx?id=194442",""],[5956,"إن كان عبد الله أصبح ساليا","https://www.poetsgate.com/ViewPoem.aspx?id=194611",""],[5966,"يا أمة العُرْب","https://www.poetsgate.com/ViewPoem.aspx?id=158310",""],[6068,"رشيد تونس -18-","https://www.poetsgate.com/ViewPoem.aspx?id=177481",""],[6068,"طمع الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177484",""],[6093,"لا للتعصب","https://www.poetsgate.com/ViewPoem.aspx?id=188469",""],[6093,"وكم يضر بحسن الغادة الغضب","https://www.poetsgate.com/ViewPoem.aspx?id=215072",""],[6127,"ضاقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=214909",""],[5724,"ما رفرفت فوق هام العرب رايات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55140&r=&rc=7",""],[6189,"عيبان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83602&r=&rc=69",""],[6230,"العقاب ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67168&r=&rc=42",""]],"verses":[["لَكِن تَوَلَّيتُ غَيرَ شَكٍّ","خَيرَ إِمامٍ وَخَيرَ هادي",0,"د",2,0],["لَكِنْ تَوَهَّمْنَا قَرَارَكَ فِي الحِمَى","أَشْفَى لِغلَّةِ عَوْدِكَ الظَّمْآنِ",1,"ن",1,0],["لَكِنْ تَدَارَكَهُمْ مِنْ فَضْلِكُمْ عَمَمٌ","يَأْسُو جِرَاحَاتِ ذَاكَ الكَارِثِ العَمَمِ",2,"م",1,0],["لَكِنْ تَجِيءُ مِنَ الفُنُونِ","بِكُلِّ مُبْتَدَعِ وَغَالِي",3,"ل",2,0],["لَكُنتُ لِلقَلبِ في الهَوى تَبَعاً","إِنَّ هَواه رَبَائِبُ الحَجَلِ",4,"ل",1,0],["لكنت أبقى زمناً من غير حد","يا صاحب الشرطة ما هذا اللدد",5,"د",1,0],["لكِنْ تطاوَلَتِ الشكْوى بِقائدَتي","فكنتُ شهْراً وحالي حالُ مَصْفُودِ",6,"د",1,0],["لكن تشوَّفْتُ إلى ينعه","بطلعه فامنح يدي يَنْعه",7,"ع",2,0],["لكن تطارد كي يغترَّ مارقةً","أخرى إذا ما دهاها كرَّ عطافا",8,"ف",2,0],["لكن تنصّحتُ في نفسي لأهديَها","إليك والنفسُ علِقٌ ليس بالجللِ",9,"ل",1,0],["لكن تجنّتْ عليه نعمتهُ","كما تجنَّى عليَّ إذ صرما",10,"م",2,0],["لكن تَصَوُّرَ كونه يبقى كذا","متباعداً عني لقلبي يصدع",11,"ع",1,0],["لكن تعال قل لي","ولا تكن مضلى",12,"ل",2,0],["لَكُنتُ كَظَبيٍ أَدرَكَتهُ حِبالَةٌ","وَقَد كانَ يَخشى الظَبيُ إِحدى الكَفائِفِ",13,"ف",1,0],["لَكُنتُ أَطوَعَ مِن ذي حَلقَةٍ جُعِلَت","في الأَنفِ ذَلَّ بِتَقوادٍ وَتَرسامِ",14,"م",1,0],["لَكُنتَ الَّذي يَختارُهُ اللَهُ بَعدَهُ","لِحَملِ الأَماناتِ الثِقالِ العَظائِمِ",15,"م",1,0],["لَكِن تَأَخَّرَ بي عَصري وَقَدَّمَ مَن","قَد كانَ قَبلِيَ في ماضي الأَساطيرِ",16,"ر",1,0],["لَكِن تَقاسَمنا عَوامِلَ نَحوِها","فَالإِسمُ كانَ لَهُ وَكانَ الفِعلُ لي",17,"ل",2,0],["لَكِن تَرَكناهُ إِذ بِتنا عَلى ثِقَةٍ","إِنَّ الأَميرَ يُكافيهِ فَيَكفينا",18,"ن",2,0],["لكنَّ تلك حياةَ صبٍّ بائسٍ","عَرَفَ الردى مما يكابدُ فيكِ",19,"ك",1,0],["لَكُنتَ إِلى لَيلى فَقيراً وَإِنَّما","يَقودُ إِلَيها وُدَّ نَفسِكَ حينُها",20,"ه",2,0],["لكِنْ تَوَهَّمْتَ السَّقا","م فأسقمَ الوهْمُ البدنْ",21,"ن",1,0],["لكن تفاءلْتُ والأقدارُ غالِبَةٌ","واللّهُ يَبْسُطُ آمالاً فتنبسِط",22,"ط",1,0],["لَكِن تَحاجَزَ عَنها أَن تُعَجِّزَهُ","بَينَ النَدامى فَلا عُذرٌ وَلا عِلَلُ",23,"ل",1,0],["لَكِن تَأَخَّرَ يَومُ مُرتَهَنٍ","بِوَفاتِهِ فَوَعا عَلى كَسرِ",24,"ر",1,0],["لَكِنْ تَصَدَّى لِلزَّمَانِ يَعُوقُهُ","مَنْ خَالَ نَهْضَةَ مِصْرَ ضَرْبَ مُحَالِ",25,"ل",1,0],["لَكِنْ تَعَادَلْنَا بِمِيزَانِنَا","وَلَمْ نُعَادِلْ فَخْذَي كَامِلِ",26,"ل",1,0],["لكن تمسك بالصفا","لا تمزج اللبن الصراح",27,"ح",1,0],["لكنْ تَوَقَّ من الوعودِ سلاسلاً","برّاقةً ، ومن العهودِ كُبولا",28,"ل",2,0],["لكِنْ تَرَفَّعْتُ قَدْراً عَنْكَ أَنَّ أَبِي","نَجْدٌ كريمٌ، وجَدِّي ساد مَنْ سَبقَهْ",29,"ق",2,0],["لكن تعاب لبثك ال","بهتان بالوجه الصلف",30,"ف",1,0],["لكن تأمل نجوم الليل قاطبةً","وأين نجمي بي الأنجم الحلل",31,"ل",1,0],["لكن تواصَوْا بنقض العَهدِ وانتحلُوا","خلافَ ما أمرُوا حقّاً وما ازْدَجَرُوا",32,"ر",3,0],["لكنتُ أتيت من قِدم","بشيء للشتا يجدي",33,"د",2,0],["لكنتَ أكرم ممن يستعيد عطاً","عمَّ البرايا وفضلاً منك قد شملا",34,"ل",2,0],["لكن تحكّم في الهوى رأيُ الحجا","فتصيب ثغرة كل نحر مُثخنا",35,"ن",2,0],["لَكِن تحاتي حُشاشاتُ النُفوسِ إِذا","كادَت تَقضّى بِقَولٍ فيهِ مُتَّصِلِ",36,"ل",1,0],["لَكِن تَرى الفُقَراءَ مُحدِقَةً بِهِ","زُمَراً وَأَبناءَ السَبيلِ نُزُولا",37,"ل",2,0],["لَكن تَرى العَينَ مِنهُ شَكلَ حامِلهِ","وَإِنَّما حَظَّها مَما تَرى الجَسَدُ",38,"د",1,0],["لكنْ تَعوَّضتُ بالشيخ الأجلِّ أبى","محمدٍ خيرَ أَوْطانٍ وخيرَ أَبِ",39,"ب",1,0],["لكن تشبّهت بالملوك وأب","ناء كبار التجّار والعجَم",40,"م",1,0],["لَكُنتُ أَهدي سَدرَةَ المُنتَهى","تَرفَلُ في أَثوابِها الخَضرُ",41,"ر",1,0],["لكُنتُ أظن الهلالَ الحبيبَ","وكنتُ أظن الحبيب القمرْ",42,"ر",1,0],["لكنت بالغت معاً","في الشكم لي والشكد",43,"د",1,0],["لكنت تكفينيَ تكفينها","واجرة الغاسل والمقري",44,"ر",2,0],["لكن تخلّفتُ من سُقْمٍ ومِن أَلمٍ","طِفقْتُ بينهما كالهائِم الخَبِل",45,"ل",1,0],["لكن تصرَّم يومٌ كنتُ آمُلُه","نوراً لعيني فأجدى قلبيّ النارا",46,"ر",2,0],["لكنْ تَعَذُّرُ وَصْلِهِ من نفسه","أبداً وشدّة قَسْوِهِ من قلبه",47,"ه",1,0],["لكن تماديك من كسب نشأت به","طعام سوء على ضعفي يقويك",48,"ك",1,0],["لَكُنتُ كَمُهريقِ الَّذي في سِقائِهِ","لِرَقراقِ آلٍ فَوقَ رابِيَةٍ صَلدِ",49,"د",1,0],["لَكِن تَدارَكَها بَها","ءُ الدينِ فَاِشتَدَّت قُواها",50,"ا",3,0],["لَكِن تَلاطَمَ مِنها خَطوُهُ فَمَشى","بَينَ النَدامى نَزيفاً مَشيَ مُختالِ",51,"ل",1,0],["لكن تَعامى عن نصيحتِه","منك الفؤادُ وَصُمَّت الأذنُ",52,"ن",1,0],["لكن تنازل في الشفاعة عندها","وغدى على أقدامها يترامى",53,"م",2,0],["لَكُنت أَوَّلَ مَن يَرثي لِمُعتَذِر","وَما أَقولُ وَما هَمّي بِمُقتَصَرٍ",54,"ر",1,0],["لَكُنتُ إِذاً كَالمُتَّقي رَأسَ حَيَّةٍ","بِحاجَتِها إِن تُخطِئِ النَفسَ تُعرِجِ",55,"ج",1,0],["لكنت أنفض منه","يدي وأبكي بنيه",56,"ي",2,0],["لكِنْ تَوَقُدُ ذِهْنهِ","ما كادَ شَيءٌ يُفْحِمُه",57,"م",2,0],["لكنَّ تعويقَ إلمامِ الحوادثِ بي","يَصُدُّ عنه معَ الأشواقِ إلمامي",58,"م",2,0],["لكنْ تَرانا في سماءِ عُلاً","من حَولِ قُطْبِ المجدِ نَختَرِق",59,"ق",1,0],["لكنْ تُعِلّلُ منّي النَفْسَ مَعرفتي","بأنّ عهدَ ولائي الدّهرَ مُدَّكَر",60,"ر",1,0],["لكن تدبيره العلياء متصلٌ","منه إليه به عنه له يجب",61,"ب",1,0],["لَكن تَمَنيتُهُ يَوماً فَأَسكَرَني","بِريح خَمرَتِهِ أَو عرف نَكهَتِهِ",62,"ت",2,0],["لكِنَّ تحبيرَه بحبرٍ","أَنكَرَه رَقُهُ الحَبيرُ",63,"ر",1,0],["لكِن تَواليت دون شَكٍّ","خَيرَ اِمامٍ وَخيرَ هادي",64,"د",2,0],["لكُنتُمُ في يَقينٍ","لَم تُخفِهِ يَدُ ستر",65,"ر",1,0],["لكنتُ أريك صَبراً في انْتقاصٍ","بُليتُ بهِ ووجداً في ازْديادِ",66,"د",1,0],["لكن تجاوز ما أراد وجاءنا","بمباحث يلهو بهن اللاهي",67,"ي",1,0],["لكنت وحق اللّه أول ناصر","وكنت لربع الجور أول هادم",68,"م",1,0],["لكن تسطير التوقف لم يكن","لقصور فهمي واضحاً مقبولا",69,"ل",2,0],["لكن تَعَبَّدَ بالدعاء عبادَه","فأحبهم فيما أتى الدعاء",70,"ا",2,0],["لكنتُ أبلُّ من فِيه أُوامي","وأنقَعُ من مراشفِه غليلي",71,"ل",2,0],["لكن تخيّرتُك كفؤاً لها","لأنها منك على كلّ حالْ",72,"ل",1,0],["لَكنتُ انتَزَعتُ حدودَ العراق","ولو أنَّ أرسانََهُم في فَمي",73,"م",2,0],["لَكُنتُ عَلى وُدّيكَ فيما تَسومُني","مُخاطَرَةً في الناسِ مِن ذَينِ أَعجَبُ",74,"ب",1,0],["لَكُنتُ قَد وَسَّختُ هَجوي بِهِ","وَما يُساوي وَسَخَ الجُبنِ",75,"ن",1,0],["لكن تعطل والزمان معاكس","والله يعلم علة الأدواء",76,"ا",2,0],["لَكِنْ تَفَضُّلُ رَبِّي","مَنْ نَالَهُ لَيْسَ يَشْقَى",77,"ق",2,0],["لكن تَمَكَّنَ فيكمُ","داءٌ لَعَمري مُزمِنُ",78,"ن",1,0],["لكن تراه العيون جل ولا","تدركه باب ذاك مسدود",79,"د",1,0],["لَكُنتُ كَراج لِلنَوافِلِ حِفظَها","لَدى مَن مُضاعاتٌ لَدَيهِ الفَرائِضُ",80,"ض",1,0],["لكن تحككت بَغاً","حتَّى دهتْك داهِيه",81,"ي",2,0],["لَكِنْ تَعَوَّضْتُ عَنْ سُحْبٍ بِمُشْبهِهِ","إِذْ سُحْبُ هَذا وهَذا فِيهِما المَاءُ",82,"ا",2,0],["لَكِنْ تَجَسَّمَ قَبْلَ خَلْقِكَ جُودُكَ ال","بَادِي وَسمَّاه البَرِيَّةُ حَاتِمُ",83,"م",1,0],["لَكُنتُمُ مَعَها إِلباً وَكانَ لَها","نابٌ بِأَسفَلَ ساقٍ أَو بِعُرقوبِ",84,"ب",1,0],["لكن تأسينا بقوم هم","أئمة العدل مدى الدهر",85,"ر",1,0],["لكن تروح واحد من وجده","رد الغرام عليه ريم شارد",86,"د",1,0],["لكنْ تَواصوا بِعليِّ الهُدى","أن لا يُوالوهُ وأن يَخْذُلوا",87,"ل",3,0],["لَكن تعرّض للنظارة أَلكنٌ","فَرَمى الحَشا بِمَصائب وَغَواشي",88,"ش",2,0],["لَكنت مع التقصير في وصف شطره","كَأَني لَدى مَن لَم يَعاينه حالم",89,"م",1,0],["لَكِن تأمّلتُ ما يَحوي اِقتباسُك مِن","عِلمِ الحَديثِ الَّذي تَبدو بِهِ النُخَبُ",90,"ب",1,0],["لكنْ تَحِنُّ لوالدةٍ ولزوجةٍ","وتُحِبُّ مالاً صامتاً وعَقارَا",91,"ر",2,0],["لكنتُ أُسَلّي النفسَ عمّا ترومهُ","وكنتُ أذودُ العينَ عمّا تراقبُه",92,"ب",2,0],["لكنتُ إذ ذاكَ في حالٍ أَضُنُّ بها","إِنّي بأنسكَ عن أُنسي بهم راضِ",93,"ض",1,0],["لكن تفاوتت الحظوظ فعاشق","رزق الوصال وآخر لم يرزق",94,"ق",1,0],["لكن تجلد الوَزير الموصلي","الباسلِ الشهم الشَّجيع المقبلِ",95,"ل",1,0],["لَكِنَّ تَأثيرَهُ في الصّبِّ أَوهَنَهُ","وَإِنَّ تَأثيرَهُ في الجفنِ تَزيينُ",96,"ن",1,0],["لَكُنتِ في أَمنٍ مِن العَواصف","قالَت لَهُ ما مَسّني مِن تلف",97,"ف",1,0],["لَكن تَأَمَّل وَاِنظُر المُنادي","فَإِنَّهُ مِن أَعظَم الأَعادي",98,"ي",1,0],["لَكن تَرَجّى ما هُناكَ مِن بَقَر","فَطَمأنوه ثُمَ نامَ وَاِستَقَر",99,"ر",1,0],["لَكن تَرَكتُ سُرورَه وَمُدامَه","حَتّى أَكونَ لَدَيهِ ذا إِفطارِ",100,"ر",1,0],["لكن تُسلِّى الحزينَ رؤيتُها","تُريحُه من هَمٍّ وأوراط",101,"ط",1,0],["لكن تعوق الإنسانَ عن طلب الْ","مرادِ في الدهر شرَّ إعواق",102,"ق",1,0],["لكن تبدَّلتُ من حالٍ قد انقَلَبَتْ","حالاً دعتني إلى التوقير والأدب",103,"ب",1,0],["لكن تصبرت والصبر الجميل له","أجر ورب صبور غير مأجور",104,"ر",1,0],["لكن تطاول ظفرهُ","فلذاك قيل أبو المظفر",105,"ر",1,0],["لكن تطفلت في مدحي علاك على","موائد الجود علي أو أوفاه",106,"ا",2,0],["لكن تطف