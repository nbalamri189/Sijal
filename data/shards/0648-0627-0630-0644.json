{"poems":[[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[53,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[100,"الربيع والشعر","https://www.aldiwan.net/poem10291.html","عموديه"],[9,"ألم تنه نفسك عما بها","https://www.aldiwan.net/poem21912.html","المتقارب"],[73,"أصخ لمقالتي واسمع","https://www.aldiwan.net/poem11966.html","مجزوء الوافر"],[88,"أيها القوم مالكم في جمود","https://www.aldiwan.net/poem44819.html","الخفيف"],[51,"أسل الذي عطف الأعنة","https://www.aldiwan.net/poem65814.html","مجزوء الكامل"],[32,"تقول بثينة لما رأت","https://www.aldiwan.net/poem27804.html","المتقارب"],[85,"شبكت قلبي يا عيني","https://www.aldiwan.net/poem6805.html","عموديه"],[43,"هينا فقدت من الرجال بليدا","https://www.aldiwan.net/poem10621.html","الكامل"],[45,"تظن شجوني لم تعتلج","https://www.aldiwan.net/poem62675.html","المتقارب"],[45,"شوق له بين الأضالع هاجس","https://www.aldiwan.net/poem64588.html","الكامل"],[28,"رأيتُ نوار قد جعلت تجنى","https://www.aldiwan.net/poem1289.html",""],[28,"ولكن خربانا تنوس لحاهم","https://www.aldiwan.net/poem5249.html","الطويل"],[61,"خطوب تجور ولا تعدل","https://www.aldiwan.net/poem51473.html","المتقارب"],[49,"أيا رب يا ذا العرش أنت رحيم","https://www.aldiwan.net/poem63109.html","الطويل"],[31,"ألم تسأل الأطلال والمتربعا","https://www.aldiwan.net/poem42466.html","الطويل"],[76,"أرقت وقلبي عنك ليس يفيق","https://www.aldiwan.net/poem39255.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[100,"شمسان","https://www.poetsgate.com/ViewPoem.aspx?id=50171",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[45,"تَظُنُّ شُجُونيَ لَمْ تَعْتَلِجْ","https://www.poetsgate.com/ViewPoem.aspx?id=33100",""],[35,"عفا السَّفحُ من أمِّ الوليدِ فكبكبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20654&r=&rc=8",""],[115,"ترك الوفا بدر وعامل بالجفا","https://www.aldiwan.net/poem41652.html","الكامل"],[124,"لما وجدت مكارم الأخلاق","https://www.aldiwan.net/poem23750.html","مجزوء الكامل"],[128,"يا صاح نصحا للنصيحة فاقبلا","https://www.aldiwan.net/poem50592.html","الكامل"],[209,"خطرت تسحب أذيال الرسم","https://www.aldiwan.net/poem26481.html","عموديه"],[229,"شهر الصيام أجل شهر مقبل","https://www.aldiwan.net/poem50852.html","الكامل"],[229,"أيا دير مرحنا سقتك رعود","https://www.aldiwan.net/poem51140.html","الطويل"],[256,"قالت وقد كشف الوداع","https://www.aldiwan.net/poem48368.html","مجزوء الكامل"],[280,"أدنى اشتياقي أن أبيت عليلا","https://www.aldiwan.net/poem60594.html","الكامل"],[290,"دع عنك أيام السرور","https://www.aldiwan.net/poem11665.html","مجزوء الكامل"],[364,"ألا ليت قلبي يوم أعلن وجده","https://www.aldiwan.net/poem60955.html","الطويل"],[383,"ألا حبذا عصر اللوى وزمانه","https://www.aldiwan.net/poem24188.html","الطويل"],[405,"سبحان من خص الفلز بعزة","https://www.aldiwan.net/poem49542.html","الكامل"],[416,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[439,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[453,"مرحبا بالمنافس الفاتكان","https://www.aldiwan.net/poem61764.html","الخفيف"],[461,"ربعي من بني جشم","https://www.aldiwan.net/poem15121.html","المديد"],[477,"برق تألق من تهامه","https://www.aldiwan.net/poem15205.html","مجزوء الكامل"],[477,"حييت من دمن ومن أطلال","https://www.aldiwan.net/poem15352.html","الكامل"],[515,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"]],"verses":[["وَأَذَلَّ أَعناقَ العِدى","ذُلَّ المَطِيَّةِ لِلجَريرِ",0,"ر",1,0],["وَأَذَلَّ الزَمانُ بَعدَكَ عِطفَي","هِ وَقَد كانَ مِن أَعَزِّ العِبادِ",1,"د",1,0],["وَأَذَلَّ مِن قَبرِ الخُمولِ نَشَرتَهُ","فَغَدا يُناهِبُكَ العُلى وَيُجاذِبُ",2,"ب",1,0],["وأذل أهل الأرض قلباً من رأى","عبث الظلوم وذل عنه وأحجما",3,"م",2,0],["وَإِذ لِمَّتي كَجَناحِ الغُدافِ","تَرنو الكَعابُ لَإِعجابِها",4,"ب",3,0],["وَإِذ لِلحَظِّ إِقبالٌ","وَإِذ في العَيشِ مُستَمتَع",5,"ع",1,0],["وأذلّ الحياة عندي حياةٌ","قد أهينت حقوقها بجُحود",6,"د",1,0],["وأذلَّ موقفي العزي","ز عليَّ في أقصى رحابك",7,"ك",1,0],["وَإِذ لِمَّتي كَجَناحِ الغُرابِ","تُرَجَّلُ بِالمِسكِ وَالعَنبَرِ",8,"ر",1,0],["وأذَّلِّل والحق معايا","واجى أعاتبك ما تهونش عليا",9,"ي",2,0],["وأذَلَّ جمجُمَةً وأعيا منطِقاً","وأقَلَّ معروفاً وأذوى عودا",10,"د",2,0],["وَإِذ لَم يَكُن شاهِدٌ يُرتَضى","وَراءَكَ في الجَحدِ مودٍ مُضِج",11,"ج",1,0],["وَأَذَلتَني حَتّى لَقَد أَشمَتَّ بي","مَن كانَ يَحسُدُ مِنهُمُ وَيُنافِسُ",12,"س",1,0],["وَأَذلَقَهُ النِفاقُ وَكادَ مِنهُ","وَجيبُ القَلبِ يَنتَزِعُ الحِجابا",13,"ب",2,0],["وَإِذ لا طَعامٌ غَيرَ ما أَطعَمَتكُمُ","بُطونُ جَواري جَعفَرٍ وَظُهورُها",14,"ر",3,0],["وإذ لكَ من قَصَبٍ أسهُمٌ","طِوالٌ ومن خَشَبٍ مُنصُلُ",15,"ل",1,0],["وَأَذلَلتُ نَفسي اليَومَ كَيما أُعِزَّها","غَداً حَيثُ يَبقى العِزُّ لي وَيَدومُ",16,"م",1,0],["وَإِذ لا نُطيعُ العاذِلينَ وَلا نَرى","لِواشٍ لَدَينا يَطلُبُ الصَرمَ مَطمَعا",17,"ع",2,0],["وإذْ لبناتِ الخِدْرِ نحوي تطلُّعٌ","كما لمعتْ بينَ الغمامِ بروقُ",18,"ق",1,0],["وَإِذْ لاَ تُعَدُّ المَعْصِيَاتُ عَلَى الفَتَى","خَطَا صَي عَلَيهِ ذُنُوبُ",19,"ب",1,0],["وأذلُّوا الصعبَ في رِحْلاتِهم","أيُّ صعبٍ عندهم لم يُرْكَب",20,"ب",1,0],["وأذلّ ما في شعب يجتدي","مستعمرا ويؤلّه استبدادا",21,"د",2,0],["وأذلُّ خلقِ اللهِ في بَلَدٍ طغت","فيه الرزايا من يكونُ محايدا",22,"د",2,0],["وإذ لم يكن شاهد يرتضى","ورائك في الجحد مود مضج",23,"ج",1,0],["وإذْ لا ترى في الناسِ شيئاً يفوقها","وفيهنَّ حسنٌ- لو تأمّلتَ - مجنبُ",24,"ب",1,0],["وأذلني بدلاله فجميع أو","فأتى عنا فيه ومدته صفا",25,"ف",2,0],["وأذل مطلبها العزيز","وفت في عضد الهمام",26,"م",1,0],["وأَذلَّ نفساً إن تعالتْ رفعة","لا تعْلُها عن مُنتهى مقدارِها",27,"ه",2,0],["وأذلت من عتي لهم","وأعزت في حماهم من خدم",28,"م",1,0],["وأَذَلَّ مَن عاداك ذِلّةَ راغمٍ","ورماه بالحدَثِ المهِمِّ المُعْضِلِ",29,"ل",1,0],["وإذْ لمِتَّي لم يوقِظ الشيبُ ليلَها","وإذْ أثَرِي في الغانياتِ حميد",30,"د",1,0],["وأذل بالجزع الفرا","ق قوي عزاءٍ ممتهن",31,"ن",1,0],["وَأَذِلُّ مِنْ كَمَدٍ وَفَرْطِ صَبابَةٍ","وَالْحُبُّ ما تَرَكَ الْعَزِيزَ ذَلِيلا",32,"ل",2,0],["وأذل فيه كل مئناف","ومغوار صبور",33,"ر",1,0],["وإذ لم يَقُمْ عِنْدِي سوى الطّيْفِ منهمُ","وإذْ لم يَسِرْ منّي سوى القلبِ وَحده",34,"د",2,0],["وَإِذ لِلصِّبا حَوضٌ مِنَ اللَهوِ مُترَعٌ","لَنا عَلَلٌ مِن وِردِهِ وَنَهولُ",35,"ل",1,0],["وأذَلَ أنفاسَ الهواء وكُلُّ ذي","نَفْسٍ فَمُفْتَقِرٌ إلى أنفاسِهِ",36,"ه",1,0],["وأذَلَّ المالَ معطاءٌ يَرى","عزَّةَ الأنفس بالمال المهان",37,"ن",1,0],["وإِذ لا صباحِي رقيبٌ عَتيدٌ","ولا ليلُ وصلِي ظلامٌ بهيمُ",38,"م",1,0],["وأذلَّ الجباهض من تحت نعلي","ه وقد عدها من الديدان",39,"ن",1,0],["وأذلَّتْهم بسالتُنا","فالأبيُّ القَيْلُ مِذْعانُ",40,"ن",1,0],["وأذلَّهُ مِن بعدِ عِزّ","كانَ لا يخشى انفصامَه",41,"م",2,0],["وأذلتُ دمعي في عراصِ ربوعِها","سَحّاً ولم يكُ قبلَهُ بِمُذالِ",42,"ل",1,0],["وأذل عز الناكثين بعسكر","لولا التزاحم لم تسعه البيد",43,"د",1,0]]}