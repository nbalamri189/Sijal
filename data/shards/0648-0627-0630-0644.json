dhabi.ae/diwan/poem/138705",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110050","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91271","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91184","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35518","المنسرح"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4024,"","https://poetry.dctabudhabi.ae/diwan/poem/203807","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86389","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123501","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94736","الطويل"],[4272,"","https://poetry.dctabudhabi.ae/diwan/poem/145989","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81696","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72423","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120522","الكامل"],[1012,"فتح جعلان","https://www.poetsgate.com/ViewPoem.aspx?id=124501",""],[4927,"أنا والوردُ والعصفورُ والحبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=29617",""],[2177,"هما العلمان بالزوراء لاحا","https://www.poetsgate.com/ViewPoem.aspx?id=127085",""],[4119,"ضحكت تباشير الصباح كأنها","https://www.poetsgate.com/ViewPoem.aspx?id=16172",""],[5050,"أسعد الأقوام في الحرب البطل","https://www.poetsgate.com/ViewPoem.aspx?id=38205",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[5186,"هون عليك ولا تضق صدرا","https://www.poetsgate.com/ViewPoem.aspx?id=156443",""],[5290,"أعد الحديث فليس بالمملول","https://www.poetsgate.com/ViewPoem.aspx?id=113132",""],[5464,"فضح الهوى سري","https://www.poetsgate.com/ViewPoem.aspx?id=698",""],[5691,"بشائر النور","https://www.poetsgate.com/ViewPoem.aspx?id=206731",""],[402,"علا مفرقي بعد الشباب مشيب","https://www.poetsgate.com/ViewPoem.aspx?id=35055",""],[6134,"ومذ غبتم عن ناظري وابتعدتم","https://www.poetsgate.com/ViewPoem.aspx?id=169569",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""]],"verses":[["وَأَذَلَّ أَعناقَ العِدى","ذُلَّ المَطِيَّةِ لِلجَريرِ",0,"ر",1,0],["وَأَذَلَّ الزَمانُ بَعدَكَ عِطفَي","هِ وَقَد كانَ مِن أَعَزِّ العِبادِ",1,"د",1,0],["وَأَذَلَّ مِن قَبرِ الخُمولِ نَشَرتَهُ","فَغَدا يُناهِبُكَ العُلى وَيُجاذِبُ",2,"ب",1,0],["وأذل أهل الأرض قلباً من رأى","عبث الظلوم وذل عنه وأحجما",3,"م",2,0],["وَإِذ لِمَّتي كَجَناحِ الغُدافِ","تَرنو الكَعابُ لَإِعجابِها",4,"ب",3,0],["وَإِذ لِلحَظِّ إِقبالٌ","وَإِذ في العَيشِ مُستَمتَع",5,"ع",1,0],["وأذلّ الحياة عندي حياةٌ","قد أهينت حقوقها بجُحود",6,"د",1,0],["وأذلَّ موقفي العزي","ز عليَّ في أقصى رحابك",7,"ك",1,0],["وَإِذ لِمَّتي كَجَناحِ الغُرابِ","تُرَجَّلُ بِالمِسكِ وَالعَنبَرِ",8,"ر",1,0],["وأذَّلِّل والحق معايا","واجى أعاتبك ما تهونش عليا",9,"ي",2,0],["وأذَلَّ جمجُمَةً وأعيا منطِقاً","وأقَلَّ معروفاً وأذوى عودا",10,"د",2,0],["وَإِذ لَم يَكُن شاهِدٌ يُرتَضى","وَراءَكَ في الجَحدِ مودٍ مُضِج",11,"ج",1,0],["وَأَذَلتَني حَتّى لَقَد أَشمَتَّ بي","مَن كانَ يَحسُدُ مِنهُمُ وَيُنافِسُ",12,"س",1,0],["وَأَذلَقَهُ النِفاقُ وَكادَ مِنهُ","وَجيبُ القَلبِ يَنتَزِعُ الحِجابا",13,"ب",2,0],["وَإِذ لا طَعامٌ غَيرَ ما أَطعَمَتكُمُ","بُطونُ جَواري جَعفَرٍ وَظُهورُها",14,"ر",3,0],["وإذ لكَ من قَصَبٍ أسهُمٌ","طِوالٌ ومن خَشَبٍ مُنصُلُ",15,"ل",1,0],["وَأَذلَلتُ نَفسي اليَومَ كَيما أُعِزَّها","غَداً حَيثُ يَبقى العِزُّ لي وَيَدومُ",16,"م",1,0],["وَإِذ لا نُطيعُ العاذِلينَ وَلا نَرى","لِواشٍ لَدَينا يَطلُبُ الصَرمَ مَطمَعا",17,"ع",2,0],["وإذْ لبناتِ الخِدْرِ نحوي تطلُّعٌ","كما لمعتْ بينَ الغمامِ بروقُ",18,"ق",1,0],["وَإِذْ لاَ تُعَدُّ المَعْصِيَاتُ عَلَى الفَتَى","خَطَا صَي عَلَيهِ ذُنُوبُ",19,"ب",1,0],["وأذلُّوا الصعبَ في رِحْلاتِهم","أيُّ صعبٍ عندهم لم يُرْكَب",20,"ب",1,0],["وأذلّ ما في شعب يجتدي","مستعمرا ويؤلّه استبدادا",21,"د",2,0],["وأذلُّ خلقِ اللهِ في بَلَدٍ طغت","فيه الرزايا من يكونُ محايدا",22,"د",2,0],["وإذ لم يكن شاهد يرتضى","ورائك في الجحد مود مضج",23,"ج",1,0],["وإذْ لا ترى في الناسِ شيئاً يفوقها","وفيهنَّ حسنٌ- لو تأمّلتَ - مجنبُ",24,"ب",1,0],["وأذلني بدلاله فجميع أو","فأتى عنا فيه ومدته صفا",25,"ف",2,0],["وأذل مطلبها العزيز","وفت في عضد الهمام",26,"م",1,0],["وأَذلَّ نفساً إن تعالتْ رفعة","لا تعْلُها عن مُنتهى مقدارِها",27,"ه",2,0],["وأذلت من عتي لهم","وأعزت في حماهم من خدم",28,"م",1,0],["وأَذَلَّ مَن عاداك ذِلّةَ راغمٍ","ورماه بالحدَثِ المهِمِّ المُعْضِلِ",29,"ل",1,0],["وإذْ لمِتَّي لم يوقِظ الشيبُ ليلَها","وإذْ أثَرِي في الغانياتِ حميد",30,"د",1,0],["وأذل بالجزع الفرا","ق قوي عزاءٍ ممتهن",31,"ن",1,0],["وَأَذِلُّ مِنْ كَمَدٍ وَفَرْطِ صَبابَةٍ","وَالْحُبُّ ما تَرَكَ الْعَزِيزَ ذَلِيلا",32,"ل",2,0],["وأذل فيه كل مئناف","ومغوار صبور",33,"ر",1,0],["وإذ لم يَقُمْ عِنْدِي سوى الطّيْفِ منهمُ","وإذْ لم يَسِرْ منّي سوى القلبِ وَحده",34,"د",2,0],["وَإِذ لِلصِّبا حَوضٌ مِنَ اللَهوِ مُترَعٌ","لَنا عَلَلٌ مِن وِردِهِ وَنَهولُ",35,"ل",1,0],["وأذَلَ أنفاسَ الهواء وكُلُّ ذي","نَفْسٍ فَمُفْتَقِرٌ إلى أنفاسِهِ",36,"ه",1,0],["وأذَلَّ المالَ معطاءٌ يَرى","عزَّةَ الأنفس بالمال المهان",37,"ن",1,0],["وإِذ لا صباحِي رقيبٌ عَتيدٌ","ولا ليلُ وصلِي ظلامٌ بهيمُ",38,"م",1,0],["وأذلَّ الجباهض من تحت نعلي","ه وقد عدها من الديدان",39,"ن",1,0],["وأذلَّتْهم بسالتُنا","فالأبيُّ القَيْلُ مِذْعانُ",40,"ن",1,0],["وأذلَّهُ مِن بعدِ عِزّ","كانَ لا يخشى انفصامَه",41,"م",2,0],["وأذلتُ دمعي في عراصِ ربوعِها","سَحّاً ولم يكُ قبلَهُ بِمُذالِ",42,"ل",1,0],["وأذل عز الناكثين بعسكر","لولا التزاحم لم تسعه البيد",43,"د",1,0],["وَأَذلَّ مَن شَق العَصا وَأَعزَّ من","نال المُنى وَأَطاع خَير بَشير",44,"ر",1,0],["وأذلُّ ذلَّ العاشقين ولن ترى","متوسّداً للذلِّ مَن لا يعشق",45,"ق",1,0],["وإذ لي غشاءٌ من البأوِ ليس","يَطمَعُ في قَشطِه القاشط",46,"ط",1,0],["وَإِذ لا بُدَّ مِن بَذلِ القَوافي","فَأَهلُ العِلمِ أَولى بالمَديحِ",47,"ح",1,0],["وأذلُّ الناس حر عاقه","عدمُ الحيلة مْع قلةِ مالْ",48,"ل",1,0],["وأذلُّ أهلِ الأرضِ عند اللَّه مَنْ","قطعَ الصديقَ وصادقَ الأعداءَ",49,"ا",2,0],["وإذ لا قرر على حالة","فكن راعي الضأن أو أزدشيرا",50,"ر",2,0],["وَإِذ لَم تُسعِداهُ في هَواهُ","فَيقبحُ أَن تَكُونا عاذِلَيهِ",51,"ي",2,0],["وَإِذ لؤلؤُ الدمعِ مِن جفنها","على الخدّ يَجري تواماً تواما",52,"م",2,0],["وَإِذ لا ترى من لا يُصدق قَوله","عَلَينا وَلا فينا تمشى أَوامره",53,"ر",2,0],["وأذل موقفي العزي","ز على وقوف في رحابك",54,"ك",1,0],["وَأَذَلَّ صَائِلَ فِتْنَةٍ خَبَطَتْ إِلَى","أَعْطَانِهَا خَبْطَ الْبَعِير الأعْرَجِ",55,"ج",1,0],["وَأَذللتُ بِالصَّبرِ الَّذي لا أُطيقه","وَسامَحتُ في الهجرانِ من لا يُسامِحُ",56,"ح",1,0],["وأذلني وأعز مقلتك التي","ملأت قلوب العاشعين جراحا",57,"ح",2,0],["وإذلاله عز أعدائه","وقد جعل القهر أغلالها",58,"ل",3,0],["وإذ لم تزر وجامعت أبطلت به ال","حج كله إبطالا",59,"ل",2,0],["وإذ لم تجد للصبر في القوس منزعا","على نحبها حتى عليك قضت نحبا",60,"ب",2,0],["وأذل عزتهم، وخيب سعيهم","ليكون منهم للردى استسلام",61,"م",1,0],["وَإِذ لَقِيَت عامِرٌ بِالنِسا","رِ مِنهُم وَطِخفَةَ يَوماً غَشوما",62,"م",2,0],["وإذ لغياث الدين غازي بن يوسف","عيون ندى للآملين تصوب",63,"ب",1,0],["وأذلت دمعاً كنت أحبسه","وأصون لؤلؤه عن الثمن",64,"ن",1,0],["وَإِذ لَهُم ذودٌ عِجافٌ وَصِبيَةٌ","وَإِذا أَنتُم لَيسَت لَكُم غَنَمانِ",65,"ن",1,0],["وإذ لا يقيك الناس شيئا تخافه","بأنفسهم إلا الذين تضيم",66,"م",1,0],["وَأَذلُّ الناسِ من لم","يرضِهِ منها القَليلُ",67,"ل",1,0],["وَإِذ لي ندمانان ساقٍ وَقينةٌ","رَشيقان بِالأَرواحِ يَمتَزِجانِ",68,"ن",1,0],["وَأَذلّ ربّي ملكهُ","فيها فَأَوفى بِالنُذور",69,"ر",1,0],["وإذ له مرجح سواه","رجحه فهو الذي سواه",70,"ه",1,0],["واذلت دمعا لو يفيض أتيه","لحكى شآبيب السحاب هواميا",71,"ي",2,0],["وأذلهم ذاك الشريف اذا أتى","يوم الحساب بوجه جان باسر",72,"ر",1,0],["وَإِذْ لَمْ يَكُنْ مَا قَامَ يَطْلُبُ فَاعِلا","سِوَاهُ رَفَعْنَاهُ بِهِ فَتَأَكَّدا",73,"د",2,0],["وأذَلَّ معْطِسَكمْ وأضْرعَ خدَّكم","قتلى فزارةَ إذْ سما ابنا بجدلِ",74,"ل",1,0],["وَإِذ لاِهتِزازِ العيسِ بِالركبِ لذَّةٌ","وَإِذ كُلُّ شُربٍ بارِدٌ لَمْ يُكَدَّرِ",75,"ر",1,0],["وَإِذ لَم تُفَجِّعنا بِأَشياعِنا النوى","وَلَم تُمطرِ العَينانِ مِن كُلِّ ممطَرِ",75,"ر",1,0],["وَاِذ لَم اجِد لي عَن رَحيلي اِقالَةً","فَسِرتُ وَسيري خُطوَة وَالتفاتَةً",76,"ه",1,0],["وَاِذ لَنا البَينُ قَد لاحَت بَوارِقهُ","كَم قَد تَشفَع اِنّي لا اُفارِقُهُ",77,"ه",1,0],["وإذ لم يطيقوا إذ تعالى انتقاصه","ونور ذكاً لم يخفه ستر ساتر",78,"ر",1,0],["وأذلة الإسلام من معشرٍ","قد هتكت حرمة ساداتها",79,"ت",3,0],["وأَذَلُّ الهَوامِ تَنفِرُ منهُ","حَذَراً من بَلائِهِ الأَفيالُ",80,"ل",1,0],["وَإِذ للصبا ما بيننا الملك دائم","يَعزّزنا سُلطانه بِالَّذي مَضى",81,"ض",2,0],["وَأَذل أَعدانا لَنا","عزٌّ تَبلج وَاتضح",82,"ح",1,0],["وَإِذ لَيالي كُلّها غَرَر","لا يَنقضي لَهوُها وَلا دَدُها",83,"د",3,0],["وَإِذ لِأَشراعِ أُذيسَ عَرَضا","حَيثُ أَقامَ القَومُ ديوانَ القَضا",84,"ض",2,0],["وإذ للألمب أتت أرطميس","بقصر النحاس تبددت تميس",85,"س",1,0],["وإذ لمتي تحكي خوافي ناعب","وعندي لوصل الغانيات طريق",86,"ق",1,0],["وإذ لثمت الترب فيه تسليا","عمن به سحب الدلال قرونه",87,"ن",2,0],["واذ للمتاب تدعى اعتراها","سكتة مع تشنج وكزاز",88,"ز",1,0],["وإذ لم يكن فوزٌ بنصرٍ لهادن","إلى اللَه أشكو جور أهيف شادنٍ",89,"ن",1,0],["وإذ ليس سر للمسرة ذائع","وليس ذمام بالمذمة ضائع",90,"ع",1,0],["وأُذلَّ عزُّ الأَبلقِ الفردِ الذي","أخذ التمرّدَ عن أخيه مارد",91,"د",1,0],["وإذ لم يبق منه سوى قليل","تعالي ويك نكثر من عليل",92,"ل",1,0],["واذلت الهند التي","حشرت عساكرها بواسل",93,"ل",1,0],["وأذل العداة إذ خالفوا ال","حق وأموا الضلال والعصيانا",94,"ن",2,0],["وَأَذَلَّ الْحُبُّ عُبْدَاْنَ الْهَوَىْ","فَرَضَوْا بِالذُّلِّ فِيْ رِضْوَاْنِهِ",95,"ن",2,0],["وإذ لاح الفلاح لطالبيه","فعج بالعيس واغتنم الفلاحا",96,"ح",2,0],["وأذل سلطان النفاق بعزة","خضعت لها الآساد في الأخياس",97,"س",1,0],["وأذل الخلق بل أشقاهم","من إذا نودي نادى بالعلل",98,"ل",1,0],["وأذل من عاداه فيك إلى اللقا","واقصمه قصما يا مذل التائه",99,"ا",3,0],["وأذل قدر فضيلة بقيت","وأعز كل رذيلة قدرا",100,"ر",2,0],["وأذل من بالكفر حاول عزة","وأعز بالإيمان كل ذليل",101,"ل",1,0],["وأذلّ قيثاري فما عرفت","أوتاره في غربة طربا",102,"ب",2,0],["وأذلَّ أقْوى دولَتيْن ِبِعَهْدِه ِ","وأحالَ صَرْحَ الدوْلتيْن ِرسوما",103,"م",2,0],["وإذ لا تعد المعصيات على الفتى","خطايا ولا تحصى عليه ذنوب",104,"ب",1,0],["وإذ لم تسع نفسي لضيق مكانها","بجسمي طارت نحوكم حيث أنتم",105,"م",1,0],["وأذلت من كبرياء جباهٍ","كان يعنى لشاؤها بالسجود",106,"د",1,0]]}