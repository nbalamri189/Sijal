{"poems":[[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[53,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[100,"الربيع والشعر","https://www.aldiwan.net/poem10291.html","عموديه"],[9,"ألم تنه نفسك عما بها","https://www.aldiwan.net/poem21912.html","المتقارب"],[73,"أصخ لمقالتي واسمع","https://www.aldiwan.net/poem11966.html","مجزوء الوافر"],[88,"أيها القوم مالكم في جمود","https://www.aldiwan.net/poem44819.html","الخفيف"],[51,"أسل الذي عطف الأعنة","https://www.aldiwan.net/poem65814.html","مجزوء الكامل"],[32,"تقول بثينة لما رأت","https://www.aldiwan.net/poem27804.html","المتقارب"],[85,"شبكت قلبي يا عيني","https://www.aldiwan.net/poem6805.html","عموديه"],[43,"هينا فقدت من الرجال بليدا","https://www.aldiwan.net/poem10621.html","الكامل"],[45,"تظن شجوني لم تعتلج","https://www.aldiwan.net/poem62675.html","المتقارب"],[45,"شوق له بين الأضالع هاجس","https://www.aldiwan.net/poem64588.html","الكامل"],[28,"رأيتُ نوار قد جعلت تجنى","https://www.aldiwan.net/poem1289.html",""],[28,"ولكن خربانا تنوس لحاهم","https://www.aldiwan.net/poem5249.html","الطويل"],[61,"خطوب تجور ولا تعدل","https://www.aldiwan.net/poem51473.html","المتقارب"],[49,"أيا رب يا ذا العرش أنت رحيم","https://www.aldiwan.net/poem63109.html","الطويل"],[31,"ألم تسأل الأطلال والمتربعا","https://www.aldiwan.net/poem42466.html","الطويل"],[76,"أرقت وقلبي عنك ليس يفيق","https://www.aldiwan.net/poem39255.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[45,"تَظُنُّ شُجُونيَ لَمْ تَعْتَلِجْ","https://www.poetsgate.com/ViewPoem.aspx?id=33100",""],[35,"عفا السَّفحُ من أمِّ الوليدِ فكبكبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20654&r=&rc=8",""]],"verses":[["وَأَذَلَّ أَعناقَ العِدى","ذُلَّ المَطِيَّةِ لِلجَريرِ",0,"ر",1,0],["وَأَذَلَّ الزَمانُ بَعدَكَ عِطفَي","هِ وَقَد كانَ مِن أَعَزِّ العِبادِ",1,"د",1,0],["وَأَذَلَّ مِن قَبرِ الخُمولِ نَشَرتَهُ","فَغَدا يُناهِبُكَ العُلى وَيُجاذِبُ",2,"ب",1,0],["وأذل أهل الأرض قلباً من رأى","عبث الظلوم وذل عنه وأحجما",3,"م",2,0],["وَإِذ لِمَّتي كَجَناحِ الغُدافِ","تَرنو الكَعابُ لَإِعجابِها",4,"ب",3,0],["وَإِذ لِلحَظِّ إِقبالٌ","وَإِذ في العَيشِ مُستَمتَع",5,"ع",1,0],["وأذلّ الحياة عندي حياةٌ","قد أهينت حقوقها بجُحود",6,"د",1,0],["وأذلَّ موقفي العزي","ز عليَّ في أقصى رحابك",7,"ك",1,0],["وَإِذ لِمَّتي كَجَناحِ الغُرابِ","تُرَجَّلُ بِالمِسكِ وَالعَنبَرِ",8,"ر",1,0],["وأذَّلِّل والحق معايا","واجى أعاتبك ما تهونش عليا",9,"ي",2,0],["وأذَلَّ جمجُمَةً وأعيا منطِقاً","وأقَلَّ معروفاً وأذوى عودا",10,"د",2,0],["وَإِذ لَم يَكُن شاهِدٌ يُرتَضى","وَراءَكَ في الجَحدِ مودٍ مُضِج",11,"ج",1,0],["وَأَذَلتَني حَتّى لَقَد أَشمَتَّ بي","مَن كانَ يَحسُدُ مِنهُمُ وَيُنافِسُ",12,"س",1,0],["وَأَذلَقَهُ النِفاقُ وَكادَ مِنهُ","وَجيبُ القَلبِ يَنتَزِعُ الحِجابا",13,"ب",2,0],["وَإِذ لا طَعامٌ غَيرَ ما أَطعَمَتكُمُ","بُطونُ جَواري جَعفَرٍ وَظُهورُها",14,"ر",3,0],["وإذ لكَ من قَصَبٍ أسهُمٌ","طِوالٌ ومن خَشَبٍ مُنصُلُ",15,"ل",1,0],["وَأَذلَلتُ نَفسي اليَومَ كَيما أُعِزَّها","غَداً حَيثُ يَبقى العِزُّ لي وَيَدومُ",16,"م",1,0],["وَإِذ لا نُطيعُ العاذِلينَ وَلا نَرى","لِواشٍ لَدَينا يَطلُبُ الصَرمَ مَطمَعا",17,"ع",2,0],["وإذْ لبناتِ الخِدْرِ نحوي تطلُّعٌ","كما لمعتْ بينَ الغمامِ بروقُ",18,"ق",1,0],["وَإِذْ لاَ تُعَدُّ المَعْصِيَاتُ عَلَى الفَتَى","خَطَا صَي عَلَيهِ ذُنُوبُ",19,"ب",1,0],["وأذلُّوا الصعبَ في رِحْلاتِهم","أيُّ صعبٍ عندهم لم يُرْكَب",20,"ب",1,0],["وأذلُّ خلقِ اللهِ في بَلَدٍ طغت","فيه الرزايا من يكونُ محايدا",21,"د",2,0],["وإذ لم يكن شاهد يرتضى","ورائك في الجحد مود مضج",22,"ج",1,0],["وإذْ لا ترى في الناسِ شيئاً يفوقها","وفيهنَّ حسنٌ- لو تأمّلتَ - مجنبُ",23,"ب",1,0]]}