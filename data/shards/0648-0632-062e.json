{"poems":[[53,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[107,"أكان يزيد بأسك إذ تصاب","https://www.aldiwan.net/poem44210.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[154,"تركنا زهيرا للبقيع فثهمد","https://www.aldiwan.net/poem68579.html","الطويل"],[164,"أراني الله رأسك يا صلاح","https://www.aldiwan.net/poem58709.html","البسيط"],[276,"حياك يا ربع ليلى كل هطال","https://www.aldiwan.net/poem52075.html","البسيط"],[447,"إذا ما مررنا بالمقابر ساعة","https://www.aldiwan.net/poem14447.html","الطويل"],[473,"أيا من يهاب ومن يتقى","https://www.aldiwan.net/poem59813.html","المتقارب"],[563,"أنا المعروف لي بالله ألوان","https://www.aldiwan.net/poem33827.html","الهزج"],[568,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138441",""],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/144343","الكامل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105455","السريع"],[1281,"","https://poetry.dctabudhabi.ae/diwan/poem/77439","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27822","البسيط"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130799",""],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140046",""],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3082,"","https://poetry.dctabudhabi.ae/diwan/poem/202457","الطويل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52970","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138700",""],[4935,"إلهي فرج الكربا","https://www.poetsgate.com/ViewPoem.aspx?id=129287",""],[5956,"حتى ولو نلت التقاعد لم تزل","https://www.poetsgate.com/ViewPoem.aspx?id=194828",""],[6318,"لآلئ الشِّعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66159&r=&rc=9",""]],"verses":[["وزَخْرِفِ البيتَ كما زُخرفتْ","روضةُ حَزْنٍ جادها هاضبُ",0,"ب",1,0],["وزُخرِفَتِ الجِنانُ وقيل هذا","مآبُكَ إنّه نِعَمَ المآب",1,"ب",1,0],["وزخرت بالعلم والبيان","وأخرجت فرائد الأعيان",2,"ن",1,0],["وَزُخرِفَ قَولٌ ما قَضى حَقَّ نَحبِهِ","وَقَد يُدرِكُ البَطّالُ رَحمَة رَبِّهِ",3,"ه",1,0],["وزخرفت الجنان لهم وزفوا","إلى فردوسها وغدوا وراحوا",4,"ح",3,0],["وَزَخرفت بهجة الدنيا صَنائعهم","للعرب وَالعجم في سهل وأَجبال",5,"ل",1,0],["وزخرفت الدنيا لنا ما يروقنا","بمنظرها المصمي ومطمعها المردي",6,"د",2,0],["وَزَخرَفَ جَنَّةَ بُستانِنا","وَأَلبَسَها مِنهُ إِستَبرَقا",7,"ق",2,0],["وزخرفتم مقالات بها انغرّت","كهولٌ في مَذَمّاتي وشبان",8,"ن",1,0],["وَزَخرَفتُها في مَعرِضِ المدحِ رَوضَةً","لِتُسقى بِوَبلٍ مِن نَداهُ مُسَرمَدِ",9,"د",1,0],["وزخرفها يفوق الوصف حتى","ذهلت بذي النقوش المقدسيه",10,"ي",2,0],["وزخارف الدنيا يجوز خداعها","أبداً على الأبصار والأسماع",11,"ع",1,0],["وزخرف الطرس بتأليفه ال","نشوة ف زينة بنت الخدور",12,"ر",1,0],["وَزُخرِفَت لِعباد اللَه جَنَّتُهُ","وَاِستَبشَرَ المَلأُ الأَعلى وَجبريلُ",13,"ل",1,0],["وزخرفُ القولِ أبدته دجاجلةٌ","بسورةِ الدُّخ صافٍ قد جثا فيه",14,"ي",2,0],["وزخارف الدنيا وبهجةُ حسنها","الا القفار بجانب الجنات",15,"ت",1,0],["وزخرفت جنة الماوى لمقدمه","وأشرقت نحوه حور من العين",16,"ن",1,0],["وَزخرفُ العَيش لَم تخدعه صورته","وَلا اِستمالته دنياه غَرورته",17,"ه",1,0],["وزخرف والدخان هذا وهذه","وجاثية في موقف ضيق وعر",18,"ر",1,0],["وزخرفُ قولهم إذْ مَوهوهُ","على تزييفه نادى المنادي",19,"د",2,0],["وزخرفوا له الأكاذيب ولم","يغره ما زخرفوه كذبا",20,"ب",2,0],["وزخرف قول من عادا","كالدخان صار هبا",21,"ب",2,0],["وزخخْتَ غيثه منعشاً أقطارنا","وازدادَ منك تطوراً وتماسُكا",22,"ك",2,0],["وزُخْرُفاً لم تَزَلْ تَرْضَاه أَفْئدَةٌ","تَلقَى به النَّارَ أو تَلْقى به العارا",23,"ر",2,0]]}