ae/diwan/poem/54196","الكامل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50052","الرجز"],[72,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[77,"يا ربة البيت الممنع جاره","https://www.poetsgate.com/ViewPoem.aspx?id=34095",""],[100,"كاهن الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=50426",""],[100,"حيث التقينا","https://www.poetsgate.com/ViewPoem.aspx?id=50147",""],[90,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[45,"حَاشَاكِ مِنْ ذِكَرٍ ثَنَتْهُ كَئِيبَا","https://www.poetsgate.com/ViewPoem.aspx?id=31694",""],[80,"لم نؤت ليلتنا الغرّاء من قِصَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=3221",""],[91,"السر في الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=52996",""],[91,"الغراب والبلبل","https://www.poetsgate.com/ViewPoem.aspx?id=14084",""],[1,"ما تَنظُرونَ بِحَقّ وَردَة َ فيكُمُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13177&r=&rc=1",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["وَأُلصِقُ بِالنَقا كَبِدي وَيَهفو","إِلَيَّ مِنَ النَقا وَلَعُ النَسيمِ",0,"م",1,0],["وَأَلصَقوا بِالرَغمِ دونَ نَيلِها","مَوارِناً قَد أَوعَبوا اِجتِداعَها",1,"ع",3,0],["وَالصِبحُ مُنقَدُّ القَميصِ كَما جَلا","عَن حُرِّ مَفرَقِهِ البُجالُ الأَنزَعُ",2,"ع",1,0],["وَالصَبرُ عَن وَلَدٍ يَجِئُ بِمِثلِهِ","أَولى وَلَكن نَندُبُ الآباءَ",3,"ا",2,0],["وَالصُبحُ يَعلَمُ ما أَبكى العيونَ بِهِ","فَسَلْ مَباسِمَهُ عَن مَدمَعِ الباكي",4,"ي",1,0],["وَالصُبحُ نَفَّرَ سِربَ اللَّيلِ حينَ لَوى","تَليلَهُ مِن دياجِيهِ عَلى الكَفَلِ",5,"ل",1,0],["والصّبْرُ في رَيْعانِ كُلِّ رَزيَّةٍ","تَقِصُ الجَوانِحَ عَزْمَةٌ بَزْلاءُ",6,"ا",2,0],["وَالصَبُّ لابُدَّ أَن يَشكو صَبابَتَهُ","إِذا تَبَدَّلَ غَيرَ الدارِ بِالدارِ",7,"ر",1,0],["وَالصَمتُ أَجمَلُ بِالفَتى","مِن مَنطِقٍ في غَيرِ حينِهِ",8,"ن",2,0],["وَالصَمتُ عَن جاهِلٍ أَو أَحمَقٍ شَرَفٌ","وَفيهِ أَيضاً لِصَونِ العِرضِ إِصلاحُ",9,"ح",1,0],["وَالصَّارِمُ الأَمْضَى الَذِي نَحْمِي بِهِ","أَرْجَاءَنَا وَنَرُوغُ مَنْ عَادَانَا",10,"ن",2,0],["والصُّبْحُ قِطْعٌ في فِجاجِ شُروقِهِ","والأرضُ قُطْرٌ أُحْمِيَتْ أقْطارُهُ",11,"ر",2,0],["والصِّنَّ والصِّنَّبْرَ فاجْعَلْهُما","عِيداً كَعيدِ العَجِّ والثَّجِّ",12,"ج",1,0],["وَالصَّبْرُ أَوْلَى مَا اسْتَكَانَ لَهُ الفَتَى","رَغْماً وَحَقُّ العَبْدِ أَنْ يَتَأَدَّبَا",13,"ب",2,0],["والصّبْحُ منْ ريحِ الشّمالِ بزَكْمَةٍ","ترَكَتْهُ منْ بعْدِ اسْتِكانٍ عاطِسا",14,"س",2,0],["وَالصَبرُ مِنهُ قَديماً شيمَةٌ خُلُقٌ","وَزَندُهُ في الوَفاءِ الثاقِبُ الواري",15,"ي",1,0],["وَالصُبحَ قَد فَضَحَ الدُجى فَكَأَنَّهُ","شَيبُ اِبنِ عُروَةَ حينَ يُضحي ناصِلا",16,"ل",2,0],["وَالصَدرُ مُذ وَرَدَت رِفهاً نَواحِيَهُ","تومُ القَلائِدِ لَم تَجنَح إِلى صَدَرِ",17,"ر",1,0],["والصناعات البديعات التي","زانت الدار وأعلت محتواها",18,"ه",2,0],["وَالصُبحُ مِثلُ الأَجلَحِ البَجالِ","في مُسلَهِمّاتٍ مِنَ التَهطالِ",19,"ل",1,0],["والصباح يخجل منّوا","منه طلل فالثنيا",20,"ي",2,0],["والصباح يخجل منّوا","منه ظلل فالثنيا",21,"ي",2,0],["والصبح لم يصف نيّا","ورواق الليل مسبل",21,"ل",1,0],["والصبحُ في الشرق قد لاحت بشائره","والشُّهب تستنُّ سبقاً في مجاريها",22,"ي",3,0],["والصيف أحسن ما به لمشاهد","صبح أغرّ وليلة قمراء",23,"ا",2,0],["والصمت في الأنحاء قد خيّما","فالليل لم يسمع ولم ينطِق",24,"ق",1,0],["وَالصِمَّتَينِ أَجَرتُمُ فَغَدَرتُمُ","وَاِبنُ الأَصَمِّ بِحَبلِ بَيبَةَ جارُ",25,"ر",1,0],["وَالصَعبُ ذو القَرنَينِ أَصبَحَ ثاوِياً","بِالحِنوِ في جَدَثٍ أُمَيمَ مُقيمِ",26,"م",1,0],["وَالصَبرُ يَأتي كُلَّ ذي","رُزءٍ عَلى قَدرِ الرَزِيَّه",27,"ي",2,0],["وَالصُبحُ في أَعقابِهِ يُساوِقُه","طالِبُ ثَأرٍ مِن ظَلامٍ لاحِقُه",28,"ق",2,0],["والصائنين من المعائب عيبةٍ","نبويةٍ مسكيَّة الأنفاس",29,"س",1,0],["والصائنين بأقلام وحدّ ظباً","مسارح الملك من أهواء أهوال",30,"ل",1,0],["والصالحاتُ بحكم اللَّهِ معصِفةٌ","بالصالحاتِ وحكمُ الله يُمتثَلُ",31,"ل",1,0],["وَالصارِفينَ العُمرَ في سوقِ الهَوى","وَالصارِفينَ العُمرَ في المِحرابِ",32,"ب",1,0],["وَالصَوتُ مِن نِعَمِ السَماء وَلَم تَكُن","تَرضى السَما عَنِ الصَدّاحِ",33,"ح",1,0],["وَالصَوتُ مِن نِعَمِ السَماء وَلَم تَكُن","تَرضى السَما إِلّا عَنِ الصَلاحِ",34,"ح",1,0],["وَالصَدى في الغابِ لَم نَنبُس مَعاً","نِسبَةً إِلّا وَعاها وَحَكاها",35,"ا",3,0],["والصَّبا تُرْقِصُ أَوراقَ","الزُّهورِ اليابسَهْ",36,"ه",1,0],["والصبح بعد الليل يحكي ضوءه","املا لذيذا بعد يأس موجع",37,"ع",1,0],["والصبح لما راعها","ما كان بالمداعب",38,"ب",1,0],["والصوم باقٍ والصلاة مقيمة","والحج ينشط في عِناق الحادى",39,"د",2,0],["والصدق أرفع ما اهتز الرجال له","وخير ما عوّد أبناً في الحياة أب",40,"ب",1,0],["وَالصَخرُ عالٍ قامَ يُشبِهُ قاعِداً","وَأَنافَ مَكشوفَ الجَوانِبِ مُنذِرا",41,"ر",2,0],["وَالصُبحُ يُظلِمُ في عَينَيكِ ناصِعُهُ","إِذا سَدَلتَ عَلَيكَ الشَكَّ وَالرِيَبا",42,"ب",2,0],["وَالصَبرُ فيها وَفي فُرسانِها خُلُقٌ","تَوارَثوهُ أَباً في الرَوعِ بَعدَ أَبِ",43,"ب",1,0],["وَالصِدقُ مِن شِيَمِ الكِرامِ فَنَبِّنا","أَمِنَ الشَرابِ تَتوبُ أَم مِن تَركِهِ",44,"ك",2,0],["والصبغ بالتفصيل غاص وبالندى","والشمس أخرج لونَه سبّاكُه",45,"ك",2,0],["والصمغ يجمع ذات بينهما","حتى تفوز بغاية الأملِ",46,"ل",1,0],["والصلوات عدد القطارِ","على النبي المصطفى المختارِ",47,"ر",1,0],["والصبغ روح بالحصان تولدت","وتعودت وسط الجحيم قرارا",48,"ر",2,0],["والصبحُ في كأسِ الظلام مرقرقٌ","وتنفُّسُ الريح العليلةِ واني",49,"ن",2,0],["وأُلصِقُها طَوراً بصدري وأشتِفي","وأمسحُهَا حِيناً بكفي فتعبَقُ",50,"ق",1,0],["والصفوَ خذهُ ما أتاكَ بهِ","واتْركْ على عِلّاتِه الكَدَرا",51,"ر",2,0],["وَالصَيدُ مِن أَودِ بنِ صَعبٍ إِنَّهُم","باتوا عَلَيكَ حَوادِثاً وَخُطوبا",52,"ب",2,0],["وَالصُنعُ إِذ يَرتَجيهِ آمِلُهُ","مُرجاً إِلى أَن يَسوقَهُ قَدَرُه",53,"ر",2,0],["والصَّوتُ من دُولابِ كلِّ متوَّجٍ","أطفالُ زَنْجٍ للرَّضاعِ نَوادِبُ",54,"ب",1,0],["والصُّبحُ حِملُ في حَشا الظَّلماءِ","ونحن نُذكي شُعَلَ الصَّهباءِ",55,"ا",2,0],["وَالصَبرُ في النائِباتِ صَعبٌ","لَكِنَّ فَوتَ الثَوابِ أَصعَب",56,"ب",1,0],["وَالصِدقُ يَعقِدُ فَوقَ رَأ","سِ حَليفِهِ لِلبِرِّ تاجا",57,"ج",2,0],["وَالصِدقُ يَثقُبُ زَندُهُ","في كُلِّ ناحِيَةٍ سِراجا",57,"ج",2,0],["وَالصَبرُ يُعقِبُ رِضواناً وَمَغفِرَةً","مَعَ النَجاحِ وَخَيرُ الصُحبَةِ الصُبرُ",58,"ر",1,0],["وَالصِدقُ حِصنٌ دونَ صاحِبِهِ","بُنِيَت عَلى رُشدٍ دَعائِمُهُ",59,"م",2,0],["وَالصُبحُ يُغبَنُ فيهِ لاعِبُهُ","وَاللَيلُ يُغبَنُ فيهِ نائِمُهُ",59,"م",2,0],["وَالصَمتُ لِلمَرءِ الحَليمِ وِقايَةٌ","يَنفي بِها عَن عِرضِهِ ما يَكرَهُ",60,"ه",1,0],["وَالصُبحَ بِالنورِ لَهُ قَد مَحا","قُم فَاِرشُفِ الكَأسَ وَدَع مَن لَحا",61,"ح",2,0],["وَالصُبحُ لَيلٌ بِالعَجاجِ وَقَد بَدا","بِالبيضِ في فَودِ العَجاجِ مَشيبُ",62,"ب",1,0],["وَالصُبحُ قَد أَعَمَّنا بِنورِهِ","لَمّا اِنثَنى جِنحُ الظَلامِ راحِلا",63,"ل",2,0],["وَالصِبحُ لَم يُبقِ","في الدُجى رَمَقا",64,"ق",2,0],["وَالصادِقَ الوَعدِ في الكِتابِ وَمَن","فَداهُ ذو العَرشِ بَعدَما اِمتَحَنَه",65,"ن",2,0],["وَالصُبحُ قَد أَخلَقَت ثَوبَ الدُجى يَدُهُ","وَلَيتَهُ جادَ لِلعُشّاقِ بِالخَلُقِ",66,"ق",1,0],["والصبرُ هاوٍ والغيوبُ خفيةٌ","وشفاؤه في قبضةِ المنَّاح",67,"ح",1,0],["والصقر تاجك تاج فرعون الذي","جعل الشموس الزهر في كفيك",68,"ك",1,0],["والصرخة الكبرى كمو","جِ البحر تدوي في الأذن",69,"ن",1,0],["والصفح عند ذوي القلو","بِ البيض من قبل الإِساءه",70,"ه",1,0],["والصبحُ في مشرقه هازمٌ","والليلُ في مغربه منهزم",71,"م",1,0],["والصُّبحُ يرفعُ كفّاً منه لاقطةً","ما للدَّراري على الآفاق من دُرَرِ",72,"ر",1,0],["والصِّبا في مَعاطِفي وكَأنِّي","غُصُنٌ في يدِ الصَّبا يَتَأَوَّد",73,"د",1,0],["والصبحُ يلقط من جُمَانِ نجومِهِ","ما كانَ في الآفاقِ ذا تَبديدِ",74,"د",1,0],["والصبحُ يبرقُ كرّةً في كرّةٍ","مِثلَ استلالِ الصارِمِ المَغمودِ",74,"د",1,0],["والصارمُ الهنديّ يسقي الردى","فكيفَ إن سُقّيَ مَوتاً ذباح",75,"ح",1,0],["والصّبح قَد دفَعَ النّجوم عُبَابه","كأنّهُ سيلٌ يَسُوقُ حبابا",76,"ب",2,0],["وَالصَبرُ بِالأَرواحِ يُعرَفُ فَضلُهُ","صَبرُ المُلوكِ وَلَيسَ بِالأَجسامِ",77,"م",1,0],["وَالصُبحُ تَخلُفُ نورَ الشَمسِ غُرَّتُهُ","وَقَرنُها مِن وَراءِ الأُفقِ مُحتَجِبُ",78,"ب",1,0],["والصبرُ ما انفكَّ مَرداةً لمُحترِبٍ","ومستميتٍ، ومنجاةً لمِسكين",79,"ن",1,0],["وَالصُبحُ قَد مَزَّقَ عَن صَدرِهِ","جَيبَ ظَلامٍ باتَ مَزرورا",80,"ر",2,0],["وَالصُبحُ مَحطوطُ النِقابِ قَدِ اِحتَبى","في شَملَةٍ وَرسِيَّةٍ فَتَأَزَّرا",81,"ر",2,0],["وَالصُبحُ قَد صَدَعَ الظَلامَ كَأَنَّهُ","وَجهٌ وَضيءٌ شَفَّ عَنهُ قِناعُ",82,"ع",1,0],["والصّادقَ البأسَ يحمِي الوادِيَيْن إذا","صَدَّ الحُماةُ ونَامَ الذّادةُ الغُيرُ",83,"ر",1,0],["وَالصَدرُ أَنَّ القَلبَ كانَ مُوَدِّعي","وَالجِسمُ أَنَّ الرَوحَ كانَ مُصافِحي",84,"ي",1,0],["وَالصُبحُ في حَلَكِ الدُجى مُتَنَقِّبٌ","وَحُلى الدَراري موشِكٌ أَن يُنهَبا",85,"ب",2,0],["وَالصُبح في مَهوىً سَحي","ق لا يبشِّر بِالطُلوع",86,"ع",1,0],["وَالصَحنُ ياقوتُ دُرٍّ","لِلعَينِ في جِنانِ",87,"ن",1,0],["وَالصِبا مُمتَلِئٌ","حاجَةً وَأَمَلا",88,"ل",2,0],["وَالصُبحُ حَيٌّ في مَشارِقِهِ","وَاللَيلُ يَلفِظُ آخِرَ النَفَسِ",89,"س",1,0],["وَالصُبحُ يَتلو المُشتَري فَكَأَنَّهُ","عُريانُ يَمشي في الدُجى بِسِراجِ",90,"ج",1,0],["وَالصُدغُ قَد صَدَّ عَن مَحاسِنِهِ","كَصَولَجانٍ يَرُدُّ ضَربَتَه",91,"ت",2,0],["وَالصُدقُ لا يُعرَفُ مِن غُرابِها","كَغادَةٍ عَزَّت عَلى طُلّابِها",92,"ب",3,0],["وَالصُبحُ مِن تَحتِ الظَلامِ كَأَنَّهُ","شَيبٌ بَدا في لِمَّةٍ سَوداءِ",93,"ا",2,0],["وَالصَّفِيَّيْنِ تَوْأَمِ الفضل سَعْدٍ","وسَعِيدٍ إنْ عُدَّتِ الأصْفياءُ",94,"ا",2,0],["وَالصَدُّ وَالتَأنيبُ إِلطافُه","وَشِدَّةُ المَنعِ مُواتاتُه",95,"ت",2,0],["وَالصِلالُ الَّتي يَخافُ رَداها","شَرُّها في الرُؤوسِ وَالأَذنابِ",96,"ب",1,0],["وَالصَمتُ يَلزَمُهُ الفَتى","مِن بَعدِ ما غَنّى وَشَبَّب",97,"ب",1,0],["وَالصَبرُ حَزمٌ عَلى الرَزايا","وَقَبلَنا فُضِّلَ الصَبورُ",98,"ر",1,0],["وَالصُبحُ قَد غَسَلَ الدُجى بِمَعينِهِ","إِلّا بَقيَّةَ إِثمِدِ الأَشفارِ",99,"ر",1,0],["وَالصَقرُ يَلبَسُ إِن طالَ المَدى هَرَماً","حَتّى إِذا مَرَّ بَينَ الهاتِفاتِ تَفِر",100,"ر",1,0],["وَالصائِبونَ يُعَظَّمونَ كَواكِباً","وَطِباعُ كُلٍّ في الشُرورِ حَبائِسُ",101,"س",1,0],["وَالصَخرُ يَلبَثُ لا يُقارِفُ مَرَّةً","ذَنباً وَلا هُوَ مِن حَياءٍ مُطرِقُ",102,"ق",1,0],["وَالصَمتُ أَحجى وَأَحرارُ الكَلامِ لَها","فَض