 أقطاره",128,"ر",2,0],["والصبيحات كاليتامى الحزانى","والليالي كأمهات اليتامى",129,"م",2,0],["والصبابات الظوامي حولنا","تشرب اللّحن فيهتاج الأورام",130,"م",1,0],["والصبحُ رُدِّيه لَمبْسِمه","شَرِقاً وبالعبرات مُختنِقاً",131,"ق",2,0],["والصاعدينَ إلى المشانق مثلما","ارتَقتِ النُّسورُ إلى السماءِ صواعدا",132,"د",2,0],["والصادِعونَ بما يَرى مُستعمِرٌ","فهُمُ متى يأمرْهُمُ خُدّام",133,"م",1,0],["والصبحُ ما زال مُصفرّاً لمقرّنَهِ","في الحُسْن بالليل يُزجي نحوه العتبا",134,"ب",2,0],["والصابرينَ الواهبينَ نُفوسَهُمْ","والمُخجِلينَ بها الكريمَ الواهبا",135,"ب",2,0],["والصِّيدُ مِنْ أوْدِ بنِ صَعْبٍ، إنّهُمْ","باتُو عَلَيْكَ حَوَادِثاً، وَخُطُوبا",136,"ب",2,0],["والصبحُ يرفعُ كفاً من لاقطة","ً ما للدراري على الآفاق من دُرَرِ",137,"ر",1,0],["والصّوت من نعم السّما ولم تكن","ترضى السّما إلاّ عن الصّلاح",138,"ح",1,0],["والصوت من نعم السماء ولم تكن","ترضى السما إلا عن الصدّاح",139,"ح",1,0],["والصّدقُ يألفُهُ الكريمُ المرتجى","والكذبُ يألفه الدَّنئُ الأَخيَبُ",140,"ب",1,0],["والصَّمتُ يقطعُهُ رَنينُ سَلاسِلٍ","عَبَثَتْ بِهِنَّ أَصابعُ السَّجَّانِ",141,"ن",1,0]]}