{"poems":[[65,"تأملت الورى جيلا فجيلا","https://www.aldiwan.net/poem46180.html","الوافر"],[23,"هل رسم دارسة المقام يباب","https://www.aldiwan.net/poem21246.html","الكامل"],[46,"أما الرسوم فقد أذكرن ما سلفا","https://www.aldiwan.net/poem30404.html","البسيط"],[35,"شكوت إلى سرب القطا إذ مررن بي","https://www.aldiwan.net/poem25928.html","الطويل"],[173,"منال العلى بالمرهفات القواضب","https://www.aldiwan.net/poem1601.html",""],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[208,"أعاذل حسب المرء بالشيب عاذلا","https://www.aldiwan.net/poem53155.html","الطويل"],[248,"إني على رغم الوشاة لقائل","https://www.aldiwan.net/poem2053.html","الكامل"],[266,"ألم بنا يختال غير ملوم","https://www.aldiwan.net/poem38190.html","الطويل"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[385,"غلام كما سال في خده","https://www.aldiwan.net/poem48794.html","المتقارب"],[409,"مرحبا يا مرحبا يا مرحبا","https://www.aldiwan.net/poem34127.html","الرمل"],[447,"هذي نهاية وقع الحادث الجلل","https://www.aldiwan.net/poem14475.html","البسيط"],[463,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[469,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[543,"بهبركل قلبي تعلق ليت لي","https://www.aldiwan.net/poem47917.html","عموديه"],[563,"لنور عين الوجود أعيان","https://www.aldiwan.net/poem33781.html","المنسرح"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53920","السريع"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96727","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96672","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78169","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122074","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49592","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109369","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104951","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65138","البسيط"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131898","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117879","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4679,"ألا أهنأ أيها الصرح المشيد","https://www.poetsgate.com/ViewPoem.aspx?id=142721",""],[4767,"نبع الإيثار","https://www.poetsgate.com/ViewPoem.aspx?id=197294",""],[4802,"صوتك بعيد","https://www.poetsgate.com/ViewPoem.aspx?id=34384",""],[4578,"بأفق العز أشرق بدرُ سعدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49395",""],[4935,"زهر غصون الأنس في روض الهنا","https://www.poetsgate.com/ViewPoem.aspx?id=129434",""],[4984,"ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=178841",""],[5411,"النَّقْشُ اليَمانِي","https://www.poetsgate.com/ViewPoem.aspx?id=186271",""],[5582,"أَلا عُجْ بِالمَطِيِّ عَلَى المُقامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63580",""],[192,"نبض الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=16352",""]],"verses":[["بهِ بَعدَ الإلهِ بَلَغْتُ شأواً","يُسارِقُهُ السُّها نَظَراً كَليلا",0,"ل",2,0],["بِهُبوبِ مُعصِفَةٍ تُفَرِّقُ جَمعَهُم","وَجُنودِ رَبِّكَ سَيِّدَ الأَربابِ",1,"ب",1,0],["بِهِ بَسَطتَ الخُطا فَاِسحَنفَرَت رَتَكاً","إِلى الجِلادِ وَكانَت قَبلَهُ قُطُفا",2,"ف",2,0],["بِهِ بَقَرٌ لا يَبرَحُ الدَهرَ ساكِناً","وَآخَرُ وَحشِيُّ السِخالِ يَثورُ",3,"ر",1,0],["بِهِ بَلَغوا آمالَهُم وَمُناهُمُ","وَحَلّوا مِنَ العَلياءِ أَعلى المَراتِبِ",4,"ب",1,0],["بهِ بلَغَ الشيطانُ في الدين قصدهُ","وَقَطّبَ وَجهَ الحقِّ والباطلُ اِفترّا",5,"ر",2,0],["بهِ بَرَزَت حسناء في شرّ مَنبتٍ","كَما نَبتَت في الدمنةِ البقلةُ الخضرا",5,"ر",2,0],["به بسط الرحمنُ في الخلق رحمةً","وخصَّ اليتامى منهمُ والأرامِلا",6,"ل",2,0],["به بَرَدٌ صافي الجَنوب تمدُّهُ","بَناتُ مخاضِ المُزنِ أَبيضُ مُنزَلُ",7,"ل",1,0],["به بلغت شهباؤنا الشهب رفعة","ممنعة عن مارد ورجيم",8,"م",1,0],["بِهِ بَدا اللَهث مِن أَنوارِ مَظهَرُهُ","وَمِن قَديمٍ قَضى تَكوينُ جَوهَرِهِ",9,"ه",1,0],["بِهِ بَردٌ جامد كَم أَذا","بَ قَلباً يُتوق إِلى وَردِهِ",10,"د",2,0],["بهبات صيرت ما وهبت","كل كف غير كفيه هبا",11,"ب",2,0],["به بليت كل الأنام بها","لم تلق ذا نسمة إلا بتلك بلي",12,"ل",2,0],["بِهبةِ الله يستدلّ ال","روَّادُ منها على الحسينِ",13,"ن",1,0],["به بلغنا الأمانيَّ التي بعدتْ","عفواً وصدقَ رجمُ الظنِ والأمل",14,"ل",1,0],["بِهَبركَلٍ قلبِي تعلَّقَ لَيتَ لي","منهُ وِصالُ لُحَيظَةٍ تَكفيني",15,"ن",2,1],["به به عين ذاك ذاك له","وصوت طير الغناء عيدان",16,"ن",1,0],["به بدا الحقُّ بها مُشْرِقاً","وأمرُه منعقِدٌ مبرَمُ",17,"م",1,0],["بهِ بينَ السلام يلوحُ منه","سماة كالوحيّ على السلامِ",18,"م",1,0],["بهِ بكرَت يومَ النوى منه بزّل","تَبوعُ الفلا في سيرِها وتقيسُ",19,"س",1,0],["بِهِ بَشَرتَنا طَلعة قادِرية","كَما بِبزوغ الشَمس بَشرنا الفَجرُ",20,"ر",1,0],["بِهِ بَشَّر الانْجِيلُ عِيسَى بْنَ مَرْيَمٍ","وَبَشَّرَتِ التَّوْرَاةُ مُوسَى بْنَ عِمْرَانِ",21,"ن",1,0],["بِهِبَاتٍ أوْلَيْتَنِيهَا جِسامٍ","كَفْكَفَتْ غَرْبَ كلِّ خَطْبٍ جسيم",22,"م",1,0],["بهِ بلغت هذي القصيدةُ حظها","ولاح عليها من سناه قبول",23,"ل",1,0],["به بشَّرَ الإِنجيل والصُّحفُ قبلَهُ","وإن حاول الإخفاء للحقّ ملحد",24,"د",1,0],["به برغم الأعادي قد بلغت مني","هُم منهُ كلّ بسمر الخطّ مطعُونُ",25,"ن",1,0],["بِهِ بَلَدُ الزُّبَير تَجُرُّ فخراً","وَيَكفيها مِن العَليَا فخَارا",26,"ر",2,0],["به به تضرب الأمثال إن برزت","راياته واصطفى من جيشه العربا",27,"ب",2,0],["بهِ بشرَ الحبيبُ وهو مبينٌ","لتبشيرِ مولاهُ وما الشمسُ تُكتمُ",28,"م",1,0],["بهبتهم عذبات القوانس","تلاقت تموج بهام القوامس",29,"س",1,0],["به بيروت قد تاهت وباهت","وصوب العدل بات بها يجود",30,"د",1,0],["به بترَ الباغين كفاًّ وهامةً","وهدَّ لهم في الطف حصناً ومرصدا",31,"د",2,0],["به بنت مجروحه وبه شاب مجروح","توحدوا من دون قصد وكلافه",32,"ف",2,0],["به بيروت بالإقبال تزهو","ويبسم ثغرها عن دُّر عقدِ",33,"د",1,0],["به بشائر السرور أقبلت","وسر إسعاد المعالي أعلنا",34,"ن",2,0],["به بلغوا شأوا من العز وانجلوْا","بعزم لنصر مثلما جد أنصار",35,"ر",1,0],["بِهِ بَلْقيس قَدْ خاضَتْ حُروبًا","مُتَوَّجَة لَها بَأْسٌ شَديدُ",36,"د",1,0],["بِهِ بَيْنَ السِّلامِ تَلُوحُ مِنْهُ","سِماتٌ كالوَحِيِّ عَلَى السِّلامِ",37,"م",1,0],["به بشر ينسى صلفها ان كل من راح iiراجع","وبه بشر تنطر اجلها ترتجي ذاك iiالرجوع",38,"ع",1,0]]}