{"poems":[[65,"أتروى وقد صدح الجندب","https://www.aldiwan.net/poem46138.html","المتقارب"],[65,"بدا والثريا في مغاربها قرط","https://www.aldiwan.net/poem46211.html","الطويل"],[90,"متى نرجو لغمتنا انكسافا","https://www.aldiwan.net/poem44828.html","الوافر"],[90,"أجدك يا كواكب لا ترينا","https://www.aldiwan.net/poem45071.html","الوافر"],[53,"إذا ما مدحت أبا صالح فأعدد له الشتم","https://www.aldiwan.net/poem9393.html","المتقارب"],[53,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[53,"أبا حسن قد قلت لو كان فعال","https://www.aldiwan.net/poem65941.html","الطويل"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[53,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[53,"سهاد أخي البلوى حقيق به السهو","https://www.aldiwan.net/poem66707.html","الطويل"],[31,"أعاذلتي اليوم ويحكما مهلا","https://www.aldiwan.net/poem6068.html","الطويل"],[64,"عليك أقمت أرسال الكلام","https://www.aldiwan.net/poem52266.html","الوافر"],[63,"وركب أمموا قحطا","https://www.aldiwan.net/poem51576.html","الهزج"],[35,"ألا ليت ليلى أطفأت حر زفرة","https://www.aldiwan.net/poem25944.html","الطويل"],[21,"لك الحمد والنعماء والملك ربنا","https://www.aldiwan.net/poem36236.html","الطويل"],[69,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[48,"لزينب يحلو جني أمر","https://www.aldiwan.net/poem22745.html","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[119,"الا يا من به يجلى الظلام","https://www.aldiwan.net/poem40599.html","عموديه"],[147,"علي لها أن أحفظ العهد والودا","https://www.aldiwan.net/poem11743.html","الطويل"],[147,"أما ومساع لا نحيط لها عدا","https://www.aldiwan.net/poem11755.html","الطويل"],[147,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[147,"سما بك دهرك فليفتخر","https://www.aldiwan.net/poem11765.html","المتقارب"],[154,"أصبت من الحساد أنفذ مقتل","https://www.aldiwan.net/poem68600.html","الطويل"],[154,"خليلي عجابا لمحصب وانزلا","https://www.aldiwan.net/poem68605.html","الطويل"],[164,"بجود يديك أورقت الغصون","https://www.aldiwan.net/poem59070.html","الوافر"],[169,"نأت سلمى وأمست في عدو","https://www.aldiwan.net/poem719.html",""],[240,"سقاها الحيا من أربع وطلول","https://www.aldiwan.net/poem31789.html","الطويل"],[275,"أعيناك حينا ترنوان إلى الزهر","https://www.aldiwan.net/poem35619.html","الطويل"],[302,"سرت موهنا والنجم في أذنها قرط","https://www.aldiwan.net/poem33231.html","الطويل"],[302,"سلام على رب الفضائل والعلى","https://www.aldiwan.net/poem33337.html","الطويل"],[310,"هناء به الأيام تمحى وتنسخ","https://www.aldiwan.net/poem56580.html","الطويل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[325,"حنانا أخلائي فقد شفني البعد","https://www.aldiwan.net/poem67159.html","الطويل"],[333,"أعيش أم أدع الأيام للناس","https://www.aldiwan.net/poem55006.html","البسيط"],[412,"عفى طلل بالرامتين ومنهج","https://www.aldiwan.net/poem50196.html","الطويل"],[422,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[445,"بقاء الخلائق رهن الفناء","https://www.aldiwan.net/poem34882.html","المتقارب"],[463,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104603","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104588","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37865","الطويل"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/138854",""],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59674","المتقارب"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59719","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93094","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80022","المتقارب"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110697","الوافر"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109320","الوافر"],[2164,"","https://poetry.dctabudhabi.ae/diwan/poem/101862","الطويل"],[2354,"","https://poetry.dctabudhabi.ae/diwan/poem/145231","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60877","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76055","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115690","الوافر"],[240,"","https://poetry.dctabudhabi.ae/diwan/poem/13110","الوافر"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67987","الطويل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82835","الطويل"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103622","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48437","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117884","الوافر"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85236","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59516","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119603","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119632","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127107","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123490","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94375","الطويل"],[5052,"يا جنّة العمر","https://www.poetsgate.com/ViewPoem.aspx?id=205270",""],[1021,"تبدى يملأ الناظر","https://www.poetsgate.com/ViewPoem.aspx?id=47834",""],[5376,"ظلامٌ كلما ازدادَ اشتدادا","https://www.poetsgate.com/ViewPoem.aspx?id=203596",""]],"verses":[["وأنّى يُساميهِ ذو مَحْتِدٍ","مَضارِبُ أعْراقِهِ تُؤشَبُ",0,"ب",1,0],["وأنَّى يكونُ المُلتَقى عِندَ غايةٍ","وأنتَ غداةَ السَّبْقِ تَعلو ويَنْحَطُّ",1,"ط",1,0],["وأنّى يُصلح الأوطان قوم","بها أشتى تدابُرهم وصافا",2,"ف",2,0],["وأنَّى يدرك الرائي مداها","وإن ألقى لها نظرًا شفونا؟!",3,"ن",2,0],["وأنَّى يجود ولا عِرْقُهُ","كريم ولا وجهُه بالصَّبيحِ",4,"ح",1,0],["وأنَّى يناوي من يصاول قرنهُ","بقرن يُظِل الجيش والجيش مُظهر",5,"ر",1,0],["وأنَّى يُرَى للَّهِ إهمالُ مُفسدٍ","وأنى يُرى للفضل في الناس أفضالُ",6,"ل",1,0],["وأنَّى يُسمَّى ملْطماً وهو ملثمٌ","فدى حُسْنَه من ذاك خَدٌّ مُلَطَّمُ",7,"م",1,0],["وأنَّى يكونُ المنكرُ الجُرْمَ عادلاً","إذا ما استوت أحكامُهُ والجرائمُ",8,"م",1,0],["وأنّى يُرَى ذو اللُّب مالكَ صبوةٍ","إذا لم ينلْهُ مِنْ أحبته العفوُ",9,"و",1,0],["وَأَنِّيَ يَوماً لا مُضيعٌ ذِمارَها","وَلا مُفلِتي هاجٍ هَجا تَغلِباً بُطلا",10,"ل",2,0],["وأنَّى يُستنام إِلى مجيبٍ","يُناصحُ بعدما كَذَبَتْ حَذامِ",11,"م",1,0],["وأنَّى يَفْعَلُ الخَيْرَ","فتى نِصفُ اسمِه قَحطُ",12,"ط",1,0],["وَإِنّي يَمانِيُّ الهَوى مُنجِدُ النَوى","سَبيلانِ أَلقى مِن خِلافِهِما جَهدا",13,"د",2,0],["وَأنَّى يَكونُ الخَلقُ كَالخالِقِ الَذي","يَدومُ وَيَبقى وَالخَليقَةُ تَنفَدُ",14,"د",1,0],["وأَنى يهتدي للرُّشدِ عاصٍ","لِغارِبِ كلِّ مَعصِيَةٍ ركوبُ",15,"ب",1,0],["وَأَنّي يُرَجَّونَ غَمرَ الهُدى","وَقَد غَرِقوا في جِمامِ الغُمَر",16,"ر",1,0],["وأنّى يمدُّ ابنُ القوافي جَناحَهُ","إلى رقمةٍ شمَّاءَ أعجزتِ العُصْما",17,"م",2,0],["واني يا عريق الجاه عبد","اخو ضعف متاعبه جسام",18,"م",1,0],["وَأَنّى يَهُمُّ الأَولِياءُ بِطَيِّها","وَلَم يَجِدِ الأَعداءُ مِن نَشرِها بُدّا",19,"د",2,0],["وَأَنّى يَرومونَ المَحامِدَ ضِلَّةً","وَما صَدَقوا فيها وَعيداً وَلا وَعدا",20,"د",2,0],["وَأَنّى يُجاريكَ العَلاءَ مُعَظَّمٌ","يُعَظِّمُ مِن شَأنِ العُلى ما تُصَغِّرُ",21,"ر",1,0],["وَأَنّى يُسامي سَحابَ السَما","ءِ في الأَرضِ مِنهُ الحَيا المُنهَمِر",22,"ر",1,0],["وَأَنّى يَغيبُ القَلبُ قُدِّسَ بِالشَرحِ","ضَرَبنا بِهِ اليافوخَ مِن كُلِّ مُلحِدٍ",23,"د",1,0],["وَأَنّي يُدانى في المَكانِ الَّذي اِعتَلى","أَتَمُّ الوَرى جاهاً وَأَبهَرُهُم حُلى",24,"ل",2,0],["وإني يا أبا العباس عبد","لكم رق بحبكم يدين",25,"ن",1,0],["وإني يوم غمرة غير فخر","تركت النهب والأسرى الرغابا",26,"ب",2,0],["وَإِنِّيَ يا تاجَ المُلوكِ لَواثِقٌ","بِسَيبِ عَطاءٍ مِن نَداكَ جَزيلِ",27,"ل",1,0],["وأنَّى يفوزُ الحرُّ بالمجدِ والغِنى","وحوليهِ أصحابُ الخساسةِ والمكر",28,"ر",1,0],["وأَنّى يضاهيها الحسانُ وإنَّما","لَها تسعُ أَقساطِ البَها ولهم قِسطُ",29,"ط",1,0],["وأَنّى يُوازي الشُكرَ إِحسانُ مُنعمٍ","يمنُّ بلا مَنٍّ وَيولي بلا أَذى",30,"ا",1,0],["وَأَنّى يَرى وجه السياسةِ داجنٌ","مَداهُ منَ الأرضِ البسيطة فرسخُ",31,"خ",1,0],["وَأنّى يريغ الشعر فكر جناحه","بمقراض إعراض المريش له جبّا",32,"ب",2,0],["وَأَنّى يَكونُ السُخطُ يَنتَظِرُ الرِضا","وَمَهما يَكُن جَزرٌ سَيَعقِبُهُ مَدُّ",33,"د",1,0],["وإن يئستُ فلي في النار منزلةٌ","كأنَني قاتل ألفاً من الناس",34,"س",1,0],["وَأَنّي يَطيقُ الدَهر إِذ حَشَّ مَن رَجا","بِظِلِّ أَبي الذَوّادِ يَزهى وَيَهدُجُ",35,"ج",1,0],["وأنَّى يرتجي الَّلاحي سلُوِّي","وقد ذابت حشاشتي انسلالا",36,"ل",2,0],["وأَنَّى يُدافَعُ سُقمٌ بسُقمٍ","وَكَيْفَ يُعالَجُ داءٌ بداءِ",37,"ا",2,0],["وأني يومَ أمدحُه احتسابا","وإن أسميتُه فسواه أَعني",38,"ن",2,0],["وأنَّي يغيضُ الماءُ والعينُ غمرةٌ","ويخفى لهيبُ النارِ والنارُ تلفحُ",39,"ح",1,0],["وأني يستةي شمس وبدرٌ","ومنها يستمدُّ ويستنيرُ",40,"ر",1,0],["وَأَنّى يَصحُّ الجسمُ وَهوَ عَليلُها","وَأَين نَعيمُ القَلبِ وَهوَ يعذِّبُ",41,"ب",1,0],["وإني يا عليُّ رهينُ دهرٍ","وبي من وقع أنيُبِهِ كُلُوم",42,"م",1,0],["وأنى يُضاهي يَراعٌ له","إذا جال جولة شهم بطل",43,"ل",1,0],["وإني يوم الأمن أسدى مكارماً","تضيق بها الأقطار والطول والعرض",44,"ض",1,0],["وأنى يضاهي مرقداً ضم علةً","بها كل معلول من الله سببا",45,"ب",2,0],["وأنّى يزاول نملُ القرى","جبالَ شروري فتخشى زيالا",46,"ل",2,0],["وأنى يمكن التصريح باسم","بأعلى العرش خطته العنايه",47,"ا",3,0],["وَإِنّي يا أُمَيمَ لَيَجتَديني","بِنُصحَتِهِ المُحَسَّبُ وَالدَخيلُ",48,"ل",1,0],["واني يهتدى للحق يوماً","فتىً ابليس اصبح مستشاره",49,"ر",2,0],["وأنّى يضاهي من له الذات صورت","من الفضل بل من ذاته صور الفضل",50,"ل",1,0],["وأنى يدوم العهد والود بينه","وبين أخ في كل ذنب يناقشه؟",51,"ه",1,0],["وأني يلقى يداه الألفُ مُبْتَسِمَا","والأَلف تاتيه أضيافا فيقريها",52,"ي",3,0],["وَأَنّى يُضاهي واحدٌ عشرَ أَنمُلٍ","تُمَدُّ مِن البَحرِ الخِضَمِّ نَوافِلُه",53,"ل",2,0],["وإنى يا قريبا من عياني","ومن قلبي إذا دام الوصال",54,"ل",1,0],["وَإِنّي يا أَبا حَسَنٍ مُشيرٌ","عَليكَ بِما عَلى نَفسي أُشيرُ",55,"ر",1,0],["وأنَّى ينال الصفحَ من كَانَ مجرِماً","كما عَظُمتْ ذنباً رِيامٌ وأَجْرَمُوا",56,"م",3,0],["وَأَنّي يُرَجّى البُرءُ مِمَّن بِجَهلِه","غَدا الداءُ أَدواءً عَلَيَّ تَثورُ",57,"ر",1,0],["وأني يجاريكم إلى المجد حاسد","جهول بأسرار العلى غير عالم",58,"م",1,0],["وأنّى يخيبُ القَصْدُ والأكْرَم الذي","يجودُ بما شاءَ العُفاةُ ويُنْعِمُ",59,"م",1,0],["وأني يطمع العشّاق فيها","ودون مزارها الآمال خيّب",60,"ب",1,0],["وإنّى يحوط الملك إلّا سميدع","يخوض لظى الهيجاء ليس بهائب",61,"ب",1,0],["وأنىّ يرجع التسآلَ ربعٌ","عفَتَه كلُّ ساهكةٍ هَتونِ",62,"ن",1,0],["وَأَنِّيَ يَومَ الطِعانِ أُرى","إِذا التَحَمَ النَقعُ صَدَرَ السُرى",63,"ر",2,0],["وإنّي يا كرام لمن سراة","لهم دان المسالِمُ والمعادي",64,"د",2,0],["وأني يستطاع منال شهمٍ","له نسب إلى الفاروق شاعا",65,"ع",2,0],["وانى يتدي مدحي حليا","لمن لم يرتض الجوزاء عقدا",66,"د",2,0],["وأنى يرى السلوان جفن جفا الكرى","وطرف لفرط الشوق هاطله سح",67,"ح",1,0],["وأَنّي يصدُّ اللَه سؤلا لأُمهِ","فحاشا بأن الصدَّ يختال بالفكرِ",68,"ر",1,0],["وإن يئستُ من الأيّام روّحني","بروحهِ الغضِّ بل في راحهِ العذبِ",69,"ب",1,0],["وأنّى يفر الوفر","لخرق جوده وافر",70,"ر",1,0],["وأنَّى يطفئون سراجَ دينٍ","وقد دخلوا بدينكم اجتهادا",71,"د",2,0]]}