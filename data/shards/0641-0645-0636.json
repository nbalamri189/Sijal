{"poems":[[53,"لله ثم لك المحل الأعظم","https://www.aldiwan.net/poem29795.html","الكامل"],[53,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[63,"خدع المنى وخواطر الأوهام","https://www.aldiwan.net/poem46123.html","الكامل"],[86,"طمع ألقى عن الغرب اللثاما","https://www.aldiwan.net/poem10683.html","الرمل"],[35,"لعزة من أيام ذي الغصن هاجني","https://www.aldiwan.net/poem39088.html","الطويل"],[93,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[93,"لو كان مما ربك عاصم","https://www.aldiwan.net/poem11333.html","الكامل"],[93,"أصول الضاد طيبة الأروم","https://www.aldiwan.net/poem11416.html","الوافر"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[51,"زلقت في سلاحها","https://www.aldiwan.net/poem65472.html","مجزوء الخفيف"],[51,"عسرت علينا دعوة السمك","https://www.aldiwan.net/poem65756.html","أحذ الكامل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[91,"وحلمت ثانية وكان الكون لم تبرح","https://www.aldiwan.net/poem8728.html","عموديه"],[91,"نظرت دودة تدب على الأرض","https://www.aldiwan.net/poem8792.html","عموديه"],[91,"زعم المؤدب أن عيرا سائه","https://www.aldiwan.net/poem62774.html","عموديه"],[92,"أين يا شعب قلبك الخافق الحساس","https://www.aldiwan.net/poem38915.html","الخفيف"],[89,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[89,"نطقت حشاشة محسن تتبرم","https://www.aldiwan.net/poem44897.html","الكامل"],[89,"إن تأييد نهضة العلم مجد","https://www.aldiwan.net/poem44933.html","الكامل"],[89,"كذب الرجاء فما نجيب يرجع","https://www.aldiwan.net/poem44935.html","الكامل"],[85,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[85,"لكم في الخط سياره","https://www.aldiwan.net/poem7918.html","الهزج"],[85,"كان ابن داود يقر","https://www.aldiwan.net/poem8016.html","مجزوء الكامل"],[85,"نظر الليث إلى عجل سمين","https://www.aldiwan.net/poem8041.html","الرمل"],[43,"اليوم عهدكم فأين الموعد","https://www.aldiwan.net/poem9534.html","الكامل"],[45,"أجدر وأخلق أن ترن عوائدي","https://www.aldiwan.net/poem63548.html","الكامل"],[61,"ردي الخيال يجد معنى واجدا","https://www.aldiwan.net/poem51370.html","الكامل"],[97,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[97,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[80,"وأبيض ماض لا يقي من غراره","https://www.aldiwan.net/poem31413.html","الطويل"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[44,"لو أن دهرا رد رجع جواب","https://www.aldiwan.net/poem30590.html","الكامل"],[69,"برية بحرية حزنية","https://www.aldiwan.net/poem29299.html","الكامل"],[31,"عاود القلب يا لقومي سقما","https://www.aldiwan.net/poem41338.html","الخفيف"],[105,"خلوا سبيل الشاعر المتدفع","https://www.aldiwan.net/poem42071.html","الكامل"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[105,"ما للسيوف أما تثوب فتعطف","https://www.aldiwan.net/poem44198.html","الكامل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[46,"أكتم حديثك عن أخيك ولا تكن","https://www.aldiwan.net/poem22483.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85549","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85295","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39634","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39543","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39553","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16692","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55067","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54643","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67336","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""]],"verses":[["فَمَضى وَأَعقَبَ بَعدَهُ مُتَيَقِّظاً","سِجلاهُ بوسى في الزَمانِ وَأَنعُمُ",0,"م",1,0],["فَمُضطَرِبٌ في غَرزِهِ مُتَرَنِّحٌ","وَآخَرُ مَكبوبٌ عَلى الرَحلِ ساجِدُ",1,"د",1,0],["فمضى وقَدْ أصْحَبْتُهُ سيّارةً","كالرّوضِ يضْحَكُ منْ بُكاءِ غَمامِ",2,"م",1,0],["فَمَضى غَيرَ بَعيدٍ وَاِنثَنى","يَحمِلُ الأَنباءَ شُؤماً وَاِنهِزاما",3,"م",2,0],["فَمَضا لِلنَوى لا بارَكَ اللَهُ في النَوى","وَعَهدُ النَوى عِندَ المُحِبِّ ذَميمُ",4,"م",1,0],["فَمَضَى وَمَا لِبَنِيهِ إرثَ غَيْرَ مَا","وَرِثُوهُ مِنْ ضَعْفٍ وَمِنْ حِرْمَانِ",5,"ن",1,0],["فَمَضَيْتَ لا مَنْ عَاشَ بَعْدَكَ غَانِمٌ","رَهْنَ الْعَذَابِ وَلا شَبَابَكَ غَارِمُ",6,"م",1,0],["فَمِضْمَارٌ مَضَى فِيهِ حُسَيْنٌ","مَضَاءَ المَقْدِمِ الدَّرِبِ العَزُومِ",7,"م",1,0],["فَمَضَينا فَقَضَينا ناجِحاً","مَوطِناً يُسأَلُ عَنهُ ما فَعَل",8,"ل",1,0],["فَمَضى وَضاحي الماءِ فَوقَ لَبانِهِ","وَرَمى بِها عُرضَ السَرِيِّ يَعومُ",9,"م",1,0],["فَمَضى وَقَدَّمَها وَكانَت عادَةً","مِنهُ إِذا هِيَ عَرَّدَت إِقدامُها",10,"م",3,0],["فمضت تقصد الصرا","ة وفيها تكسُّف",11,"ف",1,0],["فمضى وأحوجَنا إلى خلفٍ","من سيِّدٍ كالبدرِ في الفلك",12,"ك",1,0],["فمضى بادئاً ومعناه خافٍ","غيرَ رُعبٍ يصولُ كلَّ مَصالِ",13,"ل",1,0],["فَمَضَت تُحَلِّقُ في الفَضاءِ وَلَم تَزَل","حَتّى وَهَت فَهَوَت إِلى الغَبراءِ",14,"ا",2,0],["فَمَضَت تَشتَكي إِلى الوَرَقِ الساقِطِ","في الحَقلِ أَنَّها لَم تُجَنَّح",15,"ح",1,0],["فَمَضى فَقَصَّرَتِ القَواطِعُ ذَيلَهُ","وَسَطَت مَواضيها عَلى الآذانِ",16,"ن",1,0],["فمضى يَنْشُدُ السَّلامَ بعيداً","في قبورِ الزَّمانِ خَلْفَ هضابِهْ",17,"ه",1,0],["فمضى العندليب في شدده","غير مبال بقول ذاك البليد",18,"د",1,0],["فمضى يعج وراء موكب نعشه","جيش من المتفجعين عرمرم",19,"م",1,0],["فمضى العلم واستقرَّ مكان ال","علم جهل والجهل للعلم ضد",20,"د",1,0],["فمضى ومرَّت حجتان ولم يجئ","منه كتاب للكآبة يدفع",21,"ع",1,0],["فمضى دعاة بالقضية نُهَّض","وأتى دعاة يحملون عناءها",22,"ا",3,0],["فَمَضروبٌ بِرَشّاشٍ","وَمَقلوبٌ بِغَدّارَه",23,"ر",2,0],["فَمَضَت إِلى عُمّالِهِ","يَوماً تُبَلِّغُهُم سَلامَه",24,"م",2,0],["فَمَضى الخِلّانِ تَوّاً لِلفَلاه","ذا إِلى المَوتِ وَهَذا لِلحَياه",25,"ه",1,0],["فَمَضَت وَقَد صَبَغَ الحَياءُ بَياضَها","لَوني كَما صَبَغَ اللُجَينَ العَسجَدُ",26,"د",1,0],["فَمَضَوا عَلى غِلِّ الصُدورِ فَغودِروا","مِثلَ الهَشيمِ لِخابِطٍ وَلِصائِدِ",27,"د",1,0],["فمضى ولو حمد آمرؤ لصيامه","وقيامه أهدى إليك محامدا",28,"د",2,0],["فمضيتُ لا أدري إلى أينا","ومشيت حيث تجرّني قدمي",29,"ي",1,0],["فمضيتُ توّاً قلت سيدتي","زنتِ المراقص أيَّما زين",29,"ن",1,0],["فمضى منحدراًللنهر","ناضب الزاد وما من سفر",30,"ر",1,0],["فَمَضْرِبُهُ في هامةِ القرن مَأتَمٌ","وَمَضْرِبُهُ في كَفِّ صاحِبِهِ عُرْسُ",31,"س",1,0],["فَمَضى لَو اَنَّ النارَ دونَكَ خاضَها","بِالسَيفِ إِلّا أَن تَكونَ النارُ",32,"ر",1,0],["فَمَضَت كُهولُهُمُ وَدَبَّرَ أَمرَهُم","أَحداثُهُم تَدبيرَ غَيرِ صَوابِ",33,"ب",1,0],["فمضيَّةٌ وسنيَّةٌ ونديَّةٌ","أرجاؤُها ورياضُها وقصورُها",34,"ر",3,0],["فَمَضى نَحوَها بِعَقلٍ وَحَزمٍ","وَاِحتِيالٍ وَنُصحِ حُبٍّ فَلَمّا",35,"م",2,0],["فمَضى يخوضُ إليه كُلَّ مَخوفةٍ","غبراءَ تعصِفُ بالكميِّ الأروعِ",36,"ع",1,0],["فمضى يقولُ ألا ذِمَامٌ لامرئٍ","يَبْغِي الفِرارَ بدينهِ يَستَعْصِمُ",37,"م",1,0],["فمضى على أسفٍ يلوذُ بعمّهِ","فُيلامُ غيرَ مكذَّبٍ ويُعنَّف",38,"ف",1,0],["فَمَضَوا وَصَحبي قائِلو","نَ بِظِلِّ أَهيَفَ ذي مَخايِل",39,"ل",1,0],["فَمَضى يَزيدٌ وَمَخلِدٌ في دَولَةٍ","وَثَنى الزَمانُ إِلى يَزيدَ وَمَزيَدِ",40,"د",1,0],["فَمَضَت تلكم السنون ودائي","ذلك الداء نفسه لا يحول",41,"ل",1,0],["فَمَضى الطيف وَوَلّى هارِباً","وَهوَ لا يَلوي وَلا ينتظر",42,"ر",1,0],["فمضى يحلُمُ نشوانَ طروبا","بحفيدٍ في مراقي البشَرِ",43,"ر",1,0],["فمضت في عتابها كيف لم ند","رِ بما برَّحتْ بك الأتراحُ",44,"ح",1,0],["فمضتْ تصرخُ من أعماقها","أيُّهذا الليلُ نبِّهْ من رقدْ",45,"د",1,0],["فمضَى وخلّفَها تَئِلّ كأنّما","حُبُكُ السماءِ قَتيرُها المَحْبوك",46,"ك",1,0],["فَمَضَى فِي إِنَارَةِ الشَّعْبِ مَا يَسْطِيعُ","وَالشَّعْبُ فِي الظَّلاَمِ غَرِيقُ",47,"ق",1,0],["فَمَضَيتَ فِي تَحْسِينِهَا قُدَماً وَلَمْ","تُحجِمْ عَلى العِلاَّتِ وَالأَخْطَارِ",48,"ر",1,0],["فَمَضَيْتَ مَبْكِيّاً وَمَا يُغْنِيكَ لَوْ","أَنَّ مَلأْنَا الخَافِقِينِ نَحِيبَا",49,"ب",2,0],["فَمَضَى بِأَحْزَنِ مَا يَكُو","نُ أخو الأَسَى وَبِأَجْزعِ",50,"ع",1,0],["فمَضَى فِي غَيِّهِ وَاسْترْسَلَتْ","فِي مَجَالِ الذُّلِّ تَحْبِيذاً وَشُكْرَا",51,"ر",2,0],["فَمَضَى فِي أَيِّ حَشْدٍ حاشِدٍ","يَدَعُ الرَّحْبَ مِنَ السَّاحَاتِ ضَجْرَا",51,"ر",2,0],["فَمَضَوْا أَمَامَ المُسْلِمينَ كَأَنَّهُمْ","فُنُقٌ عَلَيْهِنَّ الحديدُ المُرفَلُ",52,"ل",1,0],["فمضى وبقِيتَ لنا خَلَفاً","من كُلِّ كريم نَفْقِدهُ",53,"د",2,0],["فمضتْ نحوَ مِصرَ مَثْلَ قَطاةٍ","فَزَّعَتْها كَوَاسِرُ العِقْبانِ",54,"ن",1,0],["فَمضَى إلى النَّصرِ المُبينِ مُؤزَّراً","والشَّعبُ يَهتفُ باسْمِه ويُغَالي",55,"ل",2,0],["فمضى شهيدًا؛ ماله","قبر يُزار ولا مَقام",56,"م",1,0]]}