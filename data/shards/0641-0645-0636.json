 الزبيدية في مدح خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=195006",""],[523,"هل لُغْزِي هذا مَفْهُومٌ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=100021",""],[5309,"عاش يهواها ويستوحي جهاده","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573547",""],[5724,"فجعت لفرط فراقك الاخوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55152&r=&rc=19",""],[5724,"هتف الزمان مهللا ومكبرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55143&r=&rc=10",""],[6225,"تسرُّب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78037&r=&rc=122",""],[6229,"الغصن الذاوي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65173&r=&rc=5",""],[6237,"اليتيم السعيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77872&r=&rc=14",""],[6257,"الأسامي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87194&r=&rc=19",""],[6325,"الغياب الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88020&r=&rc=2",""],[5126,"صَدْمَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87817&r=&rc=32",""],[6344,"شعلة من وقود الغياب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87982&r=&rc=22",""],[147,"هَلْ لِلْخَلِيطِ الْمُسْتِقلِّ إِيَابُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27447&r=&rc=14",""]],"verses":[["فَمَضى وَأَعقَبَ بَعدَهُ مُتَيَقِّظاً","سِجلاهُ بوسى في الزَمانِ وَأَنعُمُ",0,"م",1,0],["فَمُضطَرِبٌ في غَرزِهِ مُتَرَنِّحٌ","وَآخَرُ مَكبوبٌ عَلى الرَحلِ ساجِدُ",1,"د",1,0],["فمضى وقَدْ أصْحَبْتُهُ سيّارةً","كالرّوضِ يضْحَكُ منْ بُكاءِ غَمامِ",2,"م",1,0],["فَمَضى غَيرَ بَعيدٍ وَاِنثَنى","يَحمِلُ الأَنباءَ شُؤماً وَاِنهِزاما",3,"م",2,0],["فَمَضا لِلنَوى لا بارَكَ اللَهُ في النَوى","وَعَهدُ النَوى عِندَ المُحِبِّ ذَميمُ",4,"م",1,0],["فَمَضَى وَمَا لِبَنِيهِ إرثَ غَيْرَ مَا","وَرِثُوهُ مِنْ ضَعْفٍ وَمِنْ حِرْمَانِ",5,"ن",1,0],["فَمَضَيْتَ لا مَنْ عَاشَ بَعْدَكَ غَانِمٌ","رَهْنَ الْعَذَابِ وَلا شَبَابَكَ غَارِمُ",6,"م",1,0],["فَمِضْمَارٌ مَضَى فِيهِ حُسَيْنٌ","مَضَاءَ المَقْدِمِ الدَّرِبِ العَزُومِ",7,"م",1,0],["فَمَضَينا فَقَضَينا ناجِحاً","مَوطِناً يُسأَلُ عَنهُ ما فَعَل",8,"ل",1,0],["فَمَضى وَضاحي الماءِ فَوقَ لَبانِهِ","وَرَمى بِها عُرضَ السَرِيِّ يَعومُ",9,"م",1,0],["فَمَضى وَقَدَّمَها وَكانَت عادَةً","مِنهُ إِذا هِيَ عَرَّدَت إِقدامُها",10,"م",3,0],["فمضت تقصد الصرا","ة وفيها تكسُّف",11,"ف",1,0],["فمضى وأحوجَنا إلى خلفٍ","من سيِّدٍ كالبدرِ في الفلك",12,"ك",1,0],["فمضى بادئاً ومعناه خافٍ","غيرَ رُعبٍ يصولُ كلَّ مَصالِ",13,"ل",1,0],["فَمَضَت تُحَلِّقُ في الفَضاءِ وَلَم تَزَل","حَتّى وَهَت فَهَوَت إِلى الغَبراءِ",14,"ا",2,0],["فَمَضَت تَشتَكي إِلى الوَرَقِ الساقِطِ","في الحَقلِ أَنَّها لَم تُجَنَّح",15,"ح",1,0],["فَمَضى فَقَصَّرَتِ القَواطِعُ ذَيلَهُ","وَسَطَت مَواضيها عَلى الآذانِ",16,"ن",1,0],["فمضى يَنْشُدُ السَّلامَ بعيداً","في قبورِ الزَّمانِ خَلْفَ هضابِهْ",17,"ه",1,0],["فمضى العندليب في شدده","غير مبال بقول ذاك البليد",18,"د",1,0],["فمضى يعج وراء موكب نعشه","جيش من المتفجعين عرمرم",19,"م",1,0],["فمضى العلم واستقرَّ مكان ال","علم جهل والجهل للعلم ضد",20,"د",1,0],["فمضى ومرَّت حجتان ولم يجئ","منه كتاب للكآبة يدفع",21,"ع",1,0],["فمضى دعاة بالقضية نُهَّض","وأتى دعاة يحملون عناءها",22,"ا",3,0],["فَمَضروبٌ بِرَشّاشٍ","وَمَقلوبٌ بِغَدّارَه",23,"ر",2,0],["فَمَضَت إِلى عُمّالِهِ","يَوماً تُبَلِّغُهُم سَلامَه",24,"م",2,0],["فَمَضى الخِلّانِ تَوّاً لِلفَلاه","ذا إِلى المَوتِ وَهَذا لِلحَياه",25,"ه",1,0],["فَمَضَت وَقَد صَبَغَ الحَياءُ بَياضَها","لَوني كَما صَبَغَ اللُجَينَ العَسجَدُ",26,"د",1,0],["فَمَضَوا عَلى غِلِّ الصُدورِ فَغودِروا","مِثلَ الهَشيمِ لِخابِطٍ وَلِصائِدِ",27,"د",1,0],["فمضى ولو حمد آمرؤ لصيامه","وقيامه أهدى إليك محامدا",28,"د",2,0],["فمضيتُ لا أدري إلى أينا","ومشيت حيث تجرّني قدمي",29,"ي",1,0],["فمضيتُ توّاً قلت سيدتي","زنتِ المراقص أيَّما زين",29,"ن",1,0],["فمضى منحدراًللنهر","ناضب الزاد وما من سفر",30,"ر",1,0],["فَمَضْرِبُهُ في هامةِ القرن مَأتَمٌ","وَمَضْرِبُهُ في كَفِّ صاحِبِهِ عُرْسُ",31,"س",1,0],["فَمَضى لَو اَنَّ النارَ دونَكَ خاضَها","بِالسَيفِ إِلّا أَن تَكونَ النارُ",32,"ر",1,0],["فَمَضَت كُهولُهُمُ وَدَبَّرَ أَمرَهُم","أَحداثُهُم تَدبيرَ غَيرِ صَوابِ",33,"ب",1,0],["فمضيَّةٌ وسنيَّةٌ ونديَّةٌ","أرجاؤُها ورياضُها وقصورُها",34,"ر",3,0],["فَمَضى نَحوَها بِعَقلٍ وَحَزمٍ","وَاِحتِيالٍ وَنُصحِ حُبٍّ فَلَمّا",35,"م",2,0],["فمَضى يخوضُ إليه كُلَّ مَخوفةٍ","غبراءَ تعصِفُ بالكميِّ الأروعِ",36,"ع",1,0],["فمضى يقولُ ألا ذِمَامٌ لامرئٍ","يَبْغِي الفِرارَ بدينهِ يَستَعْصِمُ",37,"م",1,0],["فمضى على أسفٍ يلوذُ بعمّهِ","فُيلامُ غيرَ مكذَّبٍ ويُعنَّف",38,"ف",1,0],["فَمَضَوا وَصَحبي قائِلو","نَ بِظِلِّ أَهيَفَ ذي مَخايِل",39,"ل",1,0],["فَمَضى يَزيدٌ وَمَخلِدٌ في دَولَةٍ","وَثَنى الزَمانُ إِلى يَزيدَ وَمَزيَدِ",40,"د",1,0],["فَمَضَت تلكم السنون ودائي","ذلك الداء نفسه لا يحول",41,"ل",1,0],["فَمَضى الطيف وَوَلّى هارِباً","وَهوَ لا يَلوي وَلا ينتظر",42,"ر",1,0],["فمضى يحلُمُ نشوانَ طروبا","بحفيدٍ في مراقي البشَرِ",43,"ر",1,0],["فمضت في عتابها كيف لم ند","رِ بما برَّحتْ بك الأتراحُ",44,"ح",1,0],["فمضتْ تصرخُ من أعماقها","أيُّهذا الليلُ نبِّهْ من رقدْ",45,"د",1,0],["فمضَى وخلّفَها تَئِلّ كأنّما","حُبُكُ السماءِ قَتيرُها المَحْبوك",46,"ك",1,0],["فَمَضَى فِي إِنَارَةِ الشَّعْبِ مَا يَسْطِيعُ","وَالشَّعْبُ فِي الظَّلاَمِ غَرِيقُ",47,"ق",1,0],["فَمَضَيتَ فِي تَحْسِينِهَا قُدَماً وَلَمْ","تُحجِمْ عَلى العِلاَّتِ وَالأَخْطَارِ",48,"ر",1,0],["فَمَضَيْتَ مَبْكِيّاً وَمَا يُغْنِيكَ لَوْ","أَنَّ مَلأْنَا الخَافِقِينِ نَحِيبَا",49,"ب",2,0],["فَمَضَى بِأَحْزَنِ مَا يَكُو","نُ أخو الأَسَى وَبِأَجْزعِ",50,"ع",1,0],["فمَضَى فِي غَيِّهِ وَاسْترْسَلَتْ","فِي مَجَالِ الذُّلِّ تَحْبِيذاً وَشُكْرَا",51,"ر",2,0],["فَمَضَى فِي أَيِّ حَشْدٍ حاشِدٍ","يَدَعُ الرَّحْبَ مِنَ السَّاحَاتِ ضَجْرَا",51,"ر",2,0],["فَمَضَوْا أَمَامَ المُسْلِمينَ كَأَنَّهُمْ","فُنُقٌ عَلَيْهِنَّ الحديدُ المُرفَلُ",52,"ل",1,0],["فمضى وبقِيتَ لنا خَلَفاً","من كُلِّ كريم نَفْقِدهُ",53,"د",2,0],["فمضتْ نحوَ مِصرَ مَثْلَ قَطاةٍ","فَزَّعَتْها كَوَاسِرُ العِقْبانِ",54,"ن",1,0],["فَمضَى إلى النَّصرِ المُبينِ مُؤزَّراً","والشَّعبُ يَهتفُ باسْمِه ويُغَالي",55,"ل",2,0],["فمضى شهيدًا؛ ماله","قبر يُزار ولا مَقام",56,"م",1,0],["فمضوا يطعمونا الحقد حتّى","جهل المرء قصده وهو عالم",57,"م",1,0],["فمضى والعناد في مقليته","صارخ ، والجحيم في أحقاده",58,"د",2,0],["فمضى وقد ألهته عما يتقي","من صخرة تردى ويم زاخر",59,"ر",1,0],["فمضوا يسخرون منه وينحون","عليه بألسن الأضغان",60,"ن",1,0],["فمضيت أسأل كل من","لاقيته من عارفيه",61,"ي",2,0],["فمضيت عنك لطيتي","واللّه أَعلم بالطوية",61,"ي",2,0],["فَمَضَت لِطِيَّتِها قَبائِلُ طَيِّئٍ","فَرَقاً وَحَشوُ صُدورِهِم إِرهابُ",62,"ب",1,0],["فَمَضَت ثَلاثٌ مِن سِنينَ أَبَت لَهُم","أَن يَزرَعوا وَنَهَتهُمُ أَن يَهجَعوا",63,"ع",3,0],["فمضى وألبسني السقام وإنما","من كل ما احببته أغراني",64,"ن",2,0],["فمَضَى فيما شَرَعتُ له","مستحِثا غيرَ مُتَّئِدِ",65,"د",1,0],["فمضت حياتي حسرة","وبقيت ظرفا فارغا",66,"غ",2,0],["فَمَضى همّي وَصافاني الصفا","وَأَتى أُنسي وولّى حَزَني",67,"ي",1,0],["فمضى يأنف في سخرية","عيش ذل هو والموت سواء",68,"ا",2,0],["فمضى يتيه تخايلاً","فإذا تلطف يعتذر !",69,"ر",1,0],["فَمَضى الرَّسولُ إِلى سَطيح سائِلاً","فَأَتى الجَوابُ إِلى أَنوشروانِ",70,"ن",1,0],["فَمَضى إِلَيهِ فَحينَ عايَنَ عزَّهُ","أَهوى ذَليلاً ضارِباً بِجرانِ",70,"ن",1,0],["فَمَضَت بِبِرٍّ ثُمَّ ماءٍ وافِر","وَهُدى إِلى قَومٍ ذوي أَوثانِ",70,"ن",1,0],["فَمَضَى يَرحَمُهُ ال","لَه وَأَوصَى بي إلَيهَا",71,"ي",3,0],["فَمَضى الزَمان وَنعته وَصِفاته","من قبل مبعثه بكل كتاب",72,"ب",1,0],["فَمَضى لحاجته وَلَم يرحاجرا","وَالقَوم يَقظى وَالبَصائِر نوّم",73,"م",1,0],["فمضوا وأحياها امام قد سما","ورقى الى أوج المقام الاسعد",74,"د",1,0],["فمضى وغادرني أعالج بعده","حربَ النَّوائب في زمانٍ مُدبر",75,"ر",1,0],["فمضّتْ عليه حين آلما الردى","لتقطَعَه من كرهِ ما تتذوق",76,"ق",1,0],["فمضى علي وجه السبيل ميمما","لمهابط الأنوار من بشار",77,"ر",1,0],["فَمَضى وَفي قَلبي عَلَيهِ حَسرَة","لَو كانَ يُمكِنُني الرِقادُ لَحِقتَهُ",78,"ه",1,0],["فَمَضَت تَزِفُّ أَمامَهُ","نَّ كَما تَوَلّى سَهمُ رامِ",79,"م",1,0],["فمضاؤه كالسيف بل أمضى قضاً","فالسيف أدنى من شبا إمضائه",80,"ا",3,0],["فَمَضى أَبو موسى وَعَم","روٌ جالِبا الشَر البراحِ",81,"ح",1,0],["فمضت خائبةً خاسرةً","تتحاشى نظراتِ الشَّامتين",82,"ن",1,0],["فمضى الشباب كأنما","أيامه أضغاث حلم",83,"م",1,0],["فمَضَتْ عزائمه على آماله","وقَضَتْ مكارمه على أمو