poem/8241","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30495","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9948","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42668","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42500","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55040","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54540","الوافر"],[106,"ذكرى شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179690",""],[77,"طرقنا ديور القوم وهنا وتليسا","https://www.poetsgate.com/ViewPoem.aspx?id=34193",""],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[45,"أُقيمُ عَلى التّشَوّقِ أمْ أسِيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31342",""],[45,"حَثَثْنَا سَيرَنَا لَمّا مَرَرْنا","https://www.poetsgate.com/ViewPoem.aspx?id=32105",""],[28,"ترى كل منشق القميص كأنما","https://www.poetsgate.com/ViewPoem.aspx?id=21733",""],[88,"تذكرت في أوطاني الأهلَ والصحبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19533&r=&rc=36",""]],"verses":[["وَما قَضَباتُ السَبقِ إِلّا لِماجِدٍ","سَعى فَاِحتَوى دونَ الرِجالِ المَساعِيا",0,"ي",2,0],["وَما قَلَّدَ البيضَ المَباتيرَ عُنقَهُ","سِوى الخَوفِ مِن تَقليدِها بِالأَداهِمِ",1,"م",1,0],["وَما قَولِيَ الأَشعارَ إِلّا ذَريعَةً","إِلى أَمَلٍ قَد آنَ قَودُ جَنيبِهِ",2,"ب",2,0],["وَما قَرَنتُ بِها في مَجلَسٍ حَسَناً","إِلّا بِحُسنِ ظَلومٍ يَقبُحُ الحَسَنُ",3,"ن",1,0],["وما قُلْتُ بيْتاً منْ نَسيبٍ مُشَبِّباً","بغانِيَةٍ أو بتَّ منْهُ علَى جَوى",4,"و",2,0],["وما قِسمُ الأرْزاقِ إلا عجيبةٌ","فلا تَطرُدِ السُؤّالَ يا خيْرَ رَزّاقِ",5,"ق",1,0],["وما قصْدُنا إلاّ المُقامُ بحانَةٍ","مَحاريبُ شتّى لاخْتِلاف النّواميسِ",6,"س",1,0],["وَما قَد أَخَذنَ وَما قَد تَرَك","نَ في الحَيِّ مِن نِعمَةٍ وَدِمَن",7,"ن",1,0],["وَما قَعَدتَ عَنِ السودانِ إِذ قَعَدوا","لَكِن أَمَرتَ فَلَبّى الأَمرَ جَيشانِ",8,"ن",1,0],["وَما قَبَضَت كَفُّ الخَضيبِ عَلى يَدي","وَلا حَطَّ فَوقَ الطائِرِ النسرِ مَركبي",9,"ب",2,0],["وَما قيلَ قَد وافى مِنَ الشامِ مُخبِرٌ","عَنِ القَومِ إِلّا أَقبَلَ القَلبُ يَرجفُ",10,"ف",1,0],["وَما قَرقَفٌ مِن أَذرُعاتٍ كَأَنَّها","إِذا سُكِبَت مِن دَنِّها ماءُ مَفصِلِ",11,"ل",1,0],["وَما قِلنَ إِلّا ساعَةً في مُغَوَّرٍ","وَما بِتنَ إِلّا تِلكَ وَالصُبحُ أَدرَعُ",12,"ع",1,0],["وَما قَرَأَ المُفَصَّلَ تَغلِبِيٌّ","وَلا مَسَّ الطَهورَ وَلا السِواكا",13,"ك",2,0],["وَما قَتلي بَني جُشَمَ بنِ بَكرٍ","بِزاكِيَةِ الدِماءِ وَلا اللُحومِ",14,"م",1,0],["وَما قَرمٌ بِأَنجَبَ مِن أَبيكُم","وَما خالٌ بِأَكرَمَ مِن تَميمِ",15,"م",1,0],["وَما قَعَدَت بي عَن لِحاقِكَ عِلَّةٌ","وَلَكِن قَضاءٌ فاتَني فيكَ مُبرَمُ",16,"م",1,0],["وَما قَصَّرتُ في تَسآلِ رَبعٍ","وَلَكِنّي سَأَلتُ فَما أَجابا",17,"ب",2,0],["وَما قُلتُ في مالٍ تُريدينَ أَخذَهُ","بُنَيَّةُ مَهلاً إِنَّني غَيرُ فاعِلِ",18,"ل",1,0],["وما قصرُ الليل أو سكون طوله","سوى أنك تسعف أو تهجر",19,"ر",1,0],["وما قلبي إذاً حجرٌ فيسلو","هلالاً قبل ما اكتمل الطلوعا",20,"ع",2,0],["وما قلت إلا الحقَّ فيك ولم تزل","على منهجٍ من سُنّةِ المجد لاحبِ",21,"ب",1,0],["وما قَهْرُ أنثى قِرنَ جِدٍّ ولم تكن","لتقهر إلا قِرنَ هزل وملعبِ",22,"ب",1,0],["وما قَتلُ بعضِ الحيِّ بعضاً بناهكٍ","قُواهُ إذا ما جاء حيٌّ يحاربُهْ",23,"ه",1,1],["وما قيلَ فيه مِنْ مديح فإنه","مديحُكَ والنِّيَّاتُ نَحْوَكَ عُمَّدُ",24,"د",1,0],["وما قَصَدْتُ سِوَى حَظِّي ومَسْعَدَتي","ولسْت في ذاك محْفُوفاً بتَفْنِيدِ",25,"د",1,0],["وما قلتُ قَولي لشكري يداً","يدَاها ولا مستميحاً يَدَهْ",26,"د",2,0],["وما قصمتْ مذ كنتُ ظهري مصيبةٌ","وطَغْوَى أبي الخُرطوم قاصمة الظهر",27,"ر",1,0],["وما قدْرُ ما يجري وغَيْبةُ وجْهِه","تُطيلُ عليَّ الليلَ وهْو قصير",28,"ر",1,0],["وما قوي علمناه بمحترِسٍ","ولا ضعيفٌ رأيناه بمحروس",29,"س",1,0],["وما قادني ظنٌّ إليك مشبِّهٌ","ولكن يقينٌ ثاقبُ النُورِ ساطع",30,"ع",1,0],["وما قولهم إلا الجميل لأنهم","متى أهْجروا كذَّبتهم بسَداكا",31,"ك",2,0],["وما قِيلُ أملاء الرجالِ وقالُهُم","بأسهلَ من قيلي عليك ومن قالي",32,"ل",2,0],["وما قلتُ لولا ما تظنّي سوى الذي","أراه جديراً أن يحسّنَ أحوالي",32,"ل",2,0],["وما قلّ إلا عندَ عبدِك وحده","وقد جِيد حَزْنُ الأرضِ منها وسهلُها",33,"ل",3,0],["وما قصَّرتُ في التأميلِ كلا","ولا أمسيتَ عن حقي تنامُ",34,"م",1,0],["وما قصَّرتُ قبلكَ في جزاءٍ","ولكنَّ المسامي لي شَمامُ",34,"م",1,0],["وما قِبَلي حقٌّ وهَبْه فهبْهُ لي","فإنّك لَلوهَّاب لا المُتعاظِمُ",35,"م",1,0],["وما قُلتَ لي في ذاك قولاً مُصَرِّحاً","ولكنه قد يَرْجمُ الغيبَ راجمُ",35,"م",1,0],["وَما قَبِلَت مِنّي هِلالٌ أَمانَةً","وَلا عائِذٌ يُغني الضِبابَ وَلا شِمرُ",36,"ر",1,0],["وَما قاتَلَ البَطَلَ النَجيدَ غَضَنفَرٌ","إِنَّ الغَضَنفَرَ مَن عَصى شَهَواتِهِ",37,"ت",2,0],["وَما قِستُهُ في الناسِ قَطُّ بِماجِدٍ","وَإِن جَلَّ إِلّا كانَ أَزكى وَأَفضَلا",38,"ل",2,0],["وَما قُلتُ أَشعاري لَأَبغي بِها النَدى","وَلَكِنَّني في حِليَةِ الفَضلِ واثِقُ",39,"ق",1,0],["وما قدَّرت أن سيجنّ ظهرا","ولم تكن القيامة لي حسابا",40,"ب",2,0],["وما قصِّرت بنت الكروم وإنما","مددتم بها الأيدي ومدّ الأسى يدا",41,"د",2,0],["وَما قَضَت مِصرُ مِن كُلِّ لُبانَتَها","حَتّى تَجُرَّ ذُيولَ الغِبطَةِ القُشُبا",42,"ب",2,0],["وَما قَد رَوى بَرقٌ مِنَ القَولِ كاذِبٌ","وَآخَرُ مِن فِعلِ المُحِبّينَ أَكذَبُ",43,"ب",1,0],["وَما قَضى أَحَدٌ مِنها لُبانَتَهُ","وَلا اِنتَهى أَرَبٌ إِلّا إِلى أَرَبِ",44,"ب",1,0],["وَما قُلتُ لِلبَدرِ أَنتَ اللُجَينُ","وَلا قُلتُ لِلشَمسِ أَنتِ الذَهَب",45,"ب",1,0],["وَما قِستُ كُلَّ مُلوكِ البِلادِ","فَدَع ذِكرَ بَعضٍ بِمَن في حَلَب",45,"ب",1,0],["وَما قَرُبَت أَشباهُ قَومٍ أَباعِدٍ","وَلا بَعُدَت أَشباهُ قَومٍ أَقارِبِ",46,"ب",1,0],["وَما قَتَلَ الأَحرارَ كَالعَفوِ عَنهُمُ","وَمَن لَكَ بِالحُرِّ الَّذي يَحفَظُ اليَدا",47,"د",2,0],["وَما قُلتُ مِن شِعرٍ تَكادُ بُيوتُهُ","إِذا كُتِبَت يَبيَضُّ مِن نورِها الحِبرُ",48,"ر",1,0],["وَما قَبلَ سَيفِ الدّوْلَةِ کثّارَ عاشِقٌ","ولا طُلِبَتْ عندَ الظّلامِ ذُحُولُ",49,"ل",1,0],["وما قاله هرمس أولا","وجاء به آخراً هرقلُ",50,"ل",1,0],["وما قعد الإقتارُ بي عن فضيلةٍ","وقد يقطع العَوْدُ الفَلا وهو منكوبُ",51,"ب",1,0],["وما قَذَفاتُ المجدِ إِلّا لفاتكٍ","إِذا هَمَّ لم يستَقْرِ سُبْلَ العواقبِ",52,"ب",1,0],["وَما قِدحُهُم إِلّا المُعَلّى فَمَن أَبى","فَلَيسَ لَهُ إِلّا مَنيحُ الضَوارِبِ",53,"ب",1,0],["وَما قَبُحَ المَعروفُ إِلّا غَدا اِسمُهُ","عَلَيَّ فَكانَ اِسماً لِمَعروفِهِ عِندي",54,"ي",1,0],["وَما قابَلتَ عارِفَةً بِأُخرى","كَنُعمى باتَ يَجزيها الشَكورُ",55,"ر",1,0],["وَما قَرُبَت بِالطَيفِ إِلّا لِتَنتَوي","وَلا وَصَلَت في النَومِ إِلّا لِتَهجُرا",56,"ر",2,0],["وَما قَدرُهُ في جَنبِ جودِكَ إِن غَدا","بِرُمَّتِهِ أَو راحَ نائِلُكَ الغَمرُ",57,"ر",1,0],["وَما قَصَّرَت في دَرغَنونَ رِماحُنا","فَيَرجَعَ مِنها الطَيفُ غَضبانَ مُحنَقا",58,"ق",2,0],["وَما قاضٍ لَهُ مِأَتانِ أَلفاً","مِنَ الأَرزاقِ في شَهرٍ بِغالِ",59,"ل",1,0],["وَما قايَسَت حَيّاً حَنيفَةُ سوقَةً","وَلَو جَهِدوا إِلّا حَنيفَةُ أَطيَبُ",60,"ب",1,0],["وَما قَبَضَت كَفّاً يَدٌ دونَ مالِها","لِتَمنَعَهُ إِلّا سَيَملِكُهُ الدَهرُ",61,"ر",1,0],["وَما قامَ مِنّا قائِمٌ في نَدِيِّنا","فَيَنطِقَ إِلّا بِالَّتي هِيَ أَعرَفُ",62,"ف",1,0],["وَما قامَ مُذ ماتَ النَبِيُّ مُحَمَّدٌ","وَعُثمانَ فَوقَ الأَرضِ راعٍ يُعادِلُه",63,"ل",2,0],["وَما قُمتَ حَتّى اِستَسلَمَ الناسُ وَاِلتَقى","عَلَيهِم فَمُ الدَهرِ العَضوضِ بَوازِلُه",64,"ل",2,0],["وما قُدّ قَدّ السيرِ بالسيرِ بينهمْ","ولكنّما المنقدّ بينهمُ قلبي",65,"ي",1,0],["وما قَدَّ قَدُّ السير بالطُّول سَيْرَهم","وَلكنَّما المُنقَدُّ قَلبي المتَيَّمُ",66,"م",1,0],["وما قَهوَةٌ مُيِّعَتْ مِسكة","فَبَينَهُما للأَريجِ اشتِراكْ",67,"ك",1,0],["وَما قَتلوا مِن شِدَّةِ البأسِ أَهلها","ولكنّهم قُلٌّ أحاطَ بهم كثرُ",68,"ر",1,0],["وما قَرَعَ الأسماعَ بالخبرِ الَّذي","أبَى اللَّهُ إلّا أنْ يُكَذَّبَ بالخُبرِ",69,"ر",1,0],["وما قهوةٌ صُفّقَتْ للصَّبوح","بِمِسكٍ ذَكِيٍّ وشَهْدٍ مَشورِ",70,"ر",1,0],["وما قَصّرَ اللَّه المدى إذ جرى به","ولا مدّ فيه للسَّوابق فامتدا",71,"د",2,0],["وَما قَصَدوا إِذ يَسحَبونَ عَلى المُنى","بُرودَهُمُ إِلّا إِلى وارِثِ البُردِ",72,"د",1,0],["وَمَا قُلْتُ إِلَّا بَعْدَ عِلْمٍ أَجَدَّ لِي","يَقِيناً نَفَى عَنِّي مُرَاجَعَةَ الظَّنِّ",73,"ن",1,0],["وَما قَهوَةٌ صَهباءُ في مُتَمَنِّعٍ","بِحَورانَ يَعلو حينَ فُضَّت شَرارُها",74,"ر",3,0],["وما قومٌ يكون الأمرُ فيهم","لِسادَةِ دُنشوايَ بسالمينا",75,"ن",2,0],["وَما قَهَرَ المَوتَ القَويَّ سِوى امرئٍ","يَخلِّفُ بَينَ الناس ذكراً مخلّدا",76,"د",2,0],["وَما قَلَّ مَن كانَت بَقاياهُ مِثلَنا","شَبابٌ تَسامى لِلعُلى وَكُهولُ",77,"ل",1,0],["وَما قاعِدٌ إِلّا كَآخَرَ سائِرٍ","وَإِن أَدأَبَ العيسَ المَراسيلَ إِدآبا",78,"ب",2,0],["وَما قَلْبُها مِمَّا يَقَرُّ خُفُوقُهُ","وَلا طَرْفُها حتى يعودَ قَرِيرُ",79,"ر",1,0],["وما قِيسَ وَفُر المال في كلِّ حالةٍ","بجودك إلاّ كان جودُكَ أوفرا",80,"ر",2,0],["وما قصدُ مثلي في القَصيد ضراعَةٌ","ولا من خِلالي فيه حِرْصٌ وترغيب",81,"ب",1,0],["وَما قَرَعَ الأَقوامَ مِثلُ مُشَيَّعٍ","أَريبٍ وَلا جَلّى العَمى مِثلُ عالِمِ",82,"م",1,0],["وَما قُبلُكَ مَشقوقٌ","وَلا في اِستِكَ لي أَجرُ",83,"ر",1,0],["وَما قَولُكَ لِيَ أُرضي","كَ إِلّا سُكَّرٌ مُسكِر",84,"ر",1,0],["وَما قَلَّ نَفسُ الخَيرِ بَل قَلَّ أَهلُهُ","وَأَخطَأتَهُ وَالشَرُّ في الناسِ أَكثَرُ",85,"ر",1,0],["وَما قادَني في الدَهرِ إِلّا غَلَبتُهُ","وَكَيفَ يُلامُ المَرءُ وَالحُبُّ غالِبُه",86,"ب",2,0],["وَما قَصَدَت قَوماً مُحَلّينَ خَيلُهُ","فَتَصرُفَ إِلّا عَن دِماءٍ تَصَبَّبُ",87,"ب",1,0],["وَما قَبِلَت نَفسي مِنَ الخَيرِ لَفظَةً","وَإِن طالَ ما فاهَت بِهِ الخُطَباءُ",88,"ب",3,0],["وَما قَصَدتُكِ مُختاراً فَتَعذُلَني","فيكِ العَواذِلُ إِن حاوَلتِ إِقصادي",89,"ي",1,0],["وَما قامَ لَبَنُ الضَيفِ إِذ جاءَ طارِقاً","بِما هُوَ راجٍ في الصَباحِ مِنَ اللَبنِ",90,"ن",1,0],["وما قارَنتْ شخصاً من الخلقِ ساعةً","منَ الدّهرِ إلا وَهيَ أَفْتَكُ من قِرْنِ",91,"ن",1,0],["وَما قُلتُ حَتّى قالَ شَتمُ عَشِيرتي","نُفَيلَ بنَ عَمرِوٍ وَالوَحِيدَ وجَعفَرا",92,"ر",2,0],["وَما قُلتُ حَتّى نالَ شَتمُ عَشيرَتي","نُفَيلَ بِنَ عَمرٍو وَالوَحيدَ وَجَعفَرا",93,"ر",2,0],["وَما قَبلَ سَيفِ الدَولَةِ اِثّارَ عاشِقٌ","وَلا طُلِبَت عِندَ الظَلامِ ذُحولُ",94,"ل",1,0],["وما قرَّ في ظلِّ السلام بحقِّهِ","ولا فازَ من حريَّةٍ بِضمانِ",95,"ن",1,0],["وَما قُلتُ هَذا فَاِعلَمَنَّ تَجَنُّباً","لصَرمٍ وَلا هَذا بِنا عَنكَ يَقصُرُ",96,"ر",1,0],["وما قامَ في عُلْيا زُغاوَة مُنْذِرٌ","فما بالُ سُحْمٍ يَنْتَجينَ إلى بُقْع",97,"ع",1,0],["وما قَسَطوا إلاّ على المالِ وَحْدَهُ","وذلكَ مِنهمْ في مكارِمِهِمْ قِسطُ",98,"ط",1,0],["وَما قُرِعتْ سِنِّي علَيْكُم نَدامةً","وأوشِكْ غَداً أَنْ يَقْرعَ السِّنَّ نادِمُ",99,"م",1,0],["وَما قَصَّرتُ حَتّى كُلَّ مُهري","وَقَصَّرَ في السِباقِ وَفي اللِحاقِ",100,"ق",1,0],["وَمَا قَصَّرْتُ فِي طَلَبِ الْمَعَالِي","وَلَكِنْ رُبَّمَا خَابَ الْحَرِيصُ",101,"ص",1,0],["وَما قَصَّرْتُ في جَزَعٍ وَلَكِنْ","إِذا غَلَبَ الأَسَى ذَهَبَ الْبُكاءُ",102,"ا",2,0],["وَما قُصُورُ الأُولَى يُثْرُونَ إِنْ بَخِلُوا","إلاَّ قُبُورٌ رَعَتْ دِيدَانُهَا الجِيَفَا",103,"ف",2,0],["وَمَا قُوْلي الفَنَاءُ وَأَنْتَ حَيٌّ","حَيَاةُ الخَالِدِينَ بِلا مِرَاءِ",104,"ا",2,0],["وما قيمةُ الروض دونَ طيورِ","تُغنِّي ودونَ زُهورٍ تُشم؟",105,"م",1,0],["وما قصدنا إلا الكؤوس وإنما","لحنا له في القول خبثا وتدليسا",106,"س",2,0],["وما قَدْرُ عُمرِ المرءِ إن لم يُرَعْ به","وما طيبُ عيشِ المرء إن لم يُرَنَّق",107,"ق",1,0],["وما قدمتهُ من ضحايا عزيزةٍ","نتائجُها هذا البلاءُ الموكل",108,"ل",1,0],["وَما قَابَلْتُ عَارِفَةً بأُخْرَى،","كَنُعْمَى بَاتَ يَجْزِيهَا شُكُورُ",109,"ر",1,0],["وَمَا قَاضٍ لَهُ مِائَتَانِ ألْفاً","مِنَ الأرْزَاقِ في شَهْرٍ بِغَالِ",110,"ل",1,0],["وَمَا قام مُذْ ماتَ النّبيُّ مُحَمّدٌ","وَعُثمانُ فَوْقَ الأرْضِ رَاغٍ يعادلُهْ",111,"ل",2,0],["وما قد دعونا من سلانيك قد لبى","فجئنا ولم يُعي السفارُ مطينا",112,"ا",1,0]]}