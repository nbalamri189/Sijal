t/poem37957.html","الطويل"],[515,"صحت بدولتك الأيام من سقم","https://www.aldiwan.net/poem12269.html","البسيط"],[529,"نظام يحاكي الدر أهدته نحونا","https://www.aldiwan.net/poem37082.html","الطويل"],[529,"نداء لكل الناس فالأمر أعظم","https://www.aldiwan.net/poem37210.html","الطويل"],[529,"إذا كانت العقبى لديك كما أشا","https://www.aldiwan.net/poem37412.html","الطويل"],[529,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[536,"صحا من سكره وسلا","https://www.aldiwan.net/poem23848.html","مجزوء الوافر"],[538,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[546,"أمن رسم دار ماء عينيك يسفح","https://www.aldiwan.net/poem1860.html","الطويل"],[551,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[551,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[551,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[551,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[558,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[558,"أنا العاشق السالي لوجهك يا علو","https://www.aldiwan.net/poem33585.html","الطويل"],[558,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[558,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[562,"شكا من أذهب البلوى وزالت","https://www.aldiwan.net/poem52835.html","الوافر"],[563,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[564,"سلاماً وأهلاً أيها السيد الشهم","https://www.aldiwan.net/poem891.html",""],[575,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[575,"هلال ولكن السعود منازله","https://www.aldiwan.net/poem3023.html","الطويل"],[575,"هواي لمحبوبي الأول","https://www.aldiwan.net/poem3036.html","المتقارب"],[575,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"],[580,"ولست أبالي حين أصبح جثةً","https://www.aldiwan.net/poem25191.html","عموديه"],[587,"أتعرف نظماً فيك منى مسراً","https://www.aldiwan.net/poem11501.html","عموديه"],[587,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["وَما قَضَباتُ السَبقِ إِلّا لِماجِدٍ","سَعى فَاِحتَوى دونَ الرِجالِ المَساعِيا",0,"ي",2,0],["وَما قَلَّدَ البيضَ المَباتيرَ عُنقَهُ","سِوى الخَوفِ مِن تَقليدِها بِالأَداهِمِ",1,"م",1,0],["وَما قَولِيَ الأَشعارَ إِلّا ذَريعَةً","إِلى أَمَلٍ قَد آنَ قَودُ جَنيبِهِ",2,"ب",2,0],["وَما قَرَنتُ بِها في مَجلَسٍ حَسَناً","إِلّا بِحُسنِ ظَلومٍ يَقبُحُ الحَسَنُ",3,"ن",1,0],["وما قُلْتُ بيْتاً منْ نَسيبٍ مُشَبِّباً","بغانِيَةٍ أو بتَّ منْهُ علَى جَوى",4,"و",2,0],["وما قِسمُ الأرْزاقِ إلا عجيبةٌ","فلا تَطرُدِ السُؤّالَ يا خيْرَ رَزّاقِ",5,"ق",1,0],["وما قصْدُنا إلاّ المُقامُ بحانَةٍ","مَحاريبُ شتّى لاخْتِلاف النّواميسِ",6,"س",1,0],["وَما قَد أَخَذنَ وَما قَد تَرَك","نَ في الحَيِّ مِن نِعمَةٍ وَدِمَن",7,"ن",1,0],["وَما قَعَدتَ عَنِ السودانِ إِذ قَعَدوا","لَكِن أَمَرتَ فَلَبّى الأَمرَ جَيشانِ",8,"ن",1,0],["وَما قَبَضَت كَفُّ الخَضيبِ عَلى يَدي","وَلا حَطَّ فَوقَ الطائِرِ النسرِ مَركبي",9,"ب",2,0],["وَما قيلَ قَد وافى مِنَ الشامِ مُخبِرٌ","عَنِ القَومِ إِلّا أَقبَلَ القَلبُ يَرجفُ",10,"ف",1,0],["وَما قَرقَفٌ مِن أَذرُعاتٍ كَأَنَّها","إِذا سُكِبَت مِن دَنِّها ماءُ مَفصِلِ",11,"ل",1,0],["وَما قِلنَ إِلّا ساعَةً في مُغَوَّرٍ","وَما بِتنَ إِلّا تِلكَ وَالصُبحُ أَدرَعُ",12,"ع",1,0],["وَما قَرَأَ المُفَصَّلَ تَغلِبِيٌّ","وَلا مَسَّ الطَهورَ وَلا السِواكا",13,"ك",2,0],["وَما قَتلي بَني جُشَمَ بنِ بَكرٍ","بِزاكِيَةِ الدِماءِ وَلا اللُحومِ",14,"م",1,0],["وَما قَرمٌ بِأَنجَبَ مِن أَبيكُم","وَما خالٌ بِأَكرَمَ مِن تَميمِ",15,"م",1,0],["وَما قَعَدَت بي عَن لِحاقِكَ عِلَّةٌ","وَلَكِن قَضاءٌ فاتَني فيكَ مُبرَمُ",16,"م",1,0],["وَما قَصَّرتُ في تَسآلِ رَبعٍ","وَلَكِنّي سَأَلتُ فَما أَجابا",17,"ب",2,0],["وَما قُلتُ في مالٍ تُريدينَ أَخذَهُ","بُنَيَّةُ مَهلاً إِنَّني غَيرُ فاعِلِ",18,"ل",1,0],["وما قصرُ الليل أو سكون طوله","سوى أنك تسعف أو تهجر",19,"ر",1,0],["وما قلبي إذاً حجرٌ فيسلو","هلالاً قبل ما اكتمل الطلوعا",20,"ع",2,0],["وما قلت إلا الحقَّ فيك ولم تزل","على منهجٍ من سُنّةِ المجد لاحبِ",21,"ب",1,0],["وما قَهْرُ أنثى قِرنَ جِدٍّ ولم تكن","لتقهر إلا قِرنَ هزل وملعبِ",22,"ب",1,0],["وما قَتلُ بعضِ الحيِّ بعضاً بناهكٍ","قُواهُ إذا ما جاء حيٌّ يحاربُهْ",23,"ه",1,1],["وما قيلَ فيه مِنْ مديح فإنه","مديحُكَ والنِّيَّاتُ نَحْوَكَ عُمَّدُ",24,"د",1,0],["وما قَصَدْتُ سِوَى حَظِّي ومَسْعَدَتي","ولسْت في ذاك محْفُوفاً بتَفْنِيدِ",25,"د",1,0],["وما قلتُ قَولي لشكري يداً","يدَاها ولا مستميحاً يَدَهْ",26,"د",2,0],["وما قصمتْ مذ كنتُ ظهري مصيبةٌ","وطَغْوَى أبي الخُرطوم قاصمة الظهر",27,"ر",1,0],["وما قدْرُ ما يجري وغَيْبةُ وجْهِه","تُطيلُ عليَّ الليلَ وهْو قصير",28,"ر",1,0],["وما قوي علمناه بمحترِسٍ","ولا ضعيفٌ رأيناه بمحروس",29,"س",1,0],["وما قادني ظنٌّ إليك مشبِّهٌ","ولكن يقينٌ ثاقبُ النُورِ ساطع",30,"ع",1,0],["وما قولهم إلا الجميل لأنهم","متى أهْجروا كذَّبتهم بسَداكا",31,"ك",2,0],["وما قِيلُ أملاء الرجالِ وقالُهُم","بأسهلَ من قيلي عليك ومن قالي",32,"ل",2,0],["وما قلتُ لولا ما تظنّي سوى الذي","أراه جديراً أن يحسّنَ أحوالي",32,"ل",2,0],["وما قلّ إلا عندَ عبدِك وحده","وقد جِيد حَزْنُ الأرضِ منها وسهلُها",33,"ل",3,0],["وما قصَّرتُ في التأميلِ كلا","ولا أمسيتَ عن حقي تنامُ",34,"م",1,0],["وما قصَّرتُ قبلكَ في جزاءٍ","ولكنَّ المسامي لي شَمامُ",34,"م",1,0],["وما قِبَلي حقٌّ وهَبْه فهبْهُ لي","فإنّك لَلوهَّاب لا المُتعاظِمُ",35,"م",1,0],["وما قُلتَ لي في ذاك قولاً مُصَرِّحاً","ولكنه قد يَرْجمُ الغيبَ راجمُ",35,"م",1,0],["وَما قَبِلَت مِنّي هِلالٌ أَمانَةً","وَلا عائِذٌ يُغني الضِبابَ وَلا شِمرُ",36,"ر",1,0],["وَما قاتَلَ البَطَلَ النَجيدَ غَضَنفَرٌ","إِنَّ الغَضَنفَرَ مَن عَصى شَهَواتِهِ",37,"ت",2,0],["وَما قِستُهُ في الناسِ قَطُّ بِماجِدٍ","وَإِن جَلَّ إِلّا كانَ أَزكى وَأَفضَلا",38,"ل",2,0],["وَما قُلتُ أَشعاري لَأَبغي بِها النَدى","وَلَكِنَّني في حِليَةِ الفَضلِ واثِقُ",39,"ق",1,0],["وما قدَّرت أن سيجنّ ظهرا","ولم تكن القيامة لي حسابا",40,"ب",2,0],["وما قصِّرت بنت الكروم وإنما","مددتم بها الأيدي ومدّ الأسى يدا",41,"د",2,0],["وَما قَضَت مِصرُ مِن كُلِّ لُبانَتَها","حَتّى تَجُرَّ ذُيولَ الغِبطَةِ القُشُبا",42,"ب",2,0],["وَما قَد رَوى بَرقٌ مِنَ القَولِ كاذِبٌ","وَآخَرُ مِن فِعلِ المُحِبّينَ أَكذَبُ",43,"ب",1,0],["وَما قَضى أَحَدٌ مِنها لُبانَتَهُ","وَلا اِنتَهى أَرَبٌ إِلّا إِلى أَرَبِ",44,"ب",1,0],["وَما قُلتُ لِلبَدرِ أَنتَ اللُجَينُ","وَلا قُلتُ لِلشَمسِ أَنتِ الذَهَب",45,"ب",1,0],["وَما قِستُ كُلَّ مُلوكِ البِلادِ","فَدَع ذِكرَ بَعضٍ بِمَن في حَلَب",45,"ب",1,0],["وَما قَرُبَت أَشباهُ قَومٍ أَباعِدٍ","وَلا بَعُدَت أَشباهُ قَومٍ أَقارِبِ",46,"ب",1,0],["وَما قَتَلَ الأَحرارَ كَالعَفوِ عَنهُمُ","وَمَن لَكَ بِالحُرِّ الَّذي يَحفَظُ اليَدا",47,"د",2,0],["وَما قُلتُ مِن شِعرٍ تَكادُ بُيوتُهُ","إِذا كُتِبَت يَبيَضُّ مِن نورِها الحِبرُ",48,"ر",1,0],["وَما قَبلَ سَيفِ الدّوْلَةِ کثّارَ عاشِقٌ","ولا طُلِبَتْ عندَ الظّلامِ ذُحُولُ",49,"ل",1,0],["وما قاله هرمس أولا","وجاء به آخراً هرقلُ",50,"ل",1,0],["وما قعد الإقتارُ بي عن فضيلةٍ","وقد يقطع العَوْدُ الفَلا وهو منكوبُ",51,"ب",1,0],["وما قَذَفاتُ المجدِ إِلّا لفاتكٍ","إِذا هَمَّ لم يستَقْرِ سُبْلَ العواقبِ",52,"ب",1,0],["وَما قِدحُهُم إِلّا المُعَلّى فَمَن أَبى","فَلَيسَ لَهُ إِلّا مَنيحُ الضَوارِبِ",53,"ب",1,0],["وَما قَبُحَ المَعروفُ إِلّا غَدا اِسمُهُ","عَلَيَّ فَكانَ اِسماً لِمَعروفِهِ عِندي",54,"ي",1,0],["وَما قابَلتَ عارِفَةً بِأُخرى","كَنُعمى باتَ يَجزيها الشَكورُ",55,"ر",1,0],["وَما قَرُبَت بِالطَيفِ إِلّا لِتَنتَوي","وَلا وَصَلَت في النَومِ إِلّا لِتَهجُرا",56,"ر",2,0],["وَما قَدرُهُ في جَنبِ جودِكَ إِن غَدا","بِرُمَّتِهِ أَو راحَ نائِلُكَ الغَمرُ",57,"ر",1,0],["وَما قَصَّرَت في دَرغَنونَ رِماحُنا","فَيَرجَعَ مِنها الطَيفُ غَضبانَ مُحنَقا",58,"ق",2,0],["وَما قاضٍ لَهُ مِأَتانِ أَلفاً","مِنَ الأَرزاقِ في شَهرٍ بِغالِ",59,"ل",1,0],["وَما قايَسَت حَيّاً حَنيفَةُ سوقَةً","وَلَو جَهِدوا إِلّا حَنيفَةُ أَطيَبُ",60,"ب",1,0],["وَما قَبَضَت كَفّاً يَدٌ دونَ مالِها","لِتَمنَعَهُ إِلّا سَيَملِكُهُ الدَهرُ",61,"ر",1,0],["وَما قامَ مِنّا قائِمٌ في نَدِيِّنا","فَيَنطِقَ إِلّا بِالَّتي هِيَ أَعرَفُ",62,"ف",1,0],["وَما قامَ مُذ ماتَ النَبِيُّ مُحَمَّدٌ","وَعُثمانَ فَوقَ الأَرضِ راعٍ يُعادِلُه",63,"ل",2,0],["وَما قُمتَ حَتّى اِستَسلَمَ الناسُ وَاِلتَقى","عَلَيهِم فَمُ الدَهرِ العَضوضِ بَوازِلُه",64,"ل",2,0],["وما قُدّ قَدّ السيرِ بالسيرِ بينهمْ","ولكنّما المنقدّ بينهمُ قلبي",65,"ي",1,0],["وما قَدَّ قَدُّ السير بالطُّول سَيْرَهم","وَلكنَّما المُنقَدُّ قَلبي المتَيَّمُ",66,"م",1,0],["وما قَهوَةٌ مُيِّعَتْ مِسكة","فَبَينَهُما للأَريجِ اشتِراكْ",67,"ك",1,0],["وَما قَتلوا مِن شِدَّةِ البأسِ أَهلها","ولكنّهم قُلٌّ أحاطَ بهم كثرُ",68,"ر",1,0],["وما قَرَعَ الأسماعَ بالخبرِ الَّذي","أبَى اللَّهُ إلّا أنْ يُكَذَّبَ بالخُبرِ",69,"ر",1,0],["وما قهوةٌ صُفّقَتْ للصَّبوح","بِمِسكٍ ذَكِيٍّ وشَهْدٍ مَشورِ",70,"ر",1,0],["وما قَصّرَ اللَّه المدى إذ جرى به","ولا مدّ فيه للسَّوابق فامتدا",71,"د",2,0],["وَما قَصَدوا إِذ يَسحَبونَ عَلى المُنى","بُرودَهُمُ إِلّا إِلى وارِثِ البُردِ",72,"د",1,0],["وَمَا قُلْتُ إِلَّا بَعْدَ عِلْمٍ أَجَدَّ لِي","يَقِيناً نَفَى عَنِّي مُرَاجَعَةَ الظَّنِّ",73,"ن",1,0],["وَما قَهوَةٌ صَهباءُ في مُتَمَنِّعٍ","بِحَورانَ يَعلو حينَ فُضَّت شَرارُها",74,"ر",3,0],["وما قومٌ يكون الأمرُ فيهم","لِسادَةِ دُنشوايَ بسالمينا",75,"ن",2,0],["وَما قَهَرَ المَوتَ القَويَّ سِوى امرئٍ","يَخلِّفُ بَينَ الناس ذكراً مخلّدا",76,"د",2,0],["وَما قَلَّ مَن كانَت بَقاياهُ مِثلَنا","شَبابٌ تَسامى لِلعُلى وَكُهولُ",77,"ل",1,0],["وَما قاعِدٌ إِلّا كَآخَرَ سائِرٍ","وَإِن أَدأَبَ العيسَ المَراسيلَ إِدآبا",78,"ب",2,0],["وَما قَلْبُها مِمَّا يَقَرُّ خُفُوقُهُ","وَلا طَرْفُها حتى يعودَ قَرِيرُ",79,"ر",1,0],["وما قِيسَ وَفُر المال في كلِّ حالةٍ","بجودك إلاّ كان جودُكَ أوفرا",80,"ر",2,0],["وما قصدُ مثلي في القَصيد ضراعَةٌ","ولا من خِلالي فيه حِرْصٌ وترغيب",81,"ب",1,0],["وَما قَرَعَ الأَقوامَ مِثلُ مُشَيَّعٍ","أَريبٍ وَلا جَلّى العَمى مِثلُ عالِمِ",82,"م",1,0],["وَما قُبلُكَ مَشقوقٌ","وَلا في اِستِكَ لي أَجرُ",83,"ر",1,0],["وَما قَولُكَ لِيَ أُرضي","كَ إِلّا سُكَّرٌ مُسكِر",84,"ر",1,0],["وَما قَلَّ نَفسُ الخَيرِ بَل قَلَّ أَهلُهُ","وَأَخطَأتَهُ وَالشَرُّ في الناسِ أَكثَرُ",85,"ر",1,0],["وَما قادَني في الدَهرِ إِلّا غَلَبتُهُ","وَكَيفَ يُلامُ المَرءُ وَالحُبُّ غالِبُه",86,"ب",2,0],["وَما قَصَدَت قَوماً مُحَلّينَ خَيلُهُ","فَتَصرُفَ إِلّا عَن دِماءٍ تَصَبَّبُ",87,"ب",1,0],["وَما قَبِلَت نَفسي مِنَ الخَيرِ لَفظَةً","وَإِن طالَ ما فاهَت بِهِ الخُطَباءُ",88,"ب",3,0],["وَما قَصَدتُكِ مُختاراً فَتَعذُلَني","فيكِ العَواذِلُ إِن حاوَلتِ إِقصادي",89,"ي",1,0],["وَما قامَ لَبَنُ الضَيفِ إِذ جاءَ طارِقاً","بِما هُوَ راجٍ في الصَباحِ مِنَ اللَبنِ",90,"ن",1,0],["وما قارَنتْ شخصاً من الخلقِ ساعةً","منَ الدّهرِ إلا وَهيَ أَفْتَكُ من قِرْنِ",91,"ن",1,0],["وَما قُلتُ حَتّى قالَ شَتمُ عَشِيرتي","نُفَيلَ بنَ عَمرِوٍ وَالوَحِيدَ وجَعفَرا",92,"ر",2,0],["وَما قُلتُ حَتّى نالَ شَتمُ عَشيرَتي","نُفَيلَ بِنَ عَمرٍو وَالوَحيدَ وَجَعفَرا",93,"ر",2,0],["وَما قَبلَ سَيفِ الدَولَةِ اِثّارَ عاشِقٌ","وَلا طُلِبَت عِندَ الظَلامِ ذُحولُ",94,"ل",1,0],["وما قرَّ في ظلِّ السلام بحقِّهِ","ولا فازَ من حريَّةٍ بِضمانِ",95,"ن",1,0],["وَما قُلتُ هَذا فَاِعلَمَنَّ تَجَنُّباً","لصَرمٍ وَلا هَذا بِنا عَنكَ يَقصُرُ",96,"ر",1,0],["وما قامَ في عُلْيا زُغاوَة مُنْذِرٌ","فما بالُ سُحْمٍ يَنْتَجينَ إلى بُقْع",97,"ع",1,0],["وما قَسَطوا إلاّ على المالِ وَحْدَهُ","وذلكَ مِنهمْ في مكارِمِهِمْ قِسطُ",98,"ط",1,0],["وَما قُرِعتْ سِنِّي علَيْكُم نَدامةً","وأوشِكْ غَداً أَنْ يَقْرعَ السِّنَّ نادِمُ",99,"م",1,0],["وَما قَصَّرتُ حَتّى كُلَّ مُهري","وَقَصَّرَ في السِباقِ وَفي اللِحاقِ",100,"ق",1,0],["وَمَا قَصَّرْتُ فِي طَلَبِ الْمَعَالِي","وَلَكِنْ رُبَّمَا خَابَ الْحَرِيصُ",101,"ص",1,0],["وَما قَصَّرْتُ في جَزَعٍ وَلَكِنْ","إِذا غَلَبَ الأَسَى ذَهَبَ الْبُكاءُ",102,"ا",2,0],["وَما قُصُورُ الأُولَى يُثْرُونَ إِنْ بَخِلُوا","إلاَّ قُبُورٌ رَعَتْ دِيدَانُهَا الجِيَفَا",103,"ف",2,0],["وَمَا قُوْلي الفَنَاءُ وَأَنْتَ حَيٌّ","حَيَاةُ الخَالِدِينَ بِلا مِرَاءِ",104,"ا",2,0],["وما قيمةُ الروض دونَ طيورِ","تُغنِّي ودونَ زُهورٍ تُشم؟",105,"م",1,0],["وما قصدنا إلا الكؤوس وإنما","لحنا له في القول خبثا وتدليسا",106,"س",2,0],["وما قَدْرُ عُمرِ المرءِ إن لم يُرَعْ به","وما طيبُ عيشِ المرء إن لم يُرَنَّق",107,"ق",1,0],["وما قدمتهُ من ضحايا عزيزةٍ","نتائجُها هذا البلاءُ الموكل",108,"ل",1,0],["وَما قَابَلْتُ عَارِفَةً بأُخْرَى،","كَنُعْمَى بَاتَ يَجْزِيهَا شُكُورُ",109,"ر",1,0],["وَمَا قَاضٍ لَهُ مِائَتَانِ ألْفاً","مِنَ الأرْزَاقِ في شَهْرٍ بِغَالِ",110,"ل",1,0],["وَمَا قام مُذْ ماتَ النّبيُّ مُحَمّدٌ","وَعُثمانُ فَوْقَ الأرْضِ رَاغٍ يعادلُهْ",111,"ل",2,0],["وما قد دعونا من سلانيك قد لبى","فجئنا ولم يُعي السفارُ مطينا",112,"ا",1,0],["وما قلت عنها من قوىً وتشجع","وتزكية للنفسِ إلا تفهَّمَا",113,"م",2,0],["وَما قَصُرَت يَدي عَن عُظمِ أَمرٍ","أَهُمُّ بِهِ وَما سَهمي بِنَكسِ",114,"س",1,0],["وما قَالَه اللَّوَّ الذي كَبشهُ","لقد ضَلَّ ذاكَ الكبشُ أيَّ ضَلالِ",115,"ل",1,0],["وما قِيلَ في توحيدِكُم مِن مَعِيَّةٍ","بِذَاتٍ تُنَافي مُنتَقَى كُلِّ مذهبِ",116,"ب",1,0],["وما قد حسبتُم من سَرَابٍ غَطَمطَماً","تُرَجُّونَ مِنهُ مَشرَباً بعدض مَشرَبِ",116,"ب",1,0],["وما قاَمَت مقَامَكِ لى تُرابٌ","وكيف وأنتِ فائقةُ التراب",117,"ب",1,0],["وَما قَارَنَ العِزَّ مَلكٌ ثَنى","قَرونَتَهُ عَن طَريقِ العَطَب",118,"ب",1,0],["وَما قَصَّرَت فيكَ الصِفاتُ تَعَمُّداً","وَلَكَنِّها جازَت فَجازَت عَنِ القَصدِ",119,"د",1,0],["وَما قَرَأَ الكِتابَ وَلا كِتاباً","بِهِ عُرِفَ الحَرامُ مِنَ الحَلالِ",120,"ل",1,0],["وَما قُدتُ إِلّا شُرَّداً عَزُّ مَرُّها","عَلى بَلَدٍ لَم تَتَّخِذ فيهِ مَنزِلا",121,"ل",2,0],["وما قال بعد السير والجدّ منشدٌ","توسّد بمهد الأمن قد مرّت النوى",122,"و",2,0],["وما قلتُ إلاَّ بالذي قد أفادني","تواتر نقلٍ من ثقاتِ الأصاحب",123,"ب",1,0],["وما قدر مخلوق بعلم يحيطه","بخالقه والشمس تخفى على الاعمى",124,"م",2,0],["وما قصدهُ إِلا خلافي ولو مضى","وخالفه فيَّ النبيون والكتبُ",125,"ب",1,0],["وما قادهم إلا وجوه خيوله","تعادى بأسد حين تنسبها تركا",126,"ك",2,0],["وما قصدتَك حتى حثّني طمعٌ","يحثه منك فضلٌ أَنت ناشِره",127,"ر",2,0],["وما قبض الجسوم بقبض أخذ","ولا أحيا النفوس من الحمام",128,"م",1,0],["وَما قَتلُهُ مِمّا يُعابُ بِهِ الفَتى","إِذا عُدَّ يوماً بَينَ شِيبٍ وَشُبّانِ",129,"ن",1,0],["وما قَصْدنا بك إلا الجمال","لأنك روضةٌ أهلِ الأدب",130,"ب",1,0],["وما قيل إلا بعض ما أنت عالم","فسِيّانِ فيه مُقْصِرٌ ومُكَثِّر",131,"ر",1,0],["وما قيمةُ الدنيا قياسا لفعلها","حِيالكَ كلا فهْي أَدْنَى وأَحْقَر",131,"ر",1,0],["وما قَصْدُه من بعدِ هذا وهَمُّه","سِوى مكسبٍ يَحْظَى به ويُسامى",132,"م",2,0],["وما قام إحسانُ أضعاف ما","كسبتَ بأيْسر ما قد جَنَى",133,"ن",2,0],["وما قلت هذا الشعر ملتمسا جدا","ولا طالبا بالمدح بذل الدراهم",134,"م",1,0],["وما قمت فيها قائما مذ سكنتها","وإنّي متى رمتُ القيام لأمهَد",135,"د",1,0],["وَما قَرؤوهُ مِنهُما عَن جهالةٍ","فَلا فاهمٌ معنىً ولا عالمٌ سرّا",136,"ر",2,0],["وَما قطّ اِستهلّ لحبس غيثٍ","بِأيسرِ دعوةٍ إلّا اِستهلّا",137,"ل",2,0],["وَما قَصدي اِفتخارٌ غير أنّي","لِشُكرك أَنتقي معنىً وقولا",137,"ل",2,0],["وَما قُلتُها رَهبَةً إِنَّما","يَحِلُّ العِقابُ عَلى المُذنِبِ",138,"ب",1,0],["وَما قُضاعَةُ عَن نَصرِي بِنابِيَةٍ","إِذا تَسامَت قُرومُ الناسِ في لَبَدِ",139,"د",1,0],["وَما قَد كُنتَ تَلهو في اللَيالي","بِمثلِ البكرِ تَتَّبِعُ الغَزالا",140,"ل",2,0],["وما قبلهُ للحب قبلٌ عرفتهُ","ولا بعدهُ اُلفي لذاك الرضا بعدا",141,"د",2,0],["وما قدْرُ اللآلئ وْهيَ درٌّ","إذا لم ينفلقْ عنها المحارُ",142,"ر",1,0],["وما قدمَ الماضينَ أن زمانهم","تقدَّم إنْ بذَّ الجيادَ أخيرها",143,"ر",3,0],["وما قتلَ المحلُ البلادَ وإنما","أصاب الصدا محراثنا فهو مبردُ",144,"د",1,0],["وما قد قسا قلبي ولكن همتي","تعالت فلم تعبأ بغطرسة الدهر",145,"ر",1,0],["وَمَا قَدْ هَمَّ مِنْ هَمِّي","حُلَى جِسْمِي عَلَى الدَّرْزِ",146,"ز",1,0],["وَمَا قَدْ فَاتَ مِنْهَا الْحَصْرَ نَثْراً","وَأَعْجَزَ كُلَّ ذِي قَلَمٍ وَنُونِ",147,"ن",1,0],["وما قيل اقطعوها بالتهاني","وتكرار التحايا والسلام",148,"م",1,0],["وما قال صبٌّ لمحبوبةٍ","عيونكِ أزهى من النرجس",149,"س",1,0],["وما قصبات السبق إلا لهالك","بحب المعالي لا لسالٍ وسالم",150,"م",1,0],["وما قصدت الاك قبل قصائدي","ولم يرها قوم سواك ويسمعوا",151,"ع",3,0],["وما قوةُ الاسلامِ إلا بدولةٍ","خلافيّةٍ بالمسلمينَ قوية",152,"ه",1,0],["وَما قدر الزَمان وَفي قعار","غمام فيضه كرم وجود",153,"د",1,0],["وَما قَلَّ مَنْ تَرْتاحُ مَدْحِي صِفاتُهُ","وَلكِنْ رَأَيْتُ الدُّرَّ أَلْيَقَ بِالنِّظْمِ",154,"م",1,0],["وَما قَلَّ الْوَرى حَتّى تَراهُ","مَكاناً لِلصَّنِيعةِ فِي السُّراةِ",155,"ه",1,0],["وَما قَلبي بِخالٍ مِنهُ يَوماً","فَكَيفَ وَخَدُّهُ بِالخالِ حالي",156,"ي",1,0],["وَما قَهوَةٌ صَيدَنانِيَّةٌ","مِنَ الدَنِّ أَوسَعها القَسُّ زَقّا",157,"ق",2,0],["وما قبرص أبكت كريداً وما رثت","معاهد برنو مصرع الأمن والسعد",158,"د",1,0],["وما قال آه ثم آه توجعاً","حريص على أن يلمع البرق في الرعد",158,"د",1,0],["وَما قَصدي بتحبيرِ القَوافي","سوى لفظٍ أُحبِّرُه وَمَعنى",159,"ن",2,0],["وما قنعوا بعلمِ الغيبِ وَحياً","فأُوتوا علمه نظراً وَقيلا",160,"ل",2,0],["وما قصبات السبق إلا لمن حوى","قوى العزم من تهيج مقصوده العاني",161,"ن",2,0],["وما قد كتبت أنفله في قيد دفتر","لتحفظ ما قد قلت من عيب نسيان",161,"ن",1,0],["وما قد تذكرت افض في الحال مسرعا","والا فقيد بالكتاب لا يقان",161,"ن",1,0],["وَما قيسَ الهلالُ وإن تسامى","لتاجِ جبينكَ الأسمى محلّا",162,"ل",2,0],["وَما قَنعتَ بِها لي خطّةً شُرُعاً","لا بل تنزّلت لي تَسعى بلا أنفِ",163,"ف",1,0],["وما قدر نفس لي لديك حقيرة","فأجعلها مهراً لأشرف وصلة",164,"ه",1,0],["وَما قَد بَدا حالاً فَهَذا نُعِدُّهُ","مَبادي لِإِقبالٍ وَخَيرٍ لِماهِرِ",165,"ر",1,0],["وَما قامَ داعي الأنس يُنشد قائِلاً","عَلامَ فَدَتكَ النَفس تَجفو وَتَهجرُ",166,"ر",1,0],["وَما قَلَّدتك العزَّ فيهِ وَإِنَّما","لَهُ بِكَ عزّ الفَخر أَمسَت تُقلّدُ",167,"د",1,0],["وما قضَى قَطُّ أوطارَ العلا رَجُلٌ","لم يَتَّخِذْ شُعَبَ الأكوارِ أوطانا",168,"ن",2,0],["وما قام قَيسٌ وقَيسٌ معاً","لثأريهما مالكٍ والخَطيم",169,"م",1,0],["وما قصَّرْتُ عن شَأْوٍ ولكنْ","سَقيمٌ كُلُّ ما نَظَمَ السّقيم",170,"م",1,0],["وما قَصَّرتْ بي هِمّةٌ غيرَ أنّه","زمانٌ لِما يَرْجو الكرامُ مَطول",171,"ل",1,0],["وما قصَدْتُك إلاّ بعدَ ما اجتمعَتْ","وَسائلٌ أحصدَتْ للنُّجْحِ أمراسي",172,"س",2,0],["وما قدَّم الأيامُ مثْلَك غَلْطةً","ولكنّ كَفَّ الدّهرِ أعرفُ بالنّقْد",173,"د",1,0],["وما قَلَّ عنك يَقِلّونَ عنه","إذا ضُرِبَتْ للأُمورِ الحُدود",174,"د",1,0],["وما قاتِلي إلا لواحظُ شادنٍ","منَ الرّاعياتِ القلبَ لا البانَ والرَّندا",175,"د",2,0],["وما قلتُ من كلِمٍ تُستَجاَ","د صِدْقاً ومن مِدّحٍ تُرتَضى",176,"ا",1,0],["وَما قَضى الدَهرُ لي مِن قُربِهِ وَطَراً","إِلّا اِقتَضى الوَطَرُ المَقضِيُّ أَوطارا",177,"ر",2,1],["وَما قُلتُ إِنَّ النَجمَ با