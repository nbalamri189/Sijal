{"poems":[[91,"قد قلت حقا فلم تقبله أذهان","https://www.aldiwan.net/poem44873.html","البسيط"],[107,"إلى الله فارغب يا عدي بن حاتم","https://www.aldiwan.net/poem44010.html","الطويل"],[54,"يا سارق الأنوار من شمس الضحى","https://www.aldiwan.net/poem26886.html","الكامل"],[463,"أري طرفها أن الخضابين واحد","https://www.aldiwan.net/poem56245.html","الطويل"],[580,"فرطت فيك فلوعتي لا تنقضي","https://www.aldiwan.net/poem2921.html","الكامل"],[1996,"","https://poetry.dctabudhabi.ae/diwan/poem/82850","المتقارب"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87733","الطويل"],[592,"على قلة الداعي وقلة ذي الفهم","https://www.poetsgate.com/ViewPoem.aspx?id=128814",""],[463,"أرى طرفها أنّ الخضابين واحدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60012&r=&rc=68",""]],"verses":[["اما ضياعك والارزاء قاسية","ففيه للشرق كل الشرق خسران",0,"ن",1,0],["أما ضِقْتَ ذَرعاً إذ علمتَ من العمى","مكانَك أم أنت امرؤٌ غيرُ عالم",1,"م",1,0],["أَمّا ضِياءُ الشَمسِ فيكَ فَناقِصٌ","وَأَرى حَرارَتَها بِها لَم تَنقُصِ",2,"ص",1,0],["أَماضٍ فغدَّراً زمانٌ أباحني","حريمَ الهوى أم حافظٌ لي فعائدُ",3,"د",1,0],["أَمَّا ضَنَائِي عن هَوَاكَ فَقَدْ دَرَى","كيفَ المجِيءُ وما دَرَى كَيْف المُضِي",4,"ض",2,0],["أَم اِضطَرَب البَحر في مَوجِهِ","فَثارَ لِصَخر وَإِذ ما اِنفَلَق",5,"ق",1,0],["أَما ضُرِّعت في المَجد مِنهُم أَماجد","أَما عَقدت للعزّ مِنهُم معاقد",6,"د",1,0],["أما ضرب الفاروق مدة هجرة","صبيغاً بعام آخذاً ذاك عن علم",7,"م",1,0],["أماضٍ فغدارٌ زمانٌ أباحني","حريمَ الهوى أم حافظٌ لي فعائدُ",8,"د",1,0]]}