{"poems":[[71,"لقبوه الحرا بدبس وقد","https://www.aldiwan.net/poem3797.html","الخفيف"],[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[51,"لقبها معشر مغنية","https://www.aldiwan.net/poem64524.html","المنسرح"],[85,"بيتكمو أبا لهب","https://www.aldiwan.net/poem7133.html","مجزوء الرجز"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[45,"يا أخا الحارث بن كعب بن عمر","https://www.aldiwan.net/poem65660.html","الخفيف"],[66,"عاطنيها ممزوجة بالنبات","https://www.aldiwan.net/poem38643.html","الخفيف"],[81,"هاتها كالمنار لاح النهار","https://www.aldiwan.net/poem61524.html","الخفيف"],[48,"لقبلة الراحِ إذ تصلي","https://www.aldiwan.net/poem66577.html","مخلع البسيط"],[50,"لقبيح في الناس من غير جرم","https://www.aldiwan.net/poem24454.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54732","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[106,"تهنئة بوسام","https://www.poetsgate.com/ViewPoem.aspx?id=179504",""],[85,"لكم في الخطِّ سيَّارَهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9740&r=&rc=230",""],[160,"سيعيصني في الحب من ولهي به","https://www.aldiwan.net/poem59099.html","الكامل"],[169,"بع واسطاً بالنأي والهجر","https://www.aldiwan.net/poem1629.html",""],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[229,"يا مالك الحسن تمادى الجفا","https://www.aldiwan.net/poem51214.html","الرجز"],[297,"طاف بدر الدجى بشمس الكؤوس","https://www.aldiwan.net/poem33240.html","الخفيف"],[377,"سعدت نفوس بالإله الأعظم","https://www.aldiwan.net/poem59265.html","الكامل"],[377,"قالت إليك فقلت طرفي أرمد","https://www.aldiwan.net/poem66873.html","الكامل"],[429,"لا والمحيا وصباح الجبين","https://www.aldiwan.net/poem40242.html","السريع"],[432,"أصبحت أعذر عاشقا في حبه","https://www.aldiwan.net/poem12762.html","الكامل"],[455,"حللنا آمنين بخير عيش","https://www.aldiwan.net/poem26618.html","الوافر"],[458,"طرقت على خطر السرى المركوب","https://www.aldiwan.net/poem56281.html","الكامل"],[500,"سألت آرام نجد","https://www.aldiwan.net/poem38059.html","المجتث"],[515,"المدح يدري أنكم أكبر","https://www.aldiwan.net/poem12115.html","السريع"],[551,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[553,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[558,"أنا كالحرف قائم بالمداد","https://www.aldiwan.net/poem34616.html","الخفيف"],[562,"لقبر التويني كل حين كرامة","https://www.aldiwan.net/poem52633.html","الطويل"],[562,"بين ضرب الطلى وطعن الصدور","https://www.aldiwan.net/poem52977.html","الخفيف"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["لَقَّبوهُ الحرا بِدبسٍ وَقَد ما","نوا وَرَبِّ العِبادِ ما فيهِ دبسُ",0,"س",1,1],["لقَّبوا المؤمنين بالكفر ظُلماً","وأطالوا عليهمُ التَّأليبا",1,"ب",2,0],["لقَّبَها معشرٌ مغنيةً","كعقرب الحسنِ لُقِّبت تَمْرَهْ",2,"ه",1,1],["لقبتم أبا الضيا","ضيفكم أبا لهب",3,"ب",1,0],["لَقَّبتُموهُ أَمينَ القَومِ في صِغَرٍ","وَما الأَمينُ عَلى قَولٍ بِمُتَّهَمِ",4,"م",1,0],["لَقَّبوهُ بِخاتِمٍ حَسنُ الأَم","رِ وَلَو أَنصَفوا لَكانَ لِجاما",5,"م",2,0],["لَقَّبوها طَوراً بِباعِثَةِ الفِك","رِ وَطَوراً بِهاضِمِ الأَقواتِ",6,"ت",1,0],["لَقَبُ المَجدِ فيهِ حَقٌّ وَلَكِن","هُوَ لَفظٌ لِغَيرِهِ مُستَعارُ",7,"ر",1,0],["لَقِبلةُ الراحِ إذ تُصلّي","له الأباريقُ بالسجودِ",8,"د",1,1],["لَقَبيحٌ في الناسِ مِن غَيرِ جُرمٍ","بَعدَ وَصلٍ قَطيعَةُ الأَخَوَينِ",9,"ن",1,1],["لقَبٌ بِاسْمِكَ الَّذِي لاَ يُسَامَى","خُطَّ فِي مُسْتَهَلِّ سِفْرٍ مَجِيد",10,"د",1,0],["لَقبانِ ذا مَعكوسُ ذا وَكِلاهُما","حَسنٌ وَقَد يستَقبحُ المَعكوسُ",11,"س",1,0],["لقب رفيع، قارن اسمك مثلما","قُرِن الغناء برنة الأعواد",12,"د",1,0],["لق بدَّلك الدهرُ","من الإقبالِ إدباره",13,"ر",2,0],["لقبت سعيي بالنجاح إليكم","فعساك في تلقيبه تلقى به",14,"ب",2,0],["لُقِّبتَ جَهلاً بِالسَديدِ وَما","سُدِّدتَ في نَهيٍ وَلا أَمرِ",15,"ر",1,0],["لقّبوهُ الأمينَ من قبل هذا","وقليلٌ بين الورى الأمناءُ",16,"ا",2,0],["لقبلةٍ تَجْزِي بها بعضَ ما","أصفيتُه وجهَك من حيّ",17,"ي",1,0],["لُقِّبت بالعَجوز وهي عَروسٌ","فاِعجب اليوم للعَجوز العَروسِ",18,"س",1,0],["لُقِّبتَ نورَ العالمين جميعهم","يا راهباً بل كاملاً إذ ينتمي",19,"م",2,0],["لقبٌ تُخصِّصُهُ به آلاؤه","كنزُ الحياة وفضله لا يجحد",20,"د",1,0],["لقب بالخيريّ لما غدا","طالعه عن كل خيرٍ يبين",21,"ن",1,0],["لقّبتُ تنزيلاً غرامي في الهوى","أرأيت حبّاً قبلَه تنزيلا",22,"ل",2,0],["لَقَبلَ دُموعِ عَينِكَ خَبَّرتَنا","بِما جَمجَمتَ زَفرَتُكَ الصَعودُ",23,"د",1,0],["لقبٌ يصدّق فيك معناه اسمَه","ومن الرجالِ مُمَّوةُ التلقيبِ",24,"ب",1,0],["لِقِبْلةِ الوجهِ منه","أجزاءُ قَلبي أشارَتْ",25,"ت",1,0],["لقب بالناصر لما غدا","بسيفه دين الهدى ينصر",26,"ر",1,0],["لقبٌ كنتُ قبله كاليمانيِّ","قد أتى عارياً بغير بُرودِ",27,"د",1,0],["لَقَبَنَّني أَسماءَ مِنها سَيِّدي","وَأَخي وَسالِبُ مَن أُحِبُّ وَسالِبي",28,"ي",1,0],["لقبول البياض في كل لون","ضد أمر السواد بالإنفراد",29,"د",1,0],["لقبر التُّوَينِي كلَّ حينٍ كرامَةٌ","وفي كلِّ يومٍ رحمةٌ تتجدَّدُ",30,"د",1,1],["لَقَّبوهُ الصغيرَ وهْوَ عليٌّ","إذ رأَوهُ دُونَ الإمام الكبيرِ",31,"ر",1,0],["لقبه الإمام لما إن وهى","باسم شيطان يقال أكمها",32,"ه",2,0]]}