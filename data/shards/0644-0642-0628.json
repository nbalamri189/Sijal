{"poems":[[73,"لقبوه الحرا بدبس وقد","https://www.aldiwan.net/poem3797.html","الخفيف"],[53,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[53,"لقبها معشر مغنية","https://www.aldiwan.net/poem64524.html","المنسرح"],[87,"بيتكمو أبا لهب","https://www.aldiwan.net/poem7133.html","مجزوء الرجز"],[87,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[47,"يا أخا الحارث بن كعب بن عمر","https://www.aldiwan.net/poem65660.html","الخفيف"],[68,"عاطنيها ممزوجة بالنبات","https://www.aldiwan.net/poem38643.html","الخفيف"],[83,"هاتها كالمنار لاح النهار","https://www.aldiwan.net/poem61524.html","الخفيف"],[50,"لقبلة الراحِ إذ تصلي","https://www.aldiwan.net/poem66577.html","مخلع البسيط"],[52,"لقبيح في الناس من غير جرم","https://www.aldiwan.net/poem24454.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54732","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[108,"تهنئة بوسام","https://www.poetsgate.com/ViewPoem.aspx?id=179504",""],[87,"لكم في الخطِّ سيَّارَهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9740&r=&rc=230",""],[164,"سيعيصني في الحب من ولهي به","https://www.aldiwan.net/poem59099.html","الكامل"],[173,"بع واسطاً بالنأي والهجر","https://www.aldiwan.net/poem1629.html",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[234,"يا مالك الحسن تمادى الجفا","https://www.aldiwan.net/poem51214.html","الرجز"],[302,"طاف بدر الدجى بشمس الكؤوس","https://www.aldiwan.net/poem33240.html","الخفيف"],[382,"سعدت نفوس بالإله الأعظم","https://www.aldiwan.net/poem59265.html","الكامل"],[382,"قالت إليك فقلت طرفي أرمد","https://www.aldiwan.net/poem66873.html","الكامل"],[435,"لا والمحيا وصباح الجبين","https://www.aldiwan.net/poem40242.html","السريع"],[438,"أصبحت أعذر عاشقا في حبه","https://www.aldiwan.net/poem12762.html","الكامل"],[460,"حللنا آمنين بخير عيش","https://www.aldiwan.net/poem26618.html","الوافر"],[463,"طرقت على خطر السرى المركوب","https://www.aldiwan.net/poem56281.html","الكامل"],[505,"سألت آرام نجد","https://www.aldiwan.net/poem38059.html","المجتث"],[520,"المدح يدري أنكم أكبر","https://www.aldiwan.net/poem12115.html","السريع"],[556,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[558,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[563,"أنا كالحرف قائم بالمداد","https://www.aldiwan.net/poem34616.html","الخفيف"],[567,"لقبر التويني كل حين كرامة","https://www.aldiwan.net/poem52633.html","الطويل"],[567,"بين ضرب الطلى وطعن الصدور","https://www.aldiwan.net/poem52977.html","الخفيف"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48876","الخفيف"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/146434","الخفيف"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203679","المتقارب"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64661","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79991","المنسرح"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48908","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88643","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93683","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93696","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200555","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200226","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74254","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134161","الرمل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100760","البسيط"],[3207,"","https://poetry.dctabudhabi.ae/diwan/poem/144658","البسيط"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71367","الوافر"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3434,"","https://poetry.dctabudhabi.ae/diwan/poem/203219","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89311","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74040","المديد"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106804","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205754",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216619","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114235","الوافر"],[3864,"","https://poetry.dctabudhabi.ae/diwan/poem/144804","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[463,"طرقتْ على خطر السرى المركوبِ","https://www.poetsgate.com/ViewPoem.aspx?id=25003",""],[5186,"\"أيهذا \"\"الدبور\"\" أين الحمار","https://www.poetsgate.com/ViewPoem.aspx?id=156553",""],[5542,"يا فارس الكرسي","https://www.poetsgate.com/ViewPoem.aspx?id=9679",""],[5561,"بلاء الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=196888",""],[5776,"رملٌ يسافرُ بالواحة","https://www.poetsgate.com/ViewPoem.aspx?id=199342",""],[6033,"نفرتُ إلى ربّي","https://www.poetsgate.com/ViewPoem.aspx?id=215800",""]],"verses":[["لَقَّبوهُ الحرا بِدبسٍ وَقَد ما","نوا وَرَبِّ العِبادِ ما فيهِ دبسُ",0,"س",1,1],["لقَّبوا المؤمنين بالكفر ظُلماً","وأطالوا عليهمُ التَّأليبا",1,"ب",2,0],["لقَّبَها معشرٌ مغنيةً","كعقرب الحسنِ لُقِّبت تَمْرَهْ",2,"ه",1,1],["لقبتم أبا الضيا","ضيفكم أبا لهب",3,"ب",1,0],["لَقَّبتُموهُ أَمينَ القَومِ في صِغَرٍ","وَما الأَمينُ عَلى قَولٍ بِمُتَّهَمِ",4,"م",1,0],["لَقَّبوهُ بِخاتِمٍ حَسنُ الأَم","رِ وَلَو أَنصَفوا لَكانَ لِجاما",5,"م",2,0],["لَقَّبوها طَوراً بِباعِثَةِ الفِك","رِ وَطَوراً بِهاضِمِ الأَقواتِ",6,"ت",1,0],["لَقَبُ المَجدِ فيهِ حَقٌّ وَلَكِن","هُوَ لَفظٌ لِغَيرِهِ مُستَعارُ",7,"ر",1,0],["لَقِبلةُ الراحِ إذ تُصلّي","له الأباريقُ بالسجودِ",8,"د",1,1],["لَقَبيحٌ في الناسِ مِن غَيرِ جُرمٍ","بَعدَ وَصلٍ قَطيعَةُ الأَخَوَينِ",9,"ن",1,1],["لقَبٌ بِاسْمِكَ الَّذِي لاَ يُسَامَى","خُطَّ فِي مُسْتَهَلِّ سِفْرٍ مَجِيد",10,"د",1,0],["لَقبانِ ذا مَعكوسُ ذا وَكِلاهُما","حَسنٌ وَقَد يستَقبحُ المَعكوسُ",11,"س",1,0],["لقب رفيع، قارن اسمك مثلما","قُرِن الغناء برنة الأعواد",12,"د",1,0],["لق بدَّلك الدهرُ","من الإقبالِ إدباره",13,"ر",2,0],["لقبت سعيي بالنجاح إليكم","فعساك في تلقيبه تلقى به",14,"ب",2,0],["لُقِّبتَ جَهلاً بِالسَديدِ وَما","سُدِّدتَ في نَهيٍ وَلا أَمرِ",15,"ر",1,0],["لقّبوهُ الأمينَ من قبل هذا","وقليلٌ بين الورى الأمناءُ",16,"ا",2,0],["لقبلةٍ تَجْزِي بها بعضَ ما","أصفيتُه وجهَك من حيّ",17,"ي",1,0],["لُقِّبت بالعَجوز وهي عَروسٌ","فاِعجب اليوم للعَجوز العَروسِ",18,"س",1,0],["لُقِّبتَ نورَ العالمين جميعهم","يا راهباً بل كاملاً إذ ينتمي",19,"م",2,0],["لقبٌ تُخصِّصُهُ به آلاؤه","كنزُ الحياة وفضله لا يجحد",20,"د",1,0],["لقب بالخيريّ لما غدا","طالعه عن كل خيرٍ يبين",21,"ن",1,0],["لقّبتُ تنزيلاً غرامي في الهوى","أرأيت حبّاً قبلَه تنزيلا",22,"ل",2,0],["لَقَبلَ دُموعِ عَينِكَ خَبَّرتَنا","بِما جَمجَمتَ زَفرَتُكَ الصَعودُ",23,"د",1,0],["لقبٌ يصدّق فيك معناه اسمَه","ومن الرجالِ مُمَّوةُ التلقيبِ",24,"ب",1,0],["لِقِبْلةِ الوجهِ منه","أجزاءُ قَلبي أشارَتْ",25,"ت",1,0],["لقب بالناصر لما غدا","بسيفه دين الهدى ينصر",26,"ر",1,0],["لقبٌ كنتُ قبله كاليمانيِّ","قد أتى عارياً بغير بُرودِ",27,"د",1,0],["لَقَبَنَّني أَسماءَ مِنها سَيِّدي","وَأَخي وَسالِبُ مَن أُحِبُّ وَسالِبي",28,"ب",2,0],["لقبول البياض في كل لون","ضد أمر السواد بالإنفراد",29,"د",1,0],["لقبر التُّوَينِي كلَّ حينٍ كرامَةٌ","وفي كلِّ يومٍ رحمةٌ تتجدَّدُ",30,"د",1,1],["لَقَّبوهُ الصغيرَ وهْوَ عليٌّ","إذ رأَوهُ دُونَ الإمام الكبيرِ",31,"ر",1,0],["لقبه الإمام لما إن وهى","باسم شيطان يقال أكمها",32,"ه",2,0],["لقب الرتبة التي هي حق ال","علم في ذمة الحمى وضمانه",33,"ن",2,0],["لقبوه بحامضٍ وهو حلوٌ","قول من لم يصل إلى العنقود",34,"د",1,0],["لقبّلتُها قبلة العاشقين","وأرسلتها زفرهً كاويةْ",35,"ي",2,0],["لَقَّبوهُ سَيْفاً وما كلُّ سَيفٍ","مِنْ أَياديهِ لِلسُّيوفِ مَضاءُ",36,"ا",2,0],["لقبره استقى سحاب حياً","والسحب من راحتيه صيّبُها",37,"ب",3,0],["لقبٌ نلتَه بحقّ ويكفي","حَملُه من شذا الغوانيَ عِطرا",38,"ر",2,0],["لَقَّبُوها أمَّ الخبائثِ حقّاً","فهي أقوى حبائل الشيطانِ",39,"ن",1,0],["لَقَّبُوها أُمَّ الخبائث قِدماص","حيث مالَت بالنفسِ زال الحَياء",40,"ا",2,0],["لقبوه بصالح وهو جزء","من معان لهن قد كان كلا",41,"ل",2,0],["لقبر عليّ قَربوه وَأَرخوا","بِأَعلى محل الخلد يقبر مزعل",42,"ل",1,0],["لِقَبر الهاديين بِهِ سَلَكنا","بِذَنب لا نَطيق بِهِ نَقوم",43,"م",1,0],["لقبر أبي ذهبت بيوم بؤس","يكاد به الفتى ينسى أباه",44,"ا",2,1],["لقباح الورى على الغيد فضلٌ","إذ يضيع الجمال بين الحسان",45,"ن",1,0],["لقبة مَولانا علي أَشعة","تغشي عَلى الأَبصار وَالأَعيُن الدعج",46,"ج",1,1],["لقبول الصوم عند الله أجر","دام بالخيرات يوليك الأماني",47,"ي",1,1],["لقبوك ولو تدري بما صنعوا","ما اخترت لاسمك الا عسكراً لقبا",48,"ب",2,1],["لقبته لقباً من بعد إمرته","والله بدله بالإمرة اللقبا",49,"ب",2,0],["لِقِبْلَةِ وَجْهِهِ أبَداً صَلاَتِي","وَلَثْمُ الوَرْدِ مِنْ خَدَّيْهِ وِرْدِي",50,"د",2,0],["لقبه عند الاعاريب السهى","وجاء في بعض الروايات السنا",51,"ن",2,0],["لقبه الاعراب كلب الراعي","بقرب نجم مشرق لماع",51,"ع",1,0],["لقبه مقدم الذراعين","بينهما فاعلمه برأى العين",51,"ن",1,0],["لقبه الاعراب قلب العقرب","يجيء في اشعارهم والخطب",51,"ب",1,0],["لقبه قيطس أهل الروم","وكل منسوب إلى النجوم",51,"م",1,0],["لقبها الفرس بعرش الجبار","كذلكم يذكر اهل الاخبار",51,"ر",1,0],["لقبها المنجمون الباطئة","وهي من نجم السماك دانيه",51,"ه",1,0],["لقبلت حد السيف حباً لطرفه","وعانقت من شوقي له الأسمر اللدنا",52,"ن",2,0],["لقبوله قد أرخوا","أنشأ قنطرة العلا",53,"ل",2,0],["لقّبوهُ بالأديبِ وَما","عنده شَيءٌ من الأدبِ",54,"ب",1,0],["لِقُبَّةِ الرِّيح والأفراحُ ناظرةٌ","تاجُ المُلوكِ الإِمَامُ الشَّيخُ أنشَانِي",55,"ي",1,0],["لقبي في صحبي هِمَّا","ظلموني في اسمي ظلما",56,"ا",1,0],["لقبحتِ من عمياء تقرأ في الدجى","إذا أسودّ أسطار الخراب الخوافيا",57,"ي",2,0],["لِقَبرِ الهَاشِمِيِّ وَيَا","لِذَاكَ القَبرِ مِن قَبرِ",58,"ر",1,0],["لقبت بالكمال ستراً على","نقصك كالباني على الخص",59,"ص",1,1],["لِقَبرِ إيلو ذَلِكَ الدَردَنُسي","يَبغونَ إِليونَ بِحَرِّ النَفسِ",60,"س",1,0],["لقبٌ يصدق فيك معناه اسمه","ومن الرجالِ مموهُ التقليبِ",61,"ب",1,0],["لقب البغل غير ألقاب فخر","نالها بالتزلف الأغيار",62,"ر",1,0],["لقب الشهادةِ مَطْمَحٌ لم تدَّخر","وُسْعَاً لتحمله فكنتَ وكانا",63,"ن",2,0],["لَقبرٌ به الموتُ الذليلُ مكانُهُ","وما ميّتٌ بالعزِّ مَنْ ضمَّهُ القبرُ",64,"ر",1,0],["لقبلِ القبلِ مبدؤهُ","ويُنهي البعدَ ذا الزورقْ",65,"ق",1,0],["لقِبلَتِهِ أحبو إذا كَلَّ كاهلي","أُضَمِّخُ في تُربِ السُّجودِ جبينيا.",66,"ي",2,0]]}