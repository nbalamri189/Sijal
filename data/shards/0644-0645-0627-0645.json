{"poems":[[53,"أسل بدمعك وادي الحي إن بانوا","https://www.aldiwan.net/poem29743.html","البسيط"],[77,"عجبا لوجد لا يلين شديده","https://www.aldiwan.net/poem36606.html","الكامل"],[9,"يا لقيس لما لقينا العاما","https://www.aldiwan.net/poem21985.html","الخفيف"],[27,"أرق العيون فنومهن غرار","https://www.aldiwan.net/poem5743.html","الكامل"],[51,"لما رأيت الشعر أصبح خاملا","https://www.aldiwan.net/poem9389.html","الكامل"],[51,"ما مدمعي حذر النوى بقريح","https://www.aldiwan.net/poem9403.html","الكامل"],[85,"دهر مصائبه عندي بلا عدد","https://www.aldiwan.net/poem7301.html","البسيط"],[45,"شغلان من عذل ومن تفنيد","https://www.aldiwan.net/poem63493.html","الكامل"],[61,"لما مضى اليوم حميدا فانجرد","https://www.aldiwan.net/poem51690.html","الرجز"],[66,"أدرها بأمن لا يغيرك الوهم","https://www.aldiwan.net/poem40294.html","الطويل"],[44,"أصغى إلى البين مغترا فلا جرما","https://www.aldiwan.net/poem30366.html","البسيط"],[105,"من حق ركبك أن يهز النيلا","https://www.aldiwan.net/poem43063.html","الكامل"],[105,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[40,"هاج الفؤاد وأمسى الحلم قد عزبا","https://www.aldiwan.net/poem42289.html","البسيط"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[48,"يا بهجة الدنيا التي","https://www.aldiwan.net/poem62477.html","مجزوء الكامل"],[50,"أفد الرحيل وحثني صحبي","https://www.aldiwan.net/poem64845.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39684","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19254","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19074","البسيط"],[105,"الله أكبر باسم الله أهديها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54930&r=&rc=100",""],[75,"كَذبَ السلوُّ، العِشقُ أيسَرُ مركبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10785&r=&rc=5",""],[155,"لم أمش في طرق العزاء لأنني","https://www.aldiwan.net/poem55628.html","الكامل"],[160,"أعلي ترجف بالوعيد وتوجف","https://www.aldiwan.net/poem58672.html","الكامل"],[160,"كذا فليعانا ما أهم إذا اعتلا","https://www.aldiwan.net/poem58857.html","الطويل"],[211,"بعد عامين من صدود وحيف","https://www.aldiwan.net/poem46291.html","الخفيف"],[227,"يا من هواه أعزه وأذلني","https://www.aldiwan.net/poem34055.html","عموديه"],[231,"أبا صالح ما العيش بعدك صالح","https://www.aldiwan.net/poem44572.html","الطويل"],[235,"لم أمس في سفك الدماء محكما","https://www.aldiwan.net/poem32188.html","الكامل"],[250,"قفا تبك من ذكرى قميصي وسروال","https://www.aldiwan.net/poem15019.html","الطويل"],[270,"أبصرت في المرآة وجهي أصفرا","https://www.aldiwan.net/poem35209.html","الكامل"],[270,"سيفي عشقت كما عشقت الحاجبا","https://www.aldiwan.net/poem35456.html","الكامل"],[282,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[282,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[349,"لما مررت بتربة مرت بها","https://www.aldiwan.net/poem15881.html","الكامل"],[364,"أهلا بوجهك من صباح مقبل","https://www.aldiwan.net/poem60681.html","الكامل"],[366,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[388,"يا ثقاتي نقل الأعداء","https://www.aldiwan.net/poem3690.html","مجزوء الرمل"],[403,"هل جرى مني لذا الهجر ذنوب","https://www.aldiwan.net/poem34159.html","الرمل"],[432,"لم يطق هواه فباحا","https://www.aldiwan.net/poem12581.html","المديد"],[437,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[441,"لا يمنع الموت حجاب ولا زرد","https://www.aldiwan.net/poem14449.html","البسيط"],[458,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[461,"رعى الله مجدا صاحبيا تنقلت","https://www.aldiwan.net/poem16031.html","الطويل"],[515,"هي سلوة حلت عقود وفائها","https://www.aldiwan.net/poem11999.html","الكامل"],[551,"قرت عيون بني النبي محمد","https://www.aldiwan.net/poem47856.html","الكامل"],[551,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[562,"من آل يارد في هذا الضريح فتى","https://www.aldiwan.net/poem52590.html","البسيط"],[562,"تلك الكريمة من بني ذبانة","https://www.aldiwan.net/poem52629.html","الكامل"],[562,"جمعت من أفضل الأسماء في القدم","https://www.aldiwan.net/poem52833.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"]],"verses":[["لَمّا مَرَرنا عَلى تِلكَ السُروبِ ضُحىً","نَصَت إِلى الرَبعِ أَجيادٌ وَأَعيانُ",0,"ن",1,0],["لمّا مرَرْتَ الى مُصلاّهُ ضُحىً","والتُّرْبُ يلْثِمُ أخْمصَيْكَ صَعيدُهُ",1,"د",2,0],["لِم أَمَرتُم عَبداً لِيَهجُوَ قَوماً","ظالِميهِم مِن غَيرِ جُرمٍ كِراما",2,"م",2,0],["لَمّا مَلَكتَ عَصا الخِلافَةِ بَيَّنَت","لِلطالِبينَ شَمائِلٌ وَنِجارُ",3,"ر",1,0],["لم أمتدحْه لخَلَّةٍ أبصرتُها","في مجده فسددتها بمديحِ",4,"ح",1,0],["لم أمتدحه لِخلَّةٍ ألفَيْتُهَا","في مجده فَسَدَدْتُهَا بمَدِيحِ",5,"ح",1,0],["لما مددت يدى بالشر منتقما","منها نهاني أبي عن أن أمدّ دي",6,"ي",1,0],["لَمّا مَشَينَ بِذي الأَراكِ تَشابَهَت","أَعطافُ قُضبانٍ بِهِ وَقُدودِ",7,"د",1,0],["لَمَّا مضَى اليومُ حميداً فانجرَدْ","ونشَرَ الَّليلُ جَناحاً فرَكَدْ",8,"د",1,1],["لَمّا ماتَ مَن سَمّوهُ بِاللَفظِ خالِداً","وَلا خَرَّ مَلِكٌ في الثَرى وَاِسمُهُ نَجمُ",9,"م",1,0],["لَمّا مَخَضتَ الأَمانِيَّ الَّتي اِحتَلَبوا","عادَت هُموماً وَكانَت قَبلَهُ هِمَما",10,"م",2,0],["لَمّا مَشى بَينَ المَواكِبِ لَم يَدَع","لِمُتَوَّجٍ عَرشاً وَلا إِكليلا",11,"ل",2,0],["لَمّا مَضى القَومُ في أَحكامِهِم شَطَطاً","أَوحى إِلَيها صَوابَ الحُكمِ موحيها",12,"ي",3,0],["لَمّا مَدَدتُ بِحَبل القَلبِ نَحوَكُمُ","خَفَّ الفُؤادُ لِما تَهوَينَ فَانجَذَبا",13,"ب",2,0],["لمْ أُمْطَرِ الوَسمِيَّ إلاّ بعدَما","سبَقَ الولِيُّ له وقد غَمَرَ الرُّبَى",14,"ب",2,0],["لَمّا مَشى في نَعلِ هِم","مَتِهِ إِلى العَلياءِ زَلَّت",15,"ت",1,0],["لَمّا مَرَرتُ بِها مُسَتَّرَةً","في الحَيِّ بَينَ خَرائِدٍ عُربِ",16,"ب",1,0],["لما مشى في الأرض فجر صخرها","ماء ونضرها ربى وبطاحا",17,"ح",2,0],["لَما مَلَأَ الشَبابَ كَروحِ سَعدٍ","وَلا جَعَلَ الحَياةَ لَهُم طِماحا",18,"ح",2,0],["لَمّا مُلِئنا قُنوطاً مِن سَلامَتِها","تَوَثَّبَت أُسُدُ الآجامِ تَحميها",19,"ي",3,0],["لما مضى القوم في أحكامهم شططاً","أوحى إليه صواب الحكم موحيها",20,"ي",3,0],["لمْ أمطرِ الوسميَّ إلاّ بعدَ ما","أقول دمى ً وهيَ الحسانُ الرّعابيبُ",21,"ب",1,0],["لَمْ أَمْشِ في طُرُقِ العَزاءِ لأَنَّني","غَالي السُّلُوِّ رَخِيصُ فَيْضِ الأَدْمُعِ",22,"ع",1,1],["لما منحتك فوق ما تعتاد من","غيري وجاء إليك مالا تألف",23,"ف",1,0],["لما مُكِنَ الشيطان منهم يضلهم","ولا غور الرحمن رأيالهم أصلا",24,"ل",2,0],["لم أمت بالجوى كما قد ظننتم","إنما مات بالجوى من جفاني",25,"ي",1,0],["لما ملكت قياد سري بالهوى","وعلمت أني عاشق لك خنتني",26,"ن",2,0],["لما مات ما أحييت من سنن الهدى","بعلمك فليرغم حسود وكاشح",27,"ح",1,0],["لَم أُمسِ في سَفكِ الدِماءِ مُحَكَّماً","حَتّى عُرِفتُ بِخِدمَةِ الحُكَماءِ",28,"ا",2,1],["لما مآل نحو الخِدرِ خِدرِ عُنيزةٍ","ولا باتَ عن حُسنِها سالي",29,"ي",1,0],["لما مَرَرتُ بدارِ لُبنى أنكرَت","ما كان من عهد الشباب وما جرى",30,"ر",2,0],["لما مَدَدتُ يدي إليه كسارقٍ","زَحزَحتُ عن صبحِ اليقينِ غياهبا",31,"ب",2,0],["لَم أُمسِ في غَمراتِ العِشقِ مُنغَمِساً","وَلَم تُؤَنِّفنِيَ العُذّالُ بِالعَذَلِ",32,"ل",1,0],["لَمّا مَلَكتَ حُصونَ أَنطاكِيَّةٍ","يَئِسَ الصَليبُ وَحِزبُهُ مِن مُظهِرِ",33,"ر",1,0],["لَمّا مَرَرتُ بِتُربَةٍ مَرَّت بِها","لَيلى وَلاحَت دونَها الأَعلامُ",34,"م",1,1],["لم أمتدِحْ طلَبَ النّوالِ وإنّما","أغْنَى وُصولٌ عن طِلابِ تَوَصُّل",35,"ل",1,0],["لَما مَدَدتُ إِلَيهِ راحَتي أَنَفاً","وَلا رَفَعتُ إِلَيهِ ناظِري كَسَلا",36,"ل",2,0],["لم أُمَنِّ النَفسَ إلّا","كنتمُ أقصى التَمنّي",37,"ن",2,0],["لم أميز ما الذي أنكرته","حالكم في جفوتي حال عجيب",38,"ب",1,0],["لم أُمِلْ فكري الى من سِواهُ","وطِلابُ الجِدِّ يُنسي المِزاحا",39,"ح",2,0],["لما مدحت بما أملت صفاتكم","ذلت صعاب القوافي بعد طغيان",40,"ن",1,0],["لما مررت بدار كان ساكنها","وحةض نعماه فيه والورى يرد",41,"د",1,0],["لما ملكتِ بالخداع جسدي","نقلتِ قلبي وسكنت الأضلعا",42,"ع",2,0],["لما مَرَّ يومٌ خالياً عن بَدائِعٍ","من المَدْحِ يرويهنَّ بادٍ وحاضر",43,"ر",1,0],["لما مدحت علاه أيقنت العدى","أن الزمان أجار من عدوائها",44,"ا",3,0],["لمّا مشتْ فيه الظّنونُ وأوسعتْ","طَمَعاً يروح مع العدوِّ ويغتدِي",45,"د",2,0],["لمّا مَرَرْنَ بنا خطفن قلوبَنا","وقلوبُهنّ مقيمةٌ لا تبرحُ",46,"ح",1,0],["لمَّا مَضَى نحوَ باريهِ على عَجَلٍ","وهَدَّ من فَقْدهِ للأهلِ أركانا",47,"ن",2,0],["لمَّا مَضَتْ مِن بيتِ عيدٍ أرَّخوا","أضحَى لمريمَ بيتُ عيدٍ في السَّما",48,"م",2,0],["لم أمتدِحْ لكَ فضلاً قَصدَ شُهرتِهِ","فذاكَ أشهَرُ من نارٍ على عَلَمِ",49,"م",1,0],["لما مضى كلهم لصلبه","مستترين بعده بحسبه",50,"ه",1,0],["لما مَلكْتَ قُلوبَنا","سَارَت بسيرتِكَ السَّرائِر",51,"ر",1,0]]}