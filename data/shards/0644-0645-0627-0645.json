{"poems":[[55,"أسل بدمعك وادي الحي إن بانوا","https://www.aldiwan.net/poem29743.html","البسيط"],[79,"عجبا لوجد لا يلين شديده","https://www.aldiwan.net/poem36606.html","الكامل"],[9,"يا لقيس لما لقينا العاما","https://www.aldiwan.net/poem21985.html","الخفيف"],[29,"أرق العيون فنومهن غرار","https://www.aldiwan.net/poem5743.html","الكامل"],[53,"لما رأيت الشعر أصبح خاملا","https://www.aldiwan.net/poem9389.html","الكامل"],[53,"ما مدمعي حذر النوى بقريح","https://www.aldiwan.net/poem9403.html","الكامل"],[87,"دهر مصائبه عندي بلا عدد","https://www.aldiwan.net/poem7301.html","البسيط"],[47,"شغلان من عذل ومن تفنيد","https://www.aldiwan.net/poem63493.html","الكامل"],[63,"لما مضى اليوم حميدا فانجرد","https://www.aldiwan.net/poem51690.html","الرجز"],[68,"أدرها بأمن لا يغيرك الوهم","https://www.aldiwan.net/poem40294.html","الطويل"],[46,"أصغى إلى البين مغترا فلا جرما","https://www.aldiwan.net/poem30366.html","البسيط"],[107,"من حق ركبك أن يهز النيلا","https://www.aldiwan.net/poem43063.html","الكامل"],[107,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[42,"هاج الفؤاد وأمسى الحلم قد عزبا","https://www.aldiwan.net/poem42289.html","البسيط"],[77,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[50,"يا بهجة الدنيا التي","https://www.aldiwan.net/poem62477.html","مجزوء الكامل"],[52,"أفد الرحيل وحثني صحبي","https://www.aldiwan.net/poem64845.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39684","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19254","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19074","البسيط"],[107,"الله أكبر باسم الله أهديها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54930&r=&rc=100",""],[77,"كَذبَ السلوُّ، العِشقُ أيسَرُ مركبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10785&r=&rc=5",""],[159,"لم أمش في طرق العزاء لأنني","https://www.aldiwan.net/poem55628.html","الكامل"],[164,"أعلي ترجف بالوعيد وتوجف","https://www.aldiwan.net/poem58672.html","الكامل"],[164,"كذا فليعانا ما أهم إذا اعتلا","https://www.aldiwan.net/poem58857.html","الطويل"],[215,"بعد عامين من صدود وحيف","https://www.aldiwan.net/poem46291.html","الخفيف"],[232,"يا من هواه أعزه وأذلني","https://www.aldiwan.net/poem34055.html","عموديه"],[236,"أبا صالح ما العيش بعدك صالح","https://www.aldiwan.net/poem44572.html","الطويل"],[240,"لم أمس في سفك الدماء محكما","https://www.aldiwan.net/poem32188.html","الكامل"],[255,"قفا تبك من ذكرى قميصي وسروال","https://www.aldiwan.net/poem15019.html","الطويل"],[275,"أبصرت في المرآة وجهي أصفرا","https://www.aldiwan.net/poem35209.html","الكامل"],[275,"سيفي عشقت كما عشقت الحاجبا","https://www.aldiwan.net/poem35456.html","الكامل"],[287,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[287,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[354,"لما مررت بتربة مرت بها","https://www.aldiwan.net/poem15881.html","الكامل"],[369,"أهلا بوجهك من صباح مقبل","https://www.aldiwan.net/poem60681.html","الكامل"],[371,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[393,"يا ثقاتي نقل الأعداء","https://www.aldiwan.net/poem3690.html","مجزوء الرمل"],[409,"هل جرى مني لذا الهجر ذنوب","https://www.aldiwan.net/poem34159.html","الرمل"],[438,"لم يطق هواه فباحا","https://www.aldiwan.net/poem12581.html","المديد"],[443,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[447,"لا يمنع الموت حجاب ولا زرد","https://www.aldiwan.net/poem14449.html","البسيط"],[463,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[466,"رعى الله مجدا صاحبيا تنقلت","https://www.aldiwan.net/poem16031.html","الطويل"],[520,"هي سلوة حلت عقود وفائها","https://www.aldiwan.net/poem11999.html","الكامل"],[556,"قرت عيون بني النبي محمد","https://www.aldiwan.net/poem47856.html","الكامل"],[556,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[567,"من آل يارد في هذا الضريح فتى","https://www.aldiwan.net/poem52590.html","البسيط"],[567,"تلك الكريمة من بني ذبانة","https://www.aldiwan.net/poem52629.html","الكامل"],[567,"جمعت من أفضل الأسماء في القدم","https://www.aldiwan.net/poem52833.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138370",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138291",""],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110458","الكامل"],[841,"","https://poetry.dctabudhabi.ae/diwan/poem/199364","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62456","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119978","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80236","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64593","الكامل"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20586","الهزج"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26672","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77981","الكامل"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45373","البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132281","الوافر"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116538","الكامل"],[1996,"","https://poetry.dctabudhabi.ae/diwan/poem/82848","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108492","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89553","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47124","الكامل"],[2296,"","https://poetry.dctabudhabi.ae/diwan/poem/138927","الرجز"],[2315,"","https://poetry.dctabudhabi.ae/diwan/poem/198762","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120742","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137119",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94133","المجتث"],[3048,"","https://poetry.dctabudhabi.ae/diwan/poem/100611","المجتث"],[3344,"","https://poetry.dctabudhabi.ae/diwan/poem/146493","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112335","السريع"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88960","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88912","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103939","السريع"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138633",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45903","الكامل"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122298","الكامل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75718","الوافر"],[4155,"","https://poetry.dctabudhabi.ae/diwan/poem/178109","الطويل"],[4216,"","https://poetry.dctabudhabi.ae/diwan/poem/20852","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54336","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28725","البسيط"],[4525,"","https://poetry.dctabudhabi.ae/diwan/poem/124050","الوافر"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67535","الكامل"],[4767,"يا ليتني","https://www.poetsgate.com/ViewPoem.aspx?id=210248",""],[4879,"لما مددت إليه راحة راحةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181478",""],[4981,"موعظة","https://www.poetsgate.com/ViewPoem.aspx?id=191763",""],[5002,"شوكة الأوجاع....","https://www.poetsgate.com/ViewPoem.aspx?id=205730",""],[5120,"هَلِ انْتَهَى أَرَقُ الْأَحْلاَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=179959",""],[5232,"ثورة غزل","https://www.poetsgate.com/ViewPoem.aspx?id=212586",""],[5285,"إشارة خضراء","https://www.poetsgate.com/ViewPoem.aspx?id=203516",""],[5397,"هل من ضناي معالج يبريني","https://www.poetsgate.com/ViewPoem.aspx?id=157932",""],[5436,"السفر الى ضفاف الرافدين (محمود محمد أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=58602",""],[5644,"رحل الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=198640",""],[5897,"على جناح أمنية","https://www.poetsgate.com/ViewPoem.aspx?id=156541",""],[1920,"ياسمين بابلي","https://www.poetsgate.com/ViewPoem.aspx?id=191433",""],[5956,"حبيبةُ الأزهارِ","https://www.poetsgate.com/ViewPoem.aspx?id=193363",""],[5975,"عذّبيني","https://www.poetsgate.com/ViewPoem.aspx?id=53252",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""],[2638,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87865&r=&rc=22",""],[6308,"وتسألُ الدار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87722&r=&rc=0",""]],"verses":[["لَمّا مَرَرنا عَلى تِلكَ السُروبِ ضُحىً","نَصَت إِلى الرَبعِ أَجيادٌ وَأَعيانُ",0,"ن",1,0],["لمّا مرَرْتَ الى مُصلاّهُ ضُحىً","والتُّرْبُ يلْثِمُ أخْمصَيْكَ صَعيدُهُ",1,"د",2,0],["لِم أَمَرتُم عَبداً لِيَهجُوَ قَوماً","ظالِميهِم مِن غَيرِ جُرمٍ كِراما",2,"م",2,0],["لَمّا مَلَكتَ عَصا الخِلافَةِ بَيَّنَت","لِلطالِبينَ شَمائِلٌ وَنِجارُ",3,"ر",1,0],["لم أمتدحْه لخَلَّةٍ أبصرتُها","في مجده فسددتها بمديحِ",4,"ح",1,0],["لم أمتدحه لِخلَّةٍ ألفَيْتُهَا","في مجده فَسَدَدْتُهَا بمَدِيحِ",5,"ح",1,0],["لما مددت يدى بالشر منتقما","منها نهاني أبي عن أن أمدّ دي",6,"د",2,0],["لَمّا مَشَينَ بِذي الأَراكِ تَشابَهَت","أَعطافُ قُضبانٍ بِهِ وَقُدودِ",7,"د",1,0],["لَمَّا مضَى اليومُ حميداً فانجرَدْ","ونشَرَ الَّليلُ جَناحاً فرَكَدْ",8,"د",1,1],["لَمّا ماتَ مَن سَمّوهُ بِاللَفظِ خالِداً","وَلا خَرَّ مَلِكٌ في الثَرى وَاِسمُهُ نَجمُ",9,"م",1,0],["لَمّا مَخَضتَ الأَمانِيَّ الَّتي اِحتَلَبوا","عادَت هُموماً وَكانَت قَبلَهُ هِمَما",10,"م",2,0],["لَمّا مَشى بَينَ المَواكِبِ لَم يَدَع","لِمُتَوَّجٍ عَرشاً وَلا إِكليلا",11,"ل",2,0],["لَمّا مَضى القَومُ في أَحكامِهِم شَطَطاً","أَوحى إِلَيها صَوابَ الحُكمِ موحيها",12,"ي",3,0],["لَمّا مَدَدتُ بِحَبل القَلبِ نَحوَكُمُ","خَفَّ الفُؤادُ لِما تَهوَينَ فَانجَذَبا",13,"ب",2,0],["لمْ أُمْطَرِ الوَسمِيَّ إلاّ بعدَما","سبَقَ الولِيُّ له وقد غَمَرَ الرُّبَى",14,"ب",2,0],["لَمّا مَشى في نَعلِ هِم","مَتِهِ إِلى العَلياءِ زَلَّت",15,"ت",1,0],["لَمّا مَرَرتُ بِها مُسَتَّرَةً","في الحَيِّ بَينَ خَرائِدٍ عُربِ",16,"ب",1,0],["لما مشى في الأرض فجر صخرها","ماء ونضرها ربى وبطاحا",17,"ح",2,0],["لَما مَلَأَ الشَبابَ كَروحِ سَعدٍ","وَلا جَعَلَ الحَياةَ لَهُم طِماحا",18,"ح",2,0],["لَمّا مُلِئنا قُنوطاً مِن سَلامَتِها","تَوَثَّبَت أُسُدُ الآجامِ تَحميها",19,"ي",3,0],["لما مضى القوم في أحكامهم شططاً","أوحى إليه صواب الحكم موحيها",20,"ي",3,0],["لمْ أمطرِ الوسميَّ إلاّ بعدَ ما","أقول دمى ً وهيَ الحسانُ الرّعابيبُ",21,"ب",1,0],["لَمْ أَمْشِ في طُرُقِ العَزاءِ لأَنَّني","غَالي السُّلُوِّ رَخِيصُ فَيْضِ الأَدْمُعِ",22,"ع",1,1],["لما منحتك فوق ما تعتاد من","غيري وجاء إليك مالا تألف",23,"ف",1,0],["لما مُكِنَ الشيطان منهم يضلهم","ولا غور الرحمن رأيالهم أصلا",24,"ل",2,0],["لم أمت بالجوى كما قد ظننتم","إنما مات بالجوى من جفاني",25,"ن",2,0],["لما ملكت قياد سري بالهوى","وعلمت أني عاشق لك خنتني",26,"ن",2,0],["لما مات ما أحييت من سنن الهدى","بعلمك فليرغم حسود وكاشح",27,"ح",1,0],["لَم أُمسِ في سَفكِ الدِماءِ مُحَكَّماً","حَتّى عُرِفتُ بِخِدمَةِ الحُكَماءِ",28,"ا",2,1],["لما مآل نحو الخِدرِ خِدرِ عُنيزةٍ","ولا باتَ عن حُسنِها سالي",29,"ل",2,0],["لما مَرَرتُ بدارِ لُبنى أنكرَت","ما كان من عهد الشباب وما جرى",30,"ر",2,0],["لما مَدَدتُ يدي إليه كسارقٍ","زَحزَحتُ عن صبحِ اليقينِ غياهبا",31,"ب",2,0],["لَم أُمسِ في غَمراتِ العِشقِ مُنغَمِساً","وَلَم تُؤَنِّفنِيَ العُذّالُ بِالعَذَلِ",32,"ل",1,0],["لَمّا مَلَكتَ حُصونَ أَنطاكِيَّةٍ","يَئِسَ الصَليبُ وَحِزبُهُ مِن مُظهِرِ",33,"ر",1,0],["لَمّا مَرَرتُ بِتُربَةٍ مَرَّت بِها","لَيلى وَلاحَت دونَها الأَعلامُ",34,"م",1,1],["لم أمتدِحْ طلَبَ النّوالِ وإنّما","أغْنَى وُصولٌ عن طِلابِ تَوَصُّل",35,"ل",1,0],["لَما مَدَدتُ إِلَيهِ راحَتي أَنَفاً","وَلا رَفَعتُ إِلَيهِ ناظِري كَسَلا",36,"ل",2,0],["لم أُمَنِّ النَفسَ إلّا","كنتمُ أقصى التَمنّي",37,"ن",2,0],["لم أميز ما الذي أنكرته","حالكم في جفوتي حال عجيب",38,"ب",1,0],["لم أُمِلْ فكري الى من سِواهُ","وطِلابُ الجِدِّ يُنسي المِزاحا",39,"ح",2,0],["لما مدحت بما أملت صفاتكم","ذلت صعاب القوافي بعد طغيان",40,"ن",1,0],["لما مررت بدار كان ساكنها","وحةض نعماه فيه والورى يرد",41,"د",1,0],["لما ملكتِ بالخداع جسدي","نقلتِ قلبي وسكنت الأضلعا",42,"ع",2,0],["لما مَرَّ يومٌ خالياً عن بَدائِعٍ","من المَدْحِ يرويهنَّ بادٍ وحاضر",43,"ر",1,0],["لما مدحت علاه أيقنت العدى","أن الزمان أجار من عدوائها",44,"ا",3,0],["لمّا مشتْ فيه الظّنونُ وأوسعتْ","طَمَعاً يروح مع العدوِّ ويغتدِي",45,"د",2,0],["لمّا مَرَرْنَ بنا خطفن قلوبَنا","وقلوبُهنّ مقيمةٌ لا تبرحُ",46,"ح",1,0],["لمَّا مَضَى نحوَ باريهِ على عَجَلٍ","وهَدَّ من فَقْدهِ للأهلِ أركانا",47,"ن",2,0],["لمَّا مَضَتْ مِن بيتِ عيدٍ أرَّخوا","أضحَى لمريمَ بيتُ عيدٍ في السَّما",48,"م",2,0],["لم أمتدِحْ لكَ فضلاً قَصدَ شُهرتِهِ","فذاكَ أشهَرُ من نارٍ على عَلَمِ",49,"م",1,0],["لما مضى كلهم لصلبه","مستترين بعده بحسبه",50,"ه",1,0],["لما مَلكْتَ قُلوبَنا","سَارَت بسيرتِكَ السَّرائِر",51,"ر",1,0],["لما مروءته العظيمة قد بدت","اسديت شكرا للشجاع جزيلا",52,"ل",2,0],["لما مقدسنا اقتفى آثارهم","في كل داء قوله قد أثرا",53,"ر",2,0],["لمَّا مَضَت عن بيت نعمة من بني","حسّون باتَت في السَّما تتنعَّمُ",54,"م",1,1],["لم أمرتم بصرفه وهو مبني","وكذا العدل فيه والعلميه",55,"ه",1,0],["لما مضى بالسيب شهراً جَدَّدت","عَزَماته سيراً وأين المقصد",56,"د",1,0],["لما مررن على الغويرِ ونَثبِهِ","أزرت به منهن كثب مآزرِ",57,"ر",1,0],["لَما ما شَفَقتُم يا كِرام عَلى فَتىً","عافٍ أَلَستُم مَنهَلَ الوَرّادِ",58,"د",1,0],["لما محوت اسمي باسم محققي","مكنت فوق رؤوسهم أقدامي",59,"م",2,0],["لَما مِن إِخوَةٍ بَينَ","قُصورِ الشَأمِ وَالرَدمِ",60,"م",1,0],["لما ملأتُ يدي منهم لأخبرهم","نفضتُ كفّي بأشباهِ اليعاسيب",61,"ب",1,0],["لما مُلئن بحبكم","ومزجن من تسنيمكم",62,"م",1,0],["لَمّا مَلَأتَ دلاءَ المَأثراتِ إِلى","أَكرابِها وَاِحتَبى في حِلمِكَ النادي",63,"د",2,0],["لما من فضله جاءوا بعشر","ففضل القطب ليس له تمام",64,"م",1,0],["لّما مَنَعتِني الوداد فبعدما","حكم التطوُّل أن يذمّ المانعُ",65,"ع",1,0],["لَم أمتع طَرفي وَقَلبي مَلياً","مِنك حَتّى آذنتني بِرَحيلِ",66,"ل",1,0],["لم أمس مغلول اليدين وإنما","امسي فؤادي بالأسى مغلولا",67,"ل",2,0],["لَمّا مَدَحتُكَ قالَ الناسُ كُلُّهُمُ","الآنَ مَدحُكَ بِالمَمدوحِ قَد زانا",68,"ن",2,0],["لمّا مضى جاء البشيرُ بإثره","نوراً به باغي الهداية يهتدِي",69,"د",2,0],["لما مضى الترك مع القرينة","والذكر أن يفيدنا تعيينه",70,"ه",1,0],["لم أمتدحكَ وأنت حيٌ ترزقُ","خوف النفاق وخوف أنّي أخفقُ",71,"ق",1,1],["لمَّا مررتَ إلى المُصَلى قائِماً","بسكينَةِ التَّقوَى مقام مناجِ",72,"ج",1,1],["لما مشيت مغرباً قلبي مشى","يقفو ركابك كالظليم النافر",73,"ر",1,0],["لما مضى عام خمس","وسار أحسن سير",74,"ر",1,1],["لمَّا مدحت نظلما","نظماً وأديت حقه",75,"ه",1,1],["لما مدحتُ الإمامَ أرجو","ما نال غيري من المواهب",76,"ب",1,1],["لما مشوا في مهرجان الجلال","ألم ترَ الدرويش في المهرجان",77,"ن",1,0],["لما محمد أهداه الزمان لنا","حركت تاريخه ظهور مهديه",78,"ه",1,1],["لمام هو أمٌ أهل جد هاشم","مشاهد جهل هام أو هم آمل",79,"ل",1,1],["لما منعت القرب من سيدي","ولج في هجري ولم ينصف",80,"ف",1,1],["لم أملك يد الزمان عناني","وان الدهر بالخطوب رماني",81,"ن",2,1],["لَما مَنحناكُم بِعَفو شامل","مَع قُدرة وَبلاؤُكُم لَم يَنجل",82,"ل",1,0],["لما مضى حتم القضا قلنا رضا","فله الآله فارخوه غفور",83,"ر",1,0],["لما مرت بساحته اللَيالي","عليها حلية الشهب الوسام",84,"م",1,0],["لماماً وأغصان الشبيبة رطبةٌ","وماء الصبا في ورد خدي جائل",85,"ل",1,0],["لَم أَمتَدِح أَحَدا سِواكَ وَإِنَّني","بِصِفاتِ مَجدِكَ في الوَرى أَتَمَثَّلُ",86,"ل",1,0],["لما مضيتُ له براني صرْفهُ","مثلَ اليراعِ فبرْيُهُ لمضائهِ",87,"ا",3,0],["لَم أَمتَدِحكَ رَجاءَ المالِ أَطلُبُهُ","لكِن لِتُلبِسَني التَّحجيل وَالغُرَرا",88,"ر",2,0],["لما منع الرسائل والتحايا","وآيات المحَبّةِ والوداد",89,"د",1,0],["لما ملكت وصالي","آيستني من وصالك",90,"ك",1,0],["لم أملأنْ عَينيَّ من وجهكم","والعمر يجري كاد أن ينتهي",91,"ه",2,0],["لما مددت إليه راحة راحةٍ","من شأنها الإعطاء والإعدام",92,"م",1,1],["لَمّا ( مُحمّدُ ) لانَ في أصحابِه ِ","أمْسَوا إلى دربٍ إليهِ حَجِيْجَا",93,"ج",2,0],["لم أمزقْ مَوْثِقاً أو أخترقْ","سنَّةَ الأحْبابِ ...ذي شِيَمي",94,"م",2,0],["لَمْ أَمْتَثِلْ عِنْدَهَا أَمْرًا لِقَافِيَةٍ","وَ لَمْ يُصَافِحْ خَيَالِي بَعْدَهَا خَبَبَا",95,"ب",2,0],["لمَّا مررتِ العطرُ مُنتشر ٌ","أبطأت ِ فانتعشتْ شراييني",96,"ن",2,0],["لمَّا منحتَ ليَ الجفاءَ وحرَّه","سلَّمتُ أمري للذي سوَّاكا",97,"ك",2,0],["لما محوا آثار سنة أحمد","ضربوا بنيه بصارم مسنون",98,"ن",1,0],["لم أمشِ إلاَّ إذا شاءَتْ وشاءَ الهوى","كرمُ القصيدِ إليها يَنْزَعُ العجبا",99,"ب",2,0],["‏لما مررت بدار من قد كانوا","‏نبضُ الفؤادِ وللهوى عنوانُ",100,"ن",1,1],["لما مضى للحج من ناداهمو","أبطأت أصغي للنداء وأطرقُ",101,"ق",1,0],["لمَّا مَررتُ على بغدادَ أَوقفني","طفلٌ له شغفٌ بالعلم والأدبِ",102,"ب",1,1],["لمّا ملائكة السماء تُعِزّنا","يزداد فيض الشعر كالأنهارِ",103,"ر",1,0],["لم أمِلْ .. لكنْ لا يكونُ خنوعي","وخضوعي وفيَّ منكِ ضياءُ",104,"ا",2,0],["لم أمل للرخيص منها القوافي","شتمت أو كالت رخيص عواء",105,"ا",2,0],["لما مضى نوري السعي","د إلى نهايته المشينة",106,"ن",2,0],["لما مشى الثوار لل","ملك الغرير يجندلونه",106,"ن",2,0],["لمَّا مشينَا... مَشَيْنَا نحْوَ مَغْرِبِنَا","ومشرقُ الدار يَبْكِي وحدَهُ أسَفَا",107,"ف",2,0]]}