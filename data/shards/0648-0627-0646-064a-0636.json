{"poems":[[55,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[47,"مخبرتي برقة أحواج","https://www.aldiwan.net/poem62672.html","السريع"],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[239,"ليهنك أني في حبالك عاني","https://www.aldiwan.net/poem31742.html","الطويل"],[407,"أتسأل عن رحيلي يا بن ودي","https://www.aldiwan.net/poem33966.html","الوافر"],[461,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[482,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[541,"فضلك لا أنساه","https://www.aldiwan.net/poem47510.html","عموديه"],[554,"يا آل خير عباد الله كلهم","https://www.aldiwan.net/poem47180.html","البسيط"],[554,"يا سائلي عن ذنوب الدهر آونة","https://www.aldiwan.net/poem47821.html","البسيط"]],"verses":[["وَإِنّي ضَمينٌ إِن تَجَرَّدَ مازِقٌ","لَغاوٍ مِنَ الأَيّامِ أَن يَتَجَرَّدا",0,"د",2,0],["وَأَن يُضيءَ التاجُ في غُرَّةٍ","قَديمَةِ الإِشراقِ في التاجِ",1,"ج",1,0],["وأن يضق بي أمري فهو متسع","بوسع جاهك في وردي وفي صدري",2,"ر",2,0],["وَأَنّي ضَعيفٌ في هَواكِ تَجَلُّدي","عَلى أَنَّني جَلدٌ عَلى الحَدَثانِ",3,"ن",1,0],["وأن يضحي بطيبة لي قرار","يكون إلى موافاتي للحدي",4,"د",2,0],["وأن يضعَ السيرُ أثقالَهُ","إذا رُفِعتْ حُجْبُ أستارِهِ",5,"ر",2,0],["وأني ضمن قوم لم يسيئوا","إليهم بل دعوهم للوئام",6,"م",1,0],["وأن يَضُوعَ مِن عَبِي","ر عَابقٍ شَذَاهُ",7,"ا",2,0],["وإنْ يَضِلَّ أُناسٌ عن سبيلهِمُ","فليس لِي غيرُ ما أنتمْ به سَنَنُ",8,"ن",1,0],["وإنْ يضقْ خُلُقٌ من صاحب سَئِمٍ","فلم يضقْ بِيَ في ذي الأرض أقطارُ",9,"ر",1,0]]}