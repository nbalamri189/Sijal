{"poems":[[55,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[47,"مخبرتي برقة أحواج","https://www.aldiwan.net/poem62672.html","السريع"],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[240,"ليهنك أني في حبالك عاني","https://www.aldiwan.net/poem31742.html","الطويل"],[409,"أتسأل عن رحيلي يا بن ودي","https://www.aldiwan.net/poem33966.html","الوافر"],[463,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[484,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[543,"فضلك لا أنساه","https://www.aldiwan.net/poem47510.html","عموديه"],[556,"يا آل خير عباد الله كلهم","https://www.aldiwan.net/poem47180.html","البسيط"],[556,"يا سائلي عن ذنوب الدهر آونة","https://www.aldiwan.net/poem47821.html","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38488","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62472","الطويل"],[2353,"","https://poetry.dctabudhabi.ae/diwan/poem/32978","الوافر"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141183","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114308","الطويل"],[1012,"السجسج","https://www.poetsgate.com/ViewPoem.aspx?id=186252",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5322,"فما لسناء النور لاح بقبلة","https://www.poetsgate.com/ViewPoem.aspx?id=120394",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[5190,"شَهد وسُهد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85035&r=&rc=110",""]],"verses":[["وَإِنّي ضَمينٌ إِن تَجَرَّدَ مازِقٌ","لَغاوٍ مِنَ الأَيّامِ أَن يَتَجَرَّدا",0,"د",2,0],["وَأَن يُضيءَ التاجُ في غُرَّةٍ","قَديمَةِ الإِشراقِ في التاجِ",1,"ج",1,0],["وأن يضق بي أمري فهو متسع","بوسع جاهك في وردي وفي صدري",2,"ر",2,0],["وَأَنّي ضَعيفٌ في هَواكِ تَجَلُّدي","عَلى أَنَّني جَلدٌ عَلى الحَدَثانِ",3,"ن",1,0],["وأن يضحي بطيبة لي قرار","يكون إلى موافاتي للحدي",4,"د",2,0],["وأن يضعَ السيرُ أثقالَهُ","إذا رُفِعتْ حُجْبُ أستارِهِ",5,"ر",2,0],["وأني ضمن قوم لم يسيئوا","إليهم بل دعوهم للوئام",6,"م",1,0],["وأن يَضُوعَ مِن عَبِي","ر عَابقٍ شَذَاهُ",7,"ا",2,0],["وإنْ يَضِلَّ أُناسٌ عن سبيلهِمُ","فليس لِي غيرُ ما أنتمْ به سَنَنُ",8,"ن",1,0],["وإنْ يضقْ خُلُقٌ من صاحب سَئِمٍ","فلم يضقْ بِيَ في ذي الأرض أقطارُ",9,"ر",1,0],["وَإِنّي ضَنينٌ بِالّذي قَد هَويتهُ","وَدينُ الهوَى يَأبى مُشارَكة اِثنَينِ",10,"ن",1,1],["وإني ضعيف الصبر في كُلفة الهوى","وإن كنتُ قوّاماً لحمل العظائم",11,"م",1,0],["وَأَن يَضطَّرَهُنَّ الدَهرُ بَعدي","إِلى جَلِفٍ مِنَ الأَعمامِ جافِ",12,"ف",1,0],["وإني ضاري القلب مستوفر النهى","أسر بيسر أو أساء بإعسار",13,"ر",1,0],["وَإِنِّي ضَعِيفُ الصَّبْرِ مَا لِي تَخَلُّصٌ","بِغَيرِ امْتِدَاحِ المُصْطَفَى العَدْلُ الاعْدَلُ",14,"ل",1,0],["وإني ضليع لدى بابهم","وأنت إلي غيرهم تعرج",15,"ج",1,0],["وإني ضيف يا متين فقوني","وأبدل سقامي من شفائك أشقاه",16,"ا",2,0],["وأني ضعيف عاجز متذلل","بباب علاكم فارحموني بمنحة",17,"ه",1,0],["وإنّي ضقت من جزْري","وإنّي مخطئٌ أسهبْ",18,"ب",1,0],["وإِنْ يَضِنَّ ، فَقَد أَشقَى بِلا سَبَبٍ","ومَا عَهِدتُ بِهِ الإِمسَاكَ والبُخْلا",19,"ل",2,0]]}