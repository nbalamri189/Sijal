sgate.com/ViewPoem.aspx?id=182763",""],[6102,"عُد ..","https://www.poetsgate.com/ViewPoem.aspx?id=184447",""],[6102,"لحم ودم","https://www.poetsgate.com/ViewPoem.aspx?id=184863",""],[6124,"عناقُ الحروفِ العاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=109747",""],[6152,"الوداد لا يموت","https://www.poetsgate.com/ViewPoem.aspx?id=204956",""],[5075,"سأظلُ أملأ بالهنَا أقدَاحِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82755&r=&rc=1",""],[6212,"مهرة الشمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1619&r=&rc=0",""],[402,"ذلك الشعب الذي آتاه نصرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=53563&r=&rc=415",""]],"verses":[["أَخطَأتُ في طَلَبي وَأَخطَأَ في","يَأسي وَرَدَّ يَدي بِغَيرِ يَدِ",0,"د",1,0],["أَخُطُّ بِأَطرافِ القَنا كُلَّ بَلدَةٍ","وَأُملي جَلابيبَ المَلا مِن نُدوبِهِ",1,"ب",2,0],["أَخطا الطَريقَ وَأَفنى الزادَ وَاِنقَطَعَت","عَنهُ المَناهِلُ في تَيهاءِ مِقفارِ",2,"ر",1,0],["أَخُطُّ وَأَمحو ما خَطَطتُ بِعَبرَةٍ","تَسُحُّ عَلى القُرطاسِ سَحَّ غُروبِ",3,"ب",1,0],["اِخطُب فَمُلكُكَ يَفقِدُ الإِملاكا","وَاِطلُب فَسَعدُكَ يَضمَنُ الإِدراكا",4,"ك",2,1],["أَخُطُّ وَأَمحو الخَطَّ ثُمَّ أُعيدُهُ","بِكَفّي وَالغِربانُ في الدارِ وَقَّعُ",5,"ع",1,0],["أَخَطا الرَبيعُ بِلادَهُم فَتَيَمَّنوا","وَلِحُبِّهِم أَحبَبتُ كُلَّ يَماني",6,"ن",2,0],["أخطُّ سؤالي بالرِّقاعِ ولا أرى","جفاءَك يا هذا بوصلك ينسخ",7,"خ",1,1],["أخطأتُ قصدي وأنتَ لي بصرٌ","فاركبْ بيَ القصد أيها البصر",8,"ر",1,0],["أخطأت في المصراع مفتتحاً","وأتيت إذ عجَّزتَه بِدعه",9,"ع",2,0],["أخطأت في التقدير يا اب","نَ المومسات وعال فرضُك",10,"ك",1,0],["أَخطَأتَ ما أَمَّلتَ يا ابنَ الغادِر","لَستُ بِورَّادٍ ولا بِصادِر",11,"ر",1,0],["أخطأوا يا حياة في زعمهم أن","نك مفقودة من الاجرام",12,"م",1,0],["أَخطَأوا المَكرُماتِ وَالتَمَسوا قا","رِعَةَ المَجدِ في غَداةِ ضَبابِ",13,"ب",1,0],["أَخطَبُ الخَلقَ راجِلاً فَإِذا رُج","جِلَ خاطَبَت مِنهُ عَينَ البَّليدِ",14,"د",1,0],["أَخٌ طاهِرُ الأَخلاقِ عَذبٌ كَأَنَّهُ","جَنا النَحلِ مَمزوجاً بِماءِ غُمامِ",15,"م",1,1],["أَخٌ طالَما سَرَّني ذِكرُهُ","فَقَد صِرتُ أَشجى لَدى ذِكرِهِ",16,"ر",2,1],["أَخطَأَ الشَيبُ ظُباءً والصِّبا","لو رماها خَذَفاتٍ لأَصاب",17,"ب",1,0],["أخطأتِ يا كاملةَ الحسنِ إذْ","أقمْتِ إسحاقَ مكانَ الزبيرْ",18,"ر",1,0],["أَخطا الرَبيعُ بِلادَهُم فَتَيَمَّنوا","وَلِحُبِّهِم أَحبَبتُ كُلَّ يَمانِ",19,"ن",1,0],["أَخطَأتِ أَنتِ بَدَأتِ بِاِلصَرمِ","وَاِبتَعتِ مِنّا الهَجرَ بِالسِلمِ",20,"م",1,1],["أَخُطُّ وَأَمحو كُلَّ ما قَد خَطَطتُهُ","بِدَمعِيَ وَالغِربانُ حَولِيَ وُقَّعُ",21,"ع",1,0],["أخطأته خُطوةٌ كانت له","حُظوةَ السَّاعِي وفوزَ المجتهد",22,"د",1,0],["أَخطَأتما لَم تَعرفا ما الهَوى","كِلاكُما عَن كنهه تاها",23,"ا",3,0],["أَخطَأتَ يا دَهرُ في تَفَرُّقِنا","وَيحَكَ تُب بَعدَها وَلا تَعُدِ",24,"د",1,1],["أخطأ العلم بالإله","جميع المذاهب",25,"ب",1,1],["أخطأ الشيطانُ مسراها فيا","ضَلَّةَ الشيطانِ في تلك الموامي",26,"م",2,0],["أخطا الأقربون موضعها الدا","ني وفازت بنيله البعداء",27,"ا",2,0],["أَخْطَأَكَ الْحَزْمُ وَأَخْطَأْتَهُ","أَيُحْمَلُ الوَرْدُ إِلى الوَرْدِ",28,"د",1,0],["أَخْطَرَ الأَمْنُ قَلِيقُوْلاَ عَلى","بَالِهِ والْهَزْرُ قَدْ يُعْقِبُ هَزْرَا",29,"ر",2,0],["أَخْطَأَ مَنْ تَوَهَّمَ القَبْرَ لَهُ","حِرْزاً يَقِيهِ بِالرَّدَى مِنَ للرَّدَى",30,"د",2,0],["أَخَطَأَتني الخُطوبُ ما أَخطَأَتهُ","ثُمَّ أَنّي أُصِبتُ لمّا أُصيبا",31,"ب",2,0],["أَخطيبٌ هوى عن الأعوادِ","أم كميٌّ رماهُ ظهرُ الجوادِ؟",32,"د",1,1],["أخطرُ من نار على أحْطَاب!","كم ذات جسم للنُّهى سلاَّب",33,"ب",1,0],["أخطأ الشّيطان مسراها ، فيا","ضلّة الشّيطان تلك الموامي !",34,"م",2,0],["أخٌ طَاهِرُ الأَخْلاقِ عَذْبٌ كَأَنَّهُ","جَنَى النَّحْلِ مَمْزوجا بماءِ غَمَامِ",35,"م",1,1],["أخطب الخلق راجلاً فإذا رج","ل خاطبت منه عين البليد",36,"د",1,0],["أَخْطَى الرَّبِيعُ بِلاَدَهُمْ، فَتَيَمَّنُوا،","ولحبهم أحببتُ كلّ يمانِ",37,"ن",1,0],["أخطأت والله ما وصَف النبي ولا","من دونه بالذي تحكى من الأدب",38,"ب",1,0],["أخطأتِ النّحوَ عِرسُهُ فغَدَت","مرفوعةَ الرِّجلِ وهْيَ مَفْعولَهْ",39,"ه",1,0],["أَخُطوَةُ شَوقٍ في الفُؤادِ تَغَمَّرَت","لِتَنكَأَ قَلباً مُستَهاماً فَيَطرَبا",40,"ب",2,0],["اخطأت لا كان النباتي ولا","كيدا ولا كرامة للورد",41,"د",1,0],["أخطّك هذا أم تصاوير جنّةٍ","تقول بما يهدى الضلال وتفعل",42,"ل",1,0],["أخطك هذا ليت إني لممتر","فما كنت عنى في لظى الياس تسأل",42,"ل",1,0],["أخطك هذا قد عرفت وإنني","سأعرف منه ما الذي سوف أفعل",42,"ل",1,0],["أخطّك هذا آه من ظلم فتنة","تزلزل قلبى في الهوى وتقلقل",42,"ل",1,0],["أخطّك هذا أم تصارير جنّة","لها في كتاب الحب والوحي أسطر",43,"ر",1,0],["أخطك هذا أم سطور روائع","من الوشم في الجسم الجميل تسجّل",44,"ل",1,0],["أخطك هذا لا تبح سروحيه","فعن مدمعي المسفوح يوما ستسأل",44,"ل",1,0],["أخطَاكَ ما كنتَ تَرجُوهُ وتَأمُلُه","فاغسِل يَدَيكَ مِنَ العبَّاسِ بالياسِ",45,"س",1,1],["أخطأت ميعادك","يا طيفها السحري",46,"ي",1,1],["أَخْطَأَتْ عَينيَ في نَقْدِهِمِ","أَيْقَظَ اللَّهُ لَهُمْ عَيْناً مُصِيبَه",47,"ه",1,0],["أخطأ المطلَعَ ذا الصُّبْحُ فهل","عَمِيَ النّاظرُ منه أو تَعامى",48,"م",2,0],["أخ طالما تفدى بأنفس ماله","وأُقسمُ لو أنصفت كنت له الفدا",49,"د",2,0],["أخطأ الفكر وما من مرة","ضل إلا فيك منهاج الرشاد",50,"د",1,0],["أخطبُ منهنّ ناشزاتٍ","لا يتعطّفن للبعالِ",51,"ل",1,0],["أخطِرُ مع جُبني به","في لأمَةٍ المشيِّعِ",52,"ع",1,0],["أخطب لقد عمت رزية خطبه","أكلمٌ لقد جل المصاب عن الكلم",53,"م",1,0],["أَخُطُّ الأَرضَ خَطّاً مِث","لَ خَطِّ الجَمَلِ الفَحلِ",54,"ل",1,0],["أخطوا ولو عددتها تكررت","واتسع القول بها وكثرت",55,"ت",1,0],["اخطأت حقا في مخاطرة بها","اوشكت امسي في الحضيض نزيلا",56,"ل",2,0],["أخطأت في تشبيهه بالعقد إذ","بين العقود الغر نادرة غدا",57,"د",2,0],["أخطيب أرض الرافدين","ومَن له الإرشادُ مَنهَج",58,"ج",1,0],["أخُطَافةٌ في يدي أم جَلَم","أمِ الرّقِّ يُحنى لشقِّ القَلِم",59,"م",1,1],["أَخطأتَ في عَذلي لأَنَّ مُصيبَتي","مِن سَهمِ طَرفٍ لِلفُؤادِ مصيبِ",60,"ب",1,0],["أخطأت بالذم غذ جاءت لنا بفتى","به نفاخر أهل الشام واليمن",61,"ن",1,0],["أَخطَأتُ في وَضعِها فيهِ فَوانَدَمي","وَكُنتُ واضِعها في جلدِ خِنزيرِ",62,"ر",1,0],["أخطأتُ والمخطئ في مذهبي","يُصفَعُ في قِمْته بالدِّلا",63,"ل",2,0],["أخطأ المدعي لحسنك شبها","يا سنا واضح الهدى أو مثيلا",64,"ل",2,0],["أَخطَرُ في بُردَتِها المُسَهَّمَه","وَالرَوضُ في حُلَّتِهِ المُنَمنَمَه",65,"م",2,0],["اِخطَب لِكَأسِكَ نَدماناً فَسِر بِهِ","أَو لا فَنادِم عَلَيها حِكمَةِ الكُتُب",66,"ب",1,1],["اِخطَبهُ حَرا كَريماً ذا مَحافَظَة","يَرى نَدامَكُما مِن أَقرَبِ النَسَبِ",66,"ب",1,0],["أخطأت أن شبّهته في جوده","معنا وكعبا حاتما وبلالا",67,"ل",2,0],["أخُطايَ تضعُفُ عَن طَريقِك في العلا","وَتعوقُها بَيداؤها وَرِمالُها",68,"ل",3,0],["أخطأ من قاس به غيره","ان عمّ جودا أو سطا بالحسام",69,"م",1,0],["أخطه أملح أم خده","ولحظه أفتن أم لفظه",70,"ه",1,0],["أخطأت فيه وقلّ من","هو يهتدي لصوابه",71,"ب",2,0],["اخطفت روعه بها شمس الأصيل","وامزجتها مَعْ حِسِنْها والدلال",72,"ل",1,0],["أخطر بذكرك عند فكرك كي","ف نحن وكيف كنا",73,"ن",2,0],["أخطرت مهري في الرهان بحاجة","ومن اللجاجة ما يضر وينفع",74,"ع",1,1],["أخطرتها وبعد الى التي","يدعو المطي لها ويشدو الحادي",75,"د",2,0],["أخطأ الدهر في صباك ولكن","قبس الشيب قد هداه الصوابا",76,"ب",2,0],["أخطأتَ أخطأتَ يا ابنَ ملجِّمٍ فَلَقَد","أتيتَ على الأذى والوِزرِ إيتانا",77,"ن",2,0],["أخطا وأخطَلَ في قولٍ وفي عَمَلٍ","ولم يُصِب في صالحاتٍ قط تُعتَبَرُ",78,"ر",1,0],["أخط يراع أم قنا الخط أشرعت","يراع لها قلب الكمي المصمم",79,"م",1,0],["أَخْطُو البيوت مخاطراً بحشاشة","يقتادها داعي الهوى وتذكري",80,"ر",2,0],["أخطو الكماة وكم نيام حولها","في محكمات سوابغ وسنوَّر",80,"ر",1,0],["أخطأتُ في ظنّي فكان صنيعُه","فضلاً يجلّ به مَقاماً أفضَلاَ",81,"ل",2,0],["أَخَطَرتَ في تِلكَ المُروجِ عَواطِراً","وَمَلَأتَ قَلبَكَ مِن جَلالِ الوادي",82,"د",2,0],["أخطبك أم خطب العلى والمكارم","ومثواك أم مثوى النهى والعزائم",83,"م",1,1],["أخطأ من مثل يوم العطا","بمستهل السحب جدواه",84,"ا",2,0],["أخطأت يا رب القياس ولم تصب","إذ قست جدواه بفيض غمائم",85,"م",1,0],["أخطّ لك الرثاء وهنَّ رعشٌ","ولا قلمي يمد ولا مدادي",86,"د",2,0],["أخطَّافَ المَكَارِمِ والمَعَالِي","وَرَائِدَ الاستِقَامَةِ وَالصَّوَابِ",87,"ب",1,0],["أخطأ من قال القرودُ أصلكم","فليس في القرود شرّ أو خطر",88,"ر",1,0],["أخطأت يا عقلاً هبطت من السما","وهبطت ثم حللت في الانسان",89,"ن",1,1],["أَخُطُّ وَأَمحو الخَطَّ ثُمَّ أُعيدُهُ","بِكَفِّيَ وَالغِزلانُ حَولِيَ وُقَّعُ",90,"ع",1,0],["أَخطا وَرَدَّ عَلَيَّ غَيرَ جَوابي","وَزَرى عَلَيَّ وَقال