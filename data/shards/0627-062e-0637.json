{"poems":[[53,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[53,"هل الطرف يعطي نظرة من حبيبه","https://www.aldiwan.net/poem30742.html","الطويل"],[55,"يا موقد النار بالهندي والغار","https://www.aldiwan.net/poem26369.html","البسيط"],[55,"أزين نساء العالمين أجيبي","https://www.aldiwan.net/poem26547.html","الطويل"],[73,"اخطب فملكك يفقد الإملاكا","https://www.aldiwan.net/poem11973.html","الكامل"],[30,"أمن دمنة بين القلات وشارع","https://www.aldiwan.net/poem29572.html","الطويل"],[27,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[72,"أخط سؤالي بالرقاع ولا أرى","https://www.aldiwan.net/poem18535.html","الطويل"],[51,"يا ابن الوزيرين لا مواربة","https://www.aldiwan.net/poem64065.html","المنسرح"],[51,"أصل نما بك ربه فرعه","https://www.aldiwan.net/poem65410.html","أحذ الكامل"],[51,"يا خالد ابن الخالدات","https://www.aldiwan.net/poem65801.html","مجزوء الكامل"],[12,"أونس ريح الموت في المكاسر","https://www.aldiwan.net/poem1213.html",""],[89,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[45,"ما على الركب من وقوف الركاب","https://www.aldiwan.net/poem10646.html","الخفيف"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[58,"أخ طاهر الأخلاق عذب كأنه","https://www.aldiwan.net/poem30865.html","الطويل"],[49,"أخ طالما سرني ذكره","https://www.aldiwan.net/poem62116.html","المتقارب"],[80,"غيرته غير الدهر فشاب","https://www.aldiwan.net/poem31541.html","الرمل"],[69,"قولوا لمن تهوى السحاق الذي","https://www.aldiwan.net/poem28156.html","السريع"],[31,"أضحى فؤادك غير ذات أوان","https://www.aldiwan.net/poem41285.html","الكامل"],[31,"أخطأت أنت بدأت بالصرم","https://www.aldiwan.net/poem41327.html","الكامل"],[33,"عشية ما لي حيلة غير أنني","https://www.aldiwan.net/poem25884.html","الطويل"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[102,"كم قائل لو كنت تلقاها","https://www.aldiwan.net/poem33025.html","السريع"],[52,"أخطأت يا دهر في تفرقنا","https://www.aldiwan.net/poem27121.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85862","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19015","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54803","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54770","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[106,"خطيب هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179687",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[96,"عام جديد","https://www.poetsgate.com/ViewPoem.aspx?id=17900",""],[58,"أخٌ طَاهِرُ الأَخْلاقِ عَذْبٌ كَأَنَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=22823",""],[45,"أقصرا قد أطلتما تفنيدي،","https://www.poetsgate.com/ViewPoem.aspx?id=31347",""],[31,"أَضْحَى فُؤَادُكَ غَيْرَ ذَات أَوانِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19116&r=&rc=378",""],[161,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[167,"هجو الخواري عندنا دوله","https://www.aldiwan.net/poem46884.html","المنسرح"],[196,"أتعرف بالصحراء شرقي شابك","https://www.aldiwan.net/poem54400.html","الطويل"],[211,"لا وليال بالحمى من نجد","https://www.aldiwan.net/poem13348.html","الرجز"],[212,"تلقيت من روح الجمال رسالة","https://www.aldiwan.net/poem46317.html","الطويل"],[212,"خطاب كزهر الروض بل هو أنضر","https://www.aldiwan.net/poem46594.html","الطويل"],[212,"أسافر في يوم الثلاثاء ليتني","https://www.aldiwan.net/poem46608.html","الطويل"],[263,"أخطاك ما كنت ترجوه وتأمله","https://www.aldiwan.net/poem68205.html","البسيط"],[329,"أخطأت ميعادك","https://www.aldiwan.net/poem54978.html","مجزوء الرجز"],[349,"وأناس غرني ظاهرهم","https://www.aldiwan.net/poem19890.html","الرمل"],[365,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[417,"أقول لعبد المحسن اليوم منشدا","https://www.aldiwan.net/poem53986.html","الطويل"],[450,"هدر المداد","https://www.aldiwan.net/poem1009.html",""],[459,"لو حملت عتبي الليالي","https://www.aldiwan.net/poem56006.html","مخلع البسيط"],[459,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[465,"لقد غاض بحر العلم بعد أخي العلم","https://www.aldiwan.net/poem3167.html","عموديه"],[544,"أيا تملك يا تمل","https://www.aldiwan.net/poem1760.html","الهزج"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["أَخطَأتُ في طَلَبي وَأَخطَأَ في","يَأسي وَرَدَّ يَدي بِغَيرِ يَدِ",0,"د",1,0],["أَخُطُّ بِأَطرافِ القَنا كُلَّ بَلدَةٍ","وَأُملي جَلابيبَ المَلا مِن نُدوبِهِ",1,"ب",2,0],["أَخطا الطَريقَ وَأَفنى الزادَ وَاِنقَطَعَت","عَنهُ المَناهِلُ في تَيهاءِ مِقفارِ",2,"ر",1,0],["أَخُطُّ وَأَمحو ما خَطَطتُ بِعَبرَةٍ","تَسُحُّ عَلى القُرطاسِ سَحَّ غُروبِ",3,"ب",1,0],["اِخطُب فَمُلكُكَ يَفقِدُ الإِملاكا","وَاِطلُب فَسَعدُكَ يَضمَنُ الإِدراكا",4,"ك",2,1],["أَخُطُّ وَأَمحو الخَطَّ ثُمَّ أُعيدُهُ","بِكَفّي وَالغِربانُ في الدارِ وَقَّعُ",5,"ع",1,0],["أَخَطا الرَبيعُ بِلادَهُم فَتَيَمَّنوا","وَلِحُبِّهِم أَحبَبتُ كُلَّ يَماني",6,"ن",2,0],["أخطُّ سؤالي بالرِّقاعِ ولا أرى","جفاءَك يا هذا بوصلك ينسخ",7,"خ",1,1],["أخطأتُ قصدي وأنتَ لي بصرٌ","فاركبْ بيَ القصد أيها البصر",8,"ر",1,0],["أخطأت في المصراع مفتتحاً","وأتيت إذ عجَّزتَه بِدعه",9,"ع",2,0],["أخطأت في التقدير يا اب","نَ المومسات وعال فرضُك",10,"ك",1,0],["أَخطَأتَ ما أَمَّلتَ يا ابنَ الغادِر","لَستُ بِورَّادٍ ولا بِصادِر",11,"ر",1,0],["أخطأوا يا حياة في زعمهم أن","نك مفقودة من الاجرام",12,"م",1,0],["أَخطَأوا المَكرُماتِ وَالتَمَسوا قا","رِعَةَ المَجدِ في غَداةِ ضَبابِ",13,"ب",1,0],["أَخطَبُ الخَلقَ راجِلاً فَإِذا رُج","جِلَ خاطَبَت مِنهُ عَينَ البَّليدِ",14,"د",1,0],["أَخٌ طاهِرُ الأَخلاقِ عَذبٌ كَأَنَّهُ","جَنا النَحلِ مَمزوجاً بِماءِ غُمامِ",15,"م",1,1],["أَخٌ طالَما سَرَّني ذِكرُهُ","فَقَد صِرتُ أَشجى لَدى ذِكرِهِ",16,"ر",2,1],["أَخطَأَ الشَيبُ ظُباءً والصِّبا","لو رماها خَذَفاتٍ لأَصاب",17,"ب",1,0],["أخطأتِ يا كاملةَ الحسنِ إذْ","أقمْتِ إسحاقَ مكانَ الزبيرْ",18,"ر",1,0],["أَخطا الرَبيعُ بِلادَهُم فَتَيَمَّنوا","وَلِحُبِّهِم أَحبَبتُ كُلَّ يَمانِ",19,"ن",1,0],["أَخطَأتِ أَنتِ بَدَأتِ بِاِلصَرمِ","وَاِبتَعتِ مِنّا الهَجرَ بِالسِلمِ",20,"م",1,1],["أَخُطُّ وَأَمحو كُلَّ ما قَد خَطَطتُهُ","بِدَمعِيَ وَالغِربانُ حَولِيَ وُقَّعُ",21,"ع",1,0],["أخطأته خُطوةٌ كانت له","حُظوةَ السَّاعِي وفوزَ المجتهد",22,"د",1,0],["أَخطَأتما لَم تَعرفا ما الهَوى","كِلاكُما عَن كنهه تاها",23,"ا",3,0],["أَخطَأتَ يا دَهرُ في تَفَرُّقِنا","وَيحَكَ تُب بَعدَها وَلا تَعُدِ",24,"د",1,1],["أخطأ العلم بالإله","جميع المذاهب",25,"ب",1,1],["أخطأ الشيطانُ مسراها فيا","ضَلَّةَ الشيطانِ في تلك الموامي",26,"م",2,0],["أخطا الأقربون موضعها الدا","ني وفازت بنيله البعداء",27,"ا",2,0],["أَخْطَأَكَ الْحَزْمُ وَأَخْطَأْتَهُ","أَيُحْمَلُ الوَرْدُ إِلى الوَرْدِ",28,"د",1,0],["أَخْطَرَ الأَمْنُ قَلِيقُوْلاَ عَلى","بَالِهِ والْهَزْرُ قَدْ يُعْقِبُ هَزْرَا",29,"ر",2,0],["أَخْطَأَ مَنْ تَوَهَّمَ القَبْرَ لَهُ","حِرْزاً يَقِيهِ بِالرَّدَى مِنَ للرَّدَى",30,"د",2,0],["أَخَطَأَتني الخُطوبُ ما أَخطَأَتهُ","ثُمَّ أَنّي أُصِبتُ لمّا أُصيبا",31,"ب",2,0],["أَخطيبٌ هوى عن الأعوادِ","أم كميٌّ رماهُ ظهرُ الجوادِ؟",32,"د",1,1],["أخطرُ من نار على أحْطَاب!","كم ذات جسم للنُّهى سلاَّب",33,"ب",1,0],["أخطأ الشّيطان مسراها ، فيا","ضلّة الشّيطان تلك الموامي !",34,"م",2,0],["أخٌ طَاهِرُ الأَخْلاقِ عَذْبٌ كَأَنَّهُ","جَنَى النَّحْلِ مَمْزوجا بماءِ غَمَامِ",35,"م",1,1],["أخطب الخلق راجلاً فإذا رج","ل خاطبت منه عين البليد",36,"د",1,0],["أَخْطَى الرَّبِيعُ بِلاَدَهُمْ، فَتَيَمَّنُوا،","ولحبهم أحببتُ كلّ يمانِ",37,"ن",1,0],["أخطأت والله ما وصَف النبي ولا","من دونه بالذي تحكى من الأدب",38,"ب",1,0],["أخطأتِ النّحوَ عِرسُهُ فغَدَت","مرفوعةَ الرِّجلِ وهْيَ مَفْعولَهْ",39,"ه",1,0],["أَخُطوَةُ شَوقٍ في الفُؤادِ تَغَمَّرَت","لِتَنكَأَ قَلباً مُستَهاماً فَيَطرَبا",40,"ب",2,0],["اخطأت لا كان النباتي ولا","كيدا ولا كرامة للورد",41,"د",1,0],["أخطّك هذا أم تصاوير جنّةٍ","تقول بما يهدى الضلال وتفعل",42,"ل",1,0],["أخطك هذا ليت إني لممتر","فما كنت عنى في لظى الياس تسأل",42,"ل",1,0],["أخطك هذا قد عرفت وإنني","سأعرف منه ما الذي سوف أفعل",42,"ل",1,0],["أخطّك هذا آه من ظلم فتنة","تزلزل قلبى في الهوى وتقلقل",42,"ل",1,0],["أخطّك هذا أم تصارير جنّة","لها في كتاب الحب والوحي أسطر",43,"ر",1,0],["أخطك هذا أم سطور روائع","من الوشم في الجسم الجميل تسجّل",44,"ل",1,0],["أخطك هذا لا تبح سروحيه","فعن مدمعي المسفوح يوما ستسأل",44,"ل",1,0],["أخطَاكَ ما كنتَ تَرجُوهُ وتَأمُلُه","فاغسِل يَدَيكَ مِنَ العبَّاسِ بالياسِ",45,"س",1,1],["أخطأت ميعادك","يا طيفها السحري",46,"ي",1,1],["أَخْطَأَتْ عَينيَ في نَقْدِهِمِ","أَيْقَظَ اللَّهُ لَهُمْ عَيْناً مُصِيبَه",47,"ه",1,0],["أخطأ المطلَعَ ذا الصُّبْحُ فهل","عَمِيَ النّاظرُ منه أو تَعامى",48,"م",2,0],["أخ طالما تفدى بأنفس ماله","وأُقسمُ لو أنصفت كنت له الفدا",49,"د",2,0],["أخطأ الفكر وما من مرة","ضل إلا فيك منهاج الرشاد",50,"د",1,0],["أخطبُ منهنّ ناشزاتٍ","لا يتعطّفن للبعالِ",51,"ل",1,0],["أخطِرُ مع جُبني به","في لأمَةٍ المشيِّعِ",52,"ع",1,0],["أخطب لقد عمت رزية خطبه","أكلمٌ لقد جل المصاب عن الكلم",53,"م",1,0],["أَخُطُّ الأَرضَ خَطّاً مِث","لَ خَطِّ الجَمَلِ الفَحلِ",54,"ل",1,0],["أخطوا ولو عددتها تكررت","واتسع القول بها وكثرت",55,"ت",1,0]]}