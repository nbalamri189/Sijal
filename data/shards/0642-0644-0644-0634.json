{"poems":[[79,"قل لشمس الدين وقيت الردى","https://www.aldiwan.net/poem36563.html","الرمل"],[99,"بي نزوع إلى الدموع الهوامي","https://www.aldiwan.net/poem24764.html","الخفيف"],[54,"ليت يومي بنهر فروخ عادا","https://www.aldiwan.net/poem27119.html","الخفيف"],[52,"قل لشهر الصيام أنحلت جسمي","https://www.aldiwan.net/poem62257.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[119,"قل لشيخ يؤذي النبي عناداً","https://www.aldiwan.net/poem40846.html","عموديه"],[242,"قل لشمس الفضل غيث المنن","https://www.aldiwan.net/poem19094.html","الرمل"],[333,"اسبقي الشمس كالشعاع وثوبا","https://www.aldiwan.net/poem54975.html","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56214","الرمل"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205628","الخفيف"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128231","الرمل"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110760","السريع"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86354","الرمل"],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""]],"verses":[["قُلْ لشَمْسِ الدّينِ وُقّيتَ الرّدى","لمْ يَدَعْ سُقْمُكَ عِنْدي جَلَدا",0,"د",2,1],["قل لشاكٍ هلا مضيت لتجثو","عند مثوى ميت من الخلان",1,"ن",1,0],["قُل لِشَرِّ بِاللَهِ يا هَمَّ نَفسي","زَوِّديني قَبلَ الحَوادِثِ زادا",2,"د",2,0],["قُل لِشَهرِ الصِيامِ أَنحَلتَ جِسمي","إِنَّ ميقاتَنا طُلوعُ الهِلالِ",3,"ل",1,1],["قل لشيخ قد أتعبته الليالي","لك أن تستريح تحت الرغام",4,"م",1,0],["قل لشكري العظيم أشرقت في","السدّة يمنا وكبرياء ورشدا",5,"د",2,0],["قل لشيخ يؤذي النبي عناداً","برجال من آله اهل حال",6,"ل",1,1],["قُلْ لِشَمْسِ الْفَضْلِ غَيْثِ الْمِنَنِ","أَمَنَارَ الْْمُهْتَدِينَ الْيَمَنِي",7,"ن",2,1],["قل لشعب قاد الشعوب إلى المجد","قديماً ولم يبال الخطوبا",8,"ب",2,0],["قل لشاكٍ جور دهرٍ دهما","هاك نوراً فاستتر واقتبس",9,"س",1,0],["قل لشكري فقد غلا وتمادى","بعض ما أنت فيه يشفى الفؤادا",10,"د",2,1],["قل لشيخ قلبه منها نفور","لا تخف فالله توّاب غفور",11,"ر",1,0],["قل لشهاب الدين يا قانعا","بالعقل كنزا والحيا قوتا",12,"ت",2,1],["قل لشاني المصطفى كنت الفدا","للذي ترهب من أنصله",13,"ه",1,0],["قلْ لشَّهيد \"الصدر\" إنَّك بادئ","ما فات من عمرٍ يهبك دواء",14,"ا",2,0]]}