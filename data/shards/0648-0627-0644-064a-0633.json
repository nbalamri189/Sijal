{"poems":[[65,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[95,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[47,"لم يبق في تلك الرسوم بمنعج","https://www.aldiwan.net/poem62668.html","الكامل"],[30,"طرقت نوار ودون مطرقها","https://www.aldiwan.net/poem5126.html","الكامل"],[2,"لمن الديار غشيتها بالفدفد","https://www.aldiwan.net/poem25034.html","الكامل"],[111,"لن ترضي الله حتى تخلص الورعا","https://www.poetsgate.com/ViewPoem.aspx?id=106",""],[102,"أخر جديد","https://www.poetsgate.com/ViewPoem.aspx?id=50333",""],[214,"نقل الغرام حديث دمعي مرسلا","https://www.aldiwan.net/poem13420.html","الكامل"],[214,"أعريب ذاك الحي من يبرين","https://www.aldiwan.net/poem13559.html","الكامل"],[240,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[354,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[438,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[466,"لم لا أتيته على الرماح اذا","https://www.aldiwan.net/poem15687.html","أحذ الكامل"],[556,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138221",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122780","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136098","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95561","الخفيف"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11858","الكامل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96490","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88650","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60904","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102501","البسيط"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130834",""],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110148","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102947","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77106","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139488",""],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102014","الرمل"],[4935,"قمر الفخار بمجدكم إلي أنواراً","https://www.poetsgate.com/ViewPoem.aspx?id=129378",""],[5189,"قلْ للعبادِ","https://www.poetsgate.com/ViewPoem.aspx?id=195165",""],[5612,"حامِلُ المِصْباحْ","https://www.poetsgate.com/ViewPoem.aspx?id=179612",""],[402,"كم بطل أمسى ولم يسمر","https://www.poetsgate.com/ViewPoem.aspx?id=35749",""],[6125,"رِفقًا بنفسكَ أيها المَحزونُ","https://www.poetsgate.com/ViewPoem.aspx?id=210711",""]],"verses":[["وإِلى سَناءِ الدّولةِ اضْطَرَبَتْ بِنا","شعب الرِّحالِ وغَرَّدَ الرُّكْبانُ",0,"ن",1,0],["والْيِسْرُ بَعْدَ الْعُسْرِ مَوْعُودٌ بِهِ","وَالصَّبْرُبِالْفَرَجِ الْقَرِيبِ مُوَكّلُ",1,"ل",1,0],["وَاليَسِيرُ الذِي تَصِيدُ عَسِيرٌ","وَالضَّئِيلُ الَّذِي تُريدُ جَسِيمُ",2,"م",1,0],["وَإِلى سَراةِ بَني حُمَيدٍ إِنَّهُم","أَمسَوا كَواكِبَ مَذحِجِ اِبنَةِ مَذحِجِ",3,"ج",1,0],["وَإِلى سُلَيمانَ الَّذي سَكَنَت","أَروى الهِضابِ بِهِ مِنَ الذُعرِ",4,"ر",1,0],["وَإِلى سِنانٍ سَيرُها وَوَسيجُها","حَتّى تُلاقِيَهُ بِطَلقِ الأَسعُدِ",5,"د",1,0],["واليسر يصحب مرتاد العلوم اذا","كان ارتيادا عن الأكوان منقطعا",6,"ع",2,0],["وإلى سوق في آخره","منعطف ينشدني أهلا",7,"ل",2,0],["وإلى سما العلياء ترقى صاعدا","والضد يهبط نازلا يهوي إلى",8,"ل",2,0],["والى سما العلياء طفلا قد سما","وسما على الاقران في العشرين",9,"ن",1,0],["وَإِلى ساكِنيهِ مِن","شَجوِ قَلبٍ وَمِن شَجَن",10,"ن",1,0],["وَإِلى سَلعٍ وَنَجدٍ عَطَفَ ال","فُرسَ عَن قَمِّ وَبَلخٍ وَخُوَي",11,"ي",1,0],["والى سَراةِ بني عديٍّ أنتمي","في حيثُ تُنمى العزةُ القعساءُ",12,"ا",2,0],["واِليَّ سَوْقُ الرَّيحِ حامِلَةً","طوداً أشَمَّ وقابِضي بَحْرُ",13,"ر",1,0],["وإلى سِنانٍ فوق هامةِ ذابلٍ","هتّاكِ كلِّ تريبةٍ خرّاقِ",14,"ق",1,0],["واليس مثل الدر عند خليلنا","وحليلها والدر منظره بهج",15,"ج",1,0],["وَإلى سَمّيّ المُصطَفَى وَشَبيهِهِ","في العَدلِ والتَّبجيلِ والتَّعظيمِ",16,"م",1,0],["وإلى سيدي الذي حاز مجدا","هو في عزه رفيع الجناب",17,"ب",1,0],["وإلى ساحة المهيمن فازوا","بوصول أنعم به من وصولِ",18,"ل",1,0],["وَإِلى سُمَيساطٍ قَطَعنَ جِيادُهُ","مِن مارِدَينِ وَتِلكُمُ العَذراءُ",19,"ا",2,0],["والى سُليمة والعفاة وغامد","مَوجُ يقمص بالمشيح الماهر",20,"ر",1,0],["والى سريرك عولوا باكفهم","وعليك كم للقوم من تعويل",21,"ل",1,0],["وإلى سماه بني حُبَيش معشري","جُبْتُ القفارَ مشمّراً من حوشب",22,"ب",1,0],["وآل يس أدعو خالقي بهم","إذ هم ملاذي لدنياي وآخرتي",23,"ي",1,0],["وإلى سنا شمس الاصيل وضوءها","تبرٌ يكللُ فضة الداماء",24,"ا",2,0],["واليُسر وَالعُسر في الدنيا مداولة","إن الحيا يُنبت الأزهار في الأكم",25,"م",1,0],["واليُسرُ يَسنَحُ من مياسرها ولم","يبرَح سنيحُ الامن من إيمانها",26,"ن",3,0],["واليسر مثل العسر ليس بنافع","عيش أغض ولا نعيم أرغد",27,"د",1,0],["وَإِلى سِواكَ فَلا تَكِلني لَحظَة","وَاِمنُن عَلَيَّ بِدائِمِ الإِسعافِ",28,"ف",1,0],["وإلى سادة زكت من ذويه","قد زكت في ولاهم الأزكياء",29,"ا",2,0],["وإلى سيدٍ زكا من بنيه","فزكت منه تسعة أمناءُ",29,"ا",2,0],["وإلى سلع سقى سلع الحيا","عج وبّلغ لأحبائي السلاما",30,"م",2,0],["وإلى سموات الجمال ختانه","باليمن طاز وبالأماني أخبرا",31,"ر",2,0],["واليُسرُ بعد العُسرِ يأتي دائما","مِشكاةُ نورٍ .. خَيرها مَكمولُ",32,"ل",1,0],["واليُسْرُ بعْدَ العُسْرِ يُولَدُ دائِماً","والأُنْسُ للأجْسامِ والأرْواحِ",33,"ح",1,0],["واليسف إن يثلم له صلة","وصلة أنكر إن يكسر",34,"ر",1,0],["واليُسرُ بعد العُسرِ وعدٌ صادقٌ","ما بين بؤسِكَ والنعيمِ يقينُ",35,"ن",1,0]]}