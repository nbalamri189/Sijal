{"poems":[[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[154,"لكل نبي عصمة وأمانة","https://www.aldiwan.net/poem68578.html","الطويل"],[563,"ليت لو كنت إذا قلت أنا","https://www.aldiwan.net/poem33848.html","الرمل"],[566,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138290",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86771","الخفيف"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202069","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79891","المتقارب"],[2196,"","https://poetry.dctabudhabi.ae/diwan/poem/205614","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27846","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27636","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137076",""],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82825","الرمل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199023","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118009","الوافر"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85279","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45951","الخفيف"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4691,"بحجم الكون لو قيسا","https://www.poetsgate.com/ViewPoem.aspx?id=207367",""],[4755,"أَرَانِي في المَنَامِ لَهَا أقُولُ","https://www.poetsgate.com/ViewPoem.aspx?id=184711",""],[4778,"أضعنا القدس","https://www.poetsgate.com/ViewPoem.aspx?id=199872",""],[4784,"برق التهاني في سناه ائتلقا","https://www.poetsgate.com/ViewPoem.aspx?id=170935",""],[4578,"بأفق العز أشرق بدرُ سعدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49395",""],[4984,"لغتنا *","https://www.poetsgate.com/ViewPoem.aspx?id=175635",""],[5002,"كوكبِي....","https://www.poetsgate.com/ViewPoem.aspx?id=211790",""],[5057,"واهِنُ القلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=207364",""],[5397,"سموت أبا السجاد صيد الورى فخرا","https://www.poetsgate.com/ViewPoem.aspx?id=157916",""],[5725,"أبابيل الهيام","https://www.poetsgate.com/ViewPoem.aspx?id=211444",""],[5906,"رسول وآل","https://www.poetsgate.com/ViewPoem.aspx?id=188071",""],[5956,"شقاء الشوق ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181907",""],[5956,"منطقُ الغرب","https://www.poetsgate.com/ViewPoem.aspx?id=192220",""]],"verses":[["بحجة الله قامت في الشقاق لها","بدين ذي الثفنات الحبر ايقان",0,"ن",1,0],["بِحُجَّتِهِ العُليا وَشِرعَتِهِ المُثلى","أَحاطَت بِهِ طِفلاً عِنايَةُ رَبِّهِ",1,"ه",1,0],["بحجاب النفس قومي حجبوا","ويحهم كم يدَّعون الفطنا",2,"ن",2,0],["بِحَجِناتٍ يتَثَقَّبنَ البُهَر","كَأَنَّما يَمزِقنَ بِاللَحمِ الحَوَر",3,"ر",1,0],["بحجاك معهد علمنا من فوقه","علم السعادة والصفا منشور",4,"ر",1,0],["بحجاه سَما رَفيع العَمادِ","مَركز الفَضل وَالعُلا ذو الأَيادي",5,"د",2,1],["بُحَجج مثل السَّرَاج تلْمعُ","تَقْصِمُ كلَّ مُلْحدٍ وتَقْمعُ",6,"ع",1,0],["بحجرِ العناصرِ لم يَبغَقِ","ولولاكَ ثوبُ الدجى ما انسدل",7,"ل",1,0],["بحجة تملأ الألباب موعظة","كالشمس تملأ أبصار البصيرينا",8,"ا",1,0],["بحجرته الغرّا بمسجد يثرب","بحضرةِ عبد الله ذي النائلِ الغمر",9,"ر",1,0],["بحجابي علمت أني لما","جئتكم جئتكم بأمرٍ عُجاب",10,"ب",1,0],["بحجة ان الحرب لم تلق وزرها","ترى أفهذي الحرب ليس لها حد",11,"د",1,0],["بِحِجا المصري أَقَرّا","عُقلاءُ الناسِ طُرّا",12,"ر",2,0],["بحجم جسم العالم المحيط","المستدير الشكل ذي التخيطي",13,"ي",1,0],["بحجر المجد منشاؤه فأكرم","به ملكاً كريماً أريحيا",14,"ي",2,0],["بحجده لذلك العقار","وبيع مائه الزلال الجاري",15,"ي",1,0],["بحجر أبٍ وأي أب","يغذيه على الركب",16,"ب",1,0],["بحجري قد أنشأتها وأبحتها","لفيلا الذي مرقاة ودكم رقى",17,"ق",2,0],["بِحِجىً يُبهِرُ العُقولَ إِذا ما","قَدَحتَهُ ثَواقِبُ الأَنظارِ",18,"ر",1,0],["بِحُجَّةٍ شَعْشَعَتْ أَنوارَ مَذْهَبِها","فَكانَ مِن نُورِهِ إِشْراقُ كَوْكَبِها",19,"ه",2,0],["بحجم الكونِ لو قيسا","هوىً قد كان مدسوسا",20,"س",2,1],["\"بِحَجْرِ اللهِ\" يا قَلَمِي أَغِثنِي","إذا خَطَّ الهُدَى عُوْرٌ وحُوْلُ",21,"ل",1,0],["\"بِحَجْرِ اللهِ\" يا وَطَنِي أَعِدْنَا","إلى التَّغييرِ إنْ فُرِضَ النُّزُولُ",21,"ل",1,0],["بحجة أننا طلاب سلم","ولو لم يجنحوا ،فالآثمينا",22,"ن",2,0],["بحجة زاكية مبرورة","مشكورة السعي علاها سمقا",23,"ق",2,0],["بحجر العز والإقبالِ يربى","ويغدو رائعاً في خير مهدِ",24,"د",1,0],["بحجة مفحمة صيَّرت","عقل الذي أنكرها راضخا",25,"خ",2,0],["بِِحِجْرِي تهَاوَت خُطُوبٌ وَسَهْمِي","رمَى ألفَ خَطبٕ وصَبْرِي عِنايَهْ",26,"ا",3,0],["بحجمِ مَصلَحةِ الإنسانِ سوفَ تَرَى","مِنهُ المَوَدّةَ ... للأطماعِ يحتَكِمُ",27,"م",1,0],["بحجر الهدى طفلا تربيت يافعا","وأرضعك الإيمان من ثدييه درا",28,"ر",2,0],["بحجارة السجيل تعصف قلبه","مضنى على نهج الصبابة ترجعهْ",29,"ع",2,0],["بِحُجَّةِ أنَّ اﻹلٰهَ بِنا","لِسادَةِ يَثرِبَ أعلى النُّخَبْ",30,"ب",1,0],["‏ ‏بحجة شرع أو بحجة نخوة","‏ ‏ وها نحن شِخْنا دون سُكْنى المجامرِ",31,"ر",1,0],["‏ ‏بحجة تنظيم أقاموا سلاسلاً","‏ ‏ تفرّخ في الأرواح ذلَّ الأوامر",31,"ر",1,0],["بحجاراتٍ وراها تختفي","عزة العُرب وما أقسى النّبا..",32,"ب",2,0]]}