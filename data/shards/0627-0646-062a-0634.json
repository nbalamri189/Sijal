{"poems":[[55,"يا كثير الألوان ما أجفاكا","https://www.aldiwan.net/poem26202.html","الخفيف"],[77,"يا سراج الجمال يا ابن سراج","https://www.aldiwan.net/poem36668.html","الخفيف"],[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[72,"وبديع الجمال زين بخال","https://www.aldiwan.net/poem18436.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[51,"يا أبا الصقر زادك الله في المجد","https://www.aldiwan.net/poem65411.html","الخفيف"],[51,"لا عرتك الخطوب يا ابن حريث","https://www.aldiwan.net/poem65778.html","الخفيف"],[51,"يا أبا أيوب هذي كنية","https://www.aldiwan.net/poem65867.html","الرمل"],[89,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[85,"طال عليها القدم","https://www.aldiwan.net/poem63695.html","مجزوء السريع"],[85,"يا ملكا تعبدا","https://www.aldiwan.net/poem63720.html","مجزوء الرجز"],[45,"لأخي الحب عبرة ما تجف","https://www.aldiwan.net/poem65151.html","الخفيف"],[61,"ناديك من مطر الإحسان ممطور","https://www.aldiwan.net/poem51687.html","البسيط"],[80,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[48,"إن تشق عيني بها فقد سعدت","https://www.aldiwan.net/poem63324.html","المنسرح"],[46,"يا تاجر المصر ما أنصفت سائمة","https://www.aldiwan.net/poem23053.html","البسيط"],[46,"إبق في نعمة بقاء الدهور","https://www.aldiwan.net/poem23636.html","الخفيف"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39681","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147506","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[106,"الأسد السجين!","https://www.poetsgate.com/ViewPoem.aspx?id=179522",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[45,"لأخي الحُبّ عَبرَةٌ ما تَجِفُّ","https://www.poetsgate.com/ViewPoem.aspx?id=32543",""],[51,"نفَّرتْ هِيفَك الليالي وغيدَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=28487",""],[116,"يا رفاعي وقعت في أبوابك","https://www.aldiwan.net/poem41238.html","عموديه"],[116,"لمعاليك جئت أعرض حالي","https://www.aldiwan.net/poem42171.html","الخفيف"],[129,"هنيت بالنصر موعودا لك الظفر","https://www.aldiwan.net/poem50605.html","البسيط"],[187,"يا ضريرا له فؤاد ضرير","https://www.aldiwan.net/poem43811.html","الخفيف"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[200,"يا حبيبا إذا حننت إليه","https://www.aldiwan.net/poem45146.html","الخفيف"],[200,"قتل الحب يا ليالي الوداد","https://www.aldiwan.net/poem45191.html","الخفيف"],[230,"هزني للصبوح صبح تبدى","https://www.aldiwan.net/poem50941.html","الخفيف"],[230,"ليس شعري وإن كسا المجد درا","https://www.aldiwan.net/poem51056.html","الخفيف"],[233,"أيها الشيخ دعوة من محب","https://www.aldiwan.net/poem14937.html","الخفيف"],[236,"سيدي يا ابن جعفر أنت أعلى","https://www.aldiwan.net/poem31899.html","الخفيف"],[255,"حبيب العمر","https://www.aldiwan.net/poem36222.html","مجزوء الرمل"],[262,"ربع أسماء لا عداك عنان","https://www.aldiwan.net/poem38168.html","الخفيف"],[272,"رياض نجد بكم جنان","https://www.aldiwan.net/poem52050.html","مخلع البسيط"],[298,"صاح إن جزت بذي الأثل فحي","https://www.aldiwan.net/poem33082.html","الرمل"],[329,"كذبت هند حين قالت لك القل","https://www.aldiwan.net/poem54941.html","الخفيف"],[354,"ما تراءى هلال عام جديد","https://www.aldiwan.net/poem40399.html","الخفيف"],[404,"ما على الصب في الصبابة وصمه","https://www.aldiwan.net/poem33405.html","الخفيف"],[416,"إنتشتكي عنا سمى فإننا","https://www.aldiwan.net/poem1936.html","الكامل"],[417,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[440,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[454,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[539,"إن تشا تحيى سعيدا","https://www.aldiwan.net/poem48212.html","عموديه"],[552,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[552,"مرت بنا بمصلى الخيف سانحة","https://www.aldiwan.net/poem47343.html","البسيط"],[559,"إن تشأ قل أنا وإن شئت قل هو","https://www.aldiwan.net/poem33588.html","الخفيف"],[559,"أنت الذي طول عمري الهم تكفيني","https://www.aldiwan.net/poem33806.html","البسيط"],[559,"وجود كوني من تجلي الجواد","https://www.aldiwan.net/poem34632.html","السريع"],[580,"نفسي تميل إِلى الهوى فأَردها","https://www.aldiwan.net/poem56776.html","الكامل"]],"verses":[["أَنتَ شُغلُ الفُؤادِ عَن كُلِّ شَيءٍ","لَيسَ يَخلو الفُؤادُ حَتّى يَراكا",0,"ك",2,0],["أنْتَ شَمْسي فكُلَّما غابَ عنّي","فنَهاري مِثْلُ الظّلامِ الدّاجِي",1,"ج",2,0],["إن تُشَيَّع بِي المُذَكرَةُ الوَج","نَاءُ تَنفِي لُغَامَهان بِلُغَامِ",2,"م",1,0],["إن تشكى بها الحريقَ فممَّا","فتنَ المؤمنين والمؤمنات",3,"ت",1,0],["أنت شهمٌ مُحصِّلٌ فاترك الأس","ماءَ للبُلْه واكشفِ الأنباءَ",4,"ا",2,0],["أنت شجعتني على الصدق في القو","ل وأرْكبتَ جنبيَ العوصاءَ",4,"ا",2,0],["أنت شر المجدَّدات على الحي","يِ ولا بأس باكتسابي جديدَكْ",5,"ك",1,0],["أنت شمس أضاءت الشرق والغر","ب وأضحى لها إلينا شعاعا",6,"ع",2,0],["أنت شيخٌ عطاؤه حيوانٌ","إذ عطاياهُمُ الجمادُ السبيكُ",7,"ك",1,0],["أنت شِبهٌ للذي تُكنَى به","ولبعضِ الخَلْقِ من بعض مَثلْ",8,"ل",1,0],["انت شمس لها البيان شعاع","لم تمل في طريقها للغروب",9,"ب",1,0],["اِنتَشَرَت لُؤلُؤاً","في المُهَجاتِ اِنتَظَم",10,"م",1,0],["أَنتَ شُعاعٌ مِن عَلٍ","أَنزَلَهُ اللَهُ هُدى",11,"د",2,0],["إِن تَشَكَّت رَعِيَّةٌ سوءَ قَبضٍ","بِكَ أَو عَقَبَ الوِلايَةَ صَرفُ",12,"ف",1,0],["إن تَشْتَكِ الحَدَثُ الحَسناءُ حادثةً","سَعى بها حائنٌ منهم ومَغرورُ",13,"ر",1,0],["أنتَ شَجّعْتَ نفسَ كلّ جبانٍ","فاقترَابُ الأسودِ منه غرورُ",14,"ر",1,0],["إِن تَشقَ عَيني بِها فَقَد سَعِدَت","عَينُ رَسولي وَفُزتُ بِالخَبَرِ",15,"ر",1,1],["إِن تَشكُ قَطعَ طَريقٍ بِالفَلاةِ فَكَم","قَطَعتَ مِن قَبلُ طُرُقَ الناسِ في السوقِ",16,"ق",1,0],["أنتَ شمسُ الضّحى فمنكَ يُفيدُال","صّبْحُ ما فيه من ضِياءٍ ونُورِ",17,"ر",1,0],["إن تَشَيْ راضيةً قَتْلي جَوىً","في الهَوى حَسبي افتخاراً أن تَشَي",18,"ي",1,0],["أَنتَ شيءٌ وَغير شيءٍ وَكافي","كلَّ شيءٍ يا حيرة الحكماء",19,"ا",2,0],["انتشت الأرض من شذاه","وأترعت كأنها الرصيعه",20,"ع",2,0],["أنت شباب الحياة أنت","الجمال في موكب الطليعه",20,"ع",2,0],["انتشروا في عيشهم أعصراً","ثم طواهم قدر فانطووا",21,"و",3,0],["انتشروا قبائلا على الزمن","ملء الحجاز والشآم واليمن",22,"ن",1,0],["إن تشطروا النيل المباركَ، تقطعوا","من مِصرَ خيطَ حياتها الممدودا",23,"د",2,0],["إن تشْك من ذلِّ الإسار، فكلنا","أُسْدٌ تِئنُّ من الإِسار أنينا",24,"ن",2,0],["ان تشكُ ما قاسيتَ من إجهادةٍ","أو تَلقَ ما لاقيت من أتعاب",25,"ب",1,0],["إنْ تَشَكّتْ رَعِيّةٌ سُوءَ قَبْضٍ","بكَ أوْ أعقَبَ الوِلاَيَةَ صَرْفُ",26,"ف",1,0],["أنت شر المجدَّدات على الح","يِّ ولا بأس باكتسابي جديدك",27,"ك",1,0],["انت شيخ ما خيب الله يوما","ما اليه رفعت من آرابك",28,"ك",1,0],["أنت شكل قامت به نقطة الخل","ق وحلت سلاسل الأشكال",29,"ل",1,0],["إن تشكرُوا تَفْلَحوا دُنيا وآخرة","فإنه من ذَوِى الكفران مُنتَصِرُ",30,"ر",1,0],["إن تشرّفت بالقرى أو تكثر","ت ببئر فمعدن الشر بير",31,"ر",1,0],["أنتَ شمسٌ وفي سناكَ ظهوري","غيرُ مُستغربٍ لأنّي هباءُ",32,"ا",2,0],["أنت شخصان في الفؤاد فشخص","عند ظني وآخر في يقيني",33,"ن",2,0],["إن تشأ أن ترى حديثكَ بعدَ ال","موتِ فانظرْ إلى حديثِ العبادِ",34,"د",1,0],["إن تشفِّيت من زماني شفيت الن","نفسَ فيه والله لِي بالتَشفّي",35,"ف",2,0],["أنت شمسٌ وأنت بدرٌ منيرٌ","ليس من شاء كان شمساً وبدرا",36,"ر",2,0],["أَنتَ شيخُ وقد قَرُبت من النَّ","ارِ فكيفَ ادَّهنتَ بالكبريتِ",37,"ت",1,0],["أَنتَ شَمسٌ لِلدينِ حَقّاً وَلِلفَضلِ","سَماءٌ وَلِلأَخِلّاءِ أَرضُ",38,"ض",1,0],["أنتِ شمس، أنت نور","في الدجى مازال يَهدي",39,"د",2,0],["ان تشم بارق الفضائل منه","أعقب البرق عارض هتان",40,"ن",1,0],["أَنتَ شجاع عَلى المَعاصي","وَأَنتَ عَن طاعَتي جبان",41,"ن",1,0],["إِن تُشِر للشَمس والبَدر تقُل","هذه أُختي وذيّاك أخي",42,"ي",1,0],["أنتشي عنده بخمر شهودي","لمكاني وأين منى مكاني",43,"ن",2,0],["أَنتَ شبل النَجيب في كُلّ فَضلٍ","وَكَمالٍ وَكُلُّ خَلقٍ حَميدِ",44,"د",1,0],["إن تشم برق ثغره لتهتك","ت ولم يبق فيك للدين شمه",45,"م",2,0],["إِنتَشتَكي عَنّا سُمىُّ فَإِنَّنا","يَسمو إِلى قحم العُلى أَدنانا",46,"ن",2,1],["إنْ تَشَأْ أَنْقَذْتَهُ أَوْ لا فلا","فَعلى أَيّهما أصْبَحتَ عازم",47,"م",1,0],["إِنْ تُشْرِقِ الدنيا ببارِعِ ذِكْرِهِ","فَمَحَلُّهُ عِنْدَ ابْنِ يَحْيى بارِعُ",48,"ع",1,0],["إنَّ تشريفهَ لنعمىَ عزيزٌ","أن تَرَاهَا وُكلُّها إحسانُ",49,"ن",1,0],["إِن تشَا تحيَى سَعِيدا","وقَوِيا كالأسُود",50,"د",1,1],["أنتَ شاطرتهمْ مقيماً بأوطا","نك ذاك التّكبير والتّهليلا",51,"ل",2,0],["إِنْ تَشكري فاِشكري من لم يُذِقْكِ هوىً","ومَن بحبّك أبلانا وأبلاكِ",52,"ك",1,0],["إن تشأ قل أنا وإن شئتَ قل هو","وكذا إن تشأ فقل أنت تزهو",53,"ه",2,1],["أن تشرح الصدر من ضيق ومن حرج","وتفرج الهم من صعب بتهوين",54,"ن",1,0],["أنت شؤن الحق لا يلتبس","عليك معبود هنا بالعباد",55,"د",1,0],["إِنْ تشتهي لَبَّى، كَمَسْلُوبِ النُّهَى","أَوْ صَبُّ عِشْقٍ قَدْ أُضِلَّ فَتَاهَا!!",56,"ا",3,0]]}