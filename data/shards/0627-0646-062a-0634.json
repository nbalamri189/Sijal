://www.poetsgate.com/ViewPoem.aspx?id=200602",""],[5302,"جعلت فداكا","https://www.poetsgate.com/ViewPoem.aspx?id=205728",""],[5307,"يا عويد البان","https://www.poetsgate.com/ViewPoem.aspx?id=10540",""],[5388,"أقبل الليل","https://www.poetsgate.com/ViewPoem.aspx?id=206922",""],[5431,"قاصرٌ من ذويه ...","https://www.poetsgate.com/ViewPoem.aspx?id=210853",""],[5518,"يا حبيب الله","https://www.poetsgate.com/ViewPoem.aspx?id=188939",""],[5587,"خدعوني لمعاني","https://www.poetsgate.com/ViewPoem.aspx?id=197794",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5605,"مرثية محمود درويش","https://www.poetsgate.com/ViewPoem.aspx?id=159623",""],[5668,"لم أعشق سواه","https://www.poetsgate.com/ViewPoem.aspx?id=179114",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5691,"بحر عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=207064",""],[5701,"إن تشيبي فإنني كيفما كن","https://www.poetsgate.com/ViewPoem.aspx?id=164673",""],[5756,"لمباني","https://www.poetsgate.com/ViewPoem.aspx?id=5420",""],[5756,"الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=5184",""],[5956,"كل يوم نحن في حب جديد","https://www.poetsgate.com/ViewPoem.aspx?id=182078",""],[5956,"ارحميني","https://www.poetsgate.com/ViewPoem.aspx?id=182191",""],[5956,"اشفها يا ربنا لا تُشْقِها","https://www.poetsgate.com/ViewPoem.aspx?id=192142",""],[5956,"جاءني طفلٌ نحيل","https://www.poetsgate.com/ViewPoem.aspx?id=192779",""],[6021,"منى الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=201665",""],[6046,"أنا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=35208",""],[6066,"يَومَ عُرسُكِ يَا أَرِيج","https://www.poetsgate.com/ViewPoem.aspx?id=12670",""],[6068,"قال العواذل هل نسيت غرامها -20-","https://www.poetsgate.com/ViewPoem.aspx?id=175899",""],[4442,"يتنزى هوى على تلعاته","https://www.poetsgate.com/ViewPoem.aspx?id=170995",""],[6125,"قَابَ قَوسَينِ","https://www.poetsgate.com/ViewPoem.aspx?id=210207",""],[6328,"تاء التأنيث","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84884&r=&rc=25",""]],"verses":[["أَنتَ شُغلُ الفُؤادِ عَن كُلِّ شَيءٍ","لَيسَ يَخلو الفُؤادُ حَتّى يَراكا",0,"ك",2,0],["أنْتَ شَمْسي فكُلَّما غابَ عنّي","فنَهاري مِثْلُ الظّلامِ الدّاجِي",1,"ج",2,0],["إن تُشَيَّع بِي المُذَكرَةُ الوَج","نَاءُ تَنفِي لُغَامَهان بِلُغَامِ",2,"م",1,0],["إن تشكى بها الحريقَ فممَّا","فتنَ المؤمنين والمؤمنات",3,"ت",1,0],["أنت شهمٌ مُحصِّلٌ فاترك الأس","ماءَ للبُلْه واكشفِ الأنباءَ",4,"ا",2,0],["أنت شجعتني على الصدق في القو","ل وأرْكبتَ جنبيَ العوصاءَ",4,"ا",2,0],["أنت شر المجدَّدات على الحي","يِ ولا بأس باكتسابي جديدَكْ",5,"ك",1,0],["أنت شمس أضاءت الشرق والغر","ب وأضحى لها إلينا شعاعا",6,"ع",2,0],["أنت شيخٌ عطاؤه حيوانٌ","إذ عطاياهُمُ الجمادُ السبيكُ",7,"ك",1,0],["أنت شِبهٌ للذي تُكنَى به","ولبعضِ الخَلْقِ من بعض مَثلْ",8,"ل",1,0],["انت شمس لها البيان شعاع","لم تمل في طريقها للغروب",9,"ب",1,0],["اِنتَشَرَت لُؤلُؤاً","في المُهَجاتِ اِنتَظَم",10,"م",1,0],["أَنتَ شُعاعٌ مِن عَلٍ","أَنزَلَهُ اللَهُ هُدى",11,"د",2,0],["إِن تَشَكَّت رَعِيَّةٌ سوءَ قَبضٍ","بِكَ أَو عَقَبَ الوِلايَةَ صَرفُ",12,"ف",1,0],["إن تَشْتَكِ الحَدَثُ الحَسناءُ حادثةً","سَعى بها حائنٌ منهم ومَغرورُ",13,"ر",1,0],["أنتَ شَجّعْتَ نفسَ كلّ جبانٍ","فاقترَابُ الأسودِ منه غرورُ",14,"ر",1,0],["إِن تَشقَ عَيني بِها فَقَد سَعِدَت","عَينُ رَسولي وَفُزتُ بِالخَبَرِ",15,"ر",1,1],["إِن تَشكُ قَطعَ طَريقٍ بِالفَلاةِ فَكَم","قَطَعتَ مِن قَبلُ طُرُقَ الناسِ في السوقِ",16,"ق",1,0],["أنتَ شمسُ الضّحى فمنكَ يُفيدُال","صّبْحُ ما فيه من ضِياءٍ ونُورِ",17,"ر",1,0],["إن تَشَيْ راضيةً قَتْلي جَوىً","في الهَوى حَسبي افتخاراً أن تَشَي",18,"ي",1,0],["أَنتَ شيءٌ وَغير شيءٍ وَكافي","كلَّ شيءٍ يا حيرة الحكماء",19,"ا",2,0],["انتشت الأرض من شذاه","وأترعت كأنها الرصيعه",20,"ع",2,0],["أنت شباب الحياة أنت","الجمال في موكب الطليعه",20,"ع",2,0],["انتشروا في عيشهم أعصراً","ثم طواهم قدر فانطووا",21,"و",3,0],["انتشروا قبائلا على الزمن","ملء الحجاز والشآم واليمن",22,"ن",1,0],["إن تشطروا النيل المباركَ، تقطعوا","من مِصرَ خيطَ حياتها الممدودا",23,"د",2,0],["إن تشْك من ذلِّ الإسار، فكلنا","أُسْدٌ تِئنُّ من الإِسار أنينا",24,"ن",2,0],["ان تشكُ ما قاسيتَ من إجهادةٍ","أو تَلقَ ما لاقيت من أتعاب",25,"ب",1,0],["إنْ تَشَكّتْ رَعِيّةٌ سُوءَ قَبْضٍ","بكَ أوْ أعقَبَ الوِلاَيَةَ صَرْفُ",26,"ف",1,0],["أنت شر المجدَّدات على الح","يِّ ولا بأس باكتسابي جديدك",27,"ك",1,0],["انت شيخ ما خيب الله يوما","ما اليه رفعت من آرابك",28,"ك",1,0],["أنت شكل قامت به نقطة الخل","ق وحلت سلاسل الأشكال",29,"ل",1,0],["إن تشكرُوا تَفْلَحوا دُنيا وآخرة","فإنه من ذَوِى الكفران مُنتَصِرُ",30,"ر",1,0],["إن تشرّفت بالقرى أو تكثر","ت ببئر فمعدن الشر بير",31,"ر",1,0],["أنتَ شمسٌ وفي سناكَ ظهوري","غيرُ مُستغربٍ لأنّي هباءُ",32,"ا",2,0],["أنت شخصان في الفؤاد فشخص","عند ظني وآخر في يقيني",33,"ن",2,0],["إن تشأ أن ترى حديثكَ بعدَ ال","موتِ فانظرْ إلى حديثِ العبادِ",34,"د",1,0],["إن تشفِّيت من زماني شفيت الن","نفسَ فيه والله لِي بالتَشفّي",35,"ف",2,0],["أنت شمسٌ وأنت بدرٌ منيرٌ","ليس من شاء كان شمساً وبدرا",36,"ر",2,0],["أَنتَ شيخُ وقد قَرُبت من النَّ","ارِ فكيفَ ادَّهنتَ بالكبريتِ",37,"ت",1,0],["أَنتَ شَمسٌ لِلدينِ حَقّاً وَلِلفَضلِ","سَماءٌ وَلِلأَخِلّاءِ أَرضُ",38,"ض",1,0],["أنتِ شمس، أنت نور","في الدجى مازال يَهدي",39,"د",2,0],["ان تشم بارق الفضائل منه","أعقب البرق عارض هتان",40,"ن",1,0],["أَنتَ شجاع عَلى المَعاصي","وَأَنتَ عَن طاعَتي جبان",41,"ن",1,0],["إِن تُشِر للشَمس والبَدر تقُل","هذه أُختي وذيّاك أخي",42,"ي",1,0],["أنتشي عنده بخمر شهودي","لمكاني وأين منى مكاني",43,"ن",2,0],["أَنتَ شبل النَجيب في كُلّ فَضلٍ","وَكَمالٍ وَكُلُّ خَلقٍ حَميدِ",44,"د",1,0],["إن تشم برق ثغره لتهتك","ت ولم يبق فيك للدين شمه",45,"م",2,0],["إِنتَشتَكي عَنّا سُمىُّ فَإِنَّنا","يَسمو إِلى قحم العُلى أَدنانا",46,"ن",2,1],["إنْ تَشَأْ أَنْقَذْتَهُ أَوْ لا فلا","فَعلى أَيّهما أصْبَحتَ عازم",47,"م",1,0],["إِنْ تُشْرِقِ الدنيا ببارِعِ ذِكْرِهِ","فَمَحَلُّهُ عِنْدَ ابْنِ يَحْيى بارِعُ",48,"ع",1,0],["إنَّ تشريفهَ لنعمىَ عزيزٌ","أن تَرَاهَا وُكلُّها إحسانُ",49,"ن",1,0],["إِن تشَا تحيَى سَعِيدا","وقَوِيا كالأسُود",50,"د",1,1],["أنتَ شاطرتهمْ مقيماً بأوطا","نك ذاك التّكبير والتّهليلا",51,"ل",2,0],["إِنْ تَشكري فاِشكري من لم يُذِقْكِ هوىً","ومَن بحبّك أبلانا وأبلاكِ",52,"ك",1,0],["إن تشأ قل أنا وإن شئتَ قل هو","وكذا إن تشأ فقل أنت تزهو",53,"ه",2,1],["أن تشرح الصدر من ضيق ومن حرج","وتفرج الهم من صعب بتهوين",54,"ن",1,0],["أنت شؤن الحق لا يلتبس","عليك معبود هنا بالعباد",55,"د",1,0],["إِنْ تشتهي لَبَّى، كَمَسْلُوبِ النُّهَى","أَوْ صَبُّ عِشْقٍ قَدْ أُضِلَّ فَتَاهَا!!",56,"ا",3,0],["أنت شبيهُ النبيِّ حقّاً","في الحكمِ والخُلق والسجيّهْ",57,"ي",2,0],["أَنتَ شرّفته وَقَد كانَ يَرجو","قَبل ذا الوَقت أَن تَكون عِماده",58,"د",2,0],["إنْ تَشْدُ فَالأسماعُ رَهْنُ تَشَوُّفٍ","أو تَبْدُ فالأبصارُ رَهْنُ توقُّفِ",59,"ف",1,0],["إن تشغيلنا لمثلك مني","فلتة كان مثل ضرطة وهب",60,"ب",1,0],["أنت شمسُ النهارِ وجهاً وغصنُ ال","بان قَدّاً ومُقْلَةُ الخِشْفِ لحظا",61,"ظ",2,0],["إِن تَشائي فَهوَ صِدقٌ","أَو تَشائي فَهوَ كِذبَهْ",62,"ب",2,0],["أنت شهاب ثاقب نوره","في ظلمة الخطب فمن مصعبُ",63,"ب",1,0],["أنْتَ شَمْسٌ فِي ضُحًى أم","أنْتَ بدرٌ فِي دِجِنَّهْ",64,"ن",2,0],["إن تشأ ينصع الجماد وإن تأ","مر يقم في ركابها القمران",65,"ن",1,0],["أنت شروق ولا غروب","طوباك أنت",66,"ت",1,0],["أنت شيء من نشوة وعبير","أنت رعشات قطعة من سماء",67,"ا",2,0],["إِن تَشكا في ضَناي سلاها","أَو تشكا في ضَناها سَلاني",68,"ن",2,0],["أَنْ تَشْفِ نَفْسِي مِن حَزازاتِ الحَسَكْ","أَجْزِ بِهَا أَطْيَبَ مِنْ رِيح المِسَكْ",69,"ك",1,0],["أنت شاني وأنت حاجات سري","أنت روحي وراحتي والاراده",70,"د",2,0],["أنت شبيهي وشبيه والدي","ومصدر الأمور في الشدائد",71,"د",1,0],["أنت شغلي في كلّ حالٍ فنومي","بخيالٍ ويقظتي باذّكارِ",72,"ر",1,1],["ان تشج حائمة الحمام سواجعاً","فلكم شجاها بالغوير مناحي",73,"ح",2,0],["إن تشا فارسٌ له فارسٌ من","نا وإن شئت باللفيف التقينا",74,"ن",2,0],["أنت شمس وليس ينكر ضوء الشم","س إلا حندوقة عمياء",75,"ا",2,0],["انت شمسي وبدري انت كوني المنير","يَعِلْ تفداك روحي وتستمر بضياك",76,"ك",1,0],["إن تشهد النِيات فِعلاً إنَّه","أعمالُه شهدتُ على نيَّاتهِ",77,"ت",2,0],["إن تَشتُموني فقَد بَدَّلتُ أَيكتُكُم","ذَرقَ الدَجاجِ بِحَفّازِ اليَعاقيبِ",78,"ب",1,0],["أنت شجرة وديوك","يا نخلة الرمّأن",79,"ن",1,1],["أنت شمس العلوم بحر العطايا","منبع الفضل سيد الأنبياء",80,"ا",2,0],["انتشى القمريُّ في الروض فأنْشَدْ","وعلى أغصانه غنّى وغَرَّدْ",81,"د",1,1],["انتشق تربه وقبله واخضع","وتوسد شريف تلك القباب",82,"ب",1,0],["أنت شمس الهدى واقمار ابنا","ك استمدوا منك السنا والسعودا",83,"د",2,0],["أنت شمس الكون والهادي الذي","ملئت ملته الدنيا بلج",84,"ج",1,0],["إِن تَشوَقت للطلا وَإليها","شمت نورين خمرة وَعروسا",85,"س",2,0],["ان تشك بعدك وحشة فلقد غدت","بك تزدهي طرباً بلاد الشام",86,"م",1,0],["أنت شباية لهوي وإذا","مسني ضيم تمثلتك نايا",87,"ا",3,0],["إن تشأ أول الطريق فدعني","فاذا امتدّ لا أُطيق الرجوعا",88,"ع",2,0],["إن تشائي طلقّت حسناء شعري","وسكنتِ الفؤاد من دون أجر",89,"ر",1,0],["أنت شمس تطهر العيب إما","سكبت فيه نورها الوضاء",90,"ا",2,0],["انت شعر مجنح ام خيال","انت معنى في النفس ام وجدانُ",91,"ن",1,0],["أَنتَ شِهابُ الفَضلِ بَل شَمسُهُ","وَهَضبَةُ المَجدِ وَطودُ الحِجى",92,"ا",1,0],["أنت شيدت اتحادا","فغدا شعبك واحد",93,"د",1,0],["أنت شاد بنغمة الشحرور","في رياض المنظوم والمنثور",94,"ر",1,1],["أنت شمس غاب عنّا ضوءها","فأضاءت بقعة أخرى هناك",95,"ك",1,0],["ان تشبه الناس في التشكيل مثلهم","فإن شأنكما في الحق مختلف",96,"ف",1,0],["إِن تَشِم بارقَ الصداقةِ منه","لَمْ تجدْ غير بارقاتٍ كواذِب",97,"ب",1,0],["إنْ تشكُ نفسي ضِيقَ دهرٍ أسرعتْ","ليمينِه فأَنالَها مَا يُوجَد",98,"د",1,0],["إِن تَشغَلوني بِأَعمالٍ أُصَيِّرُها","شُغلاً وَإِلّا فَفي أَعراضِكُم شُغُلُ",99,"ل",1,0],["أنت شيخ المنجمين ولكن","لست في حكمهم تنال السعاده",100,"د",2,0],["إن تشتهي الموت من داءٍ أصبت به","مني يريحك منظومٌ ومنثور",101,"ر",1,0],["أَنتَ شمسٌ لافقنا وهو بَدْرٌ","منكَ يَنبوعُ ضوئِه والنُّورِ",102,"ر",1,0],["ان تشيعه في البسيطة قومٌ","فله شيع الملائك طرا",103,"ر",2,0],["ان تشيع له النواظر وجهاً","لم تشيع له الخواطر ذكرا",104,"ر",2,0],["إِن تَشقَ أَعينُهُ ببعد لقائكم","ففؤاده بَعد الوداد سَعيد",105,"د",1,0],["أنتَ شمس لهيبها في فؤادي","أنت نور لظاه في أحشائي",106,"ا",2,0],["أنت شمس الملوك لما تبدّت","أخفت الفرقدين والجوزاءَ",107,"ا",2,0],["أنت شامس الكل عندي والذي","قاله العذال جدا فهو ومزح",108,"ح",1,0],["ان تشائي تعذيب قلبي عمداً","عذبيه فس