n/poem/34524","المنسرح"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97926","الرمل"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103623","السريع"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85072","الخفيف"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107539","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81234","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33624","المنسرح"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104913","الرمل"],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5186,"\"أصلح الله يا \"\"أسيمى\"\" عقولا","https://www.poetsgate.com/ViewPoem.aspx?id=156507",""],[778,"يا لائماً يعذلني في طربي","https://www.poetsgate.com/ViewPoem.aspx?id=89224",""],[5213,"انشقاني من ربع مية طيبا","https://www.poetsgate.com/ViewPoem.aspx?id=170409",""],[5453,"يالكبار اللي ذخرتوا كل عار","https://www.poetsgate.com/ViewPoem.aspx?id=28015",""],[6034,"الدهر لا يبرح خوانا","https://www.poetsgate.com/ViewPoem.aspx?id=169609",""],[6115,"والله لايبطون ما وصلوا الى مستواك","https://www.poetsgate.com/ViewPoem.aspx?id=196471",""],[5309,"أنكرت عيناي اطياف الذهب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573562",""],[572,"يا راحُ قُمْ فأحْبِنَا بالراحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9211&r=&rc=68",""]],"verses":[["يا لَكَ مِن حافٍ مَشى","حَيثُ يَزِلُ الناعِلُ",0,"ل",1,0],["يالَكِ أَحياءً عَلى عُدوانِها","نِسوانُها أَمنَعُ مِن فُرسانِها",1,"ن",3,0],["يا لكَ من وصلٍ قصير المدى","أبكِي عليهِ طولَ آمادِي",2,"د",2,0],["يا لكَ لحظاً بسعاد أزرى","وجاءَ في الوزنِ مثال سكرى",3,"ر",2,0],["يا لك من صيدٍ مقرّ العين","يرضي الصحاب وهو ذو وجهين",4,"ن",1,0],["يا لكِ من أُمٍّ لها فضلُها","ومن أبٍ أكْرم به من أبِ",5,"ب",1,0],["يَا لَكَ ابْناً ووَالِدَيْنِ وجَدَّيْ","نِ يُرَوْنَ الجبالَ في أخْدُودِ",6,"د",1,0],["يا لك من نُعْمى أبو مُرَّةٍ","مُسْتَحوِزٌ فيها على الحمدِ",7,"د",1,0],["يا لك من أصلَعٍ ذي هامة","قد قَرَّعَتْها خِلَعُ القفْدِ",8,"د",1,0],["يا لك من مالكٍ ومقتدرٍ","مؤتَمِر السوء كلَّ مؤتَمَرِ",9,"ر",1,0],["يا لك من منكرٍ ومعترفٍ","يُكرمُ إنكاره وإقراره",10,"ر",2,0],["يا لك من حكمةٍ ملعَّنةٍ","أمرِّ ما أثمرتْ من الثمرِ",11,"ر",1,0],["يالك من وجهٍ ومن لحيةٍ","ما أشبهَ الجارةَ بالجارِ",12,"ر",1,0],["يا لك من نحلة معسَّلة","وحية منه في سُرادقها",13,"ق",3,0],["يا لك من بائع بلا وَرِقٍ","ينشُده ناقدٌ ولا عين",14,"ن",1,0],["يا لك من مهندس","بنى الدنى وما ونى",15,"ن",2,0],["يالكِ دنيا لذّت نعيما","للقوم واستعذبت بلاء",16,"ا",2,0],["يا لك الويلُ ليسَ يعجز موسى","رجُلٌ حشو جلدِه فرعونُ",17,"ن",1,0],["يا لَكَ مِن جيفَةٍ مُعَفَّنَةٍ","أَيُّ اِمتِناعٍ لَها إِذا طُلِبَت",18,"ت",1,0],["يَا لَكَ مِنْ ذِي أَدَبٍأَطْلَعَتْ","فِكْرَتُهُ ثَاقِبَةَ الأَنْجُمِ",19,"م",1,1],["يا لَك بَلهاء وَدّعت وَمَضَت","أَثني عَلى لطفها وَأَشكرها",20,"ر",3,0],["يا لَكَ مِن ذي حيلَةٍ كَسوبِ","يا لَكَ مِن ذي حيلَةٍ كَسوبِ",21,"ب",1,0],["يا لَكَ مِن كَلبٍ نَسيجِ وَحدِهِ","يا لَكَ مِن كَلبٍ نَسيجِ وَحدِهِ",22,"د",2,0],["يا لَكَ مِن ديكٍ رُبي في المَهدِ","يا لَكَ مِن ديكٍ رُبي في المَهدِ",23,"د",1,0],["يا لَكَ مَيتاً صَلاةُ شيعَتِهِ","عَزفٌ عَلَيهِ وَالنَقرُ بِالوَتَرِ",24,"ر",1,0],["يا لَكِ مِن تُفّاحَةٍ غَضَّةٍ","طَيَّبَها حِبّي بِأَنفاسِهِ",25,"س",2,0],["يا لَكِ مِن قُبَّرَةٍ بِمَعمَرِ","خَلا لَكِ الجَوَّ فَبيضي وَاِصفِري",26,"ر",2,1],["يا لَك مِن لَيل بَهي","مٍ للرجال مفزع",27,"ع",1,0],["يا لَكِ مِن لُعبَةٍ مُشَنَّفَةٍ","قَد سُمّيَت بِاِسمِ حِبَّتي لُعَبا",28,"ب",2,0],["يا لك في الهيجاء من فارس","مشتهر بالصبر بطريق",29,"ق",1,0],["يا لك من راحٍ ومن أنامل","نوائشٍ ألبابَنا نوائل",30,"ل",1,0],["يا لَكِ مِنْ لَيْلَةٍ مُحَسَّدَةٍ","تُعَدُّ فِي الدَّهْرِ غُرَّةَ الدَّهْرِ",31,"ر",1,0],["يا لَكَ الخَيرُ وَالمَراحمُ مَن أَب","قيَتَ فينا لِلحادِثاتِ الجِسامِ",32,"م",1,0],["يا لَكَ اللَهُ ما أَثَرتَ مِن الحُز","ن وَفي المَوت وِردُ ما لا يُرامُ",33,"م",1,0],["يالك من معركةٍ بالحاسي","مع ابن لاوي شاخص الأضراسِ",34,"س",1,1],["يالَكَ مِن لَيلِ حِجا","بٍ جُنحُهُ مُعتَكِرُ",35,"ر",1,1],["يالَكَ مِن يَومٍ لَهُ حُرمَةٌ","تُقَصِّرُ الأَلسُنُ عَن شُكرِهِ",36,"ر",2,1],["يا لَكَ مِن رَزِيَّةٍ أَسرَفَ رَيبُ","الدَهرِ في الرُزءِ بِها وَما اِقتَصَد",37,"د",1,0],["يَا لَكَ الْفَضْلُ مَا تَعَوَّدْتُ إِلاَّ","وَابِلَ الْفَضْلِ لاَ تُعِدْنِي لِوَلْثِهْ",38,"ث",2,0],["يا لك الخير إِن أَتَيتَ رُبى سَل","عٍ وَشارَفت كثبَه وَرمالَه",39,"ل",2,0],["يالك من مركوضة ملساء","رافعة لخصلة دهماء",40,"ا",2,0],["يا لكِ من أيام وصلٍ سلفت","أعقبَها الدهرُ بأيام نوى",41,"ا",1,0],["يا لِكربٍ بِكَربلاء عَظيمٍ","وَلرزءٍ عَلى النَبِيِّ ثَقيلِ",42,"ل",1,0],["يا لك الله فتًى من مُبدِئٍ","بالندى والفضل فينا ومعيد",43,"د",1,0],["يا لك الله مشيراً بالذي","يُرتضى منه وبالخير مُشير",44,"ر",1,0],["يا لك الله هماماً بالذي","يَدْحَضُ الغيَّ وما جانب رشدا",45,"د",2,0],["يا لكَ اللَه قاسماً وهماماً","وذا رشادٍ غضنفراً ريبالا",46,"ل",2,0],["يا لكم من طُغمةٍ فاسدةٍ","تحسب الحمقَ سلاحَ الفاتحين",47,"ن",1,0],["يا لك ربعاً بالنخيل شاخصا","أين الظباء تقنص القوانصا",48,"ص",2,0],["يا لَكَلبٌ هو للِشَّرِّ وعَه","دِيَ بِالكلبِ منَ الشرِّ يَهِر",49,"ر",1,0],["يا لكَ اللهُ هل سمعتَ نُواحاً","في الليالي لهُ الصَفاةُ تَلينُ",50,"ن",1,0],["يا لَكَ اللَهُ مِن أَديبٍ إِذا ما","عَدَّ يَوماً فَغَيرُهُ لَيسَ يُذكَر",51,"ر",1,0],["يا لَكَ اللَه مِن عَزيز مفدّى","فيكَ حلم بِهِ المُلوك تَسود",52,"د",1,0],["يا لَكَ اللَه مِن أَميرٍ تهنا","بِكَ في دَولة العَزيز المَناصب",53,"ب",1,0],["يا لَكَ مِنهُ مَنظَراً أَشهى إِلى","قَلبِيَ مِن جَنَّةِ عَدنٍ أَو أَسَرّْ",54,"ر",1,0],["يا لكَ ليلاً فجرُه السوالِف","خَوْدٌ لها من حُسنِها طرائف",55,"ف",1,0],["يا لَك اللَه تحمّل مالِكاً","لِلَّذي فيه فؤادي انقسما",56,"م",2,0],["يا لَك اللَه من جَفا قَد طالا","وَمَدى ما حباك إِلّا مَطالا",57,"ل",2,1],["يا لَكَ مِن خُرسٍ لَها كَلامُ","مَوتى إِلَيها النَقضُ وَالإِبرامُ",58,"م",1,0],["يا لَكَ يَوماً قَلَّ فيهِ ثِقَتي","وَغابَ عَنّي مَعشَري وَأُسرَتي",59,"ت",2,1],["يا لَكَ يَوماً فاتَ فيهِ نَهبي","وَغابَ عَنّي ثِقَتي وَصَحبي",60,"ي",1,1],["يا لك الله هل وجدت سبيلا","موصلا أو لقيت يا ذا رسولا",61,"ل",2,0],["يا لك الله ما وجدت من الان","س بلقيا الحبيب من غير حيله",62,"ل",2,0],["يالك الخير يا حريضة تيهي","عربدي بالامام عالي المنار",63