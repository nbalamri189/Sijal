ewPoem.aspx?id=189580",""],[5039,"الدلع بألف خير","https://www.poetsgate.com/ViewPoem.aspx?id=48119",""],[5046,"غرامك نارٌ","https://www.poetsgate.com/ViewPoem.aspx?id=197894",""],[585,"أما حان خوض المأزق المتلاحم","https://www.poetsgate.com/ViewPoem.aspx?id=161924",""],[3591,"أحنُّ على شطِ المزار إلى مصرا","https://www.poetsgate.com/ViewPoem.aspx?id=149379",""],[5106,"الطَّيَِبُوْنَ .. شَرِبْنَا المِسْكَ وَالصَ","https://www.poetsgate.com/ViewPoem.aspx?id=148667",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5252,"اشلونك","https://www.poetsgate.com/ViewPoem.aspx?id=36106",""],[5277,"ومضةُ مُحِبّ","https://www.poetsgate.com/ViewPoem.aspx?id=214651",""],[5282,"يتيمٌ يلهو في عزاء أبيه.. ألمِ ووجع","https://www.poetsgate.com/ViewPoem.aspx?id=214421",""],[5302,"وقوف على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=200867",""],[5310,"مِدَادُ الْقَلْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=211267",""],[5323,"بارق ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=207293",""],[5376,"وان غبتم عن العينين بعدا","https://www.poetsgate.com/ViewPoem.aspx?id=188506",""],[5459,"ذبح السماح","https://www.poetsgate.com/ViewPoem.aspx?id=200624",""],[5493,"الوردُ الذابل","https://www.poetsgate.com/ViewPoem.aspx?id=211777",""],[5512,"وتشرق شمس صبحي","https://www.poetsgate.com/ViewPoem.aspx?id=204624",""],[5525,"ما بقى لي قلب","https://www.poetsgate.com/ViewPoem.aspx?id=7297",""],[5616,"رؤية","https://www.poetsgate.com/ViewPoem.aspx?id=203340",""],[5689,"ترى يطب بي شعبي رجوعي لغيله","https://www.poetsgate.com/ViewPoem.aspx?id=143430",""],[5689,"انا عربي لا جنس أمجد من جنسي","https://www.poetsgate.com/ViewPoem.aspx?id=143432",""],[5690,"بدت هذه الديار بثوب فخرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=172176",""],[5742,"الحمراء تأريخ ونهضة","https://www.poetsgate.com/ViewPoem.aspx?id=206897",""],[5751,"بيت الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214721",""],[5783,"زوجتي الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=61545",""],[5794,"نشيد الارض","https://www.poetsgate.com/ViewPoem.aspx?id=80284",""],[5794,"قلب جدا ..","https://www.poetsgate.com/ViewPoem.aspx?id=80286",""],[5845,"تجلتْ لوحدانية ِ الحقِّ أنوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=15448",""],[5939,"مُتوَّجةٌ في سماواتِ عشقي","https://www.poetsgate.com/ViewPoem.aspx?id=178605",""],[5957,"أحبكَ أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=11393",""],[5957,"هويتكَ","https://www.poetsgate.com/ViewPoem.aspx?id=12624",""],[5957,"لأنكَ فجريَ الآتي","https://www.poetsgate.com/ViewPoem.aspx?id=176901",""],[6035,"كذبة يوم القدس .. !","https://www.poetsgate.com/ViewPoem.aspx?id=175126",""],[6045,"تحية الترحيب","https://www.poetsgate.com/ViewPoem.aspx?id=180624",""],[161,"لفي كبدٍ خُلِقْتَ فَمَنْ تَلومُ ؟ !","https://www.poetsgate.com/ViewPoem.aspx?id=155650",""],[6102,"حَماقَة !!","https://www.poetsgate.com/ViewPoem.aspx?id=183657",""],[5190,"على بُعدِ شاطئين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85032&r=&rc=107",""],[6351,"صحراء انتظارٍ أنا.. وغيمة الموعد أنت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86048&r=&rc=8",""]],"verses":[["وَإِنَّ غَريبَ القَومِ مَن عاشَ فيهِمُ","وَليسَ يَرى إِلّا عَدُوّاً مُداجِيا",0,"ي",2,0],["وَإِن غِبتُ عَنكَ فَإِنَّ الفُؤادَ","عِندَكَ ما فاتَهُ مَوضِعُ",1,"ع",1,0],["وَإِنَّ غَبينَ القومِ مِن طاعِنِ الرَدى","إِذا جاءَ في جَيشِ الرَزايا بِأَدمُعِ",2,"ع",1,0],["وَإِنَّ غَزالاً جُزتُمُ بِكِناسِهِ","عَلى النَأيِ عِندي وَالمَطالِ حَبيبُ",3,"ب",1,0],["وَإِن غَرَبتِ فَلِطّا","لِعاتِ شَرقٌ وَغَربُ",4,"ب",1,0],["وَإِن غَفَلَت عُيونُهُم رَجَعنا","لِأَحسَنِ ما يَكونُ مِنَ الوِصالِ",5,"ل",1,0],["وإنْ غالَ خطْبُ فهْوَ مأْوَى منَ الرّدَى","وإنْ هالَ ذنْبٌ فهْوَ في الذّنْبِ شافِعُ",6,"ع",1,0],["وَإِنْ غَالَهَا حَرَّ الْهَجِيِرِ فَذَكَّرِا","غَضَارَةَ وَادِيهِ وَبَرْدَ ظِلاَلِهِ",7,"ل",2,0],["وإنْ غابَ قُرْطٌ عنْدَهُ ومُقلَّدٌ","رجَعْتُ الى الجوْزاءِ والأنْجُمِ الزُّهْرِ",8,"ر",1,0],["وَإِنَّ غَزاتَكَ مِن حَضرَمَوتَ","أَتَتني وَدوني الصَفا وَالرَجَم",9,"م",1,0],["وَإنَّ غَداً وَإِنَّ اليَومَ رَهنٌ","وَبَعدَ غَدٍ بِما لا تَعلَمينا",10,"ن",2,0],["وإن غزير الدمع خدّد خّدها","فلاحت من الأشجان فيه فتون",11,"ن",1,0],["وأن غزا مستظِلاً ظلّ رايته","هزّ البلاد وأحيا الأعصُر الأُولا",12,"ل",2,0],["وإن غزلت لي من ضنا الجسم حلةً","لما حلتُ عن أني بها أتغزَّل",13,"ل",1,0],["وإن غدا الشَّبوط قِرْناً لهم","فخدُّ شَبُّوطِهمُ التَّاربُ",14,"ب",1,0],["وإن غنَّيتِ زنَّيت الندامى","فلا عَمِرتْ بحضرتك البُيوتُ",15,"ت",1,0],["وإن غدا أظلمَ من قاسمٍ","ذاك الذي يجفو وأشتاقه",16,"ق",2,0],["وإن غَدوا دون أهلِ الأرضِ إخوته","أبوهُمُ وأبيهِمْ منبتُ الأجمِ",17,"م",1,0],["وَإِنَّ غُلاماً نيلَ في عَهدِ كاهِلٍ","لَطِرفٌ كَنَصلِ المَشرَفِيَّ صَريحُ",18,"ح",1,0],["وَإِن غابَ أُنسُكَ عَن مَجلِسي","فَما لِيَ أُنسٌ بِمَن يَحضُرُ",19,"ر",1,0],["وإن غفوت فإن الحي","اة ليست تروعك",20,"ك",1,0],["وانغماس الكبريت في الجسد","الأبيض من أصعب الأمور علينا",21,"ن",2,0],["وإنْ غلبتكم شِقْوةُ الجَدِّ فاعلموا","بأن ديارَ الناكثينَ طُلولُ",22,"ل",1,0],["وَإِن غُمَّ أَخبارُ العَطايا فَبِشرُهُ","مُؤَدٍّ إِلَينا وَقتَها وَبَشيرُها",23,"ر",3,0],["وَإِن غَلَتِ الأَرواحُ أَرخَصتَ سَومَها","هُنالِكَ في سوقٍ مِنَ المَوتِ قائِمِ",24,"م",1,0],["وَإِن غِبتُ كانوا بَينَ راوٍ وَمُحتَبٍ","وَبَينَ مُعيبٍ قَلبُهُ بِالشَنائِفِ",25,"ف",1,0],["وإن غدوتُ زُهَيراً في مدائِحِه","فقَد غدا بتوالي جُودِه هَرِما",26,"م",2,0],["وإن غادرْتَ مِصباحاً ضئيلاً","فقد ساوَرْنَ أثقبَ من شِهابِ",27,"ب",1,0],["وَإِن غُنّيتُ عَن أَحَدٍ قَلاني","وَعاقَبَني بِما فيهِ اِكتِفاءُ",28,"ا",2,0],["وَإِن غَدَت لِمُلوكِ الأَرضِ مُشكِلَةٌ","غَدا لَها حَكَماً تَرضى بِها حِكَما",29,"م",2,0],["وَإِن غَشِيَتكِ ظَلماءٌ تَجَلّى","بِغُرَّتِهِ دُجى اللَيلِ البَهيمِ",30,"م",1,0],["وَإِن غُضَّ يَوماً دونَهُ طَرفُ حاسِدٍ","فَإِنَّهُما شَمسٌ تُنيرُ وَأَرمَدُ",31,"د",1,0],["وَإِن غَضِبَت رَأَيتَ الناسَ هَلكى","وَإِن رَضِيَت فَأَرواحٌ تَعودُ",32,"د",1,0],["وَإِن غابَ عَن لَأيٍ بَغيضٌ كَفَتهُمُ","نَواشِئُ لَم تَطرِر شَوارِبُهُم بَعدُ",33,"د",1,0],["وَإِن غَضِبَت خِلتَ بِالمِشفَرَينِ","سَبائِخَ قُطنٍ وَبِرساً نُسالا",34,"ل",2,0],["وإن غُرِسَت في أرضِ قَلْبِي مَحَبَّةٌ","فليسَ بِبُغْضٍ آخِرَ الدَّهْرِ تُثْمِرُ",35,"ر",1,0],["وَإِن غَيَّرَ الإِثمُ الوُجوهَ فَما تَرى","لَدى الحَشرِ إِلّا كُلَّ أَسوَدَ شاحِبِ",36,"ب",1,0],["وَإِن غُفِرَت مُوبِقاتُ الذُنوبِ","فَكُلُّ مَصائِبِهِم تُغتَفَر",37,"ر",1,0],["وَإِنَّ غُروبَ الشَمسِ كُلَّ عَشيَّةٍ","يُحَدِّثُ أَهلَ اللُبِّ عَنهُ دُلوكُها",38,"ك",3,0],["وإن غوين على الفر","ض فالجمال شَفيع",39,"ع",1,0],["وَإِن غَرائِبُها أَجدَبنَ مِن بَلَدٍ","كانَت عَطاياكَ أَندى مِن مَسارِحِها",40,"ح",3,0],["وانغمسوا في الشهوات والترفْ","وأفسدوا شبان أبناء الشرفْ",41,"ف",1,0],["وَإِنْ غَدَرَ الزَّمَانُ بِهِ فَإِنِّي","أَقُومُ بِنَصْرِهِ فِعْلَ الصَّدِيقِ",42,"ق",1,0],["وَإِن غَيَّرَ السقمُ مِن وَجنَتَي","كَ دُرَّ الشَبابِ وَياقوتَه",43,"ه",1,0],["وأنَّ غُراباً شأى \" معبداً \"","وأنّ حِماراً \" غريضاً \" حَكى",44,"ا",1,0],["وإنَّ \" غداً \" باسماً يُجتَلَى","بشِقِّ النفوس . ولا يُوهَب",45,"ب",1,0],["وإن غيّرَ الإثمُ الوجوهَ، فما ترى،- لدى الحشر، إلا كلّ أسودَ شاحبِ","إذا ما أشار العقلُ بالرُّشد، جرَّهمْ-، إلى الغَيّ، طبعٌ أخذهُ أخذُ ساحب",46,"ب",1,0],["وَإن غَدا التربيعُ مِثلَ العَدَدِ","فَجذرُه التَّنصِيفُ دونَ فَنَد",47,"د",1,0],["وَإِن غَضِبَت مِنهُ قُرَيشٌ فَقُل لها","بَني عَمِّنا ما قَومُكُم بِضِعافِ",48,"ف",1,0],["وإن غبت عنا كان في ابنيك سلوةٌ","وإن عَز نطقٌ فالهلالُ يترجمُ",49,"م",1,0],["وَإِن غَنيتَ بِما أَثَّلتَ مِن شَرَفٍ","عَن ذِكرِ ما أَثَّلَت آباؤُكَ النُجُبُ",50,"ب",1,0],["وَإِن غادَرتَ صَبرَهُمُ أَسيراً","فَقَد غادَرتَ رُعبَهُمُ طَليقا",51,"ق",2,0],["وإن غشيتهم محن","فطاعة أمره عصم",52,"م",1,0],["وإن غدت أزمةٌ فاصبر لشدتها","إن الشدائد تأتي ثم تنقرض",53,"ض",1,0],["وَإِن غِبتُ أَدنى ساعَةٍ مِن لحاظِهِ","تَمَحَّلَ في غَيبي بِكُلِّ مِحالِ",54,"ل",1,0],["وإِنَّ غداً باليومِ رَهْنٌ وإِنَّما","مَسيرُ غدٍ كاليومِ أوْ تَريانِ",55,"ن",1,0],["وإن غفا راحت الأحلام عابثة","به فتدنيه أحيانا وتقصيه",56,"ي",2,0],["وإن غبت عنها بعض ليل تلفتت","تسائل عن سرّ القطيعة والصد",57,"د",1,0],["وإن غاب عن عيني أنكرت عيشتي","وضاق علي الرحب من كل منفذ",58,"ذ",1,0],["وأنغام إلهام السماع بروحنا","تبثّ لنا سرّ الحبيب فنفهم",59,"م",1,0],["وإن غبتُ حسبي عينُ غيبك أجتلي","شهادته في حضرة العين والعلم",60,"م",1,0],["وإن غَضِبنَ قليلاً","لي تضحكُ الأمهات",61,"ت",1,0],["وَإنْ غَرَّ الغُواةَ ذُرى جِبالٍ","يُرَوْنَ بِها نُسوراً في وُكورِ",62,"ر",1,0],["وإِن غَنَّت الرَكبيَّ وَالركب سائِرٌ","غدا حائراً ما كدَّرَته وَثَنَّتِ",63,"ت",1,0],["وَإِن غفتْ أو بدتْ في عينها سنةٌ","أهويتُ ألثمها والشرط أملك لي",64,"ل",2,0],["وَإِن غاضَ في ذا القبرِ فيضُ يَمينِها","فَكَم كبدٍ حرّاء أَروى اِنبِجاسها",65,"س",3,0],["وإن غنّت الأمواج خلت غناءها","أنين اليتامى أو نشيج الحرائر",66,"ر",1,0],["وَإِن غَشَّت مَوارِدُها","فَقَد نَصَحَت مَصادِرُها",67,"ر",3,0],["وان غبهم","الموت والعطب",68,"ب",1,0],["وإنْ غدا قابِلاً أعذارَهُ كرماً","فلا يَزالُ على الأكفاء يَفْتَخِر",69,"ر",1,0],["وإن غَدتْ بالنّوالِ فائزةً","فلا يَدٌ للمَلامِ تَفْثَؤها",70,"ا",3,0],["وأن غرامي بعد شيب مفارقي","كما عهدت والخد مِنِّي أجرد",71,"د",1,0],["وإنَّ غريمي غزال اللّوى","فجُوزيت بالخير ذاك الغريما",72,"م",2,0],["وإنَّ غُضَّ طرفٌ عن مكارم ماجد","فلا طرف إلاَّ نحو جدواك طامح",73,"ح",1,0],["وإن غاب عني بدر علمٍ فإنني","تعوّضت بدراً للعلى وهو أسعدُ",74,"د",1,0],["وان غبت تكلف ان ينادي","عليك بجلق أو في هديّه",75,"ي",2,0],["وإن غبتم عن ناظريّ فإنما","تمثلكم عندي المودة والذكر",76,"ر",1,0],["وإن غاب بدر من محاسن شخصه","فإحسانه شمس على الناس تطلُع",77,"ع",1,0],["وإِن غاضَ عَيْنَيْ ماءِ دِجْلَةَ حَيْنُها","لقد أَغرقَتْ أَرْضَيَّ بَعْدَ فُرَاتِها",78,"ت",3,0],["وإن غَدَا كُلُّ رَحْبٍ من بِلادِهِمُ","عَليْهِمُ حُرُماً أفضى بنا حَرَمُكْ",79,"ك",1,0],["وإِنْ غَرَّها بالجُودِ خَاتِلُ طائِفٍ","تهجَّى لَهَا الشَّكْوَى بِغَيْرِ حُرُوفِها",80,"ف",3,0],["وإِنْ غَزَتْ الآمالُ نفسي صرمتُها","بصارِمِ يأْسٍ فِي يمينِ تُقىً حُرِّ",81,"ر",1,0],["وإِنْ غالَتِ البيدُ اصطبارَكِ والسُّرى","فما غالَ ضيم الكاشِحينَ اصطبارَكِ",82,"ك",1,0],["وأَنَّ غابك ثقب لا عبئت بها","فغابة الأسد الحامي الحمى ثقب",83,"ب",1,0],["وأنّ غصناً أنت من فروعه","لخيرُ غصنٍ مثمراً أو مورقا",84,"ق",2,0],["وإن غنيتم لغنى أنفسكم","عن رغبةٍ فهو إليكم مفتقِرْ",85,"ر",1,0],["وإن غزا فهو الهِزبرُ الضاري","أغْلب ماضي العزْم من نِزارِ",86,"ر",1,0],["وإن غاض ماءُ الضَّرع وامتقع الثرى","وعمَّ الطَّوى خصوا العراقيب بالحلب",87,"ب",1,0],["وَإِن غَنّى الحَديدُ فَهُم سُقاةٌ","يُديرونَ الكُؤوسَ مِنَ الحُتوفِ",88,"ف",1,0],["وَإِن غُرتِ غُرنا حَيثُ كُنتِ وَغُرتُمُ","أَوَ انجَدتِ أَنجَدنا مَع المُتَنَجِّدِ",89,"د",1,0],["واِنْ غبطَتْني الفضلَ والعقلَ أُمَّةٌ","فمَنْ ذا على ما كانَ منها يلومُها",90,"م",3,0],["واِنْ غابَ عن أفكارِ قومٍ صحيحةٍ","غدا والى فكري الصحيحِ انتسابُهُ",91,"ب",2,0],["وإن غفَلْتَ فعُدْ للذِّكْرِ مبتَهِجاً","ذَنْبُ المُحِبِّ مع الأَحْبابِ مغْفُورُ",92,"ر",1,0],["وإنْ غشِيَتْ نورَ البصائِرِ ظُلمةٌ","جلَبْتَ من الرّأيِ السّديدِ بها فجْرا",93,"ر",2,0],["وإن غشيت إلى سقيا ثمارهم","فلا سقى الله لي قلباً سوى الغلل",94,"ل",1,0],["وإنْ غَنَّتْ لَهُ أَبكارُ عِلْمٍ","فعِنِّينٌ بعُنَّتِهِ يُعاني",95,"ن",2,0],["وإنْ غَدا سِرْبُهُمُ آمناً","فَكُلُّ شَرٍّ عَنْهُ لَمْ يَنْكُصُوا",96,"ص",3,0],["وإنْ غفرتُ جُرمَهُ","أعاد ما كان جَرَمْ",97,"م",1,0],["وإنّ غنيّاً في الهوى ونزيلُهُ ال","مشيبُ فقيدُ الرّاحتين عديمُ",98,"م",1,0],["وَإنْ غبتَ عن عَيني فما غبتَ عن حَشىً","مُقَلْقِلَةٍ تحنو عليك وأضلعُ",99,"ع",1,0],["وإنّ غناءً بعد هُلْكِكَ أصْلَمٌ","وإنّ وفاءً بعد فقدك أجْدَعُ",99,"ع",1,0],["وإنّ غبينَ النّاسِ مَن بات عِرْضُهُ","تعرّضُهُ السُّوءى لبعضِ القرائحِ",100,"ح",1,0],["وَإِنْ غابَ مِن بَعدِ طولِ المَدى","فَإِنَّك أَطوَلُ مِنهُ بقا",101,"ا",1,0],["وَإِن غَفَلَ الدَيّوثُ عَنها تَقَنَّعَت","بِثَوبِ الدُجى تَرتادُ مَزنىً وَمَعهَرا",102,"ر",2,0],["وإن غرد الشحرور كان إشارة","به منه فينا أو تناوح لغلغ",103,"غ",1,0],["وإن غصبوا أوصافهم من ذواتها","أغارت عليهم منه خيل طلائع",104,"ع",1,0],["وإن غَفَلتُ لضُعفي هَبَّ مُنتبِهاً","وإن نَسيتُ مواثيقَ الهَوَى ذَكرا",105,"ر",2,0],["وإِن غِبْتَ فما غَابَ","فؤَادِي بين أَفْنَائِك",106,"ك",1,0],["وإِن غبتَ كان البدرُ مِنكَ خَليفَةً","وإِن قُلْتَ لي أَنْشَأْتُ عَنْكَ لَه الْعَهْدَا",107,"د",2,0],["وَإِن غِبتُ عَنهُ كانَ لِلوُدِّ حافِظاً","وَلَم يَكُ عَنّي في المَغيبِ بِغافِلِ",108,"ل",1,0],["وإن غاب نَجمٌ عنكَ أزهرُ غائمٌ","فَحَولَك مِن إخوانِه أنجمٌ زُهرُ",109,"ر",1,0],["وَإِنّ غبيّ الذهن عرّض نَفسَه","لِهذا البَلا مِن جَهله بِمَقامي",110,"م",2,0],["وَإِن غرّدَت في دوحها الورقُ في الحمى","حَكيتُ بِسَجعي في القَريض المغرّدا",111,"د",2,0],["وأنَّ غَرامي مُنْذُ سارَ مُلازِمي","وأنَّ اصْطِباري منذُ بانَ مُطَلِّقي",112,"ق",2,0],["وإن غضبت فما في الناس من بشر","إلا على خطر ما مثله خطر",113,"ر",1,0],["وإنْ غُرِرْتَ بجاهٍ قد رُفعْتَ به","فاجعلْ نصيب البرايا غيرَ مقسومِ",114,"م",1,0],["وإنْ غضِبْتَ فلا تسْلحْ على أحدٍ","وارجعْ بعرض بسيف الهجو مهذوم",114,"م",1,0],["وإن غدوتَ ظلوماً","جنتْ عليك الجراسر",115,"ر",1,0],["وَأن َّغدَاً وَليسَ غد ٌبعِيداً","فإنَّ الحق َّأجْدَرُ أنْ يَحِقا",116,"ق",2,0],["وَإنْ غَرَّدَ الْحَادِي سُحَيْراً وَفَوَّضَا","يُذَكِّرُنِي بَرْقُ الْحِمى زَمَناً مَضى",117,"ض",2,0],["وَإِن غازَلَت عن نَرجِسٍ فبِثَغرِها","أَقاحِي رَوضٍ بالعَقيقِ تُلَثَّمُ",118,"م",1,0],["وَإِن غَرَّكَ القَومُ عَن حُلمِهِ","فَلا تَأمَنِ اللَيثَ وَقتَ الأَجَمْ",119,"م",1,0],["وإن غرامي غرامي الذي","عهدت بها وولوعي ولوعي",120,"ع",2,0],["وَإِن غادَرَتني بِالعَراءِ حُمولُهُم","كَفى أَنَّ قَلبي جاهِدٌ إِثرَ أَظعانِ",121,"ن",1,0],["وَإِن غَدَت عَلَيهِ مِنها ساعة","وَهوَ مصر لَم يَتب مِن ذَنبه",122,"ب",2,0],["وإن غدا يجيء بما عليه","يدور الأمر من سعد ونحس",123,"س",1,0],["وَإِنْ غَلا ماءُ الحَمِيمِ المُسْخَنِ","ثَقَّفْتَ تَثْقِيفَ امْرِئٍ لَمْ يُهْدَنِ",124,"ن",1,0],["وإن غرقوا في بحر بأسك فلتكن","نكال عليهم ما عليك عتاب",125,"ب",1,0],["وإن غار منقضاً أراك من العدا","رؤوساً على البيداء ملقاة كالأكرْ",126,"ر",1,0],["وإن غاب انتهاج الحق يوماً","عن الأفهام كان هو الطريقُ",127,"ق",1,0],["وإن غشى بقعة الهيجاء يوم وغىً","ألفيتهُ الطود لما مال وانطبقا",128,"ق",2,0],["وان غيبتني غشية توهم الكرى","يواصل طيف الهم فيها ويطرق",129,"ق",1,0],["وأن غَداً غادٍ عليكَ بحادثٍ","وبعد غدٍ حتى تُساَق إلى القبرِ",130,"ر",1,0],["وَإِنغابَ عَنهُ الجسم عَنا فَسَرَّه","مَدى الدَهر فينا أَن نَروح وَمُذ نَغدو",131,"د",2,0],["وإن غَيَّمت بالنقع شمت بوارقاً","لهم غربُها بالموت والدّم هاطل",132,"ل",1,0],["وإن غالبَ الخطبُ الورى فقريعه","أخو نجدةٍ ما بين برديه أغلبُ",133,"ب",1,0],["وإنْ غَابَ عَنْهُمْ شَاهدَتْهُمْ مَهابَةٌ","بها يَقْهَرُ الأعْدَاءَ حِينَ يَغِيبُ",134,"ب",1,0],["وإن غضبت في موقف الهول خلتها","نبى الجن ثارت فاغرات الخياشم",135,"م",1,0],["وإن غركم أن الخطوب تنكّرت","زماناً لنا فالدهر بالناس قُلّب",136,"ب",1,0],["وإنَّ غُلاماً كان وارثَ عامِرٍ","ووارثَ رِبعِيٍّ لأهلٌ ليفخرا",137,"ر",2,0],["وَإِن غَضِبَت مِن ذا قُرَيشٌ فَقُل لَها","مَعاذَ الإِلهِ أَن أَكونَ أَهابَها",138,"ب",3,0],["وإن غسلت من غير طهر ولم يبن","لها الطهر فلتغتسل إذا بان بابن مي",139,"م",2,0],["وإن غالني من دونهن منيتي","فأقدار رب بالمنيه حاكم",140,"م",1,0],["وإن غركم أن أجّل الله نصرنا","فما ذاك إلا للفتوح دلائل",141,"ل",1,0],["وأنَّ غربان القضاءِ على","فُلولهم لا بدَّ ما تنعبُ",142,"ب",1,0],["وَاِنغَسَّ في كَدَرِ الطمالِ دُعامِصٌ","حُمرُ البُطونِ قَصيرَةٌ أَعمارُها",143,"ر",3,0],["وَإِن غَضِبوا فَالمَوتُ بَعضُ عِقابِهِم","وَتُستَلُّ مِنهُ بِالخُضوعِ السَخائِمُ",144,"م",1,0],["وإن غربت تلك البدور بِغُرَّب","فعهدي بها بين الطوالع تطلع",145,"ع",1,0],["وإن غَسَلَ الكفين وتراً ولم يزلْ","بخيلاً بما يهوى على فطرةِ الأولى",146,"ا",1,0],["وان غبت حسا عنكم لضرورة","فانتم معي معنى لسكناك في القلب",147,"ب",1,0],["وإن غبت عن عيني وقد كنتِ نورُها","فإنّك مِنْ قلبي مكانَ سَوادي",148,"د",2,0],["وإن غيرّ الناسُ العبادَ فإنني","هواي صَحِيحٌ والودادُ أكيد",149,"د",1,0],["وان غيَّر الأحبابُ جورَ زمانِهم","فو الله لا أَسْلُو ولا أتغير",150,"ر",1,0],["وَإِن غابَت لَكُم شَمسٌ فَهَذا","سُليمانٌ بَدا بَدراً تَماما",151,"م",2,0],["وإن غاب عن عيني فليس بغائب","وإني وفي قلبي أقام مخيما",152,"م",2,0],["وإن غرقوا ببحر الحقِّ أرسى","لهم سفنَ الشرائِعِ كالجبالِ",153,"ل",1,0],["وإن غَوَت قِبلَةُ بَعضِ أمكِنه","نَظمِي فبالطُّولِ وَالعَرضٍ آتقِنَه",154,"ه",1,0],["وإن غَرَبَ الذُبَّان خَمسا كما ترى","يكونُ كذا التِّنِّينُ خَمسَا مكرَّرَه",155,"ه",1,0],["وأن غدا جسمى هشيماً اذا","قدحتَ فيه الزندَ لم يُضرم",156,"م",1,0],["وَإِن غَنيهم أَبَداً غبى","وَلا يَدري بَياضاً أَو سَواداً",157,"د",2,0],["وَإِن غَيرُهُمُ باهَى بِكُلِّ سَفاهةٍ","وَسابَقَ في مَيدانِها غَيرُ مُقلِعِ",158,"ع",1,0],["وَإِن غُضَّ مِن غَربِها رَفَّدَت","وَسيجا وَأَلوَت بِجَلسٍ طُوالِ",159,"ل",1,0],["وإن غدت مظلمة ما رأت","في ظلمة الأيام ما يسطع",160,"ع",1,0],["وإن غاب عنكم حيث أزهر رمسُه","به ميتاً أحياه معروفه الساري",161,"ر",2,0],["وإن غشى منّي أعانق وأبوس","وما أجرحه قطَ بمشراطِ وموس",162,"س",1,0],["وإن غواية الوطن استبدت","بهذا الجيل كن سبب الهدايه",163,"ا",3,0],["وإن غدوت عدوّي","أضعت فيك الخصاما",164,"م",2,0],["وَإِن غَدَت القَوم الكِرام فَإِنَّهُ","يَكون أَجَل العالَمين وَأَكرَما",165,"م",2,0],["وان غسلت بماء فاوردنه على","محل نجن ليتقي ذاك فاقتهم",166,"م",1,0],["وإن غيَّبت منك المقابر ماجداً","فشخصك باق في القلوب مؤيّدُ",167,"د",1,0],["وإن غَدَت قلوبُ أهلِه معَه","لكن رماحُهُم إليه مشرَعَه",168,"ه",1,0],["وأن غزو أمير الله لاحقه","من ليس تلحقه خيل ولا نجب",169,"ب",1,0],["وان غزا الموشي اللّماسِ","نضفي خِدر السَّدّ وِنلَحفَه",170,"ف",2,0],["وإن غيب الغيم عنا الهلال","فلسنا نبالي إذا لم تغب",171,"ب",1,0],["وإن غدوتَ ليوم النَّفْرِ مبتكِراً","وداعَهم فهمُ للصبِّ يبتكِروا",172,"ر",3,0],["وإِن غار مثلَ الريحِ بالرَّكب جامحُ","يمرّ كمثل البرقِ إِذ هو لائح",173,"ح",1,0],["وإن غفلت نفس جالت في عالمها","وأهواها حسنها المجازي في لمحة",174,"ه",1,0],["وإن غصنا أبداً لا تزول","عليه شمس لحر بالذبول",175,"ل",1,0],["وإن غاضَ من جَدْواهُمُ نَيلُ نائِلٍ","فنائِلُكَ البحْرُ الذي فاضَ مَدُّهُ",176,"د",2,0],["وإنْ غرُبَ النجْمُ الذي كان يُهْتدَى","بهِ فمُحيّا الصُبْحِ قد لاحَ مُقْبِلا",177,"ل",2,0],["وان غدت ابطالها عوابساً","رعباً واقدامهم تضطرب",178,"ب",1,0],["وَإِن غَوَّرنَ هاجِرَةً بِفَيفٍ","كَأَنَّ سَرابَها قِطَعُ الدُخانِ",179,"ن",1,0],["وَإِن غر مِن عاديت حلم فإنما","مِن الحلم ما يَدعو الغَبي إِلى الرَدى",180,"د",2,0],["وان غاض بحر أوسع الخلق سيبه","فهيهات أن يروي البرية منهل",181,"ل",1,0],["وإن غرَّدت في دَوحِهَا الوُرقُ بالحِمَى","حَكَيتُ بسَجعِي في مَدِيحِك مَعبَدا",182,"د",2,0],["وإن غرناطة الغرّا حللتُ بها","فصرتُ مِنْ ريبِ هذا الدهرِ في حرمِ",183,"م",1,0],["وإن غيرهم بغياً تسنّم منبراً","على رغمه صلَّى عليهم لكي يهدى",184,"د",2,0],["وَإِن غال في التاريخ حَقاً تحيرٌ","ففي الجَنة الفَردوس يهدى بسيده",185,"د",2,0],["وَإن غِبتُ عَنهُ سَاعةً قِيل يَفتري","عَليَّ فَلاَ أدرِي أََأَشتِمه أم لا",186,"ل",2,0],["وإن غنَّت فهل كان","سوى نوح لها مُعْد",187,"د",1,0],["وَإِن غَشِيَت حُزناً سَنابِكُ خَيلِهِ","تَضاءَلَ حَتّى يُصبِح الحُزنُ أَجرَعا",188,"ع",2,0],["وإن غدت الصحافة في امتهانٍ","ترى ركن الحصافة قد تداعى",189,"ع",2,0],["وإن غضبت يوماً فولتك ظهرها","رأيت المئات الست واضحة الرسم",190,"م",1,0],["وَإِنْ غَرسُوا غَرْسَهُ فِي الْكِرامِ","فَما كلُّ عُودٍ وَإِنْ طابَ عُودُ",191,"د",1,0],["وإن غذته المعالى ثدى نعمتها","فلا ورب الورى لا يعرف الشبعا",192,"ع",2,0],["وإن غاب الرقيب لها انبساطٌ","وإن حضر الرقيب لها انكماشُ",193,"ش",1,0],["وَإِن غابَت بعولتهن فَاِحذَر","رَقيباً لا يُفارِقُ قَيدَ شبر",194,"ر",1,0],["وان غم الممالك ليل خطب","جلاه صبح رأيك أو سناكا",195,"ك",2,0],["وَإِن غَيَّرَتها الحادِثاتُ فَإِنَّني","لأَرعى لَها عَهدَ الهَوى سالِفَ الدَّهرِ",196,"ر",1,1],["وَإِن غَدَوتَ صاحِبَ السُلطانِ","فَلا تَكُن مِنهُ عَلى أَمانِ",197,"ن",1,0],["وَإِنَّ غايَةَ ما يَملِكنَ في جَلَلٍ","دُموعُهنَّ إِذا لَم يَستَطِعنَ فِدا",198,"د",2,0],["وإن غمَدوا سيفَ اللواحظِ في الكرَى","أليسَ لهُم في القلبِ ضربةُ لازبِ",199,"ب",1,0],["وأنغصُ عيشٍ للحليمِ إذا نَشَا","بدهرٍ سَمَتْ أوغادُهُ والأراذِلُ",200,"ل",1,0],["وإن غِبتَ عنه حلَّ فيه وطنَّبَتْ","على مَنكِب الكشف المَصون خِيامُه",201,"م",2,0],["وأن غناء اللحن في القول عندهم","لكالحن في الإيقاع والأصل ظاهر",202,"ر",1,0],["وَإِن غَرَّدَت قُمرِيَّةٌ فَوقَ أَيكَةٍ","تُجاوِبُ قُمرِيّاً عَلى البابِ ساجِعُ",203,"ع",1,0],["وإن غبت عنهم ظاعناً بان فقرُهم","إلى الواحد الفذ الذي عنهم ظعنْ",204,"ن",1,0],["وان غبت بابك ينتظر وين ما كنت","ومرايتك من شوقها تصيح وينك",205,"ك",1,0],["وان غدا فالحرب شور امر وناهي","سعد والله عين من ربعي وزانه",206,"ن",2,0],["وإن غراماً كان قد شفّ مهجتي","وألبسني ثوبَ البطالة والضّرِ",207,"ر",1,0],["وان غرّك الزين ونعومة شعرك","لاتنسي النار وحطبها الشيني",208,"ن",2,0],["وَإِن غَرِقْتَ كَفِرْعَوْنٍ فَمَا أَحَدٌ","فِي النَّاسِ يَوْمَئِذٍ يَا بُوشُ يُنْجِيكَا",209,"ك",2,0],["وإنْ غابَتْ عَنِ الْأنْظارِ دَهْراً","فإنّي في الْمُنى دَوماً أَراها",210,"ا",3,0],["وان غدا الشعر ..غيرك.. ماورا الشعر خير","يامن رضاك يسوى عندي ألفين راس",211,"س",1,0],["وإنَّ غَرَاماً مِنْ سَنَا الشَّمْسِ نُورُهُ","لِكُلِّ عُيُونِ الحَاسِدَاتِ يُقَارِعُ",212,"ع",1,0],["وإن غض منهم خوضهم في ضلالهم","وشعث منهم سعيهم بالنمائم",213,"م",1,0],["وإن غدرت حسناءُ بي بعدما وفت","فلست أرى إلا فضيحتها جهرا",214,"ر",2,0],["وَإِنْ غَضبْنَا .. فَهَذا السَّيفُ مُبتَسِمٌ","نزَاحِمُ المَوتَ وَالإِقدَامَ وَالخَطَرَا",215,"ر",2,0],["وإن غُلبت على طبعي فأكرمني","فضلا وإلا فّقل يا زلة القدم",216,"م",1,0],["وان غبت ما انشد عنك:شلونك","لايا بعد ميتي وحياني",217,"ن",2,0],["وإن غِبتُمْ يتيه الدربُ عنّي","كَأَعمى تاهَ في قلب الصحاري",218,"ي",1,0],["وإن غدَا لاعباً أو راح مُنْتَشِيَاً","بكى الغمام وسال الدمع للوادي",219,"د",2,0],["وإن غربت كنا بجيزان ليلة","على شاطيء نرتاده في تفقد",220,"د",1,0],["وَإن غِبتِ عن عيْني فإنكِ سورةٌ","يُرتلُها قلبي فينشرِحُ الصَّدرُ",221,"ر",1,0],["وإن غادرتْ أرضاً تراءتْ كئيبةً","وإن نزلتْ قفراً غدتْ جنةَ الخلدِ",222,"د",1,0],["وان غبتم عن العينين بعدا","يزيد هواكمو الوجدان قربا",223,"ب",2,1],["وإن غشا الموتُ ميادينَنَا","فلن نصدّه بحمل السلاح ..",224,"ح",1,0],["وإن غابَ الرحيقُ فلا اقترابٌ","لِيُرجَى منْ تلابيبِ الشرودِ",225,"د",1,0],["وإنْ غابتْ تَزَيْدُ اللَّيلَ عتماً","فَتُولَدُ ليلتي من عتمتَينِ",226,"ن",1,0],["وان غَدى للحب في قلبك شظيه","وش يقول اللي غدى قلبه شظايا",227,"ا",3,0],["وأنّ غيماً وراء الغيم يرمقني","وسوف يمضي إلى حقلي وينهمر",228,"ر",1,0],["وإن غار صبح الاتحاد بأمة","طوى الخلف عنها اليمن فيجنح ليله",229,"ل",2,0],["وإن غادرت درب الهداية أمة","ذرتها نجوم السعد في ظلم النحس",230,"س",1,0],["وأن غشَّى الظلام عليك أمراً","فمن أنواره تجد الدليلا",231,"ل",2,0],["وإن غربت للعيشي فسلم","على الأحباب منزلة وقربى",232,"ب",2,0],["وأنَّ غَداً لابدَّ آتٍ بِصُبْحِهِ","وتَسقُطُ رَاياتُ الظَّلامِ حِيالَهُ",233,"ل",2,0],["وإنْ غفوتُ على نهديكِ قلتُ: كفى!","كفى دلالاً ملأتِ الكأس وانصبا",234,"ب",2,0],["وان غرهد القمري وبيّح قهرها","سجيت بلحوني صدى لصوت ورّاق",235,"ق",1,0],["وأن غدرك الناس لله تحتسب","في شرايينك قناعاتك تسيل",236,"ل",1,0],["وإنْ غردَ القمريُّ شكراً لربهِ","تجاوبهُ بالسجعِ أيكٌ وأطيارُ",237,"ر",1,0],["وإن غِبتِ عنهُ كواهُ اللَّهيبُ وعانَى انسحابَ النُّهَى وقتَها!","فلا قلبُهُ يَستطيبُ سواكِ ولا فادَ إنْ عنْ هواكِ الْتَهَى",238,"ت",3,0],["وإن غرامكَ قد نال مني","وداهم قلبي فشوقي تسعّر",239,"ر",1,0],["وان غبت عني ورحت بعيداً","سابقى بحلمي ودمع العيون",240,"ن",1,0],["وإن غابت عن الأنظار","يا عمري شقاواتي",241,"ت",2,0],["وأنْ غداً قرب باب القدس موعدنا","وسوف يُرفع في عليائها العلم",242,"م",1,0],["وإن غنى مع الأيام شعراً","تراقصت الأماكن والزوايا",243,"ا",3,0],["12- وإن غَصَّتْ وَغَرْغَرَتِ الأمَانِي","وحشْرَجَ صَوْتُ آهَاتٍ سَقيمُ",244,"م",1,0],["وَإِن غَضِبتِ فَمِن خَدَّيكِ دُونَ فَمِي","حَماقَةُ الثَّغرِ بَعضٌ مِن حَماقَةِ خَدْ!",245,"د",1,0],["وإنْ غَابَ عَنِّي الوَحيُ عِشتُ كَأَنَّنِي","عَلَى هَامِشِ الأَرقَامِ لا شَيءَ أو صِفرُ",246,"ر",1,0],["وإن غبتِ عن عينيَّ أرنو إلى الضحى","مليّاً.. كأني نحو وجهِكِ أنظرُ",247,"ر",1,0]]}