https://www.aldiwan.net/poem54137.html","الطويل"],[430,"لئن غاب عن عيني أمين فضائل","https://www.aldiwan.net/poem40077.html","الطويل"],[430,"وجارية لطهماز ربية","https://www.aldiwan.net/poem40857.html","الوافر"],[438,"أجل قد تمادى الأمر وانصرم العمر","https://www.aldiwan.net/poem2542.html","الطويل"],[438,"ربوع الندى من بعد فقدك بلقع","https://www.aldiwan.net/poem2548.html","الطويل"],[440,"يا صفوة الأجفان من عبراتها","https://www.aldiwan.net/poem34761.html","الطويل"],[440,"استقبل العز مرفوعا به علمك","https://www.aldiwan.net/poem34775.html","البسيط"],[440,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[440,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[440,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[442,"أنا الغريب فلولا المجد والحسب","https://www.aldiwan.net/poem14420.html","البسيط"],[459,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[459,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[462,"أمدحه أبلج كالنهار","https://www.aldiwan.net/poem16108.html","الرجز"],[465,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[469,"وقوم إن دجا للنقع ليل","https://www.aldiwan.net/poem59870.html","الوافر"],[471,"وإنك إن تنزح بك الدار آتكم","https://www.aldiwan.net/poem4670.html","الطويل"],[478,"مغاني الهوى لم يبق إلا رسومها","https://www.aldiwan.net/poem15188.html","الطويل"],[478,"أضر بعيني دمعها وانسكابه","https://www.aldiwan.net/poem15358.html","الطويل"],[501,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[515,"طلبت عظيم المجد بالهمة الكبرى","https://www.aldiwan.net/poem20833.html","الطويل"],[516,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[530,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[530,"وجوه سوء إن غلى مرجل","https://www.aldiwan.net/poem37355.html","السريع"],[552,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[552,"نضوت ثياب اللهو عني فقلصت","https://www.aldiwan.net/poem47235.html","الطويل"],[552,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[552,"وثقت بكم حتى خجلت وكم جنت","https://www.aldiwan.net/poem47888.html","الطويل"],[552,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"],[554,"فلم أر كالأقدام صارت سواعدا","https://www.aldiwan.net/poem68361.html","الطويل"],[559,"غني به عبد الغني فيبلغ","https://www.aldiwan.net/poem34363.html","الطويل"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[563,"قد عاهد الدهر أهليه فما غدرا","https://www.aldiwan.net/poem52874.html","البسيط"],[576,"شفاك الله من دائك","https://www.aldiwan.net/poem2699.html","الهزج"],[576,"دنوت وقد أبدى الكرى منه ما أبدى","https://www.aldiwan.net/poem3082.html","الطويل"]],"verses":[["وَإِنَّ غَريبَ القَومِ مَن عاشَ فيهِمُ","وَليسَ يَرى إِلّا عَدُوّاً مُداجِيا",0,"ي",2,0],["وَإِن غِبتُ عَنكَ فَإِنَّ الفُؤادَ","عِندَكَ ما فاتَهُ مَوضِعُ",1,"ع",1,0],["وَإِنَّ غَبينَ القومِ مِن طاعِنِ الرَدى","إِذا جاءَ في جَيشِ الرَزايا بِأَدمُعِ",2,"ع",1,0],["وَإِنَّ غَزالاً جُزتُمُ بِكِناسِهِ","عَلى النَأيِ عِندي وَالمَطالِ حَبيبُ",3,"ب",1,0],["وَإِن غَرَبتِ فَلِطّا","لِعاتِ شَرقٌ وَغَربُ",4,"ب",1,0],["وَإِن غَفَلَت عُيونُهُم رَجَعنا","لِأَحسَنِ ما يَكونُ مِنَ الوِصالِ",5,"ل",1,0],["وإنْ غالَ خطْبُ فهْوَ مأْوَى منَ الرّدَى","وإنْ هالَ ذنْبٌ فهْوَ في الذّنْبِ شافِعُ",6,"ع",1,0],["وَإِنْ غَالَهَا حَرَّ الْهَجِيِرِ فَذَكَّرِا","غَضَارَةَ وَادِيهِ وَبَرْدَ ظِلاَلِهِ",7,"ل",2,0],["وإنْ غابَ قُرْطٌ عنْدَهُ ومُقلَّدٌ","رجَعْتُ الى الجوْزاءِ والأنْجُمِ الزُّهْرِ",8,"ر",1,0],["وَإِنَّ غَزاتَكَ مِن حَضرَمَوتَ","أَتَتني وَدوني الصَفا وَالرَجَم",9,"م",1,0],["وَإنَّ غَداً وَإِنَّ اليَومَ رَهنٌ","وَبَعدَ غَدٍ بِما لا تَعلَمينا",10,"ن",2,0],["وإن غزير الدمع خدّد خّدها","فلاحت من الأشجان فيه فتون",11,"ن",1,0],["وأن غزا مستظِلاً ظلّ رايته","هزّ البلاد وأحيا الأعصُر الأُولا",12,"ل",2,0],["وإن غزلت لي من ضنا الجسم حلةً","لما حلتُ عن أني بها أتغزَّل",13,"ل",1,0],["وإن غدا الشَّبوط قِرْناً لهم","فخدُّ شَبُّوطِهمُ التَّاربُ",14,"ب",1,0],["وإن غنَّيتِ زنَّيت الندامى","فلا عَمِرتْ بحضرتك البُيوتُ",15,"ت",1,0],["وإن غدا أظلمَ من قاسمٍ","ذاك الذي يجفو وأشتاقه",16,"ق",2,0],["وإن غَدوا دون أهلِ الأرضِ إخوته","أبوهُمُ وأبيهِمْ منبتُ الأجمِ",17,"م",1,0],["وَإِنَّ غُلاماً نيلَ في عَهدِ كاهِلٍ","لَطِرفٌ كَنَصلِ المَشرَفِيَّ صَريحُ",18,"ح",1,0],["وَإِن غابَ أُنسُكَ عَن مَجلِسي","فَما لِيَ أُنسٌ بِمَن يَحضُرُ",19,"ر",1,0],["وإن غفوت فإن الحي","اة ليست تروعك",20,"ك",1,0],["وانغماس الكبريت في الجسد","الأبيض من أصعب الأمور علينا",21,"ن",2,0],["وإنْ غلبتكم شِقْوةُ الجَدِّ فاعلموا","بأن ديارَ الناكثينَ طُلولُ",22,"ل",1,0],["وَإِن غُمَّ أَخبارُ العَطايا فَبِشرُهُ","مُؤَدٍّ إِلَينا وَقتَها وَبَشيرُها",23,"ر",3,0],["وَإِن غَلَتِ الأَرواحُ أَرخَصتَ سَومَها","هُنالِكَ في سوقٍ مِنَ المَوتِ قائِمِ",24,"م",1,0],["وَإِن غِبتُ كانوا بَينَ راوٍ وَمُحتَبٍ","وَبَينَ مُعيبٍ قَلبُهُ بِالشَنائِفِ",25,"ف",1,0],["وإن غدوتُ زُهَيراً في مدائِحِه","فقَد غدا بتوالي جُودِه هَرِما",26,"م",2,0],["وإن غادرْتَ مِصباحاً ضئيلاً","فقد ساوَرْنَ أثقبَ من شِهابِ",27,"ب",1,0],["وَإِن غُنّيتُ عَن أَحَدٍ قَلاني","وَعاقَبَني بِما فيهِ اِكتِفاءُ",28,"ا",2,0],["وَإِن غَدَت لِمُلوكِ الأَرضِ مُشكِلَةٌ","غَدا لَها حَكَماً تَرضى بِها حِكَما",29,"م",2,0],["وَإِن غَشِيَتكِ ظَلماءٌ تَجَلّى","بِغُرَّتِهِ دُجى اللَيلِ البَهيمِ",30,"م",1,0],["وَإِن غُضَّ يَوماً دونَهُ طَرفُ حاسِدٍ","فَإِنَّهُما شَمسٌ تُنيرُ وَأَرمَدُ",31,"د",1,0],["وَإِن غَضِبَت رَأَيتَ الناسَ هَلكى","وَإِن رَضِيَت فَأَرواحٌ تَعودُ",32,"د",1,0],["وَإِن غابَ عَن لَأيٍ بَغيضٌ كَفَتهُمُ","نَواشِئُ لَم تَطرِر شَوارِبُهُم بَعدُ",33,"د",1,0],["وَإِن غَضِبَت خِلتَ بِالمِشفَرَينِ","سَبائِخَ قُطنٍ وَبِرساً نُسالا",34,"ل",2,0],["وإن غُرِسَت في أرضِ قَلْبِي مَحَبَّةٌ","فليسَ بِبُغْضٍ آخِرَ الدَّهْرِ تُثْمِرُ",35,"ر",1,0],["وَإِن غَيَّرَ الإِثمُ الوُجوهَ فَما تَرى","لَدى الحَشرِ إِلّا كُلَّ أَسوَدَ شاحِبِ",36,"ب",1,0],["وَإِن غُفِرَت مُوبِقاتُ الذُنوبِ","فَكُلُّ مَصائِبِهِم تُغتَفَر",37,"ر",1,0],["وَإِنَّ غُروبَ الشَمسِ كُلَّ عَشيَّةٍ","يُحَدِّثُ أَهلَ اللُبِّ عَنهُ دُلوكُها",38,"ك",3,0],["وإن غوين على الفر","ض فالجمال شَفيع",39,"ع",1,0],["وَإِن غَرائِبُها أَجدَبنَ مِن بَلَدٍ","كانَت عَطاياكَ أَندى مِن مَسارِحِها",40,"ح",3,0],["وانغمسوا في الشهوات والترفْ","وأفسدوا شبان أبناء الشرفْ",41,"ف",1,0],["وَإِنْ غَدَرَ الزَّمَانُ بِهِ فَإِنِّي","أَقُومُ بِنَصْرِهِ فِعْلَ الصَّدِيقِ",42,"ق",1,0],["وَإِن غَيَّرَ السقمُ مِن وَجنَتَي","كَ دُرَّ الشَبابِ وَياقوتَه",43,"ه",1,0],["وأنَّ غُراباً شأى \" معبداً \"","وأنّ حِماراً \" غريضاً \" حَكى",44,"ا",1,0],["وإنَّ \" غداً \" باسماً يُجتَلَى","بشِقِّ النفوس . ولا يُوهَب",45,"ب",1,0],["وإن غيّرَ الإثمُ الوجوهَ، فما ترى،- لدى الحشر، إلا كلّ أسودَ شاحبِ","إذا ما أشار العقلُ بالرُّشد، جرَّهمْ-، إلى الغَيّ، طبعٌ أخذهُ أخذُ ساحب",46,"ب",1,0],["وَإن غَدا التربيعُ مِثلَ العَدَدِ","فَجذرُه التَّنصِيفُ دونَ فَنَد",47,"د",1,0],["وَإِن غَضِبَت مِنهُ قُرَيشٌ فَقُل لها","بَني عَمِّنا ما قَومُكُم بِضِعافِ",48,"ف",1,0],["وإن غبت عنا كان في ابنيك سلوةٌ","وإن عَز نطقٌ فالهلالُ يترجمُ",49,"م",1,0],["وَإِن غَنيتَ بِما أَثَّلتَ مِن شَرَفٍ","عَن ذِكرِ ما أَثَّلَت آباؤُكَ النُجُبُ",50,"ب",1,0],["وَإِن غادَرتَ صَبرَهُمُ أَسيراً","فَقَد غادَرتَ رُعبَهُمُ طَليقا",51,"ق",2,0],["وإن غشيتهم محن","فطاعة أمره عصم",52,"م",1,0],["وإن غدت أزمةٌ فاصبر لشدتها","إن الشدائد تأتي ثم تنقرض",53,"ض",1,0],["وَإِن غِبتُ أَدنى ساعَةٍ مِن لحاظِهِ","تَمَحَّلَ في غَيبي بِكُلِّ مِحالِ",54,"ل",1,0],["وإِنَّ غداً باليومِ رَهْنٌ وإِنَّما","مَسيرُ غدٍ كاليومِ أوْ تَريانِ",55,"ن",1,0],["وإن غفا راحت الأحلام عابثة","به فتدنيه أحيانا وتقصيه",56,"ي",2,0],["وإن غبت عنها بعض ليل تلفتت","تسائل عن سرّ القطيعة والصد",57,"د",1,0],["وإن غاب عن عيني أنكرت عيشتي","وضاق علي الرحب من كل منفذ",58,"ذ",1,0],["وأنغام إلهام السماع بروحنا","تبثّ لنا سرّ الحبيب فنفهم",59,"م",1,0],["وإن غبتُ حسبي عينُ غيبك أجتلي","شهادته في حضرة العين والعلم",60,"م",1,0],["وإن غَضِبنَ قليلاً","لي تضحكُ الأمهات",61,"ت",1,0],["وَإنْ غَرَّ الغُواةَ ذُرى جِبالٍ","يُرَوْنَ بِها نُسوراً في وُكورِ",62,"ر",1,0],["وإِن غَنَّت الرَكبيَّ وَالركب سائِرٌ","غدا حائراً ما كدَّرَته وَثَنَّتِ",63,"ت",1,0],["وَإِن غفتْ أو بدتْ في عينها سنةٌ","أهويتُ ألثمها والشرط أملك لي",64,"ل",2,0],["وَإِن غاضَ في ذا القبرِ فيضُ يَمينِها","فَكَم كبدٍ حرّاء أَروى اِنبِجاسها",65,"س",3,0],["وإن غنّت الأمواج خلت غناءها","أنين اليتامى أو نشيج الحرائر",66,"ر",1,0],["وَإِن غَشَّت مَوارِدُها","فَقَد نَصَحَت مَصادِرُها",67,"ر",3,0],["وان غبهم","الموت والعطب",68,"ب",1,0],["وإنْ غدا قابِلاً أعذارَهُ كرماً","فلا يَزالُ على الأكفاء يَفْتَخِر",69,"ر",1,0],["وإن غَدتْ بالنّوالِ فائزةً","فلا يَدٌ للمَلامِ تَفْثَؤها",70,"ا",3,0],["وأن غرامي بعد شيب مفارقي","كما عهدت والخد مِنِّي أجرد",71,"د",1,0],["وإنَّ غريمي غزال اللّوى","فجُوزيت بالخير ذاك الغريما",72,"م",2,0],["وإنَّ غُضَّ طرفٌ عن مكارم ماجد","فلا طرف إلاَّ نحو جدواك طامح",73,"ح",1,0],["وإن غاب عني بدر علمٍ فإنني","تعوّضت بدراً للعلى وهو أسعدُ",74,"د",1,0],["وان غبت تكلف ان ينادي","عليك بجلق أو في هديّه",75,"ي",2,0],["وإن غبتم عن ناظريّ فإنما","تمثلكم عندي المودة والذكر",76,"ر",1,0],["وإن غاب بدر من محاسن شخصه","فإحسانه شمس على الناس تطلُع",77,"ع",1,0],["وإِن غاضَ عَيْنَيْ ماءِ دِجْلَةَ حَيْنُها","لقد أَغرقَتْ أَرْضَيَّ بَعْدَ فُرَاتِها",78,"ت",3,0],["وإن غَدَا كُلُّ رَحْبٍ من بِلادِهِمُ","عَليْهِمُ حُرُماً أفضى بنا حَرَمُكْ",79,"ك",1,0],["وإِنْ غَرَّها بالجُودِ خَاتِلُ طائِفٍ","تهجَّى لَهَا الشَّكْوَى بِغَيْرِ حُرُوفِها",80,"ف",3,0],["وإِنْ غَزَتْ الآمالُ نفسي صرمتُها","بصارِمِ يأْسٍ فِي يمينِ تُقىً حُرِّ",81,"ر",1,0],["وإِنْ غالَتِ البيدُ اصطبارَكِ والسُّرى","فما غالَ ضيم الكاشِحينَ اصطبارَكِ",82,"ك",1,0],["وأَنَّ غابك ثقب لا عبئت بها","فغابة الأسد الحامي الحمى ثقب",83,"ب",1,0],["وأنّ غصناً أنت من فروعه","لخيرُ غصنٍ مثمراً أو مورقا",84,"ق",2,0],["وإن غنيتم لغنى أنفسكم","عن رغبةٍ فهو إليكم مفتقِرْ",85,"ر",1,0],["وإن غزا فهو الهِزبرُ الضاري","أغْلب ماضي العزْم من نِزارِ",86,"ر",1,0],["وإن غاض ماءُ الضَّرع وامتقع الثرى","وعمَّ الطَّوى خصوا العراقيب بالحلب",87,"ب",1,0],["وَإِن غَنّى الحَديدُ فَهُم سُقاةٌ","يُديرونَ الكُؤوسَ مِنَ الحُتوفِ",88,"ف",1,0],["وَإِن غُرتِ غُرنا حَيثُ كُنتِ وَغُرتُمُ","أَوَ انجَدتِ أَنجَدنا مَع المُتَنَجِّدِ",89,"د",1,0],["واِنْ غبطَتْني الفضلَ والعقلَ أُمَّةٌ","فمَنْ ذا على ما كانَ منها يلومُها",90,"م",3,0],["واِنْ غابَ عن أفكارِ قومٍ صحيحةٍ","غدا والى فكري الصحيحِ انتسابُهُ",91,"ب",2,0],["وإن غفَلْتَ فعُدْ للذِّكْرِ مبتَهِجاً","ذَنْبُ المُحِبِّ مع الأَحْبابِ مغْفُورُ",92,"ر",1,0],["وإنْ غشِيَتْ نورَ البصائِرِ ظُلمةٌ","جلَبْتَ من الرّأيِ السّديدِ بها فجْرا",93,"ر",2,0],["وإن غشيت إلى سقيا ثمارهم","فلا سقى الله لي قلباً سوى الغلل",94,"ل",1,0],["وإنْ غَنَّتْ لَهُ أَبكارُ عِلْمٍ","فعِنِّينٌ بعُنَّتِهِ يُعاني",95,"ن",2,0],["وإنْ غَدا سِرْبُهُمُ آمناً","فَكُلُّ شَرٍّ عَنْهُ لَمْ يَنْكُصُوا",96,"ص",3,0],["وإنْ غفرتُ جُرمَهُ","أعاد ما كان جَرَمْ",97,"م",1,0],["وإنّ غنيّاً في الهوى ونزيلُهُ ال","مشيبُ فقيدُ الرّاحتين عديمُ",98,"م",1,0],["وَإنْ غبتَ عن عَيني فما غبتَ عن حَشىً","مُقَلْقِلَةٍ تحنو عليك وأضلعُ",99,"ع",1,0],["وإنّ غناءً بعد هُلْكِكَ أصْلَمٌ","وإنّ وفاءً بعد فقدك أجْدَعُ",99,"ع",1,0],["وإنّ غبينَ النّاسِ مَن بات عِرْضُهُ","تعرّضُهُ السُّوءى لبعضِ القرائحِ",100,"ح",1,0],["وَإِنْ غابَ مِن بَعدِ طولِ المَدى","فَإِنَّك أَطوَلُ مِنهُ بقا",101,"ا",1,0],["وَإِن غَفَلَ الدَيّوثُ عَنها تَقَنَّعَت","بِثَوبِ الدُجى تَرتادُ مَزنىً وَمَعهَرا",102,"ر",2,0],["وإن غرد الشحرور كان إشارة","به منه فينا أو تناوح لغلغ",103,"غ",1,0],["وإن غصبوا أوصافهم من ذواتها","أغارت عليهم منه خيل طلائع",104,"ع",1,0],["وإن غَفَلتُ لضُعفي هَبَّ مُنتبِهاً","وإن نَسيتُ مواثيقَ الهَوَى ذَكرا",105,"ر",2,0],["وإِن غِبْتَ فما غَابَ","فؤَادِي بين أَفْنَائِك",106,"ك",1,0],["وإِن غبتَ كان البدرُ مِنكَ خَليفَةً","وإِن قُلْتَ لي أَنْشَأْتُ عَنْكَ لَه الْعَهْدَا",107,"د",2,0]]}