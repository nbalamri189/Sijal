{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[53,"مقيم من الهم لا يقلع","https://www.aldiwan.net/poem29974.html","المتقارب"],[53,"عظيم الأسى في هذه غير مقنع","https://www.aldiwan.net/poem30141.html","الطويل"],[53,"ألا أيها الركب اليمانون عهدكم","https://www.aldiwan.net/poem30717.html","الطويل"],[53,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[55,"أيا زهر الملاحة والجمال","https://www.aldiwan.net/poem26184.html","الوافر"],[77,"سقى دارهم هام من السحب هامع","https://www.aldiwan.net/poem35996.html","الطويل"],[77,"لقد رام كتم الوجد يوم ارتحاله","https://www.aldiwan.net/poem36375.html","الطويل"],[77,"هنيئا لمن حث الركائب في بدر","https://www.aldiwan.net/poem36494.html","الطويل"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[88,"بكت في ظلام الليل تندب أهلها","https://www.aldiwan.net/poem44803.html","الطويل"],[88,"ابنوا المدارس واستقصوا بها الأملا","https://www.aldiwan.net/poem45004.html","البسيط"],[72,"يجور كما شاء الدلال ويعدل","https://www.aldiwan.net/poem19476.html","الطويل"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[51,"فقدتك يا كنيزة كل فقد","https://www.aldiwan.net/poem8705.html","الوافر"],[51,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[51,"لا تحسب النبط الأوغاد أنهم","https://www.aldiwan.net/poem66340.html","البسيط"],[26,"نام الخلي وبت الليل مشتجرا","https://www.aldiwan.net/poem24088.html","البسيط"],[70,"إذا ما نسيتك من أذكر","https://www.aldiwan.net/poem42907.html","المتقارب"],[92,"يا لاابتسامة قلب","https://www.aldiwan.net/poem38892.html","مجزوء الكامل"],[62,"إن أخذنا الكبريت ثم خلطنا","https://www.aldiwan.net/poem52210.html","الخفيف"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[45,"مغاني سليمى بالعقيق ودورها","https://www.aldiwan.net/poem63610.html","الطويل"],[45,"دموع عليها السكب ضربة لازم","https://www.aldiwan.net/poem65662.html","الطويل"],[28,"ولست بناس فضل مروان ما دعت","https://www.aldiwan.net/poem5320.html","الطويل"],[61,"ما ودع اللهو لما بان منصرما","https://www.aldiwan.net/poem51437.html","البسيط"],[61,"تناهى فاطمأن إلى العتاب","https://www.aldiwan.net/poem51802.html","الوافر"],[58,"تغيرت المودة والإخاء","https://www.aldiwan.net/poem31208.html","الوافر"],[66,"اليوم زعزع ركن المجد وانهدما","https://www.aldiwan.net/poem40121.html","البسيط"],[44,"لعلك ذاكر الطلل القديم","https://www.aldiwan.net/poem29686.html","الوافر"],[74,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[33,"ذكرت عشية الصدفين ليلى","https://www.aldiwan.net/poem25960.html","الوافر"],[22,"ألا طرقتنا بعدما هجدوا هند","https://www.aldiwan.net/poem21643.html","الطويل"],[22,"نأتك أمامة إلا سؤالا","https://www.aldiwan.net/poem21647.html","المتقارب"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[46,"عصا في يد الأعمى يروم بها الهدى","https://www.aldiwan.net/poem22167.html","الطويل"],[46,"لعمري لقد طال هذا السفر","https://www.aldiwan.net/poem22748.html","المتقارب"],[46,"كأن إبارا في المفارق خيطت","https://www.aldiwan.net/poem23068.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85579","المجتث"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1149","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42716","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43674","المتقارب"],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"إلى المناضلين","https://www.poetsgate.com/ViewPoem.aspx?id=179212",""],[46,"عصا في يد الأعمى، يرومُ بها الهدى،","https://www.poetsgate.com/ViewPoem.aspx?id=18006",""]],"verses":[["وَإِنَّ غَريبَ القَومِ مَن عاشَ فيهِمُ","وَليسَ يَرى إِلّا عَدُوّاً مُداجِيا",0,"ي",2,0],["وَإِن غِبتُ عَنكَ فَإِنَّ الفُؤادَ","عِندَكَ ما فاتَهُ مَوضِعُ",1,"ع",1,0],["وَإِنَّ غَبينَ القومِ مِن طاعِنِ الرَدى","إِذا جاءَ في جَيشِ الرَزايا بِأَدمُعِ",2,"ع",1,0],["وَإِنَّ غَزالاً جُزتُمُ بِكِناسِهِ","عَلى النَأيِ عِندي وَالمَطالِ حَبيبُ",3,"ب",1,0],["وَإِن غَرَبتِ فَلِطّا","لِعاتِ شَرقٌ وَغَربُ",4,"ب",1,0],["وَإِن غَفَلَت عُيونُهُم رَجَعنا","لِأَحسَنِ ما يَكونُ مِنَ الوِصالِ",5,"ل",1,0],["وإنْ غالَ خطْبُ فهْوَ مأْوَى منَ الرّدَى","وإنْ هالَ ذنْبٌ فهْوَ في الذّنْبِ شافِعُ",6,"ع",1,0],["وَإِنْ غَالَهَا حَرَّ الْهَجِيِرِ فَذَكَّرِا","غَضَارَةَ وَادِيهِ وَبَرْدَ ظِلاَلِهِ",7,"ل",2,0],["وإنْ غابَ قُرْطٌ عنْدَهُ ومُقلَّدٌ","رجَعْتُ الى الجوْزاءِ والأنْجُمِ الزُّهْرِ",8,"ر",1,0],["وَإِنَّ غَزاتَكَ مِن حَضرَمَوتَ","أَتَتني وَدوني الصَفا وَالرَجَم",9,"م",1,0],["وَإنَّ غَداً وَإِنَّ اليَومَ رَهنٌ","وَبَعدَ غَدٍ بِما لا تَعلَمينا",10,"ن",2,0],["وإن غزير الدمع خدّد خّدها","فلاحت من الأشجان فيه فتون",11,"ن",1,0],["وأن غزا مستظِلاً ظلّ رايته","هزّ البلاد وأحيا الأعصُر الأُولا",12,"ل",2,0],["وإن غزلت لي من ضنا الجسم حلةً","لما حلتُ عن أني بها أتغزَّل",13,"ل",1,0],["وإن غدا الشَّبوط قِرْناً لهم","فخدُّ شَبُّوطِهمُ التَّاربُ",14,"ب",1,0],["وإن غنَّيتِ زنَّيت الندامى","فلا عَمِرتْ بحضرتك البُيوتُ",15,"ت",1,0],["وإن غدا أظلمَ من قاسمٍ","ذاك الذي يجفو وأشتاقه",16,"ق",2,0],["وإن غَدوا دون أهلِ الأرضِ إخوته","أبوهُمُ وأبيهِمْ منبتُ الأجمِ",17,"م",1,0],["وَإِنَّ غُلاماً نيلَ في عَهدِ كاهِلٍ","لَطِرفٌ كَنَصلِ المَشرَفِيَّ صَريحُ",18,"ح",1,0],["وَإِن غابَ أُنسُكَ عَن مَجلِسي","فَما لِيَ أُنسٌ بِمَن يَحضُرُ",19,"ر",1,0],["وإن غفوت فإن الحي","اة ليست تروعك",20,"ك",1,0],["وانغماس الكبريت في الجسد","الأبيض من أصعب الأمور علينا",21,"ن",2,0],["وإنْ غلبتكم شِقْوةُ الجَدِّ فاعلموا","بأن ديارَ الناكثينَ طُلولُ",22,"ل",1,0],["وَإِن غُمَّ أَخبارُ العَطايا فَبِشرُهُ","مُؤَدٍّ إِلَينا وَقتَها وَبَشيرُها",23,"ر",3,0],["وَإِن غَلَتِ الأَرواحُ أَرخَصتَ سَومَها","هُنالِكَ في سوقٍ مِنَ المَوتِ قائِمِ",24,"م",1,0],["وَإِن غِبتُ كانوا بَينَ راوٍ وَمُحتَبٍ","وَبَينَ مُعيبٍ قَلبُهُ بِالشَنائِفِ",25,"ف",1,0],["وإن غدوتُ زُهَيراً في مدائِحِه","فقَد غدا بتوالي جُودِه هَرِما",26,"م",2,0],["وإن غادرْتَ مِصباحاً ضئيلاً","فقد ساوَرْنَ أثقبَ من شِهابِ",27,"ب",1,0],["وَإِن غُنّيتُ عَن أَحَدٍ قَلاني","وَعاقَبَني بِما فيهِ اِكتِفاءُ",28,"ا",2,0],["وَإِن غَدَت لِمُلوكِ الأَرضِ مُشكِلَةٌ","غَدا لَها حَكَماً تَرضى بِها حِكَما",29,"م",2,0],["وَإِن غَشِيَتكِ ظَلماءٌ تَجَلّى","بِغُرَّتِهِ دُجى اللَيلِ البَهيمِ",30,"م",1,0],["وَإِن غُضَّ يَوماً دونَهُ طَرفُ حاسِدٍ","فَإِنَّهُما شَمسٌ تُنيرُ وَأَرمَدُ",31,"د",1,0],["وَإِن غَضِبَت رَأَيتَ الناسَ هَلكى","وَإِن رَضِيَت فَأَرواحٌ تَعودُ",32,"د",1,0],["وَإِن غابَ عَن لَأيٍ بَغيضٌ كَفَتهُمُ","نَواشِئُ لَم تَطرِر شَوارِبُهُم بَعدُ",33,"د",1,0],["وَإِن غَضِبَت خِلتَ بِالمِشفَرَينِ","سَبائِخَ قُطنٍ وَبِرساً نُسالا",34,"ل",2,0],["وإن غُرِسَت في أرضِ قَلْبِي مَحَبَّةٌ","فليسَ بِبُغْضٍ آخِرَ الدَّهْرِ تُثْمِرُ",35,"ر",1,0],["وَإِن غَيَّرَ الإِثمُ الوُجوهَ فَما تَرى","لَدى الحَشرِ إِلّا كُلَّ أَسوَدَ شاحِبِ",36,"ب",1,0],["وَإِن غُفِرَت مُوبِقاتُ الذُنوبِ","فَكُلُّ مَصائِبِهِم تُغتَفَر",37,"ر",1,0],["وَإِنَّ غُروبَ الشَمسِ كُلَّ عَشيَّةٍ","يُحَدِّثُ أَهلَ اللُبِّ عَنهُ دُلوكُها",38,"ك",3,0],["وإن غوين على الفر","ض فالجمال شَفيع",39,"ع",1,0],["وَإِن غَرائِبُها أَجدَبنَ مِن بَلَدٍ","كانَت عَطاياكَ أَندى مِن مَسارِحِها",40,"ح",3,0],["وانغمسوا في الشهوات والترفْ","وأفسدوا شبان أبناء الشرفْ",41,"ف",1,0],["وَإِنْ غَدَرَ الزَّمَانُ بِهِ فَإِنِّي","أَقُومُ بِنَصْرِهِ فِعْلَ الصَّدِيقِ",42,"ق",1,0],["وَإِن غَيَّرَ السقمُ مِن وَجنَتَي","كَ دُرَّ الشَبابِ وَياقوتَه",43,"ه",1,0],["وأنَّ غُراباً شأى \" معبداً \"","وأنّ حِماراً \" غريضاً \" حَكى",44,"ا",1,0],["وإنَّ \" غداً \" باسماً يُجتَلَى","بشِقِّ النفوس . ولا يُوهَب",45,"ب",1,0],["وإن غيّرَ الإثمُ الوجوهَ، فما ترى،- لدى الحشر، إلا كلّ أسودَ شاحبِ","إذا ما أشار العقلُ بالرُّشد، جرَّهمْ-، إلى الغَيّ، طبعٌ أخذهُ أخذُ ساحب",46,"ب",1,0]]}