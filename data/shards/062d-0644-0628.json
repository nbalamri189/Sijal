tps://poetry.dctabudhabi.ae/diwan/poem/123863","الخفيف"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104904","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141567","الكامل"],[4859,"تسيّد الجبناء!","https://www.poetsgate.com/ViewPoem.aspx?id=187405",""],[5152,"خزي الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=184658",""],[5376,"ولد الحبيب فنوره وضَّاء","https://www.poetsgate.com/ViewPoem.aspx?id=188484",""],[5376,".قالوا الوغى قد فرَّها فرَّارُها......حلب","https://www.poetsgate.com/ViewPoem.aspx?id=188500",""],[5397,"هل من ضناي معالج يبريني","https://www.poetsgate.com/ViewPoem.aspx?id=157932",""],[5425,"عَرَبِيَّةٌ مِنْ قَاسِيُونَ تُعَلِّقُ","https://www.poetsgate.com/ViewPoem.aspx?id=207508",""],[5431,"حلب","https://www.poetsgate.com/ViewPoem.aspx?id=183040",""],[5490,"قف بالمعرة","https://www.poetsgate.com/ViewPoem.aspx?id=176334",""],[5561,"الجمرُ صبرُ النار","https://www.poetsgate.com/ViewPoem.aspx?id=195029",""],[402,"أفراقا وأنت آخر باق","https://www.poetsgate.com/ViewPoem.aspx?id=35995",""],[6052,"رداء السكينة والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=34646",""],[6075,"أرض الصمود","https://www.poetsgate.com/ViewPoem.aspx?id=190500",""],[6093,"زاد في هجره لا تسلْ","https://www.poetsgate.com/ViewPoem.aspx?id=203215",""],[6125,"يا شام مهلاً فالأسى تنكيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=210914",""],[463,"لمنَ الطلولُ تراقصتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60065&r=&rc=121",""],[6261,"الهجرة الخامسة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82138&r=&rc=10",""],[6290,"وَطَنٌ فِي الصَّدْرِ مَوْؤُدٌ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85170&r=&rc=3",""]],"verses":[["حَلَبَت ذَخائِرَها المَدامِعُ بَعدَكُم","في أَربُعٍ قَبلَ العَقيقِ دَواثِرِ",0,"ر",1,0],["حَلَبْنا أفاوِيقَ الغِنى منْ يَمينِهِ","وما غَرّنا البَرْقُ اللَّموعُ ولا الرَّعْدُ",1,"د",1,0],["حَلَّ بِالجُمعَةِ حُزنٌ وَأَسىً","وَمَشى الوَجدُ إِلى يَومِ الأَحَد",2,"د",1,0],["حَلَبتُ شُطورَ الدَهرِ يُسراً وَعُسرَةً","وَجَرَّبتُ حَتّى حَنكَتني التَجارِبُ",3,"ب",1,0],["حلَّ بي فيكَ مَشْمَتٌ","جَلَّ عن كلِّ مُشْمِتِ",4,"ت",1,0],["حل بالأمتين خطب جليل","رجل مات والرجال قليل",5,"ل",1,1],["حَلَبتُ لَهُ الثَناءَ فَجاءَ عَفواً","جَلِيَّ الرِسلِ مَعسولَ المِزاجِ",6,"ج",1,0],["حَلَبنا بِأَخلافِ السَماءِ عَلَيهِمُ","شَآبيبُ مَوتٍ تَستَهِلُّ وَتَرزِمُ",7,"م",1,0],["حل بالأيك خريف منكر","وظلال قاتمات وغيوم",8,"م",1,0],["حَلَبتُ صَرفَ النَوى صَرفَ الأَسى وَحَداً","بِالبَثِّ في دَولَةِ الإِغرامِ وَالدَدَنِ",9,"ن",1,0],["حلبٌ على رغمي أقلُّ سعادةٍ","مِنْ أنْ يعيشَ لها الكمالُ الأورعُ",10,"ع",1,0],["حلبٌ واللهُ يكفي","شرَّها أرضُ مشقهْ",11,"ه",1,1],["حَلَبُوا شَطْرَيْهِ فِي الجودِ والبَأْ","سِ فأَحْلَى وأَمَرَّ الحِلابا",12,"ب",2,0],["حَلَبتُ لِأَصحابي بِها دِرَّةَ الصِبا","بِصَفراءَ مِن ماءِ الكُرومِ شَمولِ",13,"ل",1,0],["حَلَبتُ بِشِعري راحَتَيهِ وَقَد رَنا","سَماحاً كَما دَرَّ السَحابُ عَلى الرَعدِ",14,"د",1,0],["حَلَبتَ لِلقَومِ فَلا تَنسَني","وَأَنتَ عَرفُ الجودِ مَحلوبُ",15,"ب",1,0],["حَلَبِيَّةٌ في النِسبَتَينِ لِأَنَّها","حَلَبُ الكُرومِ وَأَنَّ مَوطِنَها حَلَب",16,"ب",1,0],["حَلَبتَ الزَمانَ العَودَ أَشطُرَ ثِرَّةٍ","صَفيٍّ وَما تَنفَكُّ مِن جَهلِ مُرضِعِ",17,"ع",1,0],["حَلَبوا دُرَّةَ الكُؤوسِ وَأَلغَوا","ما رَواهُ الكَرَخِيُّ وَالحَلَبِيُّ",18,"ب",2,0],["حَلَبٌ للَوليّ جَنْةُ عَدْنٍ","وهْيَ للغادرينَ نارُ سعيرِ",19,"ر",1,0],["حَلَباً حَجّتِ المَطِيُّ ولو أنْ","جَمْتَ عنها مالَتْ إلى حَرّانِ",20,"ن",1,0],["حل بأحشائه فسادُ","عصى فَلا يقبل الصلاحا",21,"ح",2,0],["حَلَباً يمْلأ الجِفانَ سَديفاً","يَرْعَبُ الغالِياتِ بالتَّرْعِيب",22,"ب",1,0],["حَلَبْتُ شَطْرَيْهِ مِنْ يُسْرٍ وَمَعْسرَةٍ","وَذُقْتُ طَعْمَيْهِ مِنْ خِصْبٍ وَإِمْحَالِ",23,"ل",1,0],["حَلَبْتُ الدَّهْرَ أَشْطُرَهُ مَلِيَّاً","وَذُقْتُ الْعَيْشَ مِنْ أَرْيٍ وَصابِ",24,"ب",1,0],["حَلَبْتُ أَشْطُرَ هَذَا الدَّهْرِ تَجْرِبَةً","وَذُقْتُ مَا فِيهِ مِنْ صَابٍ وَمِنْ عَسَلِ",25,"ل",1,0],["حَلْبَةٌ يُعذَرُ المُقَصِّرُ فِيهَا","وَالخَوَاتِيمُ رَهْنُ تِلْكَ المَبَادِي",26,"د",2,0],["حَلَبٌ أَنْجَبَتْكَ وَهْيَ فَخُورةٌ","بِفَتَاهَا الشِهيرِ فِي الآفَاقِ",27,"ق",1,0],["حَلَّ بِأَجفانِكَ ما راعَني","فَكَيفَ أَستَحسِنُ أَجوازَها",28,"ه",2,0],["\" حَلبٌ \" فتَّقَت أضاميمَ ذِهنٍ","كان من قبلُ \" وردةً \" في كمائِم",29,"م",1,0],["حلَبتُ كِلا شطرَيْ زماني تمعّناً","فلم أحمَدِ الشطر الذي فَضَلَ الشطرا",30,"ر",2,0],["حلَبِيّةٌ في النّسبتينِ، لأنّهما","حلَبُ الكُرومِ، وأنّ موطنها حلَب",31,"ب",1,0],["حَلَبْنا بأخْلافِ السّماءِ عَلَيهِمُ","شَآبيبَ مَوْتٍ تَسْتَهِلّ وَتُزْرِمُ",32,"م",1,0],["حل بسري وعلى","منصة السر علا",33,"ل",2,0],["حل بقلبي شخصه وحاله","بناظري الله ما احلاه",34,"ا",2,0],["حَلَبتُ الدَّهرَ شَطرَيهِ فَأناً","أمَرَّ عَلَىَّ وأحلَولَى بِأنِ",35,"ن",1,0],["حلّ بيتَ الأسماع من غيرِ إذنٍ","وأتى للقلوب من كل بابِ",36,"ب",1,0],["حل بها التوفيق حين حلها","فالتقيا فيها على مقدار",37,"ر",1,0],["حلبَ الضرعَ أشبعَ الركب منها","بإِناءٍ وزادَ عنهم إناءُ",38,"ا",2,0],["حل بيافوخك مني الذي","يحل يوم العيد بالطبل",39,"ل",1,0],["حلب مقصدي على القرب منه","ليس من مقصدي زبيد ومرو",40,"و",1,0],["حلب الشهباء في الارض علت","سائر الأمصار في اقطارها",41,"ر",3,1],["حلبت أشطر أجفاني لفرقتها","وما درت حلب ما در من حلب",42,"ب",1,0],["حلبت دهري وحظى","فما بللت أُواما",43,"م",2,0],["حَلَّ بِالجَزعِ فَحَلّى دَوحَهُ","وَسَقى مِنهُ النَدا ذاكَ النُدَي",44,"ي",1,0],["حَلَّ بي ما كُنتُ مِنه","أَتَوقَّا يا مُوقَّى",45,"ق",2,0],["حل بيني وبينكم ريْبُ دهر","يُبْطِل الوصل بالقطيعة قطعا",46,"ع",2,0],["حلبَت أَخلاف هَذا الدَهرُ مُنتَصِراً","فَلَم أَدَع فيهِما حَظاً لِمُحتَلِبِ",47,"ب",1,0],["حَلَبتُ الدَهرَ أَشطُرَه","وفي حَلبٍ صَفا حَلَبي",48,"ي",1,1],["حلبت بمسمع كل ذي سمع فما","تنفكّ بين ترنّ ونشيد",49,"د",1,0],["حلب حماك الله من","عين ابن فاجرة أثيمه",50,"م",2,0],["حَلَبَ الهَجيرُ بِلَيتِها وَمَقَذِّها","حَتّى كَأَنَّ بِها عَنِيَّةَ قارِ",51,"ر",1,0],["حَلْبتُها القرطاسُ وال","أسطرُ خَيلٌ دُهُمُ",52,"م",1,0],["حَلَبَ البكيَّة ثم جَد","دَ من الصباحِ نِفارُها",53,"ر",3,0],["حَلَّ بي ما كُنتُ عَنهُ غافِلاً","لَيسَ يَدري المَرءُ ما يَقضي عَلَيهِ",54,"ي",2,0],["حلبت أفاويق الزمان براحة","تدر بها أخلافه حين تحلب",55,"ب",1,0],["حَلَبتَ هَذي الدُهورَ أَشطُرَها","أَبتُرُ أَخلافَها وَأَلبَؤُها",56,"ه",2,1],["حلبت الدهر أشطره حياتي","ونلت من المنى بلغ المزيد",57,"د",1,1],["حَلَّ بي مِنْ هَواكَ ما لَيْس يُنْبي","عَنْهُ نَعْتٌ ولا يُعبِّرُ وَصْفُ",58,"ف",1,0],["حلب بدر دجا ان","مها الزهر قراها",59,"ا",3,0],["حلبت در السرور في حلب","بين رياض تدعو إلى الطرب",60,"ب",1,1],["حَلَبٌ بَدْرُ دُجاً أَنْجُمُها","الزُّهْرُ قُرَاها",61,"ا",3,0],["حَلَبٌ أكرَمُ مأوى","وكريمٌ مَنَ أوَاها",61,"ا",3,0],["حَلَّ بي أَمرٌ وَما إِن يحملِ","أَذهَبَ العَقلَ وَخَلّاني المَريض",62,"ض",1,0],["حلّ بالقلب حبّ طه فتاها","انما الفخر كله حب طه",63,"ه",1,1],["حلّ بالعالي فما من طيِّب","من خباياه له إلاَّ سمحْ",64,"ح",1,0],["حل بها قوم وهم في عمى","ما ميزوا أشرارها والخيار",65,"ر",1,0],["حَلَبت خلوفَ الدَّهرِ كَهلاً وَيافِعاً","وَجَرَّبتُ حَتّى أَحكَمَتني التَجارِبُ",66,"ب",1,1],["حلَّ بنيان اصطباري المنعقدْ","غليانٌ من دموعي لا يطاقْ",67,"ق",1,0],["حلبات السبق في العلم له","وعليه خنصر المعروف يلوى",68,"و",2,0],["حلبنا به ضرع المدامع لو صفى","لأخصب من أكفنافه الماحل القفر",69,"ر",1,0],["حَلَبتُ بِهِ الحلوقَ دَماً نَجيعاً","بِحَيثُ يَدرُّ لِلحَلبِ النُخاعُ",70,"ع",1,0],["حلب الحمام أبا الأمين بك الجوى","شطرين صاباً في الزمان وعلقما",71,"م",2,0],["حلبُ الغمامِ رضابُها","وحديثُها حلبُ العصيرِ",72,"ر",1,0],["حَلَّ بِأَكتافِكَ في جِلَّقٍ","ما حَلَّ بِالهَيتِيِّ في آمِدِ",73,"د",1,0],["حلبت في القريض فهي معانٍ","رفعت قدره عن الأوصاف",74,"ف",1,0],["حلبت به رقابهم دماءً","ملجت به أديم الأرض ملجا",75,"ج",2,0],["حَلَبنا الدَهرَ أَشطُرَهُ وَمَرَّت","بِنا عُقَبُ الشَدائِدِ وَالرَخاءِ",76,"ا",2,0],["حلب الدهر أشطراً ومضى فو","ق مَطاه وذاق شهداً وَصَابَه",77,"ب",2,0],["حَلَبٌ هِيَ الدُنيا تُحَبُّ وَطَعمُها","طَعمانِ حُلوٌ في المَذاقِ وَعَلقَمُ",78,"م",1,0],["حل بها العاصي ألا فاعجبوا","من جنة حل بها العاصي",79,"ي",1,0],["حلّ بمغنى الغَنِيِّ في حلب","تجنى ثمار المنى وتقطفها",80,"ف",3,0],["حلّ بها من دوخت سطوته","كل مهيب باسمه يخوف",81,"ف",1,0],["حَلَبَ العِشارَ مِنَ النُّحورِ وَزادَ عَن","أَلبانِها دَرَّ النَّجيعِ السّافِحِ",82,"ح",1,0],["حلَبٌ إنّها مقَرّ غرامي","ومرامي وقبلةُ الأشواقِ",83,"ق",1,0],["حَلبْتُ فكنتَ ضَرعاً بكيّاً","هززت فكنتَ لي سيفاً كَهاما",84,"م",2,0],["حلبتُ الدَهرَ أَشطُرَهُ زَماناً","وَأَغناني العِيانُ عَن السُؤالِ",85,"ل",1,1],["حلب مذ حللتها حل فيها","عين رأسي والقلب في رأس عين",86,"ن",1,1],["حلب بها خاوي وفيه كرومها","والبشر قل جبل سنمى بجبانة",87,"ه",1,0],["حل بستان شاهك طائر السع","د بوجه الإمام ذي الأسفار",88,"ر",1,0],["حلّ بهِم لولا ابنُهُ العذابُ","وفاجأ البسيطةَ انقِلابُ",89,"ب",1,0],["حلبات المجد لاحقها","في المعالي غير سابقها",90,"ق",3,0],["حلبت شطور الفكر فانصاع درها","جداول من ضرع البلاغة يسفح",91,"ح",1,0],["حل بالنّاس والهواتف فيهم","أرخت إنه هلاك عظيم",92,"م",1,0],["حلبتُ بهِ وُسعَ الإِناءِ معارفاً","يُلازِمُني جُنحَ الدُجَى وأُلازمُه",93,"م",2,0],["حَلَبَّيةٍ تزهو نَفاستُها على","نَفسٍ غدت شاميَّةَ الآراءِ",94,"ا",2,0],["حلبتُ الدهر أشطره","وفيه الخير والشر",95,"ر",1,0],["حل بهم ما عجل الله من","عقاب آثامهم المخزيات",96,"ت",1,0],["حل بين المتنين والحبل فيه","فوق مرآة صدرها العاجيه",97,"ي",2,0],["حَلَّ بي مِثلَما عَلِم","تَ فَجِسمي كَما تَرى",98,"ر",2,0],["حَلَّ بَيتاً للأمِّ مَعبَدَ فَارتَا","حَت لِوَصفِ مُحيٍ بِنَشرِهِ مَوتَى",99,"ت",2,0],["حلّ بي من حُبّك الخطْ","بُ الّذي لا كالخُطُوبِ",100,"ب",1,0],["حَلَّ بِاليُمن وَالبَنين وَخَيرٌ","وَلِنَفع الأَبناء لِلأَوطانِ",101,"ن",1,0],["حلبيٌّ ذو دلالٍ","يوم وصلٍ منه عيدك",102,"ك",1,0],["حلب الشاة خلفه اردف الرا","كب قال المزاح غير الفراء",103,"ا",2,0],["حَلَبٌ لها حلبُ المدامعِ سُيّلٌ","أَنْ لاقت الخطبَ الفظيعَ المبكيا",104,"ي",2,0],["حَلَّ بها أبهى البُدُورِ هالَةً","أوفَت على كُلِّ البِلادِ من عَلا",105,"ا",1,0],["حلبت لك الأنعام ضرعاً حافلاً","ورنت على أفنانها أطيارها",106,"ه",2,1],["حلبت لك الأنعام ضرعاً حافلاً","وأرت على أفنانها أطيارها",107,"ر",3,0],["حل بي نظمكم باحلى المواقع","قول لطف ظرف الدعابة جامع",108,"ع",1,1],["حلبت دهري في تصاريفه","شطريه من عسر ومن يسر",109,"ر",1,0],["حلبت به رأسي خلافاً للنسا","عاماً وكل العام كان خريفا",110,"ف",2,0],["حلبٌ تباد بها الحياةُ ويشتكي","فيها الإباءُ تسيّد الجبناءِ",111,"ا",2,1],