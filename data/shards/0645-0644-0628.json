{"poems":[[55,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[95,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[53,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[93,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[30,"إذا عرض المنام لنا بسلمى","https://www.aldiwan.net/poem5154.html","الوافر"],[82,"يا ذنوبي ثقلت والله ظهري","https://www.aldiwan.net/poem31425.html","الخفيف"],[46,"ما لي بعادية الأيام من قبل","https://www.aldiwan.net/poem30374.html","البسيط"],[41,"قل في شط نهروان اغتماضي","https://www.aldiwan.net/poem53771.html","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16686","المنسرح"],[139,"بعيد اللقا وافى وأنجز موعدي","https://www.aldiwan.net/poem49122.html","الطويل"],[190,"يا أبا القاسم الأديب ويا من","https://www.aldiwan.net/poem44128.html","الخفيف"],[194,"قد رحل الحى الغداة عمدا","https://www.aldiwan.net/poem1154.html",""],[203,"مل بي عن الورد واسقني القدحا","https://www.aldiwan.net/poem45643.html","المنسرح"],[237,"لو أنكرت لحظات طرفك مصرعي","https://www.aldiwan.net/poem14707.html","الكامل"],[369,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[463,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[475,"فيا ليت أنا قد تعشقت الملا","https://www.aldiwan.net/poem4738.html","الطويل"],[520,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[556,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[564,"مل بنا يا سعد وانزل بالحجون","https://www.aldiwan.net/poem69342.html","الرمل"],[591,"ملبسي من هجره ثوب الضنى","https://www.aldiwan.net/poem17787.html","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64116","الخفيف"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61018","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112939","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118429","البسيط"],[2032,"","https://poetry.dctabudhabi.ae/diwan/poem/121984","الكامل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131333","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53063","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53236","البسيط"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88658","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140044",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135738","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102738","الخفيف"],[5854,"فصحى اللغات","https://www.poetsgate.com/ViewPoem.aspx?id=208608",""],[6142,"مل بنا يا هديت ننتجع الحق","https://www.poetsgate.com/ViewPoem.aspx?id=155693",""]],"verses":[["مُلَبِّداً يَرمي إِلى","مَكَّةَ حَصباءَ الوَبَر",0,"ر",1,0],["مُلبَساتٌ مِثلَ الرَمادِ مِنَ الكُر","رَةِ مِن خَشيَةِ النَدى وَالطِلالِ",1,"ل",1,0],["ملبسه لا عيب فيه نظيف","وسيره سير أميرٍ شريف",2,"ف",1,0],["ملبسٌ فيه فرحةٌ من غرورٍ","وهْو باقٍ وترحةٌ وهو ناض",3,"ض",1,0],["ملبساتٍ من التهاويلِ زيّاً","يستفزّ القلوبَ قبل التّبال",4,"ل",1,0],["مَلَّ بَنو الإِنسانِ أَطوارَهُم","وَبَرِموا بِالسُقمِ وَالعافِيَه",5,"ه",1,0],["مُلَبَّدَةٌ رُؤوسُهُمُ سِراعاً","إِلى البَيتِ المُحَرَّمِ ذي السُتورِ",6,"ر",1,0],["مِلْ بقلبي إلى صَلاحِ فسادي","منه واجبرْ برأفةٍ منك كسري",7,"ر",2,0],["مُلَبِّياً طالَما لَبّى مُنادِيَهُ","إِلى الوَغى غَيرَ رِعديدٍ وَلا وَكَلِ",8,"ل",1,0],["مُلبَساتِ القَتامِ يُمسي عَلَيها","مِثلُ ساجي دَواجِنِ الحَرّاضِ",9,"ض",1,0],["مَلْبَسُ قَيْلٍ ما خِيطَ مُشْبِهُهُ","لِدارِمٍ قَبْلَنا ولا دَرِم",10,"م",1,0],["ملبيِّ الندا رب الندى معدن الهدى","مذيق العدا طعم الردى والتبدد",11,"د",1,0],["مل بهذا إلى فقيه عليم","بشروط التعليم في ترتيب",12,"ب",1,0],["مُلبَسَةً سَبائِباً وَلِبدا","تَحتَ ظِلالِ رايَةٍ وَبَندا",13,"د",2,0],["مل بي عن الوردِ واسقني القدحا","فوردُها من خدودكَ افتضحا",14,"ح",2,1],["مِل بِالعِطاشِ الحَائِماتِ فَما لَها","في مَورِدٍ غَيرِ الحِمى مِن مَشرَعِ",15,"ع",1,0],["مَلْبَسٌ للحُلولِ يُخلَعُ للرِح","لةِ عند استماعِ رَجْع الحُداء",16,"ا",2,0],["ملبدةِ الجوانب أمِّ نقع","ترى البيضاء منها مستضامَهْ",17,"م",2,0],["مُلَبدَةً غُبراً جُثوماً كَأَنَّها","أَفانِئُ لَولا رُوسُها وَالأَكارِعُ",18,"ع",1,0],["ملبياً دعوة حظ دعا","إن صدق الحظ ولم يكذب",19,"ب",1,0],["مُلبّون إنْ يُعرَوْا وقد هتف النّدى","بأموالهمْ فمعاطناً ومرابطا",20,"ط",2,0],["مِلْ بِنا يا سعْدُ وانزِلْ بالحجُونْ","هذه الاعْلاَم تبْدو للعُيونْ",21,"ن",1,1],["مُلْبِسي مِنْ هَجْرِهِ ثَوْبَ الضَّنَى","وَمذيب القَلْبَ حُزْناً وعَنَا",22,"ن",2,1],["ملبسٌ لونُهُ الإناءَ شعاعاً","هُوَ من ظاهرِ الإنا بإناء",23,"ا",2,0],["مُلَبين في حَدج وَفي","أَقصى العِراق عَلى نَجيب",24,"ب",1,0],["مل بي إلى أهل الوداد وحيهم","وانزل به فهناك خمر دنان",25,"ن",1,0],["ملبيا داعيا لما اعتصمت بأن","لبيته لم اسم خسفا ولم ارم",26,"م",1,0],["مل بي إلى مجرى النسيم الواني","واجعل مقيلك دوحتي نعمان",27,"ن",1,1],["مُلَبَّسٍ بِحَلّ عَقْدِ السُّكَّرِ","مُمْتَزجٍ بالمسكِ ثمّ العَنْبَرِ",28,"ر",1,0],["مِلْ بلذاتي عن الصحو وَصِلْ","بعرى اللهو غُدُوِّي ورواحي",29,"ح",2,0],["مل بي إلى الشرف الأعلى ونيربها","فلا غِنىً لمشُوفٍ من مغانيها",30,"ي",3,0],["ملبيا لِلَّه حول بيته","يا خير من طاف ولبى وسعى",31,"ع",2,0],["ملبياً جيتكم وسعيي","اليكم كاشافً غطائي",32,"ا",2,0],["ملبِّي علاَّمُ أيا حنَّانُ","لتصلحنْ حالي أيا منَّانُ",33,"ن",1,0],["ملبس الدهر حلة من علاهم","حين اضحوا لردنها كالطراز",34,"ز",1,0],["مِل بالمطي، وشد السير منك إلى","حيث المنارة نطوي سبْلها ذُللا",35,"ل",2,0],["مل بنا يا هديت ننتجع الحق","قَ ولكن من بارق لازوردي",36,"د",2,1]]}