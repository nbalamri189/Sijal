{"poems":[[53,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[93,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[51,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[28,"إذا عرض المنام لنا بسلمى","https://www.aldiwan.net/poem5154.html","الوافر"],[80,"يا ذنوبي ثقلت والله ظهري","https://www.aldiwan.net/poem31425.html","الخفيف"],[44,"ما لي بعادية الأيام من قبل","https://www.aldiwan.net/poem30374.html","البسيط"],[39,"قل في شط نهروان اغتماضي","https://www.aldiwan.net/poem53771.html","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16686","المنسرح"],[136,"بعيد اللقا وافى وأنجز موعدي","https://www.aldiwan.net/poem49122.html","الطويل"],[187,"يا أبا القاسم الأديب ويا من","https://www.aldiwan.net/poem44128.html","الخفيف"],[191,"قد رحل الحى الغداة عمدا","https://www.aldiwan.net/poem1154.html",""],[200,"مل بي عن الورد واسقني القدحا","https://www.aldiwan.net/poem45643.html","المنسرح"],[233,"لو أنكرت لحظات طرفك مصرعي","https://www.aldiwan.net/poem14707.html","الكامل"],[365,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[459,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[471,"فيا ليت أنا قد تعشقت الملا","https://www.aldiwan.net/poem4738.html","الطويل"],[516,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[552,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[560,"مل بنا يا سعد وانزل بالحجون","https://www.aldiwan.net/poem69342.html","الرمل"],[587,"ملبسي من هجره ثوب الضنى","https://www.aldiwan.net/poem17787.html","الرمل"]],"verses":[["مُلَبِّداً يَرمي إِلى","مَكَّةَ حَصباءَ الوَبَر",0,"ر",1,0],["مُلبَساتٌ مِثلَ الرَمادِ مِنَ الكُر","رَةِ مِن خَشيَةِ النَدى وَالطِلالِ",1,"ل",1,0],["ملبسه لا عيب فيه نظيف","وسيره سير أميرٍ شريف",2,"ف",1,0],["ملبسٌ فيه فرحةٌ من غرورٍ","وهْو باقٍ وترحةٌ وهو ناض",3,"ض",1,0],["ملبساتٍ من التهاويلِ زيّاً","يستفزّ القلوبَ قبل التّبال",4,"ل",1,0],["مَلَّ بَنو الإِنسانِ أَطوارَهُم","وَبَرِموا بِالسُقمِ وَالعافِيَه",5,"ه",1,0],["مُلَبَّدَةٌ رُؤوسُهُمُ سِراعاً","إِلى البَيتِ المُحَرَّمِ ذي السُتورِ",6,"ر",1,0],["مِلْ بقلبي إلى صَلاحِ فسادي","منه واجبرْ برأفةٍ منك كسري",7,"ر",2,0],["مُلَبِّياً طالَما لَبّى مُنادِيَهُ","إِلى الوَغى غَيرَ رِعديدٍ وَلا وَكَلِ",8,"ل",1,0],["مُلبَساتِ القَتامِ يُمسي عَلَيها","مِثلُ ساجي دَواجِنِ الحَرّاضِ",9,"ض",1,0],["مَلْبَسُ قَيْلٍ ما خِيطَ مُشْبِهُهُ","لِدارِمٍ قَبْلَنا ولا دَرِم",10,"م",1,0],["ملبيِّ الندا رب الندى معدن الهدى","مذيق العدا طعم الردى والتبدد",11,"د",1,0],["مل بهذا إلى فقيه عليم","بشروط التعليم في ترتيب",12,"ب",1,0],["مُلبَسَةً سَبائِباً وَلِبدا","تَحتَ ظِلالِ رايَةٍ وَبَندا",13,"د",2,0],["مل بي عن الوردِ واسقني القدحا","فوردُها من خدودكَ افتضحا",14,"ح",2,1],["مِل بِالعِطاشِ الحَائِماتِ فَما لَها","في مَورِدٍ غَيرِ الحِمى مِن مَشرَعِ",15,"ع",1,0],["مَلْبَسٌ للحُلولِ يُخلَعُ للرِح","لةِ عند استماعِ رَجْع الحُداء",16,"ا",2,0],["ملبدةِ الجوانب أمِّ نقع","ترى البيضاء منها مستضامَهْ",17,"م",2,0],["مُلَبدَةً غُبراً جُثوماً كَأَنَّها","أَفانِئُ لَولا رُوسُها وَالأَكارِعُ",18,"ع",1,0],["ملبياً دعوة حظ دعا","إن صدق الحظ ولم يكذب",19,"ب",1,0],["مُلبّون إنْ يُعرَوْا وقد هتف النّدى","بأموالهمْ فمعاطناً ومرابطا",20,"ط",2,0],["مِلْ بِنا يا سعْدُ وانزِلْ بالحجُونْ","هذه الاعْلاَم تبْدو للعُيونْ",21,"ن",1,1],["مُلْبِسي مِنْ هَجْرِهِ ثَوْبَ الضَّنَى","وَمذيب القَلْبَ حُزْناً وعَنَا",22,"ن",2,1]]}