47843.html","الكامل"],[549,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[549,"لا تفخرن إلا بنفسك","https://www.aldiwan.net/poem48032.html","مجزوء الكامل"],[549,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[549,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[549,"ما نحن إلا للفناء","https://www.aldiwan.net/poem48110.html","مجزوء الكامل"],[556,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[556,"إياك تشهد غيره ودع العنا","https://www.aldiwan.net/poem33787.html","الكامل"],[556,"عن يمين الحي من إضم","https://www.aldiwan.net/poem34197.html","المديد"],[556,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[556,"أنت في بالك خاطر","https://www.aldiwan.net/poem34552.html","مجزوء الرمل"],[556,"هي هذه الحركات والسكنات","https://www.aldiwan.net/poem34703.html","الكامل"],[560,"القلب بين الصحب أعدل شاهد","https://www.aldiwan.net/poem52952.html","البسيط"],[571,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[573,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[573,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[573,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[573,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"]],"verses":[["وَإِذا بَقيتَ فَقَد شَفَيتَ مِنَ العِدا","قَلبي وَأَعطَيتَ الأَمانَ زَماني",0,"ي",1,0],["وَإِذا بَلَغنَ بِيَ الحُسَينَ فَإِنَّهُ","حَقٌّ لَهُنَّ عَلى المَطايا واجِبُ",1,"ب",1,0],["وَإِذا بُليتَ بِظالِمٍ كُن ظالِم","وَإِذا لَقيتَ ذَوي الجَهالَةِ فَاِجهَلي",2,"ل",2,0],["وإذا بلَغْتَ الى محلِّكَ سالِماً","سلِّمْ لسَعْدِكَ في أزِمّةِ أمْرِهِ",3,"ر",2,0],["وَإِذَا بَقيِتَ فَلَسْتُ أَبْكِي مَنْ مَضى","لِم لاَ وأَنْتَ الأَهْلُ عِنْدِي وَالأَبُ",4,"ب",1,0],["وَإِذا بَكى سَعدٌ بَكَت","لِبُكائِهِ مِنّا القُلوب",5,"ب",1,0],["وَإِذا بِها قَعَدَت تَخي","طُ وَتَرتَضي وَخزَ الإِبَر",6,"ر",1,0],["وَإِذا بِهِ لِلناظِرينَ زُمُرُّدٌ","يَشفيكَ أَخضَرُهُ مِنَ الأَتراحِ",7,"ح",1,0],["وَإِذا بِهِ مِسكٌ تَشُقُّ سَوادَهُ","شَقَّ الأَديمِ مَحارِثُ الفَلّاحِ",7,"ح",1,0],["وَإِذا بِجَيشٍ مُقبِلٍ","وَالخَيلُ مُطلَقَةُ الأَعِنَّه",8,"ن",2,0],["وَإِذا بِأَصواتٍ تَصيحُ أَلا اِفتَحوا","دَقّاتُ مَرضى مُدلِجينَ عِجالِ",9,"ل",1,0],["وَإِذا بِأَيدٍ طاهِراتٍ عُوِّدَت","صُنعَ الجَميلِ تَطَوَّعَت في الحالِ",9,"ل",1,0],["وَإذَا بَرَرْتَ بِأُمَّةٍ مَغْلُولَةٍ","فَالحَزْمُ أَنْ تُفْتَكَّ مِنْ أَغْلالِهَا",10,"ل",3,0],["وَإذَا بَنَتْ لَكَ مَضْجَعاً فِي صَدْرِهَا","فَذَخِيرَةً تُهْدَى إِلَى أَجْيَالِهَا",10,"ل",3,0],["وإذا بدت تهفو القلوب صبابةً","فيها وتركع دونها العينان",11,"ن",1,0],["وَإِذا بَنو أَسَدٍ عَلَيَّ تَحَدَّبوا","نَصَبَت بَنو أَسَدٍ لِمَن راداني",12,"ن",2,0],["وَإِذا بَدا عَلَمُ الفَلاةِ طَلَبنَهُ","عَمِقُ الفِجاجِ مُنَطَّقٌ بِعَماءِ",13,"ا",2,0],["وَإِذا بَطِنتَ فَأَنتَ يا اِبنَ مُجاشِعٍ","عِندَ الهَوانِ جُنادِفٌ نَثّارُ",14,"ر",1,0],["وَإِذا بَنو حِسلٍ أَجاروا ذِمَّةً","أَوفَوا وَأَدَّوا جارَهُم بِسَلامِ",15,"م",1,0],["وإذا بغى باغٍ عليك بجهله","فاقتلْه بالمعروف لا بالمنكرِ",16,"ر",1,1],["وإذا بحثتُ لأمه عن سوأةٍ","سَوْآءَ أحسبُ أنها لم تُشهَر",17,"ر",1,0],["وإذا باشروا الثرى","بالخدود الضوارع",18,"ع",1,0],["وإذا بنو الموت استطالهمُ","وهجٌ تغشى الموت أينَعه",19,"ع",2,0],["وإذا بدا ملأ العيون جلالةً","فتَظلُّ وهي كليلةُ اللحظان",20,"ن",1,0],["وَإِذا بِصَوتٍ كَالهَريرِ يَطُنُّ في","أُذُني وَأَنيابٌ تَصُرُّ وَرائي",21,"ا",2,0],["وَإِذا بَصَرتَ بِهِ بَصَرتَ بِأَشمَطٍ","وَإِذا تُحَدِّثُهُ تَكَشَّفَ عَن صَبي",22,"ب",2,0],["وَإِذا بِنا نَلقى كَنيسَتَنا","بِالوافِدينَ تَموجُ كَالبَحرِ",23,"ر",1,0],["وَإِذا بِها وَإِذا الفَتى هِنري","في حَلَّةٍ بَيضاءَ كَالفَجرِ",23,"ر",1,0],["وَإِذا بِهِ أَلقى عَباءَتَهُ","بَرَحَ الخَفاءُ بِها عَنِ الجَهرِ",24,"ر",1,0],["وَإِذا بِالبَدرِ قَد مَزَّقَ عَن","وَجهِهِ بُرقَعَهُ ثُمَّ اِنبَرى",25,"ر",2,0],["وَإِذا بِالأَوَّلِ يَقتَرِبُ","مِنّي كَالطائِرِ في الوَثبِ",26,"ب",1,0],["وَإِذا بِالطِفلِ يُخاطِبُني","بِكَلامٍ لا يَتَكَلَّفُهُ",26,"ه",1,0],["وَإِذا بِمَخمورٍ يَتيهِ مُعَربِداً","خَبَلٌ بِهِ ما ذاكَ تيهُ دَلالِ",27,"ل",1,0],["وَإِذا بَنى رَجُلٌ قَصراً وَزَخرَفَهُ","سُقنا إِلَيهِ التَهاني وَاِمتَدَحناهُ",28,"ا",2,0],["وَإِذا بُليتَ بِجاهِلٍ يَستامُها","فَقُلِ المَنِيَّةُ دونَ ذَلِكَ مَركَبُ",29,"ب",1,0],["وإذا بالحَيَاةِ في ملعَبِ الدَّهْرِ","تَدوسُ الرُّؤُوسَ بالأَقْدامِ",30,"م",1,0],["وإذا بمأمور البريد يقل في ال","أَيدي كتاباً لم يكن يتوقع",31,"ع",1,0],["وإذا بنيت الملك فآبن حقيقة","لا تبن أوهاما ولا أحلاما",32,"م",2,0],["وَإِذا بَنَيتَ فَخَيرُ زَوجٍ عِشرَةً","وَإِذا اِبتَنَيتَ فَدونَكَ الآباءُ",33,"ا",2,0],["وَإِذا بِالشَطِّ مِن شِقوَتِهِ","صائِحٌ صاحَ بِهِ نِلتَ الأَمان",34,"ن",1,0],["وَإِذا بَرَزنَ مِنَ الخُدورِ سَفَرنَ عَن","هَمَّيكَ مِن وَردٍ وَمِن تُفّاحِ",35,"ح",1,0],["وَإِذا بَدَت شَمسُ النَهارِ مُضيأَةً","فَلَنا بِها وَبِحُسنِها شَمسانِ",36,"ن",1,0],["وَإِذا بَذَختُ وَرايَتي يَمشي بِها","سُفيانُ أَو عُدسُ الفَعالِ وَجَندَلُ",37,"ل",1,0],["وَإِذا بَكَيتَ عَلى أُمامَةَ فَاِستَمِع","قَولاً يَعُمُّ وَتارَةً يُتَنَخَّلُ",38,"ل",1,0],["وإذا بحارُ المكرُماتِ تدفَّقَت","فجميعُها تمتارُ من أندائِه",39,"ا",3,0],["وَإِذا بَرَزتَ بِهِ بَرَزتَ إِلى","ضافي الخَليقَةِ طَيِّبِ الخُبرِ",40,"ر",1,0],["وِإِذا بُليتَ بِنَكبَةٍ فَاِصبِر لَها","مَن ذا رَأَيتَ مُسلِّماً لا يُنكَبُ",41,"ب",1,0],["وَإِذا بَحَثتُ عَنِ التَقِيِّ وَجَدتُهُ","رَجُلاً يُصَدِّقُ قَولَهُ بِفِعالِ",42,"ل",1,0],["وَإِذا بَدا سِرُّ اللَبيبِ فَإِنَّهُ","لَم يَبدُ إِلّا وَالفَتى مَغلوبُ",43,"ب",1,0],["وَإِذا بَلَغتَ مِنَ المُدامَةِ غايَةً","فَاِقلِل لِتُذكي الفَهمَ بَعدَ خُمودِهِ",44,"د",2,0],["وإذا بي أرى لعينيك دنيا","خير ما فكرت به عينان",45,"ن",1,0],["وإذا بالطيور قد","دخل الموت وكرهُم",46,"م",1,0],["وإذا بي غارقٌ في محنَتي","وبلائي أقطعُ الأيامَ وَحدِي",47,"ي",1,0],["وإذا بكيتُ فقد بكيت مخافة","من أن يكون غرامُنا أحلاما",48,"م",2,0],["وإِذا بَنو الآمالِ أَخْسرَ وُسْعُهُمْ","أَضحى لهُمْ في القَصدِ مِنهُ جناحُ",49,"ح",1,0],["وإذا بسمْتِ عن ثغرِكِ المنْ","ظومِ أغرى بلفظه المنثورِ",50,"ر",1,0],["وَإِذا بِالقُلوب تَهفو عَلى الن