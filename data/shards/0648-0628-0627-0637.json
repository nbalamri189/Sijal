{"poems":[[52,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[147,"دل على المجد من إليه سعى","https://www.aldiwan.net/poem11778.html","المنسرح"],[351,"ألا يا صاح للعجب","https://www.aldiwan.net/poem24113.html","مجزوء الوافر"],[354,"بداية وجدي في هواكم نهاية","https://www.aldiwan.net/poem15594.html","الطويل"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[398,"أبا العلا يا هلال الهزل والجد","https://www.aldiwan.net/poem53576.html","البسيط"],[563,"قد جاء ربنا لنا","https://www.aldiwan.net/poem33876.html","مجزوء الرجز"],[563,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[563,"دوائر أوهام بها شغل الفكر","https://www.aldiwan.net/poem34532.html","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117603","الوافر"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82532","المتقارب"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105859","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104732","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109291","الكامل"],[2376,"","https://poetry.dctabudhabi.ae/diwan/poem/115218","الطويل"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68193","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201704","الوافر"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71297","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89424","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89041","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216461","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135496","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102735","الطويل"],[4611,"","https://poetry.dctabudhabi.ae/diwan/poem/124100","الخفيف"],[5786,"إن كنتَ لي صاحباً قِف لي بهبود","https://www.poetsgate.com/ViewPoem.aspx?id=50651",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5956,"إني لَمُختصّ بكم يا أشهمُ","https://www.poetsgate.com/ViewPoem.aspx?id=194262",""]],"verses":[["وَباطَ اِبنُ رَوحٍ لِلجَماعَةِ إِنَّهُ","زَأَرنا إِلَيهِ فَاِقشَعَرَّت ذَوائِبُه",0,"ب",2,0],["وَباطِلٍ ظَلَّ في زَمانِكَ مَد","حوضاً وَحَقٍّ بِحُكمِكَ اِرتُجِعا",1,"ع",2,0],["وَباطِيَةٍ مُكَلَّلَةٍ","عَلَيها سادَةُ العَرَبِ",2,"ب",1,0],["وَباطِنُ ما عِندَ المُحِبّينَ فيكُمُ","مِنَ الحُسنِ وَالإِحسانِ ظاهِرُ ما عِندي",3,"د",2,0],["وَباطِنُ الصَليبِ وَالمُلقى عَلى","ظاهِرِهِ بِالصلبِ لَمّا أَن كَفَر",4,"ر",1,0],["وَباطِنُ القُرآنِ وَالفُرقانِ وَالتَن","زيلُ وَالتَأويلُ سِرَّ مُستَسَر",4,"ر",1,0],["وَباطِنُ الجِسمِ غَرٌّ مِثل ظاهِرِهِ","وَأَنتَ تعلمُ مِما قُلتُه قَصدي",5,"ي",1,0],["وباطل أنتم كما","قال تعالى والسلام",6,"م",1,0],["وبأطيارٍ ونملٍ","وبخيل وبغال",7,"ل",1,0],["وباطنها الباقي الذي هو واحد","هدىً حيث لا زيد هناك ولا عمرو",8,"ر",2,0],["وَباطِنُ الهَمِّ سعارٌ يَسْهَمُهْ","أَتَاكَ لَمْ يُخْطِئ بِهِ تَرَسُّمُهْ",9,"م",2,0],["وباطيةٍ إذا ملئت مُداماً","وكان بها لزورقها مجالُ",10,"ل",1,1],["وباطل إعماله لما أتى","من كلمتين في القوافي مثبتا",11,"ت",2,0],["وَباطِنُها لِلنَّدى","وَظاهِرُها لِلقُبَل",12,"ل",1,0],["وباطنها من باطن الأُذن خَلقُهُ","غُصُونا اذا شبَّهتَها وتكسُّرا",13,"ر",2,0],["وَباطِنُ عَرشِ اللهِ أَنتَ أضَأتَهُ","لِحافِّينَ حَولَ العَرشِ فالكُلُّ خاضِعُ",14,"ع",1,0],["وبأطلس الشفق انتقبن مطرزا","شهبا ترى من حاك ذا المنديلا",15,"ل",2,0],["وباطيةٍ كانت له خدن زنيَةٍ","يعاقِرها والليل معتكر الستر",16,"ر",1,0],["وباطن هو في حال الظهور كما","عرفت في الذهب المصنوع والخشب",17,"ب",1,0],["وباطنُ عقلنا منه انبثاق","فليس عليه من سرّ يفوت",18,"ت",1,0],["وَبَاطِنٌ فِي شُهُودِ العَيْنِ وَاحِدُهُ","وَظَاهِرٌ لاِمْتَيِازَاتٍ بأَسْمَاءِ",19,"ا",2,0],["وباطن حوسة خدٌّ وساق","عراض جبهة كفل مليّ",20,"ي",1,0],["وباطنك الحسنى وظاهرك الندى","فللَه ما تخفي وللمجد ما تبدي",21,"د",2,0],["وباطنه في مواعيده","كصفحة عنوانه الظاهر",22,"ر",1,0],["وباطنية سوى أولها","وغيره عقلية بعقلها",23,"ه",2,0],["وباطنهم جهم الوداد وقلب","واين الذي يصفيك منهم توددا",24,"د",2,0],["وبأطلال حو لبلشان أقوت","من سُلَيمى ومية والرباب",25,"ب",1,0],["وباطنٌ ظاهرٌ إن غاب عن بصري","فإن معناهُ باقٍ غير مفقود",26,"د",1,0],["وباطن أسرار الكتوب جميعها","حقيقتي المكتوم عن بشريّة",27,"ه",1,0],["وباطن الله غيب ليس يدركه","خلق ولا يتمناه إذا أمنا",28,"ن",2,0],["وبأطيب الإطعام تملأ منزلي","حتى سلاني المنتدَى والمطعَمُ",29,"م",1,0]]}