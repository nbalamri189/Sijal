{"poems":[[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141011",""],[287,"وهو الذي لم يزل تهمي أنامله","https://www.aldiwan.net/poem32887.html","البسيط"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138602",""],[5397,"رميت بقوس الحزم عن قوس حاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157922",""]],"verses":[["لها ظفرٌ إن كلّ ظفرٌ أعدّه","ونابٌ إذا لم يبق في الفمّ ناب",0,"ب",1,0],["لَهُ أَظافِرُ حُجنٌ قد بَرَزنَ كَأَن","صافِ الأَهِلَّةِ مَن جِلبابِ مُختَضِبِ",1,"ب",1,0],["لَها ظَليل ظلال فوق هامته","تفيه حر وَطيس للهجير حَمي",2,"م",2,0],["له اظهروا وداً وأن اغتصابه","مقام رسول الله لم يتحملوا",3,"ل",3,0],["له أظلمت كل المشارق مطلعا","وأجرت غروب الدمع عين المغارب",4,"ب",1,0]]}