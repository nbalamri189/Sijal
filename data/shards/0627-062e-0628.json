{"poems":[[55,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[57,"يا موقد النار بالهندي والغار","https://www.aldiwan.net/poem26369.html","البسيط"],[36,"ألبنى لقد جلت عليك مصيبتي","https://www.aldiwan.net/poem4905.html","الطويل"],[79,"لا تعجبن لطالب نال العلا","https://www.aldiwan.net/poem36129.html","الخفيف"],[95,"ألشرق طال سباته الروحاني","https://www.aldiwan.net/poem11226.html","الكامل"],[43,"يا روضة الوضاح قد","https://www.aldiwan.net/poem42348.html","مجزوء الكامل"],[90,"أن بليلا من نسيم السحر","https://www.aldiwan.net/poem44414.html","الرجز"],[4,"بلينا وما تبلى النجوم الطوالع","https://www.aldiwan.net/poem21175.html","الطويل"],[39,"أخبرت عن فعاله الأرض","https://www.aldiwan.net/poem7071.html","الخفيف"],[53,"أعزز علي أبا إسحاق أن ذهبت","https://www.aldiwan.net/poem64667.html","البسيط"],[91,"هل لمن يرقدون في الالحاد","https://www.aldiwan.net/poem44644.html","الخفيف"],[91,"اخبث الناس صديق","https://www.aldiwan.net/poem44877.html","مجزوء الرمل"],[47,"هجاني النغيل وما خلتني","https://www.aldiwan.net/poem65634.html","المتقارب"],[2,"أخبرت أن أبا الحويرث قد","https://www.aldiwan.net/poem25006.html","الكامل"],[68,"أخبرت شبهة النعاس بعينيك","https://www.aldiwan.net/poem39043.html","الخفيف"],[68,"سلبتنا فواتك اللفتات","https://www.aldiwan.net/poem40646.html","الخفيف"],[33,"هل عرفت اليوم من شن","https://www.aldiwan.net/poem41331.html","مجزوء الرمل"],[41,"أخبرت ضبة تهجوني لأهجوها","https://www.aldiwan.net/poem53786.html","البسيط"],[42,"يا خل ما كنا نخافكم","https://www.aldiwan.net/poem42285.html","أحذ الكامل"],[69,"أخبروني غضبة وصلفا","https://www.aldiwan.net/poem18076.html","الرمل"],[48,"أخبرت عن كتبك أعجوبة","https://www.aldiwan.net/poem22372.html","السريع"],[48,"أخبت ركابي أم أتيح لها خبت","https://www.aldiwan.net/poem22380.html","الطويل"],[48,"يا شهب إنك في السماء قديمة","https://www.aldiwan.net/poem22712.html","الكامل"],[48,"قد آن مني ترحال ولم أفق","https://www.aldiwan.net/poem23051.html","البسيط"],[1,"قفي ودعينا اليوم يا ابنة مالك","https://www.aldiwan.net/poem34008.html","الطويل"],[8,"هل بالديار الغداة من صمم","https://www.aldiwan.net/poem21838.html","المنسرح"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85389","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62211","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[101,"قطرة الندى","https://www.poetsgate.com/ViewPoem.aspx?id=570",""],[102,"ساعة نقاش مع طالبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67693&r=&rc=180",""],[146,"النجاء النجاء من أرض نجد","https://www.aldiwan.net/poem58420.html","البسيط"],[147,"طاول بقدرك من علا مقداره","https://www.aldiwan.net/poem11767.html","الكامل"],[164,"اضرب بسيف العزم أَعناق الكرى","https://www.aldiwan.net/poem58719.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[199,"منع النوم طارقات الهموم","https://www.aldiwan.net/poem54415.html","الخفيف"],[215,"منازل كانت جلوة العين والحشا","https://www.aldiwan.net/poem46626.html","الطويل"],[215,"مات رشدي مات آها ثم آه","https://www.aldiwan.net/poem46636.html","الرمل"],[275,"أتحب مسئلة بغير جواب","https://www.aldiwan.net/poem52114.html","الكامل"],[286,"فيك عذولي عذرا","https://www.aldiwan.net/poem32763.html","مجزوء الرجز"],[289,"زفت معارف تونس","https://www.aldiwan.net/poem39396.html","مجزوء الكامل"],[304,"فمثلك ألوى بالفؤاد وزار بالعداد","https://www.aldiwan.net/poem45486.html","الطويل"],[342,"قائد الغفلة الأمل","https://www.aldiwan.net/poem68629.html","مجزوء الخفيف"],[369,"أخبر المخبر عنكم أنكم","https://www.aldiwan.net/poem44363.html","الرمل"],[381,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[397,"عندي سر لابن متوية","https://www.aldiwan.net/poem53513.html","السريع"],[407,"وافى نظامك وهو خير نظام","https://www.aldiwan.net/poem33424.html","الكامل"],[407,"أيها الأعلام من ساداتنا","https://www.aldiwan.net/poem33598.html","الرمل"],[407,"أخبرونا تفضلا ما الذي كان","https://www.aldiwan.net/poem33912.html","الخفيف"],[409,"بنفسي أخ نفسه أمة","https://www.aldiwan.net/poem49523.html","المتقارب"],[409,"شيخ لنا يقطعنا عرضه","https://www.aldiwan.net/poem49774.html","السريع"],[420,"هاتها حمراء تحكي العندما","https://www.aldiwan.net/poem54068.html","الرمل"],[420,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[436,"يا بن عدلان يا أخس الرجال","https://www.aldiwan.net/poem12457.html","الخفيف"],[461,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[467,"طرقت ريح الصبا ميثاء وهنا","https://www.aldiwan.net/poem3594.html","عموديه"],[503,"من بات ملتحفا في ذيل منقبتي","https://www.aldiwan.net/poem38000.html","البسيط"],[503,"ماذا يقول عليل شفه وله","https://www.aldiwan.net/poem38085.html","البسيط"],[517,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[518,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[556,"قل لمن تاه إذ بنا عز جهلا","https://www.aldiwan.net/poem68326.html","الخفيف"],[561,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"أخبروني عن مرهف القد مطبو","https://www.aldiwan.net/poem2698.html","الخفيف"],[591,"","https://poetry.dctabudhabi.ae/diwan/poem/28420","الطويل"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/79657","الكامل"],[907,"","https://poetry.dctabudhabi.ae/diwan/poem/20684","البسيط"],[967,"","https://poetry.dctabudhabi.ae/diwan/poem/29436","الطويل"]],"verses":[["أَخبَرَ خافي الشَخصِ إِل","لا بِالمَقامِ المُشتَهَر",0,"ر",1,0],["أُخَبِّرُ الناسَ أَنّي قَد سَلَوتُكُمُ","وَاللَهُ يَعلَمُ ما مَكنونُ إِضمارِ",1,"ر",1,0],["أَخُبِّرتِ أَنّي فيكِ مَيِّتُ حَسرَتي","فَما فاضَ مِن عَينَيكِ لِلوَجدُ مَدمَعُ",2,"ع",1,0],["أَخْبِرِ الْخَابِطَ الْمُدَوِّمَ تَشْكُو","أُظْهُرُ الْعِيسِ حَمْلَهُ وَفِصَالَهْ",3,"ل",2,0],["أَخْبَارُهُمْ آدَابُهُمْ أَخْلاقُهُمْ","صَوَّرْتَهَا فِي أَصْدَقِ الأَلْوَانِ",4,"ن",1,0],["أَخبره إِمَّا جِئتَهُ","أَنَّ الفؤادَ بهِ يُجَن",5,"ن",1,0],["أخبر ريّاه أصحّ الخبر","عمّا جرى في الروض للبلبل",6,"ل",1,0],["أُخَبِّرُ أَخبارَ القُرونِ الَّتي مَضَت","أَدِبُّ كَأَنّي كُلَّما قُمتُ راكِعُ",7,"ع",1,0],["أخبرت عن فعاله الأرض","واستنطق منها اليباب والمعمورا",8,"ر",2,1],["أخٍ بل ابنٍ وإن سمّيته ابن أخٍ","معطىً من الحظ فضلاً غير مَخْسُوس",9,"س",1,0],["اخبريني يا نفس من انا ماذا","انت مني ما مبدئ ما معادي",10,"د",2,0],["اخبث الناس صديق","عن نفاق يتحرك",11,"ك",1,1],["أُخَبِّرُ أَنَّكَ مُستَوجِبٌ","لِلُطفِ المَحَلَّةِ وَالمَنزِلَه",12,"ل",2,0],["أُخبِرتُ أَنَّ أَبا الحُوَيرِثِ قَد","خَطَّ الصَحيفَةَ أَيتَ لِلحِلمِ",13,"م",1,1],["أَخبَرَت شُبهَةُ النُعاسِ بِعَينَي","كَ صَباحاً عَنِ المَساءِ السَعيدِ",14,"د",1,1],["أَخبَرَتنا عُذوبَةُ اللَفظِ مِنها","أَنَّ عَينَ الحَياةِ في الظُلُماتِ",15,"ت",1,0],["أَخبِريهِ بِالَّذي أَل","قى فَإِن كانَ مُقيما",16,"م",2,0],["أُخبِرتُ ضَبَّةَ تَهجوني لِأَهجوها","وَلَو حُدوا كَحَداءِ القَينِ ما عادوا",17,"د",3,1],["أُخبِرتُ أَنَّكِ قُلتِ نَهجُرُهُ","لا تَفعَلِنَّ فَدَتكُمُ نَفسي",18,"س",2,0],["أخْبَرُوني غَضْبَةً وصَلفَا","أنكم رُحْتُمُ إليهِ مَرصَفا",19,"ف",2,1],["أَخبَرتَ عَن كُتبِكَ أُعجوبَةً","وَرُبَّ مَينٍ ضُمِّنَتهُ الكُتُب",20,"ب",1,1],["أَخَبَّت رِكابي أَم أُتيحَ لَها خَبتُ","عَميمُ رِياضٍ ما يَزالُ بِهِ نَبتُ",21,"ت",1,1],["أَخبَرتِ عَن مَوتٍ يَكونُ مُنَجِّماً","أَفَتُخبِرينَ بِحادِثِ الإِنشارِ",22,"ر",1,0],["أَخبَرَتني بِأَحاديثٍ مُناقَضَةٍ","فَرابَني مِنكَ قَولٌ غَيرُ مُتَّفَقِ",23,"ق",1,0],["أُخَبِّركِ أَنَّ الحَيَّ فَرَّقَ بَينَهُم","نَوى غُربَةٍ ضَرّارَةٍ لي كَذَلِكِ",24,"ك",1,0],["أُخبِرُكَ السِرَّ لا أُخَبِّرُهُ","الناسَ وَأُصفيكَ دُونَ ذِي الرَحِمِ",25,"م",1,0],["أَخبرته يا أم في كتبي له","أني مرضت فَلَم يوافِ جواب",26,"ب",1,0],["أَخبروا أنهن مرتبطات","بِذَكاء من جذبها برشاء",27,"ا",2,0],["أَخَبَّا وقَدْ كَانَ المَزَادُ سِوَاهُمَا","عَلَى شُعَبٍ مِنْ صَادِرٍ قَدْ تَبَدَّدَا",28,"د",2,0],["أَخْبِرْهُ أَنِّي بَعْدَهُ في مَعْشَرٍ","يَسْتَجْلِبُونَ صَلاحَهُمْ بِفَسَادِي",29,"د",2,0],["أَخْبِثْ بِمَا أَخْفَوْا وَظَا","هِرُ قَصْدِهِمْ عَطْفٌ وَحُوبُ",30,"ب",1,0],["أخبرتهم نفحةٌ منكِ سَرَتْ","أن روضا راح في النادي وجاء",31,"ا",2,0],["أخبريني من انت ان شعوري","كشعور الذي يطارد ارنب",32,"ب",1,0],["(أخبار اليوم نفوا ، هجموا","كسروا إحدى كتفي لبنان)",33,"ن",1,0],["أخبرُ الناسَ تَقْلُهمُ أو تصِلْهم","هل يحاز الدينار إلا بنقدِ",34,"د",1,0],["أَخبارُ مَجدٍ كادَ يَحفَظُها الدُجى","مِمّا يُكَرِّرُ ذِكرَها سُمّارُهُ",35,"ر",2,0],["أخبرت عنه ولم أقل في وصفه","زوراً ولم أخلق حديثاً مفترى",36,"ر",2,0],["أَخبَروهم بصدقهِ فاِستَمرّوا","وَالعَمى لا تفيدهُ الأضواءُ",37,"ا",2,0],["أَخبِرِ النَفسَ إِنَّما الناسُ كَالعي","دانِ بَينَ نابِتٍ وَهَشيمِ",38,"م",1,0],["أخبر الوحي بأني قد أعود","للندى المقطور من روح الوجود",39,"د",1,0],["أخبروني أن رشدي لن يعود","جثم الصخر عليه والحديد",40,"د",1,0],["اخباره مَع سائر الاحبار وَالرُهبان","وَالكهان وَالحساب",41,"ب",1,0],["أَخبارُهُم مُجَمِّلا","تٌ في الطُروسِ السِيَرا",42,"ر",2,0],["أخبارها الحق الصر","يح ونصحها ياللعجب",43,"ب",1,0],["أُخَبِّرُ مَن لا قَيتُ أَنّي مُبَصِّرٌ","وَكائِن تَرى مِثلي مِنَ الناسِ بَصَّرا",44,"ر",2,0],["أَخبَرَ الشَيبُ عَنك أَن","نَك في آخِرِ الأَجَل",45,"ل",1,0],["أَخبَرَ المُخبِرُ عنكم أنكم","يومَ فَيفِ الريحِ أُبتُم بالفَلَج",46,"ج",1,1],["أخبار موتك لو رأى آثارها","قلبٌ كفورٌ لانثنى يتوجَّع",47,"ع",1,0],["أَخبرني بَعضيَ عَن بَعضِهِ","بِأَنَّهُ أَوسَعُ مَن يَمشي",48,"ي",1,0],["أخبارها يشتاقها أحبارنا","إذ خبرت عن كل خبر سامي",49,"م",2,0],["أخبرونا ما الذي تدعونه","مذهباً في القول أو في العمل",50,"ل",1,0],["أخبرونا تفضلا ما الذي كا","ن وماذا جرت به الأقدار",51,"ر",1,1],["أخٌ بابُ إحسانِهِ مُطَلقٌ","وبابُ إساءتِهِ مُغلَقُ",52,"ق",1,0],["أخبَتُ خَلقِ اللهِ مَنْ خالَهُ","حُرّاً ومَنْ شامَ صدىً خالَهُ",53,"ل",2,0],["أخْبَرت عن نار كسرى ما رَوَتْ","من أعاصير الأُلى ما قدما",54,"م",2,0],["أخبرني هذا الدنا عن القضا","بفطنة تدني إلينا ما نأى",55,"ا",1,0],["أخبَرونا بأنّ عندكَ بنتاً","وهْي تُنمى الى ثلاثِ رجالِ",56,"ل",1,0],["أَخُبُّ حِذارَ الشامتينَ تجلُّداً","بهنّ وما تحتَ الخَبَالِ نَجيبُ",57,"ب",1,0],["أخبرت عنك خيالاتُ الكرى","ولأمرٍ هيَ لا تخبر عنّا",58,"ن",2,0],["أَخبارُهُمْ وعُلاهُمْ دونَ مَخْبَرِهِمْ","وكم وكم مَخْبَرٍ من دونِهِ الخَبَرُ",59,"ر",1,0],["أخبرتُهُمْ بشُؤُنِ الغيبِ فانْذَهلوا","وهزَّهُمْ لمَعالي حضرَتي رَهَبُ",60,"ب",1,0],["أخبرَتْنا حَلاوةُ القُربِ منكمْ","أنّ هذا البِعادَ مُرُّ المَذاقِ",61,"ق",1,0],["أخبرتمونا عنه قبل مجيئه","أخبار صدق صح منه بيانها",62,"ن",3,0],["أَخبِرونا مَنِ الأَعَزُّ أَأَلمَن","صورُ حَتّى اِعتلى أَم الأَنصارُ",63,"ر",1,0],["أخبار أحبار عذالي مصحفة","وكل منهم عن التحريف كل فم",64,"م",1,0],["أخبرنا بذاك من دعانا","إليه عمن قد رأى عيانا",65,"ن",2,0],["أَخبروني عَنْ مُرْهَفِ الْقَدِّ مَطْبُو","عٍ حَبِيبٍ إِلى القُلُوبِ مكرَّمْ",66,"م",1,1],["أُخَبِّرُ أَخبارَ القُرونِ الَّتي مَضَت","وَلا بُدَّ يَوماً أَن يُطارَ بِمَصرَعي",67,"ع",2,0],["أُخبرنَ بالجولان روضاً ممْرِعاً","فكأنَّ حارِثَهُ لهنَّ لِواءُ",68,"ا",2,0],["أَخبارَ أَروعَ مَيمونٍ نَقيبَتُهُ","مُستَعمَلٍ في سَبيلِ اللَهِ مِغوارِ",69,"ر",1,0],["أُخبِّرُ من لاقيتُ أَن قد وفيتُمُ","ولو شِئتُ قالَ المنبِئونَ أساؤوا",70,"ا",1,0]]}