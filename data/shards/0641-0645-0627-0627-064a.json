{"poems":[[32,"تصابيت في أطلال مية بعدما","https://www.aldiwan.net/poem29578.html","الطويل"],[376,"وكنت أرى تصاريف الليالي","https://www.aldiwan.net/poem57334.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122798","البسيط"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11859","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53117","الهزج"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100815","المتقارب"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36761","السريع"],[5956,"النساء ضحايا أحوالنا","https://www.poetsgate.com/ViewPoem.aspx?id=181848",""],[5956,"أيا بحر","https://www.poetsgate.com/ViewPoem.aspx?id=183215",""],[5956,"بعد الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=194844",""]],"verses":[["فَما أَيأَسَتني النَفسُ حَتّى رَأَيتُها","بِحَومانَةِ الزُرقِ اِحزَأَلَّت خُدورُها",0,"ر",3,0],["فما أيقظتَ ذا الوَسنان إلا","إلى مُتَيقِّظٍ رَحب الذراعِ",1,"ع",1,0],["فَما إياسٌ وَأوسٌ وَابنُ ساعِدَةٍ","وَأكتمٌ وأُوَيسُ الفَضلِ في قَرَنِ",2,"ن",1,0],["فَما آيبٌ لِلهَمِّ عَنّي بِرائِحٍ","وَلا رائِحٌ لِلعَيشِ عَنّي بِآيِبِ",3,"ب",1,0],["فما أيمنه فَألاً","يُنَاجِينِي به فكري",4,"ر",2,0],["فما ايد اللَه من مالك","بغير العدالة في العالمين",5,"ن",1,0],["فَما إياسٌ بِذكيٍّ إِذا","عُدَّت قَضاياكَ وَرَبِّ النَجاح",6,"ح",1,0],["فما أيُّ اختلاف غيرَ وهْمٍ","لدينا أنهنَّ لظى المواقدْ",7,"د",1,0],["‏ ‏فما أي عيب سوى فيه حُسْنٌ","‏ ‏ ولا أي حُسْنٍ يَظَلُّ أنيقا",8,"ق",2,0],["فما أيّ شبر ببيتي يغنّي","ولكنْ ينوح عليهم حسيرا",9,"ر",2,0]]}