ps://www.aldiwan.net/poem3220.html","عموديه"],[464,"يا من بدا ورنا فلاح","https://www.aldiwan.net/poem3458.html","عموديه"],[464,"سل بين بانات الحمى وقدوده","https://www.aldiwan.net/poem3490.html","عموديه"],[468,"حلاوة الحمد ليس يعرفها","https://www.aldiwan.net/poem60240.html","المنسرح"],[477,"أطل الوقوف على رسوم الدار","https://www.aldiwan.net/poem15238.html","الطويل"],[477,"ربع وقفت عليه بعد أهليه","https://www.aldiwan.net/poem15251.html","البسيط"],[477,"ما الدمع بعد نوى الأحبة عار","https://www.aldiwan.net/poem15339.html","الكامل"],[493,"وإن رأى المتناهى من سيادته","https://www.aldiwan.net/poem67397.html","البسيط"],[504,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[514,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[515,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[529,"يا بن البهاليل والأطواد من مضر","https://www.aldiwan.net/poem37166.html","البسيط"],[558,"وجدت كنزا هنا هو البركه","https://www.aldiwan.net/poem33508.html","المنسرح"],[558,"أصبحت أنا على مرادك","https://www.aldiwan.net/poem34271.html","مجزوء الدوبيت"],[558,"كن عارفا بنعمة الله وكن","https://www.aldiwan.net/poem34564.html","الرجز"],[559,"لا تلتفت بالله يا ناظري","https://www.aldiwan.net/poem69356.html","السريع"]],"verses":[["فالشِّعْرُ ما لَمْ يُقْتَسَرْ أبيُّهُ","وذادَ عنهُ الطّبْعُ وحْشيَّ اللُّغى",0,"ا",1,0],["فَالشُّكْر يُقْتَادُ الْمَزِيدَ رَكَائِباً","تَنْتَابُ بَابَكَ مِنْهُ فِي أَرْسَانِ",1,"ن",1,0],["فَالشَّمْلُ مُجْتَمِعٌ كَأَحْسَنِ حَالَةٍ","تَعْتَادُهَا وَنَوالُ رَبِّكَ يَشْمُلُ",2,"ل",1,0],["فَالشُّجَاعُ الَّذِي مضَى","قَبْلَنَا يحْمِلُ اللِّوَا",3,"و",2,0],["فالشعب وفق في هواه","مسودوه أو سواده",4,"د",2,0],["فَالشَّرْقُ في شَرَقٍ مِنَ الدَّمْعِ الذَِّي","أجْرَى الْعُيُونَ وَفَاضَ بِالْغُدْرَانِ",5,"ن",1,0],["فالشمس تأخذ من جبينك نورَها","والبشر منك بوجهها يتهلَّلُ",6,"ل",1,0],["فالشمسُ تأخذ عن جبينك نورَها","والروض ينفح عن كريم خِلالِ",7,"ل",1,0],["فالشاعر المصري فيها فاضل","وسواه مفضول وأن يك نابها",8,"ب",3,0],["فالشرق ليس بناهض إلا إذا","أدنى النساء من الرجال وقَرّبا",9,"ب",2,0],["فالشعر بعدهما استطال بكاؤه","وتموّجت بالحزن كل بحوره",10,"ر",2,0],["فالشعر قد دكّت جبال فنونه","إذ موت شوقي كان نفخة صوره",10,"ر",2,0],["فالشعر ليس يفي بذا ولو أنه","شعر الرضّي الفحل أو مهيار",11,"ر",1,0],["فالشعر قد قرّط الأسماع مندفقاً","والدمع قد قرّح الأجفان منحدرا",12,"ر",2,0],["فالشعر من هذه الأكباد بلّ صدى","والدمع من هذه الأوطان بلّ ثرى",12,"ر",2,0],["فالشعب منهم مريد ما أردت له","وليس يقبل عذراً ممّن اعتذرا",12,"ر",2,0],["فَالشَمسُ كاسِفَةٌ لَيسَت بِطالِعَةٍ","تَبكي عَلَيكَ نُجومَ اللَيلِ وَالقَمَرا",13,"ر",2,0],["فالشيء بالشيء فانظر في عواقبه","مما إذا هو يوماً غاب لم يَؤُبِ",14,"ب",1,0],["فالشافعيّ لو استجلى صحائفه","فدى بأمَّين فحواها وآباء",15,"ا",2,0],["فالشام كالحرم المأمون طائره","فيه الأماني وفيه البرّ والنسك",16,"ك",1,0],["فالشهب تعلم أنك ال","عالي سنا والسحب أنّكْ",17,"ك",1,0],["فالشَّمْلُ مُجْتَمِعٌ والشِّكْلُ مؤْتَلِفٌ","والأزْرُ بالأزر مَشْدُودٌ بمشدودِ",18,"د",1,0],["فَالشَرقُ مُرتَعِدُ الفَرائِصِ جازِعٌ","وَالغَربُ مِن وَقَعاتِها مُتَزَلزِلُ",19,"ل",1,0],["فَالشَرُّ في الناسِ كانَ خَلقا","وَأَيُّ طَيرٍ بِغَيرِ ريشِ",20,"ش",1,0],["فَالشَوقُ كَالحُزنِ لَهُ آخِرٌ","وَيَنقَضي في آخِرِ المُدَّةِ",21,"ه",1,0],["فالشهد في المذاق","فخفة الأوراق",22,"ق",1,0],["فَالشَرقُ يُسقى ديمَةً بِيَمينِهِ","وَالغَربُ تُمطِرُهُ غُيوثُ يَسارِ",23,"ر",1,0],["فالشطرُ في أعلاهُ في مأتمٍ","وشطرُه الأسفلُ في عُرْسِ",24,"س",1,0],["فالشمس إنْ حاذَتْهُ رأْدَ الضُّحَى","حسناءُ في مرآتِها ناظِرَه",25,"ر",2,0],["فَالشَرقُ وَالغَربُ مَغمورانِ مِن أَسَفٍ","باقٍ لِفِقدانِها وَالسَهلُ وَالجَبَلُ",26,"ل",1,0],["فالشفاه المطيبات رمادٌ","وخيام الهوى رماها الهواء",27,"ا",2,0],["فالشكل من أعلاه يحكي شكله","ثدي الكعاب إلى مدار نطاقه",28,"ق",2,0],["فالشِّعرُ بحرٌ نلتُ أنفَسَ دُرِّه","وتنافسَ الشعراءُ في حَصْبائِه",29,"ا",3,0],["فَالشَمسُ تَسري في الحَقيقَةِ يَسرَةً","وَيُديرُها الفَلَكُ المُحيطُ يَمينَ",30,"ن",1,0],["فَالشَمسُ فيهِ مَدى النَهارِ فَطيمَةٌ","وَالظِلُّ كَهلٌ وَالنَسيمُ غُلامُ",31,"م",1,0],["فَالشَمسُ طالِعَةٌ مِن ذا وَقَد أَفَلَت","وَالشَمسُ واجِبَةٌ مِن ذا وَلَم تَجِبِ",32,"ب",1,0],["فالشيبُ قدْ حلَّ برأسي وقدْ","أقسمَ لا يرحل إلاّ بي",33,"ي",1,0],["فَالشَكلُ مِها الغَداةَ مُختَلِفٌ","ذاكَ طِلابُ الضَلالِ وَالفِتَنِ",34,"ن",1,0],["فَالشَمسُ خَمرٌ وَالجِيادُ عَرائِسٌ","وَالجَوُّ كاسٍ وَالسُيوفُ مَداري",35,"ر",2,0],["فالشَّمسُ لا تُغنِي الكَواكِبُ جُمْلَةً","فِي الفَضْلِ مَغْناها وَلا تفضيلا",36,"ل",2,0],["فَالشَمسُ طالِعَةٌ وَلَيلٌ كاسِفٌ","وَالنَجمُ تَجري أَنحُساً وَسُعودا",37,"د",2,0],["فَالشَّعْبُ يَهْتِفُ لِلْمَلِيكِ","وَلِلْمَلِيكَةِ بِالتَّهَانِي",38,"ي",1,0],["فَالشَّعْبُ بِالإِجْمَاعِ يُثْنِي وَإِنْ","لَمْ يَكْفِهِ فِي الشُّكْرِ قَوْلٌ يُقَالُ",39,"ل",1,0],["فالشّارع اللي هيبته هيبة ملك","اللي تهجّا خطوتي .... وأعتادني",40,"ن",2,0],["فالشّرق مر تعد الفرائض جازع","والغرب من وقعاتها متزلزل",41,"ل",1,0],["فالشوقُ يفتحُ ألف نافذةٍ","خضراء ... عن عينيكِ تغنينيَ",42,"ن",2,0],["فالشاه في شهر تموز هوى وكذا","عبد الحميد هوى في شهر تموزا",43,"ز",2,0],["فَالشَمس مَهما تَرقت فَهِيَ قاصِرَة","عَن بَعض أَيسر شَيء مِن مَراقيكا",44,"ك",2,0],["فالشوق توحي به للقلب ذاكرة","كالشوق منبعثاً من منظر الغيد",45,"د",1,0],["فالشعرُ فيه حكمةٌ","وفصاحةٌ لِمن اعتبرْ",46,"ر",1,0],["فالشعرُ ليسَ بمُدرِكٍ أوصافَها","والفنُّ يجمَحُ دون دِقةِ فهمها",47,"م",3,0],["فالشُّرُفُ الجُونُ تَوَخَّتكُمُ","تَرمِيكُمُ بِسَهمِهَا الشَّارِفِ",48,"ف",1,0],["فَالشَّيبُ أدهَى مُنَادٍ","بِمِنبَرِ الفَودِ يُوفي",49,"ف",2,0],["فالشَّرعُ إنكَارُ أهلِ العِلمِ قَاطِبَةً","قَولاً وإلاَّ فَحَدُّ الصَّارِمِ الذَّعَرِ",50,"ر",1,0],["فالشمس تكفل راحتي","فكأنها أمي وأحنى",51,"ن",2,0],["فالشرق يبحث فيه عن عجائبه","والغرب يعجم منه النبع والغرَبا",52,"ب",2,0],["فَالشامُ ذَودٌ ذادَ عَنهُ مُصعَبٌ","قَطِمٌ تَصِلُّ البيضُ إِن هُوَ صالا",53,"ل",2,0],["فالشكر للرحمن ان تمسى به","كلفا تذب عن الهدى وتحامى",54,"م",2,0],["فَالشَرُّ كُلُّ الشَرِّ ما","بَينَ العَمائِم وَالقَلانِسْ",55,"س",1,0],["فالشيبُ أولُ موتِ المرءِ منه إذا","بَدا به كدَبيبِ النارِ في الحَطَب",56,"ب",1,0],["فالشِّعْرُ مَمْلَكَةٌ تأبى لها مَلِكًا","قَدْ قالَ شِعْرًا ولَمْ يُضْرَبْ بِهِ المَثَلُ",57,"ل",1,0],["فَالشَوقُ مِنهُ بِلا مَدى","وَالوَجدُ فيهِ بِلا بِلى",58,"ل",2,0],["فالشعب مديون لهم","بثقافة النشء الفخور",59,"ر",1,0],["فالشاطىء الرملي مهبط حبه","ولكم هنالك رتل الإنجيلا",60,"ل",2,0],["فالشمسُ تطلعُ في نهارٍ مشرقٍ","والبدرُ لا يخفيهِ ليل مظلمُ",61,"م",1,0],["فالشهبُ كثرٌ إذا أبصرتهنَّ ولا","يعددُ الناسُ غيرَ السبعةِ الشُهُبِ",62,"ب",1,0],["فالشمس في فم ذا تجري وفي يد ذا","تبدو إذن خلت مشروباً وملتمسا",63,"س",2,0],["فالشَّيب أسخطهنَّ من بعد الرضا","والعُدم علَّمهنَّ صفح الحالِ",64,"ل",1,0],["فالشمس تقبس نورها من نوره","والحور يؤخذ وصفُها من وصفِه",65,"ف",2,0],["فالشمس من وجهه لها شبه","ومنه بدر السما عليه سمه",66,"م",2,0],["فالشمس ضاءت من مطالع افقها","وسمت ببدر خبائها الألاء",67,"ا",2,0],["فالشمسُ والبدرُ من أنوارِ وَجهِهم","ولليالي ظلامٌ من شُعورِهم",68,"م",1,0],["فالشيخ خزي فادح","متستر تحت العمامه",69,"م",2,0],["فَالشَياطينُ مِن بَني الأَرضِ أَقوا","مٌ همُ سادَةٌ من الزُعَماءِ",70,"ا",2,0],["فَالشِعرُ لَو أَدرَكتَ وَحي حَقيقَة","وَالشاعِرُ الرَسّامُ طوعُ قِيادِهِ",71,"د",2,0],["فالشمس بعد الصحو مشرقة السنا","والبدر في فلك الكمال مداره",72,"ر",2,0],["فالشفة الياقوت والؤلؤ ال","رطب الثمين الثغر والمنطق",73,"ق",1,0],["فَالشِعرُ يُثني عَلى عُلاكَ بِما","يَدخُلُ في وَسعِهِ وَيَعتَذِرُ",74,"ر",1,0],["فَالشَيبُ لَو لَم يُعَدَّ مَنقَصَةً","ما زَهِدَ البيضُ في هَوى الشَيبِ",75,"ب",1,0],["فَالشُّرْبُ مِنْهُ لِذِي ذَوْقٍ وَذِي نَظَرِ","يَكْسِبُ زَهْوَيْنِ زَهْوَ النَّفْسِ وَالْبَصَرِ",76,"ر",1,0],["فَالشُّرْبُ فِيهِ لِذِي ذَوْقٍ وَذِي بَصَرِ","يُكْسِبُ سُكْرَيْنِ سُكْرَ الشُّرْبِ وَالنَّظَرِ",76,"ر",1,0],["فَالشُّهْبُ مِنْ عَزَمَاتِهِ مَذْعُورَةٌ","وَالْقَطْرُ يَحْسُدُ نَيْلَهُ وَالنِّيلُ",77,"ل",1,0],["فالشعر قد صار فيها وأتى","مع ذا بتفصيل ذلك الخبر",78,"ر",1,0],["فالشك إلا في الأحبة فاسد","وبه يقبني لا يكاد يقيني",79,"ن",2,0],["فالشعر لي وَالحسن خالصة لها","وَيدا الصَنيع لاحمد بن محمد",80,"د",1,0],["فَالشَوكُ وَردٌ وَالحَصا دُرٌّ وَذا","كَ الماءُ راحٌ وَالعِضاهُ كُرومُ",81,"م",1,0],["فَالشُّعورُ ال