"],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5690,"قم ودع الغرب أن الشرق ناداكا","https://www.poetsgate.com/ViewPoem.aspx?id=172169",""],[5720,"يا رب","https://www.poetsgate.com/ViewPoem.aspx?id=214737",""],[5790,"أظن البدر لما لحت حارا","https://www.poetsgate.com/ViewPoem.aspx?id=112046",""],[5975,"مدينة عشقي","https://www.poetsgate.com/ViewPoem.aspx?id=33750",""],[6088,"اقباس","https://www.poetsgate.com/ViewPoem.aspx?id=207586",""],[6102,"دانا ..","https://www.poetsgate.com/ViewPoem.aspx?id=183992",""],[6305,"لا تَبْكِ قَتْلاكَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87353&r=&rc=26",""],[5190,"على بُعدِ شاطئين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85032&r=&rc=107",""]],"verses":[["وَلا تَمشِيَن في مَنكِبِ الأَرضِ فاخِراً","فَعَمّا قَليلٍ يَحتَويكَ تُرابُها",0,"ب",3,0],["وَلا تَمشي اللِئامُ لَها بِسِرٍّ","وَلا تُهدي لِجارَتِها السِبابا",1,"ب",2,0],["وَلا تَملِكُ الحَسناءُ قَلبِيَ كُلَّهُ","وَإِن شَمِلَتها رِقَّةٌ وَشَبابُ",2,"ب",1,0],["وَلا تَمتَحي الآياتُ مِن دارِ حُرمَةٍ","بِها مِنبَرُ الهادي الَذي كانَ يَصعَدُ",3,"د",1,0],["ولا تميلنَّ عن عمرو إلى عُمَرٍ","فينتضي لك من أكفانه عمر",4,"ر",1,0],["ولا تمتعض أن سُبِّق الغيث مرة","فما بين ذي سبق وتاليه من فرق",5,"ق",1,0],["ولا تمطلِ الغَصّان بالماء إنه","متى يمطل الغصان بالماء يزهَقِ",6,"ق",1,0],["وَلا تَمَلَّكَني دَلٌّ وَلا خَفَرٌ","وَلا سَبى خَلَدي غُنج وَلا حَوَرُ",7,"ر",1,0],["ولا تمشى على بولا","ق من عُرس إلى عرس",8,"س",1,0],["ولا تَمَسِّي عِذاريهِ فتفتضحِي","بنفجةِ المِسْكِ بين الوِرْدِ والصَّدَرِ",9,"ر",1,0],["وَلا تُمَدُّ يَدٌ يَوماً إِلى طَمَعٍ","وَلا ثَنَتها أَكُفُّ اليَأسِ بِالشَلَلِ",10,"ل",1,0],["ولا تُمْكِنُوه من ذِمامِ سُيوفِكم","فليسَ له عندَ السيوفِ ذِمامُ",11,"م",1,0],["ولا تَمُدُّوا إلى العيُّوقِ أيديَكم","جَهْلاً فلم يُدرِكَ العيُّوقَ طالبُه",12,"ب",2,0],["وَلا تُمكِنَنَّ النَفسَ مِن شَهَواتِها","وَلا تَركَبَنَّ الشَكَّ حَتّى تَيَقَّنا",13,"ن",2,0],["وَلا تُمكِنِ الإِخلاقَ مِنها فَإِنَّما","يَلَذُّ لِباسُ البُردِ وَهُوَ جَديدُ",14,"د",1,0],["ولا تمارِ عاشقاً فتتعبا","وما عليكَ عَتبُهُ فتُعْتَبا",15,"ب",2,0],["ولا تمضي مَغانمُهم إذا ما","مَضتْ أسلابُهم في الغانمينا",16,"ن",2,0],["ولا تَمُرُّ على سَهْلٍ ولا جَبَلٍ","لم تَرْوِهِ من نَدىً أو من دمٍ سَرِبِ",17,"ب",1,0],["ولا تمسك بحبال لها","تصبح من كفيك مجذوذه",18,"ذ",2,0],["ولا تَمْنَعانِي أَنْ أَجُودَ بأَدْمُعٍ","حَوَاها الجَوى لمّا نَظَرْتُ جِواءَهَا",19,"ا",3,0],["ولا تمتعض أن نسبِّق الغيثُ مرة ً","فما بين ذي سبقٍ وتاليه من فرقِ",20,"ق",1,0],["ولا تمنحنا لاجل الذنوب","ولا تذهب القصد منا سدى",21,"د",2,0],["ولا تمنح الود امرءاً ليس أهله","فما كل ماءٍ لامع الوجه مورد",22,"د",1,0],["ولا تمت أسفاً في إثر فائتة","فربما رد بعد الغارة السلب",23,"ب",1,0],["ولا تمنيت طول البعد من وطني","ولا تبدلت بالجيران جيرانا",24,"ن",2,0],["وَلا تَمنَعَن مِن أَوجُهِ الحَقِّ مِثلَما","يَكونُ وَشيكاً لِاِستِهامِ المَوارِثِ",25,"ث",1,0],["وَلا تمازِح إن رَايتَ ابنَهُ","شاكي صُدغٍ لا يُجيبُ المِزاح",26,"ح",1,0],["ولات مناص في الفرار لهالك","ولكنه الأنسان كان هلوعا",27,"ع",2,0],["وَلا تَمتَحني في الورى بعَظيمة","يَضيق بها ذرعي وَيفنى لَها صَبري",28,"ر",2,0],["وَلا تمدد يدا بسؤال ذل","الى غير الَّذي أغنى واقني",29,"ن",2,0],["ولا تملاّ بكاء طول دهر كما","على أب لم يمل الرحم والرأفا",30,"ف",2,0],["ولا تَملّوا فالمَلَل","يعوقُ وَالخَطبُ جَلل",31,"ل",1,0],["ولا تمسك امساك الشحيحين رغبة","ولا تسرف اسراف السفيه كصبيان",32,"ن",1,0],["وَلا تُملِ نَحوَ ما شاءَتهُ قائِلَةٌ","هَذا لَذيذٌ وَخالي الضُرِّ خائِلَة",33,"ه",1,0],["وَلا تَمنَح الأَسفال برّاً فَإِنَّما","زَوالُ المَعالي بِاِصطِناع الأَسافلِ",34,"ل",1,0],["وَلا تَمتَحنّي يا إِلهي بِشدَّةٍ","فَإِنّي قَليلُ الصَبر عِندَ البَليّةِ",35,"ي",2,0],["ولا تَمُجّنَّ سَمْعاً لَفْظَهُ عَجِلاً","ما دام يُستَحسَنُ المَعْنَى إذا ضُبِطا",36,"ط",2,0],["وَلا تَميلُ عَلى ملكٍ يَميلُ عَلى","جَوانِبِ الجودِ مِنهُ العِلمُ وَالأَدَبُ",37,"ب",1,0],["ولا تَمِل إنَّ شمسكْ حان مغربها","وولَّت الزنجُ لما شامت الشَمَطا",38,"ط",2,0],["ولا تمدحنه قبل تهذيب عقله","فقل لي بلا التهذيب ما ينفع المدح",39,"ح",1,0],["ولا تمل بي إلى سواه فلا","أميل عنه ما دمت ذا رمق",40,"ق",1,0],["ولا تَمَلّي مِنْ مَسِيرٍ وَسُرىً","في مَهْمَهٍ سَهلٍ وَوَعْرٍ حَزِنِ",41,"ن",1,0],["ولا تمنعونا نظرةً من جمالكم","فيرتاح قلبٌ أو يُسَرُّ كئيب",42,"ب",1,0],["ولا تُماطلْها بجمّاتِها","معلِّلاً أَظماءَها بالثِّمادْ",43,"د",1,0],["وَلا تُمسِكُ الكاسَ مِنّا يضدٌ","إِذا هُوَ أَمسَكَ أَو أَطلَقا",44,"ق",2,0],["ولا تمن بمعروف فتبطله","ولا تكن لجميل غير مدكر",45,"ر",1,0],["ولا تمَثَّلْتُ بالوادي وظَبْيَتِهِ","إِلاَّ كتبْتُ بقَلبي سطرَ شكلِهِمِ",46,"م",1,0],["ولا تمشِ يا هذا المُطَيْطاءَ في السُّرى","ودعْ عنكَ من ساروا بنهجِ الهُدى مَهْلاَ",47,"ل",2,0],["ولا تمِلْ عن طريقٍ أوضَحوهُ وكنْ","عبداً ذليلاً على الأقْدامِ مُنْتَصبا",48,"ب",2,0],["ولا تَمِلْ بي إلى مَن لا أُسَرُّ بهِ","ففي يَمينكَ أَحزاني وأفراحي",49,"ح",2,0],["ولا تمطُلا ثاره إنّه","فتىً حرّم المَطْلَ في مَطلبِ",50,"ب",1,0],["وَلا تَمنعِ الأجفانَ سَحَّا فكلّما","هَرَقْنَ الّذي فيهنَّ عُدنَ ملاءا",51,"ا",3,0],["ولا تمزج فإن المزج شركٌ","حرامٌ في طريق العارفينا",52,"ن",2,0],["ولا تمنح الأعراب صفحاً ومهلة","فبالصفح والإمهال يستأسد الهر",53,"ر",1,0],["ولا تمتنا دون أن ترينا","ذلك يا ذا الطول أجمعينا",54,"ن",2,0],["ولا تَمزجَاها في الكُؤوس بِريقه","ولكنْ بمدح العادِل المْلكِ فامْزجا",55,"ج",2,0],["ولا تمويه مبتدع جهول","بخلق القول عن أهل الضلال",56,"ل",1,0],["ولا تملا الزُّجاجَ فليسَ عَدلا","على الندمانِ أن تَملا لازجاجا",57,"ج",2,0],["ولا تَمنَعوني عَن مَديحِ صِفاتِكم","فَعِندي ذاكَ المَنعُ مِن أَعظَمِ القَيدِ",58,"د",1,1],["ولا تَمَنَّ أُموراً غِبُّها عَطَبٌ","فَرُبَّ نفسٍ مُناها في مَناياها",59,"ا",3,0],["ولا تمدحنَّ النفس في الناس فاخراً","وخفْ يومَ تجْزَى كل نفسٍ بما تسعى",60,"ع",2,0],["ولا تمدحْ يهوديّاً","لَعيناً صاحب السبتِ",61,"ت",1,0],["ولا تمد لجم الجود جارحة","فالحر يكره حمل المن عاتقه",62,"ق",2,0],["ولا تمل لهوى الدنيا وزخرفها","فعن قريب ترى وجدانه عدما",63,"م",2,0],["ولا تمل في الورى ألا لذي ادبٍ","واحفل بحرّ ثقيفٍ غير ملتئمِ",64,"م",1,0],["ولا تَموتَنْ قُنوطاً","فللإِلهِ عواطِفْ",65,"ف",1,0],["ولا تمل عنه إلى غيرهِ","وحسبنا الله ونعم الوكيل",66,"ل",1,0],["ولأتم نعمتي عليكم","بحفظ لا إله إلا اللّه",67,"ه",1,0],["ولا تمنعاه أن يمر مسلماً","على معهد قضى به العيش صالحا",68,"ح",2,0],["ولا تمل معها للسلم إن جنحت","قد يختم الجرح أحيانا على دغل",69,"ل",1,0],["ولا تَملي بكاءكِ الدهرَ مِغولَةً","عليه ما غردَ القمريُّ بالسَحَرِ",70,"ر",1,0],["ولا تمسك بالعهد الذي زعمت","وطبعها من طريق الدخل مخبول",71,"ل",1,0],["ولا تمل حياة لا بقاء لها","فان مدتها قلت عن الملل",72,"ل",1,0],["وَلا تَمُت حسدا إما رأيت أَخا","حِرصٍ لما نال في الدنيا وَما جمعا",73,"ع",2,0],["ولا تميد الأرض الفضاء بنا","إلا إذا هُدَّ منكمُ جبل",74,"ل",1,0],["وَلا تَمُرُّ عَلى رَوضٍ رِياحُ صَباً","تَحوي عَلى كاعِباتٍ خُرَّدٍ عُرُبِ",75,"ب",1,0],["ولا تمترِ فيما أقول فإنني","وقفت على علمٍ من البحرِ زاخر",76,"ر",1,0],["ولا تمنعن من رؤية الميت أهلهُ","وتقبيله فعل المحبّ المجوّد",77,"د",1,0],["ولا تمسكت فيها","إلا بنفحة نده",78,"د",2,0],["ولا تمش من كون لكون تكن كما","حمار الرحا وارحل إلى المقصد الأسنى",79,"ن",2,0],["ولا تميلوا عن رشفِ ثغرٍ","وسمع شدوٍ وشرب راحِ",80,"ح",1,0],["ولا تمش الضراء فقد أثرت ال","أسود الغلب تخطر باحتفاز",81,"ز",1,0],["ولا تمت قبل موت","بالهمّ خدنِ الحمام",82,"م",1,0],["وَلا تَميل إِلى دار المقام إِلى","أَن تلقي الرحل باب النيل سؤلاها",83,"ا",3,0],["وَلا تمل أَبداً يَوماً لِقولهما","فأنتَ تَعرف كَيد الخَصم وَالحكم",84,"م",1,0],["ولا تمل عنهم يوما الى احد","تمقت لديهم وتلقى بعد طردهم",85,"م",1,0],["ولا تمديدا والقوم قد وضعوا","ولم يتم لهم وضع لطعمهم",85,"م",1,0],["ولا تمد لطرف في مجالسهم","ولا تمل نحو دنياهم وبزهم",85,"م",1,0],["ولا تمن لموت ان بليت نعم","ان خفت من فتنة في الدين لم تلم",85,"م",1,0],["ولا تمل ولا تكسل فربك لا","يمل حل علا فانهض له وقم",85,"م",1,0],["ولا تمش في ريح وشمس ولا تطل","وإن ألزمَتْ في الصبح والعصر فاركب",86,"ب",1,0],["وَلا تمل لشادن قصده","لدى التآخي قصد شَيطانِ",87,"ن",1,0],["ولا تمنعونَ السائراتِ كأَنَّها","كتائبُ خيلٍ تَحمِل الاسلَ اللدْنَا",88,"ن",2,0],["وَلا تَمشِ في الحَربِ الضَرّاءَ وَلا تُطِع","ذَوي الضَعفِ عِندَ المَأزِقِ المُتَحَفِّلِ",89,"ل",1,0],["وَلاَ تُمِل لِسَبَبٍ لَم يَتَّصِل","وَالكَفُّ قَد يُوجِبُهُ مَا يَ