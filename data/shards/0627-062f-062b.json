{"poems":[[4807,"مِدادٌ من شعور","https://www.poetsgate.com/ViewPoem.aspx?id=213614",""],[5092,"نعمْ هي لي","https://www.poetsgate.com/ViewPoem.aspx?id=139680",""],[5121,"لُؤْلُؤَة","https://www.poetsgate.com/ViewPoem.aspx?id=215867",""],[6152,"جار الطير","https://www.poetsgate.com/ViewPoem.aspx?id=205855",""],[6360,"شَغَبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87598&r=&rc=1",""]],"verses":[["‏أُدثِّرُها بأَوشِحةٍ تَسامتْ","‏لِمحْرابِ المَكارِمِ والمفاخِرْ",0,"ر",1,0],["أدثِّرُ مابقى من دوَّماتي","بموجٍ غارقٍ , فيهِ السهادُ",1,"د",1,0],["أُدَثِّرُ النُّورَ بِالْجَفْنَيْنِ مُرْتَخِياً","كَأَنَّ فِي رُؤْيَتِي أُرْجُوحَةُ الْفَنَقِ",2,"ق",1,0],["أدثره وأحفظه بصبري","وأرسمه لمن خلفي مسارا",3,"ر",2,0],["أُدَثِّرُ صَمْتِي بِصَمْتٍ طَوِيلٍ","وَأَرْوِي انْتِظَارِي بحُمَّى الْغَضَبْ",4,"ب",1,0]]}