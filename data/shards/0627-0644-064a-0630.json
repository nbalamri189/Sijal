{"poems":[[53,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[93,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[45,"ضروب الناس عشاق ضروبا","https://www.aldiwan.net/poem9501.html","الوافر"],[107,"إلى ذات السلاسل من بلي","https://www.aldiwan.net/poem43574.html","الوافر"],[77,"أمن أفقها ذاك السنا وتألقه","https://www.aldiwan.net/poem69058.html","الطويل"],[7,"وما حاولتما بقياد خيل","https://www.aldiwan.net/poem2007.html","الوافر"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85552","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140900",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54565","الوافر"],[154,"أرقت لبرق من تهامة مومض","https://www.aldiwan.net/poem68586.html","الطويل"],[173,"ذريني فضرباً بالمهندة البتر","https://www.aldiwan.net/poem1623.html",""],[199,"ألا رب لهو آنس ولذاذة","https://www.aldiwan.net/poem54397.html","الطويل"],[369,"هم نازلون بقلبي أية سلكوا","https://www.aldiwan.net/poem60817.html","البسيط"],[369,"حلفت بالساعين يوم الموقف","https://www.aldiwan.net/poem60837.html","الرجز"],[369,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[369,"حياءك من غصن بدمعي ثابت","https://www.aldiwan.net/poem60980.html","الطويل"],[408,"أنا السيف لا تختشى نبوتي","https://www.aldiwan.net/poem46408.html","المتقارب"],[422,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[438,"لهن ربوع بالعقيق دواثر","https://www.aldiwan.net/poem12468.html","الطويل"],[438,"قف بقفراء يباب","https://www.aldiwan.net/poem12547.html","مجزوء الرمل"],[466,"ولو أن نكسا خامل الذكر جاهلا","https://www.aldiwan.net/poem15409.html","الطويل"],[566,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66684","الوافر"],[749,"","https://poetry.dctabudhabi.ae/diwan/poem/97584","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63840","الهزج"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38276","الوافر"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18510","المتقارب"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96306","الطويل"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90677","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100969","الوافر"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11195","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28031","البسيط"],[2447,"","https://poetry.dctabudhabi.ae/diwan/poem/198716","الوافر"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100893","الطويل"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131898","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100763","المتقارب"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74072","المتقارب"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36717","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36715","المنسرح"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85261","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135500","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199093","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136914",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91000","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58078","الطويل"],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66857","الهزج"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113824","البسيط"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204312","الطويل"],[4755,"إلى الشِّعرِ لَيلًا تَطِيرُ اليَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=183688",""],[4935,"إلهي فرج الكربا","https://www.poetsgate.com/ViewPoem.aspx?id=129287",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5720,"رحلتي في عسير","https://www.poetsgate.com/ViewPoem.aspx?id=198936",""],[5732,"يا نور عيني","https://www.poetsgate.com/ViewPoem.aspx?id=177930",""],[5732,"قلبي نهبته","https://www.poetsgate.com/ViewPoem.aspx?id=177915",""],[5732,"إلى عذلت القلب","https://www.poetsgate.com/ViewPoem.aspx?id=177953",""],[5355,"عن الحبّ الذي ولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87125&r=&rc=20",""]],"verses":[["إلى ذراه أنيخت بعد متعبة","أنضاء ركب أملّوا الأرض تطوافا",0,"ف",2,0],["إِلى ذَوي العِلمِ إِلى أَهلِ الغِنى","مِن واصِلٍ وَهاجِرٍ وَسالِ",1,"ل",1,0],["إِلى ذي اِنتِقامٍ لا يَنامُ غَريمُهُ","وَلَو أَنَّهُ شَخصُ المَنامِ المُحَجَّبُ",2,"ب",1,0],["إِلى ذي شيمَةٍ شَعَفَت فُؤادي","فَلَولاهُ لَقُلتُ بِها النَسيبا",3,"ب",2,0],["إلى ذاتِ السَّلاسِلِ مِن بَليِّ","وعُذْرَةَ فَامْضِ بُورِكَ مِن مُضِيِّ",4,"ي",1,1],["إلى ذاك رأيُ الهِبْرِزِيِّ إذا ارتأى","وصِدْقُ ظنونِ الألَمعيِّ ومَصْدَقُه",5,"ق",2,0],["إِلى ذُبيانَ حَتّى صَبَّحَتهُم","وَدونَهُمُ الرَبائِعُ وَالخُبَيتُ",6,"ت",1,0],["إلى ذَوي الدِّيوانِ والرَّاياتِ","وكُلِّ مَنْسوبٍ إلى الشَّاماتِ",7,"ت",1,0],["إلى ذي اختيار في الحكومة مطلق","إذا شاء لم يفعل وإن شاء يفعل",8,"ل",1,0],["إلى ذي شيمةٍ شغفت فؤادي","فلولاه لقلت بها النسيبا",9,"ب",2,0],["إلىَ ذَاكَ المَقَامِ الْحَمدْ يُهْدَى","وَعَنْ ذَاكَ المَقَامِ الذَّمُّ نَابِي",10,"ب",2,0],["إِلى ذِمَّةٍ لا تَلتَقي بِمَذَمَّةٍ","إِلى عِصمَةٍ تَجلودُ جيَ كُلِّ وَصمَةٍ",11,"ه",1,0],["إِلى ذروَةِ البَيتِ العُيونِيِّ يَنتَمي","وَهَل يَنتَمي الدِينارُ إِلّا إِلى التِبرِ",12,"ر",1,0],["إِلى ذي الحِيافِ ما بِهِ اليَومَ نازِلٌ","وَما حَلَّ مُذ سَبتٌ طويلٌ مُهَجِّرُ",13,"ر",1,0],["إلى ذُراكَ قِوامَ الدِّينِ سارَ بنا","خُوصٌ كما اصطَفَّ من نَخْلِ القُرَى سِكَك",14,"ك",1,0],["إلى ذُراهُ قطَعتْ ركائبي","للمجدِ كُلَّ مَهْمَهٍ ونَفْنَف",15,"ف",1,0],["إلى ذُراكَ الرَّحْبِ نوِّخْتُها","وقد بَراها السَّيرُ بَرْيَ القِداح",16,"ح",1,0],["إلى ذُخرِ أحرارٍ تَؤمُّ عِراصَه","إذا طَرقَتْ إحدى الخُطوبِ البَواغت",17,"ت",1,0],["إلى ذي القفار اعتزائي كما","إلى حيدر يعتزي صاحبي",18,"ي",1,0],["إلى ذُرا جرثومةٍ طيبةٍ","إذ ينتمي القرم ولمّا ينتمى",19,"ا",1,0],["الى ذي سماحٍ لو يعدَّدُ فضله","الى أن يكون الرّمْلُ ممّن يكاثِرُ",20,"ر",1,0],["إلي ذلك يصبو","كلّ وقتٍ كلُّ صابِ",21,"ب",1,0],["إِلى ذروةٍ شمَّاء من شرفِ العُلى","بناها فأعلى سيدٌ بعد سيدِ",22,"د",1,0],["إِلَيَّ ذي الحَلاوَةِ المُعَسَّلِ","جاءَ بِهِ مَرُّ البَريدِ المُرسَلِ",23,"ل",1,0],["إلى ذي علمِهِ الهادي عليٍّ","وخولةُ خادمٌ في البيتِ تَرْدِي",24,"د",2,0],["إِلى ذي الندى والمجدِ سارت ركائِبي","عَلى شحط تصلى بنار الهواجرِ",25,"ر",1,1],["إلى ذي العزِّ والعارِ","إلى قاطِع أفسار",26,"ر",1,1],["إِلى ذي الجاهِ وَالعليا عليٍّ","وَمَن أَولى العُلى عِزّاً وَمَجدا",27,"د",2,0],["إِلى ذاكَ ما شابَ أَبناؤُنا","وَبادَ الأَخِلّاءُ وَالمَعشَرُ",28,"ر",1,0],["إلى ذائدٍ في الحرب لم يكُ خامِلاً","إذا عاذَ بالسَّيف المُجرّد حامله",29,"ل",2,0],["إلى ذاكَ ماأودَت بقايا بشاشتي","وشِبتُ فلم يربع عليّ خليلُ",30,"ل",1,0],["إلى ذاك الجناب الرحب تسعى","به نجب المنية مسرعات",31,"ت",1,0],["إِلى ذاكَ ما حارَت أُمورُكَ وَإِنجَلَت","غَيابَةُ حُبِّيكِ إِنجِلاءَ المَخايِلِ",32,"ل",1,0],["إلى ذكرت الذي عليه معتمدي","سبحانه كنت فيه المثبت النافي",33,"ف",2,0],["إلى ذي صفحة كالماء رقت","وراقت فهي كالسيف اليماني",34,"ن",2,0],["إلى ذلك المُلكِ الذى بات دوننا","على أَمره مستَضعَفاً غيرَ قادر",35,"ر",1,0],["إلى ذاك الكريمِ وَمَن لِعَبدٍ","أُضِيفَ لمُحسِنٍ يهوى الوَقَارا",36,"ر",2,0],["إلى ذلك الصهر رب النهى","كريم السلالة والمحتد",37,"د",1,0],["إِلى ذلك الفرد مَجموعتي","وَمن ذلك البحر إِروائيَه",38,"ي",2,0],["إِلى ذُراك أَتَت فَاِقبل عَلى دَخَلٍ","نَسيجَها يا رَئيس البَدوِ وَالحَضَرِ",39,"ر",1,0],["إِلى ذُراهُ أَتَيتُ مُشتَكياً","بَينَ يَدَيهِ لِقِصَّتي رافِع",40,"ع",1,0],["إلى ذي السما الدنيا ينادي عباده","إلى أن يكون الفجر في الأفق يشعل",41,"ل",1,0],["إلى ذي الأمانات الأمين محمد","أمين ومامين ومكس بلا نكس",42,"س",1,0],["إلى ذي المعالي وابن سيد قومه","حليف الندى رب العلى والفضائل",43,"ل",1,1],["إلى ذات خصر كعنق الحمام","وجيد النعام استطالا",44,"ل",2,0],["إلى ذات ساق سويّ النظام","يحاكي نحيت الرخام انفتالا",44,"ل",2,0],["إلى ذرية الحسن الدراري","مصابيح الهداية في الظلام",45,"م",1,0],["إلى ذاتِ حَرٍّ في الجحيمِ مُكَبَّلاً","وما شافعٌ في ذلك اليومِ يَشْفَعُ",46,"ع",1,0],["إلى ذقن أطلناها","بعثنون لتزدانا",47,"ن",2,0],["إلى ذويّ بني الصحاف كلهمو","وآليَ الغر تسليمي وتكريمي",48,"م",2,0],["إلى ذات يومٍ لا ترى الأرض وارثاً","سوى الله من إنسٍ يراه باني",49,"ن",2,0],["إلى ذلِكَ البَابِ سِرْ بي عَسَى","إذا قُلتُ يا بابُ.. لا أُطرَدُ",50,"د",1,0],["إلى ذلِكَ الحَقْلِ حَيثُ الحَصَى","على الزَّرعِ, والشَّوْكُ مُستَورَدُ",50,"د",1,0],["إلى ذلِكَ الرُّكنِ خُذْنِي, وقُل","لِأروَى: لقَد غَشَّنَا \"الأسْوَدُ\"",50,"د",1,0],["إلى ذات البروج رقي","وجبريل له صحبا",51,"ب",2,0],["إلى ذروات المجد والعز والهنا","لتحصيل مأمول من المال ذي الوفر",52,"ر",1,0],["إلى ذرة المجد والمجد إنما","ينال بتقوى الله حقاً ويرتمى",53,"م",2,0],["إلى ذروات المجد والعلم والتقى","ولاشك قد كانوا أبر وأعلما",54,"م",2,0],["إلى ذكرياتٍ .. لا تغيبُ بخاطري","ملامحُها تحكي السنينَ الخواليا",55,"ي",2,0],["إلى ذكرتك دمع عيني يفيضي","وامسح غزير الدمع عقب اندفاقه",56,"ق",2,0],["الى ذكرته شاح قلبي وجيته","لو هو يسيل الدم من سبت ماطاي",57,"ا",2,0],["إلى ذكرته صار بالقلب دقاق","واذكر جبينه كل ما شفت بارق",58,"ق",1,0],["ألي ذنب إذا لاحت","بطيف نحو نافذتي",59,"ت",2,0],["ألي ذنب إذا حضرت","فأنسى كل أسئلتي",59,"ت",2,0]]}