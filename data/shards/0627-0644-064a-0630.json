{"poems":[[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[91,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"ضروب الناس عشاق ضروبا","https://www.aldiwan.net/poem9501.html","الوافر"],[105,"إلى ذات السلاسل من بلي","https://www.aldiwan.net/poem43574.html","الوافر"],[75,"أمن أفقها ذاك السنا وتألقه","https://www.aldiwan.net/poem69058.html","الطويل"],[7,"وما حاولتما بقياد خيل","https://www.aldiwan.net/poem2007.html","الوافر"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85552","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140900",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54565","الوافر"],[150,"أرقت لبرق من تهامة مومض","https://www.aldiwan.net/poem68586.html","الطويل"],[169,"ذريني فضرباً بالمهندة البتر","https://www.aldiwan.net/poem1623.html",""],[195,"ألا رب لهو آنس ولذاذة","https://www.aldiwan.net/poem54397.html","الطويل"],[364,"هم نازلون بقلبي أية سلكوا","https://www.aldiwan.net/poem60817.html","البسيط"],[364,"حلفت بالساعين يوم الموقف","https://www.aldiwan.net/poem60837.html","الرجز"],[364,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[364,"حياءك من غصن بدمعي ثابت","https://www.aldiwan.net/poem60980.html","الطويل"],[402,"أنا السيف لا تختشى نبوتي","https://www.aldiwan.net/poem46408.html","المتقارب"],[416,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[432,"لهن ربوع بالعقيق دواثر","https://www.aldiwan.net/poem12468.html","الطويل"],[432,"قف بقفراء يباب","https://www.aldiwan.net/poem12547.html","مجزوء الرمل"],[461,"ولو أن نكسا خامل الذكر جاهلا","https://www.aldiwan.net/poem15409.html","الطويل"],[561,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"]],"verses":[["إلى ذراه أنيخت بعد متعبة","أنضاء ركب أملّوا الأرض تطوافا",0,"ف",2,0],["إِلى ذَوي العِلمِ إِلى أَهلِ الغِنى","مِن واصِلٍ وَهاجِرٍ وَسالِ",1,"ل",1,0],["إِلى ذي اِنتِقامٍ لا يَنامُ غَريمُهُ","وَلَو أَنَّهُ شَخصُ المَنامِ المُحَجَّبُ",2,"ب",1,0],["إِلى ذي شيمَةٍ شَعَفَت فُؤادي","فَلَولاهُ لَقُلتُ بِها النَسيبا",3,"ب",2,0],["إلى ذاتِ السَّلاسِلِ مِن بَليِّ","وعُذْرَةَ فَامْضِ بُورِكَ مِن مُضِيِّ",4,"ي",1,1],["إلى ذاك رأيُ الهِبْرِزِيِّ إذا ارتأى","وصِدْقُ ظنونِ الألَمعيِّ ومَصْدَقُه",5,"ق",2,0],["إِلى ذُبيانَ حَتّى صَبَّحَتهُم","وَدونَهُمُ الرَبائِعُ وَالخُبَيتُ",6,"ت",1,0],["إلى ذَوي الدِّيوانِ والرَّاياتِ","وكُلِّ مَنْسوبٍ إلى الشَّاماتِ",7,"ت",1,0],["إلى ذي اختيار في الحكومة مطلق","إذا شاء لم يفعل وإن شاء يفعل",8,"ل",1,0],["إلى ذي شيمةٍ شغفت فؤادي","فلولاه لقلت بها النسيبا",9,"ب",2,0],["إلىَ ذَاكَ المَقَامِ الْحَمدْ يُهْدَى","وَعَنْ ذَاكَ المَقَامِ الذَّمُّ نَابِي",10,"ب",2,0],["إِلى ذِمَّةٍ لا تَلتَقي بِمَذَمَّةٍ","إِلى عِصمَةٍ تَجلودُ جيَ كُلِّ وَصمَةٍ",11,"ه",1,0],["إِلى ذروَةِ البَيتِ العُيونِيِّ يَنتَمي","وَهَل يَنتَمي الدِينارُ إِلّا إِلى التِبرِ",12,"ر",1,0],["إِلى ذي الحِيافِ ما بِهِ اليَومَ نازِلٌ","وَما حَلَّ مُذ سَبتٌ طويلٌ مُهَجِّرُ",13,"ر",1,0],["إلى ذُراكَ قِوامَ الدِّينِ سارَ بنا","خُوصٌ كما اصطَفَّ من نَخْلِ القُرَى سِكَك",14,"ك",1,0],["إلى ذُراهُ قطَعتْ ركائبي","للمجدِ كُلَّ مَهْمَهٍ ونَفْنَف",15,"ف",1,0],["إلى ذُراكَ الرَّحْبِ نوِّخْتُها","وقد بَراها السَّيرُ بَرْيَ القِداح",16,"ح",1,0],["إلى ذُخرِ أحرارٍ تَؤمُّ عِراصَه","إذا طَرقَتْ إحدى الخُطوبِ البَواغت",17,"ت",1,0],["إلى ذي القفار اعتزائي كما","إلى حيدر يعتزي صاحبي",18,"ي",1,0],["إلى ذُرا جرثومةٍ طيبةٍ","إذ ينتمي القرم ولمّا ينتمى",19,"ا",1,0],["الى ذي سماحٍ لو يعدَّدُ فضله","الى أن يكون الرّمْلُ ممّن يكاثِرُ",20,"ر",1,0],["إلي ذلك يصبو","كلّ وقتٍ كلُّ صابِ",21,"ب",1,0],["إِلى ذروةٍ شمَّاء من شرفِ العُلى","بناها فأعلى سيدٌ بعد سيدِ",22,"د",1,0],["إِلَيَّ ذي الحَلاوَةِ المُعَسَّلِ","جاءَ بِهِ مَرُّ البَريدِ المُرسَلِ",23,"ل",1,0]]}