{"poems":[[37,"ألمم بعزة إن الركب منطلق","https://www.aldiwan.net/poem39127.html","البسيط"],[32,"يظل مرتبئا للشمس تصهره","https://www.aldiwan.net/poem29450.html","البسيط"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[32,"يا حاديي بنت فضاض أما لكما","https://www.aldiwan.net/poem29609.html","البسيط"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[53,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[31,"هل تعرف اليوم من ماوية الطللا","https://www.aldiwan.net/poem6034.html","البسيط"],[34,"قامت تودعنا والعين ساكبة","https://www.aldiwan.net/poem27703.html","البسيط"],[82,"إلى متى منكم هجري وإقصائي","https://www.aldiwan.net/poem31577.html","البسيط"],[107,"لمن دم في مغاني الحي مطلول","https://www.aldiwan.net/poem42135.html","البسيط"],[52,"يا سلم هل قيمكم ماكث","https://www.aldiwan.net/poem64721.html","السريع"],[78,"أهدت إليك حمياها بكاسين","https://www.aldiwan.net/poem38863.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/921","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[207,"ما بال عينك قد أزرى بها السهد","https://www.aldiwan.net/poem68168.html","البسيط"],[208,"خاف الملال إذا طالت إقامته","https://www.aldiwan.net/poem53078.html","البسيط"],[234,"يا شأم شؤمك عادي","https://www.aldiwan.net/poem51192.html","المجتث"],[302,"أما ترى الصبح قد لاحت بشائره","https://www.aldiwan.net/poem33253.html","البسيط"],[302,"قم هاتها كالنار ذات الوقود","https://www.aldiwan.net/poem33291.html","السريع"],[355,"أقفر من سلمى يناضيبُ","https://www.aldiwan.net/poem641.html",""],[358,"ليهن ورق الحمى في الأيك تغريد","https://www.aldiwan.net/poem40400.html","البسيط"],[376,"أين مكان السلو من عذلي","https://www.aldiwan.net/poem57231.html","المنسرح"],[411,"كالشمس نورا ولكن ماله لهب","https://www.aldiwan.net/poem50077.html","البسيط"],[435,"أهلا بخير صفاء","https://www.aldiwan.net/poem40787.html","المجتث"],[458,"ما اسكندر اليازجي اليوم أعرفه","https://www.aldiwan.net/poem61793.html","البسيط"],[505,"دار الولي إذا ما مات عامرة","https://www.aldiwan.net/poem37758.html","البسيط"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44587","المجتث"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146221","المجتث"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64095","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37771","البسيط"],[2049,"","https://poetry.dctabudhabi.ae/diwan/poem/118062","البسيط"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45493","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53155","السريع"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33859","البسيط"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101714","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115422","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74157","الرجز"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112479","البسيط"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140306",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62797","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91593","البسيط"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103790","المجتث"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66554","البسيط"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103536","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102730","البسيط"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67425","البسيط"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102017","البسيط"],[5302,"لقاء حب","https://www.poetsgate.com/ViewPoem.aspx?id=200063",""],[5409,"يمشي الهوينا كأن الأرض قد رجفت","https://www.poetsgate.com/ViewPoem.aspx?id=155439",""]],"verses":[["كَأَنَّهُ حينَ مارَ المَأقَيانِ بِهِ","دُرٌّ تَحَلَّلَ مِن أَسلاكِهِ نَسَقُ",0,"ق",1,0],["كَأَنَّهُ حينَ يَمتَدُّ النَهارُ لَهُ","إِذا اِستَقامَ يَمانٍ يَقرَأُ الطِوَلا",1,"ل",2,0],["كَأَنَّهُ حينَ تَدنو وِردَها طَمَعاً","بِالصَيدِ مِن خَشيَةِ الإِخطاءِ مَحمومُ",2,"م",1,0],["كَأَنَّهُ حينَ يرمي خَلفَهُنَّ بِهِ","حادي ثَمانٍ مِنَ الحُقبِ السَماحيجِ",3,"ج",1,0],["كَأَنّهُ حَبَشِيٌّ يَبتَغي أَثَراً","أَو مِن مَعاشِرَ في آذانِها الخُرَبُ",4,"ب",1,0],["كأنه حين يجري في كتابته","له طريق إلى العلياء مختصر",5,"ر",1,0],["كَأَنَّهُ حينَ يَمتَدُّ النَهارُ لَهُ","إِذا اِستَقَلَّ يَمانٍ يَقرَءُ الطولا",6,"ل",2,0],["كأَنَّهُ حينَ جَدَّ المأقِيَان بِه","دُرٌّ تقطَّع منهُ السلك مُنسجلُ",7,"ل",1,0],["كأنّه حينَ يستشفيْ بغانيةٍ","غيرِ البخيلة يَرْمي الداءَ بالداءِ",8,"ا",2,0],["كأنَّهُ حِينَ غَالتْهُ عَمايتُه","على الهوانِ وحُبِّ الضَّيمِ مَجبولُ",9,"ل",1,0],["كَأَنَّهُ حينَ تَصَدّى لَهُ","طالِبُ عُرفٍ أَسَدٌ شارِثُ",10,"ث",1,0],["كأنَّه حين يمشي في تأوُّدهِ","قضيبُ بانٍ تَثنَّى بينَ ريحينِ",11,"ن",1,0],["كأَنه حين يجري","ريح هياع لياع",12,"ع",1,0],["كَأَنَّهُ حينَ أَذكى نارَ وَجنَتِهِ","سُكراً وَأَسبَلَ فَضلَ الفاحِمِ الجَعدِ",13,"د",1,0],["كَأَنَّهُ حَكَمُ العُشَّاقِ كَمْ وَسِعَتْ","بَيْضاءُ جُبَّتِهِ شَتَّى قَضاياها",14,"ا",3,0],["كَأَنَّهُ حينَ يَكبو في جَديلَتِهِ","تَحتَ العَجاجِ وَفيهِ ثَعلَبٌ جَسَدُ",15,"د",1,0],["كأنه حين يبدو من مطالعِهِ","صبّ يقبِّلِ حبّاً وهو يرتقبُ",16,"ب",1,0],["كأنّه حُللَ البي","ت في عيون الحَجِيج",17,"ج",1,0],["كأَنَّه حين يَثني غصنَ قامَتِه","شُدَّت على نَقوى رَملٍ مآزِرُهُ",18,"ر",2,0],["كأَنَّه حين بَدا مُسفِراً","وَجهُ حُسينٍ حين يَلقى الوفود",19,"د",1,0],["كَأَنَّهُ حين نَجا كَوكَبٌ","أَو قَبَسٌ بالكَفِّ مَشبوبُ",20,"ب",1,0],["كَأَنَّهُ حينَ حَيّاه الحَيا سحراً","خودٌ بِها لِلحَيا في الخَدّ تَوريدُ",21,"د",1,0],["كأنَّهُ حينَ لا اعتِقادَ لَهُ","جاءَ عَلى فَترَةٍ مِن الرُّسُلِ",22,"ل",1,0],["كأنَّهُ حينَ يُعطي كُلَّهُ رَغَبُ","كأنَّهُ حينَ يَحمي كُلُّهُ رَهَبُ",23,"ب",1,0],["كأنه حين يجري","من أذنه الماءُ وكفا",24,"ف",2,0],["كأنه حُلمُ الجنات فارقنِي","فبنتُ عنها كسيفَ البال مشدوها",25,"و",3,0],["كأنَّهُ حاضِرٌ فيها بهيْئَتِهِ","يَراهُ من فيهِ عِرْفانٌ وإِيمَانُ",26,"ن",1,0],["كَأَنَّهُ حينَ يَبدو","بُرادَةُ الآبُنوسِ",27,"س",1,0],["كأنه حين أهوى","لهن بازٍ صيود",28,"د",1,0],["كأنه حَوْلَهُ وجوهٌ","مستشرفاتٌ إلى حريق",29,"ق",1,0],["كَأَنّهُ حيّةٌ وَالرّوضُ مَدَّ لَهُ","قُدودَ أَشجارِهِ لِلطّعنِ أَرمَاحا",30,"ح",2,0],["كأنه حين يعتن البيان له","غيث يسحّ سجالا لم تكن نزفا",31,"ف",2,0],["كَأَنَّهُ حينَ يَستَسقي الضَجيعُ بِهِ","بَعد الكَرى بِمدامِ الراحِ مَشمولُ",32,"ل",1,0],["كأنه حين أنار الدجى","رَوْنَقُ ذاك الشنب الريِّق",33,"ق",1,0],["كَأَنَّهُ حالِفٌ بِاللِهِ مُجتَهِداً","أَلّا يَقومَ عَلى أُنثى وَلا ذَكَرِ",34,"ر",1,0],["كأنه حين راح الثغر أسكره","غنى فكاد غناه يطرب الورقا",35,"ق",2,0],["كأنه حينَ يجرى زُرقةً وصفا","رقراق عينٍ بوجه الأرض شهلاءِ",36,"ا",2,0],["كَأَنَّهُ حَديقة مِن وَرد","أَو منهل عذب شَهي الوَرد",37,"د",1,0],["كأنه حكمة المجنون يرسلها","من غير قصد فلا تصغى لها أذن",38,"ن",1,0],["كأنه حين ينهاهم ويأمرهم","مسخرون لهم يوحي سليمان",39,"ن",1,0],["كأنّهُ حينَ يستخفي مكارمَه","يَعُدُّ إظهارَها فينا من الرِّيَبِ",40,"ب",1,0],["كَأَنه حَيثما أَهداه مبتسماً","وَقَد سَبى القَلبَ وَاستولى عَلى الفِكَر",41,"ر",1,0],["كأنه حين يبدو","مداهن اللازورد",42,"د",1,0],["كَأَنَّهُ حَينَ يَرمْي عَنْ حَنِيَّتِهِ","بَدْرٌ رَمَى عَن هِلالِ الأُفْقِ بِالشُّهُبِ",43,"ب",1,0],["كأنه حين جَلّى الحزنَ عن خلَدي","قميصُ يوسف في أجفان يعقوب",44,"ب",1,0],["كأنه حين يجتاب الضلوع له","بين الجوانح والإحشاء حاجات",45,"ت",1,0],["كأنه حين يبدو من مطالعه","صبّ يقبل صباً وهو مرتقب",46,"ب",1,0],["كأنه حين يغشى الجمع منفرداً","عرمرم سال أو شيل من العرم",47,"م",1,0],["كأنه حين وافى لحظها ورنا","لقبلة عاد بعد الغبن منتصرا",48,"ر",2,0],["كأنه حين يلوي جيده دنفٌ","يشكو صداعاً فيلويه من الألم",49,"م",1,0]]}