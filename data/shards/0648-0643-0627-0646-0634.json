{"poems":[[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[0,"لمن الديار غشيتها بِسحام","https://www.aldiwan.net/poem64.html",""],[93,"طفيء الصباح بعيني الإلهام","https://www.aldiwan.net/poem11359.html","الكامل"],[54,"أهلا وسهلا بالمشيب","https://www.aldiwan.net/poem27622.html","الكامل"],[51,"يا أيها النفر الذين تعجبوا","https://www.aldiwan.net/poem65464.html","الكامل"],[51,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[29,"صرمت أمامة حبلها ورعوم","https://www.aldiwan.net/poem6063.html","الكامل"],[89,"وقفت عند الحدث النازل","https://www.aldiwan.net/poem44899.html","السريع"],[85,"الملك بين يديك في إقباله","https://www.aldiwan.net/poem63756.html","الكامل"],[45,"مع الدهر ظلم ليس يقلع راتبه","https://www.aldiwan.net/poem10905.html","الطويل"],[45,"أما وهواك حلفة ذي اجتهاد","https://www.aldiwan.net/poem63502.html","الوافر"],[45,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[61,"عصى الرشاد فقد ناداه من حين","https://www.aldiwan.net/poem51409.html","البسيط"],[49,"أأخي لا تنس القبور","https://www.aldiwan.net/poem64150.html","مجزوء الكامل"],[48,"كيف النزوع عن الصبا والكاس","https://www.aldiwan.net/poem63424.html","الطويل"],[48,"نزه صبوحك عن مقال العذل","https://www.aldiwan.net/poem64500.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85441","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[143,"تظن فراقا أن تثار حمول","https://www.aldiwan.net/poem58376.html","الطويل"],[251,"وصلت على إنفاق عمري تأسفي","https://www.aldiwan.net/poem15080.html","الطويل"],[271,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[299,"يا ليتني لما شرب","https://www.aldiwan.net/poem36797.html","عموديه"],[306,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[338,"يأوي إذا كشحت إلى أطبائها","https://www.aldiwan.net/poem45302.html","الكامل"],[358,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[358,"يا أهل تدمير إن جاركم","https://www.aldiwan.net/poem4169.html","المنسرح"],[442,"عزاء فما كل حي بحي","https://www.aldiwan.net/poem14493.html","المتقارب"],[465,"شغفي بأعطاف الغصون الهيف","https://www.aldiwan.net/poem3453.html","عموديه"],[465,"أو ما ترى وجه السماء معبساً","https://www.aldiwan.net/poem3547.html","عموديه"],[480,"ما للقريض تعاصى","https://www.aldiwan.net/poem36906.html","المجتث"],[501,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[552,"لا تفخرن إلا بنفسك","https://www.aldiwan.net/poem48032.html","مجزوء الكامل"]],"verses":[["وَكانَ شَيءٌ إِلى شَيءٍ فَفَرَّقَهُ","دَهرٌ يَعودُ عَلى تَشتيتِ ما جَمَعا",0,"ع",2,0],["وَكَأَنَّ شارِبَها أَصابَ لِسانَهُ","مومٌ يُخالِطُ جِسمَهُ بِسَقامِ",1,"م",1,0],["وَكَأَنَّ شَمْسَ العَبْقَرِيَّةِ كُفِّنَتْ","بَعْدَ ازْدِهَارِ شُعَاعِهَا بِقَتَامِ",2,"م",1,0],["وَكَأَنَّ شَيبي نَظمُ دُرٍّ زاهِرٍ","في تاجِ ذي مُلكٍ أَغَرَّ مُتَوَّجِ",3,"ج",1,0],["وكأن شيب عجانه حول استه","بدد الخليط على جوانب معلف",4,"ف",1,0],["وكأن شخصَك حينَ يعقدُ حبوةً","جبلٌ تخاشَع في ذُراه الأجبُلُ",5,"ل",1,0],["وَكَأَنَّ شارِبَها أَصابَ لِسانَهُ","مِن داءِ خَيبَرَ أَو تِهامَةَ مومُ",6,"م",1,0],["وكان شخص البين لي ماثلا","ابصره كالشبح الهائل",7,"ل",1,0],["وَكَأَنَّ شاهِقَةَ القُصورِ حِيالَهُ","حُجُراتُ طَهَ في الجِنانِ وَآلِهِ",8,"ل",2,0],["وَكانَ شِفاءً صَلبُهُ لَو تَأَلَّفَت","لَهُ جِثَّةٌ يُرضي بِها العَينَ صالِبُه",9,"ب",2,0],["وَكانَ شِفاءُ ما بي في مَحَلٍّ","نُرَدُّ إِلَيهِ أَو زَمَنٍ مُعادِ",10,"د",1,0],["وَكَأَنَّ شاهِرُهُ إِذا اِستَعصى بِهِ","في الرَوعِ يَعصى بِالسِماكِ الأَعزَلِ",11,"ل",1,0],["وكان شِربُهُمُ في صدرِ مجلِسِهِم","شِربَ المُلوكِ وناموا كالمساكينِ",12,"ن",1,0],["وَكَأَنَّ شَيئاً لَم تَنَل","هُ العَينُ ساعَةَ يُفقَدُ",13,"د",1,0],["وَكَأَنَّ شارِبَها لِفَرطِ شُعاعِها","بِاللَيلِ يَكرَعُ في سَنا مِقباسِ",14,"س",1,0],["وَكَأَنَّ شارِبَها لِطيبِ نَسيمِها","وافَت مَشارِبُهُ سَحابُ قَرَنفُلِ",15,"ل",1,0],["وكأن شخصك فيهِ قلب ساكن","وعليهِ مرصوف الحجار ضلوع",16,"ع",1,0],["وكان شبابيَ صَمْتَ القفارِ","ورَجْعَ الهواتفِ من جِنِّها",17,"ه",2,0],["وَكَأَنَّ شُرْفَتَهُ مَقَامُ عِبَادَةٍ","نُصِبَ التَّكَبُّرُ فِي ذُرَاهُ مِثَالاَ",18,"ل",2,0],["وكانَ \" شكسبيرٌ \" خويدمَ شعره","وكانت لُغى الأكوان تخدمُه نثرا",19,"ر",2,0],["وكان شفاءً لي لو أن طُلولَهم","خُلقنَ ركابا والركابَ طلولُ",20,"ل",1,0],["وكأن شبابي في الحقيقة سكرةً","فلما انقضى أصبحتُ أَلتزمُ الصَّحوا",21,"و",2,0],["وكانَ شبابي عقدَ زَهرٍ نظمتُه","فنثَّرتِ الأحزانُ زَهري على الحبل",22,"ل",1,0],["وكأنَّ شوقي حين لا","يشفي بصدري نار ضغن",23,"ن",1,0],["وَكأنّ شمسَ الفضلِ لم تكُ أشرقت","إذ عمّ للأحزانِ ليلٌ أسفعُ",24,"ع",1,0],["وَكَأَنَّ شَفرَةَ خَطمِهِ وَجَبينِهِ","لَمّا تَشَرَّفَ صُلَّبٌ مَفلوقُ",25,"ق",1,0],["وَكَان شَفِيعَنَا عِندَ اللَّيَالِي","رَجَاؤُكُمُ فَيَا نِعمَ الشَّفِيعُ",26,"ع",1,0],["وكَانَ شَوقِي إلَى تَحِيَّتِهِ","شَوقَ رِيَاضِ الرُّبَى ِإلَى مَطَرِه",27,"ر",2,0],["وكان شهياَ ليلقى المنايا","على حبه للاله العلي",28,"ي",1,0],["وكأنَّ شمس الدَّجن بين الحجب","والإسفار وجهٌ شفَّ تحت نصيفِ",29,"ف",1,0],["وكأنَّ شادينا يهزّ قوامهُ","ثملٌ وليس بشاربٍ من مسكر",30,"ر",1,0],["وكان شعري كجيش","يساق بحرا وبرا",31,"ر",2,0],["وكانَ شَيْخي من الأَوتادِ منزلَةً","وفي أُولي العلمِ فذًّا مثلَ يُعْسوبِ",32,"ب",1,0],["وَكَأنّ شيئاً مُحزناً","لك لم يُصبْكَ إذا صبرتا",33,"ت",2,0]]}