{"poems":[[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[0,"لمن الديار غشيتها بِسحام","https://www.aldiwan.net/poem64.html",""],[95,"طفيء الصباح بعيني الإلهام","https://www.aldiwan.net/poem11359.html","الكامل"],[56,"أهلا وسهلا بالمشيب","https://www.aldiwan.net/poem27622.html","الكامل"],[53,"يا أيها النفر الذين تعجبوا","https://www.aldiwan.net/poem65464.html","الكامل"],[53,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[31,"صرمت أمامة حبلها ورعوم","https://www.aldiwan.net/poem6063.html","الكامل"],[91,"وقفت عند الحدث النازل","https://www.aldiwan.net/poem44899.html","السريع"],[87,"الملك بين يديك في إقباله","https://www.aldiwan.net/poem63756.html","الكامل"],[47,"مع الدهر ظلم ليس يقلع راتبه","https://www.aldiwan.net/poem10905.html","الطويل"],[47,"أما وهواك حلفة ذي اجتهاد","https://www.aldiwan.net/poem63502.html","الوافر"],[47,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[63,"عصى الرشاد فقد ناداه من حين","https://www.aldiwan.net/poem51409.html","البسيط"],[51,"أأخي لا تنس القبور","https://www.aldiwan.net/poem64150.html","مجزوء الكامل"],[50,"كيف النزوع عن الصبا والكاس","https://www.aldiwan.net/poem63424.html","الطويل"],[50,"نزه صبوحك عن مقال العذل","https://www.aldiwan.net/poem64500.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85441","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[92,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[146,"تظن فراقا أن تثار حمول","https://www.aldiwan.net/poem58376.html","الطويل"],[255,"وصلت على إنفاق عمري تأسفي","https://www.aldiwan.net/poem15080.html","الطويل"],[275,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[303,"يا ليتني لما شرب","https://www.aldiwan.net/poem36797.html","عموديه"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[342,"يأوي إذا كشحت إلى أطبائها","https://www.aldiwan.net/poem45302.html","الكامل"],[362,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[362,"يا أهل تدمير إن جاركم","https://www.aldiwan.net/poem4169.html","المنسرح"],[447,"عزاء فما كل حي بحي","https://www.aldiwan.net/poem14493.html","المتقارب"],[469,"شغفي بأعطاف الغصون الهيف","https://www.aldiwan.net/poem3453.html","عموديه"],[469,"أو ما ترى وجه السماء معبساً","https://www.aldiwan.net/poem3547.html","عموديه"],[484,"ما للقريض تعاصى","https://www.aldiwan.net/poem36906.html","المجتث"],[505,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[556,"لا تفخرن إلا بنفسك","https://www.aldiwan.net/poem48032.html","مجزوء الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122605","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48850","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63817","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38412","البسيط"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/74019","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109075","الوافر"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44876","الكامل"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103209","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114771","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53159","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27809","المجتث"],[2230,"","https://poetry.dctabudhabi.ae/diwan/poem/101791","الطويل"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123643","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93635","الكامل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137150",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75859","الوافر"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127403","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204855","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205007","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112687","الرجز"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139917","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138713",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86563","الكامل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78339","البسيط"],[4693,"اهداء الى خادم الحرمين","https://www.poetsgate.com/ViewPoem.aspx?id=33403",""],[4755,"كقصيدة كالضرب بالفأس","https://www.poetsgate.com/ViewPoem.aspx?id=183593",""],[5121,"الودُّ","https://www.poetsgate.com/ViewPoem.aspx?id=215579",""],[5145,"رقدت ودهرك لا يرقد","https://www.poetsgate.com/ViewPoem.aspx?id=108069",""],[5302,"ما أعذب العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200599",""],[5338,"جفني لفقدك سهده فرض","https://www.poetsgate.com/ViewPoem.aspx?id=187597",""],[5338,"مديحك ما يزان به الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=187945",""],[5376,"قولوا لها .....يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=188269",""],[5431,"سأعوم في لُجج الطويل وأُطرِبُ","https://www.poetsgate.com/ViewPoem.aspx?id=192267",""],[5561,"أمّةُ الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=192741",""],[5616,"عدنا","https://www.poetsgate.com/ViewPoem.aspx?id=203479",""],[5770,"إلى صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178681",""],[402,"سجدوا لكسرى إذ بدا إجلالا","https://www.poetsgate.com/ViewPoem.aspx?id=36216",""],[5829,"الهاتفة","https://www.poetsgate.com/ViewPoem.aspx?id=152689",""],[5909,"شوقٌ إذا حل المساءُ كففته","https://www.poetsgate.com/ViewPoem.aspx?id=210235",""],[5956,"‏ رثاء حب الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=182240",""],[5956,"مرحلة مُمْتِعة معَ عِرْق السُّوس","https://www.poetsgate.com/ViewPoem.aspx?id=184840",""],[6160,"ما لمْ يقلهُ أبو الطَّيب ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87102&r=&rc=19",""],[6318,"الفجر الدامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66161&r=&rc=11",""]],"verses":[["وَكانَ شَيءٌ إِلى شَيءٍ فَفَرَّقَهُ","دَهرٌ يَعودُ عَلى تَشتيتِ ما جَمَعا",0,"ع",2,0],["وَكَأَنَّ شارِبَها أَصابَ لِسانَهُ","مومٌ يُخالِطُ جِسمَهُ بِسَقامِ",1,"م",1,0],["وَكَأَنَّ شَمْسَ العَبْقَرِيَّةِ كُفِّنَتْ","بَعْدَ ازْدِهَارِ شُعَاعِهَا بِقَتَامِ",2,"م",1,0],["وَكَأَنَّ شَيبي نَظمُ دُرٍّ زاهِرٍ","في تاجِ ذي مُلكٍ أَغَرَّ مُتَوَّجِ",3,"ج",1,0],["وكأن شيب عجانه حول استه","بدد الخليط على جوانب معلف",4,"ف",1,0],["وكأن شخصَك حينَ يعقدُ حبوةً","جبلٌ تخاشَع في ذُراه الأجبُلُ",5,"ل",1,0],["وَكَأَنَّ شارِبَها أَصابَ لِسانَهُ","مِن داءِ خَيبَرَ أَو تِهامَةَ مومُ",6,"م",1,0],["وكان شخص البين لي ماثلا","ابصره كالشبح الهائل",7,"ل",1,0],["وَكَأَنَّ شاهِقَةَ القُصورِ حِيالَهُ","حُجُراتُ طَهَ في الجِنانِ وَآلِهِ",8,"ل",2,0],["وَكانَ شِفاءً صَلبُهُ لَو تَأَلَّفَت","لَهُ جِثَّةٌ يُرضي بِها العَينَ صالِبُه",9,"ب",2,0],["وَكانَ شِفاءُ ما بي في مَحَلٍّ","نُرَدُّ إِلَيهِ أَو زَمَنٍ مُعادِ",10,"د",1,0],["وَكَأَنَّ شاهِرُهُ إِذا اِستَعصى بِهِ","في الرَوعِ يَعصى بِالسِماكِ الأَعزَلِ",11,"ل",1,0],["وكان شِربُهُمُ في صدرِ مجلِسِهِم","شِربَ المُلوكِ وناموا كالمساكينِ",12,"ن",1,0],["وَكَأَنَّ شَيئاً لَم تَنَل","هُ العَينُ ساعَةَ يُفقَدُ",13,"د",1,0],["وَكَأَنَّ شارِبَها لِفَرطِ شُعاعِها","بِاللَيلِ يَكرَعُ في سَنا مِقباسِ",14,"س",1,0],["وَكَأَنَّ شارِبَها لِطيبِ نَسيمِها","وافَت مَشارِبُهُ سَحابُ قَرَنفُلِ",15,"ل",1,0],["وكأن شخصك فيهِ قلب ساكن","وعليهِ مرصوف الحجار ضلوع",16,"ع",1,0],["وكان شبابيَ صَمْتَ القفارِ","ورَجْعَ الهواتفِ من جِنِّها",17,"ه",2,0],["وَكَأَنَّ شُرْفَتَهُ مَقَامُ عِبَادَةٍ","نُصِبَ التَّكَبُّرُ فِي ذُرَاهُ مِثَالاَ",18,"ل",2,0],["وكانَ \" شكسبيرٌ \" خويدمَ شعره","وكانت لُغى الأكوان تخدمُه نثرا",19,"ر",2,0],["وكان شفاءً لي لو أن طُلولَهم","خُلقنَ ركابا والركابَ طلولُ",20,"ل",1,0],["وكأن شبابي في الحقيقة سكرةً","فلما انقضى أصبحتُ أَلتزمُ الصَّحوا",21,"و",2,0],["وكانَ شبابي عقدَ زَهرٍ نظمتُه","فنثَّرتِ الأحزانُ زَهري على الحبل",22,"ل",1,0],["وكأنَّ شوقي حين لا","يشفي بصدري نار ضغن",23,"ن",1,0],["وَكأنّ شمسَ الفضلِ لم تكُ أشرقت","إذ عمّ للأحزانِ ليلٌ أسفعُ",24,"ع",1,0],["وَكَأَنَّ شَفرَةَ خَطمِهِ وَجَبينِهِ","لَمّا تَشَرَّفَ صُلَّبٌ مَفلوقُ",25,"ق",1,0],["وَكَان شَفِيعَنَا عِندَ اللَّيَالِي","رَجَاؤُكُمُ فَيَا نِعمَ الشَّفِيعُ",26,"ع",1,0],["وكَانَ شَوقِي إلَى تَحِيَّتِهِ","شَوقَ رِيَاضِ الرُّبَى ِإلَى مَطَرِه",27,"ر",2,0],["وكان شهياَ ليلقى المنايا","على حبه للاله العلي",28,"ي",1,0],["وكأنَّ شمس الدَّجن بين الحجب","والإسفار وجهٌ شفَّ تحت نصيفِ",29,"ف",1,0],["وكأنَّ شادينا يهزّ قوامهُ","ثملٌ وليس بشاربٍ من مسكر",30,"ر",1,0],["وكان شعري كجيش","يساق بحرا وبرا",31,"ر",2,0],["وكانَ شَيْخي من الأَوتادِ منزلَةً","وفي أُولي العلمِ فذًّا مثلَ يُعْسوبِ",32,"ب",1,0],["وَكَأنّ شيئاً مُحزناً","لك لم يُصبْكَ إذا صبرتا",33,"ت",2,0],["وكأنَّ شأنُهمُ وشَأنُك في الذي","أعطيتَه في النَّصرِ والتَّأييد",34,"د",1,0],["وكان شفائي أن أراهم مسلماً","سلام التلاقي والوادع لحين",35,"ن",1,0],["وكان شعري يُتَغَنَّى به","فاسْتُحْسِنَتْ للنوحِ أَشعاري",36,"ر",2,0],["وَكانَ شبلَ العُلى يُدعى اِبنَ بَجدَتِها","وَكانَ بِالمَجدِ فيها خَير مُحتَضنِ",37,"ن",1,0],["وكان شعاري اذ اتى شعاره","كعادتنا في اليقظة الذل والزهوا",38,"و",2,0],["وكان شعاعها يطفى ويحكي","غروب الشمس أو ود النساء",39,"ا",2,0],["وَكَأَنَّ شَكلَ الغَيمِ مُنخُلُ فِضَّةٍ","يُلقِي عَلى الآفاقِ رَطبَ الجَوهَرِ",40,"ر",1,0],["وَكانَ شِفاءً غيرَ داءٍ دُنُوُّهُ","إذا احوَلَّ أَبصارُ العُيونِ اللَوامِحُ",41,"ح",1,0],["وكأَنَّ شَخصك في الضّمير سريرةٌ","أَو مُنيَةٌ تأبى على المتصوِّرِ",42,"ر",1,0],["وكان شملي بهمُ مجتمعاً","حتى سعى وشاتنا ففرَّقوا",43,"ق",3,0],["وكان شخصاً كريماً","من الأناسي سويا",44,"ي",2,0],["وكأن شهود العقد سكان عرشه","وكانت جنان الخلد منه لها مهرا",45,"ر",2,0],["وكان شمساً بها لما يحل منى","أيام تشريقها أشراقهن جلى",46,"ل",2,0],["وَكَأَن شُعلة خَده بِلسانها","أَمرت قُلوب العاشقين أَلا أَقبسي",47,"س",2,0],["وكان شاعراً رقيق الحاشيه","أشعارهُ بين الأنام فاشيه",48,"ه",1,0],["وكأن شعرك يا ابن عيسى لؤلؤ","ومسامع الدنيا له اصداف",49,"ف",1,0],["وَكانَ شِفاءَ نَفسي أَن تَراه","يَزور فَعزَّ وُجدانُ الشفاءِ",50,"ف",3,0],["وكان شيطان شعري لا يطاوعني","ولا يجود بشيء غير آهات",51,"ت",1,0],["وكان شهياً كأحلى الثمار","ومن ذاقه قال: هذا العسل",52,"ل",1,0],["وكأن شهب الأفق إن جن الدّجى","نزلت بعاصيها الجميل تسير",53,"ر",1,0],["وكان شهماً صابراً حليما","وسيداً ومصلحاً عظيما",54,"م",2,0],["وكأنّ شهبَ الرجم بعضُ حليِّها","عثرتْ به من شرعةٍ فتكسرا",55,"ر",2,0],["وكأن شمراً منه ينحر","منحراً في حد صارم",56,"م",1,0],["وكأن شكل الجلنار إذا بدا","للناظرين مدوراً ومجوفا",57,"ف",2,1],["وَكانَ شُغلي خُضوعي زِلتي اِسفى","وَوَضع خدي عَلى اِرض المَذَلّات",58,"ت",1,0],["وكان شرع اله الكون منهجه","وأبدل الظلم بالإحسان والكرم",59,"م",1,0],["وكَأنَّ شَيئًا ما على وتري","يَبكِي بُكاءَ الصَّبرِ لِليَأسِ",60,"س",1,0],["وَكَأَنَّ شَمْسَكَ كُلَّمَا لَوَّنْتَها","رَسَمَتْ بِأَلْوَانِ الْفَضَا مَا يَشْرُقُ",61,"ق",1,0],["وكان شهاباً لدين الإله","من العلم أنواره ترصد",62,"د",1,0],["وكان شمسا على كوني وكان لي ال","بدر المنير يجلي حالك السدف",63,"ف",1,0],["وَكَأَنَّ َشِرْعَةَ أَحْمَدٍ نَزَلَتْ","وَشِعَارُهَا الشَّحْنَاءُ وَالْبُغْضُ",64,"ض",1,0],["وَكَانَ شِعَارُهُمْ دَفْنًا وَدَفْنًا","لِذِكْرِكَ فَاسْتَهَلَّ بِكَ الزَّمَانُ(١٠)",65,"ن",1,0],["وكأنَّ شاماً لم يكنْ كجمالها","والطيرُ تنشرُ في العلا أسرابَها",66,"ب",3,0],["وكأنّ شعريَ في هواك مداده","هطلٌ بقلب سحابة لاتُحجبُ",67,"ب",1,0],["وكأنّ شمسي في أُفولٍ دائمٍ","غامتْ بكونٍ مُدلجٍ ببلاءِ",68,"ا",2,0],["وكان شعري لا ساق ولا ورق","حتى بزغتم فشبّ الساق والورق",69,"ق",1,0],["وكان شفيقُ صديقي الأثير","وضيّعتهُ في دروب الحياهْ",70,"ا",2,1],["وكأن شرفته مقام عبادة","نصب التكبر في ذاره مثالا",71,"ل",2,0],["وكأن شيئا شدني","ما بين ضلّ واهتدا",72,"د",2,0],["وكأن شيئاً من حياةٍ لم تزل","تتكنَّفُ العُشّاقَ وهي سرابُ",73,"ب",1,0],["وكأنَّ شكلَ الورد بعد ذبوله","أطلالُ عهد بالسعادة عارمِ",74,"م",1,0],["وكان شقيقي غاضباً من غيابنا","تُجَابِهُنا لمَّا نعودُ الصَّوافعُ",75,"ع",1,0],["وكان شعري إلى حتفي يسابقني","والشَّمسُ من ظلِّها تدنو وتنحَرفُ",76,"ف",1,0],["وكأَنَّ شقشقَة الطيور ِ نَدَاوَةٌ","رفَّتْ وتسْبيحُ الرُّبى والأوهُدِ",77,"د",1,0],["وكأَنَّ شقشقَة الزهور تظلَّ تَسْ","أَلُ ما يُخبَّأُ يا مَرابعُ في غدِ",77,"د",1,0]]}