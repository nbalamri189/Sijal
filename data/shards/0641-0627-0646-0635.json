oetry.dctabudhabi.ae/diwan/poem/131003","الرجز"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96085","البسيط"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67482","السريع"],[4679,"ذو الحزم يسمو والمهيمن ينصر","https://www.poetsgate.com/ViewPoem.aspx?id=142728",""],[4690,"مَا ضَلَّ رَكْبٌ هَدْيُهُ السَمْحاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=120306",""],[4691,"إذا مر شعري عليك تذكر","https://www.poetsgate.com/ViewPoem.aspx?id=61413",""],[4709,"رحلة الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=214833",""],[4830,"شعرُ صبابتي","https://www.poetsgate.com/ViewPoem.aspx?id=209132",""],[4856,"رحيلٌ مؤقت","https://www.poetsgate.com/ViewPoem.aspx?id=36269",""],[4858,"في ذكرى الإسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=29825",""],[4858,"طريق العودة","https://www.poetsgate.com/ViewPoem.aspx?id=35235",""],[4858,"صبراً أحبتنا","https://www.poetsgate.com/ViewPoem.aspx?id=35641",""],[4908,"ضياع وشتاء","https://www.poetsgate.com/ViewPoem.aspx?id=207329",""],[182,"معْ سَبْق الشَتات والتشظّي ،،،","https://www.poetsgate.com/ViewPoem.aspx?id=72800",""],[4983,"حديث في الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=11014",""],[4984,"المدار","https://www.poetsgate.com/ViewPoem.aspx?id=176018",""],[5022,"بورما المضطهدة","https://www.poetsgate.com/ViewPoem.aspx?id=200677",""],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[5092,"من هناك إلى هنا","https://www.poetsgate.com/ViewPoem.aspx?id=178240",""],[5121,"الْمِنْهَاجُ","https://www.poetsgate.com/ViewPoem.aspx?id=34716",""],[5206,"حب غير الله","https://www.poetsgate.com/ViewPoem.aspx?id=187395",""],[5302,"اسم الذي أهواه","https://www.poetsgate.com/ViewPoem.aspx?id=200945",""],[5320,"إلى رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=40398",""],[592,"على قلة الداعي وقلة ذي الفهم","https://www.poetsgate.com/ViewPoem.aspx?id=128814",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5397,"أبسفح حاجر منك يسفح محجر","https://www.poetsgate.com/ViewPoem.aspx?id=157963",""],[5413,"فما بالُه يزدادُ!","https://www.poetsgate.com/ViewPoem.aspx?id=201571",""],[5413,"أحد عشر كوكبا","https://www.poetsgate.com/ViewPoem.aspx?id=208597",""],[5570,"إن أفارقهم فقد عشت دهرا","https://www.poetsgate.com/ViewPoem.aspx?id=186734",""],[5596,"كل برقٍ سيتلو رعده ديٓم","https://www.poetsgate.com/ViewPoem.aspx?id=205595",""],[5660,"وَ كَم تَنَدَّرَ بِالعُقَلاءِ مِن خَبِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=29466",""],[5784,"وهم الصغار","https://www.poetsgate.com/ViewPoem.aspx?id=198886",""],[5790,"أخنساء ما قلب المتيم من صخرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=111918",""],[5804,"الجليس السيّء","https://www.poetsgate.com/ViewPoem.aspx?id=180100",""],[5881,"لهب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=183864",""],[5943,"ومحمد روحي فداهُ","https://www.poetsgate.com/ViewPoem.aspx?id=11707",""],[5956,"قبرُ شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=183885",""],[5956,"ما منعوا الجروح تصيب غزةْ","https://www.poetsgate.com/ViewPoem.aspx?id=202514",""],[5957,"أحبكَ أكثر مما مضى","https://www.poetsgate.com/ViewPoem.aspx?id=119167",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6068,"إذا ذكر الأحباب آضت تهزّني -24-","https://www.poetsgate.com/ViewPoem.aspx?id=175862",""],[6142,"بكر الردى فاجتاح في نكبائه","https://www.poetsgate.com/ViewPoem.aspx?id=155755",""],[6142,"عهدي بربعهم أغن المعهد","https://www.poetsgate.com/ViewPoem.aspx?id=155758",""],[5309,"ما علمهم غير تعريب وتقليد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573891",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[6237,"وجدتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77898&r=&rc=40",""]],"verses":[["فَأَنصُبُ فَوقَ هامِهِمُ قُدوري","وَأَمزُجُ مِن دِمائِهِم شَرابي",0,"ب",2,0],["فانْصاعَ يَتْبَعُهُ قَلبٌ لهُ شَجَنٌ","وضاعَ منْ بَعْدِهِ جِسمٌ بهِ سَقَمُ",1,"م",1,0],["فانْصُروني وعيِّنوا لي رَسولاً","صارِمَ الحدِّ مُحْكَمَ التّدْبيرِ",2,"ر",1,0],["فَإِنْ صَحَّ مِنْكَ الْحَظُّ طَاوَعَتِ الْمُنَى","وَيَبْعُدُ مَرْمَى السَّهْم وَهْوَ مُصِيبُ",3,"ب",1,0],["فَاِنصاعَ لا يَأتَلي شَدّاً بِخَذرَفَةٍ","تَرى لَهُ مِن يَقينِ الخَوفِ إِهذابا",4,"ب",2,0],["فَاِنصَرَفَت فاقِداً ثَكلى عَلى حَزَنٍ","كُلٌّ دَهاها وَكُلٌّ عِندَها اِجتَمَعا",5,"ع",2,0],["فَإِن صادَقتَهُم صَدَقوكَ وُدّاً","وَلَيسَ لَهُم إِذا فَتَّشتَ مِثلُ",6,"ل",1,0],["فَانْصَرَفَ الْقَوْمُ وَبَاتُوا وَهُمْ","بِمَا بِهِ الشَّاعِرُ أَوْصَى قِيَامْ",7,"م",1,0],["فَأَنْصِفُوهَا يَا قَوْمُ تَنْتَصِفُوا","وَأَخْلِصُوا رَأْيكُمْ مِنْ الوَهَمِ",8,"م",1,0],["فَاِنصاعَتِ الحُقبُ لَم تَقصَع صَرائِرِها","وَقَد نَشَحنَ فَلا رِيٌّ وَلا هيمُ",9,"م",1,0],["فَاِنصاعَ جانِبَه الوَحشِيَّ وَاِنكَدَرَت","يَلحَبنَ لا يَأتَلي المَطلوبُ وَالطَلَبُ",10,"ب",1,0],["فأنصفوا منه أخا حرمةٍ","لاذ بكم منه مع اللائذِ",11,"ذ",1,0],["فانصرفت نحوها الضمائر وال","أبصار يُعنِقن أيَّما عنق",12,"ق",1,0],["فانصاع جمعُ المارقي","ن كأنَّهُم نَعَمٌ تُشَلُّ",13,"ل",1,0],["فانصرفت مكروبةً شنطفٌ","تساجلُ الدمعَ المثاكيلا",14,"ل",2,0],["فانْصِرَافاً عن الوقوفِ عليها","إنها من مواقِفِ الضُّلّالِ",15,"ل",1,0],["فانصرف عني حسيراً خاسئاً","شجني فيهم وللناس شجن",16,"ن",1,0],["فَاِنصَعنَ كَالطَيرِ يَحدوهُنَّ ذو زَجَلٍ","كَأَنَّهُ في تَواليهِنَّ مَشكولُ",17,"ل",1,0],["فَاِنصاعَ كَالكَوكَبِ الدُرِيِّ جَرَّدَهُ","غَيثٌ تَقَشَّعَ عَنهُ طالَما هَطَلا",18,"ل",2,0],["فَاِنصاعَ كَالكَوكَبِ الدُرّيءِ مَيعَتُهُ","غَضبانَ يَخلِطُ مِن مَعجٍ وَإِحضارِ",19,"ر",1,0],["فَاِنصاعَ كَالمِصباحِ يَطفو مَرَّةً","وَيَلوحُ وَهوَ مُثابِرٌ مَدهومُ",20,"م",1,0],["فَاِنصاعَ مُنهَزِماً وَهُنَّ لَواحِقٌ","وَالشاةُ يَبتَذِلُ القَوائِمَ يُحضِرُ",21,"ر",1,0],["فَاِنصَعنَ أَسرَعَ مِن طَيرٍ مُغاوِلَةٍ","تَهوي إِلى لابَةٍ مِن كاسِرٍ خَدِرِ",22,"ر",1,0],["فَإِن صَبَرنا فَإِنَّنا صُبُرٌ","وَإِن بَكَينا فَغَيرُ مَردودِ",23,"د",1,0],["فإن صح قولك ذا لا برحت","إلا وجسمي إليك ثقيلُ",24,"ل",1,0],["فإن صبرتَ على تحميره بحِمى","نار لطيف بلا حرق ولا ضجر",25,"ر",1,0],["فَاِنصاعَ يَطلُبُ ظِلَّهُ","وَالخَيلُ غادِيَةٌ تَكُدُّه",26,"د",2,0],["فَإِن صَدَّ عَن إِنجازِهِ المَنعُ فَاِنعِموا","بَعُذرٍ فَإِنَّ العُذرَ أَسوى مِنَ الغَدرِ",27,"ر",1,0],["فانْصَبّتِ الأرْزَاقُ بعد جُمودِها","وأضاءَتِ الآفاقُ بعدَ ظلامِ",28,"م",1,0],["فَانصُرْ وافخَرْ وأدِرْ وأشِرْ","وَأَبِرْ وأَجِرْ وأَغِرْ وَسُدِ",29,"د",1,0],["فإنْ صدقتُ وإلا","فكذبيني بواحدْ",30,"د",1,0],["فَاِنصاعَ يَضحَكُ وَجهُهُ مِن غُرَّةٍ","سالَت وَيَلعَبُ في العِنانِ مِراحا",31,"ح",2,0],["فأنْصِفْ مصر وَاعْصِ القومَ فيها","إذا اطّردَ الحديثُ وهم شُهودُ",32,"د",1,0],["فانصبَّ نورٌ وطيبٌ","على القلوب انصبابا",33,"ب",2,0],["فَاِنصاعَ يَطرُدُها وَيَح","مِلُها عَلى غَيبِ المَحامِل",34,"ل",1,0],["فَاِنصَرَفَت وَالدُمُوعُ تَسكُبُ مِن","إِنسانِ عَينٍ مَحزُونَةٍ كُحُلا",35,"ل",2,0],["فَإِن صادَفتَ مِنّي غَف","لَةً عَنكَ تَغافَلتا",36,"ت",2,0],["فَاِنصاعَ كَالأَجدَلِ في اِنصِبابِهِ","أَو كَالحَريقِ في هَشيمِ غابِهِ",37,"ب",2,0],["فَاِنصاعَ مُرقَدّاً عَلى مُرقَدِّهِ","كَأَنَّهُ حينَ اِنفَرى في شَدِّهِ",38,"د",2,0],["فَاِنصاعَ كَالكَوكَبِ في اِنحِدارِهِ","لَفتَ المُشيرِ مَوهِناً بِنارِهِ",39,"ر",2,0],["فَاِنصَدَعوا وِجهَةً كَأَنَّهُمُ","جُناةُ شَرٍّ يُنفَونَ بِالبوقِ",40,"ق",1,0],["فَاِنصَدَعَت عَن راكِبٍ مُجِدِّ","وَرّادِ أَمواهٍ كَماءِ السِخدِ",41,"د",1,0],["فَاِنصاعَ مِن حَذَرٍ عَلى حَوبائِهِ","وَتَبِعنَهُ يَنسَبنَ في مُنسابِهِ",42,"ب",2,0],["فَاِنصَرَفوا وَالبَلاءُ باقٍ","وَلَم يَزُل داؤُكِ العَياءُ",43,"ي",3,0],["فَإِن صَدَقُوا قَالُوا جَوادٌ مُجَرَّبٌ","ضَلِيعٌ وَمِن خَيرٍ الجيِادِ ضَلِيعُها",44,"ه",2,1],["فَإِنَّ صَخرَتَنا أَعيَت أَباكَ فَلا","يَألُو لَها ما استَطاعَ الدَهرَ إِخبالا",45,"ل",2,0],["فانصرفَ الأميرُ من غَزاتِهِ","وقد شَفاهُ اللَّهُ من عُداتهِ",46,"ه",1,0],["فإنْ صَلَحَتْ للناظِمينَ دُموعُنا","فأنْتُنّ منها والكَثيبُ حَوال",47,"ل",1,0],["فانصدعتْ طائفتين البصرهْ","فريقُ خَذْلٍ وفريقُ نُصْرَهْ",48,"ه",1,0],["فانْصَرفا مِثْلَ انْصِرافِ الفَتَى","أَسْلَمَ إِلْفاً ليَدِ البَينِ",49,"ن",1,0],["فَإِنْ صُلْتُ فَدَّانِي الْكَ