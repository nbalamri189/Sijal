{"poems":[[53,"إلى كم لا تلين على العتاب","https://www.aldiwan.net/poem30701.html","الوافر"],[63,"نأى بجانبه والصبح مبتسم","https://www.aldiwan.net/poem46133.html","البسيط"],[77,"يا بني السادة الكرام نداء","https://www.aldiwan.net/poem36499.html","الخفيف"],[77,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[9,"بانت سعاد وأمسى حبلها رابا","https://www.aldiwan.net/poem21909.html","البسيط"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[86,"هنيئا أيها الملك الأجل","https://www.aldiwan.net/poem68929.html","الوافر"],[93,"يا حسنها حين تجلت على","https://www.aldiwan.net/poem11300.html","السريع"],[93,"علمتنا بالمثال والقلم","https://www.aldiwan.net/poem11355.html","المنسرح"],[30,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[51,"هذا مقام يا بني وائل","https://www.aldiwan.net/poem61985.html","السريع"],[51,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[51,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[51,"إذا تغنت شنطف مرة","https://www.aldiwan.net/poem65930.html","السريع"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[29,"بانت سعاد ففي العينين ملمول","https://www.aldiwan.net/poem6024.html","البسيط"],[29,"هل تعرف اليوم من ماوية الطللا","https://www.aldiwan.net/poem6034.html","البسيط"],[29,"تغير الرسم من سلمى بأحفار","https://www.aldiwan.net/poem6035.html","البسيط"],[29,"صرمت أمامة حبلها ورعوم","https://www.aldiwan.net/poem6063.html","الكامل"],[29,"بينا يجول بها عرته ليلة","https://www.aldiwan.net/poem6161.html","الكامل"],[38,"يا أهل ما بال هذا الليل في صفر","https://www.aldiwan.net/poem7718.html","البسيط"],[43,"ما سدكت علة بمورود","https://www.aldiwan.net/poem9527.html","المنسرح"],[62,"جرى بين هرمس والشمس في","https://www.aldiwan.net/poem52164.html","المتقارب"],[62,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[45,"نفسي الفداء لمن أوده","https://www.aldiwan.net/poem63470.html","مجزوء الكامل"],[66,"وعصر الرضا إني لديك لفي خسر","https://www.aldiwan.net/poem38739.html","الطويل"],[80,"وفدت عليك سعادة الأعوام","https://www.aldiwan.net/poem31285.html","الكامل"],[80,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[69,"يا هند ما في زماني","https://www.aldiwan.net/poem28189.html","المجتث"],[74,"ركضوا الجياد إلى الجلاد صباحا","https://www.aldiwan.net/poem12884.html","الكامل"],[105,"أتسأل مصر ما حمل العميد","https://www.aldiwan.net/poem42123.html","الوافر"],[102,"حسبت أن الشبابا","https://www.aldiwan.net/poem33070.html","المجتث"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[40,"رد الخليط الجمال فانتقلا","https://www.aldiwan.net/poem42312.html","المنسرح"],[52,"تضمنت لي الحاج","https://www.aldiwan.net/poem27199.html","الهزج"],[48,"قد أغتدي والليل في إهابه","https://www.aldiwan.net/poem62456.html","الرجز"],[48,"لما طوى الليل حواشي برده","https://www.aldiwan.net/poem63252.html","الرجز"],[48,"لما غدا الثعلب من وجاره","https://www.aldiwan.net/poem63408.html","الطويل"],[48,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[50,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[46,"قد حجب النور والضياء","https://www.aldiwan.net/poem22000.html","مجزوء البسيط"],[8,"فإن صدقوا قالوا جواد مجرب","https://www.aldiwan.net/poem21804.html","الطويل"],[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30499","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42573","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142022","الهزج"],[9,"باتتْ سعادُ وأمسى حبلها رابا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17255&r=&rc=2",""],[88,"علام حرمنا منذ حين تلاقيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19520&r=&rc=23",""],[134,"قل لعبد العزى أخي وشقيقي","https://www.aldiwan.net/poem21041.html","الخفيف"],[147,"يا رب يا رب يا رب الأنام ومن","https://www.aldiwan.net/poem47639.html","البسيط"],[160,"رضيتك مولاتي وارضيتني عبدا","https://www.aldiwan.net/poem58680.html","الطويل"],[160,"قلب على جمر الغضا يتقلب","https://www.aldiwan.net/poem58807.html","الكامل"],[160,"أتخشى بأن يغشى صوارمه الظما","https://www.aldiwan.net/poem58941.html","الطويل"],[169,"أمن دمنة بين اللوى والدكادك","https://www.aldiwan.net/poem1642.html",""],[169,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[174,"لو أن ذا حسب نال السماء به","https://www.aldiwan.net/poem46073.html","البسيط"],[186,"أقول لمنكر يغتاظ مما","https://www.aldiwan.net/poem43235.html","الوافر"],[195,"نزع الفؤاد عن البطالة والصبا","https://www.aldiwan.net/poem54411.html","الكامل"],[204,"خاطرت بالنفس في بحر الهوى فعسى","https://www.aldiwan.net/poem53081.html","البسيط"],[235,"أبو علي قد تجافاني","https://www.aldiwan.net/poem31638.html","السريع"],[235,"الدست من لألاء وجهك مشرق","https://www.aldiwan.net/poem31812.html","الكامل"],[235,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[249,"أحق ما رأيت أم احتلام","https://www.aldiwan.net/poem2096.html","الوافر"],[260,"خليلي لا تستعجلا أن تزودا","https://www.aldiwan.net/poem1103.html",""],[287,"أصرمت حبل الوصل من فتر","https://www.aldiwan.net/poem1918.html","أحذ الكامل"],[294,"سقى الله قبرا كنت روضة عيشه","https://www.aldiwan.net/poem1749.html","الطويل"],[318,"تدار لي الدنيا بل السبعة العلى","https://www.aldiwan.net/poem62620.html","الطويل"],[364,"يا راحلا بالسعد عن مقلتي","https://www.aldiwan.net/poem60903.html","السريع"],[366,"اقرا الدموع فإنها عنواني","https://www.aldiwan.net/poem17127.html","الكامل"],[366,"يمينك أخت الغيث إن ضلت السحب","https://www.aldiwan.net/poem17163.html","الطويل"],[371,"لا يفجعنك غصن البان إن بانا","https://www.aldiwan.net/poem57003.html","الطويل"],[377,"جلا مذ تجلى أعينا فيك تدمع","https://www.aldiwan.net/poem59341.html","الطويل"],[377,"هذا سلام والصدور رحاب","https://www.aldiwan.net/poem66940.html","الكامل"],[406,"بعثت إليك بطيفها تعليلا","https://www.aldiwan.net/poem50139.html","الطويل"],[432,"ناظر الديوان يحتاج","https://www.aldiwan.net/poem12406.html","مجزوء الرمل"],[432,"لمن رسوم الديار باللبب","https://www.aldiwan.net/poem12466.html","المنسرح"],[441,"عذاب الهوى في قلب من رامه عذب","https://www.aldiwan.net/poem14329.html","الطويل"],[441,"لهذا خلقنا والجديد سيخلق","https://www.aldiwan.net/poem14465.html","الطويل"],[464,"ما نال من وصلكم بعض الذي وجبا","https://www.aldiwan.net/poem3498.html","عموديه"],[468,"أيا من يهاب ومن يتقى","https://www.aldiwan.net/poem59813.html","المتقارب"],[479,"قبر ابن آدم أيا زرته انتدبا","https://www.aldiwan.net/poem36940.html","البسيط"],[479,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[538,"خضوعا ومثلي بالخضوع أخو فخر","https://www.aldiwan.net/poem48153.html","عموديه"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"تظنني قد بت محموما","https://www.aldiwan.net/poem2803.html","السريع"],[587,"ألا أيها الغادي مجداً بنجداً","https://www.aldiwan.net/poem11509.html","عموديه"]],"verses":[["فَأَنصُبُ فَوقَ هامِهِمُ قُدوري","وَأَمزُجُ مِن دِمائِهِم شَرابي",0,"ي",1,0],["فانْصاعَ يَتْبَعُهُ قَلبٌ لهُ شَجَنٌ","وضاعَ منْ بَعْدِهِ جِسمٌ بهِ سَقَمُ",1,"م",1,0],["فانْصُروني وعيِّنوا لي رَسولاً","صارِمَ الحدِّ مُحْكَمَ التّدْبيرِ",2,"ر",1,0],["فَإِنْ صَحَّ مِنْكَ الْحَظُّ طَاوَعَتِ الْمُنَى","وَيَبْعُدُ مَرْمَى السَّهْم وَهْوَ مُصِيبُ",3,"ب",1,0],["فَاِنصاعَ لا يَأتَلي شَدّاً بِخَذرَفَةٍ","تَرى لَهُ مِن يَقينِ الخَوفِ إِهذابا",4,"ب",2,0],["فَاِنصَرَفَت فاقِداً ثَكلى عَلى حَزَنٍ","كُلٌّ دَهاها وَكُلٌّ عِندَها اِجتَمَعا",5,"ع",2,0],["فَإِن صادَقتَهُم صَدَقوكَ وُدّاً","وَلَيسَ لَهُم إِذا فَتَّشتَ مِثلُ",6,"ل",1,0],["فَانْصَرَفَ الْقَوْمُ وَبَاتُوا وَهُمْ","بِمَا بِهِ الشَّاعِرُ أَوْصَى قِيَامْ",7,"م",1,0],["فَأَنْصِفُوهَا يَا قَوْمُ تَنْتَصِفُوا","وَأَخْلِصُوا رَأْيكُمْ مِنْ الوَهَمِ",8,"م",1,0],["فَاِنصاعَتِ الحُقبُ لَم تَقصَع صَرائِرِها","وَقَد نَشَحنَ فَلا رِيٌّ وَلا هيمُ",9,"م",1,0],["فَاِنصاعَ جانِبَه الوَحشِيَّ وَاِنكَدَرَت","يَلحَبنَ لا يَأتَلي المَطلوبُ وَالطَلَبُ",10,"ب",1,0],["فأنصفوا منه أخا حرمةٍ","لاذ بكم منه مع اللائذِ",11,"ذ",1,0],["فانصرفت نحوها الضمائر وال","أبصار يُعنِقن أيَّما عنق",12,"ق",1,0],["فانصاع جمعُ المارقي","ن كأنَّهُم نَعَمٌ تُشَلُّ",13,"ل",1,0],["فانصرفت مكروبةً شنطفٌ","تساجلُ الدمعَ المثاكيلا",14,"ل",2,0],["فانْصِرَافاً عن الوقوفِ عليها","إنها من مواقِفِ الضُّلّالِ",15,"ل",1,0],["فانصرف عني حسيراً خاسئاً","شجني فيهم وللناس شجن",16,"ن",1,0],["فَاِنصَعنَ كَالطَيرِ يَحدوهُنَّ ذو زَجَلٍ","كَأَنَّهُ في تَواليهِنَّ مَشكولُ",17,"ل",1,0],["فَاِنصاعَ كَالكَوكَبِ الدُرِيِّ جَرَّدَهُ","غَيثٌ تَقَشَّعَ عَنهُ طالَما هَطَلا",18,"ل",2,0],["فَاِنصاعَ كَالكَوكَبِ الدُرّيءِ مَيعَتُهُ","غَضبانَ يَخلِطُ مِن مَعجٍ وَإِحضارِ",19,"ر",1,0],["فَاِنصاعَ كَالمِصباحِ يَطفو مَرَّةً","وَيَلوحُ وَهوَ مُثابِرٌ مَدهومُ",20,"م",1,0],["فَاِنصاعَ مُنهَزِماً وَهُنَّ لَواحِقٌ","وَالشاةُ يَبتَذِلُ القَوائِمَ يُحضِرُ",21,"ر",1,0],["فَاِنصَعنَ أَسرَعَ مِن طَيرٍ مُغاوِلَةٍ","تَهوي إِلى لابَةٍ مِن كاسِرٍ خَدِرِ",22,"ر",1,0],["فَإِن صَبَرنا فَإِنَّنا صُبُرٌ","وَإِن بَكَينا فَغَيرُ مَردودِ",23,"د",1,0],["فإن صح قولك ذا لا برحت","إلا وجسمي إليك ثقيلُ",24,"ل",1,0],["فإن صبرتَ على تحميره بحِمى","نار لطيف بلا حرق ولا ضجر",25,"ر",1,0],["فَاِنصاعَ يَطلُبُ ظِلَّهُ","وَالخَيلُ غادِيَةٌ تَكُدُّه",26,"د",2,0],["فَإِن صَدَّ عَن إِنجازِهِ المَنعُ فَاِنعِموا","بَعُذرٍ فَإِنَّ العُذرَ أَسوى مِنَ الغَدرِ",27,"ر",1,0],["فانْصَبّتِ الأرْزَاقُ بعد جُمودِها","وأضاءَتِ الآفاقُ بعدَ ظلامِ",28,"م",1,0],["فَانصُرْ وافخَرْ وأدِرْ وأشِرْ","وَأَبِرْ وأَجِرْ وأَغِرْ وَسُدِ",29,"د",1,0],["فإنْ صدقتُ وإلا","فكذبيني بواحدْ",30,"د",1,0],["فَاِنصاعَ يَضحَكُ وَجهُهُ مِن غُرَّةٍ","سالَت وَيَلعَبُ في العِنانِ مِراحا",31,"ح",2,0],["فأنْصِفْ مصر وَاعْصِ القومَ فيها","إذا اطّردَ الحديثُ وهم شُهودُ",32,"د",1,0],["فانصبَّ نورٌ وطيبٌ","على القلوب انصبابا",33,"ب",2,0],["فَاِنصاعَ يَطرُدُها وَيَح","مِلُها عَلى غَيبِ المَحامِل",34,"ل",1,0],["فَاِنصَرَفَت وَالدُمُوعُ تَسكُبُ مِن","إِنسانِ عَينٍ مَحزُونَةٍ كُحُلا",35,"ل",2,0],["فَإِن صادَفتَ مِنّي غَف","لَةً عَنكَ تَغافَلتا",36,"ت",2,0],["فَاِنصاعَ كَالأَجدَلِ في اِنصِبابِهِ","أَو كَالحَريقِ في هَشيمِ غابِهِ",37,"ب",2,0],["فَاِنصاعَ مُرقَدّاً عَلى مُرقَدِّهِ","كَأَنَّهُ حينَ اِنفَرى في شَدِّهِ",38,"د",2,0],["فَاِنصاعَ كَالكَوكَبِ في اِنحِدارِهِ","لَفتَ المُشيرِ مَوهِناً بِنارِهِ",39,"ر",2,0],["فَاِنصَدَعوا وِجهَةً كَأَنَّهُمُ","جُناةُ شَرٍّ يُنفَونَ بِالبوقِ",40,"ق",1,0],["فَاِنصَدَعَت عَن راكِبٍ مُجِدِّ","وَرّادِ أَمواهٍ كَماءِ السِخدِ",41,"د",1,0],["فَاِنصاعَ مِن حَذَرٍ عَلى حَوبائِهِ","وَتَبِعنَهُ يَنسَبنَ في مُنسابِهِ",42,"ب",2,0],["فَاِنصَرَفوا وَالبَلاءُ باقٍ","وَلَم يَزُل داؤُكِ العَياءُ",43,"ي",3,0],["فَإِن صَدَقُوا قَالُوا جَوادٌ مُجَرَّبٌ","ضَلِيعٌ وَمِن خَيرٍ الجيِادِ ضَلِيعُها",44,"ه",2,1],["فَإِنَّ صَخرَتَنا أَعيَت أَباكَ فَلا","يَألُو لَها ما استَطاعَ الدَهرَ إِخبالا",45,"ل",2,0],["فانصرفَ الأميرُ من غَزاتِهِ","وقد شَفاهُ اللَّهُ من عُداتهِ",46,"ه",1,0],["فإنْ صَلَحَتْ للناظِمينَ دُموعُنا","فأنْتُنّ منها والكَثيبُ حَوال",47,"ل",1,0],["فانصدعتْ طائفتين البصرهْ","فريقُ خَذْلٍ وفريقُ نُصْرَهْ",48,"ه",1,0],["فانْصَرفا مِثْلَ انْصِرافِ الفَتَى","أَسْلَمَ إِلْفاً ليَدِ البَينِ",49,"ن",1,0],["فَإِنْ صُلْتُ فَدَّانِي الْكَمِيُّ بِنَفْسِهِ","وَإِنْ قُلْتُ لَبَّانِي الْوَلِيدُ مِنَ الْمَهْدِ",50,"د",1,0],["فإن صح الذي قالوا","أيرضى العدل ذا الفرقا",51,"ق",2,0],["فانصاعَ لا يأتلي شداً بخذرفة ٍ،","إذا نَحَا لِكُلاهَا رَوْقَهُ صَابَا",52,"ب",2,0],["فإنّ صريح الرأي ألا تداريا","ورُبّ أخِ أو قرُتُ قلبي بحبه",53,"ه",1,0],["فَاِنصُروهُ لِلرحمِ وَالنَسَبِ الأَد","نى وَكونوا لَهُ يَداً 