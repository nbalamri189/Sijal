{"poems":[[65,"من الطوالع من نجد تظلهم","https://www.aldiwan.net/poem45743.html","البسيط"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[29,"هل رام أم لم يرم ذو السدر فالثلم","https://www.aldiwan.net/poem5990.html","البسيط"],[74,"ألا من لمسلوب الفؤاد رهينه","https://www.aldiwan.net/poem20148.html","الطويل"],[77,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[77,"سرى وجناح الليل أقتم أفتخ","https://www.aldiwan.net/poem69093.html","الطويل"],[48,"إذا قص آثاري الغواة ليحتذوا","https://www.aldiwan.net/poem22878.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[186,"رمس ثواه كريم قوم ماجد","https://www.aldiwan.net/poem66975.html","الكامل"],[275,"حتام تعشق عاجا تحت ديباج","https://www.aldiwan.net/poem35179.html","البسيط"],[309,"مرت لنا بالحمى المأنوس أعياد","https://www.aldiwan.net/poem16841.html","البسيط"],[309,"يا جيرة بالمعهد اليماني","https://www.aldiwan.net/poem16842.html","الرجز"],[509,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[519,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110463","الكامل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216926",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59119","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137855",""],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122059","المتقارب"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122031","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79810","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53066","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27843","المجتث"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93565","الوافر"],[2758,"","https://poetry.dctabudhabi.ae/diwan/poem/31506","المتقارب"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21594","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89006","البسيط"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/133043","المتقارب"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206141","الطويل"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122266","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135636","الرجز"],[5277,"ناموسُ الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=200055",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5732,"ينام منهو مايعرف الهمومي","https://www.poetsgate.com/ViewPoem.aspx?id=177856",""],[5843,"البحرين","https://www.poetsgate.com/ViewPoem.aspx?id=51289",""],[5956,"شعلة الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=182637",""],[231,"الشاعر في وادي الموتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79142&r=&rc=17",""]],"verses":[["مَنِ الطَّوالِعُ مِن نَجدٍ تُظِلُّهُمُ","سُمرُ القَنا أَنِزاراً يَدَّعونَ أَبا",0,"ب",2,1],["مِنَ الطَنابيرِ يَزهى صَوتَهُ ثَمِلٌ","في لَحنِهِ عَن لُغاتِ العُربِ تَعجيمُ",1,"م",1,0],["مِنَ الطَوامِحِ أَبصاراً إِذا خَشَعَت","عَنها ذُرى عَلَمٍ قالوا بَدا عَلَمُ",2,"م",1,0],["من الطالبي كتم الغرام صبابة","وأحسن بمكتوم الغرام مصونه",3,"ن",2,0],["من الطّيرِ إلاّ أنّهُنّ جَوارِحٌ","فليسَ لها إلاّ النفوسُ مَصيد",4,"د",1,0],["من الطالباتِ البرْقَ لا الشأو مُرهَقٌ","ولا العِطف مجنوب ولا الرِّدف أبزخُ",5,"خ",1,0],["مِنَ الطَيرِ أَو نَبتاً بِأَرضٍ مُضِلَّةٍ","وَإِلّا فَظَبيّاً في الظَباءِ حَصيصا",6,"ص",2,0],["من الطّراز العربيّ الأوّل","على الدخيل قطّ لم تعوّل",7,"ل",1,0],["مِن آلِ طاسو مِن أَفاضل مَعشَرٍ","فازوا بِمَجدٍ في الأَنامِ مُكرَّمِ",8,"م",1,0],["من الطواويسِ حسنُ الريشِ أعجبنا","وأزعجَ الصوتُ منها أي إزعاج",9,"ج",1,0],["من آل طه وآل المرتضى ومن الزه","را البتول لقصر المجد قد شادوا",10,"د",3,0],["من آل طه ومن آلا يس","والجانب الغربي وطور سينين",11,"ن",1,0],["من الطعن لا يوذي مزاج عدوه","من الضرب غير الحي لا يتوقع",12,"ع",1,0],["من الطّعنِ يحمي العِرضَ عن جنّةِ النّدى","وللمالِ في سيفِ النّوالِ يُبيدُ",13,"د",1,0],["من آل طاسو غصنُ بانٍ أَملدٌ","سكَنَ النَعيم فَنالَ خيرَ جِوَارِ",14,"ر",1,0],["مِنَ الطّيرِ مُختلفٌ لونهُ","يحطُّ نُسَالاً ويُبْقِي نُسالا",15,"ل",2,1],["مِنَ الطَّالِبَاتِ البَرْقَ لاَ الشَّأوُ مُعْجِزٌ","وَلاَ الظَّهْرُ مقسُوم وَلاَ الشاء غَالِبُ",16,"ب",1,0],["من الطبيب لعمري حيثما انبسطت","ايدي المنون ويوم الحين قد حانا",17,"ن",2,0],["مِنَ الطَّالِعِينَ بِحُمْرِ المَنَايَا","طِوَالِ السَّوَاعِدِ غُبْر السِّبَالِ",18,"ل",1,0],["مِنَ الطَّبَلاَتِ الَّلائِي مَا زَالَ كَسْرُهَا","لَدَى الْبَطَلِ الأَحْمَى يُعَدُّ مِنَ الْجَبْرِ",19,"ر",1,0],["من الطاعني صدر الكتيبة في الوغى","إذا الصفُّ منها من حديد توقّرا",20,"ر",2,0],["من الطود الأَشم من المُلِثِّ الأع","م من الخضم المستماح",21,"ح",1,0],["من الطبيعة بنا","ما بين عقلٍ ونفسِ",22,"س",1,0],["مِن الطَرف السَقيم يَعدن حَمرا","فَترمقهن بِالطَرف الصَحيح",23,"ح",1,0],["مِنَ الطاوِياتِ خِلالَ الغَضى","بِأَجمادِ حَومَلَ أَو بِالمَطالي",24,"ل",2,0],["مِنَ الطَفِّ مَجلوباً إِلى أَرضِ كابُلٍ","فَمَلّوا وَما مَلَّ الأَسيرُ المُعَذَّبُ",25,"ب",1,0],["من ألطف الإنس لكن في الوغى أسدٌ","له قلوب العدا إن غاب غابات",26,"ت",1,0],["من الطينِ رَبِّي بَرَا آدما","فآكلُهُ آكلٌ للأَبِ",27,"ب",1,0],["مَن الطارق الساري فقال صبابة","نعمتَ بها حينًا وما أنت ناسيا",28,"ي",2,0],["من آل طه المصطفى","حقاً بلا استفهام",29,"م",1,0],["من الطعام فكُلَن ما تشتهي","حسنَ أو خشنَ هكذا البهي",30,"ي",1,1],["من الطينِ المبللِ صرتَ شيئاً","فطِبْ طيناً..إذا ما شحَّ ماءُ",31,"ا",2,0],["من الطاعات فهو لها محب","إلهي راضياً بالامتثال",32,"ل",1,0],["من الطاعات لو وقعت وصارت","على وفق المحبة بالفعال",32,"ل",1,0],["من الطرب في كل روض تحومي","وتقضي الدنيا زغاريت وسجوم",33,"م",1,0],["من الطايف بلاد الورد والشعر وحديث الناس","يسيل الحب والشوق إيتهشم فيّ من عامين",34,"ن",1,0],["من الطايف هل الفكر المنير ومسجد العباس","لفيتك ياغلا المحار واليامال والبحرين",34,"ن",1,0],["‏ ‏من الطفولة لم تُشبعنِ والدتي","‏ ‏ حبّاً فعشتُ حياتي غيرَ منفطمِ",35,"م",1,0],["من الطارق الساري خلال المقابر","كخفقة روح في الدجنات عابر ؟",36,"ر",1,1],["\" من الطارق الساري خلال المقابر","فأقلق منّا كل غاف وساهرِ \"",36,"ر",1,0]]}