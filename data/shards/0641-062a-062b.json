{"poems":[[93,"بنات الدهر عوجي لا تهابي","https://www.aldiwan.net/poem9824.html","عموديه"],[93,"ويح الفقيرات الجميلات من","https://www.aldiwan.net/poem11136.html","السريع"],[92,"أظل الوجود المساء الحزين","https://www.aldiwan.net/poem38904.html","المتقارب"],[80,"نثر الجو على الأرض برد","https://www.aldiwan.net/poem31499.html","الرمل"],[113,"صبرا امي فذي الشخوص خيال","https://www.aldiwan.net/poem40634.html","عموديه"],[113,"يا نعم ضائعة المكارم تنشد","https://www.aldiwan.net/poem41173.html","عموديه"],[221,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[268,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[268,"سرت في الروضة والصبح قريب","https://www.aldiwan.net/poem35660.html","الرمل"],[303,"محيا الهنا طلق وثغر المنى افترا","https://www.aldiwan.net/poem56547.html","الطويل"],[402,"أبرزت وجها كلاذا","https://www.aldiwan.net/poem49973.html","مجزوء الرمل"],[429,"وسريع الجواب نازعته القول","https://www.aldiwan.net/poem12772.html","الخفيف"],[438,"إن العداوة لم تزل","https://www.aldiwan.net/poem14397.html","مجزوء الكامل"],[450,"بكرت عنادل روضنا","https://www.aldiwan.net/poem13633.html","مجزوء الكامل"],[450,"بكرت عنادل روضنا","https://www.aldiwan.net/poem13751.html","مجزوء الكامل"],[451,"نعم الرصاص جزاء خادم شعبه","https://www.aldiwan.net/poem61243.html","الكامل"]],"verses":[["فَتَثْلِمَ عَزْمَهُ كَالْعَهْدِ حَتَّى","يَفِيءَ عَلَى يَدَيْكَ إلى مَتَابِ",0,"ب",1,0],["فَتَثِبُ الأَبْصَارُ شَوْطاً بِهَا","ثُمَّ تَنِي ظَالِعَةً حَاسِرَهْ",1,"ر",2,0],["فتَثْغُو حنيناً لحِمْلانِها","وتقطفُ زهرَ المُروجِ الخَصيبْ",2,"ب",1,0],["فتثنَّى الغصنُ سكراً بالنّدى","وتغنّى ساجعُ الطيرِ غَرد",3,"د",1,0],["فتثور افئدة الكرام لنصره","ويهز من سجف العلا زلزال",4,"ل",1,0],["فتثبتي يا نعم وارض عن القضا","فالله في كل الشؤن الموعد",5,"د",1,0],["فَتَثنَّت تضاجِعُ الجَوِّ نَشوى","مِن تَلَوّي قَوامِها المَحرورِ",6,"ر",1,0],["فتَثبّتوا بعَقِيدَةٍ عصَبيَّةٍ","وطنِيّةٍ عندَ اختِلافِ عقائد",7,"د",1,0],["فتثَّنت عِندما حيَّيتها","ثم قالت ويلتي هذا الرقيب",8,"ب",1,0],["فَتُثمرُ إسعافاً خلاف مَطالبي","وَتَجني طِباعي شكرَ مُنعِمِها زهرا",9,"ر",2,0],["فتَثنَّتْ ثمَّ قالتْ","قد جرى الأمرُ على ذا",10,"ذ",2,0],["فتثنى وقال لي كيف يذْوي","وحياهُ كما رأيت حياؤهُ",11,"ا",3,0],["فتثير هذي جزلها","وتثير هاتيك الشناوه",12,"ا",3,0],["فتثير سالفةً الهوى","مني وتذكرني حبيبي",13,"ي",1,0],["فتثير سالفةَ الهوى","وتذكِّر المشتاق عهْدَا",14,"د",2,0],["فتثور كالسيل العرمرم صاخبا","متمردا لا ينتهي لمصبّه",15,"ب",2,0]]}