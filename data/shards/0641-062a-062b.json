{"poems":[[95,"بنات الدهر عوجي لا تهابي","https://www.aldiwan.net/poem9824.html","عموديه"],[95,"ويح الفقيرات الجميلات من","https://www.aldiwan.net/poem11136.html","السريع"],[94,"أظل الوجود المساء الحزين","https://www.aldiwan.net/poem38904.html","المتقارب"],[82,"نثر الجو على الأرض برد","https://www.aldiwan.net/poem31499.html","الرمل"],[102,"أنسى ان أموت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67669&r=&rc=156",""],[119,"صبرا امي فذي الشخوص خيال","https://www.aldiwan.net/poem40634.html","عموديه"],[119,"يا نعم ضائعة المكارم تنشد","https://www.aldiwan.net/poem41173.html","عموديه"],[228,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[275,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[275,"سرت في الروضة والصبح قريب","https://www.aldiwan.net/poem35660.html","الرمل"],[310,"محيا الهنا طلق وثغر المنى افترا","https://www.aldiwan.net/poem56547.html","الطويل"],[411,"أبرزت وجها كلاذا","https://www.aldiwan.net/poem49973.html","مجزوء الرمل"],[438,"وسريع الجواب نازعته القول","https://www.aldiwan.net/poem12772.html","الخفيف"],[447,"إن العداوة لم تزل","https://www.aldiwan.net/poem14397.html","مجزوء الكامل"],[457,"بكرت عنادل روضنا","https://www.aldiwan.net/poem13633.html","مجزوء الكامل"],[457,"بكرت عنادل روضنا","https://www.aldiwan.net/poem13751.html","مجزوء الكامل"],[458,"نعم الرصاص جزاء خادم شعبه","https://www.aldiwan.net/poem61243.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138215",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64342","الخفيف"],[928,"","https://poetry.dctabudhabi.ae/diwan/poem/145673","الرمل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102318","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108827","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108772","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110314","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137453",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94020","الخفيف"],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77731","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92030","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94412","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133096","الوافر"],[5111,"بسمةُ الرحمانِ","https://www.poetsgate.com/ViewPoem.aspx?id=212080",""],[5136,"يا بروحي المدلل البتاه","https://www.poetsgate.com/ViewPoem.aspx?id=121772",""],[5387,"بعينيكِ ارتياحي","https://www.poetsgate.com/ViewPoem.aspx?id=46526",""],[1117,"تاج الحب","https://www.poetsgate.com/ViewPoem.aspx?id=19415",""],[5674,"مأسور ويعشق آسره","https://www.poetsgate.com/ViewPoem.aspx?id=190017",""],[5725,"الى رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=177499",""],[402,"كانت عيون الريب الساهرة","https://www.poetsgate.com/ViewPoem.aspx?id=36585",""],[6223,"حثالة الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1211&r=&rc=6",""]],"verses":[["فَتَثْلِمَ عَزْمَهُ كَالْعَهْدِ حَتَّى","يَفِيءَ عَلَى يَدَيْكَ إلى مَتَابِ",0,"ب",1,0],["فَتَثِبُ الأَبْصَارُ شَوْطاً بِهَا","ثُمَّ تَنِي ظَالِعَةً حَاسِرَهْ",1,"ر",2,0],["فتَثْغُو حنيناً لحِمْلانِها","وتقطفُ زهرَ المُروجِ الخَصيبْ",2,"ب",1,0],["فتثنَّى الغصنُ سكراً بالنّدى","وتغنّى ساجعُ الطيرِ غَرد",3,"د",1,0],["فتثير أوجاعي وترّغمني على وجع السّكوت","وتقول لي : متّ أيها الذواي … فأنسى أن أموت",4,"ت",1,0],["فتثور افئدة الكرام لنصره","ويهز من سجف العلا زلزال",5,"ل",1,0],["فتثبتي يا نعم وارض عن القضا","فالله في كل الشؤن الموعد",6,"د",1,0],["فَتَثنَّت تضاجِعُ الجَوِّ نَشوى","مِن تَلَوّي قَوامِها المَحرورِ",7,"ر",1,0],["فتَثبّتوا بعَقِيدَةٍ عصَبيَّةٍ","وطنِيّةٍ عندَ اختِلافِ عقائد",8,"د",1,0],["فتثَّنت عِندما حيَّيتها","ثم قالت ويلتي هذا الرقيب",9,"ب",1,0],["فَتُثمرُ إسعافاً خلاف مَطالبي","وَتَجني طِباعي شكرَ مُنعِمِها زهرا",10,"ر",2,0],["فتَثنَّتْ ثمَّ قالتْ","قد جرى الأمرُ على ذا",11,"ذ",2,0],["فتثنى وقال لي كيف يذْوي","وحياهُ كما رأيت حياؤهُ",12,"ا",3,0],["فتثير هذي جزلها","وتثير هاتيك الشناوه",13,"ا",3,0],["فتثير سالفةً الهوى","مني وتذكرني حبيبي",14,"ب",2,0],["فتثير سالفةَ الهوى","وتذكِّر المشتاق عهْدَا",15,"د",2,0],["فتثور كالسيل العرمرم صاخبا","متمردا لا ينتهي لمصبّه",16,"ب",2,0],["فتثقيف الفتاة عليه تبنى","مسرات الفتى والعائلات",17,"ت",1,0],["فتثنى وقال مهلا فهذا","زعفران الهوى بورد الخدود",18,"د",1,0],["فتثنى وتراخى مائلا","كقضيب في كثيب ملتبد",19,"د",1,0],["فتثني إليه كل قلبٍ إذا شدا","ويثني عليه كل غصن إذا انثنى",20,"ن",2,0],["فتثنت وأنشدت وعلى اليا","قوت من خدها حميم اللآلي",21,"ل",2,0],["فتثنت وأنشدت مت فقد قا","ل أبو الطيب الأديب العراقي",22,"ق",2,0],["فتثنى يوم ارتقائك بشراً","وتصابى ولم يكن يتصابى",23,"ب",2,0],["فتثير أصواتا تلذ لمسمع الا","نسان كالنغمات بالأوزان",24,"ن",1,0],["فتثبتي يا حرقتي حزنا وكن","متأهلا يا صبر للترحال",25,"ل",1,0],["فتثنى تيهاً وقد صحت جاد ألح","ح فوافي فقلت كيم الطيب",26,"ب",1,0],["فتثخنُ في عِداك بكل أرضٍ","سعودُكُ قبل إثخانِ الحسامِ",27,"م",1,0],["فَتثبّت فكلُّ حي لموتٍ","وَتبصّر وَقَلَّ أن تتبصر",28,"ر",1,0],["فَتثبّت لك البَقا يا عَزيزي","هكذا الدَهر صَفوة وَتكدّر",28,"ر",1,0],["فتثوي الضواري والخراف بكهفهِ","وكم أَلِفت شاةٌ سُدوفاً وأجوفا",29,"ف",2,0],["فتثبيتٌ يكون لأهل خيرٍ","وزيغٌ للعصاةِ ذوي الفجور",30,"ر",1,0],["فَتَثَمَّلَ الْبُلَغَاءُ وَالْخُطَبَاءُ مِنْ","آيَاتِهِ، سَرِحَ الْخَيَالُ فَأبْدَعَا",31,"ع",2,0],["فتثنى نظم ثغره شفتاه","ورد خديه فتثنى عيناه",32,"ا",2,0],["فتثملني عيون الغيد حتى","أذوبُ بسحرها من غير راحِ",33,"ح",1,0],["فتثاقَلَتْ لما رأتني مُمعِناً","فيها بطرفٍ يعتريهِ سُؤالُ",34,"ل",1,0],["فتثورُ منْ سحرِ البيانِ قصيدتي","وأكادُ أنْ أفشي الهوى وأجاهرٓهْ",35,"ر",2,0],["فتثقّبتْ مني جنوباً غرزها","شوك العواسجِ لا تُرافُ بمرقعِ",36,"ع",1,0],["فتثبت الأبصار شوطا بها","ثم تني ظالعة حاسرة",37,"ر",2,0],["فتثنّى كأنّه غصنُ بانٍ","وتدلَّى كنجمةٍ في السماء!",38,"ا",2,0]]}