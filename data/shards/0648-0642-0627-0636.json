{"poems":[[88,"ماذا أصبت من الأسفار والنصب","https://www.aldiwan.net/poem10508.html","البسيط"],[85,"كأني بلطف الله قد عم خلقه","https://www.aldiwan.net/poem54272.html","الطويل"],[74,"ألا في سبيل الحب حال مسهد","https://www.aldiwan.net/poem19251.html","الطويل"],[74,"يجور كما شاء الدلال ويعدل","https://www.aldiwan.net/poem19476.html","الطويل"],[74,"يدافعني الغيران عن طيب لثمها","https://www.aldiwan.net/poem19677.html","الطويل"],[71,"وقاضيا ماضيا في الشر مجتنيا","https://www.aldiwan.net/poem29164.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/178163","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[170,"وقاض لنا أير أيد","https://www.aldiwan.net/poem47080.html","المتقارب"],[215,"رأيت ومن يعش ما عشت يشهد","https://www.aldiwan.net/poem46759.html","الوافر"],[290,"بقصر مليكة العليا أقمنا","https://www.aldiwan.net/poem39355.html","الوافر"],[443,"إذا بارق من بارق لاح مومضاً","https://www.aldiwan.net/poem2536.html","الطويل"],[463,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[563,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48790","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38659","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38852","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38854","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120057","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96635","المتقارب"],[1138,"","https://poetry.dctabudhabi.ae/diwan/poem/100664","الوافر"],[1611,"","https://poetry.dctabudhabi.ae/diwan/poem/106721","المتقارب"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49582","الطويل"],[2037,"","https://poetry.dctabudhabi.ae/diwan/poem/34881","الطويل"],[2100,"","https://poetry.dctabudhabi.ae/diwan/poem/34958","الوافر"],[2175,"","https://poetry.dctabudhabi.ae/diwan/poem/101269","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77357","الوافر"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124780","الطويل"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33981","الهزج"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134039","الوافر"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117024","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117993","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131302",""],[2052,"جواد جدد المعروف فينا","https://www.poetsgate.com/ViewPoem.aspx?id=189621",""],[5582,"أَرَى ماءَ الجُفُونِ جَرَى وَفاضَا","https://www.poetsgate.com/ViewPoem.aspx?id=187175",""],[5818,"لعلّ الله أنْ يشفي سقامهْ","https://www.poetsgate.com/ViewPoem.aspx?id=193231",""],[496,"وقاض اتى بقضي على كل ملة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=599255",""]],"verses":[["وَقاضِباتٍ لَهُم كانَت إِذا اِختُرِطَت","تَدَثَّرَ الغَربُ في ثَوبٍ مِنَ الرَهَبِ",0,"ب",1,0],["وقاضي القضاء الحَتْم سجَّل ختمه","وخَطّ على رسم الشفاء له اكتفى",1,"ف",2,0],["وقاضي قضاة الشام والذكر والندى","بحيث ثبيرٌ فالحسا فأباع",2,"ع",1,0],["وقاضي قضاةٍ معرب بكمالِه","تقىً ليسَ يخفى أو لهىً ليسَ يجهل",3,"ل",1,0],["وقاضي قضاة تعرب الخلق مدحه","فتعجز حتَّى عربها مثل عجمها",4,"م",3,0],["وقاضياً ماضياً في الشر مجتنياً","للخير من سيئاتِ الدهرِ محسوبا",5,"ب",2,1],["وقاض لا يزال الليل عندى","وطول نهاره بين الخصوم",6,"م",1,1],["وقاضياً كالذكر اليماني","لم يأته في سنةٍ خصمان",7,"ن",1,0],["وقاضٍ لنا أَيّرٍ أَيِّدِ","يَنيكَ الرَّدِيَّ معَ الجَيِّدِ",8,"د",1,1],["وقاضي الشرع يحضر في يديه","كتاب خطّه خطّ غريب",9,"ب",1,0],["وقاضيها الجليل ومن يليه","ليالي مؤنسات كالزلال",10,"ل",1,0],["وقاضى الهوى منه عليّ تجبّرا","بحكم التنائي والتباعد قد قضى",11,"ض",2,0],["وقاضٍ ينفِّذُ أحكامَهُ","إذا أمر الناسَ لا يؤمَرُ",12,"ر",1,0],["وقاض قضى بالحق والروح شاهد","فكان لحق النفس منها مقامع",13,"ع",1,0],["وقاضوا زمانك وهو البريء","وألقوا عليه ذنوب الأول",14,"ل",1,0],["وَقاضٍ عَلى حَقِّ بِحقٍّ قَضاؤُهُ","وَكانَ لِقَولِ الحقِّ فيهِ اِلتِزامُهُ",15,"م",2,0],["وَقاضي قَريَةٍ قَد قالَ أَقضي","لِذي دَعوى بِها عَينٌ ودينُ",16,"ن",1,1],["وَقاضٍ تَولّى الشّرع وَالشّرعُ عَينُهُ","بِها يَظهرُ الحقُّ المُبين وَيَسطعُ",17,"ع",1,1],["وقاضية بالظلم لولا اعتدالها","وجور هواها ما أقضى وسادي",18,"د",2,0],["وَقاضَك بعد الكرى والهجو","ع حكم الهوى بالهجوعِ السهادا",19,"د",2,0],["وقاضٍ باع أخراهُ","بتبر الراح والنشوه",20,"ه",1,1],["وَقاضي القُضاةِ الَّذي فاخرَت","بِهِ الشَرقُ مَغرِبَنا الظاهِرَه",21,"ر",2,0],["وقاضِيةً بالهجرِ بيني وبينها","كأنَّكِ لم تَلْقَيْ سبيلاً إلى العدل",22,"ل",1,0],["وَقاضٍ ضَعيفُ الحِلمِ وَالعَقلِ جاهِلٌ","يَصُدُّ عَنِ الحَقِّ المُبينِ وَيَجنَفُ",23,"ف",1,0],["وَقاضي المَوتِ يَعلَمُ ما عَلَيهِ","إِذا ما متُّ مِنهُ ما صَماني",24,"ن",2,0],["وقاضي قضاة القوم أرشدت أمره","وقد كان صعباً لا يلين لمرشد",25,"د",1,0],["وَقاضٍ عادِلٍ عِن كُلِّ خَيرٍ","يُشايِعُهُ عَلى ظُلمٍ مُحامي",26,"م",2,0],["وقاض بحكم الحق أصبح عالما","ولكنه فيه يجور ويعتدي",27,"د",2,0],["وَقاضٍ حاكِمٍ فِيَّ","بِظُلمٍ وَبِعَدوانِ",28,"ن",1,0],["وقاض في شريعتنا همام","بعدل قد بدا يصفو لورد",29,"د",1,0],["وقاضى قضاة الشام جاء يزورنا","ويثبت دعوى حبنا ويؤكد",30,"د",1,0],["وقاض أتى يقضي على كل ملّة","مطاع ومرضي لديهم بيانه",31,"ن",2,1],["وقاضٍ يعادي المصلحين تعمداً","ولكنه للمفسدين محاب",32,"ب",1,1],["وقاض ليس في تقواه ريب","ولا يحتاج فيه الى دليل",33,"ل",1,0],["وَقاضانِي الزَّمانُ سَقامَ جِسْمٍ","مِنَ الصِّحاتِ ما ذَا مِنْهُ قاضَى",34,"ض",2,0],["وقاض ٍ لمْ يفدْه العلْم لمّا","أصاخ لها وغرّدتِ الحمامة ْ",35,"م",2,0],["وقاض أتى بقضي على كل ملّة","مطاع ومرضي لديهم بيانه",36,"ن",2,1]]}