{"poems":[[88,"يا من خلقت الدمع لطفاً","https://www.aldiwan.net/poem10943.html","مجزوء الكامل"],[87,"انظر إلى الأقمار كيف تزول","https://www.aldiwan.net/poem62837.html","الكامل"],[64,"يا من خلائقه لطائف","https://www.aldiwan.net/poem52336.html","مجزوء الكامل"],[69,"أمدائح لي فيك أم تسبيح","https://www.aldiwan.net/poem18045.html","الكامل"],[382,"رب الورى في عرشه","https://www.aldiwan.net/poem66957.html","مجزوء الكامل"],[458,"لم يفجع الدهر أحلامي ويرهقها","https://www.aldiwan.net/poem61567.html","البسيط"],[473,"يا من خلعت على هواه طاعتي","https://www.aldiwan.net/poem59635.html","الكامل"],[591,"الدمع هام والحشا هائم","https://www.aldiwan.net/poem17702.html","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120080","الكامل"],[1037,"","https://poetry.dctabudhabi.ae/diwan/poem/198809","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59418","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96603","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64720","الوافر"],[1351,"","https://poetry.dctabudhabi.ae/diwan/poem/130685","الكامل"],[458,"","https://poetry.dctabudhabi.ae/diwan/poem/133692","الكامل"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121911","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65102","البسيط"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142838","البسيط"],[4755,"بينَ يَدَيْ قِيَامِ السَّاحَة","https://www.poetsgate.com/ViewPoem.aspx?id=183587",""],[4755,"إِنِّي أَحِنُّ إِلى اتِّصَالِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=183828",""],[4755,"ولَقَد رَأَيتُ.. لَقَد رَأَيتُ مُحَالا","https://www.poetsgate.com/ViewPoem.aspx?id=184349",""],[4755,"أنتِ القلبُ يا عَدَنُ","https://www.poetsgate.com/ViewPoem.aspx?id=206344",""],[4830,"حُفاةٌ عُراة","https://www.poetsgate.com/ViewPoem.aspx?id=193877",""],[5033,"قبضةٌ من أثر الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=207615",""],[5324,"إلى من لا يرعوي.","https://www.poetsgate.com/ViewPoem.aspx?id=211396",""],[5410,"الصبر من صبري اشتكى","https://www.poetsgate.com/ViewPoem.aspx?id=141974",""],[5463,"أحسن أعيش العمر من دون خلان","https://www.poetsgate.com/ViewPoem.aspx?id=26413",""],[5582,"صبٌّ له في الهَوى شرحٌ وإملاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=63455",""],[5694,"تريحي","https://www.poetsgate.com/ViewPoem.aspx?id=132099",""],[5781,"فاكهةُ الشِّتاءِ ومُتعةُ الليل","https://www.poetsgate.com/ViewPoem.aspx?id=185318",""],[5781,"فاكهةُ الشّتاءِ ومُتعةُ الليل","https://www.poetsgate.com/ViewPoem.aspx?id=202854",""],[5956,"فاجعُ المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=182538",""],[5956,"يا خالقَ الأكوان","https://www.poetsgate.com/ViewPoem.aspx?id=194028",""],[5956,"صاحبة التَّرحابِ المُرَكَّز","https://www.poetsgate.com/ViewPoem.aspx?id=205344",""],[6070,"أيّامُ عُمْرِكَ والمَغيبْ","https://www.poetsgate.com/ViewPoem.aspx?id=187881",""],[6106,"سيدنا الإمام الحسين ، سيد الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=6313",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""]],"verses":[["يا مَن خَلَقتَ الدَمعَ لُط","فاً مِنكَ بِالباكي الحَزين",0,"ن",1,1],["يا مَن خِلافَتُهُ الرَضِيَّةُ عِصمَةٌ","لِلحَقِّ أَنتَ بِأَن يُحَقَّ كَفيلُ",1,"ل",1,0],["يا من خلائقُهُ لطائفْ","وبباله إلا لطائفْ",2,"ف",1,1],["يا منْ خَزَائِنُ جُودِهِ مملوءَةٌ","كَرَماً وبابُ عطائِه مَفْتُوحُ",3,"ح",1,0],["يا من خطوتَ إلى الردى","لا تعتبنَّ على الخُطى",4,"ا",1,0],["يا من خذلتم رجائي في مودتهم","مهما نسيت فمالي اليوم نسيان",5,"ن",1,0],["يا مَن خَلَعتُ عَلى هَواهُ طاعَتي","فَغَدا يُجَرِّرُها بِكُلِّ مَكانِ",6,"ن",1,1],["يا مَنْ خَلا مِنْ حُسْنهِمْ نَاظِري","في القَلْبِ مَغْناكُم وَمَعْنَاكُمْ",7,"م",1,0],["يا من خلائقه الشوا","هد أنها خمر وشهدُ",8,"د",1,0],["يا من خلعت على الصحراء حلتَها","الخضرا فضاحكتِ الأقمار والسحبا",9,"ب",2,0],["يا من خلق الأرض والسماء وأبرى","الأنفاس وأروى من الظما وهدى الضال",10,"ل",1,0],["يا مَن خَلائقهُ لِلمُعتَفين وللطائعين","وَالساغبينَ في الطبعِ سرّاء وضراءُ",11,"ا",2,0],["يا مَنْ خُلِقُوا على اقْتِراحي","ما أَطيبَ فيكُمُ افْتضِاحي",12,"ح",2,0],["يا من خزائن ملكه في قول كن","امنن فإنّ الخير عندك أجمع",13,"ع",1,0],["يا من خواطره تزيد خواطري","ألقا ويرفع حبه إمكاني",14,"ن",2,0],["يامن خلعت عذار نسكى هائما","فى حبه وعصيت من لى يردع",15,"ع",1,0],["يا من خزائنُ رُحمى الفضل ما نفدت","منهُ اجرنا من اللأوا فلم نحج",16,"ج",1,0],["يا من خلقت الطباق السبع خذ بيدي","فملء دربي شياطين وأشباح",17,"ح",1,0],["يا مَن خَرَجتُم للنِّظامِ أَلَم يَعُد","بفُلُولِه ِوحَميرِهِ وبِغالِهِ؟!",18,"ل",2,0],["يا مَن خَطَرْتِ الآنَ في","بالِي . ولَمْ أَخطُر بِبَالِكْ",19,"ك",1,0],["يا مَن خَرَجتَ لِرَفضِ (أحمَدَ) حَاكِمًا","ماذا فَعَلتَ لِكَي تُزيحَ (جَلَالا)؟!",20,"ل",2,0],["يا مَن خَذَلناكِ يَومًا كي نَقُولَ لِمَن","أَصَابَ عَينَيكِ: عاشَ القائِدُ الوَثَنُ",21,"ن",1,0],["يامَنْ خَبِرتَ الوغى نصراً وقد شهدَتْ","لك السنونُ وبعضُ النصرِ لم يَغِبِ",22,"ب",1,0],["يا من خُلقتَ ولم يُخلق سواك كما","خلقتَ أنتَ بطهرٍ مازجَ الطُّهرا",23,"ر",2,0],["يامن خسرت من الحياة جميلها","فسعت اليك من القباحة ألسنُ",24,"ن",1,0],["يا من خلقت جوارحي","فسمت لترجو قدرتك",25,"ك",1,0],["يامن خلق [ دمعات .. وجروح .. وأحزان ]","أسألك خفف / عنّي همّي شويّه",26,"ي",2,1],["يا مَنْ خَلائِقُهُ لِلْمُعْتَفِينَ وَلِلْ","باغِينَ فِي الطَّبْعِ سَرَّاءٌ وَضَرَّاءُ",27,"ا",2,0],["يامن خذيت النور من شعلة الشمس","في قربك الفرحه وديمومة الأنس",28,"س",1,0],["يا منْ خَلَعْتَ على الأجفانِ حِلْيَتها","مِنْ غَيْضِ شَوْقٍ فما خانوا ولا غَدَروا",29,"ر",3,0],["يا مَنْ خَلَعْتَ عَلى الأَشْواقِ حِلْيَتها","فَتَرْجُمُ البَدْرَ شَمْسٌ فِيَّ تَسْتَعِرُ",30,"ر",1,0],["يا من خدعت سواي ثم خدعتني","الغشّ مجبول بنسغ دماكا",31,"ك",2,0],["يا مَن خلقتَ المجد فِيَّ أما ترى","أنَّ الوفاء إليك يَنبوعٌ جرى؟",32,"ر",2,1],["يا مَن خدمتِ أباكِ وقت شبابه","ترجين خدمته لأنه شابا",33,"ب",2,0],["يامَنْ خَلوتَ بريبةٍ","وغفوتَ في خدرٍ مُريبْ",34,"ب",1,0],["يا من خرجت إلى الجهاد مدافعاً","ببسالة يا قائد الأحرار",35,"ر",1,0],["يا مَن خبر يا مَن علم مثل بَلوَتي","بِالصَوت شفتوا يا الرفاق مثالها",36,"ل",3,0]]}