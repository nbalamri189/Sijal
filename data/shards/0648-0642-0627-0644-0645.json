{"poems":[[65,"أكوكب ما أرى يا سعد أم نار","https://www.aldiwan.net/poem45803.html","البسيط"],[95,"يا حسنها حين تجلت على","https://www.aldiwan.net/poem11300.html","السريع"],[74,"نعاه للفضل والعلياء والنسب","https://www.aldiwan.net/poem18241.html","البسيط"],[53,"خدن أبي المستهل خبرني","https://www.aldiwan.net/poem8690.html","المنسرح"],[26,"نام الخلي وبت الليل مشتجرا","https://www.aldiwan.net/poem24088.html","البسيط"],[93,"رآني الله ذات يوم في الأرض أبكي من الشقاء","https://www.aldiwan.net/poem8734.html","عموديه"],[101,"رسالة حب صغيرة","https://www.aldiwan.net/poem6320.html","عموديه"],[82,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[107,"بني الكنانة هذا صوتها ارتفعا","https://www.aldiwan.net/poem42100.html","البسيط"],[107,"هوازن أقبلي ماذا التواني","https://www.aldiwan.net/poem44036.html","الطويل"],[107,"أكانوا كلهم داء عياء","https://www.aldiwan.net/poem44053.html","الوافر"],[50,"فديت من حملته حاجة","https://www.aldiwan.net/poem10411.html","السريع"],[50,"وأحور ذمي طرقت فنائه","https://www.aldiwan.net/poem63278.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39631","السريع"],[102,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[82,"أمسكَ الصبا أهدتْ إلي صبا نجدِ","https://www.poetsgate.com/ViewPoem.aspx?id=3155",""],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[193,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[228,"لبيك يا قلب ماض فيك ناداني","https://www.aldiwan.net/poem39693.html","البسيط"],[234,"وشادن شرط الصبا مرهف","https://www.aldiwan.net/poem51273.html","السريع"],[242,"ألمم بمكناسة فموردها","https://www.aldiwan.net/poem18187.html","المنسرح"],[287,"تب يا عذولي عن ملامي واتئب","https://www.aldiwan.net/poem32884.html","الرجز"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[308,"غنى بشعر سمج فانثنى","https://www.aldiwan.net/poem57805.html","السريع"],[325,"بالله ربكما عوجا على سكنى","https://www.aldiwan.net/poem61782.html","البسيط"],[358,"وبائع بعت روحي في محبته","https://www.aldiwan.net/poem39781.html","البسيط"],[369,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[505,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[534,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66773","السريع"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66806","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87194","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87248","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37953","المجتث"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77591","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77660","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77640","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77552","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77593","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202069","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46516","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46525","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46523","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46514","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109200","السريع"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137908",""],[1449,"","https://poetry.dctabudhabi.ae/diwan/poem/110682","الرجز"],[1552,"","https://poetry.dctabudhabi.ae/diwan/poem/203250","السريع"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53058","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129823","السريع"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137364",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75881","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94240","المجتث"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134112","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65317","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112624","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112622","الرجز"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99373","المنسرح"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61257","البسيط"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32832","المنسرح"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135257","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70127","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81917","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81731","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83671","الطويل"],[4578,"زف المدامة واسع سعيك للصفا","https://www.poetsgate.com/ViewPoem.aspx?id=49483",""],[4966,"تجَنَّى..","https://www.poetsgate.com/ViewPoem.aspx?id=196745",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5338,"سقيت ربعك غيث المدمع الهطل","https://www.poetsgate.com/ViewPoem.aspx?id=187697",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5126,"بائِع المسَاويك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87809&r=&rc=24",""],[572,"عرشُ العلا مُنهدِمٌ مُؤْتَفِكْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9419&r=&rc=276",""]],"verses":[["وَقالَ مَن هُوُّلَيَّاءِ الرُكَيبُ وَما","يَبغونَ عِنديَ لا آوَتْهُمُ دارُ",0,"ر",1,0],["وَقَالَ مَنْ قَرَّبَ مِنْكُمْ لَهَا","عِدَّة شَهْرَيْنِ وَصَلَّى وَصَامْ",1,"م",1,0],["وقال موتُ فتى الأنصارِ مغتبطاً","الله أكبرُ كلّ الحسنِ في العرَب",2,"ب",1,0],["وقال مَحْلُوقةٌ فقلتُ له","كَذَبْتَ مَنْتوفةٌ كَلِحْيَتِهِ",3,"ت",2,0],["وَقالَ ما شيهِمُ سِيّانِ سَيرُكُمُ","وَأَن تُقيموا بِهِ وَاِغبَرَّتِ السوحُ",4,"ح",1,0],["وَقالَ مازالَ آدَمِيّاً","يَصبو إِلى الغيدِ وَالطِلاء",5,"ا",2,0],["وقال ما قال فلا نجمةٌ","إلا عليها من عبيري عبير",6,"ر",1,0],["وقَالَ مُعِزُّ الدينِ ذو الفَخرِ لابنِهِ","تميمٍ سريرُ الملك أنتَ له بَعدي",7,"د",2,0],["وقال ما بالُ إسماعيلُ يُنكرنا","أما يَرى رأيَ مَن أمسَى لنا تبعا",8,"ع",2,0],["وقال محمدٌ أين ابنُ عَوْفٍ","سَيَحْمَدُ مُنتَواهُ إذا أتاني",9,"ن",2,0],["وقال مُحَمَّدٌ يا آلَ بِشرٍ","كَفَى بِدَمِ التي قُتِلَتْ عَزَاءَ",10,"ا",2,0],["وَقالَ ما شِئتَ فَسَل غَيرَنا","فَفي الَّذي تَطلُبُ جازَ الإِباءِ",11,"ا",2,0],["وَقالَ مَنِ الطُرّاقِ لَيلاً فِناءَنا","فَقُلتُ لَهُ افتَح فِتيَةٌ طَلَبوا خَمرا",12,"ر",2,0],["وقال من قال لقد أولعت","بالشرِّ فالطَّبْعُ لئيمٌ لعينْ",13,"ن",1,0],["وقال ما ليس يدري فادعت غضبا :","من خلتني ؟ قل لغيري : انني كلف",14,"ف",1,0],["وقال معزّ اليدن ذو الفخر لابنه","تميمٍ: سريرُ الملك أنتَ له بعدي",15,"د",2,0],["وقال مراد الله وفق لأمره","فما كافر إلا مطيع الأوامر",16,"ر",1,0],["وَقالَ مُفتخراً بالزورِ مَذهبُنا","تَركُ الجدالِ وتأنيب لطالبهِ",17,"ب",2,0],["وَقالَ مِلكُكَ لَيسَ الشَعب يا مَلِكي","فَلَستَ تَملِكُ إِلّا بَعضَ عُميانِ",18,"ن",1,0],["وقال ما استام بها ماجِدٌ","قَبلَكمُ فيما علِمناه",19,"ن",3,0],["وَقالَ مِنْ فَرَحٍ وَمِنْ مَرَحٍ","يُخَاطِبُ النَّجْلَ دُمْتَ تُنْجِدُهَا",20,"د",3,0],["وَقال ما عَبدُ الحَميدِ هَكَذا","وَهَل يُقاسُ النَبعُ يَوماً بِالغَرَب",21,"ب",1,0],["وَقال من قد أَطلقا","هيَ الودادُ مُطلَقا",22,"ق",2,0],["وَقال مه أَي زانيَه","صُليتِ ناراً آنيَه",22,"ه",1,0],["وقال منذُ دهر","لَم أَشتَغِل بسُكرِ",22,"ر",1,0],["وقال ما مقطوعه داخلٌ","لذاك تستخرج موصولي",23,"ي",1,0],["وَقالَ ماذا الَّذي قُتلُم وَمَن هُوَ ذا","فَغالِطاهُ وَقَولاً لَيسَ تَعرِفُهُ",24,"ف",2,0],["وَقال ما تَشتَهي مِنّي فَقُلت لَهُ","ما بِالكَرائم مِن لاميّة العَجمِ",25,"م",1,0],["وقال من بعدُ للعبّاس في مَلأَ","افخَرْ فأنت أبو الأملاك من مُضَر",26,"ر",1,0],["وقالَ من ضَريحِهِ","أَهلاً بهِ فليُقْبِلِ",27,"ل",1,0],["وقَالَ مَنْ حازَ عِلْمَ الإجْتِهادِ وَلَمْ","يَحُلَّ عَنْهُ عُرا التَّقْليدِ لَمْ يُصِبِ",28,"ب",1,0],["وقال ما حق امرئ ذي شيء","يوصى به من مسلم في الحي",29,"ي",1,0],["وقال من قال من الخوارج","لم ندر ما ان من المخارج",29,"ج",1,0],["وقال من وافق بعض ما انتظم","من قولهم نطيعه وإن ظلم",29,"م",1,0],["وقال من بين ما قد قصَّه","أخبرهم بإسمه ونصه",29,"ه",1,0],["وقال ما جاز لكم من قتلها","فلم يجز مع ذاك قتل حملها",29,"ه",2,0],["وقال من قد كنتُ مولىً لهُ","فذا له مَولى لكم مَوئِلُ",30,"ل",1,0],["وقال محمدٌ بغديرِ خُمّ","عن الرحمنِ يَنطِقُ باعتزامِ",31,"م",1,0],["وَقال مَجدي بِناديها يؤرخها","سِراية صان شاهينٌ مَبانيها",32,"ي",3,0],["وَقالَ مُخاطِباً لِلمَجد أَرّخ","رِسالة مُقبل في مَصر أَبهَجْ",33,"ج",1,0],["وَقالَ مِنهُ تَطيَّبْ","فَإِنّهُ ماءُ وَردي",34,"د",2,0],["وَقالَ مُذ رَأى سَفينةً عجب","مَدينةٌ تِلكَ عَلَيهِ مِن خَشَب",35,"ب",1,0],["وَقالَ ما قالَ الوَزير الرومي","لِنَفسهِ يا نَفسُ دَوماً صُومي",36,"ي",1,0],["وَقالَ ما بَدا لَهُ لِيعظه","هَذا مَنام ما أَرى أَو يَقظه",37,"ه",1,0],["وَقالَ ما مَنفَعة الذُيول","بارِدَةً باسِلَة في الطُول",38,"ل",1,0],["وَقالَ مَن ذا قالَ شَخصُ صاحِبك","أَتاكَ في جنح الدُجى وَصاحَ بِك",39,"ك",1,0],["وقال من بعد ذا إن المحاسن قد","صارت له قسما أعظم بما قسما",40,"م",2,0],["وقال موسى سوف ألفَى صابرا","فَلْم يَكُنْ إذْ ذاك إَّلا قَاِصرَا",41,"ر",2,0],["وَقالَ مَن يعذرني في العرب","كَيفَ أَبيع طائِعاً بَني أَبي",42,"ي",1,0],["وَقالَ ما قُلت وَلا لي علم","بِما جَرى مني وَلا لي جُرم",43,"م",1,0],["وَقالَ ما أقدر أَن أَريما","وَأظهر التوجع العَظيما",44,"م",2,0],["وَقالَ ما عُذرك يا رَقيعه","في هَذِهِ المَقالة الشَّنيعه",45,"ه",1,0],["وَقال ملك ضائع ما فيه","ذو نَجدة إِن رُمتَهُ تَحميه",46,"ه",1,0],["وقال مذ أطلقها في فمي","أطلق ربي عبده بالسلام",47,"م",1,0],["وقال ما صاح ثغر مركزا ابدا","للبحر بل ذاك اطماع تناجينا",48,"ن",2,0],["وقال من حيرته","سبحانه عز وجل",49,"ل",1,0],["وقال: ما في قلبك اذكره لي","فقلت في قلبي المُعنَّى قلوب",50,"ب",1,0],["وقال متمم يحكي أخاه","وينعته لبعض السائلينا",51,"ن",2,0],["وقال مُنَخِّلٌ يحكي غناه","ويحسب أنه في المالكينا",51,"ن",2,0],["وقال من راعه خفق البنود لمن","هذي الأسود التي غاباتها حلبُ",52,"ب",1,0],["وقال ما ترغبُ قلت اتّئد","أدرَكت إذ كلمتني المأرَبا",53,"ب",2,0],["وقال محا بالشطب ذكرى حبيبه","واشهد فيما يدعى سنة الكرى",54,"ر",2,0],["وَقالَ مَتى ما عادَ للكُفرِ أرده","بِحدِّ حسامٍ تتركُ الرَأسَ طائِحا",55,"ح",2,0],["وقال ما كان وردي","وجود هذا بفارض",56,"ض",1,0],["وقال مهني العز وهو مؤرخ","سنا أنور الأفراح بشرى محمد",57,"د",1,0],["وقال ما نصلُ هذا الصّبغ ُقلتُ له","لو كان يُنضحُ من ماء اللّمى نصلا",58,"ل",2,0],["وقالَ من أحب في غيرِ حَرَج","فَليَمضِ عنا سالكاً في أيّ فج",59,"ج",1,0],["وقالَ ما معناهُ إنّ مَصرعي","هناكَ لا شكَ وأصحابي معي",60,"ي",1,0],["وقال ما تشتهي فقلت له","نقصف حسادنا بأن نقصف",61,"ف",1,0],["وَقالَ مِن رِبقَةِ الآداب منخلعا","أُجرِرتَ حَبلَ خَليعٍ في الصِبا غزلِ",62,"ل",1,0],["وَقالَ ما تَشتَهي فَقُلتُ لَهُ","قَطرَةَ مِلحٍ وَكَسرَةً أُخرى",63,"ر",2,0],["وقال من لم يرضَ هذي الأربعهْ","فالنار تكفيه وهذا فاسمعهْ",64,"ه",1,0],["وَقالَ ما قُلت في عُرسٍ نؤرّخهُ","قَد قارن البَدرَ عزًّ انخلةُ الجودِ",65,"د",1,0],["وقال من مات منكم ثم ليس له","علم به مات كالمجهول في الحقب",66,"ب",1,0],["وقال ما قال من كلام","كستهُ عقباه كل شين",67,"ن",1,0],["وَقالَ مَقالاً وَهوَ أَصدَقُ قائِلٍ","وَما أَنا إِذ أَرويهِ عنهُ بِكاذِبِ",68,"ب",1,0],["وقال من لعلاك تاريخاً حبا","بصفيةٍ ورد السعيد لقد صفا",69,"ف",2,0],["وقال : متيَّمٌ صبٌّ هَيومُ","فقلتُ مخاتلٌ كَذِبٌ ظلومُ",70,"م",1,0],["وقال معاذ الله واشتد سابقا","إلى الباب يبغي فتحه الباب جهما",71,"م",2,0],["وَقالَ: مَنَ أنَا مَوْلاهُ فإنَّ لَكُمْ","بَعْدِي عَلِيًّا وَلِيُّ لَيْسَ مِنْ قِبَلي",72,"ل",2,0],["وقال من كنت له مولى فذا","مولى له اكرم به وأنعم",73,"م",1,0],["وقالَ: (مِنْ قرشين)! ماذا إذَنْ","يَبْقَى معي؟ وَيْحَكَ ماذا دَهَاكْ؟",74,"ك",1,0],["وقالَ مولاهُ وأعداؤه","تباركَ الرّحمنُ ما أكْمَلكْ",75,"ك",1,0]]}