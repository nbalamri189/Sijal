94671",""],[5956,"ما إن لمحتُ حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=181972",""],[5956,"أوطان الحب","https://www.poetsgate.com/ViewPoem.aspx?id=192320",""],[5956,"عجباً يحارب نفسه الصّومالُ","https://www.poetsgate.com/ViewPoem.aspx?id=194484",""],[5956,"ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=194897",""],[5956,"هدَّ انعطافي للرَّفاه قوايا","https://www.poetsgate.com/ViewPoem.aspx?id=210311",""],[6093,"قُبْلَةُ المِلْيَارِ","https://www.poetsgate.com/ViewPoem.aspx?id=199427",""],[5724,"هتف الزمان مهللا ومكبرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55143&r=&rc=10",""],[6198,"القبلة الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79295&r=&rc=69",""],[433,"أنتِ السّماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87047&r=&rc=0",""],[6328,"في رحاب الضاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82139&r=&rc=14",""]],"verses":[["هِيَ نُطفَةٌ رَقرَقتُها مِن خاطِري","بَيضاءُ تَنقَعُ غُلَّةَ الظَمآنِ",0,"ن",1,0],["هِيَ نَفسٌ زَكِيَّةٌ وَأَبوها","غَرسُهُ في الجِنانِ أَكرَمُ غَرسِ",1,"س",1,0],["هِيَ نَفسٌ تَعَلَّمَت حُسنَ أَخلا","قِ المولِحِيِّ في صَفاءٍ وَأُنسِ",1,"س",1,0],["هِيَ نِعْمَةٌ لَمْ يُؤْتهَا","رَجُلٌ أَحَقُّ وَلاَ أَحَبْ",2,"ب",1,0],["هي نعمة للَه واحدةٌ","أعطيتها فزكت عن الحصر",3,"ر",1,0],["هِيَ نَوَّرَتْ أَذَّهَانَ أُمَّتِهَا","إِذْ كَانَتِ الأَذْهَانُ فِي ظُلَمِ",4,"م",1,0],["هي نفحةٌ هبت من الأنصارِ","أهدتك فتحَ ممالك الأمصارِ",5,"ر",1,1],["هي نسخة للشيخ فيها نسبة","ما إن يزالا يرعشان من الكبرْ",6,"ر",1,0],["هَينُونَ لَينُونَ في بِيُوتهم","سِنخُ التُّقى والفَضَائِلُ الرُتُبُ",7,"ب",1,0],["هي نقطةٌ تروى فعند نفوذها","تحتال إذ عند الرجاء نفوذ",8,"ذ",1,0],["هي نارٌ وافقتْ مُطْفِئَها","لستَ بالآيس من مُلْهبِها",9,"ب",3,0],["هِيَ نَظرَةٌ عَرَضَت فَصارَت في الحَشا","نارا وَصارَ لَها الفُؤادُ وَقودا",10,"د",2,0],["هي نار مشبوبة يتصبى","سامعيه حسيس تلك النار",11,"ر",1,0],["هي نور للتائهين مبين","وهي ماء للظامئين قراح",12,"ح",1,0],["هي نَكْبَةٌ أَغْنَتْ فُؤادي مِنْ أسىً","إِذْ غادرتْهُ مِنَ العَزاءِ عَديما",13,"م",2,1],["هيناً فقدتُ من الرجال بليدا","من كان عندَ وجوده مَفقودا",14,"د",2,1],["هَيِّنٌ ما يَقولُ فيكَ اللاحي","بَعدَ إِطفاءِ غُلَّتي وَاِلتِياحي",15,"ح",2,1],["هيَ نفسُ النجوم لَيسَت سواها","وَهيَ ما في النجوم من أَضواء",16,"ا",2,0],["هَيْنَمَةُ الخِرْصانِ في عِطْفِها","هَيْنَمَةُ الأعْجَمِ للأعْجَم",17,"م",1,0],["هِيَ نَظْرَةٌ كَانَتْ ذَرِيعَةَ صَبْوَةٍ","وَاللَّحْظُ أَضْعَفُ مَا يَكُونُ وَأَقْدَرُ",18,"ر",1,0],["هِيَ نَظْرَةٌ فامْنُنْ عَلَي بِأُخْتِها","فالْخَمْرُ مِنْ أَلَمِ الْخُمارِ شِفَاءُ",19,"ا",2,0],["هِيَ نُجْعَةُ الأَدَبِ الَّتِي مَنْ أَمَّهَا","أَلْقَى مَرَاسِيَهُ بِوَادٍ مُمْرِعِ",20,"ع",1,0],["هِيَ نَظْرَةٌ كَانَتْ حِبالَةَ خُدْعَةٍ","مَلَكَتْ عَلَيَّ بَدِيهَتي وَصَوابِي",21,"ب",2,0],["هِيَ نِعْمَةٌ لِلْبيعَةِ الصُّغْرَى وَقدْ","حَظِيَتْ بِطَلْعَةِ أَكْبَرِ الأَحْبَارِ",22,"ر",1,1],["هِيَ نِعْمَةٌ جُمِعَتْ بِهَا","شَتَّى مِنَ النِّعَمِ الجِسَامِ",23,"م",1,0],["هِيَ نوْرُ الرَّوْضِ أَوْ أَزْهَى حُلىً","وَهْيَ غصْنُ الرَّنْدِ أَوْ أَرْشَقُ خَصْرَا",24,"ر",2,0],["هي نجمةُ الساري إذا عبَسَ الدجى","في وجهه ومنارةُ الملاح",25,"ح",1,0],["هَيْنٌ لَيْنٌ في عِزَّتِهِ","لكن في الحرْبِ تَشَدُّدُهُ",26,"د",2,0],["هِيَ نَظْرَةٌ لاقَتْ بِعَيْنِكِ مِثْلَهَا","ما كَانَ أَغْنَاهُ وما أَغْناكِ",27,"ك",1,0],["هي نفسَ شَفَّافَةٌ؛ نسجتها","قدرةُ الله من شُعَاع الصَّبَاح",28,"ح",1,0],["هَيّنٌ كلُّ ما أُلاقيهِ منكمْْ","في الهوى غَيْرَ ذِلّتي وخضوعي",29,"ع",2,0],["هي نقطة السر المطم","طم فالبحور ندا مياها",30,"ا",3,0],["هينٌ جنب ما تفوز به النفس","من السعد سورةٌ للوجد",31,"د",1,0],["هيني ببعض القفار نابتةً","في حيث لا تهتدي لي القدم",32,"م",1,0],["هيَّنٌ ليِّنٌ الطبيعةِ سهلٌ","ذُو خشوعٍ لله في سُجَرائِه",33,"ا",3,0],["هينُونَ لَينُونَ أقحاحٌ جَهَابِذَةٌ","كَانَ العُقَارُ وقَد شُجَّ إستِعَارَتَكُم",34,"م",1,0],["هي نِعمة ليديك أشكُرها","طولَ الزمان وآخرَ العَصِر",35,"ر",1,0],["هِيَ نارُ إِبراهيمَ لِلباغي النَدى","لَكِن عَلى الباغي تُشَبُّ وُقودا",36,"د",2,0],["هي نعمة لك لا أُؤدي شكرها","أن مِلتَ نحوي بعد نهي الوالدِ",37,"د",1,0],["هيَ نَفسيَ الثَكلى وَقَد","صَلّى العَذابُ لَها وَصاما",38,"م",2,0],["هينئاً لك الأعيادُ يا عيدَها الذي","به يُمْنَح العزُّ المنيعُ ويُوهَبُ",39,"ب",1,0],["هي نار الكليم فامح خليل ال","ذات في نورها حجاب صفاتك",40,"ك",1,0],["هي نجمتي في الحيِّ إذ لك نجمةٌ","في الجوِّ تؤثرُها لِفَرطِ بهاء",41,"ا",2,0],["هي نُكتةُ الدّنيا فحيهلاً بها","تَجدوا سناها في غدو سناءها",42,"ا",3,0],["هين ذاك وان كان كما","قيل من أعمارنا ذاك العجل",43,"ل",1,0],["هي نعمةٌ لَمْ أعطها","فيفقدها لم أَرْز شيّا",44,"ي",2,0],["هي نُصْحاً للمُلْكِ فَتْحٌ كفَتْح","وهْي نَصراً للدِّينِ قَلْعٌ لقَلْعه",45,"ع",2,0],["هيَ نارُ الخَليلِ في الوَقدِ لكِن","خَالَفَتها في بَردِها والسَّلامِ",46,"م",1,0],["هيَ نَفسُ الحُسَينِ نَفسُ رَسولِ ال","لَهِ نَفسُ الوَصي نَفس البتولِ",47,"ل",1,0],["هي نُصرة المظلوم ساقتهم","فهل يدري الغفاة ويدرك الجبناء",48,"ا",2,0],["هي نفسٌ لا بذنب قُتِلَتْ","ودَمٌ في غير جرم سُفِكا",49,"ك",2,0],["هي نظرة تنسي الوقار","وتسعد الروح المعنّى",50,"ن",2,0],["هي نزهة بل جنةٌ","فيها المسرة جاريه",51,"ي",2,0],["هينئاً إنهم طلبوا فنالوا","مرادهم رضى غير احتراث",52,"ث",1,0],["هي نفثةُ السحر التي قد أرْخَت ال","ساداتُ مثلُك لي بها الأرسانا",53,"ن",2,0],["هي نظرةٌ هيهاتِ من أخواتها","عيناك إن كفر المطيَّ شَراف",54,"ف",1,0],["هينٌ تلافي عند مقلته فوا","عجباهُ من مثلي يهون تلافه",55,"ف",2,0],["هي نعم المزار والدار فالجب","بار داراً للمكرمات اصطفاها",56,"ا",3,0],["هَيِّنٌ ليِّنٌ على الخالِصِ القلْ","بَ وصَعْباً على أَخي البُهْتانِ",57,"ن",1,0],["هي نَفسي وبنفسي أنا أص","نَعُ ما شِئت فخُذها فهيَ لَك",58,"ك",1,0],["هي نِعمَ المتاعُ لولا الذِي تُو","قِدُ في القلبِ من جحيم بتيت",59,"ت",1,0],["هَيِّنٌ بِالقَولِ تَقصيفُ القَنا","إِذ نَأَت عَنكَ العَوالي وَالشِفارُ",60,"ر",1,0],["هي نوق يقودها الشوق حثّاً","لحبيب لها على البعد بادي",61,"د",2,0],["هي نفس كيفما شئت بدت","لي بشخص بالسوى متشح",62,"ح",1,0],["هي نشأة من بعد أخرى مثلها","حتى تتم أولئك الحركات",63,"ت",1,0],["هِيَ نارٌ ليست تصيرُ رَماداً","وهْيَ سيفٌ بهِ الصَّدا ليسَ يَعلَقْ",64,"ق",1,0],["هي نسمة من روح أكرم روضةٍ","يُحيى شذاها روح كل عليلِ",65,"ل",1,0],["هين بغيهم عليك إذا لم","يؤذهم بغيهم وما اجترحوه",66,"و",2,0],["هيَ نصرةٌ من مفضلٍ متفضّلٍ","هيَ نَصْرَةٌ مِنْ غائظٍ مُغْتَاظ",67,"ظ",1,0],["هَيِّنٌ لَيِّنٌ وَسَهلُ طِباعٍ","وَلِرَفعِ القَبيحِ أَقوى شديدِ",68,"د",1,0],["هيَ نِكْتَةٌ سَنَظَلُّ نرويهَا ونَبْ","كي ضاحَكينَ وَنَلْعَنُ الأقدَارا",69,"ر",2,0],["هي نبذةٌ عن شعره ويسيرة","فعن العلوم فما يكون مقالي",70,"ل",2,0],["هينم القطر في الرياض فَتَصغى","مِثلَما سلسل الحَبيب عتابه",71,"ب",2,0],["هين لين وَفي حومة الحر","ب يعير الهندي منه الصَلابه",71,"ب",2,0],["هيَ نارٌ في إناءٍ من بَرَد","عجباً ذابت به وهو جَمد",72,"د",1,0],["هي نثرةٌ تضفوا على أحسابكم","زُغفٌ خلفتُ بنسجها داوودا",73,"د",2,0],["هي نفسي من ترى يعذِلُني","في هوى نفسي ما من أَحدِ",74,"د",1,0],["هي نِعمةٌ بمحلّها وبقاؤها","شكرٌ لواهِبها الكريم يَليق",75,"ق",1,0],["هي نعمةٌ نسج الإباء برودَها","فعلى الرعية أن تسوسَ الأَنعُما",76,"م",2,0],["هي نصف عمر المرء في الدنيا إذا","هو أحسن استخدامها ورعاها",77,"ا",3,0],["هي نور العلم والعرفان وال","فنّ والوحي السّماوي هي أميّ",78,"م",2,0],["هي نور الربيع وهي شذا المس","ك ودر البحرا في الأصداف",79,"ف",1,0],["هي نَفسي وما أُبُرِّئُ نفسي","إنما النفسث لومُها إغراء",80,"ا",2,0],["هيّن ليّن مطيعٌ مطَاعٌ","ضرب المجد في ذَرَاه قِبابَه",81,"ب",2,0],["هَيْنٌ عَلَيْكَ وَقَدْ مَلأتُ مِنَ الكَرَى","سَهَرِي لأنْظُرَ قِصَّتي فِي الأنجُمِ",82,"م",1,0],["هَينٌ عَلَيْهِمْ لَوْ قَذَفْتُ بِهِمَّتي","وَسَعَيتُ مَا بَينَ المَلا أتكَفَّفُ",83,"ف",1,0],["هي نهضة مردية احيا بها","نعوم كل مفاخر الأجداد",84,"د",1,0],["هين علها أن ترى الصبا","يتجرع الأوصاب والكربا",85,"ب",2,1],["هي نور الفؤاد قد شفَّ عنه","ثغر حب به الفؤادُ بهيم",86,"م",1,0],["هي نغمةٌ رَدَّدتُها دهرا","وقضيتُ في ترديدها العمرا",87,"ر",2,1],["هي نُهزةٌ للسائلي","نَ وعن حقوق الحي تُحظَر",88,"ر",1,0],["هَيْنونَ لَيْنونَ أيسارٌ ذوُو كرمٍ","سُوّاسُ مكرمةٍ أبناءُ أيسارِ",89,"ر",1,1],["هَينونَ لينونَ أيسارٌ ذوو يسرٍ","سوّاسُ مكرمةٍ أبناءُ أيسارِ",90,"ر",1,0],["هي نظرة تعقب عليك مضرّة","فاذا تركت فقد فعلت جميلا",91,"ل",2,0],["هِي نَفسٌ إِظلامُها مستمرُّ","وَهيَ روحٌ أَنوارُهُ تَتَلالا",92,"ل",2,0],["هي نار 