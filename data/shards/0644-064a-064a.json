{"poems":[[55,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[55,"لعمرك ما جر ذيل الفخار","https://www.aldiwan.net/poem29861.html","المتقارب"],[29,"ألا أيها القلب الطروب المكلف","https://www.aldiwan.net/poem5922.html","الطويل"],[23,"ما سبني العوام إلا لأنه","https://www.aldiwan.net/poem21468.html","الطويل"],[47,"مدحت أبا العباس للحين ضلة","https://www.aldiwan.net/poem65551.html","الطويل"],[30,"عجبت إلى قيس تضاهي كلابها","https://www.aldiwan.net/poem5623.html","الطويل"],[46,"إذا جاريت في خلق دنيئا","https://www.aldiwan.net/poem30075.html","الوافر"],[71,"بهادر عبدي لا بهاء ولا در","https://www.aldiwan.net/poem28375.html","الطويل"],[54,"تمكن هذا الدهر مما يسوءني","https://www.aldiwan.net/poem26852.html","الطويل"],[119,"لي يا أهيل الجذع تحت ظلالكم","https://www.aldiwan.net/poem41670.html","الكامل"],[136,"وقفت على التليل فبت ليلى","https://www.aldiwan.net/poem54646.html","الوافر"],[170,"إذا كان من عزمي التقدم في العلا","https://www.aldiwan.net/poem47133.html","الطويل"],[447,"لقد برك السهاد على عيوني","https://www.aldiwan.net/poem14390.html","الوافر"],[556,"إن العقيق يزيدني خبلا","https://www.aldiwan.net/poem47321.html","أحذ الكامل"],[563,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96992","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86988","الطويل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44624","الوافر"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199621","المسحوب"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199620","المسحوب"],[873,"","https://poetry.dctabudhabi.ae/diwan/poem/123627","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70819","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120001","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119953","المنسرح"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96631","الوافر"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16713","المتقارب"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56266","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49984","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49924","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21669","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108974","الكامل"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216450",""],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216592",""],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93628","المتقارب"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93681","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93573","الكامل"],[3447,"","https://poetry.dctabudhabi.ae/diwan/poem/32707","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89025","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48321","الطويل"],[3546,"","https://poetry.dctabudhabi.ae/diwan/poem/103363","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138589",""],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45260","الطويل"],[3997,"","https://poetry.dctabudhabi.ae/diwan/poem/132186","الطويل"],[4308,"","https://poetry.dctabudhabi.ae/diwan/poem/34760","الهزج"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216345",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139667",""],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67473","الهزج"],[4849,"ليلة غيابك","https://www.poetsgate.com/ViewPoem.aspx?id=53509",""],[5307,"مرحبا يا حي فضل الله","https://www.poetsgate.com/ViewPoem.aspx?id=10545",""],[592,"أرى طالع الأدبار والنحس قد بدا","https://www.poetsgate.com/ViewPoem.aspx?id=128843",""],[5573,"خاتم ذهب","https://www.poetsgate.com/ViewPoem.aspx?id=200179",""],[5582,"سَرَتْ مِنْ بَرْزَخٍ ناءٍ بَعِيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63484",""],[5582,"طَيْفٌ سَرَى وَثِيابُ اللَّيْلِ أَخْلاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=63545",""],[5848,"محمد بن زايد","https://www.poetsgate.com/ViewPoem.aspx?id=48970",""],[6102,"عي الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=184460",""],[6152,"صباح التفاؤل","https://www.poetsgate.com/ViewPoem.aspx?id=206072",""],[6182,"قَدْر ما يَتَنَهَّدُ الربّانُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86105&r=&rc=2",""]],"verses":[["لي يَقظَةُ الذِئبِ الحَبيثِ فَإِن جَرى","سَفَهٌ فَعِندي نَومَةُ الظَرِبانِ",0,"ن",1,0],["لَئيمٌ تَلَمَّسَ مِنهُ العُلى","وَيَأنَفُ مِن يَدِهِ النائِلُ",1,"ل",1,0],["لَئيمانِ هاذي يَدَّعيها اِبنُ دِرهَمٍ","وَهاذا اِبنُ قَينٍ جِلدُهُ يَتَوَسَّفُ",2,"ف",1,0],["لَئيمٌ دَنِيٌّ فاحِشٌ وَاِبنُ فاحِشٍ","لَئيمُ العُروقِ أَصلُهُ مُتَنازِحُ",3,"ح",1,0],["لَئيمَ الجُدودِ وَالفِعالِ فَما لَهُ","أَبٌ داخِلٌ في الأَكرَمينَ وَلا فِعلُ",4,"ل",1,0],["لَئيمانِ كانا مَولَيَينِ كِلاهُما","ذَليلٌ غَداةَ الرَوعِ وَالحَدَثانِ",5,"ن",1,0],["لَئيمُ الفِعلِ مِن قَومٍ كِرامٍ","لَهُ مِن بَينِهِم أَبَداً عُواءُ",6,"ا",2,0],["لئيمٌ متى أحسنْ إليهِ يكافني","بسيئةٍ لم ينكتمْ عندَهُ سرُّ",7,"ر",1,0],["لَئيمٌ إِذا جادَ اللَئيمُ تَخَلُّقاً","يُحِبُّ سُؤالَ القَومِ شَوقاً إِلى المَنعِ",8,"ع",1,0],["لي يا أهيل الجذع تحت ظلالكم","قلب ثوى طمعاً بحسن نوالكم",9,"م",1,1],["لييلات تعاقبها زُمَين","يبين خنى فويسقة الجعيل",10,"ل",1,0],["لئيِمٌ ويُعْدي لؤمُه جلساءَهُ","ولا غَروَ لو تعدَى الصِحاحُ من الجُرب",11,"ب",1,0],["لييلات الشباب سلبن مني","وعوضني البقا شيب القرون",12,"ن",1,0],["لِي يا عذولي في الهوى شَجَنٌ","لم يخش منّي في هوىً مَلَلا",13,"ل",2,0],["لي يوم بينهمِ جسم بلا رمقٍ","أودى السقام به لي يوم بينهمِ",14,"م",1,0],["لئيم فما للصفح عند اقتداره","محلٌّ وما للحلم أن هاج موقف",15,"ف",1,0],["لَئيم ثَقيل الرُوح فَدْمٍ مفند","مهين مضلّ بِالأَباطيل واثق",16,"ق",1,0],["لَئيمٌ لا يَزالُ يَلُمُّ وَفراً","لِوارِثِهِ فَيَنفَحُ عَن حِماهُ",17,"ه",1,1],["لي يحشون المفارق","مْن الطيب لي معجون",18,"ن",1,0],["لي يمرضنا بْهدابه","ويشافينا حكيْه",19,"ي",2,0],["لئيم لسوداء الجواعر جعدة","على أهلها مما تصر وتحلب",20,"ب",1,0],["لئيمةٌ بنتُ أقوامٍ جدودهمُ","أهيلُ قدرٍ تُحيْتَ التحتِ موضوع",21,"ع",1,0],["لي يا بهاء الدين فيك مدائح","تبقى ومنك مواهب ومنائحُ",22,"ح",1,1],["لي يا طيف السماح رسم","على بني عامر مرتب",23,"ب",1,0],["لييلة أقصتني لييلي وقد سرت","على أورق يدني لها كل شاسع",24,"ع",1,0],["لئيلاتٍ بها كم من غزالٍ","يَصيدُ الأسدَ أَضحى من مصيدِ",25,"د",1,0],["لَئيمٌ إِذا جاءَهُ طارِقٌ","فَقَد جاءَهُ كُلَّ ما ساءَهُ",26,"ا",3,0],["لي يا ابن ودّي مسكن من أصلهِ","ما في قيام بنايهِ تمكينُ",27,"ن",1,0],["لي يا ذهلُ السَّجيّاتُ الرّضَى","والأيادي والعُلى والمفتَخَرْ",28,"ر",1,0],["ليْيثٌ هصورٌ أبو شِبْلَيْنِ جانبُهُ","مُجنّبٌ وحِماهُ غيرُ مقْروبِ",29,"ب",1,0],["لَئيمٌ رَبا وَاللُؤمُ في بَطنِ أُمَّهِ","وَقُلِّدَهُ في المَهدِ قَبلَ التَمائِمِ",30,"م",1,0],["لي يا بني المختار بعد أبيكم","وجد الدفين وللحياة بقاء",31,"ا",2,0],["لِي يَشَتِّيها حَبيبي","نور عيني هو جداه",32,"ا",2,0],["لِيْ يظِنّ يظِنّ بَعَدْ وايِدْ","مَا يظِنّ فِيْ الرّبْ طِشُّونَه",33,"ن",2,0],["لييلات تَشريقنا أظلمت","لبعدك يا ذا المحيّا الأَغر",34,"ر",1,0],["لي يا أَمير عليك حَق مَودة","تَدني البَعيد وَإِن تنائى المَنزل",35,"ل",1,0],["لي يا أَمير عَليك حَق مَودة","هِيَ كَالأخاء وَإِن تَنائى المَولد",36,"د",1,0],["لَئيمُ الفِعلِ أَشأَمُ مِن غُرابٍ","وَضيعُ القَدرِ أَطفَلُ مِن ذُبابِ",37,"ب",1,0],["لئيمٌ لو يكون اللؤم شخصاً","لأضحى منه منزلة الفقاح",38,"ح",1,0],["لَئيمٌ غَدا بالسّوءِ يَبْسُطُ كفَّهُ","ليَقْبِضَ بسْطَ الرّزْقِ واللهُ رازِقُ",39,"ق",1,0],["لئيمُ القومِ يَشتُمني فَيخطِىء","ولو دَمَه سَفكتُ لما خَطيتُ",40,"ت",1,0],["لئيم يرى هتك الحرائر مفخرا","أيقرع ثغر ابن النبي تجبرا",41,"ا",1,0],["لَئيماً ذَميماً اِعجَمِيّاً لِسانُهُ","إِذا نالَ دَنّا لَم يُبالِ المَكارِما",42,"م",2,0],["لييلة أنس يا لها من لييلة","تقضت بأفراح إلى مطلع الفجر",43,"ر",1,0],["لَئيمِ الجَدِّ كابي الزَن","دِ إِمّا اِقتَدَحوا زَندَه",44,"د",2,0],["لي يِعيبْ الشِّعْر يِنْدِب لي سوال","مِنْ كِتَابٍ أو أحَاديِثٍ تِقول",45,"ل",1,0],["لُييلاتُ وصلٍ عمَّ نشراً عبيرُها","وساعاتُ لهوٍ تمَّ بشراً سرورُها",46,"ر",3,1],["لئيم درن الثوب","نظيف القعب والقدرِ",47,"ر",1,1],["لي يالفرح لاعاد تحسب حسابك","حزني مخاويني بكل المشاوير",48,"ر",1,0],["لي ينير الحوش والفله","والحشا منهوب يفلاني",49,"ن",2,0],["لئيم السجايا ناصر الكفر ناصر","لمقدمه حصن الردى قد تشيدا",50,"د",2,0],["لي ياخوي قلب ماسكنته احقودي","لو الهجر والجفا طول به احدادي",51,"د",2,0],["لُيَيْلاتٌ بِها كَمْ مِنْ غَزالٍ","يَصِيدُ الأُسْدَ أَضْحَى مِنْ مَصِيدِي",52,"د",2,0],["[ لِي يا أَبا الطِّيبِ وُدٌّ لَيْسَ يَحْمِلُهُ","قَلْبٌ ( وَلا ) يَدَّعِيهِ فِيكَ مَذَّاقُ ]",53,"ق",1,0],["لي يا محمد ذكرياتٍ جميلة","تخالطت فيها بالافراح الاتراح",54,"ح",1,0],["لِي يَا فُرَاتَ العِشقِ أُغنِيَةٌ","رَثَّتْ فَلا سُمَّاعَ , لا شَدوا",55,"و",2,0],["لي يا صباح تفاؤل لا ينتهي","ما كان فألي يا صباح خيالا",56,"ل",2,1],["لي يأسُ حَطَّابٍ وأنتِ بعيدةٌ","لا الشعرُ، لا الأمطارُ، لا العربانُ",57,"ن",1,0]]}