{"poems":[[55,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[55,"لعمرك ما جر ذيل الفخار","https://www.aldiwan.net/poem29861.html","المتقارب"],[29,"ألا أيها القلب الطروب المكلف","https://www.aldiwan.net/poem5922.html","الطويل"],[23,"ما سبني العوام إلا لأنه","https://www.aldiwan.net/poem21468.html","الطويل"],[47,"مدحت أبا العباس للحين ضلة","https://www.aldiwan.net/poem65551.html","الطويل"],[30,"عجبت إلى قيس تضاهي كلابها","https://www.aldiwan.net/poem5623.html","الطويل"],[46,"إذا جاريت في خلق دنيئا","https://www.aldiwan.net/poem30075.html","الوافر"],[71,"بهادر عبدي لا بهاء ولا در","https://www.aldiwan.net/poem28375.html","الطويل"],[54,"تمكن هذا الدهر مما يسوءني","https://www.aldiwan.net/poem26852.html","الطويل"],[118,"لي يا أهيل الجذع تحت ظلالكم","https://www.aldiwan.net/poem41670.html","الكامل"],[135,"وقفت على التليل فبت ليلى","https://www.aldiwan.net/poem54646.html","الوافر"],[169,"إذا كان من عزمي التقدم في العلا","https://www.aldiwan.net/poem47133.html","الطويل"],[444,"لقد برك السهاد على عيوني","https://www.aldiwan.net/poem14390.html","الوافر"],[553,"إن العقيق يزيدني خبلا","https://www.aldiwan.net/poem47321.html","أحذ الكامل"],[560,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[626,"","https://poetry.dctabudhabi.ae/diwan/poem/123627","الطويل"]],"verses":[["لي يَقظَةُ الذِئبِ الحَبيثِ فَإِن جَرى","سَفَهٌ فَعِندي نَومَةُ الظَرِبانِ",0,"ن",1,0],["لَئيمٌ تَلَمَّسَ مِنهُ العُلى","وَيَأنَفُ مِن يَدِهِ النائِلُ",1,"ل",1,0],["لَئيمانِ هاذي يَدَّعيها اِبنُ دِرهَمٍ","وَهاذا اِبنُ قَينٍ جِلدُهُ يَتَوَسَّفُ",2,"ف",1,0],["لَئيمٌ دَنِيٌّ فاحِشٌ وَاِبنُ فاحِشٍ","لَئيمُ العُروقِ أَصلُهُ مُتَنازِحُ",3,"ح",1,0],["لَئيمَ الجُدودِ وَالفِعالِ فَما لَهُ","أَبٌ داخِلٌ في الأَكرَمينَ وَلا فِعلُ",4,"ل",1,0],["لَئيمانِ كانا مَولَيَينِ كِلاهُما","ذَليلٌ غَداةَ الرَوعِ وَالحَدَثانِ",5,"ن",1,0],["لَئيمُ الفِعلِ مِن قَومٍ كِرامٍ","لَهُ مِن بَينِهِم أَبَداً عُواءُ",6,"ا",2,0],["لئيمٌ متى أحسنْ إليهِ يكافني","بسيئةٍ لم ينكتمْ عندَهُ سرُّ",7,"ر",1,0],["لَئيمٌ إِذا جادَ اللَئيمُ تَخَلُّقاً","يُحِبُّ سُؤالَ القَومِ شَوقاً إِلى المَنعِ",8,"ع",1,0],["لي يا أهيل الجذع تحت ظلالكم","قلب ثوى طمعاً بحسن نوالكم",9,"م",1,1],["لييلات تعاقبها زُمَين","يبين خنى فويسقة الجعيل",10,"ل",1,0],["لئيِمٌ ويُعْدي لؤمُه جلساءَهُ","ولا غَروَ لو تعدَى الصِحاحُ من الجُرب",11,"ب",1,0],["لييلات الشباب سلبن مني","وعوضني البقا شيب القرون",12,"ن",1,0],["لِي يا عذولي في الهوى شَجَنٌ","لم يخش منّي في هوىً مَلَلا",13,"ل",2,0],["لي يوم بينهمِ جسم بلا رمقٍ","أودى السقام به لي يوم بينهمِ",14,"م",1,0],["لئيم لسوداء الجواعر جعدة","على أهلها مما تصر وتحلب",15,"ب",1,0]]}