{"poems":[[53,"لا ترقدن على الأذى","https://www.aldiwan.net/poem30194.html","مجزوء الكامل"],[77,"الحمد لله موصولا كما وجبا","https://www.aldiwan.net/poem36772.html","البسيط"],[85,"لست بناس ليلة","https://www.aldiwan.net/poem8051.html","مجزوء الرجز"],[85,"قم في فم الدنيا وحي الأزهرا","https://www.aldiwan.net/poem63764.html","الكامل"],[45,"فيم ابتداركم الملام ولوعا","https://www.aldiwan.net/poem64665.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[169,"قسماً بأعراف الجياد الضمر","https://www.aldiwan.net/poem1628.html",""],[353,"لا تعتب الوغد اللئيم إذا أسا","https://www.aldiwan.net/poem40167.html","الكامل"],[377,"نار تثير على الضلوع وطيسا","https://www.aldiwan.net/poem59384.html","الكامل"],[406,"قولا له هل دار في حوبائه","https://www.aldiwan.net/poem50212.html","الكامل"],[437,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[441,"يا من له وسط الفؤاد","https://www.aldiwan.net/poem14306.html","مجزوء الكامل"],[458,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[468,"كم نعرة طولتها","https://www.aldiwan.net/poem59604.html","مجزوء الكامل"],[514,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[538,"قد طال بي شوق إلى لقياكا","https://www.aldiwan.net/poem48000.html","عموديه"],[562,"سل مطلع القمرين من كبد السما","https://www.aldiwan.net/poem52944.html","الكامل"]],"verses":[["حَتّى ظَنَنّا اللَّه لَي","سَ بِرازِقٍ إِلّا خَسيسا",0,"س",2,0],["حَتَّى ظَفِرْتُ بِحَظٍّ مِنْهُ أَحْكِمُهُ","حِفظاً فَيَسَّرَ مِنْهُ اللهُ لِي أَرَبَا",1,"ب",2,0],["حَتّى ظَفِرتُ بِالَّتي","عَلَيَّ قَد تَجَرَّتِ",2,"ت",1,0],["حَتّى ظَنَنّا الشافِعِيَّ وَمالِكاً","وَأَبا حَنيفَةِ وَاِبنَ حَنبَلِ حُضَّرا",3,"ر",2,0],["حَتّى ظَفِرتَ بِبَذِّهِم فَتَرَكتَهُ","لِلذُلِّ جانِبُهُ وَكانَ مَنيعا",4,"ع",2,0],["حتَّى ظَفِرْتَ بِهَا وَقَلْبُكَ مُلْهَمٌ","كَشَفَتْ موَاقِعَهَا لَهُ الأَسْرارُ",5,"ر",1,0],["حَتّى ظَنَنّا أَنَّهُ في عَزمِهِ","يَسعى لِيَخرُجَ عَن مَدى الإِسكَندَرِ",6,"ر",1,0],["حَتّى ظَهَرتُ لِوجهِهِ فَرَأيتهُ","قَد خمَّس الفكر الخَبيث وَسدَّسا",7,"س",2,0],["حتى ظفرت من الإله بنعمةٍ","وكذا النفيس يُرَى نداه نفيسا",8,"س",2,0],["حَتّى ظفَرتُ مِنَ المُظَفَّرِ بِالمُنى","عَفواً وتهتُ عَلى الزَمانِ التائِهِ",9,"ا",3,0],["حتى ظفرت بزيد الجود جللني","فواضلا أذهبت همي وأحزاني",10,"ي",1,0],["حتى ظفرت ببعضها","والبعض عز الملمس",11,"س",1,0],["حتى ظننا شبابَه من وفو","رِ الرأي شَيباً في وجهه كُتما",12,"م",2,0],["حَتّى ظَفِرتُ بِسَكرَةٍ","كانَت أَلَذَّ مِنَ الأَماني",13,"ن",2,0],["حتّى ظَفِرْتُ بدُرّةٍ مكنونةٍ","عنها محارةُ خِدْرِها لا تُفلَقُ",14,"ق",1,0],["حَتَّى ظِفرتُ بِرُؤيَةٍ مِن وَجهِهِ","فرأيتُ شخصَه فوق ذاك وذاكَا",15,"ك",2,0],["حتى ظَفِرتُ بحَضرةٍ هيَ كَعْبةٌ","للوَفدِ في شَهرٍ أراهُ مُحَرَّما",16,"م",2,0]]}