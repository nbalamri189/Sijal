{"poems":[[55,"لا ترقدن على الأذى","https://www.aldiwan.net/poem30194.html","مجزوء الكامل"],[79,"الحمد لله موصولا كما وجبا","https://www.aldiwan.net/poem36772.html","البسيط"],[87,"لست بناس ليلة","https://www.aldiwan.net/poem8051.html","مجزوء الرجز"],[87,"قم في فم الدنيا وحي الأزهرا","https://www.aldiwan.net/poem63764.html","الكامل"],[47,"فيم ابتداركم الملام ولوعا","https://www.aldiwan.net/poem64665.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[173,"قسماً بأعراف الجياد الضمر","https://www.aldiwan.net/poem1628.html",""],[358,"لا تعتب الوغد اللئيم إذا أسا","https://www.aldiwan.net/poem40167.html","الكامل"],[382,"نار تثير على الضلوع وطيسا","https://www.aldiwan.net/poem59384.html","الكامل"],[412,"قولا له هل دار في حوبائه","https://www.aldiwan.net/poem50212.html","الكامل"],[443,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[447,"يا من له وسط الفؤاد","https://www.aldiwan.net/poem14306.html","مجزوء الكامل"],[463,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[473,"كم نعرة طولتها","https://www.aldiwan.net/poem59604.html","مجزوء الكامل"],[519,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[543,"قد طال بي شوق إلى لقياكا","https://www.aldiwan.net/poem48000.html","عموديه"],[567,"سل مطلع القمرين من كبد السما","https://www.aldiwan.net/poem52944.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48683","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120078","السريع"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96608","الكامل"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216639",""],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52120","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52090","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53120","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27750","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47102","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129900","الكامل"],[2853,"","https://poetry.dctabudhabi.ae/diwan/poem/102465","الرمل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131948","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76458","البسيط"],[5183,"بين العيد والمدرسة","https://www.poetsgate.com/ViewPoem.aspx?id=185683",""],[5409,"صوني جمالك بالحياء","https://www.poetsgate.com/ViewPoem.aspx?id=155249",""],[5561,"مداولة ..","https://www.poetsgate.com/ViewPoem.aspx?id=193469",""],[5582,"هذِي مَنازِلُهُمْ هَلْ أَنْتَ تُبصِرُها","https://www.poetsgate.com/ViewPoem.aspx?id=187141",""],[5626,"يا غُربتي","https://www.poetsgate.com/ViewPoem.aspx?id=189560",""],[6082,"لن اعود","https://www.poetsgate.com/ViewPoem.aspx?id=58989",""],[6097,"يَقْظَة","https://www.poetsgate.com/ViewPoem.aspx?id=197426",""],[5190,"الحسناء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78290&r=&rc=4",""]],"verses":[["حَتّى ظَنَنّا اللَّه لَي","سَ بِرازِقٍ إِلّا خَسيسا",0,"س",2,0],["حَتَّى ظَفِرْتُ بِحَظٍّ مِنْهُ أَحْكِمُهُ","حِفظاً فَيَسَّرَ مِنْهُ اللهُ لِي أَرَبَا",1,"ب",2,0],["حَتّى ظَفِرتُ بِالَّتي","عَلَيَّ قَد تَجَرَّتِ",2,"ت",1,0],["حَتّى ظَنَنّا الشافِعِيَّ وَمالِكاً","وَأَبا حَنيفَةِ وَاِبنَ حَنبَلِ حُضَّرا",3,"ر",2,0],["حَتّى ظَفِرتَ بِبَذِّهِم فَتَرَكتَهُ","لِلذُلِّ جانِبُهُ وَكانَ مَنيعا",4,"ع",2,0],["حتَّى ظَفِرْتَ بِهَا وَقَلْبُكَ مُلْهَمٌ","كَشَفَتْ موَاقِعَهَا لَهُ الأَسْرارُ",5,"ر",1,0],["حَتّى ظَنَنّا أَنَّهُ في عَزمِهِ","يَسعى لِيَخرُجَ عَن مَدى الإِسكَندَرِ",6,"ر",1,0],["حَتّى ظَهَرتُ لِوجهِهِ فَرَأيتهُ","قَد خمَّس الفكر الخَبيث وَسدَّسا",7,"س",2,0],["حتى ظفرت من الإله بنعمةٍ","وكذا النفيس يُرَى نداه نفيسا",8,"س",2,0],["حَتّى ظفَرتُ مِنَ المُظَفَّرِ بِالمُنى","عَفواً وتهتُ عَلى الزَمانِ التائِهِ",9,"ا",3,0],["حتى ظفرت بزيد الجود جللني","فواضلا أذهبت همي وأحزاني",10,"ن",2,0],["حتى ظفرت ببعضها","والبعض عز الملمس",11,"س",1,0],["حتى ظننا شبابَه من وفو","رِ الرأي شَيباً في وجهه كُتما",12,"م",2,0],["حَتّى ظَفِرتُ بِسَكرَةٍ","كانَت أَلَذَّ مِنَ الأَماني",13,"ن",2,0],["حتّى ظَفِرْتُ بدُرّةٍ مكنونةٍ","عنها محارةُ خِدْرِها لا تُفلَقُ",14,"ق",1,0],["حَتَّى ظِفرتُ بِرُؤيَةٍ مِن وَجهِهِ","فرأيتُ شخصَه فوق ذاك وذاكَا",15,"ك",2,0],["حتى ظَفِرتُ بحَضرةٍ هيَ كَعْبةٌ","للوَفدِ في شَهرٍ أراهُ مُحَرَّما",16,"م",2,0],["حتى ظفرت لهم بخير وسيلة","في كل مملكة وأقوى جانب",17,"ب",1,0],["حتى ظباء القاع في كنسها","من أذؤب الردهة منصوفَه",18,"ف",2,0],["حتّى ظفرت الآن وَاِستفتحت ما","هو من مغالقِ فتحه مستصعبُ",19,"ب",1,0],["حَتَّى ظِلَالِكْ خايفٍ ما تعدّاك","كنّه تهوَّب خَطُوِتك يَوْم تَمّ",20,"م",1,0],["حتى ظفرت بدولة","منها وغاب الحسّد",21,"د",1,0],["حَتى ظَفِرتَ بِإرثٍ كُنتَ تَطْلُبُهُ","وَكَانَ مَا كَانَ مِما عِلمُهُ عَلَنُ",22,"ن",1,0],["حتى ظفرت بزورة نزهتها","مع ما بقلبي أن تشاب بمنكر",23,"ر",1,0],["حتى ظهرت فذابوا كالرصاصِ يرى","تذيبه النار بالأبصار والمقل",24,"ل",1,0],["حتَى ظللتُ من الصّبابة عِبْرَةً","لأولي البصائرِ سائِلَ العبراتِ",25,"ت",1,0],["حتى ظباهم في الحياء مثالهُم","أبدت وقد أردت محَيّا أحمَرا",26,"ر",2,0],["حتّى ظنَنتُها أنّي","وكانَت روحي فداها",27,"ا",3,0],["حتى ظفرت به فصغته رائقا","مدحا لضيف مدينة الآثار",28,"ر",1,0],["حَتّى ظفرت وَكادَ الصدر من جَذَل","يَرتاح من أَلم في الصدر ما خرجا",29,"ج",2,0],["حتى ظفرت به على شرع الرضا","فبصرت أملده وذل قطوفه",30,"ف",2,0],["حتى ظفرت بما حلا","لك من فماتنها وطابا",31,"ب",2,0],["حتى ظننت بأن حبك قد مضى","وإذا الظنون تزيد فيَّ هموما",32,"م",2,0],["حَتَّى ظَلَلْنَ رِياضُ الحَزْنِ أَبْيَضُها","فِيها يُضاحِكُها بِالزَّهْرِ أَخْضَرُها",33,"ر",3,0],["حَتّى ظَنَنّا بِأنَّ السَّعْدَ نَعْزِفُهُ","لَحْناً جَميلاً ، لِهذا العُمْرِ ، خَفّاقا",34,"ق",2,0],["حتّى ظننت بأنّ الناس قد هلكوا","والكون خال من العصفور والشجر",35,"ر",1,0],["حتّى ظهرتِ (كيَقظةٍ)","والقلبُ فيكِ تعثَّرا",36,"ر",2,0],["حتى ظَهَرْتِ فكاد يذوي مُطرقاً","وتساقطت أوراقُهُ الخضراءُ",37,"ا",2,0]]}