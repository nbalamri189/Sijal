 كسب العلا","https://www.aldiwan.net/poem32221.html","الكامل"],[417,"تذكر عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53977.html","الطويل"],[417,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[430,"كفي فإن سحاب الجفن قد وكفا","https://www.aldiwan.net/poem41398.html","البسيط"],[433,"بعثت به حنانا أم جنانا","https://www.aldiwan.net/poem12424.html","الوافر"],[433,"لذي الظلامة عد الظلم والشنب","https://www.aldiwan.net/poem12438.html","البسيط"],[433,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[433,"علمنا وقد مات الكمال التساويا","https://www.aldiwan.net/poem12769.html","الطويل"],[440,"سلام على مستودع الروح والنفس","https://www.aldiwan.net/poem34839.html","الطويل"],[440,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[440,"أعاره النرجس من لونه","https://www.aldiwan.net/poem34901.html","السريع"],[459,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[459,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[459,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[459,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[459,"إما تقومون كذا أو فاقعدوا","https://www.aldiwan.net/poem56238.html","الرجز"],[459,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[465,"أتهويماً وليل الهم داجي","https://www.aldiwan.net/poem3585.html","عموديه"],[480,"الحب داء دفين","https://www.aldiwan.net/poem36935.html","المجتث"],[501,"يستغرب الخب أن نعلو وقد برزت","https://www.aldiwan.net/poem37809.html","البسيط"],[501,"تحت شراع الرفرف","https://www.aldiwan.net/poem37961.html","مجزوء الرجز"],[516,"لك الحسب الباقي على عقب الدهر","https://www.aldiwan.net/poem12142.html","الطويل"],[517,"ولولا ان يقال صبا نصيب","https://www.aldiwan.net/poem48682.html","الوافر"],[552,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[552,"مرت بنا بمصلى الخيف سانحة","https://www.aldiwan.net/poem47343.html","البسيط"],[552,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[552,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"رأيت طرفك يوم البين حين همى","https://www.aldiwan.net/poem3020.html","البسيط"],[576,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"]],"verses":[["وَلَو رَدَّ مَيتاً وَجدُ ذي الوَجدِ بَعدَه","لِرَدِّكَ وَجدي وَالدُموعُ السَوارِبُ",0,"ب",1,0],["وَلَو رَقَّ لي قَلباكُما لارتَدَيتُما","بِلَيلٍ مَريضِ النَّجمِ أَسوَدَ حالِكِ",1,"ك",1,0],["وَلَو رامَ عَمروٌ وَالمُغيرَةُ غِرَّتي","لأَعيَتهُما فَليَحذَرِ الشَرَّ جالِبُهْ",2,"ب",2,0],["وَلَوْ رَأَتِ البُدورُ نِعالَ خَيْلي","لَصِرْنَ بِها حَواسِدَ لِلأَهِلَّهْ",3,"ل",2,0],["وَلَوْ رَآني ابْنُ هِنْدٍ عَضَّ أَنْمُلَهُ","غَيْظَاً على أُمَويٍّ يَمْدَحُ النَّاسَا",4,"س",2,0],["ولَوْ رَضِيتُ حَبَّرَتْ رُواتُها","بِها كَلامَ العَرَبِ الأوائِلِ",5,"ل",1,0],["وَلَو رُمتَ في لَيلَةٍ قادِحاً","حَصاةً بِنَبعٍ الأورَيتَ نارا",6,"ر",2,0],["وَلَو رُحتُ أَنعَتُ تِلكَ الضُروبَ","لَضاقَ القَريضُ وَأَعيا بِها",7,"ا",1,0],["وَلَو رَأى اِبنَ جُرَيجٍ في قَصائِدِهِ","لَقالَ آمَنتُ في سِرّي وَإِعلاني",8,"ن",2,0],["وَلَو رَأَيتَ المِطواعَ يَنظُرُ في ال","تَشريحِ كَيفَ الفَقارُ في الصُلبِ",9,"ب",1,0],["وَلَو رَأَيت بُكاهُم عِندَ بَيعهمُ","لَهالَكَ الأَمرُ وَاِستَهوَتكَ أَحزانُ",10,"ن",1,0],["ولو رام إدراك النجوم بحيلة","لأحرزَ من إدراكها ما يُحاولُ",11,"ل",1,0],["ولو رضِيَت نفسي بأمرٍ يَشيِنها","لما نطقت بالشعر إلاّ أهاجيا",12,"ي",2,0],["وَلَو رَقَّعَت كيرَيكَ كانَت كَظاعِنٍ","مِنَ الغَيثِ يَختارُ الجُدوبَةَ وَالمَحلا",13,"ل",2,0],["وَلَو رَدَّ يَوماً حَمزَةَ الخَيرِ حُزنُها","إِذاً ما عَلَتها رَنَّةٌ وَعَويلُ",14,"ل",1,0],["ولو رجا المشتري إدراكَ غايتِه","لدافعته عصاً في كفِّ جوزاء",15,"ا",2,0],["ولَو رأى ذا غيْرَةٍ","في بيْتِهِ أو بلَدِهْ",16,"د",2,0],["ولو رجا ودك دون الجدا","ما كظ ما قد سُمتَه وُسعه",17,"ع",2,0],["ولو رأيت اليأس من عفوه","لم ير مني هذه الخنعه",17,"ع",2,0],["ولو رأوه لسارتْ كي تحارِبَه","من الوَرَى زُمَرٌ في إثرِها زُمَرُ",18,"ر",1,0],["وَلَو رَآهُ حَوارِيّوهُمُ لَبَنوا","عَلى مَحَبَّتِهِ الشَرعَ الَّذي شَرَعوا",19,"ع",3,0],["وَلَو رَفَعَ الإِلَهُ إِلَيهِ قَوماً","لَحِقنا بِالسَماءِ مَعَ السَحابِ",20,"ب",1,0],["وَلَو رَفَعَ السَحابُ إِلَيهِ قَوماً","عَلَونا في السَماءِ إِلى السَحابِ",21,"ب",1,0],["وَلَو رُدَّ المَهَلَّبُ حَيثُ ضَمَّت","عَلَيهِ الغافَ أَرضُ أَبي صُفارِ",22,"ر",1,0],["وَلَو رَضِيَت يَدايَ بِها وَقَرَّت","لَكانَ لَها عَلى القَدَرِ الخِيارُ",23,"ر",1,0],["وَلَو رُزِئَت مِثلَيهِما هَضبَةُ الحِمى","لَأَصبَحَ ما دارَت مِنَ الأَرضِ بَلقَعا",24,"ع",2,0],["وَلَو رامَها أَحَدٌ غَيرُهُ","لَزُلزِلَتِ الأَرضُ زِلزالَها",25,"ل",3,0],["وَلَو رَشَفَ الرِعديدُ فاضِلَ كَأسِها","عَلى ضُعفِهِ ظَنَّتهُ عَنتَرَها عَبسُ",26,"س",1,0],["وَلَو رَعى أَلكَنٌ عِبارَتَهُ","أَزالَ مِن سِحرِ لَفظِهِ لَكنَه",27,"ن",2,0],["وَلَو رَأوا ما أَرى مِن فَرطِ لَذَّتِهِ","بِالجودِ ما شَكَروا يَوماً وَلا حَمِدوا",28,"د",3,0],["ولو رآك زهيرٌ في العلى لثنى","لسانَهُ في كريمِ المدح عن هرمِ",29,"م",1,0],["وَلَوْ رَاجَعُوا هَذِي النُّفُوسَ لَعَالَجُوا","بِتَرْكِ الْخَطَايَا مُعْضِلَ الدَّاءِ بِالْحَسْمِ",30,"م",1,0],["ولو رمتُ هجوَ الشمسِ قلتُ قرونَها","طوالٌ وقدْ كانتْ سراجَ ثمودِ",31,"د",1,0],["ولو رمْتُ ذَمَّ البدرِ شبهتُ وجهَهُ","بدفِّ بغيٍّ أو بخفِّ قعودِ",31,"د",1,0],["ولو رعاني قمري","ما كنتُ أرعى قمركْ",32,"ك",1,0],["ولو رمْتُ في وصلِها جهلةً","لما كانَ للسرِّ مستودَعُ",33,"ع",1,0],["ولوْ رامَ غيرَ القدسِ كنتُ منعتهُ","وكيفَ يجوزُ المنعُ عن حضرةِ القدْسِ",34,"س",1,0],["وَلَو رَكِبَ الجِواءَ بِمصرَ سَعدٌ","لَقُلنا لَيتَهُ رَكِبَ السَحابا",35,"ب",2,0],["ولو رَهنُوني وكتبي معاً","مع الشِّعرِ والظَّرفِ والمحبرَة",36,"ر",2,0],["وَلَو رَدَّت جِنانُ مَرَدَّ خَيرٍ","تَبَيَّنَ ذاكَ في وَجهِ الرَسولِ",37,"ل",1,0],["وَلَو رَآني سَيّئاً في الهَوى","لَقالَ لي أَبعَدَكَ اللَهُ",38,"ل",3,0],["وَلَو رَضيتُ دونَ النُفوسِ بِغَيرِها","لَحُطَّت بِعَفوٍ لا قِصاصَ جُروحُها",39,"ح",3,0],["وَلَو رَقى الطِفلَ عيسى أَو أُعيدَ لَهُ","بُقراطُ ما كانَ مِن مَوتٍ يُوَقّيهِ",40,"ق",3,0],["ولو رُفعَتْ سُرُوجُكَ في ظَلامٍ","على بُهُمٍ جَعَلْنَ لها وُضُوحا",41,"ح",2,0],["ولو رَسَمَ الرّاقي حُرُوفَ اسمِها على","جَبينِ مُصابٍ جُنّ أبْرَأهُ الرسم",42,"م",1,0],["وَلَوْ رُمْتُ مَا رَام امْرُؤٌ بِخِيَانَةٍ","لَصَبَّحنِي قِسْطٌ مِنَ الْمَالِ غَامِرُ",43,"ر",1,0],["وَلَو رُدَّ بِالرِزءِ ما تَستَحِقُّ","لَما كانَ لي في حَياةٍ أَرَب",44,"ب",1,0],["وَلَو رَجمتُ ثبيراً","بِعَقلِهِ لَهَدَدتُه",45,"ت",2,0],["ولوردةٍ عائت حياةَ الورود، ما","راعَ ابنها، أو راعَها ببنائه",46,"ا",3,0],["ولو رُمتُ للعَوْرات كشفاً أريتُكُمْ","من الناس حتى الأنبياءِ عجائبا",47,"ب",2,0],["ولوْ رسمَ الرَّقي حروفَ اسمها على","جبينِ مصابٍ جنَّ أبرأهُ الرَّسمُ",48,"م",1,0],["ولو رأتك زليخا وهي مسرعة","نحو القميص لما قامت على قدم",49,"م",1,0],["وَلَو رُمتَهُم لَم يَعِزّوا عَلَيكَ","وَلَو أَنَّهُم في مُتونِ السُحُب",50,"ب",1,0],["وَلَو راءَها البَدرُ في تَمِّهِ","وَكانَت لَهُ قُدرَةٌ لِاِستَتَر",51,"ر",1,0],["وَلَو رَأَتكَ مُلوكٌ أَنتَ تاجُهُمُ","لَأَذعَنوا وَأَقَرّوا أَنَّهُم خَوَلُ",52,"ل",1,0],["وَلَو رُموا بِكَ في الهَيجاءَ لَم يَجِدوا","إِلّا إِلى ظِلِّكَ المَمدودِ مُنهَزَما",53,"م",2,0],["ولو رمت أن آتي على كل شرحه","لما قام لي طرسٌ ولا استطعت اكتبُ",54,"ب",1,0],["ولو رأته لظلّت وهي كاسفةٌ","وغيّرتها بفرطِ الغيرة الغيَرُ",55,"ر",1,0],["ولو رأى أدنى صدود لأتى","منه وعيد بالفراق مرعب",56,"ب",1,0],["ولو رد من ناجاك للغير طرفه","تميزت من غيظ عليه وغيره",57,"ه",1,0],["ولو رجعت إلى عقل ومعرفة","جعلت ما قلته مما تواريه",58,"ي",2,0],["ولو رأوه كما قلتم وخاطبهم","لما شكوا فقدما الرحمن يوحيه",58,"ي",2,0],["ولو رأى حاتمُ الطائيُّ أَيْسَرَ ما","يُعْطِي لأيقنَ أنَّ الشُّحَّ مَذْهبُه",59,"ب",2,0],["ولو رُمْتُ أن أنساكمُ ذَكَّرتْ بكم","محاسنُ فعلٍ مثل منتظِم العِقد",60,"د",1,0],["ولو رآها بعين العيش خالفها","على الهوى ورأى مختارها عار",61,"ر",1,0],["ولو رفعوها فوقَ غيرِ ضِعافِهم","لما وجدوها آخرَ الدهرِ ترفعُ",62,"ع",1,0],["ولو روى الفلكُ الدوارُ حكمتهُ","لامستِ الشهبُ فيهِ كلها سورُ",63,"ر",1,0],["ولو رأتهُ الأسدُ في غابها","رأتء مذلَّ الأسدِ الخادرِ",64,"ر",1,0],["ولو رأى البدر ليلا حسن طلعته","تجلى لولى بلون منه مكسوف",65,"ف",1,0],["وَلَو رامَ الحَياةَ نَجا إِلَيها","بِعَزمَتِهِ نَجاءَ المَضرَحِيِّ",66,"ي",1,0],["وَلِوِردِ جودِكَ أَن يُكَدَّرَ شُربُهُ","وَلِوَجهِ بِرِّكَ أَن يُرى مُتَجَهِّما",67,"م",2,0],["وَلَو رُمتَ مِنِّيَ بيضَ الأَنوُقِ","وَعَنقاءَ مَغرِبَ لَم تُعوِزِ",68,"ز",1,0],["وَلَو رَأَوهُ في جَحفَلٍ صَعِقوا","أَو شَهِدوهُ في مَحفَلٍ سَجَدوا",69,"د",3,0],["ولو رأى البدرُ المنيرُ وَجهَهُ","هَلَّلَ إجلالا له وكبَّرا",70,"ر",2,0],["ولورمته لم ينج لكن انفت ان","تحاول من رام الفرار عن الطعن",71,"ن",1,0],["ولو رأى مرحب في الحرب موقعه","والضرب ولىّ حليف الويل والحرب",72,"ب",1,0],["ولَو رامَ السلُوّ أَبَتْ عَلَيه","مَعاهدُ عَهدها الماضي حَميدُ",73,"د",1,0],["وَلَوْ راعى ذَوِي الأَخْطارِ دَهْرٌ","رَعى ذا الْمَجْدَ وَالشَّرَفَ الْخَطِيرا",74,"ر",2,0],["وَلَوْ رَكِبَ النَّاسُ الْغِنى بِبَرَاعَةٍ","وَفَضْلٍ مُبِينٍ كُنْتُ أَوَّلَ رَاكِبِ",75,"ب",1,0],["ولو راعه عمرٌ تكامل أَلفُهُ","لما راعَ نوحاً في السنينِ الدكائك",76,"ك",1,0],["وَلَو رَدَّ عَنهُ المَوتَ بَأسٌ لَأَزهَقَت","شِفارُ المَواضي أَنفُساً وَالقَنا اللُدنا",77,"ن",2,0],["وَلَو رَآكَ اِبنُ العَميدِ مَنشَئاً","يا اِبنَ العَميدِ عادَ مَقطوعَ النَسَب",78,"ب",1,0],["ولَو رُدَّ عنك الحتفُ بالبأس لم يَقف","سِنانيَ عَن طعنٍ وَسيفيَ عَن بَتكِ",79,"ك",1,0],["وَلَو رآه عاذلي لا رأى","أَصبحَ لا أَصبحَ لي عاذِرا",80,"ر",2,0],["ولو رجعت لأهلي","كانت بلادي بلادا",81,"د",2,0],["ولو رأى أمردٌ أن يستبيح دمي","إذا لقام بنصري معشرٌ خشن",82,"ن",1,0],["ولو رأى وجهك المفدى","وما تغشاه من سناك",83,"ك",1,0],["ولو رام إشجائي اِعتراض عتابه","توهّمته السلسالَ من سائغٍ عذبِ",84,"ب",1,0],["ولو روعي الضر الذي فيهما لنا","ولم يخلقنا لاختل نظم الخليقة",85,"ه",1,0],["وَلَوْ رَأَوْا مَن رَأَيْنا قالَ قائلُهُمْ","لَوَ أنَّهُمْ ضُرِبُوا بالسَّيْفِ ما شَعَرُوا",86,"ر",3,0],["وَلوَ رامَ حَلَّ قَفَا نَفسهِ","لَمَا كانَ فيهِ لهُ مَوْضِعُ",87,"ع",1,0],["وَلَوْ رَأَيتُ بُدُورَ التِّمِّ طالعِةً","وَدَدْتُها أَصبَحتْ في قُفَّتي رُغُفَا",88,"ف",2,0],["وَلَو رَأَيتَ حَبيبي","لَقُلتَ ذا رَبُّ رَبّي",89,"ب",2,0],["وَلَو رَأَوهُ بِعَيني","لِاِستَحسَنوا ما أَعابوا",90,"ب",3,0],["ولو رأَى في الكَرى ما نِلّتُه أَحَدٌ","لَهَزَّ ما عاشَ عِطْفُيْهِ منَ التِّيه",91,"ي",2,0],["ولو ركضوا على الأفلاك صارَتْ","أَهِلّتُها طِراقاً للنِّعال",92,"ل",1,0],["وَلَو رُمتَ تَقديراً لَما كُنتَ قادِراً","وَهَل يَترُكُ الإِنسانُ ما يَتَعَوَّدُ",93,"د",1,0],["ولو رأى الزَّهْرُ في الواحاتِ بَسْمَتَه","لَمَا حَبَانا الشَّذا يوماً ولا ازدهَرا",94,"ر",2,0],["ولو رآها نسيمُ الفجر حاضرةً","على ضِفافِ الرَّبيعِ الطَّلْقِ ما حَضَرا",94,"ر",2,0],["وَلَو راءَ ما يبنيه حاتِم طَيِّها","لَقالَ كَذا تَبنى العُلى وَالمآثِرُ",95,"ر",1,0],["ولو رقوا في ذرى ثهلان أسلمهم","لسيفه العاصمان الحصن والوزر",96,"ر",1,0],["ولو رأَى الجوهريّ ألفاظَها الْ","غُرِّ لَما شَكَّ أنّها دُرَرُ",97,"ر",1,0],["ولو رامَ أنْ يرقى إلى النَّجم لارتقى","ويوشك ربّ الفضل أنْ يبلغ السَّما",98,"م",2,0],["ولو رآك طرفه لما ارتضى","إلاَّ بأنْ تسمو إلى أوج السما",99,"ا",1,0],["ولو رأى وجهك الوضاح بدر دجى","لعاد مستترا أو راح منخسفا",100,"ف",2,0],["ولو رامَ ابْنُ هانِىٍءٍ اتِّصالاً","بصعب مَرَامِها يوماً لهانا",101,"ن",2,0],["ولو رفعْنَ سُتورَ الحُجْب لانْسدَلَتْ","من العفافِ على عاداتِها الحُجُبُ",102,"ب",1,0],["ولو رأيتَ من هَويْتُ قربَهُ","رأيتَ فرْضاً في العباد حبَّهُ",103,"ه",1,0],["ولو رامَه شاكي السِلاحِ مُحسَّداً","لراح كما لا يشتهي عنه شاكيا",104,"ي",2,0],["ولو رُدَّ فِيَّ الرُّوحُ من قَتْلِ قاتِلٍ","لما باتَ من ذمِّي وعَتْبي عَلَى وَجْسِ",105,"س",1,0],["ولَوْ رُدَّ فِي المنصور روحُ حياتِهِ","غداةَ لقيتَ الموتَ والموتُ عُرْيانُ",106,"ن",1,0],["ولوْ رَجا عبدَ المليكِ الَّذِي","تأَدَّبَ الدهرُ بتَأديبِهِ",107,"ب",2,0],["ولو رعى الحقَّ وإنصافَه","ما فاز بالقِدْح سِوى أسهمي",108,"م",2,0],["ولو رآك مَن رأى بنظري","وخُبرتي قال بليغٌ صدَقا",109,"ق",2,0],["ولو رأتْ وجهَ الجحودِ جَحَدت","وإنما ضرورة إقرارُها",110,"ر",3,0],["ولو راض خلقُك لؤمَ الزمان","لعلَّمه المجدَ والسؤددا",111,"د",2,0],["ولو ركبتُ أرحلاً لكان لي","فيك بُراقٌ بالمنى مزوَّدُ",112,"د",1,0],["ولو رُدَّ قبلي الموتُ بالشِّعر أو مضى","شَبا لَسِنٍ أو عاش في الدهر مُفصِحُ",113,"ح",1,0],["ولو ركبتْ لتقنص الأماني","بنان يدٍ تسالم في الهياج",114,"ج",1,0],["ولو رقاك الأمين","لما وجدت انحلالا",115,"ل",2,0],["ولو رَمَقْتُ لِعَبدٍ أسْوَدٍ لَسَما","ساداتِهِ وتَعالى ذِرْوَةَ الأمَلِ",116,"ل",1,0],["ولو رآهُ أَفقَرٌ","عن كلِّ مَخْلوقٍ كُفي",117,"ف",2,0],["ولو رجعت مصر إلى الكفر لانطوى","بساط الهدى من ساحل البر والبحر",118,"ر",1,0],["وَلَو رَأَت الفَراشَةُ طار مِنها","مَعَ الاِرواحِ روح مُستَطار",119,"ر",1,0],["وَلَو رأتْ وجهَها شمسُ النّهارِ وقدْ","ألْقَتْ معارجها غابتْ من الخَجلِ",120,"ل",1,0],["ولو رميتِ ورَيْعانُ الشّباب معي","أصميتِ منِّيَ مَن بالحبّ أصماكِ",121,"ك",1,0],["ولو رأيتُك دون النّاسِ كلِّهِمُ","قَضيتُ مِن هَذهِ الدّنيا لُباناتي",122,"ت",2,0],["ولو رابه منكُمُ ما أرا","بَ شآكمْ وَلكن لم يَرْتَبِ",123,"ب",1,0],["ولو رأى الوصي أن الفعلة","قد اعتدوا أقاد ممن قتله",124,"ه",1,0],["ولو رأَى ابنُ أَبي سُلمى مواهِبَه","رأَى جَدَا هَرمٍ مثل اسمه هَرِما",125,"م",2,0],["ولو رشَدُوا كانُوا رَضوا بالَّذي قَضَى","به الله لكن رُبَّما خفِي الرُّشْدُ",126,"د",1,0]]}