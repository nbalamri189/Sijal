n/poem/124158","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131199",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135341","البسيط"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95322","الطويل"],[3982,"","https://poetry.dctabudhabi.ae/diwan/poem/18399","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101356","الوافر"],[4048,"","https://poetry.dctabudhabi.ae/diwan/poem/110654","الطويل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78249","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127329","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123498","المنسرح"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94801","الطويل"],[4243,"","https://poetry.dctabudhabi.ae/diwan/poem/122434","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81731","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73231","الرجز"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115322","الطويل"],[4449,"","https://poetry.dctabudhabi.ae/diwan/poem/143719","البسيط"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96078","السريع"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136446",""],[4723,"إشراقة الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=61979",""],[4729,"يَا علَم المُلك افتخر","https://www.poetsgate.com/ViewPoem.aspx?id=109475",""],[1901,"أما في الناس من رجلِ رشيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=160409",""],[4859,"مثقال!","https://www.poetsgate.com/ViewPoem.aspx?id=202341",""],[4859,"ملّ العواذل!","https://www.poetsgate.com/ViewPoem.aspx?id=207463",""],[5039,"المشاعر وربما ألم شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=48109",""],[5050,"أرى الأيام لي حربا","https://www.poetsgate.com/ViewPoem.aspx?id=38212",""],[3271,"التائهة","https://www.poetsgate.com/ViewPoem.aspx?id=131013",""],[585,"سلوه وقد مال السرير المطنب","https://www.poetsgate.com/ViewPoem.aspx?id=161851",""],[5083,"بُنودُ الشَّام","https://www.poetsgate.com/ViewPoem.aspx?id=53878",""],[5183,"مُلْغِزَه رق73م","https://www.poetsgate.com/ViewPoem.aspx?id=186395",""],[5213,"أين العذيب وآرام بواديه","https://www.poetsgate.com/ViewPoem.aspx?id=170569",""],[5225,"رد صاحب السمو الشيخ زايد بن سلطان آل نهيان على قصي","https://www.poetsgate.com/ViewPoem.aspx?id=27613",""],[5397,"بكيت شجواً على الأطلال والدمن","https://www.poetsgate.com/ViewPoem.aspx?id=157909",""],[5431,"عجبتُ لمن يرى في الجوع ربّا !!....","https://www.poetsgate.com/ViewPoem.aspx?id=202210",""],[5463,"زاد شكّك في غرامي","https://www.poetsgate.com/ViewPoem.aspx?id=30343",""],[5605,"ستُونَ عَامًا","https://www.poetsgate.com/ViewPoem.aspx?id=160307",""],[5717,"يا حسرة من فؤاد محتدم","https://www.poetsgate.com/ViewPoem.aspx?id=170590",""],[402,"أهدي إلى عالي المقام","https://www.poetsgate.com/ViewPoem.aspx?id=36221",""],[520,"طرقتها والليل وحف الجناح","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577464",""],[6317,"هذا الجمال !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86083&r=&rc=1",""],[6344,"طُقُوسُ العاشِقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87967&r=&rc=7",""]],"verses":[["وَلَو رَدَّ مَيتاً وَجدُ ذي الوَجدِ بَعدَه","لِرَدِّكَ وَجدي وَالدُموعُ السَوارِبُ",0,"ب",1,0],["وَلَو رَقَّ لي قَلباكُما لارتَدَيتُما","بِلَيلٍ مَريضِ النَّجمِ أَسوَدَ حالِكِ",1,"ك",1,0],["وَلَو رامَ عَمروٌ وَالمُغيرَةُ غِرَّتي","لأَعيَتهُما فَليَحذَرِ الشَرَّ جالِبُهْ",2,"ب",2,0],["وَلَوْ رَأَتِ البُدورُ نِعالَ خَيْلي","لَصِرْنَ بِها حَواسِدَ لِلأَهِلَّهْ",3,"ل",2,0],["وَلَوْ رَآني ابْنُ هِنْدٍ عَضَّ أَنْمُلَهُ","غَيْظَاً على أُمَويٍّ يَمْدَحُ النَّاسَا",4,"س",2,0],["ولَوْ رَضِيتُ حَبَّرَتْ رُواتُها","بِها كَلامَ العَرَبِ الأوائِلِ",5,"ل",1,0],["وَلَو رُمتَ في لَيلَةٍ قادِحاً","حَصاةً بِنَبعٍ الأورَيتَ نارا",6,"ر",2,0],["وَلَو رُحتُ أَنعَتُ تِلكَ الضُروبَ","لَضاقَ القَريضُ وَأَعيا بِها",7,"ا",1,0],["وَلَو رَأى اِبنَ جُرَيجٍ في قَصائِدِهِ","لَقالَ آمَنتُ في سِرّي وَإِعلاني",8,"ن",2,0],["وَلَو رَأَيتَ المِطواعَ يَنظُرُ في ال","تَشريحِ كَيفَ الفَقارُ في الصُلبِ",9,"ب",1,0],["وَلَو رَأَيت بُكاهُم عِندَ بَيعهمُ","لَهالَكَ الأَمرُ وَاِستَهوَتكَ أَحزانُ",10,"ن",1,0],["ولو رام إدراك النجوم بحيلة","لأحرزَ من إدراكها ما يُحاولُ",11,"ل",1,0],["ولو رضِيَت نفسي بأمرٍ يَشيِنها","لما نطقت بالشعر إلاّ أهاجيا",12,"ي",2,0],["وَلَو رَقَّعَت كيرَيكَ كانَت كَظاعِنٍ","مِنَ الغَيثِ يَختارُ الجُدوبَةَ وَالمَحلا",13,"ل",2,0],["وَلَو رَدَّ يَوماً حَمزَةَ الخَيرِ حُزنُها","إِذاً ما عَلَتها رَنَّةٌ وَعَويلُ",14,"ل",1,0],["ولو رجا المشتري إدراكَ غايتِه","لدافعته عصاً في كفِّ جوزاء",15,"ا",2,0],["ولَو رأى ذا غيْرَةٍ","في بيْتِهِ أو بلَدِهْ",16,"د",2,0],["ولو رجا ودك دون الجدا","ما كظ ما قد سُمتَه وُسعه",17,"ع",2,0],["ولو رأيت اليأس من عفوه","لم ير مني هذه الخنعه",17,"ع",2,0],["ولو رأوه لسارتْ كي تحارِبَه","من الوَرَى زُمَرٌ في إثرِها زُمَرُ",18,"ر",1,0],["وَلَو رَآهُ حَوارِيّوهُمُ لَبَنوا","عَلى مَحَبَّتِهِ الشَرعَ الَّذي شَرَعوا",19,"ع",3,0],["وَلَو رَفَعَ الإِلَهُ إِلَيهِ قَوماً","لَحِقنا بِالسَماءِ مَعَ السَحابِ",20,"ب",1,0],["وَلَو رَفَعَ السَحابُ إِلَيهِ قَوماً","عَلَونا في السَماءِ إِلى السَحابِ",21,"ب",1,0],["وَلَو رُدَّ المَهَلَّبُ حَيثُ ضَمَّت","عَلَيهِ الغافَ أَرضُ أَبي صُفارِ",22,"ر",1,0],["وَلَو رَضِيَت يَدايَ بِها وَقَرَّت","لَكانَ لَها عَلى القَدَرِ الخِيارُ",23,"ر",1,0],["وَلَو رُزِئَت مِثلَيهِما هَضبَةُ الحِمى","لَأَصبَحَ ما دارَت مِنَ الأَرضِ بَلقَعا",24,"ع",2,0],["وَلَو رامَها أَحَدٌ غَيرُهُ","لَزُلزِلَتِ الأَرضُ زِلزالَها",25,"ل",3,0],["وَلَو رَشَفَ الرِعديدُ فاضِلَ كَأسِها","عَلى ضُعفِهِ ظَنَّتهُ عَنتَرَها عَبسُ",26,"س",1,0],["وَلَو رَعى أَلكَنٌ عِبارَتَهُ","أَزالَ مِن سِحرِ لَفظِهِ لَكنَه",27,"ن",2,0],["وَلَو رَأوا ما أَرى مِن فَرطِ لَذَّتِهِ","بِالجودِ ما شَكَروا يَوماً وَلا حَمِدوا",28,"د",3,0],["ولو رآك زهيرٌ في العلى لثنى","لسانَهُ في كريمِ المدح عن هرمِ",29,"م",1,0],["وَلَوْ رَاجَعُوا هَذِي النُّفُوسَ لَعَالَجُوا","بِتَرْكِ الْخَطَايَا مُعْضِلَ الدَّاءِ بِالْحَسْمِ",30,"م",1,0],["ولو رمتُ هجوَ الشمسِ قلتُ قرونَها","طوالٌ وقدْ كانتْ سراجَ ثمودِ",31,"د",1,0],["ولو رمْتُ ذَمَّ البدرِ شبهتُ وجهَهُ","بدفِّ بغيٍّ أو بخفِّ قعودِ",31,"د",1,0],["ولو رعاني قمري","ما كنتُ أرعى قمركْ",32,"ك",1,0],["ولو رمْتُ في وصلِها جهلةً","لما كانَ للسرِّ مستودَعُ",33,"ع",1,0],["ولوْ رامَ غيرَ القدسِ كنتُ منعتهُ","وكيفَ يجوزُ المنعُ عن حضرةِ القدْسِ",34,"س",1,0],["وَلَو رَكِبَ الجِواءَ بِمصرَ سَعدٌ","لَقُلنا لَيتَهُ رَكِبَ السَحابا",35,"ب",2,0],["ولو رَهنُوني وكتبي معاً","مع الشِّعرِ والظَّرفِ والمحبرَة",36,"ر",2,0],["وَلَو رَدَّت جِنانُ مَرَدَّ خَيرٍ","تَبَيَّنَ ذاكَ في وَجهِ الرَسولِ",37,"ل",1,0],["وَلَو رَآني سَيّئاً في الهَوى","لَقالَ لي أَبعَدَكَ اللَهُ",38,"ل",3,0],["وَلَو رَضيتُ دونَ النُفوسِ بِغَيرِها","لَحُطَّت بِعَفوٍ لا قِصاصَ جُروحُها",39,"ح",3,0],["وَلَو رَقى الطِفلَ عيسى أَو أُعيدَ لَهُ","بُقراطُ ما كانَ مِن مَوتٍ يُوَقّيهِ",40,"ق",3,0],["ولو رُفعَتْ سُرُوجُكَ في ظَلامٍ","على بُهُمٍ جَعَلْنَ لها وُضُوحا",41,"ح",2,0],["ولو رَسَمَ الرّاقي حُرُوفَ اسمِها على","جَبينِ مُصابٍ جُنّ أبْرَأهُ الرسم",42,"م",1,0],["وَلَوْ رُمْتُ مَا رَام امْرُؤٌ بِخِيَانَةٍ","لَصَبَّحنِي قِسْطٌ مِنَ الْمَالِ غَامِرُ",43,"ر",1,0],["وَلَو رُدَّ بِالرِزءِ ما تَستَحِقُّ","لَما كانَ لي في حَياةٍ أَرَب",44,"ب",1,0],["وَلَو رَجمتُ ثبيراً","بِعَقلِهِ لَهَدَدتُه",45,"ت",2,0],["ولوردةٍ عائت حياةَ الورود، ما","راعَ ابنها، أو راعَها ببنائه",46,"ا",3,0],["ولو رمحا شككت به ولكن","تواردت الأسنة كالشطون",47,"ن",1,0],["ولو رُمتُ للعَوْرات كشفاً أريتُكُمْ","من الناس حتى الأنبياءِ عجائبا",48,"ب",2,0],["ولوْ رسمَ الرَّقي حروفَ اسمها على","جبينِ مصابٍ جنَّ أبرأهُ الرَّسمُ",49,"م",1,0],["ولو رأتك زليخا وهي مسرعة","نحو القميص لما قامت على قدم",50,"م",1,0],["وَلَو رُمتَهُم لَم يَعِزّوا عَلَيكَ","وَلَو أَنَّهُم في مُتونِ السُحُب",51,"ب",1,0],["وَلَو راءَها البَدرُ في تَمِّهِ","وَكانَت لَهُ قُدرَةٌ لِاِستَتَر",52,"ر",1,0],["وَلَو رَأَتكَ مُلوكٌ أَنتَ تاجُهُمُ","لَأَذعَنوا وَأَقَرّوا أَنَّهُم خَوَلُ",53,"ل",1,0],["وَلَو رُموا بِكَ في الهَيجاءَ لَم يَجِدوا","إِلّا إِلى ظِلِّكَ المَمدودِ مُنهَزَما",54,"م",2,0],["ولو رمت أن آتي على كل شرحه","لما قام لي طرسٌ ولا استطعت اكتبُ",55,"ب",1,0],["ولو رأته لظلّت وهي كاسفةٌ","وغيّرتها بفرطِ الغيرة الغيَرُ",56,"ر",1,0],["ولو رأى أدنى صدود لأتى","منه وعيد بالفراق مرعب",57,"ب",1,0],["ولو رد من ناجاك للغير طرفه","تميزت من غيظ عليه وغيره",58,"ه",1,0],["ولو رجعت إلى عقل ومعرفة","جعلت ما قلته مما تواريه",59,"ي",2,0],["ولو رأوه كما قلتم وخاطبهم","لما شكوا فقدما الرحمن يوحيه",59,"ي",2,0],["ولو رأى حاتمُ الطائيُّ أَيْسَرَ ما","يُعْطِي لأيقنَ أنَّ الشُّحَّ مَذْهبُه",60,"ب",2,0],["ولو رُمْتُ أن أنساكمُ ذَكَّرتْ بكم","محاسنُ فعلٍ مثل منتظِم العِقد",61,"د",1,0],["ولو رآها بعين العيش خالفها","على الهوى ورأى مختارها عار",62,"ر",1,0],["ولو رفعوها فوقَ غيرِ ضِعافِهم","لما وجدوها آخرَ الدهرِ ترفعُ",63,"ع",1,0],["ولو روى الفلكُ الدوارُ حكمتهُ","لامستِ الشهبُ فيهِ كلها سورُ",64,"ر",1,0],["ولو رأتهُ الأسدُ في غابها","رأتء مذلَّ الأسدِ الخادرِ",65,"ر",1,0],["ولو رأى البدر ليلا حسن طلعته","تجلى لولى بلون منه مكسوف",66,"ف",1,0],["وَلَو رامَ الحَياةَ نَجا إِلَيها","بِعَزمَتِهِ نَجاءَ المَضرَحِيِّ",67,"ي",1,0],["وَلِوِردِ جودِكَ أَن يُكَدَّرَ شُربُهُ","وَلِوَجهِ بِرِّكَ أَن يُرى مُتَجَهِّما",68,"م",2,0],["وَلَو رُمتَ مِنِّيَ بيضَ الأَنوُقِ","وَعَنقاءَ مَغرِبَ لَم تُعوِزِ",69,"ز",1,0],["وَلَو رَأَوهُ في جَحفَلٍ صَعِقوا","أَو شَهِدوهُ في مَحفَلٍ سَجَدوا",70,"د",3,0],["ولو رأى البدرُ المنيرُ وَجهَهُ","هَلَّلَ إجلالا له وكبَّرا",71,"ر",2,0],["ولورمته لم ينج لكن انفت ان","تحاول من رام الفرار عن الطعن",72,"ن",1,0],["ولو رأى مرحب في الحرب موقعه","والضرب ولىّ حليف الويل والحرب",73,"ب",1,0],["ولَو رامَ السلُوّ أَبَتْ عَلَيه","مَعاهدُ عَهدها الماضي حَميدُ",74,"د",1,0],["وَلَوْ راعى ذَوِي الأَخْطارِ دَهْرٌ","رَعى ذا الْمَجْدَ وَالشَّرَفَ الْخَطِيرا",75,"ر",2,0],["وَلَوْ رَكِبَ النَّاسُ الْغِنى بِبَرَاعَةٍ","وَفَضْلٍ مُبِينٍ كُنْتُ أَوَّلَ رَاكِبِ",76,"ب",1,0],["ولو راعه عمرٌ تكامل أَلفُهُ","لما راعَ نوحاً في السنينِ الدكائك",77,"ك",1,0],["وَلَو رَدَّ عَنهُ المَوتَ بَأسٌ لَأَزهَقَت","شِفارُ المَواضي أَنفُساً وَالقَنا اللُدنا",78,"ن",2,0],["وَلَو رَآكَ اِبنُ العَميدِ مَنشَئاً","يا اِبنَ العَميدِ عادَ مَقطوعَ النَسَب",79,"ب",1,0],["ولَو رُدَّ عنك الحتفُ بالبأس لم يَقف","سِنانيَ عَن طعنٍ وَسيفيَ عَن بَتكِ",80,"ك",1,0],["وَلَو رآه عاذلي لا رأى","أَصبحَ لا أَصبحَ لي عاذِرا",81,"ر",2,0],["ولو رجعت لأهلي","كانت بلادي بلادا",82,"د",2,0],["ولو رأى أمردٌ أن يستبيح دمي","إذا لقام بنصري معشرٌ خشن",83,"ن",1,0],["ولو رأى وجهك المفدى","وما تغشاه من سناك",84,"ك",1,0],["ولو رام إشجائي اِعتراض عتابه","توهّمته السلسالَ من سائغٍ عذبِ",85,"ب",1,0],["ولو روعي الضر الذي فيهما لنا","ولم يخلقنا لاختل نظم الخليقة",86,"ه",1,0],["وَلَوْ رَأَوْا مَن رَأَيْنا قالَ قائلُهُمْ","لَوَ أنَّهُمْ ضُرِبُوا بالسَّيْفِ ما شَعَرُوا",87,"ر",3,0],["وَلوَ رامَ حَلَّ قَفَا نَفسهِ","لَمَا كانَ فيهِ لهُ مَوْضِعُ",88,"ع",1,0],["وَلَوْ رَأَيتُ بُدُورَ التِّمِّ طالعِةً","وَدَدْتُها أَصبَحتْ في قُفَّتي رُغُفَا",89,"ف",2,0],["وَلَو رَأَيتَ حَبيبي","لَقُلتَ ذا رَبُّ رَبّي",90,"ب",2,0],["وَلَو رَأَوهُ بِعَيني","لِاِستَحسَنوا ما أَعابوا",91,"ب",3,0],["ولو رأَى في الكَرى ما نِلّتُه أَحَدٌ","لَهَزَّ ما عاشَ عِطْفُيْهِ منَ التِّيه",92,"ي",2,0],["ولو ركضوا على الأفلاك صارَتْ","أَهِلّتُها طِراقاً للنِّعال",93,"ل",1,0],["وَلَو رُمتَ تَقديراً لَما كُنتَ قادِراً","وَهَل يَترُكُ الإِنسانُ ما يَتَعَوَّدُ",94,"د",1,0],["ولو رأى الزَّهْرُ في الواحاتِ بَسْمَتَه","لَمَا حَبَانا الشَّذا يوماً ولا ازدهَرا",95,"ر",2,0],["ولو رآها نسيمُ الفجر حاضرةً","على ضِفافِ الرَّبيعِ الطَّلْقِ ما حَضَرا",95,"ر",2,0],["وَلَو راءَ ما يبنيه حاتِم طَيِّها","لَقالَ كَذا تَبنى العُلى وَالمآثِرُ",96,"ر",1,0],["ولو رقوا في ذرى ثهلان أسلمهم","لسيفه العاصمان الحصن والوزر",97,"ر",1,0],["ولو رأَى الجوهريّ ألفاظَها الْ","غُرِّ لَما شَكَّ أنّها دُرَرُ",98,"ر",1,0],["ولو رامَ أنْ يرقى إلى النَّجم لارتقى","ويوشك ربّ الفضل أنْ يبلغ السَّما",99,"م",2,0],["ولو رآك طرفه لما ارتضى","إلاَّ بأنْ تسمو إلى أوج السما",100,"ا",1,0],["ولو رأى وجهك الوضاح بدر دجى","لعاد مستترا أو راح منخسفا",101,"ف",2,0],["ولو رامَ ابْنُ هانِىٍءٍ اتِّصالاً","بصعب مَرَامِها يوماً لهانا",102,"ن",2,0],["ولو رفعْنَ سُتورَ الحُجْب لانْسدَلَتْ","من العفافِ على عاداتِها الحُجُبُ",103,"ب",1,0],["ولو رأيتَ من 