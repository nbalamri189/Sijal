],["ولو رأتني في نار مسعرة","ثم استطاعت لزدت فوقها حطباً",182,"ب",2,0],["ولورقه فوق الغصون تناشد","تتلو حديثا للورى مستعذبا",183,"ب",2,0],["ولو رأى العنسي شديد باسه","عرقب جواده في الحروب وأحجم",184,"م",1,0],["وَلَو رامَ عَذلي من يُريني نَصيحَةً","رَدَدتُ عذولي وَهوَ خزيانُ ناكِصُ",185,"ص",1,0],["ولو رأتها إذن لغنّى","قلبي على الرجع من صداها",186,"ا",3,0],["ولو رمى جمرة من ناره احترقت","تلك البطاح وما فيها لجمرته",187,"ت",2,0],["ولو رآه لهوَىَ مثلما","موسى هوى من طورسيناه",188,"ا",2,0],["وَلَو رَبا ثقل آثامي عَلى أُحُد","إن الكَبائر في الغفران كاللمم",189,"م",1,0],["وَلَو راموا رقياً أَو عروجاً","لرتبته أَسامهم المسام",190,"م",1,0],["ولو رام أن يبدي الدليل مبرهنا","يرى سفه الباغي لسمع الورى أصمى",191,"م",2,0],["ولو رحموا كرامتها وخلّوا","كراسيهم أراحوا واستراحوا",192,"ح",3,0],["ولو رأوني أو مأوا بالسجود","يا ذلة الدنيا لهذا الإله",193,"ه",1,0],["ولو رآه لهام قلبي","به وخلى الملام بعده",194,"د",2,0],["ولو رفعت عن الدنيا الحجاب لما","كانت لروحك يوماً ترفع الحجب",195,"ب",1,0],["ولو رَهطُ مرداس بن حيّان أحدثوا","وعى العظمُ وانضمَّت عليه جبائرُه",196,"ر",2,0],["ولو رسول الله موجوداً لما","كان سواه بالعزاء يقصد",197,"د",1,0],["ولو رامها كعب وعوف ومحلم","لما رضيت كعبا وعوفا ومحاما",198,"م",2,0],["ولو رآها الصفدي في الأزل","صفّد طرف فكره قيد الخجل",199,"ل",1,0],["ولو رآها الفاضل الوداعي","لفارق النظم بلا وداع",199,"ع",1,0],["ولو رآها عُمُر بن الوردي","لقال شعري شوك هذا الوردِ",199,"د",1,0],["ولو رآها الألمعي الذهبي","حقّق أن نظمه من خشب",199,"ب",1,0],["ولو رآها ابن منير أظلمت","عليه سبل نظمه واستبهمت",199,"ت",1,0],["وَلَو رَدَّ آسٍ قَبله رائِدَ الرَّدى","بِوَفرِ النُّهى وَالخُبرِ لَم يُعيهِ الرَدُّ",200,"د",1,0],["وَلو رَأَيتُ مناماً جَمعَنا بكمُ","كذّبتُ عَيني وَقلتُ الدَهرُ غالطني",201,"ن",2,0],["وَلو رام دَهري فَوق ما بي لصدّه","تَحزُّنُ أَعدائي وَحسرةُ عذّالي",202,"ل",2,0],["وَلو رمت صيرت السماك لمنزلي","محلّاً وَناولتُ السما كفّ سائل",203,"ل",1,0],["ولو رأوك بتلك العين لانخلعت","رقابهم دون أدنى تلكم القمم",204,"م",1,0],["ولو رام يسعى اليها امرؤ","تقضى به الدهر دون النجاح",205,"ح",1,0],["ولورمت أسولها لقالت حشاشتي","سلوك بدر التم من أعظم الغدر",206,"ر",1,0],["وَلَو رَآكَ وَأَهلُ القُدسِ في وَلَهٍ","أَبو عُبَيدَةَ فَدّى مِن مَسَرَّتِهِ",207,"ت",2,0],["ولو رأى منك جالينوس معجزةً","ما قال في الكل إن الأمر ملتبس",208,"س",1,0],["ولو رد تأبين على الجسم روحه","إذا لرأوني عند نعشك جاثيا",209,"ي",2,0],["ولو رقى لحظة يعطيك مالاه","لكنه جذوةٌ يعطي كمالاه",210,"ل",3,0],["ولَو رَامَ كَسفَ الشَّمسِ كوّرَ نورَها","وعَطَّلَ مِن أفلاكها كلَّ دَائِر",211,"ر",1,0],["وَلَو رامَت جموعُكُمُ بِلادي","إِذَن كَرَّت رَحانا تَستَديرُ",212,"ر",1,0],["ولو رمقتك أبصار الزواني","لودت أن تكحل بالغموض",213,"ض",1,0],["ولو رضعت من در راحته الندى","همت باللئالي هاطلات الغمائم",214,"م",1,0],["وَلَو رامَت تَعبر عَن ضَميري","وَما لاقى بِكُم قَلبي لَغنت",215,"ت",1,0],["ولو رآها ابن منير أظلمت","عليه سبل نظمه واستعجبت",216,"ت",1,0],["ولو رأى بعضها أخو ورع","حلف تقى عابد بها سكرا",217,"ر",2,0],["ولو رهبتْ لدى الإقدام جوري","لما رغبتْ جهاراً في جواري",218,"ر",2,0],["ولو رمتُ في التأبين عَدَّ نعوتها","وكنتُ بليغ النظم ابرع خاطبِ",219,"ب",1,0],["ولو رمتَ شتمي عند عدلٍ قضاؤُهُ","لرمتَ به يابنَ الزبيرِ مدى شحطا",220,"ط",2,0],["ولو رنا جدّه إليه","وهو خضيبُ الذؤابَتَين",221,"ن",1,0],["وَلَو رأَى النُعمانُ رأيَ رُشدِهِ","لما رأى في ابنِ عَدِيٍّ ما رأى",222,"ا",1,0],["ولو رأى رأى دُرَيدٍ صِنوُهُ","لم يَنتَقِع نَقِيعَةً يَومَ اللِّوا",222,"ا",1,0],["ولو رثى للمُشَتكي مَجهودَهُ","ما لَجَّ في إبعادهِ مَجهودهُ",223,"د",2,0],["ولو رُدَّ مَخلوقٌ الى بِدءِ خَلقِهِ","اذن كنت جسماً بينَهُنّ تُقَسَّمُ",224,"م",1,0],["ولو رُهنتُ وما أحويه من نَشَبٍ","على غدائكَ يوماً لم تَنَم سَغِبا",225,"ب",2,0],["ولو رآها خرَّ من حُبّها","يسجُد للشيطان بالباطلِ",226,"ل",1,0],["ولو رمت ان يستغرق الخط وصفه","لكنت كمن قاس السماء بشبره",227,"ر",2,0],["ولو رأوا ما أرى ِمنْ سحْر ِ فاتنتي","ما همَّهمْ ذهَبٌ برّاقُ أو ماسُ",228,"س",1,0],["ولو رأيتُ سيبويه","قلتُ يا نحوي مَهْ",229,"م",2,0],["ولو رجَعوا إلى الإنصافِ كنّا","أحقَّ بكلِ إكرامِ وجودِ",230,"د",1,0],["ولو رأتني عيونُ النّاس مثلك ما","أمسى بقلبي منَ الأحز