{"poems":[[91,"ما شاهدت عيني ممث","https://www.aldiwan.net/poem44910.html","مجزوء الكامل"],[71,"هذي فصوص لم تكن","https://www.aldiwan.net/poem28042.html","مجزوء الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54760","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54934","الكامل"],[154,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[234,"نعم المعين على الوغى في مأزق","https://www.aldiwan.net/poem50885.html","الكامل"],[287,"هلم يا لائمي قد أثمر البان","https://www.aldiwan.net/poem32409.html","البسيط"],[290,"للغرب أنت وللمشارق مرجع","https://www.aldiwan.net/poem39407.html","الكامل"],[295,"مهما تألبت الأحداث والغير","https://www.aldiwan.net/poem11710.html","البسيط"],[484,"قل هكذا مد الشباك","https://www.aldiwan.net/poem37068.html","مجزوء الكامل"],[543,"مثل التهامي ما في الأرض من بطل","https://www.aldiwan.net/poem47989.html","عموديه"],[543,"نظرت بلحظ بالقلوب لعوب","https://www.aldiwan.net/poem48277.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138238",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138202",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138235",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138300",""],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62645","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96722","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96633","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133796","الكامل"],[1579,"","https://poetry.dctabudhabi.ae/diwan/poem/198788","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120922","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137073",""],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115768","البسيط"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133931","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100832","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100785","البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130096","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126948","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131279",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131044",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102947","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44698","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125864","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125831","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83645","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83582","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83456","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66113","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52128","الكامل"],[4809,"هل في القوم من عمر ؟","https://www.poetsgate.com/ViewPoem.aspx?id=201476",""],[4854,"لَن نُوقِفَ الشََدوَ","https://www.poetsgate.com/ViewPoem.aspx?id=216066",""],[4858,"رثاء الشّيخ الحاج محمّد أحمد خليل","https://www.poetsgate.com/ViewPoem.aspx?id=139897",""],[5070,"الفردوس المفقود","https://www.poetsgate.com/ViewPoem.aspx?id=99368",""],[5111,"قُدْسَاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=212591",""],[5131,"من هَهُنا من أَرضِ يافا أكتبُ","https://www.poetsgate.com/ViewPoem.aspx?id=55256",""],[5185,"بعض أنفاس البحر","https://www.poetsgate.com/ViewPoem.aspx?id=71578",""],[5205,"حتام يا من صان ظلماً","https://www.poetsgate.com/ViewPoem.aspx?id=120990",""],[5277,"صفعةُ القرن","https://www.poetsgate.com/ViewPoem.aspx?id=204495",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5320,"تحية نصر","https://www.poetsgate.com/ViewPoem.aspx?id=42037",""],[5338,"سقيت ربعك غيث المدمع الهطل","https://www.poetsgate.com/ViewPoem.aspx?id=187697",""],[5376,"دع عنك شعرا بما هيجته أدبا","https://www.poetsgate.com/ViewPoem.aspx?id=189134",""],[5376,"من غُوْرِها قد أخْرجَتْ ثوَّارَها","https://www.poetsgate.com/ViewPoem.aspx?id=196644",""],[5376,"الى المقدسيين عند باب الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=202793",""],[5376,"فلتشهدي يا روح نفسي إنني","https://www.poetsgate.com/ViewPoem.aspx?id=214062",""],[5376,"كم ليلةٍ بالجوى مرَّتْ على العربِ","https://www.poetsgate.com/ViewPoem.aspx?id=214067",""],[5542,"شعري وحبي فيكَ يلتقيانِ","https://www.poetsgate.com/ViewPoem.aspx?id=24756",""],[5582,"تَهْنا أَبَيْتَ اللَّعْنَ بِالمَوْلُودِ","https://www.poetsgate.com/ViewPoem.aspx?id=63486",""],[5587,"أَرْضُ الرِّسَالَاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=196678",""],[5605,"دوى الرصاص","https://www.poetsgate.com/ViewPoem.aspx?id=161226",""],[5652,"بشار عاث وعاثت ذنوب بشار","https://www.poetsgate.com/ViewPoem.aspx?id=164684",""],[5652,"المماليك البحرية","https://www.poetsgate.com/ViewPoem.aspx?id=177048",""],[5829,"تحية الى اهل العلم","https://www.poetsgate.com/ViewPoem.aspx?id=159310",""],[5887,"يا طائر الدوح","https://www.poetsgate.com/ViewPoem.aspx?id=35290",""],[5944,"عروبتنا النازفة","https://www.poetsgate.com/ViewPoem.aspx?id=215338",""],[6050,"الشّمسُ تُنسَجُ مِنْ فَم الشُّعراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=103311",""],[6070,"يا أيُّها الضَّوءُ المُسافرُ في دمي","https://www.poetsgate.com/ViewPoem.aspx?id=197531",""],[6113,"وافرض","https://www.poetsgate.com/ViewPoem.aspx?id=58847",""],[6145,"من نحن ؟","https://www.poetsgate.com/ViewPoem.aspx?id=7794",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[5724,"ما رفرفت فوق هام العرب رايات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55140&r=&rc=7",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""],[6222,"عام مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1932&r=&rc=3",""],[406,"أما لهذا الليل من آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63269&r=&rc=73",""],[406,"إلى ياسر عرفات ( بعها )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=840&r=&rc=31",""],[6315,"ابتِهَالٌ على خُيُوطٍ مُقَدَّسَة !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87582&r=&rc=7",""],[5922,"أَمامَ يديْ ألمانيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88227&r=&rc=2",""]],"verses":[["هذي فتاة النيل لل","اعجاب في شعب مثيره",0,"ر",2,0],["هذي فصوصٌ لمْ تكنْ","بنفيسةٍ في نفسِها",1,"ه",2,1],["هذي فلسطين أو هذي روايتُها","ماذا تقولون إنْ لم يُحسَمِ الداءُ",2,"ا",2,0],["هَذِي فَضَائِلُهُ وَيَكْثُرُ مَا","أَخْطَأْتُهُ مِنْهُنَّ فِي الْعَدِّ",3,"د",1,0],["هَذِي فَتَاةٌ حَالُهَا","أَدْهَى وَأَفْطَرُ للمَرَائرْ",4,"ر",1,0],["هذي فتوح خليفة شهدت له","بالسَّعد بين النقض والإٍبرام",5,"م",1,0],["هذي فضائِلك التي قد نزّلت","بالنصّ في آيِ الكتاب المنزل",6,"ل",1,0],["هَذي فَواكِهُ ما تَنفَكُّ يانِعَةً","فَدَع مَلامي فَمَن أَهواهُ بُستانُ",7,"ن",1,0],["هذي فرنسا دولة الإفرنج قد","جلتك فاعترفت بأنك المطلب",8,"ب",1,0],["هذي فلسطين كم من محنةٍ عصَفَت","بأهلها ودهاها ظالم أشرُ",9,"ر",1,0],["هذي فتاتك قل له","ولها فقل هذا فتاك",10,"ك",1,0],["هذي فرنسا وذا وسامُ عِزَّتِها","وأنتَ أنت عديمُ النِّدِّ والمَثَلِ",11,"ل",1,0],["هَذِي فرنسَا وهيَ خَيرُ حَبيبةٍ","لِلعَرش وهوَ لها أعزُّ حبِيب",12,"ب",1,0],["هذي فعال أميرنا","ذي النبل والأصل المجيد",13,"د",1,0],["هذي فضائله هذي شمائله","فإنها مثل أعلى لنا ضُربا",14,"ب",2,0],["هذي فعالك غرة في جبهة","للدهر بل هي للصباح عمود",15,"د",1,0],["هذى فروض نحو اخوان ومن","لم يبذل الاحسان كان مقصرا",16,"ر",2,0],["هذي فريضتهم من ستة علمت","نصف وسدس وثلث قسمها كملا",17,"ل",2,0],["هذي فضولٌ قد حبَا","كَ بِكَسبها باري النسم",18,"م",1,0],["هذي فصولٌ مِن إِلهك أصبحت","تسقى بعقدِ لوائها المعقودِ",19,"د",1,0],["هذي فصولك لم تفتك","همومهن ولم تفتني",20,"ن",2,0],["هذي فلسطينُ تبكي قدسَها نُزعتْ","منها ويحكمها هودٌ وكفار",21,"ر",1,0],["هذي فتوح النصر فتّح بابها","قد راق مورودها وفاق المصدر",22,"ر",1,1],["هذي فرنسا ازهرت ايامها","ولقد غدت منصورة اعلامها",23,"م",3,1],["هذي فعالك في اعطف وفي صلة","فما أظنك في هجر وفي ظعن",24,"ن",1,0],["هذي فلسطين بعد الفاتحين غدت","خرافة أو مراحاً للأساطير",25,"ر",1,0],["هذي فروق تموجت بجموعكم","كالغاب يجمع أشبلا وأسودا",26,"د",2,0],["هذي فروق تفاخرت برجالها","وبهم تناهت رفعة وصعودا",26,"د",2,0],["هذي فضائلهم يا قوم فانتجعوا","مناهل المجد إصدارا وإيرادا",27,"د",2,0],["هذي فِعالكَ أثمرت في ثَغرِنا","فأجلّ مدحٍ في علاك قليلُ",28,"ل",1,0],["هذي فرائض ارث عن ميمنه","وافى محمد فيها خير مبعوث",29,"ث",1,1],["هذي فلسطين فاضمد جرحها الدامي","وانضح ثرى قدسها بالمدمع الهامي",30,"م",2,1],["هذي فلسطين في أيام نكبتها","تمسي وتصبح في شجوٍ وآلامِ",30,"م",1,0],["هذي فلسطين يا لبنان قد نكبت","فاعطف على بائسيها عطف كرام",30,"م",1,0],["هذي فعال ملوكنا في أرضنا","كل يريد لضدّه إهلاكا",31,"ك",2,0],["هذي فتاوى المكرمات تعطلت","فاليوم لا رشد لمن يسترشد",32,"د",1,0],["هَذي فُنونٌ لَكُم في طَيِِّها عِبَرٌ","فيها اِمتِزاجُ أُصولِ الجَدِّ بِاللَعبِ",33,"ب",1,0],["هذي فلسطين الشهيدةُ ضُرِّجَتْ","بدماء أهليها عليها تهرف",34,"ف",1,0],["هذي فلسطينُ الوديعةُ","في مصائبها تميد",35,"د",1,0],["هذي فلسطين قَد قامَت قِيامَتها","نَبكي عَلى الدينِ ما نَبكي فِلِسطينا",36,"ن",2,0],["هذي فَلِسطينُ مهدُ الأَنبِيا وَبِها ال","بيت المقدّس وَالأَهلون أَهلونا",36,"ن",2,0],["هذي فِلِسطينُ لَم يَغضَب لَها أَحدٌ","كَما يُرادُ وَيُبدي سورَة الغَضَبِ",37,"ب",1,0],["هذي فلسطينُ قَد ضاعَت بِرمَّتِها","في حُكم جامِعَةٍ في شرّ أوقاتِ",38,"ت",1,0],["هذي فِلَسْطِينُ عَهْدُ السُّوءِ بَلْفَرَها","حتى ادَّعاها غَرِيبُ الدارِ والنَّسَبِ",39,"ب",1,0],["هذي فروضي قد أَتتك كغادةٍ","منها عبير ولاك بات فَتِيقا",40,"ق",2,0],["هذي فلسطين في الأغلال معصمها","يقتادها الحقد في موجٍ من السُمُرِ",41,"ر",1,0],["هَذِي فِلَسطِينُ نَابُ الذِّئبِ تَنهَشُهَا","لَولَاكَ رَبِي لأَضحَى يُوسُفٌ مِزَقَا",42,"ق",2,0],["هذي فلسطينٌ يُدنّسُ أرضَها","رِجسُ اليهودِ، فمَن يصون حماها ؟",43,"ا",3,0],["هذي فلسطينُ كادتْ، والوغى دولٌ","تكونُ أندلساً أخرى وأحزانا",44,"ن",2,0],["هَذِي فِلِسْطِينُ جَيْشُ الظُّلْمِ يُجْرِفُهَا","فَالْبَطْشُ سِيمَتُهُمْ ، بِالْقَتْلِ قَدْ جَاؤُوا",45,"ا",1,0],["هَذِيْ فِلِسْطِينُ جُنْدُ الْحَقِّ يَبْعَثُهَا","خُلْدًا وَذِيْ يَدُنَا لِسِّلْمِ بَيْضَاءُ",45,"ا",2,0],["هذي فلسطينٌ أتاها أهلُها","والغاصبونَ قدِ احتواهم مركب",46,"ب",1,0],["هذي فصاحة أذني بيد أن لها","بالعلم بعضا من السلطان والعظم",47,"م",1,0],["هذي فعال اللحظ في","ه فكيف من قدر رام لثما",48,"م",2,0],["هذي فلسطينُ لا تنفكُّ تكسرُ بي","إجابةً لسؤالٍ للملايينِ",49,"ن",1,0],["هذى (فلسطين) نحو الفتح راجعة","لاهلها لا يربح (القدس) تدويل !",50,"ل",1,0],["هذى فرنسا واليهو","د لكل سيف شاهرة",51,"ر",2,0],["هَذِي فَضَائِلُهُمْ تُتْلَى مُرَدَّدَةً","فِي مَسْمَعِ الدَّهْرِ فِي الأَصْبَاحِ وَالأُصُلِ",52,"ل",1,0],["هذي فلسطين ما هانت أعزتها","أعزها الله وعد الله ما كذبا",53,"ب",2,0],["هذي فلسطين ما جفت محابرها","تاريخها من دما الأبطال قد كتبا",53,"ب",2,0],["هذي فلسطين كم عانت بوحدتها","فلا نصير لها عنها قد احتجبا",53,"ب",2,0],["هذي فلسطين تجري في أعنتها","لا الغرب ترضى بهم والحق ما اغتربا",53,"ب",2,0],["هذي فلسطين ان طالت شكايتها","لله تشكو فلا انسا ولا عربا",53,"ب",2,0],["هذي فلسطينُ العروبة أنَّها","قد أشعلتْ بركانَها وأوارَها",54,"ر",3,0],["هذي فلسطين التي في فلكها","نادى الاله محمدا فأجابا",55,"ب",2,0],["هذي فلسطين التي في روحنا","كأنها شمس تلوح من عل",56,"ل",1,0],["هذي فلسطينُ في الأحشاء مسكنُها","شعَّتْ مناراتُها بالرسْلِ والكتبِ",57,"ب",1,0],["هذي فتاواكَ التي أرسلتَها","لتضيءَ ذهنَ السائلِ الحيرانِ",58,"ن",1,0],["هذِي فُضُولٌ مِنْ إِلهِكَ أَصْبَحَتْ","تَسْعَى بِعَقْدِ لِوائِها المَعْقُودِ",59,"د",1,0],["هَذِي فِلَسْطِينُ وَ الأَقْطَارُ هَاوِيَةٌ","بَغْدَادُ وَ الشَّامُ بِالأَصْفَادِ وَ الزَّرَدِ",60,"د",1,0],["هذي فلسطين يا لبنان عاشقة","للوصل تحتضن الأبطال بالقبل",61,"ل",1,0],["هذي فعايل من على العزه اشهار","شاموا على الطغيان شبوا فتايل",62,"ل",1,0],["هذي فعايل فتنة الغرب ياصاح","عشنا وشفنا صمتنا وش جديده !",63,"د",2,0],["هذي فضائله في الشام مخصبة"," والخيرُ فيّاض من ْ حيثما كانا",64,"ن",2,0],["هذي فلسطين يا ابن العرب في نصب","والكفر يعثو بترب القدس والنقب",65,"ب",1,0],["7–هذي فلِسطينٌ تَعَيَّاها الأسىٰ","تبكي عُقودًا مِنْ هوَانٍ سالِفةْ",66,"ف",2,0],["هذي فلسطينٌ تنادي أهلها","عُودوا إلى أحضانيَ الفيحاء ِ",67,"ا",2,0],["هذي فضاءاتي التي لا تنتهي","