ww.aldiwan.net/poem890.html",""],[564,"فؤادي قد أغواه من بعد رشده","https://www.aldiwan.net/poem901.html",""]],"verses":[["تَيَقَّظَ وَالعُيونُ مُغَمَّضاتٌ","وَقَلقَلَ وَالرَعِيَّةُ وادِعونا",0,"ن",2,0],["تَيَقَّظتُمُ لِدِفاعِ الخُطوبِ","فَلَم تَترُكونَ الأَعادي نِياما",1,"م",2,0],["تَيَمَّمتُ قَيساً وَكَم دونَهُ","مِنَ الأَرضِ مِن مَهمَهٍ ذي شَزَن",2,"ن",1,0],["تَيَمَّموا أَرضَ كولُمبٍ فَما شَعَرَت","مِنهُم بِوَطءِ غَريبِ الدارِ حَيرانِ",3,"ن",1,0],["تَيَمَّمتُها وَاللَيلُ في غَيرِ زَيِّهِ","وَحاسِدُها في الأُفقِ يُغري بِيَ العِدا",4,"د",2,0],["تَيَمَّمتُ سَعدَ اللَهِ لِلفَألِ بِاسمِهِ","وَلَم آتِ سَعدَ اللَهِ لَو كانَ لي عَقلُ",5,"ل",1,1],["تَيَمَّمتُ سَعدَ اللَهِ لِلفَألِ بِاسمِهِ","وَقُلتُ كَريمٌ بَينَ موسى وَمَريَمِ",6,"م",1,1],["تَيامَنَّ عَن ذي المُرِّ في مُسبَطِرَّةِ","يَدُلُّ بِها الحادي المُدِلُّ المُراوِما",7,"م",2,0],["تَئِنُّ إِلى العَجمِ وَالأَبهَرينِ","أَنينَ المَريضِ تَشَكّى المُغاثا",8,"ث",2,0],["تَيَمَّمتُ لَهبًا أَبتَغي العِلم عِندَهُم","وَقَد رُدَّ عِلمُ العَائِفينَ إلى لَهبِ",9,"ب",1,1],["تَيَمَّمتُ شَيخًا مِنهُمُ ذا بَجَالةٍ","بَصيرًا بِزَجرِ الطَيرِ مُنحنيَ الصُلبِ",9,"ب",1,0],["تَئِن سَوَاقٍ بُحَّ بِالشَّجْوِ صَوْتُهَا","وَيثمَلُ سِرْبٌ حَوْلَهَا مُتَنَادِمُ",10,"م",1,0],["تَيَمَّمنَ يافوخَ الدُجى فَصَدَعنَهُ","وَجَوزَ الفَلا صَدعَ السُيوفِ الصَوادِعِ",11,"ع",1,1],["تَيَمَّمنَ عَيناً مِن أُثالٍ نَميرَةً","قَموساً يَمُجُّ المُنقِضاتُ اِحتِفالُها",12,"ل",3,0],["تَياسَرنَ عَن حَذوِ الفَراقِدِ في السُرى","وَيا مَن شَيئاً عَن يَمينِ المَغاوِرِ",13,"ر",1,0],["تَيَمَّمَ ناوي آلِ خَرقاءَ مُنهِلاً","لَهُ كَوكَبٌ في صَرَّةِ القَيظِ بارِدُ",14,"د",1,0],["تَئِنُ إِذا ما النَسعُ بَعدَ اِعوِجاجِها","تَصَوَّبَ في حَيزومِها ثُمَّ أَصعَدا",15,"د",2,0],["تئن وقد مدّ الظلام رِواقه","وخيّم صمت في الدجى وسكون",16,"ن",1,0],["تيمَّم من بعد الحجاز تهامة","وراح إلى صنعاء يُزجي الركائبا",17,"ب",2,0],["تَيَقّظ فما أنت بالخالد","ولا حادث الدهر بالراقد",18,"د",1,1],["تَيمِيَّةٌ هَمَشى تَقولُ لِبَعلِها","لا تَنظُرَنَّ إِذا وَضَعتُ ثِيابي",19,"ب",2,0],["تيهٌ يَحارُ بِهِ الهادي إِذا اِطَّرَدَت","فيهِ الرِياحُ وَهابي التُربِ مَنخولُ",20,"ل",1,0],["تَيَمَّنتُم بِمُؤتَشِبٍ حَمِيل","لَعَلَّكُمُ بِهِ تَتَشاءَمُونَا",21,"ن",2,0],["تيممتَ منها روضةً نبوية","جنيتَ بها زهرَ الرّضا وهو مخصب",22,"ب",1,0],["تيممها الملكُ المؤيدُ وادِعاً","تيممَ منصورِ اللواء مطوَّد",23,"د",1,0],["تيهي وصدِّي إذا ما شئت واحْتكمي","على النفوسِ فإن الحسن ولاَّك",24,"ك",1,0],["تيممت أجواداً وفاضت بحوركم","فلم يبق عندي رخصة في التيمم",25,"م",1,0],["تِيهاً بأن مَلَك الحِما","ر عدمتُ قلة خيره",26,"ر",2,0],["تيمَّمت منهمْ بالمديح مُمدَّحاً","يطاوعُ فيه القولُ حين يُعاصي",27,"ي",1,0],["تيَقَّظَ للعُلا والمدَّعُوها","لهمْ في نومهم عنها غطيطُ",28,"ط",1,0],["تيس تنفق بالدلال ليشتهى","فازداد مقتاً بالدلال وما نفق",29,"ق",1,1],["تيجانُ أهلِ التصابي من قرونِهمُ","قدْماً ومن صفوة العارِ الأكاليلُ",30,"ل",1,0],["تيقَّظْ أبا عبدِ الإله فإنها","مَناعس لا تعشَى امرءاً فائز الخصْلِ",31,"ل",1,0],["تياسِرُهُ الأشياءُ منقادةً له","فإن عاسرتْهُ مرّةً خَشَّ أو خَزَمْ",32,"م",1,0],["تيهَ المُجاهِدُ نالَ بُغيَتُهُ","أَو تيهَ مِسكينٍ إِذا سَعِدا",33,"د",2,0],["تيهي عَلى العاني كَما","تاهَ الغَنِيُّ عَلى الفَقيرِ",34,"ر",1,0],["تَيَّمَكَ الرَوضُ فيهِ حَتّى","تَخِذتَ باحاتِهِ مَقاما",35,"م",2,0],["تيجى تصيده يصيدك","ومين سِلِم من حباله",36,"ه",1,0],["تيهي بِعيدِكِ في المَمالِكِ وَاِسلَمي","في السِلمِ لِلآلافِ مِن أَمثالِهِ",37,"ل",2,0],["تَئِنُّ والنّفْسُ تَسْتَديرُ بهَا","رَحى مِنَ الموتِ مُرَّةُ القطبِ",38,"ب",1,0],["تَيَمَّمَني وَكيلُكَ مادِحاً لي","وَأَنشَدَني مِنَ الشِعرِ الغَريبا",39,"ب",2,0],["تَئِقٌ إِذا ما الضيمُ مَسَّ إِهابَه","لم يرضَ أو يتخضبَ الأنبوبُ",40,"ب",1,0],["تَيَّمَتهُ عُرى الأُمورِ وَراقَت","هُ اِستِباءً لِلُبِّهِ وَخِلابَه",41,"ب",2,0],["تيحُ لَها وادِعاً تَمَهُّلُهُ","في مُرهِقِ الأَمرِ واسِعاً لَبَبُه",42,"ب",2,0],["تَيَمَّموا الخُطَّةَ المُثلى عَلى سَنَنٍ","لَم يَظلِموهُ وَباعوا الغَيَّ بِالرَشَدِ",43,"د",1,0],["تَيَّمَتهُ صَبابَةً وَإِشتِياقُ","وَشَجاهُ يَومَ الفِراقِ الفِراقُ",44,"ق",1,1],["تئلَفُ المَكرُماتُ ساحَةَ خِرقٍ","حائِزٌ ذِكرَ مِثلِها أَمثالُه",45,"ل",2,0],["تَيَقَّنتَ أَنَّ العَينَ جِدُّ غَزيرَةٍ","عَلَيكَ وَأَنَّ القَلبَ جِدُّ حَزينِ",46,"ن",1,0],["تيمَّمَ كَرخايا فجاد قلبُيها","عليه وما شُربُ القليبِ لنا شُربا",47,"ب",2,0],["تَيَمَّمتُ هَمدانَ الَّذينَ هُمُ هُمُ","إِذا نابَ أَمرٌ جُنَّتي وَحُسامي",48,"م",2,0],["تَيَقَّظ فَإِنَّكَ في غَفلَةٍ","يَميدُ بِكَ السُكرُ فيمَن يَميدُ",49,"د",1,0],["تَيَقَّظَ بي غُنجُ جَفنٍ غَضيضٍ","بِفَنٍّ يَشُنُّ ضَنىً جُثَّتي",50,"ت",2,0],["تَيَقَّنَ مُذ أَعرَضتُ أَنّي لَهُ سالي","فَأوهَمَ ضِدّي أَنَّهُ الهاجِرُ القالي",51,"ي",1,1],["تَيَقَّنَ أَنَّ طيبَ الذِكرِ يَبقى","وَكُلَّ نَعيمِ مُلكٍ في زَوالِ",52,"ل",1,0],["تَيّاهةُ الدلّ لا تنفكّ في فَرَحٍ","إذا رأتني من الهجرانِ في حزنِ",53,"ن",1,0],["تَيَّمَتهُ العُلى فَلَيسَ يَعُدُّ ال","بُؤسَ بُؤساً وَلا النَعيمَ نَعيما",54,"م",2,0],["تَيَقَّنتُ أَنَّ البَينَ أَوَّلُ فاتِكٍ","بِهِ مُذ رَأَيتُ الهَجرَ وَهوَ يُغازِلُه",55,"ل",2,0],["تيمناً بكَ حتى قيلَ إن سدرتْ","إبلي فمرآكَ يشفيها من السدرِ",56,"ر",1,0],["تيهي بأشباهِ العصامِيّينَ","منكِ على “عِصَامِ”",57,"م",1,0],["(تَيْمورُ) خَفَّ و(هُولاكو) وقد سَحَقا","كلَّ الدُّنى وعلى أَسْوارِكِ انْسَحَقا",58,"ق",2,0],["تيجانُهُم مَخضوبَةٌ بِدِمائِهِ","وَعُروشُهُم مَبنِيَّةٌ بِعِظامِهِ",59,"م",2,0],["تَيَقَّظ لِي مَعرُوفُهُ واعتِنَاؤُهُ","وسَعيِي وسنَانٌ وحِرصِيَ نَائِمُ",60,"م",1,0],["تَيَمَّمتُ بِالكِديَونِ كَي لا يَفوتَني","مِنَ المَقلَةِ البَيضاءِ تَقريظُ باعِقِ",61,"ق",1,1],["تَئطُّ دونَ الرِجالِ الأَقرَبينَ بِهِ","قُربى رَؤومٌ وَجَيبٌ طالَما نَصَحا",62,"ح",2,0],["تيجانُهُم حِلمٌ إِذا ما سُقوا","قَد فُصِّصَت بِالجودِ وَالظُرفِ",63,"ف",1,0],["تَيَّمَتني بِبَنانٍ","وَبِدَلٍّ قَد شَجاني",64,"ن",2,0],["تَيَّمَتني يَومَ رُحنا","بِثَناياها الحِسانِ",64,"ن",1,0],["تَيَّمَتهُ عَجزاءُ مَهضومَةُ الكَش","حِ تَغولُ الحِجى بِعَينٍ وَجيدِ",65,"د",1,0],["تَيَّمَتني إِذ تَهادَت","في ثَلاثٍ تائِباتِ",66,"ت",1,0],["تَيَّمَتني بِقَوامٍ خُرعُبٍ","وَبِدَلٍّ عَجَبٍ يا لَلعَجَب",67,"ب",1,0],["تَيَمَّمَ فَجّاً واحِداً كُلُّ راكِبِ","وَلا بُدَّ أَنّي سالِكٌ ذَلِكَ الفَجّا",68,"ج",2,1],["تَيَمَّموا بِتُرابي عَلَّ فِعلَكُمُ"