https://www.aldiwan.net/poem48675.html","الطويل"],[541,"بمقدمك الحمراء قد عبقت عطرا","https://www.aldiwan.net/poem48185.html","عموديه"],[554,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[565,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[566,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[567,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""],[567,"فؤادي قد أغواه من بعد رشده","https://www.aldiwan.net/poem901.html",""],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/17699","الكامل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/200370","الطويل"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/46009","الطويل"],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/28927","الكامل"]],"verses":[["تيمَّموا بِصعيدِ الأرضِ حين رَأَوْا","وَقَدْ ظَمى الدينُ أنَّ الماءَ قد فُقِدا",0,"د",2,0],["تَيَقَّظَ وَالعُيونُ مُغَمَّضاتٌ","وَقَلقَلَ وَالرَعِيَّةُ وادِعونا",1,"ن",2,0],["تَيَقَّظتُمُ لِدِفاعِ الخُطوبِ","فَلَم تَترُكونَ الأَعادي نِياما",2,"م",2,0],["تَيَمَّمتُ قَيساً وَكَم دونَهُ","مِنَ الأَرضِ مِن مَهمَهٍ ذي شَزَن",3,"ن",1,0],["تَيَمَّموا أَرضَ كولُمبٍ فَما شَعَرَت","مِنهُم بِوَطءِ غَريبِ الدارِ حَيرانِ",4,"ن",1,0],["تَيَمَّمتُها وَاللَيلُ في غَيرِ زَيِّهِ","وَحاسِدُها في الأُفقِ يُغري بِيَ العِدا",5,"د",2,0],["تَيَمَّمتُ سَعدَ اللَهِ لِلفَألِ بِاسمِهِ","وَلَم آتِ سَعدَ اللَهِ لَو كانَ لي عَقلُ",6,"ل",1,1],["تَيَمَّمتُ سَعدَ اللَهِ لِلفَألِ بِاسمِهِ","وَقُلتُ كَريمٌ بَينَ موسى وَمَريَمِ",7,"م",1,1],["تَيامَنَّ عَن ذي المُرِّ في مُسبَطِرَّةِ","يَدُلُّ بِها الحادي المُدِلُّ المُراوِما",8,"م",2,0],["تَئِنُّ إِلى العَجمِ وَالأَبهَرينِ","أَنينَ المَريضِ تَشَكّى المُغاثا",9,"ث",2,0],["تَيَمَّمتُ لَهبًا أَبتَغي العِلم عِندَهُم","وَقَد رُدَّ عِلمُ العَائِفينَ إلى لَهبِ",10,"ب",1,1],["تَيَمَّمتُ شَيخًا مِنهُمُ ذا بَجَالةٍ","بَصيرًا بِزَجرِ الطَيرِ مُنحنيَ الصُلبِ",10,"ب",1,0],["تَئِن سَوَاقٍ بُحَّ بِالشَّجْوِ صَوْتُهَا","وَيثمَلُ سِرْبٌ حَوْلَهَا مُتَنَادِمُ",11,"م",1,0],["تَيَمَّمنَ يافوخَ الدُجى فَصَدَعنَهُ","وَجَوزَ الفَلا صَدعَ السُيوفِ الصَوادِعِ",12,"ع",1,1],["تَيَمَّمنَ عَيناً مِن أُثالٍ نَميرَةً","قَموساً يَمُجُّ المُنقِضاتُ اِحتِفالُها",13,"ل",3,0],["تَياسَرنَ عَن حَذوِ الفَراقِدِ في السُرى","وَيا مَن شَيئاً عَن يَمينِ المَغاوِرِ",14,"ر",1,0],["تَيَمَّمَ ناوي آلِ خَرقاءَ مُنهِلاً","لَهُ كَوكَبٌ في صَرَّةِ القَيظِ بارِدُ",15,"د",1,0],["تَئِنُ إِذا ما النَسعُ بَعدَ اِعوِجاجِها","تَصَوَّبَ في حَيزومِها ثُمَّ أَصعَدا",16,"د",2,0],["تئن وقد مدّ الظلام رِواقه","وخيّم صمت في الدجى وسكون",17,"ن",1,0],["تيمَّم من بعد الحجاز تهامة","وراح إلى صنعاء يُزجي الركائبا",18,"ب",2,0],["تَيَقّظ فما أنت بالخالد","ولا حادث الدهر بالراقد",19,"د",1,1],["تَيمِيَّةٌ هَمَشى تَقولُ لِبَعلِها","لا تَنظُرَنَّ إِذا وَضَعتُ ثِيابي",20,"ب",2,0],["تيهٌ يَحارُ بِهِ الهادي إِذا اِطَّرَدَت","فيهِ الرِياحُ وَهابي التُربِ مَنخولُ",21,"ل",1,0],["تَيَمَّنتُم بِمُؤتَشِبٍ حَمِيل","لَعَلَّكُمُ بِهِ تَتَشاءَمُونَا",22,"ن",2,0],["تيممتَ منها روضةً نبوية","جنيتَ بها زهرَ الرّضا وهو مخصب",23,"ب",1,0],["تيممها الملكُ المؤيدُ وادِعاً","تيممَ منصورِ اللواء مطوَّد",24,"د",1,0],["تيهي وصدِّي إذا ما شئت واحْتكمي","على النفوسِ فإن الحسن ولاَّك",25,"ك",1,0],["تيممت أجواداً وفاضت بحوركم","فلم يبق عندي رخصة في التيمم",26,"م",1,0],["تِيهاً بأن مَلَك الحِما","ر عدمتُ قلة خيره",27,"ر",2,0],["تيمَّمت منهمْ بالمديح مُمدَّحاً","يطاوعُ فيه القولُ حين يُعاصي",28,"ص",2,0],["تيَقَّظَ للعُلا والمدَّعُوها","لهمْ في نومهم عنها غطيطُ",29,"ط",1,0],["تيس تنفق بالدلال ليشتهى","فازداد مقتاً بالدلال وما نفق",30,"ق",1,1],["تيجانُ أهلِ التصابي من قرونِهمُ","قدْماً ومن صفوة العارِ الأكاليلُ",31,"ل",1,0],["تيقَّظْ أبا عبدِ الإله فإنها","مَناعس لا تعشَى امرءاً فائز الخصْلِ",32,"ل",1,0],["تياسِرُهُ الأشياءُ منقادةً له","فإن عاسرتْهُ مرّةً خَشَّ أو خَزَمْ",33,"م",1,0],["تيهَ المُجاهِدُ نالَ بُغيَتُهُ","أَو تيهَ مِسكينٍ إِذا سَعِدا",34,"د",2,0],["تيهي عَلى العاني كَما","تاهَ الغَنِيُّ عَلى الفَقيرِ",35,"ر",1,0],["تَيَّمَكَ الرَوضُ فيهِ حَتّى","تَخِذتَ باحاتِهِ مَقاما",36,"م",2,0],["تيجى تصيده يصيدك","ومين سِلِم من حباله",37,"ه",1,0],["تيهي بِعيدِكِ في المَمالِكِ وَاِسلَمي","في السِلمِ لِلآلافِ مِن أَمثالِهِ",38,"ل",2,0],["تَئِنُّ والنّفْسُ تَسْتَديرُ بهَا","رَحى مِنَ الموتِ مُرَّةُ القطبِ",39,"ب",1,0],["تَيَمَّمَني وَكيلُكَ مادِحاً لي","وَأَنشَدَني مِنَ الشِعرِ الغَريبا",40,"ب",2,0],["تَئِقٌ إِذا ما الضيمُ مَسَّ إِهابَه","لم يرضَ أو يتخضبَ الأنبوبُ",41,"ب",1,0],["تَيَّمَتهُ عُرى الأُمورِ وَراقَت","هُ اِستِباءً لِلُبِّهِ وَخِلابَه",42,"ب",2,0],["تيحُ لَها وادِعاً تَمَهُّلُهُ","في مُرهِقِ الأَمرِ واسِعاً لَبَبُه",43,"ب",2,0],["تَيَمَّموا الخُطَّةَ المُثلى عَلى سَنَنٍ","لَم يَظلِموهُ وَباعوا الغَيَّ بِالرَشَدِ",44,"د",1,0],["تَيَّمَتهُ صَبابَةً وَإِشتِياقُ","وَشَجاهُ يَومَ الفِراقِ الفِراقُ",45,"ق",1,1],["تئلَفُ المَكرُماتُ ساحَةَ خِرقٍ","حائِزٌ ذِكرَ مِثلِها أَمثالُه",46,"ل",2,0],["تَيَقَّنتَ أَنَّ العَينَ جِدُّ غَزيرَةٍ","عَلَيكَ وَأَنَّ القَلبَ جِدُّ حَزينِ",47,"ن",1,0],["تيمَّمَ كَرخايا فجاد قلبُيها","عليه وما شُربُ القليبِ لنا شُربا",48,"ب",2,0],["تَيَمَّمتُ هَمدانَ الَّذينَ هُمُ هُمُ","إِذا نابَ أَمرٌ جُنَّتي وَحُسامي",49,"م",2,0],["تَيَقَّظ فَإِنَّكَ في غَفلَةٍ","يَميدُ بِكَ السُكرُ فيمَن يَميدُ",50,"د",1,0],["تَيَقَّظَ بي غُنجُ جَفنٍ غَضيضٍ","بِفَنٍّ يَشُنُّ ضَنىً جُثَّتي",51,"ت",2,0],["تَيَقَّنَ مُذ أَعرَضتُ أَنّي لَهُ سالي","فَأوهَمَ ضِدّي أَنَّهُ الهاجِرُ القالي",52,"ل",2,1],["تَيَقَّنَ أَنَّ طيبَ الذِكرِ يَبقى","وَكُلَّ نَعيمِ مُلكٍ في زَوالِ",53,"ل",1,0],["تَيّاهةُ الدلّ لا تنفكّ في فَرَحٍ","إذا رأتني من الهجرانِ في حزنِ",54,"ن",1,0],["تَيَّمَتهُ العُلى فَلَيسَ يَعُدُّ ال","بُؤسَ بُؤساً وَلا النَعيمَ نَعيما",55,"م",2,0],["تَيَقَّنتُ أَنَّ البَينَ أَوَّلُ فاتِكٍ","بِهِ مُذ رَأَيتُ الهَجرَ وَهوَ يُغازِلُه",56,"ل",2,0],["تيمناً بكَ حتى قيلَ إن سدرتْ","إبلي فمرآكَ يشفيها من السدرِ",57,"ر",1,0],["تيهي بأشباهِ العصامِيّينَ","منكِ على “عِصَامِ”",58,"م",1,0],["(تَيْمورُ) خَفَّ و(هُولاكو) وقد سَحَقا","كلَّ الدُّنى وعلى أَسْوارِكِ انْسَحَقا",59,"ق",2,0],["تيجانُهُم مَخضوبَةٌ بِدِمائِهِ","وَعُروشُهُم مَبنِيَّةٌ بِعِظامِهِ",60,"م",2,0],["تَيَقَّظ لِي مَ