{"poems":[[53,"تواعد ذا الخليط لأن يبينا","https://www.aldiwan.net/poem29647.html","الوافر"],[53,"ضربن إلينا خدودا وساما","https://www.aldiwan.net/poem29807.html","المتقارب"],[9,"لعمرك ما طول هذا الزمن","https://www.aldiwan.net/poem21986.html","المتقارب"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[86,"تعمدت قتلي في الهوى وتعمدا","https://www.aldiwan.net/poem68959.html","الطويل"],[71,"تيممت سعد الله للفأل باسمه","https://www.aldiwan.net/poem3769.html","الطويل"],[71,"تيممت سعد الله","https://www.aldiwan.net/poem3770.html","الطويل"],[35,"إلى ظعن يتبعن في قتر الضحى","https://www.aldiwan.net/poem39091.html","الطويل"],[35,"حبال سجيفة أمست رثاثا","https://www.aldiwan.net/poem39175.html","المتقارب"],[35,"تيممت لهبا أبتغي العلم عندهم","https://www.aldiwan.net/poem39181.html","الطويل"],[93,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[30,"تيممن يافوخ الدجى فصدعنه","https://www.aldiwan.net/poem29468.html","الطويل"],[30,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[30,"ألا أيها الربع الذي غير البلى","https://www.aldiwan.net/poem29602.html","الطويل"],[30,"تغير بعدي من أميمة شارع","https://www.aldiwan.net/poem29603.html","الطويل"],[88,"بكت في ظلام الليل تندب أهلها","https://www.aldiwan.net/poem44803.html","الطويل"],[88,"هي النفس أغشى في رضاها المعاطبا","https://www.aldiwan.net/poem44814.html","الطويل"],[88,"تيقظ فما أنت بالخالد","https://www.aldiwan.net/poem44977.html","المتقارب"],[27,"قال الأمير لعبد تيم بئس ما","https://www.aldiwan.net/poem5683.html","الكامل"],[27,"خف القطين فقلبي اليوم متبول","https://www.aldiwan.net/poem5952.html","البسيط"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"قدمت قدوم الغيث والحي مجذب","https://www.aldiwan.net/poem18238.html","الطويل"],[72,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[72,"لثمت ثغر عذولي حين سماك","https://www.aldiwan.net/poem19438.html","البسيط"],[72,"لمولودكم يا آل يعقوب أنجم","https://www.aldiwan.net/poem19985.html","الطويل"],[51,"منع المخنث أحمد","https://www.aldiwan.net/poem64006.html","مجزوء الكامل"],[51,"أبى القلب إلا وجده برخاص","https://www.aldiwan.net/poem64933.html","الطويل"],[51,"أَحاط بحرمتي ما كان مني","https://www.aldiwan.net/poem65002.html","الوافر"],[51,"تيس تنفق بالدلال ليشتهى","https://www.aldiwan.net/poem65744.html","الكامل"],[51,"يا أحمد بن سعيد لا تمت جزعا","https://www.aldiwan.net/poem65873.html","البسيط"],[51,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[91,"قالت سكت وما سكت سدى","https://www.aldiwan.net/poem8813.html","عموديه"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[91,"يا رب ليل بلا سناء","https://www.aldiwan.net/poem62711.html","عموديه"],[85,"اللى يحب الجمال","https://www.aldiwan.net/poem6807.html","عموديه"],[85,"الملك بين يديك في إقباله","https://www.aldiwan.net/poem63756.html","الكامل"],[56,"يا عين لا للغضا ولا الكثب","https://www.aldiwan.net/poem58644.html","المنسرح"],[43,"ضروب الناس عشاق ضروبا","https://www.aldiwan.net/poem9501.html","الوافر"],[62,"تصعيد هذا الدهر والتصويب","https://www.aldiwan.net/poem52503.html","الكامل"],[45,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[45,"من قائل للزمان ما أربه","https://www.aldiwan.net/poem11054.html","المنسرح"],[45,"يفندون وهم أدنى إلى الفند","https://www.aldiwan.net/poem63480.html","الوافر"],[45,"تيمته صبابة وإشتياق","https://www.aldiwan.net/poem65211.html","الخفيف"],[45,"عاود القلب بثه وخباله","https://www.aldiwan.net/poem65603.html","الخفيف"],[45,"أقول لعنس كالعلاة أمون","https://www.aldiwan.net/poem66666.html","الطويل"],[61,"أرى الشاعر الملحي راح بنا صبا","https://www.aldiwan.net/poem51803.html","الطويل"],[58,"ولما رأيت الخيل تقرع بالقنا","https://www.aldiwan.net/poem30881.html","الطويل"],[49,"ألا إن ربي قوي مجيد","https://www.aldiwan.net/poem62037.html","المتقارب"],[66,"فتنت بظبي بغى خيبتي","https://www.aldiwan.net/poem38651.html","المتقارب"],[66,"تيقن مذ أعرضت أني له سالي","https://www.aldiwan.net/poem40100.html","الطويل"],[66,"نفوس الصيد أثمان المعالي","https://www.aldiwan.net/poem40137.html","الوافر"],[80,"وذات عين من الغزلان فاترة","https://www.aldiwan.net/poem31276.html","البسيط"],[44,"إن عهدا لو تعلمان ذميما","https://www.aldiwan.net/poem30357.html","الخفيف"],[44,"أجل أيها الربع الذي خف آهله","https://www.aldiwan.net/poem30388.html","الطويل"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[90,"نامي جياع الشعب نامي","https://www.aldiwan.net/poem59037.html","عموديه"],[90,"شممت تربك لا زلفى ولا ملقا","https://www.aldiwan.net/poem60156.html","عموديه"],[105,"حل الوفاء الحق عقد ذمامه","https://www.aldiwan.net/poem43101.html","الكامل"],[81,"هو الفتح حقا ما على الشمس كاتم","https://www.aldiwan.net/poem61322.html","الطويل"],[39,"تيممت بالكديون كي لا يفوتني","https://www.aldiwan.net/poem53702.html","الطويل"],[48,"قد عذب الحب هذا القلب ما صلحا","https://www.aldiwan.net/poem62533.html","البسيط"],[48,"سقيا لبغداد وأيامها","https://www.aldiwan.net/poem64399.html","السريع"],[50,"سيدي خذ بي أتانا","https://www.aldiwan.net/poem24538.html","مجزوء الرمل"],[50,"اشفعي لي صريم عند الكنود","https://www.aldiwan.net/poem63937.html","الخفيف"],[50,"هام قلبي باللواتي","https://www.aldiwan.net/poem64733.html","مجزوء الرمل"],[50,"آب ليلي ليت ليلي لم يأب","https://www.aldiwan.net/poem64814.html","الرمل"],[46,"تيمم فجا واحدا كل راكب","https://www.aldiwan.net/poem22248.html","الطويل"],[46,"لا أسأل المرء قرضا من شهادته","https://www.aldiwan.net/poem22890.html","البسيط"],[46,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85553","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39561","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147503","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202689","المجتث"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30514","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30434","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55169","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55161","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55058","الوافر"],[74,"","https://poetry.dctabudhabi.ae/diwan/poem/8565","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141973","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[106,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[106,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179448",""],[90,"عبادة الشر","https://www.poetsgate.com/ViewPoem.aspx?id=179136",""],[35,"تَيَمَّمْتُ لَهْباً أبتغي العِلْم عِنْدَهُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=21924",""],[30,"ألا أيُّها الرَّسمُ الذي غيَّرَ البلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20510&r=&rc=4",""],[96,"الملك البطل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66347&r=&rc=23",""]],"verses":[["تَيَقَّظَ وَالعُيونُ مُغَمَّضاتٌ","وَقَلقَلَ وَالرَعِيَّةُ وادِعونا",0,"ن",2,0],["تَيَقَّظتُمُ لِدِفاعِ الخُطوبِ","فَلَم تَترُكونَ الأَعادي نِياما",1,"م",2,0],["تَيَمَّمتُ قَيساً وَكَم دونَهُ","مِنَ الأَرضِ مِن مَهمَهٍ ذي شَزَن",2,"ن",1,0],["تَيَمَّموا أَرضَ كولُمبٍ فَما شَعَرَت","مِنهُم بِوَطءِ غَريبِ الدارِ حَيرانِ",3,"ن",1,0],["تَيَمَّمتُها وَاللَيلُ في غَيرِ زَيِّهِ","وَحاسِدُها في الأُفقِ يُغري بِيَ العِدا",4,"د",2,0],["تَيَمَّمتُ سَعدَ اللَهِ لِلفَألِ بِاسمِهِ","وَلَم آتِ سَعدَ اللَهِ لَو كانَ لي عَقلُ",5,"ل",1,1],["تَيَمَّمتُ سَعدَ اللَهِ لِلفَألِ بِاسمِهِ","وَقُلتُ كَريمٌ بَينَ موسى وَمَريَمِ",6,"م",1,1],["تَيامَنَّ عَن ذي المُرِّ في مُسبَطِرَّةِ","يَدُلُّ بِها الحادي المُدِلُّ المُراوِما",7,"م",2,0],["تَئِنُّ إِلى العَجمِ وَالأَبهَرينِ","أَنينَ المَريضِ تَشَكّى المُغاثا",8,"ث",2,0],["تَيَمَّمتُ لَهبًا أَبتَغي العِلم عِندَهُم","وَقَد رُدَّ عِلمُ العَائِفينَ إلى لَهبِ",9,"ب",1,1],["تَيَمَّمتُ شَيخًا مِنهُمُ ذا بَجَالةٍ","بَصيرًا بِزَجرِ الطَيرِ مُنحنيَ الصُلبِ",9,"ب",1,0],["تَئِن سَوَاقٍ بُحَّ بِالشَّجْوِ صَوْتُهَا","وَيثمَلُ سِرْبٌ حَوْلَهَا مُتَنَادِمُ",10,"م",1,0],["تَيَمَّمنَ يافوخَ الدُجى فَصَدَعنَهُ","وَجَوزَ الفَلا صَدعَ السُيوفِ الصَوادِعِ",11,"ع",1,1],["تَيَمَّمنَ عَيناً مِن أُثالٍ نَميرَةً","قَموساً يَمُجُّ المُنقِضاتُ اِحتِفالُها",12,"ل",3,0],["تَياسَرنَ عَن حَذوِ الفَراقِدِ في السُرى","وَيا مَن شَيئاً عَن يَمينِ المَغاوِرِ",13,"ر",1,0],["تَيَمَّمَ ناوي آلِ خَرقاءَ مُنهِلاً","لَهُ كَوكَبٌ في صَرَّةِ القَيظِ بارِدُ",14,"د",1,0],["تَئِنُ إِذا ما النَسعُ بَعدَ اِعوِجاجِها","تَصَوَّبَ في حَيزومِها ثُمَّ أَصعَدا",15,"د",2,0],["تئن وقد مدّ الظلام رِواقه","وخيّم صمت في الدجى وسكون",16,"ن",1,0],["تيمَّم من بعد الحجاز تهامة","وراح إلى صنعاء يُزجي الركائبا",17,"ب",2,0],["تَيَقّظ فما أنت بالخالد","ولا حادث الدهر بالراقد",18,"د",1,1],["تَيمِيَّةٌ هَمَشى تَقولُ لِبَعلِها","لا تَنظُرَنَّ إِذا وَضَعتُ ثِيابي",19,"ب",2,0],["تيهٌ يَحارُ بِهِ الهادي إِذا اِطَّرَدَت","فيهِ الرِياحُ وَهابي التُربِ مَنخولُ",20,"ل",1,0],["تَيَمَّنتُم بِمُؤتَشِبٍ حَمِيل","لَعَلَّكُمُ بِهِ تَتَشاءَمُونَا",21,"ن",2,0],["تيممتَ منها روضةً نبوية","جنيتَ بها زهرَ الرّضا وهو مخصب",22,"ب",1,0],["تيممها الملكُ المؤيدُ وادِعاً","تيممَ منصورِ اللواء مطوَّد",23,"د",1,0],["تيهي وصدِّي إذا ما شئت واحْتكمي","على النفوسِ فإن الحسن ولاَّك",24,"ك",1,0],["تيممت أجواداً وفاضت بحوركم","فلم يبق عندي رخصة في التيمم",25,"م",1,0],["تِيهاً بأن مَلَك الحِما","ر عدمتُ قلة خيره",26,"ر",2,0],["تيمَّمت منهمْ بالمديح مُمدَّحاً","يطاوعُ فيه القولُ حين يُعاصي",27,"ي",1,0],["تيَقَّظَ للعُلا والمدَّعُوها","لهمْ في نومهم عنها غطيطُ",28,"ط",1,0],["تيس تنفق بالدلال ليشتهى","فازداد مقتاً بالدلال وما نفق",29,"ق",1,1],["تيجانُ أهلِ التصابي من قرونِهمُ","قدْماً ومن صفوة العارِ الأكاليلُ",30,"ل",1,0],["تيقَّظْ أبا عبدِ الإله فإنها","مَناعس لا تعشَى امرءاً فائز الخصْلِ",31,"ل",1,0],["تياسِرُهُ الأشياءُ منقادةً له","فإن عاسرتْهُ مرّةً خَشَّ أو خَزَمْ",32,"م",1,0],["تيهَ المُجاهِدُ نالَ بُغيَتُهُ","أَو تيهَ مِسكينٍ إِذا سَعِدا",33,"د",2,0],["تيهي عَلى العاني كَما","تاهَ الغَنِيُّ عَلى الفَقيرِ",34,"ر",1,0],["تَيَّمَكَ الرَوضُ فيهِ حَتّى","تَخِذتَ باحاتِهِ مَقاما",35,"م",2,0],["تيجى تصيده يصيدك","ومين سِلِم من حباله",36,"ه",1,0],["تيهي بِعيدِكِ في المَمالِكِ وَاِسلَمي","في السِلمِ لِلآلافِ مِن أَمثالِهِ",37,"ل",2,0],["تَئِنُّ والنّفْسُ تَسْتَديرُ بهَا","رَحى مِنَ الموتِ مُرَّةُ القطبِ",38,"ب",1,0],["تَيَمَّمَني وَكيلُكَ مادِحاً لي","وَأَنشَدَني مِنَ الشِعرِ الغَريبا",39,"ب",2,0],["تَئِقٌ إِذا ما الضيمُ مَسَّ إِهابَه","لم يرضَ أو يتخضبَ الأنبوبُ",40,"ب",1,0],["تَيَّمَتهُ عُرى الأُمورِ وَراقَت","هُ اِستِباءً لِلُبِّهِ وَخِلابَه",41,"ب",2,0],["تيحُ لَها وادِعاً تَمَهُّلُهُ","في مُرهِقِ الأَمرِ واسِعاً لَبَبُه",42,"ب",2,0],["تَيَمَّموا الخُطَّةَ المُثلى عَلى سَنَنٍ","لَم يَظلِموهُ وَباعوا الغَيَّ بِالرَشَدِ",43,"د",1,0],["تَيَّمَتهُ صَبابَةً وَإِشتِياقُ","وَشَجاهُ يَومَ الفِراقِ الفِراقُ",44,"ق",1,1],["تئلَفُ المَكرُماتُ ساحَةَ خِرقٍ","حائِزٌ ذِكرَ مِثلِها أَمثالُه",45,"ل",2,0],["تَيَقَّنتَ أَنَّ العَينَ جِدُّ غَزيرَةٍ","عَلَيكَ وَأَنَّ القَلبَ جِدُّ حَزينِ",46,"ن",1,0],["تيمَّمَ كَرخايا فجاد قلبُيها","عليه وما شُربُ القليبِ لنا شُربا",47,"ب",2,0],["تَيَمَّمتُ هَمدانَ الَّذينَ هُمُ هُمُ","إِذا نابَ أَمرٌ جُنَّتي وَحُسامي",48,"م",2,0],["تَيَقَّظ فَإِنَّكَ في غَفلَةٍ","يَميدُ بِكَ السُكرُ فيمَن يَميدُ",49,"د",1,0],["تَيَقَّظَ بي غُنجُ جَفنٍ غَضيضٍ","بِفَنٍّ يَشُنُّ ضَنىً جُثَّتي",50,"ت",2,0],["تَيَقَّنَ مُذ أَعرَضتُ أَنّي لَهُ سالي","فَأوهَمَ ضِدّي أَنَّهُ الهاجِرُ القالي",51,"ي",1,1],["تَيَقَّنَ أَنَّ طيبَ الذِكرِ يَبقى","وَكُلَّ نَعيمِ مُلكٍ في زَوالِ",52,"ل",1,0],["تَيّاهةُ الدلّ لا تنفكّ في فَرَحٍ","إذا رأتني من الهجرانِ في حزنِ",5