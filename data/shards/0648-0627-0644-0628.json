َمسَحُهُ ال","نُزّاعُ مِن شامٍ وَمِن يَمَنِ",1,"ن",1,0],["وَأَلبَسُها حَمراءَ تَضفو ذُيولُها","مِنَ الدَمِ بُعداً عَن لِباسِ المَلاوِمِ",2,"م",1,0],["وَالبيضُ قَد طَلَعنَ مِن أَغمادِها","لِلرَوعِ تَعلو قِمَمَ القَبائِلِ",3,"ل",1,0],["وَأَلبَسَ العارَ الطَويلَ لِبسَها","وَأَرضَعَ الذُلَّ لَها رَضاعَها",4,"ع",3,0],["وَالبَيتِ قالِصَةً عَنهُ ذَلاذِلُهُ","سَومَ المَخيضِ جَلا عَن رُكنِهِ الحَجرُ",5,"ر",1,0],["وَالبارِقاتُ تَلَوّى في مَغامِدِها","وَالسابِقاتُ تَمَطّى في المَضاميرِ",6,"ر",1,0],["وَالبالِغُ الأَمرِ جالَت دونَ مَبلَغِهِ","سُمرُ القَنا وَأُمِرَّت دونَهُ المِرَرُ",7,"ر",1,0],["وَالبَدرُ ما ضَرَّهُ تَفَرُّدُهُ","وَلا خَبا نورُهُ وَلا عيبا",8,"ب",2,0],["وَالبيضُ مُرْدَفَةٌ تَبْدو خَلاخِلُها","في مَسْلَكِ وَحِلٍ مِنْ عَبْرَةٍ وَدَمِ",9,"م",1,0],["وألْبَسْتُ دَهْراً أنتَ مالِكُ رِقّهِ","بهِ غُرَراً يَلْمَعْنَ في صَفَحاتِهِ",10,"ت",2,0],["والبِيضُ تَمشي راجِحاتِ الأكْفالْ","منْ كُلِّ بَلْهاءِ التّثَنّي مِكْسالْ",11,"ل",1,0],["وألبس الخِلَّ تَعرَى لي شَمائِلُهُ","منَ الخَنى حَذَرَ الكاسي منَ الدَّرَنِ",12,"ن",1,0],["والبِيضُ تَقْلَقُ في الغُمودِ كَما الْتَوى","رُقْشٌ تَبُلُّ مُتونَها الأنْداءُ",13,"ا",2,0],["والبَرْقُ يختلِسُ الوَميضَ كأنّهُ","بَلْقاءُ تَمْرَحُ حَولَها الأفْلاءُ",13,"ا",2,0],["والبِيضُ تَبْسِمُ والأبطالُ عابِسَةٌ","ما بَينَ مُودٍ ومَكْلومٍ ومعتَقَلِ",14,"ل",1,0],["والبُرْدُ يَعلَمُ أنَّ في أثنائِهِ","كَرَماً يَفوقُ المُزْنَ وهْوَ دَفوقُ",15,"ق",1,0],["وَالبيضُ تَلمَعُ وَالرِماحُ عَواسِلٌ","وَالقَومُ بَينَ مُجَدَّلٍ وَمُقَيَّدِ",16,"د",1,0],["وَالبَدرُ مِن فَوقِ السَحابِ يَسوقُهُ","فَيَسيرُ سَيرَ الراكِبِ المُستَعجِلِ",17,"ل",1,0],["وألْبَسْتُها الأمْنَ سِتْراً حَصيناً","وإنْ هتَكَتْ سِتْريَ المُسْبَلا",18,"ل",2,0],["وَالْبحْرُ قَدْ خَفَقَتْ عَلَيْكَ ضُلُوعُهُ","وَالرِّيحُ تَقْطَعُ الزَّفِيرَ وَتُرْسِلُ",19,"ل",1,0],["وَالْبِيضُ قَدْ كَسَرَتْ حُرُوفَ جُفُونِهَا","وَعَوَامِلُ الأَسَلِ الْمُثَقَّفِ تَعْمَلُ",19,"ل",1,0],["والْبَرْقِ إِلاَّ أَنَّهُنَّ أَسِنَّةٌ","وَالرَّعْدِ إِلاَّ أَنَّهُنَّ طُبُولُ",20,"ل",1,0],["والْبِشْر ُمُنْسَحِبُ الْجَنَاحِ عَلَى الْوَرَى","وَالأُنْسُ تَشْتَمِلُ الْوُجُودَ شَمُولُهُ",21,"ل",2,0],["وَالْبَرَايَا تَبِيدُ وَالْمُلْكُ يَفْنَى","أَيْنَ كِسْرَى الْمُلُوكِ مِع أَبْرَوِيزِ",22,"ز",1,0],["وألْبَسَها النّعْمى ببَيْعَتِكَ التي","لَها الطّائِرُ المَيْمونُ والمحْتِدُ الحُرُّ",23,"ر",1,0],["وألْبَسَها النُّعْمى ببَيْعَتِكَ التي","بِها أمِنَ الإسْلامَ وانْسَدَلَ السَّتْرُ",24,"ر",1,0],["والبحْرُ يفْخَرُ منْهُ يومَ وِلادَةٍ","بمَلَنْدِهِ ابْنِ ملَنْدِهِ ابْنِ ملَنْدِهِ",25,"د",2,0],["وألْبَسْتَنا الآلاءَ بِيضاً سَوابِغاً","فزادَكَ مِنْها اللهُ ما تَسْتَزيدُهُ",26,"د",2,0],["وَالْبَدْرُ يَكْسفُ جِرْمَ الشَّمْسِ عَادَتَهُ","هَذَا الْخُسُوفُ الَّذِي قَدْ كُنْتُ أَرْتَقِبُ",27,"ب",1,0],["وَالبَيتُ لا يُبتَنى إِلّا لَهُ عَمَدٌ","وَلا عِمادَ إِذا لَم تُرسَ أَوتادُ",28,"د",1,0],["وَالبيضِ قَد عَنَسَت وَطالَ جِراؤها","وَنَشَأنَ في قِنٍّ وَفي أَذوادِ",29,"د",1,0],["وَالبَغايا يَركُضنَ أَكسِيَةَ الإِض","ريجِ وَالشَرعَبِيَّ ذا الأَذيالِ",30,"ل",1,0],["وَالباذِلينَ نُفوسَهُم لِنَبِّيِهِم","يَومَ الهِياجِ وَقُبَةِ الجَبّارِ",31,"ر",1,0],["وَاِلبَسيني عَلَيهِ ثَوبَ حِدادٍ","وَاِجلِسي لِلعَزاءِ فَالحُزنُ طابا",32,"ب",2,0],["وَالبَرُّ مَصهورَ الحَصى مُتَأَجِّجاً","يَرمي بِنَزّاعِ الشَوى لَوّاحِ",33,"ح",1,0],["وَالبَدرَ لا يَبدو عَلى ثَغرِهِ","مِن بَسَماتِ اليُمنِ ما يَشرَحُ",34,"ح",1,0],["وَأَلبَسوا الغَربَ خِزياً","في قَرنِهِ العِشرينا",35,"ن",2,0],["وَالبيضُ لا تَرضى بِخِذلانِها","وَالصُفرُ بَعدَ اليَومِ لا تُكسَرُ",36,"ر",1,0],["وَالبَدرُ قَد عَلَّمتَهُ","أَدَبَ المُثولِ إِذا رَآك",37,"ك",1,0],["وَأَلبَسَها ثَوباً مِنَ الوَشيِ رائِعاً","وَلَيسَ لَها عَقلٌ فَتُثني وَتَشكُرُ",38,"ر",1,0],["وَأَلبَستُها ثَوباً مِنَ الوَشي مُعلَماً","لِإِتمامِ مَعناها وَإِكمالِ فَخرِها",39,"ر",3,0],["وَأَلبَستَني بُرداً مِنَ المَجدِ ضافِياً","جَعَلتَ عَلَيهِ مِن صِفاتِكَ لي رَقما",40,"م",2,0],["وَاِلبَس مِنَ النِعمَةِ الخَضراءِ أَيكَتَها","ظِلّاً حَراماً عَلى الآفاتِ وَالغِيَرِ",41,"ر",1,0],["والبطرخ المضروب في زيته","قد لان وأبيض كشمع العسل",42,"ل",1,0],["وَالبَنُونَ الأَولى هُمُ العَوَضُ","الغَالِي تُرَجيهُ بَعْدَهُ الأَوْطَانُ",43,"ن",1,0],["وَالبِرُّ مِنْكُمْ بِهِ بِر بِأَنْفُسِكُمْ","إِمَّا الْوُجُودُ بِمَعْنَاهُ أَوِ الْعَدَمُ",44,"م",1,0],["وَالْبِرُّ أَشْرَفَهُ وَأَنْفَعُهُ","لِلنَّاسِ فِي الإِرْشَادِ وَالحِكَمِ",45,"م",1,0],["وَالبَينُ قَطّاعُ ذَوي الأَوصالِ","وَقَرَّبوا قَياسِرَ الجِمالِ",46,"ل",1,0],["والبدور تطلب تربّيه","وتقوم لو بالوظائف",47,"ف",1,0],["والبدر الأكمل مرار عديدا","يرغب منك يكون مربيه",48,"ه",1,0],["والبب مقروح يبكي عليها","ولس ل حيلا بعد إليها",48,"ه",2,0],["والبدور دارت حوالي","من وجوه حسان عوالي",49,"ي",1,0],["والبدرُ في صفح السماء كأنّه","مرآة هندٍ وسط لُجِّ ترتمي",50,"م",2,0],["والباسمون إذا الكماة عوابسٌ","والمقدمون على السوادِ الأعظمِ",50,"م",1,0],["والبرق سيفٌ من سيوفك مُنْتَضَى","والسحبُ تهمي من يديك وتهمُلُ",51,"ل",1,0],["وألبستّهُ بُرداً من الفخر ضافياً","على عطفه وشيُ المديح يُفوَّفُ",52,"ف",1,0],["وألبسها ثوب الوقار خليفةٌ","به لبس الإسلام أشرفَ ملبَسِ",53,"س",1,0],["والبحر تمتار السحائب ماءه","فتجوده من غيثها برذاذِهِ",54,"ذ",2,0],["والبرقُ ما لاح في الظلماء مبتسما","من جانب السفح إلا دمعَه سَفَحا",55,"ح",2,0],["والبدرُ شُقَّ لَهُ وكم من آيةٍ","كأَناملِ جاءتْ بنبع الماءِ",56,"ا",2,0],["والبدر في الأفق الغربيّ ممتقع","يرنو إلى الفجر في ألحاظ مرعوب",57,"ب",1,0],["والبدر في طلعته الزاهية","قد ضاحك البحر بثغرٍ بسيم",58,"م",1,0],["والبدر في مفرق هام السما","تحسبه التاج على المَفرق",58,"ق",1,0],["والبحر في جبهته الصافيه","قام طريقٌ للسنا مستقيم",58,"م",1,0],["والباطن المستور فيه تحكّم","والظاهر المكشوف فيه تصلُّف",59,"ف",1,0],["وألبسهم حمر الغرائز فأغتنَوْا","بحمرتها عن كل ثوب مُوَرّس",60,"س",1,0],["والبُحُورِ التي بها تُكشَفُ الحِرَّ","ةُ والداءُ من غَلِيلِ الأَوَامِ",61,"م",1,0],["والبس لتلك ثياب كلِّ دنّةٍ","سوداً وأحيِ إلى الشميط الأبلقِ",62,"ق",1,1],["وَالبُدنِ إِذ قُرِّبَت لِمَنحَرِها","حِلفَةَ بَرِّ اليَمينِ مُجتَهِدِ",63,"د",1,0],["والبيت حيث سنا الصباحِ عمودُه","وبحيث أخبية السعود خباؤه",64,"ا",3,0],["والبر والمكرمات الغرّ كم هرعت","إليه أفواجُ قصدٍ بعد أفواج",65,"ج",1,0],["والبيت مرفوعٌ لفارقهِ","ما بين أنجابٍ وأنجاد",66,"د",1,0],["وألبسته من فاخر الصوف جبةً","ستعتاض عنها جنَّةً وحريرا",67,"ر",2,0],["وألبستهم علياه فاجْتلبوا","إيناس نعماه قبل الباس",68,"س",1,0],["والبدر شقّ لقربه متهللاً","والجذع حنّ لبعده بتفجّع",69,"ع",1,0],["والباسط الأمن بالأقلام في أممٍ","كأنهم في حماها بين أغيال",70,"ل",1,0],["وألبسني بيضاء ردّ ضياؤها","لدى حاسدٍ حتَّى اسْتحال ضراما",71,"م",2,0],["والبعد عن بابكم ظالم","وهذه قصة مظلوم",72,"م",1,0],["والبدرُ فوق الغصنِ وال","غصنُ الرطيبُ على الكثيبِ",73,"ب",1,0],["وألبستِ الهواجرُ في الفيافي","نضارةَ وجههِ ثوبَ الشحوبِ",74,"ب",1,0],["والباذلُ النائل الجزيل إذا","ما المستغيثُ اللهيف لم يُغَثِ",75,"ث",1,0],["والبائسُ المسكِينُ مستسْلِمٌ","أذلُّ للمكروه من عبْدِ",76,"د",1,0],["والبكر لا تترك الشبانَ طائعةً","للشيخِ من أرذل النِّصفين من عمرِهْ",77,"ر",2,0],["والبدر في أحداجه","بالرَّقم والديباج يُسْتَرْ",78,"ر",1,0],["والبس النعمى جديداً ثوبها","أو ترى نفسك في العمر اللبيس",79,"س",1,0],["والبادئ العرف لا معاد له","يعير إحسانه ويرتجع",80,"ع",1,0],["والبغي عون على المدلِّ به","فاشنأْهُ واجعله بعض ما تدعُ",81,"ع",1,0],["والبسْ جمالك عند كلّ قبيحةٍ","إن التجمّلَ بالرجالِ جميلُ",82,"ل",1,0],["والبيضُ والجون لا نهوى فراقَهما","ولا نزال نذم البيضَ والجونا",83,"ن",2,0],["والبينُ في المخزيات يشرُكُهُ","لا باركَ اللَّهُ في الشريكين",84,"ن",1,0],["وَاِلبِس مَطارِفَ حاكَتها يَراعَتُهُ","تَبقى عَلَيكَ وَيَبلى الخَزُّ وَالقَصَبُ",85,"ب",1,0],["وَالبَدرُ مُنبَعِثُ الشُعاعِ لَطيفُهُ","صافٍ كَذِهنِ الشاعِرِ المُتَوَقِّدِ",86,"د",1,0],["وَالبَدرُ أَسفَرَ رُغمَ شامِخَةٍ","قَد حاوَلَت تَطويهِ كَالسِرِّ",87,"ر",1,0],["وَالبَحرُ خُضِّبَ بِالدِماء وَأَصبَحَت","أَمواجُه وَهيَ اللُجَينُ نُضارا",88,"ر",2,0],["وَالبَحرُ كَم ساءَلَتهُ فَتَضاحَكَت","أَمواجُهُ مِن صَوتِيَ المُتَقَطِّعِ",89,"ع",1,0],["وَالباسِمُ الثَغرِ وَالأَشلاءُ طائِرَةٌ","عَن جانِبَيهِ وَحَرُّ الطَعنِ مُتَّصِلُ",90,"ل",1,0],["وَالبَحرُ ساجٍ صامِتٌ فيهِ خُشوعُ الزاهِدين","لَكِنَّما عَيناكِ باهِتَتانِ في الأُفقِ البَعيد",91,"د",1,0],["وَالبَحرُ قَد ظَفِرَت يَداكَ بِدُرِّهِ","وَحَصاهُ لَكِن هَل مَلَكتَ هَديرُهُ",92,"ه",1,0],["وَالبَدرُ يَلوحُ في قِناعٍ","وَالغُصنُ يَميلُ في غَلائِل",93,"ل",1,0],["وَالبيضُ أَنفُرُ عَنهُمُ","لا أَشتَهي لَونَ المَشيبِ",94,"ب",1,0],["وأَلبَسَهُ حُلَّةً من جَلالٍ شجيٍّ","قويٍّ جميلٍ غَلُوبْ",95,"ب",1,0],["والبسْ رِداءَ الشِّعرِ والأَحلامِ","وارفعْ صَلاتَكَ للجمالِ عَميقةً",96,"ه",1,0],["والبُلبلُ الشَّادي وهاتيكَ","المروجُ الشَّاسِعهْ",97,"ه",1,0],["والبعضُ مَا ذاقَ منها","سِوى حَقيرِ الرَّزايا",98,"ي",2,0],["وَالبَدرُ يَطلع ناقِصاً","حَتّى يُتَمِّمَ مِن كَمالِكْ",99,"ك",1,0],["وَالبَيتِ مِن سَعدِ بنِ زَيدٍ وَالعَدَد","ما يَبتَغي الأَعداءُ مِنّي وَلَقَد",100,"د",1,0],["والبان من هز النسيم","لعطفه متمايل",101,"ل",1,0],["والبحر اما كان رهوا","لم يخفه الواغل",101,"ل",1,0],["والبحر ليس سوى الشرق الذي اضطربت","اموره والرياح الهوج اضغان",102,"ن",1,0],["والبيت فيه نظام حين تبصره","وانه لنظام ما به خلل",103,"ل",1,0],["والبنطلون مستوٍ","لم ينكسر لم ينعقد",104,"د",1,0],["وألبستني ثوب الضنى فلبسته","فأحبِب به ثوبا وإن ضم باليا",105,"ي",2,0],["وَالبَيت تَحتَ قَسطَلِ الحَجاجِ","وَخَيلُهُ أَواخذُ الفِجاجِ",106,"ج",1,0],["وَالبَيتُ أَنتِ الصَوتُ في","هِ وَهوَ لِلصَوتِ صَدى",107,"د",2,0],["والبدرُ فِي ثَبَج السماءِ مُنَوِّرٌ","سالت حُلاه على الثرى وحُلاكِ",108,"ك",1,0],["وَالباسِلانِ شُجاعُ قَلبٍ في الوَغى","وَشُجاعُ رَأيٍ في وَغى الأَفكارِ",109,"ر",1,0],["وَالباكِياتُكَ حينَ يَنقَطِعُ البُكا","وَالزائِراتُكَ في العَراءِ الناءِ",110,"ا",2,0],["وَأَلبَسنَني ثَوبَ الضَنى فَلَبِستُهُ","فَأَحبِب بِهِ ثَوباً وَإِن ضَمَّ بالِيا",111,"ي",2,0],["وَالبوقُ يَهتِفُ وَالسِها","مُ تَرِنُّ وَالقَوسُ الحَنون",112,"ن",1,0],["وَالبَدرُ مِنكَ عَلى العَوالِمِ يَجتَلي","بِشرَ الوُجوهِ وَزَحمَةِ الأَبصارِ",113,"ر",1,0],["وَاِلبَس رِداءَكَ طاهِراً","كَرِداءِ مُرقُصَ في البِيَع",114,"ع",1,0],["وَالبِرَّ عِندَ الأَغنِيا","ءِ مِنَ الشُؤونِ المُهمَلاتِ",115,"ت",1,0],["وَأَلبَسُ مِن رِضاهُ في طَريقي","سِلاحاً يَذعَرُ الأَبطالَ شاكا",116,"ك",2,0],["وَالباعِثُ الجَيشَ قَد غالَت عَجاجَتُهُ","ضَوءَ النَهارِ فَصارَ الظُهرُ كَالطَفَلِ",117,"ل",1,0],["والبدر مملتىء نوراً وباطنه","شمس ومن نورها ينجاب إظلامُ",118,"م",1,0],["والبدر ذو القرنين يلمع نوره","ملآن وهو الأزهر الوضاحُ",119,"ح",1,0],["والبيض يحصن مدة معلومة","فيحول ما فيها ويخرج فرخُها",120,"خ",3,0],["والبحث عن كل الفنون التي","بها تزكى الأنفس الزاهره",121,"ر",2,0],["والبدرُ يرتَجُّ في الخضراء من فَرَقٍ","كأنه قلبُ مذعورٍ يُنادِيكا",122,"ك",2,0],["والبِيضُ أمثالَ الخدودِ صقيلةٌ","والسُّمْرُ أشباهَ القُدودِ رِشَاقُ",123,"ق",1,0],["وألبَستْهُ الشمسُ من ضوئِها","نوراً به يَخْطَفُ نورَ البَصَرْ",124,"ر",1,0],["وألبسَهُ وشيَ الثيابِ مُحَبَّراً","كما هو يكسونِي أيادِيَه تَتْرَى",125,"ر",2,0],["وَأَلبَستَني النُعمى الَّتي غَيَّرَت أَخي","عَلَيَّ فَأَضحى نازِحَ الوُدِّ أَجنَبا",126,"ب",2,0],["وَالبَحرُ لَو زيدَ مِثلاً يَستَعينُ بِهِ","لَطَبَّقَ الأَرضَ باديهِ وَثائِبُهُ",127,"ب",2,0],["وَالبَيتُ لَولا أَنَّ فيهِ فَضيلَةً","يَعلو البُيوتَ بِفَضلِها لَم يُحجَجِ",128,"ج",1,0],["وَالبَغلُ يَنتَزِفُ الغادي عُلالَتَهُ","خِيارُ ما يُمتَطى مِنها وَيُقتَعَدُ",129,"د",1,0],["وَالبُخلُ غُلٌّ آسِرٌ بَعضُهُم","يَقصُرُ عَن نَيلِ المَساعي يَدَه",130,"د",2,0],["وَالبَذلُ يَبذُلُ مِن وَجهِ الكَريمِ وَقَد","يُضحي النَدى وَهوَ لِلحُرِّ الكَريمِ رَدى",131,"د",2,0],["وَالبَحرُ لَولا أَن تُسَيَّرَ سُفنُهُ","بِالريحِ مابَرِحَت عَلَيهِ رَواكِدا",132,"د",2,0],["وَالبَدرُ في حِلٍّ وَفي سَعَةٍ","مِن سَفكِهِ دَمَ عَبدِهِ الحُرِّ",133,"ر",1,0],["وَالبَواقي عَلى اللَيالي وَإِن خا","لَفنَ شَيئاً فَمُشبِهاتُ المَواضي",134,"ض",2,0],["وَالبَحرُ تَمنَعُهُ مَرارَتُهُ","مِن أَن تَسوغَ لِشارِبٍ جُرَعُه",135,"ع",2,0],["وَالبَينُ يَفعَلُ بِالعُشّاقِ مُحتَكِماً","مالَيسَ يَفعَلُهُ الهِندِيُّ وَالأَسَلُ",136,"ل",1,0],["وَالبَينُ يُشعَبُ صَدعاً مِنهُ مُلتَئِماً","وَالغَيُّ يَصدَعُ شَعباً غَيرَ مُلتَئِمِ",137,"م",1,0],["وَالبَدرُ يَكسِفُهُ النَهارُ فَتَبتَدي","ظُلَمُ الدُجى فَتُنيرُهُ أَدجانُها",138,"ن",3,0],["وَالبُعدُ إِن تاجَرَ المَشوقُ بِهِ","قَيضٌ مِنَ القُربِ بَيِّنٌ غَبَنُه",139,"ن",2,0],["وَالباهِلِيُّ بِكُلِّ أَرضٍ حَلَّها","عَبدٌ يُقِرُّ عَلى الهَوانِ المُجلِبِ",140,"ب",1,0],["وَالباهِلِيُّ وَلَو رَأى عِرساً لَهُ","يُغشى حَرامُ فِراشِها لَم يَغضَبِ",140,"ب",1,0],["وأَلبَسَني الَقنا حُلَلاً تَلاقَتْ","عليَّ تَهُزُّ أهداباً قَواني",141,"ي",1,0],["والبَرقُ يُومِضُ بينَها","إيماضَ حاليةِ الأَنامِل",142,"ل",1,0],["والباذلُ النَّفسَ النفيسةَ للقنا","كَرَماً تجاوزَ فيه حَدَّ الباذلِ",143,"ل",1,0],["والبدرُ يَظهرُ في السَّحابِ كأنَّه","عَذراءُ تنظُرُ من وَراءِ سِجافِ",144,"ف",1,0],["والبَسْ غرائبَ مَدْحَةٍ دبَّجتُها","فكأنَّما دَبَّجْتُ منها مِطرَفا",145,"ف",2,0],["والبِيضُ ظِلٌّ عليك الدهرَ منتشرٌ","والنَّقعُ جَيبٌ عليكَ الدهرَ مَزرورُ",146,"ر",1,0],["والبس مدائحنا التي ألبستها","شرفا بذكراك لا يبيد وسوددا",147,"د",2,0],["والبِيضُ فوقَ متونِ الزَّعْفِ خافقةٌ","كأنهن حريقٌ فوقَ أمواجِ",148,"ج",1,0],["وَالبِرُّ سابِعُها وَالصَبرُ ثامِنُها","وَالشُكرُ تاسِعُها وَاللَينُ باقيها",149,"ي",3,0],["وَالبَيتُ ذو السِترِ لَو شاؤوا تُحَدِّثُهُم","نادى بِذَلِكَ رُكنُ البَيتِ وَالحَجَرُ",150,"ر",1,0],["وَاِلبَس أَخاكَ فَإِنَّ كُلَّ أَخٍ تَرى","فَلَهُ مَساوٍ مَرَّةً وَمَحاسِنُ",151,"ن",1,0],["وَالبَغيُ يَصرَعُ أَهلَهُ وَيُريكَهُم","وَجَميعُهُم مِن صَرعِهِ يَتَأَوَّهُ",152,"ه",1,0],["وَالبَدرُ شُقَّ وَأَشرَقَت شَمسُ الضُحى","بَعدَ الغُروبِ وَما بِها نُقصانُ",153,"ن",1,0],["والبحر مجنون العبا","ب يهيج ثائره جنوني",154,"ي",1,0],["والبلى أبصرتهُ رأي العيان","ويداه تنسجان العنكبوت",155,"ت",1,0],["والبشرُ في شربِ المدامةِ فارتقبْ","منها سرورَ النفسِ ساعةَ تَعْذُبُ",156,"ب",1,0],["والبدرِ إذ في يديه للنّدى سُحُبٌ","سواكبٌ عَشْرُها تنهلّ بالمِنَنِ",157,"ن",1,0],["والبرايا أغراضُ نَبْلِ المنايا","وهي أُسْدٌ لها من الدهرِ غِيلُ",158,"ل",1,0],["والبُزْلُ تجنحُ بالقِبابِ كأنّها","سُفُنٌ مدافعةٌ صَباً وشمالا",159,"ل",2,0],["والبدرُ قد ذهبَ الخسوفُ بنورِهِ","في ليلةٍ حَسَرَتْ أواخِرَ مَدِّها",160,"د",3,0],["والبُزلُ تجنحُ بالقبابِ تهادياً","عَوْمَ السفينِ بشمألٍ وجنوبِ",161,"ب",1,0],["وَاِلبَسي اليَأسَ مِنَ النا","سِ فَإِنَّ اليَأسَ مَلجا",162,"ج",2,0],["وَالبيضُ تَلمَعُ في أَكُفِّهِمِ","رَأدَ الضُحى فَتَخالُها شُهبا",163,"ب",2,0],["وَأَلبَسَني ثَوباً مِنَ الحُزنِ وَالأَسى","هِلالٌ عَلَيهِ نَسجُ ثَوبٍ مِنَ التُربِ",164,"ب",1,0],["وَأَلبَسَهُم عَصبَ الرَبيعِ وَوَشيَهُ","وَيُمنَتَهُ نَبتُ النَدى المُتَلاحِكُ",165,"ك",1,0],["وَالبيضُ تَعلَمُ أَنَّ ديناً لَم يَضِع","مُذ سَلَّهُنَّ وَلا أُضيعَ ذِمارُ",166,"ر",1,0],["وَالبَبرُ حينَ اِطلَخَمَّ الأَمرُ صَبَّحَهُم","قَطرٌ مِنَ الحَربِ لَمّا جاءَهُم خَمَدوا",167,"د",3,0],["وَالبِيضُ تَرجُفُ في الأَغمادِ مِن ظَمَأٍ","وَالسُّمرُ تَرعدُ في الأَيمانِ مِن قَرَمِ",168,"م",1,0],["وَالْبَاسِقَاتُ الشُّمَّخُ الْحَوَامِلُ","مَشْمُورَةٌ عَنْ سُوقِهَا الذَّلاذِلُ",169,"ل",1,0],["والبرُّ أوسعُ رزقاً غيرَ أنِّيَ في","قلبي منَ العلمِ والتحصيلِ والطلبِ",170,"ب",1,0],["وَالبَيتِ ذي الأَبطَحِ العَتيقِ وَما","جُلَّلَ مِن حُرِّ عَصبِ ذي اليَمَنِ",171,"ن",1,0],["وَأُلَبّي داعِياً إِن دَعاني","وَتَصامَم عامِداً إِن دَعاكا",172,"ك",2,0],["وَالبُدنُ إِن نُزِّعَت أَجِلَّتُها","بِالخَيفِ يَغشى نُحورَها العَلَقُ",173,"ق",1,0],["وَالبُردُ بَينَ الجُلَّتَينِ بِهِ","تَجتَنُّ مِمَّن طافَ أَو نَظَرا",174,"ر",2,0],["وَالبيضُ تُحنى في الطُلى فَكَأَنَّما","لُوِيَت عُرىً مِنها عَلى أَزرارِ",175,"ر",1,0],["وَاِلبَس رِداءَ السَيفِ وَهوَ مُطَرَّزٌ","تَحتَ العَجاجَةِ بِالنَجيعِ الأَحمَرِ",176,"ر",1,0],["وَالبَرقُ مُنخَزِلٌ يُكِبُّ لِوَجهِهِ","وَيَمُجَّ روحَ الراحِ مِنهُ قَتيلُ",177,"ل",1,0],["والْبَسِ التَّاجَ رفيعاً يزدهي","من ذوي التِّيجانِ أعلى مَفْرقِ",178,"ق",1,0],["وَالبَرُّ مُلتَهِبُ الجَوانِحِ مُضمِرٌ","حَنَقَ المَغيظِ وَلَوعَةَ الحَرّانِ",179,"ن",1,0],["وأُلبِسُهَا رُفَيْدَةَ مُعجباتٍ","ضَوامِنَ أن تُجَلَّ وأن تُصانا",180,"ن",2,0],["وَالبَرقُ سَيفٌ وَالسَحابُ كَتائِبٌ","تُبدي لِوَقعِ غِرارِهِ إِحجاما",181,"م",2,0],["وَالبَحرُ وَالمَيثاءُ وَالحَسَنُ الرِضا","لِلناظِرينَ ثَلاثَةٌ أَكفاءُ",182,"ا",2,0],["والبانِ والزَيتِ والسَمراءِ أَخرَجَها","هذا الدِهان وهذا النُقلُ والأُدمُ",183,"م",1,0],["وَالبائِعِ الأَحرارِ في الأَسواقِ","وَصاحِبِ الفُجّارِ وَالمُرّاقِ",184,"ق",1,0],["وَالبَدرُ يَأخُذُهُ غَيمٌ وَيَترُكُهُ","كَأَنَّهُ سافِرٌ عَن وَجهِ مَلطومِ",185,"م",1,0],["وَأَلبَستَني دِرعاً عَلَيَّ حَصينَةً","فَنادَيتُ صَرفَ الدَهرِ هَل مِن مُبارِزِ",186,"ز",1,0],["وَالبَرقُ يَخطَفُ مِن خِلالِ سَحابِها","خَطفَ الفُؤادِ لِمَوعِدٍ مِن زائِرِ",187,"ر",1,0],["وَأَلبَسَها قَلانِسَ مُعلَماتٍ","وَصاحَبَها بِصَبرٍ وَاِنتِظارِ",188,"ر",1,0],["وَالبيضُ لا يَهتِكنَ ما لاقَيتَهُ","إِلّا بِصَوتِ مُتونِها وَرُكوبِها",189,"ب",3,0],["وَالْبَسْ ثَنَاءً أَجَادَتْ نَسْجَهُ فِكَرٌ","يَغَارُ في الحُسْنِ منه الوشْيُ والحِبَرُ",190,"ر",1,0],["والبَدْرُ بادَرَ مُنْشَقَاً بِدَعْوتِهِ","لهُ كما شُقَّ قَلْبٌ وهْوَ مَتْبُولُ",191,"ل",1,0],["والبانُ في الكُثبانِ طَوْعُ يدي إذا","أومأتُ إيماءً إليْهِ تعطَّفَا",192,"ف",2,0],["والبَرْقُ يَظهرُ في لألاءِ غُرَّتِهِ","قاضٍ من المُزْنِ في أحكامه شَطط",193,"ط",1,0],["والبحرُ والنِّينانُ شاهدةٌ بكم","والشّامخاتُ الشُّمُّ والأحجار",194,"ر",1,0],["وَالباعِثي وَالناسُ قَد رَقَدوا","حَتّى أَكونَ خَليفَةَ البَعلِ",195,"ل",1,0],["وَالبَطنُ طاوٍ تَحكي لَطافَتُهُ","ما ضَمَّنوهُ كُتبَ الدَواوينِ",196,"ن",1,0],["والبرّ لا زلتُ له سالكاً","لي فيه ولا في البحرِ منهاجُ",197,"ج",1,0],["والبكرُ تهوى ضرابَ نيّقةٍ","ولا تراهُ ينزو على جملِه",198,"ل",2,0],["والبيت إن حجّوا فحجّ مبادراً","حانوتَ خمّارٍ وعج سهرا",199,"ر",2,0],["وَالبُخلُ في اللُقيانِ قاتِلُهُ","وَالشَوقُ في الهِجرانِ كارِبُهُ",200,"ب",2,0],["وَالبَينُ قَد أَفِدَت رَكائِبُهُ","وَالقَومُ مِن طَرِبٍ وَمِن صَبِّ",201,"ب",1,0],["وَالبَطنُ ذو عُكَنٍ لَطيفٌ طَيُّهُ","وَالإِتبُ تَنفُجُهُ بِثَديٍ مُقعَدِ",202,"د",1,0],["وَالبَرايا حازوا دُيونَ مَنايا","سَوفَ تُقضى وَيَحضُرُ الغُرَماءُ",203,"م",3,0],["وَالبَهارُ الشَميمُ تَحميهِ مِن وَط","ءِ مُعاديكَ أَرنَبٌ شَمّاءُ",203,"م",3,0],["وَالبَختُ في الأولى أَنالَ العُلى","وَلَيسَ في آخِرَةٍ بَختُ",204,"ت",1,0],["وَالبَرايا لَفظُ الزَمانِ وَلابُدَّ","لَهُ مِن تَغَيُّرٍ وَاِنقِلابِ",205,"ب",1,0],["وَالبَدرُ يَكمُلُ وَالمَحاقُ مَآلُهُ","وَكَذا الأَهِلَّةُ عُقبُها الإِبدارُ",206,"ر",1,0],["وَالباءُ مِثلُ الباءِ تَخ","فِضُ لِلدَناءَةِ أَو تَجُرُّ",207,"ر",1,0],["وَالبَدرُ بَعدَ الكَمالِ مُمتَحِقٌ","فَفيمَ يا قَومُ تُجمَعُ البِدَرُ",208,"ر",1,0],["وَالبَهمُ يُربَقُ وَالأَنامُ بَهائِمٌ","أَبَداً تُقَيَّدُ بِالقَضاءِ وَتُربَقُ",209,"ق",1,0],["وَالبَدرُ أَنضَتهُ الغَياهِبُ وَالسَرى","فَليَرضَ إِن يُنَضَّ الفَنيقُ البازِلُ",210,"ل",1,0],["وَالبَرُّ يَلتَمِسُ الحَلالَ وَلَم أَجِد","هَذا الوَرى إِلّا فَقيداً حِلُّهُ",211,"ل",2,0],["وَالبُردُ يَكفيكَ العُيونَ دَريسُهُ","وَالعُضوُ يَنفَعُ في الخُطوبِ أَشَلُّهُ",211,"ل",2,0],["وَالبَيتُ أَولى بِالكَري","مِ مِنَ الطَريقِ وَإِن تَجَمَّل",212,"ل",1,0],["وَالبَغيُ أَشرانا فَأَلفَيتَنا","وَكُلُّنا يوجَدُ أَشرانا",213,"ن",2,0],["والبِيضُ في إِثرِهم والسُّمرُ","والقَتْلُ ماضٍ فيهمُ والأَسْرُ",214,"ر",1,0],["وألبسني ثوبَ الغنى بعد فاقةٍ","فأنضرَ عودي بعدَ إذْ هو ذابلُ",215,"ل",1,0],["وَأَلبَسَني النُّهى ثَوباً جَديداً","وجَرَّدَني مِنَ الثَّوْبِ المُعارِ",216,"ر",1,0],["وَالبَعض يزعم أن جملة أَرضه","حملت عَلى ثور له قرنان",217,"ن",1,0],["وَالبعض منه كَما في الراد يوم يَرى","يَنحل من نَفسه فيها وَيَنتَثر",218,"ر",1,0],["والبدرُ نَقَّبهُ الغمامُ كأنه","وجهٌ تألَّقَ من وراءِ نصيفِ",219,"ف",1,0],["والبحرُ من حولها أغاني","والسُّحْبُ والريحُ والجبالُ",220,"ل",1,0],["والبروناتُ غادةٌ","لبسَتْ حُلَّةَ السهَرْ",221,"ر",1,0],["والبَدرُ قد مَدَّ عِمادَ نُورِه","والليلُ مِثلُ الأدْهَمِ المُقَفَّزِ",222,"ز",1,0],["والبَدرُ يحْتَثُّ نحوَ الغَرْبِ أينُقَه","فكلّما خافَ من شمسِ الضّحى ركَضَا",223,"ض",2,0],["وَالبِرُّ عِندَكَ ذِمَّةٌ وَفَريضَةٌ","لا مِنَّةٌ مَمنونَةٌ وَجَباءُ",224,"ا",2,0],["والبيتُ إنْ نَقصتَ منهُ شطرهُ","فذلكَ المَشطورُ فافهمْ أَمرهُ",225,"ه",1,0],["والبيض محنية الأضلاع من قدم","على الطلا وقدود السمر منتظره",226,"ر",2,0],["وَالْبَاسِقَاتُ الْحَامِلاتُ كَأَنَّهَا","عُمُدٌ مُشَعَّبَةُ الذُّرَا وَمَنَارُ",227,"ر",1,0],["وَالبَدْرُ فِي الغَيْمِ يَخْفَى","آناً وَآناً يثُورُ",228,"ر",1,0],["وَالْبَحْرُ مَا أَسْنَاهُ فِي صَفوٍ وَمَا","أَبْهَاهُ فِي الإِرْغَاءِ وَالإِزْبَادِ",229,"د",1,0],["وَالْبَسَاتِينُ مِنْ جَنَا","هَا الأَفَانِينُ تُهْتَدَبْ",230,"ب",1,0],["وَالبَرْقَ سَخَّرَتِ العُقُو","لُ قُوَاهُ مُسْكِتَةً رُعُودَهْ",231,"د",2,0],["والبَيانُ الرِقيقُ تَبْدُو المَعَانِي","باهِرَاتٍ فِي ثَوْبِهِ الشَّفَّافِ",232,"ف",1,0],["وَالْبَثْ وَحِيداً بَيْنَ قَوْمِكَ ظَاهِراً","بِمَحَامِدَ مَشْهُورَةٍ وَمَنَاقِبِ",233,"ب",1,0],["وَالْبَرَايَا فِي هِدْأَةِ الظُّلُمَاتِ","خَاشِعَاتٌ رَجَاءَ أَمْرٍ آتِ",234,"ت",1,0],["وألبستها صباغَ اخلدِ ريشتهُ","فافتر عن ألف لون في ذراريها",235,"ي",3,0],["وَالبَربَر اِختارَت عَلى عُربِها","وَسَوفَ تَهوى الروم وَالقِبطا",236,"ط",2,0],["وَالبَدرُ في أُفقِ السَماءِ كَدِرهَمٍ","مُلقىً عَلى ديباجَةٍ زَرقاءِ",237,"ا",2,0],["والْبَسِي مِنْ عَفَاف نَفْسِكِ ثوْباً","كلُّ ثَوْب سِوَاه يَفْنَى ويَبْلَى",238,"ل",2,0],["والبشاشات أينَ مِنِّي سناها","والأفاكيهُ مِنْ هُناك وهنا",239,"ن",2,0],["والبشرُ أين البِشْرُ وَيْحي له","يا رحمةَ اللّه على بِشْرِهِ",240,"ر",2,0],["وألبسها من نهضةِ الغربِ حُلَّةً","وكم زانتِ الغيدَ الملاحَ ثياب",241,"ب",1,0],["والبِشْرُ قد ملأ الوُجوهَ نَضارةً","فتكادُ من فَرْطِ النَّضارةِ تَقْطُر",242,"ر",1,0],["والبحرُ تُبْصِرُ جُزْءَا حَوْلَ ساحِلِهِ","ولَيْسَ في دَرْكِهِ طَوْقٌ لإِنسان",243,"ن",1,0],["وَالْبَحْرُ يَدْنُو وَيَعْلُو","تَطَلُّعاً وَارْتِقابَا",244,"ب",2,0],["وألبسَها وَشياً يَزُرُّ جيوبَه","على النَّحْرِ منها والذُّيولَ على الخَصرِ",245,"ر",1,0],["والبطولات على غربتها","في مغانينا جياع خشع",246,"ع",1,0],["والبرق نار الشنان","يا معملاً بالقيعان",247,"ن",1,0],["والبدر لاح كغُرَّة الْ","محبوب أخطأه الرقيب",248,"ب",1,0],["والبَطَّ يسبَحُ شارعًا أعناقه","كزوارقٍ خضراءَ ذاتِ سَوار",249,"ر",1,0],["والبحر لا ضائق، أو شاعرٌ بهما","لكنه ناظرٌ في ثغر مبتسم",250,"م",1,0],["وألبست سيمى المجد في المهد ناشئا","وسدت وما شدت عليك المآزر",251,"ر",1,0],["والبدر يكسِفُ جِرم الشمس عادتُهُ","هذا الخسوفُ الذي كنْتَ أرتقِبُ",252,"ب",1,0],["والباب ، يلغظ ، بالوعيد","وينتفي ، أعمق الرّواجف",253,"ف",1,0],["والباب يلثغ ، باللقاء وينطوي","في صمته ، يتحرّق استجداء",254,"ا",2,0],["والبِخاسِ الَّذي أُضِيفَ إلَى النَّ","فقة ِ والبخس من يدِ الوَزَّانِ",255,"ن",1,0],["والبر سابعها والشكر ثامنها","والصبر تاسعها واللين باقيها",256,"ي",3,0],["والبدرُ حتى البدرُ يُوحشه","في يومِ محنتهِ ويُفرده",257,"د",2,0],["والباذلينَ عن الكرامة- أُرخصَتْ -","أغلَى المُهورِ ، وأفدحَ الأسعار",258,"ر",1,0],["والبدرُ بالأنوارِ يملأُ دجلةً","زَهْواً ويبعثُ في النفوسِ خُشوعا",259,"ع",2,0],["والباعثاتُ من العواطف خيرَها","إيناسةً . وأرقَّها أحزانا",260,"ن",2,0],["وألبسكُنَّ جَمالَ الغديرِ","مَن صافَ منكنَّ أو مَن شتا",261,"ا",1,0],["والبيوتُ المُبَعْثراتُ \" نَثارُ \"","العُرس مبثوثةً بدونِ حساب",262,"ب",1,0],["وأُلْبِسْتِ من جَورٍ وهضمٍ ملابساً","أخو العزِّ عنها وهو عريانُ يرغب",263,"ب",1,0],["والبَذْلُ يُبذَلُ مِن وَجْهِ الكَريمِ، وَقَد","يَصْخَى النّدَى، وَهوَ للحرّ الكريمِ رِدى",264,"د",2,0],["وَالبَحْرُ، لَوْلا أنْ تُسَيَّرَ سُفْتُهُ","وَالرّيحَ، ما برِحَتْ عَلَيْهِ رَوَاكِدَا",265,"د",2,0],["والبساتين ، والبلابل فيها","تتغنّى، حزينة لرواحك",266,"ك",1,0],["والبس مطارف حاكتها براعته","تبقى عليك ويبلى الخزّ والقصب",267,"ب",1,0],["والبختُ في الأولى أنالَ العلا،","وليسَ في آخرةٍ بَخت",268,"ت",1,0],["والباطني منها وسا","وسُ من هُموم كالخصوم",269,"م",1,0],["والبردُ، بينَ الحلتينِ، بهِ","تجننُّ ممنْ طافَ، أو نظرا",270,"ر",2,0],["والبيتُ أنتِ الصوتُ في","ه، وهْوَ للصَّوتِ صَ",271,"ص",1,0]]}