{"poems":[[73,"لا تعرضن لضيق المقل","https://www.aldiwan.net/poem4018.html","أحذ الكامل"],[95,"قضيت عمري لا مستديناً","https://www.aldiwan.net/poem9843.html","مخلع البسيط"],[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[53,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[16,"دافعت عنه بشعري","https://www.aldiwan.net/poem27692.html","الرجز"],[93,"يا ليتما خلق الزمان أصيلا","https://www.aldiwan.net/poem62669.html","عموديه"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[87,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147513","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202552","الرجز"],[92,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[47,"نبر على تباعدنا فنجفا","https://www.poetsgate.com/ViewPoem.aspx?id=31547",""],[276,"هم الأحبة إن جاروا وإن عدلوا","https://www.aldiwan.net/poem52090.html","البسيط"],[276,"أنسمة طيب أم صبا طيبة هبا","https://www.aldiwan.net/poem52104.html","الطويل"],[354,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[370,"لمن طلل بتيمات فجند","https://www.aldiwan.net/poem44517.html","الوافر"],[371,"لا أتضع إليه","https://www.aldiwan.net/poem17949.html","البسيط"],[411,"أتاني اليوم من كافي الكفاة","https://www.aldiwan.net/poem50040.html","الوافر"],[422,"هنيت مولانا المشير بابنه","https://www.aldiwan.net/poem53850.html","الرجز"],[447,"الرزء أعظم أن تراق دموع","https://www.aldiwan.net/poem14460.html","الكامل"],[463,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[469,"ورياضِ محنية دفنت بها الأسى","https://www.aldiwan.net/poem3381.html","عموديه"],[505,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[519,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[558,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122732","الوافر"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137629",""],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126155","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130625","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144155","الرجز"],[1455,"","https://poetry.dctabudhabi.ae/diwan/poem/198840",""],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35775","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80000","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79861","الكامل"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101703","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93699","البسيط"],[2449,"","https://poetry.dctabudhabi.ae/diwan/poem/115405","البسيط"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106975","الكامل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45698","السريع"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82964","الرجز"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93426","الكامل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93451","السريع"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146316","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100293","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100236","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58263","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58364","البسيط"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102185","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204855","المتقارب"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74180","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138600",""],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69936","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86372","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119650","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73189","الكامل"],[4927,"يا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=12986",""],[5725,"واذا الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=181554",""],[5845,"أنسمة ُ طيبٍ أمْ صبا طيبة ً هبا","https://www.poetsgate.com/ViewPoem.aspx?id=198483",""],[4442,"ما بال جفنك لا يدر","https://www.poetsgate.com/ViewPoem.aspx?id=171226",""],[6093,"تكافؤُ نَسَبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=198803",""]],"verses":[["فَكَأَنَّ في أَغصانِها سَحَراً","ثاني الثَقيلِ وَمُطلَقَ الرَمَلِ",0,"ل",1,0],["فكان فقدانه علينا","في كل أحوالنا غبينا",1,"ن",2,0],["فكأنَّ في الأحشاء ني","راناً يضرِّمهنَّ كيرُ",2,"ر",1,0],["فكان في ظعنكم لها شغل","على كل ما محَّ من روانقها",3,"ق",3,0],["فَكانَ فيهِ ما أَتاكَ وَفي","تِسعينَ أَسرى مُقرَنينَ صَفَد",4,"د",1,0],["فَكَأَنَّ في ذاكَ الوِشاحِ مُتَيَّماً","وَكَأَنَّ في ذاكَ الإِزارِ عَذولا",5,"ل",2,0],["فَكانَ في هَوج الخُطوبِ صَخرَةً","وَفي طَريق السَيلِ شَمّاءَ الرُبا",6,"ا",1,0],["فَكانَ في تَقديمه الإِصلاحُ","وَفي بَنيهِ الخَيرُ وَالفَلاحُ",7,"ح",1,0],["فكانَ في آخرِ هذا العامِ","بعد خُضوعِ الكُفرِ للإِسلامِ",8,"م",1,0],["فكأنَّ في الليل البهيم تبسطوا","خفراً وفي الصبح المنير تقبضوا",9,"ض",3,0],["فكان في السماوة الرئبالا","لا تذكر الألب وأنِّيبالا",10,"ل",2,0],["فكان في هوج الخطوب صخرةً","وفي طريق السيل شمّاء الرّبى",11,"ا",1,0],["فكأن فيها الصُلْبَ منغلقاً","بجراحه ، والصدرَ منخرقا",12,"ق",2,0],["فكأن فيك من خلق لئيم","تكرم أو تعاطاه الكلاب",13,"ب",1,0],["فَكانَ في الكَون لا شكل يقاس به","وَلا عَلى مثله الاقطار تشتمل",14,"ل",1,0],["فَكانَ فنا الطاغين في كل بلدة","وَمنتجع الراجين في السنة الشهبا",15,"ب",2,0],["فَكانَ في أَفعالِهِ كَقاتِلٍ","أَصبَحَ يَبكي رَحمَةً لِمَن قَتَل",16,"ل",1,0],["فكان فداؤُهُ ألفَي بعيرٍ","وألفاً من طريفاتٍ وتُلدِ",17,"د",1,0],["فَكانَ في إِخفاءِ أَسراري","كَمَن دَبَّ يَستَخفي وَفي الحَليِ جُلجُلُ",18,"ل",1,0],["فكانَ فُراتَ آمالٍ ظمِاءٍ","وكانَ حياةَ أحوالٍ رُفاتِ",19,"ت",1,0],["فكان في ميلاده مَسَرَّةً","لسابق من الهنا ولاحق",20,"ق",1,0],["فكأن في كفيه عشر سحائب","من كل واحدة جرى ينبوع",21,"ع",1,0],["فكان في مهده وقارا","كأنه في الوسادتين",22,"ن",1,0],["فكأنَّ فارس بهمةٍ سيم الوغى","ركزَ القناةَ بها وألقى زغفهُ",23,"ف",2,0],["فكأَنَّ فيك خِزانَةً لجميعِها","ولها صَحائفُ ضِمنَها قُرَّاءُ",24,"ا",2,0],["فكان في الحِلم كالمرآة حين يُرى","يُعَدّ فرداً وما فيها من الصّورِ",25,"ر",1,0],["فَكانَ فارِطَ قَومٍ حانَ مَكرَعُهُم","بِأَرضِ زاذانَ شَتّى في المَواريدِ",26,"د",1,0],["فكان فيهم آمرا وناهيا","وواعظا ومنذرا وداعيا",27,"ي",2,0],["فكان في ذلك بعض العيث","والنقص في ظاهرهم والريث",27,"ث",1,0],["فكان فيما زعمت حميرا","لا جوزيت عن الوصي خيرا",27,"ر",2,0],["فكان فيما قال في ولايته","كواحد منهم على حكايته",27,"ه",1,0],["فكان فيما تزعمون قائلا","تكلفا منه مقالا باطلا",27,"ل",2,0],["فكان في تغييره للسنة","أعظم جرما قيل فيما ظنه",27,"ه",1,0],["فكان في الواجب أن تستفهموا","وليكم عن علم ما لم تعلموا",27,"م",3,0],["فكان في رفْعي له كملْكِي","وكان من لثمي له كخِلِّي",28,"ل",2,0],["فَكانَ فِرارُهُم أَبقَى وَأوفَى","وَأنفَعَ لِلنُّفُوسِ مِنَ القِتالِ",29,"ل",1,0],["فكان فراغ تلاه انكماس","فأحدث ذاك البلاء المحيق",30,"ق",1,0],["فَكانَ في سَلا مَقامي قَدرا","مِنَ الزَّمانِ لا يَبت القَصرا",31,"ر",2,0],["فَكانَ في حلولِها فَوائِد","وَبَهجَة وَفرجةٌ لِلرائِد",31,"د",1,0],["فَكانَ فيهِ مُدّة المَسير","ثَلاث لَيلات عَلى تَيسيرِ",31,"ر",1,0],["فكان فيما رامه ميسونا","إذا آثرت على الرفيع الدونا",32,"ن",2,0],["فكأن في طرف السنان لمسرهم","سرا بغير قلوبهم لم يكتم",33,"م",1,0],["فكان في بحر الخطوب عائما","لا يختشي كالدرّ لا يخشى الغرق",34,"ق",1,1],["فكان في الإخوان من","لم أره في العوّد",35,"د",1,0],["فَكَأَنَّ فارَ المِسكِ يَفتِقُ ريحهُ","في رَوضِكَ الغَدَواتُ وَالآصالُ",36,"ل",1,0],["فكان فيها كهلال فطرِها","وكلُّ يومٍ مرَّ من أعيادها",37,"د",3,0],["فكأَنَّ في أجفانِهنَّ الطلَّ من","أنوار وجهكِ أدمعٌ تترقرق",38,"ق",1,0],["فَكَأَنَّ فاها حينَ صُفِّيَ طَعمُهُ","وَاللَهِ أَو أَشهى إِلَيَّ وَأَطيَبُ",39,"ب",1,0],["فكأن في طي الشمال إذا انثنى","من نشرها طرباً شمول الكاس",40,"س",1,0],["فَكانَ في رَجل ما لَيسَ في رَجُلِ","بِقسمة لَكَ فيها غَير ما هوَ لي",41,"ي",1,0],["فكان فضلي فيها إنني تبع","لما سننت من الأنعام والنعم",42,"م",1,0],["فكأن فيها العديات جآذر","نختال من مرح على تلعاتها",43,"ت",3,0],["فَكانَ فيما أَنشَدَت إِذ شَدَت","مَن لي مِن بَعدكظ يا فاطمه",44,"م",2,0],["فكانَ في سؤالِهِ","جوابُه عما سَأَل",45,"ل",1,0],["فَكَأَنَّ في فيه المَلاهي حُرِّكَت","لَكَ في خَفيفٍ تارَةً وَثَقيلِ",46,"ل",1,0],["فَكانَ في تَحليلِ أَزرارِهِ","أَقودَ لي مِن أَلفِ شَيطان",47,"ن",1,0],["فكان فوك اليدَ البيضاء جآء بها","موسى، وجفناك هاروتاً وماروتا",48,"ت",2,0],["فكأن فارة تاجر","سقطت به من كف تاجر",49,"ر",1,0],["فكأن في الكاسات ما في عينها","وكأن ما في العين في كاساتها",50,"ت",3,0],["فكانَ فريداً في الزَّمان مقدَّماً","عَلَيْهم وكلٌّ بالنتيجة بالي",51,"ل",2,1],["فَكانَ في منزلِي أَضعافُ ما ابتهلوا","منَ الدُّعاءِ لَكُم منْ سَب أسلافي",52,"ف",2,0],["فكان فرداً به في الخلق يحسبه","العصر الحديث أزدهى بالحسن للناس",53,"س",1,0],["فكان فطوري به مصبحاً","وكان به السكر لي والجذل",54,"ل",1,0],["فَكانَ في بَركات الشَيخ مُغتبطاً","وَقَد أَقامَ عَلى مِنهاجه وَجَرى",55,"ر",2,0],["فكان في الموت اداراك لغايته","وفي البقا عائق عما له انتهجا",56,"ج",2,0],["فَكَأنَّ في فيكَ النَقيّ مهنَّداً","يُفري بَحَدَّيهِ نيوب نوائبا",57,"ب",2,0],["فكأن في برديه ملكاً ظافراً","جذلان أبدى زهوه وأعادا",58,"د",2,0],["فكان في الحكم كالمرآة حين تُرى","تُعدّ فرداً وفيها الشكل والصّور",59,"ر",1,0],["فكأنَّ في فيهِ مسيحاً ثانياً","وكأنَّ في جفنيه عزرائيلا",60,"ل",2,0],["فَكَأَنَّ فِي الأَنْبَاْرِ عُرْسُ عُرُوْبَةٍ","عَرَبِيَّةٍ فِيْهَا الْعَرِيْسُ الضَّاْدُ",61,"د",1,0],["فكأن في اذنيه وقر من هوى","الهاه عن جرح دفين يصدح",62,"ح",1,0],["فكانَ فتى الطاغينَ في كلِّ بلدة ٍ","ومنتجعَ الراجينَ في السنة ِ الشهبا",63,"ب",2,0],["فكأن فاجعة الطوف","على خيالك لا عر",64,"ر",1,0],["فكأن في دمهِم ملائكة","ولكلِّ غَاوٍ في السِّوَى سُكْنَى",65,"ن",2,0]]}