{"poems":[[79,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[53,"الدين والعلم والنعماء والشرف","https://www.aldiwan.net/poem65471.html","البسيط"],[45,"لا الحلم جاد به ولا بمثاله","https://www.aldiwan.net/poem9931.html","الكامل"],[82,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[82,"أي نعيم في الصبا والمقترح","https://www.aldiwan.net/poem31521.html","الرجز"],[54,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[54,"ولقد غدوت على طمر","https://www.aldiwan.net/poem27191.html","مجزوء الكامل"],[50,"وفتية كمصابيح الدجى غرر","https://www.aldiwan.net/poem62458.html","البسيط"],[50,"يا ليلة طاب لي بها الأرق","https://www.aldiwan.net/poem64420.html","المنسرح"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[79,"أبدى لِداعي الفوزِ وجْهَ مُنيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33318",""],[141,"يا سلم كنت كجنة قد أطمعت","https://www.aldiwan.net/poem67977.html","الطويل"],[275,"ما كان أظرف من نظرت إليه","https://www.aldiwan.net/poem35286.html","الكامل"],[280,"بشراي هذا مبدأ الإقبال","https://www.aldiwan.net/poem25535.html","الكامل"],[376,"لا تستطل بالذي تأتي به السحب","https://www.aldiwan.net/poem57528.html","البسيط"],[438,"إن بلغتك العيس نجدا","https://www.aldiwan.net/poem12590.html","مجزوء الكامل"],[447,"متى بنا العيس ينكحن السماليقا","https://www.aldiwan.net/poem14318.html","البسيط"],[563,"من أين للسعد ما ندري وللرازي","https://www.aldiwan.net/poem34456.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83310","المنسرح"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66703","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86588","الكامل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44612","الرجز"],[1178,"","https://poetry.dctabudhabi.ae/diwan/poem/31473","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64739","البسيط"],[1274,"","https://poetry.dctabudhabi.ae/diwan/poem/99858","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109123","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77986","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27507","السريع"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126192","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93530","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203028",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135215","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136564",""],[4767,"المجلس البلدي","https://www.poetsgate.com/ViewPoem.aspx?id=180912",""],[5512,"يا دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=205119",""],[5542,"مشاهد من يوم القيامة","https://www.poetsgate.com/ViewPoem.aspx?id=10202",""],[5957,"ما أعذب الحب وما أنبله","https://www.poetsgate.com/ViewPoem.aspx?id=180733",""]],"verses":[["حَتَّى إِذَا فَرَضَ الْجَلادُ جدَالَهَا","وَرَأيْتَ رِيحَ النَّصْرِ ذَاتَ هُبُوبِ",0,"ب",1,0],["حَتّى إِذا فيقَةٌ في ضَرعِها اِجتَمَعَت","جاءَت لِتُرضِعَ شِقِّ النَفسِ لَو رَضَعا",1,"ع",2,0],["حتى إذا فتح الله الفتوح له","أصبحت لولا استتاري كدت أختطف",2,"ف",1,0],["حَتّى إِذا فَنِيَ التُراثُ سِوى العُلا","قَصَدَ العُداةَ مِنَ القَنا بِطِوالِهِ",3,"ل",2,0],["حتى إذا فُجِعَتْ بها أشْباحُها","بَقِيَتْ لِفَقدِ حَياتِها كَجمادِ",4,"د",1,0],["حتى إذا فكّرَ عَنْ بَصيرَةٍ","ذمّ من الأفعالِ ما كان مَدَح",5,"ح",1,0],["حَتّى إِذا فُرِشَت نِما","طُ النورِ فيهِ وَزُخرِفا",6,"ف",2,0],["حَتّى إِذا فَرَشَ الضِيا","ءُ لِأَعيُني فَرَشاتِ",7,"ت",1,0],["حَتّى إِذا فَلَكُ الأَوتارِ دارَ بِنا","مَعَ الطُبولِ ظَلَلنا كَالسَبابيتِ",8,"ت",1,0],["حَتّى إِذا في الحِياضِ صَيَّرَها","خالَطَها الزَعفَرانُ وَالعَلَقُ",9,"ق",1,0],["حتَّى إذا فَوَّزَ في العَدوِّ","جنَّبهُ الرحمنُ كُلَّ سَوِّ",10,"و",1,0],["حَتّى إِذا فُتِحَت لَهُم أَطرافُها","لَم يُطغِهِم تَرَفٌ وَلا نَعماءُ",11,"ا",2,0],["حَتَّى إِذَا فَتَرَتْ وَحَطَّ بِهَا الْوَنَى","سَقَطَتْ فَلَيْسَ لِنَفْسِهَا أَرْمَاقُ",12,"ق",1,0],["حَتَّى إِذَا فَعَلَ الدُّوَارُ بِرَأْسِهِ","فِعْلَ الطِّلاَ دَارَتْ بِرَأْسِ الشَّارِب",13,"ب",1,0],["حتى إذا فرضَ الجلادُ جدالَهُ","ورأيت ريحَ النَّصر ذاتَ هُبوب",14,"ب",1,0],["حَتّى إِذا فَسَحَ الرَبيعُ ظُنونَهُم","نَثَرَ الخَريفُ ثِمارَها فَتَصَدَّعوا",15,"ع",3,0],["حتى إذا فرَغت وهمَّ بغَيرها","أبصَرتُ ما في الكأسِ في عَينَيه",16,"ي",2,0],["حَتَّى إذَا فَارَقْتُ أرْضَهُمُ التِي","كانَتْ عِقالاً ثانِياً لِعِقَالِي",17,"ل",2,0],["حتى إذا فاضت الجردُ الصواهل والس","سُمرُ الذوابل والهِنديةُ القضبُ",18,"ب",1,0],["حتى إذا فوّقْتَ منْ","هُ بمسقَطِ الأنداءِ بُرْدا",19,"د",2,0],["حتى إذا فلق الإصباح فالقها","والعيس فلقت البيداء تفليقا",20,"ق",2,0],["حتى إذا فهموا أقوال من سلفوا","وحرروها بتطويل وإيجاز",21,"ز",1,0],["حتى إذا فرغت من جميعهم","رجعت في الشيعة مع فروعهم",22,"م",1,0],["حتى إذا فرّ به قراره","وأمنت من بعد خوف داره",22,"ه",1,0],["حَتّى إِذا فاضَ مِن هُناكَ غَدَت","أَرضَ البَطيحاءِ مِنهُ تَزدَهِرُ",23,"ر",1,0],["حتى إذا فرغَ الخطيبُ تَتابعت","طُوبى تَساقطُ لؤلؤاً منثورا",24,"ر",2,0],["حَتّى إِذا فَرِحوا بِما أُوتوا ضَحىً","أُخِذوا بِلَيلٍ حالك الظَلماء",25,"ا",2,0],["حَتّى إِذا فَرَغتَ مِنها مُتقِنا","وَلَم يَرَ العائِبُ فيها مَطعَنا",26,"ن",2,0],["حَتّى إِذا فَقَدَ الصَبو","حَ يَقولُ عَيشٌ ذو عَقارِب",27,"ب",1,0],["حتى إذا فقدَ الرأْيَ السَّديدَ بهِ","وعادَ مِنه سبيلُ الرُّشدِ مَسْدودا",28,"د",2,0],["حتى إذا فتر اللسان وأصبحت","للموت قد ذبلت ذبول النرجس",29,"س",1,1],["حتى إذا فقد القوى اتخذ الفراش","من الثرى ومن السماءِ غطاه",30,"ا",2,0],["حتى إذا فهم الخطاب دعوته","يا عبد كن لي حاضراً ومجالسا",31,"س",2,0],["حتى إذا فزَّع عن قلبهم","فقيل ماذا قيل قالوا الأحد",32,"د",1,0],["حتى إذا فَرِحوا بما هُم","أوتُوه بغتَةَ أخذنا ما هُم",33,"م",1,0],["حَتّى إِذا فَتح المظفر أَدهَم","وَرَأَت جُيوش الشرك ما قَد نابَها",34,"ب",3,0],["حتى إذا فيها هويت","أراه يضحك من عل",35,"ل",1,0],["حتى إذا فرحوا بما أوتوا أخذوا","فأصبحوا لا ترى إلا مساكنهم",36,"م",1,0],["حتى إذا في قومه حل وقف","مستشرفاً يطلب آياس وخف",37,"ف",1,0],["حتى إذا فتكت نواظرهُ","جرحَ الفؤاد وخانني الصَبر",38,"ر",1,0],["حتى إذا فتحت لنا أبوابه","ألفيتَ ما نرجوه منه قد اضمحل",39,"ل",1,0],["حتَّى إذا فاقكِ الأعداءُ في عددٍ","كمثلِ بدرٍ ، جنودٌ من سما تثبُ",40,"ب",1,0],["حتى إذا فرغ الحساب وأنصفت","من بعضها نزل القضاء الأمثل",41,"ل",1,0],["حتى إذا في قربهِ ذلنا","فما نراعي، نشتهي منهلهْ",42,"ل",2,0]]}