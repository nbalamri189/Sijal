{"poems":[[57,"ألم تعلمي يا فوز أني معذب","https://www.aldiwan.net/poem26544.html","الطويل"],[79,"من كان في الحكم له نائب","https://www.aldiwan.net/poem36732.html","السريع"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[39,"ولى يهز قناتي غير مختشيء","https://www.aldiwan.net/poem7335.html","البسيط"],[53,"قالوا ابن يوسف مستوه فقلت لهم","https://www.aldiwan.net/poem8509.html","البسيط"],[53,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[40,"طاف الخيال بأصحابي وقد هجدوا","https://www.aldiwan.net/poem7701.html","البسيط"],[82,"الآن أفرخ روع كل مهيد","https://www.aldiwan.net/poem31473.html","الكامل"],[46,"منحتك ودا كان طفلا فقد نشا","https://www.aldiwan.net/poem30227.html","الطويل"],[107,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[79,"من كان في الحُكْم له نائبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=33273",""],[92,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[47,"ألم تعلمي يا علو أني معذب","https://www.poetsgate.com/ViewPoem.aspx?id=31414",""],[139,"غيري إذا أغبر وجه الدهر يحذره","https://www.aldiwan.net/poem49094.html","البسيط"],[147,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[147,"ما مرتقاك على من رامه أمم","https://www.aldiwan.net/poem11824.html","البسيط"],[193,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[333,"على دارك يا جاري","https://www.aldiwan.net/poem54945.html","الهزج"],[353,"ولئيم جئته في حاجة","https://www.aldiwan.net/poem20118.html","الرمل"],[422,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[463,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[469,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[543,"فتحت في روضها زهرة","https://www.aldiwan.net/poem47421.html","عموديه"],[567,"طيف بلبنان من مصر إلي سرى","https://www.aldiwan.net/poem52958.html","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87213","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77608","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96632","الرمل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64474","الطويل"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101914","الخفيف"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132231","الوافر"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28560","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106912","الرمل"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124715","الخفيف"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136993",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100311","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204965","الخفيف"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26114","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138454",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108373",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59453","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59441","الرجز"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59506","المتقارب"],[3884,"","https://poetry.dctabudhabi.ae/diwan/poem/142883","البسيط"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138733",""],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117249","المديد"],[4446,"","https://poetry.dctabudhabi.ae/diwan/poem/139094","البسيط"],[4781,"بمولانا الإمام أبي تميم","https://www.poetsgate.com/ViewPoem.aspx?id=107189",""],[4830,"كأسُ الصِّبا","https://www.poetsgate.com/ViewPoem.aspx?id=201652",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5213,"رب دار دخلتها غدوة اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=170555",""],[5616,"وثن","https://www.poetsgate.com/ViewPoem.aspx?id=203456",""],[5894,"كل الحواسد راعوا ما أنا فيه","https://www.poetsgate.com/ViewPoem.aspx?id=131407",""],[6031,"يا نَسيمَ الشَمالِ أدِّ رِسَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46264",""]],"verses":[["وَلي يَومَ شَيَّعتُ الجِنازَةَ قِصَّةٌ","غَداةَ بَدا البَدرُ الَّذي كانَ يُحجَبُ",0,"ب",1,0],["وَلَّى يَداً خَائِنَةً أَمْرَهُ","فَأَصْبَحَتْ صَفْقَتُهُ خَائِبَهْ",1,"ه",1,0],["وَلّى يَهُزُّ اِنهزِاماً وَسطَها زَعِلا","جَذلانَ قَد أَفرَخَت عَن رَوعِهِ الكُرَبُ",2,"ب",1,0],["ولَّى يهز قناتي غير مختشيء","من وحدة طلل يأدو له طللُ",3,"ل",1,1],["ولي ينفع إلّا وهو منبطحٌ","تحت الغواة لِحُرِّ الوجهِ مكبوبُ",4,"ب",1,0],["ولَّى يرى الأرضَ العري","ضةَ ماله فيها محلُّ",5,"ل",1,0],["وَلّى يَشُقُّ جِمادَ الفَردِ مُطَّلِعاً","بِذي النِعاجِ وَأَعلى رَوقِهِ جَسِدُ",6,"د",1,0],["وَلَّى يُحاكي البرقَ لَمعُ مُجَرَّدٍ","والرَّعدَ في حَذَرٍ تحَمْحُمُ أجرَدِ",7,"د",1,0],["وَلي يا خَلِيَّ الصَدرِ مِن لَوعَةِ الهَوى","حَشاً لَستُ أَدري جَمرَةٌ هِيَ أَم حَشا",8,"ش",2,0],["ولَّى يَسوقُ السَّرْحَ لو لم تُولِهِ","سَعةً لضَاقَ به الفضاءُ الأفيحُ",9,"ح",1,0],["ولَّى يدا خائبة ً أمرُهُ","فأصبحت صفقتُه خائبه",10,"ه",1,0],["ولُيَيْلَةً بيضاءَ خالدةً","منها عرفت لذائذَ السفر",11,"ر",1,0],["ولي يوم شيعت الجنازة قصة","غداة بد البدر الذي كان يحجب",12,"ب",1,0],["ولِي يراع كصدر الرمحِ هزّتهُ","تبشر الكونَ أحياناً وتنذرهُ",13,"ر",2,0],["وَلِيَيأَسوا النَصرَ العَزيزَ فَإِنَّهُ","لَكَ دونَهُم مُذ سارَ تَحتَ لِواكا",14,"ك",2,0],["وَليَيأَسوا رَمَّةً كانَت مُؤَهَّلَةً","لِهِمَّةٍ ما اِهتَدَت في طُرقِها الهِمَمُ",15,"م",1,0],["وَلي يدٌ فيه لولا ضعفُ سامعهِ","جَعلتُ نظمَ بسيطي في مهذّبهِ",16,"ب",2,0],["ولي يا جار مثل الناس","زوج ما أحيلاها",17,"ه",2,0],["وَلَئِيمٍ جِئْتُهُ في حَاجَةٍ","فَتْأَمَّى وَتَأَبَّى وَتَمَرْدَكْ",18,"ك",1,1],["ولئيمٍ من دهره في نعيمِ","إنَّ دهراً عَدوَّ كلِّ كريم",19,"م",1,0],["ولَّى يفِرُّ ولم يعفْها سُبَّةً","تَسرِي وليس من الحِمامِ فرارُ",20,"ر",1,0],["ولي يخيبَ وان عزَّ المرام فتى","إلى أياديكَ بعد الله يتَّكل",21,"ل",1,0],["ولييلاي مضى","ربع الحول لها",22,"ه",2,0],["وَلّى يَشُقُّ أديمَ الليلِ معُتسفاً","فما عَرَفتُ لهُ عيناً ولا أثَرا",23,"ر",2,0],["وليي ولي اللَه في آل موئلي","وكل ولي عن ولاه بمعزل",24,"ل",1,0],["وَلَئيمِ طَبعٍ باطناً","وَجَميلُهُ لَكَ أَعلنَهْ",25,"ن",2,1],["وَلي يَقول لَيت لَم تجِدني","وَلَيت أُمّي قَطّ لَم تَلِدني",26,"ي",1,0],["وَلئيلاتٍ مَضت بَهجتها","وتقضّت بوصالٍ من سعادِ",27,"د",1,0],["وليِّيَ في الدنيا وفي الأخرى تولني","بما تتولى الصالحين وثبت",28,"ت",1,1],["وليي تولتني شئون من الهوى","تدارك خلاصي من هوى فيه شقوتي",28,"ت",2,0],["ولئيم قد عاش عيشا رغيداً","وكريم قد مات جوعا وفقرا",29,"ر",2,0],["ولي يا خير مقصود خطايا","عظام أو جبت ألم العقاب",30,"ب",1,0],["وَلّى يَذُمُ لَهُ قَوائِمُ سابِحٍ","جَمَحَت بِهِ الخُيَلاء وَهيَ إِباقُ",31,"ق",1,0],["ولئيماً فسدت جبلته","وتوالى بالمخازي محضره",32,"ر",2,0],["ولئيم واهي المروءة لا يف","رق بين الإسعاد والإيلامِ",33,"م",1,0],["ولئيم الناس يقتله","مجد أهل المجد والكرم",34,"م",1,0],["ولي يطير حمامة فكأنما","أتبعته بالسوازناق الباز",35,"ز",1,0],["ولئيم على عدائي مصرّ","خطرت في حجاه لحظة نبل",36,"ل",1,1],["وَلي يا بنَ المُراغَةِ مِن تَميمٍ","وَجوهُ السابِقاتِ وَلي العَديدُ",37,"د",1,0],["ولييلاتٍ لنا الدهرُ أعارا","طلن لكن بالهنا عادت قصارا",38,"ر",2,1],["ولي يومُ نجح في البلاد له نباً","وهذا له في الخافقين رنين",39,"ن",1,0],["وليَّ يشوب عسيجَةُ بوَسيجِةِ","أعتقْ بذلكَ من وسوجٍ معسج",40,"ج",1,0],["وَلي يومان منْ نعمٍ وبؤسٍ","وَلي طَعمان من أرْي وصابِ",41,"ب",1,0],["ولُيِّ يُشا يعني في الخُطوبِ","ورائي يُحاكي القضا المبرم",42,"م",1,0],["ولي يمينٌ من الأغلالِ داميةٌ","وإن بدا القيدُ فيها مثل إسوارِ",43,"ر",1,0],["وليي علي حيث كنت وليه","ومخلصه بل عبد عبد لعبده",44,"د",2,1],["ولييلاتٌ خلت ومضت","وعهود قد تقضت لنا",45,"ن",2,0],["ولي يدٌ إذ توافقني أشدُّ بها","على فؤادي وفي يمنى يديه يد",46,"د",1,0],["وليى الله إن أكُ مِنْ وَلي","ودود قد خلوت ومن حميم",47,"م",1,0],["ولّى يميناً وجهَهُ خشيةً","وقلبُهُ تفضحُهُ المُقلتانْ",48,"ن",1,0],["ولي يا شهيد اشهد بأني موحد","ودين سوى التوحيد قلبي يأباه",49,"ا",2,0],["ولئيم ما ان عرفا حديثا","من أبوه وما علمنا قديما",50,"م",2,0],["ولي يراع إذا صوّبته سقطت","كل النسور وإن أشهرته طعنا",51,"ن",2,0],["ولي يراع له الأعداء قد شهدوا","بالفضل والخالق الوهاب حاميه",52,"ي",2,0],["ولئيمٍ واهيْ المُرُوءةِ لا يَفْ","رُقُ بين الإكرامِ والإيْلامِ",53,"م",1,0]]}