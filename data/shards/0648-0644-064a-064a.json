{"poems":[[55,"ألم تعلمي يا فوز أني معذب","https://www.aldiwan.net/poem26544.html","الطويل"],[77,"من كان في الحكم له نائب","https://www.aldiwan.net/poem36732.html","السريع"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[37,"ولى يهز قناتي غير مختشيء","https://www.aldiwan.net/poem7335.html","البسيط"],[51,"قالوا ابن يوسف مستوه فقلت لهم","https://www.aldiwan.net/poem8509.html","البسيط"],[51,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[38,"طاف الخيال بأصحابي وقد هجدوا","https://www.aldiwan.net/poem7701.html","البسيط"],[80,"الآن أفرخ روع كل مهيد","https://www.aldiwan.net/poem31473.html","الكامل"],[44,"منحتك ودا كان طفلا فقد نشا","https://www.aldiwan.net/poem30227.html","الطويل"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[77,"من كان في الحُكْم له نائبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=33273",""],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[45,"ألم تعلمي يا علو أني معذب","https://www.poetsgate.com/ViewPoem.aspx?id=31414",""],[133,"غيري إذا أغبر وجه الدهر يحذره","https://www.aldiwan.net/poem49094.html","البسيط"],[141,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[141,"ما مرتقاك على من رامه أمم","https://www.aldiwan.net/poem11824.html","البسيط"],[187,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[326,"على دارك يا جاري","https://www.aldiwan.net/poem54945.html","الهزج"],[346,"ولئيم جئته في حاجة","https://www.aldiwan.net/poem20118.html","الرمل"],[413,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[462,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[536,"فتحت في روضها زهرة","https://www.aldiwan.net/poem47421.html","عموديه"],[560,"طيف بلبنان من مصر إلي سرى","https://www.aldiwan.net/poem52958.html","البسيط"]],"verses":[["وَلي يَومَ شَيَّعتُ الجِنازَةَ قِصَّةٌ","غَداةَ بَدا البَدرُ الَّذي كانَ يُحجَبُ",0,"ب",1,0],["وَلَّى يَداً خَائِنَةً أَمْرَهُ","فَأَصْبَحَتْ صَفْقَتُهُ خَائِبَهْ",1,"ه",1,0],["وَلّى يَهُزُّ اِنهزِاماً وَسطَها زَعِلا","جَذلانَ قَد أَفرَخَت عَن رَوعِهِ الكُرَبُ",2,"ب",1,0],["ولَّى يهز قناتي غير مختشيء","من وحدة طلل يأدو له طللُ",3,"ل",1,1],["ولي ينفع إلّا وهو منبطحٌ","تحت الغواة لِحُرِّ الوجهِ مكبوبُ",4,"ب",1,0],["ولَّى يرى الأرضَ العري","ضةَ ماله فيها محلُّ",5,"ل",1,0],["وَلّى يَشُقُّ جِمادَ الفَردِ مُطَّلِعاً","بِذي النِعاجِ وَأَعلى رَوقِهِ جَسِدُ",6,"د",1,0],["وَلَّى يُحاكي البرقَ لَمعُ مُجَرَّدٍ","والرَّعدَ في حَذَرٍ تحَمْحُمُ أجرَدِ",7,"د",1,0],["وَلي يا خَلِيَّ الصَدرِ مِن لَوعَةِ الهَوى","حَشاً لَستُ أَدري جَمرَةٌ هِيَ أَم حَشا",8,"ش",2,0],["ولَّى يَسوقُ السَّرْحَ لو لم تُولِهِ","سَعةً لضَاقَ به الفضاءُ الأفيحُ",9,"ح",1,0],["ولَّى يدا خائبة ً أمرُهُ","فأصبحت صفقتُه خائبه",10,"ه",1,0],["ولُيَيْلَةً بيضاءَ خالدةً","منها عرفت لذائذَ السفر",11,"ر",1,0],["ولي يوم شيعت الجنازة قصة","غداة بد البدر الذي كان يحجب",12,"ب",1,0],["ولِي يراع كصدر الرمحِ هزّتهُ","تبشر الكونَ أحياناً وتنذرهُ",13,"ر",2,0],["وَلِيَيأَسوا النَصرَ العَزيزَ فَإِنَّهُ","لَكَ دونَهُم مُذ سارَ تَحتَ لِواكا",14,"ك",2,0],["وَليَيأَسوا رَمَّةً كانَت مُؤَهَّلَةً","لِهِمَّةٍ ما اِهتَدَت في طُرقِها الهِمَمُ",15,"م",1,0],["وَلي يدٌ فيه لولا ضعفُ سامعهِ","جَعلتُ نظمَ بسيطي في مهذّبهِ",16,"ب",2,0],["ولي يا جار مثل الناس","زوج ما أحيلاها",17,"ه",2,0],["وَلَئِيمٍ جِئْتُهُ في حَاجَةٍ","فَتْأَمَّى وَتَأَبَّى وَتَمَرْدَكْ",18,"ك",1,1],["ولئيمٍ من دهره في نعيمِ","إنَّ دهراً عَدوَّ كلِّ كريم",19,"م",1,0],["ولَّى يفِرُّ ولم يعفْها سُبَّةً","تَسرِي وليس من الحِمامِ فرارُ",20,"ر",1,0],["ولي يخيبَ وان عزَّ المرام فتى","إلى أياديكَ بعد الله يتَّكل",21,"ل",1,0],["ولييلاي مضى","ربع الحول لها",22,"ه",2,0],["وَلّى يَشُقُّ أديمَ الليلِ معُتسفاً","فما عَرَفتُ لهُ عيناً ولا أثَرا",23,"ر",2,0]]}