{"poems":[[95,"هل آية في السلم والحرب","https://www.aldiwan.net/poem9789.html","عموديه"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54861","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[119,"هز منها النسيم خصراً رفيعاً","https://www.aldiwan.net/poem41758.html","الخفيف"],[147,"دم بالصيام مهنأ ما داما","https://www.aldiwan.net/poem11821.html","الكامل"],[164,"منزلتي أحمد عظمها","https://www.aldiwan.net/poem58665.html","الرجز"],[333,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[406,"خير أمة","https://www.aldiwan.net/poem10301.html","عموديه"],[408,"كيف لا أبدي شجوني وأنوح","https://www.aldiwan.net/poem46442.html","الرمل"],[408,"فيك أما في سواك فلا","https://www.aldiwan.net/poem46911.html","المديد"],[519,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[543,"به أهلا من حوار","https://www.aldiwan.net/poem47472.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86722","الرمل"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/138858",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59418","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64848","السريع"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48908","الخفيف"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132227","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125482","الرمل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102727","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77306","الخفيف"],[2395,"","https://poetry.dctabudhabi.ae/diwan/poem/101400","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201404","الرمل"],[3008,"","https://poetry.dctabudhabi.ae/diwan/poem/103179","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100860","الكامل"],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18729","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52147","الخفيف"],[4858,"يا نَصْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=29797",""],[4929,"صورة وتعليق","https://www.poetsgate.com/ViewPoem.aspx?id=199389",""],[5057,"أطفئِيْ ظمأيْ","https://www.poetsgate.com/ViewPoem.aspx?id=197541",""],[5136,"يا شمس أفق سما المجد والجود","https://www.poetsgate.com/ViewPoem.aspx?id=121560",""],[5138,"يانصيب الغير واحلام السنين","https://www.poetsgate.com/ViewPoem.aspx?id=184848",""],[5353,"المغزل","https://www.poetsgate.com/ViewPoem.aspx?id=212464",""],[333,"نشيد الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=101256",""],[5414,"صرخة من وراء الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=12936",""],[5790,"تلفت والله روحي","https://www.poetsgate.com/ViewPoem.aspx?id=111989",""]],"verses":[["يَا نُصَرَاءَ الْعِلْمِ شُكْرُ النُّهَى","لَكُمْ كَشُكْرِ الرَّوْضِ لِلسُّحُبِ",0,"ب",1,0],["يا نصيرَ الضِعاف حَرِّرْ نفوساً","تتمنَّى الفكاكَ والتَّحريرا",1,"ر",2,0],["يا نصيرَ الحقوقِ آثرتَ حقاً","كلّ نفسٍ بما قضاهُ رهينه",2,"ن",2,0],["يَا نَصِيرَ الآدَابِ تَبْكِيكَ","بَاكُورَاتُهُ الْيَوْمَ بِالدُّمُوعِ الحِرارِ",3,"ر",1,0],["يَا نَصِيرَ النِّسَاءِ وَالدِّينُ سَمْحٌ","لَوْ وَعَيْنَا السَّرِيَّ مِنْ آدَابِهْ",4,"ب",2,0],["يا نَصِيرَ العِلْمِ فِي مَمْلَكَةٍ","بَلَغَتْ بِالْعِلْمِ غاياتِ مُناها",5,"ا",3,0],["يا نصيري يا سيدي يا سراج الدي","ن يا قدوة الشيوخ جميعا",6,"ع",2,0],["يا نَصرُ إِنَّ النَصرَ خَلفَكَ ظاعِنٌ","أَنّى ظَعَنتَ وَإِن أَقَمتَ أَقاما",7,"م",2,0],["يا نصرتي أتاكم منتصفاً","لتنصفوا محبكم مهتضم",8,"م",1,0],["يا نصيري إذا دهَتني الرزايا","وأنيسي في وحدتي ونجيي",9,"ي",1,0],["يا نصيرَ الأمرِ بالمعروف، أهلاً","بكَ يا سلمانُ في نَبْع وَ(جَمَّهْ)",10,"م",2,0],["يا نَصيحي لا تَلمني في البُكَى","بانَ لِي غَشّكَ فيه يا نَصيحُ",11,"ح",1,0],["يا نصيحي أنتَ أكبر مِن","أن تقولَ الغيّ والخطلا",12,"ل",2,0],["يا نَصيري على العِداءِ وعَوْني","ومَعاذي إذا خشيتُ أذاها",13,"ا",3,0],["يا نَصيراً لِقَديمٍ","بِم تُدعى إذ اُنادي",14,"د",2,0],["يا نَصير العلم في مصر ويا","ناشر العَدل عَلى رَأس العِبادْ",15,"د",1,0],["يا نُصرةَ الملك الجبار عودي على","آل النبي بما قد فاتهم عودي",16,"د",2,0],["يا نصرة الأصحاب يا عناء عفاة","يا عمدة الأتباع يا خلاصة الأعمال",17,"ل",1,0],["يا نِصْفَ طالوت لإِيتائِهِ","في جِسْمِهِ لا عِلْمِهِ البَسْطَهْ",18,"ه",1,1],["يا نصير الحِسان حسبُك أَجرا","أَن دعتك الحسان عمَّا أَبرّا",19,"ر",2,1],["يا نصير النساء أكثرْ من الأُولى","لتلقى براحتيها التِبرا",19,"ر",2,0],["يا نصيري على الخطوب وغوثي","من ذنوبي لأرتجي برء داء",20,"ا",2,0],["يا نصير الفنِّ هيا","جُد كما جادَ الكرام",21,"م",1,0],["يا نُصرةً للمنتمينَ إليكمو","يا سادتي قصدي أنالُ رضاكمو",22,"و",1,0],["يا نَصيرَ الضَعيفِ سَدِّد سِهامي","لِقُلوبٍ مِن العِدا وَنُحورِ",23,"ر",1,0],["يا نصير الدين إذ عز النصير","وحمى الجار إذا عز المجير",24,"ر",1,0],["يا نصيبي قد دخلت اليانصيب","فالمسي نجميَ يا كف القدر",25,"ر",1,1],["يا نصر من للقاء الحرب إن لقحت","يا نصر بعدك أو للضيف والجار",26,"ر",1,0],["يا نصف اميين كيف قرأتم","ونسيتم أن تعملوا الاقلاما",27,"م",2,0],["يا نَصرَ نَصرَ بَني قُعَينٍ إِنَّما","أَنتُم إِماءٌ يَتَّبِعنَ الأَشتَرا",28,"ر",2,1],["يا نصيحي لا تُطِل قولاً سُدى","ان هذا عند سمعي في نكَر",29,"ر",1,0],["يا نصيرَا لشعوب إن الأماني","سبُلُ البائسينَ للإسعادِ",30,"د",1,0],["يا نصْرُ، قُل للعزم أن يتكلّما","عَييَ اللسانُ فلا يُجيدُ تكلّما",31,"م",2,1],["يا نصرُ، إنك في العرين مجاهدٌ","فلِواكَ يبقى في الجهادِ مقدّما",31,"م",2,0],["يا نصرةَ المظلوم ِ من ربِ السما","عُجْلَاكِ إنا في انتظاركِ..، أقدمِي*",32,"م",2,0],["يانِصفَ روحيْ دعىٰ النِّصفُ الذي كتبَت","يداهُ عنكِ : تعالَيْ يا مُكمِّلَتِيْ",33,"ت",2,0],["يا نصرة لهتوف ولا صريخ له","وعقدة للهيف القلب منجود",34,"د",1,0],["يانصيب الغير واحلام السنين","ماسواك انسان زاد القلب هم",35,"م",1,1],["يا نصفَ ميت ٍ ذاكَ نعشُكَ يرتقي","حجبَ السَّماءِ تحث ُّ فيها أرجلَكْ",36,"ك",1,0],["يا نصيري إذا دَهَتني الرزايا وأنيسي في وحدتي ونجييّ","يا حبيبا أغنى فؤادي عن كل حبيب وصاحبٍ وصفيّ",37,"ي",1,0],["يا نصيرَ المظلومً إنا ظُلمنا","وغُلبٍنا فانتصرٍ لي انتصارا»",38,"ر",2,0],["يا نصيحي ومن اللذ","ذات عصيان النصيح",39,"ح",1,0]]}