{"poems":[[91,"كنت طاغور ماثلا في خيالي","https://www.aldiwan.net/poem44752.html","الخفيف"],[33,"وغضيض الطرف مكسال الضحى","https://www.aldiwan.net/poem41298.html","الرمل"],[33,"طال ليلي وتعناني الطرب","https://www.aldiwan.net/poem42651.html","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39543","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141955","الخفيف"],[100,"خيال من دمر","https://www.poetsgate.com/ViewPoem.aspx?id=55301",""],[190,"قلت حقا وأحلف","https://www.aldiwan.net/poem43604.html","مجزوء الخفيف"],[458,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[563,"خالق الكل واحد","https://www.aldiwan.net/poem34618.html","مجزوء الخفيف"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130205","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37844","الرمل"],[925,"","https://poetry.dctabudhabi.ae/diwan/poem/144556","السريع"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202073","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109074","الخفيف"],[1509,"","https://poetry.dctabudhabi.ae/diwan/poem/73901","السريع"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108752","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130843",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202510","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204649","الخفيف"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32388","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118016","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119673","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33752","الرمل"],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[6056,"الأحلام الوردية","https://www.poetsgate.com/ViewPoem.aspx?id=130357",""]],"verses":[["قلت حاول منها بنفسك افلا","تاً فحاولته فبان كلالي",0,"ل",2,0],["قُلتُ حَقّاً ذا فَقالَت قَولَةً","أَورَثَت في القَلبِ هَمّاً وَشَجَن",1,"ن",1,0],["قُلتُ حِلّاً فَاِقبَلي مَعذِرَتي","ما كَذا يَجزي مُحِبٌّ مَن أَحَب",2,"ب",1,0],["قلتُ حسبي من الربيع شذاهُ","ولعينيَّ زهرهُ اللمَّاحُ",3,"ح",1,0],["قلتُ حبّا زَقَّ الحمامَةِ للفَرخِ","فلم لا تكون ذاك الحماما",4,"م",2,0],["قلت حباً زق الحمامة للفر","خ فلم لا نكون ذاك الحماما",5,"م",2,0],["قلتُ حقّا وأحلِف","ليس في الناس منصفُ",6,"ف",1,1],["قلت حسبي والعيد ينضح","بالمأساة لعني مغامرا كسفه",7,"ف",2,0],["قلت حقا إذا انتفى","عنك ما أنت جاحد",8,"د",1,0],["قلت حالي الذي عهدتيه ولى","ثم طوفان عصرنا قد تغلب",9,"ب",1,0],["قلت حَمدي كيف يُجدي","وهو حمْدٌ وزيادَهْ",10,"ه",1,0],["قلت حمامات على منهلٍ","شحت مناقير تسيغ الجرع",11,"ع",1,0],["قلت حسبي الذي لَقيتُ هَوانَا","فلَقِاءُ الهَواَنِ عندي يَهُول",12,"ل",1,0],["قلت حاشاك فهو كل الحلال","أنا صدَّقتها أما أنت أيضا",13,"ض",2,0],["قُلتُ حَرامٌ قَتلُ نَفسٍ بِلا","ذَنبٍ فَقالَت ذا حَلالٌ لَنا",14,"ن",2,0],["قلت حوريةٌ إذن","أنت يا غاية المنى",15,"ن",2,0],["قلت حقاً أمة أنت بها","لا أراها عند حد ترهن",16,"ن",1,0],["قلت حسبي ان شئت قبلة خدٍّ","وإذا زدتها فرشفة ثغر",17,"ر",1,0],["قلت حاذر فللبدور محاق","وترفق فللشموس كسوف",18,"ف",1,0],["قُلتُ حَدِّث عَن أُناسِ نَزَلوا","حَضَناً أَو غَيرَهُ قالَ هَلا",19,"ل",2,0],["قلت حبيبي أعف عن ذنب بدا","ولا أعود في سواه أبدا",20,"د",2,0],["قلتُ حتى ذوى من الهجر عودي","عُدتَ بالوصل سيدي قال حتى",21,"ت",2,0],["قلت حاشا اللَه أن يقضي بذا","بل قضاهُ صاحبُ الوجهِ الوَضِي",22,"ض",2,0],["قُلْتُ : حُسْنَى سَخَّرَ الأَقْ","دَارَ أَحْكَاماً وَنَذْرَا",23,"ر",2,0],["قلت حبك ( لأبن عمار ) متسيّدي","قال وحبك ، ملك قلبي ، ومتسيّده",24,"د",2,0]]}