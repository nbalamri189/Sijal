{"poems":[[95,"لعينيك من جارة جائره","https://www.aldiwan.net/poem11135.html","المتقارب"],[32,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[53,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[93,"أحب إله في صباه إلاهة","https://www.aldiwan.net/poem8744.html","عموديه"],[72,"بك اهتز عطف الدين في حلل النصر","https://www.aldiwan.net/poem42921.html","الطويل"],[63,"ألذ العيش إتيان الصبيح","https://www.aldiwan.net/poem51310.html","الوافر"],[76,"ونشوان غنته حمامة أيكة على","https://www.aldiwan.net/poem12913.html","الطويل"],[76,"تشفع بعلق للشباب خطير","https://www.aldiwan.net/poem12959.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85480","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54294","الطويل"],[102,"أصيل القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50335",""],[201,"أي وعينيك فاض كأس غرامي","https://www.aldiwan.net/poem39807.html","الخفيف"],[203,"تغيرت الدنيا فهل هي زور","https://www.aldiwan.net/poem45156.html","الطويل"],[216,"سألت المعالي والقنا والمهندا","https://www.aldiwan.net/poem37895.html","الطويل"],[237,"بدا فأراني الظبي والغصن والبدرا","https://www.aldiwan.net/poem14761.html","الطويل"],[240,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[240,"حث كؤوس الراح","https://www.aldiwan.net/poem32118.html","مجزوء الرجز"],[257,"أوجدي كذا أم هكذا كل من يهوى","https://www.aldiwan.net/poem1420.html",""],[275,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[374,"بنفسي من أغلقت كفي بحبله","https://www.aldiwan.net/poem4316.html","الطويل"],[382,"أمانا لقلب طال فيه اعتناؤه","https://www.aldiwan.net/poem66968.html","الطويل"],[385,"تباعدت عن ألفي فيا حر أشجاني","https://www.aldiwan.net/poem48777.html","الطويل"],[385,"تغيب در الزهر في صدف الأفق","https://www.aldiwan.net/poem48822.html","الطويل"],[415,"أأحبابنا خطب التفرق شاغل","https://www.aldiwan.net/poem32278.html","الطويل"],[463,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[482,"تذكر أيام الصبا فتألما","https://www.aldiwan.net/poem15241.html","الطويل"],[484,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[520,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[543,"أكتم مابي لو يدوم التكتم","https://www.aldiwan.net/poem47962.html","عموديه"],[556,"دعى منظري إن لم أكن لك رائعا","https://www.aldiwan.net/poem47780.html","الطويل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112447","الهزج"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137598",""],[905,"","https://poetry.dctabudhabi.ae/diwan/poem/146462","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59244","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64842","الوافر"],[1282,"","https://poetry.dctabudhabi.ae/diwan/poem/105278","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44875","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127984","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49585","السريع"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101070","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52112","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118389","الوافر"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46471","الوافر"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126378","الطويل"],[2249,"","https://poetry.dctabudhabi.ae/diwan/poem/202569","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205785","الوافر"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205782","المتقارب"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115689","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74175","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74168","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65111","المتقارب"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68017","الطويل"],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62742","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48340","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48437","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138699",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138445",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66450","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91681","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205879","الهزج"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36736","الطويل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111189","الوافر"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81932","السريع"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127937","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83195","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72494","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141678","الطويل"],[5065,"مكاشفة الغموض","https://www.poetsgate.com/ViewPoem.aspx?id=205181",""],[3271,"من نار السكينة","https://www.poetsgate.com/ViewPoem.aspx?id=128739",""],[5096,"من السخف","https://www.poetsgate.com/ViewPoem.aspx?id=206911",""],[5129,"حين يزهر الجنون","https://www.poetsgate.com/ViewPoem.aspx?id=120621",""],[5206,"صِرف النصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=187394",""],[5409,"حياةُ الربيع وعصر الباب","https://www.poetsgate.com/ViewPoem.aspx?id=155499",""],[5961,"اضرب عن الناس","https://www.poetsgate.com/ViewPoem.aspx?id=199763",""],[6075,"أجيبي نبض قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=190482",""],[6147,"جنوني ... بلا مدى.","https://www.poetsgate.com/ViewPoem.aspx?id=151491",""],[520,"هل القلب الا بضعة يتقلب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577441",""],[433,"لقاء القاهرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87049&r=&rc=2",""]],"verses":[["وَأَصْغُوا إِلَى قَوْلٍ وَاشٍ بِهَا","وَحَاشَ لَهَا أَنَّها وَازِرَهْ",0,"ر",2,0],["وَأَصغَرَ مِن قَعبِ الوَليدِ تَرى بِهِ","قِباباً مُبَنّاةً وَأَوديَةً خُضرا",1,"ر",2,0],["وأصغى المُعرضاتُ إلى عتابٍ","يُحَطُّ به الوُعُول من الهِضابِ",2,"ب",1,0],["وَأَصغى إِلى نَسَماتِ المُروجِ","وَأَصغى إِلى نَفَحاتِ الزَهَر",3,"ر",1,0],["وَأُصغي إِلَيهِ مُستَعيداً حَديثُهُ","كَأَنِّيَّ ذو وَقرٍ وَلَستُ بِذي وَقرِ",4,"ر",1,0],["وأصغاء إلى وتر وناي","إذا ناحا على زق جريح",5,"ح",1,0],["وَأَصغى إِلى لَحنٍ فَصيحٍ يَهُزُّهُ","كَما هَزَّ نَشرُ الريحِ رَيحانَةً سَكرى",6,"ر",2,0],["وَأَصغى إِلى داعي النَدى سَمعَ أَروَعٍ","مُجيبٍ عَلى بُعدِ الصَريخِ مُجيرِ",7,"ر",1,0],["وأصغى فَلَم يَسمَع زَئيراً يريبه","فَقامَ وَولَّى ظهره الغاب يركض",8,"ض",1,0],["وأصغت فمرت على سمعِها","روايةُ ميلادِها الغابرِ",9,"ر",1,0],["وأصْغَوا إلى الرأي السديدِ وأنصتوا","لنصحِ نصيرٍ للعُروبةِ باسلِ",10,"ل",1,0],["وأصغى السكون ، إلى كل بيت","كحيران ، ينوى وينسى الوطر",11,"ر",1,0],["واصغ يا منيتي ومشعل روحي","بسكون الدجى إلى أنغامي",12,"م",2,0],["واصغرتها والشر في بطن امهِ","ولمَّا تلدهُ لو علمتَ كبير",13,"ر",1,0],["وأصغرُهم نفساً وأكبرُهم حِجا","وأقصرُهم طَرْفاً وأطولهم يدا",14,"د",2,0],["وَأصغي إِذا جاءوا بِغَيرِ حَديثِهِ","بِسَمعي وَلَكِنّي أَذوبُ لهُ فِكرا",15,"ر",2,0],["وَاِصغَ لِشَكوى موجَعٍ","سَميرِ هَمٍّ مُقلِقِ",16,"ق",1,0],["وَاِصغِ لَها مِنَ الهِجانِ","العُرُبِ الفِصاحِ",17,"ح",1,0],["وَأَصغرتُ ما يُطوى وَيُنشَرُ وَشيُه","فحبّرتُ منشوراً عَلى الدَهر ما يُطوى",18,"و",2,0],["وأصغَرُهم إن قال للفَتحِِ كُن يَكُن","وللدَّهرِ سِر طوعي يَسِر وهو خادِم",19,"م",1,0],["وأصغ الى لطف الكلام وحسنه","بلا عجب يبدو عليك واذعان",20,"ن",1,0],["وَإِصغاء إذعانٍ إليّ فإنّما","لإلقاءِ إكسيرِ الكلامِ سما لهبي",21,"ب",2,0],["وأصغي إلى تحصيله في مسامع ال","مشاعر من كل منبت شعرة",22,"ه",1,0],["وأصغى إِلى رجم الظنون مصدِّقاً","ألا إنما تلك الظنون كواذب",23,"ب",1,0],["وأصغ لما أبديه عقلاً وناظراً","ووَجِّهْ سماعاً لا يضيق وِعاؤه",24,"ا",3,0],["وَأَصغَت إِلى ذاكَ الصِبا فَتَعَثَرَت","بِأَذيالِها سُكراً تَعَثَر غَيران",25,"ن",1,0],["وَأَصغِ إِلى الشَكوى وَإِن كُنتَ قاسِياً","فَإِن اِستِماع البَث نَوع مِن الرفق",26,"ق",1,0],["وأَصغيتُمُ إذْ لم تقولُوا وطَالَما","تعرّضَ في الأسماعِ من ذكريَ الوَقْرُ",27,"ر",1,0],["وأَصغِ لها عذراءَ لولاك لم تُجب","خطيباً ولم يظفَر بها الدهرَ ناكحُ",28,"ح",1,0],["وأصغُوا إلى نجوايَ فهي شكايةُ","وجدتُ لها طعماً حكى الصّابَ عَلْقَما",29,"م",2,0],["وأصغي للجنود وهم نشاوى","بحب شاربا كأس الجمام",30,"م",1,0],["واصغ إلى ماقلته تنتفع به","ولا تطرح نصحي فإني مجرب",31,"ب",1,0],["وأصغَرُ مَا يَكتمَن لو كُنتَ خَأدِعا","ولكنَّه الشيءُ الذي أنتَ تعلَمُ",32,"م",1,0],["وَأصغوا إِلى داعي الرّدى وَتَهافتوا","تَهافُتَ خَوَّارِ الأباءِ المسَعَّرِ",33,"ر",1,0],["وأصغت لأغانيها","أزاهير البساتين",34,"ن",1,0],["وأصغرها لا يكاد يرى","ببعد ولا يحتوي معشرا",35,"ر",2,1],["واصغ لشكوى كلف ذي جوى","يذبل من أيسره يذبل",36,"ل",1,0],["وَاصْغَ لِتَغْرِيدِ الحَمَامِ وَشَدْوِهِ","يُنْبِئْكَ عَنْ وَجْدِي وَعَنْ أشْوَاقِي",37,"ق",2,0],["وأصْغِ لما أَشَرْتُ بِهِ فإنِّي","صَبَحْتُكَ مِنْهُ كَأْسَ النُّصحِ مَحْضَا",38,"ض",2,0],["وأصغى إلى الأخرى بقلب كأنه","عياناً يرى سكانها وقطينها",39,"ن",3,0],["وَأَصغَت مِنَ الآسِ النَضيرِ مَسامِعٌ","لِتَسمَعَ ما يَتلوهُ مِن سُوَرِ الشِّعرِ",40,"ر",1,0],["وأصغرهم رب الختان حسينه","نجاته تسمو بغير مراء",41,"ا",2,0],["وَاصْغِ إليه مُغْرِباً منتجاً","يملأُ سَمْعَ الدَّهْرِ إذ يُمْلي",42,"ل",2,0],["وأصغر ما فيها بما عند ربه","ومن طلب البحر استقل السواقيا",43,"ي",2,0],["واصغ للطّير واعجبن كيف عادت","تنشط النفس بالحديث المعاد",44,"د",1,0],["وأصغى شنفها الأسماع منها","إلى الواشين فهي لهم تميل",45,"ل",1,0],["وَاِصغاءً إِلى شَكوى شَكورٍ","أَطلتَ عَلى قَصَابتِهِ عِتابه",46,"ب",2,0],["واصغيت للواشي وصدَّقت قوله","وضيعت ما بيني وبينك بالكذب",47,"ب",1,0],["وأصغ بسمعك نحو روض سحْبُهُ","من راحتيك ودرُّهُ من منطقي",48,"ق",2,0],["وأصغ إلى الهتاف على الروابي","سلمت لنا وعشت مدى طويلا",49,"ل",2,0],["وأصغى الرفاق إلى قوله","يسير على وضح المنطق",50,"ق",1,0],["واصغ لما قد قلته","فكم خرمت من مثل",51,"ل",1,0],["وَأصغت إِلى الطَنبور عِندَ طنينه","فَصاغَت لَهُ مِن طيب نَغمتها إذنا",52,"ن",2,0],["وَأَصغرهم عَبد الغَني وَأَحمد ال","كَريم المَساعي طَيب الأَب وَالجد",53,"د",1,0],["وأصغ لما قال تاريخهُ","ختانٌ به اللهُ زادك طيبا",54,"ب",2,0],["وأُصغِي إِلَى الأصوات من كل ناطقٍ","وأَنْصِب طرفي للبُروق اللَّوامع",55,"ع",1,0],["وأصغرٌ فذاك ذو اندراج","ووسطٌ يلغى لدى الإنتاج",56,"ج",1,0],["واصغَ لقولي اذا حاجيتُ ملتفتاً","من جاز بحراً فهل يحصيه بالقدمِ",57,"م",1,0],["وأصغرُ عيبٍ في زمانِكَ أنّهُ","بهِ العِلْمُ جهلٌ والعَفافُ فُسوقُ",58,"ق",1,0],["وأُصغي إلى ذِكْرِ التّواصُلِ واللِقا","وبالفكْرِ لا أزْدادُ إلا تشوُّقا",59,"ا",1,0],["وأُصْغي لأقوامٍ يُقيمونَ ألْسُناً","تُجادِلُ في صدْقِ المقالِ وتَخصُمُ",60,"م",1,0],["واصغى ارتياحاً لاستماع حديثه","إذا ما أتى الهيجاء فل البواترا",61,"ر",2,0],["وأصغر الثقلين في منتهى","مراتب خصوا بها لا العلى",62,"ل",2,0],["واصغي لما قد قيل عنها راغباً","متزوّداً ميرا بلا استظهار",63,"ر",1,0],["وَأَصغر ما يَرمي بِهِ الدَهرُ أَن نَرى","تساوى لَدينا جَفوةُ الآل وَالود",64,"د",1,0],["وأصغيت على مهل","فطاشت كل آذاني",65,"ن",2,0],["وَأَصغِ إِلى عَتبِ الصَديقِ فَرُبَّما","أَعادَ عِتابٌ خُلّةَ المُتَصَرِّمِ",66,"م",1,0],["واصغاء إلى وتر ونأي","إذا ناجى على دن جريح",67,"ح",1,0],["واصغوا إلى الداعي فهل أنتمُ","صمٌ عن الداعي فلا تسمعون",68,"ن",1,0],["واصغي لقولي اذا حاجيت ملتفتاً","من جاز بحراً فهل يحصيه بالقدم",69,"م",1,0],["وَاصغ إِلى مَعذِرَةِ الإِخوانِ","وَقابل السَيِّئَ بالإِحسانِ",70,"ن",1,0],["واصغ لما أقوله بأذن","واعية واسمع رخيم رنَّ",71,"ن",1,0],["وأصغي إليَّ الجد حين دعوته","ولاحت تباشر المنى لي من صُبحي",72,"ح",2,0],["وأُصغِي إلى الأرواحِ في خَلَوَاتِها","فأسمعُ صوتَ الميِّتينَ يُزَمجِرُ",73,"ر",1,0],["وأصغيتُ فيه وكرّرتهُ","وجودًا لذاتي أخفيتهُ",74,"ت",2,0],["وأصْغي لأضْغاثِ المفاسد مُلزَمًا","بحبْكتهِ كادتْ تكون اختياريَهْ",75,"ر",3,0],["وأصغى لوقْعِ النبض صارخُ لهفتي","فأسْلَكَه دربَ القَبولِ ويَسَّرا",76,"ر",2,0],["وَاصْغِ إليَّ بِسَمْعِ قَلبٍ شَاهِدٍ","أَلقَى السَّمَاعَ لِسِرِّهِ بِفُدُودِهِ",77,"د",2,0],["وأصغي إليك إذا ما الطيور","تغنت بأوكارها شاديه",78,"ه",1,0],["واصغى بأذنيك للذكار هل شغلوا","بغير توحيدهم لله بالله",79,"ل",2,0],["وَأَصْغَى لِلْبَلَابِلِ مُسْتَهَامًا","فَفِي تَغْرِيدِهَا هَمْسُ الْعِتَابِ",80,"ب",1,0],["وأصغيتُ في صمتٍ لِمأمونِ حكمةٍ","يسبّح من أفضاله الخَلْقُ تنْويها",81,"ي",3,0],["واصغ إلا ما قلته تنتفع به","ولا تطرح نصحى فإني مجرب",82,"ب",1,0],["وأُصغي فأسمع لحنَ الحياةِ","في الروض في فرحة الزائر",83,"ر",1,0]]}