{"poems":[[91,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[28,"لعمري لقد صابت على ظهر خالد","https://www.aldiwan.net/poem5173.html","الطويل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[33,"أتضرب ليلى كلما زرت دارها","https://www.aldiwan.net/poem25998.html","الطويل"],[33,"ألا هل طلوع الشمس يهدي تحية","https://www.aldiwan.net/poem25999.html","الطويل"],[102,"يا أيها البلد الكئيب","https://www.aldiwan.net/poem33097.html","مجزوء الكامل"],[46,"أم دفر جزيت شرا فديا","https://www.aldiwan.net/poem22852.html","الخفيف"],[46,"لو كان يدري أويس ماجنت يده","https://www.aldiwan.net/poem23343.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142033","الكامل"],[162,"وله نابه وخطب جليل","https://www.aldiwan.net/poem67814.html","الخفيف"],[227,"علل فؤادك بالمنى إن المنى","https://www.aldiwan.net/poem50814.html","الكامل"],[268,"أتضمد جرحا وتمسح دمعا","https://www.aldiwan.net/poem35212.html","المتقارب"],[403,"طرقت خيالا بعد طول صدودها","https://www.aldiwan.net/poem50186.html","الكامل"]],"verses":[["أَتَضِنُّ بِالدينارِ في إِسعافِهِ","وَتَجودُ بِالآلافِ في الفَحشاءِ",0,"ا",2,0],["أَتَضرِبُ في العِصيانِ تَزعُمُ مَن عَصا","وَتَعصي أَميرَ المُؤمِنينَ أَخا قَسرِ",1,"ر",1,0],["أتَضمنينَ مَقيلاً لي سَواسِيةً","بين الحشائشِ أو بين الرياحين؟",2,"ن",1,0],["أَتُضرَبُ لَيلى كُلَّما زُرتُ دارَها","وَما ذَنبُ شاةٍ طَبَّقَ الأَرضُ ذيبُها",3,"ب",3,1],["أَتُضرَبُ لَيلى إِن مَرَرتُ بِذي الغَضى","وَما ذَنبُ لَيلى إِن طَوى الأَرضَ ذيبُها",4,"ب",3,0],["أَتَضيع يا وَطَني وَها","عرق العُروبة فيَّ نابض",5,"ض",1,0],["أَتَضَحّى بِالهَمِّ أَو أَتَمَسّى","وَتَقَضّى مِنَ الخُطوبِ التَماسي",6,"ي",1,0],["أَتُضمِرُ التَوبَ مِن ضَأنٍ تُرَوِّعُها","أَم كانَ ذَلِكَ داءً فيكُمُ قُدُما",7,"م",2,0],["أتضيق بالقتلى رحاب قبورها","والعدل مشلول السواعد أبكم",8,"م",1,0],["أَتضيعُ الدِماءُ يا قَومُ فَزعاً","لا بَواء وَلا دَمٌ مَطلولُ",9,"ل",1,0],["أَتضيقُ بي الأرضُ العريضةُ ساعةً","والأَرضُ فيها قَيْنةٌ ومُدامُ",10,"م",1,0],["أتضمدُ جرحاً وتمسحُ دمعا","وترجو من الدَّهر عوداً وجمعا",11,"ع",2,1],["أَتَضيع نَفساً أَنتَ مِن تامورها","وَصَميمِها كالجُزءِ مِن تَوحيدِها",12,"د",3,0]]}