{"poems":[[93,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[30,"لعمري لقد صابت على ظهر خالد","https://www.aldiwan.net/poem5173.html","الطويل"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[35,"أتضرب ليلى كلما زرت دارها","https://www.aldiwan.net/poem25998.html","الطويل"],[35,"ألا هل طلوع الشمس يهدي تحية","https://www.aldiwan.net/poem25999.html","الطويل"],[104,"يا أيها البلد الكئيب","https://www.aldiwan.net/poem33097.html","مجزوء الكامل"],[48,"أم دفر جزيت شرا فديا","https://www.aldiwan.net/poem22852.html","الخفيف"],[48,"لو كان يدري أويس ماجنت يده","https://www.aldiwan.net/poem23343.html","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142033","الكامل"],[96,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[168,"وله نابه وخطب جليل","https://www.aldiwan.net/poem67814.html","الخفيف"],[234,"علل فؤادك بالمنى إن المنى","https://www.aldiwan.net/poem50814.html","الكامل"],[275,"أتضمد جرحا وتمسح دمعا","https://www.aldiwan.net/poem35212.html","المتقارب"],[412,"طرقت خيالا بعد طول صدودها","https://www.aldiwan.net/poem50186.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126679","الكامل"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102034","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48794","الخفيف"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138104",""],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144093","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109741","الرمل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107181","الكامل"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145116","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109916","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92038","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216746","المتقارب"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103290","الوافر"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130601","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204285","الطويل"],[4869,"زمان الطفوله","https://www.poetsgate.com/ViewPoem.aspx?id=139692",""],[5587,"شمس الجهاد","https://www.poetsgate.com/ViewPoem.aspx?id=196820",""],[5956,"تواصل الفتن فيما بيننا","https://www.poetsgate.com/ViewPoem.aspx?id=202522",""]],"verses":[["أَتَضِنُّ بِالدينارِ في إِسعافِهِ","وَتَجودُ بِالآلافِ في الفَحشاءِ",0,"ا",2,0],["أَتَضرِبُ في العِصيانِ تَزعُمُ مَن عَصا","وَتَعصي أَميرَ المُؤمِنينَ أَخا قَسرِ",1,"ر",1,0],["أتَضمنينَ مَقيلاً لي سَواسِيةً","بين الحشائشِ أو بين الرياحين؟",2,"ن",1,0],["أَتُضرَبُ لَيلى كُلَّما زُرتُ دارَها","وَما ذَنبُ شاةٍ طَبَّقَ الأَرضُ ذيبُها",3,"ب",3,1],["أَتُضرَبُ لَيلى إِن مَرَرتُ بِذي الغَضى","وَما ذَنبُ لَيلى إِن طَوى الأَرضَ ذيبُها",4,"ب",3,0],["أَتَضيع يا وَطَني وَها","عرق العُروبة فيَّ نابض",5,"ض",1,0],["أَتَضَحّى بِالهَمِّ أَو أَتَمَسّى","وَتَقَضّى مِنَ الخُطوبِ التَماسي",6,"س",2,0],["أَتُضمِرُ التَوبَ مِن ضَأنٍ تُرَوِّعُها","أَم كانَ ذَلِكَ داءً فيكُمُ قُدُما",7,"م",2,0],["أتضيق بالقتلى رحاب قبورها","والعدل مشلول السواعد أبكم",8,"م",1,0],["أتضيق بالأنثى وحبّك لم يضق","بالوحش بين سباسب وبطاح",9,"ح",1,0],["أَتضيعُ الدِماءُ يا قَومُ فَزعاً","لا بَواء وَلا دَمٌ مَطلولُ",10,"ل",1,0],["أَتضيقُ بي الأرضُ العريضةُ ساعةً","والأَرضُ فيها قَيْنةٌ ومُدامُ",11,"م",1,0],["أتضمدُ جرحاً وتمسحُ دمعا","وترجو من الدَّهر عوداً وجمعا",12,"ع",2,1],["أَتَضيع نَفساً أَنتَ مِن تامورها","وَصَميمِها كالجُزءِ مِن تَوحيدِها",13,"د",3,0],["أتضنّ بالدنيا رقى إسعافه","وتصدّ عنه بغلظة وجفاءِ",14,"ا",2,0],["أتضمن أن يبقى لنا مبدأ العلى","نزان به من عفة وحياء",15,"ا",2,0],["أتضيق الحياة والأرض ملأى","ثمراتٍ والنيل في سلساله",16,"ل",2,0],["أتضحك مهموما ليهتف غافل","وتنحب تضليلا ليبكي متيّم",17,"م",1,0],["أتضيقُ عنك الأرضُ وهيَ فسيحةٌ","وتضمُّ جسمكَ بعد موتِك أذرُعُ",18,"ع",1,0],["إِتضع للناس أن رمتَ العلا","فلها ترقى ولا تلقى الضرر",19,"ر",1,1],["أَتُضاعُ كُلُّ كَريمَةٍ في قَومِها","وَيُصانُ ذَيَّاكَ الحَقِيرُ الداني",20,"ن",2,0],["أتضيق ذرعا كابن آ","دم بالوجود وما انتظم",21,"م",1,0],["أتضج من شرف يداس","ومن المسيطر إذ ظلم",21,"م",1,0],["أتضج من حر يها","ن ومن حقوق تهتضم",21,"م",1,0],["أتضج من جار يجو","د ومن وضيع يحترم",21,"م",1,0],["أتضج من عبث السيا","سة أو أخ خان الذمم",21,"م",1,0],["أتُضِيعُ أجرَكَ يا فَتَى والحالُ أَنَّكَ","مُؤجَرُ الأَعمالِ في جَنَّاتِهِ",22,"ت",2,0],["أتُضحي وحيداً وَالمحبون معشر","وَتردى قتيلاً بعد تلك البدائع",23,"ع",1,0],["أتضحك لي ضحكات الثلوج","إذا ما علاها ضياء القمر",24,"ر",1,0],["أتضربُ مثله بالسوط عشرا","ضُربتَ بفالجِ ابنِ أبي دُوادِ",25,"د",1,0],["اتضربها شلت يمينك انها","وجوه لوجه الله طال سجودها",26,"د",3,0],["أتضربُ صفحاً وادعَ الجأش ساكنا","وجنبي على رمضائه يتضرّبُ",27,"ب",1,0],["اتضح من كان همه بالمصايب يمتحني","ولّ يادنيا العجايب كن ما بالكون وافي",28,"ف",2,0],["أَتُضِيءُ بَعْدَكِ فِي البُيُوتِ شُمُوعُ","أَفَلَتْ شُمُوسُكِ وَ الفِرَاقُ فَظِيعُ",29,"ع",1,1],["أ تضيع يا وطني فلسطينَ التي","بليتْ بإسرائيلَ والطغيانِ..؟",30,"ن",1,1]]}