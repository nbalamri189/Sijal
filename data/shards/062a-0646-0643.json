oemId=573643",""],[6218,"كلاّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65905&r=&rc=58",""],[6355,"هلال رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66597&r=&rc=57",""]],"verses":[["تَنكَّرَ هَذا الناسُ بَعدَكَ لِلنَّدى","وَأَقلَعَ مِن نَوءِ المَكارِمِ ماطِرُه",0,"ر",2,0],["تَنَكَّسَ كَالأَميمِ فَإِن تَسامى","مَضى كَالسَهمِ شَذَّ عَنِ الرِماءِ",1,"ا",2,0],["تَنَكَّرَ لي دَهْري وَلَمْ يَدْرِ أَنَّنِي","أَعِزُّ وَأَحْداثُ الزَّمانِ تَهُونُ",2,"ن",1,1],["تَنَكَّرَتِ البِلادُ وَمَن عَلَيها","كَأَنَّ أُناسَها لَيسوا بِناسي",3,"س",2,0],["تنكّبُ عنْها البيضُ وهْيَ بواتِرٌ","ويَقْصُرُ عنْها السّمْهَريُّ المُثَقّفُ",4,"ف",1,0],["تَنَكَّرَتِ الحَيَاةُ كَأَنَّ دَهْراً","يَجِيءُ وَيَنْقَضِي فِي كُلِّ سَاعَهْ",5,"ه",1,1],["تَنكَّبُ لَأواءُ السِنينَ جِوارَهُم","فَلا تَصطَليهِم جَمرَةُ الجَمَراتِ",6,"ت",1,0],["تَنَكَّرَ مِن مَعارِفِها وَمالَت","دَعائِمُها وَقَد بَليَ الثُمامُ",7,"م",1,0],["تَنَكَّرَ سَيفُ الدينِ لَمّا عَتَبتُهُ","وَعَرَّضَ بي تَحتَ الكَلامِ وَقَرَّعا",8,"ع",2,0],["تَنكَّبُ عنا مرة فكأنما","مُنَكِّبُهَا عنا إلينا مُسَدِّدُ",9,"د",1,0],["تنكَّرن لي أن نكّر الشيبُ لمَّتي","وفي الشيب للسودِ الذرى متحرّمُ",10,"م",1,0],["تُنَكَّرُ آياتُ البِلادِ لِمالِكٍ","وَأَيقَنَ أَن لا شَيءَ فيها يُقَوَّلُ",11,"ل",1,0],["تُنكِرُ مِنهُ اليَومَ حُس","ناً كُنتَ أَمسِ تَعرِفُه",12,"ف",2,0],["تُنكِرُ الأَرضُ عَلَيهِ جِسمَهُ","وَاِسمُهُ أَعظَمُ مِنها دَوَرانا",13,"ن",2,0],["تُنَكِّسُهُم وَالسابِقاتُ جِبالُهُم","وَتَطعَنُ فيهِم وَالرِماحُ المَكايِدُ",14,"د",1,0],["تَنَكَّرَ العَيشُ حَتّى صارَ أَكدَرُهُ","يَأتي نِظاماً وَيَأتي صَفوُهُ لُمَعا",15,"ع",2,0],["تَنَكَّبَ مَذمومَ الخِلالِ وَبَرَّزَت","خَلائِقُ مِنهُ في الوَفاءِ وَفي الفَضلِ",16,"ل",1,0],["تَنَكَّرَ الناسُ لِلناسِ الأُلى عَرَفوا","وَتِلكَ حالُ أَبي إِسحاقَ لَم تَحُلِ",17,"ل",1,0],["تَنَكَّرَ حَتّى لَأَنكَرتُهُ","خَلا أَنَّني عارِفٌ بِاِسمِهِ",18,"م",2,0],["تَنَكَّرَ لِي دَهري وَلَم يَدرِ أَنَّني","أَعزُّ وَرَوعاتُ الخُطوبِ تَهونُ",19,"ن",1,1],["تَنَكَّبتُ جَهلي فَاستَراحَ ذَوُو عَذلي","وَأَهمَدتُ غِبَّ العَذلِ حينَ انقَضى جَهلي",20,"ل",2,1],["تنكر النور في الوجود فيغدو","محض وهمٍ كأنه ما رأيته",21,"ه",1,0],["تَنَكَّرَ تَنْكِزٌ بدمشقَ خلقاً","فقاسوا منهُ أنواعَ العذابِ",22,"ب",1,1],["تنكَّرَ تنكزّ بدمشقَ تيهاً","فقاسوا منهُ أنواعَ العذابِ",23,"ب",1,1],["تنكَّرت صُوَرُ الهيجاءِ واتّخذَتْ","من الأعاجيبِ أثواباً لها قُشُبا",24,"ب",2,0],["تَنَكَّرَ رَسمُها إِلّا بَقايا","جَلا عَنها جَدا هَمِعٍ هَتونِ",25,"ن",1,0],["تَنَكَّرَ صالِحٌ فَضَبابُ قَيسٍ","ضَبابٌ يَتَّقينَ مِن اِحتِراشِ",26,"ش",1,1],["تَنَكَّرَ بَعدي مِن أُمَيمَةَ صائِفُ","فَبِركٌ فَأَعلى تَولَبٍ فَالمَخالِفُ",27,"ف",1,1],["تنَكّرْتَ فاعْرِفْ للشّبيبةِ مَوْضِعاً","بكُلّ ضَميرٍ مِنْ هَواهُ وَساوِس",28,"س",1,0],["تنكر وهو لو كشّفت عنه","أسفّ مجانة وهوى مزاحا",29,"ح",2,0],["تَنَكَّبَ مُمْسَاهُ وَأَخْطَأَ صَيْدَهُ","فَأَقْعَى عَلَى غَيْظٍ مِنَ الْجُوعِ وَالْكَدِّ",30,"د",1,0],["تَنَكَّرَتْ مِصْرُ بَعْدَ الْعُرْفِ وَاضْطَرَبَتْ","قَوَاعِدُ الْمُلْكِ حَتَّى رِيعَ طَائِرُهُ",31,"ر",2,0],["تنَكَّرَ مِنْ عُرْفٍ لَهَا وَكَدَأْبِهِ","لِكُلِّ مُجِدٍّ حَالَةً يتَنَكَّرُ",32,"ر",1,0],["تنكر لي الصديق فما اندهاشي","وقد قفز العدو إلى اجتياحي",33,"ح",2,0],["تَنَكَّروني وَهُم ثِقاتي","وَرُبَّما خانَتِ الثِقاتُ",34,"ت",1,0],["تنكب عنها البيض وهي بواتر","ويقصر عنها السمهري المشقف",35,"ف",1,0],["تنكّر لي عند المشيب ولا قلى","فمن بعض نعماه الكهولة والصبا",36,"ب",2,0],["تنكر مني الحال والطور والزي","ونشر ذنوبي في صحافي مطوي",37,"ي",1,1],["تنكر قوم بالزمان وطورهم","به يعرف الحذاق شأن الاوائل",38,"ل",1,0],["تنكّرَ لي دَهرِي وَلم يَدرِ أَنَّني","عَرَفتُ جَليّ الأَمرِ لَمّا تَنَكّرا",39,"ر",2,0],["تُنْكِرُ ظُلْمَ النَّاسِ عُشَّاقَهُمْ","وَأَنْتَ تَجْرِي بِي إلى مِثْلِهِ",40,"ل",2,0],["تَنكّر الخفر المَمسوخ في دَمها","يَزخرف عاقِر في مَنطِق عارِ",41,"ر",1,0],["تنكّست الأصنام عند ولاده","كما نكّستها منه في الفتح إصبع",42,"ع",1,0],["تُنكِرُ أَغمادَها مَناصِلُهُ","في يَومِ حَلٍّ وَيَومِ تَأويبِ",43,"ب",1,0],["تَنَكَّرَتِ الدُنيا عَلَيَّ فَفَوَّقَت","إِلَيَّ سِهامَ الغَدرِ بَعدَ وَفاءِ",44,"ا",2,0],["تنكر مرتابا ولم يدر أنني","شهدت مذاق العيش شهداً وعلقما",45,"م",2,0],["تنكر العلم الغربيّ من أضم","وأَقفرت بعد بين الركب رامات",46,"ت",1,0],["تنكّرت الدنيا على الدين ضلّة","ومن شيمة الدنيا تنكرَ فارك",47,"ك",1,0],["تَنَكَّرَ شَيبي مُذ تَوَلَّت شَبيبَتي","فَلي أَسَفٌ بَعدَ الشَبابِ يَطولُ",48,"ل",1,0],["تنكَّرَ الدهرُ واربدَّتْ مخايلُه","من بعدِ نكثتْ أيامُه الذمما",49,"م",2,0],["تَنكّبُ عَن حدائقَ محدقاتٍ","بِهِ كالهدبِ عَن حدقٍ تذودُ",50,"د",1,0],["تَنَكَّب بُنَيّاتِ الطَريقِ وَجَورَها","فَإِنَّكَ في الدُنيا غَريبٌ مُسافِرُ",51,"ر",1,1],["تَنكَّسَت الأَصنامُ وَالنارُ أُخمِدَت","وَغارَت عُيون الفُرس وَالفرس تَندُبُ",52,"ب",1,0],["تَنكَّسُ أبصارُ الكماةِ مَهابةً","لديه وتَعْيا ألسُنُ البُلَغاء",53,"ا",2,0],["تَنَكَّرَ بَعدَ البَينِ دارٌ وَجيرانُ","فَلا الدارُ ما كانَت وَلا القَومُ ما كانوا",54,"ن",3,1],["تنكَّرت أنَّ جسمي غيرُ مُنتَهكٍ","من السقامِ وقَلبي غير مختَبِلِ",55,"ل",1,0],["تنكَّبِ العالَمَ الغرّار محترزاً","في أول العمر إذ يلقاك مبتسما",56,"م",2,1],["تَنكبك الهَمّ الدَخيل فَإِنَّهُ","إِلى الحُر أَسى مِن خَيال إِلى خال",57,"ل",1,0],["تَنَكَّرَ للعينِ مَعروفُهُ","وَلَم يَفُت القَلبَ عِرفانُهُ",58,"ن",2,0],["تنكرني الإخوان حتى ثقاتهم","وحذرني منهم نذير التجارب",59,"ب",1,1],["تُنكِر العين بعد معرفةٍ من","ها طلولاً كأنَّما كنَّ رقما",60,"م",2,0],["تنكّر لي دهري المسيبء فردّه","برأي ممرّ في الملمات محصَد",61,"د",1,0],["تنكشف الدنيا له عن صورة","معبودها طمع بغير حدود",62,"د",1,0],["تُنكِصه البِطنةُ فيما يرتعِي","عن حَومة العلياء واقتحامِها",63,"م",3,0],["تنكّرت العينُ ما لا تزا","ل تعرفُ من ربعه الآهِلِ",64,"ل",1,0],["تنكّرته مذ رأته بُلجةً","ضاحيةً أن عرفته حِندِسا",65,"س",2,0],["تنكَّرتْ أن رأت شيبي وقد حسبت","أيَّام عمري فصدت أمُّ عمّارِ",66,"ر",1,0],["تنكّبوا فإنما","على الطريق الأسدُ",67,"د",1,0],["تنكَّر من إيحاشِه كل ساكنٍ","فصوَّانُهُ مرهوبةٌ وجَراولهْ",68,"ل",2,0],["تنكُّرهُ زعازعُ عاصِفاتٌ","وريحُ رضاهُ ساكنةٌ رُخاءُ",69,"ا",2,0],["تنكَّب عزْمُه خفْضَ المَساعي","فأرْضى المجدَ وافْترعَ القِلالا",70,"ل",2,0],["تنكَّرُها على الأعْداءِ نارٌ","وعطْفتُها على العافينَ ماءُ",71,"ا",2,0],["تنكَرَّ منْ كتمانِ سرِّي ولو درى","بخُرق زماني بات في الصمت عاذري",72,"ر",2,0],["تنكَّبُ ماء الرافدين ظَميئَةً","ويسْتاقُها غُدْرُ المَلا ووَقائعُهْ",73,"ع",2,0],["تنكر مني عادلاً ما عرفتم","ولاعجبا للظلم إن خلي الخل",74,"ل",1,0],["تَنَكَّرَ بعدَ ساكِنِهِ","فَأمسَى أهلُهُ فِرَقا",75,"ق",2,0],["تَنكَلُّ عَن مُتِّسِقٍ ظَلمُهُ","في ثَغرِهِ الإِثمِدُ لَم يُفلَلِ",76,"ل",1,0],["تَنَكَّب مَذهَبَ الهُمَجِ","وَعُذ بِالصَبرِ تَبتَهِجِ",77,"ج",1,1],["تنكبوا عن طريقنا وقفوا","وقفة قوم نذيرهم هود",78,"د",1,0],["تنكرت الدنيا ولكن تعرفت","بطيب الثنا عن فضله المتكامل",79,"ل",1,0],["تنكر صحب واتقى الجار جاره","وكُذِّبَ صدِّيقٌ وروع آمن",80,"ن",1,0],["تنكّرَ للخرّيتِ بالبيدِ عُرفُهُ","فلا عَلمٌ يعلو ولا النجمُ ينجُمُ",81,"م",1,0],["تنكصُ عن خِلِّهِ الهمومُ على","أَعقابها وهي غيرُ ما نُكَّص",82,"ص",1,0],["تنَكَّرت من بعد تعريفها","والحال ما امتاز بعطف البَيَان",83,"ن",1,0],["تنكَّرنَ من أُنسى فلمّا عَرَفننى","بَدَت كلُّ مِبهاجٍ أَغَرُّ جبينُها",84,"ن",3,0],["تنكَّبَ فى زوراءَ يُلحِقُ نبلها","إِلى الصيدِ عِجزٌ فى الشمالِ طحومُ",85,"م",1,0],["تنكّر لي بعد صفو الودا","دِ واللطفِ واِبتزّني ما أفادا",86,"د",2,0],["تنكرت لي نفسي","يوم اذّكاري أمسي",87,"س",2,1],["تنكبت عن ذا الدهرِ خوفَ نكوبهِ","فنكباه قد أنضت وأضنت مناكبي",88,"ب",2,0],["تنكبتْ قُلَلَ الأعلامِ مِن أجاً","وشاقَها دونَه سَلْعٌ وعُفانُ",89,"ن",1,0],["تنكر وقتي أورث الحزن والهما","وكيف وأهل الوقت قد أهملوا العلما",90,"م",2,1],["تنكر لي حالي فاصبحت فاقدا","اخا عند ما اشكو إليه يخفف",91,"ف",1,0],["تنكر وقتي بعد فقدي لاخوة","اقاموا على عهد من الود ما انحرف",92,"ف",1,0],["تَنَكَلّوا عن بَطنِ مَكَّةَ إِنَّها","كانَت قَديماً لا يُرامُ حَريمُها",93,"م",3,1],["تنكر الوجد وجفني شاهدٌ","مثبتٌ بالدمع خطَّي عبرتي",94,"ي",1,0],["تنكّر الحال إذ أبدوا تنازعهم","وحبل روحهم بالموت موصول",95,"ل",1,0],["تنكّرتِ الأيامُ لا بل تنكّستْ","فقد شابَهت آصالَها بُكَراتُها",96,"ت",3,0],["تُنكرُ العينُ آيَهُنَّ ويابي","شَغَفُ القلبِ والدموعُ سجوما",97,"م",2,0],["تنكَّرْتَ حتى صار بِرُّك قَسْوَةً","وقُرْبُك منهم جَفْوةً وتنائيا",98,"ي",2,0],["تَنَكّرَ أحبابٌ وبانتْ حبائبٌ"