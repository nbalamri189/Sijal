{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54972","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54329","الخفيف"],[214,"بك الدهر قد أبدى التهلل والبشرا","https://www.aldiwan.net/poem13323.html","الطويل"],[214,"من الود أني لا أحول عن الوفا","https://www.aldiwan.net/poem13465.html","الطويل"],[214,"تراءت لك الأيام باسمة الثغر","https://www.aldiwan.net/poem13519.html","الطويل"],[214,"تنفست الأيام وابتسم الدهر","https://www.aldiwan.net/poem13558.html","الطويل"],[275,"أفيقي فردي بسمة وسلاما","https://www.aldiwan.net/poem35622.html","الطويل"],[302,"سريرة شوق في الهوى من أذاعها","https://www.aldiwan.net/poem33229.html","الطويل"],[382,"لأعجب شيء ما تجل عزائمه","https://www.aldiwan.net/poem59266.html","الطويل"],[469,"لنحول خصرك والوشاح الجائل","https://www.aldiwan.net/poem3554.html","عموديه"],[556,"قفا بي على تلك الطلول الرثائث","https://www.aldiwan.net/poem48019.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63897","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38766","الطويل"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18219","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56210","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112841","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108673","الكامل"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95084","المنسرح"],[2431,"","https://poetry.dctabudhabi.ae/diwan/poem/139803",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87317","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87318","الرجز"],[3042,"","https://poetry.dctabudhabi.ae/diwan/poem/199482","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100834","الوافر"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26116","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100166","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59504","الطويل"],[3982,"","https://poetry.dctabudhabi.ae/diwan/poem/18404","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133078","الطويل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4677,"أتنسى","https://www.poetsgate.com/ViewPoem.aspx?id=204575",""],[4767,"اعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=91943",""],[4782,"شطر الخامسة","https://www.poetsgate.com/ViewPoem.aspx?id=198465",""],[5409,"حياةُ الربيع وعصر الباب","https://www.poetsgate.com/ViewPoem.aspx?id=155499",""],[5616,"غضبى","https://www.poetsgate.com/ViewPoem.aspx?id=204586",""],[5842,"كي لا ينضب الماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=73684",""],[6093,"تَعالوا أيُّها الشُّعُّارْ ( مجزوء الوافر المذيل)","https://www.poetsgate.com/ViewPoem.aspx?id=181727",""],[6331,"حلم موت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82023&r=&rc=4",""]],"verses":[["لِنحذَرْ مِنَ اليَأْسِ الَّذِي دُونهُ الرَّدَى","وَمِنْ كُلِّ مَأْفُونٍ مِنَ الرَّأْيِ مُؤنِسِ",0,"س",1,0],["لنحيي الأحبابَ جاءَتْ تُحييّ","شاعرَ العُرْبِ سيِّدَ الأوزان",1,"ن",1,0],["لنحوك قد اضحى التفاتي لأنني","وحقك لا زبدا اروم ولا عمرا",2,"ر",2,0],["لنحوك عن حالي اتيتك معربا","لعل بوصل ان تجود وتعطفا",3,"ف",2,0],["لنحوك وافت من خباها كأنها","وقد سفرت عذراء تبدو من الخدر",4,"ر",1,0],["لنحوك قد وافت من الفقر تشتكي","أغثها فلا زبد يغيث ولا عمرو",5,"ر",2,0],["لَنحنُ بنو البؤسى على الفقرِ والغِنى","وُلِدنا لكي نَلقى الخطوب جساما",6,"م",2,0],["لِنَحظى من الدُنيا بأَوفر حظِّها","وَنشهدَ أَوصافاً عَشِقنا اِستماعَها",7,"ع",3,0],["لنحفظ من هذا وذاك طهارةً","فمالُكها فيه الملاكُ يزاحمه",8,"م",2,0],["لنحول خصركِ والوشاح الجائل","لا خنتُ خانت في هواكِ عواذلي",9,"ي",1,1],["لَنحنُ بِنشر الفخرِ أعبقُ منكُمُ","وَأَسمق مِنكمْ في الجبالِ اللّوابِثِ",10,"ث",1,0],["لنحنُ السَّلَفُ الأعلى الّذي تعهدونَهُ","علقنا بهِ من وارثٍ بعد وارثِ",10,"ث",1,0],["لنحتُ الشعر للأعراضِ شرٌّ","على الأعراض من نَحْت الفؤوس",11,"س",1,0],["لِنَحوِ حِمى عكار عالية الذُّرى","مُشيّدة العَلياءِ بِالعِزِّ وَالمجدِ",12,"د",1,0],["لِنَحوِكَ يا بَطلوسُ عَزمِيَ قَد طَلَب","بِحَدِّ الحُسامِ كَالشِهابِ إِذا اِنتَدَب",13,"ب",1,1],["لنحو غزيرهم شوقي غزيرٌ","ديارٌ كم بها قد همت وجدا",14,"د",2,0],["لنحوكم قصدي المسير أحبتي","وفي وصلكم يحلو ثنائي عشرتي",15,"ي",1,1],["لنحول جسمي في الهوى وتفكري","بكم اكتسى بدني بثوب بهار",16,"ر",1,1],["لِنَحوِهَا جِئتُ عدتُ مشتغلاً","إذ ذَاك بالملحةِ الحريريّه",17,"ه",1,0],["لنحن بنو الحروب وموقدوها","غداة الروع دوماً تستطار",18,"ر",1,0],["لِنَحوِ سَنجافورَ فارحَل منها","لِنَحوِ تِيكٍ في النُّعُوشِ عنها",19,"ه",2,0],["لِنَحو تِيكا ثُمَّ سِر في العَقرَبِ","إلى تُوَبنَ ما بها من وَصَبِ",20,"ب",1,0],["لِنَحوِ جينا يا أخي وفرسو","فَرقَد ثلاثٍ ثمَّ نِصفٍ قاسوا",20,"س",3,0],["لنحن عليكم لا لكم إن عثرتُمُ","من الصَرعة الأولى إذا قُضي الأمر",21,"ر",1,0],["لنحن أحق بالشكران منهم","ولكن شيمة الباغي الجحود",22,"د",1,0],["لِنَحيا جَريرِ اللؤُمِ فَوقَ حِمارِهِ","عَليهِ وَرِبقا أُمِّهِ كانَ أَعوَدا",23,"د",2,0],["لنحت كما ناحت على صخرها التي","قد اتخذت من بعده العمر مأتما",24,"م",2,1],["لنحن أحق الناس بالحمد والثنا","وأولاهمُ بالملك ضربة لازم",25,"م",1,0],["لِنَحوِيَ أَرضاً أَو نُناهِبَ غارَةً","يَصيخُ لَها ما بَينَ بُصرى وَبابِلِ",26,"ل",1,0],["لنحظى بجناتٍ ونسلم من لظى","فجاهكم عند الإله فسيح",27,"ح",1,0],["لِنَحوِ حِماها وَهيَ في مَنعَةِ الهَوى","وَصَونِ شُفوفٍ مِن سُيوفٍ أَعِزَّةِ",28,"ه",1,0],["لنحيا التفاني ونجني الأماني","وتبقى بقربي ... حبيبًا وآل",29,"ل",1,0],["لنحيي فكرة في القلب كانت","وقبل العام لم تلق اعتبارا",30,"ر",2,0],["لنحيي (ليلة بالأنس ماسَتْ","بها طربا) أهازيجُ العيون",31,"ن",1,0],["لنحظى بها إنها فرصةٌ","فقد يبخل الدهر في ثانيه",32,"ه",1,0],["لِنَحْرُسَ أَسْرَابَ العَنَاقِيدِ كُلِّهَا","نُضِئُ سَمَاءً قد نَسِينا بها الشُّهْبَا",33,"ب",2,0],["لنحمل الراية العصماء في يدنا","وتزرع الحبَّ أسماءٌ وأسماءُ",34,"ا",2,0],["لنحسوَ خَمْرَ قافيةٍ","بِلا ذنبٍ ولا أوزَارْ",35,"ر",1,0],["لَنَحْنُ أضعفُ أن نحيا بلا شجنٍ","كذا جبِلَّتُنا بالماءِ والطِّينِ",36,"ن",1,0]]}