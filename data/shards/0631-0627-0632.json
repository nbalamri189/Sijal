{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[409,"قف وقفة العبد الذليل الحقير","https://www.aldiwan.net/poem33747.html","السريع"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25325","الرجز"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130809",""],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103828","المنسرح"],[4797,"حن بني مرة","https://www.poetsgate.com/ViewPoem.aspx?id=178127",""]],"verses":[["رازحاً في عذابه يتلوّى","مثقَلاً في فوادحِ الأعباء",0,"ا",2,0],["رازقنا هل نخنسي فاقة","وكل مخلوق إليه فقير",1,"ر",1,0],["رَازٌ بَنَاهَا آجُراً وَآجُرَا","وَقَدْ فَرَشْتُ الرَحْلَ حَرْفاً ضامِرا",2,"ر",2,0],["رازقٌ محسنٌ رؤوفٌ رحيمٌ","كلُّ شيءٍ لديهِ طوع البنانِ",3,"ن",1,0],["رازحات تحت نيرٍ سامها","مالها في سجنها من مذهب",4,"ب",1,0],["رازق أهل الزمان أجمعهم","من كان من عجمه ومن عربه",5,"ب",2,0],["رازقي وانا اتنقا فالمشاهي","اذكر افضاله ولا انكرت اشكرانه",6,"ن",2,0]]}