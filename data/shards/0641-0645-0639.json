{"poems":[[63,"ألمت ودوني رامة فكثيبها","https://www.aldiwan.net/poem46161.html","الطويل"],[100,"يقظة الصحراء","https://www.aldiwan.net/poem23696.html","عموديه"],[77,"تخالف جنس الشوق والحكم واحد","https://www.aldiwan.net/poem35893.html","الطويل"],[86,"من لم ير المعرض في اتساع","https://www.aldiwan.net/poem68848.html","الرجز"],[72,"كيف قاسوا قد الحبيب بغصن","https://www.aldiwan.net/poem20160.html","الخفيف"],[64,"ثلاثة أحرف لا عجم فيها","https://www.aldiwan.net/poem67614.html","الوافر"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[92,"يا رفيقي وأين أنت فقد","https://www.aldiwan.net/poem38907.html","الخفيف"],[78,"ببيض الهند والأسل الحداد","https://www.aldiwan.net/poem14259.html","الوافر"],[89,"اخبث الناس صديق","https://www.aldiwan.net/poem44877.html","مجزوء الرمل"],[49,"بنى معن ويهدمه يزيد","https://www.aldiwan.net/poem64148.html","الوافر"],[66,"هنيئا بشهر الصوم للملك الذي","https://www.aldiwan.net/poem40978.html","الطويل"],[105,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[48,"أربع البلى إن الخشوع لباد","https://www.aldiwan.net/poem62604.html","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[133,"طرقتني نوار عند دكار","https://www.aldiwan.net/poem54837.html","الخفيف"],[144,"لا تخش عدوى من أبحت ذماره","https://www.aldiwan.net/poem11831.html","الطويل"],[276,"ما للهوى إلا الرصافة مأرب","https://www.aldiwan.net/poem25635.html","الكامل"],[283,"وأهيف لحظه بالسحر ناجا","https://www.aldiwan.net/poem32838.html","الوافر"],[299,"أيصبر متبول الفؤاد كثيب","https://www.aldiwan.net/poem36324.html","عموديه"],[321,"جاز التماس إعادة الأنظار في","https://www.aldiwan.net/poem61665.html","الكامل"],[329,"تعاليت لا مولى سواك خلقتني","https://www.aldiwan.net/poem54954.html","الطويل"],[367,"بين الضلوع جهنم من حبهم","https://www.aldiwan.net/poem17017.html","الكامل"],[378,"جلا مذ تجلى أعينا فيك تدمع","https://www.aldiwan.net/poem59341.html","الطويل"],[378,"رويدا رويدا يا حداة الركائبِ","https://www.aldiwan.net/poem66929.html","الطويل"],[407,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[433,"أبليت بعدك في الأنام ظنوني","https://www.aldiwan.net/poem12427.html","الكامل"],[433,"ما لمن في الهوى من خلاق","https://www.aldiwan.net/poem12686.html","الخفيف"],[442,"أراك تريد فوق هوى تليد","https://www.aldiwan.net/poem14304.html","الوافر"],[442,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[459,"على كل حال جانب الحق أمنع","https://www.aldiwan.net/poem56131.html","الطويل"],[459,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[465,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[506,"الجرّافة","https://www.aldiwan.net/poem56764.html","الوافر"],[552,"أفي كل يوم لي حميم أفارقه","https://www.aldiwan.net/poem47369.html","الطويل"],[552,"ألا أرقت لضوء برق أومضا","https://www.aldiwan.net/poem47737.html","الكامل"],[552,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[576,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"],[576,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"]],"verses":[["فمَعْذِرَةُ الأيامِ مَقْبولَةٌ بِهِمْ","ومَغْفورَةٌ للنّائِباتِ ذُنوبُها",0,"ب",3,0],["فمعاني السلم في ألفاظه","حيل تبتكر الموت الزؤاما",1,"م",2,0],["فمَعْنَى اشْتِياقِ الأرْضِ للغَيْثِ حاجَةٌ","ومَعْنى اشْتِياقِ الغيْثِ للأرْضِ إشْفاقُ",2,"ق",1,0],["فَمَعرِضُ القَومِ بِلا نِزاعِ","في نَفثَةٍ مِن ذَلِكَ اليَراعِ",3,"ع",1,0],["فمعاديه في سوآء جحيمٍ","ومواليه في جنَّات عدنِ",4,"ن",1,0],["فَمَعجومٌ يُشاكِلَ وَأُجديهِ","وَمَتروكٌ يُصَدِّقُهُ الأَنامُ",5,"م",1,0],["فَمُعَقَّرٌ بِثِيابِهِ مُتَكَفِّنٌ","وَمُجَرَّحٌ بِدِمائِهِ مُتَسَربِلُ",6,"ل",1,0],["فمَعِي في جوانحي أَبدَ الدَّهرِ","فؤادٌ إلى الحقيقةِ ظامي",7,"م",2,0],["فَمَعنى الدَهرِ في قَتلِ الأَعادي","وَحَسمِ رِقابِهِم في كُلِّ وادِ",8,"د",1,0],["فمع المظلوم يبكي","ومع الظالم يضحك",9,"ك",1,0],["فَمَعنٌ كانَ لِلحُسّادِ غَمّاً","وَهَذا قَد يُسَرُّ بِهِ الحَسودُ",10,"د",1,0],["فَمٌ عَن أَحاديثِ المَحارِمِ صائِمٌ","وَكَفٌّ بِإِسداءِ المَكارِمِ مُفطِرُ",11,"ر",1,0],["فمعترك به عين وجيد","ومعترك به ظفر وناب",12,"ب",1,0],["فَمَعْشَرٌ رَكِبُوا الأَوْتادَ فانقطعَتْ","أَمْعاؤُهم فَتَمَنَّوْا أَنَّهمْ نُحِرُوا",13,"ر",3,0],["فَمَعذِرَةً مِنّي إِلَيكَ بِأَن تَرى","رَهينَةَ أَرواحٍ وَصَوبِ غَوادي",14,"د",2,0],["فَمَعناكَ مَعنى لَيلَةِ القَدرِ إِنَّها","عَلى الناسِ تَخفى وَهيَ في رَمَضانِ",15,"ن",1,0],["فَمَعَالِيكَ في انتِظَامٍ عَجِيبٍ","وأيَادِيكَ في عَجِيبٍ انتِثَارِ",16,"ر",1,0],["فَمُعَجَّلٌ لَكَ مِن إِلَهِكَ نَصرُهُ","وَمُؤَجَّلٌ لَكَ عِندَهُ رِضوانُهُ",17,"ن",2,0],["فَمَعَ الصّباح تبتُّلٌ وتَقَلّصٌ","ومع الظلام تبذُّلٌ وتَسحّبُ",18,"ب",1,0],["فَمِعصَمُ مُلكِهِ أَصبَحتَ فيهِ ال","سِوارَ لَهُ وَفَوقَ الفَرقِ تاجا",19,"ج",2,0],["فمعذرة إِن كان للدمع وَكفةٌ","وَللقلب من خوف الفراق وثوب",20,"ب",1,0],["فَمَعادُهُم في الشَهرِ لا يَبدا بِهِ","قَبلَ الظُهورِ بِحَجَّةٍ وَعَيانِ",21,"ن",1,0],["فمعنى وجودي في معاني وجودها","كمعنى نشيدي في كلام نشيدي",22,"ي",1,0],["فَمَعَ الظَلامِ الدَمعُ كانَ طَليقَها","وَمَعَ الصَباحِ الهَمُّ كانَ حَبيسَها",23,"ه",2,0],["فمعراجه للطور يوضح أنه","إلهٌ له كل الخلائق تَخضع",24,"ع",1,0],["فمعصومةٌ عن كل وصمة قادحٍ","مبرأةٌ عن كل دعوة عائب",25,"ب",1,0],["فَمُعَفِّر جَسَد الحَياة وَهارِب","جَسَد الرُفات القبر وَالصّفاحا",26,"ح",2,0],["فَمعِينُ فضلِكَ كلَّما أَورَدْتَني","يوماً مناهِلَه أَجلُّ مَعِينِ",27,"ن",1,0],["فمعاليه لم تزلْ في اجتماع","ولهاهُ لمّا تزَلْ في افتراقِ",28,"ق",1,0],["فمعذور وعرفني لعلي","أحاول صحبة لأخ جديد",29,"د",1,0],["فمعذرة إِليك اللَه هذي","نصيحات كشفت لهم غطاها",30,"ا",3,0],["فمعذرةً إن المفارق حافظٌ","هواك ومُثنِي الخيرِ بعدك مِصقَعُ",31,"ع",1,0],["فمع الحفيظة قسوةٌ وفظاظةٌ","حتى كأنّ فؤادَه جُلمودُ",32,"د",1,0],["فمعاقلٌ للكفر أيُّ معاقرٍ","وجزائرٌ بالسيف أي جزائر",33,"ر",1,0],["فمعْ كلّ شهيدٍ دَمعتانِ","فقطْ صَوناً لحقِّ القادِمينا",34,"ن",2,0],["فمُعْتَبَطٌ خولِسْتُهُ ومؤجَّلٌ","تلبّث حتّى خِلتنِي لا أُفارقُهْ",35,"ق",2,0],["فمعوَّضٌ عن نَزْرِ ماء حيائِهِ","بكثير ما بلغ الغِنى ما عُوّضا",36,"ض",2,0],["فَمُعجّلٌ لحمامهِ ومؤجّلٌ","وَمُشرّقٌ بِطلوعهِ ومغرّبُ",37,"ب",1,0],["فَمُعادِيه موثَقٌ ومُواليهِ","بقيدين من حَديدِ وَتِبْرِ",38,"ر",1,0],["فَمَعالِيه مَا لَها مِنْ نَفَاذٍ","وأَياديه ما لها مِنْ نَفاد",39,"د",1,0]]}