"","https://poetry.dctabudhabi.ae/diwan/poem/59504","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111476","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77006","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135095","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136678",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83132","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139751",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139499",""],[4709,"جمال يطوقني","https://www.poetsgate.com/ViewPoem.aspx?id=214866",""],[4755,"بفَمِي سُؤالٌ شاخَ دُونَ مُبَلِّغٍ","https://www.poetsgate.com/ViewPoem.aspx?id=188571",""],[4856,"قمر مسافر/لضياء عواد","https://www.poetsgate.com/ViewPoem.aspx?id=35880",""],[4955,"إذا ما كنت في يوم تعاني","https://www.poetsgate.com/ViewPoem.aspx?id=188748",""],[5112,"البدر الراحل","https://www.poetsgate.com/ViewPoem.aspx?id=212708",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5302,"يا غويا","https://www.poetsgate.com/ViewPoem.aspx?id=201064",""],[5302,"بين خوف وهموم","https://www.poetsgate.com/ViewPoem.aspx?id=201379",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5351,"هنا اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=202214",""],[5431,"ولكن أداينه ....","https://www.poetsgate.com/ViewPoem.aspx?id=214829",""],[5512,"خلف السواتر ..قمحانة","https://www.poetsgate.com/ViewPoem.aspx?id=204501",""],[482,"بسوى قربِكَ لا يُشْفَى الغليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=111425",""],[5628,"لست شاكيا","https://www.poetsgate.com/ViewPoem.aspx?id=178488",""],[5906,"فمعفر الليث","https://www.poetsgate.com/ViewPoem.aspx?id=188221",""],[5939,"لقد أفنيت في التسطيب عمرا","https://www.poetsgate.com/ViewPoem.aspx?id=185507",""],[5956,"جروحي","https://www.poetsgate.com/ViewPoem.aspx?id=197512",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6033,"تَصَبَّرْ!","https://www.poetsgate.com/ViewPoem.aspx?id=215799",""],[5309,"تغاوى دعي الفهم في رهط خلان","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573786",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6259,"لو جادهنَّ غداة رمنَ رواحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59361&r=&rc=9",""],[6368,"","https://www.linga.org/varities-articles/NDEwMQ","المضارع"]],"verses":[["فمَعْذِرَةُ الأيامِ مَقْبولَةٌ بِهِمْ","ومَغْفورَةٌ للنّائِباتِ ذُنوبُها",0,"ب",3,0],["فمعاني السلم في ألفاظه","حيل تبتكر الموت الزؤاما",1,"م",2,0],["فمَعْنَى اشْتِياقِ الأرْضِ للغَيْثِ حاجَةٌ","ومَعْنى اشْتِياقِ الغيْثِ للأرْضِ إشْفاقُ",2,"ق",1,0],["فَمَعرِضُ القَومِ بِلا نِزاعِ","في نَفثَةٍ مِن ذَلِكَ اليَراعِ",3,"ع",1,0],["فمعاديه في سوآء جحيمٍ","ومواليه في جنَّات عدنِ",4,"ن",1,0],["فَمَعجومٌ يُشاكِلَ وَأُجديهِ","وَمَتروكٌ يُصَدِّقُهُ الأَنامُ",5,"م",1,0],["فَمُعَقَّرٌ بِثِيابِهِ مُتَكَفِّنٌ","وَمُجَرَّحٌ بِدِمائِهِ مُتَسَربِلُ",6,"ل",1,0],["فمَعِي في جوانحي أَبدَ الدَّهرِ","فؤادٌ إلى الحقيقةِ ظامي",7,"م",2,0],["فَمَعنى الدَهرِ في قَتلِ الأَعادي","وَحَسمِ رِقابِهِم في كُلِّ وادِ",8,"د",1,0],["فمع المظلوم يبكي","ومع الظالم يضحك",9,"ك",1,0],["فَمَعنٌ كانَ لِلحُسّادِ غَمّاً","وَهَذا قَد يُسَرُّ بِهِ الحَسودُ",10,"د",1,0],["فَمٌ عَن أَحاديثِ المَحارِمِ صائِمٌ","وَكَفٌّ بِإِسداءِ المَكارِمِ مُفطِرُ",11,"ر",1,0],["فمعترك به عين وجيد","ومعترك به ظفر وناب",12,"ب",1,0],["فَمَعْشَرٌ رَكِبُوا الأَوْتادَ فانقطعَتْ","أَمْعاؤُهم فَتَمَنَّوْا أَنَّهمْ نُحِرُوا",13,"ر",3,0],["فَمَعذِرَةً مِنّي إِلَيكَ بِأَن تَرى","رَهينَةَ أَرواحٍ وَصَوبِ غَوادي",14,"د",2,0],["فَمَعناكَ مَعنى لَيلَةِ القَدرِ إِنَّها","عَلى الناسِ تَخفى وَهيَ في رَمَضانِ",15,"ن",1,0],["فَمَعَالِيكَ في انتِظَامٍ عَجِيبٍ","وأيَادِيكَ في عَجِيبٍ انتِثَارِ",16,"ر",1,0],["فَمُعَجَّلٌ لَكَ مِن إِلَهِكَ نَصرُهُ","وَمُؤَجَّلٌ لَكَ عِندَهُ رِضوانُهُ",17,"ن",2,0],["فَمَعَ الصّباح تبتُّلٌ وتَقَلّصٌ","ومع الظلام تبذُّلٌ وتَسحّبُ",18,"ب",1,0],["فَمِعصَمُ مُلكِهِ أَصبَحتَ فيهِ ال","سِوارَ لَهُ وَفَوقَ الفَرقِ تاجا",19,"ج",2,0],["فمعذرة إِن كان للدمع وَكفةٌ","وَللقلب من خوف الفراق وثوب",20,"ب",1,0],["فَمَعادُهُم في الشَهرِ لا يَبدا بِهِ","قَبلَ الظُهورِ بِحَجَّةٍ وَعَيانِ",21,"ن",1,0],["فمعنى وجودي في معاني وجودها","كمعنى نشيدي في كلام نشيدي",22,"ي",1,0],["فَمَعَ الظَلامِ الدَمعُ كانَ طَليقَها","وَمَعَ الصَباحِ الهَمُّ كانَ حَبيسَها",23,"ه",2,0],["فمعراجه للطور يوضح أنه","إلهٌ له كل الخلائق تَخضع",24,"ع",1,0],["فمعصومةٌ عن كل وصمة قادحٍ","مبرأةٌ عن كل دعوة عائب",25,"ب",1,0],["فَمُعَفِّر جَسَد الحَياة وَهارِب","جَسَد الرُفات القبر وَالصّفاحا",26,"ح",2,0],["فَمعِينُ فضلِكَ كلَّما أَورَدْتَني","يوماً مناهِلَه أَجلُّ مَعِينِ",27,"ن",1,0],["فمعاليه لم تزلْ في اجتماع","ولهاهُ لمّا تزَلْ في افتراقِ",28,"ق",1,0],["فمعذور وعرفني لعلي","أحاول صحبة لأخ جديد",29,"د",1,0],["فمعذرة إِليك اللَه هذي","نصيحات كشفت لهم غطاها",30,"ا",3,0],["فمعذرةً إن المفارق حافظٌ","هواك ومُثنِي الخيرِ بعدك مِصقَعُ",31,"ع",1,0],["فمع الحفيظة قسوةٌ وفظاظةٌ","حتى كأنّ فؤادَه جُلمودُ",32,"د",1,0],["فمعاقلٌ للكفر أيُّ معاقرٍ","وجزائرٌ بالسيف أي جزائر",33,"ر",1,0],["فمعْ كلّ شهيدٍ دَمعتانِ","فقطْ صَوناً لحقِّ القادِمينا",34,"ن",2,0],["فمُعْتَبَطٌ خولِسْتُهُ ومؤجَّلٌ","تلبّث حتّى خِلتنِي لا أُفارقُهْ",35,"ق",2,0],["فمعوَّضٌ عن نَزْرِ ماء حيائِهِ","بكثير ما بلغ الغِنى ما عُوّضا",36,"ض",2,0],["فَمُعجّلٌ لحمامهِ ومؤجّلٌ","وَمُشرّقٌ بِطلوعهِ ومغرّبُ",37,"ب",1,0],["فَمُعادِيه موثَقٌ ومُواليهِ","بقيدين من حَديدِ وَتِبْرِ",38,"ر",1,0],["فَمَعالِيه مَا لَها مِنْ نَفَاذٍ","وأَياديه ما لها مِنْ نَفاد",39,"د",1,0],["فمعارف وعوارف وبشاشة","وهشاشة تجلو عن القلب الكرب",40,"ب",1,0],["فمعلوله النور البسيط وظله","هو الفرع لكن شخص علمي أصله",41,"ه",1,0],["فَمَعنى كِتاب اللّه نَصب خَيالِهِ","كَسُنَّةِ خَيرِ الخَلقِ خَيرِ رَسولِ",42,"ل",1,0],["فَمَعنى السكَّر الحالي","غَدا لَم يَحوِهِ القَصبُ",43,"ب",1,0],["فمَعاذَ الإله أنْ أَنْأَيَنْ عنْ","ك ولا غرو أن أقولَ مَعاذا",44,"ذ",2,0],["فمعاذَ ربّ العرش عزّ من العمى","ومن التردّى في هوى الكفران",45,"ن",1,0],["فَمُعَادِيهِ فِي سَعِيرِ جَحِيمٍ","وَمُوَالِيهِ فِي جِنَانِ خُلُودِ",46,"د",1,0],["فمعد ذخرى وأهلي ومالي","وعمادي وعدتي وعتادي",47,"د",2,0],["فمعجم كلٍّ ضمَّ تاريخ عامه","ومهمل كلّ منهما قد حوى العددْ",48,"د",1,0],["فمعجم البيت تاريخٌ ومهملهُ","وكل شطر به التاريخ جاءَ جلي",49,"ل",2,0],["فمعجمه ومهمله وكل","من الشطرين تاريخاً تراهُ",50,"ا",2,0],["فمع الاسم لا يضرك شيء","هكذا الحكم قد جرى محكوما",51,"م",2,0],["فمعتصِرٌ ذا ولا يُكسر","وذا مُسكرٌ وهو لا يُعصر",52,"ر",1,0],["فمع الشمس يشرقون شموساً","ومع البدر يُشرقون بدورا",53,"ر",2,0],["فمعنى الحلى تهديه للقلب ذاته","و\"سر العلى\" يبديه للعين مجدُه",54,"د",2,0],["فمعزر وموقر ومسبح","ومقدس لبروزه أواب",55,"ب",1,0],["فمعذرةً إذا عاف القوافي","فحول الشعر بعدك فاستراحوا",56,"ح",3,0],["فمعذرةٌ لمصر إذا أرنت","وقامت بالأسى بين البكاة",57,"ه",1,0],["فمعنى الذي عددت في الوجهِ كلهِ","هو الله ذو الآلاء والبارئ النسم",58,"م",1,0],["فمعناه فيه خلقه جل ذكرهُ","مليكٌ تعالى ملكه غير منصرِم",58,"م",1,0],["فمعناه في منهن معهن هكذا","وإن كنت فيهم في المخافةِ فلتقم",58,"م",1,0],["فمعرفتي بالعينِ ما ثم غيرها","وعلمي بحال واحد وهو عاطف",59,"ف",1,0],["فمعطل الأوصاف ذاك معطل الت","وحيد حقا ذان تعطيلان",60,"ن",1,0],["فمعطل الأوصاف ذو شرك كذا","ذو الشرك فهو معطل الرحمن",60,"ن",1,0],["فمعي يا طير في أثري اقتفى","فمعي المأمول روض وغدير",61,"ر",1,0],["فمعي عسانا أن نروح بالعنا والخمر","من ألم النفوس",62,"س",1,0],["فَمَعذِرَةً إِلَيكَ الآنَ أَرجو","قُبولَ العُذرِ يا حَسنَ الخِلالِ",63,"ل",1,0],["فمع ما ترى من قصد وجهك للمنى","ترى يهتك الدهر المحارم والسرا",64,"ر",2,0],["فمع كل خمس أو تجاوز أربعاً","وعشرين بعد الحول شاة أبا نهد",65,"د",1,0],["فمعدن منها رصاصا يسمى","وخص بالقصدير غيره اسما",66,"م",2,0],["فمعصرة العصير تدور صرفا","ومن خمارها نشقوا الخمارا",67,"ر",2,0],["فمعدن قفلي قاسي جفاك","ودمع تحجر اذ يقطر",68,"ر",1,0],["فمعظم شعري جاء بين ضجيجهم","وإن زرت يوما نادياً أتبلد",69,"د",1,0],["فمعذرة لك حتى أراك","فأنت الممثل في مهجتي",70,"ت",2,0],["فَمِعْطَفُ القَبْرِ شَهْدٌ فِي عَبَاءتِهِ","وَمَارِقِيَّةُ غَيْمَاتِي كَجَوْهَرَتِي!",71,"ت",2,0],["فمعاهد بالغور كنت عهدتها","تزهو سقاها المزن صوب عهاد",72,"د",1,0],["فمعنى انقطاع الأوّلين مسلّم","فألحق به قطع القريب المخلّف",73,"ف",1,0],["فمعنى الحياة كمعنى الممات","إلى حيث كان المصير ادفعي",74,"ع",2,0],["فمع السيادة والسعادة سائرٌ","ومع الكرامة بالسلامة يقدم",75,"م",1,0],["فمعقب سوء الحال حسني وفرحة","وتالي رخاء العيش احدى البوائق",76,"ق",1,0],["فمعهده الباقي على الدهر كاسمه","يد لا تحاكيها يد من أياديك",77,"ك",1,0],["فمَعالِمُ الإسْلامِ بعْدَ عفائِها","في أرْضِ أندَلُسٍ بهِمْ توْطيدُها",78,"د",3,0],["فمعموديَّةٌ لَزَمت لكُلٍّ","وتثبيتٌ وثوبُ الإِعترافِ",79,"ف",1,0],["فمعقلةٍ بالرُّزق فالحبلِ ذي الغضا","فنعفى أريكٍ فالرُّبى فالصرائمِ",80,"م",1,0],["فَمَعقِلَهُم دُكَّ دَكًّا فَيُلقَى","إِلى لُجَّةِ البَحرِ يُمحَقُ مَحقا",81,"ق",2,0],["فَمُعَسكَرُ الاَعداءِ ذاكَ ورُبَّما","في اللَّيلِ أَورى حَربَهُ مُتَمَرِّدا",82,"ا",1,0],["فَمَعِي قد بُعِثتَ لِلحَربِ لَمَّا","رَامَ فِيلا تَؤُّ أَترِيذَا قِدما",83,"ا",1,0],["فَمَعذَرَة يا اِبنَ الأَكارِم اِنَّني","لِذو فِكرَة عَمياء صَلدى المَضارِب",84,"ب",1,0],["فمعذرة مني إليك فإنني","من العجز والتقصير أنسب للفخر",85,"ر",1,0],["فَمعالي أبيهما غررٌ في","جَبهات الدهُور والأزمان",86,"ن",1,0],["فَمَعناهُ مثلُ البَدرِ خَلفَ سَحابَةٍ","سِوى لَمعَةٍ كَالبَرقِ تَبدو فَتبهرُ",87,"ر",1,0],["فمعنى الندى والفضل فيه ممهَّدٌ","وركن العلى والعزِّ فيه ركين",88,"ن",1,0],["فمعاليه للمعالي نفوسٌ","وأياديه للندى أعضاء",89,"ا",2,0],["فمعبدُ عشقي يضجُّ بشوقي","أرتلُ فيه تراتيلَ قلبي",90,"ب",2,0],["فَمَعَاهِدٌ لِلجَهلِ تَنفُثُ سُمَّها","ومَساجدٌ لِعبادَةِ الأَصنامِ",91,"م",1,0],["فمعَ المساءِ لقاؤنا","ومَعَ الضحى يَمضي السَّهَرْ",92,"ر",1,0],["فمعصيةُ الإلهِ تجرُّ ويلاً","وطاعتهُ سبيلٌ للأمانِ",93,"ن",1,0],["فمَعْي تُنْعِيكَ جِبَالُ ندى","كَرَمٌ وَقِنَانٌ لِلْفَخْرِ",94,"ر",1,0],["فمعظم آي الأنبيا أتى بها","وآياتها الصغرى كأعظمها حجما",95,"م",2,0],["فمع القرب ظل يدنو ويدنو","لمكاني كي أستريب فعاله",96,"ل",2,0],["فمع الركب ناقم وجهول","خالفوا العرف في شذوذ الطباع",97,"ع",1,0],["فمعناه في هذا التوسل بالدعا","كما قاله الفاروق من غير ما جحد",98,"د",1,0],["فمعركةٌ تخوض هنا وأخرى","هناك ونصرها المأمول حاضر",99,"ر",1,0],["فمعظم من نهوى على البعد جنّة","فإنْ قُرّبت صارت جحيما نطاعنه",100,"ن",2,0],["فَمَعَ الرَّصاصِ دوتْ حناجرُ وَحشِهِمْ","تكبيرُهمْ بِدَمِ الورى معجونُ",101,"ن",1,0],["فمعانيه لألبابِ الورى","سِحْرةُ النافثِ واللفظُ الشَّمولُ",102,"ل",1,0],["فمع العيْشِ همّة وانطلاق ٌ","ومع الموت تسكنُ الحَرَكاتُ",103,"ت",1,0],["فَمُعَفِّرُ اللَّيثِ الهِزَبر ِبِسَوْطِهِ","مِنّا ، وَنَحْمِلُ سَيْفَهُ المَصْقولا",104,"ل",2,1],["فمعظمُ هذه الأجيالِ (فافي)","ولم تنحتْ من الصخرِ الأغاني!",105,"ن",2,0],["فمعظمُهم يعشق اللاَّ","مبالاة أو قد يبرُّ قليلاً بنا",106,"ن",2,0],["فَمَعدَنُ الرَّجُلِ شَمَائِلهُ","والصَّمتُ فيْهِ الخَيرُ عَنْ كَلِم",107,"م",1,0],["فمعْذِرَةً إن كُنتُ فيهِ مُقصّراً","ولم أرْقَ في نَوحي لِحُزْنِ مشاعِري.",108,"ر",2,0],["فَمَعنىً سَقيمٌ في تَفاهَةِ غايَةٍ","وَلَفظٌ رَكيكٌ في تَخُلُّعِ أَوزانِ",109,"ن",1,0],["فمعذرة إذا ما جاء قولي","يخيب ظن جَدٍ أو حفيد",110,"د",1,0],["فمعفَّرٌ حسدَ الحياة َ وهاربٌ","حسدَ الرُّفات القبر والصفّاحا",111,"ح",2,0],["فمَعْنى الحياةِ إنسٌ","سَعى حامِلًا صَليبَهْ",112,"ب",2,0]]}