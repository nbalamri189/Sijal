{"poems":[[63,"ألمت ودوني رامة فكثيبها","https://www.aldiwan.net/poem46161.html","الطويل"],[100,"يقظة الصحراء","https://www.aldiwan.net/poem23696.html","عموديه"],[77,"تخالف جنس الشوق والحكم واحد","https://www.aldiwan.net/poem35893.html","الطويل"],[86,"من لم ير المعرض في اتساع","https://www.aldiwan.net/poem68848.html","الرجز"],[72,"كيف قاسوا قد الحبيب بغصن","https://www.aldiwan.net/poem20160.html","الخفيف"],[64,"ثلاثة أحرف لا عجم فيها","https://www.aldiwan.net/poem67614.html","الوافر"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[92,"يا رفيقي وأين أنت فقد","https://www.aldiwan.net/poem38907.html","الخفيف"],[78,"ببيض الهند والأسل الحداد","https://www.aldiwan.net/poem14259.html","الوافر"],[89,"اخبث الناس صديق","https://www.aldiwan.net/poem44877.html","مجزوء الرمل"],[49,"بنى معن ويهدمه يزيد","https://www.aldiwan.net/poem64148.html","الوافر"],[66,"هنيئا بشهر الصوم للملك الذي","https://www.aldiwan.net/poem40978.html","الطويل"],[105,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[48,"أربع البلى إن الخشوع لباد","https://www.aldiwan.net/poem62604.html","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"]],"verses":[["فمَعْذِرَةُ الأيامِ مَقْبولَةٌ بِهِمْ","ومَغْفورَةٌ للنّائِباتِ ذُنوبُها",0,"ب",3,0],["فمعاني السلم في ألفاظه","حيل تبتكر الموت الزؤاما",1,"م",2,0],["فمَعْنَى اشْتِياقِ الأرْضِ للغَيْثِ حاجَةٌ","ومَعْنى اشْتِياقِ الغيْثِ للأرْضِ إشْفاقُ",2,"ق",1,0],["فَمَعرِضُ القَومِ بِلا نِزاعِ","في نَفثَةٍ مِن ذَلِكَ اليَراعِ",3,"ع",1,0],["فمعاديه في سوآء جحيمٍ","ومواليه في جنَّات عدنِ",4,"ن",1,0],["فَمَعجومٌ يُشاكِلَ وَأُجديهِ","وَمَتروكٌ يُصَدِّقُهُ الأَنامُ",5,"م",1,0],["فَمُعَقَّرٌ بِثِيابِهِ مُتَكَفِّنٌ","وَمُجَرَّحٌ بِدِمائِهِ مُتَسَربِلُ",6,"ل",1,0],["فمَعِي في جوانحي أَبدَ الدَّهرِ","فؤادٌ إلى الحقيقةِ ظامي",7,"ي",1,0],["فَمَعنى الدَهرِ في قَتلِ الأَعادي","وَحَسمِ رِقابِهِم في كُلِّ وادِ",8,"د",1,0],["فمع المظلوم يبكي","ومع الظالم يضحك",9,"ك",1,0],["فَمَعنٌ كانَ لِلحُسّادِ غَمّاً","وَهَذا قَد يُسَرُّ بِهِ الحَسودُ",10,"د",1,0],["فَمٌ عَن أَحاديثِ المَحارِمِ صائِمٌ","وَكَفٌّ بِإِسداءِ المَكارِمِ مُفطِرُ",11,"ر",1,0],["فمعترك به عين وجيد","ومعترك به ظفر وناب",12,"ب",1,0],["فَمَعْشَرٌ رَكِبُوا الأَوْتادَ فانقطعَتْ","أَمْعاؤُهم فَتَمَنَّوْا أَنَّهمْ نُحِرُوا",13,"ر",3,0],["فَمَعذِرَةً مِنّي إِلَيكَ بِأَن تَرى","رَهينَةَ أَرواحٍ وَصَوبِ غَوادي",14,"ي",1,0],["فَمَعناكَ مَعنى لَيلَةِ القَدرِ إِنَّها","عَلى الناسِ تَخفى وَهيَ في رَمَضانِ",15,"ن",1,0]]}