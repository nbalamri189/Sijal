{"poems":[[32,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[68,"من لصب أدنى البعاد وفاته","https://www.aldiwan.net/poem40641.html","الخفيف"],[76,"ماذا عليك وقد نأيت ديارا","https://www.aldiwan.net/poem12958.html","الكامل"],[48,"تدين مغربي بانتحال","https://www.aldiwan.net/poem23605.html","الوافر"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/142366","الرمل"],[132,"فصم عن نسيب الغواني ولا","https://www.aldiwan.net/poem50508.html","المتقارب"],[146,"هو منزل النجوى بخالي الأعصر","https://www.aldiwan.net/poem58442.html","الكامل"],[147,"حمى النوم أجفان صب وصب","https://www.aldiwan.net/poem11724.html","المتقارب"],[173,"أقيما على حر المدى أو ترحلا","https://www.aldiwan.net/poem1649.html",""],[190,"لمن النوادب ينتدبن سراعا","https://www.aldiwan.net/poem43624.html","الكامل"],[234,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[236,"سقى الله ارض الحمى وابلا","https://www.aldiwan.net/poem44562.html","المتقارب"],[302,"بالفتح والنصر هذا السير والسفر","https://www.aldiwan.net/poem33275.html","البسيط"],[369,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[369,"لأي وميض بارقة أشيم","https://www.aldiwan.net/poem60666.html","الوافر"],[369,"أيا أهدى من الشهب السواري","https://www.aldiwan.net/poem60892.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122721","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66803","الطويل"],[1012,"","https://poetry.dctabudhabi.ae/diwan/poem/132424","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16733","المتقارب"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126606","المجتث"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6769","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79855","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79825","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129839","الطويل"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10420","المنسرح"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133942","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107062","المتقارب"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112628","الرجز"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103570","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94372","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58080","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139754",""],[4836,"أمى","https://www.poetsgate.com/ViewPoem.aspx?id=203611",""],[4929,"جمالك ماله ثاني","https://www.poetsgate.com/ViewPoem.aspx?id=199239",""],[5111,"هَمْزِيَّةُ :الْحَوَّاسِ بري","https://www.poetsgate.com/ViewPoem.aspx?id=212623",""],[5206,"ضاق ذرعي","https://www.poetsgate.com/ViewPoem.aspx?id=148341",""],[5212,"زعيمُ الحوزةِ الكُبرى","https://www.poetsgate.com/ViewPoem.aspx?id=212056",""],[5277,"يا سيّدَ الناس","https://www.poetsgate.com/ViewPoem.aspx?id=188104",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5628,"في المطعم المكسيكي","https://www.poetsgate.com/ViewPoem.aspx?id=178553",""],[5736,"نادمتني .. إلى إحداهن","https://www.poetsgate.com/ViewPoem.aspx?id=208249",""]],"verses":[["فَصَمَّمنَ في دَوِّيَةِ الدَوِّ بَعدَما","لَقينَ الَّتي بَعدَ اللَتَيا مِنَ الضَمرِ",0,"ر",1,0],["فَصَمَت شِدَّةُ الهُمومِ عُرى القَل","بِ وَأَصدى مَرأى العِدى مِرآتَه",1,"ت",2,0],["فَصَمَمتُ عَنهُ وَقَد سَمِعتُ حَمامَةً","فَاِغرَورَقَت عَيني لَها اِستِعبارا",2,"ر",2,0],["فَصَمتاً إِن أَرَدتُم أَو مَقالاً","فَما في هَذِهِ الدُنِّيا تَقِيُّ",3,"ق",2,0],["فصموتاً فلكم جرَّ لك النطق وبالا","واعتزالاً أو يكون الحق حراً فاعتزالا",4,"ل",2,0],["فصم عن نسيبِ الغواني ولا","تخلّط وأعلنْ بمدحِ الإمامْ",5,"م",1,1],["فصَمِمْنَ حتى لاوعت أسماعُها","تَصهالَ رعدٍ في حَبِىٍّ ممطِرِ",6,"ر",1,0],["فَصَمتَ عُرى الإِفكِ في وَقعَةٍ","أَزالَت عَنِ المُستَريبِ الرِيَب",7,"ب",1,0],["فَصُمَّت رِجالٌ عَن دُعائي وَأَحجَمَت","كَمِثلِ بُغاثِ الطَيرِ عايَنَ أَجدَلا",8,"ل",2,0],["فصَميتها من بعد تكريص بها","والصمي توسعه لها إيساعا",9,"ع",2,0],["فصُمْه بالتقوى وبالتهجّد","محتسِبا لله بالتعبّد",10,"د",1,0],["فصم لنا بين أكنافه","حبيب أأهملنا أم رعى",11,"ع",2,0],["فصمِّم العَزمَ فيما قد قصدت له","فَما عليك بجاه المُصطَفى خطرُ",12,"ر",1,0],["فَصُمْ وأفْطِرْ مديدَ العُمْرِ في نِعَمٍ","ما عاوَد النّاسَ في الأيّامِ عِيدان",13,"ن",1,0],["فَصُمْ أُلْفاً وَعيِّدْ في ظلالِ الْس","سعادةِ إذْ تُعيِّدُ أَو تَصوم",14,"م",1,0],["فصُمْهُ وبَعدَهُ أَلْفاً عليه","بإسعادٍ من الفَلَكِ المُدار",15,"ر",1,0],["فَصَميمُ حَمزةَ والرَّسُولِ عُمُومُهُ","وَصَميمُ يَحيى بنِ الحسينِ خَؤولُه",16,"ل",2,0],["فصمَّم آطامَ الذين تهوّدوا","بأرعنَ مّمن يَعبد اللهَ مْوحَمِ",17,"م",1,0],["فصمتي ذكري والسكون تصرفي","ونومي وردي حيث كان المنوما",18,"م",2,0],["فَصَمتاً إِذا شِئتَ إِطرابَنا","فَنَحنُ إِذا قُلتَ لا نَطرَبُ",19,"ب",1,0],["فصمت وجداً والبين مبتسم","ألقاه مني مفرقي بمبتسمي",20,"م",2,0],["فَصَمَتُّ إِلّا عَن تُقىً وَلَرُبَّما","قَذَفَت بِحارُ قَريحَتي بِجَواهِرِ",21,"ر",1,0],["فصم السوار لفعمة من زندها","فكأَنَّما كان الهلال سوارها",22,"ر",3,0],["فصمَّم لا مُستعدياً غيرَ همَّةٍ","تفلّ له العضبَ الجرازَ اليمانيا",23,"ي",2,0],["فصمصام عمرو حين فارقَ كفّهُ","رموهُ ولا ذنبٌ لعجزِ المضاربِ",24,"ب",1,0],["فَصَمَدوا رَأسَ كَبشِ إِخوَتِهِم","حَتّى تَوَلَّوا وَاِستَنفَروا هَرَبا",25,"ب",2,0],["فصمه وحادي عشره بعد تاسع","فهذا كمال واحتياط لمن صبر",26,"ر",1,0],["فصمت مسامع ذاك الجناب","وهل تسمع الصم تسآليه",27,"ي",2,0],["فصمّم القومُ على القتالِ","واقبلوا زَحفاً إلى النزلِ",28,"ل",1,0],["فصمَّم ولا تحجم فأنك صارمٌ","حسامٌ ومنه في يد اللَه قائمُ",29,"م",1,0],["فَصمَ الحشاشةِ قد تعوَّد مُعرضاً","في غنج لحظِ لا بجدِّ قواضبِ",30,"ب",1,0],["فصمتاً وانظروا ما الله يُبْدِي","ويصنعُ في بريَّتِهِ اختراعَا",31,"ع",2,0],["فُصمت عروة الرشاد ولكن","فيه قد أحكم الإله عراه",32,"ا",2,0],["فَصَمتْ عُرَى آمالنا آلامُنا","من بعد لينٍ ذاك مرجِى أصلفُ",33,"ف",1,0],["فصمتي فيك مقروء","وسري مثلُ إعلاني",34,"ن",2,0],["فَصُمُوتُهَا إعْرَابُهَا يُشْدُو الْهَوَى","لَغَةُ النِّسَا ءِ رُمُوزُهَا إيْمَاءُ",35,"ا",2,0],["فصمٌّ وبكمٌ ثم عُميٌّ عن الهدى","بلى همجًا صاروا وسُمْجَ رعاع",36,"ع",1,0],["فَصَمتٌ عَنْ دُعاةِ الشَّرِّ عِلَّتُهُ","لِسانُ العِلْمِ لا يَحْكي مَعَ الخَبَلِ",37,"ل",1,0],["فصمْ نهارَكَ ...ثمَّ الليلَ فامْضِ بِهِ","تُجري صلاتَكَ في داجٍ منَ الغلسِ",38,"س",1,0],["فصمّ الصخرٍ همّته","وبالشدّات قد صلدا",39,"د",2,0],["فصمتُّ ثمّ أجبتُها مُتبسّما ً","سأقولُ ما قالوا ولا أتفاخرُ",40,"ر",1,0],["فصممتِ قلبَك عن حديثِ جوارحي","وبصقتِ في طبقٍ تردى طائعا",41,"ع",2,0]]}