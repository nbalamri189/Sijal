{"poems":[[53,"مجرب أنه إذا نسب","https://www.aldiwan.net/poem8497.html","المنسرح"],[53,"أفطر وأكباد العداة تفطر","https://www.aldiwan.net/poem62877.html","الكامل"],[80,"فيما مضى كنت بالأعياد مسرورا","https://www.aldiwan.net/poem14212.html","البسيط"],[47,"يا أخا الحارث بن كعب بن عمر","https://www.aldiwan.net/poem65660.html","الخفيف"],[46,"الدهر يوم ويوم","https://www.aldiwan.net/poem30111.html","المجتث"],[48,"أفطر وصم وأفطر خائفا","https://www.aldiwan.net/poem22569.html","الكامل"],[80,"فيما مضى كنت بالأعياد مسرورا","https://www.poetsgate.com/ViewPoem.aspx?id=1465",""],[47,"يا أخا الحارِثِ بنِ كَعبِ بنِ عمرو","https://www.poetsgate.com/ViewPoem.aspx?id=32074",""],[48,"أفطِرْ وصُمْ، أو صُمْ وأفطرْ، خائفاً،","https://www.poetsgate.com/ViewPoem.aspx?id=20117",""],[208,"للعيد أوعدني من لم يزل عيدا","https://www.aldiwan.net/poem53320.html","البسيط"],[261,"أوجع دماغا القرع بالسلقِ","https://www.aldiwan.net/poem48457.html","السريع"],[398,"يا قاضيا بات أعمى","https://www.aldiwan.net/poem53565.html","المجتث"],[422,"جسد ذاب نحولا وسقاما","https://www.aldiwan.net/poem53951.html","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80002","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107001","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201543","البسيط"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103799","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111504","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58007","الكامل"],[4785,"صياماً إلى أن يُفطِرَ السيفُ","https://www.poetsgate.com/ViewPoem.aspx?id=129736",""],[5277,"مشاعرٌ موحشة","https://www.poetsgate.com/ViewPoem.aspx?id=192198",""],[5694,"احذر من الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=132101",""]],"verses":[["افْطُنْ لداعيهِ كيف يَنْسبُهُ","في موطنٍ ليس حقَّهُ النّسَبُ",0,"ب",1,0],["أفْطِرْ وأكباد العُداة تفطّرُ","في نعمةٍ تنمي ودنيا تَزهرُ",1,"ر",1,1],["أَفطَرتَ في العيدِ لا عادَت إِساءَتُهُ","فَكانَ فِطرُكَ لِلأكبادِ تَفطيرا",2,"ر",2,0],["أَفطِروا راشِدينَ إِنّي أَعُدُّ ال","فِطرَ في هَجرِ مَن أُحِبُّ أَثاما",3,"م",2,0],["أَفطَرتُ فيهِ وَقَد كا","نَ قَبلَهُ لِيَ صَومُ",4,"م",1,0],["أَفطِر وَصُم وَأَفطِر خائِفاً","صَومُ المَنِيَّةِ لَهُ إِفطارُ",5,"ر",1,1],["أفطرت في العيد لا عادت إساءتُه","ولست يا عيدُ مني اليوم معذورا",6,"ر",2,0],["أفْطِرُوا رَاشِدينَ إنجي أعُدُّ ال","فِطْرَ في هَجْرِ مَنْ أُحِبُّ إثَامَا",7,"م",2,0],["أفطِرْ وصُمْ، أو صُمْ وأفطرْ، خائفاً","، صومُ المنيّةِ ما لهُ إفطار",8,"ر",1,1],["أفطرتُ فطرَين أني لم أزل بفمي","صوم الصدود بصوم الدين معقودا",9,"د",2,0],["افطر من الصوم على فقحةٍ","زبدتها في طرف الزق",10,"ق",1,0],["أَفطَرتَ في رَمضانٍ","وَصمتَ في يَوم عيدِ",11,"د",1,0],["أَفْطَرَ النَّاس جميعاً غيرنا","وبَقينا نحن في النَّاس صياما",12,"م",2,0],["أفطرتِ إلاَّ قلبَ حامية الهدى","وصدعتِ إلاَّ بيضة التوحيد",13,"د",1,0],["افطرت في رمضان لا تخشى من ال","تأنيب في الاخرى ولا في الاولى",14,"ل",2,0],["أفطرت صبحاً على بيتي علاً ونُهىً","صَومي هو الأكل والأشعار إفطاري",15,"ي",1,0],["افطن اذا ابدى الزمان تبالها","واذا تواسن جفنه فاستيفظ",16,"ظ",1,0],["أفطميذٌ وألقميذ أخو العز","م جميعاً عدوا وجازوا البابا",17,"ب",2,0],["أفطرقل مذ سيقت لذا الترب أعظمي","وبعدك لي قد خط أن أنزل اللحدا",18,"د",2,0],["افطِمْ صَبِيَّكَ إنْ مَضَتْ","سنتان تَتْرَى في العددْ",19,"د",1,1],["أَفِطرٌ وأحرار الحمى في مجاعة؟","وعيدٌ وأبطال الجهاد بمأتم؟!",20,"م",1,0],["أفطرتُ وجداً وقد صامتْ جوارحنا","وطفتِ سبعاً وجنبَ الركنِ صليتِ",21,"ت",1,0],["إفطن ترى دنياك لعبة وراعين","لو مدحوها بالأمل والمناوي",22,"ا",3,0]]}