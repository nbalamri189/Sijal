","أحذ الكامل"],[362,"تصرف أحوالي على حكم أيامي","https://www.aldiwan.net/poem60644.html","الطويل"],[374,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[377,"أترى أراك بلا رقيب","https://www.aldiwan.net/poem49250.html","مجزوء الكامل"],[392,"هل لمن يرتجي البقاء خلود","https://www.aldiwan.net/poem3667.html","الخفيف"],[397,"أيا شعب مصر","https://www.aldiwan.net/poem10307.html","عموديه"],[429,"عرضت لمعترض الصباح الأبلج","https://www.aldiwan.net/poem12577.html","الكامل"],[429,"ما زال يخدع قلبه حتى هفا","https://www.aldiwan.net/poem12801.html","الكامل"],[438,"بنفسي رسوم بين نفعي وغرب","https://www.aldiwan.net/poem14331.html","الطويل"],[456,"ما جد السعي أتاه ما سعى له","https://www.aldiwan.net/poem55933.html","الرمل"],[456,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[462,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[462,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[475,"هل بعد وصالك من وطر","https://www.aldiwan.net/poem15256.html","الوافر"],[475,"ومصفر أوراق الغصون وخضرها","https://www.aldiwan.net/poem15319.html","الطويل"],[512,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[513,"خطبتني الخطوب بالهم لما","https://www.aldiwan.net/poem12295.html","الخفيف"],[549,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[549,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[549,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"],[549,"عن الخيال لنا ليالي الأبرق","https://www.aldiwan.net/poem47353.html","الكامل"],[549,"لا در در الحرص والطمع","https://www.aldiwan.net/poem47708.html","أحذ الكامل"],[549,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[565,"عادات طيفك أن يعاود","https://www.aldiwan.net/poem69711.html","مجزوء الكامل"],[565,"نطق الود باللسان الفصيح","https://www.aldiwan.net/poem69741.html","الخفيف"],[573,"يا حيرة الحق لما غيب الهادي","https://www.aldiwan.net/poem2786.html","البسيط"],[573,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"]],"verses":[["وَمُصِرَّةِ الآذانِ تَر","قُبُ وَثبَةً بَعدَ القِيامِ",0,"م",1,0],["وَمَصقولَةِ الأَعطافِ في جَنَباتِها","مِراحٌ لِأَطرافِ العَوالي وَمَلعَبُ",1,"ب",1,0],["وَمُصابُ أَبلَجَ مِن ذُؤابَةِ هاشِمٍ","وَلَجَ القُبورَ وَأَزعَجَ الخُلَفاءَ",2,"ا",2,0],["وَمَصَامِ عِزًّ للنُّجُومِ مُزَاحِمٍ","مَا لاِسْتِبَاحةِ مَا حَوَاهُ سَبِيلُ",3,"ل",1,0],["ومُصَدِّقٌ بصَحيفةِ الخَدِّ الذي","قدْ أعْجَبَ الكُفّارَ حُسْنُ نَباتِهِ",4,"ه",1,0],["وَمَصابِ غادِيَةٍ كَأَنَّ تِجارَها","نَشَرَت عَلَيهِ بُرودَها وَرِحالَها",5,"ل",3,0],["وَ مِصْرُ قَائِمَةٌ غَمّاً وَقَاعِدَةٌ","كَاللُّجِّ يَزْخَرُ وَالأَمْوَاجُ تَلْتَطِمُ",6,"م",1,0],["وَمَصِيرُنَا وَالدَّهْرُ وَالدُّنْيَا مَعاً","فَقْدٌ عَمِيمٌ وَانْحِلالٌ خَاتِمُ",7,"م",1,0],["وَمُصعَدُهُم كَي يَقطَعوا بَطنَ مَنعِجٍ","فَضاقَت بِهِم ذَرعاً خَزازٌ وَعاقِلُ",8,"ل",1,0],["وَمُصَفَّينَ في المَنَاسِبِ مَحضِي","نَ خِضَمِّينَ كالقُرُومِ السَّوَامِي",9,"م",2,0],["وَمُصطَحَباتٍ قارَبَ الرَكضُ بَينَها","وَلَكِن بِها عَن غَيرِها أَبَداً بُعدُ",10,"د",1,0],["ومصنَّفات لستُ عنها راضياً","فمسوَّدٌ منها وغيرُ مسوَّد",11,"د",1,0],["ومصحف باتَ يشكو قلبه أسفاً","مقسَّماً بين أجزاءٍ وأعشار",12,"ر",1,0],["ومصاحب تلقاه عند عيوبه","خلداً بلا بصرٍ به يتبينُ",13,"ن",1,1],["ومُصِّححُ الأضياف يَسلَمُ ضيفُهُ","من كل داءٍ غيرَ داء الذيبِ",14,"ب",1,0],["ومُصابٍ بشقةِ الروحِ مني","ضمَّنَ الجسم سُقْمَه ونحولهْ",15,"ل",2,0],["وَمُصفِقٍ لِلخَمرِ في أَكوابِهِ","طَرَبا وَطَيفُ المَوتِ في الأَكوابِ",16,"ب",1,0],["وَمُصغِيَةٍ خَدَّها بِالزِمام","فَالرَأسُ مِنها لَهُ أَصعَرُ",17,"ر",1,0],["وَمَصنَعَةٍ هُنَيدَ أَعَنتُ فيها","عَلى لَذّاتِها الثَمِلَ المَنينا",18,"ن",2,0],["ومصارع الأيام لا","يبغى من الأيام رفدا",19,"د",2,0],["ومصفدٍ ما داينوه وطالما","دان الرجال فبتن في الأصفاد",20,"د",1,0],["وَمِصرُ بِناءُ جَدِّكَ لَم يُتَمَّم","أَلَيسَ عَلى يَدَيكَ لَهُ تَمامُ",21,"م",1,0],["وَمِصرُ الَّتي تَجمَعُ المُسلِمينَ","كَما اِجتَمَعوا في ظِلالِ الرُكُن",22,"ن",1,0],["وَمُصَرِّفُ الأَحكامِ مَوكولٌ إِلى","حُكمِ المَنِيَّةِ ما لَهُ مِن كافي",23,"ي",1,0],["وَمِصرُ كَالكَرمِ ذي الإِحسانِ فاكِهَةٌ","لِحاضِرينَ وَأَكوابٌ لِبادينا",24,"ن",2,0],["ومصرُ لعمري أهل كلِّ عجيبَةٍ","ولا مثل ذا المخصِيِّ أعجوبَةً نُكرا",25,"ر",2,0],["ومصقولةٌ تُغْشِي العيونَ كأنها","من الشمسِ تُمْهَى أو من الشُهبِ تُطْبَعُ",26,"ع",1,0],["وَمُصيبٌ مَفاصِلَ الرَأيُ إِن حا","رَبَ كانَت آراؤُهُ مِن جُنودِه",27,"د",2,0],["وَمِصعِدٌ في هِضابِ المَجدِ يَطلَعُها","كَأَنَّهُ لِسِكونِ الجَأشِ مُنحَدِرُ",28,"ر",1,0],["ومصومَةٍ إن عايَنتْ عَيْنَ رِيبَةٍ","تُلاحِظُها غَطَّتْ بَناناً ومَعصِما",29,"م",2,0],["ومصبوغَةٍ بالزَّعفرانِ عريضةٍ","كأنَّ على أَعْضائِها منه مِجْسَدا",30,"د",2,0],["وَمُصعَبٌ كانَ لَيثاً دونَهُ حَرَداً","حَتّى تَزَمَّلَ مِنهُ ثَعلَبٌ جَسَدُ",31,"د",1,0],["وَمَصيرُهُ مِن بَعدِ مِرَّتِهِ","بِالناسِ ظُلمَةُ بَيتِ وَحدَتِهِ",32,"ت",2,0],["ومصيخاً إلى غناء السواقي","شاكياتٍ سواخرَ الأقدارِ",33,"ر",1,0],["ومصفقين عَلَت أكفهم","فوّارة فكأنها الزبدُ",34,"د",1,0],["ومصَفَّحِ الأبوابِ تبراً نَظّروا","بالنقش بين شكوله تنظيرا",35,"ر",2,0],["ومصابٍ أصابَ كلّ فؤادٍ","في ابنِ عبد العزيز عبدِ الغني",36,"ي",1,0],["وَمَصونُ العرضِ مَبذولُ الندى","مُعْرِقُ الآباء في مَحْضِ الجُدود",37,"د",1,0],["ومصيبةٌ حَرُّ المصائب عندها","بَرْدٌ بِحُرْقَتِها على الأكبادِ",38,"د",1,0],["ومُصاحبي عضبٌ كأنّ فِرْنَده","نَمْلٌ مصاحبةٌ عليه ذبابا",39,"ب",2,0],["وَمُصَرِّفُ المُلكِ الجَموحِ كَأَنَّهُ","قَد زُمَّ مُصعَبُهُ لَهُ بِزِمامِ",40,"م",1,0],["وَمُصيبٌ شَواكِلُ الأَمرِ فيهِ","مُشكِلاتٌ يُلكِنَّ لُبَّ لَبيبِ",41,"ب",1,0],["وَمَصيفِهِنَّ المُستَظِلِّ بِظِلِّهِ","سِربُ المَها وَرَبيعِهِنَّ الصَيِّبِ",42,"ب",1,0],["وَمَصرَعَ إِخوانٍ كَأَنَّ أَنينَهُم","أَنينُ مُكاكي فارَقَت بَلَداً خِصباً",43,"ب",2,0],["وَمُصابُ الإِفريسِ حينَ عَصى اللَ","هَ وَإِذ صابَ حَينَهُ الجالوتُ",44,"ت",1,0],["وَمُصَرَّعينَ مِنَ الخُما","رِ عَلى السَواعِدِ وَاللِمَم",45,"م",1,0],["وَمُصطَبِحٍ لِلراحِ لَمّا أَدارَها","قَرَنتُ يَدي مِن كَأسِها بِنَديمِ",46,"م",1,0],["وَمِصباحُنا قَمَرٌ مُشرِقٌ","كَتُرسِ اللُجَينِ يَشُقُّ الدُجى",47,"ا",1,0],["ومُصَمِّمٌ لو يَنتحي بلِوائِهِ","رَيْبَ المَنونِ لكان رَيبَ مَنونه",48,"ن",2,0],["وَمُصفَرَّةٍ بِالزَعفَرانِ جُلودُها","إِذا حَلِيَت مِثلَ الهِرَقلِيَّةِ الصُفرِ",49,"ر",1,0],["وَمُصغياتٍ وَقعُها تَقديرُ","قودٍ بَراها النَصُّ وَالتَسييرُ",50,"ر",1,0],["وَمَصامُ الجِيادِ يَمشي بِها الرَأ","سُ الرَأسُ غُدُوّاً كَالعائِدِ الحَمّادِ",51,"د",1,0],["ومُصطبحينَ هَوتْ كأسهم","حُطاماً على الشفةِ الراشفَه",52,"ف",2,0],["ومصوّرٌ لبقُ الخيال يصوغُ من","فنِّ الجمالِ السِّحرَ والإغراءَ",53,"ا",2,0],["ومُصْدِرٍ حين يُعْيِي القَوْمَ مُصدِرُهم","وجَفْنَةٍ عند نحسِ الكوكبِ الشَّبِمِ",54,"م",1,0],["ومَصْنوعاً له فيما أتاهُ","إلى الأمْلاكِ من وِتْرٍ وغَمِّ",55,"م",1,0],["ومصبحا بقفرة ومجهل","وممسيا بربوة ومنهل",56,"ل",1,0],["وَمَصُونَةٍ بِحَيائِهَا وَإِبَائِهَا","سَفَرَتْ بِلاَ لَوْمٍ وَلاَ تَثْرِيبِ",57,"ب",1,0],["وَمِصْرُ فِرْعَوْنَ مِنْ أَوْ","جِ مَجْدِهَا تَتَرَاءَى",58,"ا",2,0],["ومُصَفّقٍ بيدَيهِ قلتُ له اتَّئِد","أو خلّ قلبكَ في الضلوع يُصَفقُ",59,"ق",1,0],["وَمَصقولَةِ الأَطرافِ حُمرٌ كُعوبُها","سَريعٍ إِلى نَفسِ الكَمِيِّ وُرودُها",60,"د",3,0],["وَمُصطَبِحٍ بِتَقبيلِ الحَبيبِ","خَلا مِن كُلِّ واشٍ أَو رَقيبِ",61,"ب",1,1],["وَمِصْرُ تَرْقُُ سَطْراً","لِلْمَوْتِ يَتْلُوهُ سَطْر",62,"ر",1,0],["ومصر بمحييها تتيهُ وتنثني","كما لعبتْ بالعاشقين كَعَاب",63,"ب",1,0],["ومصرُ ليس لها حِصْنٌ ولا وَزَرٌ","إلاّ الغَطاريفَ من أبنائها الصِّيد",64,"د",1,0],["ومصر تصغي وشطها دنف","يكاد للشدو ينحني شجره",65,"ر",2,0],["ومصرُ والنيلُ ماذا اليوْمَ خطبُهما","فقد سَرى بحديثِ النيلِ رُكْبانُ",66,"ن",1,0],["ومصدر حين يعيي القوم مصدرهم","وحَفنة عند نحسِ الكوكبِ الشبمِ",67,"م",1,0],["ومصوِّرٍ فوق الطُّروس تخاله","في الفنِّ وقّادَ القريحةِ مُلهما",68,"م",2,0],["ومصر تَرُدُّ أذى مَنْ يُغِيرُ","عليها، وتَجْلِدُ جَلاَّدها",69,"د",3,0],["ومصرُ ملاذُ العروبة؛ تَحْمِي","حماها، وترعى لها ضادها",69,"د",3,0],["ومصامِ الجياد يمشي بها الرأ","سُ غُدُوًّا كالعَائدِ الْحَمَّادِ",70,"د",1,0],["ومصابٍ أصابَ كلّ فؤادٍ","في ابن عيد العزيز عبد الغني",71,"ي",1,0],["ومصاحبي عضتٌ كأن فِرنْدَه","نملٌ مصاحبة ٌ عليه ذبابا",72,"ب",2,0],["وَمَصون عَلَيهِ غيرة حُسن","حَجبتهُ عَن أَعيُن الأَوهام",73,"م",1,1],["ومُصطَانُ دَمعِى قَد تَدَلَّى صَبَابَةً","بِنَحرِى وَرَاءَت دَمعِىَ المُتَدَلِّيَا",74,"ي",2,0],["ومِصبَاحاً وَحلياً في النَّوَادِى","وعَفَّ بِمَا لِهِم قَشَبَ الكُلُومِ",75,"م",1,0],["ومصرُ بعَوده ازدانت وكلٌّ","أحسَّ من السرِورِ بذَوقِ سكّرْ",76,"ر",1,0],["ومصدر الصدق في الفردوسِ أرخه","ضريح أحمدَ يحوي العلم والأدبا",77,"ب",2,0],["ومصلح بين جدواه وراحته","يسعى ويكَدح في صلح على دَخَلِ",78,"ل",1,0],["ومصباح أهل الله قدوتهم إلى الكمالات","من طيب المئاثر قد سنى",79,"ن",2,0],["ومصيبة عظمت علي","ي فما أقوم بثقلها",80,"ل",3,0],["ومصائب أخرى وأشنع قالها","ما أنت محتاج إلى أن تذكرا",81,"ر",2,0],["وَمُصّورٍ بِالشَمسِ وَهوَ نَظيرُها","أَهدَتهُ صُورَتها بِرَسمِ مِثالِهْ",82,"ه",1,1],["ومُصاحِبي شختُ الغِرارُ مُذَرَّب","للموت في جَنباته هيجان",83,"ن",1,0],["وَمُصلّياً ومسلّماً تسليما","صلّوا عليه وسلّموا تَسليما",84,"م",2,0],["ومصر بالبشر قد ابدى السرور لها","وجها جميلا عليه بالبها خفر",85,"ر",1,0],["ومصباح العلوم لطالبيه","وللآمال مفتاح الرجاء",86,"ا",2,0],["ومصدر المضموم غالباً على","فعالة كذا فعولة جلا",87,"ل",2,0],["ومصدر الأخير كالفعيل","وقد أتى للصوت كالصهيل",87,"ل",1,0],["ومُصاحِبٌ ومُواصِلٌ","ومؤالِفٌ ومساعدُ",88,"د",1,0],["ومصونة حوت البهاء ستورها","سمراء يُطرب وصفها سماري",89,"ر",2,0],["وَمُصَرِّدينَ عَنِ المَآثِرِ ما سَعوا","لِفَضيلَةٍ صُمِّ المَسامِعِ ما دُعوا",90,"ع",3,0],["ومصانعٌ كسَف الضّلالُ صَباحها","فيخالُه الرّائي إليْه مَسَاءَها",91,"ا",3,0],["وَمُصاحِبي من ليس يَحفُرني","ماضي الضَريبة مُرهفُ الحَدِّ",92,"د",1,0],["وَمِصداقَ قَولي ما تَراهُ مُؤَرِّخاً","عَلاءَكَ صَبري أَمجَدَ يَشرَحُ الصَدرا",93,"ر",2,0],["وَمَصقَلَةُ الَّذي أَجدى وَأَعطى","لَهُ مِن مَدِّ عافيهِ وَرود",94,"د",1,0],["ومصير أمشى إليه كما تم","شي وتمشى النمال في الحفرات",95,"ت",1,0],["ومصارع مثّلت دورى راغما","فيها ومسرحها أنا وحطامها",96,"م",3,0],["ومصدر الشعور والالهام","وساعدي في يومي العصيب",97,"ب",1,0],["وَمِصرُ وَالأَبوابُ وَاِختِلافُها","وَمَن إِلى عَزيزِها فيها عَبَر",98,"ر",1,0],["ومُصادِقي رَجُلانِ إنْ عُرِفا","من غُرّةِ الإنْصاف والزَّمَن",99,"ن",1,0],["ومُصْلتةً بالكَفِّ من كُلِّ مُرْهَفٍ","مُصمَّمٍ حَدٍّ في الوقائعِ صَمْصام",100,"م",1,0],["ومصدقُ الأيامِ يجهل كذْبَها","والبدر يحجبه الغمام الأسفع",101,"ع",1,0],["وَمَصير بَدر التَمّ مِن","بَعد الطُلوع إِلى المَغيب",102,"ب",1,0],["ومصير الانام طرا الى ما","صار فيه آباؤهم والجدود",103,"د",1,0],["ومِصرُ الكِنانَةِ تاريخُها","ينابيعُ تُعطي ولا تنْضُبُ",104,"ب",1,0],["ومُصيبُ سهمِ الظّنّ يُشرقُ رأيُه","في حيثُ نورُ الشمسِ لم يتوهّجِ",105,"ج",1,0],["ومصرِّفُ الأحكامِ لم يعلَقْ بها","طيشُ الضّجورِ ولا اختلالُ المُحرَجِ",105,"ج",1,0],["ومصرّفُ الرمحِ الطويلِ سنانُه","فتخالُه قلماً هناكَ محرِّفا",106,"ف",2,0],["ومصفن أفراس ومبرك هجمة","وشاوٍ داودي وناد وملعب",107,"ب",1,0],["ومصيخان على نائية","بخفيّ الجَرْسِ حتى يوضِحا لَهْ",108,"ل",2,0],["ومصونةٍ منهنّ قد أعجلتُها","لك لم تكن لولا هواك لتُبذَلا",109,"ل",2,0],["ومصائبٌ متحكِّماتٌ ليس لي","مَعهنَّ في بيع النفوس خِيارُ",110,"ر",1,0],["ومصارماً باع المودة مرخصاً","مني وحقُّ مودتي أتن تشتري",111,"ر",2,0],["ومصباح دين الله بين عبادهِ","ولولاهُ أعيا حلّها وحرامها",112,"م",3,0],["ومصيرُ دمِ العشاقِ متى","طُلَّتْ في الحبِّ إلى الهَدَرِ",113,"ر",1,0],["ومصفرَّ أوراقِ الغصونِ وخضرِها","لعينيكَ في فصلِ الخريفِ تروقُ",114,"ق",1,1],["ومصرعُ أسرى موثَقينَ قُلوبُهم","بحَومَتِه أضحتْ مع الطّيرِ حُوَّما",115,"م",2,0],["ومصاباً على مصاب وثكلا","بعد ثكل أصيب منه جناني",116,"ي",1,0],["وَمُصيبةٍ غطّتْ عليَّ بَصيرَتي","ورمتْ ضياءَ جوانحي بظلامِ",117,"م",1,0],["ومصيبةٍ ليلي وقد ساوَرْتُها","ليلُ اللّديغِ بها ويومي أيْوَمُ",118,"م",1,0],["ومصيبةٍ وَلَجَتْ على ملك الورى","أبوابَه والذّائدون نيامُ",119,"م",1,0],["ومصرّعين من الكلال كأنّهمْ","صبحوا وما صبحوا بكلّ مروَّقِ",120,"ق",1,0],["ومصارعُ الأحياءِ كلِّهِمُ","في الدّهرِ بين الرِّيّ والشِّبَعِ",121,"ع",1,0],["ومصيبةٍ وَلَجَتْ على سُرُجِ الهدى","آلِ النبيّ حفائرَ الأرْماسِ",122,"س",1,0],["وَم