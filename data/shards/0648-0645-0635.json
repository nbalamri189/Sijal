{"poems":[[53,"أترى ديار الحي بال","https://www.aldiwan.net/poem29794.html","مجزوء الكامل"],[53,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[53,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[77,"السعد جندك والقضاء دليل","https://www.aldiwan.net/poem36373.html","الكامل"],[77,"أنا كافر وسواي فيه بعاذل","https://www.aldiwan.net/poem36690.html","الكامل"],[9,"رحلت سمية غدوة أجمالها","https://www.aldiwan.net/poem21970.html","الكامل"],[93,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[93,"لو كان مما ربك عاصم","https://www.aldiwan.net/poem11333.html","الكامل"],[4,"ألا تسألان المرء ماذا يحاول","https://www.aldiwan.net/poem21189.html","الطويل"],[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[47,"دعوناك والهجران دونك دعوة","https://www.aldiwan.net/poem25306.html","الطويل"],[72,"أهلا بها صحف الإمام المسند","https://www.aldiwan.net/poem18563.html","الكامل"],[72,"لو لم تفه برثاء فيك أشعاري","https://www.aldiwan.net/poem18718.html","البسيط"],[72,"ومصاحب تلقاه عند عيوبه","https://www.aldiwan.net/poem20341.html","الكامل"],[51,"ما كنت في بخس الجزاء بمشبه","https://www.aldiwan.net/poem8510.html","الكامل"],[51,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[91,"من أين جئت وكيف عجت ببابي","https://www.aldiwan.net/poem8751.html","عموديه"],[38,"تغير قومي ولا أسخر","https://www.aldiwan.net/poem7712.html","المتقارب"],[38,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[89,"في الصدر حتى كدت تردى","https://www.aldiwan.net/poem44868.html","مجزوء الكامل"],[85,"أكذا تقر البيض في الأغماد","https://www.aldiwan.net/poem7131.html","الكامل"],[85,"بأرض الجيزة اجتاز الغمام","https://www.aldiwan.net/poem8084.html","الوافر"],[85,"مضى الدهر بابن إمام اليمن","https://www.aldiwan.net/poem8111.html","المتقارب"],[85,"أجل وإن طال الزمان موافي","https://www.aldiwan.net/poem62840.html","الكامل"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[43,"أفيقا خمار الهم نغصني الخمرا","https://www.aldiwan.net/poem10630.html","الطويل"],[62,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[45,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[45,"وواعظ منه لولا أنه حجر","https://www.aldiwan.net/poem63596.html","البسيط"],[61,"هم صرموا حبل الهوى فتصرما","https://www.aldiwan.net/poem51445.html","الطويل"],[61,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[58,"ألله حي قديم قادر صمد","https://www.aldiwan.net/poem31103.html","البسيط"],[49,"المرء في تأخير مدته","https://www.aldiwan.net/poem62014.html","الطويل"],[97,"تحت عين الصباح والأنوار","https://www.aldiwan.net/poem24747.html","الخفيف"],[97,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[80,"واعمر بقصر الملك ناديك الذي","https://www.aldiwan.net/poem31233.html","الكامل"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[80,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[80,"ودجنة كالنقس صب على الثرى","https://www.aldiwan.net/poem31573.html","الكامل"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[44,"أي مرعى عين ووادي نسيب","https://www.aldiwan.net/poem30586.html","الخفيف"],[44,"أحسن بأيام العقيق وأطيب","https://www.aldiwan.net/poem30589.html","الكامل"],[31,"أرقت ولم يمس الذي أشتهى قربا","https://www.aldiwan.net/poem42629.html","الطويل"],[17,"نطفة ما منيت يوم منيت","https://www.aldiwan.net/poem1193.html",""],[52,"مولاي أجود من حكم","https://www.aldiwan.net/poem26684.html","مجزوء الكامل"],[52,"قضى وطرا من لذة ونعيم","https://www.aldiwan.net/poem26690.html","الطويل"],[52,"وسارية لا تمل البكا","https://www.aldiwan.net/poem27320.html","المتقارب"],[75,"متهلل والبدر فوق جبينه","https://www.aldiwan.net/poem69030.html","الكامل"],[50,"تجاللت عن فهر وعن جارتي فهر","https://www.aldiwan.net/poem63803.html","الطويل"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[50,"حال حب الذلفاء دون الرقاد","https://www.aldiwan.net/poem63901.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39558","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39584","الكامل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72225","البسيط"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72226","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54564","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142006","الكامل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9042","الطويل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8890","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54290","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[36,"ياعينُ بَكّي بدَمْعٍ دائِمِ السَّجمِ","https://www.poetsgate.com/ViewPoem.aspx?id=15888",""],[106,"خيال في يقظة","https://www.poetsgate.com/ViewPoem.aspx?id=179676",""],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[50,"حال حبُّ الذَّلفاء دون الرُّقاد","https://www.poetsgate.com/ViewPoem.aspx?id=21808",""],[80,"هل أقالَ الحِمامُ عثرة حيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=3730",""],[80,"ودجنة ٍ كالنِّفس صُبّ على الثرى","https://www.poetsgate.com/ViewPoem.aspx?id=2985",""]],"verses":[["وَمُصِرَّةِ الآذانِ تَر","قُبُ وَثبَةً بَعدَ القِيامِ",0,"م",1,0],["وَمَصقولَةِ الأَعطافِ في جَنَباتِها","مِراحٌ لِأَطرافِ العَوالي وَمَلعَبُ",1,"ب",1,0],["وَمُصابُ أَبلَجَ مِن ذُؤابَةِ هاشِمٍ","وَلَجَ القُبورَ وَأَزعَجَ الخُلَفاءَ",2,"ا",2,0],["وَمَصَامِ عِزًّ للنُّجُومِ مُزَاحِمٍ","مَا لاِسْتِبَاحةِ مَا حَوَاهُ سَبِيلُ",3,"ل",1,0],["ومُصَدِّقٌ بصَحيفةِ الخَدِّ الذي","قدْ أعْجَبَ الكُفّارَ حُسْنُ نَباتِهِ",4,"ه",1,0],["وَمَصابِ غادِيَةٍ كَأَنَّ تِجارَها","نَشَرَت عَلَيهِ بُرودَها وَرِحالَها",5,"ل",3,0],["وَ مِصْرُ قَائِمَةٌ غَمّاً وَقَاعِدَةٌ","كَاللُّجِّ يَزْخَرُ وَالأَمْوَاجُ تَلْتَطِمُ",6,"م",1,0],["وَمَصِيرُنَا وَالدَّهْرُ وَالدُّنْيَا مَعاً","فَقْدٌ عَمِيمٌ وَانْحِلالٌ خَاتِمُ",7,"م",1,0],["وَمُصعَدُهُم كَي يَقطَعوا بَطنَ مَنعِجٍ","فَضاقَت بِهِم ذَرعاً خَزازٌ وَعاقِلُ",8,"ل",1,0],["وَمُصَفَّينَ في المَنَاسِبِ مَحضِي","نَ خِضَمِّينَ كالقُرُومِ السَّوَامِي",9,"م",2,0],["وَمُصطَحَباتٍ قارَبَ الرَكضُ بَينَها","وَلَكِن بِها عَن غَيرِها أَبَداً بُعدُ",10,"د",1,0],["ومصنَّفات لستُ عنها راضياً","فمسوَّدٌ منها وغيرُ مسوَّد",11,"د",1,0],["ومصحف باتَ يشكو قلبه أسفاً","مقسَّماً بين أجزاءٍ وأعشار",12,"ر",1,0],["ومصاحب تلقاه عند عيوبه","خلداً بلا بصرٍ به يتبينُ",13,"ن",1,1],["ومُصِّححُ الأضياف يَسلَمُ ضيفُهُ","من كل داءٍ غيرَ داء الذيبِ",14,"ب",1,0],["ومُصابٍ بشقةِ الروحِ مني","ضمَّنَ الجسم سُقْمَه ونحولهْ",15,"ل",2,0],["وَمُصفِقٍ لِلخَمرِ في أَكوابِهِ","طَرَبا وَطَيفُ المَوتِ في الأَكوابِ",16,"ب",1,0],["وَمُصغِيَةٍ خَدَّها بِالزِمام","فَالرَأسُ مِنها لَهُ أَصعَرُ",17,"ر",1,0],["وَمَصنَعَةٍ هُنَيدَ أَعَنتُ فيها","عَلى لَذّاتِها الثَمِلَ المَنينا",18,"ن",2,0],["ومصارع الأيام لا","يبغى من الأيام رفدا",19,"د",2,0],["ومصفدٍ ما داينوه وطالما","دان الرجال فبتن في الأصفاد",20,"د",1,0],["وَمِصرُ بِناءُ جَدِّكَ لَم يُتَمَّم","أَلَيسَ عَلى يَدَيكَ لَهُ تَمامُ",21,"م",1,0],["وَمِصرُ الَّتي تَجمَعُ المُسلِمينَ","كَما اِجتَمَعوا في ظِلالِ الرُكُن",22,"ن",1,0],["وَمُصَرِّفُ الأَحكامِ مَوكولٌ إِلى","حُكمِ المَنِيَّةِ ما لَهُ مِن كافي",23,"ي",1,0],["وَمِصرُ كَالكَرمِ ذي الإِحسانِ فاكِهَةٌ","لِحاضِرينَ وَأَكوابٌ لِبادينا",24,"ن",2,0],["ومصرُ لعمري أهل كلِّ عجيبَةٍ","ولا مثل ذا المخصِيِّ أعجوبَةً نُكرا",25,"ر",2,0],["ومصقولةٌ تُغْشِي العيونَ كأنها","من الشمسِ تُمْهَى أو من الشُهبِ تُطْبَعُ",26,"ع",1,0],["وَمُصيبٌ مَفاصِلَ الرَأيُ إِن حا","رَبَ كانَت آراؤُهُ مِن جُنودِه",27,"د",2,0],["وَمِصعِدٌ في هِضابِ المَجدِ يَطلَعُها","كَأَنَّهُ لِسِكونِ الجَأشِ مُنحَدِرُ",28,"ر",1,0],["ومصومَةٍ إن عايَنتْ عَيْنَ رِيبَةٍ","تُلاحِظُها غَطَّتْ بَناناً ومَعصِما",29,"م",2,0],["ومصبوغَةٍ بالزَّعفرانِ عريضةٍ","كأنَّ على أَعْضائِها منه مِجْسَدا",30,"د",2,0],["وَمُصعَبٌ كانَ لَيثاً دونَهُ حَرَداً","حَتّى تَزَمَّلَ مِنهُ ثَعلَبٌ جَسَدُ",31,"د",1,0],["وَمَصيرُهُ مِن بَعدِ مِرَّتِهِ","بِالناسِ ظُلمَةُ بَيتِ وَحدَتِهِ",32,"ت",2,0],["ومصيخاً إلى غناء السواقي","شاكياتٍ سواخرَ الأقدارِ",33,"ر",1,0],["ومصفقين عَلَت أكفهم","فوّارة فكأنها الزبدُ",34,"د",1,0],["ومصَفَّحِ الأبوابِ تبراً نَظّروا","بالنقش بين شكوله تنظيرا",35,"ر",2,0],["ومصابٍ أصابَ كلّ فؤادٍ","في ابنِ عبد العزيز عبدِ الغني",36,"ي",1,0],["وَمَصونُ العرضِ مَبذولُ الندى","مُعْرِقُ الآباء في مَحْضِ الجُدود",37,"د",1,0],["ومصيبةٌ حَرُّ المصائب عندها","بَرْدٌ بِحُرْقَتِها على الأكبادِ",38,"د",1,0],["ومُصاحبي عضبٌ كأنّ فِرْنَده","نَمْلٌ مصاحبةٌ عليه ذبابا",39,"ب",2,0],["وَمُصَرِّفُ المُلكِ الجَموحِ كَأَنَّهُ","قَد زُمَّ مُصعَبُهُ لَهُ بِزِمامِ",40,"م",1,0],["وَمُصيبٌ شَواكِلُ الأَمرِ فيهِ","مُشكِلاتٌ يُلكِنَّ لُبَّ لَبيبِ",41,"ب",1,0],["وَمَصيفِهِنَّ المُستَظِلِّ بِظِلِّهِ","سِربُ المَها وَرَبيعِهِنَّ الصَيِّبِ",42,"ب",1,0],["وَمَصرَعَ إِخوانٍ كَأَنَّ أَنينَهُم","أَنينُ مُكاكي فارَقَت بَلَداً خِصباً",43,"ب",2,0],["وَمُصابُ الإِفريسِ حينَ عَصى اللَ","هَ وَإِذ صابَ حَينَهُ الجالوتُ",44,"ت",1,0],["وَمُصَرَّعينَ مِنَ الخُما","رِ عَلى السَواعِدِ وَاللِمَم",45,"م",1,0],["وَمُصطَبِحٍ لِلراحِ لَمّا أَدارَها","قَرَنتُ يَدي مِن كَأسِها بِنَديمِ",46,"م",1,0],["وَمِصباحُنا قَمَرٌ مُشرِقٌ","كَتُرسِ اللُجَينِ يَشُقُّ الدُجى",47,"ا",1,0],["ومُصَمِّمٌ لو يَنتحي بلِوائِهِ","رَيْبَ المَنونِ لكان رَيبَ مَنونه",48,"ن",2,0],["وَمُصفَرَّةٍ بِالزَعفَرانِ جُلودُها","إِذا حَلِيَت مِثلَ الهِرَقلِيَّةِ الصُفرِ",49,"ر",1,0],["وَمُصغياتٍ وَقعُها تَقديرُ","قودٍ بَراها النَصُّ وَالتَسييرُ",50,"ر",1,0],["وَمَصامُ الجِيادِ يَمشي بِها الرَأ","سُ الرَأسُ غُدُوّاً كَالعائِدِ الحَمّادِ",51,"د",1,0],["ومُصطبحينَ هَوتْ كأسهم","حُطاماً على الشفةِ الراشفَه",52,"ف",2,0],["ومصوّرٌ لبقُ الخيال يصوغُ من","فنِّ الجمالِ السِّحرَ والإغراءَ",53,"ا",2,0],["ومُصْدِرٍ حين يُعْيِي القَوْمَ مُصدِرُهم","وجَفْنَةٍ عند نحسِ الكوكبِ الشَّبِمِ",54,"م",1,0],["ومَصْنوعاً له فيما أتاهُ","إلى الأمْلاكِ من وِتْرٍ وغَمِّ",55,"م",1,0],["ومصبحا بقفرة ومجهل","وممسيا بربوة ومنهل",56,"ل",1,0],["وَمَصُونَةٍ بِحَيائِهَا وَإِبَائِهَا","سَفَرَتْ بِلاَ لَوْمٍ وَلاَ تَثْرِيبِ",57,"ب",1,0],["وَمِصْرُ فِرْعَوْنَ مِنْ أَوْ","جِ مَجْدِهَا تَتَرَاءَى",58,"ا",2,0],["ومُصَفّقٍ بيدَيهِ قلتُ له اتَّئِد","أو خلّ قلبكَ في الضلوع يُصَفقُ",59,"ق",1,0],["وَمَصقولَةِ الأَطرافِ حُمرٌ كُعوبُها","سَريعٍ إِلى نَفسِ الكَمِيِّ وُرودُها",60,"د",3,0],["وَمُصطَبِحٍ بِتَقبيلِ الحَبيبِ","خَلا مِن كُلِّ واشٍ أَو رَقيبِ",61,"ب",1,1],["وَمِصْرُ تَرْقُُ سَطْراً","لِلْمَوْتِ يَتْلُوهُ سَطْر",62,"ر",1,0],["ومصر بمحييها تتيهُ وتنثني","كما لعبتْ بالعاشقين كَعَاب",63,"ب",1,0],["ومصرُ ليس لها حِصْنٌ ولا وَزَرٌ","إلاّ الغَطاريفَ من أبنائها الصِّيد",64,"د",1,0],["ومصر تصغي وشطها دنف","يكاد للشدو ينحني شجره",65,"ر",2,0],["ومصرُ والنيلُ ماذا اليوْمَ خطبُهما","فقد سَرى بحديثِ النيلِ رُكْبانُ",66,"ن",1,0],["ومصدر حين يعيي القوم مصدرهم","وحَفنة عند نحسِ الكوكبِ الشبمِ",67,"م",1,0],["ومصوِّرٍ فوق الطُّروس تخاله","في الفنِّ وقّادَ القريحةِ مُلهما",68,"م",2,0],["ومصر تَرُدُّ أذى مَنْ يُغِيرُ","عليها، وتَجْلِدُ جَلاَّدها",69,"د",3,0],["ومصرُ ملاذُ العروبة؛ تَحْمِي","حماها، وترعى لها ضادها",69,"د",3,0],["ومصامِ الجياد يمشي بها الرأ","سُ غُدُوًّا كالعَائدِ الْحَمَّادِ",70,"د",1,0],["ومصابٍ أصابَ كلّ فؤادٍ","في ابن عيد العزيز عبد الغني",71,"ي",1,0],["ومصاحبي عضتٌ كأن فِرنْدَه","نملٌ مصاحبة ٌ عليه ذبابا",72,"ب",2,0]]}