{"poems":[[55,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[93,"تلك المازل كيف حال مقيمها","https://www.aldiwan.net/poem62713.html","عموديه"],[64,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[46,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[76,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[202,"بأي نعي صبحتنا الركائب","https://www.aldiwan.net/poem51977.html","الطويل"],[409,"وافى نظامك أيها الفذ الذي","https://www.aldiwan.net/poem33613.html","الكامل"],[447,"عزاء فما كل حي بباق","https://www.aldiwan.net/poem14464.html","المتقارب"],[520,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64195","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59652","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59112","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80010","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49546","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53191","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105019","الخفيف"],[2621,"","https://poetry.dctabudhabi.ae/diwan/poem/199847","الوافر"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100514","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54480","الرمل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135132","المجتث"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81697","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28618","الرجز"],[307,"جاهدتُ دهري للحروف وصولا","https://www.poetsgate.com/ViewPoem.aspx?id=213776",""],[6213,"أرض ونجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76296&r=&rc=44",""]],"verses":[["وَهِضاباً تُزلِقُ الطَر","فَ وَأَطواداً زَليقَه",0,"ق",2,0],["وَهِضابِها يَلبَسنَ عَسجَدَ شَمسِها","حيناً وَأَحياناً لُجَينَ نُجومِها",1,"م",3,0],["وهَضْبٌ كأجيادِ الكواعبِ أتلَحٌ","وبانٌ كأجفانِ المحبِّينَ مهضوبُ",2,"ب",1,0],["وَهَضبِ عِزٍّ تَجري السَماحَةُ في","حَدورِهِ وَالإِباءُ في صُعُدِه",3,"د",2,0],["وَهَضبَتُهُ أَحمى جَناباً لِخائِفٍ","وَأَبطَحُهُ أَندى مُراداً وَأَمرَعُ",4,"ع",1,0],["وهَضبةِ حلمٍ منْ شمارخها النُّهى","وزهرةِ مجدٍ من رُباها المناقب",5,"ب",1,0],["وهضمت رتبتك التي حليتها","في العلم إذا أدركته بحقائقه",6,"ق",2,0],["وهضبة حلم تلوذ الليالي","حمول لأثقال فوق المطاق",7,"ق",1,0],["وهضبة عزه والطود ينأى","عليك صعوده بين الهضاب",8,"ب",1,0],["وهضيم الحشا يجولُ وشاحا","ه وَيُشجي الردفين منه الإزار",9,"ر",1,1],["وهضمت حق المجد وهو ممنع","ورضيتُ قتلي أن رضيتَ بذلك",10,"ك",1,0],["وَهَضِيمَةِ الكَشْحَيْنِ هَزّ قَوَامُهَا","مَا لَمْ يَهُزَّ الأسْمَرُ المُرَّانُ",11,"ن",1,0],["وهضبة حلمٍ لو وزنت به الورى","وجدتهم في جنبه كلَّهم ذرَّا",12,"ر",2,0],["وَهَضْبَةٌ طالما لاذُوا بجانبها","فما لهمْ لم يقولوا مَعْقِلٌ أشِبُ",13,"ب",1,0],["وهضاب حلمك راسيات دونها","رضوى وهضب مَتَالِعٍ ويَلَمْلَمُ",14,"م",1,0],["وهضيم الكشحين ما قام إلا","جذبته أردافه للقعود",15,"د",1,0],["وهضمك فاصلحنه فهو أصل","وأسهل بالإبارج كل عام",16,"م",1,0],["وهضاب زانها حصباؤها","مثلما زينت الشهب سماها",17,"ا",3,0],["وهضيمُ الكَشْحِ في حبّي له","لم يَزدْني كاشحي إلاَّ اهتضاما",18,"م",2,0],["وهضبة في المعاني","أزرت بكل الجبال",19,"ل",1,0],["وهضبةٍ من هضابِ الحلم راجحةٍ","وروضةٍ من رياضِ العلم مِعطار",20,"ر",1,0],["وَهَضْبَةُ الدِّينِ وَأَنصارُ الهُدى","وَعِصْمَةُ الحَقِّ وَفُرسانُ الفُلَلْ",21,"ل",1,0],["وهضمْتُ من خيرِ المعارفِ كتْفها","وملأتُ أركانَ البحوثِ دليلا",22,"ل",2,0],["وهضابها فيها غروبٌ شيِّقُ","وشروقها سِحْرٌ رقيقٌ بارعُ",23,"ع",1,0]]}