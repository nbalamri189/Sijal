{"poems":[[53,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[91,"تلك المازل كيف حال مقيمها","https://www.aldiwan.net/poem62713.html","عموديه"],[62,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[44,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[74,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[196,"بأي نعي صبحتنا الركائب","https://www.aldiwan.net/poem51977.html","الطويل"],[400,"وافى نظامك أيها الفذ الذي","https://www.aldiwan.net/poem33613.html","الكامل"],[438,"عزاء فما كل حي بباق","https://www.aldiwan.net/poem14464.html","المتقارب"],[513,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"]],"verses":[["وَهِضاباً تُزلِقُ الطَر","فَ وَأَطواداً زَليقَه",0,"ق",2,0],["وَهِضابِها يَلبَسنَ عَسجَدَ شَمسِها","حيناً وَأَحياناً لُجَينَ نُجومِها",1,"م",3,0],["وهَضْبٌ كأجيادِ الكواعبِ أتلَحٌ","وبانٌ كأجفانِ المحبِّينَ مهضوبُ",2,"ب",1,0],["وَهَضبِ عِزٍّ تَجري السَماحَةُ في","حَدورِهِ وَالإِباءُ في صُعُدِه",3,"د",2,0],["وَهَضبَتُهُ أَحمى جَناباً لِخائِفٍ","وَأَبطَحُهُ أَندى مُراداً وَأَمرَعُ",4,"ع",1,0],["وهَضبةِ حلمٍ منْ شمارخها النُّهى","وزهرةِ مجدٍ من رُباها المناقب",5,"ب",1,0],["وهضمت رتبتك التي حليتها","في العلم إذا أدركته بحقائقه",6,"ق",2,0],["وهضبة حلم تلوذ الليالي","حمول لأثقال فوق المطاق",7,"ق",1,0],["وهضبة عزه والطود ينأى","عليك صعوده بين الهضاب",8,"ب",1,0]]}