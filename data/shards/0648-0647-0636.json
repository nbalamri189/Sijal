{"poems":[[53,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[91,"تلك المازل كيف حال مقيمها","https://www.aldiwan.net/poem62713.html","عموديه"],[62,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[44,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[74,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"]],"verses":[["وَهِضاباً تُزلِقُ الطَر","فَ وَأَطواداً زَليقَه",0,"ق",2,0],["وَهِضابِها يَلبَسنَ عَسجَدَ شَمسِها","حيناً وَأَحياناً لُجَينَ نُجومِها",1,"م",3,0],["وهَضْبٌ كأجيادِ الكواعبِ أتلَحٌ","وبانٌ كأجفانِ المحبِّينَ مهضوبُ",2,"ب",1,0],["وَهَضبِ عِزٍّ تَجري السَماحَةُ في","حَدورِهِ وَالإِباءُ في صُعُدِه",3,"د",2,0],["وَهَضبَتُهُ أَحمى جَناباً لِخائِفٍ","وَأَبطَحُهُ أَندى مُراداً وَأَمرَعُ",4,"ع",1,0]]}