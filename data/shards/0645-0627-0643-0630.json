{"poems":[[53,"كم نسام الأذى كأنا كلاب","https://www.aldiwan.net/poem8534.html","الخفيف"],[101,"الشقيقتان","https://www.aldiwan.net/poem6547.html","عموديه"],[51,"كأنني بالديار قد خربت","https://www.aldiwan.net/poem10390.html","المنسرح"],[52,"أرسلت خلتي من الدمع غربا","https://www.aldiwan.net/poem64795.html","الخفيف"],[137,"فتح مبين جل أن يتخيلا","https://www.aldiwan.net/poem4220.html","الكامل"],[137,"ببسيط العالم تعتضد","https://www.aldiwan.net/poem4239.html","المتدارك"],[230,"نحن لله ما لحي بقاء","https://www.aldiwan.net/poem55098.html","الخفيف"],[371,"ما كذب العاذل لا بل قد صدق","https://www.aldiwan.net/poem17043.html","الرجز"],[376,"إنلها من لوعة شانا","https://www.aldiwan.net/poem57074.html","البسيط"],[376,"من لطول الهم والحزن","https://www.aldiwan.net/poem57098.html","المديد"],[385,"أخلق الدار بالعقيق الدثور","https://www.aldiwan.net/poem49208.html","الخفيف"],[406,"حداء على أسطول الحرية","https://www.aldiwan.net/poem6743.html","عموديه"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54028","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144180","المديد"],[2853,"","https://poetry.dctabudhabi.ae/diwan/poem/102465","الرمل"],[3264,"","https://poetry.dctabudhabi.ae/diwan/poem/198457","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91637","الرمل"],[5518,"سِدرةُ المنتهَى","https://www.poetsgate.com/ViewPoem.aspx?id=206241",""],[5561,"هو خيرةٌ من خيرةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193807",""]],"verses":[["ما كذا يفعل الكرامُ ولا تَرْ","ضى بهذا في مثليَ الآدابُ",0,"ب",1,0],["ما كذبت الله .. فيما أدعي","كاد أن يهجر قلبي موضعة",1,"ع",2,0],["ما كَذَّبَتني عَينٌ رَأَيتُ بِها ال","أَمواتَ وَالعَينُ رُبَّما كَذَبَت",2,"ت",1,0],["ما كَذا يَصنَعُ المُحِبُّ فَقَرّي","أَينَ مِنّا مَن لا يُقارِفُ ذَنبا",3,"ب",2,0],["ما كذبت حملاتهم لكن رسا","قدامها أهلُ البصائِرِ أجبلا",4,"ل",2,0],["ما كذبَ فيكَ فِراسَتَهُ","ملكٌ للعالمِ منتقدُ",5,"د",1,0],["ما كذا عَهدُنا بِعزِّكَ تَرمي","هِ اللَيالي أو يَعتَريهِ انقِضاء",6,"ا",2,0],["ما كَذَبَ العاذِلُ لا بَل قَد صَدَقْ","كُلُّ جَديدِ الحُسنِ ذو عَهدٍ خَلَقْ",7,"ق",1,1],["ما كذَبَ الظنُّ الذي قادَني","إلى ابنِ قسَّامٍ ولا خانا",8,"ن",2,0],["ما كَذا كانَ الكِرامُ فسِر","لا عَلى حَدٍّ ولا سَنَنِ",9,"ن",1,0],["ما كَذا كانَ في عُهودك ظَني","وَعُهود الظَبي الغَرير غُرورُ",10,"ر",1,0],["ماكذبنا في الذي قلنا لكم","إنما أنتم علينا تكذبون",11,"ن",1,0],["ما كذا يفعلُ الأخلاّءُ أصلاً","يا أصِيلاً زَكَا له طِيبُ أصلِ",12,"ل",1,0],["ما كذا ترنو ضباءُ الأجرعِ","والغواني تَدَّعي السحرَ وما",13,"م",2,0],["ما كذا يا من ألِفتُهُمُ","تهجُرُ الأحبابُ من ألِفوا",14,"ف",3,1],["ما كذَبَ القَلبُ عنّي","إذا باح بلِقاها",15,"ا",3,0],["ما كذا يعمل الكرام ولكن","قد جرى على المعود دهري",16,"ي",1,0],["ما كذا عهدي وَلا عهد به","جلّ من أَنساه ذكري وَابتلان",17,"ن",1,0],["ما كذَّبوكَ ولكنْ بالهُدَى جحَدوا","كذاك يحجَدُ أهلَ الفضلِ باغيها",18,"ي",3,0],["ما كذّبوا ألاّ ضمائرَهُم فهمْ","خسروا اليقينَ وأنكروا آياتيا",19,"ي",2,0]]}