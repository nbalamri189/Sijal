ياة دروب","https://www.poetsgate.com/ViewPoem.aspx?id=163960",""],[4728,"آه من قلبٍ على الضيق محدي","https://www.poetsgate.com/ViewPoem.aspx?id=176989",""],[4755,"أَشعَلُوكَ وما انطَفَأُوا","https://www.poetsgate.com/ViewPoem.aspx?id=186835",""],[4927,"تهنئة","https://www.poetsgate.com/ViewPoem.aspx?id=29625",""],[5038,"يا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=190197",""],[5145,"سربٌ يسامي الفرقدين بناؤه","https://www.poetsgate.com/ViewPoem.aspx?id=108207",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5273,"باب الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=59634",""],[5273,"أرق الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=178287",""],[5273,"وساوس شعرية","https://www.poetsgate.com/ViewPoem.aspx?id=180052",""],[5277,"شظايا الذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=185998",""],[5307,"مرحبا يا حي فضل الله","https://www.poetsgate.com/ViewPoem.aspx?id=10545",""],[5358,"نطقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=201485",""],[5376,"يا دارُ عودُ الوردِ لمْ يمسِ","https://www.poetsgate.com/ViewPoem.aspx?id=188342",""],[5425,"أَوفَيتَ عَهْدَكَ ، يا حَقٌّ بِمَقْتَلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=207514",""],[5431,"سوناتا العشق...","https://www.poetsgate.com/ViewPoem.aspx?id=200245",""],[5444,"رُّمانُ.. وأيلولُ أسود","https://www.poetsgate.com/ViewPoem.aspx?id=205085",""],[5480,"خزني بالعين","https://www.poetsgate.com/ViewPoem.aspx?id=1587",""],[5628,"صور من الريف","https://www.poetsgate.com/ViewPoem.aspx?id=178449",""],[5674,"والضفاف مسافرة","https://www.poetsgate.com/ViewPoem.aspx?id=189553",""],[5703,"أيلول","https://www.poetsgate.com/ViewPoem.aspx?id=215961",""],[5704,"وصْف...","https://www.poetsgate.com/ViewPoem.aspx?id=191601",""],[5704,"قالت أحبُّكَ","https://www.poetsgate.com/ViewPoem.aspx?id=192690",""],[5720,"النَّهار","https://www.poetsgate.com/ViewPoem.aspx?id=207397",""],[5743,"كلهم يحدثني عنك","https://www.poetsgate.com/ViewPoem.aspx?id=202315",""],[5943,"غرِّيدة","https://www.poetsgate.com/ViewPoem.aspx?id=21947",""],[6093,"يا أيها العربي","https://www.poetsgate.com/ViewPoem.aspx?id=191866",""],[6093,"الكلام يشوق","https://www.poetsgate.com/ViewPoem.aspx?id=204829",""],[6147,"لو.","https://www.poetsgate.com/ViewPoem.aspx?id=151497",""],[6198,"عرس الطبيعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79233&r=&rc=7",""],[6222,"يا تائهون على الدروب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1930&r=&rc=1",""],[2944,"شكوى العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86015&r=&rc=4",""]],"verses":[["والنهر درّع بالحباب","وسل سيفو وشهر",0,"ر",1,0],["والنهر مصقول الحُسام متى تَرِدْ","درعُ الغدير مصفقاً فيها صَدَرْ",1,"ر",1,0],["والنهر طرسٌ تخطّ الريح أسطره","والقطر يتبع ما خطّت بإعجام",2,"م",1,0],["وَالنَهرُ مِمّا سالَ مِن مُهَجاتِهِم","يَجري عَلى أَرضٍ مِنَ المُرجانِ",3,"ن",1,0],["والنَّهرُ للغول المقدّسة التي","لا ترتوي والغابُ للحَطّابِ",4,"ب",1,0],["وَالنُهودُ هامِدَةٌ","وَالخُدودُ تَلتَهِبُ",5,"ب",1,0],["وَالنَهرُ ما بَينَ الرِياضِ تَخالُهُ","سَيفاً تَعَلَّقَ في نِجادٍ أَخضَرا",6,"ر",2,0],["وَالنَهرَ وَالبُستانَ وَالبُحَيرَه","قَد جَمَعَ الماءُ إِلَيها طَيرَه",7,"ه",1,0],["والنهرُ سلسال الخرير كأنه","قيثارة سحريةُ التعزيفِ",8,"ف",1,0],["والنهر روح العاشقين ودمعهم","ملقى على قدميك يلهث خائرا",9,"ر",2,0],["والنهر إذ تنظر أمواجه","لا أستحي منها ولا تخجلين",10,"ن",1,0],["والنُهى والجَهلُ إِن","كنتَ عليماً في الصُدور",11,"ر",1,0],["واَلِنهُ فَكَم الَنتَ بِذَكرَا","كَ قُلُوباً أقسَى مِنَ الصَّفوَاءِ",12,"ا",2,0],["والنهرُ صافٍ ماؤُهُ مُفَضَّضٌ","والنجمُ فيه كذبالٍ مُشْرِقِ",13,"ق",1,0],["والنهر صفّق والاغصان راقصة","وللهنا كل وقت فيه تجديد",14,"د",1,0],["والنهر كالوسنان يحلم","بالورى جيلا فجيل",15,"ل",1,0],["وَالنَهرُ قد نقشَته السحبُ من طربٍ","كأَنَّه مِعصمٌ بالدُرِّ مَنقوشُ",16,"ش",1,0],["وَالنَهرُ يَشكو وَجدَهُ بِخَريره","وَالغُصنُ مَعشوق لَهُ مَوموق",17,"ق",1,0],["والنهر فيه جاري","ينساب في المجاري",18,"ي",1,0],["والنهر في تصفيقه","كأنه مشبب",19,"ب",1,0],["والنهر في الوادي كذائب فضة","يجري فتجري نحوه الأغراض",20,"ض",1,0],["والنهر الجوانب ضاحك","عن ثغر در ما له أنداد",21,"د",1,0],["والنهر خلت به الحصى","حَبَباً تنكَّسَ من ورائه",22,"ا",3,0],["والنهر يصدى بهاتيك الظلال كما","تصدى صفيحة حدّ الصارم الذكر",23,"ر",1,0],["والنهر بين الغصون مُطرد","وموجه تابع ومُتَّبَعُ",24,"ع",1,0],["والنهر قد شبَّ الشعا","عُ صفحهُ باللَّهبِ",25,"ب",1,0],["والنَهضَةُ الغَيبِيَّةُ انبَلَجَت وَقَد","حَيَّت بِمَعنى ما يَكُونُ وَكَانا",26,"ن",2,0],["والنَّهْرُ كالأَفْعَى جَرَى","بَيْن الرِّياضِ لَهُ انْسِيابْ",27,"ب",1,0],["والنهارات المضيئات التي","إن مضت تأتي الليالي الحلك",28,"ك",1,0],["والنهر كَمٌّ أَزرَقٌ","وخيالُ وَجْهِكَ طرَّزه",29,"ه",1,0],["والنهر يجرى تحتها متسلسلا","فكأن بقعتها نعيم ثان",30,"ن",1,0],["والنهر صنجٌ والنسائم مَزهرٌ","والأيكُ عُودٌ والحمام ولائدوه",31,"د",3,0],["والنَّهرُ مكسوٌّ غلالةَ فضَّةٍ","فإذا جرَى سيلٌ فثوبُ نضارِ",32,"ر",1,1],["والنهر في يد النس","يم كالقبا المفرك",33,"ك",1,0],["والنهرُ قد هَزَّتْهُ أرواحُ الصَّبَا","طرباً وَجَرَّتْ فَوْقَه أهدابَها",34,"ه",2,0],["وَالنّهرُ فيهِ بِثَغرِ الأُنسِ مُبتَسِمٌ","مِن حيثُ قَد رَقَصَت أَزاهِرُهُ",35,"ر",2,0],["وَالنّهرُ يَنزِلُ مِن عالٍ لِمُنحدر","يُقهقهُ الثغرُ في عالٍ ومنحدرِ",36,"ر",1,0],["والنهار اختبا وأبدى احمراراً","إذ أتى الليل في كِسا الطيلسانِ",37,"ن",1,0],["والنهر صرف والكواكب أكؤس","والطير عود والغصون جوارِ",38,"ر",1,0],["والنهر عاد جليدا تحت ناقته","لما ارتقى فوقها حتى تعراه",39,"ا",2,0],["والنهر يجري في الرّيَاضِ كما جرت","سِنَةُ الكَرَى في المُقْلَةِ الوَسْنَاءِ",40,"ا",2,0],["والنهر بين ممرد ومزرد","والزهر بين منمق ومرصع",41,"ع",1,0],["وَالنَّهْرُ ينسابُ فِي مَجْرَى نهايتهِ","كَمَا جَرَى الدمع من أجْفَانِ مُخْتَلِقِ",42,"ق",1,0],["وَالنَّهْرُ كَالهنديّ أوْ هُوَ مِعْصَمٌ","فِي حلة خضْرَاء أوْ ثعبَانُ",43,"ن",1,0],["وَالنَّهْرُ بَيْنَ مُدَعَّجٍ وَمُزَرَّدٍ","وَالزَّهْرُ بَيْنَ مُؤَنَّقٍ وَمُنَمَّقِ",44,"ق",1,0],["والنَّهْرُ بَيْنَ مُزَرَّدٍ وَمُدَرّعٍ","وَالزَّهْرُ بَيْنَ مُدَرْهَمٍ وَمُدَنَّرِ",45,"ر",1,0],["والنهرُ خُلْقُو وَالشَّقَائِقْ خَلْقُو","وَالبَانْ عَرْفُو وَالجَوَابِي فَضْلُو",46,"و",1,0],["والنهرْ سَاقِي وَالبَلاَبِلْ نُدْمَانْ","والطلّ قَهْوَهْ وَالكُؤوسْ النّسْرِينْ",47,"ن",1,0],["وَالنَهْمُ بِالْيَايَاءِ وَالهَجْهاجِ","مُخْرَوَّطاتٌ كَقَنَا الحَلّاجِ",48,"ج",1,0],["والنهر يجري إلى الدولاب منعطفاً","تراه منعرجاً في غثر منعرج",49,"ج",1,0],["والنهر كالمبردٍ يجلو الصدا","ببرده عن قلب ظمآنهِ",50,"ه",1,1],["وَالنهب تعدو بِهِ الرِجال وَقَد","أَبدَت خَلاخيلَها حَرائرها",51,"ر",3,0],["والنهرُ مذ علقَ الغصونَ محبةً","أضحت تطيلُ صدودَهُ وجفاه",52,"ه",1,1],["والنهرُ ساعٍ قد غدا","بسعادةِ الأغصانِ يجري",53,"ي",1,0],["والنهرُ بينهما بغيرِ جنايةٍ","سيفٌ على طولِ المدى مسلولُ",54,"ل",1,0],["وَالنَهرُ قَد طمحَت بِهِ نارنجَةٌ","فَتَيمَّمَت مَن كانَ فيهِ مُنيخا",55,"خ",2,0],["وَالنَهرُ مَرقومُ الأَباطح وَالرُبى","بِمُصَندَلٍ مِن زَهرِهِ وَمُعَصفَرِ",56,"ر",1,0],["وَالنَهرُ مَن طَرَبٍ يَصفِّقُ مَوجُهُ","وَالغُصنُ يَرقُصُ وَالحَمامَةُ تَسجَعُ",57,"ع",1,0],["والنهر كالمبرد يجلو الصدا","وبرده عن قلبِ ظمآنهِ",58,"ه",1,1],["والنهر جن به فراح مسلسلاً","صب تحيرَ لا يصيب قرارا",59,"ر",2,0],["والنهر في الروضة الفيحاء مثلها","لما جرى فسقى الصفصاف والبانا",60,"ن",2,0],["والنُّهُودِ الحسانٍ بينَ وِرادٍ","مُلُسٍ من ترائبٍ وتَراقيِ",61,"ق",2,0],["وَالنَّهْرُ غِيضَ لَهُمْ وَالنَّارُ قَدْ طُفِيَتْ","كَأَنَّ مَا فَاضَ مِنْ مَاءٍ سَرَى فِيهَا",62,"ي",3,0],["والنهر مثل المجر حف به","من الندانى كواكب زهر",63,"ر",1,0],["وآلَ نهيانَ في الآفاقِ نعرِفُهُمْ","فضلاً ونبلاً اليهمْ ينتهي أربي",64,"ب",2,0],["والنهر مثل المجَرّ حفّ به","من الندامى كواكِبٌ زُهْر",65,"ر",1,0],["والنهد رمانه واللحظ نرجسه","والخد تفاحه والخال عنبره",66,"ر",2,0],["والنهر أصبح بالسنا متموِّجاً","فجرى يرد الضوء للنظار",67,"ر",1,0],["والنهر ذل لغصنها فتراه يل","ثمه ويشكو للهوى مهما انثنى",68,"ن",2,0],["والنهل من وشل المناهل في الفلا","مع أسدها من مائها المورود",69,"د",1,0],["والنهر يجرى لجينا من سباه ومن","يد النسيم عليها أبدع الصور",70,"ر",1,0],["والنهب أحمال والقتول والأكوان","والنار والمعول حوالي سوره",71,"ر",2,0],["والنهر من خلف اليفاع كمعصم","ضمّت به إحدى الحسان سليلا",72,"ل",2,0],["والنهر عشر ما سقى سائحاً","وما سقى المستحنفر الدعدع",73,"ع",1,0],["والنهر كالصل والجنات مشرفة","والنهر والبحر كالمرآة وهو يد",74,"د",1,0],["والنهر يحكي كلما حوله","كأن فيه مجلس ثاني",75,"ن",2,0],["والنهي وهو مثله بلا بدا","والشرط بعدها يجوز والندا",76,"د",2,0],["والنهك للعظام مكروه فلا","تفعله فالناهك عظماً يبتلى",77,"ل",2,0],["والنهر قد مالت عليه غصونهُ","فكأنّما هو مقلةٌ وطفاء",78,"ا",2,0],["والنهر من خوف العيون كأنّه","كتبَت عليه من النسيم حروفُ",79,"ف",1,1],["والنهر جنّ فسلسلوه مخافة","من أن يغرق ماؤه ريح الصبا",80,"ب",2,0],["والنهر يجرى سائلا ماذا جرى","فالروض قد حيى بوجه ناضر",81,"ر",1,0],["وألنه غايات المنى","فوق الأرائك والاسره",82,"ر",2,0],["والنهر حيث جرى وقت الأصيل حكى","كف الأصيل ابن عون جاد بالذهب",83,"ب",1,0],["والنهار الطويل يمضى من العم","ر كفاحاً حول المنى وزحاما",84,"م",2,0],["والنهر من عكا ومخرج مآية","من نهر كردانية الموصوفة",85,"ه",1,0],["والنهر من برشين مخرج مآية","من بيت جبريل واجنادية",85,"ه",1,0],["والنهر من تل يسمى اخضرا","من تل يونس نبعه من بصة",85,"ه",1,0],["والنهر يجري في السفوح كأنه","خيطٌ يخاط به رداءُ السندس",86,"س",1,0],["والنهر يجري كاللجين وحوله","ألارض ترب والسماء عجاج",87,"ج",1,0],["والنهد يا ويلتي من حالم هزج","إلى التوثّب منه يرفع الراس",88,"س",1,0],["والنهر ما أحلاه ينتقل","في حضن حصباء من الدرر",89,"ر",1,0],["والنهر سيف بالنسيم فرنده","وله حمائل من خمائل سندس",90,"س",1,0],["والنَهرُ مُطَّردُ الكُعُوبِ يَحُفُّهُ","رَوضٌ أَريضٌ أَينَعَت أَفنانُهُ",91,"ن",2,0],["والنهر قد صفق والطير قد","غرد حتى أرقص الأغصنا",92,"ن",2,0],["وَالنهرُ لَمّا راحَ وَهوَ مسلسَلٌ","لا يَستَطيع الرَقصَ ظلَّ يُصفِّقُ",93,"ق",1,0],["والنهر حركه النسيم فصاغها","زردا من البلور فوق سمائه",94,"ا",3,0],["وَالنَهر مَصقول الفرند مرصّعٌ","من نُوره بلآلئٍ بَيضاء",95,"ا",2,0],["وَالنَهر منطبعٌ فيهِ الجَميع كَما","قَد يَطبع الفكر في أَلبابنا صُوَرا",96,"ر",2,0],["وَالنَهرُ سَبَّحَ وَالغُصونُ رَواكعٌ","وَالطَيرُ في أَفنانها كمُدَرّس",97,"س",1,0],["وَالنَهر يَسقي غُصوناً وَهيَ مائِلَةٌ","كَالصَبِّ يَبكي حَبيباً وَهوَ مَغرور",98,"ر",1,0],["وَالنَهر مضطربُ الفُؤاد كَأَنَّهُ","قَلبي عَلَيك مَتى أَرَدت لقائي",99,"ا",2,0],["وَالنَهر نحر وَالظلال غَدائرٌ","تَغشى جَمال بَياضه بِسَواد",100,"د",1,0],["وَالنَهر مضطرب الفُؤاد كَأَنه","صبٌّ بِقامة أَغصُنٍ هَيفاء",101,"ا",2,0],["وَالنَهرُ يَنسابُ خِلالَ الرُبا","كَالأَيمِ يَنسابُ لَدى مَهربِ",102,"ب",1,0],["وَالنَّهْرُ خَدٌّ بِالشُّعاعِ مُوَرَّدٌ","قَد دَبَّ فِيهِ عِذارُ ظِلِّ الْبانِ",103,"ن",1,0],["والنهر وافق لحنه","نقراً على دفٍ مصنج",104,"ج",1,0],["والنهر مطرد والزهر منعكس","والناي ما بين تقييد وإطلاق",105,"ق",1,0],["والنهر من طرب يصفّق فرحة","والغُصنُ يرقُص والرياض تميدُ",106,"د",1,0],["والنهر لولا الغيث جفت أرضه","والسيف لولا الضاربون حديدُ",107,"د",1,0],["والنّهى لمَّا ارتاح معطفه إلى","لقيا الرياح عُبابُهُ متموِّج",108,"ج",1,0],["والنهر قد رقت غلالة صبغه","وعليه من صنع الأصيل طراز",109,"ز",1,1],["وَ ((آلُ نُهَّيانِ)) الكِرامِ أَعِزَّةٍ","سَأَشْدُو لهُم بالتَّهنِئاتِ مُغَرِّدَا",110,"د",2,0],["والنهر ما بين ضفتيه","شقائق ملؤها عزائم",111,"م",1,0],["والنهاية درب واحد عنه والله لا مفر","والحساب العدل من ربك على الميزانيه",112,"ن",3,0],["والنهاية في يدين المبتدي","إخذها حتى ولو راحت سدا",113,"د",2,0],["والنّهايَةُ واضِحَةٌ","لا انتَهَيَتَ ولا ابتَدَأُوا",114,"ا",1,0],["وَالنَّهْرُº وَالْبَحْرُ لِلْعُشَّاْقِ أُغْنِيَةٌ","تَرْوِيْ مُحِباًّ إِلى الْمَحْبُوْبِ ظَمْآنَاْ",115,"ن",2,0],["وَالنًّهْرُ يا بَغْدادُ يَجْثو ضارِعاً","وَقَدِ انْطَوَتْ بَينَ الضِّفافِ الْأَعْصُرُ",116,"ر",1,0],["والنهر فيه الكوثر الموصوف في","دار السلام تحفه أنداؤه",117,"ا",3,0],["وَالنَّهيُ عَنْ دَاعِي الهَوَى تَحتَ النُّهَى","فِي كُلِّ حَالٍ حَادِلٌ فَمُجَادِلُ",118,"ل",1,0],["والنهدُ باح بسرّهِ","ماعاد يجدي إن تخفى",119,"ف",2,0],["والنَّهرُ غَنّى للضِّفافِ قَصيدةً","لولا غناءُ النّهرِ كانتْ مُقْفِرَهْ",120,"ر",2,0],["والنَّهْدُ تَلْهَثُ خَلفَ الصُّبْحِ حَلْمَتُهُ","كالطَّيرِ في لَيْلِهِ حَارَتْ بِهِ السُّبُلُ",121,"ل",1,0],["والنهر يجري كدمع فاض من مقلٍ","والماءُ صافٍ وعذبِ المرتوى عذبُ",122,"ب",1,0],["والنهد ثوبيه قد شله","مثل شوبينن برماني",123,"ن",2,0],["والنَّهْرُ أنشأَ في العيونِ","ضفافَهُ وبنى جدارَه",124,"ر",2,0],["والنهرُ قد جفَّت منابعُه","