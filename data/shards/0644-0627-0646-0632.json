{"poems":[[46,"أعقبك الله صحة البدن","https://www.aldiwan.net/poem30336.html","المنسرح"],[107,"هي الأواصر أدناها الدم الجاري","https://www.aldiwan.net/poem44225.html","البسيط"],[287,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[325,"يا أيها الخل الذي لم ينسني","https://www.aldiwan.net/poem61704.html","الكامل"],[406,"شموخ الصابري","https://www.aldiwan.net/poem6716.html","عموديه"],[556,"إن على رمل العقيق خيما","https://www.aldiwan.net/poem47229.html","الرجز"],[574,"ونار دعوت المعتفين بضوئها","https://www.aldiwan.net/poem52006.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48516","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128713","الكامل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87813","الرمل"],[3557,"","https://poetry.dctabudhabi.ae/diwan/poem/140210",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111439","الخفيف"],[3996,"","https://poetry.dctabudhabi.ae/diwan/poem/114904","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119447","الرجز"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123860","الرجز"],[5436,"سكن المجد(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=35148",""],[5794,"كنز لا يفنى ..","https://www.poetsgate.com/ViewPoem.aspx?id=80285",""]],"verses":[["لا نَزَعَ اللَهُ مِنكَ صالِحَةً","أَبلَيتَها مِن بَلائِكَ الحَسَنِ",0,"ن",1,0],["لأُنزِلنَّ ذوي الطُّغيانِ مَنزلةً","تستفرغُ الكبرَ من هامٍ وأبصارِ",1,"ر",1,0],["لأَنزَعَن في قِسِيِّ الذَّمِّ مُجتَهِداً","فَأُصمِيَنَّ لِئاماً بَعدَ مُرتَحَلي",2,"ل",2,0],["لَأُنَزِّهَنَّكَ عَن تَقَصُّدِ جَفوَةٍ","إِنَّ الجَفاءَ قَطيعَةُ الخِلّانِ",3,"ن",1,0],["لا نزكّيه، ولكنَّا نرى","صُوراً تُلحِقُه بالصادقين",4,"ن",1,0],["لا نزل الرّزقُ على مستمطرٍ","لِرزقه من المخازي دِيَما",5,"م",2,0],["لأَنزع ضباً جاثماً في فؤاده","وأَقلم اظفاراً أَطال بِها حفرا",6,"ر",2,0],["لأنزهن نواظري متنقلاً","أستقبل اللذات فيك ضروبا",7,"ب",2,0],["لأنزهنّ نواظري من وجهها","ولحاظها في روضة وعيون",8,"ن",1,0],["لا نَزال الدَهرَ نُهدي","لِمَغانيكِ السَلاما",9,"م",2,0],["لأن زمانَ الزَّهوِ ليس بدائمٍ","ففيه اغتنمْ صفوَ الحياةِ مع اليُسْر",10,"ر",1,0],["لان زَفسٌ لِقَولِها ثُمَّ قالا","لأَثِينا هَيِّي أَجيبي السُّؤَالا",11,"ل",2,1],["لأنزعَ ضيماً ثاوياً في فؤادهِ","وأقلِمَ أظفاراً أطال بها الحفرا",12,"ر",2,0],["لأنزل الرحمن فيه سوره","أو نطقت أبنية معموره",13,"ر",2,0],["لا نزع اللَه سرابيل النعم","عنك فسد وارفل بها دون الأمم",14,"م",1,0],["لا نزرع الجرحَ في دمع ونتركه","ُ يهزُّ في عينِنا أشواكهُ حزنا",15,"ن",2,0],["لا نزفنا الدم في كف البطوله","واكتب أن النصر هو مسك الختام",16,"م",1,0]]}