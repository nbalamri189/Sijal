poetsgate.com/ViewPoem.aspx?id=182643",""],[5956,"قبل الموت","https://www.poetsgate.com/ViewPoem.aspx?id=184892",""],[5957,"رجاء","https://www.poetsgate.com/ViewPoem.aspx?id=59641",""],[6102,"أُمنِياتٌ بَريئَة !!","https://www.poetsgate.com/ViewPoem.aspx?id=211861",""],[6139,"غياب جديد","https://www.poetsgate.com/ViewPoem.aspx?id=212331",""],[520,"حرام على قلبي يرى وهو ساكن","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577669",""],[3155,"إلى قُمْريَّة الشط","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75612&r=&rc=35",""],[6211,"تفاهات،تفاهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78242&r=&rc=11",""],[463,"لكِ الغرامُ وللواشي بكِ التعبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59983&r=&rc=39",""],[5567,"أغيب بها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82081&r=&rc=134",""],[5567,"وسواس الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81769&r=&rc=37",""]],"verses":[["أُغَيلِمَةٍ زَحَمتَ بِها الأَعادي","تَعاطى بِالذَوابِلِ ما تَعاطى",0,"ط",2,0],["أَغيبُ فَأَنسى كُلَّ شَيءٍ سِوى الهَوى","وَإِن فَجَعَتني بِالحَبيبِ النَوائِبُ",1,"ب",1,1],["أَغيبُ عَنكِ بِوُدٍّ لا يُغَيِّرُهُ","نَأيُ المَحَلِّ وَلا صَرفٌ مِنَ الزَمَنِ",2,"ن",1,1],["أغيد ذو ردف وخصر فكم","في غورهِ أصبو وفي نجده",3,"د",2,0],["أغيد لو مزَّق الضنى جسدي","ما حال بي عن غرامه أبدا",4,"د",2,0],["أغيد له فوقَ وجنتيه دمٌ","يروي أحاديثَ قلبه القاسي",5,"س",2,0],["أغيدُ لم يرتعِ الخَلاء ولا","خالط غِزلانَه ولا بقره",6,"ر",2,0],["أغيلِمةٌ لا يملِكُ الحزمُ بأسَهُم","هُمُ والمذاكي والرياحُ مناسيبُ",7,"ب",1,0],["أَغيثي مَن وَراءَكِ مِن رَبيعٍ","أَمامَكِ مُرسَلٍ بِيَدَي هِشامِ",8,"م",1,0],["أَغياثَ دينِ اللَهِ يا مَن رَأيُه","يُغنيهِ عَن خَطِّيَّةٍ وَنِصالِ",9,"ل",1,0],["أُغِيرُ عَلَى الأَبْطَالِ وَالصُّبْحُ أَشْهَبٌ","وَآوِي إِلَى الضِّيفَانِ وَاللَّيْلُ أَدْهَمُ",10,"م",1,0],["أغيدُ عبريٌّ لهُ عمَّةٌ","حَكَتْ منَ العشاقِ ألوانا",11,"ن",2,1],["أغيرَ قويم قد قيل عجر","فقالَ نعم وغير تمور يفر",12,"ر",1,0],["أغيدُ ذو طبٍّ وذو حكمةٍ","لو عادَ أحيا قلبيَ الطائحا",13,"ح",2,0],["أغيَدُ سكرانُ نورُ شرقٍ","وهُوَ لأهلِ الشمالِ قبلَهْ",14,"ه",1,1],["أَغَيظي تَمَنَّت أَم أَرادَت فِراقَها","إِلَيَّ فَلا حاشايَ بَل أَنا أَقبَلُ",15,"ل",1,0],["أغيثوا أهلها وتداركوهم","تهزُّ حُماتَها المُستبسِلينا",16,"ن",2,0],["أَغيثوا مِصرَ وَاِستَبِقوا بَنيها","فَقَد ضاقَت وُجوهُ العَيشِ فيها",17,"ي",3,1],["أَغيثوها فَما شَقِيَت بِلادٌ","بَنو السَكسونِ أَكبَرُ مُصلِحيها",17,"ي",3,0],["أَغيثوا أُمَّةً تَشكو إِلَيكُم","أَذى الحِدثانِ وَالعَيشَ الكَريها",17,"ي",3,0],["أغيدُ مثلَ الشمسِ لمَّا بدا","تاهَ على الناسِ بنحرٍ وَجيد",18,"د",1,1],["أغيرَ الذي قد خُطّ في اللوح أبتغي","مديحاً لهُ إنّي إذاً لَعَنُود",19,"د",1,0],["أَغيَدُ مُرتَجَّةٌ رَوادِفُهُ","مُحتَلِمٌ أَو دُوَينَ مُحتَلِمِ",20,"م",1,0],["أَغِيَّ الطِفلِ مِن بَعدِ التَناهي","وَضُعفَ السَقبِ في حالِ البُزولِ",21,"ل",1,0],["اغير ليلاي نادوا ام بها هتفوا","فداء ليلى الليالي الخرَّد الغيد",22,"د",1,0],["أُغَيبِرُ مَقطوعٌ مِنَ اللَيلِ شَوبُهُ","أَنيسٌ بِأَطرافِ البِلادِ البَلاقِعِ",23,"ع",1,0],["أَغيَرَ الرِجالُ وَما ال","حُرُّ غَير أَغيَرِها",24,"ر",3,0],["أغيدَ مطرابِ العشيَّات مرعشٌ","من الخمْرِ لا يَلْقاكَ إِلا نَدِيمُها",25,"م",3,0],["أغير َ المطامعِ لا تعرفون","وغيرَ الهياكلِ لا تعبدونا ؟",26,"ن",2,0],["أَغَيْرَكِ نَرْجُو لِلْمَعُوْنَةِ والكِفَلِ","فَقَالَتْ أَشِيرِي يَا أُمَيْمَةُ إِنَّنِي",27,"ي",1,0],["اغيب اذا ذكرت لفرط وجدي","تقول عليّ قد ثقل المدام",28,"م",1,0],["اغيثوا حنانا يا كرام برحمة","ومنا لكم طول المدا الشكر والحمد",29,"د",1,0],["أغيب وعندي بالوفاء حضور","وينأى مزاري والكتاب يزور",30,"ر",1,1],["أغيب عن الهموم به وأكفى","بسكري طلعة الرجل الثقيل",31,"ل",1,0],["أَغْيَدُ في وَجْنَتِهِ رَوْضَةٌ","يجري بها ماءُ الشباب المعين",32,"ن",1,0],["أغيثوهم بسيفٍ لا بزاد","فهم خلفُ القساورة الصلاب",33,"ب",1,0],["أغِيبُ ولي مهجة لا يزال","إليك سُرَاها وتبكيرُها",34,"ر",3,1],["أَغيَدُ مِقلاقُ الوِشا","حِ نائِمٌ عَن قَلَقي",35,"ق",2,0],["أَغيَدُ مَصقولَةٌ تَرائِبُهُ","أَينَ الكَمِيُّ الكَرّارُ وَالغَيدُ",36,"د",1,0],["أَغيَدَ يَقتادُ زِمامي لَهُ","قَدٌّ كَخوطِ البانِ مَقدودُ",37,"د",1,0],["أغيب شهراً فلا تراني","العيون والناس يطلبوني",38,"ن",2,0],["أغيروا كلُّكم عرباً وغاروا","على الدينِ الحنيفِ الأحمدي",39,"ي",1,0],["أَغيب وَذو اللطائف لا يَغيب","وَأَرجوه رجاء لا يخيب",40,"ب",1,1],["أُغِيرُ عَلَى نَداكَ وَكانَ حَقَّاً","لِجُودِكَ أَنْ يُغاوَرَ أَوْ يُغازا",41,"ز",2,0],["أغيرتني بالتمنى","فصار طبعا لديّا",42,"ي",2,0],["أَغِيضَ النَّدا من أَكُفٍّ لَهُمْ","فَجَاوَبَني مُنْشِئاً مُنْشِدَا",43,"د",2,0],["أَغيَدُ يَومُ وَصلِهِ تَأريخُ","لِصُدغِهِ مِن نِقسِهِ تَضميخُ",44,"خ",1,0],["أُغِيّضُ دَمعي وهْو يسَبِقُ واكفاً","وأَلزَمُ قلبي الكفَّ وهْو يَطير",45,"ر",1,0],["أَغيبُ بِرَغمي ثُمَّ أُحضرُ عِندَهُ","فَأنظُرُ آثارَ الضَنى فَأَغيبُ",46,"ب",1,0],["أَغَيرِيَ مَن يُدعى لِيَومِ كَريهَةٍ","وَساعَةِ شَكوى مِن حَبيبٍ فَيَحضُرُ",47,"ر",1,0],["أغيثي مَن هوى في كل مهوىً","لينهض إنَّك المأمول عُتقا",48,"ق",2,0],["أغيّرَ البعدُ قلباً منك أعرفُه","أم هلْ سمعتَ مقالَ الحاسِدِ الشّاني",49,"ن",2,0],["أغيرك يُرْجَى لِخَطْبٍ نَزَلْ","فَتُزجَى إليهِ ركابُ الأمَلْ",50,"ل",1,1],["أغيرِ أَبي السبِّطِ لِلْمصْطَفى","أجابَ ولَبَّاه لمَّا دَعَا",51,"ع",2,1],["أغير عليٍّ كانَ بعْدَ محمَّدٍ","لَهُ كاهِلُ المجدِ الأثيل وغاربُهْ",52,"ب",2,0],["أَغيث جداه الماء لا شيء غيره","كَغيث جداه طارِف وتلادُ",53,"د",1,0],["أُغيدُ ما همّتْ به روضةٌ","أعلّ جِسمي لأكونَ النسيمْ",54,"م",1,0],["أغيد ليّنُ العريكةِ يغتا","لُ بسحْر اللّحاظِ أسْدَ العَرينِ",55,"ن",1,0],["أغيرَأن كنتُ المقل","لَ وغدا مموَّلا",56,"ل",2,0],["أغير أبيك إمام الهدى","ضياء النديِّ هزبر العزيفِ",57,"ف",1,0],["أغيلمةُ الحيِّ من دونها","تجرُّ الذوابل أو تدَّعي",58,"ع",2,0],["أغيدُ لا يُنجِي الرقا","بَ من يديه الجَيَدُ",59,"د",1,0],["أَغيَدٌ يَغدو وَأَدمُعَنا","مِن تَجَنّيهِ كَوجنَتِهِ",60,"ت",2,0],["أَغيثُوا بآياتِ القَبُولِ مُتَيَّماً","لَكُم ابداً يا قَومِ أدمُعُه تَجري",61,"ر",2,0],["أَغِيثوني برؤيَتِكُمْ لأحْيى","وأجعلَ ذا الفَناءَ بكم بقاءَ",62,"ا",2,0],["أغيب فمن نوحي كأني حاضرٌ","فاحضر من ضعفي كأني غايب",63,"ب",1,0],["أغيب عنه وألقاه ومنزلتي","محروسة فكأني عنه لم أغب",64,"ب",1,0],["أغيثت سمنود بعالي ركابه","فعز لها أنف ذليل ومازن",65,"ن",1,0],["أغيَّرتُ من رُوحٍ يُفاوِحُ لطفُها","أريجَ نسيمِ اليَاسمِين إذا هَبَّا",66,"ب",2,0],["أَغيبُ ذُهُولاً ثم أَحْضُرُ فِكْرةً","وأَعْلَمُ مَنْ بي ثُم أَسأَلُهم مَنْ بي",67,"ب",2,0],["أغيرَ العَليِّ حَباكَ العُلُوَّ","وَغيرَ الجَليلِ حَباكَ الجَلالا",68,"ل",2,0],["أغيب عنك بود ما يغيره","نأي المحل ولا صرف من الزمن",69,"ن",1,1],["أغيب عن بيتي كما","شاء الهوى وأحضر",70,"ر",1,0],["أُغيّضُ ماءَ العينِ وهي دريرةٌ","وأكتمُ زندَ الوجدِ والزّندُ يقدحُ",71,"ح",1,0],["أَغيبُ بِها وَجداً وَإِنّي حاضِرٌ","أيُجدي حضورُ الصّبِّ والصّبُّ غائبُ",72,"ب",1,0],["أَغيد ما شان ورد وجنته","شوك عذار يكلّف العذرا",73,"ر",2,0],["أغيدٌ تَرشُقني أسهمهُ","في الحَشا إِن طرفه يحوي طرف",74,"ف",1,0],["أغيد يشبه غصنَ ال","بانِ ليناً واِعتدالا",75,"ل",2,0],["أَغيدٌ كانساتٌ أم بدورُ","تشفُّ بها الهوادجُ والستورُ",76,"ر",1,1],["أغيثوا وليا خاض في بطشةِ العِدى","بحبِّكمْ بحْراً من الهمِّ طَاميا",77,"ي",2,0],["أَغْيالَهُ وَالأَجَمَ العِرِّيسا","لا يَمْتَنِعْنَ الدَوْسَ أَنْ يَدُوسا",78,"س",2,0],["اغيد إن بعته الروح لما","كنت في بيعي له بالمبخسِ",79,"س",1,0],["أغيثوا ضعيفا قد تعذب بالذنب","وذبوا أزيلوا عنه عطفا عنا القلب",80,"ب",1,0],["أغيركم عن ودّنا صدق ودنا","فيا قرب ما خيبتم فيكم الظنا",81,"ن",2,0],["أغيرانُ كان الدّيك أوصاحُ مُشفقاً","حذارَ رقيبٍ حان منه نُشورُهُ",82,"ر",2,0],["أغيَدُ لا يقصِدُ إلاَّ تلَفى","ولم يزل قلبى به مُعلَّقا",83,"ق",2,0],["أغيدٌ فى هواهُ طالت ليالٍ","فوَاهاً منَ اللّيالى الطِّوالِ",84,"ل",1,0],["أغيدٌ أنوارُ مبسمه","أين منها الصبح إن سطعا",85,"ع",2,0],["أغيدٍ يجلو محيَّاهُ الظلاما","بنتُ كرمٍ زُوِّجت بابنِ السحب",86,"ب",1,0],["أغيثوهم سراة القوم برّاً","فأهل البر حاشوا أن يضاموا",87,"م",3,0],["أَغَيظاً أَرادَت أَن تُخِبَّ جِمالُها","لِتَفجَعَ بِالأَضعانِ مَن أَنتَ فاجِعُ",88,"ع",1,0],["أَغَيرَ كِتابِ اللَهِ تَبغونَ شاهِداً","لَكُم يا بَني العَبّاسِ بِالمَجدِ وَالفَخرِ",89,"ر",1,0],["أغيدٌ رَنَا","أهيف القَنا",90,"ن",2,1],["أَغِيُّ بَعدَ ما ذَهَبَ التَصابِي","وَشابَت بَعدَ حُلكَتِها القُرونُ",91,"ن",1,0],["أغيرك يجلو عنه دجنة كربة","إذا النصل لم يقطع فما ينفع الغمد"