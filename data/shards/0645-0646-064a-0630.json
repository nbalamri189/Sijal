{"poems":[[54,"من يذود الهموم عن مكروب","https://www.aldiwan.net/poem27241.html","الخفيف"],[77,"أحبب به قنصا إلى متقنص","https://www.aldiwan.net/poem69068.html","الكامل"],[108,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[102,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[147,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[208,"شاقني الأهل لم تشقني الديار","https://www.aldiwan.net/poem53085.html","الخفيف"],[276,"سمعت سويجع الاثلاث غنى","https://www.aldiwan.net/poem52085.html","الوافر"],[371,"من يذكر المولى تناسى عبده","https://www.aldiwan.net/poem16967.html","الكامل"],[382,"عقلي يحدثه لسان نائح","https://www.aldiwan.net/poem66885.html","الكامل"],[491,"قالت ولم تقصد لقول الخنا","https://www.aldiwan.net/poem479.html",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38771","الرمل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67584","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216755",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216530","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33215","الرمل"],[5122,"((( لمّا )))","https://www.poetsgate.com/ViewPoem.aspx?id=24718",""],[5170,"ضايق الصدر","https://www.poetsgate.com/ViewPoem.aspx?id=175541",""],[5431,"بآخر طعنةِ","https://www.poetsgate.com/ViewPoem.aspx?id=195246",""],[5510,"لا تلمني","https://www.poetsgate.com/ViewPoem.aspx?id=206114",""],[5638,"ملحمة حر","https://www.poetsgate.com/ViewPoem.aspx?id=197920",""],[5818,"درس","https://www.poetsgate.com/ViewPoem.aspx?id=184873",""],[5970,"أشغل القلب بما يهوى فما","https://www.poetsgate.com/ViewPoem.aspx?id=130592",""],[6152,"هاشميون","https://www.poetsgate.com/ViewPoem.aspx?id=203020",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""]],"verses":[["مَن يَذودَ الهُمومَ عَن مَكروبِ","مُستَكينٍ لِحادِثاتِ الخُطوبِ",0,"ب",1,1],["مَن يذعَرُ السِّرحانَ بعد ركائبي","أو من يَصي ليل التّمام كما أصي",1,"ص",2,0],["من يذكرُ الأوطان يَنْسى غيرَها","أجْدِرْ بها هي وحدَها أن تُذْكَرا!",2,"ر",2,0],["من يذبُ النقود يا أم عنا؟","أصبحت فوقنا الرؤوس عجينا",3,"ن",2,0],["مَن يُذَد بِالتَمويهِ عَن مَورِدِ العِز","زِ فَإِنّي عَن وِردِهِ لَن أُذادا",4,"د",2,0],["مَن يُذيل النفسَ الخطيرة في الرَّو","ع إذا كان بالنفوس احتكارُ",5,"ر",1,0],["مني ذكر الحَبيب فذ احبيب","عليه اللَه في التَوراة أَثنى",6,"ن",2,0],["مَن يُذكِرُ المَولى تَناسى عَبدَهُ","لي عِندَهُ وَعدٌ وَقَلبِيَ عِندَهُ",7,"د",2,1],["من يذكر الديان يذبح حزنه","بحسام نوحٍ والترجي الذابحُ",8,"ح",1,0],["مَن يَذُقِ الحَربَ يَجِد طَعمَها","مُرّاً وَتَحبِسهُ بِجَعجاعِ",9,"ع",1,0],["مَن يَذُقها يَعِشِ الدّهرَ وَلَم","يَذُقِ المَوتَ فدى عَين الحَياهْ",10,"ه",1,0],["مَن يذودُ الملوكَ عن ساحةِ المُل","كِ إذا ما تَنافَسوا في المعالي",11,"ل",2,0],["من يذق لذة الهوى","يسل لذاته الأخر",12,"ر",1,0],["من يذق غصة الشراب فما بي","غصة غير أن تفيض الدموع",13,"ع",1,0],["من يذق طعم الهوى يرث لمن","ألفَ الحزن وقاسى الكَمدا",14,"د",2,0],["من يذوق الغرام العف يتألما","كل من شرب من كأسه ختمه بالونين",15,"ن",1,0],["من يذوق المفارق ، ما يحصل طبيب","والكسر بالمفارق ماحدٍ يجبره",16,"ر",2,0],["من يذبح القلب الرؤوم تجبرا","يذبح حشاشته بآخر طعنةِ",17,"ه",1,1],["من يذق علقمَ الفراقِ يراها","في الحنايا مرارةَ الترياقِ",18,"ق",1,0],["مَنْ يَذُقْ بَعْضَ نَارِنَا - قَدْ رَأَيْتَهْ","يَتَبَرَّأْ مِنْ كُلِّ وَغْدٍ عَنِيدِ",19,"د",1,0],["مَنْ يذكُر الآنَ مخلوقًا لَهُ أثَرٌ","ما عادَ يَحْيا ببلوى طارئٍ عَرَضا ؟",20,"ض",2,0],["من يذم العيش يصبح في أسى","ليس يبلى في نواحيه جديده",21,"د",2,0],["من يذمونهم بغير سبيل","غير حقد بقلبهم قد تعدا",22,"د",2,0],["مَنْ يَذُقْ عبر الأقاصي تَمرَنا","يَلْقَ في أعصابِهِ خَتْمَ زيارَةْ",23,"ر",2,0]]}