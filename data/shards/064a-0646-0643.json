{"poems":[[53,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[91,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[47,"مع الدهر ظلم ليس يقلع راتبه","https://www.aldiwan.net/poem10905.html","الطويل"],[89,"أي فتى للعظيم نندبه","https://www.aldiwan.net/poem8283.html","المنسرح"],[107,"مت لتحيا ولا تردها حياة","https://www.aldiwan.net/poem43410.html","الخفيف"],[50,"إن بارك الله في الأنام فلا","https://www.aldiwan.net/poem66230.html","المنسرح"],[29,"","https://poetry.dctabudhabi.ae/diwan/poem/1613","الوافر"],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[91,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[29,"أقادكَ بالمقادِ هوى عجيبٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16348&r=&rc=12",""],[136,"ربع أسماء إذ هي الأنس آلا","https://www.aldiwan.net/poem54778.html","الطويل"],[164,"لنا ما دنا مما نروم وما شطا","https://www.aldiwan.net/poem59104.html","الطويل"],[201,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[463,"مالي ولم أسبِق إلى الغنمِ","https://www.aldiwan.net/poem55868.html","أحذ الكامل"],[463,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[466,"بين الاباء وبين الصبر ملحمة","https://www.aldiwan.net/poem15656.html","البسيط"],[466,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[505,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[563,"أتعبتني بقر الشام","https://www.aldiwan.net/poem34182.html","المديد"],[563,"كان فرعون قاصدا تحقيقه","https://www.aldiwan.net/poem34290.html","الخفيف"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2467","المنسرح"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122750","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63900","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71027","الرجز"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16735","السريع"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110275","الرمل"],[2255,"","https://poetry.dctabudhabi.ae/diwan/poem/34911","المنسرح"],[190,"","https://poetry.dctabudhabi.ae/diwan/poem/98396","المنسرح"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100295","الوافر"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112671","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67986","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40126","الوافر"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93260","السريع"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111114","الرجز"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4755,"حِينَمَا يَقتُلُ الشَّقيقُ شَقِيقَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=191665",""],[4927,"عَفْرَاْءُ الدَّوَاْءُ الْمُتَوَهَّم","https://www.poetsgate.com/ViewPoem.aspx?id=30174",""],[6261,"تباريحُ الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82137&r=&rc=9",""]],"verses":[["يُنكر الفتكَ وهو أفتكُ بالده","رِ وأحداثِه من البَرَّاض",0,"ض",1,0],["ينكأ الجرح من يغني ويأسو","كطبيب بموقع الداء دار",1,"ر",1,0],["يُنَكِّبُ في إِشرافِهِ وَهوَ آزِمٌ","أُزومَ الخَليعِ اِزوَرَّ عَمَّن يُعاتِبُه",2,"ب",2,0],["يَنْكَفِتُ الْجَيْشُ حِينَ يَفْجَؤُهُ","وَيَصْعَقُ الْقِرْنُ حِينَ يَلْتَزِمُهْ",3,"م",2,0],["يُنكِرُ السُبلَ لا تَموجُ نُفوساً","حينَ يَمضي وَلا تَمُجُّ نَجيعا",4,"ع",2,0],["ينكب المُردَحين يبصرهم","على حصانٍ كأنّه عتمه",5,"م",2,0],["يُنَكَّلُ بِالمُهاجِرِ كُلُّ عاصٍ","وَيُدعى في هَواكَ فَيَستَجيبُ",6,"ب",1,0],["ينكر الشوط نفسه حين تجري","عاريات من الكمأة الخيول",7,"ل",1,0],["ينكر العقل أن تدوم حياة","قد تقصي كتابها الموقوتا",8,"ت",2,0],["يُنَكَّلُ بالمُهاجِرِ كُلُّ رعاص،","وَيُدْعى َ في هَواكَ فيَستَجيبُ",9,"ب",1,0],["يُنكِرُونَ الفَتحَ الإلهِىَّ والذَّو","قَ اللَّدني والشُّهودُ إعتدَالا",10,"ل",2,0],["ينكس منها رأسه كل سامع","حياء وتلقى من يد المنشد القطا",11,"ط",2,0],["ينكثُ الرملَ مُطرقاً وأنا","أشكو إليه آلامَ دائي الوبيل",12,"ل",1,0],["ينكب عجزاً عن طريق عزيمة","ومالٌ لتأويل ضعيف ورخصة",13,"ه",1,0],["يُنْكَرْنَ بالحدثان في زمني","لولا تعَرُّفُهنَّ بالوسمِ",14,"م",1,0],["ينكُص عند الجُلّى فإن أبصرال","جفنةَ ملآى استشاط فاقتحما",15,"م",2,0],["يُنكِّب الخفض اِنْ ذُمَّت مواقفه","ويطلبُ الحمد عند المنزلِ الخشنِ",16,"ن",1,0],["يُنكِّبُ سمْت القصد من حذر العدى","فيوعرُ حيث الوعْر أبقى وأسْلمُ",17,"م",1,0],["ينكشِفُ الغِطاءُ بالموتِ وقدْ","يُسأَلُ عن أَفعالِهِ من قد بَغَى",18,"ا",1,0],["ينكروني كلما جهلوا","فيزيد الله إنعامي",19,"م",2,0],["ينكران الضلال منه بجمع","لم يضف مع حضوره تفريقه",20,"ق",2,0],["يُنكِرُ لا إِنَّ لا لَمُنكَرَةٌ","مِن فيهِ إِلّا مُحالِفاً نَعَما",21,"م",2,0],["يُنَكِّت فَوقَ ناظِرَتَيهِ قَوساً","لَها في كُلِّ جارِحَةٍ سِهامُ",22,"م",1,0],["ينكّس رأسي إنني لم أَمُتْ أسىً","عليك كفى تنكيسُ راسيَ تنكيسا",23,"س",2,0],["ينكر ما يُنكره ويكتُمُهْ","في قلبه كأنه لا يعلمُهْ",24,"ه",1,0],["يَنكُسُهُ المَرءُ فَيَعلو بِهِ","وَرُبَّ نِكسٍ غِبُّهُ نَصبُ",25,"ب",1,0],["ينكر الساجع ان يسجع في","ايكه والفجر ان يبتسما",26,"م",2,0],["ينكر الليل إذا الليل جلا","قمراً في جوه او انجما",26,"م",2,0],["ينكر الدنيا كما انكره","اهلها واعتزلوه مسقما",26,"م",2,0],["يُنكِرُهُ النّاسُ بَعدَ مَعرِفَةٍ","وَقَد تَواصَوا بِطولِ جَفوَتِهِ",27,"ت",2,0],["ينكر عاص على أخيه وما","أنكره منه فهو في عدده",28,"د",2,0],["ينكِّس منه في القرطاس رأسا","ليودع مسمع الألواح سرا",29,"ر",2,0],["ينكثُ ثغراً وثنايا غُرا","قد كان يوليها النبي ثغرا",30,"ر",2,0],["يُنكر العقلُ فِعْلَ مَا عَزَّ عنه","فهمُه أَوْ يكون غِرٌّ تَعامَى",31,"م",2,0],["يُنَكِّسُ رأيُهُ رأيَ المحامي","ويَقْتُلُ خوفُهُ قبل القتالِ",32,"ل",1,0],["يُنكِرُ ما أَلقاه من صَدِّهِ","وأَيُّ فعل ما له فاعل",33,"ل",1,0],["ينكر هذا الفضل من لم ينصف","وكم له في نظمه من درر",34,"ر",1,0],["يُنَكَّسُ رَأسُ الريحِ عِندَ اِرتِفاعِهِ","وَكَم زالَ عَنهُ السُحبُ وَالغَيثُ هامِعُ",35,"ع",1,0],["يُنكِرُ الحَرفُ شَكلَهُ.. والمَعَانِي","فِيهِ تَنسَى مُرَادَها والطَّريقة",36,"ق",2,0],["يُنَكِّدُ عِيْشَتِيْ، وَيُزِيْدُ حُزْنِيْ","وَتَشْكُرُهُ عَلَى الْكَيْدِ النِّسَاْءُ",37,"ا",2,0],["يُنكرُ المرءُ سطوةَ الهُدبِ مالَمْ","يَرْشُقِِ الهُدْبُ في حَشاهُ سهامَهِ",38,"م",2,0]]}