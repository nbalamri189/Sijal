ww.aldiwan.net/poem38045.html","الخفيف"],[506,"يا وحشة الاسلام من فرقة","https://www.aldiwan.net/poem2415.html","السريع"],[514,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[514,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[515,"أما المكين المرتضى فعله","https://www.aldiwan.net/poem12042.html","السريع"],[529,"قد نلت منك جزيلا","https://www.aldiwan.net/poem37085.html","المجتث"],[538,"نعيت نفسي إليه","https://www.aldiwan.net/poem47496.html","عموديه"],[538,"قد نراه جالسا منكمشا","https://www.aldiwan.net/poem48200.html","عموديه"],[551,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[551,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[551,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[551,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[551,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[558,"إني أنا لست أنا","https://www.aldiwan.net/poem33847.html","مجزوء الرجز"],[558,"شمعتي أشرقت بنورك ربي","https://www.aldiwan.net/poem34431.html","الخفيف"],[558,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"],[562,"لا بد في الناس للأسماء من أثر","https://www.aldiwan.net/poem52599.html","البسيط"],[562,"قد ناح ميخائيل نحاس على","https://www.aldiwan.net/poem52611.html","الكامل"],[562,"قد نال يوسف بعد اليأس في كبر","https://www.aldiwan.net/poem52614.html","البسيط"],[562,"من قال إن الدهر ليس يعود","https://www.aldiwan.net/poem52806.html","الكامل"],[562,"رضيت من عين ذاك الحي بالأثر","https://www.aldiwan.net/poem52854.html","البسيط"],[562,"إن لم لك يكن في نقد الرجال يد","https://www.aldiwan.net/poem52863.html","البسيط"],[562,"أعرفت رسم الدار أم لم تعرف","https://www.aldiwan.net/poem52886.html","الكامل"],[562,"لا تجزعي يا نفس من حكم الردى","https://www.aldiwan.net/poem52894.html","البسيط"],[562,"ورد الكتاب فضاع طيب نشره","https://www.aldiwan.net/poem52956.html","الكامل"],[567,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[575,"يا منية النفس يا مسكية النفس","https://www.aldiwan.net/poem2925.html","البسيط"],[586,"فضحت جيد الغزال بالجيد","https://www.aldiwan.net/poem17492.html","المنسرح"],[586,"طرف تعرض بعدكم لهجوع","https://www.aldiwan.net/poem17592.html","الكامل"]],"verses":[["قَد نَطَقَ الصامِتُ مِن بَعدِهِ","وَأَصرَدَ النابِلُ بَعدَ المُروق",0,"ق",1,0],["قُدني إِلى ما قُدتَني قَبلَها","أَيُّ جَنيبٍ لَكَ لَم يوضِعِ",1,"ع",1,0],["قَد نَزَلنا دارَ كِسرى بَعدَهُ","أَربُعاً ما كُنَّ لِلذُلِّ ظُؤارا",2,"ر",2,0],["قَد نَهَدَ الثَديُ عَلى صَدرِها","في مُشرِقٍ ذي صَبَحٍ نائِرِ",3,"ر",1,0],["قَد نالَ أَهلَ شَبامٍ فَضلُ سُؤدَدِهِ","إِلى المَدائِنِ خاضَ المَوتَ وَاِدَّرَعا",4,"ع",2,0],["قَد نَطعَنُ العيرَ في مَكنونِ فائِلِهِ","وَقَد يَشيطُ عَلى أَرماحِنا البَطَلُ",5,"ل",1,0],["قَد نَحاها بِشَرِّهِ دونَ تِسعٍ","كانَ ما رامَ عِندَهُنَّ يَسيرا",6,"ر",2,0],["قَد نَفَضنا عَنّا الكَرى وَاِبتَدَرنا","فُرَصَ العَيشِ وَاِنتَقَلنا اِنتِقالا",7,"ل",2,0],["قَد نَجا المُنعِمُ الجَوادُ مِنَ المَو","تِ بِفَضلِ الزَكاةِ وَالإِنعامِ",8,"م",1,0],["قد نازَعَتني نَفسي أن أوَفِّيَها","وليس في طَوقِ مِثلي أنْ يُوَفِّيها",9,"ي",3,0],["قد نوَّهُوا باسمِه في جاهِلّيتِه","وزادَه سَيِّدُ الكَونَينِ تنويها",9,"ي",3,0],["قَد نُسِّقَت وَتَآلَفَت فَكَأَنَّها","في الحُسنِ مِثلَ تَآلُفِ الأَحزابِ",10,"ب",1,0],["قَد نَزَلنا جِوارَكُم فَحَمِدنا","مِنكُمُ الوُدَّ وَالنَدى وَالذِماما",11,"م",2,0],["قَد نالَني مِنكَ ما حَسبي بِهِ وَكَفى","يا مَن تَناهَيتُ في إِلطافِهِ فَجَفا",12,"ف",2,1],["قَدْ نَشَّأَتْهُ عَلَى الفَضَائِلِ وَالعُلَى","فَبِحَمْدِهَا نَطَقَ المُشِيدُ بِحَمْدِهِ",13,"د",2,0],["قَدْ نَاصَرَ الْعَدْلَ فِيه فَهْوَ مُنْتَصِرٌ","وَهَاجَمَ الْبَغْيَ فِيه فَهْوَ مُنْهَزِمُ",14,"م",1,0],["قد ناصحَ الإسلامَ خيرُ خليفةٍ","وحمى عزيز الملك أغلبُ مُشبلُ",15,"ل",1,0],["قد نتجنا لقوحها عن خداج","فلذلك انتهت بسوء النتيجه",16,"ج",2,0],["قد نُنكِر الفعل لم تألفه عادتنا","وأن علمناه من بعض المُباحات",17,"ت",1,0],["قَد نَكتَسي بِزَّةَ الجَبّارِ نَجنُبُهُ","وَالبَيضَ نَضرِبُهُ فَوقَ القَوانيسِ",18,"س",1,0],["قَد نالَ عَدلُكَ مَن أَقامَ بِأَرضِنا","فَإِلَيكَ حاجَةُ كُلِّ وَفدٍ راحِلِ",19,"ل",1,0],["قُدنا خُزَيمَةَ قَد عَلِمتُم عَنوَةً","وَشَتا الهُذَيلُ يُمارِسُ الأَغلالا",20,"ل",2,0],["قد نبذوا الإنصافَ فاعجب لمن","غدا بشهرِ الصوم نبَّاذا",21,"ذ",2,0],["قد نَفَثتُ الأدواءَ نَفْثَ وليٍّ","والعدوُّ المُكَمِّنُ الأَدواءَ",22,"ا",2,0],["قد ناصب الوردَ فمِنْ قولهِ","لا يلتقي الشِّيعيُّ والناصبُ",23,"ب",1,0],["قد نَزفْتُ المنيَّ واسْتُكَ غَرْثى","كُلَّ وقت تقول هل من مزيدِ",24,"د",1,0],["قد نحا سهماً لظبيٍ","أو لثورٍ أو حمار",25,"ر",1,0],["قد نظرنا بأعينٍ صافياتٍ","صادقاتٍ إذا مُخيلٌ أخالا",26,"ل",2,0],["قد نزّهوكَ عن الخداعِ ونكَّبوا","سُبل النفاقِ وإن جَنَوا لك ما جَنَوا",27,"ن",3,0],["قَد نالَ فَرطُ السُهادِ مِنّي","وَاِشتاقَ طَرفي إِلى الهُجوعِ",28,"ع",1,0],["قَد نَسَبوا الظُلمَ لِلسَماءِ","وَكُلُّهُم جائِرٌ ظَلومُ",28,"م",1,0],["قَد نَزَلَ الحُبُّ في فُؤادِيَ","ضَيفاً وَلَكِن عَلى الدَوامِ",29,"م",1,0],["قَد نَسَينا شُعاعَها وَسَناها","عِندَما أَشرَقَت وُجوهُ الحِسانِ",30,"ن",1,0],["قَد نَشَقتُ الأَزهارَ في كُلِّ أَرضٍ","ي شَذاهُنَّ لَستَ مِثلَ شَذاها",31,"ا",3,0],["قَد نَعى الناعونَ زَي","داناً إِلى البَدرِ سَناه",32,"ه",1,0],["قَد نَبَتَت في وَجهِهِ","فَوقَ عِظامٍ نَخِرَه",33,"ر",2,0],["قد نسينا تقصيرنا ثم أكثر","نا عتابا منا على الأيام",34,"م",1,0],["قد نفق الزور فلله ما","يكابد الحق من الباطل",35,"ل",1,0],["قد نال أسباب السعادة مغرم","يبكي بمرأى من سعادَ ومسمع",36,"ع",1,0],["قد نلت رتبة مجدٍ","على المراتب تعلو",37,"ل",2,0],["قد نصبوه فوق وا","د موحش محتدم",38,"م",1,0],["قد نلت باِست اِبنك ما لم ينل","بفرجِ بورانَ أبوها الحسَن",39,"ن",1,0],["قَد نَفَروا لِلأَمر في أَوقاتِهِ","وَالأَمرُ يَستَأنِسُ في مِيقاتِهِ",40,"ه",1,0],["قَد نَضجت آراؤه غلاما","وَرُزق الهمةَ وَالكَلاما",41,"م",2,0],["قَد نِلتَ ما نِلتَ مِنَ التَكريمِ","وَذا أَوانِ المَوعِدِ الكَريمِ",42,"م",1,0],["قَد نامَ عَنها فَنامَت غَيرَ واحِدَةٍ","لَم يَدعُها في الدَياجي لِلكَرى داعي",43,"ي",1,0],["قَد نَزَلتَ اليَومَ في باديَةٍ","عَمَرَت فيها اِمرَأَ القَيسِ الحِقَب",44,"ب",1,0],["قَد نابَ عَنكِ فَكانَ أَصدَقَ نائِبٍ","وَالشَعبُ يَهوى الصِدقَ في نُوّابِه",45,"ب",2,0],["قَد نَثَرَتهُم جُعبَةٌ","وَنَفَضَتهُم مِئبَرَه",46,"ر",2,0],["قَد نابَ عَنكَ شَديدُ الخَوفِ وَاِصطَنَعَت","لَكَ المَهابَةُ مالا تَصنَعُ البُهَمُ",47,"م",1,0],["قَد نَقَّلَت نُوَبُ الأَيّامُ مِن شِيَمي","لِكُلِّ نائِبَةٍ رَأيٌ أُجانِبُهُ",48,"ب",2,0],["قَد نالَ وَهبٌ عِندَها رِفعَةً","وَزُلفَةً فَاِزدادَ في سَطوَتِه",49,"ت",2,0],["قَد نالَ بِشرٌ مُنيَةَ النَفسِ إِذ غَدا","بِعَبدَةَ مَنهاةِ المُنى اِبنُ شُغافِ",50,"ف",1,1],["قدنا لها حتفا من الحتوف","كلبا درير الشد بالخذروف",51,"ف",1,0],["قَد نَكَّبَت ماءَ شَرجٍ عَن شَمائِلِها","وَجَوُّ سَلمى عَلى أَركانِها اليُمُنِ",52,"ن",1,0],["قَد نِلتَ مِن شَرخِ الشَبابِ وَسُكرِهِ","وَلَقَد رَأَيتَ الشَيبَ كَيفَ نَعاكا",53,"ك",2,0],["قَدنَقَّطَت في وَجهِها نُقطَةً","مَخافَةَ العَينِ مِنَ الكُحلِ",54,"ل",1,0],["قَد نَغَّصَ المَوتُ عَلَيَّ الحَياة","إِذ لا أَرى مِنهُ لِحَيٍّ نَجاة",55,"ا",2,1],["قَد نَظَرَ الناسَ بِلا عَينِ","مَن ناظَرَ الناسَ بِلا عَينِ",56,"ن",1,1],["قَد نَشَرَ الزَنبَقُ أَعلامَهُ","وَقالَ كُلُّ الزَهرِ في خِدمَتي",57,"ت",2,1],["قَد نِلتُ في رَبعِهِما","مِنَ النَعيمِ ما كَفى",58,"ا",1,0],["قد نسينا وطوينا","كل ما قبلك طيّا",59,"ي",2,0],["قد نأى عني الذي يرحمُني","والذي يفهمُ آلامي وروحي",60,"ي",1,1],["قَد نِلتُ مِنكَ الَّذي بَخِلتَ بِهِ","فَلَم أَنَل طائِلاً وَلا دَرَكا",61,"ك",2,0],["قَد نَبَذوا الحَجَفَ المَحبوكَ مِن زُؤُدٍ","وَصَيَّروا هامَهُم بَل صُيِّرَت حَجَفا",62,"ف",2,0],["قَد نابَتِ الجِزعَ مِن أُروِيَّةَ النُوَبُ","وَاِستَحقَبَت جِدَّةً مِن رَبعِها الحِقَبُ",63,"ب",1,1],["قَد نَبا بِالقَلبِ مِنها","إِذ تَواعَدنا الكَثيبا",64,"ب",2,1],["قَد نَمَت حَولَهُ الأَزاهيرُ شَتّى","وَسَقاها الهَوى عَلالَةَ راحِه",65,"ه",1,0],["قَد نَحاها فَهيَ مَسعورَةٌ","فَوقَها مِثلُ شُواظِ الضِرام",66,"م",1,0],["قَد نَراهُ وَأَهلَهُ لَم يَحُلُّوا","آهِلاً مِنهُمُ خَصِيبَ الجَنابِ",67,"ب",1,0],["قَد ناضَلوكَ فَسَلّوا مِن كِنانَتِهِم","مَجداً تَليداً وَنَبلاً غَيرَ أَنكاسِ",68,"س",1,0],["قَد نَعا الديكُ الظَلاما","فَاِسقِني الراحَ المُداما",69,"م",2,1],["قَد نَتَنَ المَجلِسُ مُذ جِئتَنا","فَكُلُّ مَن مَرَّ بِهِ يَبصُقُ",70,"ق",1,1],["قَد نِلتَ مَهرَ خِلافَةٍ","لَم تَخطُ حُسنَ صَنيعِها",71,"ع",3,0],["قد نالَ غَايَةَ ما يَرُومُ المُنْتَهِي","مِنْ رَبِّهِ وَلهُ اجتهادُ المُبْتَدِي",72,"د",2,0],["قد نالَ أسباباً إلى أفلاكِها","وسيَبْتَغي من بَعدِها أسْبابَا",73,"ب",2,0],["قَد نَضِجنا وَنَحنُ في الخَيشِ طُرّاً","أَنضَجَتنا كَواكِبُ الجَوزاءِ",74,"ا",2,1],["قَد نُقِلتُم مِنَ القُصو","رِ إِلى ظُلمَةِ الحُفَر",75,"ر",1,0],["قَد نالَ بَعضُهُمُ بَعضاً عَلى رَغَمٍ","لا أَرغَمَ اللَهُ إِلّا أَنفَ مَن رَغِما",76,"م",2,0],["قَد نَشَرَ الطومارَ في حِجرِهِ","مُبتَدِئً بِالباءِ وَالسينِ",77,"ن",1,0],["قد نشر الطومار في حجرهِ","مبتدئاً بالياءِ والسينِ",78,"ن",1,0],["قَد نامَ واشٍ وَغابَ ذو حَسَدٍ","فَاِشرَب هَنيئاً خَلا لَكَ الجَوُّ",79,"و",1,1],["قَد نالَ خَيراً في المَعاشِرِ ظاهِراً","مَن كانَ تَحتَ لِسانِهِ مَخبوءا",80,"و",3,1],["قَد نُسِخَ الشَرعُ في عُصورِهِمُ","فَلَيتَهُمُ مِثلَ شَرعِهِم نُسِخوا",81,"خ",3,0],["قَد نِلتَ مِنها ما كَفا","كَ فَما ظَفِرتَ بِما يَسُرُّ",82,"ر",1,0],["قَد نَفَضتُ السِهامَ أَبغي المَقايِي","سَ فَلَم يُثبِتِ الرَميَّةَ نَفضي",83,"ي",1,0],["قَد نَدِمنا عَلى القَبيحِ فَأَمسَي","نا عَلى غَيرِ قَهوَةٍ نَتَنادَم",84,"م",1,1],["قَد نُمتَ عَنّي وَباتَ البَرقُ يُسهِرُني","كَما اِستَضاءَ يَهودِيٌّ بِمِصباحِ",85,"ح",1,0],["قد نالَها فاِختال مستكبراً","كأَنَّه صار رعمسيسا",86,"س",2,0],["قد نقّط الزهرَ المنضور سلسلُه","وجاد بالطلّ أفوافَ السرياحين",87,"ن",1,0],["قد نامت الأدواح","مقرورة الظل",88,"ل",1,0],["قد نَزلتِ العشيَّ فيهِ على قف","رٍ جفَتهُ الحياةُ ماءً وظلا",89,"ل",2,0],["قد نزلنا السهلَ والليلَ الرهيبا","حيث ترعاني وأرعاكَ أنا",90,"ن",2,0],["قد نصب الحلمُ لهم حبائلا","وربّ حلمٍ جمع الغوائلا",91,"ل",2,0],["قد نشأ التاريخ في حجر الحَجَرْ","وشب ما بين الكهوف والحُجَرْ",92