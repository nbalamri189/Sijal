"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43804","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54270","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[19,"ودّعْ لميسَ وداعَ الصّارمِ اللاحِي","https://www.poetsgate.com/ViewPoem.aspx?id=17914",""],[100,"لا تقل لي","https://www.poetsgate.com/ViewPoem.aspx?id=50110",""],[90,"يا فراتي","https://www.poetsgate.com/ViewPoem.aspx?id=178986",""],[9,"معلقة الأعشي","https://www.poetsgate.com/ViewPoem.aspx?id=11407",""]],"verses":[["قَد نَطَقَ الصامِتُ مِن بَعدِهِ","وَأَصرَدَ النابِلُ بَعدَ المُروق",0,"ق",1,0],["قُدني إِلى ما قُدتَني قَبلَها","أَيُّ جَنيبٍ لَكَ لَم يوضِعِ",1,"ع",1,0],["قَد نَزَلنا دارَ كِسرى بَعدَهُ","أَربُعاً ما كُنَّ لِلذُلِّ ظُؤارا",2,"ر",2,0],["قَد نَهَدَ الثَديُ عَلى صَدرِها","في مُشرِقٍ ذي صَبَحٍ نائِرِ",3,"ر",1,0],["قَد نالَ أَهلَ شَبامٍ فَضلُ سُؤدَدِهِ","إِلى المَدائِنِ خاضَ المَوتَ وَاِدَّرَعا",4,"ع",2,0],["قَد نَطعَنُ العيرَ في مَكنونِ فائِلِهِ","وَقَد يَشيطُ عَلى أَرماحِنا البَطَلُ",5,"ل",1,0],["قَد نَحاها بِشَرِّهِ دونَ تِسعٍ","كانَ ما رامَ عِندَهُنَّ يَسيرا",6,"ر",2,0],["قَد نَفَضنا عَنّا الكَرى وَاِبتَدَرنا","فُرَصَ العَيشِ وَاِنتَقَلنا اِنتِقالا",7,"ل",2,0],["قَد نَجا المُنعِمُ الجَوادُ مِنَ المَو","تِ بِفَضلِ الزَكاةِ وَالإِنعامِ",8,"م",1,0],["قد نازَعَتني نَفسي أن أوَفِّيَها","وليس في طَوقِ مِثلي أنْ يُوَفِّيها",9,"ي",3,0],["قد نوَّهُوا باسمِه في جاهِلّيتِه","وزادَه سَيِّدُ الكَونَينِ تنويها",9,"ي",3,0],["قَد نُسِّقَت وَتَآلَفَت فَكَأَنَّها","في الحُسنِ مِثلَ تَآلُفِ الأَحزابِ",10,"ب",1,0],["قَد نَزَلنا جِوارَكُم فَحَمِدنا","مِنكُمُ الوُدَّ وَالنَدى وَالذِماما",11,"م",2,0],["قَد نالَني مِنكَ ما حَسبي بِهِ وَكَفى","يا مَن تَناهَيتُ في إِلطافِهِ فَجَفا",12,"ف",2,1],["قَدْ نَشَّأَتْهُ عَلَى الفَضَائِلِ وَالعُلَى","فَبِحَمْدِهَا نَطَقَ المُشِيدُ بِحَمْدِهِ",13,"د",2,0],["قَدْ نَاصَرَ الْعَدْلَ فِيه فَهْوَ مُنْتَصِرٌ","وَهَاجَمَ الْبَغْيَ فِيه فَهْوَ مُنْهَزِمُ",14,"م",1,0],["قد ناصحَ الإسلامَ خيرُ خليفةٍ","وحمى عزيز الملك أغلبُ مُشبلُ",15,"ل",1,0],["قد نتجنا لقوحها عن خداج","فلذلك انتهت بسوء النتيجه",16,"ج",2,0],["قد نُنكِر الفعل لم تألفه عادتنا","وأن علمناه من بعض المُباحات",17,"ت",1,0],["قَد نَكتَسي بِزَّةَ الجَبّارِ نَجنُبُهُ","وَالبَيضَ نَضرِبُهُ فَوقَ القَوانيسِ",18,"س",1,0],["قَد نالَ عَدلُكَ مَن أَقامَ بِأَرضِنا","فَإِلَيكَ حاجَةُ كُلِّ وَفدٍ راحِلِ",19,"ل",1,0],["قُدنا خُزَيمَةَ قَد عَلِمتُم عَنوَةً","وَشَتا الهُذَيلُ يُمارِسُ الأَغلالا",20,"ل",2,0],["قد نبذوا الإنصافَ فاعجب لمن","غدا بشهرِ الصوم نبَّاذا",21,"ذ",2,0],["قد نَفَثتُ الأدواءَ نَفْثَ وليٍّ","والعدوُّ المُكَمِّنُ الأَدواءَ",22,"ا",2,0],["قد ناصب الوردَ فمِنْ قولهِ","لا يلتقي الشِّيعيُّ والناصبُ",23,"ب",1,0],["قد نَزفْتُ المنيَّ واسْتُكَ غَرْثى","كُلَّ وقت تقول هل من مزيدِ",24,"د",1,0],["قد نحا سهماً لظبيٍ","أو لثورٍ أو حمار",25,"ر",1,0],["قد نظرنا بأعينٍ صافياتٍ","صادقاتٍ إذا مُخيلٌ أخالا",26,"ل",2,0],["قد نزّهوكَ عن الخداعِ ونكَّبوا","سُبل النفاقِ وإن جَنَوا لك ما جَنَوا",27,"ن",3,0],["قَد نالَ فَرطُ السُهادِ مِنّي","وَاِشتاقَ طَرفي إِلى الهُجوعِ",28,"ع",1,0],["قَد نَسَبوا الظُلمَ لِلسَماءِ","وَكُلُّهُم جائِرٌ ظَلومُ",28,"م",1,0],["قَد نَزَلَ الحُبُّ في فُؤادِيَ","ضَيفاً وَلَكِن عَلى الدَوامِ",29,"م",1,0],["قَد نَسَينا شُعاعَها وَسَناها","عِندَما أَشرَقَت وُجوهُ الحِسانِ",30,"ن",1,0],["قَد نَشَقتُ الأَزهارَ في كُلِّ أَرضٍ","ي شَذاهُنَّ لَستَ مِثلَ شَذاها",31,"ا",3,0],["قَد نَعى الناعونَ زَي","داناً إِلى البَدرِ سَناه",32,"ه",1,0],["قَد نَبَتَت في وَجهِهِ","فَوقَ عِظامٍ نَخِرَه",33,"ر",2,0],["قد نسينا تقصيرنا ثم أكثر","نا عتابا منا على الأيام",34,"م",1,0],["قد نفق الزور فلله ما","يكابد الحق من الباطل",35,"ل",1,0],["قد نال أسباب السعادة مغرم","يبكي بمرأى من سعادَ ومسمع",36,"ع",1,0],["قد نلت رتبة مجدٍ","على المراتب تعلو",37,"ل",2,0],["قد نصبوه فوق وا","د موحش محتدم",38,"م",1,0],["قد نلت باِست اِبنك ما لم ينل","بفرجِ بورانَ أبوها الحسَن",39,"ن",1,0],["قَد نَفَروا لِلأَمر في أَوقاتِهِ","وَالأَمرُ يَستَأنِسُ في مِيقاتِهِ",40,"ه",1,0],["قَد نَضجت آراؤه غلاما","وَرُزق الهمةَ وَالكَلاما",41,"م",2,0],["قَد نِلتَ ما نِلتَ مِنَ التَكريمِ","وَذا أَوانِ المَوعِدِ الكَريمِ",42,"م",1,0],["قَد نامَ عَنها فَنامَت غَيرَ واحِدَةٍ","لَم يَدعُها في الدَياجي لِلكَرى داعي",43,"ي",1,0],["قَد نَزَلتَ اليَومَ في باديَةٍ","عَمَرَت فيها اِمرَأَ القَيسِ الحِقَب",44,"ب",1,0],["قَد نابَ عَنكِ فَكانَ أَصدَقَ نائِبٍ","وَالشَعبُ يَهوى الصِدقَ في نُوّابِه",45,"ب",2,0],["قَد نَثَرَتهُم جُعبَةٌ","وَنَفَضَتهُم مِئبَرَه",46,"ر",2,0],["قَد نابَ عَنكَ شَديدُ الخَوفِ وَاِصطَنَعَت","لَكَ المَهابَةُ مالا تَصنَعُ البُهَمُ",47,"م",1,0],["قَد نَقَّلَت نُوَبُ الأَيّامُ مِن شِيَمي","لِكُلِّ نائِبَةٍ رَأيٌ أُجانِبُهُ",48,"ب",2,0],["قَد نالَ وَهبٌ عِندَها رِفعَةً","وَزُلفَةً فَاِزدادَ في سَطوَتِه",49,"ت",2,0],["قَد نالَ بِشرٌ مُنيَةَ النَفسِ إِذ غَدا","بِعَبدَةَ مَنهاةِ المُنى اِبنُ شُغافِ",50,"ف",1,1],["قدنا لها حتفا من الحتوف","كلبا درير الشد بالخذروف",51,"ف",1,0],["قَد نَكَّبَت ماءَ شَرجٍ عَن شَمائِلِها","وَجَوُّ سَلمى عَلى أَركانِها اليُمُنِ",52,"ن",1,0],["قَد نِلتَ مِن شَرخِ الشَبابِ وَسُكرِهِ","وَلَقَد رَأَيتَ الشَيبَ كَيفَ نَعاكا",53,"ك",2,0],["قَدنَقَّطَت في وَجهِها نُقطَةً","مَخافَةَ العَينِ مِنَ الكُحلِ",54,"ل",1,0],["قَد نَغَّصَ المَوتُ عَلَيَّ الحَياة","إِذ لا أَرى مِنهُ لِحَيٍّ نَجاة",55,"ا",2,1],["قَد نَظَرَ الناسَ بِلا عَينِ","مَن ناظَرَ الناسَ بِلا عَينِ",56,"ن",1,1],["قَد نَشَرَ الزَنبَقُ أَعلامَهُ","وَقالَ كُلُّ الزَهرِ في خِدمَتي",57,"ت",2,1],["قَد نِلتُ في رَبعِهِما","مِنَ النَعيمِ ما كَفى",58,"ا",1,0],["قد نسينا وطوينا","كل ما قبلك طيّا",59,"ي",2,0],["قد نأى عني الذي يرحمُني","والذي يفهمُ آلامي وروحي",60,"ي",1,1],["قَد نِلتُ مِنكَ الَّذي بَخِلتَ بِهِ","فَلَم أَنَل طائِلاً وَلا دَرَكا",61,"ك",2,0],["قَد نَبَذوا الحَجَفَ المَحبوكَ مِن زُؤُدٍ","وَصَيَّروا هامَهُم بَل صُيِّرَت حَجَفا",62,"ف",2,0],["قَد نابَتِ الجِزعَ مِن أُروِيَّةَ النُوَبُ","وَاِستَحقَبَت جِدَّةً مِن رَبعِها الحِقَبُ",63,"ب",1,1],["قَد نَبا بِالقَلبِ مِنها","إِذ تَواعَدنا الكَثيبا",64,"ب",2,1],["قَد نَمَت حَولَهُ الأَزاهيرُ شَتّى","وَسَقاها الهَوى عَلالَةَ راحِه",65,"ه",1,0],["قَد نَحاها فَهيَ مَسعورَةٌ","فَوقَها مِثلُ شُواظِ الضِرام",66,"م",1,0],["قَد نَراهُ وَأَهلَهُ لَم يَحُلُّوا","آهِلاً مِنهُمُ خَصِيبَ الجَنابِ",67,"ب",1,0],["قَد ناضَلوكَ فَسَلّوا مِن كِنانَتِهِم","مَجداً تَليداً وَنَبلاً غَيرَ أَنكاسِ",68,"س",1,0],["قَد نَعا الديكُ الظَلاما","فَاِسقِني الراحَ المُداما",69,"م",2,1],["قَد نَتَنَ المَجلِسُ مُذ جِئتَنا","فَكُلُّ مَن مَرَّ بِهِ يَبصُقُ",70,"ق",1,1],["قَد نِلتَ مَهرَ خِلافَةٍ","لَم تَخطُ حُسنَ صَنيعِها",71,"ع",3,0],["قد نالَ غَايَةَ ما يَرُومُ المُنْتَهِي","مِنْ رَبِّهِ وَلهُ اجتهادُ المُبْتَدِي",72,"د",2,0],["قد نالَ أسباباً إلى أفلاكِها","وسيَبْتَغي من بَعدِها أسْبابَا",73,"ب",2,0],["قَد نَضِجنا وَنَحنُ في الخَيشِ طُرّاً","أَنضَجَتنا كَواكِبُ الجَوزاءِ",74,"ا",2,1],["قَد نُقِلتُم مِنَ القُصو","رِ إِلى ظُلمَةِ الحُفَر",75,"ر",1,0],["قَد نالَ بَعضُهُمُ بَعضاً عَلى رَغَمٍ","لا أَرغَمَ اللَهُ إِلّا أَنفَ مَن رَغِما",76,"م",2,0],["قَد نَشَرَ الطومارَ في حِجرِهِ","مُبتَدِئً بِالباءِ وَالسينِ",77,"ن",1,0],["قد نشر الطومار في حجرهِ","مبتدئاً بالياءِ والسينِ",78,"ن",1,0],["قَد نامَ واشٍ وَغابَ ذو حَسَدٍ","فَاِشرَب هَنيئاً خَلا لَكَ الجَوُّ",79,"و",1,1],["قَد نالَ خَيراً في المَعاشِرِ ظاهِراً","مَن كانَ تَحتَ لِسانِهِ مَخبوءا",80,"و",3,1],["قَد نُسِخَ الشَرعُ في عُصورِهِمُ","فَلَيتَهُمُ مِثلَ شَرعِهِم نُسِخوا",81,"خ",3,0],["قَد نِلتَ مِنها ما كَفا","كَ فَما ظَفِرتَ بِما يَسُرُّ",82,"ر",1,0],["قَد نَفَضتُ السِهامَ أَبغي المَقايِي","سَ فَلَم يُثبِتِ الرَميَّةَ نَفضي",83,"ي",1,0],["قَد نَدِمنا عَلى القَبيحِ فَأَمسَي","نا عَلى غَيرِ قَهوَةٍ نَتَنادَم",84,"م",1,1],["قَد نُمتَ عَنّي وَباتَ البَرقُ يُسهِرُني","كَما اِستَضاءَ يَهودِيٌّ بِمِصباحِ",85,"ح",1,0],["قد نالَها فاِختال مستكبراً","كأَنَّه صار رعمسيسا",86,"س",2,0],["قد نقّط الزهرَ المنضور سلسلُه","وجاد بالطلّ أفوافَ السرياحين",87,"ن",1,0],["قد نامت الأدواح","مقرورة الظل",88,"ل",1,0],["قد نَزلتِ العشيَّ فيهِ على قف","رٍ جفَتهُ الحياةُ ماءً وظلا",89,"ل",2,0],["قد نزلنا السهلَ والليلَ الرهيبا","حيث ترعاني وأرعاكَ أنا",90,"ن",2,0],["قد نصب الحلمُ لهم حبائلا","وربّ حلمٍ جمع الغوائلا",91,"ل",2,0],["قد نشأ التاريخ في حجر الحَجَرْ","وشب ما بين الكهوف والحُجَرْ",92,"ر",1,0],["قد نزل اليتم به جنينا","لم يتهيب سيدنا البنينا",93,"ن",2,0],["قد نصروا الله وبرّوا الهادي","ووصلوا الجهاد بالجهاد",94,"د",1,0],["قَد نالَ بِالهادي الكَريمِ وَبِالهُدى","ما لَم تَنَل مِن سُؤدُدٍ سيناءُ",95,"ا",2,0],["قد نَهاني النَّصيحُ عنهُ مراراً","بأبي أَنتَ مِن نصيحٍ وأُمِّي",96,"ي",1,0],["قَدْ نِيلَ مِنْ أَقْدَامِهِمْ بِعِقَالِهِمْ","أَمَّا النُّفُوسُ فَلَمْ تُنَلْ بِعقَالِ",97,"ل",1,0],["قَدْ نَافَسَ الأَيامَ لَكِنَّهُ","نَافسَهُ اليَوْمُ الَّذِي نَحْضَرُ",98,"ر",1,0],["قَدْ نوَّلَتْ يَدَهَا صُنَّاعُ يَدٍ","فِي الْفَنِّ مَرْفوعاً لَهُ ذِكْرُ",99,"ر",1,0],["قد نشدناكَ عندَ كلَّ قناةِ","وعلى كل أيكةٍ غرِّيده",100,"د",2,0],["قُدني إِذا كُنتَ في فَريقٍ","فازوا إِلى ذلِكَ الفَريقِ",101,"ق",1,0],["قَد نَبا كُلُّ صارِمٍ","وَكَبا كُلُّ فارِسِ",102,"س",1,0],["قَد نافَسَ الغَيبُ الحُضورَ عَلى الَّذي","شَهِدوا وَقَد حَسَدَ الرَسولَ المُرسِلُ",103,"ل",1,0],["قدْ نَعَينا فَرداً به كان عَصْراً","وفَقَدْنا عَصْراً به كان فَرْدا",104,"د",2,0],["قد نظَمْتَ العُلاَ قِلادَةَ دُرٍّ","فَنظمْتُ الدّموعَ أَرْثيكَ عِقْدا",104,"د",2,0],["قد نَعِمْنا بِالْهَوَى زَمَناً","وشَقِينا آخشرَ الزَّمَنِ",105,"ن",1,0],["قَدْ نَكِرْنَاهُ حِين قَامَ يُنَادِي","وَفَهِمْنَا مَعْنَاهُ يَوْمَ احْتِسَابِهْ",106,"ب",2,0],["قَدْ نَقَدْنَا لَكَ الْقَوَافي صحَاحاً","مِثْلَمَا يَنْقُدُ الشَحِيحُ النقُودَا",107,"د",2,0],["قَدْ نَثَرْنَا لَكَ الْوُرُودَ قُلُوباً","وَنَثَرْنا لَكَ الْقُلُوبَ وُرُودا",107,"د",2,0],["قد نُسِّقَتْ فيه أزهارُ الربا أُصُصًا:","ورد، وآسٌ، ونَسرينٌ، وريحان",108,"ن",1,0],["قد نمتَ عنّي وباتَ البرقَ يُسهرني","كما استْتَضاءَ يَهوديٌّ بِمِصْباحِ",109,"ح",1,0],["قد نسيت اللّقاء يوما وإنّي","لست أدري متى نسيت الفراقا ؟",110,"ق",2,0],["قد نطقنا حتَّى رُمينا بهُجْرٍ","وسكتنا حتَّى اتُهِمنا بِعي",111,"ي",1,0],["قد نخضب العير في مك