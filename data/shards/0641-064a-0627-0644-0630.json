{"poems":[[55,"هي ما علمت فهل ترد همومها","https://www.aldiwan.net/poem29757.html","الكامل"],[53,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[71,"وافى الكتاب الذي تعنو له الكتب","https://www.aldiwan.net/poem29125.html","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202533","الرجز"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[132,"لله في الأرض أقوام قد اشتملوا","https://www.aldiwan.net/poem50553.html","البسيط"],[136,"كنا إذا مسنا من دهرنا نكد","https://www.aldiwan.net/poem54643.html","البسيط"],[371,"إن كنت تترعه كأسا لمكتئب","https://www.aldiwan.net/poem17314.html","البسيط"],[396,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[484,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104686","الكامل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118920","الدوبيت"],[3123,"","https://poetry.dctabudhabi.ae/diwan/poem/21151","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129374","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117942","البسيط"],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135654","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81241","السريع"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83177","البسيط"],[5237,"أنوار سيدنا النبي المرسل","https://www.poetsgate.com/ViewPoem.aspx?id=113114",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[5431,"ولم أزل ممشيا!","https://www.poetsgate.com/ViewPoem.aspx?id=192762",""],[5956,"آخر دمعة","https://www.poetsgate.com/ViewPoem.aspx?id=193309",""],[5956,"غرِّدْ أيا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=200909",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["في الذاهِبِ المَوروثِ سَلوَةُ وارِثٍ","وَأَمَرُّ ما وَرِثَ الرِجالُ غُمومُها",0,"م",3,0],["في الذي بين ترْمَتَيْكَ وبيني","خلفٌ منْ وصالكَ المصروم",1,"م",1,0],["في الذوقِ تحلو وفي الأسماعِ تعذب إذْ","في السبْقِ تملُحُ حسناً هكذا القصبُ",2,"ب",1,0],["في الذّكْر لم يغفل لهم حديثُ","وذكرهم سيرّه الحديثُ",3,"ث",1,0],["في الذب عن حرمات الله شأنهم","لا شأن دنياهم نيل وحرمان",4,"ن",1,0],["في الذكرِ أصلُ له والأصلُ متبعٌ","وقد رَوَتْه ثقاتٌ سادةٌ فَضُلُوا",5,"ل",3,0],["في الذب عن حرمات الأولياء وفي","نصر الموالي لهم والناس قد حَسَدُوا",6,"د",3,0],["في الذُلِّ في السِجنِ خَلَّفتُم مُحِبَّكُمُ","مِن بَعدِ تَخليدِكُم بِالحَمدِ في الكُتُبِ",7,"ب",1,0],["في الذكر كل الجوائز","هنا وبعد الجنائز",8,"ز",1,0],["في الذي يرى حسنا","لا تراه مجتنبا",9,"ب",2,0],["في الذِّكر بسمِ اللهِ تُوِّجَتِ السُّوَر","وَبِهِ أُتَوِّجُ مِيلادٍ أَغَر",10,"ر",1,1],["في الذر عرفتكم فلا أنساكم","يا من بهواهم جرى المقدور",11,"ر",1,0],["في الذاهِبينَ الأَوَّلي","نَ مِنَ القُرونِ لَنا بَصائِر",12,"ر",1,1],["في الذل يعلوه الهوان ولا سرى","بين الورى إلا بوجه باسر",13,"ر",1,0],["في الذكر جاء وفي الأخبار مدحهم","مكرّراً فبماذا تنعت البلغا",14,"غ",2,0],["في الذهن علة لها في الواقع","فذاك باللمي عندهم دعي",15,"ي",1,0],["في الذكر لا يك فتورْ","في ذي الحياة والمماتْ",16,"ت",1,0],["في الذود عن طروادةٍ ونسائها","ما انتابه جزعق ولا عرف المفر",17,"ر",1,0],["فَيا لذياك وَما شَأنه","يُعانق الجَنة في غانِيَه",18,"ه",1,0],["في الذِّكرَياتِ وَفاءٌ أَستَعِيضُ بِه","عَمَّن فَقَدتُ وَوُدٌّ لَيسَ يَنتَقِلُ",19,"ل",1,0],["في الذكر والكتب المنزلة العلى","بمناقب ومحاسن وفضائل",20,"ل",1,0],["فيا لذة الأسماع إن قيل قد أتى","إلينا بريد الارتحال من الهند",21,"د",1,0],["في الذكر هلّت أحرفي ميمي لها","صار المدى متلألئا فضيّا",22,"ي",2,0],["في الذل مقبورون باقي العمرِ","ونعيش عالاتٍ على اْبني البِكْرِ",23,"ر",1,1],["في الذكرياتِ لذاذةٌ لكنها","يا ليتها ليست تثير الأدمعا",24,"ع",2,0],["في الذنب والصالح والمفرط","بالمانع الحفاظ في التورط",25,"ط",1,0]]}