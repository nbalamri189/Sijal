{"poems":[[95,"هل آية في السلم والحرب","https://www.aldiwan.net/poem9789.html","عموديه"],[53,"أدار العامرية بالوحيد","https://www.aldiwan.net/poem61884.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39625","السريع"],[123,"هل زيدت الشمس للأنوار أنوارا","https://www.aldiwan.net/poem4350.html","البسيط"],[132,"بعادك يا عذب الثنايا ولا الصد","https://www.aldiwan.net/poem50635.html","الطويل"],[228,"لمن يا ترى أشكو بمدمعي الهمل","https://www.aldiwan.net/poem41906.html","الطويل"],[310,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[382,"سلوا عني نغول بني الزناء","https://www.aldiwan.net/poem66979.html","الوافر"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122323","المتقارب"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122350","المنسرح"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126156","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55927","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132362","الوافر"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79711","الوافر"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130048","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48456","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117857","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83619","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33385","المنسرح"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105171","الرجز"],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4578,"أبانت فوق حاجبها المصون","https://www.poetsgate.com/ViewPoem.aspx?id=49534",""],[5183,"نكبات الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=186413",""],[5277,"بيني وبينها","https://www.poetsgate.com/ViewPoem.aspx?id=186896",""],[5351,"هنا صنعاء هنا صعدة","https://www.poetsgate.com/ViewPoem.aspx?id=202119",""],[5419,"خيرٌ وأبقى","https://www.poetsgate.com/ViewPoem.aspx?id=39918",""],[5956,"أرجو أن يزيد الله وعيي","https://www.poetsgate.com/ViewPoem.aspx?id=185669",""]],"verses":[["تَبُثُّ في العَقلِ نَشَاطَ المُنَى","وَتَبْعَثُ النَّجْدَةَ فِي القَلْبِ",0,"ب",1,0],["تَبثُّ حديث أمك ذي المخازي","وباخرْزيِّها نجْل اليهودِ",1,"د",1,0],["تبثُّ المراعيَ نوراً يشفُّ","ويجلو الطهارةَ في النظرةِ",2,"ه",1,0],["تبثُّ يُمناه زهراً في الطروس ولا","نكرٌ على السحب أن ينبتن أزهارا",3,"ر",2,0],["تبث ثناءَ ليس يحجبُ سيْرَها","إذا غامرتْ في السيرِ غورٌ ولا نجدُ",4,"د",1,0],["تَبثُّ من الأَغراضِ فيهِم مبادئاً","أَشدَّ بِجِسم الإِجتِماعِ من السلِّ",5,"ل",1,0],["تَبثُّ طلائعَ البشرى فَتزهى","لَها في كلّ رابيةٍ بنودُ",6,"د",1,0],["تَبثُّ الشكرَ بينَ يدي مليكٍ","مطوّقةٌ بِنعماه الجيودُ",6,"د",1,0],["تَبُثُّ سمومَها في كُلِّ نَفسٍ","ويرشَحُ ظاهِراً ما في الإناءِ",7,"ا",2,0],["تبثك شجو متاعي الذي","رميت به في كساد الرجال",8,"ل",1,0],["تبثك شجو غريب الديرا","غريب المتاع غريب المثال",8,"ل",1,0],["تبثك الشوق عن فؤاد شح","اشفى ولكن في ضمنها الغلل",9,"ل",1,0],["تبثك من الشوق يا خير ماجد","وتهدي تحايا الود طيبة النشر",10,"ر",1,0],["تبثَ الثنا في بدءها واختتامها","وتبدى الدعا بفضلك الجم تشكرُ",11,"ر",1,0],["تَبُثُّ نَمارِقَ الصُّوَّى بكفٍّ","بهِ تطوي طنافِسَةَ الرّمَالِ",12,"ل",1,0],["تبث الحزن عن عاف ذليل","وتروي الوجود عن صب عميد",13,"د",1,0],["تبثّ في نفسِها ما شاء مُنشِئها","منَ الغرورِ فتنسى المجد والشمَما",14,"م",2,0],["تبُثُّها في أقاصي الخافقَيْنِ بما","تخُطُّهُ يدُكَ العُليا وترْسُمُهُ",15,"م",2,0],["تبث إليّ شكواها فأشكو","إليها والدموع لها انسجام",16,"م",1,0],["تبثّ علياك شوقي لِلّقاء كما","تقبل الأَرضَ عنّي وهي تائِبَتي",17,"ي",1,0],["تبثُّ عيناهُ من فتورهِما","على العيونِ الفتونَ والبِدَعا",18,"ع",2,0],["تبث شكواها لما أصابها","له وتبدي كل شي مكمد",19,"د",1,0],["تبثبث عن غور المعاني بمحكم ال","مباني وتهدي للطريق بعرفان",20,"ن",1,0],["تبث إليك شوقاً من خليلٍ","تخلل في حشاه هوى العيونِ",21,"ن",1,0],["تبث بهم روح الشريعة والهدى","وتسعى بهم في حضرة القدس مطرقا",22,"ق",2,0],["تبثُّكِ الشدوَ عمَّن باتَ مرتحلاً","كأنهُ الفلكُ تجري في دجى اللُّجَجِ",23,"ج",1,0],["تبث أنينها لله شجواً","فيظهر نصرها في كل هامة",24,"م",2,0],["تبثّينَ فيَّ يقيناً بربّي","فيعبق في النفس كالمسكِ عبقا",25,"ق",2,0],["تَبُثُّ الروحُ ضوءاً مستديماً","من الخلَّاق لا تَسْوَدُّ يوما",26,"م",2,0]]}