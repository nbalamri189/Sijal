,"https://poetry.dctabudhabi.ae/diwan/poem/132672","البسيط"],[3290,"","https://poetry.dctabudhabi.ae/diwan/poem/100709","المتدارك"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109963","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131263",""],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139254","الخفيف"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139186","الخفيف"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139150","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120481","الخفيف"],[4718,"شلت روحي بين كفيني","https://www.poetsgate.com/ViewPoem.aspx?id=137101",""],[4782,"من يخبر الصبح...؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=198725",""],[4940,"سيف التجاهل","https://www.poetsgate.com/ViewPoem.aspx?id=210451",""],[4955,"قالوا أما للحب عيد قلت لا","https://www.poetsgate.com/ViewPoem.aspx?id=195096",""],[5081,"مَنْ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=191363",""],[5150,"العاشقه ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204341",""],[5225,"يا نسناسْ الهبايبْ","https://www.poetsgate.com/ViewPoem.aspx?id=27611",""],[5431,"من يخبر الأرض؟...","https://www.poetsgate.com/ViewPoem.aspx?id=198396",""],[5533,"ما بَيْنَ بُرْدَيَّ","https://www.poetsgate.com/ViewPoem.aspx?id=181664",""],[5542,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=10200",""],[5573,"خالي انتم خابرينه","https://www.poetsgate.com/ViewPoem.aspx?id=201921",""],[5674,"يعيد لي العطار وجه زماني","https://www.poetsgate.com/ViewPoem.aspx?id=185902",""],[5885,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=194688",""],[6152,"ولاّدة العصر","https://www.poetsgate.com/ViewPoem.aspx?id=203139",""],[5393,"رب شيخ يمد للحق رجلاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85468&r=&rc=35",""]],"verses":[["منْ يخوضُ الردى إذا كان من فَرْ","رَ أثابوهُ بالثوابِ الجزيلِ",0,"ل",1,0],["مَنْ يخَفْ من زوالِ نُعمى عليه","آل وهبٍ فلن تخافوا زوالا",1,"ل",2,0],["من يَخْلُ من جزع لضَيْعة حُرْمةٍ","من مثله فالمجدُ غيرُ خَليِّ",2,"ل",2,0],["مَن يَخلَعُ النيرَ يَعِش بُرهَةً","في أَثَرِ النيرِ وَفي نَدبِهِ",3,"ب",2,0],["مُنيخٌ بِمَثوى المَجدِ مِن ظِلِّ أَروَعٍ","وَدورُ الأَعادي دارِساتُ المَعالِمِ",4,"م",1,0],["مَن يَخضُبُ الشَعَراتِ يُحسَبُ ظالِماً","وَيُعَدُّ أَخرَقَ كَالظَليمِ الخاضِبِ",5,"ب",1,1],["مَنْ يُخْبِرُ الليلَ إذ جَنَّتْ حنادِسُهُ","والرّمْلَ عنّي لمّا طُلّ أوْ جِيدا",6,"د",2,0],["مَن يختلف كلّ الورى في حُبِّهِ","فَأبو المطرّف حبُّه إِجماعُ",7,"ع",1,0],["منى خالجت نفسي وأحبب بها منى","تريني حياتي فوق الشهب النيازك",8,"ك",1,0],["مَن يُخبر الآباء عَني أَنَّني","حُزت العُلا مُذ صرت مِن أَتباعِهِ",9,"ه",1,0],["مَن يُخمِدُ الحَربَ العَوانَ بِنارِهِ","يُردي الكُماةَ وَيَحطِمُ الأَبطالا",10,"ل",2,0],["مَن يُخبر الصادق القَول الأَمين عَلى ال","مَلا وَمَن لي بِأَنَّ الدَهر يُخبرهُ",11,"ر",2,0],["مَن يُخبر الغَيث أَنّ اليمّ نائله","أو يُنذر اللَيث مِن خَطب بِهِ فَدحا",12,"ح",2,0],["من يخبر الدنيا ويسبُرْ بخسَها","يعرف غناه ويتقي الأرزاء",13,"ا",2,0],["مني خياله وصاله متباعد","حسبي لتسليتي وصال خياله",14,"ل",2,0],["من يخبر القوم عني يا كرام الحي","بأن نفسي لقد ماتت وقلبي حي",15,"ي",1,1],["مُنِيْخٌ عَلَيَّ بِمَكْرُوهِهِ","مُضِبٌّ عَلَى حِقْدِهِ المُضْطَغِنْ",16,"ن",1,0],["مَن يَخُنْ فيها فَهوَ غَير لَبيبٍ","إِنَّ غَيرَ اللّبيبِ غَيرُ أَمينِ",17,"ن",1,0],["من يختم المولى له","بالخير يستوفي الظفر",18,"ر",1,0],["من يخجل البدر التما","م اذا م عن وجه سفر",19,"ر",1,0],["من يُخبِرُك بِشَتمِ عَن أَخ","فَهوَ الشاتِم لا من شَتَمَك",20,"ك",1,1],["مَن يَخُنكَ الصَفاءُ أَو يَتَبَدَّل","أَو يَزُل مِثلَما تَزولُ الظِلالُ",21,"ل",1,0],["مَن يَخطب الحَسناء يُغلِ مَهرَها","إِن الحِسان فَواركُ البُخَلاء",22,"ا",2,0],["من يُخبر الأفلاك ان علومها","من بعده قصرت عقول رواتها",23,"ت",3,0],["من يخجل البد في الاغلاس","ويفضح الظبي والأغصان",24,"ن",1,0],["مَن يُخبِركَ بِسَبٍّ عَن أَخٍ","فَهُوَ الشاتِمُ لا مَن شَتَمَك",25,"ك",1,1],["من يخلق الله للدنيا فأنهم","لنصرة العترة الهادين قد خلقوا",26,"ق",3,0],["مَن يَخطِب حُورَ الخُلدِ بِها","يَضفَر بِالحُور وَبالغُنجِ",27,"ج",1,0],["من يخسر العمر والدنيا بهم ربح","الدارين في حبهِ حسن اتباعهمِ",28,"م",1,0],["من يخدم الدنيا الدنية طائعاً","استخدمته كارهاً مجبورا",29,"ر",2,1],["من يخترمه الموت حال جهاده","فحياته بمماته تتجدد",30,"د",1,0],["من يخف شره يوف الكرامه","ويوالى الرعاية المستدامه",31,"ه",1,1],["من يخالف في شيء الناس يرجع","هدفاً للسهام من كل راشق",32,"ق",1,0],["من يخذل الإخوان يخذل نفسه","ويهن ما لهوانه عز",33,"ز",1,0],["من يخل قصره وما يتسرى","فيه فخرا له فذاك المعاب",34,"ب",1,0],["من يخون الارض خان العرض هذا بلاكيد","جيبو ارقاب الشراذم بالسيوف انقدها",35,"د",3,0],["من يخبر الصبحَ أن الروحَ تهواهُ","وما لطلَّتهِ في الحسْنِ أشباهُ",36,"ا",2,1],["من يخط فيه إلى الأمام فما له","عَود كشلال بدا مُنصَبَّا",37,"ب",2,0],["من يختصر ذاكَ الشعورَ بموعدٍ","فكأنَّما منهُ الفؤادُ حديدُ",38,"د",1,0],["مَنْ يُخْرِجُ الْخَبْءَ الَّذِي بِسَحَابَةٍ","أَوْ كَانَ زَرْعٌ دُونَهَا مُتَأَصِّلَا ؟",39,"ل",2,0],["من يخشى الحب يصادفُهُ","إن هابَ لقاءَه أو راقَهْ",40,"ق",2,0],["من يختلط في النّايبْ","إرغاها والحنينْ",41,"ن",1,0],["من يُخبر الأرض أنّا لن نضيع سُدى","فحارس الغيم مفتونٌ بها وعدا",42,"د",2,1],["من يخبر الشط عن غرقى بعشقهمُ","فوق السحاب مضوا حيث الحنين بدا",42,"د",2,0],["من يُخْبِرُ البرَّ أَنَّ البَحْرَ أَغْرَقَهُمْ","لم يَبْقَ ما جَمَعُوا لم يَبْقَ ما حَلمُوا",43,"م",3,0],["مَنْ يخدم الحرمين يأَنَفُ أنْ يرى","أقصاكِ في صَلَفِ اليَهودِ يُهانُ",44,"ن",1,0],["من يخوضون المعارك حصلو منه الغبينه","تصبح اسياد المعارك لا تلاقت به جبانه",45,"ن",2,0],["منْ يُخْمِدُ البركانَ في شرياني","ويصُبُّ في بحرِ الهوى أشجاني",46,"ن",2,1],["من يخلي ترابه وحماه","فهو في نفسه أثيم أثيم",47,"م",1,0],["من يخبر الصبح عن قلب تملكني","فبات شريانه في حبكم ثملا",48,"ل",2,0],["من يخرون سجداً كي ينالوا","بعض مال أو منصباً مرموقا-",49,"ق",2,0]]}