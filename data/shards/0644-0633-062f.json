{"poems":[[55,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[74,"ما الطرف بعدكم بالنوم مكحول","https://www.aldiwan.net/poem19466.html","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36768","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133232","البسيط"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143040","الطويل"],[5213,"لهوّن بعد اليوم ما يفعل الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=170487",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""]],"verses":[["لِسَدِّ ثَغرٍ فاغِرٍ","بِالبيضِ أَو طَعنِ ثُغَر",0,"ر",1,0],["لسدرة المنتهى يا منتهى طلبي","ما مثله يا ختام الرسل تحويل",1,"ل",1,0],["لِسَدَّتِهِ العُليا رَفعتُ ظُلامَةً","عَليّ جَناها صَرفُهُ المُتَتابِعُ",2,"ع",1,0],["لسدرة المنتهى جبريل أوصله","والنور بالسر يغشاه ويغشاه",3,"ا",2,0],["لسدت بنوها الأفق بالخيل والقنا","وردت شعاع الشمس في نسجها النقعا",4,"ع",2,0],["لسدد سهم الغدر تلقاء هاشم","فما اخطأ المرمى ولا سلم النحر",5,"ر",1,0],["لسدرة المنتهى حين انتهى صعدا","رأى الذي علمه للخلق مجهول",6,"ل",1,0]]}