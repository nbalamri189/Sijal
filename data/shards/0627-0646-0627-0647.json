www.poetsgate.com/ViewPoem.aspx?id=177158",""],[6102,"شَظايا خَزَف ..","https://www.poetsgate.com/ViewPoem.aspx?id=184420",""],[6102,"لن أعود","https://www.poetsgate.com/ViewPoem.aspx?id=184867",""],[6170,"أجتازُ هِجرَتنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86031&r=&rc=2",""],[6189,"قراءة لعوامل التعرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83585&r=&rc=52",""],[6225,"تسرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78013&r=&rc=100",""],[6308,"إني أحبكَ أكثر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87729&r=&rc=7",""],[5567,"محارة الرمل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69068&r=&rc=2",""],[6355,"يوم الفداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66542&r=&rc=2",""],[572,"يا أَيُّها الصَّلِفُ المدلُّ بِحُسْنِهِِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9224&r=&rc=81",""]],"verses":[["إِن أُهدِ أَشعاري إِلَيكَ فَإِنَّهُ","كَالسَردِ أَعرِضُهُ عَلى داوودِ",0,"د",1,0],["أَناةٌ حَكاها الظَّبيُ جِيداً وَمُقلَةً","وَلَيسَ لَها في حُسنِها بِعَديلِ",1,"ل",1,0],["أَناةٌ عَلَيها مِن سَنا البَدرِ مَيسَمٌ","وَفيها مِنَ الغُصنِ النَضيرِ شَمائِلُ",2,"ل",1,0],["أَناةٍ كَأَنَّ المِسكَ أَو نَورَ حَنوَةٍ","بِمَيثاءَ مَرجوعٌ عَلَيهِ التِثامُها",3,"م",3,0],["أَناةً بَخَنداةً كَأَنَّ إِزارَها","إِذا اِنجَرَدَت مِن كُلِّ دِرعٍ وَمِفضَلِ",4,"ل",1,0],["أَناةٍ كَأَنَّ المِرطَ حينِ تَلوثُهُ","عَلى دِعصَةٍ غَرّاءَ مِن عُجَمِ الرَملِ",5,"ل",1,0],["أَناةٌ تَلوثُ المِرطَ مِنها بِدِعصَةٍ","رُكامٍ وَتَجتابُ الوِشاحَ فَيَقلَقُ",6,"ق",1,0],["أَناةُ يَطيبُ البَيتُ مِن طيبِ نَشرِها","بُعَيدَ الكَرى زَينٌ لَهُ حينَ تُصبِحُ",7,"ح",1,0],["إن أهل الفقر يشقّو","ن لأرباب الثراء",8,"ا",2,0],["أَناةٌ لا النَمومُ لَها خَدينٌ","وَلا تُهدي لِجارَتِها السَبابا",9,"ب",2,0],["أنا هاجيك ما سَكتَّ ومُعفي","ك إذا ما هجوتَني من هجائي",10,"ا",2,0],["إنّ أهل القريض طوراً يرقّو","ن وطوراً تراهم أجلافا",11,"ف",2,0],["أناة إذا باغ أبى أن يودنا","عليها أقمنا للعداوة سوقها",12,"ق",3,0],["انا هذا ولست اقوى على تغيير","نفسي يوماً او استعدادي",13,"د",2,0],["انا هذا ولست اقوى على تغيير","ما في خلقي او استعدادي",14,"د",2,0],["أَناةً أَيُّها الفَلَكُ المُدارُ","أَنَهبٌ ما تَطَرَّفُ أَم جُبارُ",15,"ر",1,1],["أُناهِبُهُ الأَدنَينَ وَالأَبعَدَ الَّذي","أَتاكَ بِهِ مِن أَبعَدِ الأَرضِ جالِبُه",16,"ب",2,0],["أَناةٌ كَرِئمِ الرَملِ نَوّامَةُ الضُحى","بَطيءٌ عَلى لَوثِ النِطاقِ بُكورُها",17,"ر",3,0],["أَناةً وَحِلماً وَاِنتِظارَ عَشيرَةٍ","لِأَدفَعَ عَنّي جَهلَ قَومِيَ مَدفَعا",18,"ع",2,0],["إِنَّ اهتمامَكَ بالهدى عن همّةٍ","علويَّةِ الإِصدارِ والإِيرادِ",19,"د",1,0],["أَنَاةٌ بَرَاهَا اللَّهُ فِي الْحُسْنِ آيَةً","يَدِينُ إِلَيْهَا جَاهِلٌ وَحَلِيمُ",20,"م",1,0],["إنَّ أهلَ العصرِ عندي","هكذا إلا قليلا",21,"ل",2,0],["إِنَّ أَهوى العِبادَ شَخصاً إِلَينا","وَأَلَذَّ العِبادِ نَغماً وَدَلّا",22,"ل",2,1],["أناة أيها الحادي فإنا","وجدنا منك ما تجد الركاب",23,"ب",1,0],["إنْ أهلُهُ إلاّ الأُلى استوطنوا","دارَ الوغَى في دُومةِ الجندلِ",24,"ل",1,0],["إنَّ أهلَ الهوَى يَخافونَ يوماً","بِالجَفَا كانَ شَرُّهُ مُستَطيرَا",25,"ر",2,0],["إِن أَهاجوا بِآلِ أَحمَدَ حَرباً","بِبَنيكُم لا تَحلُبوا في إِنائي",26,"ا",2,0],["إنّ أهل القضاء ما أنصفوكم","فكأنَّ القلوبَ منهم صخور",27,"ر",1,0],["أَنَاةٌ كَأَنَّ المِسْكَ دُونَ شِعَارِهَا","يُبَكِّلهُ بِالعَنْبَرِ الوَرْدِ مُقطِبُ",28,"ب",1,0],["أنا هنا ، أعلى الربى قامة","يداي لا تلقى اليمين اليسار",29,"ر",1,0],["أنا هذا أنا – وما كنتُ يوماً","في شُعوري ونَزعتي بمَلاك",30,"ك",1,0],["أَنَاة ٌ كَأَنَّ المِسْكَ دُونَ شِعَارِهَا","يُبَكِّيهِ بالعَنبَرِ الوردِ مُقطبُ",31,"ب",1,0],["أنا هُنا . بعد عامٍ من قطيٍعتنا","ألا تمُدَّين لي بعد الرجوع يدا؟",32,"د",2,1],["أنا هُنا مُتَابعٌ نَغْمَةً","قادمةً من غابةِ البيلسانِ",33,"ن",1,0],["أنا هُنا وفي يدي ثَرْوَةٌ","عيناكِ والليلُ وصوتُ البِيانِ",33,"ن",1,0],["إن أهاجُوا بآلِ أحمدَ حرباً،","بينكم ! لا تحلبُوا في إنائي",34,"ا",2,0],["أنا هواكَ فطرة ً ، ليسَ فيها","مِنْ مَسَاغٍ لِلنَّقْضِ وَالإِبْرَامِ",35,"م",1,0],["ان أهل الديون أضنوا فؤادي","أكفنيهم كفيت يوم القيام",36,"م",1,0],["أَنا هزارٌ وَقلبُ ال","شَبابِ يَهوى نَشيدي",37,"ي",1,0],["أَنا هزار في اللَيلِ أَشدو","لَحني عَلى مَسمَح الدهورِ",38,"ر",1,0],["إِنَّا هَمَمْنَا بِأَمْرٍ","مَنَعَ مِنْهُ انْزِعَاجُكْ",39,"ك",1,0],["إِنَّ أهْلي قد رَمَوْني","بِجُنونٍ، فاسْعِفيني",40,"ن",2,0],["إنّ أهل الغرام زمرة عشقي","كلّهم قد رووا أحاديثَ فنّي",41,"ن",2,0],["أَناةٌ مُنَقّاةٌ نَقاةٌ لَوَ اَنَّها","تُخايِلُ عَينَ الشَمسِ ظَلّت تَروقُها",42,"ق",3,0],["أنا هو الناقوس والمعمَدان","والمعبد القدسي وروح الصلاه",43,"ه",1,0],["انا هذا اليوم لن تلقا","ني في هذي الديار",44,"ر",1,0],["أنا هو بأس العواصف فافهم","لماذا أصونك من هوى عنفي",45,"ف",2,0],["اِن أَهل البَديع قالوا جَميعاً","أَنتَ شيخ التَأصيل وَالتَفريع",46,"ع",1,0],["إِنَّ أَهلَ السَّماءِ فيكُم وأهلَ ال","أَرضِ مادامَتا لأهل افتراقِ",47,"ق",1,0],["أنا هاشمي فطميُّ نسبتي","إلى حَسَنٍ سِبْط الرسول محمد",48,"د",1,0],["أَناةٌ بَراها اللَهُ أَكمَلَ صورَة","فَأَردَفَت الأَرداف واختَصر الخصرُ",49,"ر",1,0],["أَناة كَمِثلِ الشَمسِ نوراً وَعادَة","فَفيها دُنوٌ مطمعٌ وَبعادُ",50,"د",1,0],["أنا ههنا في موطني لكن لي","قلبا يهيم بشارع الأحباب",51,"ب",1,0],["إن أهلي في كل أرض بها الحق","عريق وباسمه تتغنى",52,"ن",2,0],["أناةٌ ومن تحت القطوبِ تبسُّمٌ","أواناً وفي عقب الأناةِ مكايدُ",53,"د",1,0],["أناةٌ واِقدامٌ ولِينٌ وشِدَّةٌ","وعونٌ على الأيام في العسر واليسر",54,"ر",1,0],["أناةٌ كعاديِّ الجِبالِ رَزينَةٌ","وفتْكٌ كأطراف الرِّماحِ الشوارع",55,"ع",1,0],["أنا هو ذاك الطفل الأم ووالد","ومن بأخيه كان في الأهل رابعا",56,"ع",2,0],["إنَّ أهلَ القُلُوبِ في كلِّ فجٍّ","هُمْ عَلَيْهِ حتَّى القِيامَ عِيَالُ",57,"ل",1,0],["إن أهل التمكين في التلوينِ","ليس عنهم لي حالة تلويني",58,"ن",2,1],["إن أهل الضلال ليسوا بشيء","حاضر عندهم ذوي إذعان",59,"ن",1,0],["إن أهل الإيمان في نور غيب","وذووا العقل كلهم في ظلام",60,"م",1,0],["أناة كأن المسك تحت ثيابها","وريح خزامى الطل في دمث سهل",61,"ل",1,0],["آن اهتمامك بالأوطان تسعدها","فإنما كل مقدار لميقات",62,"ت",1,0],["إِنْ أَهْجُ أمثالَكُمْ فربَّما","تَطَرَّبَ البازُ للعصافير",63,"ر",1,0],["إناّ هُنا، فاحطم بنا","دنيا أساطيرِ الحدود",64,"د",1,0],["ان أهليه في الحقيقة أهلي","واناس الادراك والذوق ناسي",65,"س",2,0],["أَناةُ الخُطا تمشي الهُوينا إذا بدت","تَهادى على أعطافها الوشيُ والعَصبُ",66,"ب",1,0],["أَناة فَإِن لَم تُغنِ أَعقب بَعدَها","وَعيداً فَإِن لم يجدِ أَجدَت عَزائِمُه",67,"ه",1,1],["إن أهل الحصاب قد تركوني","مغرماً مولعاً بأهل الحصاب",68,"ب",1,0],["أَناة امرئٍ يأتي الأمورَ بقُدرةٍ","متى ما يرد لا يعي من بَعدُ مَصدَرا",69,"ر",2,0],["إن أهل الهوى هم الأحياءُ","وهم عند أهله الشهداء",70,"ا",2,1],["إن أهل الفداء أعلى مقاما","إنهم صاعدون نحو الجنان",71,"ن",1,0],["أنا هو العود والعواد أطرب","سماعي بايلام اضلاعي وأوتاري",72,"ر",2,0],["أَناةً وَحِلماً وَاِنتِظاراً بِهِم غَداً","وَإِلّا فَلا وانٍ وَلا مُتَوَهِّما",73,"م",2,0],["أَناةَ عَلَيها لُؤلُؤٌ وَزَبَرجَدٌ","وَنَظمٌ كَأَجوازِ الجَرادِ مُفَصَّلِ",74,"ل",1,0],["أناة ورفقاً يا يزيد بن مزيد","ومرحمةً كيلا تبنك النوائب",75,"ب",1,1],["إِنا هذا الذى تجافاه قوم","يملأُون الصدور بالأحجار",76,"ر",1,0],["أَنا هاوٍ لِمُستَطيلٍ أَغَنِّ","كُلَما اِشتَدَّ صارَت النَفسُ رَخوَه",77,"و",2,1],["أنا هائم فيمن أتاني زائراً","سحراً يميل برأسه تهويما",78,"م",2,0],["إن أهلي في الوكر مذ ولدوني","دون شك إلى الفضا دفعوني",79,"ن",2,1],["إن أهلي عَلَى الثرى نبَذوني","أنا درٌّ من السما نَثَروني",80,"ي",1,0],["أَناةً حينَ لا يُغنى بِدَارٌ","وتشميراً اذا ركبَ الغِوارَا",81,"ر",2,0],["أَنا هَمُّكُم أَنا غَمُّكُم أَنا سُقمُكَم","أَنا سُمُّكُم في السِرِّ وَالإِعلانِ",82,"ن",1,0],["إن أهل الصلاح قد فجعوا","بمصاب فطال غمّهمُ",83,"م",1,1],["إِنّ أَهنى الناس بالاً مَن غدا","خالي الأَفكارِ مَطلوقَ العِنان",84,"ن",1,0],["إِن أُهدِ نَفسي مِن نَفسِهِ","أَو أُهدِ مالي فَهوَ مَن مالِهِ",85,"ل",2,0],["إنا هنا اثنان أمسينا، وفي نظري","بلاغ إلفين فاترك لي أنا السهرا",86,"ر",2,0],["أناةٌ مَيوُد القدّ هيفاءُ بضةٌ","نقيّةُ مجرى الطَّوق طَيّبةُ النَّشرِ",87,"ر",1,0],["أناةٌ هَضيمُ الكشح بيضاءُ رخصةٌ","لها حَسبُ كالشمسِ أبيضُ ناصعُ",88,"ع",1,0],["أناهٌ فَعَمَةُ الأردافِ خَوْدٌ","قَطُوفُ المشي باهرةُ الجمالِ",89,"ل",1,0],["إِنَّ أَهل الزَمانِ قَومٌ أَراهُم","قَد أَشادوا لِصاحب الثَوب ذِكرا",90,"ر",2,0],["أنا هكذا أنا هكذا","يا سادتي هذا الكلا",91,"ل",2,0],["أنا هكذا أنا 