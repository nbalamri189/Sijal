{"poems":[[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[63,"نظرت وكم من نظرة تلد الردى","https://www.aldiwan.net/poem45788.html","الطويل"],[73,"مرادهم حيث السلاح خمائل","https://www.aldiwan.net/poem11930.html","الطويل"],[30,"مررنا على دار لمية مرة","https://www.aldiwan.net/poem29525.html","الطويل"],[30,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[30,"خليلي عوجا عوجة ناقتيكما","https://www.aldiwan.net/poem29543.html","الطويل"],[30,"أدارا بحزوى هجت للعين عبرة","https://www.aldiwan.net/poem29554.html","الطويل"],[30,"أمنزلتي مي سلام عليكما علي","https://www.aldiwan.net/poem29608.html","الطويل"],[88,"أيها الناظر ذا الفقر","https://www.aldiwan.net/poem45076.html","مجزوء الرمل"],[27,"سإمت من المواصلة العتابا","https://www.aldiwan.net/poem5660.html","الوافر"],[51,"يا ابن بوران يا جعلت فدائي","https://www.aldiwan.net/poem7967.html","الخفيف"],[51,"أيها الماجد الذي بهر المداح","https://www.aldiwan.net/poem65475.html","الخفيف"],[51,"لعمرك ما أعطى الرجال حقوقهم","https://www.aldiwan.net/poem65513.html","الطويل"],[89,"هل لمن يرقدون في الالحاد","https://www.aldiwan.net/poem44644.html","الخفيف"],[89,"ما حياة قديمها غير باد","https://www.aldiwan.net/poem44747.html","الخفيف"],[45,"أناة أيها الفلك المدار","https://www.aldiwan.net/poem63597.html","الوافر"],[28,"إليك من الصمان والرمل أقبلت","https://www.aldiwan.net/poem1293.html",""],[28,"عرفت بأعلى رائس الفأو بعدما","https://www.aldiwan.net/poem5244.html","الطويل"],[28,"فسيرا فلا شيخين أحمق منكما","https://www.aldiwan.net/poem5283.html","الطويل"],[80,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[87,"بأي غزال في الخدور تهيم","https://www.aldiwan.net/poem8259.html","الطويل"],[69,"أرح النفس قليلا","https://www.aldiwan.net/poem28876.html","مجزوء الرمل"],[31,"إن أهوى العباد شخصا إلينا","https://www.aldiwan.net/poem41845.html","الخفيف"],[105,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[105,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[81,"أرسل اللحظ للقتال نذيرا","https://www.aldiwan.net/poem61361.html","الخفيف"],[52,"فك حرا للوجد قيد البكاء","https://www.aldiwan.net/poem27332.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[99,"سمفونية على الرصيف","https://www.poetsgate.com/ViewPoem.aspx?id=17739",""],[52,"فُكّ حُرّاً للوَجدِ قيدَ البُكاءِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14636&r=&rc=5",""],[87,"حيَّ مغنى الهوى بوادي الشآمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23779&r=&rc=41",""]],"verses":[["إِن أُهدِ أَشعاري إِلَيكَ فَإِنَّهُ","كَالسَردِ أَعرِضُهُ عَلى داوودِ",0,"د",1,0],["أَناةٌ حَكاها الظَّبيُ جِيداً وَمُقلَةً","وَلَيسَ لَها في حُسنِها بِعَديلِ",1,"ل",1,0],["أَناةٌ عَلَيها مِن سَنا البَدرِ مَيسَمٌ","وَفيها مِنَ الغُصنِ النَضيرِ شَمائِلُ",2,"ل",1,0],["أَناةٍ كَأَنَّ المِسكَ أَو نَورَ حَنوَةٍ","بِمَيثاءَ مَرجوعٌ عَلَيهِ التِثامُها",3,"م",3,0],["أَناةً بَخَنداةً كَأَنَّ إِزارَها","إِذا اِنجَرَدَت مِن كُلِّ دِرعٍ وَمِفضَلِ",4,"ل",1,0],["أَناةٍ كَأَنَّ المِرطَ حينِ تَلوثُهُ","عَلى دِعصَةٍ غَرّاءَ مِن عُجَمِ الرَملِ",5,"ل",1,0],["أَناةٌ تَلوثُ المِرطَ مِنها بِدِعصَةٍ","رُكامٍ وَتَجتابُ الوِشاحَ فَيَقلَقُ",6,"ق",1,0],["أَناةُ يَطيبُ البَيتُ مِن طيبِ نَشرِها","بُعَيدَ الكَرى زَينٌ لَهُ حينَ تُصبِحُ",7,"ح",1,0],["إن أهل الفقر يشقّو","ن لأرباب الثراء",8,"ا",2,0],["أَناةٌ لا النَمومُ لَها خَدينٌ","وَلا تُهدي لِجارَتِها السَبابا",9,"ب",2,0],["أنا هاجيك ما سَكتَّ ومُعفي","ك إذا ما هجوتَني من هجائي",10,"ا",2,0],["إنّ أهل القريض طوراً يرقّو","ن وطوراً تراهم أجلافا",11,"ف",2,0],["أناة إذا باغ أبى أن يودنا","عليها أقمنا للعداوة سوقها",12,"ق",3,0],["انا هذا ولست اقوى على تغيير","نفسي يوماً او استعدادي",13,"ي",1,0],["انا هذا ولست اقوى على تغيير","ما في خلقي او استعدادي",14,"ي",1,0],["أَناةً أَيُّها الفَلَكُ المُدارُ","أَنَهبٌ ما تَطَرَّفُ أَم جُبارُ",15,"ر",1,1],["أُناهِبُهُ الأَدنَينَ وَالأَبعَدَ الَّذي","أَتاكَ بِهِ مِن أَبعَدِ الأَرضِ جالِبُه",16,"ب",2,0],["أَناةٌ كَرِئمِ الرَملِ نَوّامَةُ الضُحى","بَطيءٌ عَلى لَوثِ النِطاقِ بُكورُها",17,"ر",3,0],["أَناةً وَحِلماً وَاِنتِظارَ عَشيرَةٍ","لِأَدفَعَ عَنّي جَهلَ قَومِيَ مَدفَعا",18,"ع",2,0],["إِنَّ اهتمامَكَ بالهدى عن همّةٍ","علويَّةِ الإِصدارِ والإِيرادِ",19,"د",1,0],["أَنَاةٌ بَرَاهَا اللَّهُ فِي الْحُسْنِ آيَةً","يَدِينُ إِلَيْهَا جَاهِلٌ وَحَلِيمُ",20,"م",1,0],["إنَّ أهلَ العصرِ عندي","هكذا إلا قليلا",21,"ل",2,0],["إِنَّ أَهوى العِبادَ شَخصاً إِلَينا","وَأَلَذَّ العِبادِ نَغماً وَدَلّا",22,"ل",2,1],["أناة أيها الحادي فإنا","وجدنا منك ما تجد الركاب",23,"ب",1,0],["إنْ أهلُهُ إلاّ الأُلى استوطنوا","دارَ الوغَى في دُومةِ الجندلِ",24,"ل",1,0],["إنَّ أهلَ الهوَى يَخافونَ يوماً","بِالجَفَا كانَ شَرُّهُ مُستَطيرَا",25,"ر",2,0],["إِن أَهاجوا بِآلِ أَحمَدَ حَرباً","بِبَنيكُم لا تَحلُبوا في إِنائي",26,"ا",2,0],["إنّ أهل القضاء ما أنصفوكم","فكأنَّ القلوبَ منهم صخور",27,"ر",1,0],["أنا هذا أنا – وما كنتُ يوماً","في شُعوري ونَزعتي بمَلاك",28,"ك",1,0],["أنا هُنا مُتَابعٌ نَغْمَةً","قادمةً من غابةِ البيلسانِ",29,"ن",1,0],["أنا هُنا وفي يدي ثَرْوَةٌ","عيناكِ والليلُ وصوتُ البِيانِ",29,"ن",1,0],["إن أهاجُوا بآلِ أحمدَ حرباً،","بينكم ! لا تحلبُوا في إنائي",30,"ا",2,0],["أنا هواكَ فطرة ً ، ليسَ فيها","مِنْ مَسَاغٍ لِلنَّقْضِ وَالإِبْرَامِ",31,"م",1,0]]}