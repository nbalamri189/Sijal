,[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102016","الرمل"],[4759,"كيف والعطر","https://www.poetsgate.com/ViewPoem.aspx?id=204029",""],[4767,"فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=87998",""],[4767,"ساعات الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=129785",""],[4984,"مجد الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=175798",""],[5002,"أحلامٌ مهاجرةٌ...","https://www.poetsgate.com/ViewPoem.aspx?id=207238",""],[585,"ليتني كنت شارداً أجنبياً","https://www.poetsgate.com/ViewPoem.aspx?id=161850",""],[585,"لم تزل في هواك نضواً طليحا","https://www.poetsgate.com/ViewPoem.aspx?id=161862",""],[5074,"الغائب الحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=153717",""],[5145,"من لبرقٍ على البراق أنارا","https://www.poetsgate.com/ViewPoem.aspx?id=108062",""],[5187,"ضحايا بين الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29258",""],[5187,"نغم عذري","https://www.poetsgate.com/ViewPoem.aspx?id=33002",""],[5232,"الأخطل الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=213530",""],[5324,"إلى إبنتي لبنى.","https://www.poetsgate.com/ViewPoem.aspx?id=211597",""],[5387,"بلسم العيون","https://www.poetsgate.com/ViewPoem.aspx?id=46997",""],[5411,"ما مَضى قدْ مَضى","https://www.poetsgate.com/ViewPoem.aspx?id=191214",""],[709,"بزَغَتْ بِالظَّلاَمِ شَمْسُ الدُّيُورِ","https://www.poetsgate.com/ViewPoem.aspx?id=2878",""],[5459,"المتخم","https://www.poetsgate.com/ViewPoem.aspx?id=190892",""],[5542,"شاهد التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=10069",""],[5561,"نجمة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=193221",""],[5596,"تقريظ كتاب التاريخ الإباضي","https://www.poetsgate.com/ViewPoem.aspx?id=206483",""],[5596,"البردة الشعرية","https://www.poetsgate.com/ViewPoem.aspx?id=206751",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[5691,"بوم وغربان","https://www.poetsgate.com/ViewPoem.aspx?id=205929",""],[5725,"نم قريرا","https://www.poetsgate.com/ViewPoem.aspx?id=198899",""],[5725,"يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=211258",""],[5725,"آه يا بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=215377",""],[5956,"شوقي لك يزدادُ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182224",""],[5956,"منذ أيام","https://www.poetsgate.com/ViewPoem.aspx?id=192801",""],[5956,"تجديد الانتماء","https://www.poetsgate.com/ViewPoem.aspx?id=193912",""],[4442,"أنفت أن تميس إلا دلالا","https://www.poetsgate.com/ViewPoem.aspx?id=171224",""],[4442,"بالأعالي فتنت لا بالأسافل","https://www.poetsgate.com/ViewPoem.aspx?id=171204",""],[6142,"حضن الطفل جده شيبة الحم","https://www.poetsgate.com/ViewPoem.aspx?id=155705",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[4222,"يا صلاح الدين الذي أصلح الفاسد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52903&r=&rc=195",""]],"verses":[["لَم تَزَل تَطعَنُ المُوَلّينَ حَتّى","حَسِبتَ مِن قَنا الظُهورِ قَناكا",0,"ك",2,0],["لَم تَزَل كامِلاً وَلَم تَسمُ بِالكا","مِلِ مِن قَبلِ أَن تَشُدَّ الإِزارا",1,"ر",2,0],["لَم تَزَل وَالمَشيبُ غَيرُ قَريبٍ","ناعِياً لِلشَبابِ حَتّى ماتا",2,"ت",2,0],["لمْ تَزِدْ غيْرَ أنْ أبَحْتَ حِمى","الإعْرابِ في كلِّ لفْظَةٍ مَقْروّهْ",3,"و",2,0],["لَم تَزَل في بِناءَةِ النَشءِ حَتّى","هَدَمَ المَوتُ عُمرَ باني الرِجالِ",4,"ل",1,0],["لَم تَزَل مُشتَكايَ في كُلِّ أَمرٍ","وَمُعيني وَعُدَّتي وَنَصيري",5,"ر",2,0],["لم تزل بالعجب حتَّى ضربت","نفسها منه بطاعونٍ عظيم",6,"م",1,0],["لم تزل تستعيرُ منك جَمالاً","تكتسيه وتستميرُ ثَناءَ",7,"ا",2,0],["لم تزل عِرسُ حُريثٍ مركباً","لجميع الناس تُحنَى للرُّكبْ",8,"ب",1,0],["لم تزالوا يقومُ بالشكر عنكم","ما فعلتم والجاحدون سُكوتُ",9,"ت",1,0],["لم تزل مبدئاً معيداً لفضلٍ","وبما أنت فاعل محقوقا",10,"ق",2,0],["لم تزل نسوةٌ لديه قِراهُ","منذ ناغَى ثُديَّها التفليك",11,"ك",1,0],["لمْ تزلْ مانحي سؤالاً وطوراً","مانحي عِشرةً أراها نوالا",12,"ل",2,0],["لم تزلْ من فعالكَ البدأةُ الحر","رةُ بُشْرى بعودةٍ مأمولهْ",13,"ل",2,0],["لم تزلْ تُرشِدُ الغَوِيَّ من الأي","يامِ أفعالُه الرشيدةُ فيه",14,"ي",2,0],["لَم تَزَل كَأسُهُ لَدَي","هِ وَفي كَأسِهِ مُدام",15,"م",1,0],["لم تزل تجزى به تحت الثرى","لجة المعروف والنيل الجزيل",16,"ل",1,0],["لَم تَزَل لَيا","ليكَ تُرتَقَب",17,"ب",1,0],["لَم تَزَل تَسمَعُ المَديحَ وَلَكِن","نَ صَهيلَ الجِيادِ غَيرُ النُهاقِ",18,"ق",1,0],["لَم تَزَل تُوضِحُ العِنايَةَ حَتّى","وَضَحَ النُجحُ لي بِرَغمِ الخُطوبِ",19,"ب",1,0],["لَم تَزَل مُعوِزَ الشَبيهِ وَفي النا","سِ بَقايا فَضلٍ قَليلِ النَظيرِ",20,"ر",1,0],["لَم تَزَل مِن عُيوبِها أَبيَضَ الثَو","بِ وَمِن دائِها صَحيحَ الأَديمِ",21,"م",1,0],["لَم تَزَل تَكلأُ البِلادَ بِقَلبٍ","أَلمَعِيٍّ وَناظِرٍ يَقظانِ",22,"ن",1,0],["لَم تَزَل تَسبُقُ الأَنامِ بِحُسنا","كَ وَتولي العِبادَ لُطفاً وَطولا",23,"ل",2,0],["لَم تَزهُ صَنعَتُهُ إِلّا بِصُنعِكُمُ","تَزهو الخَمائِلُ أَنّى يَهطِلُ المَطَرُ",24,"ر",1,0],["لم تَزَل ذكراه من بالي وبالك","كيف ينسى القلبُ أحلامَ صباه",25,"ه",1,0],["لم تزل حتى هوّم الحان نعسان وأغفى البساط والندماء","غير نجم في جانب الليل يقظان له روعة بها وجلاء",26,"ا",2,0],["لم تَزَلْ تُرْضِعُ أخلافَ الندى","يَدُهُ العافينَ مُذْ كان فطيم",27,"م",1,0],["لم تزلْ عينيَ أو أذني به","تُؤذنُ القلب بخوْفٍ لا يُنيم",27,"م",1,0],["لَم تُزجَرِ العيسُ في قَراهُ","مُذ عَصرِ نوحٍ وَعَصرِ شيثِ",28,"ث",1,0],["لَم تَزَل مِن هَوى قُرَيبَةَ تَهوى","مَن يَليها حَتّى هَوَيتَ الرِياحا",29,"ح",2,0],["لَم تَزَل تَصرِفُها عَن رَأيِها","وَتَأَتّاها بِرِفقٍ وَأَدَب",30,"ب",1,0],["لَم تَزَل مُقلَتي تَفيضُ بِدَمعِ","مِثلِ الغُيوثِ مُذ فَقَدَتها",31,"ت",3,1],["لم تزل تَضرِبُ الطواغيتَ حَتَّى","جَرَّعَتْها الرُزأَيْنِ ثُكْلاً وَيُتْما",32,"م",2,0],["لم تزل تهجرني منذ سنين","ليتني أنعم يوماً برضاكْ",33,"ك",1,1],["لَم تَزَل بِالرَحيلِ دارُ سُلَيمى","يَتَهادى بِها المَها الوَحشِيُّ",34,"ي",1,0],["لم تَزَلْ في ضمائرِ الكونِ تُختَا","رُ لك الأُمهاتُ الأَباءُ",35,"ا",2,0],["لَمْ تَزَلْ عَوْنَنَا عَلَى الدَّهْرِ حَتَّى","غَلَبَتْنَا يَدُ المَنُونِ عَلَيْكا",36,"ك",2,0],["لَم تَزَل في قَعرِ دَنٍّ","مُشعَرٍ زِفتاً وَقارا",37,"ر",2,0],["لم تزل تسمع المديح ولكن","صهال الجياد غير النهاق",38,"ق",1,0],["لم تَزَلْ مصرُ كعبةَ الشعر في الشر","قِ وفي كفِّها لواءُ الزعامَه",39,"م",2,0],["لم تزل تزجر الطغاة فلا تط","غ فحب الدنيا لمثلك مطغي",40,"غ",2,0],["لَم تَزَل تَجري بِهِ تَحتَ الثَرى","لُجَّةَ المَعروفِ وَالنَيلِ الجَزيل",41,"ل",1,0],["لم تزل ليلى بعينى طفلة","لم تزد عن أمس إلا أصبعا",42,"ع",2,0],["لم تزل تسمع المراثي حتى","سمعت في الرثاء صوت نعيّ",43,"ي",1,0],["لم تُزْهِهِ يومًا عراقَةُ بيته","ولوَ أنه أرسى من الأطواد",44,"د",1,0],["لم تزل تقهرُ الطبيعة، حتَّى","قَهَرَتْها أيدي البُنَاة الكُمَاة",45,"ه",1,0],["لم تزل في «مدارسَ» من بقايا","وبقايا مازلن في «مدريد»؟",46,"د",1,0],["لم تزلْ من فعالكَ البدأة ُ","الحرُّ يشْرى بعودة ٍ مأموله",47,"ل",2,0],["لم تزلْ تُرشِدُ الغَوِيَّ من الْ","أيامِ أفعالُه الرشيدة ُ فيه",48,"ي",2,0],["لم تزل مقلتي تفيض بدمع","يُشْبِهُ الغَيْثَ بَعْدَ أنْ فَقَدَتْها",49,"ت",3,1],["لم تزل ذكرى ليالي","العذاب السالفات",50,"ت",1,0],["لم تَزَلْ في ظِل ظليلٍ من العَدْ","لِ وفي ذِرْوةِ من العزّ يَعْلُو",51,"ل",2,0],["لَم تَزَل تَقَهرُ العِدى فَلِهَذا","كُلَّما أَنجَبوا اِستَزَدتَ سَناءَ",52,"ا",2,0],["لَم تَزَل مُبدِعاً فَلَم أَدرِ إِلها","ماً عَرَفتَ الإِعجازَ أَم إيحاءَ",52,"ا",2,0],["لَم تَزَل توسِعُ الخِلافَةَ بِالنُص","حِ اِجتِهاداً وَالمُشرِكينَ جِهادا",53,"د",2,0],["لَم تَزَل ناظِراً إَلَيها بِعَينٍ","هِيَ في جَفنِها قَذىً وَسَقامُ",54,"م",1,0],["لَم تَزَل للإلهِ عَبداً فقيرا","لا شَريكاً لهُ ولستَ وَزيرا",55,"ر",2,0],["لَم تَزَل فَوقَ كُلِّ فَوقٍ مُجِدّاً","بِالتَرَقّي ما لِلتَّرَقّي اِنتِهاءُ",56,"ا",2,0],["لَم تزِد قدركَ الرفيعَ سوى ما","زادَ في الشمس من سناها البهاءُ",56,"ا",2,0],["لَم تَزِدكَ الدارُ إِلّا طَرَباً","وَالصِبا غَيرُ شَبيهٍ بِالصَوابِ",57,"ب",1,0],["لم تزل من جواهر اللفظ تهدى","لعلاكم بدائع الاصناف",58,"ف",1,0],["لم تَزِد يا أَبا الحُصَينِ على أَو","لادِ حَوّاءِ في ضُروبِ الدهاءِ",59,"ا",2,0],["لَم تَزَل تَدفَعُ الحَوادِثَ عَنّا","أَحسَنَ اللَهُ في عُلاكَ الدِفاعا",60,"ع",2,0],["لَم تَزَ