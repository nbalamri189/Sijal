{"poems":[[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85594","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54540","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48542","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109366","الطويل"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146875","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123504","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83527","الكامل"],[5038,"النفس","https://www.poetsgate.com/ViewPoem.aspx?id=196979",""],[5408,"أنا لا إليك","https://www.poetsgate.com/ViewPoem.aspx?id=190581",""],[6235,"تراتيل الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77691&r=&rc=6",""],[6334,"في الرمل حمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82250&r=&rc=0",""]],"verses":[["علّي إذا جئت مصراً","أعيش في مصر حرا",0,"ر",2,0],["عَلِيُّ إذا ثَويْتَ رَهينَ رَمْسٍ","فَقَدْ عَجِلَتْ عَلَيْكَ يَدُ الفَنَاءِ",1,"ا",2,0],["عليّ إذا طاوعتموني جداله","وما لي عليكم إن ظفرت به أجر",2,"ر",1,0],["عليَّ إذا ما الدهرُ أصبح عادياً","سعى ركب آمالي لبغداد غاديا",3,"ي",2,1],["علي إذا غنيت أن تطرب العلا","فليت فؤادي للسرور منادم",4,"م",1,1],["علىّ اذا ألقى بشيرى باللقا","جعلت له خدّى على الترب مفرشا",5,"ش",2,0],["عَلّي إِذا جاوَرتهُ مُستمسِكاً","بِالسُنّة الغَرّاءِ بَلَّغَني الأَرَب",6,"ب",1,0],["عَلّيْ إِذا أَلْزَمْتُها سَمْتَ الرِّضا","تَرْضى بِما قَسَمَ الْإِلهُ وَتَقْنَعُ",7,"ع",1,0],["عَلّي إذا رمْتُ اقترابكَ من دمي","بك أبتدي لغةَ الحديثِ وأكتبُ",8,"ب",1,0],["علّي أذوقُ شراييني وأوردتي","علّي أناجي مقام الشمس والقمر",9,"ر",1,0],["عَلِّي إِذَا بَلَّلَتْ سُقْيَاكِ ذَاكِرَتِي","تَنْمُو حُرُوفِي وَيَحَْيا بَعْضُ أَشْلاَئِي",10,"ا",3,0]]}