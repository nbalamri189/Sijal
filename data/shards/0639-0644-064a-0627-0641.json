{"poems":[[88,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[87,"بني مصر ارفعوا الغار","https://www.aldiwan.net/poem8078.html","الهزج"],[87,"بني مصرَ ، ارفعوا الغار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9668&r=&rc=158",""],[203,"اراك نسيت يا ظبي الصريم","https://www.aldiwan.net/poem45571.html","الوافر"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[333,"على أفقي سحابات","https://www.aldiwan.net/poem54953.html","الهزج"],[509,"سما قدر السماحه والجمال","https://www.aldiwan.net/poem38407.html","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101062","الوافر"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84865","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86489","الوافر"],[5616,"أنا","https://www.poetsgate.com/ViewPoem.aspx?id=205028",""]],"verses":[["عَلّي أَفي بَعضَ دَيني","إِن كانَ ذَلِكَ يُغني",0,"ن",2,0],["عَلى إِفريزِ راجبوتا","نَ تِمثالٌ مِنَ المَجدِ",1,"د",1,0],["على إفريزِ راجيوتا","نَ تمثالٌ من المجد",2,"د",1,0],["على إفكِ العواذلِ واللواحي","وظنة كلّ أفاكٍ أثيمِ",3,"م",1,0],["عليّاً فلا يَسطيع خطبٌ ظهوره","ولا يَستطيع العيث في حِصنهِ نَقبا",4,"ب",2,0],["على أفقي سحابات","وفي نفسي أعاصيرُ",5,"ر",1,1],["على افق العلى بدرٌ تمام","اتم بيان قدرة ذي الجلال",6,"ل",1,0],["على أفواهها زرقٌ حدادٌ","بها نفري الخواصر والمتونا",7,"ن",2,0],["علي أَفقها المَيمون شَمس سُرورنا","تَبَدت لِتَهدي كُل سار وَسائر",8,"ر",1,1],["على أفنانها في كل فن","تطارحني الهديل وبيد أني",9,"ي",1,0],["علِّي أفجِّرُ تاريخاً غَدَا همَلاً","فيهِ تألَّهَ أنصافُ العبابيدِ",10,"د",1,0]]}