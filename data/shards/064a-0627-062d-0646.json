{"poems":[[99,"يا حنانا كيد الآسي الرؤوم","https://www.aldiwan.net/poem24775.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[102,"عند مجهولة","https://www.poetsgate.com/ViewPoem.aspx?id=50413",""],[242,"عائذا بكم من زماني وبثه","https://www.aldiwan.net/poem18104.html","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125412","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108429","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205818","الخفيف"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117044","الرمل"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32365","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4701,"الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=176660",""],[5092,"ما أروعك","https://www.poetsgate.com/ViewPoem.aspx?id=190577",""],[5461,"حنان العمر","https://www.poetsgate.com/ViewPoem.aspx?id=8536",""],[5463,"آآه يا حالي عليها","https://www.poetsgate.com/ViewPoem.aspx?id=31732",""],[5686,"لو ماتت الأشجار ما مات الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=203365",""],[5829,"نسيم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=148225",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""]],"verses":[["يا حناناً كيدِ الآسي الرؤومِ","وشُعاعاً يُشتَهى بعد الغُيومِ",0,"م",1,1],["يَا حُْنَ تِلْكَ المُفَتَدَاةِ الَّتِي","آيَاتُهَا فِي البِرِّ لاَ تُحُصَرُ",1,"ر",1,0],["يا حنان الحلوة الفنجا إلى","اين تمضي بي لياليك العجيبه",2,"ب",2,0],["يَاحَنَانَيْكَ لاَ تُقَابِلْ أَخَسَّ الْ","مُجْرِمِينَ الْمُذَمَّمِينَ بِحِنْثِهِ",3,"ث",2,0],["يا حنيناً ملكتَ سمعي وقلبي","أنتَ كالسِّحرِ في عُيُونِ الحِسانِ",4,"ن",1,0],["يا حنيني لليالِ عبرت","يا حنيني لاويقات الصفا",5,"ف",2,0],["يا حنيني إلى الليالي المواضي","وشقائي من الليالي البواقي",6,"ق",2,1],["يا حنانا يا منان","نسألك الغفران",7,"ن",1,0],["يا حُنَّ إِنّي لِما حَدَّثتَني أُصُلاً","مُرَنَّحٌ مِن ضَميرِ الوَجدِ مَعمودُ",8,"د",1,1],["يا حنفي ما أنت إلا شافعي","فقد جنينا كل زهر يانع",9,"ع",1,0],["يا حِنطةَ الفقراءِ يا نبع الرضا","يا صوتَنا والصمتُ ذئبٌ أحمرُ",10,"ر",1,0],["يا حنانًا يرتوي منهُ دمي","يا تُرى مَنْ بالحنانِ أرضعَكْ ؟",11,"ك",1,0],["يا حنان العمر في عيونك حنان","والهوى جذّابه الرمش الحنون",12,"ن",1,1],["يا حنيني وشوق فيني وكل فرح ٍ لا طرالي","يامشاعر قلب شاعر يرسم اللحظه وبكيها",13,"ي",3,0],["يا حنظل الأسماء لون عمرنا","علمتنا طيب التعانق سؤددا",14,"د",2,0],["يا حنين الورد قطْرات الندى","في صباح العطر ترسل ما استطابا",15,"ب",2,0],["يَا حَنانَ الهَوَى وصَفْوَ ودادٍ","غَرِّدي مِنْ قَصِيدِك المَعْهُودِ",16,"د",1,0],["يَا حَنَانَ القَصيدِ ، يَا لمْسَةَ الإِسْ","لاَم سَلْوَى الحَزين مَأْوى الطَّريدِ",16,"د",1,0]]}