,"https://www.poetsgate.com/ViewPoem.aspx?id=125022",""],[4812,"سرى عارضُ","https://www.poetsgate.com/ViewPoem.aspx?id=200780",""],[5121,"ميميّة الأم","https://www.poetsgate.com/ViewPoem.aspx?id=33578",""],[5186,"أي متى كنت مغرما بالملاح؟","https://www.poetsgate.com/ViewPoem.aspx?id=156552",""],[5206,"أئمة بني خروص","https://www.poetsgate.com/ViewPoem.aspx?id=187433",""],[5277,"خاتمةُ المراثي","https://www.poetsgate.com/ViewPoem.aspx?id=199869",""],[5413,"لست أدري","https://www.poetsgate.com/ViewPoem.aspx?id=208618",""],[5452,"كوني لي","https://www.poetsgate.com/ViewPoem.aspx?id=112028",""],[5512,"البدر أمسى هلالاً","https://www.poetsgate.com/ViewPoem.aspx?id=204347",""],[5596,"الى الشيخ الصوّافي","https://www.poetsgate.com/ViewPoem.aspx?id=206689",""],[243,"مأساة الميناء","https://www.poetsgate.com/ViewPoem.aspx?id=50470",""],[5660,"فَإِلّا إِلى الخَيرِ أَمشي وَ فيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=36409",""],[5759,"سجى الليل","https://www.poetsgate.com/ViewPoem.aspx?id=213405",""],[5842,"ومازال التراب \\محمد حسام الدين دويد","https://www.poetsgate.com/ViewPoem.aspx?id=150625",""],[5948,"أمُخبري أنت يا قتيبةُ عن","https://www.poetsgate.com/ViewPoem.aspx?id=100596",""],[5980,"إذا كان أمر المرء إن طال عهده","https://www.poetsgate.com/ViewPoem.aspx?id=146265",""],[5986,"أيا بدر المعارف والمعالي","https://www.poetsgate.com/ViewPoem.aspx?id=162953",""],[6093,"مَا عَبْدُهُ فِي الشِّعْرِ إلاَّ فتىً","https://www.poetsgate.com/ViewPoem.aspx?id=178842",""],[6102,"السِّفر اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=186268",""],[6259,"أبان لنا من دره يوم ودّعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59387&r=&rc=35",""]],"verses":[["فصَيِّرْ أعادِيكَ الأضاحِيَّ إذ لَوَوْا","طُلىً يَسْتَزِرْنَ المَشْرَفيَّ المُصَمِّما",0,"م",2,0],["فَصيحاً إِذا ما كانَ في ذِكرِ رَبِّهِ","وَفي ما سِواهُ في الوَرى كانَ أَعجَما",1,"م",2,0],["فَصَيَّرَتَني بَعدَ اِنتِكاثِكَ مُتهِماً","لِنَفسي عَلَيها أَرهَبُ الخَلقَ أَجمَعا",2,"ع",2,0],["فَصَيِّر أَميرَ المُؤمِنينَ ثَناءَها","مَآثِرَ تُحيِ الأَرضَ وَهيَ مَواتُ",3,"ت",1,0],["فَصيحٌ مَتى يَنطِق تَجِد كُلَّ لَفظَةٍ","أُصولَ البَراعاتِ الَّتي تَتَفَرَّعُ",4,"ع",1,0],["فَصَيَّرَ سَيلُهُ بَلَدي غَديراً","وَصَيَّرَ خَمرُهُ سَنَتي رَبيعا",5,"ع",2,0],["فصيَّرني بين القِيانِ إذا شَدَتْ","وبين نِداماه حِجاباً مُكرَّما",6,"م",2,0],["فَصَيِّرها لِنَفسِكَ رَأسُ مالٍ","وَصَيِّر بَعدَها التَقوى بِضاعَه",7,"ع",2,0],["فَصَيَّرتُ القَريضَ لَهُ جَزاءً","وَقُلتُ جُزيتَ عَن نَحسٍ بِسَعدِ",8,"د",1,0],["فَصيحٌ إِذا الخَصمُ الأَلَدُّ تَعالَمَت","دَلائِلُهُ كانَت لَهُ الحُجَجُ اللُدُّ",9,"د",1,0],["فَصَيْحَةُ الرّوْعِ وطعمُ الرّدى","لديه كالشّدوْ على شربِ جام",10,"م",1,0],["فصيحٌ بأسماءِ الكماةِ مبارزاً","لِتُعْملَ فيها بالمهنَّدِ أَفعالُ",11,"ل",1,0],["فَصَيِّرْ جميلَ الصَّفحِ عنهُ عِقابَهُ","فقد جَلّ منكَ القدرُ عن ضَعَةِ القدرِ",12,"ر",1,0],["فَصيحٌ إِذا اِستَنطَقتَهُ وَهوَ راكِبٌ","وَأَعجَمُ إِن خاطَبتَهُ وَهوَ راجِلُ",13,"ل",1,0],["فَصَيَّرَني الحُبُّ ما أَستَطيعُ","أُقِلُّ بِكَفّي مِنَ الأَرضِ عودا",14,"د",2,0],["فَصيلُ أَخيكَ يَشكو طولَ ظِمءٍ","بِما لاقى فَصيلُكَ مِن غَواهُ",15,"و",3,0],["فَصِيمٌ نِصْفُهُ في الماء بادٍ","ونِصْفٌ في السّماء به تُزانُ",16,"ن",1,0],["فَصير البر بحراً","وَصير البحر برا",17,"ر",2,0],["فصيحوا إذا شئتم سكوتاً وأغلقوا","عليكم، وكالأحلام في النوم جاهدوا",18,"د",3,0],["فَصَيَّرَ سَيلُهُ بَلَدي غَديرًا","وَصَيَّرَ خَيرُهُ سَنَتي رَبيعا",19,"ع",2,0],["فَصَيَّرْتَني بَعْدَ انتحائِكَ مُتْهماً","لنفسي ، عليها أرهبُ الخلقَ أجمعا",20,"ع",2,0],["فصيحاً إذا ما كان في ذكر به","وفي ما سواه في الورى كان أعجماٍ",21,"م",2,0],["فصيرتني الخطوب زافرةً","كما أثار الزمان أنيوبا",22,"ب",2,0],["فَصيلَ لَهُم قَرمٌ كَأَنَّ بِكفِّهِ","شِهاباً بَدا في ظُلمَةِ اللَيلِ يَلمَعُ",23,"ع",1,1],["فَصِيحٌ متى ينطِقْ يجد كل مُفصحٍ","أخا منطق تعنو له الفُصَحاءُ",24,"ا",2,0],["فَصيحٌ إذا آنستُ للحُبِّ حَضرةًُ","فإن غابَ لم يَنطِق لِسَانِي ولا حَرفا",25,"ف",2,0],["فصيرتها أعني زوالاً نذيرة","لسائر عنك فهي قد قمعت عكا",26,"ك",2,0],["فصيلهِ يا دنيا الأماني واصدعي","في قلبه شمل الشجون وبدّدي",27,"د",2,0],["فصيح صبيح عامل بعلومه","حليم كريم بالذكاء تأيّدا",28,"د",2,0],["فصيح بليغ فاضل ذو سماحةٍ","له كرم مثل الغيوم المواطر",29,"ر",1,0],["فصيالي عليك وثبةُ ليثٍ","يشتهى وقع هولها المحبوب",30,"ب",1,0],["فصيَّرن نرجِسَها أَعْيُناً","وأوهبن أغصانها للقدودِ",31,"د",1,0],["فصيحهم عند النصيحة ألكن","واصحاهم عقلا لديك نزيف",32,"ف",1,0],["فصيح من السعدى أسعد خطبة","وأشجي من الكندي شعراً وأشجع",33,"ع",1,0],["فصيّرَ الوادي جميلاً مخصبا","والظلُّ في الغاب يشوقُ المُتعَبا",34,"ب",2,0],["فَصيحٌ صَبيح زَندَهُ غَير مُصلَدِ","قطعت حبال الفقر حين وصلته",35,"ه",1,0],["فَصيحٌ فَمَن أَهدى إِلَيهِ فَصاحَةً","يَكُن مِثلَ مَن أَهدى إِلى هَجَر التمرا",36,"ر",2,0],["فصيَّرتُها بَحراً منَ الدّمعِ بعدَها","لَعَلِّى بطُولِ الغَوصِ ألقَى بها خِدْنا",37,"ن",2,0],["فَصَّير منه يُمْناً في يَمينِ","وصَيّرَ منه يُسراً في يَسار",38,"ر",1,0],["فَصِيّرْ سِواراً في يَساري عِنانَه","أُبادِرْ به قَطْعَ الفلا والصّحاصِح",39,"ح",1,0],["فَصيح إِذا ما جال لَم ير مغنماً","مِنَ العَيشِ إِلّا أَن يَقول وَيَسمعها",40,"ع",3,0],["فصيرنهُ في مكانٍ رطبِ","ليطفي حرّ طبعهِ الملتهبِ",41,"ب",1,0],["فصيحُ الشَبا ما استمَدَّ الرِضاعَ","وَأَعجمُ ساعةَ تنوي فِطامَهْ",42,"م",2,0],["فصيحٌ يَطا وعْرَ المقالة مُسهلاً","يُقرُّ له يوم الجدالِ مُجادله",43,"ل",2,0],["فصيح خطيبي سيفه ولسانه","يجالد عن عليائه ويجادل",44,"ل",1,0],["فَصَيَّرَ الحَربِ سَلماً","فَالصُلحُ فيهِ الصَلاحُ",45,"ح",1,0],["فصيحٌ ما لمنطقِه شَبيهٌ","ولو حملَتْ به أمُّ الكِتابِ",46,"ب",1,0],["فصيحٌ نُطقُه نَظماً ونثراً","يرصّعُ لفظُه الدُرَرَ الكِبارا",47,"ر",2,0],["فصيحٌ عن الأسماءِ جمجمَ لفظُه","وأسمعَ معناهُ القُلوبَ وأفهَما",48,"م",2,0],["فصيح اللسان بديع البنان","رفيعُ السنان سريع القلم",49,"م",1,0],["فَصِيْنَ حَتَّى يُضَاهِي فِي صَيَانَتِهِ","جَاهِي لِصَوْنِيْهِ عَمَّنْ لاَ يُدَانِيْنِي",50,"ن",2,0],["فصيِّر الشَّطر مبذولاً ومنتهَبا","وصيَّر الشَّطْر أَحباساً وأَوْقَافا",51,"ف",2,0],["فصيحةُ مَنطِقٍ ناغَت بلفظٍ","كسلسالٍ من الصهبآءِ عذبِ",52,"ب",1,0],["فصِيحٌ لَهُ التَّقدِيمُ في كُلِّ مَشهَدٍ","إِذا جالَ في عِلمٍ فَمن ذا يُناضِحُ",53,"ح",1,0],["فصيحٌ اذا استنطقتهُ وهو أخرسٌ","جوادٌ اذا يُعطي مجيدٌ اذا يَعطو",54,"ط",2,0],["فَصيح بَليغ لا يُجارى بَلاغَةً","بِسحرِ بَيان لَم يَنله المنافسُ",55,"س",1,0],["فَصَيَّروا الوَردَ عَلى ضَعفِهِ","لِلزَّهرِ سُلطاناً بِكُلِّ الزّمانْ",56,"ن",1,0],["فَصَيَّرت فيها الطرفَ منّي مُسافراً","فَطرفِيَ في خَيرِ المَنازلِ سافرا",57,"ر",2,0],["فَصيحٌ إِذا ما قامَ يَخطُبُ واعِظاً","تَرى يَعرُباً يَبدو لَدَيهِ كَأَبْكَمِ",58,"م",1,0],["فَصيحٌ بليغٌ لا يُجارى بَلاغَةً","وَمَن ذا يُجاري الخَيل في العَدوِ وَالضبحِ",59,"ح",1,0],["فَصيحٌ بِهِ سَحبانُ قَد عُدَّ باقِلاً","وَإِن قالَ أمّا بعدُ حين يناظرُ",60,"ر",1,0],["فَصيح بَليغ إِن تَكَلَّم لافظاً","فَبادِرْ لأَخذِ الدّرِّ ثمَّ اِلتَقِط لَقطا",61,"ط",2,0],["فَصيحٌ بَليغ لا يُضاهَى بَلاغَةً","وَلَو أَنّ كلّ النّاسِ فيها تَساعَدوا",62,"د",3,0],["فَصيحاً لا يُعبِّرُ عَن مَعانٍ","إِذا ما قالَ إِلّا بِالطّريفِ",63,"ف",1,0],["فَصيحَةً تُعرِبُ عَن قَصدِها","لَكِنّها الناطِقَةُ الخَرسا",64,"س",2,0],["فصيح مليح صادق القول طاهر","نقي تقي أكملي معظم",65,"م",1,0],["فَصَيَّرتَهُ لِلدَهرِ عَقداً مُفَصَّلاً","وَطَيَّرتَهُ في الأُفقِ نَشراً مُعَطَّرا",66,"ر",2,0],["فصيح لسان الحال منها على المدى","يرنّم في تاريخها الرب حافظي",67,"ي",1,0],["فصيح لسان أعجم جيرة بكم","وأعجم دمعي بالصبابة مفصح",68,"ح",1,0],["فصيَّر طردي في الأمر عكساً","وكنت الروائي فصرت الرواية",69,"ه",1,0],["فصيرتها صبحاً بُعيدَ اسودادها","ولولاكم ما خاضها أيُّ راهب",70,"ب",1,0],["فصير حسن عقلك راس مال","وربحك سترة حتى النهايه",71,"ا",3,0],["فصير الصبح ليلا يوم مصرعه","وحول الصبر للاجفان قطرانا",72,"ن",2,0],["فَصيحٌ إِذا قالَ ابنُ عَبّاسَ عَبدُهُ","وَيَبرُدُ مِن عِيٍّ لَدَيهِ المُبَرِّدُ",73,"د",1,0],["فصير القادر الأجفان في لججٍ","حاكت ندى عبده السمح السخيْ المضري",74,"ر",2,0],["فصيّرت الخريف لنا ربيعاً","بختن في ربيع جاء ثَاني",75,"ن",2,0],["فصيام شوالٍ يقومُ مقامه","وصيامُ شعبانٍ إلى هدرِ",76,"ر",1,0],["فصيحٌ فكمْ من مِصْقَعٍ في زمانِهِ","تَقَلَّدَ من تيارهِ جوهرَ الفُصْحِ",77,"ح",1,0],["فصيتهُ طار في كل البلاد إلى","شرقٍ وغربٍ وجنّاتٍ وكُثبانِ",78,"ن",1,0],["فصَيَّرَت قُلوبنا","بالوَجدِ كالمُطَوَّقَه",79,"ق",2,0],["فصيّرَ منه عسكرَهُ خلاءً","وفرَّقَ عنه أفواجَ الجنودِ",80,"د",1,0],["فَصياح مَن عرف الطَريق هداية","وَصِياح مِن جَهل الطَريق نباح",81,"ح",1,0],["فَصيحُ مَقالٍ حينَ يَخرَسُ قسُّهُم","فَسيحُ مَجالٍ إِن يَحِلُّوا بِمأزِقِ",82,"ق",1,0],["فَصيحةٌ ثَقَّفَت بِالنَحوِ مَنطِقَها","فَلَن تَرى فيهِ لا لَحنا وَلا لَكنا",83,"ن",2,0],["فصيرت لي حقا بفضلك واجبا","واعطيتني شيئاً سوى ذلك الحق",84,"ق",1,0],["فصيحٌ، إِذا مدّ المِداد حِبالَهُ","لِمَلْمومَةٍ لم يُعْيه صَيْدُ صِيْدها",85,"د",3,0],["فصيَّرته جسراً حديدا مقنطرا","وزندك لا ينفك مقتدحا وريا",86,"ي",2,0],["فصيَّرَنِي الفصيلَ وها أنا ذَا","أُصُولُ علَى البوازِلِ والجِذَاعِ",87,"ع",1,0],["فصيرّت برّي عوذةً من أذى الدهر","وأعددت من شكري لباري الورى ذُخري",88,"ر",2,0],["فصيّر حديثك همساً له","فإن يستمعه نسيمٌ وشى",89,"ش",2,0],["فصيّر جسمه ظلاً لجسمي","وصيّر نفسه درعاً لنفسي",90,"س",2,0],["فصيّرت ذاك الطرس حرزا لأضلعي","اطمئن قلبي ان ذا سند الحبّ",91,"ب",1,0],["فصير في رزةٍ أصبعي","وأوثق كفي تحت الرحى",92,"ح",2,0],["فصيرها شوى عمى وضلالة","ونور الهدى من منزل الوحي يجتلى",93,"ل",2,0],["فصير أرض الشام طوقاً لجيدها","وأضحت لها زهراء قرطبة قرطا",94,"ط",2,0],["فَصُيِّرَتْ لِي هُمُومٌ","تُدْنِينَ مِنِّي وَفاتِي",95,"ت",2,0],["فَصَيَّرَ الحالَ مَعكوساً تَزَلُّفُكُم","لكُلِّ ذي نِعمَةٍ عنكُم قَد استَغنى",96,"ن",2,0],["فصيح الولاء بميلاد س","بط هادي الانام به مسفر",97,"ر",1,0],["فصير في الآفاق أمر وقائع","تطيل إذا فكرت فيها التفكرا",98,"ر",2,0],["فَصيَّر لي جودَه رغبةً","ولم أكُ في منفسٍ أَرغَبُ",99,"ب",1,0],["فصير جوف العجل من ذلك الثرى","فقام له منه خوارٌ ممدد",100,"د",1,0],["فصيّرتهُ اخْتيالاً","خيْلُ الجمالِ مَجالا",101,"ل",2,0],["فصير مطلوب الأعنة طالبا","هنالك والمغلوب أصبح غالبا",102,"ب",2,0],["فصير الأمر إلى المنصور","فأحكم التدبير للأمور",103,"ر",1,0],["فصير الأمر إلى المقتدر","لله نجل المعتضد جعفر",103,"ر",1,0],["فصير الشورى إلى أصحابه","ستتهم وهو يشكو ما به",104,"ه",1,0],["فصير الملك إلى الوليد","فلم يكن في الحكم بالسديد",104,"د",1,0],["فصيح عنده الفصحاء خرس","بليغ يترك البلغاء لكنا",105,"ن",2,0],["فصيرتني حكيما","برغ