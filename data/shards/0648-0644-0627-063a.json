{"poems":[[63,"ومر تبع من مسقط الرمل بالحمى","https://www.aldiwan.net/poem45786.html","الطويل"],[71,"ولي صاحب يغشى الوغى وهو فارس","https://www.aldiwan.net/poem3865.html","الطويل"],[93,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[88,"هلم إلى ذوق طعم الأدب","https://www.aldiwan.net/poem44429.html","المتقارب"],[88,"نجيت بالسد بغدادا من الغرق","https://www.aldiwan.net/poem44443.html","البسيط"],[88,"أرى الشعر أحياناً بجيش بخاطري","https://www.aldiwan.net/poem44455.html","الخفيف"],[88,"حببت العلا منذ الصبا حب شاعر","https://www.aldiwan.net/poem44989.html","الطويل"],[88,"نعى البرق من باريس ساسون فاغتدت","https://www.aldiwan.net/poem45033.html","الطويل"],[47,"وإني لأنوي هجره فيردني","https://www.aldiwan.net/poem25111.html","الطويل"],[51,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[51,"لك الطائر الميمون والطالع السعد","https://www.aldiwan.net/poem10887.html","الطويل"],[51,"قرأت على أهلي كتابك إذا أتى","https://www.aldiwan.net/poem62922.html","الطويل"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[91,"سلام عليها طفلة وفتية","https://www.aldiwan.net/poem8831.html","عموديه"],[85,"لست بناس ليلة","https://www.aldiwan.net/poem8051.html","مجزوء الرجز"],[85,"إلى عرفات الله يا خير زائر","https://www.aldiwan.net/poem63776.html","الطويل"],[62,"سرى يكتسي قطعا من الليل مظلما","https://www.aldiwan.net/poem52297.html","الطويل"],[62,"تصدى وللحي الجميع رحيل","https://www.aldiwan.net/poem52316.html","الطويل"],[62,"أرقت لبرق لاح عني وميضه","https://www.aldiwan.net/poem52462.html","الطويل"],[45,"لدارك يا ليلى سماء تجودها","https://www.aldiwan.net/poem63478.html","الطويل"],[44,"متى أنت عن ذهلية الحي ذاهل","https://www.aldiwan.net/poem30372.html","الطويل"],[44,"تقي جمحاتي لست طوع مؤنبي","https://www.aldiwan.net/poem30583.html","الطويل"],[74,"شأوت مطايا الصبا مطلبا","https://www.aldiwan.net/poem12866.html","المتقارب"],[74,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[74,"وبيضاء في صفراء تحمل نفحة","https://www.aldiwan.net/poem12930.html","الطويل"],[74,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[1,"قفي ودعينا اليوم يا ابنة مالك","https://www.aldiwan.net/poem34008.html","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30495","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142022","الهزج"],[88,"اعرني لساناً ايها الشعر للشكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19582&r=&rc=85",""]],"verses":[["وَلا غَروَ أَن أُكسى القِلَى مِن كواعِبٍ","رِداءُ شَبابي عِندَهُنَّ سَليبُ",0,"ب",1,0],["وَلا غُنيَةٌ فيهِ بِغَيرِ أَخٍ لَهُ","شَديدِ القُوى صعبٍ عَلى الخَيلِ باسِلُ",1,"ل",1,0],["وَلأَغْوِي عِبَادَ اللهِ أَسْمَاءُ وَابْذُلِي","لِحَاظَكِ آلاءً وَإِنْ كُنَّ أَسْهُمَا",2,"م",2,0],["ولا غرو أن ملّكت ي الغنا","ء وأن أحرزت فيه أعلى الرتب",3,"ب",1,0],["ولا غدت تجرف الأسداد قاذفةً","منها بسيل على الأنحاء مندفق",4,"ق",1,0],["ولا غصت في بحر القريض مخاطراً","إذا لم أفز من درّه بثمينه",5,"ن",2,0],["ولا غروَ أن أبكي أسىً من بكائها","فأعظم ما يشجي بكاء الحرائر",6,"ر",1,0],["ولا غروَ أن تبكيه إذ فقدت به","نواطق أعمال عن المجد تعرب",7,"ب",1,0],["وَلا غَروَ أَن أَعنو لَهُ بَعدَ عِزَّةٍ","فَقَدرِيَ في عِزِّ الحَبيبِ يَهونُ",8,"ن",1,0],["ولا غوفصت نفسٌ ببلوى وقد رأت","عِظاتٍ من الأيام بعد عظاتِ",9,"ت",1,0],["ولا غَرْوَ أن تحظى عَليَّ عصابة","لَوَتْ حمدها والحمدُ عندِيَ والحقدُ",10,"د",1,0],["ولا غَروَ أنت البحر تُفضي عُفاتُه","إلى الضحل من جَدواه ثم إلى الغمر",11,"ر",1,0],["ولا غرو إلا أننّي رُعت عنهُمُ","عُرام القوافي وهي نار تسعّر",12,"ر",1,0],["ولا غروَ أن ذلّتْ له بعد عزّةٍ","أنوفٌ عِدىً أضحتْ تُخَشُّ وتُخزَمُ",13,"م",1,0],["ولا غَرِقٌ ناجٍ من الكرب عَيْشُهُ","بحيث يكون الموت في الأخضر القطمْ",14,"م",1,0],["وَلا غَرَوَ إِن عَزَّت وَهانَ خُصومُها","فَلِلحَقِّ مَهما جَعجَعَ الباطِلُ النَصرُ",15,"ر",1,0],["وَلا غَرَوَ إِن أَهدى لَها الشِعرُ وَحيَهُ","فَيا طالَما سارَت وَسارَ بِها الشِعرُ",15,"ر",1,0],["وَلا غَرَوَ إِن صُغنا لَها النَثرَ حِلَيَةً","فَفي عُنُقُ الحَسناءِ يُستَحسَنُ الدُرُّ",15,"ر",1,0],["وَلا غَبيتُ ضَعفَها","وَلا نَسيتُ قُدرَتي",16,"ي",1,0],["وَلا غَلَبَتني شِقوَةٌ أَو سَعادَةٌ","عَلى حِكمَةٍ آتَيتَني وَأَناةِ",17,"ه",1,0],["ولا غرو إلّا بذله من كلامه","لأعناقنا الدُّرَّ الثمينَ المكرَّما",18,"م",2,0],["ولا غروَ أن أخنتْ عليك فإنَّما","يُصادَمُ بالخطبِ الجليل جليلُ",19,"ل",1,0],["ولا غَروَ أن يرتاحَ للصيدِ قانِصٌ","إِذا عَنَّ ظبيٌ بالصَّريمةِ جانِحُ",20,"ح",1,0],["وَلا غَروَ إِلّا أَن تَكيدَ سَراتَها","وَتَغمِسَ نَصلَ السَيفِ فيمَن يَكيدُها",21,"د",3,0],["وَلا غُمُرٌ قَد رَقَّصَ الخَفضُ قَلبَهُ","وَلا طارِفٌ في نِعمَةِ اللَهِ جاهِلُ",22,"ل",1,0],["وَلا غَروَ أَن وَطَّأتَ أَكنافَ مَرتَعي","لِمُهمِلِ أَخفاضي وَرَفَّهتَ مَشرَبي",23,"ي",1,0],["وَلا غامَ ما غامَ حَتّى اِنجَلى","فَأَضحى وَلا اِنقادَ حَتّى أَبى",24,"ب",2,0],["وَلا غَيمَ إِلّا قَسطَلٌ ثارَ أَقتَمٌ","وَلا بَرقَ إِلّا أَشقَرٌ جالَ تَجرَدُ",25,"د",1,0],["وَلا غَروَ أَن تَروى بِها عَينُ ناظِرٍ","وَباطِنُها ماءٌ وَظاهِرُها خَمرُ",26,"ر",1,0],["وَلا غَيرَ أَطرافِ الأَسِنَّةِ مِقوَلٌ","يُبينُ وَلا غَيرَ الفَرائِصِ مِسمَعُ",27,"ع",1,0],["وَلا غَروَ إِلّا جارَتي وَسُؤالُها","أَلا هَل لَنا أَهلٌ سُئِلتِ كَذَلِكِ",28,"ك",1,0],["ولا غَرو مِن تَرْكِ القَلانِسِ جانِباً","إِذا عَرفَتْ حَقِّي هُناكَ العمائِمُ",29,"م",1,0],["وَلاَ غَرَّكُمْ مِنِّي ابتِسَامٌ بِلِمَّتِي","فَرُبَّ ابتِسَامٍ لاَحَ وَهْوَ شُبُوبُ",30,"ب",1,0],["وَلا غُصنَ إِلاّ وَهوَ نَشوانُ راقِصٌ","وَلا طَيرَ إِلاّ وَهوَ فَرحانُ يَصدَحُ",31,"ح",1,0],["ولا غدّيت أطفالي","سوى همّي وأوصابي",32,"ي",1,0],["ولا غرو ان اكرمتم الضيف شيمة ً","توارثتُموها عن جُدود لكم غر",33,"ر",1,0]]}