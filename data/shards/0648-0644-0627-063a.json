كم أداري عاذلي ومفندي","https://www.aldiwan.net/poem33969.html","الطويل"],[404,"وحرمة ما بيني وبينك من حب","https://www.aldiwan.net/poem34138.html","الطويل"],[404,"نظم أرق من الشراب","https://www.aldiwan.net/poem34142.html","مجزوء الكامل"],[406,"ولا غرو أن يمنى أديب بجاهل","https://www.aldiwan.net/poem49550.html","الطويل"],[417,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[417,"دعاك أمير المؤمنين وإنما","https://www.aldiwan.net/poem54129.html","الطويل"],[430,"ولا غرو أن زرق العيون قتلنني","https://www.aldiwan.net/poem40505.html","الطويل"],[438,"قف إن شاني بهم أن يسفح الشان","https://www.aldiwan.net/poem2574.html","البسيط"],[438,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[440,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[440,"مكارمك اغتباقي واصطباحي","https://www.aldiwan.net/poem34896.html","الوافر"],[442,"على الذنب لي قلب شجاع مجرب","https://www.aldiwan.net/poem14379.html","الطويل"],[450,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[454,"كأنك لم تقرن بمجد مؤصل","https://www.aldiwan.net/poem61596.html","الطويل"],[459,"وفى لي بك الحظ الذي كان يغدر","https://www.aldiwan.net/poem56168.html","الطويل"],[471,"أإن نادى هديلا ذات فلج","https://www.aldiwan.net/poem4817.html","الوافر"],[496,"سقى الله نجدا كلما ذكروا نجدا","https://www.aldiwan.net/poem9820.html","الطويل"],[516,"فرض على الشعر أن يبدا بما يجب","https://www.aldiwan.net/poem12013.html","البسيط"],[516,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[516,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[516,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[530,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[552,"قطعت بها يا دهر حبل وتيني","https://www.aldiwan.net/poem47164.html","الطويل"],[552,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[552,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[576,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"],[587,"إذا بعدوا وافوك أسرى وإن دنوا","https://www.aldiwan.net/poem17704.html","الطويل"]],"verses":[["ولا غرو أن أزرى فشخصي حاضر","ورهطي من حي يبجل غائبه",0,"ب",2,0],["وَلا غَروَ أَن أُكسى القِلَى مِن كواعِبٍ","رِداءُ شَبابي عِندَهُنَّ سَليبُ",1,"ب",1,0],["وَلا غُنيَةٌ فيهِ بِغَيرِ أَخٍ لَهُ","شَديدِ القُوى صعبٍ عَلى الخَيلِ باسِلُ",2,"ل",1,0],["وَلأَغْوِي عِبَادَ اللهِ أَسْمَاءُ وَابْذُلِي","لِحَاظَكِ آلاءً وَإِنْ كُنَّ أَسْهُمَا",3,"م",2,0],["ولا غرو أن ملّكت ي الغنا","ء وأن أحرزت فيه أعلى الرتب",4,"ب",1,0],["ولا غدت تجرف الأسداد قاذفةً","منها بسيل على الأنحاء مندفق",5,"ق",1,0],["ولا غصت في بحر القريض مخاطراً","إذا لم أفز من درّه بثمينه",6,"ن",2,0],["ولا غروَ أن أبكي أسىً من بكائها","فأعظم ما يشجي بكاء الحرائر",7,"ر",1,0],["ولا غروَ أن تبكيه إذ فقدت به","نواطق أعمال عن المجد تعرب",8,"ب",1,0],["وَلا غَروَ أَن أَعنو لَهُ بَعدَ عِزَّةٍ","فَقَدرِيَ في عِزِّ الحَبيبِ يَهونُ",9,"ن",1,0],["ولا غوفصت نفسٌ ببلوى وقد رأت","عِظاتٍ من الأيام بعد عظاتِ",10,"ت",1,0],["ولا غَرْوَ أن تحظى عَليَّ عصابة","لَوَتْ حمدها والحمدُ عندِيَ والحقدُ",11,"د",1,0],["ولا غَروَ أنت البحر تُفضي عُفاتُه","إلى الضحل من جَدواه ثم إلى الغمر",12,"ر",1,0],["ولا غرو إلا أننّي رُعت عنهُمُ","عُرام القوافي وهي نار تسعّر",13,"ر",1,0],["ولا غروَ أن ذلّتْ له بعد عزّةٍ","أنوفٌ عِدىً أضحتْ تُخَشُّ وتُخزَمُ",14,"م",1,0],["ولا غَرِقٌ ناجٍ من الكرب عَيْشُهُ","بحيث يكون الموت في الأخضر القطمْ",15,"م",1,0],["وَلا غَرَوَ إِن عَزَّت وَهانَ خُصومُها","فَلِلحَقِّ مَهما جَعجَعَ الباطِلُ النَصرُ",16,"ر",1,0],["وَلا غَرَوَ إِن أَهدى لَها الشِعرُ وَحيَهُ","فَيا طالَما سارَت وَسارَ بِها الشِعرُ",16,"ر",1,0],["وَلا غَرَوَ إِن صُغنا لَها النَثرَ حِلَيَةً","فَفي عُنُقُ الحَسناءِ يُستَحسَنُ الدُرُّ",16,"ر",1,0],["وَلا غَبيتُ ضَعفَها","وَلا نَسيتُ قُدرَتي",17,"ي",1,0],["وَلا غَلَبَتني شِقوَةٌ أَو سَعادَةٌ","عَلى حِكمَةٍ آتَيتَني وَأَناةِ",18,"ه",1,0],["ولا غرو إلّا بذله من كلامه","لأعناقنا الدُّرَّ الثمينَ المكرَّما",19,"م",2,0],["ولا غروَ أن أخنتْ عليك فإنَّما","يُصادَمُ بالخطبِ الجليل جليلُ",20,"ل",1,0],["ولا غَروَ أن يرتاحَ للصيدِ قانِصٌ","إِذا عَنَّ ظبيٌ بالصَّريمةِ جانِحُ",21,"ح",1,0],["وَلا غَروَ إِلّا أَن تَكيدَ سَراتَها","وَتَغمِسَ نَصلَ السَيفِ فيمَن يَكيدُها",22,"د",3,0],["وَلا غُمُرٌ قَد رَقَّصَ الخَفضُ قَلبَهُ","وَلا طارِفٌ في نِعمَةِ اللَهِ جاهِلُ",23,"ل",1,0],["وَلا غَروَ أَن وَطَّأتَ أَكنافَ مَرتَعي","لِمُهمِلِ أَخفاضي وَرَفَّهتَ مَشرَبي",24,"ب",2,0],["وَلا غامَ ما غامَ حَتّى اِنجَلى","فَأَضحى وَلا اِنقادَ حَتّى أَبى",25,"ب",2,0],["وَلا غَيمَ إِلّا قَسطَلٌ ثارَ أَقتَمٌ","وَلا بَرقَ إِلّا أَشقَرٌ جالَ تَجرَدُ",26,"د",1,0],["وَلا غَروَ أَن تَروى بِها عَينُ ناظِرٍ","وَباطِنُها ماءٌ وَظاهِرُها خَمرُ",27,"ر",1,0],["وَلا غَيرَ أَطرافِ الأَسِنَّةِ مِقوَلٌ","يُبينُ وَلا غَيرَ الفَرائِصِ مِسمَعُ",28,"ع",1,0],["وَلا غَروَ إِلّا جارَتي وَسُؤالُها","أَلا هَل لَنا أَهلٌ سُئِلتِ كَذَلِكِ",29,"ك",1,0],["ولا غَرو مِن تَرْكِ القَلانِسِ جانِباً","إِذا عَرفَتْ حَقِّي هُناكَ العمائِمُ",30,"م",1,0],["وَلاَ غَرَّكُمْ مِنِّي ابتِسَامٌ بِلِمَّتِي","فَرُبَّ ابتِسَامٍ لاَحَ وَهْوَ شُبُوبُ",31,"ب",1,0],["وَلا غُصنَ إِلاّ وَهوَ نَشوانُ راقِصٌ","وَلا طَيرَ إِلاّ وَهوَ فَرحانُ يَصدَحُ",32,"ح",1,0],["ولا غدّيت أطفالي","سوى همّي وأوصابي",33,"ي",1,0],["ولا غرو إن أهدى لها الشعر وحيه","فيا طالما سارت وسار بها الشهر",34,"ر",1,0],["ولا غرو ان اكرمتم الضيف شيمة ً","توارثتُموها عن جُدود لكم غر",35,"ر",1,0],["ولا غاب إلا في الطبيعة أمه","وقدماً أعارته الضلوع الحوانيا",36,"ي",2,0],["وَلا غير ما فَوقَ الرَّوادِفِ بانَةٌ","وَلاَ غيرُ ما فَوقَ الجيوب صباحُ",37,"ح",1,0],["ولا غدا بضفاف البحر منزهنا","ولا رأت قهوة السمّار سارينا",38,"ن",2,0],["ولا غَرْو إِن أسلبت في الربْع أدْمعي","فلى في حمى لبلَى ليالٍ سوالفُ",39,"ف",1,0],["ولا غَرْوَ إن أمسيتُ حِلْف الأسى وقد","تناءى إِذاً عَنّي الحبيبُ المودِّعُ",40,"ع",1,0],["ولا غرو في أن فاض برك للورى","فإنكَ للخيراتِ لا شك منبع",41,"ع",1,0],["ولا غداةٌ أطارت نعيَه فغدا","كل امرىء بدم الأجفانِ مختضبا",42,"ب",2,0],["وَلا غاضَ مِن بَحرِ الأَجَلَّينِ زاخِرٌ","عَلا طامِياً آذِيُّهُ وَنَأى القَعرُ",43,"ر",1,0],["وَلا غَروَ أَن تُعطي أَمانِيَّ طالِبٍ","يَراكَ بِتَصديقِ المُنى مُتَكَفِّلا",44,"ل",2,0],["ولا غبن في الدنيا ولا من رزيئةٍ","سوى رجل عن نيلها حظّه نزر",45,"ر",1,0],["ولا غرو في هذا وقد قال ربّنا","تراهم عيون ينظرون ولا بصر",45,"ر",1,0],["ولا غرو أن حزتَ السِّباق ديانةً","فللدِّين والدنيا مدىً ورجال",46,"ل",1,0],["وَلا غَروَ أَن نَرتاحَ شَوقاً لِمَدحِهِ","فَهَذي حَمامُ الأَيكِ تَرتاحُ لِلشَدوِ",47,"و",1,0],["ولا غرو أن احياه والعرقُ واحدِ","ألست ترى كلا يقال له المقري",48,"ر",2,0],["ولا غرو أن يسمو على الأًصل فرعه","فللغيب وهو الفرع فضل على السحب",49,"ب",1,0],["ولا غرو أن يليه شأنك عنهم","فقد شغل الشيء الكثير عن النزر",50,"ر",1,0],["ولا غَرْ وَقد تُقِصى المقَاديرُ من دَنا","وتُدْنى مع اليأسِ الفتى وهْو شاسع",51,"ع",1,0],["ولا غابراً إلا على إثْرِ سالفٍ","أَوائِلُهُمْ للآخرينَ رُهون",52,"ن",1,0],["ولا غروَ إن زادَ أعداؤها","فقدْرُ النفوسِ بأعدائها",53,"ا",3,0],["ولا غيٌّ سوى غيِّ التَّصابي","ولا عبثٌ سوى عبثِ النديمِ",54,"م",1,0],["ولا غاب عن سمعي رنين حديثها","إذا اقتربت منى تريد التناجيا",55,"ي",2,0],["ولا غروَ أن الموتَ حَقّ ولازمٌ","على كلِّ ذي روحٍ إذا أكمَلَ العُمرُ",56,"ر",1,0],["ولا غدى مصطفاك رقاً","ولا كسا جسمه السقام",57,"م",1,0],["وَلا غَروَ إِن أَشرَق بِبَهجَةِ أَدمُعي","غَراماً بِوَجهٍ يُبهَرُ الشَمسَ إِشراقا",58,"ق",2,0],["وَلا غَروَ أَن تَبكي الدِماءُ لِكاسِبٍ","لَها كانَ يَسعى في البِلادِ وَيَكدَحُ",59,"ح",1,0],["وَلا غَروَ بِالوَرقاءِ في رَونَقِ الضُحى","يَرِفُّ لَها عَودُ الأَراكِ فَتَصدَحُ",59,"ح",1,0],["وَلاَ غُصْنَ إِلاَّ تَثَنَّى ارْتِيَاحاً","وَلاَ طَيْرَ إِلاَّ تََغَنَّى سُرُورَا",60,"ر",2,0],["ولا غرثى الوشاح كأن ورد ال","حياء بوجنتيها الجلنار",61,"ر",1,0],["وَلا غَروَ إِلّا حينَ جاءَت مُحارِبٌ","إِلَينا بِأَلفٍ حارِدٍ قَد تَكَتَّبا",62,"ب",2,0],["وَلا غَروَ إِلّا الخُضرُ خُضرُ مُحارِبٍ","يُمَشّونَ حَولي حاسِراً وَمُلَأَّما",63,"م",2,0],["ولا غرو ان اهدت يداه طرائفاً","وباطنها للمكرمات ظروف",64,"ف",1,0],["وَلا غَرْو أنْ أَصْبَحْتُ مُغْرَى فَإنَّهُ","بِأُخْتِ بَلِيٍّ فِي الهَوَى عَمَّت البَلْوَى",65,"و",2,0],["وَلا غَرْوَ أنْ تُغْرَى السُّعُودُ بأهْلِها","فَمَا قابَلوا النُّعْمَى بِغَمْطٍ ولا غَمْصِ",66,"ص",1,0],["ولا غَرْوَ أنْ قِيسَتْ عَلَى تِلْكَ هَذِهِ","فَكَمْ مِنْ قِيَاسٍ في عِدَاكَ غَدا نَصَّا",67,"ص",2,0],["وَلأَغلِبَنّ عَلى السلوّ صَبابتي","والشّوْقُ في كُل المواطن أغْلبُ",68,"ب",1,0],["وَلا غَرْوَ أَنْ أَصْبَحْتَ غُفْلاً مِنَ الْهَوى","فَأَنْكَرْتَ ما بِي لِلصَّبابَةِ مِنْ رَسْمِ",69,"م",1,0],["وَلا غَرو أَن نالَتكَ أَطرافُ وَعكَةٍ","كَما يوعَكُ الرِئبالُ إِذ كُنتَ شكلَهُ",70,"ل",2,0],["وَلا غَروَ أَن جادَت جُفوني بِمائِها","إِذا كانَ مَن أَهواهُ بِالوَصلِ يَبخَلُ",71,"ل",1,0],["وَلا غَروَ أَن عادَ الفِرَنجُ هَزيمَةً","وَلَو لَم تَعُد لَم يَبقَ لِلشِركِ ساحِلُ",72,"ل",1,0],["ولا غَريبَ إِذا أَصبَحتُ ذا حَزَنٍ","إنَّ الغَريبَ حزينٌ حيثما كانا",73,"ن",2,0],["ولا غروَ أَن أَربت على القول أَنَّها","كَلامُ ملوكٍ أَو مُلوكُ كلامِ",74,"م",1,0],["ولا غلوَّ إذا ما قُلتُ عزمتُه","تَكاد تَثني عهودَ الأَعصر القُدُمِ",75,"م",1,0],["وَلا غروَ إِن أَصبَحَت تُشتَهى","فَقَد حُفَّت النارُ بالشَهواتِ",76,"ت",1,0],["وَلا غضاضة في تركِ البلادِ وَقَدْ","(خُيِّرتَ أمرين ضاعَ الحزمُ بينهما)",77,"م",2,0],["ولا غرو أن صدقت حلو حديثها","وسكره يرويه لي عن أبي الذر",78,"ر",1,0],["وَلا غَرابَةَ إِن قَد باتَ مِن حَسَدِ","مِن هالِهِم أَمرَها في مُنتَهى النَكَدِ",79,"د",1,0],["وَلا غَلوَ لَو اِستَدعى النُجومَ هَوَت","وَكَيفَ لا وَعَلَيَّ العَرشَ وَطَأتُهُ",80,"ت",2,0],["وَلا غَرَسَ الأُمورَ وَلا اِجتَناها","كَيَحيى حينَ يَعزِمُ أِو يَسيرُ",81,"ر",1,0],["وَلا غَروَ أَن يَمضي بِإِنتاجِ مِث","لِهِ الزَمانُ عَقيماً وَهوَ لِلدَهرِ مُنتَجُ",82,"ج",1,0],["وَلأغفرنّ ذُنوبَ دَهري كلها","وَأَقول لَيسَ من الزَمانِ شقاق",83,"ق",1,0],["ولا غَرْوَ إلاّ مَن يَظَلُّ على الَّذي","يُضيّعُ من أَيّامِه غيرَ لَهْفان",84,"ن",1,0],["ولا غَرو أن يَسخو بظِلٍّ نَحُلُّه","فتىّ جُودُه فَوقَ الورى سابِغُ الظِّلّ",85,"ل",1,0],["ولا غَرْوَ أن تُمسي الرّياحُ عليلةً","إذا ما جعَلْناهُنَّ ما بَيْننا رُسْلا",86,"ل",2,0],["ولا غَرض إلا يُصيبُ لأنّه","إذا سُلَ سيفٌ من يدِ اللهِ صائب",87,"ب",1,0],["وَلا غَروَ لَو ضَلَّ مَن قَد هَدَيتَ","ضَلالُ الدَليلِ دَليلُ الضَلالِ",88,"ل",1,0],["ولا غرو أن آتي هنيدة سالماً","فقد يدركُ الإنسان ما يتوقع",89,"ع",1,0],["ولا غدت أرضُ مصر من مقاصده","إِلا ليجعل في مغناك منزله",90,"ل",2,0],["ولا غرو أن البكر يفضُلُ إرثُه","على الدون كالصنديد حين يصول",91,"ل",1,0],["ولا غيره من كل قول لأنه","عدد ذر كل الرمل في الكثر والعظم",92,"م",1,0],["ولا غرو يا مولاي إن قُرئتْ بأن","تداولَ سمعَ المرء أنملُه العشرُ",93,"ر",1,0],["ولأغصانها إذا هبت الريح","اعتناق الأحباب والتقبيل",94,"ل",1,0],["ولا غرو إن آثرت أهلاً ووالداً","علينا وآثرت الملوك ذوي الأمر",95,"ر",1,0],["ولا غرو من حاز الكمال فإنما","يكون أميراً أو أسيراً لأصْيَدِ",96,"د",1,0],["ولا غرو للأبناء إرث أبيهمُ","فيا حبذا ما نلت من ذلك القرب",97,"ب",1,0],["ولاغفرن له الذُّنو","ب السالفات إلى جنابي",98,"ب",2,0],["ولا غَرْوَ أنْ يُمنى أديبٌ بجاهِلٍ","فمِن ذَنَبِ التِّنِّينِ تَنكسِفُ الشَّمْسُ",99,"س",1,1],["ولا غروَ في ذاك المكان المطهر","أمطنا القذى عن جفن سيف مذكر",100,"ر",1,0],["ولا غرو من كانَ الفتوح بوجهه","إذا استفتح الإسلام فيه المغالقا",101,"ق",2,0],["ولا غروَ أنْ زرقُ العيون قتلنني","فإنَّ الرماح الخُطَّ زرقٌ سنانها",102,"ه",2,1],["ولا غدوتُ بآمالي إلى أحد","له من المال شبع وهو غرثان",103,"ن",1,0],["ولا غرو أن تقفوا أباك متابعا","لتلك الأيادي البيض والشيم الغر",104,"ر",1,0],["ولا غابَ من وافاكَ من أرْضِ رُومَةٍ","بغابٍ من الخَطِّيِّ تَزْأَرُ أُسْدُهُ",105,"د",2,0],["ولا غَنَّتْ ليَ الآمالُ إِلّا","وحظُّ رضاكَ سُؤْلِي واقتراحي",106,"ح",2,0],["ولا غصةً تحكي إلى الذنب غصةٌ","ولا كلفي في الموبقات لهيف",107,"ف",1,0],["ولا غزوا في سبيل الله أندلس","ولا فدوا حين عز المال والطلب",108,"ب",1,0],["ولا غرو إذ صلى الرئيسُ لحفظه","وأزجى دُعاءً قد أضاءَ منارا",109,"ر",2,0],["ولا غشيت ظلماءُ إلا وفجرُها","برغم العدا عما تُحبّون يُسفرُ",110,"ر",1,0],["وَلا غَفَرَ الإِلَهُ لِمُنكِحيها","ذُنوبَهُمُ وَإِن صَلّوا وَصاموا",111,"م",3,0],["ولا غَرَرٌ إلا شمِمْتُ له يداً","ولا خطر إلا قدحت له زندا",112,"د",2,0],["ولا غزونا أياديه بمسألة","إلا سلبناه ما يقنى القنا السلب",113,"ب",1,0],["ولا غرو إن ماتت حقود بصدره","فإن صدور القادرين لحود",114,"د",1,0],["ولا غدا مثلي ومثلي معوز","يعرف مابين الورى بشاعر",115,"ر",1,0],["ولاغرو أن ماتت حقودكم بحلمكم","فإن صدور القادرين قبورها",116,"ر",3,0],["وَلا غَدَتْ لِعَشاءِ النّاظِرينَ لَهَا","كَأَنّها طَلَعَتْ في مُظْلِمِ الحُجُبِ",117,"ب",1,0],["ولا غَرْوَ أنْ أبكي لمنْ خفّ بالرّدى","إذا كنتُ أبكي يومَ خفَّ قطيني",118,"ن",2,0],["وَلا غفرَ الإلهُ لكمْ ذنوباً","ولا جُزتمْ هنالِكمُ الصِّراطا",119,"ط",2,0],["ولا غمضَ ولا أرضَ","لِعَينَيَّ وللجنبِ",120,"ب",1,0],["ولا غَرْوَ إِنْ تَاهَتْ بِمُلكِكَ وازْدَهَتَ","ولا عجباً إِنْ أسْرفَتْ بكَ في العُجْب",121,"ب",1,0],["وَلا غائِبٌ إِلّا أَتى وَهْوَ تَائِبٌ","وَلا قَادِمٌ إلّا أَتَى وَهْوَ نَادِمُ",122,"م",1,0]]}