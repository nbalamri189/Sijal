],[407,"بث سر الهوى عليه النحول","https://www.aldiwan.net/poem33486.html","الخفيف"],[407,"بعثت بشعر أم بعقد من الدر","https://www.aldiwan.net/poem33902.html","الطويل"],[407,"إلى كم أداري عاذلي ومفندي","https://www.aldiwan.net/poem33969.html","الطويل"],[407,"وحرمة ما بيني وبينك من حب","https://www.aldiwan.net/poem34138.html","الطويل"],[407,"نظم أرق من الشراب","https://www.aldiwan.net/poem34142.html","مجزوء الكامل"],[409,"ولا غرو أن يمنى أديب بجاهل","https://www.aldiwan.net/poem49550.html","الطويل"],[420,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[420,"دعاك أمير المؤمنين وإنما","https://www.aldiwan.net/poem54129.html","الطويل"],[433,"ولا غرو أن زرق العيون قتلنني","https://www.aldiwan.net/poem40505.html","الطويل"],[441,"قف إن شاني بهم أن يسفح الشان","https://www.aldiwan.net/poem2574.html","البسيط"],[441,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[443,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[443,"مكارمك اغتباقي واصطباحي","https://www.aldiwan.net/poem34896.html","الوافر"],[445,"على الذنب لي قلب شجاع مجرب","https://www.aldiwan.net/poem14379.html","الطويل"],[452,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[456,"كأنك لم تقرن بمجد مؤصل","https://www.aldiwan.net/poem61596.html","الطويل"],[461,"وفى لي بك الحظ الذي كان يغدر","https://www.aldiwan.net/poem56168.html","الطويل"],[473,"أإن نادى هديلا ذات فلج","https://www.aldiwan.net/poem4817.html","الوافر"],[498,"سقى الله نجدا كلما ذكروا نجدا","https://www.aldiwan.net/poem9820.html","الطويل"],[518,"فرض على الشعر أن يبدا بما يجب","https://www.aldiwan.net/poem12013.html","البسيط"],[518,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[518,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[518,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[532,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[554,"قطعت بها يا دهر حبل وتيني","https://www.aldiwan.net/poem47164.html","الطويل"],[554,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[554,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[578,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"],[589,"إذا بعدوا وافوك أسرى وإن دنوا","https://www.aldiwan.net/poem17704.html","الطويل"],[1021,"أرى جارتي خَفّتْ، وخفّ نَصيحُها","https://www.poetsgate.com/ViewPoem.aspx?id=5339",""]],"verses":[["ولا غرو أن أزرى فشخصي حاضر","ورهطي من حي يبجل غائبه",0,"ب",2,0],["وَلا غَروَ أَن أُكسى القِلَى مِن كواعِبٍ","رِداءُ شَبابي عِندَهُنَّ سَليبُ",1,"ب",1,0],["وَلا غُنيَةٌ فيهِ بِغَيرِ أَخٍ لَهُ","شَديدِ القُوى صعبٍ عَلى الخَيلِ باسِلُ",2,"ل",1,0],["وَلأَغْوِي عِبَادَ اللهِ أَسْمَاءُ وَابْذُلِي","لِحَاظَكِ آلاءً وَإِنْ كُنَّ أَسْهُمَا",3,"م",2,0],["ولا غرو أن ملّكت ي الغنا","ء وأن أحرزت فيه أعلى الرتب",4,"ب",1,0],["ولا غدت تجرف الأسداد قاذفةً","منها بسيل على الأنحاء مندفق",5,"ق",1,0],["ولا غصت في بحر القريض مخاطراً","إذا لم أفز من درّه بثمينه",6,"ن",2,0],["ولا غروَ أن أبكي أسىً من بكائها","فأعظم ما يشجي بكاء الحرائر",7,"ر",1,0],["ولا غروَ أن تبكيه إذ فقدت به","نواطق أعمال عن المجد تعرب",8,"ب",1,0],["وَلا غَروَ أَن أَعنو لَهُ بَعدَ عِزَّةٍ","فَقَدرِيَ في عِزِّ الحَبيبِ يَهونُ",9,"ن",1,0],["ولا غوفصت نفسٌ ببلوى وقد رأت","عِظاتٍ من الأيام بعد عظاتِ",10,"ت",1,0],["ولا غَرْوَ أن تحظى عَليَّ عصابة","لَوَتْ حمدها والحمدُ عندِيَ والحقدُ",11,"د",1,0],["ولا غَروَ أنت البحر تُفضي عُفاتُه","إلى الضحل من جَدواه ثم إلى الغمر",12,"ر",1,0],["ولا غرو إلا أننّي رُعت عنهُمُ","عُرام القوافي وهي نار تسعّر",13,"ر",1,0],["ولا غروَ أن ذلّتْ له بعد عزّةٍ","أنوفٌ عِدىً أضحتْ تُخَشُّ وتُخزَمُ",14,"م",1,0],["ولا غَرِقٌ ناجٍ من الكرب عَيْشُهُ","بحيث يكون الموت في الأخضر القطمْ",15,"م",1,0],["وَلا غَرَوَ إِن عَزَّت وَهانَ خُصومُها","فَلِلحَقِّ مَهما جَعجَعَ الباطِلُ النَصرُ",16,"ر",1,0],["وَلا غَرَوَ إِن أَهدى لَها الشِعرُ وَحيَهُ","فَيا طالَما سارَت وَسارَ بِها الشِعرُ",16,"ر",1,0],["وَلا غَرَوَ إِن صُغنا لَها النَثرَ حِلَيَةً","فَفي عُنُقُ الحَسناءِ يُستَحسَنُ الدُرُّ",16,"ر",1,0],["وَلا غَبيتُ ضَعفَها","وَلا نَسيتُ قُدرَتي",17,"ي",1,0],["وَلا غَلَبَتني شِقوَةٌ أَو سَعادَةٌ","عَلى حِكمَةٍ آتَيتَني وَأَناةِ",18,"ه",1,0],["ولا غرو إلّا بذله من كلامه","لأعناقنا الدُّرَّ الثمينَ المكرَّما",19,"م",2,0],["ولا غروَ أن أخنتْ عليك فإنَّما","يُصادَمُ بالخطبِ الجليل جليلُ",20,"ل",1,0],["ولا غَروَ أن يرتاحَ للصيدِ قانِصٌ","إِذا عَنَّ ظبيٌ بالصَّريمةِ جانِحُ",21,"ح",1,0],["وَلا غَروَ إِلّا أَن تَكيدَ سَراتَها","وَتَغمِسَ نَصلَ السَيفِ فيمَن يَكيدُها",22,"د",3,0],["وَلا غُمُرٌ قَد رَقَّصَ الخَفضُ قَلبَهُ","وَلا طارِفٌ في نِعمَةِ اللَهِ جاهِلُ",23,"ل",1,0],["وَلا غَروَ أَن وَطَّأتَ أَكنافَ مَرتَعي","لِمُهمِلِ أَخفاضي وَرَفَّهتَ مَشرَبي",24,"ب",2,0],["وَلا غامَ ما غامَ حَتّى اِنجَلى","فَأَضحى وَلا اِنقادَ حَتّى أَبى",25,"ب",2,0],["وَلا غَيمَ إِلّا قَسطَلٌ ثارَ أَقتَمٌ","وَلا بَرقَ إِلّا أَشقَرٌ جالَ تَجرَدُ",26,"د",1,0],["وَلا غَروَ أَن تَروى بِها عَينُ ناظِرٍ","وَباطِنُها ماءٌ وَظاهِرُها خَمرُ",27,"ر",1,0],["وَلا غَيرَ أَطرافِ الأَسِنَّةِ مِقوَلٌ","يُبينُ وَلا غَيرَ الفَرائِصِ مِسمَعُ",28,"ع",1,0],["وَلا غَروَ إِلّا جارَتي وَسُؤالُها","أَلا هَل لَنا أَهلٌ سُئِلتِ كَذَلِكِ",29,"ك",1,0],["ولا غَرو مِن تَرْكِ القَلانِسِ جانِباً","إِذا عَرفَتْ حَقِّي هُناكَ العمائِمُ",30,"م",1,0],["وَلاَ غَرَّكُمْ مِنِّي ابتِسَامٌ بِلِمَّتِي","فَرُبَّ ابتِسَامٍ لاَحَ وَهْوَ شُبُوبُ",31,"ب",1,0],["وَلا غُصنَ إِلاّ وَهوَ نَشوانُ راقِصٌ","وَلا طَيرَ إِلاّ وَهوَ فَرحانُ يَصدَحُ",32,"ح",1,0],["ولا غدّيت أطفالي","سوى همّي وأوصابي",33,"ي",1,0],["ولا غرو هذا فان السنين","يدور على الناس دولابها",34,"ب",3,0],["ولا غرو ان تستنزف الصبر نكبة","ويقصر من تطراقها المتعزم",35,"م",1,0],["ولا غرو إن أهدى لها الشعر وحيه","فيا طالما سارت وسار بها الشهر",36,"ر",1,0],["ولا غرو ان اكرمتم الضيف شيمة ً","توارثتُموها عن جُدود لكم غر",37,"ر",1,0],["ولا غاب إلا في الطبيعة أمه","وقدماً أعارته الضلوع الحوانيا",38,"ي",2,0],["وَلا غير ما فَوقَ الرَّوادِفِ بانَةٌ","وَلاَ غيرُ ما فَوقَ الجيوب صباحُ",39,"ح",1,0],["ولا غدا بضفاف البحر منزهنا","ولا رأت قهوة السمّار سارينا",40,"ن",2,0],["ولا غَرْو إِن أسلبت في الربْع أدْمعي","فلى في حمى لبلَى ليالٍ سوالفُ",41,"ف",1,0],["ولا غَرْوَ إن أمسيتُ حِلْف الأسى وقد","تناءى إِذاً عَنّي الحبيبُ المودِّعُ",42,"ع",1,0],["ولا غرو في أن فاض برك للورى","فإنكَ للخيراتِ لا شك منبع",43,"ع",1,0],["ولا غداةٌ أطارت نعيَه فغدا","كل امرىء بدم الأجفانِ مختضبا",44,"ب",2,0],["وَلا غاضَ مِن بَحرِ الأَجَلَّينِ زاخِرٌ","عَلا طامِياً آذِيُّهُ وَنَأى القَعرُ",45,"ر",1,0],["وَلا غَروَ أَن تُعطي أَمانِيَّ طالِبٍ","يَراكَ بِتَصديقِ المُنى مُتَكَفِّلا",46,"ل",2,0],["ولا غبن في الدنيا ولا من رزيئةٍ","سوى رجل عن نيلها حظّه نزر",47,"ر",1,0],["ولا غرو في هذا وقد قال ربّنا","تراهم عيون ينظرون ولا بصر",47,"ر",1,0],["ولا غرو أن حزتَ السِّباق ديانةً","فللدِّين والدنيا مدىً ورجال",48,"ل",1,0],["وَلا غَروَ أَن نَرتاحَ شَوقاً لِمَدحِهِ","فَهَذي حَمامُ الأَيكِ تَرتاحُ لِلشَدوِ",49,"و",1,0],["ولا غرو أن احياه والعرقُ واحدِ","ألست ترى كلا يقال له المقري",50,"ر",2,0],["ولا غرو أن يسمو على الأًصل فرعه","فللغيب وهو الفرع فضل على السحب",51,"ب",1,0],["ولا غرو أن يليه شأنك عنهم","فقد شغل الشيء الكثير عن النزر",52,"ر",1,0],["ولا غَرْ وَقد تُقِصى المقَاديرُ من دَنا","وتُدْنى مع اليأسِ الفتى وهْو شاسع",53,"ع",1,0],["ولا غابراً إلا على إثْرِ سالفٍ","أَوائِلُهُمْ للآخرينَ رُهون",54,"ن",1,0],["ولا غروَ إن زادَ أعداؤها","فقدْرُ النفوسِ بأعدائها",55,"ا",3,0],["ولا غيٌّ سوى غيِّ التَّصابي","ولا عبثٌ سوى عبثِ النديمِ",56,"م",1,0],["ولا غاب عن سمعي رنين حديثها","إذا اقتربت منى تريد التناجيا",57,"ي",2,0],["ولا غروَ أن الموتَ حَقّ ولازمٌ","على كلِّ ذي روحٍ إذا أكمَلَ العُمرُ",58,"ر",1,0],["ولا غدى مصطفاك رقاً","ولا كسا جسمه السقام",59,"م",1,0],["وَلا غَروَ إِن أَشرَق بِبَهجَةِ أَدمُعي","غَراماً بِوَجهٍ يُبهَرُ الشَمسَ إِشراقا",60,"ق",2,0],["وَلا غَروَ أَن تَبكي الدِماءُ لِكاسِبٍ","لَها كانَ يَسعى في البِلادِ وَيَكدَحُ",61,"ح",1,0],["وَلا غَروَ بِالوَرقاءِ في رَونَقِ الضُحى","يَرِفُّ لَها عَودُ الأَراكِ فَتَصدَحُ",61,"ح",1,0],["وَلاَ غُصْنَ إِلاَّ تَثَنَّى ارْتِيَاحاً","وَلاَ طَيْرَ إِلاَّ تََغَنَّى سُرُورَا",62,"ر",2,0],["ولا غرثى الوشاح كأن ورد ال","حياء بوجنتيها الجلنار",63,"ر",1,0],["وَلا غَروَ إِلّا حينَ جاءَت مُحارِبٌ","إِلَينا بِأَلفٍ حارِدٍ قَد تَكَتَّبا",64,"ب",2,0],["وَلا غَروَ إِلّا الخُضرُ خُضرُ مُحارِبٍ","يُمَشّونَ حَولي حاسِراً وَمُلَأَّما",65,"م",2,0],["ولا غرو ان اهدت يداه طرائفاً","وباطنها للمكرمات ظروف",66,"ف",1,0],["وَلا غَرْو أنْ أَصْبَحْتُ مُغْرَى فَإنَّهُ","بِأُخْتِ بَلِيٍّ فِي الهَوَى عَمَّت البَلْوَى",67,"و",2,0],["وَلا غَرْوَ أنْ تُغْرَى السُّعُودُ بأهْلِها","فَمَا قابَلوا النُّعْمَى بِغَمْطٍ ولا غَمْصِ",68,"ص",1,0],["ولا غَرْوَ أنْ قِيسَتْ عَلَى تِلْكَ هَذِهِ","فَكَمْ مِنْ قِيَاسٍ في عِدَاكَ غَدا نَصَّا",69,"ص",2,0],["وَلأَغلِبَنّ عَلى السلوّ صَبابتي","والشّوْقُ في كُل المواطن أغْلبُ",70,"ب",1,0],["وَلا غَرْوَ أَنْ أَصْبَحْتَ غُفْلاً مِنَ الْهَوى","فَأَنْكَرْتَ ما بِي لِلصَّبابَةِ مِنْ رَسْمِ",71,"م",1,0],["وَلا غَرو أَن نالَتكَ أَطرافُ وَعكَةٍ","كَما يوعَكُ الرِئبالُ إِذ كُنتَ شكلَهُ",72,"ل",2,0],["وَلا غَروَ أَن جادَت جُفوني بِمائِها","إِذا كانَ مَن أَهواهُ بِالوَصلِ يَبخَلُ",73,"ل",1,0],["وَلا غَروَ أَن عادَ الفِرَنجُ هَزيمَةً","وَلَو لَم تَعُد لَم يَبقَ لِلشِركِ ساحِلُ",74,"ل",1,0],["ولا غَريبَ إِذا أَصبَحتُ ذا حَزَنٍ","إنَّ الغَريبَ حزينٌ حيثما كانا",75,"ن",2,0],["ولا غروَ أَن أَربت على القول أَنَّها","كَلامُ ملوكٍ أَو مُلوكُ كلامِ",76,"م",1,0],["ولا غلوَّ إذا ما قُلتُ عزمتُه","تَكاد تَثني عهودَ الأَعصر القُدُمِ",77,"م",1,0],["وَلا غروَ إِن أَصبَحَت تُشتَهى","فَقَد حُفَّت النارُ بالشَهواتِ",78,"ت",1,0],["وَلا غضاضة في تركِ البلادِ وَقَدْ","(خُيِّرتَ أمرين ضاعَ الحزمُ بينهما)",79,"م",2,0],["ولا غرو أن صدقت حلو حديثها","وسكره يرويه لي عن أبي الذر",80,"ر",1,0],["وَلا غَرابَةَ إِن قَد باتَ مِن حَسَدِ","مِن هالِهِم أَمرَها في مُنتَهى النَكَدِ",81,"د",1,0],["وَلا غَلوَ لَو اِستَدعى النُجومَ هَوَت","وَكَيفَ لا وَعَلَيَّ العَرشَ وَطَأتُهُ",82,"ت",2,0],["وَلا غَرَسَ الأُمورَ وَلا اِجتَناها","كَيَحيى حينَ يَعزِمُ أِو يَسيرُ",83,"ر",1,0],["وَلا غَروَ أَن يَمضي بِإِنتاجِ مِث","لِهِ الزَمانُ عَقيماً وَهوَ لِلدَهرِ مُنتَجُ",84,"ج",1,0],["وَلأغفرنّ ذُنوبَ دَهري كلها","وَأَقول لَيسَ من الزَمانِ شقاق",85,"ق",1,0],["ولا غَرْوَ إلاّ مَن يَظَلُّ على الَّذي","يُضيّعُ من أَيّامِه غيرَ لَهْفان",86,"ن",1,0],["ولا غَرو أن يَسخو بظِلٍّ نَحُلُّه","فتىّ جُودُه فَوقَ الورى سابِغُ الظِّلّ",87,"ل",1,0],["ولا غَرْوَ أن تُمسي الرّياحُ عليلةً","إذا ما جعَلْناهُنَّ ما بَيْننا رُسْلا",88,"ل",2,0],["ولا غَرض إلا يُصيبُ لأنّه","إذا سُلَ سيفٌ من يدِ اللهِ صائب",89,"ب",1,0],["وَلا غَروَ لَو ضَلَّ مَن قَد هَدَيتَ","ضَلالُ الدَليلِ دَليلُ الضَلالِ",90,"ل",1,0],["ولا غرو أن آتي هنيدة سالماً","فقد يدركُ الإنسان ما يتوقع",91,"ع",1,0],["ولا غدت أرضُ مصر من مقاصده","إِلا ليجعل في مغناك منزله",92,"ل",2,0],["ولا غرو أن البكر يفضُلُ إرثُه","على الدون كالصنديد حين يصول",93,"ل",1,0],["ولا غيره من كل قول لأنه","عدد ذر كل الرمل في الكثر والعظم",94,"م",1,0],["ولا غرو يا مولاي إن قُرئتْ بأن","تداولَ سمعَ المرء أنملُه العشرُ",95,"ر",1,0],["ولأغصانها إذا هبت الريح","اعتناق الأحباب والتقبيل",96,"ل",1,0],["ولا غرو إن آثرت أهلاً ووالداً","علينا وآثرت الملوك ذوي الأمر",97,"ر",1,0],["ولا غرو من حاز الكمال فإنما","يكون أميراً أو أسيراً لأصْيَدِ",98,"د",1,0],["ولا غرو للأبناء إرث أبيهمُ","فيا حبذا ما نلت من ذلك القرب",99,"ب",1,0],["ولاغفرن له الذُّنو","ب السالفات إلى جنابي",100,"ب",2,0],["ولا غَرْوَ أنْ يُمنى أديبٌ بجاهِلٍ","فمِن ذَنَبِ التِّنِّينِ تَنكسِفُ الشَّمْسُ",101,"س",1,1],["ولا غروَ في ذاك المكان المطهر","أمطنا القذى عن جفن سيف مذكر",102,"ر",1,0],["ولا غرو من كانَ الفتوح بوجهه","إذا استفتح الإسلام فيه المغالقا",103,"ق",2,0],["ولا غروَ أنْ زرقُ العيون قتلنني","فإنَّ الرماح الخُطَّ زرقٌ سنانها",104,"ه",2,1],["ولا غدوتُ بآمالي إلى أحد","له من المال شبع وهو غرثان",105,"ن",1,0],["ولا غرو أن تقفوا أباك متابعا","لتلك الأيادي البيض والشيم الغر",106,"ر",1,0],["ولا غابَ من وافاكَ من أرْضِ رُومَةٍ","بغابٍ من الخَطِّيِّ تَزْأَرُ أُسْدُهُ",107,"د",2,0],["ولا غَنَّتْ ليَ الآمالُ إِلّا","وحظُّ رضاكَ سُؤْلِي واقتراحي",108,"ح",2,0],["ولا غصةً تحكي إلى الذنب غصةٌ","ولا كلفي في الموبقات لهيف",109,"ف",1,0],["ولا غزوا في سبيل الله أندلس","ولا فدوا حين عز المال والطلب",110,"ب",1,0],["ولا غرو إذ صلى الرئيسُ لحفظه","وأزجى دُعاءً قد أضاءَ منارا",111,"ر",2,0],["ولا غشيت ظلماءُ إلا وفجرُها","برغم العدا عما تُحبّون يُسفرُ",112,"ر",1,0],["وَلا غَفَرَ الإِلَهُ لِمُنكِحيها","ذُنوبَهُمُ وَإِن صَلّوا وَصاموا",113,"م",3,0],["ولا غَرَرٌ إلا شمِمْتُ له يداً","ولا خطر إلا قدحت له زندا",114,"د",2,0],["ولا غزونا أياديه بمسألة","إلا سلبناه ما يقنى القنا السلب",115,"ب",1,0],["ولا غرو إن ماتت حقود بصدره","فإن صدور القادرين لحود",116,"د",1,0],["ولا غدا مثلي ومثلي معوز","يعرف مابين الورى بشاعر",117,"ر",1,0],["ولاغرو أن ماتت حقودكم بحلمكم","فإن صدور القادرين قبورها",118,"ر",3,0],["وَلا غَدَتْ لِعَشاءِ النّاظِرينَ لَهَا","كَأَنّها طَلَعَتْ في مُظْلِمِ الحُجُبِ",119,"ب",1,0],["ولا غَرْوَ أنْ أبكي لمنْ خفّ بالرّدى","إذا كنتُ أبكي يومَ خفَّ قطيني",120,"ن",2,0],["وَلا غفرَ الإلهُ لكمْ ذنوباً","ولا جُزتمْ هنالِكمُ الصِّراطا",121,"ط",2,0],["ولا غمضَ ولا أرضَ","لِعَينَيَّ وللجنبِ",122,"ب",1,0],["ولا غَرْوَ إِنْ تَاهَتْ بِمُلكِكَ وازْدَهَتَ","ولا عجباً إِنْ أسْرفَتْ بكَ في العُجْب",123,"ب",1,0],["وَلا غائِبٌ إِلّا أَتى وَهْوَ تَائِبٌ","وَلا قَادِمٌ إلّا أَتَى وَهْوَ نَادِمُ",124,"م",1,0],["ٍ ولا غَمْرَة ٍ إلاَّ وَشِيكاً مُصُوحُهَا","نَقِيلة ُ نَعلٍ بانَ منها سَريحُها",125,"ح",3,0]]}