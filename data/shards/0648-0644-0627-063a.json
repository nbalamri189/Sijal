m34138.html","الطويل"],[400,"نظم أرق من الشراب","https://www.aldiwan.net/poem34142.html","مجزوء الكامل"],[402,"ولا غرو أن يمنى أديب بجاهل","https://www.aldiwan.net/poem49550.html","الطويل"],[413,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[413,"دعاك أمير المؤمنين وإنما","https://www.aldiwan.net/poem54129.html","الطويل"],[426,"ولا غرو أن زرق العيون قتلنني","https://www.aldiwan.net/poem40505.html","الطويل"],[434,"قف إن شاني بهم أن يسفح الشان","https://www.aldiwan.net/poem2574.html","البسيط"],[434,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[436,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[436,"مكارمك اغتباقي واصطباحي","https://www.aldiwan.net/poem34896.html","الوافر"],[438,"على الذنب لي قلب شجاع مجرب","https://www.aldiwan.net/poem14379.html","الطويل"],[447,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[451,"كأنك لم تقرن بمجد مؤصل","https://www.aldiwan.net/poem61596.html","الطويل"],[456,"وفى لي بك الحظ الذي كان يغدر","https://www.aldiwan.net/poem56168.html","الطويل"],[468,"أإن نادى هديلا ذات فلج","https://www.aldiwan.net/poem4817.html","الوافر"],[493,"سقى الله نجدا كلما ذكروا نجدا","https://www.aldiwan.net/poem9820.html","الطويل"],[513,"فرض على الشعر أن يبدا بما يجب","https://www.aldiwan.net/poem12013.html","البسيط"],[513,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[513,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[513,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[527,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[549,"قطعت بها يا دهر حبل وتيني","https://www.aldiwan.net/poem47164.html","الطويل"],[549,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[549,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[573,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"],[584,"إذا بعدوا وافوك أسرى وإن دنوا","https://www.aldiwan.net/poem17704.html","الطويل"]],"verses":[["وَلا غَروَ أَن أُكسى القِلَى مِن كواعِبٍ","رِداءُ شَبابي عِندَهُنَّ سَليبُ",0,"ب",1,0],["وَلا غُنيَةٌ فيهِ بِغَيرِ أَخٍ لَهُ","شَديدِ القُوى صعبٍ عَلى الخَيلِ باسِلُ",1,"ل",1,0],["وَلأَغْوِي عِبَادَ اللهِ أَسْمَاءُ وَابْذُلِي","لِحَاظَكِ آلاءً وَإِنْ كُنَّ أَسْهُمَا",2,"م",2,0],["ولا غرو أن ملّكت ي الغنا","ء وأن أحرزت فيه أعلى الرتب",3,"ب",1,0],["ولا غدت تجرف الأسداد قاذفةً","منها بسيل على الأنحاء مندفق",4,"ق",1,0],["ولا غصت في بحر القريض مخاطراً","إذا لم أفز من درّه بثمينه",5,"ن",2,0],["ولا غروَ أن أبكي أسىً من بكائها","فأعظم ما يشجي بكاء الحرائر",6,"ر",1,0],["ولا غروَ أن تبكيه إذ فقدت به","نواطق أعمال عن المجد تعرب",7,"ب",1,0],["وَلا غَروَ أَن أَعنو لَهُ بَعدَ عِزَّةٍ","فَقَدرِيَ في عِزِّ الحَبيبِ يَهونُ",8,"ن",1,0],["ولا غوفصت نفسٌ ببلوى وقد رأت","عِظاتٍ من الأيام بعد عظاتِ",9,"ت",1,0],["ولا غَرْوَ أن تحظى عَليَّ عصابة","لَوَتْ حمدها والحمدُ عندِيَ والحقدُ",10,"د",1,0],["ولا غَروَ أنت البحر تُفضي عُفاتُه","إلى الضحل من جَدواه ثم إلى الغمر",11,"ر",1,0],["ولا غرو إلا أننّي رُعت عنهُمُ","عُرام القوافي وهي نار تسعّر",12,"ر",1,0],["ولا غروَ أن ذلّتْ له بعد عزّةٍ","أنوفٌ عِدىً أضحتْ تُخَشُّ وتُخزَمُ",13,"م",1,0],["ولا غَرِقٌ ناجٍ من الكرب عَيْشُهُ","بحيث يكون الموت في الأخضر القطمْ",14,"م",1,0],["وَلا غَرَوَ إِن عَزَّت وَهانَ خُصومُها","فَلِلحَقِّ مَهما جَعجَعَ الباطِلُ النَصرُ",15,"ر",1,0],["وَلا غَرَوَ إِن أَهدى لَها الشِعرُ وَحيَهُ","فَيا طالَما سارَت وَسارَ بِها الشِعرُ",15,"ر",1,0],["وَلا غَرَوَ إِن صُغنا لَها النَثرَ حِلَيَةً","فَفي عُنُقُ الحَسناءِ يُستَحسَنُ الدُرُّ",15,"ر",1,0],["وَلا غَبيتُ ضَعفَها","وَلا نَسيتُ قُدرَتي",16,"ي",1,0],["وَلا غَلَبَتني شِقوَةٌ أَو سَعادَةٌ","عَلى حِكمَةٍ آتَيتَني وَأَناةِ",17,"ه",1,0],["ولا غرو إلّا بذله من كلامه","لأعناقنا الدُّرَّ الثمينَ المكرَّما",18,"م",2,0],["ولا غروَ أن أخنتْ عليك فإنَّما","يُصادَمُ بالخطبِ الجليل جليلُ",19,"ل",1,0],["ولا غَروَ أن يرتاحَ للصيدِ قانِصٌ","إِذا عَنَّ ظبيٌ بالصَّريمةِ جانِحُ",20,"ح",1,0],["وَلا غَروَ إِلّا أَن تَكيدَ سَراتَها","وَتَغمِسَ نَصلَ السَيفِ فيمَن يَكيدُها",21,"د",3,0],["وَلا غُمُرٌ قَد رَقَّصَ الخَفضُ قَلبَهُ","وَلا طارِفٌ في نِعمَةِ اللَهِ جاهِلُ",22,"ل",1,0],["وَلا غَروَ أَن وَطَّأتَ أَكنافَ مَرتَعي","لِمُهمِلِ أَخفاضي وَرَفَّهتَ مَشرَبي",23,"ي",1,0],["وَلا غامَ ما غامَ حَتّى اِنجَلى","فَأَضحى وَلا اِنقادَ حَتّى أَبى",24,"ب",2,0],["وَلا غَيمَ إِلّا قَسطَلٌ ثارَ أَقتَمٌ","وَلا بَرقَ إِلّا أَشقَرٌ جالَ تَجرَدُ",25,"د",1,0],["وَلا غَروَ أَن تَروى بِها عَينُ ناظِرٍ","وَباطِنُها ماءٌ وَظاهِرُها خَمرُ",26,"ر",1,0],["وَلا غَيرَ أَطرافِ الأَسِنَّةِ مِقوَلٌ","يُبينُ وَلا غَيرَ الفَرائِصِ مِسمَعُ",27,"ع",1,0],["وَلا غَروَ إِلّا جارَتي وَسُؤالُها","أَلا هَل لَنا أَهلٌ سُئِلتِ كَذَلِكِ",28,"ك",1,0],["ولا غَرو مِن تَرْكِ القَلانِسِ جانِباً","إِذا عَرفَتْ حَقِّي هُناكَ العمائِمُ",29,"م",1,0],["وَلاَ غَرَّكُمْ مِنِّي ابتِسَامٌ بِلِمَّتِي","فَرُبَّ ابتِسَامٍ لاَحَ وَهْوَ شُبُوبُ",30,"ب",1,0],["وَلا غُصنَ إِلاّ وَهوَ نَشوانُ راقِصٌ","وَلا طَيرَ إِلاّ وَهوَ فَرحانُ يَصدَحُ",31,"ح",1,0],["ولا غدّيت أطفالي","سوى همّي وأوصابي",32,"ي",1,0],["ولا غرو ان اكرمتم الضيف شيمة ً","توارثتُموها عن جُدود لكم غر",33,"ر",1,0],["ولا غاب إلا في الطبيعة أمه","وقدماً أعارته الضلوع الحوانيا",34,"ي",2,0],["وَلا غير ما فَوقَ الرَّوادِفِ بانَةٌ","وَلاَ غيرُ ما فَوقَ الجيوب صباحُ",35,"ح",1,0],["ولا غدا بضفاف البحر منزهنا","ولا رأت قهوة السمّار سارينا",36,"ن",2,0],["ولا غَرْو إِن أسلبت في الربْع أدْمعي","فلى في حمى لبلَى ليالٍ سوالفُ",37,"ف",1,0],["ولا غَرْوَ إن أمسيتُ حِلْف الأسى وقد","تناءى إِذاً عَنّي الحبيبُ المودِّعُ",38,"ع",1,0],["ولا غرو في أن فاض برك للورى","فإنكَ للخيراتِ لا شك منبع",39,"ع",1,0],["ولا غداةٌ أطارت نعيَه فغدا","كل امرىء بدم الأجفانِ مختضبا",40,"ب",2,0],["وَلا غاضَ مِن بَحرِ الأَجَلَّينِ زاخِرٌ","عَلا طامِياً آذِيُّهُ وَنَأى القَعرُ",41,"ر",1,0],["وَلا غَروَ أَن تُعطي أَمانِيَّ طالِبٍ","يَراكَ بِتَصديقِ المُنى مُتَكَفِّلا",42,"ل",2,0],["ولا غبن في الدنيا ولا من رزيئةٍ","سوى رجل عن نيلها حظّه نزر",43,"ر",1,0],["ولا غرو في هذا وقد قال ربّنا","تراهم عيون ينظرون ولا بصر",43,"ر",1,0],["ولا غرو أن حزتَ السِّباق ديانةً","فللدِّين والدنيا مدىً ورجال",44,"ل",1,0],["وَلا غَروَ أَن نَرتاحَ شَوقاً لِمَدحِهِ","فَهَذي حَمامُ الأَيكِ تَرتاحُ لِلشَدوِ",45,"و",1,0],["ولا غرو أن احياه والعرقُ واحدِ","ألست ترى كلا يقال له المقري",46,"ر",2,0],["ولا غرو أن يسمو على الأًصل فرعه","فللغيب وهو الفرع فضل على السحب",47,"ب",1,0],["ولا غرو أن يليه شأنك عنهم","فقد شغل الشيء الكثير عن النزر",48,"ر",1,0],["ولا غَرْ وَقد تُقِصى المقَاديرُ من دَنا","وتُدْنى مع اليأسِ الفتى وهْو شاسع",49,"ع",1,0],["ولا غابراً إلا على إثْرِ سالفٍ","أَوائِلُهُمْ للآخرينَ رُهون",50,"ن",1,0],["ولا غروَ إن زادَ أعداؤها","فقدْرُ النفوسِ بأعدائها",51,"ا",3,0],["ولا غيٌّ سوى غيِّ التَّصابي","ولا عبثٌ سوى عبثِ النديمِ",52,"م",1,0],["ولا غاب عن سمعي رنين حديثها","إذا اقتربت منى تريد التناجيا",53,"ي",2,0],["ولا غروَ أن الموتَ حَقّ ولازمٌ","على كلِّ ذي روحٍ إذا أكمَلَ العُمرُ",54,"ر",1,0],["ولا غدى مصطفاك رقاً","ولا كسا جسمه السقام",55,"م",1,0],["وَلا غَروَ إِن أَشرَق بِبَهجَةِ أَدمُعي","غَراماً بِوَجهٍ يُبهَرُ الشَمسَ إِشراقا",56,"ق",2,0],["وَلا غَروَ أَن تَبكي الدِماءُ لِكاسِبٍ","لَها كانَ يَسعى في البِلادِ وَيَكدَحُ",57,"ح",1,0],["وَلا غَروَ بِالوَرقاءِ في رَونَقِ الضُحى","يَرِفُّ لَها عَودُ الأَراكِ فَتَصدَحُ",57,"ح",1,0],["وَلاَ غُصْنَ إِلاَّ تَثَنَّى ارْتِيَاحاً","وَلاَ طَيْرَ إِلاَّ تََغَنَّى سُرُورَا",58,"ر",2,0],["ولا غرثى الوشاح كأن ورد ال","حياء بوجنتيها الجلنار",59,"ر",1,0],["وَلا غَروَ إِلّا حينَ جاءَت مُحارِبٌ","إِلَينا بِأَلفٍ حارِدٍ قَد تَكَتَّبا",60,"ب",2,0],["وَلا غَروَ إِلّا الخُضرُ خُضرُ مُحارِبٍ","يُمَشّونَ حَولي حاسِراً وَمُلَأَّما",61,"م",2,0],["ولا غرو ان اهدت يداه طرائفاً","وباطنها للمكرمات ظروف",62,"ف",1,0],["وَلا غَرْو أنْ أَصْبَحْتُ مُغْرَى فَإنَّهُ","بِأُخْتِ بَلِيٍّ فِي الهَوَى عَمَّت البَلْوَى",63,"و",2,0],["وَلا غَرْوَ أنْ تُغْرَى السُّعُودُ بأهْلِها","فَمَا قابَلوا النُّعْمَى بِغَمْطٍ ولا غَمْصِ",64,"ص",1,0],["ولا غَرْوَ أنْ قِيسَتْ عَلَى تِلْكَ هَذِهِ","فَكَمْ مِنْ قِيَاسٍ في عِدَاكَ غَدا نَصَّا",65,"ص",2,0],["وَلأَغلِبَنّ عَلى السلوّ صَبابتي","والشّوْقُ في كُل المواطن أغْلبُ",66,"ب",1,0],["وَلا غَرْوَ أَنْ أَصْبَحْتَ غُفْلاً مِنَ الْهَوى","فَأَنْكَرْتَ ما بِي لِلصَّبابَةِ مِنْ رَسْمِ",67,"م",1,0],["وَلا غَرو أَن نالَتكَ أَطرافُ وَعكَةٍ","كَما يوعَكُ الرِئبالُ إِذ كُنتَ شكلَهُ",68,"ل",2,0],["وَلا غَروَ أَن جادَت جُفوني بِمائِها","إِذا كانَ مَن أَهواهُ بِالوَصلِ يَبخَلُ",69,"ل",1,0],["وَلا غَروَ أَن عادَ الفِرَنجُ هَزيمَةً","وَلَو لَم تَعُد لَم يَبقَ لِلشِركِ ساحِلُ",70,"ل",1,0],["ولا غَريبَ إِذا أَصبَحتُ ذا حَزَنٍ","إنَّ الغَريبَ حزينٌ حيثما كانا",71,"ن",2,0],["ولا غروَ أَن أَربت على القول أَنَّها","كَلامُ ملوكٍ أَو مُلوكُ كلامِ",72,"م",1,0],["ولا غلوَّ إذا ما قُلتُ عزمتُه","تَكاد تَثني عهودَ الأَعصر القُدُمِ",73,"م",1,0],["وَلا غروَ إِن أَصبَحَت تُشتَهى","فَقَد حُفَّت النارُ بالشَهواتِ",74,"ت",1,0],["وَلا غضاضة في تركِ البلادِ وَقَدْ","(خُيِّرتَ أمرين ضاعَ الحزمُ بينهما)",75,"م",2,0],["ولا غرو أن صدقت حلو حديثها","وسكره يرويه لي عن أبي الذر",76,"ر",1,0],["وَلا غَرابَةَ إِن قَد باتَ مِن حَسَدِ","مِن هالِهِم أَمرَها في مُنتَهى النَكَدِ",77,"د",1,0],["وَلا غَلوَ لَو اِستَدعى النُجومَ هَوَت","وَكَيفَ لا وَعَلَيَّ العَرشَ وَطَأتُهُ",78,"ت",2,0],["وَلا غَرَسَ الأُمورَ وَلا اِجتَناها","كَيَحيى حينَ يَعزِمُ أِو يَسيرُ",79,"ر",1,0],["وَلا غَروَ أَن يَمضي بِإِنتاجِ مِث","لِهِ الزَمانُ عَقيماً وَهوَ لِلدَهرِ مُنتَجُ",80,"ج",1,0],["وَلأغفرنّ ذُنوبَ دَهري كلها","وَأَقول لَيسَ من الزَمانِ شقاق",81,"ق",1,0],["ولا غَرْوَ إلاّ مَن يَظَلُّ على الَّذي","يُضيّعُ من أَيّامِه غيرَ لَهْفان",82,"ن",1,0],["ولا غَرو أن يَسخو بظِلٍّ نَحُلُّه","فتىّ جُودُه فَوقَ الورى سابِغُ الظِّلّ",83,"ل",1,0],["ولا غَرْوَ أن تُمسي الرّياحُ عليلةً","إذا ما جعَلْناهُنَّ ما بَيْننا رُسْلا",84,"ل",2,0],["ولا غَرض إلا يُصيبُ لأنّه","إذا سُلَ سيفٌ من يدِ اللهِ صائب",85,"ب",1,0],["وَلا غَروَ لَو ضَلَّ مَن قَد هَدَيتَ","ضَلالُ الدَليلِ دَليلُ الضَلالِ",86,"ل",1,0],["ولا غرو أن آتي هنيدة سالماً","فقد يدركُ الإنسان ما يتوقع",87,"ع",1,0],["ولا غدت أرضُ مصر من مقاصده","إِلا ليجعل في مغناك منزله",88,"ل",2,0],["ولا غرو أن البكر يفضُلُ إرثُه","على الدون كالصنديد حين يصول",89,"ل",1,0],["ولا غيره من كل قول لأنه","عدد ذر كل الرمل في الكثر والعظم",90,"م",1,0],["ولا غرو يا مولاي إن قُرئتْ بأن","تداولَ سمعَ المرء أنملُه العشرُ",91,"ر",1,0],["ولأغصانها إذا هبت الريح","اعتناق الأحباب والتقبيل",92,"ل",1,0],["ولا غرو إن آثرت أهلاً ووالداً","علينا وآثرت الملوك ذوي الأمر",93,"ر",1,0],["ولا غرو من حاز الكمال فإنما","يكون أميراً أو أسيراً لأصْيَدِ",94,"د",1,0],["ولا غرو للأبناء إرث أبيهمُ","فيا حبذا ما نلت من ذلك القرب",95,"ب",1,0],["ولاغفرن له الذُّنو","ب السالفات إلى جنابي",96,"ي",1,0],["ولا غَرْوَ أنْ يُمنى أديبٌ بجاهِلٍ","فمِن ذَنَبِ التِّنِّينِ تَنكسِفُ الشَّمْسُ",97,"س",1,1],["ولا غروَ في ذاك المكان المطهر","أمطنا القذى عن جفن سيف مذكر",98,"ر",1,0],["ولا غرو من كانَ الفتوح بوجهه","إذا استفتح الإسلام فيه المغالقا",99,"ق",2,0],["ولا غروَ أنْ زرقُ العيون قتلنني","فإنَّ الرماح الخُطَّ زرقٌ سنانها",100,"ه",2,1],["ولا غدوتُ بآمالي إلى أحد","له من المال شبع وهو غرثان",101,"ن",1,0],["ولا غرو أن تقفوا أباك متابعا","لتلك الأيادي البيض والشيم الغر",102,"ر",1,0],["ولا غابَ من وافاكَ من أرْضِ رُومَةٍ","بغابٍ من الخَطِّيِّ تَزْأَرُ أُسْدُهُ",103,"د",2,0],["ولا غَنَّتْ ليَ الآمالُ إِلّا","وحظُّ رضاكَ سُؤْلِي واقتراحي",104,"ي",1,0],["ولا غصةً تحكي إلى الذنب غصةٌ","ولا كلفي في الموبقات لهيف",105,"ف",1,0],["ولا غزوا في سبيل الله أندلس","ولا فدوا حين عز المال والطلب",106,"ب",1,0],["ولا غرو إذ صلى الرئيسُ لحفظه","وأزجى دُعاءً قد أضاءَ منارا",107,"ر",2,0],["ولا غشيت ظلماءُ إلا وفجرُها","برغم العدا عما تُحبّون يُسفرُ",108,"ر",1,0],["وَلا غَفَرَ الإِلَهُ لِمُنكِحيها","ذُنوبَهُمُ وَإِن صَلّوا وَصاموا",109,"م",3,0],["ولا غَرَرٌ إلا شمِمْتُ له يداً","ولا خطر إلا قدحت له زندا",110,"د",2,0],["ولا غزونا أياديه بمسألة","إلا سلبناه ما يقنى القنا السلب",111,"ب",1,0],["ولا غرو إن ماتت حقود بصدره","فإن صدور القادرين لحود",112,"د",1,0],["ولا غدا مثلي ومثلي معوز","يعرف مابين الورى بشاعر",113,"ر",1,0],["ولاغرو أن ماتت حقودكم بحلمكم","فإن صدور القادرين قبورها",114,"ر",3,0],["وَلا غَدَتْ لِعَشاءِ النّاظِرينَ لَهَا","كَأَنّها طَلَعَتْ في مُظْلِمِ الحُجُبِ",115,"ب",1,0],["ولا غَرْوَ أنْ أبكي لمنْ خفّ بالرّدى","إذا كنتُ أبكي يومَ خفَّ قطيني",116,"ي",1,0],["وَلا غفرَ الإلهُ لكمْ ذنوباً","ولا جُزتمْ هنالِكمُ الصِّراطا",117,"ط",2,0],["ولا غمضَ ولا أرضَ","لِعَينَيَّ وللجنبِ",118,"ب",1,0],["ولا غَرْوَ إِنْ تَاهَتْ بِمُلكِكَ وازْدَهَتَ","ولا عجباً إِنْ أسْرفَتْ بكَ في العُجْب",119,"ب",1,0],["وَلا غائِبٌ إِلّا أَتى وَهْوَ تَائِبٌ","وَلا قَادِمٌ إلّا أَتَى وَهْوَ نَادِمُ",120,"م",1,0]]}