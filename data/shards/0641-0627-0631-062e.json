{"poems":[[50,"ديار نوار ما ديار نوار","https://www.aldiwan.net/poem63367.html","الطويل"],[96,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[173,"سما لك من أم العبيد خيال","https://www.aldiwan.net/poem1660.html",""],[251,"نأتك بليلى دارها لا تزورها","https://www.aldiwan.net/poem56333.html","الطويل"],[354,"لم ينل سائق الركائب رشدا","https://www.aldiwan.net/poem15627.html","الخفيف"],[371,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[406,"وقفة أمام خيام المبعدين","https://www.aldiwan.net/poem6725.html","عموديه"],[422,"لله در أبي داود من رجل","https://www.aldiwan.net/poem54143.html","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38150","المتقارب"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56383","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55911","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80046","السريع"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108959","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108988","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108956","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108693","البسيط"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89627","الوافر"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104964","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202572","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89117","الرجز"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125954","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91229","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94531","الطويل"],[4308,"","https://poetry.dctabudhabi.ae/diwan/poem/34763","المنسرح"],[4656,"","https://poetry.dctabudhabi.ae/diwan/poem/98051","الوافر"],[4767,"يوم العسكري","https://www.poetsgate.com/ViewPoem.aspx?id=197293",""],[4927,"حِجابُ عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=30186",""],[5079,"إني أحبك ياوسن","https://www.poetsgate.com/ViewPoem.aspx?id=178379",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5183,"سَعد وسُعَيد","https://www.poetsgate.com/ViewPoem.aspx?id=180217",""],[5725,"عشقت بعينيك","https://www.poetsgate.com/ViewPoem.aspx?id=181097",""],[5751,"كل ما فيها يُغنّي","https://www.poetsgate.com/ViewPoem.aspx?id=215018",""],[5842,"ومازال التراب \\محمد حسام الدين دويد","https://www.poetsgate.com/ViewPoem.aspx?id=150625",""],[5984,"يا طلل الحىّ جادك الطّلل","https://www.poetsgate.com/ViewPoem.aspx?id=200383",""],[5997,"الْأثَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=214281",""],[6147,"مشروع حلال","https://www.poetsgate.com/ViewPoem.aspx?id=151492",""],[6150,"على مرفأ البوح","https://www.poetsgate.com/ViewPoem.aspx?id=25229",""],[231,"ناحتُ الصخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79149&r=&rc=23",""],[572,"عَذِيري من بياضِ الشي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9289&r=&rc=146",""]],"verses":[["فَأَرخِ عَلَيها سِترَ مَعروفِكَ الَّذي","سَتَرتَ بِهِ قِدماً عَلَيَّ عُواري",0,"ر",2,0],["فأرخيت آلاف الستور كأنّني","أمدّ على حال من النّور غيهبا",1,"ب",2,0],["فَأَرخُوا لَها فَضلَ الأَزمَّةِ ساعَةً","وَإِن كانَ أَينٌ مَسَّها وَكَلالُ",2,"ل",1,0],["فأرختْ لنضّاخ القَفا ذي مِنصةٍ","وذي سيرةٍ قد كان قِدماً يسيرُها",3,"ر",3,0],["فَاِرخِ عُقلَ الَطِبِّ وَاِستَنجِدِ الرِك","بَ عَلى سوقِها إِذا جِئتَ نَجدا",4,"د",2,0],["فَأَرخِصِ النَفسَ في ذِكرٍ يُخَلِّدُها","فَما أَرىالذِكرَ إِن غاَلَ النُفوسَ غَلا",5,"ل",2,0],["فأرخى طرفه وبكى وأبكى","ودمع الحر في الشكوى مباح",6,"ح",1,0],["فأرَّخوه وقالوا يومَ مولده","يَقُرُّ عَينَ سليمان الزهير علي",7,"ل",2,0],["فَأَرْخَتْ على خدِّها سالفاً","فَحالاً أَرَتْنا اِنشِقاقَ القَمرْ",8,"ر",1,0],["فأرّخ نيله أجرى","أنابيباً من الكوثر",9,"ر",1,0],["فارّخ جاء بنوا كرام قوم","سقاهم ربهم كاسا طهورا",10,"ر",2,0],["فأرّخنَّه فرحاً معجباً","في أشطرٍ أحمدت رؤياها",11,"ا",3,0],["فأرخوا يثلث البدرين بدركما","حبيب راجي بباهي وجهه باهوا",12,"ا",1,0],["فأرخ الفوز في الفردوس يا ولدي","داواك خير حكيم يبهر الحكما",13,"م",2,0],["فأرِّخها تسود الشمس حسناً","وعبد اللَه صوراتي أبوها",14,"و",3,0],["فأرخوه عباباً لا نظير له","شهمٌ سخٍ سيد حساده كثروا",15,"ر",3,0],["فأرخصنا الجماجم يوم ذاكم","وما كنا لهن بمثمنينا",16,"ن",2,0],["فأرخصها فدىً لأخيه لما","تسجى في حظيرته وناما",17,"م",2,0],["فأَرخَيتُ القَناةَ وَيزءنياً","عَلى الأَكفالِ بالطَعنِ المُعاقِ",18,"ق",1,0],["فأرخص الدمع من عينين قد غلتا","على لهيب جوى في القلب يتَّقدُ",19,"د",1,0],["فأرخصُ شيءٍ في الوجود كثيرُه","وأثمنهُ ما قلَّ ناساً وأَعلاقا",20,"ق",2,0],["فأرخت نصفاً من الإنصافِ","حل المحلة الثناء الوافي",21,"ي",1,0],["فأرخص دمعاً كان بالأمس غالياً","وقام به صوت الإباء يعاتبه",22,"ب",2,0],["فَأَرّخه بتاريخٍ بديعٍ","ليوسفَ أَحمدٌ خَلَفٌ مبارك",23,"ك",1,0],["فأرَّختُ صحبٌ زار بالأمن صالحٌ","وعاد لنا بالنصر والعود أحمدُ",24,"د",1,0],["فَأُرخِيَت دونَنا وَقَد هَدَأَ الل","لَيلُ سُتورُ الحِجابِ وَالكِلَلُ",25,"ل",1,0],["فَأَرخيتُ العمامةَ دون صَحبي","عَلى عيني وَقلتُ جَرى قذاها",26,"ا",3,0],["فأرِّخْ عامَ مولِدهِ (كبيرٌ)","وأهلُ الحق للذكرى شهودُ",27,"د",1,0],["فَأُرْخِصُ نَفْساً كَيْ أَفُوْزَ بِحُبِّهَاْ","وَأَحْظَىْ بِأَسْرَاْرِ الْجَمَاْلِ الْمُركَّبِ",28,"ب",1,0],["فارخي إليّ بمسمع","إني أحبك ياوسن",29,"ن",1,0],["فأرخصت ما غلا من دُرِّها فغدا","يجري عقيقاً بمنثور ومنتظمِ",30,"م",1,0],["فأرخى علينا المال نرخي عنانه","فيطغى ونطغى فوقه ما تمردا",31,"د",2,0],["فارخى هموما على خافقي","بافواه جرحٍ تلوك الضمادا",32,"د",2,0],["فأرخيت العنانَ ليتبعوها","وصلوا في مفاتنها وغابوا",33,"ب",3,0],["فأرخيت القلوع ورحت أشدو","بشعر صاغ في نفسي حضوره",34,"ر",2,0],["فأرخيت دوننا وقد هدأ ال","ليل ستور الحجاب والكلل",35,"ل",1,0],["فَأَرْخَى سدولاً وَقَلْبَي سَؤُولَا","فَعَادَ خَجُولَا ضَرِيرَ الْبصرْ",36,"ر",1,0],["فأرخى البدر في الديجور نورا","تُوَشّحُه المجرة والهلال",37,"ل",1,0],["فأُرْخى الجفونَ رويدًا .. قليلاً","خفيفًا إلى ظلِّها أنسرِبْ",38,"ب",1,0],["فأرخى ذراعيه ، وأسند جسمهُ","إلى معول ، نضّاه للكدح معولُ",39,"ل",1,0],["فأرخَاها وأمضَى حُكمَ","هُ في سائرِ الشّعْرَهْ",40,"ر",2,0]]}