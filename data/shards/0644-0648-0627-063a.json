{"poems":[[65,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[34,"أرى كل معشوقين غيري وغيرها","https://www.aldiwan.net/poem27811.html","الطويل"],[482,"على البان قمرية تسجع","https://www.aldiwan.net/poem15215.html","المتقارب"],[482,"ألا حي آثار الرسوم الدوائر","https://www.aldiwan.net/poem15243.html","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66962","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48733","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37957","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37925","المجتث"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96352","البسيط"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5183,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=186425",""],[5653,"أربرب بالكثيب الفرد أم نشأ؟","https://www.poetsgate.com/ViewPoem.aspx?id=3011",""],[5956,"ساعِدِي الموجَ يا رفاهي","https://www.poetsgate.com/ViewPoem.aspx?id=182092",""]],"verses":[["لَواغِبُ يُحْذَيْنَ السَّريحَ مِنَ الحَفا","وأوساطُها يَشكُو بِها القلَقَ الضُّفْرُ",0,"ر",1,0],["لَواغِبُ لا يَصدُرنَ عَنهُ لِوِجهَةٍ","وَلا هُنَّ مِن بَردِ الحِياضِ دَواني",1,"ن",2,0],["لواغبَ تهوي إلى حيّها","وقد فاتَها الرَّعْيُ والمَكْرَعُ",2,"ع",1,0],["لواغبُ أنضاها الذميلُ بواركاً","مِنَ الأينِ يَفْحَصْنَ الحصى بالكَراكِرِ",3,"ر",1,0],["لو أَغْلَظَ المَلْكُ أَمْراً فيهِمُ ائتَمروا","لو اقتضى الجيشُ رَدّاً منهُمُ رَدَأَوْا",4,"ا",1,0],["لو أغنت الحق الشرائع والنهى","ما أعوزته كتائب وحصون",5,"ن",1,0],["لَو أَغلَقوا أَبوابَهم","عليكَ بالبوّابِ",6,"ب",1,0],["لَو أَغلَقوا عَنكَ باباً","فاللَّهُ يَفتَحُ أَلفا",7,"ف",2,0],["لواغبَ الطَّرفِ منقوباً حواجِبُها","كأنها قُلُبٌ عاديّةٌ مُكُلُ",8,"ل",1,0],["لو أغلَقوا بابَ المجادلَة","والتَّمحيل والجفاء والقولِ البَذا",9,"ا",1,0],["لَوْ أُغَنِّي مِلْءَ رُوحِي","كُنْتُ أَرْعَشْتُ الْمَقَرَّا",10,"ر",2,0],["لو أغرق العلم مني كل جارحة","وثبط الحلم مجهوداً وآمالا",11,"ل",2,0],["لو أَغْلَظَ المَلْكُ أمْراً فيهِمُ کئتَمروا","لو کقتضى الجيشُ رَدّاً منهُمُ رَدَأوْا",12,"ا",1,0],["لو أغنّي يا (رفاهي) ألفَ لحنٍ","ليس يكفيني لتعبير شعوري",13,"ر",2,1]]}