ورى تاهت بسلطانك الأعلى","https://www.aldiwan.net/poem42204.html","الطويل"],[126,"شربت شمولا من شتيت مشوبة","https://www.aldiwan.net/poem50539.html","الطويل"],[126,"ألا إنني في نعمة ومسرة","https://www.aldiwan.net/poem50629.html","الطويل"],[131,"فتح يطاول فتحه الأحقابا","https://www.aldiwan.net/poem4248.html","الكامل"],[133,"لم ينلها سواك من أهل مصر","https://www.aldiwan.net/poem49077.html","الخفيف"],[140,"مرض بقلبك ما يعاد","https://www.aldiwan.net/poem58409.html","مجزوء الكامل"],[148,"يا نسيم الريح يهفو سحرا","https://www.aldiwan.net/poem68474.html","الرمل"],[148,"طويت الحشا مني على حر لوعة","https://www.aldiwan.net/poem68561.html","الطويل"],[148,"بطيبة للعافين أكرم سيد","https://www.aldiwan.net/poem68590.html","الطويل"],[158,"قلب على جمر الغضا يتقلب","https://www.aldiwan.net/poem58807.html","الكامل"],[158,"قد أوعدتني بالزيارة في الكرى","https://www.aldiwan.net/poem58874.html","الكامل"],[164,"وسقت الركائب حتى أنخن","https://www.aldiwan.net/poem46823.html","المتقارب"],[164,"طاب العميد الكندري شمائلا","https://www.aldiwan.net/poem46881.html","الكامل"],[167,"طما بحر الهموم به فمادا","https://www.aldiwan.net/poem1620.html",""],[184,"أفق أيها القلب الولوع المكلف","https://www.aldiwan.net/poem43621.html","الطويل"],[193,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[209,"طمعت بقرب دجلة قبل هذا","https://www.aldiwan.net/poem46761.html","الوافر"],[227,"طمع الورد أن ينافس خدي","https://www.aldiwan.net/poem51145.html","الخفيف"],[233,"يا علاء الدين المرجى أعني","https://www.aldiwan.net/poem31634.html","الخفيف"],[248,"طربت اشتياقا للنبي محمد","https://www.aldiwan.net/poem15069.html","الطويل"],[254,"أسفي عليه ممددا فوق الخصي","https://www.aldiwan.net/poem48318.html","الكامل"],[259,"شكت شجي وبكت يوم النوى شجنا","https://www.aldiwan.net/poem38169.html","البسيط"],[268,"أيا أهل النميمة والرواغ","https://www.aldiwan.net/poem35014.html","الوافر"],[268,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[351,"لا تعتب الوغد اللئيم إذا أسا","https://www.aldiwan.net/poem40167.html","الكامل"],[364,"يا رعد ما هذي القعاقع","https://www.aldiwan.net/poem17228.html","مجزوء الكامل"],[369,"لا مقصر عن هوى ولا سال","https://www.aldiwan.net/poem57226.html","المنسرح"],[369,"طمع الوشاة بسلوتي وتباشروا","https://www.aldiwan.net/poem57480.html","الكامل"],[397,"أنا وريشتي","https://www.aldiwan.net/poem6732.html","عموديه"],[413,"أمر بها مع الأرواح رند","https://www.aldiwan.net/poem54046.html","الرمل"],[413,"بدا والصبح غار على الظلام","https://www.aldiwan.net/poem54132.html","الوافر"],[426,"للمرء في حادثات الدهر آمال","https://www.aldiwan.net/poem40075.html","البسيط"],[456,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[459,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[459,"حباه إله العرش جودا ونجدة","https://www.aldiwan.net/poem16115.html","الطويل"],[475,"عفى الزمان مرابعاوملاعبا","https://www.aldiwan.net/poem15213.html","الكامل"],[475,"عهد الصبا ومعاهد الأحباب","https://www.aldiwan.net/poem15221.html","الكامل"],[475,"بعد المزار فأنة وتذكر","https://www.aldiwan.net/poem15285.html","الكامل"],[475,"حييت من دمن ومن أطلال","https://www.aldiwan.net/poem15352.html","الكامل"],[498,"للقلب في سبك الحروف معان","https://www.aldiwan.net/poem37757.html","الكامل"],[498,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[513,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[513,"خطبتني الخطوب بالهم لما","https://www.aldiwan.net/poem12295.html","الخفيف"],[527,"طمعتم يا ويحكم معشرا","https://www.aldiwan.net/poem37336.html","السريع"],[538,"أرسم سودة محل دارس الطلل","https://www.aldiwan.net/poem56707.html","البسيط"],[549,"حتام ذمي عندكم أزماني","https://www.aldiwan.net/poem47167.html","الكامل"],[556,"طوبى لمن كشفت بصيرته الغطا","https://www.aldiwan.net/poem33544.html","الكامل"],[556,"لي رتبة العلامة الشهم الأَسد","https://www.aldiwan.net/poem34635.html","الكامل"],[560,"خذوا حذركم من طرفه فهو قتال","https://www.aldiwan.net/poem52839.html","الطويل"],[565,"عادات طيفك أن يعاود","https://www.aldiwan.net/poem69711.html","مجزوء الكامل"],[573,"من ذا الذي من مقلتيه يقيني","https://www.aldiwan.net/poem2839.html","الكامل"]],"verses":[["طَمِعَ المُعادي أَن يُقَرِّبَهُ وَمَن","صافى عَدُوّاً لي فَقَد عاداني",0,"ي",1,0],["طَموحٍ إِذا غَضَّ الشُجاعُ لِحاظَهُ","وَأَطرَقَ عَن بَرقِ الظُبى كُلُّ شائِمِ",1,"م",1,0],["طَمِعتَ أَن تَرتَقي بِلا قَدَمٍ","إِلى العُلى راعَ أُمَّكَ الثَكَلُ",2,"ل",1,0],["طَماعِيَتي أَن أَملِكَ المَجدَ كُلَّهُ","وَكُلُّ غُلامٍ في العَلاءِ طَموعُ",3,"ع",1,0],["طَمَعٌ وَرَّطَني في حَبلِهِم","وَيُصادُ الطَيرُ مِن حَيثُ لُقِط",4,"ط",1,0],["طَمَسَت مَنابِرَها عُلوجُ أُمَيَّةٍ","تَنزو ذِئابُهُمُ عَلى أَعوادِها",5,"د",3,0],["طَمِعتَ يا دَهرُ أَن تُرَوِّعَهُ","ظَنّا عَلى الرُغمِ مِنكَ مَكذوبا",6,"ب",2,0],["طَمِعتَ بِلَيلى أَن تَريعَ وَإِنَّما","تُقَطِّعُ أَعناقَ الرِجالِ المَطامِعُ",7,"ع",1,0],["طمَعَتْ نَفْسي بزَوْرٍ غرَّها","فهْيَ تجْني بعْدَهُ عُقْبَى الطّمَعْ",8,"ع",1,0],["طَمِعَ الشّيْبُ باللِّجامِ المُحلّى","حينَ أجْرَيْتُ أن يَرُدّ جِماحي",9,"ح",2,0],["طَمَعٌ أَلقى عَنِ الغَربِ اللِثاما","فَاِستَفِق يا شَرقُ وَاِحذَر أَن تَناما",10,"م",2,1],["طَمَّتْ فَعَمَّتْ بِالبَوَارِ وَلَمْ تَذَرْ","حَفْلَ الفَقِيرِ وَلا حِمَى المِسْكِينِ",11,"ن",1,0],["طماعة منك غير واعية","وهي لعمري حماقة وبله",12,"ل",2,0],["طمِعوا بوفر المال منه فأخجلوا","بفضول هاتيك المطامع أشعبا",13,"ب",2,0],["طمعتُ بالعدلِ والإحسانِ منكَ معاً","فكنتَ عنديَ بالإحسانِ غيرَ سخي",14,"ي",1,1],["طمعنا بحدس في رجوع مفارق","وفي غير من قد وارت الأرض يرجع",15,"ع",1,0],["طَمَعُ القَريبِ أَوِ البَعيدِ بِنَيلِها","طَمَعُ الفَتى مِن دَهرِهِ بِمَحالِهِ",16,"ل",2,0],["طَموحٌ إِلى العلياء يقدمُ همُّهُ","على المجدِ حتى لا يَرى متقدِّما",17,"م",2,0],["طَمَحَت عُيونُ الكاشِحينَ فَغَضَّها","شَرَفٌ بَناهُ اللَهُ حَيثُ بَناهُ",18,"ا",2,0],["طَمِعتُ بِعَفوٍ مِنكَ عَمّا اِقتَرَفتُهُ","فَلَيسَ لَهُ في طَيِّ حِلمِكُمُ قَدرُ",19,"ر",1,1],["طَمَحَت إِلى عَلياكَ أَحداقُ الوَرى","وَاِرتَدَّ طَرفُ الدَهرِ عَنكَ كَليلا",20,"ل",2,0],["طَمَعي في لِقاكَ بَعدَ إِياسِ","هُوَ أَغرى قَلبي بِقَصدِ أَياسِ",21,"س",1,1],["طما بحرها فركبتُ الكؤوس","إلى ساحل البحرِ منها سفين",22,"ن",1,0],["طمعتُ بهذا كلّه في لقائكمْ","لِتَغْرَمَ نَفْسٌ أُتْلِفَتْ بغرامِ",23,"م",1,0],["طَمَى بِالمَنايا الحُمرِ لَجُّ سرابِهِ","فكم غائصٍ لهفان من دونِ ساحِلِه",24,"ل",2,0],["طُمعَتْ مصافحتي له إذ زُرتُهُ","فَقَبضتُ مِن ظلِّ الخيالِ النافِرِ",25,"ر",1,0],["طَموحٌ بِأَثناءِ الزِمامِ كَأَنَّما","تَخالُ بِها مِن عَدوِها طَيفُ جِنَّةِ",26,"ه",1,0],["طَمَاعَةُ نَفْسٍ تُورِدُ الْمَرْءَ مَشْرَعاً","مِنَ الْبُؤْسِ لا يَعْدُوهُ أَوْ يَتَحَطَّمَا",27,"م",2,0],["طَمِعتُ بِأَمرٍ لَيسَ لي فيهِ مَطمَعُ","فَأَخلَفَني فَالعَينُ مِن ذاكَ تَدمَعُ",28,"ع",1,1],["طَمى الجودُ في يُمناهُ بَحراً وَرُبَّما","تَدَفَّقَ في أَرجائِها فَتَدَفَّعا",29,"ع",2,0],["طَمعَ المغيرُ فكرَّ إثر فريسةٍ","أخرى يضنُّ بمثلها ويُغالي",30,"ل",2,0],["طَمَحتَ بِأَجفاني فَأَنسَيتَها الغُمضا","وَأَجنَيتَني مِن وَجنَتَيكَ هَوىً غَضّا",31,"ض",2,1],["طِمِرّاً تَزلَقُ العِقبانُ عَنهُ","إِذا ما نابَني ضَيمٌ أَبَيتُ",32,"ت",1,0],["طِمِرّاً يُؤنِسُ الفارِ","سَ مِن أَينٍ وَمِن كَبوِ",33,"و",1,0],["طَمَسَ الْيَمِينَ بِكَوْكَبٍ","وسَيَطْمُسُ اليُسْرَى بَفَجْرِ",34,"ر",1,0],["طُموحُ العَينِ وَالنَظَرِ","مُباحٌ لي وَلِلبَشَرِ",35,"ر",1,1],["طَمَعاً إِلَيكِ بِما أُؤمِّلُهُ","وَمَخافَةً أَن تَقطعي عُذري",36,"ي",1,0],["طَمَرَ الجَهولُ إِلى مَراتِبِهِ","ثُمَّ اِنثَنى وَحِباؤُهُ طَمرُ",37,"ر",1,0],["طماعيةٌ فيه أزالتْ قناعها","وما سترتْ وجهاً لها ببنانِ",38,"ن",1,0],["طَموحُ السّيفِ لا يخْشَى إلهاً","ولا يَرجو القِيامَةَ والمَعادا",39,"د",2,0],["طَمِعتُ بِأَن أَسلو الهَوى فَغَلَبتني","وَقَد ضَرَبَتني مُقلَتاكَ سِياطا",40,"ط",2,0],["طَمى بحرُ شَوقي وَاِلتَظى جاحِمُ الهَوى","فَهذا بِقَلبي ثُمَّ ذاكَ أَحاطا",40,"ط",2,0],["طَمِعتُ في أَن يَكونَ مِثلي","لَو صانَهُ اللَهُ لي وَحاطا",41,"ط",2,0],["طُموحٌ وإلاّ ما صِراعُ الكتائبِ","وعَزمٌ وإلاّ فيمَ حَثُّ الركَائبِ",42,"ب",1,1],["طَموحٌ له في ذِرْوةِ الدهرِ مأرَبٌ","وفوق مَناطِ الفرقَدِيْنِ طِلابُ",43,"ب",1,0],["طمع الشيب باللجام المحلى","حين أجريت أن يرد جماح",44,"ح",1,0],["طُموحٌ إلى الحتفِ المدبَّر قادني","وقد يُزهِقُ النفسَ الطُموحُ المُعاجل",45,"ل",1,0],["طَمَى فردَّ شبابَ الأرض قاحلةً","به وعادت إلى رَيعانها الغُدُر",46,"ر",1,0],["طَموحاً وأعرفُ عُقْبى الطُموح","فلا بالدَّعِيِّ ولا المُعْجَب",47,"ب",1,0],["طموحٌ يريني كلَّ شيءٍ أنالُه","وإنْ جلَّ قَدرْاً دونَ ما أبتغي قدرا",48,"ر",2,0],["طَمع النُفوس مطية","لِلنائِبات وَالمعنا",49,"ن",2,0],["طمست عيون العاقلين بغيهب ال","عمى فغشاء الطمس بالدرك لن يجلى",50,"ل",2,0],["طمست الهوَى لما بَدا طالعُ الهُدى","وطلعةُ سلطانُ بن سيف تهلَّلُ",51,"ل",1,0],["طَمَى بحر شوقي في زيارة قبره","فهلْ في الورَى قبرٌ كقبرِ محمدِ",52,"د",1,0],["طَمحَ الشَقاءُ بأهلِ قَفصَةَ وارتقى","بِهمُ شواهِقَ صَعبَةً وعِقَابا",53,"ب",2,0],["طمحت أنفسٌ إليها فصانت","حسّها عنهمو صيانةَ بكرِ",54,"ر",1,0],["طمعٌ وأنتَ برامةٍ","فيمن تضمَّنه النِّجادُ",55,"د",1,0],["طمست معناه في إبَّانه","فُرقَةٌ دبَّت إليه الخمرا",56,"ر",2,0],["طمِعتُ وَقَد أحببتُ في الوَصلِ والرِّضَا","فَما رَاحَتِي إلاَّ القَطيعَةُ والشَّحطُ",57,"ط",1,0],["طَمت لُجَجٌ للحبِّ خضتُ عُبَابَها","فلا سَبحَ يُنجيني وَقد بَعُدَ الشَّدُّ",57,"د",1,0],["طمِعت باثناءِ الجَزاءِ بِقُربِهِ","وَلِم لا وَعِندي مِن مَدائحِهِ الشَرطُ",58,"ط",1,0],["طمّعت نفسكَ أن تجاوز قدْرها","فطلب يا مسكينُ مالا يطلبُ",59,"ب",1,0],["طمع الورى في المستحيل من العطا","لما رأوه على يديك ميسّرا",60,"ر",2,0],["طَمى بالنّدى واديا راحَتَيهِ","فطمّ على آجناتِ القَرِيِّ",61,"ي",1,0],["طمِحَتْ إلى خوارَزْمَ همّتُهُ كما","سلكَ الهِزبرُ إلى العَرينِ مَداخلا",62,"ل",2,0],["طَما بَحرُ الهُمومِ بِهِ فَمادا","وَعَوَّضَهُ مِنَ الغمضِ السُهادا",63,"د",2,1],["طموح إلى ما تشتهي غير منته","فقد ملك العافي وعاف المعنّف",64,"ف",1,0],["طَمَّت عَلى ما يَذكُرونَ مِنَ العُلى","مِن فَيضِ بَحرِكَ جَمَّةٌ وَحَفيلُ",65,"ل",1,0],["طمعت بقرب دجلة قبل هذا","فلم أظفر بنائية المزار",66,"ر",1,1],["طمِع الوَرد أن ينافس خَدِّي","طمع الغصن أن يقاس بقَدِّي",67,"ي",1,1],["طَمَعاً أَن تَقِرَّعَيني وَأَن يَن","عَمَ بالي فَخَيَّبَ اللَهُ ظَنّي",68,"ن",2,0],["طَمعت بإدراكِ الشفاعةِ في غَدٍ","إذا الخوفُ من كلِّ الجهات أحاطا",69,"ط",2,0],["طماعيةً مني الرجاء فويح مَن","تعاطى من الزَّلات ما أَتعاطى",69,"ط",2,0],["طَموحٌ لعفوِ اللَه طرفُ رجائِهِ","على عظم ما داجي عليه وَواطا",69,"ط",2,0],["طمعُ الغَوانِي في انْتِظارِ قيامِهِ","طمعُ الرَّوافضِ في انْتِظارِ القائمِ",70,"م",1,0],["طُمرةً من مذاكي الفكر سابحة","جرداء ما صحبت حلاً ولا رسنا",71,"ن",2,0],["طمعتم بالكريمِ لفرطِ حلمٍ","وأنتم كالعبيدِ لكل باغ",72,"غ",1,0],["طمسَ الزمانُ قصورَهم وقبورَهم","والمكرماتُ مع الكرامِ تُباد",73,"د",1,0],["طَمع العَنيدُ لجهله بِهديّةٍ","منّي تسهّل وَجهُهُ المدلمسا",74,"س",2,0],["طَمِعَت بِأَن تَحكي يَدَي","عُثمانَ يا تَعَبَ المَطامِعْ",75,"ع",1,0],["طَمَستُ ما لِلحِسانِ مِن بَصَري","فيكُم وأوقَرتُ ما لِعُذَّالِي",76,"ل",2,0],["طَمِعَ الوشاةُ بسَلوتي وتَباشروا","إذ قيل قُرِّط عارضاه وقُلِّدا",77,"د",2,1],["طمعتُ فيها، فقلت: النَّجمُ يُعجبني","فصوَّرتْ ريشتي من حُسْنِه صُوَرا",78,"ر",2,0],["طَمِعْتُ في ريشتي، قلت: ارسمي حُلُم","فصوَّرتْ صورةً، عقلي بها انبهَرا",78,"ر",2,0],["طمى علماً ومكرمةً وجوداً","خضَمٌّ ليس يستقصيه حدّ",79,"د",1,0],["طميتَ وأنتَ يوم الجود بحر","وبحرك لا يزال الدهر طامي",80,"م",2,0],["طمن فؤادك إن اللَه ذو كرمٍ","واربأ بنفسك إن سامتك أهوالُ",81,"ل",1,0],["طمعتُ فيهم حتى يئست وما ال","يأس سوى ما أفادك الطمعُ",82,"ع",1,0],["طما بالقَنا العسَّا يتلو طِعانهُ","على سغبٍ مُعْطُ الذئاب العواسلُ",83,"ل",1,0],["طَمَتْ ثروةٌ بالبرمكيِّ فسهَّلت","نوالاً وجاد الخِنْدِفيُّ ولم يُثْرِ",84,"ر",1,0],["طمسَتْ معالِمَها الجَنُوبُ وغيَّرتْ","دمناً بها قضَّى المشوقُ مآرِبا",85,"ب",2,0],["طمعاً بأنَّ وصالَ جيرانِ النقا","مما يعيدُ علَّي عصرَ شبابيِ",86,"ي",1,0],["طمعاً بِعَوْدِ زمانِ أيامِ اللِّوى","ومُحَجِّرٍ سُقيَ الّلوى ومُحَجِّرُ",87,"ر",1,0],["طمحٌ يزيدُ وأضلعٌ تَلْظَى هوًى","وصبابةٌ تقوى وصبرٌ يُقهَرُ",87,"ر",1,0],["طمعاً بعودِ الظاعنينَ وعودِ ما","قد ماتَ من قربٍ وطيبِ وصالِ",88,"ل",1,0],["طَمْطامُها العَجَّاجُ صاحِبُ جُندِها","يومَ العَجاجِ مُجَنْدِلُ الفُرْسَانِ",89,"ن",1,0],["طمَّ أَكنافَ الوَرَى أَخبارُها","ملأَتْ بالنَّقلِ بيضَ الكُتُبِ",90,"ب",1,0],["طمع المرء في الحياة غرور","وطويل الآمال فيها قصير",91,"ر",1,1],["طمست فرقدي بعد طلوع","وعجيب أن يطمس الفرقدان",92,"ن",1,0],["طَمَّعْتُمُ يا وَيْحَكُمْ مَعْشَراً","قَدْ عَفَّ عَنْهُمْ كُلُّ طَمّاعِ",93,"ع",1,1],["طُموحَ سارِحَةٍ حَوم مُلَمَّعَةٍ","وَمُمرعُ السِرِّ سَهلٌ ماكِدُ السَهَلِ",94,"ل",1,0],["طمحتْ إليه عينُ كلِّ رئاسةٍ","لولاه ما نظرتْ إلى إنسانِ",95,"ن",1,0],["طمع الجهول بأن ينال بعقله","هذا النبا فأبى عليه تسلطا",96,"ط",2,0],["طمعت نفوسٌ فيه ملقاةٌ ورا","لكن جمال الحق جل فلا يُرى",97,"ر",2,0],["طمِعنا على جهلٍ بعسَّالِ ثغرِهِ","وكم دُونَ عَسَّالِ المَراشِفِ عَسَّالُ",98,"ل",1,0],["طَمَعُ الرَّدَى مستحكِمٌ","فيه فقد يَئِسَ العوائِدْ",99,"د",1,0],["طَمِع الغزالُ بأَن يعارِضُ مُغْل","تي والبدْرُ أَيضاً طَامِعَاً يَحْكِيني",100,"ي",1,0]]}