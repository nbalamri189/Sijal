%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6189,"حاشية على الجرح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83547&r=&rc=14",""],[6189,"قراءة في جسد اللؤلؤة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83584&r=&rc=51",""],[6213,"صدور الحادثات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76270&r=&rc=27",""],[6213,"شفرة الذباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76306&r=&rc=54",""],[6233,"متى قررتِ اغتيالي!؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82692&r=&rc=35",""],[463,"هبَّتْ ومنها الخلابُ والخدعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60118&r=&rc=174",""],[6318,"الفجر الدامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66161&r=&rc=11",""]],"verses":[["طَمِعَ المُعادي أَن يُقَرِّبَهُ وَمَن","صافى عَدُوّاً لي فَقَد عاداني",0,"ن",2,0],["طَموحٍ إِذا غَضَّ الشُجاعُ لِحاظَهُ","وَأَطرَقَ عَن بَرقِ الظُبى كُلُّ شائِمِ",1,"م",1,0],["طَمِعتَ أَن تَرتَقي بِلا قَدَمٍ","إِلى العُلى راعَ أُمَّكَ الثَكَلُ",2,"ل",1,0],["طَماعِيَتي أَن أَملِكَ المَجدَ كُلَّهُ","وَكُلُّ غُلامٍ في العَلاءِ طَموعُ",3,"ع",1,0],["طَمَعٌ وَرَّطَني في حَبلِهِم","وَيُصادُ الطَيرُ مِن حَيثُ لُقِط",4,"ط",1,0],["طَمَسَت مَنابِرَها عُلوجُ أُمَيَّةٍ","تَنزو ذِئابُهُمُ عَلى أَعوادِها",5,"د",3,0],["طَمِعتَ يا دَهرُ أَن تُرَوِّعَهُ","ظَنّا عَلى الرُغمِ مِنكَ مَكذوبا",6,"ب",2,0],["طَمِعتَ بِلَيلى أَن تَريعَ وَإِنَّما","تُقَطِّعُ أَعناقَ الرِجالِ المَطامِعُ",7,"ع",1,0],["طمَعَتْ نَفْسي بزَوْرٍ غرَّها","فهْيَ تجْني بعْدَهُ عُقْبَى الطّمَعْ",8,"ع",1,0],["طَمِعَ الشّيْبُ باللِّجامِ المُحلّى","حينَ أجْرَيْتُ أن يَرُدّ جِماحي",9,"ح",2,0],["طَمَعٌ أَلقى عَنِ الغَربِ اللِثاما","فَاِستَفِق يا شَرقُ وَاِحذَر أَن تَناما",10,"م",2,1],["طَمَّتْ فَعَمَّتْ بِالبَوَارِ وَلَمْ تَذَرْ","حَفْلَ الفَقِيرِ وَلا حِمَى المِسْكِينِ",11,"ن",1,0],["طماعة منك غير واعية","وهي لعمري حماقة وبله",12,"ل",2,0],["طمِعوا بوفر المال منه فأخجلوا","بفضول هاتيك المطامع أشعبا",13,"ب",2,0],["طمعتُ بالعدلِ والإحسانِ منكَ معاً","فكنتَ عنديَ بالإحسانِ غيرَ سخي",14,"ي",1,1],["طمعنا بحدس في رجوع مفارق","وفي غير من قد وارت الأرض يرجع",15,"ع",1,0],["طَمَعُ القَريبِ أَوِ البَعيدِ بِنَيلِها","طَمَعُ الفَتى مِن دَهرِهِ بِمَحالِهِ",16,"ل",2,0],["طَموحٌ إِلى العلياء يقدمُ همُّهُ","على المجدِ حتى لا يَرى متقدِّما",17,"م",2,0],["طَمَحَت عُيونُ الكاشِحينَ فَغَضَّها","شَرَفٌ بَناهُ اللَهُ حَيثُ بَناهُ",18,"ا",2,0],["طَمِعتُ بِعَفوٍ مِنكَ عَمّا اِقتَرَفتُهُ","فَلَيسَ لَهُ في طَيِّ حِلمِكُمُ قَدرُ",19,"ر",1,1],["طَمَحَت إِلى عَلياكَ أَحداقُ الوَرى","وَاِرتَدَّ طَرفُ الدَهرِ عَنكَ كَليلا",20,"ل",2,0],["طَمَعي في لِقاكَ بَعدَ إِياسِ","هُوَ أَغرى قَلبي بِقَصدِ أَياسِ",21,"س",1,1],["طما بحرها فركبتُ الكؤوس","إلى ساحل البحرِ منها سفين",22,"ن",1,0],["طمعتُ بهذا كلّه في لقائكمْ","لِتَغْرَمَ نَفْسٌ أُتْلِفَتْ بغرامِ",23,"م",1,0],["طَمَى بِالمَنايا الحُمرِ لَجُّ سرابِهِ","فكم غائصٍ لهفان من دونِ ساحِلِه",24,"ل",2,0],["طُمعَتْ مصافحتي له إذ زُرتُهُ","فَقَبضتُ مِن ظلِّ الخيالِ النافِرِ",25,"ر",1,0],["طَموحٌ بِأَثناءِ الزِمامِ كَأَنَّما","تَخالُ بِها مِن عَدوِها طَيفُ جِنَّةِ",26,"ه",1,0],["طَمَاعَةُ نَفْسٍ تُورِدُ الْمَرْءَ مَشْرَعاً","مِنَ الْبُؤْسِ لا يَعْدُوهُ أَوْ يَتَحَطَّمَا",27,"م",2,0],["طَمِعتُ بِأَمرٍ لَيسَ لي فيهِ مَطمَعُ","فَأَخلَفَني فَالعَينُ مِن ذاكَ تَدمَعُ",28,"ع",1,1],["طَمى الجودُ في يُمناهُ بَحراً وَرُبَّما","تَدَفَّقَ في أَرجائِها فَتَدَفَّعا",29,"ع",2,0],["طَمعَ المغيرُ فكرَّ إثر فريسةٍ","أخرى يضنُّ بمثلها ويُغالي",30,"ل",2,0],["طَمَحتَ بِأَجفاني فَأَنسَيتَها الغُمضا","وَأَجنَيتَني مِن وَجنَتَيكَ هَوىً غَضّا",31,"ض",2,1],["طِمِرّاً تَزلَقُ العِقبانُ عَنهُ","إِذا ما نابَني ضَيمٌ أَبَيتُ",32,"ت",1,0],["طِمِرّاً يُؤنِسُ الفارِ","سَ مِن أَينٍ وَمِن كَبوِ",33,"و",1,0],["طَمَسَ الْيَمِينَ بِكَوْكَبٍ","وسَيَطْمُسُ اليُسْرَى بَفَجْرِ",34,"ر",1,0],["طُموحُ العَينِ وَالنَظَرِ","مُباحٌ لي وَلِلبَشَرِ",35,"ر",1,1],["طَمَعاً إِلَيكِ بِما أُؤمِّلُهُ","وَمَخافَةً أَن تَقطعي عُذري",36,"ر",2,0],["طَمَرَ الجَهولُ إِلى مَراتِبِهِ","ثُمَّ اِنثَنى وَحِباؤُهُ طَمرُ",37,"ر",1,0],["طماعيةٌ فيه أزالتْ قناعها","وما سترتْ وجهاً لها ببنانِ",38,"ن",1,0],["طَموحُ السّيفِ لا يخْشَى إلهاً","ولا يَرجو القِيامَةَ والمَعادا",39,"د",2,0],["طَمِعتُ بِأَن أَسلو الهَوى فَغَلَبتني","وَقَد ضَرَبَتني مُقلَتاكَ سِياطا",40,"ط",2,0],["طَمى بحرُ شَوقي وَاِلتَظى جاحِمُ الهَوى","فَهذا بِقَلبي ثُمَّ ذاكَ أَحاطا",40,"ط",2,0],["طَمِعتُ في أَن يَكونَ مِثلي","لَو صانَهُ اللَهُ لي وَحاطا",41,"ط",2,0],["طُموحٌ وإلاّ ما صِراعُ الكتائبِ","وعَزمٌ وإلاّ فيمَ حَثُّ الركَائبِ",42,"ب",1,1],["طَموحٌ له في ذِرْوةِ الدهرِ مأرَبٌ","وفوق مَناطِ الفرقَدِيْنِ طِلابُ",43,"ب",1,0],["طمت الجرفة يا اقباطها","انها مأدبة لا تنتقر",44,"ر",1,0],["طمنوا ستي ام عطا بإنه القضية","من زمان المندوب وهي زي ما هية",45,"ي",2,1],["طمع الشيب باللجام المحلى","حين أجريت أن يرد جماح",46,"ح",1,0],["طُموحٌ إلى الحتفِ المدبَّر قادني","وقد يُزهِقُ النفسَ الطُموحُ المُعاجل",47,"ل",1,0],["طَمَى فردَّ شبابَ الأرض قاحلةً","به وعادت إلى رَيعانها الغُدُر",48,"ر",1,0],["طَموحاً وأعرفُ عُقْبى الطُموح","فلا بالدَّعِيِّ ولا المُعْجَب",49,"ب",1,0],["طموحٌ يريني كلَّ شيءٍ أنالُه","وإنْ جلَّ قَدرْاً دونَ ما أبتغي قدرا",50,"ر",2,0],["طمع لو أطاق  فاخشوا أذاه","حبس النور عنكم والغماما",51,"م",2,0],["طَمع النُفوس مطية","لِلنائِبات وَالمعنا",52,"ن",2,0],["طمست عيون العاقلين بغيهب ال","عمى فغشاء الطمس بالدرك لن يجلى",53,"ل",2,0],["طمست الهوَى لما بَدا طالعُ الهُدى","وطلعةُ سلطانُ بن سيف تهلَّلُ",54,"ل",1,0],["طَمَى بحر شوقي في زيارة قبره","فهلْ في الورَى قبرٌ كقبرِ محمدِ",55,"د",1,0],["طَمحَ الشَقاءُ بأهلِ قَفصَةَ وارتقى","بِهمُ شواهِقَ صَعبَةً وعِقَابا",56,"ب",2,0],["طمحت أنفسٌ إليها فصانت","حسّها عنهمو صيانةَ بكرِ",57,"ر",1,0],["طمعٌ وأنتَ برامةٍ","فيمن تضمَّنه النِّجادُ",58,"د",1,0],["طمست معناه في إبَّانه","فُرقَةٌ دبَّت إليه الخمرا",59,"ر",2,0],["طمِعتُ وَقَد أحببتُ في الوَصلِ والرِّضَا","فَما رَاحَتِي إلاَّ القَطيعَةُ والشَّحطُ",60,"ط",1,0],["طَمت لُجَجٌ للحبِّ خضتُ عُبَابَها","فلا سَبحَ يُنجيني وَقد بَعُدَ الشَّدُّ",60,"د",1,0],["طمِعت باثناءِ الجَزاءِ بِقُربِهِ","وَلِم لا وَعِندي مِن مَدائحِهِ الشَرطُ",61,"ط",1,0],["طمّعت نفسكَ أن تجاوز قدْرها","فطلب يا مسكينُ مالا يطلبُ",62,"ب",1,0],["طمع الورى في المستحيل من العطا","لما رأوه على يديك ميسّرا",63,"ر",2,0],["طَمى بالنّدى واديا راحَتَيهِ","فطمّ على آجناتِ القَرِيِّ",64,"ي",1,0],["طمِحَتْ إلى خوارَزْمَ همّتُهُ كما","سلكَ الهِزبرُ إلى العَرينِ مَداخلا",65,"ل",2,0],["طَما بَحرُ الهُمومِ بِهِ فَمادا","وَعَوَّضَهُ مِنَ الغمضِ السُهادا",66,"د",2,1],["طموح إلى ما تشتهي غير منته","فقد ملك العافي وعاف المعنّف",67,"ف",1,0],["طَمَّت عَلى ما يَذكُرونَ مِنَ العُلى","مِن فَيضِ بَحرِكَ جَمَّةٌ وَحَفيلُ",68,"ل",1,0],["طمعت بقرب دجلة قبل هذا","فلم أظفر بنائية المزار",69,"ر",1,1],["طمِع الوَرد أن ينافس خَدِّي","طمع الغصن أن يقاس بقَدِّي",70,"د",2,1],["طَمَعاً أَن تَقِرَّعَيني وَأَن يَن","عَمَ بالي فَخَيَّبَ اللَهُ ظَنّي",71,"ن",2,0],["طَمعت بإدراكِ الشفاعةِ في غَدٍ","إذا الخوفُ من كلِّ الجهات أحاطا",72,"ط",2,0],["طماعيةً مني الرجاء فويح مَن","تعاطى من الزَّلات ما أَتعاطى",72,"ط",2,0],["طَموحٌ لعفوِ اللَه طرفُ رجائِهِ","على عظم ما داجي عليه وَواطا",72,"ط",2,0],["طمعُ الغَوانِي في انْتِظارِ قيامِهِ","طمعُ الرَّوافضِ في انْتِظارِ القائمِ",73,"م",1,0],["طُمرةً من مذاكي الفكر سابحة","جرداء ما صحبت حلاً ولا رسنا",74,"ن",2,0],["طمعتم بالكريمِ لفرطِ حلمٍ","وأنتم كالعبيدِ لكل باغ",75,"غ",1,0],["طمسَ الزمانُ قصورَهم وقبورَهم","والمكرماتُ مع الكرامِ تُباد",76,"د",1,0],["طَمع العَنيدُ لجهله بِهديّةٍ","منّي تسهّل وَجهُهُ المدلمسا",77,"س",2,0],["طَمِعَت بِأَن تَحكي يَدَي","عُثمانَ يا تَعَبَ المَطامِعْ",78,"ع",1,0],["طَمَستُ ما لِلحِسانِ مِن بَصَري","فيكُم وأوقَرتُ ما لِعُذَّالِي",79,"ل",2,0],["طَمِعَ الوشاةُ بسَلوتي وتَباشروا","إذ قيل قُرِّط عارضاه وقُلِّدا",80,"د",2,1],["طمعتُ فيها، فقلت: النَّجمُ يُعجبني","فصوَّرتْ ريشتي من حُسْنِه صُوَرا",81,"ر",2,0],["طَمِعْتُ في ريشتي، قلت: ارسمي حُلُم","فصوَّرتْ صورةً، عقلي بها انبهَرا",81,"ر",2,0],["طمى علماً ومكرمةً وجوداً","خضَمٌّ ليس يستقصيه حدّ",82,"د",1,0],["طميتَ وأنتَ يوم الجود بحر","وبحرك لا يزال الدهر طامي",83,"م",2,0],["طمن فؤادك إن اللَه ذو كرمٍ","واربأ بنفسك إن سامتك أهوالُ",84,"ل