{"poems":[[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[53,"ألا ليت أذيال الغيوث السواجم","https://www.aldiwan.net/poem29766.html","الطويل"],[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[53,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[53,"ما لذا الداني إلى القلب شحط","https://www.aldiwan.net/poem30161.html","الرمل"],[53,"هذي المنازل بالغميم فنادها","https://www.aldiwan.net/poem30606.html","الكامل"],[53,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[34,"عفا سرف من أهله فسراوع","https://www.aldiwan.net/poem4901.html","الطويل"],[77,"خدع الشوق فؤادي فانخدع","https://www.aldiwan.net/poem35986.html","الرمل"],[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[86,"طمع ألقى عن الغرب اللثاما","https://www.aldiwan.net/poem10683.html","الرمل"],[93,"أمن الفساد طغيت نهر السين","https://www.aldiwan.net/poem11178.html","الكامل"],[88,"كان أبو الطيب امرأ قوله","https://www.aldiwan.net/poem44436.html","المنسرح"],[88,"ظلموك أيتها الفتاة بجهلهم","https://www.aldiwan.net/poem44971.html","الكامل"],[72,"طمعت بالعدل والإحسان منك معا","https://www.aldiwan.net/poem18539.html","البسيط"],[72,"أذات الحجى إن الحجاب ليمنع","https://www.aldiwan.net/poem19171.html","الطويل"],[85,"الملك بين يديك في إقباله","https://www.aldiwan.net/poem63756.html","الكامل"],[62,"سرى يكتسي قطعا من الليل مظلما","https://www.aldiwan.net/poem52297.html","الطويل"],[45,"أرج لريا طلة رياه","https://www.aldiwan.net/poem66848.html","الكامل"],[66,"طمعت بعفو منك عما اقترفته","https://www.aldiwan.net/poem38658.html","الطويل"],[66,"لا زال ظلك للعفاة ظليلا","https://www.aldiwan.net/poem38745.html","الكامل"],[66,"طمعي في لقاك بعد إياس","https://www.aldiwan.net/poem40639.html","الخفيف"],[80,"رددت الملام على العاذلين","https://www.aldiwan.net/poem31275.html","المتقارب"],[80,"شددت على صدر الزماع حزامي","https://www.aldiwan.net/poem31296.html","الطويل"],[80,"بجمل حدا الغيران بزل جمائله","https://www.aldiwan.net/poem31331.html","الطويل"],[80,"هجر الخيال فزرته بالخاطر","https://www.aldiwan.net/poem31447.html","الكامل"],[44,"نسائلها أي المواطن حلت","https://www.aldiwan.net/poem30567.html","الطويل"],[87,"هوى كان لي أن ألبس المجد معلما","https://www.aldiwan.net/poem8284.html","الطويل"],[31,"طمعت بأمر ليس لي فيه مطمع","https://www.aldiwan.net/poem42245.html","الطويل"],[74,"سجعت وقد غنى الحمام فرجعا","https://www.aldiwan.net/poem13173.html","الطويل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[81,"طمحت بأجفاني فأنسيتها الغمضا","https://www.aldiwan.net/poem61467.html","الطويل"],[17,"عفا من آل فاطمة الخبيت","https://www.aldiwan.net/poem1192.html",""],[52,"أللمنزل بالحنو","https://www.aldiwan.net/poem26584.html","الهزج"],[67,"انظر بحمد الله في","https://www.aldiwan.net/poem18136.html","مجزوء الكامل"],[48,"طموح العين والنظر","https://www.aldiwan.net/poem63343.html","مجزوء الوافر"],[50,"أعبيد يا ذات الهوى النزر","https://www.aldiwan.net/poem63818.html","الكامل"],[46,"لا علم لي بم يختم العمر","https://www.aldiwan.net/poem22588.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43645","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43843","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54197","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[77,"ما على القلب بعدكم من جناح","https://www.poetsgate.com/ViewPoem.aspx?id=33823",""],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[90,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""]],"verses":[["طَمِعَ المُعادي أَن يُقَرِّبَهُ وَمَن","صافى عَدُوّاً لي فَقَد عاداني",0,"ي",1,0],["طَموحٍ إِذا غَضَّ الشُجاعُ لِحاظَهُ","وَأَطرَقَ عَن بَرقِ الظُبى كُلُّ شائِمِ",1,"م",1,0],["طَمِعتَ أَن تَرتَقي بِلا قَدَمٍ","إِلى العُلى راعَ أُمَّكَ الثَكَلُ",2,"ل",1,0],["طَماعِيَتي أَن أَملِكَ المَجدَ كُلَّهُ","وَكُلُّ غُلامٍ في العَلاءِ طَموعُ",3,"ع",1,0],["طَمَعٌ وَرَّطَني في حَبلِهِم","وَيُصادُ الطَيرُ مِن حَيثُ لُقِط",4,"ط",1,0],["طَمَسَت مَنابِرَها عُلوجُ أُمَيَّةٍ","تَنزو ذِئابُهُمُ عَلى أَعوادِها",5,"د",3,0],["طَمِعتَ يا دَهرُ أَن تُرَوِّعَهُ","ظَنّا عَلى الرُغمِ مِنكَ مَكذوبا",6,"ب",2,0],["طَمِعتَ بِلَيلى أَن تَريعَ وَإِنَّما","تُقَطِّعُ أَعناقَ الرِجالِ المَطامِعُ",7,"ع",1,0],["طمَعَتْ نَفْسي بزَوْرٍ غرَّها","فهْيَ تجْني بعْدَهُ عُقْبَى الطّمَعْ",8,"ع",1,0],["طَمِعَ الشّيْبُ باللِّجامِ المُحلّى","حينَ أجْرَيْتُ أن يَرُدّ جِماحي",9,"ح",2,0],["طَمَعٌ أَلقى عَنِ الغَربِ اللِثاما","فَاِستَفِق يا شَرقُ وَاِحذَر أَن تَناما",10,"م",2,1],["طَمَّتْ فَعَمَّتْ بِالبَوَارِ وَلَمْ تَذَرْ","حَفْلَ الفَقِيرِ وَلا حِمَى المِسْكِينِ",11,"ن",1,0],["طماعة منك غير واعية","وهي لعمري حماقة وبله",12,"ل",2,0],["طمِعوا بوفر المال منه فأخجلوا","بفضول هاتيك المطامع أشعبا",13,"ب",2,0],["طمعتُ بالعدلِ والإحسانِ منكَ معاً","فكنتَ عنديَ بالإحسانِ غيرَ سخي",14,"ي",1,1],["طمعنا بحدس في رجوع مفارق","وفي غير من قد وارت الأرض يرجع",15,"ع",1,0],["طَمَعُ القَريبِ أَوِ البَعيدِ بِنَيلِها","طَمَعُ الفَتى مِن دَهرِهِ بِمَحالِهِ",16,"ل",2,0],["طَموحٌ إِلى العلياء يقدمُ همُّهُ","على المجدِ حتى لا يَرى متقدِّما",17,"م",2,0],["طَمَحَت عُيونُ الكاشِحينَ فَغَضَّها","شَرَفٌ بَناهُ اللَهُ حَيثُ بَناهُ",18,"ا",2,0],["طَمِعتُ بِعَفوٍ مِنكَ عَمّا اِقتَرَفتُهُ","فَلَيسَ لَهُ في طَيِّ حِلمِكُمُ قَدرُ",19,"ر",1,1],["طَمَحَت إِلى عَلياكَ أَحداقُ الوَرى","وَاِرتَدَّ طَرفُ الدَهرِ عَنكَ كَليلا",20,"ل",2,0],["طَمَعي في لِقاكَ بَعدَ إِياسِ","هُوَ أَغرى قَلبي بِقَصدِ أَياسِ",21,"س",1,1],["طما بحرها فركبتُ الكؤوس","إلى ساحل البحرِ منها سفين",22,"ن",1,0],["طمعتُ بهذا كلّه في لقائكمْ","لِتَغْرَمَ نَفْسٌ أُتْلِفَتْ بغرامِ",23,"م",1,0],["طَمَى بِالمَنايا الحُمرِ لَجُّ سرابِهِ","فكم غائصٍ لهفان من دونِ ساحِلِه",24,"ل",2,0],["طُمعَتْ مصافحتي له إذ زُرتُهُ","فَقَبضتُ مِن ظلِّ الخيالِ النافِرِ",25,"ر",1,0],["طَموحٌ بِأَثناءِ الزِمامِ كَأَنَّما","تَخالُ بِها مِن عَدوِها طَيفُ جِنَّةِ",26,"ه",1,0],["طَمَاعَةُ نَفْسٍ تُورِدُ الْمَرْءَ مَشْرَعاً","مِنَ الْبُؤْسِ لا يَعْدُوهُ أَوْ يَتَحَطَّمَا",27,"م",2,0],["طَمِعتُ بِأَمرٍ لَيسَ لي فيهِ مَطمَعُ","فَأَخلَفَني فَالعَينُ مِن ذاكَ تَدمَعُ",28,"ع",1,1],["طَمى الجودُ في يُمناهُ بَحراً وَرُبَّما","تَدَفَّقَ في أَرجائِها فَتَدَفَّعا",29,"ع",2,0],["طَمعَ المغيرُ فكرَّ إثر فريسةٍ","أخرى يضنُّ بمثلها ويُغالي",30,"ل",2,0],["طَمَحتَ بِأَجفاني فَأَنسَيتَها الغُمضا","وَأَجنَيتَني مِن وَجنَتَيكَ هَوىً غَضّا",31,"ض",2,1],["طِمِرّاً تَزلَقُ العِقبانُ عَنهُ","إِذا ما نابَني ضَيمٌ أَبَيتُ",32,"ت",1,0],["طِمِرّاً يُؤنِسُ الفارِ","سَ مِن أَينٍ وَمِن كَبوِ",33,"و",1,0],["طَمَسَ الْيَمِينَ بِكَوْكَبٍ","وسَيَطْمُسُ اليُسْرَى بَفَجْرِ",34,"ر",1,0],["طُموحُ العَينِ وَالنَظَرِ","مُباحٌ لي وَلِلبَشَرِ",35,"ر",1,1],["طَمَعاً إِلَيكِ بِما أُؤمِّلُهُ","وَمَخافَةً أَن تَقطعي عُذري",36,"ي",1,0],["طَمَرَ الجَهولُ إِلى مَراتِبِهِ","ثُمَّ اِنثَنى وَحِباؤُهُ طَمرُ",37,"ر",1,0],["طماعيةٌ فيه أزالتْ قناعها","وما سترتْ وجهاً لها ببنانِ",38,"ن",1,0],["طَموحُ السّيفِ لا يخْشَى إلهاً","ولا يَرجو القِيامَةَ والمَعادا",39,"د",2,0],["طَمِعتُ بِأَن أَسلو الهَوى فَغَلَبتني","وَقَد ضَرَبَتني مُقلَتاكَ سِياطا",40,"ط",2,0],["طَمى بحرُ شَوقي وَاِلتَظى جاحِمُ الهَوى","فَهذا بِقَلبي ثُمَّ ذاكَ أَحاطا",40,"ط",2,0],["طَمِعتُ في أَن يَكونَ مِثلي","لَو صانَهُ اللَهُ لي وَحاطا",41,"ط",2,0],["طُموحٌ وإلاّ ما صِراعُ الكتائبِ","وعَزمٌ وإلاّ فيمَ حَثُّ الركَائبِ",42,"ب",1,1],["طَموحٌ له في ذِرْوةِ الدهرِ مأرَبٌ","وفوق مَناطِ الفرقَدِيْنِ طِلابُ",43,"ب",1,0],["طمع الشيب باللجام المحلى","حين أجريت أن يرد جماح",44,"ح",1,0],["طُموحٌ إلى الحتفِ المدبَّر قادني","وقد يُزهِقُ النفسَ الطُموحُ المُعاجل",45,"ل",1,0],["طَمَى فردَّ شبابَ الأرض قاحلةً","به وعادت إلى رَيعانها الغُدُر",46,"ر",1,0],["طَموحاً وأعرفُ عُقْبى الطُموح","فلا بالدَّعِيِّ ولا المُعْجَب",47,"ب",1,0],["طموحٌ يريني كلَّ شيءٍ أنالُه","وإنْ جلَّ قَدرْاً دونَ ما أبتغي قدرا",48,"ر",2,0]]}