{"poems":[[65,"سرت والليل يرمز بالصباح","https://www.aldiwan.net/poem46156.html","الوافر"],[48,"إذا كان ما قال الحكيم فما خلا","https://www.aldiwan.net/poem23119.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42595","الكامل"],[190,"أصون دراهمي وأذب عنها","https://www.aldiwan.net/poem43715.html","الوافر"],[234,"أأظهر أم أخفي الذي بي من السقم","https://www.aldiwan.net/poem50791.html","الطويل"],[266,"هلما نحييها ربى وربوعا","https://www.aldiwan.net/poem38241.html","الطويل"],[520,"ما عن هوى الرشأ العذري أعذار","https://www.aldiwan.net/poem12136.html","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70682","البسيط"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110801","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54454","المنسرح"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62152","المتقارب"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83201","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83189","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139759",""],[5401,"خادم الحرمين الشريفين","https://www.poetsgate.com/ViewPoem.aspx?id=183493",""],[5906,"احذر عديم الأصل","https://www.poetsgate.com/ViewPoem.aspx?id=188219",""]],"verses":[["وآبَ خَيالُها والليْلُ داجٍ","ونِضْوِي فاتِرُ اللحَظاتِ طاحِ",0,"ح",1,0],["وَأَبخَلُ بِالطَبعِ الَّذي لَستُ","غالِباً وَمِن شَرِّ أَخلاقِ الرِجالِ هُوَ البُخلُ",1,"ل",1,0],["وَابْخِلْ بِنَفْسِكَ أَوْ فَجُدْ","كُلُّ الأُمُورِ إِلَى فَسَادِ",2,"د",1,0],["وأبخلُ ما استطعت بها حياتي","على نفسي بماكولي ولبسي",3,"س",2,0],["وأُبخَس حظّاً أنت كنت ابتدأتَه","وأنت أحقّ الناس بالعدْل في القَسْم",4,"م",1,0],["وابخل خلق الله من كان باعثاً","خيالا لعين لا تذوق هجوعا",5,"ع",2,0],["وابخل بمعدن هذا الدر وهو فمي","فالبخل بي كرم محض وإيثار",6,"ر",1,0],["وابخلْ بعِرضِك تكسبْ كلَّ محمدَةٍ","فالمرء يفنَى وقد تبقَى محامده",7,"د",2,0],["وابخل بنفسك إن تذل لباخل","فسؤاله شر من الإفلاس",8,"س",1,0],["وابخلْ بودّي يا سَمْحُ فالسُّمحاء ال","غرُّ صيدٌ بودّهم بُخلا",9,"ل",2,0],["وأبخر قص حديثاً له","فقال الحضور فساء حدث",10,"ث",1,1],["وَاِبخَل بِهِ إِلّا عَلى ما يَنفَعُك","وَجُد بِهِ فيما تَراهُ يَرفَعُك",11,"ك",1,0],["وَاِبخل بِهِ حَتّى تُصيبَ المَوضِعا","ضَنّاً بِفَضلِ العِلمِ أَن يُضَيَّعا",12,"ع",2,0],["وابخل به عن جميع الناس قاطبةً","إلا لنجل الندى والمجد فانشيه",13,"ي",2,0],["وابختصر بيتين قدام الأخير","أعضاي فدوى لك ولو راحت تَلَف",14,"ف",1,0],["وابخس عَديمَ الأصلِ لو بلغَ الرََّدى","فالخَيرُ فيهِ كَدمعَةِ المَرعوفِ",15,"ف",1,0]]}