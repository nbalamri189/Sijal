{"poems":[[53,"ضربن إلينا خدودا وساما","https://www.aldiwan.net/poem29807.html","المتقارب"],[53,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[55,"ألا فانظري بالله يا سكني الوعدا","https://www.aldiwan.net/poem26406.html","الطويل"],[77,"خطب ألم فأذهب الأخ والأبا","https://www.aldiwan.net/poem36779.html","الكامل"],[93,"ماذا تصباك من حال تجددها","https://www.aldiwan.net/poem11314.html","البسيط"],[93,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[54,"ألا فاشتروا مني ملوك المخرم","https://www.aldiwan.net/poem27375.html","الطويل"],[88,"أزمعت عنا إلى مولاك ترحالا","https://www.aldiwan.net/poem45053.html","البسيط"],[27,"لمن رسم دار هم أن يتغيرا","https://www.aldiwan.net/poem5761.html","الطويل"],[72,"خلفت بالقلب بيتا منك معمورا","https://www.aldiwan.net/poem18733.html","البسيط"],[64,"رقيبان مني شاهدان لحبه","https://www.aldiwan.net/poem67600.html","الطويل"],[51,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[70,"لها خفر يوم اللقاء خفيرها","https://www.aldiwan.net/poem42923.html","الطويل"],[38,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[62,"إذا ما الأرض لم تنخل مرارا","https://www.aldiwan.net/poem52177.html","الوافر"],[62,"هلموا إذا ما خفتهم الفقر فاصعدوا","https://www.aldiwan.net/poem52185.html","الطويل"],[62,"أطامن عن أيدي العفاة تكرما","https://www.aldiwan.net/poem52246.html","الطويل"],[45,"كنت إلى وصل سعدى جد محتاج","https://www.aldiwan.net/poem62673.html","البسيط"],[28,"أحب من النساء وهن شتى","https://www.aldiwan.net/poem5414.html","الوافر"],[61,"نسالم هذا الدهر وهو لنا حرب","https://www.aldiwan.net/poem51800.html","الطويل"],[66,"أخاف مع الترداد تقطيب حاجب","https://www.aldiwan.net/poem38684.html","الطويل"],[66,"صروف الليالي لا يدوم لها عهد","https://www.aldiwan.net/poem40127.html","الطويل"],[97,"يا مية الحسناء هل يغزو الهوى","https://www.aldiwan.net/poem24867.html","الكامل"],[69,"أيبست أفئدة بالحزن يا خضر","https://www.aldiwan.net/poem28056.html","البسيط"],[69,"خليلي هل من رقدة أستريحها","https://www.aldiwan.net/poem28555.html","الطويل"],[31,"أفي رسم دار دارس أنت واقف","https://www.aldiwan.net/poem42225.html","الطويل"],[81,"لله سر جمال أنت موضعه","https://www.aldiwan.net/poem61462.html","البسيط"],[52,"يا طول شوقي إلى تسليم مقلته","https://www.aldiwan.net/poem26921.html","البسيط"],[48,"إذا ولج البعير فروغ صبري","https://www.aldiwan.net/poem66271.html","الوافر"],[46,"خطوب تألت لا يزال معذبا","https://www.aldiwan.net/poem22447.html","الطويل"],[46,"لنفسي إن تنأ عن الجسم روعة","https://www.aldiwan.net/poem22657.html","الطويل"],[46,"ظهور الركاب عند اللبيب","https://www.aldiwan.net/poem23059.html","المتقارب"],[15,"طاف الخيال علينا ليلة الوادي","https://www.aldiwan.net/poem45273.html","البسيط"],[8,"باتت تذكرني بالله قاعدة","https://www.aldiwan.net/poem21822.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85351","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30489","الطويل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42533","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43755","الوافر"],[54,"أَلاَ فاشترُوا مِنِّي مُلوكَ المخرِّمِ","https://www.poetsgate.com/ViewPoem.aspx?id=14090",""],[46,"خطوبٌ تألّت: لا يزالُ، معذَّباً،","https://www.poetsgate.com/ViewPoem.aspx?id=18549",""],[46,"لِنَفسيَ، إن تَنْأ عن الجسم، رَوْعةٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=20233",""],[136,"ما للحوادث تنئينا وتدنينا","https://www.aldiwan.net/poem49191.html","البسيط"],[138,"على الدور التي بليت سفاها","https://www.aldiwan.net/poem67927.html","الوافر"],[143,"ماذا يعيب رجال الحى في النادي","https://www.aldiwan.net/poem58426.html","البسيط"],[148,"أقاسي الحب من قاسي الفؤاد","https://www.aldiwan.net/poem47683.html","الوافر"],[161,"هو القضا فخذ المبسوط مختصرا","https://www.aldiwan.net/poem59004.html","البسيط"],[170,"دع الدار بالبحرين تعفو ربوعها","https://www.aldiwan.net/poem1634.html",""],[170,"أفي كل يوم للخطوب أصالي","https://www.aldiwan.net/poem1650.html",""],[194,"أخوك من إن كنت في","https://www.aldiwan.net/poem13095.html","مجزوء الرجز"],[200,"رأيت نساء الزمان كثارا","https://www.aldiwan.net/poem45374.html","المتقارب"],[200,"ألا لا تلمه اليوم أن يتألما","https://www.aldiwan.net/poem45633.html","الطويل"],[236,"مولاي يامن له أياد","https://www.aldiwan.net/poem31781.html","مجزوء البسيط"],[236,"سقاها الحيا من أربع وطلول","https://www.aldiwan.net/poem31789.html","الطويل"],[238,"مات الحفيظ فمن يحفظ من عاشا","https://www.aldiwan.net/poem19724.html","البسيط"],[276,"من الملك المحيا في الرواق","https://www.aldiwan.net/poem25475.html","الوافر"],[282,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[299,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[306,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[306,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[329,"قبل أن يبصر الظلام الضياء","https://www.aldiwan.net/poem54981.html","الخفيف"],[343,"عجيب أيحدوني إليك حنين","https://www.aldiwan.net/poem55364.html","الطويل"],[350,"أراني فيك موجودا","https://www.aldiwan.net/poem15614.html","مجزوء الوافر"],[358,"هنيئا لك الإقبال واليمن والنجح","https://www.aldiwan.net/poem4174.html","الطويل"],[378,"أيا أغنياء الروح صونوا كنوزَكم","https://www.aldiwan.net/poem59426.html","الطويل"],[401,"موازين الرجال","https://www.aldiwan.net/poem6777.html","عموديه"],[404,"أما آن عما أنت فيه متاب","https://www.aldiwan.net/poem34163.html","الطويل"],[430,"هو الحب في العشاق ينفذ ما يقضي","https://www.aldiwan.net/poem39881.html","الطويل"],[430,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[430,"يا سيدا حزت من راحاته نعما","https://www.aldiwan.net/poem41407.html","البسيط"],[433,"قفا فاسألا مني زفيرا وأدمعا","https://www.aldiwan.net/poem12378.html","الطويل"],[433,"بدور الحي مالت للأفول","https://www.aldiwan.net/poem12702.html","الوافر"],[438,"منازلهم بين اللوى فالدكادك","https://www.aldiwan.net/poem2528.html","الطويل"],[440,"تسمع لدعوة ناء غريب","https://www.aldiwan.net/poem34789.html","المتقارب"],[449,"بعثت لكم مثلى مشوقا قد انطوى","https://www.aldiwan.net/poem53726.html","الطويل"],[459,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[459,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[462,"هل للزمان وقد جلت جرائمه","https://www.aldiwan.net/poem15130.html","البسيط"],[462,"بقيت مطاعا ما تغنت حمامة","https://www.aldiwan.net/poem16179.html","الطويل"],[469,"إلى كم خطبت من المعالي","https://www.aldiwan.net/poem60509.html","الكامل"],[494,"فإن رأى لا أراه الله نائبة","https://www.aldiwan.net/poem67371.html","البسيط"],[494,"فإن رأي لا رأي سواءا ولا برح","https://www.aldiwan.net/poem67408.html","البسيط"],[501,"أرى سيرة الوراث وراث أحمد","https://www.aldiwan.net/poem38075.html","الطويل"],[507,"زيادة حسن الصوت في الخلق زينة","https://www.aldiwan.net/poem2427.html","الطويل"],[516,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[516,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[528,"فإن ردني دهري عليك طريدة","https://www.aldiwan.net/poem45958.html","الطويل"],[530,"أجزتك يا عبد الرحيم بكل ما","https://www.aldiwan.net/poem37424.html","الطويل"],[552,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[552,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[552,"ناد امرءا غيب خلف النقا","https://www.aldiwan.net/poem48119.html","السريع"],[559,"هوى قد أذاب الروح والنفس والجسما","https://www.aldiwan.net/poem34192.html","الطويل"],[559,"حروف المباني والمعاني تنزهت","https://www.aldiwan.net/poem34543.html","الطويل"],[559,"خيطان خيط أبيض وهو الوجود","https://www.aldiwan.net/poem34578.html","الرجز"],[576,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[588,"تعلم ففي العلم الشريف فوائد","https://www.aldiwan.net/poem11508.html","عموديه"],[588,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["فَإِن رابَكُم ما يَقولُ النَصيحُ","فَسالوا القَنا وَاِستَشيروا الحُساما",0,"م",2,0],["فَإِن راشَني دَهري أَكُن لَكَ بازِياً","يَسُرُّكَ مَحصوراً وَيُرضيكَ مُطلَقا",1,"ق",2,0],["فَإِن رُدَّتِ الأَيامُ بَعدُ وَعاوَدَت","فَلا رُدَّ فيها الأَربِعاءُ وَلا عُدّا",2,"د",2,0],["فَأَنَرْتَ مِنْ ظَلْمَاءِ نَفْسِي مَا دَجَا","وَقَدَحْتَ مِنْ زَنْدِ اصْطِبَارِي مَا خَبَا",3,"ب",2,0],["فَإِنْ رَنَا وَهِلالُ الشَّهْرِ مُبْتَسِمٌ","حَيَّاهُ مِنْ أَمَلٍ فِي الأُفْقِ مُبْتَسِمِ",4,"م",1,0],["فَإِنْ رَوِيَتْ مِنْكَ الْجَوَانِحُ بَهْجَةَ","وَأَظْمَأَهَا وِرْدٌ جَدِيدٌ يُيَمَّمُ",5,"م",1,0],["فَإِن رُدَّ مِن عَيبٍ عَلَيَّ جَميعُهُم","فَلَيسَ يَرُدُّ العَيبَ يَحيى اِبنَ أَكثَمِ",6,"م",1,0],["فإن رزأك عمّ الناس قاطبةً","يا أكرم الناس أعماماً وأخوالا",7,"ل",2,0],["فَإِنَّ رَبيعاً وَالمُشَيَّعَ فَاِعلَما","عَلى مَوطِنٍ لَم يَدرِيا كَيفَ قَدَّرا",8,"ر",2,0],["فإن رسمت بمصر أو دمشق حمى","فأعطِ عبدَكَ في الحالين دستورا",9,"ر",2,0],["فَإِن رُمتُ شَرقاً أَنتَ في الشَرقِ شَرقُهُ","وَإِن رُمتُ غَرباً أَنتَ نُصبُ عِياني",10,"ن",2,0],["فإن رأى كفّاً كريماً زوّجا","جَدوى ترى منها الغِنى مُسْتَنْتَجَا",11,"ج",2,0],["فإن رأى في المنام هفوتهُ","غضّ من الطرف عنه أو شَزره",12,"ر",2,0],["فإن راثَ اللقاءُ فلا تلمني","فإن تخلُّفي عنك انهزامُ",13,"م",1,0],["فَإِن راحَ مِنها ناجِياً بِحُشاشَةٍ","سَتَلقاهُ أُخرى تَحتَويهِ سَعيرُها",14,"ر",3,0],["فَإِن رَفَعتَ بِهِم رَأساً نَعَشتَهُمُ","وَإِن لَقوا مِثلَها في قابِلٍ فَسَدوا",15,"د",3,0],["فإن ردّدتَ بِلَّتَها عليها","افادتهنَّ في النار البقاءَ",16,"ا",2,0],["فإن رمتم الحُملان منه فقطّروا","على القشر محمراً من الدم مثخنا",17,"ن",2,0],["فإِن راشتِ الأيامُ قِدحي فطالما","غدتْ بيدِ الأيامِ تنهِكُهُ بريَا",18,"ي",2,0],["فَإِن رَجَعتَ إِلى حَربٍ فَأَبقِ عَلى","خِلياقِ يَنشو وَبَمٍّ فيهِ لَجلاجِ",19,"ج",1,0],["فَإِنَّ رَواحَكِ الأَتعابُ عِندي","وَتَكليفي لَكِ العُصَبَ العِجالا",20,"ل",2,0],["فإن رِيعَ سِربي أو تُمرِّدَ دونَه","ولم يُنجِني منه الحمايةُ والذَّبُّ",21,"ب",1,0],["فَإِن رُمتُ إِقداماً لَيسَ بِمُمكِنٍ","وَإِن رُمتُ تَأخيراً فَلَيسَ بَواجِبِ",22,"ب",1,0],["فَإِن رَمِدَت أَجفانُ عَينِيَ بِالبُكا","فَكَم جُلِيَت مِنّا بِكَ الأَعيُنُ الرُمدُ",23,"د",1,0],["فأنرتِ لي قلبي وصرتُ كأنما","هذا السواد الجَهمُ غير سواد",24,"د",1,0],["فإنْ رُددتَ فما في الردِّ منقصةٌ","عليكَ قدْ ردَّ موسى قبلُ والخِضرُ",25,"ر",1,0],["فإنْ رنَّحتْ عطفاً فلا يستميلُها","وإنْ سمحت لطفاً قلا يستميحُها",26,"ح",3,0],["فَإِن راجَعَتهُ في التَراسُلِ لَم يَزَل","لَهُ مِن أَعاجيبِ الحَديثِ طَرائِفُ",27,"ف",1,0],["فَإِن رَمى قَرطَسَت بِالسَهمِ نَزعَتُهُ","وَإِن رَأى صادَفَ التَوفيقَ مَنزِعُهُ",28,"ع",2,0],["فَإِن رَأى الخَوفَ أَو هَمَّ الرَقيبُ بِهِ","يُعرَفنَ أَلحاظُهُ في لَحظَةِ الكاسِ",29,"س",1,0],["فإن رابطتَ في ثغرٍ فدعني","يكون ببيتِ خمّارٍ رباطي",30,"ط",2,0],["فَإِن رُمتَ جوداً فَلِيَجِئ مِنكَ مُطلَقاً","وَأَكرِمهُ عَن تَقيُّدِهِ بِالمَواعِدِ",31,"د",1,0],["فَإِن رَحَلَت بِالرَغمِ عَن مُستَقَرِّها","فَما كانَ سُكناها لَهُ بِاِختِيارِها",32,"ر",3,0],["فَاِن راقَهُ مَنظَرٌ مَسَّهُ","بِإِثمٍ وَيُؤذيهِ إِن لَم يَرُق",33,"ق",1,0],["فَإِن رَأَيتَ بِوادٍ حَيَّةً ذَكَراً","فَاِمضِ وَدَعني أُمارِس حَيَّةَ الوادي",34,"د",2,0],["فَإِن رَجَعتُ فَرَبُّ الناسِ يُرجِعُني","وَإِن لَحِقتُ بِرَبّي فَابتَغي بَدَلا",35,"ل",2,0],["فإن رأيتَ سيّدي إمْهالي","حتّى أرمَّ من صَلاحِ حالي",36,"ي",1,0],["فإن رجعت إليه ملقياً نظراً","فَقَد تَرى ما يسمى علة العلل",37,"ل",1,0],["فإِنْ رَكِبَتْ منِّي اللَّيَالِي هَضِيمةً","فقَبْلِيَ مَا كانَ اهْتِضَام تَمِيمِ",38,"م",1,0],["فإنْ رأيتَ الجُزءَ لم يَذهب مَعا","بالانتقاصِ فهو وافٍ فاسمعا",39,"ع",2,0],["فَإِنْ رُمْتَ السَّلامَةَ فَاجْتَنِبْنِي","عَدُوَّاً فَالسَّلامَةُ فِي اجْتِنابِي",40,"ب",2,0],["فَإِن رزقت شَفاعَتَهُ","غَداةَ الخَوفِ أَمَّنَها",41,"ن",3,0],["فانْ ردَّ منْ عيبٍ عليَّ جميعهمْ","فليسَ يردُّ العيبُ يحيى بنَ أكثمِ",42,"م",1,0],["فإن رُمتَ جوداً، فليجىء منك مطلقاً","، وأكرِمْهُ عن تقييدِه بالمواعد",43,"د",1,0],["فإن رحلَتْ، بالرّغم، مُستقرّها","، فما كان سُكناها لهُ باختيارها",44,"ر",3,0],["فإِن رأى أنه مما يساعدنا","في الحكم يا قرب ما يلغى القوانينا",45,"ن",2,0],["فَإِن رَضِيَت فَذاكَ وَإِن تَمادَت","فَهَبها خُطَّةً بَلَغَت مَداها",46,"ا",3,0],["فإن رضيتَ بميسورى فهاءِ حُلىً","مَصُوغة بين أفكاري وإنشادي",47,"د",2,0],["فإن رضيت علي أرت محيا","بشوشا بالملاحة ظلّ باد",48,"د",1,0],["فإن رأى أنهم أخطوا أقالهم","وإن رأى أنه دانا الخطا أعتذرا",49,"ر",2,0],["فَإِن رَضِيَت قَومي بِنَقصِي فَلي غِنىً","بِنَفسي وَجَلّابُ المَنايا دَفُوعُها",50,"ع",3,0],["فَإِن رَقَدَت عَينُ الزَمانِ هُنَيئَةً","فَكَم يقظَةٍ مِنهُ أَتَت بِزَوالِ",51,"ل",1,0],["فَإِن رَآكَ مُنعِماً","بِالبِرِّ مِنهُ عادَ لَك",52,"ك",1,0],["فإن رمتها فالتمسْ وصفها","فقدء ميزتْ بصفاتٍ ثمانْ",53,"ن",1,0],["فإن رأيا طفلاً تجشمتِ البكا","على طفلها بعدَ الرضا وتجشما",54,"م",2,0],["فَإِن رَأى عِكرِشاً رَأَيتَ ال","لُعابَ مِن فَكِّهِ يَسيلُ",55,"ل",1,0],["فَإِن رُفِعَت لِلحَربِ وَالجَدبِ رايَةٌ","رَمَوها بِأُسدٍ مِنهُمُ وَشُبولِ",56,"ل",1,0],["فَإِنْ رَمَتْهُ اللَّيَالِي وَهْيَ رَامِيَةٌ","لَمْ يُلْفَ عَنْ هَدَفِ التَّأْيِيدِ طَيَّاشَا",57,"ش",2,0],["فإنْ رَافقْتُ جسْماً في سَرَاحٍ","فَقَد فارَقْتُ قَلْباً في وثاقِ",58,"ق",1,0],["فإن رزئيَ رزءٌ لو بكيت له","دم الحشا ما كفى لو سال أو وكفا",59,"ف",2,0],["فإن راعَكِ ما بي مِنْ","نحولٍ فهو من ذنبك",60,"ك",1,0],["فإنَّ رياضاً أَصبحت كلمي لها","سَواجعُ تُغني عَن ذبابٍ بها زطّا",61,"ط",2,0],["فإن راقَها مِنه اِبتِسام نيوبه","فَقَد راعَها إِذ نبّ أنيابه قبّا",62,"ب",2,0],["فأنر للأنام ما تحجب الأغلال","عنهم والشهوة الرقطاء",63,"ا",2,0],["فان رام من دنيا الفناء تنفساً","يحول زكام الانف ثم يخون",64,"ن",1,0],["فَإِن رَأَفوا عَلى ضَعفي","أُعَدُّ مِنَ الَّذي سُعِدوا",65,"د",3,0],["فَإن رَشَحَت مِن بَعدِهَا لَكَ بَلَّةٌ","مِنَ العَيشِ لَم يَنجَع بِهِ ذَلِكَ الرَّشحُ",66,"ح",1,0],["فإن رُمت خيراً نلت خيراً وإن ترُم","قبيحاً تجده فالحسام على النحر",67,"ر",1,0],["فإِنَّ رياحَنا تجري رُخاءً","تَسوقُ مواكبَ السُّحُبِ الثِّقالِ",68,"ل",1,0],["فإن رمت تأريخاً رأيت عجائباً","ترى آدماً إذ كان هو تراب",69,"ب",1,0],["فإن رامت الأيام عنه انفضاضها","فركب الثنا عن بابه غير منفض",70,"ض",1,0],["فإن رآه أخذاً يقولُ","اللَه هو وهو لهُ الدليلُ",71,"ل",1,0],["فإن راحتكم سنت لنا سننا","أخذ الجزيل بلا من ولا كرب",72,"ب",1,0],["فإِن راقَ أَسماعَ المصيخِينَ مطلعاً","فقد راقَ أسماعَ المُصِيخِينَ مَقْطَعَا",73,"ع",2,0],["فإن ركِبوا فمجتمعُ الأعادي","يفرِّقُ عن جريحِ أو قَتيل",74,"ل",1,0],["فإن رشقتني أسهم البين بالنوى","كما رشقتني أسهم من لحاظك",75,"ك",1,0],["فإِنْ رَمِدَتْ فقليلٌ لِعَيْنٍ","يُقَلِّبُها شَجْوُ قلبٍ كئيبِ",76,"ب",1,0],["فان ريم منه النفع مدّ ظلاله","وساعة يولى النفع فهو جواد",77,"د",1,0],["فإن رأت ذلك ذن","باً إنني لمعتذِرْ",78,"ر",1,0],["فإنَّ رقابَ الأُسْدِ دون عراكها","مصارعُ للآجالِ وهي قِصارُ",79,"ر",1,0],["فإنَّ رؤيا أبي نصْرٍ على كبدي","كالماء ينقعُ مني بالورود صَدى",80,"د",2,0],["فإن رهبَتْكَ البيض والسُّمرُ جرأةً","فقد حسدتك النافحاتُ على النَّشْر",81,"ر",1,0],["فَإِن رُفَّت ثَنَيتُ الطَرفَ عَنها","مَخافَةَ أَن يَتِمَّ لَها جِلاءُ",82,"ا",2,0],["فَإِن رَأى لا أَراهُ اللَهُ نائِبَةً","مِنَ الزَمانِ وَرَعاهُ مِنَ الغيرِ",83,"ر",1,1],["فَإِنَّ رَأي لا رَأي سواءاً وَلا بَرح ال","إِقبال مُشتَمِلاً أَيّامَ دَولَتِهِ",84,"ت",2,1],["فإِنَّ رسولَ اللهِ لم يستَقِمْ له","بمكَّةَ حالٌ واسْتقامَ بيثرِبِ",85,"ب",1,0],["فان رسولَ الله قد قال زَينّوا","بأصواتكم آي الكتاب المطهر",86,"ر",1,0],["فإن رمى وعر العدى بعزمه","في مأزق تسهلت أوعاره",87,"ر",2,0],["فإن رأيت في الكماة حاسراً","فليس فيهم غيره من حاسر",88,"ر",1,0],["فإن ردّني دهري عليك طريدةً","فلا غرو أن يسترجع القوس حاجبُ",89,"ب",1,1],["فإنْ رُمْتَ إسْناداً تَرَاهُ مُحَرّراً","بِهِ لقَدِيمِ الناسِ أو للأَواخِرِ",90,"ر",1,0],["فإنْ رجعوا منها بهُلْكِ نفوسهمْ","فأيديهمُ جرّتْ إليها المهالكا",91,"ك",2,0],["فَإنْ رُمُوا كنتَ تُرساً","وإنْ ورَوْا كنت زندا",92,"د",2,0],["فَإِن رَقا دَمعِي فلم يَبكِهِ","فَلن أُصبِحَ فيمَن بَكى",93,"ا",1,0],["فإن رمت أن تدنو إليها فكن بها","بعيداً ودع إن رمت فهماً لها فهما",94,"م",2,0],["فإن رمت يا أولي سواك محققاً","عليك بك افهم منصفاً أنك الأحرى",95,"ر",2,0],["فإن رأيناه فلا أكل ولا","شرب ولكن صفة الرب الصمود",96,"د",1,0],["فإِنْ رَشَدْت وغَيْرِي في غوايَتِه","جهلاً فإِنِّي بصيرٌ بَيْنَ عُمْيان",97,"ن",1,0],["فإن رمت جاهاً وارتفاعا ورتبةً","ففي العلم ما تهدي له ويشوق",98,"ق",1,0],["فإن رمت النجاة غداً وترجو","نعيماً لا يصير إلى زوال",99,"ل",1,0]]}