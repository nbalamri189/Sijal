iewPoem.aspx?id=50658",""],[5863,"تبدت فتاة القصر في الحلل الخضر","https://www.poetsgate.com/ViewPoem.aspx?id=127111",""],[5881,"يا حامل المصباح","https://www.poetsgate.com/ViewPoem.aspx?id=183774",""],[5939,"جليد","https://www.poetsgate.com/ViewPoem.aspx?id=178606",""],[5943,"خير الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=11258",""],[5943,"إن كان حبي لكم","https://www.poetsgate.com/ViewPoem.aspx?id=34286",""],[5948,"ألا طَرَقتْ أسماءُ أم أنتَ حالِمُ","https://www.poetsgate.com/ViewPoem.aspx?id=100613",""],[5952,"بِكل اتجاهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=200062",""],[5956,"للحب آلاف الصور","https://www.poetsgate.com/ViewPoem.aspx?id=182158",""],[5961,"اضرب عن الناس","https://www.poetsgate.com/ViewPoem.aspx?id=199763",""],[5974,"ابتسامة الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=200334",""],[6023,"حال المثقل ناطقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=123855",""],[6031,"أبا هاشِمٍ إنِّي إلى ما يَنَالُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46411",""],[6068,"بخط القلب -04-","https://www.poetsgate.com/ViewPoem.aspx?id=175912",""],[6090,"يا نجم بلغ سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=170919",""],[6167,"حديث النجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85550&r=&rc=33",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""],[6229,"إنسان أي إنسان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65211&r=&rc=34",""],[463,"تغربْ فالبدار الحبيبة ِ دارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60062&r=&rc=118",""],[6257,"بدويّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87175&r=&rc=0",""],[6259,"إن كنت تصدق في ادعاء وداده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59365&r=&rc=13",""],[2220,"تعجبت من أنثى يقاوم مكرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11173&r=&rc=47",""]],"verses":[["فَإِن رابَكُم ما يَقولُ النَصيحُ","فَسالوا القَنا وَاِستَشيروا الحُساما",0,"م",2,0],["فَإِن راشَني دَهري أَكُن لَكَ بازِياً","يَسُرُّكَ مَحصوراً وَيُرضيكَ مُطلَقا",1,"ق",2,0],["فَإِن رُدَّتِ الأَيامُ بَعدُ وَعاوَدَت","فَلا رُدَّ فيها الأَربِعاءُ وَلا عُدّا",2,"د",2,0],["فَأَنَرْتَ مِنْ ظَلْمَاءِ نَفْسِي مَا دَجَا","وَقَدَحْتَ مِنْ زَنْدِ اصْطِبَارِي مَا خَبَا",3,"ب",2,0],["فَإِنْ رَنَا وَهِلالُ الشَّهْرِ مُبْتَسِمٌ","حَيَّاهُ مِنْ أَمَلٍ فِي الأُفْقِ مُبْتَسِمِ",4,"م",1,0],["فَإِنْ رَوِيَتْ مِنْكَ الْجَوَانِحُ بَهْجَةَ","وَأَظْمَأَهَا وِرْدٌ جَدِيدٌ يُيَمَّمُ",5,"م",1,0],["فَإِن رُدَّ مِن عَيبٍ عَلَيَّ جَميعُهُم","فَلَيسَ يَرُدُّ العَيبَ يَحيى اِبنَ أَكثَمِ",6,"م",1,0],["فإن رزأك عمّ الناس قاطبةً","يا أكرم الناس أعماماً وأخوالا",7,"ل",2,0],["فَإِنَّ رَبيعاً وَالمُشَيَّعَ فَاِعلَما","عَلى مَوطِنٍ لَم يَدرِيا كَيفَ قَدَّرا",8,"ر",2,0],["فإن رسمت بمصر أو دمشق حمى","فأعطِ عبدَكَ في الحالين دستورا",9,"ر",2,0],["فَإِن رُمتُ شَرقاً أَنتَ في الشَرقِ شَرقُهُ","وَإِن رُمتُ غَرباً أَنتَ نُصبُ عِياني",10,"ن",2,0],["فإن رأى كفّاً كريماً زوّجا","جَدوى ترى منها الغِنى مُسْتَنْتَجَا",11,"ج",2,0],["فإن رأى في المنام هفوتهُ","غضّ من الطرف عنه أو شَزره",12,"ر",2,0],["فإن راثَ اللقاءُ فلا تلمني","فإن تخلُّفي عنك انهزامُ",13,"م",1,0],["فَإِن راحَ مِنها ناجِياً بِحُشاشَةٍ","سَتَلقاهُ أُخرى تَحتَويهِ سَعيرُها",14,"ر",3,0],["فَإِن رَفَعتَ بِهِم رَأساً نَعَشتَهُمُ","وَإِن لَقوا مِثلَها في قابِلٍ فَسَدوا",15,"د",3,0],["فإن ردّدتَ بِلَّتَها عليها","افادتهنَّ في النار البقاءَ",16,"ا",2,0],["فإن رمتم الحُملان منه فقطّروا","على القشر محمراً من الدم مثخنا",17,"ن",2,0],["فإِن راشتِ الأيامُ قِدحي فطالما","غدتْ بيدِ الأيامِ تنهِكُهُ بريَا",18,"ي",2,0],["فَإِن رَجَعتَ إِلى حَربٍ فَأَبقِ عَلى","خِلياقِ يَنشو وَبَمٍّ فيهِ لَجلاجِ",19,"ج",1,0],["فَإِنَّ رَواحَكِ الأَتعابُ عِندي","وَتَكليفي لَكِ العُصَبَ العِجالا",20,"ل",2,0],["فإن رِيعَ سِربي أو تُمرِّدَ دونَه","ولم يُنجِني منه الحمايةُ والذَّبُّ",21,"ب",1,0],["فَإِن رُمتُ إِقداماً لَيسَ بِمُمكِنٍ","وَإِن رُمتُ تَأخيراً فَلَيسَ بَواجِبِ",22,"ب",1,0],["فَإِن رَمِدَت أَجفانُ عَينِيَ بِالبُكا","فَكَم جُلِيَت مِنّا بِكَ الأَعيُنُ الرُمدُ",23,"د",1,0],["فأنرتِ لي قلبي وصرتُ كأنما","هذا السواد الجَهمُ غير سواد",24,"د",1,0],["فإنْ رُددتَ فما في الردِّ منقصةٌ","عليكَ قدْ ردَّ موسى قبلُ والخِضرُ",25,"ر",1,0],["فإنْ رنَّحتْ عطفاً فلا يستميلُها","وإنْ سمحت لطفاً قلا يستميحُها",26,"ح",3,0],["فَإِن راجَعَتهُ في التَراسُلِ لَم يَزَل","لَهُ مِن أَعاجيبِ الحَديثِ طَرائِفُ",27,"ف",1,0],["فَإِن رَمى قَرطَسَت بِالسَهمِ نَزعَتُهُ","وَإِن رَأى صادَفَ التَوفيقَ مَنزِعُهُ",28,"ع",2,0],["فَإِن رَأى الخَوفَ أَو هَمَّ الرَقيبُ بِهِ","يُعرَفنَ أَلحاظُهُ في لَحظَةِ الكاسِ",29,"س",1,0],["فإن رابطتَ في ثغرٍ فدعني","يكون ببيتِ خمّارٍ رباطي",30,"ط",2,0],["فَإِن رُمتَ جوداً فَلِيَجِئ مِنكَ مُطلَقاً","وَأَكرِمهُ عَن تَقيُّدِهِ بِالمَواعِدِ",31,"د",1,0],["فَإِن رَحَلَت بِالرَغمِ عَن مُستَقَرِّها","فَما كانَ سُكناها لَهُ بِاِختِيارِها",32,"ر",3,0],["فَاِن راقَهُ مَنظَرٌ مَسَّهُ","بِإِثمٍ وَيُؤذيهِ إِن لَم يَرُق",33,"ق",1,0],["فَإِن رَأَيتَ بِوادٍ حَيَّةً ذَكَراً","فَاِمضِ وَدَعني أُمارِس حَيَّةَ الوادي",34,"د",2,0],["فَإِن رَجَعتُ فَرَبُّ الناسِ يُرجِعُني","وَإِن لَحِقتُ بِرَبّي فَابتَغي بَدَلا",35,"ل",2,0],["فإن رأيتَ سيّدي إمْهالي","حتّى أرمَّ من صَلاحِ حالي",36,"ي",1,0],["فإن رد من فضل العنان توردت","هوي قطاة أتبعتها الأجادل",37,"ل",1,0],["فإن رجعت إليه ملقياً نظراً","فَقَد تَرى ما يسمى علة العلل",38,"ل",1,0],["فإِنْ رَكِبَتْ منِّي اللَّيَالِي هَضِيمةً","فقَبْلِيَ مَا كانَ اهْتِضَام تَمِيمِ",39,"م",1,0],["فإنْ رأيتَ الجُزءَ لم يَذهب مَعا","بالانتقاصِ فهو وافٍ فاسمعا",40,"ع",2,0],["فَإِنْ رُمْتَ السَّلامَةَ فَاجْتَنِبْنِي","عَدُوَّاً فَالسَّلامَةُ فِي اجْتِنابِي",41,"ب",2,0],["فَإِن رزقت شَفاعَتَهُ","غَداةَ الخَوفِ أَمَّنَها",42,"ن",3,0],["فانْ ردَّ منْ عيبٍ عليَّ جميعهمْ","فليسَ يردُّ العيبُ يحيى بنَ أكثمِ",43,"م",1,0],["فإن رُمتَ جوداً، فليجىء منك مطلقاً","، وأكرِمْهُ عن تقييدِه بالمواعد",44,"د",1,0],["فإن رحلَتْ، بالرّغم، مُستقرّها","، فما كان سُكناها لهُ باختيارها",45,"ر",3,0],["فإِن رأى أنه مما يساعدنا","في الحكم يا قرب ما يلغى القوانينا",46,"ن",2,0],["فَإِن رَضِيَت فَذاكَ وَإِن تَمادَت","فَهَبها خُطَّةً بَلَغَت مَداها",47,"ا",3,0],["فإن رضيتَ بميسورى فهاءِ حُلىً","مَصُوغة بين أفكاري وإنشادي",48,"د",2,0],["فإن رضيت علي أرت محيا","بشوشا بالملاحة ظلّ باد",49,"د",1,0],["فإن رأى أنهم أخطوا أقالهم","وإن رأى أنه دانا الخطا أعتذرا",50,"ر",2,0],["فَإِن رَضِيَت قَومي بِنَقصِي فَلي غِنىً","بِنَفسي وَجَلّابُ المَنايا دَفُوعُها",51,"ع",3,0],["فَإِن رَقَدَت عَينُ الزَمانِ هُنَيئَةً","فَكَم يقظَةٍ مِنهُ أَتَت بِزَوالِ",52,"ل",1,0],["فَإِن رَآكَ مُنعِماً","بِالبِرِّ مِنهُ عادَ لَك",53,"ك",1,0],["فإن رمتها فالتمسْ وصفها","فقدء ميزتْ بصفاتٍ ثمانْ",54,"ن",1,0],["فإن رأيا طفلاً تجشمتِ البكا","على طفلها بعدَ الرضا وتجشما",55,"م",2,0],["فَإِن رَأى عِكرِشاً رَأَيتَ ال","لُعابَ مِن فَكِّهِ يَسيلُ",56,"ل",1,0],["فَإِن رُفِعَت لِلحَربِ وَالجَدبِ رايَةٌ","رَمَوها بِأُسدٍ مِنهُمُ وَشُبولِ",57,"ل",1,0],["فَإِنْ رَمَتْهُ اللَّيَالِي وَهْيَ رَامِيَةٌ","لَمْ يُلْفَ عَنْ هَدَفِ التَّأْيِيدِ طَيَّاشَا",58,"ش",2,0],["فإنْ رَافقْتُ جسْماً في سَرَاحٍ","فَقَد فارَقْتُ قَلْباً في وثاقِ",59,"ق",1,0],["فإن رزئيَ رزءٌ لو بكيت له","دم الحشا ما كفى لو سال أو وكفا",60,"ف",2,0],["فإن راعَكِ ما بي مِنْ","نحولٍ فهو من ذنبك",61,"ك",1,0],["فإنَّ رياضاً أَصبحت كلمي لها","سَواجعُ تُغني عَن ذبابٍ بها زطّا",62,"ط",2,0],["فإن راقَها مِنه اِبتِسام نيوبه","فَقَد راعَها إِذ نبّ أنيابه قبّا",63,"ب",2,0],["فأنر للأنام ما تحجب الأغلال","عنهم والشهوة الرقطاء",64,"ا",2,0],["فان رام من دنيا الفناء تنفساً","يحول زكام الانف ثم يخون",65,"ن",1,0],["فَإِن رَأَفوا عَلى ضَعفي","أُعَدُّ مِنَ الَّذي سُعِدوا",66,"د",3,0],["فَإن رَشَحَت مِن بَعدِهَا لَكَ بَلَّةٌ","مِنَ العَيشِ لَم يَنجَع بِهِ ذَلِكَ الرَّشحُ",67,"ح",1,0],["فإن رُمت خيراً نلت خيراً وإن ترُم","قبيحاً تجده فالحسام على النحر",68,"ر",1,0],["فإِنَّ رياحَنا تجري رُخاءً","تَسوقُ مواكبَ السُّحُبِ الثِّقالِ",69,"ل",1,0],["فإن رمت تأريخاً رأيت عجائباً","ترى آدماً إذ كان هو تراب",70,"ب",1,0],["فإن رامت الأيام عنه انفضاضها","فركب الثنا عن بابه غير منفض",71,"ض",1,0],["فإن رآه أخذاً يقولُ","اللَه هو وهو لهُ الدليلُ",72,"ل",1,0],["فإن راحتكم سنت لنا سننا","أخذ الجزيل بلا من ولا كرب",73,"ب",1,0],["فإِن راقَ أَسماعَ المصيخِينَ مطلعاً","فقد راقَ أسماعَ المُصِيخِينَ مَقْطَعَا",74,"ع",2,0],["فإن ركِبوا فمجتمعُ الأعادي","يفرِّقُ عن جريحِ أو قَتيل",75,"ل",1,0],["فإن رشقتني أسهم البين بالنوى","كما رشقتني أسهم من لحاظك",76,"ك",1,0],["فإِنْ رَمِدَتْ فقليلٌ لِعَيْنٍ","يُقَلِّبُها شَجْوُ قلبٍ كئيبِ",77,"ب",1,0],["فان ريم منه النفع مدّ ظلاله","وساعة يولى النفع فهو جواد",78,"د",1,0],["فإن رأت ذلك ذن","باً إنني لمعتذِرْ",79,"ر",1,0],["فإنَّ رقابَ الأُسْدِ دون عراكها","مصارعُ للآجالِ وهي قِصارُ",80,"ر",1,0],["فإنَّ رؤيا أبي نصْرٍ على كبدي","كالماء ينقعُ مني بالورود صَدى",81,"د",2,0],["فإن رهبَتْكَ البيض والسُّمرُ جرأةً","فقد حسدتك النافحاتُ على النَّشْر",82,"ر",1,0],["فَإِن رُفَّت ثَنَيتُ الطَرفَ عَنها","مَخافَةَ أَن يَتِمَّ لَها جِلاءُ",83,"ا",2,0],["فَإِن رَأى لا أَراهُ اللَهُ نائِبَةً","مِنَ الزَمانِ وَرَعاهُ مِنَ الغيرِ",84,"ر",1,1],["فَإِنَّ رَأي لا رَأي سواءاً وَلا بَرح ال","إِقبال مُشتَمِلاً أَيّامَ دَولَتِهِ",85,"ت",2,1],["فإِنَّ رسولَ اللهِ لم يستَقِمْ له","بمكَّةَ حالٌ واسْتقامَ بيثرِبِ",86,"ب",1,0],["فان رسولَ الله قد قال زَينّوا","بأصواتكم آي الكتاب المطهر",87,"ر",1,0],["فإن رمى وعر العدى بعزمه","في مأزق تسهلت أوعاره",88,"ر",2,0],["فإن رأيت في الكماة حاسراً","فليس فيهم غيره من حاسر",89,"ر",1,0],["فإن ردّني دهري عليك طريدةً","فلا غرو أن يسترجع القوس حاجبُ",90,"ب",1,1],["فإنْ رُمْتَ إسْناداً تَرَاهُ مُحَرّراً","بِهِ لقَدِيمِ الناسِ أو للأَواخِرِ",91,"ر",1,0],["فإنْ رجعوا منها بهُلْكِ نفوسهمْ","فأيديهمُ جرّتْ إليها المهالكا",92,"ك",2,0],["فَإنْ رُمُوا كنتَ تُرساً","وإنْ ورَوْا كنت زندا",93,"د",2,0],["فَإِن رَقا دَمعِي فلم يَبكِهِ","فَلن أُصبِحَ فيمَن بَكى",94,"ا",1,0],["فإن رمت أن تدنو إليها فكن بها","بعيداً ودع إن رمت فهماً لها فهما",95,"م",2,0],["فإن رمت يا أولي سواك محققاً","عليك بك افهم منصفاً أنك الأحرى",96,"ر",2,0],["فإن رأيناه فلا أكل ولا","شرب ولكن صفة الرب الصمود",97,"د",1,0],["فإِنْ رَشَدْت وغَيْرِي في غوايَتِه","جهلاً فإِنِّي بصيرٌ بَيْنَ عُمْيان",98,"ن",1,0],["فإن رمت جاهاً وارتفاعا ورتبةً","ففي العلم ما تهدي له ويشوق",99,"ق",1,0],["فإن رمت النجاة غداً وترجو","نعيماً لا يصير إلى زوال",100,"ل",1,0],["فإِن رُمتَ