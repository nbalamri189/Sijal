{"poems":[[53,"ضربن إلينا خدودا وساما","https://www.aldiwan.net/poem29807.html","المتقارب"],[53,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[55,"ألا فانظري بالله يا سكني الوعدا","https://www.aldiwan.net/poem26406.html","الطويل"],[77,"خطب ألم فأذهب الأخ والأبا","https://www.aldiwan.net/poem36779.html","الكامل"],[93,"ماذا تصباك من حال تجددها","https://www.aldiwan.net/poem11314.html","البسيط"],[93,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[54,"ألا فاشتروا مني ملوك المخرم","https://www.aldiwan.net/poem27375.html","الطويل"],[88,"أزمعت عنا إلى مولاك ترحالا","https://www.aldiwan.net/poem45053.html","البسيط"],[27,"لمن رسم دار هم أن يتغيرا","https://www.aldiwan.net/poem5761.html","الطويل"],[72,"خلفت بالقلب بيتا منك معمورا","https://www.aldiwan.net/poem18733.html","البسيط"],[64,"رقيبان مني شاهدان لحبه","https://www.aldiwan.net/poem67600.html","الطويل"],[51,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[70,"لها خفر يوم اللقاء خفيرها","https://www.aldiwan.net/poem42923.html","الطويل"],[38,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[62,"إذا ما الأرض لم تنخل مرارا","https://www.aldiwan.net/poem52177.html","الوافر"],[62,"هلموا إذا ما خفتهم الفقر فاصعدوا","https://www.aldiwan.net/poem52185.html","الطويل"],[62,"أطامن عن أيدي العفاة تكرما","https://www.aldiwan.net/poem52246.html","الطويل"],[45,"كنت إلى وصل سعدى جد محتاج","https://www.aldiwan.net/poem62673.html","البسيط"],[28,"أحب من النساء وهن شتى","https://www.aldiwan.net/poem5414.html","الوافر"],[61,"نسالم هذا الدهر وهو لنا حرب","https://www.aldiwan.net/poem51800.html","الطويل"],[66,"أخاف مع الترداد تقطيب حاجب","https://www.aldiwan.net/poem38684.html","الطويل"],[66,"صروف الليالي لا يدوم لها عهد","https://www.aldiwan.net/poem40127.html","الطويل"],[97,"يا مية الحسناء هل يغزو الهوى","https://www.aldiwan.net/poem24867.html","الكامل"],[69,"أيبست أفئدة بالحزن يا خضر","https://www.aldiwan.net/poem28056.html","البسيط"],[69,"خليلي هل من رقدة أستريحها","https://www.aldiwan.net/poem28555.html","الطويل"],[31,"أفي رسم دار دارس أنت واقف","https://www.aldiwan.net/poem42225.html","الطويل"],[81,"لله سر جمال أنت موضعه","https://www.aldiwan.net/poem61462.html","البسيط"],[52,"يا طول شوقي إلى تسليم مقلته","https://www.aldiwan.net/poem26921.html","البسيط"],[48,"إذا ولج البعير فروغ صبري","https://www.aldiwan.net/poem66271.html","الوافر"],[46,"خطوب تألت لا يزال معذبا","https://www.aldiwan.net/poem22447.html","الطويل"],[46,"لنفسي إن تنأ عن الجسم روعة","https://www.aldiwan.net/poem22657.html","الطويل"],[46,"ظهور الركاب عند اللبيب","https://www.aldiwan.net/poem23059.html","المتقارب"],[15,"طاف الخيال علينا ليلة الوادي","https://www.aldiwan.net/poem45273.html","البسيط"],[8,"باتت تذكرني بالله قاعدة","https://www.aldiwan.net/poem21822.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85351","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30489","الطويل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42533","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43755","الوافر"],[54,"أَلاَ فاشترُوا مِنِّي مُلوكَ المخرِّمِ","https://www.poetsgate.com/ViewPoem.aspx?id=14090",""],[46,"خطوبٌ تألّت: لا يزالُ، معذَّباً،","https://www.poetsgate.com/ViewPoem.aspx?id=18549",""],[46,"لِنَفسيَ، إن تَنْأ عن الجسم، رَوْعةٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=20233",""]],"verses":[["فَإِن رابَكُم ما يَقولُ النَصيحُ","فَسالوا القَنا وَاِستَشيروا الحُساما",0,"م",2,0],["فَإِن راشَني دَهري أَكُن لَكَ بازِياً","يَسُرُّكَ مَحصوراً وَيُرضيكَ مُطلَقا",1,"ق",2,0],["فَإِن رُدَّتِ الأَيامُ بَعدُ وَعاوَدَت","فَلا رُدَّ فيها الأَربِعاءُ وَلا عُدّا",2,"د",2,0],["فَأَنَرْتَ مِنْ ظَلْمَاءِ نَفْسِي مَا دَجَا","وَقَدَحْتَ مِنْ زَنْدِ اصْطِبَارِي مَا خَبَا",3,"ب",2,0],["فَإِنْ رَنَا وَهِلالُ الشَّهْرِ مُبْتَسِمٌ","حَيَّاهُ مِنْ أَمَلٍ فِي الأُفْقِ مُبْتَسِمِ",4,"م",1,0],["فَإِنْ رَوِيَتْ مِنْكَ الْجَوَانِحُ بَهْجَةَ","وَأَظْمَأَهَا وِرْدٌ جَدِيدٌ يُيَمَّمُ",5,"م",1,0],["فَإِن رُدَّ مِن عَيبٍ عَلَيَّ جَميعُهُم","فَلَيسَ يَرُدُّ العَيبَ يَحيى اِبنَ أَكثَمِ",6,"م",1,0],["فإن رزأك عمّ الناس قاطبةً","يا أكرم الناس أعماماً وأخوالا",7,"ل",2,0],["فَإِنَّ رَبيعاً وَالمُشَيَّعَ فَاِعلَما","عَلى مَوطِنٍ لَم يَدرِيا كَيفَ قَدَّرا",8,"ر",2,0],["فإن رسمت بمصر أو دمشق حمى","فأعطِ عبدَكَ في الحالين دستورا",9,"ر",2,0],["فَإِن رُمتُ شَرقاً أَنتَ في الشَرقِ شَرقُهُ","وَإِن رُمتُ غَرباً أَنتَ نُصبُ عِياني",10,"ي",1,0],["فإن رأى كفّاً كريماً زوّجا","جَدوى ترى منها الغِنى مُسْتَنْتَجَا",11,"ج",2,0],["فإن رأى في المنام هفوتهُ","غضّ من الطرف عنه أو شَزره",12,"ر",2,0],["فإن راثَ اللقاءُ فلا تلمني","فإن تخلُّفي عنك انهزامُ",13,"م",1,0],["فَإِن راحَ مِنها ناجِياً بِحُشاشَةٍ","سَتَلقاهُ أُخرى تَحتَويهِ سَعيرُها",14,"ر",3,0],["فَإِن رَفَعتَ بِهِم رَأساً نَعَشتَهُمُ","وَإِن لَقوا مِثلَها في قابِلٍ فَسَدوا",15,"د",3,0],["فإن ردّدتَ بِلَّتَها عليها","افادتهنَّ في النار البقاءَ",16,"ا",2,0],["فإن رمتم الحُملان منه فقطّروا","على القشر محمراً من الدم مثخنا",17,"ن",2,0],["فإِن راشتِ الأيامُ قِدحي فطالما","غدتْ بيدِ الأيامِ تنهِكُهُ بريَا",18,"ي",2,0],["فَإِن رَجَعتَ إِلى حَربٍ فَأَبقِ عَلى","خِلياقِ يَنشو وَبَمٍّ فيهِ لَجلاجِ",19,"ج",1,0],["فَإِنَّ رَواحَكِ الأَتعابُ عِندي","وَتَكليفي لَكِ العُصَبَ العِجالا",20,"ل",2,0],["فإن رِيعَ سِربي أو تُمرِّدَ دونَه","ولم يُنجِني منه الحمايةُ والذَّبُّ",21,"ب",1,0],["فَإِن رُمتُ إِقداماً لَيسَ بِمُمكِنٍ","وَإِن رُمتُ تَأخيراً فَلَيسَ بَواجِبِ",22,"ب",1,0],["فَإِن رَمِدَت أَجفانُ عَينِيَ بِالبُكا","فَكَم جُلِيَت مِنّا بِكَ الأَعيُنُ الرُمدُ",23,"د",1,0],["فأنرتِ لي قلبي وصرتُ كأنما","هذا السواد الجَهمُ غير سواد",24,"د",1,0],["فإنْ رُددتَ فما في الردِّ منقصةٌ","عليكَ قدْ ردَّ موسى قبلُ والخِضرُ",25,"ر",1,0],["فإنْ رنَّحتْ عطفاً فلا يستميلُها","وإنْ سمحت لطفاً قلا يستميحُها",26,"ح",3,0],["فَإِن راجَعَتهُ في التَراسُلِ لَم يَزَل","لَهُ مِن أَعاجيبِ الحَديثِ طَرائِفُ",27,"ف",1,0],["فَإِن رَمى قَرطَسَت بِالسَهمِ نَزعَتُهُ","وَإِن رَأى صادَفَ التَوفيقَ مَنزِعُهُ",28,"ع",2,0],["فَإِن رَأى الخَوفَ أَو هَمَّ الرَقيبُ بِهِ","يُعرَفنَ أَلحاظُهُ في لَحظَةِ الكاسِ",29,"س",1,0],["فإن رابطتَ في ثغرٍ فدعني","يكون ببيتِ خمّارٍ رباطي",30,"ي",1,0],["فَإِن رُمتَ جوداً فَلِيَجِئ مِنكَ مُطلَقاً","وَأَكرِمهُ عَن تَقيُّدِهِ بِالمَواعِدِ",31,"د",1,0],["فَإِن رَحَلَت بِالرَغمِ عَن مُستَقَرِّها","فَما كانَ سُكناها لَهُ بِاِختِيارِها",32,"ر",3,0],["فَاِن راقَهُ مَنظَرٌ مَسَّهُ","بِإِثمٍ وَيُؤذيهِ إِن لَم يَرُق",33,"ق",1,0],["فَإِن رَأَيتَ بِوادٍ حَيَّةً ذَكَراً","فَاِمضِ وَدَعني أُمارِس حَيَّةَ الوادي",34,"ي",1,0],["فَإِن رَجَعتُ فَرَبُّ الناسِ يُرجِعُني","وَإِن لَحِقتُ بِرَبّي فَابتَغي بَدَلا",35,"ل",2,0],["فإن رأيتَ سيّدي إمْهالي","حتّى أرمَّ من صَلاحِ حالي",36,"ي",1,0],["فإن رجعت إليه ملقياً نظراً","فَقَد تَرى ما يسمى علة العلل",37,"ل",1,0],["فإِنْ رَكِبَتْ منِّي اللَّيَالِي هَضِيمةً","فقَبْلِيَ مَا كانَ اهْتِضَام تَمِيمِ",38,"م",1,0],["فإنْ رأيتَ الجُزءَ لم يَذهب مَعا","بالانتقاصِ فهو وافٍ فاسمعا",39,"ع",2,0],["فَإِنْ رُمْتَ السَّلامَةَ فَاجْتَنِبْنِي","عَدُوَّاً فَالسَّلامَةُ فِي اجْتِنابِي",40,"ي",1,0],["فَإِن رزقت شَفاعَتَهُ","غَداةَ الخَوفِ أَمَّنَها",41,"ن",3,0],["فانْ ردَّ منْ عيبٍ عليَّ جميعهمْ","فليسَ يردُّ العيبُ يحيى بنَ أكثمِ",42,"م",1,0],["فإن رُمتَ جوداً، فليجىء منك مطلقاً","، وأكرِمْهُ عن تقييدِه بالمواعد",43,"د",1,0],["فإن رحلَتْ، بالرّغم، مُستقرّها","، فما كان سُكناها لهُ باختيارها",44,"ر",3,0]]}