ا","https://www.poetsgate.com/ViewPoem.aspx?id=46278",""],[6034,"الدهر لا يبرح خوانا","https://www.poetsgate.com/ViewPoem.aspx?id=169609",""],[6049,"اسمن عذارك","https://www.poetsgate.com/ViewPoem.aspx?id=35631",""],[6070,"صوَّرْتُها قَمَراً في دَوحَةِ الشَّجَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=189786",""],[6102,"صَنَم !!","https://www.poetsgate.com/ViewPoem.aspx?id=184433",""],[6120,"أَنتِ أَمَانِينَا","https://www.poetsgate.com/ViewPoem.aspx?id=213548",""],[6152,"أبتاه 3","https://www.poetsgate.com/ViewPoem.aspx?id=204879",""],[6170,"دمشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86030&r=&rc=1",""],[6185,"أوصل سلامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87028&r=&rc=14",""],[1583,"القبلة الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73011&r=&rc=2",""],[6285,"أغنيات على أبواب القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86824&r=&rc=17",""],[6355,"يا وطني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66661&r=&rc=121",""]],"verses":[["يا قَبرُ بَينَ القَورِ وَالدِعاصِ","ضُمَّ عَلى لُؤلُؤَةِ الغَوّاصِ",0,"ص",1,0],["يا قَبرُ أَمنَحُهُ الهَوى وَأَوَدُّ لَو","نَزَفَت عَلَيهِ دُموعُ كُلِّ سَماءِ",1,"ا",2,0],["يا قِبلَةَ القُصّادِ يا تاجَ العُل","يا بَدرَ هَذا العَصرِ في كيوانِهِ",2,"ن",2,0],["يا قَبرَ سَيّدِنا المجنِّ سَماحه","صَلّى عَلَيكَ اللَهُ يا قَبرُ",3,"ر",1,0],["يا قَبرُ وَيحَكَ ما صَنَع","تَ بِوَجهِهِ المُتَهَلِّلِ",4,"ل",1,0],["يا قَبرُ هَل لَعِبَ البِلى","بِلِطافِ تِلكَ الأَنمُلِ",4,"ل",1,0],["يا قَبرُ ضَيفُكَ بَينَنا","قَد كانَ خَيرَ مُؤَمَّلِ",4,"ل",1,0],["يا قَبرَهُ العَطِرَ الثَرى لا يَبعَدَن","حُلوٌ مِنَ الفِتيانِ فيكَ حَلالُ",5,"ل",1,0],["يا قَبَّحَ اللَهُ عَبداً مِن بَني لَجَإٍ","يَأوي إِلى نِسوَةٍ رُصعٍ مَداريمِ",6,"م",1,0],["يا قُبحَها مُقبِلَةً","وَقُبحَها مُوَلِّيَه",7,"ي",2,0],["يا قبر شوقي إنني من أدمعي","مهد إليك قصائدا عطرات",8,"ت",1,0],["يا قبر ليلى انت تحوي","فيك زنبقة كعابا",9,"ب",2,0],["يا قبر فوزي سلاماً بعد تكرمة","اليك يهديه من بغداد لهفان",10,"ن",1,0],["يا قُبَّةَ الغوري تَحتَكِ مَأتَمٌ","تَبقى شَعائِرُهُ عَلى الأَدهارِ",11,"ر",1,0],["يا قَبْرَ فاطِمَةَ الّذي مَا مِثْلُهْ","قَبْرٌ بطَيْبَةَ طابَ فيهِ مَبِيتَا",12,"ت",2,1],["يا قبرُ أُفْرِغَ فيك سَجْلٌ من نَدَىً","فالْبسْ له حُلَلَ الرِّياضِ وأمْرِعِ",13,"ع",1,0],["يا قبرُ غاضَ البحرُ فيك فلا تدَعْ","للناس حولَكَ غُلَّةً لم تُنْقَعِ",13,"ع",1,0],["يا قبرُ غاب البدرُ فيك فلا تكنْ","من بعدِه إِلّا مُنيرَ المطلَعِ",13,"ع",1,0],["يا قَبرَ يَحيى لا عَدِمتَ تَحِيَّةً","مِن كُلِّ ذاتِ تَبَسُّمٍ وَتَرَنُّمِ",14,"م",1,1],["يا قِبلة الحب الخفي","وكعبة الأمل الدفين",15,"ن",1,0],["يا قَبُولاً قد جلا صيقَلُهُ","صدأً عن صفحةِ الماءِ الصقيلِ",16,"ل",1,0],["يا قُبَّةَ المُختارِ دُونَكِ ما بَنَى","في مُلكِهِ كِسْرَى وشيَّدَ قيصرُ",17,"ر",1,0],["يا قبر أخبرني فإنك عارف","أَيَطول فيك من الوَلي ثواء",18,"ا",2,0],["يا قبر إسماعيل إنك كعبة","ما بالقَليل حجيجها لطواف",19,"ف",1,0],["يا قبر إسماعيل حولك أُمَّة","تَبكي أديباً في ظلالك غافي",19,"ف",2,0],["يا قبرُ لم تُبْصركَ عيني ولا","رأتك إلَّا في ثنايا الخيالْ",20,"ل",1,0],["يا قِبلَةَ القُصّادِ يا تاجَ العُلا","يا بَدرَ هَذا العَصرِ في كيوانِهِ",21,"ن",2,0],["يا قَبرَهُ وَمَنزِلي","حَسبي البُكا هُنا وَثُم",22,"م",1,0],["يا قبرَ حفني أَجبْني","ماذا صنعتَ بحفني",23,"ن",2,1],["يا قبرَ حفني أجبني","وارحم بقيّةَ سنّي",23,"ن",2,0],["يا قبرُ من لم يَمتَهِنْ بضَراعةٍ","باد عليك تضرُّعي وخُشُوعي",24,"ع",2,0],["يا قبر أيوب الذي نوره","حل بقلبي ذروة الطور",25,"ر",1,1],["يا قبرَ آمالِ نفسي في ثَرى كَبِدي","يسقيكَ صضوبُ دَمٍ من قَلبيَ القاسي",26,"س",2,0],["يا قَبرَ شَمس الفَضلِ لا زالَت بِكَ الر","رَحماتُ بِالغَدَواتِ وِالآصالِ",27,"ل",1,0],["يا قبر أضنانا البكاءُ وتبسمُ","أدريت أن الفضل فيك مخيمُ",28,"م",1,1],["يا قُبحَ آرائِهِم فينا فَلو عَرَفُوا","حَقَّ السَوابِقِ ما اِختارُوا البَراذِينا",29,"ن",2,0],["يا قَبرَ جرجسَ مِن تُربٍ وَمِن حَجَرٍ","ما أَنصَفَ البَدرُ ذاكَ التُّربَ وَالحَجَرُ",30,"ر",1,0],["يا قبر كيف وسعت منه سحابةً","وطفاءَ ساحبة الذيول هطولا",31,"ل",2,0],["يا قبر قد واريت طوداً باذخاً","عجباً لطود ساخ في وسط الثرى",32,"ر",2,0],["يا قبوراً تربَّعَ الوَحيُ فيها","لَيسَ مَن فيكِ صائِراً لِلفَناءِ",33,"ا",2,0],["يا قِبلَتي جُدلي بِقُبلَه","تطفي جَوىً وَتَبلُ غُلَّه",34,"ل",2,1],["يا قَبْرُ ما لِلْمَجْدِ عِنْدَكَ فَاحْتَفِظْ","بِمُهَنَّدٍ ما كُنْتَ مِنْ أَغْمادِهِ",35,"ه",1,1],["يا قبرُ لم تدر ما ضمّنتَ من شرفٍ","عالٍ تفرَّع من (فهر) و(عدنان)",36,"ن",1,0],["يا قبر تجاف الارض عن مضجعه","ما يصلح ذاك الوجه للتعذيب",37,"ب",1,0],["يا قبرُ قَد أُودِعت منه طيّباً","حيّاً وميتاً فاِدر من تستودعُ",38,"ع",1,0],["يا قَبرُ أنتَ الآنَ روضةُ جنّةٍ","مَن مرّ حولكَ فليزر وليرتعِ",39,"ع",1,0],["يا قبرُ إنّكَ قَد سُقيتَ بوجههِ","فَاِشكرهُ وَاِستبشر بهِ وتوسّعِ",39,"ع",1,0],["يا قبرُ كيفَ سعدتَ أنتَ بقربهِ","دونَ البقاعِ فكنتَ أكرم موضعِ",39,"ع",1,0],["يا قبرُ أيُّ وديعةٍ أودعتها","فَكن الأمينَ وخف من المستودعِ",39,"ع",1,0],["يا قبرُ تفترشُ الترابَ لجنبهِ","وَلخدّهِ أخشِن به من مضجعِ",39,"ع",1,0],["يا قَبرُ لا تبلغ إِليه مُصابنا","فَتروعُه قَد كان غير مروّعِ",39,"ع",1,0],["يا قبرُ مَن للمُعضلات فليلُها","داجٍ وبدرُ كمالهِ لم يطلعِ",39,"ع",1,0],["يا قبرُ إنّك إن طَويتَ علومهُ","لَم تطوِ نشرَ ثنائه المتضوّعِ",39,"ع",1,0],["ياقُبْحَها مِن عَجْوزٍ صَدْرُها قَفَصٌ","وَثَغْرُها أسْوَدٌ والشَّعْرُ ذُو بَرَصِ",40,"ص",1,1],["يا قبة الميثاق أنت صلحُنا","مع ربنا والشرحُ فيك يطول",41,"ل",1,0],["يا قُبَّةَ العَهدِ التي قد ضَمَّها","موسى الكليمُ لشَعبهِ الخَطّاءِ",42,"ا",2,0],["يا قَبَّحَ اللَهُ أُمَّةً خَذَلَت","سَيِّدَها لا تُريدُ مَرضاهُ",43,"ا",2,0],["يا قبَّة المسجِدِ الأقصى أراكِ على","مرمى الحَصاةِ،وقدْ أُحْكِمتِ إغلاقا",44,"ق",2,0],["يا قبر أحمد كم حَوَيْتَ","مَكارماً ومحامدا",45,"د",2,1],["يا قبر جادكَ وابلُ الرّضوانِ","واستَوطَنتكَ عَواطفُ الغُفرانِ",46,"ن",1,1],["يا قبرُ فيك المرتضَى","والسَيّدُ السَّندُ الكريمُ",47,"م",1,0],["يا قبور الأحباب هل من مجيب","إن دعاكم دمع الحزين ونادى",48,"د",2,1],["يا قبرُ هَلْ عَلِمْتَ مَن ضَمَمْتَهُ","ومَنْ عَليه تنطوي جَوانحُكْ",49,"ك",1,1],["يا قبرَ محمود لا جازَتْك غاديةٌ","تَسقي ثَراكَ بصَوْبٍ غير مفقودِ",50,"د",1,1],["يا قِبْلَةً لِلآمِلينَ وَكَعْبَةً","تَدْعُو بِحَيّ عَلَى النَّدَى حُجَّاجَها",51,"