{"poems":[[91,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[104,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[376,"لم تستمع سره من كل ملتمس","https://www.aldiwan.net/poem57354.html","البسيط"],[447,"لا يدرك المجد من لم يجعل السببا","https://www.aldiwan.net/poem14345.html","البسيط"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45563","الرجز"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129352","الخفيف"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125927","السريع"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44892","الرمل"]],"verses":[["منكدة قد طالبتك بحقها","فلو كنت تقضي سؤلها كنت تعذل",0,"ل",1,0],["منكَ دَمع وَمِن محبك دَمع","بَرَدى وَالمُحبّ مُتَفِقان",1,"ن",1,0],["من كدت حجركَ في خَضراء من غَدَقٍ","وكان بالأمسِ في شَهباء من بلَسِ",2,"س",1,0],["من كد في مبلغ العلياء مهجته","عزت فلم يخش إذلالاً ولا لغبا",3,"ب",2,0],["مِن كَدرٍ يُنجاب عَن صَفاء","تَقشع الغَيم عَن السَماء",4,"ا",2,0],["منك دارت رحى المنون عليهم","وغدا جمعهم كحب الحصيد",5,"د",1,0],["منكد الحظ كثير الجلد","يخاله الرائي خيال الأبد",6,"د",1,1],["مِنكَ دائي وَبيُمناكَ الدَواء","وَبِكَفَّيكَ حَياتي وَمَماتي",7,"ي",1,0]]}