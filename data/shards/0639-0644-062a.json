5897,"رمضان يستعيد الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=156849",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""],[6056,"حمامة الأفكار","https://www.poetsgate.com/ViewPoem.aspx?id=130504",""],[6115,"ياما كليت من الليالي مقاليب","https://www.poetsgate.com/ViewPoem.aspx?id=180521",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""],[6187,"نبضُ الحكمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82478&r=&rc=1",""],[6222,"يا تائهون على الدروب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1930&r=&rc=1",""]],"verses":[["عَلَت أَصواتُهُم صَوتي وَلَكِن","صَهيلُ الخَيلِ يُطرِقُ لِلهَريرِ",0,"ر",1,0],["علت أمة الغرب السماء وأشرفت","علينا فظلَنا ننظر القوم من تحت",1,"ت",1,0],["عَلَتكَ أَواذِيٌّ مِنَ البَحرِ فَاِقتَبِض","بِكَفَّيكَ فَاِنظُر أَيَّ لُجَّيهِ تَقدَحُ",2,"ح",1,0],["علتْ حالاه من سُخْطٍ","وَمَرْضَاةٍ عن المزحِ",3,"ح",1,0],["علتْ ذُرَاها والأصولُ رُسَّخُ","ما أطوع البذْخَ له لو يَبْذَخُ",4,"خ",1,0],["عَلَتْهُ وحشةٌ بهمُ","وأصبح نورهُ باخا",5,"خ",2,0],["علتْ وأضاءتْ للعيونِ وربّما","غدا كلُّ طرْفٍ وهْو عنها مُفَلّلُ",6,"ل",1,0],["عَلَتها بُحورٌ مِن أُمَيَّةَ تَرتَقي","ذُرا هَضبَةٍ ما فَرعُها بِقَصيرِ",7,"ر",1,0],["عَلَتني مِن السَخطِ الأَليم سَحابَةٌ","فَأغرَبُها ريحُ الرِضى كَي تَقَشَّعا",8,"ع",2,0],["عَلَت فَوقَ بَغراسٍ فَضاقَت بِما جَنَت","صُدورُ رِجالٍ حينَ ضاقَ بِها الدَربُ",9,"ب",1,0],["عَلَت هاشِمٌ مِن بَعدِ ذَلِكَ كُلِّهِ","سَنامَ العُلا فَوقَ الذُرى وَالغَوارِبِ",10,"ب",1,0],["عَلَت يَدٌ لِلعَلاءِ مُفضِلَةٌ","كَما تَعَلّى مِن عارِضٍ مُزُنُه",11,"ن",2,0],["عَلَت كَفُّكَ اليُمنى طِعاناً وَنائِلاً","يَدَي كُلِّ مِعطاءٍ وَقِرنٍ تُساوِرُه",12,"ر",2,0],["علت خيلُنا منها جليداً فلم يُتَحْ","بِنا للعدى من عَدوهِنَّ عجاجُ",13,"ج",1,0],["عَلتْ قُبَّةُ الإسلامِ واعتزَّ جندُه","فَمِن شَرَفٍ وافٍ ومن سُؤْددٍ جَمِّ",14,"م",1,0],["عَلَتِ الأَيدي بِأَجوازٍ لَها","رُحُبِ الأَجوافِ ما إِن تَنبَهِر",15,"ر",1,0],["عُلَّت بهِ قَرقَفٌ سُلاَفَةُ إِس","فِنطٍ عُقارٌ قَلِيلَةُ النَدَمِ",16,"م",1,0],["عَلَتْ شَمْسُ الضُّحى وَالرَّوْضُ زَاهٍ","وَفِيهِ نَضَارَةٌ وَسَنىً وَمَاءُ",17,"ا",2,0],["عِلَّتُهُ أَلِيمَةٌ","تُذِيبُ قَلْبِي كَمَدَا",18,"د",2,0],["علت بِهِ دَرَجَات الْفضل واتضحت","دقائق من مَعَاني لَفظه البهج",19,"ج",1,1],["علت الوجوه الواضحات كآبة","ومحا الذبول نضارة الأوراد",20,"د",1,0],["عَلَتني مِن السُّخطِ الأَليم سَحابَةٌ","فَأَغْرِ بها ريحَ الرِّضا كَي تَقَشَّعا",21,"ع",2,0],["علَتْ أمَّة الغرب السماءَ وأشرقتْ","علينا فظَلنا نَنظر القوم من تحت",22,"ت",1,0],["علت من الابوين الانجبين له","من هاشم نسبة كالصبح حين جلي",23,"ل",2,0],["علت أحوال دولته مكاناً","فكان هو المكين بكل مرصد",24,"د",1,0],["عَلَتِ الدُسوتُ بِهِ وَقِدماً شُرِّفَت","مِنهُ المَنابِرُ بِالخَطيبِ المِصقَعِ",25,"ع",1,0],["عَلَت جَدواكَ أَقوالي وَقِدماً","عَلَوتُ المُنعِمينَ بِما أَقولُ",26,"ل",1,0],["عَلَت وَغَلَت عَلى مُتَطَلِّبيها","لِتَأمَنَ أَن تُسامى أَو تُساما",27,"م",2,0],["عَلَتْ نَفَحَاتُهُ سَبَقََتْ بِعِطْرٍٍ","وَهَفْهَفَتِ النَّسَائِمُ ، وَالجِنَانُ",28,"ن",1,0],["عَلَتِ النُجومَ بُرُوجُها فَكَأَنّما","عَقَدت أَكاليلاً عَلى شُرُفاتِها",29,"ت",3,0],["عَلت في كلِّ أرضٍ كلّ دينٍ","وَدينُ اللَّه يعلو ليس يعلى",30,"ل",2,0],["عَلت فتعالت كلُّ نفسٍ بحبِّها","فنفسي لها من دارةِ الحمل العلو",31,"ل",2,0],["علت وَغلت الاعليك فأرخصت","لترخص حور في القصور قصور",32,"ر",1,0],["علتِ المِلْحَ الأُجاجَ فَما","شِئْتَ مِنْ تَشْمير وَتَشْمِيلِ",33,"ل",1,0],["عُلتَ اليَتامى وَالأَرامِلَ جائِداً","إِذ لَم تِكُن جودٌ يُرى مَوجودا",34,"د",2,0],["علت بسمة شفتيك العذاب","وقد هجم الموت لا يردع",35,"ع",1,0],["عَلَت فَأَدناها كَمالُ لُطفِها","مِن صَبِّها حَتّى بَدَت كَما بَدا",36,"د",2,0],["علت بعليٍّ الأَفراح فيهِ","فَبتنا وَالزَمان عَلى وِفاقِ",37,"ق",1,0],["علَتْ منازلُ أملاكٍ رجَوتُهمُ","وما أرى بيَ من إنعامِهمْ أثَرا",38,"ر",2,0],["علَت بِه إذ دَنَت خلائِقُه","وربَّ شيءٍ يَعلو إذا هَبَطا",39,"ط",2,0],["علت مذ غلت قدراً إلى قربِ ربها","فكانت له أمّاً فيا حبذا العُلْو",40,"و",1,0],["علَت وغلَت أوصافُكِ عند قدرِها","فأين فَرَزدَقْها وأين جريرها",41,"ر",3,0],["علَت بها رايةٌ للعدلِ قاصِدُها","يقتَصُّ من دهرِهِ الجاني وينتَصِفُ",42,"ف",1,0],["عَلَتْ برِفْعَتِك السادات وافتخَرتْ","حتَّى لقد خِلْتَها تعلو لكيوان",43,"ن",1,0],["عَلَتْ كلماتُ الله وهيَ عليَّةٌ","بحدِّ العوالي والمهنَّدة البُتْر",44,"ر",1,0],["عَلَّتْهُ واكِفًةُ الغَمَائمِ أَيْكَةً","وعَلَتْهُ هاتفةُ الحمائمِ مِنْبَرَا",45,"ر",2,0],["علَتْ بك عزماتٌ قواضٍ قواضبٌ","عليه وهمّات سوامٍ سوامِكُ",46,"ك",1,0],["علت تتقاضاني الوخيد وإنه","إلى نحو خير المرسلين وخيدها",47,"د",3,0],["علت فعلت ومن تيهٍ عتتْ فعنت","لحاكم التلفينِ الخوفِ والوجل",48,"ل",1,0],["علت وخبت ثم انجلت وتطاولت","على هضبات الرمل ثم تخفضت",49,"ت",1,0],["عُلّتْ بخمرِ رُضابِها فمِزاجُها","لم يصْحُ يوماً من خُمارِ مَلالِ",50,"ل",1,0],["عَلَتْ بِعَليٍّ فَوْقِ بِرْجيسَ رِفْعَةً","ولم تَرْضَ أَقْدارَ الدّرارِيّ والدُّرِّ",51,"ر",1,0],["علتْ والمنى ترنو إليها كما علا","مليكٌ على كرسيّه وأميرُ",52,"ر",1,0],["علت بي كعبة الذات البديعَهْ","لأسماء نزيهات رفيعهْ",53,"ع",2,1],["عَلَتْ على كلِّ عالٍ في معَارِجهِ","ما لم يَكُنْ من رِجالِ اللهِ أهلِ غَدِ",54,"د",1,0],["عَلَتْ به مَرْتَبتي ولم يَزَلْ","يعلو عَليٌّ في الورى ويُعلي",55,"ل",2,0],["عَلَتْ على الفِكْرِ فَمَا","يَرْقَى إِلَيْها هَاجسْ",56,"س",1,0],["عَلَتْ في أَوْجها وحَضيضُ حظّي","يُجاذِبها بأَرسان المغيب",57,"ب",1,0],["عَلَت فقميصُها بَدنٌ ورُوحٌ","وكانَ قميصُها خَزَفاً ونارا",58,"ر",2,0],["علت منهما الأبراجُ في حال قربها","علواً وقرباً مثله ليس يعهدُ",59,"د",1,0],["عِلَّتي ناشتِ الحنايا فلم أَفْ","زَعْ، فجدَّت صروفُها في طلابي",60,"ب",2,0],["علت فَعَلا صليل السيف منها","لِهَامَتِها له وقعٌ صميم",61,"م",1,0],["عَلَّ تَشفِي ما بِقَلبِي مِن سِقامِي","وَعَسى قَلبٌ كَوَاهُ بَينُهُ",62,"ه",1,0],["علت يده ما اسود جنح من الدجى","فما خلقت إلا لبيض أيادي",63,"د",2,0],["علت عن بني الأشعار قدرا ولن ترى","ربى أرض واد تستوي بوهادِ",63,"د",1,0],["علته غواشِ عبرة ما يرُدّها","لها من شؤون الناظرين سُجومُ",64,"م",1,0],["عَلت مَراتبُه فوقَ السماءِ على ال","جوزاءِ فهيَ عَلى الجوزاء جوزاءُ",65,"ا",2,0],["علت فوقها ورق النهى طربا","تشدو فتمزج ألحاناً بألحان",66,"ن",1,0],["علت همة الباشا الذي ذاع بطشه","همامٌ عليٌّ رام خيراً مؤّيدا",67,"د",2,0],["علت وغلت إلا عليك فارخصت","وجاءت على نهج الحياء تسير",68,"ر",1,0],["عَلَتْ جُدْرانُها حتَّى لَقُلْنا","سَيَقْصُرُ عَنْ مَداها الفَرْقَدانِ",69,"ن",1,0],["عَلتْ بعليّ همّةٌ عُمَرِيةٌ","ومجْدٌ لأْعنان المجرَّة ناطحُ",70,"ح",1,0],["علّ تحظى من منازلها","في ربى التنعيم بالنعم",71,"م",1,0],["علتْ فوق أعوادِ الرسول لبيعةٍ","بها مِن ثقيل الوزر طال احتقابها",72,"ب",3,0],["علت فروعاً وطابت","من قبل فيها أصولا",73,"ل",2,0],["علت لكم نار القرى فرحبوا","بمن على نار قراكم عشا",74,"ش",2,0],["عَلَتْ علوةٌ في أعينِ الصَّبِّ بهجةً","وفي أعينِ العينِ الحسان البوارعِ",75,"ع",1,0],["علتكَ أسيافُ من لا دونهُ أحَدٌ","وليسَ فوقَكَ إلّا الواحدُ الصمَدُ",76,"د",1,0],["عَلَّت مَآليَها مِنها عَواليَها","تَأوي عَلاليها في سَتر أَكنانِ",77,"ن",1,0],["علتْ بخزازيَ ذكْرُه ومنارة","فَمنْ زارها ألَفى السديف المكملا",78,"ل",2,0],["عَلَتها بدورٌ قَد سَفَرنَ فَما تَرى","لَهُنَّ سِوى مِن حالِكِ الشَعر غَيهَبا",79,"ب",2,0],["علتي عيلتي وأنت طبيبي","ودوائي الغنى وأنت الشافي",80,"ف",2,0],["علتها طفلاً على بعد أبي","وهو نائي الدار عني والوطن",81,"ن",1,0],["علتها طفلا على بعد أبي","وهو نأى الدار عني والوطن",82,"ن",1,0],["عَلَتْ فأَفلاكُها الأفلاك في شَرَفٍ","وتبرُها الشُّهبُ والأرَكانُ أَركانُ",83,"ن",1,0],["علت وغلت إلا عليك فأرخصت","عساها إلى حسن القبول تصير",84,"ر",1,0],["عَلت بِرَسول اللَه مِنهُم مَراتب","عَلى شَرف الدارين أَبياتها تُبنى",85,"ن",2,0],["علت فَوقها زهر النُجوم كَما عَلَت","بِآباء عَبد اللَه دائرة المَجد",86,"د",1,0],["علتني السنون فابلينني","ودقت عظامي وكل البصر",87,"ر",1,0],["علت الوزارة إذ علوت محلها","يا خير من عقد الأمور وحلها",88,"ل",3,1],["عَلَتْ سنِّي وَقَدْرِي فِي انْخِفَاضِ","وَحُكْمُ الرَّبِّ فِي المَرْبُوبِ مَاضِ",89,"ض",1,1],["علت همم الأرواح للعالم الأسنى","بمحض تفضل وجود ومنة",90,"ه",1,0],["علّتي ودْواي وشْفَاي وامّا راح راح","والمودّه خيرها ما يكافي اشرارها",91,"ر",3,0],["علَتْ بكَ للدّين الحَنيفِ وأهْلِهِ","مراقِبُ في أفْقِ العُلَى ومظاهِرُ",92,"ر",1,0],["عَلَت عَلَيَّ ذُنوبي","فَكُن لاِمري وَلِيّا",93,"ي",2,0],["عَلَت عَلى هامَت