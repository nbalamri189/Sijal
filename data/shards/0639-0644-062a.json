{"poems":[[53,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[88,"أيا سائلا عنا ببغداد إننا","https://www.aldiwan.net/poem44796.html","الطويل"],[27,"أجد رواح القوم أم لا تروح","https://www.aldiwan.net/poem5704.html","الطويل"],[51,"ألا يا أيها الشاكر والمطنب في المدح","https://www.aldiwan.net/poem9411.html","الهزج"],[51,"أصغى لما قلت الأصم الأصلخ","https://www.aldiwan.net/poem9439.html","الرجز"],[51,"أإسماعيل من رجل","https://www.aldiwan.net/poem9988.html","مجزوء الوافر"],[51,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[29,"رأيت قريشا حين ميز بينها","https://www.aldiwan.net/poem6025.html","الطويل"],[78,"ألا يا مليكا ظل في الخطب مفزعا","https://www.aldiwan.net/poem14152.html","الطويل"],[45,"قليل لها أني بها مغرم صب","https://www.aldiwan.net/poem10656.html","الطويل"],[45,"وراءك عني يا عذول الأشايب","https://www.aldiwan.net/poem11493.html","الطويل"],[45,"ماجو خبت وإن نأت ظعنه","https://www.aldiwan.net/poem66814.html","المنسرح"],[28,"وطارق ليل من علية زارنا","https://www.aldiwan.net/poem5142.html","الطويل"],[80,"ومسبلة دمعا يسوغ عذوبة","https://www.aldiwan.net/poem31529.html","الطويل"],[105,"ثقيف اجمعي للات ما شئت من عزم","https://www.aldiwan.net/poem43571.html","الطويل"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[8,"هل بالديار الغداة من صمم","https://www.aldiwan.net/poem21838.html","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54523","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54797","الرجز"],[72,"علت بِهِ دَرَجَات الْفضل واتضحت","https://www.poetsgate.com/ViewPoem.aspx?id=189411",""],[90,"تحية العيد أو الملك والإنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=178948",""],[78,"أَلا يا مَليكا ظلَّ في الخَطب مَفْزَعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86550&r=&rc=95",""],[88,"أيا سائلا عنَّا ببغدادَ إننا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19513&r=&rc=16",""],[115,"كنز المقل سلاح الخائف الوجل","https://www.aldiwan.net/poem40858.html","عموديه"],[115,"لواء المجد والتعظيم يعقد","https://www.aldiwan.net/poem41775.html","الخفيف"],[143,"هو ذاك ربع المالكية فاربع","https://www.aldiwan.net/poem11770.html","الكامل"],[143,"أرى سفها ولو جاء العذول","https://www.aldiwan.net/poem11804.html","الوافر"],[143,"أما ومناقب عزت مراما","https://www.aldiwan.net/poem11818.html","الوافر"],[157,"سيد الشهور","https://www.aldiwan.net/poem23652.html","الوافر"],[169,"سقها ولو ذهب السرى بسراتها","https://www.aldiwan.net/poem1609.html",""],[189,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[270,"تقول إذا مرت وقلبي لها تلو","https://www.aldiwan.net/poem35304.html","الطويل"],[271,"فؤادي بربع الظاعنين أسير","https://www.aldiwan.net/poem52084.html","الطويل"],[275,"لم يخن في الحب تأويلي","https://www.aldiwan.net/poem25541.html","المديد"],[282,"لا والمطايا يعتسفن البيدا","https://www.aldiwan.net/poem32795.html","الكامل"],[290,"تذكرت فانهلت الأدمع","https://www.aldiwan.net/poem11662.html","المتقارب"],[349,"لولا سنى ربة الخدر بدا","https://www.aldiwan.net/poem15643.html","الرجز"],[353,"دعوني بين ندمان وساقي","https://www.aldiwan.net/poem40026.html","الوافر"],[364,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[371,"إن يئست نفسه وإن قنطا","https://www.aldiwan.net/poem57339.html","المنسرح"],[377,"تمازج في قلبي الصبابة والشجو","https://www.aldiwan.net/poem59183.html","الطويل"],[377,"قفا نبك نفسا طال منها بسورها","https://www.aldiwan.net/poem59433.html","الطويل"],[409,"من كان لي من حماه خيس ذي لبد","https://www.aldiwan.net/poem32214.html","البسيط"],[416,"علي لا زلت مسرورا بسلمان","https://www.aldiwan.net/poem53863.html","البسيط"],[416,"لقد خفقت في النحر ألوية النصر","https://www.aldiwan.net/poem54141.html","الطويل"],[432,"هو ملتقى أرج النواسم فانظرا","https://www.aldiwan.net/poem12311.html","الكامل"],[432,"تلين لعزمي بالعراء العوائك","https://www.aldiwan.net/poem12691.html","الطويل"],[441,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[464,"مابعد لقياك للعافين من أملِ","https://www.aldiwan.net/poem3136.html","عموديه"],[513,"أرقت بنار بالطليحة أوقدت","https://www.aldiwan.net/poem67772.html","الطويل"],[514,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[529,"أدكرى حبيب أبرزت دمية القصر","https://www.aldiwan.net/poem37419.html","الطويل"],[551,"ودهم كسون الليل سود ثيابه","https://www.aldiwan.net/poem47820.html","الطويل"],[558,"علت بي كعبة الذات البديعه","https://www.aldiwan.net/poem34368.html","الوافر"],[562,"المال يفرق بين الأم والولد","https://www.aldiwan.net/poem52953.html","البسيط"],[575,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[575,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[585,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""]],"verses":[["عَلَت أَصواتُهُم صَوتي وَلَكِن","صَهيلُ الخَيلِ يُطرِقُ لِلهَريرِ",0,"ر",1,0],["علت أمة الغرب السماء وأشرفت","علينا فظلَنا ننظر القوم من تحت",1,"ت",1,0],["عَلَتكَ أَواذِيٌّ مِنَ البَحرِ فَاِقتَبِض","بِكَفَّيكَ فَاِنظُر أَيَّ لُجَّيهِ تَقدَحُ",2,"ح",1,0],["علتْ حالاه من سُخْطٍ","وَمَرْضَاةٍ عن المزحِ",3,"ح",1,0],["علتْ ذُرَاها والأصولُ رُسَّخُ","ما أطوع البذْخَ له لو يَبْذَخُ",4,"خ",1,0],["عَلَتْهُ وحشةٌ بهمُ","وأصبح نورهُ باخا",5,"خ",2,0],["علتْ وأضاءتْ للعيونِ وربّما","غدا كلُّ طرْفٍ وهْو عنها مُفَلّلُ",6,"ل",1,0],["عَلَتها بُحورٌ مِن أُمَيَّةَ تَرتَقي","ذُرا هَضبَةٍ ما فَرعُها بِقَصيرِ",7,"ر",1,0],["عَلَتني مِن السَخطِ الأَليم سَحابَةٌ","فَأغرَبُها ريحُ الرِضى كَي تَقَشَّعا",8,"ع",2,0],["عَلَت فَوقَ بَغراسٍ فَضاقَت بِما جَنَت","صُدورُ رِجالٍ حينَ ضاقَ بِها الدَربُ",9,"ب",1,0],["عَلَت هاشِمٌ مِن بَعدِ ذَلِكَ كُلِّهِ","سَنامَ العُلا فَوقَ الذُرى وَالغَوارِبِ",10,"ب",1,0],["عَلَت يَدٌ لِلعَلاءِ مُفضِلَةٌ","كَما تَعَلّى مِن عارِضٍ مُزُنُه",11,"ن",2,0],["عَلَت كَفُّكَ اليُمنى طِعاناً وَنائِلاً","يَدَي كُلِّ مِعطاءٍ وَقِرنٍ تُساوِرُه",12,"ر",2,0],["علت خيلُنا منها جليداً فلم يُتَحْ","بِنا للعدى من عَدوهِنَّ عجاجُ",13,"ج",1,0],["عَلتْ قُبَّةُ الإسلامِ واعتزَّ جندُه","فَمِن شَرَفٍ وافٍ ومن سُؤْددٍ جَمِّ",14,"م",1,0],["عَلَتِ الأَيدي بِأَجوازٍ لَها","رُحُبِ الأَجوافِ ما إِن تَنبَهِر",15,"ر",1,0],["عُلَّت بهِ قَرقَفٌ سُلاَفَةُ إِس","فِنطٍ عُقارٌ قَلِيلَةُ النَدَمِ",16,"م",1,0],["عَلَتْ شَمْسُ الضُّحى وَالرَّوْضُ زَاهٍ","وَفِيهِ نَضَارَةٌ وَسَنىً وَمَاءُ",17,"ا",2,0],["عِلَّتُهُ أَلِيمَةٌ","تُذِيبُ قَلْبِي كَمَدَا",18,"د",2,0],["علت بِهِ دَرَجَات الْفضل واتضحت","دقائق من مَعَاني لَفظه البهج",19,"ج",1,1],["علت الوجوه الواضحات كآبة","ومحا الذبول نضارة الأوراد",20,"د",1,0],["عَلَتني مِن السُّخطِ الأَليم سَحابَةٌ","فَأَغْرِ بها ريحَ الرِّضا كَي تَقَشَّعا",21,"ع",2,0],["علَتْ أمَّة الغرب السماءَ وأشرقتْ","علينا فظَلنا نَنظر القوم من تحت",22,"ت",1,0],["علت من الابوين الانجبين له","من هاشم نسبة كالصبح حين جلي",23,"ل",2,0],["علت أحوال دولته مكاناً","فكان هو المكين بكل مرصد",24,"د",1,0],["عَلَتِ الدُسوتُ بِهِ وَقِدماً شُرِّفَت","مِنهُ المَنابِرُ بِالخَطيبِ المِصقَعِ",25,"ع",1,0],["عَلَت جَدواكَ أَقوالي وَقِدماً","عَلَوتُ المُنعِمينَ بِما أَقولُ",26,"ل",1,0],["عَلَت وَغَلَت عَلى مُتَطَلِّبيها","لِتَأمَنَ أَن تُسامى أَو تُساما",27,"م",2,0],["عَلَتْ نَفَحَاتُهُ سَبَقََتْ بِعِطْرٍٍ","وَهَفْهَفَتِ النَّسَائِمُ ، وَالجِنَانُ",28,"ن",1,0],["عَلَتِ النُجومَ بُرُوجُها فَكَأَنّما","عَقَدت أَكاليلاً عَلى شُرُفاتِها",29,"ت",3,0],["عَلت في كلِّ أرضٍ كلّ دينٍ","وَدينُ اللَّه يعلو ليس يعلى",30,"ل",2,0],["عَلت فتعالت كلُّ نفسٍ بحبِّها","فنفسي لها من دارةِ الحمل العلو",31,"ل",2,0],["علت وَغلت الاعليك فأرخصت","لترخص حور في القصور قصور",32,"ر",1,0],["علتِ المِلْحَ الأُجاجَ فَما","شِئْتَ مِنْ تَشْمير وَتَشْمِيلِ",33,"ل",1,0],["عُلتَ اليَتامى وَالأَرامِلَ جائِداً","إِذ لَم تِكُن جودٌ يُرى مَوجودا",34,"د",2,0],["علت بسمة شفتيك العذاب","وقد هجم الموت لا يردع",35,"ع",1,0],["عَلَت فَأَدناها كَمالُ لُطفِها","مِن صَبِّها حَتّى بَدَت كَما بَدا",36,"د",2,0],["علت بعليٍّ الأَفراح فيهِ","فَبتنا وَالزَمان عَلى وِفاقِ",37,"ق",1,0],["علَتْ منازلُ أملاكٍ رجَوتُهمُ","وما أرى بيَ من إنعامِهمْ أثَرا",38,"ر",2,0],["علَت بِه إذ دَنَت خلائِقُه","وربَّ شيءٍ يَعلو إذا هَبَطا",39,"ط",2,0],["علت مذ غلت قدراً إلى قربِ ربها","فكانت له أمّاً فيا حبذا العُلْو",40,"و",1,0],["علَت وغلَت أوصافُكِ عند قدرِها","فأين فَرَزدَقْها وأين جريرها",41,"ر",3,0],["علَت بها رايةٌ للعدلِ قاصِدُها","يقتَصُّ من دهرِهِ الجاني وينتَصِفُ",42,"ف",1,0],["عَلَتْ برِفْعَتِك السادات وافتخَرتْ","حتَّى لقد خِلْتَها تعلو لكيوان",43,"ن",1,0],["عَلَتْ كلماتُ الله وهيَ عليَّةٌ","بحدِّ العوالي والمهنَّدة البُتْر",44,"ر",1,0],["عَلَّتْهُ واكِفًةُ الغَمَائمِ أَيْكَةً","وعَلَتْهُ هاتفةُ الحمائمِ مِنْبَرَا",45,"ر",2,0],["علَتْ بك عزماتٌ قواضٍ قواضبٌ","عليه وهمّات سوامٍ سوامِكُ",46,"ك",1,0],["علت تتقاضاني الوخيد وإنه","إلى نحو خير المرسلين وخيدها",47,"د",3,0],["علت فعلت ومن تيهٍ عتتْ فعنت","لحاكم التلفينِ الخوفِ والوجل",48,"ل",1,0],["علت وخبت ثم انجلت وتطاولت","على هضبات الرمل ثم تخفضت",49,"ت",1,0],["عُلّتْ بخمرِ رُضابِها فمِزاجُها","لم يصْحُ يوماً من خُمارِ مَلالِ",50,"ل",1,0],["عَلَتْ بِعَليٍّ فَوْقِ بِرْجيسَ رِفْعَةً","ولم تَرْضَ أَقْدارَ الدّرارِيّ والدُّرِّ",51,"ر",1,0],["علتْ والمنى ترنو إليها كما علا","مليكٌ على كرسيّه وأميرُ",52,"ر",1,0],["علت بي كعبة الذات البديعَهْ","لأسماء نزيهات رفيعهْ",53,"ع",2,1],["عَلَتْ على كلِّ عالٍ في معَارِجهِ","ما لم يَكُنْ من رِجالِ اللهِ أهلِ غَدِ",54,"د",1,0],["عَلَتْ به مَرْتَبتي ولم يَزَلْ","يعلو عَليٌّ في الورى ويُعلي",55,"ي",1,0],["عَلَتْ على الفِكْرِ فَمَا","يَرْقَى إِلَيْها هَاجسْ",56,"س",1,0],["عَلَتْ في أَوْجها وحَضيضُ حظّي","يُجاذِبها بأَرسان المغيب",57,"ب",1,0]]}