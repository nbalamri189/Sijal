,["لَجَامَعْتُ أَمْراً لَيْسَ فِيهِ هَوَادَةٌ","وَلاَ غُضَّةٌ وَلَيْسَ فِيهَا تَنَازُعُ",105,"ع",1,0],["لَجّوا على أنْ يزيدوا كلَّ ثائرةٍ","تسعيرةً وأصروُّا كلَّ إصرار",106,"ر",1,0],["لجعلنا كلَّ عينٍ – مثلما","كلَّ قلب – تتملاكِ اجتلاء",107,"ا",2,0],["لجأنا للشرائعِ بالياتٍ","لتحمِينا وقد عزَّ احتماء",108,"ا",2,0],["لجأتُ إلى الدُّسْتُور في كل شدةٍ","أفسّر منه ما أراه مناسبا",109,"ب",2,0],["لجأوا إلى \" الأنساب \" لو جَلَّى لهم","\" نَسَب \" ولو صَدَقَتْ لهم أرحام",110,"م",1,0],["لَجَجْتَ، وَلَجَّتْ، وَكَانَ اللَّجا","لجاجُ فيه قطيعة ُ خلصانكا",111,"ك",2,0],["لجالدوا حيثُ كان الموتُ أدركهمْ","حتى يثوبوا لهم أسرى وأسلابُ",112,"ب",1,0]]}