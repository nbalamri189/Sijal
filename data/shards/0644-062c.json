www.aldiwan.net/poem12365.html","الطويل"],[435,"لمن الحمول بجدة تسري","https://www.aldiwan.net/poem12486.html","أحذ الكامل"],[440,"أشفيت حر جوى ودمعك يهمل","https://www.aldiwan.net/poem2502.html","الكامل"],[440,"منازلهم بين اللوى فالدكادك","https://www.aldiwan.net/poem2528.html","الطويل"],[442,"أهلي قد أنى لك أن تهلي","https://www.aldiwan.net/poem34788.html","الوافر"],[442,"سر سار صنع الله حيث تسير","https://www.aldiwan.net/poem34815.html","الكامل"],[442,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[442,"أعاره النرجس من لونه","https://www.aldiwan.net/poem34901.html","السريع"],[444,"أريحي الوجا يا ناق ما بعد ذا وجا","https://www.aldiwan.net/poem14299.html","الطويل"],[455,"إلى الصديق خفاجفي عوالمه","https://www.aldiwan.net/poem61248.html","البسيط"],[455,"لج الحنين إليك حتى خلتني","https://www.aldiwan.net/poem61336.html","الكامل"],[455,"من مبلغ وطني الحبيب تلهفي","https://www.aldiwan.net/poem61734.html","الكامل"],[455,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[460,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[460,"كذا تنقضي الأيام حالا على حال","https://www.aldiwan.net/poem56070.html","الطويل"],[460,"رعى الله في الحاجات كل نجيب","https://www.aldiwan.net/poem56301.html","الطويل"],[463,"ذريني وأهوالي نفر ونلتقي","https://www.aldiwan.net/poem15283.html","الطويل"],[463,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[463,"هنيئا لمجموع المناقب والعلى","https://www.aldiwan.net/poem16094.html","الطويل"],[466,"لقد غاض بحر العلم بعد أخي العلم","https://www.aldiwan.net/poem3167.html","عموديه"],[466,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[466,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[466,"لا والقدود الهيف حلفة وامق","https://www.aldiwan.net/poem3590.html","عموديه"],[466,"دعاني من ذكر العذيب وعهده","https://www.aldiwan.net/poem3609.html","عموديه"],[484,"يا راميا قلبا جريح","https://www.aldiwan.net/poem24200.html","عموديه"],[484,"نور ربي قد تجلى","https://www.aldiwan.net/poem24359.html","عموديه"],[484,"بجزع الحمى ظبي حمى ذلك الحمى","https://www.aldiwan.net/poem24477.html","عموديه"],[502,"آيات تلك الحضرة القدسيه","https://www.aldiwan.net/poem37708.html","الكامل"],[502,"أيها المستحلف الليل أفق","https://www.aldiwan.net/poem38032.html","الرمل"],[515,"لجرمي عقاب والتجاوز ممكن","https://www.aldiwan.net/poem67713.html","الطويل"],[516,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[516,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[516,"خلط الغرام الشجو في أمشاجه","https://www.aldiwan.net/poem20829.html","الكامل"],[517,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[517,"بهرت مناقب مجدك الأوهاما","https://www.aldiwan.net/poem12271.html","الكامل"],[560,"لمن طلل بين الأجارع بالي","https://www.aldiwan.net/poem33537.html","الطويل"],[560,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[564,"لجرجس العيد دار طاب منزلها","https://www.aldiwan.net/poem52630.html","البسيط"],[569,"يا من يكاثر بالدفاتر","https://www.aldiwan.net/poem69662.html","مجزوء الكامل"],[577,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"],[588,"حكى وجهه النقدين والجوهر الذي","https://www.aldiwan.net/poem17988.html","الطويل"],[712,"","https://poetry.dctabudhabi.ae/diwan/poem/20568","الطويل"],[861,"","https://poetry.dctabudhabi.ae/diwan/poem/21206","الوافر"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/198260","البسيط"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21414","الطويل"],[1187,"","https://poetry.dctabudhabi.ae/diwan/poem/122165","الطويل"],[1197,"","https://poetry.dctabudhabi.ae/diwan/poem/97752","الرجز"]],"verses":[["لِجَجاً يَلغَطُ فيهِنَّ القَنا","لَغَطَ الأَورادِ دَفعاً وَلِطاما",0,"م",2,0],["لِجَدّي إِذاً بِاللَومِ أَولى مِنَ الحَيا","وَمَن ذا يَلومُ العارِضَ المُتَهَلِّلا",1,"ل",2,0],["لَجلِجُ مِن فَوقِ الطُروسِ لِسانُهُ","وَلَيسَ يُؤَدّي ما تَقولُ مَسامِعُه",2,"ع",2,0],["لِجامٌ لِلمَشيبِ ثَنى جِماحي","وَذَلَّلَني لِأَيّامٍ وَراضا",3,"ض",2,1],["لَجَأنا مِنَ الدُنيا إِلى مُستَقِرَّةٍ","تُنَوِّلُنا عَذبَ الجَنى وَكَأَن قَدِ",4,"د",1,0],["لَجِئْتَ مَجيءَ البَدرِ مَدَّ رِواقَهُ","على أفُقٍ وحْفِ الدائِرِ مُظْلِمِ",5,"م",1,0],["لَجَزَى مُلْكَكَ الْمُبَارَكَ خَيْراً","وَقَضَى بِالشُّفُوفِ وَالتَّبْرِيزِ",6,"ز",1,0],["لَجَرَيْتُ طَوْعَ الحُزْنِ دُونَ نِهَايَةٍ","وَذَهَبْتُ مِنْ خَلْعِ التَّصَبُّرِ مَذْهَبَا",7,"ب",2,0],["لَجَرَّبتَ أَنّي أَجلِبُ الغَيَّ مَن غَوى","عَليَّ وَأَجزي ما جَزى وَأُطاوِلُه",8,"ل",2,0],["لِجارَتِنا إِذ رَأَت لِمَّتي","تَقولُ لَكَ الوَيلُ أَنّى بِها",9,"ب",3,0],["لَجاجٌ تُمادي الحُبَّ في المَعشَرِ العِدا","وَأَمُّ الهَوى الأُفُقَ الَّذي فيهِ نُشنَفُ",10,"ف",1,0],["لَجَمِيلِ وَجْهِكَ صُورَةٌ مَطْبُوعَةٌ","بِالطَّابِعِ الأبَدِيِّ فِي الأَذْهَانِ",11,"ن",1,0],["لَجَجتَ فَعادَ ذاكَ عَلَيكَ ذَمّاً","وَأَسبابُ البَلاءِ مِنَ اللَجاجِ",12,"ج",1,0],["لِجاراتِها أَفنى اللُصوصُ اِبنُ مُنذرٍ","فَلا ضَيرَ إِن لا تُغِلقي بابَ دارِكِ",13,"ك",1,0],["لجلالك الأعلى قنيصاً أتعبوا","في صيده الأرواح والأبدانا",14,"ن",2,0],["لَجَّت أُمامَةُ في لَومي وَما عَلِمَت","عَرضَ السَماوَةِ رَوحاتي وَلا بُكري",15,"ر",2,1],["لجَّ بتفضِيلِكَ اللسانُ ولو","أكثِرَ فيك الضَجاجُ واللَّجَبُ",16,"ب",1,0],["لَجالَدوا حَيثُ كانَ المَوتُ أَدرَكَهُم","حَتّى يَؤوبوا لَهُم أَسرى وَأَسلابُ",17,"ب",1,0],["لَجَلَّلتُهُم طَوقَ الحَمامَةِ إِذ ثَوى","بِزَبّاءَ قَد طَمَّت مِياهَ المَناقِبِ",18,"ب",1,0],["لجأت إلى باب الأمير وظله","وفارقت ذلي إذ وصلت إلى العزّ",19,"ز",1,1],["لجيران العقيق أفضت دمعي","مناسبة بمحمرّ النجيع",20,"ع",1,0],["لجأت إليه والحياة مريرةٌ","فعرَّفني إحسانه حلوَ طعمها",21,"م",3,0],["لجأتُ إلى الباب الجماليّ قاصداً","فقابل آمالي من السعد خادم",22,"م",1,1],["لجود قاضي القضاة أشكو","عجزي عن الحلو في صيامي",23,"ي",1,1],["لجأ الفضلُ من علاه لطودٍ","مشمخرٍّ سامي المنال ركين",24,"ن",1,0],["لجوابِ العُود منه حقّهُ","حين يهذِي في جواب العود هاذي",25,"ذ",2,0],["لجَجْن قِلىً إن لجَّ شيبي تضاحُكاً","كما لجَّ في النَفْر المِهارُ الخوارطُ",26,"ط",1,0],["لجَّ الفؤادُ فليس يلذعُهُ","عذلٌ ولا النكبات تردعُهُ",27,"ع",2,1],["لجأتُ إليكم فخذلتموني","وضِفْتكُم فما قُرِيَ النزيل",28,"ل",1,0],["لجيرانه منه مَحَلٌّ ممنَّعٌ","يضيم به الدهرَ الذليل المضيَّمُ",29,"م",1,0],["لجأتْ إلى وجنات شاكيةٍ","ضيفيْن مِنْ ندم ومِنْ سدَمِ",30,"م",1,0],["لُجَيمُ بنُ صَعبٍ لَم تَنَلها عَداوَتي","وَما نَبَحَت آلَ الخَصيبِ كِلابي",31,"ب",2,1],["لِجَوفِ مَن يُبصِرُها","لِلخَوفِ مِنها قَرقَرَه",32,"ر",2,0],["لَجَرّدتُ لِلضَربِ المُهَنَّدَ فاِنقَضى","مُرادي وَعَز ما مِثلَ حَدّ المُهَنَّدِ",33,"د",1,0],["لَجّ الفُؤادُ فَما عَسى أَن يَصنَعا","وَلَقَد نُصحتُ فَلَم أَرِد أَن أَسمَعا",34,"ع",2,1],["لِجيلِكَ في غَدٍ جيلِ المَعالي","وَشَعبِ المَجدِ وَالهِمَمِ العَوالي",35,"ي",1,0],["لِجيلِكَ يَومَ نَشأَتِهِ مَقالي","فَأَمّا أَنتَ يا نَجلَ المَعالي",35,"ي",1,0],["لَجَّت عَلى الصَدرِ الرَحيبِ وَبَرَّحَت","بِالكاظِمِ الغَيظَ الصَفوحِ العافي",36,"ف",2,0],["لَجَمَعتُ أَلوانَ الحَوادِثِ صورَةً","مَثَّلتُ فيها صورَةَ المُستَسلِمِ",37,"م",1,0],["لُجَّةٌ كَاللَوحِ لا يُحصى عَلى","قَلَمِ القُدرَةِ فيها ما سُطِر",38,"ر",1,0],["لُجَجُ الدَأماءِ أَوطانٌ لَكُم","وَمِنَ الأَوطانِ دورٌ وَحُفَر",38,"ر",1,0],["لُجَّةٌ عِندَ لُجَّةٍ عِندَ أُخرى","كَهِضابٍ ماجَت بِها البَيداءُ",39,"ا",2,0],["لِجِنِّيَّةٍ أَم غادَةٍ رُفِعَ السَجفُ","لِوَحشِيَّةٍ لا ما لِوَحشِيَّةٍ شَنفُ",40,"ف",1,1],["لِجِيادٍ يَدخُلنَ في الحَربِ أَعرا","ءً وَيَخرُجنَ مِن دَمٍ في جَلالِ",41,"ل",1,0],["لجين وتبر له خالصان","ونفس بشركته الأنفسِ",42,"س",1,0],["لجلالِ قدرِكَ تخضعُ الأقدارُ","وبيُمْنِ جَدِّكَ يحكمُ المِقْدارُ",43,"ر",1,1],["لُجَيْنٌ إِذا قَشَرَتْهُ الأكُفُّ","وتبرٌ إِذا هي لم تُقْشَرِ",44,"ر",1,0],["لُجٌّ مِنَ الآلِ لَم تُجعَل سَفائِنُهُ","إِلّا غَريريَّةَ البُزلِ المَصاعيبِ",45,"ب",1,0],["لَجَرَّدَ نَصلَ السَيفِ حَتّى تَفَرَّقَت","عَنِ السَيفِ مَخضوباً جُموعُ أَبي حَربِ",46,"ب",1,0],["لَجَرَّ عَلينا الغَيثُ هُدّابَ مُزنَةٍ","أَواخِرُها فيهِ وَأَوَّلُها عِندي",47,"د",2,0],["لَجَّ مَن قَد هَوَيتُهُ في الصُدودِ","وَجَرى بَعدَ ذاكَ طَيرُ السُعودِ",48,"د",1,1],["لَجاجَ مُعَذِّلٍ في الوَجدِ يَبلى","وَلا إِقصارَ مِنهُ وَلا قُصورُ",49,"ر",1,0],["لَجاجَةٌ مِنهُ تَأَدّى بِها","إِلى الَّذي يُنصِبُني أَم وَلوع",50,"ع",1,0],["لَجَّ هَذا الحَبيبُ في هِجرانِهِ","وَغَدا وَالصُدودُ أَكبَرُ شانِه",51,"ن",2,1],["لَجَأنا إِلى مَعروفِهِ فَكَأَنَّنا","لِمَنعَتِنا فيهِ لَجَأنا إِلى حِصنِ",52,"ن",1,0],["لَجارِيَةٌ بَينَ السَليلِ عُروقُها","وَبَينَ أَبي الصَهباءِ مِن آلِ خالِدِ",53,"د",1,1],["لَجِبٍ يَضيقُ بِهِ الفَضاءُ إِذا غَدَوا","وَأَرى السَماءَ بِغابَةٍ وَغُبارِ",54,"ر",1,0],["لُجَينِيَّةً بيضاً وَمَيّالَةَ العُرى","هِرَقلِيَّةً صَفراءَ مِن ضَربِ قَيصَرا",55,"ر",2,0],["لِجامُ شَجىً بَينَ اللَهاتَينِ مَن يَقَع","لَهُ في فَمٍ يَركَب سَبيلَ المَتالِفِ",56,"ف",1,0],["لَجاجَةُ صُرمٍ لَيسَ بِالوَصلِ إِنَّما","أَخو الوَصلِ مَن يَدنو وَمَن يَتَلَطَّفُ",57,"ف",1,0],["لَجُرتَ بِهادٍ أَو لَقُلتَ لِمُدلِجٍ","مِنَ القَومِ لَمّا يَقضِ نَعسَتَهُ نَمِ",58,"م",1,0],["لَجٍبٌ توشَّحَتِ البسيطةٌ سيلَه","وتعمَّمت أعلامُها بعمائِه",59,"ا",3,0],["لَجَزَيتَني غَيرَ الَّذي","قَد كانَ مِنكِ مِنَ الجَزاءِ",60,"ا",2,0],["لَجَّت عُتَيبَةُ في هَجري فَقُلتُ لَها","تَبارَكَ اللَهُ ما أَجفاكِ يا مَلَكَه",61,"ك",2,1],["لَجَّت فَقُلتُ لَها كَيما أُعَلِّلُها","كَمَن يُعَلَّلُ بَعدَ النَهلِ بِالعَلَلِ",62,"ل",1,0],["لَجَأوا إِلَيكَ بِجَمعِهِم","وَلِمِثلِ ظِلِّكَ يُلجَأُ",63,"ا",1,0],["لَجَأتُ إِلى رُكنٍ شَديدٍ لِحَربِكُم","أَشُدُّ بِهِ أَزري وَأُعلي بِهِ نَجمي",64,"م",2,0],["لجة بعد لجة كلما صارع","ردت له أمانيه غرقى",65,"ق",2,0],["لَجَّجتَ في بَحري فَناكَ عَجوزَهُ","مَن كانَ في شَكٍّ بِأَنَّكَ تَغرَقُ",66,"ق",1,0],["لُجَجي لَستَ سالِماً مِن تَعالي","ها وَلَو كُنتَ في سَفينَةِ نوحِ",67,"ح",1,0],["لَجاجَةٌ بِيَ فيكُم لَيسَ يُشبِهُها","إِلّا لَجاجَتُكُم في أَنَّكُم عَرَبُ",68,"ب",1,0],["لَجادَ بِها مِن غَيرِ كُفرٍ بِرَبِّهِ","وَآساهُمُ مِن صَومِهِ وَصَلاتِهِ",69,"ت",2,0],["لَجَّ فيما بَينَنا قَولاً بِلا","لَيتَ لا مَن قالَها نالَ الصَمَم",70,"م",1,0],["لَجِجتَ وَلَجَّت وَكانَ اللَجا","جُ فيهِ قَطيعَةَ خُلصانِكا",71,"ك",2,0],["لِجَّت فُطَيمَةُ مِنكَ في هَجرِ","غَدراً و