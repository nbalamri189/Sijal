poem42496.html","الكامل"],[31,"نعم الفؤاد مزارها محظور","https://www.aldiwan.net/poem42536.html","الكامل"],[31,"من لقلب غير صاح","https://www.aldiwan.net/poem42589.html","مجزوء الرمل"],[31,"لج قلبي في التصابي","https://www.aldiwan.net/poem42647.html","مجزوء الرمل"],[105,"ما للسيوف أما تثوب فتعطف","https://www.aldiwan.net/poem44198.html","الكامل"],[81,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[102,"أغمدان ما يبكيك يا كعبة الهدى","https://www.aldiwan.net/poem33035.html","الطويل"],[13,"إنك لا بزاً منعت ولا يداً","https://www.aldiwan.net/poem2220.html","الطويل"],[52,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[52,"هاتيك دارهم فعرج واسأل","https://www.aldiwan.net/poem26755.html","الكامل"],[52,"لج الفراق فويح من عشقا","https://www.aldiwan.net/poem26816.html","الكامل"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[48,"وعظتك واعظة القتير","https://www.aldiwan.net/poem63373.html","مجزوء الكامل"],[50,"اسقني يابن أسعدا","https://www.aldiwan.net/poem63949.html","مجزوء الخفيف"],[7,"ألا أبلغا ذبيان عني رسالة","https://www.aldiwan.net/poem1992.html","الطويل"],[46,"وجدت الناس كالأرضين شتى","https://www.aldiwan.net/poem22693.html","الوافر"],[46,"مضى الناس أفواجا ونحن وراءهم","https://www.aldiwan.net/poem23297.html","الطويل"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[76,"قصد المنون له فمات فقيدا","https://www.aldiwan.net/poem39456.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85557","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39548","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54856","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54833","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43687","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43846","البسيط"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9499","الكامل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[106,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[13,"وَإنَّكَ لاَ بَزّاً مَنَعْتَ وَلاَ يَداً","https://www.poetsgate.com/ViewPoem.aspx?id=180827",""],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[90,"الأنانية","https://www.poetsgate.com/ViewPoem.aspx?id=179128",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[31,"أأنكرتَ، من بعدِ عرفانكا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18993&r=&rc=256",""],[23,"إنّي حَلَفْتُ يَمِيناً غيرَ كاذِبَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=12805&r=&rc=9",""]],"verses":[["لِجَجاً يَلغَطُ فيهِنَّ القَنا","لَغَطَ الأَورادِ دَفعاً وَلِطاما",0,"م",2,0],["لِجَدّي إِذاً بِاللَومِ أَولى مِنَ الحَيا","وَمَن ذا يَلومُ العارِضَ المُتَهَلِّلا",1,"ل",2,0],["لَجلِجُ مِن فَوقِ الطُروسِ لِسانُهُ","وَلَيسَ يُؤَدّي ما تَقولُ مَسامِعُه",2,"ع",2,0],["لِجامٌ لِلمَشيبِ ثَنى جِماحي","وَذَلَّلَني لِأَيّامٍ وَراضا",3,"ض",2,1],["لَجَأنا مِنَ الدُنيا إِلى مُستَقِرَّةٍ","تُنَوِّلُنا عَذبَ الجَنى وَكَأَن قَدِ",4,"د",1,0],["لَجِئْتَ مَجيءَ البَدرِ مَدَّ رِواقَهُ","على أفُقٍ وحْفِ الدائِرِ مُظْلِمِ",5,"م",1,0],["لَجَزَى مُلْكَكَ الْمُبَارَكَ خَيْراً","وَقَضَى بِالشُّفُوفِ وَالتَّبْرِيزِ",6,"ز",1,0],["لَجَرَيْتُ طَوْعَ الحُزْنِ دُونَ نِهَايَةٍ","وَذَهَبْتُ مِنْ خَلْعِ التَّصَبُّرِ مَذْهَبَا",7,"ب",2,0],["لَجَرَّبتَ أَنّي أَجلِبُ الغَيَّ مَن غَوى","عَليَّ وَأَجزي ما جَزى وَأُطاوِلُه",8,"ل",2,0],["لِجارَتِنا إِذ رَأَت لِمَّتي","تَقولُ لَكَ الوَيلُ أَنّى بِها",9,"ب",3,0],["لَجاجٌ تُمادي الحُبَّ في المَعشَرِ العِدا","وَأَمُّ الهَوى الأُفُقَ الَّذي فيهِ نُشنَفُ",10,"ف",1,0],["لَجَمِيلِ وَجْهِكَ صُورَةٌ مَطْبُوعَةٌ","بِالطَّابِعِ الأبَدِيِّ فِي الأَذْهَانِ",11,"ن",1,0],["لَجَجتَ فَعادَ ذاكَ عَلَيكَ ذَمّاً","وَأَسبابُ البَلاءِ مِنَ اللَجاجِ",12,"ج",1,0],["لِجاراتِها أَفنى اللُصوصُ اِبنُ مُنذرٍ","فَلا ضَيرَ إِن لا تُغِلقي بابَ دارِكِ",13,"ك",1,0],["لجلالك الأعلى قنيصاً أتعبوا","في صيده الأرواح والأبدانا",14,"ن",2,0],["لَجَّت أُمامَةُ في لَومي وَما عَلِمَت","عَرضَ السَماوَةِ رَوحاتي وَلا بُكري",15,"ر",2,1],["لجَّ بتفضِيلِكَ اللسانُ ولو","أكثِرَ فيك الضَجاجُ واللَّجَبُ",16,"ب",1,0],["لَجالَدوا حَيثُ كانَ المَوتُ أَدرَكَهُم","حَتّى يَؤوبوا لَهُم أَسرى وَأَسلابُ",17,"ب",1,0],["لَجَلَّلتُهُم طَوقَ الحَمامَةِ إِذ ثَوى","بِزَبّاءَ قَد طَمَّت مِياهَ المَناقِبِ",18,"ب",1,0],["لجأت إلى باب الأمير وظله","وفارقت ذلي إذ وصلت إلى العزّ",19,"ز",1,1],["لجيران العقيق أفضت دمعي","مناسبة بمحمرّ النجيع",20,"ع",1,0],["لجأت إليه والحياة مريرةٌ","فعرَّفني إحسانه حلوَ طعمها",21,"م",3,0],["لجأتُ إلى الباب الجماليّ قاصداً","فقابل آمالي من السعد خادم",22,"م",1,1],["لجود قاضي القضاة أشكو","عجزي عن الحلو في صيامي",23,"ي",1,1],["لجأ الفضلُ من علاه لطودٍ","مشمخرٍّ سامي المنال ركين",24,"ن",1,0],["لجوابِ العُود منه حقّهُ","حين يهذِي في جواب العود هاذي",25,"ذ",2,0],["لجَجْن قِلىً إن لجَّ شيبي تضاحُكاً","كما لجَّ في النَفْر المِهارُ الخوارطُ",26,"ط",1,0],["لجَّ الفؤادُ فليس يلذعُهُ","عذلٌ ولا النكبات تردعُهُ",27,"ع",2,1],["لجأتُ إليكم فخذلتموني","وضِفْتكُم فما قُرِيَ النزيل",28,"ل",1,0],["لجيرانه منه مَحَلٌّ ممنَّعٌ","يضيم به الدهرَ الذليل المضيَّمُ",29,"م",1,0],["لجأتْ إلى وجنات شاكيةٍ","ضيفيْن مِنْ ندم ومِنْ سدَمِ",30,"م",1,0],["لُجَيمُ بنُ صَعبٍ لَم تَنَلها عَداوَتي","وَما نَبَحَت آلَ الخَصيبِ كِلابي",31,"ي",1,1],["لِجَوفِ مَن يُبصِرُها","لِلخَوفِ مِنها قَرقَرَه",32,"ر",2,0],["لَجَرّدتُ لِلضَربِ المُهَنَّدَ فاِنقَضى","مُرادي وَعَز ما مِثلَ حَدّ المُهَنَّدِ",33,"د",1,0],["لَجّ الفُؤادُ فَما عَسى أَن يَصنَعا","وَلَقَد نُصحتُ فَلَم أَرِد أَن أَسمَعا",34,"ع",2,1],["لِجيلِكَ في غَدٍ جيلِ المَعالي","وَشَعبِ المَجدِ وَالهِمَمِ العَوالي",35,"ي",1,0],["لِجيلِكَ يَومَ نَشأَتِهِ مَقالي","فَأَمّا أَنتَ يا نَجلَ المَعالي",35,"ي",1,0],["لَجَّت عَلى الصَدرِ الرَحيبِ وَبَرَّحَت","بِالكاظِمِ الغَيظَ الصَفوحِ العافي",36,"ي",1,0],["لَجَمَعتُ أَلوانَ الحَوادِثِ صورَةً","مَثَّلتُ فيها صورَةَ المُستَسلِمِ",37,"م",1,0],["لُجَّةٌ كَاللَوحِ لا يُحصى عَلى","قَلَمِ القُدرَةِ فيها ما سُطِر",38,"ر",1,0],["لُجَجُ الدَأماءِ أَوطانٌ لَكُم","وَمِنَ الأَوطانِ دورٌ وَحُفَر",38,"ر",1,0],["لُجَّةٌ عِندَ لُجَّةٍ عِندَ أُخرى","كَهِضابٍ ماجَت بِها البَيداءُ",39,"ا",2,0],["لِجِنِّيَّةٍ أَم غادَةٍ رُفِعَ السَجفُ","لِوَحشِيَّةٍ لا ما لِوَحشِيَّةٍ شَنفُ",40,"ف",1,1],["لِجِيادٍ يَدخُلنَ في الحَربِ أَعرا","ءً وَيَخرُجنَ مِن دَمٍ في جَلالِ",41,"ل",1,0],["لجين وتبر له خالصان","ونفس بشركته الأنفسِ",42,"س",1,0],["لجلالِ قدرِكَ تخضعُ الأقدارُ","وبيُمْنِ جَدِّكَ يحكمُ المِقْدارُ",43,"ر",1,1],["لُجَيْنٌ إِذا قَشَرَتْهُ الأكُفُّ","وتبرٌ إِذا هي لم تُقْشَرِ",44,"ر",1,0],["لُجٌّ مِنَ الآلِ لَم تُجعَل سَفائِنُهُ","إِلّا غَريريَّةَ البُزلِ المَصاعيبِ",45,"ب",1,0],["لَجَرَّدَ نَصلَ السَيفِ حَتّى تَفَرَّقَت","عَنِ السَيفِ مَخضوباً جُموعُ أَبي حَربِ",46,"ب",1,0],["لَجَرَّ عَلينا الغَيثُ هُدّابَ مُزنَةٍ","أَواخِرُها فيهِ وَأَوَّلُها عِندي",47,"ي",1,0],["لَجَّ مَن قَد هَوَيتُهُ في الصُدودِ","وَجَرى بَعدَ ذاكَ طَيرُ السُعودِ",48,"د",1,1],["لَجاجَ مُعَذِّلٍ في الوَجدِ يَبلى","وَلا إِقصارَ مِنهُ وَلا قُصورُ",49,"ر",1,0],["لَجاجَةٌ مِنهُ تَأَدّى بِها","إِلى الَّذي يُنصِبُني أَم وَلوع",50,"ع",1,0],["لَجَّ هَذا الحَبيبُ في هِجرانِهِ","وَغَدا وَالصُدودُ أَكبَرُ شانِه",51,"ن",2,1],["لَجَأنا إِلى مَعروفِهِ فَكَأَنَّنا","لِمَنعَتِنا فيهِ لَجَأنا إِلى حِصنِ",52,"ن",1,0],["لَجارِيَةٌ بَينَ السَليلِ عُروقُها","وَبَينَ أَبي الصَهباءِ مِن آلِ خالِدِ",53,"د",1,1],["لَجِبٍ يَضيقُ بِهِ الفَضاءُ إِذا غَدَوا","وَأَرى السَماءَ بِغابَةٍ وَغُبارِ",54,"ر",1,0],["لُجَينِيَّةً بيضاً وَمَيّالَةَ العُرى","هِرَقلِيَّةً صَفراءَ مِن ضَربِ قَيصَرا",55,"ر",2,0],["لِجامُ شَجىً بَينَ اللَهاتَينِ مَن يَقَع","لَهُ في فَمٍ يَركَب سَبيلَ المَتالِفِ",56,"ف",1,0],["لَجاجَةُ صُرمٍ لَيسَ بِالوَصلِ إِنَّما","أَخو الوَصلِ مَن يَدنو وَمَن يَتَلَطَّفُ",57,"ف",1,0],["لَجُرتَ بِهادٍ أَو لَقُلتَ لِمُدلِجٍ","مِنَ القَومِ لَمّا يَقضِ نَعسَتَهُ نَمِ",58,"م",1,0],["لَجٍبٌ توشَّحَتِ البسيطةٌ سيلَه","وتعمَّمت أعلامُها بعمائِه",59,"ا",3,0],["لَجَزَيتَني غَيرَ الَّذي","قَد كانَ مِنكِ مِنَ الجَزاءِ",60,"ا",2,0],["لَجَّت عُتَيبَةُ في هَجري فَقُلتُ لَها","تَبارَكَ اللَهُ ما أَجفاكِ يا مَلَكَه",61,"ك",2,1],["لَجَّت فَقُلتُ لَها كَيما أُعَلِّلُها","كَمَن يُعَلَّلُ بَعدَ النَهلِ بِالعَلَلِ",62,"ل",1,0],["لَجَأوا إِلَيكَ بِجَمعِهِم","وَلِمِثلِ ظِلِّكَ يُلجَأُ",63,"ا",1,0],["لَجَأتُ إِلى رُكنٍ شَديدٍ لِحَربِكُم","أَشُدُّ بِهِ أَزري وَأُعلي بِهِ نَجمي",64,"ي",1,0],["لجة بعد لجة كلما صارع","ردت له أمانيه غرقى",65,"ق",2,0],["لَجَّجتَ في بَحري فَناكَ عَجوزَهُ","مَن كانَ في شَكٍّ بِأَنَّكَ تَغرَقُ",66,"ق",1,0],["لُجَجي لَستَ سالِماً مِن تَعالي","ها وَلَو كُنتَ في سَفينَةِ نوحِ",67,"ح",1,0],["لَجاجَةٌ بِيَ فيكُم لَيسَ يُشبِهُها","إِلّا لَجاجَتُكُم في أَنَّكُم عَرَبُ",68,"ب",1,0],["لَجادَ بِها مِن غَيرِ كُفرٍ بِرَبِّهِ","وَآساهُمُ مِن صَومِهِ وَصَلاتِهِ",69,"ت",2,0],["لَجَّ فيما بَينَنا قَولاً بِلا","لَيتَ لا مَن قالَها نالَ الصَمَم",70,"م",1,0],["لَجِجتَ وَلَجَّت وَكانَ اللَجا","جُ فيهِ قَطيعَةَ خُلصانِكا",71,"ك",2,0],["لِجَّت فُطَيمَةُ مِنكَ في هَجرِ","غَدراً وَهُنَّ صَواحِبُ الغَدرِ",72,"ر",1,1],["لَجَّ البِعادُ بِها وَشَطَّ بِرَكبِها","نائي المَحَلَّ عَنِ الصَديقِ غَيورُ",73,"ر",1,0],["لَجَّ في ذِكرِ الغَواني","بَعدَ رُشدٍ وَصَلاحِ",74,"ح",1,0],["لَجَّ قَلبي في التَصابي","وَاِزدَهى عَنّي شَبابي",75,"ب",2,1],["لجَّ النفاقُ فقائلٌ لا يستحي","ممّا يقولُ وسامعٌ لا يأنف",76,"ف",1,0],["لِجَدّهِ أثَرٌ فِي كُلّ مُبتَعِدٍ","لَو كَانَ يَدرِي بِهِ الخَطِّيُّ لَم يَطُلِ",77,"ل",1,0],["لجبرٍ يَدٌ عِندي تَأَلَّقُ كَالضُحى","وَقَلَّ لَها شكراً رثائيكَ مُنشِدا",78,"د",2,0],["لَجامَعتُ أَمراً لَيسَ فيهِ هَوادَةٌ","وَلا غُصَّةٌ وَلَيسَ فيهِ تَنازُعُ",79,"ع",1,0],["لَجَّت بِنا هُجرَةٌ وَالقَلبُ عِندَكُمُ",