/www.aldiwan.net/poem55862.html","المنسرح"],[458,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[458,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[458,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[458,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[461,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[461,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15305.html","الطويل"],[461,"عليها ذمام الله من كل ذاعر","https://www.aldiwan.net/poem15462.html","الطويل"],[461,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[461,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[461,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[464,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[468,"أيا من تناقص منه الحياء","https://www.aldiwan.net/poem60519.html","المتقارب"],[479,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[479,"أناخ في قلب ليلى هاجس الشجن","https://www.aldiwan.net/poem37572.html","البسيط"],[482,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[500,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[515,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[515,"سرى لك عرف في النسيم الذي سرى","https://www.aldiwan.net/poem12108.html","الطويل"],[529,"أيا بين كم كدرت صفو المشارب","https://www.aldiwan.net/poem37536.html","الطويل"],[538,"يا رعى الله إخوة كرموني","https://www.aldiwan.net/poem47601.html","عموديه"],[551,"قل لمن خده من اللحظ دام","https://www.aldiwan.net/poem47221.html","الخفيف"],[551,"بيني وبين عواذلي","https://www.aldiwan.net/poem47885.html","مجزوء الكامل"],[553,"خيال من النائي الهوى المتبعد","https://www.aldiwan.net/poem68426.html","الطويل"],[553,"وساحرة العينين ما تحسن السحرا","https://www.aldiwan.net/poem68429.html","الطويل"],[558,"أنا عندي أن الشهود حجاب","https://www.aldiwan.net/poem34967.html","الخفيف"],[575,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[575,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"]],"verses":[["إِن أَخلَفَ الوَعدَ حيٌّ يظعَنونَ غَدا","وَفَى لِيَ الطَّرفُ مِن دَمعي بِما وَعَدا",0,"د",2,1],["أَنَّ إِخوانِنا الأَرَاقِمَ يَغلو","نَ عَلَينا في قَولِهِم إِحفاءُ",1,"ا",2,0],["إِنَّ أَخي لَيسَ بِتَرعِيَّةٍ","نِكسٍ هَواءِ القَلبِ ذي ماشِيَه",2,"ي",2,0],["أَناخَت بِها الأَشراطُ وَاِستَوفَضَت بِها","حَصى الرَملِ راداتُ الرِياحِ الهَواجِمِ",3,"م",1,0],["أَناخوا وَنَجمٌ لاحَ بارِقُ ضَوئِهِ","يُخالِفُ شَرقِيَّ النُجومِ تِهامِ",4,"م",1,0],["أَناخَ فَما تَوَسَّدَ غَيرَ كَفٍّ","لَوى بِبَنانِها طَرَفَ الزِمامِج",5,"م",2,0],["أَناخَت رَوايا كُلِّ دلُوِيَّةٍ بِها","وَكُلِّ سِماكيٍّ مِلُثِ المَبارِكِ",6,"ك",1,0],["أَناخوا فَأَغفوا عِندَ أَيدي قَلائِصِ","خِماصٍ عَلَيها أَرحُلٌ وَطَنافِسُ",7,"س",1,0],["أَناخوا لِتُطوى تَحتَ أَعجازِ سُدفَةٍ","أَيادي المَهارى وَالجُفونُ سَواهِدُ",8,"د",1,0],["إن أخرجوك من المواطن مُكرَهاً","فالشعب خلفك هائج لا يهجع",9,"ع",1,0],["أَناخوا قَليلاً ثُمَّ هاجوا قَلائِصاً","كَما هيجَ خَيطٌ مَغرِبَ الشَمسِ جافِلُ",10,"ل",1,0],["أَناخوا بِوَهّابِ النَفائيسِ ماجِدٍ","يُقاسِمُهُم أَموالَهُ وَيُشاطِرُ",11,"ر",1,0],["إن أخرت بيروت عود جوادها","فنداك يدعونا لخيرِ جواد",12,"د",1,0],["إن أخرتني عن مديحك فترة","فعلى رجائي فيك أن أتقدّما",13,"م",2,1],["إن أخلاقك العِذابَ حكَتْها","عند حَرِّ الصدى النِّطافُ العِذابُ",14,"ب",1,0],["إنَّ أخاك الذي تُزاولُه","ما زال مذ قال أهلُه حَلُما",15,"م",2,0],["أَناخوا فَجَرّوا شاصِياتٍ كَأَنَّها","رِجالٌ مِنَ السودانِ لَم يَتَسَربَلوا",16,"ل",3,0],["أَنا خَيرُ مَن قالَ القَوافِيَ مادِحاً","أَنا خَيرُ من قالَ القَوافِيَ هاجي",17,"ي",1,0],["إِن أَخطَأَ الخَزّافُ في جَبلِهِ ال","طينَ فَأَيُّ ذَنبٍ لِلآنِيَه",18,"ه",1,0],["أَناخوا بِأَشوالٍ إِلى أَهلِ خُبَّةٍ","طُروقاً وَقَد أَقعى سُهَيلاً فَعَرَّدا",19,"د",2,0],["أنا خدت الدمع في قلبي","وأكتم في القلب أسايه",20,"ا",3,0],["إن أخذنا الكبريت ثم خلطنا","جسداً ميتاً به وسقينا",21,"ن",2,1],["إِنَّ إِخوانَكَ المُقيمينَ بِالأَم","سِ أَتَوا لِلزِناءِ لا لِلغِناءِ",22,"ا",2,0],["إِن أَخلَقَت حُرُقاتٌ مِن صَبابَتِهِ","تَرادَفَت حُرُقاتٌ بَعدَها جُدُدُ",23,"د",1,0],["إِن أَخَفَّ الكُتّابُ في الوَزنِ غَدرٌ","رَجَحَت كِفَّةُ الوَفِيِّ الوافي",24,"ي",1,0],["إِن أَخلَفَ القَطرُ أَو أَكدَت مَخيلَتُهُ","كانَت يَداهُ لَنا مِن صَوبِهِ خَلَفا",25,"ف",2,0],["إِن أَخَسَّت تِلكَ الحَقائِقُ حَظّي","أَجزَلَت هَذِهِ الأَمانِيُّ قِسمي",26,"ي",1,0],["أَناخَت بِهِ كُلُّ رَجّاسَةٍ","وَساكِبَةِ الماءِ لَم تُرعِدِ",27,"د",1,0],["أَناخَ بِهِم مُغاضَبَةً فَلاقى","شَعوبَ المَوتِ أَو حَلَقَ الإِسارِ",28,"ر",1,0],["أَناخَت بِها وَسطَ البُيوتِ نِساؤُنا","وَقَد أُعجِلَت شَدَّ الرِحالِ اِكتِفالُها",29,"ل",3,0],["أَناخَ إِلى بَيتٍ عَطِيَّةَ تَحتَهُ","إِلَيهِ ذُرى اللُؤمِ اِستَقَرَّت مَسايِلُه",30,"ل",2,0],["أَناخوا لِكِسرى حينَ جاءَت جُنودُهُ","وَبَهراءَ إِذ جاءَت وَجَمعُ الأَراقِمِ",31,"م",1,0],["أَناخَ إِلَيكُم طالِبٌ طالَ ما نَأَت","بِهِ الدارُ دانٍ بِالقَرابَةِ عالِمِ",32,"م",1,1],["أَناخَ إِلَيها اِبنايَ ضَيفَي مَقامَةٍ","إِلى عُصبَةٍ ما تُستَعارُ ثِيابُها",33,"ب",3,0],["أَناخوا بِأَيدي طاعَةٍ وَسُيوفُهُم","عَلى أُمَّهاتِ الهامِ ضَرباً شَآمِيا",34,"ي",2,0],["إِن أَخرَسَت فِلَذُ العَقيرِ كِلابَهُم","دَعَوُا الضُيوفَ بِأَلسُنِ النيرانِ",35,"ن",1,0],["إِنّا خَدَمنا القِلى جَهلاً بِنا وَعَمىً","فَاليَومَ نَحنُ جَميعاً لِلرِضا خَدَمُ",36,"م",1,0],["أَنَا خَاشِعٌ لِجَلالِ قُدْرَتِهِ","مُتَقَلِّبُ الْجَنْبَيْنِ أَوَّاهُ",37,"ا",2,0],["أنا خالدٌ في لوعةٍ","وجوى يشيبُ لهُ الوليدْ",38,"د",1,0],["أَناخَ هَوى لَيلى بِهِ فَأَذابَهُ","وَمَن ذا يُطيقُ الصَبرَ عَن مَحمَلِ الحُبِّ",39,"ب",1,0],["إنّا خرجنا نريدُ اللهَ فاسْتَبِقُوا","من كلِّ مُنتَهِبٍ للخيرِ مُهْتَبِلِ",40,"ل",1,0],["أَنا خائِفٌ مِن شَرِّها مُتَوَقِّعٌ","إِكآبَها لا الشُربَ مِن أَكوابِها",41,"ب",3,0],["إِن أَخلَفَتكَ اليَومَ مَوعِدَها","فَعُرفُها جارٍ بِإِخلافِها",42,"ف",3,0],["إن أخفق الإنسان في عمل له","ذم الزَمان وَعاتب الأقدارا",43,"ر",2,1],["أَناخوا المَطايا حين أدرك لَيلها","بمأسدة فيها الحماة قَليل",44,"ل",1,0],["أناخَ على سَرَوَاتِ العراق","فقصَّفَ أفنانَها الوارفَه",45,"ف",2,0],["إِنْ أَخْلَقَتْ جِدَّةُ الأَشْعَارِ أَثَّلَهَا","لَفْظٌ أَصِيلٌ وَمَعْنىً غَيْرُ مُنْتَحَلِ",46,"ل",1,0],["إِنْ أَخْطَأَتْ قُطْراً مَوَاقِعُ غَيْثِهَا","أَحْظَتْهُ بِاللَّمَحَاتِ وَالأَصْدَاءِ",47,"ا",2,0],["إِنْ أَخْلَدَ المَرْءَ حُسْنُ فِعْلٍ","فَأَنْتَ بِالْخَالِدَات بَاقِ",48,"ق",1,0],["أَنا خِلُّ كُلِّ فَتىً إِذا أَيقَظتُهُ","أَيقَظتُ كَالنَضاضِ أَو كَالعادي",49,"ي",1,0],["إِن أَخَذنا سِلاحَنا أَو تَرَكنا","فَسواءٌ في المَوتِ أَخذٌ وَتَركُ",50,"ك",1,0],["أناخ بهم في الأمن خوفٌ أراهمُ","كأنهمُ يمشون فوق شفير",51,"ر",1,0],["إنا خطبنا المجدَ، فل","تجر الأمور كما تشاء",52,"ا",2,0],["إن إخواننا الأراقم يغلو","ن علينا في قيلهم إحفاء",53,"ا",2,0],["أنا خاطرت بنفسي في الهوى","والهوى لذَّتهُ في الخَطَر",54,"ر",1,0],["انا خصم كل منافق ! لم يَنْهَني","حَذرٌ ولم يقعُد بي الكِتمان",55,"ن",1,0],["إِنْ أَخلفَ القَطرُ أَوكدتْ مَخِيلَتُهُ","كاَنَتْ يَدَاهُ لنا من صَوْبِهِ خَلَفَا",56,"ف",2,0],["أناخوا الذنوب المثقلات لواغبا","بأفيح  من عفو الإله  رحيب",57,"ب",1,0],["أناخوا بأشوالٍ إلى أهلِ خبّة","ٍ طروقًا وقدْ أقعى سهيلٌ فعرّدا",58,"د",2,0],["إن أخس القديم حظى فهذا","مجزلٌ قسمتي ومورٍ زندي",59,"ي",1,0],["أناخ على الدنيا الظلام بكلكلٍ","وأغرقها في زاخر متلاطم",60,"م",1,0],["إنا خلقنا للتصبرِ والأسَى","والنوحُ والأحزانُ للنِّسْوَانِ",61,"ن",1,0],["إِن أخلَقَت هَذِي اللَّيَالِي خِلقَتِي","فَخَلِيقَتِي جَلَّت عَنِ الإخلاَقِ",62,"ق",1,1],["إن أخطأتْ واصلت اعتذارَها","وإن أصابت فهو من صوابهِ",63,"ب",2,0],["أناخوا على حسن اليقين جمالهم","على بابك العالي فاكسبتهم يمنا",64,"ن",2,0],["إِن أَخربت تلك السيوف ديارهم","أَعنى الأَعادي فالقبور عوامر",65,"ر",1,0],["إنّا خذلنا الشعرَ من زمنٍ","كَمْ من قصيدٍ قيلَ في الَعذَلِ",66,"ل",1,0],["أَناخَ بِها رَكب الغِواية عائِشاً","وَجاسَ حِماها مَربَعاً ثُمَ مَربَعا",67,"ع",2,0],["إنِ اخْتَصرتُ قَريضي في المديحِ فقد","يُنال سامي العُلَى بالباترِ الخذم",68,"م",1,0],["أَناخوا وَقَد طالَ الكَرى فَكَأَنَّهُم","سُكارى تَحاذَوا صَحنَ راحٍ مُخَضرَمِ",69,"م",1,0],["أَناخوا قَليلاً ثُمَّ نَبَّهَ نَومَهُم","دُعاءٌ بُعَيدَ الفَهمِ ماضٍ مُعَمَّمِ",69,"م",1,0],["إن أخلفَتْ غرُّ السحابِ تهللوا","أو جَنَّ ليلُ الحادثاتِ أضاءوا",70,"ا",1,0],["إنا خلقنا لأمر","أراده ذو الجلال",71,"ل",1,0],["أَنا خَفيٌّ كَالسِرِّ أَو كَال","هلاكِ أَنقضُّ في ثَوانِ",72,"ن",1,0],["إن أخلف الغيثُ بات نائلهُ","يَخْلُف أنواءه وسُقْيَاها",73,"ا",3,0],["أَناخَت بِوَضّاحِ الجَبينِ مُمَدَّحٍ","وَما كُلُّ وَضّاحِ الجَبينِ مُمَدَّحُ",74,"ح",1,0],["أنا خادم الصدِّيق واسمي في الورى","عمرٌ ولكنّي أميل إلى علي",75,"ي",1,0],["أنا خاملٌ في بُقعةٍ مَجهُولةٍ","أَسرى بها أحرارُها وخيارها",76,"ر",3,0],["أناخوا بأرجاءِ الرجاءِ وعرسوا","فأصبح كلٌ مايز القدح فالجا",77,"ج",2,0],["أَناخَت عليه لم تراقب له عُلاً","فألوَت به خَسفاً وأَزرت به عَسفا",78,"ف",2,0],["إن أخذت مرآتها بعدما","ضممت طول الليل عطفيها",79,"ه",2,1],["أنا خير محضٌ ومن هم عبيدي","ليس الشر بينهم من مقام",80,"م",1,0],["انا خيال ارى حالي بلا حال","وفكرة ميتة بل خاطر بالِ",81,"ل",1,1],["أَنَاخَ رَجَاءَهُ بِحمِىَ عَزِيزٍ","وَمَدَّ يَدَ السُّؤَالِ إلى جَوَادِ",82,"د",1,0],["إن أخلَفَ الضيفَ رسلٌ عند حاجتنا","لم يخلف الضيف من أصلابها دسَمُ",83,"م",1,0],["إن أخلق الوُدُّ القديم فعِفْتَهُ","فَهُناك وُدُّ تَصطَفيهِ جَديد",84,"د",1,0],["إِن أَخلَفَ الخِلفُ مِن مِصرٍ فَوا عَطَشي","إِن رُمتُ في حَلَبٍ ما رُمتُ مِن حَلَبِ",85,"ب",1,0],["اناخ بيَ المشيبُ فلا براحٌ","وإن أوسعته عَتباً ولوما",86,"م",2,0],["أناخَ الشَيبُ ضَيفا لَم أُرِدهُ","وَلكِن لا أُطيقُ لَهُ مَرَدّا",87,"د",2,1],["أناخ بنجد واستراح ركابها","وعاد خلياً عن رحيل وعن شد",88,"د",1,0],["إن إخواننا الأُلى سبقونا","حين دارت من السرور الكؤوس",89,"س",1,1],["أنا خافٍ كَليلةِ القَدْرِ في النَّا","سِ وعالٍ كَليلَةِ القَدْرِ قَدْرا",90,"ر",2,0],["أَناخوا جِمالاً وَحازوا جَمالاً","أَظُنُّ الأَحِبَّةَ راموا اِرتِحالا",91,"ل",2,0],["إِن أَخلَف المُزنَ لَم تَخلِف أَنامِلُهُ","أَو أَمسِك الغَيثَ لَم تُمسِك مَواهِبُهُ",92,"ب",2,0],["إن أخْلَفُوا عَهدَك أو بدَّلُوا","فكُن بِحُسْن الصَّبرِ عنهُم خَليقْ",93,"ق",1,0],["أَناخَ عَلى الصَفصاف حَتّى اِستَباحَهُ","فَكابَرَهُ فيها أَلَجُّ مُكابِرُ",94,"ر",1,0],["أنا خائفٌ مترقّبٌ","فيها وذاكَ مثقَّفُ",95,"ف",1,0],["إن أخلفتنا عهاد المزن في زمنٍ","فإنّ جودك طول الدهر ينهمر",96,"ر",1,0],["أناخَ بها فالبِشْرُ فيها مخيمٌ","وطَيْر تُهَانيها الغريضُ ومعْبَدُ",97,"د",1,0],["إن أخذوا بالذنوب مقترفا","خصُّوا وأن أمطروا ندىً عمُّوا",98,"م",3,0],["أناخوا المطيَّ وماءُ العيو","ن دمعٌ وصاحوا بها وهو دمْ",99,"م",1,0],["إن أخلف الربيعُ واستخلفهم","على العباد فعلوا فعالَه",100,"ل",2,0],["أناخ بكم مستسقياً بعضَ ليلةٍ","ولم يدْرِ أن الموتَ منها ضحى الغدِ",101,"د",1,0],["أناخوا إلى تعريسةٍ قلَّ عُمرُها","فما هي إلا خَفقةٌ وهبوبُ",102,"ب",1,0],["أناخوا بإقْبالٍ فَجادَ أكفُّهمْ","نوالٌ إذا ما أمسك الغيثُ هاطِلُ",103,"ل",1,0],["أناخوا ففضُّوا مُرتجاتٍ تضايقت","بأشهبَ خوَّار المعاجم لاصقِ",104,"ق",1,0],["أناخت بربع العز من سيف دجلة","إِلى ذروةِ أعْيا الملوكَ مَرامُها",105,"م",3,0],["أناخَتْ حَدابيرُ السنينَ بأرضهِ","فلا مخضماً أضحت ولا هي مَقْضمُ",106,"م",1,0],["أناخ بمُحيْي العدل فانكشفتْ لهُ","مواحلُه عن أغْيد النَّبْتِ ناضِرِ",107,"ر",1,0],["أناخَ إلى بدرِ المكارمِ والعُلى","بأوشكِ مِطْعامٍ وأمْنَعِ مؤْثِل",108,"ل",1,0],["إن أخلف العام الجمادُ فمقلتي","لنواك موءُ صبابةٍ لم يخلف",109,"ف",1,0],["أَناخَت عَلى كَبِدي عِلَّةٌ","فَعادَ الرِجالِ وَعادَ النِساءُ",110,"ا",2,0],["أنا خالص قد قلت إني خالص","في الحب لم تكذب علي ذنوب",111,"ب",1,0],["أناخ في قلب ليلى هاجس الشجن","أيان ترنو بجفنيها إلى الوسن",112,"ن",1,1],["أناخوا مطاياهم بأعتاب موكب","وأدلجهم حادي الهوى والهوى دان",113,"ن",1,0],["أَنا ختمُ الوَلايَةِ المُتَدلِّي","في سَمَواتِ مِرْطِها البرَّاقِ",114,"ق",1,0],["إن أخرتني عن جنابك محنة","بأقل منها تبسط الأعذار",115,"ر",1,0],["إن اختط معمور الرقاب أعادها","خراباً ويختط الربوع ليعمرا",116,"ر",2,0],["أناخَ عَلَيْهِ كَلْكَلُ البَيْنِ كُلِّهِ","وأنْحَى عَلَيْهِ الهَجْرُ من كُلِّ جانِبِ",117,"ب",1,0],["إنَّ إخلاَصا منكُمُ لِىَ إخلا","صٌ لِفَنٍّ علَى مَمَرِّ السِّنِين",118,"ن",1,0],["أنا خاطرتُ في هواك بقلبٍ","ركب البحرَ فيك أَباً وأُمّا",119,"م",2,0],["أنَا خارجيٌّ في الهوى","لا حُكمَ إلّا للمِلاحِ",120,"ح",1,0],["أَناخَت بِكَ الأَسفارُ وَالبيدُ أَينُقاً","رَمَتكَ بِها آمالُ غافينَ وُفَّدِ",121,"د",1,0],["أَناخَ عَلَيها أَغبَرُ اللَونِ أَجوَفٌ","فَصارَت لَهُ قَلباً وَصارَ لَها صَدرا",122,"ر",2,0],["أنا خمار ديرها وكفوفي","هذه عند أهلها أكواب",123,"ب",1,0],["أَناخَ بها البارقُ الممطِرُ","ومرَّ النسيمُ بِها يخْطرُ",124,"ر",1,1],["إِن اخْتفى البدرُ بالدَّلالِ أَو ال","هجرِ مَلالاً فلا بَدا أَبَدا",125,"د",2,0]]}