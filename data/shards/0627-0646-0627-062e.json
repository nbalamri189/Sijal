/poem13713.html","الطويل"],[460,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[460,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[460,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[460,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[460,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[463,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[463,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15305.html","الطويل"],[463,"عليها ذمام الله من كل ذاعر","https://www.aldiwan.net/poem15462.html","الطويل"],[463,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[463,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[463,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[466,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[470,"أيا من تناقص منه الحياء","https://www.aldiwan.net/poem60519.html","المتقارب"],[481,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[481,"أناخ في قلب ليلى هاجس الشجن","https://www.aldiwan.net/poem37572.html","البسيط"],[484,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[502,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[517,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[517,"سرى لك عرف في النسيم الذي سرى","https://www.aldiwan.net/poem12108.html","الطويل"],[531,"أيا بين كم كدرت صفو المشارب","https://www.aldiwan.net/poem37536.html","الطويل"],[540,"يا رعى الله إخوة كرموني","https://www.aldiwan.net/poem47601.html","عموديه"],[553,"قل لمن خده من اللحظ دام","https://www.aldiwan.net/poem47221.html","الخفيف"],[553,"بيني وبين عواذلي","https://www.aldiwan.net/poem47885.html","مجزوء الكامل"],[555,"خيال من النائي الهوى المتبعد","https://www.aldiwan.net/poem68426.html","الطويل"],[555,"وساحرة العينين ما تحسن السحرا","https://www.aldiwan.net/poem68429.html","الطويل"],[560,"أنا عندي أن الشهود حجاب","https://www.aldiwan.net/poem34967.html","الخفيف"],[577,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[577,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"],[610,"","https://poetry.dctabudhabi.ae/diwan/poem/97726","الطويل"],[752,"","https://poetry.dctabudhabi.ae/diwan/poem/123626","الوافر"]],"verses":[["إِن أَخلَفَ الوَعدَ حيٌّ يظعَنونَ غَدا","وَفَى لِيَ الطَّرفُ مِن دَمعي بِما وَعَدا",0,"د",2,1],["أَنَّ إِخوانِنا الأَرَاقِمَ يَغلو","نَ عَلَينا في قَولِهِم إِحفاءُ",1,"ا",2,0],["إِنَّ أَخي لَيسَ بِتَرعِيَّةٍ","نِكسٍ هَواءِ القَلبِ ذي ماشِيَه",2,"ي",2,0],["أَناخَت بِها الأَشراطُ وَاِستَوفَضَت بِها","حَصى الرَملِ راداتُ الرِياحِ الهَواجِمِ",3,"م",1,0],["أَناخوا وَنَجمٌ لاحَ بارِقُ ضَوئِهِ","يُخالِفُ شَرقِيَّ النُجومِ تِهامِ",4,"م",1,0],["أَناخَ فَما تَوَسَّدَ غَيرَ كَفٍّ","لَوى بِبَنانِها طَرَفَ الزِمامِج",5,"م",2,0],["أَناخَت رَوايا كُلِّ دلُوِيَّةٍ بِها","وَكُلِّ سِماكيٍّ مِلُثِ المَبارِكِ",6,"ك",1,0],["أَناخوا فَأَغفوا عِندَ أَيدي قَلائِصِ","خِماصٍ عَلَيها أَرحُلٌ وَطَنافِسُ",7,"س",1,0],["أَناخوا لِتُطوى تَحتَ أَعجازِ سُدفَةٍ","أَيادي المَهارى وَالجُفونُ سَواهِدُ",8,"د",1,0],["إن أخرجوك من المواطن مُكرَهاً","فالشعب خلفك هائج لا يهجع",9,"ع",1,0],["أَناخوا قَليلاً ثُمَّ هاجوا قَلائِصاً","كَما هيجَ خَيطٌ مَغرِبَ الشَمسِ جافِلُ",10,"ل",1,0],["أَناخوا بِوَهّابِ النَفائيسِ ماجِدٍ","يُقاسِمُهُم أَموالَهُ وَيُشاطِرُ",11,"ر",1,0],["إن أخرت بيروت عود جوادها","فنداك يدعونا لخيرِ جواد",12,"د",1,0],["إن أخرتني عن مديحك فترة","فعلى رجائي فيك أن أتقدّما",13,"م",2,1],["إن أخلاقك العِذابَ حكَتْها","عند حَرِّ الصدى النِّطافُ العِذابُ",14,"ب",1,0],["إنَّ أخاك الذي تُزاولُه","ما زال مذ قال أهلُه حَلُما",15,"م",2,0],["أَناخوا فَجَرّوا شاصِياتٍ كَأَنَّها","رِجالٌ مِنَ السودانِ لَم يَتَسَربَلوا",16,"ل",3,0],["أَنا خَيرُ مَن قالَ القَوافِيَ مادِحاً","أَنا خَيرُ من قالَ القَوافِيَ هاجي",17,"ج",2,0],["إِن أَخطَأَ الخَزّافُ في جَبلِهِ ال","طينَ فَأَيُّ ذَنبٍ لِلآنِيَه",18,"ه",1,0],["أَناخوا بِأَشوالٍ إِلى أَهلِ خُبَّةٍ","طُروقاً وَقَد أَقعى سُهَيلاً فَعَرَّدا",19,"د",2,0],["أنا خدت الدمع في قلبي","وأكتم في القلب أسايه",20,"ا",3,0],["إن أخذنا الكبريت ثم خلطنا","جسداً ميتاً به وسقينا",21,"ن",2,1],["إِنَّ إِخوانَكَ المُقيمينَ بِالأَم","سِ أَتَوا لِلزِناءِ لا لِلغِناءِ",22,"ا",2,0],["إِن أَخلَقَت حُرُقاتٌ مِن صَبابَتِهِ","تَرادَفَت حُرُقاتٌ بَعدَها جُدُدُ",23,"د",1,0],["إِن أَخَفَّ الكُتّابُ في الوَزنِ غَدرٌ","رَجَحَت كِفَّةُ الوَفِيِّ الوافي",24,"ف",2,0],["إِن أَخلَفَ القَطرُ أَو أَكدَت مَخيلَتُهُ","كانَت يَداهُ لَنا مِن صَوبِهِ خَلَفا",25,"ف",2,0],["إِن أَخَسَّت تِلكَ الحَقائِقُ حَظّي","أَجزَلَت هَذِهِ الأَمانِيُّ قِسمي",26,"م",2,0],["أَناخَت بِهِ كُلُّ رَجّاسَةٍ","وَساكِبَةِ الماءِ لَم تُرعِدِ",27,"د",1,0],["أَناخَ بِهِم مُغاضَبَةً فَلاقى","شَعوبَ المَوتِ أَو حَلَقَ الإِسارِ",28,"ر",1,0],["أَناخَت بِها وَسطَ البُيوتِ نِساؤُنا","وَقَد أُعجِلَت شَدَّ الرِحالِ اِكتِفالُها",29,"ل",3,0],["أَناخَ إِلى بَيتٍ عَطِيَّةَ تَحتَهُ","إِلَيهِ ذُرى اللُؤمِ اِستَقَرَّت مَسايِلُه",30,"ل",2,0],["أَناخوا لِكِسرى حينَ جاءَت جُنودُهُ","وَبَهراءَ إِذ جاءَت وَجَمعُ الأَراقِمِ",31,"م",1,0],["أَناخَ إِلَيكُم طالِبٌ طالَ ما نَأَت","بِهِ الدارُ دانٍ بِالقَرابَةِ عالِمِ",32,"م",1,1],["أَناخَ إِلَيها اِبنايَ ضَيفَي مَقامَةٍ","إِلى عُصبَةٍ ما تُستَعارُ ثِيابُها",33,"ب",3,0],["أَناخوا بِأَيدي طاعَةٍ وَسُيوفُهُم","عَلى أُمَّهاتِ الهامِ ضَرباً شَآمِيا",34,"ي",2,0],["إِن أَخرَسَت فِلَذُ العَقيرِ كِلابَهُم","دَعَوُا الضُيوفَ بِأَلسُنِ النيرانِ",35,"ن",1,0],["إِنّا خَدَمنا القِلى جَهلاً بِنا وَعَمىً","فَاليَومَ نَحنُ جَميعاً لِلرِضا خَدَمُ",36,"م",1,0],["أَنَا خَاشِعٌ لِجَلالِ قُدْرَتِهِ","مُتَقَلِّبُ الْجَنْبَيْنِ أَوَّاهُ",37,"ا",2,0],["أنا خالدٌ في لوعةٍ","وجوى يشيبُ لهُ الوليدْ",38,"د",1,0],["أَناخَ هَوى لَيلى بِهِ فَأَذابَهُ","وَمَن ذا يُطيقُ الصَبرَ عَن مَحمَلِ الحُبِّ",39,"ب",1,0],["إنّا خرجنا نريدُ اللهَ فاسْتَبِقُوا","من كلِّ مُنتَهِبٍ للخيرِ مُهْتَبِلِ",40,"ل",1,0],["أَنا خائِفٌ مِن شَرِّها مُتَوَقِّعٌ","إِكآبَها لا الشُربَ مِن أَكوابِها",41,"ب",3,0],["إِن أَخلَفَتكَ اليَومَ مَوعِدَها","فَعُرفُها جارٍ بِإِخلافِها",42,"ف",3,0],["إن أخفق الإنسان في عمل له","ذم الزَمان وَعاتب الأقدارا",43,"ر",2,1],["أَناخوا المَطايا حين أدرك لَيلها","بمأسدة فيها الحماة قَليل",44,"ل",1,0],["أَنَاخَ بِرَمْلِ الكَوْمَحَيْن إِنَاخَةَ اليَمَانِي","قِلاَصاً حَطَّ عَنْهُنَّ أَكْوُرَا",45,"ر",2,0],["أناخَ على سَرَوَاتِ العراق","فقصَّفَ أفنانَها الوارفَه",46,"ف",2,0],["إِنْ أَخْلَقَتْ جِدَّةُ الأَشْعَارِ أَثَّلَهَا","لَفْظٌ أَصِيلٌ وَمَعْنىً غَيْرُ مُنْتَحَلِ",47,"ل",1,0],["إِنْ أَخْطَأَتْ قُطْراً مَوَاقِعُ غَيْثِهَا","أَحْظَتْهُ بِاللَّمَحَاتِ وَالأَصْدَاءِ",48,"ا",2,0],["إِنْ أَخْلَدَ المَرْءَ حُسْنُ فِعْلٍ","فَأَنْتَ بِالْخَالِدَات بَاقِ",49,"ق",1,0],["أَنا خِلُّ كُلِّ فَتىً إِذا أَيقَظتُهُ","أَيقَظتُ كَالنَضاضِ أَو كَالعادي",50,"د",2,0],["إِن أَخَذنا سِلاحَنا أَو تَرَكنا","فَسواءٌ في المَوتِ أَخذٌ وَتَركُ",51,"ك",1,0],["أناخ بهم في الأمن خوفٌ أراهمُ","كأنهمُ يمشون فوق شفير",52,"ر",1,0],["إنا خطبنا المجدَ، فل","تجر الأمور كما تشاء",53,"ا",2,0],["إن إخواننا الأراقم يغلو","ن علينا في قيلهم إحفاء",54,"ا",2,0],["أنا خاطرت بنفسي في الهوى","والهوى لذَّتهُ في الخَطَر",55,"ر",1,0],["انا خصم كل منافق ! لم يَنْهَني","حَذرٌ ولم يقعُد بي الكِتمان",56,"ن",1,0],["إِنْ أَخلفَ القَطرُ أَوكدتْ مَخِيلَتُهُ","كاَنَتْ يَدَاهُ لنا من صَوْبِهِ خَلَفَا",57,"ف",2,0],["أناخوا الذنوب المثقلات لواغبا","بأفيح  من عفو الإله  رحيب",58,"ب",1,0],["أناخوا بأشوالٍ إلى أهلِ خبّة","ٍ طروقًا وقدْ أقعى سهيلٌ فعرّدا",59,"د",2,0],["إن أخس القديم حظى فهذا","مجزلٌ قسمتي ومورٍ زندي",60,"د",2,0],["أناخ على الدنيا الظلام بكلكلٍ","وأغرقها في زاخر متلاطم",61,"م",1,0],["إنا خلقنا للتصبرِ والأسَى","والنوحُ والأحزانُ للنِّسْوَانِ",62,"ن",1,0],["إِن أخلَقَت هَذِي اللَّيَالِي خِلقَتِي","فَخَلِيقَتِي جَلَّت عَنِ الإخلاَقِ",63,"ق",1,1],["إن أخطأتْ واصلت اعتذارَها","وإن أصابت فهو من صوابهِ",64,"ب",2,0],["أناخوا على حسن اليقين جمالهم","على بابك العالي فاكسبتهم يمنا",65,"ن",2,0],["إِن أَخربت تلك السيوف ديارهم","أَعنى الأَعادي فالقبور عوامر",66,"ر",1,0],["إنّا خذلنا الشعرَ من زمنٍ","كَمْ من قصيدٍ قيلَ في الَعذَلِ",67,"ل",1,0],["أَناخَ بِها رَكب الغِواية عائِشاً","وَجاسَ حِماها مَربَعاً ثُمَ مَربَعا",68,"ع",2,0],["إنِ اخْتَصرتُ قَريضي في المديحِ فقد","يُنال سامي العُلَى بالباترِ الخذم",69,"م",1,0],["أَناخوا وَقَد طالَ الكَرى فَكَأَنَّهُم","سُكارى تَحاذَوا صَحنَ راحٍ مُخَضرَمِ",70,"م",1,0],["أَناخوا قَليلاً ثُمَّ نَبَّهَ نَومَهُم","دُعاءٌ بُعَيدَ الفَهمِ ماضٍ مُعَمَّمِ",70,"م",1,0],["إن أخلفَتْ غرُّ السحابِ تهللوا","أو جَنَّ ليلُ الحادثاتِ أضاءوا",71,"ا",1,0],["إنا خلقنا لأمر","أراده ذو الجلال",72,"ل",1,0],["أَنا خَفيٌّ كَالسِرِّ أَو كَال","هلاكِ أَنقضُّ في ثَوانِ",73,"ن",1,0],["إن أخلف الغيثُ بات نائلهُ","يَخْلُف أنواءه وسُقْيَاها",74,"ا",3,0],["أَناخَت بِوَضّاحِ الجَبينِ مُمَدَّحٍ","وَما كُلُّ وَضّاحِ الجَبينِ مُمَدَّحُ",75,"ح",1,0],["أنا خادم الصدِّيق واسمي في الورى","عمرٌ ولكنّي أميل إلى علي",76,"ي",1,0],["أنا خاملٌ في بُقعةٍ مَجهُولةٍ","أَسرى بها أحرارُها وخيارها",77,"ر",3,0],["أناخوا بأرجاءِ الرجاءِ وعرسوا","فأصبح كلٌ مايز القدح فالجا",78,"ج",2,0],["أَناخَت عليه لم تراقب له عُلاً","فألوَت به خَسفاً وأَزرت به عَسفا",79,"ف",2,0],["إن أخذت مرآتها بعدما","ضممت طول الليل عطفيها",80,"ه",2,1],["أنا خير محضٌ ومن هم عبيدي","ليس الشر بينهم من مقام",81,"م",1,0],["انا خيال ارى حالي بلا حال","وفكرة ميتة بل خاطر بالِ",82,"ل",1,1],["أَنَاخَ رَجَاءَهُ بِحمِىَ عَزِيزٍ","وَمَدَّ يَدَ السُّؤَالِ إلى جَوَادِ",83,"د",1,0],["إن أخلَفَ الضيفَ رسلٌ عند حاجتنا","لم يخلف الضيف من أصلابها دسَمُ",84,"م",1,0],["إن أخلق الوُدُّ القديم فعِفْتَهُ","فَهُناك وُدُّ تَصطَفيهِ جَديد",85,"د",1,0],["إِن أَخلَفَ الخِلفُ مِن مِصرٍ فَوا عَطَشي","إِن رُمتُ في حَلَبٍ ما رُمتُ مِن حَلَبِ",86,"ب",1,0],["اناخ بيَ المشيبُ فلا براحٌ","وإن أوسعته عَتباً ولوما",87,"م",2,0],["أناخَ الشَيبُ ضَيفا لَم أُرِدهُ","وَلكِن لا أُطيقُ لَهُ مَرَدّا",88,"د",2,1],["أناخ بنجد واستراح ركابها","وعاد خلياً عن رحيل وعن شد",89,"د",1,0],["إن إخواننا الأُلى سبقونا","حين دارت من السرور الكؤوس",90,"س",1,1],["أنا خافٍ كَليلةِ القَدْرِ في النَّا","سِ وعالٍ كَليلَةِ القَدْرِ قَدْرا",91,"ر",2,0],["أَناخوا جِمالاً وَحازوا جَمالاً","أَظُنُّ الأَحِبَّةَ راموا اِرتِحالا",92,"ل",2,0],["إِن أَخلَف المُزنَ لَم تَخلِف أَنامِلُهُ","أَو أَمسِك الغَيثَ لَم تُمسِك مَواهِبُهُ",93,"ب",2,0],["إن أخْلَفُوا عَهدَك أو بدَّلُوا","فكُن بِحُسْن الصَّبرِ عنهُم خَليقْ",94,"ق",1,0],["أَناخَ عَلى الصَفصاف حَتّى اِستَباحَهُ","فَكابَرَهُ فيها أَلَجُّ مُكابِرُ",95,"ر",1,0],["أنا خائفٌ مترقّبٌ","فيها وذاكَ مثقَّفُ",96,"ف",1,0],["إن أخلفتنا عهاد المزن في زمنٍ","فإنّ جودك طول الدهر ينهمر",97,"ر",1,0],["أناخَ بها فالبِشْرُ فيها مخيمٌ","وطَيْر تُهَانيها الغريضُ ومعْبَدُ",98,"د",1,0],["إن أخذوا بالذنوب مقترفا","خصُّوا وأن أمطروا ندىً عمُّوا",99,"م",3,0],["أناخوا المطيَّ وماءُ العيو","ن دمعٌ وصاحوا بها وهو دمْ",100,"م",1,0],["إن أخلف الربيعُ واستخلفهم","على العباد فعلوا فعالَه",101,"ل",2,0],["أناخ بكم مستسقياً بعضَ ليلةٍ","ولم يدْرِ أن الموتَ منها ضحى الغدِ",102,"د",1,0],["أناخوا إلى تعريسةٍ قلَّ عُمرُها","فما هي إلا خَفقةٌ وهبوبُ",103,"ب",1,0],["أناخوا بإقْبالٍ فَجادَ أكفُّهمْ","نوالٌ إذا ما أمسك الغيثُ هاطِلُ",104,"ل",1,0],["أناخوا ففضُّوا مُرتجاتٍ تضايقت","بأشهبَ خوَّار المعاجم لاصقِ",105,"ق",1,0],["أناخت بربع العز من سيف دجلة","إِلى ذروةِ أعْيا الملوكَ مَرامُها",106,"م",3,0],["أناخَتْ حَدابيرُ السنينَ بأرضهِ","فلا مخضماً أضحت ولا هي مَقْضمُ",107,"م",1,0],["أناخ بمُحيْي العدل فانكشفتْ لهُ","مواحلُه عن أغْيد النَّبْتِ ناضِرِ",108,"ر",1,0],["أناخَ إلى بدرِ المكارمِ والعُلى","بأوشكِ مِطْعامٍ وأمْنَعِ مؤْثِل",109,"ل",1,0],["إن أخلف العام الجمادُ فمقلتي","لنواك موءُ صبابةٍ لم يخلف",110,"ف",1,0],["أَناخَت عَلى كَبِدي عِلَّةٌ","فَعادَ الرِجالِ وَعادَ النِساءُ",111,"ا",2,0],["أنا خالص قد قلت إني خالص","في الحب لم تكذب علي ذنوب",112,"ب",1,0],["أناخ في قلب ليلى هاجس الشجن","أيان ترنو بجفنيها إلى الوسن",113,"ن",1,1],["أناخوا مطاياهم بأعتاب موكب","وأدلجهم حادي الهوى والهوى دان",114,"ن",1,0],["أَنا ختمُ الوَلايَةِ المُتَدلِّي","في سَمَواتِ مِرْطِها البرَّاقِ",115,"ق",1,0],["إن أخرتني عن جنابك محنة","بأقل منها تبسط الأعذار",116,"ر",1,0],["إن اختط معمور الرقاب أعادها","خراباً ويختط الربوع ليعمرا",117,"ر",2,0],["أناخَ عَلَيْهِ كَلْكَلُ البَيْنِ كُلِّهِ","وأنْحَى عَلَيْهِ الهَجْرُ من كُلِّ جانِبِ",118,"ب",1,0],["إنَّ إخلاَصا منكُمُ لِىَ إخلا","صٌ لِفَنٍّ علَى مَمَرِّ السِّنِين",119,"ن",1,0],["أنا خاطرتُ في هواك بقلبٍ","ركب البحرَ فيك أَباً وأُمّا",120,"م",2,0],["أنَا خارجيٌّ في الهوى","لا حُكمَ إلّا للمِلاحِ",121,"ح",1,0],["أَناخَت بِكَ الأَسفارُ وَالبيدُ أَينُقاً","رَمَتكَ بِها آمالُ غافينَ وُفَّدِ",122,"د",1,0],["أَناخَ عَلَيها أَغبَرُ اللَونِ أَجوَفٌ","فَصارَت لَهُ قَلباً وَصارَ لَها صَدرا",123,"ر",2,0],["أنا خمار ديرها وكفوفي","هذه عند أهلها أكواب",124,"ب",1,0],["أَناخَ بها البارقُ الممطِرُ","ومرَّ النسيمُ بِها يخْطرُ",125,"ر",1,1],["إِن اخْتفى البدرُ بالدَّلالِ أَو ال","هجرِ مَلالاً فلا بَدا أَبَدا",126,"د",2,0],["أَناخَت عَليكم خيلُ يومِ كريهةٍ","فَما إن تملّوها ولا هي ملّتِ",127,"ت",1,0],["أناخت حائل جدباء نابي","فلم تترك لطلحتنا فنونا",128,"ن",2,0]]}