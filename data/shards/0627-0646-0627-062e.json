{"poems":[[63,"إن أخلف الوعد حي يظعنون غدا","https://www.aldiwan.net/poem45680.html","البسيط"],[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[10,"أبنت صخر تلكما الباكية","https://www.aldiwan.net/poem21145.html","السريع"],[30,"خليلي عوجا اليوم حتى تسلما","https://www.aldiwan.net/poem29528.html","الطويل"],[30,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[30,"ألا حي المنازل بالسلام","https://www.aldiwan.net/poem29530.html","الوافر"],[30,"أقول لأطلاح برى هطلانها","https://www.aldiwan.net/poem29552.html","الطويل"],[30,"ألم تسأل اليوم الرسوم الدوارس","https://www.aldiwan.net/poem29577.html","الطويل"],[30,"ألا أيها الربع الذي غير البلى","https://www.aldiwan.net/poem29602.html","الطويل"],[88,"ياسين إنك بالقلوب مشيع","https://www.aldiwan.net/poem44806.html","الكامل"],[27,"شعفت بعهد ذكرته المنازل","https://www.aldiwan.net/poem5966.html","الطويل"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[72,"روحي فداء مهفهف مياد","https://www.aldiwan.net/poem18606.html","الكامل"],[72,"إن أخرتني عن مديحك فترة","https://www.aldiwan.net/poem20044.html","الكامل"],[51,"كم نسام الأذى كأنا كلاب","https://www.aldiwan.net/poem8534.html","الخفيف"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[29,"عفا واسط من آل رضوى فنبتل","https://www.aldiwan.net/poem6022.html","الطويل"],[91,"لما سكت حسبت أنك ناج","https://www.aldiwan.net/poem8786.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[38,"وما مزنة جادت فأسبل ودقها","https://www.aldiwan.net/poem7709.html","الطويل"],[85,"الليل بدموعه جاني","https://www.aldiwan.net/poem6808.html","عموديه"],[62,"إن أخذنا الكبريت ثم خلطنا","https://www.aldiwan.net/poem52210.html","الخفيف"],[45,"ياعلي بل يا أبا الحسن المالك","https://www.aldiwan.net/poem10199.html","الخفيف"],[45,"يكاد يبدي لسعدى غيب ما أجد","https://www.aldiwan.net/poem63477.html","البسيط"],[45,"ألما فات من تلاق تلاف","https://www.aldiwan.net/poem65153.html","الخفيف"],[45,"إستقبلا الركب في أطلالهم وقفا","https://www.aldiwan.net/poem65170.html","البسيط"],[45,"أأراك الحبيب خاطر وهم","https://www.aldiwan.net/poem65655.html","الخفيف"],[28,"عرفت المنازل من مهدد","https://www.aldiwan.net/poem5043.html","المتقارب"],[28,"وعائذة التي كانت تميم","https://www.aldiwan.net/poem5237.html","الوافر"],[28,"إذا اعتركت في راحتي كل مجمد","https://www.aldiwan.net/poem5385.html","الطويل"],[28,"رأيت جريرا لم يضع عن حماره","https://www.aldiwan.net/poem5424.html","الطويل"],[28,"إني وإن كانت تميم عمارتي","https://www.aldiwan.net/poem5528.html","الطويل"],[28,"أناخ إليكم طالب طال ما نأت","https://www.aldiwan.net/poem5601.html","الطويل"],[28,"أبى الحزن أن أسلى بني وسورة","https://www.aldiwan.net/poem5648.html","الطويل"],[28,"لعمري لقد نبهت يا هند ميتا","https://www.aldiwan.net/poem5649.html","الطويل"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[44,"شعبي وشعب عبيد الله ملتئم","https://www.aldiwan.net/poem29705.html","البسيط"],[87,"ديني الحنيف وربي الله","https://www.aldiwan.net/poem8200.html","أحذ الكامل"],[69,"يا من سبى شمس الضحى","https://www.aldiwan.net/poem28073.html","مجزوء الكامل"],[33,"لقد هم قيس أن يزج بنفسه","https://www.aldiwan.net/poem25990.html","الطويل"],[105,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[46,"لا تلبس الدنيا فإن لباسها","https://www.aldiwan.net/poem22351.html","الكامل"],[46,"كأنما دنياك وحشية","https://www.aldiwan.net/poem23002.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85627","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85444","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39558","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55057","البسيط"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[106,"رثاء طيارين!","https://www.poetsgate.com/ViewPoem.aspx?id=179490",""],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[90,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[90,"لبنان في العراق","https://www.poetsgate.com/ViewPoem.aspx?id=178952",""],[45,"اسْتَوقِفا الرَّكبَ في أَطْلالِهم، وقِفا","https://www.poetsgate.com/ViewPoem.aspx?id=32848",""],[38,"وما مزنة ٌ جادتْ فأسبلَ ودقها","https://www.poetsgate.com/ViewPoem.aspx?id=21184",""]],"verses":[["إِن أَخلَفَ الوَعدَ حيٌّ يظعَنونَ غَدا","وَفَى لِيَ الطَّرفُ مِن دَمعي بِما وَعَدا",0,"د",2,1],["أَنَّ إِخوانِنا الأَرَاقِمَ يَغلو","نَ عَلَينا في قَولِهِم إِحفاءُ",1,"ا",2,0],["إِنَّ أَخي لَيسَ بِتَرعِيَّةٍ","نِكسٍ هَواءِ القَلبِ ذي ماشِيَه",2,"ي",2,0],["أَناخَت بِها الأَشراطُ وَاِستَوفَضَت بِها","حَصى الرَملِ راداتُ الرِياحِ الهَواجِمِ",3,"م",1,0],["أَناخوا وَنَجمٌ لاحَ بارِقُ ضَوئِهِ","يُخالِفُ شَرقِيَّ النُجومِ تِهامِ",4,"م",1,0],["أَناخَ فَما تَوَسَّدَ غَيرَ كَفٍّ","لَوى بِبَنانِها طَرَفَ الزِمامِج",5,"م",2,0],["أَناخَت رَوايا كُلِّ دلُوِيَّةٍ بِها","وَكُلِّ سِماكيٍّ مِلُثِ المَبارِكِ",6,"ك",1,0],["أَناخوا فَأَغفوا عِندَ أَيدي قَلائِصِ","خِماصٍ عَلَيها أَرحُلٌ وَطَنافِسُ",7,"س",1,0],["أَناخوا لِتُطوى تَحتَ أَعجازِ سُدفَةٍ","أَيادي المَهارى وَالجُفونُ سَواهِدُ",8,"د",1,0],["إن أخرجوك من المواطن مُكرَهاً","فالشعب خلفك هائج لا يهجع",9,"ع",1,0],["أَناخوا قَليلاً ثُمَّ هاجوا قَلائِصاً","كَما هيجَ خَيطٌ مَغرِبَ الشَمسِ جافِلُ",10,"ل",1,0],["أَناخوا بِوَهّابِ النَفائيسِ ماجِدٍ","يُقاسِمُهُم أَموالَهُ وَيُشاطِرُ",11,"ر",1,0],["إن أخرت بيروت عود جوادها","فنداك يدعونا لخيرِ جواد",12,"د",1,0],["إن أخرتني عن مديحك فترة","فعلى رجائي فيك أن أتقدّما",13,"م",2,1],["إن أخلاقك العِذابَ حكَتْها","عند حَرِّ الصدى النِّطافُ العِذابُ",14,"ب",1,0],["إنَّ أخاك الذي تُزاولُه","ما زال مذ قال أهلُه حَلُما",15,"م",2,0],["أَناخوا فَجَرّوا شاصِياتٍ كَأَنَّها","رِجالٌ مِنَ السودانِ لَم يَتَسَربَلوا",16,"ل",3,0],["أَنا خَيرُ مَن قالَ القَوافِيَ مادِحاً","أَنا خَيرُ من قالَ القَوافِيَ هاجي",17,"ي",1,0],["إِن أَخطَأَ الخَزّافُ في جَبلِهِ ال","طينَ فَأَيُّ ذَنبٍ لِلآنِيَه",18,"ه",1,0],["أَناخوا بِأَشوالٍ إِلى أَهلِ خُبَّةٍ","طُروقاً وَقَد أَقعى سُهَيلاً فَعَرَّدا",19,"د",2,0],["أنا خدت الدمع في قلبي","وأكتم في القلب أسايه",20,"ا",3,0],["إن أخذنا الكبريت ثم خلطنا","جسداً ميتاً به وسقينا",21,"ن",2,1],["إِنَّ إِخوانَكَ المُقيمينَ بِالأَم","سِ أَتَوا لِلزِناءِ لا لِلغِناءِ",22,"ا",2,0],["إِن أَخلَقَت حُرُقاتٌ مِن صَبابَتِهِ","تَرادَفَت حُرُقاتٌ بَعدَها جُدُدُ",23,"د",1,0],["إِن أَخَفَّ الكُتّابُ في الوَزنِ غَدرٌ","رَجَحَت كِفَّةُ الوَفِيِّ الوافي",24,"ي",1,0],["إِن أَخلَفَ القَطرُ أَو أَكدَت مَخيلَتُهُ","كانَت يَداهُ لَنا مِن صَوبِهِ خَلَفا",25,"ف",2,0],["إِن أَخَسَّت تِلكَ الحَقائِقُ حَظّي","أَجزَلَت هَذِهِ الأَمانِيُّ قِسمي",26,"ي",1,0],["أَناخَت بِهِ كُلُّ رَجّاسَةٍ","وَساكِبَةِ الماءِ لَم تُرعِدِ",27,"د",1,0],["أَناخَ بِهِم مُغاضَبَةً فَلاقى","شَعوبَ المَوتِ أَو حَلَقَ الإِسارِ",28,"ر",1,0],["أَناخَت بِها وَسطَ البُيوتِ نِساؤُنا","وَقَد أُعجِلَت شَدَّ الرِحالِ اِكتِفالُها",29,"ل",3,0],["أَناخَ إِلى بَيتٍ عَطِيَّةَ تَحتَهُ","إِلَيهِ ذُرى اللُؤمِ اِستَقَرَّت مَسايِلُه",30,"ل",2,0],["أَناخوا لِكِسرى حينَ جاءَت جُنودُهُ","وَبَهراءَ إِذ جاءَت وَجَمعُ الأَراقِمِ",31,"م",1,0],["أَناخَ إِلَيكُم طالِبٌ طالَ ما نَأَت","بِهِ الدارُ دانٍ بِالقَرابَةِ عالِمِ",32,"م",1,1],["أَناخَ إِلَيها اِبنايَ ضَيفَي مَقامَةٍ","إِلى عُصبَةٍ ما تُستَعارُ ثِيابُها",33,"ب",3,0],["أَناخوا بِأَيدي طاعَةٍ وَسُيوفُهُم","عَلى أُمَّهاتِ الهامِ ضَرباً شَآمِيا",34,"ي",2,0],["إِن أَخرَسَت فِلَذُ العَقيرِ كِلابَهُم","دَعَوُا الضُيوفَ بِأَلسُنِ النيرانِ",35,"ن",1,0],["إِنّا خَدَمنا القِلى جَهلاً بِنا وَعَمىً","فَاليَومَ نَحنُ جَميعاً لِلرِضا خَدَمُ",36,"م",1,0],["أَنَا خَاشِعٌ لِجَلالِ قُدْرَتِهِ","مُتَقَلِّبُ الْجَنْبَيْنِ أَوَّاهُ",37,"ا",2,0],["أنا خالدٌ في لوعةٍ","وجوى يشيبُ لهُ الوليدْ",38,"د",1,0],["أَناخَ هَوى لَيلى بِهِ فَأَذابَهُ","وَمَن ذا يُطيقُ الصَبرَ عَن مَحمَلِ الحُبِّ",39,"ب",1,0],["إنّا خرجنا نريدُ اللهَ فاسْتَبِقُوا","من كلِّ مُنتَهِبٍ للخيرِ مُهْتَبِلِ",40,"ل",1,0],["أَنا خائِفٌ مِن شَرِّها مُتَوَقِّعٌ","إِكآبَها لا الشُربَ مِن أَكوابِها",41,"ب",3,0],["إِن أَخلَفَتكَ اليَومَ مَوعِدَها","فَعُرفُها جارٍ بِإِخلافِها",42,"ف",3,0],["إن أخفق الإنسان في عمل له","ذم الزَمان وَعاتب الأقدارا",43,"ر",2,1],["أَناخوا المَطايا حين أدرك لَيلها","بمأسدة فيها الحماة قَليل",44,"ل",1,0],["أناخَ على سَرَوَاتِ العراق","فقصَّفَ أفنانَها الوارفَه",45,"ف",2,0],["إِنْ أَخْلَقَتْ جِدَّةُ الأَشْعَارِ أَثَّلَهَا","لَفْظٌ أَصِيلٌ وَمَعْنىً غَيْرُ مُنْتَحَلِ",46,"ل",1,0],["إِنْ أَخْطَأَتْ قُطْراً مَوَاقِعُ غَيْثِهَا","أَحْظَتْهُ بِاللَّمَحَاتِ وَالأَصْدَاءِ",47,"ا",2,0],["إِنْ أَخْلَدَ المَرْءَ حُسْنُ فِعْلٍ","فَأَنْتَ بِالْخَالِدَات بَاقِ",48,"ق",1,0],["أَنا خِلُّ كُلِّ فَتىً إِذا أَيقَظتُهُ","أَيقَظتُ كَالنَضاضِ أَو كَالعادي",49,"ي",1,0],["إِن أَخَذنا سِلاحَنا أَو تَرَكنا","فَسواءٌ في المَوتِ أَخذٌ وَتَركُ",50,"ك",1,0],["أناخ بهم في الأمن خوفٌ أراهمُ","كأنهمُ يمشون فوق شفير",51,"ر",1,0],["إنا خطبنا المجدَ، فل","تجر الأمور كما تشاء",52,"ا",2,0],["إن إخواننا الأراقم يغلو","ن علينا في قيلهم إحفاء",53,"ا",2,0],["أنا خاطرت بنفسي في الهوى","والهوى لذَّتهُ في الخَطَر",54,"ر",1,0],["انا خصم كل منافق ! لم يَنْهَني","حَذرٌ ولم يقعُد بي الكِتمان",55,"ن",1,0],["إِنْ أَخلفَ القَطرُ أَوكدتْ مَخِيلَتُهُ","كاَنَتْ يَدَاهُ لنا من صَوْبِهِ خَلَفَا",56,"ف",2,0],["أناخوا بأشوالٍ إلى أهلِ خبّة","ٍ طروقًا وقدْ أقعى سهيلٌ فعرّدا",57,"د",2,0]]}