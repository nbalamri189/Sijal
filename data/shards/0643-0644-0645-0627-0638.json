{"poems":[[74,"ليل وصل معطر الأرجاء","https://www.aldiwan.net/poem18169.html","الخفيف"],[136,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[469,"صعدة القد وسيف الكحل","https://www.aldiwan.net/poem3530.html","عموديه"],[543,"يا له حبا اتحد","https://www.aldiwan.net/poem48224.html","عموديه"],[1607,"","https://poetry.dctabudhabi.ae/diwan/poem/73660","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83134","الرمل"],[4764,"ما يهمنّي تكدر ولا يهمنّي ازعله","https://www.poetsgate.com/ViewPoem.aspx?id=37125",""],[5442,"خل دمعي فقد اصاب مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=114777",""]],"verses":[["كلَّما ظنَّ جودَهُ في انتهاء","لائمٌ عادَ جودُهُ في ابتداء",0,"ا",2,0],["كلَّمَا ظَنَّ ذَاكَ هَذَا مُلِيماً","ظَنَّ هَذَا المَلِيمُ ذَاكَ المَلِيمَا",1,"م",2,0],["كلّما ظنّت بقلبي سلوةً","كفل الوجدَ مليُّ الكفل",2,"ل",1,0],["كُلَّما ظنَّ أنَّه","بلغَ الشَّأوَ والأمَد",3,"د",1,0],["كُلَّما ظَلَّ كاشِفاً طِينَ دَنٍّ","ظَنَّهُ فارِغاً فَأَطرَقَ فِكرا",4,"ر",2,0],["كُلَّما ظَنَّ سُلوّاً","كَذَبَت فيهِ ظُنونُه",5,"ن",2,0],["كلما ظللت دربي بالأماني والوعود","كلما زادت هواجس في خفوقي تشغله",6,"ل",2,1],["كلما ظن دمعه يطفئ الوج","د أثار الجوى وأذكى الغليلا",7,"ل",2,0]]}