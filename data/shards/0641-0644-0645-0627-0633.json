{"poems":[[55,"تطاط لها فيوشك أن تجلى","https://www.aldiwan.net/poem29856.html","الوافر"],[65,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[75,"ألم يأن أن يبكي الغمام على مثلي","https://www.aldiwan.net/poem11932.html","الطويل"],[10,"ألا أيها الديك المنادي بسحرة","https://www.aldiwan.net/poem21142.html","الطويل"],[29,"أكلفت تصعيد الحدوج الروافع","https://www.aldiwan.net/poem5914.html","الطويل"],[4,"أرى النفس لجت في رجاء مكذب","https://www.aldiwan.net/poem21149.html","الطويل"],[49,"ولي منة في رقاب الضباب","https://www.aldiwan.net/poem25271.html","المتقارب"],[53,"أحب المهرجان لأن فيه","https://www.aldiwan.net/poem7934.html","الوافر"],[40,"ماذا ذكرتم من قلوص عقرتها","https://www.aldiwan.net/poem7710.html","الطويل"],[91,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[64,"فديتك قد حان وقت الصبوح","https://www.aldiwan.net/poem52395.html","المتقارب"],[47,"سقاني القهوة السلسل","https://www.aldiwan.net/poem65570.html","المنسرح"],[68,"أقر بمهجتي لكم لساني","https://www.aldiwan.net/poem39676.html","الوافر"],[33,"رأيت بجنب الخيف هندا فراقني","https://www.aldiwan.net/poem41821.html","الطويل"],[50,"هجوت الفضل دهرا وهو عندي","https://www.aldiwan.net/poem65045.html","الوافر"],[52,"أحبى فيم خليت","https://www.aldiwan.net/poem64745.html","الهزج"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[11,"من الكرم العربي","https://www.poetsgate.com/ViewPoem.aspx?id=48445",""],[47,"سَقاني القَهْوَةَ السّلْسَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=32066",""],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[154,"تزودت من مدح النبي المؤيد","https://www.aldiwan.net/poem68589.html","الطويل"],[185,"لك الخير إن واعدت حماء فالقها","https://www.aldiwan.net/poem58799.html","الطويل"],[276,"مضى زمن الصبا فدع التصابي","https://www.aldiwan.net/poem52055.html","الوافر"],[422,"أعالج قلبا في هواكم معذبا","https://www.aldiwan.net/poem54034.html","الطويل"],[466,"وفتيان صدق من تميم تناثلوا","https://www.aldiwan.net/poem15083.html","الطويل"],[510,"الوصيّة","https://www.aldiwan.net/poem27795.html","الطويل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112478","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104554","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77661","الرجز"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19934","الطويل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119301","الطويل"],[1296,"","https://poetry.dctabudhabi.ae/diwan/poem/178097","الوافر"],[1496,"","https://poetry.dctabudhabi.ae/diwan/poem/131406","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113934","الطويل"],[1615,"","https://poetry.dctabudhabi.ae/diwan/poem/73665","المجتث"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67367","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101013","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26427","الوافر"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52043","الوافر"],[2019,"","https://poetry.dctabudhabi.ae/diwan/poem/177967","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109319","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89545","الطويل"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69489","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53074","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27846","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21480","الطويل"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17741","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129829","الطويل"],[2668,"","https://poetry.dctabudhabi.ae/diwan/poem/105581","الطويل"],[2721,"","https://poetry.dctabudhabi.ae/diwan/poem/20698","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202771","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100792","الطويل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71383","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102391","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102387","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108340",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92273","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91793","الوافر"],[3896,"","https://poetry.dctabudhabi.ae/diwan/poem/45541","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35482","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70165","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77100","الكامل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136954",""],[4429,"","https://poetry.dctabudhabi.ae/diwan/poem/138861",""],[4645,"","https://poetry.dctabudhabi.ae/diwan/poem/105478","الكامل"],[4717,"صريع ٌ بعرضِ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=199577",""],[5101,"أصابعه","https://www.poetsgate.com/ViewPoem.aspx?id=189333",""],[5476,"وَاسْتَقَالَ الْمَلَّاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=194683",""],[5823,"بكائية","https://www.poetsgate.com/ViewPoem.aspx?id=59148",""],[6320,"الأَمَةُ الآبِقَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84326&r=&rc=23",""]],"verses":[["فَلِم آسي وَقَد أَحرَزتُ مَجداً","كَفاني ما يُبَلِّغُني المَحَلّا",0,"ل",2,0],["فلَمْ أسَلِ المَعاصِمَ عنْ سِوارٍ","ولا عَنْ حَجْلها القَصَبَ الخِدالا",1,"ل",2,0],["فَلَم أَستَتِر حَربَ الفِجارِ وَلَم أُطِع","مُسَيلَمَةً إِذ قالَ إِنّي مِنَ الرُسلِ",2,"ل",1,0],["فَلَمّا سَمِعتُ النائِحاتِ يَنُحنَهُ","تَعَزَّيتُ وَاِستَيقَنتُ أَن لا أَخا لِيا",3,"ي",2,0],["فَلَمّا سَقَيتُ السُمَّ خِنزيرَ تَغلِبٍ","أَبا مالِكٍ جَدَّعتُ قَينَ الصَعاصِعِ",4,"ع",1,0],["فَلَم أُسدِ ما أَرعى وَتَبلٍ رَدَدتُهُ","وَأَنجَحتُ بَعدَ اللَهِ مِن خَيرِ مَطلَبِ",5,"ب",1,0],["فَلَمّا سَمِعتُ ضَجيجَ النِسا","ءِ نادَيتُ حارِ أَلا فَاِقصِرِ",6,"ر",1,0],["فلم أسألْ له خَلَفاً ولكنْ","دعوتُ اللَّه مجتهدَ الدعاءِ",7,"ا",2,0],["فَلَمّا سَقَيناها العَكيسَ تَمَلَّأَت","مَذاخِرُها وَاِزدادَ رَشحاً وَريدُها",8,"د",3,0],["فلما سمعت القول أسبلت أدمعا","جرت فسقت خدي وجيدي والنحرا",9,"ر",2,0],["فلما سُلبنَ الثيابَ أُبتلينَ","بسوداءَ موحشةِ المنظرِ",10,"ر",1,0],["فَلَمّا سَرَتِ الراحُ","بِهِ سَمَّحَ وَاِستَرسَل",11,"ل",1,0],["فَلِم أَسكَنتُمُ الأَحزانَ فيهِ","لِتَخرِبَه وَيَعفو رَسمُ ذِكري",12,"ر",2,0],["فَلَم أَستَطِعها غَيرَ أَن قَد بَدا لَنا","عَشِيَّةَ راحَت كَفُّها وَالمَعاصِمُ",13,"م",1,0],["فَلَمّا سوئِلَت عَنهُ رَقاشٌ","لِنَعلَمَ ما تَقولُ وَما يَقولُ",14,"ل",1,0],["فَلَم أَسمَع مِنَ الشَوقِ","عَلى سَمعي فَنوديتُ",15,"ت",1,0],["فَلَمّا سَقاهَا البأَسَ واِرتَدَّ لُبُّها","إِليها وَلَم يَتُرك لَها مُتَذَكَّرا",16,"ر",2,0],["فَلَمّا سَقاها البأسُ واِرتَدَّ هَمُّها","إِليها وَلَم يترُك لَها مُتأَخَّرا",17,"ر",2,0],["فلما سمعت الصوت اقبلت نحوه","بصوت كريم الجد حلو شمائله",18,"ل",2,0],["فَلَمّا سَرَتِ الرّاحُ","بهِ، أسْمَحَ، وَاستَرْسَلْ",19,"ل",1,0],["فَلَمَّا سَقَتْهُمْ قَالَ نَشْوَانُ يَمْزَحُ","أَتَسْقِينَنَا رَوْحاً وَجَفْنُكِ يَذْبَحُ",20,"ح",1,0],["فَلَمّا سَقاهُم لِلحُتوفِ سُلافَةً","مَضوا يَحسِبونَ السَيفَ وَالنَصل آفَةً",21,"ه",1,0],["فَلَمّا سَرَى عَن ساعِدَى وَلِحيَتِى","وَأَيقَنَ أَنِّى لَستُ حمّاءَ جَمجَمَا",22,"م",2,0],["فَلَم أَسألك ديناراً ودارا","وَلا ثوبا سوى ثوب الثواب",23,"ب",1,0],["فلم أستطبْ يا سعد مرعىً أرودُه","مريعاً ولم أستعذبِ اليوم مشربا",24,"ب",2,0],["فلم أستكن من صرف دهرٍ لحادثٍ","ولا ارتعتُ من وقع الخطوب لرائع",25,"ع",1,0],["فلما سألته أجاب: كأنّها","أنا أم كأنّني برسمِ مَثيلي",26,"ل",2,0],["فلم أستقي خمراً فينضب خالقي","وفي ثغرها خمر يجل عن الوصف",27,"ف",1,0],["فلما سَرَت أذكت لهيبَ غرامهِ","كذا النارُ بالأرواحِ تسري وتستشري",28,"ر",2,0],["فَلم أُسَفِّههُ بَل اَشتَريته","بِثَمنٍ بَخسٍ وَمُذ قَرَيته",29,"ه",1,0],["فلما سقته الدر أحجم قائماً","إليها قليلاً ثم ولى وولت",30,"ت",1,0],["فلما سما في سلم السوء سالكاً","خسيس سراط يحتذيه المجالس",31,"س",1,0],["فلم أسمع جواباً غير قول","عسى الأيام تجزيني بصبري",32,"ر",2,0],["فلم أستطع صبرا لما بي من الهوى","ولم يخف ما أضمرت والقلب فاضحي",33,"ح",2,0],["فلَمّا سرا عنها الدُجى الصبحُ آنسَت","بهِ جرسَ ذي طمرَينِ بالصَيدِ مُلهجِ",34,"ج",1,0],["فَلِم أُسَمَّى بِلِصٍّ","وَأَنتَ لِصُّ القُلوبِ",35,"ب",1,0],["فَلَمَّا سَألْتَ النَّاسِ عَنْكُمْ وَجَدْتُكُمْ","بَرَاذِينَ شُقْراً أُرْبِطَتْ حَوْلَ مِذْوَدِ",36,"د",1,0],["فلم أستطع صبراً على لوعة الأسى","وأنت خبير بالأسى كيف يصنع",37,"ع",1,0],["فَلَم آسَف عَلى دُنيا تَوَلَّت","وَلَم نُسبَق إِلى حُسنِ العَزاءِ",38,"ا",2,0],["فَلَمْ أُسعَفْ وَلَو أومَضْتَ شيئاً","سَبَقْتُ إلَيكَ رُكبَانَ البَرِيدِ",39,"د",1,0],["فلما سلوتُ الحُبَّ ألقيت ثقلهُ","وثقلُ الهوى لا كان للمرء شاغلُ",40,"ل",1,0],["فلم اسمع لها إلا أنيناً","تقول اصبر فموعدنا القيامه",41,"م",2,0],["فَلَّما سَمَت فيهِ النَجابَةُ وَاِرتَقى","إِلى غايَةٍ ما فَوقَها لِلفَتى قَصدُ",42,"د",1,0],["فَلَمّا سَمِعتُ الصَوتَ نادَيتُ نَحوَهُ","بِصَوتٍ كَريمِ الجَدِّ حُلوٍ شَمائِلُه",43,"ل",2,0],["فلما سجى بحر الدجى قيد الوجى","خطى العيس حتى لا ذَمِيلٌ ولا وخد",44,"د",1,0],["فلم أستطع عني دفاعاً ولم أكن","بما جاءني فيه مبشره أدري",45,"ر",2,0],["فَلمّا سَما استَدبَرنَهُ كَيفَ سَدوه","بِها ناهضَ الدَّأياتِ فَعماً مُلَملَما",46,"م",2,0],["فَلَمّا سَمِعتُ الصَوتَ عَوَّجَ صُحبَتي","مَهارى مِنَ الإيجافِ صُعراً صَوادِيا",47,"ي",2,0],["فلم أسع إلا لارتياحٍ وراحة","وغيري وقد أواه غيرك يتعَبُ",48,"ب",1,0],["فلم أستطع خلفاً لأمرك إنه","لأمر على البرية واجب",49,"ب",1,0],["فَلَمّا سَقاهُ السُمَّ رُمحُ اِبنِ عَمِّهِ","تَذَكَّرَ ظُلمَ الأَهلِ أِيّ أَوانِ",50,"ن",1,0],["فلم استمع منه سوى ما يسرّني","ولم أرَ منه أيّ أمرٍ مخالف",51,"ف",1,0],["فلما سجى الليل البهيم تقابلا","وباتا وكل للهجوع طلوب",52,"ب",1,0],["فَلَمْ أَسْتَطِعْ في اللَّيْلِ مَيْلاً لِمَضْجَعِي","أَأَهْجَعُ والنِّيرَانُ حَشْوُ وِسَادِي",53,"د",2,0],["فلمّا سعى فينا الصريخُ وربّما","بلبَّيْكَ أنجدْنا الصريخَ المُناديا",54,"ي",2,0],["فلمّا سألتُ الرَّبْعَ أينَ تيمَّمَتْ","نوى الحيّ لم ينطقْ وضُلِّلَ سائلُهْ",55,"ل",2,0],["فلم اسل الهوى مادمت حياً","ولو منها قد انتكث الزمام",56,"م",1,0],["فَلما سَطا بغياً وَلم أَرض ما قَضى","شَكَوتُ إِلى حَزمي فطابَت وَسائلي",57,"ي",1,0],["فَلما ساءَني ما شاقَ منها","وَأَعقب نفحُ طيبِ العَيش لَفحا",58,"ح",2,0],["فَلَمّا سَقَوها وَاِستَقَوا قَلَّصَت بِهِم","تَخَطّى أَهاوِيّاً لأُخرى تَجوبُها",59,"ب",3,0],["فَلم أَستَسِغ إِلّا نَداه وَلَم يَكُن","لِيَعدلَ عِندي ذا الجَنابَ جَنابُ",60,"ب",1,1],["فَلَم اسأَل عَلى سلمى","وَلم تَسأل عَلى امري",61,"ر",2,0],["فَلَم أَستَطِع تَوديعَهُ غَيرَ أَنَّهُ","بِتَوديعِ عَينِ البَيتِ تَوديعُ حاجِبُه",62,"ه",1,0],["فلم آسف على الإدبار يوماً","ولم يكُ لي بإِقبالٍ حُفول",63,"ل",1,0],["فلما سمعن الفاطميات صوته","خرجن بقلب قد عراه ذهول",64,"ل",1,0],["فلم استطلت حمية","دون الهدى ونهضت حزما",65,"م",2,1],["فلما سعى للرزق من يطلبونهُ","إذا بهمُ يلقوْن ما الله قاسمُهْ",66,"م",2,0],["فلم اسْطِعْ له ردّاً","وكيف يُرد من عَبَدَا",67,"د",2,0],["فَلَمْ أَسْتَطَعْ أَنْ أَخُونَ الْمَنَافِي","فَإِنَّ بِهَا يُسْتَلَذُّ الْغِمَارُ",68,"ر",1,0],["فلم أسمع من الأحباب قولاً","يفيض عذوبة عند اللقاءِ",69,"ا",2,0],["فَلَمْ أَسْمَعْ نَصِيحَتَهُ ودَارَتْ","مَعَارِكُهَا عَلَى أَرْضِي رَحَاهَا",70,"ا",3,0]]}