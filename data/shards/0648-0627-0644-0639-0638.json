{"poems":[[48,"إبق في نعمة بقاء الدهور","https://www.aldiwan.net/poem23636.html","الخفيف"],[228,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[276,"تنبهوا يا رقود","https://www.aldiwan.net/poem52048.html","المجتث"],[543,"آه بشرى لنا بعودة باشا","https://www.aldiwan.net/poem48295.html","عموديه"],[563,"ظهر الحق للعيان وبينا","https://www.aldiwan.net/poem33801.html","الخفيف"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131333","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95331","الرجز"],[3989,"","https://poetry.dctabudhabi.ae/diwan/poem/147364","الخفيف"],[4485,"","https://poetry.dctabudhabi.ae/diwan/poem/132211","الخفيف"],[5186,"خلوا عقيم البحث في خلخالها","https://www.poetsgate.com/ViewPoem.aspx?id=156494",""]],"verses":[["والعَظيمُ العظيمُ يَكبُرُ في عَيْنَيْ","ِه منها قَدْرُ الصّغيرِ الصغيرِ",0,"ر",1,0],["وَالعَظيمُ العَظيمُ تُضعِفُهُ أَن","ثى فَينقادُ كَالحَقيرِ الحَقيرِ",1,"ر",1,0],["وَالعظم في الترب يبلى","وَيأَكل اللحم دود",2,"د",1,0],["والعظيمُ العظيمُ يَدري ذوِي الإخ","لاصِ عن بُعدِ دارِهم واقتِرَابِ",3,"ب",1,0],["والعظيم العظيم جل تعالى","أين من يعرف الحقيقة أينا",4,"ن",2,0],["والعَظْمُ منّي صارَ كالمُسَبّكِ","من عُظم أشواقي إلى المُشَبَّكِ",5,"ك",1,0],["والعظم أيضاً والأمير أجبرا","زيداً على ترك الهوى فأقصرا",6,"ر",2,0],["والعظيم العظيم من قيد المطلق","في كفه خيالا ً وخيلا",7,"ل",2,0],["والعظا والوظير والظهر والأظفار","والظهر بعد والإيقاظ",8,"ظ",1,0],["والعظم حلف الرهن قد أبلى به","برح السقام وطول عهد سلالها",9,"ل",3,0]]}