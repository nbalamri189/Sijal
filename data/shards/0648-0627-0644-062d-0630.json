{"poems":[[53,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[227,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[240,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[445,"ما كفر نعماك من شأني فيثنيني","https://www.aldiwan.net/poem34757.html","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27481","السريع"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107012","الرجز"],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118778","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133083","الرجز"],[5213,"أشبه البدر طلعة وجمالا","https://www.poetsgate.com/ViewPoem.aspx?id=170532",""],[5573,"عبرتك فعل البليد ومكسبه وإفلاسه","https://www.poetsgate.com/ViewPoem.aspx?id=206490",""],[5606,"ليت فلان نام","https://www.poetsgate.com/ViewPoem.aspx?id=207434",""],[6115,"اسمع الرأي المسدد يالحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=180524",""],[6115,"الظفر في طاعة الله وبرّك والديك","https://www.poetsgate.com/ViewPoem.aspx?id=187918",""]],"verses":[["والحِذَارَ الحذارَ من مبرِقَاتٍ","مُصْعِقَاتٍ لوقعها شُؤْبُوبُ",0,"ب",1,0],["والحذف من يد دم واسم أب","وابن كذا أخت وأخ لم يجب",1,"ب",1,0],["وَالحِذقُ في ما عَلِمتُ مُكتَسَبٌ","وَإِنَّما الحَظُّ غَيرُ مَكسوبِ",2,"ب",1,0],["والحِذْرُ يخفقُ في أحشاءِ والهةٍ","تُرَدِّدُ الشَجوَ في أحشاءِ مَحزونِ",3,"ن",1,0],["والحذف للمعتلّ في الأفعال","وهكذا في الخمسة الأمثال",4,"ل",1,0],["والحذف حتم إن يكن إلا فصل","بين الحقيقي وما به اتصل",4,"ل",1,0],["والحذف والإبدال في المرخم","أوالِفا مكة من ورق الحمي",5,"ي",1,0],["والحذف في فاء جواب ربطت","وبعد إما ولنون قد وقت",5,"ت",1,0],["والحذف في غير الضمير كالزمن","فاش وفي معين قالوا معن",5,"ن",1,0],["والحذف والتسكين نحو له فتى","والحذف في المجزوم أيضا قد أتى",5,"ت",2,0],["والحذر النحرير يدري الذي","جاء به مُحذِّراً منعما",6,"م",2,0],["والحذف ان تسقط مجموع الوتد","والصلم في المفروق مثله ورد",7,"د",1,0],["والحذفُ في بعض المقدّمات","أو النتيجة لعلمٍ آت",8,"ت",1,0],["وَالحَذفُ مَع فَصلٍ بِإلاَّ فُضِّلاَ","كمَا زَكَا إلاَّ فَتاةٌ ابنِ العَلاَ",9,"ل",2,0],["وَالحَذفُ قد يَأتِى بِلا فَصلٍ وَمَع","ضَمِيرِ ذِى المَجَازِ فِى شِعرٍ وَقَع",9,"ع",1,0],["وَالحَذفَ فِى نِعمَ الفَتَاةُ استَحسنَوا","لأنَّ قَصدَ الجِنسِ فِيهِ بَيِّنُ",9,"ن",1,0],["وَالحَذفُ حَتمٌ مَعَ آتٍ بَدَلاَ","مِن فِعلِهِ كَنَدَلاً الَّذ كاندُلاَ",9,"ل",2,0],["وَالحَذفُ فِى اليَا رَابِعاً أحَقُّ مِن","قَلبٍ وَحَتمٌ قَلبُ ثَالِثٍ يَعِن",9,"ن",1,0],["والحذف في ثلاثة قد حصرا","مختصة بالفعل عند من درى",10,"ر",2,0],["والحذفُ للنونِ في الفعل الَّذي رَدَفَتْ","يُرَى بها الفعل منصوباً كما انجزما",11,"م",2,0],["والحذر من خدع النفوس وشرها","والكبر والأعجاب والبهتان",12,"ن",1,0],["والحذار الحذار خيفة قد","يتثنى لدى الوغى عسالا",13,"ل",2,0],["والحذر من خوّة الي يبتليك ابلاسه","من نكس دون المراقي عيفك مرقاها!!",14,"ا",3,0],["والحذرمن غضبة الشهم الحليم","لوفقد صبره على الدنيا السلام",15,"م",1,0],["والحذر من صحبة الرجل المريب","صحبته ذلّه وملعونة جدف",16,"ف",1,0],["والحذر تظلم بعيد ولاقريب","بشر الظالم لنفسه بالتلف",16,"ف",1,0],["والحذر لا تظلم الناس ربيّ يبتليك","واعلم أن الظلم يطميك في مرتع وخيم",17,"م",1,0]]}