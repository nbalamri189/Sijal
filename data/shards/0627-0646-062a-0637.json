{"poems":[[75,"سرك الدهر وساء","https://www.aldiwan.net/poem11921.html","مجزوء الرمل"],[95,"در في سمائك يا قضاء فإن يثر","https://www.aldiwan.net/poem11145.html","الكامل"],[53,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[53,"إن تطل لحية عليك وتعرض","https://www.aldiwan.net/poem62843.html","الخفيف"],[53,"قل لأبي سهل الذي ورث","https://www.aldiwan.net/poem64575.html","المنسرح"],[53,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[45,"مالنا كلنا جو يا رسول","https://www.aldiwan.net/poem9980.html","الخفيف"],[45,"صلة الهجر لي وهجر الوصال","https://www.aldiwan.net/poem10110.html","الخفيف"],[47,"لا أرى بالبراق رسما يجيب","https://www.aldiwan.net/poem10653.html","الخفيف"],[107,"خوضوا الوغى يا أهل وادي القرى","https://www.aldiwan.net/poem44051.html","السريع"],[48,"سألتني عن رهط قيل وعتر","https://www.aldiwan.net/poem22594.html","الخفيف"],[48,"النفس إن لم تذق موتا مشارفة","https://www.aldiwan.net/poem23379.html","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140862",""],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[108,"الأسد السجين!","https://www.poetsgate.com/ViewPoem.aspx?id=179522",""],[108,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[108,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[287,"من علا الصاحب الطويل الركاب","https://www.aldiwan.net/poem32864.html","الخفيف"],[371,"داء ولكنه داء بلا ألم","https://www.aldiwan.net/poem17721.html","البسيط"],[396,"إن تطلب الهم كله يا فتى والغم","https://www.aldiwan.net/poem54524.html","عموديه"],[409,"منعت عن مقلة الصب كراها","https://www.aldiwan.net/poem33364.html","الرمل"],[435,"صاح وافى داعي الهناء يشير","https://www.aldiwan.net/poem40995.html","الخفيف"],[505,"قل لهذا الليل مهما شئت طل","https://www.aldiwan.net/poem37941.html","الرمل"],[563,"من مجيري من فاتر الطرف فاتك","https://www.aldiwan.net/poem34260.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38427","الخفيف"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16920","السريع"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133795","الخفيف"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79587","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79794","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48911","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113925","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127963","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125479","الرمل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69334","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71074","البسيط"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42444","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47173","الكامل"],[2844,"","https://poetry.dctabudhabi.ae/diwan/poem/144460","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58381","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203008","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118784","المديد"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74217","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68029","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62769","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205582","السريع"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34556","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76443","الرمل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77054","الخفيف"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93304","الخفيف"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117232","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204206","الخفيف"],[3271,"أنت دير الهوى ، وشعري صلاة","https://www.poetsgate.com/ViewPoem.aspx?id=102362",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5111,"طَالَ هَجْرِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=212271",""],[5150,"وجدتها .. وجدتها","https://www.poetsgate.com/ViewPoem.aspx?id=202800",""],[5150,"همسات الحب ...!","https://www.poetsgate.com/ViewPoem.aspx?id=202937",""],[5277,"سيدي العراق","https://www.poetsgate.com/ViewPoem.aspx?id=201721",""],[307,"الكنوز","https://www.poetsgate.com/ViewPoem.aspx?id=213659",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5459,"دوح النهى","https://www.poetsgate.com/ViewPoem.aspx?id=198288",""],[5609,"نزوة عشق","https://www.poetsgate.com/ViewPoem.aspx?id=215571",""],[5642,"جهرة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=125040",""],[5691,"الحليب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=205883",""],[5897,"لا تعبث بقلب امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=164506",""],[5957,"يا منية الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=56332",""]],"verses":[["أَنتَ طَبٌّ أَنَّ داءَ المَو","تِ قَد أَعيا الدَواءَ",0,"ا",2,0],["إِنْ تَطْلُبُوا عَدْلَ القَضَاءِ كَوُدِّكُمْ","فَالعَدْلُ لَيْسَ كَوُدِّكُمْ وَكَوُدِّهِ",1,"د",2,0],["أنت طَبٌّ بذاك لكن تغابيْ","تَ وحابيتَ كلَّ كابٍ ونابِ",2,"ب",1,0],["إن تَطُل لحيةٌ عليك وتعرض","فالمخالي معروفة للحميرِ",3,"ر",1,1],["أنت طبيبٌ فلا تكن شكِساً","والطب يأبى الخلائقَ الشُكسا",4,"س",2,0],["إنْ تَطُلْ مِحْنَتِي فلا أنا مَفْتو","نٌ زماني ولا أخي مفتونه",5,"ن",2,0],["أَنتَ طولَ الحَياةِ لِلرومِ غازٍ","فَمَتى الوَعدُ أَن يَكونَ القُفولُ",6,"ل",1,0],["أَنتَ طَوراً أَمَرُّ مِن ناقِعِ السُم","مِ وَطَوراً أَحلى مِنَ السَلسالِ",7,"ل",1,0],["إِن تَطَلَّب شَرواهُ فَالغَيثُ دَفقاً","مَثَلٌ مِن سَماحِهِ مَضروبُ",8,"ب",1,0],["إن تَطْلُبوا البُرهانَ فاستخبروا","جِيرانَكم أو فاسألوا خَيْبَرا",9,"ر",2,0],["إِن تَطُل عيشَةٌ فَإِنَّ المَنايا","سَوفَ يُقضى لَها بِمَن عاشَ وِترُ",10,"ر",1,0],["إِن تَطفَإِ النارُ عَن جَزلٍ فَإِنَّ لَها","يُعفى وَيُخبَأُ ما أَبقَت مِنَ الفَحَمِ",11,"م",1,0],["أنت طوراً أمر من ناقع السم","وطوراً أحلى من السلسال",12,"ل",1,0],["إِنْ تَطَلَّعْتَ للرَّغائِبِ فابذُلْ","تِلْك في الدَّهْرِ سُنَّةُ الكَائِناتِ",13,"ت",1,0],["إن تُطعموا الرئبال من فضلاتكم","شهدًا، تجرَّع شهدكم غِسلينا",14,"ن",2,0],["إن تطلبوا المجدَ؛ فالصاروخُ مُنْطَلِقًا","ووَحدة الصَّفِّ، والشورى مصادره",15,"ر",2,0],["إن تطرحوه بماء البحر، دنَّسهُ","فطهروا منه ماءَ البحر تطهيرا",16,"ر",2,0],["أَنتَ طَيَّبتَ أَرضَ جيرانِ جيرو","نَ فَفاحَت بَينَ الملا بِالملابِ",17,"ب",1,0],["إِن تَطلُبِ العَيشَ إِذ وَلّى الصِبا فَلِمَن","أَو تُنكِرِ الهَمِّ إِن فاتَ الهَوى فَلِمِ",18,"م",1,0],["إن تطلب الهم كله يا فتى والغم","وكربك الجم ذي يبقى ولا ينتم",19,"م",1,1],["إن تطل لا قدر اللّه فما","بعده إلا توارى في ثراها",20,"ا",3,0],["أنت طود الفخار يا خير مولى","في حماه بنو العلى تستجيرُ",21,"ر",1,0],["أَنْتَ طاوَلْتَ صَبوراً ثابِتاً","من مُعاناةِ الدُّجى لم يَقْلَقِ",22,"ق",1,0],["أنت طوراً ولا سواك وإنا","نحن طوراً ولا سوى آياتك",23,"ك",1,0],["إِن تَطل مِنكَ لِحية ثمّ تعوض","كُنتَ خِدنَ العَقلِ الخَفيفِ المريضِ",24,"ض",1,1],["إِن تَطلُبَ الأُنسَ فَفارِقهُمُ","إِلى كِتابٍ وَإِلى ياسِ",25,"س",1,0],["أنتِ طيب من الزَّهر","لست من طينة البشر",26,"ر",1,1],["أنت طورا كمثل جامع سفيا","ن وطورا تحكي سفينة نوح",27,"ح",1,0],["أنت طور النورِ الذي مذ تجلَّى","لابن عمران دكَّ ذاك الطورا",28,"ر",2,0],["أَنت طيفُ الضمير تقرع ناقوس","هواه إلى الهدى إِنذارا",29,"ر",2,0],["إن تُطِل مَرَّةً عُوَيشةُ ليلى","من أباطيلِها بمِثلِ السرابِ",30,"ب",1,0],["أنت طرف الزمان في كل عز","وفخار وسودد قد أجا له",31,"ل",2,0],["أنتَ طيفُ الحظِّ ترمي بالمُنى","في ظلامِ اليأس أو نورِ النجاه",32,"ه",1,0],["أَنتَ طَوَّلتَ قَدرَهُ وَتَطوَّل","تَ عَلَيهِ فَطالَ شُكرُ زَمانِه",33,"ن",2,0],["إِنْ تطلبوا الحقَّ نُعْطِ الحقَّ طالِبَةُ","والسيفُ في الغِمْدِ والأَدْراعُ في السُّفَرِ",34,"ر",1,0],["إن تطلبِ الشرفَ الرفيعَ فكن به","متبرّحاً واطرح فؤادكَ مَغنَمَا",35,"م",2,0],["إن تطلبوا التّقليد منّي في الهوى","فَلِمِثْلِيَ التَّقْلِيدُ فيه حَرَامُ",36,"م",1,0],["أنت طودٌ لكنّه لا يسامى،","أنت بحرٌ، لكنّه لا يخاض",37,"ض",1,0],["إنْ تُطلِقوهُ فأنتُمُ أهلُ النّدى","أو تَحِسبوهُ فالخرا لا يُحْبَسُ",38,"س",1,0],["أنت طفل ولدت في آخر العم","روشيخ يعيش عيش الرضيع",39,"ع",1,0],["أنت طول الدهر قِبلتهُ","قط لا تنفك عن نظره",40,"ر",2,0],["أَنتَ طَوَّقتَني مِن الدُر عقداً","فاقَ في نَظمه القَلائد طرا",41,"ر",2,0],["إِن تُطلِقُوني فِي الهوى فأنا الَّذِي","يهواكمُ طالتْ عليَّ سُجون",42,"ن",1,0],["أَنتَ طَودُنا","يَومَ نَعتَصِم",43,"م",1,0],["إنْ تطلح الإبلُ العِتاقُ فبَعْدَما","أفنَى الكَلالُ جِذابَها وجِذابي",44,"ب",2,0],["إن تطلب الشكر على راحتي","ما أجدر اللوم بذاك المصابْ",45,"ب",1,0],["أنت طَودي من بين هذي الهضابِ","وشهابي من دون كلِّ شِهابِ",46,"ب",1,1],["انت طفل كفه قد ملئت","بالحصى وَالشوك",47,"ك",1,0],["أَنتَ طَوَّقتَني بِوافِر إِحسا","نِكَ حَتّى أَمسى بِهِ الحر عَبدا",48,"د",2,0],["إِن تطلّبتُمُ من الطرْف","والوجْنة عُذري ففيهما أَعذار",49,"ر",1,0],["إن تطردوه فما له من حيلة","إلا جنابكم فذاك تعوّدا",50,"د",2,0],["إن تطهرت فالمياه سلاح","أو تيممت فالصعيد سماد",51,"د",1,0],["أنتِ طيفُ الغُيوب رفرفَ بالرّحْم","تةِ والطهر والهدى والتبتّلْ",52,"ل",1,0],["إِنْ تَطْلُبِ الْبَدْرَ فِيْ كَفَّيْكَ ذَوَّبَهُ","أَوْ تَطْلُبِ الشَّمْسَ يَرْمِيْهَاْ عَلَىْ الْهُدُبِ",53,"ب",1,0],["أنْتَ طيْف ٌيَا حَبِيْبِيْ","فِيْ جُفُوْنِيْ يَتمَدّدْ",54,"د",1,0],["أنتِ طيفُ المحبةِ المُتهادي","وأنا الحائرُ المنادي أنَّى",55,"ن",2,0],["أنتَ طيفٌ لم تفارقْ مُهجتي","كيفَ أشكوكَ وما طالَ المغيبُ",56,"ب",1,0],["أنتَ طيفُ الوصلِ إمَّا زارني","خلتُ أني ما تغشاني السهرْ",57,"ر",1,0],["إنْ تطرقَ البابَ ألفاً تبق مغلقةً","والدارُ فيها عديمُ الخُلقِ والحَسَبِ",58,"ب",1,0],["إن تطل نجدتهم زحفا فقد","حمد السيف الذي طال نجادا",59,"د",2,0],["أنتَ طَلّقْتَ دُنًا مَوْبُوءَةً..","أنْتَ تَذْوِي ..مَن ترى يَذْوي معكْ..؟!",60,"ك",1,0],["إن تطلع الشمس خجلى من مفاتنها","فقد سلا الليل بدرٌ لم يعد ياتي",61,"ت",2,0],["إن تُطِعْك النَّفسُ تُسْلِمْكَ وإن","تَعْصِ تُؤْلمْك بما لَم تَصْنع",62,"ع",1,0],["إنْ تُطْعِمَنَّ فأشْبِعَنَّ وكُنْ نَقِيَّ المَحْتِدِ","وإذا ضَرَبْتَ فأوْجِعَنَّ بقَبْضَةٍ منْ جلْمَدِ",63,"د",1,0],["أن تطلق الريح الهبوب لمارد","في جوفها مغلولة قدماه",64,"ا",2,0],["أن تطفئ الأشواق في صدري","والشوق حدّ الموت في طرفي",65,"ف",2,0]]}