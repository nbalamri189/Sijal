{"poems":[[73,"سرك الدهر وساء","https://www.aldiwan.net/poem11921.html","مجزوء الرمل"],[93,"در في سمائك يا قضاء فإن يثر","https://www.aldiwan.net/poem11145.html","الكامل"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"إن تطل لحية عليك وتعرض","https://www.aldiwan.net/poem62843.html","الخفيف"],[51,"قل لأبي سهل الذي ورث","https://www.aldiwan.net/poem64575.html","المنسرح"],[51,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[43,"مالنا كلنا جو يا رسول","https://www.aldiwan.net/poem9980.html","الخفيف"],[43,"صلة الهجر لي وهجر الوصال","https://www.aldiwan.net/poem10110.html","الخفيف"],[45,"لا أرى بالبراق رسما يجيب","https://www.aldiwan.net/poem10653.html","الخفيف"],[105,"خوضوا الوغى يا أهل وادي القرى","https://www.aldiwan.net/poem44051.html","السريع"],[46,"سألتني عن رهط قيل وعتر","https://www.aldiwan.net/poem22594.html","الخفيف"],[46,"النفس إن لم تذق موتا مشارفة","https://www.aldiwan.net/poem23379.html","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140862",""],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[106,"الأسد السجين!","https://www.poetsgate.com/ViewPoem.aspx?id=179522",""],[106,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[280,"من علا الصاحب الطويل الركاب","https://www.aldiwan.net/poem32864.html","الخفيف"],[364,"داء ولكنه داء بلا ألم","https://www.aldiwan.net/poem17721.html","البسيط"],[388,"إن تطلب الهم كله يا فتى والغم","https://www.aldiwan.net/poem54524.html","عموديه"],[400,"منعت عن مقلة الصب كراها","https://www.aldiwan.net/poem33364.html","الرمل"],[426,"صاح وافى داعي الهناء يشير","https://www.aldiwan.net/poem40995.html","الخفيف"],[498,"قل لهذا الليل مهما شئت طل","https://www.aldiwan.net/poem37941.html","الرمل"],[556,"من مجيري من فاتر الطرف فاتك","https://www.aldiwan.net/poem34260.html","الخفيف"]],"verses":[["أَنتَ طَبٌّ أَنَّ داءَ المَو","تِ قَد أَعيا الدَواءَ",0,"ا",2,0],["إِنْ تَطْلُبُوا عَدْلَ القَضَاءِ كَوُدِّكُمْ","فَالعَدْلُ لَيْسَ كَوُدِّكُمْ وَكَوُدِّهِ",1,"د",2,0],["أنت طَبٌّ بذاك لكن تغابيْ","تَ وحابيتَ كلَّ كابٍ ونابِ",2,"ب",1,0],["إن تَطُل لحيةٌ عليك وتعرض","فالمخالي معروفة للحميرِ",3,"ر",1,1],["أنت طبيبٌ فلا تكن شكِساً","والطب يأبى الخلائقَ الشُكسا",4,"س",2,0],["إنْ تَطُلْ مِحْنَتِي فلا أنا مَفْتو","نٌ زماني ولا أخي مفتونه",5,"ن",2,0],["أَنتَ طولَ الحَياةِ لِلرومِ غازٍ","فَمَتى الوَعدُ أَن يَكونَ القُفولُ",6,"ل",1,0],["أَنتَ طَوراً أَمَرُّ مِن ناقِعِ السُم","مِ وَطَوراً أَحلى مِنَ السَلسالِ",7,"ل",1,0],["إِن تَطَلَّب شَرواهُ فَالغَيثُ دَفقاً","مَثَلٌ مِن سَماحِهِ مَضروبُ",8,"ب",1,0],["إن تَطْلُبوا البُرهانَ فاستخبروا","جِيرانَكم أو فاسألوا خَيْبَرا",9,"ر",2,0],["إِن تَطُل عيشَةٌ فَإِنَّ المَنايا","سَوفَ يُقضى لَها بِمَن عاشَ وِترُ",10,"ر",1,0],["إِن تَطفَإِ النارُ عَن جَزلٍ فَإِنَّ لَها","يُعفى وَيُخبَأُ ما أَبقَت مِنَ الفَحَمِ",11,"م",1,0],["أنت طوراً أمر من ناقع السم","وطوراً أحلى من السلسال",12,"ل",1,0],["إِنْ تَطَلَّعْتَ للرَّغائِبِ فابذُلْ","تِلْك في الدَّهْرِ سُنَّةُ الكَائِناتِ",13,"ت",1,0],["إن تُطعموا الرئبال من فضلاتكم","شهدًا، تجرَّع شهدكم غِسلينا",14,"ن",2,0],["إن تطلبوا المجدَ؛ فالصاروخُ مُنْطَلِقًا","ووَحدة الصَّفِّ، والشورى مصادره",15,"ر",2,0],["إن تطرحوه بماء البحر، دنَّسهُ","فطهروا منه ماءَ البحر تطهيرا",16,"ر",2,0],["أَنتَ طَيَّبتَ أَرضَ جيرانِ جيرو","نَ فَفاحَت بَينَ الملا بِالملابِ",17,"ب",1,0],["إِن تَطلُبِ العَيشَ إِذ وَلّى الصِبا فَلِمَن","أَو تُنكِرِ الهَمِّ إِن فاتَ الهَوى فَلِمِ",18,"م",1,0],["إن تطلب الهم كله يا فتى والغم","وكربك الجم ذي يبقى ولا ينتم",19,"م",1,1],["إن تطل لا قدر اللّه فما","بعده إلا توارى في ثراها",20,"ا",3,0],["أنت طود الفخار يا خير مولى","في حماه بنو العلى تستجيرُ",21,"ر",1,0],["أَنْتَ طاوَلْتَ صَبوراً ثابِتاً","من مُعاناةِ الدُّجى لم يَقْلَقِ",22,"ق",1,0],["أنت طوراً ولا سواك وإنا","نحن طوراً ولا سوى آياتك",23,"ك",1,0]]}