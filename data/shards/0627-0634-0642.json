=192370",""],[5997,"ريع الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214208",""],[6019,"هذيان في لحظة تأمل","https://www.poetsgate.com/ViewPoem.aspx?id=144626",""],[6032,"خلب الغرام جنانا","https://www.poetsgate.com/ViewPoem.aspx?id=181523",""],[6035,"كارِهة.. ! .","https://www.poetsgate.com/ViewPoem.aspx?id=174226",""],[5309,"إن لم تعظنا الآي والسور","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573556",""],[6189,"قسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83577&r=&rc=44",""],[6217,"أَشْقَى لِعَقْلِكَ أنْ تَكُونَ أَدِيباً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23126&r=&rc=3",""],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""],[6238,"قلب قزح...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86772&r=&rc=1",""],[402,"يا مصر لو تقدر الأقدار بالكرم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54084&r=&rc=936",""],[5567,"أدخل في الغيبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81750&r=&rc=22",""]],"verses":[["أَشقى وَأَكتُمُ شِقوَتي","وَاللَهُ بي وَبِها عَليمُ",0,"م",1,0],["أُشَقِّقُ قَلبَ الشَرقِ حَتّى كَأَنَّني","أُفَتِّشُ في سَودائِهِ عَن سَنا الفَجرِ",1,"ر",1,0],["أَشْقَى اليَتَامَى فِي مَرَابِعِهِ","شَعْبٌ يَعِيشُ وَمَا لَهُ وَطَنُ",2,"ن",1,0],["أَشْقَتْ دِمَشْقَ الَّتِي تَدْرُونَ نَجْدَتَهَا","إِذْ يَبْتَغِيهَا جَلالُ المُلْكِ مِنْ قِدَمْ",3,"م",1,0],["أَشُقُّ وَراءَهُ الجَيشَ المُعَبّا","وَأَخرُقُ بَعدَهُ الرَهَجَ المُثارا",4,"ر",2,0],["أشقيت جدّي بثُكلٍ","بُنيَّ يا ثُكل جدّك",5,"ك",1,0],["أشقيتَ سمعي بنُغاشيّةٍ","عيَّارةٍ كَدَّاشةٍ مِلْطَهْ",6,"ط",2,0],["أشقائقَ النُّعمانِ بين رُبَى","نُعمانَ أنتِ محاسنُ النِّعمِ",7,"م",1,0],["أَشَقَّ كَسِرحانِ الصَريمَةِ لاحَهُ","طِرادُ الهَوادي فَهوَ أَشعَثُ شاسِبُ",8,"ب",1,0],["أَشقى البَرِيَّةِ نَفساً صاحِبُ الهِمَمِ","وَأَتعَسُ الخَلقِ حَذّاً صاحِبُ القَلَمِ",9,"م",1,1],["أَشقى القَضاءُ الأَرضَ بَعدَكَ أُسرَةً","لَولا القَضاءُ مِنَ السَماءِ لَما شَقَوا",10,"ق",3,0],["أَشَقيقَةَ العَلَمَينِ هَل مِن نَظرَةٍ","فَتَبُلَّ قَلباً لِلغَليلِ شَقيقا",11,"ق",2,0],["أَشقى ثَمودَ حينَ وَلَّهَهُ","عَن أُمِّهِ المَشؤومُ بِالعَقرِ",12,"ر",1,0],["أشقيقَةَ الجِزْعَيْنِ أيَّةُ لَوْعَةٍ","عُجْنا عليكِ غَداةَ عُجْنا الأينقا",13,"ق",2,0],["أَشقى بَني الدُنيا بِها","لِلَّهِ أَنتَ صَديقُها",14,"ق",3,0],["أشقى الشُّعوبِ وأولاها بمرحمةٍ","شَعبٌ تَلقَّفَهُ الغاوونَ فانْخدعا",15,"ع",2,0],["أشقى الرجالِ بما تُملي وساوسُه","من ظَنَّ أنّ بناءَ اللهِ يَنهدمُ",16,"م",1,0],["أَشقى النَعيمُ حَياتها وَأَباحَها","خِدرٌ أَعَزُّ وَذائِدٌ جَحجاحُ",17,"ح",1,0],["أَشُقُّ بهِ في حَوْمَةِ الحربِ بَطنَهُ","إذا رَامَنِي بالسّوءِ واسْتَوْعَرَ الأَمْرُ",18,"ر",1,0],["أشقَى الأَذى والغَدرُ جَدَّ رجالِهم","وَجَرَى لهم بالأسرِ طَيْرٌ أسحم",19,"م",1,0],["أشقّ لريح الأستِ من حدّ شفرةٍ","وأنفذ في الخصيين من رأس مزراقِ",20,"ق",1,0],["أَشقى بِما لاقَيتُ مِن سَكَني","أَحبَبتُهُ وَأَثابَني نَزَحا",21,"ح",2,0],["أَشَقَّ قَسامِيّاً رَبَاعِيَّ جانِبٍ","وَقارِحَ جَنبٍ سُلَّ أَقَرحَ أَشقَرا",22,"ر",2,0],["أشقانيَ الحبُّ وقلبي سعيد","يَعُدُّ هذا الدمع من أنعمك",23,"ك",1,0],["أَشَقِيقَةَ الْقَمَرَيْنِ أَيُّ وَسِيلَةٍ","تُدْنِي إِلَيكِ فَلَيْس لِي شُفَعَاءُ",24,"ا",2,0],["أَشَقِيقَ عَبَّاسٍ العَزِي","زِ وَرُكْنَ دَوْلَتِهِ الوَطِيدَهْ",25,"د",2,0],["أشقشقَ نفسي ما افتقدتُكَ ليلةً","إلا غصصتُ بأدمعي وبراحي",26,"ح",2,0],["أشقى بنيه من نجا","فأطال لوعته نجاؤه",27,"ا",3,0],["أشَقِيقَةَ العَلَمَيْنِ! هلْ من نَظرَةٍ","قتَبُلَّ قلْباً، للغَلِيلِ، شَقيقَا",28,"ق",2,0],["أشقى البريّة نفسا صاحب الهمم","وأتعس الخلق حظّا صاحب القلم",29,"م",1,1],["أشقى. وأنت استليني","ريش الوساد النبيل",30,"ل",1,0],["أشقى الرجال بما تلمي وساوسه","من ظن أن بناء الله ينهدم",31,"م",1,0],["أشقى لمن حمل الشقاء كأنّما","أتراح كلّ أخي هوى أتراحي",32,"ح",2,0],["اشق صفوف الثائرين مصادما","نصول رجال او نصول منية",33,"ه",1,0],["أشق به هذا الأنام كأنهم","وما أطنبوا فيه الغداة فضول",34,"ل",1,0],["آشقى العواذل من آتى متحبباً","جهلاً بما اتيانه تبغيضُ",35,"ض",1,0],["اشقى الورى بك مغرور نهضت له","وإن أسعدهم قوم بك اعتصموا",36,"م",3,0],["أشقى الورى في زمان السوء من سلفت","أيّامه بين قوم كلهم غرر",37,"ر",1,0],["أَشقى بِلِذَّتي الحَمراءِ في جَسَدي","وَأَمّحي لا هَوى يَبقى وَلا وَصبُ",38,"ب",1,0],["أشقر وردي أديم له","يتقد كالقبس الساعر",39,"ر",1,0],["أَشقرُ الشعر عَلَى جبهته","طرةٌ من ذهبٍ فوقَ لجين",40,"ن",1,0],["أَشقى البَرِيَّةِ مَنظوراً وَمُنتَظِراً","هَذا الضَعيفُ الَّذي يَهواكَ جَبّارا",41,"ر",2,0],["أَشَقيقَها ما أَنتَ قَطُّ لِرُشدِهِ","مَسقِيُّ ماءٍ جَنىً وَمُثمِرُ نارِ",42,"ر",1,0],["أشقُّ بالسّيفِ دُجَى نقعِها","شقَّ الدَّياجي مرسَلُ الشُّهبِ",43,"ب",1,0],["أشقَى بمعناها ويحظَى معشرٌ","ينتحلون اسما لها مقتَسما",44,"م",2,0],["أشقانيَ الدهرُ فاِنْ أسعدني","بجمع شملي بكم زال الشقا",45,"ق",2,0],["أشقيتني فرضيت أن أشقى","وملكتني فقتلتني عشقا",46,"ق",2,1],["أشقيتِ منّا قلوباً لا نقول لها","أشقى الإلهُ الّذي بالحبّ أشقاكِ",47,"ك",1,0],["أشقيت قوماً فالرياء شعارهم","وشعار من أسعدته الإخلاص",48,"ص",1,0],["أشقَى الوَرَى عَيناً وأضيَعُ مَدمعاً","مَن قد بَكَى للأمرِ بعد فَواتِهِ",49,"ت",2,0],["إشقي قلبي بما تشا أو أرحه","أنا راض بما به أنت ترضى",50,"ض",2,1],["أَشقى به اللهُ من عَادى عُلاهُ ومن","عادَى عَلياً من الجُهَّالُ فَهْو شَقي",51,"ق",2,0],["أشقيقَةَ العَلَمَينِ لا بَرَحَ الحَيا","يَكسُوكِ مِن خِلَعِ الرّياضِ شَقائِقا",52,"ق",2,0],["أشقيتهم حياً وميتاً والعدى","لم يبرحوا لنفوسهم أشرارا",53,"ر",2,0],["أشقى بجد وهو يلعب بي","لَعبَ النسيم بيانع الرَّند",54,"د",1,0],["أَشُقُّ فُؤَادِي لاَ أُبَالي بِمَنْ وَشى","بِقَلْبي غَدَوْا لَمَّا حَدَوْا بِالرَّوَاحِلِ",55,"ل",1,0],["أشق فؤاد الليل وهنا كأنني","تصفحت في سوداء مهجته الفجرا",56,"ر",2,0],["أشقر إن لم تتقدم تنحر","وإن تأخر عن هياجٍ تعقر",57,"ر",1,1],["أشقاهم الحُكمُ القديم وقطعت","عماله بالدين حبل صِلاتهم",58,"م",1,0],["أَشَقى لِعَقْلِكَ أنْ تَكُونَ أَدِيباً","أَوْ أَنْ يَرَى فيكَ الْوَرَى تَهْذيبا",59,"ب",2,1],["أشقيقٌ أم عقيقٌ","أم حريقٌ أم رحيقُ",60,"ق",1,0],["أشقيق بدرِ التم طال تلهفي","وأطال فيك العاذلون شقاقي",61,"ق",2,0],["أشقيق روضٍ أنت يا بدر الدجا","بالله قل لي أم شقيق الروح",62,"ح",1,0],["أشُقة البعد دونك اعترضت","أم حُجبت عنك عينُ مبصرها",63,"ر",3,0],["أَشقى ويرقى المدعون محبتي","متوشحينَ 