wPoem.aspx?id=181907",""],[5969,"حِداداً على روحي","https://www.poetsgate.com/ViewPoem.aspx?id=198800",""],[5977,"سيف الغدر","https://www.poetsgate.com/ViewPoem.aspx?id=213240",""],[6102,"عَجِيب !!","https://www.poetsgate.com/ViewPoem.aspx?id=184446",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[5393,"لماذا أتيتَ بهذا الزمانْ ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85467&r=&rc=34",""],[6237,"الشعر الحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77894&r=&rc=36",""],[6242,"يا أيها الشعر قد جددت أحزاني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87555&r=&rc=2",""],[5490,"أهذا الصبح..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81929&r=&rc=15",""]],"verses":[["أما كان الحري بأن يوقّى","بأدراعٍ مسربلة ثقال",0,"ل",1,0],["أَما كُنتَ مَعَ الحَيِّ","صَباحاً حينَ وَلَّينا",1,"ن",2,1],["أَما كَفاهُم لَجاجُ الدَمعِ بَعدَهُمُ","حَتّى اِستَعانوا عَلى عَينَيَّ بِالطَلَلِ",2,"ل",1,0],["أَما كانَ فيكُم مُجمِلٌ أَو مُجامِلٌ","إِذا لَم يَكُن فيكُم أَغَرُّ جَوادُ",3,"د",1,0],["أَما كَمَلَت عِندَ الخُطوبِ تَجارَتي","أَما خَلَصَت عِندَ الأُمورِ رَوِيَّتي",4,"ت",2,0],["أما كَفاها القَدُّ وهْوَ رامِحٌ","ألا تُراميني بطَرْفٍ نابِلِ",5,"ل",1,0],["أما كنت يوما طالبا ؟.. كنت يا أخي","وقد كان أستاذ التلاميذ ، طالبي",6,"ب",2,0],["أَما كانَ النِساءُ عَلِمنَ قَبلي","وَقَبلَكِ كَيفَ تَعذيبُ الرِجالِ",7,"ل",1,0],["أَمَا كَانَ حُكْمُ الدَّهْرِ فِي النَّاسِ وَاحِداً","وَلَمْ تَخْتَلِفْ فِيهِ شُعُوبٌ وَبُلْدَانُ",8,"ن",1,0],["أَما كُنتَ قَبلَ اليَومِ تَعلَمُ أَنَّما","تَنوءُ بِحَرّاثينَ ميلِ العَواتِقِ",9,"ق",1,0],["أما كفى أنهم لم يعملوا عملاً","حتى أرادوا اجتماعاً في شراغانا",10,"ن",2,0],["أما كفاك السنى جمالاً","حتى تجلّلت بالسناء",11,"ا",2,0],["أما كفانيَ تكحيل الجفون أسىً","حتَّى المراشف أيضاً باللّمى كحلت",12,"ت",1,0],["أما كان من صفحٍ سوى أن عضضتني","بأنياب تأنيبٍ ضروباً من العضّ",13,"ض",1,0],["أم اكتنفت أذنك العاذلا","ت باللوم في ذاك كل اكتناف",14,"ف",1,0],["أَمّا كُلَيبُ بنُ يَربوعٍ فَلَيسَ لَهُم","عِندَ المَكارِمِ لا وِردٌ وَلا صَدَرُ",15,"ر",1,0],["أَمّا كُلَيبُ بنُ يَربوعٍ فَإِنَّ لَها","شَرَّ الرِفاقِ إِذا ما حُصِّلَ الرُفَقُ",16,"ق",1,1],["أَما كَفى أَنَّ في آذانِهِم صَمَماً","حَتّى أَرادوا بِأَن يَنتبَها الصَمَمُ",17,"م",1,0],["أَما كَفَت قَتلَةٌ بِالسَيف واحِدَةٌ","حَتّى أُتيحَ مِنَ الأَجفانِ ثِنتانِ",18,"ن",1,0],["أَما كُنتِ أَبصَرتِني مَرَّةً","لَيالِيَ نَحنُ بِذي جَهوَرِ",19,"ر",1,0],["أَما كانَ بَذلُ العَدلِ أَيسَرَ واجِبي","عَلى المُتَعَدّي أَو أَقَلَّ حُقوقي",20,"ق",2,0],["أَما كانَ في تِلكَ الدُموعِ السَوائِلِ","بَيانٌ لِناهٍ أَو جَوابٌ لِسائِلِ",21,"ل",1,1],["أَما كانَ في قَيسِ بنِ عَيلانَ نابِحٌ","فَيَنبَحُ عَنهُم غَيرُ مُستَولَغٍ كَلبِ",22,"ب",1,0],["أما كسرنا كؤوس الحب من زمن","فكيف نبكي على كأس كسرناه؟",23,"ا",2,0],["أما كفى برُك المواسي","فزدتني روعة المزار",24,"ر",1,0],["أَمَا كَفَى هَذَا الْجَفَا","حَتَّى أَعَانَتْهُ الْنَّوَى",25,"و",2,0],["أما كانوا حديثَ الدهرِ لولا","شرائعُه العُلىَ للهاربينا",26,"ن",2,0],["أما كان في بُؤسِ الحياةِ وما جَنَتْ","صُروفُ اللّيالي من أذى العيشِ ما يكفي",27,"ف",2,0],["أَما كَفاها اِبتِياضُ الأَزدِ حُرمَتَها","في عُقرِ دارِهِم أَن يُبعَثَ الحَجَرُ",28,"ر",1,0],["أمَّا كَأنَّ الدهرَ أرضِعَ ثَديَها","فكأنَّما كَفلَتهُ وهوَ يَتيم",29,"م",1,0],["أمّا كواكِبُها له فخَواضِعٌ","تُخفي السجودَ ويَظهرُ الإيماء",30,"ا",2,0],["أَما كَفى طَرفَكَ أَن يَنظُرا","إِن راحَ لِلتَسليمِ أَو بَكَّرا",31,"ر",2,1],["أَمّا كِلابٌ فَأَغنى مِن ثَعالِبِهِم","كَأَنَّ أَرماحَهُم في الحَربِ أَشطانُ",32,"ن",1,0],["أما كفى أنّ في آذانهم صمما","حتّى أرادوا بأن ينتابها الصّمم",33,"م",1,0],["أَمَا كَفَى ما جَرَّ أَحْدَاثُهُ","حَتَّى دَعَا الْغِيدَ إِلى حِزْبِهِ",34,"ب",2,0],["أَمَا كانَ ذاكَ القَلْبُ وَالعَقْلُ نُورُهُ","لِقَلْبِ أَخِيكِ المُوئِلَ الهادي الطَّهْرَا",35,"ر",2,0],["أَمَا كُلُّ ذِي كَلَفٍ مُتْعِبٌ","شَرِيكٌ لِذِي الكَلَفِ المُتْعِبِ",36,"ب",1,0],["أما كذبوا لا قبح الله غيرهم","ولا أفلحت تلك الوجوه للواكع",37,"ع",1,0],["اما كان ملء قميصي الربيع ؟","فأين أنا ؟في قميصي سوايا",38,"ا",3,0],["أما كتابُك فهو أفَضلُ ما وَعى","واعٍ وخزيُ معاشرٍ إن لم يَعُوا",39,"ع",3,0],["أما كذبوا لا قبح اللّه غيرهم","ولا أفلحت تلك الوجوه اللواكع",40,"ع",1,0],["أما كنتَ قبلَ الحربِ تعلمُ أنَّما","تَنُوءُ بِحَرَّاثِينَ مِيلِ الْعَوَاتِقِ",41,"ق",1,0],["اما كفاك ذلي","يا كثير الدلال",42,"ل",1,0],["أم اكتَحَلَت عَينَاكَ بِالصَّابِ والحُذَا","أمِن ألَمِ الأشوَاقِ فِيهَا التَّحَرُّقُ",43,"ق",1,0],["أما كان في حال بن عجلان عبرة","لمن غره منه التفرفق والمهل",44,"ل",1,0],["أما كان هم أولى بذلك منكم","وخطبهم خطب مهم ومتعب",45,"ب",1,0],["أَما كانَ فيهِم مِثلُ عَمرو بنِ مرثِدٍ","وَذُو المَجدِ دفّاعُ الهُمومِ السَوادِكِ",46,"ك",1,0],["أَما كانَ في أَرضِ العِراقِ مَراغِمٌ","تَرُوقكَ عَن دارِ الزَلازلِ وَالأَزلِ",47,"ل",1,0],["أما كفاكم بني الأنسان شقوتكم","وأنكم للمنايا جدّ وراد",48,"د",1,0],["أما كفاكَ الفراقُ غدرا","وبعدَ هذي الديارِ هجرا",49,"ر",2,1],["أما كفاني ما ألقاهُ من زمني","حتى أغالبَ فيكَ الشوقَ والزمنا",50,"ن",2,0],["أَما كَفاكِ البَينُ لي قاتِلاً","حَتّى شَفَعتِ البَينَ بِالهَجرِ",51,"ر",1,0],["أَما كَونُ مِثلى يَذُمُّ الزَما","نِ في عَصرِ مِثلِكَ مُستَقبَحُ",52,"ح",1,0],["أَمَا كفَى السيفَ حتَّى جرَّدَ القلما","يوماً يُريق مِداداً أو يُريق دَمَا",53,"م",2,1],["أَما كَفى الأَرضَ ما ضَمَّت فَقَد كَفتَت","تُقىً وَأَطهَرَ خَلقٍ فَوقها جَسَدا",54,"د",2,0],["أَما كَفاكَ تَلافي في تَلافيكما","وَلَستَ تَنقِمُ إِلّا فَرطَ حُبيكا",55,"ك",2,1],["أما كان خير الخلق يذكُر ربَّه","جهاراً وسرّاً صحّ نرويه في الكتب",56,"ب",1,0],["أما كنتِ أُفقاً فيه يطلعُ بَدرُها","وما أخَذَت منكِ الجمالَ ولا منا",57,"ن",2,0],["أما كفانا بفقدِ الملكِ نائبةً","حتى أتانا علوجٌ الرومِ عادينا",58,"ن",2,0],["أَما كَفانِيَ طَرفٌ مِنكَ نَبّالُ","مَتى رَنا فَهوَ فَتّاكٌ فَقَتّالُ",59,"ل",1,1],["أَما كَفى البين لا دارَت دوائرهُ","نَوى الحُباب وتلك الخطَّة الخطرَه",60,"ر",2,0],["أَما كنتما أَعطيتماني مَواثِقا","بأَنَّكما لا تَنقُضانِ لنا عَهدا",61,"د",2,0],["أما كَفانا أنَّهمْ قَدَّموا","مَجْداً وطاروا بِقُداماه",62,"ا",2,0],["أما كان زَيْناً للزّمانِ اجْتماعُنا","فلِمْ كان منه القَصْدُ حتّى تفرَّقْنا",63,"ن",2,0],["إمّا كُمَيْتٍ في قُنُوِّ 