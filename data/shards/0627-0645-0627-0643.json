ي","سمعت به في شملة متشمل",110,"ل",1,0],["أَماكث في الحِمى أَم تَقتفي الأَثرا","فآل سَلمى بِسَلمى اَدلَجوا سحرا",111,"ر",2,1],["أماكن تمكين وأرضٌ بها الرضى","وأرجاء فيها للمشوق رجاء",112,"ا",2,0],["أَمَّا كِتَاوه ثُمَّ سُندَه باري","وأَندَلُوسَ ثُمَّ مُوسى بَاري",113,"ي",1,0],["أما كيوبس فحسب الدهر محكمةً","تقضِى وتأخذُ للمظلوم بالثار",114,"ر",1,0],["أما كنا تعاهدنا","بأن لا نتبع الغدرا",115,"ر",2,0],["اما كساه الله أشرف حلة","من الفضل قد حازت على مثلها رجحا",116,"ح",2,0],["أما كفاك دليلاً في محبتهم","إلا المودة في القربى فعد وتب",117,"ب",1,0],["إمّا كميتاً قد بَدا ذا غُرَّةٍ","مثلَ الكُميت الصرف ذات حُباب",118,"ب",1,0],["أما كفَت غربة في الروح أجرعها","حتى تضاف اليها غربة الوطن",119,"ن",1,0],["أَما كانَ حينَ النقع ثارَ وَأَقبَلَت","خُيول العِدى في كَربلاء تَثور",120,"ر",1,0],["أَما كانَ فيهم من تذكر أَحمَداً","وَمَدمعه لِلظاعِنين غَزير",120,"ر",1,0],["أَما كانَ فيهم من تَذكر بنته","وَبضعتها في كَربلاء تحير",120,"ر",1,0],["أَما كانَ فيهم مِن تذكر حَيدراً","فَتى الحَرب مقدام الجُيوش أَمير",120,"ر",1,0],["أَما كانَ فيهم مَن يرق لِصبية","لَهُم حنة في كَربلا وَزَفير",120,"ر",1,0],["أما كنتما تستوكفان مدامعا","لمحنة عيشى أو أموت مغامرا",121,"ر",2,0],["أَما كَفى خَفَقانٌ بِتّ شاكِيَهُ","حَتّى يُرادَ مِن الآمالِ إِخفاقُ",122,"ق",1,0],["أما كانَ فيكُم واحدٌ يَشْتَري لكم","مديحاً يُغالي ويْحَكُمْ برِداءِ",123,"ا",2,0],["أما كان إزهاق النفوس محرما","على القوم أم ظنوا النفوس لهم حلا",124,"ل",2,0],["أما كفاك انهدامي","ورقدتي في السرير",125,"ر",1,0],["أَما كُلَيبٌ فَإِنَّ اللَهَ زادَ لها","لُؤما عَلى كُلِّ شَيءٍ زادَهُ الكِبَرُ",126,"ر",1,0],["أما كنتم من قبله في شقاوةٍ","فلولاهُ هلْ كنتمْ من السعداءِ",127,"ا",2,0],["أمَا كفَى أنني بالشيبِ مُلتثِمٌ","حَتَّى علا مثلَه بالفَوْد تِيجان",128,"ن",1,0],["أمَا كان عُثمانُ الطَّويلُ ابنُ خالِدٍ","أو القَرْمُ حَفْصٌ نُهيةً للمُخاطِرِ",129,"ر",1,0],["أَم أكؤس مِن فضّة","يُذاب فيهنَّ الذَهَب",130,"ب",1,0],["أمَّا كمَهمَايَكُ مِن شَىءٍ وَفَا","لِتِلوِ تِلوِهَا وُجُوباً أُلِفَا",131,"ف",2,0],["أَما كانَ في صُنع الجَميل بَقية","لَديكُم بِها ي