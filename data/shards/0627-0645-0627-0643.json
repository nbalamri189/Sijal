{"poems":[[53,"أما كنت مع الحي","https://www.aldiwan.net/poem29741.html","الهزج"],[53,"أهلا بهن على التنويل والبخل","https://www.aldiwan.net/poem29905.html","البسيط"],[53,"هوى لكما إن الشباب يعاد","https://www.aldiwan.net/poem30513.html","الطويل"],[53,"عذيري من العشرين يغمزن صعدتي","https://www.aldiwan.net/poem30678.html","الطويل"],[63,"يا طرة الشيح بسفح عاقل","https://www.aldiwan.net/poem46162.html","الرجز"],[100,"سندباد يمني في التحقيق","https://www.aldiwan.net/poem24836.html","عموديه"],[55,"أيا زهر الملاحة والجمال","https://www.aldiwan.net/poem26184.html","الوافر"],[93,"لذكراك يا حفني في النفس أشجان","https://www.aldiwan.net/poem11210.html","الطويل"],[30,"أقول لنفسي واقفا عند مشرف","https://www.aldiwan.net/poem29553.html","الطويل"],[88,"أصبحت أعذل نوابا وأعيانا","https://www.aldiwan.net/poem44391.html","البسيط"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[72,"نفس عن الحب ما حادت ولا غفلت","https://www.aldiwan.net/poem19467.html","البسيط"],[51,"أتاني عتاب من أخ فاغتفرته","https://www.aldiwan.net/poem64967.html","الطويل"],[51,"أبا الفضل لا تحتجب إنني","https://www.aldiwan.net/poem65466.html","المتقارب"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[29,"أما كليب بن يربوع فإن لها","https://www.aldiwan.net/poem6120.html","البسيط"],[91,"ماذا جنيت عليهم أيها القلم","https://www.aldiwan.net/poem62702.html","عموديه"],[78,"سميت سيفا وفي عينيك سيفان","https://www.aldiwan.net/poem14030.html","البسيط"],[32,"تقول بثينة لما رأت","https://www.aldiwan.net/poem27804.html","المتقارب"],[45,"بعينيك إعوالي وطول شهيقي","https://www.aldiwan.net/poem65197.html","الطويل"],[45,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[28,"إليك بنفسي حين بعد حشاشةٍ","https://www.aldiwan.net/poem1287.html",""],[99,"ماذا أقول له","https://www.aldiwan.net/poem5882.html","عموديه"],[97,"بأي لفظ يفيك شعري","https://www.aldiwan.net/poem24969.html","مجزوء البسيط"],[87,"ويلاه من نار الهوى","https://www.aldiwan.net/poem8195.html","مجزوء الرجز"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"أراك على ما يرهق الناس من أذى","https://www.aldiwan.net/poem43052.html","الطويل"],[39,"إن تختلف مضر تتبع عدوهم","https://www.aldiwan.net/poem53772.html","البسيط"],[75,"قد رق من نفس الصباح نسيم","https://www.aldiwan.net/poem69018.html","الكامل"],[75,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[48,"أما كفى طرفك أن ينظرا","https://www.aldiwan.net/poem63323.html","السريع"],[46,"يكفيك حزنا ذهاب الصالحين معا","https://www.aldiwan.net/poem23453.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/142131","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42514","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54876","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54562","المتقارب"],[100,"نهاية حسناء ريفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50449",""],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[30,"أَقُولُ لِنَفْسِي وَاقِفاً عنْدَ مُشْرِفٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20517&r=&rc=11",""],[115,"يا سائق الجمال","https://www.aldiwan.net/poem40600.html","عموديه"],[132,"أعادك من أسماء عيد مشوق","https://www.aldiwan.net/poem54790.html","الطويل"],[160,"اقرت رؤسا في الطلا هذه الرسل","https://www.aldiwan.net/poem58966.html","الطويل"],[160,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[169,"أمن دمنة بين اللوى والدكادك","https://www.aldiwan.net/poem1642.html",""],[169,"إليكن عني فانصرفن على مهل","https://www.aldiwan.net/poem1643.html",""],[182,"قف بي نحي رباها أيها الحادي","https://www.aldiwan.net/poem61045.html","البسيط"],[199,"أما كفاك الفراق غدرا","https://www.aldiwan.net/poem45579.html","مخلع البسيط"],[199,"سهرت والليل أمسى للورى سكنا","https://www.aldiwan.net/poem45626.html","البسيط"],[235,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[235,"ألا ياسمي الإمام الوصي","https://www.aldiwan.net/poem32115.html","المتقارب"],[241,"أما كفى السيف حتى جرد القلما","https://www.aldiwan.net/poem45760.html","الطويل"],[252,"يأبى التأسي انهاء الأسى الجلدا","https://www.aldiwan.net/poem1436.html",""],[252,"أما كفاك تلافي في تلافيكما","https://www.aldiwan.net/poem1474.html",""],[259,"أقول لأهل اللهو والتيه والحجب","https://www.aldiwan.net/poem35748.html","الطويل"],[270,"نظرت إلى ماوية أطلعت لبنى","https://www.aldiwan.net/poem35230.html","الطويل"],[270,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[282,"أما كفاني طرف منك نبال","https://www.aldiwan.net/poem32665.html","البسيط"],[297,"ألية بانعطاف القامة النضرة","https://www.aldiwan.net/poem33265.html","البسيط"],[297,"بربك إن يممت يا صاحبي نجدا","https://www.aldiwan.net/poem33287.html","الطويل"],[364,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[364,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[364,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[364,"ألم يأن يا صاح أم قد أنى","https://www.aldiwan.net/poem61009.html","المتقارب"],[371,"صددت ولي في الناس أهل وجيران","https://www.aldiwan.net/poem57015.html","البسيط"],[371,"يا من يرى أن كل ما ملكت","https://www.aldiwan.net/poem57145.html","المنسرح"],[402,"أو أنه كان يرضي الموت فيك فدى","https://www.aldiwan.net/poem46439.html","البسيط"],[402,"ملكتم فؤادا ليس يدخله العذل","https://www.aldiwan.net/poem46985.html","الطويل"],[406,"أترضونني يا آل جراح إنني","https://www.aldiwan.net/poem50142.html","الطويل"],[409,"إيها بحقك مجد الدين تعلم أن","https://www.aldiwan.net/poem32262.html","البسيط"],[416,"أقول له يوم حث المطي","https://www.aldiwan.net/poem53822.html","المتقارب"],[437,"بما بجفنيك من غنجٍ ومن كحلِ","https://www.aldiwan.net/poem2610.html","البسيط"],[458,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[458,"لكِ الغرام وللواشي بكِ التعب","https://www.aldiwan.net/poem56274.html","البسيط"],[495,"قرة عيني بذكا محبتي أي فلكا","https://www.aldiwan.net/poem10256.html","مجزوء الرجز"],[529,"بدر بأفلاك البلاغة طالع","https://www.aldiwan.net/poem37341.html","الكامل"],[538,"ما لي أرى حبس الحمراء في نكد","https://www.aldiwan.net/poem48228.html","عموديه"],[553,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[564,"أمحمود الشمائل دمت سام","https://www.aldiwan.net/poem844.html",""],[573,"لقد طهر الرحمان آل محمد","https://www.aldiwan.net/poem3643.html","الطويل"]],"verses":[["أَما كُنتَ مَعَ الحَيِّ","صَباحاً حينَ وَلَّينا",0,"ن",2,1],["أَما كَفاهُم لَجاجُ الدَمعِ بَعدَهُمُ","حَتّى اِستَعانوا عَلى عَينَيَّ بِالطَلَلِ",1,"ل",1,0],["أَما كانَ فيكُم مُجمِلٌ أَو مُجامِلٌ","إِذا لَم يَكُن فيكُم أَغَرُّ جَوادُ",2,"د",1,0],["أَما كَمَلَت عِندَ الخُطوبِ تَجارَتي","أَما خَلَصَت عِندَ الأُمورِ رَوِيَّتي",3,"ي",1,0],["أما كَفاها القَدُّ وهْوَ رامِحٌ","ألا تُراميني بطَرْفٍ نابِلِ",4,"ل",1,0],["أما كنت يوما طالبا ؟.. كنت يا أخي","وقد كان أستاذ التلاميذ ، طالبي",5,"ب",2,0],["أَما كانَ النِساءُ عَلِمنَ قَبلي","وَقَبلَكِ كَيفَ تَعذيبُ الرِجالِ",6,"ل",1,0],["أَمَا كَانَ حُكْمُ الدَّهْرِ فِي النَّاسِ وَاحِداً","وَلَمْ تَخْتَلِفْ فِيهِ شُعُوبٌ وَبُلْدَانُ",7,"ن",1,0],["أَما كُنتَ قَبلَ اليَومِ تَعلَمُ أَنَّما","تَنوءُ بِحَرّاثينَ ميلِ العَواتِقِ",8,"ق",1,0],["أما كفى أنهم لم يعملوا عملاً","حتى أرادوا اجتماعاً في شراغانا",9,"ن",2,0],["أما كفاك السنى جمالاً","حتى تجلّلت بالسناء",10,"ا",2,0],["أما كفانيَ تكحيل الجفون أسىً","حتَّى المراشف أيضاً باللّمى كحلت",11,"ت",1,0],["أما كان من صفحٍ سوى أن عضضتني","بأنياب تأنيبٍ ضروباً من العضّ",12,"ض",1,0],["أم اكتنفت أذنك العاذلا","ت باللوم في ذاك كل اكتناف",13,"ف",1,0],["أَمّا كُلَيبُ بنُ يَربوعٍ فَلَيسَ لَهُم","عِندَ المَكارِمِ لا وِردٌ وَلا صَدَرُ",14,"ر",1,0],["أَمّا كُلَيبُ بنُ يَربوعٍ فَإِنَّ لَها","شَرَّ الرِفاقِ إِذا ما حُصِّلَ الرُفَقُ",15,"ق",1,1],["أَما كَفى أَنَّ في آذانِهِم صَمَماً","حَتّى أَرادوا بِأَن يَنتبَها الصَمَمُ",16,"م",1,0],["أَما كَفَت قَتلَةٌ بِالسَيف واحِدَةٌ","حَتّى أُتيحَ مِنَ الأَجفانِ ثِنتانِ",17,"ن",1,0],["أَما كُنتِ أَبصَرتِني مَرَّةً","لَيالِيَ نَحنُ بِذي جَهوَرِ",18,"ر",1,0],["أَما كانَ بَذلُ العَدلِ أَيسَرَ واجِبي","عَلى المُتَعَدّي أَو أَقَلَّ حُقوقي",19,"ق",2,0],["أَما كانَ في تِلكَ الدُموعِ السَوائِلِ","بَيانٌ لِناهٍ أَو جَوابٌ لِسائِلِ",20,"ل",1,1],["أَما كانَ في قَيسِ بنِ عَيلانَ نابِحٌ","فَيَنبَحُ عَنهُم غَيرُ مُستَولَغٍ كَلبِ",21,"ب",1,0],["أما كسرنا كؤوس الحب من زمن","فكيف نبكي على كأس كسرناه؟",22,"ا",2,0],["أما كفى برُك المواسي","فزدتني روعة المزار",23,"ر",1,0],["أَمَا كَفَى هَذَا الْجَفَا","حَتَّى أَعَانَتْهُ الْنَّوَى",24,"و",2,0],["أما كانوا حديثَ الدهرِ لولا","شرائعُه العُلىَ للهاربينا",25,"ن",2,0],["أما كان في بُؤسِ الحياةِ وما جَنَتْ","صُروفُ اللّيالي من أذى العيشِ ما يكفي",26,"ف",2,0],["أَما كَفاها اِبتِياضُ الأَزدِ حُرمَتَها","في عُقرِ دارِهِم أَن يُبعَثَ الحَجَرُ",27,"ر",1,0],["أمَّا كَأنَّ الدهرَ أرضِعَ ثَديَها","فكأنَّما كَفلَتهُ وهوَ يَتيم",28,"م",1,0],["أمّا كواكِبُها له فخَواضِعٌ","تُخفي السجودَ ويَظهرُ الإيماء",29,"ا",2,0],["أَما كَفى طَرفَكَ أَن يَنظُرا","إِن راحَ لِلتَسليمِ أَو بَكَّرا",30,"ر",2,1],["أَمّا كِلابٌ فَأَغنى مِن ثَعالِبِهِم","كَأَنَّ أَرماحَهُم في الحَربِ أَشطانُ",31,"ن",1,0],["أما كفى أنّ في آذانهم صمما","حتّى أرادوا بأن ينتابها الصّمم",32,"م",1,0],["أَمَا كَفَى ما جَرَّ أَحْدَاثُهُ","حَتَّى دَعَا الْغِيدَ إِلى حِزْبِهِ",33,"ب",2,0],["أَمَا كانَ ذاكَ القَلْبُ وَالعَقْلُ نُورُهُ","لِقَلْبِ أَخِيكِ المُوئِلَ الهادي الطَّهْرَا",34,"ر",2,0],["أَمَا كُلُّ ذِي كَلَفٍ مُتْعِبٌ","شَرِيكٌ لِذِي الكَلَفِ المُتْعِبِ",35,"ب",1,0],["اما كان ملء قميصي الربيع ؟","فأين أنا ؟في قميصي سوايا",36,"ا",3,0],["أما كتابُك فهو أفَضلُ ما وَعى","واعٍ وخزيُ معاشرٍ إن لم يَعُوا",37,"ع",3,0],["أما كنتَ قبلَ الحربِ تعلمُ أنَّما","تَنُوءُ بِحَرَّاثِينَ مِيلِ الْعَوَاتِقِ",38,"ق",1,0],["اما كفاك ذلي","يا كثير الدلال",39,"ل",1,0],["أم اكتَحَلَت عَينَاكَ بِالصَّابِ والحُذَا","أمِن ألَمِ الأشوَاقِ فِيهَا التَّحَرُّقُ",40,"ق",1,0],["أما كان في حال بن عجلان عبرة","لمن غره منه التفرفق والمهل",41,"ل",1,0],["أما كان هم أولى بذلك منكم","وخطبهم خطب مهم ومتعب",42,"ب",1,0],["أَما كانَ فيهِم مِثلُ عَمرو بنِ مرثِدٍ","وَذُو المَجدِ دفّاعُ الهُمومِ السَوادِكِ",43,"ك",1,0],["أَما كانَ في أَرضِ العِراقِ مَراغِمٌ","تَرُوقكَ عَن دارِ الزَلازلِ وَالأَزلِ",44,"ل",1,0],["أما كفاكم بني الأنسان شقوتكم","وأنكم للمنايا جدّ وراد",45,"د",1,0],["أما كفاكَ الفراقُ غدرا","وبعدَ هذي الديارِ هجرا",46,"ر",2,1],["أما كفاني ما ألقاهُ من زمني","حتى أغالبَ فيكَ الشوقَ والزمنا",47,"ن",2,0],["أَما كَفاكِ البَينُ لي قاتِلاً","حَتّى شَفَعتِ البَينَ بِالهَجرِ",48,"ر",1,0],["أَما كَونُ مِثلى يَذُمُّ الزَما","نِ في عَصرِ مِثلِكَ مُستَقبَحُ",49,"ح",1,0],["أَمَا كفَى السيفَ حتَّى جرَّدَ القلما","يوماً يُريق مِداداً أو يُريق دَمَا",50,"م",2,1],["أَما كَفى الأَرضَ ما ضَمَّت فَقَد كَفتَت","تُقىً وَأَطهَرَ خَلقٍ فَوقها جَسَدا",51,"د",2,0],["أَما كَفاكَ تَلافي في تَلافيكما","وَلَستَ تَنقِمُ إِلّا فَرطَ حُبيكا",52,"ك",2,1],["أما كان خير الخلق يذكُر ربَّه","جهاراً وسرّاً صحّ نرويه في الكتب",53,"ب",1,0],["أما كنتِ أُفقاً فيه يطلعُ بَدرُها","وما أخَذَت منكِ الجمالَ ولا منا",54,"ن",2,0],["أما كفانا بفقدِ الملكِ نائبةً","حتى أتانا علوجٌ الرومِ عادينا",55,"ن",2,0],["أَما كَفانِيَ طَرفٌ مِنكَ نَبّالُ","مَتى رَنا فَهوَ فَتّاكٌ فَقَتّالُ",56,"ل",1,1],["أَما كَفى البين لا دارَت دوائرهُ","نَوى الحُباب وتلك الخطَّة الخطرَه",57,"ر",2,0],["أَما كنتما أَعطيتماني مَواثِقا","بأَنَّكما لا تَنقُضانِ لنا عَهدا",58,"د",2,0],["أما كَفانا أنَّهمْ قَدَّموا","مَجْداً وطاروا بِقُداماه",59,"ا",2,0],["أما كان زَيْناً للزّمانِ اجْتماعُنا","فلِمْ كان منه القَصْدُ حتّى تفرَّقْنا",60,"ن",2,0],["إمّا كُمَيْتٍ في قُنُوِّ أَديمه","يَحْكي سَميَّتَه الرَّحيقَ السَّلْسَلا",61,"ل",2,0],["أما كّلُّ شيءٍ بهذا الكِتا","ب ما فرط الله فيما حوى",62,"ا",1,0],["أما كانَتِ الأيَّامُ فيما تَشُبُّها","تَخافُ عَليها أن يَجودَ سُليمانُ",63,"ن",1,0],["أما كَفى قاصِديكَ أنَّهمُ","ما سَألوا نائِلاً ولا حُرِمُوا",64,"م",3,0],["أمّا كَرُزْئِك لاَ واللهِ مَا سَمِعَتْ","أذنٌ ولا دَارَ في فكْرٍ ولا خَلَدِ",65,"د",1,0],["أما كانَ أدناهُمْ إليه قرابةً","وأكثرهمْ عِلماً إذا عَظُمَ الجِهلُ",66,"ل",1,0],["أما كانَ أوفاهمْ إذا قال ذمّةً","وأعظمُهم حلْماً إذا زَلّتِ النَّعْلُ",66,"ل",1,0],["أَما كانَ لي في حُرمَةِ السَعيِ مِنكم","ذمام يَردُّ البَغيَ بِالعَزمِ آفكا",67,"ك",2,0],["أَما كانَ في مَدحِ الأَمير أَبي النَدى","لكم مَذهَبٌ تَقضون فيهِ الحَسائِكا",67,"ك",2,0],["أمَا كَفاهُم نَوَى دارِي وبعدُكَ عن","عَينِي وفُرقَةُ إخوانِ الصِّبا الصُّدُقِ",68,"ق",1,0],["أما كنتَ يوم بكتْ بالغميم","فَخِلْتَ المدامعَ من نحرها",69,"ر",3,0],["أما كفاك بأني في هواك لقى","من الصبابة والتبريج والعلل",70,"ل",1,0],["أما كفاه إنْ كفاهُ واعظٌ","بيانُ ما جرَّبَ منكم واختبرْ",71,"ر",1,0],["أما كفاه انصرافُ العين مُعرِضةً","عنه وسمعٌ بوقْر الشوق محتجِبُ",72,"ب",1,0],["أما كفى صدغك لي","إلى الردى معتركا",73,"ك",2,0],["أَمّا كانَ أَعْرَف بالصَّوابِ فَحظُّهُ","في الْعِلْمِ حَظٌّ في الْحَقيقَةِ واسِعُ",74,"ع",1,0],["أما كَفَى أخذُهُ لِفندُقٍ لم يكُن","يَخفَى على أحدٍ مِن ساكنِ البلَدِ",75,"د",1,0],["أَما كَفى البَينُ أَن أُرمى بِأَسهُمِهِ","حَتّى رَماني بِلَحظِ الأَعيُنِ النُجُلِ",76,"ل",1,0],["أما كنا تعاهدنا جميعاً","على عدم الصدود فهل جحود",77,"د",1,0],["أَما كانَ في آلِ النِبِيِّ مُحَمَّد","بِزَعمِكُمُ مَن يَشهَدُ العَقدَ وَالحَلّا",78,"ل",2,0]]}