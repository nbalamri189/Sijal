{"poems":[[33,"أرقت ولم آرق لسقم أصابني","https://www.aldiwan.net/poem41851.html","الطويل"],[52,"وهبت لنا يا فتى منقر","https://www.aldiwan.net/poem62288.html","المتقارب"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[216,"محل بمسيال النجيد دريس","https://www.aldiwan.net/poem37873.html","الطويل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[396,"لك الخير يا عثمان وفقت للرشد","https://www.aldiwan.net/poem54586.html","عموديه"],[409,"أجزتكما يا أهل ودي روايتي","https://www.aldiwan.net/poem33356.html","الطويل"],[463,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[487,"فيا عجبا فرع يتمم أصله","https://www.aldiwan.net/poem24471.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122772","الكامل"],[2071,"","https://poetry.dctabudhabi.ae/diwan/poem/122418","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21444","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93992","الكامل"],[2855,"","https://poetry.dctabudhabi.ae/diwan/poem/203178","الطويل"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199156","الطويل"],[3678,"","https://poetry.dctabudhabi.ae/diwan/poem/34818","السريع"],[3893,"","https://poetry.dctabudhabi.ae/diwan/poem/114857","الوافر"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44698","البسيط"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21577","المتقارب"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66203","الخفيف"],[585,"الكاس واحدةٌ ونحن اثنان","https://www.poetsgate.com/ViewPoem.aspx?id=161930",""],[5136,"بروحي شمس على بانة","https://www.poetsgate.com/ViewPoem.aspx?id=121770",""],[5205,"سما أكباد ارباب النهى انفطرت","https://www.poetsgate.com/ViewPoem.aspx?id=120993",""],[5126,"صَدْمَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87817&r=&rc=32",""]],"verses":[["فَعَضَّت عَلى الإِبهامِ مِنها مَخافَةً","عَلَيَّ وَقالَت قَد عَجِلتَ دُخولا",0,"ل",2,0],["فَعَضَّ الَّذي خانَ في أمرِها","مِنِ اِستِ اُمِّهِ بَظرَها الأَغرَلا",1,"ل",2,0],["فَعَضَّ بِإِبهامِ اليَمينِ نَدامَةً","وَلَهَّفَ سِرّاً أُمَّهُ وَهوَ لاهِفُ",2,"ف",1,0],["فَعَضَّتْ على العُنَّابِ من حَسَراتِها","ونيرانَ أحشاها لهن حَسِيسُ",3,"س",1,0],["فعضَّ غيظاً كفَّه","على ذَهاب الكُفَّه",4,"ه",1,0],["فعضوا عليها بالنواجد ثم من","أتى بسواها قابلوا ذاك بالرد",5,"د",1,0],["فعضوا عليها بالنواجذ واصبروا","فقد فرق الناس الكلام بما فيه",6,"ي",2,0],["فعضَدَ اللّهُ أكفاً سَبْطَةً","تُفدَى ببوعِ غيرها أشبارُها",7,"ر",3,0],["فعضد فرقى لما عضدت جمعه","كبنيان مرصوص تبدى بكشهل",8,"ل",1,0],["فَعَضضتُ كَفَّ الخاسِرِ المَغبُونِ في","تَفريطِهِ وَقَرَعتُ سِنَّ النّادِمِ",9,"م",1,0],["فعضُّوا من الغيظِ الطويلِ أكفَّهم","عليكَ ومن لم يَرضَ فاللَهُ خادِعُه",10,"ع",2,0],["فَعضّت تَراقيهِ بصَفراءَ جَعدَةٍ","فَعَنها تُصاديهِ وَعنها تُراوِدُ",11,"د",1,0],["فعضضت مبسمه الشهي فقال أح","وعن اتصال اللفظ أعرض مغضبا",12,"ب",2,0],["فعَضَّ الذي أبقَى المَواسِي مِن أمِّهِ","خفيرٌ رآها لم يُشمِّرْ ويَغضَبِ",13,"ب",1,0],["فعضَّ عليها بالنواجذ واسألن","له ختم خير والنجاة من العُسرى",14,"ر",2,0],["فَعَضَّ الَّذي خانَني حاجَتي","بِإِستِ اُمِّهِ بَظرَها الأَغرَلا",15,"ل",2,0],["فعضّ بساقِ دَوسَرةٍ عَليها","عتيقُ النيِّ لم تحضُر لقوحا",16,"ح",2,0],["فَعَضِّدونا عَلى المَشروعِ إِنَّكُمُ","أَهل المَكارمِ وَالأَخلاقِ وَالحَسَبِ",17,"ب",1,0],["فَعضَّيت أَعواد رحلي بِهِ","وَناباهُ مِن زَمَع يَضربانِ",18,"ن",1,0],["فَعَضِّي على العِلْمِ الصّحِيحِ بِناجِذَيْ","فَتاةٍ ابَتْ الا عُلا الدّرَجاتِ",19,"ت",1,0],["فعضضت من شفتي لم تفلتهما","حتى استجرتك فامتصصت لساني",20,"ن",2,0],["فعضت على برأس البنان","وهزت تهددني راسها",21,"س",3,0],["فعضبة الشرك إذا لاحت بوادرها","تجلى لها من بوادي نورها نفرت",22,"ت",1,0],["فعضضتُ القلبَ من كمدٍ","وذرفتُ الدمع هطّالا",23,"ل",2,0]]}