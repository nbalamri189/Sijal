,"هي الحرب فانظر كيف ومض البوارق","https://www.poetsgate.com/ViewPoem.aspx?id=161905",""],[5213,"وكم ناقل عن احمد وصف كامل","https://www.poetsgate.com/ViewPoem.aspx?id=170516",""],[5268,"تَحُفُّ بِيَ المَخَاطِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=206999",""],[5274,"البردوني وعروبة اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=203259",""],[5277,"نصيفةُ الروح","https://www.poetsgate.com/ViewPoem.aspx?id=191050",""],[5277,"حديثُ الأحداق","https://www.poetsgate.com/ViewPoem.aspx?id=191115",""],[307,"الصيام وكورونا","https://www.poetsgate.com/ViewPoem.aspx?id=214109",""],[5376,"تأملت الهوى في كل درب","https://www.poetsgate.com/ViewPoem.aspx?id=188538",""],[5388,"قناديل الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=206919",""],[5431,"لقد تعب الجواد من الرُقادِ","https://www.poetsgate.com/ViewPoem.aspx?id=183034",""],[5447,"بين النوى والوصل","https://www.poetsgate.com/ViewPoem.aspx?id=210773",""],[5672,"الحياة...بعد الخمسين","https://www.poetsgate.com/ViewPoem.aspx?id=212476",""],[5691,"هراوة أمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=206339",""],[5725,"هنا كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=206598",""],[5804,"تساؤل","https://www.poetsgate.com/ViewPoem.aspx?id=180661",""],[5804,"أسئلة خطيرة","https://www.poetsgate.com/ViewPoem.aspx?id=180969",""],[5804,"نيّة","https://www.poetsgate.com/ViewPoem.aspx?id=195270",""],[5804,"كورونا والحدود","https://www.poetsgate.com/ViewPoem.aspx?id=214739",""],[5830,"الْكَوْنُ يَنْظُرُكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=200765",""],[5909,"وكم ناداه سراً طيف ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=210579",""],[5944,"طبيب الغلابة","https://www.poetsgate.com/ViewPoem.aspx?id=215189",""],[6088,"الي","https://www.poetsgate.com/ViewPoem.aspx?id=207597",""],[520,"شغل الزمان بما تقول وتفعل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577611",""],[6072,"أرَقٌ وغَرَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82190&r=&rc=22",""],[463,"ألاَ من مبلغٌ أسدا رسولا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59979&r=&rc=35",""],[6290,"هَوَى الصِّبْيَانِ وَشْمٌ فِي قُلُوبٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85167&r=&rc=4",""]],"verses":[["وَكَم نَظرَةٍ تَستَوهِبُ القَولَ مِن فَمي","تُكَلَّفُ نُطقي في جَوابِ المُكَلَّمِ",0,"م",1,0],["وَكَم نَدِيَت مِن نَداهُ المُنى","نَدى سُمرِهِ بِالنَجيعِ المُمارِ",1,"ر",1,0],["وَكَم نابِغٍ في أَرضِ مِصرَ حَمَيتَهُ","وَمِثلُكَ مَن يَحمي الكَريمَ وَيَمنَعُ",2,"ع",1,0],["وَكَم نِعمَةٍ أُلبِستُها سُندُسِيَّةٍ","أُسَربَلُها في كُلِّ حينٍ وَأُلحَفُ",3,"ف",1,0],["وَكَم نَفَّرَت مِن رامَحٍ مُتَوَضِّحٍ","هِجانِ القَرا ذي سُفعَةٍ وَخِدامِ",4,"م",1,0],["وَكَم نَفَّرتُ دونَكِ مِن صِوارٍ","وَمِن خَرجاءَ مُرئِلَةٍ وَخودِ",5,"د",1,0],["وكم نطقوا بألسنةٍ حدادٍ","يسيل لها من الأشداق حوب",6,"ب",1,0],["وكم نصحت فما أسمعت من أحد","حتى لقد جفّ لي ريق وكلّ فم",7,"م",1,0],["وكم نرى فعل فاعلات","من القوى وهي في الخفاء",8,"ا",2,0],["وكم نقدةٍ من تبره ولجينه","تخِذْتُ لديها كالنجم مرصدا",9,"د",2,0],["وكم ناصح كذّبت دعواه إذ غدت","عليَّ وآلت حلفةً لم تحلَّل",10,"ل",1,0],["وكم نشصتْ من نِعمةٍ فعطفْتها","على بَعلها حتى غدتْ غير ناشص",11,"ص",1,0],["وكم نِيلت بجودك من أحاظٍ","يبيتُ لرحل صاحبها أطيطُ",12,"ط",1,0],["وكم نزعت منا إليكم مطامع","فأضحت وعنكم لا إليكم نزوعها",13,"ع",3,0],["وكم نادمتُ راحَ الروحِ فاهُ","ولكن خانني ذاك الندامُ",14,"م",1,0],["وكم نِضْوٍ أناخ بها إليه","تضيَّفُها المجادب والسآمُ",14,"م",1,0],["وكم نَهش الحيّاتِ في هضباتِها","وكم فرس الأُسدَ الخوادِرَ في الأجمْ",15,"م",1,0],["وكم نعمةٍ أذوى وكم غبطةٍ طوى","وكم سند أهوى وكم عُرْوةٍ فصمْ",15,"م",1,0],["وَكَمْ نَسَجْتَ من الأَحلامِ أَرديةً","قَدْ مزَّقَتْها اللَّيالي وهي تَبْتَسِمُ",16,"م",1,0],["وكم نقلت جريحا","فمات بالاستشاره",17,"ر",2,0],["وَكَم نَظَرنا بِكُم نُعمى فَجَسَّمَها","لَنا السُرورُ فَكانَت عِندَنا نِعَما",18,"م",2,0],["وَكَم نَفَّسَت في حِمصَ عَن مُتَأَسِّفٍ","غَدا المَوتُ مِنهُ آخِذاً بِالمُخَنَّقِ",19,"ق",1,0],["وَكَم نَذَرَت مِن صَومِ شَهرٍ وَحِجَّةٍ","نِساءُ تَميمٍ إِن أَتاها يَزيدُها",20,"د",3,0],["وَكَم نَماكَ مِنَ الآباءِ مِن مَلِكٍ","بِهِ لِذُبيانَ كانَ الوِردُ وَالصَدَرُ",21,"ر",1,0],["وَكَم نامَ عَنّي بِالمَدينَةِ لَم يُبَل","إِلَيَّ اِطِّلاعَ النَفسِ دونَ الحَيازِمِ",22,"م",1,0],["وَكَم نَظرَةٍ قادَت إِلى القَلبِ حَسرَةً","يُقَطَّعُ أَنفاسَ الحَياةِ زَفيرُها",23,"ر",3,0],["وكم نسينَا وكم محَونَا","وكم غفرنَا لمن أساء",24,"ا",2,0],["وَكَم نَديمَينِ لَولا لذّةٌ لَهُما","في ذِكرِ سيرَتِهِ الحسناءِ لافتَرَقا",25,"ق",2,0],["وَكَم نَكبَةٍ ظَلماءَ تُحسَبُ لَيلَةً","تَجَلّى لَنا مِن راحَتَيكَ نَهارُها",26,"ر",3,0],["وَكَم ناكِثٍ لِلعَهدِ قَد نَكَثَت بِهِ","أَمانيهِ وَاِستَخذى لِحَقِّكَ باطِلُه",27,"ل",2,0],["وَكَم نِعمَةٍ لِلَّهِ في صَرفِ نِقمَةٍ","تُرَجّى وَمَكروهٍ حَلا بَعدَ إِمرارِ",28,"ر",1,0],["وَكَم نَومَةٍ لِيَ قَوّادَةٍ","أَتَت بِالحَبيبِ عَلى بُعدِهِ",29,"ه",1,0],["وَكَم نَزَلَ القَيلُ عَن مِنبَرٍ","فَعادَ إِلى عُنصُرٍ في الثَرى",30,"ر",2,0],["وَكَم نَهَضَ اِمرُؤٌ مِن بَينِ قَومٍ","وَفي هاديهِ مِن خِزيٍ عِلاطُ",31,"ط",1,0],["وَكَم نِسوَةٍ رَبَّينَ كَالنَخلِ فِتيَةً","فَحُزنَ بِما أَمكَنَّ مِن وَلَدٍ حُزنا",32,"ن",2,0],["وَكَم نَزَلا في مَهمَهٍ وَتَحَمَّلا","بِغَيرِ حَسيسٍ عَن جِبالٍ وَغيطانِ",33,"ن",1,0],["وكم نبغت فيها رجال أَفاضل","فَلَمّا دَهاها العسف عنها ترحلوا",34,"ل",3,0],["وكم نبأةٍ كالحديث الجديد","وما هو إلَّا القديم السماعْ",35,"ع",1,0],["وَكَمْ نَسفْتَ بِنَاءً","لِلظالِمِينَ فَخَرَّا",36,"ر",2,0],["وَكَم نَضَحتُ بِدَمعي","حرَّ الحَشا لَو برَدتُه",37,"ت",2,0],["وكم نقمةٍ أعقبَتْ نعمةً","وكم مِعْوَلٍ هادمٍ عَمَّرَا",38,"ر",2,0],["وَكم نفّستْ في حِمصَ من مُتَأسِّفٍ،","غَدا المَوْتُ مِنهُ آخِذاً بالمُخَنَّقِ",39,"ق",1,0],["وكَمْ نَازَعَ البَرْدُ الشَّدِيدُ بَقَاءَهَا","نَوائِبُ تَأْتِي كاللَّيَالِي وتَسْتَتْلِي",40,"ي",1,0],["وكم نطقوا بالسنة حداد","يسيل بها من الأشداق حُوب",41,"ب",1,0],["وكم ناقص يختال في طور كامل","وكم من حريص لابس ثوب زاهد",42,"د",1,0],["وكم نعمت بربات الجمالِ وأر","بابِ الدلالِ وما إذ ذاك إدلالُ",43,"ل",1,0],["وكم ناحلٍ بين تلك الخيا","م تحسَبه بعضَ أطنابها",44,"ب",3,0],["وَكَم نَطَقتَ بِفَصلِ القَولِ مُرتَجِلاً","وَالبيضُ في قِمَمِ الأَبطالِ تَصطَحِبُ",45,"ب",1,0],["وَكَم نَكبَةٍ زاحَمتُ بِالصَبرِ رُكنَها","فَلَم يلفَ صَبري واهِياً حينَ يَزحَمُ",46,"م",1,0],["وَكَم نَدِيِّ ضَلالٍ كانَ ذا لجَبٍ","سَطا فَأَخرَسَهُ عَن قَولِ لا وَهَلِ",47,"ل",1,0],["وكَمْ نادَيْتَ ما أسْمَعْتَ حَيًّا","فَكَيْفَ سَيَسْمَعُ الأحْياءُ مَيْتًا؟",48,"ت",2,0],["وَكَم نِعَمٍ أسدى لهم غيرَ أَنّهم","لِخِذلانهم قَد أَبدلوا شُكرها كفرا",49,"ر",2,0],["وَكَم نَبحوهُ وَهو في الأفق طالعٌ","وَلكنَّ نبحَ الكلبِ لا يصل البدرا",49,"ر",2,0],["وَكَم نادمٍ من وضعِ أولاده بها","وَقَد سَبَقت أسيافُها العذلَ والعذرا",49,"ر",2,0],["وكم نبّهت شكواك في الدوح بلبلا","فشاطرك الشكوى ونارك تكويه",50,"ي",2,0],["وكم نفَسٍ في الهوا","بنفسِ الفتى يخرجُ",51,"ج",1,0],["وكم نفرٍ تغرهمُ الليالي","وما خُلقوا ولا هيَ للدَوامِ",52,"م",1,0],["وَكَم نَكرَ الزَمانُ عَلَيَّ حَقّاً","وَكَم فنيَ الزَمانُ وَما فَنيتُ",53,"ت",1,0],["وكم نهضتَ إلى العَلْياءِ إذ عَجَزُوا","وكم أَفضْتَ بِحارَ الجُودِ إذْ بَخلوا",54,"ل",3,0],["وكم نِعم ناعماتِ الغصون","لبِسنا بظِلّك اَظلالها",55,"ل",3,0],["وكم ناب عن نُوْر الضحى فيك مَبْسِم","ونابت عن الوَرْد الجنِيّ خدود",56,"د",1,0],["وكَمْ نادَيْتُ يا هذِي ارْحَمِينَا","فلسْنا بالحَدِيدِ ولا الحِجَارَهْ",57,"ر",2,0],["وَكَم نَتَجَت حُروبٌ أَلقحَتها","سيوفُكَ وَالنتاجُ عِن اللِقاحِ",58,"ح",1,0],["وَكَم نَقَضت مِن مُوثَقٍ جَعلت بِهِ","شَهيداً عَلَيها عالِم السِرِّ وَالنَجوى",59,"و",2,0],["وكم نازلات ضاق ذرعاً بها الفتى","ولا يرتجي إلا من اللَه رفعها",60,"ع",3,0],["وكم ناطح صماء من غير حاجة","يزعزع روقيه ويعييه قلعها",60,"ع",3,0],["وكم نبح الكلب السماء وبدرها","اضر وضيع في العلاء رفيعا",61,"ع",2,0],["وَكَم نَصَبوا العداوَةَ لي بكيد","فكادوا يهدمون به جدار",62,"ر",1,0],["وكم نادت فأسمعت الليالي","ولكن لا مصيخ إلا مناد",63,"د",1,0],["وَكَم نَجا حاملوهُ الحافظونَ له","من سوءِ خَطب ملمٍّ فادحٍ عَممِ",64,"م",1,0],["وكم نعمة أسبغت من سر حكمة","أنرت بها من ناطق كل ظلمتي",65,"ي",1,0],["وكم نقَص البَدرُ من مَرّةٍ","فقابَلَه الشَّمْسُ حتّى كَمَل",66,"ل",1,0],["وكم نعمةٍ أعطَيْتَها وهْي جَزْلَةٌ","ولكنّني نَشّرتُها لم أغَطَها",67,"ط",3,0],["وَكَم نُشِرَت مِنهُ مَناشيرُ حِكمَةٍ","طَوى كاشِحٌ عَن أَن يُساجِلَها الكَشحا",68,"ح",2,0],["وكَم ناظرٍ أجفانُه جنس صارمٍ","غَنيٍّ على طولِ الضِّرابِ عن الصَّقلِ",69,"ل",1,0],["وكم نعم ليس تحصى باللسان","ولا تعد بعد العادين",70,"ن",1,0],["وكم نعم والعبيد الخام عنها غفول","ما يعرف إلا أنه يأكل وأنه يبول",71,"ل",1,0],["وكم نيطت سعادات بفقر","وكم جلب الغنى من مهلكات",72,"ت",1,0],["وكم نُوبٍ جلّيتُ بالصَّبر دُهْمَهَا","ومَا المجدُ إلا الصَّبر للنّوب الدَّهْم",73,"م",1,0],["وكم نقصتْ لِلنّيل يوماً أصابعٌ","وبحرّك ما ازدادَ النوال يزيدُ",74,"د",1,0],["وكم نكبةٍ ظَنَّ العِدا أنَّها الرَّدى","سَمتْ بي وأعلَت في البَرِيَّة شاني",75,"ن",2,0],["وكم نِعَمٍ له عندي وأيدٍ","رغمتُ بهنَّ آنافَ اللئام",76,"م",1,0],["وكم نعمةٍ أوْلَيْتَنيها وحَسرةً","غَدَوْتُ بها من لوعة البين شاكيا",77,"ي",2,0],["وكم نعمةٍ أسدَيْتَها فبَذَلْتها","وصيَّرْتَ أحرار البريَّة أعبدا",78,"د",2,0],["وكم نظمت في عقود مدائح","مزاياه في تلك العقود فرائد",79,"د",1,0],["وكمْ نازل مثلي بساحة حيِّهم","أَقامَ ولم يُؤْذنْ له برحيل",80,"ل",1,0],["وكم نعمةٍ أوْلَيْتَني فشكرتُها","ولو لم يَفُه منِّي لسان ولا فم",81,"م",1,0],["وكم نَثَرت على الأَسماع درّ فمٍ","فكان ذيالك المنثور منثورا",82,"ر",2,0],["وكم نثرت نثراً بلاغتك الَّتي","أردت بها دُرَّ المعالي منظما",83,"م",2,0],["وكم ناشدتك الشعر المقفى","حديثاً في اللويلات الدجيّه",84,"ي",2,0],["وكم نادى لطهماز بشتم","ولعن حيث أبدع ذي البليّه",84,"ي",2,0],["وكم ناجَتْ نفوسَهُمُ المنايا","فَلأْياً مَا نجا بِهِم النَّجاءُ",85,"ا",2,0],["وكم نَفَّستَ كُرْبَةَ مستكينٍ","تَأَخَّرَ عنهُ نَصْرُ الأَولِياءِ",86,"ا",2,0],["وكم نوح على صخر","وكم في الحي من خنسا",87,"ا",1,0],["وكم نفَرتْ لتنشُزَ عنك حتّى","نشَطتُ من الوفاء لها عِقالا",88,"ل",2,0],["وكم نَشَزتْ على قومٍ سواكم","فلم يعلَقْ بها الرجلُ الطَّلوبُ",89,"ب",1,0],["وكم نوديتَ يا بحرَ العطايا","فجاء البحرُ بالعجبِ العُجابِ",90,"ب",1,0],["وكم نوع إحسانٍ وصنف يفيدهُ","إذا ما انقضى نوعٌ من القول أو صنف",91,"ف",1,0],["وكم نفثت به الألباب سحرا","وكم أجرى ببحره من جوار",92,"ر",1,0],["وكم نهضت به همم وهبت","على الضعفاء أرواح انتصار",92,"ر",1,0],["وكم نحت لما أن تناء خيالها","كأني أنا موسى بميقات صعقتي",93,"ت",2,0],["وكم نصبت لها فخ الجفون على","مهواة وكر لعل الطيف ينسرق",94,"ق",1,0],["وكم نبت الأوطان يوماً بأهلها","فأورثها عز الحياة التغرب",95,"ب",1,0],["وكم نشأت من لج بحر غمامة","سرى وبلها في لجة البحر ممطرا",96,"ر",2,0],["وكم نادت ظباه إلى قلوب","وقد خفقت رويدك لن تراعي",97,"ع",2,0],["وكَمْ ناصِحٍ لمْ تَقْبَلُوا مِنْهُ نُصْحَهُ","وإنْ جاءَ بالحَقِّ الذي هُوَ أَبْرَمُ",98,"م",1,0],["وكم نغَم يُشجي كصَوت بَلابلٍ","وأصواتُ لآلاتِ الغِنا تَتردَّد",99,"د",1,0],["وكم نكبةٍ طالتْ يداً لتنالني","فباعد ما بيني وبين مَنالها",100,"ل",3,0],["وكم نِعَمٍ لجدِّهِمُ عليكمْ","لقين بكمْ جُحوداً أو غِماطا",101,"ط",2,0],["وَكَم نَذِلُّ وَفينا كلُّ ذي أَنَفٍ","ونستكينُ وفينا العِزُّ والشَّوَسُ",102,"س",1,0],["وَكَم نادَيتُ فيهِ مِن حَبيبٍ","عَهِدتُ بِهِ فَلَم أَسمَع جَوابا",103,"ب",2,0],["وكم نعمة قد حبانا بها","وأعظمها خلقُنا من عدم",104,"م",1,0],["وكم نظرة أوحت إلى القلب حسرة","تبيد قوى الإنسان والحال شاهد",105,"د",1,0],["وكم نظرت وقد أكبرت من جبل","أشم يزلق عن أطرافه البصر",106,"ر",1,1],["وَكَمْ نَظرْتُ لِوَجْهٍ لَيْسَ في بَدنٍ","وَكَمْ سَمِعْتُ بِصَخْرٍ لَيْسَ مِنْ حَجَرِ",107,"ر",1,0],["وكم نظمت قريضا مثل در","يُصاغ قلائداً للناظمات",108,"ت",1,0],["وَكَم نِعمَةٍ تَبدو فَتَرجِعُ نَقمَةً","وَمَغنَمَ قَومِ عادٍ مِن بَعدُ مُغرِما",109,"م",2,0],["وَكَم نَبَت بِالسَفينِ عاصِفَةً","وَظَنَّ أَنَّ الرِكابَ قَد غَبَروا",110,"ر",3,0],["وَكَم نَبى في ذي البِلادِ قَفا","موسى وَكَم مَرَّ هَهُنا الخَضرُ",110,"ر",1,0],["وكم نازلٍ في بُرج قَصرٍ مُشيَّد","إلى قَبره عَن صَحنِ صَرح مُمرَّد",111,"د",1,0],["وكم نيَةٍ قد بَشَّرَت بلقائِكم","فعاندَ في صَرفِ النوى بِخِداجها",112,"ج",3,0],["وكم نمت الأفكار في ثنوية","من الريب أربابا من الوثنية",113,"ه",1,0],["وكم نشأت من حرٍ أبيٍ","كساكَ من المفاخر ما كساكا",114,"ك",2,0],["وَكم نجحت في نَظم أَبهى مَدينة","لِديوان أَشغال المباني عَزائم",115,"م",1,0],["وكَمْ نَعَّمَتْني مِنْ لذيذِ وصالِها","بما لَمْ تَصِلْ نفسي له بِتَوَهُّمِ",116,"م",1,0],["وكم نثرت ايدي السحاب لآلئا","تقاصر عن منثورهن المنضد",117,"د",1,0],["وكم نشرت مشهدا رائعا","يغادر رشد الفتى ضائعا",118,"ع",2,1],["وكم نوَّط روحي ر","شأٌ ما عِفتُ تَنْويطه",119,"ط",2,0],["وكم نتقي الأعداء والدين خامل","ونغضي على الإقذاء منهم ونكظم",120,"م",1,0],["وَكَم نَقَلَ الراوونَ آيات فَضلهِ","وَيَتلونَها بِالحمدِ كَالشّمسِ وَالفَجرِ",121,"ر",1,0],["وكم نفس تموت أسىً","ولم تعلم خفاياها",122,"ا",3,0],["وكم نظمت الملحا","وكم لثمت القدحا",123,"ح",2,0],["وكم نفيس بعته","في الأهيف المنعم",123,"م",1,0],["وكم نصيب صابني","وكم معيب عابني",123,"ي",1,0],["وَكَم نَفَسٍ يعلُو هنَاكَ وَأَنَّةٍ","إِليكُم وَدَمعٍ فَوقَ خَدِّي لَهُ سَكبُ",124,"ب",1,0],["وكم نحر طفل صغيراً غدا","يحمر ما بيض الصيقل",125,"ل",1,0],["وكم نظموا كيدا فلم يغن عنهم","إذا كنت ممّن شأنه النظم والنثر",126,"ر",1,0],["وكم نبّهت أني لا أؤاخي","لذيبٍ عادم الأركان خاطفْ",127,"ف",1,0],["وكمْ نَظْرةٍ في نَضْرَةٍ مِنْ نَعيمهِ","رَأَيْتُ بِها مِنْ مُقَلتي عينَ مَقْتلي",128,"ي",1,0],["وكمْ نِعْمَةٍ لكَ قَرَّتْ لِذي","قرينَةِ قافيةٍ شارِدَهْ",129,"د",2,0],["وَكمْ ناظِرٍ لي دمْعُه وسُهادُهُ","ولِلحبِّ مِنْهُ نورُهُ وهُجودُهُ",130,"د",2,0],["وكم نعمة عزت علينا بأصفر","فنيلت بصفر من عميد بني الاصفر",131,"ر",1,0],["وكم ناح حي ميته مثل خالد","يدوم ووافته الوفاة فساواه",132,"ا",2,0],["وكم نحسد الشمس التي دائما على","مديد المدى تحوي من النور اسناه",132,"ا",2,0],["وكم نتيه كأنا لا نموت وكم","لمنا اطباءنا ظلما وبهتانا",133,"ن",2,0],["وكم ندنف في قصده جد عيشه","وكم من طبيب مات فيه من الفقر",134,"ر",1,0],["وكم نعمة كانت على الُحرِّ نقمَةً","وكم مغنمٍ يَعتَده الحرُّ مَغرَما",135,"م",2,0],["وكم نثروا زهر الربى في طريقه","وكم نظموا في الجيد من لؤلؤ رطبِ",136,"ب",1,0],["وكم نُصبَ عينيكَ يا بن النبي","نساط بِقدر البَلا الفائرِ",137,"ر",1,0],["وكم نحن في لَهوات الخطوب","نناديك من فمِها الفاغرِ",137,"ر",1,0],["وكم نطفة منْ ماءِ وجهي أرَقْتُها","بودّيَ لو أنّي أرَقْتُ لها دمي",138,"م",2,0],["وكم نسبوا للمرسلين خطيئةً","وهذا لعمري في المقالة أشنع",139,"ع",1,0],["وَكَم نُصِحتُ وَلَكِنَّ الهَوى قَدَرٌ","أَصَمَّ سَمعي وَأَعماني تَضَرُّمُهُ",140,"م",2,0],["وكم نبت في حربهم عن علي","ى وناب عن النهروان النهر",141,"ر",1,0],["وكم نشز عال علته رفودنا","وتعلو به الأصوات حين علوناه",142,"ن",3,0],["وكم نصرت رسول الله منصلتا","كالسيف عري متناه من الخلل",143,"ل",1,0],["وَكَم نَظَمتُ لَكَ الأَوصافَ مُحكَمَةً","كَأَنَّها الدُرُّ تَمثيلاً وَتَشبيها",144,"ي",3,0],["وكم ناديت قلبي عنه إبرا","فقال هواك يا عشاق",145,"ق",1,0],["وَكَم نِلتَ مِن مَولاَكَ عِلماً وَحِكمَةً","لِنَيلِهِما أَهلُ العُلاَ قَد تَقاصَرُوا",146,"ر",3,0],["وكم نبيء تارك أوطانه","شدَّ الإله بعد ذا سلطانه",147,"ه",1,0],["وكم نَيْلُوفَرٍ غضٍّ شهيٍّ","لجيشِ بهارِه يورِي زنادَهْ",148,"د",2,0],["وكم نهبوا وكم سلبوا وجاروا","على الأمراء والمستضعفينا",149,"ن",2,0],["وكم ناديت والأقوام صرعى","نديمي يا نديمي يا نديمي",150,"م",2,0],["وكمنّ قسطنطين نحت صليبه","ومد القنا من فوق ارعن ممتد",151,"د",1,0],["وَكَم نَصَحوا لَو كانَ لِلنُّصحِ مَوضِعٌ","وَكَم عَذَلوا لَو كانَ فيهِم مُحَلَّمُ",152,"م",1,0],["وكم نشرت أوصافك الغر واغتدى","شذا المسك من أردانها يتضوع",153,"ع",1,0],["وكم نهضت بآمالي وقد قعدت","بي الملوك وكم أجررت من رسن",154,"ن",1,0],["وكم نحبتَ على صبٍّ علِقْتَ به","وأصدقاءَ سُوَيدا القلب قد نزلوا",155,"ل",3,0],["وكم ندبوا لِلّه سراً وجهرة","وقد خلصا منهم له السر والجهر",156,"ر",1,0],["وكم نعمة غراء قلدهم بها","فطوّقهم طوق الحمامة بالشكر",157,"ر",1,0],["وكم نكبة في حاصبيا وكوكبا","وراشيةٍ عن عدها قصر العد",158,"د",1,0],["وكم نرى بينهم اختاً لخير اخ","جاءت تصوغ الثنا دراً وكم وكم",159,"م",1,0],["وكم نَظَرتُ في حسابِ العَرَبِ","وحسبةٍ للهند مذ كُنتُ صبي",160,"ي",1,0],["وَكَم نَشا تَزوير عمالها","وَمالها في الكَون مِن ساتر",161,"ر",1,0],["وكم نفوس سموا إليها","فصادفوا الباب وهو مغلق",162,"ق",1,0],["وكم ناطَحْتُ بالكَبْشَينِ نَطْحاً","وأَلجيتُ الدُّيوكَ إلى القتالِ",163,"ل",1,0],["وكم نظر المشوق به جمالاً","وابصر وجه درهمه الضنين",164,"ن",1,0],["وكم نسبوا للأقدمين سفاسفاً","فكذبتُها من فرط ما اختلقوا عني",165,"ي",1,0],["وكم نصحتنا لو أصخنا لنصحها","وكم خاطبتنا لو فهمنا لها نطقا",166,"ق",2,0],["وكم نال منك المرء عابر لذةٍ","فنغّصتها مما طلبت وثرثرت",167,"ت",1,0],["وكم نزلنا مثيلاً منك ما حميت حمى","الهجير أذا قنناً بحرّاءِ",168,"ا",2,0],["وكم نهر العذال سائل أدمعي","فأقبل مثل النهر بالسر معربا",169,"ب",2,0],["وَكَم نار حَرب خاضَها صارَ حَرها","كَما نار إِبراهيم أهَدى وَأَسلَما",170,"م",2,0],["وكم ندبتني في حماها ضريرة","تنوح بصوت هالع الوقع ذابل",171,"ل",1,0],["وكم نبي قد ملي بالشجن","لأمةِ الهادي عظيم المنن",172,"ن",1,0],["وكم نشروا علينا من صنوف","تجر الى الدمار ومن ضروب",173,"ب",1,0],["وكم ندعو الحماة لدى الدواهي","وما غير التخلي من مجيب",173,"ب",1,0],["وَكَم نعمة أَسبغتها لي جمة","فَأَمسَت قُلوب الحاسدين تمزق",174,"ق",1,0],["وكم نعمة آتاكها الله جزلة","مبرأة من كل خلق يذيمها",175,"ه",2,1],["وَكَم نافسوهُ ظالمينَ وسرّهم","كلامٌ أباحتهُ الغِواية مفسدُ",176,"د",1,0],["وكم ناسٍ بِمَوْتِ أُصولِهم قد","رَقَوْا رُتَباً لها شَرَفٌ وعِزَّهْ",177,"ه",1,1],["وكم نفس كمثل الخمر رجس","يواريها من الأشخاص دن",178,"ن",1,0],["وكمْ نازعته الأمر قومٌ أعزة","فما أسلمته بيضُه وصوارمهْ",179,"م",2,0],["وكم نضى صوارما لم يتخذ","لها سوى هام العدا من غمد",180,"د",1,0],["وَكَم نِعمَةٍ يَعصي بِها العَبدُ رَبَّهُ","وَبَلوى عَدَتهُ عَن رُكوبِ الكَبائِرِ",181,"ر",1,0],["وَكَم ناظر شَذراً لَها فَتَمَنَعت","وَزَفَت إِلى من كان أَحسَن مَنظَرا",182,"ر",2,0],["وكم نلت من كنز البلاغة ما به","قطفت جميل المن لا المن والسلوى",183,"و",2,0],["وكم نُدِبتُ إلى فرض فاوهَمَني","حُزني لاني بعبءِ الفَرض لم أَقُم",184,"م",1,0],["وكم نفوسٍ مَشَى فيها الرَدَى خَبَباً","لمَّا مَشَت في الهوى نَهداً على خَبَبِ",185,"ب",1,0],["وكم نفّروا طائعات القلوب","ومن مقتضى الطبع أن تنفرا",186,"ر",2,0],["وَكَم نَصيحة صرف في خلال هَوى","قَد أَغضبتني إِذ صحت وَأَرضاني",187,"ن",2,0],["وَكَم نبهج الدُنيا بحلو الفكاهةِ","وَنرشف منها كُلَّ كَأسٍ مريرة",188,"ه",1,0],["وَكَم نَلهى بالآمال ندهى بغرة","عليها يكر الدَهر من كُل وجهة",188,"ه",1,0],["وَكَم نَرى عبرةً في الدَهر لو جُليت","عَنا الغَياهبُ أَغنى الخُبْرُ عن خَبَر",189,"ر",1,0],["وَكَم نَخوة همت فَآبت بذلة","وَكَم طاهر لما اِزدَهى غاله الرجز",190,"ز",1,0],["وكم نسجت لنفسي من فضائلهم","نسجاً على الزرع من هون وإجلال",191,"ل",1,0],["وكم ندب بها إن رام أمراً","بغير الفتح يأبى أن يؤوبا",192,"ب",2,0],["وكم نقضت من الدنيا عليهم","مواثيق وكم نكثت عهود",193,"د",1,0],["وكم نازلت من مزده بشبابه","فألهته عن ليلى ولبنى وعاتكه",194,"ك",2,0],["وكم نوافل جود في الوجود سرت","لله في الكون سر لا يرى فيه",195,"ي",2,0],["وكم نهوي بكوثر فيه وردا","وحور عيونه تحميه منا",196,"ن",2,0],["وَكَم نَكبَةٍ لَو أنَّ أَدنى مُرورِها","عَلى الدَهرِ ذَلَّت عِندَها نوَبُ الدَهرِ",197,"ر",1,0],["وكم نعمة أسدى لهم بعد نعمة","ولكنه أسدى إلى غير شاكر",198,"ر",1,0],["وكم نِعَمٍ خوّلته لم تشلّه","بخيلٍ ولم توجف عليه ركابا",199,"ب",2,0],["وكم نصحت لأهل الغي فانتصحوا","وكم زجرت بغاة الشر فازجروا",200,"ر",3,0],["وكم نمَّ عنها في الدُّجَى نَفَسُ الصَّبَا","فبتنا نخالُ الليلَ مِسْكاً وَعَنْبَرا",201,"ر",2,0],["وكم نبيهٍ نبيلٍ فيه مطلعٌ","مفكرٌ في صنيع البارئ الحكمِ",202,"م",1,0],["وكم نلت مذ أصبحت الثم كفه","بيمناه من يمن ويسراه من يسر",203,"ر",1,0],["وَكَم نَشَرتَ خَيالاً كُلُّ جَوهَرِه","مُرَكَبٌ مِن مَزيجِ النورِ وَالثَمرِ",204,"ر",1,0],["وكم نَمَّقَتْ أفكارُه غَلَسَ الدُّجى","رياضاً سقَاها الفضْلُ طَلاًّ ووَابِلاَ",205,"ل",2,0],["وَكَم نُكَتٍ أَبدى لَنا مِن فُنونِه","طَرائِف مِنها يَرشُف السَمعَ كَوثَرا",206,"ر",2,0],["وكم نفذ الأحكام في يوم فصله","فما جار يوما في القضايا ولا اعتدى",207,"د",2,0],["وَكَم نَثَرَت نَظماً وَأَصمَت وَأَصمَتَت","وَذا دأبُها مِن عَهدِ عادٍ وَجُرهُمِ",208,"م",1,0],["وكم نورٍ أضاءَ بنور زُهرٍ","تبلَّج من سنا الدر النضيدِ",209,"د",1,0],["وكم نوَّرت في نَور نور بديعها","معانيَ سُرٍّ راق فيها انسجامُها",210,"م",3,0],["وكم نال أوطاراً على الجهل شاربٌ","قَعيدٌ عن المسعى أَخو الزيغ شاربُه",211,"ب",2,0],["وكم نِقابٍ فلا تَرجى مناقبهُ","وكم مَهوبٍ فَلَم يعبأ بِهِ الجارُ",212,"ر",1,0],["وكم نبالٍ رمت عن قوس حاجبها","تخال رنّاتها بالقلب ناقوسا",213,"س",2,0],["وكم نائم قد نَبَّهتْ وبصيرةٍ","بها جُلِيَتْ مرآتها بعد إصداءِ",214,"ا",2,0],["وَكَم نَسِينا جِسرَ وَضَّاحِ بِما","أَوضَحَ لِلعَينِ الجُسَيرُ وَجَلا",215,"ا",1,0],["وَكَم نَوى عَزمِي أَن يَفرى النَوى","والرَحلُ مِن غارِبِها ما قَد نَوى",215,"ا",1,0],["وكم نلتَ بالبربير اسمى فضيلة","وفضل وآدابٍ وكم حزتَ من قدرِ",216,"ر",1,0],["وَكَمْ نَفَى عَنْكَ عُذْرِيُّ الِهَوَى وَسَنِِا","وَأَثْبَتَ الِِوَجِْدُ خَطَّيْ عَبْرَةٍ وَضَنا",217,"ن",2,0],["وَكَم نالَني من فَيضِ فَضل نَوالِه","سَحائِب إِحسانٍ تتابعها سُحبُ",218,"ب",1,0],["وَكَم نَراها تُثير سُخطا","وَكَم نَراها تُجدُّ حُبّا",219,"ب",2,0],["وكم نهدت فيها كتائب يعرب","وجال عليها كل ذي ميعة نهد",220,"د",1,0],["وكَمْ ناصِحٍ قامَ فينا يُثِيرُ","دَفِينَ الإِباءِ ويُذْكِي اللَّهَبْ",221,"ب",1,0],["وكم ندب عليه الندب فرض","قضينا ان تاركه أثيما",222,"م",2,0],["وكم نصحتُ لمن بغداد موطنهُ","والنصح من أجلب الأشياء للتهم",223,"م",1,0],["وكم نراود صبرا","وقد اضعنا السدادا",224,"د",2,0],["وكم نُشرت في الناس منه فواضلٌ","توالي الأرواح الأيادي بها نشر",225,"ر",1,0],["وكم نأت المنية بالأماني","وكم في قصده خاب الرجاء",226,"ا",2,0],["وكم نهشةٍ للنوى سمُّها","يدبُّ بجسمي وروحي دبيبا",227,"ب",2,0],["وكم نادى بها حكماء قومٍ","وكم أعلى لواها من خطيب",228,"ب",1,0],["وكم نزلت قدماً نوازل","فبددت منها آخراً إثر أول",229,"ل",1,0],["وكم نعقَ الغراب ببوقِ (موسَى)","وقد حلَّتْ بقافيةٍ لنا (برْ..)",230,"ر",1,0],["وكمن يناجي في التورّط قاربا","جدرانه الأوراق أنّى يُرجعُه",231,"ع",2,0],["وكم نخلة طاولت في السماء","وجف الغدير فأضحت جريدا",232,"د",2,0],["وكَمْ نَفَثَتْ عَلى أَرضٍ سَعِيراً","إذا شاءَتْ لَنا أنْ تَسْتَبيحَا",233,"ح",2,0],["وكم نسجتُ من الآمالِ أشرعَتي","وَرحتُ أمخرُ موجَ الحُلْمِ أقصاهُ",234,"ا",2,0],["وكم نملة راشت فطارت يسوقها","إلى متعةِ التحليق جوعُ مزاجِ",235,"ج",1,0],["وَكَمْ نَحْنُ أَلْفَيناكَ في مَعْبَدِ الْتُقى","عَلامَ الْمَها تُسْقيكَ مِنْ حانَةِ الصَّبِّ",236,"ب",1,0],["وكم نطقت عن دير ياسين صيحةٌ","تضعضع منها مفحماً كل ناطق",237,"ق",1,0],["وكم ناقل عن احمد وصف كامل","وكان عياني منه أكثر من نقلي",238,"ي",1,1],["وكَمْ نَصَبوا بِها مُستوطناتٍ","وكَمْ مَنَعوا الدَّواءَ عَنِ السَّقيمِ",239,"م",1,0],["وكَمْ نَسَجْنا رؤاها وهْيَ حالمةٌ","ترْنُوْ بعينٍ إليْنَا كلّها عَتَبُ",240,"ب",1,0],["وكم نشرتُ بوجه الريح أشرعةً","مخيّمُ الموتِ فيها كيف يحييني",241,"ن",2,0],["وكمنْ طغتْ فيها تباريحُ الصِبا","رقصتْ على ضحكاتِها الأشواقُ",242,"ق",1,0],["وكمنْ يُساقُ إلى المنونِ قلوبهمْ","فالموتُ سهمٌ والوباءُ مُصيبُ",243,"ب",1,0],["وكم ناشدته في كل ركن","نأى عني أبادله العويلا",244,"ل",2,0],["وكم نرفو أمانينا عذاباً","فتخضرّ السنابلُ والهباتُ",245,"ت",1,0],["وكم نرجو بأنْ تعفو وترضى","فنرفل بالهنا بعد الشدّاد",246,"د",1,0],["وكمنجةٌ تغفو على كتفٍ نوى","يهبُ الكمنجةَ مُنيةَ العشاقِ",247,"ق",1,0],["وكمْ نادمَ الخلَّانُ فيها أحبةً","وثمَّ انتدوا قبراً عتيقاً مترَّبا",248,"ب",2,0],["وكمْ نَبيٍّ أقامَ الدّينَ مرْحَمَةً","للنّاسِ أفْسَدَهُ منْ سَنَّ أعْرافا",249,"ف",2,0],["وكم ناح في رحبتيك الحمام","هديلاً كآهاتنا محزنا",250,"ن",2,0],["وكم نشجتُ بكاءً من عذابِكُمُ","وكم حملتُ بِهِ همًّا وأثقالا",251,"ل",2,0],["وكم نلقى أخًا يقسو","ويُشعلُ في أخٍ نارا",252,"ر",2,0],["وكم نذلٍ تكشَّفَ لي","وكانَ أسرَّ إسرارا",252,"ر",2,0],["وكم نيّةٍ لما هممتُ بفعلِها","صحا العقلُ منّي فانثنيتُ عن الفعلِ",253,"ل",1,1],["وكمْ نجمةٍ لمعتْ للسُّراةِ","فجُنَّ المحبُّ ولم يسألِ",254,"ل",1,0],["وَ كَمْ نَزَفْنَا بِعِشْقٍ مِنْ تُوَاصُلِنَا","وَ كَمْ مَهَرْنَا اللِّقَا تَفْدِيهِ أَرْوَاحُ",255,"ح",1,0],["وكم ناداه سراً طيف ليلى","بهمسٍ ليس يُسمع كالنداءِ",256,"ا",2,1],["2–وكَمْ ناداهُ للدُّنيا مُنادٍ","فلَمْ يَلْقَ استِماعًا واستجابَةْ",257,"ب",2,0],["وكم نصبوا لنا عسسا فخابت","أمانيهم وفد عزّ المرام",258,"م",1,0],["وكم نصبت ذبالة في ذابل","تهدي المواكب والكواكب أفل",259,"ل",1,0],["وكم نُغالي بصمتٍ حينَ نُنْشِدُهُ","وماؤهُ والغوادي رِمْشُ إبراقِ !؟",260,"ق",1,0],["وكم نشرتْ على قومٍ سواكم","فلم يعلقْ بها الرجلُ الطلوبُ",261,"ب",1,0],["وَ كَمْ نَادَى عَلَيْنَا وَالِدَانَا","أَبَى تَفْرِيقَنَا الْوَقْتُ الثَّمِينُ",262,"ن",1,0]]}