ww.aldiwan.net/poem54458.html","عموديه"],[391,"الحمد لله مسعف كل سائل بسول","https://www.aldiwan.net/poem54537.html","عموديه"],[391,"جزى الله المصائب كل خير","https://www.aldiwan.net/poem54603.html","عموديه"],[402,"زمان على الأحرار قد جار في الحكم","https://www.aldiwan.net/poem46420.html","الطويل"],[402,"نعم هذه حزوى وتلك زرود","https://www.aldiwan.net/poem46908.html","الطويل"],[409,"إليك فما تثني شؤونك شاني","https://www.aldiwan.net/poem32160.html","الطويل"],[416,"أدار الكأس صافية المدام","https://www.aldiwan.net/poem53947.html","الكامل"],[416,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[416,"سقاها الهوى من راحة الوجد صرخدا","https://www.aldiwan.net/poem54030.html","الطويل"],[416,"شجتني وقد تشجي الطلول الهوامد","https://www.aldiwan.net/poem54036.html","الطويل"],[416,"سقاك الحيا من أربع وطلول","https://www.aldiwan.net/poem54049.html","الطويل"],[416,"متى يشتفي هذا الفؤاد المتيم","https://www.aldiwan.net/poem54074.html","الطويل"],[416,"طهر فؤادك بالراحات تطهيرا","https://www.aldiwan.net/poem54094.html","البسيط"],[416,"أتى ببراهينٍ غدا كل جاحد","https://www.aldiwan.net/poem54154.html","الطويل"],[429,"وجارية لطهماز ربية","https://www.aldiwan.net/poem40857.html","الوافر"],[439,"أخو ظمأ يمص حشاه سبع","https://www.aldiwan.net/poem34835.html","الوافر"],[439,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[443,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[458,"أحقا يا أبا نصر فترجى","https://www.aldiwan.net/poem56074.html","الوافر"],[458,"ألا من مبلغ أسدا رسولا","https://www.aldiwan.net/poem56278.html","الوافر"],[458,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[464,"معاليك أعلى أن يحيط بها الوصف","https://www.aldiwan.net/poem3294.html","عموديه"],[479,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[482,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[482,"كم كنت في غمرات الحب أستبق","https://www.aldiwan.net/poem24456.html","عموديه"],[515,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[515,"سرى لك عرف في النسيم الذي سرى","https://www.aldiwan.net/poem12108.html","الطويل"],[515,"تناولت المكارم والمساعي","https://www.aldiwan.net/poem12173.html","الوافر"],[529,"نداء لكل الناس فالأمر أعظم","https://www.aldiwan.net/poem37210.html","الطويل"],[538,"ألا إنه يوم به الدهر يشهد","https://www.aldiwan.net/poem48238.html","عموديه"],[551,"وقالوا نراها خطة مدلهمة","https://www.aldiwan.net/poem47255.html","الطويل"],[551,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[551,"المرء يجمع والدنيا مفرقة","https://www.aldiwan.net/poem47755.html","البسيط"],[551,"على شجر الأراك بكيت لما","https://www.aldiwan.net/poem48079.html","الوافر"],[558,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[564,"أمن هجر من تهواه قلبك واجد","https://www.aldiwan.net/poem838.html",""],[580,"وكم نظرت وقد أكبرت من جبل","https://www.aldiwan.net/poem25196.html","عموديه"],[586,"خذ من حديثي ما يغنيك عن نظري","https://www.aldiwan.net/poem17531.html","البسيط"]],"verses":[["وَكَم نَظرَةٍ تَستَوهِبُ القَولَ مِن فَمي","تُكَلَّفُ نُطقي في جَوابِ المُكَلَّمِ",0,"م",1,0],["وَكَم نَدِيَت مِن نَداهُ المُنى","نَدى سُمرِهِ بِالنَجيعِ المُمارِ",1,"ر",1,0],["وَكَم نابِغٍ في أَرضِ مِصرَ حَمَيتَهُ","وَمِثلُكَ مَن يَحمي الكَريمَ وَيَمنَعُ",2,"ع",1,0],["وَكَم نِعمَةٍ أُلبِستُها سُندُسِيَّةٍ","أُسَربَلُها في كُلِّ حينٍ وَأُلحَفُ",3,"ف",1,0],["وَكَم نَفَّرَت مِن رامَحٍ مُتَوَضِّحٍ","هِجانِ القَرا ذي سُفعَةٍ وَخِدامِ",4,"م",1,0],["وَكَم نَفَّرتُ دونَكِ مِن صِوارٍ","وَمِن خَرجاءَ مُرئِلَةٍ وَخودِ",5,"د",1,0],["وكم نطقوا بألسنةٍ حدادٍ","يسيل لها من الأشداق حوب",6,"ب",1,0],["وكم نصحت فما أسمعت من أحد","حتى لقد جفّ لي ريق وكلّ فم",7,"م",1,0],["وكم نرى فعل فاعلات","من القوى وهي في الخفاء",8,"ا",2,0],["وكم نقدةٍ من تبره ولجينه","تخِذْتُ لديها كالنجم مرصدا",9,"د",2,0],["وكم ناصح كذّبت دعواه إذ غدت","عليَّ وآلت حلفةً لم تحلَّل",10,"ل",1,0],["وكم نشصتْ من نِعمةٍ فعطفْتها","على بَعلها حتى غدتْ غير ناشص",11,"ص",1,0],["وكم نِيلت بجودك من أحاظٍ","يبيتُ لرحل صاحبها أطيطُ",12,"ط",1,0],["وكم نزعت منا إليكم مطامع","فأضحت وعنكم لا إليكم نزوعها",13,"ع",3,0],["وكم نادمتُ راحَ الروحِ فاهُ","ولكن خانني ذاك الندامُ",14,"م",1,0],["وكم نِضْوٍ أناخ بها إليه","تضيَّفُها المجادب والسآمُ",14,"م",1,0],["وكم نَهش الحيّاتِ في هضباتِها","وكم فرس الأُسدَ الخوادِرَ في الأجمْ",15,"م",1,0],["وكم نعمةٍ أذوى وكم غبطةٍ طوى","وكم سند أهوى وكم عُرْوةٍ فصمْ",15,"م",1,0],["وَكَمْ نَسَجْتَ من الأَحلامِ أَرديةً","قَدْ مزَّقَتْها اللَّيالي وهي تَبْتَسِمُ",16,"م",1,0],["وكم نقلت جريحا","فمات بالاستشاره",17,"ر",2,0],["وَكَم نَظَرنا بِكُم نُعمى فَجَسَّمَها","لَنا السُرورُ فَكانَت عِندَنا نِعَما",18,"م",2,0],["وَكَم نَفَّسَت في حِمصَ عَن مُتَأَسِّفٍ","غَدا المَوتُ مِنهُ آخِذاً بِالمُخَنَّقِ",19,"ق",1,0],["وَكَم نَذَرَت مِن صَومِ شَهرٍ وَحِجَّةٍ","نِساءُ تَميمٍ إِن أَتاها يَزيدُها",20,"د",3,0],["وَكَم نَماكَ مِنَ الآباءِ مِن مَلِكٍ","بِهِ لِذُبيانَ كانَ الوِردُ وَالصَدَرُ",21,"ر",1,0],["وَكَم نامَ عَنّي بِالمَدينَةِ لَم يُبَل","إِلَيَّ اِطِّلاعَ النَفسِ دونَ الحَيازِمِ",22,"م",1,0],["وَكَم نَظرَةٍ قادَت إِلى القَلبِ حَسرَةً","يُقَطَّعُ أَنفاسَ الحَياةِ زَفيرُها",23,"ر",3,0],["وكم نسينَا وكم محَونَا","وكم غفرنَا لمن أساء",24,"ا",2,0],["وَكَم نَديمَينِ لَولا لذّةٌ لَهُما","في ذِكرِ سيرَتِهِ الحسناءِ لافتَرَقا",25,"ق",2,0],["وَكَم نَكبَةٍ ظَلماءَ تُحسَبُ لَيلَةً","تَجَلّى لَنا مِن راحَتَيكَ نَهارُها",26,"ر",3,0],["وَكَم ناكِثٍ لِلعَهدِ قَد نَكَثَت بِهِ","أَمانيهِ وَاِستَخذى لِحَقِّكَ باطِلُه",27,"ل",2,0],["وَكَم نِعمَةٍ لِلَّهِ في صَرفِ نِقمَةٍ","تُرَجّى وَمَكروهٍ حَلا بَعدَ إِمرارِ",28,"ر",1,0],["وَكَم نَومَةٍ لِيَ قَوّادَةٍ","أَتَت بِالحَبيبِ عَلى بُعدِهِ",29,"ه",1,0],["وَكَم نَزَلَ القَيلُ عَن مِنبَرٍ","فَعادَ إِلى عُنصُرٍ في الثَرى",30,"ر",2,0],["وَكَم نَهَضَ اِمرُؤٌ مِن بَينِ قَومٍ","وَفي هاديهِ مِن خِزيٍ عِلاطُ",31,"ط",1,0],["وَكَم نِسوَةٍ رَبَّينَ كَالنَخلِ فِتيَةً","فَحُزنَ بِما أَمكَنَّ مِن وَلَدٍ حُزنا",32,"ن",2,0],["وَكَم نَزَلا في مَهمَهٍ وَتَحَمَّلا","بِغَيرِ حَسيسٍ عَن جِبالٍ وَغيطانِ",33,"ن",1,0],["وكم نبغت فيها رجال أَفاضل","فَلَمّا دَهاها العسف عنها ترحلوا",34,"ل",3,0],["وكم نبأةٍ كالحديث الجديد","وما هو إلَّا القديم السماعْ",35,"ع",1,0],["وَكَمْ نَسفْتَ بِنَاءً","لِلظالِمِينَ فَخَرَّا",36,"ر",2,0],["وَكَم نَضَحتُ بِدَمعي","حرَّ الحَشا لَو برَدتُه",37,"ت",2,0],["وكم نقمةٍ أعقبَتْ نعمةً","وكم مِعْوَلٍ هادمٍ عَمَّرَا",38,"ر",2,0],["وَكم نفّستْ في حِمصَ من مُتَأسِّفٍ،","غَدا المَوْتُ مِنهُ آخِذاً بالمُخَنَّقِ",39,"ق",1,0],["وكَمْ نَازَعَ البَرْدُ الشَّدِيدُ بَقَاءَهَا","نَوائِبُ تَأْتِي كاللَّيَالِي وتَسْتَتْلِي",40,"ي",1,0],["وكم نطقوا بالسنة حداد","يسيل بها من الأشداق حُوب",41,"ب",1,0],["وكم ناقص يختال في طور كامل","وكم من حريص لابس ثوب زاهد",42,"د",1,0],["وكم نعمت بربات الجمالِ وأر","بابِ الدلالِ وما إذ ذاك إدلالُ",43,"ل",1,0],["وكم ناحلٍ بين تلك الخيا","م تحسَبه بعضَ أطنابها",44,"ب",3,0],["وَكَم نَطَقتَ بِفَصلِ القَولِ مُرتَجِلاً","وَالبيضُ في قِمَمِ الأَبطالِ تَصطَحِبُ",45,"ب",1,0],["وَكَم نَكبَةٍ زاحَمتُ بِالصَبرِ رُكنَها","فَلَم يلفَ صَبري واهِياً حينَ يَزحَمُ",46,"م",1,0],["وَكَم نَدِيِّ ضَلالٍ كانَ ذا لجَبٍ","سَطا فَأَخرَسَهُ عَن قَولِ لا وَهَلِ",47,"ل",1,0],["وكَمْ نادَيْتَ ما أسْمَعْتَ حَيًّا","فَكَيْفَ سَيَسْمَعُ الأحْياءُ مَيْتًا؟",48,"ت",2,0],["وَكَم نِعَمٍ أسدى لهم غيرَ أَنّهم","لِخِذلانهم قَد أَبدلوا شُكرها كفرا",49,"ر",2,0],["وَكَم نَبحوهُ وَهو في الأفق طالعٌ","وَلكنَّ نبحَ الكلبِ لا يصل البدرا",49,"ر",2,0],["وَكَم نادمٍ من وضعِ أولاده بها","وَقَد سَبَقت أسيافُها العذلَ والعذرا",49,"ر",2,0],["وكم نبّهت شكواك في الدوح بلبلا","فشاطرك الشكوى ونارك تكويه",50,"ي",2,0],["وكم نفَسٍ في الهوا","بنفسِ الفتى يخرجُ",51,"ج",1,0],["وكم نفرٍ تغرهمُ الليالي","وما خُلقوا ولا هيَ للدَوامِ",52,"م",1,0],["وَكَم نَكرَ الزَمانُ عَلَيَّ حَقّاً","وَكَم فنيَ الزَمانُ وَما فَنيتُ",53,"ت",1,0],["وكم نهضتَ إلى العَلْياءِ إذ عَجَزُوا","وكم أَفضْتَ بِحارَ الجُودِ إذْ بَخلوا",54,"ل",3,0],["وكم نِعم ناعماتِ الغصون","لبِسنا بظِلّك اَظلالها",55,"ل",3,0],["وكم ناب عن نُوْر الضحى فيك مَبْسِم","ونابت عن الوَرْد الجنِيّ خدود",56,"د",1,0],["وكَمْ نادَيْتُ يا هذِي ارْحَمِينَا","فلسْنا بالحَدِيدِ ولا الحِجَارَهْ",57,"ر",2,0],["وَكَم نَتَجَت حُروبٌ أَلقحَتها","سيوفُكَ وَالنتاجُ عِن اللِقاحِ",58,"ح",1,0],["وَكَم نَقَضت مِن مُوثَقٍ جَعلت بِهِ","شَهيداً عَلَيها عالِم السِرِّ وَالنَجوى",59,"و",2,0],["وكم نازلات ضاق ذرعاً بها الفتى","ولا يرتجي إلا من اللَه رفعها",60,"ع",3,0],["وكم ناطح صماء من غير حاجة","يزعزع روقيه ويعييه قلعها",60,"ع",3,0],["وكم نبح الكلب السماء وبدرها","اضر وضيع في العلاء رفيعا",61,"ع",2,0],["وَكَم نَصَبوا العداوَةَ لي بكيد","فكادوا يهدمون به جدار",62,"ر",1,0],["وكم نادت فأسمعت الليالي","ولكن لا مصيخ إلا مناد",63,"د",1,0],["وَكَم نَجا حاملوهُ الحافظونَ له","من سوءِ خَطب ملمٍّ فادحٍ عَممِ",64,"م",1,0],["وكم نعمة أسبغت من سر حكمة","أنرت بها من ناطق كل ظلمتي",65,"ي",1,0],["وكم نقَص البَدرُ من مَرّةٍ","فقابَلَه الشَّمْسُ حتّى كَمَل",66,"ل",1,0],["وكم نعمةٍ أعطَيْتَها وهْي جَزْلَةٌ","ولكنّني نَشّرتُها لم أغَطَها",67,"ط",3,0],["وَكَم نُشِرَت مِنهُ مَناشيرُ حِكمَةٍ","طَوى كاشِحٌ عَن أَن يُساجِلَها الكَشحا",68,"ح",2,0],["وكَم ناظرٍ أجفانُه جنس صارمٍ","غَنيٍّ على طولِ الضِّرابِ عن الصَّقلِ",69,"ل",1,0],["وكم نعم ليس تحصى باللسان","ولا تعد بعد العادين",70,"ن",1,0],["وكم نعم والعبيد الخام عنها غفول","ما يعرف إلا أنه يأكل وأنه يبول",71,"ل",1,0],["وكم نيطت سعادات بفقر","وكم جلب الغنى من مهلكات",72,"ت",1,0],["وكم نُوبٍ جلّيتُ بالصَّبر دُهْمَهَا","ومَا المجدُ إلا الصَّبر للنّوب الدَّهْم",73,"م",1,0],["وكم نقصتْ لِلنّيل يوماً أصابعٌ","وبحرّك ما ازدادَ النوال يزيدُ",74,"د",1,0],["وكم نكبةٍ ظَنَّ العِدا أنَّها الرَّدى","سَمتْ بي وأعلَت في البَرِيَّة شاني",75,"ي",1,0],["وكم نِعَمٍ له عندي وأيدٍ","رغمتُ بهنَّ آنافَ اللئام",76,"م",1,0],["وكم نعمةٍ أوْلَيْتَنيها وحَسرةً","غَدَوْتُ بها من لوعة البين شاكيا",77,"ي",2,0],["وكم نعمةٍ أسدَيْتَها فبَذَلْتها","وصيَّرْتَ أحرار البريَّة أعبدا",78,"د",2,0],["وكم نظمت في عقود مدائح","مزاياه في تلك العقود فرائد",79,"د",1,0],["وكمْ نازل مثلي بساحة حيِّهم","أَقامَ ولم يُؤْذنْ له برحيل",80,"ل",1,0],["وكم نعمةٍ أوْلَيْتَني فشكرتُها","ولو لم يَفُه منِّي لسان ولا فم",81,"م",1,0],["وكم نَثَرت على الأَسماع درّ فمٍ","فكان ذيالك المنثور منثورا",82,"ر",2,0],["وكم نثرت نثراً بلاغتك الَّتي","أردت بها دُرَّ المعالي منظما",83,"م",2,0],["وكم ناشدتك الشعر المقفى","حديثاً في اللويلات الدجيّه",84,"ي",2,0],["وكم نادى لطهماز بشتم","ولعن حيث أبدع ذي البليّه",84,"ي",2,0],["وكم ناجَتْ نفوسَهُمُ المنايا","فَلأْياً مَا نجا بِهِم النَّجاءُ",85,"ا",2,0],["وكم نَفَّستَ كُرْبَةَ مستكينٍ","تَأَخَّرَ عنهُ نَصْرُ الأَولِياءِ",86,"ا",2,0],["وكم نوح على صخر","وكم في الحي من خنسا",87,"ا",1,0],["وكم نفَرتْ لتنشُزَ عنك حتّى","نشَطتُ من الوفاء لها عِقالا",88,"ل",2,0],["وكم نَشَزتْ على قومٍ سواكم","فلم يعلَقْ بها الرجلُ الطَّلوبُ",89,"ب",1,0],["وكم نوديتَ يا بحرَ العطايا","فجاء البحرُ بالعجبِ العُجابِ",90,"ب",1,0],["وكم نوع إحسانٍ وصنف يفيدهُ","إذا ما انقضى نوعٌ من القول أو صنف",91,"ف",1,0],["وكم نفثت به الألباب سحرا","وكم أجرى ببحره من جوار",92,"ر",1,0],["وكم نهضت به همم وهبت","على الضعفاء أرواح انتصار",92,"ر",1,0],["وكم نحت لما أن تناء خيالها","كأني أنا موسى بميقات صعقتي",93,"ت",2,0],["وكم نصبت لها فخ الجفون على","مهواة وكر لعل الطيف ينسرق",94,"ق",1,0],["وكم نبت الأوطان يوماً بأهلها","فأورثها عز الحياة التغرب",95,"ب",1,0],["وكم نشأت من لج بحر غمامة","سرى وبلها في لجة البحر ممطرا",96,"ر",2,0],["وكم نادت ظباه إلى قلوب","وقد خفقت رويدك لن تراعي",97,"ع",2,0],["وكَمْ ناصِحٍ لمْ تَقْبَلُوا مِنْهُ نُصْحَهُ","وإنْ جاءَ بالحَقِّ الذي هُوَ أَبْرَمُ",98,"م",1,0],["وكم نغَم يُشجي كصَوت بَلابلٍ","وأصواتُ لآلاتِ الغِنا تَتردَّد",99,"د",1,0],["وكم نكبةٍ طالتْ يداً لتنالني","فباعد ما بيني وبين مَنالها",100,"ل",3,0],["وكم نِعَمٍ لجدِّهِمُ عليكمْ","لقين بكمْ جُحوداً أو غِماطا",101,"ط",2,0],["وَكَم نَذِلُّ وَفينا كلُّ ذي أَنَفٍ","ونستكينُ وفينا العِزُّ والشَّوَسُ",102,"س",1,0],["وَكَم نادَيتُ فيهِ مِن حَبيبٍ","عَهِدتُ بِهِ فَلَم أَسمَع جَوابا",103,"ب",2,0],["وكم نعمة قد حبانا بها","وأعظمها خلقُنا من عدم",104,"م",1,0],["وكم نظرة أوحت إلى القلب حسرة","تبيد قوى الإنسان والحال شاهد",105,"د",1,0],["وكم نظرت وقد أكبرت من جبل","أشم يزلق عن أطرافه البصر",106,"ر",1,1],["وَكَمْ نَظرْتُ لِوَجْهٍ لَيْسَ في بَدنٍ","وَكَمْ سَمِعْتُ بِصَخْرٍ لَيْسَ مِنْ حَجَرِ",107,"ر",1,0]]}