budhabi.ae/diwan/poem/54969","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55142","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55054","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54866","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54574","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67331","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54318","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[106,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[106,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[50,"يا صاح قمْ فاسقني بالكأس إعرابا","https://www.poetsgate.com/ViewPoem.aspx?id=17117",""],[96,"البحر والقمر","https://www.poetsgate.com/ViewPoem.aspx?id=17485",""],[96,"الملاح التائه","https://www.poetsgate.com/ViewPoem.aspx?id=13142",""],[23,"قالت له يوما تخاطبه","https://www.poetsgate.com/ViewPoem.aspx?id=11528",""],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[90,"يراع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=179189",""],[45,"أقصرا قد أطلتما تفنيدي،","https://www.poetsgate.com/ViewPoem.aspx?id=31347",""],[45,"ألَمْ تَرَ تَغْلِيسَ الرّبيعِ المُبَكِّرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31340",""],[35,"ألا أنْ نَأتْ سَلْمَى فأنْتَ عَمِيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=22002",""],[28,"بنيت بناء يجرض الغيظ دونه","https://www.poetsgate.com/ViewPoem.aspx?id=16953",""],[51,"غابن الحمد حقَّهُ مغبُونهْ","https://www.poetsgate.com/ViewPoem.aspx?id=30800",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[101,"اكْشفوا التُرْبَ عن الكَنْز الدفينْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62427&r=&rc=19",""],[88,"اذا شئت ان تسرى بكافرة الصوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19534&r=&rc=37",""],[85,"خَطَّتْ يداكَ الرَّوْضَة َ الغَنَّاءَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9650&r=&rc=140",""]],"verses":[["جَدّي النَبيُّ وَأُمّي بِنتُهُ وَأَبي","وَصِيُّهُ وَجُدودي خيرَةُ الأُمَمِ",0,"م",1,0],["جَدَثٌ بِبابِلَ أُشرِجَت رُجُماتُهُ","طَبَقاً عَلى مَطَرِ النَدى المُتَهَزِّمِ",1,"م",1,0],["جَدّي نَبِيٌّ وَإِمامي أَبي","وَرايَتي التَوحيدُ وَالعَدلُ",2,"ل",1,0],["جَدَّ الرَدى وَالناسُ في حِياصِ","حيدَ الأَقاطيعُ عَنِ القَنّاصِ",3,"ص",1,0],["جَدَّدَت نَظرَةُ المَها","ةِ مِنَ الوَجدِ ما دَرَسَ",4,"س",1,0],["جَدَثٌ عَلى أَن لا نَباتَ بِأَرضِهِ","وَقَفَت عَليهِ مَطالِبُ الرُوّادِ",5,"د",1,0],["جَديرٌ أَن تُصافِحَهُ الفَيافي","وَيَسحَبُ فَوقَها عَذَبَ الرَبابِ",6,"ب",1,0],["جَدِّي مُعاويَةُ الأَغَرُّ سَمَتْ بِهِ","جُرثومَةٌ مِن طينِها خُلِقَ النَّبِي",7,"ب",2,0],["جَدَّلَ الْبَاطِلَ لِلْحَقِّ","بِأَسْيَافٍ مَوَاضِي",8,"ي",1,0],["جَدّدْتَ عهْدَ أبيكَ في إمْدادِها","لمّا قَبَسْتَ النّورَ منْ مِصْباحِهِ",9,"ح",2,0],["جَديرٌ بِطَعنَةِ يَومِ اللِقا","ءِ تَضرِبُ مِنها النِساءُ النُحورا",10,"ر",2,0],["جَدَّدتَ عَهدَ الراشِدي","نَ تُقىً وَإِحساناً وَزُهدا",11,"د",2,0],["جُدتُم لَها بِالنَفسِ في وَردِ الصِبا","وَالوَردُ لَم يُنظَر إِلَيهِ ذُبولُ",12,"ل",1,0],["جُدُودٌ مِن الكَعبينِ بيضٌ وُجوهُها","لَهُم مَأَثوراتٌ مَجدُهنَّ تَليدُ",13,"د",1,0],["جَدُّكَ بِالرَّأْيِ غَزَا أَمَّةً","قَدْ عَجَزَتْ عَنْهَا سُيوفُ الْحُرُوبْ",14,"ب",1,0],["جددت عهد سنائه بعزيمةٍ","لو لم تعده لم يعد وابيك",15,"ك",1,0],["جَدِّي العَاثِرُ ابْتَلا","نِي مِنْهُ بِسُوءِ ظَنّْ",16,"ن",1,0],["جُدْتَ فِي حُبِّكَ البِلادَ بِأَغْلى","مَا بِهِ جَاءهَا شَهِيدُ غَرَامِ",17,"م",1,0],["جَدَّدْتَهَا وَالخَيْرُ أَجمَعُ فِي","تَجْدِيدِ مَا أَعْيَا مِنَ القِدَمِ",18,"م",1,0],["جِدَّ غِرٍّ فِي كِفَاحِ الدَّهْرِ لا","نَاهِباً رِوْقاً وَلا مُقْتَسِمَا",19,"م",2,0],["جُدْتَ بِالمُعْجِزِ البَلِيغِ وَعَجْزِي","دُونَهُ ظَاهِرٌ فَرِفْقاً بِحَالِي",20,"ي",1,0],["جَدّي النَبِيِّ وَأَبي عَلِيٌّ فَاِعلَموا","وَالفَخرُ فاطِمَةُ الزَكِيَّةُ مَحتِدي",21,"د",2,0],["جَدَعتُ بِأَنقاضٍ حَراجيجَ أَنفَهُ","إِذا الرِئمُ أَضحى وَهُوَ عِرقاً مُضاجِعُ",22,"ع",1,0],["جَداً قَضَّةَ الآسادِ وَاِرتَجَزَت لَهُ","بِنَوءِ السِماكينِ الغُيوثُ الرَوائِحُ",23,"ح",1,0],["جدّدت دون الدين عزمة أروعٍ","جدّدت منها سُنَّة الأنصارِ",24,"ر",1,0],["جدّدْ بها عرس الصبوح فإنها","بكر تحييها الكرام مع البُكرُ",25,"ر",1,0],["جددت للأنصار حَلْيّ جهادها","فالدين والدنيا به تتجمّلُ",26,"ل",1,0],["جدال على مرّ الجديدين دائم","بتفنيد رأيٍ أة بتزيف ناقد",27,"د",1,0],["جَديلَةُ وَالغَوثُ الَّذينَ تَعيبُهُم","كِرامٌ وَما مَن عابَهُم بِكَريمِ",28,"م",1,1],["جدي لكل عامل ثواب","الرأس والأكرُع والاهاب",29,"ب",1,0],["جَدّي أَبو لَيلى وَوالِدُهُ","عَمرٌ وَأَخوالي بَنو كَعبِ",30,"ب",1,0],["جدت وأفحمتني بما قد","سمعت من لفظك الموَاتي",31,"ي",1,1],["جدوى على إثر جدوى غير قاصرةٍ","كالسيل محتفزٍ في أثر محتفز",32,"ز",1,0],["جدتم بما قلَّ عن ظنوني","فزاد في لوعتي وهُلكي",33,"ي",1,1],["جد لي بشيءٍ يحاكيني فإنيَ قد","أصبحت لولاكمُ لحماً على وضم",34,"م",1,0],["جدّدا لي عيشاً على السفحِ قدماً","أيّ عيشٍ مضى وأيّ مكان",35,"ن",1,0],["جدَّدَ عهدَ النبيِّ بِرٌّ","من ابنِ يحيى وفَضْلُ تقوى",36,"ا",1,0],["جُدُّوا فقد جَدَّ بكم لاعباً","وقد يَجُدُّ الرجلُ اللاعبُ",37,"ب",1,0],["جِدّاً وحَدّاً إذا ما شئتَ هَزَّهُما","طباعُكَ الحُرُّ هزَّ العَضب ذي الشُّطَبِ",38,"ب",1,0],["جدودٌ تُنجِّيهِمْ من اللَّوم فوقها","جُدود تنجيهم من الهلكاتِ",39,"ت",1,0],["جَدْعاً لآنُفِ معشرٍ تُضحي لهم","رَيحانةً يا أيها الكُرّاثُ",40,"ث",1,0],["جَدَليٌّ إذا تُنُوزعَ شِعْرٌ","شاعِرٌ حضرةَ الجدال الألَدِّ",41,"د",1,0],["جدَّدْتَ مجداً لم يزل","يُبنَى على مجد يؤبَّدْ",42,"د",1,0],["جدوى فمٍ فيه لؤلؤ وجَنَى","نحلٍ بماء السحابِ في النُّقرِ",43,"ر",1,0],["جداً منك أو من ماجدٍ تستميحه","لراجيك رحب الباع ذي همةٍ بحر",44,"ر",1,0],["جدّك شيبانُ العظيمُ الفخرِ","حقّاً كما البلبلُ جَدّ الصقرِ",45,"ر",1,1],["جُدْ لي ببحرِ واحدٍ أغرقك في","بحرٍ أحيس به بسبعة أبحر",46,"ر",1,0],["جُدريٌّ ما شانها وهو شينٌ","كل أثرٍ في ذلك الوجه نقشُ",47,"ش",1,0],["جَدَّ سعياً فبلَّغَته مساعٍ","لم تَزَلْ قبل حمله في ارتكاض",48,"ض",1,0],["جُد بإدرارك ما أجريتَه","أو بإعتاقيَ من رقِّ الطمع",49,"ع",1,0],["جدواك أكرم من أن لا أصادفها","وقفاً ومدحي عليك الدهر موقوف",50,"ف",1,0],["جدتم جودة فأصبح رائي","ه بآثارها عليه مروقا",51,"ق",2,0],["جُدْ فقد تنفجرُ الصخ","رةُ بالماءِ الزُّلالِ",52,"ل",1,0],["جدعْنا أنوفَ الإفْكِ بالحقِ عنْوةً","فلم نَتَّرِكْ منهُنَّ غير شراذِمِ",53,"م",1,0],["جديراً أن يحوزَ الحمدَ عفواً","إذا ما عزَّ من حَمْدٍ مَرامُ",54,"م",1,0],["جُدْ بتسهيل حاجتي عند سهلٍ","للمعالي سهوله وحُزونه",55,"ن",2,0],["جَدّوا بنا كالمازحين عَداوةً","والجدُّ في بعض المِزاح مُبين",56,"ن",1,0],["جُدتم فلا جودَ إلا دون جودكمُ","ونلتُمُ من عظيم الجود ما شَطَنا",57,"ن",2,0],["جددت فما ارعاني القوم سمعهم","وليس وراء الجد الا التهكم",58,"م",1,0],["جدث فيه كل دهري ليل","ما لاضواء فجره من بجس",59,"س",1,0],["جددتِ صفو الملك بالنعم التي","صحبت ظهور الجود ميلاد الندى",60,"د",2,0],["جدة تجعل الحديد على الما","ل وتحمى الأبواب والأقفالا",61,"ا",1,0],["جد الطيب فكان غاية جده","تقليب كفيه إلى العواد",62,"د",1,0],["جدة يا صباح تقاسى الظما","وأنت ما بين المياه العذاب",63,"ب",1,0],["جدّهمو لا دِين دُون حُبِّهِ","وَأُمُّهُم بِالأُمَهاتِ تُفتَدى",64,"ا",1,0],["جَدَّدوا أُلفَةَ الهَوى","وَالإِخاءَ الَّذي شُطِر",65,"ر",1,0],["جَدَّ في عَمارَتِهِ","مُنصَفٌ وَمُضطَهَدُ",66,"د",1,0],["جَدَّدتَ أُسلوبَ الوَليدِ وَلَفظِهِ","وَأَتَيتَ لِلدُنيا بِسِحرِ الطاءِ",67,"ا",2,0],["جُدُدٌ كَأَوَّلِ عَهدِها وَحِيالَها","تَتَقادَمُ الأَرضُ الفَضاءُ وَتَعتُقُ",68,"ق",1,0],["جَدَّدتَ عَهدَ الراشِدينَ بِسيرَةٍ","نَسَجَ الرَشادُ لَها عَلى