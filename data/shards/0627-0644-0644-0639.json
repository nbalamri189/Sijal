{"poems":[[55,"ألا من يمطر السنة الجمادا","https://www.aldiwan.net/poem30602.html","الوافر"],[46,"أللعمر في الدنيا تجد وتعمر","https://www.aldiwan.net/poem29671.html","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126142","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79810","الطويل"],[402,"إربأ بنفسك أن تكون نجيبا","https://www.poetsgate.com/ViewPoem.aspx?id=35349",""],[231,"لماذا أحبك !؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79161&r=&rc=35",""]],"verses":[["أَلِلعَينَينِ قَد قَذَيا بُكاءً","أَمِ الجَنَبَينِ قَد قَلِقا وِسادا",0,"د",2,0],["أَلِلعُمرِ في الدُنيا تُجِدُّ وَتَعمُرُ","وَأَنتَ غَداً فيها تَموتُ وَتُقبَرُ",1,"ر",1,1],["اللعب بالمنقلة والضامة","وراءه الحسرة والندامة",2,"ه",1,0],["أللعيش تستبقي النفوس مُضامة","وما الموتُ إلاَّ أن تعيش فتقسرا",3,"ر",2,0],["اللعلوم نظنها نعما لنا","فنصيبها نقما لنا وخطوبا",4,"ب",2,0],["أللعطف ؟ إني القوي العطوف","فما أرتجي رحمة العاطفين",5,"ن",1,0]]}