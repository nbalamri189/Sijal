x?id=212779",""],[4935,"تدل بدلها تيها","https://www.poetsgate.com/ViewPoem.aspx?id=129500",""],[4954,"ألْمَحتُ بَدْرًا","https://www.poetsgate.com/ViewPoem.aspx?id=207791",""],[4978,"ماذا دهاك فلا تقوى على الكلم؟","https://www.poetsgate.com/ViewPoem.aspx?id=177181",""],[5009,"جيل الصحوة","https://www.poetsgate.com/ViewPoem.aspx?id=68820",""],[5058,"قلبي على الورقِ","https://www.poetsgate.com/ViewPoem.aspx?id=208826",""],[5081,"أَفِقْ قَلْبِي","https://www.poetsgate.com/ViewPoem.aspx?id=187884",""],[5102,"الله يمسّيك بالهجر ..","https://www.poetsgate.com/ViewPoem.aspx?id=13634",""],[5187,"وطن بلا ربيع","https://www.poetsgate.com/ViewPoem.aspx?id=29066",""],[5260,"أفق مَا معنى بِجمع الحطام","https://www.poetsgate.com/ViewPoem.aspx?id=190431",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5353,"عندما ماتَ الشّاعرُ بينَ يديه ِ","https://www.poetsgate.com/ViewPoem.aspx?id=212466",""],[5397,"أفق من رقدة الآمال جفن","https://www.poetsgate.com/ViewPoem.aspx?id=157927",""],[5431,"لن تُعدما","https://www.poetsgate.com/ViewPoem.aspx?id=191220",""],[5431,"ماعاد يملك غير القلب ملتحدا","https://www.poetsgate.com/ViewPoem.aspx?id=191980",""],[5431,"إقرأ ....","https://www.poetsgate.com/ViewPoem.aspx?id=206810",""],[5442,"عز قرب الدار إلا في الكرا","https://www.poetsgate.com/ViewPoem.aspx?id=114789",""],[5464,"يا جبل الوقار","https://www.poetsgate.com/ViewPoem.aspx?id=6672",""],[5464,"رويدك لا الملام ولا العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=703",""],[5497,"الموعظات الفواجع","https://www.poetsgate.com/ViewPoem.aspx?id=206397",""],[5582,"سُطُورُ هَوَىً ما فِي حَقِيقَتِها لَغْوُ","https://www.poetsgate.com/ViewPoem.aspx?id=187334",""],[5582,"خَلِّ الكَئِيبَ يُقاسِي ما يُقاسِيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63602",""],[5653,"فذر العقيق مجانبا لعقوقهِ","https://www.poetsgate.com/ViewPoem.aspx?id=26445",""],[5690,"قم ودع الغرب أن الشرق ناداكا","https://www.poetsgate.com/ViewPoem.aspx?id=172169",""],[5789,"مغازلة الجِراح","https://www.poetsgate.com/ViewPoem.aspx?id=201410",""],[5805,"متى تصحو بوجداني القصيدة ؟؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=24723",""],[5818,"أضحك من محبتها وأبكي","https://www.poetsgate.com/ViewPoem.aspx?id=193125",""],[5845,"أفقْ هديتَ منَ التبرجِ والكمدِ","https://www.poetsgate.com/ViewPoem.aspx?id=198482",""],[845,"إلى أبي تراب","https://www.poetsgate.com/ViewPoem.aspx?id=159622",""],[5881,"تلقاء مدين","https://www.poetsgate.com/ViewPoem.aspx?id=184317",""],[6017,"أفي كل عام غربة ونزوح","https://www.poetsgate.com/ViewPoem.aspx?id=129787",""],[6189,"فارس الضحى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83555&r=&rc=22",""],[399,"إلى عيني الحزينتين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68239&r=&rc=64",""],[6225,"تقويم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80905&r=&rc=174",""],[6237,"إفاقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77866&r=&rc=8",""],[6355,"الليل داج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66614&r=&rc=74",""]],"verses":[["أَفِق يا دَهرُ مَن أَمسَيتَ تَحدو","وَقَد مَنُعَ الخِزامَةُ وَالزِمامُ",0,"م",1,0],["أَفقَدنَ مِنكَ شُجاعَ كُلِّ بَلاغَةٍ","إِن قالَ جَلّى في المَقالِ وَجالا",1,"ل",2,0],["أَفقَدَ الأَصلَ بالِغاً مُنتَهى النَب","تِ المُرَجّى مَن أَفقَدَ الفَرعَ نَضرا",2,"ر",2,0],["أَفِقْ جَدَّ ثَدْيَيْ أُمِّكَ الثُّكْلُ وَانْثَنى","شَبا السَّيْفِ عَنْ فَوْدَيْكَ وَهو خَضِيبُ",3,"ب",1,0],["أفِقْ منْ جَوًى يا أيّها المُهْرُ إنني","وإياكَ في أهْلِ الغَضى غُرُبانِ",4,"ن",1,0],["أَفْقَدَ جَفْنِي لَذِيذَ الوَسَنْ","مَنْ لَمْ أَزَلْ فِيهِ خَلِيعَ الرَّسَنْ",5,"ن",1,1],["أفَقْراً وقد أوْرَدْتُ في موْرِدِ الغِنى","وخوْفاً وقد أصْبَحْتُ جارَ بَني نَصْرِ",6,"ر",1,0],["أَفِق عَنكَ لا يَذهَب بِكَ التّيهُ سالِماً","فَإِنَّكَ مَخلوقٌ وَلَستَ بِخالِقِ",7,"ق",1,0],["آفِقاً يُجبى إِلَيهِ خَرجُهُ","كُلَّ ما بَينَ عُمانٍ فَمَلَح",8,"ح",1,0],["أَفقَدَني المَوتُ بِهِ وافِياً","لا يَعرِفُ الخَتلَ وَلا يَغدِر",9,"ر",1,0],["أَفِق وَاِستَمِع مِنّي رِثاءً جَمَعتُهُ","تُشارِكُني فيهِ البَرِيَّةُ أَجمَعُ",10,"ع",1,0],["أَفَقنا بَعدَ نَومٍ فَوقَ نَومٍ","عَلى نَومٍ كَأَصحابِ الرَقيمِ",11,"م",1,0],["أَفِق ساعَةً وَاُنظُر إِلى الخَلقِ نَظرَةً","تَجِدهُم وَإِن راقَ الطِلاءُ هُمُ هُمُ",12,"م",1,0],["أَفِق قَد أَفاقَ العاشِقونَ وَفارَقوا ال","هَوى وَاِستَمَرَّت بِالرجالِ المَرائِرُ",13,"ر",1,0],["أفق العلم قد بد مكفهرّاً","عندما أطفا الردى نبراسه",14,"س",2,0],["أَفقَأُ عَينَ الشانِئِ البَغيضِ","فَقءَ الطَبيبِ قُرحَةَ المَريضِ",15,"ض",1,0],["أفقرت في الحسنِ الغواني مثلما","قالوا حذامي وقطامي في الدما",16,"م",2,0],["أفِقْ أيها النَّشْوانُ قبل ملامةٍ","تُعضُّك أطرافَ البنانِ وشيكا",17,"ك",2,0],["أَفِق صاغراً من نومةِ الجهلِ إنها","تعودُ على نُوّالها بوبالِ",18,"ل",1,0],["أَفَقيدَ أَرضِ النيلِ أُقسِمُ لَو دَرى","بِالخَطبِ أَوشَكَ مائُهُ يَتَعَسَرُ",19,"ر",1,0],["أَفِق أَيُّها القَلبُ اللَجوجُ عَنِ الجَهلِ","وَدَع عَنكَ جُملاً لا سَبيلَ إِلى جُملِ",20,"ل",1,0],["افقد الخافقين مخترعا كا","ن بامثاله النبوغ ضنينا",21,"ن",2,0],["أُفق البلاد وأنت بين ربوعها","بالنجم مزدان وبالمصباح",22,"ح",1,0],["أُفُقُ العُلا كُنتَ الشِها","بَ عَلَيهِ وَلا ذَنَبَ الشِهابِ",23,"ب",1,0],["أُفُقٌ مُشرِقٌ وَجَوٌّ أَضاءَت","في سَنا نورِهِ اللَيالي السودُ",24,"د",1,0],["أَفِق إِنَّ ظُلمَ الدَهرِ غَيرُ مُفيقِ","وَإِنَّ رَفيقَ البَثِّ شَرُّ رَفيقِ",25,"ق",1,1],["أَفِقْ من سَكرةِ الأمَلِ المُحالِ","ومِن ديباجةِ العَرَضِ المُزالِ",26,"ل",1,1],["أَفَقِهتَ عَن عِبَرِ الزَمانِ صِفاتِها","هَيهاتَ لَستُ أَراكَ عَنها تَفقَهُ",27,"ه",1,0],["أَفِقنَ فَإِنَّ الخُبزَ بِالأُدمِ يُشتَهى","وَلَيسَ يَسوغُ الخُبزُ بِالخُبزِ في الحَلقِ",28,"ق",1,0],["أفق لا يحد للعين قد ضا","ق فأمسى والسجن هذا الفضاء",29,"ا",2,0],["أَفِق إِنَّما تَبكي إِلى مُتَمَنِّعٍ","مِنَ البُخلِ مَألوسِ الخَليقَةِ حوَّلِ",30,"ل",1,0],["أَفِق قَد أَفاقَ العاشِقونَ وَقَد أَنى","لَكَ اليَومَ أَن تَلقى طَبيباً تُلائِمُه",31,"م",2,0],["أَفِق قَد أَفاقَ الوامِقونَ وَإِنَّما","تَماديكَ في لَيلى ضَلالٌ مُضَلِّلُ",32,"ل",1,0],["أُفْقٌ يمورُ الأفْقُ فيه عجاجةً","بحرٌ يموج البحرُ فيه سَبوحا",33,"ح",2,0],["أَفقُدُ النَومَ إِن ذُكِرتِ وَدَمعي","عِندَ ذِكراكِ لَيسَ بِالمَفقودِ",34,"د",1,0],["أفقر القوم بالعِراق وأغنى","وسَّعَ الطرقَ ضيَّقَ الأفكارا",35,"ر",2,0],["أَفقاعة أَنا ضمن بحر قد طمى","أَم أنني البحر الَّذي هُوَ طامي",36,"م",2,0],["أفَقدتَ رُشدك أم شعو","رَكَ بالحياةِ إذنْ جُنِنْتْ",37,"ت",1,0],["أفِق إنما البَدْرُ المُقَنَّعُ رأسُه","ضَلالٌ وغَيٌّ مثْلُ بَدْرِ المُقَنَّع",38,"ع",1,0],["أَفَقْراً فَتاةَ الرُّومِ وَالحُسْنُ مَغْنَمٌ","وَطُهْراً وَهَذَا العصْرُ عَصْرُ تَمَتُّعِ",39,"ع",1,0],["أَفق أَيُّها المَغرورُ إِنَّكَ مُنتَشٍ","كَأَنَّكَ مَصبوحٌ يعلُّ بِقَرقَفِ",40,"ف",1,0],["افقدتني شهب الفضائل كلهم","ويلاه من شهبي ومن أقماري",41,"ر",2,0],["أفقنا فشبت جراحاتنا","سعيرا على الذلّ لن يخمدا",42,"د",2,0],["أفقيد أرض النيل أقسم لو درى","بالخطب أوشك ماؤه يتهسّر",43,"ر",1,0],["أفق المنى أحنى وأرحب عالما","وأحنّ أفياء وأزين سولا",44,"ل",2,0],["َا فَقُلْنَا لَهُمْ إنْ تَمْنَعُونَا بِلاَدَكُمْ","نَجِدْ مَذْهَباً في سَائِرِ الأَرْضِ وَاسِعَا",45,"ع",2,0],["أفقٌ يمورُ فيه عجاجة ً","بحرٌ يموج البحرُ فيه سَبوحا",46,"ح",2,0],["أفقْ، قد أفاقَ العاشقونَ وفارقوا ال","هَوَى وَکسْتَمَرَّتْ بِالرِّجَالِ المَرَائِرُ",47,"ر",1,0],["أفقَعَ القَاعِ إِنَّا قَد ضَربنَا","عَلَيكُم في مَجَاثِمِكُم عِنَانَا",48,"ن",2,0],["أُفُقُ المُعالي مُشرِقٌ بِهِمُ فَلا","أَفَلَت أَهِلَّتُهُ وَلا أَقمارُهُ",49,"ر",2,0],["أفِق فالشيبُ قد ملأ النواصي","وليس ورائَهُ إلاَّ الحمام",50,"م",1,0],["أفق فاللَّيث مطّلع","عليك وأنت منتظر",51,"ر",1,0],["أِفق فاللَّيثُ مطَّلعٌ","عليك وأنتَ مقتربُ",52,"ب",1,0],["أفِق فطريقُ الحقِّ أبلجُ واضحٌ","إذا أشكلت يوماً جميعُ الطرائقِ",53,"ق",1,0],["أَفَقنا بِهِ مِن غَمرَةِ الغيِّ وَالهَوى","فَلا الطِبُّ مَعدومٌ وَلا النُجحُ مُرجأُ",54,"ج",2,0],["افقرتهم بتغاض منك أطمعهم","حتى لودوا مكان الأمن تخويفا",55,"ف",2,0],["أفق أيها القلبُ الولوعُ المكلفُ","أما في مشيب الرأس للغيّ مصرف",56,"ف",1,1],["أفق طالما أبضعت في اللهو والصبا","بضائعَ في أمثالها المال يتلف",56,"ف",1,0],["أفق يا قلب ما للناس عهد","وفائي صار ذنبا من ذنوبي",57,"ب",2,0],["أَفِق يا دَهرُ مِن إِدمانِ ظُلمي","وَإِعناتي فَقَد حَلِمَ الإِهابُ",58,"ب",1,0],["أفِ