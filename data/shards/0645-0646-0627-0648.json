{"poems":[[72,"يا حبذا يومي بوادي جلق","https://www.aldiwan.net/poem19580.html","الرجز"],[80,"ما للوشاة عليها أذكت الحدقا","https://www.aldiwan.net/poem31358.html","البسيط"],[105,"نبني وتهدم أيدي الجهل دائبة","https://www.aldiwan.net/poem43368.html","البسيط"],[75,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[109,"بسألك","https://www.poetsgate.com/ViewPoem.aspx?id=8395",""],[143,"ليت الهوى يصرفه الراقى","https://www.aldiwan.net/poem58422.html","السريع"],[165,"مناويك في بذل النوال وإنه","https://www.aldiwan.net/poem67826.html","الطويل"],[262,"عللوا قلبي بتذكار اللقاء","https://www.aldiwan.net/poem38376.html","الرمل"],[276,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[298,"من أودع الراح والأقاح فمك","https://www.aldiwan.net/poem33200.html","المنسرح"],[367,"اقرا الدموع فإنها عنواني","https://www.aldiwan.net/poem17127.html","الكامل"],[422,"أهل المحبة بالمحبوب قد شغلوا","https://www.aldiwan.net/poem46387.html","البسيط"],[442,"لا يدرك المجد من لم يجعل السببا","https://www.aldiwan.net/poem14345.html","البسيط"],[459,"ظل المنى واسع والشمل ملتئم","https://www.aldiwan.net/poem55869.html","البسيط"],[530,"يا جاهلا في نصر سنة أحمد","https://www.aldiwan.net/poem37462.html","الكامل"],[545,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"]],"verses":[["من أول الجبهة قد قبَّلته","مرتشفاً لآخر الخلخال",0,"ل",1,0],["مَن أوْهَنَ اللَّه كيدَ الناكِثينَ بِه","إِذا قَذَفتَ بِحَقٍّ باطِلاً زَهقا",1,"ق",2,0],["مِنّا وَمِنكُم رِجالٌ لا حُلومَ لَهُم","وَلا يَفيئونَ لِلأَديانِ وَالحُرَمِ",2,"م",1,0],["من أوّل الدهر موصولا بآخره","وإن تَسَل عن علاهم فهي لم تزل",3,"ل",1,0],["مَن أؤاخي، لو ذبت لطفاً لقالوا","إن سُمّي مُخَبَّأٌ في رحيقي",4,"ق",2,0],["من أوّلا اشوفك ولع واادللك","وأأأأحب خيط العذر لامن ... قادني",5,"ن",2,0],["من أوجب التوبةَ من خمرةٍ","يعصِرها من لحظِه الساقى",6,"ق",2,0],["مُناويكَ في بَذلِ النَوالِ وَإِنَّهُ","لَيَعجزُ عَن أَدنى مَداكَ وَيَحسُرُ",7,"ر",1,1],["من أولى مجد وجد قد سموا","بمعاليهم على أهل السماء",8,"ا",2,0],["مَنْ أوْسَعَ سُدّتَه خَدَماً","حَكَمتْ أنْ يُخدم سُؤْدَدُهُ",9,"د",2,0],["من أَودَع الراحَ والأَقاحَ فمَك","ومن أَعار الصَباح مُبتَسمَك",10,"ك",1,1],["مَن أَودَعَ الأَسرارَ عِندَ جَنانِهِ","فَأَنا الَّذي كاتَمتُها لِجَناني",11,"ن",2,0],["من أوَّل الليل قد سارَت عزائمهُم","وفي خيام حمى المحبوب قد نزلوا",12,"ل",3,0],["من أوزم النفس إكراهاً على خطرٍ","وحكم اللَه فيما يقتضي غلبا",13,"ب",2,0],["من أوقد النارَ مطروقا ومن رفعَ ال","حجابَ عن طالبي معروفه ازدحموا",14,"م",3,0],["مَنْ أَوْجَبَ التَّقْلِيدَ بَعْدَ تَأَهُّلٍ","للاِجْتِهادِ وقَالَ حَتْماً قَلِّدِ",15,"د",1,0],["من أوَّل الحرفِ لم تنعسْ أصابعُنا","على يَدَيْهِ، ولم تستطعمِ الوَسَنَا",16,"ن",2,0]]}