www.poetsgate.com/ViewPoem.aspx?id=24708",""],[5732,"حي جرح قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177917",""],[5737,"في فضيلة ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=177809",""],[5756,"خطاك السو","https://www.poetsgate.com/ViewPoem.aspx?id=5364",""],[5756,"الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=5179",""],[5764,"الواقع المر","https://www.poetsgate.com/ViewPoem.aspx?id=137045",""],[5776,"فهارس الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199335",""],[5794,"سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=80281",""],[5794,"قضايانا","https://www.poetsgate.com/ViewPoem.aspx?id=100754",""],[5843,"أمل عمري","https://www.poetsgate.com/ViewPoem.aspx?id=51304",""],[5848,"اهوا دا اللي مش معقول","https://www.poetsgate.com/ViewPoem.aspx?id=53357",""],[5853,"((العيد))","https://www.poetsgate.com/ViewPoem.aspx?id=175643",""],[5956,"أنا نار","https://www.poetsgate.com/ViewPoem.aspx?id=182598",""],[5969,"طبنا بها كي نسترد هوانا","https://www.poetsgate.com/ViewPoem.aspx?id=198910",""],[6189,"من مذكرة قبيلة باهلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83559&r=&rc=26",""],[5355,"من أول الهجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86685&r=&rc=8",""],[6257,"المجازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87187&r=&rc=12",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""],[6366,"لهواك أسرارٌ وصمتك ساحرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86673&r=&rc=0",""]],"verses":[["من أول الجبهة قد قبَّلته","مرتشفاً لآخر الخلخال",0,"ل",1,0],["مَن أوْهَنَ اللَّه كيدَ الناكِثينَ بِه","إِذا قَذَفتَ بِحَقٍّ باطِلاً زَهقا",1,"ق",2,0],["مِنّا وَمِنكُم رِجالٌ لا حُلومَ لَهُم","وَلا يَفيئونَ لِلأَديانِ وَالحُرَمِ",2,"م",1,0],["من أوّل الدهر موصولا بآخره","وإن تَسَل عن علاهم فهي لم تزل",3,"ل",1,0],["من اوزع الفكر في شيء يقدره","إلا اعتبارا صمى ايزاعن الخبل",4,"ل",1,0],["مَن أؤاخي، لو ذبت لطفاً لقالوا","إن سُمّي مُخَبَّأٌ في رحيقي",5,"ق",2,0],["من أوّلا اشوفك ولع واادللك","وأأأأحب خيط العذر لامن ... قادني",6,"ن",2,0],["من أوجب التوبةَ من خمرةٍ","يعصِرها من لحظِه الساقى",7,"ق",2,0],["مُناويكَ في بَذلِ النَوالِ وَإِنَّهُ","لَيَعجزُ عَن أَدنى مَداكَ وَيَحسُرُ",8,"ر",1,1],["من أولى مجد وجد قد سموا","بمعاليهم على أهل السماء",9,"ا",2,0],["مَنْ أوْسَعَ سُدّتَه خَدَماً","حَكَمتْ أنْ يُخدم سُؤْدَدُهُ",10,"د",2,0],["من أَودَع الراحَ والأَقاحَ فمَك","ومن أَعار الصَباح مُبتَسمَك",11,"ك",1,1],["مَن أَودَعَ الأَسرارَ عِندَ جَنانِهِ","فَأَنا الَّذي كاتَمتُها لِجَناني",12,"ن",2,0],["من أوَّل الليل قد سارَت عزائمهُم","وفي خيام حمى المحبوب قد نزلوا",13,"ل",3,0],["من أوزم النفس إكراهاً على خطرٍ","وحكم اللَه فيما يقتضي غلبا",14,"ب",2,0],["من أوقد النارَ مطروقا ومن رفعَ ال","حجابَ عن طالبي معروفه ازدحموا",15,"م",3,0],["مَنْ أَوْجَبَ التَّقْلِيدَ بَعْدَ تَأَهُّلٍ","للاِجْتِهادِ وقَالَ حَتْماً قَلِّدِ",16,"د",1,0],["من أوَّل الحرفِ لم تنعسْ أصابعُنا","على يَدَيْهِ، ولم تستطعمِ الوَسَنَا",17,"ن",2,0],["منا وايم الحق خير تحية","للقوم مقرونا بها الاعظام",18,"م",1,0],["مَن أوسُ قَيسُ وَمَن قُسٌ","وَمَن هَرَمُ الجَوادُ وعَنتَرٌ والأحنف",19,"ف",1,0],["مِن أَوروبا بَدا رَفيع المَنار","بِمحيا يَزرى بِشَمس النَهار",20,"ر",1,1],["من أورد الآمال حوض نوالكم","فلها الأمان من أن تذاد وتصرفا",21,"ف",2,0],["من أَوضح التّدقيق مِنهُ مُشكلاً","وَبانَ مِن تَدقيقهِ الدّقائقُ",22,"ق",1,0],["من أَولياءِ إلهِنا العلما","عُلماءُ من فازوا بقربِهْ",23,"ه",1,1],["مَنْ أودَعَ السرَّ أصحابَ النميم غدا","أضحوكةً بين عُضْروطٍ وصُعْفُوقِ",24,"ق",1,0],["من أوسعَ الأرضَ عرفا وقت نائله","وألبسَ الأسد خوفاً وقت سطوته",25,"ت",2,0],["من أوقف داود في السماء طيورا","إذ سخر جنا له وأوب أجبال",26,"ل",1,0],["من أوقف الشمس لغير قريش","في وقت غروب وردّها لعلي العال",26,"ل",1,0],["من أول الدنيا لغاية أمرها","في وصف أحمد ذي الأيادي الهمل",27,"ل",1,0],["منّا ومنهم غداةَ البينِ إذ بكرت","كَم عذّب البينُ أَرواحاً وأرواحا",28,"ح",2,0],["من أوجد الشيء من لا شيء يجهله","كيف استقام له الايجاد والأثر",29,"ر",1,0],["مِن أَورد الأَعداءَ مِن كَفِهِ","مَورد حَتف ما لَهُ مَصدَر"