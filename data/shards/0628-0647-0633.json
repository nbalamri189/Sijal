{"poems":[[57,"أزين نساء العالمين أجيبي","https://www.aldiwan.net/poem26547.html","الطويل"],[87,"به سحر يتيمه","https://www.aldiwan.net/poem63012.html","مجزوء الوافر"],[46,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[13,"وشعب كشل الثوب شكس طريقه","https://www.aldiwan.net/poem2225.html","الطويل"],[119,"ينادي وضيع العرق هل من مماثل","https://www.aldiwan.net/poem40853.html","عموديه"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[215,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[236,"قفا بحمى سلع فساكنه الذي","https://www.aldiwan.net/poem44591.html","الطويل"],[435,"أضحى الهناء جميلا في تلاقينا","https://www.aldiwan.net/poem41417.html","البسيط"],[457,"إِليك بها رسالة ذي كناس","https://www.aldiwan.net/poem13804.html","الوافر"],[463,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[487,"من هو أصل وجود","https://www.aldiwan.net/poem24334.html","عموديه"],[505,"هل البرق نجدي أم البرج متكين","https://www.aldiwan.net/poem37764.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48535","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112788","الطويل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79590","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78006","الوافر"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26566","الطويل"],[2170,"","https://poetry.dctabudhabi.ae/diwan/poem/198612","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27879","البسيط"],[2336,"","https://poetry.dctabudhabi.ae/diwan/poem/202320","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137221",""],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105626","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88913","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129378","الطويل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131989","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117857","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85206","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85071","المتقارب"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114383","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114060","الطويل"],[4155,"","https://poetry.dctabudhabi.ae/diwan/poem/178124","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90840","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94558","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58016","الوافر"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136380",""],[4652,"","https://poetry.dctabudhabi.ae/diwan/poem/123764","الوافر"],[4941,"كأسٌ لانقراض ساعي البريد","https://www.poetsgate.com/ViewPoem.aspx?id=178743",""],[5002,"شفيع الأمّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=202586",""],[5013,"نعى الدين والدنيا فعم ظلامها","https://www.poetsgate.com/ViewPoem.aspx?id=170966",""],[580,"مديحُك كَالمِسْكِ لا يُكْتَتَمْ","https://www.poetsgate.com/ViewPoem.aspx?id=42240",""],[5431,"لعمرك إنّ الحب راحٌ ومبهجُ","https://www.poetsgate.com/ViewPoem.aspx?id=189966",""],[5720,"أقمار الزمان (*)","https://www.poetsgate.com/ViewPoem.aspx?id=212483",""],[5768,"لِسانُ الضَّادِ فَخْرُ البلادِ !","https://www.poetsgate.com/ViewPoem.aspx?id=215276",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[6127,"إلى العراق","https://www.poetsgate.com/ViewPoem.aspx?id=199867",""],[6127,"فداءٌ وإباء","https://www.poetsgate.com/ViewPoem.aspx?id=215939",""]],"verses":[["بِهِ سَقَمٌ أَعيا المُداوينَ عِلمُهُ","سِوى ظَنَّهُم مِن مُخطِئٍ وَمُصيبِ",0,"ب",1,0],["بِهِ سِحرٌ يُتَيِّمُهُ","كِلا جَفنَيكَ يَعلَمُهُ",1,"م",2,1],["بِهِ سُبِتوا في السَبتِ بِالبيضِ وَالقَنا","سُباتاً ثَوَوا مِنهُ إِلى الحَشرِ نُوَّما",2,"م",2,0],["بِهِ سَمَلاتٌ مِن مِياهٍ قَديمَةٍ","مَوارِدُها ما إِن لَهُنَّ مَصادِرُ",3,"ر",1,0],["به ساد انذال طغام وقد طغوا","ومدوا لهدم المجد باع التطاول",4,"ل",1,0],["بهِ سننَ القومُ النَصارى تتبّعوا","عَلى الإثرِ لَم يَعدوا ذِراعاً ولا شبرا",5,"ر",2,0],["به سموتُ إليك","فعرفت من أنتَ",6,"ت",1,0],["به سعدوا بعد الشقاء وكم له","من النار من مستخلص متنقذ",7,"ذ",1,0],["به سمونا على هام السماك وإن","نشهد قتالا فيمناه عيانينا",8,"ن",2,0],["به سِرْب شَدِنَّ على المراعي","بألحاظ تذكرك المغازي",9,"ز",2,0],["به ساكنٌ من طيبِ عهدك عامرٌ","يُريح عَزيبَ الحُزن من حيث يَسرحُ",10,"ح",1,0],["به سعدنا وصلنا","محمد عبد صالح",11,"ح",1,0],["به سِرُّ أَصحابِ العَبا ضمنَ سِينِهِ","أَجلْ فغُموضُ السِّرِّ موضِعُهُ السِّينُ",12,"ن",1,0],["به سر المهيمن والنبيُّ","وعز الدينُ والبلد الحرامُ",13,"م",1,0],["به سيدي فامنن عليّ بنظرة","أفوز بها يا سيدي برضائكم",14,"م",1,0],["به سحبت خوارزم ذيل مفاخر","على خطة الشعرى وربع الفراقد",15,"د",1,0],["به سلكوا في حبه مسلكا جهل","وكلهم بين المشاهد قد ذهل",16,"ل",1,0],["به سكر وليس لديه خمر","به وجد وليس على نسيب",17,"ب",1,0],["بِهِ سَلِمَ الإِسلامُ مِن كُلِّ مُلحِدٍ","وَحَلَّ بِأَهلِ الزَيغِ قاصِمَةُ الظَهرِ",18,"ر",1,0],["به سأملك أملاكي على ثقة","ويرجع الحق ضخما وهو مندمج",19,"ج",1,0],["به سمعت كما به نطقت لذا","قد قام فينا مقامَ الحافظِ الراعي",20,"ع",2,0],["به سقم من كل سقم وخبطة","من الدهر أصغى غصنه فهو ساجد",21,"د",1,0],["به سرت في ضوء القوانين سيرة","كما سار فيها قبلك العمران",22,"ن",1,0],["به سلكت سبل المعالي فأصبحت","تهادي بفضل الدين في حلل الفخر",23,"ر",1,0],["به سعدت تلك البلاد وقد كسا","وأولى ثيابَ العز واليمن والبر",24,"ر",1,0],["به سمة من صبغة الخال سودت","بصيرته لو كان ممن تبصرا",25,"ر",2,0],["به سحنون في الأخرى قرير","يبشر معشرا سكنوا الترابا",26,"ب",2,0],["به سيؤون باسمة سرورا","وحق لها وربك الابتسام",27,"م",1,0],["به سرة سرت وسرت وفاخرت","وحق لها المجد المؤثل والفخر",28,"ر",1,0],["به سور الحسن مجلوة","وآياتها في الحشى تسطر",29,"ر",1,0],["به سرتِ الأكوانُ وازدادَ زهوها","وطابَ نعيمُ العيشِ والدهرُ أنعما",30,"م",2,0],["بِهِ سَجَدَت لَهُ بِسَبعِ طَرَائِقٍ","وَمَن حَلَّ فِي مَشَارِقٍ أو مَغَارِبِ",31,"ب",1,0],["به سماتٌ من قرونٍ سلفت","يعرف من أقربها المهلّبا",32,"ب",2,0],["به سورية الحسناء اضحت","بسور الحكم محكمة الحدود",33,"د",1,0],["به سِمَةٌ لاحت إلى الكون هيبةً","عليهِ وقارُ المجد جمَّلةُ الفخرُ",34,"ر",1,0],["به سوني لقد صارت حصاناً","تحامتها الدوائِرُ إذ تدور",35,"ر",1,0],["به سعدت أيامه وبلاده","وقامت بها الأفراح والراحة الكبرا",36,"ر",2,0],["به سعدت دمشق الشام لما","تولى قاضياً شرع التهامي",37,"م",2,0],["به سيقومُ آخِرُ خارجيّ","وآخرُ موجةٍ ستخون نهرا",38,"ر",2,0],["به سُنَّتِ الأفعالُ بالعقلِ والنُّهى","وأخْرَى بجنَّاتٍ تدعُو وترفدُ",39,"د",1,0],["به سلك الناس السبيل إلى الهدى","فغاب فعجت بالمراثي كرامها",40,"م",3,0],["به سَوفَ أَدخُلُ دارَ السلامِ","ويُلْقِي الزمانُ إِليَّ السَّلم",41,"م",1,0],["به سبّح الأفق الرحيب لربّه","وفاحت حشايا الزهر عطرا تُضرجُ",42,"ج",1,0],["به .. سطَّرتُ من نسجي رسوماً","وشكَّلها . . بأحرفها . . بناني",43,"ن",2,0],["بِهِ سَطَعَتْ عَلَى الدُّنْيا","شُمُوسُ الْعَقْلِ والْفِكْرِ",44,"ر",1,0],["به سادت الأرواح يوم خطابها","على روفق ما كان الجواب استمدت",45,"ت",1,0],["به سُطِرتْ دهورٌ بل رزايا","ومُرُّ الصبرِ يحكيهِ المُحيّا",46,"ي",2,0],["به سطرت ملاحمَ من نضالٍ","وأوقدَتِ الدِّما، فالطودُ جمرُ",47,"ر",1,0]]}