ةً أَوْطانُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=63586",""],[5751,"مرسوم كوني بنرجسية شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214785",""],[5790,"متى بت إلا في هواك موحدا","https://www.poetsgate.com/ViewPoem.aspx?id=112031",""],[5790,"تعشقت بدرا وجهه مشرقٌ كذا","https://www.poetsgate.com/ViewPoem.aspx?id=111948",""],[5790,"الله أكبر أي طرف يطمح","https://www.poetsgate.com/ViewPoem.aspx?id=111868",""],[5848,"ست الكل","https://www.poetsgate.com/ViewPoem.aspx?id=53093",""],[5956,"الحنوُّ الغزير","https://www.poetsgate.com/ViewPoem.aspx?id=192936",""],[6093,"لك في الشعر ثبات ورسوخ","https://www.poetsgate.com/ViewPoem.aspx?id=197662",""],[6257,"بدويّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87175&r=&rc=0",""],[6277,"الحنين الى الجزيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64461&r=&rc=24",""]],"verses":[["تَعشو إِلى ضَوءِ المَشيبِ فَتَهتَدي","وَتَضِلُّ في لَيلِ الشَبابِ الغابِرِ",0,"ر",1,0],["تَعَشَّقَتْ بِظِلاَلٍ","حَارَتْ لَدَيْهَا وَضَلَّتْ",1,"ت",1,0],["تَعشَقُ الجَوَّ صافي اللَونِ صَحواً","وَالمُضِلّونَ يَعشَقونَ الضَبابا",2,"ب",2,0],["تَعشَقُ الأَلقابَ في غَيرِ العُلا","وَتُفَدّي بِالنُفوسِ الرُتَبا",3,"ب",2,0],["تَعَشّى قَليلاً ثُمَّ أَنحى ظُلوفَهُ","يُشيرُ التُرابَ عَن مُبيتٍ وَمُكنِسِ",4,"س",1,0],["تعشقت فيها حسن كل حقيقة","وأعرضت عن حسن الحسان الغَرائق",5,"ق",1,0],["تَعَشّوا مِن خَزيرِهِمُ فَناموا","وَلَم تَهجَع قَرائِبُهُ اِنتِحابا",6,"ب",2,0],["تعشقتها والخد يشبه خدها","أأعشقها والشيب ملتمع اللمح",7,"ح",1,0],["تعشقته شاهر الوجنتين","بما لقى القلب من جرحه",8,"ح",2,0],["تعشقته بابليَّ اللحاظ","يسكر من شاء أو يسحر",9,"ر",1,0],["تعشقتها في الحلي غصناء منثورا","وفي البردِ بدراً في السماء منيرا",10,"ر",2,1],["تعشقته ظبيَ الكناس إذا عطا","وعلّقته ليث العرين إذا سطا",11,"ط",2,1],["تعشّقته كالبدر في الطرق مشرقاً","فيا أسفي والبدر زاهٍ وآفل",12,"ل",1,0],["تعشقته لا قول فيه لعاذلٍ","لديَّ ولا في حسنه الفرد قولان",13,"ن",1,0],["تعشقته غصناً ناضراً","يميل به السكر من ناظريه",14,"ي",2,1],["تُعْشِي بضوئك عينيه فَيَنْبَحُهُ","ليَنبَحِ الكلبُ ضوءَ البدر ما نبحا",15,"ح",2,0],["تعشو الرجال إلى نواجم رأيه","والخطب أعجمُ داثرُ البرهان",16,"ن",1,0],["تَعَشَّقتُهُ حُلوَ الشَمائِلِ أَهيَفاً","يُحَرِّكُ شَجوَ العاشِقينَ قَوامُهُ",17,"م",2,0],["تَعَشَّقتُها مِثلَ الغَزالِ الَّذي رَنا","لَها مُقلَةٌ نَجلا وَأَجفانُها وُطفُ",18,"ف",1,1],["تَعَشَّ فَإِن واثَقتَني لا تَخونَني","نَكُن مِثلَ مَن يا ذِئبُ يَصطَحِبانِ",19,"ن",1,0],["تَعَشَّقتُ لَيلى مِن وَراءِ حِجابِها","وَلَم تَرَ عَيني لَمحَةً مِن جَنابِها",20,"ب",3,1],["تَعْشَوْشِبُ الأَرْضُ مِنْ عَيْنَيْكَ مُلْتَفِتَاً","وَتَسْتَدِرُّ يَدَاكَ المَنْهَلَ الثَّمِدَا",21,"د",2,0],["تَعَشُّقُكَ الكِبارَ يَدُلُّ عِندي","عَلى أَنَّ الرَحا قُلِبَت ثِفالا",22,"ل",2,1],["تَعْشُو الرِّكَابُ فِإِنْ تَبَلَّجَ كَأْسُهَا","سَارُوا وَإِنْ زَالَ الضِّيَاءُ أَقَامُوا",23,"م",3,0],["تعشقتُهُ لَدْنَ القوامِ مهفهفاً","شهيَّ اللمى أحوى المراشفِ أشنبا",24,"ب",2,1],["تعشقتُ أحوى لي إليهِ وسائلُ","وإصلاحُ أحوالي لديهِ لديهِ",25,"ي",2,1],["تَعَشَّقتُ لَيلى وَاِبتُليتُ بِحُبِّها","وَأَصبَحتُ مِنها في القِفارِ أَهيمُ",26,"م",1,1],["تَعَشَّقَها قَلبي فَبَغَّضَ عِشقُها","إِلَيَّ مِنَ الأَموالِ كُلَّ نَفيسِ",27,"س",1,0],["تعشقتها سمراء يحلو حَديثها","وَما فيه من لحن لكل سَميع",28,"ع",1,0],["تعشق كلَّ ذات وجه ضاحي","ولا أقول: رَجُلٌ إباحي",29,"ح",2,0],["تعشش العقبان في أحضانه","وتنشط الوحش اليه للخلا",30,"ا",1,0],["تعشق النور والندى وسموّ ال","روح في النشّ والعقول الجليلة",31,"ل",2,0],["تعشقتُ من \" عمرٍ \" قوَلهُ","وكم حكمة في معاني عمر",32,"ر",1,0],["تعشّقها الشعوب فكلّ شعب","أعدّ لها الثغور وكلّ قطر",33,"ر",1,0],["تعشَّقَ دمعي رسْمَها فَكأَنَّها","تَظَلُّ عَلَى رسْم من الدمْعِ واجبِ",34,"ب",1,0],["تَعشَّقهُ طَيرُ الأَراكةِ أَخضَراً","وَحَنَ إِلَيهِ ريشُهُ وَهوَ يابِسُ",35,"س",1,0],["تعشقتهُ ظمآنَ للحبِّ فارتوى","فؤادي ولكنْ ردني جد ظمآنِ",36,"ن",1,0],["تعشقتها بكرا عليّ بعجبها","تميل ولا يوما بحاليَ تعبأ",37,"ب",2,1],["تَعَشَّقَ مَن هَوَيتُ فَبِتُّ صَبّاً","أَخا كَلَفٍ بِمَن يَهوى الحَبيبُ",38,"ب",1,1],["تَعشو السِباعُ إِلَيها حينَ يَرفَعُها","ظامي الحَشا وَخَميصُ البَطنِ طَيّانُ",39,"ن",1,0],["تَعَشَّقتُهُ واهي المَواعيدِ مَذّاقا","نَرى كُلَّ يَومٍ في الهَوى مِنهُ أَخلاقا",40,"ق",2,1],["تعشَّقتُ أجفاناً وقبَّلتُ أصداغا","وكنتُ كظَبيٍ ظَبيةً مِثلَه ناغى",41,"غ",2,1],["تعشَّقتُ أعكانَ العذارى تلطَّفاً","وأعرضتُ فيهِ عن غضونِ العجائز",42,"ز",1,0],["تعشَّقتُها بنتَ خمسٍ وعشرٍ","توقَّد في عَينها الحبُّ نارا",43,"ر",2,0],["تعشَّقتُ أجفاناً فسلَّت سيوفَها","عليَّ وكانت هدنةٌ وحروب",44,"ب",1,0],["تعَشَّقَ النورَ حتى بتُّ أحسَبُهُ","معلَّقاً بشُعاعٍ من نُجُومِهم",45,"م",1,0],["تعشَّقتُ ماءَ الرَّوضةِ المُترَجرِجا","وكم شاقني نوحُ الغصونِ وكم شجا",46,"ج",2,1],["تعشّقتُها طفلاً وشاهَدتُها فتىً","وحيَّيتُها بالشّعرِ والبَسمات",47,"ت",1,0],["تُعشي العيونَ إذا اِنجَلَت","بالضوءِ من نارٍ وَنورِ",48,"ر",1,0],["تعشقته جاراً أسال مدامعي","وحملني ما ليس يحمله الناس",49,"س",1,1],["تعشقت وضاح المحيا جبينه","به الفجر في أفق السماء تبلجا",50,"ج",2,1],["تعشقته كالغصن والبدر أحورا","مليحا من الأكراد قد فتن الورى",51,"ر",2,1],["تعشقته مثل القضيب إذا انثنى","بوجهٍ حكى البدر المنير إذا تما",52,"م",2,1],["تُعشي أَشعّتها عيون أخافشٍ","تقفو ضياءَ كواكبِ الأذهانِ",53,"ن",1,0],["تعشقتها للتصابي فشبت","غراماً ولم أك بالشيب راض",54,"ض",1,0],["تعشق الإفسادَ في الأرض وتأبى","أن ترى أرض سواها في ازدهار",55,"ر",1,0],["تَعشَى إذا نَظرُوا إليّ عُيونُهم","تحتى كأنّ الشّمسَ دُوني تُشرِقُ",56,"ق",1,0],["تعشَّقْتُ علويَّ فضل العلوم","فما تبتغي بالمعالي بديلا",57,"ل",2,0],["تعشق فعل الخير والجود طبعه","وهام بغايات المرؤة والمجد",58,"د",1,0],["تعشقتها حرية عرفت بكم","لدينا ولم تبرح لها منعشقا",59,"ق",2,0],["تَعَشّى أَسافِلُها بِالجَبوبِ","وَتَأتي حَلوبَتَها مِن عَلُ",60,"ل",1,0],["تعشقَّك الفوآد فصرتِ فيه","وصرتُ متى أرى ذاتي أراكِ",61,"ك",1,0],["تعشق روح كل ذي","حقيقةٍ خصالهم",62,"م",1,0],["تعَشَّقْتُكُمْ من قبلِ تَكْوينِ طينَتي","بذاكَ مَليكُ الأَمرِ بالغَيْبِ أَوْحى لي",63,"ل",2,0],["تعشَّقْتُهُ ما القدُّ والخَدُّ بُغْيَتي","خِلافاً لمن أودَى به القَدُّ والخَدُّ",64,"د",1,0],["تعَشَّقَكُمْ طِفلاً وكَهلاً ويافِعاً","وشيْخاً وفيكُمْ صارَ عذباً عَذابُهُ",65,"ب",2,0],["تعشّقَ المجدَ طِفلاً واِستَهامَ بهِ","فهانَ فيهِ عليه ما يُقاسِيْهِ",66,"ي",2,0],["تعَشَّقتكُم طِفلاً ولم أدْر ما الهوى","فَلا تقْتُلوني أنْتمُ فيُعلَم",67,"م",1,0],["تَعشُو الوُفودُ إلى بابٍ لمنزلهِ","لا يَطلُعُ الفجرُ إلاّ وَهْوَ قد قُرِعا",68,"ع",2,0],["تَعَشَّقْنا الحِجازَ وقد سَمِعْنا","بمَنزِلها على ذاتِ الإصادِ",69,"د",1,0],["تعشق الروحُ مثلها لمعانٍ","هي ظُرفٌ ورقَّةٌ وذكاءُ",70,"ا",2,0],["تَعَشَّقتُ في قَومٍ غِرابٍ فَودَّعوا","فيا لَيْتَني مَيْتٌ ولَمْ أتعشَّقِ",71,"ق",1,0],["تعشَّقَ المجدَ أدناه وأبعدَه","والمجدُ أعشقُ شيءٍ مَن تعشَّقه",72,"ق",2,0],["تعش من الدهر في أمن وفي دعة","بها ومهما ترم من لذة تجد",73,"د",1,0],["تَعَشَّقتُها بِالسَّمعِ ثمّ لَمَحتُها","وَبِالسّمعِ يَبدو العِشق أَو يبدُ باللّمحِ",74,"ح",1,0],["تَعشّقتها حينَ أَن كُنت حَملاً","فَهِمْتُ بِوَجدي أَجوبُ القِفارا",75,"ر",2,0],["تَعَشَّقَ الدِّرعَ إِذ شُدَّت لَفائِفُهُ","وَأَبغَضَ المَهدَ لَمّا أَبصَرَ الفَرَسا",76,"س",2,0],["تَعَشَّقْنَ ضَوْءَ الخَد مِنْهُ وَإِنَّمَا","تَعَشَّقْنَ ضَوْءَ الشَّمْسِ لَمَّا تَجَلَّتِ",77,"ت",1,0],["تُعشِى البَصِيرَ إِذا تَأَمَّلَ وَجهَهَأ","مِن حُسنِها وَتُقِيمُ عَينَ الأحوَلِ",78,"ل",1,0],["تَعشَّقَتِ العِبادُ بَياضُ طُرسٍ","يَسوِّدهُ كَما عُشِقَ الجَمالُ",79,"ل",1,0],["تعشقتها طفلاً صغيراً فقادني","إليها الهوى لما بدا لي جمالها",80,"ل",3,0],["تعشق بالسمع اللطيف صفاتكم","وهام بكم وجداً وصار قتيلا",81,"ل",2,0],["تَعَشَّقْتُ مِنْ سِرْبِهِ شادِناً","يَعِنُّ فَيَفْتِنُ عُشَّاقَهُ",82,"ق",2,0],["تعشقتُ مكفوفَ اللواحظِ ثغرهُ","ووجنتُه قد ضاعفا في الهوى وجدي",83,"ي",1,1],["تعشقته حتى تتبعتُ سيره","وأدركته أوكدت إذ دربه دربي",84,"ب",2,0],["تعش سعيداً وفي الأخرى تَنَل كرماً","من الإِله وتكفى زلة القدم",85,"م",1,0],["تَعَشَّقْتُه ظَبْياً فَنَمَّ عِذارُهُ","فَنادَيتُ يَا قَلْبِي خَلَصْتَ مِنَ السَبْيِ",86,"ي",1,1],["تعشق يحيى تموت، قلت له:","طوبى لصبّ يموت في يحيى",87,"ي",2,0],["تعشقتهُ نشوانَ من خمرةِ الصِبا","منعَّم أطراف البنانِ خضيبها",88,"ب",3,0],["تعشّقتْ فينا صديقاً لها","والجمع باتوا في هَواها سَوا",89,"س",3,0],["تَعشَّقتُ فِيهِ قَبلَ أن أَعرِفَ الهَوَى","فَلاَ تَسأَلَن مِن بَعدِ 