{"poems":[[55,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[80,"الجود أحلى على قلبي من الظفر","https://www.aldiwan.net/poem14158.html","البسيط"],[427,"يا قلب زرت وما انطوى ذاك الجوى","https://www.aldiwan.net/poem46393.html","الكامل"],[470,"من لي ببغداد","https://www.aldiwan.net/poem36225.html","عموديه"],[517,"إني امرؤ عف الضري","https://www.aldiwan.net/poem1769.html","مجزوء الكامل"],[560,"من مبلغ ملائكي حبشياً","https://www.aldiwan.net/poem1920.html","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87211","المجتث"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86940","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77618","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70726","البسيط"],[1544,"","https://poetry.dctabudhabi.ae/diwan/poem/111125","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48956","الكامل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101566","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118299","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27178","الرجز"],[2606,"","https://poetry.dctabudhabi.ae/diwan/poem/198979","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204998","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36717","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77072","البسيط"],[5136,"القلب يخشع والأماني تدمع","https://www.poetsgate.com/ViewPoem.aspx?id=121614",""],[5431,"قصيدة اليوم ...","https://www.poetsgate.com/ViewPoem.aspx?id=202682",""],[5431,"قلبٌ من الحلوى ..لحبيبي رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=206463",""],[470,"شكرا دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=64693",""],[5688,"رحيل العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200936",""],[6102,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=185331",""],[5567,"فيوضات فارابية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82101&r=&rc=142",""]],"verses":[["حَتّى اِمتَطى راحِلَةً","تُنكِرُها الرَواجِلُ",0,"ل",1,0],["حَتّى أُمَلِّك هذي ما تَجودُ بِهِ","وَأَسمَعَ الحَمدَ بِالأُخرى عَلى الأثرِ",1,"ر",1,0],["حتّى أموتَ وإن أمُت متحيرا","فلكُلِّ عبد مسلم ما قد نرى",2,"ر",2,0],["حتى أمُرَّ على الجسرَين..أركضُ في","صَوبِ الرَّصافَةِ ما بَينَ الدَّرابين ِ",3,"ن",1,0],["حتى أميلَ بفارسٍ","مَيْلَ الغَبيطِ عن الحَوِيَّهْ",4,"ه",1,0],["حَتى أَموتُ ماجِداً وَفِيّا","إِذا رَأَيتُ جارَنا مَغشِيّا",5,"ي",2,0],["حَتّى أَموت فَأُمسي","في راحة دائِميه",6,"ي",2,0],["حَتّى أَموت وَبِالجَحيم يَقودني","عَمل بِهِ سوّدت لي قُرطاسي",7,"س",2,0],["حَتّى اِمتَلا كِلاهُما وَاِنكَبَسا","وَفارَقا الدُنيا وَعافا النَفَسا",8,"س",2,0],["حَتى أمالت فَعال الخمر مهجَتها","إلى الهوى وألانتْ قلبَها القاسي",9,"س",2,0],["حتى أمال البدر جحفته","عنا وسل حسامه الفجر",10,"ر",1,0],["حتى أَممتُك زائراً","فغدوتُ في مَغناك شاعر",11,"ر",1,0],["حتى امتلا جوف الفضاءِ من الضيا","وزهت بذلك كافة الأقطارِ",12,"ر",1,0],["حتى امر حبالا لا يغيرها","طول التنائي ولا مشى الانصاء",13,"ا",2,0],["حَتّى أَمِنتُ بَينَهُم","وَما أَمِنتُ بَينَهَم",14,"م",1,0],["حتى أميل العاشقيين تطرباً","كالغصن مر صباً على ممشوقه",15,"ق",2,0],["حتى أمرضه وأسفعه فإن","أثرى وعوفي وازدهى واستعظما",16,"م",2,0],["حَتّى اِمتَطى صَهواتِ المَجدِ سامِيَةً","يَختالُ في حُلل الأَوضاع وَالغُرَرِ",17,"ر",1,0],["حَتّى اِمتَطَيتَ ذَرى العَلياءَ لا أَشَراً","وَلا فَخوراً وَلا مُستَكبِراً قَذَعا",18,"ع",2,0],["حتى امتطت كيوان منه همة","همم الورى حسراً وراها صلع",19,"ع",1,0],["حتى امرء القيس إذْ يلهو بها وطرا","قد ميّزَ الحبَ عن لهوٍ إذا اقتحمه!!",20,"م",2,0],["حتى امتلأتُ وفيضُ النبع صيّرني","سربا من الطير يبغي النور والشأوا",21,"و",2,0],["حتى امتُحِنتُ بصَوتي كيفَ أ ُطلِقُهُ","وَكُلَّما قُلتُ : يا بغدادُ .. أختَنِقُ",22,"ق",1,0],["حتّى امتلا القلب وانسابت جوانبه","عشقا كما فاض من مخزونه السُّحُل",23,"ل",1,0],["حَتَّى أَمَاسِيُّ الشَّذَى","بِالزَّهرِ مَا عَادَتْ تَجُودْ",24,"د",1,0],["حتى أمسى مُعَلّماً وحكيما","حاملاً حلمَ عالَم ٍ إنساني",25,"ن",2,0]]}