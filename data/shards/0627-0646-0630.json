poem/95330","الرجز"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76476","الخفيف"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36526","الدوبيت"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93756","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94465","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94895","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81697","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136698",""],[4359,"","https://poetry.dctabudhabi.ae/diwan/poem/141152","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133085","المديد"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205457","الخفيف"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123866","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120513","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139762",""],[4691,"ألهمتني بدلها هيفاء","https://www.poetsgate.com/ViewPoem.aspx?id=61364",""],[4767,"العلامات المبينة","https://www.poetsgate.com/ViewPoem.aspx?id=94788",""],[4767,"استجارة","https://www.poetsgate.com/ViewPoem.aspx?id=184946",""],[4805,"لجة صمت 2","https://www.poetsgate.com/ViewPoem.aspx?id=176603",""],[4858,"نفِد الماءُ ، وإنّي ظامئٌ","https://www.poetsgate.com/ViewPoem.aspx?id=141843",""],[5022,"ألقمرية","https://www.poetsgate.com/ViewPoem.aspx?id=200597",""],[5092,"أنا وليلٌ بعينيها","https://www.poetsgate.com/ViewPoem.aspx?id=147140",""],[5174,"لغة الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=199065",""],[5183,"النافقاء","https://www.poetsgate.com/ViewPoem.aspx?id=186606",""],[5186,"أيهذا البناء لو كنت حرا","https://www.poetsgate.com/ViewPoem.aspx?id=156469",""],[5373,"بلاغة القرآن وإعجازه","https://www.poetsgate.com/ViewPoem.aspx?id=186008",""],[5581,"أنذار","https://www.poetsgate.com/ViewPoem.aspx?id=22501",""],[5703,"لمّا رأيتكَ","https://www.poetsgate.com/ViewPoem.aspx?id=207958",""],[5781,"خُدوشٌ على مَلْمَسِ الياقوت","https://www.poetsgate.com/ViewPoem.aspx?id=202832",""],[402,"أنزل الروع في صلاب العماد","https://www.poetsgate.com/ViewPoem.aspx?id=35419",""],[402,"جمع الحب أي جمع كريم","https://www.poetsgate.com/ViewPoem.aspx?id=36325",""],[5910,"حيِّ الطلولَ ونبِّ عن أخبارِها","https://www.poetsgate.com/ViewPoem.aspx?id=206239",""],[5944,"طلع الشعر علينا","https://www.poetsgate.com/ViewPoem.aspx?id=212850",""],[5956,"هذي الطبيعة يا رفاهي غضبى","https://www.poetsgate.com/ViewPoem.aspx?id=196809",""],[4442,"ما بال جفنك لا يدر","https://www.poetsgate.com/ViewPoem.aspx?id=171226",""],[4442,"عاد الوصي إلى علائه","https://www.poetsgate.com/ViewPoem.aspx?id=171021",""],[6079,"إني إلى لقياكم مشتاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=213531",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[572,"عَجِبَتْ من قَنَاعَتي وقُعُودي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9230&r=&rc=87",""]],"verses":[["إِنَّ ذُلّي بِذَلِكَ الجَوِّ عِزٌّ","وَأُوامي بِذَلِكَ النَقعِ رَيُّ",0,"ي",1,0],["أَنذَرَنا الدَهرُ وَما نَرعَوي","كَأَنَّما الدَهرُ سِوانا عَنى",1,"ن",2,0],["إِنَّ ذَنبي إِلى الغَواني بِشَيبي","ذَنبُ ذِئبِ الغَضا إِلى الآرامِ",2,"م",1,0],["إِن ذُبتَ مِن كَمَدٍ فَقَد جَرَّ الهَوى","هَذا السَقامَ عَلَيَّ مِن جَرّاكا",3,"ك",2,0],["أَنذَرَهُم مِنهُ وَعَن","دَ القَومِ أَضعافُ الخَبَر",4,"ر",1,0],["إنّ ذكراك ورائي وعلى","وجهتي حيث مجيئي وذهابي",5,"ب",2,0],["أَنْذَرْتَ قَبْلَ النُّضْجِ لَمَّا جِئْتَهَا","مَلِكاً وَكَانَ الْبُرْءُ فِي البُحْرَانِ",6,"ن",1,0],["أنذَرَ المُنْذِرُ الأنامَ بجَدْوا","هُ وسَحّ النُّعْمانُ نُعْمى عَتادِ",7,"د",1,0],["إنْ ذُكِرَ المَحْبوبُ سالَتْ دَماً","ما هُنَّ أكْبادٌ ولكِنْ جُروحْ",8,"ح",1,0],["أَنذَرتُ أَعدائي غَدا","ةَ قَناً حُدَيّا الناسِ طُرّا",9,"ر",2,1],["إِنْ ذَكَرْتُ الخَلِيلِ نَوَّهَتِ الآ","فَاقَ فِي الشَّرْقِ بِالأَدِيبِ العَلِيمِ",10,"م",1,0],["أنذِلّ للمستعمرين وعندنا","جيش إذا خاض المعارك ما انثنى",11,"ن",2,0],["إِنَّ ذاكَ الصُدودَ مِن غَيرِ جُرمٍ","لَم يَدَع فِيَّ مَطمَعاً بِالوِصالِ",12,"ل",1,0],["أنذرْتُ بل بشَّرْتُ أنَّ مقالتي","ميعادُ جِدٍّ في وعيد مُزَاحِ",13,"ح",1,0],["أنْذَرْتُ من في دراه مَطْبخٌ","ضَرْطَةَ إبراهيمَ من فرسخِ",14,"خ",1,0],["أنذر في البخل معشرٌ مُنُعٌ","وفي السماح الغريبِ إنذاره",15,"ر",2,0],["إنّ ذكرَ الحميد غيرُ حميدٍ","حين يعرُوك رائداً في ارتماض",16,"ض",1,0],["أنذرتُ نبلي أنها إن أُرسلتْ","لم تُبقِ باقيةً من الأعراض",17,"ض",1,0],["أنذرت حرب الهجاء ملقِحَها","فما لها غيرَ حتفه ربع",18,"ع",1,0],["إن ذا من ورد خدَّي","كِ لِصبَّاغٍ رفيقِ",19,"ق",1,0],["إن ذاك الكمالَ فيك غريمٌ","يتقاضاك في الأيادي الكمالا",20,"ل",2,0],["أنذرتكم قبل الخسو","فِ بما ترون من الزلازلْ",21,"ل",1,0],["أنذرني دِقْلِشٌ بنادرةٍ","معدودة من نوادرِ الكَلمِ",22,"م",1,1],["إِنَّ ذا المُلكَ هَيكَلٌ نَحنُ فيهِ ال","قَلبُ وَالقَلبُ سَيِّدُ الأَعضاءِ",23,"ا",2,0],["إِنَّ ذا يَومٌ سَعيدٌ","بِكَ يا قُرَّةَ عَيني",24,"ي",1,1],["إِنَّ ذَنبَ الغَدرِ في الحُب","بِ لَذَنبٌ لا يُكَفَّر",25,"ر",1,0],["إنَّ ذا عَصْرُ ظُلْمَةٍ غَيْرَ أنِّي","مِنْ وراءِ الظَّلامِ سِمْتُ صَبَاحَهْ",26,"ح",2,0],["ان ذاك الصعود في الجو منهم","كان للمجد والعلا والغلاب",27,"ب",1,0],["ان ذكر الآداب","فهو وحده المقدم",28,"م",1,0],["ان ذاك الذي حسبناه نهراً ضيقاً","امسى اليوم كالبحر رحبا",29,"ب",2,0],["أَنذَرتَنا رِقّاً يَدومُ وَذِلَّةً","تَبقى رِحالاً لا تَرى تَحويلا",30,"ل",2,0],["إِن ذُمَّ لَم يَجِدِ الدُنيا لَهُ عِوَضاً","وَلا يُبالي الَّذي خَلّا إِذا حُمِدا",31,"د",2,0],["أَنذَرتُكُم عارِضاً تَدمى مَخايِلُهُ","القَطرَةُ الفَذُّ مِنهُ عارِضٌ هَطِلُ",32,"ل",1,0],["أنذرتُكُم حامي الحَقيقَةِ لا يَرى","إلا لِمُرْهَفَةِ السُّيوفِ حُقوقا",33,"ق",2,0],["إِنَّ ذا المَوتَ ما عَلَيهِ مُجيرُ","يَهلِكُ المُستَجارُ وَالمُستَجيرُ",34,"ر",1,1],["إِن ذُقتُ حَلواءَها عادَت عَواقِبُها","مَرارَةً يَجتَويها كُلُّ مَن أَكَلا",35,"ل",2,0],["إِن ذُكِرَ العِلمُ فَنُعمانُهُ","أَو ذُكِرَ الحُكمُ فَلُقمانُه",36,"ن",2,0],["إنَّ ذاك الفتى الوديعَ الطهورَ ال","قلب في رقة النسيم الساري",37,"ر",2,0],["إِنَّ ذَمّي مُحَمَّدَ بنَ يَزيدٍ","في الَّذي نالَهُ لَغَيرُ صَوابِ",38,"ب",1,0],["إن ذكرتم دولةَ الضادِ فلا","تَنْسَوُا التّاجَ ولا الشّيخَ الإِماما",39,"م",2,0],["أَنذِرِ الأَقوامَ لَو تُغني النُذُرْ","وَاِبعَثِ النُوَّامَ مِن خَلفِ السُتُرْ",40,"ر",1,1],["أَنُذعِنُ لِلحُكمَينِ أَمّا الَّذي لَهُم","فَجَمٌّ وَأَمّا ما لَنا فَمُصَرَّدُ",41,"د",1,0],["أَنُذعِنُ لِلباغي وَنُعطيهِ حُكمَهُ","وَفي التُركِ مِقدامٌ وَفي العُربِ حازِمُ",42,"م",1,0],["أْنذرتُ أعداءَ البلادِ","بشرِّ يومٍ مُستطير",43,"ر",1,0],["إنّ ذُلَّ العزيزِ أفظعُ مَرْأىً","بين عينيْهِ من لقاء الحُتوفِ",44,"ف",1,0],["إِنَّ ذِكراهُ عَلى هِجرانِهِ","لَتُجَلّي كَربَ قَلبٍ مُختَلَس",45,"س",1,0],["ان ذاك الشباب ما كان يوما","عهده بعد ان مضى منسيا",46,"ي",2,0],["إن ذاكَ الكرسي بين الدراري","يِ لرب للعزة القعساء",47,"ا",2,0],["إن ذكر الآباء جاءا بالقمر","جدّا تمناه العتيق وعمر",48,"ر",1,0],["إِنَّ ذَا الْحَاجَةِ مَا لَمْ يَغْتَرِبْ","عَنْ حِماهُ مِثْلُ طَيْر في قَفَصْ",49,"ص",1,0],["إِنْ ذَاكَ إِلاَّ العَهْدُ فِي تَابُوتهِ","عَهْدُ القَدِيرِ لِشَعْبِهِ الْمُخْتَارِ",50,"ر",1,0],["إِنْ ذَا النِّعْمَةِ الذِي لاَ يُزَكِّي","لِجَمَادٍ مَوَكَّلٌ بِجَمَادِ",51,"د",1,0],["إِنَّ ذاكَ الَّذِي تُعَزَّوْنَ فِيهِ","لَيُعَزَّى فِيهِ التُّقَى وَالخَيرُ",52,"ر",1,0],["إِنْ ذَكَرْنَا أَسْمَاءَهُمْ يَوْمَ فَخْرٍ","طَابَ فِي النَّابِغِينَ ذِكْرُ نَجِيبْ",53,"ب",1,0],["إن ذَلَّ فجيْشُك ينْصرُهُ","أو ضَلَّ فرأْيُكَ يُرْشِدهُ",54,"د",2,0],["إنْ ذَكَرْناكَ هَزَّنا الشَّوْق للشَّوْ","قِ وَلَهْوِ اللِّدّاتِ وَالأَترَاب",55,"ب",1,0],["إنَّ ذكرى الزَّفافِ أسعدُ ذكرَى","تملأُ النَّفْسَ من مُنىً وارتياح",56,"ح",1,0],["إن ذلك الوَداعَ كان نذيراً","بحِمامٍ دلَّتْ عليه عَلائِم",57,"م",1,0],["إن ذم لم يجد الدنيا له عوضا","ولا يبالي الذي خلى إذا حمدا",58,"د",2,0],["إنّ ذا هيكل نحن فيه القلب","والقلب سيّد الأعضاء",59,"ا",2,0],["إنَّ ذا عَصْرُ ظُلْمَة ٍ غَيْرَ أنِّي","مِنْ وَرَاءِ الظَّلاَمِ شِمْتُ صَبَاحَهْ",60,"ح",2,0],["إِن ذكر الكِرام ذكر جَميل","لَيسَ يُبلى وَكُل شَيءِ