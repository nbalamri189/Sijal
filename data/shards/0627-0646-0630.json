,"ونفى سناها الهمّ والتعبيسا",137,"س",2,0],["إِنَّ ذا الدَهرَ هكذا فَتصَبَّر","صَبرَ لا عاجز ولا مُتَوانِي",138,"ن",2,0],["إن ذكرَ الإلهِ يُرسِلُ نوراً","في قلوبٍ تفيضُ بالإيمانِ",139,"ن",1,0],["إِن ذا اللُؤمِ اِذا أَكرَمتَهُ","حَسب الإِكرامِ حقاً لزمك",140,"ك",1,0],["إن ذا اليوم عيد كل محب","عربي ينساب من قحطان",141,"ن",1,0],["أنذرت دهرا وأغفت حقبا","ثم هبت في صياح المنذرين",142,"ن",1,0],["ان ذاك الدعاءَ طال ولكن","رحم اللَه شعبه فاستجابا",143,"ب",2,0],["أنذرت عاشقيه آيات عشق","وضحت بالدلال منها الدلاله",144,"ل",2,0],["أنذرته المكر فقال لا تقل","هذا الذي قلت فما تغني النذر",145,"ر",1,0],["إنّ ذا الهو المقا","م الذي يبهره",146,"ر",2,0],["ان ذاك الا قول مخلوق وهل","هو جبريل أو الرسول فذان",147,"ن",1,0],["إن ذاق قيسٌ من هَوى ليلى الرّدى","إني كذَاك أخوه في الإسلامِ",148,"م",1,0],["أَنذر الدَهر بَنيه فَإِذا","غَفَلوا لَيسَ عَلَيهُم مِن أَسَف",149,"ف",1,0],["إِنَّ ذاكَ القَفر مَع تِلكَ الرِياض","وَغَدير الماءِ هَذا وَالتُراب",150,"ب",1,0],["إِنَّ ذاكَ القَديمَ كانَ جَديداً","وَسَيَغدوا هَذا الجَديدُ قَديما",151,"م",2,0],["إِنَّ ذَوي الطِّبِّ لا أَقولُ بما","لا يعلم ربي خلافَه فسَقَه",152,"ق",2,0],["إِنَّ ذِكرَ السِّياقِ أَصلحَك الل","هُ وذكر المَبيت في اللَّحدِ وحدي",153,"د",2,1],["إن ذوت زهرة أيامي الألى","وعليها الدهر قد جر سرايا",154,"ا",3,0],["إِنَّ ذا العيدَ فيهِ غابَت نُضارُ","وَأَخوها فَما لِقَلبي قَرارُ",155,"ر",1,1],["إِنَّ ذا الأَمْرَ فيكُم فَخُذوهُ","ثُمَّ قُودوا إِلى النَّجاةِ وَسوقُوا",156,"ق",3,0],["إن ذوى غصنه وعز جناه","فسنجني سواه غصنا رطيبا",157,"ب",2,0],["إنْ ذُكِرَ العَبْدُ فلا بُدَّ للْ","كَحّالِ في الدستورِ من تَذكرَه",158,"ه",1,0],["إن ذا الوكر كان قبل لطيري","ن محل الهنا وبيت السرور",159,"ر",1,0],["إن ذا شاعر الملوك تبدي","في ملوك عاشوا أسارى الجمود",160,"د",1,0],["ان ذا عصر ذرة قد أعدت","لانفكاك فلا تعيشوا الخيالا",161,"ل",2,0],["إن ذا صنع حفنة من ذئاب","وفئات هجينة الأصلاب",162,"ب",1,0],["أنذرى أن قد أغراني العذولُ","وهيّجني إليك بما يقول",163,"ل",1,1],["إن ذا الناظر المعيب وحاشا","ك يخال العتاب بعض السباب",164,"ب",1,0],["ان ذكر وشكوره يعني الزمان ولا","يعني وذي سنّة أسرت به الفصلا",165,"ا",1,0],["انذرتكم باس الأسود فلم يكن","ليغض فضل عنانه المغرور",166,"ر",1,0],["أنذرت من صاحب أضحى يؤَنبني","ان بحت باسم التي بالهجر تجزيني",167,"ن",2,1],["انذكر الفقر والبلوى التي نزلت","ام الخنوع وما في الرأي من خطل",168,"ل",1,0],["أنذرتُ مدحك لو لم ترتكب شططا","في أخرياتك من حين إلى حين",169,"ن",1,0],["إن ذكَرَ اسْمِي لَذَّ لي ذِكْرُه","كأنني قبَّلتُ بالوَهْمِ فَاهْ",170,"ا",2,0],["إن ذا السلطانَ فينا رحمةٌ","فاشكروا المولى جميعاً واسمعوا",171,"ع",3,0],["إن ذكرى المفقود تحرق قلبي","كيف قلبي ولم تزل مشهودا",172,"د",2,0],["إِنَّ ذا من كَسَلٍ نامَ وَذا","قامَ يشأى عزمه السَيف مضاءَ",173,"ا",2,0],["إن ذيَّل الحبُّ حبلَ الوصل منهُ بلا","فصلِ لحقتُ بنيل الجود والكرمِ",174,"م",1,0],["أنذرتهم وقايع الدهر فيهم","ناطقات لهم بكل لسان",175,"ن",1,0],["ان ذنبا قد حاد بي عن لقاه","لجديرٌ بالشوم عن كل ذام",176,"م",1,0],["انَّ ذا الدهرَ لم يَدُم","لأمرِئٍ قَطُّ من قِدَم",177,"م",1,0],["إِن ذا أَقصى مرامي والسلام","واخمِدي شَرَّ العِدى أهلِ الوَغَر",178,"ر",1,0],["إن ذا راحتي ورُوحي وراحي","ومِراحي ثُمَّ ارتِياحي المُرِيحُ",179,"ح",1,0],["أنذرت ذاتي وقف حب كمالها","وجمالها أمسي ويومي بل غدا",180,"د",2,0],["إِنَّ ذَنبي قَضَى عليَّ فِراقاً","ليتَ شِعري متى يكونُ التلاقي",181,"ق",2,0],["إن ذاد غيركم العدا","فرداً فلا كان الذياد",182,"د",1,0],["إن ذكر البعاد يعدم لما","يوجد الملتقى ويدنو الحبيب",183,"ب",1,0],["إن ذكر الحبيب فيه السرورُ","ترك ذكر الحبيب فيه الغرورُ",184,"ر",1,1],["إن ذنوبي ربّنا هي العيوب","وإنّني مستغفرٌ من الذنوبْ",185,"ب",1,1],["إن ذنوبي لا لها سوى الغفورْ","يغفرها من عملٍ مدى الدهورْ",186,"ر",1,1],["أنذَر أي علمت واستعددت","وعُمت في الماءِ إذا سبحت",187,"ت",1,0],["انذوق الزلال في كاس بلو","ر وَذاكَ الفَتى يَذوق حَميما",188,"م",2,0],["ان ذبت ما بين حوى وحزن","العشق ديني والغرام فنى",189,"ن",2,0],["إِن ذُبتُ فمن سَواد وَجهي خَجَلاً","إِذ قَرَّ بحُرقَتي عُيونُ الجَمعِ",190,"ع",1,0],["أنذرتني بصحيفة مسودّة","أَنزلتها في لَيلة الهجران",191,"ن",1,0],["إن ذا شرع الهوى لا تسأَلوا","وَبهِ الفتوى إذا المفتى سُئِل",192,"ل",1,0],["إن ذاقها قُل أرخوا ميتٌ جرى","منها جعلنا كل شيءٍ حيّا",193,"ي",2,0],["إن ذَيَّلَ النظم بالنثر استفدت به","منثورَ سحبان في منظوم بشَّار",194,"ر",1,0],["إِن ذُكِرَت مُدنُ الدني فهي التي","يختتمُ الفَخرُ بها وَيُبتَدا",195,"ا",1,0],["إن ذهبَ العقلُ بها مُسارعاً","فالهمُّ آلى مُسرعاً أن يَذهبا",196,"ب",2,0],["إن ذا العرش تعالى","يهزم الحزاب وحدَهْ",197,"ه",1,0],["إن ذا الدار آخرها فنا","كل ما فيها يصير للعدم",198,"م",1,0],["إن ذا الحرص لا يخلو الضرر","عنه والهم في طور السنين",198,"ن",1,0],["إن ذا الجد من حبوت بود","ليس من لا تود بالمجدود",199,"د",1,0],["إن ذا الاقتران خير قران","طالع السعد قد أجاد اختياره",200,"ر",2,0],["إن ذكراك لروحي راحة","وسرور ناعش قلبي الحزين",201,"ن",1,0],["إن ذا تقدير باريك الذي","صوِّر الأشياء خلقاً وبرا",202,"ا",1,0],["إِنْ ذَكَرْتُ الْهِيفَاءَ مِنْ بَعْدِ حُزْن ٍ","يَنْجَلِي الْحُزْنُ لا يَطُولُ الْعَنَاءُ",203,"ا",2,0],["أن ذا الأطماع بين الدور يسعى","ينصب الآن بلا خوف كمينه",204,"ن",2,0],["إن ذا العقل في الزوايا سجين","ليس ترضى به عقول الرَّعاع",205,"ع",1,0],["ان ذاب عمر ٍ للرجا بعتق الايام","من ماحل الياس الحويل يتكون",206,"ن",1,0],["إنّ ذاك الماءَ ماءٌ آسنٌ","وُضِعَتْ فيهِ ذواتُ الذّنبِ",207,"ب",1,0],["أنذرتهم لكنهم قد آثروا","الأهواء وارتابوا بأمر مستقر",208,"ر",1,0],["إنْ ذابَ يأسٌ في مواجعنا","رغمَ الأسى أسقيتهُ صبْرا",209,"ر",2,0],["أَنْذَرُوا الْعُرْبَ وَمَا هَابُوا الْأَسَى","لِيُمِيطُوا التُّرْبَ عَنْ دُرٍّ هِجَانِ",210,"ن",1,0],["إن ذا البطش جل لا يفل","ت الظالم من قهره ولا من وقاء",211,"ا",2,0],["إن ذكرت الأضلاع خلت الزوايا","والذي منه أفهم الأرباعا",212,"ع",2,0],["أَنْذِرْ بِهِ مَنْ كَانَ أَعْمَى ، لَا يَرَى","مَنْ كَانَ فِي سِرْدَابِ جَهْلٍ يَقْبَعُ",213,"ع",1,0],["انذار يااستعمار","ويا عصبه الاشرار",214,"ر",1,1],["انذار لكم وقدر","مالكمش منه فرار",214,"ر",1,0],["إنْ ذابَ فيكَ كَما الشموعِ بأضْلُعي","لاتسألِ القلبَ الجَريحَ لماذا...",215,"ذ",2,0],["إِنْ ذَمَّهُ حَرْفي بَتَرْتُ أَنامِلي","فَهْوَ الحَبيبُ أَخَانَ وِدِّيَ أَمْ وَفى",216,"ف",2,0],["إن ذا النعمة الذير يزكي","لجماد موكل بجماد",217,"د",1,0],["إن ذكرت الخليل نوهت الافاق","في الشرق بالديب العليم",218,"م",1,0],["أنذرتُهم مِن قبلِ ذلك فارْتَأَوْا","سفَهًا، وجلَّ الخَطبُ مِن إنكارِها",219,"ر",3,0],["إنَّ ذَوْدًا عنِ القريضِ لَفرضٌ","راسخٌ كالصيامِ أو كالصلاةِ",220,"ه",1,0],["أ نَذِلُّ من بردٍ وفينا جمرةٌ","من حبنا تومي لنا أن نأبى",221,"ب",2,0],["أن ذاع صيتهم فهم","بضمير هذا الدهر سر",222,"ر",1,0],["إن ذعذع الشعب للطغاة","فأنت أجدر في بنائه",223,"ا",3,0],["إنْ ذلَّ أهلُ الذلِّ قلنا عادةٌ","لكنْ لدى المَعزوز كيفَ تُطاقُ؟",224,"ق",1,0],["إِن ذوملت بالدوح وَتبين الخَلا","عَالظاهري تسهي كَما الشيهان",225,"ن",1,0],["إِنَّ ذاكَ الضِّياءَ غايتُنا العَليا","فَرُدُّوا السُّيوفَ لِلأغمادِ",226,"د",1,0],["إنْ ذَوَى غُصْنُ نِعْمتي فَرُوَيدا","فَعَسَى أَنْ تنوبَ نضرة ُ عودِي",227,"د",2,0]]}