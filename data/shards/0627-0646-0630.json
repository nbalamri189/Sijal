70,"لي حبيب لايسمى","https://www.aldiwan.net/poem42910.html","مجزوء الرمل"],[92,"لست أبكي لعسف ليل طويل","https://www.aldiwan.net/poem38894.html","الخفيف"],[89,"خمسة طاروا من عيون الشباب","https://www.aldiwan.net/poem44625.html","الخفيف"],[89,"ما الشعر الا نغم","https://www.aldiwan.net/poem44737.html","مجزوء الرجز"],[89,"قد طغى يطفح الفرات وعبا","https://www.aldiwan.net/poem44917.html","الخفيف"],[85,"أيامكم أم عهد إسماعيلا","https://www.aldiwan.net/poem63755.html","الكامل"],[45,"أما معين على الشوق الذي غريت","https://www.aldiwan.net/poem63500.html","البسيط"],[45,"لا دمنة بلوى خبت ولا طلل","https://www.aldiwan.net/poem65579.html","البسيط"],[61,"أما الخيال فما يغب طروقا","https://www.aldiwan.net/poem51534.html","الكامل"],[49,"إن ذا الموت ما عليه مجير","https://www.aldiwan.net/poem62069.html","الخفيف"],[49,"اهرب بنفسك من دنيا مضللة","https://www.aldiwan.net/poem63073.html","البسيط"],[66,"عانده في الحب أعوانه","https://www.aldiwan.net/poem40966.html","السريع"],[97,"تحت عين الصباح والأنوار","https://www.aldiwan.net/poem24747.html","الخفيف"],[44,"من بنو عامر من ابن الحباب","https://www.aldiwan.net/poem30069.html","الخفيف"],[105,"يا بريد النيل إن جئت الشآما","https://www.aldiwan.net/poem42115.html","الرمل"],[105,"أنذر الأقوام لو تغني النذر","https://www.aldiwan.net/poem43084.html","الرمل"],[105,"مضى الرأي حتى ما لنا متردد","https://www.aldiwan.net/poem43135.html","الطويل"],[105,"هل الحرب إلا أن تطير الجماجم","https://www.aldiwan.net/poem43156.html","الطويل"],[102,"أنا ساعة الرجل الصبور","https://www.aldiwan.net/poem33054.html","مجزوء الكامل"],[75,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[48,"اسقنيها يا نديمي بغلس","https://www.aldiwan.net/poem63436.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/86022","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202539","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42666","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54755","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54621","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[45,"أمَا مُعِينٌ على الشّوقِ الذي غَرِيَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=31603",""],[92,"لَسْتُ أبْكي لِعَسْفِ لَيْلٍ طَويلٍ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14563&r=&rc=9",""]],"verses":[["إِنَّ ذُلّي بِذَلِكَ الجَوِّ عِزٌّ","وَأُوامي بِذَلِكَ النَقعِ رَيُّ",0,"ي",1,0],["أَنذَرَنا الدَهرُ وَما نَرعَوي","كَأَنَّما الدَهرُ سِوانا عَنى",1,"ن",2,0],["إِنَّ ذَنبي إِلى الغَواني بِشَيبي","ذَنبُ ذِئبِ الغَضا إِلى الآرامِ",2,"م",1,0],["إِن ذُبتَ مِن كَمَدٍ فَقَد جَرَّ الهَوى","هَذا السَقامَ عَلَيَّ مِن جَرّاكا",3,"ك",2,0],["أَنذَرَهُم مِنهُ وَعَن","دَ القَومِ أَضعافُ الخَبَر",4,"ر",1,0],["إنّ ذكراك ورائي وعلى","وجهتي حيث مجيئي وذهابي",5,"ي",1,0],["أَنْذَرْتَ قَبْلَ النُّضْجِ لَمَّا جِئْتَهَا","مَلِكاً وَكَانَ الْبُرْءُ فِي البُحْرَانِ",6,"ن",1,0],["أنذَرَ المُنْذِرُ الأنامَ بجَدْوا","هُ وسَحّ النُّعْمانُ نُعْمى عَتادِ",7,"د",1,0],["إنْ ذُكِرَ المَحْبوبُ سالَتْ دَماً","ما هُنَّ أكْبادٌ ولكِنْ جُروحْ",8,"ح",1,0],["أَنذَرتُ أَعدائي غَدا","ةَ قَناً حُدَيّا الناسِ طُرّا",9,"ر",2,1],["إِنْ ذَكَرْتُ الخَلِيلِ نَوَّهَتِ الآ","فَاقَ فِي الشَّرْقِ بِالأَدِيبِ العَلِيمِ",10,"م",1,0],["أنذِلّ للمستعمرين وعندنا","جيش إذا خاض المعارك ما انثنى",11,"ن",2,0],["إِنَّ ذاكَ الصُدودَ مِن غَيرِ جُرمٍ","لَم يَدَع فِيَّ مَطمَعاً بِالوِصالِ",12,"ل",1,0],["أنذرْتُ بل بشَّرْتُ أنَّ مقالتي","ميعادُ جِدٍّ في وعيد مُزَاحِ",13,"ح",1,0],["أنْذَرْتُ من في دراه مَطْبخٌ","ضَرْطَةَ إبراهيمَ من فرسخِ",14,"خ",1,0],["أنذر في البخل معشرٌ مُنُعٌ","وفي السماح الغريبِ إنذاره",15,"ر",2,0],["إنّ ذكرَ الحميد غيرُ حميدٍ","حين يعرُوك رائداً في ارتماض",16,"ض",1,0],["أنذرتُ نبلي أنها إن أُرسلتْ","لم تُبقِ باقيةً من الأعراض",17,"ض",1,0],["أنذرت حرب الهجاء ملقِحَها","فما لها غيرَ حتفه ربع",18,"ع",1,0],["إن ذا من ورد خدَّي","كِ لِصبَّاغٍ رفيقِ",19,"ق",1,0],["إن ذاك الكمالَ فيك غريمٌ","يتقاضاك في الأيادي الكمالا",20,"ل",2,0],["أنذرتكم قبل الخسو","فِ بما ترون من الزلازلْ",21,"ل",1,0],["أنذرني دِقْلِشٌ بنادرةٍ","معدودة من نوادرِ الكَلمِ",22,"م",1,1],["إِنَّ ذا المُلكَ هَيكَلٌ نَحنُ فيهِ ال","قَلبُ وَالقَلبُ سَيِّدُ الأَعضاءِ",23,"ا",2,0],["إِنَّ ذا يَومٌ سَعيدٌ","بِكَ يا قُرَّةَ عَيني",24,"ي",1,1],["إِنَّ ذَنبَ الغَدرِ في الحُب","بِ لَذَنبٌ لا يُكَفَّر",25,"ر",1,0],["إنَّ ذا عَصْرُ ظُلْمَةٍ غَيْرَ أنِّي","مِنْ وراءِ الظَّلامِ سِمْتُ صَبَاحَهْ",26,"ح",2,0],["ان ذاك الصعود في الجو منهم","كان للمجد والعلا والغلاب",27,"ب",1,0],["ان ذكر الآداب","فهو وحده المقدم",28,"م",1,0],["ان ذاك الذي حسبناه نهراً ضيقاً","امسى اليوم كالبحر رحبا",29,"ب",2,0],["أَنذَرتَنا رِقّاً يَدومُ وَذِلَّةً","تَبقى رِحالاً لا تَرى تَحويلا",30,"ل",2,0],["إِن ذُمَّ لَم يَجِدِ الدُنيا لَهُ عِوَضاً","وَلا يُبالي الَّذي خَلّا إِذا حُمِدا",31,"د",2,0],["أَنذَرتُكُم عارِضاً تَدمى مَخايِلُهُ","القَطرَةُ الفَذُّ مِنهُ عارِضٌ هَطِلُ",32,"ل",1,0],["أنذرتُكُم حامي الحَقيقَةِ لا يَرى","إلا لِمُرْهَفَةِ السُّيوفِ حُقوقا",33,"ق",2,0],["إِنَّ ذا المَوتَ ما عَلَيهِ مُجيرُ","يَهلِكُ المُستَجارُ وَالمُستَجيرُ",34,"ر",1,1],["إِن ذُقتُ حَلواءَها عادَت عَواقِبُها","مَرارَةً يَجتَويها كُلُّ مَن أَكَلا",35,"ل",2,0],["إِن ذُكِرَ العِلمُ فَنُعمانُهُ","أَو ذُكِرَ الحُكمُ فَلُقمانُه",36,"ن",2,0],["إنَّ ذاك الفتى الوديعَ الطهورَ ال","قلب في رقة النسيم الساري",37,"ر",2,0],["إِنَّ ذَمّي مُحَمَّدَ بنَ يَزيدٍ","في الَّذي نالَهُ لَغَيرُ صَوابِ",38,"ب",1,0],["إن ذكرتم دولةَ الضادِ فلا","تَنْسَوُا التّاجَ ولا الشّيخَ الإِماما",39,"م",2,0],["أَنذِرِ الأَقوامَ لَو تُغني النُذُرْ","وَاِبعَثِ النُوَّامَ مِن خَلفِ السُتُرْ",40,"ر",1,1],["أَنُذعِنُ لِلحُكمَينِ أَمّا الَّذي لَهُم","فَجَمٌّ وَأَمّا ما لَنا فَمُصَرَّدُ",41,"د",1,0],["أَنُذعِنُ لِلباغي وَنُعطيهِ حُكمَهُ","وَفي التُركِ مِقدامٌ وَفي العُربِ حازِمُ",42,"م",1,0],["أْنذرتُ أعداءَ البلادِ","بشرِّ يومٍ مُستطير",43,"ر",1,0],["إنّ ذُلَّ العزيزِ أفظعُ مَرْأىً","بين عينيْهِ من لقاء الحُتوفِ",44,"ف",1,0],["إِنَّ ذِكراهُ عَلى هِجرانِهِ","لَتُجَلّي كَربَ قَلبٍ مُختَلَس",45,"س",1,0],["ان ذاك الشباب ما كان يوما","عهده بعد ان مضى منسيا",46,"ي",2,0],["إن ذاكَ الكرسي بين الدراري","يِ لرب للعزة القعساء",47,"ا",2,0],["إن ذكر الآباء جاءا بالقمر","جدّا تمناه العتيق وعمر",48,"ر",1,0],["إِنَّ ذَا الْحَاجَةِ مَا لَمْ يَغْتَرِبْ","عَنْ حِماهُ مِثْلُ طَيْر في قَفَصْ",49,"ص",1,0],["إِنْ ذَاكَ إِلاَّ العَهْدُ فِي تَابُوتهِ","عَهْدُ القَدِيرِ لِشَعْبِهِ الْمُخْتَارِ",50,"ر",1,0],["إِنْ ذَا النِّعْمَةِ الذِي لاَ يُزَكِّي","لِجَمَادٍ مَوَكَّلٌ بِجَمَادِ",51,"د",1,0],["إِنَّ ذاكَ الَّذِي تُعَزَّوْنَ فِيهِ","لَيُعَزَّى فِيهِ التُّقَى وَالخَيرُ",52,"ر",1,0],["إِنْ ذَكَرْنَا أَسْمَاءَهُمْ يَوْمَ فَخْرٍ","طَابَ فِي النَّابِغِينَ ذِكْرُ نَجِيبْ",53,"ب",1,0],["إن ذَلَّ فجيْشُك ينْصرُهُ","أو ضَلَّ فرأْيُكَ يُرْشِدهُ",54,"د",2,0],["إنْ ذَكَرْناكَ هَزَّنا الشَّوْق للشَّوْ","قِ وَلَهْوِ اللِّدّاتِ وَالأَترَاب",55,"ب",1,0],["إنَّ ذكرى الزَّفافِ أسعدُ ذكرَى","تملأُ النَّفْسَ من مُنىً وارتياح",56,"ح",1,0],["إن ذلك الوَداعَ كان نذيراً","بحِمامٍ دلَّتْ عليه عَلائِم",57,"م",1,0],["إن ذم لم يجد الدنيا له عوضا","ولا يبالي الذي خلى إذا حمدا",58,"د",2,0],["إنَّ ذا عَصْرُ ظُلْمَة ٍ غَيْرَ أنِّي","مِنْ وَرَاءِ الظَّلاَمِ شِمْتُ صَبَاحَهْ",59,"ح",2,0]]}