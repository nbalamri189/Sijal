net/poem55315.html","مجزوء الخفيف"],[362,"إن ذنبي والله ذنب كبير","https://www.aldiwan.net/poem68107.html","الخفيف"],[362,"ان وجدي كل يوم في ازدياد","https://www.aldiwan.net/poem68123.html","الرمل"],[367,"عد العتاب فما أعدت عتابا","https://www.aldiwan.net/poem17313.html","الكامل"],[392,"يا مريدين السعاده والتعلم والعباده","https://www.aldiwan.net/poem54447.html","عموديه"],[392,"زينة العلم العمل","https://www.aldiwan.net/poem54511.html","عموديه"],[392,"طلب الراحة في الدنيا محال","https://www.aldiwan.net/poem54543.html","عموديه"],[394,"رشأ غدا وجدي عليه كردفه","https://www.aldiwan.net/poem53532.html","الكامل"],[401,"أيها القانون","https://www.aldiwan.net/poem6781.html","عموديه"],[404,"الحمامة إن أثارت بالهديل","https://www.aldiwan.net/poem32903.html","الرمل"],[404,"غصن شوق علاه قلبي وغرد","https://www.aldiwan.net/poem33977.html","الخفيف"],[404,"هل جرى مني لذا الهجر ذنوب","https://www.aldiwan.net/poem34159.html","الرمل"],[417,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[430,"إن ذا الخط كساه رونقا","https://www.aldiwan.net/poem41422.html","الرمل"],[450,"يئس الصغار من الكبار","https://www.aldiwan.net/poem995.html",""],[459,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[459,"أنذرتني أم سعد أن سعدا","https://www.aldiwan.net/poem56214.html","الرمل"],[462,"علقته والصبا غض الأديم","https://www.aldiwan.net/poem15087.html","الرمل"],[501,"كل وقت له من القوم شيخ","https://www.aldiwan.net/poem37749.html","الخفيف"],[504,"كل شيء سوى الإمام صغير","https://www.aldiwan.net/poem21726.html","الخفيف"],[506,"العار","https://www.aldiwan.net/poem42463.html","البسيط"],[528,"إن ذا البلعمي والعين غين","https://www.aldiwan.net/poem46021.html","الخفيف"],[530,"الذي لاح وهو فصل الخطاب","https://www.aldiwan.net/poem37532.html","الخفيف"],[539,"إن ذا فصل الخطاب","https://www.aldiwan.net/poem47458.html","عموديه"],[539,"إن ذا رسم عجيب","https://www.aldiwan.net/poem47604.html","عموديه"],[539,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[539,"أيها الصبيان مهلا","https://www.aldiwan.net/poem47996.html","عموديه"],[539,"صلى على محمد ربه","https://www.aldiwan.net/poem48276.html","عموديه"],[541,"أرقتني تلومني أم بكر","https://www.aldiwan.net/poem56642.html","الخفيف"],[559,"يا راحم الشيب في شيبه","https://www.aldiwan.net/poem33524.html","السريع"],[559,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[559,"إن ذلي في حب علوة عز","https://www.aldiwan.net/poem34457.html","الخفيف"],[559,"أول منامك هذا","https://www.aldiwan.net/poem34557.html","المجتث"],[563,"بين قلب المحب والأحداق","https://www.aldiwan.net/poem52949.html","الخفيف"],[568,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"]],"verses":[["إِنَّ ذُلّي بِذَلِكَ الجَوِّ عِزٌّ","وَأُوامي بِذَلِكَ النَقعِ رَيُّ",0,"ي",1,0],["أَنذَرَنا الدَهرُ وَما نَرعَوي","كَأَنَّما الدَهرُ سِوانا عَنى",1,"ن",2,0],["إِنَّ ذَنبي إِلى الغَواني بِشَيبي","ذَنبُ ذِئبِ الغَضا إِلى الآرامِ",2,"م",1,0],["إِن ذُبتَ مِن كَمَدٍ فَقَد جَرَّ الهَوى","هَذا السَقامَ عَلَيَّ مِن جَرّاكا",3,"ك",2,0],["أَنذَرَهُم مِنهُ وَعَن","دَ القَومِ أَضعافُ الخَبَر",4,"ر",1,0],["إنّ ذكراك ورائي وعلى","وجهتي حيث مجيئي وذهابي",5,"ب",2,0],["أَنْذَرْتَ قَبْلَ النُّضْجِ لَمَّا جِئْتَهَا","مَلِكاً وَكَانَ الْبُرْءُ فِي البُحْرَانِ",6,"ن",1,0],["أنذَرَ المُنْذِرُ الأنامَ بجَدْوا","هُ وسَحّ النُّعْمانُ نُعْمى عَتادِ",7,"د",1,0],["إنْ ذُكِرَ المَحْبوبُ سالَتْ دَماً","ما هُنَّ أكْبادٌ ولكِنْ جُروحْ",8,"ح",1,0],["أَنذَرتُ أَعدائي غَدا","ةَ قَناً حُدَيّا الناسِ طُرّا",9,"ر",2,1],["إِنْ ذَكَرْتُ الخَلِيلِ نَوَّهَتِ الآ","فَاقَ فِي الشَّرْقِ بِالأَدِيبِ العَلِيمِ",10,"م",1,0],["أنذِلّ للمستعمرين وعندنا","جيش إذا خاض المعارك ما انثنى",11,"ن",2,0],["إِنَّ ذاكَ الصُدودَ مِن غَيرِ جُرمٍ","لَم يَدَع فِيَّ مَطمَعاً بِالوِصالِ",12,"ل",1,0],["أنذرْتُ بل بشَّرْتُ أنَّ مقالتي","ميعادُ جِدٍّ في وعيد مُزَاحِ",13,"ح",1,0],["أنْذَرْتُ من في دراه مَطْبخٌ","ضَرْطَةَ إبراهيمَ من فرسخِ",14,"خ",1,0],["أنذر في البخل معشرٌ مُنُعٌ","وفي السماح الغريبِ إنذاره",15,"ر",2,0],["إنّ ذكرَ الحميد غيرُ حميدٍ","حين يعرُوك رائداً في ارتماض",16,"ض",1,0],["أنذرتُ نبلي أنها إن أُرسلتْ","لم تُبقِ باقيةً من الأعراض",17,"ض",1,0],["أنذرت حرب الهجاء ملقِحَها","فما لها غيرَ حتفه ربع",18,"ع",1,0],["إن ذا من ورد خدَّي","كِ لِصبَّاغٍ رفيقِ",19,"ق",1,0],["إن ذاك الكمالَ فيك غريمٌ","يتقاضاك في الأيادي الكمالا",20,"ل",2,0],["أنذرتكم قبل الخسو","فِ بما ترون من الزلازلْ",21,"ل",1,0],["أنذرني دِقْلِشٌ بنادرةٍ","معدودة من نوادرِ الكَلمِ",22,"م",1,1],["إِنَّ ذا المُلكَ هَيكَلٌ نَحنُ فيهِ ال","قَلبُ وَالقَلبُ سَيِّدُ الأَعضاءِ",23,"ا",2,0],["إِنَّ ذا يَومٌ سَعيدٌ","بِكَ يا قُرَّةَ عَيني",24,"ي",1,1],["إِنَّ ذَنبَ الغَدرِ في الحُب","بِ لَذَنبٌ لا يُكَفَّر",25,"ر",1,0],["إنَّ ذا عَصْرُ ظُلْمَةٍ غَيْرَ أنِّي","مِنْ وراءِ الظَّلامِ سِمْتُ صَبَاحَهْ",26,"ح",2,0],["ان ذاك الصعود في الجو منهم","كان للمجد والعلا والغلاب",27,"ب",1,0],["ان ذكر الآداب","فهو وحده المقدم",28,"م",1,0],["ان ذاك الذي حسبناه نهراً ضيقاً","امسى اليوم كالبحر رحبا",29,"ب",2,0],["أَنذَرتَنا رِقّاً يَدومُ وَذِلَّةً","تَبقى رِحالاً لا تَرى تَحويلا",30,"ل",2,0],["إِن ذُمَّ لَم يَجِدِ الدُنيا لَهُ عِوَضاً","وَلا يُبالي الَّذي خَلّا إِذا حُمِدا",31,"د",2,0],["أَنذَرتُكُم عارِضاً تَدمى مَخايِلُهُ","القَطرَةُ الفَذُّ مِنهُ عارِضٌ هَطِلُ",32,"ل",1,0],["أنذرتُكُم حامي الحَقيقَةِ لا يَرى","إلا لِمُرْهَفَةِ السُّيوفِ حُقوقا",33,"ق",2,0],["إِنَّ ذا المَوتَ ما عَلَيهِ مُجيرُ","يَهلِكُ المُستَجارُ وَالمُستَجيرُ",34,"ر",1,1],["إِن ذُقتُ حَلواءَها عادَت عَواقِبُها","مَرارَةً يَجتَويها كُلُّ مَن أَكَلا",35,"ل",2,0],["إِن ذُكِرَ العِلمُ فَنُعمانُهُ","أَو ذُكِرَ الحُكمُ فَلُقمانُه",36,"ن",2,0],["إنَّ ذاك الفتى الوديعَ الطهورَ ال","قلب في رقة النسيم الساري",37,"ر",2,0],["إِنَّ ذَمّي مُحَمَّدَ بنَ يَزيدٍ","في الَّذي نالَهُ لَغَيرُ صَوابِ",38,"ب",1,0],["إن ذكرتم دولةَ الضادِ فلا","تَنْسَوُا التّاجَ ولا الشّيخَ الإِماما",39,"م",2,0],["أَنذِرِ الأَقوامَ لَو تُغني النُذُرْ","وَاِبعَثِ النُوَّامَ مِن خَلفِ السُتُرْ",40,"ر",1,1],["أَنُذعِنُ لِلحُكمَينِ أَمّا الَّذي لَهُم","فَجَمٌّ وَأَمّا ما لَنا فَمُصَرَّدُ",41,"د",1,0],["أَنُذعِنُ لِلباغي وَنُعطيهِ حُكمَهُ","وَفي التُركِ مِقدامٌ وَفي العُربِ حازِمُ",42,"م",1,0],["أْنذرتُ أعداءَ البلادِ","بشرِّ يومٍ مُستطير",43,"ر",1,0],["إنّ ذُلَّ العزيزِ أفظعُ مَرْأىً","بين عينيْهِ من لقاء الحُتوفِ",44,"ف",1,0],["إِنَّ ذِكراهُ عَلى هِجرانِهِ","لَتُجَلّي كَربَ قَلبٍ مُختَلَس",45,"س",1,0],["ان ذاك الشباب ما كان يوما","عهده بعد ان مضى منسيا",46,"ي",2,0],["إن ذاكَ الكرسي بين الدراري","يِ لرب للعزة القعساء",47,"ا",2,0],["إن ذكر الآباء جاءا بالقمر","جدّا تمناه العتيق وعمر",48,"ر",1,0],["إِنَّ ذَا الْحَاجَةِ مَا لَمْ يَغْتَرِبْ","عَنْ حِماهُ مِثْلُ طَيْر في قَفَصْ",49,"ص",1,0],["إِنْ ذَاكَ إِلاَّ العَهْدُ فِي تَابُوتهِ","عَهْدُ القَدِيرِ لِشَعْبِهِ الْمُخْتَارِ",50,"ر",1,0],["إِنْ ذَا النِّعْمَةِ الذِي لاَ يُزَكِّي","لِجَمَادٍ مَوَكَّلٌ بِجَمَادِ",51,"د",1,0],["إِنَّ ذاكَ الَّذِي تُعَزَّوْنَ فِيهِ","لَيُعَزَّى فِيهِ التُّقَى وَالخَيرُ",52,"ر",1,0],["إِنْ ذَكَرْنَا أَسْمَاءَهُمْ يَوْمَ فَخْرٍ","طَابَ فِي النَّابِغِينَ ذِكْرُ نَجِيبْ",53,"ب",1,0],["إن ذَلَّ فجيْشُك ينْصرُهُ","أو ضَلَّ فرأْيُكَ يُرْشِدهُ",54,"د",2,0],["إنْ ذَكَرْناكَ هَزَّنا الشَّوْق للشَّوْ","قِ وَلَهْوِ اللِّدّاتِ وَالأَترَاب",55,"ب",1,0],["إنَّ ذكرى الزَّفافِ أسعدُ ذكرَى","تملأُ النَّفْسَ من مُنىً وارتياح",56,"ح",1,0],["إن ذلك الوَداعَ كان نذيراً","بحِمامٍ دلَّتْ عليه عَلائِم",57,"م",1,0],["إن ذم لم يجد الدنيا له عوضا","ولا يبالي الذي خلى إذا حمدا",58,"د",2,0],["إنّ ذا هيكل نحن فيه القلب","والقلب سيّد الأعضاء",59,"ا",2,0],["إنَّ ذا عَصْرُ ظُلْمَة ٍ غَيْرَ أنِّي","مِنْ وَرَاءِ الظَّلاَمِ شِمْتُ صَبَاحَهْ",60,"ح",2,0],["إِن ذكر الكِرام ذكر جَميل","لَيسَ يُبلى وَكُل شَيءِ بالي",61,"ل",2,0],["إن ذنبي مثلُ تعدادِ الرمالْ","ليس يحصى أو كأمثالِ الجبالْ",62,"ل",1,0],["إن ذنبي مُوبقٌ أثْقَلني","إنَّني أرجوكَ أنْ ترحَمني",62,"ي",1,0],["إنّ ذاك الثرى لَيُنبتُ شوقا","في حشَا ميِّت اللُّباناتِ صَلدِ",63,"د",1,0],["إِن ذَمَّ سائِرَ مَن يَراهُ فَإِنَّهُ","يُثني عَلَيكَ وَلا يَكِلُّ لِسانُهُ",64,"ن",2,0],["أنذرتهم يوما رأوا أمثاله","في غيرهم لو كان فيهم مبصر",65,"ر",1,0],["إن ذكرَ الذينَ شادوا وسادوا","لم يزلْ راسخاً معِ الأطوادِ",66,"د",1,0],["إن ذا الحبَّ غادرني","ليسَ في العيشِ من أربِ",67,"ب",1,0],["إن ذكراك كالدواء لذيذ الطعم","يشفي من سقم بعد عراني",68,"ن",2,0],["إنّ ذا اليوم إذ شربتَ دواءً","فيه يومٌ من أفضل الأيّامِ",69,"م",1,0],["أنذَرتُ ذا مالٍ أسنَّ وشاخا","وإلى المعاصي قد زَجا وأناخا",70,"خ",2,1],["أنْذرْهُمُ بِالبَطْشَة الكُبْرى فقدْ","نذَرت صَوارمُه الرّقاقُ دِماءَها",71,"ا",3,0],["إِنَّ ذا الدَهرِ خَئونٌ لَم يَزَل","مُؤذِناً بَعدَ رِضاعٍ بِفِصالِ",72,"ل",1,0],["إنّ ذا درهمٍ لأفرغُ قلباً","مِن فتى كانَ عندهُ درهمانِ",73,"ن",1,0],["إِنَّ ذا الأَنعامِ أَولانا الأَماني","وَتَوالى حَظُّنا فَوقَ المَرامِ",74,"م",1,0],["ان ذكرى محمد","قرنت بالفجائع",75,"ع",1,0],["ان ذكرى محمد","تليت بالفجائع",75,"ع",1,0],["ان ذكرى محمد","تليت بالروائع",75,"ع",1,0],["إِنَّ ذَنبي وَاللَه ذَنب كَبير","غَير أَني بحلمكم أَستَجير",76,"ر",1,1],["اِن ذَنبي عِند من يعذلني","أَن قَلبي في الهَوى لورَدّ عاد",77,"د",1,0],["أَنذَرتُ مِن خَيلِ القَوافي غارَةً","تَدَعُ القُبورَ وَأَهلَها أَسلابا",78,"ب",2,0],["إن ذكر الله باقي","غير ذكر الله عاده",79,"د",2,0],["إن ذكر الله خير ما اقتنى المرء","ما اقتناه أهل العقول",80,"ل",1,0],["إن ذكر الله للقلب شفا","إن ذكر الله للقلب صقال",81,"ل",1,0],["إن ذكر الله خير ما اقتنى المرء","في الدنيا وما حصل ونال",81,"ل",1,0],["إن ذكر الله أنس دائم","ماله عنك انفصال وارتحال",81,"ل",1,0],["إن ذكر الله نور وهدى","ماله في جملة الخير مثال",81,"ل",1,0],["إِن ذُقتُ خمراً خِلتُها من ريقِه","أَو رمتُ مسكاً نِلتُهُ من نَشرِهِ",82,"ر",2,0],["أنذروا \" المجْدَ \" وهل ينذر مجد","مَنْ يُنادي بهدوءٍ واعتدالِ",83,"ل",1,0],["إن ذه نفسي على خدي تسيل","بعد ما نزت جفوني",84,"ي",1,0],["إن ذهني قد كان يدرك شيئاً","هو واللّه زائف ليس ينقد",85,"د",1,0],["إن ذوى غصن ودادي عندكم","فودادي غصنه غصن رطيب",86,"ب",1,0],["إنْ ذكرنا فضلَ أرباب النَّدى","كنتَ رأس الكل والرَّأس مقدم",87,"م",1,0],["إن ذا الخط كساه رونقا","خط مولانا البشير المرتضى",88,"ض",2,1],["أنذل للدخلاء نفسا حرة","عربية الأنساب والأصهار",89,"ر",1,0],["إن ذاك النسيمَ يجري على أر","ضٍ ثراها في الريح رقيةُ لَسعي",90,"ع",2,0],["أنذرَتْني أمُّ سعدٍ أنَّ سعدا","دونها ينهَدُ لي بالشَّرِّ نَهْدَا",91,"د",2,1],["أن ذا الأعواد مني لأبٌ","باذل الرفد ومناعُ الحريم",92,"م",1,0],["إنَّ ذاكَ الإِنسانَ إنْسانُ عينِ ال","نَّاسِ في العَصْرِ مظهَرُ الإِحسَانِ",93,"ن",1,0],["إنَّ ذا الجَمعَ لاَ يَزَالُ بِخَيرٍ","فِيهِ نُعمَى وَنِعمَةٌ وَسُرورُ",94,"ر",1,0],["أنذرتُك الشامَ وليثاً به نهَمو","يأتي طرائدهُ من حيْث تحتسِبُ",95,"ب",1,0],["أنذرتُك الشامَ إنّ الشامَ تنهزِمو","في جوفِ حلْم رواه قبلك الكذِبُ",95,"ب",1,0],["أنذرتك القدسَ وإنْ خانها الخدَمو","فالشيخُ فيها أسدٌ شبلهُ يثبُ",95,"ب",1,0],["إن ذا البلعمي والعين غيّن","وهوعارٌ على الزمان وشينُ",96,"ن",1,1],["إنَّ ذِكْرَ الإلَه في أَوَّلِ الْمَلْ","حُونِ ثُمّ الرّسُولِ غَيْرُ مُعابِ",97,"ب",1,0],["إنَّ ذا فَصلُ الخطابِ","وكَفيلٌ بِالصَّوابِ",98,"ب",1,1],["إنَّ ذا رسمٌ عَجِيبٌ","رَبُّهُ أعجَبَ مِنهُ",99,"ه",1,1],["إنَ ذا بَيتُ أديبٍ","مولَعٍ بِالشَّعرِ عانِ",100,"ن",1,0],["إنَّ ذا أمرٌ بعيدٌ","عنكمُ قولاً وفِعلا",101,"ل",2,0],["إن ذلَّ حِزبٌ مِن عدُولِه","محمَّدٌ عَزَّ به حِزبُه",102,"ب",2,0],["إِنَّ ذا الجودِ وَالمَكارِمِ إِبرا","هيمَ يَعنيهِ كُلُّ ما يَعنيني",103,"ن",2,0],["إن ذنوبي عظمت كثرة","فأوقعت قلبيَ في ريبه",104,"ب",2,0],["إن ذاك الحمى وذاك المكانا","خطفتني بروقُهُ لمعانا",105,"ن",2,0],["إن ذلي في حب علوة عزُّ","فالطفوا في المنام أو فاستفزوا",106,"ز",3,1],["إن ذقت شيئاً أليماً","أو ذقت فيه لذاذا",107,"ذ",2,0],["إنَّ ذاك القَليلَ غيرُ قليلٍ","من إمام القريضِ عبدِ الباقي",108,"ق",2,0],["إن ذَوَى عُودُ نِعْمَتي فَرُوَيْداً","وَعَسَى أَنْ يَثُوبَ نضرةُ عُودِي",109,"د",2,0]]}