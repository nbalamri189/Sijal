{"poems":[[79,"عجبا لوجد لا يلين شديده","https://www.aldiwan.net/poem36606.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141923","الخفيف"],[310,"عام سبع صفو لسعد الوزير","https://www.aldiwan.net/poem56544.html","الخفيف"],[371,"أي شأن لا يباح به","https://www.aldiwan.net/poem17294.html","المديد"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87272","الرمل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39045","السريع"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95590","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108712","الخفيف"],[5307,"يا خفيف الروح","https://www.poetsgate.com/ViewPoem.aspx?id=25798",""],[5952,"مَايا","https://www.poetsgate.com/ViewPoem.aspx?id=202877",""]],"verses":[["ما زَهْرُ روضِ الغَوْرِ روّضَهُ الحَيا","وحنَتْ عليْهِ بُروقُهُ ورُعودُهُ",0,"د",2,0],["ما زها مفرقٌ بتاجٍ إذا لم","يزهُ بالخالداتِ من تيجانِه",1,"ن",2,0],["ما زَها العام قولُ من أرّخوه","عام سبعِ صفو لسعد الوزيرِ",2,"ر",1,0],["ما زَها مِن قَبلِ مِعطَفِهِ","فَوقَ غُصنِ البانِ بُستانُ",3,"ن",1,0],["ما زَهَت أَنوارُ بَدرِ","وَصَفا وَقتُ البَريهْ",4,"ه",1,0],["ما زَهْرَةُ الدُّنيا سِوى زَهرةٍ","أطْلَعَها الحُسْنُ على غُصْنِ",5,"ن",1,1],["مازهرها إِلا لناشقه وما","أثمارها إِلاّ لذى اللأواءِ",6,"ا",2,0],["ما زهت بالحباب إلّا حسبنا","ها استعارت من الرضاب نثارا",7,"ر",2,0],["ما زهالي وقت لو منتوا","انت سعد القلب واشراقه",8,"ق",2,0],["مازَهَا عنهُنَّ حُسنٌ قد طغى","زانها سبحانه ربُّ العطايا",9,"ا",3,0]]}