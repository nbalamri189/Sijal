{"poems":[[75,"الهوى في طلوع تلك النجوم","https://www.aldiwan.net/poem11917.html","الخفيف"],[23,"هل تعرف الدار عفا رسمها","https://www.aldiwan.net/poem21428.html","السريع"],[34,"لقد اورثت قلبي وكان مصححا","https://www.poetsgate.com/ViewPoem.aspx?id=107",""],[136,"ما بال هذا المدمع الذارف","https://www.aldiwan.net/poem54792.html","السريع"],[147,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[211,"إما تري يا أم فروة خيلنا","https://www.aldiwan.net/poem27940.html","الكامل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48533","البسيط"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82242","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25362","الرجز"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87840","الكامل"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104466","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101807","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121193","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111255","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94321","الرجز"],[2947,"","https://poetry.dctabudhabi.ae/diwan/poem/146630","السريع"],[3048,"","https://poetry.dctabudhabi.ae/diwan/poem/100611","المجتث"],[3092,"","https://poetry.dctabudhabi.ae/diwan/poem/216356","الكان كان"],[3113,"","https://poetry.dctabudhabi.ae/diwan/poem/29449","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67978","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135254","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4767,"مركز الماجد","https://www.poetsgate.com/ViewPoem.aspx?id=97448",""]],"verses":[["إِذ خِتامُ الرِضا المُسَوَّغِ مِسكٌ","وَمِزاجُ الوِصالِ مِن تَسنيم",0,"م",1,0],["إِذ خَرَّ في مَشيَخَةٍ مِنكُمُ","مِن كُلِّ عاتٍ قَلبُهُ جاهِلِ",1,"ل",1,0],["إذ خَطَرَتْ من ذكر بثنة خطرةٌ","عصتني شؤون العين فانهلّ ماؤها",2,"ا",3,0],["إِذ خَرَفُوا الحَقَّ الذي تَشتَهِى","أهلُ الهُدَى مِن مُشتَهَى الخَارِفِ",3,"ف",1,0],["إِذ خَصَّهُ خَيرُ الأَنامِ بِنِعمَةٍ","لَم يَحبُها كَهلاً وَلا مَولودا",4,"د",2,0],["إِذ خافَ حَدُّهُمُ النَبِيَّ وَأَسنَدوا","جَمعاً تَكادُ الشَمسُ مِنهُ تَخَشَّعُ",5,"ع",1,0],["إِذ خلَّة الصَديقِ","عند أولي التَحقيقِ",6,"ق",1,0],["إذ خالفوا المهيمن العليّا","واتخذوا من دونه وليا",7,"ي",2,0],["إذ خصّ بموجبات فضله","منفردا دون جميع أهله",7,"ه",1,0],["إذ خيب اللّه ما كانت نفوسكم","تخفي وتعلن من ظن وحسبان",8,"ن",1,0],["إِذ خانَني عَنَتُ الزَّمانِ وَفاتَني","بِأَغَرَّ ذي فَجَرٍ كَريمِ المَشهَدِ",9,"د",1,0],["إِذَ خَانَ وَصْلُ الغانِياتِ الخُوَّنِ","فَجساً وَغَدْراً أَنْ صَحَا تَجَنُّبِي",10,"ن",3,0],["أَذَخيرَةَ الفُصحى سَلِمتَ فَما عَلى ال","فُصحى وَأَنتَ إِمامُها مِن باسِ",11,"س",1,0],["إذ خفتهم قهري إلى الإيمان","من دون تعنيفي بالبرهان",12,"ن",1,0],["إذ خَالَفُوا رَأياً لَهُ رَأيٌ يُنَا","قِضُهُ لأجلِ النَّصِّ وَالبُرهَانِ",13,"ن",1,0],["أذخرتم وصلي إذا الروح ارتقت","في النزع بين حناجري وتراقي",14,"ق",2,0],["اذ خادم الحرمين قال بنصه","لابي أمين يا أمين تبصر",15,"ر",1,0],["إذ خر من فوق الجواد إلى الثرى","وهو لمصرعه هوي الساجد",16,"د",1,0],["إذ خلقه يكون من شأن الكرم","وكيف لا ووابل الإحسان عم",17,"م",1,0],["إذ خرجت لحيته فجأةً","فشفه الحزن وأضناه",18,"ا",2,0],["إذ خلنه هاشمياً","بالجود يشبه رهطه",19,"ه",1,0],["اذخر لنفسك ذخيره","عسى تراها في غدا",20,"د",2,0],["إذ خُبِّرت مَذحِجٌ عَنَّا وقَد كُذِبت","أن لَن يُوَرِّعَ عَن أَحسابِنَا حَامِ",21,"م",1,0],["إذ خان بالسلطان سيدِنا أبي ال","فضلِ المليك الأَرْيَحيِّ سعيدُ",22,"د",1,0],["إذ خلق الإله خلقاً خلقا","مَعَهُمُ عَشْرَةَ أشياء ثقا",23,"ق",2,1],["إذ خِيرَةُ العِبَادِ عَنهَا أعرَضُوا","وَرَبَّهُم قَرضاً جَمِيلاً أقرَضُوا",24,"ض",3,0],["إذ خلَّفَ الظلمةَ من خلفِهِ","مكسورةَ الأرجلِ والساعد",25,"د",1,0]]}