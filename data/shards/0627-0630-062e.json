{"poems":[[75,"الهوى في طلوع تلك النجوم","https://www.aldiwan.net/poem11917.html","الخفيف"],[23,"هل تعرف الدار عفا رسمها","https://www.aldiwan.net/poem21428.html","السريع"],[34,"لقد اورثت قلبي وكان مصححا","https://www.poetsgate.com/ViewPoem.aspx?id=107",""],[135,"ما بال هذا المدمع الذارف","https://www.aldiwan.net/poem54792.html","السريع"],[146,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[210,"إما تري يا أم فروة خيلنا","https://www.aldiwan.net/poem27940.html","الكامل"],[300,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/29449","البسيط"]],"verses":[["إِذ خِتامُ الرِضا المُسَوَّغِ مِسكٌ","وَمِزاجُ الوِصالِ مِن تَسنيم",0,"م",1,0],["إِذ خَرَّ في مَشيَخَةٍ مِنكُمُ","مِن كُلِّ عاتٍ قَلبُهُ جاهِلِ",1,"ل",1,0],["إذ خَطَرَتْ من ذكر بثنة خطرةٌ","عصتني شؤون العين فانهلّ ماؤها",2,"ا",3,0],["إِذ خَرَفُوا الحَقَّ الذي تَشتَهِى","أهلُ الهُدَى مِن مُشتَهَى الخَارِفِ",3,"ف",1,0],["إِذ خَصَّهُ خَيرُ الأَنامِ بِنِعمَةٍ","لَم يَحبُها كَهلاً وَلا مَولودا",4,"د",2,0],["إِذ خافَ حَدُّهُمُ النَبِيَّ وَأَسنَدوا","جَمعاً تَكادُ الشَمسُ مِنهُ تَخَشَّعُ",5,"ع",1,0],["إِذ خلَّة الصَديقِ","عند أولي التَحقيقِ",6,"ق",1,0],["إذ خالفوا المهيمن العليّا","واتخذوا من دونه وليا",7,"ي",2,0],["إذ خصّ بموجبات فضله","منفردا دون جميع أهله",7,"ه",1,0],["إذ خُبِّرت مَذحِجٌ عَنَّا وقَد كُذِبت","أن لَن يُوَرِّعَ عَن أَحسابِنَا حَامِ",8,"م",1,0]]}