gate.com/ViewPoem.aspx?id=207360",""],[5064,"الطّريق إلى الرّب","https://www.poetsgate.com/ViewPoem.aspx?id=199124",""],[5092,"لا موعدٌ لنا","https://www.poetsgate.com/ViewPoem.aspx?id=178713",""],[5106,"زَاْكِيَاْتٍ كَفَرْحَةِ الأَنْبِيَ","https://www.poetsgate.com/ViewPoem.aspx?id=156840",""],[5119,"لست تدري","https://www.poetsgate.com/ViewPoem.aspx?id=196605",""],[5136,"حبه بالروح ممتزج","https://www.poetsgate.com/ViewPoem.aspx?id=121535",""],[5273,"ترنيمة الجسد","https://www.poetsgate.com/ViewPoem.aspx?id=183231",""],[5323,"أمشاج الحب","https://www.poetsgate.com/ViewPoem.aspx?id=207794",""],[5386,"ياسمين بريحةٍ من نار","https://www.poetsgate.com/ViewPoem.aspx?id=34998",""],[5421,"طواف..","https://www.poetsgate.com/ViewPoem.aspx?id=212012",""],[5672,"شهد الشفاه","https://www.poetsgate.com/ViewPoem.aspx?id=206435",""],[5739,"الغبي ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155468",""],[5747,"دهاليز الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=61678",""],[402,"يا حسنها حين تجلت على","https://www.poetsgate.com/ViewPoem.aspx?id=36426",""],[402,"يفسح الراحلون للقادمينا","https://www.poetsgate.com/ViewPoem.aspx?id=36532",""],[5823,"ياصديقي","https://www.poetsgate.com/ViewPoem.aspx?id=59800",""],[5912,"عرس القرنفل","https://www.poetsgate.com/ViewPoem.aspx?id=205015",""],[6160,"خَيْبَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87088&r=&rc=5",""],[463,"من عذيري يومَ شرقيّ الحمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60006&r=&rc=62",""],[6249,"صدفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85659&r=&rc=2",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""],[2220,"قد جرى في مثلنا مثلَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11383&r=&rc=257",""],[572,"من ترى ينصفُني من خَليلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9428&r=&rc=285",""]],"verses":[["بَينَنا يا بَني المُغيرَةِ يَومٌ","غائِرُ الشَمسِ مُدنَفُ الإِشراقِ",0,"ق",1,0],["بَيْنَ نَثْرٍ لا عَيْبَ فِيهِ وَشِعْرٍ","مِثْلَ مَا تَشْتَهِي المُنَى أَنْ يَكُونَا",1,"ن",2,0],["بَيْنَ نُجَيْمَاتٍ بَدَتْ حَوْلَهَا","لَهَا رَفِيفُ القَطَرَاتِ السِّجَامْ",2,"م",1,0],["بين نظيم المجد والعلاء","عند جميع العرَبِ العرباء",3,"ا",2,0],["بَيْنَ نَدَامَى كلُّهُم جَامحٌ","ليس عن الغَيِّ بمَكَبُوحِ",4,"ح",1,0],["بين نشيرِ الروضِ والخيشومِ","كأنها من جنةِ النعيمِ",5,"م",1,0],["بيننا حُرمةٌ وقد عضَّني الده","رُ ولا قَتْ ظهورَ أمرِي بطونه",6,"ن",2,0],["بَينَنا تَعَنُّقِهِ الكُماةَ وَرَوغِهِ","يَوماً أُتيحَ لَهُ جَرىءٌ سَلفَعُ",7,"ع",1,0],["بَينَنا مِن أَدَبٍ يُعزى لَهُ","نَسَبٌ أَوجَبَ إِدلالي عَلَيك",8,"ك",1,0],["بَينَنا مَعرِفَةٌ","يا لَها مِن مَعرِفَه",9,"ف",2,0],["بَينَ نورٍ مِنَ الرَبيعِ يُحَيِّ","يكَ وَعَهدٍ مِنَ الشِتاءِ حَميدِ",10,"د",1,0],["بَينَنا حُرمَةٌ وَعَهدٌ وَثيقٌ","وَعَلى بَعضِنا لِبَعضٍ حُقوقُ",11,"ق",1,1],["بين نثر كأنه زهرات الروض","يضحكن عن بكاء الغمام",12,"م",1,0],["بَينَ نَدامى تَحُثُّ كَأسَهُمُ","عَلَيهِمُ كَفُّ شادِنٍ أَحوَر",13,"ر",1,0],["بيننا في القياس فرق لأني","سرني يوسف بغير قميص",14,"ص",1,0],["بَينَ نِتاجَي حَبَشٍ وَرومِ","في ظُلَلِ الذَروَةِ وَالعُلجومِ",15,"م",1,0],["بَيْنَ نَدْمَانَ كَالْكَواكِبِ حُسْناً","ورَعَابِيبَ كالدُّمَى خَفِراتِ",16,"ت",1,0],["بيننا والمرام خطوة عزم","واثب كالضحى شباب الطماح",17,"ح",1,0],["بين نور الربيع والنرجس الغض","وبحرٍ يورع جزراً ومدّا",18,"د",2,0],["بَينَ نَثرٍ كَأَنَّهُ قَطَعُ الرَو","ضِ وَنظمٍ كَالدرِّ في الأَجيادِ",19,"د",1,0],["بيننا تقولُ اعتدلتْ","تقولُ لم تعتدلِ",20,"ل",1,0],["بيننا اليوم حجاب وحجاب","يا غريب الروح في دار الخلود",21,"د",1,0],["بين نشر المنى وطي المنايا","سنة عمت الورى وابتلاء",22,"ا",2,0],["بيننا على كسرى سماءُ مدامةٍ","مكلَّلة حافَاتُها بنجوم",23,"م",1,1],["بيننا يا ضياءَ عيني بحورٌ","يملأُ العينَ حرُّها والسَّراب",24,"ب",1,0],["بيننا قصة الوجود فحدث","أهيَ زادت عن يقظة ورقاد",25,"د",1,0],["بيننا أو بين زهر وشذاه","بيننا أو بين بدر وسناه",26,"ه",1,1],["بيننا أو بين جفن ورؤاه","بيننا أو بين لحن وصداه",26,"ه",1,0],["بيننا حب وقلب","وأمان حالمات",26,"ت",1,0],["بيننا كون من القرب وأكوان","من البعد الغريب",26,"ب",1,0],["بيننا ليلة ضم وليالي قبلات","بيننا سبحة حلمين أفاقا من سبات",26,"ت",1,0],["بيننا أنغام جنان وصرخات رعاة","بيننا جنات تسهيد ونيران منام",26,"م",1,0],["بيننا أوّاه مّما بيننا","بيننا ماض من الأضواء يعشى جفننا",26,"ن",2,0],["بيننا مستقبل يهفو للماح السنا","آه ما أطهر ماضينا وما",26,"م",2,0],["بيننا أو بين جفن ورؤاه","بيننا أو بين صوت وصداه",26,"ه",1,0],["بَينَنا شَمعةٌ تَذوبُ كجسمٍ","لغَريبٍ ثَوى بأرضِ الغَرِيِّ",27,"ي",1,1],["بَينَ نَشوِ الغِنا ونَشوِ المَعالي","وجَبَ العَفوُ عَن صُروفِ اللَّيالي",28,"ل",2,1],["بَينَنا نِسبَةٌ ولكنَّكَ النا","زِلُ مِنها في كلِّ بيتٍ رفيعِ",29,"ع",1,0],["بينَنا للبَخورِ غَيمٌ وللما","وَردِ طَشٌّ وللغَوالي رِداغُ",30,"غ",1,0],["بيننا للرَّقيبِ سَدُّ فلا تَج","مَعْ على ذي الهوى مَعَ السَّدِّ صَدّا",31,"د",2,0],["بين ندمان كأنْ قد أَصبحوا","من خطوب الدَّهر طرًّا في ذمام",32,"م",1,0],["بين ندمانٍ كأزهار الرُّبى","كلُّ فرد منهم بالفضل مفرد",33,"د",1,0],["بين ندمانٍ أراقوا دَمَها","بنت كرم تسلبُ الشيخ الوقارا",34,"ر",2,0],["بين نيروزٍ وعيدٍ أمسيا","رائدَيْ إِقبالكم أو اصبحا",35,"ح",2,0],["بيننا والطير نجوى","فاصغ للسر المصون",36,"ن",1,0],["بيننا وعده على الحوض نلقى","صاحب الحوض مثل ما يلقانا",37,"ن",2,0],["بَيْنَنَا مُوَاصَلَةٌ لاَ يُبَتُّ","مِثْلُهَا بِقَالِ عَدُوٍّ وَقِيْلِ",38,"ل",1,0],["بَيْنَنا في الهَوَى اخْتِلَافٌ وَإِنْ كا","نَ اتفاقٌ فَرُبَّما في الخُفُوقِ",39,"ق",1,0],["بين ندبٍ يفتّت القلبَ حُزناً","وعويل الأولادِ بعد النساءِ",40,"ا",2,0],["بَيننا أَبطالَ حَربِ","لا تُبالي يَوم كَربِ",41,"ب",1,0],["بيننا وعده على الحوض نلقى","صاحب الحوض مشرقا وضاحا",42,"ح",2,0],["بين نهرٍ وقناةٍ","قد تَلَتْه وتَلاها",43,"ا",3,0],["بَينَ نُبذٍ مِنَ الشَقائِقِ يَحكي","غِلمَةَ الدُرِّ في مَطارِفَ حُمرِ",44,"ر",1,0],["بَينَنا الآنَ جِبالٌ وَرُبىً","وَسُهولٌ يَعجَزُ الطَيرَ فَضاها",45,"ا",3,0],["بينَ نَشرِ الدُّجَى وطيِّ النَّهارِ","سَبَقَ الشَّمسَ لِلمَغيبِ هَزاري",46,"ر",2,1],["بيننا سكر فلاتفسدنه","أم يقولون: بيننا وبينك ملح",47,"ح",1,0],["بَينَنا الفَتى ناعِمٌ راضٍ بِعيشَتِهِ","سيقَ لَهُ مِن دَواهي الدَهرِ شُؤبوبُ",48,"