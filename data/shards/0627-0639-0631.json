يظفر","https://www.aldiwan.net/poem50162.html","الكامل"],[409,"وشائمة برقا بفودي راعها","https://www.aldiwan.net/poem31987.html","الطويل"],[416,"بلغ الشوق لعمري ما أراد","https://www.aldiwan.net/poem53890.html","الرمل"],[416,"أعلمت أي معالم ومعاهد","https://www.aldiwan.net/poem54097.html","الطويل"],[416,"أترى في الوجود مثلك عالم","https://www.aldiwan.net/poem54119.html","الخفيف"],[416,"إلى العز خوري يا نياقي وأنجدي","https://www.aldiwan.net/poem54159.html","الطويل"],[432,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[432,"دوعدت ولم تف لي بذاك الموعد","https://www.aldiwan.net/poem12481.html","الكامل"],[437,"ولى فأسرع في الفراق وما شفى","https://www.aldiwan.net/poem2558.html","الكامل"],[448,"أعرفت ما ألقاه بعدك","https://www.aldiwan.net/poem53725.html","مجزوء الكامل"],[453,"أعرفت الحنين في الأرض للشمس","https://www.aldiwan.net/poem61572.html","الخفيف"],[458,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[458,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[458,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[458,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[458,"تراك ترى غدوا أو أصيلا","https://www.aldiwan.net/poem56078.html","الوافر"],[458,"أزائرة كما زعم الخيال","https://www.aldiwan.net/poem56081.html","الوافر"],[458,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[458,"لأية لبسة خلع الخلاعه","https://www.aldiwan.net/poem56137.html","الكامل"],[458,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[458,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[468,"كتبت إلى بعض الأخلاء رقعة","https://www.aldiwan.net/poem59863.html","الطويل"],[477,"أعرفت من داء الصبابة شافيا","https://www.aldiwan.net/poem15185.html","الكامل"],[479,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[495,"سقى الله نجدا كلما ذكروا نجدا","https://www.aldiwan.net/poem9820.html","الطويل"],[495,"كذا من شام بارقة الثنايا","https://www.aldiwan.net/poem10288.html","الوافر"],[498,"العلم يكسو الحلل الفاخرة","https://www.aldiwan.net/poem3699.html","السريع"],[504,"كلت لسانا سقيما من تصرفه","https://www.aldiwan.net/poem38394.html","عموديه"],[515,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[515,"يا من بليغ المعاني من عبارته","https://www.aldiwan.net/poem12044.html","البسيط"],[515,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[551,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[551,"دعى منظري إن لم أكن لك رائعا","https://www.aldiwan.net/poem47780.html","الطويل"],[551,"ما نحن إلا للفناء","https://www.aldiwan.net/poem48110.html","مجزوء الكامل"],[562,"أعرفت رسم الدار أم لم تعرف","https://www.aldiwan.net/poem52886.html","الكامل"],[575,"يا معرضاً قد آن أن تقبلا","https://www.aldiwan.net/poem2887.html","السريع"]],"verses":[["أَعرِضُ الآمالَ مَشفوفاً بِها","ثُمَّ أَنساها إِذا الخَطبُ أَلَمّ",0,"م",1,0],["أَعرَضنَ عَنّي حينَ وَلّى الصِبا","وَاِختَلَجَ الهَمُّ بَقايا العُرام",1,"م",1,0],["أَعرَيتَ ظَهري لِلعِدا وَلَوِ اِتَّقى","بِزُهاءِ مُزدَحِمِ العَديدِ عَرَمرَمِ",2,"م",1,0],["أعْرَضْتِ غَضْبَى وأغرَيْتِ الخَيالَ بِنا","فلسْتُ ألْقاهُ إلا وهْوَ غَضْبانُ",3,"ن",1,0],["أَعرَضتِ ما أَعرَضتِ راغِبَةً","عَني فَهَلّا كانَ ذا قَبلُ",4,"ل",1,0],["أَعرِض عَنِ الجاهِلِ السَفيهِ","فَكُلُّ ما قالَ فَهُوَ فيهِ",5,"ه",1,1],["أَعْرَسْتَ فِي مَثْوَى الْخِلاَفَةِ بَعْدَمَا","عَكَفَتْ عُلاَكَ تُشِيدُهُ وَتُطِيلُهُ",6,"ل",2,0],["أَعِرني فُؤاداً مِنكَ يا دَهرُ قاسِياً","لَو أَنَّ القُلوبَ القاسِياتِ تُعارُ",7,"ر",1,0],["أَعِرني لِمَدحيكَ اليَراعَ الَّذي بِهِ","تَخُطُّ وَأَقرِضني القَريضَ المُسَدَّدا",8,"د",2,0],["أَعَرفُكِ راحَ في عُرفِ الرِياحِ","فَهَزَّ مِنَ الهَوى عِطفَ اِرتِياحي",9,"ح",2,1],["أَعرِض عَنِ الخَطَراتِ إِنَّكَ إِن تَشَأ","تَكُنِ النُجومُ أَسِنَّةً لِقَناكا",10,"ك",2,0],["أَعَرُوسٌ إِكْلِيلُهَا يَعْلُوهَا","أَمْ هِيَ الشَّمْسُ وَالسَّنَى يَجْلُوهَا",11,"ه",2,1],["أَعِرْنِي بَعْضَ مَا بِكَ مِنْ ذَكَاءٍ","لَهُ لَمَحُ الدَّرَارِي فِي العَنَانِ",12,"ن",1,0],["أُعَرِّفُ نَفْسِي إِذْ أُعَرِّفُكُمْ بِهِ","وَعِنْدَكمُ عِلْمٌ بِهِ فَوْقَ تِبْيَانِي",13,"ن",2,0],["أَعَرَفْتَ إِذْ دَعَتِ البِلادُ إِلَى الفِدَى","إِقْدَامَ ذَاكَ المُسْعِدِ المِعْوَانِ",14,"ن",1,0],["أعَرَفْتَ صَرْحاً مَر فِي تَشْيِيدِهِ","عُمْرٌ فَلَمَّا تَمَّ بَانَ البَانِي",15,"ن",2,0],["أَعْرَضْتَ عَنْ لَذَّاتِها مُنْذُ الصِبا","وَالرَّوْضُ تُفْري والقُطُوفُ دَوَانِي",16,"ن",2,0],["أعِرْنِي ثَغْرَ بَيْرُوتَ ابْتِساماً","أصُغْ فَرْضَ الجَمِيلِ مِنَ ابْتِسَامِ",17,"م",1,0],["أَعراضَ ريحِ الصَبا تُزهي جَوانِبَها","عِندَ الصَباحِ مَعَ الحَصباءِ بِالمورِ",18,"ر",1,0],["أعرضت عنها مشيحاً غير ملتفت","إلى المناصب فيها أو إلى الرتب",19,"ب",1,0],["أَعرابُكُم عارٌ عَلى حُضّارِكُم","وَالحاضِرونَ خَزايَةُ الأَعرابِ",20,"ب",1,0],["أَعِرني أَقيكَ السوءَ نَظرَةَ وامِقٍ","لَعَلَّكَ تَرثي أَو لَعَلَّكَ تَرحَمُ",21,"م",1,0],["أَعرِض عَنِ العَوراءِ إِن أُسمِعتَها","وَاِقعُد كَأَنَّكَ غافِلٌ لا تَسمَعُ",22,"ع",1,1],["أعربت ذكرَه مباني المعاني","فعجبْنا لمعرَبٍ ذي بناء",23,"ا",2,0],["أعرض عنِّي مرةً مرةً","فاعْترضت أنكال أنكادِي",24,"ي",1,0],["أعرضت عنه فوالت حربه فئةٌ","شاكوا السلاح فتضريبٌ وتسييف",25,"ف",1,0],["أعربت ذكره مباني علاه","فعجبنا لمعرب اللفظ مبني",26,"ي",1,0],["أعربت يا مقلتي الغافيه","عن زورةٍ كافيه شافيه",27,"ف",3,1],["أعْرَضَتْ عنهُمُ عَزَائمُك الصُم","مُ بأُذنٍ سميعة صمّاءِ",28,"ا",2,0],["أعِرْه منك إصغاءً وفهماً","يُضِئْ لك عذرُهُ ضوءَ الشِّهابِ",29,"ب",1,0],["أَعْرَيْتُمُوني مِنْ جَدَاكُمُ كُلِّهِ","وَعَرَيْتُمُ من كل عُذْرٍ مُتَّضِحْ",30,"ح",1,0],["أعِرْ طرفك المرآة وانظر فإنْ نبا","بعينيْك عنك الشيبُ فالبِيض أعذر",31,"ر",1,0],["أعْرَيتني من فضل كفكَ كله","يا من جعلتُ له الثناء لباسا",32,"س",2,0],["أعرفُ بالأشقياء بي رجُلاً","لا ينتهى أو يصيرَ لي غرضا",33,"ض",2,0],["أعرض عن قرنه وصدَّ فما","أصبح شيء عليه يعطفه",34,"ف",2,0],["أعرض عني وجفا جانبي","تقديمه البر وإلحاقه",35,"ق",2,0],["أعِرْ شَتَراً بعيْنك منك فِكْراً","وطالبْ بالجنايةِ واتريكا",36,"ك",2,0],["أعرِّفُهم منك الذي يعرفونه","وأسلافُهم من قبلِ شعري ومن قبلي",37,"ل",2,0],["أعرف ورَّاقاً بآيينِهِ","من قَرْنه نُصب سكاكينِهِ",38,"ن",2,1],["أَعرَضنَ مِن شَمَطٍ في الرَأسِ لاحَ بِهِ","فَهُنَّ مِنّي إِذا أَبصَرنَني حيدُ",39,"د",1,0],["أَعرَضنَ لَمّا حَنى قَوسي مُوَتِّرُها","وَاِبيَضَّ بَعدَ سَوادِ اللِمَّةِ الشَعَرُ",40,"ر",1,0],["أَعَرفتُموهُ إِنَّهُ هَذا الفَتى","هَذا الَّذي سَحَرَ الخِضَمَّ مُرورُهُ",41,"ر",2,0],["أَعرِفُ ما عِندَكَ مِن وَحشَةٍ","وَمِثلُهُ عِندِيَ أَو أَكثَرُ",42,"ر",1,0],["أَعَرفتَ هذا القلبَ في","ظلماءِ هاتيكَ اللُّحُودْ",43,"د",1,0],["اعرضت دنياي عني","ما على الدنيا عتاب",44,"ب",1,0],["أعرني النجم أوهب لي يراعا","يزيد الرافعيين ارتفاعا",45,"ع",2,1],["أَعِرِ الناسَ لِساناً يَنظُموا","لَكَ فيهِ الشِعرَ أَو يُنشوا الخُطَب",46,"ب",1,0],["أُعَرِّبُ ما تُنشي عُلاكَ وَإِنَّهُ","لَفي لُطفِهِ ما لا يَنالُ المُعَرِّبُ",47,"ب",1,0],["أُعَرِّضُ لِلرِماحِ الصُمِّ نَحري","وَأَنصِبُ حُرَّ وَجهي لِلهَجيرِ",48,"ر",1,0],["أعرِّضُ فيه حُرَّ وجهيَ للفَلا","وليس له إلّا الهجيرَ لِثَامُ",49,"م",1,0],["أَعرَضتِ حَتّى خِلتُ أَنّي ظالِمٌ","وَعَتَبتِ حَتّى قُلتُ أَنّي مُذنِبُ",50,"ب",1,0],["أَعرَضَت عَطفَةَ القَضيبِ وَحادَت","مِن قَريبٍ كَما يَحيدُ الغَزالُ",51,"ل",1,0],["أَعَرَفتَ بَينَ رُوَيَّتَينِ وَحَنبَلٍ","دِمَناً تَلوحُ كَأَنَّها الأَسطارُ",52,"ر",1,1],["أُعرِّيهما طَوراً وطَوراً أراهُما","يَجُرَّانِ مصقولَ البنائقِ أحمرا",53,"ر",2,0],["أعربَ البانُ بَينَهنَّ فمن أَثْ","مارِه الياسَمينُ والجُلَّنارُ",54,"ر",1,0],["أعرضَتْ خِيفَةَ الرَّقيب ولولا","ه لكان الإعراضُ منها رَقيبا",55,"ب",2,0],["أُعرَفُ في الحَشرِ بِحُبّي لَكُم","إِذ يُعرَفُ الناسُ بِسيماهُمُ",56,"م",1,0],["أَعرَبَت عَن صِفاتِنا عُجمُ أَقلا","مٍ فِصاحٍ جِراحُهُنَّ جُبارُ",57,"ر",1,0],["أَعرَضَت بُرهَةً لَمّا أَحَسَّت","بِالنَوى أَعرَضَت عَنِ الإِعراضِ",58,"ض",1,0],["أَعِر شِعري الإِصاخَةَ مِنكَ يَرجِع","طَوالَ الدَهرِ بارِحُهُ سَنيحا",59,"ح",2,0],["أعرضْتُ إعراضَ التعفّفِ عنهمُ","وقطعتُ وصلَهمُ وقرَّ قراري",60,"ر",2,0],["أَعَرَفتَ يَومَ لِوى سُوَيقَةَ دارا","هاجَت عَلَيكَ رُسومُها اِستِعبارا",61,"ر",2,1],["أَعِر مِصراً كِيانَكَ إِنَّ مِصراً","وَقاها اللَهُ واهِيَةُ الكِيانِ",62,"ن",1,0],["أَعرضَ القومُ وقالوا دِينُنا","يا ابنَ عوفٍ دِينُنا لا ما تَشاءْ",63,"ا",2,0],["اعرفْ لربّكَ حقَّهُ فَلِحكمةٍ","خَلَقَ العُقولَ وأنشأَ الأحلاما",64,"م",2,0],["اعْرِفِ الحقَّ لا تَرُعْكَ الدَّعاوى","فالمروآتُ والمناقبُ ثَمَّا",65,"م",2,0],["أعرِضْ عن ابنك إنّ موتكَ لِلّذي","حمل الحياةَ إلى الشعوبِ لَمُتْرِحُ",66,"ح",1,0],["أَعَرَفتَ رَبعاً غَيرَ آهِل","قَفرَ الرُسومِ بِبَطنِ حائِل",67,"ل",1,1],["أعْرَضْتُ عَنْ لهْوِ الحَدِيثِ وقُلْتُ يا","مَدْحَ الوَرَى عنِّي فمَا أَنَا مِنْ دَدِ",68,"د",1,0],["أعَرْتُموني نفيساً منه في أدَمٍ","فمَن لكم أن تعاروا البحثَ والنظَرا",69,"ر",2,0],["أَعِر شِعرَكَ الأَطلالَ وَالدِمَّنَ القَفرا","فَقَد طالَ ما أَزرى بِهِ نَعتُكَ الخَمرا",70,"ر",2,1],["أَعرَضتُ عَنها وَقَد فَهِمتُ لِكَي","تَحسَبَ أَنّي لِقَولِها ناسِ",71,"س",1,0],["أَعرَضَ عَنّي لاوِياً شِدقَهُ","كَأَنَّهُ في الوَفرِ قارونُ",72,"ن",1,0],["أَعرِض عَنِ الرَبعِ إِن مَرَرتَ بِهِ","وَاِشرَب مِنَ الخَمرِ أَنتَ أَصفاها",73,"ا",3,1],["أَعَرتُهُ روحي وَقَلبي فَقَد","عَيِيتُ مِمّا أَتَقاضاهُ",74,"ه",1,0],["اِعرِف فَتىً بِفَعالِهِ","شَتّانَ بَينَ نَدٍ وَجامِد",75,"د",1,0],["أَعرَضتُ عَنهُ وَالحِلمُ مِن خُلُقي","وَلَيسَ مِنّي التَثريبُ وَالصَخَبُ",76,"ب",1,0],["اِعرِضا حاجَتي عَلَيها وَقولا","أَنَسيتِ السَرارَ تَحتَ الرِداءِ",77,"ا",2,0],["أَعرِضوا عَن مَدائِحٍ وَتَهانٍ","فَالمَراثي أَولى بِكُم وَالتَعازي",78,"ي",1,0],["أَعرِشُ الجَفرَ وَلا النَخلَ في الدُن","يا وَما تَبقى يَدُ العارِشِ",79,"ش",1,0],["أَعرِض عَنِ الثَورِ مَصبوغاً أَطايِبُهُ","بِالزُعفُرانِ إِلى ثَورٍ مِنَ الأَقِطِ",80,"ط",1,1],["أَعَرَقتَ خَيلَكَ في مُحاوَلَةِ الغِنى","وَحَواهُ غَيرُكَ مُشئِمٌ أَو مُعرِقُ",81,"ق",1,0],["أَعِرقُ آدَمَ هَذا لا يُمازِجُهُ","سِواهُ أَم مَسَّ مِن إِبليسَ تَعريقا",82,"ق",2,0],["أَعَرَفتُمُ أَصحابُكُم بِحَقيقَةٍ","أَم كُلُّكُم عَنهُم غَبيٌّ أَبلَهُ",83,"ل",2,0],["أعَرْتُكَ دِرْعي ضامِناً ليَ رَدَّها","كصَفْوانَ لمّا أنْ أعارَ محَمّدا",84,"د",2,1],["أَعْرِفُ يَا سَيِّدَتِي غَادَةً","ذِكْرُ