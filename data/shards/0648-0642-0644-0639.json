{"poems":[[55,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[55,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[71,"رعى الله عيشا بالمعرة لي مضى","https://www.aldiwan.net/poem28441.html","الطويل"],[71,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85507","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[147,"أما وبديع ما تأتي يمينا","https://www.aldiwan.net/poem11835.html","الوافر"],[214,"طلائعنا بالبشر والسعد تطلع","https://www.aldiwan.net/poem13455.html","الطويل"],[242,"يا هذه الزيتونه","https://www.aldiwan.net/poem19284.html","الرجز"],[276,"مضى زمن الصبا فدع التصابي","https://www.aldiwan.net/poem52055.html","الوافر"],[276,"سمعت سويجع الاثلاث غنى","https://www.aldiwan.net/poem52085.html","الوافر"],[276,"إذا عهدوا فليس لهم وفاء","https://www.aldiwan.net/poem52095.html","البسيط"],[276,"أغيب وذو اللطائف لا يغيب","https://www.aldiwan.net/poem52126.html","الوافر"],[276,"مقيل العاثرين أقل عثارى","https://www.aldiwan.net/poem52134.html","الوافر"],[427,"ما لذة العيش إلا صحبة الفقرا","https://www.aldiwan.net/poem46403.html","البسيط"],[438,"متى يملك الحلم الدنو على البعد","https://www.aldiwan.net/poem12601.html","الطويل"],[463,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[463,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[505,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[563,"غزال ذاك الحمى صبري قضى فيه","https://www.aldiwan.net/poem33644.html","البسيط"],[563,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87019","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64361","المنسرح"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62536","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1042,"","https://poetry.dctabudhabi.ae/diwan/poem/204377",""],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65036","المتقارب"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136363","الطويل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31651","السريع"],[1498,"","https://poetry.dctabudhabi.ae/diwan/poem/130721","البسيط"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102063","الوافر"],[276,"","https://poetry.dctabudhabi.ae/diwan/poem/80445","الوافر"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102138","الوافر"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102123","الهزج"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137175",""],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116498","الطويل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104674","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74225","الوافر"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68011","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66370","الرجز"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199152","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91073","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77056","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97065","المتقارب"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45029","الطويل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35144","البسيط"],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5072,"يا قطتي","https://www.poetsgate.com/ViewPoem.aspx?id=51799",""],[5442,"تذكر بالحمي عهداً برامه","https://www.poetsgate.com/ViewPoem.aspx?id=114756",""],[5956,"جوبي السهول","https://www.poetsgate.com/ViewPoem.aspx?id=184926",""]],"verses":[["وَقَلَّ عِندَ كِرامِ الحَيِّ نائِلُهُم","حَتّى جَلا يَومَ نَحرٍ مَنزِلَ البَرَمِ",0,"م",1,0],["وَقَلعَةُ إِخوانٍ كَأَنّا وَراهُمُ","نُرامِقُ أَعجازَ النُجومِ الغَوارِبِ",1,"ب",1,0],["وقلعتُها عندي وإنْ بانَ أهلُها","كأطولَ مِنْ سهدي عليها وأعرضا",2,"ض",2,0],["وقلْ عنِ الجزعِ واذكرني لساكنِهِ","لعلَّ بالجزعِ أعواناً على السهرِ",3,"ر",1,0],["وقل عنادل بغداد قد اكتأبت","على المعالي فماتَت في البساتين",4,"ن",1,0],["وقلعَةُ الشرقِ إن مُسَّتْ جوانِبُها","خُضْنَا لها جُثثَ القتْلَى مَجَانينَا",5,"ن",2,0],["وَقَلعَةُ دَوسَرٍ بابٌ إِلى ما","تُحاوِلُ فَاِرمِها بِالفاتِحينا",6,"ن",2,0],["وقلعتنا ذات البروج نجومها","اسنتنا يوم الوغى وهي تلمع",7,"ع",1,0],["وَقَلَّعَتْ أَضْرَاسَهُ","وَسَمَّلَتْ عُيُونَهْ",8,"ن",2,0],["وَقل عَبد الرَحيم ومن يَليه","مَعي يَرجو غدا كرم المآب",9,"ب",1,0],["وَقل عَبد الرَحيم ومن يَليه","مَعي يوم الخلود يحل عدنا",10,"ن",2,0],["وقل عَبد الرَحيم ومن يَليه","لهم في ريف رأفتنا جزاء",11,"ا",2,0],["وَقل عبد الرَحيم ومن يَليه","لهم في ريف رأفتنا نصيب",12,"ب",1,0],["وَقل عَبد الرَحيم وَمن يَليه","من المحن العَظيمة في جواري",13,"ر",2,0],["وقُل عبيدُكُم أولى بصفحِكمُ","فامحوا وخُذوا بالرفقِ يا فقَرا",14,"ر",2,0],["وقلْ عاد ذاك الجوّ بعدَك مُظْلما","فلُحْ طالعاً تجلوهُ يا قمرَ السّعْدِ",15,"د",1,0],["وقل عبدُك المشتاقُ لا عهدهُ عفا","ولا وجدُه إن نُقِّلَ الوجدُ نازحُ",16,"ح",1,0],["وقلْ عن حشىً من حَرّها وخفوقها","تعلَّمتَ ما تنزو خِطاراً وتشتبُّ",17,"ب",1,0],["وقلْ عليكَ سلامُ اللهِ خُذْ بيدي","فالرَّكْبُ سارَ وحِمْلي عاقَ مَرْكوبي",18,"ب",2,0],["وقل عليل هواكم من يداويه","أنا المسمى على وهمٍ بعبدِكمو",19,"و",1,0],["وقل على كل شيء حكم قدرته","لكن بمعلومه خُصّت بإبداء",20,"ا",2,0],["وَقُل عِندَما تروى صَداك مؤرّخاً","بَنَى صالحٌ لِلناس خَير سَبيل",21,"ل",1,0],["وقل عليك السلام ما انبرت ال","شمس أو البدر للبريات",22,"ت",1,0],["وقلعتهم لمدفعها غمامَ","حداه رعد همهمة وجرسِ",23,"س",1,0],["وقل عروش المشركين بشرعه","وقادهم للموت من حيث أحجموا",24,"م",3,0],["وقلعتها لها جبل بديع","ومن سود التلول لها قرون",25,"ن",1,0],["وقُلْ عِنْدَكَ الْقِنُّ عَبْدُ الْعَزيزِ","رَهينَ الْبِلى وقَرينَ الْبَلاءِ",26,"ا",2,0],["وقل عندما تبدو معالم داره","لنفسك هذا عندنا جنة المأوى",27,"و",2,0],["وقَلْعَةٍ عَانَقَ العُيُّوقُ سَافِلَها","وجَازَ مَنْطِقَةَ الجَوْزا أَعالِيها",28,"ه",2,0],["وَقُل عديمَ مثالٍ في مفاخرِهِ","ومعدنُ الجودِ مُطفي غُلَّةَ الصادي",29,"د",2,0],["وقل عني بما فيه اكتفاء","من الوجد المبرح يا صفي",30,"ي",1,0],["وَقل عَبد الرَحيم غدا رَفيقي","وَما يَخشى رَفيقك أَن يَضيعا",31,"ع",2,0],["وقُل عثمان ابني قم إلينا","فقد حلّ العقالُ أتى رضاكا",32,"ك",2,0],["وقل عثمانُ ابني","منحنا القصد جملا",33,"ل",2,0],["وقلعة العين قد قامت تدل على","عصر مجيد لنيحا كان في القدزم",34,"م",1,0],["وقلعة الضهر قد دلت بموقعها","على مراقبة الاعدا من الامم",34,"م",1,0],["وقلعة الحصن من اثارها عرفت","بكونها هيكلا للشمس والصنم",34,"م",1,0],["وقل عنه واسمع لطف كل مقالة","يمر بها في افق اذنك اصمع",35,"ع",1,0],["وَقُل عَبدُ الرَحيمِ وَمَن يَليهِ","غَداةَ الرَوعِ ذَنبُهُما هَباءُ",36,"ا",2,0],["وَقُل عَبد حَريق القَلب ظامي","إِلَيكُم جيرة الشعب اليَماني",37,"ي",1,0],["وقلْ عسى الدهرُ يُدنِي بالحبيبِ عَسى","فيَذهب من فؤادي الهمُّ والكدر",38,"ر",1,0],["وقلع عينيه غدا","زيادة لبشرهم",39,"م",1,0],["وقل عُبيدي لا تخف وادخلن","في زمرة الداخل في رحمتي",40,"ي",1,0],["وَقُل عُيوني رَأَت حبّاً فَأفرحها","حسنُ اللقا فانجلت في زي مختضب",41,"ب",1,0],["وقل عدو الرجل افهم حمقه","وقد يقال عقله صديقه",42,"ه",1,0],["وَقُل عَهدي بِعَبدِكُم مَشوقا","يَحِنُّ إِلى زِيارَتِكُم دَواما",43,"م",2,0],["وقل عظم اللَه بابن البتول","لك الأجر في قتله والثوابا",44,"ب",2,0],["وَقُل عِندَما أَبدى بَديعَ تَمامه","وَحازَ البَها أَرّخهُ حُز واجِبَ الفَخر",45,"ر",1,0],["وَقِل عَلى أَيكَةٍ بِوادٍ","لِلوُرقِ في قُضبِها حَنينُ",46,"ن",1,0],["وقل عبدك المهجور مأسور كسبه","غريق خطاياه على بابك ارتمى",47,"م",2,0],["وقلعت ُ للحرمان ِ منك ِ أظافري","أقلعت ِ للحرمان ِ أنت ِ أظافرا ؟؟",48,"ر",2,0],["وقل عنه الذي شاهدته منه","ولا عتب عليك ولا ملامه",49,"م",2,0],["وقلعةُ الجعبر الشماءُ صامدةً","تُبشّر العُرْب بالأمجاد والغَلَبِ",50,"ب",1,0]]}