{"poems":[[31,"ألهى جريرا عن أبيه وأمه","https://www.aldiwan.net/poem6095.html","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204660","الخفيف"],[3897,"","https://poetry.dctabudhabi.ae/diwan/poem/124049","الوافر"]],"verses":[["سَبَنتىً يَظَلُّ الكَلبُ يَمضَغُ ثَوبَهُ","لَهُ في مَعانِ الغانِياتِ طَريقُ",0,"ق",1,0],["سبني إن أردت سرا وطالب","وتهدد واحذر طلابي جهارا",1,"ر",2,0],["سبَنداةٌ تقاصرَ عن قُواها","وشِدّةِ نفسِها درك الكلال",2,"ل",1,0]]}