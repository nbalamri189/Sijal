{"poems":[[30,"لقد أحجمت عني فقيم مخافة","https://www.aldiwan.net/poem5429.html","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137867",""],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120977","البسيط"]],"verses":[["فَقَلَّ غَناءً عَن فُقَيمٍ وَنَهشَلٍ","أَراجيزُ يُذريها الضَلالُ المُضَلَّلُ",0,"ل",1,0],["فقل غيث ربي فوق تاريخ تربه","وفي قبره قل شرف الله بنّاه",1,"ا",2,0],["فقل غيوث إذا جدب واعر فبدا","والناس في أزمات ذات ألوان",2,"ن",1,0]]}