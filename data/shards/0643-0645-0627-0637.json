{"poems":[[29,"أخالد عاد وعدكم خلابا","https://www.aldiwan.net/poem5685.html","الوافر"],[74,"برغم العلى تاج تحلى به الثرى","https://www.aldiwan.net/poem18719.html","الطويل"],[74,"أرأيت نهج الحق كيف يبين","https://www.aldiwan.net/poem20170.html","الكامل"],[74,"تناسبت المحاسن يا لبينا","https://www.aldiwan.net/poem20200.html","الوافر"],[64,"وبين الرياض الحو زهر شقائق","https://www.aldiwan.net/poem52269.html","الكامل"],[30,"أرى شعراء الناس غيري كأنهم","https://www.aldiwan.net/poem5321.html","الطويل"],[30,"لها صاحبا فقر عليها وصادع","https://www.aldiwan.net/poem5391.html","الطويل"],[82,"وزرقاء في لون السماء تنبهت","https://www.aldiwan.net/poem31460.html","الطويل"],[42,"ألم ينس ليلى عهدك المتباعد","https://www.aldiwan.net/poem42299.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[82,"وزرقاء في لون السماء تنبّهت","https://www.poetsgate.com/ViewPoem.aspx?id=3210",""],[119,"خطرات ذكرك تستثير مودتي","https://www.aldiwan.net/poem41225.html","عموديه"],[146,"تظن فراقا أن تثار حمول","https://www.aldiwan.net/poem58376.html","الطويل"],[230,"أهجر النوم في طلاب العلاء","https://www.aldiwan.net/poem55222.html","الخفيف"],[240,"أرى الأيام صيغتها تحول","https://www.aldiwan.net/poem31790.html","الوافر"],[287,"الآن لان لي الزمان فأعتبا","https://www.aldiwan.net/poem32875.html","الكامل"],[325,"كم أطنب الناس في وصف العذار وكم","https://www.aldiwan.net/poem61685.html","البسيط"],[369,"سبى مني الفؤاد لحاظ فاتن","https://www.aldiwan.net/poem60611.html","الوافر"],[369,"بدا في فرعك الوخط","https://www.aldiwan.net/poem60858.html","الهزج"],[406,"يا مسجد الإسراء","https://www.aldiwan.net/poem6713.html","عموديه"],[406,"أغلى الهدايا","https://www.aldiwan.net/poem6722.html","عموديه"],[520,"ما هاج مزنة دمعه المترقرق","https://www.aldiwan.net/poem12188.html","الكامل"],[556,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138301",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48654","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62600","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64720","الوافر"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132883","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27144","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28580","الرمل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99079","الوافر"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109798","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201837","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74247","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74148","الكامل"],[3226,"","https://poetry.dctabudhabi.ae/diwan/poem/140159",""],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130611","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85188","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131247",""],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77136","الكامل"],[4079,"","https://poetry.dctabudhabi.ae/diwan/poem/145861","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94554","الطويل"],[286,"","https://poetry.dctabudhabi.ae/diwan/poem/47076","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72459","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72748","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139536",""],[4679,"من لي بإحصاء لآلي البحار","https://www.poetsgate.com/ViewPoem.aspx?id=142758",""],[4691,"من أنتِ إلا كلُ ما أتمنى","https://www.poetsgate.com/ViewPoem.aspx?id=177122",""],[4767,"فاطمة (ابنتي)","https://www.poetsgate.com/ViewPoem.aspx?id=129784",""],[585,"طلع الربيع على الربوع نضيرا","https://www.poetsgate.com/ViewPoem.aspx?id=161872",""],[5082,"خلف باب الصّومعة","https://www.poetsgate.com/ViewPoem.aspx?id=212471",""],[5183,"الدعاء الثاني","https://www.poetsgate.com/ViewPoem.aspx?id=185885",""],[5376,"بدرٌ يضيءُ وشفةٌ لمياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=192684",""],[5431,"ولكن أداينه ....","https://www.poetsgate.com/ViewPoem.aspx?id=214829",""],[5459,"مُنساق ..","https://www.poetsgate.com/ViewPoem.aspx?id=196575",""],[5524,"الجلساء الثلاثة","https://www.poetsgate.com/ViewPoem.aspx?id=37193",""],[5638,"ديمة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=197900",""],[5667,"قلها","https://www.poetsgate.com/ViewPoem.aspx?id=214941",""],[6093,"معاتب نية","https://www.poetsgate.com/ViewPoem.aspx?id=212899",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""]],"verses":[["كَما طَرَدَ النَهارُ سَوادَ لَيلٍ","فَأَزمَعَ حينَ حَلَّ بِهِ الذَهابا",0,"ب",2,0],["كما طلب ابن الخضر دارَ مُقامه","فغلَّس في بغيا النعيم وبكَّرا",1,"ر",2,0],["كم أطربت سمعاً لرافعِ قصةٍ","فكأنَّ رجعَ صريرها تلحين",2,"ن",1,0],["كما طالبت جودك يا ابن يحيى","وكم أجدى وكم أسدى إلينا",3,"ن",2,0],["كما طُرِحَتْ في الفحمِ نارٌ ضعيفةٌ","فمن جانبٍ نارٌ ومن جانبٍ فحمُ",4,"م",1,0],["كَما طِرتُ مِن مِصرَي زِيادٍ وَإِنَّهُ","لَتَصرِفُ لي أَنيابُهُ بِالمَتالِفِ",5,"ف",1,0],["كَما طافَ أَيتامٌ بِأُمٍّ حَفِيَّةٍ","بِهِم وَأَبٍ قَد فارَقَتهُم شَمايِلُه",6,"ل",2,0],["كَما طَعَنَ المِقدامُ في الحَربِ دَارِعاً","بِعَضْبٍ فَشَقَّ الخَصرَ مِنهُ إِلى الخصرِ",7,"ر",1,0],["كَما طافَ أَبكارٌ هِجانٌ بِمُصعَبٍ","طَرِبنَ لِأَعلى هَدرِهِ وَهوَ سامِدُ",8,"د",1,0],["كَمَا طِبْتُ نَفْساً بِالَّذِي أَنْتَ قَائِلٌ","وفارَقَنِي الْيَأْسُ الَّذِي كانَ مُوجِعِي",9,"ع",2,0],["كما طَعَنَ المقدامُ في الحرب دارعاً","بِغَضَبٍ فشقّ الخصرَ منه إلى الخصر",10,"ر",1,0],["كم اطلع الشمس بهم ساهرا","اغفل نجما وارى كوكبا",11,"ب",2,0],["كما طالَ ليلُ الحِبر عندى ومالَه","إلى الضوء من صبح البياض سبيلُ",12,"ل",1,0],["كَم أَطالَت مدى الرَحيل وَوالَت","هُ فعادَت بِالخَير وَالسَرّاءِ",13,"ا",2,0],["كَما طَرَقَت رِياضَ الحَزنِ وَهناً","شآمِيَةٌ لَها ذَيلٌ بَليلُ",14,"ل",1,0],["كَم أَطلَعَت لَيلاً سَنابِكُ خَيلِهِ","وَالبيضُ شَمساً وَالأَسِنَّةُ كَوكَبا",15,"ب",2,0],["كَم أَطنَبَ الناسُ في وَصفِ العِذارِ وَكَم","في سَوسَنِ الرَوضِ قالوا لا يُقارِنُهُ",16,"ن",2,1],["كما طَوَّقْتَني المِنَنَ البَوادي","لقد أَقْرَطْتُك الدُّرَر الثّمائن",17,"ن",1,0],["كَما طافَ مِنَ الدائِ","رِ حَولَ النُقطَةِ الخَطُّ",18,"ط",1,0],["كم أطلقوا دَعْوَى عروبتهم","ولها أقاموا حَفْلَةَ العُرْسِ",19,"س",1,0],["كمْ أطْفأوا نيرانَ هتْكِ فضيلةٍ","وحموا بعونِ الله عِرْضَ كِرامِ",20,"م",1,0],["كم أطلقت من أسر كل بلاغة","في الخافقين وقيدت من مطلق",21,"ق",1,0],["كَم أَطَعتمْ أَمراً لَنا وَاِطّرَحنا","ما تَقولون ذِلَّةً وَاِحتِقارا",22,"ر",2,0],["كم أطرب الأسماع شعرك لم أجد","يشدو مثلك بلبلا أو طائرا",23,"ر",2,0],["كما طغوا في سالف الزمانِ","واكتسحوا مغارب البلدانِ",24,"ن",1,0],["كم أطفأت عن أهلها من غلَّه","ورفّأت بخيرها من خِلّهْ",25,"ل",2,0],["كَمْ أَطِّرِحُ الملال فامنُنْ","باللهِ عليكَ باطِّراحي",26,"ح",2,0],["كما طلع النَّسرُ المنيرُ مُصفِّقاً","جَنَاحيه لولا أن مطلَعه غُفل",27,"ل",1,0],["كَما طافَ خَيرُ الرُسلِ بِالكَعبَةِ الَّتي","يَقولُ دَليلُ العَقلِ فها بِنُقصانِ",28,"ن",1,0],["كَم أطيلُ الخَوضَ في لَي","لٍ مِنَ الفِكرِ مُضِلِّ",29,"ل",1,0],["كما طربت أباريق الندامى","إلى أصوات قهقهة القناني",30,"ن",2,0],["كما طلع المليك عليه تاج","فاطرقت الوجوه له تدين",31,"ن",1,0],["كم أُطلق الأفكار دون تعمّقٍ","فيلوح فيها منطق المتعمق",32,"ق",1,1],["كَم أطفَأت ناراً تَأجج شَرها","وَفرت بُطون الناكِثين بِخنجر",33,"ر",1,0],["كَم أطعموا مِن جائِعين وَكَم كسوا","مِن كُل عار في العِباد مُجردِ",34,"د",1,0],["كم أطلعت من بدور تم","لا تعرف النقص والمغيب",35,"ب",1,0],["كما طاف في مغناه للغنم معشر","تراه مطافا فيه نيل المغانم",36,"م",1,0],["كم أطنبو فيه الأكابر كم لنا","جاءت بما قد حاز من أخبار",37,"ر",1,0],["كم أطافت به الكتائب شهباً","وتجارت أمامه الفرسان",38,"ن",1,0],["كَم أَطلَقوا مِن أَلفِ باسِق نَخلَة","مِن كُلِّ ميرِيٍّ مُعافى سَرمَدي",39,"د",2,0],["كم أطفأ البحر أشجاني برقته","وأغرق الهم والضوضاء والتعبا",40,"ب",2,0],["كما طورنا نادي قدوماً مؤرَّخاً","عليماً بنصر اللَهِ فخري توطَّدا",41,"د",2,0],["كم أطعمت من حاضر أو بادي","من قصعةٍ أو حثيةٍ من زاد",42,"د",1,0],["كم أطلعت من بعد ما","غامت سماء المجد بدرا",43,"ر",2,0],["كم أطلعت آفاق أوراقه","للمشتري من كوكب دري",44,"ر",2,0],["كم أطلعا شمس الندى","من أفقها بعد الغروب",45,"ب",1,0],["كم أطربت أنغامه مؤمناً","يأبى عن الأوتار غير النفار",46,"ر",1,0],["كم أطلقتهُ بالهوى سهما فما","يتأخر الملهوف أو يتأنّى",47,"ن",2,0],["كما طاب ميلادك المستني","رُ بذكرى لكل الورى لازمة",48,"م",2,0],["كما طال بعدك والظلام مخيم","أمد البلاء وقد يكون قصيرا",49,"ر",2,0],["كم أطال الصّد دهراً مضّني","أرتجي من طيفه أن أتبعَه",50,"ع",2,0],["كم أطرد النزغات وهي كواسرٌ","لأقِضًّ مضجع ربها في حانه",51,"ن",2,0],["كم أطرقتْ عيناً لها بمودة ٍ","وكأنَّها في عشقِها ورقاءُ",52,"ا",2,0],["كما طفرةُ المفتون إمّا تمخضت","قصيدا جنونيا ..تألّه فاتنه",53,"ن",2,0],["كمْ أطْرَبَتها دندناتُ رسائلي ..","والعينُ تُرسِلُ فرحةً رقراقَها ..!",54,"ق",3,0],["كَمْ أطرَبَ السمعَ فيكَ يا طَرَبيِ","حتى أصِيبَ سمعي من تَواصِلِهِ",55,"ل",2,0],["كَمْ أَطْرَبَتْنِي مِنْ حِكَايَةِ عَاشِقٍ","فَعَلِمْتُ أَنَّ سِوَايَ كُلٌّ يَدَّعِي",56,"ع",2,0],["كَمْ أطرفتْ صَداً وأنتَ بجنبِها","بلْ كنتَ مقتولاً يُحاولُ قتلَها",57,"ل",3,0],["كم أطلق السهم رام يحسن الرمية","وأخلص السهم لكن راغت الظبية",58,"ي",2,1],["كَما طَير مَكسور الجَناحين بِالخَلا","في بر مُوحش وَالوُحوش أَعداه",59,"ا",2,0]]}