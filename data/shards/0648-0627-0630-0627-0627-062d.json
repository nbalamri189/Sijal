{"poems":[[49,"قد عرفنا مغزاك ياعيار","https://www.aldiwan.net/poem25255.html","الخفيف"],[53,"خجلت خدود الورد من تفضيله","https://www.aldiwan.net/poem10876.html","الكامل"],[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[93,"فتنته محاسن الحريه","https://www.aldiwan.net/poem62823.html","عموديه"],[91,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[87,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[47,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[47,"من سائل لمعذر عن خطبه","https://www.aldiwan.net/poem10888.html","الكامل"],[47,"لم يبق في تلك الرسوم بمنعج","https://www.aldiwan.net/poem62668.html","الكامل"],[50,"جاهر بنفسك واهتك السترا","https://www.aldiwan.net/poem66621.html","الكامل"],[78,"الله جرد للندى والباس","https://www.aldiwan.net/poem39281.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85448","الكامل"],[108,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[108,"صاحب ثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=179530",""],[133,"يا أخي يا اخي المصاعب شتى","https://www.aldiwan.net/poem67454.html","الخفيف"],[164,"ألقى على كرسيه أجسادا","https://www.aldiwan.net/poem58793.html","الكامل"],[164,"لو يستطيع تخطي الأيام","https://www.aldiwan.net/poem58849.html","الطويل"],[164,"كانت أحادا عند غيرك لا ثنا","https://www.aldiwan.net/poem58919.html","الكامل"],[173,"سائل ديار الحي من ماوان","https://www.aldiwan.net/poem1687.html",""],[203,"دارت عليها للهوى راحة","https://www.aldiwan.net/poem45173.html","السريع"],[203,"هذا الدجى والهم في صدري","https://www.aldiwan.net/poem45622.html","أحذ الكامل"],[208,"صار التغزل في هواه عتابا","https://www.aldiwan.net/poem53367.html","الكامل"],[240,"وبخيلة سمح الرقا","https://www.aldiwan.net/poem32174.html","مجزوء الكامل"],[266,"وربما ضاقت الأمور على المرء","https://www.aldiwan.net/poem38351.html","الخفيف"],[303,"برح الخفاء فلست أكتم لوعة","https://www.aldiwan.net/poem36808.html","عموديه"],[409,"هات واسق الذهن من خمر العلوم","https://www.aldiwan.net/poem33343.html","مجزوء الرمل"],[438,"نمت بسر غرامه الأجفان","https://www.aldiwan.net/poem12412.html","الكامل"],[463,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[500,"قسما لقد عجم الزمان","https://www.aldiwan.net/poem9819.html","مجزوء الكامل"],[534,"دمت رب الإصدار والإيراد","https://www.aldiwan.net/poem37449.html","الخفيف"],[556,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[556,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[567,"أفراقا حسبتها أم لقاء","https://www.aldiwan.net/poem52986.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138418",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138324",""],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34414","الكامل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146223","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120089","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119977","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77969","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101063","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116543","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27451","الرمل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21453","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126231","المتدارك"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137236",""],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129832","الرمل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130796",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131289",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114310","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"],[4130,"","https://poetry.dctabudhabi.ae/diwan/poem/198746","الكامل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216343",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52133","الرمل"],[5145,"قف بالمطيّ فلات حين مناص","https://www.poetsgate.com/ViewPoem.aspx?id=108223",""],[2365,"أيها الطالب أجمل واقتصد","https://www.poetsgate.com/ViewPoem.aspx?id=200664",""],[5358,"طرقتُ بابَك","https://www.poetsgate.com/ViewPoem.aspx?id=183427",""],[5956,"لله أشكو ذلّتي","https://www.poetsgate.com/ViewPoem.aspx?id=182498",""],[5997,"جائحة","https://www.poetsgate.com/ViewPoem.aspx?id=214297",""]],"verses":[["وَإِذا أَحدَثَ الحَبيبانِ أَمراً","كانَ فيهِ عَلى المُحِبِّ الخِيارُ",0,"ر",1,0],["وإذا احْتَفَظْتَ به فأمتَعُ صاحبٍ","بحياته لو أن حيَّاً خالدُ",1,"د",1,0],["وإذا احتبَى في مجلسٍ","فكأنما أرسى ثبيرُ",2,"ر",1,0],["وَإِذا أَحرَجَ الضِعافَ قَوِيٌّ","نَسِيَت ضَعفَها النُفوسُ الأَبِيَّه",3,"ي",2,0],["واذا احصيتها","لي فاستر خجلك",4,"ك",1,0],["وَإِذا اِحتَمى الأَقوامُ بِاِستِقلالِهِم","لاذَوا بِرُكنٍ لَيسَ بِالمَدكوكِ",5,"ك",1,0],["وَإِذا أَحمَدُ اِستَهَلَّ لِنَيلٍ","أَكثَرَ النَيلَ واهِباً وَأَطابَه",6,"ب",2,0],["وَإِذا اِحتَبى في عُقدَةٍ مِن حِلمِهِ","يَوماً رَأَيتَ مُتالِعاً في هَضبِهِ",7,"ب",2,0],["وَإِذا اِحتَبى في أَسوَدانَ لِسُؤدُدٍ","أَعطاكَ حَبوَةَ حاتِمٍ في الحَشرَجِ",8,"ج",1,0],["وإذا أحلّ المحرمون فغنّنى","يا من يلاحظُ خيفةُ شزرا",9,"ر",2,0],["وإِذا أَحَبَّ اللَّهُ يوماً عَبْدَهُ","أَلقَى عَليهِ مَحَبَّةً لِلنَّاسِ",10,"س",1,0],["وإذا أَحاطَت قوة","يستسلم البطل المشايح",11,"ح",1,0],["وإذا أحبَّ، فلن تراهُ محابيًا","شتَّان بين: حبيبه، وحبائه",12,"ا",3,0],["وإذا أحس الجو رقعة وجهه","صيفًا، تلبد بالغيوم وأمطرا",13,"ر",2,0],["واذا احلَولكَ الظلامُ أضأنا","مَشعَلَ القلبِ مثلَ نار المَواقد",14,"د",1,0],["وإذا أحبَّ الله عبداً زادهٍ","بالامتحان له هدى ورشادا",15,"د",2,0],["وإذا أَحب اللهُ عبداً حبَّه","من كان منسوباً إلى الإِسلامِ",16,"م",1,0],["وإذا أحبُّ الله عبداً لم يزل","يُبدي له الآيات حتى يوقنا",17,"ن",2,0],["وَإِذا اِحتَبى وَسطَ النَدِيِّ رَفعتَهُ","عَن أَن تُشَبِّهَهُ بنُو شَروانِ",18,"ن",1,0],["وإذا احتمى بكما الكرى","بعدَ التفرقِ فاطرُداهُ",19,"ه",1,0],["وإذا احتجبتَ ففي الحجابِ هوى","وجمالُ ذاتِ الخدرِ في الخدرِ",20,"ر",1,0],["وإذا أحَبَّ اللّهُ عبداً منكم","أجرى على يدِهِ النجاحَ مثابا",21,"ب",2,0],["وَإِذا اِحتَبى في مَحفَلٍ","عَدَّ الكِرامَ أَباً أَبا",22,"ب",2,0],["وإذا احلولك الدجى فجدير","ان للصباح فيه انبلاج",23,"ج",1,0],["وَإذا أُحاول كظمَها حرجتْ بها","نفسي وَلستُ مفرِّجاً إحراجها",24,"ج",3,0],["وإذا أحرزته فَلْتَنْتَقِلْ","هاجراً رسطال",25,"ل",1,0],["وإِذا أَحبَّ الله عبداً لم يَزَلْ","لِهَواهُ في كُلِّ القلوبِ مَكانُ",26,"ن",1,0],["وإذا احتشمتُ فلم أزر عرصاتِهِ","إذ هنّ بعد الخصب منك مُحولُ",27,"ل",1,0],["وإذا أحلني السما","ءَ فدون مقداري قُعودا",28,"د",2,0],["وَإِذا احْلَوْلكَتْ خُطُوبٌ أَنارَتْ","بَعْدَها الْمُشْرِقاتُ بالإسْعادِ",29,"د",1,0],["وَإِذا اِحتبى فَعلى السّكينةِ والنُّهى","وَإِذا اِختَطى فإِلى المحلِّ السامي",30,"م",2,0],["وَإِذا اِحتبى في رَجعِ مَظْلَمَةٍ","فَوَقارُهُ لَم يُعطَه الهَضْبُ",31,"ب",1,0],["وإذا أحسَنَ الزمانُ فلا تَغْ","ترَّ واعلَمْ بأنهُ قد اساءَ",32,"ا",2,0],["وإذا أحب الله أقواماً شفى","امراضهم فينيلهم اقصى المنى",33,"ن",2,0],["وإذا احبك كلنا لا غرو اذ","من قبل مرأى قد أحبك مسمع",34,"ع",1,0],["وَإِذا أَحبَّكَ مَن يَراكَ تَسودُهُ","كانَ الدُعا وَالمَدحُ غايَةَ جهدِهِ",35,"د",2,0],["وإذا احتبَى قربوسهُ بعنانهِ","علكَ الشَّكيمُ إلى انصرافِ الزَّائرِ",36,"ر",1,0],["وإذا احتبى كالبدر حف","ف سريره ضيفانه",37,"ن",2,0],["وإذا احتبى في دستهِ","يسدي المكارم والأيادي",38,"د",2,0],["وإذا أحدّث عنك أتحف سامعي","بمصحّح وبمرسل ومسلسل",39,"ل",1,0],["وَإِذا أَحلَت عليه قال لأَنَّني","كنتُ الأَمير وَكنت أَنتَ المؤمرا",40,"ر",2,0],["وإذا أحب اللَه في الناس امرأ","ألقى عليه محبة السلطان",41,"ن",1,0],["وإذا أحصنت يوماً أمةٌ","بنكاحٍ ثم لم تنكح أحد",42,"د",1,0],["واذا أَحَبَّتني العراقُ فَهَيِّنٌ","عندي إِذا نشزَت عليَّ عمانُ",43,"ن",1,0],["وإذا أحسنتُ فعلاً فأنا","بك ربي أدباً أوصله",44,"ل",2,0],["وإِذا احزأَلا في المُناخِ رأَيتَهُ","كالطَّودِ أَفردهُ العَماء المُمطِرُ",45,"ر",1,0],["وإذا أحكَمتَ بِدايَتَهَا","وإذا حاولتَ نِهايَتَهَا",46,"ه",2,0],["واذا احتفى يا جورج فيك افاضل","فلقدقضوا لك ذمة وديونا",47,"ن",2,0],["وإذا أحسب في الديوان لم","يدرِ كتّابهمُ ما أحسِبُ",48,"ب",1,0],["وإذا احبّ لمالها وجمالها","وغدا بفيض منهما ريانا",49,"ن",2,0],["وإذا احتوتهم للرقاد مضاجعٌ","حلموا بأنهم بكم سعداء",50,"ا",2,0],["وَإِذَا أحْبَبْتَ أوْ أبْغَضْتَ لاَ","تَتَوَغَّلْ رُبَّمَا الأمْرُ انْتَقَلْ",51,"ل",1,0],["وإذا أحلولكت خطوب فناهي","ك بشمس النهى سراجا منيرا",52,"ر",2,0],["وإِذا أحبك عالم من «بُو ظبي»","حتى «فلبّينٍ» إلى «إنجلْترا»",53,"ر",2,0],["وإذا احصلَت لِك راحِةٍ فِيْ مِذَلَّه","مَع نِعمِةٍ ما عَنك يَبعِد زوالها",54,"ل",3,0],["وإذا احتجنا الغنى عند اللزومْ","فيدي في يده للوطَرِ",55,"ر",1,0],["وإذا احتبى للمكرمات أعاذه","روح الأمين بسورة الإخلاص",56,"ص",1,0],["واذا أحكمت عقدا فاعلمن","أن هذا الموت حلّال العقد",57,"د",1,0],["وإذا أحَبَّكَ مَنْ يَراكَ","أَحَبَّ في المَرْعَى كِلابَكْ",58,"ك",1,0],["وإذا احتوتني أسرةٌ تمضي لها","في حربها الشعواء دون رويّةِ",59,"ه",1,0],["وإذا أحسست بأعراضٍ","فتذكّر ما قد اهدونا",60,"ن",2,0]]}