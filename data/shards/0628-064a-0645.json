",""],[5582,"خلّ المتيّم في نهج الغواياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=63473",""],[5672,"مجمرة الوهن","https://www.poetsgate.com/ViewPoem.aspx?id=206449",""],[5690,"بيمين سلطاننا عبد الحميد غدت","https://www.poetsgate.com/ViewPoem.aspx?id=172233",""],[5690,"بيمن سلطاننا عبد العزيز","https://www.poetsgate.com/ViewPoem.aspx?id=172150",""],[5703,"اللقاء الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=206134",""],[5703,"ليلى والذئب","https://www.poetsgate.com/ViewPoem.aspx?id=206325",""],[5758,"تَرَاتِيلُ الشَّمْس","https://www.poetsgate.com/ViewPoem.aspx?id=200496",""],[5786,"مِلْ يمنَةً بلوى العقيقِ وبانهِ","https://www.poetsgate.com/ViewPoem.aspx?id=50659",""],[5809,"ياجمل","https://www.poetsgate.com/ViewPoem.aspx?id=205493",""],[5881,"يستر وجهها الشفق","https://www.poetsgate.com/ViewPoem.aspx?id=183822",""],[6023,"بي من الحَبْشِ غادة","https://www.poetsgate.com/ViewPoem.aspx?id=123902",""],[6142,"لا عذر للعين إن لم تنفجر علقا","https://www.poetsgate.com/ViewPoem.aspx?id=155754",""],[5309,"هذا هواك فودعي عهد الهوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573549",""],[520,"شأن الغرام اجل ان يلحاني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577660",""],[5567,"وصل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81770&r=&rc=38",""],[572,"ما أرتضي عَنْكَ بالرّياضِ غِنَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9480&r=&rc=337",""]],"verses":[["بي منْكَ ما لوْ غَدا بالشّمْسِ ما طَلَعَتْ","أو بالغَمامَةِ لمْ يُسْمَعْ لَها رعْدُ",0,"د",1,0],["بي مِثلُ مابِكَ مِن حُزنٍ وَمِن جَزَعٍ","وَقَد لَجَأتُ إِلى صَبرٍ فَلَم أَجِدِ",1,"د",1,0],["بيمن امرئٍ أحيى به ميت الرجا","وبدّل عسر الحادثات لنا يسرا",2,"ر",2,0],["بيمين متَّصل العلى حلف الورى","أن لا مثيل له بكلِّ يمين",3,"ن",1,0],["بي من بني الترك ساجي الطرف وسنان","ما الصبّ منه معاذٌ وهو فتَّان",4,"ن",1,1],["بي من درورِكَ واختصاصك جانبي","بالجدب حَرُّ صَلاً وحَزُّ مَواس",5,"س",1,0],["بيَ من حُبّيه بلوى","ما يوازيه اكتتامُ",6,"م",1,0],["بيَ ما يعجز عن أَد","ناه رضوى وشَمامُ",6,"م",1,0],["بِيَ مِن سُكرِ الهَوى ما","لَستُ عَنهُ بِمُفيقِ",7,"ق",1,0],["بي مثل ما بك يا قمرية الوادى","ناديت ليلى فقومي في الدجى نادي",8,"د",2,1],["بِيَ من جرحك ألف مثله","لا خلعُت السقم حتى يدعك",9,"ك",1,0],["بيمينه فالوذج","لم يهد للمتوكل",10,"ل",1,0],["بي مِثلُ ما بِكَ مِن جَوىً وَنَوىً","أَنا في الأَنامِ وَأَنتَ في القُمرِ",11,"ر",1,0],["بي منكَ ما لو غَدا بالماء كدَّرهُ","من الكآبة أو بالنجمِ لانكدَرا",12,"ر",2,0],["بِيَمينَينِ تُفيدانِ الغِنى","وَالأَيادي البيضُ لِلأَيدي اليُمُن",13,"ن",1,0],["بِيُمنِ خِلافَةِ المُعتَزِّ عادَت","لَنا حَقّاً أَكاذيبُ الأَماني",14,"ن",2,0],["بي ما تحس وفي فؤادِكَ ما بي","فتعالَ نبكي يا نجيَّ شبابي",15,"ب",2,1],["بي ما تحسّ وفي فؤادك ما بي","فتَعال نبكِ أيا نجيَّ شبابي",16,"ب",2,1],["بيمينٍ صَيّرَتْ خاتمها","تاجَ عَضْبٍ يقطفُ الهامَ يمان",17,"ن",1,0],["بِيُمْنِ أكبرَ لا عابٌ يُنَاطُ به","يُمنَاهُ منشأُ صوبِ العارضِ الهطِلِ",18,"ل",1,0],["بِيُمنِ أَبي إِسحاقَ طالَت يَدُ العُلى","وَقامَت قَناةُ الدينِ وَاِشتَدَّ كاهِلُه",19,"ل",2,0],["بِيُمنِ مُعتَصِمٍ بِاللَهِ لا أَوَدٌ","بِالمُلكِ مُذ ضَمَّ قُطرَيهِ وَلا خَلَلُ",20,"ل",1,0],["بي مِنْ بناتِ المغلِ مَنْ","تفضحُ مني ما ما استترْ",21,"ر",1,1],["بيَ مَنْ لا يقاسُ بالغصنِ حاشا","وذلكَ القدُّ مِنْ غضونِ الغصونِ",22,"ن",1,0],["بي منْ بنات المغلِ مَنْ","تفضحُ مني ما استترْ",23,"ر",1,1],["بيَ مَنْ لوْ قالَ لي مبسمُهُ","ادنُ والثمْ غرتُ أنْ ألثمَهُ",24,"ه",1,1],["بي من الخرْسِ شادنٌ","ليتَ شانيهِ لمْ يكنْ",25,"ن",1,1],["بي مِنْ جفاهُ وعطفِهِ","أصلٌ لخوفي والرجا",26,"ج",2,1],["بِيَمينِهِ يَومَ الوَغى وَشِمالِهِ","ماشاءَ مِن نارٍ وَمِن إِعصارِ",27,"ر",1,0],["بِيُمْنِكَ يا عمَّ الرسولِ تَتابعَتْ","أيادٍ يراهَا المسلمونَ ذخائرا",28,"ر",2,0],["بيُمْن أسنَى أُميَّةٍ حَسَباً","وخيرِهم رافداً لمُرتفدِهْ",29,"د",2,0],["بيَ منكَ ما لو غَدا بالشمسِ ما طلَعتْ","من الكآبَةِ أوْ بالبَرْقِ ما وَمَضَا",30,"ض",2,0],["بِيُمْنِهِ تُدْرَكُ الأَوْطَارُ سَاعِيةً","لَهَا بِأَبْرِعِ تَقْرِيبٍ وَتَمْهِيدِ",31,"د",1,0],["بِيُمنِهِ كُنتُ مَهما","نَصَبتُ لِلَّيثِ صِدتُه",32,"ت",2,0],["بي ما علمتُ من الأسى الدامي وبي","من حرقةِ الأعماقِ ما لا أعلمُ",33,"م",1,0],["بي مِنْ جراحِ الروحِ ما أدري وبي","أضعافُ ما أدري وما أتوهّمُ",33,"م",1,0],["بِيُمْنِهِ قَدْ بَلَغْتِ أَوْجا","وَعِشْتِ في قِمَّةِ السُّعُودِ",34,"د",1,0],["بي من الحُزن والكآبةِ من فقدان","ه ما يقطِّعُ الأَكبادا",35,"د",2,0],["بِيُمنِ تَعَلُّقٍ مني إلَيهِ","تَأَلَّقَ بَرقُ إِيمَاني اليَمَامنِا",36,"ن",2,0],["بيُمنِ الإمامِ الصالحِ المُصلح الرِّضا","نضى سيفَهُ الإسلامُ فاستأصَلَ الكُفرا",37,"ر",2,0],["بِيُمنايَ مِنها صَعدَةٌ وَبِأُختِها","مِجَنٌّ وَقِدماً كُنتُ أَعزَلَ أَكشَفا",38,"ف",2,0],["بيُمنِ أمير المؤمنين وَمَنِّهِ","وعزة هذا الأمر هذي الرغائب",39,"ب",1,0],["بِيُمنِ رَسولٍ خُصَّ بِالفَضلِ في الأَزَل","فَقامَ بِهِ وَزنُ الدِيانَةِ واِعتَدَل",40,"ل",1,0],["بي مِنْكَ ما لَيْسَتْ تُحَدُّ صِفَاتُهُ","حَاشاكَ أَنْ تُبْلى بِهِ حَاشاكَ",41,"ك",1,0],["بي من فتور المقلةِ الكحلاءِ","ما أَولع اللحظاتِ بالاعضاءِ",42,"ا",2,1],["بيُمنِ خَتلغَ بَلكا سيِّدِ الوزرا ال","أَميرِ حقاً عميدِ الملك خواجَه بِكِ",43,"ك",1,0],["بي منكمُ خَنِثُ الجفون يَشوبُها","خَفَرٌ أَقام قيامَة المُتَنبِّه",44,"ب",2,0],["بي مابخصرِك من سُقْمٍ وموجِبهُ","صَدٌّ كرِدفك تعنيفا وعدوانا",45,"ن",2,0],["بي مثل ما بك من شوق ومن كمدِ","لكن أغطّي الهوى بالصبر والجلدِ",46,"د",1,1],["بي مذ رأى الف السهاد فقال لي","من صاد نومك قلت عين الراءي",47,"ا",2,0],["بيمينه في الحرب حتف الممترى","وحياتها في السلم للممتار",48,"ر",1,0],["بِيَ ما لَو أَنَّ أَيسَرَهُ","بِالقِنانِ الصُلبِ زَعزَعَهُ",49,"ع",2,0],["بي من الغانيات ذات غناء","حسنٍ كله شجون وشجو",50,"و",1,0],["بي من الدهر خطوب جمة","اشفعت منها متاحاً بمتاح",51,"ح",1,0],["بِيُمْنِكَ يا أَبا الْيُمْنِ اسْتَطَلْنا","إِلى الْعَلْياءِ مِنْ كَرَمِ الْخِلالِ",52,"ل",1,0],["بي مِن بَني التُركِ ساقٍ مِن لَواحِظِهِ","سُكري وَإِن لَم يَكُن بِالكَأسِ يَسقيني",53,"ن",2,0],["بي مِن مُحاوَرَةِ الزَمانِ ضَمانَةٌ","سَيُميطُها عَنّي الغَداةَ ضَمانُهُ",54,"ن",2,0],["بي مِن بَني التُركِ هَضيمُ الحَشا","أَحوَرُ مَعسولُ اللَمى أَشنَبُ",55,"ب",1,0],["بي من هوى الغيدِ ربَّات التدلُّلِ ما","لو كان بالفَلَكِ الدوّارِ لم يدر",56,"ر",1