https://www.poetsgate.com/ViewPoem.aspx?id=192358",""],[5978,"آمال عجاف","https://www.poetsgate.com/ViewPoem.aspx?id=191287",""],[5309,"ما اختيالي بحسن وجه ومال","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573961",""],[6198,"غمز الشموس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79228&r=&rc=1",""],[454,"كنوز الحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82668&r=&rc=32",""],[6300,"كلمات في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82851&r=&rc=22",""]],"verses":[["ما أَخطَأَتكَ سِهامُ الدَهرِ رامِيَةً","فَما أُبالي مِنَ الدُنيا بِمَن تَقَعُ",0,"ع",1,1],["ما أَخطَأَتكَ النائِبا","تُ إِذا أَصابَت مِن تَحِبُّ",1,"ب",1,0],["ما أَخفَقَ المُزجي إِلَيكَ رِكابَهُ","حَتّى يَراكَ وَلَم يَخِب مَن أَمَّلَك",2,"ك",1,0],["ما أخطأتْ سنن العلا","إذ هذّيتك يد العناية",3,"ا",3,0],["ما إخالُ المديح يوجب حقاً","لي عليكم كما يرى المسبوتُ",4,"ت",1,0],["ما أخذ الشاتمُ إلا ما تركْ","وهل على الشاتمِ إلا ما مَلكْ",5,"ك",1,0],["ما اختارَ إلا امرءاً أضحتْ فضائلُه","يُثني عليه بها راضٍ وغضبان",6,"ن",1,0],["مَا إخالُ النُّجُومَ إلاَّ دُموعاً","ذَرَفَتْها محاجِرُ الأَعوامِ",7,"م",1,0],["ما اِختارَ أَمراً إِلّا تَوَهَّمَهُ","رَداهُ أَو ظَنَّ أَنَّهُ عَطَبُه",8,"ب",2,0],["ما أَخوَنَ الناسَ لِلعُهودِ وَما","أَشَدَّ إِقدامَهُم عَلى الحَلفِ",9,"ف",1,0],["ما اِختَصَرتُ التَردادَ إِلّا لِعُذرٍ","لِيَ يُغني عَن وَصفِهِ الإِشتِهارُ",10,"ر",1,0],["ما اختار إلا الجِدَّ يَجْعَلُه","نَجواهُ إن قَلمُ امرئٍ هَزَلا",11,"ل",2,0],["ما أَخلَفَ اللَهُ مِن وَعدٍ وَلا كَذَبَت","آمالُ شَعبٍ بِلُطفِ اللَهِ مَشمولِ",12,"ل",1,0],["ما أخيبَ النفسَ في الدُّنيا وأخسرَها","إن أخطأ النفسَ إيمانٌ وإسلامُ",13,"م",1,0],["ما اختارَ نُصرةَ دينِه أو رأيهِ","من لا يرى أن الفداءَ المذهب",14,"ب",1,0],["ما أخَّرَ اللّهُ هذا الفَتحَ منذُ نَما","إلاّ ليَصْحَبَهُ بالعِدَّةِ الكَمَل",15,"ل",1,0],["ما إخال الحياة غير جهادِ","طاحنٍ للشعوب والأفرادِ",16,"د",1,1],["ما اِختلاف هناك في السير إلا","لاختلاف في وجهة الأنواء",17,"ا",2,0],["ما أخذت غير صفي الروح","كاللطف من روح سرى لروح",18,"ح",1,0],["ما اخْتَصَّ فَاجِعُ خَطْبِكَ التَّمْثِيلاَ","عَمَّ البِلاَد أَسى وَنَالَ النِّيَلا",19,"ل",2,1],["مَا أَخْطَأَتْنِي كُتْبُهُ فِي فَرَحٍ","أَوْ تَرَحٍ بِحُسْنِ الاِفْتِقادِ",20,"د",1,0],["مَا اخْتَص لُبْنَانٌ بِمَا لَكَ مِنْ يَدٍ","شَمِلَتْ وَقَدْ أَوْلَيْتَهَا أَقْطَارَا",21,"ر",2,0],["ما أَخوَنَ الدُنيا الَّتي","واثَقتَها ما أَنقَضا",22,"ض",2,1],["ما أَخوَضَ الناسَ مُنذُ كانوا","في كُلِّ قالٍ وَكُلِّ قيلِ",23,"ل",1,0],["ما أخطأت مقلةٌ فيه له هدفًا","إن صوَّبتْ سهمها، والسهمُ حرنان",24,"ن",1,0],["ما اختاره الله صفوا من خلاصتهم","الا وللصفو من اكرامه شان",25,"ن",1,0],["ما اختتمنا تمثيل دور بدأنا","منه فصلا لكن فقدنا البراعه",26,"ع",2,0],["ما اختلفنا في ذكرِ فضلك لكن","ما ألونَا في الدين جهداً جِدَالا",27,"ل",2,0],["ما أخلدت منها العيون لقرة","إلاّ وقيّدَهن دمعٌ مطلق",28,"ق",1,0],["ما اخطاؤا بل أراد الله مكرمة","تملأ لك الأرض منها بالثنا العبق",29,"ق",1,0],["ما اخْترتُها عِوضَا ممن نشأتُ بها","ولا شفَى ليَ منها غُلَّةً أَرَبُ",30,"ب",1,0],["ما اخترت بعدك عكبرا","وطنا لبذل مفيده",31,"د",2,0],["مَا أَخُو خَمْسَةٍ جَلَتْهُ لِعَاقِلْ","مِثْلَ أَجْزَائِهِ أَسَامٍ لِفَاعِلْ",32,"ل",1,1],["ما أختُ مكة إِلا القدسُ فاحترمي","شرعَ النبيِّ وصونيها لقرباك",33,"ك",1,0],["ما اختلافُ النهارِ والليلِ إلاّ","كاختلافِ السيوفِ في الهيجاءِ",34,"ا",2,0],["ما أخذ العشّاقُ إلاّ عني","فما عليكِ إن بكيتِ جدِّي",35,"ي",1,0],["ما أَختَشي نارَ العُقو","لِ بِجَيشِ دينِهِمُ اللُهامِ",36,"م",1,0],["ما أخمدَ النيرانَ في سجِّينها","بجهنمٍ وسَجيرُها الشيطان",37,"ن",1,0],["مَا اختْاركَ الله مَلْكاً في بسيطتِهِ","إلاّ لتُخْمِدَ فيها جَمْرةَ الفتنِ",38,"ن",1,0],["ما اختراكَ الموْلَى لِتَحْمِي مُلْكَهُ","إلاّ لأَنَّكَ دِرعُهُ والمغْفَرُ",39,"ر",1,0],["ما اختلافي إليه إلا لأمرٍ","وهو في الخَلوةِ اختلافي عَليهِ",40,"ه",1,0],["مااختَرْتَ إلاّ مَهيناً عاجِزاً صَلِفاً","إنْ حالَ في أمرِهِ خَلْقٌ فَكَلَّ فَهو",41,"و",1,0],["ما اختارَهُ المَولى عَلى نُضرائِهِ","حَتّى اِرتَضاهُ الواحِدُ القَهَّارُ",42,"ر",1,0],["مَا أخْطأتْ فيكَ النّوى عادَاتِها","لكنَّ تَقْرِيفَ الكُلومِ أليمُ",43,"م",1,0],["ما أَخو الحزم سوى من يتَّقي ال","شادنَ الألْعَسَ والطَّرف الكحيلا",44,"ل",2,0],["ما اخت صخرٍ تضاهيني بفرط شجى","وليس أوجع مني اللحم والوفض",45,"ض",1,0],["ما اخلقوا عهدا ولا","خانوا ولا ارتكبوا جريمه",46,"م",2,0],["ما أخرج الشعر هذا من جوانحن","إلا المحبة لولا أمرها لأبى",47,"ب",2,0],["ما اخترتها طوعاً ولكن غضبةً","للحقِّ والأَحرار والشُّهداءِ",48,"ا",2,0],["ما إخال الحجَّ يقضِي فرضَه","مسلمٌ يوم رآهن سنحنا",49,"ن",2,0],["ما اختصَمَتْني فيهمُ قبيلةٌ","إلا وكنتُ غُصّةَ المخاصمِ",50,"م",1,0],["ما اختصَّ مني السَّقامُ جارحةً","على جهاتي أغراضُ منتبلي",51,"ل",2,0],["ما أخفَّ الأقدارَ في غبنِ حظّي","وتعفِّي أنسي وتفريق جمعي",52,"ع",2,0],["ما أخلقَ العاثرَ يمشي به","كسيرهُ أن يبتغي مَجْبَرا",53,"ر",2,0],["ما اختارت المختارَ لي إلا يدٌ","وثِقتْ لمُغرِسها بطيبِ جنَاتِها",54,"ت",3,0],["ما أخلُ حالةَ نكبةٍ أو نعمةٍ","من شامتٍ أو غابطٍ وحسود",55,"د",1,0],["ما اختفَى من هَوِيتَ طرفة عينٍ","عنكَ في الأرضِ غاصَ أو في السَّماء",56,"ا",2,0],["ما أَخشنَ الدَّهرَ على لينهِ","وأَخدعَ المرءَ بتلوينِه",57,"ن",2,1],["ما اخْتَصَّ بِي حادِثٌ مِنْهَا فأغْبَنُها","كَذاكَ شِيمَتُها في كُلّ ذِي أَدَبِ",58,"ب",1,0],["ما اِختار إلّا غادة","منها عبير المسكِ يأرج",59,"ج",1,0],["ما أَخْجَلَ البَدْرَ المُنيْرَ إذا مَشَى","يَختالُ والخُوْطَ النَّضيْرَ إذا خَطَا",60,"ط",2,0],["ما اختص أحمد بالخلافة أمة","علماً بأن الدائرات تدور",61,"ر",1,0],["ما أخطأتْ نوناته من صُدْغِهِ","شيئاً ولا ألِفاتُهُ من قده",62,"د",2,0],["ما أخي إلا أخو حسبٍ","مورقٌ بل مثمِر حسبُه",63,"ب",2,0],["ما أَخطأ الأيْمَ في تعوجه","شيئاً إذا ما استقامَ أو عرَّج",64,"ج",1,0],["ما اِخضَرَّ غُصنٌ ما بَدا مائِساً","ما قَد شَدا الوُرقُ عَلى الأَغصُنِ",65,"ن",1,0],["ما اِخضرَّ رَوضٌ ضَحوكُ الثَّغرِ مُبتسماً","مِن أَدمُعِ الغيثِ مِن قطرٍ ومنهملِ",66,"ل",1,0],["ما أَخَذا شَيئاً مِن المؤونَه","بَل تَبِعا قافِلَةً مَشحونَه",67,"ه",1,0],["ما اخضر ذاك الصدغ إلا بما","صعدت الأشواق من زفرتي",68,"ي",1,0],["ما أخطأ البعد عيني بالسهاد فها","أنا المصُاب هوى أبغي قليل رُقَى",69,"ق",2,0],["ما اختال مِذ نالها وهو المعدُّ لها","تيهاً ونالَته فاختالت به تيها",70,"ي",3,0],["ما اِخضرّ عارض خدِّه إلّا وقد","سادَ الأنامَ أعارباً وأعاجما",71,"م",2,0],["ما اِختَص عَزم دون قَصدك بِالعُلى","فَلوجهك التعظيم وَالإِجلال",72,"ل",1,0],["ما اخترتُ قتلي حين جردَ لحظهُ","سيفاً عليَّ وفتكهُ لا يجهلُ",73,"ل",1,1],["ما اختفت في غدائر مرسلات","كالليالي صيرنني ضليلا",74,"ل",2,0],["ما أخدع النفس لما تهواه","بحق لا إله إلا اللّه",75,"ه",1,0],["ما اخترتُ يوم رحيلى عن ديارِكمُ","لكنّهُنّ ذاتُ أقدارِ",76,"ر",1,0],["ما اخضر روض علائه إلا على","سحب الندى وجداول الأسياف",77,"ف",1,0],["ما اخضر حتى جاورته سحابةٌ","من راحتيك فعاد رونقه كما",78,"م",2,0],["ما أَخطَأَ الوَردُ مِنكَ لَوناً","وَطيبَ ريحٍ وَلا مَلالا",79,"ل",2,1],["مَا أخلَقَ المُلْكَ العَلِيَّ عِمَادُهُ","بِعَلِيٍّ الشَّهْمِ النَّزِيهِ البَاسِ",80,"س",1,0],["ما اختَصَّ في الدُّنْيا سواه بفَضْلها","مَلِكٌ من الباقين والهُلاّكِ",81,"ك",1,0],["ما أخوفني ما أطمَعَني","في موجِ نجاحٍ مُلتَطِم",82,"م",1,0],["مَا اختَارَ شَيئاً قَطُّ يَفعَلُهُ وَلاَ","هَذَا لَهُ أبداً بِذِي إمكَانِ",83,"ن",1,0],["ما أَخَّرَتني عَن جَنابِكَ هِمَّةٌ","وَجَدَت مِنَ الأَهواءِ عَنكَ مُعَوَّضا",84,"ض",2,0],["ما أَخَّرَتني عَنهُمُ قَدَمٌ","لَو كانَ فِيَّ وَفيهِمُ نَظَرُ",85,"ر",1,0],["ما اخضر روض سروري بعدما هجرت","ولا شجاني على افنانه الغرد",86,"د",1,0],["ما أخفا اللهُ لطالِبِهِ","من ذا خَرقُ ما لاقَ بِهِ",87,"ه",1,0],["ما اخترتُ عنك وقوفي إنما عِلَل","لم تخفْ عنك وعولٌ كله حَرَمُ",88,"م",1,0],["ما اختلف اثنان به وكيف ذا","وهو بجمع المكرمات مفرد",89,"د",1,0],["ما أخرج اللسان فابتلعه","وبالخلال اقذف ولا تدعه",90,"ه",1,0],["ما اخطات هدفاً ولا ضلت هدىً","ان تقتد بك ساسة الازمان",91,"ن",1,0],["ما اِختَرتُ مَنظومَ الكَلامِ تَهانِئي","مَهما يَكُن مِن جَيِّدِ الشُعَراءِ",92,"ا",2,0],["ما اختالَ في صحْن قَصْر أَوسٍ","إلا تسَجَّى له قَتيلُ",93,"ل",1,0],["ما اختار شعر سواك في إنشاده","إلا قرين بصيرة عمياء",94,"ا",2,0],["ما إِخال الزَمان يَبقى عَنيداً","ربما أَحسَن الَّذي قَد أَساءَ",95,"ا",2,0],["ما اِخترت إِلّا أَن تَدوم منعّماً","لَو قيل ماذا تَشتَهي وَتريدُ",96,"د",1,0],["ما أخْلَفَ الأرضَ الغَمامُ وأمْحَلَتْ","إلا وجَدْوى راحتَيْكَ تَجودُها",97