{"poems":[[53,"ما أخطأتك سهام الدهر رامية","https://www.aldiwan.net/poem30089.html","البسيط"],[53,"ما للهموم كأنها","https://www.aldiwan.net/poem30729.html","مجزوء الكامل"],[71,"أفديك من مولىً تملك خلتي","https://www.aldiwan.net/poem3973.html","الكامل"],[88,"ما للحقيقة من بداية","https://www.aldiwan.net/poem45063.html","مجزوء الكامل"],[51,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[51,"إني إذا ما الخصم في الغي ابترك","https://www.aldiwan.net/poem65823.html","الرجز"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[92,"يا رفيقي وأين أنت فقد","https://www.aldiwan.net/poem38907.html","الخفيف"],[45,"لا الدهر مستنفذ ولا عجبه","https://www.aldiwan.net/poem10901.html","المنسرح"],[45,"مرت على عزمها ولم تقف","https://www.aldiwan.net/poem65159.html","المنسرح"],[66,"حسدت جود كفك الأمطار","https://www.aldiwan.net/poem38683.html","الخفيف"],[105,"أعد الرجاء وجدد الأملا","https://www.aldiwan.net/poem42045.html","أحذ الكامل"],[105,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[105,"بني سليم أعدوا الخيل واحترسوا","https://www.aldiwan.net/poem43997.html","البسيط"],[105,"هو مرتمى الأبطال مالك دونه","https://www.aldiwan.net/poem44209.html","الكامل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85639","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55196","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54748","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54838","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43772","الرجز"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/2893","البسيط"],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[100,"حلوة الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=50384",""],[129,"وحباك الإله ملكا وإنصالا","https://www.aldiwan.net/poem50531.html","الخفيف"],[136,"جل المصاب وجاء عيد مشرق","https://www.aldiwan.net/poem49168.html","الكامل"],[161,"أرخا أثيث الدجى الجاني على الفلق","https://www.aldiwan.net/poem59000.html","البسيط"],[186,"يا ساحل الثغر كم أنأى وأغترب","https://www.aldiwan.net/poem14110.html","البسيط"],[187,"يا غاديا متوسطا","https://www.aldiwan.net/poem43974.html","مجزوء الكامل"],[238,"ما أخو خمسة جلته لعاقل","https://www.aldiwan.net/poem19067.html","الخفيف"],[271,"حبي الخليفة مولانا ومولاك","https://www.aldiwan.net/poem35652.html","البسيط"],[299,"لزوال جميع ما أنت رائي","https://www.aldiwan.net/poem36262.html","عموديه"],[299,"آليت في حبك رعي العهد","https://www.aldiwan.net/poem36315.html","عموديه"],[367,"ورأيت أجسام العداة","https://www.aldiwan.net/poem17261.html","مجزوء الكامل"],[378,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[403,"عزمت باليمن تحمي حوزة اليمن","https://www.aldiwan.net/poem46916.html","البسيط"],[403,"ملك به عز الشريعة مظهر","https://www.aldiwan.net/poem46933.html","الكامل"],[406,"قلت للسائلين لما رأوني","https://www.aldiwan.net/poem49674.html","الخفيف"],[406,"قل للذي خص بالحسنى أبا حسن","https://www.aldiwan.net/poem49850.html","البسيط"],[407,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[410,"ما استجهلتك معالم ورسوم","https://www.aldiwan.net/poem32386.html","الكامل"],[417,"لمن الركب وحيفا وذميلا","https://www.aldiwan.net/poem53988.html","الرمل"],[430,"حكم المنية سهم والورى عرض","https://www.aldiwan.net/poem40708.html","البسيط"],[444,"قف بالديار وحيها","https://www.aldiwan.net/poem56021.html","عموديه"],[450,"كنوز الحب","https://www.aldiwan.net/poem988.html",""],[454,"ست من السنوات جاوز عمرها","https://www.aldiwan.net/poem61591.html","الكامل"],[459,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[459,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[459,"عثرت يوم العذيب فاستقل","https://www.aldiwan.net/poem55993.html","المنسرح"],[459,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[459,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[459,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[465,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[539,"أنت ماذا دهاك قل لي حتى","https://www.aldiwan.net/poem48307.html","عموديه"],[576,"ما أخشن الدهر على لينه","https://www.aldiwan.net/poem2772.html","السريع"],[587,"تحرش الطرف بين الجد واللعب","https://www.aldiwan.net/poem17437.html","البسيط"]],"verses":[["ما أَخطَأَتكَ سِهامُ الدَهرِ رامِيَةً","فَما أُبالي مِنَ الدُنيا بِمَن تَقَعُ",0,"ع",1,1],["ما أَخطَأَتكَ النائِبا","تُ إِذا أَصابَت مِن تَحِبُّ",1,"ب",1,0],["ما أَخفَقَ المُزجي إِلَيكَ رِكابَهُ","حَتّى يَراكَ وَلَم يَخِب مَن أَمَّلَك",2,"ك",1,0],["ما أخطأتْ سنن العلا","إذ هذّيتك يد العناية",3,"ا",3,0],["ما إخالُ المديح يوجب حقاً","لي عليكم كما يرى المسبوتُ",4,"ت",1,0],["ما أخذ الشاتمُ إلا ما تركْ","وهل على الشاتمِ إلا ما مَلكْ",5,"ك",1,0],["ما اختارَ إلا امرءاً أضحتْ فضائلُه","يُثني عليه بها راضٍ وغضبان",6,"ن",1,0],["مَا إخالُ النُّجُومَ إلاَّ دُموعاً","ذَرَفَتْها محاجِرُ الأَعوامِ",7,"م",1,0],["ما اِختارَ أَمراً إِلّا تَوَهَّمَهُ","رَداهُ أَو ظَنَّ أَنَّهُ عَطَبُه",8,"ب",2,0],["ما أَخوَنَ الناسَ لِلعُهودِ وَما","أَشَدَّ إِقدامَهُم عَلى الحَلفِ",9,"ف",1,0],["ما اِختَصَرتُ التَردادَ إِلّا لِعُذرٍ","لِيَ يُغني عَن وَصفِهِ الإِشتِهارُ",10,"ر",1,0],["ما اختار إلا الجِدَّ يَجْعَلُه","نَجواهُ إن قَلمُ امرئٍ هَزَلا",11,"ل",2,0],["ما أَخلَفَ اللَهُ مِن وَعدٍ وَلا كَذَبَت","آمالُ شَعبٍ بِلُطفِ اللَهِ مَشمولِ",12,"ل",1,0],["ما أخيبَ النفسَ في الدُّنيا وأخسرَها","إن أخطأ النفسَ إيمانٌ وإسلامُ",13,"م",1,0],["ما اختارَ نُصرةَ دينِه أو رأيهِ","من لا يرى أن الفداءَ المذهب",14,"ب",1,0],["ما أخَّرَ اللّهُ هذا الفَتحَ منذُ نَما","إلاّ ليَصْحَبَهُ بالعِدَّةِ الكَمَل",15,"ل",1,0],["ما إخال الحياة غير جهادِ","طاحنٍ للشعوب والأفرادِ",16,"د",1,1],["ما اِختلاف هناك في السير إلا","لاختلاف في وجهة الأنواء",17,"ا",2,0],["ما أخذت غير صفي الروح","كاللطف من روح سرى لروح",18,"ح",1,0],["ما اخْتَصَّ فَاجِعُ خَطْبِكَ التَّمْثِيلاَ","عَمَّ البِلاَد أَسى وَنَالَ النِّيَلا",19,"ل",2,1],["مَا أَخْطَأَتْنِي كُتْبُهُ فِي فَرَحٍ","أَوْ تَرَحٍ بِحُسْنِ الاِفْتِقادِ",20,"د",1,0],["مَا اخْتَص لُبْنَانٌ بِمَا لَكَ مِنْ يَدٍ","شَمِلَتْ وَقَدْ أَوْلَيْتَهَا أَقْطَارَا",21,"ر",2,0],["ما أَخوَنَ الدُنيا الَّتي","واثَقتَها ما أَنقَضا",22,"ض",2,1],["ما أَخوَضَ الناسَ مُنذُ كانوا","في كُلِّ قالٍ وَكُلِّ قيلِ",23,"ل",1,0],["ما أخطأت مقلةٌ فيه له هدفًا","إن صوَّبتْ سهمها، والسهمُ حرنان",24,"ن",1,0],["ما اختتمنا تمثيل دور بدأنا","منه فصلا لكن فقدنا البراعه",25,"ع",2,0],["ما اختلفنا في ذكرِ فضلك لكن","ما ألونَا في الدين جهداً جِدَالا",26,"ل",2,0],["ما أخلدت منها العيون لقرة","إلاّ وقيّدَهن دمعٌ مطلق",27,"ق",1,0],["ما اخطاؤا بل أراد الله مكرمة","تملأ لك الأرض منها بالثنا العبق",28,"ق",1,0],["ما اخْترتُها عِوضَا ممن نشأتُ بها","ولا شفَى ليَ منها غُلَّةً أَرَبُ",29,"ب",1,0],["ما اخترت بعدك عكبرا","وطنا لبذل مفيده",30,"د",2,0],["مَا أَخُو خَمْسَةٍ جَلَتْهُ لِعَاقِلْ","مِثْلَ أَجْزَائِهِ أَسَامٍ لِفَاعِلْ",31,"ل",1,1],["ما أختُ مكة إِلا القدسُ فاحترمي","شرعَ النبيِّ وصونيها لقرباك",32,"ك",1,0],["ما اختلافُ النهارِ والليلِ إلاّ","كاختلافِ السيوفِ في الهيجاءِ",33,"ا",2,0],["ما أخذ العشّاقُ إلاّ عني","فما عليكِ إن بكيتِ جدِّي",34,"ي",1,0],["ما أَختَشي نارَ العُقو","لِ بِجَيشِ دينِهِمُ اللُهامِ",35,"م",1,0],["ما أخمدَ النيرانَ في سجِّينها","بجهنمٍ وسَجيرُها الشيطان",36,"ن",1,0],["مَا اختْاركَ الله مَلْكاً في بسيطتِهِ","إلاّ لتُخْمِدَ فيها جَمْرةَ الفتنِ",37,"ن",1,0],["ما اختراكَ الموْلَى لِتَحْمِي مُلْكَهُ","إلاّ لأَنَّكَ دِرعُهُ والمغْفَرُ",38,"ر",1,0],["ما اختلافي إليه إلا لأمرٍ","وهو في الخَلوةِ اختلافي عَليهِ",39,"ه",1,0],["مااختَرْتَ إلاّ مَهيناً عاجِزاً صَلِفاً","إنْ حالَ في أمرِهِ خَلْقٌ فَكَلَّ فَهو",40,"و",1,0],["ما اختارَهُ المَولى عَلى نُضرائِهِ","حَتّى اِرتَضاهُ الواحِدُ القَهَّارُ",41,"ر",1,0],["مَا أخْطأتْ فيكَ النّوى عادَاتِها","لكنَّ تَقْرِيفَ الكُلومِ أليمُ",42,"م",1,0],["ما أَخو الحزم سوى من يتَّقي ال","شادنَ الألْعَسَ والطَّرف الكحيلا",43,"ل",2,0],["ما اخت صخرٍ تضاهيني بفرط شجى","وليس أوجع مني اللحم والوفض",44,"ض",1,0],["ما اخلقوا عهدا ولا","خانوا ولا ارتكبوا جريمه",45,"م",2,0],["ما أخرج الشعر هذا من جوانحن","إلا المحبة لولا أمرها لأبى",46,"ب",2,0],["ما اخترتها طوعاً ولكن غضبةً","للحقِّ والأَحرار والشُّهداءِ",47,"ا",2,0],["ما إخال الحجَّ يقضِي فرضَه","مسلمٌ يوم رآهن سنحنا",48,"ن",2,0],["ما اختصَمَتْني فيهمُ قبيلةٌ","إلا وكنتُ غُصّةَ المخاصمِ",49,"م",1,0],["ما اختصَّ مني السَّقامُ جارحةً","على جهاتي أغراضُ منتبلي",50,"ل",2,0],["ما أخفَّ الأقدارَ في غبنِ حظّي","وتعفِّي أنسي وتفريق جمعي",51,"ع",2,0],["ما أخلقَ العاثرَ يمشي به","كسيرهُ أن يبتغي مَجْبَرا",52,"ر",2,0],["ما اختارت المختارَ لي إلا يدٌ","وثِقتْ لمُغرِسها بطيبِ جنَاتِها",53,"ت",3,0],["ما أخلُ حالةَ نكبةٍ أو نعمةٍ","من شامتٍ أو غابطٍ وحسود",54,"د",1,0],["ما اختفَى من هَوِيتَ طرفة عينٍ","عنكَ في الأرضِ غاصَ أو في السَّماء",55,"ا",2,0],["ما أَخشنَ الدَّهرَ على لينهِ","وأَخدعَ المرءَ بتلوينِه",56,"ن",2,1],["ما اخْتَصَّ بِي حادِثٌ مِنْهَا فأغْبَنُها","كَذاكَ شِيمَتُها في كُلّ ذِي أَدَبِ",57,"ب",1,0]]}