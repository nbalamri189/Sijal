qid=75731&r=&rc=39",""],[6202,"سبعون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86728&r=&rc=29",""],[6213,"جناح الذكرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76264&r=&rc=21",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[6259,"أذهبت رونق ماء الصبح في العذل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59394&r=&rc=42",""],[6288,"فراديس الرند","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78520&r=&rc=0",""],[572,"قالوا أبو أحمدٍ يبني فقلتُ لهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9406&r=&rc=263",""],[6359,"عقدة حجاجي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69089&r=&rc=3",""]],"verses":[["يَنتَظِرُ الحَيُّ بِهِم هَتفَةً","مِنَ النَواعي وَكَأَن قَد نُعِي",0,"ع",2,0],["يَنتَهي مِنها الوِشاحانِ إِلى","حُبلَةٍ وَهيَ بِمَتنٍ كَالرَسَن",1,"ن",1,0],["يَنتَويكَ المَوتُ في شَرخِ الصِبا","وَالشَبابُ الغَضُّ في البُردِ القَشيبِ",2,"ب",1,0],["ينتابها أبناؤكم كي يأخذوا","من كل فن بالنصيب الوافي",3,"ف",2,0],["يَنتابُنا جِبريلُ في أَبياتِنا","بِفَرائِضِ الإِسلامِ وَالأَحكامِ",4,"م",1,0],["ينتقلُ الناسُ وأحوالُهمْ","وأنت في الدنيا من الرُّتَّبِ",5,"ب",1,0],["يَنتحل الآدابَ مُسْحَنْفِراً","وأيُّها المسكين لم تُسلبِ",5,"ب",1,0],["ينتحي من عِدائه في الثَّنِيَّا","تِ ولَحْبُ الهدى له مَلْحُوبُ",6,"ب",1,0],["ينتحي فيها بجُرذا","ن كجرذان الحمار",7,"ر",1,0],["ينتقدُ الشعرَ ولا يعْرفُهُ","أكثر من قولته هذا النمطْ",8,"ط",1,0],["ينْتَمي كُلُّهُ إلى آلِ سامٍ","غير هاتيكَ فهْي من آلِ حام",9,"م",1,0],["ينتهبن المدى إليْه ويضْرمْ","نَ له الشَّدَّ أيَّما إضْرام",9,"م",1,0],["ينتحِلُ الدهرَ فيا ليته","لم يكُ ذا فيهِ وكان الغَبيّ",10,"ي",1,0],["يَنتابُني حَرَجُ الحياةِ كأنَّني","مِنهمْ بِوَهْدَة جَنْدَلٍ وصُخورِ",11,"ر",1,0],["ينتهى العيش عندها حين لا اليا","فع سالٍ ولا الكبير ملول",12,"ل",1,0],["يَنتَهي الحارِثُ بنُ كَعبٍ بنِ عَمرٍو","بُعُلاها حَيثُ اِنتَهى بُنيانُه",13,"ن",2,0],["يَنتَجِعونَ المَنايا في مَنابِتِها","وَلَم تَكُن قَبلَهُم في الدَهرِ تُنتَجَعُ",14,"ع",1,0],["يَنتابُ مَضجَعَهُ وينظرُ ما الذي","صنعَ القضاءُ فَهَمُّه مُتراكِمُ",15,"م",1,0],["يَنتحِي يثربَ بالنّورِ الذي","يملأُ الدنيا ويُعيي المطفئين",16,"ن",1,0],["يَنتَحِبُ القَومِ في مَنازِلِها","كَأَنَّ أَوطانِها مَقابِرُها",17,"ه",2,0],["يَنتَسِبُ الحُسنُ إِلى حُسنِهِ","وَالطيبُ يَحتاجُ إِلى نَكهَتِه",18,"ت",2,0],["يَنتابُهُ الأَقرَبُ الساعي بِذِمَّتِهِ","إِذا الزَمانُ كَبا وَالخابِطُ الجُنُبُ",19,"ب",1,0],["يَنتَفِعُ الناسُ بِما عِندَهُ","وَهوَ لَقىً بَينَهُم شاحِبُ",20,"ب",1,0],["يَنتَابُ بالعِرقِ مِن بُقعَانَ مَعَهَدةً","ماءَ الشَّريعَةِ أو فَيضاً مِنَ الأَجَمِ",21,"م",1,0],["يَنْتَابُنَا جِبْرِيلُ في أَبائِنَا","بِفَرَائِضِ الإسْلاَمِ والأَحْكَامِ",22,"م",1,0],["ينتشر ينشر حبال الأجل","تحسب الجيش وقد نشقه",23,"ه",1,0],["يَنْتَهي جُهْدُ كُلِّ مَدْحٍ وَوَصْفٍ","وَمَدَى فَضْلِهِ بِغَيْرِ انتِهَاءِ",24,"ا",2,0],["ينتمي، يدخل الشجيرات نسغاً","وإلى قلبهِ، يلُّم الجُذاذا",25,"ذ",2,0],["ينتضيني ، من يسمّى سيّدا","أو هجينا ، واليد المستهجنه",26,"ن",2,0],["ينتظرون السّحر من جبّاره","هيهات دون السّحر باب موصد",27,"د",1,0],["ينتحِلُ الدهر قد جلا","الشُّبهة َ البيانُ الخفيُّ",28,"ي",1,0],["ينتهك الحرمة لا تريغه","ضريبة من كرم ولا تقى",29,"ا",1,0],["£يَنْتحِي بالقَنَان يَقْرُو رِياضاً","فانتحى آتنا جدائدَ نورا",30,"ر",2,0],["يَنتابُ بِالعِراقِ مِن بُقعانَ مَعهَدَهُ","ماءَ الشَريعَةِ أَو فَيضاً مِنَ الأَجَمِ",31,"م",1,0],["ينتابك النوروز يجنُب إِثَرهُ","أعوامَ سعدٍ كلُّهن صقيلُ",32,"ل",1,0],["ينتظرون الإِذن في تقبيلهم","بين يديك الأرض فأذن واخترِ",33,"ر",1,0],["يَنتابُ ماءَ قُطَيّاتٍ فَأَخلَفَهُ","وَكانَ مَورِدُهُ ماءً بِحَورانِ",34,"ن",1,0],["يَنْتابُني من جيوشها أُمَم","إذا مضى فَيْلقٌ أتى فيلق",35,"ق",1,0],["يَنتَظِمونَ في الوَلاءِ سَيِّداً","مِن سَيِّدٍ وَكابِراً مِن كابِرِ",36,"ر",1,0],["يَنتَقي غُرَّ القَوافي","لَكَ وَالمَدحِ اِنتِقاءا",37,"ا",3,0],["يُنْتِجُ الْمَطْلًوبَ إِنْ رَكَّبْتَهُ","بَيِّنَ الأَشْكَالِ ذَا صَبٍّ شَجِ",38,"ج",1,0],["يَنتَجِعُ العُفاةُ حِصناً مِنكَ يا","ماءَ السَماءِ أُفعِمَت غُدرانُهُ",39,"ن",2,0],["يَنتَشِرُ التِبرُ وَاللُجَينُ مَعاً","بِمرِّهِ وَالياقوتُ وَاللولو",40,"ل",2,0],["ينتشى خافقي بنشوة ذكراه","وكم ذا يلجّ بالخفقانت",41,"ن",2,0],["ينتاب قلبي كل حين","شيء يروح ويغتدي",42,"ي",1,0],["يَنتضيهِ للمُلْكِ كفُّ بليغٍ","يَدعُ الطِّرْسَ منه روضاً مَجودا",43,"د",2,0],["يَنتابُ دَمعَ النَوى وَاللَهو وَجنَتَها","فقلَّما انفَكَ ظهر الخَدِّ مِن بَلَلِ",44,"ل",1,0],["يَنْتَعِلْنَ الخدودَ من تَحْتِ حُجْنٍ","قَدْ تَلَفَّفْنَ فِي شُعورِ النَّواصِي",45,"ص",2,0],["يَنْتابُني ذكرُ الحبيب","فأشتكي شكوى الغريب",46,"ب",1,0],["ينتابُني ذكر الحبي","ب ولا أرى ليَ منه بُدّا",47,"د",2,0],["ينتحي مُنْتَحَى المروءات طلقاً","في لذاذاته ويبدي افتراره",48,"ر",2,0],["ينتهز المكرماتِ وثبا","بنهضةِ الطالبِ المعاني",49,"ن",2,0],["يُنتابُ ناديهم وتَف","هَق في بيوتهم الجِفانُ",50,"ن",1,0],["ينتشر الأرضَ فلا يَردَعُه","كيف طواها عَنَقاً أو حُضُرا",51,"ر",2,0],["يَنتُقنَ بِالقَومِ مِنَ التَزَغُّلِ","وَهِزَّةِ المِراحِ وَالتَخَيُّلِ",52,"ل",1,0],["يَنتْابُنا بالمَكرماتِ تَبرُّعاً","والمَكرُماتُ فرائضٌ ونوافلُ",53,"ل",1,0],["ينتحلون ولد العباس","وقبلهم بغير ما أساس",54,"س",1,0],["يَنتَهِبُ الحَمدَ بِاليَدَينِ كَما","ناهَبَ فُرسانُ غارَةٍ نَعما",55,"م",2,0],["يَنتَشي مِن نَسيمِها الرَّجُلُ الصّا","حي فَقُل لي ما يَفعَلُ النَّشوانُ",56,"ن",1,0],["ينتاش منها كل ذي عزته","وظل يدميها بظفر وناب",57,"ب",1,0],["ينتشر الحقد في محاجرهم","كأنهم بالضغائن اكتحلوا",58,"ل",3,0],["ينتضي الظفرَ حين يظفر في الحر","بِ وإلا فظفره في قراب",59,"ب",1,0],["ينتحي باليمين نحو ربي الكر","ب وبالمرسيين يلقي الشمالا",60,"ل",2,0],["ينتمي كلُّ واحدٍ منهما عن","د انتساب الأبناء للآباء",61,"ا",2,0],["ينتمي طهماس بالق","د إلى الغصن الرطيب",62,"ب",1,0],["يَنتابُكَ الناسُ أَفواجاً فَتُصدِرُهُم","عَن مَورِدٍ غَيرِ مَذمومٍ إِذا وَرَدُوا",63,"د",3,0],["يَنتابُها الناسُ أَفواجاً فَتَفغَمُهُم","طِيباً وَتُشبِعُ جُوعاهُم مِنَ السَغَبِ",64,"ب",1,0],["ينتحي الأندلسَ العظمى وما","حسب الخيبة فيما حسبا",65,"ب",2,0],["يَنتابُهُ الناسُ أَفواجاً كَأَنَّهُمُ","جاءوا لِنُسكٍ عَلى صُهبِ العَثانينِ",66,"ن",1,0],["ينتهي إلى وجودي","كلُّ شيءٍ في الكيان",67,"ن",1,0],["ينتهي من غير حدٍّ","نظر لا بأدات",68,"ت",1,0],["ينتِمي بالطيب من خالٍ وجَدْ","هوب وارد مصر والّا مْن الهنود",69,"د",1,0],["يُنتج ولداً له وأهلا","ويُكثِر الخصبَ والنماء",70,"ا",2,0],["يَنتَخَ جاهَ أربَعٍ وَثُلثِ","كَمِثلِ هيلي إستَمِع لِنعتي",71,"ي",1,0],["ينتقل الرمان في أثرها","مخافة من ضرر السكر",72,"ر",1,0],["ينتاش أروِقَةَ السماءِ ويُرتجَى","عند القضاءِ له منًى ومَرَام",73,"م",1,0],["ينتمي لِجَنابِهِ كُلُّ وَصفٍ","رائقٍ حَسَنٍ بِغَيرِ انتِهاءِ",74,"ا",2,0],["ينتظر السامعون قولي","فليس لي إن سكتّ عذر",75,"ر",1,0],["ينتقي اللب منه كل لبيب","والبقايا تلف كالعميان",76,"ن",1,0],["ينتهي سفحه بواد عميق","ضيق الصدر خافق للنيام",77,"م",1,0],["ينتج الهَجر مِن قِياس عَقيم","إِن هَذا مِن الغَريب العَجيب",78,"ب",1,0],["ينتاش من أبدي الحوادث ربه","ويكون حصناً في الخطوب ومعقلا",79,"ل",2,0],["ينتضى للخطوب مرهف عزم","ماضي الحد ما اعتراه الفلول",80,"ل",1,0],["ينتهب اللحظ ورد وجنته","ولحظه للقلوب منتهب",81,"ب",1,0],["يَنتَضي مضرب اللسان فَيَغدو","لَسِنُ القَوم دونه فأفاءَ",82,"ا",2,0],["ينتمي في العلا لأشرف بيت","ولأزكى قبائل وشموب",83,"ب",1,0],["ينتمي للشرف السامي وهل","ينتمي الفخر متى تذكر عليا",84,"ي",2,0],["ينتابه من كل فج نازح","مشتبه الأعلام والصحاصح",85,"ح",1,0],["ينتابه جيشان فقر مدقع","وجهالة فيه تعيث وتفسد",86,"د",1,0],["ينتفع المرء بما يقتني","وأنت لا جدوى ولا مأرب",87,"ب",1,0],["ينتهي البَرُّ ههنا","أو هنا البدء أوَّلا",88,"ل",2,1],["ينتحيني الأنام من غير داع","ومتى أدع لا ألاق مجيبا",89,"ب",2,0],["ينتج للمحال والباقي لا","عكس لها بالنقض فليحصلا",90,"ل",2,0],["ينتج مما كان ذا اتصال","وضع مقدم ودفع التالي",90,"ي",1,0],["يَنتَظِمُ الأنسُ مِن مَنثُورِ لُؤلُؤهِ","حَتَّى تَهِيمَ بِمَنظُومٍ وَمُنتَثَرِ",91,"ر",1,0],["ينتف الريش على عبرية","مرّة المقضم من دوح العشر",92,"ر",1,0],["ينتشي بالمدام حتى إذا ما","جف منه اللسان خر صريعا",93,"ع",2,0],["ينتج منها الهدى فتنجى","من لهب زاد منه حرّ",94,"ر",1,0],["يَنتَضيهِ مِنَ الغياثِ هِزَبرٌ","مُخدِرٌ صَيَّرَ الَممالِك غِيلا",95,"ل",2,0],["يَنتقم العذلُ من مَسامِعه","ومن فؤادي يروُح منتقما",96,"م",2,0],["يَنْتابُها الوَيْلُ فَياضا بِساحَتِها","كالوَبْلِ تُسْعِدُهُ في فَيْضهِ الدِّ