Poem.aspx?id=169580",""],[6152,"لكنة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=201742",""],[6152,"مطل الوعد دين","https://www.poetsgate.com/ViewPoem.aspx?id=213183",""],[6152,"روحي تحتاج إليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=213209",""],[6256,"ضاعت حقيبتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65917&r=&rc=5",""],[6344,"جنوح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87977&r=&rc=17",""]],"verses":[["فَرَفَعَ الشَّاعِرُ أَبْصَارُهُ","إِلَى الْعُلَى ثُمَّ جَثَا ثُمَّ قَامْ",0,"م",1,0],["فرفيّع إلى المليك","ونخليك تفتل اديك",1,"ك",1,0],["فرفرفتْ رحمتُهُ فوقَهُ","حتى كَفاهُ نكدَ المطلبِ",2,"ب",1,0],["فرفَّعتَ من قدري وخفَّضتَ عيشتي","وأمَّنْتَ روْعاتي وحقَّقتَ آمالي",3,"ل",2,0],["فَرَفَّعَ أَصحابي المَطِيَّ وَأَبَّنوا","هُنَيدَةَ فَاِشتاقَ العُيونُ اللَوامِحُ",4,"ح",1,0],["فرفعت مذودتي أذب","ب بها عن الأدب الذبابا",5,"ب",2,0],["فَرَفَعتَ إيواناً كَرُكنِ النَجمِ لَم","يُضرَب عَلى كِسرى وَلا بَهرامِ",6,"م",1,0],["فَرَفَعتَ رُكناً لِلقَضِيَّةِ لَم يَكُن","سَحبانُ يَرفَعُهُ بِسِحرِ خِطابِهِ",7,"ب",2,0],["فَرِفقاً بِالبَنينِ إِذا اللَيالي","عَلى الأَعقابِ أَوقَعَتِ العِقابا",8,"ب",2,0],["فَرَفَعتَ بُنياناً كَأَنَّ زُهاءَهُ","أَعلامُ رَضوى أَو شَواهِقُ صَنبَرِ",9,"ر",1,0],["فرفعت نفسي عن سواك ومنطقي","إن المطالب يختلفن منازلا",10,"ل",2,0],["فَرِفقاً إِلى أَن يُبرِزَ الحَقُّ وَجهَهُ","بِعَبدِكُمُ فَالعَبدُ أَجدَرُ بِالرِفقِ",11,"ق",1,0],["فرفقاً بالذي أبقيتِ منها","وأقسمُ كم تركتِ لنا أنينَا",12,"ن",2,0],["فرفّ البشر في الصمت ال","ذي خيم في الغرفه",13,"ه",1,0],["فَرَفْعُ النجمِ في علياكَ خَفْضٌ","وفَيْضُ البَحرِ في نُعماكَ رشحُ",14,"ح",1,0],["فَرِفدُكَ الزائِرَ مَجدٌ وَلا","كَرِفدِكَ الزائِرَ لِلزائِرِ",15,"ر",1,0],["فَرَفعتُ مِن ناري لِضَيفٍ طارِقٍ","يَعشو إِلَيها مِن خَيالٍ طاري",16,"ر",2,0],["فَرَفَلتُ في سَمَلِ الدُجى وَكَأَنَّما","قَزَعُ السَحابِ بِجانِبَيهِ رِقاعُ",17,"ع",1,0],["فَرَفَلتُ حَيثُ تَعَثَّرت بي نَشوَةٌ","في ثَوبِ وَشيٍ لِلرَبيعِ مَصونِ",18,"ن",1,0],["فَرَّ فُؤادي مِنّي","فَسَل يُحَدِّثكَ عَنّي",19,"ي",1,0],["فَرَفَعتَ عَشْرَاً مِنْ أنامِلَ داعياً","فانْهَلَّ أُسبوعاً سَحابٌ صَيبُ",20,"ب",1,0],["فرِفْقاً قَلِيلاً أيها الملِك الرِّضَى","بنفسك واتركْ منك حظّاً على قَدْر",21,"ر",1,0],["فرفّ البشر في الصمت ال","لَذي خيم في الغرفه",22,"ه",1,0],["فرفَّ على الوادي الشاعُ طروبا","وناداهُ من بين الظلالِ مُجيبا",23,"ب",2,0],["فَرَفَعْنَ عَنْهُ غَطَاءَهُ فَوَجَدْنَهُ","بِالمَيْتِ أَشْبَهَ مِنْهُ بِالأَحْيَاءِ",24,"ا",2,0],["فرفرف ظلُّها فوقَ","مدارِ الأنجم الزُّهر",25,"ر",1,0],["فرفّ ، كأجنحة ، من نضّار","كأردية ، من دموع النهر",26,"ر",1,0],["فرِفْقاً باشباهِ القواريرِ صُدِّعَتْ","وما اسْطعتمُ فاسَتدركوا صدعها رأبا",27,"ب",2,0],["فرفَّتْ عليه رَفيفَ الأقاح","في مَنبِت نَضرٍ مُعشِب",28,"ب",1,0],["فَرِفقاً أَيُّها المَولى قَليلاً","فَإِن القَوم كُلَهُم عَبيدُ",29,"د",1,0],["فرف بالقلب رسيس الهوى","وود صدع الشمل لو يرأبا",30,"ب",2,0],["فَرَفَضتُ الوَرى وَغَيرُ مَلومٍ","تارِكُ الرَشحِ مَن أَصابَ الرَواءَ",31,"ا",2,0],["فرفقا فبالسلطان للمال حاجة","أهم فخذ وأحسن على مالك البقيا",32,"ي",2,0],["فرفدك أجزلنا وقصدك لم يخب","لدنيا فهل أبصرت يا ابن الأخاير",33,"ر",1,0],["فرفدُك جارٍ على مَن أقامَ","وبرُّك زادٌ لمَن لم يُقِم",34,"م",1,0],["فرفقاً بمن قد نآى مرغماً","وأدمعه حسرة تهطل",35,"ل",1,0],["فَرَّفَتهُم في الهَوى ثاراتُهُم","فاجمَعي الأمرَ وَصوني الأَبرِياء",36,"ا",2,0],["فَرِفقاً بِذي صَبوَةٍ في هَواكِ","ضَعيفِ العَزيمَةِ مَغلوبِها",37,"ب",3,0],["فَرِفقاً بِعان في يَدِ الشَوقِ مُفرَدٍ","بِأَشجانِهِ يا ظَبيَةَ العَلَمِ الفَردِ",38,"د",1,0],["فرفرف في الإحساء عدلك شاملا","وفي الخط بات الأمن وهو مطنب",39,"ب",1,0],["فرفعتُ الشعورَ عنها رُويداً","وجَسستُ النهودَ تحت الشعور",40,"ر",1,0],["فرِفعتُها على ضِعةٍ مثالٌ","لحسنِ سياسةٍ رَفعَت خَسيسا",41,"س",2,0],["فَرَفرَفتِ النواظِرُ تجتليها","فأُعلِقت القلوبُ بها طُيُورا",42,"ر",2,0],["فَرفقاً بأرضٍ جاءَ فيها محمدٌ","رَسولاً وفيها رنَّ صوت المعلم",43,"م",1,0],["فرفْعٌ ونصْبٌ في الجُذوعِ بما جنَتْ","وجرّ تُوالِيه إليْهَا السَّلاسلُ",44,"ل",1,0],["فرفعتَ للفصحى (بمصرٍ) دولةً","كانتْ تطالع فيك نجماً صاعدا",45,"د",2,0],["فَرَفَضتُ يَأسي مِنكَ لَمّا لَم أَج