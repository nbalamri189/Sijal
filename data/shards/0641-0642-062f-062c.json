te.com/ViewPoem.aspx?id=128808",""],[5410,"بلا ميعاد","https://www.poetsgate.com/ViewPoem.aspx?id=139640",""],[5533,"زَفَاف","https://www.poetsgate.com/ViewPoem.aspx?id=179727",""],[5736,"شكواي","https://www.poetsgate.com/ViewPoem.aspx?id=208435",""],[5855,"فقد جعلت إذا ما حاجة عرضت","https://www.poetsgate.com/ViewPoem.aspx?id=186737",""],[5913,"بئر الناس","https://www.poetsgate.com/ViewPoem.aspx?id=183199",""],[6031,"خَلِيلَيَّ مِنْ علْيَا لُؤيِّ بنِ غَالِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=46401",""],[6093,"ثقافة","https://www.poetsgate.com/ViewPoem.aspx?id=198733",""],[6142,"بسطت لشبك المرتضى راحة السؤل","https://www.poetsgate.com/ViewPoem.aspx?id=155757",""],[231,"يقظة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79175&r=&rc=49",""],[6305,"وَشَيْطانٍ يُقاسِمُني نَصِيبي !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87329&r=&rc=2",""]],"verses":[["فَقَد جَرَّبتُ إِخواني جَميعاً","فَما أَلفَيتُ كَاِبنَ أَبي عَتيقِ",0,"ق",1,0],["فَقَد جَرَتِ العاداتُ أَنّا لَدى الوَغى","سَنَظفَرُ وَالإِنسانُ يَبغي الفَوائِدا",1,"د",2,0],["فقد جار في الأرض البسيطة خَلْقه","على خلقه جوراً إلى الحزن يستدعي",2,"ع",2,0],["فقد جمعتْ ثغراً من الضحك مُفعَماً","إلى مَحْجِر باك من الدمع مفعم",3,"م",1,0],["فَقَد جَعَلَ المَفروكَ لا نامَ لَيلُهُ","يُحِبُّ حَديثي وَالغَيورُ المُشايِحُ",4,"ح",1,0],["فَقَد جَرَّتِ الحَنفاءُ حَتفَ حُذَيفَةٍ","وَكانَ يَراها حُدَّةً لِلشَدائِدِ",5,"د",1,0],["فقد جاء في أمثالهم أنَّ ثعلباً","وذئباً أصابا عندَ ليثٍ تقدُّمَا",6,"م",2,0],["فَقَد جَعَلَت دَواعي الشَوقِ تَدعو","إِلى حَلَلٍ بِواسِطَ أَو كِنابِ",7,"ب",1,0],["فَقَد جُمِعَت أَشتاتُ قَومٍ وَأُصلِحَت","جَوانِبُ أَمرٍ بَعدَما اِلتاثَ فاسِدُه",8,"د",2,0],["فَقَد جَعَلَ المَفروكُ لا نامَ لَيلُهُ","بِحُبِّ حَديثي وَالغَيورِ المُشايِحِ",9,"ح",1,0],["فقد جدَّدَ الدَّهرُ ظِلاًّ ظليلاً","ورَوْضاً أَريضاً وماءً نَمِيرا",10,"ر",2,0],["فقد جَلا النَّرجِسُ الجَنِيُّ لنا","عن عِيشَةٍ في قُدومِهِ رَغَدِ",11,"د",1,0],["فَقَد جَدَّ الرَحيلُ بِهِم","إِلى سَفَرٍ هُوَ السَفَرُ",12,"ر",1,0],["فَقَد جَعَلتُ الأَرضَ مِن مَدحِكُم","خَضرا وَشِعري جائِلٌ كَالوِشاح",13,"ح",1,0],["فَقَد جَعَلَ الإِلَهُ لَكُم لِساناً","عَلِيّاً ذِكرُهُ بِأَبي عَلِيِّ",14,"ي",1,0],["فقدْ جاءكمْ والٍ بروقُ سُيوفِهِ","إذا لَمَعَتْ لم يبْقَ في الأرض مُنْكَرُ",15,"ر",1,0],["فَقَد جَنَيتُ الهُمومَ مِنهُ وَقَد","خَلَّيتُ قَلبي يَعومُ في الفِكَرِ",16,"ر",1,0],["فَقَد جاءَ الرَسولُ لَهُ اِنكِسارٌ","وَحالٌ ما عَلَيها مِن قَبولِ",17,"ل",1,0],["فَقَد جُبِلَت عَلى فَرسٍ وَضَرسٍ","كَما جُبِلَ الوَقودُ عَلى التَنَمّي",18,"م",2,0],["فَقَد جَعَلَت نَفسي وَأَنتِ اِختَرَمتِها","وَكُنتِ أَعَزَّ الناسِ عَنكِ تَطيبُ",19,"ب",1,0],["فَقَدْ جَاوَرَتْ هَذِي الْوَفِيَّةُ إِلْفَهَا","إِذِ الإِلْفُ مَيَّاسُ المَعَاطِفِ أَميلُ",20,"ل",1,0],["فقد جلت الريح ذاك الجراد","فكنا جرادا وكنا الزروع",21,"ع",1,0],["فقد جارَ \" شوقي \" على نفسهِ","وقد يقتُلُ المرءَ جَورُ الفِكَر",22,"ر",1,0],["فَقَد جَرَّبتُ إخواني جميعاً","فما ألْفَيْتُ كکبْنِ أبي عَتِيقِ",23,"ق",1,0],["فَقد جَرّتِ الحَنفاءُ حَتفَ حُذَيْفَة","ٍ وكانَ يراها عدة ً للشدائدِ",24,"د",1,0],["فقد جلبا حَيْناً وحرْباً عظيمة ً","تُبيدُ سُراة َ القَوْمِ من غَطَفانِ",25,"ن",1,0],["فَقَد جُرِّبتُ قَبلَكَ فِيهِ حتى","بَدَا أني البَصِيرُ بِهِ السَّبُوقُ",26,"ق",1,0],["فقد جنَح الأعداءُ للسّلم رغبةً","إليك وأىّ الناس لا يعشق البِرّا",27,"ر",2,0],["فَقَد جُدتَ لي بِالصيتِ في الناسِ وَاللُهى","فَوَفَّرتَ مِن نَيلِ العُلى وَالغِنى قِسمي",28,"م",2,0],["فقد جمعوا لولا تلافوا مفرقاً","وقد أرهبوا لو كان مثلي يرهبُ",29,"ب",1,0],["فَقَد جُزتَ مِقدارَ الشَجاعَةِ وَالنَدى","وَتِربُكَ في لِعبِ الصِبا مُتَشاغِلُ",30,"ل",1,0],["فَقَد جاءَ في بَيتٍ مِنَ الشِعرِ سائِرٍ","لَنا مثلٌ مِن عالِمٍ قَد تَمَثَّلا",31,"ل",2,0],["فَقَد جَعَلوا للرَقصِ في وقتِ لَهوهم","لَياليَ أُنسٍ كَم لَهُم أطلعت بدرا",32,"ر",2,0],["فَقَد جَهَدوهُ بِالسُؤالِ وَقَد أَبى","بِهِ المَجدِ إِلّا أَن يَلِجَ وَيُستَشرى",33,"ر",2,0],["فَقَد جُعِلَت كُتّابُهُ في مَؤونَةٍ","مَفاتيحُ مِن مَعروفِهِ المُتَقَسِّمِ",34,"م",1,0],["فقد جل قدراً عن مدادي مديحه","وعن قلمي والكف والسطر والطرس",35,"س",1,0],["فَقَد جَعَلتُ أَرى الشَخصَينِ أَربَعَةً","وَالوَحِدَ اِثنَينِ مِمّا بورِكَ البَصَرُ",36,"ر",1,0],["فَقَد جاءَني إِبليسُ يَبغي غَولَتي","بِغَيدٍ كَأَمثالِ الدَمي وَغَواني",37,"ي",1,0],["فَقَد جُنَّت كَواكِبُهُ جُنوناً","لَها صَبَحٌ إِذا اِرتَفَعَ الضَحاءُ",38,"ا",2,0],["فَقَد جَدَّ الرَحيلُ وَأَنتَ مِمَّن","يَسيرُ عَلى مُقَدِّمَةِ الرِكابِ",39,"ب",1,0],["فقد جَلا المِهْرَجانُ السَّعْدُ طلْعتَه","في صَدْرِ يومٍ بنُورٍ منك مُلْتَحِف",40,"ف",1,0],["فقد جُزْتُمُ فوقَ حَدِّ الورى","وللمجدِ من بعدُ فيكم وُعود",41,"د",1,0],["فَقَد جاءَني هاجِري واصِلاً","فَلا يَرجِعَن واصِلي هاجِرا",42,"ر",2,0],["فقَد جُدِّدَ الطُّوفانُ في الأرضِ والتَقَى","بجُودِ يَدَيهِ مُزنُها ومَعينُها",43,"ن",3,0],["فقد جعلا سلامهما عزاء","على موت الصداقة والخفوق",44,"ق",1,0],["فقد جلَّ العزاء له ببيتٍ","به التأريخ يُفْصِحُ بالبيانِ",45,"ن",1,0],["فقد جرّبتُمُ بالأمس منّا","عرائكَ لا تلينُ على اعتياقِ",46,"ق",1,0],["فَقَد جَزَيتُ بَني حَزمٍ بِظُلمِهِمُ","وَقَد جَزَيتُ زُرَيقاً بِالَّذي صَنَعوا",47,"ع",3,0],["فَقَدْ جاءَ عَنْ خَيْرِ الْبَرِيَّةِ فِعْلُهُ","وَسَلْ مَرْسَلاً إنْ شِئْتَ عَنْهُ ومُسْنَدا",48,"د",2,0],["فَقَد جاءَ يُخبِرنا فيك بال","بقاءِ وَما ترتجي مِن دوامِ",49,"م",1,0],["فقُدْ جزاءً لِما أَوليتَ من مِنَنِي","زمامَ كلِّ شَرودِ الذّكر سيّارِ",50,"ر",1,0],["فقد جحدت الغيور الحق ملته","هيهات أنك تنجو من أياديه",51,"ي",2,0],["فَقَد جَعَلَت أَكبادُنا تَجتَويهُمُ","كما يَجتَوي سوقُ العِضاهِ الكَرازِنا",52,"ن",2,0],["فقد جاءنا جند الضلال وأجلبوا","بأحزابهم من كل غاو معاند",53,"د",1,0],["فقد جاء في النص المؤكد فعله","وذا حاصل التقرير من قول أحمد",54,"د",1,0],["فقد جاء في هذا نصوص صحيحة","فخذ بنصوص المصطفى وتقيد",54,"د",1,0],["فقد جعلت نفسي على النأي تنطوي","وعيني على فقد الحبيب تنامُ",55,"م",1,0],["فقد جُرتمُ وتكذّبتمُ","على ربِّنا كَذِبَ المُفترينا",56,"ن",2,0],["فقد جر فيها الجهل ذيل ظلامه","وضم عليها الظلم طوق حصار",57,"ر",1,0],["فَقَد جاءَكُم هَذا العَزيز مُتوّجاً","بِتاج المَعالي مِن إِلَه نَبيِّنا",58,"ن",2,0],["فَقَد جاءَ يَسعى مِن بلاد بَعيدة","عَلى عجل يُهدي إِلَيكَ تَحيتي",59,"ي",1,0],["فَقَد جَعلت عَلى علياك أَمدحتي","وَقفاً لغيرك لَم يَصلح وَلم يَجب",60,"ب",1,0],["فَقَد جاءَ نَصر اللَه وَالفَتح وَاِزدَهَت","بِطَلعة هذا الشبل بَهجة مِقياس",61,"س",1,0],["فَقَد جادَ الزَمانُ لَنا","بِحُسن الوَصل وَالقُرب",62,"ب",1,0],["فَقَد جادَ السُرورُ لَنا","بِما نَرجوه مِن إِرْب",62,"ب",1,0],["فقد جاء ما لم يجئه ابن أنثى","وعنه روى الفضل من قد روى",63,"ر",3,0],["فَقَد جَعلَ الوردُ الشقيقَ شَقيقَه","وَأَودَعهُ كَالزّهرِ مِن عَرفِهِ سرَّا",64,"ر",2,0],["فقد جرت لحسين دمعها بدم","فجارها في البكا وابك الحسين دما",65,"م",2,0],["فَقَد جاءَنا مِن بَعدِكَ المَعشَرُ العِدى","وَوالٍ مَتى يُنطَق حَوالَيهِ يَغضَبِ",66,"ب",1,0],["فقد جعلت بمحض الفضل قدركم","ذخري وأهلي فكيف الهم يزعجني",67,"ن",2,0],["فقد جاز العقاب عقاب ذنبي","وضجَّ العشر واستعدى النسيب",68,"ب",1,0],["فَقَدْ جَعَلتْ نَفْسِيَ عَلَى النَّأْيِ تَنْطَوِي","وَعَيْني عَلَى فَقْدِ الصَّدِيقِ تَنَامُ",69,"م",1,0],["فقدْ جَعَلتْ في حَبَّةِ القَلْبِ والحَشا","عِهادُ الهَوى تُولَى بِشَوْقٍ يُعِيدُها",70,"د",3,0],["فقد جمعت من صروف الجمال","نهاية ما يقتضيه الوجود",71,"د",1,0],["فقد جَدَّ جِدُّ الهَجرِ يا ليلُ بيننا","وشَحطُ النوى إلا الهوى والتَذكُّرا",72,"ر",2,0],["فَقَد جُمِعت بجَامِعِه مَزَايا","لها قد أذعَن الجَمّ الغَفِيرُ",73,"ر",1,0],["فقد جزعتَ غَداةَ الروْعِ إذ لَقحَتْ","أبطالُ قيْسٍ عليها البيضُ مشْجورُ",74,"ر",1,0],["فَقَد جَلَّ هذا الخَطب حتى تَدَكدَكَت","لِمَوقِعِهِ شُمُّ الجِبالِ المَعالِمِ",75,"م",1,0],["فقد جر قبح الفعل مصرع مالك","فما رده ترصيع شعر متمم",76,"م",1,0],["فقد جعلت تبدو شواكل منكما","كأنكما بي موقران من الصخرِ",77,"ر",1,0],["فَقَد جَهلَت حَتّى أَرادَ خَبيرُها","بِوادي القُطَينِ أَن يَلوحَ سَنيرُ",78,"ر",1,0],["فقد جعلَت دواوينُ الغواني","سوى ديوانِ ليلى يمّحينا",79,"ن",2,1],["فقد جاد فضلا للعباد بمنة","بها ثغر دمياط غدا وهو يفتر",80,"ر",1,0],["فقد جدّ أمر هدّ شرع محمد","وما مخبر عن حالة مثل شاهد",81,"د",1,0],["فقد جنّ حقاً حجى اليانصيب","وجنَّ الأديب وجنَّ القدر",82,"ر",1,0],["فقد جربت مستشفى بنوه","لكم فيه غدوتم تسلخونا",83,"ن",2,0],["فَقَد جَعَلَت آمالُ بَعضِ بَناتِنا","مِنَ الظُلمِ إِلّا ما وَقى اللَهُ تُكشَفُ",84,"ف"