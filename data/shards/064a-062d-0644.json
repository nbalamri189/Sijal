etsgate.com/ViewPoem.aspx?id=96554",""],[4927,"قصيدة لعيني عُروة وعَفْراء","https://www.poetsgate.com/ViewPoem.aspx?id=29954",""],[4961,"الكهف الذي لم تدخله الظلمات","https://www.poetsgate.com/ViewPoem.aspx?id=33328",""],[5002,"أهزوجة الليل ،،،","https://www.poetsgate.com/ViewPoem.aspx?id=202975",""],[5027,"جاءت 2","https://www.poetsgate.com/ViewPoem.aspx?id=35143",""],[5081,"أَفِقْ قَلْبِي","https://www.poetsgate.com/ViewPoem.aspx?id=187884",""],[3591,"رأيتُ ثوباً على الأعراس قد نشرا","https://www.poetsgate.com/ViewPoem.aspx?id=149390",""],[3591,"حرم الجمال نواظري سنة الكرى","https://www.poetsgate.com/ViewPoem.aspx?id=149439",""],[5121,"رَيَّاك","https://www.poetsgate.com/ViewPoem.aspx?id=215868",""],[5135,"على مرفأ الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=203702",""],[5147,"هي الحقيقة والعقبى بمجراها","https://www.poetsgate.com/ViewPoem.aspx?id=166753",""],[5150,"أم الدنيا .. مصر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=202872",""],[5219,"استغاثة شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=194538",""],[5219,"يا منحة الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=194996",""],[5246,"رقيق الشعر وافى وهو يحوي","https://www.poetsgate.com/ViewPoem.aspx?id=187084",""],[5302,"يا خادم الحرمين","https://www.poetsgate.com/ViewPoem.aspx?id=200944",""],[5324,"طيب على طيب.","https://www.poetsgate.com/ViewPoem.aspx?id=211954",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[5409,"ليت ابن آدم كالثما","https://www.poetsgate.com/ViewPoem.aspx?id=155251",""],[5493,"سفَر بلا عودة","https://www.poetsgate.com/ViewPoem.aspx?id=199531",""],[5530,"أميره","https://www.poetsgate.com/ViewPoem.aspx?id=155984",""],[5776,"حربُ الفصول","https://www.poetsgate.com/ViewPoem.aspx?id=207245",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5956,"أُلامُ لأني أحبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=182085",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""],[5963,"شاعرٌ في زمن الضَّياع","https://www.poetsgate.com/ViewPoem.aspx?id=187324",""],[5986,"أيا بدر المعارف والمعالي","https://www.poetsgate.com/ViewPoem.aspx?id=162953",""],[161,"أنشودة للصغار / وصف هررة صغار","https://www.poetsgate.com/ViewPoem.aspx?id=164385",""],[6149,"سبحان من صاغه وكون","https://www.poetsgate.com/ViewPoem.aspx?id=169628",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""],[6259,"بدا البرق من نجدٍ فحن إلى نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59369&r=&rc=17",""],[572,"كتبتُ وعِندَنَا ماءٌ وراحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9210&r=&rc=67",""]],"verses":[["يَحلو لَهُم عِرضي فَيَستَرِطونَهُ","وَيَصِلُّ عِرضُهُمُ الذَليلُ فَيُبصَقُ",0,"ق",1,0],["يَحِلُّ يَفاعاً يَخْزَرُ النَّجْمُ دونَهُ","ويَعْتَنِقُ الجَوْزاءَ في ظِلِّهِ الغَفْرُ",1,"ر",1,0],["يَحْلُو حَديثُ عُلاكَ فِي أَسْمَاعِهَا","وَيَلَذُّ فِي أُفْوَاهِهَا ذِكْرَاكَا",2,"ك",2,0],["يَحلو بِها الكِذبُ لِأَربابِها","كَأَنَّها أَوَّلُ إِبريلِ",3,"ل",1,0],["يَحُلُّ المَعْضِلاتِ مِنَ القَضَايَا","وَفِيهِ لِنُجْحِهَا أَوْفَى ضَمَانِ",4,"ن",1,0],["يَحُلّونَ من وَهبينَ أَو مِن سُوَيقَةٍ","مَشَقَّ السَوابي عَن أُنوفِ الجَآذِرِ",5,"ر",1,0],["يحلو على الأفواه طيبُ مذاقها","لولا التجسّدُ خلتُهنَّ ثناكا",6,"ك",2,0],["يُحَلِّئنَ عنماءِ الفُراتِ وظِلِّه","حُسَيناً ولم يُشهَر عَلَيهنَّ مُنصُلُ",7,"ل",1,0],["يحلو إذا هي كرَّرتهُ وحسبكُم","بالسكّر المصريّ حين يكرَّر",8,"ر",1,0],["يحْلُبُ تيساً مثلَه","في قَعْبِ أُمِّ وَلَدهْ",9,"د",2,0],["يحلُو على سَمعه السؤالُ وما","زالتْ نَعَمْ حُلْوةً على حَنَكهْ",10,"ك",2,0],["يحِلّ لبعلها مائةٌ سِواها","لأن نصيبه منها قليل",11,"ل",1,0],["يحُلُّ من المكارم والمعالي","بحيثُ الرأسُ منها والسَّنامُ",12,"م",1,0],["يَحُلُّ القَنا يَومَ الطِعانِ بِعَقوَتي","فَأَحرِمُهُ عِرضي وَأُطعِمُهُ جِلدي",13,"د",2,0],["يحُلُّ نياطَهُ طبعٌ ذكيٌّ","يُكِبُّ لهيبَهُ عذبُ الضرامِ",14,"م",1,0],["يَحُلُّ غُرورُ الوَعدِ مِنها عَزيمَتي","وَأَحلى مَواعيدِ النِساءِ غُرورُها",15,"ر",3,0],["يَحُلُّ بِها خِرقٌ كَأَنَّ عَطاءَهُ","تَلاحُقُ سَيلِ الديمَةِ المُتَخَرِّقِ",16,"ق",1,0],["يُحَلِّأُنا عُقوقُ أَبي يَزيدٍ","عَنِ الصَهباءِ صافِيَةَ العَشايا",17,"ا",3,0],["يَحُلُّ اللُؤمُ ما حَلَّت فُقَيمٌ","وَإِن ساروا بِأَقصى الأَرضِ سارا",18,"ر",2,0],["يَحُلُّ عُقودَ الدُّرِّ دمعاً ومَنْطِقاً","ويَنظِمُها حَلْياً عليه ومَبْسِما",19,"م",2,0],["يَحُلُّ بَسطَةَ إقليمٍ فإنْ عَصَفَتْ","به الصَّبا تَرَكَتْهُ جَوَّ إقليمِ",20,"م",1,0],["يَحُلُّ ما يَعْقِدُ الزَّمانُ ولا","يَحُلُّ صَرْفُ الزَّمانِ ما عَقَدا",21,"د",2,0],["يُحلِّي بمَدْحَتِه غيرَه","فيُمْسي محلّىً ويُضحي سَليبا",22,"ب",2,0],["يَحلو وَيَعذُبُ إِن زَمانٌ نالَهُ","بِغِنىً وَتَلتاثُ الخُطوبُ فَيَكرُمُ",23,"م",1,0],["يَحِلُّ بِها أَدنى الرِياحِ فَلَيتَها","شَمالٌ تَهادى بَينَنا وَجَنوبُ",24,"ب",1,1],["يَحلّون الكِتابَ حِمَى نفوسٍ","حَلَلْنَ من السّماءِ بحيث شِينا",25,"ن",2,0],["يَحلو عَلى تَردادِهِ فَكَأَنَّهُ","سَجَعُ الحَمامِ إِذا تَرَدَّدَ أَطرَبا",26,"ب",2,0],["يَحِلُّ على الأمْواهِ تُتْلَعُ دونَها","رؤوسُ العوالي والمذاكي فتُشدخُ",27,"خ",1,0],["يَحلِفُ ما جادَت اللَيالي","إِلّا بِسُمٍّ لَنا قَطيبِ",28,"ب",1,0],["يَحِلُّ بِمَهرٍ رَحيقُ الرُضابِ","وَلَيسَ يَحِلُّ رَحيقُ العِنَب",29,"ب",1,1],["يَحلِفُ لا أَبّقى عَلى واحِدٍ","وَبِرٌّ في إيمانِهِ الحالِفُ",30,"ف",1,0],["يَحُلُّكَ الحَيُّ بَعدَ الحَيِّ عَن شَحَطٍ","وَما سُوافُكَ إِلّا مِن سَوافيكا",31,"ك",2,0],["يَحُلُّ دِيارَ المُندِياتِ بِرُغمِهِ","وَيَرحَلُ عَنها وَالفُؤادُ بِهِ تَبلُ",32,"ل",1,0],["يَحُلُّ أَجسامَها المُدامُ إِذا","ما فارَقَت قَنصَها وَبابِلَها",33,"ل",3,0],["يَحلو لِعَين المرء مدُّ يمينها","وَتَروق منها فترة الأجفان",34,"ن",1,0],["يَحُلُّونَ الفضَاءَ بِحَيِّ صِدْقٍ","جَمِيعِ الأَمْرِ مِيقَاصِ الجُمُوعِ",35,"ع",1,0],["يحلّ به على قلبٍ شجاعٍ","ويرحل منه عن قلبٍ جبان",36,"ن",1,0],["يَحْلِفُ أن يَقْتُلَ الكَمِيَّ وقد","فاتَ إليه حِمامَهُ وَشَأى",37,"ا",2,0],["يحل الربى ويحل الوهود","ولا بد للربع أن يندرس",38,"س",1,0],["يَحُلُّ عُرَى الجَبَّار في دارِ مُلْكِهِ","ويهفُو بنَفْسِ الشارِبِ المتساكِرِ",39,"ر",1,0],["يُحَلّونَ فيهِ وَفي ناظِري","وَإِن أَبعَدوا في مَحَلِّ السَوادِ",40,"د",1,0],["يحلو حديث العلا في أسماعها","ويلذ في أفواهها ذكراكا",41,"ك",2,0],["يُحَلّئُنَا عُقُوقُ أبي يَزِيدٍ عَنِ","الصّهْبَاءِ ضَافيَةَ العَشَايَا",42,"ا",3,0],["يَحُلُّ عليه بالرغبات وفْدٌ","ويرحل بالرغائب عنه وفْدُ",43,"د",1,0],["يحل عقودَ المشكلاتِ بعزمهِ","ومَن غيرهُ يُختارُ للحلّ والعقدِ",44,"د",1,0],["يَحُلُّ ما يبديه من بِشره","عَقْدَ لسان الهائب اللاقى",45,"ق",2,0],["يُحَلِّي بِها أَلحانَهُ كُلُّ مَن شَدا","وَتَحلو بِأَفواهِ الرُواةِ وَتَعذُبُ",46,"ب",1,0],["يُحِلّونَهُ بِسَوادِ القُلو","بِ ضَنّاً بِهِ عَن سَوادِ المُقَل",47,"ل",1,0],["يَحُلُّ الناسُ ما عَقَدوهُ غَدراً","وَعَقدُكَ لا يُحَلُّ وَلا يَحولُ",48,"ل",1,0],["يَحْلِفُ بِاللَهِ فَيا لَيْتَهُ","إِذا أَرادَ الخُلْفَ لا يَحْلِفُ",49,"ف",1,0],["يحلفُ الأيمان قد عّددها","ليرى وجهك خمسينَ يمينا",50,"ن",2,0],["يَحلو بها فمُ راويها فتحسبُهُ","صبّاً ترشَفَ ظلمَ الواضِحِ الرمِلِ",51,"ل",1,0],["يَحُلُّ المَجدُ أَرضاً حَلَّ فيها","وَتُضرَبُ لِلعُلا فِيها الخِيامُ",52,"م",1,0],["يُحلُّونَ الحَرَامَ إذا ما أرَادوا","وقد بَانَ الحلالُ منَ الحرامِ",53,"م",1,0],["يحلو مشاهدة به قتلي عسى","فيه أكون غدا من الشهداء",54,"ا",2,0],["يحلو التناجى وعين الليل في سنةٍ","عن عاشقٍ وامقٍ للحسن يغتال",55,"ل",1,0],["يَحِلّ عَسِيْرَ المُشِكلاتِ بَرَاعةً","فلا غيرُهُ يُرْجَى إذا انقَطَعَ الرّجْوى",56,"و",2,0],["يَحلمُ بِالسَعادَةِ الدائِمَه","خابَ رَجاءُ الأَنفُسِ الحالِمَه",57,"ه",1,0],["يَحِلُّ البَعيدُ الدارِ وَالأَهلِ فيكُم","فَيُلهى عَنِ الجيرانِ وَالدارِ وَالأَهلِ",58,"ل",1,0],["يَحلُمُ عَن قُدرَةٍ وَأَحسَنُ ما","مَنَّ أَخو الحِلمِ وَهوَ مُقتَدِرُ",59,"ر",1,0],["يَحلو هِجاؤُكَ لي وَأَن","تَ أَمَرُّ مِن حُبِّ الأَيارِج",60,"ج",1,0],["يَحْلو في الأنْفُسِ مَسْمَعُه","كالطّيْرِ يَشُوقُ تَغَرُّدُهُ",61,"د",2,0],["يَحْلُو بأفْواهِهم إيلامُهُم كَرَماً","وَقَد يَمُرُّ لِسِرّ فيهمُ انبَلَجا",62,"ج",2,0],["يَحلو له طَعم الكَريهَةِ سَلْسَلا","وهِيَ الأجاجُ مَشارِعاً ومَشارِبا",63,"ب",2,0],["يُحَلِّئُني عَنهُ الفِراقُ وَسَبسَبٌ","عَريضٌ كَأَيّامِ الصُدودِ طَويلُ",64,"ل",1,0],["يَحُلُّ لَدى الرَوعِ مِن جَيشِهِ","مَحَلَّ السِّنانِ مِنَ العامِلِ",65,"ل",1,0],["يحلُّ بها من لا أصرِّحُ باِسمِه","غَزالٌ على بُعد المزارِ أُغازِلُه",66,"ل",2,0],["يحلو إذا كررت إنشاده","وكيف لا يحلو وفيه كتا",67,"ت",2,0],["يحلو لهن ان يرين الفتى","صريع حسن الزي والملبس",68,"س",1,0],["يُحلَب لَكِ اللَبُن الغَريضُ وَيُنتَزَع","بِالعيسِ مِن يَمَنٍ إِلَيكِ وَشامِ",69,"م",1,0],["يَحلُو مُقبَّلُهُ وبَرْدُ رُضَابهِ","كالأُقحوانِ غَداةَ غِبِّ سَمائِه",70,"ا",3,0],["يحلّى بها بيض الطروس جواهراً","فلا مهرُقٌ إلّا بها يشتهي الرقما",71,"م",2,0],["يَحلِفُ المَرءُ إنّها لا تَمَسُّ ال","أرضَ من فَرْطِ خِفّةِ الوَطْءِ خُفّا",72,"ف",2,0],["يَحلُّ لَنا لَيلاً شَرابِيَ خِلعَةً","يَفيضُ عَلَينا البُردُ مِنها مُسَهَّما",73,"م",2,0],["يحلفُ لا عادَ أو يعود إلى","حال التَّسلي وليس بالعائِد",74,"د",1,0],["يحل في بطن بكرٍ وهي ظاهرةٌ","وثديها بحليب البر مدرار",75,"ر",1,0],["يَحلُ خَفي المُشكِلات بَداهة","مَتى شاءَ مِن غَير اِنهِماك وَإِمعان",76,"ن",1,0],["يَحل بِكُل علم مُشكِلات","تَحامَت أَن تحاولها الفُحول",77,"ل",1,0],["يَحلُّ عقدُ اصطباري في محبّتِهِ","بسحر ناظرِهِ النفِّاث في العُقَدِ",78,"د",1,0],["يحل مِن كُلِّ مَجد شامِخٍ وَسَطاً","توسط العين بَينَ الشفر وَالشفرِ",79,"ر",1,0],["يَحِلُّ عُقود القطر بَينَ مُعاهِدٍ","يَحِلُّ بِها مِن قَبل دُرِيَّةِ العقدِ",80,"د",1,0],["يحلُّ به عبد الغنيّ فلا الغنى","إذا ما دنا الإملاق منك بناءِ",81,"ا",2,0],["يحلُّ بها عقد الشدائد كلّها","فهل مثله من وُلِّي الحلَّ والعقدا",82,"د",2,0],["يحل عقود المشكلات برأيه","إذا أشكل المعنى الدقيق وعقدا",83,"د",2,0],["يَحُلُّ لكمْ حُبَى الأَملاكِ فضلٌ","حَلَلْتُمْ من معاقِدِهِ الحِباءَ",84,"ا",2,0],["يحلُّ بذلكَ سُقْيا الغَمامِ","على فَرْطِ مدمعِه الساجِمِ",85,"م",1,0],["يَحلُّ قصورُ مِثلِكَ فِي مِثالي","حُلولَ الماء فِي ظَمْآنَ صادِ",86,"د",1,0],["يُحلّ قتلي كلّ يو","م زَمَّةٍ في حِلَّهْ",87,"ل",2,0],["يحلو جناها كلّما","شافهتَه تتذوَّقُهْ",88,"ق",2,0],["يحلُّ له منها الحرامُ لمعشر","يكونون في جِنسٍ سوى جِنسها بحرا",89,"ر",2,0],["يحلفُ لا آبَ إلا بعد قسركُمُ","يا لكَ حَلْفاً لوَ اَنّ الشيخَ مبرورُ",90,"ر",1,0],["يحلُّ به طلقُ الجبين يسرّ