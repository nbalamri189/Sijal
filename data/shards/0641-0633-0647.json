{"poems":[[102,"قالت الضحيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50170",""],[154,"يا من له شيم تملكه","https://www.aldiwan.net/poem68473.html","مجزوء الكامل"],[154,"كم في الدياجير من ذخر وفائدة","https://www.aldiwan.net/poem68518.html","البسيط"],[177,"وهيهات مشن ريب الزمان وريحه","https://www.aldiwan.net/poem4393.html","عموديه"],[214,"أكاتب خط الوصل حرر لي الضبطا","https://www.aldiwan.net/poem13302.html","الطويل"],[285,"لنا كل يوم هناء جديد","https://www.aldiwan.net/poem60772.html","المتقارب"],[310,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[357,"الحبيب الشرود","https://www.aldiwan.net/poem950.html",""],[449,"كل حمد لما صنعتم قليل","https://www.aldiwan.net/poem56020.html","عموديه"],[469,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101472","الخفيف"],[816,"","https://poetry.dctabudhabi.ae/diwan/poem/107111","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96743","البسيط"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113985","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53065","السريع"],[2249,"","https://poetry.dctabudhabi.ae/diwan/poem/202569","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100728","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83190","الرجز"],[5189,"مكة","https://www.poetsgate.com/ViewPoem.aspx?id=195284",""],[5536,"مشطوبة من الذاكرة!!","https://www.poetsgate.com/ViewPoem.aspx?id=19795",""],[6031,"أَلا تَسْتنطقُ الدِمَنَ الخَوَالي","https://www.poetsgate.com/ViewPoem.aspx?id=46291",""]],"verses":[["فسهرنا نشقى ونسترجع الأمس","ونبكي أبي ونرويه سيره",0,"ر",2,0],["فَسِهَا مُهُنٌ لواحظٌ","وقسيهُنَّ حواجب",1,"ب",1,0],["فَسُهَّدُ اللَّيلِ مصفاةٌ مواردُهُم","ونوَّمُ الليلِ لا يدرون مالاخبر",2,"ر",1,0],["فَسَهمَانِ فِي قَلبِي وَقَلبِيَ وَاحِدٌ","وَلَو كَانَ سَهماً وَاحِداً لَكَفَانِي",3,"ن",2,0],["فسهدي ونومي حين بانوا احبتي","فهذا دنا مني وهذاك قد شطا",4,"ط",2,0],["فَسُهِّلَ مِنْهُ الطِّلابُ الْعَسِيرُ","وَقُرِّبَ مِنْهُ الْمرَامُ الْبَعِيدُ",5,"د",1,0],["فَسِهامُ المنونِ مُعترضاتٌ","وَالتأنّي فيما يهمّ توانِ",6,"ن",1,0],["فسهادي كاد يودي","وردنا لن يقطفا",7,"ف",2,0],["فسهرتم ونام من لا أسمي","ه ولولا كم لحل العويل",8,"ل",1,0],["فسهامها لقطارها وسيوفها","لبروقها وقسيها لرعودها",9,"د",3,0],["فسهادٌ فلَوعةٌ فاكتئابٌ","فنحولٌ فزفرةٌ فبكاءُ",10,"ا",2,0],["فسهّل سبيلي وازو عنّيَ شرّها","وشرَّ الذي ألقاه في الأهل آيبا",11,"ب",2,0],["فسهمُ أعينها في القلب يُؤلمني","وَريقُ مَبسمها في الرشف يشفيني",12,"ن",2,0],["فَسُهبُ الكَديدِ فالغُشَيواءَ فاللَوى","لوى الساقِ بعد الأُنسِ قَفرٌ منازِلُه",13,"ل",2,0],["فسهلت منه كؤوس الطِّلى","ما كان صعباً نيله وهو صاحْ",14,"ح",1,0],["فسهام مالك في المكارم لم تزل","ابداً تقرطس في رجاء المهلق",15,"ق",1,0],["فسهرت أنظم في ثناك ليالياً","وأنا بمدحي في علاك طروب",16,"ب",1,0],["فَسَهمُ بَني الإغرِيقِ مالَ غِلى الثَّرى","وَسَهمُ بَني الطُّروَادِ لِلجَوِّ حَلَّقا",17,"ق",2,0],["فَسُهدَهُ لا السُهدَ في البُكاءِ","عَلى فِراقِ غادَةٍ هَيفاءِ",18,"ا",2,0],["فسَهِّلْ يا إلهي لي طريقاً","فإنّ الروح مَطلبها السلامُ",19,"م",1,0],["فسهمُك ِ الوردي في أضلعي","قد جاوز َ الأضلاع َ للذاكره!",20,"ر",2,0],["فَسَهْمي فَوقَ سَهْمِكَ في سُرُورٍ","يَسُرُّكَ حَيْثُ كُنتَ وشُغْلِ بالِ",21,"ل",1,0]]}