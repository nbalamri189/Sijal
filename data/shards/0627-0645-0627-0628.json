{"poems":[[53,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[53,"لا يبعدن الله برد شبيبة","https://www.aldiwan.net/poem30715.html","الكامل"],[6,"أهلي فداء بني شبيم كلهم","https://www.aldiwan.net/poem377.html",""],[30,"هل تعرف المنزل بالوحيد","https://www.aldiwan.net/poem29596.html","الرجز"],[88,"قل للحكومات في البلقان هل علقت","https://www.aldiwan.net/poem44467.html","البسيط"],[27,"ألا حي المنازل بالجناب","https://www.aldiwan.net/poem5664.html","الوافر"],[37,"أما بفارس أو بقزوين التي","https://www.aldiwan.net/poem7230.html","الكامل"],[72,"عطفت كأمثال القسي حواجبا","https://www.aldiwan.net/poem18230.html","الكامل"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[72,"قاضي القضاة بعثت لي شهب السما","https://www.aldiwan.net/poem20296.html","الكامل"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[91,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[89,"انا في خضم ثائر عجاج","https://www.aldiwan.net/poem44777.html","الكامل"],[43,"أرق على أرق ومثلي يأرق","https://www.aldiwan.net/poem9735.html","الكامل"],[45,"لم يبق في تلك الرسوم بمنعج","https://www.aldiwan.net/poem62668.html","الكامل"],[58,"تلكم قريش تمناني لتقتلني","https://www.aldiwan.net/poem31070.html","البسيط"],[49,"أما بيوتك في الدنيا فواسعة","https://www.aldiwan.net/poem62161.html","البسيط"],[80,"من كان يعذب عندها تعذيبي","https://www.aldiwan.net/poem31542.html","الكامل"],[44,"أم ابن الاعمش فاعلموها فرتنا","https://www.aldiwan.net/poem29995.html","الكامل"],[105,"بني الكنانة هذا صوتها ارتفعا","https://www.aldiwan.net/poem42100.html","البسيط"],[105,"محمد يا ابن مسلمة سلام","https://www.aldiwan.net/poem43990.html","الوافر"],[48,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[50,"يا صاح بين حاجتي","https://www.aldiwan.net/poem63885.html","مجزوء الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140815",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[106,"جمال طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179605",""],[127,"يا صاحبي لقد غفا","https://www.aldiwan.net/poem67428.html","مجزوء الكامل"],[133,"يا سيد أحمد يا قوصي","https://www.aldiwan.net/poem48848.html","عموديه"],[140,"أكذا يجازى ود كل قرين","https://www.aldiwan.net/poem58441.html","الكامل"],[158,"لقد حكمت بأمر فيه بعد","https://www.aldiwan.net/poem58903.html","الوافر"],[183,"أف لها دنيا فلا تستقر","https://www.aldiwan.net/poem14531.html","السريع"],[221,"ألا تبصر الأغصان بللها القطر","https://www.aldiwan.net/poem41891.html","الطويل"],[239,"فديتك من جان تجور وتعتب","https://www.aldiwan.net/poem45750.html","الطويل"],[273,"مهج تساق إلى الردى فتشاق","https://www.aldiwan.net/poem25476.html","الكامل"],[273,"أما بعد عتب العامرية من عتبى","https://www.aldiwan.net/poem25631.html","الطويل"],[275,"هلا سألت وريبُ الدهر ذو غيرٍ","https://www.aldiwan.net/poem1168.html",""],[303,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[369,"أما بهواه تيمني هواه","https://www.aldiwan.net/poem56988.html","الخفيف"],[374,"هذا سلام والصدور رحاب","https://www.aldiwan.net/poem66940.html","الكامل"],[399,"رميت أسهم آمالي فلم تصب","https://www.aldiwan.net/poem46936.html","البسيط"],[400,"جئت بالمعجزات من تبيانك","https://www.aldiwan.net/poem33383.html","الخفيف"],[400,"أبرق بدا أم زحزح اليوم برقع","https://www.aldiwan.net/poem33677.html","الطويل"],[400,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[403,"شهر غدا مشتهرا","https://www.aldiwan.net/poem50163.html","مجزوء الكامل"],[403,"بدا البرق من نجد فحن إلى نجد","https://www.aldiwan.net/poem50190.html","الطويل"],[403,"الآن قد صح لي حقا بلا كذب","https://www.aldiwan.net/poem50209.html","البسيط"],[406,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[429,"لو لم يحرم على الأيام إنجادي","https://www.aldiwan.net/poem12352.html","البسيط"],[436,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[466,"أبا قاسم إن أنت عاودت بعدها","https://www.aldiwan.net/poem59650.html","الطويل"],[477,"صبرا لحكمك صبرا","https://www.aldiwan.net/poem37050.html","المجتث"],[512,"حتام فيكم أعاني الشوق وأقاسي","https://www.aldiwan.net/poem20887.html","المواليا"],[527,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[527,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[538,"إني امرؤ من رعى عيني رعيت له","https://www.aldiwan.net/poem56645.html","الوافر"],[549,"إما بقيت فهلك غيرك هين","https://www.aldiwan.net/poem47818.html","الكامل"],[549,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[556,"رويدك أيها البرق اللموع","https://www.aldiwan.net/poem34391.html","الوافر"]],"verses":[["إِمّا بُكاءً بِالدُموعِ ما جَرَت","أَو بِالفُؤادِ إِن أَبى الدَمعُ وَضَن",0,"ن",1,0],["إِمّا بَكَيتُ عَلى الشَبابِ فَإِنَّهُ","قَد كانَ عَهدي بِالشَبابِ قَريبا",1,"ب",2,0],["أَمّا بَنو عَمروٍ فَإِنَّ مَقِيلَهُم","مِن ذاتِ أَصداءٍ كَسَيلِ الأَدرَعِ",2,"ع",1,0],["أَمّاً بِكُلِّ كَوكَبٍ حَريدِ","في كُلِّ سَهبٍ خَاشِعِ الحُيودِ",3,"د",1,0],["أما بنو العرب فالإخلاص يرفعهم","إلى مقام على الأقوام ممتاز",4,"ز",1,0],["أَما بالَيتَ يَومَ أَكُفُّ دَمعي","مَخافَةَ أَن يُفَنِّدَني صِحابي",5,"ب",2,0],["أما بفارس أو بقزوين التي","تَرَكَتْك غزوتُها وانفكُ أجدعُ",6,"ع",1,1],["إمَّا بخطَّيّ اليراعِ إذا الفتى","في السلمِ أو في الحربِ يغدو كاتِبا",7,"ب",2,0],["إما بأرماح أقلامٍ لكم عرفت","لياقة الحدّ أو إرماح أقلام",8,"م",1,0],["أما برقع سهيل أمسى طالعي","قدراً وأما طالع الميزان",9,"ن",1,0],["أمَّا بنو طاهرٍ فإنهُمُ","نبعُ الورى إذ سواهُمُ غَرَبُهْ",10,"ب",2,0],["أَم أَبصَرَ أَلِهَةَ الحُبِّ","تَدعوهُ إِلَيها إِماءَ",11,"ا",2,0],["اما باهداب الحياة تعلق","فلانني لم اقض منها حاجي",12,"ي",1,0],["أَمّا بَنو أَوسِ اِبنِ مَعنِ اِبنِ الرِضا","فَأَعَزُّ مَن تُحدى إِلَيهِ الأَينُقُ",13,"ق",1,0],["إِمّا بِأَشقَرَ ساطِعٍ أَغشى الوَغى","مِنهُ بِمِثلِ الكَوكَبِ المُتَأَجِّجِ",14,"ج",1,0],["أَما بَقَيتُ فَإِنّي لَستُ مُتَّخِذاً","أَهلا وَلا شيعَةً في الدّينِ إِذ فَجَروا",15,"ر",3,0],["أَمّا بُيوتُكَ في الدُنيا فَواسِعَةٌ","فَلَيتَ قَبرَكَ بَعدَ المَوتِ يَتَّسِعُ",16,"ع",1,1],["أَما بَناتي المفرداتِ فإنَّها","في الحُسنِ أَشهر من بناتِ حبيبِ",17,"ب",1,0],["أُمُّ اِبنِ الاَعمَشِ فَاِعلَموها فَرتَنا","ما أَسهَلَ المَعروفَ ثَمَّ وَأَمكَنا",18,"ن",2,1],["أما بكَوْا يَومَ تُسدِي الصُّنعَ منك يدٌ","تَشفِي الجِراحَ وتنفِي الهمَّ والوَجَعا",19,"ع",2,0],["أما بَصُرتْ بسيِّدها ذليلاً","عَبوسَ الوجهِ يَعْلُوه القَتامُ",20,"م",1,0],["إِمّا بَلاكَ لَقَد أَج","هَدَ الإِلَهُ بَلاكا",21,"ك",2,0],["إِمّا بِتَيّا أَو بِتَي","كَ وَراحَةٌ تَركُ الكِدادِ",22,"د",1,0],["أما بنو أوس بن معن بن الرضا","فأعز من تحدى إليه الأينق",23,"ق",1,0],["أَمَّا بَنُوكَ فَعِنْدَ ظَنِّ","الْنُبْلِ أَبْرَارٌ نُدُوبُ",24,"ب",1,0],["أما بنوها؛ فَحَدِّث عن سماحتهم","هم في السماحة صاروا مضرب المثل",25,"ل",1,0],["أما بقى منه أثَر","أكذا رداءُ المَجدِ يُمسي",26,"ي",1,0],["أما بنات الهوارهْ","ما يخش في بيتهم الإبريق",27,"ق",1,0],["إِمّا بيوت النحل بين شفاههم","مضمومةً أو حانةُ الزَّرَجونِ",28,"ن",1,0],["أَما بعرفهِ كفّي فتثني","وأسقيه تروح ملا وتغدو",29,"د",2,0],["إما بسُمٍّ أو سلاحٍ فلا","يأمَنُ حاليْ سَفَرٍ أو حَضَر",30,"ر",1,0],["أَما بعلبكُّ اليَومَ كَالأَمسِ زِخرها","يكلِّلُها في كُلِّ دارِسَةٍ زخرُ",31,"ر",1,0],["أَما بَرِحت في لُبَّةِ المَجدِ زَهرَةً","يُقَبِّلُها التاريخُ وَهيَ لهُ فَجرُ",31,"ر",1,0],["أما بين أيدٍ ضارعاتٍ مُشفَّعٌ","وبين دُمُوعٍ سائِلاتٍ مُقَرَّبُ",32,"ب",1,0],["أَما بَنُو يَعْقُوبَ قَدْ أوْدَى بِهِمْ","مِنْ بَأْسِهِ الإرْهَابُ والإرْهَاقُ",33,"ق",1,0],["أمَا بَعْد عَتْب العامِرِيّة مِن عُتْبى","لقد قَطَعَتْ حتّى الوَلائِدَ وَالكُتْبا",34,"ب",2,1],["أَما بَنو الحِصنِ إِذ شالَت نَعامَتُهُم","فَيَخرُجُ المَرءُ مِن ثَوبَيهِ عُريانا",35,"ن",2,0],["أَما بقريضي عاد منقار بائِها","رويّا من بحر حوى نقطة نقبا",36,"ب",2,0],["أما بِهَواهُ تَيَّمَني هَواهُ","فكَم يَرضَى ويُسخِطُه رِضاهُ",37,"ا",2,1],["أُمّاً براها الذلُّ حتى أصبحت","ومصابُها للشامتين مصاب",38,"ب",1,0],["أَمَا بِكمْ تُضربُ الأَمثالُ سائرةً","في المجدِ والجودِ والعلياء والحَسَب",39,"ب",1,0],["أم أبيحت لك الجنان عياناً","فنظمت الزهور في بستانك",40,"ك",1,0],["أم ابتسمت عُجْباً لما قال قائل","بأنِّي للعهد القديم مضيع",41,"ع",1,0],["أما بالحريبي الشقي اعتبرتُم","ففي فعله للخلق أعظمُ زاجر",42,"ر",1,0],["إِمّا بِعَينٍ أَو لُجَينٍ","أَو بِقَمحٍ أَو شَعير",43,"ر",1,0],["أما بِكُم الأَمثال تَضرِب في النَدى","أَما أَركُبُ الآمالَ نَحوَكُم تَحدي",44,"د",2,0],["إِمّا بلوغَ أَمانٍ تَنعَمينَ بِها","أَو نَيلَ منزلة تَشفي من الرِيب",45,"ب",1,0],["إِمّا بلغتُم سالمينَ فبِلِّغوا","أوفَى تحيّةِ مُشئمٍ لِعَراقي",46,"ي",1,0],["إِمّا بِطامِرَةٍ في ذَا وَطارِمَةً","أو في قَتَادٍ على هذا وأَقْتادِ",47,"د",1,0],["أَمْ أَبْرَمُوا أَمْراً يَسُوؤُكَ ذِكْرُهُ","فاللهُ ناقِضُ ذَلِكَ الإِبْرَامِ",48,"م",1,0],["أَما باعَنا رَخيصاً بِخاتَمٍ","فَلا كانَ في الدُنيا وَلا كانَ خاتَمُه",49,"م",2,0],["إما بكيت لميت","فالحي أولى وأحرى",50,"ر",2,0],["أما بكم من طبيب لعلة الياسِ","بمرهم اللطف مجروح الحشا ياسي",51,"ي",1,0],["أَمْ ابْتَعادِي لِما قَدْ زَافَ مِنْ كَلم","خَالَطْتُمُ حُبَّهُ باللّحْمِ والعَصَبِ",52,"ب",1,0],["أَمّا بسوَى الفِراقِ لَقيتَ قَلْبي","لِتَعْلَم في الحوادِثِ ما غنائي",53,"ا",2,0],["أَما بَنو هاشِمٍ حَولي فَقَد فَزعُوا","نبل الضَبابِ الَّتي جَمَّعت في قَرَنِ",54,"ن",1,0],["إمّا بقيتَ فهلكُ غيرك هّينٌ","وإذا نجوتَ فجرمُ دهرك يغفرُ",55,"ر",1,1],["أَمَّا بنو عبد الرّحيمِ فإنّهم","حدُّ الرَّجاء وغايةُ الطلابِ",56,"ب",1,0],["أم ابتسمت عشية ودعتنا","فجاد بكوننا الثغر المنوع",57,"ع",1,0]]}