poem/123492","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45092","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73316","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58031","الكامل"],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66857","الهزج"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72823","الطويل"],[4959,"الشَّهِيدُ الْفِلَسْطِينِي","https://www.poetsgate.com/ViewPoem.aspx?id=213889",""],[5055,"سيد الباب","https://www.poetsgate.com/ViewPoem.aspx?id=101195",""],[5279,"المصيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=183492",""],[5338,"إن لم تثر في نصر أهلك في اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=187944",""],[5376,"دع عنك شعرا بما هيجته أدبا","https://www.poetsgate.com/ViewPoem.aspx?id=189134",""],[5376,"حتَّام يا عربي","https://www.poetsgate.com/ViewPoem.aspx?id=190351",""],[5376,"قد عيل صبري وما ذا النزف من شيمي","https://www.poetsgate.com/ViewPoem.aspx?id=199003",""],[470,"شكرا دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=64693",""],[470,"هذي ذُرى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=63614",""],[5596,"ابوسرور فقيد الفقه والأدب","https://www.poetsgate.com/ViewPoem.aspx?id=206773",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5689,"الآم أسائل عنك القمر","https://www.poetsgate.com/ViewPoem.aspx?id=143397",""],[5701,"يا سعد قم وانظر تجد ما نستحي","https://www.poetsgate.com/ViewPoem.aspx?id=164583",""],[5732,"ياما برأس الناب","https://www.poetsgate.com/ViewPoem.aspx?id=177954",""],[5755,"ركض المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=177110",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[5909,"وجدٌ توارى فما للشوقِ يظمينا","https://www.poetsgate.com/ViewPoem.aspx?id=210237",""],[5956,"وُلِدْنا في سُجون العمر","https://www.poetsgate.com/ViewPoem.aspx?id=193566",""],[5957,"أهواكِ!!!","https://www.poetsgate.com/ViewPoem.aspx?id=12552",""],[5997,"سَرْجٌ وَأكْحَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=214284",""],[6029,"تتوارى الشّمسُ مُرْغمة","https://www.poetsgate.com/ViewPoem.aspx?id=188804",""],[6102,"أُمِّي وَأُمِّي","https://www.poetsgate.com/ViewPoem.aspx?id=182734",""]],"verses":[["إِمّا بُكاءً بِالدُموعِ ما جَرَت","أَو بِالفُؤادِ إِن أَبى الدَمعُ وَضَن",0,"ن",1,0],["إِمّا بَكَيتُ عَلى الشَبابِ فَإِنَّهُ","قَد كانَ عَهدي بِالشَبابِ قَريبا",1,"ب",2,0],["أَمّا بَنو عَمروٍ فَإِنَّ مَقِيلَهُم","مِن ذاتِ أَصداءٍ كَسَيلِ الأَدرَعِ",2,"ع",1,0],["أَمّاً بِكُلِّ كَوكَبٍ حَريدِ","في كُلِّ سَهبٍ خَاشِعِ الحُيودِ",3,"د",1,0],["أما بنو العرب فالإخلاص يرفعهم","إلى مقام على الأقوام ممتاز",4,"ز",1,0],["أَما بالَيتَ يَومَ أَكُفُّ دَمعي","مَخافَةَ أَن يُفَنِّدَني صِحابي",5,"ب",2,0],["أما بفارس أو بقزوين التي","تَرَكَتْك غزوتُها وانفكُ أجدعُ",6,"ع",1,1],["إمَّا بخطَّيّ اليراعِ إذا الفتى","في السلمِ أو في الحربِ يغدو كاتِبا",7,"ب",2,0],["إما بأرماح أقلامٍ لكم عرفت","لياقة الحدّ أو إرماح أقلام",8,"م",1,0],["أما برقع سهيل أمسى طالعي","قدراً وأما طالع الميزان",9,"ن",1,0],["أمَّا بنو طاهرٍ فإنهُمُ","نبعُ الورى إذ سواهُمُ غَرَبُهْ",10,"ب",2,0],["أَم أَبصَرَ أَلِهَةَ الحُبِّ","تَدعوهُ إِلَيها إِماءَ",11,"ا",2,0],["اما باهداب الحياة تعلق","فلانني لم اقض منها حاجي",12,"ج",2,0],["أَمّا بَنو أَوسِ اِبنِ مَعنِ اِبنِ الرِضا","فَأَعَزُّ مَن تُحدى إِلَيهِ الأَينُقُ",13,"ق",1,0],["إِمّا بِأَشقَرَ ساطِعٍ أَغشى الوَغى","مِنهُ بِمِثلِ الكَوكَبِ المُتَأَجِّجِ",14,"ج",1,0],["أَما بَقَيتُ فَإِنّي لَستُ مُتَّخِذاً","أَهلا وَلا شيعَةً في الدّينِ إِذ فَجَروا",15,"ر",3,0],["أَمّا بُيوتُكَ في الدُنيا فَواسِعَةٌ","فَلَيتَ قَبرَكَ بَعدَ المَوتِ يَتَّسِعُ",16,"ع",1,1],["أَما بَناتي المفرداتِ فإنَّها","في الحُسنِ أَشهر من بناتِ حبيبِ",17,"ب",1,0],["أُمُّ اِبنِ الاَعمَشِ فَاِعلَموها فَرتَنا","ما أَسهَلَ المَعروفَ ثَمَّ وَأَمكَنا",18,"ن",2,1],["أما بكَوْا يَومَ تُسدِي الصُّنعَ منك يدٌ","تَشفِي الجِراحَ وتنفِي الهمَّ والوَجَعا",19,"ع",2,0],["أما بَصُرتْ بسيِّدها ذليلاً","عَبوسَ الوجهِ يَعْلُوه القَتامُ",20,"م",1,0],["إِمّا بَلاكَ لَقَد أَج","هَدَ الإِلَهُ بَلاكا",21,"ك",2,0],["إِمّا بِتَيّا أَو بِتَي","كَ وَراحَةٌ تَركُ الكِدادِ",22,"د",1,0],["أما بنو أوس بن معن بن الرضا","فأعز من تحدى إليه الأينق",23,"ق",1,0],["أَمَّا بَنُوكَ فَعِنْدَ ظَنِّ","الْنُبْلِ أَبْرَارٌ نُدُوبُ",24,"ب",1,0],["أما بنوها؛ فَحَدِّث عن سماحتهم","هم في السماحة صاروا مضرب المثل",25,"ل",1,0],["أما بقى منه أثَر","أكذا رداءُ المَجدِ يُمسي",26,"ي",1,0],["أما بنات الهوارهْ","ما يخش في بيتهم الإبريق",27,"ق",1,0],["إِمّا بيوت النحل بين شفاههم","مضمومةً أو حانةُ الزَّرَجونِ",28,"ن",1,0],["أَما بعرفهِ كفّي فتثني","وأسقيه تروح ملا وتغدو",29,"د",2,0],["إما بسُمٍّ أو سلاحٍ فلا","يأمَنُ حاليْ سَفَرٍ أو حَضَر",30,"ر",1,0],["أَما بعلبكُّ اليَومَ كَالأَمسِ زِخرها","يكلِّلُها في كُلِّ دارِسَةٍ زخرُ",31,"ر",1,0],["أَما بَرِحت في لُبَّةِ المَجدِ زَهرَةً","يُقَبِّلُها التاريخُ وَهيَ لهُ فَجرُ",31,"ر",1,0],["أما بين أيدٍ ضارعاتٍ مُشفَّعٌ","وبين دُمُوعٍ سائِلاتٍ مُقَرَّبُ",32,"ب",1,0],["أَما بَنُو يَعْقُوبَ قَدْ أوْدَى بِهِمْ","مِنْ بَأْسِهِ الإرْهَابُ والإرْهَاقُ",33,"ق",1,0],["أمَا بَعْد عَتْب العامِرِيّة مِن عُتْبى","لقد قَطَعَتْ حتّى الوَلائِدَ وَالكُتْبا",34,"ب",2,1],["أَما بَنو الحِصنِ إِذ شالَت نَعامَتُهُم","فَيَخرُجُ المَرءُ مِن ثَوبَيهِ عُريانا",35,"ن",2,0],["أَما بقريضي عاد منقار بائِها","رويّا من بحر حوى نقطة نقبا",36,"ب",2,0],["أما بِهَواهُ تَيَّمَني هَواهُ","فكَم يَرضَى ويُسخِطُه رِضاهُ",37,"ا",2,1],["أُمّاً براها الذلُّ حتى أصبحت","ومصابُها للشامتين مصاب",38,"ب",1,0],["أَمَا بِكمْ تُضربُ الأَمثالُ سائرةً","في المجدِ والجودِ والعلياء والحَسَب",39,"ب",1,0],["أم أبيحت لك الجنان عياناً","فنظمت الزهور في بستانك",40,"ك",1,0],["أم ابتسمت عُجْباً لما قال قائل","بأنِّي للعهد القديم مضيع",41,"ع",1,0],["أما بالحريبي الشقي اعتبرتُم","ففي فعله للخلق أعظمُ زاجر",42,"ر",1,0],["إِمّا بِعَينٍ أَو لُجَينٍ","أَو بِقَمحٍ أَو شَعير",43,"ر",1,0],["أما بِكُم الأَمثال تَضرِب في النَدى","أَما أَركُبُ الآمالَ نَحوَكُم تَحدي",44,"د",2,0],["إِمّا بلوغَ أَمانٍ تَنعَمينَ بِها","أَو نَيلَ منزلة تَشفي من الرِيب",45,"ب",1,0],["إِمّا بلغتُم سالمينَ فبِلِّغوا","أوفَى تحيّةِ مُشئمٍ لِعَراقي",46,"ق",2,0],["إِمّا بِطامِرَةٍ في ذَا وَطارِمَةً","أو في قَتَادٍ على هذا وأَقْتادِ",47,"د",1,0],["أَمْ أَبْرَمُوا أَمْراً يَسُوؤُكَ ذِكْرُهُ","فاللهُ ناقِضُ ذَلِكَ الإِبْرَامِ",48,"م",1,0],["أَما باعَنا رَخيصاً بِخاتَمٍ","فَلا كانَ في الدُنيا وَلا كانَ خاتَمُه",49,"م",2,0],["إما بكيت لميت","فالحي أولى وأحرى",50,"ر",2,0],["أما بكم من طبيب لعلة الياسِ","بمرهم اللطف مجروح الحشا ياسي",51,"ي",1,0],["أَمْ ابْتَعادِي لِما قَدْ زَافَ مِنْ كَلم","خَالَطْتُمُ حُبَّهُ باللّحْمِ والعَصَبِ",52,"ب",1,0],["أَمّا بسوَى الفِراقِ لَقيتَ قَلْبي","لِتَعْلَم في الحوادِثِ ما غنائي",53,"ا",2,0],["أَما بَنو هاشِمٍ حَولي فَقَد فَزعُوا","نبل الضَبابِ الَّتي جَمَّعت في قَرَنِ",54,"ن",1,0],["إمّا بقيتَ فهلكُ غيرك هّينٌ","وإذا نجوتَ فجرمُ دهرك يغفرُ",55,"ر",1,1],["أَمَّا بنو عبد الرّحيمِ فإنّهم","حدُّ الرَّجاء وغايةُ الطلابِ",56,"ب",1,0],["أم ابتسمت عشية ودعتنا","فجاد بكوننا الثغر المنوع",57,"ع",1,0],["إِمّا بِجاهٍ إِلى المُلوكِ وَإِم","ما في ظِلالِ الراياتِ تَختَفِقُ",58,"ق",1,0],["أما بَينَنا وُدُّ قَديمٌ مُؤَكَّدٌ","أواخِرُه مَحفُوظَةٌ وأوائِلُه",59,"ل",2,0],["أَما بِكَ مصرك الغَراء سادَت","عَلى الأَمصار وَاِنخَذَل الحَسود",60,"د",1,0],["أم ابن أحمد مولانا محمد ال","رضا جلا كالدرراري عقد تخميس",61,"س",1,0],["أما بنو الأحلاف أهل ودادنا","فلهم يد في الفضل تَعقبها يد",62,"د",1,0],["أما بدا في حيرتي","طولٌ وفي باعي قصر",63,"ر",1,0],["إِمّا بِيَأسٍ مِنكَ أَو مَطمَعٍ","يُسدي بِحُسنِ الوُدِّ أَو يلحمُ",64,"م",1,0],["أَما بعد إِنّي قَد فهمت مقالةً","أَتت مِنكَ فيها المحكمات الغرائبُ",65,"ب",1,0],["أما بالحادثات له انزجار","اما في الاعتبار له نصيب",66,"ب",1,0],["أَما بنوكَ وطالما أَدَّبْتُهم","فسيعلمُ الملأُ الأكارمُ من هُمُ",67,"م",1,0],["أمّا بلادك فالأحداث ترهقها","والذّلّ يذهب فيها مذهب المثل",68,"ل",1,0],["أمَا بيننا حَكَمٌ عادل","ولو أنّه زمني مَا عَدل",69,"ل",1,0],["أما بنو قحطان أه","ل الحزم والرأى الخمير",70,"ر",1,0],["أم أبرَقَ العَلَمينِ أم","هَجرَ الحبيبةِ تذكرُ",71,"ر",1,0],["إما بحر إلى الجحيم مكبلاً","ومسربلاً بسرابل القطران",72,"ن",1,0],["إِمّا بِنَفعٍ أَو بِضُرّ","كَالسَيفِ لانَ وَبَتَر",73,"ر",1,0],["إِمّا بِحَدِّ سنانَ أَو مُحافِلَةٍ","فَلا قَحومٌ وَلا فانٍ وَلا ضَرَعُ",74,"ع",1,0],["أمِ ابتَسَمَت لَيلَى فَفاحَ لَنا العَرفُ","أَضَاءَت لَنا الآفاقُ مِن فَرطِ حُسنِها",75,"ه",2,0],["أمَّا بمغناكِ قد فاضتْ مدامعُهُ","لفرطِ ذكرٍ يُغَنّيه بمغْناكِ",76,"ك",1,0],["أما بِحِطِّين حُطَّت عن معارفكم","تيجانها فتخليتم عن الحُرُم",77,"م",1,0],["أمّا بتلك فلا تُرَعْ بل دُمْ لَنَا","فلك الهنا بنهاية الأزلافِ",78,"ف",1,0],["أما بنو ورغمَّة فَفَقَيهُهُمْ","لم يَجْر مَذْهَبُه على التجويز",79,"ز",1,0],["إمَّا بِتاوِيلٍ فإن أعيَا فَتَف","وِيضٌ وَنَترُكهَا لِقُولِ فُلاَنِ",80,"ن",1,0],["أما بحسب المدركين لريحها","قربا وبعدا ما هما سيّان",80,"ن",1,0],["أُمُّ أَبي عيسى وَاِسحاق","غَدَت مرتهنه",81,"ن",2,1],["اما بك سوق الغرب للغرب غادة","ومنظرها الفتان ليس له ضد",82,"د",1,0],["أَمَّا بِنَجراشي مَعَ جُدَاوَري","ودَندَبَاشي سَبعةٌ وسَاجرِ",83,"ر",1,0],["أمّا بجوش يمينِ مَا تُبَالي","أَمَّا لأرياحِ الصَّبَا الأَوَالي",84,"ي",1,0],["أَمَّا بطينُ يا أَخي شُمُطرَه","كثيرةٌ أَرقاقُهُ مُضِرَّه",85,"ه",1,0],["أَمَّا بِجَاهِ خَمسَةِ وَنِصفِ","كانَ المُرَبَّع فَآتّخَذ مِن وَصفي",86,"ي",1,0],["أمّا بُرُورُ المُلِّ مِن وَاسِيني","إلى هُنَا يَقُومُ بِاليَقِينِ",86,"ن",1,0],["أَمَّا بِقُربِ البرِّ يا ربانا","يَسقِي وَيَكبُرُ آفَهَمِ البَيَانَا",86,"ن",2,0],["أَمَّا بِقرب سُفَالَه هُو هَابِط","فَآجر لَهَا وَلاَ تَكونَ غَالِط",86,"ط",1,0],["أَمَّا براسِ الحدِّ قِيسَ المُحنِثُ","أَربَعَةً زلَّ بِهِ من يحنث",87,"ث",1,0],["أما ببحث بحثه","أو اختراعه أحداثه",88,"ه",1,0],["أما بهذا حاجزٌ عن قتلي","وهَتكِ عرضي وانتهابِ رَحلي",89,"ي",1,0],["أمُّ أبيها وهي أمُّ ابنيه","أحبُّ أهلِ بيتِه إليهِ",90,"ه",1,0],["أُمّ أبي الفضلِ وأمّ جعفرِ","وأمّ عبدِ اللَهِ شبلِ حيدرِ",91,"ر",1,0],["أما بحارُ الندى للخَلْقِ مُغْرِقةٌ","والمجدُ أغصانُه بالنصر مُورقةٌ",92,"ه",1,1],["إما بكل أو ببعض أو بلا","شيء وليس بعض أو شبهٍ جلا",93,"ل",2,0],["إِمّا بإيرادٍ تحد","دى العاشقين أَو اِرتياد",94,"د",1,0],["إما بتخويفٍ من النارِ أو","بنوعِ تشويقٍ الى الخُلدِ",95,"د",1,0],["أَمّا بَنو يَعرُبٍ فَلَيسوا كَمَن","أَسكَنَهُ اللَهُ آمِناً حَرَمَه",96,"م",