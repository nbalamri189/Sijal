ب الكرام فهم كما","عاهدتموهم في القديم سوام",121,"م",1,0],["أما بضلوعك قلب يرق","لشكوى الجوي كقلوب البشر؟",122,"ر",1,0],["أما بنو الوادي فكل وحده","نار مؤججة وثورة ثائر",123,"ر",1,0],["اما بحبل الوصل تنصف بالاحكام","والا تجور وكل ما قلت صاير",124,"ر",1,0],["اما بريشة صقر .. والا بريشة عقاب","واحد عبرها مطر .. وآخر عبرها شحوح",125,"ح",1,0],["أَمَّا (بِبَابِلَ) فَالْجَنَائِنُ شَاهِدٌ","في رَوْعَةِ الْمِعْمَارِ والإنْبَاتِ",126,"ت",1,0],["أما بصرتَ لعينٍ للكرى هجرتْ","من ذا حسيبك إن جفّت مآقينا",127,"ن",2,0],["أما بَعد العلاج وحين نبْرا","يُدَحرجنا السَّقام لحيث نُفرى؟",128,"ر",2,0],["أما بوحي ظله","قد بانَ نورٌ وضيا",129,"ا",1,0],["أَمِ اِبْكِي بِالْهَوَى أطلاْلَ حَرْفٍ","أَسَيْرًا فِي جَنَابِ الدَّهْرِ أُرَمِّلْ",130,"ل",1,0],["إمَّا بَكَوْا وَلَهاً في إثْرِ مَنْ عَشِقوا","إنِّي نَزَفْتُ لها روحي من الحدَقِ",131,"ق",1,0],["إِمَّا بِتِيهِ الدَّمعِ خارَتْ مُقلَتي","أَتبَعتُ إِنساني خُطَى إِنسانِها",132,"ن",3,0]]}