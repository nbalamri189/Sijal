{"poems":[[88,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[31,"أتعرف من أسماء بالجد روسما","https://www.aldiwan.net/poem6156.html","الطويل"],[107,"أتلك مصارع المستضعفينا","https://www.aldiwan.net/poem43397.html","الوافر"],[161,"تقبل الله منا ومنكم","https://www.aldiwan.net/poem23649.html","مجزوء الرجز"],[303,"حطمت أغلال يدي","https://www.aldiwan.net/poem36294.html","عموديه"],[463,"تمنى رجال أن تزل بي النعل","https://www.aldiwan.net/poem55997.html","الطويل"],[543,"عدو الحق عند الناس طرا","https://www.aldiwan.net/poem47994.html","عموديه"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77070","الرجز"],[4767,"دعوة صادقة","https://www.poetsgate.com/ViewPoem.aspx?id=178387",""],[5187,"وطن بلا ربيع","https://www.poetsgate.com/ViewPoem.aspx?id=29066",""],[5387,"بعد الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=53063",""],[5573,"صلوا في رحالكم","https://www.poetsgate.com/ViewPoem.aspx?id=210867",""]],"verses":[["عَلّي أُجاوِدُكُم في القَولِ مُقتَدِياً","بِشاعِرِ الأَرزِ في صُنعٍ وَإِتقانِ",0,"ن",1,0],["عَلى آجِنٍ أَبقَت لَهُ الريحُ دِمنَةً","وَحَوضاً كَأُدحِيِّ النَعامَةِ أَثلَما",1,"م",2,0],["عَلى أَجسامِهِم أَثَرٌ مُبينٌ","تُريكَ سُطورُهُ الظُلمَ المُبينا",2,"ن",2,0],["عَلَى اجْتِهَادِ عَاملٍ","بِهِ اللَّيَالِي أَقْمَرَتْ",3,"ت",1,0],["عَلَى اجتماعِ شملِنا","لغايةٍ ومطلب",4,"ب",1,0],["عليَّ اجتناءُ الفضل من شجراته","ولا ذنبَ إن لم يجنِ حظّاً ليَ الفضلُ",5,"ل",1,0],["على أجداده الدُّخلاءِ فينا","من اللعناتِ شُؤبوبٌ هطولُ",6,"ل",1,0],["عَلى أَجَلِّ المُرسَلينَ الهادي","مُحَمَّد مَن جاءَ بِالرَشاد",7,"د",1,0],["على أجنح الحب يطوي مسا","فة الدرب في سرعة فائقة",8,"ق",2,0],["على أجسادِنا يا ( بوشُ ) تَمشي","ولن تحتلَّ ( بغدادَ ) الطَغامُ",9,"م",1,0],["على أجفانها تثب الأماني","مجرحة فيخمدها الهجوعُ",10,"ع",1,0],["على اجتماع الاحبه مالهم حيله","وقلوبهم صابها فالشوق زلزالي",11,"ل",2,0]]}