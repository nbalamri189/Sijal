{"poems":[[396,"الحذر كل الحذر كل الحذر","https://www.aldiwan.net/poem54514.html","عموديه"],[396,"الحذر كل الحذر كل الحذر من","https://www.aldiwan.net/poem54520.html","عموديه"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131533",""],[2296,"","https://poetry.dctabudhabi.ae/diwan/poem/138927","الرجز"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107012","الرجز"],[5461,"يا صقر","https://www.poetsgate.com/ViewPoem.aspx?id=508",""],[5606,"ياقمرنور بنورك","https://www.poetsgate.com/ViewPoem.aspx?id=194585",""],[6056,"اقول معصي","https://www.poetsgate.com/ViewPoem.aspx?id=130136",""]],"verses":[["الحذر كل الحذر كل الحذر","من معاداة الأمائل والنذال",0,"ل",1,1],["الحذر كل الحذر كل الحذر","من دخولك يا فتى في ذا الفضول",1,"ل",1,1],["الحذف عند علماء الشعر","يكون في ممدوده بالقصر",2,"ر",1,0],["الحذر لا يدفع المقدور","هيهات ما قدر الله كان",3,"ن",1,1],["الحذف للصون وللانكار","والاحتراز أو للاختيار",4,"ر",1,0],["الحذف والقطع يعدان معا","الجزء بترا فيه اما اجتمعا",5,"ع",2,0],["الحذر يا صقر لا يشبكونك أسير","ويل صقر يتله مربطه لى نوى",6,"و",2,0],["الحذر ثم الحذر ثم الحذر","الخطر والموت في بحر العيون",7,"ن",1,0],["الحذر ماهوب ينفع والدعاء مرجم حصي","نوبة ٍرجمة تصيب ونوب تخطي رجمتين",8,"ن",1,0]]}