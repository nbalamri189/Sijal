{"poems":[[90,"لنا ملك وليس له رعايا","https://www.aldiwan.net/poem44793.html","الوافر"],[74,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[63,"صدودك علم النوم الصدودا","https://www.aldiwan.net/poem51720.html","الوافر"],[48,"إذا ردنت فيما يعود لطفلها","https://www.aldiwan.net/poem22611.html","الطويل"],[136,"أثار بلى دور الأحبة فينا","https://www.aldiwan.net/poem54731.html","عموديه"],[138,"ألا هل أتى بحرينا صنع ربنا","https://www.aldiwan.net/poem20995.html","الطويل"],[146,"تفيض نفوس بأوصابها","https://www.aldiwan.net/poem58421.html","المتقارب"],[280,"قضى صادق الآثار في أمرك الأرضى","https://www.aldiwan.net/poem25491.html","الطويل"],[354,"متى شمت برقا للصوارم لامعا","https://www.aldiwan.net/poem15777.html","الطويل"],[382,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[422,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[422,"هو البرق مما راعها وشجاها","https://www.aldiwan.net/poem54106.html","الطويل"],[482,"تضاعف ما ألقاه غير بديع","https://www.aldiwan.net/poem15269.html","الطويل"],[558,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122739","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122599","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122621","الطويل"],[699,"","https://poetry.dctabudhabi.ae/diwan/poem/104490","المجتث"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37997","الطويل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100140","الطويل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42456","الوافر"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42445","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53182","الطويل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146360","الطويل"],[3085,"","https://poetry.dctabudhabi.ae/diwan/poem/76575","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65348","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26120","الوافر"],[3413,"","https://poetry.dctabudhabi.ae/diwan/poem/146794","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92014","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97100","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81682","الطويل"],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5582,"هوَ الدَّهْرُ فِينا جائِدٌ غَيْرُ جائِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186912",""],[5725,"قلاك القلب","https://www.poetsgate.com/ViewPoem.aspx?id=196514",""],[5939,"وقد يُفصِحُ الزهرُ عمّا مَسَك","https://www.poetsgate.com/ViewPoem.aspx?id=178613",""]],"verses":[["متى شَفِق القويّ على ضعيف","وكيف يعاهد الخِرفانَ سِيد",0,"د",1,0],["متى شئت يا راعي الكرام وجدته","غمام الندى في دسته قمر الندي",1,"د",2,0],["متى شرَّفْتُ غيرَك بامتداحي","لَبِسْتُ بمدحِكَ الشَّرَفَ العَتيدا",2,"د",2,0],["مَتى شَرِبَت خَمراً فَلَستُ بِآمِنٍ","عَلَيها غَوِيّاً أَن يُحَلَّ خِمارَها",3,"ر",3,0],["مَتَى شَجَنٌ مِن ذِكرِ سَاكِنَهَأ انقَضَى","يُخَلِّفُ أحشَاءَ العَمِيدِ شُجُونَا",4,"ن",2,0],["مَتى شركَ الأَقوامُ في جُلِّ أَمرِنا","وَكُنّا قَديماً قَبلَها نَتَوَدَّدُ",5,"د",1,0],["متى شاء يقطِف وردَ الخدود","وقَتْهُ الأكفُّ بعُنّابها",6,"ب",3,0],["مَتَى شَحَّ صَوْبُ القَطْرِ سَحَّ أنَامِلاً","وَإنْ غاضَ صَرْفُ الدَّهْرِ مُعْتَدِياً أَغْضَى",7,"ض",2,0],["مَتى شِمتُ بَرقاً لِلصَوارِمِ لامَعا","جَلا ضَوءُهُ يَأسي وَجَلّا المَطامِعا",8,"ع",2,1],["متى شِمتُ برقاً بارقاً من رسومها","رأيت سحابَ الجفن بالدمع يذرف",9,"ف",1,0],["متى شئتَ غادَرْتَ البلاد كأَنَّما","سَقَتْها الغوادي ساجماً بعد ساجم",10,"م",1,0],["متى شاءَ أوراها وأثقبَ زندها","وشبَّت بفرسان الرِّجال لظاها",11,"ا",3,0],["متى شئتُ غازلتُ الغزالَ مُقرَّطا","على غِرَّةِ الواشي وباتَ ضجيعي",12,"ع",2,0],["مَتّى شِئتَ رَفَّعتَ الرِواقَ عَلى الغِنى","إِذا أَنتَ زُرتَ الفَضلَ أَو أَذِنَ الفَضلُ",13,"ل",1,0],["مَتَى شِئتُ أَصفاني كَريمةَ مالِهِ","وَحَكَّمَني في خَيلِهِ وَبِغالِه",14,"ل",2,0],["مَتى شِئتَ يا ريبَ الزمانِ فَعاوِد","وقارِب عَلَى ما كانَ مِنكَ وباعِدِ",15,"د",1,1],["متَى شَجَّها بالماء هاجَ مِزاجُها","لَها شَرَرٌ مِن جَمرِها المتَسَعِّر",16,"ر",1,0],["متى شعاعك يبدو","لنا فيجلو الظلاما",17,"م",2,0],["مَتى شِمتُها يَشفى فُؤادي وَمُهجَتي","وَتَكحلُ عَيني بِالسُّرورِ وَبِالهَنا",18,"ا",1,0],["متى شن جيش الدهر غارةً غدره","توهم منه سطوة فتذعذعا",19,"ع",2,0],["متى شَعرتْ بهِ وجناتُ ظبيٍ","أتاها الحسنُ من كُلِّ الجهاتِ",20,"ت",1,0],["متى شطَّتْ بكَ الأحبابُ يوماً","أسلتَ الدمع ياقوتاً مبدَّدْ",21,"د",1,0],["متى شام طرفي برقَ غَيْرِ منيل","فلا جاد نوء النُّجح أرض مُحُول",22,"ل",1,1],["متى شق جيب الجنح بالبارق الومض","وهبت قبول فالسلام على الغمض",23,"ض",1,1],["مَتى شِئتَ اسمَ مَن يَهواهُ قَلبِي","فَذاكَ اسمٌ بِهِ يُبدا الكَلامُ",24,"م",1,0],["متى شفّني كأُس الغرامفريقهُ","علاجيومن لي بالمعالج يُشفيني",25,"ن",2,0],["مَتّى شَهِدَت فَوارِسَنا كُلَيبٌ","ضَلَلتَ وَأَنتَ مِن بَلَدِ الضَلولِ",26,"ل",1,0],["متى شملتني صحة وفراغ","وقوت به لي غنية وبلاغ",27,"غ",1,1],["متى شاقه حِلٌّ يراعُ برحلةِ","فماذا ترجّي يا ابنَ آدمَ بعد أنْ",28,"ن",1,0],["متى شمت فوق الصعاد الرؤوس","بأدمعهن الصعيد ارتوى",29,"و",2,0],["متى شاء يحْجبها بنصلٍ وذابلٍ","وإن شاءَ يَحجُبْها بصلٍّ ووجناءِ",30,"ا",2,0],["متى شاءَ لم يقنع من القِرن نَصْلُهُ","بغير سوادِ الطَّرف أو بالسُّويداءِ",30,"ا",2,0],["متى شاع عنكم يا بني اللوم أنكم","نصرتم محقاً أو قليتم محرما",31,"م",2,0],["متى شاع عنكم أنكم قد نكأتم","عدواً رماكم بالصواب فأيكما",31,"م",2,0],["متى شاع عنكم هتك ستر كل مشبه","متى شاع عنكم دحض من قد تجهما",31,"م",2,0],["متى شاع رفض الروافض عنكمو","وهل نصركم إلاَّ لمن كان مجرما",31,"م",2,0],["مَتَى شاءَ مِنْها سَلَّ ما شاءَ قائِداً","عَلَى الكُرْهِ عَنْ رَعْيِ الكَلا وَالمَوارِدِ",32,"د",1,0],["متى شفتاك ينبجسان عفوا","لنشرب منهما شهدا وراحا",33,"ح",2,0],["متى شفتاكِ تلوذانِ باسْمي","إذا الوجدُ بالليلِ قد أيأسَكْ؟",34,"ك",1,0]]}