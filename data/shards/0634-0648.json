أَلَمَّ وَما شَوقي إِلى أَحَدٍ","سِوى الَّذي نامَ عَن لَيلي وَأَيقَظَني",0,"ن",2,0],["شَوقٌ يُعَرِّضُ لا إِلى الآرامِ","وَجَوىً يُخادِعُني عَنِ الأَحلامِ",1,"م",1,1],["شَواحٍ مِنَ الطَعنِ أَفواهُها","كَما جَرَّتِ الناصِحونَ الجِلاما",2,"م",2,0],["شَوقٌ أَقامَ وَأَنتِ غَيرُ مُقيمَةٍ","وَالشَوقُ بِالكَلفِ المُعَنّى أَعلَقُ",3,"ق",1,0],["شَوسٍ إِذا الباغي بَغى","سُمحٍ إِذا الجادي جَدا",4,"د",2,0],["شَوقاً إِلَيكَ وَإِشفاقاً عَليكَ وَلي","دَمعانِ ما بَينَ مَحلولٍ وَمَعقودِ",5,"د",1,0],["شَوقٌ عَلى نَأيِ الدِيارِ مُغالِبٌ","وَجَوىً عَلى طولِ المَطالِ مُبَرِّحُ",6,"ح",1,0],["شَواجِرُ أَرحامٍ إِذا ما وَصَلتَها","فَعِندَ أَميرِ المُؤمِنينَ ثَوابُها",7,"ب",3,0],["شَواهِقُ مِن جِبالِ النَقعِ تَرمي","بِها أَبَداً غُدوّاً أَو مَساءَ",8,"ا",2,0],["شُوسٌ كأمْثالِ الصّقورِ أعْنَقَتْ","بهِمْ مَذاكِيها كأسْرابِ القَطا",9,"ا",1,0],["شُوسُ الحَواجِبِ في الهَيْجاءِ إذْ لَقِحَتْ","بيضُ المَسافِرِ وهّابونَ ما سُئِلوا",10,"ل",3,0],["شوارِدُ أمثالَ اللآلِئِ ما لَها","إذا انتَثَرَتْ إلاَّ بِناديكُمُ لَقْطُ",11,"ط",1,0],["شوْقي إليْكَ قويٌّ","لكِنْ قُوايَ ضَعيفَةْ",12,"ف",2,0],["شَوْقُ نفْسي الى كَلامِكَ يحْكي","نارَهُ للجَحيمِ ذاتِ الوَقودِ",13,"د",1,1],["شُوَاظٌ أَرَادَ اللهُ إِطْفَاءَ نَارِهِ","وَقَدْ لَفَحَ الإِسْلاَمَ مِنْ كُلِّ جانِبِ",14,"ب",1,0],["شَوَّفتُماني أَيُّها الفَرقَدانِ","لِبَدرٍ تَمٍّ غابَ قَبلَ الأَوانِ",15,"ن",1,1],["شَوَّقتَنا لِلتُربِ بَعدَكَ وَاِشتَهى","فيهِ الإِقامَةَ واحِدُ العَذراءِ",16,"ا",2,0],["شَوقي وَمَطرانَ وَصَبري وَمَن","سَمَّيتُهُ في مَطلَعي الباهِرِ",17,"ر",1,0],["شَوقي نَسَبتَ فَما مَلَكتُ مَدامِعي","مِن أَن يَسيلَ بِها النَسيبُ الشَيِّقُ",18,"ق",1,0],["شَوقاً إِلى ساكِني دِمَشقَ فَلا","عَدَت رُباها مَواطِرُ السُحبِ",19,"ب",1,0],["شَوارِعُ في ثَرى الخَرماءِ لَيسَت","بِجاذِيَةِ الجُذوعِ وَلا رِقالِ",20,"ل",1,0],["شَوامِذَ قَد أَرتَجنَ دون أَجِنَّةٍ","وَهوجٍ تَبارى في الأَزِمَّةِ حولِ",21,"ل",1,0],["شوقي نزيلٌ بكل قلبٍ","في صورة ما بها جمود",22,"د",1,1],["شَوْقٌ دَعَا فَأَجَبْتَ لا تَلْوِي بِمَا","تُسْتَامُ مِنْ جَرَّائِهِ وَتُعَانِي",23,"ن",2,0],["شَوْقٌ تُكابِدُهُ وَيَثْوِي مِنْكَ فِي","مَثْوَى الرُّؤى مِنْ مُهْجَةِ الْوَسْنَانِ",24,"ن",1,0],["شَوقَاً إِلَيكَ فَمَا تَنَالُكَ حَالُهُ","وَإذَا يَحِلُّ البَابَ لَم يُؤذَن لَهُ",25,"ل",2,0],["شَوقاً وَهَل يُبكي الهَوى أَمثالي","لَمّا اِستَرَقَّ الجَزءُ لِانزِيالِ",26,"ل",1,0],["شَوائِيا لِلسائِقِ الغِرّيدِ","إِذا حَداهُنَّ بِهيد هيدِ",27,"د",1,0],["شوقاً لمحرسةِ العذَّال إن نظرت","سباقة لسيوف اللحظ للعذل",28,"ل",1,0],["شويت يا مهجتي إن كنتُ عاتبهم","وإن وجدت لساناً قائلاً فقلي",29,"ي",1,0],["شوقاً لمن لست على حبّه","بصالح لكنّ قلبي كليم",30,"م",1,0],["شوقاً أجدت عليه نثر مدامعي","وعلى عُلا قاضي القضاة نظامي",31,"م",2,0],["شوقاً كما حكم الفارق لمالكٍ","ولى ولكن عندنا نيرانه",32,"ن",2,0],["شَواهِدُها عَلَيها ناطِقاتٌ","تُبَطِّلُ كُلَّ دَعوى المُدَّعينا",33,"ن",2,0],["شَوىً ما أصابت أسهمُ الدهر بعده","هوى من هوى أو مات بالرمل بَحرَجُ",34,"ج",1,0],["شُؤبُوبُ غيثٍ مُصْعِقٍ مُغْدِقٍ","تهتانُهُ الوابِلُ لا الرَشْحُ",35,"ح",1,0],["شوقي إليك على الأيام يزداد","والقلب بعدك للأحزان معتادُ",36,"د",1,0],["شواهدٌ مقبولةٌ","ناهيك من شواهدِ",37,"د",1,0],["شواردَ لا يثنى المُهيب شريدها","ولا يتناهى غربُها حين يُزجر",38,"ر",1,0],["شؤم رأيٍ أتى على الشرق والغر","بِ من المدَّعى الدعِيِّ النحيس",39,"س",1,0],["شوهاءَ معشُوقةً يُخلِّدها","حِفظ حفيظٍ ورقشُ رقاش",40,"ش",1,0],["شَواخِصُ بِالأَبصارِ مِن كُلِّ مُقرَبٍ","أُعِدَّ لِهَيجا أَو مُواقَفَةِ الرَكبِ",41,"ب",1,0],["شَوقاً إِلَيهِم وَوَجداً يَومَ أُتبِعُهُم","طَرفي وَمِنهُم بِجَنبَي كَوكَبٍ زُمَرُ",42,"ر",1,0],["شَوازِبَ كَالقَنا قَد كانَ فيها","مِنَ الغاراتِ وَالغَزوِ اِقوِرارُ",43,"ر",1,0],["شَوقٌ يَروحُ مَعَ الزَمانِ وَيَغتَدي","وَالشَوقُ إِن جَدَّدتَهُ يَتَجَدَّدِ",44,"د",1,1],["شَوقي إِلَيكَ أَشَدَّ مِن","شَوقِ السَليمِ إِلى الهُجود",45,"د",1,0],["شَوقي إِلَيكَ شَديدٌ","كَما عَلِمتَ وَأَزيَد",46,"د",1,1],["شوّقتها حتى إذا أظمأتها","قام السراب بها مقام الماء",47,"ا",2,0],["شَوقاً وَحُبّاً بِالرَسو","لِ وَآلِهِ أَزكى سُلالَه",48,"ل",2,0],["شَوقي إِلَيكَ عَلى النَوى","شَوقُ الضَريرِ إِلى الغَزالَه",48,"ل",2,0],["شَوقي إِلَيكَ نَفى لَذيذَ هُجوعي","فارَقتَني فَأَقامَ بَينَ ضُلوعي",49,"ي",1,1],["شَوَائِلَ تَشْوَالَ العَقَارِبِ بالقَنَا","لهَا مَرَحٌ مِنْ تَحْتِهِ وَصَهيلُ",50,"ل",1,0],["شواردُ لا يزالُ بهن أنسٌ","يُحَلُّ لحسنِها طوقُ الحمامِ",51,"م",1,0],["شَوقٌ تَلَبَّسَ بِالفُؤادِ دَخيلُهُ","وَالشَوقُ يُسرِعُ في الفُؤادِ الواجِدِ",52,"د",1,0],["شَوقٌ لَهُ بَينَ الأَضالِعُ هاجِسُ","وَتَذَكُّرٌ لِلصَدرِ مِنهُ وَساوِسُ",53,"س",1,1],["شَوكَةٌ ما أَصابَتِ الدَهرَ إِلّا","تَرَكَت في الغِرارِ مِنهُ فُلولا",54,"ل",2,0],["شَوقاً إِلى رَشَإٍ لا الشَمسُ تُشبِهُهُ","وَلا الهِلالُ إِذا تَمَّت لَياليهِ",55,"ي",2,0],["شَوقٌ إِلَيكَ تَفيضُ مِنهُ الأَدمُعُ","وَجَوىً عَلَيكَ تَضيقُ مِنهُ الأَضلُعُ",56,"ع",1,1],["شَواجِرُ أَرماحٍ تُقَطِّعُ بَينَهُم","شَواجِرَ أَرحامٍ مَلومٍ قُطوعُها",57,"ع",3,0],["شَوازِبُ قَد كانَت دِماءُ نُحورِها","نِعالاً لِأَيديها وَهُنَّ كَواتِفُ",58,"ف",1,0],["شَوامِخٌ لِبَني شَمخٍ إِذا اِرتَفَعَت","لا تُرتَقى وَأَشَدُّ الناسِ أَركانا",59,"ن",2,0],["شَوارِداً في البِلادِ ما افترَقَتْ","إلاّ رَأَيتَ اللبيبَ يَفرُقُها",60,"ق",3,0],["شَوائِلُ أذنابٍ يُخَيَّلُ أنَّها","عقارِبُ دَبَّتْ فَوقَ صَرْحٍ مُمَرَّدِ",61,"د",1,0],["شَوَىً أثوابُهُ قُشُبُ","ومَدٌّ شأنُه عَجَبُ",62,"ب",1,1],["شوقي إليكم والديار قريبة","إن قلت زال مع التقارب زادا",63,"د",2,1],["شُواظُ وَغىً كُلٌّ يُحاذِرَ وَقدَها","وَنارُ قِرىً كُلٌّ إِلى ضَوئِها يَعشو",64,"ش",2,0],["شوسٌ تَرى مِنهُم في كُلِّ مُعتَرِكٍ","أُسدَ العَرينِ إِذا حَرُّ الوَطيسِ حَمي",65,"م",2,0],["شوسٌ تَظُنُّ العِدى سِهامَهُمُ","شُهُباً بِها المارِدونَ قَد رُجِموا",66,"م",3,0],["شَوقي إِلَيكُم وَالدِيارُ قَريبَةٌ","إِن قُلتُ زالَ مَعَ التَقَرُّبِ عادا",67,"د",2,1],["شَوقي إِلى عَلياكَ أَعظَمُ أَن يُرى","مُتَعَدِّدا وَيَعُمَّهُ الإِحصاءُ",68,"ا",2,0],["شَوقاً إِلى أَكنافِ رَبعِكُمُ الَّذي","كُلّي إِلَيهِ تَشَوُّفٌ وَتَشَوُّقُ",69,"ق",1,0],["شوسُ النَواظِرِ وَهيَ في","غَيرِ الدُجُنَّةِ غَيرُ شوسِ",70,"س",1,0],["شوقي نظمت فكنت برّاً خيِّراً","في أمة ظمأى إلى الأخيارِ",71,"ر",1,0],["شوقي على رغم التفر","ردِ والتفوقِ والعلاء",72,"ا",2,0],["شوقاً إليهم ومحضاً من وفائهمُ","ل