بسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112692","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89116","الكامل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123922","الكامل"],[3576,"","https://poetry.dctabudhabi.ae/diwan/poem/128403","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138712",""],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141477","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77136","الكامل"],[4699,"لقاء في الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=153960",""],[4929,"قُلْ للذي أبْكَتْ يداهُ زماني","https://www.poetsgate.com/ViewPoem.aspx?id=199282",""],[4119,"لو كان سرك للوشاة معرضا","https://www.poetsgate.com/ViewPoem.aspx?id=16177",""],[3591,"ظن الحبيب بأن الصب قد عدلا","https://www.poetsgate.com/ViewPoem.aspx?id=149380",""],[5120,"مَطَرٌ بِقَلْبِي","https://www.poetsgate.com/ViewPoem.aspx?id=207959",""],[5212,"وارث النَّبي","https://www.poetsgate.com/ViewPoem.aspx?id=211736",""],[5397,"أبسفح حاجر منك يسفح محجر","https://www.poetsgate.com/ViewPoem.aspx?id=157963",""],[5397,"لمن الرواسم بين تلك الأرسم","https://www.poetsgate.com/ViewPoem.aspx?id=157956",""],[5408,"لو مرة حاولت","https://www.poetsgate.com/ViewPoem.aspx?id=190757",""],[5409,"غمر السرور فؤادها بزواجه","https://www.poetsgate.com/ViewPoem.aspx?id=155300",""],[5431,"أغنية الخليج 3","https://www.poetsgate.com/ViewPoem.aspx?id=202771",""],[5447,"بذرة","https://www.poetsgate.com/ViewPoem.aspx?id=208365",""],[5451,"لكم مزماركم ولي مزماري","https://www.poetsgate.com/ViewPoem.aspx?id=155932",""],[5484,"هذي الطلول فقف بنا يا ساري","https://www.poetsgate.com/ViewPoem.aspx?id=206304",""],[5493,"غضبى","https://www.poetsgate.com/ViewPoem.aspx?id=206893",""],[470,"هذي ذُرى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=63614",""],[6068,"هل تارك روحي لنصح العاذل","https://www.poetsgate.com/ViewPoem.aspx?id=181693",""],[572,"شَمْسُ الضّحَى في الغَمَامِ مُسْتَتِرَهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9290&r=&rc=147",""],[572,"لمّا رأيتُ مَطَايَاهُمْ معلّقة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9430&r=&rc=287",""],[572,"لستُ على عذلِكَ صَبَّارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9316&r=&rc=173",""]],"verses":[["حَتّى إِذا نَسَمَت رِيا","حُ الصُبحِ تُؤذِنُ بِالفِراقِ",0,"ق",1,0],["حَتّى إِذا نَطَقوا وَآذَنَ فيهُمُ","داعي الشَتاتِ بِرِحلَةٍ وَتَفَرُّقِ",1,"ق",1,0],["حَتّى إِذا نالَت نَحا سَلِباً","وَقَد عَلَتهُ رَوعَةٌ وَوَهَل",2,"ل",1,0],["حَتّى إِذا نَشِبَت حَربٌ رَأَيتَ بِها","أَغوالَ قَفرٍ وَلَكِن تَنهَشُ الحَجَرا",3,"ر",2,0],["حَتّى إِذا نَزَتِ القُلوبُ وَقَد","لَزَّت هُناكَ العُذرَ بِالعُذرِ",4,"ر",1,0],["حتى إذا نشب الضفي","ر بجاذب للحبل باترْ",5,"ر",1,0],["حتى إذا نغض العدو م","وتم خَصْلُك من تُخاصلْ",6,"ل",1,1],["حتّى إذا نبهتَهُ لعظيمةٍ","ألفيته والرأيُ منه أصيلُ",7,"ل",1,0],["حَتّى إِذا نَشَرَ القُنوطُ ضَبابُهُ","فَوقي فَغَيَّبَني وَغَيَّبَ مَوضِعي",8,"ع",2,0],["حَتّى إِذا نَطَقَ العُصفورُ وَاِنكَشَفَت","عَمايَةُ اللَيلِ عَنهُ وَهوَ مُعتَمِدُ",9,"د",1,0],["حتى إذا نفدت جميع نقودها","وغدا الأثاث يباع ثم يوزَّع",10,"ع",1,0],["حَتّى إِذا نَزَعوا الدُجى وَتَسَربَلوا","مِن فَضلِ هَلهَلَةِ الصَباحِ الغائِرِ",11,"ر",1,0],["حتى إذا نَكَصَتْ على أعقابِها","دَلَفَ النَّبيطُ إليَّ من شِمْشاطِ",12,"ط",1,0],["حتى إذا نَعِمَتْ به أجسامُنا","وقَضَتْ به وطَراً من الأوطارِ",13,"ر",1,0],["حتى إذا نِلْتَ به لَذَّةً","ليسَ على مَن نالَها حُوبُ",14,"ب",1,0],["حَتّى إِذا نَكَصَ القَومُ الكَمِيُّ بِهِ","وَأَعوَزَت عِندَ دَعواهُ الأَسانيدُ",15,"د",1,0],["حَتّى إِذا نَكَصَ المُكافِحُ جاءَها","مُتَهادِياً في خَطوِهِ يَتَرَفَّقُ",16,"ق",1,0],["حتى إذا نادتكم ال","أوطان والوادي أهاب",17,"ب",1,0],["حتى إذا نَبَذوا الصّوارِمَ بينَهُم","قِطَعاً وسُمْرَ الزّاغبيّةِ أكعُبا",18,"ب",2,0],["حَتّى إِذا نَزَعَ الرُوّادُ رَغوَتَها","وَأَقصَتِ النارُ عَنها كُلَّ ضَرّاءِ",19,"ا",2,0],["حَتّى إِذا نَقَلَت كاساتِها خُرُدٌ","مِن بَينِ ذي قُرطُقٍ أَو ذاتِ زِنّارِ",20,"ر",1,0],["حتّى إذا نادَمَهُمْ سَيفُه","بكلِّ كأسٍ مُرَّةِ الطَّعمِ",21,"م",1,0],["حَتَّى إِذَا نَالَ مِنْهُ السُّكْرُ قَامَ إِلَى","فَيَّاضَةِ الْقَرْءِ لَمْ تُعْهَدْ بِتَطْهِيرِ",22,"ر",1,0],["حَتَّى إِذا نَمَّ الصَّبَا وَتَتَابَعَتْ","زِيَمُ الْكَواكِبِ كَالْمَهَا الْمُتَبَدِّدِ",23,"د",1,0],["حَتَّى إذا نَطَقُوا وآذانَ فيهِمُ","داعي الشَّتاتِ بِرِحلَة ٍ وَتَفَرقِ",24,"ق",1,0],["حتى إذا نبذوا الصوارمَ بينهم","قَطَعاً وسُمْرَ الزّاعبيّة ِ أكعُبا",25,"ب",2,0],["حَتّى إِذا نَزَلَت صِرّينَ مُقبِلَةً","جاشَت بِحارُ رَدىً طَمَّت عَلى القُلُبِ",26,"ب",1,0],["حتى إذا نضِبَتْ بحارُ عُبابِه","عنهُ سِوى حَمَأٍ بها مَسْنونِ",27,"ن",1,0],["حَتّى إِذا نَشَت بَعدَ حينٍ","وَطالَتِ اللِّحيَةُ اللَئيمَه",28,"م",2,0],["حَتّى إِذا ناداهُ خالقُهُ إِلى","فَردوسِهِ فَمضى وَلَم يَتَوقَّفِ",29,"ف",1,0],["حَتّى إِذا نَفَضَ الأَيّامُ مِرَّتَهُ","وَاِستَوقَدَ الهَمُّ في صُدغَيهِ وَالأَسَفُ",30,"ف",1,0],["حتى إذا نلتَ ما تهوَى بلا كدرٍ","فاجعل منامك فوقَ المَتْن والكَفَل",31,"ل",1,0],["حتى إذا نكَّسته نَكْسَ من","يُبْدِل مِنه الحرف بالحرفِ",32,"ف",1,0],["حتى إذا نفَث الشَّرابُ بُخارَهُ","أصبَحتَ تبكي كالصَّغيرِ وتنحب",33,"ب",1,0],["حَتّى إِذا نشر الاموات واِرتعدت","فَرائص الخلق من بعض الَّذي نالوا",34,"ل",3,0],["حَتّى إِذا نشر الاموات يوم غد","وكل نفس رأت ما قدمت لغد",35,"د",1,0],["حَتّى إِذا نَهَتِ الأُولى فَما انْتَفَعُوا","بِالنَّهْي وَالْبَغْيُ فِيهِمْ شَرُّ أَمّارِ",36,"ر",1,0],["حتى إذا نامت جراحاتي","وخلتُ هواك طبّي",37,"ي",1,0],["حَتّى إِذا نَزَلَ المَشي","بُ وَصِرتَ بَينَ عِمامَتَين",38,"ن",1,0],["حتّى إذا نشَرتْه الكَفُّ لم تَرَ لي","إلاّ سُجوداً وإلاّ لَثْمَ قرطاس",39,"س",1,0],["حتَّى إِذا نَبَّهتَه","وأَحَسَّ مَن وَلَّى تَولَّى",40,"ل",2,0],["حتى إذا نلْنَا الذي نبتغي","من فتح باب الأملِ المغلقِ",41,"ق",1,0],["حتّى إذا نَادَتِ السبعونَ حَسبُكَ مِنْ","تَعليلِ قَلبِكَ بالآمالِ والكَذِبِ",42,"ب",1,0],["حتى إذا نحن أحرمنا على ثقة","سرنا الهويني إلى الإحرام في حشد",43,"د",1,0],["حتى إِذا نبذوا العهود وهوّموا","ناشدتهم ويدي بذيل النابذ",44,"ذ",1,0],["حتى إذا نيطت به لُوطِفت","جروحُها بالعاصِب الملحِمِ",45,"م",1,0],["حتى إذا نزلت عليك وشاهدت","ملكاً لزند الملك منه أوار",46,"ر",1,0],["حتى إذا نلت سؤلي من مواهبه","وصادني بشباك الوصل والمنن",47,"ن",1,0],["حَتّى إِذا نَضَبَ النَهارُ وَأُدرِجَت","في اللَيلِ شَمسُ نَهارِهِ المُتَوَرِّسِ",48,"س",1,0],["حَتَّى إِذَا نَحْنُ قَضَّيْنَا لُبَانَتَنَا","وَغَيَّبَتْ وَجْهَهَا فِي الكِلَّةِ احْتَمَلُوا",49,"ل",3,0],["حَتَّى إِذَا نِلْنَا بِهِ","أَوْطَارَ لَهْوٍ وَغِبَطْ",50,"ط",1,0],["حَتَّى إِذَا نَفْحَةُ الصَّبَا نَسَمَتْ","نَمَّتْ عَلَيْهَا الرَّوَائِحُ العَطِرَهْ",51,"ر",2,0],["حتى إذا نادى به بلال","للفجر قال لهم يقال",52,"ل",1,0],["حتى إذا نظروا حديث مدامعي","يروي الجوى عن قلبي المتسعر",53,"ر",1,0],["حتى إذا نشر البخار لواءه","في الأفق وائتمن الحمامُ القَشعما",54,"م",2,0],["حتى إذا نشبت لظاها لم أكن","متقاعسا عنها ولم أتحول",55,"ل",1,0],["حتى إذا نعمت بليلة عرسه","وتفيأ الضيف الجديد المنزلا",56,"ل",2,0],["حَتّى إِذا نامَ وَقَد أَسكَرتهُ","قَتلت فرخيه وَما شَكرته",57,"ه",1,0],["حتَّى إذا نزلوا أرض العتيكِ رَعت","أموالهم بين أمواهٍ وتثبيتِ",58,"ت",1,0],["حتَّى إذا نَهضّت بغيْر تَبَذُّل","ظلّت تنوءُ بِرَدْفها المَتَرجرجِ",59,"ج",1,0],["حتى إذا نظر الدفاع عن الحمى","أضحى بغير المشرفي ضعيفا",60,"ف",2,0],["حَتّى إِذا نَضَحَت من بردِهِ عَرقاً","حَسِبتها لَبِسَت وَشياً مِنَ الدُرَرِ",61,"ر",1,0],["حتى إذا نام طرف الجهل وانتبهت","عين النهى قرعا سنيهما ندما",62,"م",2,0],["حَتى إذا نُثِرَ المَدِيحُ بَدَا لَهُ","بَدْءَ الهَوَى ذاك الكثيفُ الألطَفُ",63,"ف",1,0],["حتى اذا نظروا الى متقلص","اهدامه ذي وفرة شعثاء",64,"ا",2,0],["حَتّى إِذا نَزَلَ الرُصافَةَ شُيِّدَت","فيها قِبابٌ حَولَهُ وَخِيامُ",65,"م",1,0],["حتى إذا نهلوا من وردهم صدروا","عنه وهم رسل اصلاحٍ واحسان",66,"ن",1,0],["حتى إذا نزلَ القضاءُ وأبرَما","خلعَتْ هياكلَها بذياكَ الحِمى",67,"ا",1,0],["حتى إذا نقعت غليل أُوامِها","ووفى لها من ربها بوعوده",68,"د",2,0],["حتىّ اذا نودوا الى الدار الَّتي","نال السعادة منهم من نالها",69,"ل",3,0],["حَتّى إِذا نَفذ القَضاء وَقَدر ال","مَحتوم فيهِ وَحَتم المَقدور",70,"ر",1,0],["حتى اذا نبذ القضاء واقبلت","زمر العدى تستن في عدواتها",71,"ت",3,0],["حتى إذا نثر التبلّجُ وردَه","متدارِكاً فطفا على الريحان",72,"ن",1,0],["حتى إذا نظرت عين الحسود لنا","ففرّقتنا وعادَ السقمُ والوجعُ",73,"ع",1,0],["حتى إذا نظر البري احسانه","في العفو يغبط ما رأى بالمجرم",74,"م",1,0],["حتّى إذا نزلت سياحة أرضه","خيلٌ عليها للحُروب ضراغمُ",75,"م",1,0],["حتى إذا نطقت صدقاً صوارمها","أصغى لحجتها من كان ذا صمم",76,"م",1,0],["حتى إذا نزل القضاء","وأنفذ المقدور حتمه",77,"م",2,0],["حتى إذا نثرت جواهر منطق","نظمت أوامره صحاح الجوهر",78,"ر",1,0],["حتى إذا نزلوا العراق فأشرقتذ","بوجوههم وسيوفهم ظلماتها",79,"ت",3,0],["حتى إذا نجحت مساعيه التي","كانت لسوء الحظ أصلا بلائه",80,"ا",3,0],["حتى إذا نفذ القضا ونجيبه","من تحته لم يرفع الأقداما",81,"م",2,0],["حتى إذا نَدَّ منهمْ واحدٌ عَرَضتْ","وسائطُ السوءِ في تكدير ما تَهَب",82,"ب",1,0],["حَتّى إِذا نَزَلتَ بِساحاتِ العِدى","نَكَصوا عَلى الأَعقابِ كُلَّ مُشَرَّد",83,"د",1,0],["حتى إذا نارُ الغرام تَوَهَجَتْ","ولَمَسْتُ خَدَّاً ناعِماً وأسيلا",84,"ل",2,0],["حتى إذا نَبَتَتْ لديكَ مخالبٌ","صارت لِشَرِّكَ آلةَ الطغيانِ",85,"ن",1,0],["حتى إذا نازلت فارس لحظه","ما زلت منه محاربا ومحرضا",86,"ض",2,0],["حتى إذا نشروا المنديل ذكرهم","حسن الترقي وأِجاهم بياض طلى",87,"ل",2,0],["حَتَّى إِذَا نَادَى عَلَيْهَا غَادَرَتْ","مِثْلَ الطُّيُورِ تَفِرُّ مِنْ أَعْشَاشِهَا.",88,"ش",3,0],["حتّى إذا نَزَلَ الخِطابُ بآيةٍ","بلِّغ لِما قَد جاءَ في القرآنِ",89,"ن",1,0],["حتى إذا نفذ القضاء بحلمه","وجرى عليه من الصروف مقدر",90,"ر",1,0],["حتى إذا نفذت سرائر حكمة","رسمت على لوح القضاء المحكم",91,"م",1,0],["حتّى إذا نَفْسي اطمَأنّتْ واحْتَفَتْ","عَجِلاً أَتى نكَدُ الزَّمَانِ يُكَسِّرُكْ",92,"ك",1,0],["حتى إذا نعمت بليلة عرسه","وتفيأ الضبف الجديد المنزلا",93,"ل",2,0],["حتى إذا نضب الوعاء بزيته","عاد الربيب لمركز الأصفار",94,"ر",1,0],["حتى إذا نَمَتْ القصيدةُ وانحنت","لتبوسَ قلبَكَ فابتعد متوجسا",95,"س",2,0],["حتى إذا نَهَضَتْ لَمَسْتُ مكانَها","فأصابَني مما لَمَسْتُ دُوَارُ",96,"ر",1,0],["حتى إذا نزل القضاء ولم يكن","إلا الورود لمنهل الأقدار",97,"ر",1,0],["حتَّى إذَا نَفذَ اصْطبَارِي عنْدَمَا","بلغتْ سُيولُ القهْرِ منْ قلبِي الزُّبَى",98,"ب",2,0],["حَتَّى إذا نالَنا غاصَتْ أظافِرُنا","في لَحْمِهِ وَيَظَلُّ الموتُ مَشلولا",99,"ل",2,0],["حتى إذا نام الرقيب اتى بها","ذاك الذي في زفرة المتثاقل",100,"ل",1,0],["حتَّى إذا نَفْخَة ُ الصّبا نَسَمَتْ","نَمَّتْ عليها الرَّوايحُ العَطِرَهْ",101,"ر",2,0],["حتَّى إذا نَحْنَ قَضَّيْنَا لُبَانَتَنَا","وغيّبَتْ وجَههَا في الكلّة ِ ارتحَلُوا",102,"ل",3,0],["حتَّى إِذا نحنُ قَضَيْنَا بِهِ","من عُذَرِ اللذَّاتِ أَوطارا",103,"ر",2,0]]}