budhabi.ae/diwan/poem/29374","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91454","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34611","المتقارب"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95331","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103022","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111423","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70161","الوافر"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75686","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81946","الطويل"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29451","الطويل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121265","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72790","الطويل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116051","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120512","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139637",""],[4692,"طفل تبخر في الايام وانفلتا","https://www.poetsgate.com/ViewPoem.aspx?id=190440",""],[4784,"برق التهاني في سناه ائتلقا","https://www.poetsgate.com/ViewPoem.aspx?id=170935",""],[4578,"إلامَ أرجى من زماني التدانيا","https://www.poetsgate.com/ViewPoem.aspx?id=49615",""],[4888,"معراج عشقي .. (في حب الرسول)","https://www.poetsgate.com/ViewPoem.aspx?id=207773",""],[3271,"إني سائر للخلود","https://www.poetsgate.com/ViewPoem.aspx?id=103531",""],[5135,"سبحان رب الكون","https://www.poetsgate.com/ViewPoem.aspx?id=201992",""],[5219,"تشطير أبيات جميل بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=194992",""],[5290,"لعل نسيمات الضحى والأصائل","https://www.poetsgate.com/ViewPoem.aspx?id=113131",""],[5338,"لا تعذل العين أن أرخت عزاليها","https://www.poetsgate.com/ViewPoem.aspx?id=187832",""],[5397,"تبلجت ليلة في سعدها طلعا","https://www.poetsgate.com/ViewPoem.aspx?id=157936",""],[5409,"تهللت كالعارض الباكر","https://www.poetsgate.com/ViewPoem.aspx?id=155493",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5449,"أرقُّ العطر","https://www.poetsgate.com/ViewPoem.aspx?id=188954",""],[709,"هذَا الْحِمى فَانْزِلْ عَلَى جَرْعائِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=2903",""],[5596,"شمائل سمائل","https://www.poetsgate.com/ViewPoem.aspx?id=206377",""],[5720,"سَاكنُ يَثْرِبﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=201015",""],[5732,"الصدر ضاق وحاير الدمع دفاق","https://www.poetsgate.com/ViewPoem.aspx?id=177846",""],[6056,"عيب ٍ عليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=130525",""],[6090,"بدت لنا بمحيا أخجل البدرا","https://www.poetsgate.com/ViewPoem.aspx?id=170914",""]],"verses":[["وَأَسفَعَ لَثَّمَتهُ الشَمسُ نَدبٌ","أَبَينا أَن يُلَقَّبَ بِالهِجانِ",0,"ن",1,0],["وَأَسفَحُ الدَمعَ لِلأَعادي","إِنّي إِذاً فارِغُ الدُموعِ",1,"ع",1,0],["وَإِسفِنطَ عانَةَ بَعدَ الرُقا","دِ شَكَّ الرِصافُ إِلَيها غَديرا",2,"ر",2,0],["وأسفرَ عن سنا قمرٍ منيرٍ","ولكني وجدتُ بهِ الضَّلالا",3,"ل",2,0],["وأَسفر القمرُ الساري فصفحتُه","ريَّا لها من صفاءِ الجوِّ لألاءُ",4,"ا",2,0],["وَأُسفِهتُ إِذ مَنَّيتُ نَفسي اِبنَ واسِعٍ","مُنىً ذَهَبَت لَم تَسقِني بِذَنوبِ",5,"ب",1,0],["وأسفرَ حَظِّيَ لمَّا رآ","كَ بيني وبينَ اللَّيالي سَفيرا",6,"ر",2,0],["وأسفْرتَ والألوانُ تَرْبَدُّ خِيفَةً","وبيضُ الظُّبا تَدْمَى وسُمْرُ القَنا تَفْنَى",7,"ا",1,0],["وَأَسفَرَ بَعدَ ذَلِكَ عَن سَماءٍ","كَأَنَّ نُجومَها حَدَقُ المِلاحِ",8,"ح",1,0],["وَأسِفَ القلبُ لكنزي الذي","غَصَّت به أفئدة الحُسَّدِ",9,"د",1,0],["وآسفا للعالَمِ البائدِ","ليس له مما يرى مهربُ",10,"ب",1,0],["واسفِري تلك حُلىً ما خُلقت","لسوى لثمٍ وضمٍ واجتلاء",11,"ا",2,0],["واسفلت أسواق مستعمر ... أضأت مسافاتها ، وانطفيت","وروّيتها من عصير الجبين ... وأنت كصحرائها ، ما ارتويت",12,"ت",1,0],["وأسفاري إلى الماضي","وإبحاري إلى الآتي",13,"ت",2,0],["واسفلت أسواق مستعمر","أضأت مسافاتها ، وانطفيت",14,"ت",1,0],["وأسفر عن وجهٍ وسيم مقسمِ","قد افترّ عن ثغرٍ بسيم منضدِ",15,"د",1,0],["وأسفر الأنسن به عن طلعة","تملا حواليك القلوب بشرا",16,"ر",2,0],["وأسفرت فاراد الصبح يفضحنا","خافت فأبدت لنا ليلا من الشعر",17,"ر",1,0],["واسفِري تلك حلىً ما خُلِقَت","لِتُواري بِلئامٍ أو خباء",18,"ا",2,0],["وأَسفرتْ فبدا من وجهها قمَرٌ","عليه من شرِها داجٍ من الظُّلَم",19,"م",1,0],["وَاِسفِر بِجاهِكَ بَينَ حَظّي وَالغِنى","وَتَقاضَ لي أَيّامَ دَهري الماطِلِ",20,"ل",1,0],["وَاسفِر عَنِ النُعمى لِسَفّارَةٍ","غَربِيَّةٍ جاءَتكَ في سِفرِ",21,"ر",1,0],["وَأَسفَرَ وَجهُ الحَظِّ جِذلانَ باسِماً","وَعَهدي بِهِ وَهوَ العَبوسُ المُكَلِّحُ",22,"ح",1,0],["وأسفح ذو رُمحين يضحي كأنه","إذا ما علا نَشْزاً حصان مُبرقع",23,"ع",1,0],["واِسفَح دموعَك إِن مررتَ بسفحه","شغفاً به إِنَّ الدموعَ جمانُهُ",24,"ن",2,0],["وأَسفرَ عنها الصبحُ لمّا تلثَّمت","وَلَو أَسفرت للصُبح يَوماً تلثَّما",25,"م",2,0],["وأَسفرت أَوجُهُ الآمال ضاحكةً","واِستبشرت بشفا عليائِك الأُممُ",26,"م",1,0],["وأَسفرَت عن سَنى وجه أَبانَ لنا","بدرَ التَمام ولكن ليلُه الشَعَرُ",27,"ر",1,0],["وَأَسفَر عَن بَدر التَمام نِقابه","فَأثبت دَعوى حُسنهِ بِدَليلهِ",28,"ل",2,0],["وَآسف لَو كانَ التأَسّف نافِعاً","عَلَيهِ وَلَكنَّ الثَناء لَهُ أَحرى",29,"ر",2,0],["وأسفرَ وَجهه عَن بَدر تمٍّ","وَلَكن فَوق غُصن نقاً تبدّى",30,"د",2,0],["وَاَسفح دَمع مُشتاق عَميدٍ","إِلى سَكن نَأى عَنهُ فَقيد",31,"د",1,0],["وآسَفُ كيفَ أَخْلَقَ عَهدُ وُدِّي","وآسَى كَيفَ أَخلفَ فيكَ ظَنّي",32,"ن",2,0],["وأسْفَرَ عن سنا قمرٍ منيرٍ","ولكنْ قدْ وَجَدْتُ به الضلالا",33,"ل",2,0],["وأسفر وجه المجد من فرح به","ووطّد أركان الندى والتكرم",34,"م",1,0],["وأسْفَرَ رَيْبُ السُّخْطِ عن صادِقِ الرِّضا","ولاح هِلالُ الوصلِ من مَغْربِ الصَّدِّ",35,"د",1,0],["وأَسْفَرَ عَنْ زُهْرِ النُّجُومِ كَأَنَّما","جَبينُكَ أَبْدى عن خَلائِقِكَ الزُّهْرِ",36,"ر",1,0],["واسفك دم الراووق كل السفْكِ","وافحص برجليك لفرط الضحكِ",37,"ك",1,0],["وأسفحُ مِن فوقِها أدمعاً","تُخَدَّدُ في صَحْنِ خدَّي مَسيلا",38,"ل",2,0],["واِسْفَحْ بذاكَ السّفْحِ حول غَديرِه","دمعاً يعسجِدُ ذَوبَ فضّةِ مائِهِ",39,"ا",3,0],["وأسفر الفجر وفاحت به","حدائق الورد وروض الشقيق",40,"ق",1,0],["وَأَسفَرَ السَبتَ عِن هَزيمَتِهِم","وَأَصبَحَ المُلكُ ضِمنَ مَن أُسِروا",41,"ر",3,0],["واسفِكُوا بِاللهِ دَمعي وَدَمي","هَدَراً كانَ حَراماً وَحلالا",42,"ل",2,0],["وآسَفُ في الصُدودِ لسوءِ حَظّي","إِذا لَم أنتَشِق ورداً وآسا",43,"س",2,0],["وَأسْفَرَتِ الثريَّا إذْ تَهَادَتْ","لِطَرْفِ سُهَيْلِهَا فَازْدَادَ نُوراَ",44,"ر",2,0],["واسفع يهدى القوم بالخافق الذى","دُوين الشباة إِن يَرَ الموت يصطل",45,"ل",1,0],["وَأَسفرت وضياءُ الصبحِ متّضحٌ","فَقلت قَد أزعج الداجي بصبحينِ",46,"ن",1,0],["وَأَسفر عَنهُ لَيله وَهوَ ساجد","وَأَدمعه مِن خشية اللَه تهمر",47,"ر",1,0],["واسفرت الآلاء عن وجه حسنها","بابراز شمس في الورى ما لها حذا",48,"ذ",2,0],["وَأَسفَرَ تَحتَ النَقعِ حَتّى كَأَنَّهُ","صَباحٌ مَشى في ظُلمَةِ اللَيلِ طالِعُ",49,"ع",1,0],["واسفرن عن خدين حازا عبادتي","كأنهما لي في الهَوى صَنَمان",50,"ن",1,0],["وأسفر وجههن فهمت وجداً","وقلت البدر أشرق في الدجنة",51,"ن",2,0],["وأسفر عن وجه من الود واضح","كما حط عن وجه الصباح لثام",52,"م",1,0],["وأسفلها مزارع كل نبت","وأعلاها المصانع والحصونا",53,"ن",2,0],["واسفري عن وجهك الباهي هدىً","واملئي الأرجاء نوراً ذهبيا",54,"ي",2,0],["وأسفرتِ عن وجهٍ تكامل حسنهُ","بطلعته نوراً ملأت عيوني",55,"ن",2,0],["وأسفارٌ له تُجلى بها لا","مُعَتَّقَةٌ يطوُف بها المُديرُ",56,"ر",1,0],["واسفر عن لثام","واشهدني الجمال",57,"ل",1,0],["وأسفر وجه الدهر بعد قطوبه","وعزّ به الاسلام واشتد عضده",58,"د",2,0],["وأسفرت المصالح عن عداء","فكل كامن كالصل رام",59,"م",1,0],["وَآسَفَتكَ ثَقيفٌ إِذ نُدِبتَ لَها","تَدعو لِرَبِّكَ في سَهلٍ وَفي عَلَمِ",60,"م",1,1],["وأسفر ليل الجور عن صبح فتية","مع العدل والإنصاف أمسوا وأصبحوا",61,"ح",3,0],["وأسفتُ أني لم أنل","حظي ولم أقض المرام",62,"م",1,0],["وَآسفا عَلى العشا","مطبقاً مكشمشا",63,"ش",2,1],["واسفوا لمَّا بقبرٍ قد ثوى","حزناً على الفضائل التي حوى",64,"ح",3,0],["واسفح دموعك من عيونك علها","تطفى لهيب جوى الفؤاد وتخمد",65,"د",1,0],["واسفّ انا واياه كاس المدام","واصبح بخمر الثغر ساكر",66,"ر",1,0],["وَأَسفَرنَ عَن مِثلِ الشُموسِ طَوالِعاً","بِأَعيُنِ عِينٍ عَزَّ مِنها نُفورُها",67,"ر",3,0],["وَأَسفَرَت عَن مُحَيّا مَن رآه خال","بَدراً بَدا وَنَضَت عَنها بُرودَ الخال",68,"ل",1,0],["وَأَسفَعُ دارَ فَوقَ الطَوقِ مِنهُ","سَوادٌ مِثلُ خَطِّ الكاتِبينا",69,"ن",2,0],["وآسف إذ أضعت بهن وقتي","ونورَ نواظري وثمين فكري",70,"ر",2,0],["وآسف أن شعري سوف يبقى","بدنيا مالها أبداً بقاء",71,"ا",2,0],["واسفح عليّ دموع عينك ساعة","وامنن بها حمراً تفيض همولا",72,"ل",2,0],["واسفل صاعد للمجد قوم","على حرماتهم كان الصعود",73,"د",1,0],["وأسف لما ولى وأو","دع في الدفاتر والحفر",74,"ر",1,0],["وأسفَرَ الفرغان عن","أربعةٍ من الشهب",75,"ب",1,0],["وأسفح الدمع على وجه الثرى","منهمراً منهمعاً منهملا",76,"ل",2,0],["وأسفرت في الدجى كالبدر في فلك","عن فاحم كظلام الليل منسدل",77,"ل",1,0],["وَأَسفَر وَجه الدَهر عَن غُرّة المنا","بِأَهيب بَسام عَزيز مُؤيد",78,"د",1,0],["وأسفل منكم بكر حلول","على تعثاى رئيت القباب",79,"ب",1,0],["وَأَسفحُ دَمعاً طلُّهُ فَوق وابلٍ","يَسيرُ بحاراً طامِياتِ الجَوانب",80,"ب",1,0],["وأسفرت الأرضُ عن حُلَّةٍ","تُضاحكُ بالأحمرِ الأصفرا",81,"ر",2,0],["واسفر الصبح وقد خنست","عنه تأخرت وقد أخنست",82,"ت",1,0],["وأسفر البدر عن ديباج رونقه","فزاده رونقاً حسن وإحسان",83,"ن",1,0],["وأسفلِيذُونَ وأُرخُومِينُ","من مِينُسٍ قَيلُهُما يَلمِينُ",84,"ن",1,0],["واسفرَ عَن وجوهِ القَوم صبحٌ","يرينا بهجَةً فوقَ الخُدودِ",85,"د",1,0],["وَأَسفر منبلجاً وجه الزَمان وَقَد","قامَت عَلى ساقها الدنيا من الطرب",86,"ب",1,0],["وأسفر صبح منه بعد ظلامه","فأوضح معنى ظاهر ثم باطن",87,"ن",1,0],["وَأَسفَلَ مِنّي نَهدَةً قَد رَبَطتُهَا","وَأَلقَيتُ ضِغثاً مِن خَلى مُتَطَيِّبِ",88,"ب",1,1],["وأسفَرَت البراقِعُ عن خدودٍ","أقولُ تحمّرت بدَمِ الكبودِ",89,"د",1,0],["وأسفر بالأسعاد بعد قطوبه","جبين الأماني عن أسرّة اقبال",90,"ل",1,0],["وأسفَرَ الجوُّ حتى ظَنَّ مُبصِرُهُ","بأنّ لَمعَ السَّنَا فى أُفقِهِ ضَحِكُ",91,"ك",1,0],["واسفاره اللاءى طبعن بضبطه","وتصحيحه اسفرن في الشرق والغرب",92,"ب",1,0],["وأسفرت الأيام عن غرةٍ لها","سنا نور فضلٍ منه عمَّ الثرى وَقد",93,"د",1,0],["وأسفر الصبح عن جنبيه فانبجست","هموم كهل فشاب الرأس وهْوَ فتى",94,"ت",2,0],["وأسفر الفضل وحقا فيه من","بعد شتات بلقاه استوسقا",95,"ق",2,0],["وأسفح من عيني عقبقاً نقدته","لذكري ليال قد تفضت لا ليا",96,"ي",2,0],["وأَسْفَرَتْ مِن مَجانيها على مَهَلٍ","كالبِكْرِ لمّا بَدَتْ ترنو بلا عَمَدِ",97,"د",1,0],["وأسفر الصبح على نحسها","فطاح ميثاقٌ وخِينتْ عهودْ",98,"د",1,0],["وأَسْفَرَتْ مِنْ وراءِ التَّلِ فَاتِنَةٌ","فألْقَتِ المِرْطَ في الكُثْبَانِ عِقْيَانا",99,"ن",2,0],["وأسفرت عن ثغرها البسام مؤتلقا","كأنه حين أبدته لنا برد",100,"د",1,0],["وأسفار صبح الشيب عن ليل لمتي","دليل على ظل من العمر زائل",101,"ل",1,0],["وَأسْفَرَ الأُفقُ عَنْ شَمْسٍ يُجَلّلُها","وَجْهُ الوَصيِّ وَبِالأَنْوَارِ يَقْرِيها",102,"ي",3,0],["وأسفر الحق عن إيضاح طلعتها","كأنه نير في أفقه سطعا",103,"ع",2,0],["وأسفرت الحرب عن فاجعٍ","يثير التوجع للذاكر",104,"ر",1,0],["وأسفر عن ليل المفازة بالمنى","لهم موهناً صبح المفازة يشرق",105,"ق",1,0],["وأسفارٌ ، وترحالٌ","فيحسدُ حالنا النَّورُ",106,"ر",1,0],["واسفح بذاكَ السّفحِ قبلَ غديرهِ","دَمْعاً يُعَسْجِدُ ذَوْبَ فِضَّة ِ مَائِهِ",107,"ا",3,0],["وأسفرت غادة الفصحى ببسمتها","عنه فأفصح تشكيلاً وتنوينا",108,"ن",2,0],["وأَسْفَرَتِ الحياةُ بخيرِ دينٍ","أقام نعيمَها وطوىٰ الخطُوبا",109,"ب",2,0],["واسفر حجاجه وابدل الوجه باشراق","وافتر عن بيض تكاشف بها بروق",110,"ق",1,0],["وأسفّ دمع ٍ من على الخد سفاّ","يذرف كما وبل ٍ تحدّر مزونه",111,"ن",2,0],["وأسفرت عن محياها وقد شربت","راحا فقد هتكت في شرعنا السترا",112,"ر",2,0]]}