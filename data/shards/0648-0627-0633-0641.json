{"poems":[[53,"أمن شوق تعانقني الأماني","https://www.aldiwan.net/poem29668.html","الوافر"],[53,"أأترك الغر من لداتي","https://www.aldiwan.net/poem30129.html","مجزوء البسيط"],[9,"غشيت لليلى بليل خدورا","https://www.aldiwan.net/poem21941.html","المتقارب"],[72,"بدت ورنت لواحظه دلالا","https://www.aldiwan.net/poem20544.html","الوافر"],[51,"لولا فواكه أيلول إذا اجتمعت","https://www.aldiwan.net/poem7933.html","البسيط"],[29,"خليلي قوما للرحيل فإنني","https://www.aldiwan.net/poem6047.html","الطويل"],[61,"ثنت لك أعطافها والخصورا","https://www.aldiwan.net/poem51673.html","المتقارب"],[61,"رويدك عن تفنيد ذي المقلة العبرى","https://www.aldiwan.net/poem51837.html","الطويل"],[52,"لمن دار وربع قد تعفى","https://www.aldiwan.net/poem27164.html","الوافر"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[133,"بعيد اللقا وافى وأنجز موعدي","https://www.aldiwan.net/poem49122.html","الطويل"],[158,"يا بحر قلدت أخاك البحرا","https://www.aldiwan.net/poem59050.html","الرجز"],[208,"يا ظبية البان يا غصن النقا النضر","https://www.aldiwan.net/poem13316.html","البسيط"],[223,"يا لواء الحسن أحزاب الهوى","https://www.aldiwan.net/poem55176.html","الرمل"],[227,"لما أشارت بعناب على عنم","https://www.aldiwan.net/poem50834.html","البسيط"],[233,"أمط اللثام عن العذار السائل","https://www.aldiwan.net/poem31792.html","الكامل"],[233,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[233,"عسى الدهر يوما بالبخيلة يسمح","https://www.aldiwan.net/poem32121.html","الطويل"],[292,"لعمري لجو من جواء سويقة","https://www.aldiwan.net/poem1750.html","الطويل"],[295,"ذاك الحجاز وهذه كثبانه","https://www.aldiwan.net/poem33089.html","الكامل"],[295,"وأبرزتها بطحاء مكة بعدما","https://www.aldiwan.net/poem33162.html","الطويل"],[295,"صحت لصحتك العلياء والكرم","https://www.aldiwan.net/poem33175.html","البسيط"],[295,"وافتك والزهر في روض الدجى زهر","https://www.aldiwan.net/poem33266.html","البسيط"],[351,"أدار سلاف الراح من سلسبيله","https://www.aldiwan.net/poem39999.html","الطويل"],[351,"ألا هل لقلب عنك قد فقد الصبرا","https://www.aldiwan.net/poem40238.html","الطويل"],[351,"ألام بحبه فأزيد وجدا","https://www.aldiwan.net/poem40390.html","الوافر"],[377,"قفوا بالناجيات على زرود","https://www.aldiwan.net/poem49202.html","الوافر"],[406,"محيا ما أرى أم بدر دجن","https://www.aldiwan.net/poem32530.html","الوافر"],[413,"بدا ورنت لواحظه دلالا","https://www.aldiwan.net/poem53886.html","الوافر"],[434,"أنخ أيها الحادي المطي وسلّم","https://www.aldiwan.net/poem2559.html","الطويل"],[436,"تصدت لوشك البين من جفوة الصد","https://www.aldiwan.net/poem34776.html","الطويل"],[436,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[450,"يا مؤثرا للهو طيب النعمه","https://www.aldiwan.net/poem13927.html","الكامل"],[475,"أراها عن الجزع تبغي عدولا","https://www.aldiwan.net/poem15225.html","المتقارب"],[512,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[556,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"]],"verses":[["وَأَسفَعَ لَثَّمَتهُ الشَمسُ نَدبٌ","أَبَينا أَن يُلَقَّبَ بِالهِجانِ",0,"ن",1,0],["وَأَسفَحُ الدَمعَ لِلأَعادي","إِنّي إِذاً فارِغُ الدُموعِ",1,"ع",1,0],["وَإِسفِنطَ عانَةَ بَعدَ الرُقا","دِ شَكَّ الرِصافُ إِلَيها غَديرا",2,"ر",2,0],["وأسفرَ عن سنا قمرٍ منيرٍ","ولكني وجدتُ بهِ الضَّلالا",3,"ل",2,0],["وأَسفر القمرُ الساري فصفحتُه","ريَّا لها من صفاءِ الجوِّ لألاءُ",4,"ا",2,0],["وَأُسفِهتُ إِذ مَنَّيتُ نَفسي اِبنَ واسِعٍ","مُنىً ذَهَبَت لَم تَسقِني بِذَنوبِ",5,"ب",1,0],["وأسفرَ حَظِّيَ لمَّا رآ","كَ بيني وبينَ اللَّيالي سَفيرا",6,"ر",2,0],["وأسفْرتَ والألوانُ تَرْبَدُّ خِيفَةً","وبيضُ الظُّبا تَدْمَى وسُمْرُ القَنا تَفْنَى",7,"ا",1,0],["وَأَسفَرَ بَعدَ ذَلِكَ عَن سَماءٍ","كَأَنَّ نُجومَها حَدَقُ المِلاحِ",8,"ح",1,0],["وَأسِفَ القلبُ لكنزي الذي","غَصَّت به أفئدة الحُسَّدِ",9,"د",1,0],["وآسفا للعالَمِ البائدِ","ليس له مما يرى مهربُ",10,"ب",1,0],["واسفِري تلك حُلىً ما خُلقت","لسوى لثمٍ وضمٍ واجتلاء",11,"ا",2,0],["وأسفر عن وجهٍ وسيم مقسمِ","قد افترّ عن ثغرٍ بسيم منضدِ",12,"د",1,0],["وأسفر الأنسن به عن طلعة","تملا حواليك القلوب بشرا",13,"ر",2,0],["وأسفرت فاراد الصبح يفضحنا","خافت فأبدت لنا ليلا من الشعر",14,"ر",1,0],["واسفِري تلك حلىً ما خُلِقَت","لِتُواري بِلئامٍ أو خباء",15,"ا",2,0],["وأَسفرتْ فبدا من وجهها قمَرٌ","عليه من شرِها داجٍ من الظُّلَم",16,"م",1,0],["وَاِسفِر بِجاهِكَ بَينَ حَظّي وَالغِنى","وَتَقاضَ لي أَيّامَ دَهري الماطِلِ",17,"ل",1,0],["وَاسفِر عَنِ النُعمى لِسَفّارَةٍ","غَربِيَّةٍ جاءَتكَ في سِفرِ",18,"ر",1,0],["وَأَسفَرَ وَجهُ الحَظِّ جِذلانَ باسِماً","وَعَهدي بِهِ وَهوَ العَبوسُ المُكَلِّحُ",19,"ح",1,0],["وأسفح ذو رُمحين يضحي كأنه","إذا ما علا نَشْزاً حصان مُبرقع",20,"ع",1,0],["واِسفَح دموعَك إِن مررتَ بسفحه","شغفاً به إِنَّ الدموعَ جمانُهُ",21,"ن",2,0],["وأَسفرَ عنها الصبحُ لمّا تلثَّمت","وَلَو أَسفرت للصُبح يَوماً تلثَّما",22,"م",2,0],["وأَسفرت أَوجُهُ الآمال ضاحكةً","واِستبشرت بشفا عليائِك الأُممُ",23,"م",1,0],["وأَسفرَت عن سَنى وجه أَبانَ لنا","بدرَ التَمام ولكن ليلُه الشَعَرُ",24,"ر",1,0],["وَأَسفَر عَن بَدر التَمام نِقابه","فَأثبت دَعوى حُسنهِ بِدَليلهِ",25,"ل",2,0],["وَآسف لَو كانَ التأَسّف نافِعاً","عَلَيهِ وَلَكنَّ الثَناء لَهُ أَحرى",26,"ر",2,0],["وأسفرَ وَجهه عَن بَدر تمٍّ","وَلَكن فَوق غُصن نقاً تبدّى",27,"د",2,0],["وَاَسفح دَمع مُشتاق عَميدٍ","إِلى سَكن نَأى عَنهُ فَقيد",28,"د",1,0],["وآسَفُ كيفَ أَخْلَقَ عَهدُ وُدِّي","وآسَى كَيفَ أَخلفَ فيكَ ظَنّي",29,"ي",1,0],["وأسْفَرَ عن سنا قمرٍ منيرٍ","ولكنْ قدْ وَجَدْتُ به الضلالا",30,"ل",2,0],["وأسفر وجه المجد من فرح به","ووطّد أركان الندى والتكرم",31,"م",1,0],["وأسْفَرَ رَيْبُ السُّخْطِ عن صادِقِ الرِّضا","ولاح هِلالُ الوصلِ من مَغْربِ الصَّدِّ",32,"د",1,0],["وأَسْفَرَ عَنْ زُهْرِ النُّجُومِ كَأَنَّما","جَبينُكَ أَبْدى عن خَلائِقِكَ الزُّهْرِ",33,"ر",1,0],["واسفك دم الراووق كل السفْكِ","وافحص برجليك لفرط الضحكِ",34,"ك",1,0],["وأسفحُ مِن فوقِها أدمعاً","تُخَدَّدُ في صَحْنِ خدَّي مَسيلا",35,"ل",2,0],["واِسْفَحْ بذاكَ السّفْحِ حول غَديرِه","دمعاً يعسجِدُ ذَوبَ فضّةِ مائِهِ",36,"ا",3,0],["وأسفر الفجر وفاحت به","حدائق الورد وروض الشقيق",37,"ق",1,0]]}