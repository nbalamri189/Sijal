{"poems":[[65,"سرت وجنح الليل غربيب","https://www.aldiwan.net/poem46147.html","السريع"],[2,"لمن طلل برامة لا يريم","https://www.aldiwan.net/poem25054.html","الوافر"],[46,"ريب دهر أصم دون العتاب","https://www.aldiwan.net/poem30322.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39554","الخفيف"],[98,"الْقُطْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=187539",""],[98,"القطب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66342&r=&rc=19",""],[240,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[309,"من عاون الشيطان في ظلمه","https://www.aldiwan.net/poem16851.html","السريع"],[354,"يأبي عادل القوام وإن ما","https://www.aldiwan.net/poem15857.html","الخفيف"],[369,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[409,"لولا الرجا ما انتهضت إرادة","https://www.aldiwan.net/poem34171.html","الرجز"],[563,"فر إبليس عن هدى العرفان","https://www.aldiwan.net/poem33728.html","الخفيف"],[563,"هو أمر وكل أمر","https://www.aldiwan.net/poem34499.html","مجزوء الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62513","الرمل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105447","الخفيف"],[2234,"","https://poetry.dctabudhabi.ae/diwan/poem/111067","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93869","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77087","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86482","الخفيف"],[4044,"","https://poetry.dctabudhabi.ae/diwan/poem/105883","الرجز"],[5122,"روضة التنهات","https://www.poetsgate.com/ViewPoem.aspx?id=31513",""],[6102,"سِباقُ الواوِيات ..","https://www.poetsgate.com/ViewPoem.aspx?id=184411",""]],"verses":[["وهْوَ غَمامٌ خَضِلٌ فالحيا","مُنْتَظَرٌ منهُ ومَرْقوبُ",0,"ب",1,0],["وَهو غَيثٌ لَنا في كُلِّ عامٍ","يَلوذُ بِهِ المُخَوَّلُ وَالعَديمُ",1,"م",1,0],["وَهوَ غَضُّ الآراءِ وَالحَزمِ خِرقٌ","ثُمَّ غَضُّ النَوالِ غَضُّ الشَبابِ",2,"ب",1,0],["وهو غيبٌ مُتحَبٌ دون مرآ","هُ اقتحام الردى ورنقُ الذعافِ",3,"ف",1,0],["وهو غيبٌ مُحبَّبٌ دون مرآهُ","اقتحام الردى ورنْقُ الذعافِ!",4,"ف",1,0],["وهو غيب مستحب دون مرآ","ه اقتحام الرّدى ورنق الذّعاف",5,"ف",1,0],["وَهوَ غَيثٌ إِذا اِستَلا","نَ وَلَيثٌ إِذ خَشُن",6,"ن",1,0],["وهو غريق في الضلال وفي ال","عناد للَه القوي المتين",7,"ن",1,0],["وَهوَ غَيرُ الَّذي رَأَيتُ وَعَن كُ","لِّ مَقالٍ يُقالُ فيهِ يَجَلُّ",8,"ل",1,0],["وَهوَغَنِيٌّ أَن يَشيمَ حَدَّهُ","فَيَهزِمُ الجَيشَ لَهُ اِسمٌ وَحدَهُ",9,"ه",1,0],["وهو غفور غافر غفار ما","يأتي به العبد إذا العبد عصى",10,"ا",1,0],["وهو غيب ولا تغيُّر للغي","ب سوى بالظهور في الإمكان",11,"ن",1,0],["وهو غيبٌ مقدسٌ","شربته الرجال خمر",12,"ر",1,0],["وهو غيث في مكانٍ","أغبرِ الجانبِ أمحل",13,"ل",1,0],["وهو غوث لخائف مستجير","وبه للهدى وللَه صلح",14,"ح",1,0],["وهو غوث الورى إذا عم كرب","جلل جل وقعه في العزاء",15,"ا",2,0],["وهو غيث الأنام عند احتباس","وابتسم الأيام وقت العبوس",16,"س",1,0],["وَهُوَ غَسل لِربة القَبرِ فَرضاً","خُذ جَواباً كَأَنَّهُ نُظم در",17,"ر",1,0],["وهو غصن النقا إذا ما تثني","وهلال السما إذا ما تبدى",18,"د",2,1],["وهوغريض العصر بل معبدُه","ومن له الباع الطويل مددُه",19,"ه",1,0],["وهو غايه قصيدي والله يبلغني الغايات","وهو يرفع معانيها عن الناقد ومنقوده",20,"د",2,0],["وَهْوَ غِرٌّ, مُسَطَّحُ الفِكرِ, قِشرٌ","فَوقَ رَكمٍ مِنَ الهَلاوِسِ ثاوِ",21,"ا",2,0]]}