{"poems":[[55,"ذكرت على بعدها من منالي","https://www.aldiwan.net/poem29904.html","المتقارب"],[55,"غالى بها الزائد حتى ابتاعها","https://www.aldiwan.net/poem30152.html","الرجز"],[55,"كأنك لم تقد بعويرضات","https://www.aldiwan.net/poem30163.html","الوافر"],[55,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[79,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[79,"أنور سناء لاح في مشرق الغرب","https://www.aldiwan.net/poem36773.html","الطويل"],[88,"لقد نصل الدجى فمتى تنام","https://www.aldiwan.net/poem10686.html","الوافر"],[37,"أهاجك ليلى إذ أجد رحيلها","https://www.aldiwan.net/poem39101.html","الطويل"],[53,"ألا قل لذي العطن الواسع","https://www.aldiwan.net/poem65403.html","المتقارب"],[87,"الحيوان خلق له عليك حق","https://www.aldiwan.net/poem7932.html","مجزوء الرجز"],[47,"أجرني من الواشي الذي جار واعتدى","https://www.aldiwan.net/poem63484.html","الطويل"],[68,"صروف الليالي لا يدوم لها عهد","https://www.aldiwan.net/poem40127.html","الطويل"],[50,"وندمان صدق بل يزيد فكاهة","https://www.aldiwan.net/poem64466.html","الطويل"],[52,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[79,"تألق نجديا فأذكرني نجدا","https://www.poetsgate.com/ViewPoem.aspx?id=33939",""],[173,"لذا اليوم أعملت القلاص العباهلا","https://www.aldiwan.net/poem1655.html",""],[173,"سما لك من أم العبيد خيال","https://www.aldiwan.net/poem1660.html",""],[173,"أبت نوب الأيام إلا تماديا","https://www.aldiwan.net/poem1691.html",""],[190,"وإني وإن أصبحت في دار غربة","https://www.aldiwan.net/poem43827.html","الطويل"],[240,"ليهنك أني في حبالك عاني","https://www.aldiwan.net/poem31742.html","الطويل"],[242,"أبلغهم مألكا عن قلب من ملكوا","https://www.aldiwan.net/poem18848.html","البسيط"],[280,"أمبتسم الأضحى ومطلع الفطر","https://www.aldiwan.net/poem25567.html","الطويل"],[302,"سقى صوب الحيا أرض الحجاز","https://www.aldiwan.net/poem33244.html","الوافر"],[310,"قبر به ضم الحفيد لجده","https://www.aldiwan.net/poem56556.html","الكامل"],[354,"حمول لأعباء الهوى غير طالع","https://www.aldiwan.net/poem15518.html","مجزوء الطويل"],[376,"فشرقت أبغي مطلع الشمس بالغنى","https://www.aldiwan.net/poem57457.html","الطويل"],[422,"سقاك الحيا من أربع وطلول","https://www.aldiwan.net/poem54049.html","الطويل"],[438,"نثرن عليه من صدف الخيام","https://www.aldiwan.net/poem12735.html","الوافر"],[447,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[447,"أرى بدرا فصار به هلالا","https://www.aldiwan.net/poem14472.html","الوافر"],[463,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[463,"أمنك خيال ضوع الركب موهنا","https://www.aldiwan.net/poem55831.html","الطويل"],[463,"أما والنقا لولا هوى ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[463,"دعوها ترد بعد خمس شروعا","https://www.aldiwan.net/poem56122.html","المتقارب"],[463,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[463,"سقى زمنا ببابل عقربي","https://www.aldiwan.net/poem56146.html","الوافر"],[463,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[463,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[463,"بكى النار سترا على الموقد","https://www.aldiwan.net/poem56223.html","المتقارب"],[463,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[463,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[463,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[469,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[469,"شهيدا غرامي ادمعي وسجومها","https://www.aldiwan.net/poem3217.html","عموديه"],[469,"اصمى بسهم المقلة النجلاء","https://www.aldiwan.net/poem3631.html","عموديه"],[558,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[591,"حموا بكعوب السمر بيض الكواعب","https://www.aldiwan.net/poem17441.html","الطويل"],[592,"لك الحمد اللهم يا ذا الحامد","https://www.aldiwan.net/poem11497.html","عموديه"],[718,"","https://poetry.dctabudhabi.ae/diwan/poem/124030","المتقارب"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56082","المتدارك"],[1252,"","https://poetry.dctabudhabi.ae/diwan/poem/199429","السريع"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49948","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49969","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122089","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111896","البسيط"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141311","الطويل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105423","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53042","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47117","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93678","الطويل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46742","الوافر"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84516","الطويل"],[2758,"","https://poetry.dctabudhabi.ae/diwan/poem/31508","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74147","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74238","الطويل"],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96108","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62873","المتقارب"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123920","الطويل"],[3532,"","https://poetry.dctabudhabi.ae/diwan/poem/146252","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126963","الوافر"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45237","الطويل"],[3763,"","https://poetry.dctabudhabi.ae/diwan/poem/124158","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40139","الطويل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75683","الكامل"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17788","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119650","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90797","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66124","الطويل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18806","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76758","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76706","البسيط"],[4935,"نه كوزل نظم جواهر وجمان","https://www.poetsgate.com/ViewPoem.aspx?id=129439",""],[592,"أرى طالع الأدبار والنحس قد بدا","https://www.poetsgate.com/ViewPoem.aspx?id=128843",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5843,"البحرين","https://www.poetsgate.com/ViewPoem.aspx?id=51289",""],[6142,"لمن أذيل عقيق الأدمع السجم","https://www.poetsgate.com/ViewPoem.aspx?id=155760",""],[463,"في الظباء الغادين أمسِ غزالُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60186&r=&rc=242",""]],"verses":[["حَمولٌ نَهوضٌ بِأَعبائِها","إِذا البُزلُ جَرجَرنَ تَحتَ الرِحالِ",0,"ل",1,0],["حَموا بِأَطرافِ القَنا سَوامَها","مِنَ العِدى وَآمَنوا رِتاعَها",1,"ع",3,0],["حَمَوكُم وَالأَسِنَّةُ في الهَوادي","وُقوعَ الطَيرِ تَبتَدِرُ اللِقاطا",2,"ط",2,0],["حَمَوكُم مَنابِتَ عُشبِ البِلادِ","تَحَلّوا مِنَ النورِ سَبطاً وَجَعدا",3,"د",2,0],["حمَوْا وهَمَوْا في حوْمَةِ البأسِ والنّدى","فكانُوا الغُيوثَ المُسْتَهِلّةَ والأُسْدا",4,"د",2,0],["حَمَوْا حَائِمَ التَّهْوِيمِ وِرْدَ جُفُونِهمْ","وَشَدُّوا وِثَاقَ السُّهْدِ فِي شَرَكِ الْهُدْبِ",5,"ب",1,0],["حَمَونا وِردَ ماءِ النيلِ عَذباً","وَقالوا إِنَّهُ مَوتٌ زُؤامُ",6,"م",1,0],["حَموا مَنزِلَ الأَملاكِ مِن مَرجِ راهِطٍ","وَرَملَةِ لُدٍّ أَن تُباحَ سُهولُها",7,"ل",3,0],["حمَوهُ المعاش وأسبابه","وهم خير مزدرع الزارع",8,"ع",1,0],["حَمولَةُ الأَثقالِ","وَمُرضِعُ الأَطفالِ",9,"ل",1,0],["حَمَوهُ سُهولَ الأَرضِ مِن كُلِّ جانِبٍ","فَظَلَّ شَريداً في الجِبالِ مُطَرَّدا",10,"د",2,0],["حَموا لِجُنودِ الجَأشِ حَولَ بُيوتِهِم","مِنَ المَجدِ مالَ يَحمِهِ الجَيشُ وَالجُندُ",11,"د",1,0],["حَمولٌ لِما حَمَّلتَهُ غَيرِ ضَيِّقٍ","ذِراعاً بِما ضاقَ الكِرامُ بِهِ مَسكا",12,"ك",2,0],["حَمولٌ عَلى المَكروهِ نَفساً كَريمَةً","إِذا هَمَّ لَم يَقعُد بِما كانَ أَوعَدا",13,"د",2,0],["حموا وهم في حومة البأس والندى","فكانوا الغيوث المستهلة والأسدا",14,"د",2,0],["حَمُولا لَما حَمَّلتَهُ ذا فَظاظَةٍ","عَلى مَن يُعادي أَلمَعِيّاً مُناضِلا",15,"ل",2,0],["حَمُولٌ لِأَعباءِ الأُمورِ وَإِنَّها","عَلى غَيرِهِ لَو رامَها لَثِقالُ",16,"ل",1,0],["حَمُولاً لِأَثقالِ العَشِيرَةِ رائِحاً","مَدى الدَهرِ في ما قَد عَناها وَغاديا",17,"ي",2,0],["حمول لعلات الرجال على الأذى","صبور وعند الصالحات شكور",18,"ر",1,0],["حَمولٌ لِأَعباءِ المُلِمّاتِ كاهِلي","وَمالي بِما حَمَّلتَنيهِ يَدانِ",19,"ن",1,0],["حَمَوْا حِمَى الدِّينِ بَيْدَ أَنَّهُمْ جَبُنُوا","عَنِ الْهَوَى وَبِمَيْدَانِ الْعُلاَ نَهُكُوا",20,"ك",3,0],["حَمَوْها كَما يَحْمي الهِزَبرُ عَرينَه","وأسيافُهم أمضَى من النابِ والظُّفرِ",21,"ر",1,0],["حَموا بالسُمر بيضَهم وَشاموا","عليها كلَّ ذي شُطَبٍ جُرازِ",22,"ز",1,0],["حمّودةٌ وافى ضَريحَ محمّدٍ","أَعني اِبن غشّام الشهيرَ بمجدهِ",23,"د",2,0],["حَمولٌ لِأَعباءِ الهَوى غَيرُ طالِعٍ","لَواشٍ وَلا عاصٍ لِما أَمَرَ الحُبُّ",24,"ب",1,1],["حَمولتُها ما بينَ مجدٍ مؤثَّلٍ","إلى خُلُقٍ رَحبٍ إلى نائلٍ غَمرِ",25,"ر",1,0],["حمول لأعباء الخطوب بأسرها","ولكنَّني للضيم غير حمول",26,"ل",1,0],["حمَوْا وسمَوْا فما حامٍ وسامٍ","سواهُم من بَني حامٍ وسامِ",27,"م",1,0],["حموها من ولاة النكر حتى","بها عاشوا وهم ماتوا حماها",28,"ا",3,0],["حموا عنكم بأسياف وسمر","وآراء تركن الشم آلا",29,"ل",2,0],["حموا خُطَطَ العلا لَسنا وضربا","بأقوال وأسيافٍ نَضاها",30,"ا",3,0],["حمولٌ لأعباء الرياسة ناهضٌ","بأثقالها إن قصّر الغمرُ أو ونى",31,"ن",2,0],["حَموا مجدهم بالسمهريّ تطاعناً","وبالكَلِم المربي على الطعن منطِقا",32,"ق",2,0],["حموا راحةَ النوم أجفانَهم","وشدّوا على الزفراتِ الضلوعا",33,"ع",2,0],["حموا بالندى أعراضَهم فوقاهُمُ","من العار ما لا يُتَّقَى بدروعِ",34,"ع",1,0],["حمَوا وجهي ولم أسأل سواهم","وأعطَوا كلَّ نافلةٍ وفرضِ",35,"ض",1,0],["حَمَوا شبولاً حِمى سَرحي وعشتُ إلى","أن ذبَّ عنِّيَ منهم ضيغمٌ ضاري",36,"ر",2,0],["حمولٌ قويمُ قناةِ الفَقارِ","إذا ركعتْ للخطوبِ الظهورُ",37,"ر",1,0],["حمولٌ على القلب وهو الضعيفُ","صبورٌ عن الماء وهو الصَّدِي",38,"د",2,0],["حَمَوا مالهم أن تُنتحَى بنقيصة","عقائلهُ والسارياتُ السرائحُ",39,"ح",1,0],["حَمولٌ لماء المزن تطفو لصوبه","فواغرُ أفواهِ الجِواءِ فتَطفَحُ",40,"ح",1,0],["حموْها وذابُّوا أن تُرامَ وما حَمَوا","قلوبَ الهوى من مقلتيها ولا ذَبُّوا",41,"ب",3,0],["حمولٌ لأعباءِ الملَّمات لو رمت","ثبيراً لأضحى وعنهُ وهو مفدوح",42,"ح",1,0],["حموه فمن خلق سواهم يبيحه","واعلوا مبانيه فمن ذا يرومها",43,"م",3,0],["حموا القدود بمثلها فالصعدةُ ال","سّمراء دونَ القامة السمراء",44,"ا",2,0],["حَمولاً لِعِبوِ الدَهرِ يَنهَضُ عَفوُهُ","بِهِ مُستَقِلّاً حينَ لا يُحمَلُ الثِقلُ",45,"ل",1,0],["حَموا بِكُعوبِ السّمْرِ بِيضَ الكَواعِبِ","وَصانُوا من الأَتْرابِ دُرَّ الترائبِ",46,"ب",1,1],["حموا دراهم من كل طاغ مخادع","وعن كل جبار عنيد معاند",47,"د",1,0],["حمولٌ بحال بها حاتم","على الضيف والجار يقرندح",48,"ح",1,0],["حمود الأحمد والناصي","ف الفرد الليث الكرارُ",49,"ر",1,0],["حموا حماهم وسما بينهم","في باذخاتِ الشرفِ العالي",50,"ل",2,0],["حموا وآوَوا رسول الله إِذ عهدت","لهم قريش بخذلان وإِبعادِ",51,"د",1,0],["حمَو شرفض العليا وسادو بني الدّنا","فما مسَهم ضيمٌ ولا فاتهم وتْرُ",52,"ر",1,0],["حَمُولٌ عَلَى الأَبْطَالِ فِي حَوْمَةِ الوَغَى","وَمَوْجُ المَنَايَا لِلسَّمَاءِ مُنَاغِي",53,"غ",2,0],["حموا حماهم فلو ارسلتُ من شغفي","معَ النسيم كتاب الشوق لا يصلُ",54,"ل",1,0],["حموا لغة الأعراب من كلّ لكنةٍ","وشادوا بها دور الهدى والمغانيا",55,"ي",2,0],["حموا عذب الفرات عليك حتى","ظمئت فليت ذاك العذب أجا",56,"ج",2,0],["حموا جارهم بأساً فلم يضح منشداً","أجارتنا إن الخطوب تنوب",57,"ب",1,0],["حمّودةُ الباشا وما أدراك ما","مَلِكٌ به نِعَمُ الإِلاهِ مُجَدَّدَة",58,"د",2,0],["حمّودةُ الباشا الذي أخبارُه","يُهْدِي إليك عطيرَها التّردادُ",58,"د",1,0],["حموا بِالظبا دين النَبي وَطاعنوا","ثَباتاً وَخاضَت خَيلَهُم بِالجَحافل",59,"ل",1,0],["حَمولاً لِلعَظائِمِ أَريحيّاً","إِذا الأَعباءُ أَثقلتِ الرِّجالا",60,"ل",2,0],["حموا عَن عيون المستهام رِقاده","فَهَل مانِع اللذات للنوم مانح",61,"ح",1,0],["حَمولَةِ أَخرى أَهلُها بَينَ مَهوَرٍ","إِلى مَحزِىءٍ مِن أَهلِ كَرمٍ وَسَنبَلِ",62,"ل",1,0],["حَموا بشفار البيض وَالسُمر حوزة","بمثلهم 