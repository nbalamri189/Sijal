{"poems":[[57,"نصيري الله منك إذا اعتديت","https://www.aldiwan.net/poem26445.html","الوافر"],[79,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[56,"أبا عبد الاله أصخ لقولي","https://www.aldiwan.net/poem27609.html","الوافر"],[29,"عوجي علينا واربعي ربة البغل","https://www.aldiwan.net/poem5972.html","الطويل"],[74,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[53,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[53,"فلو شهدت مقامي ثم أنديتي","https://www.aldiwan.net/poem61980.html","البسيط"],[53,"أيرضى الأمير أطال الإله","https://www.aldiwan.net/poem65407.html","المتقارب"],[53,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[47,"بعمرك تدري أي شأني أعجب","https://www.aldiwan.net/poem10663.html","الوافر"],[47,"سرى من خيال المالكية ما سرى","https://www.aldiwan.net/poem63587.html","البسيط"],[68,"ولي فرس ليست شكورا وإنما","https://www.aldiwan.net/poem38621.html","الطويل"],[46,"أصب بحميا كأسها مقتل العذل","https://www.aldiwan.net/poem29689.html","الطويل"],[46,"جوى ساور الأحشاء والقلب واغله","https://www.aldiwan.net/poem30306.html","الطويل"],[46,"أرامة كنت مألف كل ريم","https://www.aldiwan.net/poem30367.html","الوافر"],[33,"هيهات من أمة الوهاب منزلنا","https://www.aldiwan.net/poem41292.html","البسيط"],[22,"جزى الله خيرا والجزاء بكفه","https://www.aldiwan.net/poem21641.html","الطويل"],[69,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[50,"ودار يؤدب فيها البزاة","https://www.aldiwan.net/poem62610.html","المتقارب"],[50,"طرحتم من الترحال ذكرا فغمنا","https://www.aldiwan.net/poem66141.html","الطويل"],[7,"ألا أبلغا ذبيان عني رسالة","https://www.aldiwan.net/poem1992.html","الطويل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10683","الطويل"],[92,"رثاء شيخ الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=178927",""],[47,"بعُمرِكَ تَدرِي أيَّ شَانَيَّ أعْجَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31571",""],[33,"هَيْهَاتَ مِنْ أَمَة ِ الوَهّابِ مَنْزِلُنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19109&r=&rc=371",""],[119,"بعيشك هات اخبار المغاني","https://www.aldiwan.net/poem40469.html","عموديه"],[146,"تزاحم في صدرى القوافى ولا أرى","https://www.aldiwan.net/poem58355.html","الطويل"],[208,"أعاذل حسب المرء بالشيب عاذلا","https://www.aldiwan.net/poem53155.html","الطويل"],[214,"تضاهيك بالجيد الغزالة والصلف","https://www.aldiwan.net/poem13496.html","الطويل"],[237,"تبدت لنا حزوى فهاج جواها","https://www.aldiwan.net/poem14831.html","الطويل"],[266,"سلا عن ربي سلع فأعين عينها","https://www.aldiwan.net/poem38135.html","الطويل"],[280,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[370,"تقول حليلتي لما قلتني","https://www.aldiwan.net/poem44386.html","الوافر"],[422,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[445,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[463,"إذا رضيت رباك عن الربيع","https://www.aldiwan.net/poem56133.html","الوافر"],[466,"سقى الله المهيمن قبر ثاو","https://www.aldiwan.net/poem15417.html","الوافر"],[500,"كلام الشيخ مولانا كلام","https://www.aldiwan.net/poem10240.html","الوافر"],[520,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[534,"نداء لكل الناس فالأمر أعظم","https://www.aldiwan.net/poem37210.html","الطويل"],[543,"بكم شعري على غيري فخور","https://www.aldiwan.net/poem48179.html","عموديه"],[556,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83279","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122622","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122736","البسيط"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96997","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38984","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202100","الوافر"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35403","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61157","الطويل"],[196,"","https://poetry.dctabudhabi.ae/diwan/poem/45157","الطويل"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28388","الطويل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69200","الطويل"],[1290,"","https://poetry.dctabudhabi.ae/diwan/poem/116804","الوافر"],[1396,"","https://poetry.dctabudhabi.ae/diwan/poem/204678","الوافر"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90602","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79989","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127953","الطويل"],[1743,"","https://poetry.dctabudhabi.ae/diwan/poem/17658","الطويل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105412","الطويل"],[1816,"","https://poetry.dctabudhabi.ae/diwan/poem/198774","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118389","الوافر"],[2181,"","https://poetry.dctabudhabi.ae/diwan/poem/45551","الطويل"],[2246,"","https://poetry.dctabudhabi.ae/diwan/poem/116767","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77254","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105025","المتقارب"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93600","الطويل"],[2448,"","https://poetry.dctabudhabi.ae/diwan/poem/33005","الطويل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46744","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137440",""],[2858,"","https://poetry.dctabudhabi.ae/diwan/poem/22625","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84475","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103423","البسيط"],[3077,"","https://poetry.dctabudhabi.ae/diwan/poem/113638","المجتث"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65104","الطويل"],[3200,"","https://poetry.dctabudhabi.ae/diwan/poem/146080","الوافر"],[3299,"","https://poetry.dctabudhabi.ae/diwan/poem/80119","الطويل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99335","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74101","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62832","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62742","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86276","الطويل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2551","الطويل"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105264","الطويل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107296","الطويل"],[4048,"","https://poetry.dctabudhabi.ae/diwan/poem/110654","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95065","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138823",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141606","الهزج"],[5038,"إبن الفراتين","https://www.poetsgate.com/ViewPoem.aspx?id=188955",""],[5397,"تخادعك الدنيا وتبدي اغترارها","https://www.poetsgate.com/ViewPoem.aspx?id=157907",""],[5442,"تبدت وقد مدت عليها ستورها","https://www.poetsgate.com/ViewPoem.aspx?id=114743",""]],"verses":[["فَلَو شاءَ الَّذي بِكُمُ اِبتَلاني","لَعَجَّلَ راحَتي مِنكُم بِمَوتي",0,"ت",2,0],["فَلَوْ شَعَرَتْ نَفْسِي وَإِنِي لَشَاعِرٌ","بِهِ يَوْمَ أَرْدَانِي لَشَمَّرْتُ أَرْدَانِي",1,"ن",2,0],["فَلَو شاءَ الاِمامُ أَقامَ سوقاً","فَباعَهُمُ كَما بيعَ السَمادُ",2,"د",1,0],["فَلَو شاءَ قَومي كانَ حِلمِيَ فيهِمُ","وَكانَ عَلى جُهّالِ أَعدائِهِم جَهلي",3,"ل",2,0],["فلو شاء المشبه قال سحراً","بسرعتها لإخراج الضمير",4,"ر",1,0],["فلو شهد الهيجا بقلبِ أبيكُمُ","غداةَ التقى الجمعان والخيلُ تَمْعَجُ",5,"ج",1,0],["فلو شَهِدْت مُقامي ثم أنديتي","يوم الخصام وماءُ الموت يطَّردُ",6,"د",1,1],["فلو شاء صيقله رده","جديداً وولاه كفاً صناعا",7,"ع",2,0],["فلو شئتَ إشرافاً عليها وقدرةً","قبضتَ على أطرافها بالأناملِ",8,"ل",1,0],["فَلَو شارَكَت في مَكرُماتِكَ طَيٌّ","لَوُهِّمَ قَومٌ أَنَّني أَتَعَصَّبُ",9,"ب",1,0],["فَلَو شاءَ هَذا القَلبُ في أَوَلِ الصِبا","لَقَصَّرَ عَن بَعضِ الصِبا أَو لَأَقصَرا",10,"ر",2,0],["فَلَو شَرِبَت بِالفَلسِ مِن كَفِّ حاتَمٍ","لَأَصبَحَ نَدماناً عَلى تَلَفِ الفَلسِ",11,"س",1,0],["فَلَو شاءَ مَن لَو شاءَ لَم يَثنِ أَمرَهُ","لَصَيَّرَ فَضلَ المالِ عِندَ ذَوي الفَضلِ",12,"ل",1,0],["فَلَو شاءَ هَذا الدَهرُ أَقصَرَ شَرُّهُ","كَما قَصُرَت عَنّا لُهاهُ وَنائِلُه",13,"ل",2,0],["فَلَو شاهَدتَهُم وَالزائِريهِم","لَما مِزتَ البَعيدَ مِنَ الحَميمِ",14,"م",1,0],["فَلَو شَهِدتَ غَداةَ البَينِ عَبرَتَنا","لَأَن تُغَرِّدَ قُمرِيٌّ عَلى فَنَنِ",15,"ن",1,0],["فَلَو شاءَ إِذ جِئناهُ صَدَّ فَلَم يُلَم","وَصادَفَ مَنأىً في البِلادِ عَريضا",16,"ض",2,0],["فلو شاءَ سُلْطَانُ البَسِيطَةِ ساقَهُمْ","لِمِصْرٍ وتَحْتَ الفارِسَيْنِ بَعِيرُ",17,"ر",1,0],["فَلَو شَهِدَتهُ قُرَيشُ البِطاحِ","لَما مَحَشَت نارُكُم جِلدَه",18,"د",2,0],["فَلَو شاءَ رَبّي لَابتَلاهُم بِما بِهِ اب","تَلانا فَكانوا لا عَلَينا وَلا لَنا",19,"ن",2,0],["فَلَو شَهِدَت سَهمٌ وَأَبناءُ مالِكٍ","فَتُعذِرُني مِن مُرَّةَ المُتَناصِرَه",20,"ر",2,0],["فَلَو شاءَ رَبّي كُنتُ قَيسَ بنَ خالِدٍ","وَلَو شاءَ رَبّي كُنتُ عَمروَ بنَ مَرثَدِ",21,"د",1,0],["فَلَو شِئتِ لَم أَغضَب عَلَيكِ وَلَم يَزَل","لَكِ الدَهرَ مِنّي ما حَيِيتُ نَصيبُ",22,"ب",1,0],["فلو شاء ذاك القبر بين كم به","أماني نفوس قد طوتها ضمائره",23,"ر",2,0],["فلَوْ شارَكَتْ في مَكرُماتِكَ طَيِّءٌ","لَوُهّمَ قَوْمي أنّني أتَعَصّبُ",24,"ب",1,0],["فَلَوْ شَهِدْنَ، غَداة َ البَيْنِ، عَبْرَتَنَا","لأَنْ تَغَرَّدَ قُمْرِيٌّ عَلَى فَنَنِ",25,"ن",1,0],["فلو شاهدتها لذهلت وجدا","وما الخبر المترجم كالعيان",26,"ن",1,0],["فلو شَرُفوا بالعلم واطرحوا الندى","تأولتُ فيهم أننى أمدح الفضلا",27,"ل",2,0],["فلو شاجَرَته ألسنُ الناس كلهم","دِراكاً وعى فهماً وأفهَمَ قائلا",28,"ل",2,0],["فلو شام قبل النصف منك قلامة","ورام يحاكيها لولى وما انتصف",29,"ف",1,0],["فَلَو شَرِبَت ماءَ البِحار لَما رَوى","لَها ذَلِكَ الماءُ القُراحُ ظَماها",30,"ا",3,0],["فلو شاء من حذقٍ به وفراسةٍ","لحدث بالأشياء من قبل حينها",31,"ن",3,0],["فَلَوْ شاءَ ما التَفَّتْ عَلَيهِ مَيامِنٌ","ولَوْ شاءَ ما التَفَّت عَلَيهِ مَياسِرُ",32,"ر",1,0],["فلو شَمَّرنَ ثم عَدَونَ رَهواً","بكلِّ مُدَجَّجٍ لَعَرَفتِ لَوني",33,"ن",2,0],["فلو شاهدت في التقرير منه","بياناً خلته السحر الحلالا",34,"ل",2,0],["فلَوْ شَهدَ الأَملاكُ يَومَكَ فِيهِمُ","لألقى إِليكَ التَّاجَ كِسْرى وخَاقانُ",35,"ن",1,0],["فلو شهِدَ ابن أيّوبٍ مقامي","نجوت بمُصرَخٍ منه سميعِ",36,"ع",1,0],["فلو شاهدتُ مثواهُ لجادتْ","له عيني بصوْبٍ من دُموعي",37,"ع",2,0],["فلو شرب المصيخ إليه سمعاً","على ألفاظه سمّاً لساغه",38,"ه",1,0],["فلو شئتم بردتم حر حرقة","يهيجها تذكاركم ويثيرها",39,"ر",3,0],["فَلَوْ شاهَدَ الْمَهْديُّ أَوْلادَهُ كَما","نُشَاهِدُهُمْ أَضْحى لَهُ الدَّمْعُ يُسْجَمُ",40,"م",1,0],["فلو شاهدتَه يُثني عليه","بأوصافٍ هي المِسكُ العطيرُ",41,"ر",1,0],["فلو شئتَ لم يخدُشْنَ جلدي وطالما","وَقَيْتَ فلم تَخْلُصْ إليَّ سهامُ",42,"م",1,0],["فَلَو شاءَت الفُصحى وَفاءَ جِهادَهُ","لَنَصَتَ لَهُ فَوقَ السَماكينَ مِجثَما",43,"م",2,0],["فلو شَفَعتَ لأهل النّار ما خَلُدَت","بَعد الشَّفاعةِ أهلُ النّار في النّار",44,"ر",1,0],["فَلَو شَرَكناكَ في غَمِّ الحِمامِ فَقَد","أشرَكتَنا بُرهَةً في الغَمِّ والجَذَلِ",45,"ل",1,0],["فلو شاهد الطائي بعض هباته","لأبهره ثم انثنى وهو عاذله",46,"ل",2,0],["فَلَو شامَ سَحبان جواهرَ لَفظهِ","لَظَلَّ أَخَا عِيٍّ عَنِ النّظمِ وَالنّثرِ",47,"ر",1,0],["فلو شاء لم تأوي الطيع جنانه","ولو شاء لم تحو العصي جهنم",48,"م",1,0],["فلو شهروا حسامي شاهدوه","لأوداج العدى يفرى ويبرى",49,"ر",2,0],["فَلَو شارَفَت شَرقَ البِلادِ سُيوفُكُم","أَتاكَ اِستِلاباً تاجُ كِسرى وَخاقانِ",50,"ن",1,0],["فَلو شئتما علم الَّذي هُوَ عِنده","لَصحفتما أَمري لَكُم بَعدَ قَلبه",51,"ه",1,0],["فَلَو شاءَ رَبّي لَم أَكُن ذا حَفيظَة","طَلوباً لِغاياتِ المَكارِمِ وَالفَخرِ",52,"ر",1,0],["فَلَو شِئتَ لَم تسجن صَديقاً وَلَم تُهَب","إِلَيكَ بِصَقعاءِ المَناكِبِ بازِلِ",53,"ل",1,0],["فَلَو شئت أَن أَبكي دَماً لبكيته","عليك وَلَكِن ساحةُ الصَبر أَوسَع",54,"ع",1,0],["فلو شاورتني وقبلت رأيي","لسرت لهم بسيرةِ أوّليكا",55,"ك",2,0],["فلو شاء الإله وشاء موسى","لآنس جانبي فرجٌ بسعد",56,"د",1,0],["فلو شكرتُ أياديكم وأنعُمَكم","لما أحا