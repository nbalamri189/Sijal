{"poems":[[79,"إنما طاشور جعسوس","https://www.aldiwan.net/poem36401.html","مجزوء الرمل"],[50,"قل لذي الوجه الرقيق","https://www.aldiwan.net/poem64430.html","مجزوء الرمل"],[48,"الرمح أبلغ من قس تخاطبه","https://www.aldiwan.net/poem23163.html","البسيط"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144103","الرمل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137264",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130750","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121560","الكامل"],[4984,"عاشق أنت..","https://www.poetsgate.com/ViewPoem.aspx?id=175559",""]],"verses":[["إنّما طاشورُ جَعْسو","سٍ بيوْمٍ مُكْفَهِرْ",0,"ر",1,1],["إِنَّما طابَت لِذي فَت","كٍ تَرَدّى بِفُسوقِ",1,"ق",1,0],["إِن ماطَلَتكَ اللَيالي بِالَّذي وَعَدَت","فَالجودُ يُشعَرُ تَنغيصاً إِذا مُطِلا",2,"ل",2,0],["إن ماطلته بغُزْرِها","نهضت بهِ أعيارُها",3,"ر",3,0],["إنما طلقت كرمان بكم","أنكم لي عوض، ما أشرفه",4,"ف",2,0],["ان ماطلت جوليات فيه فانها","قد انجزتك اليوم فيه موعدا",5,"د",2,0],["انما طالب المعالي تراه","ان تصدى ألانَ فيها العضالا",6,"ل",2,0],["أن ما طلت فلربما","أنجزن بعد المطل وعدا",7,"د",2,0],["إنما طيفك لما عادني","في فراشي مس قلبي في الشغاف",8,"ف",1,0]]}