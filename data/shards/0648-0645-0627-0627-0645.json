{"poems":[[65,"أدار بأكناف الحمى جادها الحيا","https://www.aldiwan.net/poem45799.html","الطويل"],[65,"أثرها فلا ماء أصابت ولا عشبا","https://www.aldiwan.net/poem46174.html","الطويل"],[36,"وما سجعت ورقاء تهتف بالضحى","https://www.aldiwan.net/poem4864.html","الطويل"],[9,"أتصرم ريا أم تديم وصالها","https://www.aldiwan.net/poem21968.html","الطويل"],[37,"توهمت بالخيف رسما محيلا","https://www.aldiwan.net/poem39118.html","المتقارب"],[37,"غشيت لليلى بالبرود مساكنا","https://www.aldiwan.net/poem39153.html","الطويل"],[95,"لقد فدح الخطب في قاسم","https://www.aldiwan.net/poem11334.html","المتقارب"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[53,"قرأت على أهلي كتابك إذا أتى","https://www.aldiwan.net/poem62922.html","الطويل"],[53,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[53,"قالوا هجاك أبو المزاق قلت لهم","https://www.aldiwan.net/poem65433.html","البسيط"],[53,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[26,"ألا زعمت أسماء أن لا أحبها","https://www.aldiwan.net/poem24103.html","الطويل"],[31,"لقد جارى أبو ليلى بقحم","https://www.aldiwan.net/poem6166.html","الوافر"],[91,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[64,"إن العلى لم تزل تبغي الكفي لها","https://www.aldiwan.net/poem52323.html","البسيط"],[30,"يرد على خيشومها من ضجاجها","https://www.aldiwan.net/poem5111.html","الطويل"],[51,"ألا شافع عند الخليفة يشفع","https://www.aldiwan.net/poem64233.html","الكامل"],[107,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[107,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[69,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[77,"أمنك اجتياز البرق يلتاح في الدجى","https://www.aldiwan.net/poem69096.html","الطويل"],[48,"لقد ترفع فوق المشتري زحل","https://www.aldiwan.net/poem22192.html","البسيط"],[48,"إذا سعد البازي البعيد مغاره","https://www.aldiwan.net/poem22650.html","الطويل"],[48,"إن كان لم يترك قيس له وطرا","https://www.aldiwan.net/poem22666.html","البسيط"],[48,"أرى حسن البقاء لمن يرجي","https://www.aldiwan.net/poem22859.html","الوافر"],[48,"إذا سلقت عرس الفتى في كلامها","https://www.aldiwan.net/poem23033.html","الطويل"],[48,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[48,"تنازع في الدنيا سواك وما له","https://www.aldiwan.net/poem23569.html","الطويل"],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[96,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""],[37,"غشيتُ لليلى بالبَرودِ مساكناً","https://www.poetsgate.com/ViewPoem.aspx?id=22022",""],[90,"نهيتكِ عن هواكِ فما انتهيتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19573&r=&rc=76",""],[113,"يعد علي أنفاسي ذنوبا","https://www.aldiwan.net/poem16186.html","الوافر"],[136,"أعاذلتي ويبكما دعاني","https://www.aldiwan.net/poem54715.html","الوافر"],[173,"تخفي الصبابة والألحاظ تبديها","https://www.aldiwan.net/poem1690.html",""],[189,"هل المجد إلا دون ما أنت رافع","https://www.aldiwan.net/poem14573.html","الطويل"],[226,"أرت أم عباس أعجوبة","https://www.aldiwan.net/poem55282.html","المتقارب"],[234,"وما أم خشف ظل يوما وليلة","https://www.aldiwan.net/poem50724.html","الطويل"],[237,"نعمت بكم والدهر في غفلانه","https://www.aldiwan.net/poem14826.html","الطويل"],[237,"تبدت لنا حزوى فهاج جواها","https://www.aldiwan.net/poem14831.html","الطويل"],[280,"هو الفتح أدنى حوزه المغرب الأقصى","https://www.aldiwan.net/poem25493.html","الطويل"],[287,"لأجفانك المرضى الصحاح القواتل","https://www.aldiwan.net/poem32674.html","الطويل"],[290,"نصول اذا حان الدفاع ولا نرى","https://www.aldiwan.net/poem39402.html","الطويل"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[398,"إذا تراخى مديحي آل يسينا","https://www.aldiwan.net/poem53670.html","البسيط"],[408,"لا نال منك فؤادي ما يرجيه","https://www.aldiwan.net/poem46474.html","البسيط"],[408,"وإن التلقي بالقبول على الذي","https://www.aldiwan.net/poem46977.html","الطويل"],[425,"طربت وعناك الهوى والتطربُ","https://www.aldiwan.net/poem404.html",""],[447,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[471,"ما وجد علوي الهوى جن واجتوى","https://www.aldiwan.net/poem50418.html","الطويل"],[487,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[520,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[556,"حلفت بمعشر عسفوا المطايا","https://www.aldiwan.net/poem47223.html","الطويل"],[556,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[572,"أرتك يد الغيث آثارها","https://www.aldiwan.net/poem69674.html","المتقارب"],[572,"وجارية مثل شمس النهار","https://www.aldiwan.net/poem69698.html","المتقارب"],[592,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122794","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122746","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122599","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48801","المتقارب"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19951","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59766","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96568","الطويل"],[1195,"","https://poetry.dctabudhabi.ae/diwan/poem/100518","الطويل"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102239","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49985","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122028","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35735","الطويل"],[1610,"","https://poetry.dctabudhabi.ae/diwan/poem/115004","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108831","البسيط"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36180","الطويل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105419","الطويل"],[2100,"","https://poetry.dctabudhabi.ae/diwan/poem/34949","الوافر"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96024","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53236","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53140","الوافر"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121025","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60878","الطويل"],[2575,"","https://poetry.dctabudhabi.ae/diwan/poem/142561","السريع"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84904","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116498","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65945","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65939","الطويل"],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101884","الطويل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140086",""],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104683","الطويل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104685","السريع"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102366","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112584","الطويل"],[3280,"","https://poetry.dctabudhabi.ae/diwan/poem/203129","الوافر"],[3487,"","https://poetry.dctabudhabi.ae/diwan/poem/111546","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129339","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91526","السريع"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131009",""],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77007","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94815","الوافر"],[4532,"","https://poetry.dctabudhabi.ae/diwan/poem/45299","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72347","البسيط"],[4691,"مللتك شوقا أقام قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=81257",""],[4755,"وطن على السرير","https://www.poetsgate.com/ViewPoem.aspx?id=204338",""],[4830,"اِعجازُ الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=213690",""],[5055,"شوف ألماس","https://www.poetsgate.com/ViewPoem.aspx?id=103651",""],[5083,"بُنودُ الشَّام","https://www.poetsgate.com/ViewPoem.aspx?id=53878",""],[5213,"مدير المال يشكو الفقر فينا","https://www.poetsgate.com/ViewPoem.aspx?id=170561",""],[5781,"مدنٌ فارغةٌ من وطن","https://www.poetsgate.com/ViewPoem.aspx?id=198833",""],[5910,"دعاكَ السُّهدُ والأرقُ العتيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=206954",""],[5943,"ببيتِ اللهِ ياأختاهُ صلي(تحية للشاعرة مقبولة عبد ل","https://www.poetsgate.com/ViewPoem.aspx?id=61808",""],[6051,"وَمَا أَمِّي وأَمُّ الوَحْشِ لَمَّا","https://www.poetsgate.com/ViewPoem.aspx?id=85170",""]],"verses":[["وَما أَمُّ ذَيَّالِ السَّرابيلِ باسِلٍ","طَويلِ نِجادِ السَيفِ عَبلٍ مَناكِبُهْ",0,"ب",2,0],["وما أُمُّ ساجي الطّرْفِ مالَ بهِ الكَرى","على عَذَباتِ الجِزْعِ تَحْسَبُهُ قُلْبا",1,"ب",2,0],["وَما أَمطَرَت يَوماً بِنَجدٍ سَحابَةٌ","وَما اِخضَرَّ بِالأَجراعِ طَلحٌ وَتَنضُبُ",2,"ب",1,0],["وَما أُمُّ خِشفٍ جَأبَةُ القَرنِ فاقِدٌ","عَلى جانِبَي تَثليثَ تَبغي غَزالَها",3,"ل",3,0],["وَما أُمُّ خِشفٍ تَرعى بِهِ","أَراكاً عَميماً وَدَوحاً ظَليلا",4,"ل",2,0],["وَما أُمُّ خِشفٍ بِالعَلايَةِ شادِنٍ","أَطاعَ لها بَانٌ مِنَ المَردِ ناضِرُ",5,"ر",1,0],["وَمَا أُمُّ جَهْلٍ عَلَى بِرِّهَا","سِوَى آفَةِ الْحِكُمِ وَالْحَاكِمِ",6,"م",1,0],["وما أملي في المَذْحجِيَّ بِمُنْتَهٍ","ولكنَّه كالشيءِ بُلَّتْ بِهِ اليَدُ",7,"د",1,0],["وما أمْنُ مأمولٍ على نفسِ آمِلٍ","حوادثَ دهر غير مأمونةِ المكر",8,"ر",1,0],["وما امتنعوا من عدوٍّ بها","ولكنها بهمُ تمتنع",9,"ع",1,0],["وما امتهاني به شعري وخلقتُه","تهجوه عني وعن غيري بكل لُغه",10,"غ",2,0],["وما أمتنُّ شكري وامتداحي","وهل لك من حُلى مدحي عُطولُ",11,"ل",1,0],["وَما أُمُّ خِشفٍ بِالعَلايَةِ تَرتَعي","وَتَرمُقُ أَحياناً مُخاتَلَةَ الحَبلِ",12,"ل",1,0],["وَما أُمٌّ رَبَوتَ عَلى يَدَيها","بِطاهِرَةِ الثِيابِ وَلا حِصانِ",13,"ن",1,0],["وما أمة إلا تدين بصانعٍ","يُقر بذا من للشعوب قد استقرى",14,"ر",2,0],["وما امتشقتَ شَباةَ الطعنِ عن كَبدٍ","وعن فُؤادٍ وَتورٍ طالَ ما شِيكا",15,"ك",2,0],["وَما أَمَرَتني النَفسُ في رِحلَةٍ لَها","فَيَأمُرَني إِلّا إِلَيكَ ضَميرُها",16,"ر",3,0],["وَما آمِنٌ يُمسي وَيُصبِحُ عائِذاً","بِعَفوِ أَميرِ المُؤمِنينَ يُرَوَّعُ",17,"ع",1,0],["وما أمر الشعوب بمستقيم","إذا لم يستقم خلق وداب",18,"ب",1,0],["وما أمرُ اليهودِ إلى صلاحٍ","إذا الدّاعي إلى الهيجا أهابا",19,"ب",2,0],["وَمَا امْتَدَّ لِي طَرْفٌ ولا لانَ جَانِبٌ","لِغَيْرِكَ إلا ساءني اللِّينُ والمَدُّ",20,"د",1,0],["وما أمَّكَ العَافُونَ إلاّ تعرّفُوا","جنابَكَ مأنُوساً وظِلَّكَ سَجسَجا",21,"ج",2,0],["وَما أَمِنتُ زَماني في تَصَرُّفِهِ","أَن يَنقُلَ المُلكَ مِن مِصرٍ إِلى حَلَبِ",22,"ب",1,0],["وَما أَمَدٌ في الدَهرِ يُبلَغُ مَرَّةً","بِأَبعَدَ مِمّا نالَهُ المَرءُ بِالفِكرِ",23,"ر",1,0],["وَما أَميرُكَ يا اِبنَ المَجدِ مُنتَسِباً","لَكِنَّهُ اِبنُ تُرابٍ عَنهُ مُنفَطِرِ",24,"ر",1,0],["وَما أَمدي وَلا أَمَّلي بِسامٍ","إِلى نُجحٍ يَكونُ فَكَم أَعيشُ",25,"ش",1,0],["وَما أُمُّ غَيلانٍ مُحَرَّمَةَ الصَلى","وَلا أُمُّ لَيلى في مَحابِسِها طِلقا",26,"ق",2,0],["وَما أَمِنَ البازِيانِ القِصاصَ","وَأَن يُؤخَذا بِالَّذي يَبزُوانِ",27,"ن",1,0],["وَما أُمُّ صِلٍ أَو حَليلَةُ ضَيغَمٍ","بِأَظلَمَ مِن دُنياكِ فَاِعتَرِفيها",28,"ي",3,0],["وما امتاز من أضحى رفاتا مفتتا","مليك يحيا أو حمار يكدم",29,"م",1,0],["وما امتحنت خفاياه لأجلوها","ولا تمنّيت أن تجلى خفاياه",30,"ا",2,0],["وما أُمُّ خِشْفٍ بالعَلاَيَة ِ شادِنٍ","أصاعَ لها بانٌ من المردِ ناضرُ",31,"ر",1,0],["وما امارة بالسوء يوماً","سعت في المنكرات كما سعيت",32,"ت",1,0],["وَما أَملت في أَهلي نَصيراً","فَكَيفَ الآن أَطلبهُ غَريبا",33,"ب",2,0],["وَمَا أمَّت يَدُ الحَدَثَانِ إِلاَّ","ثَنى عَنِّى يَدَ الجَدَثَانِ ثَانِ",34,"ن",1,0],["وَما أُمِيتَت عَلى الأَيّامِ مَكرُمَةٌ","مِنَ المَكارِمِ إِلّا وَهوَ مُحيِيها",35,"ي",3,0],["وما أَمَّلوا إلا الذي أنت أَهلُه","ولا قَصَدوا إلا الذي أنت شائع",36,"ع",1,0],["وما أم عباس إلا عجوز","تقي بها نزعة للورع",37,"ع",1,0],["وما أُمُّ خِشْفٍ ظَلَّ يوماً وليلةً","ببَلْقَعةٍ بَيْداءَ ظَمْآنَ صادِيَا",38,"ي",2,1],["وَما أَمَّ فَرخٍ عايَنَتهُ وَصائِدٌ","يَحومُ عَلَيهِ بِاِقتِناصِ بُزاتِهِ",39,"ت",2,0],["وَما أُمُّ فَرخ بانَ عَنها قَرينها","تَقَلقَلَ مِن وَجدٍ عَلَيهِ حَشاها",40,"ا",3,0],["وَمَا أَمَّلَ العَافُونَ خَمْسَ بَنَانِهِ","فَلاقَتْ مَطَايَاهُم بِطَيِّ الفَلا خَمْصا",41,"ص",2,0],["وَما أَمَّلوا أَن يَلحَقوا بِبِلادِهِم","لِتَعصِمَهُم مِمّا رَأَوهُ المَعاقِلُ",42,"ل",1,0],["وما أملت مصر نجاة ولم تفز","بفاتح عقد الاحتلال الممدد",43,"د",1,0],["وَما اِمتِداحي أَبا الزَهراءِ مَن وَصَفَت","بِهِ الكَمالاتِ الآنِيَةِ وَصَفَت",44,"ت",1,0],["وَما أَملُّ مَقالاً في مَناقِبِهِم","أَسوقُهُ ما تَلا تِشرينُ تشرينا",45,"ن",2,0],["وما امْتَدحتك أَرْجو منك نيلَ غِنىً","لكِنْ قضاءٌ جرى في الكونِ ماضيهِ",46,"ي",2,0],["ومَا أمّةُ المختارِ من آلِ هاشمٍ","تَلَقَّى حَديثاً كاذُبَّاً بقبُولِ",47,"ل",1,0],["وَما أُمُّ خِشفٍ شادِنٍ بخَميلةٍ","من الدَهسِ منه هايلٌ وَمُكَثَّبُ",48,"ب",1,0],["وما أملت من هذي","ومن تلكم تلقيني",49,"ن",2,0],["وَما أُمَّ أَحوى الطُرَّتَينِ خِلالَها","أَراكَ بِذي الأَحناءِ أَجنى وَأَيفَعا",50,"ع",2,0],["وما امرأة قد أبطلت صوم يومها","بضحة فاعجب للعلوم المريتي",51,"ت",2,0],["وما أمنت ضلالة القصد إلا","ومن هادي الدعاة لهن هادي",52,"د",2,0],["وما أموالُهمْ إلّا لجودٍ","وإلّا للحَمالةٍ والغرامَهْ",53,"م",2,0],["وَما اِمتُقِعَتْ ألوانُهمْ في شديدةٍ","تُهابُ ولونُ اليوم لونٌ مولَّعُ",54,"ع",1,0],["وَمَا أَمْتَعَتْ جَارَهَا بَلْدَةٌ","كَمَا أَمْتَعَتْ حَلَبٌ جَارَهَا",55,"ر",3,0],["وما أمْهَلَتْهُ ولا نَهْنَهَتْهُ","من الظهرِ حتى انقضاء النهار",56,"ر",1,0],["وما أمر المعصوم من كان مخطئاً","من الصحب أن يقصضي الصيام فسائل",57,"ل",1,0],["وَما أمَلي بِهِنَّ بِأَن أُعَزّى","وَلَكِن كُنتُ آمَلُ أن أُهَنّا",58,"ن",2,0],["وَما أُمُّ فَردِ لَم تَزَل في صَلاتِها","تَضَرَّعُ في إنشائِهِ وَتُهينِمُ",59,"م",1,0],["وَما أمُّ خِشفٍ فَوَّقَته وأدبَرَت","تُورِّقُ في سِربِ البَوادي الأوابِد",60,"د",1,0],["وما أمعن الفاتحون الغزا","ة في الأرض يوماً كما أمعنا",61,"ن",2,0],["وَما أُمُّ أَحوى الجُدَّتَينِ خَلالَها","أَراكٌ مِنَ الأَعرافِ أَجنى وَأَينَعا",62,"ع",2,0],["وما أملى فيه مهاة ورملة","سوى سكن بالرمل أصبح نازلا",63,"ل",2,0],["وما أُمُّ مكحولِ المدامعِ طالعت","ركائبنا من منزل وهى عاطف",64,"ف",1,0],["وما أَمُّ أَحوى الجُدَّتينِ تعرَّضَت","أَمامَ المطايا فهى فى الشرقِ عاطِفُ",64,"ف",1,0],["وما أم رسلان ببطن مفازةٍ","نأى السرب عنها ساعة الركب طاويا",65,"ي",2,0],["وما أمرُنا إلا سواء وإنَّما","عرَفنا وكلٍّ منهُم ليسَ يعرِفُ",66,"ف",1,0],["وما أمنُها أو خوفها في حياتها","من الموت إلاَّ برُّها وفجورهُها",67,"ه",2,0],["وَمَا أَمْطَرَتْ فِيهِ السَّحَابُ وَإِنَّمَا","بَكَى أَدْمُعاً خَوْفَ النَّوى تَتَحَدَّرُ",68,"ر",1,0],["وَما اِمتَنَعَت مِن عَهدِهِ نَفسُ مُسلِمٍ","بِشَرقٍ وَلا غَربٍ أَتاها لَهُ ذِكرُ",69,"ر",1,0],["وما امتنع الاقوام عنا بنأيهم","سواء علينا النأيُ في الحرب والقرب",70,"ب",1,0],["وما أمرَّ نبال الغنج من دعج","وأطعن الذابل المحجوب في الحلل",71,"ل",1,0],["وما أموالنا فينا كنوزاً","إذا كنز الوفور الكانزونا",72,"ن",2,0],["وما أموالنا من بعد هذا","سوى بيض الصفائح ما عشينا",72,"ن",2,0],["وَما أمّ خشفٍ طولَ يَومٍ وَليلةٍ","بِبلقعةٍ بَيداء ظَمآن صادِيا",73,"ي",2,1],["وما أمرت أفلاكها باستدارةٍ","على الأفق إلا درن منك على قطب",74,"ب",1,0],["وَما أَموالُنا إِلّا عَوارٍ","سَيَأخُذُها المُعيرُ مِنَ المُعارِ",75,"ر",1,0],["وما أم عشر أهلك البين جمعها","عداداً يقفي البعض بعضاً ويعقب",76,"ب",1,0],["وما امت بما أثني عليك به","لولاك يا بحر ما كانت لآليها",77,"ي",3,0],["وما أمضى اعتزامك حين يغرى","بسلب للممالك وانتزاع",78,"ع",1,0],["وما أمكَنَت فيروز من عُمر الرِّضى","فهدَّت من الإسلامِ أرفع مَعلمِ",79,"م",1,0],["ومَا أمْدحُ الأجوادَ إلاّ لجودِهم","وما أخدمَ الساداتِ إلاّ لأِخدما",80,"م",2,0],["وما أمر الدهر إن مر بي","من غير أن يملا فراغ العمر",81,"ر",1,0],["وَما أَمرنا إِلا اِتِباع أَوامر","لِأَعظَم مَبعوث أَقام لَنا أَمرا",82,"ر",2,0],["وما امضت في الشجو ساجعة الحما","على فنن غض وظللت ترجع",83,"ع",1,0],["وما امتنعوا فيه من الدور أو رموا","إليك بسهم منه فاهدمه كالثرد",84,"د",1,0],["وما أمة تدعى لحق فأعرضت","بعصيانها إلا أبيدت بنقمة",85,"ه",1,0],["وما أم خشف كلما مر سانحا","ينص إليها جيده عند ذعره",86,"ر",2,0],["وما امر النوى مذاقاً","وما أشد القلا وأصعب",87,"ب",1,0],["وما أمه السؤال إلا وأوردوا","ركاماً هما صاروا له الكل وردا",88,"د",2,0],["وما أمالت يمنةً يسرةً","زهر الروابي نسمةٌ تشمل",89,"ل",1,0],["وما أمانة عتّاب بسالمةٍ","لا غمز فيها ولكن جمّة السّبل",90,"ل",1,0],["وما أمسكوا عن شهوة غير بطهنهم","فما عرفوا للدين أيّ وفاء",91,"ا",2,0],["وما أمٌّ يجامعها بنوها","جهاراً فهي حاملة عقيم",92,"م",1,1],["وما أم ساجي الطرف خفاة الجشا","أطاع لها الجوذان والسلم النظر",93,"ر",1,0],["وما آملىافى اليه وقد كبا","له أمل أورده اليأس خائبا",94,"ب",2,0],["وَما أَمرَّ البَينَ لا ذقتَه","لا سيّما إِن مرَّ حبٌّ ببال",95,"ل",1,0],["وما امتلكوها عنوة غير أنه","تملكها جوع ولم يأتها رفد",96,"د",1,0],["وَما أَمَلي إِلّا قَبول فَريدَتي","وَإِتحافُها بِالسَمعِ عَن قَصدِ رائِم",97,"م",1,0],["وما أمري بذا الإهداء إلّا","كمهدٍ من هبا يَمَّ الهباتِ",98,"ت",1,0],["وَما اُمُّكُم تَحتَ الخَوافِقِ وَالقَنا","بِثَكلى وَلا زَهراءَ مِن نِسوَةٍ زُهرِ",99,"ر",1,1],["وما امتطى لاحقا في أثره أحد","إلا وعن شأوه في عدوه ضلعا",100,"ع",2,0],["وما أمن القلبٌ إن أقبلتْ","علي السعادة شيئا قليلا",101,"ل",2,0],["وما أَمَرَّ العَيشَ، والبُعدَ عن","مَنَازِلٍ فِيهِنَّ قلبي حَبَا",102,"ب",2,0],["وما أُميلِحَ ظبيٍ في تغنُّجهِ","أذكى الفؤادَ هوىً واستمطَرَ الحَدَقا",103,"ق",2,0],["وما أمد اليد لو شفت الغرقّ","وما زرعت العشب في باب الكهوف",104,"ف",1,0],["وما أُمُّ الشَهيدِ نَعَتْ فتاها","مُزَغْردةً فهَلَّلتِ الخُلُودُ",105,"د",1,0],["وما أموالنا إلا لديه","وليس سواه فينا من يخون",106,"ن",1,0],["وما امْتَدَّتْ إِلى خَدِّي شِفاهٌ","فَسُكْناهُ الفُؤادُ وَفي الحَشايا",107,"ا",3,0],["وما آمالُ قلبِكَ إنْ تهاوتْ","بمرجُوٍّ لها البعثُ البهيُّ",108,"ي",1,0],["وما أمَّلتُهُ إلا وصالا","فلاذَ بخالقي يرجو اصطبارا",109,"ر",2,0],["وَمَا أَمِّي وأَمُّ الوَحْشِ لَمَّا","تَفَرَّعَ في مَفَارِقيَ المَشِيبُ؟",110,"ب",1,1]]}