{"poems":[[63,"أدار بأكناف الحمى جادها الحيا","https://www.aldiwan.net/poem45799.html","الطويل"],[63,"أثرها فلا ماء أصابت ولا عشبا","https://www.aldiwan.net/poem46174.html","الطويل"],[34,"وما سجعت ورقاء تهتف بالضحى","https://www.aldiwan.net/poem4864.html","الطويل"],[9,"أتصرم ريا أم تديم وصالها","https://www.aldiwan.net/poem21968.html","الطويل"],[35,"توهمت بالخيف رسما محيلا","https://www.aldiwan.net/poem39118.html","المتقارب"],[35,"غشيت لليلى بالبرود مساكنا","https://www.aldiwan.net/poem39153.html","الطويل"],[93,"لقد فدح الخطب في قاسم","https://www.aldiwan.net/poem11334.html","المتقارب"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"قرأت على أهلي كتابك إذا أتى","https://www.aldiwan.net/poem62922.html","الطويل"],[51,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[51,"قالوا هجاك أبو المزاق قلت لهم","https://www.aldiwan.net/poem65433.html","البسيط"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[26,"ألا زعمت أسماء أن لا أحبها","https://www.aldiwan.net/poem24103.html","الطويل"],[29,"لقد جارى أبو ليلى بقحم","https://www.aldiwan.net/poem6166.html","الوافر"],[89,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[62,"إن العلى لم تزل تبغي الكفي لها","https://www.aldiwan.net/poem52323.html","البسيط"],[28,"يرد على خيشومها من ضجاجها","https://www.aldiwan.net/poem5111.html","الطويل"],[49,"ألا شافع عند الخليفة يشفع","https://www.aldiwan.net/poem64233.html","الكامل"],[105,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[105,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[75,"أمنك اجتياز البرق يلتاح في الدجى","https://www.aldiwan.net/poem69096.html","الطويل"],[46,"لقد ترفع فوق المشتري زحل","https://www.aldiwan.net/poem22192.html","البسيط"],[46,"إذا سعد البازي البعيد مغاره","https://www.aldiwan.net/poem22650.html","الطويل"],[46,"إن كان لم يترك قيس له وطرا","https://www.aldiwan.net/poem22666.html","البسيط"],[46,"أرى حسن البقاء لمن يرجي","https://www.aldiwan.net/poem22859.html","الوافر"],[46,"إذا سلقت عرس الفتى في كلامها","https://www.aldiwan.net/poem23033.html","الطويل"],[46,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[46,"تنازع في الدنيا سواك وما له","https://www.aldiwan.net/poem23569.html","الطويل"],[94,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""],[35,"غشيتُ لليلى بالبَرودِ مساكناً","https://www.poetsgate.com/ViewPoem.aspx?id=22022",""],[88,"نهيتكِ عن هواكِ فما انتهيتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19573&r=&rc=76",""],[110,"يعد علي أنفاسي ذنوبا","https://www.aldiwan.net/poem16186.html","الوافر"],[133,"أعاذلتي ويبكما دعاني","https://www.aldiwan.net/poem54715.html","الوافر"],[170,"تخفي الصبابة والألحاظ تبديها","https://www.aldiwan.net/poem1690.html",""],[186,"هل المجد إلا دون ما أنت رافع","https://www.aldiwan.net/poem14573.html","الطويل"],[222,"أرت أم عباس أعجوبة","https://www.aldiwan.net/poem55282.html","المتقارب"],[230,"وما أم خشف ظل يوما وليلة","https://www.aldiwan.net/poem50724.html","الطويل"],[233,"نعمت بكم والدهر في غفلانه","https://www.aldiwan.net/poem14826.html","الطويل"],[233,"تبدت لنا حزوى فهاج جواها","https://www.aldiwan.net/poem14831.html","الطويل"],[276,"هو الفتح أدنى حوزه المغرب الأقصى","https://www.aldiwan.net/poem25493.html","الطويل"],[283,"لأجفانك المرضى الصحاح القواتل","https://www.aldiwan.net/poem32674.html","الطويل"],[286,"نصول اذا حان الدفاع ولا نرى","https://www.aldiwan.net/poem39402.html","الطويل"],[321,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[394,"إذا تراخى مديحي آل يسينا","https://www.aldiwan.net/poem53670.html","البسيط"],[403,"لا نال منك فؤادي ما يرجيه","https://www.aldiwan.net/poem46474.html","البسيط"],[403,"وإن التلقي بالقبول على الذي","https://www.aldiwan.net/poem46977.html","الطويل"],[420,"طربت وعناك الهوى والتطربُ","https://www.aldiwan.net/poem404.html",""],[442,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[467,"ما وجد علوي الهوى جن واجتوى","https://www.aldiwan.net/poem50418.html","الطويل"],[483,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[516,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[552,"حلفت بمعشر عسفوا المطايا","https://www.aldiwan.net/poem47223.html","الطويل"],[552,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[568,"أرتك يد الغيث آثارها","https://www.aldiwan.net/poem69674.html","المتقارب"],[568,"وجارية مثل شمس النهار","https://www.aldiwan.net/poem69698.html","المتقارب"],[588,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"]],"verses":[["وَما أَمُّ ذَيَّالِ السَّرابيلِ باسِلٍ","طَويلِ نِجادِ السَيفِ عَبلٍ مَناكِبُهْ",0,"ب",2,0],["وما أُمُّ ساجي الطّرْفِ مالَ بهِ الكَرى","على عَذَباتِ الجِزْعِ تَحْسَبُهُ قُلْبا",1,"ب",2,0],["وَما أَمطَرَت يَوماً بِنَجدٍ سَحابَةٌ","وَما اِخضَرَّ بِالأَجراعِ طَلحٌ وَتَنضُبُ",2,"ب",1,0],["وَما أُمُّ خِشفٍ جَأبَةُ القَرنِ فاقِدٌ","عَلى جانِبَي تَثليثَ تَبغي غَزالَها",3,"ل",3,0],["وَما أُمُّ خِشفٍ تَرعى بِهِ","أَراكاً عَميماً وَدَوحاً ظَليلا",4,"ل",2,0],["وَما أُمُّ خِشفٍ بِالعَلايَةِ شادِنٍ","أَطاعَ لها بَانٌ مِنَ المَردِ ناضِرُ",5,"ر",1,0],["وَمَا أُمُّ جَهْلٍ عَلَى بِرِّهَا","سِوَى آفَةِ الْحِكُمِ وَالْحَاكِمِ",6,"م",1,0],["وما أملي في المَذْحجِيَّ بِمُنْتَهٍ","ولكنَّه كالشيءِ بُلَّتْ بِهِ اليَدُ",7,"د",1,0],["وما أمْنُ مأمولٍ على نفسِ آمِلٍ","حوادثَ دهر غير مأمونةِ المكر",8,"ر",1,0],["وما امتنعوا من عدوٍّ بها","ولكنها بهمُ تمتنع",9,"ع",1,0],["وما امتهاني به شعري وخلقتُه","تهجوه عني وعن غيري بكل لُغه",10,"غ",2,0],["وما أمتنُّ شكري وامتداحي","وهل لك من حُلى مدحي عُطولُ",11,"ل",1,0],["وَما أُمُّ خِشفٍ بِالعَلايَةِ تَرتَعي","وَتَرمُقُ أَحياناً مُخاتَلَةَ الحَبلِ",12,"ل",1,0],["وَما أُمٌّ رَبَوتَ عَلى يَدَيها","بِطاهِرَةِ الثِيابِ وَلا حِصانِ",13,"ن",1,0],["وما أمة إلا تدين بصانعٍ","يُقر بذا من للشعوب قد استقرى",14,"ر",2,0],["وما امتشقتَ شَباةَ الطعنِ عن كَبدٍ","وعن فُؤادٍ وَتورٍ طالَ ما شِيكا",15,"ك",2,0],["وَما أَمَرَتني النَفسُ في رِحلَةٍ لَها","فَيَأمُرَني إِلّا إِلَيكَ ضَميرُها",16,"ر",3,0],["وَما آمِنٌ يُمسي وَيُصبِحُ عائِذاً","بِعَفوِ أَميرِ المُؤمِنينَ يُرَوَّعُ",17,"ع",1,0],["وما أمر الشعوب بمستقيم","إذا لم يستقم خلق وداب",18,"ب",1,0],["وما أمرُ اليهودِ إلى صلاحٍ","إذا الدّاعي إلى الهيجا أهابا",19,"ب",2,0],["وَمَا امْتَدَّ لِي طَرْفٌ ولا لانَ جَانِبٌ","لِغَيْرِكَ إلا ساءني اللِّينُ والمَدُّ",20,"د",1,0],["وما أمَّكَ العَافُونَ إلاّ تعرّفُوا","جنابَكَ مأنُوساً وظِلَّكَ سَجسَجا",21,"ج",2,0],["وَما أَمِنتُ زَماني في تَصَرُّفِهِ","أَن يَنقُلَ المُلكَ مِن مِصرٍ إِلى حَلَبِ",22,"ب",1,0],["وَما أَمَدٌ في الدَهرِ يُبلَغُ مَرَّةً","بِأَبعَدَ مِمّا نالَهُ المَرءُ بِالفِكرِ",23,"ر",1,0],["وَما أَميرُكَ يا اِبنَ المَجدِ مُنتَسِباً","لَكِنَّهُ اِبنُ تُرابٍ عَنهُ مُنفَطِرِ",24,"ر",1,0],["وَما أَمدي وَلا أَمَّلي بِسامٍ","إِلى نُجحٍ يَكونُ فَكَم أَعيشُ",25,"ش",1,0],["وَما أُمُّ غَيلانٍ مُحَرَّمَةَ الصَلى","وَلا أُمُّ لَيلى في مَحابِسِها طِلقا",26,"ق",2,0],["وَما أَمِنَ البازِيانِ القِصاصَ","وَأَن يُؤخَذا بِالَّذي يَبزُوانِ",27,"ن",1,0],["وَما أُمُّ صِلٍ أَو حَليلَةُ ضَيغَمٍ","بِأَظلَمَ مِن دُنياكِ فَاِعتَرِفيها",28,"ي",3,0],["وما امتحنت خفاياه لأجلوها","ولا تمنّيت أن تجلى خفاياه",29,"ا",2,0],["وما أُمُّ خِشْفٍ بالعَلاَيَة ِ شادِنٍ","أصاعَ لها بانٌ من المردِ ناضرُ",30,"ر",1,0],["وما امارة بالسوء يوماً","سعت في المنكرات كما سعيت",31,"ت",1,0],["وَما أَملت في أَهلي نَصيراً","فَكَيفَ الآن أَطلبهُ غَريبا",32,"ب",2,0],["وَمَا أمَّت يَدُ الحَدَثَانِ إِلاَّ","ثَنى عَنِّى يَدَ الجَدَثَانِ ثَانِ",33,"ن",1,0],["وَما أُمِيتَت عَلى الأَيّامِ مَكرُمَةٌ","مِنَ المَكارِمِ إِلّا وَهوَ مُحيِيها",34,"ي",3,0],["وما أَمَّلوا إلا الذي أنت أَهلُه","ولا قَصَدوا إلا الذي أنت شائع",35,"ع",1,0],["وما أم عباس إلا عجوز","تقي بها نزعة للورع",36,"ع",1,0],["وما أُمُّ خِشْفٍ ظَلَّ يوماً وليلةً","ببَلْقَعةٍ بَيْداءَ ظَمْآنَ صادِيَا",37,"ي",2,1],["وَما أَمَّ فَرخٍ عايَنَتهُ وَصائِدٌ","يَحومُ عَلَيهِ بِاِقتِناصِ بُزاتِهِ",38,"ت",2,0],["وَما أُمُّ فَرخ بانَ عَنها قَرينها","تَقَلقَلَ مِن وَجدٍ عَلَيهِ حَشاها",39,"ا",3,0],["وَمَا أَمَّلَ العَافُونَ خَمْسَ بَنَانِهِ","فَلاقَتْ مَطَايَاهُم بِطَيِّ الفَلا خَمْصا",40,"ص",2,0],["وَما أَمَّلوا أَن يَلحَقوا بِبِلادِهِم","لِتَعصِمَهُم مِمّا رَأَوهُ المَعاقِلُ",41,"ل",1,0],["وما أملت مصر نجاة ولم تفز","بفاتح عقد الاحتلال الممدد",42,"د",1,0],["وَما اِمتِداحي أَبا الزَهراءِ مَن وَصَفَت","بِهِ الكَمالاتِ الآنِيَةِ وَصَفَت",43,"ت",1,0],["وَما أَملُّ مَقالاً في مَناقِبِهِم","أَسوقُهُ ما تَلا تِشرينُ تشرينا",44,"ن",2,0],["وما امْتَدحتك أَرْجو منك نيلَ غِنىً","لكِنْ قضاءٌ جرى في الكونِ ماضيهِ",45,"ي",2,0],["ومَا أمّةُ المختارِ من آلِ هاشمٍ","تَلَقَّى حَديثاً كاذُبَّاً بقبُولِ",46,"ل",1,0],["وَما أُمُّ خِشفٍ شادِنٍ بخَميلةٍ","من الدَهسِ منه هايلٌ وَمُكَثَّبُ",47,"ب",1,0],["وما أملت من هذي","ومن تلكم تلقيني",48,"ن",2,0],["وَما أُمَّ أَحوى الطُرَّتَينِ خِلالَها","أَراكَ بِذي الأَحناءِ أَجنى وَأَيفَعا",49,"ع",2,0],["وما امرأة قد أبطلت صوم يومها","بضحة فاعجب للعلوم المريتي",50,"ت",2,0],["وما أمنت ضلالة القصد إلا","ومن هادي الدعاة لهن هادي",51,"د",2,0],["وما أموالُهمْ إلّا لجودٍ","وإلّا للحَمالةٍ والغرامَهْ",52,"م",2,0],["وَما اِمتُقِعَتْ ألوانُهمْ في شديدةٍ","تُهابُ ولونُ اليوم لونٌ مولَّعُ",53,"ع",1,0],["وَمَا أَمْتَعَتْ جَارَهَا بَلْدَةٌ","كَمَا أَمْتَعَتْ حَلَبٌ جَارَهَا",54,"ر",3,0],["وما أمْهَلَتْهُ ولا نَهْنَهَتْهُ","من الظهرِ حتى انقضاء النهار",55,"ر",1,0],["وما أمر المعصوم من كان مخطئاً","من الصحب أن يقصضي الصيام فسائل",56,"ل",1,0]]}