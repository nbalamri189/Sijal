{"poems":[[65,"أدار بأكناف الحمى جادها الحيا","https://www.aldiwan.net/poem45799.html","الطويل"],[65,"أثرها فلا ماء أصابت ولا عشبا","https://www.aldiwan.net/poem46174.html","الطويل"],[36,"وما سجعت ورقاء تهتف بالضحى","https://www.aldiwan.net/poem4864.html","الطويل"],[9,"أتصرم ريا أم تديم وصالها","https://www.aldiwan.net/poem21968.html","الطويل"],[37,"توهمت بالخيف رسما محيلا","https://www.aldiwan.net/poem39118.html","المتقارب"],[37,"غشيت لليلى بالبرود مساكنا","https://www.aldiwan.net/poem39153.html","الطويل"],[95,"لقد فدح الخطب في قاسم","https://www.aldiwan.net/poem11334.html","المتقارب"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[53,"قرأت على أهلي كتابك إذا أتى","https://www.aldiwan.net/poem62922.html","الطويل"],[53,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[53,"قالوا هجاك أبو المزاق قلت لهم","https://www.aldiwan.net/poem65433.html","البسيط"],[53,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[26,"ألا زعمت أسماء أن لا أحبها","https://www.aldiwan.net/poem24103.html","الطويل"],[31,"لقد جارى أبو ليلى بقحم","https://www.aldiwan.net/poem6166.html","الوافر"],[91,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[64,"إن العلى لم تزل تبغي الكفي لها","https://www.aldiwan.net/poem52323.html","البسيط"],[30,"يرد على خيشومها من ضجاجها","https://www.aldiwan.net/poem5111.html","الطويل"],[51,"ألا شافع عند الخليفة يشفع","https://www.aldiwan.net/poem64233.html","الكامل"],[107,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[107,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[69,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[77,"أمنك اجتياز البرق يلتاح في الدجى","https://www.aldiwan.net/poem69096.html","الطويل"],[48,"لقد ترفع فوق المشتري زحل","https://www.aldiwan.net/poem22192.html","البسيط"],[48,"إذا سعد البازي البعيد مغاره","https://www.aldiwan.net/poem22650.html","الطويل"],[48,"إن كان لم يترك قيس له وطرا","https://www.aldiwan.net/poem22666.html","البسيط"],[48,"أرى حسن البقاء لمن يرجي","https://www.aldiwan.net/poem22859.html","الوافر"],[48,"إذا سلقت عرس الفتى في كلامها","https://www.aldiwan.net/poem23033.html","الطويل"],[48,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[48,"تنازع في الدنيا سواك وما له","https://www.aldiwan.net/poem23569.html","الطويل"],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[96,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""],[37,"غشيتُ لليلى بالبَرودِ مساكناً","https://www.poetsgate.com/ViewPoem.aspx?id=22022",""],[90,"نهيتكِ عن هواكِ فما انتهيتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19573&r=&rc=76",""],[113,"يعد علي أنفاسي ذنوبا","https://www.aldiwan.net/poem16186.html","الوافر"],[136,"أعاذلتي ويبكما دعاني","https://www.aldiwan.net/poem54715.html","الوافر"],[173,"تخفي الصبابة والألحاظ تبديها","https://www.aldiwan.net/poem1690.html",""],[189,"هل المجد إلا دون ما أنت رافع","https://www.aldiwan.net/poem14573.html","الطويل"],[225,"أرت أم عباس أعجوبة","https://www.aldiwan.net/poem55282.html","المتقارب"],[233,"وما أم خشف ظل يوما وليلة","https://www.aldiwan.net/poem50724.html","الطويل"],[236,"نعمت بكم والدهر في غفلانه","https://www.aldiwan.net/poem14826.html","الطويل"],[236,"تبدت لنا حزوى فهاج جواها","https://www.aldiwan.net/poem14831.html","الطويل"],[279,"هو الفتح أدنى حوزه المغرب الأقصى","https://www.aldiwan.net/poem25493.html","الطويل"],[286,"لأجفانك المرضى الصحاح القواتل","https://www.aldiwan.net/poem32674.html","الطويل"],[289,"نصول اذا حان الدفاع ولا نرى","https://www.aldiwan.net/poem39402.html","الطويل"],[324,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[397,"إذا تراخى مديحي آل يسينا","https://www.aldiwan.net/poem53670.html","البسيط"],[406,"لا نال منك فؤادي ما يرجيه","https://www.aldiwan.net/poem46474.html","البسيط"],[406,"وإن التلقي بالقبول على الذي","https://www.aldiwan.net/poem46977.html","الطويل"],[423,"طربت وعناك الهوى والتطربُ","https://www.aldiwan.net/poem404.html",""],[445,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[469,"ما وجد علوي الهوى جن واجتوى","https://www.aldiwan.net/poem50418.html","الطويل"],[485,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[518,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[554,"حلفت بمعشر عسفوا المطايا","https://www.aldiwan.net/poem47223.html","الطويل"],[554,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[570,"أرتك يد الغيث آثارها","https://www.aldiwan.net/poem69674.html","المتقارب"],[570,"وجارية مثل شمس النهار","https://www.aldiwan.net/poem69698.html","المتقارب"],[590,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"]],"verses":[["وَما أَمُّ ذَيَّالِ السَّرابيلِ باسِلٍ","طَويلِ نِجادِ السَيفِ عَبلٍ مَناكِبُهْ",0,"ب",2,0],["وما أُمُّ ساجي الطّرْفِ مالَ بهِ الكَرى","على عَذَباتِ الجِزْعِ تَحْسَبُهُ قُلْبا",1,"ب",2,0],["وَما أَمطَرَت يَوماً بِنَجدٍ سَحابَةٌ","وَما اِخضَرَّ بِالأَجراعِ طَلحٌ وَتَنضُبُ",2,"ب",1,0],["وَما أُمُّ خِشفٍ جَأبَةُ القَرنِ فاقِدٌ","عَلى جانِبَي تَثليثَ تَبغي غَزالَها",3,"ل",3,0],["وَما أُمُّ خِشفٍ تَرعى بِهِ","أَراكاً عَميماً وَدَوحاً ظَليلا",4,"ل",2,0],["وَما أُمُّ خِشفٍ بِالعَلايَةِ شادِنٍ","أَطاعَ لها بَانٌ مِنَ المَردِ ناضِرُ",5,"ر",1,0],["وَمَا أُمُّ جَهْلٍ عَلَى بِرِّهَا","سِوَى آفَةِ الْحِكُمِ وَالْحَاكِمِ",6,"م",1,0],["وما أملي في المَذْحجِيَّ بِمُنْتَهٍ","ولكنَّه كالشيءِ بُلَّتْ بِهِ اليَدُ",7,"د",1,0],["وما أمْنُ مأمولٍ على نفسِ آمِلٍ","حوادثَ دهر غير مأمونةِ المكر",8,"ر",1,0],["وما امتنعوا من عدوٍّ بها","ولكنها بهمُ تمتنع",9,"ع",1,0],["وما امتهاني به شعري وخلقتُه","تهجوه عني وعن غيري بكل لُغه",10,"غ",2,0],["وما أمتنُّ شكري وامتداحي","وهل لك من حُلى مدحي عُطولُ",11,"ل",1,0],["وَما أُمُّ خِشفٍ بِالعَلايَةِ تَرتَعي","وَتَرمُقُ أَحياناً مُخاتَلَةَ الحَبلِ",12,"ل",1,0],["وَما أُمٌّ رَبَوتَ عَلى يَدَيها","بِطاهِرَةِ الثِيابِ وَلا حِصانِ",13,"ن",1,0],["وما أمة إلا تدين بصانعٍ","يُقر بذا من للشعوب قد استقرى",14,"ر",2,0],["وما امتشقتَ شَباةَ الطعنِ عن كَبدٍ","وعن فُؤادٍ وَتورٍ طالَ ما شِيكا",15,"ك",2,0],["وَما أَمَرَتني النَفسُ في رِحلَةٍ لَها","فَيَأمُرَني إِلّا إِلَيكَ ضَميرُها",16,"ر",3,0],["وَما آمِنٌ يُمسي وَيُصبِحُ عائِذاً","بِعَفوِ أَميرِ المُؤمِنينَ يُرَوَّعُ",17,"ع",1,0],["وما أمر الشعوب بمستقيم","إذا لم يستقم خلق وداب",18,"ب",1,0],["وما أمرُ اليهودِ إلى صلاحٍ","إذا الدّاعي إلى الهيجا أهابا",19,"ب",2,0],["وَمَا امْتَدَّ لِي طَرْفٌ ولا لانَ جَانِبٌ","لِغَيْرِكَ إلا ساءني اللِّينُ والمَدُّ",20,"د",1,0],["وما أمَّكَ العَافُونَ إلاّ تعرّفُوا","جنابَكَ مأنُوساً وظِلَّكَ سَجسَجا",21,"ج",2,0],["وَما أَمِنتُ زَماني في تَصَرُّفِهِ","أَن يَنقُلَ المُلكَ مِن مِصرٍ إِلى حَلَبِ",22,"ب",1,0],["وَما أَمَدٌ في الدَهرِ يُبلَغُ مَرَّةً","بِأَبعَدَ مِمّا نالَهُ المَرءُ بِالفِكرِ",23,"ر",1,0],["وَما أَميرُكَ يا اِبنَ المَجدِ مُنتَسِباً","لَكِنَّهُ اِبنُ تُرابٍ عَنهُ مُنفَطِرِ",24,"ر",1,0],["وَما أَمدي وَلا أَمَّلي بِسامٍ","إِلى نُجحٍ يَكونُ فَكَم أَعيشُ",25,"ش",1,0],["وَما أُمُّ غَيلانٍ مُحَرَّمَةَ الصَلى","وَلا أُمُّ لَيلى في مَحابِسِها طِلقا",26,"ق",2,0],["وَما أَمِنَ البازِيانِ القِصاصَ","وَأَن يُؤخَذا بِالَّذي يَبزُوانِ",27,"ن",1,0],["وَما أُمُّ صِلٍ أَو حَليلَةُ ضَيغَمٍ","بِأَظلَمَ مِن دُنياكِ فَاِعتَرِفيها",28,"ي",3,0],["وما امتاز من أضحى رفاتا مفتتا","مليك يحيا أو حمار يكدم",29,"م",1,0],["وما امتحنت خفاياه لأجلوها","ولا تمنّيت أن تجلى خفاياه",30,"ا",2,0],["وما أُمُّ خِشْفٍ بالعَلاَيَة ِ شادِنٍ","أصاعَ لها بانٌ من المردِ ناضرُ",31,"ر",1,0],["وما امارة بالسوء يوماً","سعت في المنكرات كما سعيت",32,"ت",1,0],["وَما أَملت في أَهلي نَصيراً","فَكَيفَ الآن أَطلبهُ غَريبا",33,"ب",2,0],["وَمَا أمَّت يَدُ الحَدَثَانِ إِلاَّ","ثَنى عَنِّى يَدَ الجَدَثَانِ ثَانِ",34,"ن",1,0],["وَما أُمِيتَت عَلى الأَيّامِ مَكرُمَةٌ","مِنَ المَكارِمِ إِلّا وَهوَ مُحيِيها",35,"ي",3,0],["وما أَمَّلوا إلا الذي أنت أَهلُه","ولا قَصَدوا إلا الذي أنت شائع",36,"ع",1,0],["وما أم عباس إلا عجوز","تقي بها نزعة للورع",37,"ع",1,0],["وما أُمُّ خِشْفٍ ظَلَّ يوماً وليلةً","ببَلْقَعةٍ بَيْداءَ ظَمْآنَ صادِيَا",38,"ي",2,1],["وَما أَمَّ فَرخٍ عايَنَتهُ وَصائِدٌ","يَحومُ عَلَيهِ بِاِقتِناصِ بُزاتِهِ",39,"ت",2,0],["وَما أُمُّ فَرخ بانَ عَنها قَرينها","تَقَلقَلَ مِن وَجدٍ عَلَيهِ حَشاها",40,"ا",3,0],["وَمَا أَمَّلَ العَافُونَ خَمْسَ بَنَانِهِ","فَلاقَتْ مَطَايَاهُم بِطَيِّ الفَلا خَمْصا",41,"ص",2,0],["وَما أَمَّلوا أَن يَلحَقوا بِبِلادِهِم","لِتَعصِمَهُم مِمّا رَأَوهُ المَعاقِلُ",42,"ل",1,0],["وما أملت مصر نجاة ولم تفز","بفاتح عقد الاحتلال الممدد",43,"د",1,0],["وَما اِمتِداحي أَبا الزَهراءِ مَن وَصَفَت","بِهِ الكَمالاتِ الآنِيَةِ وَصَفَت",44,"ت",1,0],["وَما أَملُّ مَقالاً في مَناقِبِهِم","أَسوقُهُ ما تَلا تِشرينُ تشرينا",45,"ن",2,0],["وما امْتَدحتك أَرْجو منك نيلَ غِنىً","لكِنْ قضاءٌ جرى في الكونِ ماضيهِ",46,"ي",2,0],["ومَا أمّةُ المختارِ من آلِ هاشمٍ","تَلَقَّى حَديثاً كاذُبَّاً بقبُولِ",47,"ل",1,0],["وَما أُمُّ خِشفٍ شادِنٍ بخَميلةٍ","من الدَهسِ منه هايلٌ وَمُكَثَّبُ",48,"ب",1,0],["وما أملت من هذي","ومن تلكم تلقيني",49,"ن",2,0],["وَما أُمَّ أَحوى الطُرَّتَينِ خِلالَها","أَراكَ بِذي الأَحناءِ أَجنى وَأَيفَعا",50,"ع",2,0],["وما امرأة قد أبطلت صوم يومها","بضحة فاعجب للعلوم المريتي",51,"ت",2,0],["وما أمنت ضلالة القصد إلا","ومن هادي الدعاة لهن هادي",52,"د",2,0],["وما أموالُهمْ إلّا لجودٍ","وإلّا للحَمالةٍ والغرامَهْ",53,"م",2,0],["وَما اِمتُقِعَتْ ألوانُهمْ في شديدةٍ","تُهابُ ولونُ اليوم لونٌ مولَّعُ",54,"ع",1,0],["وَمَا أَمْتَعَتْ جَارَهَا بَلْدَةٌ","كَمَا أَمْتَعَتْ حَلَبٌ جَارَهَا",55,"ر",3,0],["وما أمْهَلَتْهُ ولا نَهْنَهَتْهُ","من الظهرِ حتى انقضاء النهار",56,"ر",1,0],["وما أمر المعصوم من كان مخطئاً","من الصحب أن يقصضي الصيام فسائل",57,"ل",1,0]]}