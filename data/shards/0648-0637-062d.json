{"poems":[[107,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[276,"سمعت سويجع الاثلاث غنى","https://www.aldiwan.net/poem52085.html","الوافر"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[3447,"","https://poetry.dctabudhabi.ae/diwan/poem/32747","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62923","الرمل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2565","الوافر"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67567","المتقارب"],[3271,"دمعة في قلب الليل","https://www.poetsgate.com/ViewPoem.aspx?id=102704",""]],"verses":[["وطحا بجيفرَ جَهلُهُ وعِنادُه","فأبَى على عمروٍ وأعرضَ يأنَفُ",0,"ف",1,0],["وَطحا مكة ذهبا أَباها","ببيد الملك وَاللذات تفنى",1,"ن",2,0],["وَطَحطَحَ الأُحبُوشُ قَسراً تركَهُ","وَاحتَثَّ نَحوَ الغَربِ قَصراً بَركَهُ",2,"ه",1,0],["وَطَحّانُ طَيٍّ تَوَلّى الجُسورَ","وَسَقىَ الفُراتِ وَزُرفامِيَه",3,"ي",2,0],["وطَحُونٌ فيلقٌ ملمومةٌ","كأَتانِ الضَّحلِ ما فيها عَوَارُ",4,"ر",1,0],["وَطَحطَحنا شَنوءَةَ كُلَّ أَوبٍ","وَلاقَت حِميَرٌ مِنّا غَراما",5,"م",2,0],["وطحّان طيّ تولّى الجسور","وسقي الفرات ووزر فانيه",6,"ي",2,0],["وطحت بالشّراعِ هبّاتُ ريحٍ","عاصفاتٌ من زعزعٍ نكباءِ",7,"ا",2,0]]}