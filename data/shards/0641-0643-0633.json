{"poems":[[55,"يا حبذا فوق الكثيب الأعفر","https://www.aldiwan.net/poem30452.html","الرجز"],[85,"عزاء فإن الشجو قد كان يسرف","https://www.aldiwan.net/poem54270.html","الطويل"],[90,"سعروها في البحر حربا ضروسا","https://www.aldiwan.net/poem44472.html","الخفيف"],[53,"إن امرأ رفض المكاسب واغتدى","https://www.aldiwan.net/poem66367.html","الكامل"],[63,"إن عاده بعد السلو غرامه","https://www.aldiwan.net/poem51427.html","الكامل"],[68,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[83,"أهدى التلاقي صبح وجهك مسفرا","https://www.aldiwan.net/poem61522.html","الكامل"],[48,"للخير منزلتان عند معاشر","https://www.aldiwan.net/poem23251.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85417","الخفيف"],[92,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[154,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[189,"عبقت بطيب ثنائك الأقطار","https://www.aldiwan.net/poem14538.html","الكامل"],[199,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[226,"الشمس خلف الجبال","https://www.aldiwan.net/poem55254.html","المجتث"],[227,"روح الروح واسقني بمدام","https://www.aldiwan.net/poem55471.html","الخفيف"],[236,"سبح لربك في الظلام الداجي","https://www.aldiwan.net/poem44595.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[287,"لا والمطايا يعتسفن البيدا","https://www.aldiwan.net/poem32795.html","الكامل"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[369,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[370,"لو كان عباس هنالك حاضرا","https://www.aldiwan.net/poem44507.html","الكامل"],[382,"أورت بي الشهوات نار زنادها","https://www.aldiwan.net/poem59396.html","الكامل"],[409,"قد عجزنا عن شكرنا لامتنانك","https://www.aldiwan.net/poem33402.html","الخفيف"],[422,"هنيت بالفرمان والنيشان","https://www.aldiwan.net/poem54081.html","الكامل"],[445,"كسيت بدولتك اليالي نورا","https://www.aldiwan.net/poem34851.html","الكامل"],[445,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[447,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[457,"خذ بنا في محاسن الأوصاف","https://www.aldiwan.net/poem13842.html","الخفيف"],[580,"نعم هذه دار النعيم المعجل","https://www.aldiwan.net/poem2735.html","الطويل"],[580,"فرطت فيك بسوء تدبيري","https://www.aldiwan.net/poem2951.html","الهزج"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83298","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97002","المتقارب"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101546","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87103","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39070","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145804","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62462","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62543","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126188","الكامل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20030","الكامل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44808","الكامل"],[1496,"","https://poetry.dctabudhabi.ae/diwan/poem/131403","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79801","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108650","الخفيف"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101582","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125360","الكامل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202174","الرمل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69422","الكامل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201722",""],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113810","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88700","الرمل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106836","الكامل"],[2465,"","https://poetry.dctabudhabi.ae/diwan/poem/124310","الخفيف"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129933","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94057","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89319","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66348","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66545","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77023","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86352","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136450",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72430","الطويل"],[557,"عودوا إلى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=83292",""],[5183,"أم هابيل","https://www.poetsgate.com/ViewPoem.aspx?id=186487",""],[5200,"هبت تعاتبنى عرسى فقلت لها","https://www.poetsgate.com/ViewPoem.aspx?id=200805",""],[2365,"أدرك الدّهر الذي طلبا","https://www.poetsgate.com/ViewPoem.aspx?id=200641",""],[5413,"هي قصتي!","https://www.poetsgate.com/ViewPoem.aspx?id=200673",""],[5544,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=213413",""],[5616,"قصب","https://www.poetsgate.com/ViewPoem.aspx?id=203436",""],[5638,"عيد أمة هانت","https://www.poetsgate.com/ViewPoem.aspx?id=198128",""],[5781,"أناقة العشق...وتصبُّري","https://www.poetsgate.com/ViewPoem.aspx?id=210380",""],[5897,"إلى ذات الحرير الأخضر","https://www.poetsgate.com/ViewPoem.aspx?id=160572",""],[6032,"خلب الغرام جنانا","https://www.poetsgate.com/ViewPoem.aspx?id=181523",""]],"verses":[["فَكَسَفتُ ضاحِيَهُ بِنَقعٍ مُظلِمٍ","وَكَشَفتُ داجِيَهُ بِوَجهٍ مُقمِرِ",0,"ر",1,0],["فكسّرتَ تمثالاً وهدْمتَ بِيعَةً","وناقوسُها بالكفر يهوي ويهتفُ",1,"ف",1,0],["فكَسَوْهم من الهَوان لَبُوسا","وسَقَوْهم من المنون كؤوسا",2,"س",2,0],["فكسا وحلَّى كلَّ أروع ماجدٍ","من خيرِ ما حاك الضميرُ ونظّما",3,"م",2,0],["فكسوتُه دِيباجَ مَدْحٍ مُشْرقٍ","حَسُنَتْ مَعانيهِ وقَلَّ كلامُه",4,"م",2,0],["فَكَسا وَجهَهُ الحَياءُ وَأَمسى","نادِماً سادِماً يَعَضُّ اليَدَينِ",5,"ن",1,0],["فَكَسانِيَ الآمالَ غَيثاً أَخضَراً","وَكَفى بَني الأَوجالِ مَوتاً أَحمَرا",6,"ر",2,0],["فَكَسبنَ مِنها ما يَقومُ بِأَنفُسٍ","وَالصَبرُ يَبدُنُ في الزَمانِ الهازِلِ",7,"ل",1,0],["فكست منكب الربى وَحوالي","ها رداءً مطرزاً بالنضار",8,"ر",1,0],["فكسونَ الصديقَ شهماً ونَدْبا","واعدن العَدُوَّ نذلاً ونِكسا",9,"س",2,0],["فكساك من خلع الولاية حلة","جلت عن السّوام والأسوام",10,"م",1,0],["فكسوتَ وجه الأرضِ منه محاسنا","فلِعزِّك الدنيا به أنوار",11,"ر",1,0],["فَكَساها مُنَوَّراً رَشَحَتهُ","فَتَراتُ الشِتاءِ وَالأَنواءُ",12,"ا",2,0],["فكسرت في سراها ال","أشجار مثل النصال",13,"ل",1,0],["فكساني لما عريت من الصب","ر ولكن ثوب الأسا والسقام",14,"م",1,0],["فكسا الربيع بقاعها من نشره","حللا تفوق ملابس الديباج",15,"ج",1,0],["فَكَسى خُزيمَة غُرَّةً بِجَبينِهِ","نوراً بِمَسحَةِ أَشرَفِ الإيمانِ",16,"ن",1,0],["فَكَساكَ رَبُّكَ ثَوبَ عافِيَةٍ تَسُر","رُ بِها وَلِيّاً أَو تَسوءُ حَسودا",17,"د",2,0],["فكسب انسان يلازم داره","سلامته من شر إنس وشيطان",18,"ن",1,0],["فكَسا ورُودُهما اخْضِراراً أنّه","صَحِبا غَماماً من نَداهُ هَطولا",19,"ل",2,0],["فكساهُ قَدرَ الشِّبر منه فانكفَا","شَطرَينِ من مُتَيَمِّنٍ ومُيَسَّرِ",20,"ر",1,0],["فكسا دخان شواظهن أناملي","صبغاً يريك الفعل بالآثار",21,"ر",1,0],["فكساك الشباب أفخر ملبو","س تراه ستراً على أغصانك",22,"ك",1,0],["فكسا بما أمضى بهم بيض الظبا","بدمٍ من الأَوداج أحمرَ قاني",23,"ن",2,0],["فكسا المنازِلَ مَطْعَماً ومشارِباً","وكسا الأَسِرَّةَ نَضْرَةً وسرورا",24,"ر",2,0],["فكَسَوْتُ خَيْلَ الشَّوْقِ لَيْلَ مُخالِسٍ","مَا كاد يَشْعُرُ أَنَّهُ جِلْبابِي",25,"ب",2,0],["فكَسَوْتَ فِيهِ الأَرْضَ سابِغَ حُلَّةٍ","نُسِجَتْ بأُسْدِ شَرىً ومَأْشَبِ غابِ",25,"ب",1,0],["فكست مجانيها وروض وهادها","حللا تبهج فوقها مجلالها",26,"ل",3,0],["فكستها مُفَوَّفات بُرُودٍ","أصبحت عبقربة الأصناف",27,"ف",1,0],["فكسرى يرى الإِيوانَ كِسْراً وقَيْصرٌ","يرى القَصْر خُصَّ الناسك المتبتِّلِ",28,"ل",1,0],["فكَسَلْتُ فيك فَيَالَهُ كَسَلاً","بُسِطَتْ بِهِ أَيْدِي المَقَادِيرِ",29,"ر",1,0],["فَكَسا الطَبيعَةَ مِن نَسيجِ بَيانِهِ","حَلَلاً خَلَت مِن غَيرِ طَرزٍ دَواتِهِ",30,"ت",2,0],["فكسر قنا الشرك في جبره","جبر قنا الشرك في كسره",31,"ر",2,0],["فكسوتَ قامتها طرازاً مُعلَماً","يبقى ولا تبقى البدورُ حواسدُه",32,"د",2,0],["فَكَسا المَباني حلةً محبوكة","بِبَديع مَعنىً هام فيهِ الهائم",33,"م",1,0],["فَكَسا الوجودَ ثِيابَ دفءٍ واغْتَدى","يُسْدي الهِباتِ مُشَرِّقاً ومُغَرِّبا",34,"ب",2,0],["فكسِّرْ مَرَايَاكَ ثمَّ اسْتعِدْ","عيونَكَ مِن صمتِها المُطبَقِ",35,"ق",1,0],["فكسَاهم العفو المسكِّن","إذ أتوهُ باعتذارْ",36,"ر",1,0],["فكسَاه رب العرش ثوب سلامة","وجلالة وسكينة ووقارِ",37,"ر",1,0],["فكساك من نسج التواضع بردةً","عزّت على الجبار في بطشاتهِ",38,"ت",2,0],["فَكَسَت بَواطِنُها ظَواهِرَها","نَوراً كَأَنَّ زُهاءَهُ بُردُ",39,"د",1,0],["فَكَسَاهُ خِلعةَ طِيبَةٍ ورَمَى لَهُ","بِدَرَاهِمِ الأَزهَارِ رَميَ سَخَاءِ",40,"ا",2,0],["فكسوته ثوب الأمان وإنه","لا حبلها واه ولا مقضوب",41,"ب",1,0],["فكستها طيبَها أعراقُه","يهجر الشهدَ لها مشتاقُه",42,"ه",1,0],["فكستهُ مسلوبَ المطارفِ نقعها","وسقتهُ ضمآنَ الحشا سمراءها",43,"ا",3,0],["فكسا خده الحياء كما يك","سو احمرار السلافة البلورا",44,"ر",2,0],["فكساق نحو ظام قدرنا","حامل الطاسات دون المطرة",45,"ه",1,0],["فَكَسا الحياءُ وُرُودَ خديها دماً","ومشت وَذَيلُ قميصها يرعاني",46,"ي",1,0],["فكسا الْبَطحاءَ وَشْياً أَخضراً","وأَعار الجوَّ نَوْءاً أَدْكنا",47,"ن",2,0],["فَكَسا جَوانبِها مَفَوَّفَةً","غَنّاءَ يَضحَكُ بَينَها الزَهرُ",48,"ر",1,0],["فكسوها ثوب البهاء بما","أبدعوا من علم ومن أدب",49,"ب",1,0],["فكَسوهُ سوداً والقلوبُ تَوَدُّ لَو","ضَمَّت عليهِ سوادَها الأحداقُ",50,"ق",1,0],["فَكَسَوهُ هَذَا اللَّفظَ تَلبِيساً وَتَد","لِيساً عَلَى العُميَانِ وَالعُورَانِ",51,"ن",1,0],["فَكَسَوتُمُ أفعَالَهُ لَفظَ الحَوَا","دِثِ ثُم قُلتُم قَولَ ذِي بُطلاَنِ",51,"ن",1,0],["فَكَساها وضحا من نوره","بعد ما كانَت كجنح الليل اسود",52,"د",1,0],["فكسرتها وسلكتِ ما نهج الهوى","للعاثرات كأَن ذلك أربح",53,"ح",1,0],["فكسا الصيد والسلاطين ذلا","والمساكين عزة وجلالا",54,"ل",2,0],["فكِسرى في الجفونِ ووجنَتاه","بها النعمانُ والخالُ النجاشي",55,"ي",1,0],["فكسوه ستراً وإذ أرخوه","حل فوق الستور نور اللَه",56,"ه",1,0],["فكسر إيوان كسرى مقصرٌ أملاً","من قيصر في بني التثليث والصنم",57,"م",1,0],["فكسرت أصناماً خفضت برفعك","حتى ليس يرجى انضمامها",58,"م",3,0],["فَكِسْرى بِإيوانٍ تَعاظَمَ مُلْكُهُ","وَشاهَ ارْمَنٍ مِن بَعْضِ أَسْراهُ إِيواني",59,"ن",2,0],["فَكَسَوتَني مُنَناً يَنوءُ بِعِبئِها","شُكري وَلَو اِفنَيتُ فيهِ القيلا",60,"ل",2,0],["فكسا الروض من اليمن ردا","أخضراً وشته بيض المنح",61,"ح",1,0],["فكسا ربيعُ الحُسنِ روضَ جمالهم","من نورِه فوقَ الحريرِ حريرا",62,"ر",2,0],["فِكسرى عندها يبدي إنكساراً","وقيصر دونَ رؤيتها قصير",63,"ر",1,0],["فكسرى أنو شروان في جنب عدله","يرى عدله في عين انصافه جورا",64,"ر",2,0],["فكسرة الخبز بالإخلاص تشبعنا","وقطرة الماء بالإيمان تروينا",65,"ن",2,0],["فكساها من الخلافة برُداً","شفّ عنه جمالها الوضاء",66,"ا",2,0],["فكسب محمدة يبقى الثناء بها","خير وأزين من مذخورة الذهب",67,"ب",1,0],["فكساك الدهر بهجته","ثم حال الدهر فانقلبا",68,"ب",2,0],["فكساكِ من دونِ الغواني حُلَّةً","قدسيةً فجعلتِنِي مجنونا",69,"ن",2,0],["فكساها من الجلال ثيابا","وسقى دوح مجدها فأغنى",70,"ن",2,0],["فكسرة الخبز عند الجوع تقنعني","وتملأ الجوف حبات من الرُطبِ",71,"ب",1,0],["فَكَسَوْتُمُونِي هُونَكُمْ وَشَقَاءَكُمْ","وَكَأَنَّنِي زَمَنَ الْهَوَانِ شُجُونُ",72,"ن",1,0],["فَكَسا حَواشي القلبِ دونَ تَرَفُّقٍ","بِطوافِ شاكٍ منْ بَلايا الأدْهُرِ",73,"ر",1,0],["فكسوك أثواب الخلود بهية","في العالمين على الصعيدِ الأطهرِ",74,"ر",1,0],["فكسوتني من مقلتيك معانيا","أشعلت منها بالهوى نيرانا",75,"ن",2,0]]}