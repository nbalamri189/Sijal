{"poems":[[53,"يا حبذا فوق الكثيب الأعفر","https://www.aldiwan.net/poem30452.html","الرجز"],[83,"عزاء فإن الشجو قد كان يسرف","https://www.aldiwan.net/poem54270.html","الطويل"],[88,"سعروها في البحر حربا ضروسا","https://www.aldiwan.net/poem44472.html","الخفيف"],[51,"إن امرأ رفض المكاسب واغتدى","https://www.aldiwan.net/poem66367.html","الكامل"],[61,"إن عاده بعد السلو غرامه","https://www.aldiwan.net/poem51427.html","الكامل"],[66,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[81,"أهدى التلاقي صبح وجهك مسفرا","https://www.aldiwan.net/poem61522.html","الكامل"],[46,"للخير منزلتان عند معاشر","https://www.aldiwan.net/poem23251.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85417","الخفيف"],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[148,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[183,"عبقت بطيب ثنائك الأقطار","https://www.aldiwan.net/poem14538.html","الكامل"],[193,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[219,"الشمس خلف الجبال","https://www.aldiwan.net/poem55254.html","المجتث"],[220,"روح الروح واسقني بمدام","https://www.aldiwan.net/poem55471.html","الخفيف"],[229,"سبح لربك في الظلام الداجي","https://www.aldiwan.net/poem44595.html","الكامل"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[280,"لا والمطايا يعتسفن البيدا","https://www.aldiwan.net/poem32795.html","الكامل"],[302,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[362,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[363,"لو كان عباس هنالك حاضرا","https://www.aldiwan.net/poem44507.html","الكامل"],[374,"أورت بي الشهوات نار زنادها","https://www.aldiwan.net/poem59396.html","الكامل"],[400,"قد عجزنا عن شكرنا لامتنانك","https://www.aldiwan.net/poem33402.html","الخفيف"],[413,"هنيت بالفرمان والنيشان","https://www.aldiwan.net/poem54081.html","الكامل"],[436,"كسيت بدولتك اليالي نورا","https://www.aldiwan.net/poem34851.html","الكامل"],[436,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[438,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[450,"خذ بنا في محاسن الأوصاف","https://www.aldiwan.net/poem13842.html","الخفيف"],[573,"نعم هذه دار النعيم المعجل","https://www.aldiwan.net/poem2735.html","الطويل"],[573,"فرطت فيك بسوء تدبيري","https://www.aldiwan.net/poem2951.html","الهزج"]],"verses":[["فَكَسَفتُ ضاحِيَهُ بِنَقعٍ مُظلِمٍ","وَكَشَفتُ داجِيَهُ بِوَجهٍ مُقمِرِ",0,"ر",1,0],["فكسّرتَ تمثالاً وهدْمتَ بِيعَةً","وناقوسُها بالكفر يهوي ويهتفُ",1,"ف",1,0],["فكَسَوْهم من الهَوان لَبُوسا","وسَقَوْهم من المنون كؤوسا",2,"س",2,0],["فكسا وحلَّى كلَّ أروع ماجدٍ","من خيرِ ما حاك الضميرُ ونظّما",3,"م",2,0],["فكسوتُه دِيباجَ مَدْحٍ مُشْرقٍ","حَسُنَتْ مَعانيهِ وقَلَّ كلامُه",4,"م",2,0],["فَكَسا وَجهَهُ الحَياءُ وَأَمسى","نادِماً سادِماً يَعَضُّ اليَدَينِ",5,"ن",1,0],["فَكَسانِيَ الآمالَ غَيثاً أَخضَراً","وَكَفى بَني الأَوجالِ مَوتاً أَحمَرا",6,"ر",2,0],["فَكَسبنَ مِنها ما يَقومُ بِأَنفُسٍ","وَالصَبرُ يَبدُنُ في الزَمانِ الهازِلِ",7,"ل",1,0],["فكست منكب الربى وَحوالي","ها رداءً مطرزاً بالنضار",8,"ر",1,0],["فكسونَ الصديقَ شهماً ونَدْبا","واعدن العَدُوَّ نذلاً ونِكسا",9,"س",2,0],["فكساك من خلع الولاية حلة","جلت عن السّوام والأسوام",10,"م",1,0],["فكسوتَ وجه الأرضِ منه محاسنا","فلِعزِّك الدنيا به أنوار",11,"ر",1,0],["فَكَساها مُنَوَّراً رَشَحَتهُ","فَتَراتُ الشِتاءِ وَالأَنواءُ",12,"ا",2,0],["فكسرت في سراها ال","أشجار مثل النصال",13,"ل",1,0],["فكساني لما عريت من الصب","ر ولكن ثوب الأسا والسقام",14,"م",1,0],["فكسا الربيع بقاعها من نشره","حللا تفوق ملابس الديباج",15,"ج",1,0],["فَكَسى خُزيمَة غُرَّةً بِجَبينِهِ","نوراً بِمَسحَةِ أَشرَفِ الإيمانِ",16,"ن",1,0],["فَكَساكَ رَبُّكَ ثَوبَ عافِيَةٍ تَسُر","رُ بِها وَلِيّاً أَو تَسوءُ حَسودا",17,"د",2,0],["فكسب انسان يلازم داره","سلامته من شر إنس وشيطان",18,"ن",1,0],["فكَسا ورُودُهما اخْضِراراً أنّه","صَحِبا غَماماً من نَداهُ هَطولا",19,"ل",2,0],["فكساهُ قَدرَ الشِّبر منه فانكفَا","شَطرَينِ من مُتَيَمِّنٍ ومُيَسَّرِ",20,"ر",1,0],["فكسا دخان شواظهن أناملي","صبغاً يريك الفعل بالآثار",21,"ر",1,0],["فكساك الشباب أفخر ملبو","س تراه ستراً على أغصانك",22,"ك",1,0],["فكسا بما أمضى بهم بيض الظبا","بدمٍ من الأَوداج أحمرَ قاني",23,"ن",2,0],["فكسا المنازِلَ مَطْعَماً ومشارِباً","وكسا الأَسِرَّةَ نَضْرَةً وسرورا",24,"ر",2,0],["فكَسَوْتُ خَيْلَ الشَّوْقِ لَيْلَ مُخالِسٍ","مَا كاد يَشْعُرُ أَنَّهُ جِلْبابِي",25,"ي",1,0],["فكَسَوْتَ فِيهِ الأَرْضَ سابِغَ حُلَّةٍ","نُسِجَتْ بأُسْدِ شَرىً ومَأْشَبِ غابِ",25,"ب",1,0],["فكست مجانيها وروض وهادها","حللا تبهج فوقها مجلالها",26,"ل",3,0],["فكستها مُفَوَّفات بُرُودٍ","أصبحت عبقربة الأصناف",27,"ف",1,0],["فكسرى يرى الإِيوانَ كِسْراً وقَيْصرٌ","يرى القَصْر خُصَّ الناسك المتبتِّلِ",28,"ل",1,0],["فكَسَلْتُ فيك فَيَالَهُ كَسَلاً","بُسِطَتْ بِهِ أَيْدِي المَقَادِيرِ",29,"ر",1,0]]}