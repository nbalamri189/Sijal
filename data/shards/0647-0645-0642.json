,"https://poetry.dctabudhabi.ae/diwan/poem/139593",""],[4679,"ما درت مثل عيدك الأعيادُ","https://www.poetsgate.com/ViewPoem.aspx?id=142749",""],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4750,"ون ابن جدلان","https://www.poetsgate.com/ViewPoem.aspx?id=180423",""],[4755,"لا تَمنَحِ الذُّلَّ إطراقا","https://www.poetsgate.com/ViewPoem.aspx?id=212886",""],[4929,"الحق ورايته (اكناف بيت المقدس)","https://www.poetsgate.com/ViewPoem.aspx?id=208723",""],[5411,"النّور","https://www.poetsgate.com/ViewPoem.aspx?id=187732",""],[5518,"سِدرةُ المنتهَى","https://www.poetsgate.com/ViewPoem.aspx?id=206241",""],[5582,"قَلْبٌ عَلَى جَمْرِ الغَرامِ يُقَلَّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186671",""],[5616,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=204848",""],[5720,"قادةٌ وأثَر *","https://www.poetsgate.com/ViewPoem.aspx?id=199812",""],[5792,"ابركها من ساعه","https://www.poetsgate.com/ViewPoem.aspx?id=180342",""],[5853,"ندائي","https://www.poetsgate.com/ViewPoem.aspx?id=178347",""],[5943,"لاتعجبني ياسيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=37263",""],[6101,"زمرة الشيطان / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120281",""],[6142,"من مبلغ أكثر الأصحاب معذلتي","https://www.poetsgate.com/ViewPoem.aspx?id=155745",""],[6152,"حبكِ خارطتي","https://www.poetsgate.com/ViewPoem.aspx?id=203311",""]],"verses":[["هُمُ قَعقَعوا بَغياً عَليكَ وَأَجلَبوا","فَآبوا وَما قاموا بِحَلٍّ وَلا عَقدِ",0,"د",1,0],["هُم قَومِيَ الأَدنَونَ مِن بَينِ أُسرَتي","وَإِن كانَ شِعبُ القَومِ مِن غَيرِ مَشعِبي",1,"ب",2,0],["هُم قَعَدوا فَاِنتَقَوا لَهُم حَسَباً","يَجوزُ بَعدَ العِشاءِ في العَرَبِ",2,"ب",1,1],["هُمُ قَرَنوا بِالبَكرِ عَمراً وَأَنزَلوا","بِأَسيافِهِم يَومَ العَروضَ اِبنَ ظالِمِ",3,"م",1,0],["هُمُ قَتَلوا الزُبَيرَ فَلَم تُنَكِّر","وَعَزّوا رَهطَ جِعثِنَ في الخِطابِ",4,"ب",1,0],["هُمُ قَتَلوا صَبراً شُتَيرَ بنَ خالِدٍ","وَأَبكَوا لِبِسطامٍ مَآتِمَ حُسَّرا",5,"ر",2,0],["هُمُ قَومي وَقَد أَنكَرتُ مِنهُم","شَمائِلَ بُدِّلوها مِن شِمالي",6,"ل",2,0],["هُمُ قَتَلوا يَومَ الرَجيعِ اِبنَ حُرَّةٍ","أَخا ثِقَةٍ في وُدِّهِ وَصَفاءِ",7,"ا",2,0],["هُم قَيَّدونا بِالعَوارِفِ وَالنَدى","وَهُم أَطلَقونا مِن عِقالِ المَغارِمِ",8,"م",1,0],["هُم قَلَّبوا كُرَةَ الدُنيا فَما وَجَدَت","أَقوى عَلى صَولَجانِ المَلكِ أَيمانا",9,"ن",2,0],["هُمُ قَتَلوا مَولاهُمُ وَأَميرَهُم","وَلَم يَصبِروا لِلمَوتِ عِندَ المَلاحِمِ",10,"م",1,0],["هُمُ قُطبُ مِلَّةِ دينِ الإِلَهِ","وَدَورُ الرَحى حَولَ أَقطابِها",11,"ب",3,0],["هُمُ قَوَّموا دَرءَ الشَآمِ وَأَيقَظوا","بِنَجدٍ عُيونَ الحَربِ وَهيَ هَواجِعُ",12,"ع",1,0],["هُم قَدَّموا القَومَ الطَغامَ وَأَخَّروا","مَلَأَ السُراةِ وَمَعشَرَ الأَعيانِ",13,"ن",1,0],["هَمَّ قومٌ بِقَتْلِهِ فأَبى السَّيْ","فُ وَفاءً وَفاءتِ الصَّفْواءُ",14,"ا",2,0],["هُمُ قَدَحُوا تِلكَ الزّنادَ التي وَرَتْ","ولو لمْ تُشَبَّ النّارُ لم تَتَضَرّم",15,"م",1,0],["هم قطّعوا بأكفّهمْ أرحامَهُمْ","غَضباً لجارِ بُيوتِهم أن يغضَبا",16,"ب",2,0],["هُم قَعَدوا فَاِنتَقوا لَهُم حَسَباً","يَدخُلُ بَعدَ العِشاءِ في العَرَبِ",17,"ب",1,1],["هُمُ قَتَلوا لَقيطاً وَاِبنَ حُجرٍ","وَأَردَوا حاجِباً وَاِبني أَبانِ",18,"ن",1,0],["هم قدَّسوا البدويَّ تق","ديس المسيح وأحمد",19,"د",1,0],["همْ قطَّعوا بأكفهمْ أرحامهمْ","فتوطَأ أغمارٌ وهضبٌ شناخيب",20,"ب",1,0],["هم قاف قرب اللَه سينا الهدى الذي","تغشت بأنوار النبي كتائبه",21,"ب",2,0],["هُم قارَنوا الحُسنَ بِالإِحسانِ عَن كَرَمٍ","حَتّى تَشابَهَتِ الأَفعالُ وَالصُوَرُ",22,"ر",1,0],["هَمِقٌ إِذا رَشَحَ العِذارُ بِلَيتِهِ","وَكَفَت خَصائِلُهُ وَكَيفَ الغَرقَدِ",23,"د",1,0],["هُمُ قالوا المُدامُ رُضابُ فِيهِ","وَمَن أَعطاكَ يا كَأْسَ المُدامِ",24,"م",1,0],["هُمْ قَصّروا عنها ولم يَتواضَعُوا","وحَظِيتَ أنتَ بها ولم تَتكبَّر",25,"ر",1,0],["همُ قتلوا عُزَيزاً يومَ لَحجٍ","وعَلقَمَةَ بنَ سعدٍ يومَ نَجدِ",26,"د",1,0],["هم قوم لوطٍ فادن منهم تجدهم","أفاعي في أنيابها السم والذبح",27,"ح",1,0],["همْ قُدوةُ الأجيالِ ، أنَّى يقتدي","جيلٌ بمن هو في الخلافِ يلوبُ",28,"ب",1,0],["هُمْ قادتي وسَادتي","وأسْوتي المرضيّهْ",29,"ي",2,0],["هم قذاة الأعيان كم أتمنى","حين ألقاهم بأني أكمه",30,"م",2,0],["هم قد أذاقوا كل باغ ومعتد","كؤوس المنايا من شفار المهند",31,"د",1,0],["هم قبلنا ركب سرى متقدما","نحن القطار لهم نسير سريعا",32,"ع",2,0],["هم قوَّدوني وبرأسي نخوة","أن أستميح اللَّحزَ الضنينا",33,"ن",2,0],["هم قطبها كيفما أديرتْ","وهم إذا ضلّت السبيلُ",34,"ل",1,0],["همْ قشروا العار عن عصاهم","بكلِّ عاري الظُّبا صقيلِ",35,"ل",1,0],["هم قواعدها السفلى وذروتها ال","عليا وأوتادها المرساة والطنب",36,"ب",1,0],["هُمُ قَذَعوا نفوسَهُمُ ولوَّوْا","أعِنَّتَها إلى التّقوى وراضوا",37,"ض",3,0],["هم قادة الآنام في وادي المنى","ولذا بهم تتشبه الآنام",38,"م",1,0],["هُم قُدوَةٌ لِلعالَمينَ مِن بَني العَبّاسِ مِن","بَعدِ الخَلائِفِ مِن بَني مَروانِ",39,"ن",1,0],["هُم قادة الدُنيا وَنَحنُ وَراءَهُم","فُضول وَأَذيال تَجر وَتَتَبع",40,"ع",1,0],["هم قَبَلوا الزِّناء وأنشؤوهُ","وهم وسموا بجبهته حبيسا",41,"س",2,0],["همُ قلادة عز أنت واسطة","فيها وكل بما قد قلته علما",42,"م",2,0],["هُم قَتلُوا مُوسَى الحَراميَّ فاستَوت","كنانةُ يَعليها مَعاً وَهُطُوفُها",43,"ف",3,0],["هم قدموه لامرة بضلالها","أَمسى لَه يتمهد التقديم",44,"م",1,0],["همُ قرَّبوا طرق الحياة وإنما","لإدراكنا تقريب ما كان نائيا",45,"ي",2,0],["هُم قَد بايَعوا المُختار حَقّاً","عَلى أَن لا يُضام وَلا يُصابا",46,"ب",2,0],["هُمُ قَتَلوهُ كَي يَكونوا مَكانَهُ","كَما غَدَرَت يَوماً بِكِسرى مَرازِبُهْ",47,"ب",2,0],["هم قد فوقوا حسدا إليكم","سهام الغي بالشر الصراح",48,"ح",1,0],["هم قابلوا في نصر مَدرَة هاشمٍ","أُميَّةَ لما آزرتها القبائل",49,"ل",1,0],["هم قادوا الجياد على وجاها","من الامصار يقذفن المهارا",50,"ر",2,0],["هُمُ قَتَلوا بِشرا وَرَدُّوا خُيولَهُ","بِطَعنٍ كَإيزاغِ المَخاضِ الحَوامِزِ",51,"ز",1,0],["هُمُ قطعُوا أرحامَهُم وتحزَّبُوا","وَحَادَ بِهشم عَن رُشدِهِم عمرُو والغمرُ",52,"ر",1,0],["هم قُدوةُ النّاس لا أُحاشي","ومُدَّعي غيرِ ذاكَ زورُ",53,"ر",1,0],["هُمُ قُدوَةٌ في ذا الزَمانِ وَحُجَّةٌ","وَميزانُ عدلٍ لا يَميلُ عنِ القَصدِ",54,"د",1,0],["هم قابلوا الإقبال والنقع حالك","وهم بادلوا الأموال والعام كالح",55,"ح",1,0],["هُم قَدَّمُوا المفهُومَ مِن لَفظِ الكِتَا","بِ عَلَى الحَدِيثِ المُوجِبِ التبيَانِ",56,"ن",1,0