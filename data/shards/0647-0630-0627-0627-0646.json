m/ViewPoem.aspx?id=177138",""],[6102,"على !!","https://www.poetsgate.com/ViewPoem.aspx?id=184455",""],[6145,"لما تطاير لحمه وعظامه","https://www.poetsgate.com/ViewPoem.aspx?id=7800",""],[6159,"شكراً جزيلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85857&r=&rc=3",""],[6180,"امرأة في داخلي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81072&r=&rc=6",""],[186,"رقص الهزار على الغصون الميس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55775&r=&rc=38",""],[6186,"عادت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82885&r=&rc=5",""],[5355,"دنيا القريض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87209&r=&rc=34",""],[6234,"ديواني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6528&r=&rc=0",""],[6262,"العائد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80128&r=&rc=26",""],[6294,"هذا انا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69312&r=&rc=29",""],[6314,"بكائية الليل الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88067&r=&rc=2",""]],"verses":[["هذا انتشى بصَبوحه من دجلة","قبلاً وزاد من نيله بغبوق",0,"ق",1,0],["هذا إناء حوى ما كان مجتمعا","في غيره فله الماعون أعوان",1,"ن",1,1],["هذا انتهاكٌ ، بل عدائيةٌ","كل ضيائي عدو هتوك",2,"ك",1,0],["هذا انت دايم تقلب الصحبه اخناق","ودايم اتغلى ولا انا ما تغليت",3,"ت",1,0],["هذا أنا بكلِّ سيئاتي","بكلِّ ما في الأرضِ من غرورِ",4,"ر",1,0],["هذا أنا إن تكن يا دهر تجهلني","أرى المصائب والأفراح سيانا",5,"ن",2,0],["هَذا إِناءُ الحِكمَةِ البَرِّ الَّذي","بِبِهاءِ أَنوارِ المُهَيمنِ قَد كُسِي",6,"س",2,0],["هذا أنا فاعذريني","إذا سئمت اصطباري",7,"ي",1,0],["هذا اندراوسُ ذاق صلباً ذاوياً","إذ سلَّمَ الأتراك ديناً صائبا",8,"ب",2,0],["هذا انتحارٌ لو دَريتض فهلُ ترى","تدري أم استسلمتَ للبهتان",9,"ن",1,0],["هذا أنو شروان آخرُ قومه","نجلُ العلى وأخو الملوك الصيدِ",10,"د",1,0],["هذا أناني وذلك خائن","والثالث المدفوع للهيجاء",11,"ا",2,0],["هذا أنا مُذْ خُلقتُ، نورٌ","يسْتبصرُ نورَه الأريبُ",12,"ب",1,0],["هذا أنا أعلنتُ حظرَ تَجَوُّلي","في الطيشِ وابتدأَ الحصارُ الخَيِّرُ",13,"ر",1,0],["هذا أنا من بُؤس ِما بي ضاحِكٌ","والضِحْكُ في زَمَن ِالبكاءِ عزَائي",14,"ا",2,0],["هذا إن عدلك في عدلك","حصه تصلح لك ذي الخله",15,"ه",1,0],["هذا إن موسى أمعن اللحظ به","فهو عميد العلما والرؤسا",16,"س",2,0],["هَذا أَنالَ فَدامَ نائِلُهُ","فِينا وَذاكَ أَلَثَّ وَاِنصَرَفا",17,"ف",2,0],["هذا انتساب أولى التفريق نسبته","من أربع معلومة التبيان",18,"ن",1,0],["هَذَا أَنَا وَالأُفْقُ صَافَحَ نَجْمَتِي","فِي ذَاتِ يَومٍ مِنْ خَضِيرِ شَبَابِي",19,"ب",2,0],["هذا انقلاب حكومة الحق الذي","تقضى شرائعه على التيجان",20,"ن",1,0],["هذا انتقام الكرى من بطء موعده","وللكرى ربَّةٌ مشكورة النِّقم",21,"م",1,0],["هذا انتقامٌ من عزيزٍ قاهرٍ","ربٍّ قويٍّ قادرِ متعالي",22,"ل",2,0],["هذا أنا لم أزل أحياكِ ملءَ دمي","وتنبضين غراماً ملءَ أوردتي",23,"ت",2,0],["هذا أنا احتسي في الليل قافية","وفي النهار يموت الحرف والكلم",24,"م",1,0],["هذا أنا يا حمام الأيك مجتمع","إذا قُسمت وحين الجمع انقسم",24,"م",1,0],["هذا أنا ما بين حزني وخوفي","تشفّ ما دامك تحب التشفّي",25,"ف",2,1],["هذا أنا.. جَسَدٌ على أكتَافِهِ","تَعدُو الجبَالُ, ولا تَرِقُّ الأدمُعُ",26,"ع",1,1],["هذا أنا واختفى والليلُ ثائرة ٌ","في جوفهِ المرِّ أكبادٌ وأفواهُ",27,"ا",2,0],["هذا انا ياهيهِ وافهم ماجرالي","بالليالي كم نقل راسي عليّه",28,"ي",2,0],["هذا انا عسافها واهديتها بكيفي لذيب","لاعوى ثم امتطاها شقق صفوف الزحام",29,"م",1,0],["هذا أنا قد جئت أشكر من له","فضل علي وهل يجود ثناء",30,"ا",2,1],["هذا انا مجنووون والقلب مرهون","في دنيتك يادنيتي وانظمك فن",31,"ن",1,0],["هذا انا مابيني وبيني افراح","حتى الهموم الخافيات استضاحت",32,"ت",1,0],["هذا أنا قبل المقادير تدنيك","قدّر طليق الأمس لليوم طالبك",33,"ك",1,0],["هذا أنا راجع من المستقبل المُر الفظيع","طفل ٍعلى وجهه تقاسيم البراءة والغرام",34,"م",1,0],["هذا أنا المجبولُ حبًّا للتي","صبّت بروحي من صميمِ رضاها",35,"ا",3,0],["هذا أنينُ القلبِ،قلبي مُتْرَعٌ","شوقٌ ويشدوهُ الحنينُ ويَخْفِقُ",36,"ق",1,0],["هذا انت تشكي الجرح عامً ورى عام","وجوفك من النيران مات وتشوّه",37,"و",2,0],["هذا انا كلي رجعت أعزف هيامي","رافع راسي وقلبي بين ايديه",38,"ي",2,0],["هذا أنا والأرضُ تعرفُ من أنا","يا عورةَ التأريخ ِ في أزماني",39,"ن",2,0],["هذا أنا يا مسندي هبس وهبوس","ويا كثرهم مثلي رثع فيه غلّه",40,"ل",2,0],["هذا أنا يا ميُّ منذُ بَعُدْتِ عن","عينيْ أضعتُ بغربتي إنسانِيْ",41,"ن",2,0],["هذا انا يلي بديت بتجافيكك","هذي فعولي والسوايا سواياك",42,"ك",1,0],["هَذَاْ أَنَاْ .. وَلَقَدْ مَسَحْتُ بِرَاْيَتِيْ","عَرَقَاً تَلَمْلَمَ فَوْقََ غُصْنٍ مِنْ نَقَا",43,"ق",2,0],["هَذَاْ أَنَاْ قَدْ رَنَتْ نَفْسِيْ الضُّحَى قَدَرَاً","عَلِّيْ أُلاقِيْ الضُّحَىْ عَلِّيْ أُدَاْنِيْهِ",44,"ي",2,0],["هَذَاْ أََنَا وَالعُذْرُ مَقْطُوعُ الرََّجَاْ","وَالكَفُّ يَدْعُوْ وَالدُّمُوعُ شَرَابِيْ",45,"ب",2,0],["هذا أنا فارسٌ للشِّعرِ في زمني","قبلي الفحولُ وبعدي لن ترى اسْمَا",46,"م",2,0],["هذا أنا وبرغمِ كلّ توتُّري","والناسُ حولي ذكرُك استثناءُ",47,"ا",2,0],["هذا أنا وبماضٍ سوف أصرفهُ","حليب نوقِ أمانينا سأنتخبُ",48,"ب",1,0],["هذا أنا بالمُنى لا ليس ينصفني","بأن وقفت على ظلّي لكي أثبُ",48,"ب",1,0],["هَذَا أَنَا كَالطَّيرِ مُنطَلِقاً","أَشدُو، فَيَسحَرُ شَدوِيَ الطَّيرَا",49,"ر",2,0],["هذا أنا والشِّعْرُ كُلُّ مَخاوِفي","آهاتُ حُزْني في القَصيدِ عِذابُ",50,"ب",1,0],["هذا أنا قد رقّ ثوبُ عفافهِ","فطفقتُ عريانا ببوحيَ أجهرُ",51,"ر",1,0],["هذا أنا إن تسألوهُ تعجبا","جسمٌ هزيلٌ متعبٌ ونحيلُ",52,"ل",1,0],["هذا أنا كالطودِ مصطبرٌ","ما همّني في صبريَ البذلُ",53,"ل",1,0],["هذا أنا..صقرٌ تكسّرَ جنحُهُ","ومضى كسيرَ القلبِ للمحرابِ",54,"ب",1,0],["هذا أنا وطنٌ, جوازُ مرورهِ","صدقُ النوايا والعهودُ الوافيهْ",55,"ف",3,0],["هذا أنا أبكي بني العبّاسِ","فابكِ معي يا ظبيةَ الأوراسِ",56,"س",1,0],["هذا أنا صبٌّ تمرد عشقهُ","وبدا يسابقُ في الهوى فيمنْ بدا",57,"ا",1,0],["هذا أنا ... في حيرتي يا صبوتي","وتقودُني الأوهامُ للبئرِ العميقة",58,"ق",2,0],["هذا أنا .. معك باقي .. ولا تمنّيتي أمر","بس تمنّي .. تلتقيني .. قبل لا لي تندهين",59,"ن",1,0],["هذا أنا قاصدٌ بغدادَ نازِلُها","يا منزِلاً تتمنّى وصلَهُ العَجَمُ",60,"م",1,0],["هذا أنا.. يا لِبوحٍ","عن حسرةِ العمرِ شفّا",61,"ف",2,0],["هذا أنا في ساحة الحمراء أسألُ حائراً","صمت المكانِ ولا أراه يجيبُ",62,"ب",1,0],["هذا انصبابُ غمامةٍ شردت","مامسّه الإحساس مابلّه",63,"ل",2,0],["هذا انصباب الروح دلقة وجدها","نفحاته كالله كيف يموتُ ؟",64,"ت",1,0],["هذاانت والا حمرت الشمس واليم","ريح المطر والا نسايم حنينك",65,"ك",1,1],["هذا انت والا من يضم الحشا ضم","هذي يدين البرد والا يدينك",65,"ك",1,0],["هذا انا , والليل , وبارق تواليه","وهذاك وجه الصبح , ما شع نوره",66,"ر",2,0],["هَذا أنا شهقةُ الأحياءِ في لُججٍ","بمُنتهى ضفَّتيها الخوفُ والغرقُ",67,"ق",1,0],["هذا أنا بين فَكيْ ضيغمٍ أَشِرٍ","وجندُه أينما يَممتُ أشرار",68,"ر",1,0],["هذا أنا في كلَّ شبرٍ","فيضُ حبري كالعلم",69,"م",1,0],["هذا أنا لحالي .. هزيل الحال .. وأشعر بإكتئاب","كن قلبي جال بحر ٍ هاجرت عنه الطيور",70,"ر",1,0],["هذا انت خنت العيش والملح يامن","تسب ناسٍ خانوا الملح والعيش..!!",71,"ش",1,1],["هذا انا يوم الحياه فنظرتي عشرين بيت","ومسجدين .. ومدرسه من طين كم فيها اصطبحت",72,"ت",1,0],["هذا أنا وأصبحت اتمتم : \" هذا انا \" حتى بغيت..",".. أختنق .. بس القدر عيّا على موتي .. وطحت",72,"ت",1,0],["هذا أنا كالنجمِ في شعْثِ الفضا","بالنارِ أبحثُ عن سبيلِ هدايتي",73,"ت",2,0],["هذا أنا بل من أنا يا حيرتي!","طفلٌ يشيبُ ولا يعيشُ برفقتي",73,"ت",2,0],["هذا أنا أبكى بحرفيَ باسماً","في النورِ بيتي من ظلامِ العزلةِ!",73,"ه",1,0],["هذا أنا عبدك أناديك من عوم","أغفر لي الزله فدار الأخيره ...",74,"ر",2,0],["هذا أنا البحر فيه الدر يسكنه",".وفيه تنطق بالآلاء أولادي",75,"د",2,0],["هذا انا بين ميلادي ومنعطفي","سبع وستون خطف العين تنخطف",76,"ف",1,0],["هذا انته تبخل بحروف","تهمسهاباذني للغد",77,"د",1,0],["هذا انا سلطان يا الي عن علومه ناشدينه","حر من ضربة يمينه تسهر العين الجبانه",78,"ن",2,0],["هذا أنا وسهادُ الليلِ يصحبُني","إني أنا المُبتَلى بالسّهدِ واليأسِ",79,"س",1,0],["هذا انا للحين .. قلبي يناديك","ليتك تحس بحالتي لا فقدتك ..!!",80,"ك",1,0],["هذا أنا ياسيّدي شوفني زين","جبل ولكن .. كل همٍ رقابه",81,"ب",2,0],["هذا انا من ضيقتي حيل مجبور","لاصرت أنادي وين .. رد أعتباري !",82,"ر",2,0],["هذا أنا والهم مليان فيني","والي سمو ب أخلاقهم ماتحلّو ..!!!",83,"ل",2,0],["هذا انا والحال من دون لا دون ؟","عايش كآبة بؤس ماهي هنية !",84,"ي",2,0],["هذا انا من العام طايح ومطعون","لاالوقت وقتي ولا القصايد لحوني",85,"ن",2,0],["هذا انا من الليل واقف ومشتاق","وهذي كفوفي من الوله دوم عرقى",86,"ق",2,0],["هذا انا والشعر حاله بحاله","اما غشيته يوم والا غشاني",87,"ن",2,0],["هذا أنا يا مَن جَهِلْتَ بموطني","باللهِ .. هل شاهدتَ مثلَ مَعالمي؟",88,"م",2,0],["هذا انفجارٌ في عميق قلوبنا","لا تحتملهُ أسقفٌ وبيوتُ",89,"ت",1,0],["هذا أنا سيدي بالبابِ منتظرٌ","معي حروفي ..فشهرُ ربيعَ ناداها",90,"ا",3,0],["هذا أنا سيدي لا بوصلات معي","سواكَ أنتَ الربيع فخُذْ بمن تاها",90,"ا",3,0],["هذا أنا..كيف شوقُ الأنبياءِ إلى","رؤياكَ والآيُ عنكَ تضمّ بشراها",90,"ا",3,0],["هذا أنا يا سائلي متوشح أجزائي حداد","شفني انا فيني غدّت .. اجزائي الغبراء .. حطام",91,"م",1,0],["هذا انا جيتك شعور / صدق ما عنه .. أحيد","وأنت تدري بأن فعلي / فوق ترديد..الكلام",92,"م",1,0],["هذا أنا والآخرون مواسمٌ","بالطّيب جاؤوا ,للمحبّةِ أقدموا",93,"م",3,0],["هذا أنا مسجون بالحب يا هيه","عيَّا زماني والخطوط مْعطوفه",94,"ف",2,0],["هذا أنا مانيب انا واتأملّي سبع الفروق","ما عاد باقي بي سوى الدمعات والموت الأكيد",95,"د",1,0],["هذا أنا وحبي من العام للحين","وباقي العمر مني لقلبك هديه",96,"ي",2,0],["هذا أنا بالآهِ أطلقُ صرختي","ودِمَا الشَّبابِ تفورُ كالبركانِ",97,"ن",1,1],["هذا انتهاءُ مطافي قمت مبتهلاً","لله يغفر لي عن هفوة الكلِمِ",98,"م",1,0],["هذا أنا يا رب أزجي عبرتي","حرّى بما قد بؤت من أخطائي",99,"ا",3,0],["هذا أنا والشعر حالَ مديحنا","لعَطيَّةِ التعليم ، ذاكَ عَمِيْدُهْ",100,"د",2,0],["هذا أنا ..وسوايَ ليسَ يهمّني","الويلُ لو يوماً سوايَ تكلّما",101,"م",2,0],["هَذَا أَنا, وَقَصِيدِيَ انتَثَرتْ","أَبياتُهُ - مِن لَوعَتِي - جُمَلا",102,"ل",2,0],["هذا انتشار المجد قد وزعته","فكسا سهولا بالهدى وهضابا",103,"ب",2,0],["هذا أنا إما أقول فأصطلي","أو أنني أُفنى بسمِّ تكتُّمي",104,"م",2,0],["هذا أنا من بعدها، ملوّناً كطفلٍ","أبكي بألفِ لُغَةٍ، وأكرهُ التّفسيرا",105,"ر",2,0],["هذا إناء الحكمة البر الذي","بيهاء أنوار المهيمن قد كسي",106,"س",2,0],["هذا أنا مجهدٌ طالت مقاصده","رأى الطريق على آثار أشتات",107,"ت",1,0],["هذا أنا أهوى القصيدة تارةً","وأصدها رغم احتياجي تارةْ",108,"ر",2,1],["هذا أنا وجع الكلام يجيئني","في كل صبح أستفيق جوارَهْ",108,"ر",2,0],["هذا أنا قد هد جسمي الأسى ‍ ‍","والقلب باك من عذاب السنين",109,"ن",1,0],["هذا أنتَ الوجْهُ الشاحبْ","الهاربُ في زمنٍ هاربْ",110,"ب",1,1],["هذا انا قلب ٌأضاع الحبَ في دنياك ِ","هذا انا قمرٌ ينوحُ على ضفاف ِ هواكِ",111,"ك",1,1],["هذا أنا كانعكاس الوهم محتملٌ","بعضي ضلالٌ وهذا البعض فيه هُدى",112,"د",2,0]]}