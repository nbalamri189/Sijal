,[4978,"لله درك يا أخي وتدوم","https://www.poetsgate.com/ViewPoem.aspx?id=178647",""],[585,"سل الدهر ما للدهر بالرزء يفجع","https://www.poetsgate.com/ViewPoem.aspx?id=161944",""],[585,"يا أيها القلم انهض إن سواك كبا","https://www.poetsgate.com/ViewPoem.aspx?id=161888",""],[3591,"ألفناك من دمع الخد ساجم","https://www.poetsgate.com/ViewPoem.aspx?id=149426",""],[3591,"أحبكمَ والشاهداتُ الحواسدُ","https://www.poetsgate.com/ViewPoem.aspx?id=149376",""],[5225,"رد صاحب السمو الشيخ زايد بن سلطان آل نهيان على قصي","https://www.poetsgate.com/ViewPoem.aspx?id=27613",""],[5338,"على منهاج صاحب البردة","https://www.poetsgate.com/ViewPoem.aspx?id=187617",""],[5397,"بآل محمدٍ عرف الصواب","https://www.poetsgate.com/ViewPoem.aspx?id=157900",""],[5431,"عادات ثقيلة ...","https://www.poetsgate.com/ViewPoem.aspx?id=213746",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5444,"آيات الوصال","https://www.poetsgate.com/ViewPoem.aspx?id=205510",""],[5573,"عديت لك سبعين بارق وشديت","https://www.poetsgate.com/ViewPoem.aspx?id=205474",""],[5582,"أَراكَ كَئِيباً أَراكَ أَراكَا","https://www.poetsgate.com/ViewPoem.aspx?id=187214",""],[5648,"احساس مجنون","https://www.poetsgate.com/ViewPoem.aspx?id=154543",""],[5652,"معالي / توفيق الربيعه","https://www.poetsgate.com/ViewPoem.aspx?id=177752",""],[5652,"تمثال حلمي ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=178197",""],[5674,"يا أحلى دواويني","https://www.poetsgate.com/ViewPoem.aspx?id=186990",""],[5691,"هبوط","https://www.poetsgate.com/ViewPoem.aspx?id=206350",""],[5725,"ايقونة","https://www.poetsgate.com/ViewPoem.aspx?id=195001",""],[5749,"الفكلمة","https://www.poetsgate.com/ViewPoem.aspx?id=132697",""],[5749,"سعداتك ايلا بغاتك","https://www.poetsgate.com/ViewPoem.aspx?id=179968",""],[402,"أبلغ بما أفرغت في تمثال","https://www.poetsgate.com/ViewPoem.aspx?id=36069",""],[5970,"قد أثقلت ذات قلبي اليوم شكواه","https://www.poetsgate.com/ViewPoem.aspx?id=130621",""],[6134,"جنات عدن من رباها يجتنى","https://www.poetsgate.com/ViewPoem.aspx?id=169536",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[5309,"نصوغ من لاعج الأشواق الحانا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573550",""],[6229,"حواء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65186&r=&rc=12",""],[6315,"رُؤى على شفير الحداد !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87579&r=&rc=4",""]],"verses":[["تمثلت فيه الدهر أنّى تقلبت","نوائبه والخلق أنى تواردوا",0,"د",3,0],["تَمَثَّلَ الخَطبُ مَظنوناً لِتالِفِهِ","فَسَوفَ نَلقاهُ مَوجوداً وَمُدَّرَكا",1,"ك",2,0],["تُمَثِّلُهُ الذِّكرى وَهَيهاتَ نازِحٌ","نأَت دارُهُ حَتّى كَأَنّي أُخاطِبُهْ",2,"ب",2,0],["تُمَثِّلُهُ في نَومِهِ وَجُلوسِهِ","وَتَخدَعُ فيهِ المَوتَ حينَ يُقارِبُه",3,"ب",2,0],["تَمَثَّلي إِن شِئتِ في مَنظَرٍ","يا جولِيا أُنكِرُ فيهِ الغَرام",4,"م",1,1],["تَمْثَالُكَ المَرْفُوعُ أَبْلَغُ شَاهِدٍ","بِوَفَاءِ مِصْرَ وَذَاكَ فِيها خِيمُ",5,"م",1,0],["تمثّل ما قد مرّ منَا وما حلا","وما جلّ من أمر الحياة وما دقّا",6,"ق",2,0],["تمثال ناعمة الشمائل وجهها","تزداد نوراً منه عين المُجتلي",7,"ل",2,0],["تمثّلك الذكرى لعينَّى جالساً","تحدثّنا عّما أهمّ من الأمر",8,"ر",1,0],["تَمثَّلُ للأوهام عند مغيبها","تمثُّلَ قرنِ الشمس تحت نشاص",9,"ص",1,0],["تَمَثَّلْتُ أمثالي مُعيداً ومُبدئاً","فما اندمَلَ الجُرحُ الذي بي ولا التأمْ",10,"م",1,0],["تُمَثِّلُ لي الأَشواقُ أَنَّ تُرابَها","وَحَصباءَها مِسكٌ يَفوحُ وَعِقيانُ",11,"ن",1,0],["تُمَثِّلُ مِصرَ لِهَذا الزَمانِ","كَما هِيَ في الأَعصُرِ الخالِيَه",12,"ي",2,0],["تَمَثَّلوا حاتِماً وَلَو عَقَلوا","لَكُنتَ في الجودِ غايَةَ المَثَلِ",13,"ل",1,0],["تَمَثَّلْتُ يومَكَ في خاطرِي","ورَدَّدْتُ صوتَكَ في مَسْمَعِي",14,"ع",2,0],["تَمَثَّلُ لي أَن لا أَقولَ عَلى النَوى","فَيا لَيتَ شِعري ما الَّذي أَحدَثَت بَعدي",15,"د",2,0],["تَمَثَّلُ لي جَهَنَّمُ حينَ يَبدو","خَيالُ الكَبشِ مِن تَحتِ السَقيفَه",16,"ه",1,1],["تَمَثَّلَ لي وَجهُ الخَليفَةِ دونَها","فَقُل في حَبيبٍ دونَهُ أَسَدٌ شاحِ",17,"ح",1,0],["تمثَّلَ صدرُك سلطانَهُ","كجبارِ وادٍ تحدَّى الخطَرْ",18,"ر",1,0],["تمثَّلَ الحقّ يرمي كلَّ شائبةٍ","عنه ويُغرِقُ فيه كلّ بهتانِ",19,"ن",1,0],["تمثَّلَ إذْ تألّقَ ذكرياتٍ","وأمجاداً مشهّرةً مُسامهْ",20,"م",2,0],["تمثَّلها الحبُّ في باقةٍ","إلهيةٍ جَمَعَتْها يداهْ",21,"ه",1,0],["تَمثَّلْتِ شتَّى جسومٍ وكم","تجدَّدْت في صُوَرٍ بائدهْ",22,"ه",1,0],["تمثَّلها في صورة قرشيّة","يشيعُ الرضا في طيفِها المتجسِّدِ",23,"د",1,0],["تمثَّلْتِهِ طيفَ إنسانةٍ","ومَثَّلَ فيك الصِّبا الناضرا",24,"ر",2,0],["تُمَثِّلُهَا الذِّكْرَى لِعَيْنِي كَأَنَّنِي","إِلَيْهَا عَلَى بُعْدٍ مِنَ الأَرْضِ نَاظِرُ",25,"ر",1,0],["تِمْثَالِ مَجْدٍ لا تَرَى فِيهِ سِوَى","رَجُلٍ بِلاَ تِيهٍ وَلاَ إِدْلاَلِ",26,"ل",1,0],["تمثالَ نَهْضَةِ مِصْرَ أَشْرِقْ جَامِعاً","أَسْنَى مُنَى الأَوْطَانِ فِي تِمْثَالِ",27,"ل",1,0],["تِمْثَالُهُ مِنْ مَعْدَنٍ","وَمِثَالُهُ فِي كُلِّ قَلْبِ",28,"ب",1,0],["تَمَثَّلَتْ مِصْرُ فِيهِمْ وَهْيَ مُوحِيَةٌ","مَا يُطْرِبُ الْحَفْلَ مِنْ شِعْرٍ وَمِنْ خُطَبِ",29,"ب",1,0],["تَمَثَّلتها حَتّى إِذا ما تَمَثَّلَت","طَرِبتُ كَأَنّي قَد دَعَوتُ وَلَبَّتِ",30,"ت",1,0],["تمثلت لهم الدنيا فما جهلوا","حقيقة الأمر ان العيش ثعبان",31,"ن",1,0],["تمثّل إذا تألّق ذكريات","وأمجادا مشهّرة مسامه",32,"م",2,0],["تمثل من تهوى قريباً مناجياً","تبث له الشكوى وترجو وتأمل",33,"ل",1,0],["تمثلُ الذي درتْ","شفاهها من قبلي",34,"ل",2,0],["تمثّلَ يومُ الحشرِ فيهِ ونورُهُ","ظلامٌ كأنَّ الجوَّ وجهُ مقنَّع",35,"ع",1,0],["تمثّل قصّة الإنسا","ن منذ بداية الدهر",36,"ر",1,0],["تمثل الأحلام في سجنه","رواية الماضي الذي قد غبر",37,"ر",1,0],["تمثل فيها فصول الفساد","وتلمع فيها نصال النقم",38,"م",1,0],["تُمثلِّكَ الذِّكْرَى لِقَلْبي وَنَاظِرِي","فأَغْدُو وَكُلِّي أَعْيُنٌ وَقُلُوبُ",39,"ب",1,0],["تُمَثِّلُكَ الذِكرى إِذا شَطَّتِ النَوى","لِعَيني فَأَغدو كَالقَريبِ المُلازِمِ",40,"م",1,0],["تمثَّلَ لي بالسِّحْرِ ورْداً ونَرْجساً","وما هي إلاّ وجنتاهُ وعَيْنَاهُ",41,"ه",1,0],["تَمَثَّلَهُ الأبطالُ في كلّ مَعْركٍ","وتدعو لَهُ النَسّاكُ في كلِّ مسجدِ",42,"د",1,0],["تُمثِّلُكَ الأفكارُ لي كلَّ لَيلةٍ","وتُؤنِسُني أشباهُكَ الأنجمُ الزُّهرُ",43,"ر",1,0],["تُمثّلُكَ الأشواقُ لي كُلَّ ليلةٍ","فَهمّي جديدٌ والفِراقُ جَديدُ",44,"د",1,0],["تمثل الراح نشوة منه حقا","حين يعدي إسكاره الصهباء",45,"ا",2,0],["تمثلهُ الأحزان عندي فأنثني","أناجيه من فرط الصبابة بالفكر",46,"ر",1,0],["تمثل حبا بالغا وأمانيا","أضت وسفحا من دموعي أو جرحا",47,"ح",2,0],["تُمثِّلُ الأشخاصَ فيما صقَلتْ","من سابغ وافٍ وصمصامٍ خَذِمْ",48,"م",1,0],["تُمثِّلُ بَهْرامَ الكواكبِ قائماً","بها حيثُ بَهرامُ الأكاسر قاعدُ",49,"د",1,0],["تمثل بيننا الماضي فكدنا","نشاهد ما تقصه بالعيون",50,"ن",1,0],["تمثالُ حُسنٍ بلا مِثْلٍ يماثِله","في الحسنِ لكنَّه في السَّير كالْمَثل",51,"ل",1,0],["تُمَثِّلُكَ الأَشْواقُ وَهْماً لِخاطِري","فَيُدْرِكني بالخَوْفِ مِنْكَ وُجُومُ",52,"م",1,0],["تُمَثِّلُ دَكَّ الطورِ في صَعَقاتِهِ","دَمادِمُهُ مَمّا تَميدُ مَعاقِلُهُ",53,"ل",2,0],["تمثلت في الأشياء وهي تمثلي","على أنني لم ألف لي فيهم مثلا",54,"ل",2,0],["تمثلها في كل عين مثالها","له مثل في كل قلب له مثوى",55,"و",2,0],["تمثل للحس المبين بفعله","فضلت به الأبصار في نور ظله",56,"ه",1,0],["تمثلت في إنسان عين عيانها","بنيت بها بيتاً لها من بيانها",56,"ه",2,0],["تمثلها المخصوص فالذات ضمنها","تسمت بأسماء الوجوب لأنها",56,"ه",2,0],["تمثل روح الوحي في شكل دحية","هدايته تهدى لتمهيد فرشه",56,"ه",1,0],["تمثل مثل في تهيؤ هيئة","تبدى فأبدى منه كل بدائه",56,"ه",1,0],["تمثله المخصوص عرش استوائه","هو الأزل القيوم في الأبدية",56,"ه",1,0],["تمثله فيه بكل رقيقة","هو الناطق القيوم في كلماته",56,"ه",1,0],["تمثله يبدي رقائق نفسه","فأمثاله للخلق رسل المنية",56,"ه",1,0],["تمثلها في كل ركن للطفها","يولد أشكال النفوس اللطيفة",56,"ه",1,0],["تمثل في أشباحه الملكية","إذا ما انتفت بالله بعد ثبوتها",56,"ه",2,0],["تمثلني الرحمن عينا لغيبه","فها صورتي كالنجم في صورة الإسرا",57,"ر",2,0],["تمثلت وهي روح اللَه في بدل","من شكل عيسى لذات الصون والعصم",58,"م",1,0],["تمثلت في أكنافه ركب هاشم","تهاوت إليه فيه خوص الركائب",59,"ب",1,0],["تَمثل لي شَخص الزَمان وَزارَني","وَلَم يَك طَرف النجم عَني بِناعسِ",60,"س",1,1],["تمثلتِ الرواةُ به قديماً","إذا نزلت بساحتها الخطوبُ",61,"ب",1,0],["تمثل هبة من منحوا","سعود الحياة عقيب الممات",62,"ت",1,0],["تمثل القوم فيها كل طائفة","من المرافق والآمال والمهن",63,"ن",1,0],["تُمثلك الأشواق حتى كأنني","أناجيك بالأشجان من حيث تسمع",64,"ع",1,0],["تَمَثَّلَت لِي في كُلِّ الجِهاتِ فَفي","حلّي وَفي حُلَلي وَالخَيلِ وَالخَوَلِ",65,"ل",1,0],["تمثل ليلة غال الشقي","بها علم القسط قسطاسه",66,"س",2,0],["تمثلتِ الأهدابُ في ماءِ وجههِ","فخالوا خيالَ الشعرِ فيه عِذارا",67,"ر",2,0],["تمثل في المنام لديك ناسٌ","نخبّر عن دمائهم يداكا",68,"ك",2,0],["تُمثلُها تحت التُّراب كعهدنا","بها وبأفكار القلوب تزُورُها",69,"ر",3,0],["تمثّل بين يدي مغرم","يقاسمه لفحات الجوى",70,"ا",1,0],["تمثل الذوق حسناً","يذري بنظم الجمان",71,"ن",1,0],["تَمَثَّلَ أَيّامَ الوِصالِ وَمَن لَهُ","بِإِرجاعِها أَو مَن عَلَيها يُؤازِرُه",72,"ر",2,0],["تمثلك الذكرى لطرفي كأنني","أراك فما أدنى المزار وأبعدا",73,"د",2,0],["تمثَّلَ جبريلُ لمريمَ صورةً","من الإنس لم يأتِ بمثل ولا بكا",74,"ك",2,0],["تمثلتم لي والديار بعيدةُ","فخيل لي أن الفؤاد لكم مغنى",75,"ن",2,1],["تمثل فيك بأس أبناء يعربٍ","وبغي علوج الترك شر من اعتدى",76,"د",2,0],["تمثل فيك من خلق وخُلق","فكنت لشخصه اسمى مثال",77,"ل",1,0],["تَمثيله كَنحو إِنّ بشرا","مُقَدِّمٌ رجلاً مُؤخر أُخرى",78,"ر",2,0],["تمثّلت لي في سكون الدجى","خيالاً تراوح في خاطري",79,"ر",2,0],["تمثال مجمرة قريب عندها","قد احرقت لصليبها فتفتت",80,"ت",1,0],["تمثل لي بموكبه كميّاً","أضاءت فوق منكبه أضاة",81,"ه",1,0],["تمثّل كلُّ رأي الحق فيّا","فإن لم أرض عنك فلست شيّا",82,"ي",2,0],["تمثال كل عظيم في فضائله","لا بالنحاس ولا بالصخر والتبر",83,"ر",1,0],["تمثلها العين المنيرة للعدى","ويسترها جفن من الليل واطف",84,"ف",1,0],["تمثال دلسبس فيها","كأنه جسم مارد",85,"د",1,0],["تَمَثَّل سُلَّماً فيها تَراءَى ال","قُوَى بينَ انحِدارٍ وارتِقاءِ",86,"ا",2,0],["تمثيل اقوالهِ والفعلِ أَنشَطَنا","والخيلُ تُنشَط بالمِهمازِ واللُجُمِ",87,"م",1,0],["تمثالها في صفحة البلور","مرتسماً بريشة من نور",88,"ر",1,0],["تمثالَ سعد فى الجزيرة ساهراً","هيهات يغفل منك لَحْظٌ صارم",89,"م",1,0],["تُمثله حُلمًا ناطقًا","على الستر من يبغِه يشهدِ",90,"د",1,0],[