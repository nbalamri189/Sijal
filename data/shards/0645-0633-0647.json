{"poems":[[53,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[104,"مسهدون وهم حيرى محاجرهم","https://www.aldiwan.net/poem32919.html","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19074","البسيط"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9580","البسيط"],[92,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[154,"الخوف والأنس شيء ليس يتفق","https://www.aldiwan.net/poem68515.html","الخفيف"],[228,"مر جنح من الظلام وقلبي","https://www.aldiwan.net/poem41919.html","الخفيف"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[310,"ما له في النحو نبغ","https://www.aldiwan.net/poem56476.html","مجزوء الرمل"],[376,"شك فيما شكوت من طول ليلي","https://www.aldiwan.net/poem57240.html","الخفيف"],[376,"أصبحوا يفرقون من إفراقي","https://www.aldiwan.net/poem57285.html","الخفيف"],[415,"من كان لي من حماه خيس ذي لبد","https://www.aldiwan.net/poem32214.html","البسيط"],[445,"سعي شفى بالمنى قبل انتها أمده","https://www.aldiwan.net/poem34879.html","البسيط"],[556,"مرت بنا بمصلى الخيف سانحة","https://www.aldiwan.net/poem47343.html","البسيط"],[556,"أما آن للسلوان أن يردع الصبا","https://www.aldiwan.net/poem48083.html","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133831","الوافر"],[1768,"","https://poetry.dctabudhabi.ae/diwan/poem/101825","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2553,"","https://poetry.dctabudhabi.ae/diwan/poem/12036","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137238",""],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101878","البسيط"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104683","الطويل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79714","البسيط"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26120","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103931","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85183","البسيط"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136912",""],[5056,"<< لا تلمني إن بكت عيني سناها..>>","https://www.poetsgate.com/ViewPoem.aspx?id=33786",""],[5136,"يا بروحي المدلل البتاه","https://www.poetsgate.com/ViewPoem.aspx?id=121772",""],[5277,"لا تمسحِ الدمعَ","https://www.poetsgate.com/ViewPoem.aspx?id=195072",""],[5628,"نذاء الروح","https://www.poetsgate.com/ViewPoem.aspx?id=178463",""],[6052,"هزة الضمير","https://www.poetsgate.com/ViewPoem.aspx?id=34893",""]],"verses":[["مُسهِّلاً سبل الجدوى لطالبها","لعرضه ولدين الله ظلّافا",0,"ف",2,0],["مسهدون وَهُم حَيرى مَحاجرهم","تَنوطها بِنُجوم اللَيل أَسبابُ",1,"ب",1,1],["مُسَهَّدَ الجَفنِ مَكدودَ الفُؤادِ بِما","يُضني القُلوبَ شَجِيَّ النَفسِ عانيها",2,"ي",3,0],["مُسَهَّدٌ في ظَلامِ اللَيلِ أَوّاهُ","عَضَّتهُ لِلدَهرِ أَنيابٌ وَأَفواهُ",3,"ه",1,1],["مسّه الظلمُ فعادى أهله","وامترى البؤسَ فَحَبَّ البوساء",4,"ا",2,0],["مسهَّدُ الجَفنِ في فكرٍ ومعتبرٌ","لا الفجر يلفيه نوَّاماً ولا الشَّفق",5,"ق",1,0],["مسَّهُ عارِضُ الجنونِ فَلَولا","أَضلُعي لاِستَطارَ عن جُثمانِه",6,"ن",2,0],["مسهدَ الجفن لا ترمش مدامعهُ","كأنما طرفّه من دوننا طرفا",7,"ف",2,0],["مَسّه بِالمنطقِ السو","ءِ منَ الشيطانِ نزغُ",8,"غ",1,0],["مُسهراً والرُّقادُ أسهلُ ما أَع","رِفُ مِنه ما كانَ عندَ سُهيلِ",9,"ل",1,0],["مسَّةٌ من هَواكَ بي لا مِن الجن","نِ فَهَل مِن مُعَزِّمٍ أَور راقِ",10,"ق",1,0],["مُسَهَّدٌ وعُيونُ الخلقِ هاجِعَةٌ","على التَّهَجِّدِ والقرآنِ معتَكِفُ",11,"ف",1,0],["مسهَّداً فِي سبيلِ اللهِ يكلؤُهُ","ربٌّ أَنامَ عُيونَ الدِّينِ فِي سُهُدِهْ",12,"د",2,0],["مسهّدين ولولا داءُ حبِّكمُ","أكرى العيونَ لنا مَن كان أكراكِ",13,"ك",1,0],["مُسهّدَةٌ لا يطعمُ النومَ جَفنُها","وَلا تَبلغ الغايات مِن صَبرها العُقبى",14,"ب",2,0],["مسهِّدَ أمة وغدٍ شرودِ","وحقك لست وحدك بالشهيدِ",15,"د",1,1],["مسه الضر وأمسى شبحا","ما له ظل إذ الشوق براه",16,"ا",2,0],["مسَّهُ الضُّرُّ وانبرى الداءُ يَفرى","جسمَ طَودٍ فانهارَ هذا البناء",17,"ا",2,0],["مُسَهَّدَ النَومِ تَعنيهِ ثُغورُكُمُ","يَرومُ مِنها إِلى الأَعداءِ مُطَّلَعا",18,"ع",2,0],["مسهداً لم اذق طعم الكرى","هل يعرف العاشق طيب المنام",19,"م",1,0],["مسهد الطرف لم يخطر بناظرتي","طيب المنام ولا أقوى على الجلد",20,"د",1,1],["مسهل آمالٍ ومصلح صالحٍ","وكم سامدٍ لولاه أهلكه الردا",21,"د",2,0],["مسهد الطرف والجيران قد هجعوا","معذب الجسم بالأوجاع مضطلع",22,"ع",1,0],["مُسَهَّلَةٍ نَوافِذُها وَضَربٍ","كَأَفواهِ المُقرَّحَةِ الهدولِ",23,"ل",1,0],["مسهد القلب في خديه أدمعه","قد طالما شرقت بالوجد أضلعه",24,"ع",2,1],["مسهد طرفه المعنى","منكد قلبه العميد",25,"د",1,0],["مسهد الطرف لا يني يتلوّى","في حشا الليل خابطاً كالجنين",26,"ن",1,0],["مُسهداتٌ سعدُها في مُشتهاها","مٌبدِلاتٌ دمعها غالي دماها",27,"ا",3,0],["مسهل مثل الهلال وقد أو","في على البدر تمه وسناه",28,"ا",2,0],["مسهّدٌ وجموحُ النفس تطلبُهُ","شوقاً إلى حمرةِ الخدينِ..وا عجبا",29,"ب",2,0],["مُسهّدا في مطاوي الليل لا سِنَة ٌ","تغشى الجفون فريدا ليس لِي أحدُ",30,"د",1,0],["مسه الجن وامتطاه جنون","فعوى ذئبه بجبن فرارا",31,"ر",2,0]]}