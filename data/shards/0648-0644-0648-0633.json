بض قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=190482",""],[6127,"البشرى","https://www.poetsgate.com/ViewPoem.aspx?id=204472",""],[6225,"نسيمُ الخلود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81328&r=&rc=355",""],[6259,"سقى دمعي الأحبَّة َ حيث ساروا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59414&r=&rc=62",""],[572,"أخٌ لي كُنتُ أُغبَطُ باعتقادِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9249&r=&rc=106",""]],"verses":[["وَلَو سأَلَتْ نُجومَ اللَّيلِ عَنّي","لَخَبَّرها بِما أَلقَى النُّجومُ",0,"م",1,0],["وَلَو سأَلَتْنِي غَيرَهُ لَرَجَعتُها","بِهِ فالهَوى لِلمالِكيَّةِ أَجمَعُ",1,"ع",1,0],["وَلَو سادوا وَاِستَجَدّوا لِلسَخا ال","مَنسوخِ طاسِم رَسمِهِ المَدروسِ",2,"س",1,0],["وَلَو سَعى غَيرُهُ فيها لِيَرأَبَها","أَنامَهُ المُقعِدانِ العَجزُ وَالتَعَبُ",3,"ب",1,0],["وَلَو سَكَتَّ وَلَم تَخطُب إِلى عَرَبٍ","لَما نَبَستَ الَّذي تَطويهِ مِن سَبَبِك",4,"ك",1,0],["ولو سلبتنيه الحوادث في الدنى","لما عشت أو مارمت عيشاًبدونه",5,"ن",2,0],["ولو ساروا على طرق انفراد","لما كانوا سوى هَمَجَ رعاع",6,"ع",1,0],["ولو سَبَر الناس الحوادث بالنهي","لما حصلوا منها على غير مضحك",7,"ك",1,0],["وَلَو سارَ الزُبَيرُ فَحَلَّ فينا","لَما يَئِسَ الزُبَيرُ مِنَ الإِيابِ",8,"ب",1,0],["وَلَو سَدَّ غَيري ماسَدَدتُ اِكتَفوا بِهِ","وَما كانَ يَغلو التِبرُ لَو نَفَقَ الصُفرُ",9,"ر",1,0],["وَلَو سُئِلَت بَدرٌ بِحُسنِ بَلائِنا","فَأَثنَت بِما فينا إِذاً حُمِدَت بَدرُ",10,"ر",1,0],["ولو سمته ردّ الشباب لردّه","عليَّ وقد مرَّت عليَّ سوافي",11,"ف",2,0],["ولو سُئلنا لقلنا الفقرُ فاقِرةٌ","لكنَّ أعظمَ منه حسرةُ الحَرَبِ",12,"ب",1,0],["ولو سام سَوْمَ اللهو قامت بلهوه","فِصاحٌ بأيديهن خُرْسٌ تَكلَّمُ",13,"م",1,0],["ولو سامني ذاك الوزيرُ أبيتُهُ","وأنكرتُهُ النُّكرَ الذي هو صارمُ",14,"م",1,0],["ولو سَخِطَ امرؤ يُولَى جميلاً","سَخِطتُ وحُقَّ لي مِمَّا اعتلاني",15,"ن",2,0],["وَلَو سُئِلَت عَنّي أُمَيَّةُ أَخبَرَت","لَها بِأَخٍ حامي الذِمارِ نَصورِ",16,"ر",1,0],["ولو سئل الإسلام ماذا يريده","لما اختار إلا ان تديما التلاقيا",17,"ي",2,0],["وَلَو سَها قَوادهُ وَآلُهُ","لَقَلَّدَ العَهدَ عَليّ بِن الرِضا",18,"ا",1,0],["وَلَو سُقِّيتُها بِيَدي نَديمٍ","أَسَرُّ بِهِ لَكانَ أَبا ضَبيسِ",19,"س",1,0],["وَلَو سِرنا إِلَيهِ في طَريقٍ","مِنَ النيرانِ لَم نَخَفِ اِحتِراقا",20,"ق",2,0],["وَلَو سَلَكَت طُرقَ السِلاحِ لَرَدَّها","بِطولِ يَمينٍ وَاِتِّساعِ جَنانِ",21,"ن",1,0],["وَلَو سَمِعَ الدَهرُ العِتابَ بِمَنطِقٍ","لَأَوجَعتُهُ مِنّي بِحَدِّ المُعاتِبِ",22,"ب",1,0],["وَلَو ساعَدَت سُعدى عَلى الحُبِّ ذا هَوى","أَبَت قَولَ واشيها وَعاصَت عَذولَها",23,"ل",3,0],["وَلَو سيقَتِ الدُنيا إِلَيهِ بِأَسرِها","وَلَم يَتلُها حَمدٌ لَعافَ قَبولَها",23,"ل",3,0],["وَلَو سَأَلَت عَنّي سُوَيدَةُ أُنبِئَت","إِذا كانَ زادُ القَومِ عَقرَ الرَكايِبِ",24,"ب",1,0],["وَلَو سَيَّرتُمُ فيمَن أَصابَت","عَلى القَسِماتِ أَظفاري وَنابي",25,"ب",2,0],["وَلَو سُؤِلَت مَن كُفُؤُ الشَمسِ أَومَأَت","إِلى اِبنَي مَنافٍ عَبدِ شَمسٍ وَهاشِمِ",26,"م",1,0],["وَلَو سُؤِلَت مَن كُفأُنا الشَمسُ أَومَأَت","إِلى اِبنَي مَنافٍ عَبدِ شَمسٍ وَهاشِمِ",27,"م",1,0],["وَلَو سُؤِلَت عَنّي النَوارُ وَقَمُها","إِذاً لَم تُوارِ الناجِذَ الشَفَتانِ",28,"ن",1,0],["وَلَو سَلَبَتهُ الحَربُ مِنّي لَشاهَدَت","كَما شاهَدَت في ثارِ أَخوالِهِ مِنّي",29,"ن",2,0],["ولو سطا قادراً عليه","لم يبُقِ للطيرِ فيه شِلوا",30,"و",2,0],["وَلَو سُلَّ روحي مِن عُروقي لَرَدَّهُ","إِلَيَّ رُضابٌ مِن ثَناياكِ سِلسالُ",31,"ل",1,0],["وَلَو سَلَكَ الناسُ في جانِبٍ","مِنَ الأَرضِ وَاِعتَزَلَت جانِبا",32,"ب",2,0],["وَلَو سُئِلَت بِنا البَطحاءُ قالَت","هُمُ أَهلُ الفَواضِلِ وَالسُيوبِ",33,"ب",1,0],["ولو سُرِقُوا أنسابَهم يومَ فخرِهم","ونَزْوَتِهِمْ ما جاز في مِثلها القَطع",34,"ع",1,0],["وَلَو سَكَنَت جِبالَ الأَرضِ روحٌ","لَما خَلَدَت نَضادِ وَلا أَرابُ",35,"ب",1,0],["وَلَو سَأَلوهُ بِالَّذي فَوقَ صَدرِهِ","لَجاءَ بِمَينٍ أَو أَرَمَّ وَجَمجَما",36,"م",2,0],["ولو سَمِعَتْ كلامَكَ بُزْلُ شَوْلٍ","لعادَ هَديرُ بازِلِها فَحيحا",37,"ح",2,0],["وَلَو سَأَلَت مِنّي حَياتي بَذَلتُها","وَجدتُ بِها إِن كانَ ذَلِكَ مِن أَمري",38,"ر",2,0],["ولو ساد في الأرض عدلُ السماءِ","لعاش الأنام بها سعداء",39,"ا",2,0],["ولو سلت السيفين يمنى اخوة","لدكت جبال المعتدين المصارع",40,"ع",1,0],["ولو سلمت من صبغة الشر نسمة","لما راع في أوكاره الفرخ رائع",40,"ع",1,0],["ولو سقى الشمس من أحزانه نديت","على هجير الضّحى حبّا وتحنانا",41,"ن",2,0],["ولوْ سُئِلتْ من كُفؤُ الشمس أوْمأتْ","إلى ابْنَيْ مَنَافٍ عَبدِ شَمسٍ وَهاشِمِ",42,"م",1,0],["ولَوْ سُئِلَتْ عَني النَّوَارُ وَقَوْمُهَا،","إذاً لمْ تُوَارِ النّاجِذَ الشّفَتَانِ",43,"ن",1,0],["وَلَو سَعى جُهدَهُ المَعروف مُختَبِراً","لَم يَلف غَيرَك في الدُنيا فَيألفهُ",44,"ف",2,0],["ولو سمعت أذني لصوتك نغمة","لما طربت يوماً لصوت شدا ليا",45,"ي",2,0],["ولَو سَوَّدتُمُوهُ مُبَارَكِيًّا","أشَمَّ بِكُلِّ مَحمَدَةٍ كَفِيلا",46,"ل",2,0],["وَلَو سِواكَ وَكَلّا كانَ وارِدَهُ","لَما عَدَوتُ بِهِ الإِكدارَ وَالزَبَدا",47,"د",2,0],["وَلَو سَمَحتِ بِلُقيا الطَّيفِ عِشتُ بِهِ","دَهراً وَإِن هِمتُ بَعدَ العَينِ بِالأَثَرِ",48,"ر",1,0],["ولو سبكوا شخصاً جميعاً لما وفوا","يقينا لما يأتي ولا قاربوا الشكا",49,"ك",2,0],["ولو سألتني مهجتي لو هبتها","وقلت افعلي بي ما تحبين يا هند",50,"د",1,0],["ولو سمعوا ما عنه يقرا لديكم","لكفره الاجماع منهم وكذبوا",51,"ب",3,0],["ولو سمعوا من قال خاطب ربنا","لكانت رؤوس بالصوارم تضرب",51,"ب",1,0],["وَلَو سِواكَ دَعاني لَم أُلَبِّ لَهُ","صَوتاً وَلا قامَ في ناديهِ شادِيها",52,"ي",3,0],["وَلَو سَأَلَت للنَّاسِ يَوماً بِوَجهِها","سَحابَ الثُّرَيّا لاستَهَلَّت مَواطِرُه",53,"ر",2,0],["ولو سَكتوا قامتْ مَعاليك شاعرا","فصيحاً له بين الأَنام نشيد",54,"د",1,0],["ولو ساعدتْني عزمةٌ من جناحِه","ليَمَّمتُ أحبابي بها حيثُ ما كانوا",55,"ن",3,0],["وَلَو سألَ الأشياخَ أدرك سرّه","وَلكنّه مع جهلهِ قَد حَوى كِبرا",56,"ر",2,0],["ولو سِوَى مَنْظَرِهِ راقني","لألاؤُهُ كنتُ من الخاسرين",57,"ن",1,0],["ولو ساسها أَحدٌ غَيْرُه","لأخرجتِ الأَرض أَثقالها",58,"ل",3,0],["ولو سَحَرَتْ أَرْبُعٌ قبلَه","لكان البديعَ الذي يَسحَر",59,"ر",1,0],["ولو سَرَتْ ما بقِيَتْ لم تُجْهَدِ","من المراسيل العِتَاق الوُخَّد",60,"د",1,0],["ولو سال دمعي بها جدولاً","فما أنا عنها لعمري بسال",61,"ل",1,0],["ولو سوى مدح إبراهيم يلزمني","شببت فيه بأنواع من الهزج",62,"ج",1,0],["وَلَو سير الاجبال سارَت وان دَعا","ذرى صخرة لبت له الصخرة الصلدا",63,"د",2,0],["وَلَو سار فَوقَ البحر أَو طارَ في الهَوا","لامكنه وَالحق ما جاوز الحدا",63,"د",2,0],["وَلَوْ سَجَدَ الوَرَى لأَبَرِّ خَلْقٍ","يَداً وَنَدىً لَحُقَّ لَكَ السُّجُودُ",64,"د",1,0],["وَلَوْ سَارَ وَمْضُ البَرْقِ والرِّيحُ عِنْدَهُ","لَكَلاَّ وَكَلاَّ لَيْسَ يُدرِكُ كاذِبُ",65,"ب",1,0],["وَلوْ سَأَلْتَ اللَّيلَ عَن صُبحهِ","لَقَالَ أَلْهَتْهَ الوُجُوهُ الصِّباحْ",66,"ح",1,0],["ولو سلَختْ لنا في الشّرْقِ شَهْراً","سَبقْنَ بنا إلى الغَرْبِ الهلالا",67,"ل",2,0],["ولو سقط التفاضلُ في عقولٍ","لَكَانَ الناسُ كُلُّهُمُ سَواءَ",68,"ا",2,0],["وَلَو ساجَلَت غُرُّ الغَمائِمِ أَدمُعي","تَبَيَّنَ عَن قُربٍ غُرورُ الغَمائِمِ",69,"م",1,0],["وَلَو سَمِعَت أَو لَم تَدَبَّرَ أَهلُها","عِتابي لَكانَ البَحرَ فيهِ العَجائِبُ",70,"ب",1,0],["وَلَو سيقَت الدُنيا إِلَيَّ جَميُعها","بِغَير وِداد ما رَفَعَت لَها جِفنا",71,"ن",2,0],["ولو سألت عنا سليمى لخبرت","إذا الحجرات زينت بالمغالِق",72,"ق",1,0],["وَلَو سادَ الصَبور بِغَيرِ حلم","إِذاً لاقتادَ قائِدَه الحِمارُ",73,"ر",1,0],["ولو سَعَى الطّيفُ بِهِ في الكَرَى","لَقيلَ هذا المُنْزَلُ المُحكَمُ",74,"م",1,0],["ولو سئّلت أرض الفرنج شهادة","أجابتكم صيدا ويافا وحارم",75,"م",1,0],["ولو سَمِ جَدُّكَ المنصورُ أدعُو","إِلَيْهِ لَمَ يَسُمْني سَوْمَ مَطْلِ",76,"ل",1,0],["ولو سلمى أقل البعض منها","تهدم من ذراه وهو نيق",77,"ق",1,0],["ولو سبرتُ الناسَ أو أعلقتُها","مُزرّعيّاً عَلِقتْ مَتينا",78,"ن",2,0],["ولو سلم ابنُ أيّوب ولمّا","يَحُلْ سلِمَ البقاءُ من الحِمامِ",79,"م",1,0],["ولو ساعد الشوقَ طَولٌ إليك","طلعتُ به خيرَ مستطلَعِ",80,"ع",1,0],["ولو سيروا فلكا تسير بهم على","متون ظهور أو بطون على البحر",81,"ر",1,0],["ولو سَفَكَتْ يداهُ دَمَ ابن عمِيِّ","أو إنني لم أتِرْهُ ولم أُعَادِهْ",82,"د",2,0],["ولو سَلَموا لإمامِ الهُدَى","لقُوبِلَ مُعوجُّهم باستواء",83,"ا",2,0],["وَلَو ساكِناتِ الأَيكطِ يَعمَلنَ مَن ثَوى","لِما نَحنُ إِلّا في رِثائِكَ سَجَّعا",84,"ع",2,0],["وَلَو سَبَقتُ بِهِ الوَرقاءُ ما لَحِقَت","مَناحَتي صاحِبَيهِ السَيفُ وَالقَلَما",85,"م",2,0],["وَلَو سَبَرَ الناسَ الأُمورَ لِأَصبَحوا","بِأَسرِهِم مِن فَيلَسوفَ وَزاهِدِ",86,"د",1,0],["وَلَو سُبِكَ الوَرَى لَفظاً لَكُنتُم","بَني عُمَرٍ مَعانٍ لِلمَعانِ",87,"ن",1,0],["وَلَو سُبِكَت قُرونُ الخَلقِ قَرنا","وَقَرنا ما وَفَت في الحَربِ قِرنا",88,"ن",2,0],["ولو سُبِكت قُرونُ الخلقِ نِدّا","لعَمرُك ما وفَى الثقلان ندَا",89,"د",2,0],["ولوسف تنظر كيف يصبح ظافراً","بجميع ما يرجوه في زمنٍ قليل",90,"ل",1,0],["ولو ساير الأيام في مصر أهلها","لعادت إليها اليوم أحزابها حزبا",91,"ب",2,0],["ولو سألوا عني لكان صنيعهم","وكان هو الشافي وكان هو المغني",92,"ن",2,0],["وَلَو سَمِعتْ في الغابِ ذِكراه أُسْدها","لَمِنْهُ عَلى أَرواحِها خافَتِ الخَطفا",93,"ف",2,0],["وَلَو سَمِعَت آذانُنا درَّ لَفظِهِ","لَقالَت رَعاكَ اللَّهُ زِدنا مِنَ امْدرِّ",94,"ر",1,0],["ولو سرقْتُ خليعاً من ملابِسه","لاخْتَلْتُ في حُلَّةٍ أَبْهَى من السَّرَق",95,"ق",1,0],["ولو ساهرٌ أَمسَى سليمَ ضئيلة","أخو ألمٍ يضْحِى ويُمسِى مسهدَّا",96,"د",2,0],["ولو ساورتْه حادثاتُ زمانِه","وصارت عليه موعظاتُ الورى تُتْلَى",97,"ل",2,0],["ولو سقيت أمثالها قبلها دما","لقلت سقاها من دموعي السواجم",98,"م",1,0],["وَلَوْ سقي الصَّلْدَ مِنْ جِرْيَالِ رِيقَتِهِ","لأنْبَتَ الصَّلدُ نِسْرِينًا وَسُوسَانَا",99,"ن",2,0],["وَلو سَمِعت أسدُ العرينِ ببأسهِ","وَسطوتهِ تحتَ العجاج لذلّتِ",100,"ت",1,0],["ولو سوى هذه الدنيا غدا وطني","لقلت أني لم أربع على طلل",101,"ل",1,0],["وَلَو سُئلَت بِلاَدُ الحَربِ عَنَّا","وَعَنكُم إِذ تَصادَمنا صِدَامَا",102,"م",2,0],["وَلَو سُئِلَت مِنهُ شَنُوءَةُ فِديَةً","لأَعطَوا نُفُوسَ القَومِ بَعدَ الحَرَائِبِ",103,"ب",1,0],["وَلَو سُئِلَت يَوماً رَبيعَةُ مَن بِهم","لَها خَضَعت وَاِرتَجَّتِ الشَرقُ وَالغَربُ",104,"ب",1,0],["ولو سمعت صفير الناي اذ صعقت","أو لو الهوى خلت نفخ الصور قد حضرا",105,"ر",2,0],["وَلَو سَمِعَت سَمعي عَكاظُ بَلاغَتي","لَما سَمَّعَ الآذانَ في الذِكر سحبانُ",106,"ن",1,0],["ولو سمحوا بخوض البحر خضناً","على الدر النفيس بكل بحر",107,"ر",1,0],["ولو سلموا ساروا على منهج الهدى","الى حضرة الرضوان لكنهم غُرّوا",108,"ر",3,0],["وَلَو سَهَّلَت عَنكَ الأَسى كانَ في الأَسى","عَزاءُ مُعزٍّ لِلَّبيبِ وَمَقنَعُ",109,"ع",1,0],["ولو سألنا عبد العزيز وما","في القبر الا عظامه الرمم",110,"م",1,0],["ولو سئلت عنا جنوب لأخبرت","عشية سالت عقرباء وملهم",111,"م",1,1],["ولوسف تأتيني المراكب عدةً","فيها صنوف مواكب الركابِ",112,"ب",1,0],["وَلَو سكنت لأَسكنها سكونا","خليلاه السَكينة وَالوقار",113,"ر",1,0],["ولو سمعت شعري النجوم لحاولت","بأقصر بيتٍ أن تملكني الشعرى",114,"ر",2,0],["ولو سمعوا أمر النهى ما تسمعوا","مقالة ألوى في الخصومة ألوق",115,"ق",1,0],["ولو سألت الظلام عنها","تجيبك الأنجم السواري",116,"ر",2,0],["ولو سمِعَ السلام لردّ عمرو","ولكن لا يُطيقونَ الكلاما",117,"م",2,0],["وَلَو سَمِعوا مِنهُم دُعاءً يَروعُهُم","إِذا لَأَتَتهُ الخَيلُ أَعيُنُها قُبلُ",118,"ل",1,0],["وَلَو سَألنَا بِكَ الأعيَادَ مَا حَكَمَتْ","إلاَّبِأنَكَ رُوحٌ أوْ هِيَ البَدنُ",119,"ن",1,0],["وَلَو سامَني الماني مَكانَ حَياتِهِ","أَناعيمَ دَهرٍ مِن عِبادٍ وَجامِلِ",120,"ل",1,0],["ولو سواك بعته مدائحي","ما نلت إلا صفقة المغبون",121,"ن",1,0],["ولو سعى نحوه وفدٌ لمصلحةٍ","تبشر الوفدَ منه طلعة البشر",122,"ر",1,0],["وَلَو سِرتَ حَتّى مَطلَعِ الشَمسِ لَم تَجِد","لِقَومٍ عَلى قَومي وَإِن كَرمُوا فَضلا",123,"ل",2,0],["وَلَو سَأَلتَ أَوِ اِستَنصَرتَ بَعَضَهُمُ","في جُلِّ أَمرِكَ ما آوَوا وَلا نَصَروا",124,"ر",3,0],["ولو سالمت سلمى لكنتُ بنانها","طواعيةً بل ربما كنتُ أطوعا",125,"ع",2,0],["ولو سلموا من مرهف السيف أو خلوا","بأنفسهم يولاً لأفناهم الرعب",126,"ب",1,0],["وَلَو سَلمت لَعادَت غَضة لَكُم","طرية تَستجد النُور وَالوَرقا",127,"ق",2,0],["ولو سئلت عظامي عن بِلاها","لانكرتِ البِلى وسمعت جَحدا",128,"د",2,0],["ولو سار مسراك القضاة بحكمهم","لما كان في لبنان مختلفان",129,"ن",1,0],["وَلَو سواهُ بعثتُ فيها","لَم تَحظَ نَفسي بما تَمَنَّت",130,"ت",1,0],["وَلَو سَحَر الأفلاكَ غيري بِحِكمَتِي","لَكَانَت مَشَاهِيرُ النُّجومِ حَبَايِبِي",131,"ب",2,0],["وَلَو سمتَ مِنها لَحظَ مُقلَةِ طَرفِها","لما عُدتَ لِي في ذا المَلامِ مُرَدِّدا",132,"د",2,0],["ولو ساعة في الزمان الطويل","وإن أوشكت ساعة أن تزولا",133,"ل",2,0],["ولو سَمَحَتْ أرض العراق بمُسكةٍ","تَرَفَّهْتُ عن جَيْ وأَكلِ قديدها",134,"د",3,0],["ولو سكَن الغرامُ لهم قلوباً،","أو اقتدحَ الهوى فيهم زِنادا،",135,"د",2,0],["وَلَو سَفرت أغنى عَن الحُجب نورها","يُناجي فَمَ الجوزاء لسان منارها",136,"ه",2,0],["وَلَو ساجلته السُحب في مَسقط النَدى","لَجَفت عزاليها وَكانَ لَهُ القَطر",137,"ر",1,0],["وَلَو سَمعت بِهَيبته الضَواري","لَجاوَرت السَباسب وَالجِبالا",138,"ل",2,0],["وَلَو سحت يَداه في فَضاء","لَضاقَ بِمائِهِ الوادي وَسالا",138,"ل",2,0],["ولو ساحر يدعو بأسماء لحظه","لأغناهُ عن اسم به ظلّ يسحرُ",139,"ر",1,0],["ولو سيم الفدا رخصت وهانت","نفوس كان يغليها الفداء",140,"ا",2,0],["ولو سكت عن عيوب الناس","لم تفتضح في اعين الجلاس",141,"س",1,0],["ولو سرت بثناه عند ريح صبا","لاستنشقوا من شذاها أطيب الأرج",142,"ج",1,0],["ولو سلَّمَتْ ليلى غَداةَ لَقِيتُها","بسفح اللِّوى كادت لها النفس تخشع",143,"ع",1,1],["ولو سلوت لنفسي عن طلابِ غنىً","لما سلوتُ لأتباعي وأشياعي",144,"ع",2,1],["وَلَوسالَ عَنكَ الغائِبينَ اِبنُ مُنذِرٍ","لَقالوا لَهُ القَولَ الَّذي لا يُحاذِرُه",145,"ر",2,0],["وَلو سَاءَلتِ عن حَسَبي نِزاراً","لقالوا ذاك في الحَسَبِ التَّليدِ",146,"د",1,0],["وَلَو سَأَلَت سَراةَ الحَيِّ عَنّي","عَلى أَنّي تَلَوَّنَ بي زَماني",147,"ن",2,0],["ولو سامني خلي الوفود على فنى","سواك ولو أغنى تبرأت من خلي",148,"ل",2,0],["وَلَو سَمَوتِ لِذاتِ الرّملِ سافِرَةً","بِسَفحٍ دَمَّرَ أَو في هامَةِ الهامي",149,"م",2,0],["وَلَو سَلِمَت لَهُ يُمنى يَدَيهِ","لَعَمرُ أَبيكَ أَطعَمَهُ السِباعا",150,"ع",2,0],["ولو سرت نسمات الروض حاذر أن","تعود تاركة في خدها أثرا",151,"ر",2,0],["ولو سبقَ الرسولُ لكان سعيي","إليك ينوب عن طول الكلام",152,"م",1,0],["ولو سحاب عطاياه التي وكفت","دارت على دول الدنيا رحى القطب",153,"ب",1,0],["وَلَو سَكت الشَيوخ لَعدتَ تَلقى","غَيا الصبيان مَدحاً مسترَقّا",154,"ق",2,0],["وَلَو سَلأَت صُروف الدَهر جسمي","فاني عَنكَ اَبقى غَير سالِ",155,"ل",1,0],["وَلَو ساعَدَ الجَدُّ العُثورُ بِمِنيَتي","لِما كُنتَ عَن لُقيا الأَحِبَّة مُقعَدا",156,"د",2,0],["ولو سرت صاحت ملوك البلا","د بين يدي النفير النفيرا",157,"ر",2,0],["ولو سومحتُ في عُمُري","لجَلَّ لديهمُ خطرُك",158,"ك",1,0],["ولو سالت لرقتها طباع","لأفعمنا برقتك الزجاج",159,"ج",1,0],["ولو سفرت لجللها سناها","فتحجب بالسفور عن السفور",160,"ر",1,0],["ولو سليمان حبته بها","بلقيسه ما كان بالكالح",161,"ح",1,0],["ولو سارق الأشعار حز لسانه","كما سارق الأموال حز يمينه",162,"ن",2,0],["ولو سمعتْهُ عُصْمُ طودٍ أمالها","فأَنزلَ منها العُصْمَ من كلِّ منزل",163,"ل",1,0],["وَلَو سَمَا بِها لِضَربِ قَيصَرٍ","لَسَامَهُ قَسراً بِها ضَربَ الجِزَى",164,"ا",1,0],["وَلَو سَما خَليفَةُ اللَهِ لَهَا","لافتَكَّهَا بالسيفِ مِنهُم وافتَدَى",164,"ا",1,0],["ولو سقيت دمي ودمي حرام","لكان لحسن منطقها حلالا",165,"ل",2,0],["ولو سبقتني سادةٌ جلّ قدرُهُم","وما حسُنَت منّي مجاوَزَةُ القدرِ",166,"ر",1,0],["ولو سكنت بي لاسترحنا معا ولم","تحرك بشكواي اللسان الدوائر",167,"ر",1,0],["ولو سقت القلوب وجدتها لم","تسر الا جموحا او حرونا",168,"ن",2,0],["ولوسيل سحاب الوقت نجمه وانطفت بيديك","حبيبي لا يسيل النور من عينك وتبكيني",169,"ن",2,0],["ولو سألناكم من وردها نهلاً","لرد يشكو الصدى النهر ساقينا",170,"ن",2,0],["ولو سألني شيخ عنك إنت من بد الرجال","والله لبكي من لهيبي شوق وهمس له أبيك",171,"ك",1,0],["وَلَوْ سُئِلَ الْعُشَاقُ عَنْ سِرِّ عِشْقِهِمْ","لَسَاْلَتْ دُمُوْعُ الْعَيْنِ تَحْكِيْ، وَتَشْرَحُ!",172,"ح",1,0],["ولو سِرْتَ وحدَك في مَهْمَهٍ","تراهُ وراءكَ يَقفو خُطاكا",173,"ك",2,0],["وَلَو سايَرْتُهُ طَوعاً وَكُرْهاً","لِأَوْجَعَني بِدَقّاتِ الضَّريبِ",174,"ب",1,0],["ولو سَبقتِ بيومٍ شَمْسَ أندَلُسٍ","لما تَذَكَّرَها في الأصلِ زَيدونُ",175,"ن",1,0],["وَلَوْ سَمِعَ الشَّبَابُ أَنِينَ كَهْلٍ","لَعَاشُوا فِي الشَّبَابِ كَمَنْ أَشَابَا",176,"ب",2,0],["ولو سُلّم الإبداع ظلما إليهمُ","تراءى بليدا لا يُشادُ له حظُّ",177,"ظ",1,0],["ولوسمعوا عذابات الحنايا","أغضوا الطرف عن عمدٍ تعاموا",178,"م",3,0],["ولوٍ سمعها ميّت من دهر شداد","قام وتنبه كنّه من رقادي",179,"د",2,0],["ولو سمع الجحود حديث هذا","لرق له وآمن ثم أسلم",180,"م",1,0],["وَلَوْ سَمِعَتْ أُسْدُ العَرِينِ بِبأْسِهِ","وَسَطْوَتِهِ تَحْتَ العَجاجِ لَوَلَّتِ",181,"ت",1,0],["ولو سَمعَ الشّكاوَى في المَواني","لعادَ لنا ولَو سَهُلَ العُبورُ",182,"ر",1,0],["ولوسقته ديار المسلمين .. نما","بين القفار أزاهيراً وريحانا",183,"ن",2,0],["وَلَوْ سَارَتْ طُيُوفُكِ فَوْقَ أَرْضٍ","لَقَبَّلْتُ الطُّيُوفَ مَعَ التُّرَابِ",184,"ب",1,0],["ولو سالت بأبطحها، قليلٌ","فدَينُ السالفينَ يجرُّ دَيْنا",185,"ن",2,0],["ولو سقطتُ الهوى جناحي","ولو غُلِبتُ الزمان ُجُندي",186,"د",2,0],["ولو ساد الصبورُ بغير حلمٍ","إذن لاقتادَ قائدهُ الحمارُ",187,"ر",1,0],["ولو سَفَكَة ْ يداهُ دَم ابنَ عمِّي","أو ابني لَمْ أُثِرْهُ وَلَمْ أَعَادِهْ",188,"د",2,0]]}