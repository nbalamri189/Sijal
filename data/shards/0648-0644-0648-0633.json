6.html","الطويل"],[163,"دعوني فما مما يكلفني بد","https://www.aldiwan.net/poem58839.html","الطويل"],[163,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[172,"تخفي الصبابة والألحاظ تبديها","https://www.aldiwan.net/poem1690.html",""],[184,"ألا حبذا الماء الذى قابل النقا","https://www.aldiwan.net/poem58752.html","الطويل"],[188,"لعل زماني بالعذيب يعود","https://www.aldiwan.net/poem14502.html","الطويل"],[188,"ألا ليت صبري لم يبن مثلما بانوا","https://www.aldiwan.net/poem14689.html","الطويل"],[192,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[201,"طرة ليل فوق صبح مبين","https://www.aldiwan.net/poem51878.html","السريع"],[232,"وخمر ترشفت سلسالها","https://www.aldiwan.net/poem50882.html","المتقارب"],[232,"نجوم سعودك لا تفتر","https://www.aldiwan.net/poem51053.html","المتقارب"],[232,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[262,"كعوب تردت ببرد الجمال","https://www.aldiwan.net/poem35558.html","المتقارب"],[264,"عقبى مدى الهم أولي غاية الفرج","https://www.aldiwan.net/poem38354.html","البسيط"],[274,"سقاك خيام الغور صوب الحيا عهدا","https://www.aldiwan.net/poem52068.html","الطويل"],[283,"أمد الله ظلك يا سعيد","https://www.aldiwan.net/poem60568.html","الرمل"],[351,"أيذل رسلي في اقتضاء وعوده","https://www.aldiwan.net/poem19891.html","الطويل"],[351,"تخلو همومي بي وأخلو بها","https://www.aldiwan.net/poem20022.html","السريع"],[367,"أقلا عند طيتي المقالا","https://www.aldiwan.net/poem60808.html","الوافر"],[369,"وحوشي أن يقال لها عتابي","https://www.aldiwan.net/poem17143.html","الوافر"],[369,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[369,"لمن والليالي غير معتبة الفتى","https://www.aldiwan.net/poem17742.html","الطويل"],[383,"سرى البرق في الأفق الشمالي معتنا","https://www.aldiwan.net/poem48756.html","الطويل"],[399,"ألا حي سلمى في الخليط المُفارق","https://www.aldiwan.net/poem602.html",""],[409,"سقى دمعي الأحبة حيث ساروا","https://www.aldiwan.net/poem50161.html","الوافر"],[412,"ما أنصفوا في الحب إذ حكموا","https://www.aldiwan.net/poem32534.html","السريع"],[440,"أشاقتك من أطلال ليلى معالم","https://www.aldiwan.net/poem2587.html","الطويل"],[442,"أهلي قد أنى لك أن تهلي","https://www.aldiwan.net/poem34788.html","الوافر"],[444,"حقيق إن بكيت دماً حقيق","https://www.aldiwan.net/poem14382.html","الوافر"],[460,"جرت لها ببابلٍ يمينا","https://www.aldiwan.net/poem55838.html","الرجز"],[460,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[460,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[484,"نسيم الصبا عنعن وسلسل بنافح الت","https://www.aldiwan.net/poem24378.html","عموديه"],[569,"أخ لي كنت أغبط باعتقاده","https://www.aldiwan.net/poem69712.html","الكامل"],[569,"بكاء وقل غناء البكاء","https://www.aldiwan.net/poem69825.html","الطويل"],[728,"","https://poetry.dctabudhabi.ae/diwan/poem/84967","الطويل"],[765,"","https://poetry.dctabudhabi.ae/diwan/poem/31499","الطويل"],[792,"","https://poetry.dctabudhabi.ae/diwan/poem/29562","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/28060","الطويل"],[848,"","https://poetry.dctabudhabi.ae/diwan/poem/18038","البسيط"],[1015,"","https://poetry.dctabudhabi.ae/diwan/poem/21219","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/31525","الوافر"]],"verses":[["وَلَو سأَلَتْ نُجومَ اللَّيلِ عَنّي","لَخَبَّرها بِما أَلقَى النُّجومُ",0,"م",1,0],["وَلَو سأَلَتْنِي غَيرَهُ لَرَجَعتُها","بِهِ فالهَوى لِلمالِكيَّةِ أَجمَعُ",1,"ع",1,0],["وَلَو سادوا وَاِستَجَدّوا لِلسَخا ال","مَنسوخِ طاسِم رَسمِهِ المَدروسِ",2,"س",1,0],["وَلَو سَعى غَيرُهُ فيها لِيَرأَبَها","أَنامَهُ المُقعِدانِ العَجزُ وَالتَعَبُ",3,"ب",1,0],["وَلَو سَكَتَّ وَلَم تَخطُب إِلى عَرَبٍ","لَما نَبَستَ الَّذي تَطويهِ مِن سَبَبِك",4,"ك",1,0],["ولو سلبتنيه الحوادث في الدنى","لما عشت أو مارمت عيشاًبدونه",5,"ن",2,0],["ولو ساروا على طرق انفراد","لما كانوا سوى هَمَجَ رعاع",6,"ع",1,0],["ولو سَبَر الناس الحوادث بالنهي","لما حصلوا منها على غير مضحك",7,"ك",1,0],["وَلَو سارَ الزُبَيرُ فَحَلَّ فينا","لَما يَئِسَ الزُبَيرُ مِنَ الإِيابِ",8,"ب",1,0],["وَلَو سَدَّ غَيري ماسَدَدتُ اِكتَفوا بِهِ","وَما كانَ يَغلو التِبرُ لَو نَفَقَ الصُفرُ",9,"ر",1,0],["وَلَو سُئِلَت بَدرٌ بِحُسنِ بَلائِنا","فَأَثنَت بِما فينا إِذاً حُمِدَت بَدرُ",10,"ر",1,0],["ولو سمته ردّ الشباب لردّه","عليَّ وقد مرَّت عليَّ سوافي",11,"ف",2,0],["ولو سُئلنا لقلنا الفقرُ فاقِرةٌ","لكنَّ أعظمَ منه حسرةُ الحَرَبِ",12,"ب",1,0],["ولو سام سَوْمَ اللهو قامت بلهوه","فِصاحٌ بأيديهن خُرْسٌ تَكلَّمُ",13,"م",1,0],["ولو سامني ذاك الوزيرُ أبيتُهُ","وأنكرتُهُ النُّكرَ الذي هو صارمُ",14,"م",1,0],["ولو سَخِطَ امرؤ يُولَى جميلاً","سَخِطتُ وحُقَّ لي مِمَّا اعتلاني",15,"ن",2,0],["وَلَو سُئِلَت عَنّي أُمَيَّةُ أَخبَرَت","لَها بِأَخٍ حامي الذِمارِ نَصورِ",16,"ر",1,0],["ولو سئل الإسلام ماذا يريده","لما اختار إلا ان تديما التلاقيا",17,"ي",2,0],["وَلَو سَها قَوادهُ وَآلُهُ","لَقَلَّدَ العَهدَ عَليّ بِن الرِضا",18,"ا",1,0],["وَلَو سُقِّيتُها بِيَدي نَديمٍ","أَسَرُّ بِهِ لَكانَ أَبا ضَبيسِ",19,"س",1,0],["وَلَو سِرنا إِلَيهِ في طَريقٍ","مِنَ النيرانِ لَم نَخَفِ اِحتِراقا",20,"ق",2,0],["وَلَو سَلَكَت طُرقَ السِلاحِ لَرَدَّها","بِطولِ يَمينٍ وَاِتِّساعِ جَنانِ",21,"ن",1,0],["وَلَو سَمِعَ الدَهرُ العِتابَ بِمَنطِقٍ","لَأَوجَعتُهُ مِنّي بِحَدِّ المُعاتِبِ",22,"ب",1,0],["وَلَو ساعَدَت سُعدى عَلى الحُبِّ ذا هَوى","أَبَت قَولَ واشيها وَعاصَت عَذولَها",23,"ل",3,0],["وَلَو سيقَتِ الدُنيا إِلَيهِ بِأَسرِها","وَلَم يَتلُها حَمدٌ لَعافَ قَبولَها",23,"ل",3,0],["وَلَو سَأَلَت عَنّي سُوَيدَةُ أُنبِئَت","إِذا كانَ زادُ القَومِ عَقرَ الرَكايِبِ",24,"ب",1,0],["وَلَو سَيَّرتُمُ فيمَن أَصابَت","عَلى القَسِماتِ أَظفاري وَنابي",25,"ب",2,0],["وَلَو سُؤِلَت مَن كُفُؤُ الشَمسِ أَومَأَت","إِلى اِبنَي مَنافٍ عَبدِ شَمسٍ وَهاشِمِ",26,"م",1,0],["وَلَو سُؤِلَت مَن كُفأُنا الشَمسُ أَومَأَت","إِلى اِبنَي مَنافٍ عَبدِ شَمسٍ وَهاشِمِ",27,"م",1,0],["وَلَو سُؤِلَت عَنّي النَوارُ وَقَمُها","إِذاً لَم تُوارِ الناجِذَ الشَفَتانِ",28,"ن",1,0],["وَلَو سَلَبَتهُ الحَربُ مِنّي لَشاهَدَت","كَما شاهَدَت في ثارِ أَخوالِهِ مِنّي",29,"ن",2,0],["ولو سطا قادراً عليه","لم يبُقِ للطيرِ فيه شِلوا",30,"و",2,0],["وَلَو سُلَّ روحي مِن عُروقي لَرَدَّهُ","إِلَيَّ رُضابٌ مِن ثَناياكِ سِلسالُ",31,"ل",1,0],["وَلَو سَلَكَ الناسُ في جانِبٍ","مِنَ الأَرضِ وَاِعتَزَلَت جانِبا",32,"ب",2,0],["وَلَو سُئِلَت بِنا البَطحاءُ قالَت","هُمُ أَهلُ الفَواضِلِ وَالسُيوبِ",33,"ب",1,0],["ولو سُرِقُوا أنسابَهم يومَ فخرِهم","ونَزْوَتِهِمْ ما جاز في مِثلها القَطع",34,"ع",1,0],["وَلَو سَكَنَت جِبالَ الأَرضِ روحٌ","لَما خَلَدَت نَضادِ وَلا أَرابُ",35,"ب",1,0],["وَلَو سَأَلوهُ بِالَّذي فَوقَ صَدرِهِ","لَجاءَ بِمَينٍ أَو أَرَمَّ وَجَمجَما",36,"م",2,0],["ولو سَمِعَتْ كلامَكَ بُزْلُ شَوْلٍ","لعادَ هَديرُ بازِلِها فَحيحا",37,"ح",2,0],["وَلَو سَأَلَت مِنّي حَياتي بَذَلتُها","وَجدتُ بِها إِن كانَ ذَلِكَ مِن أَمري",38,"ر",2,0],["ولو ساد في الأرض عدلُ السماءِ","لعاش الأنام بها سعداء",39,"ا",2,0],["ولو سقى الشمس من أحزانه نديت","على هجير الضّحى حبّا وتحنانا",40,"ن",2,0],["ولوْ سُئِلتْ من كُفؤُ الشمس أوْمأتْ","إلى ابْنَيْ مَنَافٍ عَبدِ شَمسٍ وَهاشِمِ",41,"م",1,0],["ولَوْ سُئِلَتْ عَني النَّوَارُ وَقَوْمُهَا،","إذاً لمْ تُوَارِ النّاجِذَ الشّفَتَانِ",42,"ن",1,0],["وَلَو سَعى جُهدَهُ المَعروف مُختَبِراً","لَم يَلف غَيرَك في الدُنيا فَيألفهُ",43,"ف",2,0],["ولو سمعت أذني لصوتك نغمة","لما طربت يوماً لصوت شدا ليا",44,"ي",2,0],["ولَو سَوَّدتُمُوهُ مُبَارَكِيًّا","أشَمَّ بِكُلِّ مَحمَدَةٍ كَفِيلا",45,"ل",2,0],["وَلَو سِواكَ وَكَلّا كانَ وارِدَهُ","لَما عَدَوتُ بِهِ الإِكدارَ وَالزَبَدا",46,"د",2,0],["وَلَو سَمَحتِ بِلُقيا الطَّيفِ عِشتُ بِهِ","دَهراً وَإِن هِمتُ بَعدَ العَينِ بِالأَثَرِ",47,"ر",1,0],["ولو سبكوا شخصاً جميعاً لما وفوا","يقينا لما يأتي ولا قاربوا الشكا",48,"ك",2,0],["ولو سألتني مهجتي لو هبتها","وقلت افعلي بي ما تحبين يا هند",49,"د",1,0],["ولو سمعوا ما عنه يقرا لديكم","لكفره الاجماع منهم وكذبوا",50,"ب",3,0],["ولو سمعوا من قال خاطب ربنا","لكانت رؤوس بالصوارم تضرب",50,"ب",1,0],["وَلَو سِواكَ دَعاني لَم أُلَبِّ لَهُ","صَوتاً وَلا قامَ في ناديهِ شادِيها",51,"ي",3,0],["وَلَو سَأَلَت للنَّاسِ يَوماً بِوَجهِها","سَحابَ الثُّرَيّا لاستَهَلَّت مَواطِرُه",52,"ر",2,0],["ولو سَكتوا قامتْ مَعاليك شاعرا","فصيحاً له بين الأَنام نشيد",53,"د",1,0],["ولو ساعدتْني عزمةٌ من جناحِه","ليَمَّمتُ أحبابي بها حيثُ ما كانوا",54,"ن",3,0],["وَلَو سألَ الأشياخَ أدرك سرّه","وَلكنّه مع جهلهِ قَد حَوى كِبرا",55,"ر",2,0],["ولو سِوَى مَنْظَرِهِ راقني","لألاؤُهُ كنتُ من الخاسرين",56,"ن",1,0],["ولو ساسها أَحدٌ غَيْرُه","لأخرجتِ الأَرض أَثقالها",57,"ل",3,0],["ولو سَحَرَتْ أَرْبُعٌ قبلَه","لكان البديعَ الذي يَسحَر",58,"ر",1,0],["ولو سَرَتْ ما بقِيَتْ لم تُجْهَدِ","من المراسيل العِتَاق الوُخَّد",59,"د",1,0],["ولو سال دمعي بها جدولاً","فما أنا عنها لعمري بسال",60,"ل",1,0],["ولو سوى مدح إبراهيم يلزمني","شببت فيه بأنواع من الهزج",61,"ج",1,0],["وَلَو سير الاجبال سارَت وان دَعا","ذرى صخرة لبت له الصخرة الصلدا",62,"د",2,0],["وَلَو سار فَوقَ البحر أَو طارَ في الهَوا","لامكنه وَالحق ما جاوز الحدا",62,"د",2,0],["وَلَوْ سَجَدَ الوَرَى لأَبَرِّ خَلْقٍ","يَداً وَنَدىً لَحُقَّ لَكَ السُّجُودُ",63,"د",1,0],["وَلَوْ سَارَ وَمْضُ البَرْقِ والرِّيحُ عِنْدَهُ","لَكَلاَّ وَكَلاَّ لَيْسَ يُدرِكُ كاذِبُ",64,"ب",1,0],["وَلوْ سَأَلْتَ اللَّيلَ عَن صُبحهِ","لَقَالَ أَلْهَتْهَ الوُجُوهُ الصِّباحْ",65,"ح",1,0],["ولو سلَختْ لنا في الشّرْقِ شَهْراً","سَبقْنَ بنا إلى الغَرْبِ الهلالا",66,"ل",2,0],["ولو سقط التفاضلُ في عقولٍ","لَكَانَ الناسُ كُلُّهُمُ سَواءَ",67,"ا",2,0],["وَلَو ساجَلَت غُرُّ الغَمائِمِ أَدمُعي","تَبَيَّنَ عَن قُربٍ غُرورُ الغَمائِمِ",68,"م",1,0],["وَلَو سَمِعَت أَو لَم تَدَبَّرَ أَهلُها","عِتابي لَكانَ البَحرَ فيهِ العَجائِبُ",69,"ب",1,0],["وَلَو سيقَت الدُنيا إِلَيَّ جَميُعها","بِغَير وِداد ما رَفَعَت لَها جِفنا",70,"ن",2,0],["ولو سألت عنا سليمى لخبرت","إذا الحجرات زينت بالمغالِق",71,"ق",1,0],["وَلَو سادَ الصَبور بِغَيرِ حلم","إِذاً لاقتادَ قائِدَه الحِمارُ",72,"ر",1,0],["ولو سَعَى الطّيفُ بِهِ في الكَرَى","لَقيلَ هذا المُنْزَلُ المُحكَمُ",73,"م",1,0],["ولو سئّلت أرض الفرنج شهادة","أجابتكم صيدا ويافا وحارم",74,"م",1,0],["ولو سَمِ جَدُّكَ المنصورُ أدعُو","إِلَيْهِ لَمَ يَسُمْني سَوْمَ مَطْلِ",75,"ل",1,0],["ولو سلمى أقل البعض منها","تهدم من ذراه وهو نيق",76,"ق",1,0],["ولو سبرتُ الناسَ أو أعلقتُها","مُزرّعيّاً عَلِقتْ مَتينا",77,"ن",2,0],["ولو سلم ابنُ أيّوب ولمّا","يَحُلْ سلِمَ البقاءُ من الحِمامِ",78,"م",1,0],["ولو ساعد الشوقَ طَولٌ إليك","طلعتُ به خيرَ مستطلَعِ",79,"ع",1,0],["ولو سيروا فلكا تسير بهم على","متون ظهور أو بطون على البحر",80,"ر",1,0],["ولو سَفَكَتْ يداهُ دَمَ ابن عمِيِّ","أو إنني لم أتِرْهُ ولم أُعَادِهْ",81,"د",2,0],["ولو سَلَموا لإمامِ الهُدَى","لقُوبِلَ مُعوجُّهم باستواء",82,"ا",2,0],["ولو سئلت عنا جنوب لأخبرت","عشية سالت عقرباء وملهم",83,"م",1,1],["وَلَو سَمِعوا مِنهُم دُعاءً يَروعُهُم","إِذا لَأَتَتهُ الخَيلُ أَعيُنُها قُبلُ",84,"ل",1,0],["وَلَو سامَني الماني مَكانَ حَياتِهِ","أَناعيمَ دَهرٍ مِن عِبادٍ وَجامِلِ",85,"ل",1,0],["وَلَو سِرتَ حَتّى مَطلَعِ الشَمسِ لَم تَجِد","لِقَومٍ عَلى قَومي وَإِن كَرمُوا فَضلا",86,"ل",2,0],["وَلَو سَأَلتَ أَوِ اِستَنصَرتَ بَعَضَهُمُ","في جُلِّ أَمرِكَ ما آوَوا وَلا نَصَروا",87,"ر",3,0],["وَلَوسالَ عَنكَ الغائِبينَ اِبنُ مُنذِرٍ","لَقالوا لَهُ القَولَ الَّذي لا يُحاذِرُه",88,"ر",2,0],["وَلَو سَلِمَت لَهُ يُمنى يَدَيهِ","لَعَمرُ أَبيكَ أَطعَمَهُ السِباعا",89,"ع",2,0]]}