{"poems":[[53,"أيها السيد الذي جل عن شكري","https://www.aldiwan.net/poem66516.html","الخفيف"],[87,"بدأ الطيف بالجميل وزارا","https://www.aldiwan.net/poem7774.html","الخفيف"],[87,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[99,"أمل ضائع ولب مشرد","https://www.aldiwan.net/poem24804.html","الخفيف"],[50,"هل عرفت الربع أجلى","https://www.aldiwan.net/poem65035.html","مجزوء الرمل"],[333,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[376,"ما لريم الكناس ليس يريم","https://www.aldiwan.net/poem57152.html","الخفيف"],[385,"مدمع بات يسفح","https://www.aldiwan.net/poem49237.html","مجزوء الخفيف"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124040","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119956","السريع"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35367","الرمل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127381","الرمل"],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139843",""],[709,"ضربوا القبابَ وطنّبوها بالقنا","https://www.poetsgate.com/ViewPoem.aspx?id=2906",""],[5725,"طرفك","https://www.poetsgate.com/ViewPoem.aspx?id=177418",""]],"verses":[["ما لِرزْقي كأن على البِي","ضِ تَخَطِّيهِ مِن تباطيه عَنِّي",0,"ن",2,0],["ما لربِّ الجمال جار على القل","ب كأن لم يكن له القلب جارا",1,"ر",2,0],["ما لِروحي صاعِداً ما يَنتَهي","أَتُراهُ آثَرَ الجَوَّ فَراما",2,"م",2,0],["مال ركنٌ من السماء وأمسى","هلهلَ النسج كلُّ صَرحٍ مُمرَّد",3,"د",1,0],["ما لِرِجلِ المالِ أَمسَت","تَشتَكي مِنكَ الكَلالا",4,"ل",2,0],["ما لرجليّ تشردان عن النهج","كاني مشرّدٌ يستجدى",5,"د",2,0],["ما لِريمِ الكِناسِ ليسَ يَريمُ","أتُراهُ مُستَشعِراً ما يَرُومُ",6,"م",1,1],["ما لِراجي وِصالَهُ","أَمل فيهِ يَنجَح",7,"ح",1,0],["ما لراجي الخلود نيل الخلود","إن ورد المنون حتم الورود",8,"د",1,1],["ما لروض مطلول بكى شجوه","فيه الحيا وابتسم الأقحوان",9,"ن",1,0],["ما لِريفي لَم يَجُد بَطحاءَهُ","عارِضٌ مِن راحَتَيكَ اِنبَجَسا",10,"س",2,0],["ما لروحي ألفت سكنى السجون","وهي نور كيف تهوى الظلمات",11,"ت",1,0],["ما لريم الفلاة عيناه والجي","د ولكن توهم المدعونا",12,"ن",2,0],["مالروحُ منذُ رحلتَإلا مهجة","ُ بِكَ تُيِّمَتْ فَخُفُوقُهَا لَنْ يَسْكُنَا",13,"ن",2,0],["مالروحي عن هواكم سلوةٌ","كلما اصْرمْتٓ قالتْ هيتٓ لكْ",14,"ك",1,0]]}