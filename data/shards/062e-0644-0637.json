{"poems":[[53,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[53,"خلطوا الصوارم بالقنا وتعمموا","https://www.aldiwan.net/poem30083.html","الكامل"],[53,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[55,"خلط الله بروحي روحها","https://www.aldiwan.net/poem26386.html","الرمل"],[83,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[72,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[62,"خلطنا بتركيبنا غيره","https://www.aldiwan.net/poem52212.html","المتقارب"],[45,"أحرام أن ينجز الموعود","https://www.aldiwan.net/poem63501.html","الخفيف"],[61,"لا تصغين إلى مقال سفيه","https://www.aldiwan.net/poem51401.html","الكامل"],[61,"فرقت بين جفونه ورقاده","https://www.aldiwan.net/poem51712.html","الكامل"],[2,"لمن الديار غشيتها بالفدفد","https://www.aldiwan.net/poem25034.html","الكامل"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[19,"حلًت تماضر بعدنا رببا","https://www.aldiwan.net/poem322.html",""],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20993","الخفيف"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2231","الكامل"],[115,"صبرا امي فذي الشخوص خيال","https://www.aldiwan.net/poem40634.html","عموديه"],[132,"يا شيخ من أوصيتم بضيافتى","https://www.aldiwan.net/poem54866.html","الكامل"],[143,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[143,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[235,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[250,"كيف حالت بعد الوفاء عهوده","https://www.aldiwan.net/poem14946.html","الخفيف"],[275,"ما بسيط الحياة إلا وجيز","https://www.aldiwan.net/poem25401.html","الخفيف"],[364,"زمان قليل من بنيه نجيب","https://www.aldiwan.net/poem60998.html","الطويل"],[371,"تبيت أحاديث الهوى لك تفتري","https://www.aldiwan.net/poem57453.html","الطويل"],[406,"ذكر الحمى فبكى لسجع حمامه","https://www.aldiwan.net/poem50115.html","الكامل"],[409,"إذا ضاق بالخطي معترك الوغى","https://www.aldiwan.net/poem32163.html","الطويل"],[409,"ليس طرفي جارا لقلبي ولكن","https://www.aldiwan.net/poem32616.html","الخفيف"],[453,"ست من السنوات جاوز عمرها","https://www.aldiwan.net/poem61591.html","الكامل"],[458,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[458,"لها بعد خطو لات حين مراح","https://www.aldiwan.net/poem56257.html","الطويل"],[514,"خلط الغرام الشجو في أمشاجه","https://www.aldiwan.net/poem20829.html","الكامل"],[551,"من ذا يؤمل بعدك الأياما","https://www.aldiwan.net/poem47233.html","الكامل"],[551,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[553,"وقفتني على نداك الظنون","https://www.aldiwan.net/poem68378.html","الخفيف"],[553,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[554,"من مبلغ عني سنانا رسالة","https://www.aldiwan.net/poem1849.html","الطويل"]],"verses":[["خَلَطتُ بِمَنسِمِها في الثَرى","عَلى الرَكضِ ميسَمَ أَيدي النَعامِ",0,"م",1,0],["خَلَطوا الصَوارِمَ بِالقَنا وَتَعَمَّموا","بِالبيضِ وَاِجتابوا العَجاجَ دُروعا",1,"ع",2,1],["خَلَطوا الضَيفَ بِالنُفوسِ عَلى العُس","رِ وَباتوا عَلى السَماحِ غَيارى",2,"ر",2,0],["خَلَطَ اللَهُ بِروحي روحَها","فَهُما في جَسَدي شَيءٌ أَحَد",3,"د",1,1],["خُلِطَ البياضُ بصفرة في لونه","فترى اللجين يشوب ذوب نُضارِ",4,"ر",1,0],["خلط الحمام عظامهم ولحومهم","حتى تساوى الدّرّ بالأحجار",5,"ر",1,0],["خَلَطوا صَليبَكَ وَالخَناجِرَ وَالمُدى","كُلٌّ أَداةٌ لِلأَذى وَحِمامُ",6,"م",1,0],["خلطنا بتركيبنا غيره","رماداً لطيفا وماء عتيدا",7,"د",2,1],["خَلَطَت هِجرَةً بِوَصلٍ فَفي القُر","بِ بِعادٌ وَفي الوِصالِ صُدودُ",8,"د",1,0],["خُلِطَتْ بها نُطَفُ السُّقاةُ فمَا يُطا","إلا على ابنِ سَفِيهةٍ وسفيهِ",9,"ي",2,0],["خلَطَ العَجاجةَ بالدِّماءِ كأنَّما","نُشِرَتْ مَجاسِدُه خِلالَ جِيادِه",10,"د",2,0],["خَلِطٌ أَلوفٌ لِلجَميعِ بَيتِهِ","إِذ لا يُحَلُّ بِحَيِّزِ المُتَوَحِّدِ",11,"د",1,0],["خَلَطَ الشَجاعَةَ بِالحَياءِ فَأَصبَحا","كَالحُسنِ شيبَ لِمُغرَمٍ بِدَلالِ",12,"ل",1,0],["خِلطُ وَشيٍ مِثلَ ما هَلهَلَت","ذاتُ أَصدافٍ نَؤورَ الوِشام",13,"م",1,0],["خَلَطَ العضساكِرَ بِالعَسا","كِرِ وَالقَنابِلَ بِالقَنابِل",14,"ل",1,0],["خَلَطَت إِذا ما السيرُ جَدَّ بِه","مَعَ لينِها بِمِراحِها غَضَبا",15,"ب",2,0],["خَلطَتهُ بآخَرٍ وبِبَانٍ","فَهوَ أَحَوى عَلَى اليَدَينِ شَرِيقُ",16,"ق",1,0],["خَلَطَت إِذا ما السيرُ جَدَّ بِها","مَعَ لينِها بِمِراحِها غَضَبا",17,"ب",2,0],["خلطوا السياسة بالفساد لجهلهم","فتباين الافعال والاقوال",18,"ل",1,0],["خلطوا طعامهم بحوت يابس","وأنا أعاف الحوت يوم خروجه",19,"ج",2,0],["خِلطَينِ مِن عَرَبٍ وَعُجمٍ طالَما","نُدِبوا لِصَرفِ النَائِباتِ فَأَسرَعوا",20,"ع",3,0],["خِلطانِ مِن حَضَرٍ وَبَدوٍ طالَما","لاقَوا إِلى مَجنوبِكَ الآلاما",21,"م",2,0],["خَلَطَ الحَماسَةَ بِالنَسيبِ فَقُل لَهُ","أَسلافُ خَمرٍ في كُؤوسِكَ أَم دَمُ",22,"م",1,0],["خَلِّ طرفي يذرى الدموعَ دماءً","بعد عيشٍ مَضَى فعزَّ وجودُه",23,"د",2,0],["خلطَةُ العالمين داءٌ دوِيٌّ","واعتزالُ الأشكال حرزٌ حريزُ",24,"ز",1,0],["خلطْنَ السُّرى بالسيرِ حتى وَردْنه","وأفنى بقايا متنِهنَّ دُؤوب",25,"ب",1,0],["خلَطتُ ببَردِ الليلِ بردَ رُضابِه","فأين به عنِّي إذا الهجرُ هجَّرا",26,"ر",2,0],["خلط الشَجاعَة بِالنَدى فَالرِزق","وَالآجالُ بَينَ بَنانِهِ وَحُسامِهِ",27,"م",2,0],["خلطتَ السّطا بالعَدلِ حتّى تألّفَتْ","أسودُ الشّرى والمُطفِلاتُ الرّوائِمُ",28,"م",1,0],["خُلطةٌ في تَبايُنِ الحالِ هذا","أبداً ظاهِرٌ وذَا محجوبُ",29,"ب",1,0],["خُلطت كأشلاء الحروبِ وليتها","دُفنت ولم تضحك على أشلائي",30,"ي",1,0],["خلَطت حُزْنا بتغريدٍ فما","فرَّق السمعُ أتبكي أم تُغنِّي",31,"ي",1,0],["خلطتُ التهاني بالتشاكي مُرجيِّاً","بموضعِ جِدّي أن يكون مزاحي",32,"ي",1,0],["خلطَ الغرامُ الشّجوَ في أمشاجِه","فبَكى فخِلْتُ بُكاهُ من أوداجِهِ",33,"ج",2,1],["خلطت مصيبتك الولاةَ ونظّرَتْ","بين الرّجال وسوّتِ الأقداما",34,"م",2,0],["خَلَطنا نُفوساً بالنفوسِ صبابةً","وَضاق اِعتناقٌ بيننا وتصافحُ",35,"ح",1,0],["خَلَطَتهُ الأَسى بِمَن ماتَ حَتّى","هَوَّنَت فَقدَهُ عَلِيَّ المَنونُ",36,"ن",1,0],["خَلَطنا دَماً مِن كَومَةٍ بِدِمائِنا","فَأَظهَرَ في الأَلوانِ مِنّا الدَمَ الدَمُ",37,"م",1,0],["خَلَطنا البُيوتَ بِالبُيوتِ فَأَصبَحوا","بَني عَمِّنا مَن يَرمِهِم يَرمِنا مَعا",38,"ع",2,0]]}