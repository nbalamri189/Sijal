{"poems":[[55,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[55,"خلطوا الصوارم بالقنا وتعمموا","https://www.aldiwan.net/poem30083.html","الكامل"],[55,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[57,"خلط الله بروحي روحها","https://www.aldiwan.net/poem26386.html","الرمل"],[85,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[74,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[87,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[64,"خلطنا بتركيبنا غيره","https://www.aldiwan.net/poem52212.html","المتقارب"],[47,"أحرام أن ينجز الموعود","https://www.aldiwan.net/poem63501.html","الخفيف"],[63,"لا تصغين إلى مقال سفيه","https://www.aldiwan.net/poem51401.html","الكامل"],[63,"فرقت بين جفونه ورقاده","https://www.aldiwan.net/poem51712.html","الكامل"],[2,"لمن الديار غشيتها بالفدفد","https://www.aldiwan.net/poem25034.html","الكامل"],[46,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[41,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[41,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[19,"حلًت تماضر بعدنا رببا","https://www.aldiwan.net/poem322.html",""],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20993","الخفيف"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2231","الكامل"],[119,"صبرا امي فذي الشخوص خيال","https://www.aldiwan.net/poem40634.html","عموديه"],[136,"يا شيخ من أوصيتم بضيافتى","https://www.aldiwan.net/poem54866.html","الكامل"],[147,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[147,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[240,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[255,"كيف حالت بعد الوفاء عهوده","https://www.aldiwan.net/poem14946.html","الخفيف"],[280,"ما بسيط الحياة إلا وجيز","https://www.aldiwan.net/poem25401.html","الخفيف"],[369,"زمان قليل من بنيه نجيب","https://www.aldiwan.net/poem60998.html","الطويل"],[376,"تبيت أحاديث الهوى لك تفتري","https://www.aldiwan.net/poem57453.html","الطويل"],[412,"ذكر الحمى فبكى لسجع حمامه","https://www.aldiwan.net/poem50115.html","الكامل"],[415,"إذا ضاق بالخطي معترك الوغى","https://www.aldiwan.net/poem32163.html","الطويل"],[415,"ليس طرفي جارا لقلبي ولكن","https://www.aldiwan.net/poem32616.html","الخفيف"],[458,"ست من السنوات جاوز عمرها","https://www.aldiwan.net/poem61591.html","الكامل"],[463,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[463,"لها بعد خطو لات حين مراح","https://www.aldiwan.net/poem56257.html","الطويل"],[519,"خلط الغرام الشجو في أمشاجه","https://www.aldiwan.net/poem20829.html","الكامل"],[556,"من ذا يؤمل بعدك الأياما","https://www.aldiwan.net/poem47233.html","الكامل"],[556,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[558,"وقفتني على نداك الظنون","https://www.aldiwan.net/poem68378.html","الخفيف"],[558,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[559,"من مبلغ عني سنانا رسالة","https://www.aldiwan.net/poem1849.html","الطويل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44612","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63738","السريع"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145950","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72285","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25340","الرجز"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18240","الرجز"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111176","الكامل"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128271","الخفيف"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96030","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53146","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53120","الكامل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46743","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204709","الوافر"],[2993,"","https://poetry.dctabudhabi.ae/diwan/poem/147741","المنسرح"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126280","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62891","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62875","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62825","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66532","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59453","الكامل"],[3893,"","https://poetry.dctabudhabi.ae/diwan/poem/114857","الوافر"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35549","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4176,"","https://poetry.dctabudhabi.ae/diwan/poem/96545","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81690","الكامل"],[4359,"","https://poetry.dctabudhabi.ae/diwan/poem/141158","الخفيف"],[4625,"","https://poetry.dctabudhabi.ae/diwan/poem/124112","الرمل"],[4764,"الليالي العقيمه","https://www.poetsgate.com/ViewPoem.aspx?id=32992",""],[5122,"(( روح هشه ))","https://www.poetsgate.com/ViewPoem.aspx?id=24264",""],[5183,"وقِّر العلم","https://www.poetsgate.com/ViewPoem.aspx?id=186456",""],[5183,"الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=186596",""],[5431,"على لسان ابليس!!....","https://www.poetsgate.com/ViewPoem.aspx?id=202708",""],[5431,"قلب قدسي","https://www.poetsgate.com/ViewPoem.aspx?id=213919",""],[5605,"استراحة فنية","https://www.poetsgate.com/ViewPoem.aspx?id=160695",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5732,"يا ناشد العراف","https://www.poetsgate.com/ViewPoem.aspx?id=177831",""],[5953,"يا دولة الحق كم تري تقف","https://www.poetsgate.com/ViewPoem.aspx?id=93850",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""]],"verses":[["خَلَطتُ بِمَنسِمِها في الثَرى","عَلى الرَكضِ ميسَمَ أَيدي النَعامِ",0,"م",1,0],["خَلَطوا الصَوارِمَ بِالقَنا وَتَعَمَّموا","بِالبيضِ وَاِجتابوا العَجاجَ دُروعا",1,"ع",2,1],["خَلَطوا الضَيفَ بِالنُفوسِ عَلى العُس","رِ وَباتوا عَلى السَماحِ غَيارى",2,"ر",2,0],["خَلَطَ اللَهُ بِروحي روحَها","فَهُما في جَسَدي شَيءٌ أَحَد",3,"د",1,1],["خُلِطَ البياضُ بصفرة في لونه","فترى اللجين يشوب ذوب نُضارِ",4,"ر",1,0],["خلط الحمام عظامهم ولحومهم","حتى تساوى الدّرّ بالأحجار",5,"ر",1,0],["خَلَطوا صَليبَكَ وَالخَناجِرَ وَالمُدى","كُلٌّ أَداةٌ لِلأَذى وَحِمامُ",6,"م",1,0],["خلطنا بتركيبنا غيره","رماداً لطيفا وماء عتيدا",7,"د",2,1],["خَلَطَت هِجرَةً بِوَصلٍ فَفي القُر","بِ بِعادٌ وَفي الوِصالِ صُدودُ",8,"د",1,0],["خُلِطَتْ بها نُطَفُ السُّقاةُ فمَا يُطا","إلا على ابنِ سَفِيهةٍ وسفيهِ",9,"ي",2,0],["خلَطَ العَجاجةَ بالدِّماءِ كأنَّما","نُشِرَتْ مَجاسِدُه خِلالَ جِيادِه",10,"د",2,0],["خَلِطٌ أَلوفٌ لِلجَميعِ بَيتِهِ","إِذ لا يُحَلُّ بِحَيِّزِ المُتَوَحِّدِ",11,"د",1,0],["خَلَطَ الشَجاعَةَ بِالحَياءِ فَأَصبَحا","كَالحُسنِ شيبَ لِمُغرَمٍ بِدَلالِ",12,"ل",1,0],["خِلطُ وَشيٍ مِثلَ ما هَلهَلَت","ذاتُ أَصدافٍ نَؤورَ الوِشام",13,"م",1,0],["خَلَطَ العضساكِرَ بِالعَسا","كِرِ وَالقَنابِلَ بِالقَنابِل",14,"ل",1,0],["خَلَطَت إِذا ما السيرُ جَدَّ بِه","مَعَ لينِها بِمِراحِها غَضَبا",15,"ب",2,0],["خَلطَتهُ بآخَرٍ وبِبَانٍ","فَهوَ أَحَوى عَلَى اليَدَينِ شَرِيقُ",16,"ق",1,0],["خَلَطَت إِذا ما السيرُ جَدَّ بِها","مَعَ لينِها بِمِراحِها غَضَبا",17,"ب",2,0],["خلطوا السياسة بالفساد لجهلهم","فتباين الافعال والاقوال",18,"ل",1,0],["خلطوا طعامهم بحوت يابس","وأنا أعاف الحوت يوم خروجه",19,"ج",2,0],["خِلطَينِ مِن عَرَبٍ وَعُجمٍ طالَما","نُدِبوا لِصَرفِ النَائِباتِ فَأَسرَعوا",20,"ع",3,0],["خِلطانِ مِن حَضَرٍ وَبَدوٍ طالَما","لاقَوا إِلى مَجنوبِكَ الآلاما",21,"م",2,0],["خَلَطَ الحَماسَةَ بِالنَسيبِ فَقُل لَهُ","أَسلافُ خَمرٍ في كُؤوسِكَ أَم دَمُ",22,"م",1,0],["خَلِّ طرفي يذرى الدموعَ دماءً","بعد عيشٍ مَضَى فعزَّ وجودُه",23,"د",2,0],["خلطَةُ العالمين داءٌ دوِيٌّ","واعتزالُ الأشكال حرزٌ حريزُ",24,"ز",1,0],["خلطْنَ السُّرى بالسيرِ حتى وَردْنه","وأفنى بقايا متنِهنَّ دُؤوب",25,"ب",1,0],["خلَطتُ ببَردِ الليلِ بردَ رُضابِه","فأين به عنِّي إذا الهجرُ هجَّرا",26,"ر",2,0],["خلط الشَجاعَة بِالنَدى فَالرِزق","وَالآجالُ بَينَ بَنانِهِ وَحُسامِهِ",27,"م",2,0],["خلطتَ السّطا بالعَدلِ حتّى تألّفَتْ","أسودُ الشّرى والمُطفِلاتُ الرّوائِمُ",28,"م",1,0],["خُلطةٌ في تَبايُنِ الحالِ هذا","أبداً ظاهِرٌ وذَا محجوبُ",29,"ب",1,0],["خُلطت كأشلاء الحروبِ وليتها","دُفنت ولم تضحك على أشلائي",30,"ي",1,0],["خلَطت حُزْنا بتغريدٍ فما","فرَّق السمعُ أتبكي أم تُغنِّي",31,"ن",2,0],["خلطتُ التهاني بالتشاكي مُرجيِّاً","بموضعِ جِدّي أن يكون مزاحي",32,"ح",2,0],["خلطَ الغرامُ الشّجوَ في أمشاجِه","فبَكى فخِلْتُ بُكاهُ من أوداجِهِ",33,"ج",2,1],["خلطت مصيبتك الولاةَ ونظّرَتْ","بين الرّجال وسوّتِ الأقداما",34,"م",2,0],["خَلَطنا نُفوساً بالنفوسِ صبابةً","وَضاق اِعتناقٌ بيننا وتصافحُ",35,"ح",1,0],["خَلَطَتهُ الأَسى بِمَن ماتَ حَتّى","هَوَّنَت فَقدَهُ عَلِيَّ المَنونُ",36,"ن",1,0],["خَلَطنا دَماً مِن كَومَةٍ بِدِمائِنا","فَأَظهَرَ في الأَلوانِ مِنّا الدَمَ الدَمُ",37,"م",1,0],["خَلَطنا البُيوتَ بِالبُيوتِ فَأَصبَحوا","بَني عَمِّنا مَن يَرمِهِم يَرمِنا مَعا",38,"ع",2,0],["خَلَطتَهُ بِاللَحمِ خَلطاً جَيِّداً","وَلَم تَزَل تَخلِطُهُ مُرَدِّدا",39,"د",2,0],["خَلَطْتُمُ الجَوْهَرَ بالجَوْهَرِ","وَشِبْتُمُ العَنْبَرَ بالعَنْبَرِ",40,"ر",1,1],["خَلَطَ اللوزَ والحليبَ فكانت","حيثُ كانتْ وليسَ طيناً وماءا",41,"ا",3,0],["خلطنا الندى بالبأس حتى كأننا","سحاب لديه البرق والرعد والقطر",42,"ر",1,0],["خَلْطٌ كَخَلْطِ الكَذبِ المَضَغْضَغِ","قَد أَتْرُك الشاعِرَ مِثْل الأَلْثَغِ",43,"غ",1,0],["خَلْطين من شحم ومن نقي","شابهما بالأزرق المشويّ",44,"ي",1,0],["خلط السماحة بالحماسة فالندى","ينهل من سحب الردى المتحتم",45,"م",1,0],["خلطاء من كل فج حضور","وصفوف كما تصف السطور",46,"ر",1,1],["خلط البراعة بالشجاعة","فالصليل عن الدليل",47,"ل",1,0],["خلط الشجاعة بالندى فحسامه","لمن اعتدى وسماحه لمن اعتفى",48,"ف",2,0],["خلط النعيم ببؤسه لما سخا","وسطا فأنسى سيرة ابن المنذر",49,"ر",1,0],["خَلطَت مَلاحَتَها بِحُسنِ تَقتُّل","وَفخامَةٍ لِلمُجتَلي وَجَلالِ",50,"ل",1,0],["خلطت بعالم الأطفال نفسي","بيوم العيد كي أجني السرورا",51,"ر",2,1],["خلط على الناس ينسبوك إلى","الظرف وشتت عليهم السبلا",52,"ل",2,0],["خلطت بل خبطت في المعنى ولم","تدر الحقائق فاعترف بعماكا",53,"ك",2,0],["خلطنَ المَعْجَ من مَرحٍ بذُعْرٍ","كما قطعت حبائِلَها النُّوَارُ",54,"ر",1,0],["خَلَطُوني بأَهلهم وحَموني","من صُروفِ الزمانِ والتلقيبِ",55,"ب",1,0],["خَلَطَ السُّباءَ مراهقاً من سِرّهم","بفَتىً وبِكرٍ منهم بعَوانِ",56,"ن",1,0],["خَلَطَ القَنا بِعِظَامِهِ فَتَشابَهَتْ","هِيَ وَالقَنا المُتَقَصِّفُ المُتَقَصِّدُ",57,"د",1,0],["خُلطت بمسحوق العبيرِ وعلَّلتْ","بذكيِّ نافِجةٍ ونَشر يَلنجَج",58,"ج",1,0],["خلطت لهم مُدامَة أذرعاتٍ","بماءِ سحابةً خضلاً نَضُوحا",59,"ح",2,0],["خَلطَ الصّبا ماءَ الشَبابِ بِنارِهِ","مِن وَرد وَجنَتِهِ وَآس عِذارهِ",60,"ر",2,1],["خلطت هزلي في الهوى يجدى","ولم أزل في حب ذا المقرطق",61,"ق",1,0],["خلطته بعودها وبِباقٍ","فهو أحوى على اليدين شريق",62,"ق",1,0],["خُلِطت يواقيتٌ هناك لأدمع","مزجت بلؤلُؤِ أدمع لم تمزج",63,"ج",1,0],["خلطوا صالحا وآخر سوءا","فعسى الله أن يتوب عليهم",64,"م",1,0],["خلط اللاحين في سلوته","غلطاً فالحب قد أضرم ناره",65,"ر",2,0],["خلطه من الحيرة وفي القلب تعميم","دربٍ خطيرٍ والأماني سقيمه",66,"م",2,0],["خلطت مع حسن النوايا خباثه","تضحك لي وزرع الموده تحشه",67,"ش",2,0],["خلطوا الحابل بالنابل في","جدهم حتى تراموا شعبا",68,"ب",2,0],["خلطت في الحديث لما رأتني","رب خلط يشف عنه ذكاء",69,"ا",2,0],["خلط الزبورَ مع الدماء وثغره","في كلّ طعم غوايةٍ متلمّظُ",70,"ظ",1,0],["خلط الناس بين كبْرٍ ودينٍ","فارتوى الكون من تخاريف مسِّ",71,"س",1,0],["(خلط وجلط) فما للفن من نغم","(بربش ودردش) فلا تحتاج للكلم",72,"م",1,1],["خُلِطتْ أوراقُ المبادئ في الأرض","فحارَ اللبيبُ والمأفونُ",73,"ن",1,0],["خلطتْها معادلاتُ النظام","العالميِّ الجديد وهْوَ عفينُ",73,"ن",1,0],["خلط الحلال بنية البغي ما جاز","ولا ينبني مجد بعوج المخاليص",74,"ص",1,0],["خلطا من التبر واللجين ومن","جواهر من كرائم الصدف",75,"ف",1,0],["خلطوا النصائِحَ بالهجاء ولم يَعُوا","عُمْقَ النصيحةِ في هجاءٍ قُدِّما",76,"م",2,0]]}