","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83179","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57965","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58042","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72496","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72501","السريع"],[4767,"شمس الرشاد","https://www.poetsgate.com/ViewPoem.aspx?id=179938",""],[5038,"تراتيل وموّال","https://www.poetsgate.com/ViewPoem.aspx?id=189578",""],[585,"يا أيها القلم انهض إن سواك كبا","https://www.poetsgate.com/ViewPoem.aspx?id=161888",""],[5080,"سعي الظمائر","https://www.poetsgate.com/ViewPoem.aspx?id=185455",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5145,"الله يعلم ما قاسته قاسان","https://www.poetsgate.com/ViewPoem.aspx?id=108055",""],[5187,"لقاءٌ بلا مَوعِد","https://www.poetsgate.com/ViewPoem.aspx?id=37393",""],[5198,"الكحل","https://www.poetsgate.com/ViewPoem.aspx?id=135396",""],[5198,"جنة احبابه","https://www.poetsgate.com/ViewPoem.aspx?id=136099",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5461,"نامت عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=9493",""],[5464,"وفي حقول فؤادي أتمَرَ القصب","https://www.poetsgate.com/ViewPoem.aspx?id=21368",""],[5464,"طرقنا بابكم فأجاب صمت","https://www.poetsgate.com/ViewPoem.aspx?id=6677",""],[5582,"لِمَنْ بِسِقْطِ اللِّوَى وَالمُنْحَنَى طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187219",""],[5582,"أَهاجَ لَكَ التَّذْكارَ وَالوَجْدَ بارِقُ","https://www.poetsgate.com/ViewPoem.aspx?id=187213",""],[5582,"سُلطانُ لا زِلْتَ فِي عَلْياكَ سُلْطانا","https://www.poetsgate.com/ViewPoem.aspx?id=187305",""],[5582,"أَمِنْ بارِقٍ أَعْلَى الأُبَيْرِقِ يُلْمَحُ","https://www.poetsgate.com/ViewPoem.aspx?id=186780",""],[5582,"أَهذا الَّذِي تَحْتَ النِّقابِ هُوَ الخَدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=63487",""],[5582,"دَعاهُ يَعُجْ فِي حُبِّهِ لِمَعاجِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63476",""],[5582,"صِلِيهِ بِما يَشْفِي غَلِيلَ فُؤادِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63496",""],[243,"تسديد الحساب","https://www.poetsgate.com/ViewPoem.aspx?id=50560",""],[5664,"الزبرجد","https://www.poetsgate.com/ViewPoem.aspx?id=176688",""],[5691,"حمار الحطاب","https://www.poetsgate.com/ViewPoem.aspx?id=205825",""],[5691,"سجال(4)","https://www.poetsgate.com/ViewPoem.aspx?id=206443",""],[5953,"قد مسني الشيطان يا سيدي","https://www.poetsgate.com/ViewPoem.aspx?id=93882",""],[4222,"تُرى يجتمعُ الشّملُ","https://www.poetsgate.com/ViewPoem.aspx?id=71346",""],[6164,"الثمانون؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66038&r=&rc=48",""],[6169,"وكادت وبيتِ اللهِ أطنابُ ثاتبٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19424&r=&rc=9",""],[5080,"بصبر عصا أبي ذرٍّ صبرت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88140&r=&rc=10",""],[6243,"دهشة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84445&r=&rc=19",""],[6268,"يبكيكم الأقصى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82924&r=&rc=10",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""],[6280,"مَضَى لِسَبِيلِهِ مَعْنٌ وأبْقَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27900&r=&rc=55",""],[2220,"الحمدُ للهِ جلَّ اللهُ منْ خالقٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11611&r=&rc=485",""]],"verses":[["وَكادَ الدَّهرُ يَقطُرُ مُجتَلاهُ","عَلى الأَثلاتِ بِالسُمِّ النَّقيعِ",0,"ع",1,0],["وَكادَ رُباهُ تَرفُلُ في رِداءٍ","مِنَ النُّوَّارِ فَوَّفَهُ الحَبِيُّ",1,"ي",1,0],["وكادَتْ عَذارى الحَيِّ يَقْبِسْنَ نارَهُ","إذا ما تلَوَّتْ في السّنا المُتَوهِّجِ",2,"ج",1,0],["وكادَ يَفْتِلُ إكْراماً لزائِرِهِ","عِذارَها منْ أثيثِ النّبْتِ غِرْبيبِ",3,"ب",1,0],["وكاد الصباح يشق الدجى","ولم يأذن القلب أن أهجعا",4,"ع",2,0],["وكادَ يَصبُو إلى دُنياكُمُ عُمَرٌ","ويَرتَضي بَيعَ باقيهِ بفانيها",5,"ي",3,0],["وَكَادَتْ صَفْحَةُ التَّارِيخِ تُطْوَى","وَتُنْثَرُ كُلَّمَا تُلِيَتْ إِذَاعَهْ",6,"ه",1,0],["وَكَادَ يَكْبُو فُؤَادِي","مِنْ شِدَّةِ الخَفَقَانِ",7,"ن",1,0],["وكادت مصر تسبقها فَخاراً","به لو ظلّ وهو هناك ثاو",8,"و",1,0],["وكاد إذا رأى مغناك راء","يَوَدّ بأن يكون من اليتامى",9,"م",2,0],["وَكادَ يَومَ لِوى حَوّاءَ يَقتُلُني","لَو كُنتُ مِن زَفَراتِ البَينِ قُرحانا",10,"ن",2,0],["وكادت عياب الود منا ومنهم","وإن قيل أبناء العمومة تَصْفَرُ",11,"ر",1,0],["وَكادَ بِأَكنافِ العَقيقِ وَئيدُهُ","يَحُطُّ مِنَ الجَمّاءِ رُكناً مُلَملَما",12,"م",2,0],["وكاد يخترق الإثنين ذاك لذا","كالفعل ينصب مفعولين في نسق",13,"ق",1,0],["وكادت تبارينا دمشق بشجوها","إليك وقد تشجى الرّبى والمعالم",14,"م",1,0],["وكادَ من لطف ألفاظٍ محررةٍ","يردّ سائله المفتنّ مفتونا",15,"ن",2,0],["وَكادَت تَحُزُّ لدَيكِ الهِضابُ","وَتَركُضُ قُدّامَكِ الأَجبُلُ",16,"ل",1,0],["وَكادَ يُريني الإِثمَ في كُلِّ ما أَرى","وَكُلَّ نِظامٍ غَيرَ ما سَنَّ مُختَلّا",17,"ل",2,0],["وكاد بنار منه يحرق مهجتي","وقلبي وما يحويه ي طيه طمري",18,"ر",2,0],["وَكادَ سُروري لا يَفي بِنَدامَتي","عَلى تَركِهِ في عُمرِيَ المُتَقادِمِ",19,"م",1,0],["وكادَ ينزِعُ شيطانُ الغرامِ يدي","عن طاعةِ النُّسْكِ لولا قلبيَ الخاشي",20,"ش",2,0],["وَكادَت بَناتُ النَفسِ تَخرُجُ وَالحَشا","وَتَنفَضُّ مِن وَجدٍ عَلَيها الأَضالِعُ",21,"ع",1,0],["وَكادَت تَكونُ الروحَ لا الراحَ كَمَّلَت","قَوى طَبعِها لَو كانَ يا بِسُها رَطبا",22,"ب",2,0],["وكادتْ يدٌ منه تشدّ على يدي","ورجلٌ له بالقُرْبِ تمشْي على رجلي",23,"ل",2,0],["وكادَ لَيلي يكون من قِصَرٍ","غَيرَ زَمَانٍ مجدّد الوقتِ",24,"ت",1,0],["وَكادَ بِما فيهِ مِن بَلَّةٍ","يَسومُ الصَحيفَةَ أَن تُعشِبا",25,"ب",2,0],["وَكادَت بِلادُ اللَهِ يا أُمَّ مالِكٍ","بِما رَحُبَت مِنكُم عَلَيَّ تَضيقُ",26,"ق",1,0],["وَكادَت وَبَيتِ اللَهِ أَطنابُ ثابِتٍ","تَقوَّضَ عَن لَيلى وَتَبكي النَوائِحُ",27,"ح",1,1],["وَكادَت عَلى الأَطواءِ أَطواءِ ضارِجٍ","تُساقِطُني وَالرَحلَ مِن صَوتِ هُدهُدِ",28,"د",1,0],["وكادَ نَداهُ لا يَفي بالّذي جَنى","عليَّ من الإثم المُضاعَفِ والوِزْر",29,"ر",1,0],["وَكادَ يَقولُ شَيئاً غَيرَ أَنّي","سَبَقتُ إِلى اليَمينِ بِلا أَعودُ",30,"د",1,0],["وَكادَ يُمَزِّقُ سِربالَهُ","فَقُلتُ إِلَيكَ يُساقُ الحَديثُ",31,"ث",1,0],["وكاد منه الزمان يغضي","خزيا وتستغفر الذنوب",32,"ب",1,0],["وكادتْ قَلوصٌ حُمّلَتْها حَقيبَةً","يَبِضّ بماءٍ كُورُهَا ونُسُوعُها",33,"ع",3,0],["وَكادَ لاَ يَتْرُكُ إِلاَّ لَوْنَهُ","فِي أَعْيُنِي تَعَاقُبُ الحِدَادِ",34,"د",1,0],["وَكادَ مِمّا أَفقَدتُ شِبلي","يَطُفنَ بي نابِحٌ وَعاوِ",35,"و",1,0],["وكاد اليأسُ يُوهِنُ كلَّ عزمٍ","ومصرُ تصارعُ الخصمَ الألدّا",36,"د",2,0],["وكادَ سروراً ما بها من أهلّةٍ","يتيه على ابن الليل في ليلة التم",37,"م",1,0],["وكادت جوانحنا الواجفات","من الذعر أن تلفظ الأكبدا",38,"د",2,0],["وكاد الصباح يشقّ الدجا","ولم يأذن القلب أن أهجعا",39,"ع",2,0],["وكادَ على \" القَطَّارِ \" يُرْسِلُ حاصباً","على \" الشرقِ \" لولا أنْ قذفتَ به حَصْبا",40,"ب",2,0],["وكاد يُذيعُ حديث الجنانِ","واسرارَ كَوثَرِه المُطرّف",41,"ف",1,0],["وكادتْ تَلُفُّكِ في طيّها","حواشيه ردَّكِ عزمٌ قَضى",42,"ا",1,0],["وكادت تخرّ الهضاب","وتركض قدّامك الأجبل",43,"ل",1,0],["وكاد قلبي ان يفنى له جزعا","لولا اعلل قلبي انه خانا",44,"ن",2,0],["وكادتْ من أماكنها الرَّواسي","تخرّ على الدَّكادِك والقُلىّ",45,"ا",1,0],["وكادتْ ترجفُ الأرضون طرَّا","بمن فيها ويصعق كلُّ حيّ",45,"ي",1,0],["وكادَ البدرُ يخسف والدرارى","تناثرُ قبلَ خسرانِ الشقىّ",45,"ا",1,0],["وكادت لها بغدادُ يوم تطلّعت","تسيرُ مغانيها وتَجمحُ دُورُها",46,"ر",3,0],["وَكادَ شِعارُ الخَوفِ يَنبَثُّ في الوَرى","فَنادى شِعارُ الأَمنِ يا نَصرُ يا نَصرُ",47,"ر",1,0],["وكادَ يَفْضَحُهُ ضَوْءُ الهِلالِ وقَدْ","بَدا لِخَمْسِ لَيالٍ مِنْهُ في الشَّهَرِ",48,"ر",1,0],["وكادت تميد الأرض منها بفيلق","يشد على الريح الطريق إلى القصد",49,"د",1,0],["وكادت ترى عيناي في سحب ادمعي","متى ارتجفت برقاً من النار مضرَما",50,"م",2,0],["وَكادَت عِيابُ الوُدِّ مِنّا وَمِنكُمُ","وَإِن قيلَ أَبناءُ العُمومَةِ تَصفَرُ",51,"ر",1,1],["وَكادَ القَلب أَن يَسلو فَلما","تذكر أبرق الحنان حنا",52,"ن",2,0],["وَكادَت دُموعُ العَينِ تَمحو الحُجولَ مِن","جَنائِبِهِ مِن لَوعَةِ الحُزنِ وَالغُرَر",53,"ر",1,0],["وَكادَ يَحكيكِ ضوءُ الصُبح مبتَسِماً","لكن ثَناهُ وَميضٌ من ثَناياكِ",54,"ك",1,0],["وَكاد وقد ه