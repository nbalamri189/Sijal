{"poems":[[63,"إذا نشر الحيا حلل الربيع","https://www.aldiwan.net/poem45726.html","الوافر"],[63,"ألا بأبي بذي الأثلات ربع","https://www.aldiwan.net/poem45774.html","الوافر"],[63,"ثنى عطفه للبارق المتأجج","https://www.aldiwan.net/poem46140.html","الطويل"],[63,"يا حادي الشدنيات المطاريب","https://www.aldiwan.net/poem46151.html","الرجز"],[100,"ليلة الذكريات","https://www.aldiwan.net/poem11328.html","عموديه"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[93,"تنكرت الحياة كأن دهراً","https://www.aldiwan.net/poem11131.html","الوافر"],[93,"رأيته ورآني","https://www.aldiwan.net/poem11233.html","المجتث"],[88,"أرى بغداد من بعد أغبرار","https://www.aldiwan.net/poem44976.html","الوافر"],[88,"لدار شنلر في القدس فضل","https://www.aldiwan.net/poem44996.html","الوافر"],[27,"بان الخليط ولو طوعت ما بانا","https://www.aldiwan.net/poem4432.html","البسيط"],[37,"لقدما رأيت الناس أبناء علة","https://www.aldiwan.net/poem6930.html","الطويل"],[23,"ألم تسأل الربع الجديد التكلما","https://www.aldiwan.net/poem21236.html","الطويل"],[72,"يا رب ظبي على ظبي ظفرت به","https://www.aldiwan.net/poem19364.html","البسيط"],[72,"ليهن بنو الآمال أنك قادم","https://www.aldiwan.net/poem19670.html","الطويل"],[72,"أعدى بغيركم دمع المحبينا","https://www.aldiwan.net/poem20172.html","البسيط"],[91,"سألت وقد مرت الشمأل","https://www.aldiwan.net/poem9059.html","عموديه"],[91,"وسائلة أي المذاهب مذهبي","https://www.aldiwan.net/poem62662.html","عموديه"],[89,"تقدمت الاقوام مسرعة تجري","https://www.aldiwan.net/poem44885.html","الطويل"],[43,"أنا لائمي إن كنت وقت اللوائم","https://www.aldiwan.net/poem10544.html","الطويل"],[62,"وموقف من وراء الرمل آنسني","https://www.aldiwan.net/poem52373.html","البسيط"],[28,"إني إلى خير البرية كلها","https://www.aldiwan.net/poem5296.html","الطويل"],[66,"عجبت لها تمسي العقول لها نهبا","https://www.aldiwan.net/poem39205.html","الطويل"],[80,"ننام من الأيام في غرض النبل","https://www.aldiwan.net/poem31332.html","الطويل"],[80,"يا ليلة فزت إذ ظفرت بها","https://www.aldiwan.net/poem31533.html","المنسرح"],[74,"شأوت مطايا الصبا مطلبا","https://www.aldiwan.net/poem12866.html","المتقارب"],[33,"أيا شبه ليلى لا تراعي فإنني","https://www.aldiwan.net/poem25862.html","الطويل"],[13,"وكادت وبيت الله أطناب ثابت","https://www.aldiwan.net/poem2190.html","الطويل"],[22,"آثرت إدلاجي على ليل حرة","https://www.aldiwan.net/poem21644.html","الطويل"],[75,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[48,"ريب الدار مطلبه بعيد","https://www.aldiwan.net/poem62588.html","الوافر"],[50,"ومرت فقالت متى نلتقي","https://www.aldiwan.net/poem64720.html","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39674","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16704","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54748","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43858","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[100,"ليلة الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=50132",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[90,"إليها !","https://www.poetsgate.com/ViewPoem.aspx?id=179205",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[91,"ريح الشمال","https://www.poetsgate.com/ViewPoem.aspx?id=53198",""],[113,"اضنى وحق الهوى وجدا له حسدي","https://www.aldiwan.net/poem40463.html","عموديه"],[126,"بموتِ المرتضى الواكي الرضى","https://www.aldiwan.net/poem50216.html","الوافر"],[140,"لجاجة قلب ما يفيق غرورها","https://www.aldiwan.net/poem58440.html","الطويل"],[141,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[153,"روحي فدى شادن وافى على حذر","https://www.aldiwan.net/poem55668.html","البسيط"],[158,"كذا فليكن سعى الملوك إلى المجد","https://www.aldiwan.net/poem58974.html","الطويل"],[197,"من الصدع في قلبي غداة تهدما","https://www.aldiwan.net/poem45161.html","الطويل"],[247,"وكادت عياب الود منا ومنكم","https://www.aldiwan.net/poem2083.html","الطويل"],[269,"سمعت سويجع الاثلاث غنى","https://www.aldiwan.net/poem52085.html","الوافر"],[280,"أتى نعي ملك أظلم الشمس والقمر","https://www.aldiwan.net/poem32742.html","الطويل"],[295,"يا دار مية بالجرعاء حياك","https://www.aldiwan.net/poem33201.html","البسيط"],[296,"رأى البرق في جنح الدجى يتألق","https://www.aldiwan.net/poem36295.html","عموديه"],[301,"أتتنا بعود حركته بأنمل","https://www.aldiwan.net/poem57794.html","الطويل"],[301,"قد زاد هذا النيل في عامنا","https://www.aldiwan.net/poem57811.html","السريع"],[318,"وسيع صدري انقضت في ضيقه حيلي","https://www.aldiwan.net/poem67221.html","البسيط"],[335,"أتعرف رسما دارسا قد تغيرا","https://www.aldiwan.net/poem45431.html","الطويل"],[335,"ألا ناديا أظعان ليلى تعرج","https://www.aldiwan.net/poem45434.html","الطويل"],[346,"أرحتك واسترحت من الملام","https://www.aldiwan.net/poem20678.html","الوافر"],[359,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[361,"سمونا بالجياد إلى أعاد","https://www.aldiwan.net/poem1714.html","الوافر"],[369,"عسى بعض هاتيك العوائد عائد","https://www.aldiwan.net/poem57499.html","الطويل"],[369,"أفرق حتى ما به داء","https://www.aldiwan.net/poem57537.html","السريع"],[377,"ودادي غير منتقل","https://www.aldiwan.net/poem48753.html","مجزوء الوافر"],[399,"قد أصبح الدين نهبا بين زعنفة","https://www.aldiwan.net/poem46493.html","البسيط"],[399,"يهنا المعالي قدوم منك ميمون","https://www.aldiwan.net/poem46917.html","البسيط"],[400,"سلام على الدار التي جمعت شملي","https://www.aldiwan.net/poem33607.html","الطويل"],[407,"مضى لسبيله معن وأبقى","https://www.aldiwan.net/poem67484.html","الوافر"],[413,"أرد الدموع بأردانه","https://www.aldiwan.net/poem53918.html","المتقارب"],[413,"بحكمك زال الظلم وابتسم العدل","https://www.aldiwan.net/poem53956.html","الطويل"],[438,"حرائق حزن في فؤادي تجدد","https://www.aldiwan.net/poem14448.html","الطويل"],[441,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[456,"حماها أن تشل وأن تراعا","https://www.aldiwan.net/poem56121.html","الوافر"],[459,"كأن رياض الحزن هبت لها الصبا","https://www.aldiwan.net/poem15139.html","الطويل"],[459,"تعلمت البيداء فسحة صدره","https://www.aldiwan.net/poem15445.html","الطويل"],[468,"فما جعلت ما بين مكة ناقتي","https://www.aldiwan.net/poem4680.html","الطويل"],[475,"دم أريق بأسياف الهوى هدر","https://www.aldiwan.net/poem15236.html","البسيط"],[480,"نسيم الصبا عنعن وسلسل بنافح الت","https://www.aldiwan.net/poem24378.html","عموديه"],[480,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[493,"علي أن لا أريح العيش والقتبا","https://www.aldiwan.net/poem9763.html","البسيط"],[512,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[536,"يا لذة الحلم في إغفاءة الوسن","https://www.aldiwan.net/poem47600.html","عموديه"],[538,"لما أتاني وأهلي من طياتهم","https://www.aldiwan.net/poem56648.html","البسيط"],[560,"قوموا بنا نسأل الأموات في الرجم","https://www.aldiwan.net/poem52816.html","الكامل"],[560,"قد طلع البدر من المغرب","https://www.aldiwan.net/poem52981.html","السريع"],[573,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"]],"verses":[["وَكادَ الدَّهرُ يَقطُرُ مُجتَلاهُ","عَلى الأَثلاتِ بِالسُمِّ النَّقيعِ",0,"ع",1,0],["وَكادَ رُباهُ تَرفُلُ في رِداءٍ","مِنَ النُّوَّارِ فَوَّفَهُ الحَبِيُّ",1,"ي",1,0],["وكادَتْ عَذارى الحَيِّ يَقْبِسْنَ نارَهُ","إذا ما تلَوَّتْ في السّنا المُتَوهِّجِ",2,"ج",1,0],["وكادَ يَفْتِلُ إكْراماً لزائِرِهِ","عِذارَها منْ أثيثِ النّبْتِ غِرْبيبِ",3,"ب",1,0],["وكاد الصباح يشق الدجى","ولم يأذن القلب أن أهجعا",4,"ع",2,0],["وكادَ يَصبُو إلى دُنياكُمُ عُمَرٌ","ويَرتَضي بَيعَ باقيهِ بفانيها",5,"ي",3,0],["وَكَادَتْ صَفْحَةُ التَّارِيخِ تُطْوَى","وَتُنْثَرُ كُلَّمَا تُلِيَتْ إِذَاعَهْ",6,"ه",1,0],["وَكَادَ يَكْبُو فُؤَادِي","مِنْ شِدَّةِ الخَفَقَانِ",7,"ن",1,0],["وكادت مصر تسبقها فَخاراً","به لو ظلّ وهو هناك ثاو",8,"و",1,0],["وكاد إذا رأى مغناك راء","يَوَدّ بأن يكون من اليتامى",9,"م",2,0],["وَكادَ يَومَ لِوى حَوّاءَ يَقتُلُني","لَو كُنتُ مِن زَفَراتِ البَينِ قُرحانا",10,"ن",2,0],["وكادت عياب الود منا ومنهم","وإن قيل أبناء العمومة تَصْفَرُ",11,"ر",1,0],["وَكادَ بِأَكنافِ العَقيقِ وَئيدُهُ","يَحُطُّ مِنَ الجَمّاءِ رُكناً مُلَملَما",12,"م",2,0],["وكاد يخترق الإثنين ذاك لذا","كالفعل ينصب مفعولين في نسق",13,"ق",1,0],["وكادت تبارينا دمشق بشجوها","إليك وقد تشجى الرّبى والمعالم",14,"م",1,0],["وكادَ من لطف ألفاظٍ محررةٍ","يردّ سائله المفتنّ مفتونا",15,"ن",2,0],["وَكادَت تَحُزُّ لدَيكِ الهِضابُ","وَتَركُضُ قُدّامَكِ الأَجبُلُ",16,"ل",1,0],["وَكادَ يُريني الإِثمَ في كُلِّ ما أَرى","وَكُلَّ نِظامٍ غَيرَ ما سَنَّ مُختَلّا",17,"ل",2,0],["وكاد بنار منه يحرق مهجتي","وقلبي وما يحويه ي طيه طمري",18,"ي",1,0],["وَكادَ سُروري لا يَفي بِنَدامَتي","عَلى تَركِهِ في عُمرِيَ المُتَقادِمِ",19,"م",1,0],["وكادَ ينزِعُ شيطانُ الغرامِ يدي","عن طاعةِ النُّسْكِ لولا قلبيَ الخاشي",20,"ي",1,0],["وَكادَت بَناتُ النَفسِ تَخرُجُ وَالحَشا","وَتَنفَضُّ مِن وَجدٍ عَلَيها الأَضالِعُ",21,"ع",1,0],["وَكادَت تَكونُ الروحَ لا الراحَ كَمَّلَت","قَوى طَبعِها لَو كانَ يا بِسُها رَطبا",22,"ب",2,0],["وكادتْ يدٌ منه تشدّ على يدي","ورجلٌ له بالقُرْبِ تمشْي على رجلي",23,"ي",1,0],["وكادَ لَيلي يكون من قِصَرٍ","غَيرَ زَمَانٍ مجدّد الوقتِ",24,"ت",1,0],["وَكادَ بِما فيهِ مِن بَلَّةٍ","يَسومُ الصَحيفَةَ أَن تُعشِبا",25,"ب",2,0],["وَكادَت بِلادُ اللَهِ يا أُمَّ مالِكٍ","بِما رَحُبَت مِنكُم عَلَيَّ تَضيقُ",26,"ق",1,0],["وَكادَت وَبَيتِ اللَهِ أَطنابُ ثابِتٍ","تَقوَّضَ عَن لَيلى وَتَبكي النَوائِحُ",27,"ح",1,1],["وَكادَت عَلى الأَطواءِ أَطواءِ ضارِجٍ","تُساقِطُني وَالرَحلَ مِن صَوتِ هُدهُدِ",28,"د",1,0],["وكادَ نَداهُ لا يَفي بالّذي جَنى","عليَّ من الإثم المُضاعَفِ والوِزْر",29,"ر",1,0],["وَكادَ يَقولُ شَيئاً غَيرَ أَنّي","سَبَقتُ إِلى اليَمينِ بِلا أَعودُ",30,"د",1,0],["وَكادَ يُمَزِّقُ سِربالَهُ","فَقُلتُ إِلَيكَ يُساقُ الحَديثُ",31,"ث",1,0],["وكاد منه الزمان يغضي","خزيا وتستغفر الذنوب",32,"ب",1,0],["وكادتْ قَلوصٌ حُمّلَتْها حَقيبَةً","يَبِضّ بماءٍ كُورُهَا ونُسُوعُها",33,"ع",3,0],["وَكادَ لاَ يَتْرُكُ إِلاَّ لَوْنَهُ","فِي أَعْيُنِي تَعَاقُبُ الحِدَادِ",34,"د",1,0],["وَكادَ مِمّا أَفقَدتُ شِبلي","يَطُفنَ بي نابِحٌ وَعاوِ",35,"و",1,0],["وكاد اليأسُ يُوهِنُ كلَّ عزمٍ","ومصرُ تصارعُ الخصمَ الألدّا",36,"د",2,0],["وكادَ سروراً ما بها من أهلّةٍ","يتيه على ابن الليل في ليلة التم",37,"م",1,0],["وكاد الصباح يشقّ الدجا","ولم يأذن القلب أن أهجعا",38,"ع",2,0],["وكادَ على \" القَطَّارِ \" يُرْسِلُ حاصباً","على \" الشرقِ \" لولا أنْ قذفتَ به حَصْبا",39,"ب",2,0],["وكاد يُذيعُ حديث الجنانِ","واسرارَ كَوثَرِه المُطرّف",40,"ف",1,0],["وكادتْ تَلُفُّكِ في طيّها","حواشيه ردَّكِ عزمٌ قَضى",41,"ا",1,0],["وكادت تخرّ الهضاب","وتركض قدّامك الأجبل",42,"ل",1,0],["وكاد قلبي ان يفنى له جزعا","لولا اعلل قلبي انه خانا",43,"ن",2,0],["وكادتْ من أماكنها الرَّواسي","تخرّ على الدَّكادِك والقُلىّ",44,"ا",1,0],["وكادتْ ترجفُ الأرضون طرَّا","بمن فيها ويصعق كلُّ حيّ",44,"ي",1,0],["وكادَ البدرُ يخسف والدرارى","تناثرُ قبلَ خسرانِ الشقىّ",44,"ا",1,0],["وكادت لها بغدادُ يوم تطلّعت","تسيرُ مغانيها وتَجمحُ دُورُها",45,"ر",3,0],["وَكادَ شِعارُ الخَوفِ يَنبَثُّ في الوَرى","فَنادى شِعارُ الأَمنِ يا نَصرُ يا نَصرُ",46,"ر",1,0],["وكادَ يَفْضَحُهُ ضَوْءُ الهِلالِ وقَدْ","بَدا لِخَمْسِ لَيالٍ مِنْهُ في الشَّهَرِ",47,"ر",1,0],["وكادت تميد الأرض منها بفيلق","يشد على الريح الطريق إلى القصد",48,"د",1,0],["وكادت ترى عيناي في سحب ادمعي","متى ارتجفت برقاً من النار مضرَما",49,"م",2,0],["وَكادَت عِيابُ الوُدِّ مِنّا وَمِنكُمُ","وَإِن قيلَ أَبناءُ العُمومَةِ تَصفَرُ",50,"ر",1,1],["وَكادَ القَلب أَن يَسلو فَلما","تذكر أبرق الحنان حنا",51,"ن",2,0],["وَكادَت دُموعُ العَينِ تَمحو الحُجولَ مِن","جَنائِبِهِ مِن لَوعَةِ الحُزنِ وَالغُرَر",52,"ر",1,0],["وَكادَ يَحكيكِ ضوءُ الصُبح مبتَسِماً","لكن ثَناهُ وَميضٌ من ثَناياكِ",53,"ك",1,0],["وَكاد وقد هَبَّتْ مِنَ الحيِّ نفحةٌ","بأَذيالِها من شوقِه يتعلَّق",54,"ق",1,0],["وكاد وقد جست مثانيه يكتسى","بأوراقه لما جرى الماء في العود",55,"د",1,0],["وكاد أن يعطف من مائه","عرى على أزرار أهرامه",56,"ه",1,0],["وَكادَ صَبري يَهي لَولا بِهِ بَقيتُ","بِقِيَّةٍ مِن بَقايا الحَزمِ لَم تَزَلِ",57,"ل",1,0],["وَكادَت عَلى ذاتِ التَنانيرِ تَرتَمي","بِها القورُ مِن حادٍ