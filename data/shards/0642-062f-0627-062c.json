{"poems":[[88,"قد أجدبت دار الحجا والنهى","https://www.aldiwan.net/poem68887.html","السريع"],[45,"أهلا بدار سباك أغيدها","https://www.aldiwan.net/poem9531.html","المنسرح"],[48,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85590","الطويل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[108,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[102,"تحدّي","https://www.poetsgate.com/ViewPoem.aspx?id=50181",""],[132,"هنيت بالنصر موعودا لك الظفر","https://www.aldiwan.net/poem50605.html","البسيط"],[186,"رمس لفارس لحود الكريم ثوى","https://www.aldiwan.net/poem66966.html","البسيط"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[193,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[230,"أهجر النوم في طلاب العلاء","https://www.aldiwan.net/poem55222.html","الخفيف"],[230,"لا والهوى العذري والوجد","https://www.aldiwan.net/poem55247.html","السريع"],[234,"قد اجتمع البستان والروض والخمر","https://www.aldiwan.net/poem51088.html","الطويل"],[266,"عقبى مدى الهم أولي غاية الفرج","https://www.aldiwan.net/poem38354.html","البسيط"],[275,"قد اجتمعت فيك المحاسن يا جمل","https://www.aldiwan.net/poem35426.html","الطويل"],[280,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[287,"قد أجمد الخمر كانون بكل قدح","https://www.aldiwan.net/poem32821.html","البسيط"],[321,"يا أيها القاضي السني الذكر","https://www.aldiwan.net/poem69439.html","الرجز"],[408,"قد أجبنا هواك لما دعانا","https://www.aldiwan.net/poem46736.html","الخفيف"],[409,"كلمات منكم طيب شذاها","https://www.aldiwan.net/poem33363.html","الرمل"],[422,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[449,"صراع السيف والقلم","https://www.aldiwan.net/poem55927.html","عموديه"],[469,"بك طالت يد الزمان القصيرِ","https://www.aldiwan.net/poem3316.html","عموديه"],[484,"قد اجتمعت بخلي","https://www.aldiwan.net/poem36910.html","المجتث"],[487,"لي في الغرام صبابة قد أسكرت","https://www.aldiwan.net/poem24326.html","عموديه"],[505,"عليك سلام الله أفرطت يا مي","https://www.aldiwan.net/poem37725.html","الطويل"],[505,"قد أجمعوا كيدهم قوم وقد جمعوا","https://www.aldiwan.net/poem37727.html","البسيط"],[563,"نور تلفف بالظلام مكمل","https://www.aldiwan.net/poem34237.html","الكامل"],[567,"مللت من القريض وقلت يكفي","https://www.aldiwan.net/poem52844.html","البسيط"],[567,"كلفت حمل تحيتي ريح الصبا","https://www.aldiwan.net/poem52966.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139046",""],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110352","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48804","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62540","السريع"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56600","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56568","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84478","البسيط"],[1477,"","https://poetry.dctabudhabi.ae/diwan/poem/134236","البسيط"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35803","الخفيف"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128706","البسيط"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111802","الرمل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141260","البسيط"],[1976,"","https://poetry.dctabudhabi.ae/diwan/poem/198506","الطويل"],[2074,"","https://poetry.dctabudhabi.ae/diwan/poem/33092","البسيط"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177817","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53173","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99083","البسيط"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130837",""],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141202","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93881","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112607","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74063","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126914","الخفيف"],[3576,"","https://poetry.dctabudhabi.ae/diwan/poem/128498","المجتث"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109981","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216593",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117845","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114454","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114596","الخفيف"],[4036,"","https://poetry.dctabudhabi.ae/diwan/poem/145555","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95052","البسيط"],[4281,"","https://poetry.dctabudhabi.ae/diwan/poem/73890","السريع"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73284","الرمل"],[4767,"فارس القريض","https://www.poetsgate.com/ViewPoem.aspx?id=126303",""],[4767,"رجاءٌ وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=213553",""],[4886,"قد أجّج الشوق في قلبي وفي خَلَدي","https://www.poetsgate.com/ViewPoem.aspx?id=170307",""],[4968,"صولات الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=208105",""],[5190,"معلقة الجمال في رد الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=175246",""],[592,"ألا فذراني من جهول وغاشم","https://www.poetsgate.com/ViewPoem.aspx?id=128817",""],[5376,"مال الغبيط من الأهواء في المهج","https://www.poetsgate.com/ViewPoem.aspx?id=188318",""],[5376,"توشَّحَ الليلُ في أغوارِ لوحاتي","https://www.poetsgate.com/ViewPoem.aspx?id=205053",""],[5574,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=206009",""],[5691,"وكر الجواسيس... ويوم النكبة","https://www.poetsgate.com/ViewPoem.aspx?id=206158",""],[5691,"مستشار","https://www.poetsgate.com/ViewPoem.aspx?id=206655",""],[5691,"عكاظُ الفيسِبوك...!","https://www.poetsgate.com/ViewPoem.aspx?id=207585",""],[5804,"مساجلة ( الطغاة )","https://www.poetsgate.com/ViewPoem.aspx?id=189659",""],[5895,"نقرتْ سهيدةُ","https://www.poetsgate.com/ViewPoem.aspx?id=198608",""],[5906,"عدالة جائرة","https://www.poetsgate.com/ViewPoem.aspx?id=188523",""],[5956,"مصر الأبية ليس ترضَى بالأسى","https://www.poetsgate.com/ViewPoem.aspx?id=210652",""],[6093,"يَسْتَحْسِنُ القُبْحَ مَنْ يَسْتَقْبِحُ الحَسَنَا(حرب بِرُسْغٍ)","https://www.poetsgate.com/ViewPoem.aspx?id=205621",""],[6127,"صوتك النور","https://www.poetsgate.com/ViewPoem.aspx?id=191300",""],[6167,"نداء الأمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85478&r=&rc=7",""]],"verses":[["قَد أَجدَبَت دارُ الحِجا وَالنُهى","بَعدَكَ مِن آرائِكَ النافِعَه",0,"ه",1,1],["قَد أَجمَعَت هَذِهِ الخَليقَةُ لي","أَنَّكَ يا اِبنَ النَبِيِّ أَوحَدُها",1,"د",3,0],["قد أجَبْنَا قَوْلَ الشّريفِ بقوْلٍ","وأثَبْنَا الحَصَى عنِ المَرْجانِ",2,"ن",1,0],["قد اجتمع الأمجاد يحتفلون بي","وأكثرهم صحبي سلام على صحبي",3,"ب",2,0],["قَد أَجَبنا نِداءَكُنَّ وَجِئنا","نَسأَلُ القادِرينَ بَعضَ النَوالِ",4,"ل",1,0],["قَدْ أَجَادَ الْمَثَّالُ مَا تَصْنَعُ الْكَفُّ","وَمَا يَسْتَطِيعُ وَحْيُ الذَّكاءِ",5,"ا",2,0],["قد اجتحتم بثورتكم شرورًا","وما للشَّرِّ إلا الاجتياحُ",6,"ح",1,0],["قد أجبنا صوت المروءات لمّا","عربد الظالم العنيد الإباحي",7,"ح",2,0],["قد أجْمَعوا أمرهم سرّاً ومكرَهُمُ","غدراً فأعْقَبهم إهلاكُ ما مَكرُوا",8,"ر",3,0],["قَد أَجمَلَ السَعيَ في الدُنيا بسيرَتِهِ","فَأَجمَلَ اللَهُ في الدارينِ مَرجِعَهُ",9,"ع",2,0],["قَدِ اِجتَهدوا فيها بحُكم نُفوسهم","فَنالوا بِها مِنها الكبائرَ والكِبرا",10,"ر",2,0],["قَدِ اِجتَهدوا في دينِهم حينَما رأوا","مَجامِعَهم زادتهُ في نكرهِ نُكرا",10,"ر",2,0],["قَدِ اِجتَهدوا في خذلِ دينِ مُحمّدٍ","وَإِن زَعَموا بِالإجتهادِ له نصرا",10,"ر",2,0],["قَدِ اِجتَهدوا أَن لا تكاليفَ عندهم","فَصاروا إِباحيّينَ لا نهيَ لا أمرا",10,"ر",2,0],["قَد أجفلَ الناسُ مِن عربٍ ومن عجمٍ","مِنهم وما فيهمُ في الحرب إجفيلُ",11,"ل",1,0],["قَد أجزت المدّاحَ قبلي فكانت","سُنّةً واِقتدى بك الكرماءُ",12,"ا",2,0],["قد أَجادَت فيها يَراعةُ مُنشي","ها اِختِيارَ الأَخبارِ وَالأَنباء",13,"ا",2,0],["قَد أَجمَعَ الكُلُّ على أَنَّه","مُفرَدُ هذا العَصر في المَجدِ",14,"د",1,0],["قد اجتمع البستان والروض والخمرُ","وحُرِّكِت الأوتارُ وارتفع الزَّمْرُ",15,"ر",1,1],["قد أجمع الخلق أن لا خلق يفضله","في العلم والحلم إجماعا ً بلا حرج",16,"ج",1,0],["قد اجتَمعت فيكِ المحاسنُ يا جملُ","فهانَ علينا في محَبَّتِكِ القَتلُ",17,"ل",1,1],["قَد أجْهَدَ السَّابِحاتِ خَيْلاً","تَهْوِي إلَى بابِهِ وسُفْنا",18,"ن",2,0],["قَد أَجمَدَ الخَمرَ كانونٌ بِكُلِّ قَدَح","وَأَخمَدَ الجَمرَ في الكانونِ حينَ قَدَح",19,"ح",1,1],["قد اجتمعنا في محل وعر","ومنزل ضنك ومثوى قمر",20,"ر",1,0],["قد أجبنا هواك لمّا دعانا","وعَصينا العذولَ حين نَهانا",21,"ن",2,1],["قد أجازت بالدراري كلمي","فأجادت أحسن اللّه جزاها",22,"ا",3,0],["قد اجتنبت هذي الملوك الَّتي ترى","مطامع راجيها اجتناب المحارم",23,"م",1,0],["قد اجتمع القضاة وهم","عصارة سُلطة الأمم",24,"م",1,0],["قد أجدتُ التجبير جهدي فلا","تقنع بها غير نضرة التحبير",25,"ر",1,0],["قد اجتمعت بخلّي","من بعد طول جفاء",26,"ا",2,1],["قد أجريت من وحدتي من نقطتي","من هيبتي من صولتي من رتبتي",27,"ت",2,0],["قدِ اجْتَمَعَ الضِدَّانِ منكِ بِسِرِّهمْ","فَذا الوقْتُ مَرْئِيٌّ وذا القَصْدُ مَخْفِيُّ",28,"ي",1,0],["قد أجْمَعوا كَيْدَهُمْ قومٌ وقد جَمَعوا","جُنْداً لهمْ بينَ قاصِيٍّ ودانِيِّ",29,"ي",1,1],["قد أجملت نور النبيِّ وفصلت","وتظل تجمل للورى وتفصل",30,"ل",1,0],["قد اجتمعت قلوبُ النَّاسٍِ طرّاً","عليهِ وأجَمَعتْ من دُونِ خُلفِ",31,"ف",1,0],["قد أجمَدتْ نُوَبُ الزمانِ قريحتي","كَمَداً وأنْستْني الكَلامَ المُعرَبا",32,"ب",2,0],["قد أجمعوا واتفقوا فيما خلا","كمثل ما ذكرت عنهم أولا",33,"ل",2,0],["قد أجبنا وأنت أيضاً فصحت","بتلاقيك سالف وسلاف",34,"ف",1,1],["قد اجتمعت بها غُرَرُ السجايا","وزان جمالَها حسنُ الطويَّه",35,"ي",2,0],["قد أجادوها شباكاً","وأعدوها كمينا",36,"ن",2,0],["قد اجتهدنا أن ننال المنى","منكم فكم مجتهد لا يصيبْ",37,"ب",1,0],["قد أجيعوا فالبعض يأكل بعضاً","غنمٌ بعضهم وبعض ذئاب",38,"ب",1,0],["قد أجهدتهم وهي عارمة","وأظنها يوماً سترتدع",39,"ع",1,0],["قَد اجتَهَدتُ عَلى ضُعفي وَلي أَمَلٌ","بِعِتقِ شيبَتي الغَبراء في اللِمَمِ",40,"م",1,0],["قد أجل الله آجال العباد فمن","مقدم فات أو باقٍ إلى أجل",41,"ل",1,0],["قَد أَجَرنا إِلَيهِ في اللَيلَةِ الدَع","جاءِ وَاليَوم ذي الهَجيرِ الهِيامِ",42,"م",1,0],["قد أججوا في نار الوجد وانتزحوا","فمن صفاء أديمي يظهر اللهب",43,"ب",1,0],["قد أجبنا فأَجبنا ما اسمُ شيءٍ","عليهِ طائرُ الافصاح صاح",44,"ح",1,0],["قد أجدب العام لا غيثٌ ولا ثمرٌ","وأفقر الرّبع لا أهلا ولا دارا",45,"ر",2,0],["قد أجاب الإله دعوة نوحٍ","حين نادى بأنه مغلوب",46,"ب",1,0],["قَد اِجتَواني لَهُ الخُلّانُ كُلُّهُم","وَباعَ مَسكَنَهُ مِن قُربِهِ جاري",47,"ر",2,0],["قد أجزت اللخمي محمدا الخير","ربيب الحجي، رفيع الذكر",48,"ر",1,0],["قد أجمع الخلق على تفضيله","من بعدما أفنوا الزمان في الجدل",49,"ل",1,0],["قَد أجمعَت رُسلُ الإِلَهِ عَلَيهِ لَم","يُنكِرهُ مِن أتبَاعِهِم رَجُلاَنِ",50,"ن",1,0],["قدأجمع الناس أن حمقي","أحسن من عفتي وديني",51,"ن",2,0],["قد أججت من دلها","في مهجتي نار السعير",52,"ر",1,0],["قد اجتمعت كل العلاقات الأرود","فقوموا بنا نغدوا وقوموا بنا نعدو",53,"د",2,1],["قد أجاد الإمعان في جود معن","وحجاه حاجي ذكاء إياس",54,"س",1,0],["قد اجتمع الضدان فلتسقط النهى","فقد تهلك الدنيا ببعض الخوارق",55,"ق",1,0],["قَد أَجزَلوا لَك شكرهم","وَالأَجرُ عِندَ اللَه جزلُ",56,"ل",1,0],["قد أجاب الآله حين دعاه","ومضى راضيا بأمر القضاء",57,"ا",2,0],["قد اجتمعت بخلي","في يوم موت الرقيب",58,"ب",1,1],["قد اجتَبانا وما منا سِوى دَنِسٍ","مستغرقٍ في حَما الآثام منغمسِ",59,"س",1,0],["قد أجنّوك في الثرى","يا جنين الضمائر",60,"ر",1,0],["قد اجتهدت قالوا وهذا اجتهادها","لجمع قوى الإسلام أم لانقسامها",61,"م",3,0],["قد أجادَ فيما أفاد وأبدى","ما به أقذى العين من كُلِّ شاني",62,"ن",2,0],["قد أجزناكَ دُمتَ تَزدادُ رَيا","من علومٍ وردتَها سلسبيلا",63,"ل",2,0],["قد أجملت جمل ولكن ضيعت","إجمالها يوم ارتحال جمالها",64,"ل",3,0],["قد أجمع الناس أن الآس مغرسهُ","صدر الجنائن كي تُزهى زواهيها",65,"ي",3,1],["قَد أَجمَعَ الناسُ عَلى بُغضِ لا","وَلَستُ أَنسَى أَبَداً حُبَّ لا",66,"ل",2,1],["قد أجنَّ الصُّدغُ منه","عارضاً فهو مُسَلسل",67,"ل",1,0],["قد أجابوا