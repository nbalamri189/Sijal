{"poems":[[55,"يا قلب ما أطول هذا الغرام","https://www.aldiwan.net/poem29809.html","السريع"],[55,"من اي الثنايا طالعتنا النوائب","https://www.aldiwan.net/poem30739.html","الطويل"],[55,"أرابك من مشيبي ما أرابا","https://www.aldiwan.net/poem30754.html","الوافر"],[24,"وهاجرة لا تستريد ظباؤها","https://www.aldiwan.net/poem21882.html","الطويل"],[24,"أمن دمنة الدار أقوت سنينا","https://www.aldiwan.net/poem21884.html","المتقارب"],[29,"عفا النسران بعدك والوحيد","https://www.aldiwan.net/poem5726.html","الوافر"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[34,"أبثين إنك قد ملكت فأسجحي","https://www.aldiwan.net/poem27808.html","الكامل"],[30,"نعائي ابن ليلى للسماح وللندى","https://www.aldiwan.net/poem5378.html","الطويل"],[30,"ومطروفة العينين قد قدت للصبا","https://www.aldiwan.net/poem5565.html","الطويل"],[63,"كان جليدا فخانه جلده","https://www.aldiwan.net/poem51718.html","المنسرح"],[68,"عجبت لها تمسي العقول لها نهبا","https://www.aldiwan.net/poem39205.html","الطويل"],[41,"عرفت لسلمى رسم دار تخالها","https://www.aldiwan.net/poem53698.html","الطويل"],[13,"وبالشعب إذ سدت بجيلة فجه","https://www.aldiwan.net/poem2213.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[30,"وركب كأن الريح تطلب عندهم","https://www.poetsgate.com/ViewPoem.aspx?id=21374",""],[34,"أبثين إنك قد ملكت فأسجحي","https://www.poetsgate.com/ViewPoem.aspx?id=121",""],[181,"خليقان هلهالان لا خير فيهما","https://www.aldiwan.net/poem4504.html","الطويل"],[190,"عجبت لبيت قاله بعض من مضى","https://www.aldiwan.net/poem43735.html","الطويل"],[240,"أترضون يا أهل بغداذ لي","https://www.aldiwan.net/poem32092.html","المتقارب"],[275,"ركبت فهزني طربي","https://www.aldiwan.net/poem35269.html","مجزوء الوافر"],[342,"وحرف قد بعثت على وجاها","https://www.aldiwan.net/poem45435.html","الوافر"],[463,"يا عينِ لو أغضيتِ يوم النوى","https://www.aldiwan.net/poem56312.html","السريع"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86703","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145944","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145891","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145801","المتقارب"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96375","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80203","الوافر"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95491","المتقارب"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144759","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21448","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100388","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204647","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62763","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62966","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86293","الطويل"],[4162,"","https://poetry.dctabudhabi.ae/diwan/poem/67786","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28725","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72566","الخفيف"],[4728,"داء الهوى (فصحى)","https://www.poetsgate.com/ViewPoem.aspx?id=176952",""],[5776,"حربُ الفصول","https://www.poetsgate.com/ViewPoem.aspx?id=207245",""],[5879,"خماسيات الوجد (3)","https://www.poetsgate.com/ViewPoem.aspx?id=215454",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""],[2696,"ألَمَّ خَيَالٌ مِنْ أُمَيْمَة َ مَوْهِناً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27417&r=&rc=21",""]],"verses":[["يَعَضُّ كَفَّيهِ عَلى حَظِّهِ","وَيَسأَلُ الدَهرَ حُظوظَ اللِئام",0,"م",1,0],["يَعَضّونَ مِنهُ بِالأَكُفِّ وَإِنَّما","تُعَضُّ بِأَطرافِ البَنانِ العَجائِبُ",1,"ب",1,0],["يَعَضُّ عَلى لَواحِظَ أُفعُوانٍ","فَإِن سيمَ الأَذى طَلَبَ الوِثابا",2,"ب",2,0],["يَعُضُّ بِإِبهامِ اليَدَينِ تَنَدُّماً","وَلَهَّفَ سِرّاً أُمَّهُ وَهُوَ نادِمُ",3,"م",1,0],["يُعَضِّضُهُنَّ عَضيضَ الثِقا","فِ بِالسَمهَرِيَةِ حَتّى تَلينا",4,"ن",2,0],["يَعَضّونَ الأَنامِلَ إِن رَأوها","بَساتيناً يُؤازِرُها الحَصيدُ",5,"د",1,0],["يعضُّ بالبيض ويخطو بالقنا","ويسبق الوهم لإدراك المنى",6,"ن",2,0],["يُعضُّ وما أسدى إلى العين سيِّئاً","وليس بمظلومٍ وإن كان يُظْلمُ",7,"م",1,0],["يَعضَضنَ مِن غَيظٍ عَلَيَّ أَنامِلاً","وَوَدِدتُ لَو يَعضَضنَ صُمَّ جَنادِلِ",8,"ل",1,0],["يَعَضّونَ أَطرافَ العِصِيِّ تَلُفُّهُم","مِنَ الشَأمِ حَمراءُ السُرى وَالأَصائِلِ",9,"ل",1,0],["يَعَضُّ عَلى النارِ الَّذينَ يَلونَها","إِذا كانَ ثَوبَ الكَلبِ مِنها جَحيمُها",10,"م",3,0],["يَعضُدُ قَرْماً تَقِلُّه يَدُه","طَوْراً وطَوْراً يَكُنُّه عَضُدُه",11,"د",2,0],["يَعُضُّ عَلَيها التائِبونَ بِنانَهُم","وَيَندُبُ كُلٌّ مِنهُمُ عَقلَهُ نَدبا",12,"ب",2,0],["يَعَضُّ سِواراها خِدالاً لَوَ اَنَّها","إِذا بَلَغا الكَفَّينِ أَن يَتَقَدَّما",13,"م",2,0],["يَعَضُّ عَلى أَطرافِهِ كَيفَ زَولُهُ","وَدونَ المَلا سَهلٌ مِنَ الأَرضِ ماثِلُ",14,"ل",1,0],["يَعَضُّ الرَّدَى أَطْرَافَهَا بِنَواجِذِ","مِنَ المَوجِ تَبْدُو تَارَةً وَتَغيبُ",15,"ب",1,0],["يعضّونَ أطْرَافَ العِصِيّ كَأنّها","تُخَزِّمُ بالأطرَافِ شَوْكَ العَقارِبِ",16,"ب",1,0],["يعضضن من غيظ لعيّ أناملا","ووددت لو يعضضن صمّ جنادل",17,"ل",1,0],["يَعَضُّ بِأَبْدانٍ لها مُلْتَقاهما","ومَثْناهُما رِخْوانِ يَضْطَرِبانِ",18,"ن",1,0],["يعضّ على نظراته وهو صاغرٌ","وغلا أتاه الموت من حيث لا يدري",19,"ر",2,0],["يَعَضُّ الحَسودُ بِها كَفَّهُ","وَمِثلي عَلى مِثلِها يُحسَدُ",20,"د",1,0],["يَعَضُّ لجامهُ صَلفاً","كما عضَّ الثَّديَّ صَبي",21,"ب",2,0],["يَعَضُّ عَلى ذَواتِ الضُغنِ مِنها","كَما عَضَّ الثِقافُ عَلى القَناةِ",22,"ه",1,0],["يَعضُد فيها العامُ ما قبلَهُ","ويفضُل اليومَ أخوه غدا",23,"ا",1,0],["يَعضّ عَلى كَفيهِ مِنهُ نَدامة","لِتفريطه في عَيشه وَمَعاده",24,"د",2,0],["يعضُّ إصبعًهُ غيظاً عليكَ فما","عوَّدتهُ أن يُلاقي الموتَ مُنفردا",25,"د",2,0],["يَعضُّ دشداشةَ الأوجاعِ يركضُ في","العرَاءِ مندهِشاً بالشمسِ والشُهُبِ",26,"ب",1,0],["يَعضّ ُعليكَ العراقُ اليدين","ففي كل ِّيوم ٍله ُكربلاءُ",27,"ا",2,0],["يُعضُ عليها الحاسدونَ بنانَهم","وليس بأيديهم غنايَ ولا فَقرِي",28,"ر",2,0],["يَعض وسادَه غَيظاً وَيُمسي","يَغض الطَرف مِن هَولِ الخِصامِ",29,"م",1,0],["يعضّ البنان على لهوِه","وكم ودَّ مِن قبلُ لو يُفلِتُ",30,"ت",1,0],["يعضون الأنامل من خزاء","وما ذاكم بِشافِ النادمينا",31,"ن",2,0],["يعض بنان الراحتين تلهفاً","ويصبح من فرط الأسى قارعاً سنا",32,"ن",2,0],["يَعَضُّ عَليها الشَّيخُ إِبهام كفِّهِ","وَتخزَى بِها أَحياؤُكُم والمقابِرُ",33,"ر",1,0],["يعضّ الكور غاربها فتلوي","اخشَّتَها لا سنمة دوامي",34,"م",2,0],["يعض أناملي عضا لطيفا","ويخدشها دعابا دون ضغن",35,"ن",1,0],["يعض عليّ الكفَّ لا يَستطيعني","وما ضرّني أنْ ينشِقَ التّربَ راغِمُ",36,"م",1,0],["يَعَضُّ على النابينِ فأْس لجامهِ","ويقطَعُ من آرائِهِ الشَّطِنَ المُثْنَى",37,"ن",2,0],["يَعض بِنان الكَف حال مَشيبُه","عَلى زَمن التَفريطِ في سن امرد",38,"د",1,0],["يَعَضُّونَ مِنْ غَيْظِ عَلَيَّ أكُفَّهُمْ","وَرَدُّكَ مَا لاَ تَسْتَطِيعُ شَدِيدُ",39,"د",1,0],["يَعُضُّ مِن هَولِهِ الحادي بِإِصبَعِهِ","وَيَجعَل الماءَ دونَ الزَّادِ مُدخَرا",40,"ر",2,0],["يعضد الوالد الذي هو في الحك","مة عيسى ليقمعا كل داء",41,"ا",2,0],["يعِضُّ عَلَى وَرْدٍ وَيَجْلو لآلِئَاً","ويُغْضي بِرِمْشٍ كالمُهَنَّدِ فَالِجِ",42,"ج",1,0],["يعض الماء فيها كل نفط","وآخرها إلى الأقصى الدخولُ",43,"ل",1,0],["يعضّني الشوق، لا أبكي على حلم","أبكي على عبق ترميه أزهاري",44,"ر",2,0],["يَعَضُّ عليْنا الشوكُ تَدْمي به الخُطا","وتَدْمي به أَكبَادُنُا والنَّواظِرُ",45,"ر",1,0],["يَعَضُّ عَلى أطْرَافِهِ كُلّما بَدَا","لنا فراسٌ يبغي القتالَ تنجُّدا",46,"د",2,0]]}