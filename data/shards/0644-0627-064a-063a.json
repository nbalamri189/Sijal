{"poems":[[53,"راحل أنت والليالي نزول","https://www.aldiwan.net/poem29892.html","الخفيف"],[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[53,"لا يغررنك سلم جاء يطلبه","https://www.aldiwan.net/poem30209.html","البسيط"],[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[63,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[77,"السعد جندك والقضاء دليل","https://www.aldiwan.net/poem36373.html","الكامل"],[77,"باتت نجوم الأفق دون علاكا","https://www.aldiwan.net/poem36385.html","الكامل"],[77,"قلبي وسمعي في شغل عن الفند","https://www.aldiwan.net/poem36613.html","البسيط"],[88,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[88,"لمن تركت فنون العلم والأدب","https://www.aldiwan.net/poem45052.html","البسيط"],[47,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"سؤلي أن توقن أني امرؤ","https://www.aldiwan.net/poem65986.html","السريع"],[51,"يا بني السمري لا تجشموني","https://www.aldiwan.net/poem66503.html","الخفيف"],[91,"ليس يدري الهم غير المبتلي","https://www.aldiwan.net/poem9064.html","عموديه"],[89,"اذكري إذ كنا صغيرين نلعب","https://www.aldiwan.net/poem44865.html","الخفيف"],[85,"كان فيما مضى من الدهر بيت","https://www.aldiwan.net/poem8034.html","الخفيف"],[28,"تضاحكت أن رأت شيباً تفرعني","https://www.aldiwan.net/poem1241.html",""],[61,"أفي دمى أبكت العيون دما","https://www.aldiwan.net/poem51428.html","المنسرح"],[66,"طمعي في لقاك بعد إياس","https://www.aldiwan.net/poem40639.html","الخفيف"],[107,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[80,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[80,"طرقت والليل ممدود الجناح","https://www.aldiwan.net/poem31522.html","الرمل"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[69,"أخرجوكم إلى الصعيد لعذر","https://www.aldiwan.net/poem28692.html","الخفيف"],[105,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[105,"ناد القبور وبشر كل مقبور","https://www.aldiwan.net/poem43053.html","البسيط"],[105,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[105,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[105,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[81,"لولا قضاؤك بين الحكم والحكم","https://www.aldiwan.net/poem61492.html","البسيط"],[52,"رأيت فيها برقها لما وثب","https://www.aldiwan.net/poem27297.html","الرجز"],[75,"ألؤلؤ دمع هذا الغيث أم نقط","https://www.aldiwan.net/poem69067.html","البسيط"],[50,"يا ابن موسى ماذا يقول الإمام","https://www.aldiwan.net/poem62248.html","الخفيف"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[50,"آب ليلي ليت ليلي لم يأب","https://www.aldiwan.net/poem64814.html","الرمل"],[50,"تأبدت برقة الروحاء فاللبب","https://www.aldiwan.net/poem64839.html","البسيط"],[46,"لا يغبطن أخو نعمى بنعمته","https://www.aldiwan.net/poem22083.html","البسيط"],[46,"يا حاديينا ألا سوقا بنا سحرا","https://www.aldiwan.net/poem23041.html","البسيط"],[46,"لا يغبطن ماش فوارس شزب","https://www.aldiwan.net/poem23253.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85782","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/44348","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30452","الخفيف"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42637","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42603","البسيط"],[94,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[51,"سُؤلي أنْ توقنَ أنّي امرؤٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30305",""],[120,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[124,"سكر الدهر فقل لي كيف أَصحو","https://www.aldiwan.net/poem23736.html","الرمل"],[128,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[160,"المشتري الحمد بالإفعال يصلحها","https://www.aldiwan.net/poem59003.html","البسيط"],[160,"من سلم الحق إلى أربابه","https://www.aldiwan.net/poem59193.html","الرجز"],[164,"جزعت أن يقال دام عبيط","https://www.aldiwan.net/poem67813.html","الخفيف"],[164,"أعن الشمس عشاء","https://www.aldiwan.net/poem67842.html","مجزوء الرمل"],[185,"لا تفرحن برتبة","https://www.aldiwan.net/poem14495.html","مجزوء الكامل"],[185,"لا تفرحن برتبة","https://www.aldiwan.net/poem14619.html","مجزوء الكامل"],[186,"لا تعبأن بفراق أه","https://www.aldiwan.net/poem43520.html","مجزوء الكامل"],[193,"لي رفيق شهم الفؤاد يماني","https://www.aldiwan.net/poem13145.html","الخفيف"],[198,"لا تصيخن لتشويق النديم","https://www.aldiwan.net/poem51886.html","الرمل"],[199,"غير قلبي أراه يسطيع صبرا","https://www.aldiwan.net/poem45561.html","الخفيف"],[207,"مابال عينك فيها عائر سهر","https://www.aldiwan.net/poem27960.html","البسيط"],[210,"خلني يا خلي وفرط بلائي","https://www.aldiwan.net/poem13509.html","الخفيف"],[222,"أو لم يأن أن يفيق من الغفلة","https://www.aldiwan.net/poem55408.html","الخفيف"],[223,"أيها الظلم والخنا والغرور","https://www.aldiwan.net/poem41927.html","الخفيف"],[235,"سقاك سار من الوسمي هتان","https://www.aldiwan.net/poem31744.html","البسيط"],[235,"يا صلاح الدين خذ حذ","https://www.aldiwan.net/poem31807.html","مجزوء الرمل"],[271,"يا جيرة الحي في ذا الاثل والبان","https://www.aldiwan.net/poem52066.html","البسيط"],[320,"لا يغرنك منظر لبغاة","https://www.aldiwan.net/poem61738.html","الخفيف"],[328,"لك يا وجهي التعيس هجائي","https://www.aldiwan.net/poem55014.html","الخفيف"],[328,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[331,"إني أتتني لسان ما أسر بها","https://www.aldiwan.net/poem518.html",""],[338,"لا يغلبنك غالب الحرص","https://www.aldiwan.net/poem68745.html","أحذ الكامل"],[342,"صدق الظن واستبان الخفاء","https://www.aldiwan.net/poem55383.html","الخفيف"],[353,"منهل العشاق مورود","https://www.aldiwan.net/poem40392.html","المديد"],[353,"زفت على بدر العلى الأفراح","https://www.aldiwan.net/poem40541.html","الكامل"],[371,"رسل المدامع أبلغ الرسل","https://www.aldiwan.net/poem57203.html","أحذ الكامل"],[403,"إن كنت ترضى في الهوى بتلافي","https://www.aldiwan.net/poem33642.html","الكامل"],[405,"لا يغرنك أنني لين اللم","https://www.aldiwan.net/poem49753.html","الخفيف"],[406,"الحلم أولى بمن شابت ذوائبه","https://www.aldiwan.net/poem50201.html","البسيط"],[416,"في كل يوم للمنون صولة","https://www.aldiwan.net/poem53940.html","الرجز"],[416,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[432,"أرح المطية برهة يا حادي","https://www.aldiwan.net/poem12596.html","الكامل"],[439,"قل للهوى حكمت فاحكم لي","https://www.aldiwan.net/poem34825.html","أحذ الكامل"],[458,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[461,"جانبا لومي وخافا لددي","https://www.aldiwan.net/poem16116.html","الرمل"],[461,"له عن الشر إعراض ومجتنب","https://www.aldiwan.net/poem16164.html","البسيط"],[485,"إني أتتني لسان لا أسر بها","https://www.aldiwan.net/poem1121.html",""],[495,"لا يغرنك الذي أنا فيه من الطلب","https://www.aldiwan.net/poem9764.html","مجزوء الخفيف"],[495,"اذهب الكاس فعرف الفجر","https://www.aldiwan.net/poem9813.html","مجزوء الرمل"],[515,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[515,"أيها الناس والخطاب إلى من","https://www.aldiwan.net/poem12291.html","الخفيف"],[538,"كل هذا خوف فقر ولقد","https://www.aldiwan.net/poem48196.html","عموديه"],[551,"برباعكم يا أهل يثرب حاجي","https://www.aldiwan.net/poem47907.html","الكامل"],[558,"كل من بالناس يختلط","https://www.aldiwan.net/poem34409.html","المديد"],[562,"ماذا التعلل في دنياك بالأمل","https://www.aldiwan.net/poem52780.html","البسيط"]],"verses":[["لا يَغُبُّ الحادي العَنيفُ وَلا يَف","تُرُ عَن رَنَّةِ العَديلِ العَديلُ",0,"ل",1,0],["لا يَغرُرَنَّكَ أَنَّهُم بِسِهامِهِم","أَشوَوا وَما بَلَغوا مَدى ما أَمَّلوا",1,"ل",3,0],["لا يَغرُرَنَّكَ سِلمٌ جاءَ يَطلُبُهُ","لَم يَخطُبِ السَلمَ إِلّا بَعدَ ما عُقِرا",2,"ر",2,1],["لا يَغرُرَنَّكُمُ تَناوُمُ ضَيغَمٍ","وَتَناذَروا وَثَباتِ أَغلَبَ مُلبِدِ",3,"د",1,0],["لا يغْلِبُ الحَقَّ بهِ باطِلٌ","ولا يُداني الجِدَّ منهُ مِزاحْ",4,"ح",1,0],["لاَ يَغْرُرَنَّ الرَّومَ فِي إِمْلاَئِهَا","قَدَرٌ فأَيَّامُ الْحُرُوبِ تَدُولُ",5,"ل",1,0],["لا َيَغْرُرَنَّ الرَّومَ فِي إِمْلائِهاَ","قَدَرٌ جَرَى فَاٌلْحَرْبُ هَاتِ وَهَاكَا",6,"ك",2,0],["لا يَغْرُرِ الرّومَ ما نالُوا وما فَعَلوا","فإنّ ذلِكَ إمْلاءٌ الى أمَدِ",7,"د",1,0],["لا يغُرَّنّك الزمان إذا ما","لك أبدى بشاشة وابتساما",8,"م",2,0],["لا يغضبون لأمرٍ عمّ باطله","كأنهم غير مخلوقين من عصب",9,"ب",1,0],["لايَغضَبونَ لِغَيرِ اللَهِ إِن غَضِبوا","وَلا يُضيعونَ حُكمَ اللَهِ إِن حَكَموا",10,"م",3,0],["لا يغرهم بندىً يأتيهمُ فكفى","مدحاً بأن يتأتَّى منك إنصات",11,"ت",1,0],["لا يَغُرَّنَّكَ المُماذِقُ بالظا","هر في حال مدة الالتقاءِ",12,"ا",2,0],["لا يغيظنَّ معشراً حسدوني","أنْ توالت إجادتي تمجيدَكْ",13,"ك",1,0],["لا يغْضَبنّ لعمرو من له خطرٌ","فليس يرضى بضيمي من له خَطَرُ",14,"ر",1,1],["لا يغضبُ العبدُ على ربهِ","ويَغضبُ الصاحبُ والخِلُّ",15,"ل",1,0],["لا يغرَّنَّكم بجهليَ حلمي","وارعوائي إلى حيائي وديني",16,"ن",2,0],["لا يَغُرَّ الحُسنُ ذا الحُسنِ فَقَد","يَصرَعُ البُلبُلَ صَوتُ البُلبُلِ",17,"ل",1,0],["لا يغرنك العيشة برق","وامضُ في سحابه فهو خلب",18,"ب",1,0],["لا يَغُرَّنكَ يا أَخا البيدِ مِن مَو","لاكَ ذاكَ القَبولُ وَالإِقبالُ",19,"ل",1,0],["لا يَغمِدُ السَيفَ إِلّا ما يُجَرِّدَهُ","عَلى قَفا مُحرِمٍ بِالسوقِ مَصلوبِ",20,"ب",1,0],["لا يَغْرِسُ الشَّرَّ غارِسٌ أبداً","إلا اجتَنى من غُصونِهِ نَدَما",21,"م",2,0],["لا يُغَيُّركَ ما تَقولُ الأَعادي","فَبِناءُ الوِدادِ فَوقَ أَساسِ",22,"س",1,0],["لا يَغْضَبُونَ وَلا يُحْمَى لَهُمْ حَرَمٌ","وَإِنْ تَكُنْ دُونَهُمْ أَسْيَافُهُمْ نَضَدَا",23,"د",2,0],["لا يَغْتررْ بالعفوِ من سلمه","أعداؤهُ فالحربُ دار انتقام",24,"م",1,0],["لا يغرّنّكَ منها خَجَلٌ","إنّها تُبديه في خدٍّ وَقَاح",25,"ح",1,0],["لا يغرنَّكَ لينٌ مِنتْ فتى","إنَّ للحيّاتِ لينٌ يُعتزَلْ",26,"ل",1,0],["لا يغيِّرْكُم الصعيدُ وكونوا","فيهِ مثلَ السيوفِ في الأغمادِ",27,"د",1,0],["لا يَغُرَّنَ قويّاً جُندُه","قُوّةٌ صَرْعَى وجُندٌ مُنهزِمْ",28,"م",1,0],["لا يَغْلِبِ الحقَّ يَرْدَى في كتائبهِ","جُنْدُ الدّراهمِ أو جيشُ الدّنانيرِ",29,"ر",1,0],["لا يَغضَبِ المَجدُ إِنَّ الحُرَّ يَفدَحُهُ","ظُلمُ البَريءِ وَنَصرُ الجارِمِ الجاني",30,"ن",2,0],["لاَ يَغُرَّنَّهم من الغيثِ وَكفٌ","إنّه السيلُ مُوشِكٌ أن يَعُمَّا",31,"م",2,0],["لا يغرَّنْكم رَسُولٌ جاءكم","مُبغض القلب محب المنطقِ",32,"ق",1,0],["لا يَغرَقُ البَحرُ في غَمرِ السَرابِ وَلا","يُخِلُّ بِالنَبعِ فَرعُ الضالِ وَالسَلَمِ",33,"م",1,0],["لِأَيِّ غاياتي أَجري بَعدَما","رَأَيتُ أَترابي وَقَد صاروا تُرَب",34,"ب",1,0],["لا يغتدي فَرِحاً بالمالِ يجمعُهُ","ولا يبِيتُ بدُنْيا وهو مغتبط",35,"ط",1,0],["لا يَغيضُ اِنسِجامُ عَيني علَيهِم","إِنَّما غايَةُ الحَزينِ السِجامُ",36,"م",1,0],["لا يُغمِدُ السَيفَ وَلا يَسورُ","لَقَد غَبينا وَالدَواهي عورُ",37,"ر",1,0],["لا يَغُرَّنَّكَ يَومٌ مِن غَدٍ","صاحِ إِنَّ الدَهرَ يُغفي وَيَهُب",38,"ب",1,0],["لا يَغفَلُ القَلبُ عَن لَيلى وَقَد غَفَلَت","عَمّا يُلاقي شَجٍ بِالحُبِّ مُغتَرِبُ",39,"ب",1,0],["لا يُغبَطَنَّ أَخو نُعمى بِنِعمَتِهِ","بِئسَ الحَياةُ حَياةٌ بَعدَها الشَجَبُ",40,"ب",1,1],["لا يَغرَضِ المَرءُ مِمّا يَغتَدي غَرِضاً","يُمسي وَيُضحي بِنَبلِ الدَهرِ مَرشوقا",41,"ق",2,0],["لا يَغبَطَن ماشٍ فَوارِسَ شُزَّبٍ","ما فارِسٌ إِلّا كَآخَرَ راجِلِ",42,"ل",1,1],["لا يَغضَب الناس من مَقالي","إن قلتُ أَصل الإنسان حيوانْ",43,"ن",1,1],["لأي غورٍ زال عن عرشه","وغاص في اللجِّ إلى أيِّ قاع",44,"ع",1,0],["لا يَغرُبُ الوَصلُ فيما بَينَنا أَبَداً","لَو كُنتِ واجِدَةً مِثلَ الَّذي أَجِدُ",45,"د",1,0],["لا يَغُرَّنْكَ ما تَرى مِن ودِادِي","فَلَعلِّي إِنْ شِئْتُ غَيَّرْتُ ودَّا",46,"د",2,0],["لا يَغُرَّنَّكَ ابتسامُ بَني الأرْ","ضِ فَخَلْفَ الشُّعاعِ لَذْعُ اللَّهيبِ",47,"ب",1,0],["لا يَغْنَمُ اللَّذَّةَ غَيْرُ امْرِئٍ","لَيْسَ لَهُ عَنْ لَهْوِهِ زَاجِرُ",48,"ر",1,0],["لا يُغْمِدُ السَّيْفَ إِلَّا بَعْدَ مَلْحَمَةٍ","وَلا يُعَاقِبُ إِلَّا بَعْدَ تَحْذِيرِ",49,"ر",1,0],["لا يغرّنك سحرها ورؤاها","جنّتي وحدها الرضى والأمان",50,"ن",1,0],["لا يغضبُ العبدُ على ربهِ","ويُغضبُ الصاحبَ الخِلُّ",51,"ل",1,0],["لا يغرنك ما ترى من أناتي","واحتبائي بالحلم والأغضاء",52,"ا",2,0],["لا يغرنك تقبيلهم","يدك اليوم وتقريظ ومدح",53,"ح",1,0],["لا يغرَّنْكَ التضاحكُ في النادِ","فما كل ضاحكٍ بالظهيرِ",54,"ر",1,0],["لا يغررنك منه الابتسام إذا","دنا إليك ولا تيأس إذا نفرا",55,"ر",2,0],["لا يغررنك ما يرى من سمته","فالخير كل الخير في اجتنابه",56,"ب",2,0],["لا يَغُرَّنكُمُ اِنبِعاثي رُوَيداً","إِنَّ هَمّي بِالفَرقَدَينِ مَنوطُ",57,"ط",1,0],["لا يَغُرَّنكِ سَما","حي فَمُقتادي عَنيفُ",58,"ف",1,0],["لا يَغْرُرَنَّك من يَها","ب ولا يَروقُك من يَوَدُّك",59,"ك",1,0],["لا يَغْررُنَّك أنْ تُها","ب ولا يروقُك من يَرُدّك",60,"ك",1,0],["لا يغريّنك بالذنو","ب إلى أخ حسنُ اعتذارك",61,"ك",1,0],["لا يُغنّي في العَظمِ إِلّا إِذا أَص","بَحَ نَشوان مِن نَجيعٍ قاني",62,"ي",1,0],["لا يغرنَّك مِنْ ذي ثروة","نَشَبٌ يَرْفَعُ من قدرِ اللئيم",63,"م",1,0],["لا يغرَّنَّ من يلومني الصم","تُ فإني رأيتُ في الصمتِ أجرا",64,"ر",2,0],["لا يَغرِسونَ فَسيلَ النَخلِ وَسطَهُمُ","وَلا تَخاوَرُ في مَشتاهُمُ البَقَرُ",65,"ر",1,0],["لا يغرنك ان حبتك بود","فمحال مودة الاعداء",66,"ا",2,0],["لا يغرّنك الغرور ولا يغ","ريك من كيد دهرك الاغفاء",67,"ا",2,0],["لا يغرَّنكَ أَنَّني مُستَكنٌ","فَإِلى ثَورَةٍ سُكوتي يُشيرُ",68,"ر",1,0],["لا يُغمِدُ السَيفَ إِلّا في الكَمِيِّ وَلا","يَستَصحِبُ النَصلَ إِلّا وَهوَ عُريانُ",69,"ن",1,0],["لا يَغُرَّنَّكَ مِنهُ","مَنطِقٌ حُلوُ المَذاقِ",70,"ق",1,0],["لا يغلق الباب عَن راحي النَوال وَلا","يقابل الوفد الا وهو جذلان",71,"ن",1,0],["لا يَغُرَنَّكَ مَنظرٌ لِبُغاةٍ","بِوُجوهٍ يَبدو بِها إِشراقُ",72,"ق",1,1],["لا يغرّنك ما يزيّنه الناس من","الحسن فهو محضُ هباء",73,"ا",2,0],["لا يَغُرّنك الذي يبدو","ففيه المستكِنُّ",74,"ن",1,0],["لاَ يَغْمِزُ السّاقَ مِنْ أَيْنٍ ولا نَصَبٍ","وَلاَ يَزَالُ أَمَامَ القَوْمِ يَغْتَفِرُ",75,"ر",1,0],["لا يَغلِبَنَّكَ غالِبُ الحِرصِ","وَاِعلَم بِأَنَّ الناسَ في نَقصِ",76,"ص",1,1],["لا يغرنك ما ترى من أناس","جللتهم مظاهر ورداء",77,"ا",2,0],["لا يغرنَّ العَذول بِهِ","إِن نَأى صدٌّ وَتَبعيدُ",78,"د",1,0],["لا يُغرينّك ذا التَمنّع في الهَوى","حُكم الغَرام تَمنّع وَسماحُ",79,"ح",1,0],["لا يَغتَرِر بي مِنكمُ أحَدٌ","ما كلُّ سَهمٍ نافِذُ النَّصلِ",80,"ل",1,0],["لا يغضبون عن الشريعة إن غدت","منهدة الأرجاء والأكناف",81,"ف",1,0],["لا يَغُرَنَّكَ أنَّني لَيِّنُ اللَّمْ","سِ فَعَزمي إذا انتضيت حُسامُ",82,"م",1,1],["لا يَغفَل الخَير ما لاقيتَ غُرَّتُهُ","بِحَيثُ حَلَّ وَلا تَدجو غَياكِهبُهُ",83,"ب",2,0],["لا يغفل الإِنسان عن مزلقة","لو كانَ للإنسان عقلٌ راجح",84,"ح",1,0],["لا يغالي فيكم المادحُ إنْ","أطنبَ المادح في المدح وغالى",85,"ل",2,0],["لا يغرُرَنْكَ تجاوُزي عن فعلِه","فلقد أثارَ كمائنَ الأحقادِ",86,"د",1,0],["لا يَغْلِبْنَ خصمايَ عندكَ فِي","عَيْنِ الرَّقِيبِ وأَلْسُنِ العَذْلِ",87,"ل",1,0],["لا يُغبَط الدينارُ يحمله","وينوء بعدُ بأثقل الحِملِ",88,"ل",1,0],["لا يَغُرَّنَّكُما مُلْكٌ ثَوى","من تميمٍ بعد طولِ الأسْعُدِ",89,"د",1,0],["لا يغلبُ الحلمَ من عاداته غضبٌ","ولا يشُحُّ ببشْرٍ وهو مهْمومُ",90,"م",1,0],["لا يغمز الساق من أين ولا صب","ولا يزال أمام القوم يقتفر",91,"ر",1,0],["لا يغرنك الذي","أنا فيه من الطلبْ",92,"ب",1,1],["لا يغرنّك جسم","صادق الحسن وروحُ",93,"ح",1,0],["لا يغررن الحي طول بقائه","فمصيره من بعده لفناء",94,"ا",2,0],["لا يغرنكم زيادة حال","فالزيادات بعدها النقصان",95,"ن",1,0],["لا يَغُرِّنَّكُم ظاِهرُه","إنَّه والله كالعَظمِ النَّخِر",96,"ر",1,0],["لا يغصبونَ إذا الرّجالُ تَغاصبتْ","إِلّا العقائلَ مِن عظيمِ التاجِ",97,"ج",1,0],["لا يغر المرء رقته","إذ به ذو القبض ينبسط",98,"ط",1,0],["لا يُغمِضُ المرءُ عيناً ثمَّ يفتَحُها","إلاّ على خوفِ موتٍ مُغمِضِ المُقَلِ",99,"ل",1,0]]}