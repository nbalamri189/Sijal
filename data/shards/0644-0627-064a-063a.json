{"poems":[[53,"راحل أنت والليالي نزول","https://www.aldiwan.net/poem29892.html","الخفيف"],[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[53,"لا يغررنك سلم جاء يطلبه","https://www.aldiwan.net/poem30209.html","البسيط"],[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[63,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[77,"السعد جندك والقضاء دليل","https://www.aldiwan.net/poem36373.html","الكامل"],[77,"باتت نجوم الأفق دون علاكا","https://www.aldiwan.net/poem36385.html","الكامل"],[77,"قلبي وسمعي في شغل عن الفند","https://www.aldiwan.net/poem36613.html","البسيط"],[88,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[88,"لمن تركت فنون العلم والأدب","https://www.aldiwan.net/poem45052.html","البسيط"],[47,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"سؤلي أن توقن أني امرؤ","https://www.aldiwan.net/poem65986.html","السريع"],[51,"يا بني السمري لا تجشموني","https://www.aldiwan.net/poem66503.html","الخفيف"],[91,"ليس يدري الهم غير المبتلي","https://www.aldiwan.net/poem9064.html","عموديه"],[89,"اذكري إذ كنا صغيرين نلعب","https://www.aldiwan.net/poem44865.html","الخفيف"],[85,"كان فيما مضى من الدهر بيت","https://www.aldiwan.net/poem8034.html","الخفيف"],[28,"تضاحكت أن رأت شيباً تفرعني","https://www.aldiwan.net/poem1241.html",""],[61,"أفي دمى أبكت العيون دما","https://www.aldiwan.net/poem51428.html","المنسرح"],[66,"طمعي في لقاك بعد إياس","https://www.aldiwan.net/poem40639.html","الخفيف"],[80,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[80,"طرقت والليل ممدود الجناح","https://www.aldiwan.net/poem31522.html","الرمل"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[69,"أخرجوكم إلى الصعيد لعذر","https://www.aldiwan.net/poem28692.html","الخفيف"],[105,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[105,"ناد القبور وبشر كل مقبور","https://www.aldiwan.net/poem43053.html","البسيط"],[105,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[105,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[105,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[81,"لولا قضاؤك بين الحكم والحكم","https://www.aldiwan.net/poem61492.html","البسيط"],[52,"رأيت فيها برقها لما وثب","https://www.aldiwan.net/poem27297.html","الرجز"],[75,"ألؤلؤ دمع هذا الغيث أم نقط","https://www.aldiwan.net/poem69067.html","البسيط"],[50,"يا ابن موسى ماذا يقول الإمام","https://www.aldiwan.net/poem62248.html","الخفيف"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[50,"آب ليلي ليت ليلي لم يأب","https://www.aldiwan.net/poem64814.html","الرمل"],[50,"تأبدت برقة الروحاء فاللبب","https://www.aldiwan.net/poem64839.html","البسيط"],[46,"لا يغبطن أخو نعمى بنعمته","https://www.aldiwan.net/poem22083.html","البسيط"],[46,"يا حاديينا ألا سوقا بنا سحرا","https://www.aldiwan.net/poem23041.html","البسيط"],[46,"لا يغبطن ماش فوارس شزب","https://www.aldiwan.net/poem23253.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85782","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/44348","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30452","الخفيف"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42637","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42603","البسيط"],[51,"سُؤلي أنْ توقنَ أنّي امرؤٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30305",""],[118,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[122,"سكر الدهر فقل لي كيف أَصحو","https://www.aldiwan.net/poem23736.html","الرمل"],[126,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[158,"المشتري الحمد بالإفعال يصلحها","https://www.aldiwan.net/poem59003.html","البسيط"],[158,"من سلم الحق إلى أربابه","https://www.aldiwan.net/poem59193.html","الرجز"],[162,"جزعت أن يقال دام عبيط","https://www.aldiwan.net/poem67813.html","الخفيف"],[162,"أعن الشمس عشاء","https://www.aldiwan.net/poem67842.html","مجزوء الرمل"],[183,"لا تفرحن برتبة","https://www.aldiwan.net/poem14495.html","مجزوء الكامل"],[183,"لا تفرحن برتبة","https://www.aldiwan.net/poem14619.html","مجزوء الكامل"],[184,"لا تعبأن بفراق أه","https://www.aldiwan.net/poem43520.html","مجزوء الكامل"],[191,"لي رفيق شهم الفؤاد يماني","https://www.aldiwan.net/poem13145.html","الخفيف"],[196,"لا تصيخن لتشويق النديم","https://www.aldiwan.net/poem51886.html","الرمل"],[197,"غير قلبي أراه يسطيع صبرا","https://www.aldiwan.net/poem45561.html","الخفيف"],[205,"مابال عينك فيها عائر سهر","https://www.aldiwan.net/poem27960.html","البسيط"],[208,"خلني يا خلي وفرط بلائي","https://www.aldiwan.net/poem13509.html","الخفيف"],[220,"أو لم يأن أن يفيق من الغفلة","https://www.aldiwan.net/poem55408.html","الخفيف"],[221,"أيها الظلم والخنا والغرور","https://www.aldiwan.net/poem41927.html","الخفيف"],[233,"سقاك سار من الوسمي هتان","https://www.aldiwan.net/poem31744.html","البسيط"],[233,"يا صلاح الدين خذ حذ","https://www.aldiwan.net/poem31807.html","مجزوء الرمل"],[269,"يا جيرة الحي في ذا الاثل والبان","https://www.aldiwan.net/poem52066.html","البسيط"],[318,"لا يغرنك منظر لبغاة","https://www.aldiwan.net/poem61738.html","الخفيف"],[326,"لك يا وجهي التعيس هجائي","https://www.aldiwan.net/poem55014.html","الخفيف"],[326,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[329,"إني أتتني لسان ما أسر بها","https://www.aldiwan.net/poem518.html",""],[336,"لا يغلبنك غالب الحرص","https://www.aldiwan.net/poem68745.html","أحذ الكامل"],[340,"صدق الظن واستبان الخفاء","https://www.aldiwan.net/poem55383.html","الخفيف"],[351,"منهل العشاق مورود","https://www.aldiwan.net/poem40392.html","المديد"],[351,"زفت على بدر العلى الأفراح","https://www.aldiwan.net/poem40541.html","الكامل"],[369,"رسل المدامع أبلغ الرسل","https://www.aldiwan.net/poem57203.html","أحذ الكامل"],[400,"إن كنت ترضى في الهوى بتلافي","https://www.aldiwan.net/poem33642.html","الكامل"],[402,"لا يغرنك أنني لين اللم","https://www.aldiwan.net/poem49753.html","الخفيف"],[403,"الحلم أولى بمن شابت ذوائبه","https://www.aldiwan.net/poem50201.html","البسيط"],[413,"في كل يوم للمنون صولة","https://www.aldiwan.net/poem53940.html","الرجز"],[413,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[429,"أرح المطية برهة يا حادي","https://www.aldiwan.net/poem12596.html","الكامل"],[436,"قل للهوى حكمت فاحكم لي","https://www.aldiwan.net/poem34825.html","أحذ الكامل"],[456,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[459,"جانبا لومي وخافا لددي","https://www.aldiwan.net/poem16116.html","الرمل"],[459,"له عن الشر إعراض ومجتنب","https://www.aldiwan.net/poem16164.html","البسيط"],[483,"إني أتتني لسان لا أسر بها","https://www.aldiwan.net/poem1121.html",""],[493,"لا يغرنك الذي أنا فيه من الطلب","https://www.aldiwan.net/poem9764.html","مجزوء الخفيف"],[493,"اذهب الكاس فعرف الفجر","https://www.aldiwan.net/poem9813.html","مجزوء الرمل"],[513,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[513,"أيها الناس والخطاب إلى من","https://www.aldiwan.net/poem12291.html","الخفيف"],[536,"كل هذا خوف فقر ولقد","https://www.aldiwan.net/poem48196.html","عموديه"],[549,"برباعكم يا أهل يثرب حاجي","https://www.aldiwan.net/poem47907.html","الكامل"],[556,"كل من بالناس يختلط","https://www.aldiwan.net/poem34409.html","المديد"],[560,"ماذا التعلل في دنياك بالأمل","https://www.aldiwan.net/poem52780.html","البسيط"]],"verses":[["لا يَغُبُّ الحادي العَنيفُ وَلا يَف","تُرُ عَن رَنَّةِ العَديلِ العَديلُ",0,"ل",1,0],["لا يَغرُرَنَّكَ أَنَّهُم بِسِهامِهِم","أَشوَوا وَما بَلَغوا مَدى ما أَمَّلوا",1,"ل",3,0],["لا يَغرُرَنَّكَ سِلمٌ جاءَ يَطلُبُهُ","لَم يَخطُبِ السَلمَ إِلّا بَعدَ ما عُقِرا",2,"ر",2,1],["لا يَغرُرَنَّكُمُ تَناوُمُ ضَيغَمٍ","وَتَناذَروا وَثَباتِ أَغلَبَ مُلبِدِ",3,"د",1,0],["لا يغْلِبُ الحَقَّ بهِ باطِلٌ","ولا يُداني الجِدَّ منهُ مِزاحْ",4,"ح",1,0],["لاَ يَغْرُرَنَّ الرَّومَ فِي إِمْلاَئِهَا","قَدَرٌ فأَيَّامُ الْحُرُوبِ تَدُولُ",5,"ل",1,0],["لا َيَغْرُرَنَّ الرَّومَ فِي إِمْلائِهاَ","قَدَرٌ جَرَى فَاٌلْحَرْبُ هَاتِ وَهَاكَا",6,"ك",2,0],["لا يَغْرُرِ الرّومَ ما نالُوا وما فَعَلوا","فإنّ ذلِكَ إمْلاءٌ الى أمَدِ",7,"د",1,0],["لا يغُرَّنّك الزمان إذا ما","لك أبدى بشاشة وابتساما",8,"م",2,0],["لا يغضبون لأمرٍ عمّ باطله","كأنهم غير مخلوقين من عصب",9,"ب",1,0],["لايَغضَبونَ لِغَيرِ اللَهِ إِن غَضِبوا","وَلا يُضيعونَ حُكمَ اللَهِ إِن حَكَموا",10,"م",3,0],["لا يغرهم بندىً يأتيهمُ فكفى","مدحاً بأن يتأتَّى منك إنصات",11,"ت",1,0],["لا يَغُرَّنَّكَ المُماذِقُ بالظا","هر في حال مدة الالتقاءِ",12,"ا",2,0],["لا يغيظنَّ معشراً حسدوني","أنْ توالت إجادتي تمجيدَكْ",13,"ك",1,0],["لا يغْضَبنّ لعمرو من له خطرٌ","فليس يرضى بضيمي من له خَطَرُ",14,"ر",1,1],["لا يغضبُ العبدُ على ربهِ","ويَغضبُ الصاحبُ والخِلُّ",15,"ل",1,0],["لا يغرَّنَّكم بجهليَ حلمي","وارعوائي إلى حيائي وديني",16,"ن",2,0],["لا يَغُرَّ الحُسنُ ذا الحُسنِ فَقَد","يَصرَعُ البُلبُلَ صَوتُ البُلبُلِ",17,"ل",1,0],["لا يغرنك العيشة برق","وامضُ في سحابه فهو خلب",18,"ب",1,0],["لا يَغُرَّنكَ يا أَخا البيدِ مِن مَو","لاكَ ذاكَ القَبولُ وَالإِقبالُ",19,"ل",1,0],["لا يَغمِدُ السَيفَ إِلّا ما يُجَرِّدَهُ","عَلى قَفا مُحرِمٍ بِالسوقِ مَصلوبِ",20,"ب",1,0],["لا يَغْرِسُ الشَّرَّ غارِسٌ أبداً","إلا اجتَنى من غُصونِهِ نَدَما",21,"م",2,0],["لا يُغَيُّركَ ما تَقولُ الأَعادي","فَبِناءُ الوِدادِ فَوقَ أَساسِ",22,"س",1,0],["لا يَغْتررْ بالعفوِ من سلمه","أعداؤهُ فالحربُ دار انتقام",23,"م",1,0],["لا يغرّنّكَ منها خَجَلٌ","إنّها تُبديه في خدٍّ وَقَاح",24,"ح",1,0],["لا يغرنَّكَ لينٌ مِنتْ فتى","إنَّ للحيّاتِ لينٌ يُعتزَلْ",25,"ل",1,0],["لا يغيِّرْكُم الصعيدُ وكونوا","فيهِ مثلَ السيوفِ في الأغمادِ",26,"د",1,0],["لا يَغُرَّنَ قويّاً جُندُه","قُوّةٌ صَرْعَى وجُندٌ مُنهزِمْ",27,"م",1,0],["لا يَغْلِبِ الحقَّ يَرْدَى في كتائبهِ","جُنْدُ الدّراهمِ أو جيشُ الدّنانيرِ",28,"ر",1,0],["لا يَغضَبِ المَجدُ إِنَّ الحُرَّ يَفدَحُهُ","ظُلمُ البَريءِ وَنَصرُ الجارِمِ الجاني",29,"ن",2,0],["لاَ يَغُرَّنَّهم من الغيثِ وَكفٌ","إنّه السيلُ مُوشِكٌ أن يَعُمَّا",30,"م",2,0],["لا يغرَّنْكم رَسُولٌ جاءكم","مُبغض القلب محب المنطقِ",31,"ق",1,0],["لا يَغرَقُ البَحرُ في غَمرِ السَرابِ وَلا","يُخِلُّ بِالنَبعِ فَرعُ الضالِ وَالسَلَمِ",32,"م",1,0],["لِأَيِّ غاياتي أَجري بَعدَما","رَأَيتُ أَترابي وَقَد صاروا تُرَب",33,"ب",1,0],["لا يغتدي فَرِحاً بالمالِ يجمعُهُ","ولا يبِيتُ بدُنْيا وهو مغتبط",34,"ط",1,0],["لا يَغيضُ اِنسِجامُ عَيني علَيهِم","إِنَّما غايَةُ الحَزينِ السِجامُ",35,"م",1,0],["لا يُغمِدُ السَيفَ وَلا يَسورُ","لَقَد غَبينا وَالدَواهي عورُ",36,"ر",1,0],["لا يَغُرَّنَّكَ يَومٌ مِن غَدٍ","صاحِ إِنَّ الدَهرَ يُغفي وَيَهُب",37,"ب",1,0],["لا يَغفَلُ القَلبُ عَن لَيلى وَقَد غَفَلَت","عَمّا يُلاقي شَجٍ بِالحُبِّ مُغتَرِبُ",38,"ب",1,0],["لا يُغبَطَنَّ أَخو نُعمى بِنِعمَتِهِ","بِئسَ الحَياةُ حَياةٌ بَعدَها الشَجَبُ",39,"ب",1,1],["لا يَغرَضِ المَرءُ مِمّا يَغتَدي غَرِضاً","يُمسي وَيُضحي بِنَبلِ الدَهرِ مَرشوقا",40,"ق",2,0],["لا يَغبَطَن ماشٍ فَوارِسَ شُزَّبٍ","ما فارِسٌ إِلّا كَآخَرَ راجِلِ",41,"ل",1,1],["لا يَغضَب الناس من مَقالي","إن قلتُ أَصل الإنسان حيوانْ",42,"ن",1,1],["لأي غورٍ زال عن عرشه","وغاص في اللجِّ إلى أيِّ قاع",43,"ع",1,0],["لا يَغرُبُ الوَصلُ فيما بَينَنا أَبَداً","لَو كُنتِ واجِدَةً مِثلَ الَّذي أَجِدُ",44,"د",1,0],["لا يَغُرَّنْكَ ما تَرى مِن ودِادِي","فَلَعلِّي إِنْ شِئْتُ غَيَّرْتُ ودَّا",45,"د",2,0],["لا يَغُرَّنَّكَ ابتسامُ بَني الأرْ","ضِ فَخَلْفَ الشُّعاعِ لَذْعُ اللَّهيبِ",46,"ب",1,0],["لا يَغْنَمُ اللَّذَّةَ غَيْرُ امْرِئٍ","لَيْسَ لَهُ عَنْ لَهْوِهِ زَاجِرُ",47,"ر",1,0],["لا يُغْمِدُ السَّيْفَ إِلَّا بَعْدَ مَلْحَمَةٍ","وَلا يُعَاقِبُ إِلَّا بَعْدَ تَحْذِيرِ",48,"ر",1,0],["لا يغضبُ 