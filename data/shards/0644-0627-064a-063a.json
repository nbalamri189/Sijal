s://www.poetsgate.com/ViewPoem.aspx?id=9726",""],[5848,"علوم دقاقة","https://www.poetsgate.com/ViewPoem.aspx?id=48825",""],[6035,"كم كان أَعْدَل لو أَزْرَى بنا الحَجرُ .. !","https://www.poetsgate.com/ViewPoem.aspx?id=177617",""],[6056,"القناعة كنز بايد","https://www.poetsgate.com/ViewPoem.aspx?id=130344",""],[6115,"الناس ذا الوقت ياحاقد ويا حاسد","https://www.poetsgate.com/ViewPoem.aspx?id=180502",""],[6115,"اسمع الرأي المسدد يالحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=180524",""],[6134,"ماذا حملتم على الايدي بلا حذر","https://www.poetsgate.com/ViewPoem.aspx?id=169551",""],[469,"لا يغرنك التودد من قوم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574828",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[6259,"لست في بينها الغداة بلاحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59363&r=&rc=11",""],[6290,"لَكَ فِي الْأَفْئِدَةِ الْغَرَّاءِ حُبٌّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85517&r=&rc=35",""]],"verses":[["لا يَغُبُّ الحادي العَنيفُ وَلا يَف","تُرُ عَن رَنَّةِ العَديلِ العَديلُ",0,"ل",1,0],["لا يَغرُرَنَّكَ أَنَّهُم بِسِهامِهِم","أَشوَوا وَما بَلَغوا مَدى ما أَمَّلوا",1,"ل",3,0],["لا يَغرُرَنَّكَ سِلمٌ جاءَ يَطلُبُهُ","لَم يَخطُبِ السَلمَ إِلّا بَعدَ ما عُقِرا",2,"ر",2,1],["لا يَغرُرَنَّكُمُ تَناوُمُ ضَيغَمٍ","وَتَناذَروا وَثَباتِ أَغلَبَ مُلبِدِ",3,"د",1,0],["لا يغْلِبُ الحَقَّ بهِ باطِلٌ","ولا يُداني الجِدَّ منهُ مِزاحْ",4,"ح",1,0],["لاَ يَغْرُرَنَّ الرَّومَ فِي إِمْلاَئِهَا","قَدَرٌ فأَيَّامُ الْحُرُوبِ تَدُولُ",5,"ل",1,0],["لا َيَغْرُرَنَّ الرَّومَ فِي إِمْلائِهاَ","قَدَرٌ جَرَى فَاٌلْحَرْبُ هَاتِ وَهَاكَا",6,"ك",2,0],["لا يَغْرُرِ الرّومَ ما نالُوا وما فَعَلوا","فإنّ ذلِكَ إمْلاءٌ الى أمَدِ",7,"د",1,0],["لا يغُرَّنّك الزمان إذا ما","لك أبدى بشاشة وابتساما",8,"م",2,0],["لا يغضبون لأمرٍ عمّ باطله","كأنهم غير مخلوقين من عصب",9,"ب",1,0],["لايَغضَبونَ لِغَيرِ اللَهِ إِن غَضِبوا","وَلا يُضيعونَ حُكمَ اللَهِ إِن حَكَموا",10,"م",3,0],["لا يغرهم بندىً يأتيهمُ فكفى","مدحاً بأن يتأتَّى منك إنصات",11,"ت",1,0],["لا يَغُرَّنَّكَ المُماذِقُ بالظا","هر في حال مدة الالتقاءِ",12,"ا",2,0],["لا يغيظنَّ معشراً حسدوني","أنْ توالت إجادتي تمجيدَكْ",13,"ك",1,0],["لا يغْضَبنّ لعمرو من له خطرٌ","فليس يرضى بضيمي من له خَطَرُ",14,"ر",1,1],["لا يغضبُ العبدُ على ربهِ","ويَغضبُ الصاحبُ والخِلُّ",15,"ل",1,0],["لا يغرَّنَّكم بجهليَ حلمي","وارعوائي إلى حيائي وديني",16,"ن",2,0],["لا يَغُرَّ الحُسنُ ذا الحُسنِ فَقَد","يَصرَعُ البُلبُلَ صَوتُ البُلبُلِ",17,"ل",1,0],["لا يغرنك العيشة برق","وامضُ في سحابه فهو خلب",18,"ب",1,0],["لا يَغُرَّنكَ يا أَخا البيدِ مِن مَو","لاكَ ذاكَ القَبولُ وَالإِقبالُ",19,"ل",1,0],["لا يَغمِدُ السَيفَ إِلّا ما يُجَرِّدَهُ","عَلى قَفا مُحرِمٍ بِالسوقِ مَصلوبِ",20,"ب",1,0],["لا يَغْرِسُ الشَّرَّ غارِسٌ أبداً","إلا اجتَنى من غُصونِهِ نَدَما",21,"م",2,0],["لا يُغَيُّركَ ما تَقولُ الأَعادي","فَبِناءُ الوِدادِ فَوقَ أَساسِ",22,"س",1,0],["لا يَغْضَبُونَ وَلا يُحْمَى لَهُمْ حَرَمٌ","وَإِنْ تَكُنْ دُونَهُمْ أَسْيَافُهُمْ نَضَدَا",23,"د",2,0],["لا يَغْتررْ بالعفوِ من سلمه","أعداؤهُ فالحربُ دار انتقام",24,"م",1,0],["لا يغرّنّكَ منها خَجَلٌ","إنّها تُبديه في خدٍّ وَقَاح",25,"ح",1,0],["لا يغرنَّكَ لينٌ مِنتْ فتى","إنَّ للحيّاتِ لينٌ يُعتزَلْ",26,"ل",1,0],["لا يغيِّرْكُم الصعيدُ وكونوا","فيهِ مثلَ السيوفِ في الأغمادِ",27,"د",1,0],["لا يَغُرَّنَ قويّاً جُندُه","قُوّةٌ صَرْعَى وجُندٌ مُنهزِمْ",28,"م",1,0],["لا يَغْلِبِ الحقَّ يَرْدَى في كتائبهِ","جُنْدُ الدّراهمِ أو جيشُ الدّنانيرِ",29,"ر",1,0],["لا يَغضَبِ المَجدُ إِنَّ الحُرَّ يَفدَحُهُ","ظُلمُ البَريءِ وَنَصرُ الجارِمِ الجاني",30,"ن",2,0],["لاَ يَغُرَّنَّهم من الغيثِ وَكفٌ","إنّه السيلُ مُوشِكٌ أن يَعُمَّا",31,"م",2,0],["لا يغرَّنْكم رَسُولٌ جاءكم","مُبغض القلب محب المنطقِ",32,"ق",1,0],["لا يَغرَقُ البَحرُ في غَمرِ السَرابِ وَلا","يُخِلُّ بِالنَبعِ فَرعُ الضالِ وَالسَلَمِ",33,"م",1,0],["لِأَيِّ غاياتي أَجري بَعدَما","رَأَيتُ أَترابي وَقَد صاروا تُرَب",34,"ب",1,0],["لا يغتدي فَرِحاً بالمالِ يجمعُهُ","ولا يبِيتُ بدُنْيا وهو مغتبط",35,"ط",1,0],["لا يَغيضُ اِنسِجامُ عَيني علَيهِم","إِنَّما غايَةُ الحَزينِ السِجامُ",36,"م",1,0],["لا يُغمِدُ السَيفَ وَلا يَسورُ","لَقَد غَبينا وَالدَواهي عورُ",37,"ر",1,0],["لا يَغُرَّنَّكَ يَومٌ مِن غَدٍ","صاحِ إِنَّ الدَهرَ يُغفي وَيَهُب",38,"ب",1,0],["لا يَغفَلُ القَلبُ عَن لَيلى وَقَد غَفَلَت","عَمّا يُلاقي شَجٍ بِالحُبِّ مُغتَرِبُ",39,"ب",1,0],["لا يُغبَطَنَّ أَخو نُعمى بِنِعمَتِهِ","بِئسَ الحَياةُ حَياةٌ بَعدَها الشَجَبُ",40,"ب",1,1],["لا يَغرَضِ المَرءُ مِمّا يَغتَدي غَرِضاً","يُمسي وَيُضحي بِنَبلِ الدَهرِ مَرشوقا",41,"ق",2,0],["لا يَغبَطَن ماشٍ فَوارِسَ شُزَّبٍ","ما فارِسٌ إِلّا كَآخَرَ راجِلِ",42,"ل",1,1],["لا يَغضَب الناس من مَقالي","إن قلتُ أَصل الإنسان حيوانْ",43,"ن",1,1],["لأي غورٍ زال عن عرشه","وغاص في اللجِّ إلى أيِّ قاع",44,"ع",1,0],["لا يَغرُبُ الوَصلُ فيما بَينَنا أَبَداً","لَو كُنتِ واجِدَةً مِثلَ الَّذي أَجِدُ",45,"د",1,0],["لا يَغُرَّنْكَ ما تَرى مِن ودِادِي","فَلَعلِّي إِنْ شِئْتُ غَيَّرْتُ ودَّا",46,"د",2,0],["لا يَغُرَّنَّكَ ابتسامُ بَني الأرْ","ضِ فَخَلْفَ الشُّعاعِ لَذْعُ اللَّهيبِ",47,"ب",1,0],["لا يَغْنَمُ اللَّذَّةَ غَيْرُ امْرِئٍ","لَيْسَ لَهُ عَنْ لَهْوِهِ زَاجِرُ",48,"ر",1,0],["لا يُغْمِدُ السَّيْفَ إِلَّا بَعْدَ مَلْحَمَةٍ","وَلا يُعَاقِبُ إِلَّا بَعْدَ تَحْذِيرِ",49,"ر",1,0],["لا يغرّنك سحرها ورؤاها","جنّتي وحدها الرضى والأمان",50,"ن",1,0],["لا يغضبُ العبدُ على ربهِ","ويُغضبُ الصاحبَ الخِلُّ",51,"ل",1,0],["لا يغرنك ما ترى من أناتي","واحتبائي بالحلم والأغضاء",52,"ا",2,0],["لا يغرنك تقبيلهم","يدك اليوم وتقريظ ومدح",53,"ح",1,0],["لا يغرَّنْكَ التضاحكُ في النادِ","فما كل ضاحكٍ بالظهيرِ",54,"ر",1,0],["لا يغررنك منه الابتسام إذا","دنا إليك ولا تيأس إذا نفرا",55,"ر",2,0],["لا يغررنك ما يرى من سمته","فالخير كل الخير في اجتنابه",56,"ب",2,0],["لا يَغُرَّنكُمُ اِنبِعاثي رُوَيداً","إِنَّ هَمّي بِالفَرقَدَينِ مَنوطُ",57,"ط",1,0],["لا يَغُرَّنكِ سَما","حي فَمُقتادي عَنيفُ",58,"ف",1,0],["لا يَغْرُرَنَّك من يَها","ب ولا يَروقُك من يَوَدُّك",59,"ك",1,0],["لا يَغْررُنَّك أنْ تُها","ب ولا يروقُك من يَرُدّك",60,"ك",1,0],["لا يغريّنك بالذنو","ب إلى أخ حسنُ اعتذارك",61,"ك",1,0],["لا يُغنّي في العَظمِ إِلّا إِذا أَص","ب