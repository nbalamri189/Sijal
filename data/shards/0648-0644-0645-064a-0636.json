{"poems":[[88,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[87,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[276,"لي في نوالك يا مولاي آمال","https://www.aldiwan.net/poem52046.html","البسيط"],[285,"متى ارتجعت مواهبها الكرام","https://www.aldiwan.net/poem60717.html","الوافر"],[376,"إن ضاع قصدي لكم فكم سفر","https://www.aldiwan.net/poem57411.html","الطويل"],[466,"دعوا دمعي بيوم البين يجري","https://www.aldiwan.net/poem16086.html","الوافر"],[556,"فديته من زائر زارني","https://www.aldiwan.net/poem48040.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138409",""],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25344","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102153","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137352",""],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103299","السريع"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76695","السريع"]],"verses":[["وَلَم يَضِرهُم سُراءٌ في مَناكِبِها","فَكُلِّ حَيٍّ لَهُ في الكَونِ مُضطَرَبُ",0,"ب",1,0],["وَلَم يَضَع حَجَراً بانٍ عَلى حَجَرٍ","في الأَرضِ إِلّا عَلى آثارِ بانينا",1,"ن",2,0],["وَلَم يضق بي منك العفوان ختمت","لي بالشهادة أَقوال وَأَفعال",2,"ل",1,0],["وَلَمْ يَضَعِ السَّرْدِ عَنْ مَنْكِبَيْ","هِ حَتّى يَصِيرَ مَعَ الْجِلْدِ جِلْدا",3,"د",2,0],["ولم يضع قد رأيتُ منك بها","عجائبَ البحرِ في جزائِرِه",4,"ه",1,0],["ولم يَضرعْ لجبَّارٍ رجاءً","لمعروفٍ ولو أمْسى بضرِّ",5,"ر",1,0],["ولم يَضِرْها أنّها زَورَةٌ","لعازبِ الآراء مكذوبِ",6,"ب",1,0],["ولم يضع احمدٌ لكنّه فرط","في جنة الخلد مسرور برضوان",7,"ن",1,0],["وَلَمْ يُضعْها بَيْنَ فِرْكٍ وَعَشَقْ","لا يَتْرُكُ الغَيْرَةَ مِنْ عَهْدِ الشَبَقْ",8,"ق",1,0],["ولم يضيفوا قلماً لكسرِ","غير الذي ذكرت فيما استقري",9,"ي",1,0],["ولم يضطَرِب من حادثِ الدهر قلبهُ","وإن أرعدَ الأعداءُ عمداً وأبرَقُ",10,"ق",1,0],["ولم يض يوم دون ان يسمع الورى","بماءثرة عن دركها يعجر الفكر",11,"ر",1,0],["ولم يُضَيَّع فارسيُّ الندى","في عربيِّ الحمدِ والشكرِ",12,"ر",1,0],["ولم يضق دهر على أمّةٍ","الا أصابوا بذراه انفساح",13,"ح",1,0]]}