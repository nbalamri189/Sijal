{"poems":[[55,"لمن دمن بذي سلم وضال","https://www.aldiwan.net/poem29896.html","الوافر"],[65,"رنت إلي وظل النقع ممدود","https://www.aldiwan.net/poem46194.html","البسيط"],[95,"تعجبني رؤية حوليكم","https://www.aldiwan.net/poem11070.html","السريع"],[95,"يا عائدون من الجهاد سلام","https://www.aldiwan.net/poem11295.html","الكامل"],[56,"يا واقفا يبكي الطلول وينشد","https://www.aldiwan.net/poem27436.html","الكامل"],[90,"تذكرت في أوطاني الأهل والصحبا","https://www.aldiwan.net/poem44451.html","الطويل"],[74,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[74,"هنيئا لأفق الفضل إنك بدره","https://www.aldiwan.net/poem18711.html","الطويل"],[74,"ماذا على ذي الحسن لو","https://www.aldiwan.net/poem20298.html","مجزوء الكامل"],[74,"ومصاحب تلقاه عند عيوبه","https://www.aldiwan.net/poem20341.html","الكامل"],[93,"يا رب قائلة والقول أجمله","https://www.aldiwan.net/poem8757.html","عموديه"],[91,"البحر يغلى كان البحر بركان","https://www.aldiwan.net/poem44779.html","البسيط"],[91,"كذب الرجاء فما نجيب يرجع","https://www.aldiwan.net/poem44935.html","الكامل"],[45,"لهوى النفوس سريرة لا تعلم","https://www.aldiwan.net/poem10567.html","الكامل"],[64,"هذا الزمان يزف أبكار العلى","https://www.aldiwan.net/poem52319.html","الطويل"],[64,"هو الشوق حتى ما تقر المضاجع","https://www.aldiwan.net/poem52357.html","الطويل"],[64,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[47,"عهدي بربعك مأنوسا ملاعبه","https://www.aldiwan.net/poem10906.html","البسيط"],[68,"يا هلالا من سلطة العي حيي","https://www.aldiwan.net/poem38473.html","الخفيف"],[68,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[68,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[68,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[99,"متى يرق الحظ يا قاسي","https://www.aldiwan.net/poem24796.html","السريع"],[99,"ألمي محا ذنبي إليك وكفرا","https://www.aldiwan.net/poem24995.html","الكامل"],[82,"أإن بكت ورقاء في غضن بان","https://www.aldiwan.net/poem31262.html","السريع"],[46,"لمكاسر الحسن بن وهب أطيب","https://www.aldiwan.net/poem30585.html","الكامل"],[107,"ترامى الجيش واندفع الرعيل","https://www.aldiwan.net/poem44191.html","الوافر"],[21,"يرن على مغزيات العقاق","https://www.aldiwan.net/poem36179.html","المتقارب"],[54,"سار الرفيق لقصده وتلبثا","https://www.aldiwan.net/poem27183.html","الكامل"],[48,"أراك زنيما إذا تعرضت ليلة","https://www.aldiwan.net/poem23340.html","الطويل"],[78,"هتك الحجاب عن الضمائر","https://www.aldiwan.net/poem39327.html","مجزوء الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55147","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54880","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55146","السريع"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142033","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[108,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[108,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[47,"عَهْدي بِرَبْعِكَ مَأنوساً مَلاعِبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=31545",""],[93,"الرجل والمرأة","https://www.poetsgate.com/ViewPoem.aspx?id=14081",""],[96,"الكعبة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=12696",""],[102,"ساعة نقاش مع طالبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67693&r=&rc=180",""],[124,"إني بلا مهلة أقول في مهل","https://www.aldiwan.net/poem23817.html","البسيط"],[145,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[177,"ومحجب نبهته","https://www.aldiwan.net/poem46028.html","مجزوء الكامل"],[196,"أهلا بنرجس روض","https://www.aldiwan.net/poem12993.html","المجتث"],[200,"ولهان ذو خافق رقت حواشيه","https://www.aldiwan.net/poem39877.html","البسيط"],[202,"أمن الظبا ذاك الغرير المعجب","https://www.aldiwan.net/poem45580.html","الكامل"],[213,"سلوا فاتر الأجفان عن كبدي الحرا","https://www.aldiwan.net/poem13338.html","الطويل"],[213,"حتام تخلف وعدي","https://www.aldiwan.net/poem13529.html","المجتث"],[235,"بدا فأراني الظبي والغصن والبدرا","https://www.aldiwan.net/poem14761.html","الطويل"],[253,"وافي إليك بلهوه النيروز","https://www.aldiwan.net/poem14982.html","الكامل"],[262,"حبيب القلب أضحى فيه حاضر","https://www.aldiwan.net/poem35756.html","الوافر"],[274,"أيرجع لي قرب الحبيب المعاهد","https://www.aldiwan.net/poem52107.html","الطويل"],[285,"عذولي لا تلمني في هلالي","https://www.aldiwan.net/poem32663.html","الوافر"],[285,"جاء الربيع وروضه الممطور","https://www.aldiwan.net/poem32758.html","الكامل"],[285,"أفدي الذي زار بعد هجر","https://www.aldiwan.net/poem32890.html","مخلع البسيط"],[300,"لك الخير إن جزت اللوى والمطاليا","https://www.aldiwan.net/poem33081.html","الطويل"],[300,"وعود به عود المسرة مورق","https://www.aldiwan.net/poem33153.html","الطويل"],[300,"أدر المدامة بالكبير","https://www.aldiwan.net/poem33264.html","مجزوء الكامل"],[300,"تذكر والذكرى تهيج أخا الوجد","https://www.aldiwan.net/poem33290.html","الطويل"],[301,"مضناك حين أمض البين مضناك","https://www.aldiwan.net/poem36804.html","عموديه"],[301,"أعطى قليلا واستردا","https://www.aldiwan.net/poem36857.html","عموديه"],[345,"أو ما رأيت إلى شئونه","https://www.aldiwan.net/poem55342.html","مجزوء الكامل"],[356,"وأغيد معسول الرضاب رجوته","https://www.aldiwan.net/poem39748.html","الطويل"],[356,"صلوا حبل ودي يا كرام وزوروا","https://www.aldiwan.net/poem40349.html","الطويل"],[383,"قد رق برق الحندس","https://www.aldiwan.net/poem48809.html","مجزوء الكامل"],[405,"سرى طيفها وهنا إلي فحياني","https://www.aldiwan.net/poem46755.html","البسيط"],[419,"ما ودع الصب المشوق وما قلى","https://www.aldiwan.net/poem53997.html","الكامل"],[419,"طرف يراعي النجم وهو مؤرق","https://www.aldiwan.net/poem54166.html","الكامل"],[432,"وافى يميس فاخجل الغصن الرطب","https://www.aldiwan.net/poem39900.html","الكامل"],[454,"أرن في عذبات الأيك مرنان","https://www.aldiwan.net/poem13930.html","البسيط"],[463,"مظفر الدين إن فاق الرجال فقد","https://www.aldiwan.net/poem15173.html","البسيط"],[463,"عداك الردى والذم كم من فصيحة","https://www.aldiwan.net/poem15677.html","الطويل"],[463,"واني لمثن ما تغنت حمامة","https://www.aldiwan.net/poem15965.html","الطويل"],[463,"منازلكم للخائفين عصام","https://www.aldiwan.net/poem16033.html","الطويل"],[463,"وركب كالصقور سروا بليل","https://www.aldiwan.net/poem16269.html","الوافر"],[466,"قسماً لقد أملى أحاديث الغضا","https://www.aldiwan.net/poem3531.html","عموديه"],[467,"على سناك سلام الله","https://www.aldiwan.net/poem36230.html","عموديه"],[479,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[479,"أبثك ما بي أم كفاك نحولي","https://www.aldiwan.net/poem15347.html","الطويل"],[502,"هل العناية إلا أن ترى رجلا","https://www.aldiwan.net/poem38034.html","البسيط"],[516,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[553,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[564,"لاحت بوجه بديع الأنس ميمون","https://www.aldiwan.net/poem52847.html","البسيط"],[569,"وشقائق خجلت ملاحة لونه","https://www.aldiwan.net/poem69563.html","الكامل"],[792,"","https://poetry.dctabudhabi.ae/diwan/poem/29558","الطويل"]],"verses":[["يُرَنِّحُني إِلَيكَ الشَوقُ حَتّى","أَميلُ مِنَ اليَمينِ إِلى الشِمالِ",0,"ل",1,0],["يَرنو إِلى عَذَباتِ الوِرْدِ مِنْ ظَمأٍ","لَحظَ الطّريدةِ حيثُ الماءُ مَثمودُ",1,"د",1,0],["يرنو إلى البربون في جنبه","وقد زهت بالحسن منه الحلل",2,"ل",1,0],["يَرْنُو إِلَى هَذِي السَّفِينَةِ مِنْ عَلٍ","سَعْدُ السُّعُودِ وَثَغْرَهُ بَسَّامُ",3,"م",1,0],["يَرنو لِوالِدِهِ وَيَرنو حالَهُ","وَبَنو أُمَيَّةَ في العَمى لَم يَهتَدوا",4,"د",3,0],["يرنّ بجوف الطود صوت دويّها","إذا ولجت في جوفه النفق الرحبا",5,"ب",2,0],["يرنو إليك الحجر المجتلى","يا أيُّها العين بمسوده",6,"د",2,0],["يرنحه شدْوُ السؤال كأنما","تثنَّت بعطفيه وحاشاه خمره",7,"ر",2,0],["يرنو ويشرق حسنه","في ناظري ولهانه",8,"ن",2,0],["يرنو إلى سرب الظبا لحظه","فيسرق الكحل من العين",9,"ن",1,0],["يَرنو فَتَضطَرِبُ الآسادُ خائِفَةً","فَإِن رَنَت ذاتُ حُسنٍ ظَلَّ مُضطَرِبا",10,"ب",2,0],["يرنو مليا الى فلك تقاذفه","في اللج امواجه والفلك هيمان",11,"ن",1,0],["يرنو إليها من نوافذ بيتهِ","وإليهِ من شباكها تتطلع",12,"ع",1,0],["يَرنو إِلَيكِ مَعَ العَفافِ وَعِندَهُ","أَنَّ المَجوسَ تُصيبُ فيما تَحكُمُ",13,"م",1,0],["يرنو إليكَ بطرفِ جانٍ آملٍ","نسيانَ ذنبٍ من جرائمِه خَلا",14,"ل",2,0],["يُرنِّقْنَ شُربي وهو صافٍ جمامُهُ","ويُحْرِجْنَ صدري وهو أفيحُ واسعُ",15,"ع",1,0],["يُرنِّحُها سُقْيا الدماءِ كأنَّها","مُدامٌ وآثار الطِّعانِ أكاوِيبُ",16,"ب",1,0],["يُرَنِّقُ النَسرُ في جَوِّ السَماءِ وَقَد","أَوما إِلَيهِ شُعاعُ الشَمسِ ياذِبُهُ",17,"ب",2,0],["يَرنو بِعَينٍ تُغنيهِ في قَتلِهِ العُش","شاقَ عَن كُلِّ ذابِلٍ يَزَنِيِّ",18,"ي",1,0],["يَرنونَ بِالأَلحاظِ شَزراً كُلَّما","صَبَغَت أَشِعَّتُها أَكُفَّ سُقاتِها",19,"ت",3,0],["يُرَنِّحُهُ سَمعُ المَديحِ تَكَرُّماً","وَإِنَّ لَبيداً عِندَهُ لَبَليدُ",20,"د",1,0],["يَرنو إِلى حُبُكِ السَماءِ تَوَهُّماً","أَنَّ المَجَرَّةَ حَلبَةُ المَيدانِ",21,"ن",1,0],["يرنو له الناس ويبغونه","وما يبالي النجم بالناسِ",22,"س",1,0],["يرنو إليك على البعاد ويعتلي","فيجره الجرح المميت إلى الثرى",23,"ر",2,0],["يُرَنّحُ الغصْنَ نسيمٌ بها","مُعَانقٌ بين الغصون اللّدان",24,"ن",1,0],["يَرنو فَيَثلِمُ في القُلوبِ بِطَرفِهِ","وَيَعِنُّ لِلنَظَرِ الحَرونِ فَيُصحِبُ",25,"ب",1,0],["يُرنِّقُ عَيْشَهم جُوعٌ وخَوْفٌ","كِلاَ الخطبَيْنِ أيْسرُهُ جَليلُ",26,"ل",1,0],["يَرِنُّ عَلى مُغزياتِ العِقاقِ","وَيَقرو بِها قَفِراتِ الصِلالِ",27,"ل",1,1],["يَرنو بِناظِرَةٍ تُذيبُ بِلَحظِها","مُهَجَ النُفوسِ تَقَتُّلاً وَتَأَنُّثا",28,"ث",2,0],["يُرَنِّمنَ بِالدُرِّ الثَمينِ مَسامِعاً","وَيَزجرنَ لِلبَينِ السَوامَ المُزَنَّما",29,"م",2,0],["يَرْنُو فَيَمْتَحنُ القُلو","ب كَأَنَّهُ في القَلبِ نَاظِرْ",30,"ر",1,0],["يَرنو إليك بإعجا","بٍ من جميع النواحي",31,"ي",1,0],["يَرْنُو إِلى الذَّرِّ الدَّقِيقِ مِنَ الثَّرَى","فَيَرَى دَرَارِيَ لَمْ تُضَأ بِذُبَالِ",32,"ل",1,0],["يَرْنُو إِلى صُفْرِ الشَّوَاطِيءِ نُطِقَتْ","أَعْطَافُهَا بِالأَزْرَقِ الزَّخَّارِ",33,"ر",1,0],["يَرْنو بِفَائِضَتَيْ سَنىً","كَالجَوْهَرِ المُتَطلَّعِ",34,"ع",1,0],["يُرِنُّ إِرْنانَ سِهَامٍ رَمَتْ","حَيْثُ رَمَتْ بِالشُّعَلِ الحمْرِ",35,"ر",1,0],["يرَنْو إِلى العَلْيا بِسَامي طَرْفِهِ","وَيُلاَحِظُ الدُّنْيَا بِلاَ إِزْرَاءِ",36,"ا",2,0],["يَرْنُو إِلَى السُّلْطَانِ فِي جَنْبِهِ","وَقَدْ زَهَتْ بِالحُسْنِ مِنْهُ الحُلَلِ",37,"ل",1,0],["يرنو إليك ولا يرى وكأنه","ينسى محطّ يديه حين يسلّم",38,"م",1,0],["يَرْنُو بِعَيْنٍ عَلَى الظَّلْمَاءِ صَادِقَةٍ","كَأَعْيُنِ النَّسْرِ أَنّى صُوّبَتْ تُصِبِ",39,"ب",1,0],["يَرنو إلى استقلال مصر كما رنَتْ","عين المحب لطارقِ الأطياف",40,"ف",1,0],["يَرْنُو فَيُرْخِي حَيَاءً","مِنَ الْكِمامِ نِقَابا",41,"ب",2,0],["يَرْنُو إِلَيْهِ الْعَائِدُونَ بِأَعْيُنٍ","غُزْرِ الدُّمُوعِ كَثِيرةِ التَّسآل",42,"ل",1,0],["يرنو إليه الطرْف غيرَ منكس","والبدر يظهر من سناه خجولا",43,"ل",2,0],["يَرنُو إليهم صخرُها","فيذوبُ من فَرْط الحنين!",44,"ن",1,0],["يُرَنِّقُ النّسْرُ في جَوّ السّماءِ، وَقَدْ","أوْمَا إليْهِ شُعَاعُ الشّمسِ يَأدِبُهُ",45,"ب",2,0],["يرنو فتضطرب الآساد خائفة","فإن رنت حسن ظلّ مضطربا",46,"ب",2,0],["يرنّح شعري باللوى كلّ بانة","ويندى بشعري فيه كلّ كثيب",47,"ب",1,0],["((يرنو من خلف التيه كما","ترنو الحيطان إلى الحيطان))",48,"ن",1,0],["يرنو لقارئه بعين رحمته","يدنو به أبداً بغير منفصلِ",49,"ل",1,0],["يرنو الزمان إلى معاندِه","حنَقاً عليه بأعينٍ قُبْلِ",50,"ل",1,0],["يَرْنُو بِمُقْلَةِ جُؤْذَرٍ","لَمْ يَخْلُ يَوْماً مِنْ قَتِيلِ",51,"ل",1,0],["يَرنو بِعَينٍ غَزالٍ","عَلى قَضيبٍ رَطيبِ",52,"ب",1,0],["يرنو إليها كما يرنو المريض وما","أبلّ بعد إلى عيني مداويه",53,"ي",2,0],["يرنو فتنتزعُ القلوبَ لحاظُهُ","وتكادُ أنفسنا عليهِ تذهبُ",54,"ب",1,0],["يرنحه لطف النسيم اذا سرى","ويهدي لنا من طي ايراده نشرا",55,"ر",2,0],["يرنو بيض