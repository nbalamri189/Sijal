d=151697",""],[5309,"يرن بآفاق الحيا قصيدنا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573592",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[1710,"إركب اذا دارت رحاها وانزل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=530612",""],[6210,"قالت لي الريح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7244&r=&rc=16",""],[6212,"جُبَر.. ومئةُ عامٍ من المطر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1625&r=&rc=6",""],[6231,"مقطوعة ل السفر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84913&r=&rc=3",""],[6256,"سُجُوّ الغروب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65922&r=&rc=10",""],[2220,"الحمدُ للهِ جلَّ الله منْ واقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11608&r=&rc=482",""]],"verses":[["يُرَنِّحُني إِلَيكَ الشَوقُ حَتّى","أَميلُ مِنَ اليَمينِ إِلى الشِمالِ",0,"ل",1,0],["يَرنو إِلى عَذَباتِ الوِرْدِ مِنْ ظَمأٍ","لَحظَ الطّريدةِ حيثُ الماءُ مَثمودُ",1,"د",1,0],["يرنو إلى البربون في جنبه","وقد زهت بالحسن منه الحلل",2,"ل",1,0],["يَرْنُو إِلَى هَذِي السَّفِينَةِ مِنْ عَلٍ","سَعْدُ السُّعُودِ وَثَغْرَهُ بَسَّامُ",3,"م",1,0],["يَرنو لِوالِدِهِ وَيَرنو حالَهُ","وَبَنو أُمَيَّةَ في العَمى لَم يَهتَدوا",4,"د",3,0],["يرنّ بجوف الطود صوت دويّها","إذا ولجت في جوفه النفق الرحبا",5,"ب",2,0],["يرنو إليك الحجر المجتلى","يا أيُّها العين بمسوده",6,"د",2,0],["يرنحه شدْوُ السؤال كأنما","تثنَّت بعطفيه وحاشاه خمره",7,"ر",2,0],["يرنو ويشرق حسنه","في ناظري ولهانه",8,"ن",2,0],["يرنو إلى سرب الظبا لحظه","فيسرق الكحل من العين",9,"ن",1,0],["يَرنو فَتَضطَرِبُ الآسادُ خائِفَةً","فَإِن رَنَت ذاتُ حُسنٍ ظَلَّ مُضطَرِبا",10,"ب",2,0],["يرنو مليا الى فلك تقاذفه","في اللج امواجه والفلك هيمان",11,"ن",1,0],["يرنو إليها من نوافذ بيتهِ","وإليهِ من شباكها تتطلع",12,"ع",1,0],["يَرنو إِلَيكِ مَعَ العَفافِ وَعِندَهُ","أَنَّ المَجوسَ تُصيبُ فيما تَحكُمُ",13,"م",1,0],["يرنو إليكَ بطرفِ جانٍ آملٍ","نسيانَ ذنبٍ من جرائمِه خَلا",14,"ل",2,0],["يُرنِّقْنَ شُربي وهو صافٍ جمامُهُ","ويُحْرِجْنَ صدري وهو أفيحُ واسعُ",15,"ع",1,0],["يُرنِّحُها سُقْيا الدماءِ كأنَّها","مُدامٌ وآثار الطِّعانِ أكاوِيبُ",16,"ب",1,0],["يُرَنِّقُ النَسرُ في جَوِّ السَماءِ وَقَد","أَوما إِلَيهِ شُعاعُ الشَمسِ ياذِبُهُ",17,"ب",2,0],["يَرنو بِعَينٍ تُغنيهِ في قَتلِهِ العُش","شاقَ عَن كُلِّ ذابِلٍ يَزَنِيِّ",18,"ي",1,0],["يَرنونَ بِالأَلحاظِ شَزراً كُلَّما","صَبَغَت أَشِعَّتُها أَكُفَّ سُقاتِها",19,"ت",3,0],["يُرَنِّحُهُ سَمعُ المَديحِ تَكَرُّماً","وَإِنَّ لَبيداً عِندَهُ لَبَليدُ",20,"د",1,0],["يَرنو إِلى حُبُكِ السَماءِ تَوَهُّماً","أَنَّ المَجَرَّةَ حَلبَةُ المَيدانِ",21,"ن",1,0],["يرنو له الناس ويبغونه","وما يبالي النجم بالناسِ",22,"س",1,0],["يرنو إليك على البعاد ويعتلي","فيجره الجرح المميت إلى الثرى",23,"ر",2,0],["يُرَنّحُ الغصْنَ نسيمٌ بها","مُعَانقٌ بين الغصون اللّدان",24,"ن",1,0],["يَرنو فَيَثلِمُ في القُلوبِ بِطَرفِهِ","وَيَعِنُّ لِلنَظَرِ الحَرونِ فَيُصحِبُ",25,"ب",1,0],["يُرنِّقُ عَيْشَهم جُوعٌ وخَوْفٌ","كِلاَ الخطبَيْنِ أيْسرُهُ جَليلُ",26,"ل",1,0],["يَرِنُّ عَلى مُغزياتِ العِقاقِ","وَيَقرو بِها قَفِراتِ الصِلالِ",27,"ل",1,1],["يَرنو بِناظِرَةٍ تُذيبُ بِلَحظِها","مُهَجَ النُفوسِ تَقَتُّلاً وَتَأَنُّثا",28,"ث",2,0],["يُرَنِّمنَ بِالدُرِّ الثَمينِ مَسامِعاً","وَيَزجرنَ لِلبَينِ السَوامَ المُزَنَّما",29,"م",2,0],["يَرْنُو فَيَمْتَحنُ القُلو","ب كَأَنَّهُ في القَلبِ نَاظِرْ",30,"ر",1,0],["يَرنو إليك بإعجا","بٍ من جميع النواحي",31,"ي",1,0],["يَرْنُو إِلى الذَّرِّ الدَّقِيقِ مِنَ الثَّرَى","فَيَرَى دَرَارِيَ لَمْ تُضَأ بِذُبَالِ",32,"ل",1,0],["يَرْنُو إِلى صُفْرِ الشَّوَاطِيءِ نُطِقَتْ","أَعْطَافُهَا بِالأَزْرَقِ الزَّخَّارِ",33,"ر",1,0],["يَرْنو بِفَائِضَتَيْ سَنىً","كَالجَوْهَرِ المُتَطلَّعِ",34,"ع",1,0],["يُرِنُّ إِرْنانَ سِهَامٍ رَمَتْ","حَيْثُ رَمَتْ بِالشُّعَلِ الحمْرِ",35,"ر",1,0],["يرَنْو إِلى العَلْيا بِسَامي طَرْفِهِ","وَيُلاَحِظُ الدُّنْيَا بِلاَ إِزْرَاءِ",36,"ا",2,0],["يَرْنُو إِلَى السُّلْطَانِ فِي جَنْبِهِ","وَقَدْ زَهَتْ بِالحُسْنِ مِنْهُ الحُلَلِ",37,"ل",1,0],["يرنو إليك ولا يرى وكأنه","ينسى محطّ يديه حين يسلّم",38,"م",1,0],["يَرْنُو بِعَيْنٍ عَلَى الظَّلْمَاءِ صَادِقَةٍ","كَأَعْيُنِ النَّسْرِ أَنّى صُوّبَتْ تُصِبِ",39,"ب",1,0],["يَرنو إلى استقلال مصر كما رنَتْ","عين المحب لطارقِ الأطياف",40,"ف",1,0],["يَرْنُو فَيُرْخِي حَيَاءً","مِنَ الْكِمامِ نِقَابا",41,"ب",2,0],["يَرْنُو إِلَيْهِ الْعَائِدُونَ بِأَعْيُنٍ","غُزْرِ الدُّمُوعِ كَثِيرةِ التَّسآل",42,"ل",1,0],["يرنو إليه الطرْف غيرَ منكس","والبدر يظهر من سناه خجولا",43,"ل",2,0],["يَرنُو إليهم صخرُها","فيذوبُ من فَرْط الحنين!",44,"ن",1,0],["يُرَنِّقُ النّسْرُ في جَوّ السّماءِ، وَقَدْ","أوْمَا إليْهِ شُعَاعُ الشّمسِ يَأدِبُهُ",45,"ب",2,0],["يرنو فتضطرب الآساد خائفة","فإن رنت حسن ظلّ مضطربا",46,"ب",2,0],["يرنّح شعري باللوى كلّ بانة","ويندى بشعري فيه كلّ كثيب",47,"ب",1,0],["((يرنو من خلف التيه كما","ترنو الحيطان إلى الحيطان))",48,"ن",1,0],["يرنو لقارئه بعين رحمته","يدنو به أبداً بغير منفصلِ",49,"ل",1,0],["يرنو الزمان إلى معاندِه","حنَقاً عليه بأعينٍ قُبْلِ",50,"ل",1,0],["يَرْنُو بِمُقْلَةِ جُؤْذَرٍ","لَمْ يَخْلُ يَوْماً مِنْ قَتِيلِ",51,"ل",1,0],["يَرنو بِعَينٍ غَزالٍ","عَلى قَضيبٍ رَطيبِ",52,"ب",1,0],["يرنو إليها كما يرنو المريض وما","أبلّ بعد إلى عيني مداويه",53,"ي",2,0],["يرنو فتنتزعُ القلوبَ لحاظُهُ","وتكادُ أنفسنا عليهِ تذهبُ",54,"ب",1,0],["يرنحه لطف النسيم اذا سرى","ويهدي لنا من طي ايراده نشرا",55,"ر",2,0],["يرنو بيض حداد","تجاوزت كل ضد",56,"د",1,0],["يرَنّحُ عَطفَيهِ الدَلال فَيَنثني","كَما هَزَّ نَشوانٌ مَعاطِفهُ شُكرا",57,"ر",2,0],["يرنُوا إليك بمقلة سَّمارةٍ","هاروتُ في أجفانِها مَركوزُ",58,"ز",1,0],["يرنّم بالغنا شوقاً إليكم","ويصدح فيكم بالحمد شاكر",59,"ر",1,0],["يرنحها سكر الشَبيبة وَالصبا","فعند الهَوى العذرى مطل الموارد",60,"د",1,0],["يُرَنَّحُ في الكثيبِ قَضيبَ بانٍ","رَشيقَ القَدِّ أَهيَفَ ذا اِعتِدالِ",61,"ل",1,0],["يَرنو بِأَعيُنِ غانِياتٍ ما بِها","مِن نَعسَةٍ لَكِن بِهِنَّ فُتورُ",62,"ر",1,0],["يَرنو بِأَجفانِهِ دَلالاً","فَيَنفُثُ السِحرَ في القُلوبِ",63,"ب",1,0],["يرنِّحنَ من هيف القدود ذوابلاً","وَيُنضين من دُعج اللِحاظ مواضيا",64,"ي",2,0],["يرنِّحُ من يُصغي إليه صَبابةً","كَما رنَّحته في الرِياض النَسائمُ",65,"م",1,0],["يَرنو إليكَ بمقلةٍ","وَسنى الجُفون من الفُتورِ",66,"ر",1,0],["يُرَنِّحُها زَهوُ الصِباحين تَنثَني","كَما رنَّحت ريحُ الصبا عَذبَ المُلدِ",67,"د",1,0],["يرنّ أرنانَ أوّاهٍ تملَّكه","حالٌ يباعدُ عن حسٍّ وَإدراك",68,"ك",1,0],["يرنو وأَرنو فالعيو","ن تجاوبتْ أَخذاً وردا",69,"د",2,0],["يرنو إلى غده وليل ال","شك يظلم في يقينه",70,"ن",2,0],["يُرَنِّحُ مِن أَعطاف بانة قَدِّهِ","مَتى ما عَراني في هَواه فَنىً فَنَن",71,"ن",1,0],["يُرنّحُ مِنهُ عجبه غُصن بانَةٍ","نَضيراً وَلَكن ما حَكاهُ نَظيرُ",72,"ر",1,0],["يَرنو بِلَحظ مطمع","يَخفي وَحي مُوئيس",73,"س",1,0],["يُرنّحهُ سكرُ الصَّبابةِ والصَّبا","كما رنَحَتْ ريحُ الصِّبا غُصُنَ البانِ",74,"ن",1,0],["يرنو فيُرْسِلُ من سهامِ لِحاظِه","سَهماً يصادف من مَشوقٍ مقتلا",75,"ل",2,0],["يرنو إليك بمقلة سحَّارة","تهوى ملاحتها القلوب وتشفق",76,"ق",1,0],["يرنو وقد فعلت بمقلته الطلي","فعل النسيم بنرجس الروض الخصب",77,"ب",1,0],["يرنو بمنْهُوكةِ الألحاظِ فاترةٍ","كأنّما جَفْنُها بالسحْرِ غصَّانُ",78,"ن",1,0],["يَرَ نُقشٌ كسليمانٍ بأشْهبَه","إذا غدا ورخاءُ الريح مركبه",79,"ب",2,0],["يُرنِّحُ طُلابَ المعالي نشيدها","كما رنَّحَ الشَّربَ الكرامَ شمول",80,"ل",1,0],["يُرنِّحُ أعْطافَ الرجالِ كأنهُ","حُمَيَّا عُقارٍ أو دواخنُ منْدلِ",81,"ل",1,0],["يُرَنِّحُني فَرْطُ الحِذار فانني","كما هَزَّ مَخْلوعَ الفُؤادِ لَمامُ",82,"م",1,0],["يُرنِّحها الكَرى ودخيلُ هَمٍّ","لحامِلِهِ التَّخَيُّلُ والحِذارُ",83,"ر",1,0],["يرنو فتهزأُ بالقلوب لحاظه","كسيوف نور الدين تهزأُ بالقضا",84,"ض",2,0],["يَرنُو إلَيهِم ، وَفي عَينَيهِ مَغفِرَةٌ","وَنَظرَةٌ مِلؤها الإشْفاقُ والأسَفُ",85,"ف",1,0],["يرنو اليَّ لظُهُ","فيستَبيني نَظَرا",86,"ر",2,0],["يُرنَّحُها سكرُ الصَّبا فيُميلُها","دلالاً على العلاّتِ كلَّ مَمِيلِ",87,"ل",1,0],["يَرِنُّ من قلبهِ أنٌّ يُزَحْزحهُ","عنِ الوُجودِ ومنهُ القلبُ مَفْقودُ",88,"د",1,0],["يرنو إلى درَقِ الحَديد هوىً كما","يَرنو إلى ورَقِ اللُجَيْنِ المُدْقِعُ",89,"ع",1,0],["يرنّ اِشتكاءً إلى نازلٍ","وإمّا اِشتياقاً إلى راحلِ",90,"ل",1,0],["يرنِّحُ الشِّعرَ عِطْفيهِ