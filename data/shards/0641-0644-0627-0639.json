tml","البسيط"],[459,"لا أوحش الله من جود أسر به","https://www.aldiwan.net/poem16426.html","البسيط"],[459,"هنيئا للمناقب والمعالي","https://www.aldiwan.net/poem16428.html","الوافر"],[462,"جلت عزماتك الفتح المبينا","https://www.aldiwan.net/poem3115.html","عموديه"],[462,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[462,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[466,"وذي حلة من نسيج الزمان","https://www.aldiwan.net/poem60014.html","الكامل"],[475,"أرقت من بارق بالجزع لماع","https://www.aldiwan.net/poem15184.html","البسيط"],[475,"هي الدار قد أقوت ورث جديدها","https://www.aldiwan.net/poem15191.html","الطويل"],[477,"أدرها من سلافك يا نديم","https://www.aldiwan.net/poem37037.html","الوافر"],[477,"جنوني من غرامك في ازدياد","https://www.aldiwan.net/poem37060.html","الوافر"],[498,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[512,"نصال من جفونك أم سهام","https://www.aldiwan.net/poem20794.html","الوافر"],[512,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[536,"بربك هل أبصرت أسخف من عقلي","https://www.aldiwan.net/poem47995.html","عموديه"],[538,"قد كنت أحسبني جلدا فضعضعني","https://www.aldiwan.net/poem56643.html","البسيط"],[538,"فلا عفا الله عن مروان مظلمة","https://www.aldiwan.net/poem56847.html","البسيط"],[549,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[549,"بقاء ولكن لو أتى لا أذمه","https://www.aldiwan.net/poem47249.html","الطويل"],[549,"لنا من ثناياك الغريض المرشف","https://www.aldiwan.net/poem47403.html","الطويل"],[549,"عجبت لشيب في عذاري طالعا","https://www.aldiwan.net/poem48052.html","الطويل"],[556,"أنا العاشق السالي لوجهك يا علو","https://www.aldiwan.net/poem33585.html","الطويل"],[556,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[585,"فإن كان عن ذنب جناه محبكم","https://www.aldiwan.net/poem11554.html","عموديه"]],"verses":[["فَلا عارَ أَن تَستَنجِدَ الكَأسَ راحَةٌ","أَضَرَّ بِها حَملُ الجُرازِ المُصَمِّمِ",0,"م",1,0],["فَلا عَجَبٌ لَهُ في اللَي","لِ إِن ضَلَّت أَباعِرُه",1,"ر",2,0],["فَلا عِزَّ حَتّى يَحْمِلَ المَرْءُ نَفْسَهُ","على خُطَّةٍ يَبْقَى بِها الدَّهْرَ ذِكْرُهُ",2,"ر",2,0],["فلا عاشَ مَنْ يَرْضى بأسْآرِ عِيشَةٍ","تَبرَّضَها إلا ذَليلاً مُهَضَّما",3,"م",2,0],["فَلا عَهْدَ إلاّ بالخَيالِ وبالمُنى","ولا وصْلَ إلاّ بالرّسائِلِ والصُّحْفِ",4,"ف",1,0],["فَلا عَجَبٌ إِذا مُلِكَت عَلَينا","مَذاهِبُنا وَأَكثَرُنا نِيامُ",5,"م",1,0],["فَلا عَيشَ إِلّا مِثلُ عَيشٍ مَضى لَنا","مَصيفاً أَقَمنا فيهِ مِن بَعِ مَربَعِ",6,"ع",1,0],["فلا عيش في الدنيا لمن لم يكن بها","قديراً على دفع الأذى والمكاره",7,"ر",2,0],["فلا عجب من أهل مصر وغيرهم","إذا عقدوا منهم عليه الخناصرا",8,"ر",2,0],["فلا عجب أن راح في الغرب ثاوياً","فإن النجوم الزهر في الغرب تغرب",9,"ب",1,0],["فلا عجبْ أنا نرى كل ساعةٍ","أكفّ المنايا داميات الأظافر",10,"ر",1,0],["فَلا عَهدَ إِلّا أَن تَذَكَّرَ أَو تَرى","ثُماماً حَوالي مَنصَبِ الخَيمِ بالِيا",11,"ي",2,0],["فَلا عَدِمنا لَهُم ثَناءً","كَأَنَّهُ اللُؤلُؤُ النَظيمُ",12,"م",1,0],["فلا عجب للفظي حين يحلو","فهذا القطر من ذاك النبات",13,"ت",1,0],["فَلا عَيبَ إِن مِتُّ مَوتَ الكِرامِ","كَما ماتَ في الحُبِّ مَن قَد خَلا",14,"ل",2,0],["فَلا عَينٌ يُؤرِقُها اِشتِياقُ","وَلا قَلبٌ يُقَلقِلُهُ اِدِّكارُ",15,"ر",1,0],["فلأعدائك البشاعةُ منه","ولك النفعُ دونهم والشفاءُ",16,"ف",3,0],["فلا عافاهُمُ اللَّه","ولا أَغْنى ولا أَقْنَى",17,"ن",2,0],["فلا عذرَ فيها لامرىءٍ هابَ مثلَها","وفي اللُّجَّةِ الخضراء عذرٌ لهائبِ",18,"ب",1,0],["فلأعطافها صنوفُ اهتزازٍ","ولأردافها صنوف ارتجاجِ",19,"ج",1,0],["فلا عَدِم الوُرَّادُ منك هشاشةً","لِسَقْيهمُ سجْلاً رويّاً على سجْلِ",20,"ل",1,0],["فلا عيبَ فيه سوى نائلٍ","يراهُ المُنَوِّلُ كالحالمِ",21,"م",1,0],["فلا عدِماه حتى يَسْتديرا","فيقترنا كهذا الاقتران",22,"ن",1,0],["فَلا عُذرَ لِلطَيرِ إِمّا رَأى","جَمالَ الرَبيعِ وَلَم يَسجَعِ",23,"ع",1,0],["فَلا عَجَبٌ إِذا خَفَروا ذِماماً","شَديدُ البَطشِ لَيسَ لَهُ ذَمامُ",24,"م",1,0],["فَلا عَدِموا مِن فَضلِكَ الجَمَّ أَنعُماً","أَحَلَّتهُمُ رَوضَ السَعادَةِ مُقبِلا",25,"ل",2,0],["فَلا عاذِلي يَنفَكُّ عَنِّيَ إِصبَعاً","وَقَد وَقَعَت في رَزَّةِ الحِبِّ إِصبَعي",26,"ي",1,0],["فَلا عَيشَ إِلّا أَن تُدارَ مُدامَةٌ","وَلا أُنسَ إِلّا أَن يَزورَ حَبيبُ",27,"ب",1,0],["فلا عقلك في الحك","م ولا روحك في الكرسي",28,"ي",1,0],["فَلا عَرشَ إِلّا أَنتَ وارِثُ عِزِّهِ","وَلا تاجَ إِلّا أَنتَ بِالحَقِّ كاسِبُه",29,"ب",2,0],["فَلا عَزَلٌ وَأَنتَ بِلا سِلاحٍ","لِحاظُكَ ما تَكونُ بِهِ مَنيعا",30,"ع",2,0],["فَلا عَدِمَت أَرضُ العِراقَينِ فِتنَةً","دَعَتكَ إِلَيها كاشِفَ الخَوفِ وَالمَحلِ",31,"ل",1,0],["فَلا عَبَرَت بي ساعَةٌ لا تُعِزُّني","وَلا صَحِبَتني مُهجَةٌ تَقبَلُ الظُلما",32,"م",2,0],["فلا عطفَ إِلّا سخطةٌ وتنكّرٌ","ولا ردَّ إِلّا ضَجرةٌ وسَآمُ",33,"م",1,0],["فَلا عارَ إِن أَجزَع فَهَجرُكِ آلِ بي","جَزوعاً وَإِن أُغلَب فَحُبُّكِ غالِبي",34,"ب",2,0],["فَلا عَيشٌ كَوَصلٍ بَعدَ هَجرٍ","وَلا شَيءٌ أَلَذُّ مِنَ العِتابِ",35,"ب",1,0],["فَلا عَدِمَ الإِمامُ صَوابَ رَأيٍ","نَفى الجَزباءِ عَن عَطَنِ الصِحاحِ",36,"ح",1,0],["فَلا عَجَبٌ في أَن يَغيضوا وَتَعتَلي","وَلا مُنكَرٌ في أَن يَقِلّوا وَتَكثُرا",37,"ر",2,0],["فَلا عُرفَ إِلّا عِندَ مَن باتَ شُكرُهُ","لِبُعدَ التَنائي مُشإِماً وَهوَ مُعرِقُ",38,"ق",1,0],["فَلا عَهدَ إِلّا أَن يُعاوِدَ ذِكرُها","وَلا وَصلَ إِلّا أَن يَزورَ خَيالُها",39,"ل",3,0],["فَلا عَجَبٌ أَن يَطلُبَ السَيلُ نَهجَهُ","وَأَن يَستَقيمَ المُشتَري مِن رُجوعِهِ",40,"ع",2,0],["فلا عَدَتْهُ من الجَوْزاءِ سارِيَةٌ","تَبكي عليهِ بدَمْعٍ غَيرِ مَسجومِ",41,"م",1,0],["فلا عيشَ إلاّ في اعتصامٍ بقَهوةٍ","يروحُ الفَتى منها خَضِيبَ المعَاصمِ",42,"م",1,0],["فلا عَيشَ إلاّ ما أفادَ بها الصِّبا","ولا وَجْدَ إلا ما أفادَ التَّفَرُّقُ",43,"ق",1,0],["فلا عَدِمَ الفِتيانُ منكَ قرارةً","أَيسلُّهُم سَعْداً عليَّ مُسْعِدا",44,"د",2,0],["فَلا عَدا الغَيثُ تُرباً أَنتَ ساكِنُهُ","مَع عِلمِنا أَنَّ فيهِ الغَيثَ مَلحودُ",45,"د",1,0],["فلا عجبٌ أن قَدّتِ البيضُ هامَهُمْ","فتلك حروفُ اللين لاقتْ جوازما",46,"م",2,0],["فلا عَصَفَتْ ريحُ الفراقِ الَّتي جرتْ","بها في خصمّ الجيش سُفْنُ رَواَحلِه",47,"ل",2,0],["فَلا عَجَبٌ وَإِن كَظَّت رِكابي","بِأَرضٍ طارَ طائِرُها المَشومُ",48,"م",1,0],["فَلَأُعرِضَنَّ عَنِ الخُطوبِ وَجَورِها","وَلَأَصفَحَنَّ عَنِ الزَمانِ المُذنِبِ",49,"ب",1,0],["فَلا عَيْنَ إِلَّا وَهْيَ بِالدَّمْعِ ثَرَّةٌ","وَلا قَلْبَ إِلَّا وَهْوَ ذُو خَفَقَانِ",50,"ن",1,0],["فلا عاصمَ اليومَ من أمره","سوى رحمةِ اللهِ سبحانَهُ",51,"ن",2,0],["فَلا عَينَ إِلّا وَهيَ تَظمَأُ لَوعَةً","وَإِنسانُها في ماءِ حُسنِكَ يَغرَقُ",52,"ق",1,0],["فَلا عِشتُما إِلّا حَليفَي مُصيبَةٍ","وَلا مُتُّما حَتّى يَطولَ بَلاكَما",53,"م",2,0],["فلا عَدْلَ حتّى تُسْتَردَّ حُقوقُها","ويُقْضَى لها استقِلالُها ووجودُها",54,"د",3,0],["فلَاعتَراني الشَوقُ لَمّا خِلتُهُ","مَوهِناً قَد لَجَّ وَهَناً وَالحَزَن",55,"ن",1,0],["فَلاَ عِنْدِي لَهُ نِعَمٌ تُجَازَى","وَلا لِي عِنْدَهُ ذِمَمٌ تُرَاعَى",56,"ع",2,0],["فلا عبْقَرِيٌّ كان أو هو كائِنٌ","فرَى فَريَهُ في المُعضِلاتِ العظائم",57,"م",1,0],["فلا عجيبُ بمن أبقَتْ ظُباهُ على","ملوك مصر أن استبقى ولم يغل",58,"ل",1,0],["فلا عسكرٌ من قبلِ عَسكرِ جوهرٍ","تَخُبُّ المطايا فيه عَشراً وتوضِع",59,"ع",1,0],["فَلا عَدِمَ الهَوى قَلبي","لِغَيظِهِمُ وَلا عَدِموا",60,"م",3,0],["فَلا عَمرُ الَّذي أُثني عَلَيهِ","وَما رَفَعَ الحَجيجُ إِلى إِلالِ",61,"ل",1,0],["فلا عهدَ للمُرّاقِ من بعدِ هذهِ","يتمُّ لهمْ عند الإمامِ ولا صُلحُ",62,"ح",1,0],["فلا عَيْشَ في الدُّنْيا لمَن عاشَ صاحياً","ومَن لم يَمُتْ سُكْراً بها فاته الحزم",63,"م",1,0],["فلا عظيم سوى الك","لو سألت حكيما",64,"م",2,0],["فَلا عَجَبٌ إِنْ لَمْ يَصُرْنِيَ مَنْزِلٌ","فَلَيْسَ لِعِقْبَانِ الْهَوَاءِ وُكُورُ",65,"ر",1,0],["فَلا عَجَبٌ إِذَا جَاءَتْ بِخَيْرٍ","فَلَوْلا النَّحْلُ مَا كَانَ الشِّهَادُ",66,"د",1,0],["فَلا عَيْنَ إِلَّا وَهْيَ عَيْنٌ مِنَ الْبُكَى","وَلا خَدَّ إِلَّا لِلدُّمُوعِ بِهِ خَدُّ",67,"د",1,0],["فَلاَ عِدَتُّكَ دُونَ مَا حَمَلْتَهُ","مَعُونَةً مِنْ رَبِّكَ الْقَدِيرِ",68,"ر",1,0],["فَلا عَظمَ إِلّا أَوهَنتهُ عَظائِمٌ","وَلا حَبل إِلّا قَطَّعَتهُ حُبولُ",69,"ل",1,0],["فلا عَيْنَ إِلاَّ وَهْيَ تَرْتَقِبُ المُنَى","وَلاَ صَدْرَ إِلا فارِحُ القلبِ جَاذِلُهْ",70,"ل",2,0],["فلا عينَ فيه لم تُقَرَّح جفونُها","ولا صدرَ إلا والهمومُ تخامره",71,"ر",2,0],["فلا عذرَ للأشعار حتى يردَّها","إلى الحق مرضيُّ الحكومةِ فاصل",72,"ل",1,0],["فَلا عَرْفَ إلاّ عِندَ مَنْ باتَ شكرُهُ،","لبُعدِ التّنَائي، مُشئِماً وَهوَ مُعرِقُ",73,"ق",1,0],["فلا عدم الإمام صواب رأي","نفى الجرباء عن عطن الصحاح",74,"ح",1,0],["فلا عصفت ريحُ الفراقِ التي جرت","بها في خضم الجيش سُفنُ رواحله",75,"ل",2,0],["فلا عيشَ إلاّ مثلُ عيشٍ مضى لنا","مصيفاً أقمنا فيهِ من بعدِ مربعِ",76,"ع",1,0],["فلا عيبَ فيه سوى نائلٍ","يراهُ المُنَوِّلُ كالحام",77,"م",1,0],["فلا عِدماه حتى يَسْتَدير","فيقترنا كهذا الاقتران",78,"ن",1,0],["فلا عذرَ فيها لامرء هاب مثلها","وفي اللجة الخضراء عذرٌ لهائب",79,"ب",1,0],["فلا عليك إذا أقريتني لبناً","وقلت خبزتنا من قمح حوران",80,"ن",1,0],["فلا عجبٌ إذا فاضتْ جُفوني","دماً من بعد فقدانِ التقىِّ",81,"ا",1,0],["فلا عجبٌ إذا حققت ظني","فظني في سعادتكم جميل",82,"ل",1,0],["فَلا عُذرَ لِلشِعرِ الَّذي فاضَ بَحرُهُ","إِذا لَم يَكُن في وَصفِ فَضلِكَ مُطنِبا",83,"ب",2,0],["فَلا عَدِمَت هَذي النِيابَةَ دَولَةٌ","جَعَلتَ لَها أَعداءَها كُلَّهُم جُندا",84,"د",2,0],["فَلا عُذرَ لِلخَيلِ الَّتي طالَ حَبسُها","إِذا لَم تُثِر في أَرضِ بَغدادَ قَسطَلا",85,"ل",2,0],["فَلا عَدِمَت سَماءُ المَجدِ مِنكُم","شُموساً لا تُغَيِّبُها الدُجونُ",86,"ن",1,0],["فلا عالم إلاّ خبيرٌ بشربيها","ولا جاهلٌ إلا جهولٌ بها غرّ",87,"ر",1,0],["فَلا عِلَّةٌ تُخشى وَقَد أَنجَحَ الطِبُّ","أَتُبصِرُ أَم غَطّى بَصيرَتَكَ القَذى",88,"ذ",2,0],["فلا عيد إلا يوم عودك نحوها","ولا بشر إلا يوم تأتي بك البشرى",89,"ر",2,0],["فلا عاش من للعيش يغضى على الأذى","لمولاه إلا عيشة الواله الثكلى",90,"ل",2,0],["فَلا عَدمَت يَوماً رَبيعَةُ مِثلَهُ","لِتَشييدِ عِزٍّ أَو لِبَذلِ مَواهِبِ",91,"ب",1,0],["فَلا عارَ في وَصلِ اِمرِئٍ ذِي صَبابَةٍ","فَذا الناسُ مُذ كانُوا مَشُوقٌ وَشائِقُ",92,"ق",1,0],["فَلا عَبَثَت بِساحَتِكَ اللَيالي","فَإِنَّكَ لِلصَّديقِ يَدٌ وَنَصلُ",93,"ل",1,0],["فَلا عُدِمَت أَيّامُهُ الغُرُّ إِنَّها","لَتَعدِلُ طَعمَ الماءِ وَهوَ زُلالُ",94,"ل",1,0],["فَلا عَجَبٌ أَن يَطلبَ الحَقَّ أَهلُهُ","فَلِلدَوحِ أَوراقٌ نَشَأنَ وَأَغصانُ",95,"ن",1,0],["فَلا عَدِمَتهُ ما أَنارَت نُجُومُها","وَما سارَ في أَبراجِها قَمَراها",96,"ا",3,0],["فَلا عَدِمَ الإِسلامُ أَيّامَهُ الَّتي","أَقامَت بِدارِ المُشرِكينَ التَلَهُّفا",97,"ف",2,0],["فلا عيشَ إلا في زمانك طيب","ولا نفسَ إلا من نوالك تُجْبَر",98,"ر",1,0],["فَلا عذرَ للكفّارِ في جهلِهم به","وَهذي البَرايا كلُّها صُحفٌ تقرا",99,"ر",2,0],["فَلا عَجبٌ أَن كان باباً لعلمهِ","وَفي الحربِ ذِمراً لَم نَجِد مثله ذمرا",99,"ر",2,0],["فَلا عَجبٌ إن قلتُ هل من مفاخرٍ","وَأَحجمَ عنّي سائرُ الملل الأخرى",99,"ر",2,0],["فلا عجبَ أن يصدَّ الحسان","وأن يتعلمنَ فيكَ النفورا",100,"ر",2,0],["فلا عجباً إذا الإنسانُ أمسى","لدى الإنسانِ كالشيءِ العُجابِ",101,"ب",1,0],["فلا عاش الذي في الحب يوما","بسلوتها تفوه أو نواها",102,"ا",3,0],["فَلا عَتَبَنَّكَ في الَّذي اَندَيتُهُ","أَعدِل فِداكَ خِلالُ أَهل الموصِلِ",103,"ل",1,0],["فَلا عَدِمَت مِنكَ المَمالِكُ هِمَّةً","تَبيتُ وَفي تَدبيرِها الثَقَلانِ",104,"ن",1,0],["فَلا عِرضُهُ قابِلٌ لِلثَناءِ","وَلا عِطفُهُ بِالمَعالي عَبِق",105,"ق",1,0],["فَلا عَطفٌ لَديهِ وَلا وِصالٌ","وَلا جَلَدٌ لَديَّ وَلا اِصطِبارُ",106,"ر",1,0],["فَلا عَدِمتُ عَطاياكُم وَلا عَدِمَت","إِصغاءَكُم لِمَديحي هَذِهِ الفِقَرُ",107,"ر",1,0],["فَلا عَدِمنا جَدواكَ مِن هَتِنٍ","مُجَلجِلٍ بِالنَوالِ أُسكوبِ",108,"ب",1,0],["فَلا عَرَفَت أَخلاقُكَ الغُرُّ جَفوَةً","وَحاشا لَها مِن قَسوَةٍ وَجَفاءِ",109,"ا",2,0],["فلا عزَّ إِلا مِن خَميسٍ وَرايَةٍ","ولا حَقَّ إِلا ما حَمتهُ الصّوارِم",110,"م",1,0],["فلا عذرٌ لأعزَلَ سيمَ ضيماً","فقالَ أخافُ بطشةَ مدفعي",111,"ي",1,0],["فَلا عدد وَلا مَدَد يقيهم","وَلا مصر وَلا قصر مشيد",112,"د",1,0],["فَلا عَجَبٌ أنْ رَاحَ يَومَ سَلامِهِ","إلَى سِلْمِ دَهْر شَجَّه بسلامِهِ",113,"م",2,0],["فَلا عيدَ مَا لم تُسعِدُني بعَوْدَةٍ","وأنّى يَؤُمُّ القَصْرَ من يَمم القَبْرا",114,"ر",2,0],["فَلا عَجَبٌ وَإِنْ وافى بِأَوفى الْ","فَوادِحِ أَنْ يَسُوءَ وَأَنْ يَسُورا",115,"ر",2,0],["فَلاَ عَاقَتْكَ عَنْ طَلَبِ الْمَعَالِي","إِذا الأَيَّامُ كَادَتْ أَنْ تُعَاقا",116,"ق",2,0],["فَلا عَين إِلّا وَهيَ عَينٌ مَعينَةٌ","وَلا خَدَّ إِلّا خدَّ فيهِ مَسيلُ",117,"ل",1,0],["فَلا عِلمَ إِلّا دونَ غايَةِ عِلمِهِ","وَلا فَضلَ في المِضمارِ يُدرِكُ فَضلَهُ",118,"ل",2,0],["فَلا عَينٌ وَلا غَبنٌ إِذا ما","سَبَأتَ الخَمرَ بِالثَمَنِ الرَبيحِ",119,"ح",1,0],["فَلا عَدَدٌ وَلا عُدَدٌ تَوَقّى","بِها المَلِكُ المُغيثُ المُستَغيثُ",120,"ث",1,0],["فَلا عَدمنا بلاغة نسقَت","منه المَعاني وأَبدعت حِكمَه",121,"م",2,0],["فلا عجب إذا جزعتْ (دمشق)","فلوعتُها للوعتِه جزاءُ",122,"ا",2,0],["فلا عشت إن كان قلبي سكن","إلي البعد عن أهله والوطن",123,"ن",1,0],["فَلا عطّلَ الفخرُ المنضّد جيدَها","وَلا أهوتِ الأيّامُ مِن ليتها قرطا",124,"ط",2,0],["فَلا عاذِلي يَدري وَلا أَنا قائِلُ","وَلا أَنتَ تَخشى مِن مَلامَةِ لَومِ",125,"م",1,0],["فَلا عَدَمْناكَ واجِداً أَبَداً","تَجمَعُ بَينَ الصَّلاةِ والصَّدَقَه",126,"ه",1,0],["فَلا عَدِمَ المُلْكُ نَصراً عَزيزاً","ولا عَدِمَ الدِّينُ فَتحاً مُبينا",127,"ن",2,0],["فَلا عَجَباً إِن فاحَ طيب ثَنائِهِ","شَمائله رَوض وَأَخلاقه الزُهرُ",128,"ر",1,0],["فلا عَدِمَتْ شَمائلَه المَعالي","ولا زال الحسودُ بهِنَّ راغم",129,"م",1,0],["فَلا عَدِمَتكَ المَعالي فَأَنتَ","نَشَرتَ لَها ماطَواهُ القِدَم",130,"م",1,0],["فلا عجَبٌ أن يَتيهَ المُدلُّ","وأن يَمرَحَ العَربِيُّ العَتيق",131,"ق",1,0],["فلا عَدِ مناكَ على حالةٍ","فأنت قلْبُ الدَّهرِ في صَدْره",132,"ر",2,0],["فلا عَدا السّوءُ مَنْ عاداهُ من مَلكٍ","كَفّارُ أنعُمه باللهِ كَفّار",133,"ر",1,0],["فلا عَقُمَ الدَّهرُ الكثيرُ رِجالُه","ومثْلُك من أبنائهِ النُّجبَاء",134,"ا",2,0],["فَلا عَدِموا الرَخاءَ بِهِ وَأَمّا","شِراهُ لَهُم فَلا عَدِمَ الغَلاءَ",135,"ا",2,0],["فَلا عَقرَبٌ إِلّا بِخَدِّ مَليحَةٍ","وَلا جَورَ إِلّا في وِلايَةِ ساقِ",136,"ق",1,0],["فَلا عَدِمتُ يَداً إِن جِئتُها بَذَلَت","وَعُدتُ عَنها كَريمَ الوَجهِ ما بُذِلا",137,"ل",2,0],["فَلا عَدَمتُ يَميناً مِنهُ مُغرِقَةً","في يَمِّ مَعروفِها فِرعَونَ آمالي",138,"ي",1,0],["فلأعزمنَّ على صُرو","فِ الدَّهر عزمةَ مُستثيرِ",139,"ر",1,0],["فَلا عَيشَ لي حَتّى تَدومَ مُسَلَّماً","وَصَرفُ اللَيالي عَن ذَراك بِمَعزَلِ",140,"ل",1,0],["فَلا عُدْتُ إلى الغُرَبةِ","ما كرَّ الجَديدانِ",141,"ن",1,0],["فلا عثرةُ النذل ممَّا تقال","ولا ذنب مذنبها يغفر",142,"ر",1,0],["فلا عجبٌ إنْ رمتُ عنها تحوُّلا","وكيفَ أرى بغداد للحرّ منزلا",143,"ل",2,0],["فلا عزّ حتَّى أترك النوق ترتمي","بنا وجياد الخيل تكدم باليد",144,"د",1,0],["فلا عدم الهَناءَ بكم زمانٌ","مواضِعَ نَقْبِه وَضَعَ الهِناءَ",145,"ا",2,0],["فلا عبرَتْ بساحتِه الليالي","ولا عثرَ الزمانُ بها الخَؤونُ",146,"ن",1,0],["فلا عدمت مغانيك التهاني","ودام لمجدكَ الجدّ العليّ",147,"ي",1,0],["فلأَعْقِدَنَّ عَلَيْكِ أَكرَمَ ذِمَّةٍ","ولأَبْنِيَنَّ عَلَيْكِ أَشْيَدَ مَعْقِلِ",148,"ل",1,0],["فلا عَدِمَ الإِسلامُ من عَزَمَاتِهِ","سيوفاً بِهَا نَسْبِي وُجُوهاً بِهَا نُسْبى",149,"ب",2,0],["فلا عَرِيَتْ منكَ الجيادُ إِلَى الوغى","ولا العيسُ من حِلٍّ إِلَيْكَ وتَرْحالِ",150,"ل",1,0],["فلا عدِمَ الإِسلامُ رعْيَكَ لا يَني","ولا أَمِنَ الإِشراكُ بأْسَكَ لا يُرْعِ",151,"ع",1,0],["فلا عين ولا رسم","ولا حمي ولا مرعى",152,"ا",1,0],["فلا عدِم الوفدُ ناديكُمُ","ولا استَوْحشتْ سُبُلُ الرائدينا",153,"ن",2,0],["فلا عدِمتْك فارجا لمَضيقها","وبابا إلى ما استصعبتْ من مرامِها",154,"م",3,0],["فلا عدِموك حياً في الجدوب","رَخاً في الكروب غِنىً في العَدَمْ",155,"م",1,0],["فلأُعطينَّك من ودادي ميِّتاً","جهدَ المنيب ورجعةَ المتنصلِ",156,"ل",1,0],["فلا عُدمتَ آسياً","كدَّ العلاجَ فرفَقْ",157,"ق",1,0],["فلا عدمتك يا بدرُ الليالي","ولا خفتَ المحاقَ ولا الشَّعاعا",158,"ع",2,0],["فلا عَصْمُ سودَدِهم بالقنا","يُحَلُّ ولا عودُهم يُقشَرُ",159,"ر",1,0],["فلا عدا شرف الدين الثَّناءُ فقد","طابت مساعيه والأنسابُ والشِّيمُ",160,"م",1,0],["فلا عدا شرف الدين الثناءُ اذا","طابَ النَّديُّ بذكر المحسن الحسن",161,"ن",1,0],["فلا عَدِم الحمد الوزيرُ الذي به","أشُدُّ على صرف الرَّدى وأصولُ",162,"ل",1,0],["فلا عَدِمَ الحمد الوزيرُ فانني","بنُعماهُ أحْداثَ الليالي اُجالِدُ",163,"د",1,0],["فلا عَدِمتْ عَليّاً دارُ مَجْدٍ","ولا أخْلاهُ منه شريفُ حَفْلِ",164,"ل",1,0],["فلا عدا ابْن طِرادٍ قولُ مَحْمدةٍ","ما وحِّدَ اللهُ في سِرٍّ وفي عَلَنِ",165,"ن",1,0],["فلا عدت شرف الدين الجواد عُلاً","ما طافَ فوق الثَّرى حافٍ ومنتعلُ",166,"ل",1,0],["فلا عَدِمتْ رؤياك عينٌ قَريرةٌ","بلُقْياك يَوْمَيْ خَلْوةٍ ومجامع",167,"ع",1,0],["فلا عادكُمْ رزءٌ من الدهر بعدَه","ولا زلتُم حتف ا