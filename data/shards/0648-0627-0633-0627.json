ِ العيون عيونَهُ","وأَطَال لَوعتَهُ وزادَ حنينَهُ",194,"ه",1,0],["واسأل لنا في كل حين يا علي","حسن الختام فهو خير العمل",195,"ل",1,0],["وأسأله بعد الصلاة مسلماً","على أحمد والآل خاتمة حسنى",196,"ن",2,0],["وأسأله الصلاح لكل فرد","حوته الأرض من يمن وشام",197,"م",1,0],["وأسأله صبراً على فقد من سرى","إليك وكنا لا نحب بأن يسري",198,"ر",2,0],["وأسأل عنكم كل غاد ورائح","وهيهات ما الأخبار تغني عن الخبر",199,"ر",1,0],["وأسأله لطفاً وعفواً ورحمة","أفوز بها مهما نزلت بملحدي",200,"د",2,0],["واسأله الرضا في كل حين","وتوفيقاً إلى التقوى يقود",201,"د",1,0],["وأسأل رب العرش يجمعنا معاً","لديه غداً في خير دار ومقعد",202,"د",1,0],["وأسأله حُسْنَ الختام مقدِّماً","صلاة على المختار والآل ذي القربى",203,"ب",2,0],["وأسأل بهم صرف الزما","ن فإنه هو أعلم",204,"م",1,0],["وأسألُ عن ظمياءَ صمَّاءَ لا تَعي","فأرضى بما قالَتْ ولَيْسَ تَقولُ",205,"ل",1,0],["وأسألُ عن نَهجِ السُّلُوِّ وقد بَدا","لعَينَيَّ إلاّ أنّ مسلَكه وَعرُ",206,"ر",1,0],["وأسأل التيسيرَ في رؤيته","بالمصطفى الهادي وآل بيتهِ",207,"ه",1,0],["واسأَلا عن مهجةٍ داميةٍ","رُمِيَت سهمَ غرام مَن رماها",208,"ا",3,0],["وأساة لحشًى مكلومةٍ","جَرَحَتْها حَدَقُ الغيد نصالا",209,"ل",2,0],["واسأل ودادَك من جوانح أخرس","لو كانَ يستطيع الكلام تكلَّما",210,"م",2,0],["واسأل النجم في الظلماء مرتقباً","عن شادنٍ ما عرا حبيه أسقاط",211,"ط",1,0],["وآسٌ أبداً يُجْنى","على منْ رامَ أن يجْني",212,"ي",1,0],["واسأَلْ بِقَبْرَةَ واللائي أَطَفْنَ بِهَا","عن عَزَمَاتٍ لَهُ فِيهِنَّ تُرْتَدَفُ",213,"ف",1,0],["واسْأَلْ جُنُودَ العَذْلِ كيْفَ لَقِيتُها","فِي جَحْفَلِ البُرَحاءِ والأَوْصابِ",214,"ب",1,0],["واسْأَلْ بِضَيْفِكَ كيْفَ بَعْدَكَ حالُهُ","وقدِ اقْتَضَتْهُ بعدَ دارٍ دارُ",215,"ر",1,0],["وأسأل اللَه توفيقاً ومغفرةً","وصحة ونولاً ينسخ الملقا",216,"ق",2,0],["واسألهم من ذا الذي","لهم تحلل قبلنا",217,"ن",2,0],["وأسألك الرضى عني فإني","أَخو جرم فهب لي ما محاها",218,"ا",3,0],["واسألوا النجم حائرا","واسألوا الشمس في حذر",219,"ر",1,0],["واسألوا النور باهتا","خائفا ما له مقر",219,"ر",1,0],["واسألوا النهر واجما","كل موج له عثر",219,"ر",1,0],["واسألوا الحب بعد ما","