poem42458.html","الرمل"],[509,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[514,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[514,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[514,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[529,"من ظن في بعمته أنها","https://www.aldiwan.net/poem37531.html","السريع"],[543,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[551,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[551,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[551,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"],[551,"لو لم يعاجله النوى لتحيرا","https://www.aldiwan.net/poem47806.html","الكامل"],[551,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[558,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[558,"أنا الوجود كما أني أنا العدم","https://www.aldiwan.net/poem33860.html","البسيط"],[558,"عن يمين الحي من إضم","https://www.aldiwan.net/poem34197.html","المديد"],[558,"بدر تم لاح في الغسق","https://www.aldiwan.net/poem34335.html","المديد"],[558,"هذه الأثواب والخلع","https://www.aldiwan.net/poem34397.html","المديد"],[558,"اغسلوا بي نجاسة الوسواس","https://www.aldiwan.net/poem34440.html","الخفيف"],[558,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[558,"أنا دائما يا نور كل مليح","https://www.aldiwan.net/poem34680.html","الكامل"],[569,"سلب الشباب رداءه","https://www.aldiwan.net/poem52022.html","مجزوء الكامل"],[575,"أيدفعني الدهر عن مطلبي","https://www.aldiwan.net/poem2750.html","المتقارب"],[586,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"]],"verses":[["وَأَسأَلُهُ أَن لا تَزالَ مُخَلَّداً","بِمَلقى سَماعٍ بَينَنا وَعِيانِ",0,"ن",1,0],["وَأُسامُ في أَكلاءِ مَوبِئَةٍ","مُحتَشُّها دونَ السَوامِ رَدي",1,"د",2,0],["وَأَسآلُهُم عَن جَنوبِ الحِمى","وَعَن أَرضِ نَجدٍ وَمَن حَلَّ نَجدا",2,"د",2,0],["وَاِسأَل بِهِ صِفّينَ إِنَّ زَئيرَهُ","أَودى بِكَبشِ أُمَيَّةَ النَطّاحِ",3,"ح",1,0],["وَاِسأَل شَراةَ النَهرَوانِ فَإِنَّهُم","ضَرَبوا بِمُنذَلِقِ اليَدَينِ وَقاحِ",3,"ح",1,0],["وَأَسأَلُ أَينَ مَصابُ الغَمامِ","شُروقاً إِذا ما غَدا أَو غُروبا",4,"ب",2,0],["وَأَسأَلُ أَن يُعطيكَ في العُمرِ فَسحَةً","لِعِلمِيَ أَنَّ العُمرَ يُعطى وَيوهَبُ",5,"ب",1,0],["وَاِسأَلاني عَن قَريبٍ","في الهَوى غَيرِ قَريبِ",6,"ب",1,0],["وَأَسأَلُ الرَّكبَ عَنها وَالدُّموعُ دَمٌ","بِناظِرٍ لَم يَخِطْ جَفناً عَلى وَسَنِ",7,"ن",1,0],["وأسْألُ الطّيْفَ عنْ سَلْمى إذا قُبِلَتْ","شَفاعَةُ النّوْمِ للسّاري إِلى المُقَلِ",8,"ل",1,0],["وَاِسأَل حُذَيفَةَ حينَ أَرَّشَ بَينَن","حَرباً ذَوائِبُها بِمَوتٍ تَخفِقُ",9,"ق",1,0],["وَاِسأَل عَنِ الأَظعانِ أَينَ سَرَت بِه","آباؤُها وَمَتى يَكونُ رُجوعُها",10,"ع",3,0],["وَأَسأَلُها حَملَ السَلامِ إِلَيكُمُ","فَإِن هِيَ يَوماً بَلَّغَت فَأَجيبي",11,"ب",2,0],["واسألْهُ عنْ وجْدِي يُجِبْكَ مُبادِراً","هَذا قِياسٌ ليْسَ بالمَرْفوعِ",12,"ع",1,0],["وَاسْأَلِي الْقَوْمَ هَلْ ثَنَيْتُ عِنَانَاً","عَنْ قَنَاةٍ أَوْ صَعْدَةٍ تَثَنَّى",13,"ن",2,0],["وَاسْأَل مَوَاقِفَنَا بِبَابِكَ يَوْمَ لَمْ","يُدْعَ لِخِدْمِتهِ سِوَى الْخُلْصَانِ",14,"ن",1,0],["وَأَسْألُ عَنْ أَخْبَارِهِ كُلَّ وَارِدٍ","فَيَالَيْتَ شِعْرِي كَيْفَ عَنِّي سُؤَالُهُ",15,"ل",2,0],["واسألْ عنِ النّعْمانِ حيرَتَهُ وقدْ","عشِقَ الشقيقَ الغَضَّ فهْوَ شِعارُهُ",16,"ر",2,0],["وَاِسأَل قُشَيراً وَعَبدَ اللَهِ كُلُّهُمُ","وَاِسأَل رَبيعَةَ عَنّا كَيفَ نَفتَعِلُ",17,"ل",1,0],["وَاِسأَلوا اللَهَ أَن يُديمَ عَلَينا","مُلكُ عَبّاسَ ناضِراً بَسّاما",18,"م",2,0],["وَاِسأَلوها في زَورَةٍ مِن خَيالٍ","إِن تَكُن لَم تَجِد مِنَ الهَجرِ بُدّا",19,"د",2,0],["وَأَسالَ باناسٌ ذَوائِبَهُ","فَتَجَعَّدَت في ضَيِّقِ السُبُلِ",20,"ل",1,0],["وَاِسأَل هُنالِكَ هَل عَنّى تَذَكُّرُنا","إِلفاً تَذَكُّرُهُ أَمسى يُعَنّينا",21,"ن",2,0],["وأساهم البلد الأمين وحزنه","بين الطوايا فوق ما في الظاهر",22,"ر",1,0],["واسألْ مواقفهم بكل مشهّر","واقرَ المغازي في الصحيح وفي السِّيَرْ",23,"ر",1,0],["وأسألنّ الشام عمّا قد أضا","للمُعاويّين فيها من فَخار",24,"ر",1,0],["وأساس عمران البلاد تَعاوُن","مُتواصل الأسباب من سُكّانها",25,"ن",3,0],["وأسال غرب الدمع منسكبا","من كل عين اثر منسكب",26,"ب",1,0],["وَاِسأَل ذَوي يَمَنٍ إِذا لاقَيتَهُم","وَاِسأَل قُضاعَةَ كُلَّها وَنِزارا",27,"ر",2,0],["وَاِسأَل ذَوي الأَلبابِ مِن سَرَواتِهِم","يَومَ العُهَينِ فَحاجِرٍ فَرُؤامِ",28,"م",1,0],["واسألهمُ تمطرك أيديهُمُ","عُرْفاً خلالَ الوبل منه رذاذْ",29,"ذ",1,0],["واسأل به فارساً إذ سار تطلبه","سيراً حثيثاً يغول الأرض خَشّافا",30,"ف",2,0],["وَاِسأَلِ الأَنجُم وَالريح وَسَل صَوبَ الغَمام","أَتَرى الشَيءَ كَما نَحنُ نَراهُ لَستُ أَدري",31,"ي",1,0],["وَاِسأَلهُ إِن كانَ يُرضيهِ ضَنى جَسَدي","فَحَبَّذا كُلَّ شَيءٍ كانَ يُرضيهِ",32,"ي",2,0],["وَأَسأَلَهُ وَلَيسَ يُرَدُّ حَرفاً","كَأَنَّ جَوابَ مَسأَلَتي حَرامُ",33,"م",1,0],["وَاِسأَلهُ عَن أَخبارِهِ","وَاِستَغنِ عَن مَضمونِ كُتُبي",34,"ب",2,0],["واسأل ذويها لو أجابوا سائلا","واجعل مدادك يا يراعي من دمي",35,"م",2,0],["واسأل لمصر عناية","تأتي وتهبط من عل",36,"ل",1,0],["وَأَسأَلُ أَن تَسلَمي لي السِنينَ","وَأَن تُرزَقي العَقلَ وَالعافِيَه",37,"ي",2,0],["وَأَساسٌ مِن عَهدِ عُثمانَ يُبنى","في ثَمانٍ وَمِثلُهُنَّ يُقامُ",38,"م",1,0],["وَاِسأَل لِمِصرَ عِنايَةً","تَأبى وَتَهبُطُ مِن عَلِ",39,"ل",1,0],["وأسألُها ما أستحقُّ قضاءَهُ","وما أنا ممّن رام حاجَتَهُ قسرا",40,"ر",2,0],["وأسألكمْ خِيماً سوى شِيَمِ الورى","كأني بأخلاقِ الوَرى غيرُ عالمِ",41,"م",1,0],["وَأَسأَلُ عَن غَيرِهِ قَبلَهُ","لَأَقسِمَ ظَنَّ الَّذي يَستَريبُ",42,"ب",1,0],["وَأَسأَلُكَ النِصفُ اِحتِجازاً وَرُبَّما","أَبَيتُ فَلَم أَسمَح لِغَيرِكَ بِالنِصفِ",43,"ف",1,0],["وَأَسأَلُ فيكَ أَبا صالِحٍ","وَما كانَ حَقُّكَ أَن أَسأَلَه",44,"ل",2,0],["وَاِسأَل بِنا وَبِكُم إِذا وَرَدَت مِنىً","أَطرافُ كُلِّ قَبيلَةٍ مَن يَسمَعُ",45,"ع",1,0],["وَاِسأَل بِقَومِكَ يا جَريرُ وَدارِمٍ","مَن ضَمَّ بَطنَ مِنىً مِنَ النُزّالِ",46,"ل",1,0],["وَاِسأَل بِتَغلِبَ كَيفَ كانَ قَديمُها","وَقَديمُ قَومِكَ أَوَّلَ الأَزمانِ",47,"ن",1,0],["وأساءَ الزَّمانُ فيه إلينا","حينَ أعطى القَليلَ منه وأكدى",48,"د",2,0],["وَاسأَل فَقَد يَكشِفُ عَنكَ العَمى","سُؤالُكَ العالِمَ في أُنسِهِ",49,"س",2,0],["وَأَسَأتَ كُلَّ إِساءَةٍ","وَظَنَنتَ أَنَّكَ تُحسِنُ",50,"ن",1,0],["وَأَسأَلُ مِنكَ أَن تَعفو وَتُعفي","مُحِبَّكَ مِن إِجابَتِهِ اِعتِقادا",51,"د",2,0],["وأسائل الزمن الخفيّ لعله","يشفي أواماً أواماً أو يبل غليلا",52,"ل",2,0],["وَإِساءاتُ ذي الإِساءَةِ يُذكِر","نَكَ يَوماً إِحسانَ ذي الإِحسانِ",53,"ن",1,0],["وَأُسْأَلُ يَوْمَ الْبَعْثِ عَنْ كُلِّ مَا وَعَى","سَمَاعٌ وَمَا فَاهَتْ بِهِ شَفَتَانِ",54,"ن",1,0],["وَاسْأَلْ عَنِ الْبَدْرِ الَّذِي كَسَمِيِّهِ","فِي نُورِ غُرَّتِهِ وَبُعْدِ مَرَامِهِ",55,"م",2,0],["واسألْ إلَهكَ عصمةً وحمايةً","فالسيئاتُ قواصفُ الأعمارِ",56,"ر",1,0],["وَأَسأَلُ هَل سَقى طَلَلاً بِحَزوى","عَفا قِدماً وَهلَ جادَ الغَميما",57,"م",2,0],["وَأَسأَل مَن لاقَيتُ عَن أُمِّ مالِكٍ","فَهَل يَسأَلانِ الحَيَّ عَن كَيفَ حالِيا",58,"ي",2,0],["وَاسْألْ عن الفتح المبينِ أما شَفَى","مُهَجاً يَهِيجُ غليلُها ونُفوسا",59,"س",2,0],["واسْألوا مُوسَى أَطابت نفسُه","أمْ أَبَى ما كان منكم فَنَقِمْ",60,"م",1,0],["وَاِسأَل مَنابِرَها العُليا أَما رَجَفَت","لَمّا هَوى الدَهرُ بِالغُرِّ البَهاليلِ",61,"ل",1,0],["وَاِسأَل عَنِ الشُهَداءِ أَينَ قُبورُهُم","فَإِذا عَرَفتَ فَطُف بِها وَتَعَبَّدِ",62,"د",1,0],["واسألوها إنّها ألسنة","يا ابن حربٍ للمنايا الحمرِ لُدّ",63,"د",1,0],["وأسَال صفحة خَدّه مَا مِسكَةٍ","عبقت بلام عذاره أو نونهِ",64,"ن",2,0],["وَاِسألي الباغين ماذا هالَهُم","مِنهُ في أَكفانِهِ إِن تَسألي",65,"ل",2,0],["وَاِسأَل فَإِنَّ لَنا مَناقِبَ شَكلُها","سِيٌّ مَضَت لِسَوالِفِ الأَعصارِ",66,"ر",1,0],["وَاِسأَل قُفَيرَةَ بِالمَرّوتِ هَل شَهِدَت","شَوطَ الحُطَيئَةِ بَينَ الكِسرِ وَالنَضَدِ",67,"د",1,0],["وَاِسأَل ثُغورَ الشامِ عَن وَصيفِ","يُخبِر بِفَتحٍ عَجَبٍ ظَريفِ",68,"ف",1,0],["وَأَسأَلُ نَيلاً لا يُجادُ بِمِثلِهِ","فَيَفتَحُهُ بِشرِي وَيَختُمُهُ عُذرِي",69,"ر",2,0],["وَأَسأَلُهُ رَدَّ الأَحاديثِ عَلَّهُ","سُؤالٌ وَأُخفي دَمعَةً تَفضَحُ الوَجدا",70,"د",2,0],["وَاِسأَلِ الدارَ مَتى فا","رَقَتِ الدارُ القَطينا",71,"ن",2,0],["وَأَساءَ ناكِحُ زَوجَةٍ نَصرانَةٍ","قَطَعَت لِأَجلِ نِكاحِهِ زِنّارَها",72,"ر",3,0],["وَأَسأَلُ خالِقي نسأً بِرِفقٍ","إِذا لَم يَبقَ لي إِلّا النَسيسُ",73,"س",1,0],["وَاِسأَل بِهِ الحَيَّ مِن عَدنانَ أَو سَبَإٍ","تَجِدهُ لَيسَ إِذا أَقوى بُوَسّالِ",74,"ل",1,0],["وَأَسأَلُ الخالِقَ مِن عِزِهِ","ما لَم يَكُن إِلّا لَهُ يُمكِنُ",75,"ن",1,0],["وَاِسأَل بِهِم أَسَداً إِذا جُعَلَت","حَربُ العَدُوِّ تَشُولُ عَن عُقمِ",76,"م",1,0],["واسأَلْ نجومَ اللّيلِ هل زارَ الكَرَى","جَفني وكيف يزورُ مَن لم يَعْرِفِ",77,"ف",1,0],["واسْأَلْ غزالَ كِنَاسِهِ هل عندهُ","عِلْمٌ بقَلبي في هواهُ وحاله",78,"ل",2,0],["واسألِ الرحمنَ أن يُصلِحَ عَه","داً كسيحاً وزماناً أعرَجا",79,"ج",2,0],["وأساطيرَ ليالٍ صُبِغَتْ","بدماءٍ سفكتهنَّ يداها",80,"ا",3,0],["وَاِسأَل حُذَيفَةَ حينَ أَرَّشَ بَينَنا","حَرباً ذَوائِبُها بِمَوتٍ تَخفِقُ",81,"ق",1,0],["وَاِسأَل عَنِ الأَظعانِ أَينَ سَرَت بِها","آباؤُها وَمَتى يَكونُ رُجوعُها",82,"ع",3,0],["وَاسْأَلْهُ مَغْفِرَةً لِمَنْ حَلَّ الثَّرَى","بِالأَمْسِ فَهْوَ مُجِيبُ كُل مُنَادِي",83,"ي",1,0],["وَاسَأَلْهُ غُفْرَاناً لِزَلاَّتِي فَقَدْ","ثَقُلَتْ علَيَّ وَعَفْوُ رَبِّكَ وَاسِعُ",84,"ع",1,0],["وَاسْأَلْهُ لِي صَبْراً فَحَسْبِي مِنْ رِضىً","بِاللِه أَنَّكَ فِي رِضَاهُ رَاتِعُ",84,"ع",1,0],["وَأَسَا جَرْحَى وَإِبْقَاءٌ عَلَى","أُسُدٍ أَلْصقهَا بِالأَرْضِ جُوْعْ",85,"ع",1,0],["وَأَسْأَلُ كَيْفَ حَالُكُمُ جَمِيعاً","فَإِنِّي فِي اشْتِيَاقٍ وَالتِيَاحْ",86,"ح",1,0],["واسألي الزهر أن تكون دموعا","واسألي الأزهار",87,"ر",1,0],["وأسأل الحفل عنهم لا يجاوبني","كأنما الحفل في آذانه صممُ",88,"م",1,0],["وَاِسأَلهُ هَل نَسيَ الَّذي","أَودَعتُ عِندَ وَداعِهِ",89,"ع",2,0],["وأَسأَلُ السُّفْنَ عن أخبارهِ طَمَعاً","وأنْثَنِي وبقَلبي منه لَوْعَاتُ",90,"ت",1,0],["واسْأَلْ نَمُوراً ما دَهَى أَهْلَها","فقدْ نَعاهَا البَرْقُ فيما نَعَى",91,"ع",2,0],["وأسأل : أين ألقاها ؟","فتغلي في صباباتي",92,"ت",2,0],["وأسائل الصمت الرهيب كأنّني","جوعان محتضر يسائل معدما",93,"م",2,0],["واسألْ ذوي الألبابِ عن سرواتهمْ","يومَ العهينِ ، فحاجرٍ ، فرؤامِ",94,"م",1,0],["واسِ الضعيف يكن ليومك أسوة","وكذا الشُعوب كما تدين تدان",95,"ن",1,0],["وأسأَلُ قلبي أتعرفُها؟","فيضحكُ منّي ولا أفهمُ",96,"م",1,0],["وَأَسْأَتَ تَكْرَارُ السُّؤَالِ ذَوِي الفَضْلِ","أَراهَا أصحَّ الآنَ حسْماً وَأَجْمَلاَ",97,"ل",2,0],["وأسائل عن وجهي عنّي","عن يومي في تيه الأزمان",98,"ن",1,0],["وَأَسألك القَليل مِن التَلاقي","وَلَكن خَشيَتي مِن سوءِ رَدك",99,"ك",1,0],["واسال في الله الدموع بهمة","تعلو عزائمها عن الاضداد",100,"د",1,0],["واسأل قلبي أي ذنب جنيته","والقيتني من وهدة الهجر في جب",101,"ب",1,0],["وأسأل من إله العرش فتحاً","قريباً فيهم وبأهل بدر",102,"ر",1,0],["وأسأله عطفاً على حالتي التي","لها مقلتي سالت كسيل الغمائم",103,"م",1,0],["وأساء محسن للقرين وعرسه","ولنا عشية صاغ عقد قرانه",104,"ن",2,0],["واسأل فرديك بن بيك","إذا شككت بذاك يشهد",105,"د",1,0],["واسأَل من الرحمن عنها عِصْمَة","هلاَّ رأيتَ المنحَ منها محنَة",106,"ه",1,0],["وَاسأَلاَ النُّؤءىَ والأوَارِىَ والسُّفعَ","ثَلاَثاً بجَنبِ هَابٍ جُثُومَا",107,"م",2,0],["وأسأل الركبَ أنباءً فيكتمُنى","كأنّكم في صدورِ القوم أسرارُ",108,"ر",1,0],["وَاِسأَلهُ ما تَحوي يَداهُ يُنلِكَهُ","كَرَماً وَأَمّا مَجدَهُ الزاكي فَلا",109,"ل",2,0],["وأسألها عنه فكلّ أجابني","بأنه ما رآه يوما ولا أدرا",110,"ر",2,0],["وأسألُ عن نجد وفيه مخيّمي","وأطلب روض الرقمتين ونعمانا",111,"ن",2,0],["وأسأل من ربي اللقاء فإنه","قديرٌ ولي في ذي الجلال رجاء",112,"ا",2,0],["وأَسْأَلُ مَنْ بِبَيْنِكُمُ رَمَاني","يَمُنُّ عَلَيَّ مِنْكُمْ بِالرُّجُوعِ",113,"ع",1,0],["وأسأله كم حذرته من شؤم من","ظهرت له في الشؤم منه عبرة",114,"ه",1,0],["وأسام آمالي العريضة وادياً","من جوده فرتَعنَ في رَوضاتهِ",115,"ت",2,0],["واسألِ الحبَّ عن روحي وعن بدني","فلا أرى لي لا روحاً ولا بدنا",116,"ن",2,0],["واسألهُ هلْ لهمْ إليهِ مرجعٌ","ولذلكَ الزمنِ القديمِ معادُ",117,"د",1,0],["وَاِسأَلوا سَيِّدَ الفَريقينِ حُجراً","يَومَ سارَت جُموعُنا بِاِحتِفالِ",118,"ل",1,1],["واسألن حتى أمير الأنبيا","هل نجا مما حواه من شرور",119,"ر",1,0],["وأسالت من جهام لهما","عارضا من ذهب لا من ديم",120,"م",1,0],["واسأل عرف الريح عن طيب نشركم","وعنكم اذا ما ضاع استنشق الطرقا",121,"ق",2,0],["واسألُ اللهَ أنْ يُبْقِيه مرتفعاً","تُبنى له في العُلا ا