20825.html","الرمل"],[512,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[527,"من ظن في بعمته أنها","https://www.aldiwan.net/poem37531.html","السريع"],[541,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[549,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[549,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[549,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"],[549,"لو لم يعاجله النوى لتحيرا","https://www.aldiwan.net/poem47806.html","الكامل"],[549,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[556,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[556,"أنا الوجود كما أني أنا العدم","https://www.aldiwan.net/poem33860.html","البسيط"],[556,"عن يمين الحي من إضم","https://www.aldiwan.net/poem34197.html","المديد"],[556,"بدر تم لاح في الغسق","https://www.aldiwan.net/poem34335.html","المديد"],[556,"هذه الأثواب والخلع","https://www.aldiwan.net/poem34397.html","المديد"],[556,"اغسلوا بي نجاسة الوسواس","https://www.aldiwan.net/poem34440.html","الخفيف"],[556,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[556,"أنا دائما يا نور كل مليح","https://www.aldiwan.net/poem34680.html","الكامل"],[567,"سلب الشباب رداءه","https://www.aldiwan.net/poem52022.html","مجزوء الكامل"],[573,"أيدفعني الدهر عن مطلبي","https://www.aldiwan.net/poem2750.html","المتقارب"],[584,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"]],"verses":[["وَأَسأَلُهُ أَن لا تَزالَ مُخَلَّداً","بِمَلقى سَماعٍ بَينَنا وَعِيانِ",0,"ن",1,0],["وَأُسامُ في أَكلاءِ مَوبِئَةٍ","مُحتَشُّها دونَ السَوامِ رَدي",1,"د",2,0],["وَأَسآلُهُم عَن جَنوبِ الحِمى","وَعَن أَرضِ نَجدٍ وَمَن حَلَّ نَجدا",2,"د",2,0],["وَاِسأَل بِهِ صِفّينَ إِنَّ زَئيرَهُ","أَودى بِكَبشِ أُمَيَّةَ النَطّاحِ",3,"ح",1,0],["وَاِسأَل شَراةَ النَهرَوانِ فَإِنَّهُم","ضَرَبوا بِمُنذَلِقِ اليَدَينِ وَقاحِ",3,"ح",1,0],["وَأَسأَلُ أَينَ مَصابُ الغَمامِ","شُروقاً إِذا ما غَدا أَو غُروبا",4,"ب",2,0],["وَأَسأَلُ أَن يُعطيكَ في العُمرِ فَسحَةً","لِعِلمِيَ أَنَّ العُمرَ يُعطى وَيوهَبُ",5,"ب",1,0],["وَاِسأَلاني عَن قَريبٍ","في الهَوى غَيرِ قَريبِ",6,"ب",1,0],["وَأَسأَلُ الرَّكبَ عَنها وَالدُّموعُ دَمٌ","بِناظِرٍ لَم يَخِطْ جَفناً عَلى وَسَنِ",7,"ن",1,0],["وأسْألُ الطّيْفَ عنْ سَلْمى إذا قُبِلَتْ","شَفاعَةُ النّوْمِ للسّاري إِلى المُقَلِ",8,"ل",1,0],["وَاِسأَل حُذَيفَةَ حينَ أَرَّشَ بَينَن","حَرباً ذَوائِبُها بِمَوتٍ تَخفِقُ",9,"ق",1,0],["وَاِسأَل عَنِ الأَظعانِ أَينَ سَرَت بِه","آباؤُها وَمَتى يَكونُ رُجوعُها",10,"ع",3,0],["وَأَسأَلُها حَملَ السَلامِ إِلَيكُمُ","فَإِن هِيَ يَوماً بَلَّغَت فَأَجيبي",11,"ب",2,0],["واسألْهُ عنْ وجْدِي يُجِبْكَ مُبادِراً","هَذا قِياسٌ ليْسَ بالمَرْفوعِ",12,"ع",1,0],["وَاسْأَلِي الْقَوْمَ هَلْ ثَنَيْتُ عِنَانَاً","عَنْ قَنَاةٍ أَوْ صَعْدَةٍ تَثَنَّى",13,"ن",2,0],["وَاسْأَل مَوَاقِفَنَا بِبَابِكَ يَوْمَ لَمْ","يُدْعَ لِخِدْمِتهِ سِوَى الْخُلْصَانِ",14,"ن",1,0],["وَأَسْألُ عَنْ أَخْبَارِهِ كُلَّ وَارِدٍ","فَيَالَيْتَ شِعْرِي كَيْفَ عَنِّي سُؤَالُهُ",15,"ل",2,0],["واسألْ عنِ النّعْمانِ حيرَتَهُ وقدْ","عشِقَ الشقيقَ الغَضَّ فهْوَ شِعارُهُ",16,"ر",2,0],["وَاِسأَل قُشَيراً وَعَبدَ اللَهِ كُلُّهُمُ","وَاِسأَل رَبيعَةَ عَنّا كَيفَ نَفتَعِلُ",17,"ل",1,0],["وَاِسأَلوا اللَهَ أَن يُديمَ عَلَينا","مُلكُ عَبّاسَ ناضِراً بَسّاما",18,"م",2,0],["وَاِسأَلوها في زَورَةٍ مِن خَيالٍ","إِن تَكُن لَم تَجِد مِنَ الهَجرِ بُدّا",19,"د",2,0],["وَأَسالَ باناسٌ ذَوائِبَهُ","فَتَجَعَّدَت في ضَيِّقِ السُبُلِ",20,"ل",1,0],["وَاِسأَل هُنالِكَ هَل عَنّى تَذَكُّرُنا","إِلفاً تَذَكُّرُهُ أَمسى يُعَنّينا",21,"ن",2,0],["وأساهم البلد الأمين وحزنه","بين الطوايا فوق ما في الظاهر",22,"ر",1,0],["واسألْ مواقفهم بكل مشهّر","واقرَ المغازي في الصحيح وفي السِّيَرْ",23,"ر",1,0],["وأسألنّ الشام عمّا قد أضا","للمُعاويّين فيها من فَخار",24,"ر",1,0],["وأساس عمران البلاد تَعاوُن","مُتواصل الأسباب من سُكّانها",25,"ن",3,0],["وأسال غرب الدمع منسكبا","من كل عين اثر منسكب",26,"ب",1,0],["وَاِسأَل ذَوي يَمَنٍ إِذا لاقَيتَهُم","وَاِسأَل قُضاعَةَ كُلَّها وَنِزارا",27,"ر",2,0],["وَاِسأَل ذَوي الأَلبابِ مِن سَرَواتِهِم","يَومَ العُهَينِ فَحاجِرٍ فَرُؤامِ",28,"م",1,0],["واسألهمُ تمطرك أيديهُمُ","عُرْفاً خلالَ الوبل منه رذاذْ",29,"ذ",1,0],["واسأل به فارساً إذ سار تطلبه","سيراً حثيثاً يغول الأرض خَشّافا",30,"ف",2,0],["وَاِسأَلِ الأَنجُم وَالريح وَسَل صَوبَ الغَمام","أَتَرى الشَيءَ كَما نَحنُ نَراهُ لَستُ أَدري",31,"ي",1,0],["وَاِسأَلهُ إِن كانَ يُرضيهِ ضَنى جَسَدي","فَحَبَّذا كُلَّ شَيءٍ كانَ يُرضيهِ",32,"ي",2,0],["وَأَسأَلَهُ وَلَيسَ يُرَدُّ حَرفاً","كَأَنَّ جَوابَ مَسأَلَتي حَرامُ",33,"م",1,0],["وَاِسأَلهُ عَن أَخبارِهِ","وَاِستَغنِ عَن مَضمونِ كُتُبي",34,"ب",2,0],["واسأل ذويها لو أجابوا سائلا","واجعل مدادك يا يراعي من دمي",35,"م",2,0],["واسأل لمصر عناية","تأتي وتهبط من عل",36,"ل",1,0],["وَأَسأَلُ أَن تَسلَمي لي السِنينَ","وَأَن تُرزَقي العَقلَ وَالعافِيَه",37,"ي",2,0],["وَأَساسٌ مِن عَهدِ عُثمانَ يُبنى","في ثَمانٍ وَمِثلُهُنَّ يُقامُ",38,"م",1,0],["وَاِسأَل لِمِصرَ عِنايَةً","تَأبى وَتَهبُطُ مِن عَلِ",39,"ل",1,0],["وأسألُها ما أستحقُّ قضاءَهُ","وما أنا ممّن رام حاجَتَهُ قسرا",40,"ر",2,0],["وأسألكمْ خِيماً سوى شِيَمِ الورى","كأني بأخلاقِ الوَرى غيرُ عالمِ",41,"م",1,0],["وَأَسأَلُ عَن غَيرِهِ قَبلَهُ","لَأَقسِمَ ظَنَّ الَّذي يَستَريبُ",42,"ب",1,0],["وَأَسأَلُكَ النِصفُ اِحتِجازاً وَرُبَّما","أَبَيتُ فَلَم أَسمَح لِغَيرِكَ بِالنِصفِ",43,"ف",1,0],["وَأَسأَلُ فيكَ أَبا صالِحٍ","وَما كانَ حَقُّكَ أَن أَسأَلَه",44,"ل",2,0],["وَاِسأَل بِنا وَبِكُم إِذا وَرَدَت مِنىً","أَطرافُ كُلِّ قَبيلَةٍ مَن يَسمَعُ",45,"ع",1,0],["وَاِسأَل بِقَومِكَ يا جَريرُ وَدارِمٍ","مَن ضَمَّ بَطنَ مِنىً مِنَ النُزّالِ",46,"ل",1,0],["وَاِسأَل بِتَغلِبَ كَيفَ كانَ قَديمُها","وَقَديمُ قَومِكَ أَوَّلَ الأَزمانِ",47,"ن",1,0],["وأساءَ الزَّمانُ فيه إلينا","حينَ أعطى القَليلَ منه وأكدى",48,"د",2,0],["وَاسأَل فَقَد يَكشِفُ عَنكَ العَمى","سُؤالُكَ العالِمَ في أُنسِهِ",49,"س",2,0],["وَأَسَأتَ كُلَّ إِساءَةٍ","وَظَنَنتَ أَنَّكَ تُحسِنُ",50,"ن",1,0],["وَأَسأَلُ مِنكَ أَن تَعفو وَتُعفي","مُحِبَّكَ مِن إِجابَتِهِ اِعتِقادا",51,"د",2,0],["وأسائل الزمن الخفيّ لعله","يشفي أواماً أواماً أو يبل غليلا",52,"ل",2,0],["وَإِساءاتُ ذي الإِساءَةِ يُذكِر","نَكَ يَوماً إِحسانَ ذي الإِحسانِ",53,"ن",1,0],["وَأُسْأَلُ يَوْمَ الْبَعْثِ عَنْ كُلِّ مَا وَعَى","سَمَاعٌ وَمَا فَاهَتْ بِهِ شَفَتَانِ",54,"ن",1,0],["وَاسْأَلْ عَنِ الْبَدْرِ الَّذِي كَسَمِيِّهِ","فِي نُورِ غُرَّتِهِ وَبُعْدِ مَرَامِهِ",55,"م",2,0],["واسألْ إلَهكَ عصمةً وحمايةً","فالسيئاتُ قواصفُ الأعمارِ",56,"ر",1,0],["وَأَسأَلُ هَل سَقى طَلَلاً بِحَزوى","عَفا قِدماً وَهلَ جادَ الغَميما",57,"م",2,0],["وَأَسأَل مَن لاقَيتُ عَن أُمِّ مالِكٍ","فَهَل يَسأَلانِ الحَيَّ عَن كَيفَ حالِيا",58,"ي",2,0],["وَاسْألْ عن الفتح المبينِ أما شَفَى","مُهَجاً يَهِيجُ غليلُها ونُفوسا",59,"س",2,0],["واسْألوا مُوسَى أَطابت نفسُه","أمْ أَبَى ما كان منكم فَنَقِمْ",60,"م",1,0],["وَاِسأَل مَنابِرَها العُليا أَما رَجَفَت","لَمّا هَوى الدَهرُ بِالغُرِّ البَهاليلِ",61,"ل",1,0],["وَاِسأَل عَنِ الشُهَداءِ أَينَ قُبورُهُم","فَإِذا عَرَفتَ فَطُف بِها وَتَعَبَّدِ",62,"د",1,0],["واسألوها إنّها ألسنة","يا ابن حربٍ للمنايا الحمرِ لُدّ",63,"د",1,0],["وأسَال صفحة خَدّه مَا مِسكَةٍ","عبقت بلام عذاره أو نونهِ",64,"ن",2,0],["وَاِسألي الباغين ماذا هالَهُم","مِنهُ في أَكفانِهِ إِن تَسألي",65,"ل",2,0],["وَاِسأَل فَإِنَّ لَنا مَناقِبَ شَكلُها","سِيٌّ مَضَت لِسَوالِفِ الأَعصارِ",66,"ر",1,0],["وَاِسأَل قُفَيرَةَ بِالمَرّوتِ هَل شَهِدَت","شَوطَ الحُطَيئَةِ بَينَ الكِسرِ وَالنَضَدِ",67,"د",1,0],["وَاِسأَل ثُغورَ الشامِ عَن وَصيفِ","يُخبِر بِفَتحٍ عَجَبٍ ظَريفِ",68,"ف",1,0],["وَأَسأَلُ نَيلاً لا يُجادُ بِمِثلِهِ","فَيَفتَحُهُ بِشرِي وَيَختُمُهُ عُذرِي",69,"ر",2,0],["وَأَسأَلُهُ رَدَّ الأَحاديثِ عَلَّهُ","سُؤالٌ وَأُخفي دَمعَةً تَفضَحُ الوَجدا",70,"د",2,0],["وَاِسأَلِ الدارَ مَتى فا","رَقَتِ الدارُ القَطينا",71,"ن",2,0],["وَأَساءَ ناكِحُ زَوجَةٍ نَصرانَةٍ","قَطَعَت لِأَجلِ نِكاحِهِ زِنّارَها",72,"ر",3,0],["وَأَسأَلُ خالِقي نسأً بِرِفقٍ","إِذا لَم يَبقَ لي إِلّا النَسيسُ",73,"س",1,0],["وَاِسأَل بِهِ الحَيَّ مِن عَدنانَ أَو سَبَإٍ","تَجِدهُ لَيسَ إِذا أَقوى بُوَسّالِ",74,"ل",1,0],["وَأَسأَلُ الخالِقَ مِن عِزِهِ","ما لَم يَكُن إِلّا لَهُ يُمكِنُ",75,"ن",1,0],["وَاِسأَل بِهِم أَسَداً إِذا جُعَلَت","حَربُ العَدُوِّ تَشُولُ عَن عُقمِ",76,"م",1,0],["واسأَلْ نجومَ اللّيلِ هل زارَ الكَرَى","جَفني وكيف يزورُ مَن لم يَعْرِفِ",77,"ف",1,0],["واسْأَلْ غزالَ كِنَاسِهِ هل عندهُ","عِلْمٌ بقَلبي في هواهُ وحاله",78,"ل",2,0],["واسألِ الرحمنَ أن يُصلِحَ عَه","داً كسيحاً وزماناً أعرَجا",79,"ج",2,0],["وأساطيرَ ليالٍ صُبِغَتْ","بدماءٍ سفكتهنَّ يداها",80,"ا",3,0],["وَاِسأَل حُذَيفَةَ حينَ أَرَّشَ بَينَنا","حَرباً ذَوائِبُها بِمَوتٍ تَخفِقُ",81,"ق",1,0],["وَاِسأَل عَنِ الأَظعانِ أَينَ سَرَت بِها","آباؤُها وَمَتى يَكونُ رُجوعُها",82,"ع",3,0],["وَاسْأَلْهُ مَغْفِرَةً لِمَنْ حَلَّ الثَّرَى","بِالأَمْسِ فَهْوَ مُجِيبُ كُل مُنَادِي",83,"ي",1,0],["وَاسَأَلْهُ غُفْرَاناً لِزَلاَّتِي فَقَدْ","ثَقُلَتْ علَيَّ وَعَفْوُ رَبِّكَ وَاسِعُ",84,"ع",1,0],["وَاسْأَلْهُ لِي صَبْراً فَحَسْبِي مِنْ رِضىً","بِاللِه أَنَّكَ فِي رِضَاهُ رَاتِعُ",84,"ع",1,0],["وَأَسَا جَرْحَى وَإِبْقَاءٌ عَلَى","أُسُدٍ أَلْصقهَا بِالأَرْضِ جُوْعْ",85,"ع",1,0],["وَأَسْأَلُ كَيْفَ حَالُكُمُ جَمِيعاً","فَإِنِّي فِي اشْتِيَاقٍ وَالتِيَاحْ",86,"ح",1,0],["واسألي الزهر أن تكون دموعا","واسألي الأزهار",87,"ر",1,0],["وأسأل الحفل عنهم لا يجاوبني","كأنما الحفل في آذانه صممُ",88,"م",1,0],["وَاِسأَلهُ هَل نَسيَ الَّذي","أَودَعتُ عِندَ وَداعِهِ",89,"ع",2,0],["وأَسأَلُ السُّفْنَ عن أخبارهِ طَمَعاً","وأنْثَنِي وبقَلبي منه لَوْعَاتُ",90,"ت",1,0],["واسْأَلْ نَمُوراً ما دَهَى أَهْلَها","فقدْ نَعاهَا البَرْقُ فيما نَعَى",91,"ع",2,0],["واسألْ ذوي الألبابِ عن سرواتهمْ","يومَ العهينِ ، فحاجرٍ ، فرؤامِ",92,"م",1,0],["واسِ الضعيف يكن ليومك أسوة","وكذا الشُعوب كما تدين تدان",93,"ن",1,0],["وأسأَلُ قلبي أتعرفُها؟","فيضحكُ منّي ولا أفهمُ",94,"م",1,0],["وَأَسْأَتَ تَكْرَارُ السُّؤَالِ ذَوِي الفَضْلِ","أَراهَا أصحَّ الآنَ حسْماً وَأَجْمَلاَ",95,"ل",2,0],["وَأَسألك القَليل مِن التَلاقي","وَلَكن خَشيَتي مِن سوءِ رَدك",96,"ك",1,0],["واسال في الله الدموع بهمة","تعلو عزائمها عن الاضداد",97,"د",1,0],["واسأل قلبي أي ذنب جنيته","والقيتني من وهدة الهجر في جب",98,"ب",1,0],["وأسأل من إله العرش فتحاً","قريباً فيهم وبأهل بدر",99,"ر",1,0],["وأسأله عطفاً على حالتي التي","لها مقلتي سالت كسيل الغمائم",100,"م",1,0],["وأساء محسن للقرين وعرسه","ولنا عشية صاغ عقد قرانه",101,"ن",2,0],["واسأل فرديك بن بيك","إذا شككت بذاك يشهد",102,"د",1,0],["واسأَل من الرحمن عنها عِصْمَة","هلاَّ رأيتَ المنحَ منها محنَة",103,"ه",1,0],["وَاسأَلاَ النُّؤءىَ والأوَارِىَ والسُّفعَ","ثَلاَثاً بجَنبِ هَابٍ جُثُومَا",104,"م",2,0],["وأسأل الركبَ أنباءً فيكتمُنى","كأنّكم في صدورِ القوم أسرارُ",105,"ر",1,0],["وَاِسأَلهُ ما تَحوي يَداهُ يُنلِكَهُ","كَرَماً وَأَمّا مَجدَهُ الزاكي فَلا",106,"ل",2,0],["وأسألها عنه فكلّ أجابني","بأنه ما رآه يوما ولا أدرا",107,"ر",2,0],["وأسألُ عن نجد وفيه مخيّمي","وأطلب روض الرقمتين ونعمانا",108,"ن",2,0],["وأسأل من ربي اللقاء فإنه","قديرٌ ولي في ذي الجلال رجاء",109,"ا",2,0],["وأَسْأَلُ مَنْ بِبَيْنِكُمُ رَمَاني","يَمُنُّ عَلَيَّ مِنْكُمْ بِالرُّجُوعِ",110,"ع",1,0],["وأسأله كم حذرته من شؤم من","ظهرت له في الشؤم منه عبرة",111,"ه",1,0],["وأسام آمالي العريضة وادياً","من جوده فرتَعنَ في رَوضاتهِ",112,"ت",2,0],["واسألِ الحبَّ عن روحي وعن بدني","فلا أرى لي لا روحاً ولا بدنا",113,"ن",2,0],["واسألهُ هلْ لهمْ إليهِ مرجعٌ","ولذلكَ الزمنِ القديمِ معادُ",114,"د",1,0],["وَاِسأَلوا سَيِّدَ الفَريقينِ حُجراً","يَومَ سارَت جُموعُنا بِاِحتِفالِ",115,"ل",1,1],["واسألن حتى أمير الأنبيا","هل نجا مما حواه من شرور",116,"ر",1,0],["وأسالت من جهام لهما","عارضا من ذهب لا من ديم",117,"م",1,0],["واسأل عرف الريح عن طيب نشركم","وعنكم اذا ما ضاع استنشق الطرقا",118,"ق",2,0],["واسألُ اللهَ أنْ يُبْقِيه مرتفعاً","تُبنى له في العُلا الأبراجُ والغُرَفُ",119,"ف",1,0],["واسألُ عنكم كلَّ ريحٍ تَمُرُّ بي","وأطلِقُ أفراسي لا خبارِكُم رَكْضَا",120,"ض",2,0],["واسأل اللهَ جمعَِ الشملِ في سَرَعٍ","عسى تفارقني الأحزانُ والكَدَرُ",121,"ر",1,0],["واسألُ ربي أنْ يكونَ معافياً","مدى الدهرِ والرّبُ الإله قديرُ",122,"ر",1,0],["واسأل اللهَ أن ألقاه في نِعَمٍ","بجنةِ سكننا إنْ ساعفَ القَدَرُ",123,"ر",1,0],["واسألُ ربي أن يزيدكَ رفعةً","وعزّاً ونصراً لا تكون مكدّرا",124,"ر",2,0],["واسأل ربي أن يخلِّدَ ملكَهُ","وتسمو لعلياه به درجاتُها",125,"ت",3,0],["واسأل اللهَ جمع الشمل في سرَع","عَنْ نصطلي زمناً نيرانَ فرقتِهِ",126,"ت",2,0],["وأسْألُ اللهَ أن يبقيه في نِعَمٍ","والخيرُ يجري إليه جريُ مُنْسَرِبِ",127,"ب",1,0],["وأساس قانون الصبا","بة غير قانون الأساس",128,"س",1,0],["واسألوا يوم خيبرٍ واسألوا مكْ","كة عن كَرِّه على الفُجّار",129,"ر",1,0],["واسألوا يوم بَدْر مَن فارسُ الإس","لام فيه وطالبُ الأوتار",129,"ر",1,0],["واسأل لي الرحمن روحاً إذا","ضمّ عظامي برزخ ضيّق",130,"ق",1,0],["واسأل الله لطفه في حباء","فإليه صبابتي وحفاظي",131,"ظ",2,0],["واسأل لي الله العظيم سلامة","ولهم وستراً شاملاً لا يسلخ",132,"خ",1,0],["واسأل لأمتك الحيا غدقا فقد","فقد المزارع ماءها السحاحا",133,"ح",2,0],["واسأل الهك أن يكون بقهره","لعدوهم مستأصلا مجتاحا",133,"ح",2,0],["واسأله هل حيّا مرابعه الحيا","وكسا الربيع شعابه من عشبه",134,"ب",2,0],["وأسأل الله حين تعرض أعما","لي عليك الغفران لي يا رجائي",135,"ا",2,0],["وَأُسامَةٌ فَاِزدادَ تَطهيراً إِلى","طهرٍ وَلُفَّ بِأَفخَرِ الأكفانِ",136,"ن",1,0],["وَأسأَلُ البَرقَ أَحياناً فَتُخبِرُني","عَنهُمُ بِما يَملَأُ الأَحشاءَ إِحراقا",137,"ق",2,0],["وَاِسأَل مَغاني الحَيِّ بَع","دِيَ هَل تَغَيَّرَتِ الرُسومُ",138,"م",1,0],["وَأُسامَةُ الماضي الصَقي","لُ وَذَلِكَ النابي الصَدي",139,"د",2,0],["وَأُسامَةُ الغَمرُ الرِداءِ","وَذَلِكَ الغُمرُ الرَدي",139,"د",2,0],["وَاِسأَل كَثيبَي رِمالٍ عَن رَشاءٍ","عَنّا بِسُمرِ الرِماحِ مَحجوبِ",140,"ب",1,0],["وَأَسَاءَ إِذْ أَهْدى الزُّيُو","فَ لِمَعْدِنَيْ وَرِقٍ وَعَسْجَدْ",141,"د",1,0],["وَأَسْأَلُ رَبِّي أَنْ يُعَظِّمَ أَجْرَنَا","وَأَجْرَكُمْ فِي السَّيِّدِ السَّنَدِ الْبَرِّ",142,"ر",1,0],["وَاِسأَل تَميماً بِنا يَومَ الجِفارِ وَسَل","عَنّا بَني لَأمٍ إِذ وَلَّوا وَلَم يَقِفوا",143,"ف",3,0],["واسألي عن حالِ بالي","بلْ مَآلي حين نَحْبي",144,"ي",1,0],["واسأله بمن للعاص ضمِنْ","حاشاه به للراج يضِنْ",145,"ن",1,0],["واسألوا الرحمن يَهدي رَحمة","تشمل الاموات في بطن الثرى",146,"ر",2,0],["واسأل الحي عن محب صحبنا","قَديما وَكان برّا وَصولا",147,"ل",2,0],["واسأله السَلامة من زَمان","بليت به نوائبه تشيب"