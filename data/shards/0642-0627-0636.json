هون وأصون","https://www.aldiwan.net/poem14687.html","الكامل"],[198,"قاض يجور على الضعيف وربما","https://www.aldiwan.net/poem51849.html","الكامل"],[198,"ذرني ونجدا لا حملت نجادي","https://www.aldiwan.net/poem51954.html","الكامل"],[210,"شد المناطق يثني عطف مخمور","https://www.aldiwan.net/poem13307.html","البسيط"],[210,"آيات حسنك قد أبدت لنا عجبا","https://www.aldiwan.net/poem13309.html","البسيط"],[210,"لطائر البشر بالأفراح تغريد","https://www.aldiwan.net/poem13312.html","البسيط"],[210,"مولاي حاشاك لقد مال بي","https://www.aldiwan.net/poem13318.html","السريع"],[210,"يا أيها المولى الذي جوده","https://www.aldiwan.net/poem13320.html","السريع"],[210,"مولاي عز الطلب","https://www.aldiwan.net/poem13321.html","مجزوء الرجز"],[210,"دع عنك يا عاذلي لومي وتعنيفي","https://www.aldiwan.net/poem13328.html","البسيط"],[210,"قسما بليل الشعر منك إذا سجا","https://www.aldiwan.net/poem13395.html","الكامل"],[210,"نقل الغرام حديث دمعي مرسلا","https://www.aldiwan.net/poem13420.html","الكامل"],[210,"وافى السرور وصحت الأحلام","https://www.aldiwan.net/poem13476.html","الكامل"],[210,"بك المناصب في العلياء تفتخر","https://www.aldiwan.net/poem13551.html","البسيط"],[210,"الدهر قد حسنت بكم أيامه","https://www.aldiwan.net/poem13552.html","الكامل"],[229,"أيها الماجد الذي لم يقصر","https://www.aldiwan.net/poem51050.html","الخفيف"],[237,"حي على الأنس إن طيف الهموم سرى","https://www.aldiwan.net/poem18192.html","البسيط"],[282,"لئن نأت بعد قرب منكم الدار","https://www.aldiwan.net/poem32761.html","البسيط"],[285,"قاضي الإسلام داوود البطل","https://www.aldiwan.net/poem39351.html","الرمل"],[305,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[353,"قاض لنا أحكم أحكامه","https://www.aldiwan.net/poem40217.html","السريع"],[353,"أأنت أم أنا أم ما نلت من رتب","https://www.aldiwan.net/poem40818.html","البسيط"],[364,"إن أقمر الليل للسارين في حضن","https://www.aldiwan.net/poem60631.html","البسيط"],[364,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[371,"ليكن عقابك لي بحسب تجلدي","https://www.aldiwan.net/poem57506.html","الكامل"],[402,"قاضي القضاة وعالم العلما الذي","https://www.aldiwan.net/poem46479.html","الكامل"],[429,"خود من الترك قد صالت على العرب","https://www.aldiwan.net/poem40050.html","البسيط"],[432,"ما أطول الليل على الساهر","https://www.aldiwan.net/poem12619.html","السريع"],[432,"وكأنما مدح الأثير أثارها","https://www.aldiwan.net/poem12736.html","الكامل"],[437,"الله أكبر هذا مربع الجود","https://www.aldiwan.net/poem2539.html","البسيط"],[441,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[452,"أورى الهوى بحشاي زندا","https://www.aldiwan.net/poem13712.html","مجزوء الكامل"],[452,"مولاي وافدة الثناء تأرجت","https://www.aldiwan.net/poem13767.html","الكامل"],[452,"برح الخفاء فما ذكاء إياس","https://www.aldiwan.net/poem13807.html","الكامل"],[464,"ما على الركب من تلافي تلافي","https://www.aldiwan.net/poem3215.html","عموديه"],[495,"قرة عيني بذكا محبتي أي فلكا","https://www.aldiwan.net/poem10256.html","مجزوء الرجز"],[514,"ما الراح إلا روح كل حزين","https://www.aldiwan.net/poem20791.html","الكامل"],[514,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[575,"قارنها الدمع فبئس القرين","https://www.aldiwan.net/poem3004.html","السريع"]],"verses":[["قاضيكَ إِن لَم تُقصِهِ فَاخصِهِ","أَولا فَلا يَحكُمُ بَينَ النِسا",0,"س",2,0],["قاضِياتٍ لُبانَةً مِن مُناخٍ","وَطَوافٍ وَمَوقِفٍ بِالجِبالِ",1,"ل",1,0],["قاضي القضاة إذا أعيا الورى فطناً","حسيرة العين دون الباء والتاء",2,"ا",2,0],["قاضي القضاةِ عزاءً عن إمام تقى","بالفضلِ أوصى وصايا المرءِ بالعَقب",3,"ب",1,0],["قاضي قضاةِ الدّين لم يبق لي","من قربكم لي أمل خائب",4,"ب",1,0],["قاضي القضاة الملبَّى","تاج السراة الألبه",5,"ب",2,0],["قاضي القضاة المرتجى دمت ذا","نعماه للصادر والواردِ",6,"د",1,1],["قاضي القضاة جلال الدِّين قد وضحت","سبل القريض وصاغ القول ماهره",7,"ر",2,0],["قاضي القضاة أعزَّ الله جانبه","أولى بقصدي وتأميلي وأشعاري",8,"ي",1,1],["قاضي القضاة وإنها لمكانةٌ","طهرت بسؤدده من الأدناس",9,"س",1,0],["قاضٍ قضى بالندى العميم فما","في حكمِهِ محضرٌ لإفلاس",10,"س",1,0],["قاضي القضاة بقيتَ مأثور الدعا","وجُزيت خيراً عن صريخِ الناس",11,"س",1,1],["قاضي القضاة وإنها لمكانةٌ","خطبت تقاه كما تشا وكما يشا",12,"ش",2,0],["قاضي قضاة الدين دمْ في علىً","لا تلحن الأيام في رفعها",13,"ع",3,1],["قاضي القضاة لك اتِّصال سلامة","ولحاسديكَ مسآءة وتلاف",14,"ف",1,1],["قاضي القضاة حبَّذا تكرمة","تنزِّه المملوك في صنوفها",15,"ه",2,1],["قاضي القضاة تهنها علياء ما","برحت ببيتكم الممدّح أليقا",16,"ق",2,0],["قاضي القضاة ويا أبا الحسن الذي","شرفت أصول علاه والأعراق",17,"ق",1,0],["قاضي القضاة الذي سارت مآثرهُ","بغير مثلٍ يوازيها سوى المثل",18,"ل",1,0],["قاضي القضاة الذي مواهبه","قد خلقتْ للرجاء من عجل",19,"ل",1,0],["قاضي القضاة عليّها وتقيّها","ما لي على خلق سواك معوّل",20,"ل",1,1],["قاضي القضاة جمعت للزهدِ الندى","فغدوت في الحالين تبعث بالولي",21,"ي",1,1],["قاضي القضاة لقد حويت من العلى","خطًّا يطلُّ على الكواكبِ من عل",22,"ل",1,1],["قاضي القضاة بيمنى حكمه القلم","يا ساريَ القصد هذا الباب والعلم",23,"م",1,1],["قاضٍ قضى العدل ولكنه","قضى على المال قضاء الغريم",24,"م",1,0],["قاضي القضاة عليه يعقد خنصر","ويضيء وجه العلم من إبهام",25,"م",1,0],["قاضٍ له شاهد إرث ومكتسبٍ","في الفضلِ يا حبَّذا قاضٍ وعدلان",26,"ن",1,0],["قاضي القضاة أخا التّقى","لا يعدم الطّلاّب مَنَّكْ",27,"ك",1,0],["قاضي القضاة بعثت لي شهب السما","ونجومها وأردتَ رفعةَ شاني",28,"ن",2,1],["قاضي قضاة الدِّين ما شهبه","خائفة القطع ولا خافيه",29,"ف",3,0],["قاضي القُضاةِ جَرَت عَلَيهِ قَضِيَّةٌ","لِلمَوتِ لَيسَ لَها مِنِ اِستِئنافِ",30,"ف",1,0],["قاضى السِياسَةِ نالَهُم بِعِقابِهِ","خَشِنَ الحُكومَةِ في الشَبابِ عَتيدا",31,"د",2,0],["قاضٍ إِذا اِلتَبَسَ الأَمرانِ عَنَّ لَهُ","رَأيٌ يُخَلِّصُ بَينَ الماءِ وَاللَبَنِ",32,"ن",1,0],["قاضٍ إِذا التَبَسَت حَقيقَةُ مُشكِلٍ","أَبدَت لَهُ الآراءُ ما هُوَ خافِ",33,"ف",1,0],["قاضٍ لنا مهما انثنى أوْ بدا","يغارُ منهُ الغصنُ والبدرُ",34,"ر",1,1],["قاضي القضاةِ المهذبُ الفطنُ ال","أروعُ كهفُ المسودِ والسائدْ",35,"د",1,0],["قاضٍ من السّوقِ أتى","معتادُ بيعِ الأكسيهْ",36,"ه",1,1],["قاضٍ عن الناسِ غيرُ راضٍ","مباهتٌ خالطٌ مغالِطْ",37,"ط",1,1],["قاضيَةً حَقّهُ لديْكَ وما","يُنسَبُ إلاّ إليكَ سُودَدُها",38,"د",3,0],["قَاضَيْتُهُ عِنْدَ مَلِيكِ الْهَوَى","فَغَلَّ حَقِّي وَأَسَاءَ الْقَضَا",39,"ض",2,0],["قَاضُونَ لِلْحَاجَاتِ بَادٍ بِشْرُهُمْ","في وَجْهِ مُرْتَادِ النَّدَى وَالطَّالِبِ",40,"ب",1,0],["قاضٍ يَرى الحَدَّ في الزِناءِ وَلا","يَرى عَلى مَن يَلوطُ مِن باسِ",41,"س",1,1],["قاضي القضاة المعوان","على الزمان إذا مان",42,"ن",1,0],["قاض إِذا التَبَسَت أُمور جَدِها","بِحسام حُكم بِالمَضا مَوصوف",43,"ف",1,0],["قاضي القُضاة وَناهيكُم بِهِ حُكماً","ما خابَ يَوماً بِهِ مِن راح يَعتَصم",44,"م",1,0],["قاض نَود لَو أَنَّها فَرشت لَهُ","عِندَ القُدوم كَواكب الأَغلاس",45,"س",1,0],["قاضٍ أَتَى والحَقُّ غُصنٌ ذَابِلٌ","فَسَقاهُ ماءَ العَدلِ حَتَّى أَثمَرَا",46,"ر",2,0],["قاضي اللُّبانةِ لم يفطِن لها أملٌ","كأنّه لهوى العافى بمِرصادِ",47,"د",1,0],["قاضٍ مَضى لسبيلهِ لمّا قَضى","ما كانَ أوّلَ مَن قَضى ثمَّ انْقَضى",48,"ض",2,1],["قاضِي القضاة ومن يُشيد بعد له","هادي الدُّعاةِ ومن إليه يَدين",49,"ن",1,0],["قاض يجورُ على الضعيف وربما","لقي القويَّ بمثلِ حلم الأحنفِ",50,"ف",1,1],["قاضٍ إذا يمَّمْتُ عَدْلَ قضائهِ","لم أُعْطَ جَوْرَ الحادثاتِ قِيادي",51,"د",2,0],["قاضي القضاة الذي عين الزمان به","قرّت ومن فعله لي أي تقرير",52,"ر",1,0],["قاضي القضاة الذي ما رمت نائله","الا وفقري مني حاول الهربا",53,"ب",2,0],["قاضي القضاة ومن بالفضل قد شهدت","له الاماثل والغر الاماجيد",54,"د",1,0],["قاضي القضاة الشافعي الذي","من بابه ام غدا في امان",55,"ن",1,0],["قاضي القضاة الالمعي الذي","يبين الحق من الباطل",56,"ل",1,0],["قاضي القضاة ذو العلا","حسبك هذا النسب",57,"ب",1,0],["قاضي القضاة ومن مصر به شرفت","على الممالك فخرا أي تشريف",58,"ف",1,0],["قاضي القضاة ابو السعود ومن به","فلك المعالي بالمعاني اسرجا",59,"ج",2,0],["قاضي القضاة وواحد العصر الذي","كم غامض ابدى وأوضح مشكلا",60,"ل",2,0],["قاضي القضاة المفرد العلم الذي","ايامه رفعت بها الاعلام",61,"م",1,0],["قاضي القضاة ولي الدين من شهدت","بفضله وعلاه البدو الحضر",62,"ر",1,0],["قاضي القضاة المالكي ومن سمت","في كل اقليم به اقلارمه",63,"م",2,0],["قاضياً في زيارتي لك حقّاً","ليس تقضيه رُ