wan/poem/36715","المنسرح"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99213","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114285","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114273","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133295","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133285","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133281","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54504","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94392","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94519","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136670",""],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62134","الكامل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62130","الخفيف"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62135","البسيط"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62128","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83148","الرجز"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103161","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72926","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72874","المتدارك"],[4755,"ها قَد أَصبَحتَ عَلَى وَطَنٍ","https://www.poetsgate.com/ViewPoem.aspx?id=198372",""],[4119,"يا سعد ما أحسنها شمائلا","https://www.poetsgate.com/ViewPoem.aspx?id=16208",""],[5573,"الياس جمره تشتعل داخل الجوف","https://www.poetsgate.com/ViewPoem.aspx?id=200075",""],[5582,"طَرَقَ الطَّيْفُ وَقَدْ زارَ وِسادِي","https://www.poetsgate.com/ViewPoem.aspx?id=186881",""],[5956,"القاضي الظالم","https://www.poetsgate.com/ViewPoem.aspx?id=193647",""],[5956,"بعدالةٍ من أحمد الطعمينا","https://www.poetsgate.com/ViewPoem.aspx?id=194285",""],[242,"حي على الأنس ان طيف الهموم سرى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563699",""]],"verses":[["قاضيكَ إِن لَم تُقصِهِ فَاخصِهِ","أَولا فَلا يَحكُمُ بَينَ النِسا",0,"س",2,0],["قاضِياتٍ لُبانَةً مِن مُناخٍ","وَطَوافٍ وَمَوقِفٍ بِالجِبالِ",1,"ل",1,0],["قاضي القضاة إذا أعيا الورى فطناً","حسيرة العين دون الباء والتاء",2,"ا",2,0],["قاضي القضاةِ عزاءً عن إمام تقى","بالفضلِ أوصى وصايا المرءِ بالعَقب",3,"ب",1,0],["قاضي قضاةِ الدّين لم يبق لي","من قربكم لي أمل خائب",4,"ب",1,0],["قاضي القضاة الملبَّى","تاج السراة الألبه",5,"ب",2,0],["قاضي القضاة المرتجى دمت ذا","نعماه للصادر والواردِ",6,"د",1,1],["قاضي القضاة جلال الدِّين قد وضحت","سبل القريض وصاغ القول ماهره",7,"ر",2,0],["قاضي القضاة أعزَّ الله جانبه","أولى بقصدي وتأميلي وأشعاري",8,"ر",2,1],["قاضي القضاة وإنها لمكانةٌ","طهرت بسؤدده من الأدناس",9,"س",1,0],["قاضٍ قضى بالندى العميم فما","في حكمِهِ محضرٌ لإفلاس",10,"س",1,0],["قاضي القضاة بقيتَ مأثور الدعا","وجُزيت خيراً عن صريخِ الناس",11,"س",1,1],["قاضي القضاة وإنها لمكانةٌ","خطبت تقاه كما تشا وكما يشا",12,"ش",2,0],["قاضي قضاة الدين دمْ في علىً","لا تلحن الأيام في رفعها",13,"ع",3,1],["قاضي القضاة لك اتِّصال سلامة","ولحاسديكَ مسآءة وتلاف",14,"ف",1,1],["قاضي القضاة حبَّذا تكرمة","تنزِّه المملوك في صنوفها",15,"ه",2,1],["قاضي القضاة تهنها علياء ما","برحت ببيتكم الممدّح أليقا",16,"ق",2,0],["قاضي القضاة ويا أبا الحسن الذي","شرفت أصول علاه والأعراق",17,"ق",1,0],["قاضي القضاة الذي سارت مآثرهُ","بغير مثلٍ يوازيها سوى المثل",18,"ل",1,0],["قاضي القضاة الذي مواهبه","قد خلقتْ للرجاء من عجل",19,"ل",1,0],["قاضي القضاة عليّها وتقيّها","ما لي على خلق سواك معوّل",20,"ل",1,1],["قاضي القضاة جمعت للزهدِ الندى","فغدوت في الحالين تبعث بالولي",21,"ي",1,1],["قاضي القضاة لقد حويت من العلى","خطًّا يطلُّ على الكواكبِ من عل",22,"ل",1,1],["قاضي القضاة بيمنى حكمه القلم","يا ساريَ القصد هذا الباب والعلم",23,"م",1,1],["قاضٍ قضى العدل ولكنه","قضى على المال قضاء الغريم",24,"م",1,0],["قاضي القضاة عليه يعقد خنصر","ويضيء وجه العلم من إبهام",25,"م",1,0],["قاضٍ له شاهد إرث ومكتسبٍ","في الفضلِ يا حبَّذا قاضٍ وعدلان",26,"ن",1,0],["قاضي القضاة أخا التّقى","لا يعدم الطّلاّب مَنَّكْ",27,"ك",1,0],["قاضي القضاة بعثت لي شهب السما","ونجومها وأردتَ رفعةَ شاني",28,"ن",2,1],["قاضي قضاة الدِّين ما شهبه","خائفة القطع ولا خافيه",29,"ف",3,0],["قاضي القُضاةِ جَرَت عَلَيهِ قَضِيَّةٌ","لِلمَوتِ لَيسَ لَها مِنِ اِستِئنافِ",30,"ف",1,0],["قاضى السِياسَةِ نالَهُم بِعِقابِهِ","خَشِنَ الحُكومَةِ في الشَبابِ عَتيدا",31,"د",2,0],["قاضٍ إِذا اِلتَبَسَ الأَمرانِ عَنَّ لَهُ","رَأيٌ يُخَلِّصُ بَينَ الماءِ وَاللَبَنِ",32,"ن",1,0],["قاضٍ إِذا التَبَسَت حَقيقَةُ مُشكِلٍ","أَبدَت لَهُ الآراءُ ما هُوَ خافِ",33,"ف",1,0],["قاضٍ لنا مهما انثنى أوْ بدا","يغارُ منهُ الغصنُ والبدرُ",34,"ر",1,1],["قاضي القضاةِ المهذبُ الفطنُ ال","أروعُ كهفُ المسودِ والسائدْ",35,"د",1,0],["قاضٍ من السّوقِ أتى","معتادُ بيعِ الأكسيهْ",36,"ه",1,1],["قاضٍ عن الناسِ غيرُ راضٍ","مباهتٌ خالطٌ مغالِطْ",37,"ط",1,1],["قاضيَةً حَقّهُ لديْكَ وما","يُنسَبُ إلاّ إليكَ سُودَدُها",38,"د",3,0],["قَاضَيْتُهُ عِنْدَ مَلِيكِ الْهَوَى","فَغَلَّ حَقِّي وَأَسَاءَ الْقَضَا",39,"ض",2,0],["قَاضُونَ لِلْحَاجَاتِ بَادٍ بِشْرُهُمْ","في وَجْهِ مُرْتَادِ النَّدَى وَالطَّالِبِ",40,"ب",1,0],["قاضٍ يَرى الحَدَّ في الزِناءِ وَلا","يَرى عَلى مَن يَلوطُ مِن باسِ",41,"س",1,1],["قاضي القضاة المعوان","على الزمان إذا مان",42,"ن",1,0],["قاض إِذا التَبَسَت أُمور جَدِها","بِحسام حُكم بِالمَضا مَوصوف",43,"ف",1,0],["قاضي القُضاة وَناهيكُم بِهِ حُكماً","ما خابَ يَوماً بِهِ مِن راح يَعتَصم",44,"م",1,0],["قاض نَود لَو أَنَّها فَرشت لَهُ","عِندَ القُدوم كَواكب الأَغلاس",45,"س",1,0],["قاضٍ أَتَى والحَقُّ غُصنٌ ذَابِلٌ","فَسَقاهُ ماءَ العَدلِ حَتَّى أَثمَرَا",46,"ر",2,0],["قاضي اللُّبانةِ لم يفطِن لها أملٌ","كأنّه لهوى العافى بمِرصادِ",47,"د",1,0],["قاضٍ مَضى لسبيلهِ لمّا قَضى","ما كانَ أوّلَ مَن قَضى ثمَّ انْقَضى",48,"ض",2,1],["قاضِي القضاة ومن يُشيد بعد له","هادي الدُّعاةِ ومن إليه يَدين",49,"ن",1,0],["قاض يجورُ على الضعيف وربما","لقي القويَّ بمثلِ حلم الأحنفِ",50,"ف",1,1],["قاضٍ إذا يمَّمْتُ عَدْلَ قضائهِ","لم أُعْطَ جَوْرَ الحادثاتِ قِيادي",51,"د",2,0],["قاضي القضاة الذي عين الزمان به","قرّت ومن فعله لي أي تقرير",52,"ر",1,0],["قاضي القضاة الذي ما رمت نائله","الا وفقري مني حاول الهربا",53,"ب",2,0],["قاضي القضاة ومن بالفضل قد شهدت","له الاماثل والغر الاماجيد",54,"د",1,0],["قاضي القضاة الشافعي الذي","من بابه ام غدا في امان",55,"ن",1,0],["قاضي القضاة الالمعي الذي","يبين الحق من الباطل",56,"ل",1,0],["قاضي القضاة ذو العلا","حسبك هذا النسب",57,"ب",1,0],["قاضي القضاة ومن مصر به شرفت","على الممالك فخرا أي تشريف",58,"ف",1,0],["قاضي القضاة ابو السعود ومن به","فلك المعالي بالمعاني اسرجا",59,"ج",2,0],["قاضي القضاة وواحد العصر الذي","كم غامض ابدى وأوضح مشكلا",60,"ل",2,0],["قاضي القضاة المفرد العلم الذي","ايامه رفعت بها الاعلام",61,"م",1,0],["قاضي القضاة ولي الدين من شهدت","بفضله وعلاه البدو الحضر",62,"ر",1,0],["قاضي القضاة المالكي ومن سمت","في كل اقليم به اقلارمه",63,"م",2,0],["قاضياً في زيارتي لك حقّاً","ليس تقضيه رُقْعتي واستتاري",64,"ر",2,0],["قَاضِي الْقُضَاةِ الذِي لاَ شَيْءَ يَعْدِلُهُ","فِي عَدْلِهِ اللَّذْ فَشَا فِي النَّاسِ وَاشْتَهَرَا",65,"ر",2,0],["قاضٍ إِذا اِختَلَفَ الخَصمانِ كانَ لَهُ","في نُصرَةِ الحَقِّ إيرادٌ وَإِصدارُ",66,"ر",1,0],["قاضي الإسلام داوود البطل","أسد الإسلام بالنصرة طل",67,"ل",1,1],["قاض إذا شهد النزال لغائب","يمضي ولا يمضي عليه قضاءُ",68,"ا",2,0],["قاضٍ لَنا أحكم أَحكامه","بِالجور حَتّى ما لَنا مِن مُجير",69,"ر",1,1],["قاضٍ عَلى مِنبرِ الهاماتِ في يَدِهِ","بِالخَطبِ نَسمَع مِنهُ أَبلَغ الخُطَبِ",70,"ب",1,0],["قاضي قُضاةِ بلادٍ قد أُتيحَ لها","منه مُقيمُ فُروضِ المَجْدِ والسُّنَن",71,"ن",1,0],["قاضي القُضاةِ طاهِرُ عِمادُهُ","خِدنُ العُلا النَدبُ أَبو مُحَمَّدِ",72,"د",1,0],["قاضٍ تُرى الأيام قاضيةً له","أبداً تروح بما يحبُّ وتغتدي",73,"د",2,0],["قاضي القضاةِ وعالم العُلَما الَّذي","أحيى من المجدِ الأَثيلِ رُفاتا",74,"ت",2,1],["قاضي القضاة أمامٌ ليس تأخذهُ","في اللَه لومة ذي لومٍ وذي عتب",75,"ب",1,0],["قاضٍ مُجيدُ الشِعْر في وصفهِ","يُهدي البضاعاتِ الى التاجِرِ",76,"ر",1,0],["قاضٍ له فضلُ القضاءِ فقد غَدا","يرْضى بحكمةِ حكمهِ الخَصْمانِ",77,"ن",1,0],["قاض يظلّ به الإسلام مبتهجا","إذ لمّ شملا له من بعد تبديد",78,"د",1,0],["قاضي القضاة وسيف اللّه قد سفرت","أفعاله البيض في أيامنا السود",78,"د",1,0],["قاض يرى بفؤاده ما لا يرى","بعيونه الفطن النبيه الأصمع",79,"ع",1,0],["قاضي العساكر من أنا","فَ على الورى كَرَماً ومجدَا",80,"د",2,0],["قاضي دمشقَ ومن قضى بجميله","أن تسترقّ لفضله الأحرار",81,"ر",1,0],["قاضي دِمَشقَ الأصمعيّ محمد","تِرْبُ الندى طَوْدُ العلوم الراسي",82,"س",2,0],["قاضب العزم والسيوف نواب","عاقر الكوم في السنين العجاف",83,"ف",1,0],["قاض إذا ما جنّهُ اللّي","ل يصيد السمكا",84,"ك",2,0],["قاضٍ بأحكام الشريعة عالِمٌ","بقواعدِ الإرشادِ والتبيينِ",85,"ن",1,0],["قاضٍ إذا اِختلفَ الخُصومُ كأنّما","فصْلُ الخِطابِ رواهُ عن داودِ",86,"د",1,0],["قاضٍ قَضَى اللهُ بأَن لا يُرى","قِرْنٌ له في خَلْقِه أَو قَرِين",87,"ن",1,0],["قاضيكمُ يا أميرُ أصلحَك اللهُ","تَعالى السعيدُ مسعودُ",88,"د",1,1],["قاض مقر العدل في أبوابه","فالجور من أرجائها لا يقرب",89,"ب",1,0],["قاضي القضاة كليم بعدك لم يزل","للقرب من ناديكم يترقب",89,"ب",1,0],["قاضي الديونِ ومرشدٌ لكمُ كما","قد كنتُ أُرشَدُ من هُدًى وفَلاحِ",90,"ح",1,0],["قاضٍ إذا ذُكِرَ القُضاةُ وحالُهم","في فضلهمْ أرَبى عليهم حالُهُ",91,"ل",2,0],["قاضٍ يرى الحقَّ ويقضي به","رغماً على من أنفُه يُرْغَمُ",92,"م",1,0],["قاضيته فأقرَّ ثم وفى به","لك فاستراح غريمه الممطول",93,"ل",1,0],["قاض بسوق له الغريم غريمه","حقدا ويرجع عنه وهو خليل",94,"ل",1,0],["قاضٍ يَرى قَدرَ الشَّريعَةِ عالِياً","وَبِرَفعِها وَقتَ الخصومَةِ يجزُمُ",95,"م",1,1],["قاضي القُضاةِ صادِقٌ في حُكمهِ","وَإِنّما قاضي القُضاةِ صادِقُ",96,"ق",1,0],["قاضي القُضاةِ قَضاياهُ لَقَد شهدت","بِأَنّ أَحكامَهُ للحقِّ تأييدُ",97,"د",1,0],["قاضٍ إذا انفصلَ الخصمانِ رَدَّهُما","إلى الخصام بحكمٍ غيرِ مُنْفَصِلِ",98,"ل",1,1],["قاضب الضير والضرير هضيم","هاضم الضيم والهضيم يضام",99,"م",1,0],["قاض وآيات الجمال شهوده","فالقلبَ يحبس والمدامعَ يطلق",100,"ق",1,0],["قاضي أوانا أي خطب دهاك","شيبك عن فعل الخنا ما نهاك",101,"ك",1,1],["قاضيه قاضي ديونه","وأخيه الصادق الود في محبته",102,"ت",2,0],["قاضٍ إِلَى مِيقاتِ وَقْتٍ يَعْزِمُهْ","بِقَدَرٍ تَأْخِيرُهُ وَمَقْدَمُهْ",103,"م",2,0],["قاضياً حَقَّ الصِّحابِ إِذا","قابلُوا حَقِّي بإِهْدارِ",104,"ر",1,0],["قاض تنقّصه وقد صدقته","وتنقص القاضي فما كذبته",105,"ت",2,0],["قاضي القضاة الشافعي بن صالح","م