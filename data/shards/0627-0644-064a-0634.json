{"poems":[[71,"لنا حاكم أعمى سديد قضاؤه","https://www.aldiwan.net/poem3886.html","الطويل"],[93,"لانت صلاب العزائم","https://www.aldiwan.net/poem11341.html","المجتث"],[45,"ألما يكف في طللي زرود","https://www.aldiwan.net/poem63486.html","الوافر"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[116,"الى شيخون تنعطف الاماني","https://www.aldiwan.net/poem41257.html","عموديه"],[199,"دعاك خليل والأصيل كأنه","https://www.aldiwan.net/poem51848.html","الطويل"],[212,"إلى شاطئ فيه إغراقكم","https://www.aldiwan.net/poem46245.html","المتقارب"],[213,"أجيران وادي الأثل هل منكم وصل","https://www.aldiwan.net/poem37843.html","الطويل"],[232,"قفا بحمى سلع فساكنه الذي","https://www.aldiwan.net/poem44591.html","الطويل"],[238,"حي على الأنس إن طيف الهموم سرى","https://www.aldiwan.net/poem18192.html","البسيط"],[238,"شاقتك آرام إلف","https://www.aldiwan.net/poem19496.html","المجتث"],[365,"سترن المحاسن إلا العيونا","https://www.aldiwan.net/poem60632.html","المتقارب"],[365,"خيالك من قبل الكرى طارقي ذكرا","https://www.aldiwan.net/poem60916.html","الطويل"],[365,"أرقت وصحبي بنجد هجود","https://www.aldiwan.net/poem60951.html","المتقارب"],[403,"نعم هذه حزوى وتلك زرود","https://www.aldiwan.net/poem46908.html","الطويل"],[417,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[417,"إلى شعبان مولاي المفدى","https://www.aldiwan.net/poem54139.html","الوافر"],[459,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[459,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"]],"verses":[["إِلى شَرَفِ الدينِ اِقتَضَيتُ مَقالَتي","إِلى سَيِّدٍ حازَ الشَهامَةَ وَالعلما",0,"م",2,0],["إِلَى شَوَاطِيءِ مَجْدٍ","مُنَوَّرَاتٍ بَوَاسِمْ",1,"م",1,0],["إِلى شَرَفٍ تَسامى مُرتَقاهُ","وَمَطلَعُهُ إِلى أَمَدٍ بَعيدِ",2,"د",1,0],["إلى شِلْوِ مَيْتٍ في ثيابِ خليفةٍ","وبضع لحام في إهاب مورم",3,"م",1,0],["الى شيخون تنعطف الاماني","كشهب الخيل تسرع بالوثوب",4,"ب",1,1],["إلى شطِّ منسابٍ كأنك ماؤه","صفاءَ ضميرٍ أو عذوبةَ أخلاق",5,"ق",1,0],["إلى شاطئ فيه إغراقكم","رميناكم الرمية القاضيه",6,"ي",2,1],["إلى شمس دنيانا وبدرِ سمائها","مع الشِبْلِ الذي شأنهُ البَذْلُ",7,"ل",1,0],["إلى شيبة الحمد المعظم وابنه ال","ذبيح الكريم بن الكريم المنجذ",8,"ذ",1,0],["إِلَى شَمَائِلَ أَزْرَتْ بِالنَّسِيمِ ضُحىً","وَخُلُقٍ كَالْخَلُوقِ قَدْ هَفَا سَحَرَا",9,"ر",2,0],["إِلَى شُمُوسِ بَيَانٍ","تَضِيءُ مِنْ كُلِّ حَرْفِ",10,"ف",1,0],["إلى شَرَفِ الدّينِ تِرْبِ العُلا","أثَرْتُ منَ العيسِ حَرْفاً أمونا",11,"ن",2,0],["إلى شَرفِ الدّينِ الوِزارةُ أُنهِيَتْ","فَرَدُّوا لها الأفواهَ مَملوءةً دُرّا",12,"ر",2,0],["إلى شرَفِ الدّينِ الهُمامِ سرَتْ بنا","ركائبُ لم يُحمَدْ لها قَبْلَهُ مَسرى",12,"ر",2,0],["إلى شَرَفِ الدّينِ سارَتْ بنا","وتَشْرُفُ عند المَوالي العَبيد",13,"د",1,0],["إلى شرف الدين الحُسَين الَّذي لَهُ","عزائم أغنتْهُ عن الخيل والرجْلِ",14,"ل",1,0],["إلى شرِّ جيلٍ شرّهم قد أنابنا","فَلِمْ نعاني حزننا واكتئابنا",15,"ن",2,0],["إلى شعبانَ مَولايَ المفدى","ربيعِ الفضلِ والروضِ النضير",16,"ر",1,1],["إلى شَرفِ الدين انتشطنا حبالَها","تُعانِقُ في نفض الطريق وتختبُّ",17,"ب",1,0],["إلى شرفِ الدين انتزعْها إِهابَها","ودعْها على نارِ السِّياط تَلَهّبُ",18,"ب",1,0]]}