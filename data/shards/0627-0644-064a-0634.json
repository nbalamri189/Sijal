{"poems":[[73,"لنا حاكم أعمى سديد قضاؤه","https://www.aldiwan.net/poem3886.html","الطويل"],[95,"لانت صلاب العزائم","https://www.aldiwan.net/poem11341.html","المجتث"],[47,"ألما يكف في طللي زرود","https://www.aldiwan.net/poem63486.html","الوافر"],[77,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[119,"الى شيخون تنعطف الاماني","https://www.aldiwan.net/poem41257.html","عموديه"],[202,"دعاك خليل والأصيل كأنه","https://www.aldiwan.net/poem51848.html","الطويل"],[215,"إلى شاطئ فيه إغراقكم","https://www.aldiwan.net/poem46245.html","المتقارب"],[216,"أجيران وادي الأثل هل منكم وصل","https://www.aldiwan.net/poem37843.html","الطويل"],[236,"قفا بحمى سلع فساكنه الذي","https://www.aldiwan.net/poem44591.html","الطويل"],[242,"حي على الأنس إن طيف الهموم سرى","https://www.aldiwan.net/poem18192.html","البسيط"],[242,"شاقتك آرام إلف","https://www.aldiwan.net/poem19496.html","المجتث"],[369,"سترن المحاسن إلا العيونا","https://www.aldiwan.net/poem60632.html","المتقارب"],[369,"خيالك من قبل الكرى طارقي ذكرا","https://www.aldiwan.net/poem60916.html","الطويل"],[369,"أرقت وصحبي بنجد هجود","https://www.aldiwan.net/poem60951.html","المتقارب"],[408,"نعم هذه حزوى وتلك زرود","https://www.aldiwan.net/poem46908.html","الطويل"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[422,"إلى شعبان مولاي المفدى","https://www.aldiwan.net/poem54139.html","الوافر"],[463,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[463,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83311","الطويل"],[710,"","https://poetry.dctabudhabi.ae/diwan/poem/104427","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64226","الهزج"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96655","الوافر"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106703","الطويل"],[1903,"","https://poetry.dctabudhabi.ae/diwan/poem/146074","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69338","الهزج"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143015","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53207","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121016","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21434","الطويل"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17734","الطويل"],[445,"","https://poetry.dctabudhabi.ae/diwan/poem/48173","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202741","المتقارب"],[3411,"","https://poetry.dctabudhabi.ae/diwan/poem/79769","الطويل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99313","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89018","الوافر"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36718","البسيط"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34625","المجتث"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32909","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135370","الطويل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75687","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4243,"","https://poetry.dctabudhabi.ae/diwan/poem/122436","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139475",""],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4978,"تشطير ضحكت دموعا","https://www.poetsgate.com/ViewPoem.aspx?id=177265",""],[4984,"في عيدها ..","https://www.poetsgate.com/ViewPoem.aspx?id=196952",""],[5122,"مابين كفي والقلم","https://www.poetsgate.com/ViewPoem.aspx?id=24074",""],[5150,"منوّر ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204353",""],[5277,"الرَشاش","https://www.poetsgate.com/ViewPoem.aspx?id=185434",""],[592,"لك الحمد اللهم يا واسع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=128838",""],[5431,"إلى شامي أنا راجعْ","https://www.poetsgate.com/ViewPoem.aspx?id=183085",""],[5442,"عسى وقفة بالركب يا حادي الركب","https://www.poetsgate.com/ViewPoem.aspx?id=114759",""],[5582,"أَسْيانُ ما فِي الأَيْكِ ناحَ حَمامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=63573",""],[5732,"صفقت بالأصبع","https://www.poetsgate.com/ViewPoem.aspx?id=177955",""],[5736,"من ذاوٍ لذابل","https://www.poetsgate.com/ViewPoem.aspx?id=208216",""],[5776,"إشراقةٌ حمراء","https://www.poetsgate.com/ViewPoem.aspx?id=199439",""],[6019,"رقصةٌ بفتنةِ الإشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=137042",""]],"verses":[["إِلى شَرَفِ الدينِ اِقتَضَيتُ مَقالَتي","إِلى سَيِّدٍ حازَ الشَهامَةَ وَالعلما",0,"م",2,0],["إِلَى شَوَاطِيءِ مَجْدٍ","مُنَوَّرَاتٍ بَوَاسِمْ",1,"م",1,0],["إِلى شَرَفٍ تَسامى مُرتَقاهُ","وَمَطلَعُهُ إِلى أَمَدٍ بَعيدِ",2,"د",1,0],["إلى شِلْوِ مَيْتٍ في ثيابِ خليفةٍ","وبضع لحام في إهاب مورم",3,"م",1,0],["الى شيخون تنعطف الاماني","كشهب الخيل تسرع بالوثوب",4,"ب",1,1],["إلى شطِّ منسابٍ كأنك ماؤه","صفاءَ ضميرٍ أو عذوبةَ أخلاق",5,"ق",1,0],["إلى شاطئ فيه إغراقكم","رميناكم الرمية القاضيه",6,"ي",2,1],["إلى شمس دنيانا وبدرِ سمائها","مع الشِبْلِ الذي شأنهُ البَذْلُ",7,"ل",1,0],["إلى شيبة الحمد المعظم وابنه ال","ذبيح الكريم بن الكريم المنجذ",8,"ذ",1,0],["إِلَى شَمَائِلَ أَزْرَتْ بِالنَّسِيمِ ضُحىً","وَخُلُقٍ كَالْخَلُوقِ قَدْ هَفَا سَحَرَا",9,"ر",2,0],["إِلَى شُمُوسِ بَيَانٍ","تَضِيءُ مِنْ كُلِّ حَرْفِ",10,"ف",1,0],["إلى شَرَفِ الدّينِ تِرْبِ العُلا","أثَرْتُ منَ العيسِ حَرْفاً أمونا",11,"ن",2,0],["إلى شَرفِ الدّينِ الوِزارةُ أُنهِيَتْ","فَرَدُّوا لها الأفواهَ مَملوءةً دُرّا",12,"ر",2,0],["إلى شرَفِ الدّينِ الهُمامِ سرَتْ بنا","ركائبُ لم يُحمَدْ لها قَبْلَهُ مَسرى",12,"ر",2,0],["إلى شَرَفِ الدّينِ سارَتْ بنا","وتَشْرُفُ عند المَوالي العَبيد",13,"د",1,0],["إلى شرف الدين الحُسَين الَّذي لَهُ","عزائم أغنتْهُ عن الخيل والرجْلِ",14,"ل",1,0],["إلى شرِّ جيلٍ شرّهم قد أنابنا","فَلِمْ نعاني حزننا واكتئابنا",15,"ن",2,0],["إلى شعبانَ مَولايَ المفدى","ربيعِ الفضلِ والروضِ النضير",16,"ر",1,1],["إلى شَرفِ الدين انتشطنا حبالَها","تُعانِقُ في نفض الطريق وتختبُّ",17,"ب",1,0],["إلى شرفِ الدين انتزعْها إِهابَها","ودعْها على نارِ السِّياط تَلَهّبُ",18,"ب",1,0],["إِلى شَمَمٍ جَمٍّ وَمَجدٍ مُؤَثِّل","وَفي عِزَّةٍ قَعساً وَوَفرٍ موفِرِ",19,"ر",1,0],["إلى شمس هذا العصر ما ضر قومه","إذا الشمس في افق السموات كورت",20,"ت",1,0],["إلى شرب العفاريت","إلى شرب الشياطين",21,"ن",1,0],["إِلى شمسِ العتيكِ إلى فلاح","إِلى ملكٍ يجيرُ ولا يجورُ",22,"ر",1,0],["إلى شعث الذوائب ذي غلال","يبث الناظرين له شجونا",23,"ن",2,0],["إلى شِيَمٍ مَهدِيَّةٍ فاطميَّةٍ","يهزُّ عِطفَيهِ شَيبَةُ أو عمرُو",24,"ر",2,0],["إلى شمس الشتاء إلى ظلال ال","مصيف إلى الغمام إلى الهلال",25,"ل",1,0],["إِلى شَرقِيِّ صِفّينٍ","وَمَجرى العَسكَرِ المَجرِ",26,"ر",1,0],["إلى \"شهاب\" نيّر","كفارس متّقد",27,"د",1,0],["إلى شرف الدين انبرت في بُرينها","حَرَاجِيحُ قد أُدْمين في كل مخدم",28,"م",1,0],["إلى شرفَي دينٍ وعلمٍ تظاهرا","تبارك من أعطى وبورك في المعطى",29,"ط",2,0],["إِلى شَجَرٍ أَلمى الظِّلال كأَنَّها","رَواهِبُ أَحرمنَ الشرابَ عُذوبُ",30,"ب",1,0],["إِلى شيمَةٍ مِنّي وَتَأديبِ والِدي","وَلا يَعرِفُ الأَخلاقَ مَن لَم يُؤَدَّبِ",31,"ب",1,0],["إِلى شَجَرِ النَبعِ الَّذي لَيسَ نابِتاً","مِنَ الأَرضِ إِلّا في مَكانٍ مُطَيَّبِ",31,"ب",1,0],["إلى شَجا لاعِجٍ فِي القلْبِ مُضْطَرِمِ","جاشٍ إليكَ بِهِ بَحرٌ مِنَ الكَلِمِ",32,"م",1,1],["إلى شاعر يلتجي شاعرٌ","فشاعر كلّ البنات الزهر",33,"ر",1,0],["إلى شَرَّ بيتٍ من قُضاعةَ مَنْصِباً","وفي شرِّ قومٍ منهم قد بدا لِيا",34,"ا",1,0],["إلى شاعر نادى وقد فغر الردى","له فاه سابور معي فتهيبا",35,"ب",2,0],["إلى شمس المعارف في سماءٍ","يمد البدر منها في الدياج",36,"ج",1,0],["إِلى شَمائِل تَندى كَالرِياض إِذا","ما وابلُ المُزنِ فيها دَمعَهُ سَفَحا",37,"ح",2,0],["إلى شرابٍ لذيذٍ","وأكل جديٍ رضيعٍ",38,"ع",1,0],["إِلى شاطِئِ القاطولِ بِالجانِبِ الَّذي","بِهِ القَصرُ بَينَ القادِسِيَّةِ وَالنَخلِ",39,"ل",1,0],["إلى شمس أقمار الحقيقة بعد ما","أتمّ من الشرع الحقيقي ما بدرُ",40,"ر",1,0],["إِلى شيخنا الأسنى الامام محمد","إمام له العَلياء وَالرتبة الرجحى",41,"ح",2,0],["إلي شكا الفَضلُ نَقصَ الزمانِ","وهل فَاضلٌ في زماني شكورُ",42,"ر",1,0],["إلى شرِّ قومٍ من شُراةٍ تحزبُوا","وعادوا إله الناسِ رَبَّ المَشارِقِ",43,"ق",1,0],["إلى شمس الشموس وما سواه","أنيس في الأسى للأصفياء",44,"ا",2,0],["إلى شمسٍ حبا طوساً بشمس","تفوق الشمس باهرة الضياء",44,"ا",2,0],["إِلى شَمسِ تَحقيقِ الأُلوهَةِ رافِعاً","إِلى ذاتِهِ لِلقَدرِ إِذ أَنتَ رافِعُ",45,"ع",1,0],["إلى \" شعراء الجاهلية \"، وجهتي","(بشعري وأفكاري بربيَّ تتصلْ)",46,"ل",1,0],["إلى شروق بنود النصر إذْ رفعت","بالجو خفاقة في حضن أبطال",47,"ل",1,0],["الى شاعر جزل القوافي يقودها","الى شخص ابو ميسون راع الوفى الجزيل",48,"ل",1,0],["إلى شطِّ يافا وعكّا وحيفا","وبيّارةِ البرتقالِ ستثمرْ",49,"ر",1,0],["إلى شفتيكِ ..يقتلني العطاشُ","وما جدواكِ ..إنْ شحَّ الرياشُ..",50,"ش",1,1],["إلى شم أعداء دين محمد","ذوي الغدر والمكر المجرد عن رشد",51,"د",1,0],["إلى شامي أنا راجعْ","إلى داري أنا راجعْ",52,"ع",1,1],["إلى شمسي أعانِقُها","ودربي الضاحك الساطعْ",52,"ع",1,0],["إلى شافع العاصين عند الهم","ومنقذهم في الحشر من غمرة الكرب",53,"ب",1,0],["اليَشْجُبِيُّ الأَمْجَدُ المَلِكُ الَّذِي","شَرَقَتْ بِبَهْجَةِ مُلْكِهِ أَيَّامُهُ",54,"م",2,0],["إلى شربت المي مر شرابي","والنون ياقف له عن النوم حراب",55,"ب",1,0],["إلى شجنٍ يسافرُ ألفَ عمرٍ","يقدُّ الحلم في سِفرِ الأوائلْ",56,"ل",1,0],["إلى شعبٍ تفلتَ من قيودٍ","ليشرقَ فوق أجنحة الرياحِ",57,"ح",1,0],["إليَّ شيئاً فشيئاً دونما خَجَلٍ","في هدأةِ الليلِ في همسٍ تُغنِّهِ",58,"ه",1,0]]}