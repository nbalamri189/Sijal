oem/54315","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54252","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54244","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54216","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[95,"النسر","https://www.poetsgate.com/ViewPoem.aspx?id=706",""],[106,"شرع الاستعمار","https://www.poetsgate.com/ViewPoem.aspx?id=179645",""],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[100,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[100,"ليلة خائف","https://www.poetsgate.com/ViewPoem.aspx?id=50433",""],[90,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[90,"غضبة","https://www.poetsgate.com/ViewPoem.aspx?id=179231",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[9,"أثوى ، قصّرَ ليلة ً ليزوَّدا،","https://www.poetsgate.com/ViewPoem.aspx?id=20031",""],[101,"بَسَمَتْ تتيهُ مُدلّة ً بصباحها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62458&r=&rc=50",""]],"verses":[["وَمَضَوا مُعقِبينَ إِر","ثاً مِنَ المَجدِ باقِيا",0,"ي",2,0],["وَمَضى رَحيضَ الثَوبِ غَيرَ مُدَنَّسٍ","وَقَضى نَقِيَّ العودِ غَيرَ مُوَصَّمِ",1,"م",1,0],["وَمَضى بِإِخوانِ الصَفاءِ فَلَم يَدَع","مِنهُم أَخا ثِقَةٍ وَلا عَضُداً مَعي",2,"ع",2,0],["وَمُضاعِنٍ مَلآنَ يَكتُمُ غَيظَهُ","جَزَعاً كَما كَتَمَ المَزادُ الماءَ",3,"ا",2,0],["ومضت في طرق العمر فمن","مسلك صعب إلى دنيا صعاب",4,"ب",1,0],["وَمَضَتْ مِنْ بَعْدِ أنْسٍ وَكَذَا","سَاعةُ الْأُنْسِ إِذَا سَرَّتْ مَضَتْ",5,"ت",1,0],["وَمَضى لِحاجَتِهِ وَأَصبَحَ حَبلُها","خَلَقاً وَكانَ يَظُنُّ أَن لَن يُنكَدا",6,"د",2,0],["وَمَضرَبُها تَحتَ الحَصى بِجِرانِها","وَمَثنى نَواجٍ لَم يَخُنهُنَّ مَفصِلُ",7,"ل",1,0],["وَمُضطَّمِرٌ مِن خاشِعِ الطَرفِ خائِفٌ","لِما تَضَعُ الأَرضُ القَواءُ وَتَحمِلُ",7,"ل",1,0],["وَمَضاءٌ يُريكَ حَدَّ قَضاءِ اللَ","هِ يَفري مَتناً وَيَحطِمُ نابا",8,"ب",2,0],["وَمَضى واهِبُ الأُلوفِ فَوَلَّت","يَومَ وَلّى بَشاشَةُ الأَريَحِيِّ",9,"ي",1,0],["وَمُضَيَّقُ الأَلحاظِ يَهزَأُ سِحرُها","وَفُتورُها بِالمُقلَةِ النَجلاءِ",10,"ا",2,0],["ومضايفٍ وملاجئٍ ومواصفٍ","تشفي بها الأرواح والأجساد",11,"د",1,0],["وَمَضِنَّةٍ يَطْوِي عَلَيْهَا صَدْرَهُ","وَكَأَنَّهُ أَبَداً عَلَيْهَا حَانِ",12,"ن",1,0],["وَمَضروبَةٍ في غَيِرِ ذَنب بَريئَةٍ","كَسَرتُ لِأَصحابي عَلى عَجَل كَسرا",13,"ر",2,0],["وَمَضى عَلَيكَ مُصَدَّرٌ ذو مَيعَةٍ","رَبِذُ اليَدَينِ يَفوزُ بِالأَقصابِ",14,"ب",1,0],["وَمُضطَغِنٍ يُراوِدُ فِيَّ عَيباً","سَيَلقاهُ إِذا سُكِنَت وَبارُ",15,"ر",1,0],["ومضيق ضمّ لو دراهُ معذِّبي","ضاقت عليه أرضه وسماؤه",16,"ا",3,0],["ومضى الصبا ومن التصابي بعده","صيرتُ للدمعِ الدماءَ خضابا",17,"ب",2,0],["ومضى البياض من الحياة وطيبها","لكنها أبقته فوق عذاري",18,"ر",2,0],["ومضوا كما يمضي الغمام وخلفوا","عبقاً كما ينشي الربيع وينشر",19,"ر",1,0],["ومضروبة من غير جرمٍ وربَّما","أقيم عليها الحدّ من دون نفسها",20,"س",3,1],["ومضى بشمس محاسنٍ لولا الهدى","ما كنت أمسك في الوفاء حبالها",21,"ل",3,0],["ومُضْحكٍ واضحٍ به شَنبٌ","يعرف من شام برقَهُ مطره",22,"ر",2,0],["ومضى كالقضاءِ يأذنُ في سَفْ","كِ دماءِ العِدا لأسْدٍ بسالِ",23,"ل",1,0],["ومضى يَعْسِفُ النجاء كما زلْ","ل من المنجنيقِ مِرْدى رِجام",24,"م",1,0],["وَمَضى عَلى مَهَلٍ يَهُزُّ مُذَلَّقاً","رَيّانَ مِن عَلَقِ الفَرائِصِ يَقطُرُ",25,"ر",1,0],["وَمَضى بِهِ لِرِفاقِهِ فَتَهَلَّلوا","وَتَقاسَموهُ فَكانَ خَيرَ عَشاءِ",26,"ا",2,0],["وَمَضى لِلبَحرِ ماءُ الجَدوَلِ طَرِباً","يا كَريمَ الأَصلِ قَد زانَكَ فِعلُك وَصِفاتِك",27,"ك",1,0],["وَمَضَيتَ تَستَقصي الحَياة وَسِرَّها","في كُلِّ عاقِلَة وَكُلِّ جَمادِ",28,"د",1,0],["وَمَضى يُقَلِّبُ كَفَّهُ أَسَفاً","وَلَبِثتُ كَالمَقتولِ في الوَكرِ",29,"ر",1,0],["وَمَضى كَالظِلِّ إِذا اِنتَقَلا","وَأَنا أَرجو لَو لَم يَمضِ",30,"ض",1,0],["وَمَضى يَعدو وَأَعدو خَلفَهُ","وَتَرانا قَد طَوَينا الأَرضَ طَيَّ",31,"ي",1,0],["ومضتْ نسْمةٌ تُوَسْوِسُ للغا","بِ وتشدو في عمقِ ذاكَ السُّكونِ",32,"ن",1,0],["ومَضَيْتُ أَشدو للأشعَّةِ ساحراً","من صوت أحزاني وبطش سقامي",33,"ي",1,0],["ومضتْ بروحِكَ للسَّماءِ","عَرائسُ النُّورِ الحبيبْ",34,"ب",1,0],["ومضوْا إلى المرْج البهيجِ","يطارِدُونَ طيورَهُ",34,"ه",1,0],["ومَضتْ بالشَّذى فَقُلتُ ستبني","في مروجِ السَّماءِ بالعِطر مَجْدي",35,"د",2,0],["ومضَى الرَّدى بسَعَادتي","وقضى على الحُبِّ الوَليدْ",36,"د",1,0],["ومضَوْا يَمُدُّونَ الخُوَانَ ليأكلوا","لحمي ويرتشفوا عليه دِمائي",37,"ي",1,0],["ومضى الليل عابسا","وبدا الصبح وابتسم",38,"م",1,0],["ومضَّتها على الأرض الرزايا","وأسأمها بمحبسها الثواءُ",39,"ا",2,0],["ومضيَّع لشقائه لو لم يِضع","بلغت على يده البلاد مرامها",40,"م",3,0],["ومضى الحماة الناصرو","ن الذائدون عن الحياض",41,"ض",1,0],["وَمِضمارٌ يَسوقُ إِلى القَوافي","سَوابِقُها إِذا الشُعَراءُ قَلّوا",42,"ل",3,0],["وَمَضَت بِنارِ العَبقَرِيَّةِ لَم تَدَع","غَيرَ الرَمادِ وَدارِساتِ أَثافي",43,"ي",1,0],["وَمَضَوا بِهِ لِسَبيلِ آدَمَ قَبلَهُ","وَمَصايِرِ الأَقوامِ مِن أَعقابِه",44,"ب",2,0],["وَمَضى وَفيهِ مِنَ الشَبابِ بَقِيَّةٌ","لِلنَفعِ أَرجى ما تَكونُ بَقاءَ",45,"ا",2,0],["وَمَضى يَجُرُّ عَلى الهَوى أَذيالَهُ","وَيَلومُ حامِلَهُ مَعَ اللُوّامِ",46,"م",1,0],["وَمَضى السُرى بِكَ حَيثُ كا","نَ الروحُ يَسري وَالرِسالَه",47,"ل",2,0],["وَمَضى المالِكونَ إِلّا بَقايا","لَهُمُ في ثَرى الصَعيدِ اِلتِجاءُ",48,"ا",2,0],["ومَضَوا إلى عَقْدِ الخِلافِ وما","حَضَروهُ إلاَّ داخلَ القَبْرِ",49,"ر",1,0],["ومضى عليها مدة فنشا","من ذلك التزويج خير ولد",50,"د",1,0],["ومضَوا يَشيمونَ الوميضَ وقد هَفَا","بخفوقِه خَضلُ الربابِ هتونُ",51,"ن",1,0],["ومضَى الذي كُنَّا نروعُ بذِكرهِ","نُوَبَ الزمانِ فما لهُ من مرجعِ",52,"ع",1,0],["وَمُضاهٍ لَهُ تَفَنَّنَ حَتّى","فايَضَ البَحرَ زاخِراً بِصُبابَه",53,"ب",2,0],["وَمضى الطالِبِيُّ يَطلُبُ حِرزاً","وَالمَنايا يَطلُبنَهُ في التِلاعِ",54,"ع",1,0],["وَمَضى اِبنُ عَمرٍو قَد أَساءَ بِعُمرِهِ","ظَنّاً يُنَزِّقُ مُهرَهُ تَنزيقا",55,"ق",2,0],["وَمَضَت سَرايا خَيلِهِ فَتَراجَعَت","بِأَبي السَرايا خائِباً مَذموما",56,"م",2,0],["وَمَضَت لِمَسلَمَةَ الرِكابُ مُوَدَّعاً","فَاِرعَي فَزارَةَ لا هَناكِ المَرتَعُ",57,"ع",1,0],["ومضىء مصباح الوداد إذا دجا","في مضرمات الود ليل نفاق",58,"ق",1,0],["ومضارِعُ الجَوْزَاءِ لي","لاً في عُلوِّ واتِّساقِ",59,"ق",1,0],["ومضى وقد منعَ الجُفونَ خُفوقَها","قَلبٌ لذكرِكَ لا يَقَرُّ خُفُوقا",60,"ق",2,0],["وَمُضْطَربٍ وشيُ أبرادِه","يُضاحكُ وَشْيَ النِّجادِ القَشيبا",61,"ب",2,0],["وَمَضى أَمامَكَ مَن رَأَيتَ وَأَنتَ لِل","باقينَ حَتّى يَلحَقوكَ أَمامُ",62,"م",1,0],["وَمُضَعَّفُ الأَجفانِ فَوَّقَ لَحظَهُ","نَبلاً عَلى بُعدِ المَدى لَم يُخطِني",63,"ي",1,0],["ومضطرم الأنفاسِ والضيق جاثمٌ","ومشتبك النجوى ومعتنق الأيدي",64,"د",2,0],["ومضَى الحِمام يدبُّ فيه فإن جَرَت","ذكراكِ طارَ إليكِ وَهوَ مجنَّحُ",65,"ح",1,0],["ومضى يطلب العلوم وحيداً","موحشاً قلبهُ غريبَ الدارِ",66,"ر",1,0],["ومضيت عن دنيا خلَت","وجرت بنعمى لَم تتم",67,"م",1,0],["ومضى النهار ولا نهار لأنه","يمتدُّ عندي كالفراغ المظلم",68,"م",1,0],["ومضَتْ على الرّومْ الدهورُ وما بنوْا","لملوكهم شَبَهاً له ونظيرا",69,"ر",2,0],["ومضروبةٌ بين الرّسوم وما جَنَتْ","عقاب النوى من هامها الضربُ والقلعُ",70,"ع",1,0],["ومُضمَّنٍ راحاً يشفّ زُجاجُهُ","عن ماءِ ياقوتٍ بدُرٍّ يُزْبِدُ",71,"د",1,1],["وَمَضَت طَواويسُ العِراقِ فَأَشرَقَت","أَذنابُ مُشرِقَةٍ وَهُنَّ حُفودُ",72,"د",1,0],["وَمَضى وَقَد مَلَكَتهُ هِزَّةُ عِزَّةٍ","تَحتَ العَجاجِ وَضِحكَةُ اِستِبشارِ",73,"ر",1,0],["ومَضوا بِعافِيةٍ يَقولُ كبيرُهم","حَيَّاكَ رَبُّك مِن أبٍ يرعانا",74,"ن",2,0],["ومَضَتْ تذودُ اليأسَ عن آمالها","وتُعلِّمُ الأحداثَ كيف تلينُ",75,"ن",1,0],["ومضى الظُّلمُ خليَّاً ناعماً","يسحبُ البُرْدَيْنِ من نارٍ ودَمْ",76,"م",1,0],["ومضتْ تعلو فلمّا زُوحِمَتْ","طاولت هارونَ عِزّاً وهِشاما",77,"م",2,0],["ومضوا بعهدٍ للمُروءة صالحٍ","ألوَى بِنَضرتهِ بِلىً ونفادُ",78,"د",1,0],["وَمضيتَ مُعتمِراً بِصحبِكَ مُحرماً","والهَدْيُ حالٍ بالقلائدِ مُعْلَمُ",79,"م",1,0],["ومضوا يرون المشركين بذي طوى","والخيلُ شتَّى والخميسُ عَرَمْرم",79,"م",1,0],["ومضى فهزَّ بَني قَريظَة هِزّةً","يَغتالُ رَاجفُها الأشمَّ الراسيا",80,"ي",2,0],["ومضى حُذيفةُ بالبَشارةِ يبتغِي","عِندَ النبيِّ بها المحلَّ العاليا",80,"ي",2,0],["ومضت بعمَّارٍ وزيدٍ هِمَّةٌ","لم تُبْقِ من هِمَمِ الجهادِ مروما",81,"م",2,0],["ومضى يقصّ على النبيِّ حديثَهُ","فيكاد عنه من الكراهةِ يصدف",82,"ف",1,0],["ومضَى قبلي شهيداً فأنا","أبتغِي الزُّلْفَى لدى الفردِ الصَّمَدْ",83,"د",1,0],["وَمَضى البُلبلُ الغَريبُ يَطوف الر","روضَ حَتّى إِنزَوى مَحيّا النَهارِ",84,"ر",1,0],["ومضت به صُعداً إلى كرسيه","والموت في يده وراء زناد",85,"د",1,0],["ومضجعَ أضلعٍ مُنِيَتْ","بنيرانٍ وأشواكِ",86,"ك",1,0],["وَمَضى تُشبِهُ أَقرابُهُ","ثَوبَ سَحلٍ بَينَ أَعوادِ قام",87,"م",1,0],["وَمَضَت رَهواً تُطيرُ الحَصى","بِصَحيحِ النَسرِ صُلبِ الحَوام",87,"م",1,0],["وَمَضى يَخطُرُ في المَش","يِ كَجَبّارٍ عَنيدِ",88,"د",1,0],["ومَضَى بِحَمْلِ صَلِيبِهِ مُستَسلِماً","لِلموتِ مَكتُوفَ اليَدَينِ ذَلِيلا",89,"ل",2,0],["ومُضْرَمَةِ الأنفاسِ جَمْرٌ وطيسُها","شَرَنْبَثَةِ الكَفّينِ فاغرةِ الفَم",90,"م",1,0],["ومَضَى يَخفُّ على الجنائبِ حَمْلهُ","ولقد يُرى بالجيش وهو ثقيل",91,"ل",1,0],["ومضى يقطُرُ بالبأسِ دَماً","وبكفَّيْهِ من الأُسْدِ لِبَد",92,"د",1,0],["وَمُضَمَّخاتٍ بِالعَبي","رِ نَزَلنَ مِن غُرَفِ الجِنانِ",93,"ن",1,0],["وَمَضى عَلى مِنوالِهِ","حَسَنَ اليَدَينِ عَلى الأَحاسِد",94,"د",1,0],["وَمَضحَكاً مِنها كَما أَومَضَت","صَيفِيَّةُ المُزنِ وَلَم تُرعِدِ",95,"د",1,0],["وَمَضى يَزِلُّ عَلى المِتانِ كَأَنَّهُ","نَجمٌ لِمُستَرِقٍ هَوى بِشِهابِهِ",96,"ب",2,0],["وَمُضمَراتِ أُمورٍ زادَهُنَّ سَناً","إِضمارُهُنَّ وَتَجري الخَيلُ بِالضُمُرِ",97,"ر",1,0],["ومُضْطَغِنٍ عليكَ وليس يُجْدي","ولا يُعْدي على الشمس اضْطِغانُ",98,"ن",1,0],["ومضوا يعدون في الأر","ض وإنا سوف نمضي",99,"ي",1,0],["وَمُضطَرِب يَشكو الحَريق كأَنَّما","بأَثوابه مِمّا يَلي جلدَه جمر",100,"ر",1,0],["ومضى معتدياً","وأتى معتذرا",101,"ر",2,0],["وَمَضى يَطير مغرداً لنجاته","من شر غربان وَظلم صقور",102,"ر",1,0],["ومضت بي الذكرى فرحتُ مكذِّباً","عيني ومتهماً لديهِ يقيني",103,"ي",1,0],["ومضى الناثرُ الذي صوَّرَ النفسَ","وجلّى سرّ الضميرِ المحجّبْ",104,"ب",1,0],["ومضوا فما وجدوا كفاءَ صنيعهِم","تمثالَ حبٍّ أو مثالَ وفاءِ",105,"ا",2,0],["ومضيتَ تضربُ في غياهبِه","وتردُّ عنكَ المائجَ الصَّخِبا",106,"ب",2,0],["ومضى الليلُ ونادى بالرواحِ","كلُّ خَالٍ وتعايا كلُّ ضبِّ",107,"ب",1,0],["ومضوا به إلا شعاعاً لم يزل","في الأرض مؤتلق السنى وضاحا",108,"ح",2,0],["ومضتْ تُخالِسُني حَييَّ لحاظها","لا تشتكي سَهْراً وفَرْطَ تطلُّعِ",109,"ع",1,0],["ومضت تكذبني الظنونُ فأنثني","مُتسمِّعاً دقاتِ قلبي الثائرِ",110,"ر",1,0],["ومَضَتْ في صَميمِهِ شُعْلَةُ الحُزْ","نِ فَعَشَّتْهُ من شُعاعِ اللَّهيبِ",111,"ب",1,0],["وَمضَيْتَ تَمْلِكُ أَمِيرُهُمْ مِنْ قَبْلمَا","شَبَّ النَّزَالُ وَآذَنُوا بِبَوَارِ",112,"ر",1,0],["وَمَضَايفٍ وَمَلاَجِيءٍ وَمَوَاصِفٍ","تُشْفَى بِهَا الأَرْوَاحُ والأَجْساد",113,"د",1,0],["وَمَضَى فِي تَخَيُّرِ السُّنَنِ المُثْ","لَى وَلَمْ يَثْنِهِ اعْتِرَاضُ الغُلاَةِ",114,"ه",1,0],["وَمُضِيفاً إِلَى الثَّوَابِتِ مِنْهَا","مُحْكَمَاتِ الأصُولِ وَالتَّجْرِبَاتِ",114,"ت",1,0],["وَمَضَيْتَ تَمْلَؤُهُ هَوىً","حُرّاً وَتَمْنحُهُ سَوَادَكْ",115,"ك",1,0],["وَمضَوْا فَإِمَّا المَوْتُ أَوْ يَحْيَا الحِمَى","حُرَّاً وَيَحْيَا أَهْلُهُ أَحْرَارَا",116,"ر",2,0],["وَمَضَى لَطِيفاً فِي ابْتِغَاءٍ مَرَامِهِ","أَوْ غَيْرَ مُلْوٍ دُونَهُ بِمَعَاطِبِ",117,"ب",1,0],["وَمَضَى مُطْلَقَ اليَدَيْنِ يُعَانِي","غَمَرَاتِ مَنْ خَاسَ فِيهُنَّ خَابَا",118,"ب",2,0],["وَمُضطَغِنٍ لَم يَحمِلِ السِرَّ قَلبُهُ","تَلَفَّتَ ثُمَّ اِغتابَني وَهوَ هائِبُ",119,"ب",1,0],["ومضت إلى الطباخ تلجم ما بها","لفتاتها من لاعج الأشواق",120,"ق",1,0],["ومَضَى يَسْبِقُ الْخَواطِرَ وثْباً","وجَرَى يُجْهِدُ الأمَانِيَّ وَخْدا",121,"د",2,0],["ومَضَاءٌ في الحَادِثاتِ برأْيٍ","فَضَح الصُّبْحَ نُورُه وتَحدَّى",121,"د",2,0],["ومَضى كالقَضَاءِ يَهْوِي لِمَرْمَا","هُ جَريئاً مُجَمَّعَ القَلْبِ جَلْدَا",121,"د",2,0],["ومضَى الرَّكْب بالرفاقِ وخلاَّ","نِي وحيداً أبكي على خُلاّني",122,"ي",1,0],["وَمَضَى و