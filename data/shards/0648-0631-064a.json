et/poem38954.html","الخفيف"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[85,"لا والزبيب ومزة من حمص","https://www.aldiwan.net/poem7261.html","الكامل"],[85,"نجا وتماثل ربانها","https://www.aldiwan.net/poem63734.html","المتقارب"],[85,"قم حي هذي النيرات","https://www.aldiwan.net/poem63775.html","مجزوء الكامل"],[43,"بنا منك فوق الرمل ما بك في الرمل","https://www.aldiwan.net/poem9926.html","الطويل"],[43,"كدعواك كل يدعي صحة العقل","https://www.aldiwan.net/poem10137.html","الطويل"],[62,"فديتك قد تنبهنا لدهر","https://www.aldiwan.net/poem52281.html","الوافر"],[45,"هين ما يقول فيك اللاحي","https://www.aldiwan.net/poem62696.html","الخفيف"],[45,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[45,"باكرتنا بواكر الوسمي","https://www.aldiwan.net/poem66865.html","الخفيف"],[28,"بين إذا نزلت عليك مجاشع","https://www.aldiwan.net/poem5311.html","الكامل"],[61,"غدت لذاتنا أمما","https://www.aldiwan.net/poem51435.html","مجزوء الوافر"],[61,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem51442.html","الطويل"],[61,"عش مدى الدهر يا أبا إسحاق","https://www.aldiwan.net/poem51505.html","الخفيف"],[61,"وريم رمتني ألحاظه","https://www.aldiwan.net/poem51518.html","المتقارب"],[61,"قصاراك في اللوم أن تقصرا","https://www.aldiwan.net/poem51610.html","المتقارب"],[61,"لمحة البارق من حيث لمح","https://www.aldiwan.net/poem51745.html","الرمل"],[61,"أكان لقلبه عنك انقلاب","https://www.aldiwan.net/poem51816.html","الوافر"],[80,"ملك جديد مثل طبع المنصل","https://www.aldiwan.net/poem31324.html","الكامل"],[80,"وريحانة في النفس منبت غصنها","https://www.aldiwan.net/poem31410.html","الطويل"],[80,"طربت متى كنت غير الطروب","https://www.aldiwan.net/poem31567.html","المتقارب"],[80,"نفى هم شيبي سرور الشباب","https://www.aldiwan.net/poem31576.html","المتقارب"],[90,"‏كل ما في الكون حب وجمال","https://www.aldiwan.net/poem26553.html","الرمل"],[31,"هيج القلب مغان وصير","https://www.aldiwan.net/poem42520.html","الرمل"],[105,"يقول أبو سفيان أودى محمد","https://www.aldiwan.net/poem44208.html","الطويل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[48,"أعاذل بعت الجهل حيث يباع","https://www.aldiwan.net/poem64377.html","الطويل"],[50,"أشادن إن ريمة لا تصاد","https://www.aldiwan.net/poem63916.html","الوافر"],[46,"أرى حبلا حادثا في النسا","https://www.aldiwan.net/poem23277.html","المتقارب"],[15,"أمن منزل عاف ومن رسم أطلال","https://www.aldiwan.net/poem45252.html","الطويل"],[76,"وريان من ماء الشباب تهافتت","https://www.aldiwan.net/poem39014.html","الطويل"],[76,"يا مجيل الروح في جسدي","https://www.aldiwan.net/poem39433.html","المديد"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[90,"","https://poetry.dctabudhabi.ae/diwan/poem/147231","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202649","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30469","المتقارب"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30458","الكامل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39497","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9916","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9909","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54840","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54633","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[106,"رثاء طيارين!","https://www.poetsgate.com/ViewPoem.aspx?id=179490",""],[86,"الاسكندريه","https://www.poetsgate.com/ViewPoem.aspx?id=10627",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[31,"هَيَّجَ القَلْبَ مَغَانٍ وَصِيَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18881&r=&rc=144",""],[96,"الشّاطئ المهجور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66348&r=&rc=24",""],[92,"أَتَفنى ابتساماتُ تَلك الجفونِ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14571&r=&rc=16",""]],"verses":[["وَريمٍ رَماني طَرفُهُ بِسِهامِهِ","فَما أَخطأَ الرَّامي وَهُنَّ صيابُ",0,"ب",1,1],["وَريقٍ يَكادُ الرَّاحُ يَحكي مَذاقَهُ","أَظُنُّ وَظَنيِّ صادِقٌ أَنَّهُ عَذْبُ",1,"ب",1,0],["وريمٍ رَمى قلبي بأسْهُمِ لَحظِهِ","فأصْمَى وفي قَوْسِ الحَواجِبِ أنْبَضا",2,"ض",2,0],["ورِياضُ الشّيْخ كمْ مرْأى لَنا","فيهِ يُزْري بالنُهَى أو مُسْتَمَعْ",3,"ع",1,0],["وريعَ وقد شدّ العِناقُ وَثاقَهُ","كما ريعَ ظبْيٌ في حِبالةِ صائِدِ",4,"د",1,0],["وَريعَ الفُؤادُ لِعِرفانِها","وَهاجَت عَلى النَفسِ أَذكارَها",5,"ر",3,0],["وَريقَتُهُ في الإِرتِشافِ مُدامُ","سَقى جَنَباتِ القَصرِ صَوبُ الغَمائِمِ",6,"م",1,0],["وَرَيّاكِ رَوحٌ لِلنُفوسِ وَرَيحانُ","وَحَسبُ الأَماني ظِلُّكِ المُتَفَيَّأُ",7,"ي",2,0],["وَرَيّا إِذا نَفَحَت خِلتُها","تُمِلُّ ثَناءَكَ أَو تَستَهِلّ",8,"ل",1,0],["وَريحَ سَناً في حُقَّةٍ حِميَرِيَّةٍ","تُخَصُّ بِمَفروكٍ مِنَ المِسكِ أَذفَرا",9,"ر",2,0],["وَرَيحانٍ يَميسُ عَلى غُصونٍ","يَطيبُ بِشَمِّهِ شُربُ الكُؤوسِ",10,"س",1,1],["وَريحِ الخُزامى رَشَّها الطَلُّ بَعدَ ما","دَنا اللَيلُ حَتّى مَسَّها بِالقَوادِمِ",11,"م",1,0],["وَرَيطَةِ خِرقٍ كَالعُقابِ رَفَعتُها","وَقَد رَكَضَت رَصفَ الهَجيرِ جَنادِبُه",12,"ب",2,0],["ورياحُهُ نسمت بنشر لطيمة","وأقاحُهُ بسمت بثغر ملثّمِ",13,"م",1,0],["ورياضة الأبدان ملعبة بها","حفظت نشاط جسومها الأقوام",14,"م",1,0],["وَرَئيسُ مَملَكَةٍ وَطِئنَ جَبينَهُ","يَغشى حَواجِبَهُ دَمٌ وَغُبارُ",15,"ر",1,0],["وَريشي مِنكُمُ وَهَوايَ فيكُم","وَإِن كانَت زِيارَتُكُم لِماما",16,"م",2,0],["وَريَطْةِ فتيان كخاطف ظله","جعلت لهم منا خِباءً ممدَّدا",17,"د",2,1],["ورئيس كما تريد المعالي","لا كمن آده المسيرُ فردَّا",18,"د",2,0],["ورئيساً نجا ذوو القصد لما","قرَّبت منها الملوك نجيّا",19,"ي",2,0],["وريبُ الزمان غداً كائنٌ","وغالبُهُ مثلُ مغلوبِهِ",20,"ب",2,0],["ورياضٍ تخايلُ الأرض فيها","خُيلاء الفتاة في الأبرادِ",21,"د",1,1],["ورياسة كانت مطلَّقةً","منهم فكنت أحق بالرجعه",22,"ع",2,0],["وَرَئيسٍ ذي خِسَّةٍ","كُلُّ مَن شِئتَ لائِمُه",23,"م",2,1],["ورياضٌ لا تعرف الحَلَك الدَّاجي","ولا ثورَةَ الخريفِ العتيدِ",24,"د",1,0],["وريحٌ تمرُّ مُرورَ الملاكِ","وتخطو إلى الغابِ خَطْوَ الرُّعودْ",25,"د",1,0],["وريالة تجرى على شفة التقى","إن قيل قم في حلقة الذكرى أرقص",26,"ص",1,0],["وَريعَت كَما ريعَتِ الأَرضُ فيكَ","نَواحي السَماءِ وَأَعنانُها",27,"ن",3,0],["وَرِياضُ أَندَلُسٍ نَمَي","نَ الهاتِفاتِ الشاعِراتِ",28,"ت",1,0],["وَريعَ لَهُ جَيشُ العَدُوِّ وَما مَشى","وَجاشَت لَهُ الحَربُ الضَروسُ وَما تَغلي",29,"ل",2,0],["وَرَيّانُ لا تَصدى إِلى الخَمرِ نَفسُهُ","وَعَطشانُ لا تَروى يَداهُ مِنَ البَذلِ",30,"ل",1,0],["وريّانُ الصِبّا للحُسْنِ فيهِ","بدائعُ لا يُحيطُ بها الكلامُ",31,"م",1,0],["وَرِياضاً بَينَ العُبَيدِيِّ فَالقَص","رِ فَأَعلى سِمعانَ فَالمُستَراحِ",32,"ح",1,0],["وَرَيعُ الشَبابِ آضَ نَهباً مُفَرَّقاً","وَكانَ قَديماً وَهوَ غُنمٌ مُجَمَّعُ",33,"ع",1,0],["وَرِياضٍ تَصبو النُفوسُ إِلَيها","وَتُحَيّا بِوَردِهِنَّ الجَنِيِّ",34,"ي",1,0],["وَرَئيسُ يَومِ نَطاعِ صَعصَعَةُ الَّذي","حيناً يَضُرُّ وَكانَ حيناً يَنفَعُ",35,"ع",1,0],["ورَيحانٌ يَروقُكُما","ونَدمانٌ يَسُرُّكما",36,"م",2,0],["ورياحُكَ اللاتي تَهُبُّ جَنائباً","ولربَّما أجريتَهُنَّ سَمُوما",37,"م",2,0],["ورِياضٌ لم يُنْشِ زَهرَتَها التُّر","بُ ولم يَسْقِها منَ الغَيْثِ سِاقِي",38,"ق",2,0],["وريمٍ رَمَتْنيَ ألحاظُه","فَبِتُّ أسيراً لها مُوثَقا",39,"ق",2,1],["وريمٌ إذا رامَ حَثَّ الكُؤو","سِ قَطَّبَ للتِّيهِ واستَكبرا",40,"ر",2,0],["ورياضٌ تُجتَلى في طَرَفٍ","نظمَ القَطْرُ حِلاها ومَلُح",41,"ح",1,0],["وريعَتْ مصرُ إذ وثب العِفَرْنى","بحَدِّ السَّيفِ وانسابَ الحُباب",42,"ب",1,0],["ورياسةٌ عُلْوِيّةٌ ترنو إلى","زُهْرِ الكواكبِ إذ تَراءتْ من عَلِ",43,"ل",1,0],["وريحانَةٍ في النفس مَنبِتُ غُصْنها","لها نَفَسٌ يُحْيي بنفحتِهِ النّفسا",44,"س",2,1],["ورَيحانةٍ أُمّها كرمة","تَنَفّسُ في كفِّ غصن رطيبِ",45,"ب",1,0],["وريحٍ خفِيفَةٍ رَوْحِ النّسِيمِ","أطّتْ بليلاً وهبّت رُخاءَ",46,"ا",2,0],["ورياض ضاحَكَ الزهرَ بها","ثغرُك الصافي وناجاها الخيال",47,"ل",1,0],["وَرِياحُ الصَيفِ قَد أَزرَت بِها","تَنسِجُ التُربَ فُنوناً وَالمَطَر",48,"ر",1,0],["وَريعتْ قلوبُ المؤمنين فأجفلوا","يخافون من بعد النبيِّ الدواهيا",49,"ي",2,0],["وَريقُهُ كَمِثلِ طَوقٍ مِن أَدَم","وَلَيسَ مِن تَركِ السُؤالِ يَحتَشِم",50,"م",1,0],["وَرِيعَ لهُ أبو جهلٍ بِفَحْلٍ","يَنُوبُ عَنِ الهِزَبْرِ لهُ نُيُوبُ",51,"ب",1,0],["وَرَيّانَ مِن ماءِ الشَبابِ كَأَنَّما","يُظَمّأُ مِن ضُمرِ الحَشا وَيُجاعُ",52,"ع",1,0],["وَرِئبالُ العِراقِ إِذا تَداعَت","عَلى أَبطالِها البيضُ الحِدادُ",53,"د",1,0],["وَريعَ مِنَ الغِيَرِ الطارِقا","تِ بِالرُمحِ صَرَّ وَبِالسَيفِ صَل",54,"ل",1,0],["وَريحِ خُزامى في مَذانِبِ رَوضَةٍ","جَلا دِمنَها سارٍ مِنَ المُزنِ هَطّالِ",55,"ل",1,0],["وريَّانَ من ماءِ الشَّبابِ تَهافَتَتْ","به نَشَواتٌ مِن صِباً ودَلالِ",56,"ل",1,1],["ورِياحُ الهجْرِ قدْ هَدَمَتْ","ما أقامَ الصبرُ مِنْ أَوَدِي",57,"د",2,0],["وَرياضاً أَنيقة وحياضاً","مترعات وأَنهراً جاريات",58,"ت",1,0],["وَرياحين من جميع صنوف ال","زهر تُهدي روائحاً عطرات",58,"ت",1,0],["وريث نرمي الجمار شوقا","في ملعب الشادن البهيج",59,"ج",1,0],["وريث نهدي إلى خطاه","بين الصحارى أو المروج",59,"ج",1,0],["ورياح الخليج دافئةً تثني","حواشي شراعه المنشورِ",60,"ر",1,0],["ورياح حسبتها","جررت ذيلك العطر",61,"ر",1,0],["ورِيعَتْ حذاراً على طِفْلِهَا","فنادَيْتُ يا هَذِهِ لا تُراعِي",62,"ع",2,0],["ورِياحُ زَهْرَتِها تلوحُ علَيْهمُ","برَوائِحٍ يَفتَرُّ منها العَنْبرُ",63,"ر",1,0],["ورَيطٌ متينِ الوَشيِ أَينعَ تحتَهُ","ثِمارُ صُدورٍ لا ثِمارُ غُصونِ",64,"ن",1,0],["وَرَيحانَتي رُمحي وَكاساتُ مَجلِسي","جَماجِمُ ساداتٍ حِراصٍ عَلى المَجدِ",65,"د",1,0],["وَريحُ الخُزامى يُذَكِّرُ أَنفي","نَسيمَ عَذارى وَذاتِ الأَيادي",66,"ي",1,0],["وَرَئِيسُ أَوْسَعِ أُمَّةٍ حُرِّيَّةً","يُغْرِي أُبَاةَ الضَّيْمِ بِالإِذْلاَلِ",67,"ل",1,0],["وَرِيحٌ حَيْثُ مَا هَبَّتْ","حَمَلَتْهَا الطِّيبَ مِعْطَارُ",68,"ر",1,0],["وَرِيَاضٌ مِنَ المَحَاسِنِ زِينَتْ","بِالأَفَانِينِ مِنْ غِرَاسٍ وَزَهْرِ",69,"ر",1,0],["وَرِيَاسَةُ الوُزَرَاءِ هَلْ تَحْلُو وَمَا","مَنْ سُؤْرِهَا فِي الكَأْسِ غَيْرُ الصَّابِ",70,"ب",1,0],["ورّي الفهم لَدَيهِ فَأَغنى","قَلبَهُ عَن كُلِّ شِبع وَرِيِّ",71,"ي",1,0],["وَريعَت بِاِسمِهِ الأُسدُ الضَواري","وَفُلَّ بِحَدِّ مِقوَلِهِ الصَفيحُ",72,"ح",1,0],["ورياحه: نكباء في","يوم، وفي يوم رُخاء",73,"ا",2,0],["ورئسكم كلنتن عارف ان احنا شعوب جيين","جيين بلصحوه الكبرى على ارض صلاح الدين",74,"ن",1,0],["وريعَ قلبيَ من ذكرى مُفارَقَةٍ","كأنَّني من جِنانِ الخُلْدِ مطرود",75,"د",1,0],["وَرِيْاحُ الصَّيْف قَدْ أَذْرَتْ بِها","تَنْسِجُ التُّرْبَ فُنوناً والمَطَرْ",76,"ر",1,0],["ورياح الخليج دافئة ال","بدر في ظلّه دفيف الطّيور",77,"ر",1,0],["وريحٌ، تمرُّ مرورَ المَلاكِ،","وتخطو إلى الغاب خَطَوَ الوليدْ؟",78,"د",1,0]]}