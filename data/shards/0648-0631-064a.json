.net/poem37443.html","الوافر"],[539,"إن تشا تحيى سعيدا","https://www.aldiwan.net/poem48212.html","عموديه"],[552,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[554,"كتاب فتى أخى كلف طروب","https://www.aldiwan.net/poem68408.html","الوافر"],[559,"أنا المعروف لي بالله ألوان","https://www.aldiwan.net/poem33827.html","الهزج"],[559,"هي الذات التي فوق البراق","https://www.aldiwan.net/poem34331.html","الوافر"],[559,"لم يكن ذا الكون قط","https://www.aldiwan.net/poem34408.html","مجزوء الرمل"],[562,"لقد وجدتم مصعبا مستصعبا","https://www.aldiwan.net/poem27829.html","الرجز"],[562,"وبلدة بعيدة النياط","https://www.aldiwan.net/poem27843.html","الرجز"],[568,"ضرب في ارتشاف ذاك الرضاب","https://www.aldiwan.net/poem69817.html","الخفيف"],[576,"أصبحت بعدك في الحياة كفان","https://www.aldiwan.net/poem2773.html","الكامل"],[576,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[579,"أتهجر أم لا اليوم من أنت عاشقه","https://www.aldiwan.net/poem710.html",""]],"verses":[["وَريمٍ رَماني طَرفُهُ بِسِهامِهِ","فَما أَخطأَ الرَّامي وَهُنَّ صيابُ",0,"ب",1,1],["وَريقٍ يَكادُ الرَّاحُ يَحكي مَذاقَهُ","أَظُنُّ وَظَنيِّ صادِقٌ أَنَّهُ عَذْبُ",1,"ب",1,0],["وريمٍ رَمى قلبي بأسْهُمِ لَحظِهِ","فأصْمَى وفي قَوْسِ الحَواجِبِ أنْبَضا",2,"ض",2,0],["ورِياضُ الشّيْخ كمْ مرْأى لَنا","فيهِ يُزْري بالنُهَى أو مُسْتَمَعْ",3,"ع",1,0],["وريعَ وقد شدّ العِناقُ وَثاقَهُ","كما ريعَ ظبْيٌ في حِبالةِ صائِدِ",4,"د",1,0],["وَريعَ الفُؤادُ لِعِرفانِها","وَهاجَت عَلى النَفسِ أَذكارَها",5,"ر",3,0],["وَريقَتُهُ في الإِرتِشافِ مُدامُ","سَقى جَنَباتِ القَصرِ صَوبُ الغَمائِمِ",6,"م",1,0],["وَرَيّاكِ رَوحٌ لِلنُفوسِ وَرَيحانُ","وَحَسبُ الأَماني ظِلُّكِ المُتَفَيَّأُ",7,"ي",2,0],["وَرَيّا إِذا نَفَحَت خِلتُها","تُمِلُّ ثَناءَكَ أَو تَستَهِلّ",8,"ل",1,0],["وَريحَ سَناً في حُقَّةٍ حِميَرِيَّةٍ","تُخَصُّ بِمَفروكٍ مِنَ المِسكِ أَذفَرا",9,"ر",2,0],["وَرَيحانٍ يَميسُ عَلى غُصونٍ","يَطيبُ بِشَمِّهِ شُربُ الكُؤوسِ",10,"س",1,1],["وَريحِ الخُزامى رَشَّها الطَلُّ بَعدَ ما","دَنا اللَيلُ حَتّى مَسَّها بِالقَوادِمِ",11,"م",1,0],["وَرَيطَةِ خِرقٍ كَالعُقابِ رَفَعتُها","وَقَد رَكَضَت رَصفَ الهَجيرِ جَنادِبُه",12,"ب",2,0],["ورياحُهُ نسمت بنشر لطيمة","وأقاحُهُ بسمت بثغر ملثّمِ",13,"م",1,0],["ورياضة الأبدان ملعبة بها","حفظت نشاط جسومها الأقوام",14,"م",1,0],["وَرَئيسُ مَملَكَةٍ وَطِئنَ جَبينَهُ","يَغشى حَواجِبَهُ دَمٌ وَغُبارُ",15,"ر",1,0],["وَريشي مِنكُمُ وَهَوايَ فيكُم","وَإِن كانَت زِيارَتُكُم لِماما",16,"م",2,0],["وَريَطْةِ فتيان كخاطف ظله","جعلت لهم منا خِباءً ممدَّدا",17,"د",2,1],["ورئيس كما تريد المعالي","لا كمن آده المسيرُ فردَّا",18,"د",2,0],["ورئيساً نجا ذوو القصد لما","قرَّبت منها الملوك نجيّا",19,"ي",2,0],["وريبُ الزمان غداً كائنٌ","وغالبُهُ مثلُ مغلوبِهِ",20,"ب",2,0],["ورياضٍ تخايلُ الأرض فيها","خُيلاء الفتاة في الأبرادِ",21,"د",1,1],["ورياسة كانت مطلَّقةً","منهم فكنت أحق بالرجعه",22,"ع",2,0],["وَرَئيسٍ ذي خِسَّةٍ","كُلُّ مَن شِئتَ لائِمُه",23,"م",2,1],["ورياضٌ لا تعرف الحَلَك الدَّاجي","ولا ثورَةَ الخريفِ العتيدِ",24,"د",1,0],["وريحٌ تمرُّ مُرورَ الملاكِ","وتخطو إلى الغابِ خَطْوَ الرُّعودْ",25,"د",1,0],["وريالة تجرى على شفة التقى","إن قيل قم في حلقة الذكرى أرقص",26,"ص",1,0],["وَريعَت كَما ريعَتِ الأَرضُ فيكَ","نَواحي السَماءِ وَأَعنانُها",27,"ن",3,0],["وَرِياضُ أَندَلُسٍ نَمَي","نَ الهاتِفاتِ الشاعِراتِ",28,"ت",1,0],["وَريعَ لَهُ جَيشُ العَدُوِّ وَما مَشى","وَجاشَت لَهُ الحَربُ الضَروسُ وَما تَغلي",29,"ل",2,0],["وَرَيّانُ لا تَصدى إِلى الخَمرِ نَفسُهُ","وَعَطشانُ لا تَروى يَداهُ مِنَ البَذلِ",30,"ل",1,0],["وريّانُ الصِبّا للحُسْنِ فيهِ","بدائعُ لا يُحيطُ بها الكلامُ",31,"م",1,0],["وَرِياضاً بَينَ العُبَيدِيِّ فَالقَص","رِ فَأَعلى سِمعانَ فَالمُستَراحِ",32,"ح",1,0],["وَرَيعُ الشَبابِ آضَ نَهباً مُفَرَّقاً","وَكانَ قَديماً وَهوَ غُنمٌ مُجَمَّعُ",33,"ع",1,0],["وَرِياضٍ تَصبو النُفوسُ إِلَيها","وَتُحَيّا بِوَردِهِنَّ الجَنِيِّ",34,"ي",1,0],["وَرَئيسُ يَومِ نَطاعِ صَعصَعَةُ الَّذي","حيناً يَضُرُّ وَكانَ حيناً يَنفَعُ",35,"ع",1,0],["ورَيحانٌ يَروقُكُما","ونَدمانٌ يَسُرُّكما",36,"م",2,0],["ورياحُكَ اللاتي تَهُبُّ جَنائباً","ولربَّما أجريتَهُنَّ سَمُوما",37,"م",2,0],["ورِياضٌ لم يُنْشِ زَهرَتَها التُّر","بُ ولم يَسْقِها منَ الغَيْثِ سِاقِي",38,"ق",2,0],["وريمٍ رَمَتْنيَ ألحاظُه","فَبِتُّ أسيراً لها مُوثَقا",39,"ق",2,1],["وريمٌ إذا رامَ حَثَّ الكُؤو","سِ قَطَّبَ للتِّيهِ واستَكبرا",40,"ر",2,0],["ورياضٌ تُجتَلى في طَرَفٍ","نظمَ القَطْرُ حِلاها ومَلُح",41,"ح",1,0],["وريعَتْ مصرُ إذ وثب العِفَرْنى","بحَدِّ السَّيفِ وانسابَ الحُباب",42,"ب",1,0],["ورياسةٌ عُلْوِيّةٌ ترنو إلى","زُهْرِ الكواكبِ إذ تَراءتْ من عَلِ",43,"ل",1,0],["وريحانَةٍ في النفس مَنبِتُ غُصْنها","لها نَفَسٌ يُحْيي بنفحتِهِ النّفسا",44,"س",2,1],["ورَيحانةٍ أُمّها كرمة","تَنَفّسُ في كفِّ غصن رطيبِ",45,"ب",1,0],["وريحٍ خفِيفَةٍ رَوْحِ النّسِيمِ","أطّتْ بليلاً وهبّت رُخاءَ",46,"ا",2,0],["ورياض ضاحَكَ الزهرَ بها","ثغرُك الصافي وناجاها الخيال",47,"ل",1,0],["وَرِياحُ الصَيفِ قَد أَزرَت بِها","تَنسِجُ التُربَ فُنوناً وَالمَطَر",48,"ر",1,0],["وَريعتْ قلوبُ المؤمنين فأجفلوا","يخافون من بعد النبيِّ الدواهيا",49,"ي",2,0],["وَريقُهُ كَمِثلِ طَوقٍ مِن أَدَم","وَلَيسَ مِن تَركِ السُؤالِ يَحتَشِم",50,"م",1,0],["وَرِيعَ لهُ أبو جهلٍ بِفَحْلٍ","يَنُوبُ عَنِ الهِزَبْرِ لهُ نُيُوبُ",51,"ب",1,0],["وَرَيّانَ مِن ماءِ الشَبابِ كَأَنَّما","يُظَمّأُ مِن ضُمرِ الحَشا وَيُجاعُ",52,"ع",1,0],["وَرِئبالُ العِراقِ إِذا تَداعَت","عَلى أَبطالِها البيضُ الحِدادُ",53,"د",1,0],["وَريعَ مِنَ الغِيَرِ الطارِقا","تِ بِالرُمحِ صَرَّ وَبِالسَيفِ صَل",54,"ل",1,0],["وَريحِ خُزامى في مَذانِبِ رَوضَةٍ","جَلا دِمنَها سارٍ مِنَ المُزنِ هَطّالِ",55,"ل",1,0],["وريَّانَ من ماءِ الشَّبابِ تَهافَتَتْ","به نَشَواتٌ مِن صِباً ودَلالِ",56,"ل",1,1],["ورِياحُ الهجْرِ قدْ هَدَمَتْ","ما أقامَ الصبرُ مِنْ أَوَدِي",57,"د",2,0],["وَرياضاً أَنيقة وحياضاً","مترعات وأَنهراً جاريات",58,"ت",1,0],["وَرياحين من جميع صنوف ال","زهر تُهدي روائحاً عطرات",58,"ت",1,0],["وريث نرمي الجمار شوقا","في ملعب الشادن البهيج",59,"ج",1,0],["وريث نهدي إلى خطاه","بين الصحارى أو المروج",59,"ج",1,0],["ورياح الخليج دافئةً تثني","حواشي شراعه المنشورِ",60,"ر",1,0],["ورياح حسبتها","جررت ذيلك العطر",61,"ر",1,0],["ورِيعَتْ حذاراً على طِفْلِهَا",