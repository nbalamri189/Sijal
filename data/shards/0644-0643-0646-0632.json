{"poems":[[408,"والله ما اخترت عنك من بدل","https://www.aldiwan.net/poem46532.html","المنسرح"],[556,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140220",""],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141255","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198480","الكامل"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216578",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87341","البسيط"],[3621,"","https://poetry.dctabudhabi.ae/diwan/poem/198776","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118001","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133277","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[4291,"","https://poetry.dctabudhabi.ae/diwan/poem/142466","الكامل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198226","الكامل"],[4869,"المقفص","https://www.poetsgate.com/ViewPoem.aspx?id=151534",""],[4902,"قالت قدر","https://www.poetsgate.com/ViewPoem.aspx?id=18516",""],[5458,"رحم الله أم ديبو","https://www.poetsgate.com/ViewPoem.aspx?id=72164",""],[5536,"وش سوى الغياب؟!!","https://www.poetsgate.com/ViewPoem.aspx?id=22593",""]],"verses":[["لكِنْ زَمانٌ وقِيتَ جفوتَه","أبدلني البُومَ بالطَّواويسِ",0,"س",1,0],["لك نَزْرٌ من كلّ خيرٍ فإنّي","كِلْتُ للشّرِّ وحدَه بالصّاعِ",1,"ع",1,0],["لكن زماني أصمتني رميته","بمدقع الفقر فانسدت به السبل",2,"ل",1,0],["لكن زوجته كاللبوةِ اختطفت","ها منه وارتشفتها رشف ظمآن",3,"ن",1,0],["لَكِن زَعَمتَ بأنَّ ربَّكَ بَائِنٌ","مِن خَلقِهِ إذ قُلتَ مَوجُودَانِ",4,"ن",1,0],["لَكِنَّ زَاغُونِيَّهُم قَد قَالَ إنَّ","ذَوَاتَهَا وَوُجُودَهَا غَيرَانِ",4,"ن",1,0],["لَكِن زِنُوهَا بِالنُّصُوصِ فَإن تُوَا","فِقهَأ فَتِلكَ صَحِيحَةُ الأوزَانِ",4,"ن",1,0],["لكنَّ ((زايدَ)) جُودُهُ لَمْ يَقْتَصِرْ","في سَاحَةِ الأنْباءِ والإِخْوانِ",5,"ن",1,0],["لكِنْ زرعي مِشْغِلِنِّي","أصَلّح الأشيَا وانَا وْحِيْد",6,"د",1,0],["لَكِن زِيَادَاتُهُم والنَّقصُ في أحَدٍ","مِنهُم وآخرُ مأسورٌ ومكبولُ",7,"ل",1,0],["لكنَّ زايد والإكرامُ دَيدَنُهُ","للنائلينَ سعَى كالبحرِ بالقُربِ",8,"ب",1,0],["لكن زيادة كلها في النار إلا","فرقة لم تخل عن طعان",9,"ن",1,0],["لكن زيارتنا لله خالصة","وذلك الجمع بالإخلاص محشود",10,"د",1,0],["لكن زفس مشدِّداً ركبي","وقواي أنقذني من العطب",11,"ب",1,0],["لكن زفس بعرش عزته","قاض بأن تنقض هاجمة",11,"ه",1,0],["لكن زفس وآله حفظوا","أنياس حتى ناجياً سلما",11,"م",2,0],["لَكِنَّ زَفسَ لَيسَ بِالمُبالي","يَعتَزُّ في عَلياهُ بِاِعتِزالِ",12,"ل",1,0],["لَكِنَّ زَفسَ في المَقامِ الأَرفَعِ","رَوَّعَ آياسَ بِهَولِ المَصرَعِ",12,"ع",1,0],["لَكِنَّ زَفسَ وَهَكطوراً بِنُصرَتِهِ","مِن دونِهِم خَصَّ ذاكَ الصضوتَ ما سَمِعا",13,"ع",2,0],["لَكِنَّ زَفسَ ذُرى المَجدِ الرَفيعِ ذَخَر","لِهَكطُرٍ فَإِلى الحُصنِ المَنيعِ عَبَر",13,"ر",1,0],["لكنَّ زايداً إزدرى ما زخرفوا","وسمَا فليسَ يَغُرُّهُ الَّلأْلاءُ",14,"ا",2,0],["لكنَّ ((زائِدَ))قد أتى طِبقَ اسمِهِ","والفعلُ طِبقَ الوصْفِ بل هُو أطبقُ",15,"ق",1,0],["لكن زمنّا باذن الايام يقرص","خلا الحضاره للبشر طب دكتور",16,"ر",1,0],["لكن زماني المر علمني اني","أموت ماحني لأجل قلبي جبيني",17,"ن",2,0],["لكن زواجك يا بني بداية","بيت بلا أطفال أشبه بالخرب",18,"ب",1,0],["لكن زد غباً تزد حبا ًولو طال الغياب","قبري تراه عيونك الثنتين ورموشك كفن",19,"ن",1,0]]}