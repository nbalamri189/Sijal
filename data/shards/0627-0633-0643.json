t/poem3474.html","عموديه"],[462,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[462,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[475,"أعن أرض الغميم لمحت نارا","https://www.aldiwan.net/poem15207.html","الوافر"],[477,"اسكت وقل هذا مآل","https://www.aldiwan.net/poem36958.html","مجزوء الكامل"],[477,"ما الغزال الأنيس","https://www.aldiwan.net/poem36978.html","مجزوء الخفيف"],[477,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[480,"ما لنا في الإمكان أبدع مما","https://www.aldiwan.net/poem24486.html","عموديه"],[498,"أسكرت أهل الوحا خمرتنا","https://www.aldiwan.net/poem37672.html","الرمل"],[498,"أي راح دارت به الأقداح","https://www.aldiwan.net/poem38045.html","الخفيف"],[498,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[512,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[512,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[512,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[513,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[534,"الحمد لله على الإسلام","https://www.aldiwan.net/poem23860.html","الرجز"],[536,"سال بالسحر منك خير يراع","https://www.aldiwan.net/poem47556.html","عموديه"],[556,"إن الذي أكد وعدي وفاه","https://www.aldiwan.net/poem33660.html","السريع"],[557,"هل لكم في شرب صهبا مزجت","https://www.aldiwan.net/poem69360.html","الرمل"],[565,"الحمد لله قد وجدت أخا","https://www.aldiwan.net/poem69721.html","المنسرح"],[573,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[573,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"],[584,"أسكرني باللفظ والمقلة ال","https://www.aldiwan.net/poem17560.html","السريع"]],"verses":[["أَسكَتَكَ المَوتُ وَلَكِنَّهُ","لَم يُسكِتِ الآثارَ في المَجمَعِ",0,"ع",1,0],["أَسكِتوهُ لا أَسكَتَ اللَهُ ذاكَ ال","صَوتَ صَوتَ المُتَيَّمِ الغِرّيدِ",1,"د",1,0],["اسكُت فَلَستَ مُصَدَّقاً","مَا كَانَ يَفعَلُ ذَا أَظُن",2,"ن",1,0],["أسكنتَه من فاسَ جنَّة ملكها","متنعماً منها بدار قرارِ",3,"ر",1,0],["أسكان نجد جادها واكِفُ الحيا","هواكم بقلبي مُنجدٌ ومغيرُ",4,"ر",1,0],["أسكان بطن الأرض هلاّ ذكرتم","عهوداً مضت منكم وأنتم على الظهر",5,"ر",1,0],["أَسَكرى اللَحظِ طَيِّبَةَ الثَنايا","هَضيمَ الكَشحِ جائِلَةَ الوِشاحِ",6,"ح",1,0],["أَسكُنُ البَدوَ ما أَقَمتِ بِبَدوٍ","فَإِذا ما حَضَرتِ طابَ الحُضورُ",7,"ر",1,0],["أسكانَ قلبٍ لا يداوى كليمه","ليهنكم من مقلتيَّ ذبيحها",8,"ح",3,0],["اسكنت قلبيَ لحدك","لا خيرَ في العيشِ بعدك",9,"ك",1,1],["اسكندر الأيام مالكها","بدليل أن زمانه الخضر",10,"ر",1,0],["أسكنتك القلب يا ذا الخال محتكماً","فيه فيا تعب المسكون بالخالي",11,"ي",1,0],["أسْكنته مهجتي ويا خجلي","فما أراني أكرمتُ مثواه",12,"ا",2,0],["اُسكتْ لحاك اللَّه من قائلٍ","أَجْنفَ عن قَصْد الهدى أنكبِ",13,"ب",1,0],["اسكتوا بعدَها فلا تذكروا الشؤ","م حياً فأنتُمُ الآجالُ",14,"ل",1,0],["أسكرتني سكر الشَّمولِ من الخم","رِ ودبَّت دبيبها في عِظامي",15,"م",2,0],["أَسُكّانَ مِصرٍ إِن قَضى اللَهُ بِالنَوى","فَثَمَّ عُهودٌ بَينَنا وَمَواثِقُ",16,"ق",1,0],["اسْكُني يا جِراحْ","واسْكُتي يا شُجُونْ",17,"ن",1,1],["إِسكَندَرِيَّةُ شُرِّفَت بِعِصابَةٍ","بيضِ الأَسِرَّةِ وَالصَحيفَةِ وَاليَدِ",18,"د",1,0],["إِسكَندَرِيَّةُ عادَ كَنزُكِ سالِماً","حَتّى كَأَن لَم يَلتَهِمهُ ضِرامُ",19,"م",1,0],["إِسكَندَرِيَّةُ كَيفَ صَبرُكِ عَن فَتىً","الصَبرُ لَم يُخلَق لِمِثلِ مُصابِه",20,"ب",2,0],["اِسكُب دُموعَكَ لا أَقولُ اِستَبقِها","فَأَخو الهَوى يَبكي عَلى أَحبابِه",20,"ب",2,0],["إِسكَندَرِيَّةُ يا عَروسَ الماءِ","وَخَميلَةَ الحُكَماءِ وَالشُعَراءِ",21,"ا",2,0],["أسكَرَني سُكْرُ مُقلَتَيْهِ فما","دامَ ثُمالي فإنني ثَمِلُ",22,"ل",1,0],["أَسكَرتَني بِسُلافِ ذِكرِ أَحِبَّتي","يا مُترِعَ الكاساتِ فَاِملَأ وَاِسقِني",23,"ي",1,0],["أسكبُ الدمعَ مرةً ثم أغدو","ذلكَ الساخرَ الخليَّ الهاني",24,"ي",1,0],["أسكبُ الدمعَ مرةً ثم أمضي","أنا أحببتُ مرةً في زماني",24,"ي",1,0],["أسكنت ذكرَك حُكْماً خالداً","أبداً بُنْيانُهُ لا ينْهَدِم",25,"م",1,0],["أسكَنَ اللَّهُ رأفةً مِنهُ قلباً","وَرَسَا طودُ حِلمِهِ في الوقارِ",26,"ر",1,0],["أُسَكِّنُ قَلباً هائِماً فيهِ مَأتَمٌ","مِنَ الشَوقِ إِلّا أَن عَينِيَ في عُرسِ",27,"س",1,0],["أُسكُت فَأَينَ ضِياؤُهُ وَبَهاؤُهُ","وَكَمالُهُ وَذَكاؤُهُ وَحَياؤُهُ",28,"ا",3,0],["أسكرَتْنا ألفاظُهُ فوقَ سكرِ ال","ناسِ بالعشقِ وابنةِ الزرجونِ",29,"ن",1,0],["اسكندريةُ ذا الوبا","سَبُعٌ يمدُّ إليكِ ضبعَهْ",30,"ه",1,1],["أسكرتَ في مصرَ شعباً ما هممتَ به","حتّى مشَى الذُّعرُ في أوصالِه فصحا",31,"ح",2,0],["أَسكَنوها في الدُنِّ مِن عَهدِ نوحٍ","كَظَلامٍ فيهِ نَهارٌ حَبيسُ",32,"س",1,0],["اِسكُبوا الكَأسَ إِلى النَو","مِ وَخَيرُ اللَهوِ تَجري",33,"ي",1,1],["أُسكُت فَإِنَّ السُكوتَ مَنقَبَةٌ","تَأمَن بِهِ إِنسَها وَخابِلَها",34,"ل",3,0],["أَسَكَنَ الثَرى لا يَبعَثونَ رِسالَةً","إِلَينا وَلَستُم سامِعي كَلِمِ الرُسلِ",35,"ل",1,0],["أُسكُت وَخَلِّ مُضِلَّهُم وَشُؤونَهُ","لِيَسوقَهُم بِعَصاهُ أَو بِحُسامِهِ",36,"م",2,1],["أسكوتٌ عن كلِّ ما هو حقٌّ","وسؤالٌ عن كلِّ ما هو زور",37,"ر",1,0],["أسكندريةُ قد شهدتِ فحدِّثي","فاليومَ قد وضَحَ الحنينُ المبهمُ",38,"م",1,0],["أسكنته حين لم يسكن به سكن","وليس يحسن أن يسخى بسكناك",39,"ك",1,0],["إسكندر الخيل وإن لم يركب","الأرض من أيامه في موكب",40,"ب",1,0],["أسكنها العقل فكانت أشرفا","من كلّ زاه في السماء أشرفا",41,"ف",2,0],["أَسْكِرِينِي عَلَى الدَّوَامِ وَأَفْنِي","مُهْجَتِي أَدْمُعاً وَعَزْمِي حَرِيقا",42,"ق",2,0],["اسْكَنْدر الشَّهْمِ","الأبِيِّ العَادِلِ المُعْتَدِلِ",43,"ل",1,0],["إِسْكنْدَرِيَّةُ التِي آثَرْتَهَا","مَا نَالَهَا مِنْ أَلَمِ البِعَادِ",44,"د",1,0],["أسكتَتهُ قوارعُ الموتِ لحناً","ولوتْهُ زَعازعُ الموتِ غُصنَا",45,"ن",2,0],["أسْكَرَتْهُ الذِّكْرَى فأصْغَى وأَصْغَى","يمَلأُ السَّمْعَ وهوْ نشْوانُ صاحي",46,"ح",2,0],["أَسْكِتِ الصَادِحاتِ يَهتفْنَ في الدَّو","حِ وَكُنْ في عِشاشِهَا تَغْرِيدَا",47,"د",2,0],["اُسْكُبِ الأُنْس في النفوس، وكَفْكِفْ","من دموع العُفَاةِ والأيتام",48,"م",1,0],["إسكندريةُ -إذ رأتك- تلفَّتَتْ","وهفت لسالف مجدها المدثور",49,"ر",1,0],["أسكتوا... إنما حفيد ( النجاشي)","يلبس اليوم( حميراً) و( معينا)",50,"ن",2,0],["أسكتوا... إنما تنوب الزوايا","باسمنا تطبخ السقوف أنينا",50,"ن",2,0],["أسَكْرَى اللّحظِ طَيّبَة َ الثّنَايا","أفترى اللحظِ ، جائلة َ الوشاحِ",51,"ح",1,0],["اسكتوا بعدَها فلا تذكروا الشْ","شُؤم حياً فأنتُمُ الآجالُ",52,"ل",1,0],["اسكرني ولطفه","من ريقه جرياله",53,"ل",2,0],["أسكرتني همومُهم إذْ تولّوْا","فكأنّي شربْتُ كأسَ رحيقِ",54,"ق",1,0],["أسكنْتَني في بقعةٍ","فيها غدوتُ أعزّ شأنا",55,"ن",2,0],["أَسكَنتَها ظِلَّ القُصورِ وَلَم تَزَل","مِن قَبلُ في ظِلِّ الوَشيجِ تَقيلُ",56,"ل",1,0],["أَسكَنتَ مُقفِرَهُ وَلَو لَم تَحمِهِ","لَخَلَت مَعاقِلُهُ مِنَ السُكّانِ",57,"ن",1,0],["أَسُكّانَ نَعمانِ الأَراكِ تَيَقَّنوا","بِأَنَّكُمُ في رَبعِ قَلبِيَ سُكّانُ",58,"ن",1,1],["اسكن فؤادي وطب نفسا وقرّ لقد","بلغت ما رمت قرّ الناس أو ساحوا",59,"ح",3,0],["اسكن فؤادي وقرّ الآن في جسدي","فقد وصلت بحزب اللّه أحبالا",60,"ل",2,0],["أَسْكَنْتُ مِنْ بَعْدِهِ صَبْري ثَرى جَلَدِي","فَماتَ فِيهِ وَلَمْ أَعْلَمْ بِما عَلِما",61,"م",2,0],["اسكنوها بسلام آمنينا","في سرور يا أمير المؤمنينا",62,"ن",2,1],["اسكت بفيك الترب أن عجز امرء","عن فضه بالصخرة الجلمود",63,"د",1,0],["أسكتت عن مقصد النط","ق ونحواها فصيح",64,"ح",1,0],["أسكر بها الوادي على","فرح الأقارب والأباعد",65,"د",1,0],["أسكنتهُ الضميرَ حتى رأتهُ","يتهادى من كبرهِ في الضميرِ",66,"ر",1,0],["اسكرني من حباب مبسمه","افديه كالبدر في اصايله",67,"ه",1,0],["أسكان حلوانٍ سلام ولوعة","فأنتم بوجدان المتيم سكان",68,"ن",1,0],["إسكندرية دعها دع حماك بها","مصر الجديدة مأوى الخرّد الغيد",69,"د",1,0],["إسكندرية دعها دع حماك بها","إن كنتَ تشتاقني في ليلة العيد",69,"د",1,0],["أسكان حلوان إليكم تحيةٌ","وشوق بأحشاي يثور فيجهل",70,"ل",1,0],["أسُكَّانَ وادي الضَالِ إنَّ محَاجِري","فليسَ لها عن سَكْبِ أدمعِها شُغْلُ",71,"ل",1,0],["أَسكَرَت خدعَةُ الجَمالِ هرقَلاً","قَبل شَمشونَ بِالهَوى الشِرّيرِ",72,"ر",1,0],["أسكرَني لحظُ مقلتيه كما","أسكر عينيه لدغُ صُدْغيهِ",73,"ي",2,0],["أسكنتُهُ قلبي وفيه لظىً","والحورُ لا تَسكُنُ إلا الجنان",74,"ن",1,0],["أَسكَرَتنا جُفونُهُ السودُ لَكِن","سَلّ بيض السُيوفِ يا صاحِ نُصحي",75,"ي",1,0],["اسكندرية لم تزل","وحنينها بادي الأثر",76,"ر",1,0],["أسكنت شخصك عيني","حتى أوارى أواري",77,"ي",1,1],["أَسُكَّانَ رَامَه هَل مِن قِرَى","فَقَد دَفَع اللَّيلُ ضَيفاً قَنُوعَا",78,"ع",2,1],["أسكر الليلَ حبُّنا فمضى يح","لمُ بالخمر والهوى والنساء",79,"ا",2,0],["أسكرت قلبي فنى ورو","ى الشدوَ لساني",80,"ي",1,0],["إِسكَندر الحَزم مُستَغنٍ بِحكمته","عَن نَيلِهِ مِن أَرسطليسه مددا",81,"د",2,0],["إسكَندر الثاني عنان العَزم لا","إِلّا إِلى شَرفٍ يَحقّ لَهُ الطَلَب",82,"ب",1,0],["أَسُكّانَ قَلبي كَيفَ جاوَرتُمُ الأَسى","بِهِ وَهوَ نارٌ بِالدُموعِ تَسيلُ",83,"ل",1,1],["أَسُكّانَ القُصورِ لَئِن قُطِعتُم","فَقَد قُطِّعتُ مِن سُكّانِ قَصري",84,"ي",1,0],["أَسكَنَت غَر مَعاشِري دَور البَلا","فَرَددت أَسيافاً إِلى أَغمادِ",85,"د",1,0],["أسكنه يا ربِّي وكلَّ موحِّدٍ","سلكَ الطَّريق المستقيم جِنانا",86,"ن",2,0],["أسكّان نعمان الأراك إلى مَتَى","وحتّى مَتى وجدي بكم وولوعي",87,"ي",1,0],["أسكنه اللّه دار رحمته","وخصه بالنعيم من نعمه",88,"م",2,0],["أسكَّانَ أكنافِ العواصِم دعوةً","بِفِيَّ بَروداً وهي في كَبِدي جمرُ",89,"ر",1,0],["اسكن الوجد في الحشاشة لما","جرّ قلبي بلامهِ الذهبي",90,"ي",1,0],["اسكرتنا عيناه حتى كأنا","قد رشفنا من ريقه الكوثريّ",90,"ي",1,0],["اسكترنا ما بين تيه وعجب","برحيق من الصبا والدلال",91,"ل",1,0],["أسكرتُهُم بكؤوسِ المدح مترعةً","ولم أفِدْ منهمُ إلا العرابيدا",92,"د",2,0],["أسكان سلع إن خلا منكم اللوى","فلم يخل قلبي من هواكم ولا سرّي",93,"ر",2,0],["أسكنتها الكرم التلاد فما انضوى","إلا إليها منتهى الأفهام",94,"م",1,0],["أسكرني من هواه كأس طلىً","من خمرة الوجنتين معتصرَه",95,"ر",2,0],["أسكنتها في عيوني وهي شاردة","كالزهر تسكنه ذرات أنداء",96,"ا",2,0],["أسكنتَه دارَ الشقاءِ وإنها","في جنب ما هو خائف لنعيمُ",97,"م",1,0],["أسكبُ العُرْف والدماء ولا أسْ","أَمُ بذل النَّدى وضرب الرقابِ",98,"ب",1,0],["أسكرني الحبُّ بأجفانه","وأنت يا صاحِ من الحبِّ صاحْ",99,"ح",1,0],["أسكَّانَ نجدٍ لم يكن عهدُ وصلكم","وغضِ الصبا إلاَّ كأحلام نائمِ",100,"م",1,0],["أسكنتهُ قلبي وفيه جهنمٌ","وكذا جزاء القاتل المتعمد",101,"د",1,0],["أُسكَّنُ بالدموعِ لهيبَ نارٍ","أبتْ بعدَ النوى إلا استعارا",102,"ر",2,0],["اسكت وقل هذا مآ","ل المستكين لمسكتيه",103,"ي",2,1],["أسكرتنا بلطف","