oem55864.html","الكامل"],[462,"أيها الناطق الذي شغل الأل","https://www.aldiwan.net/poem15153.html","الخفيف"],[465,"ليس على الصب المغنى جناح","https://www.aldiwan.net/poem3474.html","عموديه"],[465,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[465,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[478,"أعن أرض الغميم لمحت نارا","https://www.aldiwan.net/poem15207.html","الوافر"],[480,"اسكت وقل هذا مآل","https://www.aldiwan.net/poem36958.html","مجزوء الكامل"],[480,"ما الغزال الأنيس","https://www.aldiwan.net/poem36978.html","مجزوء الخفيف"],[480,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[483,"ما لنا في الإمكان أبدع مما","https://www.aldiwan.net/poem24486.html","عموديه"],[501,"أسكرت أهل الوحا خمرتنا","https://www.aldiwan.net/poem37672.html","الرمل"],[501,"أي راح دارت به الأقداح","https://www.aldiwan.net/poem38045.html","الخفيف"],[501,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[515,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[515,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[515,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[516,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[537,"الحمد لله على الإسلام","https://www.aldiwan.net/poem23860.html","الرجز"],[539,"سال بالسحر منك خير يراع","https://www.aldiwan.net/poem47556.html","عموديه"],[559,"إن الذي أكد وعدي وفاه","https://www.aldiwan.net/poem33660.html","السريع"],[560,"هل لكم في شرب صهبا مزجت","https://www.aldiwan.net/poem69360.html","الرمل"],[568,"الحمد لله قد وجدت أخا","https://www.aldiwan.net/poem69721.html","المنسرح"],[576,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[576,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"],[587,"أسكرني باللفظ والمقلة ال","https://www.aldiwan.net/poem17560.html","السريع"]],"verses":[["أَسكَتَكَ المَوتُ وَلَكِنَّهُ","لَم يُسكِتِ الآثارَ في المَجمَعِ",0,"ع",1,0],["أَسكِتوهُ لا أَسكَتَ اللَهُ ذاكَ ال","صَوتَ صَوتَ المُتَيَّمِ الغِرّيدِ",1,"د",1,0],["اسكُت فَلَستَ مُصَدَّقاً","مَا كَانَ يَفعَلُ ذَا أَظُن",2,"ن",1,0],["أسكنتَه من فاسَ جنَّة ملكها","متنعماً منها بدار قرارِ",3,"ر",1,0],["أسكان نجد جادها واكِفُ الحيا","هواكم بقلبي مُنجدٌ ومغيرُ",4,"ر",1,0],["أسكان بطن الأرض هلاّ ذكرتم","عهوداً مضت منكم وأنتم على الظهر",5,"ر",1,0],["أَسَكرى اللَحظِ طَيِّبَةَ الثَنايا","هَضيمَ الكَشحِ جائِلَةَ الوِشاحِ",6,"ح",1,0],["أَسكُنُ البَدوَ ما أَقَمتِ بِبَدوٍ","فَإِذا ما حَضَرتِ طابَ الحُضورُ",7,"ر",1,0],["أسكانَ قلبٍ لا يداوى كليمه","ليهنكم من مقلتيَّ ذبيحها",8,"ح",3,0],["اسكنت قلبيَ لحدك","لا خيرَ في العيشِ بعدك",9,"ك",1,1],["اسكندر الأيام مالكها","بدليل أن زمانه الخضر",10,"ر",1,0],["أسكنتك القلب يا ذا الخال محتكماً","فيه فيا تعب المسكون بالخالي",11,"ل",2,0],["أسْكنته مهجتي ويا خجلي","فما أراني أكرمتُ مثواه",12,"ا",2,0],["اُسكتْ لحاك اللَّه من قائلٍ","أَجْنفَ عن قَصْد الهدى أنكبِ",13,"ب",1,0],["اسكتوا بعدَها فلا تذكروا الشؤ","م حياً فأنتُمُ الآجالُ",14,"ل",1,0],["أسكرتني سكر الشَّمولِ من الخم","رِ ودبَّت دبيبها في عِظامي",15,"م",2,0],["أَسُكّانَ مِصرٍ إِن قَضى اللَهُ بِالنَوى","فَثَمَّ عُهودٌ بَينَنا وَمَواثِقُ",16,"ق",1,0],["اسْكُني يا جِراحْ","واسْكُتي يا شُجُونْ",17,"ن",1,1],["إِسكَندَرِيَّةُ شُرِّفَت بِعِصابَةٍ","بيضِ الأَسِرَّةِ وَالصَحيفَةِ وَاليَدِ",18,"د",1,0],["إِسكَندَرِيَّةُ عادَ كَنزُكِ سالِماً","حَتّى كَأَن لَم يَلتَهِمهُ ضِرامُ",19,"م",1,0],["إِسكَندَرِيَّةُ كَيفَ صَبرُكِ عَن فَتىً","الصَبرُ لَم يُخلَق لِمِثلِ مُصابِه",20,"ب",2,0],["اِسكُب دُموعَكَ لا أَقولُ اِستَبقِها","فَأَخو الهَوى يَبكي عَلى أَحبابِه",20,"ب",2,0],["إِسكَندَرِيَّةُ يا عَروسَ الماءِ","وَخَميلَةَ الحُكَماءِ وَالشُعَراءِ",21,"ا",2,0],["أسكَرَني سُكْرُ مُقلَتَيْهِ فما","دامَ ثُمالي فإنني ثَمِلُ",22,"ل",1,0],["أَسكَرتَني بِسُلافِ ذِكرِ أَحِبَّتي","يا مُترِعَ الكاساتِ فَاِملَأ وَاِسقِني",23,"ن",2,0],["أسكبُ الدمعَ مرةً ثم أغدو","ذلكَ الساخرَ الخليَّ الهاني",24,"ن",2,0],["أسكبُ الدمعَ مرةً ثم أمضي","أنا أحببتُ مرةً في زماني",24,"ن",2,0],["أسكنت ذكرَك حُكْماً خالداً","أبداً بُنْيانُهُ لا ينْهَدِم",25,"م",1,0],["أسكَنَ اللَّهُ رأفةً مِنهُ قلباً","وَرَسَا طودُ حِلمِهِ في الوقارِ",26,"ر",1,0],["أُسَكِّنُ قَلباً هائِماً فيهِ مَأتَمٌ","مِنَ الشَوقِ إِلّا أَن عَينِيَ في عُرسِ",27,"س",1,0],["أُسكُت فَأَينَ ضِياؤُهُ وَبَهاؤُهُ","وَكَمالُهُ وَذَكاؤُهُ وَحَياؤُهُ",28,"ا",3,0],["أسكرَتْنا ألفاظُهُ فوقَ سكرِ ال","ناسِ بالعشقِ وابنةِ الزرجونِ",29,"ن",1,0],["اسكندريةُ ذا الوبا","سَبُعٌ يمدُّ إليكِ ضبعَهْ",30,"ه",1,1],["أسكرتَ في مصرَ شعباً ما هممتَ به","حتّى مشَى الذُّعرُ في أوصالِه فصحا",31,"ح",2,0],["أَسكَنوها في الدُنِّ مِن عَهدِ نوحٍ","كَظَلامٍ فيهِ نَهارٌ حَبيسُ",32,"س",1,0],["اِسكُبوا الكَأسَ إِلى النَو","مِ وَخَيرُ اللَهوِ تَجري",33,"ي",1,1],["أُسكُت فَإِنَّ السُكوتَ مَنقَبَةٌ","تَأمَن بِهِ إِنسَها وَخابِلَها",34,"ل",3,0],["أَسَكَنَ الثَرى لا يَبعَثونَ رِسالَةً","إِلَينا وَلَستُم سامِعي كَلِمِ الرُسلِ",35,"ل",1,0],["أُسكُت وَخَلِّ مُضِلَّهُم وَشُؤونَهُ","لِيَسوقَهُم بِعَصاهُ أَو بِحُسامِهِ",36,"م",2,1],["أسكوتٌ عن كلِّ ما هو حقٌّ","وسؤالٌ عن كلِّ ما هو زور",37,"ر",1,0],["أسكندريةُ قد شهدتِ فحدِّثي","فاليومَ قد وضَحَ الحنينُ المبهمُ",38,"م",1,0],["أسكنته حين لم يسكن به سكن","وليس يحسن أن يسخى بسكناك",39,"ك",1,0],["إسكندر الخيل وإن لم يركب","الأرض من أيامه في موكب",40,"ب",1,0],["أسكنها العقل فكانت أشرفا","من كلّ زاه في السماء أشرفا",41,"ف",2,0],["أَسْكِرِينِي عَلَى الدَّوَامِ وَأَفْنِي","مُهْجَتِي أَدْمُعاً وَعَزْمِي حَرِيقا",42,"ق",2,0],["اسْكَنْدر الشَّهْمِ","الأبِيِّ العَادِلِ المُعْتَدِلِ",43,"ل",1,0],["إِسْكنْدَرِيَّةُ التِي آثَرْتَهَا","مَا نَالَهَا مِنْ أَلَمِ البِعَادِ",44,"د",1,0],["أسكتَتهُ قوارعُ الموتِ لحناً","ولوتْهُ زَعازعُ الموتِ غُصنَا",45,"ن",2,0],["أسْكَرَتْهُ الذِّكْرَى فأصْغَى وأَصْغَى","يمَلأُ السَّمْعَ وهوْ نشْوانُ صاحي",46,"ح",2,0],["أَسْكِتِ الصَادِحاتِ يَهتفْنَ في الدَّو","حِ وَكُنْ في عِشاشِهَا تَغْرِيدَا",47,"د",2,0],["اُسْكُبِ الأُنْس في النفوس، وكَفْكِفْ","من دموع العُفَاةِ والأيتام",48,"م",1,0],["إسكندريةُ -إذ رأتك- تلفَّتَتْ","وهفت لسالف مجدها المدثور",49,"ر",1,0],["أسكت القبر فيه كلّ ضجيج","واحتواه سكونه وهجوعه",50,"ع",2,0],["أسكتوا... إنما حفيد ( النجاشي)","يلبس اليوم( حميراً) و( معينا)",51,"ن",2,0],["أسكتوا... إنما تنوب الزوايا","باسمنا تطبخ السقوف أنينا",51,"ن",2,0],["أسَكْرَى اللّحظِ طَيّبَة َ الثّنَايا","أفترى اللحظِ ، جائلة َ الوشاحِ",52,"ح",1,0],["اسكتوا بعدَها فلا تذكروا الشْ","شُؤم حياً فأنتُمُ الآجالُ",53,"ل",1,0],["أسكنتها القلب الرّحيم فرابها","ما فيه من شكوى ورجع نواح",54,"ح",1,0],["اسكرني ولطفه","من ريقه جرياله",55,"ل",2,0],["أسكرتني همومُهم إذْ تولّوْا","فكأنّي شربْتُ كأسَ رحيقِ",56,"ق",1,0],["أسكنْتَني في بقعةٍ","فيها غدوتُ أعزّ شأنا",57,"ن",2,0],["أَسكَنتَها ظِلَّ القُصورِ وَلَم تَزَل","مِن قَبلُ في ظِلِّ الوَشيجِ تَقيلُ",58,"ل",1,0],["أَسكَنتَ مُقفِرَهُ وَلَو لَم تَحمِهِ","لَخَلَت مَعاقِلُهُ مِنَ السُكّانِ",59,"ن",1,0],["أَسُكّانَ نَعمانِ الأَراكِ تَيَقَّنوا","بِأَنَّكُمُ في رَبعِ قَلبِيَ سُكّانُ",60,"ن",1,1],["اسكن فؤادي وطب نفسا وقرّ لقد","بلغت ما رمت قرّ الناس أو ساحوا",61,"ح",3,0],["اسكن فؤادي وقرّ الآن في جسدي","فقد وصلت بحزب اللّه أحبالا",62,"ل",2,0],["أَسْكَنْتُ مِنْ بَعْدِهِ صَبْري ثَرى جَلَدِي","فَماتَ فِيهِ وَلَمْ أَعْلَمْ بِما عَلِما",63,"م",2,0],["اسكنوها بسلام آمنينا","في سرور يا أمير المؤمنينا",64,"ن",2,1],["اسكت بفيك الترب أن عجز امرء","عن فضه بالصخرة الجلمود",65,"د",1,0],["أسكتت عن مقصد النط","ق ونحواها فصيح",66,"ح",1,0],["أسكر بها الوادي على","فرح الأقارب والأباعد",67,"د",1,0],["أسكنتهُ الضميرَ حتى رأتهُ","يتهادى من كبرهِ في الضميرِ",68,"ر",1,0],["اسكرني من حباب مبسمه","افديه كالبدر في اصايله",69,"ه",1,0],["أسكان حلوانٍ سلام ولوعة","فأنتم بوجدان المتيم سكان",70,"ن",1,0],["إسكندرية دعها دع حماك بها","مصر الجديدة مأوى الخرّد الغيد",71,"د",1,0],["إسكندرية دعها دع حماك بها","إن كنتَ تشتاقني في ليلة العيد",71,"د",1,0],["أسكان حلوان إليكم تحيةٌ","وشوق بأحشاي يثور فيجهل",72,"ل",1,0],["أسُكَّانَ وادي الضَالِ إنَّ محَاجِري","فليسَ لها عن سَكْبِ أدمعِها شُغْلُ",73,"ل",1,0],["أَسكَرَت خدعَةُ الجَمالِ هرقَلاً","قَبل شَمشونَ بِالهَوى الشِرّيرِ",74,"ر",1,0],["أسكرَني لحظُ مقلتيه كما","أسكر عينيه لدغُ صُدْغيهِ",75,"ي",2,0],["أسكنتُهُ قلبي وفيه لظىً","والحورُ لا تَسكُنُ إلا الجنان",76,"ن",1,0],["أَسكَرَتنا جُفونُهُ السودُ لَكِن","سَلّ بيض السُيوفِ يا صاحِ نُصحي",77,"ح",2,0],["اسكندرية لم تزل","وحنينها بادي الأثر",78,"ر",1,0],["أسكنت شخصك عيني","حتى أوارى أواري",79,"ي",1,1],["أَسُكَّانَ رَامَه هَل مِن قِرَى","فَقَد دَفَع اللَّيلُ ضَيفاً قَنُوعَا",80,"ع",2,1],["أسكر الليلَ حبُّنا فمضى يح","لمُ بالخمر والهوى والنساء",81,"ا",2,0],["أسكرت قلبي فنى ورو","ى الشدوَ لساني",82,"ن",2,0],["إِسكَندر الحَزم مُستَغنٍ بِحكمته","عَن نَيلِهِ مِن أَرسطليسه مددا",83,"د",2,0],["إسكَندر الثاني عنان العَزم لا","إِلّا إِلى شَرفٍ يَحقّ لَهُ الطَلَب",84,"ب",1,0],["أَسُكّانَ قَلبي كَيفَ جاوَرتُمُ الأَسى","بِهِ وَهوَ نارٌ بِالدُموعِ تَسيلُ",85,"ل",1,1],["أَسُكّانَ القُصورِ لَئِن قُطِعتُم","فَقَد قُطِّعتُ مِن سُكّانِ قَصري",86,"ر",2,0],["أَسكَنَت غَر مَعاشِري دَور البَلا","فَرَددت أَسيافاً إِلى أَغمادِ",87,"د",1,0],["أسكنه يا ربِّي وكلَّ موحِّدٍ","سلكَ الطَّريق المستقيم جِنانا",88,"ن",2,0],["أسكّان نعمان الأراك إلى مَتَى","وحتّى مَتى وجدي بكم وولوعي",89,"ع",2,0],["أسكنه اللّه دار رحمته","وخصه بالنعيم من نعمه",90,"م",2,0],["أسكَّانَ أكنافِ العواصِم دعوةً","بِفِيَّ بَروداً وهي في كَبِدي جمرُ",91,"ر",1,0],["اسكن الوجد في الحشاشة لما","جرّ قلبي بلامهِ الذهبي",92,"ي",1,0],["اسكرتنا عيناه حتى كأنا","قد رشفنا من ريقه الكوثريّ",92,"ي",1,0],["اسكترنا ما بين تيه وعجب","برحيق من الصبا والدلال",93,"ل",1,0],["أسكرتُهُم بكؤوسِ المدح مترعةً","ولم أفِدْ منهمُ إلا العرابيدا",94,"د",2,0],["أسكان سلع إن خلا منكم اللوى","فلم يخل قلبي من هواكم ولا سرّي",95,"ر",2,0],["أسكنتها الكرم التلاد فما انضوى","إلا إليها منتهى الأفهام",96,"م",1,0],["أسكرني من هواه كأس طلىً","من خمرة الوجنتين معتصرَه",97,"ر",2,0],["أسكنتها في عيوني وهي شاردة","كالزهر تسكنه ذرات أنداء",98,"ا",2,0],["أسكنتَه دارَ الشقاءِ وإنها","في جنب ما هو خائف لنعيمُ",99,"م",1,0],["أسكبُ العُرْف والدماء ولا أسْ","أَمُ بذل النَّدى وضرب الرقابِ",100,"ب",1,0],["أسكرني الحبُّ بأجفانه","وأنت يا صاحِ من الحبِّ صاحْ",101,"ح