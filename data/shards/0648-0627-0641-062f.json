{"poems":[[65,"سرت وظلام الليل ستر على الساري","https://www.aldiwan.net/poem46202.html","الطويل"],[65,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[10,"فدى للفارس الجشمي نفسي","https://www.aldiwan.net/poem21133.html","الوافر"],[95,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[95,"إلى مصر أزف عن الشآم","https://www.aldiwan.net/poem11411.html","الوافر"],[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[87,"هذه نور السفينه","https://www.aldiwan.net/poem63692.html","مجزوء الرمل"],[60,"أقيك بنفسي أيها المصطفى الذي","https://www.aldiwan.net/poem30919.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16641","الكامل"],[147,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[147,"ما كان قبلك في الزمان الخالي","https://www.aldiwan.net/poem11802.html","الكامل"],[185,"أمن طلل بالجزع قو المعارف","https://www.aldiwan.net/poem58844.html","الطويل"],[242,"نلنا ولولا الحب ما نلناها","https://www.aldiwan.net/poem19725.html","الكامل"],[275,"بما في ليالي الهوى من أرق","https://www.aldiwan.net/poem35459.html","المتقارب"],[276,"بمحمد خطر المحامد يعظم","https://www.aldiwan.net/poem52125.html","الكامل"],[369,"أنت للعيد وهو للناس عيد","https://www.aldiwan.net/poem60931.html","الخفيف"],[385,"لمن طلل بعد القطين تغيرا","https://www.aldiwan.net/poem49255.html","الطويل"],[408,"ألا خبرا عن رامة أيها الركب","https://www.aldiwan.net/poem46427.html","الطويل"],[409,"لله درك فارس العلماءكم","https://www.aldiwan.net/poem33490.html","الكامل"],[463,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[498,"وأنا الذي علمت من طلب الغنى","https://www.aldiwan.net/poem67425.html","الكامل"],[591,"أأخاف صرف الدهر أم حدثانه","https://www.aldiwan.net/poem17502.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48846","المتقارب"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56184","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112866","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112814","الخفيف"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49942","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125366","الوافر"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104803","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120717","المديد"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94243","الكامل"],[3374,"","https://poetry.dctabudhabi.ae/diwan/poem/145411","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88994","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138602",""],[4935,"مفاخر مصر بالكذب","https://www.poetsgate.com/ViewPoem.aspx?id=129308",""],[3591,"أحبكمَ والشاهداتُ الحواسدُ","https://www.poetsgate.com/ViewPoem.aspx?id=149376",""],[5136,"صافحت ريح الصبا روض الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=121655",""],[5328,"كوني سحابا","https://www.poetsgate.com/ViewPoem.aspx?id=211984",""],[5538,"هب النسيم على محب ناءي","https://www.poetsgate.com/ViewPoem.aspx?id=142626",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5956,"سلامة كفّك","https://www.poetsgate.com/ViewPoem.aspx?id=192416",""]],"verses":[["وأفْديهِ منْ سارٍ على الأيْنِ طارِقٍ","وأهْواهُ منْ طَيفٍ على النّأْيِ زَوَّارِ",0,"ر",1,0],["وأفَدْتُ مِنْ أخلاقِهِ ونَوالِهِ","مِنَحاً يَضِنُّ بها السَّحابُ المُرْهِمُ",1,"م",1,0],["وَأَفديهِ بِكُلِّ بَني سُلَيمٍ","بِظاعِنهِم وَبِالأَنَسِ المُقيمِ",2,"م",1,0],["وأَفَدْتَ فَالمَحْمُولُ فِي","هَا طَابَ وَالمَوْضُوعُ طَابَا",3,"ب",2,0],["وَأُفْدِي كُلَّ جُلْمُودٍ فَتِيتٍ","وَهَى بِقَنَابِلِ الْقَوْمِ اللِّئَامِ",4,"م",1,0],["وَافِدٌ زار مُستماحي وفود","مُرْتجىً منه مُستَمَاحُ وُفُودِ",5,"د",1,0],["وَأَفِدهُ أَنَّني في ال","بَحرِ مُذ دُستُ عَرينَه",6,"ن",2,0],["وَأَفديكَ حَوبائي وَما قَدر مُهجَتي","لِمَن أَنتَمي فيهِ إِلى الفَرعِ وَالأَصلِ",7,"ل",1,0],["وأفَدْتُها القِدْحَ المُعَلّى فائضاً","يَجْري ولم أقْنَعْ لها بالنافس",8,"س",1,0],["وَأَفَدتَ ما لَم يَجرِ في خَلَدِ المُنى","يَوماً وَلَم يَطمَح إِلَيهِ مَطمَعُ",9,"ع",1,0],["وَأَفَدتَني أَنَّ الإِقامَةَ لِلفَتى","ذُلٌّ وَأَنَّ العِزَّ في التَرحالِ",10,"ل",1,0],["وَأَفدَى لِمَغلُولٍ وَأَوفَى بِذِمَّةٍ","وَأَوقَى لِضَيمٍ عَن نَقِيلٍ مُحالِفِ",11,"ف",1,0],["وَأَفِدْهُ فَهْماً فِي قَضَايَاكَ التِي","عَكْسُ النَّقِيضِ مُوَافِقٌ فَحْوَاهَا",12,"ا",3,0],["وأفدي جمالاً هداني إلى","عفافِ غرامٍ وقوَّةِ حَق",13,"ق",1,0],["وأفد وأرسد بالهداية من غوى","فَلك الفَضيلة وَالوَسيلة وَاللوا",14,"ل",3,0],["وافدٌ لا يزالُ بالسّعْد منه","صَدرٌ ليس يَنْقَضِي ووُرود",15,"د",1,0],["وَأَفدي بِروحي واهن العَهد مدنف الجُفون","غَضيضاً ساحر الطَرف أَحوَرا",16,"ر",2,0],["وأفديه سرباً بالعتيقِ ألفتُهُ","فأي غزال ضمها ذلك السربُ",17,"ب",1,0],["وأفدي الّتي أجرتْ دماً مِن مَحاجري","بأسياف لحظٍ لا تكِلّ ولا تَنْبو",17,"ب",2,0],["وأفدتنا فيه فوائد جمة","أضحت إلى نيل الرشاد سبيلا",18,"ل",2,0],["وأفدتُ عدوى العزّ منك فكلُّ ما","وسِعَ الكفايةَ لي غنىً وكَفافُ",19,"ف",1,0],["وَأَفَدتُ قَدماً مُعجِزات فَضائِلي","مِن نورِ فَطنَتِهِ وَنارِ ذَكائِهِ",20,"ا",3,0],["وَأَفَدْتُ سَمْعِي مِنْ فُكَاهَةِ مُمْتِع ال","ألفَاظ مَقْبُولِ الكَلَام مُفِيدِهِ",21,"د",2,0],["وأفدي بمهجتيَ العاملي","ن بعد طريفيَ والتالد",22,"د",1,0],["وافديه خليلٌ للمعالي","أمير قد علا منه الجنابُ",23,"ب",1,0],["وافد علوما واملني من بركم","حسن الحديث ووالني بصلاتي",24,"ت",2,0],["وافدني علوم خير وهبني","شرب حب بذي المحيا المنيره",25,"ر",2,0],["وافدتَ نائلك العُفاةَ مُعجَّلاً","ببشاشةٍ لا تشتَكي اْلحاحَها",26,"ح",3,0],["وأفدى يوم أقتحِمُ المنايا","بأهلي كلِّهِم وأبي ومالي",27,"ل",2,0],["وَأَفِدهُ إِنِّى مُولَعٌ بِجَنَابِهِ","وَالقَلبُ مَجرُوحٌ لَدَيهِ جُرَاحَا",28,"ح",2,0],["وافدٌ لو أبذل النَّفسَ فيهِ","لَم أوفِّ حَقِّ تِلكَ الوفادة",29,"د",2,0],["وأفدت ما نفحاته","تشفي غليل المستفيد",30,"د",1,0],["وأفدتني ثمر المنى من باسق","ريان سبط الظل جعد المغرس",31,"س",1,0],["وأفده أن الدين حب نظافة","وتشبث الأوساخ مُفْضٍ للجرب",32,"ب",1,0],["وافديه والسهم المثلث محتوٍ","على القلب مسموماً فراح يجدل",33,"ل",1,0],["وافدنة وأملاك","يقول بها فخار أبي",34,"ب",2,0],["وأفديكم ُ بالروح وهي جميلكم","عليَّ ويفديكم طريفُ وتالدُ",35,"د",1,0],["وافدى كلما أشفقتهم","وجن الورد وأدنيها اشتماما",36,"م",2,0],["وافدي له قلبًا أحبك ساعة","قسما بهذا الحب إنك فيه",37,"ي",2,0],["وأفدتنا أن الكريم خلا عن ال","أصحاب والأزواج والأبناء",38,"ا",2,0],["وأفداه يوم الغار طوعا بنفسه","وأوساه بالأموال حتى تجردا",39,"د",2,0],["وأفدى رسول الله حقا بنفسه","عشية لما بالفراش توسدا",39,"د",2,0],["وأفديك بالدمِ يا اْبنَ الحلالْ","فؤادي عليك لظىً في اشتعالْ",40,"ل",1,0]]}