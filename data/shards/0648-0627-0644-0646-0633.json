{"poems":[[55,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[65,"الناس من خولي والدهر من خدمي","https://www.aldiwan.net/poem45927.html","البسيط"],[3,"دع ما مضى لك في الزمان الأول","https://www.aldiwan.net/poem196.html",""],[74,"قدم الحبيب من السفر","https://www.aldiwan.net/poem18729.html","مجزوء الكامل"],[74,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[93,"بأبي خيال لاح لي متلففا","https://www.aldiwan.net/poem62779.html","عموديه"],[87,"قم ناد أنقرة وقل يهنيك","https://www.aldiwan.net/poem63757.html","الكامل"],[54,"لما ظننت فراقهم لم أرقد","https://www.aldiwan.net/poem27130.html","الكامل"],[48,"ماءنا بالواغل يوما على ال","https://www.aldiwan.net/poem22868.html","السريع"],[48,"لقد فنيت وهل تبقى إذا عمرت","https://www.aldiwan.net/poem23055.html","البسيط"],[48,"يا صاح ماأهوى وما أقلي","https://www.aldiwan.net/poem23257.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147493","السريع"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142019","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[100,"قلت أهواك يا ملاكي","https://www.poetsgate.com/ViewPoem.aspx?id=55313",""],[146,"إحدى الكواعب من بنى نصر","https://www.aldiwan.net/poem58404.html","أحذ الكامل"],[173,"حطوا الرحال فقد أودى بها الرحل","https://www.aldiwan.net/poem1661.html",""],[202,"بيني وبين الحادثات خصام","https://www.aldiwan.net/poem51882.html","الكامل"],[214,"عاطنيها ذوب تبر","https://www.aldiwan.net/poem13366.html","مجزوء الرمل"],[287,"فك أسري طيف لعلوة أسرى","https://www.aldiwan.net/poem32769.html","الخفيف"],[295,"يا ليالينا بوادي السلط قد","https://www.aldiwan.net/poem11711.html","الرمل"],[333,"هات قيثارك يا شاعر","https://www.aldiwan.net/poem55055.html","مجزوء الرمل"],[347,"مرقص ضاحك يحف به البشر","https://www.aldiwan.net/poem55323.html","الخفيف"],[347,"مرحبا بالربيع يختال بشرا","https://www.aldiwan.net/poem55328.html","الخفيف"],[347,"يا لقلبي من ذكريات الأماني","https://www.aldiwan.net/poem55330.html","الخفيف"],[347,"يا شعاع الصباح","https://www.aldiwan.net/poem55362.html","مجزوء الخفيف"],[347,"الضحايا معناهم الشهداء","https://www.aldiwan.net/poem55366.html","الخفيف"],[347,"دمعة حرى على وطن","https://www.aldiwan.net/poem55385.html","المديد"],[463,"خدع الزمان مودة من ثائر","https://www.aldiwan.net/poem56205.html","الكامل"],[484,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[510,"العار","https://www.aldiwan.net/poem42463.html","البسيط"],[563,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[563,"بالأجرع من جهات ذاك الوادي","https://www.aldiwan.net/poem34646.html","الدوبيت"],[572,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138379",""],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44585","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77596","الرجز"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203791","الخفيف"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203709","الكامل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216712",""],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56694","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118102","الكامل"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82274","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93124","الرمل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101566","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141278","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101049","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66270","الرجز"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77202","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28495","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106856","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87328","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87325","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87315","الرجز"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137385",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75932","الخفيف"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65952","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205855","الخفيف"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124670","السريع"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140090",""],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140088",""],[3049,"","https://poetry.dctabudhabi.ae/diwan/poem/102041","الكامل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101607","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101629","السريع"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101614","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132689","الرمل"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110021","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91770","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36772","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131277",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131029",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66574","الرمل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66591","الخفيف"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86537","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135442","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29312","الخفيف"],[4755,"الغُوْلُ, والعَنْقاءُ, والتِّنِّينُ","https://www.poetsgate.com/ViewPoem.aspx?id=184098",""],[4832,"ورد بخدك أم دم مطلول","https://www.poetsgate.com/ViewPoem.aspx?id=166708",""],[4927,"ضياع الأمل في المعرة","https://www.poetsgate.com/ViewPoem.aspx?id=30182",""],[5072,"زمن","https://www.poetsgate.com/ViewPoem.aspx?id=34351",""],[5186,"روعة الشعر من لحاظ الزهور","https://www.poetsgate.com/ViewPoem.aspx?id=156484",""],[5273,"القوام يأتلق","https://www.poetsgate.com/ViewPoem.aspx?id=181461",""],[5461,"السما وردي","https://www.poetsgate.com/ViewPoem.aspx?id=9512",""],[5596,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=206694",""],[5642,"جهرة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=125040",""],[5690,"عصرٌ على الإعصار فاق وأزهر","https://www.poetsgate.com/ViewPoem.aspx?id=172158",""],[5690,"دع عنك تشبيباً بوصف محاجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=172161",""],[5725,"جرح","https://www.poetsgate.com/ViewPoem.aspx?id=180053",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[6142,"يا آية الله هل إلاك من أحدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155713",""],[6237,"عودة إلى الطبيعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77860&r=&rc=2",""]],"verses":[["وَالنَسلُ يَخبُثُ بَعضُهُ","ما كُلُّ ماءٍ لِلطَهورِ",0,"ر",1,0],["وَالنَّسْرُ يَتْبَعُ سَيْفِي حِينَ يَلْحَظُهُ","وَالدَّهْرُ يُنْشِدُ ما يَهْمي بِهِ قَلَمي",1,"م",2,0],["وَالنَسرُ نَحوَ الغَربِ يَرمي نَفسَهُ","فَيَكادُ يَعثُرُ بِالسِماكِ الأَعزَلِ",2,"ل",1,0],["والنسبة العلياء قد","شيدت بأبناءٍ أخر",3,"ر",1,0],["والنسر ينهض بينها بقوادمٍ","لكنهنَّ عن العيان خواف",4,"ف",1,0],["وَالنَسرُ لا يَرضى السُجونَ وَإِن تَكُن","ذَهَباً فَكَيفَ مَحابِسٌ مِن طينِ",5,"ن",1,0],["وَالنَسرُ مَملوكٌ لِسُلطانِ الهَوى","وَوَجَدتُ نَسرَكِ لَيسَ بِالمَملوكِ",6,"ك",1,0],["وَالنَسرُ قَد بَسَطَ الجَناحَ مُحَوِّماً","حَتّى القِيامَةِ طالِباً لَم يَصطَدِ",7,"د",1,0],["وَالنَسلُ فَرشٌ لِهُمومِ الفَتى","وَالعَقلُ مَسلوبٌ مِنَ الفارِشِ",8,"ش",1,0],["وَالنُسكُ لانُسكَ مَوجودٌ فَنَبغِيَهُ","فَعَدِّ عَن فُقَهاءِ اللَفظِ مُرّاقِ",9,"ق",1,0],["وَالنَسلُ أَفضَلُ ما فَعَلتَ بِها","وَإِذا سَعَيتَ لَهُ فَعَن عَقلِ",10,"ل",1,0],["والنسيمُ العليل يدفع وهْناً","زَبَدَ الموج للرُّبى والحزونِ",11,"ن",1,0],["والنسك مثل النجم في بعده","والخلق إن يبلغه ناكص",12,"ص",1,0],["والنسيم الخفيف يلهو بثوبينا","كطفل أهلوه ما هذبوه",13,"و",2,0],["وَالنَسيمُ تَرجَمَ عَن","رَسمِها بِأَذفَرِها",14,"ر",3,0],["والنَّسِيمُ الذِي جَرَى طَيِّبَ النَّشْرِ","جَرَى ذِكْرُهُ به وثَناؤه",15,"ا",3,0],["والنسيم الخفيف يلهو بثوبينا","كطفل أهله ما هذبوه",16,"و",2,0],["والنسرُ قد أعيت قوادمُهُ","والغربُ يجذِبه إلى وكَرِ",17,"ر",1,0],["وَالنَسرُ في الجَوِّ ما يَألُو يَقُولُ لَهُ","لِكُلِّ نَفسٍ وَإِن طالَ المَدى أَجَلُ",18,"ل",1,0],["والنسرُ مقتَنصٌ بأشراكِ الرَّدى","وبناتُ نعشٍ في الدجى أيتام",19,"م",1,0],["والنسيم الرطب يهدي","من شذاه كل عطر",20,"ر",1,0],["وَالنَسيمُ العَليلُ قَد أَيقَظَ البا","ناتِ حَتّى نَفَثنَ مِسكاً وَعِطرا",21,"ر",2,0],["والنسيم الرطب يسري سحراً","حاملاً رجع حديث الحب عنا",22,"ن",2,0],["والنسيم العف رفاف","كأحلام الحسان",23,"ن",1,0],["والنسيم العليل تكمن فيه","قبلات والماء خمر وراح",24,"ح",1,0],["والنسيم العليل يحيي الاماني","باعثاً من مباسم الزهر عطرا",25,"ر",2,0],["والنسيم العليل يسري كروحي","نا لطيفاً في رقة وحنان",26,"ن",1,0],["والنسيم العليل","غادتي داعبيه",27,"ه",1,0],["والنسيم يهب وهو عليل","والسواقي انينها اصداء",28,"ا",2,0],["والنسيم الطلق منتشياً","بأريج الزهر ينعشني",29,"ن",2,0],["والنسبةُ العلياءُ إن هي شَجَّرتْ","زلِقتْ معارجُها بكلِّ مُفاخرِ",30,"ر",1,0],["والنسر سار إلى العلاء كأنما","له بين سكان البروج نصيب",31,"ب",1,0],["والنسوة بينهم قد شخْنَ والرّحمو","ما عاد ينجبُ ذُكراناً، أمُضطربُ؟",32,"ب",1,0],["والنسب الذاتي الذي","جل عن المخلوقين",33,"ن",1,0],["والنسمة حين أقبلت تسعدني","يا نفحة من أحب طاب النادي",34,"ي",1,0],["وَالنَّسْرُ فِي كَبِدِ السَّمَاءِ كَأَنَّهُ","نَسْرٌ يُحَلِّقُ تَارَةً وَيَحُومُ",35,"م",1,0],["والنسل منك سما حجى ومعارفا","كأب فانك عالم وحكيم",36,"م",1,0],["وَالنُسكُ في عَصرِ الصِبا كَأَنَّهُ","مِن قُبحِهِ خَلعُ عِذارٍ في الكِبَرْ",37,"ر",1,0],["وَالنسر في العشِّ أَقامَ أَبَدا","كَذاكَ وَالحلّوف دامَ سرمدا",38,"د",2,0],["والنسيم البليل لفح هجير","وغناء الغرّيد شبه اختناق",39,"ق",1,0],["والنسر إن طالت به أيامه","ما ازداد إلا عزة وتصلبا",40,"ب",2,0],["والنسيم يْزِف هفّات الأريج","في الصباح وفي الرواح وفي الغبوق",41,"ق",1,0],["والنسيم العليل في الرضو يستش","في بلثم الثرى على آثاري",42,"ر",2,0],["والنسخُ ما لبائه رأسٌ وإن","أردتَ تشعيراً فمن وجهٍ زُكِن",43,"ن",1,0],["والنسر سلطان لها لكنه","لم يلقها لدمائها مهدارا",44,"ر",2,0],["وَالنَّسمَ مِثلَ الزَّرعِ آنَ حَصادُهُ","مِنهُ الحَصيدُ وَمِنهُ ما لَم يُحصَدِ",45,"د",1,0],["والنسا أودى بها طول السرى","في الفيافي وهي ربات الحجال",46,"ل",1,0],["والنسر هب إلى العلاءِ كأنه","يبغي المسير مع السحاب الجاري",47,"ر",2,0],["والنسيم العليل عند انبثاق الفجر","يحيي النّفوس بعد الهجوع",48,"ع",1,0],["والنسا ضلّال قفر في مسارحها","هيمٌ من السرح أو غفل من الغنم",49,"م",1,0],["والنسك قد أضحى هشيماً ربعه","من بعده واخيبةَ المرتبع",50,"ع",1,0],["وَالنَسيمُ الَّذي يَهُبُّ عَلَيهِ","مِلكُ آبائِنا صَباً أَم دَبورُ",51,"ر",1,0],["وَالنَّسرُ في أُفُقِ المَغارِبِ رايَةٌ","تَهفو بِعالِيَةِ السِّماكِ الرَّامِحِ",52,"ح",1,0],["والنسمات التي تسير","والظلُّ إمّا تقلصا",53,"ص",2,0],["والنَّسرُ في الطلوعِ يا رُبَّانُ","خَمسٌ بِضيقٍ هُوَّ وَالذُّبَّانُ",54,"ن",1,0],["والنَّسرُ في الطلوعِ والذُّبَّانُ","في آخرِ الليلِ هُمَا ذًبَّانُ",54,"ن",1,0],["والنَّسرُ في طلوعِهِ يزيدُ","ثَلثاً وشامي الشامي المجيدُ",54,"د",1,0],["والنَّسرُ ستٌ والذراعُ أربَعَه","مُقَيَّدَه في الغَربِ عَنكَ فَدَعَه",55,"ه",1,0],["والنَّسرُ في الغروبِ ثمَّ المُحنِث","مستقبلٌ طلوعَهُ لَم يَلبَث",56,"ث",1,0],["والنس نادى لهل الثغر قد سطعت","فيكم شموس العلا والفضل قد زادا",57,"د",2,0],["وَالنِسائي وَمُعجمَ الطَبَراني","ثَم نصفا مِلمُعجمِ الكُبّارِ",58,"ر",1,0],["والنسب الصريح","والعقل الصحيح",59,"ح",1,0],["والنسيم العليل يسري على وج","ه تراب يَضُمٌّ منكم عظاما",60,"م",2,0],["والنسيمُ الولهانُ داعبه الجوُّ","ندّياً فهبَّ رطباً نديّا",61,"ي",2,0],["والنسر اعني واقفا من بعده","قد سار يطلبه بأعلى همة",62,"ه",1,0],["والنسر داع للطيور وليثهم","للوحش ثم الثور للجنسية",63,"ه",1,0],["والنسك والتقوى لقد","كانا له شيماً وعاده",64,"د",2,0],["والنسيم العليل فوق لظى أن","فاسنا ساكب ندى نفثاته",6