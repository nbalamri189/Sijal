{"poems":[[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[37,"عفا السفح من أم الوليد فكبكب","https://www.aldiwan.net/poem39615.html","الطويل"],[32,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[87,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[63,"وساق بحب الكأس أصبح مغرما","https://www.aldiwan.net/poem51408.html","الطويل"],[63,"أسمعتما أن الجبال تضام","https://www.aldiwan.net/poem51425.html","الكامل"],[71,"في دير بيرة دادخين حور","https://www.aldiwan.net/poem28805.html","الكامل"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[111,"هزت العالم أدوار البشر","https://www.poetsgate.com/ViewPoem.aspx?id=105",""],[92,"الوحدة العربية الممزقة","https://www.poetsgate.com/ViewPoem.aspx?id=178953",""],[37,"عفا السَّفحُ من أمِّ الوليدِ فكبكبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20654&r=&rc=8",""],[154,"ألا فاشكروا نعمى الإله يزدكم","https://www.aldiwan.net/poem68580.html","الطويل"],[202,"وساق يحث الكاس وهي كأنما","https://www.aldiwan.net/poem51874.html","الطويل"],[254,"أهمت منك سلمى بانطلاق","https://www.aldiwan.net/poem2100.html","الوافر"],[305,"عوجوا فحيوا أيها السفر","https://www.aldiwan.net/poem45485.html","أحذ الكامل"],[342,"ألا ناديا أظعان ليلى تعرج","https://www.aldiwan.net/poem45434.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122567","الخفيف"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96999","الكامل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67843","الطويل"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96306","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59125","الطويل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19992","المديد"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95563","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113930","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141344","الخفيف"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49571","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87829","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48223","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53205","الكامل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83224","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140036","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74067","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109977","الكامل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125956","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91340","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216614","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89987","الخفيف"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101386","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54419","المنسرح"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94464","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94530","البسيط"],[4578,"تجلَّت فيها شمس النهار على رُمحٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49377",""],[5002,"قطرات النّدى","https://www.poetsgate.com/ViewPoem.aspx?id=202369",""],[5910,"حيِّ الطلولَ ونبِّ عن أخبارِها","https://www.poetsgate.com/ViewPoem.aspx?id=206239",""]],"verses":[["هَضومُ الشِتاءِ إِذا المُرضِعا","تُ جالَت جَبائِرُ أَعضادِها",0,"د",3,0],["هَضيمُ الحَشا رُودُ المَطا بَختَرِية","جَمِيلٌ عَلَيها الأتحَميُّ الممُنَشَّبُ",1,"ب",1,0],["هَضيمَ الحَشى يَثني الذِراعَ ضَجيعُها","عَلى جيدِ عَوجاءِ المُقَلَّدِ مُغزِلِ",2,"ل",1,0],["هِضابُ لُبنانَ مِن مَنعاتِكَ اِضطَرَبَت","كَأَنَّ لُبنانَ مَرمِيٌّ بِزِلزالِ",3,"ل",1,0],["هَضيمُ الحَشا ذُو وَجْنَةٍ عَنْدَمِيَّةٍ","يُريكَ احْمِرارَ الوَرْدِ فِي غَيْرِ حِيِنِهِ",4,"ن",2,0],["هَضَباتُ حِلْمٍ سِحْنَ وهيَ شَواهِقٌ","ومياهُ علمٍ غُصْنَ وهي جُمامُ",5,"م",1,0],["هضباتُهُ منصوبةٌ مرفوعةٌ","حسناً وذيلُ نسيمِهِ مجرورُ",6,"ر",1,0],["هِضابٌ قُمْنَ من لَهَبٍ عليها","دُخانٌ كالجبالِ إذا رُئينا",7,"ن",2,0],["هَضِيمةُ كَشْحٍ مَا بِهَا مِنْ خَلاَعَةٍ","وَيَكْذِبُ مَا فِي مَشْيِهَا مِنْ تخَلُّعِ",8,"ع",1,0],["هضبة الفضل عزيز المحتمى","شانه العدل بما ساء وسر",9,"ر",1,0],["هُضِمت حقوقُ ذوي الحقوق ، وُضيِّعت","تلك العهودُ وخاست الآساد",10,"د",1,0],["هَضِيمُ الحَشا رُودُ المَطا بَخْتَرِيّة","جميلٌ عليها الأتحميُّ المنشَّبُ",11,"ب",1,0],["هِضابُ مُلوكِ الأَرضِ دُكَّت لِبَعثِهِ","وَأَلسُنُهُم لِلذُعرِ لا تَتَفَوَّهُ",12,"ه",1,0],["هضيم الحشا ذو وجنةٍ عَنْدَمِيَّةٍ","تريكَ قِطافَ الوردِ في غير حينه",13,"ن",2,0],["هَضيمُ الكَشحِ ما غُذِيَت بِبُؤسِ","وَلا مَدَّت بِناحِيَةِ الرِباقِ",14,"ق",1,0],["هُضُمٌ إِذا حُبَّ القُتارُ وَهُم","نُصُرُّ إِذا ما اِستُبطِئَ النَصرُ",15,"ر",1,0],["هَضيمُ الحَشا لا يَملَأُ الكَفَّ خَصرُها","وَيُملَأُ مِنها كُلُّ حِجلٍ وَدُملَجِ",16,"ج",1,0],["هضبةِ الحلمِ باقرِ العلمِ بدرِ الت","مِّ شمس النَّهارِ كَبشِ النِّطاح",17,"ح",1,0],["هضب لدى الأهوال جد ثوابت","وإذا دعا المظلوم جد سراع",18,"ع",1,0],["هِضَابٌ قَطَعْنَاهَا إلى نَحْوِ يَثْرِبِ","بِزَوْرَةِ هَادٍ بِالْهُدى خَصَّهُ اللهُ",19,"ه",1,0],["هَضُومٌ لأضيافِ الشتاء كأنما","يَراهُ الحَيا أيتامُهُ وأرامِله",20,"ل",2,0],["هَضِيمَةُ بَحْرِ البُنْدِ أمَّا وِشَاحُها","فَصَادٍ وَأمَّا ردْفُهَا فَهْوَ صَادِرُ",21,"ر",1,0],["هَضَمَ الدُنيا بِنائِلِهِ","وَأَقالَ الدينَ مِن عَثَرِه",22,"ر",2,0],["هضبة المجد زلزلتها المنونُ","فأكبت علي الدموع العيونُ",23,"ن",1,1],["هضبَةَ الخيلِ أسعدي إنّ غَدراً","أن تَضِنّي بعَولَةٍ وانتِحابِ",24,"ب",1,0],["هضبَةَ الخيلِ خبِّرينيَ عنهُم","وأبيني سُقيتِ غُرَّ السحابِ",24,"ب",1,0],["هضبةَ الخيلِ أينَ حيٌّ حِلالٌ","عمَروا منكِ كلَّ مغنىً خَرابِ",24,"ب",1,0],["هضبةَ الخيلِ إنّ عندَكِ خُبراً","لو أرَدتِ الغداةَ ردّ الجوابِ",24,"ب",1,0],["هضبةَ الخيلِ أينَ حيّاكِ أم","ليسَ لما فاتَ أمرهُ من إيابِ",24,"ب",1,0],["هضبات تعلو بها هضبات","مائسات الغصون والأشجار",25,"ر",1,0],["هُضْبُ الإطالةِ فُرْسَانُ المقالةِ","جِنَّانُ البَسَالةِ لا عُزْلٌ ولا كُشُفُ",26,"ف",1,0],["هضبٌ كَأَنَّكَ مِن بَهيِّ رُبوعِها","في جَنَّةٍ قُربَ النُجومِ فساحِ",27,"ح",1,0],["هَضِيمُ الخصر لا قصرٌ","يشين به ولا طولُ",28,"ل",1,0],["هضبات مجدٍ يستطال شمامها","وولات حمد يستطاب شميما",29,"م",2,0],["هَضيمُ الحَشا وَالنارُ بَينَ أَضالِعي","تَأَجَّجُ زَفراً مِن هَلوعٍ كَمُقلِتِ",30,"ت",1,0],["هضابٌ سقتها ديمةُ نبويةُ","ففيها جنى للمنضوي وتنزّهُ",31,"ه",1,0],["هضبُ البَسيطة أَوشكت","من هول يومك أَن تزولا",32,"ل",2,0],["هَضَمَت لكلِّ مَوَاددٍ غذيت بها","فقضيَّةٌ لم تفتقر لقياسِ",33,"س",1,0],["هضيم الكشح فاتنة","كأن حديثها سحر",34,"ر",1,0],["هَضيمةُ مَهوى البندِ حاليةُ الطُلَى","عديمةُ أَمثالٍ بها أَعدمت صَبري",35,"ر",2,0],["هضابُك أم هذي أواذىّ عيلم","وهل فيك من ورد لغير التوهم",36,"م",1,1],["هضبةً فيها نخيل وثمر","وبراكينُ خبا منها الضرام",37,"م",1,0],["هضبة من شهامةٍ ووقارٍ","روضة من فكاهةٍ ومزاحِ",38,"ح",1,0],["هضيم الكشح مقلق ما عليه","بنفسي ذلك الكشح الهضيم",39,"م",1,0],["هضبةُ عزٍّ لولاكَ ما ارتُقيت","وطوْدُ ملكٍ لولاكَ ما فرعا",40,"ع",2,0],["هضيمة كشحٍ فوق كافور رابةٍ","ومنصاتةٌ صدراً مُطهَّمةُ النهدِ",41,"د",1,0],["هضيمة الخصر قد رقَّت وراق بها","محاسنٌ قد سمت عن قدح أضدادِ",42,"د",1,0],["هضيمة كسحٍ قد نشرتُ بحبها","لواء الهوى عن عاذلي طاوي الكشح",43,"ح",1,0],["هضمتني نائبات ٌ","نابها عض التَّأنِّي",44,"ن",2,0],["هضموا حقوقَ الناس ثُمَّ تقلَّبوا","في نعمةٍ تبلى بِبَخْسِ دثارِها",45,"ر",3,0]]}