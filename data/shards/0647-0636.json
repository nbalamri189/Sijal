{"poems":[[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[35,"عفا السفح من أم الوليد فكبكب","https://www.aldiwan.net/poem39615.html","الطويل"],[30,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[85,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[61,"وساق بحب الكأس أصبح مغرما","https://www.aldiwan.net/poem51408.html","الطويل"],[61,"أسمعتما أن الجبال تضام","https://www.aldiwan.net/poem51425.html","الكامل"],[69,"في دير بيرة دادخين حور","https://www.aldiwan.net/poem28805.html","الكامل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[90,"الوحدة العربية الممزقة","https://www.poetsgate.com/ViewPoem.aspx?id=178953",""],[35,"عفا السَّفحُ من أمِّ الوليدِ فكبكبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20654&r=&rc=8",""],[150,"ألا فاشكروا نعمى الإله يزدكم","https://www.aldiwan.net/poem68580.html","الطويل"],[198,"وساق يحث الكاس وهي كأنما","https://www.aldiwan.net/poem51874.html","الطويل"],[249,"أهمت منك سلمى بانطلاق","https://www.aldiwan.net/poem2100.html","الوافر"],[300,"عوجوا فحيوا أيها السفر","https://www.aldiwan.net/poem45485.html","أحذ الكامل"],[337,"ألا ناديا أظعان ليلى تعرج","https://www.aldiwan.net/poem45434.html","الطويل"]],"verses":[["هَضومُ الشِتاءِ إِذا المُرضِعا","تُ جالَت جَبائِرُ أَعضادِها",0,"د",3,0],["هَضيمُ الحَشا رُودُ المَطا بَختَرِية","جَمِيلٌ عَلَيها الأتحَميُّ الممُنَشَّبُ",1,"ب",1,0],["هَضيمَ الحَشى يَثني الذِراعَ ضَجيعُها","عَلى جيدِ عَوجاءِ المُقَلَّدِ مُغزِلِ",2,"ل",1,0],["هِضابُ لُبنانَ مِن مَنعاتِكَ اِضطَرَبَت","كَأَنَّ لُبنانَ مَرمِيٌّ بِزِلزالِ",3,"ل",1,0],["هَضيمُ الحَشا ذُو وَجْنَةٍ عَنْدَمِيَّةٍ","يُريكَ احْمِرارَ الوَرْدِ فِي غَيْرِ حِيِنِهِ",4,"ن",2,0],["هَضَباتُ حِلْمٍ سِحْنَ وهيَ شَواهِقٌ","ومياهُ علمٍ غُصْنَ وهي جُمامُ",5,"م",1,0],["هضباتُهُ منصوبةٌ مرفوعةٌ","حسناً وذيلُ نسيمِهِ مجرورُ",6,"ر",1,0],["هِضابٌ قُمْنَ من لَهَبٍ عليها","دُخانٌ كالجبالِ إذا رُئينا",7,"ن",2,0],["هَضِيمةُ كَشْحٍ مَا بِهَا مِنْ خَلاَعَةٍ","وَيَكْذِبُ مَا فِي مَشْيِهَا مِنْ تخَلُّعِ",8,"ع",1,0],["هُضِمت حقوقُ ذوي الحقوق ، وُضيِّعت","تلك العهودُ وخاست الآساد",9,"د",1,0],["هَضِيمُ الحَشا رُودُ المَطا بَخْتَرِيّة","جميلٌ عليها الأتحميُّ المنشَّبُ",10,"ب",1,0],["هِضابُ مُلوكِ الأَرضِ دُكَّت لِبَعثِهِ","وَأَلسُنُهُم لِلذُعرِ لا تَتَفَوَّهُ",11,"ه",1,0],["هضيم الحشا ذو وجنةٍ عَنْدَمِيَّةٍ","تريكَ قِطافَ الوردِ في غير حينه",12,"ن",2,0],["هَضيمُ الكَشحِ ما غُذِيَت بِبُؤسِ","وَلا مَدَّت بِناحِيَةِ الرِباقِ",13,"ق",1,0],["هُضُمٌ إِذا حُبَّ القُتارُ وَهُم","نُصُرُّ إِذا ما اِستُبطِئَ النَصرُ",14,"ر",1,0],["هَضيمُ الحَشا لا يَملَأُ الكَفَّ خَصرُها","وَيُملَأُ مِنها كُلُّ حِجلٍ وَدُملَجِ",15,"ج",1,0]]}