{"poems":[[55,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[55,"إلا يكن نصلا فغمد نصول","https://www.aldiwan.net/poem29887.html","الكامل"],[65,"سرى البرق والليل يدني خطاه","https://www.aldiwan.net/poem46183.html","المتقارب"],[3,"قف بالمنازل إن شجتك ربوعه","https://www.aldiwan.net/poem175.html",""],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[75,"غمرتني لك الأيادي البيض","https://www.aldiwan.net/poem11926.html","الخفيف"],[95,"ألشرق طال سباته الروحاني","https://www.aldiwan.net/poem11226.html","الكامل"],[23,"منع النوم بالعشاء الهموم","https://www.aldiwan.net/poem21237.html","الخفيف"],[53,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[53,"أرى الحر يجري بره ويدوم","https://www.aldiwan.net/poem66017.html","الطويل"],[53,"خساسة البيهقي والبينِ","https://www.aldiwan.net/poem66485.html","المنسرح"],[93,"كم بين طيات العصور الخاليه","https://www.aldiwan.net/poem62819.html","عموديه"],[47,"تبسم عن واضح ذي أشر","https://www.aldiwan.net/poem63557.html","المتقارب"],[47,"شرط الإنصاف لو قيل اشترت","https://www.aldiwan.net/poem64647.html","الرمل"],[68,"جن الظلام فمذ بدا مبتسما","https://www.aldiwan.net/poem40643.html","الكامل"],[68,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[54,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[78,"والدار بعدهم مقسمة","https://www.aldiwan.net/poem39246.html","أحذ الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54325","الخفيف"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[105,"ملكنا هذه الدنيا قرونا","https://www.poetsgate.com/ViewPoem.aspx?id=1234",""],[53,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[111,"تلك ربوع الحي في سفح النقا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545619",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[119,"من الهوى آه","https://www.aldiwan.net/poem40430.html","عموديه"],[119,"يا غزالا نوعه نوع اسد","https://www.aldiwan.net/poem41127.html","عموديه"],[119,"أنت النبي لا كذب","https://www.aldiwan.net/poem41968.html","مجزوء الرجز"],[133,"فلسطين من غربة موثقة","https://www.aldiwan.net/poem67434.html","المتقارب"],[136,"كثر الملام ولم أك لأواري","https://www.aldiwan.net/poem54647.html","الكامل"],[139,"خذ من لواحظها الحذار","https://www.aldiwan.net/poem49139.html","مجزوء الكامل"],[147,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[147,"طاول بقدرك من علا مقداره","https://www.aldiwan.net/poem11767.html","الكامل"],[147,"إدراك وصفك ليس في الإمكان","https://www.aldiwan.net/poem11827.html","الكامل"],[154,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[164,"بي من فتور المقلة الكحلاء","https://www.aldiwan.net/poem58775.html","الكامل"],[164,"أيامنا بك كلها أعياد","https://www.aldiwan.net/poem58841.html","الكامل"],[164,"كانت أحادا عند غيرك لا ثنا","https://www.aldiwan.net/poem58919.html","الكامل"],[164,"خرقت عوائدها لك الأقدار","https://www.aldiwan.net/poem58921.html","الكامل"],[164,"عيون المها ردى سهامك من نحر","https://www.aldiwan.net/poem58986.html","الطويل"],[164,"لنا ما دنا مما نروم وما شطا","https://www.aldiwan.net/poem59104.html","الطويل"],[203,"لك أن تشا وعلي أن لا أجزعا","https://www.aldiwan.net/poem45648.html","الكامل"],[239,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[239,"أترى تعود لنا كما","https://www.aldiwan.net/poem31737.html","مجزوء الكامل"],[239,"حان إسفار الصباح","https://www.aldiwan.net/poem32120.html","مجزوء الرمل"],[254,"أقبل مثل البدر في تمامه","https://www.aldiwan.net/poem15039.html","الرجز"],[256,"ظبى المواضي وأطراف القنا الذبل","https://www.aldiwan.net/poem1419.html",""],[265,"وان طيفا منك عاود مضجعي","https://www.aldiwan.net/poem38243.html","الكامل"],[279,"من كل رقراق الفرند كأنه","https://www.aldiwan.net/poem25582.html","الكامل"],[286,"أنا بالغزلان وبالغزل","https://www.aldiwan.net/poem32672.html","المتدارك"],[286,"أيامنا بالرقمتين تولت","https://www.aldiwan.net/poem32857.html","الكامل"],[309,"ما بدر وجهك كالبدور إذا اتسق","https://www.aldiwan.net/poem56450.html","الطويل"],[309,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[332,"يا ليل قد طلع الصباح","https://www.aldiwan.net/poem55076.html","مجزوء الكامل"],[365,"با بي غزالا صد عني قسوة","https://www.aldiwan.net/poem68116.html","الكامل"],[368,"وجد الصبا للعاشقين رسولا","https://www.aldiwan.net/poem60791.html","الكامل"],[368,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[375,"نظر الغرام إليه من نظراته","https://www.aldiwan.net/poem56923.html","الكامل"],[381,"دنت العناصر من علائك","https://www.aldiwan.net/poem59306.html","مجزوء الكامل"],[381,"قلب يقلبه النوى","https://www.aldiwan.net/poem59383.html","مجزوء الكامل"],[381,"قالت إليك فقلت طرفي أرمد","https://www.aldiwan.net/poem66873.html","الكامل"],[381,"شمس تسير مشارقا ومغاربا","https://www.aldiwan.net/poem66953.html","الكامل"],[420,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[420,"ما زلت أول مغرم مفتون","https://www.aldiwan.net/poem54126.html","الكامل"],[436,"أشفار جفنك لم تزل","https://www.aldiwan.net/poem12366.html","الكامل"],[436,"عهدي بحيك وهو حي عامر","https://www.aldiwan.net/poem12398.html","الكامل"],[436,"وعد الزيارة ثم أخلف","https://www.aldiwan.net/poem12675.html","مجزوء الكامل"],[443,"أهلا بمن نصر الإله وأيدا","https://www.aldiwan.net/poem34795.html","الكامل"],[443,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[461,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[461,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[461,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[461,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[467,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[482,"قالوا هي الخضراء أرض فلاحة","https://www.aldiwan.net/poem37186.html","الكامل"],[482,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[517,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[518,"في مثل ذا الموقف المشهود تحتلب","https://www.aldiwan.net/poem12012.html","البسيط"],[541,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[561,"نحن عن شمس أمره كالشعاع","https://www.aldiwan.net/poem34395.html","الخفيف"],[570,"اسلمي يا كثيرة الإعراض","https://www.aldiwan.net/poem69588.html","الخفيف"],[570,"سل بي وبالأيام تعرف","https://www.aldiwan.net/poem69589.html","مجزوء الكامل"],[1047,"","https://poetry.dctabudhabi.ae/diwan/poem/29394","الوافر"]],"verses":[["وَسَطا بِأَيّامي فَقَد","جُعِلَت عَرائِكُها تَلينُ",0,"ن",1,0],["وَسَطا عَلى أَبناءِ قَيصَرَ سَطوَةً","أَمَماً فَأَجلَت عَن دَمٍ مَطلولِ",1,"ل",1,0],["وسَطْوَةُ ذي لَبِدٍ في العَري","نِ مَنْضوحَةٍ بنَجيعٍ سُطاهْ",2,"ا",2,0],["وَسَطَت بِسَيفي في النُفوسِ مُبيدَةً","مَن لا يُجيبُ مَقالَها وَيُطيعُها",3,"ع",3,0],["وَسطَ المُشَقَّرِ في عَيطاءَ مُظلِمَةٍ","لا يَستَطيعونَ فيها ثَمَّ مُمتَنَعا",4,"ع",2,0],["وَسطَها دُميَةٌ يَروقُ اِجتِلاءُ ال","كُلِّ مِنها وَيَفتِنُ التَبعيضُ",5,"ض",1,0],["وَسَطَا جَديدُ نِظَامهِ بِقَدِيمهِ","وَرَمَى الجُمُودَ بِصَاعِقِ النِّيَرَانِ",6,"ن",1,0],["وَسَطَت نِسبَتي الذَوائِبَ مِنهُم","كُلُّ دارٍ فيها أَبٌ لي عَظيمُ",7,"م",1,0],["وسط رياض دنا الربيع لها","فحاك أبرادها ونشَّرها",8,"ر",3,0],["وسَطتَ القرومَ الصّيدَ من آل مرثدٍ","وما مثلهم فيما عَلمتُ قُرومُ",9,"م",1,0],["وسَّطه مجلسُ الأمير وأح","ياهُ وقد مات مِيتة الدَّين",10,"ن",1,0],["وَسَطَوا فَأَسقَطَتِ العُروشُِ مُلوكَها","رُعباً وَأَجفَلَتِ الصُروحُ العالِيَه",11,"ي",2,0],["وَسَطوٌ ثَبَتَّ بِهِ قائِماً","عَلى كاهِلِ المُلكِ حَتّى اِستَقَر",12,"ر",1,0],["وَسَطُ الإِخوانِ لا يَدخُلُ لي","في حِسابٍ وَأَخو الدونِ الوَسَط",13,"ط",1,0],["وَسَطا الضِياءُ عَلى الظَلامِ وَحَبَّذا","لَو يُفتَدى وَلَهُ النُفوسُ فِداءُ",14,"ا",2,0],["وَسَطا عَلى الأَرماحِ وَهوَ رَبيبُها","وَأَليفُها في الغابِ عِندَ نَباتِها",15,"ت",3,0],["وَسَطَ غابٍ وَأَيكَةٍ يَتَغَنّى","فَوقَ أَغصانِ أَيكِها القُمرِيُّ",16,"ي",1,0],["وسطورِ آناءٍ بعَقْوتِها","مَحْنوَّةٍ كأهلَّةِ المَحْقِ",17,"ق",1,0],["وَسطا وجدَّل واحداً بقناته","وأَطار بالصمصام رأس الثاني",18,"ن",2,0],["وسطا بين ممعن في وقوف","عند ماض وممعن في مضيّ",19,"ي",1,0],["وسطوة من ظالم شباته","اقتل الاسلام من حد الظبى",20,"ا",1,0],["وسطرنا صحائف من ضياء","فما نسى الزمان ولا نسينا",21,"ن",2,0],["وَسَطُ القدرِ لم يكبر لجرَّع","متوالٍ ولم يُصغِّر لرِشف",22,"ف",1,0],["وسطوة من ظالم شباته","اقتل للاسلام من حد الظبى",23,"ا",1,0],["وَسطَهُ كَاليَراعِ أَو سُرُجِ المجد","دل حيناً يَخبو وَحيناً يُنيرُ",24,"ر",1,0],["وسطر اشواق","منه قراناه",25,"ا",2,0],["وسطا ليثا فقلنا خشية","يا علي يا اسد الله المدد",26,"د",1,0],["وسطر علم سره","في لوح تظيم كتب",27,"ب",1,0],["وسَطَّرتِ آياته في الخُلودِ","بأرواحِ أبنائكِ المُزهَقة",28,"ق",2,0],["وسطت على خطراته غفلاتُه","فغدا خبيث النطق والإضمار",29,"ر",1,0],["وسَطت عليّ بمرهفا","تِ لا يفلّ لها غبارْ",30,"ر",1,0],["وَسُطاً وَصَفحاً فَالمَمالِكُ قَد عَنَت","مِن خَوفِ بَأسِكَ وَالجَرائِمُ توهَبُ",31,"ب",1,0],["وَسَطا فَما جَرَّ اِغتِرارُ وَلِيِّهِ","ضَرَراً وَلا نَفَعَ العَدُوَّ حِذارُهُ",32,"ر",2,0],["وَسُطاكَ تَأبى أَن تَفوزَ قِداحُهُ","حَتّى يَفوزَ لَدَيكَ بِالغُفرانِ",33,"ن",1,0],["وسطوت بالأذفنش سطوة واثق","في أمره بالواحد القيام",34,"م",1,0],["وسطا ومازج بأسه بسخائهِ","فلديهِ كم من شدةٍ ورخاءِ",35,"ا",2,0],["وسطاً باعداء لو اتفقت لهم","أو بعضها بردت بها الاكبادُ",36,"د",1,0],["وسطاً تكفكفها وحلماً واسعاً","للمذنبين وعفةً وتدُّينا",37,"ن",2,0],["وسطاً لها خضع الملوك يرونها","كالموتِ ما فيه عليهم عارُ",38,"ر",1,0],["وسطوته تشى ونعماه ترتجى","وفي يده ماشا من النفع والضرر",39,"ر",1,0],["وسطرت أعذاراً أتين سقيمة","فأخجلت في تسطيرها الطرس والخطا",40,"ط",2,0],["وسطا على الشعرِ الزمانُ وغالهُ","فحفظتَ ما غالَ الزمانُ وضيعا",41,"ع",2,0],["وَسَطَت جائِزَةً في حُكمِها","سورَةُ الخَمرِ عَلى نَدمانِها",42,"ن",3,0],["وَسَطا عَلى بَهرامَ جو","رَوَأَزدَشيرَ العادِلَينِ",43,"ن",1,0],["وَسُطىً في فَأفَةٍ تَم","زُجُ بَأساً بِسَماحِ",44,"ح",1,0],["وسَطوَةٌ لو نظر اللَّيثُ لها","لأعمَلَ الحِيلة في إحجامهِ",45,"م",2,0],["وسطَ العِدى وَحدَه ثبت الجِنان وَقَد","طارَت قُلوبٌ عَلى بُعدٍ مِن الوَهَلِ",46,"ل",1,0],["وسطا فحاولت الأعادي ردعه","والليث عن سطواته لم يردع",47,"ع",1,0],["وُسْطى قِلادَتِهمْ وزهرةُ رَوْضِهم","وأحَقُّ منْ حُبِي الجَسيم وقُلِّدا",48,"د",2,0],["وَسَطا التَأييدُ بِأَظفارٍ","حُجنٍ وَبِأَنيابٍ عُصُلِ",49,"ل",1,0],["وَسَطَت عَلى دُهمِ الشَبابِ مُغيرَةً","في لِمَّتي شُهبُ المَشيبِ فَوَلَّتِ",50,"ت",1,0],["وَسَط النوى وَسط الجَوى كَبدي كوى","حقّاً غَوى باغي السوى والعمدُ حُق",51,"ق",1,0],["وَسطوٌ تغضّ البيضُ منه جُفونَها","وَتزوي ظلالَ السمرِ مِن بَأسِهِ رعبا",52,"ب",2,0],["وسطا السقام على البقي","يَة من ضياء شبابيه",53,"ي",2,0],["وَسطا عَلَيّ بِصارِم من لَحظِه","من مُنصِفي مِن لَحظه من مسعدي",54,"د",2,0],["وسَطا فما ينفَكُّ طَرْفُ عُداتِه","بظُباهُ أو بخَيالها مَكْحولا",55,"ل",2,0],["وسْطَ الدّماء حائرُ سَوادُه","ممّا بكَى يُديرُ عينَ أرمَد",56,"د",1,0],["وسَطا الزَّمانُ علَيه لا جَهلاً بهِ","لكن سَطا إذ خافَ من سَطَواتِهِ",57,"ت",2,0],["وسطت عليه الموبقا","تُ فأخَّرته عن فِنائك",58,"ك",1,0],["وسطت فأيدت الكنا","ئسَ ثم سكانَ المحابس",59,"س",1,0],["وسطوا على الجن الطغاة فما انثنوا","حتى انثنى الشيطان وهومقيّد",60,"د",1,0],["وسطت مناصلُها فمن لا يحتمي","بحمى معاقلِها ومن لا يُنجِد",60,"د",1,0],["وسطوا ببأس ثلَّ ركنَ جهنمٍ","حتى غدا المنهوب فيهم ناهبا",61,"ب",2,0],["وَسَطَتْ في الخصم حتَّى أنَّها","فتَكَتْ فتكَ القنا في مهجة الخصم",62,"م",1,0],["وسطت عليك جفونها بصوارمٍ","ما أُغْمِدَتْ أمثالها بجفون",63,"ن",1,0],["وسطاك يشهد يا علي","بأَن جفنك ذو الفقار",64,"ر",1,0],["وسطا عليَّ البُعْدُ بَعْدَكِ بالضنا","فأَذَابَنِي لولا الخيالُ الزائرُ",65,"ر",1,0],["وسَطا عليّ وظنّ أنّ","الدمعَ من عينيهِ يذْرِفْ",66,"ف",1,0],["وسطا عَلَى الأَعداءِ حَتَّى لاغتدَتْ","عَنْقَاءُ مُغْرِبُ فِي البلادِ منَ العِدى",67,"د",2,0],["وسَطَا الرَّغَامُ بأَنْفِهِ ولطالما","غَادى أُن