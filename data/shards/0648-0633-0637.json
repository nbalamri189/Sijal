{"poems":[[53,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[53,"إلا يكن نصلا فغمد نصول","https://www.aldiwan.net/poem29887.html","الكامل"],[63,"سرى البرق والليل يدني خطاه","https://www.aldiwan.net/poem46183.html","المتقارب"],[3,"قف بالمنازل إن شجتك ربوعه","https://www.aldiwan.net/poem175.html",""],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[73,"غمرتني لك الأيادي البيض","https://www.aldiwan.net/poem11926.html","الخفيف"],[93,"ألشرق طال سباته الروحاني","https://www.aldiwan.net/poem11226.html","الكامل"],[23,"منع النوم بالعشاء الهموم","https://www.aldiwan.net/poem21237.html","الخفيف"],[51,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[51,"أرى الحر يجري بره ويدوم","https://www.aldiwan.net/poem66017.html","الطويل"],[51,"خساسة البيهقي والبينِ","https://www.aldiwan.net/poem66485.html","المنسرح"],[91,"كم بين طيات العصور الخاليه","https://www.aldiwan.net/poem62819.html","عموديه"],[45,"تبسم عن واضح ذي أشر","https://www.aldiwan.net/poem63557.html","المتقارب"],[45,"شرط الإنصاف لو قيل اشترت","https://www.aldiwan.net/poem64647.html","الرمل"],[66,"جن الظلام فمذ بدا مبتسما","https://www.aldiwan.net/poem40643.html","الكامل"],[66,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[52,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[76,"والدار بعدهم مقسمة","https://www.aldiwan.net/poem39246.html","أحذ الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54325","الخفيف"],[103,"ملكنا هذه الدنيا قرونا","https://www.poetsgate.com/ViewPoem.aspx?id=1234",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[113,"من الهوى آه","https://www.aldiwan.net/poem40430.html","عموديه"],[113,"يا غزالا نوعه نوع اسد","https://www.aldiwan.net/poem41127.html","عموديه"],[113,"أنت النبي لا كذب","https://www.aldiwan.net/poem41968.html","مجزوء الرجز"],[127,"فلسطين من غربة موثقة","https://www.aldiwan.net/poem67434.html","المتقارب"],[130,"كثر الملام ولم أك لأواري","https://www.aldiwan.net/poem54647.html","الكامل"],[133,"خذ من لواحظها الحذار","https://www.aldiwan.net/poem49139.html","مجزوء الكامل"],[141,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[141,"طاول بقدرك من علا مقداره","https://www.aldiwan.net/poem11767.html","الكامل"],[141,"إدراك وصفك ليس في الإمكان","https://www.aldiwan.net/poem11827.html","الكامل"],[148,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[158,"بي من فتور المقلة الكحلاء","https://www.aldiwan.net/poem58775.html","الكامل"],[158,"أيامنا بك كلها أعياد","https://www.aldiwan.net/poem58841.html","الكامل"],[158,"كانت أحادا عند غيرك لا ثنا","https://www.aldiwan.net/poem58919.html","الكامل"],[158,"خرقت عوائدها لك الأقدار","https://www.aldiwan.net/poem58921.html","الكامل"],[158,"عيون المها ردى سهامك من نحر","https://www.aldiwan.net/poem58986.html","الطويل"],[158,"لنا ما دنا مما نروم وما شطا","https://www.aldiwan.net/poem59104.html","الطويل"],[197,"لك أن تشا وعلي أن لا أجزعا","https://www.aldiwan.net/poem45648.html","الكامل"],[233,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[233,"أترى تعود لنا كما","https://www.aldiwan.net/poem31737.html","مجزوء الكامل"],[233,"حان إسفار الصباح","https://www.aldiwan.net/poem32120.html","مجزوء الرمل"],[248,"أقبل مثل البدر في تمامه","https://www.aldiwan.net/poem15039.html","الرجز"],[250,"ظبى المواضي وأطراف القنا الذبل","https://www.aldiwan.net/poem1419.html",""],[259,"وان طيفا منك عاود مضجعي","https://www.aldiwan.net/poem38243.html","الكامل"],[273,"من كل رقراق الفرند كأنه","https://www.aldiwan.net/poem25582.html","الكامل"],[280,"أنا بالغزلان وبالغزل","https://www.aldiwan.net/poem32672.html","المتدارك"],[280,"أيامنا بالرقمتين تولت","https://www.aldiwan.net/poem32857.html","الكامل"],[303,"ما بدر وجهك كالبدور إذا اتسق","https://www.aldiwan.net/poem56450.html","الطويل"],[303,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[326,"يا ليل قد طلع الصباح","https://www.aldiwan.net/poem55076.html","مجزوء الكامل"],[359,"با بي غزالا صد عني قسوة","https://www.aldiwan.net/poem68116.html","الكامل"],[362,"وجد الصبا للعاشقين رسولا","https://www.aldiwan.net/poem60791.html","الكامل"],[362,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[369,"نظر الغرام إليه من نظراته","https://www.aldiwan.net/poem56923.html","الكامل"],[374,"دنت العناصر من علائك","https://www.aldiwan.net/poem59306.html","مجزوء الكامل"],[374,"قلب يقلبه النوى","https://www.aldiwan.net/poem59383.html","مجزوء الكامل"],[374,"قالت إليك فقلت طرفي أرمد","https://www.aldiwan.net/poem66873.html","الكامل"],[374,"شمس تسير مشارقا ومغاربا","https://www.aldiwan.net/poem66953.html","الكامل"],[413,"قام يجلوها وبرد الليل معلم","https://www.aldiwan.net/poem54025.html","الرمل"],[413,"ما زلت أول مغرم مفتون","https://www.aldiwan.net/poem54126.html","الكامل"],[429,"أشفار جفنك لم تزل","https://www.aldiwan.net/poem12366.html","الكامل"],[429,"عهدي بحيك وهو حي عامر","https://www.aldiwan.net/poem12398.html","الكامل"],[429,"وعد الزيارة ثم أخلف","https://www.aldiwan.net/poem12675.html","مجزوء الكامل"],[436,"أهلا بمن نصر الإله وأيدا","https://www.aldiwan.net/poem34795.html","الكامل"],[436,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[456,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[456,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[456,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[456,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[462,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[477,"قالوا هي الخضراء أرض فلاحة","https://www.aldiwan.net/poem37186.html","الكامل"],[477,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[512,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[513,"في مثل ذا الموقف المشهود تحتلب","https://www.aldiwan.net/poem12012.html","البسيط"],[536,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[556,"نحن عن شمس أمره كالشعاع","https://www.aldiwan.net/poem34395.html","الخفيف"],[565,"اسلمي يا كثيرة الإعراض","https://www.aldiwan.net/poem69588.html","الخفيف"],[565,"سل بي وبالأيام تعرف","https://www.aldiwan.net/poem69589.html","مجزوء الكامل"]],"verses":[["وَسَطا بِأَيّامي فَقَد","جُعِلَت عَرائِكُها تَلينُ",0,"ن",1,0],["وَسَطا عَلى أَبناءِ قَيصَرَ سَطوَةً","أَمَماً فَأَجلَت عَن دَمٍ مَطلولِ",1,"ل",1,0],["وسَطْوَةُ ذي لَبِدٍ في العَري","نِ مَنْضوحَةٍ بنَجيعٍ سُطاهْ",2,"ا",2,0],["وَسَطَت بِسَيفي في النُفوسِ مُبيدَةً","مَن لا يُجيبُ مَقالَها وَيُطيعُها",3,"ع",3,0],["وَسطَ المُشَقَّرِ في عَيطاءَ مُظلِمَةٍ","لا يَستَطيعونَ فيها ثَمَّ مُمتَنَعا",4,"ع",2,0],["وَسطَها دُميَةٌ يَروقُ اِجتِلاءُ ال","كُلِّ مِنها وَيَفتِنُ التَبعيضُ",5,"ض",1,0],["وَسَطَا جَديدُ نِظَامهِ بِقَدِيمهِ","وَرَمَى الجُمُودَ بِصَاعِقِ النِّيَرَانِ",6,"ن",1,0],["وَسَطَت نِسبَتي الذَوائِبَ مِنهُم","كُلُّ دارٍ فيها أَبٌ لي عَظيمُ",7,"م",1,0],["وسط رياض دنا الربيع لها","فحاك أبرادها ونشَّرها",8,"ر",3,0],["وسَطتَ القرومَ الصّيدَ من آل مرثدٍ","وما مثلهم فيما عَلمتُ قُرومُ",9,"م",1,0],["وسَّطه مجلسُ الأمير وأح","ياهُ وقد مات مِيتة الدَّين",10,"ن",1,0],["وَسَطَوا فَأَسقَطَتِ العُروشُِ مُلوكَها","رُعباً وَأَجفَلَتِ الصُروحُ العالِيَه",11,"ي",2,0],["وَسَطوٌ ثَبَتَّ بِهِ قائِماً","عَلى كاهِلِ المُلكِ حَتّى اِستَقَر",12,"ر",1,0],["وَسَطُ الإِخوانِ لا يَدخُلُ لي","في حِسابٍ وَأَخو الدونِ الوَسَط",13,"ط",1,0],["وَسَطا الضِياءُ عَلى الظَلامِ وَحَبَّذا","لَو يُفتَدى وَلَهُ النُفوسُ فِداءُ",14,"ا",2,0],["وَسَطا عَلى الأَرماحِ وَهوَ رَبيبُها","وَأَليفُها في الغابِ عِندَ نَباتِها",15,"ت",3,0],["وَسَطَ غابٍ وَأَيكَةٍ يَتَغَنّى","فَوقَ أَغصانِ أَيكِها القُمرِيُّ",16,"ي",1,0],["وسطورِ آناءٍ بعَقْوتِها","مَحْنوَّةٍ كأهلَّةِ المَحْقِ",17,"ق",1,0],["وَسطا وجدَّل واحداً بقناته","وأَطار بالصمصام رأس الثاني",18,"ن",2,0],["وسطا بين ممعن في وقوف","عند ماض وممعن في مضيّ",19,"ي",1,0],["وسطرنا صحائف من ضياء","فما نسى الزمان ولا نسينا",20,"ن",2,0],["وَسَطُ القدرِ لم يكبر لجرَّع","متوالٍ ولم يُصغِّر لرِشف",21,"ف",1,0],["وَسطَهُ كَاليَراعِ أَو سُرُجِ المجد","دل حيناً يَخبو وَحيناً يُنيرُ",22,"ر",1,0],["وسطر اشواق","منه قراناه",23,"ا",2,0],["وسطا ليثا فقلنا خشية","يا علي يا اسد الله المدد",24,"د",1,0],["وسطر علم سره","في لوح تظيم كتب",25,"ب",1,0],["وسَطَّرتِ آياته في الخُلودِ","بأرواحِ أبنائكِ المُزهَقة",26,"ق",2,0],["وسطت على خطراته غفلاتُه","فغدا خبيث النطق والإضمار",27,"ر",1,0],["وسَطت عليّ بمرهفا","تِ لا يفلّ لها غبارْ",28,"ر",1,0],["وَسُطاً وَصَفحاً فَالمَمالِكُ قَد عَنَت","مِن خَوفِ بَأسِكَ وَالجَرائِمُ توهَبُ",29,"ب",1,0],["وَسَطا فَما جَرَّ اِغتِرارُ وَلِيِّهِ","ضَرَراً وَلا نَفَعَ العَدُوَّ حِذارُهُ",30,"ر",2,0],["وَسُطاكَ تَأبى أَن تَفوزَ قِداحُهُ","حَتّى يَفوزَ لَدَيكَ بِالغُفرانِ",31,"ن",1,0],["وسطوت بالأذفنش سطوة واثق","في أمره بالواحد القيام",32,"م",1,0],["وسطا ومازج بأسه بسخائهِ","فلديهِ كم من شدةٍ ورخاءِ",33,"ا",2,0],["وسطاً باعداء لو اتفقت لهم","أو بعضها بردت بها الاكبادُ",34,"د",1,0],["وسطاً تكفكفها وحلماً واسعاً","للمذنبين وعفةً وتدُّينا",35,"ن",2,0],["وسطاً لها خضع الملوك يرونها","كالموتِ ما فيه عليهم عارُ",36,"ر",1,0],["وسطوته تشى ونعماه ترتجى","وفي يده ماشا من النفع والضرر",37,"ر",1,0],["وسطرت أعذاراً أتين سقيمة","فأخجلت في تسطيرها الطرس والخطا",38,"ط",2,0],["وسطا على الشعرِ الزمانُ وغالهُ","فحفظتَ ما غالَ الزمانُ وضيعا",39,"ع",2,0],["وَسَطَت جائِزَةً في حُكمِها","سورَةُ الخَمرِ عَلى نَدمانِها",40,"ن",3,0],["وَسَطا عَلى بَهرامَ جو","رَوَأَزدَشيرَ العادِلَينِ",41,"ن",1,0],["وَسُطىً في فَأفَةٍ تَم","زُجُ بَأساً بِسَماحِ",42,"ح",1,0],["وسَطوَةٌ لو نظر اللَّيثُ لها","لأعمَلَ الحِيلة في إحجامهِ",43,"م",2,0],["وسطَ العِدى وَحدَه ثبت الجِنان وَقَد","طارَت قُلوبٌ عَلى بُعدٍ مِن الوَهَلِ",44,"ل",1,0],["وسطا فحاولت الأعادي ردعه","والليث عن سطواته لم يردع",45,"ع",1,0],["وُسْطى قِلادَتِهمْ وزهرةُ رَوْضِهم","وأحَقُّ منْ حُبِي الجَسيم وقُلِّدا",46,"د",2,0],["وَسَطا التَأييدُ بِأَظفارٍ","حُجنٍ وَبِأَنيابٍ عُصُلِ",47,"ل",1,0],["وَسَطَت عَلى دُهمِ الشَبابِ مُغيرَةً","في لِمَّتي شُهبُ المَشيبِ فَوَلَّتِ",48,"ت",1,0],["وَسَط النوى وَسط الجَوى كَبدي كوى","حقّاً غَوى باغي السوى والعمدُ حُق",49,"ق",1,0],["وَسطوٌ تغضّ البيضُ منه جُفونَها","وَتزوي ظلالَ السمرِ مِن بَأسِهِ رعبا",50,"ب",2,0],["وسطا السقام على البقي","يَة من ضياء شبابيه",51,"ي",2,0],["وَسطا عَلَيّ بِصارِم من لَحظِه","من مُنصِفي مِن لَحظه من مسعدي",52,"ي",1,0],["وسَطا فما ينفَكُّ طَرْفُ عُداتِه","بظُباهُ أو بخَيالها مَكْحولا",53,"ل",2,0],["وسْطَ الدّماء حائرُ سَوادُه","ممّا بكَى يُديرُ عينَ أرمَد",54,"د",1,0],["وسَطا الزَّمانُ علَيه لا جَهلاً بهِ","لكن سَطا إذ خافَ من سَطَواتِهِ",55,"ت",2,0],["وسطت عليه الموبقا","تُ فأخَّرته عن فِنائك",56,"ك",1,0],["وسطت فأيدت الكنا","ئسَ ثم سكانَ المحابس",57,"س",1,0],["وسطوا على الجن الطغاة فما انثنوا","حتى انثنى الشيطان وهومقيّد",58,"د",1,0],["وسطت مناصلُها فمن لا يحتمي","بحمى معاقلِها ومن لا يُنجِد",58,"د",1,0],["وسطوا ببأس ثلَّ ركنَ جهنمٍ","حتى غدا المنهوب فيهم ناهبا",59,"ب",2,0],["وَسَطَتْ في الخصم حتَّى أنَّها","فتَكَتْ فتكَ القنا في مهجة الخصم",60,"م",1,0],["وسطت عليك جفونها بصوارمٍ","ما أُغْمِدَتْ أمثالها بجفون",61,"ن",1,0],["وسطاك يشهد يا علي","بأَن جفنك ذو الفقار",62,"ر",1,0],["وسطا عليَّ البُعْدُ بَعْدَكِ بالضنا","فأَذَابَنِي لولا الخيالُ الزائرُ",63,"ر",1,0],["وسَطا عليّ وظنّ أنّ","الدمعَ من عينيهِ يذْرِفْ",64,"ف",1,0],["وسطا عَلَى الأَعداءِ حَتَّى لاغتدَتْ","عَنْقَاءُ مُغْرِبُ فِي البلادِ منَ العِدى",65,"د",2,0],["وسَطَا الرَّغَامُ بأَنْفِهِ ولطالما","غَادى أُنوفَ الدينِ بالإِرْغَامِ",66,"م",1,0],["وسط السماء وعاد غايةَ تِمِّهِ","فأضاء لا كلفاً ولا ميّالا",67,"ل",2,0],["وُسطاهُ إسماعيلُه","ومدى علاه موفَّقُهْ",68,"ق",2,0],["وسطورُ الأفق قد جلَّلها","أزرقُ الفجرِ فعادت نُقَطا",69,"ط",2,0],["وسطت يمينُ أخيه منه بمثلها","فهُمَا يمينَا قوّةٍ وتآزُرِ",70,"ر",1,0],["وسطا بناظرتي مهاةٍ مغزلٍ","وعطا بسالفتي غزال أتلع",71,"ع",1,0],["وسطت معاولها على أحشائها