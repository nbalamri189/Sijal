مِيْنِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=214225",""],[5997,"جمر في ذاكرة الرماد","https://www.poetsgate.com/ViewPoem.aspx?id=214424",""],[161,"ربيعَا للأمة زَعَمُوا !","https://www.poetsgate.com/ViewPoem.aspx?id=211185",""],[6093,"الشَّيْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=178325",""],[6102,"حسب الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=183652",""],[6115,"ياوجودي وجد من ضيع احذي","https://www.poetsgate.com/ViewPoem.aspx?id=180519",""],[6117,"طَيْبَةُ الطَّيِّبَة","https://www.poetsgate.com/ViewPoem.aspx?id=183710",""],[5014,"مفقودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76222&r=&rc=18",""],[6251,"صديقُ المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76479&r=&rc=19",""],[6300,"كلمات في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82851&r=&rc=22",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""],[6331,"عِتْقُ الحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82075&r=&rc=56",""],[6345,"بلادي الإمارات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78677&r=&rc=48",""],[572,"سَلْ بي وبالأيامِ تعرفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9395&r=&rc=252",""]],"verses":[["وَسَطا بِأَيّامي فَقَد","جُعِلَت عَرائِكُها تَلينُ",0,"ن",1,0],["وَسَطا عَلى أَبناءِ قَيصَرَ سَطوَةً","أَمَماً فَأَجلَت عَن دَمٍ مَطلولِ",1,"ل",1,0],["وسَطْوَةُ ذي لَبِدٍ في العَري","نِ مَنْضوحَةٍ بنَجيعٍ سُطاهْ",2,"ا",2,0],["وَسَطَت بِسَيفي في النُفوسِ مُبيدَةً","مَن لا يُجيبُ مَقالَها وَيُطيعُها",3,"ع",3,0],["وَسطَ المُشَقَّرِ في عَيطاءَ مُظلِمَةٍ","لا يَستَطيعونَ فيها ثَمَّ مُمتَنَعا",4,"ع",2,0],["وَسطَها دُميَةٌ يَروقُ اِجتِلاءُ ال","كُلِّ مِنها وَيَفتِنُ التَبعيضُ",5,"ض",1,0],["وَسَطَا جَديدُ نِظَامهِ بِقَدِيمهِ","وَرَمَى الجُمُودَ بِصَاعِقِ النِّيَرَانِ",6,"ن",1,0],["وَسَطَت نِسبَتي الذَوائِبَ مِنهُم","كُلُّ دارٍ فيها أَبٌ لي عَظيمُ",7,"م",1,0],["وسط رياض دنا الربيع لها","فحاك أبرادها ونشَّرها",8,"ر",3,0],["وسَطتَ القرومَ الصّيدَ من آل مرثدٍ","وما مثلهم فيما عَلمتُ قُرومُ",9,"م",1,0],["وسَّطه مجلسُ الأمير وأح","ياهُ وقد مات مِيتة الدَّين",10,"ن",1,0],["وَسَطَوا فَأَسقَطَتِ العُروشُِ مُلوكَها","رُعباً وَأَجفَلَتِ الصُروحُ العالِيَه",11,"ي",2,0],["وَسَطوٌ ثَبَتَّ بِهِ قائِماً","عَلى كاهِلِ المُلكِ حَتّى اِستَقَر",12,"ر",1,0],["وَسَطُ الإِخوانِ لا يَدخُلُ لي","في حِسابٍ وَأَخو الدونِ الوَسَط",13,"ط",1,0],["وَسَطا الضِياءُ عَلى الظَلامِ وَحَبَّذا","لَو يُفتَدى وَلَهُ النُفوسُ فِداءُ",14,"ا",2,0],["وَسَطا عَلى الأَرماحِ وَهوَ رَبيبُها","وَأَليفُها في الغابِ عِندَ نَباتِها",15,"ت",3,0],["وَسَطَ غابٍ وَأَيكَةٍ يَتَغَنّى","فَوقَ أَغصانِ أَيكِها القُمرِيُّ",16,"ي",1,0],["وسطورِ آناءٍ بعَقْوتِها","مَحْنوَّةٍ كأهلَّةِ المَحْقِ",17,"ق",1,0],["وَسطا وجدَّل واحداً بقناته","وأَطار بالصمصام رأس الثاني",18,"ن",2,0],["وسطا بين ممعن في وقوف","عند ماض وممعن في مضيّ",19,"ي",1,0],["وسطوة من ظالم شباته","اقتل الاسلام من حد الظبى",20,"ا",1,0],["وسطرنا صحائف من ضياء","فما نسى الزمان ولا نسينا",21,"ن",2,0],["وَسَطُ القدرِ لم يكبر لجرَّع","متوالٍ ولم يُصغِّر لرِشف",22,"ف",1,0],["وسطوة من ظالم شباته","اقتل للاسلام من حد الظبى",23,"ا",1,0],["وَسطَهُ كَاليَراعِ أَو سُرُجِ المجد","دل حيناً يَخبو وَحيناً يُنيرُ",24,"ر",1,0],["وسطر اشواق","منه قراناه",25,"ا",2,0],["وسطا ليثا فقلنا خشية","يا علي يا اسد الله المدد",26,"د",1,0],["وسطر علم سره","في لوح تظيم كتب",27,"ب",1,0],["وسَطَّرتِ آياته في الخُلودِ","بأرواحِ أبنائكِ المُزهَقة",28,"ق",2,0],["وسطت على خطراته غفلاتُه","فغدا خبيث النطق والإضمار",29,"ر",1,0],["وسَطت عليّ بمرهفا","تِ لا يفلّ لها غبارْ",30,"ر",1,0],["وَسُطاً وَصَفحاً فَالمَمالِكُ قَد عَنَت","مِن خَوفِ بَأسِكَ وَالجَرائِمُ توهَبُ",31,"ب",1,0],["وَسَطا فَما جَرَّ اِغتِرارُ وَلِيِّهِ","ضَرَراً وَلا نَفَعَ العَدُوَّ حِذارُهُ",32,"ر",2,0],["وَسُطاكَ تَأبى أَن تَفوزَ قِداحُهُ","حَتّى يَفوزَ لَدَيكَ بِالغُفرانِ",33,"ن",1,0],["وسطوت بالأذفنش سطوة واثق","في أمره بالواحد القيام",34,"م",1,0],["وسطا ومازج بأسه بسخائهِ","فلديهِ كم من شدةٍ ورخاءِ",35,"ا",2,0],["وسطاً باعداء لو اتفقت لهم","أو بعضها بردت بها الاكبادُ",36,"د",1,0],["وسطاً تكفكفها وحلماً واسعاً","للمذنبين وعفةً وتدُّينا",37,"ن",2,0],["وسطاً لها خضع الملوك يرونها","كالموتِ ما فيه عليهم عارُ",38,"ر",1,0],["وسطوته تشى ونعماه ترتجى","وفي يده ماشا من النفع والضرر",39,"ر",1,0],["وسطرت أعذاراً أتين سقيمة","فأخجلت في تسطيرها الطرس والخطا",40,"ط",2,0],["وسطا على الشعرِ الزمانُ وغالهُ","فحفظتَ ما غالَ الزمانُ وضيعا",41,"ع",2,0],["وَسَطَت جائِزَةً في حُكمِها","سورَةُ الخَمرِ عَلى نَدمانِها",42,"ن",3,0],["وَسَطا عَلى بَهرامَ جو","رَوَأَزدَشيرَ العادِلَينِ",43,"ن",1,0],["وَسُطىً في فَأفَةٍ تَم","زُجُ بَأساً بِسَماحِ",44,"ح",1,0],["وسَطوَةٌ لو نظر اللَّيثُ لها","لأعمَلَ الحِيلة في إحجامهِ",45,"م",2,0],["وسطَ العِدى وَحدَه ثبت الجِنان وَقَد","طارَت قُلوبٌ عَلى بُعدٍ مِن الوَهَلِ",46,"ل",1,0],["وسطا فحاولت الأعادي ردعه","والليث عن سطواته لم يردع",47,"ع",1,0],["وُسْطى قِلادَتِهمْ وزهرةُ رَوْضِهم","وأحَقُّ منْ حُبِي الجَسيم وقُلِّدا",48,"د",2,0],["وَسَطا التَأييدُ بِأَظفارٍ","حُجنٍ وَبِأَنيابٍ عُصُلِ",49,"ل",1,0],["وَسَطَت عَلى دُهمِ الشَبابِ مُغيرَةً","في لِمَّتي شُهبُ المَشيبِ فَوَلَّتِ",50,"ت",1,0],["وَسَط النوى وَسط الجَوى كَبدي كوى","حقّاً غَوى باغي السوى والعمدُ حُق",51,"ق",1,0],["وَسطوٌ تغضّ البيضُ منه جُفونَها","وَتزوي ظلالَ السمرِ مِن بَأسِهِ رعبا",52,"ب",2,0],["وسطا السقام على البقي","يَة من ضياء شبابيه",53,"ي",2,0],["وَسطا عَلَيّ بِصارِم من لَحظِه","من مُنصِفي مِن لَحظه من مسعدي",54,"د",2,0],["وسَطا فما ينفَكُّ طَرْفُ عُداتِه","بظُباهُ أو بخَيالها مَكْحولا",55,"ل",2,0],["وسْطَ الدّماء حائرُ سَوادُه","ممّا بكَى يُديرُ عينَ أرمَد",56,"د",1,0],["وسَطا الزَّمانُ علَيه لا جَهلاً بهِ","لكن سَطا إذ خافَ من سَطَواتِهِ",57,"ت",2,0],["وسطت عليه الموبقا","تُ فأخَّرته عن فِنائك",58,"ك",1,0],["وسطت فأيدت الكنا","ئسَ ثم سكانَ المحابس",59,"س",1,0],["وسطوا على الجن الطغاة فما انثنوا","حتى انثنى الشيطان وهومقيّد",60,"د",1,0],["وسطت مناصلُها فمن لا يحتمي","بحمى معاقلِها ومن لا يُنجِد",60,"د",1,0],["وسطوا ببأس ثلَّ ركنَ جهنمٍ","حتى غدا المنهوب فيهم ناهبا",61,"ب",2,0],["وَسَطَتْ في الخصم حتَّى أنَّها","فتَكَتْ فتكَ القنا في مهجة الخصم",62,"م",1,0],["وسطت عليك جفونها بصوارمٍ","ما أُغْمِدَتْ أمثالها بجفون",63,"ن",1,0],["وسطاك يشهد يا علي","بأَن جفنك ذو الفقار",64,"ر",1,0],["وسطا عليَّ البُعْدُ بَعْدَكِ بالضنا","فأَذَابَنِي لولا الخيالُ الزائرُ",65,"ر",1,0],["وسَطا عليّ وظنّ أنّ","الدمعَ من عينيهِ يذْرِفْ",66,"ف",1,0],["وسطا عَلَى الأَعداءِ حَتَّى لاغتدَتْ","عَنْقَاءُ مُغْرِبُ فِي البلادِ منَ العِدى",67,"د",2,0],["وسَطَا الرَّغَامُ بأَنْفِهِ ولطالما","غَادى أُنوفَ الدينِ بالإِرْغَامِ",68,"م",1,0],["وسط السماء وعاد غايةَ تِمِّهِ","فأضاء لا كلفاً ولا ميّالا",69,"ل",2,0],["وُسطاهُ إسماعيلُه","ومدى علاه موفَّقُهْ",70,"ق",2,0],["وسطورُ الأفق قد جلَّلها","أزرقُ الفجرِ فعادت نُقَطا",71,"ط",2,0],["وسطت يمينُ أخيه منه بمثلها","فهُمَا يمينَا قوّةٍ وتآزُرِ",72,"ر",1,0],["وسطا بناظرتي مهاةٍ مغزلٍ","وعطا بسالفتي غزال أتلع",73,"ع",1,0],["وسطت معاولها على أحشائها","دون اكتراث سطرة السفاح",74,"ح",1,0],["وسطور تاريخ البلاد شواهد","فينا بضد مقالة الخصماء",75,"ا",2,0],["وسطَتْ على حربِ الرِماح مَعاشِرُ الْ","أغصانِ فاِنتصرَتْ بدولةِ قدِّهِ",76,"د",2,0],["وسطوة لو خلت من عفو مقتدر","على العصاة لكاد الجو يلتهب",77,"ب",1,0],["وسطَ قصرٍ كأنَّمَا خَلَع الحُس","نُ عليه رِداءَه المَجرورا",78,"ر",2,0],["وسطا سطوة الشجاع وهل يق","تحم المعركات غير الشجاع",79,"ع",1,0],["وَسُطُورٍ خَطَطْتُهَا فِي كِتَابٍ","مِثْلَ غَيْمِ السِّحَابَةِ الرَّقْرَاقِ",80,"ق",1,0],["وَسُطُورِ خَطٍّ مُونَقٍ","فِي الطِّرْسِ كَالنُّوْرِ المُفَوَّفْ",81,"ف",1,0],["وَسَطا عَلى الصَبرِ التَفَجُّعِ بالِغاً","سَيلُ الأَسى الطامي ذَرى أَطوادِهِ",82,"د",2,0],["وَسَطا ففرّق جمعَهم","وَبِسيفهِ قد فلّ نظمَه",83,"م",2,0],["وَسَطا عَلَى لَخمٍ وَآلِ مُخَرِّقٍ","فتَخَرَّم النُّعمانَ وَالنَّجُوما",84,"م",2,0],["وسطا على المعنى الجناسُ فلم يزل","ينقاد بين يديه وهو نَفُورُ",85,"ر",1,0],["وَسطَ اللهيب تراهُ","يفترُّ لا يتكدَّر",86,"ر",1,0],["وَسَطا سَطوة الأُسود عَلَيهم","فَاِستجاروا مِن بَأسه وَدَهاه",87,"ا",2,0],["وَسَطا عَلى مَن صَدّ عَن دين الهُدى","فَرماهمُ مِن سَيفه بِثبور",88,"ر",1,0],["وَسَطا عَليّ لَدى النَوى بِصَوارمٍ","مِن لَحظه فَتَكَت بِغَير تَواني",89,"ن",2,0],["وَسَطا عَلَيها بَغتة","وَنَضا الصَوار