{"poems":[[74,"مدمع سائل لغير رحيم","https://www.aldiwan.net/poem19679.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63871","الخفيف"],[1449,"","https://poetry.dctabudhabi.ae/diwan/poem/110682","الرجز"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59480","الرمل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105513","الكامل"],[5307,"برخص الغالي على شانك","https://www.poetsgate.com/ViewPoem.aspx?id=10533",""]],"verses":[["برخيمِ الألفاظ صير حظِّي","مثل حظّ الأسماء بالترخيم",0,"م",1,0],["بِرُّ خِلِّي بِرِّي إِذا حَصْحَصَ الح","قُّ وإِيناسُ صاحبي إيناسي",1,"س",2,0],["برّ خفيف طبعه","سهل وحلمه جبل",2,"ل",1,0],["برخيمِ السوت لو يسمعه","صائمُ الدهر تَصابي وصَعِقْ",3,"ق",1,0],["برخيم لفظ منك أقرأني الجوى","وسقيم لحظ منك صح غرامي",4,"م",2,0],["برخص الغالي على شانك","لا تخلي حاليه حاني",5,"ن",2,0]]}