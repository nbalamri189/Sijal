//www.poetsgate.com/ViewPoem.aspx?id=202129",""],[5358,"نعم يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=27116",""],[5431,"ألا يانارُ بردا فلتكوني","https://www.poetsgate.com/ViewPoem.aspx?id=185983",""],[5431,"لقد ذبح السلام حمائمَه","https://www.poetsgate.com/ViewPoem.aspx?id=186546",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5493,"معراج الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=203377",""],[5574,"صهيل الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=206031",""],[5582,"تَوَلَّى الشَّبابُ وَقَدْ أَدْبَرا","https://www.poetsgate.com/ViewPoem.aspx?id=187104",""],[5582,"سَرَتْ مِنْ بَرْزَخٍ ناءٍ بَعِيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63484",""],[5652,"طفلة العشرين","https://www.poetsgate.com/ViewPoem.aspx?id=137082",""],[4623,"أتسرك الدنيا وعمرك ذاهب ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146604",""],[5809,"ربح","https://www.poetsgate.com/ViewPoem.aspx?id=205337",""],[5956,"أ يصبح أولويّاً في انتشالي","https://www.poetsgate.com/ViewPoem.aspx?id=204460",""],[5956,"عجوزٌ يصف لي جانباً من حياته مع زوجته","https://www.poetsgate.com/ViewPoem.aspx?id=214990",""],[161,"الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=157684",""],[6117,"سطوة الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=183708",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[463,"تظنُّ ليالينا عودا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60026&r=&rc=82",""],[6266,"الحب والسور العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82752&r=&rc=0",""]],"verses":[["وَأَناخوا مُناخَ مَن","لَم يُرَ الدَهرَ سارِيا",0,"ي",2,0],["وإنّ أخا أُمَيّةَ في ذَراهُ","لَكالنَّمَرِيّ جارِ الزِّبْرِقانِ",1,"ن",1,0],["وَإِنَّ أَخاكِ الَّذي تَعلَمينَ","لَيالِيَنا إِذ نَحُلُّ الجِفارا",2,"ر",2,0],["وَإِنَّ أَخْلَقَ مَفْجُوعٍ بِتَعْزِيةٍ","تِلْكَ الَّتِي بَانَ عَنْهَا شَطْرُهَا الثَّانِي",3,"ن",2,0],["وإن اختلاف الآدميين سيرةً","وهم قد سلووا صورة لعجيب",4,"ب",1,0],["وإن اختلافاً منهما وتفرُّقاً","لما خالفت منها الحماش خِدالها",5,"ل",3,0],["وَأَنَّ أَخا الأَحقافِ إِذ يَعذِلونَهُ","يُجاهِدُ في ذاتِ الإِلَهِ وَيَعدِلُ",6,"ل",1,0],["وإنَّ إخلالَه ليَكرُثُهُ","لكنَّ عَوْداً بعينه بركا",7,"ك",2,0],["وَإِن أَخنى عَلَيكَ فَلَم تَجِدهُ","فَنَبتُ الأَرضَ وَالماءُ القَراحُ",8,"ح",1,0],["وأَناخَ بالإِسلامِ خَطْبٌ مَالَه","من بعدِه في المشرقَيْنِ قِيامُ",9,"م",1,0],["وأن أخف ماشياً","تحمل رأسي قدمي",10,"م",2,0],["وَأَنّا خَطَبنا حِسانَ العُلا","وَسُقنا لَها الغالِيَ المُدَّخَر",11,"ر",1,0],["وَإِن أَخَّرتُ عَن مَولايَ سَعيِي","فَإِنّي بِالدُعاءِ لَهُ مُواصِل",12,"ل",1,0],["وَأَناخَت بِظِلِّ أَبلَجَ رَحبِ ال","صَدرِ نَزرِ الأَقرانِ جَمِّ الحَسودِ",13,"د",1,0],["وأناخ الليل فيه وجثم","وجرَت أشباحه في بهوهِ",14,"ه",1,0],["وإن أخا الحزامةِ مَن كَراهُ","كَحَسْوِ مُرَوّعِ الطيرِ الثِّغابا",15,"ب",2,0],["وَأَنّا خَضَعنا لِلمَقاديرِ عَنوَةً","كَما خَضَعَت تَحتَ السُيوفِ رِقابُ",16,"ب",1,0],["وَأَناخَ حَيثُ دُموعُ عَيني مَنهَلٌ","يَروي وَحَيثُ حَشايَ مَوقِدُ نارِ",17,"ر",1,0],["وَإِنَّ أَخاكَ الكارِهَ الوِردَ وارِدٌ","وَإِنَّكَ مَرأى مِن أَخيكَ وَيَسمَعُ",18,"ع",1,1],["وَإِن أَخلَفَت خَفَّ الحَشا لِفَعالِها","نِزاعاً وَاِقشَعَرَّ لَها جِلدي",19,"د",2,0],["وَإِنَّ أَخا نُسكٍ دَعا لَكَ بِالَّذي","مَلَكتَ بِضِدٍّ مِن غِناكَ دَعا لي",20,"ل",2,0],["وَإِنَّ أَخا دُنياكَ أَعمى يَرى السُهى","عَليلٌ مُعافىً ظالِمٌ يَتَظَلَّمُ",21,"م",1,0],["وإن أخلفت خف الحشا لفعالها","نزاع.... واقْشَعَرّ لها جِلْدِي",22,"د",2,0],["وَأَناخوا بِكَ المُنى حينَ أَلفَوا","في يَدَيكَ الآراءَ وَالإِجراءَ",23,"ا",2,0],["وَأَناخَت بِدَولَةٍ عَزَّ فيها","فَكَفاها المُلِمَّ نِعمَ الكافي",24,"ف",2,0],["وإن أخفي اشتياقي في فؤادي","فإنّ الشوق يكتمه الأريب",25,"ب",1,0],["وان أخوف نهج ما خشيت به","ذهاب حرية أو مرتضى عمل",26,"ل",1,0],["وإنّ اِختلافاً للجهاتِ محقّقٌ","فَكَم ذا منَ الأقطار قطرٌ علا قطرا",27,"ر",2,0],["وَإِنَّ أَخاكَ إِن غُيِّبتَ عَنهُ","يَغَصُّ بِنُغبَةِ الماءِ القَراحِ",28,"ح",1,0],["وَإِن اِختَرتَ أَن تَعمَّدَ أَيضاً","فَدُموعي وَقفٌ لِهذا العِمادِ",29,"د",1,0],["وإن اختلاف الناس في الفَضْل بَيِّنٌ","فبعضُهمُ ناسٌ وبعضٌ بَهائم",30,"م",1,0],["وَأَناخَ في آلِ النَبي","يِ مُجاهِراً بِرَزيئَتَينِ",31,"ن",1,0],["وان اخلاء الرجال اوانس","لديك وفي الضراء عنك جوافل",32,"ل",1,0],["وَإن أخالُوا بِدَعوى في مُجَانَسَةٍ","فمن لَهم بلُجيْن يُشبِهُ الذّهَبا",33,"ب",2,0],["وإِن أَخوكَ أَسمَعا","فكن له مُستَمِعا",34,"ع",2,0],["وَإنّ إِخلاص نصّ الذكر تبركمُ","بِهِ صيارفةُ الأيّام قد حَكموا",35,"م",3,0],["وَأَناخ كلكلهُ عَلى ما شيّدوا","فَتدكدكت أطمٌ وَأقوت أربعُ",36,"ع",1,0],["وَإِن أَخلَفَتني الوَعدَ أُجِزُ وَعدَها","وَلَستُ وَإِن خانَت عُهودي أَخونُها",37,"ه",2,0],["وَإِن أَخطَأَتُ في قَولي وَفِعلي","فإِنَّ إِصابَتي بِكَ حُسنُ ظَنّي",38,"ن",2,0],["وإن أَخَّرتْها صُروفُ الزّما","نِ عنكَ وأَصفىَ الشّرابُ العَتيق",39,"ق",1,0],["وَإِنَّ اِخضِرارَ الغُصنِ بَعدَ اِستِلانَةٍ","وَإِنَّ تَمامَ البَدرِ عِندَ مَحاقِهِ",40,"ق",2,1],["وَأَن أَخَذَ المُغَسَّلُ ما نَواهُ","سَماحُكَ لِلطَبيبِ وَلِلخِتانِ",41,"ن",1,0],["وَإِنّا خَلَعنا الكِبرِياءَ مَعَ الصِبا","وَحَسبُكَ ذُلّا أَن يُقالَ كَبيرُ",42,"ر",1,0],["وإن أخَذَت أسيافَها يومَ غارة","فلا ردَّ إلا مِن عِصيِّ الخفائِرِ",43,"ر",1,0],["وإنِ اختصرتُ ولم أُطِلها إنه","سَيطولُ في دار الثناءِ خُلودُها",44,"د",3,0],["وأناخ الزمان بي فرماني","ببلاءٍ فكان داءً دخيلا",45,"ل",2,0],["وإن أخذت عن الأحبار علمهم","فجازهم بجميل الذكر في الأمم",46,"م",1,0],["وإِنْ أَخفى نِداءهُم التَّنائِي","فسمعُكَ منه يُستمعُ النِّداءُ",47,"ا",2,0],["وإِنَّ اختِلاقَ الغدرِ عَنِّي لِحَاسِدٍ","لأَدْنَى لَهُ أَن يَصْبِغَ الشمسَ بالنِّقْسِ",48,"س",1,0],["وإِنَّ أخا غَسّانَ عِندي لَذو يَدٍ","بِكَ ابْتاعَ مِنِّي شُكْرَها غَيْرَ ذِي وَكْسِ",48,"س",1,0],["وإِن أَخصَبَتْ فِي زَرْعِ نعماكَ رَعْيَها","فكَمْ قَدْ تخَطَّتْ وداِياً غَيْرَ ذي زَرْعِ",49,"ع",1,0],["وإن أخا الهوى قرباً وبعداً","لمن يهواه يا ليلى فشاق",50,"ق",1,0],["وأناخ ابن جعفرٍ في مدار ال","قصف والعزف نافياً أكداره",51,"ر",2,0],["وأناخ في مُضَرٍ بكلكلِ خَسْفِهِ","يستامُ واحتملتْ له ما سامَها",52,"م",3,0],["وأَن أخلاقَك ماءُ نُطفةٍ","رقَّت لها الريح صَباً وشَمَلا",53,"ل",2,0],["وإن أخذتَ الدستَ والصدرَ فال","قضاءُ ناهٍ فيهما آمرُ",54,"ر",1,0],["وإن أخذوك أنتَ وخلَّفوني","فسِرْ معهم فذاك لهم يَسيرُ",55,"ر",1,0],["وإن أخلَق الدهرُ ألقابَهم","بما كرّ منها وما ردَّدا",56,"د",2,0],["وإن أخذت منكم شهاباً ففيكم","صواعق هيجاء ومزن نوال",57,"ل",1,0],["وأنّ أخاً ليْ في العراق وفي دمش","قَ نقتسمُ الموتَ لقاءَ بقاها",58,"ا",3,0],["وإن أخذت من وصفها ديةً له","فذلك حكم للقصاص يضارع",59,"ع",1,0],["وأَناخت ركائبُ الهمِّ في قَلْ","بي ولم تَحْتَشِمْ لطول الثَّواءِ",60,"ا",2,0],["وإِن أَخْطَئُوا لم يُخطِئُوا من جهالةٍ","عليكَ ولكن يُخْطِئُون لِتَحلُما",61,"م",2,0],["وإِنْ أَخافَ الفقرُ أَبناءَه","فكم لديهِ مِنْ جَدَا مُجْتَدِ",62,"د",1,0],["وإن أخرجا جعلاً وهذا اختياره","وكان إماماً عالماً بالمسائل",63,"ل",1,0],["وانا خايف من إلفرْقيْا والزمان صْروف","صروف الدهَر لي تَدْعي الشمْل شَتّاني",64,"ن",2,0],["وَإنَّ أَخسَرَ خَلقِ اللهِ كُلِّهِمُ","في البَيعِ مَن باعَ مَحقُوقاً بِمظنُونِ",65,"ن",1,0],["وإن اختفت شمس عن الوادي ضحَى","يومٍ فأنت لكل شمس يوشع",66,"ع",1,0],["وَإِنْ أَخَذَت قَلبي وَإِنّي رقيقُها","فذاكَ لها ملكٌ ولم تكُ تغصبُ",67,"ب",1,0],["وإنْ آخيْتَ في الدنيا صديقا","عدلتَ إلى إهانةِ من تؤاخي",68,"خ",2,0],["وأَنْ أَخيبَ وأُعطَي","صحيفتي مِن ورائي",69,"ا",2,0],["وإن أخذتَ بقولى عشتَ مغتنما","وقد سلكتَ سبيلاً ما به نَزَقُ",70,"ق",1,0],["وإن أخطأت فيما قلت فيه","فإن على تغمدك اعتمادي",71,"د",2,0],["وأناخ ضمره على","عتبات بابك واستمد",72,"د",1,0],["وَإنِ اخْتَفَى عَنْ مُنْكِرِيهِ فَعَاذِرٌ","أنْ لاَ تَرَاهُ مقلةٌ عميَاءُ",73,"ا",2,0],["وأن أخيب ونهج النجح متَّسع","من كلِّ ما كان منكم قبل مأمولا",74,"ل",2,0],["وَإِن أَخَذْنَ عَافِيَ المِنْهاجِ","خَلّاً يَقُدُّ الحَزْنَ ذا الشَراجِ",75,"ج",1,0],["وَإِن أَخفَقتُ كَفّي وَقَد عَلَّقتَكُم","فَقَد قالَ رَأيي وَاِستَنَمتُ إِلى شِعري",76,"ر",2,0],["وَأن أَخلاءَ الزَمان غناؤهُم","قَليل إِذا الانسان زَلّت بِهِ النعل",77,"ل",1,0],["وأناختْ في فنا ملك","دَنتِ الأخطارُ عن خَطَرِهْ",78,"ر",2,0],["وإِنِ اخْتُرِمْتُ فمِيتَةٌ أَرْضَى بها","إِذْ لم أُصادِفْ عيشَةً تُرْضيني",79,"ن",2,0],["وان أخا المعاصي في انحطاط","وذل لا يجاب ولا يجيب",80,"ب",1,0],["واناخوا عيسهم واجتمعوا","بحبيب اللَه مولانا الصمد",81,"د",1,0],["وإن أَخلَفَتها الغادياتُ رُعُودَعا","تُكَلّف تصديقَ الغمامِ دمُوعُها",82,"ع",3,0],["وإِن أَخّر البَّر يوماً لعُذْرِ","رآى ان يُضاعفه بالزيّادَهْ",83,"د",2,0],["وأناخوا بنا فيا لك من يو","م عبوس عصبصب أرونان",84,"ن",1,0],["وإن أخرته عنى فإنى","سأرفعها إلى الملك المفدى",85,"د",2,0],["وإن أخرت مطلوبي فإني","أعززها بثانية أشدا",85,"د",2,0],["وَإنْ أخَّرَ الصَّفْراءَ شَكْوَى سُيُوفِهِم","فَقَدْ قَضَتِ الزَّرْقَاءُ كُلَّ المَآرِبِ",86,"ب",1,0],["وإن أخذ التحقيق فيه بحقّه","وقيل ومن هذا يقولون ساحرُ",87,"ر",1,0],["واناخ فيك من السحاب","الغر مثقلة الحمول",88,"ل",1,0],["وإن أخروها لما بعدها","فقد قدموا الخبط والنفحة",89,"ح",2,0],["وَإِن اِختِلافي نِصفَ حَولَ مجرّم","إِلَيكُم بَني هِندٍ عَلَيَّ عَظيمُ",90,"م",1,0],["وإن أخذوا أقلامهم لكتابة","فأحسن من وشّى الطروس ونمنما",91,"م",2,0],["وَإِن أَخصَبوا بِالطَّعنِ عادوا مِنَ النَّدى","سِراعاً إِلى داعي الخَصاصَةِ وَالعُسرِ",92,"ر",1,0],["وإِناخَةُ الضِيفات فرضٌ عندنا","يلقى به الولْدِانُ كلَّ مُبَشرِ",93,"ر",1,0],["وأناخت عليّ أيُّ جيوش","من هموم غَزَونَ مني السّرورا",94,"ر",2,0],["وان أخرستني هيبة من وقاره","أشارت له كف الثناء لك البشرى",95,"ر",2,0],["وأنا خادم له دون أجر","ليس أجري منه سوى الاجهاد",96,"د",1,0],["وإن أخذت بحقّ ليس ذا خطأ","وإن عفوت ففضلٌ منك تُوليها",97,"ي",3,0],["وأناخ الفساد والفرس جاسوا","بحره خائضين حتى المخانق",98,"ق",1,0],["وانَّ أَخي من لا يَمُلُّ خَليقَتي","ومن لا يَراني قائماً وهو جالسُ",99,"س",1,0],["وإن أخلق العهد الذي كان بيننا","فقلبي طري الذكر فيكم جديده",100,"د",2,0],["وإن اختلفنا في الفروع فذاك عن","خير البرية رحمة المنان",101,"ن",1,0],["وإن أخاً يرضى تهتك أخته","لأحقر من ضبٍ وأهون من كلب",102,"ب",1,0],["وأنا خطيبُ أولي البُلا","غِة إنْ ترامت في المحافلْ",103,"ل",1,0],["وإن أخفت حوادثه بزعم","بيوت الأكرمين فأنت باد",104,"د",1,0],["وَإِن أَخّر الأَقوامَ نَقصٌ تَقَدَّمت","بِهِ رُتبةٌ تَعنو لَها الرُّتَبُ الشمُّ",105,"م",1,0],["وَإِن آخَيتَ ذا أَصلٍ خَبيثٍ","وَساءَكَ في الفِعالِ فَلا تَلمهُ",106,"ه",1,0],["وان اخفى العَدوّ لَكم كَمينا","فان اللَه لَم يَبرح امينا",107,"ن",2,0],["وإنَّ اختلافَ دَعْوى","بني واحدٍ لريبَهْ",108,"ب",2,0],["وَإِن أَخَذَت خَمسهُ لِليَراع","تَرى أَهلَهُ حَولَهُ كالخَوَلِ",109,"ل",1,0],["وإن أخاكمُ في كلِّ يومٍ","من الأيامِ محمَلُهُ ثَقيلُ",110,"ل",1,0],["وإن أخذوا في جانب ملت آخذاً","وإن عدلوا عن جانب ملت عادلا",111,"ل",2,0],["وَإِنَّ أَخي كَالرافِعيِّ وَإِنَّما","مَعانيهِ مِنها ما يَجلُّ وَيَكبُرُ",112,"ر",1,0],["واناخ الغيم من كلكله","جؤجؤا اغدق بالسيل القفارا",113,"ر",2,0],["وإن أخرتني اليوم سنَّ تقدمت","فقد أسلفتني حوز كلّ رهان",114,"ن",1,0],["وإن أَخْفَتِ الأيدي أذيّةَ حَبسها","فإنّ علامات القُيودِ تُجاهرُ",115,"ر",1,0],["وأنا خيالي فاتح لميّ سيرة","وهذي تقول الله يا ليتها فيّ",116,"ي",1,0],["وأنا خفوقي ودود ولي مزاج ملول","أحارب انفاقها واعاشر جسورها",117,"ر",3,0],["وأنا خيالي كل ما هديته ..",".. حول على الوادي وصاد عقابه",118,"ب",2,0],["وانا خويك قلت ماهوب معقول","نسيت ورضيت وقتها من يصفي",119,"ي",1,0],["واِنْ أخطأْتَ لاتخشَ اعتذاراً","فانَّ العُذْرَ يُطفي الحُقْدَ قَطْرُهْ",120,"ر",2,0],["وأنا خفوقي قبل مدّه لعبْها","واليوم ماله بالغنادير مصلوح",121,"ح",1,0],["وأنا خنعت الرأس ذا يوم فشله","ما دام أخوي اليوم غولٍ غدالي",122,"ل",2,0],["وَ أَنَا خَلْفَ اَلسُّورِ،أَسْبِقُ ظِلِّي","بِخُطىً لاَ تَدْرِي اَلْخُطَى،لاَ تَشَاءُ",123,"ا",2,0],["وأنا خايف،،شمل المحبة بعد،،ينفض","رواسيه عاتي،،رايح،،الريح...ينفضها",124,"ض",3,0],["وأنا خايف بطش ألمنيه ،،علي،،يقبض","وعني وصوله ظرف ،، الأيام يقبضها",124,"ض",3,0],["وانا خابرك حر يفاخربك الصقار","لامنه أطلقه يدمي من الصيد مخلابه",125,"ب",2,0],["وانا خلقت من العرب دمنا حار","فينا حرارت دم زايد لقافه",126,"ف",2,0],["وإنْ أخْفيتُ صُورَتَهُ","وعَنكَ حَجَبتُ فَحواها",127,"ا",3,0],["وأنا خلودي فى البرية ساطع","عبر الوجود بريقه المترامي",128,"م",2,0],["وإن اختلافاً للجهات محقق","فكم ذا من الأقطار قطر على قطرا",129,"ر",2,0],["وإن اختلافاً للجهات محقق","نعم حقق الأحبار أخبارها سبرا",129,"ر",2,0],["وإن أخفق الوهم في غزوها","فلن يظفر الوغد بالحورية",130,"ي",2,0],["وإنْ أخذوا مكانَكَ كلّ َ عمري","فعمري والعيونُ لك الفِداءُ",131,"ا",2,0],["وأنّا خير من ضم الحنايا","وأصدقهم وأنداهم جبينا",132,"ن",2,0],["وأنا خيالٌ واهنٌ متمزقٌ","وكأنَّ في دمي الذبيح عمائمَهْ!!",133,"م",2,0],["وأن أخلقت أفعاله وجه عذره","فإنك بالإحسان أولى وأخلق",134,"ق",1,0],["وأناخ جنحَ الحزنِ كيما يصعدُوا","بمسالكِ المعراجِ نحوَ الذاتِ",135,"ت",1,0],["٤- وأناخَ نبضي في الجواءِ كلائذٍ","قد فرَّ من فكِّ المهالكِ والرّدى",136,"د",2,0],["وَإِنْ أَخْلَقَ الخَلْقُ مِنِّي فَما","خَلاقِي لَها دَهْرُها غَيَّرا",137,"ر",2,0],["[ وَإِنْ أَخْفَيْتُ عُذّالِي هَواها","جَرَى دَمْعِي فَكانَ مِنَ الشُّهُودِ ]",138,"د",1,0],["وانا خطير اموت وانتي تشوفين","من بُعدك الي مالقينا محلّه",139,"ل",2,0],["وأنا خديمك احمد الله الذي","هو لي الثناء على مقامك واهب",140,"ب",1,0],["وإن أخَّرتَ في ما نلتَ راءً","فقد أركبتَها موجَ الحتوفِ",141,"ف",1,0],["وإنْ أُخْفقْ فدوماً سوءُ حظي","يصاحبني ولو من بعد دفني..",142,"ن",2,0],["وإنْ أخذنَ فبعد الأخذِ دون حَياً","يَرْجِعْن بعد يعافيرٍ ثعابينا",143,"ن",2,0],["15- وَأَنَاخَ ذُلٌ واسْتَبَاحَ رِيَاضَنَا","وَطَوَى الْمُنَى تَسْقِيكَ سُماًّ كَاسُهُ",144,"س",2,0],["وإنْ أخذتَ دواءً لا تَظُنَّ بِهِ","إشربْ دَوَائِي وعُدْ لِي غُدْوةَ الأَحَدِ",145,"د",1,0],["وَإِن أَخلَفَت بَعضُ الشُّعوبِ وُعودَها","فَإِنَّ وُعودَ العُربِ ضَربٌ مِنَ النَّقدِ",146,"د",1,0],["وإن أخلق الدهرُ ألقابهم","بما كثر منها وما رددا",147,"د",2,0],["وأنا خياليُّ الرؤى، لن تملكي","رئتيَّ إلا إنْ أثرتِ خيالي",148,"ل",2,0]]}