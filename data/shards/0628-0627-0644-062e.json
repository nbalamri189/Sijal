منت إبداعا لديك جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=188840",""],[5281,"تاجُ الوقارِ","https://www.poetsgate.com/ViewPoem.aspx?id=208058",""],[5376,"ما اعتدْتُ بعداً عنك يا أمي","https://www.poetsgate.com/ViewPoem.aspx?id=191870",""],[5376,"نشجتْ بها الحسراتُ حيثُ تفيضُ","https://www.poetsgate.com/ViewPoem.aspx?id=204766",""],[5660,"قِفا أُوَدِّعكُما يا صاحِبايَ قِفا","https://www.poetsgate.com/ViewPoem.aspx?id=23717",""],[5943,"لاتعجبني ياسيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=37263",""],[5943,"صراخ طفلة من غزة","https://www.poetsgate.com/ViewPoem.aspx?id=37375",""],[6056,"ديار الدروزي","https://www.poetsgate.com/ViewPoem.aspx?id=130350",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6280,"طَرَقَتْكَ زَائِرَة ً فَحَيِّ خَيَالَها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27902&r=&rc=57",""]],"verses":[["بِالخَيلِ لا تُعلَفُ إِلّا شَدَّها","أَو مَلقَها بِالبيدِ وَاِندَراعَها",0,"ع",3,0],["بالخَيْلِ مُسْتَبِقاتٍ في أعِنَّتِها","فُرْسانُها الأُسْدُ والخَطّيّةُ الأجَمُ",1,"م",1,0],["بِالخَيلِ شُعثاً ما تَزالُ جِيادُها","رُجُعاً تُغادِرُ بِالطَريقِ سِخالَها",2,"ل",3,0],["بِالخُنَّسِ الكُنَّسِ في سَبحِها","بِالبَدرِ في مَرآهُ بِالشَمسِ",3,"س",1,0],["بِالخَيرِ أَبلَجُ مِن سِقايَةِ راهِبٍ","تُجلى بِمَوزَنَ مُشرِقٌ تِمثالُها",4,"ل",3,0],["بِالخَالِدَاتِ الذِّكْرِ مِنْ أَسْمَائِهَا","وَالخَالِدَاتِ الإِثْرِ مِنْ أَفْعَالِهَا",5,"ل",3,0],["بِالخَيلِ ضُمراً وَالسُيوفِ قَواضِباً","وَالسُمرِ لُدناً وَالرِجالِ عِجالا",6,"ل",2,0],["بالخلعة الزرقاء تتلو الفضة ال","بيضاء ذات الحسن والإحسان",7,"ن",1,0],["بالخيلِ لكن لا تزال صوافناً","والبيضِ لكن لا تزال كوامنا",8,"ن",2,0],["بِالخَيلِ ساهِمَةَ الوُجوهِ كَأَنَّما","خالَطنَ مِن عَمَلِ الوَجيفِ سُلالا",9,"ل",2,0],["بِالخَيلِ تَحمِلُ كُلَّ أَشعَثَ دارِعٍ","وَتُواصِلُ الإِدلاجَ بِالإِسراءِ",10,"ا",2,0],["بالخمر أسقيه وفي مسمعي","إرنانُ باكٍ وتشاكي حبيب",11,"ب",1,0],["بالخَيْلِ جُرداً والسيوف قواضباً","والبزْلِ قُوداً والرماح طوالا",12,"ل",2,0],["بِالخيلِ تَحتَ اللَّيلِ يُسْرَجُ حَولَها","في كُلِّ ذابِلَةٍ سِنانٌ أَزهَرُ",13,"ر",1,0],["بِالخَيلِ فَوقَ مُتونِهِنَّ فَوارِسٌ","مِثلُ الصُقورِ إِذا لَقينَ بُغاثا",14,"ث",2,0],["بِالخَيفِ مَنزِلُها وَمَسكِنُها","وَتَحُلُّ مَكَّةَ إِن شَتَت قَصرا",15,"ر",2,0],["بِالخَيلِ قَد جَفَّت مَبادينُها","وَآلَ مِن حيلَةِ أَجرامِها",16,"م",3,0],["بِالخَيلِ شُعثاً عَلى لَواحِقَ كَال","سيدانِ تُعطي مَدى مَذاهِبِها",17,"ب",3,0],["بِالخُلفِ قامَ عَمودُ الدينِ طائِفَةٌ","تَبني الصُروحَ وَأُخرى تَحفُرُ القُلُبا",18,"ب",2,0],["بِالخَلايا أتاكَ مِن أَهلِ غَرسا","نَ بجُندٍ مُجَمَّرٍ بِأَزالِ",19,"ل",1,0],["بالْخَلْقِ تُشْرِقُ نُوراً","وَالخُلْقِ تَعْبَقُ نَدَّا",20,"د",2,0],["بالخلد عن هذي الحياة تصبراً","يُغنى وعن أكدارها بصفائه",21,"ا",3,0],["بالخَلِّ تقتسِمُ الرياحُ تُرابَها","تسقي عليها مِن صَباً وشَمائلِ",22,"ل",1,0],["بِالخَمرِ بَل بِزُجاجَةِ","الكَأسِ الَّتي لا تُثمِلُ",23,"ل",1,0],["بالخير لم تأمر ولا الهدايهْ","بل لسلوك طرق الغوايهْ",24,"ه",1,0],["بالخير في أَغواره وَنجوده","فالخلق تَرعى ريف رآفة جوده",25,"ه",1,0],["بِالخَضرِ اِخضَرَّت رِياضُ العَيشِ وَاخ","ضَلَّت فَفاضَت بَركاتٌ وَبِرَك",26,"ك",1,0],["بِالخَوفِ أَقبَلَ أَقواهُم يَهرَكُما","بِالخَوفِ أَدبَرَ صَوتُ الهِرِّ يَبهَتُهُ",27,"ت",2,0],["بِالخطّ وافرُ حَظّه","حكماً أَبانَ فَأَحكَما",28,"م",2,0],["بالخلادات الذكر من أسمائها","والخالدات الإثر من أفعالها",29,"ل",3,0],["بالخيلِ يحملُ من فرسانِها أَسداً","والأُسْدِ يحملُ من أَرماحِها أَجَمَا",30,"م",2,0],["بالخيف وما أدراك بالخيف هوى","لو رام سواه القلب لم يلف سوى",31,"س",3,1],["بالخَيْفِ مُخطَفَةُ الحشا","تهوَى الغصونُ لها القدودا",32,"د",2,1],["بالخضر من أظلالها والحمر من","أموالها والغرّ من جفناتها",33,"ت",3,0],["بِالخَيفِ مِن مَكَةَ ناساً نُوَّما","فَأَرّقا عيساً وَشُعثاً سُهَّما",34,"م",2,0],["بِالخَيلِ وَالرَجلِ وَالزُهاءِ تُرى","تَخفِقُ أَوساطَ غابِهِ الخِرَقُ",35,"ق",1,0],["بالخير تم الصوم اذ شوال","بسعوده قد هلّ منه هلال",36,"ل",1,1],["بالخير قابل كل شر تابعا","أقوال عيسى من لنا أوصى بذا",37,"ذ",2,0],["بِالخاذِلِ المدعوّ ضدَّ فعاله","بِالناصرِ المُتَناقِض الآساسِ",38,"س",1,0],["بِآلِ خَيرِ المُرسَلينْ","وَصَحبِهِ أَهلِ اليَمينْ",39,"ن",1,0],["بالخسفِ ترمي ديارُ الأنِف","عدمت حياتي إذا لم أقف",40,"ف",1,0],["ب الخلوف النظمُ في الأفْقِ الرَّفِيعْ","وَبِهِ قَدْ صَارَ فِي أعْلَى الرُّتَبْ",41,"ب",1,0],["بِالخَطِّ نُظِّمَ كُلُّ مُنتَثِرٍ","مِنها وَفُصِّلَ كُلُّ مُنتَظِمِ",42,"م",1,0],["بِالخَيفِ مِنها لِلهَوى مَعرَكٌ","تَلقى بِهِ الصَبرَ هَزيمَ الفَريق",43,"ق",1,0],["بِالخَلق وَالخَلقِ ارّخ أَنَّهُ قَمَرٌ","زاهٍ أَغَرٌّ وَديعٌ جَلَّ مِن جَبلَه",44,"ل",2,0],["بِالخَير بِاليَمَنِ بِالإِسعادِ بِالظَفَر","بِحفظِ رَبّكَ سر يا مُنعش البَشَرِ",45,"ر",1,1],["بالخسف وَالقَذف وَالحَريق وَبال","حرب الَّتي أَصبحت تساورها",46,"ر",3,0],["بالخفّ تَضْرِب كِلّ قاعٍ وجَلْمود","من زود باسٍ صار في الراس وِعْناد",47,"د",1,0],["بالخصورِ الهيفِ ضعفاً وانهضاماً","ولكاسِيكَ الوشاحَ المُذهبا",48,"ب",2,0],["بالخمر في أَكوابها","من خوض طه يغترف",49,"ف",1,0],["بِالخَمرُ في لَفَتاتِها وَالخَمرُ في","خَطَراتِها وَالخَمرُ تَحتَ نِقابِها",50,"ب",3,0],["بالخال أقسم إذ عمّ الشقيق به","ما زلت ولهان في صبحي ومغتبقي",51,"ي",1,0],["بالخدود وْبالعُنوق","والمضمَّر ما حَلاه",52,"ا",2,0],["بالخمسة الأشباح تم فارخوا","يا جعفر بالعيد قد نلت المنى",53,"ن",2,0],["بالخلقِ عدمُ الشهُودِ الغيبةُ","ثمّ الحضورُ وَصفُه لا رِيبةُ",54,"ه",1,0],["بِالخضر مِن فَردوسه يَتلفع","أَبدى لَهُ الدين الحَنيف شُجونه",55,"ه",1,0],["بالخُرّد البيض الأوانس تارة","الهو وتارات بكل كتاب",56,"ب",1,0],["بالخيف حيي بعارض هطل","كم من عناق لنا وكم قبل",57,"ل",1,0],["بالخيف مربعها الانيق ومربعي","وعلى الغوير مصيفها ومصيفي",58,"ف",2,0],["بالخضر اجعل روض أنسي خضراً","كيما يقال زان نوره الشجر",59,"ر",1,0],["بالخفق نحيا وذاك الخفق ينقصنا","جزء من العمر من أرواحنا انبترا",60,"ر",2,0],["بالخال دبج خدّه فكأنما","بالآس غصن الجلنار مدبج",61,"ج",1,0],["بالخوف والجوع ونقص من ال","أموال والأنفس والثمرات",62,"ت",1,0],["بالخير والشرِّ نرضى من عثارهما","رضى المغيض بما تقضي به الزَّلَم",63,"م",1,0],["بالخالقِ الباريء والخلاَّقِ","وبالمصوِّرِ ق