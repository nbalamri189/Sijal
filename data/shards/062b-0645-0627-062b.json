{"poems":[[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[190,"الدهر يرفع ثم يخفض تارة","https://www.aldiwan.net/poem43487.html","الكامل"],[199,"لمن الدار كعنوان الكتاب","https://www.aldiwan.net/poem54425.html","الرمل"],[214,"يممت أبغي ندى من راق منظره","https://www.aldiwan.net/poem13440.html","البسيط"],[409,"منعت عن مقلة الصب كراها","https://www.aldiwan.net/poem33364.html","الرمل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126124","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58360","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91684","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95325","الرجز"]],"verses":[["ثم أَثْرى الثَّرَى فقرَّتْ عُيونٌ","بقُراهَا وَأُحْيِيَتْ أَحْيَاءُ",0,"ا",2,0],["ثُمَّ اِثَّأَرتُ وَحَولي جَحفَلٌ لَجبٌ","غَزا وَبَحرُ المَنايا حَولَهُ طامِ",1,"م",1,0],["ثم اثنى ذاك الزمان فخانهم","من بعد ما فخروا عليه وصالوا",2,"ل",3,0],["ثُمَّ أَثنى وَهوَ شَهمٌ مُصعَبٌ","فَرَدٌ يُذعَرُ مِن صَوتِ الذُبابِ",3,"ب",1,0],["ثم أثنيت وقالت لي محاسنه","ما أنت أول سار غرّه القمرُ",4,"ر",1,0],["ثم أثنى دمعها طول النوى","وهو بحر زاخر لا يتناها",5,"ا",3,0],["ثم أثني بعده بالآل","أهل التقى والعلم والكمال",6,"ل",1,0],["ثُمَّ أَثخَنْتُ ذلكَ الزّيرَ ضَرْباً","بحُسامي حتّى هوى لانكسارِ",7,"ر",1,0],["ثم اثنيتُ وَما اِنثَنَتْ لي همةٌ","إِلا دَعَتني للصبابة غيدها",8,"د",3,0],["ثم أثنى بعدُ بالتسليم","على النبي الطاهر المعصوم",9,"م",1,0]]}