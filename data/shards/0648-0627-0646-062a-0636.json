{"poems":[[93,"لا لهفة النفس على غابة","https://www.aldiwan.net/poem62811.html","عموديه"],[107,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[108,"عودة إلى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=179678",""],[92,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[103,"اكْشفوا التُرْبَ عن الكَنْز الدفينْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62427&r=&rc=19",""],[93,"الغابة المفقودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67994&r=&rc=270",""],[113,"هاك طفلا أراكه الله جدا","https://www.aldiwan.net/poem16309.html","الخفيف"],[136,"هاج ما اكتن من دفين الدار","https://www.aldiwan.net/poem54898.html","البسيط"],[276,"مقيل العاثرين أقل عثارى","https://www.aldiwan.net/poem52134.html","الوافر"],[280,"آب بدرا وقد ألم هلالا","https://www.aldiwan.net/poem25533.html","الخفيف"],[295,"هند عذراء أسلمتها المقادير","https://www.aldiwan.net/poem11680.html","الخفيف"],[302,"أشذا نعمان أهدته النعامى","https://www.aldiwan.net/poem33177.html","الرمل"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[358,"يا من غدا في أمره حائرا","https://www.aldiwan.net/poem40181.html","الوافر"],[362,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[422,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[445,"اقبل ثناء وشكرا","https://www.aldiwan.net/poem34832.html","المجتث"],[463,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[500,"أحاجيكم وليس لكم","https://www.aldiwan.net/poem10267.html","مجزوء الوافر"],[556,"أيها اللائم الذي لا يمل اللوم","https://www.aldiwan.net/poem47139.html","الخفيف"],[556,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[556,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[567,"طال شوقي لطول هذا البعاد","https://www.aldiwan.net/poem52967.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122824","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87106","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86762","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86972","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38103","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38937","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59172","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59097","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96626","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61165","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56283","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79820","الرمل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48944","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108776","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27992","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93720","السريع"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107007","الخفيف"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107179","الوافر"],[2825,"","https://poetry.dctabudhabi.ae/diwan/poem/130731","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100312","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204653","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65113","البسيط"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76541","البسيط"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104261","الخفيف"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123881","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86344","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91145","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36792","الرمل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36791","الرمل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77086","الخفيف"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105506","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83354","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72791","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72347","البسيط"],[5271,"أُريدكِ سيلا !!","https://www.poetsgate.com/ViewPoem.aspx?id=59743",""],[5277,"صهيلُ الوتر","https://www.poetsgate.com/ViewPoem.aspx?id=186070",""],[5277,"شذاها بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=191226",""],[5277,"البوحُ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=191377",""],[327,"آذَنَ اليومَ جِيرتي بارتحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=3928",""],[5582,"بَكَى وَناحَ غَراماً فِي الهَوَى ناحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186790",""],[5596,"البردة الشعرية","https://www.poetsgate.com/ViewPoem.aspx?id=206751",""],[5851,"وصية مرتحلة","https://www.poetsgate.com/ViewPoem.aspx?id=175272",""],[6084,"لا تلمني على البكا والعويل","https://www.poetsgate.com/ViewPoem.aspx?id=170854",""]],"verses":[["وَإِن تَضاحَكنا سَمِعنا الصَدى","يَضحَكُ مَعَنا في أَقاصيها",0,"ي",3,0],["وانتضى من بين جَنبيْهِ الأسَى","ما انتضى العُدوانُ من تلك الهِمَمْ",1,"م",1,0],["وانتضوا من غمدِه سيفغَ وَغىً","كان إن صال يَقُدُّ الدارعين",2,"ن",1,0],["وانتضَت السيفَ من الجفونِ","توحي إلى الجماد بالفُتونِ",3,"ن",1,0],["وأنْ تضَعي أمورَكِ في نِصابٍ","يوَّفُر او يُّطَفَّفُ باجتراح",4,"ح",1,0],["وانتضوا من غمدهِ سيفَ وَغى ً","كان إن صال يَقُدُّ الدارعين",5,"ن",1,0],["وإن تضاحكا سمعنا الصدى","يضحك معنا في أقاصيها",6,"ي",3,0],["وَاِنتَضَتهُ يَد المَقادير عَضباً","جَعَلت غمدَهُ عَلاءً وَمَجدا",7,"د",2,0],["وانتَضَى الوجدَ والجوى والأسَى","والسُّدَ من جَفنِ مُقلَةِ الأقذَاءِ",8,"ا",2,0],["وان تضرري وَعناي منهم","نظير تذللي لك واِفتِقاري",9,"ر",2,0],["وانْتَضَتْهُ عَلَى عِداها حُساماً","فَتَلَقَّى بِقَتْلِها الأَقْتَالا",10,"ل",2,0],["وانتضى خنجراً يضيء دجى","الليل سناه ويملأ القلب ذعرا",11,"ر",2,0],["واِنتضَت دونَ حِماها قُضُباً","مُرهَفاتٍ ترشحُ الموتَ الزؤاما",12,"م",2,0],["وَاِنتَضَوا أَينُقَ النَجائِبِ صعراً","أَخَذوها بِالسَيرِ في الإِرقالِ",13,"ل",1,0],["وَإِن تَضق ذرعاً فَسلّم وَقُل","ألا إِلى اللَه تَصير الأُمور",14,"ر",1,0],["وَإِن تَضِقِ البلادُ فَثَمّ عَيشٌ","وَثَمَّ مَهَامِهٌفِيحٌ وَرِيعُ",15,"ع",1,0],["وانْتَضَتْه يَدُ العُلى مَشرفيًّا","صَقَلتْه قَينُ السِّيادة صقلا",16,"ل",2,0],["وإِنْ تَضَرَّمَ صَدْرِي","حَرّاً وجدتُكَ حُرَّا",17,"ر",2,0],["وانتضوا من طبع أيمانهمُ","كلَّ عضبٍ يأمن الجفنُ دُلوقَهْ",18,"ق",2,0],["وإن تضمم له شفة","تعطلها من الحلل",19,"ل",1,0],["وَاِنتَضوا بينهمْ وبين أعادي","يَ طِوالَ الخطيِّ والمَشْرَفِيّا",20,"ي",2,0],["وإنْ تَضِقْ بي بلدةٌ واحدةٌ","فلم تضق في غيرها مَجاولي",21,"ل",2,0],["وَإِن تُضح مَحبوساً عنِ النُّطق بالرّدى","فَما زلتَ في الأقوامِ أوّلَ خاطِبِ",22,"ب",1,0],["وانتَضَى القومُ بعدَكم كلَّ سيفٍ","كانَ في عهدِ سيفكُمْ كالنِّجادِ",23,"د",1,0],["وَإن تَضاحَكَ مِن زَهوٍ وَمِن عَجَبٍ","في الرَّوضِ فاحَت اَقاحيهِ أَقاحيهِ",24,"ي",2,0],["وَاِنتَضى سَيفه فَطارَت رُؤسٌ","عَن جُسوم وَمِن دِماها رَواه",25,"ا",2,0],["وَاِنتَضى سَيفاً صَقيلاً ماضِياً","حدّه مِني بَرى رَأس القلم",26,"م",1,0],["وَاِنتَضى سَيفَ عَزمه لجهاد","وَحمى جاره بِبَأسٍ شَديد",27,"د",1,0],["وَاِنتَضى عَزمه لِحفظ بِلاد","كادَ جَيش العِدا بِها يَتطوّف",28,"ف",1,0],["وَأَنتَ ضَعيفٌ كنتَ تَظهَر صالِحاً","وَإِنّك ذو عَدلٍ لما كنتَ تُبديهِ",29,"ه",1,0],["وَاِنتَضى سَيفَ العَدلِ سَلّاً عَلَيهِ","فَاِغتَدى مِنهُ هادم البُنيانِ",30,"ن",1,0],["وَانْتَضَى البَدْرُ حُسَامًا لاَمِعًا","مُذْ رَأى اللَّيْلُ سَنَاهُ احْتَجَبَا",31,"ب",2,0],["وَانْتَضَتْ كف عنترِ السحْبِ","مُرْهَفَاتِ البروقْ",32,"ق",1,0],["وَإن تضايقتَ مِن عُسرٍ ومتربةٍ","وَإِن أَصابك صرفُ الدهرِ وَاِجتاجا",33,"ج",2,0],["وَإِن تَضَع الحَرف المُقَدم آخِرا","فَذاكَ اسم ما يَروي وَلَيسَ براح",34,"ح",1,0],["وَإِن تَضَع الحَرف الأَخير مُقَدما","فَذاكَ اسم ما تُبديه كف رداح",34,"ح",1,0],["وَإِن تَضع الحَرف الموسط أَولا","فَحَيث يَقر المَرء دَونَ جناح",34,"ح",1,0],["وانتضت من لحاظها صمصاماً","ماضي الحد يفلق الجلمودا",35,"د",2,0],["وانتضوها قُضباً هنديَّةً","بسوى الهاماتِ لا ترضى الصقالا",36,"ل",2,0],["وانتضِ الهمةَ من غِمد الوغى","واغمد الحزم بصدر النُّوَب",37,"ب",1,0],["وانتضى صارم الحقيقة فالحك","مة تنضمُّ والضلالة تزهق",38,"ق",1,0],["وإن تضاعف فيه الأجر فاستمعوا","ما يستوي مقتد فيه بمن شَرَعا",39,"ع",2,0],["وَأنتضيها في وُجوه العِدى","بارِقةً إمّا لَهُم أَو لَنا",40,"ن",2,0],["وانتضت لحظها حساما صقيلا","عن شباه تكل بيض ظباها",41,"ا",3,0],["وَإِن تُضطَرَّ في حالٍ لِشَيء","فَسَل أَقوَى وَأَرحَمَ كُلِّ بَرِّ",42,"ر",1,0],["وانتضى الفجر سيفه فأشابت","مفرق الليل روعة الإشراق",43,"ق",1,0],["وانتضيناك للخطوب حساما","مرهفا يهتك الضريبة حزا",44,"ز",2,0],["وان تضق بك الحياة مرة","ففي ارتشاف الراح تلقى الفرجا",45,"ج",2,0],["وإن تضق منك حالٌ بالزّمانن وقد","وجدت صدرك منها غير مُنشرح",46,"ح",1,0],["وَأَنتَضي ذا نِفارٍ مِن ظُبا فِقَري","إِن هُزّ في فَيلَقٍ فِالهامُ أَفلاقُ",47,"ق",1,0],["وانتضى بعضهم لسانا صقيلا","أعجمياً مقلقلا مكثارا",48,"ر",2,0],["وإن تضع بعض نعال يوم","فليس تخلو عاجلاً من لوم",49,"م",1,0],["وَاِنتَضى سَيفاً لِلحظِ","قُلتُ وَيلي يا جَناني",50,"ي",1,0],["وَإِن تضحك الأَحياء منكم فطالَما","تركنا لكم ميتاً إِلى يومنا يُبكَى",51,"ك",2,0],["وَاِنتَضى المرّيخُ سَيفاً","غِمدُهُ هامُ عِداكا",52,"ك",2,0],["وَاِنتَضى المَرّيخُ سَيفاً","زانَهُ حُسن الصِقالِ",53,"ل",1,0],["وَاِنتَضى مِن لِحاظِهِ مُشرِفيا","ت فَكانَت فَتّاكَة فَتّانَه",54,"ن",2,0],["وانتضتك العلى حساماً بوجه الد","دهر أمضى من المهند حدا",55,"د",2,0],["وَاِنتَضى العودَ يَومَ بَدرٍ فَعاد ال","عودُ سَيفاً وَكَم بِهِ مَذبوحُ",56,"ح",1,0],["وانتضت عن منحنى اضلعِها","اسهماً تعدل بالشكل رماحا",57,"ح",2,0],["وأنت ضئضىء مجد في مدى أمد","قد فصل الدهر أوصالا وما انقطعا",58,"ع",2,0],["وانتِ ضلوعي وأنتِ خشوعي","وأنتِ تراتيل كل المنابرْ",59,"ر",1,0],["وَإن تَضاوع زهرٌ أنتشِ فَرَحاً","فالزَّهرُ يُشغُلُهُ..زهرْ الودادِ نَدِ",60,"د",1,0],["وَإن تضاحك أطفالٌ بِملعَبِهم","قلت.. الهناءُ أتى من غاديَ البلدِ",60,"د",1,0],["وَأنتَ ضِياءُ العيْنِ لا كان نورُها","إذا ما وَنَتْ عن رَسْمِكُم تَتَطَلَّعُ",61,"ع",1,0],["وأنتِ ضوعُ شميمٍ فاح متقدا","بين الزهورِ التي وجداً أناجيها",62,"ي",3,0],["وانتضوا أينق النجائب صعراً","أَخَذوها بالسَّيْر بالإرقالِ",63,"ل",1,0],["وَإِنْ تَضايَقْتَ مِنْ عُسْرٍ وَمَتْرَبَةٍ","وَابْتَزَّ مالَكَ صَرْفُ الدَّهْرِ وَاجْتاحَا",64,"ح",2,0],["وانتضى سيفَه فأفزعَ مَن في","حوْمةِ الضادِ داعياً أو دَعيّا",65,"ي",2,0],["وأَنتضي السيفَ من أغمادِ غفلتهِ","ليرتَوي بدماءٍ مِلؤها قِيمُ",66,"م",1,0],["وانتضت للكفاح بيض صفاح","صاقلات تفل حد الصقيل",67,"ل",1,0]]}