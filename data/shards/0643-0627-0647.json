{"poems":[[65,"وظباء من بني أسد","https://www.aldiwan.net/poem45804.html","المديد"],[53,"أرى ابن حريث لا يبالي عضيهتي","https://www.aldiwan.net/poem66736.html","الطويل"],[35,"وجدت الحب نيرانا تلظى","https://www.aldiwan.net/poem25959.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[1419,"","https://poetry.dctabudhabi.ae/diwan/poem/116677","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27914","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109407","الرمل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130067","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126930","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216830","المتقارب"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205479","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52133","الرمل"],[5431,"عليّ كرم الله وجهه....","https://www.poetsgate.com/ViewPoem.aspx?id=212969",""],[5652,"عندم / ريتام","https://www.poetsgate.com/ViewPoem.aspx?id=179841",""]],"verses":[["كاِهتِزازِ الغُصنِ مَشيَتُها","وَهوَ مَجنوبٌ وَمَشمولُ",0,"ل",1,0],["كأهل الندى والبأس والعِلم والحجى","سقى اللَّه هاتيك الذُّرى والروابيا",1,"ي",2,0],["كَأَهلِ النارِ إِذ نَضِجَت جُلودٌ","أُعيدَت لِلشَقاءِ لَهُم جُلودُ",2,"د",1,0],["كآهةٍ في فم المُغَنِّي","جريحةٍ لحنُها العذابُ",3,"ب",1,0],["كَأهلِ جَهَنّمٍ لَمَّا استَغاثُوا","أُغِيثُوا بِالحَمِيمِ مَعَ الصَّدِيدِ",4,"د",1,0],["كأهل الشام ما حجموا بخلفٍ","معاوية ولا نبذوا حجاما",5,"م",2,0],["كأهل بيت رسول الله سيِّدنا","وهو الإمام الكريم السيِّد الندسُ",6,"س",1,0],["كاهن السحر الذي في جفنه","ناب في بابلَ عنه الملكان",7,"ن",1,0],["كأهل تلا فما منهم ضعيفٌ","يُزحزحهُ عن الحقِّ اِمتهانُ",8,"ن",1,0],["كاهل العز مركبي من قديم","أي حر للعز غير ركوب",9,"ب",1,1],["كأهل القبور سوى أنه","بقيد الحياة فلا يُقبر",10,"ر",1,0],["كاهن الأولين أول مسحو","ر، وفي كل حقبة ترجمانُ",11,"ن",1,0],["كاهنُ اللهِ بلطفٍ واحترامْ","مدّ أيديه ونادى في طرب",12,"ب",1,0],["كاهن الدين قلعة لعروش","قد تمادت بغيّها الغاشميّ",13,"ي",1,0],["كاهن صنع فعله على كف يمناه","للرايه الي لطِخت من سواده ..!!",14,"د",2,0]]}