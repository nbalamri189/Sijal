{"poems":[[87,"يا أيها الدمع الوفي بدار","https://www.aldiwan.net/poem62872.html","الكامل"],[64,"بعض التماسك أيها القلب","https://www.aldiwan.net/poem52504.html","أحذ الكامل"],[47,"أقم علها أن ترجع القول أو علي","https://www.aldiwan.net/poem65594.html","الطويل"],[68,"وليلة زارني فقيه","https://www.aldiwan.net/poem39194.html","مجزوء البسيط"],[46,"غدا الملك معمور الحمى والمنازل","https://www.aldiwan.net/poem30375.html","الطويل"],[46,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[13,"ألا أبلغ بني فهم بن عمرو","https://www.aldiwan.net/poem2203.html","الوافر"],[77,"تظلم منا الحب والحب ظالم","https://www.aldiwan.net/poem69037.html","الطويل"],[50,"رأى بخديه منبتا زغبا","https://www.aldiwan.net/poem66278.html","المنسرح"],[48,"شكوت من أهل هذا العصر غدرهم","https://www.aldiwan.net/poem22983.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55100","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[285,"ألم أك للقوافي الغر خدنا","https://www.aldiwan.net/poem60692.html","البسيط"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[422,"نعم ما لهذا الأمر غيرك صالح","https://www.aldiwan.net/poem54137.html","الطويل"],[438,"ما ضر ذاك الريم ألا يريم","https://www.aldiwan.net/poem12725.html","السريع"],[463,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[463,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[463,"حمام اللوى رفقا به فهو لبه","https://www.aldiwan.net/poem56306.html","الطويل"],[487,"ألا ليت شعري ما تقول عظائم الد","https://www.aldiwan.net/poem24527.html","عموديه"],[505,"رأى برق العقيق الفجر لاحا","https://www.aldiwan.net/poem38046.html","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138256",""],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96975","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53893","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63925","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62483","السريع"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105444","البسيط"],[1108,"","https://poetry.dctabudhabi.ae/diwan/poem/146567","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109057","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108657","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20411","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109395","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93676","البسيط"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102437","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129459","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131023",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114110","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86459","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136902",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139772",""],[4119,"رنا وكأن البابلي المصفقا","https://www.poetsgate.com/ViewPoem.aspx?id=16197",""],[5520,"رأى ببابِ القصر جنيةً","https://www.poetsgate.com/ViewPoem.aspx?id=96129",""],[5937,"باحثٌ عن أناهُ في مابعد الحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=211893",""],[5939,"وقد يُفصِحُ الزهرُ عمّا مَسَك","https://www.poetsgate.com/ViewPoem.aspx?id=178613",""],[463,"تموق الليالي فيكمُ ثم تعقلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60290&r=&rc=346",""]],"verses":[["رَأيٌ بَدا لَكَ لَم تَجِدهُ مُخالِفاً","ما في الكِتابِ وَسُنَّةِ المُختارِ",0,"ر",1,0],["رأيٌ بعيدُ الغَوْرِ سانَدَهُ","جُودٌ قريبُ المستقَى عَذْبُ",1,"ب",1,0],["رَأى بَعضُهُم بَعضاً عَلى الحُبِّ أَسوَةً","فَماتوا وَمَوتُ الحُبِّ ضَربٌ مِنَ القَتلِ",2,"ل",1,0],["رَأى بِيُمنايَ كَأسَ خَمرٍ","فَظَلَّ يَنأى وَيَتَّقيهِ",3,"ي",2,0],["رَأى بابَكٌ مِنهُ الَّتي لا شَوى لَها","فَتُرجى سِوى نَزعِ الشَوى وَالمَفاصِلِ",4,"ل",1,0],["رَأى بابَكٌ مِنكَ الَّتي طَلَعَت لَهُ","بِنَحسٍ وَلِلدينِ الحَنيفِ بِأَسعُدِ",5,"د",1,0],["رَأَى بِهِ مِن كِرامِ الرُّسلِ طائِفَةً","فَأَمَّهُم ثُمَّ صَلَّى خاشِعاً بِهِمِ",6,"م",1,0],["رَأى بِهِما عَذاباً كُلَّ عامٍ","لِخَثعَمَ أَو بَجيلَةَ أَو ثُمالَه",7,"ل",2,0],["رأى بكَ ليثُ الغابِ كيفَ اختضابُه","من العَلَقِ المُحمَرِّ والنّقعُ قاتِمُ",8,"م",1,0],["رأى بخدّيهِ منبتاً زغباً","فضنَّ عني هناكَ بالعملِ",9,"ل",1,1],["رَأى بَنو الحَزمِ أَنَّ العَيشَ فائِدَةٌ","حَتّى اِستَبانوا فَقالوا حَبَّذا التَلَفُ",10,"ف",1,0],["رأى بعينيه المصيرَ الرهيبْ","وكيف غالَ الناسَ من قبْلِه",11,"ه",1,0],["رأى بعينيهِ الذي لم يَرهْ","الذئبَ والشاةَ وحربَ البقاءْ",11,"ا",2,0],["رَأْيٌ بِهِ إِفْلاَحُ مِصْرَ وَعِزُّهَا","نَسَجَاهُ مِنْ بِرٍ عَلَى مِنْوَالِ",12,"ل",1,0],["رَأَى بِكِ النَّاسُ مِنْ فَضْلٍ وَمِنْ كَرَمٍ","مَا لَمْ يَكُنْ لِيَرَاهُ النَّاسُ لَوْلاَكِ",13,"ك",1,0],["رَأْيٌ بدا لأُولِي البَصائِرِ سِرهُ","فِي ضَوْءِ مَا أَبْدَى وزيرُ المالِ",14,"ل",1,0],["رَأَى بَيْنِي وَبَيْنَ الدَّهْرِ حَرْباً","أُكابِدُها نِزالاً أَوْ بِرازا",15,"ز",2,0],["رأى بشت سيّدهِ مرّة","فقال هنا غاية المطلب",16,"ب",1,0],["رأى بابن عيسى بعد عيسى صلاحها","وفي صالح الأعمال تقضى المصالح",17,"ح",1,0],["رأى به الديوانُ ديوانَهُ","مطرّزاً باسمِ شريفٍ وَسيمْ",18,"م",1,0],["رأى بك ركن الدين بلجةَ شمسه","غَناءً ويومُ الناظرين مغيمُ",19,"م",1,0],["رأى بك وجهَ الرشد الوقتُ فَترةٌ","وبابَ الهدى والملكُ شرعٌ مضلِّلُ",20,"ل",1,0],["رأي بك ما أنسى أبنَ غيلٍ شُبولَهُ","فخيرا بخيرٍ أو فشرّا يذبُّهُ",21,"ب",2,0],["رأى بتراجيع الأحاجي ذاك الذي","رأى ربه بالكشفيات العيانيه",22,"ي",2,0],["رأى بَرْقَ العَقيقِ الفَجرَ لاحا","فتًى فأَسَالَ بالدَّمعِ البِطاحا",23,"ح",2,1],["رأي بدا مثل السراج فكان من","لألآئه أثر أغر مفيد",24,"د",1,0],["رأى بين أيدي القوم أيتام سبطه","سبايا تهادى من شقي إلى شقي",25,"ق",2,0],["رأى بيننا غُصْنَ المودّةِ ناعِماً","فقطَّعَهُ بالزّورِ عمداً لكي يذْوِي",26,"ي",1,0],["رأيٌ به استدَّ ركنُ الحقِّ منتصباً","على قواعدِهِ من بعد ما ارتعشا",27,"ش",2,0],["رأى بني الدهر بعين النقد","إذ لا يدومُ لهمُ من عهدِ",28,"د",1,0],["رأى بأبنائه ما فيه والشرف ال","محمود في البدء ما تلقاه في العقب",29,"ب",1,0],["رأى بارقاً م جانب الري ظنه","حسامك مسلولاً فظل يراقبه",30,"ب",2,0],["رأى بالوهم ما قد كان حقاً","فثار كثورة الصب الغيور",31,"ر",1,0],["رأى بيدي صبراً فأعرض عابساً","وقال أراك اليوم تجنح للصبر",32,"ر",1,1],["رأى بان الخيبرية كيف لاقى","بحيدر ذلك الأسد الرزاما",33,"م",2,0],["رَأى بِالمُستَوى سَفراً وَعيراً","أُصَيلالاً وَجُنَّتُهُ الغَميسُ",34,"س",1,0],["رأى به لبنانُ حرزاً بدا","من سر علم الغيب لا من كتاب",35,"ب",1,0],["رَأى بِأَن سَبيل الغَي متبع","وَالرُشد لَم تدر قَوم أَية سلكا",36,"ك",2,0],["رأى بكراتٍ بالياتٍ تساوَكتْ","بها ذهبتْ من دونهنَّ الدَّراهمُ",37,"م",1,0],["رأى بعزمك طغيانا فحركه","عزم اذا هم في أمر طغى فطمى",38,"م",2,0],["رأى بهجة لم تحوها قط بلدة","وآثار عز عن حضارتها تنبي",39,"ب",2,0],["رَأى بِعَينِي قَذًى مِن طُولِ غَيبَتِهِ","فَقَالَ لِي الإكتِحَالُ حَسمُ شَوكَتِهِ",40,"ه",1,1],["رأى بذله أن جاءه مستحقه","وأبصر من عنه يصان فصانا",41,"ن",2,0],["رأى بشعرك تأييداً لدولته","على ابن طغج فأعطى القوس باريها",42,"ي",3,0],["رأى بِرَّ آل الله قربةً","وبالودِّ في القربى حرىٌّ جديرها",43,"ر",3,0],["رأى بيت مال الملك نهبى فأصبحت","كفايته سورا عليه وخندقا",44,"ق",2,0],["رأى ببابِ القصر جنيةً","تخرجُ من قصرٍ الى قصر",45,"ر",1,1],["رأى بلقيس قد ماتت ، ولكن","يحاول أن يرى معنىً مُبَلْقَسْ",46,"س",1,0],["رأى بعضَ حُسنِكِ في كلِّ شيءٍ","ولا شيءَ في الحُسنِ قد نافسَكْ",47,"ك",1,0],["رأى بك وجهَ الرشد والوقتُ فترة ٌ","وبابَ الهدى والملكُ شرعٌ مضلِّلُ",48,"ل",1,0]]}