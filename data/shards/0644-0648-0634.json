ww.aldiwan.net/poem2810.html","السريع"],[575,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"]],"verses":[["لَو شِئتَ شَتَّتَتِ الثَرَيّا شَملَها","جَزَعاً وَهَمَّ النِسرُ بِالطَيَرانِ",0,"ن",1,0],["لَو شامَ موسى كَفَّهُ في لَيلِها","خَفيَ البَياضِ عَلى الَّذي يَتَأَمَّلُ",1,"ل",1,0],["لَو شابَ طَرفٌ شابَ أَسوَدُ ناظِري","مِن طولِ ما أَنا في الحَوادِثِ ناظِرُ",2,"ر",1,0],["لَو شِمتَهُ بِبارِقٍ","ماءَ الكُلابِ أَورَدا",3,"د",2,0],["لَو شِئتُ سَمَّيتُ فيكُم مَن يُعَرِّضُ لي","بِالوَصلِ طَوعاً فَلَم أَبسُطُ إِلَيهِ يَدا",4,"د",2,0],["لَو شاءَ أَن تَصلى جَهَنَّمَ خالِداً","ما كانَ أَلهَمَ قَلبَكَ التَوحيدا",5,"د",2,0],["لَو شَهِدتُم مُحَمَّداً وَهوَ يُملي","آيَ عيسى وَمُعجِزاتِ الكِتابِ",6,"ب",1,0],["لَو شاءَ زَلزَلَها عَلى أَعدائِهِ","أَو شاءَ أَذهَلَها عَنِ الدَوَرانِ",7,"ن",1,0],["لَو شاءَ حَملي نَسيمُ الصُبحِ حينَ سَرى","وافاكُمُ بِفَتىً أَضناهُ ما لاقى",8,"ق",2,0],["لَو شِئتَ زُرتَ وَسَلكُ النَجمِ مُنتَظِمُ","وَالأُفقُ يَختالُ في ثَوبٍ مِنَ الغَبَشِ",9,"ش",1,0],["لَو شِئتِ ما عَذَّبتِ مُهجَةَ عاشِقٍ","مُستَعذِبٍ في حُبِّكِ التَعذيبا",10,"ب",2,0],["لَوْ شَبَّهَتْ أَعْيَادَهَا الأُخْرَى بِهَا","مَا كَانَتِ الأَعْيَادُ مِنْ أَمثَالِهَا",11,"ل",3,0],["لَو شِئتِ قَد نَقَعَ الفُؤادُ بِمَشرَبٍ","يَدَعُ الحَوائِمَ لا يَجِدنَ غَليلا",12,"ل",2,0],["لَوَشكانَ ما أَعطَيتَني القَومَ عَنوَةً","هِيَ السُنَّةُ الشَنعاءُ وَالطَعنُ يَظأَرُ",13,"ر",1,0],["لَو شِئتِ قَد نُقِعَ الفُؤادُ بِشَربَةٍ","تَدَعُ الصَوادي لا يَجِدنَ غَليلا",14,"ل",2,0],["لَو شِئتُ مِمّا قَد قَلَلنَ جِدّاً","عَدَدتُ أَيّامَ السُرورِ عَدّا",15,"د",2,0],["لَو شَهِدَتني مِن مَعَدٍّ عِصابَةٌ","سِوى ناكَةِ المِعزى سُلَيمُ بنُ أَشجَعِ",16,"ع",1,1],["لو شاءَ أن يجمعَ شملي بهم","غوثُ الورى ما بتُّ مكروبا",17,"ب",2,0],["لو شقَّ صدرُ الليث عن قلبِه","رأيت فيه اسمكَ مكتوبا",17,"ب",2,0],["لو شامَ طرفك ما ألقاه من حربٍ","لم تدرِ من هوَ منَّا الهالكُ المودِي",18,"د",2,0],["لو شكّ طرف امرئٍ في الشمس طالعة","لم يبقَ في فضلك الوضَّاح تشكيكا",19,"ك",2,0],["لو شامه حتَّى الجنيد لراقه","من حرفها بجبينها ذا النون",20,"ن",1,0],["لو شاء أن يذهب في صخرةٍ","لسهَّل الطِّيبُ لَهُ مذهبا",21,"ب",2,0],["لو شاهَدَ الورْدُ أحَايِينَهُ","لم تَرَ ورْداً غيْرَ مَسْفُوحِ",22,"ح",1,0],["لو شاركتْك بنو حواءَ في دمه","لكُبكبوا يا ابن بنت النار في سقر",23,"ر",1,0],["لو شِئتَ كسباً به صادفتَ مُكتسَباً","أو انتصاراً مضى كالسيف والفاس",24,"س",1,0],["لَو شاعَ في الفِردَوسِ أَنَّكَ بَينَنا","لَمَشَت إِلَينا سافِراتٍ حَورُهُ",25,"ر",2,0],["لَو شِئتَ نَيلَ النَجمِ مِن","ها ما صَبَوتَ إِلى عَسيرِ",26,"ر",1,0],["لَو شِئتَ لَم تَعتَب عَلَيكَ وَلَم يَلُم","وَطَنٌ أَسَأتَ بِهِ الصَنيعَ مُعَذَّبُ",27,"ب",1,0],["لَو شَهِدتُم عَصرَهُ أَضحى لَهُ","عالَمُ الأَفلاكِ مَعقودَ اللِواء",28,"ا",2,0],["لَو شِئتَ صِدتَ الأُسدَ بِالثِعالي","أَو شِئتَ غَرَّقتَ العِدا بِالآلِ",29,"ل",1,0],["لَو شِئتَ لَم تُفسِد سَماحَةَ حاتِمٍ","كَرَماً وَلَم تَهدِم مَآثِرَ خالِدِ",30,"د",1,0],["لَو شِئتَ عُدتَ بِلادَ نَجدٍ عَودَةً","فَنَزَلتَ بَينَ عَقيقِهِ وَزَرودِهِ",31,"د",2,0],["لَو شاهَدَ الشَريفُ مائِعتَرَضَت","عائِقَةٌ في الحَبيبِ تَعتَرِضُ",32,"ض",1,0],["لَو شِئتِ زِدتِ الكاشِحينَ مِنَ الجَوى","وَوَصَلتِ خُلَّةِ وامِقٍ لَم توصَلِ",33,"ل",1,0],["لَو شاءَ لا بورِكَت مَشيأَتُهُ","أَبلَغَها بِالطَلاقِ مَأمَنَها",34,"ن",3,0],["لَو شِئتُ لُمتُ بَني زَبينَةَ صادِقاً","وَمَطِيَّتي لِبَني زَبينَةَ أَلوَمُ",35,"م",1,1],["لو شئت نهنهت من الدمع","وصنته عن دارس الربع",36,"ع",1,1],["لو شئتُ أنشأتُ من ذَوائِبِه","ليلاً ومن نُورِ وجههِ فَلَقا",37,"ق",2,0],["لَو شَكَروا النِعمَةَ زادَتُهُمُ","مَقالَةً لِلّهِ قَد قالَها",38,"ل",3,0],["لَو شَمَّرَت فِكرَتي فيما شُلِقتُ لَهُ","ما اِشتَدَّ حِرصي عَلى الدُنيا وَلا طَلَبي",39,"ي",1,0],["لَو شِئتَ أَيضاً جُلتَ في خامَةٍ","وَفي وِشاحَينِ وَأَوضاحِ",40,"ح",1,0],["لَو شاءَ أَن يَشفي المُحِبَّ سَقاهُ مِن","تِلكَ الشِفاهِ بِأَوَّلِ الأَعرافِ",41,"ف",1,0],["لَو شِئتُم أَنَّهُ يُمسي أَبا لَهَبٍ","جاءَت بِغالُكُمُ حَمّالَةَ الحَطَبِ",42,"ب",1,0],["لَو شِئتَ ما أَبقَت صِفاحُكَ يافِعاً","مِنهُم وَلا تَرَكَت قَناكَ وَليدا",43,"د",2,0],["لَو شاءَ قال دَعوا القِصاصَ وَلَم يَقُل","بَل في القِصاصِ لَكُم حَياةٌ تَنعَمُ",44,"م",1,0],["لوْ شِئْتُ صَيّرْت بالقوافي","غارة هجوي عليه شعوا",45,"و",2,0],["لو شئتَ أغناك جدّ عن محجَّلةٍ","شعارُ فرسانها الإقدام والقحمُ",46,"م",1,0],["لو شئتِ حييتِ نَشاوَى الهوى","من لون خدّيك بتفاحتيك",47,"ك",1,0],["لَو شِئتُ لَقُلتُ لِقافِيةٍ","في الوَزنِ تَخِبُّ إِلَيكَ خِدي",48,"د",2,0],["لو شمَّها صاحٍ عَسيرٌ سُكْرُهُ","تحتَ لثامٍ في فدامٍ لَطَفَحْ",49,"ح",1,0],["لَو شَرَحتِ الغَداةَ يا هِندُ صَدري","لَم تَجِد لي يَداكِ يا هِندُ قَلبا",50,"ب",2,0],["لَو شِئتُ طُلتُ بِهِ الثُرَيّا قاعِداً","وَنَشَرتُ عِقدَ كَواكِبَ الجَوزاءِ",51,"ا",2,0],["لَو شاءَ نَسَخَ اللَيلِ صُبحاً لَاِنتَحى","فَمَحا سَوادَ اللَيلَةِ اللَيلاءِ",51,"ا",2,0],["لو شِئْتَ ما جَهِلوا السَّبيلَ ولا رَضُوا","دِيناً من النَّمط الغبيِّ ذميما",52,"م",2,0],["لَو شاءَ لِلسَبعِ الطِباقِ زِيادَةً","لَأَقامَ عَشراً فَوقَهُنَّ طِباقا",53,"ق",2,0],["لو شاءَ قتلك يا سُرا","قَةُ لم تذق طَعْمَ الحياةِ",54,"ه",1,0],["لو شاء طاح بهم قتلاً فما ملكوا","من بعد مَهلكهم قولاً ولا عملا",55,"ل",2,0],["لَو شاءَ بِالسَعدِ رَدَّ السَهمَ في لُطُفٍ","بَعدَ المُروقِ وَنالَ النَجمَ مِن أَمَمِ",56,"م",1,0],["لو شَقّ عن قلبي امتحانُ ودَادهِ","لوجدتَ من قلبي عليه حجابا",57,"ب",2,0],["لو شَيّدوا الخيماتِ تشييدَ العُلى","أمِنَتْ ديارُ ربيعةٍ أن تَخْرَبا",58,"ب",2,0],["لَو شاءَ قالَ وَلَكِن","فيهِ حَياً وَتَأَبّي",59,"ي",1,0],["لَو شِئتِ وَاللَهِ لَأَرضَيتِهِ","فَلا تُقيميهِ عَلى الياسِ",60,"س",1,0],["لَو شِئتُ أَن يُلثِمَني","فاهُ وَحَولي حِلَقُ",61,"ق",1,0],["لَو شِئتَ إِذ أَحسَنتِ لي في الكَرى","أَتمَمتِ إِحسانَكِ يَقظانا",62,"ن",2,0],["لَو شاءَ رَبُّكَ صَيَّرَ الشَرطَينِ مِن","هَذي الكَواكِبِ عِندَ أَدنى ثائِجِ",63,"ج",1,0],["لَو شاءَ رَبّي لَصاغَني مَلِكاً","أَو مَلَكاً لَيسَ يَعجَزُ القَدَرُ",64,"ر",1,1],["لَو شَكَّ بِالطَعنِ مَيتٌ لَم يَجِد أَلَماً","فَالرُمحُ فيهِ كَإِشفى الخَرزِ في الأَدَمِ",65,"م",1,0],["لَو شاءَ رَبّي أَمَرَّ مُقتَدَراً","ما نَقَضَ المَوتُ مِن مَرائِرِكُم",66,"م",1,0],["لو شاءَ أرسلَها فزلزلَ مكّةً","خَطبٌ يَضِجُّ له الحطيمُ وزمزم",67,"م",1,0],["لو شهِدتم غداةَ ثورتها الكب","رى لجَاجَ