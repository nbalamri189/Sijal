{"poems":[[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[53,"وقف على العبرات هذا الناظر","https://www.aldiwan.net/poem30472.html","الكامل"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[55,"إني بليت بذي لونين يظهر لي","https://www.aldiwan.net/poem26402.html","البسيط"],[57,"إن كنت تغدو في الذنوب جليداً","https://www.aldiwan.net/poem24703.html","الكامل"],[86,"دمعة من دموع عهد الشباب","https://www.aldiwan.net/poem10372.html","الخفيف"],[86,"أثنى الحجيج عليك والحرمان","https://www.aldiwan.net/poem68941.html","الكامل"],[73,"إني ذكرتك بازهراء مشتاقا","https://www.aldiwan.net/poem11858.html","البسيط"],[73,"يا معطشي من وصال كنت وارده","https://www.aldiwan.net/poem11902.html","البسيط"],[73,"هذا الصباح على سراك رقيبا","https://www.aldiwan.net/poem11919.html","الكامل"],[93,"حي الكنانة غدوة استقلالها","https://www.aldiwan.net/poem11126.html","الكامل"],[27,"لم أر مثلك يا أمام خليلا","https://www.aldiwan.net/poem5969.html","الكامل"],[4,"ولم تحم عبد الله لا در درها","https://www.aldiwan.net/poem21161.html","الطويل"],[4,"لم أر مثلك يا أمام خليلا","https://www.aldiwan.net/poem21291.html","الكامل"],[47,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[23,"لو شهدتني من معد عصابة","https://www.aldiwan.net/poem21480.html","الطويل"],[72,"صب بمصر حيث أولاده","https://www.aldiwan.net/poem18275.html","السريع"],[72,"واوحشتي لمقام منك محمود","https://www.aldiwan.net/poem18564.html","البسيط"],[72,"يا طالب الجود لا تتعب أمانيكا","https://www.aldiwan.net/poem19443.html","البسيط"],[72,"بأبي على عين الحبيبة حاجب","https://www.aldiwan.net/poem20232.html","الكامل"],[51,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[51,"أبشر بفتح لك مفتوح","https://www.aldiwan.net/poem9415.html","السريع"],[51,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[51,"يا عمرو فخرا فقد أعطيت منزلة","https://www.aldiwan.net/poem64656.html","البسيط"],[91,"عندي لكم نبأ عجيب شيق","https://www.aldiwan.net/poem8834.html","عموديه"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[70,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[85,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[45,"عجبا لطيف خيالك المتعاهد","https://www.aldiwan.net/poem62740.html","الكامل"],[45,"يا عارضا متلفعا ببروده","https://www.aldiwan.net/poem63492.html","الخفيف"],[45,"يزيد قلبي بصده مرضا","https://www.aldiwan.net/poem64629.html","المنسرح"],[45,"أكثرت في لوم المحب فأقلل","https://www.aldiwan.net/poem65591.html","الكامل"],[45,"أبلغ ذفافينا رسالة مشتاق","https://www.aldiwan.net/poem66811.html","المنسرح"],[28,"لو شئت لمت بني زبينة صادقا","https://www.aldiwan.net/poem5605.html","الكامل"],[61,"لو شئت نهنهت من الدمع","https://www.aldiwan.net/poem51354.html","السريع"],[61,"أهلا وسهلا بطارق طرقا","https://www.aldiwan.net/poem51522.html","المنسرح"],[58,"ما أحسن الدنيا وإقبالها","https://www.aldiwan.net/poem30913.html","السريع"],[49,"لقد لعبت وجد الموت في طلبي","https://www.aldiwan.net/poem10337.html","البسيط"],[49,"يا لابس الوشي على شيبه","https://www.aldiwan.net/poem64145.html","السريع"],[66,"حذرا عليك من الفعال الجافي","https://www.aldiwan.net/poem38689.html","الكامل"],[66,"إن البخيري مذ فارقتموه غدا","https://www.aldiwan.net/poem38737.html","البسيط"],[66,"لا تخش ياربع الحبيب همودا","https://www.aldiwan.net/poem41375.html","الكامل"],[66,"خطب لسان الحال فيه أبكم","https://www.aldiwan.net/poem41549.html","الكامل"],[80,"إني امرؤ لا ترى لساني","https://www.aldiwan.net/poem31253.html","مخلع البسيط"],[80,"يمضي لك السيف ما تنويه والقلم","https://www.aldiwan.net/poem31288.html","البسيط"],[80,"أذابل النرجس في مقلتيك","https://www.aldiwan.net/poem31351.html","السريع"],[80,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[80,"أي نعيم في الصبا والمقترح","https://www.aldiwan.net/poem31521.html","الرجز"],[31,"من لعين تذري من الدمع غربا","https://www.aldiwan.net/poem42643.html","الخفيف"],[74,"يانشر عرف الروضة الغناء","https://www.aldiwan.net/poem12828.html","الكامل"],[105,"الكون أشرق نضرة ونعيما","https://www.aldiwan.net/poem42064.html","الكامل"],[105,"هل ليم نضو صبابة فأفاقا","https://www.aldiwan.net/poem43377.html","الكامل"],[105,"إرفع كتابك يا سرا","https://www.aldiwan.net/poem44031.html","مجزوء الكامل"],[105,"ردوا بني قينقاع الأمر إذ نزلا","https://www.aldiwan.net/poem44215.html","البسيط"],[81,"لولا قضاؤك بين الحكم والحكم","https://www.aldiwan.net/poem61492.html","البسيط"],[75,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[48,"عزوا أخلاي قلبي فقد أصبت بلبي","https://www.aldiwan.net/poem10817.html","المجتث"],[48,"قل لنداماي وجلاسي","https://www.aldiwan.net/poem64317.html","السريع"],[48,"علقت من علقني","https://www.aldiwan.net/poem64448.html","مجزوء الرجز"],[48,"إذا التقى في النوم طيفانا","https://www.aldiwan.net/poem65318.html","السريع"],[46,"أتعوج أم ليس المشوق بعائج","https://www.aldiwan.net/poem22267.html","الكامل"],[46,"لو شاء ربي لصاغني ملكا","https://www.aldiwan.net/poem22596.html","المنسرح"],[46,"لا تحدث القطع في كف ولا قدم","https://www.aldiwan.net/poem23378.html","البسيط"],[46,"يا أمة في التراب هامدة","https://www.aldiwan.net/poem23433.html","المنسرح"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49137","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39611","المنسرح"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30512","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42654","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55183","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142012","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43891","السريع"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[106,"يا راعي الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179702",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[45,"أبْلِغْ ذَفافِيّنَا رِسالَةَ مُشْتاق","https://www.poetsgate.com/ViewPoem.aspx?id=31824",""],[45,"أكْثَرْتَ في لَوْمِ المُحِبّ، فأقْلِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32120",""],[45,"قُلْ للسّحابِ، إذا حَدَتْهُ الشّمألُ","https://www.poetsgate.com/ViewPoem.aspx?id=32160",""],[45,"يَزيدُ قَلْبي بِصَدِّهِ مَرَضاً","https://www.poetsgate.com/ViewPoem.aspx?id=31130",""],[51,"يا ناعيَ ابن رسول الله من البشرِ","https://www.poetsgate.com/ViewPoem.aspx?id=29230",""],[51,"أبْشِرْ بفتْح لكَ مَفْتُوحِ","https://www.poetsgate.com/ViewPoem.aspx?id=27412",""]],"verses":[["لَو شِئتَ شَتَّتَتِ الثَرَيّا شَملَها","جَزَعاً وَهَمَّ النِسرُ بِالطَيَرانِ",0,"ن",1,0],["لَو شامَ موسى كَفَّهُ في لَيلِها","خَفيَ البَياضِ عَلى الَّذي يَتَأَمَّلُ",1,"ل",1,0],["لَو شابَ طَرفٌ شابَ أَسوَدُ ناظِري","مِن طولِ ما أَنا في الحَوادِثِ ناظِرُ",2,"ر",1,0],["لَو شِمتَهُ بِبارِقٍ","ماءَ الكُلابِ أَورَدا",3,"د",2,0],["لَو شِئتُ سَمَّيتُ فيكُم مَن يُعَرِّضُ لي","بِالوَصلِ طَوعاً فَلَم أَبسُطُ إِلَيهِ يَدا",4,"د",2,0],["لَو شاءَ أَن تَصلى جَهَنَّمَ خالِداً","ما كانَ أَلهَمَ قَلبَكَ التَوحيدا",5,"د",2,0],["لَو شَهِدتُم مُحَمَّداً وَهوَ يُملي","آيَ عيسى وَمُعجِزاتِ الكِتابِ",6,"ب",1,0],["لَو شاءَ زَلزَلَها عَلى أَعدائِهِ","أَو شاءَ أَذهَلَها عَنِ الدَوَرانِ",7,"ن",1,0],["لَو شاءَ حَملي نَسيمُ الصُبحِ حينَ سَرى","وافاكُمُ بِفَتىً أَضناهُ ما لاقى",8,"ق",2,0],["لَو شِئتَ زُرتَ وَسَلكُ النَجمِ مُنتَظِمُ","وَالأُفقُ يَختالُ في ثَوبٍ مِنَ الغَبَشِ",9,"ش",1,0],["لَو شِئتِ ما عَذَّبتِ مُهجَةَ عاشِقٍ","مُستَعذِبٍ في حُبِّكِ التَعذيبا",10,"ب",2,0],["لَوْ شَبَّهَتْ أَعْيَادَهَا الأُخْرَى بِهَا","مَا كَانَتِ الأَعْيَادُ مِنْ أَمثَالِهَا",11,"ل",3,0],["لَو شِئتِ قَد نَقَعَ الفُؤادُ بِمَشرَبٍ","يَدَعُ الحَوائِمَ لا يَجِدنَ غَليلا",12,"ل",2,0],["لَوَشكانَ ما أَعطَيتَني القَومَ عَنوَةً","هِيَ السُنَّةُ الشَنعاءُ وَالطَعنُ يَظأَرُ",13,"ر",1,0],["لَو شِئتِ قَد نُقِعَ الفُؤادُ بِشَربَةٍ","تَدَعُ الصَوادي لا يَجِدنَ غَليلا",14,"ل",2,0],["لَو شِئتُ مِمّا قَد قَلَلنَ جِدّاً","عَدَدتُ أَيّامَ السُرورِ عَدّا",15,"د",2,0],["لَو شَهِدَتني مِن مَعَدٍّ عِصابَةٌ","سِوى ناكَةِ المِعزى سُلَيمُ بنُ أَشجَعِ",16,"ع",1,1],["لو شاءَ أن يجمعَ شملي بهم","غوثُ الورى ما بتُّ مكروبا",17,"ب",2,0],["لو شقَّ صدرُ الليث عن قلبِه","رأيت فيه اسمكَ مكتوبا",17,"ب",2,0],["لو شامَ طرفك ما ألقاه من حربٍ","لم تدرِ من هوَ منَّا الهالكُ المودِي",18,"د",2,0],["لو شكّ طرف امرئٍ في الشمس طالعة","لم يبقَ في فضلك الوضَّاح تشكيكا",19,"ك",2,0],["لو شامه حتَّى الجنيد لراقه","من حرفها بجبينها ذا النون",20,"ن",1,0],["لو شاء أن يذهب في صخرةٍ","لسهَّل الطِّيبُ لَهُ مذهبا",21,"ب",2,0],["لو شاهَدَ الورْدُ أحَايِينَهُ","لم تَرَ ورْداً غيْرَ مَسْفُوحِ",22,"ح",1,0],["لو شاركتْك بنو حواءَ في دمه","لكُبكبوا يا ابن بنت النار في سقر",23,"ر",1,0],["لو شِئتَ كسباً به صادفتَ مُكتسَباً","أو انتصاراً مضى كالسيف والفاس",24,"س",1,0],["لَو شاعَ في الفِردَوسِ أَنَّكَ بَينَنا","لَمَشَت إِلَينا سافِراتٍ حَورُهُ",25,"ر",2,0],["لَو شِئتَ نَيلَ النَجمِ مِن","ها ما صَبَوتَ إِلى عَسيرِ",26,"ر",1,0],["لَو شِئتَ لَم تَعتَب عَلَيكَ وَلَم يَلُم","وَطَنٌ أَسَأتَ بِهِ الصَنيعَ مُعَذَّبُ",27,"ب",1,0],["لَو شَهِدتُم عَصرَهُ أَضحى لَهُ","عالَمُ الأَفلاكِ مَعقودَ اللِواء",28,"ا",2,0],["لَو شِئتَ صِدتَ الأُسدَ بِالثِعالي","أَو شِئتَ غَرَّقتَ العِدا بِالآلِ",29,"ل",1,0],["لَو شِئتَ لَم تُفسِد سَماحَةَ حاتِمٍ","كَرَماً وَلَم تَهدِم مَآثِرَ خالِدِ",30,"د",1,0],["لَو شِئتَ عُدتَ بِلادَ نَجدٍ عَودَةً","فَنَزَلتَ بَينَ عَقيقِهِ وَزَرودِهِ",31,"د",2,0],["لَو شاهَدَ الشَريفُ مائِعتَرَضَت","عائِقَةٌ في الحَبيبِ تَعتَرِضُ",32,"ض",1,0],["لَو شِئتِ زِدتِ الكاشِحينَ مِنَ الجَوى","وَوَصَلتِ خُلَّةِ وامِقٍ لَم توصَلِ",33,"ل",1,0],["لَو شاءَ لا بورِكَت مَشيأَتُهُ","أَبلَغَها بِالطَلاقِ مَأمَنَها",34,"ن",3,0],["لَو شِئتُ لُمتُ بَني زَبينَةَ صادِقاً","وَمَطِيَّتي لِبَني زَبينَةَ أَلوَمُ",35,"م",1,1],["لو شئت نهنهت من الدمع","وصنته عن دارس الربع",36,"ع",1,1],["لو شئتُ أنشأتُ من ذَوائِبِه","ليلاً ومن نُورِ وجههِ فَلَقا",37,"ق",2,0],["لَو شَكَروا النِعمَةَ زادَتُهُمُ","مَقالَةً لِلّهِ قَد قالَها",38,"ل",3,0],["لَو شَمَّرَت فِكرَتي فيما شُلِقتُ لَهُ","ما اِشتَدَّ حِرصي عَلى الدُنيا وَلا طَلَبي",39,"ي",1,0],["لَو شِئتَ أَيضاً جُلتَ في خامَةٍ","وَفي وِشاحَينِ وَأَوضاحِ",40,"ح",1,0],["لَو شاءَ أَن يَشفي المُحِبَّ سَقاهُ مِن","تِلكَ الشِفاهِ بِأَوَّلِ الأَعرافِ",41,"ف",1,0],["لَو شِئتُم أَنَّهُ يُمسي أَبا لَهَبٍ","جاءَت بِغالُكُمُ حَمّالَةَ الحَطَبِ",42,"ب",1,0],["لَو شِئتَ ما أَبقَت صِفاحُكَ يافِعاً","مِنهُم وَلا تَرَكَت قَناكَ وَليدا",43,"د",2,0],["لَو شاءَ قال دَعوا القِصاصَ وَلَم يَقُل","بَل في القِصاصِ لَكُم حَياةٌ تَنعَمُ",44,"م",1,0],["لوْ شِئْتُ صَيّرْت بالقوافي","غارة هجوي عليه شعوا",45,"و",2,0],["لو شئتَ أغناك جدّ عن محجَّلةٍ","شعارُ فرسانها الإقدام والقحمُ",46,"م",1,0],["لو شئتِ حييتِ نَشاوَى الهوى","من لون خدّيك بتفاحتيك",47,"ك",1,0],["لَو شِئتُ لَقُلتُ لِقافِيةٍ","في الوَزنِ تَخِبُّ إِلَيكَ خِدي",48,"د",2,0],["لو شمَّها صاحٍ عَسيرٌ سُكْرُهُ","تحتَ لثامٍ في فدامٍ لَطَفَحْ",49,"ح",1,0],["لَو شَرَحتِ الغَداةَ يا هِندُ صَدري","لَم تَجِد لي يَداكِ يا هِندُ قَلبا",50,"ب",2,0],["لَو شِئتُ طُلتُ بِهِ الثُرَيّا قاعِداً","وَنَشَرتُ عِقدَ كَواكِبَ الجَوزاءِ",51,"ا",2,0],["لَو شاءَ نَسَخَ اللَيلِ صُبحاً لَاِنتَحى","فَمَحا سَوادَ اللَيلَةِ اللَيلاءِ",51,"ا",2,0],["لو شِئْتَ ما جَهِلوا السَّبيلَ ولا رَضُوا","دِيناً من النَّمط الغبيِّ ذميما",52,"م",2,0],["لَو شاءَ لِلسَبعِ الطِباقِ زِيادَةً","لَأَقامَ عَشراً فَوقَهُنَّ طِباقا",53,"ق",2,0],["لو شاءَ قتلك يا سُرا","قَةُ لم تذق طَعْمَ الحياةِ",54,"ه",1,0],["لو شاء طاح بهم قتلاً فما ملكوا","من بعد مَهلكهم قولاً ولا عملا",55,"ل",2,0],["لَو شاءَ بِالسَعدِ رَدَّ السَهمَ في لُطُفٍ","بَعدَ المُروقِ وَنالَ النَجمَ مِن أَمَمِ",56,"م",1,0],["لو شَقّ عن قلبي امتحانُ ودَادهِ","لوجدتَ من قلبي عليه حجابا",57,"ب",2,0],["لو شَيّدوا الخيماتِ تشييدَ العُلى","أمِنَتْ ديارُ ربيعةٍ أن تَخْرَبا",58,"ب",2,0],["لَو شاءَ قالَ وَلَكِن","فيهِ حَياً وَتَأَبّي",59,"ي",1,0],["لَو شِئتِ وَاللَهِ لَأَرضَيتِهِ","فَلا تُقيميهِ عَلى الياسِ",60,"س",1,0],["لَو شِئتُ أَن يُلثِمَني","فاهُ وَحَولي حِلَقُ",61,"ق",1,0],["لَو شِئتَ إِذ أَحسَنتِ لي في الكَرى","أَتمَمتِ إِحسانَكِ يَقظانا",62,"ن",2,0],["لَو شاءَ رَبُّكَ صَيَّرَ الشَرطَينِ مِن","هَذي الكَواكِبِ عِندَ أَدنى ثائِجِ",63,"ج",1,0],["لَو شاءَ رَبّي لَصاغَني مَلِكاً","أَو مَلَكاً لَيسَ يَعجَزُ القَدَرُ",64,"ر",1,1],["لَو شَكَّ بِالطَعنِ مَيتٌ لَم يَجِد أَلَماً","فَالرُمحُ فيهِ كَإِشفى الخَرزِ في الأَدَمِ",65,"م",1,0],["لَو شاءَ رَبّي أَمَرَّ مُقتَدَراً","ما نَقَضَ المَوتُ مِن مَرائِرِكُم",66,"م",1,0],["لو شاءَ أرسلَها فزلزلَ مكّةً","خَطبٌ يَضِجُّ له الحطيمُ وزمزم",67,"م",1,0],["لو شهِدتم غداةَ ثورتها الكب","رى لجَاجَ النفوسِ وهي تلهّبْ",68,"ب",1,0],["لو شَرِبا منها","ما نسِيا العهدَا",69,"د",2,0],["لَو شِئت مِما نِلت كُل عُلا","وَهتَكت كُل كَثيفَة السجفِ",70,"ف",1,1],["لَوْ شَامَ بَهْجَتَهَا وَحُسْنَ رُوَائِهَا","فِيمَا أَظُنُّ لَحَارَ عَقْلُ إِيَاسِ",71,"س",1,0],["لَوْ شَقَّ مِنْهَا لأَبْدَى","رَسْمَ الحَبِيبَ الغَالِي",72,"ي",1,0],["لَوْ شَكَا دَهْرُهُ الجَهَالَةَ مَا اسْتَعْ","صَى عَلَيْهِ إِبْرَاءُ تِلكَ الشَّكَاةِ",73,"ه",1,0],["لَوْ شِئْتِ صِيغَ مِنَ الفَرِيدِ وَمَا وَفَى","لَكِنْ أَبَيْتِ وَكَانَ خَيْرَ إِبَاءِ",74,"ا",2,0],["لو شئتُ موتا لابنتي لأخذتها","وجعلت طهري قدوة لرفاقي",75,"ق",2,0],["لو شام هومير لمحا من أشعّتِها","للألأت عينُهُ وانجابَ داجيها",76,"ي",3,0],["لو شُووِرَتْ فيهِ بنو هاشمٍ","لقَدَّمَتْهُ عن تَراضِيها",77,"ي",3,0],["لَو شِئتَ عُدتَ إِلى التَناصُفِ في الهَوى","وَبَذَلتِ مِن مَكنونِهِ ما أَبذُلُ",78,"ل",1,0],["لَو شَهِدْتَ الردَى يَحُومُ عَلَيْهِ","وَالْمنَايَا تَرْمِي لَهُ الأُحْبُولاَ",79,"ل",2,0],["لو شدَّ مثلك من قديمٍ أَزَرَهُ","لتناولت يدُهُ الثريَّا قاعدا",80,"د",2,0],["لو شئتَ أعطتكَ الحياةُ زِمامَها","ولها على كَفِّ الشَباب زِمام",81,"م",1,0],["لو شئتَ ، عن شرفٍ اردتَ فصِدْتَهُ","بَدَلاً ، لكانت صبوةٌ وغَرام",81,"م",1,0],["لوشئتَ ؟ لكن شاءَ مجدُك غيرَها","فتلقَّفَتْك من الثرى أكوام",81,"م",1,0],["لوْ شاءَ، لا بورِكَتْ مَشِيئَتُهُ،","أَ بْلَغَها بالطّلاقِ مَأمَنَها",82,"ن",3,0],["لَوْ شِئْتُ زِدْتُ الكاشِحينَ من الجوَى،","وَوصَلْتِ خِلّةَ عاشِقٍ لَمْ توصَلِ",83,"ل",1,0],["لوْ شِئتِ عُدْتِ إلى التّناصُبِ في الهَوَى،","وَبَذَلْتِ مِنْ مَكْنُونِهِ ما أبْذُلُ",84,"ل",1,0],["لَوْ شَاهَدَ الشَّريفُ ما اعتَرَضَتْ","عَائِقةٌ فِي الحَبيبِ تَعْتَرِضُ",85,"ض",1,0],["لو شاركتْك بنو حواءَ في دمه","لكُب كبوا يا بن بنت النار في سقر",86,"ر",1,0],["لو شاهَد الورْدُ أحَايِينَهُ","لو تَرَ ورْداً غيْرَ مَسْفُوحِ",87,"ح",1,0]]}