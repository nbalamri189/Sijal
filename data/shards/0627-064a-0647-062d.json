{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[96,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[469,"ليس على الصب المغنى جناح","https://www.aldiwan.net/poem3474.html","عموديه"],[482,"هل في المنازل بعد القوم آثار","https://www.aldiwan.net/poem15240.html","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53222","الكامل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105669","الكامل"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34739","السريع"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66460","البسيط"],[5186,"من مغيثي، من منصفي، من مجيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=156554",""],[5277,"مطوقةُ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=191685",""],[6102,"هيت لك","https://www.poetsgate.com/ViewPoem.aspx?id=185305",""]],"verses":[["إيهٍ حماةَ الشرق كم بجهادكم","تشدو العصور بعيدها وقريبها",0,"ب",3,0],["إيه حكيم الدّهر أيّ مليحة","ضنّت عليك بعطرها الفوّاح",1,"ح",1,0],["أيه حمامَ الأيكِ أنتَ الذي","أحزنهُ وجدي فغنَّى وناحْ",2,"ح",1,0],["اِيهٍ حديثَكَ عن نَعمانَ أين مضى","سكانُه فحديثُ الوجدِ أسمارُ",3,"ر",1,0],["إيه حمامات الأراكة رَجِّعي","نغم الحنين بأبرق الحنّان",4,"ن",1,0],["ايه حبيبي قد تحكم بي الهوى","وكذا الصبابة شأنها التحكيم",5,"م",1,0],["أيةُ حالٍ يا ابنَ رامين","حالُ المحبِّين المساكينِ",6,"ن",1,1],["إيهٍ حديث الرضا عنه وإن ترني","من المجانين فاحسبني من العقلا",7,"ل",2,0],["إيه حظ الأديب! حتى من الآ","داب تمضي بقسمة المغدور!",8,"ر",1,0],["إيهٍ حمامةُ فآشفعي عند الذي","أعطاك كحل الحسن في الأحداق",9,"ق",1,0],["إِيْهٍ حَبِيْبِيَ زَعْزَعَتْنِي حِيْرَتِي","- قَالَتْ - فَثَبِّتْنِي بِثَغْرِكَ يَا مَلَكْ",10,"ك",1,0]]}