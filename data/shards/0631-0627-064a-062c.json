{"poems":[[107,"أبا سفيان أي دم تريد","https://www.aldiwan.net/poem43580.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[164,"سماط ما أراه أم مناخ","https://www.aldiwan.net/poem58912.html","الوافر"],[325,"مدحي لذاتك مفروض ومسنون","https://www.aldiwan.net/poem67139.html","البسيط"],[411,"أخ كان لي وهو الحليف المساعد","https://www.aldiwan.net/poem49419.html","الطويل"],[591,"ليت شعري من قد أحل الخياما","https://www.aldiwan.net/poem17744.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48552","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38890","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70676","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48327","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91382","الطويل"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69296","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52175","المجتث"]],"verses":[["رأى جبلاً ترى الشُّمُّ الرَّواسي","جَلالتَهُ فترجف أو تَمِيدُ",0,"د",1,0],["رأى جمالاً سبى فَقاسى","دون وصول إليه ياسا",1,"س",2,0],["رأى جسمَ حواءَ فاشتاقَه","فهاجتْ به النزوة المُسْكِرَهْ",2,"ه",1,0],["رأى جملاً سميطا","كما هو لا انكسار ولا انشداخ",3,"خ",1,0],["رَأى جَميلُ وَأَعمالٍ أَحاطَ بِها","جَليلُ حَزمٍ وَإِتقانٌ وَتَحسينُ",4,"ن",1,0],["رأى جده في ذروةِ المجدِ صاعداً","فأطغاهُ جَدٌّ فوقَ جَدي صاعِدُ",5,"د",1,0],["رَأَى جَسَدِي وَالدَّمْعَ وَالقَلْبَ والحَشَى","فَأَضْنَى وَأَفْنَى واسْتَمَال وَتيَّما",6,"م",2,0],["رأى جمل حشائش فاشتهاها","وفاجأها ليجعلها غذاءَ",7,"ا",2,1],["رَأى جُرحَ قَلبي مِن سِهامِ جُفونِهِ","فَقالَ بَليغٌ موجبٌ للبوارِ",8,"ر",1,1],["رأى جِدَّها هزلاً فأصبح راقياً","إلى دَرَجاتٍ تَبلغُ الغايةَ القُصوى",9,"و",2,0],["رأَى جُودَهُ للقاصِدينَ مؤَمَّلاً","فأصْبحَ مُغْرىً بالمكارِمِ مُغْرَما",10,"م",2,0],["رَأَى جَوهرَ الدرّ الثَنايا منظَّما","لذا كذبَ النَّظَّامُ حَتّى تفلسفا",11,"ف",2,0],["رأى جلدَةً مِن آلِ حامٍ مَتينَة","وَرأساً كأَمثالِ الجَريبِ مُؤَوَّما",12,"م",2,0],["رأى جحى ذاتَ يومٍ","لَدى القضاةٍ المحامي",13,"م",2,1]]}