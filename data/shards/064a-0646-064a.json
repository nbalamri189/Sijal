{"poems":[[55,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[65,"أضاء بريق بالعذيب كليل","https://www.aldiwan.net/poem46146.html","الطويل"],[79,"قل للأشوني ولا تحتشم","https://www.aldiwan.net/poem36657.html","السريع"],[32,"عفا الزرق من مي فمحت منازله","https://www.aldiwan.net/poem29545.html","الطويل"],[4,"أرى النفس لجت في رجاء مكذب","https://www.aldiwan.net/poem21149.html","الطويل"],[53,"بدا الشيب في رأسي فجلى عمايتي","https://www.aldiwan.net/poem9435.html","الطويل"],[53,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[87,"على أي الجنان بنا تمر","https://www.aldiwan.net/poem63714.html","الوافر"],[82,"بني الثغر لستم في الوغى من بني أمي","https://www.aldiwan.net/poem31307.html","الطويل"],[82,"ثلاثة أفلاك عن العين مضمره","https://www.aldiwan.net/poem31435.html","الطويل"],[82,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[69,"لا تظلموني وتظلموا الحسبه","https://www.aldiwan.net/poem18043.html","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54840","الوافر"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[96,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=13793",""],[154,"اعد ذكر خير الخلق فالعود أحمد","https://www.aldiwan.net/poem68577.html","الطويل"],[266,"تذكر مهدا بالغوير ومعهدا","https://www.aldiwan.net/poem38337.html","الطويل"],[310,"ينهي إليك سلاما جارك الجنب","https://www.aldiwan.net/poem56608.html","البسيط"],[327,"ألا هاج قلبي العام ظعن بواكر","https://www.aldiwan.net/poem56358.html","الطويل"],[360,"إني امرؤ لا أقيل الخصم عثرته","https://www.aldiwan.net/poem61029.html","البسيط"],[376,"لا تستطل بالذي تأتي به السحب","https://www.aldiwan.net/poem57528.html","البسيط"],[409,"صدقت فمدح الله أشرف ما يتلى","https://www.aldiwan.net/poem34173.html","الطويل"],[422,"فؤاد كطرفك أمسى عليلا","https://www.aldiwan.net/poem54167.html","المتقارب"],[457,"للمرء مالان إحسان وسيئة","https://www.aldiwan.net/poem13887.html","البسيط"],[463,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[466,"ولو أن نكسا خامل الذكر جاهلا","https://www.aldiwan.net/poem15409.html","الطويل"],[466,"ينيخ المسيف النضو منه بممرع","https://www.aldiwan.net/poem15487.html","الطويل"],[466,"ومن آل المظفر عبقري","https://www.aldiwan.net/poem16032.html","الوافر"],[466,"يدر بلاغات اللسان مديحه","https://www.aldiwan.net/poem16358.html","الطويل"],[469,"قفا في ذمام الدمع بين الملاعب","https://www.aldiwan.net/poem3188.html","عموديه"],[469,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[484,"حللت قلبي يا ابني","https://www.aldiwan.net/poem37055.html","المجتث"],[511,"ينيل المرء تبصرة وذكرى","https://www.aldiwan.net/poem2386.html","الوافر"],[543,"تجلت معاني الطعن من قدك اللدن","https://www.aldiwan.net/poem47919.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122535","الطويل"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102034","الطويل"],[692,"","https://poetry.dctabudhabi.ae/diwan/poem/203771","الرجز"],[466,"","https://poetry.dctabudhabi.ae/diwan/poem/63347","السريع"],[840,"","https://poetry.dctabudhabi.ae/diwan/poem/143242","الطويل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100125","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59107","الطويل"],[1172,"","https://poetry.dctabudhabi.ae/diwan/poem/111299","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64787","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144115","المجتث"],[1356,"","https://poetry.dctabudhabi.ae/diwan/poem/200258","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49071","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48957","السريع"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48949","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49614","الطويل"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29561","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71076","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53139","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121196","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93580","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137021",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204656","المجتث"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74179","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132605","المتقارب"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132601","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146751","الطويل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104532","الطويل"],[4700,"ينيكون غزلان الحسان وَلَا أرى","https://www.poetsgate.com/ViewPoem.aspx?id=190975",""],[4767,"أنجم العلم","https://www.poetsgate.com/ViewPoem.aspx?id=92817",""],[4830,"سجايا المرء","https://www.poetsgate.com/ViewPoem.aspx?id=199666",""],[4927,"الباص العذول","https://www.poetsgate.com/ViewPoem.aspx?id=29647",""],[4927,"أنوار الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29952",""],[4927,"دَاْرُ عَفْرَاْء","https://www.poetsgate.com/ViewPoem.aspx?id=30192",""],[5024,"حمى طاهر شرق البلاد بيمنه","https://www.poetsgate.com/ViewPoem.aspx?id=99981",""],[5150,"تموز رمز الشهادة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204037",""],[5152,"عندي ألف فن","https://www.poetsgate.com/ViewPoem.aspx?id=185862",""],[5163,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=33950",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[5459,"عين العطاء","https://www.poetsgate.com/ViewPoem.aspx?id=198380",""],[5573,"اسَواَر","https://www.poetsgate.com/ViewPoem.aspx?id=204611",""],[5883,"تجربة","https://www.poetsgate.com/ViewPoem.aspx?id=24071",""],[5956,"إنك لحني ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181964",""],[5956,"حدْسي قال لي","https://www.poetsgate.com/ViewPoem.aspx?id=182219",""],[5956,"صديقي الرُّوحيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=194005",""]],"verses":[["يُنيرُ وَيُلحِمُ في خِفيَةٍ","إِلى أَن يَحوكَ مِنَ الرَأيِ بُردا",0,"د",2,0],["يُنيرُ سَناهُ مَنزِلَ الحَيِّ باللِّوى","ويُسْديهِ مِرْزامُ العَشيِّ هَطولُ",1,"ل",1,0],["يَنَّيْرُ والجَدْيُ إذا عُدِّلا","حَظُّكَ منْ شَهْرٍ ومنْ بُرْجِ",2,"ج",1,0],["يُنيفُ عَلى القَومِ الطِوالِ بِرَأسِهِ","وَمَنكِبِهِ قَرمٌ سِباطٌ أَنامِلُه",3,"ل",2,0],["يُنيخُ المَخاضَ البُركَ وَالشَمسُ حَيَّةٌ","إِذا ذُكِّيَت نيرانُها لَم تَلَهَّبِ",4,"ب",1,0],["يُنِيخُ المَطيَّ الراغبون ببابه","ولو لم ينيخُوه إذن لَتَنَوّخا",5,"خ",2,0],["ينيكُ حوْلاءَه بحضرته","غير مُراعٍ له ولا خاش",6,"ش",1,0],["يُنيفُ البَدرُ فَوقَكَ بِالهَباءِ","رَفيعاً في السُمُوِّ بِلا اِنتِهاءِ",7,"ا",2,0],["ينيرُ عليه صَبْرَهُ وهو نَشْرَةٌ","لتسريدها أمْنٌ من القَوْرِ والقَصْمِ",8,"م",1,0],["يُنيرُ على البعدِ ائتِلاقاً كَأَنَّما","على الشطِّ لقى لجُّهُ منه جَوهَرَه",9,"ر",2,0],["يُنير سَريرُ المُلكِ مِنهُ بِأَروعٍ","سَنا نورِهِ يَجلو قَذى الأعيُنِ الرمدِ",10,"د",1,0],["يُنِيلُ نَيْلَ الفُسوقِ مِنْ فَمهِ","لا بارَكَ اللَّهُ فيهِ مِنْ جعْبَهْ",11,"ب",2,0],["يُنِيلُ الرَّائِدُ المُصْطَافُ","مَا يَهْوَى وَيَخْتَارُ",12,"ر",1,0],["ينيلُ بلا وعدٍ إذا النيْلُ لم يكن","بغير وعيدٍ قبله وهَرير",13,"ر",1,0],["ينيخ ذوو الحاجات فيها رحالهم","وتصهل في أفيائها الضمّر القبّ",14,"ب",1,0],["يُنيخُ أُولو الحاجاتِ طُرّاً بِبابِهِ","فَيَلقونَ أَمناً في المَماتِ وَفي المَحيا",15,"ي",2,0],["ينيبلك ما فوق المراد بركضه","فتدرك منه اليوم ما ترتجي غدا",16,"د",2,0],["يُنئيه عنك على قربِ المزار حياً","إِنّ الحياء مَع الحرمان مصطحبُ",17,"ب",1,0],["يُنِيمُ حَصادَ الزَرعِ بَعدَ اِرتَفاعِهِ","فَتَفنى قُرونٌ وَهوَ لِلزَرعِ آبِرُ",18,"ر",1,0],["ينير وجهي اذا جد الخصامُ بنا","ووجهُ خصمي تراه الدهر ملتَمَعا",19,"ع",2,0],["ينير في السلم نور المشتري معه","وفي الحروب مع المريخ يلتهبُ",20,"ب",1,0],["ينيلك ما ترجوه من أي مطلب","فسل ما تشا من مطلب الدين والدنيا",21,"ا",1,0],["يُنيل وإن لامه الَّلائمون","ومن يمنع الغيث أن لا ينيلا",22,"ل",2,0],["ينيل هذا وذا من أهلِه كرماً","وغيره في كلا الحالين معذولُ",23,"ل",1,0],["ينيلك وهو أصفرُ منك كفّاً","كساقي الماء واستبقَى أوامَهْ",24,"م",2,0],["يُنيخُ الرجالُ المُسنتون بأرضهِ","إِلى ناضرٍ من خُرَّم العيش اُغْيد",25,"د",1,0],["يُنيخُ المُسيف النِّضوَ منه بممرعٍ","خصيبٍ على حبي المواطرِ ناضِر",26,"ر",1,1],["يُنيخُ الجارُ منه إِلى هُمامٍ","وشيكِ النَّصْرِ مرْجوِّ النجاحِ",27,"ح",1,0],["يُنيخُ طريدُ الحَيِّ من حَجَراتِه","إلى أريحيٍّ يمنعُ الجارَ والحِمى",28,"م",2,0],["ينير منار الشمس ليس بكاسفٍ","ويبقى الدهر ليس بذاهب",29,"ب",1,0],["ينير سنا وجهٍ ويدجو ذوائباً","فيا حسنهُ يوماً يضيءُ ويظلم",30,"م",1,0],["ينير قلبك علما","بالعلم يأتي الرقي",31,"ي",1,0],["يُنيل المرء تبصرةً وذكرى","إذا ما ابيضّ فوداه وشابا",32,"ب",2,1],["يُنيرُ دَياجِيرَ المَشاكِلِ فِكرُهُ","ويَأتي بِفَضلِ القَولِ جَزماً بلا ظَنِّ",33,"ن",1,0],["يَني الفَلَكُ الدَّوارُ جَرياً ولا يَني","نوالاً وَينبُو المشرَفيُّ ولا يَنبُو",34,"ب",2,0],["ينيطون حجبا للنساء فيصبحوا","بها تحت وبل دائم وبلاء",35,"ا",2,0],["ينير فبرير مارس للروم","أبريل مايه خامس المعلوم",36,"م",1,1],["ينيه ويليه ثم اغشت شتنبر","أكتوبر نونمبر دجنبر",36,"ر",1,0],["يُنيخُ منه جارهُ بالنَّدى","والعُرْفِ والخصْمُ بجعْجاعِ",37,"ع",1,0],["ينيكون غزلان الحسان ولا ارى","غزالاً من الغزلان فرداً بساحتي",38,"ي",1,1],["ينيلون من قد نال منهم فلا يرى","لهم بسوى الرقد العميم عقاب",39,"ب",1,0],["ينيلُ مُحِبِّيهِ وَيُفْنِي عِدَاتِهِ","فَيَأتِي عَلَى الحَالَيْنِ بِالنَّفْعِ وَالضَّرِ",40,"ر",1,0],["ينيكها حاكمنا تارة","وتارة ترضى بأمثاله",41,"ل",2,0],["يُنِيلُ فلا مالٌ يُقِلُّ ولا عُلاً","ويسطو فلا بَرٌّ يُقِلُ ولا بَحْرُ",42,"ر",1,0],["ينيك زوجةَ زيدٍ","لأنّ زيداً ينيكه",43,"ك",2,0],["ينير ذرى الأفواز ومض التياحه","كما شعشع الساقي كؤوساً لشارب",44,"ب",1,0],["يُنيرُ سويداءَ القلوبِ ونوره","سوادَ المآقي في المحاجرِ يغمد",45,"د",1,0],["يُنير في قلبي سويداءَه","بغُرّةٍ كالصارم المُشرَع",46,"ع",1,0],["ينيرون ظلماء الجهالة بالهدى","ولم أرَ ليلاً كالجهالة مُظلما",47,"م",2,0],["ينيرُ هلالاً في دُجى هَبواتِنَا","فتطلعُ شُهباً في سَمَاها ذَوَابِلُهُ",48,"ل",2,0],["يُنيلانِ بِاللَهِ المَجيدِ لَقَد ثَوى","لَدى حَيثُ لاقى زَينُها وَنَصيرُها",49,"ر",3,0],["يَنِيفُ على كلّ البلاد كأَنَّها","لديه رعايا وَهْوَ أَقْهَرُ والِ",50,"ل",1,0],["ينير الهدى منك النهوض إلى العدا","وخوض الردى في وقت تخشى الوقائع",51,"ع",1,0],["ينيلهما من شاء وهو لقادر","وماذا علو في عفيف موفق",52,"ق",1,0],["يَنيخون بِالوادي الخَصيب رِكابهم","فَيَحلو لَها المَرعى وَيَصفو لَها الوَرد",53,"د",1,0],["ينير ليالي المشكلات بثاقب","من الرأي كالصبح المنير اذا بدا",54,"د",2,0],["ينير ظلمة نفسي","بنوره الوقاد",55,"د",1,0],["يُنير ظَلام الشك نير عقله","فَيرفَع مَخفوضاً وَينصب مُبتَدا",56,"د",2,0],["ينير الغوامض ان اشكلت","بلامعة من وميض الفكر",57,"ر",1,0],["ينيلك قبل العرق بشراً ففي الندى","وفي الخلق منه روضة وغدير",58,"ر",1,0],["ينير أطراف الرقيع البعاد","كأنه والنوء عنفاً قصف",59,"ف",1,0],["يُنيرُ ما بَينَ المَنارَينِ بِهَا","قَصرٌ لَهُ قَصرُ سَعِيدٍ قَد عَنَا",60,"ا",1,0],["ينير الدجى من وجهه وهو حالك","ويندى الثرى من كفه وهو ماحل",61,"ل",1,0],["ينيلك منه القرب لطفا ورحمة","وأي قريب ليس تخشى بوادره",62,"ر",2,0],["ينيكون غزلان الحسان وَلَا أرى","غزالاً من الغزلان حل بساحتي",63,"ي",1,1],["ينير درب الذي يسعى بغير هدى","قد ألم الشوكُ في درب الهوى قدمه",64,"م",2,0],["يُنيرُ الداجياتِ من الليالي","خِداعاً... بالبنانِ لهُ يُشارُ",65,"ر",1,0],["يُنِيْرُ دَرْبَ غَرَاْمٍ مَاْ رَأَيْتُ بِهِ","إِلاَّ الْوُعُوْدَ الَّتِيْ تُفْضَيْ إِلَى الْخَبَلِ",66,"ل",1,0],["يُنِيْرُ بِنُوْرِهِ سُوْدَ اللَّيَاْلِيْ","وَيَخْتَرِقُُ الْعَوَاْصِفَº وَالرِّيَاْحَاْ",67,"ح",2,0],["يُنِيْرُهَاْ نُوْرُ عَفْرَاْءَ الَّتِيْ سَلَبَتْ","قَلْبِيْ فَنَاْحَتْ عَلَيَّ الْوُلُّهُ السُّلُبُ",68,"ب",1,0],["ينيخ بها أرض العدو ويبتني","مآثر مجد كان قدماً يشيدها",69,"د",3,0],["ينيرُ لنا دروباً مظلماتٍ","شهيدٌ يحملُ الأقباس زادَهْ",70,"د",2,0],["يُنيرُ العَقْلَ بِالتبيان حتى","تُحلِّقُ فوقَنا سُحُبُ الأمانِ",71,"ن",1,0],["ينئى بها ليلي لتخفى","عن ناظريَّ فلا تزول",72,"ل",1,0],["ينيب إلى من ليس يملك ذرة","ويرغب في مأمول ما منه