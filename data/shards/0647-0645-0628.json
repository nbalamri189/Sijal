w.poetsgate.com/ViewPoem.aspx?id=187617",""],[5338,"أين الحميا من لمى من أرتجي","https://www.poetsgate.com/ViewPoem.aspx?id=187696",""],[5409,"أنت والحق في العلو سواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=155491",""],[5540,"الترتر","https://www.poetsgate.com/ViewPoem.aspx?id=215061",""],[5558,"لنْ نَرى مِثلَ رُقِيِّ الشُّهَداءِ","https://www.poetsgate.com/ViewPoem.aspx?id=211876",""],[5582,"أَشَجاكَ لِعاتِكَةٍ طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=63553",""],[5672,"صمت النوى","https://www.poetsgate.com/ViewPoem.aspx?id=206499",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5776,"قصيدةُ الخُلْد","https://www.poetsgate.com/ViewPoem.aspx?id=199279",""],[5776,"وَصَايَاهُم","https://www.poetsgate.com/ViewPoem.aspx?id=199441",""],[5956,"حرِّروا نيويورك من صهيونها","https://www.poetsgate.com/ViewPoem.aspx?id=194434",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[6229,"أمّتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65214&r=&rc=37",""]],"verses":[["همُ بَخِلوا بِطاعَتِهِمْ ولكنْ","على الأسَلاتِ بالأرْواحِ جادوا",0,"د",3,0],["هُمُ بَيضُ الرَمادِ يُشَقُّ عَنهُم","وَبَعضُ البَيضِ يُشبِهُهُ الرَمادُ",1,"د",1,0],["هم بذا هَيَّئُوا البلاد لحرب","لم تَقِدْ عندنا لها اليوم نار",2,"ر",1,0],["همَّ بشغلي بمَعْملٍ فرأى","أنَّ أطْرافي تُجِمُّ آثامي",3,"م",2,0],["هُم بَعَثوا فِيَّ الحَياةَ جَديدَةً","فَشُدتُ أَواخيه وَعَزَّت أَواصِرُه",4,"ر",2,0],["هُم بَنو مِصرَ لا الجَميلُ لَدَيهِمُ","بِمُضاعٍ وَلا الصَنيعُ بِمَنسي",5,"س",2,0],["هُمُ بَعدَ أَمرِ اللَهِ شَدّوا حِبالَها","وَأَوتادَها فينا بِأَبيَضَ ثاقِبِ",6,"ب",1,0],["هُم بَينَ أَطباقِ التُرابِ فَنادِهِم","أَهلَ الدِيارِ الخالِياتِ الخاوِياتِ",7,"ت",1,0],["هَمَّ بِنا قَبلَ أَن نَهُمَّ بِهِ","فَجادَنا قَبلَ أَن سَأَلناهُ",8,"ا",2,0],["هُمْ بَجَّلوهُ بِباطِلٍ فابْتَزَّهُ","أَعْداؤُهُ بالباطِلِ التَّبجِيلا",9,"ل",2,0],["هُمُ بَعُدُوا عنهم على قُرْبِ دارِهم","وجَحْفَلُكَ الدّاني وأنتَ بَعيد",10,"د",1,0],["هَمٌّ بِأَسوِدَةِ القُلوبِ مَناخُهُ","لِبيضِ حينَ أَنَخنَ بِالأَفوادِ",11,"د",1,0],["هم بلغوا نهاية التمرّد","وطردوا الإسلام كلّ مطرد",12,"د",1,0],["هَمٌّ بِأَجْنِحَةٍ تُرَا","وِدُهُ المَجَرَّةُ وَهْوَ ظَامِ",13,"م",1,0],["هُمْ بِالحَمِيِّةِ خَيْرُ مَنْ يَرْجُو الحِمَى","لِسَدَادِ خَلاَّتٍ وَدَرْءٍ نَوَائِبِ",14,"ب",1,0],["همّ بالموت والظنون توارى","حوله الخوف تارة وتشيعه",15,"ع",2,0],["همٌّ بأسوِدَةِ القُلوبِ، مَناخُهُ","للبِيضِ، حينَ أنَخْنَ بالأفواد",16,"د",1,0],["هم بالرسول وبالحسين واحمد","اسد الغيوب وسيفهم بتار",17,"ر",1,0],["هم برزخ الشرف الرفيع وفي الخفا","أخذوا النبي ملاحظاً وعميدا",18,"د",2,0],["هم بالمديح أحق لكن ربما","ضاعت حقوق بالعدا والعذل",19,"ل",1,0],["هم بيض ليلاتِ المواهب نهزها","وهم سود أيام الوقائعِ جونُها",20,"ن",3,0],["هُمُ بِخَزازَى دافَعُوا عَنكُمُ العِدى","وَذَلِكَ يَومٌ مُمقِرُ الطَعمِ باسِلُ",21,"ل",1,0],["هُمُ بَذَلُوا فيما يَسُرُّكَ أَنفُساً","كِراماً وَنارُ الحَربِ يَعلُو اِشتِعالها",22,"ل",3,0],["هُمُ بَنُوهُ فَلا ميلٌ وَلا عُزُلٌ","وَلا تَرى فيهمُ وَهناً وَلا سَأَما",23,"م",2,0],["هُم بِقولِ اللَّه كانوا أعرَفا","مِن سِواهم وَمعاني السننِ",24,"ن",1,0],["هُمُ بَنو الحَربِ وَالمَوتِ الذُعافِ إِذا","لاقى الكَتائِبَ مِنهُمُ قادَةٌ صُبُرُ",25,"ر",1,0],["هُم بُدورُ الأَجيالِ هُمُ شُعراءُ ال","أَرضِ هُم كَهرَباءُ هذا الأَثيرِ",26,"ر",1,0],["هُمُ بَدَءُوا الْعُلى فَسَمَوْا عُلُوَّاً","وَأَنْتَ لِخَيْرِ ما بَدَؤُوا مُعِيدُ",27,"د",1,0],["هُم بضعةٌ مِن رسولِ اللّه طيّبةٌ","مُؤثّل فضلُها الذاتيُّ والكرمُ",28,"م",1,0],["هُم بِهِ ساروا وَلا بَرحوا","سَمَحوا بِالوَصل أَو هَجَروا",29,"ر",3,0],["هُم بَنو الغندور أَرباب التُقى","آل فتحِ اللَه نَسل الصُلحا",30,"ح",2,0],["هَمُ بدأوا وأنت تُتِمُّ كُلاًّ","فلم يَكُ بالتّمامِ لهمْ يَدان",31,"ن",1,0],["هُمُ بَصيرَةُ نَفسي","وَهُم ذَخيرَةُ دَهري",32,"ر",2,0],["هُم بَقَرٌ قُل نَعَم وَهُم نَعَم","قَد جُعِلَت لِلسُّيوفِ مَعلوفَه",33,"ف",2,0],["هم بذلوا في حفظ سنة أحمد","وتنقيحها من جهدهم غاية الجهد",34,"د",1,0],["هم بالتفضُّلِ أولى وهوَ شيمتُهُم","فلا تخف دركاً منهُم ولا ضَرَرا",35,"ر",2,0],["هم بالقَطاقِطِ منّوا في تَميمِهُمُ","من بعدِ حول وما منّوا ولا ماتوا",36,"ت",3,0],["هم بِضعةٌ منا فإن لم نَحمهم","فالعارُ يومَ مصابهم أن يرجَموا",37,"م",3,0],["همُ بحور النَّعماءِ زاخرةً","فلذْ بشم اليفاع إن سيلوا",38,"ل",3,0],["هم بحار الجود الزواخر ينجي","موجها المدقعين والأيتاما",39,"م",2,0],["هُم بِالوِصالِ أَعادوها إِلَيكَ فَلم","ذَخَرتَها بَعدَهُم لِلصَبرِ وَالجَلَدِ",40,"د",1,0],["هُمْ بحِفْظِ اللهِ يا مِسْكينُ نَمْ","أَنْتَ بالوَهْمِ أَدَرْتَ الفَلَكَا",41,"ك",2,0],["هُمْ بعَيْنِ المُصْطَفى في مَدَدٍ","كلَّما حارَبْتَهُمْ حارَبَكا",41,"ك",2,0],["همُ بالقلبِ لا بالخَيفِ حلّوا","وفي جمَراتِه اِتّخذوا دِيارا",42,"ر",2,0],["هُمُ بِلا الْتِباسِ","في ذَا هُدَاةُ النّاسِ",43,"س",1,0],["هم بقلبي حلّوا مكان السويدا","ومن العين في مكان السواد",44,"د",1,0],["هِمْ بحَرْف العَيْنِ واعْشَق أهْلهُ","تَعْلم المعْنى مِنَ السّرِّ المصُونْ",45,"ن",1,0],["هم بُزَاةٌ كواسِرٌ آكلاتُ ال","لحم ما همُ طيورُ لَقْط الحَبِّ",46,"ب",1,0],["هُم بضعةُ الندب الحسين ومَن زَكى","أصلاً وآباء همُ النُجباءُ",47,"ا",2,1],["هم بارزوا الأعداءَ واستوردوا الوغى","بِبدرٍ وما يومٌ بأعظمَ من بدرِ",48,"ر",1,0],["هم بعلم وفي ندى ونزال","أرشدوا أرفدوا أرعوا حماما",49,"م",2,0],["هم بالهوى يكتبون المخزيات لهم","ويحلمون بتصديق وتأمين",50,"ن",1,0],["همْ بذلوا المعروفَ في أهلها","وصاحبوُها بخيارِ الخصال",51,"ل",1,0],["هم بنوا شرفاً وعطوا سرفاً","واِقتفوا سلفاً ما به دخلُ",52,"ل",1,0],["هم بدور سما العليا وصبيتهم","أهلة فيه أن يستنظموا كملوا",53,"ل",3,0],["هم بوادٍ وكنت عنهم بوادٍ","فلهذا تعذَّر الإلتقاءُ",54,"ا",2,0],["هم بنو السؤدد القديم كما هم","إخوة المجد واحداً وعشيرا",55,"ر",2,0],["هم بنو المصطفى ومَن في البرايا","كبني المصطفى سماحاً وبرَّا",56,"ر",2,0],["هم به للسماح خمسة أنهار","وذا فيك للمجرَّة نهر",57,"ر",1,0],["هِمْ بالغزالة والغزلْ","واترك ملامةَ من عذلْ",58,"ل",1,1],["هِم بالجمال فلست أول هائمِ","أو مت فما لك لذةٌ في العالمِ",59,"م",1,1],["هم بالجحافل قد صالوا وقد غُلبوا","وأنت باللَه غلاب وصوّال",60,"ل",1,0],["همُ بيتُ المشاميل","مع النّابير الحفر",61,"ر",1,0],["هم بالنوق واهتممت بسعدي","فكلانا من جنسه ذو اشتياق",62,"ق