{"poems":[[64,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[47,"أفي كل دار منك عين ترقرق","https://www.aldiwan.net/poem65183.html","الطويل"],[46,"نوار في صواحبها نوار","https://www.aldiwan.net/poem30523.html","الوافر"],[35,"شكوت إلى رفيقي الذي بي","https://www.aldiwan.net/poem25726.html","الوافر"],[580,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1078,"","https://poetry.dctabudhabi.ae/diwan/poem/131929",""],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112872","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132234","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27537","الطويل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67245","الطويل"],[2630,"","https://poetry.dctabudhabi.ae/diwan/poem/107320","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100840","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91273","الطويل"],[4442,"مواهب كفك لا تحتقر","https://www.poetsgate.com/ViewPoem.aspx?id=171213",""]],"verses":[["فلوذوا بحَقو العفوِ منه فإنَّه","جوادٌ به حتى يُقالَ غَفُولُ",0,"ل",1,0],["فَلَو ذارَعَت أَخلاقُهُ الغَيثَ حافِلاً","لَحاجَزَها باعٌ مِنَ الغَيثِ ضَيِّقُ",1,"ق",1,0],["فَلَو ذَهَبَت سِناتُ الدَهرِ عَنهُ","وَأُلقِيَ عَن مَناكِبِهِ الدِثارُ",2,"ر",1,0],["فَلَو ذَهَبا إِلى لَيلى فَشاءَت","لَأَهدَت لي مِنَ السَقمِ الشِفاءَ",3,"ا",2,0],["فلو ذَكَرَتْه الطيرُ أَو سمَّت اسمَه","لما راعَها في جوِّها بأْسُ قَشْعَمِ",4,"م",1,0],["فلوذوا به واستشفعوا بجنابه","فما أحد منه على الله أكرم",5,"م",1,0],["فلو ذو التاجِ أبصر ذا المفدّى","لودَّ بأن يكونَ له رقيقا",6,"ق",2,0],["فلوذوا به بايها الصحب وامدحوا","فقد فاز من اضحى بمولانا لائيذا",7,"ذ",2,0],["فلو ذقت طعم الحب والوجد والهوى","وذقت بعيد الصب بعد الأحبة",8,"ه",1,0],["فلو ذاقه علماً به وعلامة","له فيه لم يبرح له الأكلُ والشُّرب",9,"ب",1,0],["فلو ذُقتما طعم الهوى لعذرتُما","أخا دَنفٍ يطوي الليالي بلا عقل",10,"ل",1,0],["فَلَو ذُقتَ مِن طَعمِ الهَوى ما وَجَدتُهُ","لَمَا كُنتَ لِي بالعَذلِ يَوماً مُفَنِّدا",11,"د",2,0],["فلو ذاقت الايام فيك مدائحي","لكان فم الايام حلو المراضب",12,"ب",1,0],["فَلو ذاقَ مرّاً قَد سَقاه لَما سَقى","وَلا سرّ مغرور بما لَيسَ يَدفع",13,"ع",1,0],["فلو ذاق ذو عنة طعمها","لضاقت به واسعات الحفر",14,"ر",1,0]]}