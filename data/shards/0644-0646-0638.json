{"poems":[[9,"أصرمت حبلك من لمي","https://www.aldiwan.net/poem21911.html","مجزوء الكامل"],[68,"خذ من الدهر لي نصيب","https://www.aldiwan.net/poem41371.html","مجزوء الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67301","الوافر"],[119,"وعزة الله ما شوقي إلى العلم","https://www.aldiwan.net/poem41774.html","البسيط"],[185,"أبلغ سلامة أنى لست ناسيها","https://www.aldiwan.net/poem58829.html","البسيط"],[482,"بي من جوى التبريح اشفاق","https://www.aldiwan.net/poem15351.html","السريع"],[539,"إلى الأمير فدته النفس أهديها","https://www.aldiwan.net/poem23814.html","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54058","الوافر"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78043","الرمل"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128740","الكامل"],[3439,"","https://poetry.dctabudhabi.ae/diwan/poem/130865","الخفيف"],[3677,"","https://poetry.dctabudhabi.ae/diwan/poem/35067","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67545","المتقارب"],[4916,"للذاكره روح وامسحني","https://www.poetsgate.com/ViewPoem.aspx?id=157794",""],[5212,"وارث النَّبي","https://www.poetsgate.com/ViewPoem.aspx?id=211736",""],[5626,"يا ريمُ رفقاً","https://www.poetsgate.com/ViewPoem.aspx?id=189508",""],[5703,"اللقاء الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=206134",""],[5829,"ونرجوا في أماسينا سرورا","https://www.poetsgate.com/ViewPoem.aspx?id=165997",""],[5897,"من وحي ال21","https://www.poetsgate.com/ViewPoem.aspx?id=158793",""]],"verses":[["لَنَظَرتُ أَنّى مُرتَقا","هُ وَخَيرُ مَسلَكِهِ عِقابُه",0,"ب",2,0],["لَنَظَمنا مِنَ الكَلام","ضِعفَ ما نَظَمَ الأُوَل",1,"ل",1,0],["لنُظْهِرَ دِينَكَ اللَّهمَّ إنَّا","بكفِّكَ فاهْدِنا سُبُلَ الرَّشادِ",2,"د",1,0],["لنظرة من إمام القوم تحصل لي","ونفحة فيهما يرقى العلا قدمي",3,"م",2,0],["لَنظرَةٌ مِن سُلَيمَى اليَومَ وَاحِدةٌ","أَشهَى إِلىَّ مِنَ الدُّنيا وما فِيهَا",4,"ي",3,0],["لنظمهِ في طبقاتِ النُّهى","يدٌ وفي الاِعرابِ اِعراقُ",5,"ق",1,0],["لنظفر اليوم باستقلال تربتنا","ونستعيد لها أمجاد ماضيها",6,"ي",3,0],["لنظمك في النفوسِ من الجزاله","محلٌّ دونه مرقى الغزاله",7,"ل",2,1],["لِنِظام الحُسن أَبدَت","طُرَّة فيها سَبَتني",8,"ن",2,0],["لنظمت حبات القلوب فرائداً","عربيةً بزهو بها مغناكا",9,"ك",2,0],["لنظمت النجوم عقداً إذا رص","صع غيري جواهراً بلآلي",10,"ل",2,0],["لِنَظَلَّ نَسقيهِم وَنَشرَب مِن قَنا","سمرٍ وَمُرهَفَةِ النُّصولِ قَواضِبِ",11,"ب",1,0],["لِنَظَلَّ الدَّهرَ هُزءاً لِلوَرى","قالَ يا هِيلانَةً لَستُ أَرَى",12,"ر",2,0],["لنظرته وخزة في الحشى","كوخز المحاجم في الملتزم",13,"م",1,0],["لنظم القصيده.. ابي ..مطلع","مضمونه..(الوجد)..ذابحني",14,"ن",2,1],["لَنَظَلَّ طولَ العُمرِ نَهتِفُ سيِّدي","وَيَظلُّ دَمعُ الشَّوقِ في الأجفانِ",15,"ن",1,0],["لِنَظَلَّ في كَنَفِ الغَرامِ يَضُمُّنا","( ناياً) على شَدَنِ الطُّيورِ وَ(عودا)",16,"د",2,0],["لِنظرَةٍ منكِ جاءَ القلبُ ظمآنا","وَقد قَطعْتُ بهذا الليلِ كُثبانا",17,"ن",2,1],["لنظم الشعر لم أجد السميرا","ولن أجدَ الفرزدق او جريرا",18,"ر",2,1],["لنظل نرقب من تهاني بسمة","ونعد سالمة من الأطيابِ",19,"ب",1,0]]}