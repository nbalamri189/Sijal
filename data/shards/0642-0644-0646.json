ى نعيم حياتنا",140,"ن",2,0],["قلنا: هو الدمع، قالوا لأ..قلنا : جميل","وش رايكم بالسكوت المُر ..قالوا : مُحال",141,"ل",1,0],["قلنا : الوطن .. لاتكاثرنا عليه القليل","وكثر فالارواح ..قالوا لأ .. قلنا : احتمال!",141,"ل",1,0],["قلنا: الصبر..قالوا: إن الصبر صبراً جميل","ماهو الصبر ياصغار. \"الليل والصبر طال\"",141,"ل",1,0],["قلنا: المطر..كان دغدغ وجه الأوطان سيل","وهزم جفاف القلوب أم الظما والرمال",141,"ل",1,0],["قلنا لهم فارجعوا إذ لا مُقامَ لكم","قالوا :وهل نستسيغ الجوع والوصبا",142,"ب",2,0],["قلنا:ركبتم عباب البحر مالكمو","ركبتم اليأس والاخفاق والعطبا",142,"ب",2,0],["قلن ما بالك تمشي حولنا","قال كم بزت فؤادي الحِبَب",143,"ب",1,0],["قلن جانب دربنا في دعة","قال فيها منيتي والرغب",143,"ب",1,0],["قلن هذا البحر فاركب متنه","قال دون البحر جيش لجب",143,"ب",1,0],["قلن ساوِرْه ففيه جوهر","قال من جوهره المخشلب",143,"ب",1,0],["قلن لو غامرته نلت الذي","تتمنى قال مات السبب",143,"ب",1,0],["قلن كم جالده الناس وكم","ذللوه : قال عاش الدأب",143,"ب",1,0],["قلن ما هذا البناء عالياً","قال بيتي ولديه العرب",143,"ب",1,0],["قلن ما أحسن ما شيّدته","قال للخائف إذ ينقلب",143,"ب",1,0],["قلن والخيل صفوفاً كالأشا","قال لي أن طاردتني النُّوَب",143,"ب",1,0],["قلن والأنعام والحرث الذي","حولها : قال إلهي يهب",143,"ب",1,0],["قلن إن كان الذي قلت لنا","هو حقا : قال ماذا يجب",143,"ب",1,0],["قلن وفقنا لما نقصده","قال وفقتن حيث الأرب",143,"ب",1,0],["قلن جئناك لأمر جلل","قال فليفلح لكُنَّ الطلب",143,"ب",1,0],["قلن جف الضرع والزرع ولم","يبق شيء : قال جفّ النصب",143,"ب",1,0],["قلن والمخرج والمنهج قد","أغلقا قال ليَنْأ التعب",143,"ب",1,0],["قلن والدهر عداء رابنا","قال لا تحكم فينا الريب",143,"ب",1,0],["قلن مال الركن وانهد بنا","قال بل عنكن مال الكرب",143,"ب",1,0],["قلن والطارف والتالد قد","نضبا قال ليغن الرهب",143,"ب",1,0],["قلن والليل فلا ليل لنا","مصبحاً قال إليَّ انقلبوا",143,"ب",3,0],["قلن ماذا قال رزقي قسمة","بيننا التالد والمكتسبُ",143,"ب",1,0],["قلن والعش الذي انهد بنا","قال عرشي دونه والقببُ",143,"ب",1,0],["قلن شكراً قال لا شكر على","واجب نصّت عليه الكتب",143,"ب",1,0],["قلن من لم يشكر الناس فلم","يشكر ا