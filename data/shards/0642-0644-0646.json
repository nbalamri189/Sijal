{"poems":[[77,"ياروضة للأدب المجتنى","https://www.aldiwan.net/poem36006.html","السريع"],[77,"جعسوس ثعلب مكر","https://www.aldiwan.net/poem36084.html","المجتث"],[77,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[9,"كانت وصاة وحاجات لنا كفف","https://www.aldiwan.net/poem21952.html","البسيط"],[35,"ما عناك الغداة من أطلال","https://www.aldiwan.net/poem39094.html","الخفيف"],[23,"لا تنكرن قريش فضل صاحبنا","https://www.aldiwan.net/poem21553.html","البسيط"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"وطائف باسته على طبق","https://www.aldiwan.net/poem65879.html","المنسرح"],[70,"عزلوه لما خانهم","https://www.aldiwan.net/poem42808.html","مجزوء الكامل"],[85,"اسمعنا بارنج في صده","https://www.aldiwan.net/poem7265.html","السريع"],[85,"بدأ الطيف بالجميل وزارا","https://www.aldiwan.net/poem7774.html","الخفيف"],[85,"طال عليها القدم","https://www.aldiwan.net/poem63695.html","مجزوء السريع"],[43,"أتراها لكثرة العشاق","https://www.aldiwan.net/poem9745.html","الخفيف"],[45,"عاد للصب شجوه واكتئابه","https://www.aldiwan.net/poem10654.html","الخفيف"],[45,"من يأمن البلوى وبينا فتى","https://www.aldiwan.net/poem65213.html","السريع"],[45,"بعدوك الحدث الجليل الواقع","https://www.aldiwan.net/poem64709.html","الكامل"],[61,"باليمن ما رفع الأمير وشيدا","https://www.aldiwan.net/poem51710.html","الكامل"],[69,"صاحب سيس الجديد نادى","https://www.aldiwan.net/poem28075.html","مخلع البسيط"],[69,"لما رأى الزهر الشقيق انثنى","https://www.aldiwan.net/poem28832.html","السريع"],[69,"قلنا له دع أمورا","https://www.aldiwan.net/poem29200.html","المجتث"],[31,"قلت بالخيف مرة","https://www.aldiwan.net/poem41328.html","مجزوء الخفيف"],[31,"هل عرفت اليوم من شن","https://www.aldiwan.net/poem41331.html","مجزوء الرمل"],[31,"مرحبا ثم مرهبا بالتي قا","https://www.aldiwan.net/poem41862.html","الخفيف"],[31,"هيج القلب مغان وصير","https://www.aldiwan.net/poem42520.html","الرمل"],[31,"نام صحبي وبات نومي عسيرا","https://www.aldiwan.net/poem42530.html","الخفيف"],[31,"يا صاحبي قفا نستخبر الدارا","https://www.aldiwan.net/poem42542.html","البسيط"],[31,"بكر العاذلات فيها صراحا","https://www.aldiwan.net/poem42587.html","البسيط"],[31,"حدث حديث فتاة حي مرة","https://www.aldiwan.net/poem42666.html","الكامل"],[105,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[52,"ضحك المشرفات في يوم عيد","https://www.aldiwan.net/poem26613.html","الخفيف"],[48,"قد أغتدي والليل في إهابه","https://www.aldiwan.net/poem62456.html","الرجز"],[48,"وفتية كمصابيح الدجى غرر","https://www.aldiwan.net/poem62458.html","البسيط"],[48,"باكر صبوحك فهو خير عتاد","https://www.aldiwan.net/poem62550.html","الكامل"],[48,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[46,"لو كنتم أهل صفو قال ناسبكم","https://www.aldiwan.net/poem22122.html","البسيط"],[46,"رآني في الكرى رجل كأني","https://www.aldiwan.net/poem22840.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54712","الخفيف"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50449","الرجز"],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[106,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[77,"أبدى لِداعي الفوزِ وجْهَ مُنيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33318",""],[31,"حَدِّثْ حَديثَ فتاة ِ حَيٍّ مرّة ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18737&r=&rc=0",""],[31,"يا صاحبيّ، قفا نستخبرِ الدارا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18860&r=&rc=123",""],[115,"من الهوى آه","https://www.aldiwan.net/poem40430.html","عموديه"],[115,"دار السرور بنا مع الاوقات","https://www.aldiwan.net/poem41203.html","عموديه"],[115,"قلنا لقوم غينهم","https://www.aldiwan.net/poem42195.html","مجزوء الرجز"],[128,"كتب الحسن في محياك سطرا","https://www.aldiwan.net/poem50510.html","الخفيف"],[142,"يا صحابي واين منى صحبى","https://www.aldiwan.net/poem58430.html","البسيط"],[181,"زوروا بنا اليوم سلمى أيها النفر","https://www.aldiwan.net/poem58885.html","البسيط"],[189,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[198,"وأغيد طاف بالكؤوس ضحى","https://www.aldiwan.net/poem51972.html","المنسرح"],[199,"وأغيد قلنا لها هاتها","https://www.aldiwan.net/poem45547.html","السريع"],[204,"من عينه قط لم تلتذ بالنظر","https://www.aldiwan.net/poem53271.html","البسيط"],[206,"فرح الزمان فضاء بالأنوار","https://www.aldiwan.net/poem919.html",""],[210,"تريك الصبح في الليل البهيم","https://www.aldiwan.net/poem13402.html","الوافر"],[261,"هنئت بالإكرام والإعزاز","https://www.aldiwan.net/poem38261.html","الكامل"],[282,"يا ليلة بتنا ببرزة نشتكي","https://www.aldiwan.net/poem32747.html","الكامل"],[285,"أهلا وسهلا بالإمام","https://www.aldiwan.net/poem39347.html","مجزوء الرجز"],[285,"طربت بنا ريح النسيم","https://www.aldiwan.net/poem39376.html","مجزوء الكامل"],[320,"يا أيها الخل الذي لم ينسني","https://www.aldiwan.net/poem61704.html","الكامل"],[328,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[346,"جاء البريد بقرطاس يخب به","https://www.aldiwan.net/poem24140.html","البسيط"],[348,"عشقت من ريقته قرقف","https://www.aldiwan.net/poem19888.html","السريع"],[348,"هزوا قدودا وانتضوا أعينا","https://www.aldiwan.net/poem20732.html","السريع"],[366,"ورأيت أجسام العداة","https://www.aldiwan.net/poem17261.html","مجزوء الكامل"],[377,"لا عيب في الورد يذكو عرفه سحرا","https://www.aldiwan.net/poem59235.html","الطويل"],[403,"ولأهل هذي الهجرتين من الأذى","https://www.aldiwan.net/poem33397.html","الكامل"],[403,"يافخر دين الله يا من نظمه","https://www.aldiwan.net/poem33981.html","الكامل"],[406,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[416,"جسد ذاب نحولا وسقاما","https://www.aldiwan.net/poem53951.html","الرمل"],[432,"لم يشف طيفك لما زارني ألما","https://www.aldiwan.net/poem12372.html","البسيط"],[432,"رحلوا فالسقام عندي مقيم","https://www.aldiwan.net/poem12718.html","الخفيف"],[458,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[458,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[458,"حاشاك من عارية ترد","https://www.aldiwan.net/poem56234.html","الوافر"],[458,"من عذيري يوم شرقي الحمى","https://www.aldiwan.net/poem56251.html","الرمل"],[470,"قالت وقلت تحرجي وصلي","https://www.aldiwan.net/poem4643.html","أحذ الكامل"],[470,"ضنت عقيلة لما جئت بالزاد","https://www.aldiwan.net/poem4672.html","البسيط"],[500,"قالت غزيلة الغوير","https://www.aldiwan.net/poem37771.html","مجزوء الكامل"],[500,"قالوا الحمى قد جيس من أطرافه","https://www.aldiwan.net/poem37795.html","الكامل"],[529,"أقول من بعد حمد والصلاة على","https://www.aldiwan.net/poem37209.html","البسيط"],[538,"حذرته لو ينفع التحذير","https://www.aldiwan.net/poem48135.html","عموديه"],[544,"غراب على شجرة الميلاد","https://www.aldiwan.net/poem67243.html","عموديه"],[551,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[551,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[558,"العفو أليق لا جرم","https://www.aldiwan.net/poem34073.html","مجزوء الكامل"],[558,"معرفتي مخلوقة وهي لا","https://www.aldiwan.net/poem34076.html","السريع"],[558,"إن قلت إن الوجود نفس","https://www.aldiwan.net/poem34238.html","مخلع البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[586,"هويت من ريقته قرقف","https://www.aldiwan.net/poem17443.html","السريع"]],"verses":[["قُلْنَا وَقَدْ بَلَّلَهَا مَاؤُهُ","لاَ يُنكَرُ الْمَاءُ عَلَى الرَّوْضِ",0,"ض",1,0],["قُلْنَا وَلِلْيُتُمِ فِيهَا","مَخِيلَةٌ مُستَقِيمَهْ",1,"م",2,0],["قُلْنَا لِعَالَمِكَ الَّذِي شَرَّفْتَهُ","حَسَدَ الْبَسِيطُ مَزيَّةَ التَّرْكِيبِ",2,"ب",1,0],["قُلنا الصَلاحَ فَقالوا لا نُصالِحُكُم","أَهلُ النُبوكِ وَعيرٌ فَوقَها الخَصَفُ",3,"ف",1,0],["قِلنَ عُسفانَ ثُمَّ رُحنَ سِراعاً","طالِعاتٍ عَشِيَّةً مِن غَزالِ",4,"ل",1,0],["قُلنا لَهُم ثَوِّروا حَقّاً فَنَتبَعُهُ","لَسنا نُريدُ سِواهُ آخِرَ الأَبَدِ",5,"د",1,0],["قلن لولا انكشافُنا ما تجلَّت","عنك ظَلمَاءُ شُبْهةٍ قتماءِ",6,"ا",2,0],["قلن أعَجِبْ بمُهْتَدٍ يتمنَّى","أنه لم يزل على عمياءِ",6,"ا",2,0],["قُلْن هذا هوىً فعرّجْ على الحق","قِ وخلِّ الهوى لقلْبٍ هواءِ",6,"ا",2,0],["قُلْن ما الموتُ بالكريه إذا كا","ن بحقٍّ فلا تزدْ في المراءِ",6,"ا",2,0],["قلْنا له لمْ هواكَ في سفلِ ال","ناس وشرُّ الأمورِ سافلُها",7,"ل",3,0],["قُلنا كَذَبتَ لَقَد حَزِن","تَ وَقَد خَزيتَ مُصَحَّفا",8,"ف",2,0],["قلنا صدقناك نهل هكذا","يصول سيف الحق من غمده",9,"د",2,0],["قلن نبكيه قلت هاتي دموعا","قلن صبرا فقلت هاتى اصطبارا",10,"ر",2,0],["قُلنَ تَجاهَلتِهِ","ذَلِكَ رَبُّ القَلَم",11,"م",1,0],["قَلَّ نَفعُ الحَديدِ فيكَ فَما يَل","قاكَ إِلّا مَن سَيفُهُ مِن نِفاقِ",12,"ق",1,0],["قُلنَ أَينَ الشَبابُ في عَقَبِ فَوتٍ","مِنهُ قَولاً أَعيا عَلَيَّ جَوابُه",13,"ب",2,0],["قُلنا وَقَد أَنطَقَها بَعدَهُ","يا ذا اللِسانَينِ إِذا ما نَطَق",14,"ق",1,0],["قُلنا لَعاً لَمّا عَثَرتَ وَلا تَزَل","نُوَبُ اللَيالي وَهيَ عَنكَ رَواجِعُ",15,"ع",1,0],["قُلنا وقد أعلاه جَدٌّ صاعِدٌ","في الجوِّ حتى ما يُصادِفُ مَصْعَدا",16,"د",2,0],["قلنا تأهبْ لغيرِ هذا","فذا فتوحٌ على الفتوحِ",17,"ح",1,0],["قلنا على رسلِكَ قال اسكتوا","جاءَ شقيقٌ عارضاً رمحَهُ",18,"ه",1,0],["قلنا له دع أموراً","مستهجناتٍ لمثلِكْ",19,"ك",1,1],["قُلنَ بِاللَهِ لِلَّتي","سَمِعَت قَولَ ظالِمِ",20,"م",1,0],["قُلنَ قَد نادى المُنادي","وَبَدا الصُبحُ فَقوما",21,"م",2,0],["قُلنَ هَذا الَّذي نَلومُكِ فيهِ","لا تَحَجّي مِن قَولِنا بِفَتيلِ",22,"ل",1,0],["قُلنَ يَستَرضينَها مُنيَتُنا","لَو أَتانا اليَومَ في سِرٍّ عُمَر",23,"ر",1,0],["قُلنَ بِاللَهِ لِلفَتى عُج قَليلاً","لَيسَ أَن عُجتَ لِلعِتابِ كَثيرا",24,"ر",2,0],["قُلنَ اِنزِلوا نَعِمَت دارٌ بِقُربِكُمُ","أَهلاً وَسَهلاً بِكُم مِن زائِرٍ زارا",25,"ر",2,0],["قُلنَ عَزَّ الفُؤادَ عَن أُمِّ بَكرٍ","بِعَزاءٍ قَدِ اِفتَضَحتَ اِفتِضاحا",26,"ح",2,0],["قُلنَ اِنزِلوا فَتَيَمَّموا لِمَطِيِّكُم","غَيباً تُغَيِّبُهُ إِلى الإِمساءِ",27,"ا",2,0],["قُلنا صَدَقتُم وَفاضَت ديمَةٌ ذَهَبٌ","رَنّانَةُ الوَرقِ يَشجي الوُرقَ هاميها",28,"ي",3,0],["قُلنَ لَمّا رَأَينَهُ حالِكاً أَس","وَدَ جَعداً يُناسِبُ السودانا",29,"ن",2,0],["قُلنا لَهُ عَرَّهِ مِن أَسلابِهِ","فَلاحَ كَالحاجِبِ مِن سَحابِهِ",30,"ب",2,0],["قُلنا لَها كَم لَها في الدَنِّ مُذ حُجِبَت","قالَت قَدِ اِتُّخِذَت مِن عَهدِ طالوتِ",31,"ت",1,0],["قُلنا السَلامُ عَلَيكَ قالَ عَلَيكُمُ","مِنّي سَلامُ تَحِيَّةٍ وَوِدادِ",32,"د",1,0],["قُلنَ لَهُ ما تَأتَمِر","وَهُنَّ إِذ قُلنَ أَشِر",33,"ر",1,0],["قُلنا أَتانا وَلَم يُصلَب وَقَولُكُمُ","ما جاءَ بَعدُ وَقالَت أُمَّةٌ صُلِبا",34,"ب",2,0],["قَلَنسُوَةً خُصِصَت بِها نَضاراً","كَهُرمُزَ أَو كَمَلكِ أُلي خُراسِ",35,"س",1,0],["قلَّ نفعٌ لا ينتج الضُرُّ منه","ربّ شرّ تجره الخيرات",36,"ت",1,0],["قُلْنَ يَا حَارِسَ المَكَانِ أَفِدْنَا","لَمِنِ الْبَيْتُ إِنَّهُ بَيْتُ مَجْدِ",37,"د",1,0],["قُلْنا وقد أخجلَ فيضَ جُودِه","جُودُ ابنِ فَهْدٍ كَرَمٌ بعدَ كَرَمْ",38,"م",1,0],["قلنا: لدينا ذرَّتا","ن: الحقُّ أبْلجَ، واليقين",39,"ن",1,0],["قُلْنَا، وأصْغَى السامعون طويلا","خلُّوا المنابر للسيوف قليلاَ",40,"ل",2,1],["قلنا لعالمِكَ الذي شرَّفْتَهُ","حسدا البسيطُ مزية َ التَّركيبِ",41,"ب",1,0],["قلنَ: انزلوا فتيمموا لمطيكمْ","غيباً تغيبهُ إلى الإماء",42,"ا",2,0],["قلن: انزلوا نعمتْ دارٌ بقربكمُ،","أهلاً وسهلاً، من زائرٍ زارا",43,"ر",2,0],["قلنا له يا من","طبعا هجرناه",44,"ا",2,0],["قلنا بتوحيد الاله وقدسه","فردا بعز صفاته والذات",45,"ت",1,0],["قلنا لقوم غينهم","بالوهم أعمى عينهم",46,"م",1,1],["قل نعم في لقائِنا لا تقل لي لا","إنَّ لا بعدها لَخُلقٌ ذَمِيمُ",47,"م",1,0],["قلَّ نفعي بما حويتُ فيا لي","تَ ذوى الجهلِ يستبيحونَ سَلْبي",48,"ب",2,0],["قٌلنا السَّلامُ عليكُم وَهوَ يَزبُرُنا","وَرحمةُ الله أَمّا بَعدُ ما الخبرُ",49,"ر",1,0],["قُل نازحٌ في بلاد الشامِ حاجتهُ","مِنكم قبولٌ فَقولا أنت مقبولُ",50,"ل",1,0],["قلنا وأين الأقاحُ قال لنا","أودعتُهُ ثَغْرَ مَنْ سَقَى القدحا",51,"ح",2,0],["قلنا لهُ تلكَ إذنْ قبلةٌ","كلُّ محبّ قد تمناها",52,"ا",3,0],["قلنا يلذُّ بشمٍّ أو ملامسةٍ","أو مسمعٍ حين لا يلتذُّ بالنظرِ",53,"ر",1,0],["قلنا له يا ذا الزمان فما الذي","لا قيت حتى لحت بالأنوار",54,"ر",1,0],["قلني حر نار جحيم فقري","وقاك الله من نار الجحيم",55,"م",1,0],["قلنا بمدحك كل معنى شارد","قد ادرك الأسهاب بالايجاز",56,"ز",1,0],["قُ