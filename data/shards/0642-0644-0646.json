90,"أقرئهُ عنّي الجوى","https://www.poetsgate.com/ViewPoem.aspx?id=176415",""],[5493,"نساء الأمازيغ","https://www.poetsgate.com/ViewPoem.aspx?id=197013",""],[5533,"الفَيْروس المكلَّل \"كُورُونا\" الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=178279",""],[5542,"الأمل القادم","https://www.poetsgate.com/ViewPoem.aspx?id=10027",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[6008,"ياحيف والله","https://www.poetsgate.com/ViewPoem.aspx?id=60801",""],[161,"قَلْنَا لِغَزَّةَ : ...","https://www.poetsgate.com/ViewPoem.aspx?id=175084",""],[6124,"أراك","https://www.poetsgate.com/ViewPoem.aspx?id=102714",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[5724,"ما رفرفت فوق هام العرب رايات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55140&r=&rc=7",""]],"verses":[["قُلْنَا وَقَدْ بَلَّلَهَا مَاؤُهُ","لاَ يُنكَرُ الْمَاءُ عَلَى الرَّوْضِ",0,"ض",1,0],["قُلْنَا وَلِلْيُتُمِ فِيهَا","مَخِيلَةٌ مُستَقِيمَهْ",1,"م",2,0],["قُلْنَا لِعَالَمِكَ الَّذِي شَرَّفْتَهُ","حَسَدَ الْبَسِيطُ مَزيَّةَ التَّرْكِيبِ",2,"ب",1,0],["قُلنا الصَلاحَ فَقالوا لا نُصالِحُكُم","أَهلُ النُبوكِ وَعيرٌ فَوقَها الخَصَفُ",3,"ف",1,0],["قِلنَ عُسفانَ ثُمَّ رُحنَ سِراعاً","طالِعاتٍ عَشِيَّةً مِن غَزالِ",4,"ل",1,0],["قُلنا لَهُم ثَوِّروا حَقّاً فَنَتبَعُهُ","لَسنا نُريدُ سِواهُ آخِرَ الأَبَدِ",5,"د",1,0],["قلن لولا انكشافُنا ما تجلَّت","عنك ظَلمَاءُ شُبْهةٍ قتماءِ",6,"ا",2,0],["قلن أعَجِبْ بمُهْتَدٍ يتمنَّى","أنه لم يزل على عمياءِ",6,"ا",2,0],["قُلْن هذا هوىً فعرّجْ على الحق","قِ وخلِّ الهوى لقلْبٍ هواءِ",6,"ا",2,0],["قُلْن ما الموتُ بالكريه إذا كا","ن بحقٍّ فلا تزدْ في المراءِ",6,"ا",2,0],["قلْنا له لمْ هواكَ في سفلِ ال","ناس وشرُّ الأمورِ سافلُها",7,"ل",3,0],["قُلنا كَذَبتَ لَقَد حَزِن","تَ وَقَد خَزيتَ مُصَحَّفا",8,"ف",2,0],["قلنا صدقناك نهل هكذا","يصول سيف الحق من غمده",9,"د",2,0],["قلن نبكيه قلت هاتي دموعا","قلن صبرا فقلت هاتى اصطبارا",10,"ر",2,0],["قُلنَ تَجاهَلتِهِ","ذَلِكَ رَبُّ القَلَم",11,"م",1,0],["قَلَّ نَفعُ الحَديدِ فيكَ فَما يَل","قاكَ إِلّا مَن سَيفُهُ مِن نِفاقِ",12,"ق",1,0],["قُلنَ أَينَ الشَبابُ في عَقَبِ فَوتٍ","مِنهُ قَولاً أَعيا عَلَيَّ جَوابُه",13,"ب",2,0],["قُلنا وَقَد أَنطَقَها بَعدَهُ","يا ذا اللِسانَينِ إِذا ما نَطَق",14,"ق",1,0],["قُلنا لَعاً لَمّا عَثَرتَ وَلا تَزَل","نُوَبُ اللَيالي وَهيَ عَنكَ رَواجِعُ",15,"ع",1,0],["قُلنا وقد أعلاه جَدٌّ صاعِدٌ","في الجوِّ حتى ما يُصادِفُ مَصْعَدا",16,"د",2,0],["قلنا تأهبْ لغيرِ هذا","فذا فتوحٌ على الفتوحِ",17,"ح",1,0],["قلنا على رسلِكَ قال اسكتوا","جاءَ شقيقٌ عارضاً رمحَهُ",18,"ه",1,0],["قلنا له دع أموراً","مستهجناتٍ لمثلِكْ",19,"ك",1,1],["قُلنَ بِاللَهِ لِلَّتي","سَمِعَت قَولَ ظالِمِ",20,"م",1,0],["قُلنَ قَد نادى المُنادي","وَبَدا الصُبحُ فَقوما",21,"م",2,0],["قُلنَ هَذا الَّذي نَلومُكِ فيهِ","لا تَحَجّي مِن قَولِنا بِفَتيلِ",22,"ل",1,0],["قُلنَ يَستَرضينَها مُنيَتُنا","لَو أَتانا اليَومَ في سِرٍّ عُمَر",23,"ر",1,0],["قُلنَ بِاللَهِ لِلفَتى عُج قَليلاً","لَيسَ أَن عُجتَ لِلعِتابِ كَثيرا",24,"ر",2,0],["قُلنَ اِنزِلوا نَعِمَت دارٌ بِقُربِكُمُ","أَهلاً وَسَهلاً بِكُم مِن زائِرٍ زارا",25,"ر",2,0],["قُلنَ عَزَّ الفُؤادَ عَن أُمِّ بَكرٍ","بِعَزاءٍ قَدِ اِفتَضَحتَ اِفتِضاحا",26,"ح",2,0],["قُلنَ اِنزِلوا فَتَيَمَّموا لِمَطِيِّكُم","غَيباً تُغَيِّبُهُ إِلى الإِمساءِ",27,"ا",2,0],["قُلنا صَدَقتُم وَفاضَت ديمَةٌ ذَهَبٌ","رَنّانَةُ الوَرقِ يَشجي الوُرقَ هاميها",28,"ي",3,0],["قُلنَ لَمّا رَأَينَهُ حالِكاً أَس","وَدَ جَعداً يُناسِبُ السودانا",29,"ن",2,0],["قُلنا لَهُ عَرَّهِ مِن أَسلابِهِ","فَلاحَ كَالحاجِبِ مِن سَحابِهِ",30,"ب",2,0],["قُلنا لَها كَم لَها في الدَنِّ مُذ حُجِبَت","قالَت قَدِ اِتُّخِذَت مِن عَهدِ طالوتِ",31,"ت",1,0],["قُلنا السَلامُ عَلَيكَ قالَ عَلَيكُمُ","مِنّي سَلامُ تَحِيَّةٍ وَوِدادِ",32,"د",1,0],["قُلنَ لَهُ ما تَأتَمِر","وَهُنَّ إِذ قُلنَ أَشِر",33,"ر",1,0],["قُلنا أَتانا وَلَم يُصلَب وَقَولُكُمُ","ما جاءَ بَعدُ وَقالَت أُمَّةٌ صُلِبا",34,"ب",2,0],["قَلَنسُوَةً خُصِصَت بِها نَضاراً","كَهُرمُزَ أَو كَمَلكِ أُلي خُراسِ",35,"س",1,0],["قلَّ نفعٌ لا ينتج الضُرُّ منه","ربّ شرّ تجره الخيرات",36,"ت",1,0],["قُلْنَ يَا حَارِسَ المَكَانِ أَفِدْنَا","لَمِنِ الْبَيْتُ إِنَّهُ بَيْتُ مَجْدِ",37,"د",1,0],["قُلْنا وقد أخجلَ فيضَ جُودِه","جُودُ ابنِ فَهْدٍ كَرَمٌ بعدَ كَرَمْ",38,"م",1,0],["قلنا: لدينا ذرَّتا","ن: الحقُّ أبْلجَ، واليقين",39,"ن",1,0],["قُلْنَا، وأصْغَى السامعون طويلا","خلُّوا المنابر للسيوف قليلاَ",40,"ل",2,1],["قلنا لعالمِكَ الذي شرَّفْتَهُ","حسدا البسيطُ مزية َ التَّركيبِ",41,"ب",1,0],["قلنَ: انزلوا فتيمموا لمطيكمْ","غيباً تغيبهُ إلى الإماء",42,"ا",2,0],["قلن: انزلوا نعمتْ دارٌ بقربكمُ،","أهلاً وسهلاً، من زائرٍ زارا",43,"ر",2,0],["قلنا له يا من","طبعا هجرناه",44,"ا",2,0],["قلنا بتوحيد الاله وقدسه","فردا بعز صفاته والذات",45,"ت",1,0],["قلنا لقوم غينهم","بالوهم أعمى عينهم",46,"م",1,1],["قل نعم في لقائِنا لا تقل لي لا","إنَّ لا بعدها لَخُلقٌ ذَمِيمُ",47,"م",1,0],["قلَّ نفعي بما حويتُ فيا لي","تَ ذوى الجهلِ يستبيحونَ سَلْبي",48,"ب",2,0],["قٌلنا السَّلامُ عليكُم وَهوَ يَزبُرُنا","وَرحمةُ الله أَمّا بَعدُ ما الخبرُ",49,"ر",1,0],["قُل نازحٌ في بلاد الشامِ حاجتهُ","مِنكم قبولٌ فَقولا أنت مقبولُ",50,"ل",1,0],["قلنا وأين الأقاحُ قال لنا","أودعتُهُ ثَغْرَ مَنْ سَقَى القدحا",51,"ح",2,0],["قلنا لهُ تلكَ إذنْ قبلةٌ","كلُّ محبّ قد تمناها",52,"ا",3,0],["قلنا يلذُّ بشمٍّ أو ملامسةٍ","أو مسمعٍ حين لا يلتذُّ بالنظرِ",53,"ر",1,0],["قلنا له يا ذا الزمان فما الذي","لا قيت حتى لحت بالأنوار",54,"ر",1,0],["قلني حر نار جحيم فقري","وقاك الله من نار الجحيم",55,"م",1,0],["قلنا بمدحك كل معنى شارد","قد ادرك الأسهاب بالايجاز",56,"ز",1,0],["قُلنا لِقَيِّمِها وَقَد وافى بِشَم","عَتِهِ فَصارَ العرفُ مِنّا مُنكرا",57,"ر",2,0],["قلنا احتراما والرضا","والبشر بادٍ ظاهر",58,"ر",1,0],["قلنا السلام على الجزا","ئر وانتهى هذا المسير",59,"ر",1,0],["قُلنا لَئِن تَكُنِ الحَقيقَةُ هَكَذا","فَالعُذرُ أَقبَحَ جَنبُ ذَنبِ الجاني",60,"ن",2,0],["قلن إن الذي يباركه الله","قوى يمعززٌ بالجنود",61,"د",1,0],["قلن إن الهدى هدى الله واندب","ن زماناً مضيعا في الجحود",61,"د",1,0],["قلن إن النبي جاهد في اللَ","ه جهاد المغلّب الصنديد",61,"د",1,0],["قلن إن الذي له اهتزّت الأر","ض خشوعا يرضى بأكل القديد",61,"د",1,0],["قُلنا لَكَ الوَيلُ ماذا في صَحيفَتِكُم","قالوا الخَليفَةُ أَمسى مُثبَتاً وَجِعا",62,"ع",2,0],["قَلَنْدرِىٌّ حَلَقُوا حَاجِباً","لَهُ كَنُونِ الخَطِّ مِن حاجِبِ",63,"ب",1,0],["قُلنْا فتشكُو غَيرَ ذا قُلنَ مَا","كُلُّ هَوَاكُمْ قِسْمَةٌ بَيْنَنا",64,"ن",2,0],["قُلنا اِعتَذَرتُم في الصِيا","مِ فَقَد عَذَرنا في الصِيامِ",65,"م",1,0],["قلنا أتانا مسيحُ الله مفتدياً","بصلبه الخلقَ والناسوتُ قُربان",66,"ن",1,0],["قلنا لهم لسنا نعيب على الذي","قد قلد الأموات في الأديان",67,"ن",1,0],["قلنا لهم هاتوا لنا برهانكم","إن كان للإِنصاف فيكم قاصد",68,"د",1,0],["قلنا لهم شرف الكتاب أَجلَّهُمْ","عن قتلهم إلا إذا ما عاندوا",68,"د",3,0],["قلنا ويلزمكم بغير تردد","إلحاق من هو للشريعة جاحد",68,"د",1,0],["قلنا أتانا في براءة حكم من","جحد الإِله وبئس ذاك الجاحد",68,"د",1,0],["قل نصر دولة دين اللَهِ لي أَمَلٌ","قَولاً وَقَد نِلتَ أَقصى غاية الهِمَمِ",69,"م",1,0],["قلنَ لو رام وما في باعه","قِصَرٌ أدركَ بالسَّعي المراما",70,"م",2,0],["قلنا وعاد إِلى شَرْخ الشبابِ به","جودٌ مضى هَرِمٌ عنه وقد هَرِما",71,"م",2,0],["قلنَ لمّا قامَ الأثيرُ دليلاً","ليس إلا الإقرارُ والتسليمُ",72,"م",1,0],["قلنا وصحَّ فافعلوا فإنما ال","حسنى بعشرٍ منكُمُ أمثالها",73,"ل",3,0],["قلن إذ أبصرنني أفٍّ له","ضلَّ شيخاً وتعاطيه الغزلْ",74,"ل",1,0],["قلنَ وقد عتبتُ في وثائق","نقضنها ما غادةٌ وعهدُ",75,"د",1,0],["قلن يستطردن بي عِينَ النقا","رجلٌ جُنَّ وقد كان صحا",76,"ح",2,0],["قُلنا لَها حُيّيتِ مِن شَجَنٍ","وَلرَكبِها حُيّيتَ مِن رَكبِ",77,"ب",1,0],["قُلنا لِمَنزِلِها حُيِّيتَ مِن طَلَلٍ","وَلِلعَقيقِ أَلا حُيّيتَ مِن وادي",78,"د",2,0],["قُلنا التَّجرُّدُ للحَبي","بِ على محبَّتِهِ عَلامَهْ",79,"م",2,0],["قُلْنا يَعودُ عليهِ زَخُّ نِبالِهِ","شَيْخُ العَواجِزِ دائماً حامي الحِمى",80,"م",2,0],["قُلْنا قَبِلْنا وإنْ لَمْ يَأتِنا خَبَرٌ","عَنْ غَيْرِه غَيْرُ مَظْنونٍ ومَعْلومِ",81,"م",1,0],["قلنا الهَناءُ به انتِصارا مثلما","قد 