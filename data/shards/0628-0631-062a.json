{"poems":[[36,"إذا خدرت رجلي تذكرت من لها","https://www.aldiwan.net/poem4873.html","الطويل"],[95,"من يبتني للعلم دارا إنما","https://www.aldiwan.net/poem11198.html","الكامل"],[45,"ملامي النوى في ظلمها غاية الظلم","https://www.aldiwan.net/poem10536.html","الطويل"],[89,"منحتك ألقاب العلا فادعني باسمي","https://www.aldiwan.net/poem8272.html","الطويل"],[41,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[302,"شق الدجى عن نحره الفجر","https://www.aldiwan.net/poem33263.html","أحذ الكامل"],[325,"قل للمعالي ترطب مسمعي طربا","https://www.aldiwan.net/poem67218.html","البسيط"],[358,"هناء بالسلامة مستديم","https://www.aldiwan.net/poem39955.html","الوافر"],[361,"ألمت بنا أهلا وسهلا","https://www.aldiwan.net/poem24532.html","الطويل"],[415,"تخرمت الأيام أهل مودتي","https://www.aldiwan.net/poem31859.html","الطويل"],[435,"لك الهنا يا من اضا في سما","https://www.aldiwan.net/poem39824.html","السريع"],[466,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[466,"الله جار الوزير الصدر ما طلعت","https://www.aldiwan.net/poem16429.html","البسيط"],[471,"أنا الهائم الصب الذي قاده الهوى","https://www.aldiwan.net/poem50379.html","الطويل"],[519,"هوى الكوكب الدري من أفق المجد","https://www.aldiwan.net/poem20841.html","الطويل"],[529,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[580,"قلبي يقول لطيف منك يطرقني","https://www.aldiwan.net/poem2997.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48739","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64924","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108709","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53046","الكامل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21480","الطويل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84512","الطويل"],[2833,"","https://poetry.dctabudhabi.ae/diwan/poem/204992","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65486","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132776","السريع"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139983","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138554",""],[3639,"","https://poetry.dctabudhabi.ae/diwan/poem/203988","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91850","الرمل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132109","الكامل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136902",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94580","البسيط"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139622",""],[4679,"الصحف تنطق والمنابر تشهدُ","https://www.poetsgate.com/ViewPoem.aspx?id=142755",""],[4728,"يا ملهمة","https://www.poetsgate.com/ViewPoem.aspx?id=176874",""],[5880,"رضاك إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=208579",""],[6084,"حيت تزف سلافة الصهباء","https://www.poetsgate.com/ViewPoem.aspx?id=170811",""]],"verses":[["بَرَت نَبلَها لِلصيدِ لُبنى وَرَيَّشَت","وَرَيَّشتُ أُخرى مِثلُها وَبَرَيتُ",0,"ت",1,0],["بَرَّتْ وَمَا بَرَّوا بِنَشْءٍ طَيِّبٍ","زَاكِي النَّبَاتِ إِلَى النَّدَى ظَمْآنِ",1,"ن",1,0],["بَرَتني السُرى بَريَ المُدى فَرَدَدنَني","أَخَفُّ عَلى المَركوبِ مِن نَفَسي جِرمي",2,"م",2,0],["بَرَتْنِي تَبَارِيحُ الْحَيَاةِ فَلَمْ تَدَعْ","لَدَيَّ سِوَى رُوحٍ تَرَدَّدَ فِي جِسْمِ",3,"م",1,0],["بَرَت لَكَ حَمّاءُ العِلاطِ سَجوعُ","وَداعٍ دَعا مِن خُلَّتَيكَ نَزيعُ",4,"ع",1,1],["برَّت بإخلاصٍ سريرتُه","فهو التَقيُّ المخلصُ البَرُّ",5,"ر",1,0],["بِرُتبَةٍ قَدرُها عالٍ مُفَخَّمَةٍ","لِواؤُها في ذُرى العَلياءِ قَد نَصَبا",6,"ب",2,0],["برت قَلمي وَأَفكاري وَجسمي","غُموم خَطبها خَطب جَسيمُ",7,"م",1,0],["برتها مبارة المطيّ إذا البرى","تمجّ عليها الشمس من ريقها سما",8,"م",2,0],["بَرَتْهُم كباري القوسِ جَذَّ الذي انحنى","عليها إلى أن نالَها وهي بارِزُ",9,"ز",1,0],["برتبة غراء قد حزتها","قرينة النصر مدى الأدهر",10,"ر",1,0],["بَرَتْهُ حدابيرُ السنين فجعجعتْ","حِماهُ وحَلَّتْ فوقَه بالكَراكرِ",11,"ر",1,0],["بَرٌّ تُحَصِّنُهُ التَّقْوى ويَعْصِمُهُ","إِخْلاصُهُ وعلى الرَّحْمنِ يَتّكِلُ",12,"ل",1,0],["بَرَتهُ دَواعي الحُبِّ حَتّى تَرَكنَهُ","سَقيماً وَلَم يَترُكنَ لَحماً وَلا دَما",13,"م",2,0],["برَتْهُ المَنايا وهْوَ عُضْوٌ من النّدى","فأصبحَ كفّ المَكرُماتِ بلا زَنْدِ",14,"د",1,0],["بِرُتبةِ القابِ بِالأَدنى بحظوَتِهِ","بِرُؤية اللَّهِ بِالإِيناسِ بِالكَلمِ",15,"م",1,0],["بِرٌّ تودَّد حتى صَارَ يأْلفُه","كفِّي فيسكن من كَفِّي إِلى سَكَني",16,"ن",2,0],["برت بمصر أبوة لك سمحة","في بدئها وإليك حسن مآلها",17,"ل",3,0],["بَرَتْ جِسْمي فسارَ القَلْبُ عنهُ","وكيفَ يُقيمُ في رَسْمٍ مُحيلِ",18,"ل",1,0],["برٌّ تنام عيونه وفؤاده","يقظٌ لحاجات العباد سهور",19,"ر",1,0],["بر تنقل فيك بعد وفاته","فزكت وراثة طيب عن طيب",20,"ب",1,0],["بَرتهُ سَفاسيرُ الحَديدِ فَجَرَّدت","وَقيعَ الأَعالي كانَ في الصَّوتِ مُكرِما",21,"م",2,0],["برت اعظمى قسراً باسياف جفنها","وَثَنَت بسهم من قسى الحواجِب",22,"ب",1,0],["بَرَتني صُروف الدَّهْرِ من كلّ جانب","كما يَنبري دون اللحَاء عَسِيب",23,"ب",1,0],["بّر تقيّ وليّ ناسك ورع","خير زكيّ بأسرار الإلاه حبي",24,"ب",2,0],["برتبة شماء قد اهديت","من ملك جلت هداياه",25,"ا",2,0],["برتني يدُ الأشواقِ برياً وكيفَ لا","ومثواه في شرق ومثواي في غرب",26,"ب",1,0],["برت جسمه الأسقام والغل والسرى","وفقدان أحبابٍ وصرخة أيم",27,"م",1,0],["برت على هجر الكؤوس يميني","شهر الصيام فما امتطين يميني",28,"ن",2,1],["برت الأيام عزمي","وَسبت حزمي الليالي",29,"ل",2,0],["برت السفاهة من لسانك فاحتفظ","فالباقيات من اللسان قليلُ",30,"ل",1,0],["برَّت بفرسانها حتى إذا انطلقت","من هول ما شهدت شابت نواصيها",31,"ي",3,0],["برتني صروفُ الحادثاتِ فآوِني","تضعْ منيَ الإنعام عند شكورِهِ",32,"ر",2,0],["برٌّ تسامى على سمك الكمال رقى","قد ساد في سُؤددٍ والحق ناصرهُ",33,"ر",2,0],["بَرَتْكَ نَفْسٌ مِن الاََدْواءِ ما بَرِئَتْ","وَلا انْبَرَتْ لِشِفاءٍ قَطُّ مُذ بُرِئَت",34,"ت",1,0],["برَت من مساعيهم يدُ الفضل أسهماً","رمت من أعاديهم قلوباً وأكدا",35,"د",2,0],["برٌّ تقي لا يميل إلى سوى","حب الإله وغيرَهُ لا يقصدُ",36,"د",1,0],["برتوي من هالة الحسن جعلي ما اعدمه","لا تهادى من ترايبك عنقود وثمر",37,"ر",1,0],["برت روحَه الأيامُ.. فاشتاق للِّقا","وأثقله حمل الأماني الكواذبِ",38,"ب",1,0],["بر تقي عالم ذو همة","فيها سما فضلا على القرناء",39,"ا",2,0]]}