السراب","https://www.poetsgate.com/ViewPoem.aspx?id=35918",""],[4830,"سلاماً ياعِراق","https://www.poetsgate.com/ViewPoem.aspx?id=207947",""],[4927,"شهيد الحق السوري","https://www.poetsgate.com/ViewPoem.aspx?id=80799",""],[5038,"صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=195221",""],[5061,"محمد بن الذيب","https://www.poetsgate.com/ViewPoem.aspx?id=147169",""],[3271,"دمعة في قلب الليل","https://www.poetsgate.com/ViewPoem.aspx?id=102704",""],[5072,"حوار","https://www.poetsgate.com/ViewPoem.aspx?id=53580",""],[5183,"قلن","https://www.poetsgate.com/ViewPoem.aspx?id=186480",""],[5183,"قابيلان","https://www.poetsgate.com/ViewPoem.aspx?id=180190",""],[5183,"ناشد الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=180191",""],[5277,"آهةٌ خرساءُ","https://www.poetsgate.com/ViewPoem.aspx?id=205799",""],[5431,"العمرُ بحرٌ والكرامة ساحلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187569",""],[5493,"معراج الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=203377",""],[5493,"هذا الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=204450",""],[5542,"شاهد التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=10069",""],[5628,"وداعاً أيتها البسمة","https://www.poetsgate.com/ViewPoem.aspx?id=178491",""],[2110,"صرف راح ما مسها كف عاصي","https://www.poetsgate.com/ViewPoem.aspx?id=156276",""],[549,"توبة في محراب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=203000",""],[6127,"الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=189521",""],[6127,"خوفُ الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=198260",""],[6242,"دمشق يا وردة تاهَ النّسيم بها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87573&r=&rc=20",""]],"verses":[["صامِتٌ يُسكِتُ المُفَوَّهَ فَاِعجَب","وَبَطيءٌ يَبِزُّ خَطوَ العِجالِ",0,"ل",1,0],["صامِتٌ مِثلُ كُتبِهِ","وَكَدُنيا بِلا أَنام",1,"م",1,0],["صامتٌ كالقبرِ إلاَّ من أنينِ الذِّكريات","أَنْتَ لحنٌ ساحرٌ يَخْبُطُ في التِّيهِ المَواتْ",2,"ت",1,0],["صامِتِيٌّ يَمُدُّ في كَرَمِ الفِع","لِ يَداً مِنهُ تَخلُفُ الأَنواءَ",3,"ا",2,0],["صامِتِيٌّ يَغدو فَتَغدو بِومنا","هُ طَريقُ الآجالِ وَالأَرزاقِ",4,"ق",1,0],["صاموا وَفِطرُهُمُ عَلى مَفسودِها","جَهلٌ فَهَلّا اِستُخلِصوا ما اِستَخلَصوا",5,"ص",3,0],["صامداً للظلم والظلم له","معول يهدمني عن كثب",6,"ب",1,0],["صامتٌ لوْ تكلَّما","لَفَظَ النَّارَ والدِّما",7,"م",2,0],["صَاموا مَعَ النَّاسِ ولكنَّهمْ","كانوا لِمَنْ يُبصِرُهم عِبْرَهْ",8,"ر",2,0],["صَامِتاً مِثْلَ غَديرِ القَفْ","رِ مِنْ دونِ صَدَى",9,"د",2,0],["صامت وَلَم تَشتَغِل بِفِطرٍ","حَتّى بَدا أَنَّها خِماصُ",10,"ص",1,0],["صامت مرابطة الجهاد ببابه","لله ظل جهادها وصيامها",11,"م",3,0],["صَامتيٌّ، يَغْدُو فتَغدو بيُمْنَا","هُ طَرِيقَ الآجَالِ وَالأرْزَاقِ",12,"ق",1,0],["صاموا الهواجر للإِله وهاجروا","فيه لذاذة كل عيش فاني",13,"ن",2,0],["صامت سجاياك عن كل العيوب فما","تزال في رمضان ليس معدودا",14,"د",2,0],["صامِتٌ يَسأل الرؤى في سَريرٍ","يَتَخَطّى بهِ إِلى الآجالِ",15,"ل",1,0],["صامتٌ إِنَّما المحدِّقُ فيهِ","يَتَراءى لهُ وَميضُ خَيالِ",15,"ل",1,0],["صامِتٌ يُرسِلُ التَنَهُّدَ شِعراً","كُلَّما هَزَّ قَلبَه خَفَقانُ",16,"ن",1,0],["صامتةٌ فوق صامت أبداً","يَضمَن ما يَضمن الحياةَ لنَا",17,"ن",2,1],["صامتٌ تسمعُ العوالِمُ منه","أي صوتٍ يُناهِضُ الأقدارا",18,"ر",2,0],["صامت تنطقه الأز","هار والدمع الهتون",19,"ن",1,0],["صامتات ناطقات","مبطئات مسرعات",20,"ت",1,0],["صامتاً ثم صائماً","يومَه ما تَرَيَّقا",21,"ق",2,0],["صامت وساكت عن كلام باطل","بالحق ينطق ما يخاف عاذل",22,"ل",1,0],["صامت عن الشر لك شغل عظيم","بكل مفروض تارك للحرج",23,"ج",1,0],["صاموا وخير الصوم عن","عبث لهم وصغائر",24,"ر",1,0],["صامتٌ كالظِّلالِ ليْنٌ حليمُ","مُخبرٌ بالآجالِ عنكَ كتومُ",25,"م",1,0],["صامَتْ صوارمُه وصلّتْ قُضبُه","فالهامُ تسجدُ والمنايا تخطُبُ",26,"ب",1,0],["صامت والموج لم يلتطم","كالحزانى لجلا المصرع",27,"ع",1,0],["صَامِتٍ فِي لَيْلِهِ وَضُحَى","طَالَمَا في غُصْنِهِ صَدَحَا",28,"ا",1,0],["صامتة الحجل ذات وجه","يشرق من ضوئه الحجالُ",29,"ل",1,0],["صامتة السوار والخلخال","جامعة للصون والجمال",30,"ل",1,0],["صامت وصام أسابيعا ينهنهها","حتى لقد طويت من صومها وطوى",31,"ط",3,0],["صامت لا يجيبنا بجواب","شقِيَ السائلان بالمسئول",32,"ل",1,0],["صامِتيٌّ فَرَعَ المَج","دَ وَزَكَّتهُ النُجورُ",33,"ر",1,0],["صامتة الحجل خفوق الحشا","مائرة الساق ثقال القيام",34,"م",1,0],["صام فصامت صبحا جوارحه","وقام في ليله على قدمه",35,"م",2,0],["صاموا ثلاثين سوى اليوم الذي","شهد الرضى به من الشهر",36,"ر",1,0],["صام الأخيرَ إذا أطاق صيامه","ولما مضى إطعام ذي فقر",36,"ر",1,0],["صامت وصام اسابيا ينهنهها","حتى لقد طويت من صومها وطوي",37,"و",2,0],["صامَت للَه جوارِحهُم","والويلُ لنا إن لم نصُمِ",38,"م",1,0],["صامت بيوم الطف لكن صيرت","عصب الضلالة بالدما افطارها",39,"ر",3,0],["صامت النفس وصلت فلها","لمعان من سناها وبصيص",40,"ص",1,0],["صامتاتٌ كأنها ناطقاتٌ","عن خوالى العلا وماضى الفخار",41,"ر",1,0],["صاموا وقاموا لمولى قد أحل لنا","بفضله في ليالي صومنا الرفثا",42,"ث",2,0],["صامتة الخلخال من لي بمن","يفصح لي اخرس خلخالها",43,"ل",3,0],["صامداً أجتلِي وجوه الأماني","بسَنا النّصل والسيوف البَواتر",44,"ر",1,0],["صامت أنت تسمع الطير في الرو","ض يغنى للنيل لحناً شجيا",45,"ي",2,0],["صامت الفن أخا الفن وإن","صدحت ألحانه في أذني",46,"ن",2,0],["صامت الحجل والكن بنده","ناطق عن سر أسرار الخصور",47,"ر",1,0],["صامَ الورى وليس لي صيامُ","قام الورى وليس لي قيامُ",48,"م",1,1],["صامِتاً هَكطُورُ ذَا القَولَ وَعى","وَنِدا هِيلانَةٍ شَهداً يَسيل",49,"ل",1,0],["صاموا الهجير وأظمئوا فيه الحشا","فغدا يروى من لذيذ المورد",50,"د",1,0],["صامِتٌ وَهوَ لا يَني عَن حَديثٍ","مُطمئِنٌّ في ثَورَةِ البُركانِ",51,"ن",1,0],["صام عن أكل السحت حتى وقاه","شر يوم الحساب والصوم جنه",52,"ن",2,0],["صامت الدرب ليته بالموارد يبوح","يوم زجر العواصف شلّ همس الهضاب",53,"ب",1,0],["صامَ الفؤادُ عنِ الكِعابْ","وَعَنِ السُّلافَةِ والرِّضابْ",54,"ب",1,1],["صَاْمِدٌ كَالطَّوْدِ تَنْخِيْ أُمَّةً","وَشُعُوْباً لَمْ تَذُقْ طَعْمَ الأَمَاْنِ",55,"ن",1,0],["صامَتْ عَنِ الْعَيشِ الْهَوانِ أُباتُها","وَتَيَمَّمَتْ بِصَعيدِها الشُّهَداءُ",56,"ا",2,0],["صامل وﻻ همه هروج المعادي","يقطع نحر منهو يفكر يعاديه",57,"ي",2,0],["صامتٌ في الظلام ألهمَ قلبي","من معانيه عبقريّ الغناء",58,"ا",2,0],["صامتٌ واسْتقالت الأسرارُ","وطويلٌ بصمتهِ الإ نْتظارُ",59,"ر",1,1],["صامت الخطو طهور ثوبه","يصحب الأيام منه غلب",60,"ب",1,0],["صامت على ظمأ والماء في فمها","نارا ، أما آن من إفطارها آن",61,"ن",1,0],["صامداً يطوي الفضا عجلا","وهو لم يبرح على رسنه",62,"ن",2,0],["صامتْ جوارحُنا..ولم نقضِ المنى","كيف الصيامُ لذي الفؤادِ المُضْرمِ",63,"م",1,0],["صاموا لأجلك ياديار تبسمي","بذلا سخيّا والكرام قلائلُ",64,"ل",1,0],["صام البراق عن الحديث لمَّا رأى","شرَك الرذيلةِ يجتبِي اللعناتِ",65,"ت",1,0],["صامتْ شفاهُ القلبِ عمَّا سرَّه","سكبَ القريبُ على الندَى منْ ذنبهِ",66,"ب",2,0],["صامداً في رحلة الحق التي","حفظت هذا البناءَ الأَثَريِ",67,"ر",2,0],["صامتا تسكنُ في أعماقهِ","لغة أحرفُها نورٌ وماءْ",68,"ا",2,0],["صام شعري عن مدح غيرك لكن","بثناك اعتلى رفيع الصياصي",69,"ص",2,0],["صامت عن العزف أوتاري وراودها","حزني فما افطرت إلا بأناتي",70,"ت",2,0],["صامَتْ وذي رمضاؤها تتحلبُ","ويدُ الزمان بذا البلاءِ تُرَجّبُ",71,"ب",1,1],["صامتْ عن الدُّنيا صياما بائناً","ما أعظمَ التكبيرَ لمّا تخطِبُ",72,"ب",1,0],["صَامتْ عن الحق أسيافٌ وقادتها","لمْ ينْهلُوا - أبداً - من منْبعِ الشّيمِ",73,"م",1,0]]}