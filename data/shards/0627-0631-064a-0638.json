{"poems":[[46,"أيوسف جئت بالعجب العجيب","https://www.aldiwan.net/poem30065.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85556","البسيط"],[93,"دموع وتنهّدات","https://www.poetsgate.com/ViewPoem.aspx?id=53396",""],[208,"هويت بخيلا ظالما فاستقادني","https://www.aldiwan.net/poem53193.html","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27504","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199960","الهزج"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92012","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83547","الوافر"]],"verses":[["أَرى ظُلميكَ إِنصافاً وَعَدلاً","وَذَنبي فيكَ تَكفيرُ الذُنوبِ",0,"ب",1,0],["أرى ظلاماً أمامي غير منصرف","عني بحال وأني منه في عجب",1,"ب",1,0],["أرى ظلمات مطبقات حوالكم","فإن تطلعوا فيها رأيت الدّراريا",2,"ي",2,0],["أرى ظلمَه عندي جميلاً كعدلِهِ","فألزمني في هجره شكرَ وصلِهِ",3,"ل",2,0],["أرى ظلمةَ الطبعِ المحكم فيهم","لتعمى قلوبٌ قيدتْ بعلوم",4,"م",1,0],["أرى ظلك أعيانا","فأبعد ظلك القاسي",5,"س",2,0],["أَرى ظلها الضافي تناثر شعرُه","كما انتشرت طرّات خودٍ حزينة",6,"ه",1,0],["أَرى ظهراً أَشدُّ عَلَيهِ رحلي","وَأَركبُهُ إذا شِئتُ الركوبا",7,"ب",2,0]]}