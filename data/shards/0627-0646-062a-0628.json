فيق","https://www.aldiwan.net/poem2547.html","الخفيف"],[444,"دمت يا فارس الخطب","https://www.aldiwan.net/poem55928.html","عموديه"],[454,"من هموم الإنسان ثم","https://www.aldiwan.net/poem61228.html","الخفيف"],[454,"يا سلم خير أن نراك مزعزعا","https://www.aldiwan.net/poem61230.html","الكامل"],[454,"الجلاء الجلاء رددت الأصداء","https://www.aldiwan.net/poem61259.html","الخفيف"],[454,"قبل الأرض وناجاها هياما","https://www.aldiwan.net/poem61806.html","الرمل"],[459,"انظر معي فهي نظرة أمم","https://www.aldiwan.net/poem55899.html","المنسرح"],[459,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[462,"هنيت بالعام وأمثاله","https://www.aldiwan.net/poem16171.html","السريع"],[480,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[501,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[516,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[516,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[539,"يا من تكفل لمن دعاه","https://www.aldiwan.net/poem47447.html","عموديه"],[552,"في العناء الطويل كيف وقعتم","https://www.aldiwan.net/poem47151.html","الخفيف"],[552,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[552,"يا جامع المال كله قبل آكله","https://www.aldiwan.net/poem47323.html","البسيط"],[559,"إن هذا الصبا وهذا الصباحا","https://www.aldiwan.net/poem34664.html","الخفيف"],[559,"هيكلي سام سليم الشبح","https://www.aldiwan.net/poem34676.html","الرمل"],[563,"طال شوقي لطول هذا البعاد","https://www.aldiwan.net/poem52967.html","الخفيف"],[563,"أجمل الله في فؤادك صبرا","https://www.aldiwan.net/poem52990.html","الخفيف"],[587,"إن تبدوا أو تثنوا","https://www.aldiwan.net/poem17813.html","مجزوء الرمل"]],"verses":[["أَنتَ بِالذِكرِ بَينَ عَيني وَقَلبي","إِن تَدانَيتُ مِنكَ أَو قَد نَأَيتُك",0,"ك",1,0],["إِن تَبُح بالسِّرِّ عَينٌ دَمَعَتْ","فَدموعُ العَينِ بِالسِّرِّ تَبوحُ",1,"ح",1,0],["إِن تَبَسَّمنَ فالثُّغورُ أَقاحٍ","لُحْنَ غِبَّ الغَمامَةِ الوَطفاءِ",2,"ا",2,0],["أنْتَ بالعَتْبِ يا مَشيبِي أوْلَى","جِئْتَني غَفْلَةً وفي غَيْرِ وَقْتِكْ",3,"ك",1,0],["إِنْ تَبِيحُوا خِيَارَكُمْ أَبَدَ الدَّهْرِ","فَهَلْ مُعْتَدٍ عَلَيْكُمْ غَشُومُ",4,"م",1,0],["إِنْ تُبْذَلُ الأرْوَاحُ مِنْ أَجْل الحِمَى","شَرَفاً فَأنًى تُذْخَرِ الأمْوَالُ",5,"ل",1,0],["أنتَ بالمعروفِ قدْ أحييتني","وكذا الشمس حياة للنبات",6,"ت",1,0],["أنتَ بين السادات كالذهب الخا","لص لا غَرْوَ أن يرى مصريّا",7,"ي",2,0],["أَنتَ بَينَ الشَغافِ وَالقَلبِ تَجري","مِثلَ جَريِ الدُموعِ مِن أَجفاني",8,"ن",2,1],["إن تباعدت نالني من بعيدٍ","أو تقرَّبتُ نالني من قريبِ",9,"ب",1,0],["أنت بحرٌ ومن له تَجتبي الأم","والَ بحرٌ لجانبيه عُبابُ",10,"ب",1,0],["أنت بحرٌ وآلُ وهب مُدُودٌ","عُمِّرَ البحْرُ مُمْتَعاً بالمُدُودِ",11,"د",1,0],["إن تباطَى لديه فالبِرُّ يَزْكُو","عنده أن يُرَى إليه مجِيُّهْ",12,"ي",2,0],["إِن تَبكِيا فَلَقَد بَكَيتُ مِنَ الأَسى","حَتّى لَكِدتُ بِأَدمُعي أَن أَغرَقا",13,"ق",2,0],["إِن تُبصِريني أَتَّقي فَتَكاتِها","فَلَقَد أَصولُ عَلى القَنا المَشبوكِ",14,"ك",1,0],["إِن تَبَدّى أَو تَوَلّى","يا لَها مِن فِتنَتَينِ",15,"ن",1,0],["انت بالشعر اذ هززت الشعوبا","كنت ترضي النهى وترضي القلوبا",16,"ب",2,0],["إِن تَبَوَّأتُ غَيرَ دُنيايَ داراً","وَأَتاني نَيلٌ فَأَنتَ المُنيلُ",17,"ل",1,0],["أَنتَ بنُ فَلسٍ وَماتَنفَكُّ مُفتَخِراً","فَكَيفَ تَصنَعُ لَو كُنتَ اِبنَ دينارِ",18,"ر",1,1],["إِن تُبالِ الصُدودَ تَكلَف وَما أَن","تَ بِحَيِّ الأَحشاءِ إِن لَم تُبالِه",19,"ل",2,0],["إِن تَبِت وادِعَ الضَميرِ فَعِندي","نَصَبٌ مِن عَشِيَّةِ التَوديعِ",20,"ع",1,0],["إِن تَبلُغوهُ تَكونوا مِثلَ مُنتَجِعٍ","غَيثاً يَمُجُّ ثَآهُ الماءَ وَالزَهَرا",21,"ر",2,0],["اِنتَبِه لِلمَوتِ يا هَذا الَّذي","عِلَلُ المَوتِ عَلَيهِ تَقتَرِع",22,"ع",1,0],["أَنتَ بَلائي وَأَنتَ دائي","وَأَنتَ تَدري فَما دَوائي",23,"ا",3,0],["أنت بحر الندى وقد ضمك الفل","ك لهذا في حاله قد عجبنا",24,"ن",2,1],["أَنتَ بِلَيلٍ وَالنُجومِ كَأَنَّها","دُرَرٌ بِباطِنِ خَيمَةٍ زَرقاءِ",25,"ا",2,0],["أَنتَ بَدرُ التَمامِ فَاِجعَل لَنا بَي","نَكَ عَهداً وَبَينَهُ حَربَ بَدرِ",26,"ر",1,0],["أَنتَ بَينَ الأَنامِ لَفظَةُ إِجما","عٍ عَلَيها اِتِّفاقُ قاصٍ وَدانِ",27,"ن",1,0],["أنتَ باقٍ ونحن حَرب الليالي","مزقتنا وصيرتنا هَباءَ",28,"ا",2,0],["أنْتَ بالموْت غائبٌ ومثالٌ","في ضمير الفُؤادِ منك نجيِّ",29,"ي",1,0],["إن تبدّى تنكسفْ شمسُ الضّحى","وإذا ما ماسَ يزري بالأسلْ",30,"ل",1,0],["أنتَ بدرٌ في سماءٍ","وخُدَيدي لكَ أرضُ",31,"ض",1,0],["إِن تَبخَلي لا يُسَلّو القَلبَ بُخلُكُمُ","وَإِن تَجودي فَقَد عَنّيتِنا زَمَنا",32,"ن",2,0],["إِن تَبذُلي لي نائِلاً يُشفى بِهِ","سَقَمُ الفُؤادِ فَقَد أَطَلتِ عَذابي",33,"ب",2,0],["إِن تَبكِ مِصرُ عَلى مُؤثَّلِ مَجدِها","فَلَسَوفَ يَرجِعُ عالِياً وَيَعودُ",34,"د",1,0],["أنتَ بِالصّبيَانِ صَبُّ","لَو رأيتَ البِنتَ بِنتاً",35,"ت",2,0],["إِن تَبلَ جِدَّةُ ثَوبَيهِ فَبَينَهُما","سَيفٌ يُفَرِّقُ بَينَ الهامِ وَالقَصَرِ",36,"ر",1,0],["إن تبكِ أعينُنا للحادثات فقدْ","كَحلننا بعد تغميضٍ بتسهيد",37,"د",1,0],["إِن تَبكِ عَيني فَقَد عُلِّقتُ جارِيَةً","كَأَنَّ ريقَتَها ماءُ العَناقيدِ",38,"د",1,0],["أَنتِ باعَدتِهِ فَأَمسى مِنَ الشَو","قِ صَريعاً كَأَنَّهُ في الفَضاءِ",39,"ا",2,0],["أَنتِ بَيضاءُ كَالمَهاةِ وَإِذ آ","تِيكِ نَشوانَ مُرخِياً أَذيالي",40,"ل",2,0],["أنتَ بما في نفسهِ أعلمْ","فاحكُمْ بما أحببتَ أن تحكُمْ",41,"م",1,1],["إِنْ تَبْكِ عَيْنَاكَ لي يَا مَنْ كلِفْتُ بِهِ","مِنْ رَحمَةٍ فَهُما سَهْمانِ في كَبِدي",42,"ي",1,0],["إنْ تَبَسّمتَ تحتَ ضوءِ لِثَامٍ","أو تَنَسّمْتُ الرّيحَ من أنْباكا",43,"ك",2,0],["أنت بعد الموت لا تظفر","بالحور الحسان",44,"ن",1,0],["إِن تَبرَحا وَتَباريحي عَلى كَبِدٍ","ما تَستَقِرُّ فَدَمعي غَيرُ بارِحِها",45,"ح",3,0],["أَنْ تُبقِيَ المُلْكَ الرَّهِينَ","فَمَا أَرَادَ سِوَى الفَكَاك",46,"ك",1,0],["إِنْ تبْعَدِي مَا بَعُدَتْ نَفْحَةٌ","تَرَكْتِهَا مِنْ خَالِصِ العِطْرِ",47,"ر",1,0],["إِنْ تُبْصِرُوا الْغَيْمَ الرَّقِيقَ فَفِيهِ مَا","يَخْفَى مِنَ الإِبْرِاقِ وَالإِرْعادِ",48,"د",1,0],["إِنْ تبْكِ عَدْنانُ فَأَخْلِقْ بِهَا","هَلْ بَعْدَ مَا حَلَّ بِهَا خُسْرُ",49,"ر",1,0],["إِنْ تَبْدَإِ الأمْرَ تنْهِهِ وَإِذَا","وُلِّيْتَ أَمْراً كَفَيْتَ مَنْ وَلَّى",50,"ل",2,0],["إِنْ تَبِينِي فَفِي النُّهَى لَكِ تَاجٌ","خَالِدُ النُّورِ فَوْقَ أَنْقَى جَبِينِ",51,"ن",1,0],["أنت بين النجوم، يا صاح، تَسْرِي","فَلِيَ العُذْر إن جهلتُ مكانك",52,"ك",1,0],["إن تبتسمْ تُشرقِ الدنيا، وإن غَضَبَتْ","ففي السمواتِ إبراقٌ وإرعاد",53,"د",1,0],["أنت باك تحنو على كلّ باك","أنت قلب على القلوب مقسّم",54,"م",1,0],["أنت بانيها فجرّب هدمها","هدم ما شيّدته أدنى مراما",55,"م",2,0],["انتبهوا لا الحزنُ يُجديكُمُ","شيئاً ولا استنزافُ هذي الشؤون",56,"ن",1,0],["أنت بتسافر حبيبي نعم سافر وغيب","بس تكفي سم بالله على عقلي لا ماع",57,"ع",1,1],["أنْتَ بالموْت غائبٌ، ومثالٌ","في ضمير الفُؤادِ منك نجييّ",58,"ي",1,0],["أنت باب يفضي بمن ولجوا في","ه إلى اللانهاية السوداء",59,"ا",2,0],["أَنتَ بَحر دونَهُ الأَب","حُر مِن بَعض السَواق",60,"ق",1,0],["انت باب الرسول من غير شك","واتينا نرجو العطا من بابك",61,"ك",1,0],["أنت باب من غيره قطع ال","أمر طريق الدنو من ذي الجلال",62,"ل",1,0],["إن تبك يا طير إلفاً نازحاً ونوى","سهم الفراق الذي أضناك أضنانا",63,"ن",2,0],["أَنْتَ بِالْعِزَّةِ ماضِ","وأَنا بالذُّلِّ راضِ",64,"ض",1,1],["أنت بِكْرُ الفضلِ لم يأتِ له","بأخٍ مذ كان عَدُّ الحِقَب",65,"ب",1,0],["أَنتَ بدرُ البدورِ شمسُ الشموس","وَمُمدٌّ بالنورِ خير النفوسِ",66,"س",1,0],["أَنتَ بحرُ الإحسانِ بالفضلِ طامي","وَفُؤادي لِعذبِ جودِكَ ظامي",66,"ي",1,0],["إنْ تبْكِهِ فمن الوفاءِ بكاؤُهُ","لكنْ ثوابُ الصبر خير ثواب",67,"ب",1,0],["إن تبتعدْ أو تقتربْ","فأنا على الحالينِ صبُّكْ",68,"ك",1,0],["إن تبتعدْ تقربْ إلى أملي","والدهرُ منعكسٌ بما يجري",69,"ر",2,0],["أنت بانُ المِلاح من حور عدنٍ","جنس طيبٍ عليه من كلِّ حُسنِ",70,"ن",1,0],["أنت بالخصر والمؤزَّر تحكي","مَضَّةَ الشوق بالفؤاد الضعيفِ",71,"ف",1,0],["أنت بخيرٍ يا أبا جعفرٍ","ما دمت صلب الأير نياكاً",72,"ك",2,0],["أنت بدرٌ ونحن هالُكَ فاطلع","في سماء العلاء يا بدر كامل",73,"ل",1,0],["إن تبك بالدمع الشباب فإنني","أبكي على أيامه بدماء",74,"ا",2,0],["أنتَ بالإنشادِ فوقي","إن تكن بالنَّظمِ مثلي",75,"ل",2,0],["أَنْتَ بَدْرُ التِّمِّ فِي السَّعْدِ إِذا","ذُكِرَ السَّعْدُ وَشَمْسُ الْحَمَلِ",76,"ل",1,0],["أَنْتَ بَدْرُ العُلى فَكَيْفَ وَقَدْ ضُمَّ","تْ إِلَيْهِ زُهْرُ النُّجُومِ الدَّرارِي",77,"ر",2,0],["إن تبسم نثرت دمع المحب جوى","فالدر ما بين منظوم ومنثور",78,"ر",1,0],["أنت بعد اللَه نعم المرتجى","واللجا يا مجتبي يا مصطفى",79,"ف",2,0],["أنت باب اللَه نال المرتجى","والأماني من عليه وقفا",79,"ف",2,0],["إِن تبدّى في دستِ حكمٍ محيّا","هُ تراه كالبدر في الميزانِ",80,"ن",1,0],["أنت بيت القصيد والكون شعر","واسمك الحلو فيه مثل الروى",81,"ر",3,0],["أَنتَ بِحالي في الهَوى عالم","لا يَستَوي العالم وَالجاهلُ",82,"ل",1,0],["أن تبقى أنتَ بلا وَطَنٍ","أو تحيا في الوَطَنِ غَريبا",83,"ب",2,0],["إنْ تبلُغا شَرَفَ العُذَيبِ عشيةً","فَتيامناَ عنه إلى الوعساء",84,"ا",2,0],["إن تبتدر غاية يوماً لمكرمة","تلق السوابق منّا والمصلينا",85,"ن",2,0],["أنت باذلال العِدا حيثما","كانوا وإعزاز العِدا غارِهُ",86,"ر",2,0],["إن تَبكِهِ عَيني فقَد طالمَا","أبكيتُهُ حُزناً على عَيني",87,"ي",1,1],["إن تبك شبعاناً فتلك ضلالةٌ","بل دمعة الصوّام غيثٌ صالح",88,"ح",1,0],["إن تبلها تبل السرور مواكباً","أو تلقها تلق الجبال كتائبا",89,"ب",2,0],["أَنتَ بادَرتَ يَومَ بَدرٍ وَبَعضُ ال","قَومِ لا يُخرَجون بِالمِهمازِ",90,"ز",1,0],["أنتَ بيتٌ عنكبوتيٌّ ضعيفٌ","يتلاشى واهناً قبل اكتمالِ",91,"ل",1,0],["أنتَ بالكعبةِ في أَسمى مقامٍ","شامخٍ يجلو به المهمومُ همَّهْ",92,"م",2,0],["أنتَ بالإسلامِ في روضٍ مُنيفٍ","كلَّما لاحَ له المشتاقُ ضمَّهْ",92,"م",2,0],["إن تبعت النص في مسألة","قيل هذا شافعي حنبلي",93,"ل",2,0],["أَنتَ بحر النَدى فَلا زلت مداً","لا رَأَينا بِساحِلٍ لَكَ جَزرا",94,"ر",2,0],["أَنْتَ بدرُ السُّعود في طالع المج","دِ وقد أبْهَرَ العقول كماله",95,"ل",2,0],["أنت بلا شكٍ لجسم العلى","أصفى فؤادٍ ليس فيه اغبرار",96,"ر",1,0],["أَنتَ بآلائِكَ التي شَرُفَتْ","أَصْبَحْتَ عن سائر المديح غَنِي",97,"ن",2,0],["أَنتَ بالفضلِ في بَنِي الحَجَرِ السَّا","دَةِ مِثْلُ الياقوتِ في الأَحجار",98,"ر",1,0],["إن تبرأت من دمي فعلى خد","ديك حقّا شهادةُ التحقيق",99,"ق",1,0],["انت بدر بك اهتدى","قومنا في دجى الكرب",100,"ب",1,0],["إن تبالي يهم وإن تنهريهم","فهو بر بهم لأم تلام",101,"م",1,0],["إن تبق حارسنا رفعت نفوسنا","وإلى الحضيض نزل إما فتنا",102,"ن",2,0],["أنت بعض منها نزيلة بستاني","فهيا نعيد اليوم جهرا",103,"ر",2,0],["أنتِ بنت الشمس فهي