للّيْلِ جدّدَتْ ليَ عهْداً","كُنْتُ نُسِّيتُهُ بيَوْم الفِراقِ",4,"ق",1,0],["فِرَقٌ عَوَت فَزَأَرتَ زَأرَةَ زاجِرٍ","راعَ الكُلَيبَ بِها السَبَنتى الضَيغَمُ",5,"م",1,0],["فِرَقٌ تَقَارَبَتْ القُلُوبُ بِهَا","وَتَنَاءَتْ البِيئَاتُ وَاللسُنُ",6,"ن",1,0],["فَرَقِّع لِجَدِّكَ أَكيارَهُ","وَأَصلِح مَتاعَكَ لا تُفسِدِ",7,"د",1,0],["فَرَّقتَ بَينَ جُفونِهِ وَمَنامِهِ","وَجَمَعتَ بَينَ نُحولِهِ وَعِظامِهِ",8,"م",2,0],["فرقيتَ نظمي فوقَ ما كانَ ينبغي","وبلغتَ ظني فوقَ ما كان يحسب",9,"ب",1,0],["فرقُ ما بينهما متضحٌ","أين من جود فتى جود هرِم",10,"م",1,0],["فرقَّقَتْهُ حين رقَّقْتُها","وهفْهَفَتْهُ حين هفهَفْتُهَا",11,"ت",3,0],["فرق الله بين جسم وروح","تشتهي نيك شنطف تفريقا",12,"ق",2,0],["فرقَ الشكوك وفي الشكوكِ تلبُّسٌ","جمع الأمورَ وفي الأمور تزيُّلُ",13,"ل",1,0],["فَرَقَّ وَاللَهُ ذو حَنانٍ","عَلى ذَوي الضُرِّ وَالعَناء",14,"ا",2,0],["فَرَّقَ الجُندَ الغِنى فَاِنقَسَما","وَغَدا بَينَهُم الحَقُّ نَسي",15,"ي",1,0],["فَرَّقَ بَينَ الناسِ في نَجرِهِم","ما يُعظِمُ العَبدُ لَهُ سَيِّدَه",16,"د",2,0],["فَرَّقَت شَملَنا النَوى بَعدَما كُنّا","جَميعاً في ظِلِّ عَيشٍ حَميدِ",17,"د",1,0],["فِرقَةٌ لِلسُيوفِ يَنفُذُ فيها ال","حُكمُ قَصداً وَفِرقَةٌ للقُيودِ",18,"د",1,0],["فُرقَةٌ لَم تَدَع لِعَينَي مُحِبٍّ","مَنظَراً بِالعَقيقِ غَيرَ الرُبوعِ",19,"ع",1,0],["فَرَّقتَ بَينَ النَصارى في كَنائِسِهِم","وَالعابِدينَ مَعَ الأَسحارِ وَالعَتَمِ",20,"م",1,0],["فَرَّقتُ بينَ جفونه ورُقادِه","وجمعْتُ بينَ غَرامِه وفُؤادِه",21,"د",2,1],["فَرَقدٌ فَصاراتٌ فَأَكنافُ مَنعِجٍ","فَشَرقِيُّ سَلمى حَوضُهُ فَأَجاوِلُه",22,"ل",2,0],["فَرَقَ الزَمانَ بِحالَتَيهِ فَدَهرُهُ","يَومانِ يَومُ نَدىً وَيَومُ حُتوفِ",23,"ف",1,0],["فَرقُ ما بَينَهُم وَبَينَ ذَوي الإِش","راكِ كَالفَرقِ بَينَ نوكٍ وَموقِ",24,"ق",1,0],["فرَّقَ الحبُّ بينَ عقلي وبيني","فاستهلَّتْ دموعُ عيني كعينِ",25,"ن",1,1],["فرَّقَنا الدهرُ وقدْ كانَ لي","في الدارِ أوطانٌ وأوطارُ",26,"ر",1,0],["فَرَقَت فَسَهَّلَتِ المَعا","رِضَ مِن سَبيلِ نِقابِها",27,"ب",3,0],["فَرَقرَقَ العَبرَةَ في خَجلَةٍ","وَرُبَّما يُمزَجُ بِالماءِ راح",28,"ح",1,0],["فَرَقَّ لهم من الغازِينَ قَومٌ","رُمُوا مِنهم بخطبٍ لا يُطاقُ",29,"ق",1,0],["فَرَّقَ لي وَأَمسى","عَلى الهَوى دَليلا",30,"ل",2,0],["فَرَّقتَ بِالسَيفِ يا أَعلى المُلوكِ يَداً","عَن إِبنِ مُدرِكٍ الطائي وَما جَمَعا",31,"ع",2,0],["فَرَّقَت أَيديهِمُ المالَ كُرهاً","وَلَقَد كانوا عَلَيها شِحاحا",32,"ح",2,0],["فَرَقَّ لِيَ المَولى فَفُزتُ بِمَوعِدٍ","وَقالَ انتَظِرني قَبلَ مُقتَبَلِ العِشا",33,"ش",2,0],["فِرَقاً شَعَرتُ بِأَنَّها لا تَقتَني","خَيراً وَأَنَّ شِرارَها شُعَراؤُها",34,"ا",3,0],["فَرِق تِلادَكَ فيما شِئتَ مُحتَقِراً","فَلَيسَ يَذرِفُ خَلفَ النَعشِ أَدمُعَه",35,"ع",2,0],["فَرَقٌ بَدا وَمِنَ الحَوادِثِ يَفرَقُ","شَيخٌ يُغادى بِالخُطوبِ وَيُطرَقُ",36,"ق",1,1],["فرقوا بيننا فما إن أرى اليو","مَ سميراً ولا يراني سمير",37,"ر",1,0],["فَرَّقَ اللهُ بَينَهُم مِن حُداةٍ","واستَفادُوا حُمَّى مَكانَ النَّشاطِ",38,"ط",1,0],["فَرَّقَ الدَّهْرُ بَيْنَنَا بَعْدَ قُرْبٍ","فَبِأَضْعَافِ مَا تَفَضَّلَ أَذْنَبْ",39,"ب",1,1],["فِرقَةٌ فازَت وَأُخرى شَقِيَت","شِقوَةَ العَبدِ إِذا العَبدُ أَبِق",40,"ق",1,0],["فرّقت أهواءهم ثاراتُهم","كلُّ حُبٍّ بين أشواك عِداء",41,"ا",2,0],["فَرَّقَ الدَّهْرُ بَيْنَنَا بَعْدَ قُرْبٍ","فما كان لي من عداء وحرب",42,"ب",1,1],["فَرَقيب وَلا حَبيب وَبَعد","في دُنوّ وَعَشرة مَع حَسود",43,"د",1,0],["فرق فرقت بشرق وغرب","باختلاف والجامع الاسلام",44,"م",1,0],["فرقوني أجزاء سقم كما قد","حولوا من جميعي الأحوالا",45,"ل",2,0],["فرق له معنى نسيم اللقا كما","له راق خمر الارتقا بالفناجين",46,"ن",1,0],["فرّقتهم فِرقاً فانحلَّ عِقْدُهم","بما أَساءُوا وعن أبنائهم نَفرُوا",47,"ر",3,0],["فرقَ اللهُ شملَهم ورماهم","دهرُهم بالعمَى وطولِ النكادِ",48,"د",1,0],["فَرْقُ ما بينَه وبين سواه","فَرْقُ ما بين لُجِّ بحرٍ وثَمْدِ",49,"د",1,0],["فَرَقاً لَعَمرُكَ أَن يُفارِقَ عِاصماً","بِالبَأسِ مَعصوماً مِنَ الفَحشاءِ",50,"ا",2,0],["فُرقَةٌ يا أَبا العَلاءِ أَصارَت","حَسَناتِ الزَمانِ عِندي ذُنوبا",51,"ب",2,0],["فَرَّقتَ شَملَ الخَوفِ وَهوَ مَجَمَّعٌ","وَجَمَعتَ شَملَ الأَمنِ وَهوَ مُشَعَّبُ",52,"ب",1,0],["فِرَقٌ تَخالَفُ أَلسُناً وَعَناصِراً","لَكِن تَشابَهَ ما اِنتَضَوا وَتَدَرَّعوا",53,"ع",3,0],["فَرَّقتَ جَمعاً لَو رَمَيتَ بِبَعضِهِ","أَركانَ رَضوى لَاِنبَرَت تَتَضَعضَعُ",53,"ع",1,0],["فرقت بينهما فراقاً طعمه","مر المذاقة لا لقا من دونه",54,"ن",2,0],["فرق لهم يحيى وقد كسرت لهم","مناياهم عن عضل أنيابها الفكا",55,"ك",2,0],["فرق وكف الطرف حتى لثمته","ثلاثا ودمعي سافحا فوق وجنتي",56,"ي",1,0],["فَرِقَّ لِي وَاِرث مِن هَمٍّ أُكابِدُهُ","شَوقاً إِلَيكَ وَحُزناً لِلّذي سَلَفا",57,"ف",2,0],["فَرِقت منها حتى أَنِستُ بها","مع التمادى فصرت لا أَفْرَقُ",58,"ق",1,0],["فرقوا لطيفك في المنام ففرَّقوا","بين الكرى المعهودِ والأجفان",59,"ن",1,0],["فرقادي ومقلتي في اختلاف","وسهادي ولوعتي في ائتلافي",60,"ف",2,0],["فرقت بيننا المنافع حيا","ليس يجديك في الممات عويلي",61,"ل",2,0],["فرقاب من عاده غمد حسامه","ودماؤهم لا زال ورد نباله",62,"ل",2,0],["فَرَّقَ الناسَ دينُهُم لا سَلامٌ","يَجعلُ الرفَ بَينَهُم وَالوئاما",63,"م",2,0],["فُرْقَة لا تزال في العين دمعاً","عند ذكرِي لها وفي القلب حَزَّه",64,"ز",2,0],["فرّقتهمْ يَدُ المنون فبادُوا","وَحوَتْهُمْ بعد القصور القبورُ",65,"ر",1,0],["فَرقَ ما بيْننَا اجْتماعٌ","أشْفَقْتُ منهُ على وَقارِهْ",66,"ر",2,0],["فرَقَّ لطفاً ولو أنّ الصَّبا علمت","بطبعه قصرت باللطف وافتضحت",67,"ت",1,0],["فرّقي فرقان فرقي واجمعي","جمع جمعي في بقاءٍ وفَنا",68,"ن",2,0],["فرقى الى ذى العرش أبعد غاية","وَرأى من الآيات أَكبر آية",69,"ه",1,0],["فَرِقابُهُمْ مِنْ ذِلَّةٍ خُضُعٌ","وَصِعَابُهُمْ مِنْ خِيفَةٍ ذُلُلُ",70,"ل",1,0],["فرقرقتْ أدمعاً أضحى بصيِّبها","روضُ الأمانيِّ بعد الجدْبِ فيْنانا",71,"ن",2,0],["فرقَّ لها قلبي وَلانَ وَلم تزلْ","دموعي عَلَى أمثالِها تترقرق",72,"ق",1,0],["فرقت بينهم مطامع جوفا","ء فباءا بذلة وركود",73,"د",1,0],["فِرَقٌ تعودُ وتَبتدِي فِرَقٌ","كالبحرِ يُبدِي المَدَّ والجزَرا",74,"ر",2,0],["فرقت بيننا الليالي فغودرت وماليَ","غير الفراق فريق",75,"ق",1,0],["فَرّق البين بِرَغمي","بين مَن أَهوى وَبَيني",76,"ن",2,0],["فرق ما بينَ النبيّ","وأخيهِ حيدرَه",77,"ر",2,0],["فرقى في مكة أكتافه","فغدت أصنامهم منه جثيا",78,"ي",2,0],["فرقتنا همة عالية","للذي بان وعنه نحن بنَّا",79,"ن",2,0],["فرقاً من فرق أفق السماء","لبس السحب قميصاً ثم زرّ",80,"ر",1