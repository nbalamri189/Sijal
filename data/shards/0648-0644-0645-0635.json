{"poems":[[68,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[147,"هل للخليط المستقل إياب","https://www.aldiwan.net/poem11723.html","الكامل"],[190,"رأيت الذي بيني وبينك قد وهى","https://www.aldiwan.net/poem43759.html","الطويل"],[275,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[366,"آل طه ومن يقل آل طه","https://www.aldiwan.net/poem68120.html","الخفيف"],[411,"ألا ليت شعري كيف أصبح طائري","https://www.aldiwan.net/poem49923.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86977","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86662","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86671","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87164","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48760","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59605","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126183","الكامل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28472","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133985","الخفيف"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45798","المتدارك"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118770","الكامل"],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[5525,"موت وميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=7256",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[6106,"إلى ربيع المولد النبوي","https://www.poetsgate.com/ViewPoem.aspx?id=6310",""]],"verses":[["وَلِم صَيَّرتَ بُعدَكَ قَيدَ قَلبي","وَكانَ جَمالُ وَجهِكَ قَيدَ عَيني",0,"ن",2,0],["وَلِمِصْرَ مَا يَجْنِي وَمَا يَبْنِي وَمَا","يَصِلُ الأَصَائِلَ فِيه بِالأَسْحَارِ",1,"ر",1,0],["وَلِمُصطَفى المُلكِ اِعتِزامُ المُصطَفى","لَمّا أَحاطَ بِيَثرِبَ الأَحزابُ",2,"ب",1,0],["ولم صبح المرء إلا كليله","إذا لم يكن فيه سرور يباكره",3,"ر",2,0],["ولمصرَ والغربِ القصيّ تعلّلٌ","بالقربِ بعدَ تمنُّعٍ وتعذُّر",4,"ر",1,0],["وَلِمِصر فَخر عَلى كُل مِصر","وَلَها طالِع بِقَبرِكَ سَعد",5,"د",1,0],["ولِمْ صارَ غيري مُؤنِساً في نَديِّكُمْ","ونُحِّيتُ عنكُمْ مُكَمدَ القَلبِ مَسجورا",6,"ر",2,0],["وَلمصر حَظ وافر بخدامة","مِنكَ اِستَنار بِها ظَلام مرجف",7,"ف",1,0],["وَلمصر عادَت رُوحُها عِندَ اللقا","وَاِستأنست بِكَ يا سَعيد الدَولة",8,"ه",1,0],["وَلمصر طُول الدَهر مِنهُ تَمدُّنٌ","يَزداد في أَوقاته بِبَواعث",9,"ث",1,0],["وَلمصر حظٌّ وافرٌ بخدامةٍ","مِنكَ اِستَنار بِها ظَلام داكن",10,"ن",1,0],["ولمصر شوراها وندوتها التي","أمن الرجال بها عثار رجال",11,"ل",1,0],["ولمصحف الإنجيل من رُهبانه","تالٍ يُنسِّي رجْعَ صوت العُود",12,"د",1,0],["ولمصطفاه صلاتنا وسلامنا","ولصحبه والتابعين وآل",13,"ل",1,0],["ولِمْ صبروا على أيام بؤس","لأهل الحيرة المتجبرينا",14,"ن",2,0],["وَلِمصعَبٍ مَلأَ الزَّمانَ هَديرُهُ","قادوهُ بَعدَ شَماسِهِ وَإِبائِهِ",15,"ا",3,0],["ولمصر على الخصوص هناء","برياض الخيرات دام وجوده",16,"د",2,0],["وَلِمَصر فَخرٌ لَم يَزل","بِولي النعمة لم يَزل",17,"ل",1,0],["ولمصر مع بغداد أنّة موجعٍ","يشكو أوام الصدر من زفراته",18,"ت",2,0],["ولمصطفى تصديقه واتباعه","وتعزيزه بل نفتقي ماله أمر",19,"ر",1,0],["ولمصافحك ربي خلق لي يميني","أمدها لك وصل وأمدها بعاد",20,"د",1,0],["ولَمِصرُ.. دارٌ للعروبة حُرّةٌ","تأوي الكرامَ.. وتُسند المتطلِّعا",21,"ع",2,0],["ولمصر كم فتنٍ تحاك بأرضها","لتفت قوتها لدى العدوان",22,"ن",1,0]]}