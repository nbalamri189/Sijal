{"poems":[[66,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[144,"هل للخليط المستقل إياب","https://www.aldiwan.net/poem11723.html","الكامل"],[187,"رأيت الذي بيني وبينك قد وهى","https://www.aldiwan.net/poem43759.html","الطويل"],[271,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[362,"آل طه ومن يقل آل طه","https://www.aldiwan.net/poem68120.html","الخفيف"],[406,"ألا ليت شعري كيف أصبح طائري","https://www.aldiwan.net/poem49923.html","الطويل"]],"verses":[["وَلِم صَيَّرتَ بُعدَكَ قَيدَ قَلبي","وَكانَ جَمالُ وَجهِكَ قَيدَ عَيني",0,"ن",2,0],["وَلِمِصْرَ مَا يَجْنِي وَمَا يَبْنِي وَمَا","يَصِلُ الأَصَائِلَ فِيه بِالأَسْحَارِ",1,"ر",1,0],["وَلِمُصطَفى المُلكِ اِعتِزامُ المُصطَفى","لَمّا أَحاطَ بِيَثرِبَ الأَحزابُ",2,"ب",1,0],["ولم صبح المرء إلا كليله","إذا لم يكن فيه سرور يباكره",3,"ر",2,0],["ولمصرَ والغربِ القصيّ تعلّلٌ","بالقربِ بعدَ تمنُّعٍ وتعذُّر",4,"ر",1,0],["وَلِمِصر فَخر عَلى كُل مِصر","وَلَها طالِع بِقَبرِكَ سَعد",5,"د",1,0],["ولِمْ صارَ غيري مُؤنِساً في نَديِّكُمْ","ونُحِّيتُ عنكُمْ مُكَمدَ القَلبِ مَسجورا",6,"ر",2,0]]}