لَ ذَوائِبَ الكيرانِ",0,"ن",1,0],["وَإِذا حَوَوا سَبقَ القَبائِلِ خَلَّقوا","غُرَرَ السَوابِقِ بِالنَجيعِ القاني",1,"ن",2,0],["وَإِذا حَرَّكَ الحَشا خاطِرٌ مِن","كَ تَوَهَّمتُ أَنَّني قَد رَأَيتُك",2,"ك",1,0],["وَإِذا حاجَةٌ نَأَت عَن سُؤالي","مِنكَ لَم تَنأَ عَن غِلابي وَعَضبي",3,"ب",2,0],["وَإِذَا حَبِيبةُ أُمِّ يَحْيَى أنجَبَتْ","فَلَهَا الشُّفُوفُ عَلَى عُيُونِ الْعِينِ",4,"ن",1,0],["وَإِذا حُمِّلَ عِبئاً بَعضُهُم","فَاِشتَكى الأَوصالَ مِنهُ وَأَنَح",5,"ح",1,0],["وَإِذا حاوَلتَ في الأُفقِ مُنىً","فَاِركَبِ البَرقَ وَلا تَرضَ الغَماما",6,"م",2,0],["وَإِذا حَلُمتَ فَأَعطِ حِلمَكَ كُنهَهُ","مُستَأنِياً وَإِذا كَوَيتَ فَأَنضِجِ",7,"ج",1,1],["وإذا حللتَ بموطنٍ","فاجعل محلّك في هضابه",8,"ب",2,0],["وَإِذا حَرَّكتُ غَرزي أَجمَرَت","أَو قَرا بي عَدوُ جَونٍ قَد أَبَلّ",9,"ل",1,0],["وإذا حُلى الملكِ المؤيدِ أشرقت","فاخْشع لما تمليهِ من آياتها",10,"ت",3,0],["وإذا حزَّ لي منَ المال عُضْواً","أرَّب العضوَ أيَّما تأريبِ",11,"ب",1,0],["وإذا حاسدٌ صفا من غليل","فهْوَ في وزْن عاشقٍ مُسْتهامِ",12,"م",1,0],["وَإِذا حارَبَها طاغِيَةٌ","كانَتِ الظافِرَةَ المُنتَصِرَه",13,"ر",2,0],["وَإِذا حَسِبتَ الرَوضَ تُغَنّي صورَةٌ","عَنهُ فَذَلِكَ مُنتَهى الإِفلاسِ",14,"س",1,0],["وإذا حَضَرْتُ جُموعَهُمْ ألْفَيْتَني","مَا بينهمْ كالبُلبلِ المأسورِ",15,"ر",1,0],["وَإِذا حَمَيتَ الماءَ لَم يورَد وَلَو","أَنَّ القَياصِرَ وَالمُلوكَ ظِماءُ",16,"ا",2,0],["وَإِذا حَصَلتَ مِنَ السِلاحِ عَلى البُكا","فَحَشاكَ رُعتَ بِهِ وَخَدَّكَ تَقرَعُ",17,"ع",1,0],["وَإِذا حاوَلَت طِعانَكَ خَيلٌ","أَبصَرَت أَذرُعَ القَنا أَميالا",18,"ل",2,0],["وَإِذا حَلَّ ساعَةً بِمَكانٍ","فَأَذاهُ عَلى الزَمانِ حَرامُ",19,"م",1,0],["وَإِذا حَلَلتَ فِناءَهُم مُتَوَسِّطاً","فيهِم فَما اِسمُ النيلِ غَيرُ جَزيلِ",20,"ل",1,0],["وَإِذا حُمِلتُ إِلى الصَلاةِ كَأَنَّني","عِبءٌ يَميلُ بِعِدلِهِ المَعدولِ",21,"ل",1,0],["وَإِذا حَلَلتَ عَنِ اللِسانِ عِقالَهُ","أَلقاكَ في قيلٍ عَلَيكَ وَقالِ",22,"ل",1,0],["وَإِذا حَسَدتَ عَلى التُقى","قَوماً فَكُن بِهِمُ شَبيها",23,"ي",3,0],["وَإِذا حَصِرتُ فَلَيسَ ذاكَ بِمُبطِلٍ","ما قَد مَضى مِن حُرمَتي وَذِمامي",24,"م",2,0],["وإذا حلّ الهوى هي","هات تدري كيف كانا",25,"ن",2,0],["وإذا حاولَ في طعنِ الكُلى","صَرّفَ اللهذَمَ تصريفَ القلم",26,"م",1,0],["وَإِذا حَديثُ الذَمِّ يَم","مَمَني وَنى وَتَخَلَّفا",27,"ف",2,0],["وَإِذا حَثَّها الرِكابُ أَوِ السَو","طُ أَطارَت أَرواحُها الأَجسادا",28,"د",2,0],["وإذا حَلَّتِ الْهِدَايَةُ قَلْبَاً","نَشِطَتْ في العبادة الأَعضاءُ",29,"ا",2,0],["وَإِذا حُسِدتَ فَإِنَّ شُكرَ فَضيلَةٍ","أَن لا تُؤاخِذَ في الإِساءَةِ حاسِدا",30,"د",2,0],["وَإِذا حَصَلتَ مُراقِباً في مَنزِلٍ","سُكّانَهُ أُلفيتَ خِدَنَ حِصارِ",31,"ر",1,0],["وَإِذا حازَتِ الأَنامِلُ مِلكاً","صارَ هُلكاً في قَبضَةِ الحَوّازِ",32,"ز",1,0],["وَإِذَا حِجَابُ اليَأْسِ شُقَّ وَدُوَنَهُ","أَمَلٌ كَحَدِّ المُنْصَلِ المُتَلاَلِي",33,"ل",2,0],["وَإِذَا حَارِس بَدَا مِنْ خَفُاءٍ","كَتَرَائِي الشَّيْطَانِ فِي شَكْلِ عَبْدِ",34,"د",1,0],["وَإِذا حَرَّكَ رَأْساً أَكْبَرُوا","وَحْيَهُ لِلّهِ ذَاكَ الْوَحْيُ دَرَّا",35,"ر",2,0],["وَإِذَا حَقِيبَتُكَ الصَّغِيرَةُ تَحْتَوِي","ذُخْراً تَضَاءَلُ دُونَهُ الأَذْخَارُ",36,"ر",1,0],["وإذا حلَّ بالمعلم ضيمٌ","رُمي الشَّعبُ كلُّهُ بانحلال",37,"ل",1,0],["وإذا حلَّ صالحٌ في مكان","كان غابًا يحلُّ فيهِ أُسامة",38,"م",2,0],["وإذا حلمتَ فأعطِ حلمكَ كنهه ----مُسْتَأْنِياً، وإذَا كَوَيْتَ فَأَنْضِجِ","وإذا التمستَ دخولَ أمرٍ فالتمسْ--- من قبلِ مدخله سبيلَ المخرجِ",39,"ج",1,1],["وإذا حَلَلْتَ فِنَاءَهُمْ مُتَوَسّطاً","فيهِمْ، فَما اسْمُ النِّيلِ غبرُ جَزِيلِ",40,"ل",1,0],["وإذا حنّ للكرى فذراعان","ونهدان وابتسام وريّا",41,"ي",2,0],["وإذا حملتُ على الكريهِة لم أقلْ","بعد الكريهة ِ ليتني لم أفعل",42,"ل",1,0],["وإذا حرَّكَ الشفاهَ بلفظٍ","منه أضنت جسومَنا حركاتُه",43,"ت",2,0],["وإِذَا حَسَا المُتَيَّمُ مِنهُ","ذَهَبَ الوَجدُ والأسَى والهَمُّ",44,"م",1,0],["وإذا حملت على الكريهة لم أقل","بعد العزيمة ليتني لم أفعل",45,"ل",1,0],["وَإِذا حَمى الأَصحابُ نَفسَ مُمَلَّكٍ","فَبِسَيفِهِ يَستَعصِمُ الأَصحابُ",46,"ب",1,0],["وَإِذا حارَبوا رَأَيتَ قُلوبَ ال","أُسدِ قَد أودِعَت صُدورَ الرِجالِ",47,"ل",1,0],["وَإِذا حقّقتها تلقاهُ في","واحدٍ منها على الخلق أميرا",48,"ر",2,0],["وَإِذا حَلَفتَ بأنّ مَث","واكَ الجِنان فلستَ حانِث",49,"ث",1,0],["وَإِذا حازَها المُرَوَّحُ حاكَت","عَن ضُروعٍ كَأَنَّهُنَّ الدِلاءُ",50,"ا",2,0],["وإذا حسا الكأس اركعنّ","له وبالأخرى تقدّم",51,"م",1,0],["وإذا حدثني عنها امرؤٌ","ظَلْتُ أُقصيه ولو كان حميمي",52,"م",2,0],["وإذا حرمت الجد ظلت من الدنا","ظمآن تستقي غروراً آلها",53,"ل",3,1],["وإذا حاولت غمراً","صرت غمراً وغلاما",54,"م",2,0],["وَإذا حُقّت الحقائقُ قلنا","أَجلٌ سابق لها في الكتابِ",55,"ب",1,0],["وَإِذا حُزتَ القُبولَ وَخابَ خَطّي","فَكانَ إِذا عَلى نَفسي دُعائي",56,"ا",3,0],["وإذا حقق الوفاء تجلّت","رحمة الله في قلوب الأنام",57,"م",1,0],["وإذا حدّثت يداه فمرحى","وإلى الملتقى ودعني وشاني",58,"ن",2,0],["وإذا حاجِباهُ شالا فإع","جابُ محِبٍّ أو كبرياءُ أناني",58,"ن",2,0],["وإذا حققَ القضا","خان ما كان حقَّقا",59,"ق",2,0],["وإذا حَباكَ بغُرَّةٍ من مالِهِ","ثَنَّى وأعقَبَ غرَّةً تَحجيلا",60,"ل",2,0],["وإذا حَباكَ بتافِهِ فاقنَعْ به","واكسِبْ كَثيراً تافِهاً من تافِهِ",61,"ف",2,0],["وإذا حُمَّتِ المقاديرُ أخطا ال","مرءُ في الرّأيِ حيث كان يُصيبُ",62,"ب",1,0],["وإذا حمِدنَاهُ على","حَالٍ تنكَّرَ واستَحالا",63,"ل",2,0],["وإذا حوَى الرغباتِ أمْ","ضَى للعلا فيها احتكَامَهْ",64,"م",2,0],["وإذا حلّ بدارٍ قد بَغَتْ","حَلَّ فيها الويل منه والثبور",65,"ر",1,0],["وإذا حدّ لنا أم","راً الى الأمرِ جرَيْنا",66,"ن",2,0],["وإذا حُثَّتِ الكؤوسُ وجالَتْ","كنتَ لا شكّ فارسَ المَيْدانِ",67,"ن",1,0],["وإذا حبتك سرورها","فاحذر مغبات الشبع",68,"ع",1,0],["وإذا حفِظتُ النجم فيها لم أُبَل","ما ضاع من أثرٍ بها أو مُعلَمِ",69,"م",1,0],["وإذا حملتُ عليه ثِقْلا لم أقل","يا ليتني رَوّحتُ ظهرَ الحاملِ",70,"ل",1,0],["وإذا حوسبوا على الحسَب الأب","عدِ عَدُّوا بَهرام أو سابورا",71,"ر",2,0],["وإذا حفِظتُك باكياً ومؤبِّناً","عابوا عليك تفجُّعي وتلدُّدي",72,"د",2,0],["وإذا حبّرتُ فيهِ مدحةً","قالتِ الرّيح أو البرقُ ألكني",73,"ن",2,0],["وإذا حشرْتُ بُعَيْدَ موتي في غَدٍ","حُبِّي لِهاتيكَ الوُجوهِ شِعاري",74,"ر",2,0],["وإذا حللتَ أسىً حَلَلْتُ وإن تُرِدْ","صبراً صبرتُ وفي يديك زِمامي",75,"م",2,0],["وَإِذا حُرِمتُ وُصولَها بيَدي","أَنفذتُ نُسخَتها عَل