{"poems":[[53,"لون الشبينة أنصل الألوان","https://www.aldiwan.net/poem29658.html","الكامل"],[53,"صبرا غريم الثأر من عدنان","https://www.aldiwan.net/poem29664.html","الرجز"],[53,"يا ابن عبد العزيز لو بكت العي","https://www.aldiwan.net/poem30676.html","الخفيف"],[53,"لو على قدر ما يحاول قلبي","https://www.aldiwan.net/poem30765.html","الخفيف"],[77,"حي تلمسان الحيا فربوعها","https://www.aldiwan.net/poem36058.html","الكامل"],[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[86,"بالذي أجراك يا ريح الخزامى","https://www.aldiwan.net/poem10684.html","الرمل"],[54,"وإذا حلمت فأعط حلمك كنهه","https://www.aldiwan.net/poem27620.html","الكامل"],[88,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[72,"لولا معاني السحر من لحظاتها","https://www.aldiwan.net/poem18383.html","الكامل"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[91,"خير ما يكتبه ذو مرقم","https://www.aldiwan.net/poem8865.html","عموديه"],[91,"لم يبق ما يسليك غير الكاس","https://www.aldiwan.net/poem8973.html","عموديه"],[92,"يا أيها الشادي المغرد ههنا","https://www.aldiwan.net/poem38941.html","الكامل"],[85,"ولد الهدى فالكائنات ضياء","https://www.aldiwan.net/poem20977.html","الكامل"],[43,"الحزن يقلق والتجمل يردع","https://www.aldiwan.net/poem9724.html","الكامل"],[43,"ذي المعالي فليعلون من تعالى","https://www.aldiwan.net/poem9979.html","الخفيف"],[43,"أين أزمعت أيهذا الهمام","https://www.aldiwan.net/poem10141.html","الخفيف"],[45,"صب يخاطب مفحمات طلول","https://www.aldiwan.net/poem65548.html","الكامل"],[28,"ليست ترد ديات من قد قتلت","https://www.aldiwan.net/poem5440.html","الكامل"],[49,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[49,"إيها إليك أخي إيها","https://www.aldiwan.net/poem63196.html","مجزوء الكامل"],[49,"أبلغ سلمت أبا الوليد سلامي","https://www.aldiwan.net/poem64907.html","الكامل"],[97,"كم تجرعنا هوانا","https://www.aldiwan.net/poem24766.html","مجزوء الرمل"],[80,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[52,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[52,"ليت يومي بنهر فروخ عادا","https://www.aldiwan.net/poem27119.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[46,"يستأسد النبت الغضيض فلا تلم","https://www.aldiwan.net/poem22439.html","الكامل"],[46,"تلف البصائر والزمان مفجع","https://www.aldiwan.net/poem22708.html","الكامل"],[46,"صنعة عزت الأنام بلطف","https://www.aldiwan.net/poem22771.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54712","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[106,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[106,"حفظ الله صالحًا","https://www.poetsgate.com/ViewPoem.aspx?id=179358",""],[54,"وإذا حلمتَ فأعطِ حلمكَ كنهه","https://www.poetsgate.com/ViewPoem.aspx?id=14002",""],[45,"صَب يُخَاطِبُ مُفْحَمَاتِ طُلُولِ","https://www.poetsgate.com/ViewPoem.aspx?id=32063",""],[3,"طال الثَّواءُ على رُسوم المنْزل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10727&r=&rc=81",""],[126,"من لصب تصاعدت حسراته","https://www.aldiwan.net/poem50653.html","الخفيف"],[130,"لم يكن في إدارة الكأس ذم","https://www.aldiwan.net/poem54744.html","الخفيف"],[138,"أما حكيم فالتمست دماغه","https://www.aldiwan.net/poem2138.html","الكامل"],[141,"هل للخليط المستقل إياب","https://www.aldiwan.net/poem11723.html","الكامل"],[141,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[187,"خذ كتابا جمع الفضل وإن","https://www.aldiwan.net/poem35137.html","الرمل"],[187,"وصل السراة وأنت ماكث","https://www.aldiwan.net/poem35170.html","مجزوء الكامل"],[193,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[195,"حي الصباح إذا تبسم","https://www.aldiwan.net/poem39901.html","مجزوء الكامل"],[196,"لا تصيخن لتشويق النديم","https://www.aldiwan.net/poem51886.html","الرمل"],[259,"وإذا حرمت الجد ظلت من الدنا","https://www.aldiwan.net/poem38129.html","الكامل"],[259,"جرب الناس مرارا","https://www.aldiwan.net/poem38187.html","مجزوء الرمل"],[303,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[318,"دعوت الله أن تسمو وتعلو","https://www.aldiwan.net/poem61755.html","البسيط"],[326,"أمل لا يزال فوق المرام","https://www.aldiwan.net/poem54962.html","الخفيف"],[326,"هائم الروح بالهوى والأماني","https://www.aldiwan.net/poem54990.html","الخفيف"],[374,"دهرنا قد تزندقا","https://www.aldiwan.net/poem59319.html","مجزوء الخفيف"],[402,"ملك يفيض على العفاة سجاله","https://www.aldiwan.net/poem49509.html","الكامل"],[402,"يامن يشافهه النصيح بنصحه","https://www.aldiwan.net/poem49859.html","الكامل"],[406,"كف عني واش وأغضى رقيب","https://www.aldiwan.net/poem32148.html","الخفيف"],[406,"قالوا ترشفت الليالي ماءه","https://www.aldiwan.net/poem32170.html","الكامل"],[406,"أبني السرى والبيد لا","https://www.aldiwan.net/poem32254.html","مجزوء الكامل"],[413,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[429,"أيها اللائم لم غي","https://www.aldiwan.net/poem12544.html","مجزوء الرمل"],[429,"لا تجرد علي مرهف جفني","https://www.aldiwan.net/poem12738.html","الخفيف"],[441,"اقنع من الدنيا بما","https://www.aldiwan.net/poem55983.html","عموديه"],[456,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[456,"لعدو حسنك ما لسمع العاذل","https://www.aldiwan.net/poem56068.html","الكامل"],[456,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[456,"أقريش لا فلم أراك ولا يد","https://www.aldiwan.net/poem56235.html","الكامل"],[462,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[498,"ما الفخر إلا للذين تواضعوا","https://www.aldiwan.net/poem38013.html","الكامل"],[549,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[549,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[549,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[549,"يا عليل الطرف رفقا","https://www.aldiwan.net/poem47264.html","مجزوء الرمل"],[549,"لا تفخرن إلا بنفسك","https://www.aldiwan.net/poem48032.html","مجزوء الكامل"],[549,"قل للذين إذا دعوا","https://www.aldiwan.net/poem48036.html","مجزوء الكامل"],[549,"ليس للقلب في السلو نصيب","https://www.aldiwan.net/poem48092.html","الخفيف"],[551,"لا تقنعن ومطلب لك واسع","https://www.aldiwan.net/poem68363.html","الكامل"],[556,"انهض بربك لا بنفسك","https://www.aldiwan.net/poem34286.html","مجزوء الكامل"],[556,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[560,"طال النوى حتى تقطعت المنى","https://www.aldiwan.net/poem52987.html","الكامل"],[573,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[573,"أما الغرام بها فعاد كما بدا","https://www.aldiwan.net/poem3079.html","الكامل"],[584,"طرف تعرض بعدكم لهجوع","https://www.aldiwan.net/poem17592.html","الكامل"]],"verses":[["وَإِذا حَطَطتُ عَلَيكَ أَقسَمَتِ المُنى","أَن لا أُميلَ ذَوائِبَ الكيرانِ",0,"ن",1,0],["وَإِذا حَوَوا سَبقَ القَبائِلِ خَلَّقوا","غُرَرَ السَوابِقِ بِالنَجيعِ القاني",1,"ن",2,0],["وَإِذا حَرَّكَ الحَشا خاطِرٌ مِن","كَ تَوَهَّمتُ أَنَّني قَد رَأَيتُك",2,"ك",1,0],["وَإِذا حاجَةٌ نَأَت عَن سُؤالي","مِنكَ لَم تَنأَ عَن غِلابي وَعَضبي",3,"ي",1,0],["وَإِذَا حَبِيبةُ أُمِّ يَحْيَى أنجَبَتْ","فَلَهَا الشُّفُوفُ عَلَى عُيُونِ الْعِينِ",4,"ن",1,0],["وَإِذا حُمِّلَ عِبئاً بَعضُهُم","فَاِشتَكى الأَوصالَ مِنهُ وَأَنَح",5,"ح",1,0],["وَإِذا حاوَلتَ في الأُفقِ مُنىً","فَاِركَبِ البَرقَ وَلا تَرضَ الغَماما",6,"م",2,0],["وَإِذا حَلُمتَ فَأَعطِ حِلمَكَ كُنهَهُ","مُستَأنِياً وَإِذا كَوَيتَ فَأَنضِجِ",7,"ج",1,1],["وإذا حللتَ بموطنٍ","فاجعل محلّك في هضابه",8,"ب",2,0],["وَإِذا حَرَّكتُ غَرزي أَجمَرَت","أَو قَرا بي عَدوُ جَونٍ قَد أَبَلّ",9,"ل",1,0],["وإذا حُلى الملكِ المؤيدِ أشرقت","فاخْشع لما تمليهِ من آياتها",10,"ت",3,0],["وإذا حزَّ لي منَ المال عُضْواً","أرَّب العضوَ أيَّما تأريبِ",11,"ب",1,0],["وإذا حاسدٌ صفا من غليل","فهْوَ في وزْن عاشقٍ مُسْتهامِ",12,"م",1,0],["وَإِذا حارَبَها طاغِيَةٌ","كانَتِ الظافِرَةَ المُنتَصِرَه",13,"ر",2,0],["وَإِذا حَسِبتَ الرَوضَ تُغَنّي صورَةٌ","عَنهُ فَذَلِكَ مُنتَهى الإِفلاسِ",14,"س",1,0],["وإذا حَضَرْتُ جُموعَهُمْ ألْفَيْتَني","مَا بينهمْ كالبُلبلِ المأسورِ",15,"ر",1,0],["وَإِذا حَمَيتَ الماءَ لَم يورَد وَلَو","أَنَّ القَياصِرَ وَالمُلوكَ ظِماءُ",16,"ا",2,0],["وَإِذا حَصَلتَ مِنَ السِلاحِ عَلى البُكا","فَحَشاكَ رُعتَ بِهِ وَخَدَّكَ تَقرَعُ",17,"ع",1,0],["وَإِذا حاوَلَت طِعانَكَ خَيلٌ","أَبصَرَت أَذرُعَ القَنا أَميالا",18,"ل",2,0],["وَإِذا حَلَّ ساعَةً بِمَكانٍ","فَأَذاهُ عَلى الزَمانِ حَرامُ",19,"م",1,0],["وَإِذا حَلَلتَ فِناءَهُم مُتَوَسِّطاً","فيهِم فَما اِسمُ النيلِ غَيرُ جَزيلِ",20,"ل",1,0],["وَإِذا حُمِلتُ إِلى الصَلاةِ كَأَنَّني","عِبءٌ يَميلُ بِعِدلِهِ المَعدولِ",21,"ل",1,0],["وَإِذا حَلَلتَ عَنِ اللِسانِ عِقالَهُ","أَلقاكَ في قيلٍ عَلَيكَ وَقالِ",22,"ل",1,0],["وَإِذا حَسَدتَ عَلى التُقى","قَوماً فَكُن بِهِمُ شَبيها",23,"ي",3,0],["وَإِذا حَصِرتُ فَلَيسَ ذاكَ بِمُبطِلٍ","ما قَد مَضى مِن حُرمَتي وَذِمامي",24,"ي",1,0],["وإذا حلّ الهوى هي","هات تدري كيف كانا",25,"ن",2,0],["وإذا حاولَ في طعنِ الكُلى","صَرّفَ اللهذَمَ تصريفَ القلم",26,"م",1,0],["وَإِذا حَديثُ الذَمِّ يَم","مَمَني وَنى وَتَخَلَّفا",27,"ف",2,0],["وَإِذا حَثَّها الرِكابُ أَوِ السَو","طُ أَطارَت أَرواحُها الأَجسادا",28,"د",2,0],["وإذا حَلَّتِ الْهِدَايَةُ قَلْبَاً","نَشِطَتْ في العبادة الأَعضاءُ",29,"ا",2,0],["وَإِذا حُسِدتَ فَإِنَّ شُكرَ فَضيلَةٍ","أَن لا تُؤاخِذَ في الإِساءَةِ حاسِدا",30,"د",2,0],["وَإِذا حَصَلتَ مُراقِباً في مَنزِلٍ","سُكّانَهُ أُلفيتَ خِدَنَ حِصارِ",31,"ر",1,0],["وَإِذا حازَتِ الأَنامِلُ مِلكاً","صارَ هُلكاً في قَبضَةِ الحَوّازِ",32,"ز",1,0],["وَإِذَا حِجَابُ اليَأْسِ شُقَّ وَدُوَنَهُ","أَمَلٌ كَحَدِّ المُنْصَلِ المُتَلاَلِي",33,"ل",2,0],["وَإِذَا حَارِس بَدَا مِنْ خَفُاءٍ","كَتَرَائِي الشَّيْطَانِ فِي شَكْلِ عَبْدِ",34,"د",1,0],["وَإِذا حَرَّكَ رَأْساً أَكْبَرُوا","وَحْيَهُ لِلّهِ ذَاكَ الْوَحْيُ دَرَّا",35,"ر",2,0],["وَإِذَا حَقِيبَتُكَ الصَّغِيرَةُ تَحْتَوِي","ذُخْراً تَضَاءَلُ دُونَهُ الأَذْخَارُ",36,"ر",1,0],["وإذا حلَّ بالمعلم ضيمٌ","رُمي الشَّعبُ كلُّهُ بانحلال",37,"ل",1,0],["وإذا حلَّ صالحٌ في مكان","كان غابًا يحلُّ فيهِ أُسامة",38,"م",2,0],["وإذا حلمتَ فأعطِ حلمكَ كنهه ----مُسْتَأْنِياً، وإذَا كَوَيْتَ فَأَنْضِجِ","وإذا التمستَ دخولَ أمرٍ فالتمسْ--- من قبلِ مدخله سبيلَ المخرجِ",39,"ج",1,1],["وإذا حَلَلْتَ فِنَاءَهُمْ مُتَوَسّطاً","فيهِمْ، فَما اسْمُ النِّيلِ غبرُ جَزِيلِ",40,"ل",1,0],["وإذا حملتُ على الكريهِة لم أقلْ","بعد الكريهة ِ ليتني لم أفعل",41,"ل",1,0],["وإذا حرَّكَ الشفاهَ بلفظٍ","منه أضنت جسومَنا حركاتُه",42,"ت",2,0],["وإِذَا حَسَا المُتَيَّمُ مِنهُ","ذَهَبَ الوَجدُ والأسَى والهَمُّ",43,"م",1,0],["وإذا حملت على الكريهة لم أقل","بعد العزيمة ليتني لم أفعل",44,"ل",1,0],["وَإِذا حَمى الأَصحابُ نَفسَ مُمَلَّكٍ","فَبِسَيفِهِ يَستَعصِمُ الأَصحابُ",45,"ب",1,0],["وَإِذا حارَبوا رَأَيتَ قُلوبَ ال","أُسدِ قَد أودِعَت صُدورَ الرِجالِ",46,"ل",1,0],["وَإِذا حقّقتها تلقاهُ في","واحدٍ منها على الخلق أميرا",47,"ر",2,0],["وَإِذا حَلَفتَ بأنّ مَث","واكَ الجِنان فلستَ حانِث",48,"ث",1,0],["وَإِذا حازَها المُرَوَّحُ حاكَت","عَن ضُروعٍ كَأَنَّهُنَّ الدِلاءُ",49,"ا",2,0],["وإذا حسا الكأس اركعنّ","له وبالأخرى تقدّم",50,"م",1,0],["وإذا حدثني عنها امرؤٌ","ظَلْتُ أُقصيه ولو كان حميمي",51,"م",2,0],["وإذا حرمت الجد ظلت من الدنا","ظمآن تستقي غروراً آلها",52,"ل",3,1],["وإذا حاولت غمراً","صرت غمراً وغلاما",53,"م",2,0],["وَإذا حُقّت الحقائقُ قلنا","أَجلٌ سابق لها في الكتابِ",54,"ب",1,0],["وَإِذا حُزتَ القُبولَ وَخابَ خَطّي","فَكانَ إِذا عَلى نَفسي دُعائي",55,"ا",3,0],["وإذا حقق الوفاء تجلّت","رحمة الله في قلوب الأنام",56,"م",1,0],["وإذا حدّثت يداه فمرحى","وإلى الملتقى ودعني وشاني",57,"ن",2,0],["وإذا حاجِباهُ شالا فإع","جابُ محِبٍّ أو كبرياءُ أناني",57,"ن",2,0],["وإذا حققَ القضا","خان ما كان حقَّقا",58,"ق",2,0],["وإذا حَباكَ بغُرَّةٍ من مالِهِ","ثَنَّى وأعقَبَ غرَّةً تَحجيلا",59,"ل",2,0],["وإذا حَباكَ بتافِهِ فاقنَعْ به","واكسِبْ كَثيراً تافِهاً من تافِهِ",60,"ف",2,0],["وإذا حُمَّتِ المقاديرُ أخطا ال","مرءُ في الرّأيِ حيث كان يُصيبُ",61,"ب",1,0],["وإذا حمِدنَاهُ على","حَالٍ تنكَّرَ واستَحالا",62,"ل",2,0],["وإذا حوَى الرغباتِ أمْ","ضَى للعلا فيها احتكَامَهْ",63,"م",2,0],["وإذا حلّ بدارٍ قد بَغَتْ","حَلَّ فيها الويل منه والثبور",64,"ر",1,0],["وإذا حدّ لنا أم","راً الى الأمرِ جرَيْنا",65,"ن",2,0],["وإذا حُثَّتِ الكؤوسُ وجالَتْ","كنتَ لا شكّ فارسَ المَيْدانِ",66,"ن",1,0],["وإذا حبتك سرورها","فاحذر مغبات الشبع",67,"ع",1,0],["وإذا حفِظتُ النجم فيها لم أُبَل","ما ضاع من أثرٍ بها أو مُعلَمِ",68,"م",1,0],["وإذا حملتُ عليه ثِقْلا لم أقل","يا ليتني رَوّحتُ ظهرَ الحاملِ",69,"ل",1,0],["وإذا حوسبوا على الحسَب الأب","عدِ عَدُّوا بَهرام أو سابورا",70,"ر",2,0],["وإذا حفِظتُك باكياً ومؤبِّناً","عابوا عليك تفجُّعي وتلدُّدي",71,"د",2,0],["وإذا حبّرتُ فيهِ مدحةً","قالتِ الرّيح أو البرقُ ألكني",72,"ي",1,0],["وإذا حشرْتُ بُعَيْدَ موتي في غَدٍ","حُبِّي لِهاتيكَ الوُجوهِ شِعاري",73,"ي",1,0],["وإذا حللتَ أسىً حَلَلْتُ وإن تُرِدْ","صبراً صبرتُ وفي يديك زِمامي",74,"ي",1,0],["وَإِذا حُرِمتُ وُصولَها بيَدي","أَنفذتُ نُسخَتها عَلى رَسمي",75,"ي",1,0],["وإذا حللتَ ببلدةٍ","فكأنّما حلَّ الغمامُ",76,"م",1,0],["وإذا حَلّأتني عَنْ","كَ فمن يروي غليلي",77,"ل",2,0],["وإذا حبوتَ بكلِّ ما","فوقَ السَّدادِ فما بَخِلْتا",78,"ت",2,0],["وَإذا حويتُ فَللتكر","رُمِ ما ملكتُ وما حويتُ",79,"ت",1,0],["وَإِذا حُصّلَ الوِدادُ تَدانى","ذو بِعادٍ وَبانَ عَنكَ القَريبُ",80,"ب",1,0],["وَإِذا حَرَصتَ فَأَلقِ سَترَ قَناعَةٍ","مِن دونِ حِرصِكَ لا تَلَجَّ فَتَطبَعِ",81,"ع",1,0],["وإذا حصلت على الذي","تحوي فيومك فوق أمسك",82,"ك",1,0],["وإذا حقق المحقق هذا","ونفى عنه بالسوى تغريرا",83,"ر",2,0],["وإذا حَوَى الأموالَ كان كتاجرٍ","يبغي النَّفاقَ مُعجَّلاً ما أمكَنا",84,"ن",2,0],["وإِذا حواه الطِّرسُ فَتَّحَ أَعْيناً","من زَهْرِه تصبُو إِليه الأَعْيُنَا",85,"ن",2,0],["وإِذا حَمَلْنَ مُهَنَّداً فِي فِتْنَةٍ","فَمِنَ الضَّرورَةِ أَنْ يَكُون مُجَرَّدا",86,"د",2,0],["وَإذَا حَلَلْتُمْ فِي مَحَلٍّ مُمْحِلٍ","كُسِيَتْ مَحَاسِنُهُ بِكُلَّ رَبِيعِ",87,"ع",1,0]]}