{"poems":[[88,"مضيت ونحن أحوج ما نكون","https://www.aldiwan.net/poem10370.html","الوافر"],[75,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[37,"سيأتي أمير المؤمنين ودونه","https://www.aldiwan.net/poem38819.html","الطويل"],[45,"لعينيك ما يلقى الفؤاد وما لقي","https://www.aldiwan.net/poem9733.html","الطويل"],[63,"على غير عتب ما طويت عتابها","https://www.aldiwan.net/poem51781.html","الطويل"],[48,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140987",""],[164,"ولما أراد الله أن الهدى يحيى","https://www.aldiwan.net/poem58884.html","البسيط"],[208,"أخي لا تؤاخذني وإن كان لي","https://www.aldiwan.net/poem53356.html","الطويل"],[216,"سرى كنسيم الخافقين أتاني","https://www.aldiwan.net/poem37829.html","الطويل"],[302,"أشمس سناها في الدجنة بازغ","https://www.aldiwan.net/poem33222.html","الطويل"],[435,"هو الحب في العشاق ينفذ ما يقضي","https://www.aldiwan.net/poem39881.html","الطويل"],[445,"هنيئا لنا ولأقصى العباد","https://www.aldiwan.net/poem34777.html","المتقارب"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82790","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59742","الطويل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17570","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107217","الطويل"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26661","الوافر"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109357","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137021",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65936","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65991","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65134","الطويل"],[3153,"","https://poetry.dctabudhabi.ae/diwan/poem/126024","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48321","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138554",""],[4679,"أأذنبَ في لونه الأسودُ","https://www.poetsgate.com/ViewPoem.aspx?id=142773",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5431,"حلّوا عن بلادي...","https://www.poetsgate.com/ViewPoem.aspx?id=207644",""],[5497,"معسولة اللمى","https://www.poetsgate.com/ViewPoem.aspx?id=208977",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6164,"حب وعرفان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66047&r=&rc=56",""]],"verses":[["وَلَم يَثنِ الوَعيدُ لَهُ عِناناً","وَلَم تَحنَث لَهُ أَبَداً يَمينُ",0,"ن",1,0],["وَلَم يَثنِنا أَنَّ الرَبابَ عَقيلَةٌ","تَسانَدُ سَعدٌ دونَها وَرِبابُ",1,"ب",1,0],["وَلَم يَثنِهِ عِندَ الصَبابَةِ نَهيُها","غَداةَ اِستَهَلَّت بِالدُموعِ شُؤونُها",2,"ن",3,0],["وَلَم يَثنِكَ الأَعداءُ عَن مُهَجاتِهِم","بِمِثلِ خُضوعٍ في كَلامٍ مُنَمَّقِ",3,"ق",1,0],["ولم يَثْنِ طَرْفَ العينِ حتى تَهلَّلَتْ","مَدامعُ مُزْنٍ لا تَمَلُّ انسكابَها",4,"ب",3,0],["ولم يَثْبُتِ القُطْبانِ فيهِ تحَيّراً","وما تلكَ إلاّ وقْفَةٌ عنْ تَبَلّدِ",5,"د",1,0],["ولم يثنك الأعداء عن مهاجتهم","بمثل خضوعٍ في كلامٍ منمّق",6,"ق",1,0],["ولم يثن عنه الملك إلا وقد أتي","بأمر عظيم لا تداوي به الأدوى",7,"ا",1,0],["ولم يثنني التقصير عنكم وإنما","ثنى عزمتي لما انثنى الغُصُنُ الرطبُ",8,"ب",1,0],["وَلَمْ يَثْنِهم عن دَرْكِه قَطُّ دافِعٌ","ولو كانَ محْرُوساً بكلِّ سنانِ",9,"ن",1,0],["وَلَم يَثنِها عنّي سلوٌّ وَلا قِلىً","وَلكنَّ شَيطانَ الملامة نازغُ",10,"غ",1,0],["ولم يثنني عن سنة الحب والهوى","سوى مدح داود وذلكم فرضي",11,"ض",2,0],["ولم يَثْنِها عن مَدىً غارَةٌ","تُغَوِّرُها فِي مَغَارِ البِعادِ",12,"د",1,0],["وَلم يَثنه في الشَرق وَالغَرب ضَجة","لِأَمر أَقامَ الأَرض هَولا وَأَقعَدا",13,"د",2,0],["ولم يثنني طرفٌ من النور ناعسٌ","ولا معطف للبان وسط الحدائق",14,"ق",1,0],["وَلَم يُثنِهِ عَن شَهرَزورَ مَصيفُها","وَوردُ أجاجِ الشربِ غَير فُراتِ",15,"ت",1,0],["وَلم يُثننِي دَاع المَلامِ عَنِ الهَوى","فَما لِحَبِيبِي قَد ثَنَتهُ دُعاتُهُ",16,"ت",2,0],["ولم يثبت من الأشياع إلا","شقيقك وهو صارمك الحسام",17,"م",1,0],["ولم يثن منه العزم نفي ولا لوى","عنان تفانيه بتحريرها البعد",18,"د",1,0],["ولم يثن يوما لامرءٍ من عنانه","ولكن له القى زماماً ومقودا",19,"د",2,0],["ولم يثنني خوف ولا جفوة ولا","أردّ عناني أن بكين الكواعب",20,"ب",1,0],["ولم يثنني حسن اصطخاب حليها","ولا لطف أطراف وحسن خواتم",21,"م",1,0],["ولم يثنه قول النصيح بغشه","بأن صلات المادحين مغارم",22,"م",1,0],["ولم يثن عن نفسي الردى غيرانها","تنوء باق من رجاءك ثائب",23,"ب",1,0],["ولمْ يثْنِه من بارق الأفْقِ نيّرٌ","كعَذْبِ الثّنايا ما العُذَيْبُ وبارِقُ",24,"ق",1,0],["ولم يثن ماضي عزمه فقد ناصر","وفقدان احباب وصرخة أيم",25,"م",1,0],["ولم يثنهم حارسٌ قائمٌ","على حفظ أمن الورى يسهدُ",26,"د",1,0],["ولم يثنه عن نصرة الحق والهدى","جناية ذي بغيٍ ولا زيغ ذي صد",27,"د",1,0],["ولم يثمر رياض القوم تمرا","يُزيل المُرّ عن ثغر المُراد",28,"د",1,0],["ولم يثنني عنها حسودٌ وعاذلٌ","إلى أن طرقتُ الباب في أيمن الحمى",29,"م",2,0],["ولم يثنه أن لم يكن كفو له","ولا ناصر من جنسه في الرسالتي",30,"ت",2,0],["ولم يَثْنِهمْ عَن قَصْدِهم غَيْرُ نيْلِهِ","وكيْفَ.. وقد أَدُّوا له الفَرْصَ والنَّفْلا!",31,"ل",2,0]]}