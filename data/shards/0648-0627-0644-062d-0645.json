gate.com/ViewPoem.aspx?id=200221",""],[5573,"قال الذي يسرح معه فجة النور","https://www.poetsgate.com/ViewPoem.aspx?id=204541",""],[5582,"طَيْفٌ سَرَى وَثِيابُ اللَّيْلِ أَخْلاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=63545",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5739,"الغبي ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155468",""],[5804,"حلاوة الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=195259",""],[5845,"لكلِّ خطبٍ مهمٍّ حسبيَ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198425",""],[5926,"صوت المآذن","https://www.poetsgate.com/ViewPoem.aspx?id=213821",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[5956,"شكراً شربنا القهوة الغراءَ","https://www.poetsgate.com/ViewPoem.aspx?id=208050",""],[5961,"ماء الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=199791",""],[5961,"اضرب عن الناس","https://www.poetsgate.com/ViewPoem.aspx?id=199763",""],[5961,"وفد المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=199776",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[6008,"بمناسبة شفاء الملك عبدالله بن عبدالعزيز","https://www.poetsgate.com/ViewPoem.aspx?id=61399",""],[6070,"سُبْحانَ مَنْ جَمَعَ الضدّينِ في بَدَنِ","https://www.poetsgate.com/ViewPoem.aspx?id=189127",""],[6093,"أهلاً وسهلاً بمَنْ للحفِل قدْ زَانَا","https://www.poetsgate.com/ViewPoem.aspx?id=206221",""],[6115,"ماكل من ينتخي ويقال له ونعم","https://www.poetsgate.com/ViewPoem.aspx?id=180487",""],[2220,"إنَّ المقرَ من يستعبدْ الدولا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11722&r=&rc=592",""],[4222,"نصر أنار لملككم برهانه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52911&r=&rc=203",""]],"verses":[["والحَمْدُ لا يَجْتَنيهِ كُلُّ مُلْتَحِفٍ","باللُّؤمِ مِن صَفْقَةِ العَلياءِ مَغبونِ",0,"ن",1,0],["وَالْحَمْدُ للهِ خَتْماً بَعْدَ مُفْتَتَحِ","مَا الْبَارِقُ الْتَاحَ أَوْ مَا الْعَارِضُ انْسَكَبَا",1,"ب",2,0],["والحُمَاةُ الكُفَاةُ في الحَربِ ان","لَفَّ ضِرَاماً وَقُودُها بِضِرَام",2,"م",1,0],["والحمد والأجر من بضائعهِ","فكم له كسبة على كسبه",3,"ب",2,0],["والحمدُ للّه الذي صَرف الردى","والحمد للّه الذي كشف الكُرَبْ",4,"ب",1,0],["والحمد للّه العظيم شأنُهُ","على الذي أبلَى وأَوْلى وَوَهَبْ",5,"ب",1,0],["والحمد للَّهِ أعلاني وشرفني","حتى تعاليتُ أن تُسدَى إليَّ يدُ",6,"د",1,0],["والحمد للَّه شكراً لا شريك لهُ","على الأمور التي يجري بها القدر",7,"ر",1,0],["والحمد لله لا شريك له","من لَم يَقُلها فنفسه ظلما",8,"م",2,0],["وَالحَمدُ لا يُشتَرى إِلّا لَهُ ثَمَنٌ","مِمّا تَضِنُّ بِهِ النُفوسُ مَعلومُ",9,"م",1,0],["وَالحَمدُ لا يَكتَسيهِ غَيرُ فَتىً","يَنزِعُ فيهِ الخَطيرَ مِن سَلَبِه",10,"ب",2,0],["وَالحَمدُ أَنفَسُ ما تَعَوَّضُهُ اِمرُؤٌ","رُزِئَ التِلادَ إِذا المُرَزَّأُ عُوِّضا",11,"ض",2,0],["والحمْدُ حَلْيُ بن حَمدانَ تَعرِفُهُ","والحقُّ أبلَجُ لا يُلقى بإنكارِ",12,"ر",1,0],["وَالحَمدُ مِن أَربَحِ كَسبِ الفَتى","وَالشُكرُ لِلمَعروفِ نِعمَ الجَزا",13,"ا",1,0],["وَالحَمدُ لِلَّهِ حَمداً دائِماً أَبَداً","فازَ الَّذينَ إِلى ما عِندَهُ سَبَقوا",14,"ق",3,0],["وَالحَمدُ لِلَّهِ شُكراً لا نَفادَ لَهُ","الناسُ في غَفلَةٍ عَمّا لَهُ خُلِقوا",14,"ق",3,0],["وَالحَمدُ لِلَّهِ الَّذي لِجَلالِهِ","وَلِحِلمِهِ تَتَصاغَرُ الأَحلامُ",15,"م",1,0],["وَالحَمدُ لِلَّهِ الَّذي هُوَ لَم يَزَل","لا تَستَقِلُّ بِعِلمِهِ الأَوهامُ",15,"م",1,0],["والحَمدُ في الأَقوامِ غَيرُ مُسَلّمٍ","إلّا لأحمدَ ذي العُلى والجُودِ",16,"د",1,0],["وَالحَمدُ شَهدٌ لا تَرى مُشتارَهُ","يَجنيهِ إِلّا مِن نَقيعِ الحَنظَلِ",17,"ل",1,0],["وَالحَمدُ بُردُ جَمالٍ اِختالَت بِهِ","غُرَرُ الفَعالِ وَلَيسَ بُردَ لِباسِ",18,"س",1,0],["والحمدُ للهِ وصلَّى ربِّي","على النبيِّ وآلِهِ والصَّحبِ",19,"ب",1,0],["وَالحُمرُ يَرمي بِها المَوجُ الخِضَمُّ كَما","تَختالُ في زَهَراتِ الوَردِ كُثبانُ",20,"ن",1,0],["وأَلْحَمَ مِن أَفْرَاخِهَا فَهيَ طَوْعُهُ","لَدَى كُلِّ حَرْب والمُلُوك تُطَاعُ",21,"ع",1,0],["والْحَمَامُ في","أَيْكِهِ صَدَحْ",22,"ح",1,0],["وَالحِمَامُ المُصَيَّرُ فِي الكَوْنِ","مَنْ يَعْلَمُ سِرَّ البَقَاءِ غَيْرَ البَاقِي",23,"ق",2,0],["والحمدُ للهِ ختْماً بعد مُفْتَتَحِ","ما البارِقُ التاج أو ما العارِضُ انْسَكَبا",24,"ب",2,0],["والحَمْدُ أنْفَسُ ما تَعَوّضَهُ امرُؤٌ","رُزِىءَ التِّلادَ، إذا المُرَزّأُ عُوِّضَا",25,"ض",2,0],["والحمق في سد باب الانتقاد بما","للنفس من عنفوان في دعاويها",26,"ي",3,0],["والحمد لله فكم خائن","قابلته بالعفو والصفح",27,"ح",1,0],["والحمد للَه لم أحقد على أحد","والعفو طبعي وذا من جودة لنسب",28,"ب",1,0],["والحمد للَه وصلى اللَه","على نبينا ومن والاه",29,"ه",1,0],["والحمر مصغية تصيخ","لأَنه الناي الحزينة",30,"ن",2,0],["والحمدُ لله الذي خَصَّنَا","بالعزِّ والنعمَى وبالعافِيَهْ",31,"ي",2,0],["والحمدُ للَّه نحن السالمِونَ ولا","يَسُوءُنَا حالُ قومٍ إن هُمُ كَفرُوا",32,"ر",3,0],["والحمد لله قد رُدّوا يغيظهمو","فلم ينالوا وقد باءوا بخذلانِ",33,"ن",1,0],["والحمد لله قد قرّت نواظرنا","وأقبلت نحونا الدنيا تهنّينا",34,"ن",2,0],["وَالحَمدُ عَنكَ مُقَصِّرٌ مَعَ أَنَّني","لَم أُبقِ في قَوسِ المَحامِدِ مَنزِعا",35,"ع",2,0],["والحمدُ لله الذي أرْخَى لَنَا","ظَهْرَ الزَّمَانِ مَطِيَّةَ الإحْسانِ",36,"ن",1,0],["والحمد لله الذي يجرى القضا","بعبده يحيى بما أحبا",37,"ب",2,0],["والحمدُ لله قرّت أعين شحنت","وقرَّ كلُ فؤادٍ يشتكي الوَجلا",38,"ل",2,0],["والحمد لله لي في أَحمدٍ أملٌ","يجدُّ لي كلَّ يوم نحوه طمعا",39,"ع",2,0],["والحمد لله رضاً بما قضا","ما أحد يأخذ ما لا يكتب",40,"ب",1,0],["والحمد لله أهنى الفتح رجعتهم","قبل القتال وعود الجمع مهسوفا",41,"ف",2,0],["والحمد لله الجواب هكذا","وربنا أعلمنا بصحته",42,"ت",2,0],["والحمد لله لقد أرضيته","بحفظ دينه ونعم المسلك",43,"ك",1,0],["وَالحَمدُ خَيرُ ما اِتَّخَذتَ عدَّةً","وَأَنفَسُ الأَذخارِ مِن بَعدِ التُقى",44,"ا",1,0],["وَالحَمدُ لِلّهِ ما أَنفكَّت مَباءَتُهم","تَزدادُ مَجداً وَتَعزيزاً بِراقيها",45,"ي",3,0],["والحمد والشكر مقرونان فيك بما","أَوليت في الناسِ من جودٍ ومن كَرم",46,"م",1,0],["وَالحَمدُ لِلَّهِ الكَريمِ الرازِقِ ال","خَلّاقِ مُتقنِ صَنعَةِ الإِنسانِ",47,"ن",1,0],["وَالحَمدُ لِلَّهِ العَظيمِ شِعارُهُم","في البُؤسِ وَالأَفراحِ وَالأَحزانِ",47,"ن",1,0],["وَالحَمدُ أَبقى ما اِدَّخَرتَ وَكُلُّ مُذ","خورٍ سَريعٌ في يَدَيكَ نَفادُهُ",48,"د",2,0],["والحمد لله على الدوامِ","في مبدأ القول وفي الختام",49,"م",1,0],["وَالحَمد للَهَ حمدا لا اِنقصاء له","وَحَسبي اللَه اذ لا رب إِلّا هو",50,"ا",3,0],["وَالْحَمْدُ أَنْفَسُ مَذْخُورٍ تَفَوزُ بِهِ","فَخُذْ بِحظِّكَ مِنْ عُونِي وَأَبْكارِي",51,"ر",2,0],["والحَمد للَه على","إِبلاغه المؤمَّلا",52,"ل",2,0],["والحمدُ لله أَني قد مسحتُ يدي","مِن كلِّ ما لفَّقوا بَغْياً وَما وَضعوا",53,"ع",3,0],["والحمد لله شكراً","على نعم منه تتري",54,"ي",1,0],["والحمد للَه الكريم ختامها","وقد انتهت فاقبل إلهي وانفع",55,"ع",1,0],["والحمد للَه رب العالمين على","إنعامه وتعالى اللَه خير ولي",56,"ل",2,0],["والحمد للَه لا يبقى سواه ولا","يرجى سواه عليه الكل متكل",57,"ل",1,0],["والحمد للَه لست أشكو","إلى سواه شأني وشيني",58,"ن",2,0],["والحمد لله على ما أرى","وانقطع الخطب وزال المرا",59,"ر",2,0],["وَالحَمدُ لِلَهِ أَنَّ الدَهرَ جَرَّدَني","مِن كُلِّ خِلٍّ يُوافيني وَأوفيهِ",60,"ي",2,0],["وَالحَمدُ لِلَهِ مَولانا العَزيزُ لَهُ","حُسنَ اِختِيارٍ بِهِ ما خابَ إيعازُ",61,"ز",1,0],["وَالحُمرُ تَطرُدُها رُبعٌ مُحَنَّبَةٌ","تَفوتُ أَرجُلَها أَيدٍ لَها خُنُفُ",62,"ف",1,0],["والحمد للَه لما أوتينا","حمداً يدوم دائماً آمينا",63,"ن",2,0],["والحمدلله رب العالمين على","نعما كبيره كثيره لست أحصيها",64,"ي",3,0],["والحمدلله لا نحصى","ثناه بالحد والحسبان",65,"ن",1,0],["والحمدلله على ما أثاب","من فضله والإمتنان",66,"ن",1,0],["والحمد للغافر الرازق القاهر","من يرزق السائر والقاعد المحروم",67,"م",1,0],["والحمدلله ختامه","أعني كلامي والنظام",68,"م",1,0],["والحمدلله على","أفضاله عد النقط",69,"ط",1,0],["والحمق كل الحمق كل الحمق","من يرحم خيرا ويغدو وفي بطر",70,"ر",1,0],["والحمدلله خالقنا","في الأصائل وفي الأبكار",71,"ر",1,0],["والحمدلله حمدا ليس له من أخير","ندخل به جنة المأوى ما له شبيه أو نظير",72,"ر",1,0],["والحمدلله عد الحوت ذي في البحور","وعد طش السحايب والشجر والبذور",73,"ر",1,0],["والحمدلله ما","نودى إلى الصلوات",74,"ت",1,0],["والحمدلله رب العالمين على","جميع إنعامه الماضي وما يأتي",75,"ت",2,0],["والحمد للواحد الرحمن","عد الحجارة والترب",76,"ر",2,0],["وَالحَمدُ لِلَّهِ اِذ كانَ المَشيبُ عَلى","دينِ التَشيُّعِ لا دينٍ يُنافيهِ",77,"ي",2,0],["وَالحَمدُ لِلَّهِ عَلى أَنَّني","مِمَّن والي وَله المِنَّه",78,"ن",2,0],["وَالحَمدُ لِلَّهِ في الأَحوالِ أَجمَعِها","حَمداً بهِ شَملُ ما نَرجوهُ يَجتَمِعُ",79,"ع",1,0],["والحميا راق عند الأدبا","فله مقدار",80,"ر",1,0],["والحمد لله إذ فاتك يومئذ","بشارة تُعْلِنُ الأفراح إعلانا",81,"ن",2,0],["والحمد لله شكراناً لنعمته","أقْضي به من حقوق الشكر ما وجبا",82,"ب",2,0],["والحمدُ حظّ حُوَّلٍ","من الرجال قُلَّبِ",83,"ب",1,0],["والحمدُ لِلَّه على ما قَضى","فهذه حِكمته في الأَنام",84,"م",1,0],["والحمدُ والشكرُ مخلوعٌ عِذارُهُما","فيكُمْ وقلبُ العُلا صَبٌّ بكم كَلِفُ",85,"ف",1,0],["والحمد أنفس حلات الرجال فلا","تلبس سواها من الحلات حلات",86,"ت",1,0],["والحمد للّه من أبقى سعيد لنا","من بعد وقع الرماح الخط والقصل",87,"ل",1,0],["والحمد أفضل من مال سمحت به","هيهات ما لاحمد والأموال أشباها",88,"ا",3,0],["والحماة الأبطال من طردوا الهكسوس","أضحى لهم فتوحا ونصرا",89,"ر",2,0],["وألحمتُها شعواءَ يرفُلُ نقعُها","على العلَق المحمرِّ في الأزُرِ الدُّكْنِ",90,"ن",1,0],["والحمدُ للهِ ما لي","ذَنْبٌ بلِ الحُبُّ ذَنْبي",91,"ب",2,0],["والحمد أدنى خدمة مفروضة","لأجل من يثنى عليه ويحمد",92,"د",1,0],["وَالحَمْدُ والشُّكْرُ أَضْعَافاً مُضَاعَفَةً","لِما تَقَدَّمَ تَعْظِيماً وتَجْليلا",93,"ل",2,0],["وَالحمدُ لا يَستطيع يأخذهُ","مِنْ راحتيَّ النّاكلُ الوَغْدَ",94,"د",1,0],["وَالحمدُ للَّه قَد نلتَ المَرادَ وما ال","سَعيدُ إلّا الّذي نالَ الإراداتِ",95,"ت",1,0],["والحمى طلقٌ وأصحاب الحمى","لم يزالوا فيه والقوم هم",96,"م",1,0],["والحمدُ للهِ شكوَى الجسمِ هيِّنهٌ","ما دامَ يَسلَمُ منَّا العقلُ والرَّشدُ",97,"د",1,0],["والحمدُ للهِ لم تَقصُرْ بواكرُهُ","في ما يقوُمُ ولم تُحصرْ مساعيها",98,"ي",3,0],["والحمد لله الذي قد انتجب","محمدا من خلقه لما انتخب",99,"ب",1,0],["وَألحَمتِ الجَوَى أعضاءَ صَبِّ","يُنافِسُ كُلَّ عِضوٍ مِنهُ عِضوُ",100,"و",1,0],["والحمدُ للهِ الذي","نلنا بنعمتهِ الوَطَر",101,"ر",1,0],["والحمدُ للّه ختاماً وابتدا","وأوَّلاً وآخراً وأبدا",102,"د",2,0],["والحمد لله إله الخلقِ","على الهدايةِ لدينِ الحقِّ",103,"ق",1,0],["والحمد للّه في باقي أرومتِه","من ليس يعمل الا مثل ما عملا",104,"ل",2,0],["والحمد لله يوم جينا صوبه","لي 