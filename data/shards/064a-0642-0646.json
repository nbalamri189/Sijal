{"poems":[[53,"أفي هوى يوسف ألام","https://www.aldiwan.net/poem66363.html","مخلع البسيط"],[48,"أف لما نحن فيه من عنت","https://www.aldiwan.net/poem22856.html","المنسرح"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29336","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[147,"هل للخليط المستقل إياب","https://www.aldiwan.net/poem11723.html","الكامل"],[362,"يا أهل تدمير إن جاركم","https://www.aldiwan.net/poem4169.html","المنسرح"],[369,"دام علاء العماد","https://www.aldiwan.net/poem60952.html","مجزوء السريع"],[449,"عجبا حللوا عذاب النفوس","https://www.aldiwan.net/poem56028.html","عموديه"],[463,"بلوت هذا الدهر أطواره","https://www.aldiwan.net/poem56171.html","السريع"],[505,"هل بان نعمان وهذا الأجرع","https://www.aldiwan.net/poem37974.html","الرجز"],[520,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122670","المنسرح"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93105","الطويل"],[1683,"","https://poetry.dctabudhabi.ae/diwan/poem/123962","الرمل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52077","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216573","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136456",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83198","الرجز"],[4750,"ياسيدي خالد الفيصل","https://www.poetsgate.com/ViewPoem.aspx?id=180430",""],[2052,"ملك كما حدثت عنه رأيته","https://www.poetsgate.com/ViewPoem.aspx?id=189613",""],[5461,"رد على قصيدة من محمد بن راشد","https://www.poetsgate.com/ViewPoem.aspx?id=5069",""],[5776,"الهُبوبُ الثّاني","https://www.poetsgate.com/ViewPoem.aspx?id=199446",""],[5950,"حكاوي","https://www.poetsgate.com/ViewPoem.aspx?id=126265",""],[147,"هَلْ لِلْخَلِيطِ الْمُسْتِقلِّ إِيَابُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27447&r=&rc=14",""]],"verses":[["يُقنِعُني منه حين ينْأى","في عيشتي زَوْرةٌ لمام",0,"م",1,0],["يُقنِعُني بُلسُنٌ يُمارَسُ لي","فَإِن أَتَتني حَلاوَةٌ فَبَلَس",1,"س",1,0],["يقنسه ماء اليرنا تحته","شكير كأطراف الثغامة ناصل",2,"ل",1,0],["يَقْنِصُ الآبِداتِ عَزَّتْ عَلىَ الصيَّدِ","فماسَتْ بَيْنَ الرُّبا والرِّعانِ",3,"ن",1,0],["يُقني وَيُفني وَعدُهُ وَوَعيدُهُ","هَذا جَنىً عَذبٌ وَذاكَ عَذابُ",4,"ب",1,0],["يُقنِعُنِي منهُ أن أرَاهُ وَأَن","أمشِي إِذَا مَا مَشَى عَلَى أثَرِه",5,"ر",2,0],["يَقْنِصُه بالنّدى","والحَمْدُ وحْشٌ يُصاد",6,"د",1,0],["يقنع الهائم المتيم بالوع","د وان شيب بالمطال الرسيس",7,"س",1,0],["يُقنِعها الإنصاف لو أُنصفَتْ","وتطلبُ المالَ وإكثارَه",8,"ر",2,0],["يقنَعُ قومٌ بشُهودِ حُسنِهِمْ","وإنَّني بوصْلِهِمْ لا أَقنَعُ",9,"ع",1,0],["يقني طوال القنا العسال أشجعهم","علماً بأن اقتراب الموت في القرب",10,"ب",1,0],["يَقنصُ أسدَ الوَغَى مُجاهَرَةً","تَحتَ ظِلالِ الرِّماحِ لا خُدَعا",11,"ع",2,0],["يقنعها بالسوط شمرٌ فان شكت","يؤنبها زجرٌ ويوسعها زجرا",12,"ر",2,0],["يقنص الأبطال ضرباً","في مضي ورجوع",13,"ع",1,0],["يَقْنَعُ المَحْرُومُ بِالدُّونِ كَمَا","يَقْنَعُ الأعْمَى بِأدْنَى الحَولِ",14,"ل",1,0],["يقنو نفائسه من لا يسوّمه","وقد يعزُّ على اللّآل قنيان",15,"ن",1,0],["يقنص الليث منه ثوراً وباقي","هِ فلولاً يفر في البريه",16,"ه",1,0],["يقنُص أُسد العَرين ظبيُكم","بسهم جفنٍ يصيب حيثُ رمى",17,"م",2,0],["يَقنَعُ بِالدَنِيَّه","مَن أَكثَرَ الأُمنيَّه",18,"ه",1,0],["يقنص لهابالمحازم والبواريدي","تنصاد مرّه وتسلم عشر مراتي",19,"ت",2,0],["يقني الخيول السابقات شوازبا","قبا يدخر السيوف ذكورا",20,"ر",2,0],["يقنب قنيب الذيب بالليل وان عوى","ترد النجوم اعواه من هول ماشاف",21,"ف",1,0],["يقنعّونَ الأفاعي","يجمّلونَ الغرابا",22,"ب",2,0],["يقنع القلّ من عزمه بروحه قليل","الحرار إتضايق من ردى حالها",23,"ل",3,0],["يقني وَيفني وعدهُ وَوعيدهُ","لهذا جنى ً عذبٌ وَذاكَ عذابُ",24,"ب",1,0]]}