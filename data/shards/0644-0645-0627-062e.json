abudhabi.ae/diwan/poem/83663","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72595","البسيط"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96076","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120556","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139789",""],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102019","البسيط"],[5038,"الجوى حرّاق","https://www.poetsgate.com/ViewPoem.aspx?id=190162",""],[5054,"فديتك","https://www.poetsgate.com/ViewPoem.aspx?id=214799",""],[585,"يا صارخاً أجفلت من صوته الأمم","https://www.poetsgate.com/ViewPoem.aspx?id=161844",""],[5080,"مدائن التمر","https://www.poetsgate.com/ViewPoem.aspx?id=184906",""],[3591,"يا حافظ الشعر ويا شاعراً","https://www.poetsgate.com/ViewPoem.aspx?id=149433",""],[5200,"أبصرته غدوة سطيحا","https://www.poetsgate.com/ViewPoem.aspx?id=200801",""],[5219,"سيد الثقلين","https://www.poetsgate.com/ViewPoem.aspx?id=194915",""],[5223,"صدت سعاد وما للحال تحويل","https://www.poetsgate.com/ViewPoem.aspx?id=187501",""],[5490,"من أين أبدأ..؟","https://www.poetsgate.com/ViewPoem.aspx?id=176329",""],[5587,"من أشواق","https://www.poetsgate.com/ViewPoem.aspx?id=196571",""],[5674,"أنت أميرتي ياشاعره","https://www.poetsgate.com/ViewPoem.aspx?id=200230",""],[5790,"سقاك يا دار هطال من الديم","https://www.poetsgate.com/ViewPoem.aspx?id=112138",""],[5956,"حُلُمُ أمِّ فقير ‏","https://www.poetsgate.com/ViewPoem.aspx?id=184622",""],[5956,"إني أمين مثل والدكم","https://www.poetsgate.com/ViewPoem.aspx?id=193690",""],[6045,"ذكرى الشموخ","https://www.poetsgate.com/ViewPoem.aspx?id=206788",""],[6078,"من دُرِّها المكنون","https://www.poetsgate.com/ViewPoem.aspx?id=202772",""],[6134,"يا ليت كل الناس مثلك يا فتى","https://www.poetsgate.com/ViewPoem.aspx?id=169562",""]],"verses":[["لَمَا خامَرَ السَّلْوانُ بعْدُ قُلوبَنا","ولا عرَفَتْ مِنّا الجُنوبَ المَضاجعُ",0,"ع",1,0],["لَم أَخَل أَنَّ ذاكَ يَردَعُ مِنهُ","دونَ ثَنيِ الزِمامِ تَحتَ الصَليفِ",1,"ف",1,0],["لَم أَخشَ مِن أَحَدٍ في الشِعرِ يَسبِقُني","إِلّا فَتىً ما لَهُ في السَبقِ إِلّاهُ",2,"ا",2,0],["لِمَ أَخَّرتَني وَقَدَّمتَ غَيري","أَنا حالٌ وَغَيرِيَ اِستِفهامُ",3,"م",1,1],["لما خرجت وكان الخرق متّسعاً","والناس ما بين ذي شك ومتَثق",4,"ق",1,0],["لَم أَخشَ عُلوِيَّةً يَمانِيَّةً","وَكَم قَطَعنا مِن عَرعَرٍ شُعَبا",5,"ب",2,0],["لَم أَخلُ فيما نابَني","مِن أَن أُعَزَّ وَأَن أُجَلّا",6,"ل",2,0],["لم أخف في عبلة السا","ق وفاها العنبريَّه",7,"ي",2,0],["لم أخفْ منك غلطةً حين عاتب","تُك تدعو العتابَ باسم الهجاءِ",8,"ا",2,0],["لم أخضب الشيب للغواني","أبغي به عندهم ودادا",9,"د",2,1],["لَما خِلتُ هذا الجَوْر للدهر يستوي","وعينُك تصفو لي ورأيُكَ يستوي",10,"ت",3,0],["لَم أَخشَ غَيرَ الحِسانِ ناظِرَةً","أَشَدُّ فِعلاً مِنَ الظُبى الحَدَقُ",11,"ق",1,0],["لَم أَخُن في الوَدادِ قَطُّ حَبيباً","فَيُنادى عَلَيَّ في الأَسواقِ",12,"ق",1,0],["لَمّا خَطَرتَ بِهِ اِلتَفّوا بِسَيِّدِهِم","كَالشُهبِ بِالبَدرِ أَو كَالجُندِ بِالعَلَمِ",13,"م",1,0],["لَمّا خَلَت مِن كِنزِ عِلمِكَ أَصبَحَت","مِن كُلِّ أَعلاقِ الكُنوزِ خَلاءَ",14,"ا",2,0],["لمّا خَطَوا عَافَي الرُّسومِ من ال","بيدِ أناخُوا الرَّكائبَ الرُّسُما",15,"م",2,0],["لمَّا خَلَوتُ بمن أهوى بها قَصُرَت","فكادَ يَسبُقُ منها فجرُها الشَّفَقا",16,"ق",2,0],["لَمَّا خطبتُ نَدى الحُسي","نِ أَمِنْتُ غائلةَ الخُطوبِ",17,"ب",1,0],["لم أخل إن سهرت عيناي أو رقدت","من ذكره السار أو من طيفه الساري",18,"ي",1,0],["لَم أَخشَ مِن بَعدِها ما كُنتُ أَحذَرُهُ","وَكَيفَ وَهيَ الَّتي تُنجي مِنَ الغُمَمِ",19,"م",1,0],["لمّا خَلَتْ مِنكَ المنابرُ بغْتةً","لم يَخْلُ مِن أَسَفٍ عَليكَ مكانُ",20,"ن",1,0],["لمَا خُلقتْ كفّاكَ إلّا لأَربعٍ","عَقائلَ لم يُخْلقْ لهنَّ يَدانِ",21,"ن",1,0],["لَم أَخشَ وأنتَ ساكِنٌ أَحشائي","إِن أَصبَحَ عَنِّي كُلُّ خِلٍّ نَائي",22,"ي",1,1],["لم أَخلُ من حَسَدٍ عليك فلا تُضِعْ","سَهَري بتَشْنِيع الخَيالِ المُرجِفِ",23,"ف",1,0],["لَمّا خَبَت نيرانُها وَاِنكَفا ال","سامِرُ عَنها وَهوَ مَصدوعُ",24,"ع",1,0],["لما خاطبتُ وخاطَبَنِي","لم يخفَ عَلَيَّ تَعَبُّدهُ",25,"د",2,0],["لم أخن عهدهم فحبّي على ما","ألفوه وذمّتي وعهودي",26,"د",2,0],["لم أَخْلُ من وجْدٍ عليك، ورِقَّة ٍ","إذا حلَّ غِيدٌ، أَو ترحَّل غِيدُ",27,"د",1,0],["لَم أَخَل وَالآحادُ تَنفِرُ مِنّي","أَن تَصيرَ الآلافُ مِن أُلّافي",28,"ف",2,0],["لمّا خَطَتْ قِدِّيسَتي في دارَتي","سَلبتْ فؤادي صادرَتْ مِنّي البَصَرْ",29,"ر",1,0],["لِم أخَّرَ الكاتبُ الإنجازَ في عِدَتي","وكيف لا يجعل التأخير تقديما",30,"م",2,0],["لم أَخْشَ قطُّ حُلولَ حادِثةٍ","والليثُ لا يَخْشَى من النَّعَم",31,"م",1,0],["لمّا خيّل الأكدار عدت","قلبي فأثرن به نقعا",32,"ع",2,1],["لما خلّد الإحسانَ والحسنَ شاعرٌ","بأبياتِ شعر كالجمان المُنظّم",33,"م",1,0],["لمّا خَلَّيْتُ ما أدعو إليه","وَلو إدراكُهُ أَمسى عسيرا",34,"ر",2,0],["لم أخنه بالغيب بل خنت نفسي","وهدمت البناء قبل التمام",35,"م",1,0],["لَم أَخَف حَيَّةً عَلى الخَدِّ تَسعى","لا وَلا عَقرَباً عَلَيهِ يَدِبُّ",36,"ب",1,0],["لم أُخفه ضنّاً به وصيانةً","عمن يريد العلم في طي العمل",37,"ل",1,0],["لَم أَخَف إِلّا للعلو وَإِنَّما","تخطي السُهى لِعُلوِّهِ الأَبصارُ",38,"ر",1,0],["لم أخلَعِ الدِّرعَ إِلّا حِينَ شَقَّقَهُ","عن صفحِ صَدريَ مَا تَحوي مدارِعُهُ",39,"ع",2,0],["لم أخشهم من حيث لم أرجُهُمُ","إنك ما لم ترجُ شيئاً لم تخَفْ",40,"ف",1,0],["لما خلا الربعُ مِمَّنْ كان يسكنُه","أمرُّ ما كانَ منه بالدُّنُوِّ حَلا",41,"ل",2,0],["لم أَخشَ بعد شُهودي حسنَ طلعَتِهِ","تلوينَ حالي بمعْزولٍ ومنصوبِ",42,"ب",1,0],["لم أختصر شرح المديح وإنما","نفد الكلام وفضلكم لا ينفد",43,"د",1,0],["لم أخصص بها فلاناً فإني","في زمان ما في بنيه فلان",44,"ن",1,0],["لمّا خبرتُك لم أجدْ","شيئاً أكون به ضَنينا",45,"ن",2,0],["لَما خُنتُ عَهداً مِن إِخاءٍ وَلا نَأى","بِذِكرِكَ نَأيٌ عَن ضَميري وَلا شِغلُ",46,"ل",1,0],["لَم أَخُنها فَتَطلُبَ الوِترَ مِنّي","عِندَ ذي الذَحلِ تُطلَبُ الأَوتارُ",47,"ر",1,0],["لَمّا خلعناهُ جاء الليلُ مرتجفاً","مُلَفّعاً بالأسى يبكي ويَنتحِبُ",48,"ب",1,0],["لما خطبت وصاله","وسألته أن يعدلا",49,"ل",2,0],["لما خطفت ورقاء بالشدو سمعها","ولا الرعد أشجاها ولا البرق يسطع",50,"ع",1,0],["لم أخشَ سطوته وفض","ل الشيخ عيسى يوجدُ",51,"د",1,0],["لم أخش في سفري طروق مشقة","وتوجهي حمد بن عبد الله",52,"ه",1,0],["لَم أَخَف في حُبِّهِ مِن باسِهِ","وَبِرَغمِ الكُلِّ مِن حُرَّاسِهِ",53,"ه",1,0],["لَمّا خَشِيتَ بَغيَ أهلِ الحَشدِ","وَكِدتَ كُلَّ حَاسِدٍ صِلَّخدِ",54,"د",1,0],["لم أخشَ ربوات الشعوب وإن أحا","طت بي ولا المتوازرين إذا اجتروا",55,"ر",3,0],["لم أَخَلْكَ الدَّهْرَ تَلقا","ني بشَيْءٍ لا يَليقُ",56,"ق",1,0],["لما خطبتم قريضي جاءكم عجلاً","لكنه جاء للتقصير خجلانا",57,"ن",2,1],["لم أخَلْ قبل ربعِه أنّ ربعاً","فيه بدرٌ زاهٍ وبحرٌ مُحيطُ",58,"ط",1,0],["لم أخل قبل أن أراك دفيناً","أن ملحودةً تواري ثبيرا",59,"ر",2,0],["لم أخل ينعى لساني جعفراً","وبودِّي قبل ذا لو قطعا",60,"ع",2,0],["لم أخلني كذا أكون صبوراً","وفؤادي بسهمه قد تفرَّى",61,"ر",2,0],["لمّا خلعتَ رِدا الونى","ولبستَ للإقدام بُردا",62,"د",2,0],["لم أخل من حسد عليك فلا تضع","شغفي وفرط توجعي وتلهفي",63,"ف",2,0],["لم أخف عند ضمها حية الفر","ع وشهد الرضاب من درياقي",64,"ق",2,0],["لما خبا نور النفوس أعدته","بجلوسك المأنوس كالنبراس",65,"س",1,0],["لَمْ أخْشَ بَيْنَهُمُ حَتَّى غَدَوْا حِزَقاً","واسْتَوْسَقَتْ بِهِمُ البُزْلُ العَنَاجِيجُ",66,"ج",1,0],["لما خرجت قبضوا على يدي","بغاية الازعاج والتشدد",67,"د",1,0],["لما خَلَونا وقد رابَت ظاهِرُنا","وفي بواطِننا بُعدٌ عن التُّهَمِ",68,"م",1,0],["لما خضعتُ لحكم سلطانِ الهوى","سلمتُ للصبر الجميلِ قيادي",69,"د",2,0],["لم اخش من ظمإ الحوادث إذ عرت","ومعي نظير الجدول الريان",70,"ن",1,0],["لم أَخَلْ قبله غَزَالاً من الآ","رام يُدْمي حَشَاشَةَ الهِرْمَاسِ",71,"س",1,0],["لم أخلها أي ومن أرسلها","غير رسل للقضاء المنزل",72,"ل",1,0],["لما خصصت الأكثرين ولم أقل","عم الوجودَ مظاهر أكبابا",73,"ب",2,0],["لم أخن مرةً ولم أُلفَ يوماً","غافلَ القلبِ فاتر العزمات",74,"ت",1,0],["لمّا خلا الدستُ منه هَرَّ نابحُها","فاليوم يبصر طرق الحق عاويها",75,"ي",3,0],["لما خططت مثاله في ناظري","مدّ الحجاب عليه من عبراته",76,"ت",2,0],["لم أخش حيّ الواديين بمعرك","لو كان سرب ظبائه أعواني",77,"ن",2,0],["لما خبا ذاك اللهيب ترقرقت","في الأرض من ذاك اللهيب إضاء",78,"ا",2,0],["لم أخل قبل أن توارى سناه","إن للشمس في التراب مغيبا",79,"ب",2,0],["لم أخل من عاذر يأبي الملام ولا","من عاذل معتر باللوم معترض",80,"ض",1,0],["لم أخادعك أنت لا تخدعيني","انظريني صريح شِعْرٍ وشعر",81,"ر",1,0],["لم أخش في الدهرِ سوى هجركُم","وليسَ شيئاً غيره أخشى",82,"ش",2,0],["لم أخش وأنت ساكن إنساني","يا من بجماله الورى أنساني",83,"ي",1,1],["لم أخش إلا أن يعاتب والعتاب","من الحبيب يعيب في إخلاصي",84,"ص",2,0],["لَمّا خَشيتُ كَبَّةَ التَنكيسِ","وَقَحّمَ السَير بِمَرمَريسِ",85,"س",1,1],["لَمْ أخشَ نائبةَ الزمانِ وفيصلٌ","بيد الزمانِ عَلَى النوائب يَضْرِب",86,"ب",1,0],["لَم أَخلُ مِن لَومٍ وَلم أَنَلِ المُنى","لك يا إِلهي في قَضائِكَ لي حِكَم",87,"م",1,0],["لَم اِخشَ من عذلي لِلسَّمعِ مُستَرِقاً","حَتّى غَد شَملُنا بِالبَينِ مُفتَرِقاً",88,"ق",2,0],["لَم اِخشَ في حُبٍّ لهُ","من فَرطِ عَذلٍ اِم عنا",89,"ا",1,0],["لم اخل انني بخطب اروع","فدهاني خطب الزكي فروع",90,"ع",1,1],["لما خطر السلوان عنك بخاطري","وحاشا بأن تطوى عليه جوانحي",91,"ح",2,0],["لم أَخَل انها من العُمرِ مرَّت","بل لَقد خِلتُ انها العُمرُ جمعا",92,"ع",2,0],["لما خلونا وَطابَ اللقا","وَالقربُ عَنا أَبان النَوى",93,"و",2,1],["لما خشيت من النسي","م جعلت من فكري رسولْ",94,"ل",1,1],["لَما خَلونا لا تَسل","عَما جَرى حالاً وَقال",95,"ل",1,0],["لم أُخفِ سرًّا إلا علمتَ به","كأنني بالكلام مُبديه",96,"ي",2,0],["لم أخف بعدها ولم أمض يوما","كمحب مستشرفا مغناها",97,"ا",3,0],["لَمَّا خَلَونَا وَمَا مُدَّت إِلَيهِ يَدِي","تَعَفُّفاً نَامَ نَوماً غَيرَ مَقصُودِ",98,"د",1,1],["لم أخترع فيك المديح وإنما","من بحرك الفياض هذا اللؤلؤ",99,"ا",1,0],["لَمّا خَرَجنَ مِنَ الرُصا","فَةِ كَالتَماثيلِ الحِسانِ",100,"ن",1,1],["لَم أَخل أَن داعي الحُب يَضني","وَلَقَد كُنتَ في الحَوادِثِ جَلِدا",101,"د",2,0],["لم أخل يا أخي أن قريضي","لا وعينيك في مراثيك ينشى",102,"ش",2,0],["لَم أَخلُ مِنَ التَغابُنِ اليَومَ وَقَد","غالَيتُ بِهِ وَباعَني بِالرُخصِ",103,"ص",1,0],["لم أخلُ من خبث دهر","إلا وقد جاء أخبث",104,"ث",1,0],["لما خطرت بقد كالقنا خطرت","ذكراك في قلب صب ليس ينساك",105,"ك",1,0],["لم أخن عبهده وخان عهودي","يا لقومي لغائلي يا لقومي",106,"م",2,0],["لَم أَخل قَبلها السَلامَة حقّاً","لا وَلا الأَمر يَنقَضي بِسَلامِ",107,"م",1,0],["لم أخش من وقعها ضيرا ولا ضررا","إذا تصورت من أصداغه حلقا",108,"ق",2,0],["لما خطبتُ إلى خليعةَ نفسها","قالت خليعة ما أرى لك ما لا",109,"ل",2,1],["لم اخل من حاسد عند الوصال وان","نات فاني لفرط الوجد معذول",110,"ل",1,0],["لم أخشَ من ظمأ الصيا","م وفيض جدواك الزلالُ",111,"ل",1,0],["لم أخش يا صاح من كرب الزمان ولي","خل لدى الكرب فرداً لا يخليني",112,"ن",2,0],["(( لم أخف ما صنعت بي الأشواق ))","فالْقَلْبُ مُضْنى والْجَوى حُرّاقُ",113,"ق",1,1],["لما خلتني في الحب أسبحُ في الجَوى","وأمسح بالكفينِ أخدُود دَمعتي",114,"ت",2,0],["لم أخش من جاهلٍ يبدي نواجذه","غيظاً وإن كلمته تلكم الكلم",115,"م",1,0],["لم اخطئ المنح للخاطين.فلسفتي","هي التفاني بمنحِ العمرِ مخضرا",116,"ر",2,0],["لم أخل في باريس من حافظ","يزورني بشعره الزائر",117,"ر",1,0],["لما خاننيه قا","م وقد حركا مشيحا",118,"ح",2,0],["لما خبت نار المجوس فجاءة","فزعوا كذا الإيوان نحو ركام",119,"م",1,0],["لم أخش في حبها عذلاً لذي عذل","ولا لواش وفيها القلب مكبول",120,"ل",1,0],["لمّا خطرتَ انثالَ نورٌ","ولقد نطقتَ فقلتَ حَقا",121,"ق",2,0],["لَمْ أُخْفِ مَا صَنَعَتْ بِيَ الأَشْوَاقُ","أَخْفَيْتُهَا فَأَذَاعَهَا الإِطْلَاقُ",122,"ق",1,1],["لما خفقتِ على الضلوع حمامةً","تتلو أناشيد الخلود الساحره",123,"ر",2,0],["لما خلونا تعاقدنا يدا بيد","على الرضا وتعاهدنا فما بفم",124,"م",1,0],["لم أخن عهدا وبالذات لمن","حلمتْ فيمن له يجثو القمرْ؟",125,"ر",1,0],["لم أخلفِ الميعاد طول معيشتي","فاسأل جميع الخلق هل أحدٌ شَكَا؟",126,"ك",2,0],["لم أخشَ من دركِ الحياةِ لأنها","خَلَقتْ طريقاً للنجاحِ ممهدا",127,"د",2,0],["لم أخلعِ الصبرَ ما أنزلتُ أشرعتي","فالنبكُ فاتنةٌ نبضي لها ارتحلا",128,"ل",2,0],["لما خلقت الدهر قال مبشراً","هذا فريد العصر كلل بالظفر",129,"ر",1,0]]}