{"poems":[[77,"سقى دارهم هام من السحب هامع","https://www.aldiwan.net/poem35996.html","الطويل"],[9,"أذن اليوم جيرتي بحفوف","https://www.aldiwan.net/poem21953.html","الخفيف"],[86,"يا ليلة ألهمتني ما أتيه به","https://www.aldiwan.net/poem68834.html","البسيط"],[71,"لم أخرتني وقدمت غيري","https://www.aldiwan.net/poem3932.html","الخفيف"],[88,"نجيت بالسد بغدادا من الغرق","https://www.aldiwan.net/poem44443.html","البسيط"],[4,"طافت أسيماء بالرحال فقد","https://www.aldiwan.net/poem21147.html","المنسرح"],[47,"قف في رسوم المستجا","https://www.aldiwan.net/poem25172.html","مجزوء الكامل"],[72,"لا وخمر بابليه","https://www.aldiwan.net/poem20560.html","مجزوء الرمل"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"لم أخضب الشيب للغواني","https://www.aldiwan.net/poem61979.html","مخلع البسيط"],[51,"أيلتمس الناس الغنى فيصيبهم","https://www.aldiwan.net/poem66703.html","الطويل"],[91,"أمست ثيابي وكلها خرق","https://www.aldiwan.net/poem8984.html","عموديه"],[70,"رفعت رايتي على العشاق","https://www.aldiwan.net/poem42791.html","الخفيف"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[85,"اجعل رثاءك للرجال جزاء","https://www.aldiwan.net/poem62936.html","الكامل"],[61,"أفي دمى أبكت العيون دما","https://www.aldiwan.net/poem51428.html","المنسرح"],[61,"يا ليلة جمعتنا بعد مفترق","https://www.aldiwan.net/poem51524.html","البسيط"],[61,"فلقد حدا برق الغليل","https://www.aldiwan.net/poem51762.html","مجزوء الكامل"],[66,"لا أوحش الله ممن لا أفارقه","https://www.aldiwan.net/poem38450.html","البسيط"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[105,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[76,"أما والذي سوى السماء مكانها","https://www.aldiwan.net/poem38874.html","الطويل"],[68,"لم أخش وأنت ساكن أحشائي","https://www.aldiwan.net/poem1483.html",""],[68,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12745","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[94,"دمعة على الشاعر عبد الحميد الرافعي","https://www.poetsgate.com/ViewPoem.aspx?id=13792",""],[85,"يمدُّ الدُّجى في لوعتي ويزيدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9543&r=&rc=33",""],[144,"قد كفى الله وهو نعم الكافي","https://www.aldiwan.net/poem11780.html","الخفيف"],[179,"اني اتيتك لاجئا","https://www.aldiwan.net/poem50715.html","الكامل"],[205,"يوم أتى بنسيم الريح موسوما","https://www.aldiwan.net/poem53186.html","البسيط"],[230,"هممي أنافت بي على الهمم","https://www.aldiwan.net/poem50827.html","أحذ الكامل"],[260,"لما خيل الأكدار عدت","https://www.aldiwan.net/poem35549.html","المتدارك"],[271,"أحن إلى طيب الغدائر والفم","https://www.aldiwan.net/poem35634.html","الطويل"],[299,"أَسيغوا البث واحتبسوا الزفيرا","https://www.aldiwan.net/poem36267.html","عموديه"],[329,"أمل لا يزال فوق المرام","https://www.aldiwan.net/poem54962.html","الخفيف"],[367,"حيث ماء الشباب في وجنتيها","https://www.aldiwan.net/poem16937.html","الخفيف"],[378,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[407,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[440,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[459,"لو شاء سار ليلة النعف وقف","https://www.aldiwan.net/poem56113.html","الرجز"],[478,"لما استحث حداة الجيرة الابلا","https://www.aldiwan.net/poem15257.html","البسيط"],[501,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[516,"أسماء ملك تحتها لك مقعد","https://www.aldiwan.net/poem12059.html","الكامل"],[516,"أيها الناس والخطاب إلى من","https://www.aldiwan.net/poem12291.html","الخفيف"],[552,"يا من قرنت به على","https://www.aldiwan.net/poem47171.html","مجزوء الكامل"],[554,"وإني وإسماعيل يوم وداعه","https://www.aldiwan.net/poem68272.html","الطويل"]],"verses":[["لَمَا خامَرَ السَّلْوانُ بعْدُ قُلوبَنا","ولا عرَفَتْ مِنّا الجُنوبَ المَضاجعُ",0,"ع",1,0],["لَم أَخَل أَنَّ ذاكَ يَردَعُ مِنهُ","دونَ ثَنيِ الزِمامِ تَحتَ الصَليفِ",1,"ف",1,0],["لَم أَخشَ مِن أَحَدٍ في الشِعرِ يَسبِقُني","إِلّا فَتىً ما لَهُ في السَبقِ إِلّاهُ",2,"ا",2,0],["لِمَ أَخَّرتَني وَقَدَّمتَ غَيري","أَنا حالٌ وَغَيرِيَ اِستِفهامُ",3,"م",1,1],["لما خرجت وكان الخرق متّسعاً","والناس ما بين ذي شك ومتَثق",4,"ق",1,0],["لَم أَخشَ عُلوِيَّةً يَمانِيَّةً","وَكَم قَطَعنا مِن عَرعَرٍ شُعَبا",5,"ب",2,0],["لَم أَخلُ فيما نابَني","مِن أَن أُعَزَّ وَأَن أُجَلّا",6,"ل",2,0],["لم أخف في عبلة السا","ق وفاها العنبريَّه",7,"ي",2,0],["لم أخفْ منك غلطةً حين عاتب","تُك تدعو العتابَ باسم الهجاءِ",8,"ا",2,0],["لم أخضب الشيب للغواني","أبغي به عندهم ودادا",9,"د",2,1],["لَما خِلتُ هذا الجَوْر للدهر يستوي","وعينُك تصفو لي ورأيُكَ يستوي",10,"ت",3,0],["لَم أَخشَ غَيرَ الحِسانِ ناظِرَةً","أَشَدُّ فِعلاً مِنَ الظُبى الحَدَقُ",11,"ق",1,0],["لَم أَخُن في الوَدادِ قَطُّ حَبيباً","فَيُنادى عَلَيَّ في الأَسواقِ",12,"ق",1,0],["لَمّا خَطَرتَ بِهِ اِلتَفّوا بِسَيِّدِهِم","كَالشُهبِ بِالبَدرِ أَو كَالجُندِ بِالعَلَمِ",13,"م",1,0],["لَمّا خَلَت مِن كِنزِ عِلمِكَ أَصبَحَت","مِن كُلِّ أَعلاقِ الكُنوزِ خَلاءَ",14,"ا",2,0],["لمّا خَطَوا عَافَي الرُّسومِ من ال","بيدِ أناخُوا الرَّكائبَ الرُّسُما",15,"م",2,0],["لمَّا خَلَوتُ بمن أهوى بها قَصُرَت","فكادَ يَسبُقُ منها فجرُها الشَّفَقا",16,"ق",2,0],["لَمَّا خطبتُ نَدى الحُسي","نِ أَمِنْتُ غائلةَ الخُطوبِ",17,"ب",1,0],["لم أخل إن سهرت عيناي أو رقدت","من ذكره السار أو من طيفه الساري",18,"ي",1,0],["لَم أَخشَ مِن بَعدِها ما كُنتُ أَحذَرُهُ","وَكَيفَ وَهيَ الَّتي تُنجي مِنَ الغُمَمِ",19,"م",1,0],["لمّا خَلَتْ مِنكَ المنابرُ بغْتةً","لم يَخْلُ مِن أَسَفٍ عَليكَ مكانُ",20,"ن",1,0],["لمَا خُلقتْ كفّاكَ إلّا لأَربعٍ","عَقائلَ لم يُخْلقْ لهنَّ يَدانِ",21,"ن",1,0],["لَم أَخشَ وأنتَ ساكِنٌ أَحشائي","إِن أَصبَحَ عَنِّي كُلُّ خِلٍّ نَائي",22,"ي",1,1],["لم أَخلُ من حَسَدٍ عليك فلا تُضِعْ","سَهَري بتَشْنِيع الخَيالِ المُرجِفِ",23,"ف",1,0],["لَمّا خَبَت نيرانُها وَاِنكَفا ال","سامِرُ عَنها وَهوَ مَصدوعُ",24,"ع",1,0],["لما خاطبتُ وخاطَبَنِي","لم يخفَ عَلَيَّ تَعَبُّدهُ",25,"د",2,0],["لم أخن عهدهم فحبّي على ما","ألفوه وذمّتي وعهودي",26,"د",2,0],["لم أَخْلُ من وجْدٍ عليك، ورِقَّة ٍ","إذا حلَّ غِيدٌ، أَو ترحَّل غِيدُ",27,"د",1,0],["لَم أَخَل وَالآحادُ تَنفِرُ مِنّي","أَن تَصيرَ الآلافُ مِن أُلّافي",28,"ف",2,0],["لمّا خَطَتْ قِدِّيسَتي في دارَتي","سَلبتْ فؤادي صادرَتْ مِنّي البَصَرْ",29,"ر",1,0],["لِم أخَّرَ الكاتبُ الإنجازَ في عِدَتي","وكيف لا يجعل التأخير تقديما",30,"م",2,0],["لم أَخْشَ قطُّ حُلولَ حادِثةٍ","والليثُ لا يَخْشَى من النَّعَم",31,"م",1,0],["لمّا خيّل الأكدار عدت","قلبي فأثرن به نقعا",32,"ع",2,1],["لما خلّد الإحسانَ والحسنَ شاعرٌ","بأبياتِ شعر كالجمان المُنظّم",33,"م",1,0],["لمّا خَلَّيْتُ ما أدعو إليه","وَلو إدراكُهُ أَمسى عسيرا",34,"ر",2,0],["لم أخنه بالغيب بل خنت نفسي","وهدمت البناء قبل التمام",35,"م",1,0],["لَم أَخَف حَيَّةً عَلى الخَدِّ تَسعى","لا وَلا عَقرَباً عَلَيهِ يَدِبُّ",36,"ب",1,0],["لم أُخفه ضنّاً به وصيانةً","عمن يريد العلم في طي العمل",37,"ل",1,0],["لَم أَخَف إِلّا للعلو وَإِنَّما","تخطي السُهى لِعُلوِّهِ الأَبصارُ",38,"ر",1,0],["لم أخلَعِ الدِّرعَ إِلّا حِينَ شَقَّقَهُ","عن صفحِ صَدريَ مَا تَحوي مدارِعُهُ",39,"ع",2,0],["لم أخشهم من حيث لم أرجُهُمُ","إنك ما لم ترجُ شيئاً لم تخَفْ",40,"ف",1,0],["لما خلا الربعُ مِمَّنْ كان يسكنُه","أمرُّ ما كانَ منه بالدُّنُوِّ حَلا",41,"ل",2,0],["لم أَخشَ بعد شُهودي حسنَ طلعَتِهِ","تلوينَ حالي بمعْزولٍ ومنصوبِ",42,"ب",1,0],["لم أختصر شرح المديح وإنما","نفد الكلام وفضلكم لا ينفد",43,"د",1,0],["لم أخصص بها فلاناً فإني","في زمان ما في بنيه فلان",44,"ن",1,0],["لمّا خبرتُك لم أجدْ","شيئاً أكون به ضَنينا",45,"ن",2,0],["لَما خُنتُ عَهداً مِن إِخاءٍ وَلا نَأى","بِذِكرِكَ نَأيٌ عَن ضَميري وَلا شِغلُ",46,"ل",1,0]]}