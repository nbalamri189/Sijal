{"poems":[[39,"نفى عن عينك الأرق الهجوعا","https://www.aldiwan.net/poem7654.html","الوافر"],[76,"ألا أفصح الطير حتى خطب","https://www.aldiwan.net/poem12838.html","المتقارب"],[48,"ثلاثة أيامٍ لأهلِ تنافرٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=18077",""],[211,"وكانت نهابا تلافيتها","https://www.aldiwan.net/poem27932.html","المتقارب"],[242,"يا أمنا ميمونه","https://www.aldiwan.net/poem19276.html","مجزوء الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123177","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94266","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94809","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94731","الوافر"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127931","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139629",""],[4767,"سيف الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215269",""],[5038,"فم الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=188382",""]],"verses":[["ألاَ اُفٍ لِدَهرٍ كُنتُ فِيهِ","هِدَانَاً طَائِعاً لَكُمُ مُطِيعَا",0,"ع",2,0],["أَلا أَفصَحَ الطَيرُ حَتّى خَطَب","وَخَفَّ لَهُ الغُصنُ حَتّى اِضطَرَب",1,"ب",1,1],["إلا افتكر الإنسانُ في أمر دينه","، بدا نبأٌ يُثني الحِجى وبه كبْت",2,"ت",1,0],["إِلّا أَفائِلَ أُعطيتُها","عَديدَ قَوائِمِها الأَربَعِ",3,"ع",1,0],["أَلاَ افْرُجِي شُجُونَهْ","وَأَصْلِحِي شُؤُونَهْ",4,"ن",2,0],["ألا افتتح حقق ووبّخ نبّه","تمَنّ واعرض حضّض استفهم به",5,"ه",1,0],["ألا أفّو عليهم ما معي شي","وأخيّ يا سبيل على يميني",6,"ن",2,0],["ألا أفضله والفضل قد سطعت","على أعاليه أنوار البَراهين",7,"ن",1,0],["ألا أفتنا فيه ياذا الحبر دمت لنا","لحلِّ ما جاءَ مجهولاً وما عَسُرا",8,"ر",2,0],["ألا افتي يا ظباءَ الرقمتينِ","لقد خاطبتُ قبلاً نور عيني",9,"ي",1,0],["ألا افعل ما تشا فينا ونحن","لما فوَّقت فينا من نبالك",10,"ك",1,0],["ألا افخر على مَن في البسيطة كلها","فما لك ما بين البرية جاحد",11,"د",1,0],["ألا افصَحي لِي الذي تُخفينَ مِن خجلٍ","فقد توالتْ مِن الإخفاءِ آلام",12,"م",1,0],["ألا أُفٍّ لكلِّ هوى الأماني","لِمَنْ أشكو أنا العبدُ المنيبُ",13,"ب",1,0]]}