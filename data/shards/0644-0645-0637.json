{"poems":[[242,"ما ينقضي لي منهما عجب","https://www.aldiwan.net/poem18057.html","السريع"],[242,"لمطة فيها ما تحب النفوس","https://www.aldiwan.net/poem19714.html","السريع"],[369,"نفسي فداؤك أيهذا الصاحب","https://www.aldiwan.net/poem60991.html","الكامل"],[422,"ألا هل للمتيم من مجير","https://www.aldiwan.net/poem54160.html","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62484","الطويل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123154","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96032","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137125",""],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22553","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18980","البسيط"],[242,"لمطلة فيها ما تحب النفوس","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563760",""]],"verses":[["لَمْطَةٌ فِيهَا التِّينُ والعِنَبُ","مَا يَنْقَضِي لِي مِنْهُمَا عَجَبُ",0,"ب",1,1],["لَمْطَةٌ فِيهَا مَا تُحِبُّ النُّفُوسْ","وَمَا يُرِيحُ الْقَلْبَ مِنْ كُلِّ بُوسْ",1,"س",1,1],["لمْ طالَ تقصيري فما عاتَبْتني","فأنا الغداةَ مُقصّرٌ ومُعاتِب",2,"ب",1,0],["لمطبوع على كرم السجايا","ومجبول على كرم وخِير",3,"ر",1,0],["لمطلَعها الوضّاحِ تعنو الخرائدُ","فلا عجب ان حسَّدتْها الحواسدُ",4,"د",1,1],["لمطلك يا قُلقاس كسري زائد","وما بشّرتني بالوفاء الأصابع",5,"ع",1,0],["لمطرحين بغير دفن بالعرى","تغدوا السيوف لحومهم والاعظما",6,"م",2,0],["لمطراننا المفضال قول كأنه","وقد ملأ الاسماع منا هو السحر",7,"ر",1,1],["لِمُطرِقينَ عَلى مَثنى أَيا مِنِهِم","راموا النُزولَ وَقَد غارَ الأَكاليلُ",8,"ل",1,0],["لِمَطلَعِ الشَمسِ عَن يُمنايَ إِن سَنَحَت","لو يَسرَتي لِدياجي الغَربِ إِن بَرَحَت",9,"ت",1,0],["لِمَطلَعِ الشَمسِ ماهَذا بِمُنحَدَرٍ","نَحوَ الرَبيعِ وَلا هَذا بِإِصعادِ",10,"د",1,0],["لِمُطِلَّةُ فيها ما تُحِبُّ النُفوسَ","وَما يُريحُ القَلبِ مِن كُلِّ بوسِ",11,"س",1,1]]}