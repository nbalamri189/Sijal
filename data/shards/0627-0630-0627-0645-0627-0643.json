","https://www.poetsgate.com/ViewPoem.aspx?id=200427",""],[5457,"جريح في الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=213313",""],[5508,"يخطّ الشوقُ شَخصَكَ في ضميري","https://www.poetsgate.com/ViewPoem.aspx?id=110829",""],[5587,"أتعبني الهروب","https://www.poetsgate.com/ViewPoem.aspx?id=196679",""],[5612,"أبي","https://www.poetsgate.com/ViewPoem.aspx?id=197097",""],[5616,"أغنيةُ صمودٍ للمخيَّمِ الفلسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=205219",""],[5688,"إذا ما القلبُ","https://www.poetsgate.com/ViewPoem.aspx?id=208900",""],[5873,"عيش الفخار","https://www.poetsgate.com/ViewPoem.aspx?id=215435",""],[5939,"شعورُ الحبِّ لا يكفي!","https://www.poetsgate.com/ViewPoem.aspx?id=178603",""],[5956,"رأيٌ في الصداقة *","https://www.poetsgate.com/ViewPoem.aspx?id=184175",""],[5988,"أتظعن والذي تهوى مقيم","https://www.poetsgate.com/ViewPoem.aspx?id=99721",""],[6023,"إذا ما كنت في قومٍ غريباً","https://www.poetsgate.com/ViewPoem.aspx?id=123854",""],[6070,"إذا ما كنْتَ تَرغبُ في أمانِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=190291",""],[6070,"إذا ما كنتَ تَرغَبُ في النَّجاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=191615",""],[6125,"وليس يَهمُّني في الناسِ شيءٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212866",""],[4222,"تُرى يجتمعُ الشّملُ","https://www.poetsgate.com/ViewPoem.aspx?id=71346",""],[6152,"بك أماني","https://www.poetsgate.com/ViewPoem.aspx?id=205853",""],[6290,"عَدِيمُ الجَمَالِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85511&r=&rc=29",""]],"verses":[["إِذا ما كُنتَ لي فَخراً","فَمَن هَذا أُفاخِرُه",0,"ر",2,0],["إِذا ما كانَ في بَغدا","دَ مَن تَهوى وَيَهواكا",1,"ك",2,0],["إِذا ما كُنتَ ذا فَضلٍ وَعِلمِ","بِما اِختَلَفَ الأَوائِلُ وَالأَواخِر",2,"ر",1,1],["إِذا ما كُنتَ ذا قَلبٍ قَنوعٍ","فَأَنتَ وَمالِكُ الدُنيا سَواءُ",3,"ا",2,0],["إِذَا مَا كَسَرْتَ اللَّحْظَ مِنْ تَحْتِ حَاجِبٍ","تَحَكَّمَ فِي الأَلْبَابِ كِسْرَى وَحَاجبْهْ",4,"ه",1,0],["إِذا ما كَسَتهُ أُمُّهُ مِن لِباسِها","أَتَت أُختُهُ فَاستَأصَلَت كُلَّ ما يُكسى",5,"س",2,0],["إِذا ما كِتابُ الوَجدِ أَشكَلَ سَطرُهُ","فَمِن زَفرَتي شَكلٌ وَمِن عَبرَتي نَقطُ",6,"ط",1,0],["إذَا مَا كَانَ مَعْرُوفٌ وَشُكْرٌ","مَبَادَلَةَ التَّصَافِي وَالْوِئَامِ",7,"م",1,0],["إِذا ماكانَ خالُكَ تَغلِبيّاً","فَبادِل إِن وَجَدتَ لَهُ بِدالا",8,"ل",2,0],["إِذا ما كانَ فَحلُكَ فَحلَ سَوءٍ","خَلَجتَ الفَحلَ أَو لُؤمَ الفَصيلُ",9,"ل",1,0],["إِذا ما كَسَرنا رُمحَ رايَةِ شاعِرٍ","يَجيشُ بِنا ما عِندَنا فَنُعاوِدُ",10,"د",1,0],["إذا ما كنت للرؤساء رأساً","فلا تنكر إذا حصل الصداع",11,"ع",1,0],["إذا ما كنتُ ذا عودٍ صليب","فيكفيني القليلُ من اللِّحاءِ",12,"ا",2,0],["إذا ما كساك اللَّه سربالَ صحةٍ","ولم تخلُ من قوتٍ يَحِلُّ ويَعذُبُ",13,"ب",1,1],["إذا ما كان لا يأساً مُبيناً","ولا نجحاً فإني باجتنابِهْ",14,"ب",2,0],["إذا ما كنت ذا سخطٍ كبيرٍ","فلا تسخط على رجل صغير",15,"ر",1,0],["إِذا ماكُنتَ أَنتَ وَأَنتَ روحي","تَرى تَلَفي فَغَيرُكَ لا يُلامُ",16,"م",1,0],["إِذا ما كَرَرتُ الطَرفَ نَحوَكِ رَدَّهُ","مِنَ البُعدِ فَيّاضٌ مِنَ الدَمعِ يَهمِلُ",17,"ل",1,0],["إِذا ما كِرامُ الناسِ ساموا بُمُلكِهِم","وَبِالفَضلِ وَالأَعراقِ عِندَ المَناسِبِ",18,"ب",1,0],["إِذا ما كُنتَ مُتَّخُذاً خَليلاً","فَخالِل مِثلَ حُسّانَ بنِ سَعدِ",19,"د",1,1],["إذا ما كنتَ أكرمَ مَنْ علَيْها","فكيفَ أقولُ تَفديكَ اللِّئامُ",20,"م",1,0],["إِذا ما كَبِرتَ وَبانَ الشَبابُ","فَلا خَيرَ في العَيشِ بَعدَ الكِبَر",21,"ر",1,0],["إِذا ما كُنتَ مُتَّخِذاً خَليلاً","فَمِثلَ الفَضلِ فَاِتَّخِذِ الخَليلا",22,"ل",2,1],["إذا ما كَسونا المدحَ أوصافَهُ ازدَهى","فَطيّبَ أفواه القوافي له ذكرُ",23,"ر",1,0],["إِذا ما كانَ جارُكَ مُصعَبِيّاً","فَلا ضَيراً تَخافُ وَلا اِفتِقارا",24,"ر",2,0],["إِذَا مَا كَتَمْتُ الْحُبَّ كَانَ شَرَارَةً","وَإِنْ بُحْتُ بِالْكِتْمَانِ كَانَ مَلامَا",25,"م",2,1],["إذا ما كميٌّ لم يجد طرقَ دِرعه","ولم يدر يومَ السيف أين الحمائل",26,"ل",1,0],["إِذا ما كُنتَ عِندَ قِيانِ موسى","فَعِندَ اللَهِ فَاِحتَسِبِ السُرورا",27,"ر",2,1],["إِذا ما كُنتَ بِالأَشيا","ءِ في الأَعرابِ مُعتَبَرا",28,"ر",2,0],["إذا ما كنتَ جارَ أبي حسينٍ","فبت ويداكَ في طرف السلاح",29,"ح",1,0],["إِذا ما كانَ إِثمِدُنا تُراباً","فَأَيُّ الناسِ يَرغَبُ في اِكتِحالِ",30,"ل",1,0],["إِذا ما كُنتَ لَحّاساً بَخيلاً","سَؤولاً لِلمُطاعِ وَذا عِقاصِ",31,"ص",1,0],["إِذا ما كانَ عِرضي عِندَ بَطني","فَأَينَ مِنَ اَن أُسَبَّ بِهِ مَناصي",31,"ص",2,0],["إِذا ما كاعِبٌ حَلَفَت يَميناً","عَلى حُبّى حَلَفتُ لَها يَمينا",32,"ن",2,0],["إذا ما كالئ الأضغان يوماً","رآه رعى به كلأً وبيلا",33,"ل",2,0],["إِذَا مَا كَانَ فِي كَلِمِي صِعَابٌ","فَلاَ تَأْخُذُ كَثِيري بِالأَقَلِّ",34,"ل",1,0],["إِذَا مَا كَانَ فِي مِصْرَ التَّلاَقِي","تَلاَقِي الشَّرْقِ مِنْ شَتَّى الجِهَاتِ",35,"ت",1,0],["إِذَا مَا كُنْتَ مُقْتَحِماً حَسُوداً","وَكُنْتَ تُحَاوِلُ الأَمْرَ الجّلِيلاَ",36,"ل",2,0],["إذا ما كَنَفْنا هَوْلَها جاءَ هَوْلُها","وَبِاللهِ نَدْرِي كَيْدَهُمْ ونَدافِعُ",37,"ع",1,1],["إذا ما كنت عن بلد سفيرًا","سهرتَ، وباتَ يَنعَمُ بالرقود",38,"د",1,0],["إذا ما كان عندي قوت يوم","طرحت الهم عني يا سعيد",39,"د",1,1],["إِذا ما كَرِهتَ الخَلَّةَ السوءَ لِاِمرِئٍ","فَلا تَغشَها وَاِخلِد سِواها بِمِخلَدِ",40,"د",1,0],["إِذا ما كَأسُنا دارَت","فَهَزَّت فَروَةَ الراسِ",41,"س",1,0],["إذا ما كفاك الله ما أنت متّقٍ","شفانيَ ممّا أتّقي وكفاني",42,"ن",2,0],["إذا ما كنت مصطنعا جميلا","فحاول من يروقك بالصنيع",43,"ع",1,1],["إِذا ما كانَ مِثْلُكَ لِي مُجِيراً","وَمِثْلُكَ لا يَجُودُ بِهِ الْوُجُودُ",44,"د",1,0],["إِذا ما كُنْتَ تاجَ عُلىً فَمَنْ ذا","يَكُونُ لَكَ الْجَبِينَ أَوِ الْحَجاجا",45,"ج",2,0],["إِذا ما كُنْتَ مِنْ عُشّاقِ حَمْدِي","أَدَلَّ وَزارَ مَجْدَكَ غَيْرَ غِبِّ",46,"ب",1,0],["إِذا ما كُنتَ أَعزَلَ كُنتَ شاكي ال","سِلاحِ يَهابُكَ الجَيشُ اللُهامُ",47,"م",1,0],["إذا ما كبا في (الدردنيل) إلى يدٍ","ففي الشامِ يكبو لليدين وَللفم",48,"م",1,0],["إذا ما كنت ملتمساً لرزق","ونيل القصد من عبدٍ وحر",49,"ر",1,1],["إِذا ما كَسَوتَ الوَفدَ لِلجودِ مَلبَساً","فَقَد لَبِسوهُ بِالبَشاشَةِ مُذهَبا",50,"ب",2,0],["إِذا ما كَفى المَرءُ الوَرى هَمَّ خَوفِهِم","كَفى اللَهُ ذاكَ المَرءَ ما يَتَخَوَّفُ",51,"ف",1,0],["إِذا ما كُنتُ ما أَخشى وَعيداً","فَما نَفعي مَقالي بِالوَعيدِ",52,"د",1,0],["إذا ما كان للأشعار بيت","يحج فشعرك البيت الحرام",53,"م",1,0],["إذا ما كنتُ جارَكَ ذَا اشتياقٍ","إليكَ فكيفَ بي بعدَ الفِراقِ",54,"ق",1,0],["إذا ما كتبتَ فإنَّ اليراع","بأَنْمُلِكَ السَّيفُ واللّهذم",55,"م",1,0],["إِذَا مَا كساها من دماءِ عُدَاتِهِ","سَلَبْنَ هواهُ الغيدَ والخُرَّدَ العِينا",56,"ن",2,0],["إذا ما كنت في قوم غنيّاً","حللت محل تيجان الرؤوس",57,"س",1,0],["إذا ما كنتم عقلا","فلا تستمطروا المقلا",58,"ل",2,0],["إذا ما كسوتُ العيدَ منهنَّ لِبْسةً","ترفَّلَ فيها تائهاً وتخَيَّلا",59,"ل",2,0],["إذا ما كررت الشعر من شعفٍ به","طفقن يُعالين الحنين المرَّجعا",60,"ع",2,0],["إِذا ما كانَ عِندي قوتُ يَومٍ","وَرُمتُ سِواهُ لَم يَكُ لي قَنوعُ",61,"ع",1,0],["إِذا ما كانَ في بَيتي رَغيفٌ","فَذاكَ اليَومُ عِندي يَومُ عُرسِ",62,"س",1,1],["إِذا ما كانَ عِشقُ فَتىً لِنَحسٍ","فَما عِشقي لَهُ إِلّا لِسَعدي",63,"د",2,0],["إذا ما كنتَ لي وَزَراً حصيناً","على نُوَبِ الزّمانِ فما أُبالي",64,"ل",2,0],["إذا ما كريمُ القومِ جارى فخارَه","أتى طَرَفاً فيه ووافاك واسطا",65,"ط",2,0],["إِذا ما كَتَبْنا مَدْحَه أَشْرَقَتْ بِه ال","صَّحائِفُ لاَ بَلْ كَادَ يَبْيَضُّ حِبْره",66,"ر",2,0],["إذا ما كنتَ طَالِبَ كُلِّ ذَنبٍ","ولم تُحلِل أخَاكَ من العِتَابِ",67,"ب",1,1],["إذا ما كثيب الرمل جاذب خصره","يذكرني معنى الغرير ونجده",68,"د",2,0],["إذا ما كان وَجْهُكَ نَصْبَ عيني","مَنَى نفسي فما أرجو بشمسِ",69,"س",1,0],["إذا ما كُنتَ ذا بولٍ صحيح","ألا فاضرِبْ بهِ وجهَ الطَّبيبِ",70,"ب",1,0],["إذا ما كان ممدوداً بقاءٌ","فليس لوصلة الجُلى ثباتُ",71,"ت",1,0],["إذا ما كلّمتُ فعلت","فكل كلامها جِدُّ",72,"د",1,0],["إذَا مّا كَلَّمَتْ عَيْنَاهُ قَلْبِي","فَلاَ تَسْألْ عَنِ الْقَلْبِ الْكَلِيمِ",73,"م",1,0],["إذا ما كان للدنيا طريق","وللأخرى إذا سلكت طروق",74,"ق",1,0],["إِذا ما كُنتَ جار بني خُريم","فَأَنتَ لأكرم الثِقلَينِ جار",75,"ر",1,0],["إذا ما كانَ وَصْلُكَ في فَنائي","فإِني لَسْتُ أَرْغَبُ في البَقَاءِ",76,"ا",2,1],["إِذا ما كُنتَ لا تَرعى حُقوقاً","لإِخوان هُمُ رفعوا منارَك",77,"ك",1,1],["إِذا ما كانَ في فَمِهِ كَنيفٌ","فَكَيفَ يَحلُّ ذِكرُ اللَهِ فيهِ",78,"ه",1,0],["إِذا ما كُنتُ مَكبولَ الخَطايا","وَعانِيَها فَمَن لِيَ بِالبَراحِ",79,"ح",1,0],["إذا ما كت