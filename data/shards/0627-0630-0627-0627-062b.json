{"poems":[[77,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[45,"رأى البرق مجتازا فبات بلا لب","https://www.aldiwan.net/poem10651.html","الطويل"],[28,"إذا أثفروا كل خفاقة","https://www.aldiwan.net/poem5045.html","المتقارب"],[28,"رأى عبد قيس خفقة شورت بها","https://www.aldiwan.net/poem5050.html","الطويل"],[80,"أعطيت حكمك في الأيام فاحتكم","https://www.aldiwan.net/poem31290.html","البسيط"],[21,"أأذكر حاجتي أم قد كفاني","https://www.aldiwan.net/poem36248.html","الوافر"],[46,"إذا أثنى علي المرء يوما","https://www.aldiwan.net/poem22272.html","الوافر"],[46,"يجل الملك عن نظم ونثر","https://www.aldiwan.net/poem22681.html","الوافر"],[28,"رأى عبد قيس خفقة شورت بها","https://www.poetsgate.com/ViewPoem.aspx?id=21583",""],[113,"إذا أثقلت ظهري ذنوبي وبات بي","https://www.aldiwan.net/poem41990.html","الطويل"],[209,"خلا جيبي ففارقني رفاقي","https://www.aldiwan.net/poem46253.html","الوافر"],[209,"فجعت بألطف العلماء روحا","https://www.aldiwan.net/poem46629.html","الوافر"],[278,"عتادك أن تشن بها مغارا","https://www.aldiwan.net/poem60790.html","الوافر"],[346,"أتعرف إخوة شهدوا حروبا","https://www.aldiwan.net/poem20401.html","الوافر"],[362,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[459,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[527,"إذا أثنى عليك فتى بما لا","https://www.aldiwan.net/poem37286.html","الوافر"]],"verses":[["إِذَا أَثُر الأَخْفَافِ لاَحَتْ مَحَارِباً","يَخِرُّ عَلَيْهَا رَاكِعاً وَيُنِيبُ",0,"ب",1,0],["إِذا أَثقَلَ الهِلباجُ أَحناءَ سَرجِهِ","غَدا طِرفُهُ يَختالُ بِالمُرهَفِ الضَربِ",1,"ب",1,0],["إِذا أَثفَروا كُلَّ خَفّاقَةٍ","وَرَدنَ بِهِم أَحَدَ الأَثمُدِ",2,"د",1,1],["إِذا أَثقَبوها بِالكُدادَةِ لَم تُضِئ","رَئيساً وَلا عِندَ المُنيخينَ مَرفَدا",3,"د",2,0],["إذا أثار عجاجَ الحرب ألحفها","ليلاً بهيماً بكرّ الخيل بالبُهَمِ",4,"م",1,0],["إِذا أَثنى عَلَيكَ المَرءُ يَوماً","كَفاهُ مِن تَعَرُّضِهِ الثَناءُ",5,"ا",2,0],["إِذا أَثنى عَليَّ المَرءُ يَوماً","بِخَيرٍ لَيسَ فِيَّ فَذاكَ هاجِ",6,"ج",1,1],["إِذا أَثريتَ مِن صَبرٍ جَميلٍ","فَأَنتَ وَإِن فَقَدتَ المالَ مُثرِ",7,"ر",1,0],["إذا أثْقَبُوهَا بِالكُدادَةِ لَمْ تُضيء","رَئيساً وَلا عِنْدَ المُنِيخِينَ مَرْفَدا",8,"د",2,0],["إذا أثقلت ظهري ذنوبي وبات بي","نزيل الخطايا في رحاب المصائب",9,"ب",1,1],["إذا اثريت كانوا كل يوم","ضيوفك والمكان لهم رحيب",10,"ب",1,0],["إذا أثمت فصارت دارتي سقرا","فسوف يحمل آثامي ويفديني",11,"ي",1,0],["إِذا أُثْنِي بِحَمْدِكَ قَالَ قَوْمٌ","بِحَقِّ الرَّوْضِ أَنْ حَمِدَ الْقُطارا",12,"ر",2,0],["إذا أَثْبتَهُمْ بالنَّقْلِ فيهِ","نَفَاهُمْ عنهُ مِن يَدِكَ القِياسُ",13,"س",1,0],["إذا أثَّفَتْ يوماً ثلاثَ أناملٍ","له قلَماً يَقْدِرْ أُموراً ويُنْضِج",14,"ج",1,0],["إذا اثعنجرتْ فيها الدماء حسبتها","دوارجَ سيلٍ أسلمتها المَسايلُ",15,"ل",1,0],["إذَا أَثْنَى عَلَيْكَ فَتىً بِما لا","تَكُونُ بِهِ حَقِيقاً في الْحَقِيقَهْ",16,"ه",1,1]]}