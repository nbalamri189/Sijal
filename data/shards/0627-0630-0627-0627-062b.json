{"poems":[[79,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[47,"رأى البرق مجتازا فبات بلا لب","https://www.aldiwan.net/poem10651.html","الطويل"],[30,"إذا أثفروا كل خفاقة","https://www.aldiwan.net/poem5045.html","المتقارب"],[30,"رأى عبد قيس خفقة شورت بها","https://www.aldiwan.net/poem5050.html","الطويل"],[82,"أعطيت حكمك في الأيام فاحتكم","https://www.aldiwan.net/poem31290.html","البسيط"],[21,"أأذكر حاجتي أم قد كفاني","https://www.aldiwan.net/poem36248.html","الوافر"],[48,"إذا أثنى علي المرء يوما","https://www.aldiwan.net/poem22272.html","الوافر"],[48,"يجل الملك عن نظم ونثر","https://www.aldiwan.net/poem22681.html","الوافر"],[30,"رأى عبد قيس خفقة شورت بها","https://www.poetsgate.com/ViewPoem.aspx?id=21583",""],[119,"إذا أثقلت ظهري ذنوبي وبات بي","https://www.aldiwan.net/poem41990.html","الطويل"],[215,"خلا جيبي ففارقني رفاقي","https://www.aldiwan.net/poem46253.html","الوافر"],[215,"فجعت بألطف العلماء روحا","https://www.aldiwan.net/poem46629.html","الوافر"],[285,"عتادك أن تشن بها مغارا","https://www.aldiwan.net/poem60790.html","الوافر"],[353,"أتعرف إخوة شهدوا حروبا","https://www.aldiwan.net/poem20401.html","الوافر"],[369,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[466,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[534,"إذا أثنى عليك فتى بما لا","https://www.aldiwan.net/poem37286.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122823","الوافر"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44980","الوافر"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75732","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49924","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95551","البسيط"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198646","البسيط"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100885","الوافر"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145538","الطويل"],[3487,"","https://poetry.dctabudhabi.ae/diwan/poem/111543","الوافر"],[3908,"","https://poetry.dctabudhabi.ae/diwan/poem/138045","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77126","الوافر"],[5443,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=185145",""],[285,"عَتادُكَ أنْ تشنَّ بها مغارا","https://www.poetsgate.com/ViewPoem.aspx?id=15447",""]],"verses":[["إِذَا أَثُر الأَخْفَافِ لاَحَتْ مَحَارِباً","يَخِرُّ عَلَيْهَا رَاكِعاً وَيُنِيبُ",0,"ب",1,0],["إِذا أَثقَلَ الهِلباجُ أَحناءَ سَرجِهِ","غَدا طِرفُهُ يَختالُ بِالمُرهَفِ الضَربِ",1,"ب",1,0],["إِذا أَثفَروا كُلَّ خَفّاقَةٍ","وَرَدنَ بِهِم أَحَدَ الأَثمُدِ",2,"د",1,1],["إِذا أَثقَبوها بِالكُدادَةِ لَم تُضِئ","رَئيساً وَلا عِندَ المُنيخينَ مَرفَدا",3,"د",2,0],["إذا أثار عجاجَ الحرب ألحفها","ليلاً بهيماً بكرّ الخيل بالبُهَمِ",4,"م",1,0],["إِذا أَثنى عَلَيكَ المَرءُ يَوماً","كَفاهُ مِن تَعَرُّضِهِ الثَناءُ",5,"ا",2,0],["إِذا أَثنى عَليَّ المَرءُ يَوماً","بِخَيرٍ لَيسَ فِيَّ فَذاكَ هاجِ",6,"ج",1,1],["إِذا أَثريتَ مِن صَبرٍ جَميلٍ","فَأَنتَ وَإِن فَقَدتَ المالَ مُثرِ",7,"ر",1,0],["إذا أثْقَبُوهَا بِالكُدادَةِ لَمْ تُضيء","رَئيساً وَلا عِنْدَ المُنِيخِينَ مَرْفَدا",8,"د",2,0],["إذا أثقلت ظهري ذنوبي وبات بي","نزيل الخطايا في رحاب المصائب",9,"ب",1,1],["إذا اثريت كانوا كل يوم","ضيوفك والمكان لهم رحيب",10,"ب",1,0],["إذا أثمت فصارت دارتي سقرا","فسوف يحمل آثامي ويفديني",11,"ي",1,0],["إِذا أُثْنِي بِحَمْدِكَ قَالَ قَوْمٌ","بِحَقِّ الرَّوْضِ أَنْ حَمِدَ الْقُطارا",12,"ر",2,0],["إذا أَثْبتَهُمْ بالنَّقْلِ فيهِ","نَفَاهُمْ عنهُ مِن يَدِكَ القِياسُ",13,"س",1,0],["إذا أثَّفَتْ يوماً ثلاثَ أناملٍ","له قلَماً يَقْدِرْ أُموراً ويُنْضِج",14,"ج",1,0],["إذا اثعنجرتْ فيها الدماء حسبتها","دوارجَ سيلٍ أسلمتها المَسايلُ",15,"ل",1,0],["إذَا أَثْنَى عَلَيْكَ فَتىً بِما لا","تَكُونُ بِهِ حَقِيقاً في الْحَقِيقَهْ",16,"ه",1,1],["إذا أَثرَى فَظَّلَ عَلَيهِ مالٌ","وَماطَلَني بِهِ أمسَى لَدَيا",17,"ي",2,0],["إِذا أَثرى رَأى حَقّاً عَلَيهِ","لَهُ الأَفضال مِن قَبلُ السُؤال",18,"ل",1,0],["إِذا اثقلت ظَهري عَطايا كَثيرَة","عَطايا عَلى باش فمن ثقلها أَرغو",19,"غ",2,0],["إذا أَثار غماماً نقعها مَطَرَت","دَمَ العدى بْينَ مَطْعونِ ومَضْروبِ",20,"ب",1,0],["إذا اثكلت من الأغصان غصن علىً","فأستودعيه رحاب الله ذى الرحمِ",21,"م",1,0],["إذا أثاروا القنا عن جُنْح مُظْلِمَةٍ","شالوا النجوم على أطرافها عذَبا",22,"ب",2,0],["اذا أثمَ الأريبُ فلا تلمه","فكم من أشيبٍ يفنٍ تَصابى",23,"ب",2,0],["إذا أثخنت في إثر راكبها انبرى","يجنبها وعرا ويركبها سهلا",24,"ل",2,0],["إذا أثماره جنيت","جنيت العلم والدبا",25,"ب",2,0],["إذا أثْبَتُوا فِي مَأْزِقِ الْحَربِ أرْجُلاً","فَمَوْعِدُهُمْ مِنْهُ إلى مُلْتَقىالْحَشْرِ",26,"ر",1,0],["إِذا أَثنى عَلَيكَ المَرءُ يَوماً","تُصَدِّقُهُ المُروءَةِ وَالسَخاء",27,"ا",2,0],["إذا أثقلَتْني بالجراحاتِ علَّتي","وجدتُّ ثراها للجراح مُداويا",28,"ي",2,0],["إذا أُثْني بحمدَ قالَ قومٌ","بِحَقِّ الرَّوْضِ أنْ حَمِدَ القِطارا",29,"ر",2,0]]}