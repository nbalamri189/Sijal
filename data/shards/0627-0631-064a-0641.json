,""],[4775,"ابتهالات حرف صامد","https://www.poetsgate.com/ViewPoem.aspx?id=175184",""],[4814,"سلامي إلى عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=192442",""],[4962,"سطور في حواء","https://www.poetsgate.com/ViewPoem.aspx?id=201627",""],[4978,"يافا","https://www.poetsgate.com/ViewPoem.aspx?id=177226",""],[5216,"حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=187651",""],[5277,"طائفُ الروح","https://www.poetsgate.com/ViewPoem.aspx?id=208587",""],[5281,"أصيل","https://www.poetsgate.com/ViewPoem.aspx?id=200083",""],[5376,"أنا إدلبُ","https://www.poetsgate.com/ViewPoem.aspx?id=206145",""],[5410,"مُباح اللهو في يدنا بناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=152242",""],[5457,"كرهت كتابةَ الأشعار","https://www.poetsgate.com/ViewPoem.aspx?id=213116",""],[5459,"قتيل الصدود","https://www.poetsgate.com/ViewPoem.aspx?id=204160",""],[5491,"خيالك","https://www.poetsgate.com/ViewPoem.aspx?id=215330",""],[5582,"لَئِنْ تُخْفِ ما بِكَ أَوْ تَصْبِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=187009",""],[5616,"الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=205217",""],[5660,"أَرى في عُيوني وُجوهاً كَثيرَه","https://www.poetsgate.com/ViewPoem.aspx?id=23973",""],[5691,"المربد","https://www.poetsgate.com/ViewPoem.aspx?id=206353",""],[5736,"تذروني الرياح","https://www.poetsgate.com/ViewPoem.aspx?id=214926",""],[5776,"انتحارُ عرّافة","https://www.poetsgate.com/ViewPoem.aspx?id=199330",""],[402,"سلام عليكم والفؤاد المسلم","https://www.poetsgate.com/ViewPoem.aspx?id=36305",""],[5790,"أرى في الصبا من نشر رياهم عرفا","https://www.poetsgate.com/ViewPoem.aspx?id=112080",""],[5839,"لكِ الله..","https://www.poetsgate.com/ViewPoem.aspx?id=62047",""],[6004,"يا عاذلي","https://www.poetsgate.com/ViewPoem.aspx?id=59103",""],[6093,"فَلْسَفَةُ المَوتِ","https://www.poetsgate.com/ViewPoem.aspx?id=179845",""],[6152,"مدينة الباحة","https://www.poetsgate.com/ViewPoem.aspx?id=205195",""],[6164,"أطوار..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66060&r=&rc=69",""],[6189,"أروى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83571&r=&rc=38",""],[6213,"زمان الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76263&r=&rc=20",""],[406,"إلى أين يا قومي ؟؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63654&r=&rc=84",""],[6257,"رحيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87183&r=&rc=8",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""],[5126,"بائِع المسَاويك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87809&r=&rc=24",""]],"verses":[["أَرى فِتنَةً قَد أَلهَتِ الناسَ عَنكُمُ","فَندَلاً زَريقَ المالِ نَدلَ الثَعالِبَ",0,"ب",1,1],["أَرى فَراعينَ مِصرٍ","في ذِلَّةٍ وَنُحوسِ",1,"س",1,0],["أَرَى فِيهِ آفَاتٍ لَنَا مِنْ ذُنُوبِهَا","نَصِيبٌ فَإِنْ نَعْرِفْهُ ذَلِكَ أَحْزَمُ",2,"م",1,0],["أَرى فيكِ مِن خَرقاءَ يا ظَبيَةَ اللِوى","مَشابِهِ جُنِّبَتِ اِعتِلاقَ الحَبائِلِ",3,"ل",1,0],["أرى فمها صيغ من حكمةٍ","وأبخسه أن أقل من ذهب",4,"ب",1,0],["أرى فحمة الظلماء عند أنينها","فأعجب منها كيف لم تتضرّم",5,"م",1,0],["أرى فضلَ مالِ المرءِ داء لعرضه","كما أن فضل الزادِ داءٌ لجسمِهِ",6,"م",2,0],["أرى في ابتغاءِ الشُّكر ممن أُنيلُهُ","متاجرةً والمنُّ أعتدُّه بغيا",7,"ي",2,0],["أَرى فُحشَ الكَلامِ يَروعُ قَلبي","وَلَيسَ تَروعُهُ البيضُ الحِدادُ",8,"د",1,1],["أَرى فيكَ يا عيسى الطَبيبَ فَضيلَةً","هِيَ الضِدَّ مِن أَفعالِ عيسى بنِ مَريَمِ",9,"م",1,1],["أرى في العبابِ كفاحَ الحياة","وتيارها الجارفَ الأحمقَا",10,"ق",2,0],["أرى في ابيضاضِ الرمالِ ال","مشيب والكفن الشاحب المقلقَا",10,"ق",2,0],["أرى في السرابِ غرورَ النفو","سِ والأملَ الخائبَ المخفقَا",10,"ق",2,0],["أرى في عمق خاطركَ","جلالاً يشبه البحرا",11,"ر",2,0],["أرى في العلمِ عنه ألفَ لاحٍ","يناديني بحيَّ على الفلاحِ",12,"ح",1,0],["أَرى فَساداً وَشَرّاً ضاعَ بَينَهُما","أَمرُ العِبادِ فَلا دينٌ وَلا خُلُقُ",13,"ق",1,1],["أَرى في مِصرَ شَعباً لَيسَ يَدري","أَفي سِلمٍ يُغامِرُ أَم قِتالِ",14,"ل",1,0],["أَرى فَلَكاً مازالَ بِالخَلقِ دائِراً","لَهُ خَبَرٌ عَنّا يُصانُ ويُخبَأُ",15,"ب",2,0],["أَرى فِراري مِنَ المِقدارِ سَيِّئَةً","لَو تَعلَمُ الخَيلُ عِلمي فيهِ لَم تُعَرِ",16,"ر",1,0],["أَرى فَلَكاً مادارَ إِلّا لِحِكمَةٍ","فَلا تَنسَ مَن أَجرى لِحاجَتِكَ الفُلكا",17,"ك",2,0],["أَرى فَتَيَي دُنياكَ إِن حَرِجَ الفَتى","فَما إِن هُما في مَأثَم حَرِجانِ",18,"ن",1,1],["أَرى فلقاً يَمحو الدجى ثم لا أَدري","أَمطلع فجر ذاكَ أَم مطلع الشعر",19,"ر",1,1],["أرى في حديثكِ معنى الرِّضا","وأسمعُ فيهِ هُتَافَ الحنانْ",20,"ن",1,0],["أرى فيكِ ما لا تحدُّ النّهى","كأنكِ معنىً وراء الخيالْ",20,"ل",1,0],["أرى فِتنةً حمْراءَ يَلْفُظُها الثرى","دُخاناً تُغَشِّي الكائناتِ سحائبُهْ",21,"ب",2,0],["أَرى فَيئَهُم في غَيرِهِم مُتَقَسَّماً","وَأَيدِيَهُم مِن فَيإِهِم صَفِراتِ",22,"ت",1,0],["أَرى فَيئَهُم في غَيرِهِم مُتَقَسَّما","وَأَيديهُم مِن فَيئِهِم صَفِراتِ",23,"ت",1,0],["أرى في مصرَ أبطالاً توليِّ","إذا قيل: ادفعوا ثمن البطولةْ",24,"ل",2,0],["أرى في سماءِ العُروبة برقًا","إذا صحَّ ظنِّي به، أمطرَا",25,"ر",2,0],["أرى فتنة يلفظها الثّرى","دخانا تغشّي الكائنات سحائبه",26,"ب",2,0],["أرى في أديم الطود عاث برأسه ال","خراب وواراه الضباب مثاليا",27,"ي",2,0],["أرى في النوم خيراً لي بيانا","معان ليس تحويها معاني",28,"ي",1,1],["ارى في ذلكَ الثغرِ","طِلاً وشفاهكِ الكاسُ",29,"س",1,1],["أَرى في مَنامي كُلَّ شَيءٍ يَسُرُّني","وَرُؤيايَ بَعدَ النَومِ أَدهى وَأَقبَحُ",30,"ح",1,1],["أَرى فيكَ عَلاماتٍ","وَلِلأَشياءِ تَأويلُ",31,"ل",1,0],["أرى فيكِ رمزَ الخيرِ والخَصبِ والغِنى","فدايمةٌ قد قيلَ بينَ الجماعة",32,"ه",1,0],["أرى في عَينِكِ النجلاء نفسي","ونورَ الحقِّ في عَيني ترينا",33,"ن",2,0],["أرى فيكِ من لبنانَ عزّاً وبهجَةً","وأنتِ لهُ بعضٌ وفي وجهكِ الكلُّ",34,"ل",1,0],["أَرى فِيكَ لِلآمالِ وَعْدَ مَخِيلَةٍ","وَما هِيَ إِلاّ مُقْبِبٌ سَوْفَ تُنْتَجُ",35,"ج",1,0],["أَرى فؤادي وإِن ضاقَت مسالكُه","بمدح نَجل رَسول اللَهِ جَذلانا",36,"ن",2,0],["أرى في الغربِ أقواماً تباروا","بما بَهَرَ النواظرَ والعقولا",37,"ل",2,0],["أرى فضل المشيب على شبابي","يخالف فيه بعض الأغبياء",38,"ا",2,1],["أَرى فَنَنَ الأَغصان كلَّلهُ الحَيا","إِذا مال مِن سكر السُرور لَها قدُّ",39,"د",1,0],["أَرى فِكرَتي في فُنونِ القَري","ضِ تَأَتي بِأَشباهِ دُرٍّ نَظيمِ",40,"م",1,1],["أرَى في عِراصِي راكِباً مُتَرنِّما","فَهل جَدَّدَت عَيناكَ بَعدي مُتَيَّما",41,"م",2,1],["أرى في لفظِ هذا الشَّهم معنًى","يُنبئُ عَن مدى عِلْمٍ عظيم",42,"م",1,1],["أرئِّفُ منها بالبكا باردَ الحشا","وأحوِي بعُوذاتِ الرُّقَى ماردَ الجنِّ",43,"ن",1,0],["ارى في ضَلالٍ الحبَّ وجدي بكم هدًى","وغيَّ الهوى العذريَّ في مثلكمْ رُشدا",44,"د",2,0],["أرى في وجهه ماءَ التّصافي","وفي أحشائه نار التّقالي",45,"ل",2,0],["أرَى فِتنَةَ الدُّنيا هي الآيةُ الكُبرَى","يَضِلُّ بها الهادي فيلهو عن الأُخرَى",46,"ر",2,1],["أرى في دبي نهضة ما عهدتها","أهل شيدت للعلم فيها معالم",47,"م",1,0],["أَرى في غَزالِ الدَوَ مِنهُ شَمائِلاً","فَأَهفو إِلَيهِ كُلَّما مَرَّ سانِحَهُ",48,"ح",2,1],["أرى فيه مثل مدارى الظباء","تظلّ لأطلائها حانيهْ",49,"ن",3,0],["أرى فيكَ مَعنى مِن سَميِّكَ يُوسُفٍ","بإلقائِهِ في جُبِّهِ وابتياعِه",50,"ع",2,0],["أَرى فلكاً في رَوضة النيل زادَها","بَهاء وَحلّى بِالعُقود جِيادها",51,"د",3,1],["أَرى في كِلا خَدَّيهِ وَاللّهِ حبّةً","فَفي الأَيمنِ السّودا وَفي الأَيسَرِ الخضِرا",52,"ر",2,1],["أَرى في النَومِ رُمحاً أَو سِنانا","فَأَسلَجُ في الفِراشِ عَلى مَكاني",53,"ن",2,1],["أرى فتن الدنيا كثيراً وشرُّها","بلاءُ النسا إذ كان من عهد أول",54,"ل",1,0],["أَرى فاجِراً يُعى جَليداً لظلمه","وَلَو كُلّف التَقوى لكلّت مَضاربه",55,"ب",2,0],["ارى في ديارات الأحبة أوجها","فأطلب إغضاء فيسبقني النظر",56,"ر",1,0],["أرى في وصل من أهوى سروري","وقربي منه فيه نعم حبوري",57,"ر",2,1],["أَرى في بني نبهان للمدح مَذهباً","تذال بُه الحُسنى ويكْتَسب الأْجرُ",58,"ر",1,0],["أرى في صدغك المعوج دالاً","براها اللَه قوساً للمهالكْ",59,"ك",1,1],["أرى فحلاً يقاس به حلامٌ","وكيف تقيس بالحل الحلاما",60,"م",2,0],["أرى فؤادي يحنُو","إلى سماع الأغاني",61,"ي",1,0],["أرى في شباب اليوم للعلم نهضة","تقول بأن العزم عن طوقه شبا",62,"ب",2,0],["أرى في التين عِلمَ الحقِّ حقاً","وعلمي أنه الحقُّ المبينُ",63,"ن",1,1],["أرى فتية عمياءَ جاءت لنصرتي","تقول لنا بالحال أنت المفاتن",64,"ن",1,0],["أرى فريقاً من ذوي العلم تَدا","عَوا لِلدّفاعِ عن حقوقِ المصطفى",65,"ا",1,0],["أرى فعله كالبحر يظهر سافلا","ويخفى مقام الحر فيه ويخمد",66,"د",1,0],["أرى في جمال الفكر أبهى المتاحف","أعيش به ما بين شتى الطرائف",67,"ف",1,1],["أرى في اقتناص السانحات خسارة","من النفس جُلى لا تعوّض بالصّيد",68,"د",1,1],["أرى في السينماء وجوه غيد","تفوق وجوه فِلْم السينماء",69,"ا",2,1],["أرى فيها أُصيحاباً كثاراً","فأحسبني أعيش بهم سعيدا",70,"د",2,0],["أرى فيك أخلاق المغنّى وطبعه","وأُبصر في العصفور اخلاق طائر",71,"ر",1,0],["أرى فيهما كوناً أرى الكون كله","فدعني أعش في الكون لا تغمض الطرفا",72,"ف",2,0],["أرى في غربة الانسان سجناً","فكيف بسجن انسانٍ غريب",73,"ب",1,1],["أرى في وحدتي زمر المعاني","تجئ إليّ كالألحان شتّى",74,"ت",2,1],["أرى في خواني نملة تطلب الغذا","فأتركها كالضيف تأكل ما تهوى",75,"ا",1,1],["أرى فيه أستاذي وأبدو كجده","فيملأ من أغلى اللئالئ لي أذني",76,"ن",2,0],["أرى في جميع الكون صورة ربه","فأبصرُ فيها جنةً ونعيما",77,"م",2,0],["أرى فقراءنا من كل علم","ومن دينٍ دواباً في ثياب",78,"ب",1,1],["أرى فتن الدنيا تزيد وأهلها","يخوضون بالأهواء في غمرة الجهل",79,"ل",1,1],["أرى فيه حيناً شكل عينٍ جميلةٍ","وألمس حيناً فيه تكويرة النهد",80,"د",1,0],["أرى فِرَقاً قد افترقت بمصر","ورامت عن أواصلها انفصالا",81,"ل",2,1],["ارى فوق تأنيب الغواذل رحمة","خليق بها دامي الجوانح مدنف",82,"ف",1,0],["أرى في السوى الوصف الجميل جمالةً","وفيك كأني قلت إنك تسمع",83,"ع",1,0],["أرى فيك نظمي مثل صاعقة السما","بها هام عذالي يروح مفدغا",84,"غ",2,0],["أَرَى في يد التِسماح عَظماً مجرَّداً","ومَدمَعُهُ يجري على ذلك العَظمِ",85,"م",1,1],["ارى فيك يا مرآة نفسي صورة","من الحد تهديني لمنبع سرائي",86,"ي",1,0],["أَرى فيها مِن الأَضدادِ","ما يَستَوقِفُ الفَهما",87,"م",2,0],["أَرى في عصرنا هذا علامهْ","تخبرنا بِأَشراط القيامهْ",88,"م",2,1],["أرى في البحر أجسامًا تشعُّ","عليها من حياء الحسن درعُ",89,"ع",1,1],["أرى في جلال الموت إن كان صادقًا","جلالة حق لا جلالة باطلِ",90,"ل",1,1],["أَرى فتكات الجهل دب دَبيبها","فمزق سَمعي من بِلادي نَحيبها",91,"ب",3,1],["أرى في النفس معنى أي معنى","وقد جل المقام عن المقال",92,"ل",1,0],["أَرَى في ابني مشابهَ من عليٍ","ومن يَحيى وذاكَ بهِ خَليقُ",93,"ق",1,1],["أرى فيكَ شيئاً لا تراه عيونُهم","وإلا لكفوْا 