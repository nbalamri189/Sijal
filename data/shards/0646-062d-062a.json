{"poems":[[95,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[53,"بت وبات الصبيان في أرق","https://www.aldiwan.net/poem65415.html","المنسرح"],[53,"يا من أغار عليه من غلائله","https://www.aldiwan.net/poem65939.html","البسيط"],[87,"غال في قيمة أبن بطرس غالى","https://www.aldiwan.net/poem7128.html","الخفيف"],[87,"قم ناد أنقرة وقل يهنيك","https://www.aldiwan.net/poem63757.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85343","المتدارك"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54826","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43848","البسيط"],[111,"بصائرنا في القضا خامدة","https://www.poetsgate.com/ViewPoem.aspx?id=522",""],[92,"النفثة!","https://www.poetsgate.com/ViewPoem.aspx?id=179076",""],[119,"أقول لمطرب يحدو الجمالا","https://www.aldiwan.net/poem40618.html","عموديه"],[147,"بقيت ولا عزت عليك المطالب","https://www.aldiwan.net/poem11719.html","الطويل"],[287,"لعن الله جرجس القنياطا","https://www.aldiwan.net/poem32717.html","الخفيف"],[361,"ألمت بنا أهلا وسهلا","https://www.aldiwan.net/poem24532.html","الطويل"],[454,"سلام على الماضي","https://www.aldiwan.net/poem1000.html",""],[484,"ما القبر إلا ترجمان الماثت","https://www.aldiwan.net/poem36941.html","الكامل"],[487,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[487,"أرقني سقم النوى","https://www.aldiwan.net/poem24549.html","عموديه"],[565,"أغنيات الفقد","https://www.aldiwan.net/poem67265.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83298","الكامل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103073","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145820","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62532","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80020","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141340","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27659","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132331","البسيط"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216551",""],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101248","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86459","الطويل"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131648",""],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136948",""],[4717,"هي القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=203988",""],[4778,"جرح العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=196616",""],[5010,"نحتُّ من الأعماق صِدْقَ مشاعِرِي","https://www.poetsgate.com/ViewPoem.aspx?id=189906",""],[5080,"مدائن التمر","https://www.poetsgate.com/ViewPoem.aspx?id=184906",""],[5092,"نحتاجُ لَمْسَ الورد","https://www.poetsgate.com/ViewPoem.aspx?id=213361",""],[5277,"حماماتُ العراق","https://www.poetsgate.com/ViewPoem.aspx?id=186063",""],[592,"شجتني وأبكتني خطوب فوادح","https://www.poetsgate.com/ViewPoem.aspx?id=128836",""],[5431,"كلّي دموعٌ والفرات صلاتي","https://www.poetsgate.com/ViewPoem.aspx?id=186984",""],[5431,"حتى نعود من الأجداث...يُحيينا","https://www.poetsgate.com/ViewPoem.aspx?id=187337",""],[5431,"كلّ إلى ثغر الردى يتدحرجُ","https://www.poetsgate.com/ViewPoem.aspx?id=189057",""],[5691,"أطبق الصمت...!","https://www.poetsgate.com/ViewPoem.aspx?id=206739",""],[5756,"اربع خناجر","https://www.poetsgate.com/ViewPoem.aspx?id=5190",""],[5758,"تراتيل الغيم","https://www.poetsgate.com/ViewPoem.aspx?id=207926",""],[5785,"هيّج الشوق قمري في الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=131569",""],[5823,"ياصديقي","https://www.poetsgate.com/ViewPoem.aspx?id=59800",""],[5829,"صدع الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=177716",""],[5937,"هاربٌ مِن سَدِّ مَأرِب","https://www.poetsgate.com/ViewPoem.aspx?id=211810",""],[5943,"بأي فجرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=41592",""],[5956,"الذكرى تنفعُ المؤمنين","https://www.poetsgate.com/ViewPoem.aspx?id=184490",""],[5957,"صباحك سُكْرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=53137",""],[6052,"نحتُّ الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=50324",""],[6056,"نار اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=130380",""],[6093,"إملاءُ الذِّكرياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=199527",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""]],"verses":[["نحت فدياس حير الناس حتى","لغدت تداعي الحاية الصخور",0,"ر",1,0],["نَحَتُّم بِالمَعَاوِل صَخرَتَينَا","فَأَبَّسَتَا أَكُفَّ النَّاحِتِينَا",1,"ن",2,0],["نحتال للنوم كي يواتيَنا","بكل شيء وليس ينفعنا",2,"ن",2,0],["نحتالُ فيه فينجو من حبائلنا","ونحن نَنْشَبُ تترى في حَبائلِهِ",3,"ل",2,0],["نحتفى بالأديب والحق يقضَى","وجلال الأخلاق والأعمال",4,"ل",1,0],["نَحَتَ الشُعوبُ مِنَ الجِبالِ دِيارَهُم","وَالقَومُ مِن أَخلاقِهِم نَحَتوكِ",5,"ك",1,0],["نحت الإنسان له صنماً","وَغَدا من جهل يعبده",6,"د",2,0],["نَحَتُوا الرَّاسِيَاتِ تَحْتَ صُخُورٍ","وَأَبَانُوا دَقَائِقَ الأَفْكَارِ",7,"ر",1,0],["نَحْتُ فِيدَاسَ حَيَّرَ النَّاسَ حَتَّى","لَغَدَتْ تَدَّعِي الْحَيَاةَ الصُّخُورُ",8,"ر",1,0],["نُحتُ مَعَ النائِحاتِ حَتّى","قيلَ اِستَوى الحَبرُ وَالغَواني",9,"ن",2,0],["نحت مستقر الندى والهدى","فدكتهما دكة واحده",10,"د",2,0],["نُحْتُ وغنَّيتُ ولا مِيزةٌ","قَبْلِيَ كم غنّى هزارٌ وناح",11,"ح",1,0],["نحت في الليالي كل فج","ولم ادأ من التفريق بالا",12,"ل",2,0],["نَحَتكَ القَوافي وَهيَ عونٌ عَوانِسٌ","وَها هِيَ أَبكارٌ لَدَيكَ كَواعِبُ",13,"ب",1,0],["نَحَتَتهُ الرِجالُ نَحتَ أَبيهِ","صَخرَةً وَهوَ كَالفَنيقِ نَشاطا",14,"ط",2,0],["نحت بإزا ذات التساقُط نحلاً","فلا جرس منهم حيث ناموا ولا جسما",15,"م",2,0],["نحتن بقلبي منظراً غاب في المدى","ولكنه عن ناظري ما تغيبا",16,"ب",2,0],["نحتوا القبور لمن قضى أيامه","فيهم فكانت واعظا للناحت",17,"ت",1,0],["نحتت أوزاري وتقضى مآربي","وتغفر حويتي وتقبل دعوتي",18,"ت",2,0],["نحت على ذاك الخيال","وبت أرعى ذا الجمال",19,"ل",1,0],["نَحَتْكِ عني المقاديرُ التي كُتِبَت","فحلّة الصبرِ – مهما جُدتُ – منخرِقة ْ",20,"ق",2,0],["نَحَتَ القوافي السائِرتُ أَوابِداً","ماذا يُفيدُ النَحتُ مِن أَثلاتِهِ",21,"ت",2,0],["نحت بالفكر معبوداً وقلت به","وصنت عقدا بكف الحق محلول",22,"ل",1,0],["نَحتَّنا قمِيصكَ منْ وَهْمنَا","عَليهِ دَمٌ كَذِبٌ منْ دِمَانَا",23,"ن",2,0],["نحتسي من ارؤس القوم الطلى","ونعد الضرب فينا ضربا",24,"ب",2,0],["نحت في رواق المجد صدراً من العُلى","يروع ملوكَ الأرض فيه مئولها",25,"ل",3,0],["نحتجّ جهرا على ما لا يوافقنا","بالقول والقول هذا ليس يجدينا",26,"ن",2,0],["نَحَتوا بباطنِ مَنفَ أقدسَ مَعبدٍ","جعلوه بَيتَ سرائرِ الأكوانِ",27,"ن",1,0],["نحَتُوا الجبالَ وشيَّدُوا من صَلدِها","فوق الهِضَابِ غرائبَ الأَوثانِ",27,"ن",1,0],["نحت نحوه سبحانه من وجودِنا","خواطر إيماء بتقويضِ بنيانِ",28,"ن",1,0],["نَحتُ الجِبَالِ إلى ذي اللُّبِّ أيسَرُ مِن","تَفهيمهِ للفتى ما ليسَ وارِدُه",29,"د",2,0],["نِحْتَجْ عَليك نْخوض الاخطار","فِيْ الحب وانْتَه وِشْ به تِحْتَج",30,"ج",1,0],["نحت حزناً وناح حزناً بنوحي","كل صب فيا حمام اسعديني",31,"ن",2,0],["نحت بيته العليا فقر قرارها","ولولاه فرت تألف الجولانا",32,"ن",2,0],["نحتاج نطرح ونتوالى على ملعب","ما بيننا احنا وصالح صاحب الكوله",33,"ل",2,0],["نحت مقعد العرسين تائهة الخطى","مقرَّحة الاجفان واجفة الرجل",34,"ل",1,0],["نَحَتَّ يا شعرُ شخْصًا كادَ يُشْبِهني","لولا انْتِظامٌ .. وبي كَمْ تكْثرُ العللُ",35,"ل",1,0],["نحتاج ألفا نبيٍ كي تُجمِّعنا","حيث الشقاقق غدا في شرعنا دينا",36,"ن",2,0],["نحتُّ من الأعماق صِدْقَ مشاعِرِي","تعطّرَ من حُلوِ البيانِ بهَا الشَّذَى",37,"ذ",2,1],["نحت وجهي على رملٍ وما ملكت","ذاتي سواهُ وضاعتْ دفةُ البشرى",38,"ر",2,0],["نحتاجُ لَمْسَ الوردِ قبل ذبولِنا","قد شَمَّ قسوتَنا الفراغُ فجُرِّحا",39,"ح",2,0],["نُحْتُنَّ من وجعِ النوى","والحزنُ فيكنَّ انطوى",40,"و",2,1],["نحتك من الأفلاج تختال في الحلا","تميس كغصن البان حين تمايح",41,"ح",1,0],["نحتاج أن نُسقى بجرعة صالح","هل من غيوم الخير والرحمات",42,"ت",1,0],["نحتاج قلبا لنور الله يُرشدنا","حتى نعود من الأجداث...يُحيينا",43,"ن",2,0],["نحتاجُ غسل قلوبنا بدموعنا","كي يستوي بالدمع من هو أعوجُ",44,"ج",1,0],["نحْتَسي أنْخابَ الهزائِم ِنخْباً","إثْرَ نخْبٍ مُسْتَمْرئينَ المِزاجا !",45,"ج",2,0],["نحتري فيه القا والحصيل هو الحصيل","مثل حلماً ماتحقق وعيت اقطعه",46,"ع",2,0],["نَحْتَاجُ دَمْعَ المُتْعَبِينَ لِيَعْبُرُوا","كُنْهَ الزَّمَّانِ أهلّةً وبدورَا",47,"ر",2,0],["نحت لمّا شكا وجده وناح","وأنا منه بالشكوى أحق",48,"ق",1,0],["نحتمي بالآمال ثم ترانا","كلَّ يوم وروحُنا في اندفاعِ",49,"ع",1,0],["نحتنا في جدار الشمس صدعا","وعرش الشمس اوار جموح",50,"ح",1,0],["نحتاجُ نوحَ الحُب ، كي نحتمي","من غيظ هذي الموجةِ المُشرِفَةْ",51,"ف",2,0],["نحتاجُ نهر الحب ، لكنه","يحتاجُنا غرقى لكي نرشُفَهْ",51,"ف",2,0],["نحتاجُ للنورِ ، للآمالِ طاهرةً","تصوِّبُ الفكرَ إنقاذا من القلقِ",52,"ق",1,0],["نحتاج يوميّاً لتربية الورَى","مثلَ احتياج البيت للتنظيفِ",53,"ف",1,1],["نحت هواكَ بعمقِ الفؤاد","وفي ناظريَّ ودمي وأكثرْ!",54,"ر",1,0],["نحتُّ الصمت في جرحي كلاما","فما احد ٌ وعى كانوا نياما",55,"م",2,1],["نحّت من الصخر بيت ٍ أنافس به ثمود وعاد","وبنيت أهرام ٍ تنافس بناء فرعون وهاماني",56,"ن",2,0],["نَحَتُّك نَحْتَ مَثَّالٍ بشعري","وكم من حُسْنِ شعريَ قد عجبتِ",57,"ت",1,0],["نَحَتُوه مِنَ الخُرَافَةِ والجَهْ","ل وصَاغوهُ مِنْ هوىً فَتّانِ",58,"ن",1,0]]}