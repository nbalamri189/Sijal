{"poems":[[23,"تناولني كسرى ببوسى ودونه","https://www.aldiwan.net/poem21424.html","الطويل"],[4,"طَافَتْ أُسَيْماءُ بالرِّحَالِ فَقَدْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10905&r=&rc=1",""],[264,"لك السعد أسعد يا صبا ما المشام","https://www.aldiwan.net/poem35738.html","الطويل"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101857","الطويل"],[4767,"جرح البحرين","https://www.poetsgate.com/ViewPoem.aspx?id=178432",""],[4767,"نداء محرم","https://www.poetsgate.com/ViewPoem.aspx?id=179993",""],[5277,"مهاجر","https://www.poetsgate.com/ViewPoem.aspx?id=191071",""],[5431,"قبلته...","https://www.poetsgate.com/ViewPoem.aspx?id=200620",""],[6082,"علام الحزن؟","https://www.poetsgate.com/ViewPoem.aspx?id=58987",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""]],"verses":[["فَفَجَّعَني لا وَفَّقَ اللَهُ أَمرَهُ","بِأَبيَضَ وَهّابٍ قَليلِ التَجَهُّمِ",0,"م",1,0],["ففَجادَ رَهواً إلى مداخِلَ فالصحْ","رة ِ أمستْ نِعاجُهُ عُصَبَا",1,"ب",2,0],["ففجر سواه في المكارم أوّلٌ","وهذا هو الثاني عليه عَلام",2,"م",1,0],["ففجر ينابيع العلوم وغذها","من المهد بالعلم الصحيح إلى اللحد",3,"د",1,0],["ففجرٌ بالضيا ينوي بزوغاً","ولكن الظلام به استدارا",4,"ر",2,0],["ففجَّرتْ جنودُ سبطِ الْهدَى","دمَ العدا على الثرى أبحرا",5,"ر",2,0],["ففجرت كل ما في الروح من ألمٍ","واصفرَّ منها المدى والوردُ والفننُ",6,"ن",1,0],["ففجرت المشاعرَ سائغاتٍ","لها في كل ساقيةٍ جباةُ",7,"ه",1,0],["ففجر السعد لن يبقى طويلا","سيأتي الليل يجعله حزينا",8,"ن",2,0],["ففجيعتي بك أنني.. تحت الثرى","روحي، ومن فوقِ الثرى أعضائي",9,"ا",2,0]]}