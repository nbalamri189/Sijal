em.aspx?id=59138",""],[6032,"نجم العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=181517",""],[6056,"المعاناة الشديدة","https://www.poetsgate.com/ViewPoem.aspx?id=130508",""],[6058,"وليدة من رحم شبة المستحيل","https://www.poetsgate.com/ViewPoem.aspx?id=192259",""],[6142,"مل بنا يا هديت ننتجع الحق","https://www.poetsgate.com/ViewPoem.aspx?id=155693",""],[6144,"عزرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=21837",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6189,"يا ضمير الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67118&r=&rc=3",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""],[6244,"ما هو الكون ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=510&r=&rc=3",""],[6251,"وجه الهلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76470&r=&rc=10",""]],"verses":[["واقِفاً كُلَّ مَوقِفٍ تَتَهاوى","دونَهُ أَو تُزَلزَلُ الأَقدامُ",0,"م",1,0],["وَاقِفٌ لِلصَّلاةِ حَتَّى إِذَا مَا","جِئْتَ للِشُّرْبِ حَانَ مِنْهُ سَلاَمُ",1,"م",1,0],["واقِفٌ في سَبيلِهِم أَينَ ساروا","عالِمٌ بِاِحتِيالِهِم أَينَ جابا",2,"ب",2,0],["وَأَقفَرَ عَهدُ الدارِ مِن أُمِّ سالِمٍ","وَأَقصَرَ عَن طولِ التَقاضي غَريمُها",3,"م",3,0],["واقفاً تحت سرحةٍ ناح فيها","طائر فوق غصنها الميّاد",4,"د",1,0],["وَأَقفَرَ وادي ثَرمَداءَ وَرُبَّما","تَدانى بِذي بَهدى حُلولُ الأَصارِمِ",5,"م",1,0],["واقِفيها بِكُلِّ ثَغرٍ مَخوفٍ","هُم عَلَيها لَعَمرُ جَدّي نُضارُ",6,"ر",1,0],["وَأَقفَرَ مِن حُضّارِهِ وِردُ أَهلِهِ","وَكانَ يُرَوّى في قِلالٍ وَحَنتَمِ",7,"م",1,0],["واقفاً في معاهدِ الأسر يبكي","من هوى آسراتِه غيرَ سالِ",8,"ل",1,0],["وَأَقفَرَتِ الفَراشَةُ وَالحُبَيّا","وَأَقفَرَ بَعدَ فاطِمَةَ الشَقيرُ",9,"ر",1,0],["وَأَقفَرَ اليَومَ مِمَّن حَلَّهُ الثَمَدُ","فَالشُعبَتانِ فَذاكَ الأَبرَقُ الفَرَدُ",10,"د",1,0],["واقِفاً في دِيارِ أُمُّ حُسَينٍ","مِن ضُحى يَومِهِ إِلى أُصُلِه",11,"ل",2,0],["واقِفاً بينَ فَتْكَةٍ ومُجُونٍ","راقِصاً في الصَّلاةِ خَلْفَ الإمَامِ",12,"م",1,0],["واقِفاً تَحتَ أَخمَصَي قَدرِ نَفسي","واقِفاً تَحتَ أَخمَصَيَّ الأَنامُ",13,"م",1,0],["وَأَقفَرَتِ المَنازِلُ مِن سُلَيمى","وَكانَت لِلمَوَدَّةِ وَالصَفاءِ",14,"ا",2,0],["واقِفٌ يَسأَلُ الدِيارَ وَعَذلٌ","في سُؤالِ الدِيارِ أَو تَأنيبُ",15,"ب",1,0],["واقِفٌ عِندَ نُهيَةٍ مِن نَداهُ","يَبتَغي أَن يُزادَ فيها مَزيدُ",16,"د",1,0],["واقِفاً يَسأَلُ المَغاني وَيَستَغ","رِزُ فَيداً مِن واكِفٍ مَسجومِ",17,"م",1,0],["واقِفَ البِرذَونِ أُخفي مَنطِقي","مُظهِراً عُذرِيَ في غَيرِ نَجاح",18,"ح",1,0],["وأقفو أثر الشيخين","هرديّ وملّيخا",19,"خ",2,0],["واقفاً لي كأنما هو نسرٌ","وكأني أمامهُ عصفورُ",20,"ر",1,0],["وأَقْفَرَ مِنْها بَعْدَ مَا قَدْ تَحُلُّهُ","مَدَافِعُ أَحْرَاضٍ ومَا كَانَ يُخْلِفُ",21,"ف",1,0],["وَاقِفٌ كَالْخَطِيبِ فَانْتَبَهَ الشَّرْ","قُ وَمَدَّ الأَعْنَاقَ لِلإِصْغَاءِ",22,"ا",2,0],["واقفٌ عمرَه على الذَّوْدِ عنها","لو رماها الزمان أضحى الزمانا",23,"ن",2,0],["واقف للصلاة حتى إذا ما","جئت للشرب حان منه السلام",24,"م",1,0],["واقِفَاً يَسْألُ المَغَاني. وَيَسْتَغْ","زِرُ فَيْضاً منْ وَاكِفٍ مَسْجومِ",25,"م",1,0],["وأقفزت المنازل من سليمى","وكانت للمودة والصفاء",26,"ا",2,0],["واقفاً أندب اعتدال زمانٍ","طال فيه بين الكرام ثوائي",27,"ا",2,0],["وأقفر القلب إلا من رسيس جوى","يكاد أن يوقر الأحشاء هجرانا",28,"ن",2,0],["واقْفُ المعلمَ فيما قال من أَدبٍ","واجعلْ محلّته في أرفعِ القدَرِ",29,"ر",1,0],["وَأَقفو بِعَزمي أُسرَةً تَغلَبِيَّةً","إِلى المَوتِ مِماّ يُكسِبُ العارَ تَهرُبُ",30,"ب",1,0],["واقفتُ منه على الأهوالِ ذا ثقةٍ","نعم الرفيقُ حسامُ الحدِّ مطرور",31,"ر",1,0],["واقفا قد تركته يترامى","فوق الاعتاب هيبة وكرامه",32,"م",2,0],["واقفرَ من نجد من المجد ربعُه","وعمر قبر مفرد بالدكادك",33,"ك",1,0],["وَأَقفرتِ المساجدِ من مصلٍّ","وَعُطِّلَ من مآذنِها النداءُ",34,"ا",2,0],["وأقفر من أَحيائِه كلُّ آهلٍ","وَأضحتْ مغانيه طلولاً بواليا",35,"ي",2,0],["واقف على الباب مقيم","يرجو السعادة والقبول",36,"ل",1,0],["واقفاً يبكي على آثارهم","وِقفةَ العاشقِ بَيْنَ العاذِلَين",37,"ن",1,0],["واقفٌ حائرٌ وقُوفَ أخي العلْ","لَةِ بين الشِّفاء والإشفاء",38,"ا",2,0],["واقفي مَزاري يا بتولُ أَفُز بما","أهوى على عَين الخَليْ العَوّاءِ",39,"ا",2,0],["وأقفرَ مِمّنْ تَعْهدون فقُلتمُ","سِواهُ ولاَ واللهِ ما هُو إلاّ هو",40,"و",1,0],["واقفةٌ من العلا","على طريقٍ مهيَعِ",41,"ع",1,0],["واقفٌ عنده جوادُ سباقي","وإلى هذه المعالي سِباقي",42,"ق",2,0],["وأقفَرَتْ منهُ دارٌ أظلَمتْ كَمَداً","حتى استَوَى في ذَراها الليلُ والسَحرُ",43,"ر",1,0],["وَأَقْفَرَتْ بَعْدَ عُمْرَانٍ بِمَوْقِعِهَا","مِنْهَا دَوَاةُ فَتًى بِالْكُتْبِ مَقْتُونِ",44,"ن",1,0],["وأقفرتني من كلِّ لذّةِ عيشةٍ","وكنتُ غنيّاً فيكِ ممتلئ اليدِ",45,"د",1,0],["واقفٌ الفكر بين أمرك ما م","لّ ولمّا يملَّ طولَ الوقوف",46,"ف",1,0],["وَأَقفَرَ مِن بَني كَعبٍ جُباحٌ","فَذو عَثَثٍ إِلى وادي العَناقِ",47,"ق",1,0],["واقفر ربعه عن كل ندب","يعد لدى النوائب ما عداه",48,"ا",2,0],["واقَفتُهُ وَالحَيُّ عَنّا نُوَّمٌ","بَينَ العُذَيبِ وَبينَ شَطَّي بارِقِ",49,"ق",1,0],["واقفاً يلثم الصليب وطورا","بأناجيله يرجع لحنا",50,"ن",2,0],["وأقفر الحِنوُ لا أنيس بِهِ","فالجزع فالأجزعان فالبرقُ",51,"ق",1,0],["واقِفاً في الدارِ أَبكي","لا أَرى إِلّا طُلولا",52,"ل",2,0],["وأَقفاهُمُ في شوطهم متأَملٌ","تأملَ ما شاء المقامُ وترجما",53,"م",2,0],["واقِفَةً بِالبابِ لَم يُؤذَن لَها","إِلّا وَقَد كادَ يَنامُ الحاجِبُ",54,"ب",1,0],["وأقفرت من بنيها المخلصين وقد","كانت تعجّ قديماً بالملايين",55,"ن",1,0],["واقَفْتُ منه رُكْنَ كلّ عظيمةٍ","بالأعظمِ ابنِ الأعظمِ ابنِ الأعظمِ",56,"م",1,0],["واقف نفسه على ما يراعى","ليس يجري إلاَّ بما أجراها",57,"ا",3,0],["واقفرت بعده دارُ الصبا أسفاً","والعيشُ بعد الصفا لا خير لي فيه",58,"ي",2,0],["واقفاً وقفة الحزين كأني","مذنب واقفٌ امام قضاة",59,"ه",1,0],["واقِفاتٌ وجِفاتٌ خائِفاتُ","ليّها فازت بِقُرتٍ أو دُنَو",60,"و",1,0],["وَأَقفي بِما شاءوا مِنَ الثِقلِ ناقَتي","وَإِن كانَ فيها فَترَةٌ وَلُغوبُ",61,"ب",1,0],["واقفاً يعرضُ الشعوبَ على مصر","ويقضي الحقوق بالميزان",62,"ن",1,0],["وأقفر الشطّان من جنة","فأوحش المصطاف والمربع",63,"ع",1,0],["واقفاً انشد الرسول ضلالا","هل دليل واين مني الدليل",64,"ل",1,0],["واقف باعتدال قد رشيق","موقف فيه ضلعي العوجاء",65,"ا",2,0],["واقفا دونهم يرجي نوالا","ثم يعدو بجيئة وذهاب",66,"ب",1,0],["واقفات كأنها خطباء","تعظ الأرض والسما والأناما",67,"م",2,0],["واقفٌ بالباب يشكو ما به","فمتى تنظر في قصته",68,"ت",2,0],["وأقفرَ وادِيهِنَّ واحتفَرَتْ بهِ","ماكنسُ عِينٍ باقرٌ وظِباءُ",69,"ا",2,0],["واقفت اثرهم علوج أمي","طلقاها بقيةُ الأحزاب",70,"ب",1,0],["وأقفرت البلاد فليس فيها","صديق يستفيد ولا يفيد",71,"د",1,0],["واقِفَةٌ بِلا تَعَبْ","تَشْكُو مِنَ الصَّبِّ لَهَبْ",72,"ب",1,1],["وَاِقفَرَ مِنها الجَوُّ جَوُّ قُراقِرٍ","وَبُدِّلَ آراماً مَذانِبُها السُفلُ",73,"ل",1,1],["وأقفل الأميرُ جندَ البصره","فقفلوا أي رجعوا بالنُّصره",74,"ه",1,0],["وأقفلت عنهم والمنايا صوائب","تسيل بها في ساحتيهم سجالكا",75,"ك",2,0],["واقِفاتٍ مِن بَقايا سُفُنٍ","في بِحارِ السِحرِ ظَلَّت غارِقَه",76,"ه",1,0],["واقفاً بالرّقاع في كلّ فجٍّ","أتَرَجَّى مَرَاحم السُّلطانِ",77,"ن",1,0],["واقفاً خلف كوَّة البيت يشكو","بأَنينٍ كأَنَّة الثكلانِ",78,"ن",1,0],["وَأَقفَرَ مِنها حُرِّياتُ فَما يُرى","بِها ساكِنٌ نَبِحُ وَلا مَتَنَوِّرُ",79,"ر",1,0],["واقفٌ في الديار وهي خلاء","وقفة الموسوي بالسرداب",80,"ب",1,0],["واقِفٌ في فِنااها يَتَنَشَّى","نَفَحاتِ الارِيجِ مِنْ وَجْنَتَيْها",81,"ي",3,0],["وأقفر الربع بعد أنسٍ","فعمر لهو الفتى قصير",82,"ر",1,0],["وأقفرت البويرَةُ من سلامٍ","وسعيةَ وابن أخطبَ فهي بُورُ",83,"ر",1,0],["واقفٌ في دربِ الأسى مكبولُ","لي حبيبٌ إليه قلبي يميلُ",84,"ل",1,1],["وأقفا وأنا قفيت والصمت حيلتي","عز الكلام ودمعة الياس فارقه",85,"ق",2,0],["وآقف بنظرات الضياع ومصيره","من جمرةٍ وشلون تحيى على ميّ",86,"ي",1,0],["واقفْتُهُ كيما أُسائلُهُ اللّقا","فمتى لصَبٍّ أنْ يتُمَّ صيامَهُ",87,"م",2,0],["واقفيت كن العمْر لحظة ختاما","وماعاد اشوف اللي على الدرب يمشون",88,"ن",1,0],["واقفيت كني ماشي الدرب اعمى","عصبٍ شعوري ماسكه مع وريده",89,"د",2,0],["واقف وكن رجلى فوق جرف متهايل","للجمال بعيون العاشقين إحترام",90,"م",1,0],["واقفٍ أنظر قدر ساعة","ضاع دربي في تواليها",91,"ي",3,0],["واقف على شرياني بسيف مسلول","واحلامي مطوّح بها فالمنافي",92,"ف",2,0],["واقفين على ابوابنا الأعدا - وحكومه قاعده","على قلبنا كده متواعده - من غير انذار",93,"ر",1,0],["واقفاً والوقتُ لا يملِكُني","شَامِتاً بالوقتِ إذْ يَنْتَحِرُ",94,"ر",1,0],["واقفٍ في طرف المحكمة منذهل","عين عند النيابه وعين عند الدفاع",95,"ع",1,0],["واقفٌ ظِلّي تَحْت شُرْفة أوْجا","عي فلاعُجْبَ إنْ ذَوى الصَّفْصافُ",96,"ف",1,0],["واقف على كثر ماعاني من اشرودي","شفني على باب حيره تشلع ارقادي",97,"د",2,0],["وأُقفِلَ الليلُ لا فجرٌ فَنَلحَظهُ","وأقبلَ الصّبحُ لا ضوءٌ فينتشرُ",98,"ر",1,0],["وأقفوا عليها خايبين الذمه","وحطوا حجابٍ من وراه حجابي",99,"ب",2,0],["واقفا ذليل يتبع السير بالسرا","وحرب عناله بالفواد شكاه",100,"ا",2,0],["واقف على جال السفر نفس السهر","عصفور رفرف للفضاء واستعذبه معنى الرفيف",101,"ف",1,1],["واقف فوق السهر.. والحزن يمدحني .. واذمّه !","لعنبو هالحزن .. ساقه فالسهر ضدي حميّا !",102,"ي",2,0],["واقفيت مثل اللي فقد كل الاخوان","وافقت وقتي بعد ما مات رفضي",103,"ض",2,0],["واقفٌ خلف بابِ ليلَِك صُبْحٌ","فاضربِ الباب يحتضنْكَ الضياءُ",104,"ا",2,0],["وَاقفِزْ إلَى البِحَارِ والجِبَالِ أَو","كُنْ خَلفَ أَسوَارٍ ودِرْعٍ نَائِيَا",105,"ي",2,0],["ٌو أقفرَ من ربوع العمر أنس","ُفلا عيد الأنام لديّ عيد",106,"د",1,0],["واقف لوحدي أهوجس وارمق بنظرة بعيدة","مرة أمدح في الزواج ، وعشر مرات ٍ أذمّه",107,"م",2,0],["واقفيت واركون الشجر م لها ظليل","والشوف ينزل ، وارتفع حس السماع",108,"ع",1,0],["واقفاً في قبالة الكل ثبتا","لم يزلزله عاصف التقليد",109,"د",1,0],["واقف في نص الطريق","والوقفه مكسيكي",110,"ي",1,0],["وَاقفوا بنا من مسقط الروس والوَطَن","عَلى غَير حَق عيالنا شتتونها",111,"ن",3,0],["وَاقفوا بِنا غَير جادي عَلى الهَفا","وَبذوا شظانا بَين قَوم فشالها",112,"ل",3,0],["واقف فوق سيفكم أتلظى","وقفتي رجفةٌ وهمسي سعيرُ",113,"ر",1,0],["واقفا عند أُحْد وقفة دمع","حبرت فارسا , أبا الشهداء",114,"ا",2,0],["واقفاً ناظراً محياه فيها","في غرورٍ كوقفة الحسناءِ",115,"ا",2,0],["وَاقِفَاً عِندَ بَابِهَا لَسْتُ أَدْرِي","أَينَ أُلْقِي من الجَوى أَثْقَالي",116,"ل",2,0]]}