{"poems":[[65,"إيها فكم تهصر أغصان الضال","https://www.aldiwan.net/poem46152.html","الرجز"],[65,"لمعت كناصية الحصان الأشقر","https://www.aldiwan.net/poem46196.html","الكامل"],[75,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[74,"يا بارقا من نحو بشر باسمه","https://www.aldiwan.net/poem19442.html","الكامل"],[64,"إيها فإني لا أطيع محرشي","https://www.aldiwan.net/poem52372.html","الكامل"],[107,"لمن الرواسم يرتمين صواديا","https://www.aldiwan.net/poem43382.html","الكامل"],[77,"فتكات طرفك أم سيوف أبيك","https://www.aldiwan.net/poem69051.html","الكامل"],[580,"نحافة الغصن غيظ من تثنيكا","https://www.aldiwan.net/poem3044.html","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120075","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95498","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102934","الكامل"],[4869,"صوت الانين","https://www.poetsgate.com/ViewPoem.aspx?id=151712",""]],"verses":[["إيهاً فكمْ تُهْصَرُ أغْصانُ الضّالْ","والعِيسُ يمْرَحْنَ بمُسْتَنِّ الآلْ",0,"ل",1,1],["إيْهاً فقَدْ أدرَكْتَ منْ شَرَفِ العُلا","ما لم يُنَلْ وذَخَرْتَ ما لمْ يُذْخَرِ",1,"ر",1,0],["إيهاً فَلَولا أَن أَروعَكِ بِالسَرى","لَدَنا وِسادٌ أَو لَطالَ سُوادُ",2,"د",1,0],["إيهاً فقد شفيَ ابن خضر فلم يدع","قلباً ولا جداً لنا موعوكا",3,"ك",2,0],["إِيهاً فإني لا أطيعُ مُحَرِّشِي","والمحْ جوابَك في عِذَارِ ألَلْمُشِ",4,"ش",1,1],["إيهاً فَإِنَّ مِنَ السُكوتِ بَلاغَةً","جَللاً تَفيضُ عَلى العُقولِ مَعانِيا",5,"ي",2,0],["إيهاً فمِن بين الأسَّنةِ والظُّبى","إنّ الملائكَةَ الكِرامَ تَليك",6,"ك",1,0],["إِيهاً فأَمْلِ أَحاديث الغَرامِ له","فما أَمانيه إِلاَّ في أَمَالِيكَا",7,"ك",2,0],["إيهاً فكم دامت لكفك ديمة","بخل السِّماك بمثلها والمِرزمُ",8,"م",1,0],["ايهاً فؤاد النيل أنت له","ولك الولاءُ المحض والأمرُ",9,"ر",1,0],["أيها فإن لكل ضيق فرجة","والغيث تلو البارق المتلهب",10,"ب",1,0],["ايه افرحي ماتت من سنيني احلام","ايه اطربي .. صار العزا يوم عيدي",11,"د",2,0]]}