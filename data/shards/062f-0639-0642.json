{"poems":[[52,"أفنيت عمري وتقضى الشباب","https://www.aldiwan.net/poem64823.html","السريع"],[78,"دع قول واشية وواش","https://www.aldiwan.net/poem39279.html","مجزوء الكامل"],[580,"دع قضب نعمان أو كثبان يبرين","https://www.aldiwan.net/poem2851.html","البسيط"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26662","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53223","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62959","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133068","البسيط"],[4935,"دع قول كل مكابر ومرائي","https://www.poetsgate.com/ViewPoem.aspx?id=129437",""],[5829,"الصوم عن المفاسد","https://www.poetsgate.com/ViewPoem.aspx?id=212595",""],[5829,"صانع الامل","https://www.poetsgate.com/ViewPoem.aspx?id=213787",""]],"verses":[["دَع قَولَ واءٍ وَاِنتَظِر فِعلَهُ","يُثني عَلى اللِقحَةِ ما في العِلاب",0,"ب",1,0],["دَعْ قَولَ وَاشِيَةٍ وواشِ","وَاجْعلهُما كلْبَيْ هِراشِ",1,"ش",1,1],["دع قضْبَ نَعْمَان أَو كُثْبانَ يَبرين","ما قلَّبَ القَلبَ إِلاَّ أَعينُ العِينِ",2,"ن",1,1],["دع قضب الخط للذي حملت","من قصب الخط في التّجاريب",3,"ب",1,0],["دع قصر بطياس فها آثاره","بالعجز تعرب عن بني خاقان",4,"ن",1,0],["دع قاطعاً بيديه يأْخُذْ خِيفَةً","ويُهينُ مولاه ويأمُلُ ضعفَهْ",5,"ف",2,1],["دع قول فدمٍ أخي شقاء","نذلٍ جهولٍ غوي حسود",6,"د",1,0],["دع قول كل مكابر ومرائي","وأشرب على ودي كؤس صفاء",7,"ا",2,1],["دعْ قولََ زورٍ واستقمْ، إن احصرَتْ","نفس الشريفِ فلنْ تباعَ وتشترى",8,"ر",2,0],["دعْ قولَ من مدحوا أو قولَ من سخِروا","فالناسُ ما تركوا شيئا بلا خَللِ",9,"ل",1,0]]}