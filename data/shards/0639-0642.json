َ لي المُحالا",149,"ل",2,1],["عَقَدْنَا جَنَاحَيْ لَيْلِنا بِنَهَارِنَا","وَطِرْنَا مَعَ اللَّذَّاتِ حَيْثُ تَطِيرُ",150,"ر",1,0],["عَقَدَتْ ذَلاذِلَ سُوقِهَا فِي جِيدِهَا","وَسَمَتْ فَلَيْسَ تَنَالُهَا الأَبْصَارُ",151,"ر",1,0],["عَقِيلَةُ أَتْرَابٍ تَوَالَيْنَ حَوْلَهَا","كَمَا دَارَ بِالْبَدْرِ النُّجُومُ الزَّواهِرُ",152,"ر",1,0],["عَقَلْنَا بِهِ مَا نَدَّ مِنْ كُلِّ صَبْوَةٍ","وَطِرْنَا مَعَ اللَّذَّاتِ حَيْثُ تَطِيرُ",153,"ر",1,0],["عَقِيلَةُ بَيْتٍ بَارَكَ اللهُ حَوْلَه","فَمَا مِنْ وَشَايَاتٍ وَمَا مِنْ عَوَاذِلِ",154,"ل",1,0],["عَقِيلَةٌ أَنْزَلَهَا عَقْلُهَا","مِنَ الْغَوَانِي مَنْزِلاً مُفْرَدَا",155,"د",2,0],["عَقِيدَتُهُ فِي مِنْعَةٍ مُطْمَئِنَّةٍ","وَمِنْ حَوْلِهَا العِلاَّتُ مُعْتَرِكَاتُ",156,"ت",1,0],["عُقِدَتْ بِهَا صِلَةُ المَفَاخِرِ وَالعُلَى","للأُسْرَتَيْنِ وَخُلِّدَتْ بِكِتَابِ",157,"ب",1,0],["عَقَدَ العِطْرُ سَحَاباً نَاصِعاً","فَاشِياً بَيْنَهُمُ مُنْتَشِرَا",158,"ر",2,0],["عَقَّكَ عَضَّ الصّبَا","بَانَ وَمَا وَدَّعَكْ",159,"ك",1,0],["عَقدَتْ أَغْصَانُهَا تَاجَ سَنى","وَخَبَتْ بَيْنَ مُدَلاَّةٍ وَكسْرَى",160,"ر",2,0],["عَقْرَبٌ شَالتْ زُبَانَى رَأْسِهَا","وَالذّنابَى عَجِلَتْ خلْجاً وَأَبْرَا",160,"ر",2,0],["عَقِيدَةُ نَفْسٍ أَوْرَدَتْهُ مَهَالِكاً","وَلَمْ تَأْبَ أَنْ يُرْعَى الخُصُومُ وَإِنْ زَلُّوا",161,"ل",3,0],["عِقْدٌ إِذَا أَهْدَاهُ لُبْنَ","انٌ فَقَدْ أَغْلَى وَأَهْدَى",162,"د",2,0],["عَقَدَ السَّعْدُ فِيهِ عَقْداً جَمِيلاً","ضَمَّ رَبَّ الحُسْنَى إِلى الْحَسْنَاءِ",163,"ا",2,0],["عَقيلَتِيَ اِستُلِبَت مِن يَدي","وَلَمّا أَبِعها وَلَمّا أَهَب",164,"ب",1,0],["عَقص الظَلام عَلى الصَباحِ وَلَم يَكُن","لَولا غَدائِرهُ الظَلامُ لِيَعقَصا",165,"ص",2,0],["عَقَقتُكَ إِن لَم أَبكِ بِالدَمِ كُلّه","وَإِن لَم أَمُت بَينَ البُكا وَالتَأَسُّفِ",166,"ف",1,0],["عَقيقٌ جَرى في الدرَّ حَتّى إِذا مَحا","مَحاسِنهُ عاقَ الهِلال أفولُ",167,"ل",1,0],["عقولٌ من الأحجارِ هامت بمثلها","وكل بكيمٍ لليكيمِ كِفاءُ",168,"ا",2,0],["عقدنا للعرُوبةِ فيه عهداً","فلا وَهْناً نخافُ ولا انفصاما",169,"م",2,0],["عَقَدَتْ بَيْننا اللَّيالي صِلاَتٍ","مُحْكَماتٍ أَحْبِبْ بها مِن صِلاَتِ",170,"ت",1,0],["عِقْدٌ وهذا الْوُجُودُ نَحْرُ","قد يَجْمُلُ النحْرُ بالعُقُودِ",171,"د",1,0],["عَقَدَ الأَمْرَ فابْتَكَرْتَ لَهُ الْحَلَّ","وما كانَ عَقْدُهُ مَحْلُولاَ",172,"ل",2,0],["عَقَدُوا خَناصِرَهُمْ عَلَى","صِدقِ الْوَفاءِ أَشَدَّ عَقْدِ",173,"د",1,0],["عقيلةٌ في جلال المُلْكِ ناعمةٌ","النبلُ يحرُسُها واللَهُ يَرْعاها",174,"ا",3,0],["عَقَدَ الإِلَهُ عُرَاهُ جَلَّ جَلاَلُهُ","أَتَرَى لِعَقْدِ اللّهِ مِنْ حَلاَّلِ",175,"ل",1,0],["عقرت على أنصاب توبة مقرما","بهيدة إذا لم تختفره أقاربه",176,"ه",1,1],["عقل أخفّ من الكحول، أخاف إن","مر النسيم عليه أن يتبخرا",177,"ر",2,0],["عقيلة ملك فزت منها بطائل","عزيز على النفس الكريم الممجد",178,"د",1,0],["عقد الحبّ فؤادينا كما","يعقد الهدب إلى الهدب المنام",179,"م",1,0],["عقلها حول يديها فاتح","فمه يلتقم الشعب التقاما",180,"م",2,0],["عقت البلغار والحلم قضى","وتلاشى في شهور الحمل",181,"ل",1,0],["عقابيلُ داءٍ ما لهُنَّ مطبَّبُّ","ووضعٌ تغشَّاهُ الخَنا والتذَبذُبُ",182,"ب",1,1],["عق كريم متى عدت مناقبه","كانا سواء لديه الدين والحسب",183,"ب",1,0],["عَقَدُوا عِمَامَتَهُ بِرَأسِ قَنَاتِهِ،","وَرَأوْهُ بَرّاً فَاسْتَحالَ عُقُوقَا",184,"ق",2,0],["عُقِدَ اللواءُ به على ذي هيبة","ٍ حالي المناسلب بالكرام حسيب",185,"ب",1,0],["عقلُنا، فكرُنا، هزالُ أغانينا","رؤانا، أقوالُنا الجوفاءُ",186,"ا",2,0],["عقائلُ الدرّ على العقائل","في وَشْيهنّ الفاخِر المَخايل",187,"ل",1,0],["عَقَّ من عق مثلَه اللَّهُ والح","قُّ وربُّ الجزاء في مرصادِهْ",188,"د",2,0],["عُقولٌ من الأحجارِ هامت بمثلها","وكل بَكيمٍ للبكيمِ كِفاءُ",189,"ا",2,0],["عقدت يد الله القوي حيالها","والرسل والملأ العلي شهود",190,"د",1,0],["عقاب الداء من طب المنايا","إذا لم يخش من طب عقا",191,"ق",2,0],["عقائلُ لم يعشنَ بعيشِ بؤسٍ،","وَلَكِنْ بِکلغُضَارَة ِ والنَّعيم",192,"م",1,0],["عَقيلَة ُ أتْرَابٍ لهِا، لا دَمِيمَة","وَلا ذَاتُ خَلقٍ إن تأمّلتَ جَأنّبِ",193,"ب",1,0]]}