/www.poetsgate.com/ViewPoem.aspx?id=179530",""],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.poetsgate.com/ViewPoem.aspx?id=33822",""],[100,"حيث التقينا","https://www.poetsgate.com/ViewPoem.aspx?id=50147",""],[100,"حين يصحو الشعب","https://www.poetsgate.com/ViewPoem.aspx?id=50112",""],[98,"الدول العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=55340",""],[90,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[45,"يشكو إليك هواك المدنف الوصب","https://www.poetsgate.com/ViewPoem.aspx?id=33094",""],[45,"أأفاق صَبٌّ مِنْ هَوىً، فأُفِيقَا","https://www.poetsgate.com/ViewPoem.aspx?id=32851",""],[80,"من كان يعذب عندها تعذبني","https://www.poetsgate.com/ViewPoem.aspx?id=3020",""],[99,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[51,"أتصَاب إلى ذوي إسعادِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=27791",""],[101,"أطلّت على سُحبِ الظلامِ ذُكاءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62408&r=&rc=0",""],[105,"عهد لمصر من الحياة جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54894&r=&rc=64",""],[105,"لهان على نعاتك أن نصابا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55035&r=&rc=205",""],[31,"أقولُ لصاحبيّ، ومثلُ ما بي،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19060&r=&rc=323",""],[0,"خليلّي مرّ بي على أم جندب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14326&r=&rc=2",""]],"verses":[["عَقَدتُ ذَوائِبَ الأَبطالِ مِنهُ","بِأَطرافِ المُثَقَّفَةِ الدَواني",0,"ي",1,0],["عَقيبُ شَبابِ المَرءِ شَيبٌ يَخُصُّهُ","إِذا طالَ عُمرٌ أَو فَناءٌ يَعُمُّهُ",1,"م",2,0],["عُقارٌ يُلاحِظُ مِنها الكُؤو","سَ أَفواهُنا بِجُفونٍ دَوامِ",2,"م",1,0],["عَقَروا لَيثاً وَلَو هاهوا بِهِ","كانَ بَعدَ العَقرِ أَرجى لِلصِيالِ",3,"ل",1,0],["عَقَلوهُ بَعدَما جازَ المَدى","وَطَوى شَأوَ مَساعٍ وَمَعالي",3,"ي",1,0],["عَقّادُ أَلوِيَةِ المُلو","كِ عَلى العُلى جيلاً فَجيلا",4,"ل",2,0],["عَقائِلُ عَلَّمَهُنَّ العَفا","فُ وَصلَ المَطالِ وَمَطلَ الوِصالِ",5,"ل",1,0],["عَقَدوا بِها المَجدَ الشَرودَ وَأَثَّلوا","دَرَجاً إِلى شَرَفِ العُلى وَمَراقي",6,"ق",2,0],["عَقَدوا بَينَكُم وَبَينَ المَعالي","قَبلَ يَعلو الرِجالُ عَقداً وَحِلفا",7,"ف",2,0],["عَقَدوا بَينَها وَبَينَ نُجومِ ال","أُفقِ مِن سالِفِ اللَيالي جِوارا",8,"ر",2,0],["عَقَدوا عَلى الجُلّى مَآزِرَهُم","سُبطَ الأَنامِلِ طَيّبي الأُزرِ",9,"ر",1,0],["عَقَدوا لِواءَهُمُ بِبيضِ أَكُفِّهِم","كِبراً عَلى العَقّادِ وَالأُمّارِ",10,"ر",1,0],["عُقابُ النَصرِ تَحتَهُمُ مَهيضٌ","وَنَسرُ المَوتِ فَوقَهُمُ مُطارُ",11,"ر",1,0],["عَقيدَ العُلى لا زِلتَ تَستَعبِدُ العُلى","وَتُعتِقُ مِنها رِقَّ كُلِّ أَسيرِ",12,"ر",1,1],["عَقَدنا بِباعِ الرَدى ذِمَّةً","فَحَلَّ الذِمامَ وَفَضَّ الذُمارا",13,"ر",2,0],["عُقَبُ الجَديدِ إِذا مَرَرنَ عَلى الفَتى","مَرَّ الفَوادِحِ لَم يَدَعنَ جَديدا",14,"د",2,0],["عُقَدٌ لِلمَجدِ باقٍ عَينُها","أَبَدَ الدَهرِ وَلِلمَجدِ عُقَد",15,"د",1,0],["عَقَدتُم بِها حَبلي إِسارٍ وَمِنَّةٍ","وَخانَهُمُ نَقضُ القُوى وَالنَكائِثُ",16,"ث",1,0],["عقَدَتْ بالنَّجمِ صَبوتُهُ","ناظِراً يُغفي وَيَنتَبِهُ",17,"ه",1,0],["عِقابُ الهَجرِ أَعقَبَ لي الوِصال","وَصِدقُ الصَبرِ أَظهَرَ لي المُحالا",18,"ل",2,1],["عَقائِلُ مِن بَناتِ أَبيكِ صُوَرٌّ","إِليَّ ذَواتُ عَطفٍ وَاِنقيادِ",19,"د",1,0],["عَقَائِلُ الْعَقْلِ وَالسِّحْرِ الْحِلاَلِ ثَوَتْ","مِن كَافِلِ الصَّوْنِ بَعْدَ الْكَوْنِ حِجْرَ وَصِي",20,"ي",1,0],["عَقَدْتُ صَفْقَةَ وُدِّي فِيكَ رَابِحةً","إِنْ حَلَتِ الْحالُ لاَ تَخْشَى مِنَ الْغَبَنِ",21,"ن",1,0],["عقِبَ الشّعيرِ لقد هوَتْ بكَ عِيري","كالمُجْرِمينَ هَوَوْا لقَعْرِ سَعيرِ",22,"ر",1,1],["عَقيلَةُ مُلْكٍ فُزْتَ منْها بطائِلٍ","عَزيزٍ على نفْسِ الكَريمِ المُمَجَّدِ",23,"د",1,0],["عَقْدُكَ كافورٌ بلا مِرْيَةٍ","وعَقْلُكَ الهَلْهَلُ منْ بَنْجِ",24,"ج",1,0],["عَقَبَاتُ مُنَكَّب نَاكِبَةٌ","مَنْ أَقْدَمَ فَاقْتَحَمَ الْعَقَبَهْ",25,"ه",1,1],["عَقّوا المُروءَةَ هَدّوا","مَفاخِرَ الأَوَّلينا",26,"ن",2,0],["عَقَّني الدَهرُ وَلَولا أَنَّني","أوثِرُ الحُسنى عَقَقتُ الأَدَبا",27,"ب",2,0],["عَقَرتُ لِصحبٍ جُوَّعٍ فَرَدَدتُهُم","بِطاناً وَلَمّا تَدمَ مِنها نُحورُها",28,"ه",2,0],["عِقدٌ تَأَلَّفَ في نِظامِ رِياسَةٍ","نَسَقَ اللَآلِئَ مُنجِباً وَنَجيبا",29,"ب",2,0],["عَقيلَةُ سِربٍ لا الأَراكُ مَرادُهُ","وَلا قَمِنٌ مِنهُ البَريرُ وَلا المَردُ",30,"د",1,0],["عُقوبَةٌ أَحسِن بِها سُنَّةً","في مِثلِهِ مِن حَسَنٍ مُذنِبِ",31,"ب",1,0],["عُقاراً عُتِّقَت مِن عَهدِ نوحٍ","بِبَطنِ الدَنِّ تَبتَذِلُ السِنينا",32,"ن",2,0],["عَقيلَةُ أَترابٍ لَها لا ذَميمَةٌ","وَلا ذاتُ خَلقٍ إِن تَأَمَّلتَ جَأنَبِ",33,"ب",1,0],["عُقُودٌ مُنَثرَةٌ بِانْتِظَا","مٍ عَلَى نَفْسِهَا أَبَداً دَائِرَهْ",34,"ر",2,0],["عُقْبَى نَزَاهَتِهِ وَلَيْسَتْ تَسْتَوِي","فِي النَّاسِ عُقْبَاهَا بِكُلِّ مَكَانِ",35,"ن",1,0],["عِقْدٌ تَفَرَّدَ فِيهِ الرَّافِعِيُّ وَهَلْ","لِذَلِكَ الْبُلْبُلِ الْغِرِّيد مِنْ ثَانِي",36,"ي",1,0],["عَقيلَةُ أَترابٍ كَأَنَّ بِعَينِها","إِذا اِستَيقَظَت كُحلاً وَإِن لَم تُكَحِّلِ",37,"ل",1,0],["عقدت بمرقبة العيون مسرّةً","فَمُكِبّرٌ لطلوعه ومهلِّلُ",38,"ل",1,0],["عقيلةٌ صورتها","من الجمال مبدعَهْ",39,"ع",2,0],["عقصت شعرها وقد زيّنته","بحلّى من نقارس مزدانه",40,"ن",2,0],["عَقَدنا لها عقد الوَلاء تعشُّقاً","فكنّا لها إِلفاً وكانت لنا الفا",41,"ف",2,0],["عقل وتجرِبة وجِدّ زائد","هذي صفات حازها المتقاعد",42,"د",1,1],["عَقَروا رَواحِلَهُ فَلَيسَ بِقَتلِهِ","قَتلٌ وَلَيسَ بِعَقرِهِنَّ عِقارُ",43,"ر",1,0],["عُقابُ المَنايا تَستَديرُ عَلَيهِمُ","وَشُعثُ النَواصي لُجمُهُنَّ تَصَلصَلُ",44,"ل",1,0],["عَقَدتُ عَلى مُقَلَّدِهِ يَميني","وَأَعفَيتُ المُثَقَّفَ وَالحُساما",45,"م",2,0],["عَقيلَةُ حَيٍّ مِن لُؤَيِّ بنِ غالِبٍ","كِرامِ المَساعي مَجدُهُم غَيرُ زائِلِ",46,"ل",1,0],["عقيلة الأنصار حكَّامهم","لا برحت علياهمُ حاكمهْ",47,"م",2,0],["عَقَدَ الخَلائِقُ في الإِلَهِ عَقائِداً","وَأَنا اِعتَقَدتُ جَميعَ ما عَقَدوهُ",48,"ه",1,1],["عَقدُ النُبُوَّةِ مِصباحٌ مِنَ النورِ","مُعَلَّقُ الوَحيِ في مِشكاةِ تَأمورِ",49,"ر",1,1],["عقيدَ النَّدى أطلِقْ مدائح جمّةً","حبائس عندي قد أَتَى أن تُسرَّحا",50,"ح",2,1],["عَقْدُنا واحدٌ وهاتيك قُربَى","مَسُّها مثلُ مسِّ حبلِ الوريدِ",51,"د",1,0],["عَقَّ من عقَّ مثلَه اللَّهُ والحق","قُ وربُّ الجزاء في مرصادِهْ