{"poems":[[90,"الشعر مفتقر مني لمبتكر","https://www.aldiwan.net/poem44991.html","البسيط"],[94,"يا موت قد مزقت صدري","https://www.aldiwan.net/poem38940.html","مجزوء الكامل"],[47,"أرانا لانزال نسام خسفا","https://www.aldiwan.net/poem66790.html","الوافر"],[83,"لقد أعقبت بالبؤس منك وبالنعمى","https://www.aldiwan.net/poem61490.html","الطويل"],[41,"وأجوبة كالزاعبية وخزها","https://www.aldiwan.net/poem53715.html","الطويل"],[90,"الشعر مفتقر مني لمبتكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19518&r=&rc=21",""],[128,"وهمت فليس ما سمي","https://www.aldiwan.net/poem23710.html","الهزج"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[214,"يا أهيل الحمى وعرب الفريق","https://www.aldiwan.net/poem13300.html","الخفيف"],[216,"عنطنطة غنجاء غرثاء بضة","https://www.aldiwan.net/poem37849.html","الطويل"],[234,"قد كنت أركب في هواك مساءتي","https://www.aldiwan.net/poem51251.html","الكامل"],[376,"مزيدي أسى ما عندكم أنه يسلي","https://www.aldiwan.net/poem57215.html","الطويل"],[572,"وأجوف معشوق الأنين مخفف","https://www.aldiwan.net/poem69771.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48678","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70954","البسيط"],[1399,"","https://poetry.dctabudhabi.ae/diwan/poem/143713","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87835","الكامل"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96187","الكامل"],[2074,"","https://poetry.dctabudhabi.ae/diwan/poem/33094","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129831","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112569","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114125","المجتث"],[3926,"","https://poetry.dctabudhabi.ae/diwan/poem/145513","الطويل"],[4033,"","https://poetry.dctabudhabi.ae/diwan/poem/101191","الكامل"],[4830,"قبل المَدى","https://www.poetsgate.com/ViewPoem.aspx?id=196964",""],[4981,"نجوى إلى الحَجِيج","https://www.poetsgate.com/ViewPoem.aspx?id=190676",""],[585,"الكاس واحدةٌ ونحن اثنان","https://www.poetsgate.com/ViewPoem.aspx?id=161930",""],[5082,"أطيافٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212387",""],[5186,"أيهذا البناء لو كنت حرا","https://www.poetsgate.com/ViewPoem.aspx?id=156469",""],[5285,"نوَّارة","https://www.poetsgate.com/ViewPoem.aspx?id=203655",""],[5344,"طبعي مزوح","https://www.poetsgate.com/ViewPoem.aspx?id=154945",""],[5574,"صهوة حرفي","https://www.poetsgate.com/ViewPoem.aspx?id=205990",""],[5975,"ما عدت من موتي أخافْ","https://www.poetsgate.com/ViewPoem.aspx?id=85138",""],[6032,"خلب الغرام جنانا","https://www.poetsgate.com/ViewPoem.aspx?id=181523",""],[6277,"توبة عن التوبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64442&r=&rc=1",""],[5190,"ها أنا يا نبض قلبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78297&r=&rc=10",""]],"verses":[["وأجود الشعر ما يكسوه قائله","بِوَشْي ذا العصر لا الخالي من العُصُر",0,"ر",1,0],["وأَجوبُ صحراءَ الحَيَاةِ","أَقولُ أَيْنَ تُراهُ قبْرِي",1,"ر",2,0],["وَأَجوَرُ خُطَّةٍ طاوُوسُ حُسنٍ","يُوَلّى الحُكمَ فيهِ غُرابُ بَينِ",2,"ن",1,0],["وَأَجوَدُها تَندى الصِلادُ غَضارَةً","بِهِ وَيَفوحُ التُربُ مِسكاً إِذا شُمّا",3,"م",2,0],["وَأَجوِبَةٌ كَالزاعِبِيَّةِ وَخزُها","يُبادِهُها شَيخُ العِراقَينِ أَمرَدا",4,"د",2,1],["وأجود الشعر مما يكسوه قائله","بوشي ذا العصر لا الخالي من العصر",5,"ر",1,0],["وأَجود صنف تسبيح","بذكر اللّه ريانا",6,"ن",2,0],["وَأجودُ الناسِ كغيثٍ مُنسجِم","أَجدى الوَرى جوداً وأَوفى كَرما",7,"م",2,0],["واجوز الصراط كي لمناها","تبلغ النفس بالمجاز الحقيقي",8,"ق",2,0],["وأجودُ منه بالسماحةِ مادِرٌ","وأفصحُ منه في المقالةِ باقِلُ",9,"ل",1,0],["وأجود بالنّفس النفيسة جاهداً","لك في الهوى ويَطيبُ لي تَعْذيبي",10,"ب",2,0],["وأجودُهُم من خَصَّ بالبَذلِ عرضَه","وما سائِرُ الأشياءِ تَصلحُ للبَذلِ",11,"ل",1,0],["وأجْوَفَ معشوقِ الأَنينِ مُخَفّفٍ","تُحرَّكُ مِنْ إطْرابِنَا حَرَكَاتُهُ",12,"ت",2,1],["وأجول في تلك الميادين التي","وسعت فتوح الأرض في ساعات",13,"ت",1,0],["وأجود الناس رأيا من إذا سَمِعت","أذْناه نصحا غدا بالنصح متَّعِظا",14,"ظ",2,0],["وأجوب البلاد تحتي ظبيٌ","ضاحكٌ سنهُ كثيرٌ التمرى",15,"ر",2,0],["وَأَجوبَ أَنحاءَ الصَعيدِ مُكَرَّماً","وَذُرى جِبالِ الأَرزِ رَهنُ عَذابِها",16,"ب",3,0],["واجول في غمرات حبك جاهدا","طورا فيحسبني الجليس رهيبا",17,"ب",2,0],["وَأَجوَفاً مِن نَباتِ الغيلِ توجِبُهُ","أَعالي الرَوقِ ذا طَيشٍ مِنَ الأَدَنِ",18,"ن",1,0],["وأجوب نحوَكمُ المنازلَ جاهداً","ومع اجتهادي فاتني ما أطلبُ",19,"ب",1,0],["وأجوس جنات النعيم إلى العلا","فإذا بأرجاء الجحيم مطافي",20,"ف",2,0],["وَأجوَدِ النَّاسِ كَفاً","قَد فَاقَ بَحراً وَمَوجَه",21,"ج",2,0],["وأجود من كعب بن مامة باللهى","وأحلم من قيس إذا حلت الحبى",22,"ب",2,0],["واجوب اوعار العراق وسهلها","وألف منها فدفداً في فدفد",23,"د",1,0],["وأجوبُ في عَرَضِ الدُّنا أملاً","أهفو فيعقرُ همَّتي كَبوي",24,"و",2,0],["وأجوبُ عَدْوَاً للصّفا والمَروَةِ","فَتَطِيْبُ نفسي لو هناكَ أهرولُ",25,"ل",1,0],["وأجول في الأحشاء تسعة أشهرٍ","وأزول عند الموت بعد ثوان",26,"ن",1,0],["وأجوبُ في ليل الصدى","فَتَلُفُني أطيافُ عهدِكْ",27,"ك",1,0],["وأجوز المعنى الصحيح قياسا","وتجيز المين الصريح سماعا",28,"ع",2,0],["وأجوبُ أفقَ الكونِ مُنتشياً","بحديثِها المُنسابِ من فيها",29,"ي",3,0],["واجود في خوة هل الطيب والجود ،","والصاحب آشوفه بعيني أمانه",30,"ن",2,0],["٣- وأجوبُ الأفْقَ حُرًّا","هاربًا منْ كلِّ منْفى",31,"ف",2,0],["وأجوّدُ النغمَ الأخيرَ","أودُّ للهمِّ انكشافْ",32,"ف",1,0],["وأجوب في ديجور غيب لا أرى","إلا عيونك مرفأ وأمانا",33,"ن",2,0],["وأجود صنف تسبيح بذكر الله ريانا !","يباع وجملة ( بالكمش ) لا يحتاج ميزانا",34,"ن",2,0],["وأجوبُ الروض غضّاً","أحتسي كأسَ الحنان",35,"ن",1,0]]}