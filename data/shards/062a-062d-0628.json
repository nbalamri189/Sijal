,"العُمر عود ثقاب","https://www.poetsgate.com/ViewPoem.aspx?id=48378",""],[4966,"أتوق إليك...","https://www.poetsgate.com/ViewPoem.aspx?id=196714",""],[5061,"البدر لا غاب","https://www.poetsgate.com/ViewPoem.aspx?id=147151",""],[5074,"الشراع التائه","https://www.poetsgate.com/ViewPoem.aspx?id=157884",""],[5081,"أَفِقْ قَلْبِي","https://www.poetsgate.com/ViewPoem.aspx?id=187884",""],[5431,"أحبك....أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=199836",""],[5463,"أمانه لا تردّيني","https://www.poetsgate.com/ViewPoem.aspx?id=25291",""],[5495,"بده العام الدراسي (مرثيه لولده حيدر)","https://www.poetsgate.com/ViewPoem.aspx?id=175440",""],[5525,"شكرا صدقت","https://www.poetsgate.com/ViewPoem.aspx?id=919",""],[5533,"يا عُرَاةً من ضَمِيْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=176716",""],[5612,"الطريقُ الصَّعْب","https://www.poetsgate.com/ViewPoem.aspx?id=179789",""],[2546,"تَحَبَّبْ فإنَّ الحبَّ داعية ُ الحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=17526",""],[5776,"إليهم... هم","https://www.poetsgate.com/ViewPoem.aspx?id=199538",""],[5818,"حنانيك يا أماه","https://www.poetsgate.com/ViewPoem.aspx?id=182576",""],[5848,"ولد عمك علشانك تمشكل مع ولد خالك","https://www.poetsgate.com/ViewPoem.aspx?id=48990",""],[5906,"أودعتك الله","https://www.poetsgate.com/ViewPoem.aspx?id=188828",""],[5956,"تحب النساء صفائي","https://www.poetsgate.com/ViewPoem.aspx?id=181879",""],[5956,"الحب المُعَاد","https://www.poetsgate.com/ViewPoem.aspx?id=181934",""],[5956,"تبَسُّمُ عاشقتي","https://www.poetsgate.com/ViewPoem.aspx?id=182048",""],[5956,"حبٌ وصد","https://www.poetsgate.com/ViewPoem.aspx?id=182213",""],[5956,"هكذا العربي الحقيقي أيها العالم","https://www.poetsgate.com/ViewPoem.aspx?id=182880",""],[5956,"السُّيول","https://www.poetsgate.com/ViewPoem.aspx?id=183189",""],[5956,"الفخر بالابن فراس","https://www.poetsgate.com/ViewPoem.aspx?id=192387",""],[5956,"حال البنت قبل الحب وبعده","https://www.poetsgate.com/ViewPoem.aspx?id=197942",""],[5957,"لأنكَ فجريَ الآتي","https://www.poetsgate.com/ViewPoem.aspx?id=176901",""],[5957,"سورة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=213916",""],[6198,"مناديل الشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79294&r=&rc=68",""],[1583,"القبلة الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73011&r=&rc=2",""],[6290,"لَكَ فِي الْأَفْئِدَةِ الْغَرَّاءِ حُبٌّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85517&r=&rc=35",""],[6302,"اشْتِبَاهْ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86226&r=&rc=24",""]],"verses":[["تَحبو الرّياحُ الهُوجُ في أشْواطِهِ","والبَرْقُ يَكْبو خَلْفَهُ إذا عَدا",0,"ا",1,0],["تُحِبُّ اِمرُؤُ القَيسِ القِرى أَن تَنالَهُ","وَتَأَبى مَقارِيها إِذا طَلَعَ النَسرُ",1,"ر",1,0],["تُحِبُّكَ يَومَ عيدِهِمُ النَصارى","وَيَومَ السَبتِ شيعَتُكَ اليَهودُ",2,"د",1,0],["تحبس وفودك والنيران مغمضة","إذا أناخ بجنح الليلة الطفلُ",3,"ل",1,0],["تحبيس آمالي على راحتيْ","سعد التقى والجود والباس",4,"س",1,0],["تحْبوك بدْأتُها بذكْرٍ نابِهٍ","عُقباه إخْمالٌ هو الإخْمادُ",5,"د",1,0],["تَحبُو وتُحْبَى ومالُ ال","كريم جَزْرٌ ومَدُّ",6,"د",1,0],["تحبَّب دهري بالشباب مُلاوةً","فلما أحل الشيبَ رأسي تبغّضا",7,"ض",2,0],["تحبُّ الشكر لا ما كدَّ حرّاً","بل المجرى يُعاقبه المَصامُ",8,"م",1,0],["تحبهم ثم ارزم ثم سالا","فعب اتيه يطأ التلالا",9,"ل",2,1],["تحبك صاحبي منا قلوب","لغيرك ظهرها ولك الصميم",10,"م",1,1],["تَحبو الرَواسِمُ مِن بَعدِ الرَسيمِ بِها","وَتَسأَلُ الأَرضَ عَن أَخفافِها الثَفِنُ",11,"ن",1,0],["تُحِبُّكُمُ نَفسي وَإِن كانَ حُبُّكُم","مَصيبي بِأَهواءِ الأَعادي وَموبِقي",12,"ق",2,0],["تَحِبُّ ولَكِنْ نَفْعُها لمُحبِّها","غَداةَ نَوىً منها وَوَشْكِ زِيالِ",13,"ل",1,0],["تُحبّون الهَوادةَ ما اسْتقاموا","ولستُمْ للقتالِ بكارهينا",14,"ن",2,0],["تُحِبُّ الكبرَ لا ترضَى سِواهُ","على آفاتِه خُلُقاً ودابا",15,"ب",2,0],["تُحِبُّ الوَرى الآدابَ وَهيَ مُضاعَةٌ","فَأَحسَبُها الدُنيا تُلامُ وَتُعشَقُ",16,"ق",1,0],["تَحبِسُ العَينَ عَن مَلَذَّة مرآ","ه وَلَكن تسرّحُ الأَرواحا",17,"ح",2,0],["تُحِبُّني قُلتُ مُجيباً لَهُ","وَفَوقَ ما تَرجو مِنَ الحُبِّ",18,"ب",1,0],["تُحِبُّ حَياتَكَ الدُنيا سَفاهاً","وَما جادَت عَلَيكَ بِما تُحِبُّ",19,"ب",1,0],["تَحَبَّبْ إِلَى الإِخْوَانِ بِالْحِلْمِ تَغْتَنِمْ","مَوَدَّتَهُمْ فَالْحِلْمُ لِلشَّرِّ يَرْحَضُ",20,"ض",1,1],["تُحبُّ الموتَ تغمرُه التحايا","وتأبَى ان تَطيرَ به شَعاعا",21,"ع",2,0],["تحبّني ومتعلّقبي .. وعذوبك..","أنّك تناساني .. ولا احتلت تنساني",22,"ن",2,0],["تحبوه أيدي الريح إن","هبت على قرب وبعد",23,"د",1,0],["تُحِبُّ مِنَ الإِقدامِ ما أَبغَضَ الوَرى","وَتَسلو عَنِ الأَرواحِ وَهيَ حَبائِبُ",24,"ب",1,0],["تحبُّ كما أحبّتك الرعايا","بعدلٍ يخصبُ المرعى الجديبا",25,"ب",2,0],["تُحِبُّهُم قَلبي وَتَبكي غَيرَهُم","إِنَّكَ فيما قُلتَهُ لَمُدَّعِ",26,"ع",1,0],["تُحَبِّسُ أَفواجاً عَلَيهِ سَبِيُّهُم","كَما حُبِسَت في ذي المَجازِ الأَباعِرُ",27,"ر",1,0],["تحبه من فرط خمر الصبا","نشوان هزته كؤوس المدام",28,"م",1,0],["تحبىء تسأل عني ثم تسلمني","قبل السلام إلى كربى وبأسائي",29,"ي",1,0],["تحبُّني حُبّاً شَديداً بِلا","حصرٍ وحبّ الأُخت لا يُحصَرُ",30,"ر",1,0],["تحبو إلى باب استها مثل ما","يحبو ابن عامين إلى الديس",31,"س",1,0],["تُحَبُّ ولكن لا تُحِبُّ لأنها","فتاةٌ لعوبٌ جَمعُها لشتات",32,"ت",1,0],["تَحْبُوكَ مَوْشِيَّ الرِّياضِ وَإِنَّما","تهْدِي الرَّبيعَ إِلى الرّبِيعِ الْمُمْرِعِ",33,"ع",1,0],["تُحِبُّ الهدوءَ وتَرْضى بهِ","ويُعْجِبُها روضُهُ المُعْشِبُ",34,"ب",1,0],["تحبَّبَ بالحسنى إلى النَّاس كلِّهم","ومن جُملة الإحسان أنْ يتحبَّبا",35,"ب",2,0],["تحبّ ما قد كسوْتَني أعيُنُ الر","ائي وهذا أوانُ مُستَمِعِهْ",36,"ع",2,0],["تحَّبب في عذلي ليُبردَ لوعتي","فبغَّضه أن الهوى جمره العذُل",37,"ل",1,0],["تحبِسنا صدورُها والحبُّ في","أعجازها يجذُب مَن تعلَّقا",38,"ق",2,0],["تُحِبُّهُم عُوَّذُ النِساءِ إِذا","أَبدى العَذارى مَواضِعَ الخَدَمِ",39,"م",1,0],["تُحِبُّهُم عُوَّذُ النِساءِ إِذا","ما اِحمَرَّ تَحتَ القَوانِسِ الحَدَقُ",40,"ق",1,0],["تُحِبُّ دنيانا خِسَاسَ الناسِ","ما أشبهَ الأجناسَ بالأَجناسِ",41,"س",1,0],["تحبك ما لها أحببت يوماً","وتبدي للجفا منك احتماله",42,"ل",2,0],["تحب ما أحبه","تنكر ما قد أنكر",43,"ر",1,0],["تحبوه أيدي الريح إن","ولَّتْ على قربٍ وبعد",44,"د",1,0],["تحبُّ رفعَ الحصَى من خُبثِ نيتها","وقد تُحِبُّ انحطاط الأنجم الزُّهُرِ",45,"ر",1,0],["تُحبُّ نفسُك فعلَ الخير وهْي له","ضِد وقدرُك يهوِى في شفا جرف",46,"ف",1,0],["تُحبى بِوَردٍ كَاللُجَينِ مُكَفَّرٍ","مِنها وَوَردٍ كَالعَقيقِ مُخَلَّقِ",47,"ق",1,0],["تُحِبُّ مِن أَجلِهِ الدُنيا وَتورِثُها","وَسَوفَ توبِقُكَ الدُنيا وَتوبِقُهُ",48,"ق",2,0],["تُحبُّ الكُلَّ مالَكَ مِن عَدوٍّ","يَسوءُ قَلىً إِذا اِبتَهَجَ الخَليلُ",49,"ل",1,0],["تُحبُّ البقاءَ تُريدُ الأمانْ","تسيرُ وفي شعرِها وردتانْ",50,"ن",1,1],["تَحْبِيرَهُ وَالخُسْرُوَان الأَعْتَقا","لَمَّا رَأَيْتُ الشَرَّ قَدْ تَأَلَّقا",51,"ق",2,0],["تحببت بالعرفان للأولياء في","مقاماتهم واخترتهم للمحبة",52,"ه",1,0],["تحببت بالغفران للمذنبين يا","ودودو ولم تقطع رجاء لتوبة",52,"ه",1,0],["تحببت بالأرزاق للخلق مطلقاً","فكان بوفق العدل قسم المعيشة",52,"ه",1,0],["تُحِبُّ بالله من يَخصُّكَ بال","سودِّ فما قال لا ولا نعما",53,"م",2,0],["تَحَبَّبَت الدُنيا بِمُلكِ مُحَمَّدٍ","وَكانَت بِمُلكِ المُرتَضى قَد تَقَلَّتِ",54,"ت",1,0],["تُحَبُّ مِن جَعفَرٍ طَلاقَتهُ","وَبَذلُ سَمحِ الأَخلاقِ مَحبوبُ",55,"ب",1,0],["تحببْ لي باسم الودودِ بجودِه","فأثبتَ عندي جوده أنه الله",56,"ل",2,0],["تحب الغاواني في الفتى شيمة الحيا","ويعرضنَ عن مستوقح قد تمردا",57,"د",2,0],["تحبها الناس ولكن إنمشت","كَأَنَّها تَمشي عَلى قُلوبِها",58,"ب",3,0],["تَحَبَّب فَإِنَّ الحُبَّ اعِيَةُ الحُبِّ","وَكَم مِن بَعيدِ الدارِ مُستَوجِبُ القُربِ",59,"ب",1,1],["تُحبُّ النساءَ وتأبى الرجالَ","وتمشي مع الأسفهِ الأطيشِ",60,"ش",1,0],["تحب الماء فوق الأرض حراً","ويبغض طبعها قيدَ الإناء",61,"ا",2,0],["تحب أشعاري الأولادُ تحفظها","حتى تجيء تحييني بأشعاري",62,"ر",2,1],["تحبّك مصر وأبناؤها","وتعرف معنى عُلاك الأُمَم",63,"م",1,0],["تُحِبُّ الثَناءَ وَتَأبى العَطاءَ","وَما تَمَّ ذلِكَ لِلمُعتَضِد",64,"د",1,0],["تحب حسيباً مهجتي وتحب من","يحب حسيباً أفتديه حبيبا",65,"ب",2,0],["تحبو إليهِ كأنّما أرواقُها","بُخْيُ العراقِ دلَحْنَ بالأثقالِ",66,"ل",1,0],["تُحَبُّ فكاهاتي لديهم وَحكمتي","تُجَلُّ وَحالي بينهم كله حالي",67,"ل",2,0],["تحب البقاء ولكنّ ما","تحب هو الموت أو أكبر",68,"ر",1,0],["تحبُّ باللَه من يخصك بالحبِّ","فما قال لا ولا نعما",69,"م",2,0],["تَحبَّبني فَقري فَلَو مَرَّ بي الغِنى","لَما مَرَّ إِلّا في اِحتشامِ المُجانبِ",70,"ب",1,0],["تحبب لي نجداً عروبة أصلكم","واين من المغموس في دجلة نجد",71,"د",1,0],["تحبب أو تذرع أو تأبى","فلا والله لا أزداد حبا",72,"ب",2,1],["تحب الصالحين بزعم قلبك","وتخلو إن فقدتهم بذنبك",73,"ك",1,1],["تحبُ السلام وتخشى الضررْ","وتهوى الكريم وتجفو الضنينْ",74,"ن",1,0],["تُحبُّ الذي لا يَرَاكَ جَدِيرًا","فَيُصْلِيكَ في اليومِ ألفَ احتِراقْ",75,"ق",1,0],["تحبينه وانا احبك .. وحبك في الحشا محفور","بلحظة كنتي الأحلام وصرتي منبع اشجاني",76,"ن",2,0],["تحبنِّي [ لكن ] عزومك تردّت","مآ احتلت في وصلي .. مثل مآانت محتآل .!!",77,"ل",1,0],["تحبين القصيد وأنتِ فيه","فإنّ الشّعر في قرب الخطيب",78,"ب",1,1],["تحبِّينَ منِّي كثيرَ الغموضِ","وقلبِي يحبُّكِ مثلَ النَّدَى",79,"د",2,1],["تحبني : وْبعدين؟","من يعشق الأغراب؟!",80,"ب",1,0],["تحب المصطفى حبا","تحب الصحْب والآلا",81,"ل",2,0],["تحبني حب الصباحي للكويت","واكرهك كره العريفي للغناء",82,"ن",3,0],["تَحْبُو جُفُوْنِيْ عَلَى الأَطْلالِ تَلْمَسُهَا","وَ قَدْ تُسِرُّ الرُّؤى مَا تَعْشَقُ الأُذُنُ",83,"ن",1,0],["تُحِبُّ جَمِيلَةً مِنْ غَيْرِ بَوْحٍ","وَلَا لُقْيَا فَكَيْفَ إِذَاً تَمِيلُ ؟!",84,"ل",1,0],["تحبك يازيت السراج فراشتي","أضئه لها عشقا ودعْها لترتمي !!",85,"م",2,0],["تحبّيني تودّيني إلين أصبح أنا العشقان","وأنام بحضنك الدافي وأحقق باقي أحلامي",86,"م",2,0],["تحب انت اللعب والگبر ملموم","شلون تحملت وشلون صابر",87,"ر",1,0],["تحبنّي؟..ياعلّني بعض ضعفك","قلبي جرادٍ باد ما حصّل العشب",88,"ب",1,0],["تحبني..وأقول من زود لطفك","شكراً صدقت .. وألف شكراً على الكذب",88,"ب",1,0],["تَحْبِسُوْنَ الزَّادَ عَنْهُمْ","في الصَّباحِ والهَجِيْرِ",89,"ر",1,0],["تُحِبُّ بلَوْعةٍ وبلا رجاءٍ","فلا قُرْباً كَسبْتَ ولا سَلوْتا",90,"ت",2,0],["تَحَبَّبْ فإنَّ الحبَّ داعية ُ الحبّ","وكمْ من بعيدِ الدار مستوجبَ القربِ",91,"ب",1,1],["تحبو إليهم دمعة ضمئت","للوصل فاستسقتهم الكرما",92,"م",2,0],["تحبّينني أدري ولكنَّ خافقي","بعيدٌ عَنِ التقويمِ يبتزُّ مَرقبي",93,"ب",2,0],["تحبيني وانا احبك سوى فالحل والترحال","معك من وين ما رحتي كأني اشبه ظلالك",94,"ك",1,0],["تحبو الشهامةُ شوقاً نحوَ مَرعاها","مذ غَيَّبَ الموتُ لَيثاً كانَ يرعاها",95,"ا",3,1],["تحبُّ النساءُ صفائي جميعا","كأنيَ ما زلتُ طفلاً وديعا",96,"ع",2,1],["تحب بعنف جدارا عريضا","ولا تستطيع إليه الطلوعْ",97,"ع",1,1],["تحب التي مستحيل رضاها","ولو قد أذبتَ جميع الشموعْ",97,"ع",1,0],["تحبُّ فتاها كغيثٍ أحبَّ","جميع الحقول يغيث ويمطِرْ",98,"ر",1,0],["تحبّ ولكنْ تصدُّ لتغري","وتزدادَ نارُ الغرام استعارا",99,"ر",2,0],["تحب الدِّينَ أجمعه إذا لم","يكنْ أصحابُه ملأوه زُورا..",100,"ر",2,0],["تحِبّين شِعري وأعشق شَعر","كِ، والشوق أسلاكهُ واقدة",101,"د",2,0],["تحب أمّك حباً لا حدود له","فزدت مجدي وفخري بالفتى الأسدِ",102,"د",1,0],["تحب تحكُّماً فينا","لذا فغرامها بلوى",103,"ل",3,0],["تحبك كل أشعاري","كما تهوى حكاياتي",104,"ت",2,0],["تحبك كانبثاق الفجر روحي","ويهدي النور قلبي حيثُ سارا",105,"ر",2,0],["تحبو كعاشقةٍ... على جدرانها","وتمد شوق غصونها.. لتراك",106,"ك",1,0],["تحبني ... جُهدَ ما تمنّتْ","وتخنق الوهم إِنْ وهمتُ",107,"ت",1,0],["تحبّني جامح التمنِّي","أَنثر في الحبِ ما لممتُ",107,"ت",1,0],["تحْبلُ الأرضُ نعيمًا أبديًّا","ما لهُ قطُّ شبيهٌ في الضُّروعِ",108,"ع",1,0],["تُحبُّ \"فطيرةَ التُّفاحِ\" مثلي..","ومثلي لا تَعيشُ بدونِ قَهوهْ",109,"و",2,1]]}