2,"آن التأهب للرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114779",""],[5442,"نسم آن أن تسري الرفاق إلى الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=114747",""],[5442,"خل دمعي فقد اصاب مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=114777",""],[5463,"وأتأوه آآه تحكي عنها كل الألسنه","https://www.poetsgate.com/ViewPoem.aspx?id=33840",""],[5525,"اللي هجرني","https://www.poetsgate.com/ViewPoem.aspx?id=7254",""],[5642,"مُذكرات طفل سوري","https://www.poetsgate.com/ViewPoem.aspx?id=131268",""],[5660,"ألا فَابْكِ يا عَيْنايَّ ما سَحَّ دَمْعُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=23707",""],[5672,"من بقايا الرثاء...","https://www.poetsgate.com/ViewPoem.aspx?id=206450",""],[5696,"بين الرياء والحياء","https://www.poetsgate.com/ViewPoem.aspx?id=151407",""],[349,"موقف","https://www.poetsgate.com/ViewPoem.aspx?id=146247",""],[5736,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=203805",""],[5943,"أمير الشِّعر قد تاقتْ قلوبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=34483",""],[5956,"اكتهالاتُ الخلايا","https://www.poetsgate.com/ViewPoem.aspx?id=183874",""],[5956,"أحن إلى منزلي في السعودْ","https://www.poetsgate.com/ViewPoem.aspx?id=194599",""],[5956,"دعوتُ للإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=194884",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6028,"هجوعي وتلذاذي على محرم","https://www.poetsgate.com/ViewPoem.aspx?id=127114",""],[6031,"مَعَاهِدُهُمْ بالأبْرقَيْنِ هَوَامِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46280",""],[6152,"أبي ( النداءئ الأبدي)","https://www.poetsgate.com/ViewPoem.aspx?id=203071",""],[520,"قل لابن دخان اذا جئته","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577579",""],[6230,"شريد ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67166&r=&rc=40",""],[6315,"غريبٌ في البلدة ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87580&r=&rc=5",""],[2944,"ابكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86014&r=&rc=3",""]],"verses":[["وَاِبكِ عَنّي فَطالَما كُنتُ مِن قَب","لٍ أُعيرُ الدُموعَ لِلعُشّاقِ",0,"ق",1,0],["وَأَبكي بِعَينٍ يَمتَري عَبَراتِها","تَبَسُّمُ بَرقٍ آخرَ اللَيلِ لائِحِ",1,"ح",1,0],["وَأَبكى هُذَيماً أَرقأَ اللَهُ دَمعَهُ","أَنينيَ حَتىّ أَيقَظَتْ أَنَّتي صَحبي",2,"ب",2,0],["وَأَبكي وَفي الإِعوال لِلصَبِّ راحَةٌ","فَأُطفىءُ ما كانَ التَجَلُّدُ أَوقَدا",3,"د",2,0],["وَأَبكي لِنَفسي رَحمَةً مِن عِتابِها","وَيَبكي مِنَ الهِجرانِ بَعضي عَلى بَعضي",4,"ض",2,0],["وَأَبكي إِذا ما أَذنَبَت خَوفَ صَدِها","وَأَسأَلُها مَرضاتَها وَلَها الذَنبُ",5,"ب",1,0],["وَأَبكي عَلى فَوزٍ بِعَينٍ سَخينَةٍ","وَإِن زَهِدَت فينا نَقولُ سَتَرغَبُ",6,"ب",1,0],["وَأَبكي إِذا فارَقتُ هِندًا صبابَةً","وَأَبكي إِذا فارَقتُ دَعدا عَلى دَعدِ",7,"د",1,0],["وابكوا فتى البأسِ وافتهُ منيَّتهُ","في كلّ نائِبَة ٍ نابَتْ وأقدارِ",8,"ر",1,0],["وابكي المعمَّمَ زينَ القائدينَ اذا","كانَ الرّماحُ لديهمْ خلجَ اشطانِ",9,"ن",1,0],["وَاِبكي أَخاكِ لِخَيلٍ كَالقَطا عُصَباً","فَقَدنَ لَمّا ثَوى سَيباً وَأَنهابا",10,"ب",2,0],["وَاِبكي لِصَخرٍ إِذ ثَوى","بَينَ الضَريحَةِ وَالصَفائِح",11,"ح",1,0],["وَاِبكي لِصَخرٍ إِنَّهُ","شَقَّ الفُؤادَ لِما يُكابِد",12,"د",1,0],["وَاِبكي أَخاً كانَ مَحموداً شَمائِلُهُ","مِثلَ الهِلالِ مُنيراً غَيرَ مَغمورِ",13,"ر",1,0],["وَاِبكي أَخاكِ وَلا تَنسَي شَمائِلَهُ","وَاِبكي أَخاكِ شُجاعاً غَيرَ خَوّارِ",14,"ر",1,0],["وَاِبكي أَخاكِ لِأَيتامٍ وَأَرمَلَةٍ","وَاِبكي أَخاكِ لِحَقِّ الضَيفِ وَالجارِ",14,"ر",1,0],["وَاِبكي أَخاكِ لِدَهرٍ صارَ مُؤتَلِفاً","وَالدَهرُ وَيحَكِ ذو فَجعٍ وَتَجليفِ",15,"ف",1,0],["وَاِبكي لِصَخرٍ طِوالَ الدَهرِ وَاِنتَحِبي","حَتّى تُحُلّي ضَريحاً بَينَ أَجبالِ",16,"ل",1,0],["وَاِبكيهِ لِلطارِقِ المُنتابِ نائِلَهُ","وَفي الحَقيقَةِ وَالإِعطاءِ لِلمالِ",16,"ل",1,0],["وَاِبكيهِ لِلخَيلِ تَحتَ النَقعِ عابِسَةً","كَأَنَّ أَكتافَها عُلَّت بِجِريالِ",16,"ل",1,0],["وَاِبكي مُعاوِيَةَ الفَتى","وَاِبنَ الخَضارِمَةِ القُماقِم",17,"م",1,0],["وأبكي على المجد الذي كان دونه","على رُكبتَيْه الدهر من خشية يجثي",18,"ث",2,0],["وَاِبكي عَلى عُتبَةَ إِذ قَطَّهُ","بِالسَيفِ تَحتَ الرَهَجِ الجائِلِ",19,"ل",1,0],["وأبكي بلفظ من رثاء وأدمع","منظمَ درٍّ تارةً ومنثرا",20,"ر",2,0],["وابك أيامَ حياةٍ","أنت منها في سباق",21,"ق",1,0],["وَأَبكَيتُ مِن عِتبانِ كُلَّ كَريمَةٍ","عَلى فاجِعٍ قامَت مُشَقَّقَةً عُطلا",22,"ل",2,0],["وَأَبكي عَلى عَلوٍ بِعَينٍ سَخينَةٍ","وَإِن زَهِدَت فينا فَإِنّا سَنَرغَبُ",23,"ب",1,0],["وأبكارُها شَتَّى أذيلَ مَصونُها","وريعَت عَذارها كما رُوِّع السِّربُ",24,"ب",1,0],["وَأَبكَيتُ أَجفانَ الصَوارِمِ وَالقَنا","نَجيعاً غَداةَ الكَرِّ في الضَربِ وَالطَعنِ",25,"ن",1,0],["وابكِ جبَّار الليالي","هدّه طول الصراع",26,"ع",1,0],["وَاِبكينَ للأَيتامِ لَمّا أَقحَطوا","وَاِبكينَ عِندَ تَخاذُلِ الجيرانِ",27,"ن",1,0],["وَاِبكينَ مَصرَعَ جيدِهِ مُتَزَمِّلاً","بِدِمائِهِ فَلَذاكَ ما أَبكاني",27,"ن",2,0],["وَأَبكي وَالنُجومُ مُطَلِّعاتٌ","كَأَن لَم تَحوِها عَنّي البِحارُ",28,"ر",1,0],["وأبكي للغرامِ وأنتَ لاهٍ","وأُعذَرُ في الأُوامِ وأنتَ لاحِ",29,"ح",1,0],["وابكِ الكنانةَ إنّ من حُرماتِها","ألا تَجِفَّ الأَدمُعُ الذَّرِفاتُ",30,"ت",1,0],["وَأَبكي الشَرقَ حيناً بَعدَ حينٍ","وَأَندُبُ في مَمالِكِهِ العُقولا",31,"ل",2,0],["وَأَبكاني فَبَلَّ الريحَ دَمعي","ضُحىً فَلِذاكَ قيلَ لَها البَليلُ",32,"ل",1,0],["وَأَبكي مَع القَمريِّ ذي الشَجو بِالضُحى","إِذا هَتَفَ القُمرِيُّ أَو بِالأَصائِلِ",33,"ل",1,0],["وَاِبكِ عَلى مافاتَ مِنها وَلا","تَبكِ عَلى رَبعٍ بِأَوطاسِ",34,"س",1,0],["وَاِبكِ عَلى طائِرٍ رَماهُ فَتىً","لاهٍ فَأوهى بِفِهرِهِ الكَتِفا",35,"ف",2,0],["وَأَبكَيتُماني وَسطَ صَحبي وَلَم أَكُن","أُبالي دُموعَ العَينِ لَو كُنتُ خالِيا",36,"ي",2,0],["وَأَبٌ كَانَ مَعْقِلاً يَلْجَأُ الحُرُّ","إِلَيْهِ وَمَوْئِلاً لِلفَقِيرِ",37,"ر",1,0],["وَاِبكي عَلى عارِضٍ بِالوَدقِ مُحتَفِلٍ","إِذا تَهاوَنَتِ الأَحسابُ رَجّافِ",38,"ف",1,0],["وَابْكِهِ لِلنُّجُوم كَم سَامَرتْهُ","مَالِئاتٍ بِوَحْيها آذَانَهْ",39,"ن",2,0],["وَابْكِ لِلرَّوْضِ وَاصِفاً يَخْجَلُ الرَّوْ","ضُ إذَا هَزَّ بِالْيَرَاعِ بَنَانَهْ",39,"ن",2,0],["وَابْكِهِ لِلْخَيالِ صَفْواً نَقِيّاً","إنَّهُ كانَ في الْوَرَى تَرْجُمَانَه",39,"ن",2,0],["وأبكي ويبكي خيالي معي","نشيدا يباكي الدجا الأبكما",40,"م",2,0],["وأبكي ولكن بكاء الطيور","فيدعوني الشاعر المنشدا",41,"د",2,0],["وأبكى مواسمك العاطرا","ت وأيّامها الغضّة الخرّدا",41,"د",2,0],["وأبكي على علو بعين سخينة","وإن وهدت فينا فإنا سترغب",42,"ب",1,0],["وابك وجد اواحك الغرام سرورا","وانشر الشوق يوم يطوى البعاد",43,"د",1,0],["وأبكاهُ عندَ الفَجْرِ زَجْلُ يمامةٍ","فما عاد عندي في بِعادكمُ وُسعا",44,"ع",2,0],["وَابكِيَا الأَربُعَ الدَّوَارِسَ والأطلاَلَ","والحِقفَ والرُّبَا والرَّسُومَا",45,"م",2,0],["وأبكيها فتضحك ملء فيها","وأسهر وهي في طيب الرقاد",46,"د",1,0],["وأَبكي ولا طوقَ لي بالفراقِ","إذا ذاتُ طَوقٍ بكتْ في فَنَنْ",47,"ن",1,0],["وأَبكي لدرِّ الثّغرِ منكَ ولي أبٌ","فكيفَ يديمُ الضِّحكَ وَهْوَ يَتيمُ",48,"م",1,0],["وأبكيت ابنة الدوح","بشكواك وما يبدو",49,"د",2,0],["وأبكين أعينَ عشّاقِهنّ","دموعاً كَخْلْجَانها في المُدُود",50,"د",1,0],["وَاِبكِياها بِمُقلَتي وَاِسأَلاها","مَن سَقاها ماءَ المَدامِعِ بَعدي",51,"د",2,0],["وأبكي بدمعٍ بل وابله الثرى","على أنَّه ما بلَّ بعضَ غليلي",52,"ل",2,0],["وأبكي لتذكارِ العُذَيبِ وبَارق","وما القصدُ إلا رِيقُهُ والتَّبسُّمُ",53,"م",1,0],["وابكى الليالي الغاديات بقربها","وليس يعين العين غير معينها",54,"ن",3,0],["وابكي على كبدٍ يُفطّرها الهوى","فأساؤها من دَمعِكِ المُترقرق",55,"ق",1,0],["وأبكي عليها آسفاً متشوِّقاً","وآملُ منها أن تَفُكَّ أسيرا",56,"ر",2,0],["وابكي عليها وتوبي بعد معصيةٍ","فاللهُ كانَ على التوّابِ توّابا",57,"ب",2,0],["وابكار بكر يسترقن عقولنا","بسحر عيون ان رنت قتلت عمدا",58,"د",2,0],["وابك المَنازِل بعد الظاعنين دما","ان لم تر الدمع يَقضي عنك ما وجبا",59,"ب",2,0],["وأَبكِي لِشِلْوٍ بالعَرَاءِ كَمَا بَكَى","زِيادٌ لِقَبْرٍ بَيْنَ بُصْرَى وجاسِمِ",60,"م",1,0],["وَأَبكي لَدى باناسَ لِلبَينِ وَالأَسى","وَمِن بَرَدى حُرُّ الفِراقِ دَخيلُ",61,"ل",1,0],["وَأَبكي وَلي صَبرٌ بَكيءٌ قليبُهُ","وَدَمعٌ عَلى الظبى الغَرير غَزيرُ",62,"ر",1,0],["وأَبكي بعينٍ لا تكفُّ غروبُها","وَأَصبو بِقَلبٍ بالغَرام جَريحِ",63,"ح",1,0],["وأَبكَى البَيْنُ شَتّى مِن عُيونٍ","وكان سِوَى مَدامِعيَ البَكايا",64,"ا",3,0],["وأبكارٍ لَهَوتُ بِهنَّ حيناً",