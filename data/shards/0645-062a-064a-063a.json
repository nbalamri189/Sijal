{"poems":[[53,"وما تعدم الدنيا الدنية أهلها","https://www.aldiwan.net/poem65720.html","الطويل"],[53,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[146,"وددت التصابى فيك إذ كان عاذرى","https://www.aldiwan.net/poem58434.html","الطويل"],[234,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[438,"يروع الذئب حيث سواك راع","https://www.aldiwan.net/poem12377.html","الوافر"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61237","الوافر"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61158","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49985","الطويل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67201","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65305","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114234","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136404",""],[6125,"مَتَىٰ يَا لَيلُ تَشرَعُ بالفِرَاقِ","https://www.poetsgate.com/ViewPoem.aspx?id=207932",""]],"verses":[["متى غمرت دنيا أخاها بمائها","فليس وإن أروته غير غريق",0,"ق",1,0],["متى غلبن رجالَ الجدّ في زمنٍ","كما غلبنَ رجالَ اللهو والغزلِ",1,"ل",1,0],["متى غَنت الورقاءُ كانت مدامتى","دموعى وزفراتي حنينَ مَزاهِري",2,"ر",2,0],["مَتى غضِبْتُمْ لنا وأَنْفُسُنا","لِبِيضِكم مُذْ وَلِيتُمُ نفَلَ",3,"ل",1,0],["متى غنَّتْ به نَغَمُ الوَافِي","هَفَتْ طرباً لها نَغَمُ السَّماعِ",4,"ع",1,0],["مَتى غسان قَد ذكرت بِمطل","مَتى عَرفَت بِأَن تَأتي ذَميما",5,"م",2,0],["مَتى غاب عَني ساعة مت دونه","وَأَنَّى لنفس دونه أَن تصبرا",6,"ر",2,0],["متى غالب الدُّنيا من النّاس عاقلٌ","بداهية لم يأت عنها نذيرُها",7,"ر",3,0],["متى غشى نبعةُ الهادي جُموعَهم","جَلا الغياهب منها لمعُ باتِرها",8,"ر",3,0],["متى غاب الدّليلُ عليك فيه","فسوُق التّرك فيه لنا دلاله",9,"ه",1,0],["مَتَى غَرَسَت يُمنَاهُ أفنَانَ أحرُفٍ","فَلاَ ذِهنَ إِلاَّ وَهوَ نَحوَهُ طَائِرُ",10,"ر",1,0],["متى غربت عرا ليلي جنون","وابدل بشر وجهي بالكلوح",11,"ح",1,0],["مَتَىٰ غَفَلَ الرِّعَاءُ فَكُلُّ ذِئبٍ","تَلَصَّصَ مَوطِنِي وسَبَىٰ نِيَاقِي",12,"ق",2,0]]}