{"poems":[[95,"يوسف يا سبط الندى والعلى","https://www.aldiwan.net/poem9776.html","عموديه"],[53,"لقد رأينا عجبا من العجب","https://www.aldiwan.net/poem8315.html","الرجز"],[53,"هجرتني ظلما لتحميل واش","https://www.aldiwan.net/poem64929.html","الخفيف"],[53,"علج إذا قلم أظفاره","https://www.aldiwan.net/poem66759.html","السريع"],[63,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[52,"منيتني بشرا وبشر فتى","https://www.aldiwan.net/poem64884.html","البسيط"],[504,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216887","الخفيف"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45258","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90803","الكامل"]],"verses":[["علجها الدهر لا فنائها","فثبتت شهباً ومر السحاب",0,"ب",1,0],["عِلْجٌ ترقَّى رتبةً فَرُتْبةً","ولم يكن أهلاً لهاتيك الرُّتَبْ",1,"ب",1,0],["عِلجُ سوءٍ يهشُّ للحادر العب","ل العظيم الجرْدانِ أيَّ اهتشاش",2,"ش",1,0],["عِلجٌ إذا قَلَّمَ أظفارَهُ","قَلَّم أيضاً من صَياصِيهِ",3,"ه",1,1],["عِلْجينِ إذ حَنَّ النَّواقِسُ صرَّحا","بالشَّوقِ أو حَنَّا حَنينَ النّابِ",4,"ب",1,0],["عِلجٌ بِعِلجٍ مِن بَني دابِقٍ","صاحِبِ تَقديرٍ وَإِبقاءِ",5,"ا",2,0],["عِلجٌ إِذا ما اِبتَزَّ عَنها ثَوبَها","وَتَخامَصَت قالَت لَهُ ماذا تَرى",6,"ا",1,0],["علجاتٌ شعرُ الفراسنِ والأش","داقِ كلفٌ كأنّها أفهارُ",7,"ر",1,0],["عِلجٌ تَعَصَّبَ ثُمَّ راقَ بِقَوسِهِ","وَالعِلجُ تَعرِفُهُ إِذا يَتَعَمَّمُ",8,"م",1,0],["علج ولكن إن بدا متكلما","تحسبه عجل السامري يخور",9,"ر",1,0]]}