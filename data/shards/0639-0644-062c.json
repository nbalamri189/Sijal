{"poems":[[93,"يوسف يا سبط الندى والعلى","https://www.aldiwan.net/poem9776.html","عموديه"],[51,"لقد رأينا عجبا من العجب","https://www.aldiwan.net/poem8315.html","الرجز"],[51,"هجرتني ظلما لتحميل واش","https://www.aldiwan.net/poem64929.html","الخفيف"],[51,"علج إذا قلم أظفاره","https://www.aldiwan.net/poem66759.html","السريع"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[50,"منيتني بشرا وبشر فتى","https://www.aldiwan.net/poem64884.html","البسيط"],[499,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""]],"verses":[["علجها الدهر لا فنائها","فثبتت شهباً ومر السحاب",0,"ب",1,0],["عِلْجٌ ترقَّى رتبةً فَرُتْبةً","ولم يكن أهلاً لهاتيك الرُّتَبْ",1,"ب",1,0],["عِلجُ سوءٍ يهشُّ للحادر العب","ل العظيم الجرْدانِ أيَّ اهتشاش",2,"ش",1,0],["عِلجٌ إذا قَلَّمَ أظفارَهُ","قَلَّم أيضاً من صَياصِيهِ",3,"ه",1,1],["عِلْجينِ إذ حَنَّ النَّواقِسُ صرَّحا","بالشَّوقِ أو حَنَّا حَنينَ النّابِ",4,"ب",1,0],["عِلجٌ بِعِلجٍ مِن بَني دابِقٍ","صاحِبِ تَقديرٍ وَإِبقاءِ",5,"ا",2,0],["عِلجٌ إِذا ما اِبتَزَّ عَنها ثَوبَها","وَتَخامَصَت قالَت لَهُ ماذا تَرى",6,"ا",1,0]]}