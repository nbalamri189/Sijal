{"poems":[[55,"أيا راكبا ترمي به الليل جسرة","https://www.aldiwan.net/poem29913.html","الطويل"],[55,"تناسيت إلا باقيات من الذكر","https://www.aldiwan.net/poem30441.html","الطويل"],[31,"إني أبيت وهم المرء يعمده","https://www.aldiwan.net/poem6093.html","البسيط"],[87,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[76,"أرقت أكف الدمع طورا وأسفح","https://www.aldiwan.net/poem12887.html","الطويل"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[48,"سأفعل خيرا ما استطعت فلا تقم","https://www.aldiwan.net/poem23082.html","الطويل"],[186,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[193,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[275,"محا لك حسنا مدمع وتسهد","https://www.aldiwan.net/poem35617.html","الطويل"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[422,"هنيت هنيت بالعيد السعيد فقد","https://www.aldiwan.net/poem53830.html","البسيط"],[463,"لها بعد خطو لات حين مراح","https://www.aldiwan.net/poem56257.html","الطويل"],[556,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122562","الهزج"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37870","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93105","الطويل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87937","البسيط"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45386","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100987","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53142","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27813","الرجز"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106907","السريع"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/2","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91050","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205678","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44653","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72754","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139474",""],[4782,"مرافئ الأمنيات","https://www.poetsgate.com/ViewPoem.aspx?id=198688",""],[4119,"لكم من فؤادي ما اباحكم الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=16112",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[5582,"ما لِلْحَمائِمِ لا يَنْفَكُّ نائِحُها","https://www.poetsgate.com/ViewPoem.aspx?id=186834",""],[5616,"قاصمة الظهر","https://www.poetsgate.com/ViewPoem.aspx?id=203429",""],[5751,"كذبةُ سيف","https://www.poetsgate.com/ViewPoem.aspx?id=214773",""],[5956,"تعالوا","https://www.poetsgate.com/ViewPoem.aspx?id=195019",""]],"verses":[["فَما أَتبَعَتهُ نَشطَةٌ مِن حَميمِهِ","وَلا مِن أَراكِ الجَلهَتَينِ سِواكُ",0,"ك",1,0],["فَما أَتَلافى الغَمضَ إِلّا عَلى قَذىً","وَلا أَتَناسى الوَجدَ إِلّا عَلى ذِكرِ",1,"ر",1,0],["فَما أَتَيناكَ حَتّى خالَطَت نَقَباً","أَيدي المَطِيِّ وَحَتّى خَفَّتِ السُفَرُ",2,"ر",1,0],["فما أتمّ قوله","أن ضحكت مصر له",3,"ه",1,0],["فَما أَتَلَقّى الرَكبَ أَرجو تَحِيَّةً","تُوافي لَهُ أَو رُقعَةً تَتَصَفَّحُ",4,"ح",1,0],["فما أتَى الناسُ مِنْ فَرْضٍ وَمِنْ سُنَنٍ","ففِي صَحِيفَتِهِ الغَرَّاءِ مُسْتَطَرُ",5,"ر",1,0],["فَما أَتَمَنّى أَنَّني كَأَجَلِّكُم","ولَكِن أُضاهي المُقتَرينَ الصَعالِكا",6,"ك",2,0],["فَما أَتاني رَسولٌ مِن بَوارِقِها","إلّا جَرَت فَأَجابتهُ مَآقيها",7,"ي",3,0],["فَما أتى في كلامِ الشرعِ مُشتبهاً","لِحكمةِ الفهمِ قد جاءَ النبيُّ بهِ",8,"ب",2,0],["فما أتعسَ النائي المحبَّ الذي يَرى","أحبَّتَهُ تحتَ الثّرى وهو مُفرَد",9,"د",1,0],["فما اتفقت لي مذ عرفتك خلوة","بنفسي إلا همت فيك بجلوة",10,"ه",1,0],["فما أتاك امرؤ يرجوك في أربٍ","إلاَّ وأصبَحَ في نعماك مغمورا",11,"ر",2,0],["فما اتفق السعدان حتى تكافآ","أعزُّ بطونٍ في أعزِّ بِطاحِ",12,"ح",1,0],["فما أتت كفّاكَ من سيّئٍ","يضيقُ عنهُ كرمُ الربِّ",13,"ب",1,0],["فما أتحفَ ما وشَّح","بَل أنعمَ ما دملج",14,"ج",1,0],["فَما أَتى الصُّبحُ إِلّا وَالَّذينَ بقوا","هَذا جَريحٌ وذا بِالأَسرِ مَكبولُ",15,"ل",1,0],["فَما أَتى القائم مِن أَهل اللعب","ذو قُوة ظاهرة إِلا غلب",16,"ب",1,0],["فما اتبعت إلا يعوق ضلالة","كما ابتعت آباؤها قبلها نسرا",17,"ر",2,0],["فما اتت لاختيار الشهم ان خطئت","خارت لئيماً يدنِّيها وينصرفُ",18,"ف",1,0],["فَما اِتَّبَعوا دَليلاً في اِجتِنابي","وَلا سَلَكوا سَبيلاً في اِصطِناعي",19,"ع",2,0],["فما أتم الحديث إلا","وطارقٌ في الظلام ساري",20,"ر",2,0],["فما اتسعت آمالنا وتلفتت","إلى مطلب إلا وجودك أوسع",21,"ع",1,0],["فما أتى من خطأ","فإنه من وهمنا",22,"ن",2,0],["فما أتت هند ولا أرست","عنها اعتذاراً مظهراً للوفا",23,"ف",2,0],["فما أتت هند ولا أرست","عنها اعتذاراً أنها ناسيه",23,"ه",1,0],["فما أتت هند ولا أرست","عنها اعتذاراً نافياً للجفاء",23,"ا",2,0],["فَما أَتلَفَت أَيديهُمُ مِن نُفوسِنا","وَإِن كَرُمَت فَإِنَّنا لا نَنوحُها",24,"ح",3,0],["فَما اتخذت سِواك الدَهر معتمداً","وَما دَهَت عفّتي الأَتراك وَالعرب",25,"ب",1,0],["فما أتمنَّى فيك معنًى أريده","من الحسن إلَّا وافق الحسن آمالي",26,"ل",2,0],["فَما اِتَّعَظوا في مَوقفٍ فيهِ قَد رَأَوا","مَعاهد فيها اللَهُ قَد نوَّرَ العقلا",27,"ل",2,0],["فما أتاه مني قليل","وما أتاني منه كثير",28,"ر",1,0],["فما أتت أنبياء الله قاطبة","إلا لإنبائنا عنهم بأنباءِ",29,"ا",2,0],["فما اتعضَتْ من الماضين روحي","ولا طَهُر الفؤاد من الخطايا",30,"ا",3,0],["فما أتشكى البعد إلا تعرضت","لي الحرة الوجناء والفرس النهد",31,"د",1,0],["فَمَا أَتَيْنَاهُ عَنْ شَوْقٍ لحَاضِرهِ","لَكِنْ أَتَيْنَاهُ مِنْ عَطْفٍ لمَاضِيهِ",32,"ي",2,0],["فَما أَتَتْ قَطُّ بِكْرٌ فِي مَذاهِبِها","مِنَ المَكارِمِ إِلاَّ وَهوَ ناكِحُها",33,"ح",3,0],["فما أتعس الإنسان يحيّا مهمشاً","كمثل حصاة حين تسقط في بئر!",34,"ر",1,0],["فما أتى السيفُ إلاّ في منازفنا","جرياً وآباؤنا ماتوا مِن العتَبِ",35,"ب",1,0],["فما آتاكُم الرحمن عقلاً","سوى كي تسلكوا السُّبُل السّويّةْ",36,"ي",2,0]]}