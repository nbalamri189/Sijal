"https://www.poetsgate.com/ViewPoem.aspx?id=186345",""],[6031,"أوْفاتَّخِذْ لَكَ سِنداناً ومِطْرقَةً","https://www.poetsgate.com/ViewPoem.aspx?id=46347",""],[4442,"أنت والسجن صارم وقراب","https://www.poetsgate.com/ViewPoem.aspx?id=171198",""],[6101,"زمرة الشيطان / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120281",""],[6113,"ان بعض الظن اثم","https://www.poetsgate.com/ViewPoem.aspx?id=26374",""],[6113,"منال .........!!!","https://www.poetsgate.com/ViewPoem.aspx?id=26380",""],[6124,"منك كلي","https://www.poetsgate.com/ViewPoem.aspx?id=128747",""],[6124,"رائحة الأنثى","https://www.poetsgate.com/ViewPoem.aspx?id=159879",""],[4432,"ادكارا بعد ما ولى الشباب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=564221",""],[242,"قل للذي لا ينتهي عن فحشه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563807",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""],[6237,"الليل في الريف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77891&r=&rc=33",""],[6259,"قسماً بوصلك إنَّ بُعد مرامهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59403&r=&rc=51",""],[5126,"سخرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87827&r=&rc=42",""],[572,"وليلة ٍ فيها قَصُرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9293&r=&rc=150",""],[572,"لستُ على عذلِكَ صَبَّارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9316&r=&rc=173",""]],"verses":[["أَوَعيداً يا بَني جُشَمٍ","نَنقُضُ الأَطنابَ وَالحِلَلا",0,"ل",2,1],["أَو عَدَّدا ما في الخِطالِ إِذا","لَتَوادَعا أَبَداً عَلى غِمرِ",1,"ر",1,0],["أَوعى الدُعاءَ فَلَم يُجِبهُ قَطيعَةً","أَم ضَلَّ عَنهُ مِنَ البِعادِ دُعاؤُهُ",2,"ا",3,0],["أو عارَضَها بالبَرْقِ كَبا","أوْ أوْرَدَ عيْنَ الشّمْسِ سَقَى",3,"ق",2,0],["أوْ على مرْجِ حَمامٍ خطْرَةٌ","ما سرَتْ في خاطِري إلا انْجَمَعْ",4,"ع",1,0],["أَو عُدتِ مِن سَقَمِ الهَوى إِنَّ الهَوى","مِمّا يُطيلُ ضَنى الفَتى فَيُعادُ",5,"د",1,0],["أَوْ عِدَةٌ فَاتِنَة لِلنُّهَى","أَوْ هِبَةٌ خَلاَّبَة سَاحِرَهْ",6,"ر",2,0],["أَوْ عَابِراً بِخُطَاهُ","مَجَرَّةً مُنْسَابَهْ",7,"ب",2,0],["أَو عامِرِ بِن طُفَيلٍ في مُرَكَّبِهِ","أَو حارِثٍ يَومَ نادى القَومُ يا حارِ",8,"ر",1,0],["أَو عازِبٍ جادَت عَلى أَرواقِهِ","خَلقاءُ عامِلَةٌ وَرَكضُ نُجومِ",9,"م",1,0],["أَو عاقَ عَن بَعضِ الأُمورِ عائِقُه","أَنبَأَني بِغِلِّهِ حَمالِقُه",10,"ق",2,0],["أو عشت عيشي عند جفوةَ سيدٍ","عوّدت منه ميله ولهاته",11,"ت",2,0],["أو عند مبسمك الغرَّار بارقةٌ","إني بموعد صبري فيه مغرور",12,"ر",1,0],["أو عَجْمُ رمَّانة وقشرتها","بغير ماء لقد خلا عجبُهْ",13,"ب",2,0],["أو عرض الرَّدمُ دون حاجته","أو لقِيَ الليثَ هائجاً كَلَبُهْ",13,"ب",2,0],["أو عُرِّضَتْ بُهَمُ الحروب له","لرحِمْتَ ثمَّ مصارعَ البُهَمِ",14,"م",1,0],["اوعى الفنغراف اصواتا شدوت بها","وسار يضرب اقليما باقليم",15,"م",1,0],["او على ناعم الثرى نتنزى","والثرى للصبيان اقرب ملعب",16,"ب",1,0],["أوعى لأحمد والوليد كليهما","شمم المديح ورقة التشبيب",17,"ب",1,0],["أو عربي شاحبٍ","بأبيضٍ معمم",18,"م",1,0],["أوعَى سخافات الجدو","د وأسقط الحكَم البواهر",19,"ر",1,0],["أَو عُصبَةٌ مِن مُلوكِ ناحِيَةٍ","أَبو شُجاعٍ عَلَيهِمُ واجِد",20,"د",1,0],["أَو عَرَضَت عانَةٌ مُقَزَّعَةٌ","صِدنا بِأُشرى الجِيادِ أولاها",21,"ا",3,0],["أَو عَبَرَت هَجمَةٌ بِنا تُرِكَت","تَكوسُ بَينَ الشُروبِ عَقراها",21,"ا",3,0],["أَو عالَجَ الأَمرَ وَهُوَ مُمتَنِعٌ","تَيَسَّرَت لِاِنحِلالِهِ عُقَدُه",22,"د",2,0],["أَوَعكُ مَنونا صارَ لِلمَوتِ مَورِداً","وَكانَ اِرتِقابُ المَوتِ مِن وَعكِ خَيبَرِ",23,"ر",1,0],["أَو عَدَّدوا صالِحَ الأَيّامِ كاثَرَ أَح","دانَ الفُذوذِ الَّتي عَدّوا بِأَتوامِ",24,"م",1,0],["أَو عاجَ في أَهلِ الفُراتِ فَإِنَّهُ","سَيُقالُ جاءَهُمُ فُراتٌ ثانِ",25,"ن",1,0],["أَو عانَةٍ يَبِسَت مَراتِعُها","خَبَطَت سَفا القُريانِ وَالظَهرِ",26,"ر",1,0],["أو عابدا من بني المجوس إذا","توهم الكأس شعلة سجدا",27,"د",2,0],["أَو عُيونَ الأُسدِ موصَدَةً","في ذُرى غابٍ مِنَ القَصَبِ",28,"ب",1,0],["أو على برقِ سماءٍ ضاحكٍ","غيمُهُ بالدّمْع منه منسكِب",29,"ب",1,0],["أَو عَلى الصَدر يَستوي فَوقَ عَر","شين مَكيناً مُؤيداً سُلطانُهُ",30,"ه",1,0],["أَو عاسِلٍ كَالشُجاعِ هاجَ لِيَ ال","نَفسَ وَدِرعٍ كَأَنَّها الزَبَدُ",31,"د",1,0],["أو عن جِلادٍ وفُرسانٍ ومعركَةٍ","وصَولَجانٍ وشاهينٍ وبازِيّ",32,"ي",1,0],["أَو عَن وَجارِ ضَبُعٍ أَو ذيبِ","يَعلو الإِكامَ في ذُرى الكَثيبِ",33,"ب",1,0],["أَوعَدتَني بِالقَتلِ مِن غَيرِ ما","جُرمٍ وَقَلبي رَهنُ كَفَّيكا",34,"ك",2,1],["أَو عَينُ تَسنيمٍ وَشا","بَ طَعمَهُ السَلسَبيلُ",35,"ل",1,0],["أَو عَضَّةٌ في ذِراعِها وَلَها","فَوقَ ذِراعي مِن عَضِّها أَثَرُ",36,"ر",1,1],["أَوعِد وَعِد سَوفَ يَأتي بَعدَنا زَمَنٌ","كَأَنَّنا فيهِ لَم نوعِد وَلَم نَعِدِ",37,"د",1,0],["أَوعَزَ الدَهرُ بِالفَناءِ إِلى النا","سِ فَواهاً لِذَلِكَ الإيعازِ",38,"ز",1,1],["أَو عُمِّرَ الشَيخُ عُمرَ النَسرِ مِن شُهُبٍ","لا مِن ذَواتِ جَناحٍ لَم يَقُل بَجَلِ",39,"ل",1,0],["أو عصاها حوتُ النّجومِ سَقَاهُ","حَتْفَهُ صائِدٌ مِن الحِدْثانِ",40,"ن",1,0],["أوعِدوني أو عِدوني وامطُلوا","حُكْمٌ دين الحُبّ دَينُ الحبّ لَيْ",41,"ي",1,0],["أو عبرة ذرفتها","عينٌ شجاها الوداع",42,"ع",1,0],["أَو عَلى التاج درة أَو سِراجُ","مُستَنير كالكوكب الوقادِ",43,"د",1,0],["أو عرضت عانةٌ مفزّعةٌ","صدنا بأخرى الجياد أولاها",44,"ا",3,0],["أو عاَد هُوميرٌ وسحْرُ غنائهِ","ورأى مَلاحمَهم وكيفَ تُثارُ",45,"ر",1,0],["أو عمَلُ الكُفْرِ مَن يُدينُ به","في البَعْثِ إبَّانَ مَجْمَعِ الأُمَم",46,"م",1,0],["أَوْ عسْكَرٌ ركِبُوا الخُيُو","لَ الشُّهْبَ واحْتَقَرُوا الأَداهِمْ",47,"م",1,0],["أَوْ عَبْقَرِيَّةِ مُخْرِجِ الدُّ","رِّ النَّقِيِّ مِنَ المِدَادْ",48,"د",1,0],["أَوْ عَوْدُ هَمْلِتَ وَالقَضَاءُ رَمَي بِهِ","فأَصَابَ مُهْجَةَ عَمهِ المِطْمَاعِ",49,"ع",1,0],["أو عهدنا تاجاً على مَفْرِقِ الشم","س يُشِعُّ الإيمانُ من خَرَزاتهْ",50,"ت",2,0],["أو على من رام أن يحيا كما","يتمنَّى الحرُّ ذنبٌ أو جُناحْ",51,"ح",1,0],["أو على العاني مَلامٌ إنْ رنَا","بعدَ عشرينَ لإطلاقِ السَراح",51,"ح",1,0],["او عابث ٍ من فِلَسطينٍ ومحنتِها","ألفى مَعيناً ، فالقى الدَلوَ وانتزَعا",52,"ع",2,0],["او عائشونَ على الهوامشِ مثلَما","يَنفي فُضولَ الصورةِ الرِسّام",53,"م",1,0],["أوَعَدْتَني يَوْمَ الخَميسِ، وَقَد مَضَى","مِنْ بَعْدِ مَوْعِدِكَ الخَميسُ الخامسُ",54,"س",1,0],["أوْ عادَ - مَنْ يدري - إلى أولادِهِ","يَوماً تَذكَّرَ صُورتي فَبكاني",55,"ن",2,0],["أَوعَدتُمُ إِبِلي كَلّاً سَيَمنَعُها","بَنو غَزِيَّةَ لا ميلٌ وَلا عورُ",56,"ر",1,0],["أَو عاشِقٍ وَصَلَ المَعشوقُ هَجرَتَهُ","مُستَيقِظاً وَهوَ وَصّالٌ إِذا هَجَدا",57,"د",2,0],["أَو عايَنَت ذا الجودَ سُعدى وَاِبنُها","أَوسٌ لَوَدَّت أَن تَكونَ عَقيما",58,"م",2,0],["أَوْ عِقْدَ دُرٍّ وَهَتْ مَعاقِدُهُ","عَلى عَقيقٍ في صَرْحِ بَلُّورِ",59,"ر",1,0],["أو عِمّةً من حِدادٍ لم تَعُمَّ ولم","تَسْتُر قَلَنْسُوةَ حَمْرا من الذَّهب",60,"ب",1,0],["أو علق عشق مليح في تصنّعه","للعاشقين مليح القدّ والقدمِ",61,"م",1,0],["أو علّه يرثي فقد","أمسى بحالك منك أعلم",62,"م",1,0],["أو عسى تُدرِكُ فيها النفسُ ما","تَبتغيهِ من أمانٍ ورِغاب",63,"ب",1,0],["أو عَساها تَبلغُ القصدَ الذي","عَمِيَت عنهُ وَقَد يَعمى الشَباب",63,"ب",1,0],["أو عسى أن أنال ما أتمنّى","فألاقي مفتاح باب الأماني",64,"ن",2,0],["أوعدُ غد يا قلب يصدق ليته","ليبرؤ من داء الجفاء عليل",65,"ل",1,0],["أو عين جمع جاء كالمفاعل","من بعد واو أو يا كالأوائل",66,"ل",1,0],["او عناقيدَ أَنضَجَتها شُموس الحُبِّ","في عالَمِ الخَيالِ الرَفيع",67,"ع",1,0],["أو عيشنا بالحمى في حسن رونقه","ووشك بين على الأحباب مقدور",68,"ر",1,0],["أَو عُدتُ مَغبوناً فَما أَنا في الهَوى","لَكُمُ بِأَوَّلِ عاشِقٍ مَغبونِ",69,"ن",1,0],["أَوْ عَضْبَ عَمْرٍوذَا الصَّرَا","مَةِ يَوْمَ فَارِسَإِذْ تَجَرَّدْ",70,"د",1,0],["أَوْ عَرْفُ نَارِ عَدِيٍّ بَاتَ يَرْقُبُهَا","وَفِي نَوِاجِذِهَا الْهِنْدِيُّ وَالْغَارُ",71,"ر",1,0],["أَوْ عَاذِلٍ لَيْسَتْ تَلِينُ قَنَاتُهُ","جَاثٍ عَلَى كُرْسِيِّ الصَّوَابِ وَعَرْشِهِ",72,"ش",2,0],["أَوْ عَالِمٍ طَلَعَتْ شُمُوسُ عُلُومِهِ","مِنْ تَحْتِ كُرْسِيِّ الْوِفَاقِ وَعَرْشِهِ",72,"ش",2,0],["أَوْ عَابِدٍ يًنْضِي مَطِيَّةَ لَيْلِهِ","وَنَهَارِهِ حَادِي النَّشَاطِ بِكَدْشِهِ",72,"ش",2,0],["أو عتّقت لهم الخمور شهية","(مشتاقة تسعى إلى مشتاق)",73,"ق",1,0],["أَو عاقَني عَن قصد طيبة عائق","فَهنا معارف لا تذم فعالا",74,"ل",2,0],["أو عطرت يوماً مقالة مادح","لغدا مقالي للغوالي مخوضا",75,"ض",2,0],["أو عقد درٍّ وَهى من نحرٍ غانيةٍ","أو منتحى أَكرٍ يرمي بها الطاحي",76,"ح",2,0],["أو عارف متمكن متحقق","في الكش