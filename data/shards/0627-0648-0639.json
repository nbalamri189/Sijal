{"poems":[[53,"أوعيدا يا بني جشم","https://www.aldiwan.net/poem29868.html","المديد"],[53,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[53,"أترى السحاب إذا سرت عشراؤه","https://www.aldiwan.net/poem30778.html","الكامل"],[77,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[77,"خدع الشوق فؤادي فانخدع","https://www.aldiwan.net/poem35986.html","الرمل"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[93,"ويح الفقيرات الجميلات من","https://www.aldiwan.net/poem11136.html","السريع"],[93,"ما باله ما أصابه","https://www.aldiwan.net/poem11149.html","المجتث"],[27,"حيوا المقام وحيوا ساكن الدار","https://www.aldiwan.net/poem5782.html","البسيط"],[4,"سفها عذلت وقلت غير مليم","https://www.aldiwan.net/poem21199.html","الكامل"],[47,"أشاقك الطيف ألم طارقه","https://www.aldiwan.net/poem25220.html","الرجز"],[72,"بث المشيب على الشجي بزاته","https://www.aldiwan.net/poem18390.html","الكامل"],[72,"يا شاهر اللحظ حبي فيك مشهور","https://www.aldiwan.net/poem18695.html","البسيط"],[51,"لي خادم لا أزال أحتسبه","https://www.aldiwan.net/poem8303.html","المنسرح"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[89,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[89,"اذكري إذ كنا صغيرين نلعب","https://www.aldiwan.net/poem44865.html","الخفيف"],[85,"قالوا حبيب أنت تطرى شعره","https://www.aldiwan.net/poem7591.html","الكامل"],[85,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[85,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[43,"أزائر يا خيال أم عائد","https://www.aldiwan.net/poem9559.html","المنسرح"],[43,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[45,"رنو ذاك الغزال أو غيده","https://www.aldiwan.net/poem63505.html","المنسرح"],[45,"أراني متى أبغ الصبابة أقدر","https://www.aldiwan.net/poem63635.html","الطويل"],[45,"نصيب عينيك من سح وتسجام","https://www.aldiwan.net/poem66640.html","البسيط"],[45,"ألا شعرت برحلة الأظعان","https://www.aldiwan.net/poem66685.html","الكامل"],[28,"طرقت نوار ودون مطرقها","https://www.aldiwan.net/poem5126.html","الكامل"],[61,"إبريقنا عاكف على قدح","https://www.aldiwan.net/poem51302.html","المنسرح"],[66,"جلت الظلماء بللهب","https://www.aldiwan.net/poem40672.html","المديد"],[80,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[52,"وقد ألاقي بأس العداة على","https://www.aldiwan.net/poem27132.html","المنسرح"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[48,"يا رب خرق نازح حديب","https://www.aldiwan.net/poem62452.html","الرجز"],[48,"أوعدتني بالقتل من غير ما","https://www.aldiwan.net/poem64470.html","البسيط"],[48,"يا من جداه قليل","https://www.aldiwan.net/poem65017.html","المجتث"],[50,"أو عضة في ذراعها ولها","https://www.aldiwan.net/poem62398.html","المنسرح"],[46,"نفس قد استودعت جسما إلى أمد","https://www.aldiwan.net/poem22463.html","البسيط"],[46,"أوعز الدهر بالفناء إلى النا","https://www.aldiwan.net/poem22773.html","الخفيف"],[46,"يا خاطري لا توجه وجه سيئة","https://www.aldiwan.net/poem23220.html","البسيط"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85486","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141033",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39612","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16686","المنسرح"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54719","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55017","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54246","الرمل"],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[45,"شَوْقٌ لَهُ، بَينَ الأضَالِعِ، هاجسُ","https://www.poetsgate.com/ViewPoem.aspx?id=31153",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["أَوَعيداً يا بَني جُشَمٍ","نَنقُضُ الأَطنابَ وَالحِلَلا",0,"ل",2,1],["أَو عَدَّدا ما في الخِطالِ إِذا","لَتَوادَعا أَبَداً عَلى غِمرِ",1,"ر",1,0],["أَوعى الدُعاءَ فَلَم يُجِبهُ قَطيعَةً","أَم ضَلَّ عَنهُ مِنَ البِعادِ دُعاؤُهُ",2,"ا",3,0],["أو عارَضَها بالبَرْقِ كَبا","أوْ أوْرَدَ عيْنَ الشّمْسِ سَقَى",3,"ق",2,0],["أوْ على مرْجِ حَمامٍ خطْرَةٌ","ما سرَتْ في خاطِري إلا انْجَمَعْ",4,"ع",1,0],["أَو عُدتِ مِن سَقَمِ الهَوى إِنَّ الهَوى","مِمّا يُطيلُ ضَنى الفَتى فَيُعادُ",5,"د",1,0],["أَوْ عِدَةٌ فَاتِنَة لِلنُّهَى","أَوْ هِبَةٌ خَلاَّبَة سَاحِرَهْ",6,"ر",2,0],["أَوْ عَابِراً بِخُطَاهُ","مَجَرَّةً مُنْسَابَهْ",7,"ب",2,0],["أَو عامِرِ بِن طُفَيلٍ في مُرَكَّبِهِ","أَو حارِثٍ يَومَ نادى القَومُ يا حارِ",8,"ر",1,0],["أَو عازِبٍ جادَت عَلى أَرواقِهِ","خَلقاءُ عامِلَةٌ وَرَكضُ نُجومِ",9,"م",1,0],["أَو عاقَ عَن بَعضِ الأُمورِ عائِقُه","أَنبَأَني بِغِلِّهِ حَمالِقُه",10,"ق",2,0],["أو عشت عيشي عند جفوةَ سيدٍ","عوّدت منه ميله ولهاته",11,"ت",2,0],["أو عند مبسمك الغرَّار بارقةٌ","إني بموعد صبري فيه مغرور",12,"ر",1,0],["أو عَجْمُ رمَّانة وقشرتها","بغير ماء لقد خلا عجبُهْ",13,"ب",2,0],["أو عرض الرَّدمُ دون حاجته","أو لقِيَ الليثَ هائجاً كَلَبُهْ",13,"ب",2,0],["أو عُرِّضَتْ بُهَمُ الحروب له","لرحِمْتَ ثمَّ مصارعَ البُهَمِ",14,"م",1,0],["اوعى الفنغراف اصواتا شدوت بها","وسار يضرب اقليما باقليم",15,"م",1,0],["او على ناعم الثرى نتنزى","والثرى للصبيان اقرب ملعب",16,"ب",1,0],["أوعى لأحمد والوليد كليهما","شمم المديح ورقة التشبيب",17,"ب",1,0],["أو عربي شاحبٍ","بأبيضٍ معمم",18,"م",1,0],["أوعَى سخافات الجدو","د وأسقط الحكَم البواهر",19,"ر",1,0],["أَو عُصبَةٌ مِن مُلوكِ ناحِيَةٍ","أَبو شُجاعٍ عَلَيهِمُ واجِد",20,"د",1,0],["أَو عَرَضَت عانَةٌ مُقَزَّعَةٌ","صِدنا بِأُشرى الجِيادِ أولاها",21,"ا",3,0],["أَو عَبَرَت هَجمَةٌ بِنا تُرِكَت","تَكوسُ بَينَ الشُروبِ عَقراها",21,"ا",3,0],["أَو عالَجَ الأَمرَ وَهُوَ مُمتَنِعٌ","تَيَسَّرَت لِاِنحِلالِهِ عُقَدُه",22,"د",2,0],["أَوَعكُ مَنونا صارَ لِلمَوتِ مَورِداً","وَكانَ اِرتِقابُ المَوتِ مِن وَعكِ خَيبَرِ",23,"ر",1,0],["أَو عَدَّدوا صالِحَ الأَيّامِ كاثَرَ أَح","دانَ الفُذوذِ الَّتي عَدّوا بِأَتوامِ",24,"م",1,0],["أَو عاجَ في أَهلِ الفُراتِ فَإِنَّهُ","سَيُقالُ جاءَهُمُ فُراتٌ ثانِ",25,"ن",1,0],["أَو عانَةٍ يَبِسَت مَراتِعُها","خَبَطَت سَفا القُريانِ وَالظَهرِ",26,"ر",1,0],["أو عابدا من بني المجوس إذا","توهم الكأس شعلة سجدا",27,"د",2,0],["أَو عُيونَ الأُسدِ موصَدَةً","في ذُرى غابٍ مِنَ القَصَبِ",28,"ب",1,0],["أو على برقِ سماءٍ ضاحكٍ","غيمُهُ بالدّمْع منه منسكِب",29,"ب",1,0],["أَو عَلى الصَدر يَستوي فَوقَ عَر","شين مَكيناً مُؤيداً سُلطانُهُ",30,"ه",1,0],["أَو عاسِلٍ كَالشُجاعِ هاجَ لِيَ ال","نَفسَ وَدِرعٍ كَأَنَّها الزَبَدُ",31,"د",1,0],["أو عن جِلادٍ وفُرسانٍ ومعركَةٍ","وصَولَجانٍ وشاهينٍ وبازِيّ",32,"ي",1,0],["أَو عَن وَجارِ ضَبُعٍ أَو ذيبِ","يَعلو الإِكامَ في ذُرى الكَثيبِ",33,"ب",1,0],["أَوعَدتَني بِالقَتلِ مِن غَيرِ ما","جُرمٍ وَقَلبي رَهنُ كَفَّيكا",34,"ك",2,1],["أَو عَينُ تَسنيمٍ وَشا","بَ طَعمَهُ السَلسَبيلُ",35,"ل",1,0],["أَو عَضَّةٌ في ذِراعِها وَلَها","فَوقَ ذِراعي مِن عَضِّها أَثَرُ",36,"ر",1,1],["أَوعِد وَعِد سَوفَ يَأتي بَعدَنا زَمَنٌ","كَأَنَّنا فيهِ لَم نوعِد وَلَم نَعِدِ",37,"د",1,0],["أَوعَزَ الدَهرُ بِالفَناءِ إِلى النا","سِ فَواهاً لِذَلِكَ الإيعازِ",38,"ز",1,1],["أَو عُمِّرَ الشَيخُ عُمرَ النَسرِ مِن شُهُبٍ","لا مِن ذَواتِ جَناحٍ لَم يَقُل بَجَلِ",39,"ل",1,0],["أو عصاها حوتُ النّجومِ سَقَاهُ","حَتْفَهُ صائِدٌ مِن الحِدْثانِ",40,"ن",1,0],["أوعِدوني أو عِدوني وامطُلوا","حُكْمٌ دين الحُبّ دَينُ الحبّ لَيْ",41,"ي",1,0],["أو عبرة ذرفتها","عينٌ شجاها الوداع",42,"ع",1,0],["أَو عَلى التاج درة أَو سِراجُ","مُستَنير كالكوكب الوقادِ",43,"د",1,0],["أو عرضت عانةٌ مفزّعةٌ","صدنا بأخرى الجياد أولاها",44,"ا",3,0],["أو عاَد هُوميرٌ وسحْرُ غنائهِ","ورأى مَلاحمَهم وكيفَ تُثارُ",45,"ر",1,0],["أو عمَلُ الكُفْرِ مَن يُدينُ به","في البَعْثِ إبَّانَ مَجْمَعِ الأُمَم",46,"م",1,0],["أَوْ عسْكَرٌ ركِبُوا الخُيُو","لَ الشُّهْبَ واحْتَقَرُوا الأَداهِمْ",47,"م",1,0],["أَوْ عَبْقَرِيَّةِ مُخْرِجِ الدُّ","رِّ النَّقِيِّ مِنَ المِدَادْ",48,"د",1,0],["أَوْ عَوْدُ هَمْلِتَ وَالقَضَاءُ رَمَي بِهِ","فأَصَابَ مُهْجَةَ عَمهِ المِطْمَاعِ",49,"ع",1,0],["أو عهدنا تاجاً على مَفْرِقِ الشم","س يُشِعُّ الإيمانُ من خَرَزاتهْ",50,"ت",2,0],["أو على من رام أن يحيا كما","يتمنَّى الحرُّ ذنبٌ أو جُناحْ",51,"ح",1,0],["أو على العاني مَلامٌ إنْ رنَا","بعدَ عشرينَ لإطلاقِ السَراح",51,"ح",1,0],["او عابث ٍ من فِلَسطينٍ ومحنتِها","ألفى مَعيناً ، فالقى الدَلوَ وانتزَعا",52,"ع",2,0],["او عائشونَ على الهوامشِ مثلَما","يَنفي فُضولَ الصورةِ الرِسّام",53,"م",1,0],["أوَعَدْتَني يَوْمَ الخَميسِ، وَقَد مَضَى","مِنْ بَعْدِ مَوْعِدِكَ الخَميسُ الخامسُ",54,"س",1,0],["أوْ عادَ - مَنْ يدري - إلى أولادِهِ","يَوماً تَذكَّرَ صُورتي فَبكاني",55,"ن",2,0]]}