{"poems":[[29,"قد قرب الحي إذ هاجوا لإصعاد","https://www.aldiwan.net/poem5728.html","البسيط"],[107,"الحكم إنصاف وحسن سياسة","https://www.aldiwan.net/poem43374.html","الكامل"],[534,"الله در فتى علا","https://www.aldiwan.net/poem37451.html","مجزوء الكامل"],[1075,"","https://poetry.dctabudhabi.ae/diwan/poem/200324","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49989","الكامل"]],"verses":[["اللَهُ دَمَّرَ عَبّاداً وَشيعَتَهُ","عاداتُ رَبِّكَ في أَمثالِ عَبّادِ",0,"د",1,0],["اللَهُ دَمَّرَ مُلكَهُ وَرَمى بِهِ","في جَوفِ أَكدَرَ يَقذِفُ التَيّارا",1,"ر",2,0],["الله در فتى علا","وعلت على الناس جدوده",2,"د",2,1],["الله در فوارس من تغلب","خضبوا الأسنة من فوارس جحدر",3,"ر",1,1],["الله دَرُّ الشاعرَين فإنّهم","بانوا العُلى وَصياقل الأعْراضِ",4,"ض",1,0]]}