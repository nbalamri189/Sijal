net/poem9875.html","الرمل"],[500,"الغيب صف مواكبه","https://www.aldiwan.net/poem37562.html","مجزوء الكامل"],[500,"يا آخذا وسط الشآم","https://www.aldiwan.net/poem37633.html","مجزوء الكامل"],[500,"ته غراما فللغرام رجال","https://www.aldiwan.net/poem37808.html","الخفيف"],[500,"روح القلب تارة بالمباح","https://www.aldiwan.net/poem38040.html","الخفيف"],[500,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[515,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[529,"هل إلى وصل من هويت سبيل","https://www.aldiwan.net/poem37274.html","الخفيف"],[551,"يا حامل الكأس ناولني مشعشعة","https://www.aldiwan.net/poem47138.html","البسيط"],[551,"قل لعيني لا تملا الدموعا","https://www.aldiwan.net/poem47711.html","الخفيف"],[551,"لا تكشفن عيوب الناس ما استترت","https://www.aldiwan.net/poem47782.html","البسيط"],[553,"لم أصح من لذة لا لا ولا طرب","https://www.aldiwan.net/poem68405.html","البسيط"],[553,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[558,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[558,"إنما نحن ربنا في شئونه","https://www.aldiwan.net/poem33689.html","المديد"],[558,"لا تكن إلا لمولاك أنا","https://www.aldiwan.net/poem33718.html","الرمل"],[558,"إنما رزقك الذي حزته في","https://www.aldiwan.net/poem34288.html","الخفيف"],[558,"أنا بالله عارف","https://www.aldiwan.net/poem34348.html","مجزوء الخفيف"],[558,"انظر الكون خارجا من وجوده","https://www.aldiwan.net/poem34563.html","الخفيف"],[558,"اذبح النفس بسيف الإجتهاد","https://www.aldiwan.net/poem34629.html","الرمل"],[558,"إنني إن أمت فما أنا ميت","https://www.aldiwan.net/poem34725.html","الخفيف"],[564,"أيها اللاحي رويداً","https://www.aldiwan.net/poem882.html",""],[575,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[575,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"]],"verses":[["لا تَكسَعِ الشَولَ بِأَغبارِها","إِنَّكَ لا تَدري مَنِ الناتِجُ",0,"ج",1,0],["لا تَكلَمَن عِرضَ ابنِ عَمِّكَ ظالِماً","فَإِذا فَعَلتَ فَعِرضُكَ المَكلومُ",1,"م",1,0],["لا تُكْثِرُوا من مَواليكُم فإنّ لهم","مَطامِعاً بَسَماتُ الضَّعفِ تُخفيها",2,"ي",3,0],["لا تَكفُرَن قَوماً عَزَزتَ بِعِزِّهِم","أَبا عَلقَمٍ وَالكُفرُ بالريقِ مُشرِقُ",3,"ق",1,1],["لا تَكذِبَنَّ فَإِنَّ المَوتَ مُختَرِمٌ","كُلَّ البَرِيَّةِ غَيرَ الواحِدِ الباقي",4,"ق",2,0],["لا تَكسِرَنَّ رَغيفَهُ","إِن كُنتَ تَرغَبُ في كَلامِه",5,"م",2,0],["لا تكتفوا بافتخار في أوائلكم","فنشوة الخمر لا تغني عن العنب",6,"ب",1,0],["لا تكن تابعاً هوى النفس فيما","أنت فيه تقرّر الأحكاما",7,"م",2,0],["لا تُكثِرَنَّ إِذا جَعَلتَ تَلومُني","لا يَذهَبَنَّ بِحِلمِكَ الإِكثارُ",8,"ر",1,0],["لا تكذب القول إن قالت قطا صدقت","إذ كل ذي نسبة لا بد منتحلُ",9,"ل",1,1],["لا تكسرنَّ إناءً","ملآنةً بولائِك",10,"ك",1,0],["لا تكذبنَّ فإن لُؤمكَ ناصلٌ","كنُصولِ تلك اللِّمّةِ الشمطاءِ",11,"ا",2,0],["لا تكوننَّ كالذي نبذ النَّص","ل مُعَرَّىً وهَزَّ للحرب غمدا",12,"د",2,0],["لا تُكذبنَّ فما وجدي بمفقودِ","يوم الفراق ولا صبري بموْجُودِ",13,"د",1,1],["لا تكوننَّ من أطاع هواهُ","وطغى إذ أطاعه المقدار",14,"ر",1,0],["لا تكفُرنَّ اللَّهَ نعمتَهُ","فيه فَيُسْقِطَ حظَّك الكفرُ",15,"ر",1,0],["لا تكن ممَّنْ أمَرَّتْ كفُّهُ","حبل ودٍّ ثم ثنَّى فنقض",16,"ض",1,0],["لا تكن كالدهر في أفعاله","كلما أعطى عطاياه فجع",17,"ع",1,0],["لا تكثرن ملامة العشاقِ","فكفاهم بالوجد والأشواقِ",18,"ق",1,1],["لا تُكذَبنَّ فما لذي نفرٍ","فيها حريمٌ غيرُ مُنتهك",19,"ك",1,0],["لا تكُفّي عنه أو ين","ظُر في أمْري وأمْرِك",20,"ك",1,0],["لا تكُنْ حسرةً عليَّ فقدْ أو","سعتَ هذا الأنام غيريَ فضلا",21,"ل",2,0],["لا تكن عارضاً رجوتُ حياهُ","فغدا مُرسِلاً عليّ سيولهْ",22,"ل",2,0],["لا تَكَرَّهْ مَواعظي لكريه الْ","حَقِّ فيها فإنها بستان",23,"ن",1,0],["لا تكن مولىً هواه في الأذى","لم يزل بالعبد حتى فتنه",24,"ن",2,0],["لا تُكاتم بالذي أوليتني","إنَّ ما أسررت منه قد علن",25,"ن",1,0],["لا تَكرَهوا شَرّاً يُصيبُكُمُ","فَلَرُبَّ خَيرٍ جاءَ مِن شَرِّ",26,"ر",1,0],["لا تكون الأشياء خيراً على العل","لاتِ مما قد كانت الأشياء",27,"ا",2,1],["لا تكوني مغرورة انما مثلك","في اجواز الفضاء الوف",28,"ف",1,0],["لا تكن في الحياة مختلف اللو","ن كذوبا ان لم تكن صديقا",29,"ق",2,0],["لا تكن ماقتا لخمر تسلى","من هموم الحياة حتى تذوقا",29,"ق",2,0],["لا تكون الحياة في كل وقت","للألى يرغبون فيها متاعا",30,"ع",2,0],["لا تكتمي الوجد فالجرحان من شجن","ولا الصبابةَ فالدمعان من واد",31,"د",1,0],["لا تكونوا السيل جهما خشنا","كلما عب وكونوا السلسبيل",32,"ل",1,0],["لا تَكثُرُ الأَمواتُ كَثرَةُ قِلَّةٍ","إِلّا إِذا شَقِيَت بِكَ الأَحياءُ",33,"ا",2,0],["لا تَكذِبَنَّ فَما الصِبا بِمُخَلَّفٍ","فينا وَلا زَمَنُ الصِبا بِمُعادِ",34,"د",1,0],["لا تَكذُبَنَّ فَما الدُنيا بِراجِعَةٍ","مافاتَ مِن لَذَّةِ الدُنيا وَما سَلَفا",35,"ف",2,0],["لا تَكَنَنَّ إِلى الخُطوبِ فَإِنَّها","لُمَعٌ تَسُرُّكَ تارَةً وَتَسوكا",36,"ك",2,0],["لا تَكلِفَنَّ لي الدُموعَ فَإِنَّ لي","دَمعاً يَتِمُّ عَلَيهِ إِن لَم يَفضُلِ",37,"ل",1,0],["لا تَكذِبنَّ فلو جاز الفِداءُ لها","من الحديدِ فدَاها الناسُ بالمُقلِ",38,"ل",1,0],["لا تُكْذِبنِّي فإني في مدائحِكم","مُصَدَّقُ القَوْلِ لا أستحسِنُ الكَذِبا",39,"ب",2,0],["لا تَكرَهِ المَكروهَ عِندَ نُزولِهِ","إِنَّ المَكارِهَ لَم تَزَل مُتَبايِنَه",40,"ه",1,1],["لا تَكذِبَنَّ فَإِنَّهُ","مَن يَجتَمِع يَتَفَرَّقِ",41,"ق",1,0],["لا تَكذِبَنَّ فَلَو قَدِ اِحتُفِرَ الحَشا","بَطَلَ اِحتِيالُكَ عِندَهُ وَرُقاكا",42,"ك",2,0],["لاتَكُ في كُلِّ هَواً تَنهَمِك","وَلا تَكونَنَّ لَجوجاً مَحِك",43,"ك",1,1],["لا تُكذَبَنَّ فَإِنَّني","لَكَ ناصِحٌ لا تُكذَبَنَّه",44,"ن",2,1],["لا تُكذَبَنَّ فَإِنَّ الناسَ مُذ خُلِقوا","عَن رَغبَةٍ يُعظِمونَ الناسَ أَو فَرقِ",45,"ق",1,0],["لا تَكُن طالِباً لِما في يَدِ النا","سِ فَيَزوَرَّ عَن لِقاكَ الصَديقُ",46,"ق",1,1],["لا تَكُن أَنتَ وَالزَمانُ عَلى عَب","دِكَ بِالبَينِ وَالجَفا أَعوانا",47,"ن",2,1],["لا تَكُن ناسِياً لِعَهدي فَإِنّي","لَستُ ما عِشتُ لِلعُهودِ بِناسي",48,"ي",1,0],["لا تَكُن خائِفاً سِوى اللَهِ شَيئاً","إِنَّها مِن شَواهِدِ التَوحيدِ",49,"د",1,0],["لا تكتُمي في الصدر أسرارا","وتحدثي كيف الأسى شاءَ",50,"ا",2,0],["لا تَكلنِي لذلك الأبَدِ الأَس","وَدِ في قاعِ مُزبِدِ اللُج قاتم",51,"م",1,0],["لا تَكلنِي لِهُوَّةٍ تعصِفُ ا