{"poems":[[6,"يا أيها المزمع ثم انثنى","https://www.aldiwan.net/poem382.html",""],[42,"حسدوا الفتى إذ لم ينالوا سعيه","https://www.aldiwan.net/poem50221.html","الكامل"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[35,"لا تكفرن قوما عززت بعزهم","https://www.aldiwan.net/poem39129.html","الطويل"],[10,"يا عين جودي بدمع منك مهراق","https://www.aldiwan.net/poem21117.html","البسيط"],[54,"استبق ود أبي","https://www.aldiwan.net/poem27372.html","مجزوء الكامل"],[88,"مني إلى مصر ذات المجد والحسب","https://www.aldiwan.net/poem44801.html","البسيط"],[88,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[27,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[37,"لا تكذب القول إن قالت قطا صدقت","https://www.aldiwan.net/poem7324.html","البسيط"],[72,"مولاي رفقا بصب","https://www.aldiwan.net/poem18222.html","المجتث"],[51,"يا أيها الرجل المدلس نفسه","https://www.aldiwan.net/poem7947.html","الكامل"],[51,"يا أبا أحمد ومثلك لا يغفل","https://www.aldiwan.net/poem61894.html","الخفيف"],[51,"لا تكذبن فما وجدي بمفقود","https://www.aldiwan.net/poem61911.html","البسيط"],[51,"إن خيرا من أن ترى في أن قد","https://www.aldiwan.net/poem62989.html","الخفيف"],[51,"إنفاق أيام الحياة على","https://www.aldiwan.net/poem64031.html","أحذ الكامل"],[51,"يا أبا نصر وما للمرء في","https://www.aldiwan.net/poem64966.html","الرمل"],[51,"يا أبا سهل نثاك المستمع","https://www.aldiwan.net/poem65379.html","الرمل"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[51,"سبحان مجري الفلك والفلك","https://www.aldiwan.net/poem65811.html","أحذ الكامل"],[51,"بيهقي مزدقي","https://www.aldiwan.net/poem65819.html","مجزوء الرمل"],[51,"لاح شيب فنهنه الحلم جهلا","https://www.aldiwan.net/poem65914.html","الخفيف"],[51,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[51,"أيها المتحفي بحول وعور","https://www.aldiwan.net/poem66402.html","الخفيف"],[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[51,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[91,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[89,"لا تكون الأشياء خيرا على العللات","https://www.aldiwan.net/poem44685.html","الخفيف"],[89,"أنا يا شمس ذرة فوق أرض","https://www.aldiwan.net/poem44693.html","الخفيف"],[89,"افتحوا للفتى الهضيم الطريقا","https://www.aldiwan.net/poem44844.html","الخفيف"],[89,"ذهبت ايام الشباب سراعا","https://www.aldiwan.net/poem44894.html","الخفيف"],[85,"بي مثل ما بك يا قمرية الوادى","https://www.aldiwan.net/poem6813.html","البسيط"],[85,"حبذا الساحة والظل الظليل","https://www.aldiwan.net/poem7103.html","الرمل"],[43,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[45,"حقا أقول لقد تبلت فؤادي","https://www.aldiwan.net/poem63504.html","الكامل"],[45,"إستقبلا الركب في أطلالهم وقفا","https://www.aldiwan.net/poem65170.html","البسيط"],[45,"أأخي نهنه دمعك المسفوكا","https://www.aldiwan.net/poem65223.html","الكامل"],[45,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[61,"حمى الأمير أمان الخائف الوجل","https://www.aldiwan.net/poem51471.html","البسيط"],[61,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[58,"لا تكره المكروه عند نزوله","https://www.aldiwan.net/poem30847.html","الكامل"],[49,"انظر إلى نفسك يا شقي","https://www.aldiwan.net/poem62189.html","مجزوء الكامل"],[49,"ما لي رأيتك راكبا لهواكا","https://www.aldiwan.net/poem62207.html","الكامل"],[49,"لاتك في كل هوا تنهمك","https://www.aldiwan.net/poem63039.html","السريع"],[49,"لا تكذبن فإنني","https://www.aldiwan.net/poem63170.html","مجزوء الكامل"],[49,"ما من صديق وإن تمت مودته","https://www.aldiwan.net/poem64254.html","البسيط"],[66,"لا تكن طالبا لما في يد النا","https://www.aldiwan.net/poem38587.html","الخفيف"],[66,"لا تكن أنت والزمان على عبدك","https://www.aldiwan.net/poem38719.html","الخفيف"],[66,"طمعي في لقاك بعد إياس","https://www.aldiwan.net/poem40639.html","الخفيف"],[66,"زوج الماء بابنة العنقود","https://www.aldiwan.net/poem40987.html","الخفيف"],[97,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[97,"أنا وحدي في البيد حيران هائم","https://www.aldiwan.net/poem24927.html","الخفيف"],[44,"أنضيت في هذا الأنام تجاربي","https://www.aldiwan.net/poem30064.html","الكامل"],[44,"أراك أكبرت إدماني على الدمن","https://www.aldiwan.net/poem30331.html","البسيط"],[44,"وثناياك إنها إغريض","https://www.aldiwan.net/poem30475.html","الخفيف"],[69,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[69,"لا تكن لائمي إذا اهتز عطفي","https://www.aldiwan.net/poem29002.html","الخفيف"],[105,"من يمنع الليث أن يعتز أو يثبا","https://www.aldiwan.net/poem43386.html","البسيط"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[67,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[48,"لمن الديار تسربلت ببلاها","https://www.aldiwan.net/poem66196.html","الكامل"],[50,"لقبيح في الناس من غير جرم","https://www.aldiwan.net/poem24454.html","الخفيف"],[50,"يا خليلي أصيبا أو ذرا","https://www.aldiwan.net/poem62387.html","الوافر"],[50,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[50,"يا صاح كلني إلى بيضاء معطار","https://www.aldiwan.net/poem63826.html","البسيط"],[50,"راجعت دينك أم عنت لك الذكر","https://www.aldiwan.net/poem63829.html","البسيط"],[50,"يا ابنة الخير عدينا موعدا","https://www.aldiwan.net/poem63924.html","الرمل"],[50,"اشفعي لي صريم عند الكنود","https://www.aldiwan.net/poem63937.html","الخفيف"],[50,"يا خليلي أسعدا","https://www.aldiwan.net/poem63945.html","مجزوء الخفيف"],[50,"قل لسعدى تحرجي","https://www.aldiwan.net/poem63989.html","مجزوء الخفيف"],[50,"هام قلبي باللواتي","https://www.aldiwan.net/poem64733.html","مجزوء الرمل"],[50,"آب ليلي بعد السلو بعتب","https://www.aldiwan.net/poem64827.html","الخفيف"],[50,"أفد الرحيل وحثني صحبي","https://www.aldiwan.net/poem64845.html","الكامل"],[50,"منع النوم طارق من حبابه","https://www.aldiwan.net/poem64856.html","الخفيف"],[46,"لا تكذبن فإن فعلت فلا تقل","https://www.aldiwan.net/poem22136.html","الكامل"],[46,"لا تكرموا جسدي إذا ما حل بي","https://www.aldiwan.net/poem22495.html","الكامل"],[46,"أف لما نحن فيه من عنت","https://www.aldiwan.net/poem22856.html","المنسرح"],[46,"لا تكوني روادة هزاله","https://www.aldiwan.net/poem23189.html","الخفيف"],[68,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85389","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85434","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85335","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20988","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42498","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54875","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/871","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[50,"يا خليلَيَّ أَصِيبا أو ذَرَا","https://www.poetsgate.com/ViewPoem.aspx?id=30844",""],[50,"يا ابنة الخير عدينا موعدا","https://www.poetsgate.com/ViewPoem.aspx?id=21786",""],[90,"النفثة!","https://www.poetsgate.com/ViewPoem.aspx?id=179076",""],[45,"هل أنت مصطبر على مضض الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=31300",""],[45,"لا تكمل اللذات إلا","https://www.poetsgate.com/ViewPoem.aspx?id=31164",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[51,"إنما يبكي شجيُّ شَجَنَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=30804",""],[97,"زازا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63558&r=&rc=104",""],[85,"بي مثلُ ما بكِ ياقمريَّة َ الوادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9670&r=&rc=160",""]],"verses":[["لا تَكسَعِ الشَولَ بِأَغبارِها","إِنَّكَ لا تَدري مَنِ الناتِجُ",0,"ج",1,0],["لا تَكلَمَن عِرضَ ابنِ عَمِّكَ ظالِماً","فَإِذا فَعَلتَ فَعِرضُكَ المَكلومُ",1,"م",1,0],["لا تُكْثِرُوا من مَواليكُم فإنّ لهم","مَطامِعاً بَسَماتُ الضَّعفِ تُخفيها",2,"ي",3,0],["لا تَكفُرَن قَوماً عَزَزتَ بِعِزِّهِم","أَبا عَلقَمٍ وَالكُفرُ بالريقِ مُشرِقُ",3,"ق",1,1],["لا تَكذِبَنَّ فَإِنَّ المَوتَ مُختَرِمٌ","كُلَّ البَرِيَّةِ غَيرَ الواحِدِ الباقي",4,"ق",2,0],["لا تَكسِرَنَّ رَغيفَهُ","إِن كُنتَ تَرغَبُ في كَلامِه",5,"م",2,0],["لا تكتفوا بافتخار في أوائلكم","فنشوة الخمر لا تغني عن العنب",6,"ب",1,0],["لا تكن تابعاً هوى النفس فيما","أنت فيه تقرّر الأحكاما",7,"م",2,0],["لا تُكثِرَنَّ إِذا جَعَلتَ تَلومُني","لا يَذهَبَنَّ بِحِلمِكَ الإِكثارُ",8,"ر",1,0],["لا تكذب القول إن قالت قطا صدقت","إذ كل ذي نسبة لا بد منتحلُ",9,"ل",1,1],["لا تكسرنَّ إناءً","ملآنةً بولائِك",10,"ك",1,0],["لا تكذبنَّ فإن لُؤمكَ ناصلٌ","كنُصولِ تلك اللِّمّةِ الشمطاءِ",11,"ا",2,0],["لا تكوننَّ كالذي نبذ النَّص","ل مُعَرَّىً وهَزَّ للحرب غمدا",12,"د",2,0],["لا تُكذبنَّ فما وجدي بمفقودِ","يوم الفراق ولا صبري بموْجُودِ",13,"د",1,1],["لا تكوننَّ من أطاع هواهُ","وطغى إذ أطاعه المقدار",14,"ر",1,0],["لا تكفُرنَّ اللَّهَ نعمتَهُ","فيه فَيُسْقِطَ حظَّك الكفرُ",15,"ر",1,0],["لا تكن ممَّنْ أمَرَّتْ كفُّهُ","حبل ودٍّ ثم ثنَّى فنقض",16,"ض",1,0],["لا تكن كالدهر في أفعاله","كلما أعطى عطاياه فجع",17,"ع",1,0],["لا تكثرن ملامة العشاقِ","فكفاهم بالوجد والأشواقِ",18,"ق",1,1],["لا تُكذَبنَّ فما لذي نفرٍ","فيها حريمٌ غيرُ مُنتهك",19,"ك",1,0],["لا تكُفّي عنه أو ين","ظُر في أمْري وأمْرِك",20,"ك",1,0],["لا تكُنْ حسرةً عليَّ فقدْ أو","سعتَ هذا الأنام غيريَ فضلا",21,"ل",2,0],["لا تكن عارضاً رجوتُ حياهُ","فغدا مُرسِلاً عليّ سيولهْ",22,"ل",2,0],["لا تَكَرَّهْ مَواعظي لكريه الْ","حَقِّ فيها فإنها بستان",23,"ن",1,0],["لا تكن مولىً هواه في الأذى","لم يزل بالعبد حتى فتنه",24,"ن",2,0],["لا تُكاتم بالذي أوليتني","إنَّ ما أسررت منه قد علن",25,"ن",1,0],["لا تَكرَهوا شَرّاً يُصيبُكُمُ","فَلَرُبَّ خَيرٍ جاءَ مِن شَرِّ",26,"ر",1,0],["لا تكون الأشياء خيراً على العل","لاتِ مما قد كانت الأشياء",27,"ا",2,1],["لا تكوني مغرورة انما مثلك","في اجواز الفضاء الوف",28,"ف",1,0],["لا تكن في الحياة مختلف اللو","ن كذوبا ان لم تكن صديقا",29,"ق",2,0],["لا تكن ماقتا لخمر تسلى","من هموم الحياة حتى تذوقا",29,"ق",2,0],["لا تكون الحياة في كل وقت","للألى يرغبون فيها متاعا",30,"ع",2,0],["لا تكتمي الوجد فالجرحان من شجن","ولا الصبابةَ فالدمعان من واد",31,"د",1,0],["لا تكونوا السيل جهما خشنا","كلما عب وكونوا السلسبيل",32,"ل",1,0],["لا تَكثُرُ الأَمواتُ كَثرَةُ قِلَّةٍ","إِلّا إِذا شَقِيَت بِكَ الأَحياءُ",33,"ا",2,0],["لا تَكذِبَنَّ فَما الصِبا بِمُخَلَّفٍ","فينا وَلا زَمَنُ الصِبا بِمُعادِ",34,"د",1,0],["لا تَكذُبَنَّ فَما الدُنيا بِراجِعَةٍ","مافاتَ مِن لَذَّةِ الدُنيا وَما سَلَفا",35,"ف",2,0],["لا تَكَنَنَّ إِلى الخُطوبِ فَإِنَّها","لُمَعٌ تَسُرُّكَ تارَةً وَتَسوكا",36,"ك",2,0],["لا تَكلِفَنَّ لي الدُموعَ فَإِنَّ لي","دَمعاً يَتِمُّ عَلَيهِ إِن لَم يَفضُلِ",37,"ل",1,0],["لا تَكذِبنَّ فلو جاز الفِداءُ لها","من الحديدِ فدَاها الناسُ بالمُقلِ",38,"ل",1,0],["لا تُكْذِبنِّي فإني في مدائحِكم","مُصَدَّقُ القَوْلِ لا أستحسِنُ الكَذِبا",39,"ب",2,0],["لا تَكرَهِ المَكروهَ عِندَ نُزولِهِ","إِنَّ المَكارِهَ لَم تَزَل مُتَبايِنَه",40,"ه",1,1],["لا تَكذِبَنَّ فَإِنَّهُ","مَن يَجتَمِع يَتَفَرَّقِ",41,"ق",1,0],["لا تَكذِبَنَّ فَلَو قَدِ اِحتُفِرَ الحَشا","بَطَلَ اِحتِيالُكَ عِندَهُ وَرُقاكا",42,"ك",2,0],["لاتَكُ في كُلِّ هَواً تَنهَمِك","وَلا تَكونَنَّ لَجوجاً مَحِك",43,"ك",1,1],["لا تُكذَبَنَّ فَإِنَّني","لَكَ ناصِحٌ لا تُكذَبَنَّه",44,"ن",2,1],["لا تُكذَبَنَّ فَإِنَّ الناسَ مُذ خُلِقوا","عَن رَغبَةٍ يُعظِمونَ الناسَ أَو فَرقِ",45,"ق",1,0],["لا تَكُن طالِباً لِما في يَدِ النا","سِ فَيَزوَرَّ عَن لِقاكَ الصَديقُ",46,"ق",1,1],["لا تَكُن أَنتَ وَالزَمانُ عَلى عَب","دِكَ بِالبَينِ وَالجَفا أَعوانا",47,"ن",2,1],["لا تَكُن ناسِياً لِعَهدي فَإِنّي","لَستُ ما عِشتُ لِلعُهودِ بِناسي",48,"ي",1,0],["لا تَكُن خائِفاً سِوى اللَهِ شَيئاً","إِنَّها مِن شَواهِدِ التَوحيدِ",49,"د",1,0],["لا تكتُمي في الصدر أسرارا","وتحدثي كيف الأسى شاءَ",50,"ا",2,0],["لا تَكلنِي لذلك الأبَدِ الأَس","وَدِ في قاعِ مُزبِدِ اللُج قاتم",51,"م",1,0],["لا تَكلنِي لِهُوَّةٍ تعصِفُ الأش","باحُ في جَوفِها وتَعوي السَّمائم",51,"م",1,0],["لا تَكلَفَنَّ وَأَرضُ وَجهِكَ صَخرَةٌ","في غَيرِ مَنفَعَةٍ مؤونَةَ حاجِبِ",52,"ب",1,0],["لا تُكثِرَنَّ مَلامي إِن عَكَفتُ عَلى","رَبعِ الحَبيبِ فَلَم أَعكُف عَلى وَثَنِ",53,"ن",1,0],["لا تَكُن لي وَلَن تَكونَ كَقَومٍ","عودُهُم حينَ يُعجَمونَ رَفيضُ",54,"ض",1,0],["لا تكثرنْ ضحكاً فكمْ مِنْ ضاحكٍ","أكفانُهُ في قبضةِ القصّارِ",55,"ر",1,0],["لا تكنْ لائمي إذا اهتزَّ عطفي","من سماعي لكلِّ معنى نظيمِ",56,"م",1,1],["لا تَكتُموا الحَقَّ وَاِرضوا عَن خَليفَتِكُم","وَاِقضوا لَهُ مِن حُقوقِ البِرِّ ما وَجَبا",57,"ب",2,0],["لا تُكَذِّبْ إنَّ اليَهُودَ وقد زا","غُوا عن الحقِّ مَعْشَرٌ لُؤَماءُ",58,"ا",2,0],["لا تكَذِّبْ خَبَراً أنَّ سَلْمَى","سَحَبَتْ بالتُّرْبِ ذَيْلا فَطابا",59,"ب",2,0],["لا تَكِلنِي إلى سِواكَ فَأخْيَا","رُ زَماني لا يَمْنَحُونَ خِيَارَهْ",60,"ر",2,0],["لا تُكذَبَنَّ فكُلُّ ما حُدِّثْتَ مِن","خَبرٍ يَسُرُّ فإنّهُ منحول",61,"ل",1,0],["لا تَكذِبَنَّ فَما أَراكَ بِمُنتَهٍ","عَنها وَإِن كَلَّفتَ أَن تَشناها",62,"ا",3,0],["لا تَكُن كَالحِمارِ إِذ طَلَبَ القِر","نَ لِنَفعٍ فَضَيَّعَ الأُذُنَين",63,"ن",1,0],["لا تَكونا كَاِمرِئٍ صاحَبتُهُ","يَترُكُ العَينَ وَيَبغي الأَثَرا",64,"ر",2,0],["لا تَكونا عَلَيَّ كَالخَفَضِ الرَي","يِضِ أَمسى بِنورِهِ غَيرَ نورِ",65,"ر",1,0],["لا تَكوِني إِنَّ قَلبي لَو تُعاتِبُهُ","عَن حُبِّ عَبدَةَ كَالمَكوِيِّ بِالنارِ",66,"ر",1,0],["لا تُكثِروا لَومَ مَشغوفٍ بِجارِيَةٍ","لا يَشتَكي سَهَراً مِنها وَما السَهَرُ",67,"ر",1,0],["لا تَكوني كَاِمرِئٍ فارَقتُهُ","يَقفَأُ الرادِهُ الرَدِهُ يَرعى رَغَدى",68,"د",2,0],["لا تَكوني لِذاّ وَذاكَ فَإِنّي","لَستُ عِندَ الذَوّاقِ بِالمَوجودِ",69,"د",1,0],["لا تَكونا كَعَجرَدٍ","لَعَنَ اللَهُ عَجرَدا",70,"د",2,0],["لا تَكوني بِما ضَمِن","تِ لِذي الزادِ أَنفَدا",70,"د",2,0],["لا تَكوني كَبارِقٍ","لَيسَ في بَرقِهِ نَدى",70,"د",2,0],["لا تَكوني عَلَيَّ كَال","نَفسِ إِن تُنهَ تَلجُجِ",71,"ج",1,0],["لا تَكوني مِثلَ أُخرى","تَتَجَنّى جَفَواتي",72,"ي",1,0],["لا تَكُن لي الحَياةُ إِن لَم تَكُن لي","شَربَةٌ مِن رُضابِها غَيرَ غَصبِ",73,"ب",1,0],["لا تُكثِرِنَّ بِشَيبَتي عَجَباً","إِنَّ العَجائِبَ في أَبي حَربِ",74,"ب",1,0],["لا تَكوني كَمَن يَقولُ وَلا يو","في كَذاكَ المَلّاقَةُ الخَلّابَه",75,"ب",2,0],["لا تَكذِبَنَّ فَإِن فَعَلتَ فَلا تَقُل","كَذِباً عَلى رَبِّ السَماءِ تَكَسُّبا",76,"ب",2,1],["لا تُكرِموا جَسَدي إِذا ما حَلَّ بي","رَيبُ المَنونِ فَلا فَضيلَةَ لِلجَسَد",77,"د",1,1],["لا تَكُ ثِقلاً عَلى جَليسِكَ في ال","قَومِ فَكَم آكِلِ ثَنى فَقَلَس",78,"س",1,0],["لا تَكوني رَوّادَةً هَزّالَه","وَاِحذَري مِن نَوائِبٍ جَزّالَه",79,"ه",1,1],["لا تَكِلْنِي إلى قُوَى جَلَدٍ خا","نَ فإنّي أَصْبَحْتُ من ضُعَفَاكَا",80,"ك",2,0],["لا تكونا عليَّ فظَّين في قب","ري فإني شيخٌ بعطفٍ جدير",81,"ر",1,0],["لا تكن قاسياً عليَّ كثيراً","أنا شيخ مهدَّمٌ مأطور",81,"ر",1,0],["لا تَكتمي عني مغبة أَحمَدٍ","أَلَهُ بسوءٍ يا رباب أَصابوا",82,"ب",3,0],["لا تَكُن في وجه الرَشيد عبوساً","فَهوَ في وجه ضيفه بسام",83,"م",1,0],["لا تكثرنَّ من الخضم توغلاً","فأَخاف أَن يجتاحك التيار",84,"ر",1,0],["لا تَكُونَنَّ كآسي عَظمِه","بأَسَىً حتَّى إذا العَظمُ جَبَر",85,"ر",1,0],["لا تَكِلْنِي إِلَى الصُّدُودِ فَحَسْبِي","لَوْعَةٌ لا تُقِلُّها الأَحْشَاءُ",86,"ا",2,0],["لا تَكَادُ الأَعْلامُ بَعْدَ الخَطْ","بِ حَتَّى تُنَكَّسَ الأَعْلامُ",87,"م",1,0],["لاَ تكْسِرُ الْجَفْنَ إِلاَّ","وَقَلْبُ صَبٍّ كَسِيرُ",88,"ر",1,0],["لاَ تكْتَفِي بِالمَالِ لكِنَّهَا","تُعْطِي مِن الصِّحةِ مَا يُذْخَرُ",89,"ر",1,0],["لا تَكذِبَن مَن غالَبَ ال","أَيّامَ كانَ لَها الغَلَب",90,"ب",1,0],["لا تُكذَبِنَّ فَأَنتِ أَلطَفُ في الحَشا","عَهداً وَأَحسَنُ في الضَميرِ وَأَجمَلُ",91,"ل",1,0],["لا تكونا كامرىء صاحبتُه","يترك العَيْنَ ويَبْغِي الأَثرا",92,"ر",2,0],["لا تَكُوني كامْرِىء ٍ فارقْتُهُ","يقفأ الراده يرعى رغدى",93,"د",2,0],["لا تك مهما اسطعت رِخو الجماح","واستنزلِ الدهرَّ على الإقتراح",94,"ح",1,0],["لا تكذبن، فما أمارات النوى","للصب إلا من أمارات الردى",95,"د",2,0],["لا تكمل اللذات إلا","بالقيان وبالخمور",96,"ر",1,1],["لا تُكذِّب مَخيلة ً لك أضحتْ","يخطفُ الطرفَ لمعُها كلَّ خطفِ",97,"ف",1,0],["لا تكون مولى هواه في الأذى","لم يزل بالعبد حتى فتنه",98,"ن",2,0],["لا تكلْني إلى جناحِ عُقابٍ","في ضلوعي محَلِّق الرعبِ جاثمْ",99,"م",1,0],["لا تكلْني لضائع في حنايا","ها غريب في مهمهٍ من طلاسمْ",99,"م",1,0],["لاتكتمي الوجدَ ، فالجرحانِ من شجنٍ","ولا الصببابة َ ، فالدمعان من وادِ",100,"د",1,0]]}