ْ","يخطفُ الطرفَ لمعُها كلَّ خطفِ",99,"ف",1,0],["لا تكون مولى هواه في الأذى","لم يزل بالعبد حتى فتنه",100,"ن",2,0],["لا تكلْني إلى جناحِ عُقابٍ","في ضلوعي محَلِّق الرعبِ جاثمْ",101,"م",1,0],["لا تكلْني لضائع في حنايا","ها غريب في مهمهٍ من طلاسمْ",101,"م",1,0],["لاتكتمي الوجدَ ، فالجرحانِ من شجنٍ","ولا الصببابة َ ، فالدمعان من وادِ",102,"د",1,0],["لا تكنْ فظّاً غليظَ القلب","ينقض من حَوْلك أهلٌ وخَوَلْ",103,"ل",1,0],["لا تكررْ ذكرى حبيب بعيدٍ","في مغيب بدَا له أو حُضورِ",104,"ر",1,0],["لا تُكْثِرُوا من زرعه وتنكَّبوا","عن حرثه يا أيها البُصَرَاءُ",105,"ا",2,0],["لاَ تَكُن مُشفِقاً عَلَيهَا أفِيهَا","غَرَضٌ بَعدَ أن وَصَلَت عُلاَهَا",106,"ا",3,0],["لاَ تَكُن بَاعِثاً قَرِيضاً مَرِيضاً","شِيبَ لَحناً وشِينَ لَفظاً وضِيمَا",107,"م",2,0],["لا تُكَفِفَا الدَّمعَ حَتَّى تُجرِيَاهُ دَماً","حَقُّ الدُّمُوعِ بِرَبعِ الرِّيعِ أَن تَكِفَا",108,"ف",2,0],["لاَ تَكُن آخِذاً رَوِيِّىِ تَبُوعاً","فِيهِ لِى فالمُجِيدُ غَيرُ تَبُوعِ",109,"ع",1,0],["لا تكوني جمرات دائما","فأنا الشرب الحيّ والنديم",110,"م",1,0],["لاتكاد العيون تبصر فيها","قط غصناً يهفو إليه النسيمُ",111,"م",1,1],["لا تكن ليناً فترمي بضعف","لا ولا جافياً فترمي بكبرِ",112,"ر",1,0],["لا تكذُبنَّ فهذا الشخصُ من نفرٍ","لم يخلُق اللهُ منهم غيرَ آحادِ",113,"د",1,0],["لا تُكذَبَنَّ فَلَيسَتِ الأَشعارُ لي","حَتّى تُنَكِّبَ عَن سِواكَ وَتَصدِفا",114,"ف",2,0],["لا تَكذَبَنَّ فَما أَمامَكَ غايَةٌ","فَاِنظُر مَلِيّاً هَل تَرى مُتَقَدَّما",115,"م",2,0],["لاَ تُكْثِرُوا عَذْلاً وَلا لَوْمَا","لَمْ يُبْقِ حَرُّ الهَجْرِ لِي نَوْمَا",116,"م",2,1],["لا تكتفي بسواك فيهم إنه","ما كل زجر منه باغ ينزجر",117,"ر",1,0],["لا تُكثِري مِن مَقالاتٍ تزيدُ ضَنىً","ما الخَطُّ أُمّي وَلا وادي الحَساءِ أَبي",118,"ب",2,0],["لا تَكِلْ لذةً إلى التسويفِ","وانتهزْها بالفعل قبلَ الصُّروفِ",119,"ف",1,1],["لا تكثر اللوم فيما أنت جاهله","كم عاذل وهو متحاج إلى عذل",120,"ل",1,0],["لا تكذبُ العينُ عمّا في سرائرهِ","ويكذب اللفظ عمّا في سرائره",121,"ر",2,0],["لا تكشفنّ سفيها عن مقاولة","وكن وقورا فخير الدر راسبه",122,"ب",2,0],["لا تُكبِروا من ملاح المرد إنسانا","ما 