َدَ ما رميت من الخدورِ",151,"ر",1,0],["لا تكن ذا خُرق","تر أليم التعب",152,"ب",1,0],["لا تكن كالسَقط","أو جنين السِقط",152,"ط",1,0],["لا تكن كالحُقِّ","في ادخار الذهب",152,"ب",1,0],["لا تك ممن يستفزه والهلع","أو يزدهيه بيدقٌ من الطمع",153,"ع",1,0],["لا تُكثِري هُزءاً وَلا تَعجَبي","فَلَيسَ بِالشَيبِ عَلى المَرءِ عار",154,"ر",1,0],["لا تكثِّر تَزويقَها وَترفَّق","عَن قَليلٍ يَكونُ قَبرُك فيها",155,"ه",2,0],["لا تكن واثقاً بمن كظم الغي","ظ اغتيالاً وخف غرار الغرور",156,"ر",1,1],["لاَ تُكَثّرْ فدَتكَ نَفْسي عتابي","ودع الخَوضَ في الهَوى والتَّصابي",157,"ي",1,1],["لا تَكْذِبنّ فَما لأبناءِ الهَوى","رأيٌ يحذِّرُهُم عواقبَ نَادِمِ",158,"م",1,0],["لا تُكثِرَنَّ فما يَرَى","ممَّن تُعنِّفُ فيهِ بُدّا",159,"د",2,0],["لا تكثِرنَّ عِتَابَ مَن لم يُعتِبِ","فمِن العَنَاءِ قِيادُ غَيرِ المُصْحِبِ",160,"ب",1,1],["لا تُكثرا عذلي فإنَّ مسامعي","صُمَّت عن اللاّحي إذا يلحاني",161,"ن",2,0],["لا تكن كالخمر أعطت لونها","محرمَ الكاس فشاعت منظرا",162,"ر",2,1],["لا تكذبنّ إنها","لولاهُ لم تُشيّدِ",163,"د",1,0],["لا تُكرِهَنّ على المودةِ إنها","ليستْ تجودُ لعاشقٍ بقيادِ",164,"د",1,0],["لا تكلفن بسؤال ربع شانهُ","أن لا يجاب لسائليه دعاء",165,"ا",2,0],["لا تُكْدِيَنَّ ومن ورائِكَ أَدْمُعِي","مَدَداً إِلَيْكَ بفَيْضِ دَمْعٍ ساكِبِ",166,"ب",1,0],["لا تكتفي برجوعي","إلى عوالم حبّي",167,"ي",1,0],["لا تَكسِروا ضِلعَكُم أهلي فَما عُرِفَتْ","أضلاعُ صَدر ٍلِكي تَحميه ِتَقتَتِلُ",168,"ل",1,0],["لا تَكُن في النَقدِ مِمَّن","زادَ في الشَطرَنجِ بَغلا",169,"ل",2,0],["لا تُكرِهَنَّ عَلى اللَذا","ذَةِ وَالخَلاعَةِ مَن أَبى",170,"ب",2,0],["لا تكذبَنَّ فخير القول أصْدقه","ولا تهابنَّ في أمثالها العَربا",171,"ب",2,0],["لا تكن في غمرة اللهو جموحاً","إن هذا السكر يتلوه خمار",172,"ر",1,0],["لا تكترث بأخي العل","وِ وخلِّه ومعائبه",173,"ب",2,0],["لا تكترث بعجاجهم","فالزور من طبع اليئام",174,"م",1,0],["لا تكنْ في الغَرامِ رَبَّ لِسانٍ","دونَ قلبٍ فللهَوى أهْوَالُ",175,"ل",1,0],["لا تكنْ دائمَ التَّشادُدِ للدِّي","نِ وكُنْ رَيِّضاً بَسيطَ الجَناح",176,"ح",1,0],["لا تُكَفِّرْ بالذَّنبِ عبداً فإنَّ ال","عِصمَةَ شيءٌ أصحا