net/poem4300.html","الطويل"],[372,"هل أنت راحم عبرة توله","https://www.aldiwan.net/poem4326.html","الكامل"],[380,"الله الله أنت السمع والبصر","https://www.aldiwan.net/poem59432.html","البسيط"],[394,"باسمك الله ابتدى","https://www.aldiwan.net/poem54499.html","عموديه"],[405,"الموت حق فاستعد","https://www.aldiwan.net/poem46960.html","مجزوء الرجز"],[408,"من كان يبغي علو الذكر والشرفا","https://www.aldiwan.net/poem49526.html","البسيط"],[409,"تعاتب سعدى أن تنقل دارها","https://www.aldiwan.net/poem50172.html","الطويل"],[409,"ألم وليلي بالكواكب أشيب","https://www.aldiwan.net/poem50207.html","الطويل"],[435,"أما إنه لولا الخيال المعاود","https://www.aldiwan.net/poem12609.html","الطويل"],[436,"عظم المصاب وعمت الأكدار","https://www.aldiwan.net/poem811.html",""],[440,"أمن أميمة مصطاف ومرتبع","https://www.aldiwan.net/poem2573.html","البسيط"],[444,"ما حال حي ثوى ما بين أموات","https://www.aldiwan.net/poem14354.html","البسيط"],[444,"الموت في نفسي أغدو به وأجي","https://www.aldiwan.net/poem14360.html","البسيط"],[455,"الموحيات حيالي لا عداد لها","https://www.aldiwan.net/poem61582.html","البسيط"],[463,"أبا عمارة أن شطت منازلنا","https://www.aldiwan.net/poem15114.html","البسيط"],[466,"سل بين بانات الحمى وقدوده","https://www.aldiwan.net/poem3490.html","عموديه"],[466,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[481,"الموت درس وعزرائيل ملقيه","https://www.aldiwan.net/poem36869.html","البسيط"],[516,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[517,"ما كنت آلف منزلي إلا به","https://www.aldiwan.net/poem12027.html","الكامل"],[531,"لي همة لا تشتكي إن نالها","https://www.aldiwan.net/poem37116.html","الكامل"],[553,"جسيمة حملها جسيم","https://www.aldiwan.net/poem47244.html","الرجز"],[553,"أرقت للبرق بالعلياء يضطرم","https://www.aldiwan.net/poem47247.html","البسيط"],[553,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[564,"ضاق الرثاء بنا من فرط ما اتسعا","https://www.aldiwan.net/poem52762.html","البسيط"],[564,"ما يرتجيه المرء من مولوده","https://www.aldiwan.net/poem52771.html","الكامل"],[564,"لا تبك إن جد بعض القوم في السفر","https://www.aldiwan.net/poem52923.html","البسيط"],[588,"يا باعثا شعره انتشارا","https://www.aldiwan.net/poem17520.html","مخلع البسيط"],[588,"عفا الله عن قوم عفا الصبر منهم","https://www.aldiwan.net/poem17715.html","الطويل"],[728,"","https://poetry.dctabudhabi.ae/diwan/poem/84972","الرجز"],[976,"","https://poetry.dctabudhabi.ae/diwan/poem/35040","الرجز"]],"verses":[["أَلِمّوا عَليهِ عاقِرينَ فَإِنَّنا","إِذا لَم نَجِد عَقراً عَقَرنا القَوافِيا",0,"ي",2,0],["المَوتُ أَخبَثُ مِن أَن يَرتَضي أَبَداً","لا سوقَةً بَدَلاً مِنهُ وَلا مَلِكا",1,"ك",2,0],["المَوتُ يَركُضُ في نَواحي دَهرِنا","وَكَأَنَّ صَرفَ النائِباتِ مُطَرِّقُ",2,"ق",1,0],["المَوتُ داءٌ لا دَواءَ لَهُ","سيّانِ ما يوبي وَما يَمري",3,"ر",2,0],["المَورِدُ الرَمحَ ما نالَت عَوامِلُهُ","وَالمُطعِمُ العَضبَ ما عَزاهُ تَجريدُ",4,"د",1,0],["أَلِمّوا بِأَجوازِ تِلكَ القُبورِ","فَعَرّوا الجِيادَ وَجُزّوا السَبيبا",5,"ب",2,0],["المَوتُ يا فَوزُ خَيرٌ لي وَأَروَحُ لي","مِن أَن أَعيشَ حَليفَ الهَمِّ وَالسَهَدِ",6,"د",1,0],["الْمُؤثِرِينَ عَلَى النُّفُوسِ بِزَادِهِمْ","وَالْمفْعِمِينَ حَقَائِبَ الضِّيفَانِ",7,"ن",1,0],["المَوتُ في غِشيانِهِ وَطُروقِهِ","وَالمَوتُ كُلُّ المَوتِ أَلّا يُطرَقا",8,"ق",2,0],["المَورِدُ العَذبُ وَالنادي الرَحيبُ وَإِد","راكُ المُنى وَالقِرى وَالمَربعُ الخصِبُ",9,"ب",1,0],["أَلمَوْتُ خَتَّالٌ وَلَيْسَ بِشَافِعٍ","لِلبُلْبُلِ التَّغْرِيدُ فِي الأَفْنَانِ",10,"ن",1,0],["أَلمَوْتُ وَالإِحْجَامُ فِيمَا تَتَّقِي","شَرَعٌ وَشَرُّهُمَا هُوَ الإِحْجَامُ",11,"م",1,0],["ألموْتُ مَا لَمْ يَكُنْ عُقْبَى مُجَاهَدَةٍ","نَوْمٌ تَبَالَدَ حَتَّى مَا بِهِ حُلُمُ",12,"م",1,0],["المَوتُ أَيسَرُ عِندَهُ","مِن مَضغِ ضَيفٍ وَاِلتِقامِه",13,"م",2,0],["الموت أفجعها والفقر أوجعها","والهمّ أنحلها والغمّ أضناها",14,"ا",3,0],["المَوتُ دوني لَستُ مُهتَضِماً","وَذَوُو المَكارِمِ مِن بَني عَمروِ",15,"ر",2,0],["الموتُ من جِدِّهِ فإنْ لَعَبتْ","كفَّاهُ فالجودُ باللُّهى لُعَبُهْ",16,"ب",2,0],["الموتُ دون تفَرُّقِ الأحبابِ","وعذابُ نأيهمُ أشدُّ عذابِ",17,"ب",1,1],["الموتُ يغشاها وخاطرُ قلبِها","ذِكْرُ الأيور كأنها لم تُشغلِ",18,"ل",1,0],["أَلَمّوا بِهِ حَتّى لَقَد أَشبَهوا الدُمى","فَما فاتَهُم وَاللَهِ إِلّا التَكَحُّلُ",19,"ل",1,0],["المَوتُ أَجمَلُ مِن عَيشٍ عَلى مَضَضٍ","إِنَّ الحَياةَ بِلا حُرِّيَّةٍ عَدَمُ",20,"م",1,0],["الموت ينظرني ويبسم كاشرا","عن نابه كالمارد المتهكم",21,"م",1,0],["الموريات في قلو","بنا اسى فيه لهب",22,"ب",1,0],["المؤمنون وان تناءوا اخوة","والمرء محتاج الى اخوانه",23,"ن",2,0],["الموت يصدق في جميع حديثه","اما الحياة فقلما هي تصدق",24,"ق",1,0],["الموت خير من حيا","ة كل ما فيها نصب",25,"ب",1,0],["الموت في غمرة اليأ","س من أجلّ العطايا",26,"ا",3,0],["الموت يلحق ان شد","بالعجوز الصبايا",26,"ا",3,0],["الموت امضى سلاح في يديك وكم","به تجندل صنديد وصنديد",27,"د",1,0],["الموت فيه راحة مضمونة","اما الحياة فليس غير جهاد",28,"د",1,0],["الموت أفضل أدنى اللَه ساعته","من الحياة التي أمست تعنِّينا",29,"ن",2,0],["الموت عجلان إلى ولدى","والوضع مستعص على زوجتي",30,"ي",1,0],["المَوتُ قَبلَكَ في البَرِيَّةِ لَم يَهَب","طَهَ الأَمينُ وَلا يَسوعُ الخَيِّرا",31,"ر",2,0],["المورِدونَ الناسَ مَنهَلَ حِكمَةٍ","أَفضى إِلَيهِ الأَنبِياءُ لِيَستَقوا",32,"ق",3,0],["الموطِئينَ مِنَ المَمالِكِ خَيلَهُم","ما لَم يَفُز إِسكَندَرٌ بِوِصالِهِ",33,"ل",2,0],["المُؤمِنونَ بِمِصرَ يُه","دونَ السَلامَ إِلى الأَمير",34,"ر",1,0],["المَوتُ أَقرَبُ مِخلَباً مِن بَينِكُم","وَالعَيشُ أَبعَدُ مِنكُمُ لا تَبعُدوا",35,"د",3,0],["المُؤثِرَ العُليا عَلى حَظِّهِ","وَالحَظُّ كُلَّ الحَظِّ في العُليا",36,"ي",2,0],["المَوتُ يا مالِكي خَيرٌ وَأَروَحُ لي","مِن أَن أَعيشَ حَليفَ الهَمِّ وَالسُهُدِ",37,"د",1,0],["ألمَّ وثوبُ الدُّجى مُخلِقٌ","وثوبُ الصبَّاحِ جديدُ الضِّياءِ",38,"ا",2,0],["المَوتُ يَأتي بَغتَةً","والقبرُ صندوقُ العَمَل",39,"ل",1,0],["المَوتُ لا وَالِداً يُبقي وَلا وَلَداً","هَذا السَبيلُ إِلى أَن لا تَرى أَحَدا",40,"د",2,1],["المَوتُ حَوضٌ لا مَحالَةَ دونَهُ","مُرٌّ مَذاقَتُهُ كَريهٌ مَشرَبُه",41,"ب",2,0],["المَوتُ حَقٌّ وَالدارُ فانِيَةٌ","وَكُلُّ نَفسٍ تُجزى بِما كَسَبَت",42,"ت",1,0],["المَوتُ لا والِداً يُبقي وَلا وَلَدا","وَلا صَغيراً وَلا شَيخاً وَلا أَحَدا",43,"د",2,1],["المَوتُ ما لا بُدَّ مِن","هُ عَلى احتِرازِكَ مِنهُ جَهدَك",44,"ك",1,0],["المَوتُ بابٌ وَكُلُّ الناسِ داخِلُهُ","فَلَيتَ شِعرِيَ بَعدَ البابِ ما الدارُ",45,"ر",1,1],["المَوتُ حَقٌّ وَلَكِن لَم أَزَل مَرِحاً","كَأَنَّ مَعرِفَتي بِالمَوتِ إِنكارُ",46,"ر",1,0],["المَوتُ حَقٌّ لا مَحالَةَ دونَهُ","وَلِكُلِّ مَوتٍ عِلَّةٌ لا تُدفَعُ",47,"ع",1,0],["المَوتُ بَينَ الخَلقِ مُشتَرَكُ","لاسوقَةٌ يَبقى وَلا مَلِكُ",48,"ك",1,1],["المَوتُ شَيءٌ أَنتَ تَعلَمُ أَنَّهُ","حَقٌّ وَأَنتَ بِذِكرِهِ مُتَهاوِنُ",49,"ن",1,0],["المُؤمِنُ المُوَحِّدُ اِبنُ المُؤمِنِ ال","مُوَحِدِ اِبنِ المُؤمِنِ المُوَحَّدِ",50,"د",1,0],["الموقِدونَ تَحتَ المَراجِلِ لِلقِرى","فَضَلاتِ ما حَطَموا مِنَ المُرّانِ",51,"ن",1,0],["المَوتُ عِندي وَالفِرا","قُ كِلاهُما ما لا يُطاقُ",52,"ق",1,0],["المَوتُ خَيرٌ مِن حَياةٍ كَذا","لا أَنا مَوصولٌ وَلا ذاهِلُ",53,"ل",1,0],["المؤمنونَ على الحَوادثِ أُخوةٌ","لا يعرفون سِوَى الكتابِ لهم أبا",54,"ب",2,0],["الموتُ عندَ القومِ أعذبُ مَشْرباً","مِمَّا يُرادُ بهم وأطيبُ مطعما",55,"م",2,0],["المؤمنون الثّابتون على الهُدَى","والأرضُ ترجُفُ والشّوامخُ تَخفِقُ",56,"ق",1,0],["الموتُ للمرضى الضّعافِ وهذه","مِصرُ الأبيّةُ قوّةٌ ومِراحُ",57,"ح",1,0],["المَوتُ يَسبَحُ في الغِمارِ بِأَمرِهِم","وَالمَوتُ يَمرَحُ في حِمى كيوانِ",58,"ن",1,0],["الموتُ في وثباتِه يَجرِي دماً","والموتُ في نَظَراتهِ يتلهّب",59,"ب",1,0],["الموتُ في يدهِ وعند لوائِه","رِيحُ الجِنانِ لِمَنْ دَنا يَسْتَرْوِحُ",60,"ح",1,0],["الموثِقونَ لِجارِ البَيتِ ما عَقَدوا","وَمِنهُمُ سابِقُ الجُلّى وَداعيها",61,"ي",3,0],["المَوتُ مِن غادِرٍ أُعَذَّبُ بِه","يَخدَعُني وَعدُهُ وَمَن لِيَ بِه",62,"ب",2,1],["المَوتُ أَولى لِلفَتى مِن أَن يَرى","ظالِعَ دَهرٍ كُلَّما شاءَ اِنقَلَب",63,"ب",1,0],["المَوتُ مِنّا قَريبٌ","وَلَيسَ عَنّا بِنازِح",64,"ح",1,1],["المَوتُ شَيءٌ هَيِّنٌ","وَالمَوتُ إِنجازُ الوِعادِ",65,"د",1,0],["المُؤثِرُ الرَأسَ عَلى رَبِّهِ","وَالجاعِلُ الخِنزيرَ في الزادِ",66,"د",1,0],["المَوتُ حَظٌّ لِمَن تَأَمَّلَهُ","وَلَيسَ في العَيشِ أَن تُؤَمِّلَ حَظ",67,"ظ",1,1],["المَوتُ رَبعُ فَناءٍ لَم يَضَع قَدَماً","فيهِ اِمرُؤٌ فَثَناها نَحوَ ما تَرَكا",68,"ك",2,1],["المَوتُ نَومٌ طَويلٌ لا هُبوبَ لَهُ","وَالنَومُ مَوتٌ قَصيرٌ بَعثُهُ أَمَمُ",69,"م",1,1],["المُوقِدي نارِ القِرَى الآصالَ وال","أسْحارَ بالأهْضامِ والأشعافِ",70,"ف",1,0],["المُوقِدُونَ بنجْدٍ نارَ باديَةٍ","لا يَحضُرونَ وفَقْدُ العِزّ في الحَضَرِ",71,"ر",1,0],["المُولِجِ الليلَ في النهارِ","وَفِي الليلِ نَهاراً يُفرِّجُ الظُّلَما",72,"م",2,0],["الموت لما جد علمني","أن الحياة جَميعها لعب",73,"ب",1,0],["المَوت إذ وطن الأبيّ مهدَّد","مجد يشايع أَو حياة تخلدُ",74,"د",1,1],["الموت في شرخ الشبا","ب لمن يعالجه رَهيب",75,"ب",1,0],["الموت عين يشرب ال","أفراد منها وَالشعوب",75,"ب",1,0],["المَوت لَيثٌ يقصم ال","أعناق من بعد الظهور",76,"ر",1,0],["الموت ذئب يخطف ال","أطفال من بين الحجور",76,"ر",1,0],["المَوت لَيسَ بتارك أحدا وَقَد","يُبقي عليه وبعد ذاك يوافي",77,"ف",2,0],["المَوت من حق الحَياة لأهلها","ما فيه من ظلم ولا إجحاف",77,"ف",1,0],["الموت يوصلنا إِلى دار البلى","وَلَقَد تكون مقابر الأشراف",77,"ف",1,0],["المَوت يهزأ بالحَياةِ","وَالقبر يعبث بالرفاتِ",78,"ت",1,1],["المَوت راعَني","في اللَيلِ إِذ رَنا",79,"ن",2,0],["\"الموت أعذر لى، والصبر أجمل بي","والبر أوسع، والدنيا لمن غلبا\"",80,"ب",2,0],["المَوتُ عَجلانٌ إِلى والِدي","وَالوَضعُ مُستَعصٍ عَلى زَوجَتي",81,"ي",1,0],["أَلَمَّ وَلَمْ يَلْبَثْ وَسَارَ وَلَيْتَهُ","أَقَامَ وَلَوْ طَالَتْ عَلَيَّ الدَّيَاجِرُ",82,"ر",1,0],["أَلمُورِيَاتُ أَخْمَدَتْ زِنَادِي","وَالمَرْثِيَاتُ أَنْضَبَتْ مِدَادِي",83,"د",2,1],["أَلموْتُ فِيمَا عَلِمْتَ حَقاً","أَهْنَأُ رَاحٍ يَسْقِيهِ سَاقِ",84,"ق",1,0],["ألموتُ أكرمُ نفساً","والقبرُ أرحَبُ بابا",85,"ب",2,0],["ألمؤمنون بسعد أين أبصرهم","والمعجبون بسعد أين أين هم",86,"م",1,0],["أَلَمَّ وَقَد كادَ الظَلامُ تَقَضَّياً","يُشَرِّدُ فُرّاطَ النُجومِ الطَوالِعِ",87,"ع",1,0],["المَوتُ مُرُّ وَالعَيشُ هَمُّ","وَأَيَّ هاذَينِ لا أَذُمُّ",88,"م",1,1],["الموتُ بحرٌ موجهُ غالِبٌ","يذهَلُ فيه العائمُ السابحُ",89,"ح",1,1],["الْمَوْتُ يَحْصُدُ حَصْداً","وَالسِّجْنُ لِلْح