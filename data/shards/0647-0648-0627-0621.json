{"poems":[[65,"أضاء بريق بالعذيب كليل","https://www.aldiwan.net/poem46146.html","الطويل"],[63,"هواء كالهوى حسنا وظرفا","https://www.aldiwan.net/poem51536.html","الوافر"],[63,"ثنت لك أعطافها والخصورا","https://www.aldiwan.net/poem51673.html","المتقارب"],[92,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179090",""],[1178,"","https://poetry.dctabudhabi.ae/diwan/poem/31474","الوافر"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31623","المتقارب"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95394","الطويل"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105791","المتقارب"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103000","الوافر"],[4259,"","https://poetry.dctabudhabi.ae/diwan/poem/145314","المتقارب"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146764","الطويل"],[4956,"من الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=1393",""],[5206,"الجاهل والعارف","https://www.poetsgate.com/ViewPoem.aspx?id=187359",""],[5458,"لا تدخين بعد اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=72388",""]],"verses":[["هَواءٌ كأيّامِ الهَوى لا يُغِبُّهُ","نَسيمٌ كلَحْظِ الغانِياتِ عَليلُ",0,"ل",1,0],["هَوَاءٌ كَالهَوَى حُسْنَاً وَظَرْفَا","وَخَيْشٌ لَيْسَ يُتْرَكُ أنْ يَجِفَّا",1,"ف",2,1],["هواءٌ نُبَاشِرُهُ حُسَّراً","فنَقسِمُه ساجياً أو حَسِيرا",2,"ر",2,0],["هواءك إذ نهشُّ له شَمالاً","وماءك إذ نصّفِقه شَمولا",3,"ل",2,0],["هَواءٌ مِثلُ بَعلِكِ مُستَميتٌ","عَلى ما في إِعائِكِ كَالخَيالِ",4,"ل",1,0],["هَواءٌ صَفا وهَوى مِثْلُهُ","كَخَمْرِ دَلالٍ وماءٍ زُلالِ",5,"ل",1,0],["هواء رخيم وانتعاش ومأكل","لطيف كما الخروف إذ جاءنا يسري",6,"ر",2,0],["هواءٌ ولكنّه ساكنٌ","وماءٌ ولكنّه غيرُ جارِ",7,"ر",1,0],["هواء في الاكفّ له جمود","وتبر في الزجاج له انحلال",8,"ل",1,0],["هواء كوشي قريضي رقيق","وريح كمشي عشيقي خنيث",9,"ث",1,0],["هواء كأيام الهوى فرط رقة","وقد فقد العشاق فيها العواذلا",10,"ل",2,0],["هواء لطيف وظل ظليل","وفرط هدوء وماءٌ رِوَى",11,"ا",1,0],["هَوَاءٌ هَوَى فِي هُوَّةٍ هَانَ هُونُهُ","بِمَهْوَاهُ هَوْنًا في مَهَاوي الهَوَى هَوِي",12,"ي",1,0],["هواء صاغه المولى نظيفاً","فمن يبدل خبيثاً بالعقيق",13,"ق",1,0]]}