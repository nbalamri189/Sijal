{"poems":[[57,"أما والذي لو شاء لم يخلق النوى","https://www.aldiwan.net/poem26498.html","الطويل"],[53,"لا تغش إلا ملكا في منزلِه","https://www.aldiwan.net/poem65968.html","الرجز"],[51,"أما والذي لو شاء لم يخلق النوى","https://www.aldiwan.net/poem63234.html","البسيط"],[92,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[47,"يا يَوْمُ عَرّجْ بَلْ وَرَاءَكَ يا غَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=31631",""],[159,"ومهفهف كالغصن هزته الصبا","https://www.aldiwan.net/poem55804.html","الكامل"],[266,"منهل دمع المحب من دمه","https://www.aldiwan.net/poem38141.html","المنسرح"],[308,"يوهمني من لين أعطافه","https://www.aldiwan.net/poem57872.html","السريع"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[327,"بانت سليمى وأقوى بعدها تبل","https://www.aldiwan.net/poem56346.html","البسيط"],[354,"لبيبهم أحمق من باقل","https://www.aldiwan.net/poem15712.html","السريع"],[369,"ما أنس لا أنس له موقفا","https://www.aldiwan.net/poem60583.html","السريع"],[371,"أما والذي لو شاء لم يخلق النوى","https://www.aldiwan.net/poem17851.html","الطويل"],[449,"لست أنسى عهد ليل قريب","https://www.aldiwan.net/poem56036.html","المديد"],[534,"حتى متى ذا البين يا من غدا","https://www.aldiwan.net/poem37372.html","السريع"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123441","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59419","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25329","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108838","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53175","الكامل"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123881","الرجز"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46873","المتقارب"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74103","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117976","الخفيف"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93302","السريع"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54474","الطويل"],[5281,"يا رَامِشْ العَينين","https://www.poetsgate.com/ViewPoem.aspx?id=199605",""],[5281,"الحياءُ البِكر","https://www.poetsgate.com/ViewPoem.aspx?id=199311",""],[5431,"عليّ كرم الله وجهه....","https://www.poetsgate.com/ViewPoem.aspx?id=212969",""]],"verses":[["يُوَهِّمُنيكَ الشَوقُ حَتّى كَأَنَّما","أُناجيكَ عَن قُربٍ وَإِن لَم تَكُن قُربي",0,"ي",1,0],["يوهمُ بالصبرِ على تدللِهْ","إنَّ به داهيةً في أسفلِهْ",1,"ل",2,0],["يُوَهِّمُنيكَ الشَوقُ حَتّى كَأَنَّني","أُناجيكَ عَن قُربٍ وَما أَنتَ في قُربي",2,"ي",1,0],["يُوهي الحجى ويُذيبُ كلَّ تُقىً","من مُدّعيهِ شبابُك النَّضِر",3,"ر",1,0],["يوهي صَفاةَ الخَطبِ، وَهوَ مُلَملَمٌ،","وَيَهُدُّ رُكْنَ الخَصْمِ، وَهوَ يَلَندَدُ",4,"د",1,0],["يُوهِيه حَملُ وِشَاحِهِ فَتَراهُ من","تَرَفِ النعيمِ يَئِنُّ في إِخْفاءِ",5,"ا",2,0],["يوهن اسماعنا خطابهم","ما يوهن الساق ثقل ادهمه",6,"م",2,0],["يوهمني من لين أعطافه","بأنه لم يقس يوماً على",7,"ل",2,1],["يوهي الجديدانِ القوى ويقرّبا","نِ العمرَ مِن أجلٍ مباحٍ يقطعُ",8,"ع",1,0],["يوهي السَناسِنَ مِنها صَوبُ رَيِّقِهِ","فَلَيسَ في غَيمِهِ فَتقٌ وَلا خَلَلُ",9,"ل",1,0],["يوهِمُ اَنَّ الصِدقَ في زَورِهِ","وَيَسلُكُ الخَيرَ إِلى الشَرِّ",10,"ر",1,0],["يُوهِمُ صَحْبي أَنّه مُسْعِدي","بأدْمُعٍ لم تُذْرِها مُقْلتاه",11,"ا",2,0],["يُوَهِّمُنيكَ الشَوقُ حَتّى كَأَنَّني","أَناجيكَ مِن قُربٍ وَلَم يَكُ عَن قُربِ",12,"ب",1,0],["يوهم الأصحاب أن الكبر","لم يدع لي غير لب سقيم",13,"م",1,0],["يُوهمُني أَنّي حَبيبٌ لَهُ","إنْ صَحّ ذَا ما بَالُهُ يَهْجُرُ",14,"ر",1,0],["يوهم زمراً أنه","قطعه ودندنا",15,"ن",2,0],["يوهي حصاة الحرب غير مشمر","ويهد ركن الخطب غير مدرع",16,"ع",1,0],["يُوهِي إِذَا لاقَى الشِدادَ الحُوسا","بَعْدَ الصَمِيمِ العَصَبَ المَدْخُوسا",17,"س",2,0],["يوهم الصب أنه","معدن الجود والكرم",18,"م",1,0],["يوهي نحيل الخصر منه إذا انثنى","كَفَلٌ بما شاء الغرام كفيل",19,"ل",1,0],["يوهم أن يكسو بها فتيله","وإنما ذلك منه حيله",20,"ه",1,0],["يُوَهِّن يَأْسِيَ مِنكُم رَجائي","وَتَرْحَمُ حالِيَ فيكُم مآلِي",21,"ل",2,0],["يوهي حمى قلب بأك","ناف الحمى متقسّمِ",22,"م",1,0],["يوهم البله والمصدّقين له في","ما افترى أنه سموح كريم",23,"م",1,0],["يوهمني في قوله باطناً","والحُكْم محمولٌ على الظاهر",24,"ر",1,0],["يُؤهِّلُني للبعدِ من كلِّ حظوة","ويحرمني اللذاتِ بُعدي من الأَهلِ",25,"ل",1,0],["يُوهْ يَا لَطيفْ مِنّه.. وَمَا أقول عَنِّه","النَّار والجَنِّه.. والحُسنْ صنعاني",26,"ن",2,0],["\"يُوْهْ\"(1) لَحْنٌ قد أَرسَلَتْهُ شَجِيًّا","زادَ في حُسْنِها جَمالًا جَديدا",27,"د",2,0],["يوهم الناس أنّهم مُلْكُ ملْكٍ","ممعن الفحش مجحفٌ وعتيّ",28,"ي",1,0]]}