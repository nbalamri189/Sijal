],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73170","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133100","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72431","الرجز"],[4692,"لغز3","https://www.poetsgate.com/ViewPoem.aspx?id=213013",""],[4697,"يا بوش","https://www.poetsgate.com/ViewPoem.aspx?id=22667",""],[4767,"نبئت","https://www.poetsgate.com/ViewPoem.aspx?id=93823",""],[4796,"ثرثرة المُزنِ وأنا","https://www.poetsgate.com/ViewPoem.aspx?id=180985",""],[4858,"شوق وحنين إلى فلذات كبدي","https://www.poetsgate.com/ViewPoem.aspx?id=33747",""],[4993,"لي صاحب قدره على الراس والعين","https://www.poetsgate.com/ViewPoem.aspx?id=25803",""],[5061,"البدر لا غاب","https://www.poetsgate.com/ViewPoem.aspx?id=147151",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5237,"هذي رياح اليمن هب نسيمها","https://www.poetsgate.com/ViewPoem.aspx?id=113116",""],[5376,"للقدس عين من الاشواق لم تنم","https://www.poetsgate.com/ViewPoem.aspx?id=188549",""],[5397,"عذبت لنظرة عينك الأرياف","https://www.poetsgate.com/ViewPoem.aspx?id=157965",""],[5956,"‏ انتشال من الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=183997",""],[5956,"يتسلل النور الجميل لمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=194211",""],[5976,"ربعي بني خالد","https://www.poetsgate.com/ViewPoem.aspx?id=30387",""],[6082,"فتاة شرقية","https://www.poetsgate.com/ViewPoem.aspx?id=60252",""],[6096,"عماء .. لكني أرى","https://www.poetsgate.com/ViewPoem.aspx?id=177111",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[4701,"بلاغة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87361&r=&rc=1",""]],"verses":[["بِالطائِعِ الهادي الإِمامِ أَطاعَني","أَمَلي وَسَهَّلَ لي الزَمانُ مَرامي",0,"م",2,0],["بِالطائِعِ المَيمونِ أُنجِحَ مَطلَبي","وَعَلَوتُ حَتّى ما يُطاوَلُ مَعقَلي",1,"ل",2,0],["بِالطَفِّ حَيثُ غَدا مُراقُ دِمائِها","وَمَناخُ أَينُقِها لِيَومِ جِلادِها",2,"د",3,0],["بالطَّبْعِ تُفْرِغُ نَاظِماً أَوْ نَاثِراً","أَسْمَى المَعَانِي فِي أَرَقِّ مَبَانِي",3,"ن",2,0],["بِالطَفِّ حَولي مِن يَتامى إِخوَتي","في الذُلِّ قَد سُلِبوا القِناعَ وَجُرِّدوا",4,"د",3,0],["بألطفَ من أخلاقِهِ عند شيمِها","وأعطر من أخباره عند شمّها",5,"م",3,0],["بالطاعِن الضارِب الرامي إِذا اِقتَتَلوا","بِالمَوتِ أَحمَرَ بالضرغمِ العادي",6,"د",2,0],["بِالطولِ وَالعَرضِ تُباهي فَذا","وافٍ وَهَذا عِندَ غاياتِهِ",7,"ت",2,0],["بالطب أو بالشعر أو بكليهما","كل الجهود فداء هذا الوادي",8,"د",2,0],["بِالطَرفِ وَالثَغرِ وَالسَوالِفِ وَالنَح","رِ وَشَيءٍ يَطيبُ في اللَمسِ",9,"س",1,0],["بِأَلْطَفَ مِنْ أَخْلاقِهِمْ وَصِفَاتِهِمْ","إِذَا الْعُودُ ضَمَّتْهُ أَكُفُّ الْعَوَاجِمِ",10,"م",1,0],["بالطمس بالسر المذاع بما انطوى","في الغيب من امر له برهان",11,"ن",1,0],["بالطبع حاجتنا إليك وهل غنى","يلفى عن الأرواحِ للأجسام",12,"م",1,0],["بالطفلِ والبالغِ والمُبتدى","شبابَه والكَهْلِ والشائب",13,"ب",1,0],["بالطائرات المرسلات عويلا","ترمي بأطنان الردى تنكيلا",14,"ل",2,1],["بألطفِ ترنيمٍ وأبهى طبيعةٍ","وأجملِ تمثالٍ وأكملِ صورة",15,"ه",1,0],["بِالطَّوْلِ يُسَألُ مُهَنَّؤُهُ","والصوْل يُسَلُّ مُهَنَّدُهُ",16,"د",2,0],["بالطَّويل الباع بالسَّامي الذّرى","عرف المعروف شيخاً وغلاما",17,"م",2,0],["بالطول والطول يا طوبى لو اعتدلا","فلو ظلمت رقيبا بالهوى عدلت",18,"ت",1,0],["بألْطافِ ربِّ العرش من كل حادث","وشاملِ حِفْظِ اللّهِ من كل مؤلم",19,"م",1,0],["بألطاف رب العرش من كلِّ نَبْوةٍ","يعوق أذاها كلَّ ماضٍ وهاطلِ",20,"ل",1,0],["بالطّائع اِطّادَتْ مذاهبُ أُمّةٍ","فَوْضى على سُنَنِ النبيّ المرسلِ",21,"ل",1,0],["بِالطَرفِ وَاللَبّاتِ خُزراً قُوَّدا","لَمّا رَأَينَ الشَيبَ قَد تَعَهَّدا",22,"د",2,0],["بِالطُّرَّةِ السَّوْدَاءِ فَوْق الغُرَّةِ ال","بَيْضَاءِ فَوْقَ الوَجْنَةِ الحَمْرَاءِ",23,"ا",2,0],["بِالطِعانِ الشَديدِ وَالنائِلِ الجَز","لِ إِذا نَكَّسَ البَخيلُ الدَثورُ",24,"ر",1,0],["بالطب لست بواثق ما دام في","انقاذ نجلى خاب كل نطاسي",25,"س",2,0],["بِالطِّلقِ لا المُتَجَبِّرِ المُتَكَبِّرِ ال","جافي وَلا المُتَغَطرِسِ المُتَفَيهِقِ",26,"ق",1,0],["بالطي والنشر في حال قد اتصفت","والطي والنشر فيما قيل ضدان",27,"ن",1,0],["بألطف كي يروا الألى فوق القنا","رفعت مصاحفها إتقاء منون",28,"ن",1,0],["بِالطَيف قَد وَعَدتَني","كَيفَ وَطَرفي ما هَجَع",29,"ع",1,0],["بِالطب وَالتدبير وَالمُعالجه","مِن الشكايا وَالبَلايا الهائِجَه",30,"ه",1,0],["بالطَّالِعِ السَّعد والفألِ الحميدِ جرى","لهُ منَ الله إتْمامٌ وإمْضاءُ",31,"ا",2,0],["بالطبع مستحلبٌ نداه","إن حلب الغاديات ريحُ",32,"ح",1,0],["بالطاهر الغازي الذي استولى على","غرِّ المناقب والمحل الأعظم",33,"م",1,0],["بِالطَّعنِ بِالإِجمَالِ وَالإٍضمَارِ وَالتَّ","خصِيصِ وَالتَّأوِيلِ بِالبُهتَانِ",34,"ن",1,0],["بالطبع أصدر أمره","طلباً لكثرة ما يفيد",35,"د",1,0],["بالطالع الميمون خودُ منىً","رقصت وهلهل طائر هدل",36,"ل",1,0],["بالطبع غادرت الغدران ميرتها","وَساءَ سارة أَن غاضت بُحيرتها",37,"ه",2,0],["بالطفل بالملك الباهي هناء كما","خير القرينين هذا خير مولود",38,"د",1,0],["بالطيب دولة هذا الروض قائمة","ما دام عسكرها للأرض منبسطا",39,"ط",2,1],["بالطبع أوراد زهت","حتى عذت روضاً جني",40,"ن",2,1],["بألطاف قربٍ يسهل الصعب عندها","وينعم فيها بالذي كان يأملُ",41,"ل",1,0],["بالطالب اعمرٍ وعنيتُ الكنزِي","كثِّر سوامي وكثِّر كنزي",42,"ي",1,0],["بالطاهر المطهّرِ المهيمنِ","طهِّرْ جميعي واهدي وعافني",43,"ي",1,0],["بالطالبِ اخيارِ وبالوليّ","وأغطفٍ والهيبَ كن وليي",44,"ي",1,0],["بالطاء والظاءِ وكافٍ وبلامْ","اغفرْ لنا وأغِثَنْ هذي الأنامْ",45,"م",1,0],["بالطور والنجم كذا والقمرِ","وسورةِ الرحمنِ زكِّ عمري",46,"ي",1,0],["بالطرفين ليس يبقى خلف","وإن يكن عن معرض ينكف",47,"ف",1,0],["بالطيبِ أَرى كُلَّ عَليلٍ يَقوى","لِم خامركِ الطيبُ فَما أَجداكِ",48,"ك",1,0],["بالطَلعَةِ الغَراء وَالوَجه الَّذي","يَشفي وَحَقِّك كُلِّ جَفنٍ أَرمَدِ",49,"د",1,0],["بألطافة الغراء جاءَ موحَّداً","بأوصافهِ الحسنى تسامى عن الرشدِ",50,"د",1,0],["بألطافها تسبي قلوباً أبية","بأوصافها وتؤني لدى مدحها الرشدا",51,"د",2,0],["بالطست فيها حكمةُ الرحمن","فاستخرجا القلبَ العظيم الشان",52,"ن",1,0],["بالطف يوما بكته منا","ومن حيا المزن كل عين",53,"ن",1,0],["بالطرفِ يسحرُ وهو مِن سُكرِ الصبَّا","وخُمارِه في صُورةِ المخمورِ",54,"ر",1,0],["بآل طه سألناك بأجمعهمز","فجد بسؤلي كما قدرت إيجادي",55,"د",2,0],["بالطف إذ طاف بهم عدوهم","وما سوى الله بكى من الاسى",56,"س",2,0],["ب(الطينِ) شُيَّدَ لا بالجصِّ والحجرِ","(الوَادِ) يَشْهَدُ للتاريخِ للبصرِ",57,"ر",1,1],["بالطيب جيناهم وجونا بنكران","وش ذنبنا وش جرمنا ش ارتكبنا",58,"ن",2,0],["بالطف في تخليد نهضة من","لو لاهُ صوت الحق ما وصلا",59,"ل",2,0],["بالطيرِ بالغيمِ المثرثر باخضرا","رِ التين والزيتونِ بالريمِ الشريدِ",60,"د",1,0],["بالطفلِ نذوقُ حلاوتَها!","بالطفلِ يفوحُ لها عِطْرُ!",61,"ر",1,0],["بالطفلِ يعيشُ لنا أمَلٌ!","بالطفلِ يُضيءُ لنا عُمْرُ!",61,"ر",1,0],["بالطيب والنوماس والمذهب الزين","والعرف والتقدير هذي صفاته",62,"ت",2,0],["بالطريق الي على ضوه مشيت","صرت اخايل همي الي مافنا",63,"ن",2,0],["بالطِّيبِ نُحْيِي كلَّ قلْبٍ يرْتَجِي","الآيُ حجَّتُنا بهَا الإسْداءُ",64,"ا",2,0],["بِالطّيبِ نَغْزُو قُلُوبًا عَزَّ فَاتِحُهَا","جِئْنَا نُتَمِّمُ مَا تَحْوي مِنَ القِيَمِ",65,"م",1,0],["بالطيب المختار طابت طيبة","وتأرجت أرجاؤها وحريمها",66,"م",3,0],["بالطهر مسكونة والانبياء بها","مروا عليها سلاما عند مستلم",67,"م",1,0],["بالطعن إن يعوج عاملها يرى","لقوامها المقدار وهو ثقاف",68,"ف",1,0],["بالطائرات الهليكوبْتَرِ طائرٌ","فوق السُّهاد ولست فيه أغورُ",69,"ر",1,0],["بالطبع لا شيئاً تماماً خالصاً","هذي الدُّنا يا شهم لم تتبدّلِ",70,"ل",1,0],["بالطيب صيت الخالدي عند عربان","وان كان ثار غبارها .. ما له اضداد .. !!",71,"د",1,0],["بالطفل القادم من رحمي","والزوج الآتِ كأغنية",72,"ي",2,0],["بالطّيرِ أشعرُ في الفضاءِ مرفرفاً","قربي يحطُّ كأنه المذعورُ",73,"ر",1,0],["بالطاهر القدوس ذاتاً وصفه","عن صفة حادثة مكيفه",74,"ه",1,0],["بالطاهر المسْكي أرسمُ أمةً","كي يبعث الشهداءُ من أبياتي",75,"ت",2,0]]}