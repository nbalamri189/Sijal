{"poems":[[55,"ألا من يمطر السنة الجمادا","https://www.aldiwan.net/poem30602.html","الوافر"],[32,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[32,"تصابيت في أطلال مية بعدما","https://www.aldiwan.net/poem29578.html","الطويل"],[29,"أصبح حبل وصلكم رماما","https://www.aldiwan.net/poem5987.html","الوافر"],[11,"أتعرف أطلالاَ ونؤيا مهدم","https://www.aldiwan.net/poem268.html",""],[93,"كأني في روض أرى الماء جاريا","https://www.aldiwan.net/poem8854.html","عموديه"],[18,"لابنة حطان بن عوف منازل","https://www.aldiwan.net/poem23912.html","الطويل"],[82,"وأكلف منسره ذو شغا","https://www.aldiwan.net/poem31367.html","المتقارب"],[82,"فؤادي نجيب والجلال نجيب","https://www.aldiwan.net/poem31549.html","الطويل"],[46,"جرت له أسماء حبل الشموس","https://www.aldiwan.net/poem30479.html","السريع"],[22,"أرى العير تحدى بين قو وضارج","https://www.aldiwan.net/poem22003.html","الطويل"],[50,"وفي الحمام يبدو لك","https://www.aldiwan.net/poem65003.html","الهزج"],[22,"أرى العير تحدى بين قنٍّ وضارجٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19793",""],[146,"ترى رائح يأتى بأخبار من غدا","https://www.aldiwan.net/poem58445.html","الطويل"],[164,"يغر بحسن الرأى راج ويخدع","https://www.aldiwan.net/poem58992.html","الطويل"],[358,"تنزه عن بني الدنيا وعاد","https://www.aldiwan.net/poem40384.html","الوافر"],[369,"طلعت طلوع البدر يا ملك الورى","https://www.aldiwan.net/poem60865.html","الطويل"],[432,"فمن يك أمسى في بلاد مقامةٍ","https://www.aldiwan.net/poem536.html",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66791","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38768","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26457","الرجز"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/177841","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21460","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106846","المتقارب"],[2397,"","https://poetry.dctabudhabi.ae/diwan/poem/204366","البسيط"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22533","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102388","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91153","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91131","الطويل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2542","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35495","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199085","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97074","الطويل"],[382,"","https://poetry.dctabudhabi.ae/diwan/poem/112010","الوافر"],[4989,"الله يعلم أن قد جبت ذا يمن","https://www.poetsgate.com/ViewPoem.aspx?id=82183",""],[5430,"تمهل","https://www.poetsgate.com/ViewPoem.aspx?id=1461",""],[5582,"أَهاجَ لَكَ التَّذْكارَ وَالوَجْدَ بارِقُ","https://www.poetsgate.com/ViewPoem.aspx?id=187213",""],[5829,"واسقط حكمة الرجل الحصيف","https://www.poetsgate.com/ViewPoem.aspx?id=211484",""],[161,"حنين الأنام لحج بيت الله الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=175362",""]],"verses":[["تَرى رَأيَ الفَتى فيهِم مُطاعاً","وَقَولَ المَرءِ مِنهُم مُستَعادا",0,"د",2,0],["تَرى رَعنَهُ الأَقصى كَأَنَّ قُموسَهُ","تَحامُلُ أَحوى يَتبَعُ الخَيلَ ظالِعِ",1,"ع",1,0],["تَرى رَكبَها يَهوونَ في مُدلَهِمَّةٍ","رَهاءٍ كَمَجرى الشَمسٍ دُرمٌ حُدورُها",2,"ر",3,0],["تَرى رَكبَ الفَلاةِ إِذا عَلَوها","عَلى عَجَلٍ وَسَيرُهُمُ اِقتِحاما",3,"م",2,0],["تَرى رُمحَهُ وَنَبلَهُ وَمِجَنَّهُ","وَذا شُطَبٍ عَضبَ الضَريبَةِ مِخذَما",4,"م",2,0],["تُرى رُوِّعَت مِثلي مِنَ الدَهرِ بِالفِرا","قِ أَم بَدَّلَت مِثلي مِنَ اليُسرِ بِالعُسرِ",5,"ر",1,0],["تَرى رائِداتِ الخَيلِ حَولَ بُيوتِنا","كَمِعزى الحِجازِ أَعجَزَتها الزَرائِبُ",6,"ب",1,0],["ترى ريشَهُ فوْقَ أرجائهِ","طِراقاً كمثل حباب الرّحيق",7,"ق",1,0],["ترى رامحَ الرّمضاءِ فيه كأنّه","مُواقِعُ نارٍ واقعته ذنوب",8,"ب",1,0],["تَرى رَزانَ القَومِ قَد أَسمَحَت","أَعيُنُهُم في حُسنِهِ وَهيَ شوس",9,"س",1,0],["تَرى رَأسَهُ مُستَحمِلاً قَبلَ رِدفِها","كَما حَمَلَ العِبءَ الثَقيلَ المُعادِلُ",10,"ل",1,0],["تَرى رِدفاً يُغَطّي الظَه","رَ مِن أَهيَفَ جَدوَلِ",11,"ل",1,0],["تَرَى رَأْسَهُ مُسْتَحْمَلاً خَلْفَ رِدْفِها","كما حَملَ العِبْءَ الثَّقِيلَ المُعَادِلُ",12,"ل",1,0],["تُرى رائحٌ يأتى بأخبار مَن غدا","وهل يكتُم ألأنباءَ من قد تزوَّدا",13,"د",2,1],["ترى رسل الاملاك من كل وجهة","قياما على أبوابه تتضرع",14,"ع",1,0],["تَرى رَفضَ اللئيم أَجلّ فَرضٍ","وَخَفر ذِمامِهِ خَير اِعتِقادِ",15,"د",1,0],["تَرى رجلاً لوناً إذا قابلَ العِدا","ويَرجِعُ مُرتَجّاً إذا طَعَنَ الخَلْسا",16,"س",2,0],["تَرى رائِداتِ الخَيلِ حَولَ بُيوتِنا","كَمِعزى الحِجازِ أَعوَزَتها الزَرائِبُ",17,"ب",1,0],["تَرى راياتِه بالشامِ سُوداً","وبين النَّقعِ تَحسبها قَتاما",18,"م",2,0],["تَرى رِقابَ الأَعادي حينَ يَضرِبها","مِن تَحتِ هِنديِّهِ الإِصليتِ كَالزّغبِ",19,"ب",1,0],["تَرى رِجالاً رُكَّعاً","في جَريِهِم كَالحُدُبِ",20,"ب",1,0],["ترى رجعة هل عودة لطوافنا","وذاك الحمى قبل المنية نغشاه",21,"ه",1,0],["تَرى رَبَّهُ البَهم الفِرارَ عَشِيّةً","إِذا ما عدا في بَهمِها وَهوَ ضائِعُ",22,"ع",1,1],["تُرى راجعاتٍ لياليَّ فيك","أبو قير والأمسُ لا يرجع",23,"ع",1,0],["ترى رءوس بني مروان خاضعةً","يمشون حول ركابيه وما ظلموا",24,"م",3,0],["تَرى رَأسَها في كُلِّ مَبدىً وَمَحضَرٍ","شَعاليلَ لَم يُمشَط وَلا هُوَ يُسرَحُ",25,"ح",1,0],["ترى رزقَهُ يوماً بيومٍ وإنّما","غِناهُ إذا استغنى بفِلْقٍ وأسهُمِ",26,"م",1,0],["تَرى رَجعة يَوماً لعيش قضيته","وَإِن كانَ لا يُرجى فَبَعض التخيل",27,"ل",1,0],["تَرى رَجلاً للسيف قر حمية","وَآخر فرّاراً يَهون لَهُ الوَخز",28,"ز",1,0],["تَرى رائِداتِ الخَيلِ حَولَ بُيوتِنا","أَبابيلَ تَردي بِالعَشِيِّ وَبِالبُكُر",29,"ر",1,0],["ترى رَضيتَ وَعادَ الودّ أَم بَقِيَت","بَقيّة تَتَقاضى عَودَة الغَضَبِ",30,"ب",1,1],["ترى رجلا ليس الرجال كمثله","نوافله أربت على كل قائل",31,"ل",1,0],["ترى رأس عز الدين ينكث ثغره","أذل الورى قدراً وأعظمهم كفرا",32,"ر",2,0],["ترى رهبانَهم راضين طوعاً","بذُلِّ الفقر والفقرُ اختيار",33,"ر",1,0],["ترى رؤوس بني مروان خاضعة","يمشون حول ركابيه وما ظلموا",34,"م",3,0],["ترى رجلاً فيعجبك اتزاناً","وما تدري بما تخفي القلوبُ",35,"ب",1,0],["تَرَى رأْسَها يَدْنُو إِلَى الأَرْضِ كُلَّما","خَدَتْ وَاسْتَمَدَّتْ فَهيَ فِي السَّيْرِ خافِقُ",36,"ق",1,0],["ترى رسم الحبيب كنقش وشم","تربع سدة القلب المنيفِ",37,"ف",1,0],["19-تَرَى رَحْمَةً تُسْلِي الضَّعِيفَ بِحَالِهِ","فَإِنْ مَلَكَ الإمْكَانَ عَجَّلَهُ اليَوْمَا",38,"م",2,0]]}