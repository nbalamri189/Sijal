{"poems":[[3,"عفت الديار وباقي الأطلال","https://www.aldiwan.net/poem190.html",""],[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[29,"خف القطين فقلبي اليوم متبول","https://www.aldiwan.net/poem5952.html","البسيط"],[4,"لا تزجر الفتيان عن سوء الرعه","https://www.aldiwan.net/poem21177.html","الرجز"],[23,"أنا ابن خلدة والأغر","https://www.aldiwan.net/poem21440.html","مجزوء الكامل"],[31,"حلت صبيرة أمواه العداد وقد","https://www.aldiwan.net/poem6069.html","البسيط"],[87,"راية الموت فوق هام العباد","https://www.aldiwan.net/poem7752.html","الخفيف"],[30,"إني حلفت بصارع لابن له","https://www.aldiwan.net/poem5441.html","الكامل"],[33,"ألم طيف فهاج لي طربي","https://www.aldiwan.net/poem42616.html","المنسرح"],[21,"ألا بكيت على الكرا","https://www.aldiwan.net/poem36243.html","مجزوء الكامل"],[21,"المطعمون الطعام في السنة ال","https://www.aldiwan.net/poem36244.html","البسيط"],[48,"أمسي وأمسي في شحط وإن غدي","https://www.aldiwan.net/poem23515.html","البسيط"],[19,"يا عين جودي على عمرو بن مسعود","https://www.aldiwan.net/poem332.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142406","البسيط"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2241","البسيط"],[108,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[128,"فتنتك تذكارات ميه","https://www.aldiwan.net/poem23746.html","مجزوء الكامل"],[147,"لو لم يقد نحوك العدى الرغب","https://www.aldiwan.net/poem11737.html","المنسرح"],[182,"عذراً يا شعر","https://www.aldiwan.net/poem50707.html","أحذ الكامل"],[230,"صوت الوطنية","https://www.aldiwan.net/poem24224.html","عموديه"],[233,"ما قال أوه لفقده واها","https://www.aldiwan.net/poem51256.html","المنسرح"],[275,"ألسيع صل ماله من راقى","https://www.aldiwan.net/poem52118.html","الكامل"],[353,"المطل والونمعد أذى","https://www.aldiwan.net/poem15799.html","مجزوء الرجز"],[372,"يا ذات أجوارنا قومي فحيينا","https://www.aldiwan.net/poem1883.html","البسيط"],[420,"رمى ولم يرم عن قوس ولا وتر","https://www.aldiwan.net/poem54110.html","البسيط"],[420,"خذ بالمسرة واغنم لذة الطرب","https://www.aldiwan.net/poem54116.html","البسيط"],[461,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[464,"الق الحدائج ترع الضمر القود","https://www.aldiwan.net/poem15103.html","البسيط"],[464,"لا ثل عرشكم بني أسد","https://www.aldiwan.net/poem15170.html","أحذ الكامل"],[464,"خل التغزل للمشوق المغرم","https://www.aldiwan.net/poem15296.html","الكامل"],[464,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[466,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[554,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[554,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[856,"","https://poetry.dctabudhabi.ae/diwan/poem/18049","الكامل"]],"verses":[["المُطعِمونَ إِذا السُنونُ تَتابَعَت","مَحلاً وَضَنَّ سَحابُها بِسِجالِ",0,"ل",1,0],["المُطعِمو اللَحمَ إِذا ما شَتوا","وَالجاعِلو القوتِ عَلى الياسِرِ",1,"ر",1,0],["المُطعِمونَ إِذا هَبَّت شَآمِيَةً","وَالجابِرونَ وَعَظمُ الرَأسِ مَهزولُ",2,"ل",1,0],["المُطعِمونَ الجَفنَةَ المُدَعدَعَه","وَالضارِبونَ الهامَ تَحتَ الخَيضَعَه",3,"ع",2,0],["أَلمُطعِمونَ إِذا سِنو","نَ المَحلِ تُصبِحُ راكِدَه",4,"د",2,0],["المُطعِمونَ إِذا هَبَّت شَآمِيَةٌ","غَبراءُ يَحجَرُ مِن شَفّانِها الصَرِدِ",5,"د",1,0],["آل مطران لو أتيت بوحى","لم أزدكم من الحجى والرشاد",6,"د",1,0],["المُطعِمونَ إِذا الصَبا بَرَدَت لَهُم","وَالطاعِنونَ نُحورَ كُلِّ قَبيلِ",7,"ل",1,0],["أَلَمَّ طَيفٌ فَهاجَ لي طَرَبي","لَيلَةَ بِتنا بِجانِبِ الكُثُبِ",8,"ب",1,1],["المُطعِمينَ الشَحمَ فَو","قَ الخُبزِ شَحماً كَالأَنافِح",9,"ح",1,0],["المُطعِمونَ الطَعامَ في السَنَةِ ال","أَزمَةِ وَالفاعِلونَ لِلزَّكَواتِ",10,"ت",1,1],["أَلِمُطعِمي الضَيفَ عَن يُسرٍ وَعَن عَدَمٍ","وَالشاهِدِيُّ الحَربَ مِن رَجلٍ وَفُرسانِ",11,"ن",1,0],["المُطعِمُ الحيَّ وَالأَمواتَ إِن نَزَلو","شَحمَ السَنامِ مِنَ الكومِ المَقاحيدِ",12,"د",1,0],["ألمطمئن وجمر الثأر في دمه","خابت رياحك هذا الجمر ما همدا",13,"د",2,0],["المُطعِمُ الحيَّ وَالأَمواتَ إِن نَزَلوا","شَحمَ السَنامِ مِنَ الكومِ المَقاحيدِ",14,"د",1,0],["المطلبُ الأسمى الذي من أجله","ذَهبَ الضحايا، لم يزل مفقودا",15,"د",2,0],["المطعمين الناس والطاوين","في السنة الردية",16,"ي",2,0],["المَطَرُ الجَودُ إِن هُمُ سُئِلوا","وَالعَدَدُ الدَثرُ إِن هُمُ رَكِبوا",17,"ب",3,0],["المطلعُ الشِّعريُّ بلَّلَهُ","دمعُ الجوى من محْجِر المُقَلِ",18,"ل",1,0],["المطايا حين تخشى حتفها","تُعطب السائق من دون العطَب !",19,"ب",1,0],["المُطْفئ الحرب كلّما أضطرمتْ","وفارسُ الخيل حين يَلقاها",20,"ا",3,0],["المَطى اذا مررت بذى اللقا","نَبكي الرسوم وَلَو بقدر فواق",21,"ق",1,0],["المَطلُ وِالوَنمعدِ أَذىً","يُبطِلُ حَقَّ الصِدَقَه",22,"ق",2,1],["المُطْعِمُونَ إذا هبَّتْ شآمِيَّةٌ","وخَيْرُ نادٍ رآهُ النَّاس نادِينا",23,"ن",2,0],["المطلقون لساني بالثناء على","تلك الشمائل بعد العيِّ والحصر",24,"ر",1,0],["المطمعين بنيل المجد أنفسهم","لا يسأمون من الإقدام في الطلب",25,"ب",1,0],["المطعمون الهَبْرَ وال","عامُ عبوسٌ مقشَعِرّْ",26,"ر",1,0],["المطعمون وأرض الحي مُكْديةٌ","والمقدمون إذا فرَّ الرعاديدُ",27,"د",1,0],["المُطْعِمينَ الطَّاعنين إذا","مطر الوشيجُ وأكْدتِ الدِّيمُ",28,"م",1,0],["المُطْعمين بكل ليلٍ حالكٍ","والطاعنينَ بكل يومٍ أقْتَمِ",29,"م",1,0],["المَطاعيمُ إِذا عَزَّ الحيَا","والمَطاعينُ إِذا جَدَّ الوَهَلْ",30,"ل",1,0],["المطمننة تحت أحكام القضا","المستجنة بالتقى النورانيه",31,"ي",2,0],["المُطعِمين إذا السّنونُ تكالحتْ","واِغبرّ في النّاسِ الزّمان المُمحلُ",32,"ل",1,0],["المُطعمين على خَصْبٍ ومَسْغَبَةٍ","والمنعمين على عُسرٍ وإيسارِ",33,"ر",1,0],["المُطعِمونَ إِذا النُجومُ خَوَت","وَأَحاطَ بِالمُتَوَحِّدِ المَحلُ",34,"ل",1,0]]}