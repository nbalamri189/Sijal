com/ViewPoem.aspx?id=3162",""],[64,"عَقُدْ النبوّة مِصْباح من النور","https://www.poetsgate.com/ViewPoem.aspx?id=8509",""],[99,"نزار","https://www.poetsgate.com/ViewPoem.aspx?id=16937",""],[51,"عاصيتُ كلَّ هوى مُطاعِ","https://www.poetsgate.com/ViewPoem.aspx?id=29479",""],[51,"يا ذا الذي كُنْيتي","https://www.poetsgate.com/ViewPoem.aspx?id=29389",""],[51,"أما الزمانُ إلى سلمى فقد جَنَحا","https://www.poetsgate.com/ViewPoem.aspx?id=27419",""],[20,"طال الليل علينا واِعتكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69774&r=&rc=15",""],[94,"تحيّة وفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67406&r=&rc=93",""]],"verses":[["أَذاتَ الطَوقِ لَم أُقرِضكِ قَلبي","عَلى ضَنّي بِهِ لِيَضيعَ دَيني",0,"ي",1,1],["أَذاتَ الطَوقِ تَجلو في","هِ بَرّاقَ الطُلى لَينا",1,"ن",2,0],["إِذا تَلَفَّتُّ في أَطلالِها اِبتَدَرَت","لِلعَينِ وَالقَلبِ أَمواهٌ وَنيرانُ",2,"ن",1,0],["إِذا تَنادوا لِلِّقاءِ فَيلَقٌ","تَداوَلوا الأَعناقَ مِن أَسرٍ وَمَن",3,"ن",1,0],["إِذا تَخَطّى عَجاجَةً زَحَفاً","آراؤُهُ وَالرِماحُ تَنهَزِمُ",4,"م",1,0],["إِذا تَوَجَّسَ كانَ القَلبُ ناظِرَهُ","وَالقَلبُ يَنظُرُ ما لا يَنظُرُ البَصَرُ",5,"ر",1,0],["إِذا تَناءَت بِنا قُلوبٌ","فَلا تَدانَت بِنا دِيارُ",6,"ر",1,0],["إِذا تَدَلَّت عَليهِ الشَمسُ أَوحَشَها","تَوَلُّعُ المَورِ بِالأَنهارِ وَالغُدُرِ",7,"ر",1,0],["إِذا تَرَكَت يُمنى يَدَيكَ تَعَلُّقي","فَيا لَيتَ شِعري مِن تَمَسَّكُ مِن بَعدي",8,"د",2,0],["إِذا تَحَرَّقَ أَحشاءُ الفَلا مُلِئَت","مِن رَعيِهِ خاطِرُ الرَئبالِ وَالسيدِ",9,"د",1,0],["إِذا تَكَفَّأْتَ في حِضْنِ الهَوانِ بِها","لَمْ يَأْلَفِ المَشْرَفِيُّ الغِمْدَ مِنْ دَهَشِ",10,"ش",1,0],["إذا تجاذَبْتُما أهْدابَ مَكْرُمَةٍ","حَلَلْتَ في الصّدْرِ منها وهْوَ في الطّرَفِ",11,"ف",1,0],["إذا تَجاذَبْنَ فروعَ الأهْدالْ","تَكْرَعُ منْ رَشْحِ الحَيا في أوْشالْ",12,"ل",1,0],["إِذا تَلِفتُ اِشتِياقاً زادَني كَمَداً","أَلّا يَكونَ قَريباً مِنِّيَ السَكَنُ",13,"ن",1,0],["إِذا تَعَمَّدتُكُم جاوَزتُ بابَكُمُ","كَي لا تَكونُوا لإِقبالي وَإِدباري",14,"ي",1,0],["إِذا تَرَحَّلَ مَن هامَ الفُؤادُ بِهِم","فَما أُبالي أَقامَ الحَيُّ أَم ساروا",15,"ر",3,0],["إذا تنقَّصَكَ الزّمانُ ببَلْدَةٍ","فاطْوِ المَراحِلَ كيْ تَحوزَ كَمالا",16,"ل",2,1],["إِذا تُعالِجُ قِرناً ساعَةً فَتَرَت","وَاِهتَزَّ مِنها ذَنوبُ المَتنِ وَالكَفَلُ",17,"ل",1,0],["إِذا تَقومُ يَضوعُ المِسكُ أَصوِرَةً","وَالزَنبَقُ الوَردُ مِن أَردانِها شَمِلُ",17,"ل",1,0],["إِذ أَتَتكُم شَيبانُ في شارِقِ الصُب","حِ بِكَبشٍ تَرى لَهُ قُدّاما",18,"م",2,0],["إِذا تَلَوّى بِلَحمِ الشاةِ تَبَّرَها","أَشلاءَ بُردٍ وَلَم يَجعَل لَها وَضَما",19,"م",2,0],["إِذا تَأَمَّلتَ في صُنعِ الإِلَهِ بِها","لَم تَلقَ في وَشيِهِ صُنعاً لِإِنسانِ",20,"ن",1,0],["إِذا تَصَفَّحتَ ديواني لِتَقرَأَني","وَجَدتَ شِعرَ المَراثي نِصفَ ديواني",20,"ي",1,0],["إِذا تَأَوَّدَ آدَتهُ رَفاهِيَةً","تومُ العُقودِ وَأَدمَتهُ البُرى لينا",21,"ن",2,0],["إِذا تَأَمَّلتَ حُبّي غِبَّ غَشِّهِمِ","لَم يَخفَ مِن فَلَقِ الإِصباحِ مُنصَدِعُ",22,"ع",1,0],["إِذا تَبَّعتهُم طَرفَها حالَ دونَها","رَذاذٌ عَلى إِنسانِها يَتَرَيَّعُ",23,"ع",1,0],["إِذا تَلَأَّمَ في زَغفٍ مُضاعَفَةٍ","وَصارِمٍ مِثلِ لَونِ المِلحِ جَرّادِ",24,"د",1,0],["إِذَا تَوَلَّى جَبْرِيلُ وَلَّى","مِيكَالُ يَقْفُوهُ فِي الرِّكَابِ",25,"ب",1,0],["إِذَا تَعَاظَمَتِ الجُلَّى فَنَائِلُهُ","تَرَاهُ فَوْقَ مَرَامِي الفَضْلِ قَدْ عَظُمَا",26,"م",2,0],["إِذَا تَجَلَّى لَكَ الإِلْهَامُ مُزْدَهِراً","فِي مُقْلَتَيْهِ فَلا تَنْظَرْ إِلَى الأَدَمِ",27,"م",1,0],["إِذَا تَكَلَّمَ أَصْغَتْ كُلُّ جَارِحَةٍ","إِلَيْهِ لا الكَدُّ يَثْنِيهَا وَلا السَّأَمُ",28,"م",1,0],["إِذَا تَوَخَّى جَدِيداً وَالصَّلاحُ بِهِ","رُدَّ الفَسَادُ وَلَمْ يَشْفَعْ لَهُ القِدَمُ",28,"م",1,0],["إِذَا تَجَلَّتْ قَالَ المُحَييِّ","عَلَيْكَ يَا مَرْيَمُ السَّلامُ",29,"م",1,0],["إذَا تَعِبَ الجُنُودُ فَلَيْسَ بِدْعٌ","بِأَنْ لاَ يَتْعَبَ المَلِكُ الهُمَامُ",30,"م",1,0],["إِذا تَوَجَّسَ رِكزاً مِن سَنابِكِها","أَو كانَ صاحِبَ أَرضٍ أَو بِهِ المومُ",31,"م",1,0],["إِذا تَنازَعَ جالا مَجهَلٍ قَذَفٍ","أَطرافَ مُطَّرِدٍ بِالحَرِّ مَنسوجِ",32,"ج",1,0],["إذا تيمَّمْتَ أرضاً وهي مجدبةٌ","فرحمةُ الله بالسقيا تُحيِّيها",33,"ي",3,0],["إذا تدعو الرجال به لخيرٍ","يجيبك من تخاذلهم مجيب",34,"ب",1,0],["إذا تختبرهم في الحياة تجد لهم","حياةً تخطّت خُطة السعداء",35,"ا",2,0],["إذا تعشّقت هنداً","منحتني وصل دَعد",36,"د",1,0],["إذا تصّورت في يوم خلائقه","فقد تصوّرت منها روضة أنفا",37,"ف",2,0],["إِذا تَغَيَّظَ حاديهُنَّ ظَلَّ لَهُ","مِنهُنَّ يَومٌ إِذا اِعصَوصَبنَ عُصوادُ",38,"د",1,0],["إِذا تَذارَعنَ يَوماً بُعدَ مُنخَرَقٍ","مالَت بِهِنَّ بَنو مُلطٍ وَأَعضادُ",38,"د",1,0],["إِذا تَيمٌ ثَوَت بِصَعيدِ أَرضٍ","بَكى مِن خُبثِ ريحِهِمُ الصَعيدُ",39,"د",1,0],["إِذا تَقادَمَ عَهدُ الحَيِّ هَيَّجَني","خَيالُ طَيِّبَةِ الأَردانِ مِعطارِ",40,"ر",1,0],["إِذا تَذَكَّرتَ شَجواً مِن أَخي ثِقَةٍ","فَاِذكُر أَخاكَ أَبا بَكرٍ بِما فَعَلا",41,"ل",2,1],["إِذا تَذَكَّرتُهُ فاضَت بِأَربَعَةٍ","عَيني بِدَمعٍ عَلى الخَدَّينِ مُحتَتِنِ",42,"ن",1,0],["إذا تسابق للعلياءِ ذو خطرٍ","سعى فأدركَ تبعيداً بتقريب",43,"ب",1,0],["إذا تعمَّق في نعماء ضاعفها","كأنَّ كلّ نهاياتٍ بدايات",44,"ت",1,0],["إذا تبينت ما صناعته","رنا بلحظٍ وقال فولاذي",45,"ي",1,0],["إذا تفرْعَن خطبٌ أنت خائفهُ","فقل أجرني من فرعون يا موسى",46,"س",2,0],["أذاتَ الحجى إن الحجاب ليمنع","عن اللفظ حتى في رثائك يسمع",47,"ع",1,1],["إذا تسمى الجواد بحراً","فبحرها في الفلا سريع",48,"ع",1,0],["إذا تفرزنَ في الطاغين بندقهم","فرأسه بتراب الحتف ينمعك",49,"ك",1,0],["إذا تثاقل عسرٌ باتَ في يدِه","تبرٌ يصرّف مثقالاً بمثقال",50,"ل",1,0],["إذا تمثل أهل المجد همته","خرُّوا لعزَّتها صمًّا وعميانا",51,"ن",2,0],["إذا ترآى بقر الوحش انْدفع","كأنه المرِّيخ في الثور طلع",52,"ع",1,0],["إذا تأمَّلت المقام الناصريّ","فاعْقد عليهِ أكرم الخناصر",52,"ر",1,0],["إِذا تَجَلّى بِطَوري أَن يُكَلِّمَني","رَأَيتُ في غَيبَتي موسى عَلى الطورِ",53,"ر",1,0],["إذا تطاوَل يوماً في مُطالبةٍ","فكَنِّهِ يتطامنْ وهو مرعوبُ",54,"ب",1,0],["إذا تَمَشَّى يكاد يجذبه","رِدفٌ له كالكَثِيب رَجْراجُ",55,"ج",1,0],["إذا تعاصتْ قينةٌ مرةً","فلا تُجمِّشْها بتفَّاحَهْ",56,"ح",2,1],["إذا تذكرتُ مديحي له","حسبته من كبدي يُفلَذُ",57,"ذ",1,0],["إذا تعاطتْ منالهنّ يدي","أعجزْنَ إلا تناوشَ الفِكَرِ",58,"ر",1,0],["إذا تلَّوى على مُجالسِهِ","في الحفل عاينْتَ شُهرة الشُّهر",59,"ر",1,0],["إذا تناولها من كان يألفها","في يوم دَجْن كثير الطَّلِّ والنور",60,"ر",1,0],["إذا تغنَّت رحلت نِعمةٌ","عن أهلها وانصرفتْ غِبطَهْ",61,"ط",2,0],["إذا تطاولت فاذكر","أن الرياح ستُعصِفْ",62,"ف",1,1],["إذا تعاطى مغرق مدحه","أقصر والتقصير إغراقه",63,"ق",2,0],["إذا ترعرعَ فهْو الدهرَ هِمَّتُهُ","وفي يديهِ إلى الأبياتِ منقولُ",64,"ل",1,0],["إذا تغنَّتْ شنطفٌ مرّةً","فاصفعْ ودعْ عنك الأَباطيلا",65,"ل",2,1],["إذا تغنّتْ سطعتْ نكهةٌ","تتركنا عنها مشاغيلا",65,"ل",2,0],["إذ أتاني الرسولُ منك بأمرٍ","يشبهُ الموتَ نفسَه أو رسولهْ",66,"ل",2,0],["إذا تغنَّى النديمُ ذكَّرهُ","أخْذَ السياق الحثيثِ بالكظمِ",67,"م",1,0],["إذ أُتيحتْ له ضوارٍ وطِمْل","مالهُ غيرَ صَيْدِها من طعام",68,"م",1,0],["إذا ترقْرقْنَ والإشراقُ مضطرمٌ","فيهنَّ لم يَمْلِك الأسرارَ كِتمان",69,"ن",1,0],["إذا تمايلُ في ريح تُلاعِبُهُ","ظلَّتْ طِراباً لها سَجْعٌ وإرنان",69,"ن",1,0],["إذا تَيمَّمكَ العافي فكوكبُهُ","سعْدٌ ومرعاهُ في واديكَ سعدان",69,"ن",1,0],["إِذا تَكَبَّدنَ مِمحالاً مُسَربَلَةً","مِن مُسجَهِرٍّ كَذوبِ اللَونِ مُضطَرِبِ",70,"ب",1,0],["إِذا تَنَزَّلُ مِن عُلِيَّةٍ رَجَفَت","لَولا يُؤَيِّدُها الآجُرُّ وَالقَلَعُ",71,"ع",1,0],["إِذا تَضَمَّنَني بَيتٌ بِرابِيَةٍ","آبوا سِراعاً وَأَمسى وَهوَ مَهجورُ",72,"ر",1,0],["إِذا تَزَغَّمَ مِن حافاتِها رُبَعٌ","حَنَّت شَغاميمُ في حافاتِها كومُ",73,"م",1,0],["إِذا تَساقى النُدامى الراحَ صافِيَةً","كانَت قَوافيكَ في الراحِ الَّتي شَرِبوا",74,"ب",3,0],["إِذا تَرامى عَلى جَديبٍ","أَمسى بِهِ مَربَعاً خَصيبا",75,"ب",2,0],["إِذا تَمَثَّلَ جَيشَ التُركِ مُندَحِراً","ضاقَت بِهِ مِثلَما ضاقَت بِذا الحِيَلُ",76,"ل",1,0],["إِذا تُقاسُ إِلى رَوائِعِهِم","كانَت رَوائِعُهُم لَها خَدَما",77,"م",2,0],["إِذا تَبَسَّمَ لا تَبدو نَواجِذُهُ","وَإِن بَكى فَلَهُ نَزعٌ وَإِرنانُ",78,"ن",1,0],["اذا ترنم يشدو فوق منبره","اصغت اليه من الآفاق آذان",79,"ن",1,0],["اذا تفكرت كانت","للشك بي وخزات",80,"ت",1,0],["إذا تمثلته في اللب طار له","ورفرف القلب حتى خِفت يتبعه",81,"ع",2,0],["إذا تبسم أبدى الكون زينته","وإن تنسم أهدى أى ريحان",82,"ن",1,0],["إِذا تَبَسَّمَ أَبدى الكَونُ زينَتَهُ","وَإِن تَنَفَّسَ أَهدى طيبَ رَيحانِ",83,"ن",1,0],["إِذا تَفَرَّقتُمُ في الغَربِ أَلسِنَةً","لَيَّنتُمُ كُلَّ قَلبٍ لَم يَكُن لانا",84,"ن",2,0],["إِذا تَرَكَ الإِنسانُ أَهلاً وَرائَهُ","وَيَمَّمَ كافوراً فَما يَتَغَرَّبُ",85,"ب",1,0],["إِذا تَذَكَّرتُ ما بَيني وَبَينَكُمُ","أَعانَ قَلبي عَلى الشَوقِ الَّذي أَجِدُ",86,"د",1,0],["إِذا تَغَلغَلَ فِكرُ المَرءِ في طَرَفٍ","مِن مَجدِهِ غَرِقَت فيهِ خَواطِرُهُ",87,"ر",2,0],["إِذا تَرَحَّلتَ عَن قَومٍ وَقَد قَدَروا","أَن لا تُفارِقَهُم فَالراحِلونَ هُمُ",88,"م",1,0],["إِذا تَوافَقَتِ الضَرباتُ صاعِدَةً","تَوافَقَت قُلَلٌ في الجَوِّ تَصطَدِمُ",89,"م",1,0],["إِذا تَوَلَّوا عَداوَةً كَشَفوا","وَإِن تَوَلَّوا صَنيعَةً كَتَموا",90,"م",3,0],["إذا تغير لون غيرت اسمه","وإسم وحيّر أوهام وأفهامُ",91,"م",1,0],["إِذا تغنَّى حمامُ الأيكتينِ هفا","بلُبِّه سجعُ بادي الشجوِ مِرنَانِ",92,"ن",1,0],["إِذا تَبَدّى بِزَيدِ الخَيلِ لاءَمَهُ","بِحاتَمِ الجودِ شَعباً جِدَّ مَرؤوبِ",93,"ب",1,0],["إِذا تَشاكَلَتِ الأَخلاقُ وَاِقتَرَبَت","دَنَت مَسافَةُ بَينَ العَجمِ وَالعَرَبِ",94,"ب",1,0],["إِذا تَخَطَّفَهُ المِضرابُ حَرَّكَ في","سِرِّ القُلوبِ سُروراً جِدَّ مُهتاجِ",95,"ج",1,0],["إِذا تَأَمَّلتَ فَتى مَذحِجٍ","مَلَأتَ عَيناً رَمَقَت سُؤدَدَه",96,"د",2,0],["إِذا تَجَروا في سُؤدَدٍ وَتَزايَدوا","فَأَنفَقُ ما أَبضَعتَ عِندَهُمُ الشِعرُ",97,"ر",1,0],["إِذا تَعاطى الرِجالُ مَجداً","بَذَّهُمُ سَبقُهُ المُبِرُّ",98,"ر",1,0],["إِذا تَعاظَمَني أَمرٌ فَزَعتُ إِلى","شِعري وَوَجَّهتُ أَجمالي وَأَفراسي",99,"س",2,0],["إِذا تَوَقَّعنا نَواها جَرَت","سَواكِبٌ يَحمَرُّ فيها النَجيع",100,"ع",1,0],["إِذا تَيَمَّمَ قَصدَ الغَربِ مالَ بِهِ","تِلقاءَ قَصدِكَ في شَرقٍ تَشَوُّقُهُ",101,"ق",2,0],["إِذا تَصَعَّبَتِ الأَيّامُ قَلَّدَها","رَأياً يَرُدُّ شَبا الأَيّامِ عَن فَلَلِ",102,"ل",1,0],["إِذا تَواصى بِيَ الطائِيُّ لَم أَرَ لِل","حِرمانِ شَخصاً وَلَم يَعلُق بِيَ الشومُ",103,"م",1,0],["إِذا تَجَلَّت لَهُ الدُنيا بِحِليَتِها","رَأَت مَحاسِنَها الدُنيا مَساويها",104,"ي",3,0],["إِذا تَكَلَّمَ لَم يَدخُل صَريمَتَهُ","هَزلٌ وَلا كانَ غَيرَ الجِدِّ يَعنيهِ",105,"ي",2,0],["إِذا تَرَكوا مِنهُنَّ كُلَّ شِمَلَّةٍ","إِلى رَخَماتٍ بِالطَريقِ وَأَذؤُبِ",106,"ب",1,0],["إِذا تَقاعَسَ صَعبٌ في خِزامَتِهِ","أَو إِن تَعَرَّضَ في خَيشومِهِ صَيَدُ",107,"د",1,1],["إِذا تَرَحَّلَ أَقوامٌ أَجَرتَهُمُ","عادَت إِلَيكَ بِما يَثنونَ عُوّادُ",108,"د",1,0],["إِذا تَرَوَّحَ عَنها البَردُ حُلَّ بِها","حَيثُ اِلتَقى بِأَعالي الأَسهُبِ العَكَرُ",109,"ر",1,0],["إِذاً تَدَهدَأَ عَنهُ حينَ أَضرِبُهُ","كَما تَدَهدى عَنِ الزُحلوفَةِ الحَجَرِ",110,"ر",1,0],["إِذا تَعَشّى عَتيقَ التَمرِ قامَ لَهُ","تَحتَ الخَميلِ عِصارٌ ذو أَضاميمِ",111,"م",1,0],["إذا تنفس فيه ريح نرجسها","تاغى جي خزاماها بنفسجها",112,"ج",3,0],["إذا تُرِكَ الشُّجاعُ بِغَيْرِ قَلْبٍ","فكَيفَ يَكوُنُ في قلبِ الجَبانِ",113,"ن",1,0],["إذا تأمَّلَها الزَّورُ المُلِمُ ثَوى","يَحُطُّ بالدَّمْعِ أثقالاً منَ الأَلمِ",114,"م",1,0],["إذا تخطَّفَ من أولادِنا ولداً","قامتْ بمِثْلِ قوافيه نوادبُه",115,"ب",2,0],["إذا تجلَّى جلا الخدَّينِ في خَفَرٍ","وإن تثنَّى ثَنى العِطْفَينِ من تَعَبِ",116,"ب",1,0],["إِذا تَمَّ أَمرٌ بَدا نَقصُهُ","تَوَقَّ زَوالاً اِذا قيلَ تَمّ",117,"م",1,0],["إِذا تَمَثَّلَ لي كَربُ السِياقِ وَقَد","قَلَّبتُ طَرفي وَقَد رَدَدتُ غُصَّتِيَه",118,"ت",3,0],["إِذا تَعَمَّمَ بِالمِنديلِ مُنطَلِقاً","لَم يَخشَ نَبوَةَ بَوّابٍ وَلا غَلَقِ",119,"ق",1,0],["إِذا تَرَنَّمَ ساوى وَزنَ نَغمَتِهِ","وَإِن عَلا جاءَ بِالتَرخيمِ في الأَثَرِ",120,"ر",1,0],["إِذا تَلاهُ الوُفدُ قالَ الوَرى","هَذا هُوَ السِحرُ الحَلالُ المُباح",121,"ح",1,0],["إِذا تَأَبَّطَهُ الشادي وَأَذكَرَهُ","عَصرَ الشَبابِ بِأَطرافِ الأَظافيرِ",122,"ر",1,0],["إذا تساءلتُ عمَّا خَلفَ أسطرها","رَنَا إليَّ بعينيه فأَوَّلَها",123,"ل",3,0],["إذا تحيّرنا فقولوا لنا","أكان رضوى حِلمُهُ أم شَمام",124,"م",1,0],["إذا تَبِينُ سماءٌ عن عجاجَتِها","كَانَت لَهُم سمهَرِيَّاتُ القَنا عَمَدا",125,"د",2,0],["إِذا تَظَلَّمتَ مِن أَرضٍ فُصِلتَ بِها","كانَت هِيَ العِزُّ إِلّا أَنَّها ذُلُلُ",126,"ل",1,0],["إِذا تَذَكَّرتُكَ ذَكَّرتَني","قَد ذَلَّ مَن لَيسَ لَهُ ناصِرُ",127,"ر",1,0],["إِذا تَيَمَّمناهُ في مَطلَبٍ","كانَ قَليباً أَو رِشاءَ القَليبِ",128,"ب",1,0],["إِذا تَباعَدَتِ الدُنيا فَمَطلَبُها","إِذا تَوَرَّدتَهُ مِن شِعبِهِ كَثَبُ",129,"ب",1,0],["إِذا تَنَسَّمتُ مِنها نَفحَةً لَعِبَت","بِيَ الصَبابَةُ لِعبَ الريحِ بِالعَلَمِ",130,"م",1,0],["إِذا تَذَكَّرتُهُ لاحَت مَخائِلُهُ","لِلعَينِ حَتّى كَأَنّي مِنهُ في حُلُمِ",130,"م",1,0],["إِذا تَلَفَّتُّ حَولي لَم أَجد أَثَراً","إِلا خَيالي وَلَم أَسمَع سِوى كَلِمي",130,"م",2,0],["إذا تعذَّرَ حبي","فخلِّهِ يتعذرُ",131,"ر",1,1],["إذا تبَسَّمَ ليلاً قُلْ لمبسمِهِ","يا ساهرَ البرقِ أيقظْ راقدَ السمُرِ",132,"ر",1,0],["إِذ أَتانا لَيلَةً وَجِلاً","مِن عُيونِ الخانَةِ العُذلِ",133,"ل",1,0],["إذا تَداوَى بها المغلوبُ طَاحَ بهِ","كَيدُ الأُساةِ وتضليلُ العقاقيرِ",134,"ر",1,0],["إِذا تابَ العُصاةُ عَنِ الخَطايا","فَحَسبُكَ أَن تَتوبَ عَنِ الحِمايَهْ",135,"ا",3,0],["إِذا تَدافَعَ فيها جَحفَلٌ لَجِبٌ","خاضَ الحُتوفَ إِلَيهِ جَحفَلٌ لَجِبُ",136,"ب",1,0],["إذا تدفَّقَ دِينُ المرءِ في دمِهِ","سَرَتْ معانِيهِ في رُوحٍ وجُثمانِ",137,"ن",1,0],["إذا تركَ القومُ الجهادَ رأيتهم","وإن أشبهوا الأحياءَ مَوْتَى من الخَوَرْ",138,"ر",1,0],["إِذا تَكَلَّمَ أَصغى الدَهرُ مُستَمِعاً","كَما يُصيخُ لِداعي الماءِ ظَمآنُ",139,"ن",1,0],["إِذا تَخَوَّفتُ مِن شَيءٍ أَقُولُ لَهُ","قَد جَفَّ فامضِ بِما قَد قُدِّرَ القَلَمُ",140,"م",1,0],["إِذا تَغَنّى رافِعاً صَوتَهُ","حَسِبتَهُ سِنوَرَةً تُذبَحُ",141,"ح",1,0],["إِذا تَعَرّى البَرقُ فيها خِلتَهُ","بَطنَ شُجاعٍ في كَثيبٍ يَضطَرِب",142,"ب",1,0],["إذا تَفَكَّرْتَ في المُسْتَخْدمينَ بَدَا","منهم لِعَيْنَيْكَ ما لم يُبْدِهِ النَّظَرُ",143,"ر",1,0],["إذا تَثَنّى تَثَنّتْ سمهَرِيّتُهُ","فاعجَبْ لما شئتَ من خوطٍ وخَطّيّ",144,"ي",1,0],["إذا تلاقَى الضّرْبُ والطّعْنُ مِنْ","أيديهمُ صَدْقاً على صَدْق",145,"ق",1,0],["إِذا تَغَنَّينَ لا يُبقينَ جانِحَةً","إِلّا بِها طَرَبٌ يُشفى بِهِ الداءُ",146,"ا",2,0],["إِذا تَفَكَّرتُ في هَوايَ لَهُ","مَسَستُ رَأسي هَل طارَ عَن جَسَدي",147,"ي",1,0],["إِذا تَأَمَّلتَهُ تَعاظَمَكَ ال","إِقرارُ في أَنَّهُ مِنَ البَشَرِ",148,"ر",1,0],["إِذا تَلَبَّثتُ عَنها ساقَ بي كَلَفٌ","بَرحٌ وَأَوجَفَني وَجدٌ بِها عَجِلُ",149,"ل",1,0],["إِذا تَكَرَّهتَ أَن تُعطي القَليلَ وَلَم","تَقدِر عَلى سَعَةٍ لَم يَظهَرِ الجودُ",150,"د",1,0],["إِذا تَلقَهُم لا تَلقَ لِلبَيتِ عَورَةً","وَلا الجارَ مَحروماً وَلا الأَمرَ ضائِعا",151,"ع",2,1],["إِذا تَغَنّى الحَمامُ الوُرقُ هَيَّجَني","وَإِن تَغَرَّبتُ عَنها أُمِّ عَمّارِ",152,"ر",1,0],["إِذا تَعَطَّفتِ يَوماً كُنتِ قاسِيَةً","وَإِن نَظَرتِ بِعَينٍ فَهيَ شَوساءُ",153,"س",3,0],["إِذا تَفَكَّرتَ فِكراً لا يُمازِجُهُ","فَسادُ عَقلٍ صَحيحٍ هانَ ما صَعُبا",154,"ب",2,0],["أَِذا تَلَبَّسَ بِالشُجعانِ جَنبَهُمُ","وَبِالكِرامِ أَسَرُّ الضَنِّ أَو صَلَدوا",155,"د",3,0],["إِذا تَمَّ في ما تُؤنَسُ العَينُ مَضجَعي","فَزِدني هَداكَ اللَهُ مِن سَعَةٍ شُبرا",156,"ر",2,0],["إِذا تَخَلَّفَت أَو خُلِّفتُ عَن أَمَلٍ","سَلّى هُمومِيَ أَنّي لَيسَ لي خَلَفُ",157,"ف",1,0],["إِذا تَوَلَّت عَلى هَجرٍ وَمَقلِيَةٍ","فَلا تَعَرَّضَ لَها في النَومِ إِلماما",158,"م",2,0],["إِذا تَلَوا عِظَةً فَالأَنا","مُ لا يَأذَنونَ لِما يَتلُوانِ",159,"ن",1,0],["إذا تَرَنّمَ شادٍ لليَرَاعِ به","لاقى المَنايا بلا خوْفٍ ولا فَرَقِ",160,"ق",1,0],["إِذا تَخَمَّطَ جَبّارٌ ثَنَوهُ إِلى","ما يَشتَهونَ وَلا يُثنَونَ إِن خَمِطوا",161,"ط",3,0],["إِذا تَوطَّتْ حُزونُ أرضٍ","طحْطحتِ الشُّمُّ من رُباها",162,"ا",3,0],["اذا تجنبته جر","رني إليه النزاع",163,"ع",1,0],["إذا ترحلت عنها","فبالسلام تشاع",163,"ع",1,0],["إذا تصور ما للكون من سعة","عقل الحكيم بحق فهو ينذهل",164,"ل",1,0],["إِذا ترحلت عنهم","فالذَنبُ لَيسَ بِذَنبي",165,"ي",1,0],["إذا تَناكر زوجا","ن فالفراق علاج",166,"ج",1,0],["إذا تساهل شعبٌ","مَشى إليه الشتاتُ",167,"ت",1,1],["إذا ترحّلت عن قومٍ وقد قدروا","ألاّ تفارقهم فالرّاحلون هم",168,"م",1,0],["إذا تَفَقَّهَ أحْيَا مالِكاً جَدَلاً","ويَنْشُرُ المَلِكَ الضِّلّيلَ إنْ شَعَرا",169,"ر",2,0],["إذا تنافست الجهال في حلل","رأيتني وخسيس القطن سربالي",170,"ي",1,0],["إذا تأملته والفلك تعبره","بذلك البحر منسدا وما انفلقا",171,"ق",2,0],["إذا تأملت بشراً منه مقتبلاً","عرفت من مبتداه في الندى خبره",172,"ر",2,0],["إذ أتاني نَبَأُ مشن مُنعِمٍ","لَم أَخُنهُ والَّذي أَعطَى الخَبَر",173,"ر",1,0],["إِذَا تَلَفَّتُّ لَمْ أُبْصِرْ سِوَى صُوَرٍ","فِي الذِّهْنِ يَرْسُمُهَا نَقَّاشُ آمَالِي",174,"ي",1,0],["إِذَا تَذَكَّرْتُكَ فِي خَلْوَةٍ","هَوَتْ بِدَمْعِي زَفْرَةٌ تَرْتَقِي",175,"ي",1,0],["إِذَا تَبَسَّمَ فَاضَتْ رَاحَتَاهُ لَنَا","جُوداً وَمَا كُلُّ بَرْقٍ خَلْفَهُ مَطَرُ",176,"ر",1,0],["إِذَا تَلاهَا لِسَانُ الشُّكْرِ قَامَ لَهَا","حُبَّاً بِذِكْرِ عُلاكَ الْبَدْوُ وَالْحَضَرُ",176,"ر",1,0],["إِذا تَفَشَّتْ بِمُهْجَةٍ قَتَلَتْ","كَمَا تَفَشَّى فِي الْمَبْرَكِ الْجَرَبُ",177,"ب",1,0],["إِذَا تَلَفَّتُّ لَمْ أَلْمَحْ أَخَا ثِقَةٍ","يَأْوِي إِلَيَّ ولا يَسْعَى لإِنْجَادِي",178,"ي",1,0],["إِذَا تَذَكَّرْتُ أَيَّامَاً بِهِمْ سَلَفَتْ","تَحَدَّرَتْ بِغُرُوبِ الدَّمْعِ آمَاقِي",179,"ي",1,0],["إِذَا تَنَفَّسْتُ فَاضَتْ زَفْرَتِي شَرَراً","كَمَا اسْتَنَارَ وَرَاءَ الْقَدْحَةِ اللَّهَبُ",180,"ب",1,0],["إِذَا تُلِيَتْ آيَاتُهَا فِي مَقَامَةٍ","تَنَافَسَ قَلْبٌ فِي هَوَاهَا وَمسْمَعُ",181,"ع",1,0],["إِذَا تَجَلَّى الكَمالُ فِيهَا","فَأمُّهَا صُورَةُ الكَمَالِ",182,"ل",1,0],["إِذَا تَحَلَّى عِصَامِيٌّ بِرُتْبَتِهِ","فَهْوَ الْمُحَلَّى بِمَا يُوفَى عَلَى الْرُّتَبِ",183,"ب",1,0],["إِذَا تَوَخَّى الثَّنَاءَ أَكْمَلَهُ","وَإِنْ تَوَخَّى الْهِجَاءَ ما خَلَّى",184,"ل",2,0],["إِذَا تَرَنَّمَ بَيْنَ الحَفْلِ يُنْشِدُهُ","سَمِعْتَ آيَةَ تَبْيَانٍ وَإِفْصَاحِ",185,"ح",1,0],["إذا تَأَمَّلتُ صَرعى المَوتِ لَم أرَني","مُفرِّقاً بَينَ ضبعانٍ وَضرغامِ",186,"م",1,0],["إذا تعرَّض عِرِّيضٌ بمنكرةٍ","فأنت مذ كنتَ بالمعروف عريض",187,"ض",1,0],["إِذَا تَنَقَّبْنَ إِذْ يَلْقَيْنهُ خَفَراً","فَشَوقُهُنَّ إِليْهِ غَيْرُ مُنْتقِبِ",188,"ب",1,0],["إِذا تُمِّمَتْ من فَيْضِ جَدْواك نِعْمَةٌ","فأَنْتَ بأُخْرَى سَاهِرُ الطَّرْفِ مُولَع",189,"ع",1,0],["إِذَا تَخطَّرَ في الأَفْوَاهِ تُنْشِدُهُ","غَضَّ الْجُفُونَ حَيَاءً كُلُّ خَطَّارِ",190,"ر",1,0],["إذا ترنم أنْسى الناسَ أنفسهُمْ","حتى يذيع الهوى من كان يخفيه",191,"ي",2,0],["إذا تَسمعْتُ خلتُ الموجَ فيك شدَا","بذكرِ مَنْ كوَّنَ الأكوانَ من عدم!",192,"م",1,0],["إذا تحدَّتْ شعوبَ الأرض قاطبةً","أُنثى، فَقُولوا ليوم الحشر يَقْترب!",193,"ب",1,0],["إذا تكلف قول الشعر قائله","فالشعر عندكَ طَبْعٌ غَيْرُ مفتعل",194,"ل",1,0],["إذا تُرك الجُمهورُ يَمضي لشأنه","ويسلُك من أهوائه كلَّ مَخْرِم",195,"م",1,0],["إذا تلاعب قرناً ساعةً فترت","وارتج منها ذنوب المتن والكفل",196,"ل",1,0],["إذا تَبَدّى يَزِيدُ الخَيْلَ لاءِمُهْ،","بحاتِمِ الجُودِ شِعباً، جَدَّ مَرءوبِ",197,"ب",1,0],["إذا تَعَاطَى الرّجَالُ مَجْداً،","بَذّهُمْ سَبهَ المُبِرّ",198,"ر",1,0],["إذا تبينُ سماءٌ عن عجاجتها","كانت لهم سهرياتُ القنا عمدا",199,"د",2,0],["إذا تجلّى لطوري أن يُكَلّمني","رَأَيْتُ في غيبتي موسى على الطور",200,"ر",1,0],["إذا تصفّحتِ يوماً يا بنفسجتي","هذا الكتابَ الذي لا يُشْبِهُ الكُتُبا",201,"ب",2,1],["إذا تفرقتْ الفجا","ج بنا بفرقة لا اجتماع",202,"ع",1,0],["إذا تغنَّت رحلت نِعمة ٌ عن","أهله وانصرفتْ غِبطَهْ",203,"ط",2,0],["إذا تعاصت قنية مرةً","فلا تُجشِّمْها بتفاحهْ",204,"ح",2,0],["إِذ أَتاني نَبَأٌ مِن مُنعِمٍ","لَم أَخُنهُ وَالَّذي أَعطى الشَبَر",205,"ر",1,0],["إذا تأرج ذكر منك أو نبأ","تهلّلت حلب الشهباء تنتظر",206,"ر",1,0]]}