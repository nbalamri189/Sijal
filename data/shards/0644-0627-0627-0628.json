sgate.com/ViewPoem.aspx?id=212305",""],[5126,"لا أبتغي الا لقانا","https://www.poetsgate.com/ViewPoem.aspx?id=206094",""],[5174,"لغة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=185110",""],[5183,"الموقف الحق","https://www.poetsgate.com/ViewPoem.aspx?id=180156",""],[5186,"ورد الربيع شذا من ربع غسان","https://www.poetsgate.com/ViewPoem.aspx?id=156440",""],[5186,"منبت الشاعر الكبير ثراها","https://www.poetsgate.com/ViewPoem.aspx?id=156467",""],[5277,"قد قالها شيخنا","https://www.poetsgate.com/ViewPoem.aspx?id=191012",""],[5277,"صاخبة المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=191161",""],[5277,"دنيا زحلْ..","https://www.poetsgate.com/ViewPoem.aspx?id=194698",""],[5302,"بين خوف وهموم","https://www.poetsgate.com/ViewPoem.aspx?id=201379",""],[5376,"جاد بسْمُ العرْبِ يسري في فمي","https://www.poetsgate.com/ViewPoem.aspx?id=188477",""],[5376,"يا نبيُّ اللهِ يا نورُ السما","https://www.poetsgate.com/ViewPoem.aspx?id=188536",""],[5376,"كفْكفِ الدمعَ الذي ينتابُني","https://www.poetsgate.com/ViewPoem.aspx?id=194867",""],[5397,"أبسفح حاجر منك يسفح محجر","https://www.poetsgate.com/ViewPoem.aspx?id=157963",""],[5413,"أضغاث أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=208591",""],[5431,"لاأبتغي أبدا عن ثغرك العتقا","https://www.poetsgate.com/ViewPoem.aspx?id=193679",""],[5436,"مناجاة بين بوش وكلبه! ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35272",""],[5491,"أنت علمتني بألا أبالي","https://www.poetsgate.com/ViewPoem.aspx?id=215041",""],[5491,"قهوة العطر","https://www.poetsgate.com/ViewPoem.aspx?id=215173",""],[5596,"عيون الحب","https://www.poetsgate.com/ViewPoem.aspx?id=205613",""],[5628,"ابتهالات في محراب الورد","https://www.poetsgate.com/ViewPoem.aspx?id=178665",""],[5660,"الجُرذُ الصَّغير","https://www.poetsgate.com/ViewPoem.aspx?id=25128",""],[5674,"الرمش بحر هادر","https://www.poetsgate.com/ViewPoem.aspx?id=185728",""],[5687,"خيبة صغرى","https://www.poetsgate.com/ViewPoem.aspx?id=208139",""],[5770,"ذكرت لوزان","https://www.poetsgate.com/ViewPoem.aspx?id=178266",""],[5784,"أيها الشاكي","https://www.poetsgate.com/ViewPoem.aspx?id=191242",""],[5926,"صدى الأحباب","https://www.poetsgate.com/ViewPoem.aspx?id=213830",""],[5939,"هي كِبريائي عنكِ حالتْ","https://www.poetsgate.com/ViewPoem.aspx?id=178588",""],[5952,"جمرٌ على الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=202360",""],[5953,"لا أبالي بعد الإجابة بالذرو","https://www.poetsgate.com/ViewPoem.aspx?id=93918",""],[5956,"الصحوة","https://www.poetsgate.com/ViewPoem.aspx?id=182391",""],[5956,"الوحدة واشتهاء الموت","https://www.poetsgate.com/ViewPoem.aspx?id=183881",""],[5956,"ماذا يفيد سؤالٌ لا انتفاع به","https://www.poetsgate.com/ViewPoem.aspx?id=204370",""],[6004,"خيال النَّدامى","https://www.poetsgate.com/ViewPoem.aspx?id=59141",""],[6093,"جنِّبِ القولَ منكَ (لا ) ( مجزوء الخفيف)","https://www.poetsgate.com/ViewPoem.aspx?id=181654",""],[6134,"محبوبة قد صد عني","https://www.poetsgate.com/ViewPoem.aspx?id=169594",""],[6134,"هيفاء أزري ميلها الغصونا","https://www.poetsgate.com/ViewPoem.aspx?id=169598",""],[1583,"يا قمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73059&r=&rc=16",""],[6226,"حَيْرَةُ الأَسْئِلَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87719&r=&rc=9",""],[6239,"بَرْزَخٌ من حَجَرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76053&r=&rc=104",""],[463,"تربَّعتْ بينَ العذيبِ فالنَّقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60164&r=&rc=220",""],[6249,"حبٌّ مختَلَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85657&r=&rc=0",""],[6259,"طرقت خيالاً بعد طول صدودها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59364&r=&rc=12",""]],"verses":[["لاأبتَغِي العِزَّ إلاّ من أسِنَّتِها","والموتُ يَنزِلُ والأرواحُ في ظَعنِ",0,"ن",1,0],["لا أَبعَدَ اللَهُ عَن عَيني غَطارِفَةً","إِنساً إِذا نَزَلوا جِنّاً إِذا رَكِبوا",1,"ب",3,0],["لا أُبالي مَتى وِدادُكَ لي صَحَّ","مِنَ الدَهرِ ما تَعَرَّضَ خَطبُ",2,"ب",1,0],["لاَ أُبَالِي بِمَا يَقُول فَهَلاَّ","أَقْصَرَ الْعَذْلُ حَاسِداً لاَ أَبَا لَهْ",3,"ل",2,0],["لا أُبالي أَذى العَدُوِّ فَحُطني","أَنتَ يا رَبِّ مِن وَلاءِ الصَديقِ",4,"ق",1,1],["لا أَبتَغي مِن غَيرِهِ نِعَماً","كَم عُفتُ مِن بِرٍّ تَعَرَّضَ لي",5,"ل",2,0],["لا ابنُ عَمٍّ يُرَى كهذا ولا عَ","مٌّ كهَذَاك سَيِّد الأَعمَامِ",6,"م",1,0],["لا أبعد الله الطيف منه ولا","أصغر فوق العيون ممشاه",7,"ا",2,0],["لا أباً مؤْمِناً يُعَدُّ ولا ابْناً","مُؤْمِناً خابَ قِدْحُه في القداحِ",8,"ح",1,0],["لا أبتغي أبداً بهم بدلاً","لفَّ الإلهُ بشملهم شملي",9,"ل",2,0],["لا أبتغي ما كنْتُ آمُلُ مرَّةً","حسْبي بوجهِك فهو أفضلُ مَغْنمِ",10,"م",1,0],["لا أبتغي غيرَ أخلاقٍ خُصِصتَ بها","دونَ السهام التي فوَّقْتَها جُننا",11,"ن",2,0],["لا أُبالي الفَناءَ إِن كانَ مَجدي","في فَناءِ أَو مَجدُ قَومي",12,"ي",1,0],["لا أُبالي سَطَوةَ الراعي وَلا","الكَلبَ المُجَرَّب وَصِيالَه",13,"ه",1,0],["لا اِبتِسامُ الغيدِ لا رَقصُ الطِلاء","يَتَصَبّاها وَلا شَدوُ الحَمام",14,"م",1,0],["لا أَبتَغي رُخَصَ الهَوى","لي في الهَوى دينٌ مَتينُ",15,"ن",1,0],["لا أُبالي وإنْ أُرِيقَتْ دِمائي","فدِماءُ العُشَّاقِ دوماً مُبَاحَهْ",16,"ح",2,0],["لا أُبغِضُ العيسَ لَكِنّي وَقَيتُ بِها","قَلبي مِنَ الحُزنِ أَو جِسمي مِنَ السَقَمِ",17,"م",1,0],["لا أَبتَغي أَبَداً بِسَلمى خُلَّةً","فَلتَقتَرِب بِالوَصلِ أَو فَلتَهجُرِ",18,"ر",1,0],["لا أبالِي خُنتَني أم","غيَّرَ البعدُ يمينَك",19,"ك",1,0],["لا أبٌ كالذي زَعمتُمْ ولا ابنٌ","فدعوا الشِّركَ وَانْبِذوا الإلحادا",20,"د",2,0],["لا أُبتُ إِن أُبتُ بِلا عِقابِ","حَتّى تَذوقي أَوجَعَ العَذابِ",21,"ب",1,0],["لا أبتغي منكَ طرفاً","رضيتُ منكَ بعَير",22,"ر",1,0],["لا أبتغي بالطمثِ مطمومةً","ولا أبيعُ الظبيَ بالأرنبِ",23,"ب",1,0],["لا أُبالي صَفحَ اللَئيمِ وَلا تَج","ري دُموعي عَلى الخَؤُونِ الصَفاءِ",24,"ا",2,0],["لا أبالي ناراً وعندي حبيبي","كل خطبٍ دون الفراق يسير",25,"ر",1,0],["لا أُبالي إِن مت جاورني في ال","قبر صحبي أَم جاورتني العداة",26,"ه",1,0],["لا أُبالي بعد أن أُص","بحَ في القبر مقيما",27,"م",2,1],["لا أُبالِي فِي هَواهَا","بِسَمَاعِ التُّرَّهَاتِ",28,"ت",1,0],["لا أُبالِي بِما يُقالُ وَإِنْ كُنْ","تُ مَلِيئاً بِرَدِّ كُلِّ جَوابِ",29,"ب",1,0],["لا أُبالي إِذا حَضَر","تَ بِمَن غابَ أَو حَضَر",30,"ر",1,0],["لا أُبالي بَعد أَن فارَقتهُ","بِغُرابِ البَينِ إِن قيلَ نَعَق",31,"ق",1,0],["لا أُبالي وَقَد مَضى","أَصلَحَ الدَهرُ أَو عَثا",32,"ث",2,1],["لا أَبتَغي سُقيا السَحابِ لَها","في مُقلَتي خَلَفٌ مِنَ السُقيا",33,"ي",2,0],["لا أبتغي غيرَ قربِي منك منزلةً","إن باتَ يبغي مُحبٌّ قُرْبَ ليلاهُ",34,"ا",2,0],["لا أبتغي صلةَ الأنا","م؛ فكلهم مثلي عفاة",35,"ا",2,0],["لا أبتغي خصمي أُناشده","عَفْواً ولو أطوي على سَغَب",36,"ب",1,0],["لا أبعدَ اللهُ طيفاً منك يؤنسني","إذا احتوتنيَ في أحضانها البيد",37,"د",1,0],["لا أبالي متى ودادك لي صح","من الدهر ما تعرض لي خطب",38,"ب",1,0],["لا أبالي وقد قسوت على الظالم","عسف الدجى وعضّ الحديد",39,"د",1,0],["لأأبثكمْ فيه جوى شفني،","حملتهُ من حبكمْ، مثقلا",40,"ل",2,0],["لا اباح المولى ارى غيره","حبا ولا حل لي عليه السو",41,"و",1,0],["لا أَبتَغي فَوقَ الخَيالِ زِيارَةً","حَسبي خَيالُكَ لَو أَنالَ مَزارا",42,"ر",2,0],["لا ابتلى اللَه عاشقاً بفراقِ","فيُلاقي من جهده ما أُلاقي",43,"ق",2,1],["لا أبالي ما يرجفون سفاها","فنعيمي في قيلهم بعد قال",44,"ل",1,0],["لا أبالي بكيدهم لا أبالي","لا أبالي بكيدهم لا أبالي",44,"ل",2,0],["لا أبتغي مولى سواك من الورى","إني وجانب من ملكت حريز",45,"ز",1,0],["لا أَبعَدَ اللَهُ أَيّاماً نَعِمتُ بِها","مُستَهتِراً في بُرودِ اللَهوِ أختالُ",46,"ل",1,0],["لا أَبتغي دينا سواه فهديُهُ","بالحق والبرهان والتبيين",47,"ن",1,0],["لا اِبنُ العَميدِ وَلا عَبدُ الحَميدِ وَلا ال","صابي لَهُم هَذِهِ الأَخلاقُ وَالشِيَمُ",48,"م",1,0],["لا أبالي به ولكن حلماً","واحتمالاً عمن جنى وتجنى",49,"ن",2,0],["لا أُبالي وَإِن أصابَ فُؤادي","فَهوَ كَنزٌ محصّنٌ بِطِلسمه",50,"م",2,0],["لا أبوه حيّ ولا أمه الأي","مِ ذات اليسار والأنشاب",51,"ب",1,0],["لا أَبتَغي عَن روح روحي غادَةً","بَدَلاً وَحفظُ الودِّ حَسبي عادَةً",52,"ه",1,0],["لا أُبالي بِمَقالٍ أَو قلىً","مِنهُمُ عِندَ حُضوري أَو غِيابي",53,"ب",2,0],["لا أَبجَحَنَّ بِما مَدَحتُ بِهِ العُلا","اللَفظُ لَم يَحمِل سِوى مَعناكا",54,"ك",2,0],["لا أبتغي عنهم ولا أُشريهم","حتى يُلاقيني حمامُ مماتي",55,"ي",1,1],["لا أُبالي في صبابات الهوى","أَقْصَر