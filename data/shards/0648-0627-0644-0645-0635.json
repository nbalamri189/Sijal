{"poems":[[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[85,"هذي العوالم لفظ أنت معناه","https://www.aldiwan.net/poem54231.html","البسيط"],[39,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[53,"أمسى الشباب رداء عنك مستلبا","https://www.aldiwan.net/poem8649.html","البسيط"],[30,"إني كتبت إليك ألتمس الغنى","https://www.aldiwan.net/poem5513.html","الكامل"],[51,"يا عجبا للناس لو فكروا","https://www.aldiwan.net/poem62084.html","السريع"],[99,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[82,"من كان عنه يدافع القدر","https://www.aldiwan.net/poem31442.html","أحذ الكامل"],[107,"في كل يوم شرعة ونظام","https://www.aldiwan.net/poem43408.html","الكامل"],[69,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[48,"الساع آنية الحوادث ما حوت","https://www.aldiwan.net/poem22033.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[30,"إني كَتَبْتُ إلَيْكَ ألتَمِسُ الغِنى","https://www.poetsgate.com/ViewPoem.aspx?id=17936",""],[151,"يا رب يا رب يا رب الأنام ومن","https://www.aldiwan.net/poem47639.html","البسيط"],[154,"يا سيد الرسل المكين مكانه","https://www.aldiwan.net/poem68545.html","الكامل"],[227,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[234,"الشوق يستسقي العيون الأدمعا","https://www.aldiwan.net/poem50953.html","الكامل"],[236,"قم فبادر قبيل رفع النعوش","https://www.aldiwan.net/poem44587.html","الخفيف"],[266,"أنا مضنى نوى الأحبة نضو","https://www.aldiwan.net/poem38109.html","الخفيف"],[287,"من علا الصاحب الطويل الركاب","https://www.aldiwan.net/poem32864.html","الخفيف"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[409,"شبهت ما دارت به","https://www.aldiwan.net/poem33348.html","مجزوء الرجز"],[463,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[505,"للقلب في سبك الحروف معان","https://www.aldiwan.net/poem37757.html","الكامل"],[520,"دانت لأمرك طاعة الأقدار","https://www.aldiwan.net/poem12106.html","الكامل"],[556,"ما أساء الزمان فيك الصنيعا","https://www.aldiwan.net/poem47714.html","الخفيف"],[556,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[556,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[563,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138062","الرجز"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202130","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126145","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56090","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130628","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136359","المجتث"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49948","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79985","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66252","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53219","السريع"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100245","السريع"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100220","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74210","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112495","الرمل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139919","البسيط"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145141","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138555",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108021","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110022","الكامل"],[3677,"","https://poetry.dctabudhabi.ae/diwan/poem/35066","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66616","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133261","البسيط"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102972","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127078","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83550","السريع"],[4764,"اضربه في مقتلن ثم اكسره","https://www.poetsgate.com/ViewPoem.aspx?id=34053",""],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4858,"إخوانٌ في الله","https://www.poetsgate.com/ViewPoem.aspx?id=32914",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5206,"الرد على منكر علم الحِكمة","https://www.poetsgate.com/ViewPoem.aspx?id=187403",""],[5219,"دمعة على القدس","https://www.poetsgate.com/ViewPoem.aspx?id=194900",""],[5246,"في الإسبال","https://www.poetsgate.com/ViewPoem.aspx?id=187033",""],[592,"يا طالباً مني جوابا شافيا","https://www.poetsgate.com/ViewPoem.aspx?id=128823",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5409,"طرق الباب حالماً بلقاها","https://www.poetsgate.com/ViewPoem.aspx?id=155363",""],[5413,"فقد الأحبة غربةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201389",""],[5463,"سلوى عنوان المودّه","https://www.poetsgate.com/ViewPoem.aspx?id=30881",""],[5725,"وقفة على باب ابي الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=177475",""],[4623,"ذكر الحبيب فأطلق العبرات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146689",""],[5848,"فستان وردي","https://www.poetsgate.com/ViewPoem.aspx?id=50594",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[5396,"نافذة الكهف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65504&r=&rc=3",""]],"verses":[["والمصطفى وأبو بَكرٍ بجانِبه","لا يُنكِرانِ عليها من أغانيها",0,"ي",3,0],["والمصطفى وكِمامُ الكون ما فُتقتْ","عن زُهر زَهْر يروقُ العين مرآهُ",1,"ا",2,0],["والمُصِيبِينَ بابَ ما أَاخطَأَ النَّا","سُ ومُرسِي قَوَاعِدِ الإِسلاَمِ",2,"م",1,0],["وَالمُصِيبُونَ والمُجِيبُونَ للدَّعو","وَةِ والمُحرِزُونَ خَصلَ التَّرامِي",2,"م",2,0],["والمصعبيّونَ قومٌ من شمائلهم","قتلُ الملوكِ إذا ما قتلهُمْ وجبا",3,"ب",2,0],["وَالمُصلِحاتِ بِمالِهِنَّ ذَوي الغِنى","وَالخاضِباتِ قَنا الأَسِنَّةِ بِالدَمِ",4,"م",1,0],["وَالمَصدَرُ النارُ أَوِ المَصدَرُ ال","جَنَّةُ ما دونَهُما مَصدَرُ",5,"ر",1,0],["والمصابيح التي في جانبيه","ذلك النيل وما في شاطئيه",6,"ه",1,0],["والمُصطَفَى سَمّتْهُ كافِرَةٌ","لِتُضيرَهُ أو مسّهُ الضّررَ",7,"ر",1,0],["وَالمُصلِحونَ كَما عَلِمتَ وَأَهلُها","عَنها عَلى زَجرِ المُهيبِ نِيامُ",8,"م",1,0],["والمصطَفى الماحي الذي يمحو الذي","يُحْصِي الرقيبُ على المُسيء وَيَكْتُبُ",9,"ب",1,0],["والمُصطفَى خيرُ خلقِ اللَّهِ كُلِّهِمِ","لهُ عَلَى الرُّسلِ تَرجِيحٌ وتَفضِيلُ",10,"ل",1,0],["وَالمِصرُ آنَسُ مِنهُ خَرقُ مَفازَةٍ","أَنَسَ الدَليلُ بِقافِها مَعَ طائِها",11,"ا",3,0],["وَالْمَصَابِيحَ فِي البَخُورِ كَأَطْيَا","رٍ عُكُوفٍ جَمَاعَةٍ وَبَدَادِ",12,"د",1,0],["والمُصْلِحاتِ بمَالِهِنّ ذَوِي الغِنى","، وَالحاضِبَاتِ قَنَا الأسِنّةِ بِالدّمِ",13,"م",1,0],["والمصطلون بنار الحرب شاعلة","مطلوبهم منك يا ذل الفضل رضوانا",14,"ن",2,0],["والمصطفى المختار من هذا الورى","فمحلُّه عالي المحلِّ وشأنهُ",15,"ن",2,0],["والمصدر الميمي حيث أتى","من ذي ثلاثة يصاغ يا فتى",16,"ت",2,0],["والمُصْطَفَيْنَ المرتضين من الورى","والمفضلِين بما حَوَوْه تَسَرُّعا",17,"ع",2,0],["والمصبِحين لكل عافٍ مَلْجَأً","والرائحين لكلّ عانٍ مَفْزَعا",17,"ع",2,0],["والمصفى من الخليل ومن سام","بن نوح وقينن بن أنوش",18,"ش",1,0],["والمصلي سبقاً لسخط عدو","ورضى من يحبه لي تلو",19,"و",1,0],["وَالمُصَلّى بَناهُ عَزمُكَ يا مَن","عَزمُهُ صائِبٌ بِصَوبِ الصَّوابِ",20,"ب",1,0],["وَالمُصطَفى بِرُسومٍ مِنهُ ناجِحَةً","وَفِكرَةً في قَريبِ الفَتحِ طامَحَةِ",21,"ه",1,0],["والمصطكى من فوقها","مثل السلوس المطليه",22,"ي",2,0],["والمصطفى المحبوب من ماله","يَخبِطُ فيه العائثُ الناهب",23,"ب",1,0],["والمُصْطَفى سِرُّ الوُجودِ محمَّدٌ","بُرْدَ السَّعادَةِ والقَبولُ كَساني",24,"ن",2,0],["والمصلحان فساد كل طوية","مرتابة بالعرف والإنكار",25,"ر",1,0],["والمصيباتُ لا يُصِبْنَ سوى الأخْ","يارِ منّا إِذا وَلَجنَ الرُّبوعا",26,"ع",2,0],["والمصلّين عند جَمْعٍ يرجّو","ن الّذي ما اِستجيرَ إلّا أَجارا",27,"ر",2,0],["والمُصميات من المقا","تِلِ هنّ نفسُ المخطئاتِ",28,"ت",1,0],["والمصلَّى هي بالذات لنا","رحمة عمت وخصت كل شيّ",29,"ي",1,0],["وَالْمُصْطَفى وَآلُهُ الاََطْهارُ","فَإنَّهُمْ صَفْوَتُهُ الاََبْرارُ",30,"ر",1,0],["والمصطفى وأله عماده","حقاً كما ولاؤهم عتاده",31,"ه",1,0],["والمصطفى يجيبها يابنتي","عليه حرِّمت ومنه بنتِ",32,"ت",1,0],["والمصب السامي زها واستبشرت","صيدا وفيه عمّ دنيانا الصفا",33,"ف",2,0],["والمصعدين بما الاله حباهما","حيا توفي في السما ادريسا",34,"س",2,0],["والمصطفى المجبي","يضيف للزايرين",35,"ن",1,0],["والمصطفى المختار من إحسانه","دعا لمن أصلح من لسانه",36,"ه",1,0],["والمصدر المعلل المفعول له","كتبت خوف الله يوم المسأله",36,"ه",1,0],["والمصلتون صقيلاتٍ يمانيةً","يغمدن ما بين هاماتٍ واجيادِ",37,"د",1,0],["والمصلِّي للمجدِ خلف أخيه","في سباق الأشباه والنظراء",38,"ا",2,0],["والمصطفى خير نبيٍّ مرسل","وابنته وزوجها الندب علي",39,"ي",1,0],["والمصقع الخطب إذا ضعضعت","صدمته رضوى وثهلانا",40,"ن",2,0],["والمصدرون الخيل شعث الطلى","حيث أغام الأفق واليوم صاح",41,"ح",1,0],["والمصدرين من المغيرة خيلها","والخيل شوط مغارها التخبيب",42,"ب",1,0],["وَالمصقع اللسن المفوه مَن غَدا","سحر البيان الصرف في تَبيينه",43,"ن",2,0],["والمصلّون لدى تسبيحهم","صيروا الندمان في عيني نسيّا",44,"ي",2,0],["والمُصطفى من قريش بعد خيرتها","من القبائل والمختارُ من مضرِ",45,"ر",1,0],["والمصلحون بكل مت","تجه لهم نصبت شباك",46,"ك",1,0],["والمصطفى نال من الوجد ما","ليس بموصوف ومشروح",47,"ح",1,0],["والمصابيح حولهنَّ تبدت","كبدورٍ قد انجلت في الكرات",48,"ت",1,0],["والمُصطَفَينَ جميعِهِم","ابداً وزُمرةِ أَصفِيائِك",49,"ك",1,0],["وَالمُصطَلي بِالحَربِ يسعرُها","بِغُبارِها في فِتيَةٍ سعرِ",50,"ر",1,0],["وَالمَصابِيحُ أَطْفَأَتْها يَدُ الصُّبْ","حِ فَشابَتْ مَفارِقُ الرَّوْضِ ذُعْرَا",51,"ر",2,0],["والمصطفى صفوة الخلاق يرشدهم","إلى المعالى بحسن الفعل والكلمِ",52,"م",1,0],["والمصدر الوجدان والمرءُ يجد","مستقبلا في الكل فاعلم واستفد",53,"د",1,0],["والمصدر النفوق فاعلم وقدر","زيد على الأمر وقد أعطى الظفر",53,"ر",1,0],["والمصدر الإقذاءُ من أقذيت","كما اقتضى تقذية أقذيت",53,"ت",1,0],["والمصلح الأفساد بالقلم الذي","ليس المداد له سوى الأمداد",54,"د",1,0],["وَالمُصطَفَى المُعجِزُ كُلَّ الفُصَحَا","أدَّى الرِّسَالَةض وَكُلاًّ نَصَحَا",55,"ح",2,0],["والمصطفى وفاطم والحسن","السبط بكوا مما دها وولولوا",56,"ل",3,0],["وَالمُصطَفى الطَيِّب هادي الوَرى","قَد خَصَّني مِنهُ بِهذا الرَشاد",57,"د",1,0],["والمصيبه لا طعنت انسان حي","واندفن حبك بجوف المقبره",58,"ر",2,0],["والمصطفى في الناس بلَّغ أمرَه","يومَ الغدير وكل أُذنٍ سامعة",59,"ع",2,0],["والمصطفى الهادي منارُ حياتهم","فهو الرّحيمُ بأمّة القرآن!",60,"ن",1,0],["والمصطفى لم ينفه بل لم يزل","في طيبة ابداً يروح ويغتدى",61,"د",2,0],["والمصطفى في سبيل الله قائدها","وكل طرف من الكفّار عنه عمي",62,"م",2,0],["وَالمُصْطَفى وكَذَا عَلِيٌّ بَعدَهُ","فَاهَا بِهَا رَمْزًا لَهُ التَرمِيسُ",63,"س",1,0],["والمصطفى لما سرى قمماً","كم أطربت آياتهُ أذنا",64,"ن",2,0],["والمصلي وراء غير المصلي","لم يؤد لها سوى إن اعادا",65,"د",2,0],["والمصطفى المعصوم لم يعرج به","نحو السماء كما يقول المائن",66,"ن",1,0],["والمصطفى لم يقل هذا وصحبته","والآل يوماً ومن بالعلم قد عرفا",67,"ف",2,0],["والمصطفى تعظيمه باتباعه","كذل والتعزيز بالجد والجهد",68,"د",1,0],["والمصابيح بينهن وبين الر","ريح قامت هناك حرب زبون",69,"ن",1,0],["والمصلحين من الزمانِ قلائلٌ","ومن القلائلِ سَيِّدي العَمَّارُ",70,"ر",1,0],["والمصيبه .. [ يالحبيبه ] غيرك .. الإحساس صَدّه","لين صارت كل خلق الله حوله هي غريبه ... !",71,"ب",2,0],["والمصطفى اعطاه راية دينه","فعلى بها وازْورّ عنها الاهيعُ",72,"ع",1,0],["والمصطفى في الكون منبع سره","بين الورى قد فاض بالخيرات",73,"ت",1,0],["والمصيبة كان مر الصيف ما شفتك وجيتك","يا بعد كل القلوب الا بعد كل القرايب",74,"ب",1,0],["وَالمُصطَفى خالدٌ في الناسِ مابَزَغَت","أُمُّ النُّجومِ ومَمدوحٌ بِكلِّ فَمِ",75,"م",1,0],["والمصبّ العملاق أعور كالشمس","قد اجتاح رأسه مجتاح",76,"ح",1,0]]}