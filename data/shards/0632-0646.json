0,"","https://poetry.dctabudhabi.ae/diwan/poem/65371","الطويل"],[3149,"","https://poetry.dctabudhabi.ae/diwan/poem/198915","السريع"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110799","الخفيف"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31681","المتقارب"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86297","الرجز"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46024","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117930","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85018","السريع"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59441","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101350","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90868","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81722","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83194","الرجز"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107140","الكامل"],[4578,"بعيني غزال ألبان هاروت ماكث","https://www.poetsgate.com/ViewPoem.aspx?id=49366",""],[4578,"زناد نوى الأحباب في القلب يقدحُ","https://www.poetsgate.com/ViewPoem.aspx?id=49376",""],[3591,"هكذا هكذا وإلاّ فلالا","https://www.poetsgate.com/ViewPoem.aspx?id=149456",""],[5121,"يَا طُيُورُ اذْكُرِيِنِي","https://www.poetsgate.com/ViewPoem.aspx?id=49541",""],[5145,"ويح المعالي فقد شالت نعامتها","https://www.poetsgate.com/ViewPoem.aspx?id=108050",""],[5273,"قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=186924",""],[5277,"طيفٌ وحيف","https://www.poetsgate.com/ViewPoem.aspx?id=198814",""],[5277,"زنابقُ القدس","https://www.poetsgate.com/ViewPoem.aspx?id=207037",""],[5283,"عشق فوق التعريف","https://www.poetsgate.com/ViewPoem.aspx?id=207577",""],[5376,"دع عنك شعرا بما هيجته أدبا","https://www.poetsgate.com/ViewPoem.aspx?id=189134",""],[5512,"الجولان","https://www.poetsgate.com/ViewPoem.aspx?id=204192",""],[2110,"زر دار مي وقف بالباب إن جازا","https://www.poetsgate.com/ViewPoem.aspx?id=156273",""],[5691,"ليالي شهرزاد","https://www.poetsgate.com/ViewPoem.aspx?id=205893",""],[5749,"النحيلة واللشاروالطنان","https://www.poetsgate.com/ViewPoem.aspx?id=203572",""],[5815,"وصية الرحيل الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=200044",""],[5943,"هذا أنا بالآه أطلقُ صرختي","https://www.poetsgate.com/ViewPoem.aspx?id=34676",""],[6106,"جمال الأدب ، ومرسي الحب","https://www.poetsgate.com/ViewPoem.aspx?id=6308",""],[1583,"أنامل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73062&r=&rc=19",""],[6218,"أم أرض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65906&r=&rc=59",""],[572,"صِينَتْ بمرفَعها الدواة ُ فَأصبَحَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9469&r=&rc=326",""]],"verses":[["زِن مِن وَزَنكَ بِما وَزَ","نكَ وَما ما وَزَنكَ بِهِ فَزِنهُ",0,"ن",2,1],["زِنادُكَ خَيرُ زِنادِ المُلو","كِ خالَطَ مِنهُنَّ مَرخٌ عَفارا",1,"ر",2,0],["زِنتُما الأَيّامَ إِذ مُلكُكُما","سالَ في أَوجُهِها سَيلَ الغُرَر",2,"ر",1,0],["زَنْبَقٌ نَاصِعُ البَيَاضِ نَقِيٌّ","تَرْتَوِي مِنْ بَيَاضِهِ العَيْنَانِ",3,"ن",1,0],["زَنيمٌ تَداعاهُ الرِجالُ زِيادَةً","كَما زَيدَ في عَرضِ الأَديمِ الأَكارِعُ",4,"ع",1,1],["زَنبَقُ المُدنِ وَرَيحانُ القُرى","قامَ في كُلِّ طَريقٍ وَقَعَد",5,"د",1,0],["زِنَّ عَلى الأَرضِ سَماءَ الدُجى","وَزِدنَ في الحُسنِ عَلى شُهبِهِ",6,"ب",2,0],["زَنَت زَماناً فَلَمّا عَنَّسَت هَرَماً","قادَت عَلى كُلِّ قَوّادٍ وَخَمّارِ",7,"ر",1,0],["زَنبَقٌ بَينَ قُضبِ آسٍ وَبانٍ","وَأَقاحٍ وَنَرجِسٍ وَوُرودِ",8,"د",1,0],["زِنْ بديعَ الكلامِ وَزناً مُحَرَّرْ","مثل ما يُوزَنُ النضارُ المُشَجَّرْ",9,"ر",1,1],["زَندي وَلَدتكَ وقَد عَقِمَتْ","عن حَملِ السِّقْطِ فَلَم تَلِدِ",10,"د",1,0],["زنارُ بنتِ النصارى","فخٌّ لها أيُّ فخِّ",11,"خ",1,1],["زنّارُ بنتِ النصارى","لقتلتي متوَّخِ",12,"خ",1,1],["زن الناس إن كنت اللبيب ولا تكن","كمن يتوخى الغي يحسبه رشدا",13,"د",2,0],["زِنوا الأُمورَ فَإِنَّ الظُلمَ مَهلَكَةٌ","وَأَعدَلُ الناسِ مَن يَقضي بِميزانِ",14,"ن",1,0],["زَنادِقَةٌ أَرادَت كَسبَ مالٍ","مِنَ الجُهّالِ فَاِتَّخَذَتهُ سوقا",15,"ق",2,0],["زنبورُ يا خنزير يا ابنَ الزانية","شرفٌ لأمِّكَ أن تُسمّى زانيه",16,"ي",2,1],["زنبورُ يشتمني ولكن أمُّهُ","كانت على ما كان تنعمُ بالي",16,"ي",1,0],["زنبورُ لا حين النجا وقد التقت","أرضي عليك بحاصبي وسمائيه",16,"ي",2,0],["زنبورُ فانظر هل بقى لكَ مغرمٌ","فلقد سما لك ضيغمٌ قعصاصُ",17,"ص",1,0],["زنارهُ فوق غصنِ بانٍ","يهتز في نعمةٍ ميودِ",18,"د",1,0],["زِني القَومَ حَتّى تَعرِفي عِندَ وَزنِهِم","إِذا رُفِعَ الميزانُ كَيفَ أَميلُ",19,"ل",1,1],["زنود مُسَعَّرين على الربايا","شعارهمُ الشهادة والشهيد",20,"د",1,0],["زنجيةٌ في الفنِّ تحتكمُ","قد ضاع فنُّ الخالدين سُدى",21,"د",2,0],["زَنَتْ بالرِّجالِ على سِنِّها","فَيا حبَّذَا هِي مِن زانِيهْ",22,"ن",3,0],["زَنُوا بِرَايَتِهَا السَّرِيرَ وَعوَّذوا","ذَاكَ الجَلاَلَ بِأَنْجُمٍ وَهِلاَل",23,"ل",1,0],["زَندُ الحِجا كَوكَب الدياجي","شبلُ الشَرى شامَة الرِكازِ",24,"ز",1,0],["زَنَت أَعيُنٌ مِنّا وَعَفَّت ضَمائِرٌ","فَبِتنا وَأَيدينا مِنَ اللَمسِ تُحجَزُ",25,"ز",1,0],["زني القوم حتى تعرفي عند زونهم","إذا رفع الميزان كيف أميلُ",26,"ل",1,1],["زنجيَّةُ اليلِ تروي كيف قلَّدها","في عُرسها غُرَرَ الأشعار لا الشهبا",27,"ب",2,0],["زن من وزنك بما وزنك","وما وزنك به فزنه",28,"ن",2,1],["زِنَادُ الهَوَى بَينَ الجَوانِحِ قَادحٌ","وَلا أثرٌ يَبدُو وَلا سِرُّ يَبرُزُ",29,"ز",1,0],["زَنِيمٌ شَحِيْحٌ وهو يَبْذِلُ عِرْضه","عن الحالِ والمالِ الذي هو سائِلُ",30,"ل",1,0],["زِنْت الخلافةَ مذ أُلْبِسْتَ خِلْعَتَها","وزدْت دَوْلَتَها عِزّاً على الدُّوَل",31,"ل",1,0],["زَنْتَ الخلاخلَ والسُّمو","طَ بمثل ما الْخَلْخالُ زانَكْ",32,"ك",1,0],["زَندُهُ خَيرُ زِنادٍ وَرِيَت","لِمُلوكِ الأَرضِ طُرّاً أَجمَعين",33,"ن",1,0],["زندانِ مدَّهما أخو شوقٍ إلى","مشتاقةٍ فدنتْ فتمَّ لزام",34,"م",1,0],["زنيةُ الدِّين عُرّىَ الدينُ منها","وحُلِىُّ الدنيا جفا الأعضاءَ",35,"ا",2,0],["زن بِالفَضائل مجدَ جَدِّك","وَاِقدح بِجدّكِ زند جدِّك",36,"ك",1,1],["زِنتَ وجهَ الدّهرِ الذي شانَهُ النّق","صُ فلا زلْتَ غُرّةَ الدَّهماء",37,"ا",2,0],["زند الاسى بين الجوانح قد ورى","لما تأخر ذو الأمام إلى ورا",38,"ر",2,1],["زِنَةُ الفِضَّةِ أَوْلى","بِكَ مِنْ وَزْنِ الكَلامِ",39,"م",1,1],["زنادُ مجدٍ أضاء الأفْقَ قادحُهُ","له بمجد رسول الله أُلْهوبُ",40,"ب",1,0],["زِنَة وأَفْعالٌ ومُشْتَقّاتُها","مَعْ مَصْدرٍ ثم المصَغّر فانسُبِ",41,"ب",1,1],["زنداكِ ميزانٌ بِثِقْلِهما","يَزِنُ المَدَارُ الغربَ والشرقَا",42,"ق",2,0],["زنزانةُ العُمرِ ضاقتْ دونَ أُغنيةٍ..","إنَّ الأغاني يُوَسِّعْنَ الزَّنازينا!",43,"ن",2,0],["زِنْجِيَّةٌ عَجْمَاءُ إِلاَّ أَنَّهَا","بِجَلِيْلِ تَدْبِيْرِ البَرِيَّةِ عَالِمَهْ",44,"م",2,0],["زِنتُم عَلَوتم حميتم جدتمُ كرما","أَضأتمُ وَهديتم سُبلَ ضُلّالِ",45,"ل",1,0],["زَنَت مُقلَتي لَمّا رَأَت شَمسَ وَجهِهِ","وَقَد قَذَفَت بِالدَّمعِ يَهمي وَتَذرفُ",46,"ف",1,1],["زِنتَها في مَديحِك السّامرِ حُسناً","بِثَمينِ اللّآلِ وَالعقيانِ",47,"ن",1,0],["زَني القَومُ حتّى تَعلَمي عِندَ وَزنِهم","إِذا رفعَ الميزانُ كَيفَ أَميلُ",48,"ل",1,0],["زُنودٌ زُنوجٌ كلُّ زندٍ لَقَد غَدا","بِهِ شَمعةٌ ضاءَت وَمَدَّ بِها زندُ",49,"د",1,0],["زَنَتْ مُقْلَتي إذْ خَالَسَتْهُ بِنَظْرَةٍ","فَجَدَّتْ بِتَسْكَابِ الدُّمُوعِ اللَّواعِزِ",50,"ز",1,0],["زِنَادٌ بِقَلْبي لَيْسَ يَخْبُو شَرَارُهُ","وَكَمْ فِيهِ سِرٌّ كَامِنٌ غَيْرُ بَارِزِ",50,"ز",1,0],["زِنُوا الْمَدْحَ فِيهِ قَوْلٌ مُحَرَّرُ","تَضَمَّنَ وَصْفاً كَامِلاً غَيْرَ عَاجِزِ",50,"ز",1,0],["زَنْد الامام وسيفه","ويداه في النُوَب الجسامْ",51,"م",1,0],["زنت المواهب منك بالتكرير","وغدوت بالإحسان جد جديرِ",52,"ر",1,1],["زندَها أَورى بِقَلبي شررا","صَدَعته بِالتِهاب وَاِحتِراق",53,"ق",1,0],["زند الأَسى مِن حشى المحزون يقتدح","وَأَدمع الثكل في أَجفانه سفح",54,"ح",1,1],["زُنّارُهُ في خِصرِهِ مَفقودُ","كَأَنَّهُ مِن كَبِدي مَقدودُ",55,"د",1,0],["زَّنْتُ مِنْ فِكْري سَماءَ العُلا","مِنْكَ بِشِعْرٍ يُخْجِلُ الشِّعرَى",56,"ر",2,0],["زنجية شبكت أناملَها","من فوقِ نارنجةٍ لتُخفيها",57,"ه",2,0],["زِنِ الحرفَ لا تُخرِجه عن حدِّ وَزنِه","فوزنُ حروفِ الذِكرِ من أَعظَمِ البِرِّ",58,"ر",1,0],["زند به عضد السيوف فصاوكت","حرباً وزند في المجاعة وار",59,"ر",1,0],["زنت عيناك حين ونت لغيري","فغسلهما بدمعك فرض عين",60,"ن",1,0],["زِنْت بغضاضة عود مَيّاح","ومضيمرٍ غاير وممسوح",61,"ح",1,0],["زَنجِيُّ خالِ الخدِّ يبدو واضحاً","في وجنةٍ قد أشرقت كنهارِ",62,"ر",1,1],["زنت العلى من هاشم معنى العلى","ففزت في لبابها ومحضها",63,"ض",3,0],["زناد المجد في كفي واري","ولي شرف على السبع السواري",64,"ر",2,1],["زِنوا فضلَ كُلّ الرسْل معْ فضلِ أحمدٍ","ترَوْ فضلهُ عن فضلهمْ يتميّزُ",65,"ز",1,1],["زن حقنا مما يقل زيفه","لا نكتفي إلا بنص حدفه",66,"ه",1,0],["زنادي لم يزل بك جِدَّ وارٍ","وحسبي عزةً وبك اعتزازي",67,"ز",2,0],["زنت جيد الهدى بهن عقودا","عن سواها خلا خلا وحجولا",68,"ل",2,0],["زندك يَرمي بِشَرار الجَفا","وَجانِبي يَقطر ماء الوَفا",69,"ف",2,1],["زنت الخلافة والولاية والعلا","فلذا اصطفاك لنا إلا له إماما",70,"م",2,0],["زندها الود من قلب سليم","اذا وافى وفا القلب السليم",71,"م",1,0],["زناتة يهنيكم فعلكم","عاجلكم ثائركم باجتياح",72,"ح",1,0],["زناد العزم كم قدحت يداه","وَكَم قَلب بذاكَ القدح استفزا",73,"ز",2,0],["زِنتِ البِلادَ لأَنَّ فيكِ دَلالَةٌ","عُظمَى عَلَى تَوحِيدِ رَبٍّ يُعبَدُ",74,"د",1,0],["زنت السياسة إذا حملت لواءها","وجلوتها من ريبة وخداعِ",75,"ع",1,0],["زَناديقُ أَبلاط تيوسٌ تَقَرمَطوا","لَهُم أَعيُن أَضحت لِكُفرٍ طَوامِحا",76,"ح",2,0],["زند أفكاره الزكية وار","حيث أفكار غيره ذات خبوه",77,"و",2,0],["زَنبَلكُ تَفنكهم لا يُحصى","وَمَكرُهم كَذاك لا يُستَقصى",78,"ص",2,0],["زن الأقوام بالخلُق المعلى","ولا تزن الورى علماً وحذقا",79,"ق",2,1],["زنت بمعاني نظمه كلُّ فكرة","قحابُ المعاني كلّها في بُيوته",80,"ت",2,0],["زنجية تحمل أقواتها","في مثل حدي طرف الجفت",81,"ت",1,0],["زنتمُ بالحظوظ مصرا فقامت","كل مصر بالخطوط الطروسا",82,"س",2,0],["زُنوجٌ إِذا خَفَقَتْ بَيْنَها","دَبادِبُها جَرَّدَتْ بيضَها",83,"ه",2,0],["زِن بِالنهى لا بِالحلى نَفساً وَحُز","زاداً الى الاِخرى بِنُعماه تَفُز",84,"ز",1,0],["زَندُ الخَليفَةِ عِندَ كُلِّ مُلِمَّةٍ","دَهياء تزجي أَبؤساً وَكروبا",85,"ب",2,0],["زناد حسامه يورى سعيراً","تكاد على العدى غيظاً تميز",86,"ز",1,0],["زِنجِيُّ مِسكِ الخالِ رِضوانُها","وَقَلبُهُ المُسوَدُّ ما قَطُّ لانِ",87,"ن",1,0],["زِنادي في الفضائلِ غيرُ كابٍ","وعزمي في الحوادث غيرُ نابِ",88,"ب",1,0],["زنوا ليبذر حب الحب صبكم","في ربوة القلب أو في صاعكم كيلوا",89,"ل",3,0],["زنجيرها الساقي به","لطوارق الأحزان قيد",90,"د",1,0],["زِنْتُ المدائحَ والمحامدَ باسمه","فوسمتها منه بأحسنِ ميسم",91,"م",1,0],["زِن ما تَقولُهُ فَرُبَّ قَولِ","أَنفَذُ في مُرادِهِ مِن صَولِ",92,"ل",1,0],["زند القريحة مذ علقت بكم ورى","يا من شهرت بحبهم بين الورى",93,"ر",2,1],["زنادُ الأسى وارٍ لبعد معذبي","كما زند أفراحي بلقياه غالثُ",94,"ث",1,0],["زناد نوى الأحباب في القلب يقدحُ","فمالي ومن في الحب بالجهل يقدحُ",95,"ح",1,1],["زنّ بالورد هامهنّ وما احتج","ن إلى الورد أن يزين الرفالا",96,"ل",2,0],["زَنْبَقَاتِي فِي حُرُوفِي","تَحْتَفِي قَوْلِي الطَّهُورْ",97,"ر",1,0],["زنت الوزارة لمّا كنت سيّدها","وعفتها إذ غدا وزراً تعاطيها",98,"ي",3,0],["زِنْزانتانِ وقِفْلٌ تحتَ مِعْطَفِها","فكيفَ تأسُرُ في تَشريعِها الحُلَمَا",99,"م",2,0],["زنبقاً كنتِ..ولمّا أورقتْ","ضحكةُ الوصلِ..منحتيني شذاكِ",100,"ك",1,0],["زنبقَ القدسِ العتيق الغاليهْ","غادري أعرافَ عشقٍ باليهْ",101,"ل",3,1],["زِنُوا كلامَ جميعِ النَّاسِ وارتَقِبوا","همسًا مِنَ العينِ في ميزانِنا رجَحا",102,"ح",2,0],["زنزانة الظلم لن يرضى بها أبدا","فلم ير الحق بالاذلال مكتسبا",103,"ب",2,0],["زنزانةٌ فوقَ العروشِ قيودُها","وتخاذلوا في قبضةِ السَّجانِ",104,"ن",1,0],["زند الفضيلة بين القوم ظل به","وارفا ثم من حاذاه أو وازى",105,"ز",2,0],["زناد فكري خبت عن درك غايتها","فرحت في حيز التقصير منحازا",105,"ز",2,0],["زِنَةُ العقْلِ زينَةٌ وسَدادُ","وبِها قدْ نجَوْتِ ياشَهرَزادُ",106,"د",1,1],["زنبور طاير زربان","يلاحق نحيلة بين اغصان",107,"ن",1,0],["زِنْ رَوضَ عَقْلَكَ وَالْتَمِسْ مِنْ زَهْرهِ","عِطْرَ الوفا للْصَحْبِ مَنْ وَافَاهَا",108,"ا",3,0],["زنزانتي حفظت ثفاصيل الجري","مة كلَّها في السَّقف والجدرانِ",109,"ن",1,0],["زنت المشاعر والأشعار في أدب","أبناء مصر به قد سابق الشهبا",110,"ب",2,0],["زنابق الجنّة يا أَناملُ","أَم خُصَلٌ من السنى أَوائلُ ؟",111,"ل",1,1],["زنّرتهُ بقلبها.. ثم قالتْ:","متْ.. لتبقى بقلب أمك عيدا",112,"د",2,0],["زنجيَّة ٌ عجماءُ إلاَّ أنَّها","بِجَلِيلِ تبريزِ البريَّة ِ عَالِمَهْ",113,"م",2,0]]}