{"poems":[[57,"زن من وزنك بما وزنك","https://www.aldiwan.net/poem24623.html","مجزوء الكامل"],[9,"أأزمعت من آل ليلى ابتكارا","https://www.aldiwan.net/poem21940.html","المتقارب"],[73,"أيها الظافر أبشر بالظفر","https://www.aldiwan.net/poem11957.html","الرمل"],[93,"طفت والصبح طالباً في الجنان","https://www.aldiwan.net/poem11230.html","الخفيف"],[23,"زنيم تداعاه الرجال زيادة","https://www.aldiwan.net/poem21590.html","الطويل"],[85,"لا يقيمن على الضيم الأسد","https://www.aldiwan.net/poem8101.html","الرمل"],[85,"إثن عنان القلب واسلم به","https://www.aldiwan.net/poem63782.html","السريع"],[45,"اسمع هديت أبا يحيى مقال أخ","https://www.aldiwan.net/poem64548.html","البسيط"],[66,"خلياني أجر فضل برودي","https://www.aldiwan.net/poem38801.html","الخفيف"],[80,"زن بديع الكلام وزنا محرر","https://www.aldiwan.net/poem31449.html","الخفيف"],[80,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[69,"زنار بنت النصارى","https://www.aldiwan.net/poem28137.html","المجتث"],[69,"زنار بنت النصارى لقتلتي","https://www.aldiwan.net/poem28417.html","المجتث"],[105,"أعندك أنا لم ندع بعدك الوجدا","https://www.aldiwan.net/poem41928.html","الطويل"],[105,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[52,"أبى آبي الهوى أن لا تفيقا","https://www.aldiwan.net/poem26799.html","الوافر"],[48,"زنبور يا خنزير يا ابن الزانية","https://www.aldiwan.net/poem66238.html","الكامل"],[48,"لله أعيننا وهن من الخدى","https://www.aldiwan.net/poem66240.html","الكامل"],[48,"لقبلة الراحِ إذ تصلي","https://www.aldiwan.net/poem66577.html","مخلع البسيط"],[50,"زني القوم حتى تعرفي عند وزنهم","https://www.aldiwan.net/poem62280.html","الطويل"],[90,"","https://poetry.dctabudhabi.ae/diwan/poem/147230","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39601","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30501","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43842","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43640","الطويل"],[50,"زني القوم حتى تعرفي عند زونهم","https://www.poetsgate.com/ViewPoem.aspx?id=30899",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[57,"زن من وزنك بما وزنك","https://www.poetsgate.com/ViewPoem.aspx?id=3275",""]],"verses":[["زِن مِن وَزَنكَ بِما وَزَ","نكَ وَما ما وَزَنكَ بِهِ فَزِنهُ",0,"ن",2,1],["زِنادُكَ خَيرُ زِنادِ المُلو","كِ خالَطَ مِنهُنَّ مَرخٌ عَفارا",1,"ر",2,0],["زِنتُما الأَيّامَ إِذ مُلكُكُما","سالَ في أَوجُهِها سَيلَ الغُرَر",2,"ر",1,0],["زَنْبَقٌ نَاصِعُ البَيَاضِ نَقِيٌّ","تَرْتَوِي مِنْ بَيَاضِهِ العَيْنَانِ",3,"ن",1,0],["زَنيمٌ تَداعاهُ الرِجالُ زِيادَةً","كَما زَيدَ في عَرضِ الأَديمِ الأَكارِعُ",4,"ع",1,1],["زَنبَقُ المُدنِ وَرَيحانُ القُرى","قامَ في كُلِّ طَريقٍ وَقَعَد",5,"د",1,0],["زِنَّ عَلى الأَرضِ سَماءَ الدُجى","وَزِدنَ في الحُسنِ عَلى شُهبِهِ",6,"ب",2,0],["زَنَت زَماناً فَلَمّا عَنَّسَت هَرَماً","قادَت عَلى كُلِّ قَوّادٍ وَخَمّارِ",7,"ر",1,0],["زَنبَقٌ بَينَ قُضبِ آسٍ وَبانٍ","وَأَقاحٍ وَنَرجِسٍ وَوُرودِ",8,"د",1,0],["زِنْ بديعَ الكلامِ وَزناً مُحَرَّرْ","مثل ما يُوزَنُ النضارُ المُشَجَّرْ",9,"ر",1,1],["زَندي وَلَدتكَ وقَد عَقِمَتْ","عن حَملِ السِّقْطِ فَلَم تَلِدِ",10,"د",1,0],["زنارُ بنتِ النصارى","فخٌّ لها أيُّ فخِّ",11,"خ",1,1],["زنّارُ بنتِ النصارى","لقتلتي متوَّخِ",12,"خ",1,1],["زن الناس إن كنت اللبيب ولا تكن","كمن يتوخى الغي يحسبه رشدا",13,"د",2,0],["زِنوا الأُمورَ فَإِنَّ الظُلمَ مَهلَكَةٌ","وَأَعدَلُ الناسِ مَن يَقضي بِميزانِ",14,"ن",1,0],["زَنادِقَةٌ أَرادَت كَسبَ مالٍ","مِنَ الجُهّالِ فَاِتَّخَذَتهُ سوقا",15,"ق",2,0],["زنبورُ يا خنزير يا ابنَ الزانية","شرفٌ لأمِّكَ أن تُسمّى زانيه",16,"ي",2,1],["زنبورُ يشتمني ولكن أمُّهُ","كانت على ما كان تنعمُ بالي",16,"ي",1,0],["زنبورُ لا حين النجا وقد التقت","أرضي عليك بحاصبي وسمائيه",16,"ي",2,0],["زنبورُ فانظر هل بقى لكَ مغرمٌ","فلقد سما لك ضيغمٌ قعصاصُ",17,"ص",1,0],["زنارهُ فوق غصنِ بانٍ","يهتز في نعمةٍ ميودِ",18,"د",1,0],["زِني القَومَ حَتّى تَعرِفي عِندَ وَزنِهِم","إِذا رُفِعَ الميزانُ كَيفَ أَميلُ",19,"ل",1,1],["زنود مُسَعَّرين على الربايا","شعارهمُ الشهادة والشهيد",20,"د",1,0],["زنجيةٌ في الفنِّ تحتكمُ","قد ضاع فنُّ الخالدين سُدى",21,"د",2,0],["زَنَتْ بالرِّجالِ على سِنِّها","فَيا حبَّذَا هِي مِن زانِيهْ",22,"ن",3,0],["زَنُوا بِرَايَتِهَا السَّرِيرَ وَعوَّذوا","ذَاكَ الجَلاَلَ بِأَنْجُمٍ وَهِلاَل",23,"ل",1,0],["زَندُ الحِجا كَوكَب الدياجي","شبلُ الشَرى شامَة الرِكازِ",24,"ز",1,0],["زَنَت أَعيُنٌ مِنّا وَعَفَّت ضَمائِرٌ","فَبِتنا وَأَيدينا مِنَ اللَمسِ تُحجَزُ",25,"ز",1,0],["زني القوم حتى تعرفي عند زونهم","إذا رفع الميزان كيف أميلُ",26,"ل",1,1],["زنجيَّةُ اليلِ تروي كيف قلَّدها","في عُرسها غُرَرَ الأشعار لا الشهبا",27,"ب",2,0],["زن من وزنك بما وزنك","وما وزنك به فزنه",28,"ن",2,1]]}