abi.ae/diwan/poem/54260","البسيط"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50447","الطويل"],[106,"فقيد القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179682",""],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[77,"هلُمَّ فما بيني وبينَكَ ثالثُ","https://www.poetsgate.com/ViewPoem.aspx?id=33656",""],[7,"مِنَ آلِ مَيّة َ رائحٌ، أو مُغْتَدِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17556",""],[90,"غضبة","https://www.poetsgate.com/ViewPoem.aspx?id=179231",""],[90,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[90,"جناية الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=178941",""],[9,"أصَرَمْتَ حَبْلَكَ مِنْ لَمِي س","https://www.poetsgate.com/ViewPoem.aspx?id=20020",""],[45,"عَذيري فيكِ مِنْ لاحٍ، إذا مَا","https://www.poetsgate.com/ViewPoem.aspx?id=31878",""],[45,"رَأتْ وَخْطَ شيْبٍ من عذاري، فصَدّت","https://www.poetsgate.com/ViewPoem.aspx?id=33105",""],[80,"ومسبلة ٍ دَمعاً يَسوغُ عذوبة ً","https://www.poetsgate.com/ViewPoem.aspx?id=3046",""],[44,"قَدْكَ ائَّئِبْ أَرْبَيْتَ في الغُلَوَاءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15644&r=&rc=4",""],[96,"في القرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66357&r=&rc=33",""]],"verses":[["غِناءُ ظُبانا عَويلُ النِساءِ","وَقَرعُ قَنانا لِطامُ اللِمَم",0,"م",1,0],["غَنِيَت بِهِم تَحتَزُّ دونَ مَنالِها","قِمَمُ العِدى وَيُرَدُّ عَنها الفَيلَقُ",1,"ق",1,0],["غَنِيَت بِحَليِ الحُسنِ عاطِلَةٌ","ما لِلنُضارِ بِجيدِها وَبَصُ",2,"ص",1,0],["غِناءً إِذا خاضَ المَسامِعَ لَم يَكُن","أَميناً عَلى جِلبابِهِ المُتَجَلبِبُ",3,"ب",1,0],["غِنى المَرءِ عِزٌّ وَالفَقيرُ كَأَنَّهُ","لَدى الناسِ مَهنوءُ المِلاطَينِ أَجرَبُ",4,"ب",1,0],["غَنِيَتْ عَواطِلَ بَعْدَما صاغتْ حُلَى","أطواقِها بِنَوالِهِ الآلاءُ",5,"ا",2,0],["غَنُوا في جاهِليَّتِهمْ لَقاحاً","ونارُ الحَربِ تَشْتَعِلُ اشتِعالا",6,"ل",2,0],["غناك شعري والربيع وصفوه","أهدى إليك زهوره والعندما",7,"م",2,0],["غَنَناً باطِلاً وَظُلماً كَما تُع","تَرُ عَن حَجرَةِ الرَبيضِ الظَباءُ",8,"ا",2,0],["غَنيٌّ بِلا مالٍ عَنِ الناسِ كُلِّهِم","وَلَيسَ الغِنى إِلّا عَنِ الشَيءِ لا بِهِ",9,"ب",2,0],["غَنِيٌّ بِتَصْهَالِ الْجِيَادِ عَنِ الْقَنَا","فَلاَ الزِّيرُ يَسْتَهْوِي نُهَاهُ وَلاَ الْبَمُّ",10,"م",1,0],["غَنينَا عنِ البحْرِ الذي غاضَ بالحَيا","وعنْ كوْكَبِ العَلْياء بالقَمَرِ السّعْدِ",11,"د",1,0],["غَنِينا فلَمْ نَحْتَجْ الى البَدْرِ والحَيا","إذا ضنّ غيْثٌ أو إذا جنّ جادِثُ",12,"ث",1,0],["غَنيٌّ بحِفْظِ اللهِ عنْ حِفْظِ نَفْسِهِ","إذا خيفَ أمْرٌ أو تُوُقِّعَ حادِثُ",12,"ث",1,0],["غَنِّني كَم لَكَ عِندي مِن يَدٍ","سَرَّتِ الأَشجانَ عَنّي وَالفِكَر",13,"ر",1,0],["غَنّى مُغَنّيهِ فَهاجَ غِناؤُهُ","شَجوَ الحَمامِ عَلى ذُوائِبِ بانِهِ",14,"ن",2,0],["غَنَّيا المَشرِقَينِ ما تَرَكَ الأَف","لاكَ حَيرى وَأَذهَلَ الأَجراما",15,"م",2,0],["غَنِيٌّ عَنِ الإِبساسِ دَرُّ نَوالِهِ","إِذا استَنزَلَ الدَرَّ البَكيءَ عِصابُ",16,"ب",1,0],["غُنمُ أَحبابِكَ أَن تَب","قى وَإِن عُمّوا فَناءَ",17,"ا",2,0],["غَنِيٌّ فَحُسنُ الظَنِّ بِاللَهِ مالُهُ","عَزيزٌ فَصُنعُ اللَهِ مِن حَولِهِ جُندُ",18,"د",1,0],["غَنيتُ فَلَم أَردُدكُمُ عِندَ بُغيَةٍ","وَجُعتُ فَلَم أَكدُدكُمُ بِالأَصابِعِ",19,"ع",1,0],["غنىً لا يحل الزهد فيه لفاضلٍ","حصيفٍ إذا في غيره حسن الزهد",20,"د",1,0],["غنى جميل بالغاً غاياته","في الفن حتى كان فجر نهار",21,"ر",1,0],["غَنى بِشِعْرٍ عَلَى الدَّهْ","رِ لَمْ يَزَلْ مَروِيَّا",22,"ي",2,0],["غَنِيَتْ عَنْ حِلَى البَدِيعِ القَوَافِي","بِحُلاهَا وَبَعْضُهَا يُغْنِيهَا",23,"ي",3,0],["غَنَّتْكِ مَيُّ وَ مَيٌّ أَيًّ سَاجِعَةٍ","بَيْنَ الشَّجَى فِي نَشِيدِ الخُلْدِ وَالشَّجَنِ",24,"ن",1,0],["غنيتَ بنور اله عن كلّ زينةٍ","وأُلبِستَ من رضوانه أشرف الحلى",25,"ل",2,0],["غنَى عليه الطير وهو بدوحه","والآن غنَّى فوقه ظبي أغَرْ",26,"ر",1,0],["غِنىً وَمالاً طارِفاً وَأَتلَدا","شَرخاً صُقوراً يافِعاً وَأَمرَدا",27,"د",2,0],["غنائم لم تجمع ثلاثاً وأربعاً","مسائل بالالحاف شتى ضُروبُها",28,"ب",3,0],["غنيت فلم أرددكم عند بغية","وحِجتُ فلم أكددكم الأصابعِ",29,"ع",1,1],["غِنى النَفسِ لِمَن يَعقِ","لُ خَيرٌ مِن غِنى المالِ",30,"ل",1,1],["غني اليراعُ به وأظهرَ طرسهُ","وكذا تكون الرَّوضةُ الغنَّاء",31,"ا",2,0],["غنينا زماناً في ظلالِ نواله","فلله ما أغنى زماناً وأرْغدا",32,"د",2,0],["غنينا عن السبعِ البحار بأنملٍ","أفيضت كما يغنى عن السبع بالعشر",33,"ر",1,0],["غني بكأسك يا نديم فإنّ لي","جفناً مدامعه أرقّ وأرْوَق",34,"ق",1,0],["غنّني يا نديم باسم هواه","وثناء الوزير في الآفاق",35,"ق",1,0],["غنيت بجدواه فأطربني السرى","ولا عجبٌ أن يطرب المرء بالغنا",36,"ن",2,0],["غنَّى بها الشادي وأعرب نظمها","فزهت على التعريب والتلحين",37,"ن",1,0],["غنَّيت بحسنك عن واصفٍ","وما كلُّ غانيه غانيه",38,"ي",2,0],["غنِيتُ في ظلالِهِ عن الورى","غنى نزيل المزن عن قصد القرى",39,"ر",2,0],["غَنِيٌّ عن الريحان مجلسُ شَرْبها","بنشرٍ كنشر المسك في مُحتوىً نهبِ",40,"ب",1,0],["غنَّت فمسَّ القلبَ كلُّ كرْبِ","واستوجبتْ منا أليمَ الضربِ",41,"ب",1,1],["غَنِينَ عن القوادم والهوادي","وعن إسْرَاجِهِنَّ لدى الركوبِ",42,"ب",1,0],["غَنِيتُ بها فيهنَّ والشملُ جامعٌ","وأغصانُ عيشي مورقاتٌ أَثائثُ",43,"ث",1,0],["غناؤه يشتكي حرارته","وريقه يشتكي من الخَصَرِ",44,"ر",1,0],["غناؤها كله كِياد","من نضْح أشداقها المطيرَه",45,"ر",2,0],["غنت فلم تحوج إلى زامرٍ","هل يحوج الصبح إلى شمعه",46,"ع",2,0],["غنِّ أبا حفصٍ إذا جئته","بشعره فيَّ بإيقاعِ",47,"ع",1,1],["غناءٌ ووجهٌ مونقانِ كلاهما","يهيلانِ جُولَيْ ذي الحِجى المتماسك",48,"ك",1,0],["غنَّتْ نهاراً وباتتْ وهْي زامرةٌ","حتى الصباحِ وللأحوالِ تحويلُ",49,"ل",1,0],["غَنّى فَفي النَسَماتِ وَالأَوراقِ","وَالغُدرانِ أَعراسٌ بِلا ضَوضاءِ",50,"ا",2,0],["غَنَّيتَ مِن قَبلُ المَحولَة وَالعَرى","أَفَلا تُغَنّي الرَوضَةَ المِخصابا",51,"ب",2,0],["غَنَّيتَ بِالضاد وَأَسرارِها","عَنِ الغَواني وَالطَلا وَالسُقاة",52,"ه",1,0],["غَنَّيتَها فَاِستَيقَظَت وَتَرَنَّحَت","وَتَأَلَّقَت كَالكَوكَبِ المُتَوَقِّدِ",53,"د",1,0],["غَنِّنا حَتّى نَميلا","مِثلَ أَغصانِ الأَراك",54,"ك",1,0],["غَنِيَت عَينُ مَن يَرا","كَ عَنِ الشَمسِ وَالقَمَر",55,"ر",1,0],["غَنَّاهُ الأَمْسُ وأَطْرَبَهُ","وشَجَاهُ اليومُ فَما غَدُهُ",56,"د",2,1],["غنِّني فالغِناءُ يَدْرَأُ عنَّا السَّاحرَ","الجنَّ ساكنَ الآجامِ",57,"م",1,0],["غنِّني يا أُخَيَّ فالكوْنُ تَيْهَاءُ","بها قَدْ تمزَّقتْ أَقْدامي",57,"ي",1,0],["غنِّني علَّ