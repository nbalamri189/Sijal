{"poems":[[55,"أبينتها أم ناكرتك شياتها","https://www.aldiwan.net/poem30677.html","الطويل"],[47,"أمن أجل أن أقوى الغوير فواسطه","https://www.aldiwan.net/poem64650.html","الطويل"],[255,"لا تقطعن عادة بر ولا","https://www.aldiwan.net/poem15000.html","السريع"],[473,"أخ لي أمسى في عطاياه أخطر","https://www.aldiwan.net/poem60090.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138409",""],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198417","الخفيف"]],"verses":[["فَإِن أَثمَرَت لي غَيرَ ما كُنتُ آمِلاً","فَلا ذَنبَ لي إِن حَنظَلَت نَخَلاتُها",0,"ت",3,0],["فَإِن أُثنِ لا أَبلُغ وَإِن أُلفَ غامِطاً","لِطَولِكَ لايَسعَد بِطَولِكَ غامِطُه",1,"ط",2,0],["فإن إثم الإفك من مسطح","يحطَّ قدرَ النجم عن أفقِهِ",2,"ق",2,0],["فَإِن أَثمَرَت آلاؤُهُ في مَغارِسي","فَفي رَوضِهِ مِنّي اِعتِرافٌ مُنوِّرُ",3,"ر",1,0],["فان آثاره فيه لناطقة","بالفضل قام عليه الف برهان",4,"ن",1,0],["فأنا ثابت البناني لكن","لي قلب عن النواسي أزيلا",5,"ل",2,0]]}