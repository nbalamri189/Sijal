ل","https://www.poetsgate.com/ViewPoem.aspx?id=34143",""],[100,"ليلة خائف","https://www.poetsgate.com/ViewPoem.aspx?id=50433",""],[90,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[91,"معركة شمولبو","https://www.poetsgate.com/ViewPoem.aspx?id=53085",""],[91,"الكرنفال","https://www.poetsgate.com/ViewPoem.aspx?id=53142",""],[105,"ناد القبور وبشر كل مقبور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55005&r=&rc=175",""]],"verses":[["وَالجَفنُ يَفتُرُ عَن طَرفٍ صَحِبتُ بِهِ","إِنسانُهُ مُثقَلُ العِطفَينِ بِالوَسَنِ",0,"ن",1,0],["وَالجَليدَ الَّذي إِذا الدَهرُ أَبكى","مِنهُ قَلباً جَلّى عَلى الناسِ ثَغرا",1,"ر",2,0],["وَالجَيشُ يَرفَعُ عِمَّةً مِن قَسطَلٍ","فَوقَ القَنا وَيجُرُّ ذَيلَ حَديدِ",2,"د",1,0],["وَالجِسْمُ مِنّي مُشْعِرٌ مَرَضاً","مُذْ دَبَّ في أَلْحاظِها المَرَضُ",3,"ض",1,0],["والجهلُ يُغريهِ على غِيّهِ","بهِ وقِرْنُ الدّهْرِ مَغلوبُ",4,"ب",1,0],["والجُرْدُ صافِنَةٌ لِيثَتْ بأجْرَعِه","لَها على الأثَلاتِ الشُّمِّ أرْسانُ",5,"ن",1,0],["والجارُ يأمَنُ في ذَراهُ كأنَّما","عَقَدَتْ مَكارِمُهُ عليهِ تَميما",6,"م",2,0],["وَالجَوُّ أَقتَمُ وَالنُجومُ مُضيئَةٌ","وَالأُفقُ مُغبَرُّ العَنانِ الأَربَدِ",7,"د",1,0],["وَالجِنُّ تَفرَقُ حَولَ غاباتِ الفَل","بِهَماهِمٍ وَدَمادِمٍ لَم تَغفَلِ",8,"ل",1,0],["وَالجِسمُ مِنهُ قَد أَضَرَّ بِهِ البِلى","وَالقَلبُ مِنهُ ما يُطاوِعُ مَن نَهى",9,"ا",1,0],["وَالجِسمُ مِنِّيَ مَنهوكٌ لِفُرقَتِها","يَبريهِ طولُ سَقامٍ فَهوَ مَنحولُ",10,"ل",1,0],["وَالجَدُّ يُدني كُلَّ أَمرٍ شاسِعٍ","وَالجَدُّ يَفتَحُ كُلَّ بابٍ مُغلَقِ",11,"ق",1,0],["وَالْجُودُ أَنَّكَ غَيْثُهُ الْهَامِي الْحَيَا","هَذَا وَكُلَّ شَاهِدٌ مَقْبُولُ",12,"ل",1,0],["وَالْجُودُ لَيْسَ لَهُ غَمَامٌ هَاطِلٌ","وَالْمَجْدُ لَيْسَ لَهُ سَنَامٌ بَاتِكُ",13,"ك",1,0],["وَالجِنُّ تَعزِفُ حَولَها","كَالحُبشِ في مِحرابِها",14,"ب",3,0],["وَالجارُ أوصيكُمُ بِالجارِ إِنَّ لَهُ","يَوماً مِنَ الدَهرِ يَثنيهِ فَيَنصَرِفُ",15,"ف",1,0],["وَأَلجَموا كُلَّ داعٍ","وَأَحرَجوا المُصلِحينا",16,"ن",2,0],["وَالجانِبَ المُستَوضَحَ العَجيبا","وَالحاضِرَ المُنفَسِحَ الرَحيبا",17,"ب",2,0],["وَالجودِ وَالأَيدي الطِوالِ","المُستَفيضاتِ السَوامِح",18,"ح",1,0],["وَأَلجا بَردُها الأَشوالَ حُدباً","إِلى الحُجُراتِ بادِيَةً كُلاها",19,"ا",3,0],["وَالجِرِيءُ الَّذِي اقْتَفَى","وَالبطِيءُ الَّذِي نَوى",20,"و",2,0],["وَالجَانِبَ اللَّيِّنَ حَتَّى إِذَا","دَعَا حِفَاظٌ عَادَ مَا أَخْشَنَهْ",21,"ن",2,0],["وَالجُودَ تَفْنِي فِيهِ مِنْ رِقَّةٍ","مَا صَوَّرَ اللُّطْفَ وَمَا فَنَّنَهْ",21,"ن",2,0],["وَالجَمْعُ بَيْنَ هُدَى الْيَرَا","عِ وَبَيْنَ تَهْذِيبِ اللِّسَانِ",22,"ن",1,0],["وَالجَوُّ تَطْوِيهِ الصُّقُورُ وَتَحْتَها","فِي كُلِّ جَوٍّ تَخْفُقُ الأَعْلامُ",23,"م",1,0],["وَالجَمْعُ كَالْفَرْدِ إِنْ فَاتَتْهُ مَعْرِفَةٌ","طَاحَتْ بِهِ غَاشِيَاتُ الظُّلْمِ وَالظُّلَمِ",24,"م",1,0],["وَالجودُ يَعلَمُ أَنّي مُنذُ عاهَدَني","ما خُنتُهُ وَقتَ مَيسوري وَمَعسِرَتي",25,"ي",1,0],["والجهد مني ها هنا هو أنني","أدعو إلى الإحسان من حضروا هنا",26,"ن",2,0],["والجهل لا يُبقي على أربابه","كالسيف ليس براحم لقتيله",27,"ل",2,0],["وَالجَوُّ يَنثُرُ دُرّاً غَيرِ مُنتَظِمٍ","وَالأَرضُ بارِزَةٌ في ثَوبِ كافورِ",28,"ر",1,0],["والجود ما لحيا الشآمِ عمومهُ","فينا ولا في نيل مصرَ فناؤه",29,"ا",3,0],["والجامع الرَّحب أضحى صدرُهُ حرِجاً","والنسر ضمَّ جناحيه من الرّهب",30,"ب",1,0],["وألجمِ العذل وارْكض في محبَّته","طرف الهوى بعد إلجامٍ وإسراج",31,"ج",1,0],["والجواد الذي يحدِّث راجي","سيب كفيه عن عطا بن رباح",32,"ح",1,0],["والجود راش ذوي الجدوى وطوقهم","فما يزالون في سجع وتغريد",33,"د",1,0],["والجيشُ قد ألفتْ باليسر رايته","تألف الطرف في مغراه بالسيد",33,"د",1,0],["والجواد الذي حبا المال حتى","كاد يحبو الأعمال والأعمارا",34,"ر",2,0],["والجبر من خلقك الوضاح أجعله","لِما على ذِمتي في القصد ينكسر",35,"ر",1,0],["والجاعلون معاني المجد واضحة","بين الأنام وكان المجد كالّلغز",36,"ز",1,0],["والجأ إلى الحرم الذي جبريل من","زوَّارِه من ساجدين وركّع",37,"ع",1,0],["والجود من جاهٍ ومالٍ شاملٌ","لا مانع الجدوى ولا الماعون",38,"ن",1,0],["والجيبُ ذيلٌ لديه","للنُّوكِ والذيلُ جيبُ",39,"ب",1,0],["وألجُّ الناس ما دا","م يُحَمَّى ويُفَدَّى",40,"د",2,0],["والجود عارٌ عندهم","والبخلُ من أعلى المفاخر",41,"ر",1,0],["والجواد الذي إذا نال حظاً","لم يكن عند نيله مناعا",42,"ع",2,0],["والجاثليقُ مع الإنجيل يدرسُهُ","كأن عثنُونَهُ الكشخانُ إنجيلُ",43,"ل",1,0],["والجوادُ الطباعِ من لا تراه","حائلاً جودُه مع الأحوالِ",44,"ل",1,0],["وَالجودُ نافِيَةٌ لِلمالِ مُهلِكَةٌ","وَالبُخلُ مُبقٍ لِأَهليهِ وَمَذمومُ",45,"م",1,0],["وَالجَهلُ ذو عَرَضٍ لا يُستَرادُ لَهُ","وَالحِلمُ آوِنَةً في الناسِ مَعدومُ",45,"م",1,0],["وَالجَيشِ تَحتَ البَندِ مُحتَشِداً","إِن لَم يَكُن لِلحَربِ مُحتَشِدا",46,"د",2,0],["وَاِلجُمِ الماءَ في الغَدير وَمُرهُ","لا يُصَفِّق إِلّا وَأَنتَ بِمَشهَد",47,"د",1,0],["وَالجَمعُ يَهتُفُ كُلَّما","مَرَّت عَلى الحَشدِ الغَفيرِ",48,"ر",1,0],["وَالجَوُّ أَظلَم وَاِكفَهَرَّ أَديمُهُ","حَتّى كَأَنَّ عَلى السَماءِ سِتارا",49,"ر",2,0],["وَالجَمعُ حَولي يَضُجُّ مُبتَهِجاً","كَأَنَّهُ لسَيلُ حينَ يَندَفِقُ",50,"ق",1,0],["وَالجَوُّ بِالنَقعِ المُثارِ مُلَثَّمٌ","وَالبَحرُ بِالسُفُنِ الدَوارِعِ مُثقَلُ",51,"ل",1,0],["وَالجَدوَلُ لجَذلانُ يَضحَكُ لاهِياً","وَالنَرجِسُ الوَلهانُ مُغفٍ يَحلَمُ",52,"م",1,0],["وَالجَيشُ مَعقودٌ لِواأُكَ فَوقَهُ","ما دُمتَ تَكسوهُ وَتُطعِمُهُ",53,"ه",1,0],["وَالجَدُّ إِن أَمضى عَزيمَةَ ماجِدٍ","راحَ السُكونُ يَنوبُ عَن حَرَكاتِهِ",54,"ت",2,0],["وَالجوعُ قَد نالَ مِنّا","فَكُن سَريعَ الإِجابَه",55,"ب",2,0],["والجِدُّ للشَّعْبِ روحٌ","تُوحي إليهِ الهَناءْ",56,"ا",2,0],["والجيش في تنكيله بعصابة","قد افسدت والقائد الممتاز",57,"ز",1,0],["والجلنار كأنه الياقوت قد","حملته فوق زبرجد قضبان",58,"ن",1,0],["والجُلِّنار دم على أوراقهِ","قاني الحروفِ كخاتم السفاح",59,"ح",1,0],["وَالجَهلُ مَوتٌ فَإِن أوتيتَ مُعجِزَةً","فَاِبعَث مِنَ الجَهلِ أَو فَاِبعَث مِنَ الرَجَمِ",60,"م",1,0],["وَالجُهدُ موتٍ في الحَياةِ ثِمارَهُ","وَالجُهدُ بَعدَ المَوتِ غَيرُ مُضاعِ",61,"ع",1,0],["وَالجُبنُ في قَلَمِ البَليغِ نَظيرُهُ","في السَيفِ مَنقَصَةٌ وَسوءُ سَماعِ",61,"ع",1,0],["وَالجاعِليها قِبلَةً","عِندَ التَرَنُّمِ وَالصَلاةِ",62,"ه",1,0],["وَالجاهِلِيَّةُ مِن وَراءِ قُبورِهِم","يَبكونَ زيدَ الخَيلِ وَالفَلحاءَ",63,"ا",2,0],["وَالجُندُ يَدفَعُ في رِكا","بِكَ بِالمُلوكِ مُصَفَّدين",64,"ن",1,0],["وَالجَبَرتِيُّ عَلى فِطنَتِهِ","مَرَّةً يَغبى وَحيناً يَتَغابى",65,"ب",2,0],["وَالجَماعاتُ ثَنايا المُرتَقى","في المَعالي وَجُسورُ العابِرين",66,"ن",1,0],["وَالجوعُ فَتّاكٌ وَفيهِ صَحابَةٌ","لَو لَم يَجوعوا في الجِهادِ لَصاموا",67,"م",3,0],["وَالجَهلُ حَظُّكَ إِن أَخَذ","تَ العِلمَ مِن غَيرِ العَليمِ",68,"م",1,0],["وَالجاعِلينَ سُيوفَ الهِندِ أَلسِنَهُم","وَالكاتِبينَ بِأَطرافِ القَنا السُلُبُ",69,"ب",1,0],["وَالجَواري في البَحرِ يُظهِرنَ عِزَّ ال","مُلكِ وَالبَحرُ صَولَةٌ وَثَراءُ",70,"ا",2,0],["وَالجِنُّ مِن سُتُراتِها وَالوَحشُ مِن","فَلَواتِها وَالطَيرُ مِن وُكناتِها",71,"ت",3,0],["وَالجِراحاتُ عِندَهُ نَغَماتٌ","سَبَقَت قَبلَ سَيبِهِ بِسُؤالِ",72,"ل",1,0],["وَالجودُ عَينٌ وَأَنتَ ناظِرُها","وَالبَأسُ باعٌ وَأَنتَ يُمناهُ",73,"ا",2,0],["والجند خارجها تحاصر أهلها","قد ضاق منها بالحصار خناقُ",74,"ق",1,0],["والجسد المنحلُ عن روحه","فروحه إن تركت تتركه",75,"ك",2,0],["والجسم ذو التركيب ما فيه صبغة","منه وفيه مركز ومحيطُ",76,"ط",1,0],["والجسد الكحليّ ابّارنا","وهو المظلم النحسُ",77,"س",1,0],["والجوهر الأول قيد الذي","تطلبه بالقوة المحضه",78,"ض",2,0],["والجسد اللين الضعيف هوال","حابس للآبقات بالثقلِ",79,"ل",1,0],["والجردُ مثقلةُ الرِقابِ يؤُودُها","حَمْلُ النُّضارِ بكدِّها ويرينُ",80,"ن",1,0],["والجهلُ للنفسِ رقٌّ وهي إنْ ظَفِرَتْ","بالعِتق فالناسُ والدنيا لها خَدَمُ",81,"م",1,0],["والجُودُ والإقدامُ في فِتيانهمْ","والبُخْلُ في الفتياتِ والإشفاقُ",82,"ق",1,0],["وَالجَوادُ المَوصوفُ لَو لَم يَعِبهُ","شُحُّهُ بِالفَعالِ وَاِستِئثارُه",83,"ر",2,0],["وَالجَوادُ الأَغَرُّ مِثلُكَ لا","يَمنَعُ مِثلي مِنَ الجَوادِ الأَغَرِّ",84,"ر",1,0],["وَالجازِرينَ وَهَتمِ إِبراهيمَ في","ثِنيَيهِما تِلكَ الثَنايا الروقا",85,"ق",2,0],["وَالجَوادُ العَتيقُ حاجَزتَني في","هِ لِلا عِلَّةٍ بِوَعدٍ عَتيقِ",86,"ق",1,0],["وَالجودُ يَعذِلُهُ عَلَيهِ حاتِمٌ","سَرفاً وَلا جُدٌ لِمَن لَم يَعذِلِ",87,"ل",1,0],["وَالجَعفَرِيُّ وَكانَ بِشرٌ قَبلَهُ","لي مِن قَصائِدِهِ الكِتابُ المُجمَلُ",88,"ل",1,0],["والجو في حلة ممسكة","قد طرزتها البروق بالذهب",89,"ب",1,0],["والجورَ يَكرهُ غيرَ أنَّ يمينَه","أبداً تجورُ على اللُّهى فتُقَبَّلُ",90,"ل",1,0],["والجوُّ قد كادَتْ ثُرَيْ","اهُ على الغَربِ تَرِد",91,"د",1,0],["والجوُّ في مُمسَّكٍ","طِرازهُ قَوْسُ قُزَح",92,"ح",1,0],["والجوُّ يختالُ في حُجْبٍ ممسَّكةِ","كأنما البرقُ فيها قلبُ ذي رُعُبِ",93,"ب",1,0],["وَالجِدُّ مِن خَيرِ ما أَعانَك أَو","صُلتَ بِهِ وَالجُدودُ تُهتَصَرُ",94,"ر",1,0],["وَالجامِعينَ المُكثِري","نَ مِنَ الخِيانَةِ وَالغُلولِ",95,"ل",1,0],["وَالجِنُّ عُمّارُ البُيو","تِ بَكَوا وَسُكانُ الفَضاءِ",96,"ا",2,0],["وَالجُنونُ الفُحشُ الَّذي صِرتُ مِنهُ","خارِجاً عَن طَبيعَةِ الإِنسانِ",97,"ن",1,0],["وَالجَوادُ السَهلُ اللِقاءِ إِذا ما","كانَ سَهلُ اللِقاءِ غَيرَ جَوادِ",98,"د",1,0],["وَالجِسرُ واهي السِلكِ مِن","فَرطِ اِضطِرابٍ وَاِهتِزازِ",99,"ز",1,0],["وَالجَوادُ السَمِحُ الَّذي مَرَجَ ال","بَحرَينِ مِن راحَتَيهِ يَلتَقِيانِ",100,"ن",1,0],["وَالجَوسَقَ الفَردَ في لُجِّ البُحَيرَةَ وَال","صَرحَ المُمَرَّدَ فيهِ مِن قَواريرِ",101,"ر",1,0],["وَالجَيشُ مُمتَدُّ الجَوانِبِ حَولَهُ","يُفلى بِهِ فَودُ الفَلا وَالمَفرِقُ",102,"ق",1,0],["وَالجِزعُ حَنَّ إِلى عُلاكَ مُسَلِّماً","وَبِبَطنِ كَفِّكَ سَبَّحَ الصُوّانُ",103,"ن",1,0],["والجوّ أقبَلَ في تراكبِ مُزْنهِ","قُزَحٌ بعطفةِ قَوْسِهِ يَتَنَكّبُ",104,"ب",1,0],["والجودُ في يمناك منه حيا","واليُمْنُ في يُسْرَاكَ منه زمام",105,"م",1,0],["والجهلُ في شِيمِة الإنسان أقتلُ من","تخلخل النّبْضِ في بُحرانِ مُنتَقسِ",106,"س",1,0],["والجَوُّ مُتَّقِدُ الأحشاءِ مُكتَئِبٌ","كَأَنَّما البرقُ فيها لِلأَسى سُعُرُ",107,"ر",1,0],["وَالجَعفَرِيّونَ اِستَقَلَّت ظُعنُهُم","عَن قَومِهِم وَهُمُ نُجومُ كِلابِ",108,"ب",1,0],["وَالْجَوُّ فِي حُلَّةٍ دَكْنَاءَ مَازَجَهَا","خَيْطٌ مِنَ الْفَجْرِ يَبْدُو ثُمَّ يَشْتَبِهُ",109,"ه",1,0],["والجاهلُ الخائنُ في منصبٍ","عالٍ وأرضى لا وربِّ العلى",110,"ل",2,0],["والجَاعِلينَ بُيوتَهُمْ وقُبورَهُمْ","للسَّائِلينَ عَنِ الكِرَامِ دِلِيلا",111,"ل",2,0],["والجهادُ الحقُّ بالأبطالِ أَحْرَى","يا رجالَ اللِه سِيروا باللِّواءْ",112,"ا",2,0],["والجاهليّةُ في مظاهرِ عِزِّها","ما ينقضِي صَلَفٌ لها وعُرامُ",113,"م",1,0],["والجهلُ أنفعُ ما تَرْقَى الشُّعوبُ بهِ","والذُّلُّ أسمى الأمانِي للجماهيرِ",114,"ر",1,0],["وَالجَمعُ مُحتَفِلٌ يَطوفُ بِسُدَّةٍ","تُلقي عَلَيهِ مِنَ الجَلالِ حِجابا",115,"ب",2,0],["وَالجُندُ مِن حَولِ المَواكِبِ واقِفٌ","صَفَّينِ مِن حَولَيهِما صَفّانِ",116,"ن",1,0],["وَالجودُ يُحمَدُ حَيثُ كانَ وَخَيرُهُ","ما نالَ أَوطانَ الفَتى وَبَنيها",117,"ي",3,0],["وَالجِياد العِتاق وَلهى طرادٍ","مُسرِعات بِهُم إِلى المَيدان",118,"ن",1,0],["وَالجارُ وَسطَهُمُ يَزيدُ عَطاؤُهُ","بِتَتابُعِ الهَلَكاتِ وَالأَحجارِ",119,"ر",1,0],["والجماداتُ أفصحت بالذي أُخ","رِسَ عنه لأَحمدَ الفُصحاءُ",120,"ا",2,0],["وَالجَوَادُ الذِي به تُفْرَجُ الغُم","مَةُ عَنا وتُكْشَفُ الحَوْباءُ",120,"ا",2,0],["والجِذْعُ حَنَّ لهُ وباتَ كمغْرَمٍ","قَلِقٍ بفَقْدِ حَبيبِه يَتَكَرَّبُ",121,"ب",1,0],["والجَذْلُ مِنْ حَطَبٍ غَدا لِعُكاشَةٍ","سَيْفاً وليس السَّيفُ مما يُحْطَبُ",121,"ب",1,0],["والجِنُّ تُنْشِدُ وحْشَةً لِفِرَاقِهِ","شِعْراً تَفيضُ به الدُّموعُ وتُسْكَبُ",121,"ب",1,0],["والجِنُّ تَهْتِفُ وَالأَنْوارُ ساطِعَةٌ","وَالحَقُّ يَظْهَرُ مِنْ مَعْنَى ومِنْ كَلِمِ",122,"م",1,0],["والجوَّ يَعثِرُ بالأسِنّةِ والظُّبَى","والأرضُ واجِفَةٌ تَمِيلُ مَميلا",123,"ل",2,0],["وَالجيدُ جيدُ غَزالٍ","وَالغِنجُ غِنجُ فَتاةِ",124,"ه",1,0],["وَالجيدُ زَينٌ لِمَن تَأَمَّلَهُ","أَشبَهُ شَيءٍ بِجيدِ تِنّينِ",125,"ن",1,0],["وَالجَدُّ لَيسَ بِزائِدٍ في رِزقِ مَن","يَسعى وَلَيسَ بِنائِمٍ عَن نائِمِ",126,"م",1,1],["وَالجارَ وَالأَقرَبَ وَالمُصاهِرا","إِيّاكَ يا اِبنَ القَومِ أَن تُفاخِرا",127,"ر",2,0],["وَالجُردُ مِثلُ عَجوزِ النارِ قَد بَرَدَت","شَوهاءُ شَهباءُ مُزوَرٌّ بِها الكَتَدُ",128,"د",1,0],["وَالجُسومُ التُرابُ تَحيا بِسُقيا","فَلِهَذا قُلنا سُقيتِ السَحابا",129,"ب",2,0],["وَالجُسمُ كَالثَوبِ عَلى رَوحِهِ","يُنزِعُ أَن يُخلِقَ أَو يَتَّسِخ",130,"خ",1,0],["وَالجيدُ يَنعَمُ أَو يُشقى وَيَدرُكُهُ","ريبُ المَنونِ فَلا عِقدٌ وَلا مَسَدُ",131,"د",1,0],["وَالجِسمُ لِلرَوحِ مِثلُ الرَبعِ تَسكُنُهُ","وَما تُقيمُ إِذا ما خُرِّبَ الجَسَدُ",132,"د",1,0],["وَالجُسمُ يَهوي بِالطِباعِ إِلى الثَرى","وَيَبينُ فيهِ تَكَلُّفُ الإِصعادِ",133,"د",1,0],["وَالجَهلُ أَغلَبُ غَيرَ عِلمٍ أَنَّنا","نَفنى وَيَبقى الواحِدُ القَهّارُ",134,"ر",1,0],["وَالجِسمُ أَصلٌ فَرَّعَتهُ قُدرَةٌ","فَأَبانَ خالِقُهُ حَصىً وَجَواهِرا",135,"ر",2,0],["وَالجَدُّ آدَمُ وَالمَثوى أَديمُ ثَرىً","وَإِن تَخالَفَتِ الأَهواءُ وَالشِرَعُ",136,"ع",1,0],["وَالجَدُّ يَأتيكَ بِالأَشياءِ مُمكِنَةً","وَلا تُنالُ بِإِشآمٍ وَإِعراقِ",137,"ق",1,0],["وَالجِسمُ لِلروحِ دارٌ طالَما لَقِيَت","هَدماً وَحُقَّ لِرَبِّ الدارِ تَحويلُ",138,"ل",1,0],["وَالجِسمُ ظَرفُ نَوائِبٍ وَكَأَنَّهُ","ظَرفٌ يُؤَخِّرُ تارَةً وَيُقَدِّمُ",139,"م",1,0],["وَالجَذَعُ الأَزلَمُ لَم يُبقِ ذا","رُمحٍ مِنَ الناسِ وَلا ذا زَلَم",140,"م",1,0],["وَالجِسمُ لا شَكَّ أَرضِيٌّ وَقَد وَصَلَت","بِهِ لَطائِفُ عالاها مُعاليها",141,"ي",3,0],["وَالجَدُّ أَبراها لِمَن راضَها","فَاِنهَض إِلى عَنسكَ إِبراهِ",142,"ه",1,0],["والجيمُ فيِه إنْ تَعُدْ دالَهُ","والدّالُ جيماً فيِه مَحْسوبَه",143,"ب",2,0],["والجنان التي بها العسل الما","ذيُّ قد صفوه وفيها الحور",144,"ر",1,0],["والجحيم التي بها النار تذكو","في دهور وراءهنَّ دهور",144,"ر",1,0],["والجاهلون قعود في مجالسهم","فلا اعتماد لهم إلا على القدر",145,"ر",1,0],["وَالجهل أشبه بالظلا","م يحفه من كل جانب",146,"ب",1,0],["وَالجحد لَيسَ بضائر","مَجداً من الأدب اِستمدا",147,"د",2,0],["وَالجند يصدم جنداً","مرابطاً لا يَخور",148,"ر",1,0],["والجمع بين الدين والدنيا","كما جاء الخبر",149,"ر",1,0],["وَالجسم مهما دامَ في اِستقراره","فيه جواهر مالها استقرار",150,"ر",1,0],["والجاه ليس بأَلقاب مفخمة","تهدَى لمنغمسٍ في الإثم منتهب",151,"ب",1,0],["وَالجهل يوقفهم عَلى","جرف من الأوهام هاري",152,"ي",1,0],["وَالجوهر الفرد في الأجسام لَيسَ سوى","كهيربات بِها يَقوى وَيَقتَدِر",153,"ر",1,0],["والجود عينٌ وأنت ناظرها","والبأس باعٌ وفيك يمناه",154,"ا",2,0],["وَالجوعُ فَرّاسٌ لَهُ","ظُفرٌ يَصولُ بِهِ وَناب",155,"ب",1,0],["وَالجَواري في النيلِ مِن عَهدِ نوحٍ","لَم يُقَدَّر لِصُنعِها تَغييرُ",156,"ر",1,0],["والجند كالدنيا مع الموفّق","أعوانُهُ على الشقيّ المخفق",157,"ق",1,0],["والجامِعُ الأَعْلَى يغصُّ بكُلِّ مَن","يتلو ويَسْمَعُ ما يَشاءُ ويَنْظُرُ",158,"ر",1,0],["والجُزءُ ما لم ترَ فيهِ خَرْما","فَإنّه المَوْفورُ قد يُسمَّى",159,"م",2,0],["والجُزءُ إذ يخلو من التعاقُبِ","فهو بَريءٌ غَيرَ قَولِ الكاذِبِ",159,"ب",1,0],["وَالجِنُّ تَفرَقُ حَولَ غاباتِ الفَلا","بِهَماهِمٍ وَدَمادِمٍ لَم تَغفَلِ",160,"ل",1,0],["وَالجَمَاعَاتِ إِخْوَةٌ وَفَخَارٌ","لِلمُوَلِّينَ أَنَّهُمْ خُدَّامُ",161,"م",1,0],["وَالجَوْهَرُ المَكْنُونُ لاَ بُدَّ أَنْ","يُجْلَى وَأَنْ يَنْجَابَ عَنْهُ العَرَضْ",162,"ض",1,0],["وَالجَهْلُ دَاءٌ قَدْ تَقَادَمَ عَهْدُهُ","فِي الْعالَمِينَ وَلاَ يَزَالُ عُضَالاَ",163,"ل",2,0],["وَالْجِيدُ زِينَ مِنَ النُّضَا","رِ بِحِلْيَةٍ لمْ تُصْنَعِ",164,"ع",1,0],["وَالجَوُّ تَمْلأُهُ نُسَا","لاَتُ البُرُوقِ اللُّمَّعِ",164,"ع",1,0],["والجَديدَانِ يَضْرِبَانِ عَلَيْه","كُلَّ رَحْبٍ فِي مِصْرَ بِالاسْدَادِ",165,"د",1,0],["وَالْجَوُّ صَفْوٌ وَالنَّسِيمُ نَدُّ","مَا أَبْهَجَ الْعَيْشَ إِذَا تَلاَقَى",166,"ق",2,0],["وَالْجَاهِلِيُّونَ لاَ يَرْضَوْنَ خَالِقَهُمْ","إِلاَّ كَعَبْدٍ لَهُمْ فِي شَكْلِ مَعْبُودِ",167,"د",1,0],["وَالجِسْرُ مَمْتَدٍّ قَوِيمٌ لاَ تَرَى","فِيهِ مَظِنَّةَ خَاطِفٍ أَوْ سَالِبِ",168,"ب",1,0],["وَ الْجَاحِظُ الْمَرِحُ اللَعُو","بُ يَغُوصُ لِلدُرِّ الْفَرِيدِ",169,"د",1,0],["والجوُّ أكْلَفُ والدنيا مُقطِّبةٌ","أيّامُها البيضُ من ليلاتها السّود",170,"د",1,0],["والجندُ والأعوانُ ترعى موكِباً","ما حازه سابُورُ ذو الأكتَافِ",171,"ف",1,0],["والْجَوُّ أَكْلَفُ والسَّماءُ مَرِيضَةٌ","واللَّيْلُ دَاجٍ والْخُطُوبُ تَرَامَى",172,"م",2,0],["والجو مثل الدهر تل","حقه الكدورة والصفاء",173,"ا",2,0],["والجوُّ جمرٌ حَوْلهُم","وهمو همو رَمْزُ البرود",174,"د",1,0],["والجهر بالحق بين المنكرين لهُ","رسالةُ الله أوْحَاها إلى الرسُل",175,"ل",1,0],["والجيش ده دبيته فى شبره ونهيته جبل حطين","ويحنا بجانب محمد بلمدفع اهم جيين",176,"ن",1,0],["والجود أنك غيثه الهامي الحيا","هذ وكل شاهد مقبول",177,"ل",1,0],["والجو يلهث ، كالداخن","فوق أكتاف العواصف",178,"ف",1,0],["والجيشُ خلفَك يُمضي مِن عزيمتهِ","فَرطُ الحماسِ ويُذكيها فتَستعِر",179,"ر",1,0],["والجسرُ تمنحُهُ العيونُ من المَها","في الناسِبينَ وشائجاً ومناسِبا",180,"ب",2,0],["والجسرُ يفخرُ أنَّ فوقَ أديمهِ","جثثَ الضَّحايا قد تَرَكْنَ مساحبا!",180,"ب",2,0],["والجوُّ أفرطَ في الصفاءِ فلو جرى","نَفَسٌ عليه لَبانَ في مصقوله",181,"ل",2,0],["\" والجعفريُّ \" ولم يقصِّررسمُهُ","الباقي برغُم الدَّهر عن تمثيله",181,"ل",2,0],["والجوّ أظلم واكفهرّ أديمه","حتى على السّماء ستارا",182,"ر",2,0],["والجمع حولي يضجّ مبتهجا","كأنّه السيل حين يندفق",183,"ق",1,0],["والجهل أنفع ما ترقى الشعوب به","والذي أسمى الأماني للجماهير",184,"ر",1,0]]}