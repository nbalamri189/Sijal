{"poems":[[39,"فكر بأسحم مثل السنان","https://www.aldiwan.net/poem7336.html","المتقارب"],[41,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[50,"لقد صبحت بالخير عين تصبحت","https://www.aldiwan.net/poem64432.html","الطويل"],[102,"أمسية حجرية","https://www.poetsgate.com/ViewPoem.aspx?id=50362",""],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96114","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62929","الطويل"]],"verses":[["كأن مُخَّ ريقتِه في الغُطاط","به سالخ الجلد مستبدلُ",0,"ل",1,0],["كَأَنَّ مُخَوّاها عَلى ثِفِناتِها","مُعَرَّسُ خَمسٍ وَقَّعَت لِلجَناجِنِ",1,"ن",1,0],["كَأَنَّ مَخَطَّ الصُدغِ فَوقَ خُدودِها","بَقِيَّةُ أَنقاسٍ بِإِصبَعِ لائِقِ",2,"ق",1,0],["كان مخمور يدوّي : من أنا","إنني (عنترة) هاتوا القياده",3,"د",2,0],["كأن مختلف الأرواح بينهما","فيها ملاعب أبكار معاصيرِ",4,"ر",1,0],["كأَنَّ مخاضاتِ الفراتِ صحائفٌ","وَهَرَّتَها حتى عَبَرنَ سُطُورُ",5,"ر",1,0]]}