{"poems":[[74,"ملوز الطرف أهلا","https://www.aldiwan.net/poem20548.html","المجتث"],[53,"كم جارع جرع المكاره عالما","https://www.aldiwan.net/poem66087.html","الكامل"],[93,"سمعت عويل النائحات عشية","https://www.aldiwan.net/poem8833.html","عموديه"],[93,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[45,"جللا كما بي فليك التبريح","https://www.aldiwan.net/poem9522.html","الكامل"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[82,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[52,"يا عبد باهلة الذي يتوعد","https://www.aldiwan.net/poem63931.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62240","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16655","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[92,"معرض العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179147",""],[96,"على أطلال الجزيرة العربية","https://www.poetsgate.com/ViewPoem.aspx?id=15663",""],[119,"لم تذكري الذكرى فاطيب عيشة","https://www.aldiwan.net/poem40411.html","عموديه"],[136,"تركت الشاه خشية أن أكونا","https://www.aldiwan.net/poem54723.html","الوافر"],[146,"أكذا يجازى ود كل قرين","https://www.aldiwan.net/poem58441.html","الكامل"],[240,"وباخل بت في أرجاء منزله","https://www.aldiwan.net/poem31913.html","البسيط"],[333,"هات قيثارك يا شاعر","https://www.aldiwan.net/poem55055.html","مجزوء الرمل"],[371,"رجل توكل لي وكحلني","https://www.aldiwan.net/poem17673.html","أحذ الكامل"],[438,"قد عصينا النهى فكيف النهاتا","https://www.aldiwan.net/poem12429.html","الخفيف"],[500,"لئن صوت الرعد في أفقه","https://www.aldiwan.net/poem10250.html","المتقارب"],[505,"تحل بالصدق واذكر خاشعا وأمط","https://www.aldiwan.net/poem38067.html","البسيط"],[566,"لقد وجدتم مصعبا مستصعبا","https://www.aldiwan.net/poem27829.html","الرجز"],[572,"جعلت تأمل زرقة في خاتمي","https://www.aldiwan.net/poem69510.html","الكامل"],[580,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[580,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44577","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48666","الكامل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199580","المسحوب"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105467","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96654","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25313","الرجز"],[1178,"","https://poetry.dctabudhabi.ae/diwan/poem/31473","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122031","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77973","الكامل"],[1867,"","https://poetry.dctabudhabi.ae/diwan/poem/130677","الخفيف"],[1938,"","https://poetry.dctabudhabi.ae/diwan/poem/111212","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114735","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69321","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107004","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87324","الرجز"],[2735,"","https://poetry.dctabudhabi.ae/diwan/poem/198855","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100206","الخفيف"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/137985",""],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26951","الرمل"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141847","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81696","الكامل"],[4347,"","https://poetry.dctabudhabi.ae/diwan/poem/134252","الكامل"],[5055,"وأنا حي","https://www.poetsgate.com/ViewPoem.aspx?id=72818",""],[5061,"الاجوديه","https://www.poetsgate.com/ViewPoem.aspx?id=147150",""],[5297,"رجل توكل بي وكحلنى","https://www.poetsgate.com/ViewPoem.aspx?id=181572",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5376,"وقامت أُخيَّة تلقي السلام......من حماه","https://www.poetsgate.com/ViewPoem.aspx?id=188421",""],[5464,"طرقنا بابكم فأجاب صمت","https://www.poetsgate.com/ViewPoem.aspx?id=6677",""],[6056,"الخنجر المذروب","https://www.poetsgate.com/ViewPoem.aspx?id=130515",""],[572,"جَعَلتْ تأمّلُ زرقة ً في خَاتَمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9470&r=&rc=327",""]],"verses":[["وخشكناناً أتاني","في مثل عيديَ فتلا",0,"ل",2,0],["وخَشيتُ ربي أن أسُمَّ مُوَحِّداً","ظُلْماً فأكْتَسِبَ العذاب الدائما",1,"م",2,0],["وَخَشيتُ أَن يَغدو مَعَ الرَيبِ الهَوى","كَالرَسمِ لا عِطر وَفيهِ زُهورُ",2,"ر",1,0],["وَخَشيتُ أَنَّ الوَجدَ يَسلِبُني","حِلمي وَيَغلِبُني عَلى أَمري",3,"ر",2,0],["وَخَشيتُ مِنكَ عَلى البِلادِ وَأَهلِها","ما كانَ أَنذَرَ قَومَ نوحٍ نوحُ",4,"ح",1,0],["وَخَشْيَةً أَنْ يَذُوبَ النَّهْرُ فِي نَهَرٍ","وَأَنْ يَجُورَ زَمَانٌ قَلَّمَا قَصَدَا",5,"د",2,0],["وخشوعٌ يعلوه منك وقارٌ","مُعْرِبٌ عن رَجَاحةٍ من شَمامِ",6,"م",1,0],["وَخَشيتَ سَطوَةَ عامِرِيٍّ فاتِكٍ","تَقِفُ الوُفودُ بِبابِهِ وَالوُفَّدُ",7,"د",1,0],["وخَشْخَشْتُ بِالعَنْسِ في قَفْرَةٍ","مَقِيلَ ظِبَاءِ الصَّريمِ الحُزُنْ",8,"ن",1,0],["وخَشِيتُ بَعْدَ رَجاءِ أَسْورَةٍ","يوْمَ القِيامَةِ حَمْل أغلال",9,"ل",1,0],["وخُشوعٌ من الْجَلالِ تَراءَى","وجَلالٌ من الخشوعِ تَبَدَّى",10,"د",2,0],["وخِشيتُها مكبوتةً لتحفُّزٍ","كالليثِ أرهَبُ ما يُري أن يربِضا",11,"ض",2,0],["وخشعت للنشء الجديد وقلت ذا","جند الشام فمن يطيق جلادها",12,"د",3,0],["وخشيف روض في فجاج بطاحكم","ما زال في شطحات قلبي راعيا",13,"ي",2,0],["وخشيف حاجر للظلال مسامت","يمضي ويأتي خادعا ومداجيا",13,"ي",2,0],["وخَشيَةَ أن أكُونَ كَمِثلِ شِيبٍ","إِذَا قِيمَ الأتَاىُ يُسحرِّوُنَا",14,"ن",2,0],["وخَشيَةَ أن أكُونَ نَدِيمَ آمٍ","أُنَادِ مُهُنَّ أبكَاراً وعُونَا",14,"ن",2,0],["وخَشيَةَ أن أُجَالِسَ كُلَّ نَذلٍ","يَجُرَّ ِإلَىَّ مَنقَصَةً وهُونَا",14,"ن",2,0],["وخَشيَةَ أن أكُونَ أخَادُيُونٍ","ولَم أرَ مَا بِه أقضِى الدُّيونَا",14,"ن",2,0],["وخَشيَةَ أن يَكُونَ بَيَاضُ وَجهِى","سَوَاداً لاَ تُغَيِّرُهُ السِّنُونَا",14,"ن",2,0],["وخشِيتُ من قلبي الفِرارَ إليهمُ","حتى لقد طالبتُه بضمينِ",15,"ن",1,0],["وَخُشكَنانَجَةٍ سَوداءَ فارِغَةٍ","كَأَنَّها قِطعَةٌ مِن قَرنِ جاموسِ",16,"س",1,0],["وخشوع النخل في عيني","ك مسحور البيان",17,"ن",1,0],["وَخَشيتُ تَنقُلُ نَقطَ كُحلَتِهِ","عَيَنَّ مِن عَينٍ غِلى غَينِ",18,"ن",1,0],["وخشِينا فواتَ لَذَّةِ عيشٍ","قَلَّما ساعدَ الخليعَ مُوَاتَى",19,"ت",2,0],["وخِشف تحير فيه الجما","ل من قدميه إلى فَرقه",20,"ق",2,0],["وخَشيةٌ وانْكِسارٌ واتِّصالُ يدٍ","بالهاشِمِيِّ إِمامِ العُجْمِ والعَرَبِ",21,"ب",1,0],["وَخَشَبى الأَعجَمِ وَالمُخَشِّبا","وَالدَربَ ذا البُنيانِ وَالمُدَرَّبا",22,"ب",2,0],["وَخَشِيْتُ إِنْ أَنَا فِي الثِّيَابِ لَبِسْتُهُ","أَنْ يَفْطِنُوا فَلَبِسْتُهُ فِي خَاتَمِي",23,"م",2,0],["وخشعتُ يا لَخُشوعِ قَلْبي","مِن مَقامِك أَو مَقالِكْ",24,"ك",1,0],["وخَشَوْا وَلَمْ يَغْرُرْهُم","بالَّليْثِ أَنَّ اللَّيثَ خَادرْ",25,"ر",1,0],["وَخَشخاشٍ كَأَنّا مِنهُ نَفري","قَميصَ زَبَرجَدٍ عَن جِسمِ دُرِّ",26,"ر",1,1],["وخشيتمُ شممَ الأسير وكبرَه","فقتلتمُ المأسور والمسجونا",27,"ن",2,0],["وخشمه شبر ووفايه","من حيّاته ورد",28,"د",1,0],["وخشية اللَه في سر وفي علن","لم تختلف حالته جهرة وخفا",29,"ف",2,0],["وَخشيتُ يا مرمارة الأردافِ أن","يَبتزّ خصرك ردفك المرمارُ",30,"ر",1,0],["وَخُشْنَتِي بَعْدَ الشَبابِ الصَلْتِ","أَزْمانَ لا أَدْرِي وَإِنْ سَأَلْتِ",31,"ت",1,0],["وَخَشيتُ وَقعَ ضَريبَةٍ","قَد جُرِّبَت كُلَّ التَجارِب",32,"ب",1,0],["وَخشَّتُهَا الْبَيْضَاءُ نَهْدٌ بِصَدْرِهَا","لَهُ لَبَنٌ يَعْلُو بِدُرٍّ عَلَى دُرِّ",33,"ر",1,0],["وَخشوعه وَخضوعه وَرجوعه","وَدموعه بتواتر الأَحزان",34,"ن",1,0],["وخشوف على رباها تراها","حائمات ترعى من الاحجار",35,"ر",1,0],["وخشف اغن لست اسطيع وصفه","لعوب غرير كالشقائق خداه",36,"ا",2,0],["وَخَشيت مُلتَقِطا علي","كَ موكَّلاً بالملتَقَط",37,"ط",1,0],["وَخَشيتُ لَومَ الرَكبِ لَولا أَنَّني","نَهنَهتُ غَربَ الدَمعِ عَن سَيَلانِهِ",38,"ه",1,0],["وخشيت أن يلوي الذبول بورده","مما أصعده من النيران",39,"ن",1,0],["وَخَشَبُ الإفرَنجِ قَد جاؤوهَا","وَمَلَكَوهَا بعدَ أن غازوهَا",40,"ه",2,0],["وخشفية الألحاظ والجيد والحشا","ولكن لها فضل القبول على الخشف",41,"ف",1,1],["وخشوعي وخشيتي وخضوعي","وسقامي وصحتي وضنائي",42,"ي",1,0],["وخشمه سيف قطاع حده يلفظ الحب","وريقه من لذيذ العسل أحلى وأعذب",43,"ب",1,0],["وَخُشوعٍ يُشبِهُ السُق","مَ وَضَعفٍ في الدَبيبِ",44,"ب",1,0],["وخشيته لله تعلو، وبذلُه","أجل، وفيضُ العلم أعلى كامله",45,"ل",2,0],["وخشوا على ما أُنْعِلَتْهُ توقُّداً","من كلِّ نور للنواظر واقد",46,"د",1,0],["وخشيت من قلبي التقلب في الهوى","لما اكتوى فطلبته بضمين",47,"ن",1,0],["وخشرت للترحال مكْري التفاسيح","نايع إلى خضر الفلا ظل وغلال",48,"ل",1,0],["وخشمن طويل كنه السيف شامان","لا شافه العابر يدق التحيه",49,"ي",2,0],["وخشيت تنقل نقط كحلته","عيني من عينٍ إلى غين",50,"ن",1,0],["وخشية مع رهبةٍ وكرغبةٍ","إليه تعالى والإنابة والقصد",51,"د",1,0],["وخشية قصفٍ بصوتٍ يدوِّي","طمرنا الرؤس جميع الحرام",52,"م",1,0],["وخشيةَ أن تعيشَ فماً طريداً","ك\" آدمَ\" حين أغواهُ الرَجْيمُ",53,"م",1,0],["وخشمه من ورى البرقع شبيه الخنجر المذروب","ونهد ٍرافع ٍالثوب له يادوب زامي به",54,"ب",2,0],["وخشيتُ إنْ أنا في الشَّبابِ لبستُهُ","أنْ يفطنوا فجعلتُهُ في خَاتَمي",55,"م",2,0]]}