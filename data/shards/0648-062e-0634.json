{"poems":[[72,"ملوز الطرف أهلا","https://www.aldiwan.net/poem20548.html","المجتث"],[51,"كم جارع جرع المكاره عالما","https://www.aldiwan.net/poem66087.html","الكامل"],[91,"سمعت عويل النائحات عشية","https://www.aldiwan.net/poem8833.html","عموديه"],[91,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[43,"جللا كما بي فليك التبريح","https://www.aldiwan.net/poem9522.html","الكامل"],[107,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[50,"يا عبد باهلة الذي يتوعد","https://www.aldiwan.net/poem63931.html","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16655","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[90,"معرض العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179147",""],[94,"على أطلال الجزيرة العربية","https://www.poetsgate.com/ViewPoem.aspx?id=15663",""],[115,"لم تذكري الذكرى فاطيب عيشة","https://www.aldiwan.net/poem40411.html","عموديه"],[132,"تركت الشاه خشية أن أكونا","https://www.aldiwan.net/poem54723.html","الوافر"],[142,"أكذا يجازى ود كل قرين","https://www.aldiwan.net/poem58441.html","الكامل"],[235,"وباخل بت في أرجاء منزله","https://www.aldiwan.net/poem31913.html","البسيط"],[328,"هات قيثارك يا شاعر","https://www.aldiwan.net/poem55055.html","مجزوء الرمل"],[366,"رجل توكل لي وكحلني","https://www.aldiwan.net/poem17673.html","أحذ الكامل"],[432,"قد عصينا النهى فكيف النهاتا","https://www.aldiwan.net/poem12429.html","الخفيف"],[495,"لئن صوت الرعد في أفقه","https://www.aldiwan.net/poem10250.html","المتقارب"],[500,"تحل بالصدق واذكر خاشعا وأمط","https://www.aldiwan.net/poem38067.html","البسيط"],[561,"لقد وجدتم مصعبا مستصعبا","https://www.aldiwan.net/poem27829.html","الرجز"],[567,"جعلت تأمل زرقة في خاتمي","https://www.aldiwan.net/poem69510.html","الكامل"],[575,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[575,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"]],"verses":[["وخشكناناً أتاني","في مثل عيديَ فتلا",0,"ل",2,0],["وخَشيتُ ربي أن أسُمَّ مُوَحِّداً","ظُلْماً فأكْتَسِبَ العذاب الدائما",1,"م",2,0],["وَخَشيتُ أَن يَغدو مَعَ الرَيبِ الهَوى","كَالرَسمِ لا عِطر وَفيهِ زُهورُ",2,"ر",1,0],["وَخَشيتُ أَنَّ الوَجدَ يَسلِبُني","حِلمي وَيَغلِبُني عَلى أَمري",3,"ي",1,0],["وَخَشيتُ مِنكَ عَلى البِلادِ وَأَهلِها","ما كانَ أَنذَرَ قَومَ نوحٍ نوحُ",4,"ح",1,0],["وَخَشْيَةً أَنْ يَذُوبَ النَّهْرُ فِي نَهَرٍ","وَأَنْ يَجُورَ زَمَانٌ قَلَّمَا قَصَدَا",5,"د",2,0],["وخشوعٌ يعلوه منك وقارٌ","مُعْرِبٌ عن رَجَاحةٍ من شَمامِ",6,"م",1,0],["وَخَشيتَ سَطوَةَ عامِرِيٍّ فاتِكٍ","تَقِفُ الوُفودُ بِبابِهِ وَالوُفَّدُ",7,"د",1,0],["وخَشِيتُ بَعْدَ رَجاءِ أَسْورَةٍ","يوْمَ القِيامَةِ حَمْل أغلال",8,"ل",1,0],["وخُشوعٌ من الْجَلالِ تَراءَى","وجَلالٌ من الخشوعِ تَبَدَّى",9,"د",2,0],["وخِشيتُها مكبوتةً لتحفُّزٍ","كالليثِ أرهَبُ ما يُري أن يربِضا",10,"ض",2,0],["وخشعت للنشء الجديد وقلت ذا","جند الشام فمن يطيق جلادها",11,"د",3,0],["وخشيف روض في فجاج بطاحكم","ما زال في شطحات قلبي راعيا",12,"ي",2,0],["وخشيف حاجر للظلال مسامت","يمضي ويأتي خادعا ومداجيا",12,"ي",2,0],["وخَشيَةَ أن أكُونَ كَمِثلِ شِيبٍ","إِذَا قِيمَ الأتَاىُ يُسحرِّوُنَا",13,"ن",2,0],["وخَشيَةَ أن أكُونَ نَدِيمَ آمٍ","أُنَادِ مُهُنَّ أبكَاراً وعُونَا",13,"ن",2,0],["وخَشيَةَ أن أُجَالِسَ كُلَّ نَذلٍ","يَجُرَّ ِإلَىَّ مَنقَصَةً وهُونَا",13,"ن",2,0],["وخَشيَةَ أن أكُونَ أخَادُيُونٍ","ولَم أرَ مَا بِه أقضِى الدُّيونَا",13,"ن",2,0],["وخَشيَةَ أن يَكُونَ بَيَاضُ وَجهِى","سَوَاداً لاَ تُغَيِّرُهُ السِّنُونَا",13,"ن",2,0],["وخشِيتُ من قلبي الفِرارَ إليهمُ","حتى لقد طالبتُه بضمينِ",14,"ن",1,0],["وَخُشكَنانَجَةٍ سَوداءَ فارِغَةٍ","كَأَنَّها قِطعَةٌ مِن قَرنِ جاموسِ",15,"س",1,0],["وخشوع النخل في عيني","ك مسحور البيان",16,"ن",1,0],["وَخَشيتُ تَنقُلُ نَقطَ كُحلَتِهِ","عَيَنَّ مِن عَينٍ غِلى غَينِ",17,"ن",1,0],["وخشِينا فواتَ لَذَّةِ عيشٍ","قَلَّما ساعدَ الخليعَ مُوَاتَى",18,"ت",2,0],["وخِشف تحير فيه الجما","ل من قدميه إلى فَرقه",19,"ق",2,0],["وخَشيةٌ وانْكِسارٌ واتِّصالُ يدٍ","بالهاشِمِيِّ إِمامِ العُجْمِ والعَرَبِ",20,"ب",1,0],["وَخَشَبى الأَعجَمِ وَالمُخَشِّبا","وَالدَربَ ذا البُنيانِ وَالمُدَرَّبا",21,"ب",2,0],["وَخَشِيْتُ إِنْ أَنَا فِي الثِّيَابِ لَبِسْتُهُ","أَنْ يَفْطِنُوا فَلَبِسْتُهُ فِي خَاتَمِي",22,"م",2,0],["وخشعتُ يا لَخُشوعِ قَلْبي","مِن مَقامِك أَو مَقالِكْ",23,"ك",1,0],["وخَشَوْا وَلَمْ يَغْرُرْهُم","بالَّليْثِ أَنَّ اللَّيثَ خَادرْ",24,"ر",1,0]]}