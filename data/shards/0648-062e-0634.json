{"poems":[[74,"ملوز الطرف أهلا","https://www.aldiwan.net/poem20548.html","المجتث"],[53,"كم جارع جرع المكاره عالما","https://www.aldiwan.net/poem66087.html","الكامل"],[93,"سمعت عويل النائحات عشية","https://www.aldiwan.net/poem8833.html","عموديه"],[93,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[45,"جللا كما بي فليك التبريح","https://www.aldiwan.net/poem9522.html","الكامل"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[82,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[52,"يا عبد باهلة الذي يتوعد","https://www.aldiwan.net/poem63931.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62240","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16655","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[92,"معرض العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179147",""],[96,"على أطلال الجزيرة العربية","https://www.poetsgate.com/ViewPoem.aspx?id=15663",""],[118,"لم تذكري الذكرى فاطيب عيشة","https://www.aldiwan.net/poem40411.html","عموديه"],[135,"تركت الشاه خشية أن أكونا","https://www.aldiwan.net/poem54723.html","الوافر"],[145,"أكذا يجازى ود كل قرين","https://www.aldiwan.net/poem58441.html","الكامل"],[238,"وباخل بت في أرجاء منزله","https://www.aldiwan.net/poem31913.html","البسيط"],[331,"هات قيثارك يا شاعر","https://www.aldiwan.net/poem55055.html","مجزوء الرمل"],[369,"رجل توكل لي وكحلني","https://www.aldiwan.net/poem17673.html","أحذ الكامل"],[435,"قد عصينا النهى فكيف النهاتا","https://www.aldiwan.net/poem12429.html","الخفيف"],[497,"لئن صوت الرعد في أفقه","https://www.aldiwan.net/poem10250.html","المتقارب"],[502,"تحل بالصدق واذكر خاشعا وأمط","https://www.aldiwan.net/poem38067.html","البسيط"],[563,"لقد وجدتم مصعبا مستصعبا","https://www.aldiwan.net/poem27829.html","الرجز"],[569,"جعلت تأمل زرقة في خاتمي","https://www.aldiwan.net/poem69510.html","الكامل"],[577,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[577,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/31473","الكامل"]],"verses":[["وخشكناناً أتاني","في مثل عيديَ فتلا",0,"ل",2,0],["وخَشيتُ ربي أن أسُمَّ مُوَحِّداً","ظُلْماً فأكْتَسِبَ العذاب الدائما",1,"م",2,0],["وَخَشيتُ أَن يَغدو مَعَ الرَيبِ الهَوى","كَالرَسمِ لا عِطر وَفيهِ زُهورُ",2,"ر",1,0],["وَخَشيتُ أَنَّ الوَجدَ يَسلِبُني","حِلمي وَيَغلِبُني عَلى أَمري",3,"ر",2,0],["وَخَشيتُ مِنكَ عَلى البِلادِ وَأَهلِها","ما كانَ أَنذَرَ قَومَ نوحٍ نوحُ",4,"ح",1,0],["وَخَشْيَةً أَنْ يَذُوبَ النَّهْرُ فِي نَهَرٍ","وَأَنْ يَجُورَ زَمَانٌ قَلَّمَا قَصَدَا",5,"د",2,0],["وخشوعٌ يعلوه منك وقارٌ","مُعْرِبٌ عن رَجَاحةٍ من شَمامِ",6,"م",1,0],["وَخَشيتَ سَطوَةَ عامِرِيٍّ فاتِكٍ","تَقِفُ الوُفودُ بِبابِهِ وَالوُفَّدُ",7,"د",1,0],["وخَشْخَشْتُ بِالعَنْسِ في قَفْرَةٍ","مَقِيلَ ظِبَاءِ الصَّريمِ الحُزُنْ",8,"ن",1,0],["وخَشِيتُ بَعْدَ رَجاءِ أَسْورَةٍ","يوْمَ القِيامَةِ حَمْل أغلال",9,"ل",1,0],["وخُشوعٌ من الْجَلالِ تَراءَى","وجَلالٌ من الخشوعِ تَبَدَّى",10,"د",2,0],["وخِشيتُها مكبوتةً لتحفُّزٍ","كالليثِ أرهَبُ ما يُري أن يربِضا",11,"ض",2,0],["وخشعت للنشء الجديد وقلت ذا","جند الشام فمن يطيق جلادها",12,"د",3,0],["وخشيف روض في فجاج بطاحكم","ما زال في شطحات قلبي راعيا",13,"ي",2,0],["وخشيف حاجر للظلال مسامت","يمضي ويأتي خادعا ومداجيا",13,"ي",2,0],["وخَشيَةَ أن أكُونَ كَمِثلِ شِيبٍ","إِذَا قِيمَ الأتَاىُ يُسحرِّوُنَا",14,"ن",2,0],["وخَشيَةَ أن أكُونَ نَدِيمَ آمٍ","أُنَادِ مُهُنَّ أبكَاراً وعُونَا",14,"ن",2,0],["وخَشيَةَ أن أُجَالِسَ كُلَّ نَذلٍ","يَجُرَّ ِإلَىَّ مَنقَصَةً وهُونَا",14,"ن",2,0],["وخَشيَةَ أن أكُونَ أخَادُيُونٍ","ولَم أرَ مَا بِه أقضِى الدُّيونَا",14,"ن",2,0],["وخَشيَةَ أن يَكُونَ بَيَاضُ وَجهِى","سَوَاداً لاَ تُغَيِّرُهُ السِّنُونَا",14,"ن",2,0],["وخشِيتُ من قلبي الفِرارَ إليهمُ","حتى لقد طالبتُه بضمينِ",15,"ن",1,0],["وَخُشكَنانَجَةٍ سَوداءَ فارِغَةٍ","كَأَنَّها قِطعَةٌ مِن قَرنِ جاموسِ",16,"س",1,0],["وخشوع النخل في عيني","ك مسحور البيان",17,"ن",1,0],["وَخَشيتُ تَنقُلُ نَقطَ كُحلَتِهِ","عَيَنَّ مِن عَينٍ غِلى غَينِ",18,"ن",1,0],["وخشِينا فواتَ لَذَّةِ عيشٍ","قَلَّما ساعدَ الخليعَ مُوَاتَى",19,"ت",2,0],["وخِشف تحير فيه الجما","ل من قدميه إلى فَرقه",20,"ق",2,0],["وخَشيةٌ وانْكِسارٌ واتِّصالُ يدٍ","بالهاشِمِيِّ إِمامِ العُجْمِ والعَرَبِ",21,"ب",1,0],["وَخَشَبى الأَعجَمِ وَالمُخَشِّبا","وَالدَربَ ذا البُنيانِ وَالمُدَرَّبا",22,"ب",2,0],["وَخَشِيْتُ إِنْ أَنَا فِي الثِّيَابِ لَبِسْتُهُ","أَنْ يَفْطِنُوا فَلَبِسْتُهُ فِي خَاتَمِي",23,"م",2,0],["وخشعتُ يا لَخُشوعِ قَلْبي","مِن مَقامِك أَو مَقالِكْ",24,"ك",1,0],["وخَشَوْا وَلَمْ يَغْرُرْهُم","بالَّليْثِ أَنَّ اللَّيثَ خَادرْ",25,"ر",1,0],["وَخَشيتُ وَقعَ ضَريبَةٍ","قَد جُرِّبَت كُلَّ التَجارِب",26,"ب",1,0]]}