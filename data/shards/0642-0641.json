دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[77,"الختْمُ يُحْفظُ مضمونُ الكتابِ بِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=33372",""],[77,"قفا فاسألا في ساحة الأجدع الفرد","https://www.poetsgate.com/ViewPoem.aspx?id=33812",""],[77,"دعاها تشم آثار نجد ففي نجد","https://www.poetsgate.com/ViewPoem.aspx?id=33821",""],[103,"قف في ربوع المجد وابك الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=1337",""],[23,"بطيبة رسم للرسول","https://www.poetsgate.com/ViewPoem.aspx?id=11422",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[5,"معلقة عمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=11411",""],[80,"لو أنّ ربعَ شبابي غيرُ مندرسِ","https://www.poetsgate.com/ViewPoem.aspx?id=3326",""],[91,"1916","https://www.poetsgate.com/ViewPoem.aspx?id=53214",""],[95,"طلل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=240&r=&rc=3",""],[31,"مَنْ لِقَلْبٍ غَيْرِ صَاحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18814&r=&rc=77",""],[20,"أرِقت لمكفهِر بات فيه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69759&r=&rc=0",""],[53,"أيَا لِلَّهِ! أيُّ هَوًى أضَاءَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9805&r=&rc=2",""],[3,"قف بالمنازل ان شجتك ربوعها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10711&r=&rc=65",""],[96,"إلى البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66354&r=&rc=30",""]],"verses":[["قِفا صاحِبَيَّ اليَومَ أَسأَلُ ساعَةُ","وَلا تُرجِعا سَمعِ بِغَيرِ بَيانِ",0,"ن",1,0],["قِفي أُخبِركِ عَن صَبري","إِذا أَوعَدتِني البَينا",1,"ن",2,0],["قِف مَوقِفَ الشَكِّ لا يَأسٌ وَلا طَمَعُ","وَغالِطِ العَيشَ لا صَبرٌ وَلا جَزَعُ",2,"ع",1,1],["قِف بي وَلَو لَوثَ الإِزارَ فَإِنَّما","هِيَ مُهجَةٌ عَلِقَ الجَوى بِفُؤادِها",3,"د",3,0],["قِف طالِعاً أَيُّها الساعي لِيُدرِكَني","فَبَعدَكَ الجَزَعُ المَغرورُ قَد قَرَحا",4,"ح",2,0],["قِفوا فَاِمطِروا كُلَّ عَينٍ دَماً","بِها وَاِملَاؤوا كُلَّ قَلبٍ وَجيبا",5,"ب",2,0],["قِفارٌ لا تُهاجُ الطَيرُ فيها","وَلا غادٍ يَروعُ بِها الظِباءَ",6,"ا",2,0],["قِفا بنجدٍ نسلِّمْ","على ديارِ سعادِ",7,"د",1,1],["قِفي وَاِنظُري يا عَبلَ فِعلي وَعايِني","طِعاني إِذا ثارَ العَجاجُ المُكَدَّرُ",8,"ر",1,0],["قِف بِالمَنازِلِ إِن شَجَتكَ رُبوعُه","فَلَعَلَّ عَينَكَ تَستَهِلُّ دُموعُها",9,"ع",3,1],["قِفا يا خَليلَيَّ الغَداةَ وَسَلِّم","وَعوجا فَإِن لَم تَفعَلا اليَومَ تَندَما",10,"م",2,1],["قِف بِالدِيارِ وَصِح إِلى بَيداه","فَعَسى الدِيارُ تُجيبُ مَن ناداها",11,"ا",3,1],["قِفا فاسْأَلا في ساحَةِ الأجْرَعِ الفَرْدِ","مَعالِمَ محّتْها الغَمائِمُ منْ بَعْدي",12,"د",2,1],["قِفوا نتَشَكّى ما نُلاقي منَ الهَوى","ونُنْحي على يوْمِ الرّحيلِ ونسْتَعْدي",13,"د",2,0],["قِفْ بالبَقيعِ ونادِ في عَرَصاتِه","فلَكَمْ بِها منْ جِيرَةٍ وَلِداتِ",14,"ت",1,0],["قُفْلٌ منَ الشّمْعِ يَثْني العَيْنَ هَيبَتُهُ","فَضلاً عنِ اليَدِ أنْ تَدْنُو لحَوْزَتِهِ",15,"ه",1,0],["قِفوا يا أَيُّها العُلَماءُ وَاِبكوا","وَرَوّوا لَحدَهُ قَبلَ الحِسابِ",16,"ب",1,0],["قِفوا وَاِقرَؤوا أُمَّ الكِتابِ وَسَلِّموا","عَلَيهِ فَهَذا القَبرُ قَبرُ الكَواكِبي",17,"ي",1,0],["قِف يا خَطيبَ الشَرقِ جَدِّد عَهدَنا","قَبلَ الرَحيلِ لِيُقطَعَ التَأويلُ",18,"ل",1,0],["قَفَلٌ وَإِبلالٌ عَقيبَ مُطيفَةٍ","غَشِيَت كَما غَشِيَ السَبيلَ العابِرُ",19,"ر",1,0],["قِفي قَبلَ التَفَرُّقِ يا ظَعين","نُخَبِّركِ اليَقينا وَتُخبِرينا",20,"ن",2,0],["قِفي نَسأَلكِ هَل أَحدَثتِ صَرم","لِوَشكِ البَينِ أَم خُنتِ الأَمينا",20,"ن",2,0],["قِفا نَبكِ مِن ذِكرى حَبيبٍ وَمَنزِلِ","بِسِقطِ اللِوى بَينَ الدَخولِ فَحَومَلِ",21,"ل",1,1],["قِفا نَبكِ مِن ذِكرى حَبيبٍ وَعِرفانِ","وَرَسمٍ عَفَت آياتُهُ مُنذُ أَزمانِ",22,"ن",1,1],["قَفراً وَقَفتُ بِها فَقُلتُ لِصاحِبي","وَالعَينُ يَسبُقُ طَرفَها إِسبالُها",23,"ل",3,0],["قِفْ خَاشِعاً بِضَرِيحِ عِزِّ الدِّينِ","وَاقْرَأْ سَلامَ أخٍ عَلَيْهِ حَزِينِ",24,"ن",1,1],["قِفا نَسأَلِ الدارَ الَّتي خَفَّ أَهلُها","مَتى عَهدُها بِالصَومِ وَالصَلَواتِ",25,"ت",1,0],["قِفِ العيسَ في أَطلالِ مَيَّةَ فَاِسأَلِ","رُسوماً كَأَخلاقِ الرِداءِ المُسَلسَلِ",26,"ل",1,1],["قَفِ العيسَ نَنظُر نَظرَةً في ديارِها","فَهَل ذاكَ مِن داءِ الصَبابَةِ نافِعُ",27,"ع",1,0],["قِفارٌ مَحولٌ ما بِها مُتَعَلَّلٌ","سِوى جِرَّةٍ مِن رَجعِ فَرثٍ تُفيضُها",28,"ض",3,0],["قِفا نُحَيّي العَرَصاتِ الهُمَّدا","وَالنُؤيَ وَالرَميمَ وَالمُستَوقِدا",29,"د",2,1],["قَفراً كَأَنَّ أَراعيلَ النَعام بِها","قَبائِلُ الزِنجِ وَالحُبشانُ وَالنوبُ",30,"ب",1,0],["قف بالسّبيكة وانظر ما بساحتها","عقيلة والكثيب الفرد جاليها",31,"ي",3,0],["قف بالديار فقد أناخ بها البلى","وانظر فقد قرعت بهنّ السوح",32,"ح",1,0],["قفا نحتقر دمع العيون تجلّةً","لمن فيه من ذاك الجليل الموقّر",33,"ر",1,0],["قُفّاز كفّ به فصوص","من حجر الماس ذي الصفاء",34,"ا",2,0],["قِفا فَاِسمَعا صَوتَ المُنادي لَعَلَّهُ","قَريبٌ وَما دانَيتُ بِالوُدِّ دانِيا",35,"ي",2,0],["قَفراً تَقادَمَ عَهدَهُنَّ عَلى البِلى","فَلَبِثنَ في عَدَدِ الشُهورِ سِنينا",36,"ن",2,0],["قُفَيرَةُ مِن قِنٍّ لِسَلمى اِبنِ جَندَلٍ","أَبوكَ اِبنُها بَينَ الإِماءِ الخَوادِمِ",37,"م",1,0],["قُفَيرَةُ مِن قِنٍّ لِسَلمى بنِ جَندَلٍ","أَبوكَ اِبنُها وَاِبنُ الإِماءِ الخَوادِمِ",38,"م",1,0],["قَفراً تَشابَهُ آجالُ النَعامِ بِها","عيداً تَلاقَت بِهِ قُرّانُ وَالنوبُ",39,"ب",1,0],["قُفَيرَةُ حِزبٌ لِلنَصارى وَجِعثِنٌ","وَأَمسى الكِرامُ الغالِبونَ وَهُم حِزبي",40,"ب",2,0],["قِفا فَاِستَخيرا اللَهَ أَن تُشحَطَ النَوى","غَداةَ جَرى ظَبيٌ بِحَومَلَ بارِحُ",41,"ح",1,0],["قَفرَ الجَبا لا تَرى إِلّا الحَمامَ بِهِ","مِنَ الأَنيسِ خَلاءً غَيرَ مَحضورِ",42,"ر",1,0],["قِفا نَعرِفِ الرَبعَينِ بَينَ مُلَيحَةٍ","وَبُرقَةِ سُلمانينَ ذاتِ الأَجارِعِ",43,"ع",1,0],["قِفا عُوِجا عَلى دِمَنٍ بِرَهبى","فَحَيّوا رَسمَهُنَّ وَإِن أَحالا",44,"ل",2,0],["قِفوا فَاِسأَلوا الأَقوامَ مَن يُنهِلُ القَنا","وَمَن يَكشِفُ البَلوى وَمَن يَمنَعُ الأَصلا",45,"ل",2,0],["قُفَيرَةُ ساءَ ما كَسَبَت بَنيها","وَليلى القَينِ قينِ بَني عِقالِ",46,"ل",1,0],["قُفَيرَةُ وَهيَ أَلأَمُ أُمُّ قَومٍ","تَوَفّى في الفَرَزدَقِ سَبعَ آمِ",47,"م",1,0],["قِفا يا صاحِبَيَّ