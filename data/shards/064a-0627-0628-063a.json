{"poems":[[79,"كن من صروف الردى على حذر","https://www.aldiwan.net/poem36441.html","المنسرح"],[50,"قد رفعنا البزاق مذ شهرين","https://www.aldiwan.net/poem66156.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43778","المنسرح"],[173,"خلياني من وطاء ووساد","https://www.aldiwan.net/poem1619.html",""],[261,"ولقد عهدتك تشتهي","https://www.aldiwan.net/poem48568.html","مجزوء الكامل"],[280,"أتهم بي في الهوى وأنجد","https://www.aldiwan.net/poem25576.html","مخلع البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87037","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87001","البسيط"],[840,"","https://poetry.dctabudhabi.ae/diwan/poem/143232","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59787","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80008","الخفيف"],[1638,"","https://poetry.dctabudhabi.ae/diwan/poem/205528","الكامل"],[2598,"","https://poetry.dctabudhabi.ae/diwan/poem/17393","الكامل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78201","البسيط"],[4099,"","https://poetry.dctabudhabi.ae/diwan/poem/73545","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73088","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133193","الكامل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67496","الرمل"],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5314,"خلجات","https://www.poetsgate.com/ViewPoem.aspx?id=214746",""]],"verses":[["يا بغْلَ طاحونَةٍ يَدورُ بِها","مُجْتهِدَ السّيْرِ مغْمَضَ البَصَرِ",0,"ر",1,0],["يا بُغاةَ الخِصيانِ لا تَحذَروهُ","وَاِعفِصوهُم بَقِيَّةَ العَصرَينِ",1,"ن",1,0],["يا بغيَةَ المَجدِ يا","قَد فاتَهُ مِنكَ ما رَجا وَبَغى",2,"غ",2,0],["يا بُغاثَ الطَير طيري وَاِنظُري","هَرَبَ البازِيِّ مِن كَلبِ الجَرادِ",3,"د",1,0],["يا بغض تدخين الجشا","في الصوم من تخم السحور",4,"ر",1,0],["يَا بُغْيَةَ المُدْنِفِ المُعَنَّى","وغَفْوَةَ النّاظِرِ المُسَهَّد",5,"د",1,0],["يا بغيتي ما لي سِواك فَكيفَما","أَلقى الإِهانة في هَواك وَأَنتَ لي",6,"ل",2,0],["يا بُغيةَ الملكِ للأَوطان آمالُ","نجازُها تَقتضيه مِنكَ أَحوالُ",7,"ل",1,1],["يا بغيضاً على اختلاف الليالي","يا دعياً على اتفاق البرايا",8,"ا",3,0],["يا بغيةَ الصبّ والهجرانُ أتلفهُ","رُحْماكِ رُحماكِ في قلبي وفي كبدي",9,"د",2,0],["يا بغاة الإِسلام لا تتناجوا","بانتقاص الدين الحنيف سرارا",10,"ر",2,0],["يا بغية الآمال قد ألبستني","ثوب السقام به ووجدي المتلف",11,"ف",1,0],["يا بَغلُ بَغلَ أَبي مَضاءَ تَعَلَّمَن","أَنّي حَلَفتُ وَلِليَمينِ نُذورُ",12,"ر",1,1],["يا بِغيَة الصَب رِفقا بِالفُؤاد فَقَد","أَشجاه ما بِكَ مِن تيه وَمِن مَيل",13,"ل",1,1],["يا بُغيَةً لَيسَ لي سِواها","يا أَمَلَ النَّفسِ يا هَواها",14,"ا",3,1],["يا بُغاةَ الندى إلى كَم تَحثو","نَ الَمطايا فَتَفطعونَ الرُمالا",15,"ل",2,0],["يا بغيتي يا راحتي يا حجتي","يا عمدتي يا قبلتي لدعائي",16,"ي",1,0],["يا بغيضاً زاد في البغ","ض على كل بغيضِ",17,"ض",1,1],["يا بغيتي أكرم بها في روضها","من حضرة القدس غذاؤها الوفا",18,"ا",1,0],["يا بغية الروح يارتقي وياحلمي","ويا مناي وياوجدي وأشواقي",19,"ق",2,0]]}