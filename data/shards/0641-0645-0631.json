{"poems":[[53,"أقول لها بين الغديرين والنقا","https://www.aldiwan.net/poem29961.html","الطويل"],[53,"إباء أقام الدهر عني وأقعدا","https://www.aldiwan.net/poem30634.html","الطويل"],[53,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[63,"خاض الدجى ورواق الليل مسدولب","https://www.aldiwan.net/poem46219.html","البسيط"],[77,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[9,"ألا قل لتيا قبل مرتها اسلمي","https://www.aldiwan.net/poem21979.html","الطويل"],[24,"وهاجرة لا تستريد ظباؤها","https://www.aldiwan.net/poem21882.html","الطويل"],[24,"أمن دمنة الدار أقوت سنينا","https://www.aldiwan.net/poem21884.html","المتقارب"],[86,"حياكم الله أحيوا العلم والأدبا","https://www.aldiwan.net/poem10917.html","البسيط"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[86,"شجتنا مطالع أقمارها","https://www.aldiwan.net/poem68866.html","المتقارب"],[71,"وشادن أبصرته قائماً","https://www.aldiwan.net/poem3875.html","السريع"],[35,"أهاجك بالعبوقرة الديار","https://www.aldiwan.net/poem39149.html","الوافر"],[35,"تظل ابنة الضمري في ظل نعمة","https://www.aldiwan.net/poem39160.html","الطويل"],[54,"الحمد لله لا صبر ولا جلد","https://www.aldiwan.net/poem27608.html","البسيط"],[30,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[72,"شجون نحوها العشاق فاؤا","https://www.aldiwan.net/poem18162.html","الوافر"],[26,"أصبح من أم عمرو بطن مر فأج","https://www.aldiwan.net/poem24101.html","البسيط"],[38,"ألم تسأل بعارمة الديارا","https://www.aldiwan.net/poem7721.html","الوافر"],[32,"ليت شعري أجفوة أم دلال","https://www.aldiwan.net/poem27748.html","الخفيف"],[85,"أهلا وسهلا بحاميها وفاديها","https://www.aldiwan.net/poem7586.html","البسيط"],[85,"يا حبذا أمينة وكلبها","https://www.aldiwan.net/poem8066.html","الرجز"],[85,"يا راكب الريح حي النيل والهرما","https://www.aldiwan.net/poem63746.html","البسيط"],[43,"ألا كل ماشية الخيزلى","https://www.aldiwan.net/poem9448.html","المتقارب"],[43,"ضروب الناس عشاق ضروبا","https://www.aldiwan.net/poem9501.html","الوافر"],[43,"أفاضل الناس أغراض لذا الزمن","https://www.aldiwan.net/poem10587.html","البسيط"],[45,"كنت إلى وصل سعدى جد محتاج","https://www.aldiwan.net/poem62673.html","البسيط"],[45,"أهلك والليل أيها الرجل","https://www.aldiwan.net/poem65644.html","المنسرح"],[28,"نابي الفراش طري اللحم مطعمه","https://www.aldiwan.net/poem5497.html","البسيط"],[28,"أتاني بها والليل نصفان قد مضى","https://www.aldiwan.net/poem5518.html","الطويل"],[61,"لقد سودت عرس ابن حمزة وجهه","https://www.aldiwan.net/poem51480.html","الطويل"],[61,"وشاحب اللبسة والأعضاء","https://www.aldiwan.net/poem51835.html","الرجز"],[66,"لدوا للموت وابنوا للخراب","https://www.aldiwan.net/poem40118.html","الوافر"],[97,"إيه إنعام والمحاسن كثر","https://www.aldiwan.net/poem24342.html","الخفيف"],[44,"لعلك ذاكر الطلل القديم","https://www.aldiwan.net/poem29686.html","الوافر"],[44,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[44,"أظن دموعها سنن الفريد","https://www.aldiwan.net/poem30546.html","الوافر"],[44,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[31,"خطرت لذات الخال ذكرى بعدما","https://www.aldiwan.net/poem42633.html","الكامل"],[33,"شكوت إلى رفيقي الذي بي","https://www.aldiwan.net/poem25726.html","الوافر"],[48,"ودار يؤدب فيها البزاة","https://www.aldiwan.net/poem62610.html","المتقارب"],[48,"بنت العلاء أتتنا وهي حافية","https://www.aldiwan.net/poem66246.html","البسيط"],[48,"أصبح أيري معرضا عني","https://www.aldiwan.net/poem66284.html","السريع"],[46,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85649","الطويل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/55693","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42732","الطويل"],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[99,"الى ضفيرتي ماس","https://www.poetsgate.com/ViewPoem.aspx?id=36371",""]],"verses":[["فَمَرَّت تَظُنُّ النِسعَ صَوتاً أُجيلُهُ","فَلا عُذرَ إِلّا تَتَّقي بِالعَجارِفِ",0,"ف",1,0],["فَمُرني بِأَمرٍ قَبلَ مَوتي فَإِنَّني","أَرى المَرءَ لا يَبقى وَإِن بَعُدَ المَدى",1,"د",2,0],["فَمَرَّ كَما مَرَّت ذَوائِبُ عُشوَةٍ","تُقادُ بِأَطرافِ الرِماحِ وَتُجنَبُ",2,"ب",1,0],["فَمُرْ وقُلْ أَتَّبِعْ ما أنتَ تَنهَجُهُ","فالأمرُ مُمتَثَلٌ والقولُ مَقبولُ",3,"ل",1,0],["فَمُرَنَّحُ الْعِطْفَيْنِ لاَ مِنْ نَشْوَةٍ","وَمُوَرَّدُ الْخَدَّيْنِ غَيْرُ مَرِيبِ",4,"ب",1,0],["فَمَرَّ نَضيءُ السَهمِ تَحتَ لَبانِهِ","وَجالَ عَلى وَحشِيِّهِ لَم يُثَمثِمِ",5,"م",1,0],["فَمَرَّ عَلى مُلسِ النَواشِر قَلَّما","تُثَبِّطُهُنَّ بِالخَبارِ الجِراثِمُ",6,"م",1,0],["فَمَرّ عَلى نَحرِهِ وَالذِراعِ","وَلَم يَكُ ذاكَ لَهُ الفِعلُ دينا",7,"ن",2,0],["فَمَرَّ يَوماً بِهِ وَالجوعُ يَنهَبُهُ","نَهباً فَلَم يُبقِ إِلّا الجِلدَ وَالعَصَبا",8,"ب",2,0],["فمُرْ سَرِيَّ المَعاني أنْ يُواتيَني","فيها فإنِّي ضَعيفُ الحالِ واهيها",9,"ي",3,0],["فَمَرَّت بِأَرواحِنا هِزَّةٌ","هِيَ الكَهرَباءُ بِتَيّارِها",10,"ر",3,0],["فَمَرَّ في لُعبَتِهِ لاهِياً","وَقالَ حَرفانِ مِنَ المُعجَمِ",11,"م",1,0],["فَمَرخُ مُخَلِّصٍ فَمَحَنَّباتٌ","عَفَتها الرِيحُ بَعدَكِ وَالقِطارُ",12,"ر",1,0],["فَمَرَّت بِليلٍ وَهيَ شَدفاءُ عاصِف","بِمُنخَرَقِ الدَوداءِ مَرَّ الخَفَيدَدِ",13,"د",1,0],["فَمَرَّ هَذا وَمَرَّ الشُؤمُ يَتبَعُهُ","وَقامَ هَذا فَقامَ الشُؤمُ وَالنَكَدُ",14,"د",1,0],["فَمَرَّ عَلى القُصوى النَضِيُّ فَصَدَّهُ","تَلِيَّةُ وَقتٍ لَم يُكَمَّل كَمالُها",15,"ل",3,0],["فمرسلة لها سحبُ العوافي","يعفى الداءُ بادره الدواء",16,"ا",2,0],["فَمَرَّ بِالطَيرِ مِنهُ فاعِمٌ كَدِرٌ","فيهِ الظِباءُ وَفيهِ العُصمُ أَجناحُ",17,"ح",1,0],["فَمَرَّ عَلى مَنازِلِها فَأَلقى","بِها الأَثقالَ وَاِنتَحَرَ اِنتِحارا",18,"ر",2,0],["فَمُريني أُطِعكِ في كُلِّ أَمرٍ","أَنتِ وَاللَهِ أَوجَهُ الناسِ عِندي",19,"ي",1,0],["فمر بانكلترا تزجى فيالقها","وبالأساطيل تدوى في موانيها",20,"ي",3,0],["فَمُرهُموا يَأتوا بِخُبزٍ وَلَبَن","وَيُحضِروا آنِيَةً ذاتَ ثَمَن",21,"ن",1,0],["فَمَرحَباً بِكُما مِن طالِعينَ بِهِ","عَلى سِوى الطائِرِ المَيمونِ ما قَدِما",22,"م",2,0],["فَمَرَّت بِنَخلٍ وَفي رَكبِها","عَنِ العالَمينَ وَعَنهُ غِنى",23,"ا",1,0],["فَمَرَّت غَيرَ نافِرَةٍ عَلَيهِم","تَدوسُ بِنا الجَماجِمَ وَالتَريبا",24,"ب",2,0],["فَمُر وَأَومٍ تُطَع قُدِّستَ مِن جَبَلٍ","تَبارَكَ اللَهُ مُجري الروحِ في حَضَنِ",25,"ن",1,0],["فَمَرَّ يَهوي هَوِيَّ الريحِ يُسعِدُهُ","خَرقٌ بَسيطٌ وَلَيلٌ مُظلِمٌ داجِ",26,"ج",1,0],["فَمَرَّةً بِاللُجَينِ تَنعَلُها","وَمَرَّةً بِالدِماءِ تَنتَعِلُ",27,"ل",1,0],["فَمَرَّ مِن تَحتِ أَلحَيها وَكانَ لَها","واقٍ إِلى قَدَرٍ لا بُدَّ مَحمومِ",28,"م",1,0],["فَمَرَّت عَلى أَهلِ الحُفَيرِ كَأَنَّها","ظَليمٌ تَبارى جُنحَ لَيلٍ نَعائِمُه",29,"م",2,0],["فمرَّ لها يَوْمٌ على النَّهْرِ صالحٌ","غَريبٌ من الأيامِ حلوُ الشَّمائلِ",30,"ل",1,0],["فمرَّ والأوتارُ في مِراءِ","يَحمِلُ مِثلَ زُبدَةِ السِّقاءِ",31,"ا",2,0],["فَمَرجِعُ كُلِّ حَيٍ لِلمَنايا","وَغايَةُ كُلِّ مُلكٍ لِلذَهابِ",32,"ب",1,0],["فَمُرِينَا إِنعام من غيرِ أمرٍ","نحن أسراكِ ما بأسراكِ حرُّ",33,"ر",1,0],["فَمَرَّت مِثلَما يَمشي شَهيدٌ","سَوِيّاً في صِراطٍ مُستَقيمِ",34,"م",1,0],["فَمُرني بِأَمرٍ أَحوَذِيٍّ فَإِنَّني","رَأَيتُ العِدا أَثرَوا وَأَصبَحتُ مُرمِلا",35,"ل",2,0],["فَمَرَّ وَلَو يُجاري الريحَ خيلَت","لَدَيهِ الريحُ تَرسُفُ في القُيودِ",36,"د",1,0],["فَمَرَّ مُطيعاً لِلعَوالي مُعَوَّداً","مِنَ الخَوفِ وَالإِحجامِ ما لَم يُعَوَّدِ",37,"د",1,0],["فَمَريتُ نَظرَتَهُ وَقُلتُ أَصابَني","رَمَدٌ فَهاجَ العَينَ بِالتَسكابِ",38,"ب",1,0],["فَمُرّا صاحِبَيَّ بِدارِ لَيلى","جُعِلتُ لَها وَإِن بَخُلَت فِداءَ",39,"ا",2,0],["فَمَرَّ كَمَرِّ شِهابِ الظَلامِ","لِيَفعَلَ داهِيَةً إِدَّه",40,"د",2,0],["فمرّ واللَهِ يا يحيى بفقحتِها","ما مرّ بالطبلِ في يوم الشّعانينِ",41,"ن",1,0],["فمرتعُ الروضةِ نوّارهُ","مختلفُ البهجةِ في الحسنِ",42,"ن",1,0],["فمَرّ العامُ لم تَطْرُقْ أنِيساً","بدارِهِمُ ولم تَسْمَعْ نُبوحا",43,"ح",2,0],["فَمَرّتْ إذا غنّى الرّديفُ وقد وَنَتْ","بذِكْراهُ زَفّتْ كالنّعامِ المُطَرَّدِ",44,"د",1,0],["فَمَرَّت كَهاةٌ ذاتُ خَيفٍ جُلالَةٌ","عَقيلَةُ شَيخٍ كَالوَبيلِ يَلَندَدِ",45,"د",1,0],["فَمَرَّ النَضِيُّ لِلذِراعِ وَنَحرِهِ","وَلِلحَينِ أَحياناً عَنِ النَفسِ صارِفُ",46,"ف",1,0],["فمرَّ بمستشفى أَخي الطب رامزٍ","يقبِّل جدرانَ المحلةِ والتُربا",47,"ب",2,0],["فمرّت عجوز في الطريق وخلفَها","فتاةٌ يُغشّيها ازارٌ وبُرقُع",48,"ع",1,0],["فَمُرْ بِالَّذِي تَهْوَاهُ فَالسَّعْدُ قَائِمٌ","بِمَا تَشْتَهِي وَاللَّهُ بِالنَّصْرِ كَافِلُ",49,"ل",1,0],["فمرت كهاة ذات خيفٍ جلالةٌ","عقيلة شيخٍ كالوبيل بلندد",50,"د",1,0],["فمرة ً.. تثاؤبٌ عريضٌ","ومرة ً.. تخاصرٌ وجمْعُ",51,"ع",1,0]]}