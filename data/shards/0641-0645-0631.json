جز"],[461,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[461,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[464,"فصبح الوصل وضاح","https://www.aldiwan.net/poem16064.html","الهزج"],[464,"تفوق السيف والوط","https://www.aldiwan.net/poem16125.html","مجزوء الوافر"],[464,"يا لامحا شبح المسف الأكحل","https://www.aldiwan.net/poem16270.html","الكامل"],[467,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[469,"ألا حييا الأطلال والمتطنبا","https://www.aldiwan.net/poem50469.html","الطويل"],[471,"يا من يحب أذى المحب بمطله","https://www.aldiwan.net/poem59749.html","الكامل"],[482,"سألت عليك القبر لو نطق القبر","https://www.aldiwan.net/poem37592.html","الطويل"],[486,"هجرت أمامة هجراً طويلا","https://www.aldiwan.net/poem2071.html","المتقارب"],[541,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[556,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"بدولة الترك عزت ملة العرب","https://www.aldiwan.net/poem3110.html","البسيط"],[579,"خليلي إما مت يوما وزحزحت","https://www.aldiwan.net/poem1781.html","الطويل"],[589,"منعت جفوني لذة الإغفاء","https://www.aldiwan.net/poem17400.html","الكامل"],[745,"","https://poetry.dctabudhabi.ae/diwan/poem/67366","الطويل"],[1027,"","https://poetry.dctabudhabi.ae/diwan/poem/20535","الطويل"]],"verses":[["فَمَرَّت تَظُنُّ النِسعَ صَوتاً أُجيلُهُ","فَلا عُذرَ إِلّا تَتَّقي بِالعَجارِفِ",0,"ف",1,0],["فَمُرني بِأَمرٍ قَبلَ مَوتي فَإِنَّني","أَرى المَرءَ لا يَبقى وَإِن بَعُدَ المَدى",1,"د",2,0],["فَمَرَّ كَما مَرَّت ذَوائِبُ عُشوَةٍ","تُقادُ بِأَطرافِ الرِماحِ وَتُجنَبُ",2,"ب",1,0],["فَمُرْ وقُلْ أَتَّبِعْ ما أنتَ تَنهَجُهُ","فالأمرُ مُمتَثَلٌ والقولُ مَقبولُ",3,"ل",1,0],["فَمُرَنَّحُ الْعِطْفَيْنِ لاَ مِنْ نَشْوَةٍ","وَمُوَرَّدُ الْخَدَّيْنِ غَيْرُ مَرِيبِ",4,"ب",1,0],["فَمَرَّ نَضيءُ السَهمِ تَحتَ لَبانِهِ","وَجالَ عَلى وَحشِيِّهِ لَم يُثَمثِمِ",5,"م",1,0],["فَمَرَّ عَلى مُلسِ النَواشِر قَلَّما","تُثَبِّطُهُنَّ بِالخَبارِ الجِراثِمُ",6,"م",1,0],["فَمَرّ عَلى نَحرِهِ وَالذِراعِ","وَلَم يَكُ ذاكَ لَهُ الفِعلُ دينا",7,"ن",2,0],["فَمَرَّ يَوماً بِهِ وَالجوعُ يَنهَبُهُ","نَهباً فَلَم يُبقِ إِلّا الجِلدَ وَالعَصَبا",8,"ب",2,0],["فمُرْ سَرِيَّ المَعاني أنْ يُواتيَني","فيها فإنِّي ضَعيفُ الحالِ واهيها",9,"ي",3,0],["فَمَرَّت بِأَرواحِنا هِزَّةٌ","هِيَ الكَهرَباءُ بِتَيّارِها",10,"ر",3,0],["فَمَرَّ في لُعبَتِهِ لاهِياً","وَقالَ حَرفانِ مِنَ المُعجَمِ",11,"م",1,0],["فَمَرخُ مُخَلِّصٍ فَمَحَنَّباتٌ","عَفَتها الرِيحُ بَعدَكِ وَالقِطارُ",12,"ر",1,0],["فَمَرَّت بِليلٍ وَهيَ شَدفاءُ عاصِف","بِمُنخَرَقِ الدَوداءِ مَرَّ الخَفَيدَدِ",13,"د",1,0],["فَمَرَّ هَذا وَمَرَّ الشُؤمُ يَتبَعُهُ","وَقامَ هَذا فَقامَ الشُؤمُ وَالنَكَدُ",14,"د",1,0],["فَمَرَّ عَلى القُصوى النَضِيُّ فَصَدَّهُ","تَلِيَّةُ وَقتٍ لَم يُكَمَّل كَمالُها",15,"ل",3,0],["فمرسلة لها سحبُ العوافي","يعفى الداءُ بادره الدواء",16,"ا",2,0],["فَمَرَّ بِالطَيرِ مِنهُ فاعِمٌ كَدِرٌ","فيهِ الظِباءُ وَفيهِ العُصمُ أَجناحُ",17,"ح",1,0],["فَمَرَّ عَلى مَنازِلِها فَأَلقى","بِها الأَثقالَ وَاِنتَحَرَ اِنتِحارا",18,"ر",2,0],["فَمُريني أُطِعكِ في كُلِّ أَمرٍ","أَنتِ وَاللَهِ أَوجَهُ الناسِ عِندي",19,"ي",1,0],["فمر بانكلترا تزجى فيالقها","وبالأساطيل تدوى في موانيها",20,"ي",3,0],["فَمُرهُموا يَأتوا بِخُبزٍ وَلَبَن","وَيُحضِروا آنِيَةً ذاتَ ثَمَن",21,"ن",1,0],["فَمَرحَباً بِكُما مِن طالِعينَ بِهِ","عَلى سِوى الطائِرِ المَيمونِ ما قَدِما",22,"م",2,0],["فَمَرَّت بِنَخلٍ وَفي رَكبِها","عَنِ العالَمينَ وَعَنهُ غِنى",23,"ا",1,0],["فَمَرَّت غَيرَ نافِرَةٍ عَلَيهِم","تَدوسُ بِنا الجَماجِمَ وَالتَريبا",24,"ب",2,0],["فَمُر وَأَومٍ تُطَع قُدِّستَ مِن جَبَلٍ","تَبارَكَ اللَهُ مُجري الروحِ في حَضَنِ",25,"ن",1,0],["فَمَرَّ يَهوي هَوِيَّ الريحِ يُسعِدُهُ","خَرقٌ بَسيطٌ وَلَيلٌ مُظلِمٌ داجِ",26,"ج",1,0],["فَمَرَّةً بِاللُجَينِ تَنعَلُها","وَمَرَّةً بِالدِماءِ تَنتَعِلُ",27,"ل",1,0],["فَمَرَّ مِن تَحتِ أَلحَيها وَكانَ لَها","واقٍ إِلى قَدَرٍ لا بُدَّ مَحمومِ",28,"م",1,0],["فَمَرَّت عَلى أَهلِ الحُفَيرِ كَأَنَّها","ظَليمٌ تَبارى جُنحَ لَيلٍ نَعائِمُه",29,"م",2,0],["فمرَّ لها يَوْمٌ على النَّهْرِ صالحٌ","غَريبٌ من الأيامِ حلوُ الشَّمائلِ",30,"ل",1,0],["فمرَّ والأوتارُ في مِراءِ","يَحمِلُ مِثلَ زُبدَةِ السِّقاءِ",31,"ا",2,0],["فَمَرجِعُ كُلِّ حَيٍ لِلمَنايا","وَغايَةُ كُلِّ مُلكٍ لِلذَهابِ",32,"ب",1,0],["فَمُرِينَا إِنعام من غيرِ أمرٍ","نحن أسراكِ ما بأسراكِ حرُّ",33,"ر",1,0],["فَمَرَّت مِثلَما يَمشي شَهيدٌ","سَوِيّاً في صِراطٍ مُستَقيمِ",34,"م",1,0],["فَمُرني بِأَمرٍ أَحوَذِيٍّ فَإِنَّني","رَأَيتُ العِدا أَثرَوا وَأَصبَحتُ مُرمِلا",35,"ل",2,0],["فَمَرَّ وَلَو يُجاري الريحَ خيلَت","لَدَيهِ الريحُ تَرسُفُ في القُيودِ",36,"د",1,0],["فَمَرَّ مُطيعاً لِلعَوالي مُعَوَّداً","مِنَ الخَوفِ وَالإِحجامِ ما لَم يُعَوَّدِ",37,"د",1,0],["فَمَريتُ نَظرَتَهُ وَقُلتُ أَصابَني","رَمَدٌ فَهاجَ العَينَ بِالتَسكابِ",38,"ب",1,0],["فَمُرّا صاحِبَيَّ بِدارِ لَيلى","جُعِلتُ لَها وَإِن بَخُلَت فِداءَ",39,"ا",2,0],["فَمَرَّ كَمَرِّ شِهابِ الظَلامِ","لِيَفعَلَ داهِيَةً إِدَّه",40,"د",2,0],["فمرّ واللَهِ يا يحيى بفقحتِها","ما مرّ بالطبلِ في يوم الشّعانينِ",41,"ن",1,0],["فمرتعُ الروضةِ نوّارهُ","مختلفُ البهجةِ في الحسنِ",42,"ن",1,0],["فمَرّ العامُ لم تَطْرُقْ أنِيساً","بدارِهِمُ ولم تَسْمَعْ نُبوحا",43,"ح",2,0],["فَمَرّتْ إذا غنّى الرّديفُ وقد وَنَتْ","بذِكْراهُ زَفّتْ كالنّعامِ المُطَرَّدِ",44,"د",1,0],["فَمَرَّت كَهاةٌ ذاتُ خَيفٍ جُلالَةٌ","عَقيلَةُ شَيخٍ كَالوَبيلِ يَلَندَدِ",45,"د",1,0],["فَمَرَّ النَضِيُّ لِلذِراعِ وَنَحرِهِ","وَلِلحَينِ أَحياناً عَنِ النَفسِ صارِفُ",46,"ف",1,0],["فمرَّ بمستشفى أَخي الطب رامزٍ","يقبِّل جدرانَ المحلةِ والتُربا",47,"ب",2,0],["فَمَرَّتْ عَلَى أَظْرَابِ هِرٍّ عشيةً","لَهَا تَوْأَبَانِيَّانِ لَمْ يَتَفَلْفَلاَ",48,"ل",2,0],["فمرّت عجوز في الطريق وخلفَها","فتاةٌ يُغشّيها ازارٌ وبُرقُع",49,"ع",1,0],["فَمُرْ بِالَّذِي تَهْوَاهُ فَالسَّعْدُ قَائِمٌ","بِمَا تَشْتَهِي وَاللَّهُ بِالنَّصْرِ كَافِلُ",50,"ل",1,0],["فمروج اليقين فيها زهور","معصرات التوفيق تسقي رباها",51,"ا",3,0],["فمرت كهاة ذات خيفٍ جلالةٌ","عقيلة شيخٍ كالوبيل بلندد",52,"د",1,0],["فمر تشمع الدنيا هواك وينطلق","إلى الفتح بعد الفتح عسكرك المجر",53,"ر",1,0],["فمرة ً.. تثاؤبٌ عريضٌ","ومرة ً.. تخاصرٌ وجمْعُ",54,"ع",1,0],["فَمَرَّت عَلى رَيدٍ فَأَعنَتَ بَعضَها","فَخَرَّت عَلى الرِجلَينِ أَخيَبَ خائِبِ",55,"ب",1,0],["فمُرُوه فهْوَ المطيعُ لكم في","ما أمرتم وليس تُعْصَى سُعاتُه",56,"ت",2,0],["فمري بكفك في جبهتي","وقولي وقيت من الشدةِ",57,"ه",1,0],["فَمَرَّ كَالسَهمِ إِسراعاً لِوِجهَتِهِ","إِن هيجَ عَنَّ وَإِن سيلَ الجَزيلَ حَبا",58,"ب",2,0],["فَمَرَرنَ يَخبِطنَ الدَياجِيَ وَالفَلا","وَأَظُنُّهُنَّ عَلِمنَ أَينَ أُريدُ",59,"د",1,0],["فَمَرَّت بِكَ الشَقراءُ تَسمو تَحَلُّقاً","كَما حَلَّقَت فَتخاءُ يَجذِبُها وَكرُ",60,"ر",1,0],["فمر أمر مولى للعبيد فإنني","أنا العبدذاك العبد لا الخادم الحرّ",61,"ر",1,0],["فَمَربَعُهُ قَيظٌ وَصَيِّبُهُ مَحلُ","وَلِلَّهِ دَمعٌ فيهِ فاضَت غُروبُهُ",62,"ه",1,0],["فمر ابن روبك أن يتوب فربما","قبلت له عند المهيمن توبة",63,"ه",1,0],["فمر ابن روبك أن يكف لسانه","فلكم لها بالمسلمين وقيعة",63,"ه",1,0],["فَمَرَّت بِقَصرِ العَنبَرِيِّ وَلَم يَكُن","لَها بِسِوى دارِ الأَعادي تَشاغُلُ",64,"ل",1,0],["فَمُرّا فَقُولاَ نحنُ نطلُبُ حاجةً","وعُودَ فَقُولاَ نحنُ مُنصَرِفَانِ",65,"ن",1,0],["فَمرامُهُ سَهلٌ وَكَوكَبُهُ","سَعدٌ وَغُصنُ سُرورِهِ نَضرُ",66,"ر",1,0],["فمروا جنوني بالكرى لتراكم","وتبيت من وصل على ميعاد",67,"د",1,0],["فَمراراً قَد بَكينا","تَحتَ أَقدامِ الحَياةِ",68,"ه",1,0],["فَمُرْ بأمركَ وانْظُر شِعْرَ عَبْدِكَ هَلْ","يطيقه أحد من ذلك النفرِ",69,"ر",1,0],["فمرت به خمس كأعوام يوسف","مكرا مفرا لا يني وهو متعب",70,"ب",1,0],["فمَرآكِ يا مرآةُ يوحِشُ عاشقاً","ويَعكسُ بعد الحسنِ بلُّورُكِ الحُزنا",71,"ن",2,0],["فمَرأَى الفجرِ مُنبَثِقاً","يُحسِّنُ كلَّ ما قَبُحا",72,"ح",2,0],["فمر محادين الضَلالة بالهدى","وأذل أَهل البَغي والالحاد",73,"د",1,0],["فَمَرَّت عَلى خَوفٍ وَثُكلٍ وَجيدُهُ","عَقيرٌ بِمَسفوحِ الدِّماءِ يَجودُ",74,"د",1,0],["فمرة مصفره","ومرة مصرصره",75,"ر",2,0],["فمرت تشق الكون حين مهبها","ملححة حتى أفادت معيتي",76,"ي",1,0],["فمرحى بالهوى الجني","ما دقّ له القلب",77,"ب",1,0],["فَمُرْ تَقيَّ الدِّينِ في طَبْخِنا","نَسْعَى فَقَصْدُ الصُّل