لبسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93570","الكامل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83037","الكامل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11318","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216812","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44905","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125899","الرمل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136908",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83599","السريع"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133155","المجتث"],[4859,"يدللني!","https://www.poetsgate.com/ViewPoem.aspx?id=205801",""],[4927,"اِسْمُ عَفْرَاْء","https://www.poetsgate.com/ViewPoem.aspx?id=29841",""],[5304,"الراتب ما يكفي الحاجه","https://www.poetsgate.com/ViewPoem.aspx?id=155913",""],[5338,"عرش الإمامة جنب حوض الكوثر","https://www.poetsgate.com/ViewPoem.aspx?id=190172",""],[5596,"زنجبار والشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=206692",""],[5944,"2020","https://www.poetsgate.com/ViewPoem.aspx?id=213794",""],[6257,"المجازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87187&r=&rc=12",""]],"verses":[["يُحَصِّنونَ عَلى اَلراجي مَطالِعَهُ","خَوفاً مِنَ السَلَّةِ الحَذّاءِ وَالخَلَسِ",0,"س",1,0],["يُحصَدُ فيهِ الكَفُّ وَالوَتينُ","مِن وَقعِ سَيفي سَقَطَ الجَنينُ",1,"ن",1,0],["يُحصي تَرَدُّدَ أَنفاسي وَيَمنَعُني","نَفحَ الشَمائِلِ إِن جازَت بِرَيّاكِ",2,"ك",1,0],["يُحصَّلُ في الزّق نفخُ اليراعِ","وما لِعداتِك من حاصل",3,"ل",1,0],["يُحصي الدَليلُ مَدى مَطالِبِهِ وَلا","يَحصي مَدى المُستَقبِلِ المِقدامُ",4,"م",1,0],["يُحَصِّنُهُ مِن نَهرِ نَيزَكَ مَعقِلٌ","مَنيعٌ تَسامى غابُهُ وَتَأَشَّبا",5,"ب",2,0],["يَحصُن بِها سَنَدي أَو يَمتَنِع عَضُدي","أَو يَدنُ لي أَمَدي أَو يَعتَدِل أَوَدي",6,"د",2,0],["يُحصى مَعَ الأَنواءِ فَيضُ يَمينِهِ","وَيُعَدُّ مِن حَسَناتِ أَهلِ المَشرِقِ",7,"ق",1,0],["يُحصونَ أَميالَ الطَريقِ وَفي يَدي","كَم خُطوَةٍ تَحني البَعيرَ خُطاها",8,"ه",2,0],["َيُحصي مَعانيكَ القَريضُ المُهَذَّبُ","عَلى أَنَّ صَدرَ الشِعرِ لِلمَدحِ أَرحَبُ",9,"ب",1,1],["يُحصونَ تاريخَ أقوامٍ وعندهمُ","صحائفٌ مُلِئَتْ بالخزيِ والعار",10,"ر",1,0],["يُحصَّلُ في الزّق نفخُ اليرا","عِ وما لِعدانك من حاصل",11,"ل",1,0],["يحصصن ريشي بلا اذن فينبته","فكيف ريشا بإذن منه منتوفا",12,"ف",2,0],["يُحَصِنُها ذُرىً شَمّاءُ يَعنو","لَها القُلَلُ الشَوامِخُ وَالهِضابُ",13,"ب",1,0],["يحصل بها القصد والمراد","والأنس والمسره",14,"ه",1,0],["يُحصِّل من خلائقك المعالي","ويأخذُ من دقائقك المعاني",15,"ن",2,0],["يحصل بها كل مطلوبي","ماعاد بأفضل أو أطنب",16,"ب",1,0],["يُحصىِ لنا النِّعم الجسام وإن تكن","منا ويفرض حَقَّها التمجيدا",17,"د",2,0],["يحصِب وادي الجمارِ يستغفر ال","له ومَن للدماء بالغافرْ",18,"ر",1,0],["يحصِّنُه غيْرانُ للمجد مرهف ال","عزائمِ غَمْرُ الجودِ طلاَّعُ أنجد",19,"د",1,0],["يُحَصِّنُها مِنّي فُدَيكٌ سَفاهَةً","وَقَد ذَهَبَت فيها الكُباسُ وَحوقُها",20,"ق",3,0],["يحصل لدانا طبيب","نكون في السالمين",21,"ن",1,0],["يُحصى الحَصى إِلا مَناقِبَكَ الَّتي","يَعيا بِجُملَتِها حِسابُ الجُمَّلِ",22,"ل",1,0],["يحصى من الجبناء من","ورعٍ على المعهود زائد",23,"د",1,0],["يُحصى الحصى قبلَ أَن تُحصى فَضائِلُكم","دُنيا وَديناً وَإِحساناً وَمُنتَحَلا",24,"ل",2,0],["يُحصي ذُنوبك وَالشؤون بِشأنها","وَيعدها وَأَنا عَلى تَعديدي",25,"د",2,0],["يحصي الذّنوبَ عَلَيه أَي","يام الصّداقَةِ للعداوَه",26,"ه",1,0],["يُحصى الحَصى وَيُعَدُّ الرَملُ أَصغَرُهُ","وَلا تُعَدُّ وَلا تُحصى مَعاليهِ",27,"ه",1,1],["يحصى الطفيف لعامليه وعندهم","خطط العظائم جمة الأعوان",28,"ن",1,0],["يُحَصحِصُ فيهِ الحَقُّ أَبيضَ ناصِعاً","وَتَنهَزمُ الأَوغادُ مِن كُلِّ جانبِ",29,"ب",1,0],["يحصب الجو بما في يده","ويكاد الفم منه يزيد",30,"د",1,0],["يحصي من الارز المتين سفائنا","مملؤة بنفائس الاشياء",31,"ا",2,0],["يحصدُ رَبُّ الزَرعِ في عامِهِ","يَوماً وَأَنت دائِماً تحصدي",32,"د",2,0],["يحصل لنا بالوفا","كمال حد الشفا",33,"ف",2,0],["‏يحَصّنني بأذكارٍ ويهدي","لأيامي ترانيمَ ابتهالِه",34,"ل",2,0],["يُحْصِي النُّجُوْمَ، فَلاْ يُحْصِيْ لَهَاْ عَدَداً","وَالنَّجْمُ فِيْ الْجَوِّ يَسْتَعْصِيْ عَلَى الْعَدَدِ",35,"د",1,0],["يحصّل لجوعه ما يكفيه لاخراجه","ونبي نهجر الشقه ونسكن براحة بيت",36,"ت",1,0],["يُحْصِي النُّفُوسَ بِصَارِمٍ خَمَدَتْ بِهِ","أَنْفَاسُ أُحْدٍ وَالْهُرَاسِ وَخَيْبَرِ",37,"ر",1,0],["يحصد الفقر والتخلُّف منها","كل أزهارها فلا إثمار",38,"ر",1,0],["10-يحصُدُ أرواحًا من أحِبَّتِنا","من دمِنا ظلَّ يُترِعُ القدَحا",39,"ح",2,0],["يحصي المواجع، يحصي عمر خيبته","حتى استحال بهذي البيد منفردا",40,"د",2,0]]}