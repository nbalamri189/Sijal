ا البدرا","https://www.aldiwan.net/poem14966.html","الطويل"],[262,"كفى حزنا أني أراك قريبة","https://www.aldiwan.net/poem38266.html","الطويل"],[276,"فواتح الفتح تنبي عن تواليه","https://www.aldiwan.net/poem25461.html","البسيط"],[281,"أمن الملك حسبك من أمين","https://www.aldiwan.net/poem60689.html","الكامل"],[281,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[304,"بي غادة لم ترض بدر الدجا","https://www.aldiwan.net/poem58088.html","السريع"],[306,"فسحة العمر وإن طالت قصيره","https://www.aldiwan.net/poem56510.html","الرمل"],[321,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[338,"ألا ناديا أظعان ليلى تعرج","https://www.aldiwan.net/poem45434.html","الطويل"],[354,"هناء وإسعاد وعز مؤبد","https://www.aldiwan.net/poem40402.html","الطويل"],[357,"يا موت طرفى رهانٍ","https://www.aldiwan.net/poem24534.html","البسيط"],[365,"قضى على جد شانيكم بإتعاس","https://www.aldiwan.net/poem60867.html","البسيط"],[367,"ولو تصرف السحب الغزار عن الثرى","https://www.aldiwan.net/poem17911.html","الطويل"],[394,"يقولون لي كم عهد عينك بالكرى","https://www.aldiwan.net/poem53386.html","الطويل"],[401,"أنوار القرآن","https://www.aldiwan.net/poem6712.html","عموديه"],[404,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[407,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[410,"قصرت في خدمي تقصير معترف","https://www.aldiwan.net/poem32252.html","البسيط"],[410,"أذكرهم الود إن صدوا وإن صدفوا","https://www.aldiwan.net/poem32428.html","البسيط"],[433,"شمس المحاسن قد أطلعتها فلكا","https://www.aldiwan.net/poem12434.html","البسيط"],[433,"لا تثن جيدك إن الروض قد جيدا","https://www.aldiwan.net/poem12586.html","البسيط"],[433,"أي فؤاد فيك لم يكلف","https://www.aldiwan.net/poem12670.html","السريع"],[442,"متى بنا العيس ينكحن السماليقا","https://www.aldiwan.net/poem14318.html","البسيط"],[442,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[442,"نكابد في الدنيا هموما وأحزانا","https://www.aldiwan.net/poem14485.html","الطويل"],[462,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[465,"كيف السكون من الدنيا إلى سكن","https://www.aldiwan.net/poem3393.html","عموديه"],[465,"كيف الوقوف على آثار مرتحل","https://www.aldiwan.net/poem3470.html","عموديه"],[469,"صرفت إبراهيم عن ذهني","https://www.aldiwan.net/poem59572.html","السريع"],[469,"إذا تثاقل عتب","https://www.aldiwan.net/poem59976.html","المجتث"],[516,"فرض على الشعر أن يبدا بما يجب","https://www.aldiwan.net/poem12013.html","البسيط"],[516,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[516,"رميت يا دهر كف المجد بالشلل","https://www.aldiwan.net/poem12225.html","البسيط"],[539,"ألحمد لله زال الخوف والوجل","https://www.aldiwan.net/poem47987.html","عموديه"],[554,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[563,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[563,"سقاني حبه كأسا دهاقا","https://www.aldiwan.net/poem52982.html","الوافر"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[587,"صبا وهزته أيدي شوقه طربا","https://www.aldiwan.net/poem17425.html","البسيط"],[588,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"]],"verses":[["وَلَو تَعاطاني العَدُوُّ ما قَدَر","وَكانَ لِلخُصومِ عَنّي مُزدَجَر",0,"ر",1,0],["وَلَو تَبَدَّت ظَلومٌ وَهيَ مُسفِرةٌ","تَحتَ الظَلامِ لِأَهلِ الأَرضِ لِاَفتُتِنوا",1,"ن",3,0],["وَلَو تَمَنّى عِدايَ وَاِجتَهدوا","ما بَلَغوا ما رَأَيتِ في جَسَدي",2,"د",2,0],["وَلَو تَعلَمينَ الغَيبَ أَيقَنتِ أَنَّني","لَكُم وَالهَدايا المُشعَراتِ صَديقُ",3,"ق",1,0],["وَلو تُبْق يَوْماً لِلْخَوَرْنق رَونَقاً","وَلاَ شَعَبَتْ مَا اخْتَلَّ مِنْ شِعْبِ بَوَّانِ",4,"ن",1,0],["وَلَوْ تَنَاسَى الرّضِيَّى الدَّهْرُ ثُمَّ رَأَى","أَيّامَ سَلْمِكَ لَمْ يَحْفِلْ بِذِي سَلَمِ",5,"م",1,0],["ولوْ تركَتْ منّي اللّيالي صُبابةً","لأجْهَدْتُها ركْضاً وأرْهَقْتُها شَدّا",6,"د",2,0],["وَلَو تَلَبَّثَ عَنها غَيرَ تارِكِها","إِلّا إِلَيها قَريباً ثُمَّ يَنتَقِلُ",7,"ل",1,0],["وَلَو تَزجُرونَ الطَيرَ يَوماً عَلِمتُمُ","بِما تَحتَهُ مِن عَثرَةٍ وَشَتاتِ",8,"ت",1,0],["وَلَو تَرَدّى النَزيهُ مِن حَبلٍ","قَباً لَأَضحى مُمَزَّقَ القَبِّ",9,"ب",1,0],["وَلَو تَسأَلينَ الرَكبَ في كُلِّ سَربَخٍ","إِذا العيسُ لَم يَنبِس بِلَيلٍ بَغومُها",10,"م",3,0],["وَلَو تُنقَبُ الأَضلاعُ أُلفِيَ تَحتَهَا","لِسُعدى بِأَوساطِ الفُؤادِ مَضارِبُ",11,"ب",1,0],["ولو تستنهض الجبناء يوماً","به لتقّحموا الهيجا اسودا",12,"د",2,0],["وَلَو تَدعو بِطاحِيَةَ اِبنِ سودٍ","وَزَهرانَ الأَعِنَّةِ أَو إِيادا",13,"د",2,0],["وَلَو تَدعو الجَهاضِمَ أَو جُدَيدا","وَجَدتَ حِبالَ ذِمَّتِهِم شِدادا",13,"د",2,0],["ولو تولت حزون الأرض راحته","لم يبق في الأرض صلد غير منبجس",14,"س",1,0],["ولو ترانا وقد تَكنَّفنا","من دُكُن الخزَّ لابسٌ جاها",15,"ا",3,0],["ولو تجاوزه المُدَّاحُ لم يجدوا","في الأرض عنه ولا في القول مُنتدَحا",16,"ح",2,0],["ولو تكبرتِ كنتِ مُعْذِرةً","والمسكُ ما لا يُعابُ بالذَّفرِ",17,"ر",1,0],["ولو تخليتُ من شَجايَ بكم","بادرتُ باللهو كرَّةَ القَدرِ",17,"ر",1,0],["ولو ترى الرِّجس على أربع","أمام فحلٍ مُوثَق الأسر",18,"ر",1,0],["ولو تصدَّيتَ وواقفتني","كَحَّلت عينيَّ بُعوَّار",19,"ر",1,0],["ولو تولى غيرُه","قسمةَ أرزاق الورى",20,"ر",2,0],["ولو تاجروا لم يعبثوا بتجارة","ولا انخدعت تلك الحلوم لخادع",21,"ع",1,0],["ولو تبذلت للحروب لأُل","فيتَ شبيهاً بالليث ذي الغضف",22,"ف",1,0],["ولو تخلّيت من علائقِ تأ","ميلكَ قفَّيتَ بالأباطيلِ",23,"ل",1,0],["ولو تلقيتَ بالتواضعِ ما","أُوتيت منه لتمَّ والتأما",24,"م",2,0],["وَلَو تَكَلَّفَها رِخوٌ مَفاصِلُهُ","أَو ضَيِّقُ الباعِ عَن أَمثالِها سَعَلا",25,"ل",2,0],["وَلَو تَلُفُّ النَوى مَن قَد تُشَوِّفَهُ","إِذاً قَضَيتُ لُباناتي وَأَوطاري",26,"ر",2,0],["وَلَو تَأتي الفَراشَةَ وَالحُبَيّا","إِذاً كادَت تُكَلِّمُكَ الطُلولُ",27,"ل",1,0],["وَلَو تَرَكَ الزَمانُ لَهُ فُؤاداً","لَما تَرَكَت لَهُ البَلوى فُؤادا",28,"د",2,0],["وَلَو تُرَجّى أَوبَةً لَاِشتَفَت","لَكِنَّما وَزَّ عَلَيها الإِياب",29,"ب",1,0],["وَلَو تَرَكَت عَقلي مَعي ما طَلَبتُها","وَلَكِن طِلابيها لِما فاتَ مِن عَقلي",30,"ل",2,0],["وَلَو تَأَنّى نالَ ما تَمَنّى","وَعاشَ طولَ عُمرِهِ مُهَنّا",31,"ن",2,0],["وَلَو تَنزِلُ الدُنيا عَلى حُكمِ كَفِّهِ","لَأَصبَحَتِ الدُنيا وَأَكثَرُها نَزرُ",32,"ر",1,0],["وَلَو تَبَّعتِ ما طَرَحَت قَناهُ","لَكَفَّكِ عَن رَذايانا وَعاقا",33,"ق",2,0],["وَلَو تَناهَت بَنو شَيبانَ عَنهُ إِذاً","لَم يَجشَموا وَقعَ ذي حَدَّينِ مَذروبِ",34,"ب",1,0],["وَلَو تُمكِنُ الشَكوى لَخَبَّرَكَ البُكا","حَقيقَةَ ما عِندي وَإِن جَلَّ ما عِندي",35,"د",2,0],["وَلَو تَمَّ لا تَمَّ تَأميلُهُ","لَكانَ بِذَلِكَ غَيرَ السَعيدِ",36,"د",1,0],["وَلَو تُنصِفُ الأَقدارُ كانَت مَطالِبي","إِلَيكَ وَكانَ الآخَرونَ وَسائِلي",37,"ل",2,0],["وَلَو تُنكِحُ الشَمسُ النُجومَ بَناتِها","إِذاً لَنَكَحناهُنَّ قَبلَ الكَواكِبِ",38,"ب",1,0],["وَلَو تَرضَينَ مَمّا قَد لَقينا","لِأَنفُسِنا بِقاصِمَةِ الظُهورِ",39,"ر",1,0],["وَلَو تُرمى بِلُؤمِ بَني كُلَيبٍ","نُجومُ اللَيلِ ما وَضَحَت لِساري",40,"ر",2,0],["وَلَو تَشرَبُ الكَلبى المَراضُ دِماءَنا","شَفَتها وَذو الداءِ الَّذي هُوَ أَدنَفُ",41,"ف",1,0],["وَلَو تَدري لَقُلتُ لَها اِشمَعِلّي","وَلا تَشكي إِلَيَّ لَكِ الكَلالا",42,"ل",2,0],["ولو تفوَّقَ سَهمْي راكباً وَتَراً","يوماً لطال عليهم نَقْضُ أوتاري",43,"ر",2,0],["ولو تشاءَم لانقَضَّت صواعقُه","على العِراقِ كما ارفضَّت سَحائبُه",44,"ب",2,0],["وَلَو تابَعوا قَولَ الإِلَهِ وَأَمرَهُ","لَقالوا بِأَنَّ الصُلحَ لِلخَلقِ أَصلَحُ",45,"ح",1,0],["ولو تمادَوْا على الرأي الذميمِ ولم","يُسَلّموا لك أمْرَ الحصن ما سلموا",46,"م",3,0],["ولَوْ تُنظم الأحساب يوماً قَلائِداً","لقلد منها جَوْهَرُ الحسبِ اللّبِ",47,"ب",1,0],["وَلَو تَراهُم وَإِيّانا وَمَوقِفَنا","في مَأتَمِ البَينِ لِاِستِهلالِنا زَجَلُ",48,"ل",1,0],["وَلَو تَبَسَّمُ عُجنا الطَرفَ في بَرَدٍ","وَفي أَقاحٍ سَقَتها الخَمرُ وَالضَرَبُ",49,"ب",1,0],["وَلَوْ تَكَشَّفَ هَذَا الأَمْرُ لارْتَدَعَتْ","مَعَاشِرٌ خَلَطُوا كُفْرَاً بِإِيمَانِ",50,"ن",1,0],["ولو تُرك النبيُّ بلا دفاعٍ","لدافعَ عنهُ أملاكُ السماء",51,"ا",2,0],["وَلَوَت رَأسَها ضِراراً وَقالَت","إِذ رَأَتني إِختَرتَ ذَلِكَ أَنتا",52,"ت",2,0],["وَلَو تَسامَحَ خَطبٌ في فِدائِكِ بي","لَكُنتُ مَهما عَرا خَطبٌ أُفَدّيكِ",53,"ك",1,0],["وَلَو تَعلَمينَ الغَيبَ أَيقَنتِ أَنَّني","وَرَبِّ الهَدايا المُشعِراتِ صَديقُ",54,"ق",1,0],["وَلَو تَفَلَت في البَحرِ وَالبَحرُ مالِحٌ","لَأَصبَحَ ماءُ البَحرِ مِن ريقِها عَذبا",55,"ب",2,0],["وَلَو تَآلَفَ أَهلوها لَما بَقِيَت","مِن حاجَةٍ في ضَميرِ النيلِ وَالهَرَمِ",56,"م",1,0],["وَلَو تَشاءُ إِذَن جاشَت غَوارِبُها","بِالمَوتِ لا زَوَرٌ عَنها وَلا حِوَلُ",57,"ل",1,0],["ولو تَسْطِيعُ لاتَّخذَتْ حَياءً","من البيضِ الرقاقِ لها نِقابا",58,"ب",2,0],["وَلَو تُشَقُّ عَنِ المَنصورِ تُربَتُهُ","أَثنى عَلَيكَ لِعَهدٍ لا تُضَيِّعُهُ",59,"ع",2,0],["ولوْ تأمّلَ مَن ضُمّتْ حَريبتُهُ","لقسَّم الطرفَ بينَ الفَجْع والثَّكَل",60,"ل",1,0],["ولو تشا يا إلهي","حملتُ رحلي وأيري",61,"ر",2,0],["وَلَو تَموتُ لَراعَتني وَقُلتُ لَها","يا بُؤسَ لِلمَوتِ لَيتَ الدَهرَ أَبقاها",62,"ا",3,0],["وَلَو تُساعِدُنا كُنّا بِنَدوَتِها","كَالقَوسِ أَيَّدَها الرامونَ بِالوَتَرِ",63,"ر",1,0],["وَلو تَلقينَنا وَاللَ","هِ أَو نَلقاكِ في سُترَه",64,"ر",2,0],["وَلوَ تَراها إِذا أَلقَت مَجاسِدَها","وَأَبرَزَت عَن لَبانٍ غَيرِ خَوّارِ",65,"ر",1,0],["وَلَو تَحَرَّجتِ مِن قَتلي بِلا تِرَةٍ","لَم تَقتُليني جِهاراً غَيرَ إِسرارِ",65,"ر",1,0],["وَلَو تُعطى بِسَعيِكَ مُتَّ جوعاً","وَلَم تَظفَر يَداكَ بِما تُريدُ",66,"د",1,0],["وَلَو تُكَلِّمُ مَحمولاً جِنازَتُهُ","قَد ماتَ بِالأَمسِ أَو تَرثي لَهُ خَلَدا",67,"د",2,0],["وَلَو تَرانا مَعَ الجِلاءِ إِذاً","بَدا لِعَينَيكَ مَنظَرٌ بَهِجُ",68,"ج",1,0],["وَلَو تَرى الأَزدِيَّ في جَمعِهِ","كانَ كَضِلّيلِ بَني تَغلِبِ",69,"ب",1,0],["وَلَو تَصَوَّرَ أَهلُ الدَهرِ صورَتَهُ","لَم يُمسِ مِنهُم لَبيبٌ وَهوَ مَسرورُ",70,"ر",1,0],["وَلَو تُراعينَ مَولى الناسِ كُلِّهُمُ","ما كُنتِ مِن نُوَبِ الدُنيا تُراعينا",71,"ن",2,0],["ولو تَقَدّمَ في عَصر مضى نزلَتْ","في وَصْفِهِ مُعْجِزاتُ الآيِ والسَوَرِ",72,"ر",1,0],["وَلَو تَستَعِفُّ التَيمُ أَو تُحسِنُ القِرى","وَلَكِنَّ تَيماً لا تَعِفُّ وَلا تَقري",73,"ر",2,0],["وَلَوَتْ بِوَعْدِكَ بَعدَ طُولِ ضَمانِهِ","وَمِنَ الْوُعُودِ خِلابَةٌ ما تُقْتَضَى",74,"ا",1,0],["وَلَوْ تَسَاوَى الرِّجَالُ فِي خُلُقٍ","لَزَالَ هَذَا الْخِلافُ وَالْحَرَدُ",75,"د",1,0],["وَلَوْ تَبَيَّنَ ما في الْغَيْبِ مِنْ حَدَثٍ","لَكَانَ يَعْلَمُ مَا يَأْتِي وَيَجْتَنِبُ",76,"ب",1,0],["وَلَوْ تغَشَّاهُ العِدَى لانْثَنَوْا","مُقْبِلُهُمْ يَعْثرُ بِالْمُدبِرِ",77,"ر",1,0],["وَلَو تَحَمَّلَهَا بَحْرٌ لَشَبَّ لَظَىً","وَجَفَّ وَانْهَالَ فِيهِ كُلُّ جُلْمُودِ",78,"د",1,0],["وَلَو تَتفُلُ في البَحرِ","لَأُلفي البَحرُ قَد طابا",79,"ب",2,0],["وَلَو تَراني صَباحَ اليَومَ إِذ بَرَزوا","ثَكلان أَبكي وَتَبكي حَولي الآمِ",80,"م",1,0],["وَلَو تَنطِقُ الآدابُ قُلتُ حَقيقَةً","رَواني بِأَفكارٍ إِلَيَّ رَواني",81,"ن",2,0],["ولو تَرانِي إذا غَنَّتْ بَلابِلُهُ","أشكُو البلابلَ لو تُغْني الشَّكِيَّاتُ",82,"ت",1,0],["وَلَو تَشَبَّثتَ بِها","لَأَنشَبَتكَ في الشَرَك",83,"ك",1,0],["ولو تناسى الرضى الدهر ثم رأى","أيام سلمك لم يحفل بذي سلم",84,"م",1,0],["ولو تركت من الليالي صبابة","لأجهدتها ركضا وأرهقتها شدا",85,"د",2,0],["ولو تستطيعُ نُهُوضاً سَعَت","قُراه اللِطافُ وبُلدانه",86,"ن",2,0],["ولو تقضَّتْ عليهم مثلها عَدَدا","من السنين لما مَلّوُا وما سَئِموا",87,"م",3,0],["ولو تمكَّنتُ قدَّمتُ الفؤادَ لكم","لكنَّ تقديمَ إحساسي بإِمكاني",88,"ن",2,0],["وَلَوْ تَدْرِي لَقُلْتُ لِا اشْمَعِلّي،","ولا تَشْكي إليّ لَكِ الكَلالا",89,"ل",2,0],["وَلَوْ تَشْرَبُ الكَلْبَى المرَاضُ دماءنَا","شَفَتْهها، وَذو الدَّاءِ الذي هُوَ أدْنَفُ",90,"ف",1,0],["ولو تبذَّلتَ للحروب للألْ","فيتَ شبيهاً بالليثِ ذي الغَضفِ",91,"ف",1,0],["ولوت هيكل الفؤاد بلى ال","خصر رب الرقائق المعجزات",92,"ت",1,0],["ولو تراه عابساً مكشراً","ينذرني مهدداً مزمجرا",93,"ر",2,0],["ولو تجمَّع حزنُ الخلقِ في خَلَدِي","فإن مراى فتى سلطان يسليني",94,"ن",2,0],["ولو تبين جالينوسُ موقعَه","لحار في وصف هذي الابتداعات",95,"ت",1,0],["ولو تركوا الآدابَ عنهم بمعزلٍ","وجادوا لقلت أمدحُ الجود والبذلا",96,"ل",2,0],["ولو تشاءُ اصطنعت خيلُه","وليمةً يَشهدُها القَشعمُ",97,"م",1,0],["ولو تجحد الأقرانُ بأسَك في الوغى","أتتك النسورُ بالذي كان شُهَّدا",98,"د",2,0],["ولو تُجاوره الأغصانُ ما خطَرت","ريحُ النُّعامىَ عليها وهي مغوارُ",99,"ر",1,0],["وَلَو تَرَكَت تَاجَ المُلوكِ وَراءَها","تَعَذَّرَ مَطلوبٌ وَأَخفَقَ طالِبُ",100,"ب",1,0],["وَلَو تَمَهَّلَ مُرديهِ أَتَوكَ بِهِ","إِتيانَ جِنِّ سُلَيمانٍ بِعَرشِ سَبا",101,"ب",2,0],["وَلَو تَرَكا لي بُغيَةً أَستَزيدُها","لَكُنتَ بِها دونَ الوَرى مُتَكَفِّلا",102,"ل",2,0],["وَلَو تَوَلَّيتَ أولى الدَهرِ أَمرَهُمُ","لَم يَهتَضِم وَلَدَ الزَهراءِ مُهتَضِمُ",103,"م",1,0],["وَلَو تَوَخَّيتَ إِعناتَ المُذِمِّ لَهُم","لَم يَرضَ سَيفُكَ حَتّى تُخفَرَ الذِمَمُ",104,"م",1,0],["ولو تشا ما بت في أسره","ملقى على مفترش الذلة",105,"ه",1,0],["ولو توزن الدنيا جميعا وأهلها","بظفرك ما وافوا قلاماً من الظفر",106,"ر",1,0],["وَلَو تَكون لِليثِ الغابِ نَجدَتُهُ","ما كانَ مَسكَنُهُ في الغابِ وَالقَصَبِ",107,"ب",1,0],["وَلَو تَرى السَجّانَ في كُبُولِهِ","يَضرِبُ ضَربَ النَعَمِ المِسلَعِ",108,"ع",1,0],["وَلَو تُقَسَّمُ في الآسادِ نَجدَتُهُ","لَم يُضحِ مَسكَنُها إِلّا ضَواحيها",109,"ي",3,0],["ولو تَجشَّأتُ فيه","لَما تَجاورَ حلقي",110,"ق",2,0],["ولو ترك النحوس إلى مداها","كفي همّ العذاب إلى العذاب",111,"ب",1,0],["وَلَو تُرِكوا فيما أرادوا وَعَقلهم","لَمالَ إِلى الإسلامِ جُمهورُهم جهرا",112,"ر",2,0],["ولو تخلقُ الأشعارُ في الرأسِ لم يكن","برأسكَ إلا القفرُ والشعرُ أغوالُ",113,"ل",1,0],["ولو تساندَ كلُّ الخلقِ ما قدروا","أنْ يحبسوا موجةً من موجةِ الجاري",114,"ر",2,0],["ولو تزيدُ الحسنَ أثوابُهُ","لبانَ نقصَ الحسنِ في الشمسِ",115,"س",1,0],["ولو تدري أضلاعي يُحَطِّمُها الهوى","لذابت أسىً والقلبُ منها تَمَزَّقَا",116,"ق",2,0],["ولو ترعوي ما في ضميري من الجَفا","لأبديتَ لي لُطْفاً وساءتْكَ غُربتي",117,"ي",1,0],["ولو ترى الحي عندما رعدت","أشجع من فيه قلبه خذله",118,"ل",2,0],["ولو تذكّرتُ ذنباً لانثنيت به","حتى أقطِّع قلبي تحته قِطعا",119,"ع",2,0],["ولو تفاطنت الألباب منك درت","بأنها عنك في عَجْز وفي حَصَرِ",120,"ر",1,0],["ولو تأمّلتَ وجدت الصِّبَا","أخفَّ من حِلْمٍ ثقيلِ الوقار",121,"ر",1,0],["ولو تبدّت لها سجيّتُه","ما حمَدتْ بعده سَجَاياها",122,"ا",3,0],["ولو تعقلُ الوُرقُ السَّواجِعُ سَجعَهُ","لَراحَت وقد أزرى بها منه ما أزرى",123,"ر",2,0],["ولو تجدي ما بي رحمت من الهوى","محباً صبوراً والمحب صبور",124,"ر",1,0],["ولَوْ تُسامِحُنِي العَليَاءُ قُلتُ صَبا","سحْرُ البَيَانِ إلَيْهِ دُونَ صَابِيهِ",125,"ي",2,0],["وَلَوْ تُحْبا بِقَدْرِكَ كُنْتَ مِنْهُ","مَكانَ التّاجِ مِنْ أَعْلى الْجَبِينِ",126,"ن",1,0],["وَلَوْ تَدْرِي الْحَوادِثُ ما جَنَتْهُ","بَكَتْكَ غَداةُ دَهْرِكَ والأَصِيلُ",127,"ل",1,0],["ولو تثنت قطعت خفها","على قذال الغصن النضر",128,"ر",1,0],["ولَوت ليّاً عَن الدنيا على","أنّها في سنّ عِشرينَ غَريره",129,"ر",2,0],["وَلَو تَرى نُبلَهُم إِذ لِلعِدى رَدَفوا","عَن مَنبَعِ النَسلِ لَم تُخطِئ رِمايَتُهُ",130,"ت",2,0],["وَلَو تَطلُبُ المَعروفَ عِندي رَدَدتُها","بِحاجَةِ لا القالي وَلا المُتَلَجلِجِ",131,"ج",1,0],["وَلَو تليت يَوماً عَلى من أَجنّهُ","بِعادُكَ خِلنا ماردَ الهمّ يطردُ",132,"د",1,0],["ولو تفرق في الأقران ما جمعا","لادركوا كلّ مطلوب ومغتبط",133,"ط",1,0],["ولو تَعرَّيتُ عنها لم يَضِرْ أملي","إنّ الغزيرةَ لا تَمْرِي بإبساس",134,"س",1,0],["وَلَو تُصرَفُ السُحبُ الغِزارُ عَنِ الثَرى","لَما اِنصَرَفَت عَن طَبعِكَ الشِيَمُ الحُسنى",135,"ن",2,1],["وَلو تَلتَقي عَينٌ عَلى غَير دَمعَةٍ","لَصارَمتُها حَتّى يُقالُ نَفاها",136,"ه",2,0],["ولو تغافل عنهم كُل ذي رشدٍ","لهدّموا بفوؤس الغدر أسوارا",137,"ر",2,0],["ولو تشتري تلك المساجد باعها","ببخس وما بالي بصفقة خاسر",138,"ر",1,0],["وَلَو تَيَقَّنتُ غير الراح في فَمِها","ما كُنتُ مِمَّن يَصُدُّ اللَثم بِاللَتمِ",139,"م",1,0],["ولو تجافتْ ليَ الأيّامُ عن وطَرِي","لنابَ عن قَلَمِي في سَعيِهِ القَدَمُ",140,"م",1,0],["ولو تعوّضتُ بالدّنيا غُبِنتُ وهَل","يَعُوضُني من نَفيس الجوهرِ الصّدفُ",141,"ف",1,0],["ولو تَمُرُّ على رَقٍّ أَنامِلُكا","أَرَقَّ بِالرِّقِّ كُتَّاب الأَنامِ لَكَا",142,"ك",2,0],["ولو تكلّف حب فوقَ طاقتِه","سعتْ إليه رُباه تقطعُ البيدا",143,"د",2,0],["ولو تحامى عنه ذو مَنعةٍ","لم ينقصِ البدرُ ولم يُكْسَفِ",144,"ف",1,0],["ولو تواردها الظئبار نوح في","أرجائها وتبقى حيران زهليقا",145,"ق",2,0],["ولو تجرى على بحر لأضحى","كأن ما كان بحراً من لظاها",146,"ا",3,0],["ولو تتعظ بالموعظات التي بنا","وآبائنا الماضين عنا وأبنانا",147,"ن",2,0],["ولو تأمَّلَ سلطانُ الورى هِمَمِي","أضاءَ ليلٌ وعاشت أعظمٌ رِمَمُ",148,"م",1,0],["ولو تؤدي دموعي فرط صحبته","ما أثقلني أيادي الزمن بالمنن",149,"ن",1,0],["ولو تراها وقد ألقت قلائدها","مع الكرى لرأيتَ الحلي في العطلِ",150,"ل",1,0],["وَلَو تَعَنَّيتُ إِلى عِرضِهِ","بِلَفظَةٍ تُبلِغُهُ عَنّي",151,"ن",2,0],["وَلَو تَحَمَّلَ سَمعي","مَشَقَّةَ الإِنتِهارِ",152,"ر",1,0],["ولو تولت بنو رزيك نصرتهم","في سالف الدهر ما نابتهم النوب",153,"ب",1,0],["ولو تمكنت إذاً أحله","طرفك في النقطة من سواده",154,"د",2,0],["ولو تضاعفت الأقوال واستبقت","ما كنت فيهم بحمد الله بالخجل",155,"ل",1,0],["ولو تَرى قلبَ ذي الأَحبابِ يَوم ضَنًى","أبصرتَ أعماقَهُم لِلَّهِ تَبتَهِلُ",156,"ل",1,0],["وَلَو تَلَبَّثَ دَيّانٌ لَها رَوِيَت","مِنهُ وَلَكِن شَآها عَدوَ مَزؤودِ",157,"د",1,0],["ولو تَنفّستُ فوقَ البحرِ حينَ غَلا","غليلُ صَدري لخُضتُ البحرَ بالقَدَمِ",158,"م",1,0],["ولو تَرَكَ الدواءَ لنابَ عنهُ","بأطيبَ منهُ نشْراً أو مَذَاقا",159,"ق",2,0],["ولو تمادت شدة البلية","لانقطع الدين على الكلية",160,"ه",1,0],["وَلَوْ تَلوْتَ على مَيْتٍ مَناقِبَهُ","رَدّ الإلهُ لَهُ الرُّوحَ الَّتي سَلَبا",161,"ب",2,0],["ولو تدرون ما أبديتمو لي","عتاباً بالملامة أو كلاما",162,"م",2,0]]}