201921",""],[5596,"البردة الشعرية","https://www.poetsgate.com/ViewPoem.aspx?id=206751",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5643,"أصبح الملك واهي الأرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=181292",""],[5691,"ذيول العباءات","https://www.poetsgate.com/ViewPoem.aspx?id=205882",""],[5804,"لا تلم في الزمان حرا غريبا","https://www.poetsgate.com/ViewPoem.aspx?id=215193",""],[5961,"الدعاء في عرفات","https://www.poetsgate.com/ViewPoem.aspx?id=199815",""],[5961,"والله اليوم عيد","https://www.poetsgate.com/ViewPoem.aspx?id=199808",""],[5982,"يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=152889",""],[161,"بين الأرض والسماء حياة","https://www.poetsgate.com/ViewPoem.aspx?id=202596",""],[6102,"كلميني","https://www.poetsgate.com/ViewPoem.aspx?id=184858",""],[6124,"ثورة الأمعاء","https://www.poetsgate.com/ViewPoem.aspx?id=174663",""],[6185,"غزو الهموم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87032&r=&rc=18",""]],"verses":[["ثم صدّت فأدبرت عن دلال","ثم عادت فأقبلت عن مجانه",0,"ن",2,0],["ثُمَّ صاحا يالَ غَسّانَ اِصبِروا","إِنَّهُ يَومُ مَصاليتَ صُبُر",1,"ر",1,0],["ثم صال الأمير بالثعلب الحا","ئن صول المحقِّ لا الغِطريس",2,"س",1,0],["ثم صرَّحتُ وما مع","نى احتشامي وانقباضي",3,"ض",2,0],["ثم صاحوا السلاَح فانصاتَ كهلٌ","فيلسوفٌ وبندُهم في يمينه",4,"ن",2,0],["ثم صيرته مجنا يقيني","في فروق من شر عبد الحميد",5,"د",1,0],["ثُمَّ صَرِّح لَهُ بِأَنَّ حُضورَ ال","راحِ قَصداً كَشُربِها في الإِثامِ",6,"م",1,0],["ثُمَّ صِحتُ اِعتَزِل فَشاهُكَ قَد ما","تَ بِلا مِريَةٍ وَقَد حَلَّ ديني",7,"ن",2,0],["ثُمَّ صِف لِلجَلالِ نَجلَ الحَريرِي","يُ اِشتِياقي وَالفَخرُ نَجلُ الياسِ",8,"س",1,0],["ثُمَّ صَدَّت بِوَجهِها عَمدَ عَينٍ","زَينَبٌ لِلقَضاءِ أُمُّ الحُبابِ",9,"ب",1,0],["ثُمَّ صارَت إِلى أَغَنَّ كَطَيرِ ال","ماءِ إِبريقِ فِضَّةٍ مَفدومِ",10,"م",1,0],["ثُمَّ صَدَّت لِقولِ حَمّاءَ فينا","يا لقَومي دَمي عَلى حَمّاءِ",11,"ا",2,0],["ثم صبَّا بقسوةٍ فوق رأسي","قَطِراناً لسوء حظي يفور",12,"ر",1,0],["ثم صافحته أَداريه باللي","ن كَما صافح الخليل الخليل",13,"ل",1,0],["ثم صف لي بعد تشخي","صك للداء دوائي",14,"ي",1,0],["ثمّ صارت ((مهديّة)) ((ورسولا))","نزلت واديا أضاعت شفيره",15,"ر",2,0],["ثمّ صبوهمُ على الوطن المنكوب","سوطاً يلتاع منه التياعا",16,"ع",2,0],["ثُمَّ صاروا كَأَنَّهُم وَرَقٌ جَف","ف فَأَلوَت بِهِ الصَبا وَالدَبورُ",17,"ر",1,0],["ثُمَّ صَلاةُ الله والسَّلام","عَلَى النَّبِيِّ ما انجَلى الظَّلام",18,"م",1,0],["ثم صلّى الإلهُ ما هبَّت الرِّ","يحُ على المصطفى السَّرِيِّ البَرَاءِ",19,"ا",2,0],["ثم صِرنا بينَ هاتِيكَ","وهذِي لا نُبالي",20,"ي",1,0],["ثُمَّ صَفَّ النَّمَارِبقَ الغُرَّ صَفًّا","والزَّرَابي مُبثُوثَةَ التَّحبِيرِ",21,"ر",1,0],["ثمّ صلّى بالأَنبِياءِ إماماً","وبهِ شَرّفَ الجميعَ اِقتداءُ",22,"ا",2,0],["ثمّ صدّوه سائِراً لاِعتمارٍ","حيثُ ضمّت جموعَهُ الحدباءُ",22,"ا",2,0],["ثمَّ صاروا لهُ وللدينِ مِن بع","دُ همُ الناصرون والنصحاءُ",22,"ا",2,0],["ثمّ صاحت لبّيك والبحر ساجٍ","ليت شعري من الذي ناداها",23,"ا",3,0],["ثم صار الوجود بالدين نارا","تأكل الحسن والصباحة منا",24,"ن",2,0],["ثم صالت وقد تملكها اليأس","بكفّ مخضوبة وبنان",25,"ن",1,0],["ثم صلوا على الهادي الشفيع المصدر","أحمد النور من نوره على الكون يزهر",26,"ر",1,0],["ثم صعدت زفرة","من لهيب وقلت من",27,"ن",1,0],["ثُمّ صَلاة اللَه بِالتَسليم","لِمَن رَقى أَسمى سَما التَعظيمِ",28,"م",1,0],["ثمَّ صارَت سنةً جارِيةً","كلّ مَن أمكَنَهُ الظُّلمُ ظَلَم",29,"م",1,0],["ثمَّ صارَ البَديعَ واس","تَوتَ اللامُ والألِف",30,"ف",1,0],["ثم صلاة الله","مع سلام الله",31,"ه",1,0],["ثم صلى فروضه بالشروط والأركان","ثم أدى زكاة المال من غير نقصان",32,"ن",1,0],["ثم صام المعظم كله شهر رمضان","ثم حج إذا هو ذو استطاعه وامكان",32,"ن",1,0],["ثم صلوا على الهادي الرسول","أحمد المصطفى زاكي العقول",33,"ل",1,0],["ثم صل وسلم دائما","ما سرى البرق أو مزن همي",33,"ي",1,0],["ثم صلاة الله مع سلام الله","على رسول الله الهادي المعصوم",34,"م",1,0],["ثم صلاة اللّه تترى على","خير الورى والآل أهل الكمال",35,"ل",1,0],["ثم صاروا ما بين داع إلى اللّ","ه وداع أشياخه ورجاله",36,"ل",2,0],["ثم صلاة اللّه تترى على ال","مختار والآل ومن يقتفي",37,"ف",2,0],["ثم صار البين أخبا","راً كما قد كان خبرا",38,"ر",2,0],["ثم صاغ الانسان خلقا سويّا","عاقلا ناطقا بصيراً سميعا",39,"ع",2,0],["ثم صدقت النبي المصطفى","بالذي جاء به يرشدنا",40,"ن",2,0],["ثم صرنا لسهام من ذوي ال","نفس والتدبير مثل الهدف",41,"ف",1,0],["ثُمَّ صَفُّوهُ كَالأَهِلَّةِ لاَحَتْ","لِمَوَاقِيْتِهَا حِيَالَ الشُّرُوقِ",42,"ق",1,0],["ثمَّ صلَّى بعدَ أنْ عفَّرَ وجهًا","بِفَمٍ مازَجَ بالأذكارِ تِبْرَا",43,"ر",2,0],["ثم صاحت به عدمتك حتى","لا أعاني شماتة الجمهور",44,"ر",1,0],["ثم صاحت به وألقت عليه","عظة كان وقعها مشكورا",45,"ر",2,0],["ثُمَّ صِلْني إِنّي اِصطَفَيتكَ حِبّاً","فيكَ غارَت عَلى هَوايَ الحِسانُ",46,"ن",1,0],["ثُمَّ صَلاة اللَهِ وَالسَلام","جودُهما يَصحَبهُ الدَوام",47,"م",1,0],["ثم صلاةِ اللهِ طولَ الأبدِ","على النبي المصطفى محمدِ",48,"د",1,0],["ثم صلاةُ اللهِ والسلامُ","ما مرَّت الليْلاتُ والأيامُ",48,"م",1,0],["ثم صلاة وسلامٌ على","محمدٍ ذو جاء بالبشرى",49,"ر",2,0],["ثم صلاة وسلامٌ على","محمدِ المختارِ خيرِ العباد",50,"د",1,0],["ثُمَّ صِرنا لِفُرقَةٍ ذاتِ بُعدٍ","كُلُّ حَيٍّ مَصيرُهُ لِفِراقِ",51,"ق",1,0],["ثم صفات ذاته المعاني","سبع فقط يعلمها المعاني",52,"ي",1,0],["ثم صار الناس كوفيينا","في ذلك الفن وبصريينا",53,"ن",2,0],["ثم صلاة الله ما تكلما","إمام فن مخلصاً وعلما",53,"م",2,0],["ثم صعدت نخلة لأهجعا","في رأسها من الأذى ممتنعا",54,"ع",2,0],["ثم صف ما لدي من عظم شوق","وشجون لم تبق مني بقيه",55,"ي",2,0],["ثم صلاة اللَّه والسلام","ما اختلف الضياء والظلام",56,"م",1,0],["ثم صارت تبكي وأضحك منها","وهي ترجو اغتصاب قلبي غصبا",57,"ب",2,0],["ثم صرنا إِلى النفاق فلا ها","مت غراماً وما تتيمت حبا",57,"ب",2,0],["ثم صلاته على خير الأمم","المصطفى المرفوع كالفرد العلم",58,"م",1,0],["ثم صلاة اللَه تترى أبداً","على النبي الهاشمي أحمدا",59,"د",2,0],["ثم صلاته على محمد","رسوله المكرم الممجد",60,"د",1,0],["ثم صاحت شقائق النعمان","مات فغرت أحزاني",61,"ي",1,0],["ثم صلاتي كل يوم وغدٍ","على السراج المستنير أحمد",62,"د",1,0],["ثم صلاة الله رَبّي أبدا","على شفيع الخلق أعني أحْمَدا",63,"د",2,0],["ثم صَلاةُ اللهِ بالسَّلامِ","على النَّبِيّ أفضلِ الأنامِ",64,"م",1,0],["ثم صينت بالأكف سوى","مقل تستخون الأمنا",65,"ن",2,0],["ثُمَّ صلاةُ اللَهِ دائمةٌ","ما كَتَمَ الصبُّ هواهُ وَصان",66,"ن",1,0],["ثم صيرت من دماء أعادي","ك خلوفي وكان منه طهوري",67,"ر",2,0],["ثم صلاة اللّه من بَعْدِهَا","أذكى سلامٍ عاطرٍ يُرْسَلُ",68,"ل",1,0],["ثُمَّ صَدِّق لا تَقُل هاتوا دَليلا","كُلّ هَذا مِنكَ قَولٌ لَيسَ يُجدي",69,"ي",1,0],["ثم صافحه على رغ","م النوى وافرك",70,"ك",1,0],["ثم صلوا على أحمد عدّ ما هبت النود","عدّ ما قمري غنا على طلح منضود",71,"د",1,0],["ثُم صَلاة اللَّهِ مَع سَلامه","ما لاحَ ضَوءُ البَرقِ في غَمامِه",72,"ه",1,0],["ثم صفات ذي العلى تعالى","أضدادها في حقه استحالا",73,"ل",2,0],["ثم صمتًا إذا انتهيتُ قليلاً","فسؤالاً ينسابُ من شفتَيْها",74,"ي",3,0],["ثُمَّ صَلاة اللَهِ تَغشى أَحمدا","محمد الهادي النَبِيِّ الأَوحَدا",75,"د",2,0],["ثم صدقت إذ رأيت مناما","فيه ذبح الغلام بالاحتساب",76,"ب",1,0],["ثم صلى بالانبيا أماما","وجميع الأملاك والحجاب",76,"ب",1,0],["ثُم صَلاة اللَه تَغشى الَّذي","سَماه في اللغز فخل العِناد",77,"د",1,0],["ثم صلاة ربنا طول المدا","على بنى دينه دين الهدى",78,"د",2,0],["ثُمَّ صَلِّ عَلَى رسولِك مَا قَدْ","حَنَّتِ النوقُ بالحُمول رِزاما",79,"م",2,0],["ثم صلاته مع السلام","على النبي سيد الأنام",80,"م",1,0],["ثم صلاة اللَه ذي الإحسان","على نبي جاء بالبرهان",81,"ن",1,0],["ثم صلاة اللَه والسلام","ما انشق فجروا سجي ظلام",81,"م",1,0],["ثم صلاة اللَه مقرونة","برحمة منه وأزكى سلام",82,"م",1,0],["ثم صعدنا بعده ديوانا","كاد يكون في البنا إيوانا",83,"ن",2,0],["ثم صان العهود بين البرايا","والمواثيق من جميع الصنوف",84,"ف",1,0],["ثُمَّ صَبُّوا عَلَيهِمُ حَملَةً حَسَّتهُمُ","وَاشتَدَّت بِهِم بَأسَاءُ",85,"ا",2,0],["ثم صلاته على محمدِ","إغاثة العباد في الشدائدِ",86,"د",1,0],["ثم صلاته على الذي يقولْ","مخُّ العبادة الدعاء فأقولْ",87,"ل",1,0],["ثم صلاتُه على الشفيعِ","شفيعِنا لربِّنا السميعِ",88,"ع",1,0],["ثُمَّ صَلاةَ اللّهِ بِالسَلامِ","مَوصولَة ما سَح مِن غَمام",89,"م",1,0],["ثم صدّوه عن رباه ومربا","ه فويل للعصبة الأشقياء",90,"ا",2,0],["ثم صلاةُ الله مع سلام","على رسول خاتمِ النبوه",91,"و",2,0],["ثم صلاة الله مع تسليمه","تغشى رسولاً قد هدانا سبلنا",92,"ن",2,0],["ثُم صاحَ الضَميرُ فيها نَذِيراً","فَأَصاخَت إِلى صِياح النَذيرِ",93,"ر",1,0],["ثم صغ لي من لئاليها وشاح","فعسى يذهب من عيني الأرض",94,"ض",1,0],["ثم صلاة متى ضَجَّ الحجيجُ على","خير الأنام بأصناف من النعمِ",95,"م",1,0],["ثم صلاةُ اللهِ ما جادَ الْحَيَا بوابلِ","على النبيِّ المصطفى وآلِهِ الأفاضلِ",96,"ل",1,0],["ثم صلاة الله ما غرَّدت","على أبي القاسم أطيار",97,"ر",1,0],["ثُمَّ صافحت أَنمُلاً نَشأت بَي","نَ صَريرِ الأَقلامِ وَالأَرماحِ",98,"ح",1,0],["ثم صدت عني دلالاً فأوهت","جلدي والزمان أبدى النحوسا",99,"س",2,0],["ثم صاح القضاء كونى فكانت","طينة البؤس شاعراً مثالا",100,"ل",2,0],["ثم صَلَّى اللهُ وسلَّم بِدءاً","وختاماً على شفيعِ الأنامِ",101,"م",1,0],["ثم صارت - هكذا - شرعيةً","بعدما قد وصفوها بالضلالْ",102,"ل",1,0],["ثم صلاة الله مشفوعة","بمسك تسليم لفضى ختام",103,"م",1,0],["ثم صدت عنه لتجبُر ما ها","ضَ وتبني كيانها مألوفا",104,"ف",2,0],["ثم صاح أميرهم علنا","من أخو ذا المنزل الفخم",105,"م",1,0],["ثُمَ صَلوا عَلى أَفضل مَن سَرى بِالبراق","أَحمَد الشافِعي المَقبول يَوم التَلاق",106,"ق",1,0],["ثم صل الله وتمم للرسول وتابعينه","له صلاةً وسلاماً عد من يكتب بنانه",107,"ن",2,0],["ثم صلى بهم خشوعاً مَجازاً","ثم ناداهمُ نداءً خفيّا",108,"ي",2,0],["ثم صافح أقيالها (آل صلت)","من ملوك (العتيك) في علياها",109,"ا",3,0],["ثم صاروا بعد العداوة والل","ه جميعاً في صورة الأولياء",110,"ا",2,0],["ثُمَّ صَبّوا عليْهِ سوْطَ عَذابٍ","دونَ ذنْبٍ حقْداً على الشُّرَفاءِ",111,"ا",2,0],["ثُّمَّ صرنا بغربةٍ ظَنَّنا الجا","هلُ فيها صيدًا فقام وثارا",112,"ر",2,0],["ثم صلوا وادخلوا زمزماً كي تمتلوا","وارحموا عبداً تلوا تظفروا بالحسنات",113,"ت",1,0],["ثم صلوا واحرموا ثم لبوا وقدموا","ضحوة بل يمموا مسجداً فيه الثقات",113,"ت",1,0],["ثم صلوا ثم ما كان من فرض كما","جاء من رب السما واعزموا فيها البيات",113,"ت",1,0],["ثم صلاة الله على رسول الله","والآل أهل الله دوما بلا تحديد",114,"د",1,0],["ثم صاغوا بسهام الحقد دستورا","بحبر الدين على ورق الهروب.",115,"ب",1,0],["ثُمَّ صَلَّى وَ سَلَّمَا","رَاجِيًا مَنْ بِهِ الرَّجَا",116,"ا",1,0],["ثُمَّ صُبِّي لِي فَجْرَ عَينَيكِ جَامًا","لِأَصُبَّ المَسَاءَ فَوقَكِ جَاما",117,"م",2,0],["ثمَّ صرتمْ كالخفافيشِ البغايا","يَسرقونَ النورَ من قبرِ الأميرِ",118,"ر",1,0],["ثُمَّ صِرْنَا بَعْدَ السُّروْرِ بُكَاءً","وأَنَاخَ السَّوَادُ والَّليْلُ جَنّا",119,"ن",2,0]]}