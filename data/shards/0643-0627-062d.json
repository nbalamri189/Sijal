{"poems":[[38,"ألم تسأل بعارمة الديارا","https://www.aldiwan.net/poem7721.html","الوافر"],[28,"أهاج لك الشوق القديم خياله","https://www.aldiwan.net/poem5604.html","الطويل"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[151,"صن النفس واصرفها عن اللهو","https://www.aldiwan.net/poem68584.html","الطويل"],[161,"إذا جادت الروض الحديث غمائمه","https://www.aldiwan.net/poem59001.html","الطويل"],[161,"أرخا أثيث الدجى الجاني على الفلق","https://www.aldiwan.net/poem59000.html","البسيط"],[205,"أغار عليه لست أملك وصله","https://www.aldiwan.net/poem53259.html","الطويل"],[321,"والورد في إزراره فوق الغصو","https://www.aldiwan.net/poem61791.html","الكامل"],[404,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"]],"verses":[["كَأَحقَبَ قارِحٍ بِذَواتِ خَيمٍ","رَأى ذُعراً بِرابِيَةٍ فَغارا",0,"ر",2,0],["كَأَحقَبَ شَحّاجٍ بِغَمرَةِ قارِبٍ","بِليتَيهِ آثارٌ ذَواتُ كُدومِ",1,"م",1,0],["كَأَحْرُفٍ أَشْكَلتْ خطاً فأكْثَرُها","بالطَّعْنِ والضَّرْبِ مَنْقُوطٌ ومَشكولُ",2,"ل",1,0],["كَأَحمَدَ لَم تُبصِر وَلا أَنتَ مُبصِر","مُعيناً عَلى التَقوى مُغيثاً مِنَ الهُلكِ",3,"ك",1,0],["كأحمد نعماه تسابق سيفه","فان فاتها بالسبق فهي مراهمه",4,"م",2,0],["كأحمد خصصت بالوبل ديمته","غير العدا والعدا بالبرق والصعق",5,"ق",1,0],["كأحمق لم يمكنه يدخل قريةً","فقال أنا دهقانها وأميرُها",6,"ه",2,0],["كَأَحِبّةٍ ضَمّوا المَباسِمَ وَاِنثَنوا","لِتَبادُلِ القُبُلاتِ في وَقتِ الشَمولِ",7,"ل",1,0],["كأحسن نجل إسحق ومن ذا","يساوي أحسنا في قطر سام",8,"م",1,0]]}