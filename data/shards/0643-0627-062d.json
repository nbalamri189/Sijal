{"poems":[[40,"ألم تسأل بعارمة الديارا","https://www.aldiwan.net/poem7721.html","الوافر"],[30,"أهاج لك الشوق القديم خياله","https://www.aldiwan.net/poem5604.html","الطويل"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[154,"صن النفس واصرفها عن اللهو","https://www.aldiwan.net/poem68584.html","الطويل"],[164,"إذا جادت الروض الحديث غمائمه","https://www.aldiwan.net/poem59001.html","الطويل"],[164,"أرخا أثيث الدجى الجاني على الفلق","https://www.aldiwan.net/poem59000.html","البسيط"],[208,"أغار عليه لست أملك وصله","https://www.aldiwan.net/poem53259.html","الطويل"],[325,"والورد في إزراره فوق الغصو","https://www.aldiwan.net/poem61791.html","الكامل"],[409,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67831","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96585","الطويل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198877","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62923","الرمل"],[3649,"","https://poetry.dctabudhabi.ae/diwan/poem/203520","السريع"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20945","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120498","الطويل"],[592,"ألا فذراني من جهول وغاشم","https://www.poetsgate.com/ViewPoem.aspx?id=128817",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""]],"verses":[["كَأَحقَبَ قارِحٍ بِذَواتِ خَيمٍ","رَأى ذُعراً بِرابِيَةٍ فَغارا",0,"ر",2,0],["كَأَحقَبَ شَحّاجٍ بِغَمرَةِ قارِبٍ","بِليتَيهِ آثارٌ ذَواتُ كُدومِ",1,"م",1,0],["كَأَحْرُفٍ أَشْكَلتْ خطاً فأكْثَرُها","بالطَّعْنِ والضَّرْبِ مَنْقُوطٌ ومَشكولُ",2,"ل",1,0],["كَأَحمَدَ لَم تُبصِر وَلا أَنتَ مُبصِر","مُعيناً عَلى التَقوى مُغيثاً مِنَ الهُلكِ",3,"ك",1,0],["كأحمد نعماه تسابق سيفه","فان فاتها بالسبق فهي مراهمه",4,"م",2,0],["كأحمد خصصت بالوبل ديمته","غير العدا والعدا بالبرق والصعق",5,"ق",1,0],["كأحمق لم يمكنه يدخل قريةً","فقال أنا دهقانها وأميرُها",6,"ه",2,0],["كَأَحِبّةٍ ضَمّوا المَباسِمَ وَاِنثَنوا","لِتَبادُلِ القُبُلاتِ في وَقتِ الشَمولِ",7,"ل",1,0],["كأحسن نجل إسحق ومن ذا","يساوي أحسنا في قطر سام",8,"م",1,0],["كَأَحْمَدَ لَمْ يُخْلَقْ وَلَمْ نَرَ مِثْلَهُ","نَبيٌّ لَهُ وَصْفُ السَّكِينَةِ وَالنُّسْكِ",9,"ك",1,0],["كأحقَبَ من وحشِ الغَمَيرِ بمتنِهِ","وليَتَيهِ من عضِّ الغِيار كدُومُ",10,"م",1,0],["كأحمد ما في الرسل هذا اعتقادنا","ولا شك هل في الشمس في الظهر من شك",11,"ك",1,0],["كاحتقارِ التُرب بَقرِفنَ الحَصى","كلُّ ما مرت عليهِ فهو ثارُ",12,"ر",1,0],["كأحمر الخال قليل الجدا","سقلالب تنميه إذ ما انتمى",13,"ا",1,0],["كَأَحقَبَ مَوشِيِّ القَوائِمِ لاحَهُ","بِرَوضَةِ مَعروفٍ لَيالٍ صَوارِدُ",14,"د",1,1],["كاحمد وهبي ذي البلاغة والحجا","له كلم فيها غنى عن مراضب",15,"ب",1,0],["كأحمد ذي التقوى ومالك ذي النهى","وكالشافعي وابن المديني وعاصم",16,"م",1,0],["كأحمد والحبر بن عباس قبله","مع العلماء الجلة السادة الغرر",17,"ر",1,0],["كأحمد والنعمان ثم مالك","كذاك الإمام الشافعي الذي نصر",17,"ر",1,0],["كأحمد وابن إدريس وهذا","كما قد قال مالك ذو المعالي",18,"ل",2,0],["كأحمد والنعمان والحبر مالك","وكا الشافعي وابن المبارك من سما",19,"م",2,0]]}