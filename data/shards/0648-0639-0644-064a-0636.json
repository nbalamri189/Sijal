{"poems":[[47,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[193,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[409,"قد عجزنا عن شكرنا لامتنانك","https://www.aldiwan.net/poem33402.html","الخفيف"],[409,"جادت على قبر الجلال","https://www.aldiwan.net/poem33476.html","مجزوء الكامل"],[457,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138285",""],[879,"","https://poetry.dctabudhabi.ae/diwan/poem/107039","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203793",""],[1920,"","https://poetry.dctabudhabi.ae/diwan/poem/200379","الكامل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110669","الكامل"],[2538,"","https://poetry.dctabudhabi.ae/diwan/poem/104497","الخفيف"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83240","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97077","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90972","الكامل"],[4859,"ضفاف الذكريات!","https://www.poetsgate.com/ViewPoem.aspx?id=195206",""],[5057,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=197233",""],[5092,"على ضفاف الحب","https://www.poetsgate.com/ViewPoem.aspx?id=139678",""],[5273,"سقط الوشاح","https://www.poetsgate.com/ViewPoem.aspx?id=178564",""],[5277,"تباريحٌ بغدادية..","https://www.poetsgate.com/ViewPoem.aspx?id=198463",""],[5542,"عندما يعزف الرصاص","https://www.poetsgate.com/ViewPoem.aspx?id=10187",""],[5736,"أرثي الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=208891",""],[5770,"سأزف للموتى بشارة","https://www.poetsgate.com/ViewPoem.aspx?id=178250",""],[5906,"ماذا بعد","https://www.poetsgate.com/ViewPoem.aspx?id=188226",""],[6019,"ذبولٌ يطوقُ زهرةَ عُمرك","https://www.poetsgate.com/ViewPoem.aspx?id=175268",""],[6032,"ما على الدهر عتب","https://www.poetsgate.com/ViewPoem.aspx?id=181506",""],[6131,"رسولُ الثَّرَى","https://www.poetsgate.com/ViewPoem.aspx?id=189281",""],[6131,"عَينايَ زرقاءُ اليَمامةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189287",""],[6328,"آمنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84422&r=&rc=20",""]],"verses":[["وَعَلى ضَعفِ جِسمِهِ تَفتِكُ القَط","رَةُ مِن فيهِ بِالشُجاعِ النَجيدِ",0,"د",1,0],["وَعَلَى ضَرِيحِكَ فَلْتُشَيَّدْ صُورَةٌ","مِنْ مَرْمَرٍ صَافٍ لِتِلْكَ الكَاعِبِ",1,"ب",1,0],["وَعَلى ضَعفي إِذا صال العدا","جاهُكَ الأعظمُ أَقوى عددي",2,"ي",1,0],["وعلى ضعفهما فأنت حريص","في بقاها ستراً على جثمانك",3,"ك",1,0],["وعلى ضريح قد حوا","ه تحية من ذي الجلال",4,"ل",1,0],["وعلى ضرب زَلْزَلٍ كان برصو","ما لديه مواصلاّ مزماره",5,"ر",2,0],["وعلى ضفاف النيل يبقى دائما","اسم الديوك بكل فضل يذكر",6,"ر",1,0],["وعلى ضريح قد ألم برمسه","سحب الرضا تهمي بسح غمائم",7,"م",1,0],["وعلى ضفاف الرافدي","ن زئير ليث في حديد",8,"د",1,0],["وعلى ضفاف جراحنا مرّ الأسى","العمر نهر والجراح ضفافُ",9,"ف",1,0],["وعلى ضريح قد ألم برمسه","سحب الرضا تهمي عليه سجالها",10,"ل",3,0],["وعلى ضفتيه أثل ورند","ومن البان كل غصن وريق",11,"ق",1,0],["وَعَلى ضِفافِ النَهرِ ذا مُتَنَزَّهٌ","قَد عانَقَ الرَيحانُ فيهِ السَوسَنا",12,"ن",2,0],["وعلى ضمير حاز علم","المصطفى تعدو الضوامر",13,"ر",1,0],["وعلى ضريح فيه لحدك ما سرى","ريح الصبا سحرا وما الغيث انهمر",14,"ر",1,0],["وعلى ضفافِ الذكرياتِ ترونني","أحيا وطيف الراحلينَ أسامرُ!",15,"ر",1,0],["وعلى ضِفافِ اليأسِ تبرزُ غادَةٌ","حُفِظت بها للعاشِقينَ عهودُ",16,"د",1,0],["وعلى ضفافِ الحبِّ أزرعُ جنتي","وأسيرُ وحديَ كي أفارقَ وحدتي!!",17,"ت",2,1],["وعلى ضِفافِ الجيدِ تُوقِفُني","نَفَحاتُ عِطْرٍ بَثَّها الحَبَقُ",18,"ق",1,0],["وعلى ضفافِ (الكرخِ)طافتْ نسمةٌ","نديانةٌ كشقائقِ النعمانِ",19,"ن",1,0],["وعلى ضفاف النهر جثة زورق","يبكي على أشلائها الصياد",20,"د",1,0],["وعلى ضفافِ فجيعتي قيدَ المنى","حلمٌ يطوفُ بخاطري وقَّادُ",21,"د",1,0],["وعلى ضفاف النيل زِيحت ظُلمةٌ وهوت ستارة","وتوهج الصبحُ البديع وشعَ من ألقٍ نُضاره",22,"ر",2,0],["وعلى ضفاف النيل جل دمائهم","أروت ثراه جماعة الإخوان",23,"ن",1,0],["وعلى ضفافِ القبرِ ألفُ مُشَيِّعٍ","في اللَّحدِ وجدَاً مدَّدوهُ بطولِهِ",24,"ل",2,0],["وعلى ضفة هاتيك المنى","يرسم الأحلام ليل وصخبْ",25,"ب",1,0],["وعلى ضِفافِ البيتِ أخرجَ قلبَهُ","فَتحَ الشَّغافَ رَهَافَةً كالأنبياءْ",26,"ا",2,0],["وَ علَى ضفافِ الكَونِ تُزهِرُ أحرفِي","حلْمًا إذا انْبَلجَ الصباحُ وأسفَرَا",27,"ر",2,0],["وعلى ضفّةِ الفؤادِ وروداً","ترتوي من شِغافهِ والدماء ِ",28,"ا",2,0]]}