{"poems":[[55,"ما أسرع الأيام في طينا","https://www.aldiwan.net/poem29723.html","السريع"],[68,"لو أفادتنا العزائم حالا","https://www.aldiwan.net/poem40128.html","المديد"],[108,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[102,"شاعر الكأس والرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=50185",""],[215,"أين قلبي وأين آثار قلبي","https://www.aldiwan.net/poem46575.html","الخفيف"],[406,"العصفورة الراحلة","https://www.aldiwan.net/poem6783.html","عموديه"]],"verses":[["كَيفَ دِفاعُ المَرءِ أَحداثَها","فَرداً وَأَقرانُ اللَيالي ثِنى",0,"ن",2,0],["كَيفَ دَكَّت طودَ حِلمٍ نَداهُ","سَبَقَ الوَعدَ وَأَفنى السُؤالا",1,"ل",2,0],["كيف دانتِ لدولةِ الفرس مصرٌ؟","كيف دانت لعاهل اليونان؟",2,"ن",1,0],["كيف دانت لك الهضابُ العواتي؟","كيف لانت صلابةُ الصَّوان؟",2,"ن",1,0],["كيف دين الإله ظلوم","يتحدّى الإله والإنسانا ؟",3,"ن",2,0],["كيف دارت بك الليالي فتمسى","بعد نور الوفاء نار العقوق",4,"ق",1,0],["كيف دحرجتِ صخور اليأس","حتى سُدَّ دربي",5,"ب",2,0]]}