["وقابَلَ بالحُسْنى إساءَةَ مُجْرِمٍ","فودَّ بَريءُ القَومِ أنّ لهُ ذَنْبا",0,"ب",2,0],["وقابَلْتُ بالشّكْرِ منْها الصّنيعَ","وحاشا لمِثْليَ أن يُثْقِلا",1,"ل",2,0],["وقابَلَنا بالبِشْرِ واحْتَفَلَ القِرى","فلمْ يبْقَ لحْمٌ لم ننَلْهُ ولا زُبْدُ",2,"د",1,0],["وقابِلْ صَنيعَ اللّهِ فيكَ بشُكْرِهِ","وراقِبْهُ حالَ السِّرِّ والجَهْرِ تُحْمَدِ",3,"د",1,0],["وَقابَلَها الريحُ في دَنِّها","وَصَلّى عَلى دَنِّها وَاِرتَسَم",4,"م",1,0],["وَقابَلَنا فيهِ نَسيمُ البَنَفسَجِ","وَلاحَ لَنا وَردٌ كَخَدٍّ مُضَرَّجِ",5,"ج",1,0],["وَقابوسَ أَعضَضنا الحَديدَ اِبنَ مُنذِرٍ","وَحَسّانَ إِذ لا يَدفَعُ الذُلَّ مَدفَعا",6,"ع",2,0],["وقابل أسرار الملوك بصدره","وأورد عنهم باليراع وأصدرا",7,"ر",2,0],["وقابلتها غرّ الوجوه كثيرة","جرت بحروفٍ قد صرَعنَ حرافي",8,"ف",2,0],["وقابلنا بدور في غصونٍ","طوالع فاجْتلينا واجْتنينا",9,"ن",2,0],["وَقابَلَني رُمّانَتا غُصنِ بانَةٍ","يَميلُ بِهِ بَدرٌ وَيُمسِكُهُ حِقفُ",10,"ف",1,0],["وَقابَلَهُ بَدرُ السَماءِ بِوَجهِهِ","فَبَدرٌ عَلى بَدرٍ وَبَحرٌ عَلى بَحرِ",11,"ر",1,0],["وَقابِلٌ يَتَغَنّى كُلَّما قَدَرَت","عَلى العَراقي يَداهُ قائِماً دَفَقا",12,"ق",2,0],["وَقابِل مِنهُمُ بِجَزيلِ شُكرٍ","لَدَيكَ وَمَنعَهُم بِجَميلِ عُذرِ",13,"ر",1,0],["وَقابَلَت نورَ الضُحى أَوجُهٌ","لِلغيدِ تَبغي في الصَباحِ اِصطِباح",14,"ح",1,0],["وقابلتُ منها كلّ معنىً بِعدّهِ","يلوّحُ نفسَ الوهم في دُهمةِ النقْسِ",15,"س",1,0],["وقابلَني حينَ قبَّلْتُهُ","منَ الطيبِ ما أرخصَ الغاليَهْ",16,"ي",2,0],["وَقابَلَتِ الكاسُ وَجهَ الرَبيعِ","وَسَجعَ الحَمامِ فَما أَجمَلا",17,"ل",2,0],["وَقابَلَ الشَمسَ فيهِ بَدرُ دُجىً","يَأخُذُ مِن نورِها وَيَمتارُ",18,"ر",1,0],["وَقابَلَتِ النَسيمَ وَقَد تَعَرَّت","بِمُعتَدِلٍ أَرَقَّ مِنَ الهَواءِ",19,"ا",2,0],["وِقابُ أَسماعِنا جاءَت بِمَنفعَةٍ","وَما أَتَتنا بِشَيءٍ يُحمَدُ السُرَرُ",20,"ر",1,0],["وَقَابِلْ صَنِيعَ اللهِ بِالشُّكْرِ وَاسْتَزِدْ","مِنَ اللهِ صُنعاً تُسْتَهلُّ سَحَائِبُهْ",21,"ب",2,0],["وَقابل جَوابي بِالقُبول تَفَضُلاً","وَسامح فَإِن الفَضل لِلمُتَقدم",22,"م",1,0],["وقابل من العيد السعيدِ مواسماً","وقوِّ عهودَ الإئتناسِ وجددِ",23,"د",1,0],["وقابل برضوان وما أنت أهله","وبالفضل لا بالعدل وأمنن بجنة",24,"ه",1,0],["وقابله بالفضل الذي أنت أهله","وبالجود والمن بالذي ماله عد",25,"د",1,0],["وَقابَلوهُ بِكُفرانٍ لِنِعمَتِهِ","وَكانَ خَيراً مِنَ الكُفرَانِ لَو شَكَرُوا",26,"ر",3,0],["وَقابِل بِهِ كَيدَ العَدُوِّ وَصِل بِهِ","جَناحَكَ واِجعَلهُ لِعَلياكَ حائِلا",27,"ل",2,0],["وَقابلَ هَذا الدَهرَ بِالحِلم فَاِنثَنى","عَلَيهِ بِطَبعٍ بِالسَفاهةِ مُولَعِ",28,"ع",1,0],["وقاب قوسين من رب السماء دنا","ونال ما لا اليه غيره يصل",29,"ل",1,0],["وقابل ينثر الدر نظم عقودها","عسى منك تلقى في المقابلة الجبرا",30,"ر",2,0],["وَقابَلَته في الجِنان العُلا","مَلائِكٌ لِلَّهِ في شَكلهِ",31,"ل",2,0],["وَقابَلته بِقَريضٍ لها","من زَهرِها المَنظومِ وَالوَردِ",32,"د",1,0],["وقابلتْكَ الليالي وهي لَيِّنة","نواعمٌ لا تشوب الصفَو بالكَدَر",33,"ر",1,0],["وقابل نجمَك الإسعادُ فيه","وشدّ بقاءَ نُعماك المزيد",34,"د",1,0],["وَقابَلنَ سُقمي بِالخُصورِ الَّتي وَهَت","مَعاقِدُها وَأَدمُعي بِالمَباسِمِ",35,"م",1,0],["وَقابل الغصنَ غُصنٌ مثله وَشَدت","أَقمارُها فأَجابتها قَماريها",36,"ي",3,0],["وقابَلنا اللَّهيبَ بها فلاحت","لنا ناراً فحَيَّينا المجُوسا",37,"س",2,0],["وقابَلني الصّباحُ كمشتهاةٍ","رَنت وتبسّمت لفتى ودود",38,"د",1,0],["وقابلتك لطايف اللَ","ه الواحد الماجد الودود",39,"د",1,0],["وقابل هدايا الصحب بالبشر والرضا","ولو كان شيأ لا يسام بأثمان",40,"ن",1,0],["وَقابلنا بِقهقهةٍ ووجهٍ","مُراق الماءِ مسودّ الإهابِ",41,"ب",1,0],["وقابلت فيه صفاء الشمال","بصفو الشمول وشجو النغم",42,"م",1,0],["وَقابِل مَولاهُ فَقوبِلَ بِالرِضا","وَأَصبَحَ في الفِردَوسِ في مَسكَنٍ عالي",43,"ل",2,0],["وَقابِلِ العامَ أَرخِ","هَذا قِرانَ مُبارَكَ",44,"ك",1,0],["وقابل مجهول","تطويه أكفانه",45,"ه",1,0],["وَقابلٌ مِنكَ تاريخ اِنقِراض بَني","أُميّة لِزَوال البَغي قَد قَبلا",46,"ل",2,0],["وَقابل وَجه البَدر مِنهُ بصورة","لَنا اِنعكست أَنوارها مِن صقيلهِ",47,"ل",2,0],["وقابل ببشر حين تلمحُ ناظراً","عدوَّك ذا وجهٍ يَهِلُّ ضياؤه",48,"ا",3,0],["وقابل التوب ممن تاب قبل الأفول","ومبتدى بالعطايا يا الجم من غير حول",49,"ل",1,0],["وقابِلْه بالصَّفْح الجميلِ فَقَدْ أَتى","إليك أسيراً لِلضَّراعةِ والذلّ",50,"ل",1,0],["وقابلك الإِقبال بالسعد كله","وعاد الذي عاداك بالعكس والطرد",51,"د",1,0],["وَقابَلَني البَدرُ من وَجهِهِ","وَناطقني مصقع هبرَزيِّ",52,"ي",1,0],["وَقابل فيهِ السَعدُ وَاليمن وَالرِضا","وَكل الَّذي تَرجوه سَهلٌ مُيَسَّرُ",53,"ر",1,0],["وقابلتك المعالي وهي باسمةٌ","تميس بالعز مثل الشارب النهمِ",54,"م",1,0],["وقابلَ منِّي بارعاً في مقالِةِ","بمَنْ لَمْ يَزَلْ في فِعْلِهِ مُتَبَرِّعا",55,"ع",2,0],["وقابَلَني بالأَهْلِ والمالِ عِنْدَما","تركتُ إِليهِ الأَهْلَ والمالَ أَجمعا",55,"ع",2,0],["وقابل سؤالي بالجواب فإنني","غدوت بقلب في جوانحهِ جمر",56,"ر",1,0],["وقابلت أدمُعي فبمن كفت به","يوم التفرّق والتوديع نيراني",57,"ن",2,0],["وقابَلْتُمُ دُونَنا المُعتَدِينَ","ونحنُ بأَسوارِكُمْ عائِذُونا",58,"ن",2,0],["وقابَلَتْها اللُّهى فِي كَفِّ باذِلِها","وحوزَةُ الملكِ فِي أَكنافِ مانِعِها",59,"ع",3,0],["وقابَلَ المجدَ والإِعظَامَ فِي مَلِكٍ","بالسعدِ مُسْتَقْبَلٍ للسعدِ مُقْتَبِلِ",60,"ل",1,0],["وقابَلَهُ النصرُ الَّذِي لَكَ صَفوُهُ","مع السَّعدِ حَتَّى احتازَهُ لَكَ مَغْنَما",61,"م",2,0],["وقابَلَ الدينَ والإِسلامَ فِي شِيَمٍ","فِي عفوِها من مُنى الإِسلامِ مَا سَالُوا",62,"ل",3,0],["وقابل ثائي بالقبول وأجزني","جزا ابن زهير إذ أتى بالثنا كعب",63,"ب",1,0],["وقابل ثناها بالقبول فإنها","عرائس فكر والقبول يقودها",64,"د",3,0],["وقابلت بالعصيان وجهك خلقي","كأني مظلومٌ وإني لظالم",65,"م",1,0],["وقابلَ مسعاة الهمامِ محمدٍ","بكلِّ جميلٍ مونِق يُستدامُه",66,"م",2,0],["وقابلِ الصومَ أبلجَ الوجه جذ","لانَ وعيِّدْ مؤيَّداً وصُمِ",67,"م",1,0],["وَقابَلَ المَرّيخَ في الأُفقِ زُحَل","كَأَنَّهُ شِهابُ نارٍ تَشتَعِل",68,"ل",1,0],["وقابل المسيء بالإحسان","واستر عوارات لهذا الجاني",69,"ي",1,0],["وَقابَلَنا مِن وَجهِهِ وَشَرابِهِ","بِشَمسَينِ في جُنحى دُجى اللَيلِ وَالشَعرِ",70,"ر",1,0],["وَقابَلَ العيدَ مِنهُ حينَ قابَلَهُ","مِن ملكِهِ كُلَّ يَومٍ مِنهُ في عيدِ",71,"د",1,0],["وقابله الملك الهمام بعزمة","غدا قاعداً عن مجدها كل قائم",72,"م",1,0],["وَقابِلَ الْمَتابِ","ورَافِعَ الْعِقابِ",73,"ب",1,0],["وقابَلتُ كلاًّ منهُمُ بِبشَاشةٍ","تُبرهنُ أنَّ الود لا يتفَرَّدُ"