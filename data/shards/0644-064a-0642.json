{"poems":[[53,"أراقب من طيف الحبيب وصالا","https://www.aldiwan.net/poem29899.html","الطويل"],[63,"لويت على الرمح الرديني معصما","https://www.aldiwan.net/poem46086.html","الطويل"],[4,"أنبئت أن أبا حنيف","https://www.aldiwan.net/poem21209.html","مجزوء الكامل"],[72,"في دعة الله سر وعد في","https://www.aldiwan.net/poem18731.html","مخلع البسيط"],[72,"لي قلم بين دجى خطه","https://www.aldiwan.net/poem20077.html","السريع"],[64,"فيك معنى يدعو النفوس إليكا","https://www.aldiwan.net/poem67588.html","الخفيف"],[51,"مطايب عيش زايلته مخابثه","https://www.aldiwan.net/poem9226.html","الطويل"],[51,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[91,"لي بعل ظنه الناس أبي","https://www.aldiwan.net/poem8743.html","عموديه"],[78,"غلب الكرى ودنت مطايا الراح","https://www.aldiwan.net/poem14045.html","الكامل"],[85,"جئننا بالشعور والأحداق","https://www.aldiwan.net/poem63027.html","الخفيف"],[45,"ما أنت للكلف المشوق بصاحب","https://www.aldiwan.net/poem10671.html","الكامل"],[45,"إن الأمير أبا علي أصبحت","https://www.aldiwan.net/poem65628.html","الكامل"],[28,"ألم تذكروا يا آل مروان نعمة","https://www.aldiwan.net/poem5500.html","الطويل"],[80,"لي قلب من جلمد الصخر أقسى","https://www.aldiwan.net/poem31374.html","الخفيف"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[75,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39650","الخفيف"],[90,"الى الخاتون المسبل","https://www.poetsgate.com/ViewPoem.aspx?id=179039",""],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""]],"verses":[["لِيَقرِيَ أَسماعَ الرِجالِ فَصاحَةً","وَيورِدُ أَفهامَ العُقولِ زُلالا",0,"ل",2,0],["لِيَقْصِدْ مُسِرُّ الضِّغْنِ فينا بِذَرْعِهِ","وَلا يَسْتَثِرْ مِنا بِوادِيهِ ضَيْغَما",1,"م",2,0],["لِيَقينَ وَجهَ المَرءِ سَف","سافَ التُرابِ وَلَن يَقينا",2,"ن",2,0],["لي قصة والسؤال سكني","بيتٍ ويحتاج للعبارَه",3,"ر",2,0],["لي قلمٌ بين دجى خطّه","يبيت ذا رَقْصٍ وذا زحمَه",4,"ه",1,1],["لِيَ قَلبٌ لَهُ إِلَيكَ عُيونٌ","ناظِراتٌ وَكُلُّهُ في يَدَيكا",5,"ك",2,0],["ليقْصُرْ عليه اليوم في ظلّ غِبطةٍ","ولا يَقْصُرِ العمرُ الذي هو لابثُهْ",6,"ث",2,0],["لِيَقُلْ عُفَاتُكَ لا جُنَاح عليهمُ","رَفِعَ الجُنَاحُ فلاتَ حينَ جُنَاحِ",7,"ح",1,0],["ليقلْ فيه مادحٌ فالعطايا","والمنايا هناك في أشهادِهْ",8,"د",2,0],["لِيَ قَدٌّ وَجَمالٌ يَزدَري","ذاكَ بِالغُصنِ وَذا بِالكَوكَبِ",9,"ب",1,0],["لِيُقيمَ ذاكَ العودُ مِن رَسم السُرى","وَيَعودَ في الأَجسام بالأَرواحِ",10,"ح",1,0],["لي قَوافٍ تَعِفُّ في الحُبِّ إِلّا","عَنكِ سارَت جَوائِبَ الآفاقِ",11,"ق",1,0],["لَيُقَصِّرَنَّ لَجاجَ شَوقٍ غالِبٍ","وَليَقصُرَنَّ لَجاجُ دَمعٍ ساكِبِ",12,"ب",1,0],["لِيُقَوِّمَ المُعوَجَّ مِن تَدبيرِها","وَيُعيدَ مُدبِرَ كُلِّ أَمرٍ مُقبِلا",13,"ل",2,0],["لِيَقتَطِعَن حَرفَي لِساني الَّذي بِهِ","لِخِندِفَ أَرمي عَنهُمُ مَن تَكَلَّما",14,"م",2,0],["ليَ قلبٌ من جَلمَدِ الصّخرِ أقسى","وهو من رِقّةِ النّسيمِ أرَقُّ",15,"ق",1,1],["لِيَقْضِيَ اللهُ أمْراً كانَ قَدَّرَهُ","وكُلُّ ما قَدَّرَ الرَّحْمنُ مفعُولُ",16,"ل",1,0],["لِيَقِرَّ تحتكَ عودُ منبرِهِ الذّي","لا يستقِرُّ تحسُّراً وتلهُّفَا",17,"ف",2,0],["ليَ قلبٌ كزهرةِ الحقل بيضا","ءَ نَمَتْها السماءُ من كلِّ قبْسِ",18,"س",1,0],["لي قيلةٌ تلقى عليك بمسمعٍ","وبمحضرٍ من زمرةِ السواس",19,"س",1,0],["لي قلبٌ لو جاز نسيانهُ صدريَ","يوماً لجازَ أنْ ينساك",20,"ك",1,0]]}