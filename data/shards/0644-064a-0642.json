{"poems":[[53,"أراقب من طيف الحبيب وصالا","https://www.aldiwan.net/poem29899.html","الطويل"],[63,"لويت على الرمح الرديني معصما","https://www.aldiwan.net/poem46086.html","الطويل"],[4,"أنبئت أن أبا حنيف","https://www.aldiwan.net/poem21209.html","مجزوء الكامل"],[72,"في دعة الله سر وعد في","https://www.aldiwan.net/poem18731.html","مخلع البسيط"],[72,"لي قلم بين دجى خطه","https://www.aldiwan.net/poem20077.html","السريع"],[64,"فيك معنى يدعو النفوس إليكا","https://www.aldiwan.net/poem67588.html","الخفيف"],[51,"مطايب عيش زايلته مخابثه","https://www.aldiwan.net/poem9226.html","الطويل"],[51,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[91,"لي بعل ظنه الناس أبي","https://www.aldiwan.net/poem8743.html","عموديه"],[78,"غلب الكرى ودنت مطايا الراح","https://www.aldiwan.net/poem14045.html","الكامل"],[85,"جئننا بالشعور والأحداق","https://www.aldiwan.net/poem63027.html","الخفيف"],[45,"ما أنت للكلف المشوق بصاحب","https://www.aldiwan.net/poem10671.html","الكامل"],[45,"إن الأمير أبا علي أصبحت","https://www.aldiwan.net/poem65628.html","الكامل"],[28,"ألم تذكروا يا آل مروان نعمة","https://www.aldiwan.net/poem5500.html","الطويل"],[80,"لي قلب من جلمد الصخر أقسى","https://www.aldiwan.net/poem31374.html","الخفيف"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[75,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39650","الخفيف"],[90,"الى الخاتون المسبل","https://www.poetsgate.com/ViewPoem.aspx?id=179039",""],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[109,"سائق الظعن بالحدوج تأنى","https://www.aldiwan.net/poem16294.html","الخفيف"],[115,"لي قلب قد قلبته على الجم","https://www.aldiwan.net/poem40867.html","عموديه"],[115,"لي قلب على المحبة قد شب","https://www.aldiwan.net/poem40874.html","عموديه"],[115,"صلى الآله على أبي الزهراء","https://www.aldiwan.net/poem41474.html","عموديه"],[147,"خليلي لا تجزع من الجوع إنه","https://www.aldiwan.net/poem47654.html","الطويل"],[160,"لو يستطيع تخطي الأيام","https://www.aldiwan.net/poem58849.html","الطويل"],[186,"ذهب الشباب وطيبه","https://www.aldiwan.net/poem43623.html","مجزوء الكامل"],[198,"سفرت وريعان التبلج مسفر","https://www.aldiwan.net/poem51949.html","الكامل"],[211,"مضت أسابيع والهتاف محتجب","https://www.aldiwan.net/poem46764.html","البسيط"],[221,"كم في سبيل الأماني","https://www.aldiwan.net/poem55304.html","المجتث"],[223,"سمعتني أقول شعرا شقيا","https://www.aldiwan.net/poem41592.html","الخفيف"],[229,"لو تقصيت وصف شوقي وتوقي","https://www.aldiwan.net/poem50809.html","الخفيف"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[297,"ليقعد الدهر بي ما شاء وليقم","https://www.aldiwan.net/poem33170.html","البسيط"],[328,"هتف البحر بالعذارى فلبين","https://www.aldiwan.net/poem54984.html","الخفيف"],[328,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[364,"صيرت خوزستان حربا قائما","https://www.aldiwan.net/poem60610.html","الكامل"],[371,"تعود أن يحول وأن يخونا","https://www.aldiwan.net/poem57082.html","الوافر"],[371,"من لطول الهم والحزن","https://www.aldiwan.net/poem57098.html","المديد"],[405,"أبلغ مقالي كل عاف مجتدي","https://www.aldiwan.net/poem49603.html","الكامل"],[432,"سائل لوى خبت فذاك لواؤه","https://www.aldiwan.net/poem12550.html","الكامل"],[432,"عارض الصفح في يديك الصفاحا","https://www.aldiwan.net/poem12583.html","الخفيف"],[439,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[453,"لي قلة في الأصدقاء حسبتهم","https://www.aldiwan.net/poem61268.html","الكامل"],[464,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[500,"بين الكتائب والكثبان جلجلة","https://www.aldiwan.net/poem37780.html","البسيط"],[500,"لي قلب في الحب مضنى عليل","https://www.aldiwan.net/poem37927.html","الخفيف"],[515,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[515,"خفة الروح واجتناب الثقاله","https://www.aldiwan.net/poem12198.html","الخفيف"],[558,"قلوبنا بك أبلتها النوى كمدا","https://www.aldiwan.net/poem34643.html","البسيط"],[558,"لي قصر عالي نصبتو من خشب كالبرج","https://www.aldiwan.net/poem34685.html","المواليا"],[575,"أنت الأخير هوى وأنت الأول","https://www.aldiwan.net/poem2891.html","الكامل"]],"verses":[["لِيَقرِيَ أَسماعَ الرِجالِ فَصاحَةً","وَيورِدُ أَفهامَ العُقولِ زُلالا",0,"ل",2,0],["لِيَقْصِدْ مُسِرُّ الضِّغْنِ فينا بِذَرْعِهِ","وَلا يَسْتَثِرْ مِنا بِوادِيهِ ضَيْغَما",1,"م",2,0],["لِيَقينَ وَجهَ المَرءِ سَف","سافَ التُرابِ وَلَن يَقينا",2,"ن",2,0],["لي قصة والسؤال سكني","بيتٍ ويحتاج للعبارَه",3,"ر",2,0],["لي قلمٌ بين دجى خطّه","يبيت ذا رَقْصٍ وذا زحمَه",4,"ه",1,1],["لِيَ قَلبٌ لَهُ إِلَيكَ عُيونٌ","ناظِراتٌ وَكُلُّهُ في يَدَيكا",5,"ك",2,0],["ليقْصُرْ عليه اليوم في ظلّ غِبطةٍ","ولا يَقْصُرِ العمرُ الذي هو لابثُهْ",6,"ث",2,0],["لِيَقُلْ عُفَاتُكَ لا جُنَاح عليهمُ","رَفِعَ الجُنَاحُ فلاتَ حينَ جُنَاحِ",7,"ح",1,0],["ليقلْ فيه مادحٌ فالعطايا","والمنايا هناك في أشهادِهْ",8,"د",2,0],["لِيَ قَدٌّ وَجَمالٌ يَزدَري","ذاكَ بِالغُصنِ وَذا بِالكَوكَبِ",9,"ب",1,0],["لِيُقيمَ ذاكَ العودُ مِن رَسم السُرى","وَيَعودَ في الأَجسام بالأَرواحِ",10,"ح",1,0],["لي قَوافٍ تَعِفُّ في الحُبِّ إِلّا","عَنكِ سارَت جَوائِبَ الآفاقِ",11,"ق",1,0],["لَيُقَصِّرَنَّ لَجاجَ شَوقٍ غالِبٍ","وَليَقصُرَنَّ لَجاجُ دَمعٍ ساكِبِ",12,"ب",1,0],["لِيُقَوِّمَ المُعوَجَّ مِن تَدبيرِها","وَيُعيدَ مُدبِرَ كُلِّ أَمرٍ مُقبِلا",13,"ل",2,0],["لِيَقتَطِعَن حَرفَي لِساني الَّذي بِهِ","لِخِندِفَ أَرمي عَنهُمُ مَن تَكَلَّما",14,"م",2,0],["ليَ قلبٌ من جَلمَدِ الصّخرِ أقسى","وهو من رِقّةِ النّسيمِ أرَقُّ",15,"ق",1,1],["لِيَقْضِيَ اللهُ أمْراً كانَ قَدَّرَهُ","وكُلُّ ما قَدَّرَ الرَّحْمنُ مفعُولُ",16,"ل",1,0],["لِيَقِرَّ تحتكَ عودُ منبرِهِ الذّي","لا يستقِرُّ تحسُّراً وتلهُّفَا",17,"ف",2,0],["ليَ قلبٌ كزهرةِ الحقل بيضا","ءَ نَمَتْها السماءُ من كلِّ قبْسِ",18,"س",1,0],["لي قيلةٌ تلقى عليك بمسمعٍ","وبمحضرٍ من زمرةِ السواس",19,"س",1,0],["لي قلبٌ لو جاز نسيانهُ صدريَ","يوماً لجازَ أنْ ينساك",20,"ك",1,0],["لِيَ قَلبٌ لَديك أَقرب شَيء","وَخُلوص إِذا تَباعَدت عَنا",21,"ن",2,0],["لي قلب قد قلبته على الجم","ر الليالي لما به من هواكا",22,"ك",2,1],["لي قلب على المحبة قد شب","وجمرها لعمره لهوى شب",23,"ب",1,1],["ليقال صان حمى بنية محمد","وتقر عيني فيك يا مولائي",24,"ا",2,0],["ليقضي الذي قد فات إذ كان واجباً","وفي الشرع تقضى كل فائتة قسرا",25,"ر",2,0],["ليقرَّ عيناً بالتملي مدةً","بأعز سلطان وخير إمامِ",26,"م",1,0],["ليقال شيخٌ صالحٌ","لا قادعا متواتغا",27,"غ",2,0],["ليقوِّمَنَّ صَغا الحوادثِ منْ بني","عبد العزيزِ بها وسيم أَزْهَرُ",28,"ر",1,0],["ليقض ما شاء في أمرى فسوف يرى","أني لروضح نعم القاطف الجاني",29,"ي",1,0],["لي قبل هذا أمان","والآن مالي أماني",30,"ي",1,0],["لِيَ قَلب أَفرَغته فَاِترُكيهِ","في الهَوى فارِغاً وَلا تَملَأيه",31,"ه",1,0],["ليَ قلبٌ أَمضَى من الدّهر في الده","ر إذا كَعَّت القلوبَ الطَّغامُ",32,"م",1,0],["ليقصدوا وِفادَتَه","وَيَغنَموا عيادَتَه",33,"ه",1,0],["ليقتُلَ الذُبابَه","من غير ما إِرابَه",33,"ه",1,0],["ليقعد الدَّهرُ بي ما شاءَ وليَقُم","لَيسَ التَضاؤل للأَهوال من شيمي",34,"م",2,1],["لي قلب أخشى الهوان عليه","وإباءٌ حماه قلبي وصانه",35,"ن",2,0],["لي قلب يزين البؤس للنا","س ويرجو لو كان أبأسَ حالا",36,"ل",2,0],["ليُقطِّعَنَّ قفاكَ سَوْطُ عَذابِه","وتُقاسيَنَّ عقابَه ألوانا",37,"ن",2,0],["ليَقطعني لقد أسرَفتِ حتَّى","حُداتُكِ بالعَداوةِ يَقصِدونا",38,"ن",2,0],["ليُقاسِي ناظِري كَمَداً","لم يَكن لَولاهُ يكمِدُني",39,"ي",1,0],["لِيُقيمَ كُلَّ مُؤدَّدٍ ويُنيمَ كُلَّ","مُسَهَّدٍ ويَضمَّ كُلَّ مَبَدَّدِ",40,"د",1,0],["ليقُل بُناةُ الشعر فيك فإنما","أوصافُ مجدك صحةٌ أسماؤه",41,"ا",3,0],["ليقِفْ دونَك المُلوكُ فما تبْ","لُغُ في الرُتبةِ الصّريحِ الصراحا",42,"ح",2,0],["ليَقْسِمَ لي سهمَ حمدي وشكري","وينزِعَ سهم الأَسى من فُؤادي",43,"ي",1,0],["ليقتادَني بِيَدِ الإِصْطِناعِ","ويخلَعَ من يَدِ دهرِي قِيادِي",43,"ي",1,0],["لي قلة في الأصدقاء حسبتهم","فوق الجواهر للبخيل المعدم",44,"م",1,1],["ليقم مقامك في الفصاحة والنَّدى","من ظنّ إدراك المعالي هينا",45,"ن",2,0],["لي قِسمَةٌ في طِيني مُخَمَّرَةٌ","والحاصِلاتُ لَعَمْري كلُّها قِسَمُ",46,"م",1,0],["لي قلبٌ في الحُبِّ مُضْنًى عَليلُ","ليسَ يُسليهِ عنكُمُ التَّعليلُ",47,"ل",1,1],["ليقول من يرث الليالي بعدنا","يفنى الورى وتعمر الآثار",48,"ر",1,0],["ليقول الورى بغير خلاف","صنع الخير عند من فيه آله",49,"ل",2,0],["لي قلب صب على الأشواق مشتمل","وقد بكيت بدمع فيك منهمل",50,"ل",1,0],["لي قصر عالي نصبتو من خشب كالبرج","في وسط بستان في اللوان يسمى البرج",51,"ج",1,1],["لَيَقِلُّ فِكْري إِنَّهُ لَكَ مَعْبَرٌ","وَيَقِلُّ قلْبي إِنه لَكَ مَنْزِلُ",52,"ل",1,0]]}