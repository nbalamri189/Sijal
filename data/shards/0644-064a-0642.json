.com/ViewPoem.aspx?id=200503",""],[5764,"حيرة الجاني","https://www.poetsgate.com/ViewPoem.aspx?id=174653",""],[5770,"طار الحمام","https://www.poetsgate.com/ViewPoem.aspx?id=178360",""],[5910,"حيِّ قبرًا بجانبِ الآكامِ","https://www.poetsgate.com/ViewPoem.aspx?id=207124",""],[5956,"ذكرى وداع شقيقي","https://www.poetsgate.com/ViewPoem.aspx?id=192923",""],[5956,"لم أبتدئ بالشعر بعد","https://www.poetsgate.com/ViewPoem.aspx?id=201557",""],[5992,"بواحدةٍ من مزايا الوصيّ","https://www.poetsgate.com/ViewPoem.aspx?id=41855",""],[6031,"بِرغمِ العَوَالِي والمُهَنَّدَةِ البُتْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=46342",""],[6102,"عِندَما قالَ حِذائِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=184457",""],[6125,"لي قلبُ طفلٍ شاخَ في الحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=210975",""]],"verses":[["لِيَقرِيَ أَسماعَ الرِجالِ فَصاحَةً","وَيورِدُ أَفهامَ العُقولِ زُلالا",0,"ل",2,0],["لِيَقْصِدْ مُسِرُّ الضِّغْنِ فينا بِذَرْعِهِ","وَلا يَسْتَثِرْ مِنا بِوادِيهِ ضَيْغَما",1,"م",2,0],["لِيَقينَ وَجهَ المَرءِ سَف","سافَ التُرابِ وَلَن يَقينا",2,"ن",2,0],["لي قصة والسؤال سكني","بيتٍ ويحتاج للعبارَه",3,"ر",2,0],["لي قلمٌ بين دجى خطّه","يبيت ذا رَقْصٍ وذا زحمَه",4,"ه",1,1],["لِيَ قَلبٌ لَهُ إِلَيكَ عُيونٌ","ناظِراتٌ وَكُلُّهُ في يَدَيكا",5,"ك",2,0],["ليقْصُرْ عليه اليوم في ظلّ غِبطةٍ","ولا يَقْصُرِ العمرُ الذي هو لابثُهْ",6,"ث",2,0],["لِيَقُلْ عُفَاتُكَ لا جُنَاح عليهمُ","رَفِعَ الجُنَاحُ فلاتَ حينَ جُنَاحِ",7,"ح",1,0],["ليقلْ فيه مادحٌ فالعطايا","والمنايا هناك في أشهادِهْ",8,"د",2,0],["لِيَ قَدٌّ وَجَمالٌ يَزدَري","ذاكَ بِالغُصنِ وَذا بِالكَوكَبِ",9,"ب",1,0],["لِيُقيمَ ذاكَ العودُ مِن رَسم السُرى","وَيَعودَ في الأَجسام بالأَرواحِ",10,"ح",1,0],["لي قَوافٍ تَعِفُّ في الحُبِّ إِلّا","عَنكِ سارَت جَوائِبَ الآفاقِ",11,"ق",1,0],["لَيُقَصِّرَنَّ لَجاجَ شَوقٍ غالِبٍ","وَليَقصُرَنَّ لَجاجُ دَمعٍ ساكِبِ",12,"ب",1,0],["لِيُقَوِّمَ المُعوَجَّ مِن تَدبيرِها","وَيُعيدَ مُدبِرَ كُلِّ أَمرٍ مُقبِلا",13,"ل",2,0],["لِيَقتَطِعَن حَرفَي لِساني الَّذي بِهِ","لِخِندِفَ أَرمي عَنهُمُ مَن تَكَلَّما",14,"م",2,0],["ليَ قلبٌ من جَلمَدِ الصّخرِ أقسى","وهو من رِقّةِ النّسيمِ أرَقُّ",15,"ق",1,1],["لِيَقْضِيَ اللهُ أمْراً كانَ قَدَّرَهُ","وكُلُّ ما قَدَّرَ الرَّحْمنُ مفعُولُ",16,"ل",1,0],["لِيَقِرَّ تحتكَ عودُ منبرِهِ الذّي","لا يستقِرُّ تحسُّراً وتلهُّفَا",17,"ف",2,0],["ليَ قلبٌ كزهرةِ الحقل بيضا","ءَ نَمَتْها السماءُ من كلِّ قبْسِ",18,"س",1,0],["لي قيلةٌ تلقى عليك بمسمعٍ","وبمحضرٍ من زمرةِ السواس",19,"س",1,0],["لي قلبٌ لو جاز نسيانهُ صدريَ","يوماً لجازَ أنْ ينساك",20,"ك",1,0],["لِيَ قَلبٌ لَديك أَقرب شَيء","وَخُلوص إِذا تَباعَدت عَنا",21,"ن",2,0],["لي قلب قد قلبته على الجم","ر الليالي لما به من هواكا",22,"ك",2,1],["لي قلب على المحبة قد شب","وجمرها لعمره لهوى شب",23,"ب",1,1],["ليقال صان حمى بنية محمد","وتقر عيني فيك يا مولائي",24,"ا",2,0],["ليقضي الذي قد فات إذ كان واجباً","وفي الشرع تقضى كل فائتة قسرا",25,"ر",2,0],["ليقرَّ عيناً بالتملي مدةً","بأعز سلطان وخير إمامِ",26,"م",1,0],["ليقال شيخٌ صالحٌ","لا قادعا متواتغا",27,"غ",2,0],["ليقوِّمَنَّ صَغا الحوادثِ منْ بني","عبد العزيزِ بها وسيم أَزْهَرُ",28,"ر",1,0],["ليقض ما شاء في أمرى فسوف يرى","أني لروضح نعم القاطف الجاني",29,"ي",1,0],["لي قبل هذا أمان","والآن مالي أماني",30,"ن",2,0],["لِيَ قَلب أَفرَغته فَاِترُكيهِ","في الهَوى فارِغاً وَلا تَملَأيه",31,"ه",1,0],["ليَ قلبٌ أَمضَى من الدّهر في الده","ر إذا كَعَّت القلوبَ الطَّغامُ",32,"م",1,0],["ليقصدوا وِفادَتَه","وَيَغنَموا عيادَتَه",33,"ه",1,0],["ليقتُلَ الذُبابَه","من غير ما إِرابَه",33,"ه",1,0],["ليقعد الدَّهرُ بي ما شاءَ وليَقُم","لَيسَ التَضاؤل للأَهوال من شيمي",34,"م",2,1],["لي قلب أخشى الهوان عليه","وإباءٌ حماه قلبي وصانه",35,"ن",2,0],["لي قلب يزين البؤس للنا","س ويرجو لو كان أبأسَ حالا",36,"ل",2,0],["ليُقطِّعَنَّ قفاكَ سَوْطُ عَذابِه","وتُقاسيَنَّ عقابَه ألوانا",37,"ن",2,0],["ليَقطعني لقد أسرَفتِ حتَّى","حُداتُكِ بالعَداوةِ يَقصِدونا",38,"ن",2,0],["ليُقاسِي ناظِري كَمَداً","لم يَكن لَولاهُ يكمِدُني",39,"ن",2,0],["لِيُقيمَ كُلَّ مُؤدَّدٍ ويُنيمَ كُلَّ","مُسَهَّدٍ ويَضمَّ كُلَّ مَبَدَّدِ",40,"د",1,0],["ليقُل بُناةُ الشعر فيك فإنما","أوصافُ مجدك صحةٌ أسماؤه",41,"ا",3,0],["ليقِفْ دونَك المُلوكُ فما تبْ","لُغُ في الرُتبةِ الصّريحِ الصراحا",42,"ح",2,0],["ليَقْسِمَ لي سهمَ حمدي وشكري","وينزِعَ سهم الأَسى من فُؤادي",43,"د",2,0],["ليقتادَني بِيَدِ الإِصْطِناعِ","ويخلَعَ من يَدِ دهرِي قِيادِي",43,"د",2,0],["لي قلة في الأصدقاء حسبتهم","فوق الجواهر للبخيل المعدم",44,"م",1,1],["ليقم مقامك في الفصاحة والنَّدى","من ظنّ إدراك المعالي هينا",45,"ن",2,0],["لي قِسمَةٌ في طِيني مُخَمَّرَةٌ","والحاصِلاتُ لَعَمْري كلُّها قِسَمُ",46,"م",1,0],["لي قلبٌ في الحُبِّ مُضْنًى عَليلُ","ليسَ يُسليهِ عنكُمُ التَّعليلُ",47,"ل",1,1],["ليقول من يرث الليالي بعدنا","يفنى الورى وتعمر الآثار",48,"ر",1,0],["ليقول الورى بغير خلاف","صنع الخير عند من فيه آله",49,"ل",2,0],["لي قلب صب على الأشواق مشتمل","وقد بكيت بدمع فيك منهمل",50,"ل",1,0],["لي قصر عالي نصبتو من خشب كالبرج","في وسط بستان في اللوان يسمى البرج",51,"ج",1,1],["لَيَقِلُّ فِكْري إِنَّهُ لَكَ مَعْبَرٌ","وَيَقِلُّ قلْبي إِنه لَكَ مَنْزِلُ",52,"ل",1,0],["ليقدَّس اسمك انه","شرفا على الاسما سما",53,"م",2,0],["لي قَلب أَطلقته فيك دَمعاً","بعد ما كان من جواه بحبس",54,"س",1,0],["ليَقْضِيَ في الدّنيا لَهُمْ بِجَهالةٍ","ويَحْكُمَ في الأخرى لهم بِجَهَنَّمِ",55,"م",1,0],["ليقتدي بك الذي","ن أصبحوا في سغب",56,"ب",1,0],["ليَ قلبٌ على هواكَ حبيسُ","وحَشاً حَشْوُها جوىً ورسيسُ",57,"س",1,1],["لي قلب غير صاح","من هوى البيض الصباح",58,"ح",1,1],["ليقل من سره مك","ثك في السعد المقيمِ",59,"م",1,0],["ليقضي الله أمراً","مقدرّا مفعولا",60,"ل",2,0],["ليقضي إلى كل الورى باستقامةٍ","وعدلٍ وحكمٍ مقسطٍ قد تقرْرا",61,"ر",2,0],["ليقم بين اكؤس الراح عرشي","ثابتاً أسه رفيع المنار",62,"ر",1,0],["لَيَقبُحُ بِالفَتى فِعلُ التَصابي","وَأَقبَحُ مِنهُ شَيخٌ قَد تَفَتّى",63,"ت",2,0],["ليقضي عليها من منىً غاية المنى","فقد شاقه من شعبه ما تشعبا",64,"ب",2,0],["لي قَيْس غَيْلاَنَ رُتْبَةٌ","عَلَى عَمَدِ الإِجْلاَلِ قَامَ جَلاَلُهَا",65,"ل",3,0],["ليقول من عرف الجياد وغيرها","شتان بين مطهَّمٍ وحمار",66,"ر",1,0],["ليقتاد قسراً نواصي المُنَى","فتأتي كما شاء في مضمره",67,"ر",2,0],["ليقضيها الاله بجاهكم يا","سواد سواد حندور السواد",68,"د",1,0],["ليقينه ان المجاهد ميتا","او قاتلا قطعا من السعداء",69,"ا",2,0],["ليقصر عن قلبي تطاول جوعه","وتوصله بعد القطوع شبائع",70,"ع",1,0],["لي قلب سبق الناس إلى","حبهم وأعتاقه السقم فصلى",71,"ل",2,0],["لي قلبٌ يغري بحبك مهما","عنف العاذلون فيك ولاموا",72,"م",3,0],["ليَ قالت جنودُ حسنِ مُحَيّا","هُ وأيضاً لسائرِ العُشّاقِ",73,"ق",1,0],["لي قلب ولهان في حبك وطرف كليل","أقسم بالأيمان في جمالك مثيل",74,"ل",1,0],["لي قصة أمرها عجيب","إن يستمع لي بها مقال",75,"ل",1,0],["لي قوم كلما ناديتهم","للعلى نادوا بهلكي وبجيني",76,"ن",2,0],["ليَ قلب ظلّ اثرهم","بين تلك الكثب والاكم",77,"م",1,0],["ليقض الرفد والمعروف لولا","فتى الفتيان عارفةً ورفدا",78,"د",2,0],["ليقُلل من الأطماع غارسُ دوحه","فما هو إلا للفنا مِثل غرسه",79,"ه",1,1],["لي قول أخاف منه حمامي","فيظل الكلام دون ختام",80,"م",1,1],["لي قول أقوله في الختام","ثم من بعد لا أخاف حمامي",80,"م",2,0],["لي قلبٌ متيّمٌ مستهامٌ","ذابَ شوقاً ولوعة وحنينا",81,"ن",2,1],["لي قلب في العشق شاجع ما يهاب الأسود","أخلصت يا عذب في عشقك فكن لي ودود",82,"د",1,0],["لي قلب ظمآن ما ترويه في عشقة","الخرد ثمانين دن",83,"ن",1,0],["لي قضى السّعدُ بالمنى وشُهودي","كلُّ عدل من غصنها أملود",84,"د",1,0],["ليقال احمد يا له من ناظم","جم البيان ويا له من ناثر",85,"ر",1,0],["ليقوم حباً بعد أن ذاق الردى","وأنا الضمين له برد حياته",86,"ه",1,0],["ليقبلن لي الأَحباب عذرَ شجٍ","عَلى الضنى في حَنايا خيسه قبعا",87,"ع",2,0],["ليقبسَ ناراً كلَّما عادَ جاهداً","ليطفئها بالماء والترب أَلهبَا",88,"ب",2,0],["ليقظانِ العَداوةِ مُستريبٍ","ووسنانِ المودةِ مُستنيمِ",89,"م",1,0],["لي قلم أخرس لكنه","ينطق عن معجب افكاري",90,"ر",2,1],["ليَ قلبٌ صادٍ إذا رامَ وِرْداً","ذِيدَ عن موْرِدِ الثغُورِ العِذابِ",91,"ب",1,0],["لي قَلب ذائِب من جَفاكِ مَجروح","وطرف لا يهجَع وَدمع مَسفوح",92,"ح",1,0],["ليَ قلبٌ كيف ما قَلَّبَ","هُ اللَه يُقَلَّب",93,"ب",1,0],["لِيُقدِّسوا ذا السِرَّ سِرَّ خَلاصِنا","مُتَعاقباً ما عاقَبَ الليلُ الضَحَى",94,"ا",1,0],["لي قيل طوبى له ممن وعت إذن","والعين لي شهدت بالسر والعلنِ",95,"ن",1,1],["ليقدم صَرفُ الدَهر ما شاء وَلْيُرِعْ","فَلي منهما رُكن شَديد مَدافع",9