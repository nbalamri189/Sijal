{"poems":[[55,"ما بعد يومك ما يسلو به السالي","https://www.aldiwan.net/poem29885.html","البسيط"],[57,"ركبنا وفتيان صدق ثبينا","https://www.aldiwan.net/poem26089.html","المتقارب"],[74,"أهلاً بأوفى الورى وأقوى","https://www.aldiwan.net/poem18590.html","مخلع البسيط"],[53,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[53,"مالي إذا زدت حبا زدت مقلية","https://www.aldiwan.net/poem66437.html","البسيط"],[107,"بني الآمال قد وضح اليقين","https://www.aldiwan.net/poem43095.html","الوافر"],[48,"تعالى رازق الأحياء طرا","https://www.aldiwan.net/poem22002.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62225","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55506","الطويل"],[136,"نحبها نحب من يحبها","https://www.aldiwan.net/poem54883.html","الرجز"],[164,"جرى لك في خرق العوائد والعرف","https://www.aldiwan.net/poem58901.html","الطويل"],[164,"خذوا لي من سعدى أمانا من الهجر","https://www.aldiwan.net/poem59078.html","الطويل"],[190,"نحب لذاذات ونخشى غوائلا","https://www.aldiwan.net/poem43628.html","الطويل"],[234,"وشادن شرط الصبا مرهف","https://www.aldiwan.net/poem51273.html","السريع"],[290,"نصول اذا حان الدفاع ولا نرى","https://www.aldiwan.net/poem39402.html","الطويل"],[347,"إلى أين في هذه الفانية","https://www.aldiwan.net/poem55382.html","المتقارب"],[369,"كأنك بالأحباب قد جددوا العهدا","https://www.aldiwan.net/poem60961.html","الطويل"],[406,"تلاميذ النبوة","https://www.aldiwan.net/poem6731.html","عموديه"],[406,"قمر الهدى","https://www.aldiwan.net/poem6776.html","عموديه"],[447,"رضى بما قدر الله الحكيم رضى","https://www.aldiwan.net/poem14455.html","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66844","الوافر"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137851",""],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44835","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78011","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108950","البسيط"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100908","البسيط"],[2753,"","https://poetry.dctabudhabi.ae/diwan/poem/20053","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202748","المنسرح"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112680","الرجز"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139975","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62820","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108274","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108103","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108091","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91688","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132115","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77136","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72471","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120360","الوافر"],[4693,"ملك القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=60766",""],[4699,"لدينا قلوب","https://www.poetsgate.com/ViewPoem.aspx?id=155949",""],[4755,"نحبك يا عمانُ","https://www.poetsgate.com/ViewPoem.aspx?id=208129",""],[557,"دعيني.. أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=13824",""],[5122,"(( عبّر ودروس ))","https://www.poetsgate.com/ViewPoem.aspx?id=28151",""],[5268,"تَحُفُّ بِيَ المَخَاطِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=206999",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[5431,"أبانا الروحي...","https://www.poetsgate.com/ViewPoem.aspx?id=210262",""],[5776,"صمود يماني","https://www.poetsgate.com/ViewPoem.aspx?id=200680",""],[5859,"طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=29415",""],[192,"سيّد العرضة","https://www.poetsgate.com/ViewPoem.aspx?id=16357",""],[5956,"شهيد فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192359",""],[5956,"طيوفك والدعاء","https://www.poetsgate.com/ViewPoem.aspx?id=192403",""],[5956,"أرى وجه الإله على الزهورِ..","https://www.poetsgate.com/ViewPoem.aspx?id=192602",""],[5956,"تأثيرات صحاب الطفولة في أنفسنا","https://www.poetsgate.com/ViewPoem.aspx?id=194052",""],[5956,"مناجاةُ أبٍ موَسوَسٍ على ابنته العُزَّى","https://www.poetsgate.com/ViewPoem.aspx?id=207206",""],[6035,"لمْ يَكْفِني دمعي .. !","https://www.poetsgate.com/ViewPoem.aspx?id=168759",""],[6093,"الدُّرَّةُ ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=181003",""],[6113,"تعالي وش ذنوب الحب","https://www.poetsgate.com/ViewPoem.aspx?id=14420",""],[6152,"حب الأوطان","https://www.poetsgate.com/ViewPoem.aspx?id=203294",""],[6189,"تعليق على ماقاله لقيطُ ابن حارثة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83552&r=&rc=19",""],[1583,"شعاع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73067&r=&rc=24",""]],"verses":[["نُحِبُّها وَعَلى رُغمٍ نُوَدِّعُها","إِلى المَنونِ وَداعَ الصارِمِ القالي",0,"ل",2,0],["نُحِبُّ السَماعَ وَنَلتَذُّهُ","وَنَشرَبُ ما عِندَنا آمِنينا",1,"ن",2,0],["نحبّ بيروتَ إذ نراه","وإن يغبْ لا نحبّ صيدا",2,"د",2,0],["نحب البقاء وفيه الغَنا","ء والعيش متَّصلٌ منقطع",3,"ع",1,0],["نحب كلَّ غلام فيه مَيعتُه","ينزو إذا ما استنكناه بأيرين",4,"ن",1,0],["نُحِبُّ مُحَمَّداً وَنَصونُ فيهِ","لِعيسى ما يُحِبُّ وَما يَصونُ",5,"ن",1,0],["نُحِبُّ العَيشَ بُغضاً لِلمَنايا","وَنَحنُ بِما هَوينا الأَشقِياءُ",6,"ي",3,0],["نَحْبِسُ أَذْوَادَنَا حَتَّى نُمِيطَ بِهَا","عَنَّا الغَرَامَةَ لاَ سُودٌ ولا خُرُعُ",7,"ع",1,0],["نُحِبُّ مِنَ الإِنْشَادِ كُلَّ مُكَرَّرٍ","بِلَحْنٍ جُمُودُ الفِكْرِ مِنْ مُسْتَفَادِهِ",8,"د",2,0],["نُحِبُّها نُحِبَّ مَن يُحِبُّها","نَارُ القِرَى َشُبَّهَا",9,"ه",2,1],["نحبك حب الماء في شدة الظما","لمن ظل في حر الهواجر يستطفى",10,"ف",2,0],["نحبك حبا لو تقسم بعضه","على الخالق لم يوجد عدوان في قطر",11,"ر",1,0],["نُحِبّ لذاذات ونخشى غوائِلا","فنحنُ كبكرٍ تشتهي وهي تجزَع",12,"ع",1,1],["نحبو إذا نادى إليه كما","يَحْبو إلى الوالد أَبناهُ",13,"ن",3,0],["نحب اللقا لا نبغض الطعن إن يكن","نضالا عن الأوطان والدين والمجد",14,"د",1,0],["نحب ونكره في لحظة","ونشقى ونسعد في ثانية",15,"ي",2,0],["نُحِبك لا حُبّ اعتيادٍ وإنّما","بِذاك علينا اللهُ قد أخَذ العَهدا",16,"د",2,0],["نحبك يا أبا السّبطين حب","لو اصطبغ الجماد به لهاما",17,"م",2,0],["نحبك ما شعرنا أنّ حب","يعلمنا التناحر والصّداما",17,"م",2,0],["نُحبُّ بلادَنا جبلاً وسهلا","ونعشق بِيدَها عرضاً وطولا",18,"ل",2,0],["نحب جمع الذي يفنى ونذكر ما","يبقى إِذا ما لقينا الحزن والحرضا",19,"ض",2,0],["نُحِبُّ محمداً ونحبُّ فيه","بني أبنائِه وبَني أبيهِ",20,"ي",2,0],["نحب بقلب طيب مخلص يرى","غياث اليتامى هنده وسعاده",21,"د",2,0],["نُحِبُّ بَنَات الفِكرِ وَهيَ تَعُقُّنَا","فَمَا لِعَدُوِّي أَرتَضِيهِ صَدِيقِي",22,"ق",2,0],["نحب السجود مضى وايام البكا","وهنا سرور دائم وثواب",23,"ب",1,0],["نحبها حبَّ مولود لوالدةٍ","ونشتهي أن يديم اللَه مولاها",24,"ا",3,0],["نُحِبُّها كَرَماً مِنَّا وليسَ لنا","فيها ديارٌ ولا أرضٌ ولا شَجر",25,"ر",1,0],["نَحبو الكَتيبَةَ حينَ تَقتَرِشُ القَنا","طَعناً كَإِلهابِ الحَريقِ المُضرَمِ",26,"م",1,0],["نحبوك بالقطف والذبول معاً","وأنت تحبو الأنام بالرّغد",27,"د",1,0],["نحبكُم ومَن أحبّ معشرا","مع الذي أحبه قد حشرا",28,"ر",2,0],["نحبُّ الزمانَ ولا نتقي","سطاه وآباءنا قد قتلْ",29,"ل",1,0],["نَحَبو بني حمدانَ وُدَّكَ بعدما","حكموا عليكَ حكومةَ المتحامِلِ",30,"ل",1,0],["نحبك يا دارَ الجمال ومن رأت","جمالكن عيناهُ وما عاد مغرما",31,"م",2,0],["نحبكَ يا ربَّ القوامِ المهفهفِ","ونهواكَ يا ربَّ الكلامِ المشنفِ",32,"ف",1,1],["نحب أمير النيل حباً مجرداً","وحباباً لسلطان إليه قد انتمى",33,"م",2,0],["نُح بعدَ مَن قد فارق الآثارا","وَاسمح بدمع صُنتَه إيثارا",34,"ر",2,1],["نحب فرنسا لأجل فرنسا","وهذا هو الخطأ الأكبر",35,"ر",1,0],["نَحبو الضُيوفَ طَلاقَة وَبَشاشَة","وَقُرىً بِنادينا عَظيمُ المَوقِد",36,"د",1,0],["نحب المنايا وهي تخشى وصالنا","وتكرهها قوم تهاب نزالنا",37,"ن",2,0],["نحبت من البعاد فما اساني","وطول اساي لم ينف ائترافي",38,"ي",1,0],["نحبك في الرخاء وليس حصراً","فقد يزداد في الوقت العصيبِ",39,"ب",1,0],["نحبُ .. لأن لدينا قلوباً","وليس لأن .. لدينا أمل",40,"ل",1,0],["نحبك يا عمانُ.. ثَرًى.. وشَعبًا","وقافيةً.. نحبك يا عُمانُ",41,"ن",1,0],["نحب كثيرا ونبني قصورا","وتغدو مع البعد بعض الظلال",42,"ل",1,0],["نحب الجزيل ولا خلقنا ضعاف النفوس","ونعرف الرجال اللي عريبه مناسبها",43,"ب",3,0],["نُحِبُّ الأرضَ، حتّى لَو صُلِبنا","وَخُضنا في تَلافيفِ الجَحيمِ",44,"م",1,0],["نحُبُّهُ حُبَّ أَكْفَاءٍ فَإِنْ رَضِيَتْ","بِنَا جَوَانحِهُ نَسْعَى لِنُرْضِيهِ",45,"ي",2,0],["نحبك حامضا حلوا ومرّا","نحبك داجنا ضوءا تسنّى",46,"ن",2,0],["نحبك في انقلابات المرايا","حرورا باردا حربا وأمنا",46,"ن",2,0],["نحبُّ السلامَ، ولكنّهُ لن يجيءَ بغيرِ السلاحْ","نحبُّ السلامَ، بنادقنا سوف تصنعهُ حينها لا جُناحْ",47,"ح",1,1],["نحبُ السلامَ ونكرههُ إن أذلَّ لنا طلعةً للصباحْ","نحبُ السلامَ الذي ليس يرمي بأشلائنا في الرياحْ",47,"ح",1,0],["نحبُ السلامَ إذا ما سيادتُنا، أرضُنا، لا تُباحْ","فكيف نحبُ سلامًا رأى قصفَ أطفالِنا صفقة للنجاح",47,"ح",1,0],["نحبُ السلاحَ الذي يصنعُ السّلْمَ، يطوي نزيفَ الجراحْ","نحبُ السلاحَ وإيقاعَهُ حين يعزفُ عزتنا بارتياحْ",47,"ح",1,0],["نحبسه بين الكلماتِ","نحاصره بحروف العلة",48,"ل",2,0],["نحبك ياولي العهد عضيد الفهد ياغالي","نحبك كثر مامرت على الدنيا ثوانيها",49,"ي",3,0],["نحبك فوق الهوى ونراك","تفوق الرؤى وتطاول شهبا",50,"ب",2,0],["نحبك يا محمدُ خيرَ حب","ولن ننساك ما مرَّتْ قرونُ",51,"ن",1,0],["نُحِب الله نمشي في هُداه","بما يرضيه وفقاً للسُّطورِ",52,"ر",1,0],["نحَبِّذ من يشابه كل حانٍ","رأيناهُ، ونزري بالذئابِ..",53,"ب",1,0],["نحب ابتسامك قنديلَ ليل","يتيح لنا الهدْيَ من قمَريكِ",54,"ك",1,0],["نَحَبَتْ رُبى حَوْران باكيةً عَلَيْ","كِ وأمطرتْ حرّ الدموع شآمُ",55,"م",1,0],["نُحبُّهَا حُبَّ أولادٍ لِأُمِهَمُ","أَسْقَتْهُمُ الحُبَّ والأولادُ أَبْرَارُ",56,"ر",1,0],["نحب الحب ونعيشه وتغدي النفس مسروره","نخلي العالم بحاله يصرقع من امانينا",57,"ن",2,0],["نحب ديارنا حبا عظيما","وننشر في مدارجها الوئاما",58,"م",2,0],["نُحِبهم ولهذا الحبِّ نصدقهم","فالكيل – يا سيد الأنغام – قد طفحا",59,"ح",2,0],["نحبَّ الغير إِما جاءَ خِلا","ونصلحه إذا ما جاءَ مولى",60,"ل",2,0]]}