{"poems":[[56,"وما تاه على الناس","https://www.aldiwan.net/poem27407.html","الهزج"],[23,"باهى بن سقعب إذ أثرى بكلبته","https://www.aldiwan.net/poem21393.html","البسيط"],[91,"ذكرى صباباتي فهزني الذكر","https://www.aldiwan.net/poem44845.html","الطويل"],[47,"بكل سبيل للنساء قتيل","https://www.aldiwan.net/poem65561.html","الطويل"],[154,"تركنا زهيرا للبقيع فثهمد","https://www.aldiwan.net/poem68579.html","الطويل"],[190,"ما استشعر الصبر إلا وهو مجهود","https://www.aldiwan.net/poem43908.html","البسيط"],[458,"نبئت أنك عن قرب ستسعدنا","https://www.aldiwan.net/poem61373.html","البسيط"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124038","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38752","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38769","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112822","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93699","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93990","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93922","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94247","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94152","المتقارب"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94001","المتقارب"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205429","الطويل"],[3386,"","https://poetry.dctabudhabi.ae/diwan/poem/124618","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131009",""]],"verses":[["وَإِذ حَظُّكَ في الأَشبا","هِ بَينَ الحُرِّ وَالعَبدِ",0,"د",1,0],["وَإِذ حُباشَةُ أُمٌّ لا تُسَرُّ بِها","لا ناكِحٌ في الذَرى زَوجاً وَلَم تَئِمِ",1,"م",1,0],["واذ حب ليلى لي كحبي لها فلا","تشط بها عني القطيعة والهجر",2,"ر",1,0],["وَإِذ حَسَناتُ الدَهرِ يَجمَعنَ بَينَنا","عَلى الوَصلِ وَالحُرُّ الكَريمُ وَصولُ",3,"ل",1,0],["وَإِذ حالَتِ الأَقدارُ مِن دونِ لَمحِهِ","فَإِنَّ لَنا أُنساً بِأَوصافِ سَمحِهِ",4,"ه",1,0],["وإذ حوائجنا يسعى بها رسل","من الحبيبة والإيماء موعود",5,"د",1,0],["وإذ حرمتك صاح الشعر في قلمي","لكي أخصّك بالجياش من فكري",6,"ر",2,0],["وإذ حل بالنيران والنهر ما به","من الخطب غيض البحر وانطفأ الجمر",7,"ر",1,0],["وَإِذ حَصَلَ التّبكيرُ فيها فَإِنّها","لَجالِبَةٌ لِلسّعدِ في أَحسَنِ البختِ",8,"ت",1,0],["وَإِذ حَللتَ عَليَّ المَجدِ ساحَتها","تاهَت فَخاراً عَلى الجَنّاتِ وَالغرفِ",9,"ف",1,0],["وإذ حال سور البين بالحس بيننا","فلا تحجبن رؤياك يا طيفا واتني",10,"ن",2,0],["وَإِذ حميّا الهَوى مالَت بأرؤُسِنا","فَما دَنا غَير ريّاكُم لِمعطسنا",11,"ن",2,0],["وإذ حسبوا بأني لست أدري","أصول الوضع في تلك الصناعه",12,"ع",2,0],["وإذ حوت من بديع الحسن غايته","وأحرزته بتنويع وتجنيس",13,"س",1,0],["وإذ حل بالروضات رضوان جاءه","بروح وريحان وأكرم مثواه",14,"ا",2,0],["وإذ حف بالآس أرخته","عذارك جاء بريحانه",15,"ن",2,0],["وإذ حل عقدة هميانه","وأمسكت منه بوثقى عراه",16,"ر",3,0],["وإذ حاضر حلو وماض محبب","ومستقبل أيامه نضرات",17,"ت",1,0],["وإذ حان من تلك الصحائف أخذها","وإذ توزن الاعمال من كل عامل",18,"ل",1,0],["وإذ حل فردينند فيها بجيشه","تهيب حتى لم يصعر له خد",19,"د",1,0]]}