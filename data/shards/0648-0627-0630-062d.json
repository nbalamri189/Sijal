{"poems":[[54,"وما تاه على الناس","https://www.aldiwan.net/poem27407.html","الهزج"],[23,"باهى بن سقعب إذ أثرى بكلبته","https://www.aldiwan.net/poem21393.html","البسيط"],[89,"ذكرى صباباتي فهزني الذكر","https://www.aldiwan.net/poem44845.html","الطويل"],[45,"بكل سبيل للنساء قتيل","https://www.aldiwan.net/poem65561.html","الطويل"],[150,"تركنا زهيرا للبقيع فثهمد","https://www.aldiwan.net/poem68579.html","الطويل"],[186,"ما استشعر الصبر إلا وهو مجهود","https://www.aldiwan.net/poem43908.html","البسيط"],[453,"نبئت أنك عن قرب ستسعدنا","https://www.aldiwan.net/poem61373.html","البسيط"]],"verses":[["وَإِذ حَظُّكَ في الأَشبا","هِ بَينَ الحُرِّ وَالعَبدِ",0,"د",1,0],["وَإِذ حُباشَةُ أُمٌّ لا تُسَرُّ بِها","لا ناكِحٌ في الذَرى زَوجاً وَلَم تَئِمِ",1,"م",1,0],["واذ حب ليلى لي كحبي لها فلا","تشط بها عني القطيعة والهجر",2,"ر",1,0],["وَإِذ حَسَناتُ الدَهرِ يَجمَعنَ بَينَنا","عَلى الوَصلِ وَالحُرُّ الكَريمُ وَصولُ",3,"ل",1,0],["وَإِذ حالَتِ الأَقدارُ مِن دونِ لَمحِهِ","فَإِنَّ لَنا أُنساً بِأَوصافِ سَمحِهِ",4,"ه",1,0],["وإذ حوائجنا يسعى بها رسل","من الحبيبة والإيماء موعود",5,"د",1,0],["وإذ حرمتك صاح الشعر في قلمي","لكي أخصّك بالجياش من فكري",6,"ي",1,0]]}