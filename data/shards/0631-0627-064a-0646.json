ate.com/ViewPoem.aspx?id=10970",""],[4984,"السِّفْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187854",""],[3591,"رأيناك غصناً مثلما كنت أهيفا","https://www.poetsgate.com/ViewPoem.aspx?id=149460",""],[592,"ألا أيها الغادي على ظهر ضامر","https://www.poetsgate.com/ViewPoem.aspx?id=128828",""],[5444,"الوزارة","https://www.poetsgate.com/ViewPoem.aspx?id=205448",""],[5497,"الموعظات الفواجع","https://www.poetsgate.com/ViewPoem.aspx?id=206397",""],[5690,"رأى نظري ربوعهم فما لا","https://www.poetsgate.com/ViewPoem.aspx?id=172171",""],[5943,"فشلا وتيها","https://www.poetsgate.com/ViewPoem.aspx?id=34285",""],[5956,"من أركان الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=192592",""],[5963,"إِذا كنتَ وادي النمل","https://www.poetsgate.com/ViewPoem.aspx?id=187379",""],[6068,"أبناء الأسود أسود -01-","https://www.poetsgate.com/ViewPoem.aspx?id=177022",""],[3986,"عزلت الجن والجنان عني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502415",""],[563,"رأينا النور في الظلما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56277&r=&rc=7",""],[186,"نسيمات نجد هل تحملت من نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55747&r=&rc=10",""],[5464,"بغداد والخمسون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=491&r=&rc=5",""]],"verses":[["رَأَينَ دِياراً بَينَ بُصرى وَجاسِمٍ","مَراعي لِيَومٍ لا تَلُسُّ خَلاها",0,"ا",3,0],["رَأَينا الرَجاءَ عَلى نَأيِهِ","رِشاءً وَكُلُّ يَدٍ تَنزِعُ",1,"ع",1,0],["رَأَينا بِوَجهِكَ نورَ اليَقي","نِ حَتّى خَلَعنا ظَلامَ الرِيَب",2,"ب",1,0],["رَأَينا الطايِعَ المَيمونَ بَدءاً","يَسُلُّكَ في النَوائِبِ وَاِعتِقابا",3,"ب",2,0],["رَأَينا المُلكَ مِن بَأسِ","كَ قَد دارَ عَلى القُطبِ",4,"ب",1,0],["رأيْنا بِها كُرْسيَّ كِسْرَى وتاجَهُ","نُلاحِظُهُ عَيْناً على قِدَمِ العَهْدِ",5,"د",1,0],["رأيْنا منْ يَديْهِ ومن قَفاهُ","صَليباً قد أطلّ علَى كَنيسَهْ",6,"ه",1,0],["رَأَيناكَ في أَعلى المُصَلّى كَأَنَّما","تَطَلَّعَ مِن مِحرابِ داوُدَ يوسُفُ",7,"ف",1,0],["رَأى نَقصَ مايَجبيهِ مِنها زِيادَةً","إِذِ العِوَضُ المَرضِيَّ إِلّا يَرُح يَغدو",8,"د",2,0],["رَأَينا قُروماً مِن جَديلَةَ أَنجَبوا","وَفَحلُ بَني نَبهانَ غَيرُ نَجيبِ",9,"ب",1,0],["رَأَينَ تَغَيُّري فَذُعِرنَ مِنهُ","كَذُعرِ الفارِسِ البَقَرَ الرِتاعا",10,"ع",2,0],["رأينا تواقيع تاج العلوم","على قصص ذات وصف جلي",11,"ي",1,1],["رأينا تواقيع تاج الزمان","وفيها من الفضلِ معنى جليّ",12,"ي",1,1],["رأَينَ مطافي حول حقْوَيْكَ عائذاً","فهنَّ لما أبصرنَهُ حَذِراتُ",13,"ت",1,0],["رَأَيْنَا الذي يُكتنى بالحسيْ","نِ صِنْوك ذا الشرف الأبذخِ",14,"خ",1,0],["رأيْنَاكَ ترعانا بعيْنٍ ذكيَّةٍ","أتَى النَّاسَ طُرّاً نَوْمُهُمْ من سُهُودِها",15,"د",3,0],["رأى نِيقا يستقرق النعتَ كله","جميلاً محيّاه حميد المخابرِ",16,"ر",1,0],["رَأَينا شِياهاً يَرتَعينَ خَميلَةً","كَمَشيِ العَذارى في المُلاءِ المُهَدِّبِ",17,"ب",1,0],["رَأَينا السُيوفَ ضُحىً كالنُجوم","وَكالَّيل ذاكَ الغُبارَ المُثارا",18,"ر",2,0],["رَأَينا بِبَدرِ وَآبائِهِ","لِبَدرٍ وَلوداً وَبَدراً وَليدا",19,"د",2,0],["رَأَينَ الَّتي لِلسِحرِ في لَحَظاتِها","سُيوفٌ ظُباها مِن دَمي أَبَداً حُمرُ",20,"ر",1,0],["رأى نفسَه بالصيدِ أولَى فدقَّهُ","بلَطْمةِ مُسوَدِّ الذِّراعين أصيدَا",21,"د",2,0],["رأينَ جِمامَ الماء زُرقاً ومثلَها","سنا الصبحِ فارتابتْ عيونُ الركائبِ",22,"ب",1,0],["رَأَينا خِلالَ إِمامَ الوَرى","شَبايِهَ ما شِدنَ مِن مَجدِهِ",23,"د",2,0],["رَأَينا بَني الأَمجادِ في كُلِّ مَعشَرٍ","فَكانوا لِعَبدِ اللَهِ في المَجدِ أَعبَدا",24,"د",2,0],["رَأَينا الشَآمَ مِن قَريبٍ وَأَعرَضَت","رَقائِقُ مِنهُ جُنَّحٌ عَن بِقاعِهِ",25,"ع",2,0],["رَأَينَ شُروخَهُنَّ مُؤَزَّراتٍ","وَشَرخَ لِدِيَّ أَسنانَ الهِرامِ",26,"م",1,0],["رأيْنا اللَّيْثَ في غابِ العوالي","به والشمسَ في ظِلِّ الأيادي",27,"د",2,0],["رأيناه يومَ الجودِ أزهرَ واضحاً","ويومَ قِراعِ البيضِ أبيضَ مِقْضَبا",28,"ب",2,0],["رَأَينا الدُعاءَ","لَدَيها يُجاب",29,"ب",1,0],["رأى نفسَهُ أُخِّرَتْ في العلومِ","فرامَ التقدَّمَ بالجبروتِ",30,"ت",1,1],["رَأَينَ لَها شَجواً فَعُجنَ لِشَجوِها","جَميعاً وَأَقلَتنَ التَنازُعَ وَالنَزَق",31,"ق",1,0],["رَأَينا خَلاءً مِن عُيونٍ وَمَجلِساً","دَميثَ الرُبى سَهلَ المَحَلَّةِ مُمرِعا",32,"ع",2,0],["رَأَينَ الغَواني الشَيبَ لاحَ بِعارِضي","فَأَعرَضنَ عَنّي بِالخُدودِ النَواضِرِ",33,"ر",1,1],["رأينا الشاذليَّ وكيف يمضي","إذا ما الأمرُ بعد الأمرِ نابا",34,"ب",2,0],["رَأَينا الحاكِمينَ فَما رَأَينا","حُكومَةَ صالِحٍ وَقَضاءَ بَرِّ",35,"ر",1,0],["رأَيناهُمُ لَهُ ذَحلاً وَقُلنا","أَرونا مِثلَ حَربٍ في الأَنامِ",36,"م",1,0],["رَأَينَ فَتىً لا صَيدُ وَحشٍ يُهِمُّهُ","فَلَو صافَحَت إِنساً لَصافَحنَهُ مَعا",37,"ع",2,0],["رَأَينَ الوَردَ في الوَجناتِ حَيماً","فَغادَينَ البَنانَ مُعَنِّماتِ",38,"ت",1,0],["رَأَينا شُؤونَ الدَهرِ خَفضاً وَرِفعَةً","وَنَحنُ أُسارى في الحَوادِثِ أَو غَرقى",39,"ق",2,0],["رأَيْنا السَّيْفَ مُرتَدِياً بِسَيْفٍ","وعايَنَّا الجَوادَ على الجوادِ",40,"د",1,0],["رَأَيْنا بِكَ الأَوْهَامَ وَهْيَ حَقَائِقٌ","كَأَنَّا نَرَى سِحْراً وَمَا هُوَ بِالسِّحرِ",41,"ر",1,0],["رَأَيْنَا مِنَ الْغَيْمِ طوداً رَسَا","عَلَى أُفْقِهَا وَسَمَا وَاشْرَأَبْ",42,"ب",1,0],["رَأَيْنَا كَمَالَ الأُمِّ وَالبَيْتَ عِنْدَهُمْ","وَحِكْمَةَ فِتْيَانٍ وَعِفَّةَ خَرَّدِ",43,"د",1,0],["رَأَينا أَشجَعَ الفُرسا","نِ عِندَ المَوتِ أَجبَنَها",44,"ن",3,0],["رأينا به الأذى يهدرُ ماؤه","وجرجرةُ الأمواجِ في لُجّةِ اليم",45,"م",1,0],["رأينا به كرسي كسرى وتاجه","تلاحظه عينا على قدم العهد",46,"د",1,0],["رَأيْنا خِلالَ إمَامِ الورَى","شَبَابِهَ مَا شدنَ مِنْ مَجْدِهِ",47,"د",2,0],["رأى نِيقا يستغرق النعتَ كله","جميلاً محيّاه حميد المخابرِ",48,"ر",1,0],["رَأَينا مَن نُحارِبُهُ شَقِيّاً","وَمَن ذا يا بَني عَوفٍ سَعيدُ",49,"د",1,0],["رَأَينا مِنكَ ما لَم يُروَ عَنهُم","فَأَلغَينا السَماعَ لَدى العِيانِ",50,"ن",1,0],["رأينا سجايا لو سمعنا بمثلها","قديما لكذبنا التواريخ والكتبا",51,"ب",2,0],["رأيناهُ يخطرُ في روضةٍ","كأنْ قد تعلمَ من بانها",52,"ن",3,1],["رأينا لياليَ أفراحِها","تجرُّ لياليَ أحزانها",53,"ن",3,0],["رأينا شدّة من بعد شدّة","وذاك لوعد ربّ العالمينا",54,"ن",2,0],["رأينا من الحسن ما راعنا","وأغرى بنا جمرات الفتون",55,"ن",1,1],["رأينا الحسن وثّاباً جريئاً","يحاصرنا كأحلام العشيق",56,"ق",1,0],["رأيناك والأيام ذا الأيدي سطوها","بسفع نواصيها وقد ساء سفعها",57,"ع",3,0],["رأيناه في جمع وأمكن خلوة","فقبلته تسعاً وعشرته أنا",58,"ن",2,0],["رأيناك أقوى شاعر وأعزّه","بيانا وسلطانا على الزمن الوغد",59,"د",1,0],["رأى نفسه قبساً حائرا","تحدّ سناه قيود الإله",60,"ه",1,0],["رأى نفسه ليته ما راى","وعاش على جدبه ظامئا",60,"ا",2,0],["رأينا مَعادَ النّاسِ من قبلِ حَشْرِهمْ","بمَحْيا نواحي المَسْرُقانِ العواطل",61,"ل",1,0],["رأينا عجيباً والزّمانُ عجيبُ","رجالاً ولكنْ مالَهُنَ قلوبُ",62,"ب",1,1],["رَأَينا عَطاياكَ الكَريمَةَ ما لَها","نِظامٌ فَخِفنا مِنكَ أَن تَتَبَدَّدا",63,"د",2,1],["رأى نَفسه أهلاً لارشاد غيره","وليس لارشادٍ لها بمؤهَّل",64,"ل",1,0],["رأينا من عهودِكُمُ","عهوداً ما عهدناها",65,"ا",3,1],["رأينا آدمينِ معاً ولكن","بما كانا به يتضاددانِ",66,"ن",1,1],["رأيناه بين الخلق في الطُرْق مُطْرَحاً","ولكنه فوق السماكين نابغا",67,"غ",2,0],["رأينا قبلَكم قوماً مثالاً","هُمُ في معرض المعنى شهودُ",68,"د",1,0],["رَأَينا مَجلس الفِتيا","يَزيد علوَّهُ بِعلي",69,"ل",2,0],["رأينا الطير حين غدت خماصً","وراحت بعدما ملئت بطونا",70,"ن",2,0],["رأينا الأفق مبتسمًا بشوشً","ضحوك الثغر حين بدى رضينا",70,"ن",2,0],["رأينا الشمس تنسجُ للروابي","خيوط شعاعها تاجًا ثمينا",70,"ن",2,0],["رأيناكم فما للحزن حد","ولا للهيبه عنَّا براح",71,"ح",1,0],["رأينا أناساً قد أناخت بسوحهم","وقالت خذوا من زهرتي كل منية",72,"ه",1,0],["رأيناهُ يُصلِّي الخَمْسَ باقٍ","بمحراب الصَّلاة على الشَّهيق",73,"ق",1,0],["رأَى نظامَ الأَمانِ فِي تأَلُّفِهِ","فطارَ نحوَكَ خوفاً من تَبَدُّدِهِ",74,"د",2,0],["رأينا الكثير الحرص ما كان شائباً","وكل شباب في المكارم يغبط",75,"ط",1,0],["رأينا الكريم الحُر ليس لعمره","دوام سوى ما بين هاك وهات",76,"ت",1,0],["رأيناهم في سباق الردى","ونحن سباق قطار السباق",77,"ق",1,0],["رأينا عظيم الشأن من أسرعوا به","إلى قبره ذي النازلات العظائم",78,"م",1,0],["رأى نزقةً وادّعى طَرْبَةً","فلم يحتشم ذلَّةَ الواغلِ",79,"ل",1,0],["رأيناهم وكلُّهُمُ شُكولٌ","مُصلِّيهم لسابقهم نظيرُ",80,"ر",1,0],["رَأَيناكَ لَم تَعدِل عَنِ الحَقِّ يمنَةً","وَلا يسرَةً فِعلَ الظَلومِ المُجادِلِ",81,"ل",1,0],["رأينا الهجو مخلوطا بعتب","ولم تدر الهجاء ولا العتابا",82,"ب",2,0],["رأيناك طورا في المشاكل راسبا","وطورا على أسوارها متسلقا",83,"ق",2