{"poems":[[88,"أجاد مطران كعاداته","https://www.aldiwan.net/poem10857.html","السريع"],[40,"إني حلفت يمينا غير كاذبة","https://www.aldiwan.net/poem7711.html","البسيط"],[87,"يموت في الغاب أو في غيره الأسد","https://www.aldiwan.net/poem62890.html","البسيط"],[45,"الرأي قبل شجاعة الشجعان","https://www.aldiwan.net/poem10580.html","الكامل"],[47,"ميلوا إلى الدار من ليلى نحييها","https://www.aldiwan.net/poem66851.html","البسيط"],[2,"هل تبلغني إلى الأخيار ناجية","https://www.aldiwan.net/poem25028.html","البسيط"],[69,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[50,"نك من لقيت من البشر","https://www.aldiwan.net/poem66623.html","مجزوء الكامل"],[48,"أحسن بالواجد من وجده","https://www.aldiwan.net/poem23628.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42586","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[92,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[87,"يموت في الغابِ أو في غيرِه الأسدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9599&r=&rc=89",""],[119,"يا من ولهت به والقلب طار له","https://www.aldiwan.net/poem40936.html","عموديه"],[137,"برء الإمام حياة الخلق كلهم","https://www.aldiwan.net/poem4214.html","البسيط"],[189,"بجلال قدرك تفخر الأزمان","https://www.aldiwan.net/poem14677.html","الكامل"],[215,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[216,"برق تبدى خفية بسناء","https://www.aldiwan.net/poem37922.html","الكامل"],[240,"طرقت ودون طروقها","https://www.aldiwan.net/poem32143.html","مجزوء الكامل"],[354,"لولا سنى ربة الخدر بدا","https://www.aldiwan.net/poem15643.html","الرجز"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[409,"العلم في قول لا إله إلا الله","https://www.aldiwan.net/poem33366.html","البسيط"],[484,"حرستك عين عناية","https://www.aldiwan.net/poem37026.html","مجزوء الكامل"],[484,"الله أكبر في ضريح واحد","https://www.aldiwan.net/poem37048.html","الكامل"],[484,"قالوا حبست فقلت ليس بضائري","https://www.aldiwan.net/poem37597.html","الكامل"],[520,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[543,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[558,"دار الغواني بدلت آياتها","https://www.aldiwan.net/poem68387.html","الكامل"],[558,"لولا سيوف أبي الزبير وخيله","https://www.aldiwan.net/poem68423.html","الكامل"],[567,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[580,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101545","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39132","الكامل"],[814,"","https://poetry.dctabudhabi.ae/diwan/poem/104450","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48760","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48678","الكامل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104629","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64774","السريع"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/74010","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144106","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144155","الرجز"],[1582,"","https://poetry.dctabudhabi.ae/diwan/poem/199219","الرجز"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66286","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69417","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46486","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109725","البسيط"],[2226,"","https://poetry.dctabudhabi.ae/diwan/poem/200273","السريع"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28555","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60877","البسيط"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100435","السريع"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75910","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65148","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48462","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138513",""],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101231","الكامل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46019","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132127","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131274",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131254",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114076","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199060","الكامل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93260","السريع"],[4994,"وجه واحد في مرايا القلب","https://www.poetsgate.com/ViewPoem.aspx?id=209098",""],[5026,"فراشة سكرى","https://www.poetsgate.com/ViewPoem.aspx?id=210477",""],[5183,"بين العزاء والبكاء","https://www.poetsgate.com/ViewPoem.aspx?id=180220",""],[5277,"من رسائل العيد","https://www.poetsgate.com/ViewPoem.aspx?id=204783",""],[5431,"أغنية الخليج 3","https://www.poetsgate.com/ViewPoem.aspx?id=202771",""],[5574,"آياتُ الدجى وهواجسُ عاشقٍ أدمن الليل","https://www.poetsgate.com/ViewPoem.aspx?id=206012",""],[5688,"لو كان يملك...","https://www.poetsgate.com/ViewPoem.aspx?id=200776",""],[5829,"دعوة الى الستر","https://www.poetsgate.com/ViewPoem.aspx?id=157070",""],[5956,"إلى الله تعالى كل فعل يصعد","https://www.poetsgate.com/ViewPoem.aspx?id=192595",""],[6093,"أَلِهَ المُعنى ما يُحيرُ جوابا","https://www.poetsgate.com/ViewPoem.aspx?id=177706",""]],"verses":[["لَولا سَليمٌ لَم يَقُل قائِلٌ","وَلَم يَجُد مَن جادَ بِالأَمسِ",0,"س",1,0],["لَولا سَعيدٌ أُرَجّي أَن أُلاقِيَهُ","ما ضَمَّني في سَوادِ البَصرَةِ الدورُ",1,"ر",1,0],["لَولا سِفارَتُكَ المَهدِيَّةُ اِختَصَما","وَمَلَّ طولَ النِضالِ الذِئبُ وَالنَقَدُ",2,"د",1,0],["لَولا سَمِيُّ سُيوفِهِ وَمَضاؤُهُ","لَمّا سُلِلنَ لَكُنَّ كَالأَجفانِ",3,"ن",1,0],["لَولا سَوادُ عِذارٍ لَيسَ يُسلِمُني","إِلى النُهى لَعَدَت نَفسي عَواديها",4,"ي",3,0],["لَولا سِنانٌ وَدَفعٌ مِن حُمُوَّتِهِ","ما زالَ مِنكُم أَسيرٌ عِندَ مُقتَسِرِ",5,"ر",1,0],["لَولا سألتَ اللَّهَ سُقيا رَحْمةٍ","ماتَتْ به الأحياءُ مما يَشربوا",6,"ب",3,0],["لولا سوادٌ في القمَر","واللَهِ ما حسُنَ القمَر",7,"ر",1,0],["لُوْلا سَجاياهُ وَأخْلاقُهُ","لكانَ كالمَعْدومِ في وُجْدِهِ",8,"د",2,0],["لَوْلا سُرَى الْبَدْرِ مَا اسْتَنَارَ وَلا","أَدْرَكَ شَأْوَ الْخِطَارِ مُنْجَرِدُ",9,"د",1,0],["لَولاَ سَنَا هَدْيِكَ في بَعْضِهمْ","لَدُكَّتِ الأرْضُ بِهِمْ أَجْمَعا",10,"ع",2,0],["لولا سموُّ مفاداةٍ لما احتَفَلتْ","هذي المحافلُ فياضاً بها الألم",11,"م",1,0],["لولا سِفارتُك المهديّة ُ اختصما","وملَّ النِّضالِ الذئبُ والنَّقد",12,"د",1,0],["لولا سناك الذي لاحت بوارقه","ما طاب لي ان يرى في برجه القمر",13,"ر",1,0],["لولا سياسته ما كان ملتئماً","شعثٌ ولا كانت الأسبابُ تنتظمُ",14,"م",1,0],["لولا سيوفُك ما استقرَّ لنا به","صومٌ ولا نُسكٌ ولا قرآن",15,"ن",1,0],["لولا سنا مصر في لألاء طلعته","ما كان يوما تبدّى نجم مطران",16,"ن",1,0],["لولا سعيدُ نجل سلطان أتى","زمني لَمَا قَدْ كُنْتُ في الأحياءِ",17,"ا",2,0],["لَولا سَحائِبُ رِفدِهِ","ما أَخضَرَّ لِلعافي جَنابُ",18,"ب",1,0],["لَولا سَنىً رَبَّةِ الخَدرِ بَدا","لَم يَدرِ حادي المُدلَجَينَ الرَشَدا",19,"د",2,1],["لَولا سُرورٌ هاجِرُ مُعتادُهُ","قَلباً عَصى وَالعيدُ بِالمُعَيِّد",20,"د",1,0],["لولا سيوف الألى ما سُمِعَتْ","من كافر لا إله إلا اللّه",21,"ل",2,0],["لولا سوابق لطفه","حفتك يا ابن الأكرمين",22,"ن",1,0],["لولا سلوي بالخيال لما أرى","حيا وأنت لدي غير مشاهد",23,"د",1,0],["لولا سناهم ما اهتديت لقصرهم","حاشا أكون لفضلهم بالناكر",24,"ر",1,0],["لولا سكون السكر في أجفانها","ما نابت الأقداح عن أحداقها",25,"ق",3,0],["لولا سَماحةُ جودِهِ وَوُجودِهِ","طَلَّقتُ هذا الرَّبعَ منذُ زَمانِ",26,"ن",1,0],["لَولا سُيوفُ اللَهِ مِن شَيبانَ قَد","فُلَّت سُيوفُ خَليفَةِ الرَحمانِ",27,"ن",1,0],["لَولا سُيوفُ أَبي الزُبَيرِ وَخَيلُهُ","نَشَرَ الوَليدُ بِسَيفِهِ الضَحّاكا",28,"ك",2,1],["لولا سَوادٌ لها ما أبيضَّ فَوْدِيَ عن","شَيبي ولا احمرَّ دمعي من تهاديهَا",29,"ي",3,0],["لولاَ سُرى القومِ وتعجيلُهم","عَجَّلت في القومِ شَقَاءَ الشَّفَار",30,"ر",1,0],["لولا سليمانٌ يُذيع مفاخراً","احي بها تحت التراب رفاتهُ",31,"ت",2,0],["لولا سماحُكَ بالمنام لَما سَرَى","فَلَكَ التَّفَضُّلُ بالزِّيارةِ لا لَهُ",32,"ل",2,0],["لولا سيوف أبيك القرم ما حجبت","عني لمى ثغرك الاستار والكلل",33,"ل",1,0],["لولا سياستك الرشيدة لم تضع","دعوى الغريم وفرصة المحتال",34,"ل",1,0],["لولا سماحة دينهم لبغوا على ال","أديان والأخلاق والعادات",35,"ت",1,0],["لولا سَناها وخدّاها لما عُبِدَت","كما تَعبَّدتُها نارٌ ولا نورُ",36,"ر",1,0],["لَولا سُرَى طَيْفِكمْ لم أَكُنْ","َأحْمَدُ مِنْ قبلِ الصَّباحِ السُّرى",37,"ر",2,0],["لولا سهامُ فتورِ طرفك لم أخل","أن اللواحظ للسهام كنائن",38,"ن",1,0],["لولا سرارُ البدرِ ما تمّ فهل","يؤيسُ من تمامه إذا امّحقْ",39,"ق",1,0],["لولا سرار البدر ما تمّ فهل","يؤيس من تمامه إذا امتحق",40,"ق",1,0],["لولا سُبَاتي ما ملكتماني","حتى تموتا أو تفارقاني",41,"ن",2,0],["لولا سقوط جنين فاطمة لما","أودى لها في كربلاء جنين",42,"ن",1,0],["لَولا سُيُوفُكُمُ البَواتِرُ لالتَقى","مَن بِالثُغورِ وَمِن بِبُرقَةِ مُنشِدِ",43,"د",1,0],["لَولا سُلوك يَمينه سبلَ النَدى","دَرَست وَلَم يُعلم لَهن رُسوم",44,"م",1,0],["لولا سفينةُ نومٍ منه تخرجنا","كنا غرقنا ولم يعلم بنا أحد",45,"د",1,0],["لولا سجاياه وأنفاسه","لكان كالمعدوم في وجده",46,"د",2,1],["لَولا سَنِيُّ الدَّولَةِ بنُ مُحَمَّدٍ","ما كانَ لِلمَعروفِ ذِكرٌ يُعرَفُ",47,"ف",1,1],["لولا سَمَاحُ جمالِ الدين من قدمٍ","لم يَسد عَارفةً بيضأ مسديها",48,"ي",3,0],["لولا سنا البدر وشمس الضحى","ما كان في الكون ضريباه",49,"ا",2,0],["لَولا سَوادٌ بِها مِنهُ لَما نَظَرَت","وَلَم يَكُن عاشِقٌ بِالعَينِ قَد سُحِرا",50,"ر",2,0],["لولا سرارٌ في البدُور لما انجلت","والسّيفُ لولا الغمدُ يركبهُ الصّدا",51,"د",2,0],["لوْلا سَحابٌ جاءَني من جودِه","ما كان رَيْبُ الحادِثاتِ بمنصِفِ",52,"ف",1,0],["لولا سر سارٍ منه","فيه ما أبرأ ما أنشر",53,"ر",1,0],["لولا سنا قرضابه الماضي الشبا","يجلو الدياجي والسنان الأزهر",54,"ر",1,0],["لَولا سَجايا اللُّؤمِ ما عُرفت وَلا","وَثُقَت خِلالٌ لِلعلى وَعُهودُ",55,"د",1,0],["لولا سياستهم بدين محمدٍ","وقيام دولتهم على القرآن",56,"ن",1,0],["لولا سفور الغيد لم تك فتنةٌ","للناظرين وحرقةٌ في الأضلع",57,"ع",1,0],["لولا سرارك في مواقته","لوددت أن لا أنظر السحرا",58,"ر",2,0],["لَولاَ سَنَى المُصطَفَى يَبدُو بِوَجهِكَ لِي","لَمَا تَخَلَّصَ ذاكَ القَابُ مِن قُوبِ",59,"ب",1,0],["لولا سياج عواطف قد عبرت","للناظرين فزادت الإصرارا",60,"ر",2,0],["لولا سنا فضلك يَجْلو الدُّجى","ما عُرِف المفضولُ والفاضل",61,"ل",1,0],["لولا سُليمى لما استحليتُ مُرَّ فمي","ولا العَنادلُ رقّتْ لي مَغانيها",62,"ي",3,0],["لولا *سَعيدٌ* مِنْ إدارة مِنْحَةٍ","أهدى إليَّ غمامَهُ كيْ يُمْطِرا",63,"ر",2,0],["لولا سحائب جفنه وسماؤها","لقضى على الدنيا بأحرق متلف",64,"ف",1,0],["لولا سمعتِ ضجيجَ القلبِ من شغفٍ","لقد تماهى ولم يُسمعْ له صوْتُ",65,"ت",1,1],["لولا سطوعك في ربى أرواحنا","لتآكل اليخضور في الأزهار",66,"ر",1,0],["١٠- لولا سُهادي لم أجُبْ في حلكتي","اِذهبْ أيا نومي وقَبِّلْ ثغرَهُ",67,"ر",2,0],["لولا سماحة خصمه","لقضى الليالي بالعويل",68,"ل",1,0],["لولا سألت الدهر عن أخبارهم","لعرفت أن ديارهم عفراء",69,"ا",2,0],["لولا سعادتُك التي أهديتَني","منها لما أعطيتُها لمنِ اجتدُوا",70,"د",3,0],["18. . لولا سمعتَ مقالتي فوعيْتَها","بلَّغتَ عنْ قلبِ الرءوم خطابا",71,"ب",2,0]]}