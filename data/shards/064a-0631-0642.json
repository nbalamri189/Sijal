{"poems":[[55,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[57,"أظاعنون فنبكي أم مقيمونا","https://www.aldiwan.net/poem26092.html","البسيط"],[57,"كيف المريض الذي تحمى عيادته","https://www.aldiwan.net/poem26216.html","البسيط"],[88,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[95,"يا بالغ الستين من عمره","https://www.aldiwan.net/poem11163.html","السريع"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[39,"نفى عن عينك الأرق الهجوعا","https://www.aldiwan.net/poem7654.html","الوافر"],[39,"وتو كاف الدموع على اكتساب","https://www.aldiwan.net/poem7676.html","المتقارب"],[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[53,"أيا فضل إنك فضل أصا","https://www.aldiwan.net/poem8176.html","المتقارب"],[53,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[53,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[72,"أتتك ولم تبعد على عاشق مصر","https://www.aldiwan.net/poem42920.html","الكامل"],[94,"بذر الحب بذره","https://www.aldiwan.net/poem38930.html","مجزوء الخفيف"],[87,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[58,"يرقد الناس آمنين وريب الدهر","https://www.aldiwan.net/poem58561.html","الطويل"],[45,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[64,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[47,"لعمرك ما لإسحاق بن سعد","https://www.aldiwan.net/poem11039.html","الوافر"],[47,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[47,"هبل الواشي بها أنى أفك","https://www.aldiwan.net/poem65215.html","الرمل"],[30,"جزى الله عني في الأمور مجاشعا","https://www.aldiwan.net/poem5285.html","الطويل"],[46,"يا برق طالع منزلا بالأبرق","https://www.aldiwan.net/poem30397.html","الكامل"],[71,"يرقص عجبا وله","https://www.aldiwan.net/poem28939.html","مجزوء الرجز"],[92,"ياسيدي أسعف فمي ليقولا","https://www.aldiwan.net/poem56781.html","عموديه"],[107,"يا بريد الدهر يمشي خفية","https://www.aldiwan.net/poem43137.html","الرمل"],[107,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[104,"لا تسل عن سلامته","https://www.aldiwan.net/poem33066.html","مجزوء الخفيف"],[104,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[48,"أنوار تحسب من سنا الأنوار","https://www.aldiwan.net/poem22703.html","الكامل"],[48,"لقد فنيت وهل تبقى إذا عمرت","https://www.aldiwan.net/poem23055.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85493","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85324","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42666","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[108,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[47,"هُبِلَ الوَاشِي بهَا، أنّى أفَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=33095",""],[96,"الكعبة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=12696",""],[112,"دنوا لقد أوهى تجلدي البعد","https://www.aldiwan.net/poem16228.html","الطويل"],[123,"يرى من ستور الغيب حتى كأنما","https://www.aldiwan.net/poem49290.html","الطويل"],[163,"يا طيب ما يهدى قبيل الفجر","https://www.aldiwan.net/poem58782.html","الرجز"],[169,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[198,"لمن الدار كعنوان الكتاب","https://www.aldiwan.net/poem54425.html","الرمل"],[214,"كل لفظ من حسين","https://www.aldiwan.net/poem46600.html","مجزوء الرمل"],[225,"يرق لوصفك الغزل","https://www.aldiwan.net/poem55425.html","مجزوء الوافر"],[226,"ملي النور قبل عهد البدور","https://www.aldiwan.net/poem39689.html","الخفيف"],[238,"هل أنت يا أخت القضيب الناضر","https://www.aldiwan.net/poem31983.html","الرجز"],[238,"أبثك مجد الدين حالا سماعها","https://www.aldiwan.net/poem32199.html","الطويل"],[244,"أشهرت فينا ظبا الحاظك السود","https://www.aldiwan.net/poem45766.html","الطويل"],[264,"منهل دمع المحب من دمه","https://www.aldiwan.net/poem38141.html","المنسرح"],[283,"بنفسي على قربه النازح","https://www.aldiwan.net/poem60778.html","المتقارب"],[285,"يرق الصخر لي مما أقاسي","https://www.aldiwan.net/poem32730.html","الوافر"],[293,"ويح قلبي الشجي كم ذا يعاني","https://www.aldiwan.net/poem11690.html","الخفيف"],[307,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[308,"فسحة العمر وإن طالت قصيره","https://www.aldiwan.net/poem56510.html","الرمل"],[331,"هتف الشاطىء بالمدح","https://www.aldiwan.net/poem55007.html","مجزوء الرمل"],[367,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[369,"عذول الهوى يبني بغير أساس","https://www.aldiwan.net/poem17018.html","الطويل"],[369,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[369,"يعز على محلي مفارقة القطر","https://www.aldiwan.net/poem17317.html","الطويل"],[371,"هل بالديار أن تجيب صمم","https://www.aldiwan.net/poem1879.html","السريع"],[374,"دنت فرأتني عاتبا متطرفا","https://www.aldiwan.net/poem57300.html","الطويل"],[383,"واحر غلة قلبي الوقاد","https://www.aldiwan.net/poem48838.html","الكامل"],[400,"يرقى الذرى ويعيش مغتباطا","https://www.aldiwan.net/poem11057.html","عموديه"],[403,"لله در بلادنا","https://www.aldiwan.net/poem6709.html","عموديه"],[419,"عشت الزمان بخفض العيش منتصبا","https://www.aldiwan.net/poem53964.html","البسيط"],[419,"يا ليلة في آخر الشهر","https://www.aldiwan.net/poem54175.html","أحذ الكامل"],[432,"للمرء في حادثات الدهر آمال","https://www.aldiwan.net/poem40075.html","البسيط"],[432,"يرق بدا ام ثغرك الجوهر","https://www.aldiwan.net/poem41418.html","السريع"],[435,"قد عصينا النهى فكيف النهاتا","https://www.aldiwan.net/poem12429.html","الخفيف"],[435,"تعود الطرد بها والطراد","https://www.aldiwan.net/poem12591.html","السريع"],[444,"عذاب الهوى في قلب من رامه عذب","https://www.aldiwan.net/poem14329.html","الطويل"],[454,"تنبهت في الروابي نسمة الفلق","https://www.aldiwan.net/poem13863.html","البسيط"],[454,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[455,"يا رذاذ الربيع يا معلن اليقظة","https://www.aldiwan.net/poem61337.html","الخفيف"],[455,"من أنبأ الغيد الحمائم أنه","https://www.aldiwan.net/poem61724.html","الكامل"],[460,"من طالب بي في الظباء العين","https://www.aldiwan.net/poem55833.html","الكامل"],[460,"حماها أن تشل وأن تراعا","https://www.aldiwan.net/poem56121.html","الوافر"],[460,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[463,"يسح نواله من غير شيم","https://www.aldiwan.net/poem16159.html","الوافر"],[466,"أشاقك برق بالشآم يشام","https://www.aldiwan.net/poem3487.html","عموديه"],[468,"أمسى الشباب مودعا محمودا","https://www.aldiwan.net/poem50445.html","الكامل"],[470,"يا من هو الأم لنا والأب","https://www.aldiwan.net/poem60460.html","السريع"],[481,"يا حائزا قصب سبق","https://www.aldiwan.net/poem37175.html","المجتث"],[481,"أيقظ شعورك واطرح برقع الكسل","https://www.aldiwan.net/poem37601.html","البسيط"],[502,"ودار بها قوم كرام ألفتهم","https://www.aldiwan.net/poem37788.html","الطويل"],[516,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[516,"سلام حكى في حسنه لؤلؤ العقد","https://www.aldiwan.net/poem20834.html","الطويل"],[371,"","https://poetry.dctabudhabi.ae/diwan/poem/20841","السريع"]],"verses":[["يَرقى إِلى أَمَدِ المَكارِمِ وَالعُلى","لَم تَختَزِلهُ مَوانِعُ الكِبرِ",0,"ر",1,0],["يَرِقُّ قَلبي لِأَهلِ العِشقِ أَنَّهُمُ","إِذا رَأَوني وَما أَلقى يَرِقّونا",1,"ن",2,0],["يُرقى لِيَسكُنَ ما يَلقى وَبي سَقَمٌ","مِن حُبِّهِ لازِمٌ ما إِن لَهُ راقِ",2,"ق",1,0],["يُرَقرِقُ فيهِ عَبيرَ الجِنانِ","فَتَستافُ مِنهُ النُهى وَالفِكَر",3,"ر",1,0],["يَرْقَى الذُّرَى وَيَعِيشُ مُغْتَبطاً","شَعْبُ عَلَى أَعْدَائِهِ خَشْنُ",4,"ن",1,0],["يَرقَدُّ في ظِلِّ عَرّاصٍ وَيَطرِدُهُ","حَفيفُ نافِجَةٍ عُثنونُها حَصِبُ",5,"ب",1,0],["يُرَقرِقُ أسجُمَاً دِرَرَاً وَسكبَاً","يُشَبَِّهُ سَحُّها غَربَاً هَمُوعَا",6,"ع",2,0],["يرقرق اسحما درا وسكنا","يشبه سحمها غربا هموعا",7,"ع",2,0],["يَرقُبُهُ مِن تَحتِهِ بِعَينِهِ","وَإِنَّما يَرقُبُهُ لِحينِهِ",8,"ه",1,0],["يَرقُّونَ للشيخِ منا العقيمِ","فيأتونَ من برِّه ما يجبْ",9,"ب",1,0],["يُرْقِلُ والرَّايَةُ في كفِّه","قد حَفَّها الرامحُ والناشبُ",10,"ب",1,0],["يرقدُ الطالبون وهْي إليهم","أرِقاتُ الوجيفِ والإرقالِ",11,"ل",1,0],["يَرقُصُ المَوج وَفي قاعِكَ حَربٌ لَن تَزولا","تَخلُقُ الأَسماكَ لَكِن تَخلُقُ الحوتَ الأَكولا",12,"ل",2,0],["يَرِقُّ وَيَقسو لِلعُفاةِ وَلِلعِدى","فَلِلَّهِ مِنهُ ذَلِكَ العُرفُ وَالنُكرُ",13,"ر",1,0],["يَرْقُبُ البَدْرَ جَفْنُهُ","لِيُناجيهِ مَا لَقى",14,"ق",2,0],["يَرقُبُ الرِفاقُ لَهُ","كُلَّما سَرى شَرِبوا",15,"ب",3,0],["يَرْقُدُ النّاسُ آمنينَ وَرَيْبُ الدَّ","هْرِ يَرْعاهُمُ بِمُقْلَةِ لِصَ",16,"ص",1,1],["يُرقِلنَ في الجَوِّ عَلى المَحالِ","في طُرُقٍ سَريعَةِ الإيصالِ",17,"ل",1,0],["يرقُبْنَ أوبةَ عصَّاءٍ عواذِلَهُ","في طاعةِ المجدِ محلالٍ ومظعانِ",18,"ن",1,0],["يَرِقُّ نَسيمُهُ في كُلِّ ريحٍ","تَهُبُّ بِهِ وَلَو هَبَّت جَنوبا",19,"ب",2,0],["يَرقُبُ القائِمُ المُؤَجَّلُ مِنهُم","ما اِبتَداهُ المُعَجَّلُ المَحصودُ",20,"د",1,0],["يَرقُبُ الأَعداءَ مِن رَوعاتِها","بَغَتاتُ الخَيلِ يَحمِلنَ الخِكَك",21,"ك",1,0],["يُرِقّونَ عَظمي ما اِستَطاعوا وَإِنَّما","أَشيدُ لَهُم بُنيانَ مَجدٍ وَأَرفَعُ",22,"ع",1,0],["يُرقى وَما هُوَ بِالسَليمِ وَيَغتَدي","دونَ السِلاحِ سِلاحَ أَروَعَ مُملِقِ",23,"ق",1,0],["يرقصُ عجباً ولهُ","عطفٌ وردفٌ مائجُ",24,"ج",1,1],["يَرْقَى الجبالَ مَصَاعِبَاً تَرْقَى بهِ","ويَعَافُ للمُتَحَدِّرينَ سُهولا",25,"ل",2,0],["يَرقُبُ الأَبناءَ فيما يَبتَغي","وَيَخافُ اللَهُ فيما يَفعَلُ",26,"ل",1,0],["يَرقى من الفاروقِ نَفْساً صعبةً","تأبى عَوارِمُها إذا ما تُعْجَم",27,"م",1,0],["يَرقبُ الساعةَ التي","بعدَها هولُ ساعتِهْ",28,"ه",1,0],["يَرقبون الأَطفال مِنا فَإِن لا","حوا رَموهم فَهالك وَكَليم",29,"م",1,0],["يُرقِلنَ في خَلَقِ الشِوارِ وَّفَوقَها","أَخلاقُ إِنسٍ لِلقَبيحِ شَواري",30,"ر",2,0],["يَرقى المُعَزِّمُ وِلداناً لِيورِثَهُم","نَفَعاً وَلا نَفَعَ إِلّا بُسلَةُ الراقي",31,"ق",2,0],["يَرقى العراق بما ينا","ل العلم فيه من الهبات",32,"ت",1,0],["يَرقى إليها مورياً","بالفكر في الظلماء زندا",33,"د",2,0],["يَرْقُبُ الشَّرَّ فَإِنْ لاحَتْ لَهُ","فُرْصَةٌ تَصْلُحُ لِلْخَتْلِ فَرَصْ",34,"ص",1,0],["يَرْقُبُ الله فِي الضِّعَافِ وَلا يَثْ","نِيهِ خَوْفٌ وَلا يَعُوقُ صِدَامُ",35,"م",1,0],["يَرْقَى السَّمَاعَ بِهَا وَإِنْ يَكُ نَبْرُهُ","لاَ يَرْتَقِي مَعْ فِكْرِهِ الْوَقَّالِ",36,"ل",1,0],["يرقى بنوه إلى العلا","ورقيُّه أمل كذوب",37,"ب",1,0],["يَرْقُبُ اٌلأَعْدَاءَ مِنْ رَوْعاتِها","بَغَتَاتُ اٌلخيْلِ يَحمْلْنَ الشَّكَكْ",38,"ك",1,0],["يرقّصها حينا وحينا يرجّها","ويوجز حالي هدأة ووثوب",39,"ب",1,0],["يَرق بِها خَوط المَحامد يانِعاً","وَيَعبَق مِن نَشر الفَخار بِها الرند",40,"د",1,0],["يرقرق أنداء العزاء على الأسى","ويضرم طوراً خامدات العزائم",41,"م",1,0],["يرقى الحزون كالسهول عزمه","ويقطع البحر كقطع البر",42,"ر",1,0],["يرقِّقُ طَبعَي المأيوسَ عنهُ","ويشحذُ غَرْبَهُ بعدَ الكلالِ",43,"ل",1,0],["يَرقُبُ الشَخصَ بِتالي طَرفِهِ","بَعدَما يَنضوا مَعانيقَ الرِكابِ",44,"ب",1,0],["يرقب الساعة في مصر الجديده","دارة الحسن وأعطاف الخريده",45,"ه",1,0],["يرق لوصفك الغزل","وتألف حسنك المقل",46,"ل",1,1],["يَرقُدُ الشاعِرُ الكَبيرُ مِراراً","إِنَّما السِرُّ في الرِقادِ الأَخيرِ",47,"ر",1,0],["يَرقُبُ مِنهُنَّ قَضاءَ ماطِلٍ","يَلوي الدِيونَ وَوَفاءَ غادِرِ",48,"ر",1,0],["يَرِقُّ وَيَبكي حاسِدي لِيَ رَحمَةً","وَبُعداً لَها مِن رِقَّةٍ وَبُكاءِ",49,"ا",2,0],["يرقى ذرا منبرِ التذكير عالمُهُم","فنجتلى منها عوداً على عُودِ",50,"د",1,0],["يرقى المعالي على الرؤوس علاً","إذا سواه رقى بسلمه",51,"م",2,0],["يَرِقُّ عَلَيْكَ الْعَدُوُّ الْمُبِينُ","وَيَرْثِي لَكَ الْحاسِدُ الْكاشِحُ",52,"ح",1,0],["يَرِقُّ الصَخرُ لي مِمّا أُقاسي","وَأَنتَ عَلَيَّ فَظُّ القَلبِ قاسِ",53,"س",1,1],["يرقد الأنبياءُ في ظل قسيون","وتبدو روائع العمران",54,"ن",1,0],["يرق لي الأحباب إذا مسني الضنى","وتشمت بي الحساد بين العشائر",55,"ر",1,0],["يَرقبُ اللّه على حالاتهِ","وَيرى أولاهُ للأُخرى ذَخيره",56,"ر",2,0],["يرقص الطل عليه","وتذيب الشمس تبرا",57,"ر",2,0],["يَرقُمُ الطِّرْسَ وهْو كالأرقَمِ النَّضْ","