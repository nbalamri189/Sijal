5691,"أمام المرآة","https://www.poetsgate.com/ViewPoem.aspx?id=206736",""],[5720,"الطبيعةُ في جَبلِ الأَنِي","https://www.poetsgate.com/ViewPoem.aspx?id=201633",""],[5757,"سَعَفُ الحنينْ","https://www.poetsgate.com/ViewPoem.aspx?id=95116",""],[5759,"قلادة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=213395",""],[5781,"قارئ كفّ","https://www.poetsgate.com/ViewPoem.aspx?id=208937",""],[5781,"الحسنُ أنتَ والحياة...","https://www.poetsgate.com/ViewPoem.aspx?id=208993",""],[402,"لغت أقصى العمر الفاني","https://www.poetsgate.com/ViewPoem.aspx?id=36477",""],[5853,"مواثيق الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=175624",""],[5906,"ليڤانا","https://www.poetsgate.com/ViewPoem.aspx?id=188239",""],[5910,"حيِّ الطلولَ ونبِّ عن أخبارِها","https://www.poetsgate.com/ViewPoem.aspx?id=206239",""],[5956,"فؤادي غير مقتنع","https://www.poetsgate.com/ViewPoem.aspx?id=182482",""],[5956,"صديقي الرُّوحيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=194005",""],[5956,"زميلي غير مقتنع","https://www.poetsgate.com/ViewPoem.aspx?id=196804",""],[6009,"أودى الشباب حميدا ذو التعاجيب","https://www.poetsgate.com/ViewPoem.aspx?id=182950",""],[6070,"على نسماتِها غنى البَهاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=188125",""],[6102,"هي .. هي","https://www.poetsgate.com/ViewPoem.aspx?id=185304",""],[6124,"يرقص اللحن","https://www.poetsgate.com/ViewPoem.aspx?id=193268",""],[6124,"عصفور الكناري","https://www.poetsgate.com/ViewPoem.aspx?id=201240",""],[456,"حنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84503&r=&rc=2",""],[6237,"نفحة الياسمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77901&r=&rc=43",""],[6268,"إضاءة في خيمة الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82915&r=&rc=1",""],[4228,"في الموحي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66131&r=&rc=2",""]],"verses":[["يَرقى إِلى أَمَدِ المَكارِمِ وَالعُلى","لَم تَختَزِلهُ مَوانِعُ الكِبرِ",0,"ر",1,0],["يَرِقُّ قَلبي لِأَهلِ العِشقِ أَنَّهُمُ","إِذا رَأَوني وَما أَلقى يَرِقّونا",1,"ن",2,0],["يُرقى لِيَسكُنَ ما يَلقى وَبي سَقَمٌ","مِن حُبِّهِ لازِمٌ ما إِن لَهُ راقِ",2,"ق",1,0],["يُرَقرِقُ فيهِ عَبيرَ الجِنانِ","فَتَستافُ مِنهُ النُهى وَالفِكَر",3,"ر",1,0],["يَرْقَى الذُّرَى وَيَعِيشُ مُغْتَبطاً","شَعْبُ عَلَى أَعْدَائِهِ خَشْنُ",4,"ن",1,0],["يَرقَدُّ في ظِلِّ عَرّاصٍ وَيَطرِدُهُ","حَفيفُ نافِجَةٍ عُثنونُها حَصِبُ",5,"ب",1,0],["يُرَقرِقُ أسجُمَاً دِرَرَاً وَسكبَاً","يُشَبَِّهُ سَحُّها غَربَاً هَمُوعَا",6,"ع",2,0],["يرقرق اسحما درا وسكنا","يشبه سحمها غربا هموعا",7,"ع",2,0],["يَرقُبُهُ مِن تَحتِهِ بِعَينِهِ","وَإِنَّما يَرقُبُهُ لِحينِهِ",8,"ه",1,0],["يَرقُّونَ للشيخِ منا العقيمِ","فيأتونَ من برِّه ما يجبْ",9,"ب",1,0],["يُرْقِلُ والرَّايَةُ في كفِّه","قد حَفَّها الرامحُ والناشبُ",10,"ب",1,0],["يرقدُ الطالبون وهْي إليهم","أرِقاتُ الوجيفِ والإرقالِ",11,"ل",1,0],["يَرقُصُ المَوج وَفي قاعِكَ حَربٌ لَن تَزولا","تَخلُقُ الأَسماكَ لَكِن تَخلُقُ الحوتَ الأَكولا",12,"ل",2,0],["يَرِقُّ وَيَقسو لِلعُفاةِ وَلِلعِدى","فَلِلَّهِ مِنهُ ذَلِكَ العُرفُ وَالنُكرُ",13,"ر",1,0],["يَرْقُبُ البَدْرَ جَفْنُهُ","لِيُناجيهِ مَا لَقى",14,"ق",2,0],["يَرقُبُ الرِفاقُ لَهُ","كُلَّما سَرى شَرِبوا",15,"ب",3,0],["يَرْقُدُ النّاسُ آمنينَ وَرَيْبُ الدَّ","هْرِ يَرْعاهُمُ بِمُقْلَةِ لِصَ",16,"ص",1,1],["يُرقِلنَ في الجَوِّ عَلى المَحالِ","في طُرُقٍ سَريعَةِ الإيصالِ",17,"ل",1,0],["يرقُبْنَ أوبةَ عصَّاءٍ عواذِلَهُ","في طاعةِ المجدِ محلالٍ ومظعانِ",18,"ن",1,0],["يَرِقُّ نَسيمُهُ في كُلِّ ريحٍ","تَهُبُّ بِهِ وَلَو هَبَّت جَنوبا",19,"ب",2,0],["يَرقُبُ القائِمُ المُؤَجَّلُ مِنهُم","ما اِبتَداهُ المُعَجَّلُ المَحصودُ",20,"د",1,0],["يَرقُبُ الأَعداءَ مِن رَوعاتِها","بَغَتاتُ الخَيلِ يَحمِلنَ الخِكَك",21,"ك",1,0],["يُرِقّونَ عَظمي ما اِستَطاعوا وَإِنَّما","أَشيدُ لَهُم بُنيانَ مَجدٍ وَأَرفَعُ",22,"ع",1,0],["يُرقى وَما هُوَ بِالسَليمِ وَيَغتَدي","دونَ السِلاحِ سِلاحَ أَروَعَ مُملِقِ",23,"ق",1,0],["يرقصُ عجباً ولهُ","عطفٌ وردفٌ مائجُ",24,"ج",1,1],["يَرْقَى الجبالَ مَصَاعِبَاً تَرْقَى بهِ","ويَعَافُ للمُتَحَدِّرينَ سُهولا",25,"ل",2,0],["يَرقُبُ الأَبناءَ فيما يَبتَغي","وَيَخافُ اللَهُ فيما يَفعَلُ",26,"ل",1,0],["يَرقى من الفاروقِ نَفْساً صعبةً","تأبى عَوارِمُها إذا ما تُعْجَم",27,"م",1,0],["يَرقبُ الساعةَ التي","بعدَها هولُ ساعتِهْ",28,"ه",1,0],["يَرقبون الأَطفال مِنا فَإِن لا","حوا رَموهم فَهالك وَكَليم",29,"م",1,0],["يُرقِلنَ في خَلَقِ الشِوارِ وَّفَوقَها","أَخلاقُ إِنسٍ لِلقَبيحِ شَواري",30,"ر",2,0],["يَرقى المُعَزِّمُ وِلداناً لِيورِثَهُم","نَفَعاً وَلا نَفَعَ إِلّا بُسلَةُ الراقي",31,"ق",2,0],["يَرقى العراق بما ينا","ل العلم فيه من الهبات",32,"ت",1,0],["يَرقى إليها مورياً","بالفكر في الظلماء زندا",33,"د",2,0],["يَرْقُبُ الشَّرَّ فَإِنْ لاحَتْ لَهُ","فُرْصَةٌ تَصْلُحُ لِلْخَتْلِ فَرَصْ",34,"ص",1,0],["يَرْقُبُ الله فِي الضِّعَافِ وَلا يَثْ","نِيهِ خَوْفٌ وَلا يَعُوقُ صِدَامُ",35,"م",1,0],["يَرْقَى السَّمَاعَ بِهَا وَإِنْ يَكُ نَبْرُهُ","لاَ يَرْتَقِي مَعْ فِكْرِهِ الْوَقَّالِ",36,"ل",1,0],["يرقى بنوه إلى العلا","ورقيُّه أمل كذوب",37,"ب",1,0],["يَرْقُبُ اٌلأَعْدَاءَ مِنْ رَوْعاتِها","بَغَتَاتُ اٌلخيْلِ يَحمْلْنَ الشَّكَكْ",38,"ك",1,0],["يرقّصها حينا وحينا يرجّها","ويوجز حالي هدأة ووثوب",39,"ب",1,0],["يَرق بِها خَوط المَحامد يانِعاً","وَيَعبَق مِن نَشر الفَخار بِها الرند",40,"د",1,0],["يرقرق أنداء العزاء على الأسى","ويضرم طوراً خامدات العزائم",41,"م",1,0],["يرقى الحزون كالسهول عزمه","ويقطع البحر كقطع البر",42,"ر",1,0],["يرقِّقُ طَبعَي المأيوسَ عنهُ","ويشحذُ غَرْبَهُ بعدَ الكلالِ",43,"ل",1,0],["يَرقُبُ الشَخصَ بِتالي طَرفِهِ","بَعدَما يَنضوا مَعانيقَ الرِكابِ",44,"ب",1,0],["يرقب الساعة في مصر الجديده","دارة الحسن وأعطاف الخريده",45,"ه",1,0],["يرق لوصفك الغزل","وتألف حسنك المقل",46,"ل",1,1],["يَرقُدُ الشاعِرُ الكَبيرُ مِراراً","إِنَّما السِرُّ في الرِقادِ الأَخيرِ",47,"ر",1,0],["يَرقُبُ مِنهُنَّ قَضاءَ ماطِلٍ","يَلوي الدِيونَ وَوَفاءَ غادِرِ",48,"ر",1,0],["يَرِقُّ وَيَبكي حاسِدي لِيَ رَحمَةً","وَبُعداً لَها مِن رِقَّةٍ وَبُكاءِ",49,"ا",2,0],["يرقى ذرا منبرِ التذكير عالمُهُم","فنجتلى منها عوداً على عُودِ",50,"د",1,0],["يرقى المعالي على الرؤوس علاً","إذا سواه رقى بسلمه",51,"م",2,0],["يَرِقُّ عَلَيْكَ الْعَدُوُّ الْمُبِينُ","وَيَرْثِي لَكَ الْحاسِدُ الْك