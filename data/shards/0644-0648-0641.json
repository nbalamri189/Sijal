em.aspx?id=180164",""],[5212,"وليدُ الكعبة","https://www.poetsgate.com/ViewPoem.aspx?id=212040",""],[5213,"أرح قلوصك من كد ومن تعب","https://www.poetsgate.com/ViewPoem.aspx?id=170412",""],[5215,"كلا السوادين من قلبِي وَمن بَصرِي","https://www.poetsgate.com/ViewPoem.aspx?id=187590",""],[5409,"يومٌ بزغت بأفقه مولودا","https://www.poetsgate.com/ViewPoem.aspx?id=155488",""],[5527,"قصيدة الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180853",""],[5563,"موشح الحسن والدلال","https://www.poetsgate.com/ViewPoem.aspx?id=215993",""],[5582,"أَعَلَى المُحِبِّ المُسْتَهامِ مَلامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187304",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5688,"في القلب غرام هدهده","https://www.poetsgate.com/ViewPoem.aspx?id=200845",""],[5703,"إبعد","https://www.poetsgate.com/ViewPoem.aspx?id=207493",""],[5725,"ما زلت روحا","https://www.poetsgate.com/ViewPoem.aspx?id=197850",""],[5739,"أمواق الغمام ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127362",""],[5764,"بعطيك قصه !","https://www.poetsgate.com/ViewPoem.aspx?id=162640",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[5821,"يايمه","https://www.poetsgate.com/ViewPoem.aspx?id=115432",""],[5952,"نِلْتُ خُفَّا","https://www.poetsgate.com/ViewPoem.aspx?id=201759",""],[5952,"لو فيه أفنيْ الحبرَ والقرطاسا","https://www.poetsgate.com/ViewPoem.aspx?id=202324",""],[5956,"ديمقراطية الدمويِّين","https://www.poetsgate.com/ViewPoem.aspx?id=192364",""],[5956,"الكآبة الفنية","https://www.poetsgate.com/ViewPoem.aspx?id=192705",""],[5956,"آهِ لولا بعضُ أصحابي الغيارى","https://www.poetsgate.com/ViewPoem.aspx?id=193816",""],[5956,"عطفك السابغ يجري في حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=194596",""],[5956,"تَبّتْ يداْ وطن العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=194827",""],[5989,"ما كنتُ بدعاً من العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=183969",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[2575,"يا فرحة العمر","https://www.poetsgate.com/ViewPoem.aspx?id=22532",""],[6242,"نبض للمعلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87567&r=&rc=14",""]],"verses":[["لَو فَطَنَت بِالقِرى سَوائِمُهُ","لَما مَشَت تَحتَ وَفدِهِ النَعَمُ",0,"م",1,0],["لوْ فاتَ عاديَةَ المَنونِ مُشَيَّعٌ","لنَجا بمُهْجَتِهِ الهِزَبْرُ الضّاري",1,"ر",2,0],["لَو في طُهَيَّةَ أَحلامٌ لَما اِعتَرَضوا","دونَ الَّذي كُنتُ أَرميهِ وَيَرميني",2,"ن",2,0],["لَو فَدَى الحَيُّ مَيِّتاً قُلتُ نَفسِي","وَبَنِيَّ الفِدى لِتِلكَ العِظامِ",3,"م",1,0],["لو فرَّ مصطَنَعٌ من عُرْف مصطنعٍ","عَجْزاً عن الشكر لم نُسبق إلى الهَرَبِ",4,"ب",1,0],["لو فُلِقَتْ عنْهُ لأبصرتَهُ","مثلَ الظلام الحالك الغيهبِ",5,"ب",1,0],["لو فات شيء مدى ميقاته انكدرتْ","زُهرُ النجوم عليه كلَّ مُنكَدَر",6,"ر",1,0],["لو فتكتْ مرّةً مكائِدُهُ","بالدهر أنستْه فتك برَّاضه",7,"ض",2,0],["لَو فَقِهنا مِثلَهُم مَعنى الحَياة","ما أَضَعناها بُكاءً في الطُلول",8,"ل",1,0],["لَو فَعَلتُم فِعلَ أَجدادِكُم","ما قَضى الظالِمُ مِنكُم وَطَرَه",9,"ر",2,0],["لَو فاتَني كُلُّ ما في الأَرضِ مِن ذَهَبٍ","وَلَم تَفُتني فَإِنّي غَيرُ مَغبونِ",10,"ن",1,0],["لَو فَعَلتُم بِمُهجَتي ما فَعَلتُم","لَم يَحُل فيكُمُ صَحيحُ اِعتِقادي",11,"د",2,0],["لَو فَكَّرَ العاشِقُ في مُنتَهى","حُسنِ الَّذي يَسبيهِ لَم يَسبِهِ",12,"ب",2,0],["لَو فُرِّقَ الكَرَمُ المُفَرِّقُ مالَهُ","في الناسِ لَم يَكُ في الزَمانِ شَحيحُ",13,"ح",1,0],["لَوَفدُ نُمَيرٍ كانَ أَرشَدَ مِنهُمُ","وَقَد طَرَدوا الأَظعانَ طَردَ الوَسائِقِ",14,"ق",1,0],["لَو فَطِنَت خَيلُهُ لِنائِلِهِ","لَم يُرضِها أَن تَراهُ يَرضاها",15,"ا",3,0],["لَو فَعَلوا فِعلَكَ لَاستَوجَبوا","أَكثَرَ ما يَأمُلُهُ الراجي",16,"ج",2,0],["لَو فَرَضنا أَنَّ الهَدِيَّةَ لا تَج","مُلُ إِلّا نِهايَةَ المَطلوبِ",17,"ب",1,1],["لَو فَعَلتُم مَعَ المُحِبِّ صَوابا","ما جَعَلتُم تَركَ الجَوابِ جَوابا",18,"ب",2,1],["لو في الضلوع أجلتِ عينك أبصرت","مُنهارةً تبكي على منهار",19,"ر",1,0],["لَو فَرَّ شَيءٌ قَطُّ مِن شَكلِهِ","فَرَّ إِذَن بَعضُكَ مِن بَعضِ",20,"ض",1,0],["لَو فاحَ عودٌ في النَدِيِّ وَذِكرُهُ","لَعَلا بِطيبِ الذِكرِ طيبَ العودِ",21,"د",1,0],["لوفاةِ الكمالِ في العجمِ وهنٌ","فلقدْ أكثروا عليهِ التعازي",22,"ي",1,1],["لو في يدي رُقْيَةٌ أشفِي الصّريعَ بها","إذن شفيتُك إنّ النّاسَ إخوانُ",23,"ن",1,0],["لَو فارَقَ الناسَ أَو طاحَ الزَوالُ بِهِ","إِذَن لَزالَ عَناءُ العَيشِ وَالتَعَبُ",24,"ب",1,0],["لَو فَكَّرَت طُلُبُ الغِنى في ذاهِبِ الأَ","كوارِ ما قَعَدَت عَلى الأَكوارِ",25,"ر",1,0],["لو في بناء المجد ذلك الدمُ","بل عمدوا لما بَنَوْا فَهدَموا",26,"م",3,0],["لَوْ فُوضِلَتْ أَسْمَاءُ رَبِّكَ تُوَجِّتْ","أَسْمَاءُهُ الحُسْنَى بِوَصْفِ الوَاهِبِ",27,"ب",1,0],["لوْ فِي سِوَاكَ شَهِدْتَ مَا كَابَدْتَهُ","لَمْ يَعْصِ جَفْنَكَ دمْعُهُ المِدْرَارُ",28,"ر",1,0],["لَوْ فِي عُلاَهَا فَرْقَدانِ لَهَانَ مَا","تَلْقَى وَكَانَ لَهَا العَزَاءُ بِفَرْقَد",29,"د",1,0],["لَو فَدَتهُ لَأَفادَت فخاراً","غُلُبٌ مَن غالِبٍ وَعَدِيِّ",30,"ي",1,0],["لو فرضنا أن ميتاً يفتدى","لغدت روحي أدنى مبتذل",31,"ل",1,0],["لَوْ في يدي لحَبَسْتُ الغيثَ عن وطَنٍ","مُسْتَسْلِمٍ وقَطعتُ السلسلَ الجاري",32,"ر",2,0],["لو فات شيء مدى ميقاته انكدرتْ","زُهرُ النجوم. من كل منكدَرِ",33,"ر",1,0],["لَو فوّق الحَظ سَهماً مِن كِنانتِهِ","وَكانَ مِن خَلف قاف لَم يَفت غَرَضي",34,"ي",1,1],["لوفاة الإمام ذي العدل سلط","ان بن سيف تُحرِّكُ الآبادَا",35,"د",2,0],["لو في زراعته نصيبٌ وافِرٌ","ما أطنبت في ذَمِّهِ الصُّلحاءُ",36,"ا",2,0],["لو فاخرتْ في الليل بدرَ الدجى","لكان بالفضل لها يُحَكمُ",37,"م",1,0],["لَو فَتَّرَت حَتّى يَجيءَ أَمامَها","فِتراً لَما أَمِنَ الوَرى أَن تَرجِعا",38,"ع",2,0],["لَو فارَقَ الجُدرانَ أَصبَحَ جَمعُهُ","ما بَينَ مُنحَطِمِ الوَشيجِ حُطاما",39,"م",2,0],["لَوْ فَجَعَ البَيْنُ قلبَ صَبٍّ","ذابَ ولوْ كانَ مِنْ حَديدِ",40,"د",1,0],["لو فَرَشتَ الطريقَ دُرّاً لِأَحظو","فَوقَهُ نحوَ داركُم ما رَضيتُ",41,"ت",1,0],["لو فهِموا أو عقلوا لاستحَوْا","أن يجعلوا المِرِّيخَ كالبدر",42,"ر",1,0],["لو فُرِش المجلس بالدُرّ","نَضْداً وبالياقوت والتِّبْرِ",43,"ر",1,1],["لو فتَّشوا جِسْميَ ما أبصروا","غيرَ الأسى يَسْرَح بين الثّياب",44,"ب",1,0],["لَو فاخَرَ البَحرَ جَدوى راحَتيه غدا","قَفراً وغاضَت على غيظٍ طوافحُهُ",45,"ح",2,0],["لَو فاخَرَته الطِباقُ السَبعُ لاِنتكسَت","وَعادَ كوكبُها الدُريُّ مَكبوتا",46,"ت",2,0],["لو فوضت أمرها لخالقها","وصححت صدقها وتكلاها",47,"ا",3,0],["لَو فاتَ شَيءٌ يُرى لَفاتَ اَبو","حَيّانَ لا عاجِزٌ وَلا وَكِلُ",48,"ل",1,1],["لَو فور الاجور وَالرُتبَة العل","يا وَحسنى من ربنا وَزيادَه",49,"د",2,0],["لو فَرَّغ الدّهرُ فِكْري من شَواغلِه","أطلْتُ بالمجلسِ المَعْمورِ مُعتَكَفي",50,"ف",2,0],["لو فَتَّشُوها وجَدوا كلَّ ما","يَملِكُهُ في بَيتِهِ فِيها",51,"ه",2,0],["لَو فَتَّشوا قَلبي رَأوا وَسطَهُ","سَطرَينِ قَد خُطّا بِلا كاتِبِ",52,"ب",1,1],["لو فارق الراحلون عنه","بحراً لدسناه بالنعالِ",53,"ل",1,0],["لو فُلُّ غَربُ الموت عن متدرِّعٍ","بعفافه أو ناسكٍ متعزِّلِ",54,"ل",1,0],["لَو فُصِّلَت ساعاتُها","كادَت تَكونُ سَوالِفا",55,"ف",2,0],["لَو فاتَهُ النَسَبُ الوَضّاحُ كانَ لَهُ","مِن فَضلِهِ نَسَبٌ يُغني عَن النَسَبِ",56,"ب",1,0],["لو فاضَ طوفانُ نوحٍ من ندى يدِه","لما نَجا منهُ بالألواحِ والدُّسُرِ",57,"ر",1,0],["لو في سِباخِ الأرضِ يمطُرُ كفُّهُ","بالتِبْرِ فيها نوّرَ الفَيروزَجُ",58,"ج",1,0],["لو فرشنا الأحداق حتى تطاهن","لقلت في حقك الأحداق",59,"ق",1,0],["لو فتشنا عدولنا لخجلنا","ووجدنا صفو الرجال حثالة",60,"ل",2,0],["لِوَفْدِ الْمَعالِي غدَتْ رِحْلَةٌ","بِهِمْ ولِوَفْدِ المعَاني مَزَارا",61,"ر",2,0],["لو فات تشعيثُ الزّمان فتىً","فات الأصمَّ اليابسَ الجَلْدُ",62,"د",1,0],["لَو فَقَدتهُ يَوماً","لَاِغبَرَّتِ البِلادُ",63,"د",1,0],["لو فعلوا ذلك بوجه الحق","لم يعدهم فيها ولي الخلق",64,"ق",1,0],["لو فسحة الآجالُ يمنع طاهر","لك طال عمر في الصلاح مديد",65,"د",1,0],["لو في ليل الدجايا","يتداقلن وصنوت",66,"ت",1,0],["لَو فَوَّقت نَبلَها نحوَ الخليِّ غَدا","يَهيمُ في عِشقِها وَلهانَ غير خلي",67,"ل",2,0],["لو في الثريا العلم كان لناله","منهم رجال فهمهم وقاد",68,"د",1,0],["لَوْ فُرّقَتْ عزمَاته وهبَاته","فِي النَّاسِ لَمْ يَكُ بَاخلٌ وَجبَانُ",69,"ن",1,0],["لَو في رِياض الوردِ جزت تَشابهت","في حُسنها الأزهارُ والأزهارُ",70,"ر",1,0],["لَو في السَما للإنسِ يحسنُ مقعد","يوماً لكان له هنالك مقعدُ",71,"د",1,0],["لو في يديَّ حساب أيّامي إذن","لصَرَفتُهُنّ تعجّلاً لوفاتي",72,"ت",2,0],["لو فكروا في جرم هذا المشرق","حتى يرى بمغرب ومشرق",73,"ق",1,0],["لَو فَكروا في جرم ذاكَ الكَوكَب","حَتّى يَرى بِمشرق وَمَغرب",74,"ب",1,0],["لو فارقوا الجنَّةَ معْ حُسنِها","ماتَ من الوَحشة رِضوانُ",75,"ن",1,0],["لَو فَضَّ لُؤمُها بِكُلِّ قَبيلَةٍ","مَلَأَ البِلادَ حُزونَها وَرِمالَها",76,"ل",3,0],["لو فاخرت نهرَ المجرَّة في السما","غلبت بجعفر جودها المورود",77,"د",1,0],["لو فاخرت ذات العماد بيوتها","عادتْ مقوَّضةً بغير عماد",78,"د",1,0],["لو فات راكبَها خيالُ خليله","وسرى عليها نال منه منالا",79,"ل",2,0],["لو فتَّش الملك الحفيظ كتابه","ما شام فيه نقيصة تخشاها",80,"ا",3,0],["لو فتش الملكان صحفهما لما","وجدا له شيئاً من الأوزار",81,"ر",1,0],["لو فكّر العاقلُ في نفسهِ","مدةَ هذا الخلق في العمرِ",82,"ر",1,0],["لو فظ رقيق ضم معنى رائقا","للفهم يدنو وهو نائي المنزع",83,"ع",1,0],["لَو فاضَتِ المُهَجاتُ يَومَ وَفاتِهِ","ما اِستُكثِرَت فِيهِ فَكَيفَ الأَدمُعُ",84,"ع",1,0],["لو فَدى الحيُّ ميتاً لفدت نَف","سَكَ نَفسي بطار في وتليدي",85,"د",2,0],["لوفيك ما في من وجد ومن شجن","يا عاذلي في الهوى ما كنت تعذلني",86,"ن",2,1],["لو فاتَني المَدْحُ قنعْتُ بالدُّعا","وليسَ للإنسانِ إلاّ ما سعى",87,"ع",2,0],["لو في بنى الجار ابن موله طنبت","أو تاديبتى ما أعيد بمغنم",88,"م",1,0],["لو فكر الناظر فيه رأى","بأنه المختار عن اضطرار",89,"ر",1,0],["لو فاح ريح حبيبة من حبها","فاحت رياح حبيبتي من ريحي",90,"ي",1,1],["لَو فَدى الحَيُّ مَيَّتاً لَفَدَينا","كِ رَخيصاً إِن كانَ أَو بِغَلاءِ",91,"ا",2,0],["لو في بحار العيون","اتأمّلوا مثلنا",92,"ن",2,0],["لو فرست فرسان أهل التهم","ما قدموا الخيل أمام السوم",93,"م",1,0],["لوفاة قاضي القضاة","بمن بعده يقتدي",94,"ي",1,0],["لو فهمنا حلى الكمال فهمنا","بالمعاني لراح يهوى النقوشا",95,"ش",2,0],["لَو فكَّرُوا لاستبانُوا أنَّهُم نَعَمٌ","بل هُم أَضلُّ ولكِنَّ النُّهَى قَسَمُ",96,"م",1,0],["لو فكر المغرور قبل وقوعه","ما بات يجني عكس ما يتوقع",97,"ع",1,0],["لو فدتني كلُّ نفس","كان في حقّي قليلا",98,"ل",2,0],["لَو فَضَا الشّكلُ شُمتَ لاهُوتَ قُدسٍ","بِاكتِسَا هَيكَل الأَنامِ حَكَاهَا",99,"ا",3,0],["لو في سوى مصر اتخذت مذاهبي","لملأت من ذهب الفدى أخراجي",100,"ج",2,0],["لَو فتّشوا أَضلعي لما وَجَدوا","غير هموم هَواك موجدها",101,"د",3,0],["لَو في رِياض المَجد قُلت مُؤرِخاً","لِأَني النَسيمُ مُبَشِراً بِمُحَمَد",102,"د",1,0],["لَو في الملاحَةِ عَن شَمسِ النَّهارِ غنىً","كَفيتِ رَمضاءَها مُستَوطِنَ الشامِ",103,"م",1,0],["لو فاخر الكون أكواناً تناظره","كنت الفخار فأبدت ذلة العقم",104,"م",1,0],["لو فرّ من حتفه وليدٌ","لكنت في رحبها تفرّ",105,"ر",1,0],["لو فرضنا صورة شبههما","فالتضاهي مستحيل في المعاني",106,"ن",2,0],["لو فكروا جعلوا الضري","ح بجانب المهد الوثير",107,"ر",1,0],["لو في حزيران هممت بغسلها","غطى ضياء الشمس جو سحاب",108,"ب",1,0],["لَو فَصّلوا سِمطاً بِبَعضِ فتوحِهِ","سَخِرت بما اِفتَعلوا لهم فِعلاتُهُ",109,"ت",2,0],["لو فر من رزقه عبدٌ إلى جبلٍ","دون السماءِ لألفى رزقهُ فيه",110,"ي",2,0],["لو في متون العيس همي لانثنت","ملسا رمين الأرض بالأثقال",111,"ل",1,0],["لو فاض بحر الدجى وامتد زاخره","قلتم لافكاركم في قعره عومي",112,"م",2,0],["لَو فازَ بِنَشرِها بِوالي رِمَمٍ","بِالطَبع قبيلَ بَعثِهنَّ اِنبَعَثَت",113,"ت",1,0],["لو فاخر البان يوما","لقال ما أنا قدك",114,"ك",1,0],["لو في زمانِ رسول الله كنتَ أتت","في هذه السيرةِ المحمودةِ السورُ",115,"ر",1,0],["لو فتحت الستر هذا عنوة","لرأى كيف يفر الجؤذر",116,"ر",1,0],["لوفاة شيخ قد ثوى","تحت الثرى بعد الثراء",117,"ا",2,0],["لوفاةِ شيخ لمسلمين بمذهبٍ","أنوارهُ يعْنُو لها القمران",118,"ن",1,0],["لو فيك أمعن كل من","يوما تكلم أو رقم",119,"م",1,1],["لو في يدي سحري وعندي أخذةٌ","لجعلت قلبك بعض حين يعشق",120,"ق",1,0],["لو فاخرت كل البلاد بان في","ها بطرس لكفى بذلك مفخرا",121,"ر",2,0],["لو في رضاك بذلتُ كل جوارحي","كنتُ الضنينَ وما بذلتُ قليل",122,"ل",1,0],["لو فاض في أحشاي ماؤك كلهُ","ما أطفأت منها المياهُ غليلا",123,"ل",2,0],["لو في البكى امسيت واصبحت خنسا","شروى خلوج دوم حنت وخالت",124,"ت",1,0],["لو فتشوا قلبي رأوا مما بهِ","أبدً أصور شخصه تمثاله",125,"ل",2,0],["لوفي يدي شي ماقلت الوعد بكره","حزمت حدب الضلوع وقلتلك هيّا",126,"ي",2,0],["لو فرعُها سام ٍعلَا بشَمائلٍ","وفؤادَها أهْدتْ... لماذا القسوهْ؟",127,"و",2,0],["(لو فيه ميزه نايفه ماياصلَه كود الرجال","بتْشوف ياكثر العرب اللي تْهفي من دونها)",128,"ن",3,0],["لو في جدار تخط صورته","لماج في كف من يصوره",129,"ه",1,0],["لو فاض طرفٌ رآها بالجمال جرى","بكل بحرٍ جمال شقّه البصر",130,"ر",1,0],["لَوْ فَكَّرَ الْمَرْءُ فِي الدُّنْيَا وَقِيمَتِهَا","صِفْراً سَيَحْصِي وَلَنْ يُجْدِيهِ إِعْرَاضُ",131,"ض",1,0],["لو فارقتني فواقاً ذبت من حرقٍ","أو غبت عنها فراقاً مت من ندم",132,"م",1,0],["لَو فاطِمٌ حَضَرَتْ لِمَنْ هَزَّ السَّما","مُذ قالَ (فُزْتُ وَرَبِّ بَيتِ المَكْرُمه)",133,"م",2,0],["لو فاخرت عرب في صديها مضرا","وفاخرت فيك سادت أشرف العرب",134,"ب",1,0],["لَو فكر الْمَرْء فِي أطوار خلقته","مَا كَانَ فِي غَيرهَا يَوْمًا بمعتبر",135,"ر",1,0],["لو فدتك الدنيا بما في يديها","ووقتك الردى لهان الفداء",136,"ا",2,0],["لو (فيصلٌ) عادَ حيّاً بيننا فيرى","أنَّ العلوجَ هنا في الشّامِ ما داموا",137,"م",3,0],["لو في القصائدِ شِرْعَةٌ","لَظَنَنْتُ شِعْرَكِ في الفروضْ",138,"ض",1,0],["لَوْ فِي السَّماءِ لآدَمِيٍّ مَسْكَنٌ","يَوْماً لَكانَ لَهُ هُناكَ مُقامُ",139,"م",1,0],["لَوْ فَيْضُ كَفَّيْهِ أَضْحَى نَحْوَ سَدِّ سَبا","غَيْثاً لأَظْهَرَ مِنْهُ سَيْلَهُ العَرِما",140,"م",2,0],["لوْ فتّشوا فيك لاقوا أيَّ مُتّسَع ٍ","تزاحَمَتْ في مداه البِيدُ والنُجُدُ",141,"د",1,0],["لو فاض البحر لأوقفه","ما أيدي النّاس تشيّده",142,"د",2,0],["لو في مِلوكِ الأرضِ ثِقْ لا أرْتضي","بدَلاً لهُ لا والذي قدْ كَمَّلَكْ",143,"ك",1,0],["لو فيك شوقٌ لذللت الهوى سبلا","وما بخلت بقطْر الروح يا مطرُ",144,"ر",1,0],["لو فرح بالعمر عاشه في سلام.","يشغله ذنّبه .... وهمه به طحى.",145,"ح",2,0],["لو ف يدي شريط عمري لاقّصه","عمرٍ بدونك ليه اعيشه واعاني",146,"ن",2,0],["لَو فَاحَ دِجْلَة في(الْعُزِيرَ) تَنَسَّمِي","لِقَرَنْفُلٍ يَسْري مَعَ النّسَمَاتِ",147,"ت",1,0],["لو فيها تقليب الاوجاع ماكانت الدنيا تولجني","هذا انا لي عامين وست شهور وانا دلًال",148,"ل",1,0],["لو فُراتيْ جفَّ يوماً نبْعُهُ","جدَّدتْ من سلسبيل الروح نزْفا",149,"ف",2,0],["لو فيه أفنيْ الحبرَ والقرطاسا","حتى يقارعَ حرفيَ الإحساسا",150,"س",2,1],["لو في منامك قد ثأرتَ قمِ اعتذرْ","كيلا جنود البوش حولك تنتشرْ",151,"ر",1,0],["لو فوّض الله أمر الناسِ في يده","لم يألُ عنهم وغاث الشِّيب والغيدا",152,"د",2,0],["لو في يديه أمورُ الناس قاطبة","لسهَّل العيش بل خلاّه ترغيدا",152,"د",2,0],["لو فتحتم كتبي تَلقون فيها","من تبَقَّى لي وكانوا مِن ألوفْ",153,"ف",1,0],["لو فقط لي نافعٌ ما كان شعري","يتغنى عُشْر هذي الأغنياتِ",154,"ت",1,0],["لو فاز حكمٌ راشدٌ متحرِّرٌ","فوراً يُجَنْدلُهُ العِدَى فيبورُ",155,"ر",1,0],["لو في خيالي خلتي خطرت","أرنو لها أسترهف السمعا",156,"ع",2,0],["لو فكر البحار في خطرِ","ما اسطاع في أمر الهوى صدعا",156,"ع",2,0],["لَو فِي الكَرَى نَامَتْ هَوَاجِسُهُ","زَمْزَمَةُ الأَشجَانِ لَمْ تَنَمِ",157,"م",1,0],["لوفات لك تسعين بالعمر ما شنت","في عين نفسٍ علقت بك رجاها",158,"ا",3,0],["لو فكَّر الشِّعر أن يُهديك أوْرِدةً","أصابَ مِعصَمه الخذلان والتَّلفُ",159,"ف",1,0]]}