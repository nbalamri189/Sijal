{"poems":[[53,"بيني وبين الصوارم الهمم","https://www.aldiwan.net/poem29775.html","المنسرح"],[63,"النائبات كثيرة الإنذار","https://www.aldiwan.net/poem46177.html","الكامل"],[27,"ما بال جهلك بعد الحلم والدين","https://www.aldiwan.net/poem4437.html","البسيط"],[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[51,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[51,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[51,"أنهضه في أوان إنهاضه","https://www.aldiwan.net/poem64941.html","المنسرح"],[91,"طوي العام كما يطوى الرقيم","https://www.aldiwan.net/poem8820.html","عموديه"],[91,"خير ما يكتبه ذو مرقم","https://www.aldiwan.net/poem8865.html","عموديه"],[91,"ما طائر كان فيبيداء موحشة","https://www.aldiwan.net/poem62778.html","عموديه"],[70,"ما انتفاعي بالقرب منكم إذا","https://www.aldiwan.net/poem42948.html","الخفيف"],[43,"آخر ما الملك معزى به","https://www.aldiwan.net/poem9512.html","السريع"],[43,"جللا كما بي فليك التبريح","https://www.aldiwan.net/poem9522.html","الكامل"],[43,"تذكرت ما بين العذيب وبارق","https://www.aldiwan.net/poem9734.html","الطويل"],[43,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[45,"مخبرتي برقة أحواج","https://www.aldiwan.net/poem62672.html","السريع"],[66,"لو فرضنا أن الهدية لا تجمل","https://www.aldiwan.net/poem38702.html","الخفيف"],[66,"لو فعلتم مع المحب صوابا","https://www.aldiwan.net/poem38714.html","الخفيف"],[97,"يا ساعة الحسرات والعبرات","https://www.aldiwan.net/poem24911.html","الكامل"],[44,"والله يا ابن الأعمش المبتلى","https://www.aldiwan.net/poem30028.html","السريع"],[44,"أجفان خوط البانة الأملود","https://www.aldiwan.net/poem30531.html","الكامل"],[69,"لوفاة الكمال في العجم وهن","https://www.aldiwan.net/poem28046.html","الخفيف"],[105,"قل للألى رقدوا والعدل يقظان","https://www.aldiwan.net/poem42055.html","البسيط"],[105,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[46,"أنوار تحسب من سنا الأنوار","https://www.aldiwan.net/poem22703.html","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54730","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[51,"يا ناعيَ ابن رسول الله من البشرِ","https://www.poetsgate.com/ViewPoem.aspx?id=29230",""],[110,"لو فوق الحظ سهما من كنانته","https://www.aldiwan.net/poem16745.html","البسيط"],[129,"هجرت بعدك العيون الرقادا","https://www.aldiwan.net/poem50641.html","الطويل"],[129,"أوصيكمو يا أيها العقلاء","https://www.aldiwan.net/poem50680.html","الكامل"],[143,"وعيشكم لا ورد الحوم","https://www.aldiwan.net/poem58424.html","السريع"],[144,"من عف عن ظلم العباد تورعا","https://www.aldiwan.net/poem11773.html","الكامل"],[144,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[156,"يا غائبا لم يغب هواه","https://www.aldiwan.net/poem55715.html","مخلع البسيط"],[226,"نح كأس الغرام إني سقيت","https://www.aldiwan.net/poem55154.html","البسيط"],[230,"أرى أناسا ساء بي ظنهم","https://www.aldiwan.net/poem51046.html","السريع"],[230,"لو فرش المجلس بالدر","https://www.aldiwan.net/poem51059.html","السريع"],[230,"لوم لئيم كلما اشتد خاب","https://www.aldiwan.net/poem51237.html","السريع"],[298,"أما ترى الأيك قد غنت صوادحه","https://www.aldiwan.net/poem33306.html","البسيط"],[298,"يا حادي الظعن إن جزت المواقيتا","https://www.aldiwan.net/poem33317.html","البسيط"],[314,"ما بال نفس تطيل شكواها","https://www.aldiwan.net/poem59508.html","المنسرح"],[347,"لو فات شيء يرى لفات ابو","https://www.aldiwan.net/poem24141.html","المنسرح"],[362,"أيها القوم ويحكم قد هدمتم","https://www.aldiwan.net/poem68114.html","الخفيف"],[365,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[372,"عمامة ليس ترى جالسا","https://www.aldiwan.net/poem56982.html","السريع"],[394,"لو فتشوا قلبي رأوا وسطه","https://www.aldiwan.net/poem53628.html","السريع"],[459,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[459,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[469,"أغضى فآمن خائفا","https://www.aldiwan.net/poem59850.html","مجزوء الكامل"],[494,"دعوته فأجابتني مكارمه","https://www.aldiwan.net/poem67418.html","البسيط"],[515,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[515,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[516,"مرحباً مرحباً قدومك بالسع","https://www.aldiwan.net/poem12192.html","الخفيف"],[516,"خفة الروح واجتناب الثقاله","https://www.aldiwan.net/poem12198.html","الخفيف"],[530,"أجزتك بابن السراة الأولى","https://www.aldiwan.net/poem37410.html","المتقارب"],[552,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[554,"نبا به الوساد","https://www.aldiwan.net/poem68396.html","مجزوء الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["لَو فَطَنَت بِالقِرى سَوائِمُهُ","لَما مَشَت تَحتَ وَفدِهِ النَعَمُ",0,"م",1,0],["لوْ فاتَ عاديَةَ المَنونِ مُشَيَّعٌ","لنَجا بمُهْجَتِهِ الهِزَبْرُ الضّاري",1,"ر",2,0],["لَو في طُهَيَّةَ أَحلامٌ لَما اِعتَرَضوا","دونَ الَّذي كُنتُ أَرميهِ وَيَرميني",2,"ن",2,0],["لَو فَدَى الحَيُّ مَيِّتاً قُلتُ نَفسِي","وَبَنِيَّ الفِدى لِتِلكَ العِظامِ",3,"م",1,0],["لو فرَّ مصطَنَعٌ من عُرْف مصطنعٍ","عَجْزاً عن الشكر لم نُسبق إلى الهَرَبِ",4,"ب",1,0],["لو فُلِقَتْ عنْهُ لأبصرتَهُ","مثلَ الظلام الحالك الغيهبِ",5,"ب",1,0],["لو فات شيء مدى ميقاته انكدرتْ","زُهرُ النجوم عليه كلَّ مُنكَدَر",6,"ر",1,0],["لو فتكتْ مرّةً مكائِدُهُ","بالدهر أنستْه فتك برَّاضه",7,"ض",2,0],["لَو فَقِهنا مِثلَهُم مَعنى الحَياة","ما أَضَعناها بُكاءً في الطُلول",8,"ل",1,0],["لَو فَعَلتُم فِعلَ أَجدادِكُم","ما قَضى الظالِمُ مِنكُم وَطَرَه",9,"ر",2,0],["لَو فاتَني كُلُّ ما في الأَرضِ مِن ذَهَبٍ","وَلَم تَفُتني فَإِنّي غَيرُ مَغبونِ",10,"ن",1,0],["لَو فَعَلتُم بِمُهجَتي ما فَعَلتُم","لَم يَحُل فيكُمُ صَحيحُ اِعتِقادي",11,"د",2,0],["لَو فَكَّرَ العاشِقُ في مُنتَهى","حُسنِ الَّذي يَسبيهِ لَم يَسبِهِ",12,"ب",2,0],["لَو فُرِّقَ الكَرَمُ المُفَرِّقُ مالَهُ","في الناسِ لَم يَكُ في الزَمانِ شَحيحُ",13,"ح",1,0],["لَوَفدُ نُمَيرٍ كانَ أَرشَدَ مِنهُمُ","وَقَد طَرَدوا الأَظعانَ طَردَ الوَسائِقِ",14,"ق",1,0],["لَو فَطِنَت خَيلُهُ لِنائِلِهِ","لَم يُرضِها أَن تَراهُ يَرضاها",15,"ا",3,0],["لَو فَعَلوا فِعلَكَ لَاستَوجَبوا","أَكثَرَ ما يَأمُلُهُ الراجي",16,"ج",2,0],["لَو فَرَضنا أَنَّ الهَدِيَّةَ لا تَج","مُلُ إِلّا نِهايَةَ المَطلوبِ",17,"ب",1,1],["لَو فَعَلتُم مَعَ المُحِبِّ صَوابا","ما جَعَلتُم تَركَ الجَوابِ جَوابا",18,"ب",2,1],["لو في الضلوع أجلتِ عينك أبصرت","مُنهارةً تبكي على منهار",19,"ر",1,0],["لَو فَرَّ شَيءٌ قَطُّ مِن شَكلِهِ","فَرَّ إِذَن بَعضُكَ مِن بَعضِ",20,"ض",1,0],["لَو فاحَ عودٌ في النَدِيِّ وَذِكرُهُ","لَعَلا بِطيبِ الذِكرِ طيبَ العودِ",21,"د",1,0],["لوفاةِ الكمالِ في العجمِ وهنٌ","فلقدْ أكثروا عليهِ التعازي",22,"ي",1,1],["لو في يدي رُقْيَةٌ أشفِي الصّريعَ بها","إذن شفيتُك إنّ النّاسَ إخوانُ",23,"ن",1,0],["لَو فارَقَ الناسَ أَو طاحَ الزَوالُ بِهِ","إِذَن لَزالَ عَناءُ العَيشِ وَالتَعَبُ",24,"ب",1,0],["لَو فَكَّرَت طُلُبُ الغِنى في ذاهِبِ الأَ","كوارِ ما قَعَدَت عَلى الأَكوارِ",25,"ر",1,0],["لو في بناء المجد ذلك الدمُ","بل عمدوا لما بَنَوْا فَهدَموا",26,"م",3,0],["لَوْ فُوضِلَتْ أَسْمَاءُ رَبِّكَ تُوَجِّتْ","أَسْمَاءُهُ الحُسْنَى بِوَصْفِ الوَاهِبِ",27,"ب",1,0],["لوْ فِي سِوَاكَ شَهِدْتَ مَا كَابَدْتَهُ","لَمْ يَعْصِ جَفْنَكَ دمْعُهُ المِدْرَارُ",28,"ر",1,0],["لَوْ فِي عُلاَهَا فَرْقَدانِ لَهَانَ مَا","تَلْقَى وَكَانَ لَهَا العَزَاءُ بِفَرْقَد",29,"د",1,0],["لَو فَدَتهُ لَأَفادَت فخاراً","غُلُبٌ مَن غالِبٍ وَعَدِيِّ",30,"ي",1,0],["لَوْ في يدي لحَبَسْتُ الغيثَ عن وطَنٍ","مُسْتَسْلِمٍ وقَطعتُ السلسلَ الجاري",31,"ر",2,0],["لو فات شيء مدى ميقاته انكدرتْ","زُهرُ النجوم. من كل منكدَرِ",32,"ر",1,0],["لَو فوّق الحَظ سَهماً مِن كِنانتِهِ","وَكانَ مِن خَلف قاف لَم يَفت غَرَضي",33,"ي",1,1],["لوفاة الإمام ذي العدل سلط","ان بن سيف تُحرِّكُ الآبادَا",34,"د",2,0],["لو في زراعته نصيبٌ وافِرٌ","ما أطنبت في ذَمِّهِ الصُّلحاءُ",35,"ا",2,0],["لو فاخرتْ في الليل بدرَ الدجى","لكان بالفضل لها يُحَكمُ",36,"م",1,0],["لَو فَتَّرَت حَتّى يَجيءَ أَمامَها","فِتراً لَما أَمِنَ الوَرى أَن تَرجِعا",37,"ع",2,0],["لَو فارَقَ الجُدرانَ أَصبَحَ جَمعُهُ","ما بَينَ مُنحَطِمِ الوَشيجِ حُطاما",38,"م",2,0],["لَوْ فَجَعَ البَيْنُ قلبَ صَبٍّ","ذابَ ولوْ كانَ مِنْ حَديدِ",39,"د",1,0],["لو فَرَشتَ الطريقَ دُرّاً لِأَحظو","فَوقَهُ نحوَ داركُم ما رَضيتُ",40,"ت",1,0],["لو فهِموا أو عقلوا لاستحَوْا","أن يجعلوا المِرِّيخَ كالبدر",41,"ر",1,0],["لو فُرِش المجلس بالدُرّ","نَضْداً وبالياقوت والتِّبْرِ",42,"ر",1,1],["لو فتَّشوا جِسْميَ ما أبصروا","غيرَ الأسى يَسْرَح بين الثّياب",43,"ب",1,0],["لَو فاخَرَ البَحرَ جَدوى راحَتيه غدا","قَفراً وغاضَت على غيظٍ طوافحُهُ",44,"ح",2,0],["لَو فاخَرَته الطِباقُ السَبعُ لاِنتكسَت","وَعادَ كوكبُها الدُريُّ مَكبوتا",45,"ت",2,0],["لو فوضت أمرها لخالقها","وصححت صدقها وتكلاها",46,"ا",3,0],["لَو فاتَ شَيءٌ يُرى لَفاتَ اَبو","حَيّانَ لا عاجِزٌ وَلا وَكِلُ",47,"ل",1,1],["لَو فور الاجور وَالرُتبَة العل","يا وَحسنى من ربنا وَزيادَه",48,"د",2,0],["لو فَرَّغ الدّهرُ فِكْري من شَواغلِه","أطلْتُ بالمجلسِ المَعْمورِ مُعتَكَفي",49,"ف",2,0],["لو فَتَّشُوها وجَدوا كلَّ ما","يَملِكُهُ في بَيتِهِ فِيها",50,"ه",2,0],["لَو فَتَّشوا قَلبي رَأوا وَسطَهُ","سَطرَينِ قَد خُطّا بِلا كاتِبِ",51,"ب",1,1],["لو فارق الراحلون عنه","بحراً لدسناه بالنعالِ",52,"ل",1,0],["لو فُلُّ غَربُ الموت عن متدرِّعٍ","بعفافه أو ناسكٍ متعزِّلِ",53,"ل",1,0],["لَو فُصِّلَت ساعاتُها","كادَت تَكونُ سَوالِفا",54,"ف",2,0],["لَو فاتَهُ النَسَبُ الوَضّاحُ كانَ لَهُ","مِن فَضلِهِ نَسَبٌ يُغني عَن النَسَبِ",55,"ب",1,0],["لو فاضَ طوفانُ نوحٍ من ندى يدِه","لما نَجا منهُ بالألواحِ والدُّسُرِ",56,"ر",1,0],["لو في سِباخِ الأرضِ يمطُرُ كفُّهُ","بالتِبْرِ فيها نوّرَ الفَيروزَجُ",57,"ج",1,0],["لو فرشنا الأحداق حتى تطاهن","لقلت في حقك الأحداق",58,"ق",1,0],["لو فتشنا عدولنا لخجلنا","ووجدنا صفو الرجال حثالة",59,"ل",2,0],["لِوَفْدِ الْمَعالِي غدَتْ رِحْلَةٌ","بِهِمْ ولِوَفْدِ المعَاني مَزَارا",60,"ر",2,0],["لو فات تشعيثُ الزّمان فتىً","فات الأصمَّ اليابسَ الجَلْدُ",61,"د",1,0],["لَو فَقَدتهُ يَوماً","لَاِغبَرَّتِ البِلادُ",62,"د",1,0],["لو فعلوا ذلك بوجه الحق","لم يعدهم فيها ولي الخلق",63,"ق",1,0]]}