,[5000,"عَاشِقَةُ الحَرْفِ","https://www.poetsgate.com/ViewPoem.aspx?id=6079",""],[5052,"بلدي عروسُ الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=205118",""],[3271,"أنا شاعر الوادي وعزاف اللظى","https://www.poetsgate.com/ViewPoem.aspx?id=103536",""],[585,"تلك القبور وماثل الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161873",""],[3591,"حاشا لهجرك أن يكون طوببلا","https://www.poetsgate.com/ViewPoem.aspx?id=149394",""],[3591,"فاحت ريلح أزهارٍ ولطائمِ","https://www.poetsgate.com/ViewPoem.aspx?id=149397",""],[5121,"عِرَاقُ الْإِبَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=209030",""],[5163,"عراق","https://www.poetsgate.com/ViewPoem.aspx?id=34064",""],[5183,"هبة العليم","https://www.poetsgate.com/ViewPoem.aspx?id=180194",""],[5187,"الضمير الضائع","https://www.poetsgate.com/ViewPoem.aspx?id=29240",""],[5246,"بين الربى وعلى ضفاف الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=187024",""],[5279,"آهٍ يَا شَامُ","https://www.poetsgate.com/ViewPoem.aspx?id=183879",""],[5295,"فجر المنى","https://www.poetsgate.com/ViewPoem.aspx?id=159305",""],[5324,"ألله أكبر .","https://www.poetsgate.com/ViewPoem.aspx?id=207472",""],[5324,"هذا العراق والزمان شهادة.","https://www.poetsgate.com/ViewPoem.aspx?id=210997",""],[5436,"بركان العزة(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=35146",""],[5444,"عروق التبر","https://www.poetsgate.com/ViewPoem.aspx?id=203348",""],[5574,"يا جيشنا","https://www.poetsgate.com/ViewPoem.aspx?id=206037",""],[5720,"الْصُّفَّةُ *","https://www.poetsgate.com/ViewPoem.aspx?id=199180",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5780,"لست يا موصل إلا دار عز وكرامه","https://www.poetsgate.com/ViewPoem.aspx?id=187624",""],[402,"أوقد الصيف في الصعيد لظاه","https://www.poetsgate.com/ViewPoem.aspx?id=36193",""],[5797,"فقيد الدين والوطن","https://www.poetsgate.com/ViewPoem.aspx?id=187796",""],[5829,"انت الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=150260",""],[5829,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=153128",""],[5845,"سجعتْ بأيمنِ ذى الأراكِ حمائمهْ","https://www.poetsgate.com/ViewPoem.aspx?id=198488",""],[5845,"صدوا عن الصبِّ الكئيبِ وأعرضوا","https://www.poetsgate.com/ViewPoem.aspx?id=16705",""],[5906,"فمعفر الليث","https://www.poetsgate.com/ViewPoem.aspx?id=188221",""],[5906,"إظفر بِغزة","https://www.poetsgate.com/ViewPoem.aspx?id=188826",""],[5956,"البلدة السعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185792",""],[5956,"واعدتني والخلف طبعُ \"المؤمنِ\"","https://www.poetsgate.com/ViewPoem.aspx?id=194007",""],[5956,"أشكو لمن ليخففَ الأحزانا؟","https://www.poetsgate.com/ViewPoem.aspx?id=215830",""],[5966,"الطائف","https://www.poetsgate.com/ViewPoem.aspx?id=158861",""],[5997,"طيرٌ ذبيحٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215430",""],[6031,"لَعِبتْ بعطفيهِ الشمولُ فَمَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=46254",""],[6031,"عُجْ بالمَطِيِّ علَى مَعَالمِ بُورِي","https://www.poetsgate.com/ViewPoem.aspx?id=46320",""],[6089,"يا سيد الأرض الكريمة","https://www.poetsgate.com/ViewPoem.aspx?id=215728",""],[6093,"ما بَعدَ مكة َ والمدينةِ والتي","https://www.poetsgate.com/ViewPoem.aspx?id=179793",""],[6127,"كنز اليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=190114",""],[6225,"سلمت مصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80916&r=&rc=185",""],[6352,"حزت بالكاظمين شأنا كبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22745&r=&rc=6",""]],"verses":[["بلدٌ يحُفُّ بهِ الرّياضُ كأنهُ","وجْهٌ جَميلٌ والرّياضُ عِذارُهُ",0,"ه",1,1],["بَلَدٌ قدْ غَزاهُ صَرْفُ اللّيالي","وأباحَ الحَريمَ منْهُ مُبيحُ",1,"ح",1,1],["بَلَدٌ تَجَمَّعَ مِن حِرٍ","واستٍ فَصارَ إِذَن حَرَستا",2,"ت",2,0],["بَلَدٌ حَبيبٌ أُفقُهُ","لِفَتىً يَحُلُّ بِهِ كَريم",3,"م",1,0],["بَلَدِ الْبَقَايَا الخَالِدَا","تِ وَكُلُّ مَا فِي الْكَوْنِ فَانِي",4,"ن",2,0],["بَلَدٌ مِنْ حَيَائِهِ دَعَةُ الْوَاد","دِي وَمِنْ كِبْرِيَائِهِ الأَهْرَامُ",5,"م",1,0],["بَلَدٌ طُفْتِهِ جديباً كَئِيباً","فَارْتَوَى مِنْكِ نَضْرَةً وَابْتِسَامَا",6,"م",2,0],["بَلَدٌ لَعَمرُكَ لَم أَزَل زُوّارَهُ","مَعَ سَيِّدٍ قَرمٍ أَغَرَّ هِجانِ",7,"ن",1,0],["بَلَدُ المَجانَةِ وَالخَلاعَةِ وَالصِبا","وَمَحَلِّ كُلِّ فُتُوَّةٍ وَفَتاءِ",8,"ا",2,0],["بلد بعد الذكاءِ ذهني","تشتتُ الرزقِ في البلاد",9,"د",1,1],["بلدٌ صَحبْتُ به الشبيبة والصِّبا","ولبستُ فيه العيْشَ وهو جديدُ",10,"د",1,1],["بَلَدَ الجَمالي خَفِيِّه وَجَلِيِّهِ","وَالفَنِّ مِن مُستَطرِف وَتِلادِ",11,"د",1,0],["بَلَدٌ بَنوهُ الأَكرَمونَ قُصورُهُم","وَقُبورُهُم وَقفٌ عَلى نُزَلائِهِ",12,"ا",3,0],["بَلَدٌ كانَ لِلنَصارى قَتاداً","صارَ مُلكَ القُسوسِ عَرشُ الدِيانَه",13,"ن",2,0],["بَلَداً يَرحَلُ الأَنامُ إِلَيهِ","وَيَحُجُّ الطُلّابُ وَالحُكَماءُ",14,"ا",2,0],["بَلَدٌ أَقَمتَ بِهِ وَذِكرُكَ سائِرٌ","يَشنا المَقيلَ وَيَكرَهُ التَعريسا",15,"س",2,0],["بَلَدَ العاجِزُ المُزَنَّدُ فيها","وَمَضى الأَحوَذِيُّ فيها النَجيبُ",16,"ب",1,0],["بَلَدٌ يُنبِتُ المَعالي فَما يَث","ثَغِرُ الطِفلُ فيهِ حَتّى يَسودا",17,"د",2,0],["بَلدَةٌ ما أَتَيتُها قَطُّ إِلّا","خِلتُها بَلدَتي وَمَسقَطِ راسي",18,"س",2,0],["بَلدَةٌ تُنبِتُ الكِرامَ فَلا ذُق","تُ فَناهُم ولا عَدِمتُ فِناها",19,"ا",3,0],["بلدٌ على بلد كأنك ضارب","في الأرض ما يدري لديه مقام",20,"م",1,0],["بَلَدٌ أعارَتْهُ الحمامةُ طَوْقَها","وكساهُ حُلّةَ ريشِهِ الطّاووسُ",21,"س",1,1],["بَلَدُ الفِلاحَةِ لَو أَتاها جَروَلٌ","أَعني الحُطَيئَةَ لَاِغتَدى حَرّاثا",22,"ث",2,0],["بَلَدٌ خَلَعْتُ بِهَا عِذَارَ شَبِيبَتِي","وَطَرَحْتُ فِي يُمْنَى الْغَرَامِ عِنَانِي",23,"ن",2,0],["بلدٌ كان آمناً مطمئناً","فرماه القضاء بالزلزالِ",24,"ل",1,0],["بَلَدي كانَ قدوة لِفَلسطي","ن شَديداً دفاعه في القَضيه",25,"ي",2,0],["بُلُدُ الحَفيظَةِ واحِدٌ مَولاهُمُ","جُمُدٌ عَلى مَن لَيسَ عَنهُ مُجمَدُ",26,"د",1,0],["بَل دَعِ الحُبَّ ثُمَّ لُمني عَلَيها","ذِكرُكَ الحُبَّ زائِدي في اِرتِياحي",27,"ح",2,0],["بَل دُرَّةً زهراءَ ما سَكَنَتْ","بحراً ولا اكْتَنفتْ ذَرى صَدفِ",28,"ف",1,0],["بلد بهِ قدم التعسف راسخ","والجور فيهِ ثابت الأوتاد",29,"د",1,0],["بلد بهِ سوق الجهالة نافق","والعلم فيهِ متاعه لكساد",29,"د",1,0],["بلد تمسك أهلها من جهلهم","بعرى الضلال فما لهم من هاد",29,"د",1,0],["بلد بهِ حط النفاق رحالَه","ما بين ماش في الفساد وموضعِ",30,"ع",1,0],["بلد لبست به شبابي هاتفاً","ونزعته وإذا الهتاف نواح",31,"ح",1,0],["بَلَدّ تُفدِيهِ قُلوُبُ فِئَاتِهِ","هُوَ فِي مُضَاعَفَةٍ مِنَ الأَسْوارِ",32,"ر",1,0],["بلد قسمت حظوظ بنيه","فأصبنا من بيضها الأصفارا",33,"ر",2,0],["بلدٌ كالزهرِ حُسناً وشَذاً","بينَ أظلالس وأَنْسامٍ ومَاءْ",34,"ا",2,0],["بلَدُ الشرائعِ والهدى","وكَنانةُ الله الودود",35,"د",1,0],["بلدٌ قاته وقاتَنِي النِّي","ل، وروَّاهُ مثلما روَّاني",36,"ن",2,0],["بلدٌ ردَّدت ليَاليه شعري","وشجاها من لحنه ما شجاني",36,"ن",2,0],["بلدٌ قد سقيْته الودَّ جريا","لاً، وصدري به إلى الماء صاد",37,"د",1,0],["بلدة تنبت العلوم وأرض","تلد المجد والعلا والمفاخر",38,"ر",1,0],["بَلدٌ تساوَى الحسنُ فيه ، فليلُهُ","كنهاره ، وضَّحاؤه كأصيله",39,"ل",2,0],["بَلَدٌ يُنْبِتُ المَعَالي فَمَا يَ","ثّغِرُ الطّفْلُ فيهِ حَتّى يَسُودَا",40,"د",2,0],["بَلد قَد خَلَت مِن الحُسن حَتّى","لا حَبيب إلَيهِ قَلبي يَميلُ",41,"ل",1,1],["بلد ينقص الأريب مقاما","لم يطب فيه للأريب مقام",42,"م",1,0],["بلدٌ به طيبٌ وربٌّ غافرٌ","ومواهبٌ جلّت وعيشٌ أرغدُ",43,"د",1,0],["بلد احبك ساكنوه وما أرى","خير اتجازيهم به ببعيد",44,"د",1,0],["بلدٌ طيبُ وربُّ غفورٌ","ومليكٌ عدلُ على المسلمين",45,"ن",1,0],["بَلدةٌ مَجدُها تَواصل في الإِع","صارِ مِثلَ الإِعصارِ في مَجراها",46,"ا",3,0],["بلد عَدِمتُ بها السرو","ر كما بها عُدِم الكرِام",47,"م",1,0],["بلدُ النبيِّ رَمى وكعبة ربّهِ","بجنودهِ فرمتهُمُ طيرُ السما",48,"م",2,0],["بَلدٌ به شمسُ النبوّة أشرَقت","دامَت ولم ترَ في الوجود أفولا",49,"ل",2,0],["بَلدٌ به بحرُ الشريعةِ قَد طَما","عمَّ البسيطةَ عرضَها والطولا",49,"ل",2,0],["بَلدٌ به ذاتُ النبيّ محمّدٍ","كَم جابرت بلقائِها جبريلا",49,"ل",2,0],["بَلدةٌ سادَتِ البلادَ وأَضحت","أَنفسَ الأرضِ بالنبيّ النفيسِ",50,"س",1,0],["بَلدٌ به حلَّ النبيُّ محمّدٌ","شمسُ البريّة نورها المتوهّجُ",51,"ج",1,0],["بَل دَعا اللَّه واِستجاب له اللَ","هُ فحيّا تلكَ القبور الحياءُ",52,"ا",2,0],["بلد بها طفلا نشأت ولم ازل","ابدا على ابياتها متطفلا",53,"ل",2,0],["بلدة خاب بمن فيها الرجاء","جمعت شمل لئام سفهاء",5