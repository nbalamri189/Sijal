try.dctabudhabi.ae/diwan/poem/141640","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139627",""],[4684,"يغتالنا خببا","https://www.poetsgate.com/ViewPoem.aspx?id=201573",""],[4755,"أَنا مُنهَكٌ أَيُّها المُنهَكُونا","https://www.poetsgate.com/ViewPoem.aspx?id=192452",""],[4578,"أبانت فوق حاجبها المصون","https://www.poetsgate.com/ViewPoem.aspx?id=49534",""],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[4914,"تموت ولم تبكك البارقات","https://www.poetsgate.com/ViewPoem.aspx?id=170936",""],[4927,"عيد الميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=32634",""],[4927,"مؤامرات ومؤتمرات سورية","https://www.poetsgate.com/ViewPoem.aspx?id=79602",""],[4927,"الشهيد محمود بن عبد الرزاق الدغيم","https://www.poetsgate.com/ViewPoem.aspx?id=79607",""],[4984,"حسن إختيار أو انهيار","https://www.poetsgate.com/ViewPoem.aspx?id=191329",""],[5038,"الارض دامية","https://www.poetsgate.com/ViewPoem.aspx?id=189937",""],[5083,"بُنودُ الشَّام","https://www.poetsgate.com/ViewPoem.aspx?id=53878",""],[5135,"رِحْلَة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=201963",""],[592,"على الحبر بحر العلم بدر المنابر","https://www.poetsgate.com/ViewPoem.aspx?id=128847",""],[5376,"قدِ ارْتدَّ طرفيْ بالشآم ِتَوَجُّعَا","https://www.poetsgate.com/ViewPoem.aspx?id=197597",""],[5431,"سلامي إلى صنعا تعزّ وربعها","https://www.poetsgate.com/ViewPoem.aspx?id=188446",""],[5688,"عاقبة الحبّ الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=204076",""],[5746,"زمّار الحيّ","https://www.poetsgate.com/ViewPoem.aspx?id=207098",""],[5751,"مممم فيسبوكية","https://www.poetsgate.com/ViewPoem.aspx?id=215027",""],[5887,"يا طائر الدوح","https://www.poetsgate.com/ViewPoem.aspx?id=35290",""],[5937,"مأوى العطور","https://www.poetsgate.com/ViewPoem.aspx?id=211811",""],[5943,"كليني ياهموم فلن أبالي","https://www.poetsgate.com/ViewPoem.aspx?id=34857",""],[6069,"سرى موهناً واستكتمته المهالك","https://www.poetsgate.com/ViewPoem.aspx?id=105697",""],[520,"وللشافعية فخر على","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577694",""],[454,"إلى هيئة الأمم المتحدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82667&r=&rc=31",""]],"verses":[["ولِلشِّعْرِ منها ما أؤَمِّلُ فالعُلا","إذا لَم أسِمْها بالقَصائِدِ أغْفالُ",0,"ل",1,0],["وَلِلشَّمْسِ مَيْلٌ لِلْغُرُوبِ مُرَنَّحٌ","كَما رجَحَ الدِّينَارُ فِي كَفِّ مِيزَانِ",1,"ن",1,0],["وللشعر عين لو نظرت بنورها","إلى الغيب لاستشفيت ما في بطونه",2,"ن",2,0],["وللشملِ مجموعاً بيمنك وادِعاً","وللخيرِ كم سببته خير تسبيب",3,"ب",1,0],["وللشباب حِبالاتٌ يصيد بها","وغُرّةٌ يدّريها كلُّ مُصْطادِ",4,"د",1,1],["وللشرّ إقلاعٌ وللهمِّ فَرْجَةٌ","وللخير بعد المُؤيسات عوائدُ",5,"د",1,0],["وللشَّيب جَهرٌ والشبيبة طُرّةٌ","وليس جَهيرٌ في الصِّبا كطَريرِ",6,"ر",1,0],["وللشتم في أدنى مخازيك مسبح","طويل تُجاريه القوافي فتُحسَر",7,"ر",1,0],["وللشُّعوبِ حياةٌ","حيناً وحيناً فناءْ",8,"ا",2,0],["وَلِلشهداءِ ثَناءٌ عَلَيكَ","بِحُسنِ مُقامِك ذاكَ النَهارا",9,"ر",2,0],["وللشعر عين ماؤها متدفق","متى يأت من صيابة القلب يعذب",10,"ب",1,0],["وَلِلشَيءِ مِن الشَيءِ","مَقاييسٌ وَأَشباهُ",11,"ه",1,0],["وَلِلشَكلِ عَلى الشَكلِ","مَقايِيسٌ وَأَشباهُ",12,"ا",2,0],["وَلِلشُعاعِ عَلى ذَيلِ الظَلامِ دَمٌ","كَأَنَّ طِفلَ الدُجى في حِجرِهِ ذُبِحا",13,"ح",2,0],["وَلِلشِعرِ عِندي كُلَّما نَدَبَ الصِبا","فَأَبكى مَحَلَّ أَلحَقَ الشِعرَ بِالشِعرى",14,"ر",2,0],["وَلِلشَعبِ المُصَفَّدِ أَن تَراهُ","وَقَد نَزَعَ الأَداهِمَ وَالصِفادا",15,"د",2,0],["وَلِلشَّرَابِ وَتَبْيِيتِ الْخَطاءِ بِهِ","يَجْلُو الْعُقَارَ بِأجْناسِ الرَّياحِينِ",16,"ن",1,0],["وَلِلشَّباذِي وَلِلأنْطَاعِ تُفْرَشُ في","تَمُّوزَ فَوْقَ رُخامٍ في الأَوَاوِينِ",16,"ن",1,0],["وَلَلشَّهدِ يَجني أَريَهُ مُتَرَنَّمٌ","كَذِبانِ غَيثٍ لَم تُضَيَّع جَوازِلُه",17,"ل",2,0],["وَللشعر إما قيل بالحق قيمة","وإن كانَ في بغداد لَيسَ له شاري",18,"ر",2,0],["وَللشعر جسم ناعم هو لفظه","وَللشعر روح ذو شعور هو المعنى",19,"ن",2,0],["وللشَّمْسِ أَسْبَابٌ كَأَنَّ شُعَاعَهَا","مَمَدُّ حِبَالٍ في خِبَاءٍ مُطنبِ",20,"ب",1,0],["وَلِلشَّمْسِ فِي الْمُنْتَهَى مَغْرِبٌ","رَأَيْنَا بِهِ آيَةً مِنْ عَجَبْ",21,"ب",1,0],["وَلِلشَوقِ سُلطانٌ عَلى الدَمعِ كُلَّما","دَعاهُ تَداعى غَيرَ وانٍ وَلا نَزرِ",22,"ر",1,0],["وللشَّعْبِ قَلْبٌ حَوْلَ رَكْبِكَ خافِقٌ","ورَأْيٌ عَلَى الإِخْلاَصِ والود مُجْمِع",23,"ع",1,0],["وللشمس ، كي تجتلي أوجها","دخانية ، في مرايا الظّلام",24,"م",1,0],["وللشاذلي والنقشبندي ومن مشى","بسلكهما في منهج الشرع بالسير",25,"ر",1,0],["وللشمسِ صُبحاً رُجوع","أَليسَ لنا من إياب",26,"ب",1,0],["ولِلشَّيخِ طَالِب بُوَى مَعدِنُ سِرِّهِم","ونُورُ سَنَاهُم لاَ مُنَازِعَ فِيهِ",27,"ي",2,0],["وللشقيق حلة يلبسها","مصبوغة مثل العقيق حمرا",28,"ر",2,0],["وللشيطان منه ولي صدق","فخذه من التناقض في كلامي",29,"م",2,0],["وَلِلشِيزى إِلى شيرازَ نُجباً","كَمِثلِ الهُضبِ أَجساداً وَآدا",30,"د",2,0],["وللشَّقائقِ جَمْرٌ في جَوانِبها","بقيةُ الفحمِ لم تَسْتُره باللهب",31,"ب",1,0],["وللشَّبيبةِ شيطانٌ يُساعِدني","على الهوى ويُواتِيني على أَرَبى",31,"ب",2,0],["وللشَّقيقِ احمرارٌ حين أَخْجَله","ضَحْكُ الأَقاحيِّ حتى كاد يُغْضِبه",32,"ب",2,0],["وللشقا أسلمني والعنا","من بعد ما كنت طليق العنان",33,"ن",1,0],["وَلِلشّوفِ أَرواحٌ تَرُفُّ كَريمَةً","عَلى وَحيِهِ وَالوَحيُ لِلرّوحِ مَعبَرُ",34,"ر",1,0],["وَلِلشِّعرِ مِنك سَوادَ الظَلامِ","يَضلُّ بِهِ العاشِقُ المُغرَمُ",35,"م",1,0],["وللشر والخير المهيمن خالق","وإبليس من أن يخلق الشرّ أوضع",36,"ع",1,0],["وَلِلشُعَراءِ عَدَتكَ الخُطوبُ","عَلى مالِ كُلِّ كَريمٍ غِوارُ",37,"ر",1,0],["وللشرّ أحزابٌ وللخيرِ عصبةٌ","وهذا غدا ينهَى وذاك يحرّض",38,"ض",1,0],["وَلِلشَّعَراتِ لَمّا لُحنَ بيضاً","بِقَلبي مِثلُ وَخزاتِ الحِرابِ",39,"ب",1,0],["وَلَلشَيخِ تَكبيهِ رُسومٌ كَأَنَّها","تَراوَحَها العَصرَينِ أَرواحُ مَندَدِ",40,"د",1,1],["وَلِلشَبيبَةِ حُكمٌ في الصِغارِ رَمى","أَنا المُلامُ إِذا ما قُلتُ وَاِندَما",41,"م",2,0],["وَللشام أَضحى شامة حينَ زارَها","وَزادَت جَمالاً إِذ غَدا شامة الخَدِّ",42,"د",1,0],["وللشَّمسِ عَينٌ يملأ الأرضَ نورُها","وإن كان فذّاً جِرمُها غيرَ تَوْأم",43,"م",1,0],["وللشّقائقِ زِيٌّ وسْطَها عَجبٌ","إذا تمايَلْنَ والأرواحُ تأتَفِك",44,"ك",1,0],["وللشَّقيق ناظِرُ سَوادُه","قد ارتَوى بلا اكتحالِ إثمِد",45,"د",1,0],["وللشؤونِ شُؤونٌ في شَهادَتِها","وأنتَ تَعرفُها فاطلِق أو احتبِسِ",46,"س",1,0],["وللشوق في الأحشاء ما لا يفي به","يراعي إذا حبرته ونظامي",47,"م",2,0],["وللشفاهِ كؤوسٌ غيرُ دائرةٍ","لها الثغورُ وما شاهَدْتُها حَبَبُ",48,"ب",1,0],["وللشمال ادارت","مطمورة المستدر",49,"ر",1,0],["وللشعوب حقوق في مواطنه","إن لم تنلها فلن تبخل بسفك دم",50,"م",1,0],["وللشرّ أيامٌ تمرّ وتنقضي","كما لمسرات النعيم زوالُ",51,"ل",1,0],["وللشِّعرِ منَّي أن أحوكَ بديعَهُ","لتُوصَفَ غِزلانٌ وتُنشَدُ أغزالُ",52,"ل",1,0],["وللشُّهودِ مَعانٍ","وللغرامِ مَطارِفْ",53,"ف",1,0],["وللشَّوقِ المُلِحِّ فُنونُ سُكرٍ","متى لعِبتْ بعقْلِ المرءِ باحا",54,"ح",2,0],["وللشرك انقسام منه قسمٌ","جليٌّ في النصارى واليهود",55,"د",1,0],["وللشبيرية الأمجاد إذ شرعت","مشروع خيرٍ بإتمام وإكمالِ",56,"ل",1,0],["وَلِلشَياطين كَم أَرسلت مِن شُهُبٍ","جَعَلتهم للظاها في الوَرى حَطَبا",57,"ب",2,0],["وِللشهم المُهندس كُلُّ بَحث","يَعود عَلى العَساكر بِانتِفاع",58,"ع",1,0],["وللشهداء الذكريات تعيدهم","فهم حضَّرٌ فيمن جمعت شهود",59,"د",1,0],["وللشعوب وقد زالت ضغائنها","فتح المبادئِ لا فتح المغيرينا",60,"ن",2,0],["وللشرق أم للغرب أم لهما معاً","أعد عداة الترك تلك المعاولا",61,"ل",2,0],["وَلِلشِّرْكِ مِنْهُ خِزْيُهُ وَوَبَالُهُ","مُفَرَّقَةٌ نَحْوَ الأَعَادِي نِبَالُهُ",62,"ه",1,0],["وللشوّاف بالفيحاء عهد","يقول مع المصلصل يا مَهاةُ",63,"ه",1,0],["وللشيخ آيات إذا لم تكن له","فا هو الا في ليالي الهوى يسر",64,"ر",1,0],["وللشمس وجه بالظلال مبرقع","وللزهر ثغر بالكمام ملثم",65,"م",1,0],["وَلِلشَقائِقِ خالٌ فَوقَ وَجنَتِها","وَوَجنَةُ الوَردِ بِالدينارِ مَنقوطَه",66,"ه",1,1],["وللشمس ما كورت والنجوم","تضيء وتحت الثرى لا تَغُورُ",67,"ر",1,0],["وللشوق سلطانٌ على الصبر والهوى","يجدَّ باسرارِ النفوسِ ويلعبُ",68,"ب",1,0],["وللشعبِ من هاضمي حقِّه","بأَلسنةِ الحقِِّ أن يَجأَرا",69,"ر",2,0],["وَلِلشَيبِ شَعَراتٌ تَدُلُّ عَلى الفَنا","إِذا اِبتَسَمت في عارِضِ المَرءِ قَطَّبا",70,"ب",2,0],["وللشعوب عظات في غوابرها","تهيج روح المعالي في بواقيها",71,"ي",3,0],["وَلَلشَيخِ تَبكيهِ رُسومٌ كَأَنَّها","تَراوَحَها العَصرَينِ أَرواحُ مَندَدِ",72,"د",1,1],["وللشعور وجور القد أو مقل","منا أسير ومحزون ومقتول",73,"ل",1,0],["وللشعراء اليوم ثُلَّتْ عروشهم","فلا الفخر مختالٌ ولا العز تامِك",74,"ك",1,0],["وللشمسِ سُلْطانُها بالهجيرِ","وإن حَسُنَت في الضّحى والأصُل",75,"ل",1,0],["وَلِلشِّعرِ أَتباعٌ كَثيرٌ وَلَم أَكُن","لَهُ تابِعاً في حالِ عُسرٍ وَلا يُسرِ",76,"ر",1,0],["وللشَّفاعة أَبوابٌ مُفتَّحَة","مُشَفَّعٌ مَنْ بمعناها تَشَفُّعُهُ",77,"ع",2,0],["وَلِلشَبِيبَةِ بُنيانٌ تُكَمِّلُهُ","لَكَ الثَلاثونَ عاماً ثُمَّ يَنهَدِمُ",78,"م",1,0],["وللشمسِ الأمانة في مكانٍ","كما قال الإله لنا عليّ",79,"ي",1,0],["وللشريف بهذا أسوة حسنت","عند الإله بأفعالٍ وآثار",80,"ر",1,0],["وَلِلشَمس فَانظر هَل تَراها مُضيئة","عَلى الناس أَم عيقت ذكاً بِالعَوائق",81,"ق",1,0],["وللشعرِ في روضِ التغَزُّلِ رَونَقٌ","يَرُوقُ وأزهارُ الصبابةِ يانعَه",82,"ع",2,0],["وللشباب الغضّ آماله","مبتسمات في كمام الزّهر",83,"ر",1,0],["وَلِلشَبابِ إِذا دامَت بَشاشَتُهُ","وُدُّ القُلوبِ مِنَ البيضِ الرَعابيبِ",84,"ب",1,0],["وللشباب دولة","يا حسنها بين الدول",85,"ل",1,0],["وللشامات قد سيرّن قسراً","سبايا ولهّا حسرى اسارا",86,"ر",2,0],["وللشاعر الموهوب كبر يحده","عليه غريب حاقد وقريب",87,"ب",1,0],["وَلِلشُعَراءِ أَلسِنَةٌ حِدادٌ","عَلى العَوراتِ موفِيَةٌ دَليلَه",88,"ل",2,0],["وللشعراء المفلقين بجوده","عكاظ به للجود كم راق موسم",89,"م",1,0],["وللشوق مرآة تمثل شخصه","فتخطي به عين المودة والحب",90,"ب",1,0],["وللشباب نداء قر في أذني","وللطبيعة داء مج ترياقي",91,"ق",2,0],["وللشادي نشاط وانبساط","وللساقي احتثاث وانكماش",92,"ش",1,0],["وَللشَّيء تَنساهُ وَتَذكُرُ غَيرَهُ","وَللشَّيء لا تَنساهُ إِلَّا عَلى ذِكْرِ",93,"ر",1,0],["وللشموس ولم تأفل لمغربه","وهي الشعاع وعين النور قد فقدا",94,"د",2,0],["وللشِّفار شروعٌ في الدروع كما","تواتَر الطيرُ في الغُدران للنَّهلِ",95,"ل",1,0],["وَللشبيبة نجمٌ","وَإِن بدا فَهوَ غارب",96,"ب",1,0],["وللشمس مشية مستكرَه","يساق إلى منظر لا يسر",97,"ر",1,0],["وللشَّمسِ عَينٌ عن عُلاكَ كَليلةٌ","وَللدَّهرِ قَلبٌ خافِقٌ منكَ مرعوبُ",98,"ب",1,0],["وَلِلشَّمس لم تُكسَف وللبَدرِ لم يَحل","وللشُّهبِ لم تَقذف بأشأمِ طائِر",99,"ر",1,0],["وللشراسة لون في ملامحه",