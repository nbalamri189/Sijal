م الله","https://www.poetsgate.com/ViewPoem.aspx?id=194565",""],[5956,"ذهب القطينُ إلى جنازتها","https://www.poetsgate.com/ViewPoem.aspx?id=196839",""],[5956,"صححتُ في حلمي ثلاث قصائد","https://www.poetsgate.com/ViewPoem.aspx?id=201551",""],[5956,"أصدقاء خالد مظلوم يسائلونه:","https://www.poetsgate.com/ViewPoem.aspx?id=201899",""],[6019,"إشتياق بعنوان آخر !!","https://www.poetsgate.com/ViewPoem.aspx?id=53047",""],[6035,"لاتردّي قلبي ! .","https://www.poetsgate.com/ViewPoem.aspx?id=151971",""],[6102,"لن أعود","https://www.poetsgate.com/ViewPoem.aspx?id=184867",""],[6134,"لما سموت على الملائك والبشر","https://www.poetsgate.com/ViewPoem.aspx?id=169544",""],[520,"هي سلوة حلت عقود وفائها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577427",""],[6160,"صَقيعٌ لنبوءةٍ عارِية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87101&r=&rc=18",""],[6239,"بَرْزَخٌ من حَجَرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76053&r=&rc=104",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""],[5190,"وصية شهيد فلسطيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78343&r=&rc=56",""],[572,"بأبي وأُمِّي زائرٌ متقنّعٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9383&r=&rc=240",""]],"verses":[["لَمّا سَمَت بِكَ غُرَّةٌ مَوموقَةٌ","كَالشَمسِ تَبهَرُ بِالضِياءِ وَتومَقُ",0,"ق",1,0],["لَم أَستَطِع مَنعاً فَيا","لِلَّهِ عَزماً عادَ عَجزا",1,"ز",2,0],["لَمَا ساقَها عَمْداً وَلا عَرَفَ الحِمَى","فَقُلتُ وَقِيتَ الشَرَّ سِرْ غَيرَ ماكِثِ",2,"ث",1,0],["لَمّا سَمِعتُ دُعاءَ مُرَّةَ إِذ دَع","وَدُعاءَ عَبسٍ في الوَغى وَمُحَلِّلِ",3,"ل",1,0],["لمَا سُغْتُ منْ وِرْدِ الحَياةِ صُبابَةً","ولوْ سُغْتَها من بعْدِ ذاكَ فما عُذْري",4,"ر",2,0],["لَم أَسلُ حَتّى كانَ عُذرُكِ في الَّذي","أَبدَيتِهِ أَخفى وَعُذرِيَ أَبَينا",5,"ن",2,0],["لما سكنت من التراب حديقة","فاضت عليك العينُ بالأنهار",6,"ر",1,0],["لم أسعَ للعليا بخطوٍ قاصرٍ","لكن سعيت لها بحظّ هابط",7,"ط",1,1],["لَم أُسلِمِ النَفسَ لِلأَسقامِ تُتلِفُها","إِلّا لِعِلمي بِأَنَّ الوَصلَ يُحييها",8,"ي",3,0],["لم أسْتَطِعْ كفراً كما لم تَسْتطِع","بُخْلاً ولم تجنحْ إليه مَجْنَحَا",9,"ح",2,0],["لَمّا سَكَتَ حَسِبتَ أَنَّكَ ناجِ","هَيهاتِ إِنّي كَالمَنونِ أُفاجي",10,"ج",2,1],["لَمّا سَأَلتُ عَنِ الحَقيقَةِ قيلَ لي","الحَقُّ ما اِتَّفَقَ السَوادُ عَلَيهِ",11,"ي",2,1],["لَم أَستَلَب شرفَ الطبا","ع أيسلَبُ الشَرفُ الرَفيعُ",12,"ع",1,0],["لم استمع ردحا للحق من نبأ","حتى تظنيت ان الحق ملحود",13,"د",1,0],["لما سمعت بنقطة","في الخلف صارت شر هوّة",14,"و",2,1],["لَمّا سَمِعنَكَ قُلنَ شِعرٌ أَمرَدٌ","يا لَيتَ قائِلَهُ الطَريرُ المُسعِدُ",15,"د",1,0],["لَمّا سَمِعتُ بِهِ سَمِعتُ بِواحِدٍ","وَرَأَيتُهُ فَرَأَيتُ مِنهُ خَميسا",16,"س",2,0],["لما سبكناه بتدبيرنا","أصلح منه بعضه بعضه",17,"ض",2,0],["لَمّا سَأَلتُكَ وافاني نَداكَ عَلى","أَضعافِ ظَنّي فَلَم أَظفَر وَلَم أَخِبِ",18,"ب",1,0],["لَم أَستَعِر حِليَتَها يَوماً وَلا","أَغَرتُ حينَ قُلتُها عَلى الكُتُب",19,"ب",1,0],["لَمّا سَمِعتُ لَهُ زَمازِمَ أَقبَلَت","نَفسي إِلَيَّ وَقُلتُ أَينَ فِراري",20,"ر",2,0],["لما سَقاه قهوةً","في الكاسِ ذاتَ تلهُّبِ",21,"ب",1,0],["لَمّا سَعَينا فَما رَقَّت عَزائِمُنا","عَمّا نَرومُ وَلا خابَت مَساعينا",22,"ن",2,0],["لَمّا سَمِعتُ بِنعيِ فارِسِ تَغلِبٍ","أَعني مُهَلهِلَ قاتِلِ الأَقرانِ",23,"ن",1,0],["لمّا سلمتَ طَفِقْنَا في تضرّعنا","ندعُو لكَ اللَّهَ في سرٍّ وفي عَلَنِ",24,"ن",1,0],["لم أسْلُ عنْهُ وقد سَلا عنّي","فالذّنْبُ منه وضِدّهُ منّي",25,"ن",2,1],["لَمّا سَرَيتَ بِجَيشٍ كُنتَ جُملَتَهُ","وما رَفيقاكَ إلّا النَّصرُ والظَّفَرُ",26,"ر",1,0],["لَما ساغَ لي عَذبٌ مِنَ الماءِ بارِدٌ","وَلا طابَ لي عَيشٌ وَلا زِلتُ باكِيا",27,"ي",2,0],["لَمّا سَرَت في حاجَةِ البِلادِ","وَلَحِقَ الأَعجازُ بِالهَوادي",28,"د",2,0],["لمّا سَقوهُ النَّفْيَ مُرّاً طَعمُهُ","وَجَدوهُ حَرّانَ الحَشا ظَمآنا",29,"ن",2,0],["لَم أُسَهَّد مِنَ المَراحِ وَلَكِن","طالَ لَيلي بِها وَكانَ قَصيرا",30,"ر",2,0],["لما سَلكْتُ عَروضَها","ذهبَ الزِّحافُ بِحَذوي",31,"و",2,0],["لَمّا سَمِعتُ دُعاءَ مُرَّةَ إِذ دَعا","وَدُعاءَ عَبسٍ في الوَغى وَمُحَلِّلِ",32,"ل",1,0],["لَم أَسلُ عَنكِ وَلَم أَخُنكِ وَلَم يَكُن","في القَلبِ عِندي لِلسُلُوِّ مَكانُ",33,"ن",1,1],["لم اسلهم حتى رزئت بصدعة","أخذت بقية سالف الأكدار",34,"ر",1,0],["لما سغت من ورد الحياة صباية","ولو سغتها من بعد ذاك فما عذري",35,"ر",2,0],["لم أسلبقك في مجال التدنّي","والتلوّي : فكيف أرضي اللّحاقا ؟",36,"ق",2,0],["لم استعر حليتها يوماً، ولا","أغرت حين قلتها على كتب",37,"ب",1,0],["لما سمعتُ نداءَ مرَّة قد علا","وابنى ْ ربيعة َ في الغبار الأقتم",38,"م",1,0],["لَما سَهِرَت عَلى مَدائِحِهِ الَّتي","جَعَلَت عدايَ مِن الرَدى حُراسي",39,"س",2,0],["لم استكن لذوى بغضى ومن خلقى","ترك الهوينا وفي الجُلَّى أنا ابن جلا",40,"ل",2,0],["لَم أُسَوِّغكُمُ شَهادَةَ زورٍ","مُذ خُلِقتُم لَم يُعرَفِ الإِعدامُ",41,"م",1,0],["لَمّا سَقى الأَرضَ غَيثاً مِن دِمائِهِمُ","لا تَدَّعي مِثلَهُ في سَحِّها الدِيَمُ",42,"م",1,0],["لم أستطع رجع الكلام وإنما","أعربت عما شفني بأنين",43,"ن",1,0],["لم أستفق في بعضها","حتى أصبت بكلّها",44,"ل",3,0],["لم استبح منهم يداً لضرورتي","ومع الضرورة تستباح الميتة",45,"ه",1,0],["لم أستطع أنهى اللتي انهلت","من أدمعي بعد التي واللت",46,"ت",1,1],["لما سما لو عارضين","حول شامتين الوجنتين",47,"ن",1,0],["لما سما الصارم شهر","من لحظو اسمر للقتال",47,"ل",1,0],["لَمّا سَرَت يَقدِمُها حَتفُها","عَصائِبُ التُركِ الرَعاديدُ",48,"د",1,0],["لم استطع كفرانها انني","آمنت باللَه وآياته",49,"ت",2,0],["لمّا سألتُكِ أن أحيا بقُبلتِها","أجَبتني من لظى الأنفاسِ تحترق",50,"ق",1,0],["لما سمعتُ رنينَ أبواق النّوى","أبصرتُ أبراجَ الهوى يَهوينا",51,"ن",2,0],["لما سمعت به سمعت بواحد","وَرأيته فاذا هو الثقلان",52,"ن",1,0],["لَم أسْلُ حُبّك فاعلمِي بَعد النّوى","يا لَيْتَ شِعْرِيَ ما الذي أسْلاكِ",53,"ك",1,0],["لمّا سَقاها الحَيا ما شاء مُنْبِتُها","لم تَعْدُ أنْ مزّقَتْ أثْوَابَها طرَبا",54,"ب",2,0],["لِمَ استعجَلتُمُ حُمْرَ المنايا","وأنتم عن تَقَحُّمِها بِطاءُ",55,"ا",2,0],["لَمّا سَبَيتَ نِساءَهُم وَقَتَلتَهُم","وَدَّ الذُكورُ بِأَن تَكونَ إِناثا",56,"ث",2,0],["لَمّا سَأَلتُكَ شَيئاً","أَبدَلَت رشداً بِغَيِّ",57,"ي",1,1],["لمّا سألتُ الثّغرَ منها لُؤلؤاً","قالتْ أما يَكْفيكَ جَفْنُكَ مَعْدِنا",58,"ن",2,0],["لمّا سَبقْتُ إلى الحمى وتَلاحَقُوا","صَحْبِي وهل لأسيرِ حُبٍّ مُفْتد",59,"د",1,0],["لم أسْخُ رِضاً بقَلْبيَ المَقْروحِ","لكنّيَ فادَيْتُ بقَلْبيَ رُوحي",60,"ي",1,0],["لَما ساءَني أَن تَرحَلَ الدارُ بَعدَهُم","إِذا ذَهَبَ الحامي فَلا بَقِيَ الحِمى",61,"م",2,0],["لما سمِعتُ النَّهيَ عوضَني بِها الن","ناهِي خلائِقَ من أبي العَباسِ",62,"س",1,0],["لما سَمِعتُ بأن جودَك واقفٌ","متلهِّفٌ متعرِّضٌ للقاصِد",63,"د",1,0],["لَم أَسَل قُربك إِنَّما ال","أَيام لي لَم تُسعف",64,"ف",1,0],["لما سمعتُ فتى يروي حكايتهُ","روايةً قرّحت بالدمعِ أجفاني",65,"ن",2,0],["لم استطعْ نحوكم خروجاً","فمكن أخا المكرمات عاذِر",66,"ر",1,1],["لما سعى الدهر في تفريق أُلْفَتِنَا","قنعت قسراً عن الأعيان بالأثر",67,"ر",1,0],["لَمّا سَمِعتُ بِبَيعَةٍ لِمُحَمَّدٍ","شَفَتِ النُفوسَ وَأَذهَبَت أَحزانَها",68,"ن",3,1],["لما سألت الفضل عن","هذا الزمان أفاد حكمه",69,"ه",1,1],["لما سموت إلى الصدارة أصبحت","تشدو سموت محامداً ومكارما",70,"م",2,0],["لما سَمِعْتُ بمُدَّرٍ","قَطَعَ الفلاةَ إِليك قادِم",71,"م",1,0],["لم أَستَرِقْ بمنامي وصلَ طيفِهِمُ","فما لهُ صارَ مقطوعًا على السَّرَقِ",72,"ق",1,0],["لَمْ أَسْلُ إِذْ عَذَّرَ مَنْ شَفَّني","عُذْراً وَبَعْضُ الْعُذْرِ إِيهامُ",73,"م",1,1],["لما ساخت لها في السمع أذني","ولامحها دوام العمر موقي",74,"ق",2,0],["لم اسمع لفظا مكروها","لهمايوما هزلا أو جد",75,"د",1,0],["لم أسمه بالشمس حيث طلوعه","ما كان الا في دجنه شعره",76,"ر",2,0],["لَمَا سَلِمَ البعوضُ على عُقاب","ولا عُضَّ الهِزبرُ بشرِّ نابِ",77,"ب",1,0],["لم أسمهِ العنوانَ إلاَّ أنَّهُ","في نشر طيّ الفضل كالعنوانِ",78,"ن",1,1],["لم ا ُسائِلْ ، لكنْ أعيشُ هوىً","لم يَعِشْ مِثلَ زَهْوِهِ أحَد ُ",79,"د",1,0],["لم استطع كتم ما بي","ولا استطعت جفاها",80,"ا",3,0],["لَمّا سَقى البيضَ رَيّاً وَهيَ ظامِئَةٌ","مِنَ الدِماءِ وَحُكمُ المَوتِ يَحتَكِمُ",81,"م",1,0],["لما سموت إلى المعسكرِ ضارباً","في كل عزم كل سهم مفلج",82,"ج",1,0],["لم اسع في طلب الوصال الازلي","حظاً على عدم الوصال دليل",83,"ل",1,0],["لما سنا الحسن من خديك آنسنا","من وحشة البين والهجران آنسنا",84,"ن",2,1],["لم أسأل الركبان عن أسمائها","كلفاً بها لولا هوى أسمائها",85,"ا",3,0],["لما سعى نحو العلى فات المدى","عفواً وصفحة خده لم تعرق",86,"ق",1,0],["لَم أستَمِع لِشِكَايَةٍ مِن شاكِ","هَذي الحقِيقَةُ لا حِكَاية حَاكِ",87,"ك",1,1],["لما سمعت بهم طالوا نهضت الى","ايجاز مستبرك بالمدح مغتنم",88,"م",1,0],["لَمَّا سَمَتْ هِمَمِي إِلَيْكَ رَدَدْتُهَا","بِالْهَمِّ وَالهِمَمُ الكِبَارُ هُمُومُ",89,"م",1,0],["لَمْ أَسْتَتِمَّ عِنَاقَهُ لِقُدُومِهِ","حَتَّى ابْتَدَأْتُ عِنَاقَهُ لِوَدَاعِهِ",90,"ع",2,0],["لما سرت خَيْلي عَن أَرضِهم","أَسميت قَلْبي بعَتِيق العِتَاق",91,"ق",1,0],["لَمَّا سَمِعْتُ بِفَضْلِ جُودِكُمُ","وَبما يُرامُ مِنَ النَّدى مِنْكُمْ",92,"م",1,1],["لما سننت لري القطر أنظمة","أسست في كل قسم منه خزانا",93,"ن",2,0],["لما سباحتها انقضت عجلا إلى","ذا الكوخ عادت في بهاء يبهر",94,"ر",1,0],["لَمّا سَتقامَت لَهُ الأُمورَ وَلَم","يَبقَ رَقيبٌ وَاِنجابَت الغُمَرُ",95,"ر",1,0],["لم اسمها على سواكم علوا","ولو أني قد كان لي البدر صهرا",96,"ر",2,0],["لَما سَمحت بِالوَصل يَوماً لبعلها","وَلا حَملت مِنهُ بِأَخبَث فاجر",97,"ر",1,0],["لَما سَطا جَيش الرَدى","وَعَلى المَصونة قَد عَدا",98,"د",2,1],["لم أسق ماء النيل إلا صافياً","آباه في لون النجيع القاني",99,"ن",2,0],["لم أُسوِّدْ وجهَ المشيب ولا حكَّ","متُ فيه المقراضَ والمنقاشا",100,"ش",2,0],["لَمّا سَمِعنا وَمن ذا جاءَنا خَبرٌ","فَالكلُّ مِن كدرٍ وَاللَّهِ قَد مَرِضوا",101,"ض",3,0],["لِمَ اِسوَدَّتِ الدّنيا وَلَم يَكُ غاسِقُ","وَأَظلَمَتِ الآفاقُ حَتّى المَشارِقُ",102,"ق",1,1],["لَمّا سَقَتنيها خَلعتُ الحِجى","وَنِلتُ مِن ردّ الحِجى البَأسا",103,"س",2,0],["لم أسر طالباً سوى ظلك الصا","في وحاشاي لا أصادف ظلا",104,"ل",2,0],["لَما سَلمت مِن مَلام اللُوَّمِ","فَاِسمَع لِما أَقول وَاِرحَم تُرحم",105,"م",1,0],["لمْ أستظِلَّ بكفٍ منكِ حانيةٍ","لمْ ألتفتْ لجلال ِاللهِ في الحَدَقِ",106,"ق",1,0],["لم أستطع أن تراك العين محتضراً","في زفرة الهبت قلبي بتسعير",107,"ر",1,0],["لما سرَوا ليلُ الوصال","جميعُه أمسى سَنا",108,"ن",2,0],["لما سمعت بفضله وأتيتُهُ","أبصرتُ ما لم تسمع الأذنانِ",109,"ن",1,0],["لم أستمع قول العذول وكلما","أدناه من أذنيَّ داخلها الطرش",110,"ش",1,0],["لما سجدت لله في الصلاة وما","سجدت إلا للشش والبنجِ",111,"ج",1,0],["لم أستمع فيه قو