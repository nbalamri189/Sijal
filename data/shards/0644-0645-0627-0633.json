{"poems":[[53,"لمن الحدوج تهزهن الأنيق","https://www.aldiwan.net/poem29959.html","الكامل"],[53,"إطمح بطرفك هل ترى","https://www.aldiwan.net/poem30202.html","مجزوء الكامل"],[63,"عذلت هذيما حين صد عن الحمى","https://www.aldiwan.net/poem45796.html","الطويل"],[3,"طال الثواء على رسوم المنزل","https://www.aldiwan.net/poem107.html",""],[77,"أدارهم بين الأجارع فالسدر","https://www.aldiwan.net/poem36515.html","الطويل"],[73,"إن ساء فعلك بي فما ذنبي أنا","https://www.aldiwan.net/poem11880.html","الكامل"],[72,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[72,"لم أسع للعليا بخطو قاصر","https://www.aldiwan.net/poem19146.html","الكامل"],[64,"كم دمعة فيك لي ما كنت أجريها","https://www.aldiwan.net/poem67534.html","البسيط"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[91,"لما سكت حسبت أنك ناج","https://www.aldiwan.net/poem8786.html","عموديه"],[91,"لما سألت عن الحقيقة قيل لي","https://www.aldiwan.net/poem62800.html","عموديه"],[78,"لما تماسكت الدموع","https://www.aldiwan.net/poem14198.html","مجزوء الكامل"],[89,"قد عدت بعد ذهاب منك يا عيد","https://www.aldiwan.net/poem44645.html","البسيط"],[85,"لما سمعت بنقطة","https://www.aldiwan.net/poem7576.html","مجزوء الكامل"],[85,"الرشد أجمل سيرة يا أحمد","https://www.aldiwan.net/poem63675.html","الكامل"],[43,"هذي برزت لنا فهجت رسيسا","https://www.aldiwan.net/poem9613.html","الكامل"],[62,"سماؤنا من ذهب خالص","https://www.aldiwan.net/poem52182.html","السريع"],[45,"إليك ما أنا من لهو ولا طرب","https://www.aldiwan.net/poem10655.html","البسيط"],[45,"ما للكبير في الغواني من أرب","https://www.aldiwan.net/poem10669.html","الرجز"],[28,"ما كنت أحسبني جبانا قبل ما","https://www.aldiwan.net/poem5122.html","الكامل"],[61,"وأغن كالرشإ الغرير","https://www.aldiwan.net/poem51775.html","مجزوء الكامل"],[66,"سلي الرماح العوالي عن معالينا","https://www.aldiwan.net/poem41584.html","البسيط"],[80,"لا ذنب للطرف في معداه يوم كبا","https://www.aldiwan.net/poem31260.html","البسيط"],[80,"لم أسل عنه وقد سلا عني","https://www.aldiwan.net/poem31269.html","أحذ الكامل"],[80,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[44,"ألم يأن تركي لا علي ولا ليا","https://www.aldiwan.net/poem29568.html","الطويل"],[44,"حماد من نوء له حماد","https://www.aldiwan.net/poem29694.html","الرجز"],[105,"من لي بملء المشرقين بيانا","https://www.aldiwan.net/poem41940.html","الكامل"],[50,"قم خليلي فانظر أراك بصيرا","https://www.aldiwan.net/poem63816.html","الخفيف"],[76,"أطفت شرارة لهوي","https://www.aldiwan.net/poem38852.html","المجتث"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9872","الكامل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12950","الكامل"],[77,"أدارهم بين الأجارع فالسدر","https://www.poetsgate.com/ViewPoem.aspx?id=34094",""],[100,"لا تقل لي","https://www.poetsgate.com/ViewPoem.aspx?id=50110",""],[45,"ما للكبير في الغواني من أرب","https://www.poetsgate.com/ViewPoem.aspx?id=31558",""],[3,"وتظلُّ عبْلة ُ في الخدور تجُرُّها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10748&r=&rc=102",""],[110,"وفد الربيع فقم لحث الكاس","https://www.aldiwan.net/poem16246.html","الكامل"],[133,"لاحت عهود اللوى للعين منك ألا","https://www.aldiwan.net/poem54655.html","البسيط"],[144,"لا تجز في الذي بلغت الأنام","https://www.aldiwan.net/poem11812.html","الخفيف"],[144,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[151,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[151,"حال يقل لمثلها","https://www.aldiwan.net/poem68541.html","مجزوء الكامل"],[161,"كل يحب ولا تصح مودة","https://www.aldiwan.net/poem58944.html","الكامل"],[161,"لم أستطع أنهى اللتي انهلت","https://www.aldiwan.net/poem59009.html","السريع"],[211,"مطلب دموعي إن نفد","https://www.aldiwan.net/poem13488.html","مجزوء الرجز"],[236,"قلبي في حبك معمود","https://www.aldiwan.net/poem32104.html","السريع"],[262,"مذ خط آيات عذار له","https://www.aldiwan.net/poem38123.html","السريع"],[271,"أزنبق كفك البيضاء فالعبق","https://www.aldiwan.net/poem35444.html","البسيط"],[271,"هلا وفيت كما وعدت حزينا","https://www.aldiwan.net/poem35582.html","الكامل"],[272,"رد بالمطي موارد الغزلان","https://www.aldiwan.net/poem52069.html","الكامل"],[276,"مهلا أمامة كم تطول نواك","https://www.aldiwan.net/poem25545.html","الكامل"],[276,"يا حسنها سوسنات أطلعت عجبا","https://www.aldiwan.net/poem25619.html","البسيط"],[276,"ظهيراك التوكل والمضاء","https://www.aldiwan.net/poem25645.html","الوافر"],[283,"لله يوسف كم أغاث وغاثا","https://www.aldiwan.net/poem32843.html","الكامل"],[285,"لما سألتك شيئا","https://www.aldiwan.net/poem44321.html","المجتث"],[365,"ورد الخدود ودونه شوك القنا","https://www.aldiwan.net/poem60636.html","الكامل"],[365,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[365,"أعطيت عنان قلبي المجروح","https://www.aldiwan.net/poem60963.html","الدوبيت"],[367,"وقفنا على قصر العزيز وقد عفا","https://www.aldiwan.net/poem17353.html","الطويل"],[372,"ما لي أراك مشمرا لمراسي","https://www.aldiwan.net/poem57364.html","الكامل"],[372,"شهد البكاء وما أتيت بشاهد","https://www.aldiwan.net/poem57494.html","الكامل"],[381,"طيف ألم بمدنف","https://www.aldiwan.net/poem48811.html","مجزوء الكامل"],[401,"يا قلب جدة","https://www.aldiwan.net/poem6704.html","عموديه"],[403,"لم استطع نحوكم خروجا","https://www.aldiwan.net/poem46550.html","المنسرح"],[404,"يا ساري الريح ساعدني على وطري","https://www.aldiwan.net/poem33913.html","البسيط"],[411,"لما سمعت ببيعة لمحمد","https://www.aldiwan.net/poem67463.html","الكامل"],[430,"لما سألت الفضل عن","https://www.aldiwan.net/poem39838.html","مجزوء الكامل"],[430,"هنيت يا صدر السعادة والعلى","https://www.aldiwan.net/poem39841.html","الكامل"],[433,"عقدوا شعورهم عمائم","https://www.aldiwan.net/poem12340.html","مجزوء الكامل"],[433,"ألحق بنفسج فجري وردتي شفقي","https://www.aldiwan.net/poem12386.html","البسيط"],[435,"لم أسل إذ عذر من شفني","https://www.aldiwan.net/poem26359.html","السريع"],[442,"أيا رباه دعوة مستضيق","https://www.aldiwan.net/poem14335.html","الوافر"],[444,"في إثر سعيد يا أسعد","https://www.aldiwan.net/poem55931.html","عموديه"],[447,"منع الرقاد لحادث أضناني","https://www.aldiwan.net/poem23913.html","الكامل"],[449,"ما ضر من ملك فؤادى بأسره","https://www.aldiwan.net/poem53728.html","الكامل"],[459,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[465,"لم أسمه العنوان إلا أنه","https://www.aldiwan.net/poem3341.html","عموديه"],[466,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[480,"سلا سليمى سلاها","https://www.aldiwan.net/poem37021.html","المجتث"],[494,"وكيف يقهر من لله ينصر من","https://www.aldiwan.net/poem67328.html","البسيط"],[496,"حرج على الأيام إن لم تحرج","https://www.aldiwan.net/poem9803.html","الكامل"],[505,"ما لي إلى وصل الحبيب سبيل","https://www.aldiwan.net/poem38410.html","الكامل"],[515,"لما سنا الحسن من خديك آنسنا","https://www.aldiwan.net/poem20902.html","المواليا"],[516,"هي سلوة حلت عقود وفائها","https://www.aldiwan.net/poem11999.html","الكامل"],[516,"هل تعلمان طريقة لم تطرق","https://www.aldiwan.net/poem12186.html","الكامل"],[539,"لم أستمع لشكاية من شاك","https://www.aldiwan.net/poem48003.html","عموديه"],[559,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[568,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"],[568,"بأبي وأمي زائر متقنع","https://www.aldiwan.net/poem69601.html","الكامل"],[576,"لما دعا في الركب داعي الفراق","https://www.aldiwan.net/poem2701.html","السريع"],[587,"لما سمعت بفضل جودكم","https://www.aldiwan.net/poem17770.html","أحذ الكامل"]],"verses":[["لَمّا سَمَت بِكَ غُرَّةٌ مَوموقَةٌ","كَالشَمسِ تَبهَرُ بِالضِياءِ وَتومَقُ",0,"ق",1,0],["لَم أَستَطِع مَنعاً فَيا","لِلَّهِ عَزماً عادَ عَجزا",1,"ز",2,0],["لَمَا ساقَها عَمْداً وَلا عَرَفَ الحِمَى","فَقُلتُ وَقِيتَ الشَرَّ سِرْ غَيرَ ماكِثِ",2,"ث",1,0],["لَمّا سَمِعتُ دُعاءَ مُرَّةَ إِذ دَع","وَدُعاءَ عَبسٍ في الوَغى وَمُحَلِّلِ",3,"ل",1,0],["لمَا سُغْتُ منْ وِرْدِ الحَياةِ صُبابَةً","ولوْ سُغْتَها من بعْدِ ذاكَ فما عُذْري",4,"ر",2,0],["لَم أَسلُ حَتّى كانَ عُذرُكِ في الَّذي","أَبدَيتِهِ أَخفى وَعُذرِيَ أَبَينا",5,"ن",2,0],["لما سكنت من التراب حديقة","فاضت عليك العينُ بالأنهار",6,"ر",1,0],["لم أسعَ للعليا بخطوٍ قاصرٍ","لكن سعيت لها بحظّ هابط",7,"ط",1,1],["لَم أُسلِمِ النَفسَ لِلأَسقامِ تُتلِفُها","إِلّا لِعِلمي بِأَنَّ الوَصلَ يُحييها",8,"ي",3,0],["لم أسْتَطِعْ كفراً كما لم تَسْتطِع","بُخْلاً ولم تجنحْ إليه مَجْنَحَا",9,"ح",2,0],["لَمّا سَكَتَ حَسِبتَ أَنَّكَ ناجِ","هَيهاتِ إِنّي كَالمَنونِ أُفاجي",10,"ج",2,1],["لَمّا سَأَلتُ عَنِ الحَقيقَةِ قيلَ لي","الحَقُّ ما اِتَّفَقَ السَوادُ عَلَيهِ",11,"ي",2,1],["لَم أَستَلَب شرفَ الطبا","ع أيسلَبُ الشَرفُ الرَفيعُ",12,"ع",1,0],["لم استمع ردحا للحق من نبأ","حتى تظنيت ان الحق ملحود",13,"د",1,0],["لما سمعت بنقطة","في الخلف صارت شر هوّة",14,"و",2,1],["لَمّا سَمِعنَكَ قُلنَ شِعرٌ أَمرَدٌ","يا لَيتَ قائِلَهُ الطَريرُ المُسعِدُ",15,"د",1,0],["لَمّا سَمِعتُ بِهِ سَمِعتُ بِواحِدٍ","وَرَأَيتُهُ فَرَأَيتُ مِنهُ خَميسا",16,"س",2,0],["لما سبكناه بتدبيرنا","أصلح منه بعضه بعضه",17,"ض",2,0],["لَمّا سَأَلتُكَ وافاني نَداكَ عَلى","أَضعافِ ظَنّي فَلَم أَظفَر وَلَم أَخِبِ",18,"ب",1,0],["لَم أَستَعِر حِليَتَها يَوماً وَلا","أَغَرتُ حينَ قُلتُها عَلى الكُتُب",19,"ب",1,0],["لَمّا سَمِعتُ لَهُ زَمازِمَ أَقبَلَت","نَفسي إِلَيَّ وَقُلتُ أَينَ فِراري",20,"ر",2,0],["لما سَقاه قهوةً","في الكاسِ ذاتَ تلهُّبِ",21,"ب",1,0],["لَمّا سَعَينا فَما رَقَّت عَزائِمُنا","عَمّا نَرومُ وَلا خابَت مَساعينا",22,"ن",2,0],["لمّا سلمتَ طَفِقْنَا في تضرّعنا","ندعُو لكَ اللَّهَ في سرٍّ وفي عَلَنِ",23,"ن",1,0],["لم أسْلُ عنْهُ وقد سَلا عنّي","فالذّنْبُ منه وضِدّهُ منّي",24,"ن",2,1],["لَمّا سَرَيتَ بِجَيشٍ كُنتَ جُملَتَهُ","وما رَفيقاكَ إلّا النَّصرُ والظَّفَرُ",25,"ر",1,0],["لَما ساغَ لي عَذبٌ مِنَ الماءِ بارِدٌ","وَلا طابَ لي عَيشٌ وَلا زِلتُ باكِيا",26,"ي",2,0],["لَمّا سَرَت في حاجَةِ البِلادِ","وَلَحِقَ الأَعجازُ بِالهَوادي",27,"د",2,0],["لمّا سَقوهُ النَّفْيَ مُرّاً طَعمُهُ","وَجَدوهُ حَرّانَ الحَشا ظَمآنا",28,"ن",2,0],["لَم أُسَهَّد مِنَ المَراحِ وَلَكِن","طالَ لَيلي بِها وَكانَ قَصيرا",29,"ر",2,0],["لما سَلكْتُ عَروضَها","ذهبَ الزِّحافُ بِحَذوي",30,"و",2,0],["لَمّا سَمِعتُ دُعاءَ مُرَّةَ إِذ دَعا","وَدُعاءَ عَبسٍ في الوَغى وَمُحَلِّلِ",31,"ل",1,0],["لَم أَسلُ عَنكِ وَلَم أَخُنكِ وَلَم يَكُن","في القَلبِ عِندي لِلسُلُوِّ مَكانُ",32,"ن",1,1],["لما سغت من ورد الحياة صباية","ولو سغتها من بعد ذاك فما عذري",33,"ر",2,0],["لم أسلبقك في مجال التدنّي","والتلوّي : فكيف أرضي اللّحاقا ؟",34,"ق",2,0],["لم استعر حليتها يوماً، ولا","أغرت حين قلتها على كتب",35,"ب",1,0],["لما سمعتُ نداءَ مرَّة قد علا","وابنى ْ ربيعة َ في الغبار الأقتم",36,"م",1,0],["لَما سَهِرَت عَلى مَدائِحِهِ الَّتي","جَعَلَت عدايَ مِن الرَدى حُراسي",37,"س",2,0],["لم استكن لذوى بغضى ومن خلقى","ترك الهوينا وفي الجُلَّى أنا ابن جلا",38,"ل",2,0],["لَم أُسَوِّغكُمُ شَهادَةَ زورٍ","مُذ خُلِقتُم لَم يُعرَفِ الإِعدامُ",39,"م",1,0],["لَمّا سَقى الأَرضَ غَيثاً مِن دِمائِهِمُ","لا تَدَّعي مِثلَهُ في سَحِّها الدِيَمُ",40,"م",1,0],["لم أستطع رجع الكلام وإنما","أعربت عما شفني بأنين",41,"ن",1,0],["لم أستفق في بعضها","حتى أصبت بكلّها",42,"ل",3,0],["لم استبح منهم يداً لضرورتي","ومع الضرورة تستباح الميتة",43,"ه",1,0],["لم أستطع أنهى اللتي انهلت","من أدمعي بعد التي واللت",44,"ت",1,1],["لما سما لو عارضين","حول شامتين الوجنتين",45,"ن",1,0],["لما سما الصارم شهر","من لحظو اسمر للقتال",45,"ل",1,0],["لَمّا سَرَت يَقدِمُها حَتفُها","عَصائِبُ التُركِ الرَعاديدُ",46,"د",1,0],["لم استطع كفرانها انني","آمنت باللَه وآياته",47,"ت",2,0],["لمّا سألتُكِ أن أحيا بقُبلتِها","أجَبتني من لظى الأنفاسِ تحترق",48,"ق",1,0],["لما سمعتُ رنينَ أبواق النّوى","أبصرتُ أبراجَ الهوى يَهوينا",49,"ن",2,0],["لما سمعت به سمعت بواحد","وَرأيته فاذا هو الثقلان",50,"ن",1,0],["لَم أسْلُ حُبّك فاعلمِي بَعد النّوى","يا لَيْتَ شِعْرِيَ ما الذي أسْلاكِ",51,"ك",1,0],["لمّا سَقاها الحَيا ما شاء مُنْبِتُها","لم تَعْدُ أنْ مزّقَتْ أثْوَابَها طرَبا",52,"ب",2,0],["لِمَ استعجَلتُمُ حُمْرَ المنايا","وأنتم عن تَقَحُّمِها بِطاءُ",53,"ا",2,0],["لَمّا سَبَيتَ نِساءَهُم وَقَتَلتَهُم","وَدَّ الذُكورُ بِأَن تَكونَ إِناثا",54,"ث",2,0],["لَمّا سَأَلتُكَ شَيئاً","أَبدَلَت رشداً بِغَيِّ",55,"ي",1,1],["لمّا سألتُ ا