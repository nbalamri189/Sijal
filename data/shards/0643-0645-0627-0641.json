etry.dctabudhabi.ae/diwan/poem/139556",""],[4903,"سَلاَمٌ عَلى طِيبِ رَوحَاتِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=96545",""],[3271,"مرثية غصن الزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=103533",""],[585,"مغلغلة منشورةٌ في المحافل","https://www.poetsgate.com/ViewPoem.aspx?id=161901",""],[5409,"ماذا الوقوف بموطنٍ متنكرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155295",""],[5956,"أنا حاملُ الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=194193",""],[6319,"الجنوب الصعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86563&r=&rc=5",""]],"verses":[["كَمَا فَعَلُوا فِي الْمَوْتِ وَالْخَطْبُ خَطْبُهُ","دُوَيْهِيَّةٌ تَصْفرُّ مِنْهَا الأَنَامِلُ",0,"ل",1,0],["كَم أَفادَ الصَبرُ أَجراً","وَاِقتَضى الشُكرُ نَماءَ",1,"ا",2,0],["كَما فَتَكَت أَسيافُهُم بِمُحَمَّدٍ","وَهَدَّت مَباني عَرشِهِ المُتَماسِكِ",2,"ك",1,0],["كَما فَعَلَت قَبلي بِطَسمٍ وَجُرهُمٍ","وَآلِ ثَمودٍ بَعدَ عادِ بنِ عادِيا",3,"ي",2,0],["كَم أَفاءَت مِن أَرضِ قُرَّةَ مِن قُرَّ","ةِ عَينٍ وَرَبرَبٍ مَرموقِ",4,"ق",1,0],["كَما فَعَلنا بِحَسّانَ الرَئِيسِ وَبِا","بنِ الجونِ إِذ لا يُريدُ الناسُ إِقبالا",5,"ل",2,0],["كم أفلت الجاني، فشمَّ","ر ساعديه، واقتفاه",6,"ا",2,0],["كما فرق الشمل المجمع حادث","فقد يجمع الشمل المفرق جامع",7,"ع",1,0],["كما فعلتُ فأني ما بذلت لها","من النضار سوى خمسٍ وسبعينا",8,"ن",2,0],["كَما فُجِعَت مِن قَبلِهِ بِجِدُودِهِ","بَنُو جُشَمٍ وَالمَجدُ لِلمَجدِ تابِعُ",9,"ع",1,0],["كَما فَعَلَ العَبسِيُّ قَيسٌ وَإِنَّما","أَخُو الهِمَّةِ العَليا أَخُو الحَسَبِ الجَزلِ",10,"ل",1,0],["كما فعلتْ في يوم بدرٍ سيوفُكم","وفي الشِّرْك من دُونِ القَليبِ لهاوِرْد",11,"د",1,0],["كما فوضت في الجملة","فوّض في التفاريق",12,"ق",1,0],["كما فتحت وحد السيف يدمي","من الأعناق قلعة اردمشت",13,"ت",1,0],["كما في حديثٍ للبخاريّ مسندٍ","عن المصطفى المبعوث من قِبَلِ الربِّ",14,"ب",1,0],["كما فجّرَ الينبوعَ موسى بضربةٍ","فأنكرهُ شعبٌ يلذُّ له الكفر",15,"ر",1,0],["كما فتَحَت زَهراً وأنمت خَميلةً","أشِعَّةُ شمسٍ كابتِساماتِ مُنعِم",16,"م",1,0],["كم أفادت يده من هبة","ولَكَمْ من سائل أغنى وأقنى",17,"ن",2,0],["كما فاح بالطِّيب الأريج وضوّعت","شذا المندليَّ الرّطبَ نارُ المجامر",18,"ر",1,0],["كم أفنى جمعا باتره","بالنقع وكم بطل أرمى",19,"م",2,0],["كما فاح عَرْفُ الوردِ في الزَّهْرِ قادماً","وفي الماءِ من بَعْدِ القُدومِ مُوَدِّعا",20,"ع",2,0],["كما فَتَقَتْ نَيِّراتُ الصباحِ","تُفَتِّحُ فِي الروضِ روضاً نَضِيدا",21,"د",2,0],["كم أفاضَ الرَّحمنُ فيه شُؤناً","ضُرِبَتْ في أَخْبارِها الأَمْثَالُ",22,"ل",1,0],["كما في أَجْرِ مَنْ يَقْضي بحقٍّ","ويَعْمَلُ باجْتِهادٍ في القَضَاءِ",23,"ا",2,0],["كما فعل القرآن والسنة التي","أتت في عموم الناس نرويه مسندا",24,"د",2,0],["كم أفرغوا مجهودهم ليمهدوا","نهج الفلاح بحكمة ورشاد",25,"د",1,0],["كَما في السَخا وَالحلم وَالعلم وَالوَفا","أَميري عَليٌّ صارِمي وَسِناني",26,"ن",2,0],["كما فاضت على العافين","كفُّ الشهمِ تيمورِ",27,"ر",1,0],["كم أفاد الوفودَ ندىً ولكم","كان من جاهه أمدد الظّللا",28,"ل",2,0],["كَمَا فَعَلَ الغُرُّ أَبْنَاءُ نَصْرٍ","شُمُوسُ الهُدَى وَبُدُورُ الكَمَالِ",29,"ل",1,0],["كَما فاقَ أَربابَ المَعالي ماجِدٌ","فَصارَ لَهُم إذ فاقَهُم بالعُلا فَخرا",30,"ر",2,0],["كم أفاضَ التنزيلُ عنه بياناً","واعد المؤمنين خلدَ الجنانِ",31,"ن",1,0],["كما فديتك من تقديسِ عالمهم","في زعمه وهو في التقديس ذو عند",32,"د",1,0],["كما فرحت به الأفراحُ قبلا","وكان بعز مغناه غناها",33,"ا",3,0],["كم أفصحت بروايات مخبرة","عن فضل هذا الفصيح الحاذق الحكمي",34,"م",2,0],["كَما فَارَقَ العيُّوقُ شولَة عقربٍ","وصَارَا خُصُوماً تَتَّقِيهِ ويتَّقِي",35,"ق",2,0],["كما فر جيش العدا بالنزال","عن الطهر حيدرة حين غارا",36,"ر",2,0],["كم أفسد الأفكار من علم فلا","تشغل حجاك بغير علم نافع",37,"ع",1,0],["كم افتتحت إلى الخيرات من سبل","عن سالكهيا طريق الشر مسدود",38,"د",1,0],["كما فِعلُ إسماعيل قبلك في العُلا","فقد شاد للعلم الصروحَ وأحكما",39,"م",2,0],["كما فاق كل الأنام الحسين","يجد عظيم به العقل حارا",40,"ر",2,0],["كما في ابن ناجي والتصانيف غيره","بكل مكان آخر ابره تعرف",41,"ف",1,0],["كما فأرةٌ لم تَسَع جُحرَها","فشدَّت على الذَّنَبِ المكنسه",42,"ه",1,0],["كم أفلقوا بالوعظِ قلباً جامداً","بهِمِ استلانَ وكانَ اعظمَ قاسِ",43,"س",1,0],["كما فضلَ الناسَ في مجدهمْ","أبو جعفرِ بِن أَبي جعفَرِ",44,"ر",1,0],["كما في وما آتاكمُ شمسهُ انجلَت","لنا وهي من غيرٍ بدت تتلثمُ",45,"م",1,0],["كَمَا فِي لَيلَةِ المِعرَاجِ عَادَ ال","رسولُ لِرَبِّهِ تِسعاً مُرَادَا",46,"د",2,0],["كَم أَفتديك بحلو عمري راضيا","مِن كُلِّ بَاس ذُقته وَعَناء",47,"ا",2,0],["كما فاق موسى اذ له انقلبت عصى","فرندا وعود يابس عاد مورقا",48,"ق",2,0],["كما فعلت في الترب كف المنجم","فرحت وقلبي للتذكر واعيا",49,"ي",2,0],["كما فلت لسيف الدين حداً","به جرحت لسيف الدين قَلبا",50,"ب",2,0],["كَم أَفسَدَ الأَمرَ عَلى أَهلِهِ","ما مُصلِحٌ في الناسِ كَالمُفسِدِ",51,"د",1,0],["كما فاضَ غربٌ بينَ أقرن قامةٍ","يُروِّي دِياراً ماؤه وزروعُ",52,"ع",1,0],["كم أفجعتنا في مليكٍ صروفه","وكم أفجعتنا بالملوك النوائب",53,"ب",1,0],["كَمَا فَتَلَ الوُقفُ صوّاعهُ","وَكَالأرقَمِ انسَابَ للأرقمِ",54,"م",1,0],["كم أفزعت عزريل حين تبرّجت","تلهو على جثث ِ العبادِ وتمرحُ",55,"ح",1,0],["كما فعلت أصحاب طه ومن تلا","هم قافياً آثارهم من حلاحل",56,"ل",1,0],["كم أفزعتك من اللسان وشايةٌ","وبدت غليك من الظنون بوائق",57,"ق",1,0],["كم أفدتمْ واستفدتم","ولكم منّي الوفاءْ",58,"ا",2,0],["كما فاح الجنوب الصّعب نشراً","من البارود نسْنَسَ فيه شيحُ",59,"ح",1,0]]}