{"poems":[[87,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[45,"لا خيل عندك تهديها ولا مال","https://www.aldiwan.net/poem10136.html","البسيط"],[68,"إن لم أزر ربعكم سعيا على الحدق","https://www.aldiwan.net/poem41377.html","البسيط"],[77,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141022",""],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54234","البسيط"],[214,"لحظ يسبيك مقلده","https://www.aldiwan.net/poem13325.html","المتدارك"],[371,"أكتبه يكتب لي أمانا ماضيا","https://www.aldiwan.net/poem17887.html","الكامل"],[412,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31574","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137417",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65973","الرجز"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97978","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138442",""],[3763,"","https://poetry.dctabudhabi.ae/diwan/poem/124152","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59450","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44632","البسيط"],[4048,"","https://poetry.dctabudhabi.ae/diwan/poem/110653","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119701","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94487","الكامل"],[4767,"إلى نعجة الخليج","https://www.poetsgate.com/ViewPoem.aspx?id=124840",""],[3271,"إني سائر للخلود","https://www.poetsgate.com/ViewPoem.aspx?id=103531",""],[5542,"الباحة اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=10055",""],[6108,"قبل العاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=192394",""]],"verses":[["لَو أَشارَت جاءَها ساحِلُه","في حَديدٍ وَعَديدٍ مُنتَصِر",0,"ر",1,0],["لَوِ اِشتَهَت لَحمَ قاريها لَبادَرَها","خَرادِلٌ مِنهُ في الشيزى وَأَوصالُ",1,"ل",1,0],["لَو أَشبَهَتكَ بِحارُ الأَرضِ في كَرَمٍ","لَأَصبَحَ الدُرُّ مَطروحاً عَلى الطُرُقِ",2,"ق",1,0],["لَو أَشبَهَ الغَيثُ جوداً مِنكَ مُنهَمِراً","لَم يَنجُ في الأَرضِ مَخلوقٌ مِنَ الغَرَقِ",2,"ق",1,0],["لو أشْرَبَ اللّهُ القلوبَ حَنانَهُ","أو رِفْقَهُ أحْيا القتيلَ القاتل",3,"ل",1,0],["لو اشتهت لحم قاريها لبادرها","خراذلٌ منه في الشّيزى وأوصال",4,"ل",1,0],["لو اشتكَى الدهرُ من سَقامٍ","لم يتَّخِذْ غيرَه طَبيبا",5,"ب",2,0],["لو اشكي ما بي منه إلى","صخر لتفتت جلمده",6,"د",2,0],["لَو أَشتَريهِ بِمُهجَتي فَقَليلَةٌ","فَاِسمَح بِهِ فَمَتى عَرَفتُكَ مانِعا",7,"ع",2,0],["لَو أَشرَعوا أَيمانِهِم مِن طولِها","طَعَنوا بِها عوض القَنا الخَطَّارِ",8,"ر",1,0],["لَوْ أَشْرَقَتْ لَكَ شَمْسُ ذاكَ الهَوْدَجِ","لأَرَتْكَ سَالِفَتَيْ غَزالٍ أَدْعَجِ",9,"ج",1,1],["لو أشكل الحطب حتى لا اتضاح له","فمن ذكاء انجلت عنا مشاكله",10,"ل",2,0],["لو أشرقت شمس الضحا في ليلة","ظلماً لواراها تلالي خدك",11,"ك",1,0],["لو أشيع الحب صار حوبا","أو يقطع الوصل فهو صل",12,"ل",1,0],["لو أشارت لجامح الدهر يمناه","لعاد الزمان سلس القياد",13,"د",1,0],["لو اشتريت بعمري ساعة سلفت","من عيشتي معكم ما كان بالغال",14,"ل",1,0],["لو أشربُ السُّلوان عن","ذكراك موذيَ ما سلوتُ",15,"ت",1,0],["لَو أَشرَفوا مِن قُصور الخُلد عَن خَلَفٍ","سالَت دُموعُ مَآقيهم كَما السَيلِ",16,"ل",1,0],["لو أشبه الغيث الملث نواله","لغدا وقد ملأ النضار الأطرقا",17,"ق",2,0],["لو أشرب السلوان لم أسلُ ولو","أدخلت قلبي دجلةً لم تطفه",18,"ف",2,0],["لو أشهرت خطيَّ لدن قوامها","وكزَت شغاف قلوب أجساد الثرى",19,"ر",2,0],["لو أشارت بِمخلبٍ نَحو ذئبٍ","حل في جسمه عظيم اختلاج",20,"ج",1,0],["لو أشعلوا النارَ ولم يسعفوا","بالحطب الذاوي فنحن الوقودْ",21,"د",1,0],["لو اشتكى كدرا ماءُ الخليج شكا منه","الفرات، ولم ينس الأسى بردى",22,"د",2,0],["لو أشرقتْ شمسُ السّماء بغربها","فظنونُ نفسكَ- رغمُ ذاكَ- حرااااااامُ",23,"م",1,0]]}