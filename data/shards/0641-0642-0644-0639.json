{"poems":[[447,"الحمد الله رب اللوح واللوح","https://www.aldiwan.net/poem14288.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63936","الهزج"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100903","الوافر"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138690",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92070","البسيط"],[5187,"لقاءٌ بلا مَوعِد","https://www.poetsgate.com/ViewPoem.aspx?id=37393",""],[5411,"خلف الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=195063",""],[5411,"خلف الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=198501",""]],"verses":[["فقل عتقتك من ذنب غدوت به","أسير غل ثقيل الحمل مكبوح",0,"ح",1,0],["فقل عُمِّي مغاني حً","لَبٍ إِن شيتِ أو خُصِّي",1,"ص",2,0],["فقل عنى لطاوى القَفر عَدواً","ترحَّل غيرَ ممتلىءِ الجِفان",2,"ن",1,0],["فقل عليك وزد واواً بأوله","او اسقط الواو او فاصمت لخزبهم",3,"م",1,0],["فَقُل عَلَى الأوَّلِ فِى ثَمُودَ يا","ثَمُو وَيا ثَمِى عَلى الثَّانِى بِيَا",4,"ي",2,0],["فقل عباد مكرمون ثم قل","قلبي لما فيهم أتى قد سلمه",5,"م",2,0],["فقل عفاءٌ على الدنيا وساكنها","ما أقرب الحال من تحويل حاليها",6,"ي",3,0],["فَقُلْ عَن جُرأتي ماشِئْ","تَ لَستُ أخافُ عُقباها",7,"ا",3,0],["فقُلْ عَسَى أنْ يُجير اللهُ مُبْتَلِيَا","مِنَ الْغَرامِ وَيَذْروني النَّدَى صَبَبَا",8,"ب",2,0],["فقُلْ عَسَى أنْ يُجير اللهُ مُبتَئِسا","مِنَ الْغَرامِ وَيَذْروني النَّدَى صَبَبَا",9,"ب",2,0]]}