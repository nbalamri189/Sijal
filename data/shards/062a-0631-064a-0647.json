يل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131232",""],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123525","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73157","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73302","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117258","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133062","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4755,"مَنَاحَة","https://www.poetsgate.com/ViewPoem.aspx?id=184225",""],[4763,"الموجة","https://www.poetsgate.com/ViewPoem.aspx?id=187404",""],[4764,"الجاهله","https://www.poetsgate.com/ViewPoem.aspx?id=25549",""],[4767,"طفل الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=88355",""],[4767,"نداء محرم","https://www.poetsgate.com/ViewPoem.aspx?id=179993",""],[4884,"مشاعر أب","https://www.poetsgate.com/ViewPoem.aspx?id=212243",""],[557,"أريد الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=13955",""],[5055,"حشد روس الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=101193",""],[5135,"قلبي شراع","https://www.poetsgate.com/ViewPoem.aspx?id=201782",""],[5205,"أمبكي عيون الصد لا أبكي","https://www.poetsgate.com/ViewPoem.aspx?id=120996",""],[5273,"أسئلة بظهر الغيب","https://www.poetsgate.com/ViewPoem.aspx?id=176796",""],[5302,"ولي وطن","https://www.poetsgate.com/ViewPoem.aspx?id=200125",""],[5442,"رأى الركائب تحدى فإنني كلفا","https://www.poetsgate.com/ViewPoem.aspx?id=114755",""],[5442,"أرحها فقد مل الظلام سراها","https://www.poetsgate.com/ViewPoem.aspx?id=114763",""],[470,"يا أنتِ.. يا ملحَ زادي!","https://www.poetsgate.com/ViewPoem.aspx?id=178074",""],[470,"يا أنتِ ... يا ملح زادي","https://www.poetsgate.com/ViewPoem.aspx?id=19905",""],[5690,"رضيت بنظرة بدل الوصالِ","https://www.poetsgate.com/ViewPoem.aspx?id=172175",""],[5795,"تبارك البارئ مبدع ألوى","https://www.poetsgate.com/ViewPoem.aspx?id=167913",""],[5839,"السهاد","https://www.poetsgate.com/ViewPoem.aspx?id=62050",""],[5846,"حينما عاد الربيع..","https://www.poetsgate.com/ViewPoem.aspx?id=123429",""],[5902,"وَفقه الله لما يرتضي","https://www.poetsgate.com/ViewPoem.aspx?id=189173",""],[6004,"شَكوَى الحَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=71984",""],[6019,"رحيقُ الوفاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=120903",""],[6102,"عَجِيب !!","https://www.poetsgate.com/ViewPoem.aspx?id=184446",""],[243,"يا ليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68157&r=&rc=149",""],[6243,"دهشة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84445&r=&rc=19",""],[422,"بلغتُ بحمد الله ما أنا طالبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22247&r=&rc=3",""]],"verses":[["تُريهِم نُجومُ اللَيلِ ما يَبتَغونَهُ","عَلى عاتِقِ الشِعرى وَهامِ النَعائِمِ",0,"م",1,0],["تُريهِم فيهِ مِرآةُ المَنايا","بِصِدقِ يَقينِهِم وَجهَ المَعادِ",1,"د",1,0],["تُرى هَذِهِ ريحُ أَرضِ الشَرَبَّه","أَمِ المِسكُ هَبَّ مَعَ الريحِ هَبَّه",2,"ب",2,1],["تُرَى هَلْ يَعُودُ الشَّمْلُ كَيْفَ عَهِدْتُهُ","وَيَبْلُغُ قَلْبِي مَا اشْتَهَى وَيَنَالُهُ",3,"ل",2,0],["تَرى هَمَّهُ نَظَراً خَصرَهُ","وَهَمُّكَ في الغَزوِ لا في السِمَن",4,"ن",1,0],["ترى هل لعامِي من جبينك غرة","بها لا بدمعِي المستهلّ يؤرَّخ",5,"خ",1,0],["ترى هل يبلغ المخدوم أني","لدى الكتّاب في حالٍ مضاع",6,"ع",1,1],["تُرى هَل عَلِمتُم ما لَقيتُ مِنَ البُعدِ","لَقَد جَلَّ ما أُخفيهِ مِنكُم وَما أُبدي",7,"د",2,1],["ترى هل إذا متنا تظل نفوسنا","تعيش بهذا الجو أم نحن كالعشب",8,"ب",1,1],["تَرى هَولَهُنَّ المُعتَفينَ كَأَنَّهُم","عَلى صَنَمٍ في الجاهِلِيَّةِ عُكَّفُ",9,"ف",1,0],["تريه خفيّاتِ الأمورِ بصيرةٌ","كأنّ حجابَ الغيب عنها تكشّفا",10,"ف",2,0],["تُرى هَل أَتى لَيلى بِعَزمَةِ صادِقٍ","كَما هاجَ بي مِن نَوفَلِ بنِ مُساحِقِ",11,"ق",1,0],["ترى هَبَواتِه في كلِّ أفُقٍ","يَرُحْنَ على الجِواءِ ويغتدينا",12,"ن",2,0],["تَرى هَلِ اِعتَلَّ مَن هَواهُ لَنا","وَجِسمُهُ رَبِّ فَاِشفِ عِلَّتَه",13,"ت",2,0],["تَرى هَذاكَ مَصروعاً","وَذا يَنجَرُّ سَكرانا",14,"ن",2,0],["تُريهُ الدُجى في هَيئَةِ النورِ خِدعَةً","وَتُطعِمُهُ صاباً فَيَحسِبُهُ شَهَدا",15,"د",2,0],["تَرى هَل شَكاني من شرير أَو اِفتَرى","عدوٌّ بضري فارحٌ متمتع",16,"ع",1,0],["تُرى هَل عَلِمتَ اليَومَ مَقتَلَ مالِكٍ","وَمَصرَعَهُ في ذِلَّةٍ وَهَوانِ",17,"ن",1,0],["ترى هذِهِ الأَنفاسَ ناراً مِنَ النَورِ","ترى مُذ مَضى عَبدُ الغِني وَما نورى",18,"ر",2,1],["تُرى: هل ألحَّ عليه الحياءُ","فأعرض خشيةَ إطرائه؟",19,"ا",3,0],["تُرى: هل فيه سكَّان؟ وهل هم","أُناسٌ أم ملائكة وحور؟",20,"ر",1,0],["تُرى هل أسوق إليك العزَاءَ؟","وكيف يعزي حزينٌ حزينا؟",21,"ن",2,1],["ترى هل ينام وطيف الفجو","ر ورائحة الإثم في المضجع ؟",22,"ع",1,0],["ترى ها هنا وتلاقي هناك","صفوفا من الوحل تتلو صفوف",23,"ف",1,0],["ترى هل يرجع الماضي ؟ فإني","أذوب لذلك الماضي حنينا",24,"ن",2,0],["تريها الهُدى حدْساً وتنجو برحلهِ","ودون الهدى سدٌّ من الليل مُبْهَمُ",25,"م",1,0],["ترى هضاباً زلزلت وتلاعاً","فما أنا إلا قومة وإنحناءة",26,"ا",2,0],["ترى هناك ريما","مهذب الخصال",27,"ل",1,0],["ترى هل ترى عيني معالم طيبة","وعرف الصبا من طيبها يتنسم",28,"م",1,0],["ترى هل تنكر العلياء نفس","وتسمح نفس حر بالهوان",29,"ن",1,0],["ترى هل يجود الدهر يوماً بقربه","وهل يسعف القلب المعنّى بطبه",30,"ه",1,0],["تُرَى هَلْ تَعُودُ السُّعُودْ","وَتُنْجَزُ تِلْكَ الْوُعُودْ",31,"د",1,0],["تُرى هل يَراني النَّاسُ في فَرَّجية","أجرُّبها تيهاً على الناسِ أذيالي",32,"ل",2,0],["تُرى هل أرى من قبل موتي واقفاً","أُردِّدُ في خير النبيِّينَ مدحنني",33,"ي",1,0],["تُريهِ عُقبى لَياليهِ أَوائِلُها","وَفارِسُ الرَأيِ مَن يُلقي عَلى العُقُبِ",34,"ب",1,0],["تُريه آراؤُه في يومِه غَدَهُ","فيحسِمُ الخطبَ فيه قبلَ يَكتَنِفُ",35,"ف",1,0],["تريه بواطنَ الآراء تبدو","فلمْ تَحجُبْ لعمرك ما وراها",36,"ا",3,0],["تريه صباح الرأي والأمر مُبهم","فتنجاب من ليلِ الخطوب الغياهبُ",37,"ب",1,0],["تريه عواقبَ الأمر المبادي","ويُبصر ما وراء غدٍ أمامَهْ",38,"م",2,0],["تريه خَفِيَّاتِ الشَّواكلِ فكرةٌ","بصيرٌ بها مِن خَطْفةِ النجم أثقبُ",39,"ب",1,0],["تُرى هل تَرجِعُ الاْيامُ تُدني","مزاراً كنتُ آنسُ فيهِ أُنسا",40,"س",2,0],["تُريه كَحَليِ مُشرِقِ الوَجه في الضُّحى","وتُضمِرُ شَجواً في الأصيل فَيَنحبُ",41,"ب",1,0],["تَرى هذا خميساًُ حينَ تَرمي","بِه شوكُ الرِّماحِ وذا خميسا",42,"س",2,0],["تُرى هَل أُلاقي زينَ خاتون بَعدَما","تَناءَت بِنا السُكنى وَعادَ المودِّعُ",43,"ع",1,0],["تريه محبة ورضى وتخفي","له بغضاً ولا يدري السرائرْ",44,"ر",1,0],["تريه حقه وهو الموفَّى","وترفع قدره وهو الأجير",45,"ر",1,0],["تُرى هَلْ لِصَبِّ بَانَ عَنْهُ هُجُوعُهُ","وَمِنْ نَارِ وَجْدٍ لاَ تَقرُّ ضُلُوعُهُ",46,"ه",1,0],["تريه من الحزم آراؤه","مشيَّعة ما وراء الأمورِ",47,"ر",1,0],["ترى هنالك بحراً","من الندى عجّاجاً",48,"ج",2,0],["تَرى هَولاً صَحيحاً مُستَجادا","بِقسم رابح وَلَهُ فُصول",49,"ل",1,0],["ترى هل ترى عيني ثرى حبهم وهل","أبيت وربع الشوق بالحب آهل",50,"ل",1,0],["ترى هل ترى عيني ثرى حيهم وهل","أبيت وربع الحسن للشمل جامع",51,"ع",1,0],["ترى هل درى ناعيه أن نعيَّه","من الشرف الوضَّاح قد قصم الظهرا",52,"ر",2,0],["تُرَى هاجكم ما هاجني من جوى البعدِ","وهل كَرْبُكُمْ كربي وهل وجدكم وجدي",53,"د",2,1],["ترى هل يعيد الله للصب وصلكم","بذاك الحمى من قبل يلقى حمامه",54,"م",2,0],["ترى هل مدير العدل يجهل حالهم","أم الحكم في الأدنى بعيد عن الوالي",55,"ل",2,0],["ترى هل عسيتم إن توليتم بأن","تسنوا سبيلاً تقتفيه الأراذل",56,"ل",1,0],["ترى هل بعد مصرعه رجاءٌ","لقلبٍ في احبتهِ رجاه",57,"ا",2,0],["تُرى هل تَرى عيني ثراكَ فأشتفي","برؤية تلك الأرض مما أحاذرُ",58,"ر",1,0],["تُرى هل ترى عَيني ثَراهُم فإنَّني","بِحُبّي لحبّي ذو ثَراءٍ وذو وُسعِ",59,"ع",1,0],["ترى هل سمعتم بما قد مضى","بشخص لذنب السوي موثق",60,"ق",1,0],["تريه يقظته أسرار غفلتنا","عنه فيغترُّ عن ثغر الأعاجيبِ",61,"ب",1,0],["تريه وجوه الغيث مرآة فكره","فتؤمنه من كل ظنٍّ مرجم",62,"م",1,0],["ترى هل تجمع الايام شملي","ويسعدني بلقياها ازديار",63,"ر",1,0],["ترى هُنَاكَ أيُّهَا المسافِر","سُهَيلَ والمعقلَ بالأشايِر",64,"ر",1,0],["ترى هُناكَ نَسرَكَ الكفيتَا","خَمساً تزيدُ النصفَ تَثبِيتَا",65,"ت",2,0],["ترى هناكَ الشِّعريَ العبورَا","ومثلُهَا الواقعُ كُن خبيرَا",65,"ر",2,0],["تَرى هُناكَ الرُّقَّ في اليَسَارِ","أيضاً بِهِ المّا أبيَضٌ كُن داري",66,"ي",1,0],["تَرَى هُنَا سُهَيلَ ثُمَّ المُعتلي","ثَمَانِيَه فَقِس لَهُم يَا أَمَلِي",67,"ي",1,0],["تَرًى هُنَاكَ أولَ جِبَالِ كَلفِي","مُنجى حَزَن تَتلُوهُمُ فَآعرِفِ",67,"ف",1,0],["تَرَى هُنَاكَ البَابَ عِندَ العَريَه","عَلَيهِ بَاعَانِ بِغَيرِ مِريَه",67,"ه",1,0],["ترى هل خيال منه وافى يزورني","فشاهد من عيني السهاد فموها",68,"ه",2,0],["ترى هاروت حارس مقلتيها","وعن أجفانها السح استعارا",69,"ر",2,0],["تُرى هل خيال الموت ذكّرها به","فهزَّ لها من قلبها الصخرِ أوتارا",70,"ر",2,0],["ترى هلالاً طالعاً في سما ال","هيجاء إن بدر السما أظلما",71,"م",2,0],["تريها الليالي كل يوم عجيبة","من القوم والأيام أم العاجائب",72,"ب",1,0],["ترى هل به الأيّامُ تسمح ليلة","وحظّي بعد النّحس يسعدُ جدّه",73,"د",2,0],["تُرى هل رأت مصر على طول عهدها","كَمثلك يا فاروق عدلاً ومَذهَبا",74,"ب",2,0],["ترى هدب الطرفاء بين متونها","وورق الحمام فوقها تترنم",75,"م",1,0],["تَريهم بِهِ طوفان نوح وَهَوله","وَما كانَ مِن أَمر السفين وَراكب",76,"ب",1,0],["ترى هل لنا بعد الفراق تآلف","وهل لي إلى طيب الوصال وصول",77,"ل",1,0],["ترى هل تجمع الأيام شملي","بها أو هل لفرقتنا التئام",78,"م",1,0],["تريه مناه مرفقا في طماعه","إذا ساغت الأطماع كانت مرافقا",79,"ق",2,0],["ترى هيكلاً فخماً عليها إذا بدا","رأت بعلبكٌ ند هيكلها الفخم",80,"م",1,0],["ترى هل ترى عينى ثرى مس بردكم","وأكحلها منه لكى تبصر الاضوا",81,"و",2,0],["تُرى هل درَى بهُ مُغرمٌ صبُّ","فأغراهُ بالتَّعذيبِ لي ذلكَ الحُبُّ",82,"ب",1,1],["تُرى هَل تَعودُ الدَّارُ تَجمَعُ بَيننا","وَتَرجِعُ أَيَّامُ الحِمَى وَتَعودُ",83,"د",1,0],["ترى هل تسمح الأيام حقا","بوصلهم فيشتمل النظام",84,"م",1,0],["ترى هل يعود العيش في شعب عامرٍ","وهل يرجع الناؤون ركب الهوادج",85,"ج",1,0],["تُرى هَل لِموسى القَلب مِن زَمزَمِ اللِقا","مَراضِعُ لا حُرِّمنَ تِلكَ المَراضِعُ",86,"ع",1,0],["تُرَى هَل يَذُوقُ العَيشَ _كالنَّاسِ_ خائِنٌ","ضَحَايَاهُ أرحامٌ وأرضٌ تُجَزَّأُ؟!",87,"ا",1,0],["تُرَى هَل يَذُوقُ النَّومَ في الليلِ قاتِلٌ","على ظَهرِهِ قَبرٌ وطِفلٌ مُنَوَّأُ؟!",87,"ا",1,0],["تُرَى هَلْ شَقِيتِ لِفَرْطِ الْحَنِينْ","وَشَوْقٍ لِطَقْسٍ لَطِيفٍ يَطِيبْ",88,"ب",1,0],["ترى هاذي شِرايعهم .. قِديمة واضحة قَبلاً","ومن يمشي على دربٍ .. هزيلٍ ماضيه آتي",89,"ت",2,0],["تُرى هل في غد مما أسالوا","سينمو من دم الأطفال عود",90,"د",1,0],["تريهمُ الذكرَ لذي مبدأٍ","فغيرُ ذي المبدأ لن يُذكرا",91,"ر",2,0],["ترى هل سيغني شاعراً عنه شعرُهُ","يرى الشّهرَ قرناً ما تقلْقلَ شهرُهُ",92,"ر",2,1],["ترى هل تريدين سجنا كبيرا","وفي راحتيه يموت الوفاء؟",93,"ا",2,0],["ترى هذا الشعر جوهر نجومه تبهر الرماس","إذا نارت قوافيها تلاشى مبدأ التبصيم",94,"م",1,0],["تُرِيْهِ إنْ أظْلَمَتْ أَجْواءُ رِحْلَتِهِ","مِنْ رَوْضَةِ الْحُسْنِ في خَدَّيْكِ أَلْوانا",95,"ن",2,0],["ترى هل بقى في الجسم منى بقية","وما مدية الهجران منها فرت مسكا",96,"ك",2,0],["تُرى هل ألِفْتِ برودَةَ عِقدٍ؟","وهلْ يَعْلَمُ العِقْدُ ماذا فعلتُ؟",97,"ت",1,0],["ترى هل علمت اليوم ما فيك شدني","وأبقاك فينا عالي القدر والشان",98,"ن",1,0],["تريه بأن النقا أوهامه إذا","أفاق لم ير إلا الوجد والأسفا",99,"ف",2,0],["ترى هل أراني واقفاً بعدد اللنوى","بأبوابه أو أرتوي برواها",100,"ا",3,0],["تُرى هو الوقتُ؟؟.. أم أنَّ الرياحَ بنا","جَرَتْ على غيرِ ما نهوى مَجاريها؟!",101,"ي",3,0],["ترى هو العمر ؟؟ أم إن الرياح بنا","جرت على غير ما نهوى مجاريها",102,"ي",3,0],["ترى هل ما لليل الهجر فجرٌ","وما ذنبي سوى سهر الليالي",103,"ل",2,0],["ترى هناك سنناً حكيمة","لا يعتريهن العفآء والوهى",104,"ا",1,0],["تُرى، هلْ تشرقُ الأيّامُ يوماً","لتبكيَ ما تداعى منْ شُهوقِ؟",105,"ق",1,0],["تُرى هل تَحيكُ الرهافةُ حِسِّي","أم الحِسُّ حاكى النسيمَ المُهَدهَدْ",106,"د",1,0],["تريهم بشرا وَيَا ويحهم","كم تَحت ذَاك الْبشر من مكر",107,"ر",1,0],["تُرَى هلْ هَوَى السِّربُ ، أمْ غَابَ قسرًا ؟","غشاهُ الوَهَى ، أمْ بأسر ٍ ، وظَامِِي؟",108,"م",2,0],["تُرى هلْ بكتْ \\\"ليلى\\\" بحسرةِ حظِّها","وتَتَّهِمَ ال \\\"قيسَ\\\" الذي عِشِقَ الأخرى؟!",109,"ر",2,0],["تُرَى هَلْ لِلعَذاباتِ اصطُفِينا ؟","وَ هُمْ - خَلَقَ الإِلَهُ - بِلا ذُنُوبِ ؟",110,"ب",1,0],["ترى هل الأرض مأواها وموطنها","أم السماء نمتها فهي بنت سما",111,"م",2,0],["تُرَى هل نسمة تحتلّ عُمْقِي","سَتَسْكُنُنِي لأغرقَ في الجَمَال",112,"ل",1,0],["تريه صباح الرأي والأمر مبهم","ألَنْتَ له في قسوة البأس جانباً",113,"ب",2,0]]}