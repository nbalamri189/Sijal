{"poems":[[55,"لحيا عهدهن حيا العهاد","https://www.aldiwan.net/poem30619.html","الوافر"],[39,"فما غاب عن حلم ولا شهد الخنا","https://www.aldiwan.net/poem7482.html","الطويل"],[47,"يشكو إليك هواك المدنف الوصب","https://www.aldiwan.net/poem11494.html","البسيط"],[46,"لقد أخذت من دار ماوية الحقب","https://www.aldiwan.net/poem30580.html","الطويل"],[71,"تذكرت بالبرق إذ يلمع","https://www.aldiwan.net/poem28985.html","المتقارب"],[48,"ألا يا جون ماوفقت","https://www.aldiwan.net/poem23109.html","الهزج"],[69,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""],[147,"مساعيك لا تحصى فتدرك بالعد","https://www.aldiwan.net/poem11749.html","الطويل"],[164,"رضاك عني رضا الباري به قرنا","https://www.aldiwan.net/poem58662.html","البسيط"],[164,"أعن ملل خيالك لا يطيف","https://www.aldiwan.net/poem58766.html","الوافر"],[164,"قناة العز في تلك الرماح","https://www.aldiwan.net/poem58967.html","الوافر"],[308,"أدرها سلافا ما ألمت بمنزل","https://www.aldiwan.net/poem57791.html","الطويل"],[353,"خففت عنك زمانا","https://www.aldiwan.net/poem20120.html","المجتث"],[354,"وعيدي من مخلوف","https://www.aldiwan.net/poem15611.html","الهزج"],[382,"أيا أغنياء الروح صونوا كنوزَكم","https://www.aldiwan.net/poem59426.html","الطويل"],[396,"إذا شئت السلام فالزم الدار","https://www.aldiwan.net/poem54567.html","عموديه"],[422,"خليلي في قلبي من الوجد جذوة","https://www.aldiwan.net/poem53928.html","الطويل"],[457,"أجب ما اسم خماسي","https://www.aldiwan.net/poem13642.html","مجزوء الوافر"],[458,"أبا جرير برغمي أن تخط يدي","https://www.aldiwan.net/poem61678.html","البسيط"],[463,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[466,"أبا شجاع كمال الدين دعوة ذي","https://www.aldiwan.net/poem15161.html","البسيط"],[466,"اعيذ قريشا أن تصيخ لكاشح","https://www.aldiwan.net/poem15463.html","الطويل"],[469,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[580,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[580,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82796","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48865","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48561","الرجز"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124610","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120097","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59420","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21663","البسيط"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111808","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65988","الرجز"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140304",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132571","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132665","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87366","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85003","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131294",""],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125802","المتقارب"],[4461,"","https://poetry.dctabudhabi.ae/diwan/poem/116095",""],[4755,"لِأَنَّ هذا الحُزنَ بِي لائِقُ","https://www.poetsgate.com/ViewPoem.aspx?id=200623",""],[4888,"دعوني أحلق","https://www.poetsgate.com/ViewPoem.aspx?id=207763",""],[5050,"أرى الأيام لي حربا","https://www.poetsgate.com/ViewPoem.aspx?id=38212",""],[5064,"أعدلُ ظالم","https://www.poetsgate.com/ViewPoem.aspx?id=199105",""],[5072,"يا رمزنا أنت قد بعناك","https://www.poetsgate.com/ViewPoem.aspx?id=53759",""],[5277,"لا فرق عندي","https://www.poetsgate.com/ViewPoem.aspx?id=190717",""],[5431,"فيجرف أحزانا ..وينزع أقنعه...","https://www.poetsgate.com/ViewPoem.aspx?id=191747",""],[5431,"ولكن أداينه ....","https://www.poetsgate.com/ViewPoem.aspx?id=214829",""],[5906,"قصدتك يا كريم","https://www.poetsgate.com/ViewPoem.aspx?id=188230",""],[5939,"كأنكِ لم تكوني حلم عمري","https://www.poetsgate.com/ViewPoem.aspx?id=178593",""],[6102,"هوان هوى","https://www.poetsgate.com/ViewPoem.aspx?id=185303",""],[6164,"مشاوير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66075&r=&rc=84",""],[463,"ذكرتُ وما وفايَ بحيثُ أنسى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60101&r=&rc=157",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""]],"verses":[["وَما أَجنى بِها عُذراً وَلَكِن","مُحافَظَةً عَلى ثَمَرِ الوِدادِ",0,"د",1,0],["وما اجِم المعروف من طول ذكره","وأمراً بأفعال الندى وافتعالها",1,"ل",3,0],["وَما اِجتَنَبتُكِ إِلّا لِلوُشاةِ وَكَم","مِن مُغرَمٍ كَلِفٍ بِالوَجدِ يَجتَنِبُ",2,"ب",1,0],["وَما اِجتُلِيَت بِكرٌ مِنَ الحَربِ ناهِدٌ","وَلا ثَيِّبٌ إِلّا وَمِنهُم لَها خِطبُ",3,"ب",1,0],["وما أجهلُ الحسنَ لكنْ أرى","بأنَّ النزاهةَ لي أرفعُ",4,"ع",1,0],["وَما أَجنَأَ مَن جاءَكَ","يَرمي بِالأَذى قوسَك",5,"ك",1,0],["وما أجدبتْ قومٌ أتى من لدنهمُ","لمرعى الأماني من جنابكِ رائدُ",6,"د",1,0],["وَما اِجتابَ عِقداً مِن جَواهِرِ فِعلِهِ","وَإِن جَلَّ إِلّا كُنتَ واسِطَةَ العِقدِ",7,"د",1,0],["وما أجازيك لو أني اطعتك في","أمر تفارقَ روحي عنده البدنا",8,"ن",2,0],["وما أجرمتُ جرماً غير أني","عليها طرف أجفاني طروفُ",9,"ف",1,0],["وما اجتمعت له وأبيه الا","بتقتير وأخلاق شحاح",10,"ح",1,0],["وما اجتمعت والهم يوماً لأنها","بكاساتها صفراءُ للهم فاقعه",11,"ه",1,0],["وَمَا أُجَاوِرُ بَحْراً","مِن رَاحتَيْكَ وَأَصدا",12,"د",2,0],["وَما أَجَّلتَ مِن نَعمى","لِغَيري فَهيَ لي نَقدُ",13,"د",1,0],["وما أجملَ الأبرارَ والبِرُّ ثوبُهم","يرومون مجد اللَه بالأثوُبِ الخضر",14,"ر",1,0],["وما أجمل ما أحسن شخصا","شغل بالبرقى سر وإظهار",15,"ر",1,0],["وما اجتاز بي ركبٌ يجد بسيره","من الرُّوم إلاَّ أَسأَلُ الرّكب عنكما",16,"م",2,0],["وما اجتمعا وما افترقا","ولا بَعُدَا ولا اقتربا",17,"ب",2,0],["وما أجاملُ في شعري بتعزيتي","فإنَّ حُزَنك من حُزني ومن أَلَميِ",18,"م",2,0],["وما اجتُبِي للماسحي","نَ الأسودُ المستَلَمُ",19,"م",1,0],["وما أجدتُ بقولي فيكَ قافيةً","حتى تحققتُ ديناً أنها تَجِبُ",20,"ب",1,0],["وما أجْلب الخطبُ المهيبُ صيالُه","بأنديةٍ اِلا وأنت وقورُها",21,"ر",3,0],["وما أجبنت من طعنٍ خلاج","بساحتها ومن حيٍّ لقاح",22,"ح",1,0],["وما اجتَمَعَتْ إِلا لنَظْمِ قصيدةٍ","وأَنْتَ الذي علَّمْتَنَا كيفَ تَنْظِم",23,"م",1,0],["ومَا اجْتَمعتْ إِلاَّ لتنصرَ عَسْكراً","بِسَعدِك يَغْنىَ عن مُساعَدَةِ الشُّهْبِ",24,"ب",1,0],["وَما اِجتَمَعا قَبلَها في مَكان","وَلا التَقَيا بَعدَ ذاكَ اللُقا",25,"ا",1,0],["وما أجدبت أرضٌ ولا ضاق رحبها","بقومٍ وفيهم خلة من خلاليا",26,"ي",2,0],["وما أجاب أحد ندائيا","ولا رثى لي من رأى شقائيا",27,"ي",2,0],["وما اجتمع الوفود بباب غوث","فتم به لكلهم القصود",28,"د",1,0],["وما أجراه من دفعات سيل","عطاؤك للطريف وللتلادِ",29,"د",1,0],["وما أجمل السلوان بي غير أنني","ضمنت لها أن لا أزل بها أغرى",30,"ر",2,0],["وَما اِجتِنابُكَ مَن تَهوى تُباعِدُهُ","ظُلماً وَتَهجُرُهُ حيناً إِلى حينِ",31,"ن",1,0],["وما اجتمعَ الانسانُ الاَّ ليلتقي","جموعاً من الوحشِ النفور تهاجمه",32,"م",2,0],["وما أجدبت مصرٌ ولا ز أهلها","من النيل عيش الناعم المتفنق",33,"ق",1,0],["وما أجابه أو لو التغشم","حتى دهاهم بغته في الحرم",34,"م",1,0],["وما اجتنوا غير آنام بها افتضحوا","لكن إثم كبير القوم مغفور",35,"ر",1,0],["وما اجمات الاسد الا مشاهد","باعتابها تهوى الجبابر سجدا",36,"د",2,0],["وما اجتمعت الا لتطفئ عنوة","مصابيح نور الله تلك الطوائف",37,"ف",1,0],["وَما اِجتمعا الّا عَلى سرج سابحٍ","يَسيرُ كسيرِ الفُلكِ في لَججِ البحرِ",38,"ر",1,0],["وَما أَجرى الدُموعَ سِوى رَقيبٍ","شَقّى فَصَدُّهُ هَمّي وَحُزني",39,"ن",2,0],["وما اجمعوا إلا على ان قتلها","نتيجة ذنب يجعل الجزل اهوجا",40,"ج",2,0],["وما اجتمع الشملُ حتى غدا","بذي قارٍ اليومُ يوماً أغر",41,"ر",1,0],["وما أجبتم سؤال المحدقين بكم","كأنما القطر لا تغنى وقائعه",42,"ع",2,0],["وما اجتَرَحتُ الشِّعرَ إِلَّا وقد","أَظَلَّ رُوحِي عُشبُها السَّامِقُ",43,"ق",1,0],["وما أجملَ الغدَ ما دامَ جيلٌ","بوعيٍ يقودُ السفين للحقّ",44,"ق",1,0],["وما اجترحوا سوى أن حا","ولوا نيل العلا ذنبا",45,"ب",2,0],["وَمَا أجْرَينَ بالهُجْرَانِ دَاءً","لِمَنْ يهوَى سِوَى الدَّاءِ العُضَالِ !!",46,"ل",1,0],["وما أجبنا لهذا الدين ِ صرختَه ُ","وهل يطير ُ جناح ٌ كلُّه ُ زغب ُ ؟؟",47,"ب",1,0],["وما أجدرَ القلبَ المليءَ بجرحِهِ","تناسي الَّذي آذاهُ عندَ التصرُّمِ",48,"م",1,0],["وماأجمل الحب الكبير بدفقه","فيجرف أحزانا وينزع أقنعه",49,"ع",2,0],["وماأجمل القلب الصفيَّ مغردا","تفوح بأطياب العبير جنائنه",50,"ن",2,0],["وما أجْرْيْ عَليكَ نوالُ دَهرٍ","ولكنْ للكفافِ وأنتَ تَدري",51,"ر",2,0],["وما أَجْفُوكِ عَن كُرْهٍ ولكنْ","جعلْتِ مَوَدَّتي فِعلاً أثيما!",52,"م",2,0],["وَ مَا أَجداكَ مَنْ أَغراكَ ؛ ظُلمًا","وَ لَا نَفَعَ الَّذِي بِهَوَاهُ هِمتَا",53,"ت",2,0],["وما أَجْدَبَ الفَتْوى على كُلِّ قاِعِدٍ","وأمَّا على السَّارِي. فما أَخْصَبَ الفَتْوى!",54,"و",2,0],["وما اجتمعت بروجردٌ وفقر","ولا أحدٌ رأى سعداً ونحسا",55,"س",2,0],["وما اجترمتْ وللأوفاقِ","وعْد ودعمٌ وادِّعاءٌ قدْ ترامى",56,"م",2,0],["وما أَجْمَلَ الأيَّامَ زهْوُ عَطائِها","حَنانٌ وأَشْوَاقٌ زَهَتْ وبَوَادرُ",57,"ر",1,0]]}