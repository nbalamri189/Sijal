{"poems":[[53,"لحيا عهدهن حيا العهاد","https://www.aldiwan.net/poem30619.html","الوافر"],[37,"فما غاب عن حلم ولا شهد الخنا","https://www.aldiwan.net/poem7482.html","الطويل"],[45,"يشكو إليك هواك المدنف الوصب","https://www.aldiwan.net/poem11494.html","البسيط"],[44,"لقد أخذت من دار ماوية الحقب","https://www.aldiwan.net/poem30580.html","الطويل"],[69,"تذكرت بالبرق إذ يلمع","https://www.aldiwan.net/poem28985.html","المتقارب"],[46,"ألا يا جون ماوفقت","https://www.aldiwan.net/poem23109.html","الهزج"],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""],[141,"مساعيك لا تحصى فتدرك بالعد","https://www.aldiwan.net/poem11749.html","الطويل"],[158,"رضاك عني رضا الباري به قرنا","https://www.aldiwan.net/poem58662.html","البسيط"],[158,"أعن ملل خيالك لا يطيف","https://www.aldiwan.net/poem58766.html","الوافر"],[158,"قناة العز في تلك الرماح","https://www.aldiwan.net/poem58967.html","الوافر"],[301,"أدرها سلافا ما ألمت بمنزل","https://www.aldiwan.net/poem57791.html","الطويل"],[346,"خففت عنك زمانا","https://www.aldiwan.net/poem20120.html","المجتث"],[347,"وعيدي من مخلوف","https://www.aldiwan.net/poem15611.html","الهزج"],[374,"أيا أغنياء الروح صونوا كنوزَكم","https://www.aldiwan.net/poem59426.html","الطويل"],[388,"إذا شئت السلام فالزم الدار","https://www.aldiwan.net/poem54567.html","عموديه"],[413,"خليلي في قلبي من الوجد جذوة","https://www.aldiwan.net/poem53928.html","الطويل"],[450,"أجب ما اسم خماسي","https://www.aldiwan.net/poem13642.html","مجزوء الوافر"],[451,"أبا جرير برغمي أن تخط يدي","https://www.aldiwan.net/poem61678.html","البسيط"],[456,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[459,"أبا شجاع كمال الدين دعوة ذي","https://www.aldiwan.net/poem15161.html","البسيط"],[459,"اعيذ قريشا أن تصيخ لكاشح","https://www.aldiwan.net/poem15463.html","الطويل"],[462,"وهبت وقد سرت ذات الوشاح","https://www.aldiwan.net/poem3519.html","عموديه"],[573,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[573,"لنصرك حتى تملك الغرب بالغلب","https://www.aldiwan.net/poem3107.html","الطويل"]],"verses":[["وَما أَجنى بِها عُذراً وَلَكِن","مُحافَظَةً عَلى ثَمَرِ الوِدادِ",0,"د",1,0],["وما اجِم المعروف من طول ذكره","وأمراً بأفعال الندى وافتعالها",1,"ل",3,0],["وَما اِجتَنَبتُكِ إِلّا لِلوُشاةِ وَكَم","مِن مُغرَمٍ كَلِفٍ بِالوَجدِ يَجتَنِبُ",2,"ب",1,0],["وَما اِجتُلِيَت بِكرٌ مِنَ الحَربِ ناهِدٌ","وَلا ثَيِّبٌ إِلّا وَمِنهُم لَها خِطبُ",3,"ب",1,0],["وما أجهلُ الحسنَ لكنْ أرى","بأنَّ النزاهةَ لي أرفعُ",4,"ع",1,0],["وَما أَجنَأَ مَن جاءَكَ","يَرمي بِالأَذى قوسَك",5,"ك",1,0],["وما أجدبتْ قومٌ أتى من لدنهمُ","لمرعى الأماني من جنابكِ رائدُ",6,"د",1,0],["وَما اِجتابَ عِقداً مِن جَواهِرِ فِعلِهِ","وَإِن جَلَّ إِلّا كُنتَ واسِطَةَ العِقدِ",7,"د",1,0],["وما أجازيك لو أني اطعتك في","أمر تفارقَ روحي عنده البدنا",8,"ن",2,0],["وما أجرمتُ جرماً غير أني","عليها طرف أجفاني طروفُ",9,"ف",1,0],["وما اجتمعت له وأبيه الا","بتقتير وأخلاق شحاح",10,"ح",1,0],["وما اجتمعت والهم يوماً لأنها","بكاساتها صفراءُ للهم فاقعه",11,"ه",1,0],["وَمَا أُجَاوِرُ بَحْراً","مِن رَاحتَيْكَ وَأَصدا",12,"د",2,0],["وَما أَجَّلتَ مِن نَعمى","لِغَيري فَهيَ لي نَقدُ",13,"د",1,0],["وما أجملَ الأبرارَ والبِرُّ ثوبُهم","يرومون مجد اللَه بالأثوُبِ الخضر",14,"ر",1,0],["وما أجمل ما أحسن شخصا","شغل بالبرقى سر وإظهار",15,"ر",1,0],["وما اجتاز بي ركبٌ يجد بسيره","من الرُّوم إلاَّ أَسأَلُ الرّكب عنكما",16,"م",2,0],["وما اجتمعا وما افترقا","ولا بَعُدَا ولا اقتربا",17,"ب",2,0],["وما أجاملُ في شعري بتعزيتي","فإنَّ حُزَنك من حُزني ومن أَلَميِ",18,"م",2,0],["وما اجتُبِي للماسحي","نَ الأسودُ المستَلَمُ",19,"م",1,0],["وما أجدتُ بقولي فيكَ قافيةً","حتى تحققتُ ديناً أنها تَجِبُ",20,"ب",1,0],["وما أجْلب الخطبُ المهيبُ صيالُه","بأنديةٍ اِلا وأنت وقورُها",21,"ر",3,0],["وما أجبنت من طعنٍ خلاج","بساحتها ومن حيٍّ لقاح",22,"ح",1,0],["وما اجتَمَعَتْ إِلا لنَظْمِ قصيدةٍ","وأَنْتَ الذي علَّمْتَنَا كيفَ تَنْظِم",23,"م",1,0],["ومَا اجْتَمعتْ إِلاَّ لتنصرَ عَسْكراً","بِسَعدِك يَغْنىَ عن مُساعَدَةِ الشُّهْبِ",24,"ب",1,0]]}