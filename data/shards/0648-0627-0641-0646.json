{"poems":[[55,"رجونا أبا الهيجاء إذ مات حارث","https://www.aldiwan.net/poem30665.html","الطويل"],[65,"ألا ليت شعري هل أرى الدور بالحمى","https://www.aldiwan.net/poem45807.html","الطويل"],[65,"هو الطيف تهديه إلى الصب أشجان","https://www.aldiwan.net/poem46203.html","الطويل"],[24,"نفى شعر الرأس القديم حوالقه","https://www.aldiwan.net/poem21873.html","الطويل"],[10,"تعرقني الدهر نهسا وحزا","https://www.aldiwan.net/poem21100.html","المتقارب"],[4,"أعاذل قومي فاعذلي الآن أو ذري","https://www.aldiwan.net/poem21164.html","الطويل"],[64,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[99,"كم تجرعنا هوانا","https://www.aldiwan.net/poem24766.html","مجزوء الرمل"],[89,"أقلا ملامي في هوى الشادن الأحوى","https://www.aldiwan.net/poem8196.html","الطويل"],[71,"ألا يا نفس لا تعصي","https://www.aldiwan.net/poem28715.html","مجزوء الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39596","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39539","الرمل"],[34,"","https://poetry.dctabudhabi.ae/diwan/poem/8237","الطويل"],[111,"مدد الحق للقلوب الصواردي","https://www.poetsgate.com/ViewPoem.aspx?id=528",""],[102,"أصيل القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50335",""],[119,"قال الصدور من الرجا","https://www.aldiwan.net/poem41741.html","مجزوء الكامل"],[136,"ما للشجى على برح الغرام يد","https://www.aldiwan.net/poem54853.html","الطويل"],[146,"لجاجة قلب ما يفيق غرورها","https://www.aldiwan.net/poem58440.html","الطويل"],[147,"بالحول نلت ونال الناس بالحيل","https://www.aldiwan.net/poem11794.html","البسيط"],[164,"لم أستطع أنهى اللتي انهلت","https://www.aldiwan.net/poem59009.html","السريع"],[189,"عسى يدنيك يا بلدي إياب","https://www.aldiwan.net/poem14108.html","الوافر"],[264,"دع سوانا إن رمت يوما رضانا","https://www.aldiwan.net/poem35570.html","الخفيف"],[276,"أغيب وذو اللطائف لا يغيب","https://www.aldiwan.net/poem52126.html","الوافر"],[286,"دعوني وتسكاب الدموع السوافك","https://www.aldiwan.net/poem1379.html",""],[287,"دعا مهجة الصب لا تردعاها","https://www.aldiwan.net/poem32310.html","المتقارب"],[314,"إله لا إله لنا سواه","https://www.aldiwan.net/poem50237.html","الوافر"],[347,"هاك قلبي واعطني قلبا","https://www.aldiwan.net/poem55380.html","مجزوء الرمل"],[354,"متى ينشق عن جسدي الضريح","https://www.aldiwan.net/poem15562.html","الوافر"],[366,"سوى الحب من دنياكم لست أطاب","https://www.aldiwan.net/poem68133.html","الطويل"],[412,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[415,"غرضت من الحياة فكل عمري","https://www.aldiwan.net/poem31725.html","عموديه"],[422,"فؤاد كطرفك أمسى عليلا","https://www.aldiwan.net/poem54167.html","المتقارب"],[463,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[463,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[491,"أتعرف رسماً كالرداء المحبر","https://www.aldiwan.net/poem483.html",""],[555,"لقد طوفت في الآفاق حتى","https://www.aldiwan.net/poem1885.html","عموديه"],[556,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[556,"يجد بنا صرف الزمان ونهزل","https://www.aldiwan.net/poem47337.html","الطويل"],[556,"أفي دارهم من بعدما ارتحلوا تبكي","https://www.aldiwan.net/poem47342.html","الطويل"],[563,"يا غافلون استفيقوا يا نيام الجاه","https://www.aldiwan.net/poem33678.html","المواليا"],[563,"سواكم روى عنكم سوانا روى عنا","https://www.aldiwan.net/poem33841.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83311","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87092","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38976","الرجز"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18511","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59410","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72325","الطويل"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126626","المتقارب"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101989","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64658","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64668","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136318","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109152","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49949","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108545","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26427","الوافر"],[2215,"","https://poetry.dctabudhabi.ae/diwan/poem/141784","الطويل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110616","المتقارب"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75876","المتقارب"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83213","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203495","الوافر"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104395","المتقارب"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/3","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62855","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62880","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108325",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66348","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91774","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131218",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131248",""],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32851","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59462","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135749","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135267","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135728","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135372","الخفيف"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95367","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77153","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125865","الوافر"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136865",""],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94531","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133089","الوافر"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4578,"قران سعديه وقت السرور صفا","https://www.poetsgate.com/ViewPoem.aspx?id=49485",""],[4901,"وحقك إن أدخلتني النار قلت","https://www.poetsgate.com/ViewPoem.aspx?id=186128",""],[5064,"عُمرِي رداء","https://www.poetsgate.com/ViewPoem.aspx?id=199103",""],[307,"خَرِيفُ العُمْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=215587",""],[3469,"إنْ أكُ قد أقْصرْتُ عن طولِ رحلة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=5340",""],[5672,"الحياة...بعد الخمسين","https://www.poetsgate.com/ViewPoem.aspx?id=212476",""],[5956,"أعِنّا يا إله الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192567",""],[6031,"أبا هاشِمٍ إنِّي إلى ما يَنَالُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46411",""]],"verses":[["وَأَفنانُ دَوحاتٍ مِنَ المَجدِ أُشرِعَت","مَشاظي الرَدى ما بَينَها وَالمَشاعِثُ",0,"ث",1,0],["وَأُفِني بِهِ الأَيَّامَ فيما يَسوءُنِي","عَلى كَمَدٍ بَرحٍ وَأَحيِي اللَّيالِيا",1,"ي",2,0],["وأفْنِيَةٌ مُخضَرَّةٌ عَرَصاتُها","تَزاحَمَ سُؤَّالٌ عَلَيها وضِيفانُ",2,"ن",1,0],["وَأَفنى شَبابي صُبحُ يَومٍ وَليلَةٌ","وَما الدَهرُ إِلّا مُسيُهُ وَمَشارِقُهُ",3,"ق",2,0],["وَأَفنى رِجالي فَبادوا مَعاً","فَغودِرَ قَلبي بِهِم مُستَفَزّا",4,"ز",2,0],["وَأَفنى بَناتُ الدَهرِ أَربابَ ناعِطٍ","بِمُستَمَعٍ دونَ السَماءِ وَمَنظَرِ",5,"ر",1,0],["وأفنَى جميمَ الشَّعْرِ بعد التفافهِ","قطيعانِ عاثا فيه جُونٌ ونُصَّعُ",6,"ع",1,0],["وافني بالله نَطرق","هيكل الحب كلانا",7,"ن",2,0],["وَأَفْنَيْتُ عُمْرِي فِي رِضَاهَا فَلَمْ أَنَلْ","سِوَى رَاحَةٍ تَرْتَدُّ أَوْ عِدَةٍ تُلْوَى",8,"و",2,0],["وأفنى عَنْ فنا نفسي","حذارَ قصاصِ مقتصِّ",9,"ص",1,0],["وأفنيتُ عمري أرتقي عالي الذُّرى","إلى أنْ بلغتُ اليومَ مثوايَ ههنا",10,"ن",2,0],["وافِني نصدحْ بألحانِ المنى","ونعب الكأسَ من خمر الخيالِ",11,"ل",1,0],["وَأَفنَيتُ عُمري بِاِنتِظارِيَ وَعدَها","وَأَبلَيتُ فيها الدَهرَ وَهوَ جَديدُ",12,"د",1,0],["وافن فينا فلا حياة لحي","وحياة الاحياء بعد النفاد",13,"د",1,0],["وأفنى هزيعا وأدهى هزيعا","فعاد الأصيل المولّي سحر",14,"ر",1,0],["وافني بنفسك في عشي","رتنا إذا أملت تثبت",15,"ت",1,0],["وأفنِيَت في رِضَا المَولَى بِضَاعَتُهُ","وأُفرِغَت مِنهُ في نَصرِ الهدى المُدَدُ",16,"د",1,0],["وأفنيةٌ مثلُ الروابى جِفانها","ومثل الجبال الراسيات قدورُها",17,"ر",3,0],["وَاِفنِ الزَمانَ بِعِزٍّ غَيرِ مُنصَرِمٍ","وَسُؤدُدٍ بِنَواصي النَجمِ مُتَّصِلِ",18,"ل",1,0],["وافنت الأعدا سوى عصبة","ماسورة اوقا التي قلت",19,"ت",1,0],["وأفَنتْ مُلْكَ ساكِنه الليالي","وكم فاضتْ بعسكرِه الشِّعاب",20,"ب",1,0],["وافنَ عن غيرنا لتبقى لدينا","يا مُعَنّى وتستحقّ ندانا",21,"ن",2,0],["وافن عداي واقرن نجم حظي","بسعد ما لطالعه غروب",22,"ب",1,0],["وأفنى من ابناء البَرايا جموعَها","وألقى البُرى بالرَّغم فوق البرامك",23,"ك",1,0],["وَأَفنَيتَها بِيَدٍ لَم تَكُن","تُخَيِّبُ مَن بِسُؤالٍ عَراها",24,"ا",3,0],["وَأَفنَيتُ الحَياةَ وَلَم أَصُنها","وَزُغتُ إِلى البَطالَةِ وَالتَواني",25,"ن",2,0],["وافن في انا فانٍ","فيك والحب فناء",26,"ا",2,0],["وَأَفنى في هَواها خَطَّ جِسمي","فَإِنَّ فَناهُ مِن تَرَحي مُريحُ",27,"ح",1,0],["وَأَفنَيت عُمري بَين وَجد مبرح","وَدَمع يا مطار الصَبابَة يَسكُب",28,"ب",1,0],["وَأَفنَيتُ أَياماً فَنيتُ بِمَرِّها","وَغايَة ما يُفني وَيَفنى إِلى قَدرِ",29,"ر",1,0],["وأفنى الموت إخواني وقومي","وأترابي فها أنا كالغريب",30,"ب",1,0],["وأفنت يمينك جمع الحطام","لكي تستحقَّ الثناء الجميلا",31,"ل",2,0],["وافنِ اللياليَ خالداً متسلِّطاً","حتى يقوَّمَ مَيْلُها ويثقَّفُ",32,"ف",1,0],["وأفنيةٌ تقبِضُ الوافدين","إذا رُفِعتْ بينهم كَبَّروا",33,"ر",3,0],["وَأَفناءُ قَيسٍ قَد أَبَدنا سَراتَهُم","وَعَبساً سَقَينا بِالأُجاجِ المُعَوَّرِ",34,"ر",1,0],["وأفناني ولا يفنى نهار","وليل كلما يمضي يعود",35,"د",1,0],["وأفنى نِزاراً واليمانين قبلهمْ","وحطّهمُ من شاهقاتِ المعاقلِ",36,"ل",1,0],["وأفنيَةٍ إمّا فِناءٌ مُراوَحٌ","مُغادى إليه أو فِناءٌ مُعَطَّلُ",37,"ل",1,0],["وأفنيةٌ لا يُعرَفُ الضّيمُ بينها","وَلا الفقرُ مرهوبٌ ولا العيش بالضَّنْكِ",38,"ك",1,0],["وافنوا عن الفكر إن الفكر فيه تاهْ","وما تشاؤن إلا أن يشاء اللهْ",39,"ه",1,0],["وأفنى بما أبقى هواها لها بها","من الكلِّ بل أبقى هواها بما أفنى",40,"ن",2,0],["وَأَفنِيَةً تَحكي الجِنانَ نُضارَةً","وَأَقنِيَةً تَجري عَلى كُلِّ أَخضَرِ",41,"ر",1,0],["وَأَفنان أَدواح التمدّن غرّدت","بمصر عَلَيها للأنام حَمائم",42,"م",1,0],["وَأَفنِ مِنهُمُ الصّفوفْ","وَخُذ بِهِم إِلى السّعيرْ",43,"ر",1,0],["وَأَفنى الحَوادِثُ ساداتَنا","وَمَرُّ اللَيالي وَتَكرارُها",44,"ر",3,0],["وافن تبق ومت تعش وتخلى","تتحلى وغب تجده وصولا",45,"ل",2,0],["وأفناه عنه بالبقا وأقامه","بمعناه فهو الفرد لا يتقسم",46,"م",1,0],["وأفناء جند لو توجه جمعهم","لرومية جالت عليها المقاسم",47,"م",1,0],["وأفنيتم فيه أعماركم","فأي زمانٍ به تعملونا",48,"ن",2,0],["وأفنيت صبراً بحجم الخطب دونه","فمن بعدها لم يبق للصبر موضعا",49,"ع",2,0],["وأَفْنَيْتَهُمْ طَعْنَاً وَضَرباً كَأَنَّما","تَرَدُّدُهُ فيهِمْ تَلَجْلُجُ فَأْفَاءِ",50,"ا",2,0],["وأَفْنَيْتُ في حبِّ الغَواني شَبيبَتي","ولَمْ أَقْتَصِرْ عَنْهُنَّ والرَّأْسُ أَشْيَبُ",51,"ب",1,0],["وافن عن جملة الوجود لتبقى","وانخلع عن جميع هذا الانام",52,"م",1,0],["وافنيت أعوامي عليك مداعباً","فصرتَ تُرى مثل الفرند على الصقل",53,"ل",1,0],["وأفناهم عن كل شيء بوصله","فغابوا عن الأكوان في غيب ظله",54,"ه",1,0],["وأفنانُ عيشٍ ذُقت بين ظلالها","جناها على وشي النّعيم المُمهّدِ",55,"د",1,0],["وأفنى البكا نومي وأعفى مسالكي","فلا سنةٌ تدنيك مني ولا سمت",56,"ت",1,0],["وأفنينا قريظة إذ أخلوا","وأجلينا النضير مطردينا",57,"ن",2,0],["وَأَفنِيَةُ المُلوكِ مُحَجَّباتٌ","وَبابُ اللَهِ مَبذولُ الفِناءِ",58,"ا",2,0],["وأفنى بنى أيوب كُثْرَ جميعهم","وما منهم إلاَّ مليكٌ مُعَظم",59,"م",1,0],["وأفنت رجالي عوادي الخطوب","فلم تبق منهم شبابا وشيبا",60,"ب",2,0],["وَأَفنى الشَبابَ وَأَهلاً مَضَوا","وَما كُنتُ مِمَّن بِذاكَ اكتَرَث",61,"ث",1,0],["وَأَفنى مَجدُها الأَجيالَ حَتّى","أَقَرَّ لَها الزَمانُ بِصَولَجانِ",62,"ن",1,0],["وأفني في الرقاد ثمين عمري","كأني ميت في جوف قبر",63,"ر",1,0],["وأفنيت صبري وكنت الصبو","ر على نوب الزمن من الجابر",64,"ر",1,0],["وَأَفنى وَما أُفني مِنَ الدَهرِ لَيلَةً","وَلَم يُغنِ ما أَفنَيتُ سِلكَ نِظامِ",65,"م",1,0],["وأَفنينَ بالدَّلِّ ليلَ التِّمَا","مِ دونَ الثيابِ ودونَ الأُزُر",66,"ر",1,0],["وأَفني الركضُ منه كلَّ طرفٍ","وجُنَّةَ كل سابحةٍ رواعِ",67,"ع",1,0],["وافني عيوني بالبكاء صبابةً","فيحنو عليَّ الحسن منكِ فيهمعُ",68,"ع",1,0],["وأفناهم غزواً بكل كتيبةٍ","على منهل الاقدام يبدو ركامها",69,"م",3,0],["وَأَفنيتُ أَيامي غَراماً وَصَبوةً","وَضيعتُها ما بَين لاهٍ وَلاعب",70,"ب",1,0],["وأفنى ذاك الجيش إلا أقله","وراحت تذيع الخطب منه فلول",71,"ل",1,0],["وأفنيت في التحقيق عمرك كله","وقولك فصل في الجدال سديد",72,"د",1,0],["وَأَفنانِها وَالطَيرُ تَندُبُ شَجوَها","بِأَشجارِها بَينَ المِياهِ الزَواخِرِ",73,"ر",1,0],["وأفني النُّفوسَ وأفري الرُّؤسَ","نعمْ والقُنوسَ ولمْ أذعُرِ",74,"ر",1,0],["وأفنني فيك وفيك أبقني","وبك أبقِ ربِّ ذكري واسقني",75,"ي",1,0],["وأفنِ في ذاتك والصفاتِ","كلّ صفاتي وكلَّ ذاتي",76,"ي",1,0],["وافن الثنائية بالألوهيهْ","في حضرة الجمع وفي الأحديهْ",77,"ه",1,0],["وافننا بالعرفان فيك ذواتاً","حيثما زدت زاد فقري إليكَ",78,"ك",1,0],["وأفنيت عمري في دقيقق علومه","وما بغيتي إلا رضاه وقربه",79,"ب",2,0],["وَأَفنانِها سكرى تثنت وَصفقَت","وَريح الصِبا لِلعودِ مِنهُن واتِر",80,"ر",1,0],["وأفنوْا نبتَها حصدا","باسم العلم والفن",81,"ن",1,0],["وأفن به فإن وسمك بالفنا باسمه إحسان","وإن دعوك النداما للمدامه والأدنان",82,"ن",1,0],["وأفنان بانات اللوا قد تمايلت","بروحيَ منها أملَدُ القد أغيدُ",83,"د",1,0],["وأفنيتُ الشباب كما تراني","على حال المشيب وما صفى راح",84,"ح",1,0],["وَأُفني إِذا شِئتُ الأَنامَ بِلَمحَةٍ","وَأُحيي بِلَفظٍ ما حَوَتهُ البَلاقِعُ",85,"ع",1,0],["وافنهُ بلقيس حسن من سناه علت","على علا عرش عز قد سما شرفا",86,"ف",2,0],["وأفنيت عمري في علوم دقيقة","وما بغيتي إلا رضاه وقربه",87,"ب",2,0],["وأفنَانِي البُكَاءُ جوًى ولمَّا","جرَى باليأسِ أفنَيتُ البُكَاءَ",88,"ا",2,0],["وَأَفْنَى عُمْرَهُ عِلْمًا وَفِعْلاً","وَإيمَانًا وَصَبْرًا وَاحْتِجَابَا",89,"ب",2,0],["وأفنى 