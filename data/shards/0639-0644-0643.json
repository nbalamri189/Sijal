{"poems":[[45,"شد ما أغرمت ظلوم بهجري","https://www.aldiwan.net/poem63602.html","الطويل"],[266,"اطلب أبا القاسم الخمول ودع","https://www.aldiwan.net/poem69120.html","عموديه"],[268,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[406,"وقائل رابه ضلالي عن","https://www.aldiwan.net/poem32608.html","المنسرح"],[456,"لا تلمس الشمس يد","https://www.aldiwan.net/poem56236.html","مجزوء الرجز"],[462,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[560,"قضى في خلقه ذو العرش أمرا","https://www.aldiwan.net/poem52739.html","الوافر"]],"verses":[["عَلَّكَ اِبنَ الحِصانِ تَزدادُ في غَي","ظِ أَعادِيَّ بِالحِصانِ الطِمِرِّ",0,"ر",1,0],["علك تطفي ما أنت موقده","إذ أنت في الجهل تخلع الرسنا",1,"ن",2,0],["عل كلِّ رشٍّ من دمٍ رشُّ مدمعٍ","ففي الوجدِ صار الدّمعُ والدَّمُ جوهرا",2,"ر",2,0],["علّكَ تَنجُو منهم فقلتُ له","إيّاك عنّي حاشَايَ أن أنْجُو",3,"و",1,0],["علّك من مطليَ بال","شكر عليها تَجدُ",4,"د",1,0],["علَّك أن لم تضعهُ لا تجتوي","علَّك في المكرمات أو نهلك",5,"ك",1,0],["علكيمْ بالتَّأسِّي فهو طِبٌّ","بهِ داءُ الأسَى في القلبِ يَبْرا",6,"ر",2,0]]}