{"poems":[[47,"شد ما أغرمت ظلوم بهجري","https://www.aldiwan.net/poem63602.html","الطويل"],[273,"اطلب أبا القاسم الخمول ودع","https://www.aldiwan.net/poem69120.html","عموديه"],[275,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[415,"وقائل رابه ضلالي عن","https://www.aldiwan.net/poem32608.html","المنسرح"],[463,"لا تلمس الشمس يد","https://www.aldiwan.net/poem56236.html","مجزوء الرجز"],[469,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[567,"قضى في خلقه ذو العرش أمرا","https://www.aldiwan.net/poem52739.html","الوافر"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66745","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100371","البسيط"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125928","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[5055,"يا البندري","https://www.poetsgate.com/ViewPoem.aspx?id=110088",""]],"verses":[["عَلَّكَ اِبنَ الحِصانِ تَزدادُ في غَي","ظِ أَعادِيَّ بِالحِصانِ الطِمِرِّ",0,"ر",1,0],["علك تطفي ما أنت موقده","إذ أنت في الجهل تخلع الرسنا",1,"ن",2,0],["عل كلِّ رشٍّ من دمٍ رشُّ مدمعٍ","ففي الوجدِ صار الدّمعُ والدَّمُ جوهرا",2,"ر",2,0],["علّكَ تَنجُو منهم فقلتُ له","إيّاك عنّي حاشَايَ أن أنْجُو",3,"ج",2,0],["علّك من مطليَ بال","شكر عليها تَجدُ",4,"د",1,0],["علَّك أن لم تضعهُ لا تجتوي","علَّك في المكرمات أو نهلك",5,"ك",1,0],["علكيمْ بالتَّأسِّي فهو طِبٌّ","بهِ داءُ الأسَى في القلبِ يَبْرا",6,"ر",2,0],["علكَ وقد يُبدونها بعد مِيتتي","فماذا هُديتَ اللهُ في ذاك يُصنَعُ",7,"ع",1,0],["علكن منه نيوب الموت ذا لبد","ورداً يدلُّ علوق الناب رئبالا",8,"ل",2,0],["علك تشجى في الثرى طربا","أرواح قوم في الثرى خرس",9,"س",1,0],["علك أن ترضى بدا فأمسى","ويوم حظى منك فاق أمسى",10,"س",2,0],["علك تشوف الصقر مسجون وكرة","وتقنص من الدنيا فحول الرجالي",11,"ل",2,0]]}