{"poems":[[90,"سعروها في البحر حربا ضروسا","https://www.aldiwan.net/poem44472.html","الخفيف"],[74,"خلني بالطلا أمد حياتي","https://www.aldiwan.net/poem19394.html","الخفيف"],[53,"وقروه لجاهه ولسمته","https://www.aldiwan.net/poem8704.html","الخفيف"],[91,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[91,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[87,"يا ثرى النيل في نواحيك طير","https://www.aldiwan.net/poem62831.html","الخفيف"],[87,"آل زغلول حسبكم من عزاء","https://www.aldiwan.net/poem62833.html","الخفيف"],[87,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[45,"لا افتخار إلا لمن لا يضام","https://www.aldiwan.net/poem10542.html","الخفيف"],[68,"شفها السير واقتحام البوادي","https://www.aldiwan.net/poem41577.html","الخفيف"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140892",""],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/8996","الرمل"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142334","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54328","الرمل"],[102,"عند مجهولة","https://www.poetsgate.com/ViewPoem.aspx?id=50413",""],[102,"رسالة إلى صديق في قبره","https://www.poetsgate.com/ViewPoem.aspx?id=183584",""],[53,"يا لائمي في الرَّاح غيرَ مُقَصِّرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27408",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[458,"من فؤادي يا أم هذي التحية","https://www.aldiwan.net/poem61332.html","الخفيف"],[466,"لم يدرجه إلى منصبه","https://www.aldiwan.net/poem15674.html","الرمل"],[469,"أيها الملك","https://www.aldiwan.net/poem3420.html","عموديه"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2445","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66782","الرمل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104600","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62592","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62511","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120018","الكامل"],[1149,"","https://poetry.dctabudhabi.ae/diwan/poem/67686","الرمل"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82325","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141290","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53148","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93535","الرمل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83208","الرمل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103525","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85023","الخفيف"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142988","الخفيف"],[3920,"","https://poetry.dctabudhabi.ae/diwan/poem/130243","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111471","الخفيف"],[3942,"","https://poetry.dctabudhabi.ae/diwan/poem/205163","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44895","الرمل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119712","الرمل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93740","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81282","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81275","المتقارب"],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33817","الرمل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77690","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120513","الرمل"],[4935,"ليت لي يا روح عقلاًمدركاً","https://www.poetsgate.com/ViewPoem.aspx?id=129498",""],[4984,"عاشق أنت..","https://www.poetsgate.com/ViewPoem.aspx?id=175559",""],[469,"أيها الملكُ الذي","https://www.poetsgate.com/ViewPoem.aspx?id=76536",""],[5956,"صور أشواق زوجتي إليّ","https://www.poetsgate.com/ViewPoem.aspx?id=182397",""],[5956,"عذرٌ أقبحُ من ذنب","https://www.poetsgate.com/ViewPoem.aspx?id=192180",""],[5973,"ضاع عام في الخصام وأكثر","https://www.poetsgate.com/ViewPoem.aspx?id=13685",""]],"verses":[["إنما ملكه الأثير الذي را","ح بطَيّ اهتزازه مدسوسا",0,"س",2,0],["إنما ماؤها هو الدم في العنقو","دِ يجري من عرقه وعروقي",1,"ي",1,0],["إنما مَسَّهُ وفاجَأتموهُ","فاتقى شرَّكم فواراهُ في استِهْ",2,"ت",2,0],["انما معجزاته في معانيه","وفي لفظه وفي الاسلوب",3,"ب",1,0],["انما مستقر قافلة الار","واح في غير العالم المشهود",4,"د",1,0],["إِنَّما مَنزِلٌ رُفاتُكَ فيهِ","لَبَقايا مِن كُلِّ فَنٍّ جَميلِ",5,"ل",1,0],["إِنَّما مِن كِتابِهِ يُتَوَفّى ال","مَرءُ لا مِن شَبابِهِ وَاِكتِهالِه",6,"ل",2,0],["إِنَّما مِصرُ إِلَيكُم وَبِكُم","وَحُقوقُ البِرِّ أَولى بِالقَضاء",7,"ا",2,0],["إِنَّما مُرَّةُ اِبنُ عَوفِ اِبنِ سَعدٍ","جَمَراتٌ لا تَشتَهيها النِعامُ",8,"م",1,0],["إِنَّما مَفخَري بِنَفسي وَقَومي","وَقَناتي وَصارِمي وَجَوادي",9,"د",2,0],["إنّما مَثَّلُوا صِفاتِك للنا","س كما مثَّلَ النجومَ الماءُ",10,"ا",2,0],["إنما مثوى الجاهلين جنانٌ","شاهقات القصور فيها الحور",11,"ر",1,0],["إنما مرة بن عوف بن سعدٍ","جمراتٌ لا تشتهيها النعام",12,"م",1,0],["إِنَّما ما لِيَ ما أُنفِقُهُ","وَالَّذي أَترُكُهُ لِلوَرَثَه",13,"ه",1,0],["إنما من أنا وليس بكفي","مدفع والتراب بعض امتدادي",14,"د",2,0],["إنما مت خطيباً في فمٍ","باغمٍ قد فقد اليوم الحنانا",15,"ن",2,0],["انما من انت قولي اما","خلف برق الأنس امطار المصيبه",16,"ب",2,0],["إنما ما زالت الأرض على","عهدها، والشمس ما زالت تغادي",17,"د",2,0],["إنما منْ يعشق النساء بلا أي","ر كمثل الغازي بغير سلاح",18,"ح",1,0],["إِنَّما ما حَوى الزَمانُ مِنَ الفَض","لِ وَما حازَهُ بِهِ الفُضَلاءُ",19,"ا",2,0],["إنما مريم البتول مثال لح","لال وهبت للبشريّه",20,"ي",2,0],["انما مَنْشؤهُ حِجْرُ العُلى","فَخرَ الناٍسَ جَنيناً وفَضَلْ",21,"ل",1,0],["إنما مولى جميه الن","اس من أصبح عبدك",22,"ك",1,0],["إِنَّما مُصعَبٌ شِهابٌ مِنَ اللَ","هِ تَجَلَّت عَن وَجهِهِ الظَلماءُ",23,"ا",2,0],["إنّما مولاكم بعدي إذا","حانَ موتي ودنا مُرْتَحلي",24,"ل",2,0],["انّما مهلةُ الشّبابِ بهاءٌ","فاغتنمها بنهبِ عيشٍ هَنيِّ",25,"ي",1,0],["إنما مالُ الفتى عِزَّتُه","لا بخالٍ حين يسمو أو بعَمّ",26,"م",1,0],["إنّمَا مدحك روض","وبه شِعرِيَ غنَّى",27,"ن",2,0],["إن ما مادح غيره","ألفيت مادحه يصدقُ",28,"ق",1,0],["إنّما مَوْضِعُ سِرّ المرءِ إنْ","باحَ بالسّرّ أخوهُ المُنْتَصحْ",29,"ح",1,1],["إِنَّما مَعدِن الزُّناةِ مِنَ السَف","لَةِ في بَيتِهِ وَمَأوى الزَّواني",30,"ن",2,0],["إنّما مفخري بما كنت فيه","وصغار الحمى حواليّ تزحم",31,"م",1,0],["إنما مرتقى المعالي بنو مر","وان كل يسعى لكي يرقاها",32,"ا",3,0],["إنما ملك الأيوب طود أن","ت منه في مشمخرّ الشغاف",33,"ف",1,0],["إِنَّما مِثلك مَن يَلقى الرَدى","بِثَبات العَزم صَبراً وَاِحتِسابا",34,"ب",2,0],["إِنَّما مِصرُ بِكُم قَد أَزهَرَت","وَأَذاها دونَهُ سَفكُ دَمي",35,"م",2,0],["إنما مجلس الندامى بساطٌ","للأحاديث بينهم بسطوه",36,"ه",1,1],["إِنَّما ما جَنيتَ مِن خَدِّ حُبّي","بِعُيوني يَسيلُ مِن آماقي",37,"ق",2,0],["إنما منك غرني","كلم طعمها الشهد",38,"د",1,0],["إنَّماَ مَرْيَمُ همّي","جُعِلَتْ للقلب شُغْلاَ",39,"ل",2,0],["إنما منذ ذا القتال الوبيل","لا ترى غير قاتلٍ وقتيل",40,"ل",1,0],["إِنَّما مِن زَفسَ ذا الذُلُّ المُهين","نَصرَهُ عايَنتُ قَبلاً مِثلَما",41,"م",2,0],["إِنَّما مِن جَمِيعِهِم ما استَرَدَّا","أَنا مِن دُونِهِم بِسَهمِي استَبَدَّا",42,"د",2,0],["إنما مَجلِسُ المدَام بِساطٌ","للمودات بينهم وضَعُوهُ",43,"ع",3,0],["إِنَّما مَرَت بِهِ عاصِفةٌ","هَدأت بَعدَ هياجٍ وَهُبوبِ",44,"ب",1,0],["إنما محبوب قلبي","ناسكٌ لله عابد",45,"د",1,1],["إِنَّما من يحكم الرَأي يَرى","دُونَها عِندَ ذَوي البَحث خَطر",46,"ر",1,0],["إِنما مَصر وَالشَقيق الأَخ السو","دان كانا لخافق النيل صَدرا",47,"ر",2,0],["إِنَّما مَوت عَليم عظة","لَيسَ كُل المَوت لِلناس عبر",48,"ر",1,0],["إِنَّما مَيلُكَ في مَش","يَكَ مَرعوبٌ مُخَوّف",49,"ف",1,0],["إِنَّما ماتَ حينَ ماتَ شَهيداً","فَأَقامُوا رَسماً وَلَم يَقصدوه",50,"و",2,0],["إنما من بدرنا مقتبس","نور فقه الدين والحق اليقين",51,"ن",1,0],["إنما مبلغ علمي انما","سوف نلقى من فراق جائر",52,"ر",1,0],["إنما مأملنا خلف الدنى","سعينا لمَّا يزلْ محض انحراف",53,"ف",1,0],["إنما مولى جميه الن","ناس من أصبح عبدك",54,"ك",1,0],["إنما مرآكَ يا مسعدَ روحي","تُوْصِلُ الروح لأعماق الوطرْ",55,"ر",1,0],["إنما ما زال إنساناً وفيّاً","لجميلٍ منهمُ لي جَلْببا",56,"ب",2,0],["ان ما من عمرنا الغض باق","لهو ممامنه قد مراقصر",57,"ر",1,0]]}