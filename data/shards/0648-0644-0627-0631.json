ت لوجهي أن أجود به","على بخيل ولا استسمنت ذا ورم",155,"م",1,0],["وَلاَ رَضِيتُ بِخَسْفِ الضَّيْمِ ما حَمَلَتْ","كَفِّي اليَراعَ الذِي يَخْتالُ مِنْ كَلِمي",156,"م",2,0],["وَلا رَجَعتَ إِلى مالٍ وَلا وَلَدٍ","ما كُنتَ حَيّاً وَما سُمّيتَ إِنسانا",157,"ن",2,0],["وَلا رَجَّعَت ذا حاجَةٍ عَنكَ علَّةٌ","وَلا عاقَ خَيراً عاجِلا مِنكَ آجِلُ",158,"ل",1,0],["وَلا رَأتنِيَ عينٌ لاِمرئٍ أبداً","إلّا عَرِيّاً خَلِيّاً غيرَ مقرونِ",159,"ن",1,0],["ولا رمى ذو فِطَنٍ","إليه يوماً فِطَنَهْ",160,"ن",2,0],["ولا رُئِي يومَ مصابٍ لكمْ","مُنكشِفاً في مشهدٍ مَبْسَمِي",161,"م",2,0],["ولا رعى اللَّهُ أخا مَكْرُمَةٍ","أوسعها من بعد فوْتٍ نَدَما",162,"م",2,0],["ولا رأته عينُ ذي زلّةٍ","أَبدَلَ إفحاشاً بإجمالِهِ",163,"ل",2,0],["ولا رضيتُ قراراً","إلّا قلالَ المعالي",164,"ل",2,0],["ولا رفلتْ فيهمْ وقد سلب النّدى","نفائسَهمْ تلك الهمومُ الرّوافلُ",165,"ل",1,0],["ولا رَمَيْنَ على جَدْبٍ بأَنْدِيةٍ","ولا صَبَبْنَ على مَحْلٍ بإمراعِ",166,"ع",1,0],["ولا رفع الزّمان لكم أديماً","وَلا اِزدَدتمْ به إِلّا اِنحِطاطا",167,"ط",2,0],["وَلا رأَتْنِيَ عينٌ قطّ مرتدياً","عاراً ولا كان من شنعاء ملبوسي",168,"س",2,0],["ولا رأينا لشيءٍ","نَهواهُ عندكَ فَقدا",169,"د",2,0],["وَلا رأَوْا قطُّ بِأَيديهمُ","فضيلةً منِّيَ ما غُلَّتِ",170,"ت",1,0],["وَلا رجّوا ولا حذروا جميعاً","سِوى عقبي ثَوابي أو عقابي",171,"ب",2,0],["ولا رَعَتْ عيسُك في منزلٍ","نزلتَه شيئاً من العُشبِ",172,"ب",1,0],["ولا رجوع له عما يروم نعم","له رجوع وما بين العداة كمى",173,"م",2,0],["ولا رؤية إلا له تلك رؤية","وكل سماع صار عندي سماعه",174,"ع",2,0],["ولا ريبَ أنَّ الصَّبرَ في الذَّوقِ مُرَّةٌ","موارِدُهُ في النَّفسِ حُلوُ المَصادرِ",175,"ر",1,0],["ولا رأوا عليه لما نقله","عن موضع كان النبي جعله",176,"ه",1,0],["ولأَرْكَبَنَّ الصَّعْبَ غُرَّتُه","غَرَر وخَطْرَةُ عِطْفِه خَطَر",177,"ر",1,0],["وَلا رَامَ مَرْمَى جُودِه مُتَطاوِلٌ","ولا حَازَ أَدْنى مَجْدِهِ مُتَطوِّلُ",178,"ل",1,0],["ولا رقة الأثوابِ حين تلبّست","لنا في ثياب غير خيشٍ ولا قطر",179,"ر",1,0],["وَلا رَحلي بِمَخزونٍ عَلَيهِ","إِذا جاري اِستعارَ وَلا رِدائي",180,"ا",3,0],["وَلا رَدّوا مَحورَةَ ذاكَ حَتّى","أَتانا الحِلمُ وَاِنخَرَقَ الحِجابُ",181,"ب",1,0],["وَلا رَعِشاً إِنْ جَرى سَاقُهُ","إذا بادَرَ الحَمَلَة الهيْضَلاَ",182,"ل",2,0]]}