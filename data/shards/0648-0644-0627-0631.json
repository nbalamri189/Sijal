","المجتث"],[554,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[554,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[554,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[561,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[561,"أزال عن الوجه الجميل قناعه","https://www.aldiwan.net/poem34366.html","الطويل"],[565,"سلام على وادي الأراك وحاجر","https://www.aldiwan.net/poem52743.html","الطويل"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[589,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem18010.html","الطويل"],[689,"","https://poetry.dctabudhabi.ae/diwan/poem/121241","الطويل"],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/20430","الوافر"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2522","الوافر"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/75826","المتقارب"]],"verses":[["وَلا رَدَّ في صَدرِ المَنونِ بِراحَةٍ","يَرُدُّ بِها سُمرَ القَنا وَالمَواضِيا",0,"ي",2,0],["وَلا رَكزَ إِلّا أَن تُميرَ زِجاجُها","عَوامِلَها فَضلَ النَجيعِ المُحَرَّمِ",1,"م",1,0],["وَلا رَأَينا النَجمَ ذا خِفيَةٍ","مِن قارِعِ الحافِرِ وَالمَنسَمِ",2,"م",1,0],["وَلا رَيبَ أَنّي مُبرِكٌ في مَناخِهِم","وَأَنّي بِالماضينَ أَوَّلُ لاحِقِ",3,"ق",1,0],["وَلا رُفِعَت نارٌ لَكُم مِسيَ لَيلَةٍ","وَلا راجَ مالٌ طارِفٌ وَتِلادُ",4,"د",1,0],["وَلَأُرحِلَنَّ العيسَ مَرحَلَةً","عَوجاءَ بَينَ القورِ وَالوَهدِ",5,"د",1,0],["وَلا رَأَينا الخُطوبَ داخِلَةً","رِواقَ مَجدٍ عَلَيكَ مَضروبا",6,"ب",2,0],["وَلا رُمتُ عَنها سَلوَةً وَلَو أَنَّني","تَجَنَّبتُها يَوماً لَعاقَبَني رَبّي",7,"ب",2,0],["وَلا رَجَعَت رِكابُهُمُ إِلَيهِم","إِذا وَقَفَت إِلى يَومِ التَنادِ",8,"د",1,0],["ولا ركبِنا منايانا مُطَهَّمةً","إلاّ لنكسب عزّاً من صيانته",9,"ت",2,0],["ولا رأيت ِسكارات يدخّنها","قوم بوقت انفراد واجتماعات",10,"ت",1,0],["ولا رزأت النهى والعلم وحدهما","بل قد رزأت صميم المجد والحسب",11,"ب",1,0],["ولارتحلت من العربان نضوا","غنياً عن رحالة منطفينا",12,"ن",2,0],["وَلا رَآهُم أَبو بَكرٍ وَصاحِبُهُ","أَهلاً لِما طَلَبوا مِنها وَما زَعَموا",13,"م",3,0],["وَلا راحَ يُطغيني بِأَثوابِهِ الغِنى","وَلا باتَ يَثنيني عَنِ الكَرَمِ الفَقرُ",14,"ر",1,0],["وَلا رَيبَةٌ إِلّا الحَديثُ كَأَنَّهُ","جُمانٌ وَهى أَو لُؤلُؤٌ مُتَناثِرُ",15,"ر",1,0],["ولا رمحَ منها بالنَّجيع مُخضَّبٌ","هناك ولكن بالرَّجيع مخضّبُ",16,"ب",1,0],["ولا رأيْنَا المدْحَ في غيرِه","إلا سَوَاماً غَيْرَ مَسْرُوحِ",17,"ح",1,0],["ولأرمينَّك بعدها بقصائد","فيها لكل رَميَّةٍ إقصادُ",18,"د",1,0],["ولا رُشدَ إلا بتوفيقِهِ","وإن محَضَ الرأيَ من يمحضُ",19,"ض",1,1],["ولا رُزِقت شفاءً من غليلٍ","إذا بركت لنائكها وأقعى",20,"ع",2,0],["ولا رآه الله مستعطفاً","أصل الرضا منك ولا فرعه",21,"ع",2,0],["ولا رقأت إبَّان ذاك دماؤهم","ولا أعين فاضت عليكم دموعها",22,"ع",3,0],["ولا رمت إلا النفع للناس مطلبا","ولا ارتاح لي إلا إليه ضمير",23,"ر",1,0],["وَلا رَأَيتُ غَيرَ أُمٍّ","بِالبَنينَ بَرَّةِ",24,"ه",1,0],["وَلا رَأَيتِ عُيونَ الإِنسِ تُدرِكُها","فَهَل حَسَدتِ عَلَيها أَعيُنَ الشُهُبِ",25,"ب",1,0],["وَلا رَفيقٍ وَلا صَديقٍ","وَلا شَفيقٍ وَلا عَديلِ",26,"ل",1,0],["وَلا رَأيَ لي فيمَن يُنَغَّصُ خَلوَتي","فَيَسرِقُ لَذّاتي وَيُنفِقُ مِن عُمري",27,"ر",2,0],["وَلا رَفَعوا بِوَقعِ الخَيلِ نَقعاً","وَلا نُسِجَ الغُبارُ عَلى الجِلالِ",28,"ل",1,0],["وَلا رَدَّ عَن نَفسِ اِبنَ حَمزَةَ جاشُها","وَلا الجَيشُ مِن أَمواجِهِ الأَرضُ تَرجُفُ",29,"ف",1,0],["وَلا رَأيَ لي إِلّا إِذا كُنتُ حاقِناً","لِماءِ المُحَيّا عَن سُؤالِ بَني الدَهرِ",30,"ر",1,1],["وَلا رَأَيْتَ مُلُوكَ الأَرْضِ خَائِفَةً","إِذَا رَأَتْ جَمَلاً مِنْ أَرْضِنَا وَخَدَا",31,"د",2,0],["ولا راحَ نادٍ بِالمكارِمِ للغِنى","يُقَلِّبُه في الرّاحَتَينِ فَقيرُ",32,"ر",1,0],["وَلا رَعى وُدّي وَلا حُرمَتي","وَلَم أَزَل أَرعى لَهُ الوُدّا",33,"د",2,0],["وَلا رَجَعَت فيكَ تِلكَ الظُنونُ","حَيارى وَلا اِنسَدَّ شِعبُ الرَجاءِ",34,"ا",2,0],["وَلا رَفَعوا في ذَلِكَ اليَومِ إِثلِباً","وَلا حَجَراً إِلّا وَرَأَوا تَحتَهُ دَما",35,"م",2,0],["وَلا رَعِشَ الساقِ عِندَ الجِراءِ","إِذا بادَرَ الحَملَةُ الهَيضَلا",36,"ل",2,0],["وَلا رَحِمٌ إِلّا وَقَد شُجِبَت بِكُم","وَمَزَّقتُموها مِثلَ ما مُزِّقَ المِرطُ",37,"ط",1,0],["وَلا راعَهُ في اللَّهِ قَتْلُ شَقِيقِهِ","ألا هكذا في اللَّهِ فلْيَكُن الجَلْدُ",38,"د",1,0],["وَلأَرْمِيَنَّ لهُ الفِجاجَ بِضُمَّرٍ","كالنَّبْلِ سَبْقاً والقِسِيِّ نُحولا",39,"ل",2,0],["ولا رَبُّوا مِنَ الْمُرْدانِ قَوْماً","كَأَغْصانٍ يَقُمْنَ وَيَنْحَنِينا",40,"ن",2,0],["وَلا رَأى شَفَةً مِنهُ عَلى شَفَتي","إِطباقَ عَينَيكِ بِالأَشفارِ أَشفارا",41,"ر",2,0],["وَلا رُسومٌ وَلا أَبكي لِمَنزِلَةٍ","لِلأَهلِ عَنها وَلِلجيرانِ مُنتَقَلُ",42,"ل",1,0],["وَلا رَيبَ في مَهوى الرَفيعِ إِلى الثَرى","وَلَو اِنَّهُ جارى السَماكينِ وَالغَفرا",43,"ر",2,0],["وَلا رَيبَ عِندَ اللُبِّ في أَنَّ خَيرَها","بَكيٌّ وَإِن أَمسَت مَصائِبُها غُزرا",44,"ر",2,0],["وَلاَ رِجَالٌ يُنْقِذُونَ الْحِمَى","بِحُسْنِ رَأْيٍ أَوْ بِفَضْلِ اجْتِهَادْ",45,"د",1,0],["وَلاَ رَوِيَتْ ظَمْأَى الرَّيَاحِينِ بِالنَّدَى","فَعَادَتْ كَأَزْهَى مَا تَكُونُ وَأَبْدَعِ",46,"ع",1,0],["ولا رأيت شراعا ضمه أفق","إلا ومرت هواري الصيد في فكري",47,"ر",2,0],["وَلا رَدَّ مُذ خَطَّ الصَحيفَةَ ناكِثاً","كَلاماً وَلا باتَت لَهُ عَينُ نائِمِ",48,"م",1,0],["وَلا رَجَعوا حَتّى رَأوا في شِمالِهِ","كِتاباً لِمَغرورٍ لَدى النارِ نادِمِ",48,"م",1,0],["ولا رجعت فوق الفنون حنينها","هتوف شجتها مثلها بغيابها",49,"ب",3,0],["ولا ربعها العافي عليه تناوحت","صبا ودبور أو بكته الغمائم",50,"م",1,0],["ولا رقأتْ عيْنُ امْرىء","ٍ شامتٍ يبكي أخاً ليس ببكَّاء",51,"ا",2,0],["ولا رأت عيني شمس العلا","الا محياهم الى العين لاح",52,"ح",1,0],["ولا رقصت لأخبار النقا طربا","ولا أرقت لذكر البان والعلم",53,"م",1,0],["ولا رأيت بعيني للوجود بقا","ولا شغلت بزهو اللهو واللعب",54,"ب",1,0],["ولا رعت هُمَّلُ أبصارِهم","في روضةٍ نُوّارُها أسهمُ",55,"م",1,0],["وَلا راحَةٌ لِلقَومِ مِن فَتكِ راحَةٍ","يَطولُ القَنا فيها وَإِن كانَ أَذرُعا",56,"ع",2,0],["ولا ردّنا عنها العوادي ولا العدا","ولا هالنا قفرٌ ولا راعنا بحر",57,"ر",1,0],["ولا ريب أن الجاه أعظم مشتهى","على أنه شر وأعظم به شرا",58,"ر",2,0],["وَلا رقأت مِن شَوقِها لي دَمعَ