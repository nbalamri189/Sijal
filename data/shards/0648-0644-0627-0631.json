{"poems":[[53,"أيعلم قبر بالجنينة أننا","https://www.aldiwan.net/poem29621.html","الطويل"],[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[53,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[53,"هوى لكما إن الشباب يعاد","https://www.aldiwan.net/poem30513.html","الطويل"],[53,"يا دار من قتل الهوى بعدي","https://www.aldiwan.net/poem30622.html","الكامل"],[53,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[55,"وما غاب عني وجهها مذ رأيتها","https://www.aldiwan.net/poem26516.html","الطويل"],[42,"أقول وزادني جزعا وغيظا","https://www.aldiwan.net/poem50292.html","الوافر"],[88,"يا موطنا ما انتضيناها مهندة","https://www.aldiwan.net/poem44465.html","البسيط"],[88,"كل ابن آدم مقهور بعادات","https://www.aldiwan.net/poem44993.html","البسيط"],[88,"لمن تركت فنون العلم والأدب","https://www.aldiwan.net/poem45052.html","البسيط"],[37,"الا حييت عنا يا مدينا","https://www.aldiwan.net/poem7642.html","الوافر"],[47,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[47,"أراك عصي الدمع شيمتك الصبر","https://www.aldiwan.net/poem25258.html","الطويل"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[51,"عجبت لقوم يقبلون مدائحي","https://www.aldiwan.net/poem8165.html","الطويل"],[51,"أبشر بفتح لك مفتوح","https://www.aldiwan.net/poem9415.html","السريع"],[51,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[51,"ولا رشد إلا بتوفيقه","https://www.aldiwan.net/poem64976.html","المتقارب"],[51,"إذا ما شنطف نكهت أماتت","https://www.aldiwan.net/poem65079.html","الوافر"],[51,"بدعة عندي كاسمها بدعه","https://www.aldiwan.net/poem65395.html","السريع"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[85,"شجوني إذا جن الظلام كثير","https://www.aldiwan.net/poem7520.html","الطويل"],[85,"لست بناس ليلة","https://www.aldiwan.net/poem8051.html","مجزوء الرجز"],[43,"يا أخت خير أخ يا بنت خير أب","https://www.aldiwan.net/poem9460.html","البسيط"],[49,"يا ساكن القبر عن قليل","https://www.aldiwan.net/poem63066.html","مجزوء البسيط"],[66,"أحب صديقا منصفا في ازدياده","https://www.aldiwan.net/poem38564.html","الطويل"],[66,"نفوس الصيد أثمان المعالي","https://www.aldiwan.net/poem40137.html","الوافر"],[66,"جبال بأرياح المنية تنسف","https://www.aldiwan.net/poem40297.html","الطويل"],[66,"ولا رأي لي إلا إذا كنت حاقنا","https://www.aldiwan.net/poem41562.html","الطويل"],[80,"جرى بك جد بالكرام عثور","https://www.aldiwan.net/poem31423.html","الطويل"],[44,"صد وما احتسب الصدا","https://www.aldiwan.net/poem30268.html","السريع"],[44,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[44,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[13,"تقول سليمى لجاراتها","https://www.aldiwan.net/poem2210.html","المتقارب"],[52,"ألا تريان البرق ما هو صانع","https://www.aldiwan.net/poem26872.html","الطويل"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[48,"إن لا تزوري فإن الطيف قد زارا","https://www.aldiwan.net/poem63288.html","الوافر"],[48,"ما لي بدار خلت من أهلها شغل","https://www.aldiwan.net/poem64514.html","البسيط"],[46,"إذا آمن الإنسان بالله فليكن","https://www.aldiwan.net/poem22603.html","الطويل"],[46,"لقد أصبحت دنياك من فرط حبها","https://www.aldiwan.net/poem22604.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199488","البسيط"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/8199","الطويل"],[50,"قَدْ لَعب الدَّهْرُ علَى هامَتِي","https://www.poetsgate.com/ViewPoem.aspx?id=15956",""]],"verses":[["وَلا رَدَّ في صَدرِ المَنونِ بِراحَةٍ","يَرُدُّ بِها سُمرَ القَنا وَالمَواضِيا",0,"ي",2,0],["وَلا رَكزَ إِلّا أَن تُميرَ زِجاجُها","عَوامِلَها فَضلَ النَجيعِ المُحَرَّمِ",1,"م",1,0],["وَلا رَأَينا النَجمَ ذا خِفيَةٍ","مِن قارِعِ الحافِرِ وَالمَنسَمِ",2,"م",1,0],["وَلا رَيبَ أَنّي مُبرِكٌ في مَناخِهِم","وَأَنّي بِالماضينَ أَوَّلُ لاحِقِ",3,"ق",1,0],["وَلا رُفِعَت نارٌ لَكُم مِسيَ لَيلَةٍ","وَلا راجَ مالٌ طارِفٌ وَتِلادُ",4,"د",1,0],["وَلَأُرحِلَنَّ العيسَ مَرحَلَةً","عَوجاءَ بَينَ القورِ وَالوَهدِ",5,"د",1,0],["وَلا رَأَينا الخُطوبَ داخِلَةً","رِواقَ مَجدٍ عَلَيكَ مَضروبا",6,"ب",2,0],["وَلا رُمتُ عَنها سَلوَةً وَلَو أَنَّني","تَجَنَّبتُها يَوماً لَعاقَبَني رَبّي",7,"ي",1,0],["وَلا رَجَعَت رِكابُهُمُ إِلَيهِم","إِذا وَقَفَت إِلى يَومِ التَنادِ",8,"د",1,0],["ولا ركبِنا منايانا مُطَهَّمةً","إلاّ لنكسب عزّاً من صيانته",9,"ت",2,0],["ولا رأيت ِسكارات يدخّنها","قوم بوقت انفراد واجتماعات",10,"ت",1,0],["ولا رزأت النهى والعلم وحدهما","بل قد رزأت صميم المجد والحسب",11,"ب",1,0],["ولارتحلت من العربان نضوا","غنياً عن رحالة منطفينا",12,"ن",2,0],["وَلا رَآهُم أَبو بَكرٍ وَصاحِبُهُ","أَهلاً لِما طَلَبوا مِنها وَما زَعَموا",13,"م",3,0],["وَلا راحَ يُطغيني بِأَثوابِهِ الغِنى","وَلا باتَ يَثنيني عَنِ الكَرَمِ الفَقرُ",14,"ر",1,0],["وَلا رَيبَةٌ إِلّا الحَديثُ كَأَنَّهُ","جُمانٌ وَهى أَو لُؤلُؤٌ مُتَناثِرُ",15,"ر",1,0],["ولا رمحَ منها بالنَّجيع مُخضَّبٌ","هناك ولكن بالرَّجيع مخضّبُ",16,"ب",1,0],["ولا رأيْنَا المدْحَ في غيرِه","إلا سَوَاماً غَيْرَ مَسْرُوحِ",17,"ح",1,0],["ولأرمينَّك بعدها بقصائد","فيها لكل رَميَّةٍ إقصادُ",18,"د",1,0],["ولا رُشدَ إلا بتوفيقِهِ","وإن محَضَ الرأيَ من يمحضُ",19,"ض",1,1],["ولا رُزِقت شفاءً من غليلٍ","إذا بركت لنائكها وأقعى",20,"ع",2,0],["ولا رآه الله مستعطفاً","أصل الرضا منك ولا فرعه",21,"ع",2,0],["ولا رقأت إبَّان ذاك دماؤهم","ولا أعين فاضت عليكم دموعها",22,"ع",3,0],["ولا رمت إلا النفع للناس مطلبا","ولا ارتاح لي إلا إليه ضمير",23,"ر",1,0],["وَلا رَأَيتُ غَيرَ أُمٍّ","بِالبَنينَ بَرَّةِ",24,"ه",1,0],["وَلا رَأَيتِ عُيونَ الإِنسِ تُدرِكُها","فَهَل حَسَدتِ عَلَيها أَعيُنَ الشُهُبِ",25,"ب",1,0],["وَلا رَفيقٍ وَلا صَديقٍ","وَلا شَفيقٍ وَلا عَديلِ",26,"ل",1,0],["وَلا رَأيَ لي فيمَن يُنَغَّصُ خَلوَتي","فَيَسرِقُ لَذّاتي وَيُنفِقُ مِن عُمري",27,"ي",1,0],["وَلا رَفَعوا بِوَقعِ الخَيلِ نَقعاً","وَلا نُسِجَ الغُبارُ عَلى الجِلالِ",28,"ل",1,0],["وَلا رَدَّ عَن نَفسِ اِبنَ حَمزَةَ جاشُها","وَلا الجَيشُ مِن أَمواجِهِ الأَرضُ تَرجُفُ",29,"ف",1,0],["وَلا رَأيَ لي إِلّا إِذا كُنتُ حاقِناً","لِماءِ المُحَيّا عَن سُؤالِ بَني الدَهرِ",30,"ر",1,1],["ولا راحَ نادٍ بِالمكارِمِ للغِنى","يُقَلِّبُه في الرّاحَتَينِ فَقيرُ",31,"ر",1,0],["وَلا رَعى وُدّي وَلا حُرمَتي","وَلَم أَزَل أَرعى لَهُ الوُدّا",32,"د",2,0],["وَلا رَجَعَت فيكَ تِلكَ الظُنونُ","حَيارى وَلا اِنسَدَّ شِعبُ الرَجاءِ",33,"ا",2,0],["وَلا رَفَعوا في ذَلِكَ اليَومِ إِثلِباً","وَلا حَجَراً إِلّا وَرَأَوا تَحتَهُ دَما",34,"م",2,0],["وَلا رَعِشَ الساقِ عِندَ الجِراءِ","إِذا بادَرَ الحَملَةُ الهَيضَلا",35,"ل",2,0],["وَلا رَحِمٌ إِلّا وَقَد شُجِبَت بِكُم","وَمَزَّقتُموها مِثلَ ما مُزِّقَ المِرطُ",36,"ط",1,0],["وَلا راعَهُ في اللَّهِ قَتْلُ شَقِيقِهِ","ألا هكذا في اللَّهِ فلْيَكُن الجَلْدُ",37,"د",1,0],["وَلأَرْمِيَنَّ لهُ الفِجاجَ بِضُمَّرٍ","كالنَّبْلِ سَبْقاً والقِسِيِّ نُحولا",38,"ل",2,0],["ولا رَبُّوا مِنَ الْمُرْدانِ قَوْماً","كَأَغْصانٍ يَقُمْنَ وَيَنْحَنِينا",39,"ن",2,0],["وَلا رَأى شَفَةً مِنهُ عَلى شَفَتي","إِطباقَ عَينَيكِ بِالأَشفارِ أَشفارا",40,"ر",2,0],["وَلا رُسومٌ وَلا أَبكي لِمَنزِلَةٍ","لِلأَهلِ عَنها وَلِلجيرانِ مُنتَقَلُ",41,"ل",1,0],["وَلا رَيبَ في مَهوى الرَفيعِ إِلى الثَرى","وَلَو اِنَّهُ جارى السَماكينِ وَالغَفرا",42,"ر",2,0],["وَلا رَيبَ عِندَ اللُبِّ في أَنَّ خَيرَها","بَكيٌّ وَإِن أَمسَت مَصائِبُها غُزرا",43,"ر",2,0],["وَلاَ رِجَالٌ يُنْقِذُونَ الْحِمَى","بِحُسْنِ رَأْيٍ أَوْ بِفَضْلِ اجْتِهَادْ",44,"د",1,0],["وَلاَ رَوِيَتْ ظَمْأَى الرَّيَاحِينِ بِالنَّدَى","فَعَادَتْ كَأَزْهَى مَا تَكُونُ وَأَبْدَعِ",45,"ع",1,0],["ولا رأيت شراعا ضمه أفق","إلا ومرت هواري الصيد في فكري",46,"ي",1,0],["وَلا رَدَّ مُذ خَطَّ الصَحيفَةَ ناكِثاً","كَلاماً وَلا باتَت لَهُ عَينُ نائِمِ",47,"م",1,0],["وَلا رَجَعوا حَتّى رَأوا في شِمالِهِ","كِتاباً لِمَغرورٍ لَدى النارِ نادِمِ",47,"م",1,0],["ولا رقأتْ عيْنُ امْرىء","ٍ شامتٍ يبكي أخاً ليس ببكَّاء",48,"ا",2,0]]}