{"poems":[[10,"كأن ابن عمرو لم يصبح لغارة","https://www.aldiwan.net/poem21085.html","الطويل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[8,"هل بالديار الغداة من صمم","https://www.aldiwan.net/poem21838.html","المنسرح"],[97,"سر السراب","https://www.poetsgate.com/ViewPoem.aspx?id=12258",""],[264,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66816","الوافر"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97984","البسيط"],[5691,"أقولُ لأمَّتي...!","https://www.poetsgate.com/ViewPoem.aspx?id=207393",""],[6066,"مَأْسَاتِيْ فِيْ جُوَانْتَانَامُو","https://www.poetsgate.com/ViewPoem.aspx?id=12669",""],[6102,"أُمِّي وَأُمِّي","https://www.poetsgate.com/ViewPoem.aspx?id=182734",""]],"verses":[["فَخَنساءُ تَبكي في الظَلامِ حَزينَةً","وَتَدعو أَخاها لا يُجيبُ مُعَفَّرا",0,"ر",2,0],["فَخَندَقَ المُؤمِنُونَ الدّارَ وَاِنتَصَبُوا","لِحَربِهِم كَضَواري الأُسدِ في الأَجَمِ",1,"م",1,0],["فخُنتَ عَهدَ الإِخاءِ مُبتَدِئاً","وَلَم تَخَف مِن غَوائِلِ النِقَمِ",2,"م",1,0],["فخنقتها في خاطري ! فتساقطتْ","في أدمعي ، فشربتها متلعثما",3,"م",2,0],["فخندريسُ أكؤسِ العروسِ","لا يرشفنّها أولو النفوس",4,"س",1,0],["فخنتِ محمداً في أقرَبيهِ","ولم تَرعَيْ له القولَ الرَّصينا",5,"ن",2,0],["فخنتني ونقضت العهد معتمدا","على النهانه في تهويل مصلاق",6,"ق",1,0],["فخُنْتِ عُهودَهُ ورَجَعْتِ شَتّىً","ممَزَّقَةً ومُجْتَمَعاً عَليلا",7,"ل",2,0],["فخنزيرهم يعلو بوجهي صراخه","يكبل اطرافي فيضعف عزمها",8,"م",3,0],["فَخَنَقتُ نَبضاتِ الوَريدِ, فَلا صَدَىً","يَرتَدُّ نَبضًا مِن صَدى شِريانِها",9,"ن",3,0]]}