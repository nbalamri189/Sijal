4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117225","الوافر"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28939","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76684","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120526","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52124","الوافر"],[1901,"ليَ الله ما ننفكّ ترفضُ أدمعي","https://www.poetsgate.com/ViewPoem.aspx?id=160399",""],[4955,"أخي في الله لا تحزن","https://www.poetsgate.com/ViewPoem.aspx?id=202292",""],[585,"هو الصوت دوّى من فلسطين عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=161906",""],[5155,"في ذكرى الرصافي","https://www.poetsgate.com/ViewPoem.aspx?id=176479",""],[5236,"رأتني ومن لبسي المشيب فأملت","https://www.poetsgate.com/ViewPoem.aspx?id=82570",""],[5236,"لئن فرحت بي معقل عند شيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=82569",""],[5277,"مِن تهجّدات البدوي الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=208837",""],[5302,"جعلت فداكا","https://www.poetsgate.com/ViewPoem.aspx?id=205728",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5351,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=202129",""],[242,"أبى القصر الا ان يحوز العلا قسرا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563725",""],[5490,"أهذا الصبح..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81929&r=&rc=15",""]],"verses":[["لَئِن فَلَّلَ الذُلّانُ مِنهُ فَرُبَّما","تَحَيَّفَ مِن ماضي الظُبى شَقُّ مِبرَدِ",0,"د",1,0],["لَئِن فارَقتُهُم وَبَقيتُ حَيّاً","لَقَد فارَقتُ بَعدَهُمُ الشَبابا",1,"ب",2,0],["لَئِن فاتَني مِنكِ حَظُّ النَظَر","لِأَكتَفِيَن بِسَماعِ الخَبَر",2,"ر",1,1],["لئن فارقتني وصددت عني","فقلبي لا يفارقه الوَجيب",3,"ب",1,0],["لئن فهمت عيناكِ حالي معرّباً","لقد سلَّ منها الجفن سيفاً مهنَّدا",4,"د",2,0],["لئن فخرتَ بآباءٍ ذوي حسبٍ","لقد صدقت ولكن بئس ما ولدوا",5,"د",3,1],["لينفكّ عن دار الحياة وعنهُمُ","فتىً منهم حامي المحيّا عزوَّر",6,"ر",1,0],["لَئِن فَرَّقَت بَينَ الغَواني جَمالَها","لَدامَ لَها ما يَجعَلُ الغيدَ تَغضَبُ",7,"ب",1,0],["لَئِن فاتَ ما أَمَّلتِهِ مِن مَواكِبٍ","فَدونَكِ هَذا الحَشدَ وَالمَوكِبَ الضَخما",8,"م",2,0],["لَئِن فاتَ مِصراً أَن يَموتوا بِأَرضِها","لَقَد ظَفِروا بِالبَعثِ مِن تُربِها الغالي",9,"ل",2,0],["لَئِن فُتَّ غاياتِ الأَئِمَّةِ سابِقاً","فَطُلتَ المُلوكَ سائِساً وَمُدَبِّرا",10,"ر",2,0],["لَئِن فارَقتُكُم عَبَثاً فَإِنّي","عَلى يَومِ الفِراقِ لَجِدُّ زارِ",11,"ر",1,0],["لَئِن فاتَ وَفري في اللِئامِ فَلَم أُطِق","تَلافِيَهُ مُستَرجِعاً بِلُحوقِ",12,"ق",1,0],["لي نفحةُ المحبوب حين يَشمني","طيباً ولونُ الصّبّ حين يَراني",13,"ن",2,0],["لئن فاحَ طيبٌ من ثراهُ لناشقٍ","ففخرُكَ فيه فتّقَ المسكَ والنّدّا",14,"د",2,0],["ليَ نفسٌ نفيسةٌ لم يعبْها","غيرُ حظي وذا بغيرِ اختياري",15,"ي",1,1],["لئن فَزِعَ الفَتى والشّيخُ منها","فما أمِنَ الجنينُ ولا الوليدُ",16,"د",1,0],["لَئِن فاتَني الذَهَبُ المُنتَقى","فَما فاتَني الأَدَبُ المُذهَبُ",17,"ب",1,0],["لَئِن فُجِعنا بِما لا خَلقَ يَعدِلُهُ","وَما لَهُ في الوَرى إِلّا اِبنَهُ ثانِ",18,"ن",1,0],["لَئِنْ فَرَّقَتْ مَا بَيْنَنَا شُقَّةُ النَّوَى","لَعَمْرِي وَحَالَتْ دُونَنَا نُوَبُ الدَّهْرِ",19,"ر",1,1],["لي نفس أذابها وهج الشو","ق فلم يبق غير خفق الفؤاد",20,"د",1,0],["لي نفس لولا التشقي بأروا","ح صباها ذابت بحر جواها",21,"ا",3,0],["لي نَفَسٌ كيف بتَصعيده","والشوقُ مني آخِذٌ بالخِناق",22,"ق",1,0],["لَئِنْ فَاتَ وَفْرِي في اللّثَامِ فلم أُطقْ","تَلافِيَهُ، مُستَرْجعَاً بِلُحُوقِ",23,"ق",1,0],["لئِنْ فارَقْتُكُمْ عبثاً، فَإنّي","عَلى يَوْمِ الفِرَاقِ الجِدّ زَارِ",24,"ر",1,0],["لَئِن فاتَني ادراك ما أُدرك الأُولى","فَأَنفذت أَيامي عَلَيهِ أَمانيا",25,"ي",2,0],["لي نفس موصولة بك ما عشت","وكالنجم أنت مني بعدا",26,"د",2,1],["لَئِن فَجَعَتنا الحادِثاتُ بِشَخصِهِ","لَهُنَّ لِما حُكِّمنَ فيهِ فَواجِعُ",27,"ع",1,0],["لئن فتكتْ بي مقلتاها فَرُبَّما","أكرُّ وعزمي بالحوادثِ فاتك",28,"ك",1,0],["لي نَفَسٌ يعسر تردادهُ","كنورِ مِصباحٍ بَدا يَنطَفي",29,"ف",2,0],["ليَ نَفسٌ عَلَّمَتني","كَيفَ أَستَزري لِئامَه",30,"م",2,0],["ليَ نَفسٌ كَالبَحرِ ذات اِتِّساعٍ","فَلُبابٌ يُلقى بِها وَقشورُ",31,"ر",1,0],["لَئِنْ فَرَّقَ الدَّهْرُ الْمُشِتُّ انْتِظَامَنَا","بِلِينٍ فَمَا وَجْدِي عَلَيْكُمْ بِصَعْصَعِ",32,"ع",1,0],["لئن فاتك النطقُ الفصيحُ كما تَرى","فسهمُك من نُطقِ الفؤادِ وفيرُ",33,"ر",1,0],["لئن فاتني ما فاتَ مِثلي مِن المُنى","رَجعتُ ضَحُوكاً منهُ بعد فَوات",34,"ت",1,0],["لِيَ نَفسٌ لَم يَبقَ إِلا ذَماها","وَفُؤادٌ في الحُبِّ عَزَّ اِصطِبارُه",35,"ر",2,0],["لئن فلَّتِ الأيامُ غربيه حقبةً","فقد أرهفوا حدَّيه بالدمِ جاريا",36,"ي",2,0],["لئن فرَّقتْ كتبُ الديانات بيننا","لتجمعنا صحفُ الهوى بغضونها",37,"ن",3,0],["لي نَفَسٌ ما سفتها عميقُ","كأنه لطوله شهيقُ",38,"ق",1,0],["لي نَفس مُضنىً بِغَير السقم ما طَمعت","وَطَرف صَبٍّ لِغَير السُهد ما طَمحا",39,"ح",2,0],["لَئِن فَطَموهُ عن رِضاع لبانِهِ","فَما فَطَموهُ عَن رِضاع المَكارِم",40,"م",1,0],["لَئِنْ فَرضوا مِنّي السلوَّ جهالةً","فحبكُم عندي هو الفرضُ والنَّقْلُ",41,"ل",1,0],["لئن فرقت بيني وبينك غربة","فقد جمعتنا بعد ذلك أوراق",42,"ق",1,0],["لَئِنْ فرّق الدّهرُ المشتِّتُ شملَنا","فأصبحتُ في شَرقٍ وأمسيتَ في غَربِ",43,"ب",1,1],["لئن فارقتكم كرها فقلبي","لكم طوع بحبّكم حفيّ",44,"ي",1,0],["لَئِنْ فاتَني صَرْفُ الحِمامِ بِظِلِّها","لقد أَخْلَفَتْ لي من جَنى ثَمَرَاتِها",45,"ت",3,0],["لَئِنْ فُجِعْتُ بِهَا بيضاءَ من وَرَقٍ","تبأَى عَليَّ لقد أُخْلِفْتُها ذَهَبا",46,"ب",2,0],["لئن فقدتك في أَشياء طلتُ بها","فأَنت في جُملة الأَشياء تفقدني",47,"ن",2,0],["لي نفس مشغوفٍ بسالف عهده","لم ترض نسيانَ الرفيق الأقدم",48,"م",1,0],["لئنْ في الخَلْقِ حاكَتْهُ جُسومٌ","فسُحْبُ الوَدْقِ تُشبِهُها الجَهامُ",49,"م",1,0],["لَئِن فَتكَت سودُ العُيونِ بِمُهجَتِي","فكَم أورَدَتنِي زُرقُهَا مَوردَ الهَلكِ",50,"ك",1,1],["لئن فاتَ نجداً رِيفُ مِصرَ ونِيلُها","ففي نجدَ رِيفٌ من نَداهُ ونِيلُ",51,"ل",1,0],["لَئِنْ فاتَ البِلادَ قديمُ عَصرٍ","فها قد جاءَها عَصرٌ جديدُ",52,"د",1,0],["لَئِن فاتَنا عَينُ الحَبيبِ فَإِنَّما","بِآثارِهِ الحُسنى اِكتِفاءُ مَنِ اِستَكفى",53,"ف",2,0],["لئن فارَقتَنا زمناً فعنّا","جمالكَ لا يروح ولا يغيبُ",54,"ب",1,0],["لَئن فارَقنَنا عَرباً وإنساً","لَقَد فارَقنَنا حُوراً وَجِنّا",55,"ن",2,0],["لئن فاتكم في أمسه الرفق والرضى","فما فاتكم في يومه الذوق والشَيم",56,"م",1,0],["لئن فارق الدنيا الصديقان بغتةً","فقد أخذا من خيرها حصَّتيهما",57,"م",2,0],["لين في الوديان ويزيد جريْها","وعْمان تتسمّى على من جمودها",58,"د",3,0],["لَئِن فَتَنَتني فَهيَ بِالأَمسِ أَفتَنَت","سَعيداً فَأَمسى قَد قَلى كُلَّ مُسلِمِ",59,"م",1,1],["لئنْ فاتَ في أمس فناء إفنتهم","سيلقى غداً رِجزَ العذبِ أليماً",60,"م",2,0],["لئن فجعت مصرٌ به فلطالما","كساها سروراً سعيُه ومناصبُهْ",61,"ب",2,0],["ليَ نفسٌ وصاحباها فؤاد","وحُسَامُ كِلٌّ يزيل عناها",62,"ا",3,0],["لِيَ نَفْسٌ رَفِيعَةٌ وَفُؤَادٌ","هُوَ أصْفَى مِنْ ابْنِةِ العُنْقُودُ",63,"د",1,0],["لِيَ نَفْسٌ تِشيمُ بَارقَ خَطْبٍ","مِنْكَ قدْ يُبْهِرُ النَّواظِرَ خطْبا",64,"ب",2,0],["لَئنَّ فاتَني حَظٌ بِهِ فاتَني المُنى","فَلا بُدَّ يَوماً أَن يَعودَ مَعادُهُ",65,"د",2,0],["لَئِن فَقَدتَ أَخاكَ اليَومَ وَا أَسَفاً","فَاِخضَع إِلى الحاكم الجَبار مُبتَهِلا",66,"ل",2,0],["لي نفس قد ثناها هواهم","لا ترى الا ثناهم انيسا",67,"س",2,0],["لئن فدى اللَه اسماعيلَ من كرمٍ","بالذبح واستعظمته الإنس والجان",68,"ن",1,1],["لئن فار ق الدنيا الدّنيّة شخصه","فلم يخل من حزن على فقده صدر",69,"ر",1,0],["لئِنْ فُتِحت بك الدُّنيا","لقد فُتِحَتْ بكَ الأُخرى",70,"ا",1,0],["لئن فاتني منه الأقاحي فإنني","حصلت على وردٍ جن وريحان",71,"ن",1,0],["ليَ نفس لولا التشفي بأروا","ح صباها ذابَت بحَرّ جواها",72,"ا",3,0],["لئن فرَّقتها آلُ حربٍ فلم تكن","لتجمعَ حتَّى الحشرِ إلاَّ المخازيا",73,"ي",2,0],["لِيَ نَفسٌ تَأبى الدَنِيَّةَ وَالأَش","رافُ لا تَعتَدي عَلى الأَشرافِ",74,"ف",1,0],["لئن فعلت بالحان مثلك سوقة","فَقَد هد منك الظلم للناس أَركانا",75,"ن",2,0],["لَئِن فَقَدَ اليمنى الحصينَةَ مِن فَمي","فليسَ لمخضوبِ البنانِ يَمينُ",76,"ن",1,0],["لئن في سبيل الله جادوا بمالهم","فهم في سبيل الله بالنفس أسمح",77,"ح",1,0],["لئن فارقتكم جسماً فإني","تركت لديكمو قلبي رهينا",78,"ن",2,1],["لئن فاتني في سالف الدهر فائت","وقصّر وخدي دونه وزميلي",79,"ل",2,0],["لئن فاتنا في الدهر عين محمد","فما فاتنا فيه التذكر والود",80,"د",1,0],["لئن فشا فضله في يوم مختتم","فمن فتوح له في حلقه الكلم",81,"م",1,1],["لَئنْ فَخَرَتْ بالمكرُمات بنو مصر","فإنّكَ بينَ الناس أجدرُ بالفخر",82,"ر",1,1],["لئن فقدته عيناً فجميله","مدى الدهر باقٍ في الورى ليس يفقد",83,"د",1,0],["لي نفسٌ كالناس تعجب بالنا","س ونفسٌ تهزا بهم وبنفسي",84,"ي",1,1],["لئن فطِمَت أميمةُ عن ودادي","لما أنا عن أميمة بالفطيم",85,"م",1,0],["لئن فقدا بحر العلوم وكهفها","فشبلاهما كل بوالده اقتدى",86,"د",2,0],["لئن فتكت ألحاظه بحشاشتي","وساعدها بالهجر واعتز بالحسن",87,"ن",1,1],["لئن فارقت تلك الطلول شموسها","فقد واصل القلب العليل أوامها",88,"م",3,1],["لئن فاتني بالطف حظي ولم أقم","لديكم مقام الناصح المتناصح",89,"ح",1,0],["لئن فُتَّ وقد تَوَافَوا","إليك من السُّهولةِ والوُعور",90,"ر",1,0],["لي نفس تهوى السلام مع النا","س وتأبى ايلامهم قد حياها",91,"ا",3,0],["لئن فخرت بغداد في آل برمك","ومعروفهم في عصرها المتقادم",92,"م",1,0],["لئن فاتك الصفر بالانتقال","فلا عجب ان جهلت النضارا",93,"ر",2,0],["لئن فارقتنا بالجسم فاعلم","بأنك في القلوب أجل باقي",94,"ق",2,0],["لئن فرقتنا نبوة في حياتنا","لقد أصبحت بعد الممات تآخيا",95,"ي",2,0],["لئن فاتني منك الذي أنا رائمٌ","فأنَّ هوى نفسي عليك لدائمُ",96,"م",1,0],["لَئِنْ فارقتِ خَيْرَ عزىً لأَهْلٍ","فَخَيْرُ بني أَبيكِ بهِ نَزَلْتِ",97,"ت",1,0],["لَئِن فاتَني عَهدُ الشَبابِ وَلَهوُهُ","فَإِنّي بِعُمري لَستُ آبَهُ أَو أُعنى",98,"ا",1,0],["لَئن فاتَني حَظٌّ مِن الدَهرِ وَافرٌ","وَأَخطَأني صَوب الغَوادي السَواكبِ",99,"ب",1,0],["لئن فخروا يوماً ترى المجد والعلى","لهم والأيادي البيض بعض شهودها",100,"د",3,0],["لينفي عني الغي ما أثبت الهدى","ويصلح مني السكر ما الصحوا واقسدا",101,"د",2,0],["لَئِن فاتَهُ تأسيسُها إِنَّ هَذِهِ","خَبايا زَمانٍ وَهيَ إِحدى عَجائِبه",102,"ب",2,0],["لئن فاه تجديفاً ترى السمع صاغياً","كسامع تسبيح وما من يُحاسبُه",103,"ب",2,0],["لئن فقدْتُك في قومٍ أُصاحبهُمْ","فقد فقدْتُ منَ اللَّذاتِ أطيبَها",104,"ه",2,0],["لئن فازوا بقربكم وتاهوا","ولذ لهم بساحتكم مقيل",105,"ل",1,0],["لئن فاتني ريبُ الزمانِ بمالكٍ","وقد كملت فيه المروءة والعَقلُ",106,"ل",1,0],["لئن فلت الأيام منك فانما","يفل من الاسياف ما كان يضرب",107,"ب",1,0],["لئن فات قبل الآن عيد زفافه","ففي كل يوم عيد شكرانه عندي",108,"د",2,0],["لئن فقدوا طرا