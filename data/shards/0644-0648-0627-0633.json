ry.dctabudhabi.ae/diwan/poem/101377","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119667","الكامل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93246","الدوبيت"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83131","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83127","البسيط"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76685","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120433","المتقارب"],[4988,"أقضب لسانك","https://www.poetsgate.com/ViewPoem.aspx?id=196640",""],[5005,"على حافة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=208150",""],[5038,"تهفو القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=190148",""],[5121,"مَرْضِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=71482",""],[5139,"مليط","https://www.poetsgate.com/ViewPoem.aspx?id=68956",""],[5232,"امتثال","https://www.poetsgate.com/ViewPoem.aspx?id=213438",""],[5277,"قميصُ الوجع","https://www.poetsgate.com/ViewPoem.aspx?id=191116",""],[5353,"قيامة الوطن المدجج بالعويل","https://www.poetsgate.com/ViewPoem.aspx?id=212241",""],[5376,"قد غرَّها عِشْتُ الوجْدَ في ولهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=197709",""],[5409,"تمشي بنا القهقرى مشي الكسيح بها","https://www.poetsgate.com/ViewPoem.aspx?id=155417",""],[5582,"لَئِنْ تُخْفِ ما بِكَ أَوْ تَصْبِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=187009",""],[5606,"وأول حروف اسمي على صدرك ونبضك تكتبه","https://www.poetsgate.com/ViewPoem.aspx?id=197790",""],[5685,"في مدح الحبيب المصطفى صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=34734",""],[5771,"صَوتٌ لا يَموت","https://www.poetsgate.com/ViewPoem.aspx?id=189449",""],[5778,"الْمَالُ فِي يَدِهِ كَالْمَاءِ فِي يَدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=205155",""],[5956,"سعادة الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=192151",""],[6023,"أما وجميل الصُّنع منه وإنَّها","https://www.poetsgate.com/ViewPoem.aspx?id=123881",""],[4442,"لولاك لم يطربه عيد","https://www.poetsgate.com/ViewPoem.aspx?id=171199",""],[6093,"أهلاً وسهلاً بمَنْ للحفِل قدْ زَانَا","https://www.poetsgate.com/ViewPoem.aspx?id=206221",""],[6102,"رَسولُ الهَوى...","https://www.poetsgate.com/ViewPoem.aspx?id=182740",""],[6147,"لو.","https://www.poetsgate.com/ViewPoem.aspx?id=151497",""],[6152,"يد الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=203390",""],[6198,"الموجةُ الطروبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79239&r=&rc=13",""],[6239,"المؤتلفة/ المختلفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76056&r=&rc=107",""],[2638,"تحية العلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87847&r=&rc=11",""],[5126,"الطائف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87785&r=&rc=0",""]],"verses":[["لَو أَستَطيعُ لَما سافَتكَ سائِفَةٌ","وَلا جَناكَ فَتىً رَنداً وَلا بانا",0,"ن",2,0],["لَو أَستَطيعُ نَضَوتُ عَنّي بُردَهُ","وَرَمَيتُ شَمسَ نَهارِهِ بِكُسوفِ",1,"ف",1,0],["لَو أَسنَدَت مَيتاً إِلى نَحرِها","عاشَ وَلَم يُنقَل إِلى قابِرِ",2,"ر",1,0],["لَوِ اِستَطَعتُ إِذا ما كُنتِ غائِبَةً","غَضَضتُ طَرفي فَلَم أَنظُر إِلى أَحَدِ",3,"د",1,0],["لو أسوَدّ وجه المرء من قُبح فعله","لما كنت تَلقي بيننا غير مُدفِس",4,"س",1,0],["لو أستطعت جعلت التبغ محتكَراً","فوق أحتكار له أضعافَ مَرّات",5,"ت",1,0],["لو أسكر الإنسان باطل أمره","لم تلق غير معربِد سكران",6,"ن",1,1],["لو استعنتَ بنفسٍ غيرِ أنفُسنا","أو غيرِ نفسك قابلناك بالغضبِ",7,"ب",1,0],["لَوْ أَسَدٌ نالني بمخلَبه","ما نالني ما تراه من كمدي",8,"د",2,0],["لو أسندت ميتاً إلى نحرها","أو عودها ثاب من الضجعه",9,"ع",2,0],["لَو أَستَطيعُ وَقَيتُهُ بَطشَ الهَوى","وَلَوِ اِستَطاعَ سَلا الهَوى مَحمودا",10,"د",2,0],["لَو أَستَطيعُ سَكَبتُ رو","حي خَمرَةً في كاسِها",11,"س",3,1],["لَو أَستَطيعُ كَتَبتُ بِالنيرانِ","فَلَقَد عَيِّتُ بِكُم وَعَيَّ بَياني",12,"ن",2,1],["لَو أَستَطيعُ عَلى التَزويدِ بِالذَهَبِ","فَعَلتُ لَكِن عَداني طارِقُ النُوَبِ",13,"ب",1,1],["لو استطاع ذووها من عنايتهم","بنشرها علّموها الجن والشهبا",14,"ب",2,0],["لَوِ اِستَطَعنا لَخُضنا الجَوَّ صاعِقَةً","وَالبَرَّ نارَ وَغىً وَالبَحرَ غِسلينا",15,"ن",2,0],["لَوِ اِستَبدَلتَ ذِهنَكَ مِن حُسامٍ","قَدَدتَ بِهِ المَغافِرَ وَالدُروعا",16,"ع",2,0],["لَوِ اِستَفرَغتَ جُهدَكَ في قِتالٍ","أَتَيتَ بِهِ عَلى الدُنيا جَميعا",16,"ع",2,0],["لَوَ اِستَطَعتُ رَكِبتُ الناسَ كُلَّهُمُ","إِلى سَعيدِ اِبنِ عَبدِ اللَهِ بُعرانا",17,"ن",2,0],["لَو أَسعَدَتهُ خَيلُهُ لَتَتابَعَت","آلافُ قَتلى بَذَّةُ الأَسلابِ",18,"ب",1,0],["لَو أَسعَدَت سُعدى بِتَنويلِها","أَو يَسَّرَث عاجِلَ مَبذولِها",19,"ل",3,1],["لَوِ اِستَحدَثَت عِلماً بِذاكَ تَبَجَّسَت","يَنابيعُ مِن فَيضِ الدُموعِ الهَوامِلِ",20,"ل",1,0],["لَو أَستَطيعُ بِقَلبي عَنكَ حَملُ أَذىً","جَعَلتُهُ في لَظى حُمّاكَ يَرتَمِضُ",21,"ض",1,0],["لو أستطيعُ مسحتُ الهمَّ عن كَبِدي","ورحتُ أثأر للنفسِ التي مسحا",22,"ح",2,0],["لَو أَسخَطَتكَ حَياتي","قَتَلتُ نَفسي لِتَرضى",23,"ض",2,0],["لو أسمَعوا يَعقُوبَ ذِكْرَ مَلاحَةٍ","في وجهِهِ نَسِيَ الجَمالَ اليوسُفي",24,"ف",2,0],["لو أسعف العدل لم نحتج إلى حرس","في طلعة البدر ما يغني عن الشهب",25,"ب",1,0],["لو استطاعوا لوشوا بي إلى ال","مريخ في الشهب وكيوان",26,"ن",1,0],["لو استطاع محا أمجادنا بطرا","لم يبق لا بدرا ولا أحدا",27,"د",2,0],["لَوِ اسْتُنَّ فِي الجُودِ مَا سَنَّهُ","لَمَا كَانَ فِي بَلَدٍ مُعْدَمُ",28,"م",1,0],["لَوْ أَسرَّتْ نَفْسُ أَشْقى ظَالِمٍ","بَعْضَهَا أَخْجَلَهُ مَا قَدْ أَسَرا",29,"ر",2,0],["لُوْ أَسَأْتَ الظَّنَّ بِالنَّاسِ لَمَا","دَخَلَ اللِّصُ وَلَمْ يَحْجُبْهُ بَابْ",30,"ب",1,0],["لو أستطيعُ لبعتُ عمري كلّه","لمنى الصبا وأريجه النفّاح",31,"ح",1,0],["لَوَ استَطَعتُ رَكِبتُ الناسَ كُلَّهُمُ","إِلى سَعيدِ بنِ عَبدِ اللهِ بُعرانا",32,"ن",2,0],["لو استطعتُ نشرتُ الحزنَ والألما","على فِلسْطينَ مسودّاً لها علما",33,"م",2,1],["لو استطيع كتبت بالنّيران","فلقد عييت بكم وعيّ بياني",34,"ن",2,1],["لَو اِستَحى البَدر اِحتَجَب","لَما بَدا روحي رَجَب",35,"ب",1,1],["لَوِ اِسطَعتُ لاختَرتُ الدُنوَّ عَلى النَوى","مِنَ الصادِقِ المَصدوقِ مُرشِدِ مَن غَوى",36,"غ",3,0],["لَو اِستقرّ على عرشٍ لكان بهِ","لِلعرشِ حاجةُ محتاجٍ لمركبهِ",37,"ب",2,0],["لو أستطيعُ شربتُها كلفاً بها","وعدلتُ فيها عن كؤوس رحيق",38,"ق",1,0],["لو استطاع الكلامَ قال كذا","كان ولكن لسانه أُخرِسْ",39,"س",1,0],["لَو اِستَطَعتُ رَكِبتُ الناسَ كلَّهُمُ","إلى الحجازِ رُكوبَ الراحلِ القالي",40,"ل",2,0],["لو استطعنا وقد شابت مفارقها","صبغاً لها من سواد القلب والحدق",41,"ق",1,0],["لَو أَستَطيعُ زَورَةً زُرتُكُمُ","حَتّى أَرى ذا سِمَنٍ بَعدَ العَجَف",42,"ف",1,0],["لَو أَسفَرت يَوماً إِلى خاطبٍ","بِوصفِها قامَ عَلى المِنبرِ",43,"ر",1,0],["لو استَطَعتُم مَنعتُم ذِكرَكُم وكَذا","لو استَطَعنا امتَنَعنا منه إِكراما",44,"م",2,0],["لو استَطاعَ الليلُ مع طوله","وهَولِه كرَّ على الفَجرِ",45,"ر",1,0],["لو أسهبوا في وصف مريم مدحهم","بفصاحةٍ وبلاغةٍ لم تكذبِ",46,"ب",1,0],["لو استطاعتْ نجومُ الليلِ لا نسكَبتْ","عِطْراً على ثوبهِ الفضفاضِ رقْراقا",47,"ق",2,0],["لو استطاع شُعاع الشَّمس،صار لِم","يَخُطُّ من قِصص الأبطال أوراقا",47,"ق",2,0],["لو استعار من جميع البلغا","واستخدم الصاحب ثم النبغا",48,"غ",2,0],["لَوِ استَعارَ الوَرى إكسيرَ سيرَتِهِ","لَكانَ أجودَهُمْ في سِيرَةِ المَلَكِ",49,"ك",1,0],["لوِ استَطَعْتُ ركِبْتُ الرِّيحِ نحوَهُمُ","لأنَّ بُعْدِيَ عَنهُمْ قد جنى حَْيني",50,"ن",2,0],["لَوِ استطعتُ ولو مُلِّكْتُ أمرِيَ في","قضاءِ فرضِكَ عما فَاتَ من خِدَمِي",51,"م",2,1],["لو أسمع الحجَر الأصمَّ بوعظه","لتفجَّرت صماؤه بالماء",52,"ا",2,0],["لو استعرْتَ فؤاداً واستعنْتَ به","ما كان يُمكنُني في الحبّ سُلْوانُ",53,"ن",1,0],["لو أستطيع خَنقتها بانأملي","فعلى يَدِى سكبت عزيزَ دِمائي",54,"ي",1,0],["لو أسأروا من جسدي بقيّةً","بذكرِ آثارهمُ تُنهِضُني",55,"ن",2,0],["لو أسخطتك يدُه وحوشيتْ","أرضاك أو زادك وجهاً وفما",56,"م",2,0],["لو اسطاع سامعُ أبياتها","إذا قام راوٍ بها منشِدا",57,"د",2,0],["لو استَطاعُوا أضاءُوا مِن مَحاجِرِهِم","على طريقِكَ في تِلكَ الدُّجى شُهُبا",58,"ب",2,0],["لو استشهدت أبياتي اللواتي","جمعت بها قريضك في كتاب",59,"ب",1,0],["لو استرجعتها عميت عيون","إلى ديوان شعرك في القصيد",60,"د",1,0],["لَوِ استَطعتُ لَسَعيتُ إثرَهُم","ولَو سَعيتُ إِثرَهم عن حَدَقِي",61,"ق",2,0],["لو استعطفت ذات الستور به بدت","لنا بين ثوبَيْ هيبةٍ وجمال",62,"ل",1,0],["لو أَسعدَ الدَّهرُ بما أَرْتَجي","من قُربِه كُنْتُ كَنَعْتي السَّعِيدْ",63,"د",1,0],["لو أستطيعُ فَرَشْتُ كلَّ مَسَالِكِي","حَدَقاً وَبِيْضَ سَوَالِفٍ وَنُحُورَا",64,"ر",2,0],["لَو أُسعِد الإسعادُ دونَك مِن فَتى","فَلَكم بمثلِكَ يسعدُ الإِسعادُ",65,"د",1,0],["لَو اِستَقَمتَ كُنتُ أَستقيمُ","وَأَلف حجةٍ لَكُم أُقيمُ",66,"م",1,0],["لو استوى الأشل في صهوته","لأطمعته في تناول السها",67,"ا",1,0],["لو استطاع مَسيراً نحو داركُم","لم يثنه خوفُ أسياف ولا بيد",68,"د",1,0],["لو أستطيعُ جعلتُ منّي عامرا","بين الضلوع وكل حي فإن",69,"ن",1,0],["لو استطعت ركبت الريح عاصفة","حتى أزور سريعاً سيد الخلفا",70,"ف",2,0],["لو أسيت بالشهر المحرم أحمداً","فإن ابنه بالبارقات توزعا",71,"ع",2,0],["لو استعدى الشباب على مشيب","لدى الشيخ الجليل أثار ثاره",72,"ر",2,0],["لو أستطيعُ إذاً نظم","تُ من النجومِ ثناءها",73,"ا",3,0],["لو استطاعت لهبت من مدافنها","تسعى الزرافات فيه والمواحيد",74,"د",1,0],["لو استسقى الغليل به لروى","أو استشفى العليل به لأبرا",75,"ر",2,0],["لو استطعنا قطعنا حبل فرقتكم","وما سلكنا يد الإبعاد بالجدد",76,"د",1,1],["لو استفقتم لكنتم خير مستبق","إلى المفاخر تزجون الجلاميدا",77,"د",2,0],["لو أستطيع وهبتك الفهما","وبنيت في جثمانك العظما",78,"م",2,1],["لَو اِستَطَعنا لَشاطَرناكَ مُدَّتَنا","وَكانَ بَيعاً بِهِ رِبحٌ وَمُتَّجَرُ",79,"ر",1,0],["لَو اِستَطاعَت لَقاسَمَتهُ","أَعمارَها قِسمَةَ السِهامِ",80,"م",1,0],["لو أسنَدوا شأنَ العقائدِ لمن","حرّر للسّلف رأياً ونَجا",81,"ا",1,0],["لَو اِستَعارَ الرَدى قَلب اِبن مشبلة","وَرامَ يقرب مِنهُ عُنوةً جبنا",82,"ن",2,0],["لو أسفرت لجرير عن محاسنها","لانجر من خلفها بالذل والأدب",83,"ب",1,0],["لو استطعت تركت الخيل حافية","سرىً لهم وتركت الليل زيَّافا",84,"ف",2,0],["لَوِ استَطَعنا لأرضَينا مُغِيرَتَهُ","لنَفتَدِي عُمَراً نفدِي بِهِ البَشَرَا",85,"ر",2,0],["لو أستطيع نقلتكم","أبداً لخلدي الدائم",86,"م",1,0],["لو أستطيع لطرت مثلك في الفضا","لكن أجنحتي خلقن قصارا",87,"ر",2,0],["لو أستطيع حكمت","المرآة بالتحطيم",88,"م",1,0],["لو أستطيع البكا يا أيها الطلل","بكيت حتى شكت من دمعي المقل",89,"ل",1,1],["لو استطاعوا مثله ما حاربوا","وهو لهم ايسر من كرّ وفر",90,"ر",1,0],["لو استعار نداك الغيث في كرم","عم الرواء وفاض الجود والرفد",91,"د",1,0],["لو استطاعوا لساقونا أمامهمُ","ما بين م