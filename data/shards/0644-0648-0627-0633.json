َبكتُ مَنديلا ً وشالْ",117,"ل",1,0],["لواسِعُ الخوف أنيابٌ تمزّقُنا","لمْ تجدِها رقيةٌ... عرفٌ... ولا مثلُ",118,"ل",1,0],["لو اسقطت رايتي لا قدر الله من","يذود عنكم غداة الظلم إن نزلا",119,"ل",2,0],["لو أسعَدَتْني بالوصلِ طرْت بها","كطائرٍ لا يمشي على رجْلِ",120,"ل",1,0],["لو استطاعوا وهم ملأى بطونهم","لم يتركوا لسواهم فضلة الكاس",121,"س",1,0],["لَوْ اسْتُبْصِرَ الحَقُّ مِنْ بَيْنِهِمْ","عَلَى سَوْرَةِ الجَهْلِ لَمْ يُبْصَرِ",122,"ر",1,0],["لوأستطيع أخفيه ماغيري بشر ينظرإليه","وأول حروف إسمي على صدرك ونبضك تكتبه",123,"ب",2,0],["لو أستطيعُ جعلتُ شعري كلَّه","وَلِهاً بحبك مُرتقىً لسماكا",124,"ك",2,0],["لو أسكتوا قَسرًا حناجرنَا","لنْ تَسكُتَ الأحيَاءُ والطُّرُقُ",125,"ق",1,0],["لَو اسْتَعَارَ خَنُوعاً مِنْهُ بِزَّتَهُ","دَانَتْ لِحَضْرَتِه الْأَعْدَاءُ مِنْ وَهَنِ",126,"ن",1,0],["لو أستطيع غياث أي صريخة","لأغثتها وطعنتُ كل جبانِ",127,"ن",1,0],["لو أستطيع شفاء نظرة رحمةٍ","لرحمتها وفديتها بكياني",127,"ن",2,0],["لو اسطعت حوَّلت البرية ألسناً","وكنت بها أُثني عليه أشكر",128,"ر",1,0],["لو استطيع قطعتها","لكن أعضائي تحيد",129,"د",1,0],["لَوِ استطعنا فرشْنَا الأرضَ تحتَكُمُ","وردًا وفلَّاً ونِسريناً وريْحَانَا",130,"ن",2,0],["لَوِ استَمَعتِ إِلَى هَمساتِ قَلبِيَ ما","تَرَكتِنِي وَجَناحُ العِشقِ مَكسُورُ",131,"ر",1,0],["لو أُسْقِطت كفّاك في شبَك الهوى","مَن للبنفسج كي ينيم أصابعك؟",132,"ك",1,0],["لو استطعت لجئت الآن عندكم","ولا تجرعت كأس البعد غِسلينا",133,"ن",2,0],["لو أستطيع أَسَوْتُ جرحَكِ... إنّما","أنا منكِ أحوجُ للأَسَا.. وطبيب",134,"ب",1,0],["لو أستطيع لأكملْتُ الزَّمان لها","باباً من العطرِ نحو الله ينعطفُ",135,"ف",1,0],["لو أستطاعت بقاء كان يمسكها","ما دبروه بما ساسوا وما حكموا",136,"م",3,0],["لو أسبل السّتر الوجيح أزاله","هل كان يغني الستر أو إسباله",137,"ل",2,0]]}