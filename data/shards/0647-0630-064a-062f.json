{"poems":[[88,"حياكم الله أحيوا العلم والأدبا","https://www.aldiwan.net/poem10917.html","البسيط"],[47,"كفي الملامة أو دومي على العذل","https://www.aldiwan.net/poem65639.html","البسيط"],[101,"القصيدة الدمشقية","https://www.aldiwan.net/poem6529.html","عموديه"],[99,"اليوم يومك في الشباب فناد","https://www.aldiwan.net/poem24755.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[96,"فترقبوا الغارات من أيتامها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67400&r=&rc=87",""],[303,"عاطيتني السحر أم صرفا من الراح؟","https://www.aldiwan.net/poem36844.html","عموديه"],[333,"دنياي يا دنياي","https://www.aldiwan.net/poem55040.html","مجزوء الرجز"],[382,"بئس الزمان المرتدي بشرار","https://www.aldiwan.net/poem59431.html","الكامل"],[408,"وا طول حزني في غد وتحسري","https://www.aldiwan.net/poem47004.html","الطويل"],[415,"هذي ديار بني أبي ومعاشري","https://www.aldiwan.net/poem31652.html","عموديه"],[415,"هذي ديارهم عفت وتفرقوا","https://www.aldiwan.net/poem31674.html","عموديه"],[447,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[458,"لا ترقبوا مني الدموع رخيصة","https://www.aldiwan.net/poem61319.html","الكامل"],[484,"يهتز صوتهما الرنين","https://www.aldiwan.net/poem37615.html","مجزوء الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61031","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126149","الكامل"],[1631,"","https://poetry.dctabudhabi.ae/diwan/poem/142174","البسيط"],[1877,"","https://poetry.dctabudhabi.ae/diwan/poem/115284","الكامل"],[2226,"","https://poetry.dctabudhabi.ae/diwan/poem/200278","الكامل"],[2234,"","https://poetry.dctabudhabi.ae/diwan/poem/111082","البسيط"],[2683,"","https://poetry.dctabudhabi.ae/diwan/poem/132505","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93873","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109842","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204574","الكامل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79709","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91512","الكامل"],[3708,"","https://poetry.dctabudhabi.ae/diwan/poem/123840","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216802",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131208",""],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117226","الكامل"],[4717,"زفاف","https://www.poetsgate.com/ViewPoem.aspx?id=199715",""],[4814,"قبضة السامري","https://www.poetsgate.com/ViewPoem.aspx?id=194785",""],[4818,"إعثار","https://www.poetsgate.com/ViewPoem.aspx?id=204635",""],[4888,"مدرسة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=207751",""],[4955,"مهما ابتسمتُ فدمع العين يفضحني","https://www.poetsgate.com/ViewPoem.aspx?id=188781",""],[557,"مرثية حلم","https://www.poetsgate.com/ViewPoem.aspx?id=13825",""],[4961,"خمس دقائق قبل وصول العاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=33331",""],[5038,"تبا لكم","https://www.poetsgate.com/ViewPoem.aspx?id=189960",""],[5052,"أتلفتُ حَوبائي","https://www.poetsgate.com/ViewPoem.aspx?id=205347",""],[5092,"خذني لغزة","https://www.poetsgate.com/ViewPoem.aspx?id=175328",""],[5096,"عَثَراتُ الصَّبْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=206637",""],[5277,"وااهٍ على الشام","https://www.poetsgate.com/ViewPoem.aspx?id=197630",""],[5277,"وقفةٌ على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=200038",""],[5280,"شآم","https://www.poetsgate.com/ViewPoem.aspx?id=187771",""],[5295,"جَبَّارَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=177365",""],[5320,"حى راق","https://www.poetsgate.com/ViewPoem.aspx?id=43263",""],[5365,"تراتيل في محراب الألم","https://www.poetsgate.com/ViewPoem.aspx?id=191272",""],[5376,"للقدس آهٍ ولبغدادَ آهات","https://www.poetsgate.com/ViewPoem.aspx?id=188467",""],[5431,"ماروته شهرذاد...","https://www.poetsgate.com/ViewPoem.aspx?id=202447",""],[5443,"دموع اليراع في ليل الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=185143",""],[5455,"سحابه","https://www.poetsgate.com/ViewPoem.aspx?id=34425",""],[470,"والآن ها قد قطعنا الشوط يا وطني","https://www.poetsgate.com/ViewPoem.aspx?id=178097",""],[5690,"هذي ديار غرور لا قرار لها","https://www.poetsgate.com/ViewPoem.aspx?id=172263",""],[5691,"حواء","https://www.poetsgate.com/ViewPoem.aspx?id=205898",""],[5704,"شوقي الى المختار","https://www.poetsgate.com/ViewPoem.aspx?id=194470",""],[5725,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=186576",""],[5758,"العاتِرِيّة","https://www.poetsgate.com/ViewPoem.aspx?id=200505",""],[5829,"انت الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=150260",""],[5829,"حتى متى تتساقط الاوراق","https://www.poetsgate.com/ViewPoem.aspx?id=156130",""],[5829,"هذي دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=214085",""],[5912,"شام الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=205018",""],[5956,"ديمقراطية الدمويِّين","https://www.poetsgate.com/ViewPoem.aspx?id=192364",""],[6127,"وطن الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=189444",""],[6242,"دمشق يا وردة تاهَ النّسيم بها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87573&r=&rc=20",""],[6242,"على شاطئ التِّمثال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87563&r=&rc=10",""],[6300,"الفارس المتجمّد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82872&r=&rc=43",""]],"verses":[["هَذي دُموعي عَلى الخَدَّينِ جارِيَةٍ","حُزناً وَهَذا فُؤادي يَرتَعي لَهَبا",0,"ب",2,0],["هَذي دِيارُهُمُ تُنبيكِ أَنَّهُمُ","أَيدي سَبا بَينَ مُحتَلٍّ وَمُرتَحِلِ",1,"ل",1,0],["هذي دمشق.. وهذي الكأس والراح","إني أحب... وبعض الحب ذباح",2,"ح",1,1],["هذي دياركم وذلك نيلكم","هبة السماء ومنحة الآبادِ",3,"د",1,0],["هذي دياركم وهذي شمسكم","طمع الغريب وحرقة الحسادِ",3,"د",1,0],["هَذِي دِيَارُكُمْ الَّتِي كَانَتْ حِمىً","لِلأَنْبِياءٍ وَجَنَّةَ المِيعَادِ",4,"د",1,0],["هذي دماء كرامها مطلولة","فاقبل ضحيّتها دماء كرامها",5,"م",3,0],["هذي (دمشق) بما فيها هديَّتُهُ","أكرمْ بها منحةً أكرم بمنّاح",6,"ح",1,0],["هذي دموع أساي","تخذتها سلواي",7,"ي",1,0],["هذي دمشق ونارها لي جنةٌ","بعداً لها من جنةٍ في نار",8,"ر",1,0],["هذي ديارهُم بَلاَقع بعدَهُمْ","فَسَلِي البَلاقعَ عَنْهمُ واسْتخبري",9,"ر",2,0],["هذي ديار بني أبي ومعاشري","قفر عليها وحشة وظلام",10,"م",1,1],["هذي ديارهم عفت وتفرقوا","فسل المنازل عنهم ماذا لقوا",11,"ق",3,1],["هذي ديارهم وذي أطلالها","درست فأين تأهلت أهالها",12,"ل",3,1],["هذي دموعي لا ميوعة عاجز","غرّ ولا بالك بكاء خليع",13,"ع",1,0],["هذي دروس قد روي","ناها عن المتمدنين",14,"ن",1,0],["هَذي دِيار العِدى يباب","تَعوي بِأَرجائها الذِئاب",15,"ب",1,1],["هذي دفاترهم فهل","فيها لك إسم يكتب",16,"ب",1,0],["هذي دماؤك ما تنفك دافقة","تجري بها حمى الوادي الاخاريد",17,"د",1,0],["هذي دمشق وساعة من يومها","في فضل لذّتها تقوم بأشهر",18,"ر",1,1],["هذي ديار العامرية نخ بها","فيها لزائر ربعها حسْنُ القِرى",19,"ر",2,0],["هذي ديار الهدى قد أصبحت هملا","حتى بها علقت اطماع كل شقي",20,"ق",2,0],["هذي دمشق الشام دارُ اللهو","فاسند حديثي عن رباها واروِ",21,"و",1,0],["هذي دروس العلم بعد دروسها","قامت تداعي بعضها وتحاكم",22,"م",1,0],["هذي دلالة ظلم بانيها وذي","قامت على عدل البناء دليلا",23,"ل",2,0],["هذّي ديونك لم يسدّد بعضها","عجزا فكيف تسدّد الأرباح",24,"ح",1,0],["هذي دمائي لأجل النيل أبذلها","ولست أخشى على شعبي من الضجر",25,"ر",1,0],["هذي ديارُهمُ فقف واستوقِفِ","واحزَن على آثارهم وَتأسَّفِ",26,"ف",1,1],["هذي دموعي بوجدي فيك شاهدة","ينبيك بالشأن ما يجري به الشان",27,"ن",1,0],["هذي ديار وتلك أخرى","هيهات من كردفانَ مصر",28,"ر",1,0],["هذي دماءُ بنيكم مسفوكةً","أفليس يجري في عروقكم دم",29,"م",1,0],["هذى دموعي حسرة تهمى على","ما فاتني من نيل قرب رضاكا",30,"ك",2,0],["هذي دليلُ رضا أهلٍ دعَوْا سلفاً","إذِ استجابَ دعاءَ الأهلِ باريها",31,"ي",3,0],["هذيْ دماءٌ جُرحُها غائرٌ","ينسابُ في شطآنها خاطريْ",32,"ر",2,0],["هذي دموعي من رعاف دمي","ظمآن أبكي صحبةً نفروا",33,"ر",3,0],["هذي دماؤكِ لن تضيعَ سدىً ولن","يسعى بها نحو الوقيعةِ أشدقُ",34,"ق",1,0],["هذي دموعي لنيلِ العفوِ نازلةٌ","والضعفُ من شيمي بادٍ بتكويني",35,"ن",2,0],["هذي دمانا رسول الله تغرقنا","هل من زمان بنور العدل يحمينا",36,"ن",2,0],["هذي دقائقُنا التي لم تنهزمْ","وظهورُها قد مزَّقتْهُ خناجرُ",37,"ر",1,0],["هذي دِمَشْقٌ هَوى صَنْعاءَ أثْمَلَها","إذا شَكا بَرَدى تَبْكي لَهُ عَدَنُ",38,"ن",1,0],["هذي دموعيَ تروي في محبّتكمْ","آلامَ روحي وأحزاني ولأْوائي",39,"ا",3,0],["هذي دموعُ الفرحِ فيَّ سوانحٌ","لمّا رأيتُ النصر والتنزيلا",40,"ل",2,0],["هِذِي دُرُوسٌ لوْ عَرَفْنَا كُنْهَهَا","لنَفيْتُ قوْلَ مَتَى تَصِيرُ مُوَاتيهْ",41,"ي",2,0],["هذي دمشقُ وفوقها نارُ الردى","وعلى رباها سيلُ حقدٍ مالا",42,"ل",2,0],["هذي دياري كلُّ دارٍ ملؤُهُ","ربعٌ وذا ريحُ الضياعِ محاهُ",43,"ا",2,0],["هذي دمشقُ لأرضِ العُربِ عاصمةٌ","قد صَانَها ربُنا زادَ البها ألَقا",44,"ق",2,0],["هذي دُموعِي بالحنينِ مذابةٌ","كالنَّهرِ فاضَ بِعِشْقِهِ يَرويكِ",45,"ك",1,0],["هذى دروبك مقفرات يالها","كالسجن فى عيون الرائى",46,"ا",2,0],["هذي دواتي وقد فاضتْ بما وُهِبَتْ","أكرِم بفِكرٍ به قامت شراعاتي",47,"ت",2,0],["هذي ديارُ الأنبياءِ بها","سنتْ على أنوارِ مصْطحبِ",48,"ب",1,0],["هذي ديارٌ للسلام ِعلتْ","بها تعاليم من الكتبِ",48,"ب",1,0],["هذي ديوكك في صياحْ","سأكفُ عن بوحٍ متاح",49,"ح",1,0],["هذي دُموعُ يراعي سطَّرَتْ أَلَمًا","كما بكاكِ سأبكي ريثما تصِلُوا",50,"ل",3,0],["هذي دفا صوتٍ من البرد مخنوق","هذي سؤالٍ نصف عمري جوابه",51,"ب",2,0],["هذي دموعُ الرِّضا والحبِّ يا وطني","عيونُها دائماً كانت قناديلَكْ",52,"ك",1,0],["هذي ديار غرور لا قرار لها","أن أضحكت ساعةً أبكتك تسعاً",53,"ع",2,1],["هذي دُعاباتٌ بلا إحْراجِ","منّي إلى الزَّوْجاتِ والأزواجِ !",54,"ج",1,1],["هذي دموعي قد همت تجري كما","فيض تهاطل ساجماً ومُجَمَّمَا",55,"م",2,0],["هذي دميعاتي شجون رسائلي","هل ترتضيها والسلام ختامُ",56,"م",1,0],["هَذِي دِيَارُ حَبِيبَتِي وَيَرُوقُ لِي","وَجَعٌ (عُبَيْدِيُّ ) الهَوَى وَمَنَازِلُ",57,"ل",1,0],["هذي دمشق تفتحت أبوابها","تلقى أحبتها على استحياء",58,"ا",2,0],["هذي دماء الأبرياء تراق","والسيل يجري والردى خفاق",59,"ق",1,1],["هذي دمشق جمالها وبهاؤها","وربيعها يسبي الفؤاد رُواؤها",60,"ا",3,1],["هذي دمشقُ المعالي؛ علَّمت أممًا","لها بكلِّ دِيارِ الأرضِ أَوْقافُ",61,"ف",1,0],["هذي ديمقراطيةٌ دمويةٌ","وحقارةٌ محقتْ حضارات البشرْ",62,"ر",1,0],["هذي ديمقراطية تدعو إلى","خنقِ العدالةِ والضلالِ عن الوطَرْ",62,"ر",1,0],["هذي ديارك جردا لا أنيس بها","أضحت مقابر ما فيها سوى الحُزُنِ",63,"ن",1,0],["هذي دمشق تواسي اليوم مسجدنا","صاحت تردد أين اليوم معتصمي !",64,"م",2,0],["هذي دموع الوفاء البين زلزلها","وذاك نبع من الأحزان يسقيني",65,"ن",2,0],["هذي دموعي تنادي في انتفاضتها","ونبرة ُالآه بالآهات تتصلُ",66,"ل",1,0]]}