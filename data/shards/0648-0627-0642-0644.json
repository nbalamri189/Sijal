111963",""],[5848,"اسبوع","https://www.poetsgate.com/ViewPoem.aspx?id=50533",""],[5880,"عقلي","https://www.poetsgate.com/ViewPoem.aspx?id=210779",""],[5939,"مشاغبة","https://www.poetsgate.com/ViewPoem.aspx?id=180018",""],[5948,"تَصَرَّمتِ الدنيا فليسَ خلودُ","https://www.poetsgate.com/ViewPoem.aspx?id=100588",""],[5956,"إلى كذوب ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182541",""],[5956,"نحن بالغيريين أقلُّ اهتماماً","https://www.poetsgate.com/ViewPoem.aspx?id=183330",""],[5956,"يتسلل النور الجميل لمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=194211",""],[5956,"لماذا سُمِّي الصِّهرُ صهرا؟","https://www.poetsgate.com/ViewPoem.aspx?id=204009",""],[5998,"نمت دموعي على سرى وكتماني","https://www.poetsgate.com/ViewPoem.aspx?id=190054",""],[6102,"مُراوَحَةٌ بِانتِظارِ المَوتِ...","https://www.poetsgate.com/ViewPoem.aspx?id=186294",""],[6112,"أخذنا بآفاق السماء فلم ندع","https://www.poetsgate.com/ViewPoem.aspx?id=186535",""],[6225,"عَولَمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80968&r=&rc=237",""],[4222,"لا تنكرن لسابح عثرت به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52774&r=&rc=66",""]],"verses":[["وَأَقلَعَ إِقلاعَ الظَلامِ وَقَد وَزى","قِلالَ الرَوابي وَالرَكِيَّ المُغَوِّرا",0,"ر",2,0],["وأقلُّ ما جَنَتِ الصّبابَةُ وَقْفَةٌ","مَلَكَتْ قِيادَ الدَّمعِ بالخَلْصاءِ",1,"ا",2,0],["وَأَقلَقَني فِراقُكِ إِذ دَعاني","لِحَيني بَغتَةً فَمَتى التَلاقي",2,"ق",2,0],["وَأَقلامُهُ وَفقُ أَسيافِهِ","يَظَلُّ الصَريرُ يُباري الصَليلا",3,"ل",2,0],["وأَقلق خفّاق الجوانح نسمة","تَنِمُّ مع الإصباح خافقة البردِ",4,"د",1,0],["وأقلع من سفن الخيال مراسياً","فنجري من الظلماء في لجج خضر",5,"ر",1,0],["وأقلام عدلٍ في بحورِ أناملٍ","لهم بينَ أمواجِ الدروعِ عباب",6,"ب",1,0],["وأقلام رشدٍ يتبع الرشد خطّها","ويعمل أنواع الثناء برسمها",7,"م",3,0],["وأَقلقَ مضجعَ الحسناء سُخطي","فأرضَتني على رَغمِ الغِضاب",8,"ب",1,0],["وأقلُّ حقّك أن تُرى متجاوزاً","عن شاعرٍ في القولِ منه تهلهُلُ",9,"ل",1,0],["وأقلامُهم عند أملاكنا","أسنةُ أرماح فرسانها",10,"ن",3,0],["وَأَقَلُّها خَطباً فَكيفَ أَشَدُّها","لَو نالَتِ الجَبَلَ الأَشَمَّ أَنهارا",11,"ر",2,0],["وَأَقَلَّ مِنها البَحرُ حينَ أَقَلَّها","دُنيا مِنَ الأَضواءِ وَالأَنغامِ",12,"م",1,0],["وَأَقلَعَ ذَلِكَ الغَيثُ المُرَجّى","فَلا الوَسميُّ مِنهُ وَلا الوَلِيُّ",13,"ي",1,0],["وَأَقلَعَت في الحالِ لِلخَلاصِ","فَسَلِمَت مِن طائِرِ الرَصاصِ",14,"ص",1,0],["وَأَقَلُّ ما بَيني وَبَينَكَ أَنَّنا","نَرمي القَبائِلَ عَن قَبيلٍ واحِدِ",15,"د",1,0],["وَأَقَلُّ ما أَعتَدُّ مِنكَ وَأَرتَجي","مِن حُسنِ رَأيِكَ فِيَّ نُجحُكَ مَوعِدي",16,"د",2,0],["وَأَقلامُ كُتّابٍ إِذا ما نَصَصتَها","إِلى نَسَبٍ كانَت رِماحَ فَوارِسِ",17,"س",1,0],["وَاِقلِ الكَذوبَ وَقُربَهُ وَجِوارَهُ","إِنَّ الكَذوبَ مُلَطِّخٌ مَن يَصحَبُ",18,"ب",1,0],["وَأَقَلُّ القَليلِ يُغني وَيَكفي","لَيسَ يُغني وَلَيسَ يَكفي الكَثيرُ",19,"ر",1,0],["وأَقَلُّ ما يبقى الجدارُ إذا","ما انهدّ تحتَ بنائه الأسُّ",20,"س",1,0],["وَأَقلِل إِنَّ كَيدَكَ حينَ تَصلى","بِنيراني أَقَلُّ مِنَ القَليلِ",21,"ل",1,0],["وَأَقَلُّ الأَشياءِ مَحصولَ نَفعٍ","صِحَّةُ القَولِ وَالفَعالُ مَريضُ",22,"ض",1,0],["وَأَقْلاَمُ الجَماعَةِ جائِلاتٌ","كأسْيَافٍ بأَيْدِي لاعِبِينا",23,"ن",2,0],["وأقلُّ منه ما يُضرِّمُ لوعتي","ويحولُ بين الصَّبرِ والمجلود",24,"د",1,0],["وَأَقِلَّ اللَجاجَ وَاِصبِر عَلى الجَه","دِ فَإِنَّ الهَوى نَعيمٌ وَبوسُ",25,"س",1,0],["وَأَقَلُّ أَهلِ الأَرضِ حَظّاً في العُلا","مَن يَكتَفي مِنها بِخُطبَةِ قائِلِ",26,"ل",1,0],["وَأَقَلُّ عِبئاً مِن جُلوسِ مُمَدَّحٍ","لِلوَفدِ يَقصُدُ أَن يَروحَ مُؤَبِّنا",27,"ن",2,0],["وأقلتنيَ أَرضٌ","وأظلتني سماءُ",28,"ا",2,0],["وَأَقِلْنِي وَأَعِنِّي","أَنْتَ لِي خَيْرُ شَفِيعِ",29,"ي",2,0],["وَأَقَلُّ الذِي نُحَمَّلُ مُوهٍ","لِصِلابِ الْقُوَى وَبِالصَّبْرِ مُودِ",30,"د",1,0],["وَأَقِلَّ المَكثَ في الدارِفَمَن","أَمِنَ التَثقيلَ بِالمَكثِ ثَقُل",31,"ل",1,0],["وأقلام كتابٍ يُريد انتقاصَها","من النَّفَرِ المأجورِ للسبّ مِغْزَل",32,"ل",1,0],["وَأَقل عَبد مِن شراءٍ هباتِهِ","مَأوى الطَريد وَمَقعد لِلسالك",33,"ك",1,0],["وأقلب غواية قلبي للهداية بال","لطف الخفي وتمم نور عرفاني",34,"ن",2,0],["وأقلامي ويَسألُ كُلُّ حَرْفٍ","أُسَطِّرُهُ وآلامي العَديدةْ",35,"د",2,0],["وَأقلعَ بِإمتِحَاني عَنهُ إني","رِضَا مَن كَانَ يَلحَاني امتِحَاني",36,"ن",2,0],["وَأَقِلني إِذا عَجَزتُ وَإِن كا","نَ عِثارُ المَقالِ غَيرَ مُقالِ",37,"ل",1,0],["وأقل عثارى بالنبي محمد","واستر ووفقني لنور السنة",38,"ه",1,0],["وَأَقلَعَ عَن إِفسادِهِ كُلُّ مُفسِدٍ","وَفي كُلِّ مَنحىً لِلصَلاحِ وَمَقصِدٍ ثأى",39,"ا",2,0],["وأقل جدواك الأماني كلها","وأقل أمنية هي الاكثار",40,"ر",1,0],["وأقل ما يجزيكم في مثله","إن لم يطعكم أن يهان ويزدري",41,"ر",2,0],["وأقلَّ ما تأتي إذا","حضرتْ بعصيانٍ أطايب",42,"ب",1,0],["وأقلقه ارتعاد يوم قرّ","فزاد الله رعدته ارتعادا",43,"د",2,0],["وأقلُ الغرامِ عندي أني","بينَ قومي على الغرامِ دليلُ",44,"ل",1,0],["واقلامه السمر الرشاق كأنها","رياض والحاظ الظباء المحابر",45,"ر",1,0],["وأقلامك الغراء تهتز للندى","وفي فعلها يوم الوغى تعجزُ السُمر",46,"ر",1,0],["وأقلامُه غِربانُ بَيْنٍ تصيحُ في","خزائنِهِ لم يَبْقَ فيها له وَفْرُ",47,"ر",1,0],["واقلبه واواً حيث لم يحركا","بالكسر واحذف همز ما كأفرك",48,"ك",1,0],["واقلبه ياء ذات فتح مفردا","بكل جمع كالمطايا وجد",48,"د",1,0],["وَأَقَلتَ عثرَةَ قريَةٍ حكمَ الهوى","في أَهلِها وَقَضى قضاءٌ أَخرَق",49,"ق",1,0],["وأقلُّ ما أَدْرِيه مِنْ زَمَني","رفعُ الجَهول وسَقْطةُ الفَهِمِ",50,"م",1,0],["وَأَقَلُّ ما أَلقاهُ إِنَّكَ مُنكِرٌ","وَجدي عَلَيكَ وَأَنتَ مِنّي أَعرِفُ",51,"ف",1,0],["وَأَقَلَّت غَوارِبُ ال","ماءِ في دِجلَةَ السُفُن",52,"ن",1,0],["وَإِقْلاَقٍ لإِخْفًاق","وَإِنْتَاجِ لِإِرْتَاجِ",53,"ج",1,0],["وأقلّ الجدا كنوزُ علومٍ","فُتِحت من خزائن الإلهام",54,"م",1,0],["وأقلني سَيدي من عثرتي","واكتسابى الذنب من خمسين عاما",55,"م",2,0],["وأَقِلني عَثَراتٍ لم أَزَل","ساعياً في كسبِها خَمسينَ عاما",56,"م",2,0],["وَاِقلَع أَزارَكَ يا نَديمَ وَغَنِّني","وَاِخلَع عِذارَكَ في مَدى الأَهواءِ",57,"ا",2,0],["وَأَقلَقَهُ هَمٌّ دَخيلٌ يَنوبُهُ","وَهاجِرَةٌ جَرَّت عَلَيهِ صَدومُ",58,"م",1,0],["وَأَقلام العصيِّ لَها صَرير","بطرس أَديمه فَوقَ السُطورِ",59,"ر",1,0],["وأقِلاّ لَوْمي فإنّي أَرَى الدُّنْ","يا بإنسانِ ذلكَ الإنسان",60,"ن",1,0],["وأقلامٌ تَفوتُ شَبا العوالي","بطَوْلٍ في المَواقف لا بِطُول",61,"ل",1,0],["وأقَلُّ فِكْرِك في أجلِّ أُمورِنا","كافٍ ولكنْ هل لنا ذاك الأقَلّ",62,"ل",1,0],["وأقَلُّ حَقّي إن طَرقْتُ فِناءكم","وأنخْتُ أنضائي إليه طِلاحا",63,"ح",2,0],["وَأَقلى البَذلَ في تَرَفٍ أَراهُ","وَأَهوى المَنعَ في مَلَقٍ عَطاءَ",64,"ا",2,0],["وَأَقَلُّ ما يُنمَى لَهُ","عَنّي التَحِيّاتُ النَوامي",65,"م",2,0],["وأَقلَّ عودَ صليبِه في كِتْفِه","للصلب طوعاً لا يقول لماذا",66,"ذ",2,0],["وأقل العيب فيها أنها","دار موت وانتقال وزوال",67,"ل",1,0],["وأَقَلُّ قَرنٍ حزتَهُ","كَمنارَةِ الاِسكِندريَّه",68,"ه",1,0],["وأقلُّ ما لا قيتُ بَعْ","دَكَ من تَبارِيح البِعادِ",69,"د",1,0],["وأقْلَعْت عن دارٍ جدير بأنَّها","تشينُ أباة الضَّيْم فيها وإنْ تزري",70,"ر",2,0],["وأقلها نعلان من نار بها","يغلي الدماغ قريبةً أميالها",71,"ل",3,0],["وأقلهم يعطى بها ملكاً مسي","ر الأرض لا يخشى إذاً إقلالها",71,"ل",3,0],["وأقلْنا لدى مدبِّ ظلالٍ","أسْبَلَتْها شجراؤُها في ذَرَاها",72,"ه",2,1],["وأقلع الدهرُ عمّا كان يثلِمُهُ","من عرشها بعد تصميم وإصرار",73,"ر",1,0],["وأقلُّ الناس ذَنْباً","قادرٌ عُدَّتْ ذنوبُهْ",74,"ب",2,0],["وَاِقلِلِ العَتبَ حينَ يُكثِرُهُ","فَكَثرَةُ العَتبِ تورِثُ المَللا",75,"ل",2,0],["وأقلقُ مِن تَذكارِ عيشٍ أَلِفْتُهُ","سجيةَ مَنْ لم يدرِ كيف يخونُ",76,"ن",1,0],["واقلب لأمثاله ظهر المجن فلا","يجدي النزاع عدى الإيقاع في الشغب",77,"ب",1,0],["وأَقِلْهُ صَرْعَ الزَّمانِ فكمْ أنْ","قَذَ من نَبْوَةِ الزَّمانِ صريعا",78,"ع",2,0],["وأقل من هذا فليس بمسقط","فرض الصلاة فقم بواجب شكره",79,"ر",2,0],["وأَقلُّ وَجْدِي أَنَّني رَجُلٌ","قد صَارَ عن سُلونِهِ سَالِ",80,"ل",1,0],["وأقلع عن نقائص من جراها","ورثت العار ما بين الرعايا",81,"ا",3,0],["وَأَقلامُ صِدقٍ راجِعٌ في وَلائِها","لِأَكتُبَ مَن أوتي الكِتابَ وَأَبرَعا",82,"ع",2,0],["وَأقِلهُ عَثرَتَهُ وَرِشهُ وَإن هَفا","في الرَّأي أو زَلَّت بِهِ القَدَمانِ",83,"ن",1,0],["وأقلُ فعلي يومَ بانوا أنّني","قبّلتُ آثارَ المطيِّ تشوُّقا",84,"ق",2,0],["وَإِقليدس لو قيس في أَيّ حالة","بِهِ لَم يَكُن إِلا كقطر غمام",85,"م",1,0],["وأقلامها ومواهبها","تبارت معا سحبا تكف",86,"ف",1,0],["وأقل أعذار الحصون مثارها","إذ أسلمت للحاصر المحصورا",87,"ر",2,0],["وأَقلِع عن حديثٍ يُؤ","ذنُ الأضراسَ بالقَلع",88,"ع",1,0],["وَأَقلامُك الأَعناقُ مِنهُم تَقطُّها","بِعَضبٍ غَدَت مِنهُ تَذوبُ العَواضِبُ",89,"ب",1,0],["وَأَقْلاَمٍ تُحَكَّمُ فِي الأَعادِي","كَحُكْمِ السَّيْفِ وَالرُّمْحِ الرُّدَيْنِي",90,"ن",2,0],["وأقلقني شوقٌ ألمَّ بأضلعي","ووجْدٌ على حكم الهوَى مُتماد",91,"د",1,0],["وأقلوا من البكاء على الرس -","م ولا تأسفوا غداة الفراق",92,"ق",1,0],["وَأقَلَّ فَرْقًا غُصْنُ بَانَةِ قَدِّهِ","فَعَجِبْتُ كَيْفَ البَانُ أثْمَرَ فَرْقَداَ",93,"د",2,0],["وأقلّد الأملاكَ منّي حليةً","مطبوعةً بجواهرِ الأفهامِ",94,"م",1,0],["وَأَقلقَها جوى الفرقا فَفاضَت","مَدامِعُها عَلى الخدّينِ قَطرا",95,"ر",2,0],["وَأَقلامُ البَلاغَةِ في يَديهِ","قَواطِعُ لا تُشابِهها نُصولُ",96,"ل",1,0],["واقلقني حادي الركائب بالضحى","وسائقها لما تتابع زجره",97,"ر",2,0],["وأَقْلَعْتُ عن لَهْوِ الغَرامِ ولو بَدَا","مَشيبي ولم أَجْفُ الحبيبَ جَفاني",98,"ن",2,0],["وأَقَلَلْتُ مِنْ عَتْبي عليها تَيَقُّناً","بِيَأْسيَ مِنْ إِعْتابِها حينَ أُعْتِبُ",99,"ب",1,0],["واقل عثاري يا رسول اللَه يا","حسن الخصال ويا عظيم الذات",100,"ت",1,0],["وَأَقلَقَني أَنّي أَموتُ مُفَرِّطاً","عَلى أَنَّني خَلَّفتُ بَعدُ لِداتي",101,"ت",2,0],["واقلب على كلِّ سراجٍ قد مُلي","بزيتهِ اناءَهُ ثم اجعَلِ",102,"ل",1,0],["واقلب عليها طالعا من سُفلها","ليمنةٍ وردَّها لنقلها",102,"ه",2,0],["وأقلُّ ما لاقيتُ من كُلَف الهوى","بعدَ الصّبابةِ لائمٌ وعَذولُ",103,"ل",1,0],["وَاقلِل عَديدُهُم إِن عَدَدتَ","فَما أَكثَرَ الأَرذَلينَ اللِّئاما",104,"م",2,0],["واقلب مجنّك فيها غير مكترث","خلّا يلومك أحيانا وينتقد",105,"د",1,0],["وأقلامُنا عُجْمٌ إذا هي أعربتْ","جرتْ في ميادين الطروس بواكيا",106,"ي",2,0],["واقلبِ الباقي تجد من حقهُ","منك اكرامٌ مساءً وصباح",107,"ح",1,0],["وأقلق سرى والحشى لاعج الهوى","دواماً وجنح الليل حتى إلى الفجر",108,"ر",1,0],["وأقلقتم ملوك الأرض لما","برزتم تبرقون وترعدونا",109,"ن",2,0],["واقلقه ناشر الرياح","من جهة حبه الشديد",110,"د",1,0],["واقلها بالسمن حتى أن ترى","ذات لون مورد أحمر قان",111,"ن",1,0],["وأقلي الرؤوس مع المقادم جملة","بالسمن طبق المقتضى المرغوب",112,"ب",1,0],["وأقلت من الرسالة شمساً","ليس يهدي إلا من استملاها",113,"ا",3,0],["وَأقَلُّ مَا استَقَلَلْتُ وَقْفَةُ زَائِرٍ","خَافَ العُيُونَ وَضَاقَ عَنْهُ المَوْقِفُ",114,"ف",1,0],["وَأقَلُّ مِنْهَا وَكُنتُ جَلْداً قَبْلَهَا","صَبْرِي وَقَدْ وَلَّى الخَيَالُ المُشرِفُ",114,"ف",1,0],["وَأقلُّ شيءٍ من رِضاكَ مُحَصَّلُ","لِمؤمِّلٍُ نَيلَ السَّعادَةِ ما أحَبْ",115,"ب",1,0],["وأقلب الطرف الحزين فما أرى","إلا الورى والموت والترميلا",116,"ل",2,0],["وأقلُّ الثنا على أنه وا","حدُ فخرٍ فما لَهُ من ثانِ",117,"ن",1,0],["وأقلّ ما يجنيهِ قتل الابريا","وأحلُّ شيءٍ عندهُ سفك الدما",118,"م",2,0],["وأقليم كغار الليث أضحت","دماءُ بنيه فيه تراق هدرا",119,"ر",2,0],["وأقلامهُ تجري بكل فضيلةٍ","وألفاظهُ منها تكون البدائع",120,"ع",1,0],["واقلِبَنّ المجَنّ إن لام خلّ","في هواها فأنت غير ملوم",121,"م",1,0],["وَأَقَلُّ ما حَكَمَ المِلالُ عَلَيكُمُ","سوءَ القِلى وَسَماعَ قَولِ العائِبِ",122,"ب",1,0],["وَأَقَلُّ ما يَجِدُ الحَريصُ مُرادَهُ","وَإِذا أَراحَ فَما يَفوتُ مُقَدَّرا",123,"ر",2,0],["واقلب إلى النور الهدى","قلباً به اثر السداد",124,"د",1,0],["وأقلح عجلي كان بخطمه","نواجذ خنزير إذا ما تكشر",125,"ر",1,0],["وَإقليدُه حَقاً هُوَ النَحوُ فاقصِدن","لتَحصيلِهِ إِن كُنتَ للعلمِ عاشِقا",126,"ق",2,0],["وأقلني ان نفسي طوحت","بالنهى فيما به لا يؤذن",127,"ن",1,0],["وَأَقَلُّ جودِ العامِرِيِّ محمَّدٍ","أَلفٌ حَكَت حَدَقي وَتِلكَ نُضارُ",128,"ر",1,0],["وأقلني سيدي من عثرتي","وارع مسعاي فلا أجني اجتراما",129,"م",2,0],["وأقل شيءٍ أن يفيض لمثله","دمع العيون وأن يشق رداء",130,"ا",2,0],["وَأقلع كُل ناب فيهِ سُم","يَصول بِهِ عَلى شَهم زَكي",131,"ي",1,0],["وأقلامها قد أعجزت قصب القنا","فَعطلها عَن حلية البَأس وَالحَد",132,"د",1,0],["وأقل مكرمة له وفضيلة","إجراؤه للغيل في الاجناد",133,"د",1,0],["واقلام من العلماء رقش","سمام الحتف ينفث من شباها",134,"ا",3,0],["وَأَقلِل مِنَ الماءِ الَّذي أَنتَ شارِبٌ","وَأَنّكَ عَطشانٌ فَذاكَ مُريحُ",135,"ح",1,0],["وأَقِل الَّذِين عَلَى المَعاصي قَدْ كَبَوا","وكن الجمالَ لدى المجالس إِنْ حَكوا",136,"ا",1,0],["وأقلت عثرتها بمن هو أهلها","لما رآها قال قول الساخط",137,"ط",1,0],["وأقلام سمر الخط جفت فلم يرق","لمقلتها بالنفس بعد اكتحالها",138,"ل",3,0],["وأَقل عثرة المسيء وَهَبها","أَبدَ الدهر عثرةً لَن تُقالا",139,"ل",2,0],["وَأَقلامُهُ إِن أَرادَ القَريضَ","تَراها لَهُ رُكَّعاً سُجَّدا",140,"د",2,0],["وأَقل فُؤادي صحبةً اضحت لقلبي","كالشكيمِ وغُلَّ شرِّ إسناز",141,"ز",1,0],["وأَقِل مساعينا العِثارَ ورَوِّيَنَّ","أُوامَنا من بحرك الهَتَّانِ",142,"ن",1,0],["وأقل إلهي سيدي عثراتنا","وأزل بفضلك كربة البلواء",143,"ا",2,0],["واقلب بنصرك يا بن عون سجسجا","ريحاً تهب على ربانا زعزعا",144,"ع",2,0],["وأقل منا المكث حتى نلتقي","كالحي يسبقهم بيوم رائد",145,"د",1,0],["وأقلق مهجتي وأذاب جسمي","وأظهر ما بأحشائي تخبا",146,"ب",2,0],["وأقلق بنده قلبي ولكن","أراه عند حجليه أطمانا",147,"ن",2,0],["واقْل المظلومَ ومن هو ذو","بَلَقٍ في الخيلِ وذو حَوَلِ",148,"ل",1,0],["واقلي للوغى كل فتى","كيفما دارت رحى الهيجاء دارا",149,"ر",2,0],["وأقلع يبغي لجة البحر فاستعر","لمنآه أبناء الأخاء على الأثر",150,"ر",1,0],["واقل عثاري إن هفوت فربما","سلم الغريق وجدد الأسفارا",151,"ر",2,0],["وأَقِل عِثَاري واعفُ عَنِّي واحيِنِي","عُمراً طَويلاً بِالسَعادَةِ يُختَمُ",152,"م",1,0],["وَأَقلامي كم انشقت لأني","حرمت مساسَها بِالاصبَعَين",153,"ن",1,0],["وأقلام ياقوت لها بزبرجد","رماح لها أيدي النسيم روافع",154,"ع",1,0],["وأقلني عثرتي يا سيدي","في اكتساب الإثم من خمسين عاما",155,"م",2,0],["وأَقِلْ جوادكَ عثرة ندرت له","إنَّ الجوادَ لَمَن يُقبلُ العاثرا",156,"ر",2,0],["وَأَقلني العثرات جَمعاً وَبدِّل","سَيِّئاتِ الأَيّامِ بِالحسنات",157,"ت",1,0],["وأقلقهُ من الزفراتِ","والأحزانِ ما يجِدُ",158,"د",1,0],["وأقلامه لاقت محابره التي","لأدهمها لاقت مطاردة الخيل",159,"ل",1,0],["واقلع بعد حبوتهِ وأضحى","طويلَ الليل يهرِف بالقُرانِ",160,"ن",1,0],["واقلامه السمر من فوق بيض الصحائف","تفعل فعل العوالي",161,"ل",2,0],["واقلامه تلك النحيلة كم شفت","سقيم زمان بعد يأس من الطب",162,"ب",1,0],["واقلبِ الاسمَ بعد طَرْحِك للصد","رِ تراه عيْباً بدا للعَيانِ",163,"ن",1,0],["وَأَقلِبُ أَعيانَ الجِبالِ فَلَو أَقُل","لَها ذَهَباً كوني فَهُنَّ فَواقِعُ",164,"ع",1,0],["وأقلَقتُ لَيلِي بُكاءً وشَوقًا","لِصُبحٍ, وصُبحِي وَرَاءَ الخِمارْ",165,"ر",1,0],["وأقلامٍ لقد كانَت حِراباً","بِحِقدٍ صُوِّبَتْ نحو النحورِ",166,"ر",1,0],["وأقلُّ وصفٍ للغرامِ بداخلي","خفق الفؤادِ وتمتمات الغيرةْ",167,"ر",2,1],["واقلب الماضي ولاقد تحسفت","لن القمر ماناله اللي تمناه",168,"ا",2,0],["واقلبي اللي توه أفلت عراويه","كيف انسرق وضلوع قلبي حصونه",169,"ن",2,0],["وأقَلْتَ حُبًّا مَنْ تَعثَّرَ ظنُّهُ","لا، لا تُجازِي بِالنقيصَةِ أعْوَجا",170,"ج",2,0],["وأقل عثاري يا كريم وزكني","واقبل نصوحا توبتي ودعائي",171,"ا",2,0],["وأقله عثاره وأنله","منك فوزاً بالموقف المعروف",172,"ف",1,0],["وأقلى ضوء برق مث","ل ما أقلى غنا مزج",173,"ج",1,0],["وأقل عذلك في هوى","من للتصبر عنه قلّل",174,"ل",1,0],["وأقلع عن هجر دياجير ما سجى","من الكفر والأرفاض حل بها النكد",175,"د",1,0],["وأقلع ديجور الضلالة والهوى","وقد طبق الآفاق من سائر البلد",176,"د",1,0],["وأقلامٌ لهم سُكبت","بفحوى جدّ قاهرة!!!",177,"ر",2,0],["وَأَقْلَقَها ما عايَنَتْ مِنْ تَوَلْوُلِي","فَسَحَّتْ بِخَدَّيْها مَدامِعُها قَطْرا",178,"ر",2,0],["وَأَقْلَدَ مِنْكَ بَحْرُ الجَيْشِ حَتَّى","غَرَقْتَ بِلُجِّهِ قُلَلَ الإِكامِ",179,"م",1,0],["وَأَقْلَدَ بَحْراً مُكْفَهِرًّا لِجَيْشِهِ","تَفِيضُ عَلَيْهِمْ مِنْ غَوارِبِهِ الجُرْدُ",180,"د",1,0],["وَأَقْلَقَها جَوَى الفُرْقَى فَفاضَتْ","مَدامِعُها عَلَى الخَدَّيْنِ قَطْرَا",181,"ر",2,0],["وأقل من تبر التراب وفاؤنا","كم خنجر طُعنت به الأعناق!!",182,"ق",1,0],["وأقلى الصبابة لكن أجود","لها بالحشاشة فيما أجود",183,"د",1,0],["وأقل ما يرعون روعة منكرٍ","ونكير من تحت الحصى والجندل",184,"ل",1,0],["واقلبي اللي ضاع واستاقه الهوى","وكل الظروف اللي تحيطه مريبته",185,"ت",2,0],["وأقلُّ.. أقلُّ مطامحه","أن يكشفَ سرَّ الأسرارِ",186,"ر",1,0],["وأقَلّها كلمة بحبِّك","عيشي بقى فيها بخيالك",187,"ك",1,0],["وأقلقني موتُ الكسائيّ بعدهُ","وكادتْ بي الأرضُ الفضاءُ تَميدُ",188,"د",1,0],["وأقللتَ المحبة حيث فاضت‎","وأقصدْتَ الأماني بالبرودِ ‏‎",189,"د",1,0],["‏ ‏وأقلَّ قدْر حازه أبناؤُنا","‏ ‏ والإخوة ُ العلماء والأبرارُ",190,"ر",1,0],["وأقلُّ ردٍّ لن أطالع شِعره","وأُمِيتُه بحصى السكوت المهمِلِ..",191,"ل",1,0],["وأقل ما يعطونه لجدودهم","صندوقُ ليمونٍ ولحمُ أضاحِ",192,"ح",1,0],["واقلقتني عَمَّا أستعين بِهِ","على الْهوى حسرات مِنْك تغشاني",193,"ن",2,0],["وَاقلَعْ جُذُورِيَ, نُسغٌ مِن دِمائِيَ لا","يَزالُ يُوقِدُ فِيها نارَ أَحداقي",194,"ق",2,0],["وأقلح عجلي كأن بخطمه","نواجذ خنزير إذا ما تكشرا",195,"ر",2,0],["وأقلامُ العطاءِ الحُرِّ","في أيدي الوفا جمرُ",196,"ر",1,0],["وأقل جوادك عثرة ندرت له","إن الجواد لمن يقيل العاثرا",197,"ر",2,0]]}