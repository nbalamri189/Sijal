","المجتث"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102972","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125853","الرجز"],[4233,"","https://poetry.dctabudhabi.ae/diwan/poem/143564","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28644","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33785","البسيط"],[4542,"","https://poetry.dctabudhabi.ae/diwan/poem/76556","البسيط"],[4675,"الإحتفال بالمولد النبوي","https://www.poetsgate.com/ViewPoem.aspx?id=193538",""],[4755,"هذا السَّعِيدُ \"تَقَدَّسَتْ أَسماؤُهُ\"","https://www.poetsgate.com/ViewPoem.aspx?id=188670",""],[5022,"ألقمرية","https://www.poetsgate.com/ViewPoem.aspx?id=200597",""],[5038,"بائع الأقداس","https://www.poetsgate.com/ViewPoem.aspx?id=195232",""],[5156,"أتهجروني لتعريفي بكم تيهاً","https://www.poetsgate.com/ViewPoem.aspx?id=99210",""],[5231,"لاَ عَاصِمَ الْيَوْمَ","https://www.poetsgate.com/ViewPoem.aspx?id=47901",""],[5277,"ولأنّها شبهُ القمر..","https://www.poetsgate.com/ViewPoem.aspx?id=194586",""],[5409,"قالوا فتى كان بإحدى القرى","https://www.poetsgate.com/ViewPoem.aspx?id=155270",""],[5490,"صهوة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=176416",""],[5537,"فيها حاجه حلوة","https://www.poetsgate.com/ViewPoem.aspx?id=214540",""],[1547,"قالوا ، هويت رفيعاً نيّراً حسناً","https://www.poetsgate.com/ViewPoem.aspx?id=16765",""],[5790,"حمام مولانا وسيدنا","https://www.poetsgate.com/ViewPoem.aspx?id=111895",""],[5853,"((رهطٌ من الجن))","https://www.poetsgate.com/ViewPoem.aspx?id=175656",""],[161,"السُّكَّرُ والسُّكَّرِيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=157685",""],[6127,"الأملُ الموعود","https://www.poetsgate.com/ViewPoem.aspx?id=198207",""]],"verses":[["قالوا فهل نال مجداً قلت وأعجبي","أتسألوني بمجد ليس من ثَمَري",0,"ر",2,0],["قالوا فلانٌ قد جَفتْ أفكاره","نظم القريض فلا يكاد يجيبه",1,"ه",1,1],["قالوا فَتى الكُتَّاب إلا أنهُ","من شَرْطهِ الأنصافُ والأثلاثُ",2,"ث",1,0],["قالوا فبرهنْ على ما","تقول وهْو جدير",3,"ر",1,0],["قالوا فَراشَةُ حَقلٍ لا غَناءَ بِها","ما أَفقَرَ الناسَ في عَيني وَأَغناكِ",4,"ك",1,0],["قالوا فُلانٌ قَد غَدا تائِباً","وَاليَومَ قَد صَلّى مَعَ الناسِ",5,"س",1,1],["قالوا فَأَغرَونا بِقَولِهِم","حَتّى تَأَكَّدَ بَينَنا الأَمرُ",6,"ر",1,0],["قالوا فرنسا أنذرت سلطاننا","قطع العلائق والوعيد مهول",7,"ل",1,1],["قالوا فروق الملك دار مخاوف","لا ينقضى لنزيلها وسواس",8,"س",1,1],["قالوا فَمَن مِنهُمُ يَحكيهِ قُلتُ لَهُم","كُلٌّ حَكاهُ وَلَكِن فاتَهُ الشَنَبُ",9,"ب",1,0],["قالوا فلانٌ قدْ تولى القضا","في البرِّ قلتُ ادرعوا الصبرا",10,"ر",2,1],["قالوا فلانٌ جيِّدُ","فأجبْتُ أينَ الجيِّدْ",11,"د",1,1],["قالوا فظبيُ نقا فقلْ","تُ الظبيُ يسوى درهمينِ",12,"ن",1,0],["قالوا فسادُ الهواءِ يُردي","فقلتُ يردي هوى الفسادِ",13,"د",1,1],["قالوا فلمْ تطلبِ العزلَ الذي هربَتْ","منهُ القضاةُ قديماً غايةَ الهربِ",14,"ب",1,0],["قالوا فقدناهم ثلاثةَ قادةٍ","ما مِثلُهمُ بأساً ولا إقداما",15,"م",2,0],["قالوا فَصِفهُ قُلتُ في الجَب","هَةِ مِنهُ بَرَجُ",16,"ج",1,0],["قالوا فَزِد قُلتُ وَفي ال","وَجنَةِ مِنهُ بَهَجُ",16,"ج",1,0],["قالوا فَزِد قُلتُ وَفي ال","عَينَينِ مِنهُ دَعَجُ",16,"ج",1,0],["قالوا فَزِد قُلتُ وَفي ال","أَسنانِ مِنهُ فَلَجُ",16,"ج",1,0],["قالوا فَزِد قُلتُ وَفي ال","كَشحَينِ مِنهُ دَمَجُ",16,"ج",1,0],["قالوا فَزِد قُلتُ لَهُم","أَكثَرُ مِن ذا سَمِجُ",16,"ج",1,0],["قالوا فَسَمِّ لَنا هَذا فَقُلتُ لَهُم","وَصفي لَهُ يَعدِلُ التَصريحَ في القيلِ",17,"ل",1,0],["قالوا فخذهُ فأنتَ أنتَ لهُ","سوف نكافيكَ بالذي نجدُ",18,"د",1,0],["قالوا فَلَمّا أَحالوا أَظهَروا لَدَداً","فَالقَولُ مَينٌ وَفي الأَصواتِ تَنديدُ",19,"د",1,0],["قالوا فُلانٌ جَيِّدٌ لِصَديقِهِ","لا يَكذِبوا مافي البَريَّةِ جَيِّدُ",20,"د",1,0],["قالوا فَمالوا فَلَمّا أَن حَدَوتُهُمُ","إِلى القِياسِ أَبانوا العَجزَ وَاِعتَرَفوا",21,"ف",3,0],["قالوا فتىً عشقَ الطبيعةَ واغتدى","بغرائب الأشعارِ وهو متيّمُ",22,"م",1,0],["قَالُوا فَما هِيَ قَالَ أَرْقُدُ مُوهِماً","أَنِّي قَضَيْتُ مُعَاجَلاً بِقَضَاءِ",23,"ا",2,0],["قالوا فَدَع داراً عَلى يَمنَةٍ","وَتِلكَها دارُهُمُ ثانِيَه",24,"ن",3,0],["قالوا فلسطين!قلنا الحين عاجِلها","فاستسلمت لِمدى الجاني على عجَلِ",25,"ل",1,0],["قالوا: فتى القانون أنتَ، وموئِلٌ","للعدل. قلتُ: ومعقلٌ للضاد",26,"د",1,0],["قالوا: فداءٌ له، فقلت لهم:","كلاهما فلْذتان من كبدي",27,"د",2,0],["قالوا فتور اللحظ قد كله","قلت لهم لو كل ما كلما",28,"م",2,0],["قالوا فهل صدقته أقاله","قلت نعم والحب قد أَقالهُ",29,"ل",2,0],["قالوا فهلا قنعت وجهها","فقلت لم أوتى من البغتة",30,"ه",1,0],["قالوا فطير اليهود وافى","فلا فطير ولا خمير",31,"ر",1,1],["قالوا فأنت فقلت الفقر لي سكن","والحرف صاحب ديواني وتدبيري",32,"ر",2,0],["قالوا فمن ذا الذي تعنى فقلت لهم","مولى هو الروح وهو السمع والبصر",33,"ر",1,0],["قالوا فَما أَحسَنهُ","قُلتُ فَما أَعشَقَني",34,"ن",2,0],["قالوا فَلِمَ ترك الزيا","رَةَ قُلتُ مِن خَوف الرَقيبِ",35,"ب",1,0],["قالوا فَكَيفَ يَعيش مَع","هَذا فَقُلتُ مَن العَجيبِ",35,"ب",1,0],["قالوا فلا تسكر فلسنا نرى","لعاقلٍ في سكره عذرا",36,"ر",2,0],["قالوا فهذا السكر ما حده","فقلت حد السكر أن أخرا",36,"ر",2,0],["قالوا فكم تكتب المَعاني","قلت المعنى بهم معان",37,"ن",1,0],["قالوا فدعهم فقلت كلا","لعل دهرا قسا فَلانوا",37,"ن",3,0],["قالوا فقد فارقوك ربعا","قلت هم الناس حيث كانوا",37,"ن",3,0],["قالوا فلانٌ فاسقٌ قلت يا","هناءه إن عد في من فسق",38,"ق",1,1],["قَالُوا فَهَلْ تَشْبَهُ يَقْطِينةً","فَقُلْتُ لَوْ كانَ لَهَا لُبُّ",39,"ب",1,0],["قالوا فَشَرقِيُّ واديها فَقُلتُ وَهَل","شَرقِيُّهُ وَهيَ فيهِ غَيرُ مَغرِبِهِ",40,"ب",2,0],["قالوا فَآوي إِلى كَهفِ الرُقودِ بشهِ","فَقُلتُ لَم أُلفَ فيهِ غَيرَ مُنتَبِهِ",40,"ب",2,0],["قالوا فَمَشهَدُها قُلتُ المَغيبُ بِهِ","عَنّي أَراهُ بِعَيني في تَقَلُّبِهِ",40,"ب",2,0],["قالوا فَمانوا فَلَمّا أَنَّهُم نُدِبوا","إِلى القِياسِ أَبانوا العَجزَ وَاِعتَرَفوا",41,"ف",3,0],["قالوا فُلان غَليظ الجسم ذو ثقل","أَنّى ينال فتاه حسن مُكتَملِ",42,"ل",1,1],["قالوا فُلان خَفيف فَاِبتَدَرت لَهُم","بِعُذره ثُمَّ لَم أَخرُج عَن الصَدَدِ",43,"د",1,1],["قالوا فإنَّ الفَقْرَ حَظُّ مُحبّهمْ","أرضيتَ قلتُ نعمْ رَضيتُ رضيتُ",44,"ت",1,0],["قالوا فَلِمْ تمدح ما نذمه","فقلت قد غايرتكم في قبحه",45,"ح",2,0],["قَالوا ففيه تَبَذُّلٌ","يأباهُ مِثلُكَ قلت أَدري",46,"ر",2,0],["قَالوا فتىً تسمو به هِمَمٌ","مُستصْغَرٌ في جَنبها الخَطَرُ",47,"ر",1,0],["قالوا فتى الروميّ يقصُرُ دونَه","قلتُ اللّكانةُ أصلُها روميّ",48,"ي",1,0],["قالوا فقدنا سليمانا وقد علموا","أن الندى والحجى والعلم قد فقدوا",49,"د",3,0],["قالوا فلان راح يكذب دائما","فأجبتهم عنه بعذر ضيق",50,"ق",1,1],["قالوا فجادوا فكأنّ الرعدَ لم","يُرزِمْ وماءَ المزن لم ينبجِسِ",51,"س",1,0],["قالوا فَريقُ الرَّفْضِ قَدْ أَرْجَفوا","عَلَيْكَ في النَّاسِ بقالٍ وَقيلْ",52,"ل",1,1],["قَالُوا فُلانٌ عظِّمُوا حَقَّهُ","فإنَّهُ مِنْ عُتْرَةِ المصْطَفَى",53,"ف",2,1],["قالوا فَلَمَّا يُجِبهُم","باللهِ اكتُب رِسالَه",54,"ل",2,1],["قالُوا فُلانٌ قد أتانَا خَاطِبا","قُلتُ وفي أيِّ الرجَالِ يَخطبُ",55,"ب",1,1],["قالوا فرغتَ من الأشغال قلت لهمْ","لو لم أَكن باِنتظار الموتِ في شُغُلِ",56,"ل",1,0],["قالوا فمن ذلك لم يسمه","ولا أشار لهم باسمه",57,"ه",1,0],["قالوا فكان صاحبا في الغار","إذ فر من جماعة الكفار",57,"ر",1,0],["قالوا فمنكم رجل ومنا","شريكه فقال ما سمعنا",57,"ن",2,0],["قالوا فشد ذاك ما كان سبق","واجتمع الأمر لذاك واتفق",57,"ق",1,0],["قالوا فأين سلم التباعة","وإنما رد على الجماعة",57,"ه",1,0],["قالُوا فمَنْ أَوْحى إِلي","هِ بِذَا فَقلتُ إِليّ أُوحى",58,"ح",2,0],["قالوا فإن لم يك قلت اسمعوا","بالعلم والمال وحفظ النظام",59,"م",1,0],["قالوا فهل غير الذي قلته","قلت نعم ان سد باب الخصام",59,"م",1,0],["قالوا فلان كبيرٌ","فذاك مِنْ كبريائهْ",60,"ا",3,1],["قالوا فتى الخل مستهام","بشِعره وابنِهِ المثَّل",61,"ل",1,1],["قالوا فصفها فقلت الوصف يعجز عن","إدراك ما قصرت عنه العبارات",62,"ت",1,0],["قالوا ففيم ترى حسنا فقلت لهم","في كل شيء تراءت وهي مرآة",62,"ه",1,0],["قالوا فقد حظر العفاف وروده","والصون بعد وملة الإسلام",63,"م",1,0],["قالوا فكل مخالف لمقالهم","هجر الكتاب وخالف المعبودا",64,"د",2,0],["قالُوا فُلانٌ مِنَ القُضاةِ فَما","بالُكَ في ثَلْبِ عِرْضِهِ جاهِدْ",65,"د",1,1],["قالوا فإن النور حم فقلت لا","ياسينُ حولَ النور من حاميمِ",66,"م",1,0],["قالوا فلانٌ تولى نتفَ عارضهِ","ليصبحَ الحسنُ عنه غيرَ منتقلِ",67,"ل",1,1],["قالوا فَما نَصنع حَتّى نُهلكه","قيل انصبوا مِن المحال شَبكه",68,"ه",1,0],["قالوا فَما ذاك فَقال ذكروا","وَهوَ حَديث شائع مُشتهر",69,"ر",1,1],["قالوا فَنَحنُ كَالعَبيد لَهُم","وَنَحنُ في نصرِهم نتهم",70,"م",1,0],["قالوا فنحنُ تراهُ أعيُنُنا","أبداً وليس نراهُ يَستخفي",71,"ف",2,0],["قالوا فريدُكَ قد أُعطي شهادتهُ","في الطبِّ يا ولدي طابتْ سجاياكا",72,"ك",2,1],["قالوا فَمالَكَ مِنهُ قُلتُ مُعتَذِراً","مِثلُ الَّذي لَكُمُ التَسليمُ وَالنَظَرُ",73,"ر",1,0],["قالوا فَما الحُبُّ إِن كُنتَ اِمرَأً فَطِناً","فَقَد تَحَيَّرَ فيهِ البَدوُ وَالحَضَرُ",73,"ر",1,0],["قالوا فلانٌ قد وزر","فقلتُ كلاَّ لا وزر",74,"ر",1,1],["قالوا فتركب أحياناً فقلت لهم","تحت الصليب ولا في موكب القاضي",75,"ي",1,0],["قالوا فما لك لا تبكي فقلت لهم","الدمع تنشفه نار على كبدي",76,"ي",1,0],["قالوا فلا بدلٌ عليه وقد أسى","في عقد نيته على الكفرِ",77,"ر",1,0],["قالوا فَما أَخلَفُوا مَقالَهُمُ","وَواصَلُوا بِالنَدى فَما قَطَعُوا",78,"ع",3,0],["قالوا فقد تاب وواللّه ما","يتوب أو يجعل في رمسه",79,"س",2,0],["قالوا فلان سيغدوا للردى غرضا","وما دروا بخضم العفو مورودي",80,"د",2,0],["قالوا فلان بخلهُ زائدٌ","لا يعرف الضيف ولا من يُضيف",81,"ف",1,1],["قالوا فصدت فما خلق به حرك","خوفا عليك ولا نفس بها نفس",82,"س",1,0],["قالوا فمن كان مطيعا لهم","اصبح مسرورا بلقياهم",83,"م",1,0],["قالوا فلا تيأس من الرؤية","قلت فلي ذنب وما حيلتي",83,"ي",1,0],["قالوا فلان بالنفا","ق أقام ثروته وجاهه",84,"ه",1,1],["قالوا فسَدتَ وقد مضَى زمن الصِّبَا","اللهُ يُصْلحُ لو أراد فسادَي",85,"د",2,0],["قالوا فزارتك كَي تُبْرى فزدت ضَنىً","فقلتُ برْدُ لِماها زاد في ألمي",86,"م",2,0],["قالوا فسدتَ بساجي اللحظ قلت لهم","أن الفسادَ بساجي اللحظ أصْلَحُ لي",87,"ل",2,0],["قالوا فلان رماه اللَه في سفر","رآه رأياً بما حالت به الحالُ",88,"ل",1,0],["قالوا فلان تولى اليوم مرتبة","عليا يتيه بها عجباً ويفتخر",89,"ر",1,1],["قالوا فهلا لهذا الحرب من حكم","فقلت من ذاك والكسار مشغول",90,"ل",1,0],["قالوا فهلا لهذا الحرب من حكم","يمسى عن الصلح فيها وهو مسؤول",91,"ل",1,0],["قالوا فمن هذا الذي قد أشرقت","شمس السعود له بمين ظاهر",92,"ر",1,0],["قالوا فأية بلدة فازت به","فأجبتهم منصورة ذات الندى",93,"د",2,0],["قالوا فهل هنت بذلك أهلها","فأجبتهم وبها السرور ترددا",93,"د",2,0],["قالوا: فلا وصل قلت الآن أطمعني","تفاؤلٌ باعتناق اللام والألف",94,"ف",1,0],["قالوا فَصِفهْ رْبّما","نَعرِفُه بِالخَبرِ",95,"ر",1,0],["قالوا فلان في القريض أميرنا","فأجبتهم ان الجنونَ فنون",96,"ن",1,1],["قالوا فما لك منها قلت يخدمني","لها ومن اجلها الحمقى من الناس",97,"س",1,0],["قالوا فنيتم به فقلنا","لما فنينا به بقينا",98,"ن",2,0],["قالوا فلانٌ عالمٌ فاضلٌ","فأكرمُوهُ مثلما يَرْتضي",99,"ي",1,1],["قالوا فلان قدر في بزوجة","لرتبة لم يك قبلها حرى",100,"ر",2,1],["قالوا فان العفو من شأنهم","عن كل ما يجنيه ملاهم",101,"م",1,0],["قالوا فضائله تحصى فقلت لهم","من ذا سوى اللَه رمل الأرض يحصيه",102,"ي",2,0],["قالوا: فناداه صوت","يقول في غير رفق",103,"ق",1,0],["قالوا فرنسة قلت أين كرامها","خرجت سياستهم عن الموضوعِ",104,"ع",1,0],["قالوا فهذي بغي","فزاد اذ ذاك كربي",105,"ي",1,0],["قالوا فؤادك لا تدعه للدمى","هدفا فقلت لهم وأين فؤادي",106,"د",2,0],["قالوا فلسطينُ انتهتْ","فقلت هل ذا آخِرُ",107,"ر",1,0],["قالوا فقد كنت ذا صبر تعوذ به","فقلت شرده عني الهوى فمضى",108,"ض",2,0],["قالوا فَتىً غابَ فيهِ قُلتُ وَاعَجَبي","ما إِن رَأى مِثلَ ذا راء وَلا سَمِعا",109,"ع",2,0],["قالوا فَما نفسٌ يعلوكَ ذا صُعُدٍ","وما لعينكَ لا ترقى مآقيها",110,"ه",2,0],["قالوا فَإِن لَم تَنَم كَيفَ السَبيل لَهُ","قُلتُ التَخيُّلُ وَالأَفكارُ تَغنِيني",111,"ن",2,0],["قالوا فليلتنا ؟ فقلت: مليئة","بالرقص والشجر الخبيث المفسِد",112,"د",1,0],["قالُوا: فَعَلْنَا مَا يُرِيدُ وأَطفَؤُوا","في الليلِ صُبحًا لَم يَحِنْ إطفاؤُهُ",113,"ا",3,0],["قالوا فهل يلقى عليك خواطر","من بيننا بل أنت كذاب أشر",114,"ر",1,0],["قالوا : فَمَنْ يا تُرى لِلْقُدْسِ مُغْتَصِبٌ","أَ حاكِمٌ بَاعَ أَمْ مَنْ يَشْتَري الْحَرَما",115,"م",2,0],["قالوا فما نفس يعلو كذا صعداً","وما لعينك لا ترقا مآقيها",116,"ه",2,0],["قَالُوا :.. فَقُلْتُ اسْتِعَارَاتِي مُهَدَّلَةٌ","وَرِحْلَتِي فِي مَجَازِي رَوْضةٌ أُنُفُ",117,"ف",1,0],["قالوا: \"فما بالُ المحاقِ يحفُّهُ؟\"","فأجبتهم: \"قمري كمثلي منكسرْ!\"",118,"ر",1,0],["قالوا فتى كان بإحدى القرى","طال على الناس مدى شره",119,"ر",2,1],["قالوا فردَّدت الأيامُ خلفَهُمُ","وأسهبَ الدهرُ في أشعارهم شَرْحا",120,"ح",2,0],["قالوا فيها حاجه حلوه","قلت أيوه يعني فين",121,"ن",1,1],["قالوا فما الحبُّ ، إِن كنتَ امرَءَاً فَطِناً","فقد تحيّر فيه البدو والحضرُ",122,"ر",1,0],["قالوا فصفها قلت مختصرا","هي جنةٌ وسراجها عمر",123,"ر",1,0],["قالوا فإ نا قد أتينا نشتكي","بعض الأمور كم نراها واضحةْ",124,"ح",2,0],["قَالوا : فُلَانٌ أصَابَ السُّكَّرِيُّ دَمَهْ","واخْتَلَّ نَظْمٌ فَصَار الحَلُّ مُبْتَكَرَا",125,"ر",2,0],["قالوا فقيراً أتيْتَ الأرضَ معدمةً","كلتا يديك فلا يرجونَك الكَرَما",126,"م",2,0]]}