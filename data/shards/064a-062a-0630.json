{"poems":[[63,"عندي إذا مالروض أصبح ذابلا","https://www.aldiwan.net/poem51487.html","الكامل"],[107,"وضح السبيل فما لنا نتردد","https://www.aldiwan.net/poem43144.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54760","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83292","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83291","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48670","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48642","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126188","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50018","المتدارك"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48986","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100223","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108035","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132098","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86542","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86523","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86572","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86521","الكامل"],[5268,"في فؤادكِ موطنٌ","https://www.poetsgate.com/ViewPoem.aspx?id=207011",""],[5542,"مشاهد من يوم القيامة","https://www.poetsgate.com/ViewPoem.aspx?id=10202",""],[5842,"إشراقات الأمل / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=105051",""],[4442,"ما بال جفنك لا يدر","https://www.poetsgate.com/ViewPoem.aspx?id=171226",""],[6093,"صمت يتذوق الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=202721",""]],"verses":[["يتذاكرُ الفِتيانُ كيفَ يُحرِّموا","فمضَوا قتيلاً لا يُعابُ وقَاتِلا",0,"ل",2,0],["يَتَذَمَّرونَ إِذا تَجَرَّدَ شَعبُهُ","لِلحَقِّ يُطلَبُ وَالأَمانَةِ تُنشَدُ",1,"د",1,0],["يَتَذَكَّرُونَ إِمَامَهُمْ عُمَراً","أَيَّامَ كَانَ فَرِيدَةَ الْعِقْدِ",2,"د",1,0],["يَتَذَكَّرونَ مَواقِفاً مَشهورَةً","لَكَ لَيسَ تَترُكُ لِلمَراءِ سَبيلا",3,"ل",2,0],["يَتَذَكَّرونَكَ كُلَّ حَزَّةٍ مَأزِقٌ","وَلَدَيَّ الحَنادِسَ تُنشِدُ الأَقمارُ",4,"ر",1,0],["يتذكر الإسلام فجرك مادحاً","فيجدد التذكار تلك الأنعما",5,"م",2,0],["يتذكرون جهاده وفتوحه","وصنيعه والطيبات الأولى",6,"ل",2,0],["يتذكر الأيامَ وهي بعيدة","والسحب حانية على نظراتهِ",7,"ت",2,0],["يتذكّر ما عهدته دُمى","من زمان الحمَى والصبّا خضِلُ",8,"ل",1,0],["يتذاكرانِ بدهشةٍ وكآبةٍ","بعظيمِ خطبكَ يا فَتى الفتيان",9,"ن",1,0],["يتذاكرون بكل منقبةٍ","حتى إذا ذكر الندى طربوا",10,"ب",3,0],["يتذكر الإنسان طيب نعيمه","فيه وأنس أحبة ورفاق",11,"ق",1,0],["يتذكرون مرابعاً وأحبةً","والذكر للمشتاق جرعة صابِ",12,"ب",1,0],["يتذكرونك غائباً","حتى كأنك في الحضور",13,"ر",1,0],["يتذامرون كأنما أصواتهم","صبب الأتى بمترع الغدران",14,"ن",1,0],["يتذامرون على الفناء كأنما","طمس الخليقة مأرب مقصود",15,"د",1,0],["يتذكرون من الأوائل معشراً","كالجن كانوا في متون الأبحر",16,"ر",1,0],["يتذَكَّرُ الشوقَ العليلَ فينتشي","كالثَّلجِ يُدميهِ الحنينُ فيُصهَرُ",17,"ر",1,0],["يتذكرون حوادث الدنيا التي","صمدوا لها وعلى الإله توكلوا",18,"ل",3,0],["يتذكر القدس السليبة عاقداً","عزم الأباة، سلاحه الإصرارُُ",19,"ر",1,0],["يتذوقون الموت شهد","خلية والموت مر",20,"ر",1,0],["يتذوق الصمت الكلام، ولم أجد","من صامت إلا الجواب الغالبا",21,"ب",2,0]]}