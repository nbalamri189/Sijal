{"poems":[[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[53,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[64,"يا روضة الحسن إن ضن السحاب بما","https://www.aldiwan.net/poem52305.html","البسيط"],[47,"ميلوا إلى الدار من ليلى نحييها","https://www.aldiwan.net/poem66851.html","البسيط"],[54,"ومشمولة قد طال بالقفص حبسها","https://www.aldiwan.net/poem27087.html","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20985","المنسرح"],[47,"مِيلُوا إلى الدّارِ مِنْ لَيْلَى نُحَيّيهَا","https://www.poetsgate.com/ViewPoem.aspx?id=31648",""],[20,"لم أر مثل الفتيان في غبن ال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69760&r=&rc=1",""],[242,"أبلغ لها مني تحية ذي هوى","https://www.aldiwan.net/poem18164.html","الكامل"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[445,"الآن رد عنان الملك في يده","https://www.aldiwan.net/poem34858.html","البسيط"],[463,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39080","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63760","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38949","الرجز"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69195","المنسرح"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56145","الكامل"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105855","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68014","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119610","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94533","الكامل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135098","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83468","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89580","الكامل"],[4882,"سمّي العراقَ اذا ما اصْلحتْ ذِمما-بهاء الدين الخاق","https://www.poetsgate.com/ViewPoem.aspx?id=11522",""],[5344,"طبعي مزوح","https://www.poetsgate.com/ViewPoem.aspx?id=154945",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5722,"آذار","https://www.poetsgate.com/ViewPoem.aspx?id=12684",""],[5952,"آخر الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=204836",""],[6239,"بَرْزَخٌ من حَجَرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76053&r=&rc=104",""]],"verses":[["مَحفوفَةً وَسطَ اليَراعِ يُظِلُّها","مِنهُ مُصَرَّعُ غابَةٍ وَقِيامُها",0,"م",3,0],["محفوفةً شهوةَ النفوس على","أحسنِ نَضْدٍ تروق مُبْصرها",1,"ر",3,0],["محفوفةٌ بقصيراتِ الخُطَى خُرُدٍ","أقدامُها بالقرون السودِ تنتعِلُ",2,"ل",1,0],["مَحفوفَةٌ بِرِياضٍ لا تَزالُ تَرى","ريشَ الطَواويسِ تَحكيهِ وَيَحكيها",3,"ي",3,0],["مُحَفَّرَةٍ فيها تَصاويرُ فارِسٍ","وَكِسرى غَريقٌ حَولُهُ خِرَقُ الجُندِ",4,"د",1,0],["مَحفوفَةٌ بِالجبَالِ دونض عُرضى ال","كَيدِ فيها تَرقَى غَواربُها",5,"ب",3,0],["مَحْفُوفَةٌ بِرِياضٍ، لا تَزَالُ تَرَى","رِيشَ الطّوَاوِيسِ تَحكِيهِ وَتحكيهَا",6,"ي",3,0],["مَحفوفَةٌ بِالجِبالِ دونَ عُرى","الكائِدِ ما تُرتَقى غَوارِبُها",7,"ب",3,0],["مَحْفُوفَةً بِخُلوصِهِ وَصَفائِهِ","يُبْدِي مَحَاسِنَ وُدِّهِ وَتُعِيدُهَا",8,"ه",2,0],["مَحفوظَةً أَبداً تَرعى مَذاهِبَها","عَن قُدرَةِ اللَهِ قَد دَلَّت غَرائِبَها",9,"ه",2,0],["محفوظةٌ عند حُرٍّ لا يَحُورُ بِهِ","عن يومِهِ لَكَ رَيْبُ الدهرِ فِي غدِهِ",10,"د",2,0],["محفوظةٌ عندي ودائعُكم","في الودّ حفظَ نفائسِ الذّخر",11,"ر",1,0],["مَحْفُوفَةً بالآسِ مِنْ","هُ على مَحاسِنِها خِمارُ",12,"ر",1,0],["محفوفةٍ بقوادمٍ","كقودامِ النَّسْرِ المطار",13,"ر",1,0],["مَحفوفَةً بِغايَةِ الإِحكامِ","وَغايَةِ النّظامِ بِاِنتِظامِ",14,"م",1,0],["مَحفوفَةً بالكروم وَالنخل وَالرَي","حان ما يَستَقِلّ طائِرها",15,"ر",3,0],["مَحفوفَة بِالرَدى منطّقة","بالصغر مَحصورة جَبابرها",15,"ر",3,0],["محفوظة بحماء افضل سيّدٍ","حسن الخلال أمين كل لقيّةِ",16,"ه",1,0],["محفوفة برماحٍ من منابتها","مشحونة بين ارواح وأمطارِ",17,"ر",1,0],["مُحَفَّرةً جاءته تُزْجى شئونَها","وهل يقتني العلياءَ إِلاَّ الأَكابس",18,"س",1,0],["محفوفة بورود المدح قد عَبَقت","بها لطيب شذاها السادة الأُوَل",19,"ل",1,0],["محفوفةً منك المنابر في البها","دُم نعم خطّابٍ رقى وتفضَّلا",20,"ل",2,0],["محفوفة أطراقة بالزهر","منقطاً مطوقاً بالدر",21,"ر",1,0],["محفوفَةً بِالبِشر إِذ وُلد الهدى","بِولادة الهادي البَشير الأَرفَعِ",22,"ع",1,0],["مَحفوفُ بِالأَنوارِ فَض","ضاحُ الرواذُ وَمُفتَخَر",23,"ر",1,0],["محفوظ والورد استاذيك قد جدلا","فيك التفنن والعيسى وقد عصما",24,"م",2,0],["محفوظ قدره غاب او كان موجود ،","ويبقى مكانه دايمن هو مكانه",25,"ن",2,0],["مَحْفُوفَةٍ بِطِرازِ العَدْلِ سامِيَةٍ","فَوْقَ السَّماواتِ حَيْثُ احْتَلَّ كَيْوانُ",26,"ن",1,0],["محفة آذار تلقي عليه","أزاهيرها الغضة الناديه",27,"ي",2,0],["محفوفةٌ طرق المحبة بالأسى","أدري ..ولكني أفي بوعودي",28,"د",2,0],["محفوظٌ اسمُكِ قبل اللَّوح،","وجمري منطفئُ العنوانْ",29,"ن",1,0]]}