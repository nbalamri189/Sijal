{"poems":[[147,"لك السعي ما ينفك يخدمه السعد","https://www.aldiwan.net/poem11747.html","الطويل"],[228,"نام إلا الهوى فأهلك ناموا","https://www.aldiwan.net/poem39722.html","الخفيف"],[240,"تأوبني فأرقني خيال","https://www.aldiwan.net/poem31734.html","الوافر"],[422,"بلغتم كمال الرشد أبناء راشد","https://www.aldiwan.net/poem54010.html","الطويل"],[505,"ليل المحب إذا تطاول بالسهر","https://www.aldiwan.net/poem38019.html","الكامل"],[572,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114027","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204883","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91763","البسيط"],[4830,"فَوا حَرَّ قلباه","https://www.poetsgate.com/ViewPoem.aspx?id=214347",""],[4927,"مي","https://www.poetsgate.com/ViewPoem.aspx?id=29958",""],[5725,"بغداد ليمونتي","https://www.poetsgate.com/ViewPoem.aspx?id=210926",""],[5956,"لبتر أسباب الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=184187",""],[5956,"أيا صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=194490",""],[6142,"أذاكر أنت أم ناس خطاب رسو","https://www.poetsgate.com/ViewPoem.aspx?id=155718",""],[572,"أَلاَ أَبْلِغْ أَبَا بَكْرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9291&r=&rc=148",""]],"verses":[["فَأَسهَرتَ أَجفاناً تَطاوَلَ نَومُها","لِتَرقُدَ أُخرى ما لَها بِالكَرى عَهدُ",0,"د",1,0],["فَاِسهَري فَالعَجوزُ نامَت عَلى المِ","نَدِ سَهرانَةً عَلَيها السَلامُ",1,"م",1,0],["فَأَسهُلُ جانِباً وَأَليَنُ عِطفاً","لِأَجباسٍ مِنَ المَعروفِ خُشنِ",2,"ن",1,0],["فأَسْهَرْتَ عين الخطّ والخطّ ساهر","وما أَنتَ عن ثار العدوّ براقد",3,"د",1,0],["فاسْهَرْ بُنَيَّ واقْطعْ نِصْفَهُ","أبَداً فَمَنْ نامَ الدُّجا حبًّا غَدَرْ",4,"ر",1,0],["فَأَسْهِمْنِي مِنَ الغَرْسِ ال","لَذِي عِنْدَكَ يَا ذُخْرِي",5,"ر",2,0],["فاسهرَ اللَّيل لكي تحظَى فما","بلغَ المقصُودَ مَن عنهُ رَقَد",6,"د",1,0],["فأسهل عيش أن تعيش كما ارتأوا","وأقسى حياة أن تعيش كما ترى",7,"ر",2,0],["فَأَسهر الجون إِن طالَت وَإِن قصرت","بعبرة عبرة للدَهر أَبكيها",8,"ي",3,0],["فأسهرتَ ليلي بقطْعِ الوصالِ","وأطفأْتَ من آمِلاتي الشموعْ",9,"ع",1,0],["فَأَسْهَرُ وَالنُّجُوْمِ طَوَاْلَ لَيْلِيْ","وَيَحْسُدُنِيْ عَلَى السَّهَرِ الْمُرِيْبُ",10,"ب",1,0],["فأسهرها حين لا تنطفي","جفونٌ بنيرانها تستباح",11,"ح",1,0],["فأسهِمْ في رفاهة كل شعب","ليحيا العالمون بلا حروبِ",12,"ب",1,0],["فأسهمْ يا صديقي بالتلاقي","لأنك كنز وُدٍّ واستقامةْ",13,"م",2,0],["فأسهب القول في ذكرى رسالته","وأنه لم يقصر في تأديها",14,"ي",3,0],["فأسهِمْني من الغَرسِ","الذي عندَكَ يا ذُخْرِي",15,"ر",2,0]]}