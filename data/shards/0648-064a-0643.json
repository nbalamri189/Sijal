ml","الطويل"],[442,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[459,"ما أنتِ بعد البين من أوطاني","https://www.aldiwan.net/poem55853.html","الكامل"],[459,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[459,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[459,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[459,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[459,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[462,"وصاحب من بني الآمال خضت به","https://www.aldiwan.net/poem15303.html","البسيط"],[462,"أبى الله أن تمسي همومي صواحبي","https://www.aldiwan.net/poem15375.html","الطويل"],[462,"لله در غمام سح صيبه","https://www.aldiwan.net/poem15914.html","البسيط"],[462,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[462,"يسيل دماء الدارعين ودمعه","https://www.aldiwan.net/poem16165.html","الطويل"],[462,"بقيت مطاعا ما تغنت حمامة","https://www.aldiwan.net/poem16342.html","الطويل"],[462,"ليهن الرعايا والمناقب والعلى","https://www.aldiwan.net/poem16354.html","الطويل"],[465,"معاليك أعلى أن يحيط بها الوصف","https://www.aldiwan.net/poem3294.html","عموديه"],[465,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[478,"يسائلها والبين ترغو رواحله","https://www.aldiwan.net/poem15235.html","الطويل"],[483,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[483,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[483,"فيا رب هذا الدهر قد جار حكمه","https://www.aldiwan.net/poem24499.html","عموديه"],[483,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[496,"أنت في دنياك هذي","https://www.aldiwan.net/poem10254.html","مجزوء الرمل"],[496,"ويك يا دهر لحاك الله","https://www.aldiwan.net/poem10282.html","مجزوء الرمل"],[501,"أتانا من صبا نجد نسيم","https://www.aldiwan.net/poem37783.html","الوافر"],[507,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[515,"يا منة لذ بها السكر","https://www.aldiwan.net/poem20811.html","أحذ الكامل"],[515,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[516,"مقامك من فضل وفصل خطاب","https://www.aldiwan.net/poem12011.html","الطويل"],[525,"نبي له في كل فضل تقدم","https://www.aldiwan.net/poem13291.html","الطويل"],[539,"ضاءتا كالفرقدين","https://www.aldiwan.net/poem47422.html","عموديه"],[568,"بالله يا متفردا في حسنه","https://www.aldiwan.net/poem69705.html","الكامل"],[576,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"],[576,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[576,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[576,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"],[588,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["وَيُكثِرُ مَطلِيَ الغُرماءُ إِلّا","إِذا راحَ الرَدى وَغَسا غَريمي",0,"م",2,0],["وَيَكُرُّ وَالفَرَسُ الجَوادُ مُبَلِّدٌ","وَيَقُدُّ وَالعَضبُ الحُسامُ مَعوقُ",1,"ق",1,0],["وَيَكشِفُ الرَّوعَ عَنِّي صارِمٌ خَذِمُ","وَالسَّيفُ نِعمَ مُجيرُ الخائِفِ الوَجِلِ",2,"ل",1,0],["ويَكْنُفُهُ نَصْرٌ يُناجي لِواءَهُ","إذا ما هَفا كالطّائِرِ المُتَقلِّبِ",3,"ب",1,0],["ويُكْرِمُ نَفْساً إنْ أُهينَتْ أراقَها","بمُعتَرَكٍ يُروي القَنا وهْو ظَمآنُ",4,"ن",1,0],["وَيَكونُ خِلطاً في طَعا","مي ما حَييتُ وَفي شَرابي",5,"ب",2,0],["ويُكْذِبُها الحِسُّ الذي مَنْ يرُدُّهُ","فللجَهْلِ أصْغى أو إلى أهْلِهِ انْضَوى",6,"و",2,0],["وَيُكَيِّفُ السَّببَ الْخَفِيَّ لِمَنْ قَضَى","بِسَعَادَةِ مِنْهُ إِلَيْهِ تُوَصَّلُ",7,"ل",1,0],["ويكادُ ينْتَعِلُ الهِلالَ إذا سَرَى","ويُقَلِّدُ الشّمسَ المُنيرَةَ جِيدُهُ",8,"د",2,0],["وَيَكدِمُ أَكفالَها عابِساً","فَبِالشَدِّ مِن شَرِّه يَتَّقينا",9,"ن",2,0],["ويكف من أشجان صب يشتكي","جور الزمان وقلة الأنصار",10,"ر",1,0],["ويكاد قلب الصب يفنى رقّة","بين النشيد ونغمة الأوتار",10,"ر",1,0],["وَيَكَادُ يُنْقَضُ فَضْلُ بَاذِلِهَا","فِي غِبْنِ نَائِلهَا تَعَوَّدَهَا",11,"د",3,0],["وَيَكُدُّ كَدَّ النَّحْلِ وَهْ","يَ لِغَيْرِهَا تَسْعَى وَتَجْنِي",12,"ن",2,0],["وَيُكَاتِمُ النَّاسَ الَّذِي فِي صَدْرِه","وَمِنَ القُوَى مَا نِيطَ بِالكِتْمَانِ",13,"ن",1,0],["وَيَكُونُ يَوْمَئِذٍ شِفَاءُ غَلِيلِهَا","وَمَتَاعُهَا وَفَنَاؤُهَا فِي آنِ",14,"ن",1,0],["وَيَكُونُ أَبْدَعَ صُورَةٍ رَمْزِيَّةٍ","لِجِهَادِكُمْ تَمْثَالُ سَعْدِ يُقَامُ",15,"م",1,0],["ويكون المُعَزّ غير مّعَزاً","ويكون المُهان غير مهان",16,"ن",1,0],["ويك إن الإسلام أوجد فينا","وحدة مثل وحدة الرحمن",16,"ن",1,0],["ويكون مَنظرُه الرهيب مُمَهّداً","لمُشاهديه إلى الصلاح طريقا",17,"ق",2,0],["ويك إن المعقول ما صحّ عندي","فمتى صحّ عندك المنقول",18,"ل",1,0],["وَيَكفي خَزيرُ المِرجَلَينِ مُجاشِعاً","إِذا ما السَرايا حَسَّ رَكضاً مُغيرُها",19,"ر",3,0],["وَيُكَلِّلونَ إِذا الرِياحُ تَناوَحَت","خُلُجاً تُمَدُّ شَوارِعاً أَيتامُها",20,"م",3,0],["ويكتب بالنصال غداة روع","سطوراً ما لأحرفها هجاء",21,"ا",2,0],["ويكاد الدمع يهمي عابثا","ببقايا ….. كبرياء ….. الألم",22,"م",1,0],["ويكْفيه إن خانَ الشهادةَ خائنٌ","بما اسْتَشْهَدَتْ آثارُه من شُهُودها",23,"د",3,0],["ويَكُدُّ الموضعَ المس","كين بالتكرير كَدَّا",24,"د",2,0],["ويكدُّ الجثمانَ والروحَ والجا","هَ طويلاً ولا يرى الكدَّ كدّا",25,"د",2,0],["ويكشف أعقابَ الأمور صدورُها","له فيراها غائباً كمشاهدِ",26,"د",1,0],["ويكتنَّان بالأكوا","خ والرمضاء كالجمر",27,"ر",1,0],["ويك يا واسطيُ فاسمع مقالي","ونصيحي فلستُ بالغشَّاش",28,"ش",1,0],["ويك يا عائب الحبيب لتسلى","عنه مهلاً طلبت أحوى عقوقا",29,"ق",2,0],["ويكتهلُ الشبانُ تحت ظلالها","وتهرَم أجيالٌ عليها وأجيالُ",30,"ل",1,0],["ويكتمُ عُرفَهُ فيفوحُ منه","وليس لساطع المسكِ اكتتامُ",31,"م",1,0],["ويك يا بيْنُ أيُّ قَرن عليه","ليتَ للبيهقي عَقْلاً بوزنِه",32,"ن",2,0],["وَيَكونُ ما يَرجوهُ زَورَةَ صاحِبٍ","وَيَكونُ أَبعَدَ ما يُرَجّي في غَدِ",33,"د",1,0],["وَيَكونُ أَقصَرَ ما يَكونُ إِذا الفَتى","مَدَّت لَهُ الدُنيا يَدَ المُتَوَدِّدِ",33,"د",1,0],["وَيكَ صاحَت وَدَمعُها","كَجُمانٍ مُبَدَّدِ",34,"د",1,0],["وَيَكفيكَ مِنّي ما قَد رَأَي","تَ فَلَيسَ العِيانُ كَمِثلِ الخَبَر",35,"ر",1,0],["وَيَكفيكَ أَنَّ الكامِلَ النَدبَ مِنهُمُ","وَيَكفيكَهُم هَذا هُوَ المَجدُ وَالفَخرُ",36,"ر",1,0],["ويكونُ مركبُكِ القَعودَ وحدجَهُ","وابنُ النعامةِ يومَ ذلكَ مَركَبي",37,"ي",1,0],["ويكون الكذب أجدى","ان سيف الكذب ماض",38,"ض",1,0],["ويكاد نسر الموت وهو محلق","ينقض مندفعا علي بمخلب",39,"ب",1,0],["ويكشف الحق ان","الحق عن العين احتجب",40,"ب",1,0],["ويكاد قارئه لكل عبارة","يزداد إِنسانية وتمدنا",41,"ن",2,0],["ويكفله موشَّى البر","د يوم الفخر مُعلَمه",42,"م",2,0],["وَيَكادُ مِن سِحرِ البَلاغَةِ تَحتَهُ","عودُ المَنابِرِ يُستَخَفُّ فَيورِقُ",43,"ق",1,0],["وَيَكادُ مِن طَرَبٍ لِعادَتِهِ النَدى","يَنسَلُّ لِلفُقَراءِ مِن أَثوابِه",44,"ب",2,0],["وَيُكَبُّ طاغوتُ الأُمورِ لِوَجهِهِ","مُتَحَطِّمَ الأَصنامِ وَالأَشباحِ",45,"ح",1,0],["ويُكَبِّرونَ بِأَنْ قُتِلْتَ وإنّما","قَتَلوا بكَ التّكْبيرَ والتّهْليلاَ",46,"ل",2,0],["وَيَكبُرُ أَن تَقذى بِشَيءٍ جُفونُهُ","إِذا ما رَأَتهُ خَلَّةٌ بِكَ فَرَّت",47,"ت",1,0],["وَيَكذِبُ ما أَذلَلتُهُ بِهِجائِهِ","لَقَد كانَ مِن قَبلِ الهِجاءِ ذَليلا",48,"ل",2,0],["وَيَكفيكَ مِن فَضلِ الدَنانيرِ أَنَّها","إِذا جُعِلَت في الزادِ ثانِيَةُ التَقوى",49,"و",2,0],["وَيَكفي الفَتى مِن نُصحِهِ وَوَفائِهِ","تَمَنّيهِ أَن يَردى وَيَسلَمَ صاحِبُه",50,"ب",2,0],["وَيُكدي مِنَ الحاجاتِ أَقرَبُها مَدىً","عَلى ظَنِّ باغيها وَأَوضَحُها نَهجا",51,"ج",2,0],["وَيَكسُدُ مِثلي وَهوَ تاجِرُ سُؤدَدٍ","يَبيعُ ثَميناتِ المَكارِمِ وَالحَمدِ",52,"د",1,0],["وَيَكفيكَ مِن حَقِّ تَخَيُّلُ باطِلٍ","تُرَدُّ بِهِ نَفسُ اللَهيفِ فَتَرجَعُ",53,"ع",1,0],["وَيَكفي مِنَ الرُمحِ المُبِرِّ بِطولِهِ","بَلاغُ الحِمامِ مِن سِنانٍ وَعامِلِ",54,"ل",1,0],["وَيَكلَفُ الوَجهُ مِنهُ حينَ يَفقِدُها","كَأَنّهُ لِاِربِدادِ الوَجهِ فَحّامُ",55,"م",1,0],["وَيُكَلِّفونَ أَباعِراً ذَهَبَت","جِيَفاً بَلينَ تَقادُمَ العَصرِ",56,"ر",1,0],["ويكاد ماء بهائه","في وجنتيه ينهمل",57,"ل",1,0],["ويَكُرُّ مَطرورَ السِّنانِ كأنه","قمرٌ يطارِدُ في العَجاجةِ كَوكَبا",58,"ب",2,0],["وَيكَ أَنّى لَكَ الجُزارَةُ وَالحُم","قُ أَجِبني وَأَنتَ في ذاكَ جُندي",59,"د",2,0],["وَيَكادُ يَخرُجُ سرعةً من ظِلِّهِ","لو كان يرْغبُ في فراق رفيق",60,"ق",1,0],["ويكلأ ذِمْرٌ على ضامرٍ","خبِيئَةَ خِدرٍ على عِرْمِسِ",61,"س",1,0],["وَيكَ سَلِّم لِلواحِدِ الخَلّاقِ","إِنَّ في الحَلقِ قائِداً لِلحُلاقِ",62,"ق",1,1],["ويكَ يا قلبَها بعلمِ وفاءٍ","منهُ إنَّ الوفاءَ أحصنُ سورِ",63,"ر",1,0],["وَيَكادُ الحَجلُ مِن غَصَصٍ","حينَ يَستَأنيهِ يَنكَسِرُ",64,"ر",1,0],["وَيَكادُ العَجزُ إِن نَهَضَت","بَعدَ طولِ البُهرِ يَنبَتِرُ",64,"ر",1,0],["وَيَكفي فَيَكفَلُ في حالَةٍ","فَيَبني المعالي كَفى أَو كَفَل",65,"ل",1,0],["وَيَكتُبُ وَالخَطبُ مُستَفحِلٌ","فَيَدفَعُ في صَدرِ ماقَد أَهَم",66,"م",1,0],["وَيكِ طالَت بِنا بُلَهنِيَةُ العَي","شِ فَمُتنا سَآمَةً وَمَلالا",67,"ل",2,0],["وَيْكَ عبدَ اللهِ ماذا تَبتغِي","تَعِبَ الشَّرُّ ولمَّا تتعبِ",68,"ب",1,0],["وَيَكلأها بِالنَشاط العَجيب","وَلِلدَهر في الناس شَأن عَجيب",69,"ب",1,0],["ويكاد يقلقني الأّمير بقوله","كاد المعلم أن يكون رسولا",70,"ل",2,0],["وَيَكَدنَ يَخلَعنَ الجُلو","دَ لِشِدَّةِ الرَوعاتِ",71,"ت",1,0],["ويُكسِبُ الغيْظُ مُقْلَتَيَّ وخَد","ديَّ احْمِراراً كنامر القِرْبَهْ",72,"ب",2,0],["ويكادُ يَخفَى عن بَناتِ ضميرِهِ","مكتومُ ما هو مُبتَغٍ ومحاول",73,"ل",1,0],["ويكادُ يَلقاهم على أفواهِهِمْ","قبلَ السَّماع الرّشْفُ والتّقبيل",74,"ل",1,0],["ويَكادُ فُولاذُ الحَديدِ معَ ال","مُهَجاتِ والعَبَراتِ يَبتَدِرُ",75,"ر",1,0],["ويكلّفُ الأرْماحَ لِينَ قوامِهِ","فيذمُّ ذا يَزَنٍ ويَظلِمُ قَعْضَبا",76,"ب",2,0],["وَيكَ إِنَّ الحُبَّ لَم يَم","لِك سِوى رِقِّيَ رِقّا",77,"ق",2,0],["وَيَكُنَّ النِساءُ بيضاً وَأُدماً","صيغَةً بَعدَ صيغَةِ الأَترابِ",78,"ب",1,0],["وَيَكادُ يُظلَمُ حينَ يُغشى بَيتُهُ","مِن لينِ جانِبِهِ وَلَينَ حِجابِهِ",79,"ب",2,0],["وَيَكادُ يَنزِعُ جِلدَ مَن يُصلى بِهِ","بِلَوافِحٍ مِثلِ السَعيرِ الموقَدِ",80,"د",1,0],["وَيَكونَ لِلبادينَ عَذبُ مِياهِهِ","مِثلَ المُدامَةِ لا تَحِلُّ لِوارِدِ",81,"د",1,0],["وَيَكُرُّ مِن جَيشِ القَضاءِ مُسَلَّطٌ","ثَورٌ وَشابَةُ تَحتَهُ خَوّارُ",82,"ر",1,0],["وَيَكونُ لِلزُهرِ الطَوالِعِ مُنتَهىً","يَذوَينَ فيهِ كَما ذَوى النُوّارُ",83,"ر",1,0],["وَيَكونُ غَيرَ مُصَدِّقٍ بِقِيامَةٍ","أَمسى يُمَثِّلُ في النُفوسِ ذُهولَها",84,"ل",3,0],["وَيَكفيكَ التَقَنُّعُ مِن قَريبٍ","عَظائِمَ لَيسَ تُبلَغُ بِالتَوَنّي",85,"ن",2,0],["ويُكْنَى باسْمِهِ عن كلّ مجْدٍ","وكلُّ اسْمٍ كِنايَتُهُ فُلانُ",86,"ن",1,0],["وَيَكفي المَقالَةَ أَهلَ الرِج","لِ غَيرَ مَعيبٍ وَلا عائِبِ",87,"ب",1,0],["ويكرُمُ مَن لم يَعْرِف الجودَ كَفُّه","ويحلُمُ عند الغيظ مَن لا لهُ حِلم",88,"م",1,0],["ويكدر ماء الشعر بعد صفائه","ويصفو لمن يُعْنَى به بعد أكدار",89,"ر",1,0],["وَيك نَفسي إن السعادة خودٌ","لا تَزور العشاق غير لمام",90,"م",1,0],["ويكبر أن تقذى بشيءٍ عيونه","إذا ما رأته خلّةٌ بك فرّت",91,"ت",1,0],["ويك يا بحرُ ما أنينك في ال","لَيل أنينَ المرَّوع الهيّابِ",92,"ب",1,0],["ويكَ دَعْنا نمرحْ بأجملِ أيا","مٍ ونلقى من بعد خوفٍ أمانكْ",93,"ك",1,0],["ويك قل لي أليسَ نملك يوماً","أن نراها أما تبينُ خطاها",93,"ه",2,0],["ويكِ لا تنظري إلى قدَحي","نظرَاتِ الغريبِ واقتربي",94,"ب",2,0],["ويكاد من بَهَج يضيءُ سِراجَه","وجهٌ عليه من الطهارةِ رَونقُ",95,"ق",1,0],["وَيَكونُ يَومٌ لا أَرى لَكِ مُرسَلاً","أَو نَلتَقي فيهِ عَلَي كَأَشهُرِ",96,"ر",1,0],["ويَكادُ الخَيْفانُ يَنزِلُ في القَيْ","ظِ عليها سآمَةً أنْ تَطيرا",97,"ر",2,0],["ويُكْني شهيدُ المَرْءِ غيرِكَ هَيْبَةً","وبُقْيا وإنْ يُسألْ شهيدُكَ لا يكني",98,"ن",2,0],["وَيَكَادُ بَحْرُ الآلِ فِي أَطْرَافِهَا","يَشْجُو السَّمَاعَ بِمَوْجِهِ الْهَدَّادِ",99,"د",1,0],["وَيَكَادُ يُلمَسُ فِيهِ مَشْهُودُ الرُّؤى","وَيُحَسُّ هَمْسُ الظَّنِّ في الحَوْبَاءِ",100,"ا",2,0],["وَيكْسِبُهَا مَعْنَى الحَيَاةِ ذُبُولُهَا","لَدَى نَاظِرِيهَا فَهْيَ فِي النَّفْسِ أَجْمَلُ",101,"ل",1,0],["وَيَكَادُ شَاهِدُ حُسْنِهَا وَكَمَالِهَا","بِالشِّعْرِ يَنْطُقُ وَهْوَ لَيْسَ بِشَاعِرِ",102,"ر",1,0],["وَيَكُونُ أَوَّلُ مَنْ يُلِبِّي إِنْ دَعَا","دَاعِي الْعُلَى فِي الْفِتْيَةِ الامْجَادِ",103,"د",1,0],["وَيُكَلِّلُونَكِ بِالنِّصالِ تَشابَكَتْ","كَمِظَلَّةٍ صُنِعَتْ مِنَ الأنْوَارِ",104,"ر",1,0],["وَيَكَونُ يَوْمَ السِّلْمِ خَيْرَ مَسَالِمٍ","ويَكُونُ يَوْمَ الْحَرْبِ خَيْرَ مُحَارِبِ",105,"ب",1,0],["وَيَكُونُ المِثَالُ فِيمَا تَوَلَّى","تُبَّعاً أَوْ تَخَيُّراً وَانْتِدَابَا",106,"ب",2,0],["وَيَكفي المَقالَةَ أَهلَ الرِجا","لِ غَيرَ مَعيبٍ وَلا عائِبِ",107,"ب",1,0],["ويكاد يحمله، لما تركت","منه الصبابة، مخلب الصرد",108,"د",1,0],["وَيَكادُ جامِحُهُ يُثَقِّفُ في الطُلى","بِالطَعنِ أَطرافَ القَنا المُنآدِ",109,"د",1,0],["وَيَكادُ يهدي لِلمُؤدّب نَفسه","مُستَجلِياً لِهُداهُ بِالإِهداءِ",110,"ا",2,0],["وَيكُم بَياضُ الصُبحِ أَحسَنُ مَنظَراً","في العَينِ مِن ظَلماءِ لَيلٍ أَليَلِ",111,"ل",1,0],["ويكاد سامعه يفسّر لفظه","من قبل أن يسري إلى آذانهِ",112,"ن",2,0],["ويكفيك أنْ تدعو أبا الطبِّ باسمِهِ","فإنَّ العُلا صارتْ له لَقَباً واسما",113,"م",2,0],["وَيْكَ لا تَجْزَعْ لِنازِلَةٍ","ما لِطَيْرِ الْجَوِّ مِنْ وَطَن",114,"ن",1,0],["وَيْكَ يا قَبْرُ صِرْتَ لِلْفَضْل مَثْوىً","لا يُسَامَى ولِلنُّبُوغِ مَقِيلاَ",115,"ل",2,0],["وَيَكْشِفُ الأَمَلَ الْمَحْجُوبَ سَاطِعُهُ","وَالْيأْسُ تَغْشَى بأَسْدافٍ وَأسْتَارِ",116,"ر",1,0],["ويكفيكما الله شرَّ البكاء","ويحفظ من وقعه أذنيا",117,"ي",2,0],["ويكاد يَصهَرُهُ الدخا","نُ كأنما هو من جليد",118,"د",1,0],["ويكاد يسلخ نفسه من قومه","لو تستطاع قطيعة الأرحام",119,"م",1,0],["ويكاد يمسخ خلقه، لو كان في","يمناه قَلْبُ معالم الأجسام",119,"م",1,0],["ويكرُع قوم عتيق المُدامِ","وقومُ إلى كأس ماءٍ ظِماء؟",120,"ا",2,0],["ويكادُ يحسبُها الجريحُ بجسمه","ثَغرًا؛ فيومئُ نحوَها تقبيلا",121,"ل",2,0],["ويكونُ النَّجاحُ حِلْفًا لهمْ في","كلِّ خطو، وهُمْ لهُ حلفاءُ",122,"ا",2,0],["ويكسر في مفّ طاغي لبحمى","حساما بأكباده مغمدا",123,"د",2,0],["ويكاد الصمت يروي حبّنا","قصّة لو طاوع الصمت الكلام",124,"م",1,0],["ويكاد \" دويزن \" يبعثر قبره","ويطلّ حمير من وراء الأعصر",125,"ر",1,0],["ويكرهُ منه الحلوُ وهو عصيرُ","فَوَلَّوْا وَسوءُ الظَّنِّ يَلوِي وُجُوُهَهمْ",126,"م",1,0],["ويُكسبُ الغيظُ مقلتيَّ وحدَّ","يَّ احمرارً كزامرِ القربه",127,"ب",2,0],["ويكون الحقُ – ما بينهما -","باطلاً والطالحون الصلحاء",128,"ا",2,0],["ويكاد اللبيبُ يلمُسُ حباتِ","قلوبٍ على نِقاط الحُروف",129,"ف",1,0],["ويكُبُّ جباراً ، ويُعلي مُدقعاً","ويُنيرُ خابطةً ، ويُنهضُ راقدا",130,"د",2,0],["ويكادُ يشهَق بالعَويل بَلاطُه","ويَصيحُ بالألم الدفينِ رُخام",131,"م",1,0],["ويكفيكَ منه ساعةٌ لاختباره","لتعلمَ منها أنه لم يزل غِرّا",132,"ر",2,0],["وَيَكْفيكَ في فَضْلِ الدّنانيرِ أنّهَا،","إذا جُعلَتْ في الزّادِ، ثانيَةُ التّقوى",133,"و",2,0],["ويكدُّ الجثمانَ والروحَ والجا","هَ طويلاً ولا يرى الكدَّا كدّا",134,"د",2,0],["وَيَكْذِبُ مِنْهَا الحَاجِبُ المُتَحَدِّبُ","وَيَكْذِبُ فِيهَا قَلْبُهَا المُتَقَلِّبُ",135,"ب",1,0],["وَيَكْذِبُ مِنْ بُعْدٍ شَذَاهَا المُطَيَّبُ","عَلَى غَيْرِ مَا ظَنَّتْ بِهَا النَّاسُ مِنْ قَبْلِ",135,"ل",1,0],["وَيَكرهك الجَميع كَما كَرهنا","لا رجلنا العَتيق مِن النِعال",136,"ل",1,0],["ويكفيك منها مد راحة احمد","نبي الهدى من جاء في مدحه الذكر",137,"ر",1,0],["ويكشف أسراراً بكم قد أكنها","عن الكون خوف الطي في الأمر والنشر",138,"ر",1,0],["ويكشف أسرار الضمائر من خفا","جليس ويبدي ما توهمه فكرا",139,"ر",2,0],["ويكفيه افتخاراً في البرايا","على الأفراد مد يمين أحمد",140,"د",1,0],["وي كأن السماء تلطم بالعش","ر بعشر المحرم الأفلاكا",141,"ك",2,1],["ويكادُ مِن كرمِ الطباعِ تُسِيغُه","لكنّه حَتْفٌ لكلِّ مُنافِق",142,"ق",1,0],["ويكونُ الذي تُدَبِّرُ مقبولاً","لَدَى الأوليَاءِ والأكْفَاءِ",143,"ا",2,0],["ويُكرِمُ مَن خَلَّفتُ في جَنَبَاتِهِ","وإِن لَم يَكُن أهلاً لِذَلَكَ تُكُرُّمَا",144,"م",2,0],["ويك اتئد فالحق في الدنيا أحقّ","فيما علمنا مثلُ هذا ما سبقْ",145,"ق",1,1],["وَيَكسو الصُبحَ مِن نَقعِ خِضاباً","كَليلٍ وَالنُصولُ بِهِ نُصولُ",146,"ل",1,0],["وَيَكفي كِلاباً وَهوَ مَيتٌ وَعَمَّهُ","نُمَيراً حَياةً أَنَّ جَدَّيكَ مِنهُما",147,"م",2,0],["وَيَكونُ لِلراجي هَياةً حُلوَةً","وَلِمَن طَغى فَبَغى عَلَيهِ حِماما",148,"م",2,0],["ويكمل بالتقوى ويسمو مكانة","يصير بها للأمر بالفضل نفاذا",149,"ذ",2,0],["ويكون قبل حلوله أفرشته","خدي وطاء للنعال وللحفا",150,"ف",2,0],["ويكون بيت نزوله قلبي الذي","وحياتهم من حب غيرهم عفا",150,"ف",2,0],["ويكفيك في الأمر الذي لا يرده","سواك وتلقى مثله فتقيمه",151,"م",2,0],["وَيُكرَمُ أَقوامٌ مُعيدٌ أَبُوهُمُ","وَيُحرَمُ مَن يُدعى عَلِيّاً وَعَبدَلا",152,"ل",2,0],["وَيُكرِهُ الصَعدَةَ السَمراءَ أَصغَرُنا","سِنّاً وَيُفحِمُ كَهلَ القَومِ ناشِينا",153,"ن",2,0],["وَيَكُونُ ذِكرِى بَينَهُنَّ تَلاحِياً","حَذَرَ العِدَى إِلاّ وَهُنَّ خَوَالِى",154,"ل",2,0],["وَيُكحلُ الجفنُ منِّي بَعدَها بِدَمٍ","مِن حَيثُ جفنكَ وَيْحِيي بِالبِلَى اِكتَحَلا",155,"ل",2,0],["وَيْكِ أَما يكفيك أن تُبِصري","جَنائزا تنقَل بالراتب",156,"ب",1,0],["ويكسبني طعمي ذلّة","وليس رجوعي إلا إليه",157,"ي",2,0],["ويكون فيك عن استما","حة فضل نائلهم عدول",158,"ل",1,0],["ويكفيك أمر الموبقات وشرّها","ويرعاك في حزن ووقت سرور",159,"ر",1,0],["وَيكرهُ أهلَ الدينِ حتّى قريبهُ","وَلا سيّما مَن كانَ أشعثَ مُغبرّا",160,"ر",2,0],["وَيكون فيها بالنبيّ عليما","صلّوا عليهِ وسلّموا تسليما",161,"م",2,0],["وَيُكسى رِداءَ العِلمِ وَالحِلم وَالتُقى","فَيُدرِك عُقبى مَن تَعفّفَ وَاِستَحيا",162,"ح",3,0],["وَيَكُرُّ العَبدان بِالمُحلَبِ الأَح","نَفِ فيها حَتّى يَمُجَّ السَقاءُ",163,"ا",2,0],["ويك بالحب أشبعيني ضمّا","أنكرتني وأوسعتني ذمّا",164,"م",2,0],["ويكتبُ ما يحكي العيونَ ملاحةً","وما السحرُ إلا مقلةٌ وكتابُ",165,"ب",1,0],["ويك لا تأمنن صروف الليالي","إنها تترك العزيز ذليلا",166,"ل",2,0],["ويكاد يقطر منه في حركاته","ماء النعيم لرقَّةِ الأطرافِ",167,"ف",1,0],["ويك يا مُسلِمَهُ المُس","لِمَ نفسي للبوارِ",168,"ر",1,0],["ويكاد اذا ما رام على","عجل ليقوم فيقعده",169,"د",2,0],["ويكفيك من حالي باني امرؤٌ اخو","كفاف واحلى العيش ما بعضه كفى",170,"ف",2,0],["ويكفيك من حالي باني امروؤٌ أخو","كفاف واحلى العيش ما بعضه كفى",171,"ف",2,0],["ويكفي في العلا ان نلت مجدا","به الدهر عز وافتخار",172,"ر",1,0],["وَيكَ قُل لي مَتى أَراكَ بِجَنبي","راضِياً عن مكانِكَ المَهجور",173,"ر",1,0],["ويكف عنا فتنة كادت لها","منا عرى إيماننا تتفسخ",174,"خ",1,0],["وَيُكسِبُهُ ظُلمُهُ ظُلمَةً","تُعيرُ النَهارَ سَوادَ الغَسَق",175,"ق",1,0],["ويكفيه أن الله أخزى عتوه","فذلله إذ لم يكن قط يحسب",176,"ب",1,0],["ويكفيهم ما جاء أنّ ملائكاً","تحفّهمُ من طارق الغيّ والردى",177,"د",2,0],["وَيَكفيكَ مِن أَيّامِهِم وَحُروبِهِم","بِما جَرَّتِ الغَبراءُ أَو جَرَّ داحِسُ",178,"س",1,0],["ويكبحُ من كلِّ البحور جماحَها","إذا أزبَدَت أمواجُها واكفهرّت",179,"ه",3,0],["ويكونُ في الدّنيا جحيمَ قلوبنا","وشعورُها قد زادَه تَحسينا",180,"ن",2,0],["ويُكسرُ سقطُ النّسرِ وهو محلِّقٌ","وتَقضي فِراخُ الطير وهو مغرِّد",181,"د",1,0],["وَيكبر أَن يخاطب أَو يسمى","بسر السر أولب اللباب",182,"ب",1,0],["وَيَكسو المذهب السنى حسنا","وَينشر ظل رايته العقاب",182,"ب",1,0],["وَيَكْثُرُ أعْلامَ البَسيطَةِ وَحْدَهُ","كَمَالَ مَعَالٍ أو جَمالَ مقَاوِمِ",183,"م",1,0],["ويكرم أن نرجوه للأمر هيناً","ويشرف أن ندعوه بالماجد القرم",184,"م",1,0],["وَيَكْبُرُ قَدْراً أَنْ يُرى مُتكبرَّاً","وَيَعْظُمُ مَجْداً أَنْ يَتيِهَ مَعَ العُظْمِ",185,"م",1,0],["وَيَكْرُمُ عَدْلاً أَنْ يَميلَ بهِ الهَوى","وَبَشْرُفُ نَفْساً أَنْ يَلَذَّ مَعَ الإِثمِ",185,"م",1,0],["وَيَكفيهِ أَنَّ الناسَ قَد مَنَعوا الحَبا","فَلَيسَ لَهُ إِلّا إِلَيهِ سَبيلُ",186,"ل",1,0],["وَيَكسوهُم في صَيفِهِم وَشِتائِهِم","بِأَحسَنَ ما ضَمَّتهُ أَسفاطُ بَزّازِ",187,"ز",1,0],["وَيَكُ صَبراً فَأَنتَ مِن خيرَةِ سَنَورٍ","رَأَتهُ عَيناي قطّ بَحّارَةِ",188,"ر",2,0],["وَيَكْبَّهُمْ حَتَّى تَظَّلَ رُؤُوسَهُمْ","مَأْمومةً تَنْحَطُ لِلْغُرْبانِ",189,"ن",1,0],["ويكرّمون بنا الصغير","ويهزأون من الكبير",190,"ر",1,0],["وَيكتمُ المَعيبا","وَيحفظُ المَغيبا",191,"ب",2,0],["وَيَكفيهِ فخراً في المَفاخر أَنَّه","مؤازرُه دونَ الأَنام وكافلُه",192,"ل",2,0],["وَيكفُّني حلمُ الحِجا حتّى إِذا","دَبَّت حُميّا الكأسِ بعض دَبيبها",193,"ب",3,0],["ويكون فيهم للربوع وأهلها","أنس ونفع الطالب المنتفع",194,"ع",1,0],["وَيَكادُ اليراعُ يورق منها","حَيث يُدلي السطور كالأغصانِ",195,"ن",1,0],["وَيكلؤها ليلاً بِلحظِ رعايةٍ","يَهابُ حثاثَ النومِ لم بهِ وأطا",196,"ط",2,0],["وَيكَ لا يستنسرُ البغثُ المهيض","فَهوَ لِلباري على عمدٍ حُزِر",197,"ر",1,0],["ويكاد يغفر في قوافي مدحه ال","إكفاء والإقواء والإيطاءُ",198,"ا",2,0],["ويكاد رأيه أن يباري رؤية","فتلوح قبل وجودها الأشياءُ",198,"ا",2,0],["وَيَكونُ في نَفسِ المَحاكِمِ ما بَدا","وَجهٌ لَهُ مِن سِتَّةِ لَمَعانِ",199,"ن",1,0],["ويكفيك نقضاً ان ما قد سألته","من العذر مردود لدى كل فطرة",200,"ه",1,0],["ويكفيك نقضاً ما بجسم ابن آدم","صى ومجنون وكل بهيمة",200,"ه",1,0],["ويكاد رجع ندائه","يحيى رفات الغابرين",201,"ن",1,0],["ويكاد يقرأ غيبه بخياله","في مقلتيك",202,"ك",1,0],["وَيَكْمُدُ الأَنْدادُ كَمْ بَينَهُمْ","تَحاسُدٌ أَوْجَبَ مَا أَوْجَبَا",203,"ب",2,0],["وَيَكمُلُ التَّشبيهُ فِيه إذا","غَرِّقَ في الماءِ إلى آذانهِ",204,"ن",2,0],["وَيُكثر في بَذل المُروءة عَذله","وَهَيهات أَن يُصغي لِعذل عذولهِ",205,"ل",2,0],["ويَكْشِفُ الهَوْلَ في الهَيْجا إذا شَرَعتْ","يَمينُهُ ماضياً فيها يَمانيه",206,"ي",2,0],["ويكونُ مثْلُكَ معْ حقارةِ قَدرِه","سَنتَيْنِ يَرفعُ دَخْلَ خُوزِسْتانا",207,"ن",2,0],["ويكون مثُلك أنت واسطةً إذا","ما كان مثْلَ أولئكَ الطَّرَفان",208,"ن",1,0],["ويَكْفُلُ عُمْرُ المَرءِ يوماً بحَظِّهِ","فقلتُ وهل لي بالكَفيلِ كَفيل",209,"ل",1,0],["ويَكشِرُ عن حَدِّ أَنيابِه","وفي قلبِه مَرَضٌ ليسَ يَبْرا",210,"ر",2,0],["ويَكْفى عَقيمَ المُلْكِ إيماءُ رأيهِ","إذا كان يومٌ يَسلُبُ النَصْلَ غِمْده",211,"د",2,0],["وَيُكذِبُ ما يَحكي عَنِ القَلبِ دَمعُهُ","وَلَولا الهَوى لَم يَحكِ دَمعٌ فَأَبطَلا",212,"ل",2,0],["وَيَكسِرُ صُبحُكَ لي عَينَهُ","فَيا لَيلُ دُمتَ لَهُ كاسِرا",213,"ر",2,0],["وَيَكفيكَ أَنَّ السَيفَ لا نَفعَ عِندَهُ","إِذا هُوَ لَم يوصَل ظُباهُ بِقائِمِ",214,"م",1,0],["ويكونُ كالظنِّ البَعيدِ لعائِدي","كَمدي فَما يَنفكُّ أو يَتحقَّقُ",215,"ق",1,0],["ويكونُ طرفُك في كفالةِ ما رمى","فأصابَني فإذا بَرِئتُ فقَد بَري",216,"ر",2,0],["وَيَكاد يَمنَع أَن يلمَّ","بِنا خَيال خَيالِهِ",217,"ل",2,0],["ويكرهون الضير","لكل خلق الله",218,"ه",1,0],["ويكفي الباغي الظالم","بما يشا إنه ذوالشان",219,"ن",1,0],["ويكفي الشر والأشرار","ويذهب الهم والأكدار",220,"ر",1,0],["ويكفي جميع الشر فضلا ومنة","ويحفظنا كل ضر وجاهل",221,"ل",1,0],["وَيَكمدُ الناصِبُ المَلعونُ ان قُرِئت","وَاللَهُ يَجزي بَني النَصبِ المَلاعينا",222,"ن",2,0],["ويكره قلبي ذليل الخط","فتى بين أترابه محتقر",223,"ر",1,0],["ويكون كل الدين للرحمن ما","لسواه شيء فيه من إنسان",224,"ن",1,0],["ويكاد أن يحيي العظا","م من الرميم بكل جسم",225,"م",1,0],["ويكون النصر فيه للهدى","ويولي غيره منهزما",226,"م",2,0],["ويكنز ما فيها لِيُكْوَى جبينُه","مع الظهر منه يوم كشف السرائر",227,"ر",1,0],["ويكاد يُدْرِك نشوة","مِنْ حمله أيضاً بريدُه",228,"د",2,0],["ويكفيه فخراً أنه لم يقله في","مليك لجدواه فيطرب بالكذب",229,"ب",1,0],["وَيكسبها نَشراً ذَكياً كَما كَسا","مَجاسِدهُنَّ العَنبرَ المُتأرِّجُ",230,"ج",1,0],["وَيَكشف غَمّاءَ الخطوبِ بِنَفسِهِ","لَدى النَقعِ وَالهَيجاء بالهامِ تحصُبِ",231,"ب",1,0],["وَيَكسِرُ في الحَربِ أَسيافَهُ","لِيَكفِيَ مُعظَمَ آفاتِها",232,"ت",3,0],["ويكاثِرونَ بدمْعِ من","يُغْري بهم دَمْعَ الغمائِم",233,"م",1,0],["ويكادُ ينتقلُ البلادُ وأَهْلُهَا","شوقاً إِليه فكيفَ لا يَتَنَقَّلُ",234,"ل",1,0],["ويكَ إن الحُرّ يُقنِعُهُ","من طفيفِ الرّزْقِ ما سنَحا",235,"ح",2,0],["ويكسرن الجفونَ على لِحاظٍ","هي الأسيافُ تحفل بالغُمودِ",236,"د",1,0],["ويكثرُ باسمِك أقسامُنا","فنُخبِرُ عن سَهميَ المُيْسِرِ",237,"ر",1,0],["ويك يا نضى اتئ","د واسل عمّن قتلك",238,"ك",1,0],["ويك قصّر عن الملام وذرني","عثرتي فيه ما لها من إقاله",239,"ل",2,0],["ويكفيك شكري إن شكرتك في الورى","فمجد الفتى بالشكر راح مخلدا",240,"ا",1,0],["ويك إن لم تكن رأيت الذي أه","واه فاسمع يصيبك فيه الكلام",241,"م",1,0],["ويكثر عذلي في هواه عصابة","جعلت لرأسي من خلافهم عصبا",242,"ب",2,0],["ويكتُبَ فَوْقَ جبيني ووجهي","إِلَى نُوَبِ الدهرِ حِيدي حَيادِ",243,"د",1,0],["ويكتُبَ لي فِي آلِ يَحْيَى وسائِلاً","تتيهُ عَلَى القُرْبى وتُزْهى عَلَى الصِّهْرِ",244,"ر",1,0],["ويَكفي مُلُوكَ الأَرْضِ من كُلِّ مَفْخَرٍ","إِذَا امْتَثَلُوا من بَعْضِ أَفعالِهِ شَيَّا",245,"ي",2,0],["ويكتم داء الحب صب خديعة","ليلحق وصلاً من هوى مظهر الضنى",246,"ن",2,0],["ويكاد مُوقدهم يجود بنفسه","حبَّ القِرى حطباً على النيرانِ",247,"ن",1,0],["ويَكرُمُ صَوبُ المُزن لو أنّ ماءَه","يُنبَّط من أيمانهم فيسيلُ",248,"ل",1,0],["ويَكُرَّانِ يطرُقانِك ما قا","مت بنعمانَ بانةٌ أو ضالَهْ",249,"ل",2,0],["ويكفيكِ منتقِعاً في الحدي","د أن تأبُري النخلَ أو تزرعي",250,"ع",2,0],["ويَكمَدُ الحاسدُ والشامتُ بي","بفرطِ ما قد أكلاني أَشَرا",251,"ر",2,0],["ويكون زادَ السَّفرِ في ليل الطَّوَى","ويقادُ تتبعه المهاري القُودُ",252,"د",1,0],["ويكرم السيف عن غِمدٍ فيغمدهُ","إذا يُجردهُ في رأسِ جَبَّارِ",253,"ر",1,0],["ويكسِرُ أبْطال الخميسِ وانهُ","لكسرِ مَعاديمِ الرجالِ لَجابِرُ",254,"ر",1,0],["ويُكْرم الضيف والجار المُقيمَ به","حتى يبيتا من الَّلأْواءِ في حَرَمِ",255,"م",1,0],["ويكره أن يُلقى بطاعةِ خالعٍ","نِفاقاً فيَغْرو مُظْهِراً ومُكتِّما",256,"م",2,0],["ويكرُمُ ليناً في الودادِ وعُودُهُ","على الروع والخطب المَهيب صليبُ",257,"ب",1,0],["ويكْبُر عن إِضْمارِ غِشٍّ لخائنٍ","فأعداؤه نهبُ الرَّدى والمَعاطِبِ",258,"ب",1,0],["ويكرُم عن إِضمار شَرٍّ وفِعْلِهِ","فأفكارُهُ مأمونَةٌ والبَوادِرُ",259,"ر",1,0],["ويكسر كَبَّاتِ الخميس بعزْمِه","ولكنَّهُ للفَقْر بالجود جابِرُ",259,"ر",1,0],["ويكشف جنحَ المشكلات بيانهُ","لديها ووجهُ الصبح من شانهِ الكشف",260,"ف",1,0],["ويكفيك أني بسهم الفراق","كليمُ الفؤاد سليمُ البدن",261,"ن",1,0],["ويكفيهِ شُغلاً بعدَ فُرقةِ بينهِ","سَقامٌ عَنِ العذّالِ واللَّومِ شاغلُهْ",262,"ل",2,0],["ويكفي علوم القوم إن كان طالبا","لها موسى إذ قد كان عين الفضائل",263,"ل",1,0],["ويكفيهم أن كانوا مظهر مصدر ال","وجود على وفق انبعاث أمان",264,"ن",1,0],["ويكلؤني من كل خطب ألم بي","أنادي أيا قهار أوصل حباليا",265,"ي",2,0],["ويكلؤنا الرحمن من كل طارق","وتسترنا أنواره الرهبوتيه",266,"ي",2,0],["ويك يا غافل لم لا","يخطر الموت ببالك",267,"ك",1,0],["ويك يا دهر لحاك ال","له ما أعظم شانك",268,"ك",1,1],["ويكتبُ في القُلُوبِ رَقيمَ وجدٍ","فيا للهِ من ذاكَ الرَّقيمِ",269,"م",1,0],["ويكشف عما بأيديهمُ","وناهيك عن مَوقف صاغر",270,"ر",1,0],["ويكفيه سمعكَ من سامعٍ","ويكفيه لحظكَ من ناظِر",270,"ر",1,0],["ويكاد أن يرِدَ السّماءَ إذا","ظنّ المجرّةَ أنّها نَهْرُ",271,"ر",1,0],["ويكادُ ينطِقُ في البنانِ يراعُهُ","لو أنّ مقطوعَ اللّسانِ تكلّما",272,"م",2,0],["ويكبر عن لفظ السلام وإنما","يحيا بتعفير ولثم تراب",273,"ب",1,0],["وَيَكفيك بِالإِسراءِ عِلماً بِقدره","وَبِالمَجد ما في الذكر مِن ذِكرِهِ العَلي",274,"ل",2,0],["ويكادُ الطرفُ في","حسنهِ أن يغرقا",275,"ق",2,0],["ويُكاتِمُ الأسرَارَ حتى إنَّهُ","ليصُونُها عن أَنْ تَمُرَّ بِخَاطِرِهْ",276,"ر",2,0],["ويَكْفُر أَنعمَك السابغاتِ","فسوفَ تعودُ عليهِ نِقَمْ",277,"م",1,0],["ويكادُ يَرويه السرابُ كرامَةً","والرَّي في بحر السَّراب غريقُ",278,"ق",1,0],["ويكاد يَجْحدُ خدُّها نسباً لها","إِذ لا يرى لا زال أحمر أصفر",279,"ر",1,0],["ويكاد يسبقُ سرعةً","عشقُ المريدِ له الإِرَاده",280,"د",2,0],["ويكفيك فعل المصطفى فتقيدن","لما سنه واحذر تخالفه تعتد",281,"د",1,0]]}