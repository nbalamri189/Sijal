19",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[45,"لَنَا أبَداً بَثٌّ نُعانيهِ من أرْوَى","https://www.poetsgate.com/ViewPoem.aspx?id=31686",""],[51,"يا أبا أحمدٍ ومثلُك لا يَغْ فَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=27822",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"]],"verses":[["وَيُكثِرُ مَطلِيَ الغُرماءُ إِلّا","إِذا راحَ الرَدى وَغَسا غَريمي",0,"م",2,0],["وَيَكُرُّ وَالفَرَسُ الجَوادُ مُبَلِّدٌ","وَيَقُدُّ وَالعَضبُ الحُسامُ مَعوقُ",1,"ق",1,0],["وَيَكشِفُ الرَّوعَ عَنِّي صارِمٌ خَذِمُ","وَالسَّيفُ نِعمَ مُجيرُ الخائِفِ الوَجِلِ",2,"ل",1,0],["ويَكْنُفُهُ نَصْرٌ يُناجي لِواءَهُ","إذا ما هَفا كالطّائِرِ المُتَقلِّبِ",3,"ب",1,0],["ويُكْرِمُ نَفْساً إنْ أُهينَتْ أراقَها","بمُعتَرَكٍ يُروي القَنا وهْو ظَمآنُ",4,"ن",1,0],["وَيَكونُ خِلطاً في طَعا","مي ما حَييتُ وَفي شَرابي",5,"ي",1,0],["ويُكْذِبُها الحِسُّ الذي مَنْ يرُدُّهُ","فللجَهْلِ أصْغى أو إلى أهْلِهِ انْضَوى",6,"و",2,0],["وَيُكَيِّفُ السَّببَ الْخَفِيَّ لِمَنْ قَضَى","بِسَعَادَةِ مِنْهُ إِلَيْهِ تُوَصَّلُ",7,"ل",1,0],["ويكادُ ينْتَعِلُ الهِلالَ إذا سَرَى","ويُقَلِّدُ الشّمسَ المُنيرَةَ جِيدُهُ",8,"د",2,0],["وَيَكدِمُ أَكفالَها عابِساً","فَبِالشَدِّ مِن شَرِّه يَتَّقينا",9,"ن",2,0],["ويكف من أشجان صب يشتكي","جور الزمان وقلة الأنصار",10,"ر",1,0],["ويكاد قلب الصب يفنى رقّة","بين النشيد ونغمة الأوتار",10,"ر",1,0],["وَيَكَادُ يُنْقَضُ فَضْلُ بَاذِلِهَا","فِي غِبْنِ نَائِلهَا تَعَوَّدَهَا",11,"د",3,0],["وَيَكُدُّ كَدَّ النَّحْلِ وَهْ","يَ لِغَيْرِهَا تَسْعَى وَتَجْنِي",12,"ن",2,0],["وَيُكَاتِمُ النَّاسَ الَّذِي فِي صَدْرِه","وَمِنَ القُوَى مَا نِيطَ بِالكِتْمَانِ",13,"ن",1,0],["وَيَكُونُ يَوْمَئِذٍ شِفَاءُ غَلِيلِهَا","وَمَتَاعُهَا وَفَنَاؤُهَا فِي آنِ",14,"ن",1,0],["وَيَكُونُ أَبْدَعَ صُورَةٍ رَمْزِيَّةٍ","لِجِهَادِكُمْ تَمْثَالُ سَعْدِ يُقَامُ",15,"م",1,0],["ويكون المُعَزّ غير مّعَزاً","ويكون المُهان غير مهان",16,"ن",1,0],["ويك إن الإسلام أوجد فينا","وحدة مثل وحدة الرحمن",16,"ن",1,0],["ويكون مَنظرُه الرهيب مُمَهّداً","لمُشاهديه إلى الصلاح طريقا",17,"ق",2,0],["ويك إن المعقول ما صحّ عندي","فمتى صحّ عندك المنقول",18,"ل",1,0],["وَيَكفي خَزيرُ المِرجَلَينِ مُجاشِعاً","إِذا ما السَرايا حَسَّ رَكضاً مُغيرُها",19,"ر",3,0],["وَيُكَلِّلونَ إِذا الرِياحُ تَناوَحَت","خُلُجاً تُمَدُّ شَوارِعاً أَيتامُها",20,"م",3,0],["ويكتب بالنصال غداة روع","سطوراً ما لأحرفها هجاء",21,"ا",2,0],["ويكاد الدمع يهمي عابثا","ببقايا ….. كبرياء ….. الألم",22,"م",1,0],["ويكْفيه إن خانَ الشهادةَ خائنٌ","بما اسْتَشْهَدَتْ آثارُه من شُهُودها",23,"د",3,0],["ويَكُدُّ الموضعَ المس","كين بالتكرير كَدَّا",24,"د",2,0],["ويكدُّ الجثمانَ والروحَ والجا","هَ طويلاً ولا يرى الكدَّ كدّا",25,"د",2,0],["ويكشف أعقابَ الأمور صدورُها","له فيراها غائباً كمشاهدِ",26,"د",1,0],["ويكتنَّان بالأكوا","خ والرمضاء كالجمر",27,"ر",1,0],["ويك يا واسطيُ فاسمع مقالي","ونصيحي فلستُ بالغشَّاش",28,"ش",1,0],["ويك يا عائب الحبيب لتسلى","عنه مهلاً طلبت أحوى عقوقا",29,"ق",2,0],["ويكتهلُ الشبانُ تحت ظلالها","وتهرَم أجيالٌ عليها وأجيالُ",30,"ل",1,0],["ويكتمُ عُرفَهُ فيفوحُ منه","وليس لساطع المسكِ اكتتامُ",31,"م",1,0],["ويك يا بيْنُ أيُّ قَرن عليه","ليتَ للبيهقي عَقْلاً بوزنِه",32,"ن",2,0],["وَيَكونُ ما يَرجوهُ زَورَةَ صاحِبٍ","وَيَكونُ أَبعَدَ ما يُرَجّي في غَدِ",33,"د",1,0],["وَيَكونُ أَقصَرَ ما يَكونُ إِذا الفَتى","مَدَّت لَهُ الدُنيا يَدَ المُتَوَدِّدِ",33,"د",1,0],["وَيكَ صاحَت وَدَمعُها","كَجُمانٍ مُبَدَّدِ",34,"د",1,0],["وَيَكفيكَ مِنّي ما قَد رَأَي","تَ فَلَيسَ العِيانُ كَمِثلِ الخَبَر",35,"ر",1,0],["وَيَكفيكَ أَنَّ الكامِلَ النَدبَ مِنهُمُ","وَيَكفيكَهُم هَذا هُوَ المَجدُ وَالفَخرُ",36,"ر",1,0],["ويكونُ مركبُكِ القَعودَ وحدجَهُ","وابنُ النعامةِ يومَ ذلكَ مَركَبي",37,"ي",1,0],["ويكون الكذب أجدى","ان سيف الكذب ماض",38,"ض",1,0],["ويكاد نسر الموت وهو محلق","ينقض مندفعا علي بمخلب",39,"ب",1,0],["ويكشف الحق ان","الحق عن العين احتجب",40,"ب",1,0],["ويكاد قارئه لكل عبارة","يزداد إِنسانية وتمدنا",41,"ن",2,0],["ويكفله موشَّى البر","د يوم الفخر مُعلَمه",42,"م",2,0],["وَيَكادُ مِن سِحرِ البَلاغَةِ تَحتَهُ","عودُ المَنابِرِ يُستَخَفُّ فَيورِقُ",43,"ق",1,0],["وَيَكادُ مِن طَرَبٍ لِعادَتِهِ النَدى","يَنسَلُّ لِلفُقَراءِ مِن أَثوابِه",44,"ب",2,0],["وَيُكَبُّ طاغوتُ الأُمورِ لِوَجهِهِ","مُتَحَطِّمَ الأَصنامِ وَالأَشباحِ",45,"ح",1,0],["ويُكَبِّرونَ بِأَنْ قُتِلْتَ وإنّما","قَتَلوا بكَ التّكْبيرَ والتّهْليلاَ",46,"ل",2,0],["وَيَكبُرُ أَن تَقذى بِشَيءٍ جُفونُهُ","إِذا ما رَأَتهُ خَلَّةٌ بِكَ فَرَّت",47,"ت",1,0],["وَيَكذِبُ ما أَذلَلتُهُ بِهِجائِهِ","لَقَد كانَ مِن قَبلِ الهِجاءِ ذَليلا",48,"ل",2,0],["وَيَكفيكَ مِن فَضلِ الدَنانيرِ أَنَّها","إِذا جُعِلَت في الزادِ ثانِيَةُ التَقوى",49,"و",2,0],["وَيَكفي الفَتى مِن نُصحِهِ وَوَفائِهِ","تَمَنّيهِ أَن يَردى وَيَسلَمَ صاحِبُه",50,"ب",2,0],["وَيُكدي مِنَ الحاجاتِ أَقرَبُها مَدىً","عَلى ظَنِّ باغيها وَأَوضَحُها نَهجا",51,"ج",2,0],["وَيَكسُدُ مِثلي وَهوَ تاجِرُ سُؤدَدٍ","يَبيعُ ثَميناتِ المَكارِمِ وَالحَمدِ",52,"د",1,0],["وَيَكفيكَ مِن حَقِّ تَخَيُّلُ باطِلٍ","تُرَدُّ بِهِ نَفسُ اللَهيفِ فَتَرجَعُ",53,"ع",1,0],["وَيَكفي مِنَ الرُمحِ المُبِرِّ بِطولِهِ","بَلاغُ الحِمامِ مِن سِنانٍ وَعامِلِ",54,"ل",1,0],["وَيَكلَفُ الوَجهُ مِنهُ حينَ يَفقِدُها","كَأَنّهُ لِاِربِدادِ الوَجهِ فَحّامُ",55,"م",1,0],["وَيُكَلِّفونَ أَباعِراً ذَهَبَت","جِيَفاً بَلينَ تَقادُمَ العَصرِ",56,"ر",1,0],["ويكاد ماء بهائه","في وجنتيه ينهمل",57,"ل",1,0],["ويَكُرُّ مَطرورَ السِّنانِ كأنه","قمرٌ يطارِدُ في العَجاجةِ كَوكَبا",58,"ب",2,0],["وَيكَ أَنّى لَكَ الجُزارَةُ وَالحُم","قُ أَجِبني وَأَنتَ في ذاكَ جُندي",59,"د",2,0],["وَيَكادُ يَخرُجُ سرعةً من ظِلِّهِ","لو كان يرْغبُ في فراق رفيق",60,"ق",1,0],["ويكلأ ذِمْرٌ على ضامرٍ","خبِيئَةَ خِدرٍ على عِرْمِسِ",61,"س",1,0],["وَيكَ سَلِّم لِلواحِدِ الخَلّاقِ","إِنَّ في الحَلقِ قائِداً لِلحُلاقِ",62,"ق",1,1],["ويكَ يا قلبَها بعلمِ وفاءٍ","منهُ إنَّ الوفاءَ أحصنُ سورِ",63,"ر",1,0],["وَيَكادُ الحَجلُ مِن غَصَصٍ","حينَ يَستَأنيهِ يَنكَسِرُ",64,"ر",1,0],["وَيَكادُ العَجزُ إِن نَهَضَت","بَعدَ طولِ البُهرِ يَنبَتِرُ",64,"ر",1,0],["وَيَكفي فَيَكفَلُ في حالَةٍ","فَيَبني المعالي كَفى أَو كَفَل",65,"ل",1,0],["وَيَكتُبُ وَالخَطبُ مُستَفحِلٌ","فَيَدفَعُ في صَدرِ ماقَد أَهَم",66,"م",1,0],["وَيكِ طالَت بِنا بُلَهنِيَةُ العَي","شِ فَمُتنا سَآمَةً وَمَلالا",67,"ل",2,0],["وَيْكَ عبدَ اللهِ ماذا تَبتغِي","تَعِبَ الشَّرُّ ولمَّا تتعبِ",68,"ب",1,0],["وَيَكلأها بِالنَشاط العَجيب","وَلِلدَهر في الناس شَأن عَجيب",69,"ب",1,0],["ويكاد يقلقني الأّمير بقوله","كاد المعلم أن يكون رسولا",70,"ل",2,0],["وَيَكَدنَ يَخلَعنَ الجُلو","دَ لِشِدَّةِ الرَوعاتِ",71,"ت",1,0],["ويُكسِبُ الغيْظُ مُقْلَتَيَّ وخَد","ديَّ احْمِراراً كنامر القِرْبَهْ",72,"ب",2,0],["ويكادُ يَخفَى عن بَناتِ ضميرِهِ","مكتومُ ما هو مُبتَغٍ ومحاول",73,"ل",1,0],["ويكادُ يَلقاهم على أفواهِهِمْ","قبلَ السَّماع الرّشْفُ والتّقبيل",74,"ل",1,0],["ويَكادُ فُولاذُ الحَديدِ معَ ال","مُهَجاتِ والعَبَراتِ يَبتَدِرُ",75,"ر",1,0],["ويكلّفُ الأرْماحَ لِينَ قوامِهِ","فيذمُّ ذا يَزَنٍ ويَظلِمُ قَعْضَبا",76,"ب",2,0],["وَيكَ إِنَّ الحُبَّ لَم يَم","لِك سِوى رِقِّيَ رِقّا",77,"ق",2,0],["وَيَكُنَّ النِساءُ بيضاً وَأُدماً","صيغَةً بَعدَ صيغَةِ الأَترابِ",78,"ب",1,0],["وَيَكادُ يُظلَمُ حينَ يُغشى بَيتُهُ","مِن لينِ جانِبِهِ وَلَينَ حِجابِهِ",79,"ب",2,0],["وَيَكادُ يَنزِعُ جِلدَ مَن يُصلى بِهِ","بِلَوافِحٍ مِثلِ السَعيرِ الموقَدِ",80,"د",1,0],["وَيَكونَ لِلبادينَ عَذبُ مِياهِهِ","مِثلَ المُدامَةِ لا تَحِلُّ لِوارِدِ",81,"د",1,0],["وَيَكُرُّ مِن جَيشِ القَضاءِ مُسَلَّطٌ","ثَورٌ وَشابَةُ تَحتَهُ خَوّارُ",82,"ر",1,0],["وَيَكونُ لِلزُهرِ الطَوالِعِ مُنتَهىً","يَذوَينَ فيهِ كَما ذَوى النُوّارُ",83,"ر",1,0],["وَيَكونُ غَيرَ مُصَدِّقٍ بِقِيامَةٍ","أَمسى يُمَثِّلُ في النُفوسِ ذُهولَها",84,"ل",3,0],["وَيَكفيكَ التَقَنُّعُ مِن قَريبٍ","عَظائِمَ لَيسَ تُبلَغُ بِالتَوَنّي",85,"ي",1,0],["ويُكْنَى باسْمِهِ عن كلّ مجْدٍ","وكلُّ اسْمٍ كِنايَتُهُ فُلانُ",86,"ن",1,0],["وَيَكفي المَقالَةَ أَهلَ الرِج","لِ غَيرَ مَعيبٍ وَلا عائِبِ",87,"ب",1,0],["ويكرُمُ مَن لم يَعْرِف الجودَ كَفُّه","ويحلُمُ عند الغيظ مَن لا لهُ حِلم",88,"م",1,0],["ويكدر ماء الشعر بعد صفائه","ويصفو لمن يُعْنَى به بعد أكدار",89,"ر",1,0],["وَيك نَفسي إن السعادة خودٌ","لا تَزور العشاق غير لمام",90,"م",1,0],["ويكبر أن تقذى بشيءٍ عيونه","إذا ما رأته خلّةٌ بك فرّت",91,"ت",1,0],["ويك يا بحرُ ما أنينك في ال","لَيل أنينَ المرَّوع الهيّابِ",92,"ب",1,0],["ويكَ دَعْنا نمرحْ بأجملِ أيا","مٍ ونلقى من بعد خوفٍ أمانكْ",93,"ك",1,0],["ويك قل لي أليسَ نملك يوماً","أن نراها أما تبينُ خطاها",93,"ه",2,0],["ويكِ لا تنظري إلى قدَحي","نظرَاتِ الغريبِ واقتربي",94,"ي",1,0],["ويكاد من بَهَج يضيءُ سِراجَه","وجهٌ عليه من الطهارةِ رَونقُ",95,"ق",1,0],["وَيَكونُ يَومٌ لا أَرى لَكِ مُرسَلاً","أَو نَلتَقي فيهِ عَلَي كَأَشهُرِ",96,"ر",1,0],["ويَكادُ الخَيْفانُ يَنزِلُ في القَيْ","ظِ عليها سآمَةً أنْ تَطيرا",97,"ر",2,0],["ويُكْني شهيدُ المَرْءِ غيرِكَ هَيْبَةً","وبُقْيا وإنْ يُسألْ شهيدُكَ لا يكني",98,"ن",2,0],["وَيَكَادُ بَحْرُ الآلِ فِي أَطْرَافِهَا","يَشْجُو السَّمَاعَ بِمَوْجِهِ الْهَدَّادِ",99,"د",1,0],["وَيَكَادُ يُلمَسُ فِيهِ مَشْهُودُ الرُّؤى","وَيُحَسُّ هَمْسُ الظَّنِّ في الحَوْبَاءِ",100,"ا",2,0],["وَيكْسِبُهَا مَعْنَى الحَيَاةِ ذُبُولُهَا","لَدَى نَاظِرِيهَا فَهْيَ فِي النَّفْسِ أَجْمَلُ",101,"ل",1,0],["وَيَكَادُ شَاهِدُ حُسْنِهَا وَكَمَالِهَا","بِالشِّعْرِ يَنْطُقُ وَهْوَ لَيْسَ بِشَاعِرِ",102,"ر",1,0],["وَيَكُونُ أَوَّلُ مَنْ يُلِبِّي إِنْ دَعَا","دَاعِي الْعُلَى فِي الْفِتْيَةِ الامْجَادِ",103,"د",1,0],["وَيُكَلِّلُونَكِ بِالنِّصالِ تَشابَكَتْ","كَمِظَلَّةٍ صُنِعَتْ مِنَ الأنْوَارِ",104,"ر",1,0],["وَيَكَونُ يَوْمَ السِّلْمِ خَيْرَ مَسَالِمٍ","ويَكُونُ يَوْمَ الْحَرْبِ خَيْرَ مُحَارِبِ",105,"ب",1,0],["وَيَكُونُ المِثَالُ فِيمَا تَوَلَّى","تُبَّعاً أَوْ تَخَيُّراً وَانْتِدَابَا",106,"ب",2,0],["وَيَكفي المَقالَةَ أَهلَ الرِجا","لِ غَيرَ مَعيبٍ وَلا عائِبِ",107,"ب",1,0],["ويكاد يحمله، لما تركت","منه الصبابة، مخلب الصرد",108,"د",1,0],["وَيَكادُ جامِحُهُ يُثَقِّفُ في الطُلى","بِالطَعنِ أَطرافَ القَنا المُنآدِ",109,"د",1,0],["وَيَكادُ يهدي لِلمُؤدّب نَفسه","مُستَجلِياً لِهُداهُ بِالإِهداءِ",110,"ا",2,0],["وَيكُم بَياضُ الصُبحِ أَحسَنُ مَنظَراً","في العَينِ مِن ظَلماءِ لَيلٍ أَليَلِ",111,"ل",1,0],["ويكاد سامعه يفسّر لفظه","من قبل أن يسري إلى آذانهِ",112,"ن",2,0],["ويكفيك أنْ تدعو أبا الطبِّ باسمِهِ","فإنَّ العُلا صارتْ له لَقَباً واسما",113,"م",2,0],["وَيْكَ لا تَجْزَعْ لِنازِلَةٍ","ما لِطَيْرِ الْجَوِّ مِنْ وَطَن",114,"ن",1,0],["وَيْكَ يا قَبْرُ صِرْتَ لِلْفَضْل مَثْوىً","لا يُسَامَى ولِلنُّبُوغِ مَقِيلاَ",115,"ل",2,0],["وَيَكْشِفُ الأَمَلَ الْمَحْجُوبَ سَاطِعُهُ","وَالْيأْسُ تَغْشَى بأَسْدافٍ وَأسْتَارِ",116,"ر",1,0],["ويكفيكما الله شرَّ البكاء","ويحفظ من وقعه أذنيا",117,"ي",2,0],["ويكاد يَصهَرُهُ الدخا","نُ كأنما هو من جليد",118,"د",1,0],["ويكاد يسلخ نفسه من قومه","لو تستطاع قطيعة الأرحام",119,"م",1,0],["ويكاد يمسخ خلقه، لو كان في","يمناه قَلْبُ معالم الأجسام",119,"م",1,0],["ويكرُع قوم عتيق المُدامِ","وقومُ إلى كأس ماءٍ ظِماء؟",120,"ا",2,0],["ويكادُ يحسبُها الجريحُ بجسمه","ثَغرًا؛ فيومئُ نحوَها تقبيلا",121,"ل",2,0],["ويكاد الصمت يروي حبّنا","قصّة لو طاوع الصمت الكلام",122,"م",1,0],["ويكرهُ منه الحلوُ وهو عصيرُ","فَوَلَّوْا وَسوءُ الظَّنِّ يَلوِي وُجُوُهَهمْ",123,"م",1,0],["ويُكسبُ الغيظُ مقلتيَّ وحدَّ","يَّ احمرارً كزامرِ القربه",124,"ب",2,0],["ويكون الحقُ – ما بينهما -","باطلاً والطالحون الصلحاء",125,"ا",2,0],["ويكاد اللبيبُ يلمُسُ حباتِ","قلوبٍ على نِقاط الحُروف",126,"ف",1,0],["ويكُبُّ جباراً ، ويُعلي مُدقعاً","ويُنيرُ خابطةً ، ويُنهضُ راقدا",127,"د",2,0],["ويكادُ يشهَق بالعَويل بَلاطُه","ويَصيحُ بالألم الدفينِ رُخام",128,"م",1,0],["ويكفيكَ منه ساعةٌ لاختباره","لتعلمَ منها أنه لم يزل غِرّا",129,"ر",2,0],["وَيَكْفيكَ في فَضْلِ الدّنانيرِ أنّهَا،","إذا جُعلَتْ في الزّادِ، ثانيَةُ التّقوى",130,"و",2,0],["ويكدُّ الجثمانَ والروحَ والجا","هَ طويلاً ولا يرى الكدَّا كدّا",131,"د",2,0],["وَيَكْذِبُ مِنْهَا الحَاجِبُ المُتَحَدِّبُ","وَيَكْذِبُ فِيهَا قَلْبُهَا المُتَقَلِّبُ",132,"ب",1,0],["وَيَكْذِبُ مِنْ بُعْدٍ شَذَاهَا المُطَيَّبُ","عَلَى غَيْرِ مَا ظَنَّتْ بِهَا النَّاسُ مِنْ قَبْلِ",132,"ل",1,0]]}