{"poems":[[63,"هم صرموا حبل الهوى فتصرما","https://www.aldiwan.net/poem51445.html","الطويل"],[369,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[369,"ألم يأن يا صاح أم قد أنى","https://www.aldiwan.net/poem61009.html","المتقارب"],[487,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45765","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110059","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77007","الطويل"],[5038,"دعي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=189377",""],[5038,"تسائلني","https://www.poetsgate.com/ViewPoem.aspx?id=189580",""]],"verses":[["فلو ضَمَّهُ بينَ السَّماكَيْنَ مَعْقِلٌ","ودافعَ عنه الحَينُ لم يَنْجُ مِنهُما",0,"م",2,0],["فلو ضَلَّ الكَرى في جُنحِ لَيلٍ","هدَوْهُ إلى النّواظرِ بالنِّبال",1,"ل",1,0],["فلو ضافَه كُلُّ وَحْشِ الفلاة","تَكَفّلَ صَمصامُه بالقِرى",2,"ا",1,0],["فلو ضمنا في مرصد الحكم مجلس","لكانت عليه كرة من فتاتان",3,"ن",1,0],["فَلَو ضَرَبَ الصَمصام صَفحاً مصمما","عَلى العَفو قامَ الرُمح حَتّى تَقَصَدا",4,"د",2,0],["فلو ضاءَ ليلاً لاستنارَ دُجونُهُ","واشعر في مالم يُبنهُ العوالمُ",5,"م",1,0],["فَلَو ضاعَ حِلس في الفَلا مِن مُسالِم","أَتاهُ بِهِ مَن غابَ ضاري الضَراغِم",6,"م",1,0],["فلوْ ضاءتْ شموعٌ مِنْ رحيقي","لما ذاقتْ لَمى ورْدي الْعذابا",7,"ب",2,0],["فَلَو ضاقَتْ بِيَ الدّنْيا عُصوراً","أَرى قَلْبي يَسيرُ عَلى خُطاها",8,"ا",3,0]]}