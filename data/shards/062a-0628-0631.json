1],["تبرّجت لك الشفوف دلّها","يا من رأى تبرّج الشفوف",39,"ف",1,0],["تبرأت في دنياك من كلّ ناكث","ذليل فلا عرف لديه ولا نكر",40,"ر",1,0],["تبرّج للصحراء قبل انسكابه","فلو كان للصحراء ريق تحلّبا",41,"ب",2,0],["تبرّجت للشذى الأعلى مجامرنا","وزيّنت للهوى الأغلى خفايانا",42,"ن",2,0],["تبرقُ بالليل بريقَ الطِّسْتِ","صبَّحها اللَّهُ بقفدٍ سَخْتِ",43,"ت",1,0],["تبرَّضَ الجسمَ بعد القلب بارضه","وآضَهُ حرضاً وجاءه دأضا",44,"ض",2,0],["تُبِرُّ عَلَيهِ بِالجَمالِ إِذا أَتى","وَتَخلُفُهُ في ذا الأَنامِ إِذا اِنكَفا",45,"ف",2,0],["تبرّا مما قلتموه جميعه","بحمد إله العالمين وبالشكر",46,"ر",1,0],["تَبْرُقُ العينُ بضوءٍ آسرٍ","كوميضِ النجمِ في ثغْرِ المسا",47,"س",2,0],["تبرعتَ بالإحسانِ للناسِ كلِّهم","فحبُّك في سِرِّ القلوب صَريح",48,"ح",1,0],["تبرمي بالحياة بينهم","تبرّم المستحير عن صخر",49,"ر",1,0],["تبريّةُ اللونِ مثل الغصن قد لبستْ","ثوبَ الردى معرضاً في موقف الجذلِ",50,"ل",1,1],["تبرقعت برداء الحسن واتشحت","بحندس الشعر واستغنت عن الخمر",51,"ر",1,0],["تبرقعت برداء الحسن واتشعت","بحندس الشعر واستغنت عن الخمر",52,"ر",1,0],["تَبَرَّمُ النفِس من بلابلها","يُفْسد إقرارَها ودعواها",53,"ا",3,0],["تَبَرَّعتَ بِوَعدٍ مِن","كَ لَم يَجرِ عَلى ظَنّي",54,"ن",2,0],["تَبرا مِنَ اللفظِ الرَكيكِ","إِلَيكَ وَالنَظمِ السَخيفِ",55,"ف",1,0],["تَبَرَّأَتْ وَقْدْ غَثَتْ","أَنْفُسُهَا الْمَلْعُو نَهْ",56,"ن",2,0],["تبرّع لله العلي جنابه","فأبدع بالأفضال من كل جانب",57,"ب",1,1],["تَبرُّجُها وزَبرَجُها خِداعٌ","لِكي تُذكي العواطفَ والشُّرُورا",58,"ر",2,0],["تَبَرَّأَ مِنِّي وَيَحِيَ النَّظمُ والنّثْرُ","فَلا خُطْبةٌ مِما أُجيدُ ولا الشعْرُ",59,"ر",1,1],["تَبَرّجَ أو تَبَلَّج فاشرَأَبَّتْ","لبَهجَتِهِ القُلوبُ مِن الصّديرِ",60,"ر",1,0],["تبرجتا بنفْضٍ من سوادٍ","عَلَى أَعطافِ حلةِ أَرجوانِ",61,"ن",1,0],["تبرأت من حولي ولا حول دونه","ومن قوتي لو أن لي قوّةً أبرا",62,"ر",2,0],["تَبْرِي أناملُه الأظفارَ من قَصَبٍ","مقوِّماً من قناةِ الدّولةِ الأَوَدا",63,"د",2,0],["تَبرقَعَ بالبدرِ المُنيرِ جَبينُه","ويَرفُل في لّيلٍ بِعطْفَيهِ مُدَّج",64,"ج",1,0],["تبرأت العدالة من بنيها","كما يتبرأ العهد الجديد",65,"د",1,0