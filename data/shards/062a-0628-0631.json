61861",""],[5952,"ذروني و(مايا)","https://www.poetsgate.com/ViewPoem.aspx?id=204387",""],[6052,"أبواب النفوس","https://www.poetsgate.com/ViewPoem.aspx?id=34966",""],[6082,"في مرسمي","https://www.poetsgate.com/ViewPoem.aspx?id=58992",""],[6115,"الذيب يأخذ صيدته بذراعه","https://www.poetsgate.com/ViewPoem.aspx?id=180785",""],[6117,"سِفْر ُالأحَادِيْثِ وَنَبْعُ الْفَضَائِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=182797",""],[4035,"في صباه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1524&r=&rc=7",""],[6300,"الأعْيُنُ النُجُل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81627&r=&rc=4",""],[147,"تَخَلَّفَ عَنْهُ الصَّبْرُ فِيمَنْ تَخَلَّفا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27442&r=&rc=9",""]],"verses":[["تَبَرَّجَت مِنكَ وُجوهُ المُنى","مُرتَجَّةً في النائِلِ الغَمرِ",0,"ر",1,0],["تبرَّعَ بالمَعْروفِ قبلَ سؤالِهِ","فلمْ يَبْسُطِ العافي لِساناً ولا يَدا",1,"د",2,0],["تَبَرَّعَ بالمعْروفِ حتّى كأنّهُ","يَعُدُّ اقْتِناءَ المالِ إحْدى المَثالِبِ",2,"ب",1,0],["تبَرَّمَتِ الأجفانُ بَعدَكِ بِالكَرى","فَلا تَلتَقي أو نَلْتقي ولها العُذْرُ",3,"ر",1,0],["تَبَرّأَتِ مِمّا بي وَأَنتِ حَبيبَةٌ","وَعوفيتِ مِمّا شَفَّني فَاِحمِدي الرَبّا",4,"ب",2,0],["تُبرُّ عَلَى الْمُدَّاحِ غُرُّ خِلاَلِهِ","وَمَا رَسَمُوا فَوْقَ الطُّرُوسِ وَمَا خَطُّوا",5,"ط",3,0],["تَبري لَهُ هِقلَةٌ خَرجاءُ تَحسَبُها","في الآَلِ مَخلولَةً في قَرطَفٍ شَرَفا",6,"ف",2,0],["تُبَرَّكُ بِالسَهلِ الفَضاءِ وَتَتَّقي","عُداها بِرَأسٍ مِن تَميمٍ عَرَمرَمِ",7,"م",1,0],["تَبري لَهُ صَعلَةٌ خَرجاءُ خاضِعَةٌ","فَالخَرقُ دونَ بَناتِ البَيضِ مُنتَهَبُ",8,"ب",1,0],["تَبَرُّعُ التحفةِ زَيْنٌ لها","وعيبُها الفاحشُ أن تُخْطبا",9,"ب",2,0],["تبرجت بعد حياءٍ وخفر","تبرُّجَ الأُنثى تصدّت للذكر",10,"ر",1,0],["تَبَرَّأُ مِن دَمِّ القَتيلِ وَبَزِّهِ","وَقَد عَلِقَت دَمَّ القَتيلِ إِزارُها",11,"ر",3,0],["تَبَرَّمَتْ بينيَ الدُّنيا وأَعوَزَها","في مِعزفِ الدَّهرِ غرِّيدُ الأَرانينِ",12,"ن",1,0],["تَبَرَّمْتَ بالعيشِ خوفَ الفناءِ","ولو دُمْتُ حيًّا سَئمتَ الخلودْ",13,"د",1,0],["تَبَرَّأَ عيسى مِنهُمُ و