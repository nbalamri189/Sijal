{"poems":[[95,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54941","الكامل"],[567,"شوقي إليك كما علمت طويل","https://www.aldiwan.net/poem52957.html","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125362","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69412","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204734","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97917","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52981","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103007","الكامل"],[4712,"تناسخ الألواح","https://www.poetsgate.com/ViewPoem.aspx?id=203057",""],[4999,"غداً سنلتقي","https://www.poetsgate.com/ViewPoem.aspx?id=184278",""],[5009,"الملحمة النونية","https://www.poetsgate.com/ViewPoem.aspx?id=24368",""],[5431,"إقرأ ....","https://www.poetsgate.com/ViewPoem.aspx?id=206810",""],[5431,"قصيدة وجودية ...","https://www.poetsgate.com/ViewPoem.aspx?id=207830",""],[5459,"هامة الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=204331",""],[5512,"عجاف الدَّهر ( أنا الشَّام )","https://www.poetsgate.com/ViewPoem.aspx?id=204281",""],[5605,"دنيا محبتنا","https://www.poetsgate.com/ViewPoem.aspx?id=159349",""],[5770,"يبكي ويضحك","https://www.poetsgate.com/ViewPoem.aspx?id=178252",""],[402,"يا صورة شبهت صخرا بإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=36833",""],[5956,"مودة ورحمة","https://www.poetsgate.com/ViewPoem.aspx?id=182435",""],[5956,"بصخرِ العز","https://www.poetsgate.com/ViewPoem.aspx?id=192333",""],[5956,"حسناتكم مع ربكم","https://www.poetsgate.com/ViewPoem.aspx?id=194225",""],[5956,"خذني إلهي نحو تركي","https://www.poetsgate.com/ViewPoem.aspx?id=194401",""],[5956,"حلُمٌ جميل لا أنساه","https://www.poetsgate.com/ViewPoem.aspx?id=194563",""],[5956,"الله أكبر سوف يُرجع عزمكم","https://www.poetsgate.com/ViewPoem.aspx?id=194578",""],[5956,"خذني إلهي نحو جُدّة عنده","https://www.poetsgate.com/ViewPoem.aspx?id=194603",""],[5957,"سيزول حزن الانتظار","https://www.poetsgate.com/ViewPoem.aspx?id=176862",""],[6030,"أهرب منّي إليك","https://www.poetsgate.com/ViewPoem.aspx?id=196940",""],[6093,"الفَنْقَلَة","https://www.poetsgate.com/ViewPoem.aspx?id=204921",""],[6125,"لأنَّ سواكِ لنْ يَحظَىٰ بِقَلبِي","https://www.poetsgate.com/ViewPoem.aspx?id=208755",""]],"verses":[["سِيزُسْتُريسُ الَّذِي دَانَ العُتَاةُ لَهُ","كِنْ قَوْمِ حِثٍّ وَمِنْ فُرْسٍ وَيُونَانِ",0,"ن",1,0],["سيزجر عنك الدهرَ إن شئت زجرةٌ","يصيخ لها خوفاً ولا يترمرمُ",1,"م",1,0],["سِيزَا فَتاةُ ثَقَافَةٍ وَحِجىً","نَبَغَتْ وَمَا أَنْدَادِهَا كُثْرُ",2,"ر",1,0],["سَيَزُولُ سُقمٌ مثلَ عافيةٍ مَضَتْ","إذ كلُّ ما تحتَ السماءِ يزُولُ",3,"ل",1,0],["سيزوستر يسُ اليوم عهدٌ غير ذا","ك العهدِ إذ ضاءت به الأفهامُ",4,"م",1,0],["سَيَزدادُ غَيظَاً كُلَّما مَدَّ باعَهُ","فَقَصَّرَ عَن إِدراكِ ما أَنا نائِلُه",5,"ل",2,0],["سيزول كل الملك من هذي الدنى","إلا الجمال المالك المتجبر",6,"ر",1,0],["سيزيحه الرحمن عنا إنما","شر المصائب في الوباء الأحمر",7,"ر",1,0],["سيزوستريس لقد أقام شئونها","وهو الذي أعطى لها قانونها",8,"ه",2,0],["سيزول شيب الدهر مثل شبابه","وستضمحل أواخر كأوال",9,"ل",1,0],["\"سيزيف\"، إنّ الصّخرَ أثقَلَ كاهلي","\"سيزيف\"، ما للصّخرِ لا ينزاحُ؟!",10,"ح",1,0],["سيزورنا فرحٌ وصبحٌ مشرقٌ","وسيلتقي بعد الفِراق الاصدقا.",11,"ق",2,0],["سيزول حكمك يا ظلوم كما انقضت","دول أولات عساكر وحصون",12,"ن",1,0],["سيزيف أنت فلا تقف إن باغتت","قمم الجبال تدحرجت ..لتعاودا",13,"د",2,0],["سيزيف لم يترك محاولةً","إلا وكان لمجده الأسبق",14,"ق",1,0],["سيزهَق مهما طالَ ما كان باطلاً","ويُبهَتُ بالحَق امرؤٌ متشائمُ ..",15,"م",1,0],["سيزهرُ في شراييني ربيعٌ","ويحلو في شجيراتي ثماري",16,"ر",2,0],["سيزهر الوصل في دنيَا محبتنا","إذا التقينا وطاب الوجد يوم غَد",17,"د",1,0],["\"سيزيف\" أورثه همّا وصخرته","يعاند الموج والتيار إن سبحا",18,"ح",2,0],["سيزستريس الذي دان العتاة له","من قوم حث ومن فرس ويونان",19,"ن",1,0],["سيزيد وعيي كي أعي حسناتِهَا","وأزيد تثقيفي لأفهم عقلها",20,"ل",3,0],["سيزول حب الغصب عنك فترجعي","لحبيبك الشرعي أطيب منهلِ",21,"ل",1,0],["سيزول همُّكَ حين تشهد خائفاً","أنقذتَه من أفدحِ الأخطارِ",22,"ر",1,1],["سيزول وعيي كي يزول تألمي","أنا لم أكن متبسماً لولاهُ..",23,"ا",2,0],["سيزورني في كل آنٍ حاملاً","في أصغريه وداده وسمَاحََهُ",24,"ح",2,0],["سيزول عنك السّقْم مدحور القوى","ويزول عنك الغمُّ والإيهانُ",25,"ن",1,0],["سيزول وعيي كي يزول تألمي","أنا لم أكن متميزاً لولاهُ..",26,"ا",2,0],["سيزول حزن الانتظار","فالليل يعقبه النهار",27,"ر",1,1],["سيزيف يغتاله الجلمود فلسفة","مذ قام يعزف آهات بدون صدى",28,"د",2,0],["سَيزيلُ تدليسَ السؤالِ ذكاؤهُ","ويُعيدُ تشكيلَ الإجابةِ أسئلةْ",29,"ل",2,0],["سَيَزهو حبُّنا رَغمَ المَآسِي","ويُثبتُ حبُّنا الأنْقَىٰ شَبَابَهْ",30,"ب",2,0]]}