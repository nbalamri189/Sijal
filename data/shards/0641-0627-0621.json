{"poems":[[48,"فاء لك الحلم فاله عن رشإ","https://www.aldiwan.net/poem22993.html","المنسرح"],[92,"اندونيسيا المجاهدة","https://www.poetsgate.com/ViewPoem.aspx?id=179216",""],[202,"ألف ألا انعم بالمحبة حالا","https://www.aldiwan.net/poem51903.html","الكامل"],[280,"غزو على النصر والتمكين منشؤه","https://www.aldiwan.net/poem25646.html","البسيط"],[310,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[396,"فاء الفتاة سقاني","https://www.aldiwan.net/poem54705.html","المجتث"],[487,"فاء الفقير فكاكه من أسره","https://www.aldiwan.net/poem24418.html","عموديه"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108989","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53115","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88644","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74204","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110003","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35073","الكامل"],[3464,"ألفٌ أمعاني من يذكرْ","https://www.poetsgate.com/ViewPoem.aspx?id=158742",""],[5121,"هَذَا أَبِي","https://www.poetsgate.com/ViewPoem.aspx?id=33665",""],[5449,"فاءٌ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=188821",""]],"verses":[["فاءَ لَكَ الحِلمُ فَاِلهَ عَن رَشَإٍ","خالَطَ مِنهُ عَرفُ المُدامَةِ فا",0,"ف",2,1],["فاءت على المستعمرينَ ظلالُها","وعلى مليكاتٍ لهم ومُلوك",1,"ك",1,0],["فاء فريد الحسن منه يزيده","باللحظ تكرير العيون صقالا",2,"ل",2,0],["فَاءَتْ بدولَتكَ الدُّنيا لِزِينَتِها","فدامَ ظِلُّك مأموناً تَفَيُّؤُهُ",3,"ا",2,0],["فاءَت إِلى الحُسنى فإِن تكُ أسلفت","ذَنباً فَموهوبٌ لها مغفورُ",4,"ر",1,0],["فَاءُ الفَتَاةِ سَقَاني","دَمعِىَ أحمَرَ قَانِ",5,"ن",1,1],["فاء الفقير فكاكه من أسره","والقاف قوّة جده في سيره",6,"ر",2,1],["فاءت لسورافيم والدها الذي","شادت له دار النعيم قبابها",7,"ب",3,0],["فاء على مثنه فخلنا","ماويّة مسها غبار",8,"ر",1,0],["فاءَت وَهَل علمت ماذا تفئى به","اعلام سود قد ابيضت بها مقلي",9,"ل",2,0],["فاء الفَلاح وَقاف قُرب قَد سَما","كاف الكِفاية لام كُل وَلاء",10,"ا",2,0],["فاءت على أدبارِها وتماسكت","عن جَريها ومن العجائبِ ان تَفِي",11,"ف",2,0],["فاءَت عَلَيهِ مَعَ الهَجيرَةِ سَرحَةٌ","صَدِئَت لِفَيئَتِها صَفيحَةُ مائِهِ",12,"ا",3,0],["فاءٌ فيه تزهو فطنٌ","حلت عقد العقد الأبهر",13,"ر",1,0],["فَاءَ الْبَوَادِي كَالْمُنَادِي صَادِحاً","غَنَّى بِرَمْلٍ زَاهِرٍ كَيْ يَسْعَدَا",14,"د",2,0],["فاءٌ أنا اسمي فلتهبَّ عواصفٌ","منّي العواصفُ عزمَها تتعلَّمُ",15,"م",1,0],["فاءٌ تأفأفتِ العروبةُ مِنْ دمي","فاءٌ وفاءتْ للخيامِ جهنَّمُ",15,"م",1,0],["فاءٌ لفاطمةٍ وحنظلةٍ أَتَوا","قد عادَ ناجي للمخيَّمِ يَرسُمُ",15,"م",1,0]]}