{"poems":[[46,"فاء لك الحلم فاله عن رشإ","https://www.aldiwan.net/poem22993.html","المنسرح"],[90,"اندونيسيا المجاهدة","https://www.poetsgate.com/ViewPoem.aspx?id=179216",""],[198,"ألف ألا انعم بالمحبة حالا","https://www.aldiwan.net/poem51903.html","الكامل"],[275,"غزو على النصر والتمكين منشؤه","https://www.aldiwan.net/poem25646.html","البسيط"],[305,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[391,"فاء الفتاة سقاني","https://www.aldiwan.net/poem54705.html","المجتث"],[482,"فاء الفقير فكاكه من أسره","https://www.aldiwan.net/poem24418.html","عموديه"]],"verses":[["فاءَ لَكَ الحِلمُ فَاِلهَ عَن رَشَإٍ","خالَطَ مِنهُ عَرفُ المُدامَةِ فا",0,"ف",2,1],["فاءت على المستعمرينَ ظلالُها","وعلى مليكاتٍ لهم ومُلوك",1,"ك",1,0],["فاء فريد الحسن منه يزيده","باللحظ تكرير العيون صقالا",2,"ل",2,0],["فَاءَتْ بدولَتكَ الدُّنيا لِزِينَتِها","فدامَ ظِلُّك مأموناً تَفَيُّؤُهُ",3,"ا",2,0],["فاءَت إِلى الحُسنى فإِن تكُ أسلفت","ذَنباً فَموهوبٌ لها مغفورُ",4,"ر",1,0],["فَاءُ الفَتَاةِ سَقَاني","دَمعِىَ أحمَرَ قَانِ",5,"ن",1,1],["فاء الفقير فكاكه من أسره","والقاف قوّة جده في سيره",6,"ر",2,1]]}