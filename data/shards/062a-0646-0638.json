{"poems":[[55,"لا عادت الكأس عليل النسيم","https://www.aldiwan.net/poem29774.html","السريع"],[55,"بالجد لا بالمساعي يبلغ الشرف","https://www.aldiwan.net/poem29972.html","البسيط"],[90,"قرأت وما غير الطبيعة من سفر","https://www.aldiwan.net/poem45075.html","الطويل"],[74,"كذا أبدا نلتقي كل عيد","https://www.aldiwan.net/poem18600.html","المتقارب"],[53,"تخلفت شنطف فقلنا","https://www.aldiwan.net/poem64013.html","مخلع البسيط"],[53,"أقرِن إلى حسنِ وجهك الحسنِ","https://www.aldiwan.net/poem66526.html","المنسرح"],[87,"سل الليل عن أفلاكه هل جرت سدى","https://www.aldiwan.net/poem7892.html","الطويل"],[30,"كيف نخاف الفقر يا طيب بعدما","https://www.aldiwan.net/poem5151.html","الطويل"],[51,"أتطمع أن تخلد لا أبا لك","https://www.aldiwan.net/poem63044.html","الوافر"],[82,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[107,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85730","الخفيف"],[29,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54522","الخفيف"],[30,"كيف نخاف الفقر يا طيب بعدما","https://www.poetsgate.com/ViewPoem.aspx?id=21608",""],[215,"يا مليك الحسن عزت دولتك","https://www.aldiwan.net/poem46307.html","الرمل"],[228,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[318,"ما بال نفس تطيل شكواها","https://www.aldiwan.net/poem59508.html","المنسرح"],[333,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[369,"من كان فوق سراة المجد معتليا","https://www.aldiwan.net/poem60558.html","البسيط"],[396,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[415,"تنظر العاجز الحظوظ فيستع","https://www.aldiwan.net/poem32043.html","الخفيف"],[438,"ما ضر ذاك الريم ألا يريم","https://www.aldiwan.net/poem12725.html","السريع"],[463,"ما سائر بين الورى دائر","https://www.aldiwan.net/poem56159.html","السريع"],[463,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[469,"نزلنا بمصر وهي أحسن كاعب","https://www.aldiwan.net/poem3117.html","عموديه"],[469,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[505,"للروح من روح ريح الحب ريحان","https://www.aldiwan.net/poem37759.html","البسيط"],[505,"ترفع عن محاورة الأعادي","https://www.aldiwan.net/poem38026.html","الوافر"],[534,"أكؤوس مترعات من عقار","https://www.aldiwan.net/poem37409.html","الرمل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112428","الرمل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34406","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38549","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77616","الرجز"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17008","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126128","الرجز"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69195","المنسرح"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93124","الرمل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128722","الوافر"],[1544,"","https://poetry.dctabudhabi.ae/diwan/poem/111125","الكامل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87865","البسيط"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105431","الرجز"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118361","الطويل"],[2263,"","https://poetry.dctabudhabi.ae/diwan/poem/140235",""],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60955","السريع"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60892","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60821","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93539","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87318","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46739","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202398","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202994","المنسرح"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107071","الخفيف"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53026","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138562",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108032","الخفيف"],[3704,"","https://poetry.dctabudhabi.ae/diwan/poem/146109","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216475","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131077",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135744","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77134","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81285","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81272","المتقارب"],[4297,"","https://poetry.dctabudhabi.ae/diwan/poem/102206","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133137","الكامل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216344",""],[4670,"","https://poetry.dctabudhabi.ae/diwan/poem/143602","الوافر"],[1901,"أنساك ما سَرَّكَ من بُعدِه","https://www.poetsgate.com/ViewPoem.aspx?id=160412",""],[5213,"أعرّست على العذيب العرب","https://www.poetsgate.com/ViewPoem.aspx?id=170410",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[5508,"يا سيّدي قد رمُيتُ من زمني","https://www.poetsgate.com/ViewPoem.aspx?id=110835",""],[5956,"السلام والإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=194894",""],[6001,"بنت العز","https://www.poetsgate.com/ViewPoem.aspx?id=376",""],[2588,"شاخصة (هيئة الأمم)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65613&r=&rc=45",""]],"verses":[["تَنظُرُ في أَثناءِ أَوطانِنا","لِقاحَ جودٍ لِلرَجاءِ العَقيم",0,"م",1,0],["تَنَظَّرِ الصُبحَ إِنَّ الصُبحَ مُنتَظَرٌ","وَالفَجرُ يُعرِبُ عَمّا أَعجَمَ السَدَفُ",1,"ف",1,0],["تنظّمنا الأيام شعراً وإنّما","ترّد المنايا ما نظمن إلى النثر",2,"ر",1,0],["تنظم فيه عقود الثناءِ","وفي البحر يحسن نظم العقود",3,"د",1,0],["تنظر من كوكبي رصاصٍ","في ظهر دوَّامةٍ صغيره",4,"ر",2,0],["تنظر إلى أحسنِ المناظر مق","روناً بأدنى فعالكَ الحسنِ",5,"ن",1,0],["تنظَّمن في هام الفضاء وصدره","وحلينه فرقا وزنّ المقلدا",6,"د",2,0],["تَنَظَّرتُ نَصراً وَالسِماكَينِ أَيهُما","عَلَيَّ مِنَ الغَيثِ اِستَهَلَّت مَواطِرُه",7,"ر",2,0],["تَنَظَّرتُ نَصراً أَن يَجيءَ وَإِن يَجِئ","فَإِنّي كَمَن قَد مَرَّ بِالسَعدِ طائِرُه",7,"ر",2,0],["تَنَظَّر حَيثُ كُنتَ قُدومَ مَوتٍ","يُشَتِّتُ بَعدَ جَمعِهِمُ عِيالَك",8,"ك",1,0],["تُنَظَّمُ في مراتبِهِ المعالي","فتحسبُها نجوماً للنّجومِ",9,"م",1,0],["تَنظمُ الشعرَ مُلِحَّاً حَرِداً","وَيْكَ خُذها ضربةً تشفي الحَرَدْ",10,"د",1,0],["تنظر الموت فوقها","شاخصاتٌ عيونُها",11,"ه",2,0],["تَنَظَّرتُ مَنظوراً لِيَزجُرَ قَومَهُ","فَقَد عَذَرَتني في اِنتِظارِهِمِ عُذري",12,"ر",2,0],["تَنَظَّمَ مِنْ حُسْنِهَا جَنَّةٌ","عَلَى ذَلِكَ الجَبَلِ الأَجْرَدِ",13,"د",1,0],["تَنْظُرُ النَّظْرَةَ البَعِيدَ مَدَاهَا","فَتَرَى مَا بُكِنُّ قَلْبُ الْخَفَاءِ",14,"ا",2,0],["تَنَظّرْتُ نَصْراً وَالسِّماكَينِ أيْهُما","عليّ مِنَ الغَيثِ اتَهَلّتْ مَواطرُهْ",15,"ر",2,0],["تَنظّرْتُ نَصراً أنْ يجيء، وَإنْ يجيءْ","فإني كَمَنْ قَد مَرّ بالسَّعْدِ طائرُهْ",15,"ر",2,0],["تنظرُ الساعة من حين لحين","ليت شعري ما الذي يستعجلك",16,"ك",1,0],["تنظُرُ لِلأَشجارِ فيهِ وَلا","يعجبها إِلا الَّتي تثمرُ",17,"ر",1,0],["تَنظُرُ في عَينيّ طوراً وَلا","أُحرِزُ ماذا الدُرُّ وَالجَوهَرُ",17,"ر",1,0],["تنظم مع الاقوام في سلك سلكهم","تحذر من الامر الملوم باحصان",18,"ن",1,0],["تنظر في عيب غيرها سفهاً","وكم عيوبٍ لها فتنساها",19,"ا",3,0],["تنظر الكائنات فيه أخاها","وهو في ذاته أبو الكائنات",20,"ت",1,0],["تَنظَّمَتْ لك ملْء الدّهرِ واتّصلَتْ","مَحاسنٌ قُبحُهُ في حُسْنِها خَفيا",21,"ي",2,0],["تنظر أبدانهم تبرق زيان","والبواطن ملانه بالدمان",22,"ن",1,0],["تَنظرُ العاجزَ الحظوظُ فيستْعَ","لِي وتَعْمَى عن حازمٍ محدودِ",23,"د",1,1],["تنظُرُ عينُ الضيفِ منه الى","خُلْقٍ ذميمٍ ومحيّاً دَميمْ",24,"م",1,0],["تنظرُ منه أبداً كلمّا","ليست له عينُك بالناظرهْ",25,"ر",2,0],["تَنَظَّرْ وإن ضاقت بصدرٍ رِحابُهُ","فُروج صَلاحٍ ذَرعُهنّ رحيبُ",26,"ب",1,0],["تنظم تعويذاً لها سبح الدجى","وينثر إعجاباً بها لؤلؤ الطل",27,"ل",1,0],["تُنظّمنا طعناً وتنثر ضارباً","فقد طاب في أجفانك النظم والنثر",28,"ر",1,0],["تنظَّمَتْ بطَريقِ الشَّرْعِ همَّتُهُمْ","ما فيه من نَزَغاتِ الوهمِ أَلوَانُ",29,"ن",1,0],["تنظَّمَ جيشُهُمْ من كلِّ قرْمٍ","عَظيمِ الجَاشِ ذي شمَمٍ جَوادِ",30,"د",1,0],["تنْظُرُ الْحقَ إذا ما أظْلمَتْ","طُلْمَةٌ قد أَشْكَلَتْ بالاِنتِصارِ",31,"ر",1,0],["تنظم اللؤلؤ عقداً قيما","وتواسينا بعقد قيم",32,"م",1,0],["تنظِّم أَفراد المَعاني صِفاته","وَجمع المَعالي نظم تِلكَ الفَرائِدِ",33,"د",1,0],["تَنَظَّمَ منهُ الزّهر فَوقَ غُصونِهِ","تَأَمّل تَرى المَنثورَ لا شكّ مَنظوما",34,"م",2,0],["تَنظُر فيها العَجَب العجابا","وَإِن سَأَلت لَم تَجد جَوابا",35,"ب",2,0],["تَنظُر إِلى مَخلابِ لَيثٍ ضَيغَمٍ","وَغِرارُ مَسنونِ المَضارِبِ مَفصِلِ",36,"ل",1,0],["تنظرها تظنها صغيرة","لكنها في فعلها كبيرة",37,"ه",1,0],["تنظرها تظنها لا تحرك","وإنها في سيرها لا تدرك",37,"ك",1,0],["تنظر في وَجهه وَتَهتف بالث","كل وَجاري الدُموع حادرها",38,"ر",3,0],["تنظر الأرؤس من فوق الصعاد","وترى الأجساد في عفرالوهاد",39,"د",1,0],["تنظّم بالرماح حروف جسم","وتنشر بالصفاح رؤوسهنه",40,"ن",2,0],["تنظيم وصفك فوق مقدرتي","والشهب لا يصادها الصقر",41,"ر",1,0],["تَنظيمُ أَجزاءِ فِعلٍ نَسقُ مَسلَكِها","إِجراءُها عنوَةً وِفقاً لِمَعدودِ",42,"د",1,0],["تَنَظَّرُ وفدَ معشرِها علينا","لِمَنٍّ أو نكاحٍ تمَّ فينا",43,"ن",2,0],["تنظر منهم أرؤساً أبدلن من","أجسامهم سمر الرماح الرعشا",44,"ش",2,0],["تنظرته وهنا وصحبي هجد","وقلبي يعنيه الهيام ويرمض",45,"ض",1,0],["تنظم أشواقي يواقيت أدمعي","سموطا كلا خديّ منها موشح",46,"ح",1,0],["تنظرْنقاً يهتزّ فيه قَناً","ونرجساً حَوْليه نونٌ ونون",47,"ن",1,0],["تنظرُ الطالعَ السعيدَ إذ لاَح","في ذلك الجبينِ السعيدِ",48,"د",1,0],["تنظر الخيلَ في المرابطِ حوليْه","وسُمْرَ القنا وخفقَ البنودِ",48,"د",1,0],["تنظرُ الطُوسي والكَرْخي","والملك الْبجلّي ديناً قيّمَا",49,"م",2,0],["تَنظُر في دَعج وَارنو بِالَّتي","أَخضلت الأَردان في غُروبِها",50,"ب",3,0],["تَنظُرُ ذاكَ الحينَ سُندَ بَاري","فَهيَ طريقُ المُلِّ للسُّفَّارِ",51,"ر",1,0],["تَنظُرُهُ يَقُومُ كالسُّيوُف","فَإِنَّهُ بِقُربِهَا مَعرُوف",52,"ف",1,0],["تَنظُرُهَا تَشُوفُ مِن رَاسِ الدَّقَل","جبالَ مِن برِّ السيامِ عَن كَمَل",52,"ل",1,0],["تَنظُرُ ذا الحينَ جَبَلٌ قَفَاصي","إسمُهُ فُلفَاسلاَرُ عِندَ النَّاسِ",52,"س",1,0],["تَنظُرُهَا مِن زَنجِبارِ ظَاهِرَه","وَبَينَهُم جُزرٌ عَلى المُيَاسَرَه",53,"ه",1,0],["تَنظُر إِلى نارٍ سَنا نورها","يَحمِلُها وَالماءُ يَحويها",54,"ي",3,0],["تنظف لي أرض الخوان بدقة","وتذهب ضيفاً ما أخف وما أحلى",55,"ا",1,0],["تنظر زهر الرياض هازئة","إذ قتلت بالسفور والصلف",56,"ف",1,0],["تنظم الدر في مديح إمام","صاغه اللَه حكمة للبريه",57,"ي",2,0],["تنظرُ من أعلى بغير عدِّ","عجائباً لم تُحصَ بالأقلام",58,"م",1,0],["تنظر اجسادا لها مجاسدٌ","أوصالها قد وصلتها النضب",59,"ب",1,0],["تنظر الغيد مقلتاي ولكن","دون عشق الفؤاد همٌّ وضيق",60,"ق",1,0],["تنظم في السلك اللآلي وهل","رأيتها منظومة في الحبال؟",61,"ل",1,0],["تنظم القربى على طول المدى","من ذرى الشعرى إلى قاع البحور",62,"ر",1,0],["تنظر البحر تحتها ذا خفوق","كل حين كأنه قلب مغرم",63,"م",1,0],["تنظر بعين رحمةِ العطاءِ","والفضلِ والكرمِ والآلاءِ",64,"ا",2,0],["تُنَظِّمُهُ عِقداً أَنامِلُ ماجِد","لَهُ في مَقامِ الفَضلِ أَرفَعُ مَنصِب",65,"ب",1,0],["تَنظُر الرُوح وَتَسمَع","بَينَ أَعماقك أَمرا",66,"ر",2,0],["تَنظُر نَواجمها في الطِباع","وَعَقبى نَتائجها في الشِيَم",67,"م",1,0],["تنظم نثره أيدي محب","مشوق كاد أن يقضي غراما",68,"م",2,0],["تنظرهم يا صاح في جنح الدجى","حلفا الصلاة ذوي بكاً ودعاء",69,"ا",2,0],["تَنْظِر عِجايب فِيْ الزِّمَن لو تِفَكَّر","نامَت ذيابَه ثم جارَت ثعالبَه",70,"ب",2,0],["تنظَّرُ زَورتي خَود لَعوبٌ","وتحذَرُ نَفْرتي هيفاءُ رُودُ",71,"د",1,0],["تنظْرْ اليومَ فهل توبة","تعيد ذاك النصلُ في غمدهِ",72,"د",2,0],["تنظر في اللحظ على انكساره","صوارما لاح بهن العطب",73,"ب",1,0],["تَنظيمُ \"حَسون النَّواوِى\" لَمْ يَزلْ","مِنهاجُ تَجديدٍ، ووَحى غِنَاء",74,"ا",2,0],["تنظم دراً