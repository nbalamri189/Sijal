{"poems":[[55,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[87,"ضربوا القباب على اليباب","https://www.aldiwan.net/poem62925.html","مجزوء الكامل"],[47,"في غير شأنك بكرتي وأصيلي","https://www.aldiwan.net/poem65605.html","الكامل"],[99,"غيث على القفر حيّانا وأحيانا","https://www.aldiwan.net/poem24977.html","البسيط"],[107,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[77,"هل كان ضمخ بالعبير الريحا","https://www.aldiwan.net/poem69095.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54633","الكامل"],[108,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[111,"عش ما نشاء وراقب فجعة الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=520",""],[92,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[53,"أنَّى هجوتَ بني ثوابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=26855",""],[130,"للحب دين وللأشواق باقينا","https://www.aldiwan.net/poem794.html",""],[139,"ما للحمام على الأنام يصول","https://www.aldiwan.net/poem49157.html","الكامل"],[186,"دع مجلس الغيد الأوانس","https://www.aldiwan.net/poem67054.html","مجزوء الكامل"],[275,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[325,"شكرا بالنصر عين العز ترقبكم","https://www.aldiwan.net/poem67182.html","البسيط"],[470,"يا شاديَ الأيك","https://www.aldiwan.net/poem43677.html","عموديه"],[567,"من يقرب النار لا يسلم من الحرق","https://www.aldiwan.net/poem52861.html","البسيط"],[567,"لا عين تثبت في الدنيا ولا أثر","https://www.aldiwan.net/poem52924.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138279",""],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77644","الرجز"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56575","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112834","الكامل"],[1954,"","https://poetry.dctabudhabi.ae/diwan/poem/188167","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110296","الكامل"],[2230,"","https://poetry.dctabudhabi.ae/diwan/poem/101794","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77274","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201779","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87390","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58053","البسيط"],[4680,"أودى بكَ الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=185075",""],[4755,"عَن كَوْنِهِم كانُوا ضَحَاياهُ","https://www.poetsgate.com/ViewPoem.aspx?id=183642",""],[4755,"عَوْدٌ على بَدءٍ فَصَبرٌ جَمِيلْ","https://www.poetsgate.com/ViewPoem.aspx?id=184682",""],[4755,"أنشودة المساكين","https://www.poetsgate.com/ViewPoem.aspx?id=215431",""],[4767,"منير","https://www.poetsgate.com/ViewPoem.aspx?id=98577",""],[5075,"أشْعَارُنَا تَرَفٌ","https://www.poetsgate.com/ViewPoem.aspx?id=187691",""],[5096,"يا لائما أحوالنا","https://www.poetsgate.com/ViewPoem.aspx?id=207838",""],[5160,"نحنُ القلوبُ الطاهرة","https://www.poetsgate.com/ViewPoem.aspx?id=183333",""],[5185,"القاع","https://www.poetsgate.com/ViewPoem.aspx?id=71577",""],[5189,"يا أيها الوطن الجريح","https://www.poetsgate.com/ViewPoem.aspx?id=190883",""],[5189,"يا من عَصيتَ","https://www.poetsgate.com/ViewPoem.aspx?id=191522",""],[5189,"دنيا فانيهْ","https://www.poetsgate.com/ViewPoem.aspx?id=204570",""],[5219,"أضغاث أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=195012",""],[5277,"القدسُ..القدسُ..يا عربُ","https://www.poetsgate.com/ViewPoem.aspx?id=194614",""],[5281,"غزَّة العزِّ","https://www.poetsgate.com/ViewPoem.aspx?id=199703",""],[5512,"يا أيها الرمل","https://www.poetsgate.com/ViewPoem.aspx?id=204865",""],[5542,"لغة الحجارة","https://www.poetsgate.com/ViewPoem.aspx?id=10192",""],[5569,"مريم والعراق","https://www.poetsgate.com/ViewPoem.aspx?id=60534",""],[5595,"إنّ العراقَ أبيّ ٌ أينما ذهبوا","https://www.poetsgate.com/ViewPoem.aspx?id=144531",""],[5616,"قومي","https://www.poetsgate.com/ViewPoem.aspx?id=203485",""],[5776,"فمتى السّمانُ ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=199756",""],[5830,"فِي المَجْدِ ْمُسْتَبَقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201192",""],[5897,"بين الخوف والرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=156850",""],[5897,"شكراً ملك القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=157548",""],[5956,"عجباً يحارب نفسه الصّومالُ","https://www.poetsgate.com/ViewPoem.aspx?id=194484",""],[5960,"بغدادُ أغلى انتماءاتي","https://www.poetsgate.com/ViewPoem.aspx?id=30808",""],[6189,"عيبان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83602&r=&rc=69",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""],[6323,"زلزال الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82178&r=&rc=9",""]],"verses":[["ماذا نُؤَمِّلُ في اليَراعِ إِذا نَشَت","ريحٌ تَدُقُّ الصَعدَةَ الصَمّاءَ",0,"ا",2,0],["ماذا نَقِمْتَ على امرىءٍ","يُؤوي إلى جُحرٍ حُبابهْ",1,"ب",2,0],["ماذا نَقَمتَ مِنَ الشَبابِ","وَأَنتَ في نِعَمِ الشَبابِ",2,"ب",1,0],["ماذا نَقولُ وَقَد جَمَعتَ شَتاتَنا","وَأَتَيتَنا بِالعَدلِ وَالتَعديلِ",3,"ل",1,0],["ماذا نقول ونبدي بعدما سبقت","لك الشهادة من تكريم مولانا",4,"ن",2,0],["ماذا نخافُ وَكُلُّ حَرْفٍ مَعقِلٌ","وَلِمَنْ ندينُ وكلُّ سطرٍ عسكرُ",5,"ر",1,0],["ماذا نقولُ جَلَلْتَ عن أفهامنِا","حتى استَوَينْا أعْجَماً وفَصيحا",6,"ح",2,0],["مَاذَا نُعِدُّ لِذَوْدِهَا عَنْ حَوْضِنَا","يَكْفِي الدِّعَابُ لاتَ حينَ دِعَابِ",7,"ب",1,0],["ماذا نقولُ؟ أَمَنْ صِحْنا به مَلَكًا","بالأمس ندعُوهُ هذا اليومَ شيطانا؟",8,"ن",2,0],["ماذا نحاول من ريب المنون اذا","قلنا حنانيك أو سيري على مهل",9,"ل",1,0],["ماذا نَوَيتمْ سادتي : هل أنتُمُ","بعد الرئيس – كعهده – أخشاب",10,"ب",1,0],["ماذا نَقِمْتَ على امرىء","يُؤوي إلى حُجرٍ حُبابَهْ",11,"ب",2,0],["ماذا نعوّض عن عهد الصبا بدلاً","إذا تقضّى وما نلنا أمانينا",12,"ن",2,0],["ماذا نريدُ من الحياةِ وبدرها","لا بد يوماً يعتريه أفولُ",13,"ل",1,0],["ماذا نُؤمِّلُ بَعدَهُم","إِلّا مُقارَعَةَ الفَوارِسْ",14,"س",1,0],["ماذا نَقُولُ وقد أراكِ وداعُنا","بسماتِ باكيةٍ ودَمعَ ضَحُوك",15,"ك",1,0],["ماذا نَقولُ إِذا أَصبَحتَ مُرتَقِياً","هَذا مَقامُكَ قُل لي مَن يُجاريهِ",16,"ي",2,0],["ماذا نَقولُ لهُم؟..كانوا سَماسِرَة ً","لِلمُعتَدي؟.. بِأخَسِّ البَيع ِأثمانا؟!",17,"ن",2,0],["ماذا نقولُ؟..غَزَتْنا مِن مَنازِلِكُم","هذي الأفاعي التي هِيضَتْ بمأوانا؟",17,"ن",2,0],["ماذا نَقولُ إذا كانَت كرامَتُكُم","تَبكي على قَدْرِها مِن فَرْطِ ما هانا!",17,"ن",2,0],["ماذا نُؤَمِّلُ من نَفعٍ إذا اتَّفَقَتْ","أسماؤُنا والمُسمَّى غيرُ مُتَّفِقِ",18,"ق",1,0],["ماذا نُرَجِّي منَ الدُنيا التي طُبِعَتْ","على الدَّمارِ فلا تُبقي ولا تَذرُ",19,"ر",1,0],["ماذا نرى ما هذه الأنوارُ","هل ذي نجومٌ لحن أم أقمار",20,"ر",1,1],["ماذا نَراك في الدَيار تَصنَع","إِنَّك مِن أَشعب حَقّاً أَطمَعُ",21,"ع",1,0],["ماذا نرى إحدى العوا","صم أم نرى إحدى القفور",22,"ر",1,0],["ماذا نقول من الثنا حقه","بعد الذي قد جاء في الأعراف",23,"ف",1,0],["ماذا نقول لأجيال لنا نظرت","لمجد ماض ومانحن به لانا",24,"ن",2,0],["ماذا نعيت إليَّ من أحواله","يا أيها الباكي على استقلاله",25,"ل",2,1],["ماذا نقمت من الوصي ألم يكن","لمدينة العلم الحصينة بابها",26,"ب",3,0],["ماذا نَخافُ عَلى فُضولِ تُراثِنا","لَو حازَها مِن أَهلِ مِصرٍ مُعدِمُ",27,"م",1,0],["ماذا نقول بوصف بردٍ قاتل","وشِفاهنا جمُدت فكيف نقول",28,"ل",1,0],["ماذا نؤَمِّل من زَمانِ سُحبُهُ","تَبكي بِهِ وَرياحهُ تَتَنهَّدُ",29,"د",1,0],["ماذا نقولُ إذا ما غادةٌ هَلَكت","وخلَّفت زوْجَها مُحدودبَ الظَّهرِ",30,"ر",1,1],["ماذا نقول؟ وقد تاهت رواحلنا","حكم الزمان علينا بالبعاد قضى",31,"ض",2,0],["ماذا نَقُولُ الآنَ عَن واضِحٍ","في غامِضٍ لا لَبْسَ في بَونِهِ!",32,"ن",2,0],["ماذا نَقُولُ اليَومَ عَن ثَورَةٍ","غُبَارُها وَافَى بلا زَنجَبيلْ؟!",33,"ل",1,0],["ماذا نَرَى وهي مُنذُ الفَتحِ مَزرَعةٌ","كُلُّ المَحَاصِيلِ فيها لِلطَّوَاحِينِ!",34,"ن",1,0],["ماذا نقول وراحةُ البال التي","نرنو لها قد هدها إعصار",35,"ر",1,0],["ماذا نقولُ وذِي أشعارُنا تَرَفُ ؟","والعهرُ يرقى ويُسبى في الدُّنَا الشرفُ",36,"ف",1,1],["ماذا نُداري وبالأجْواء غيْمتُها",".. أمْطارها وابلٌ لو طال بي صمْتِي",37,"ت",2,0],["ماذا نقولُ لربّنا في يومِهَا","فإذا همُ كلّ الوَرَى بالسَّاهِرَةْ",38,"ر",2,0],["ماذا نقاطع من عدو حاقد؟","أ صناعة ، وبضاعة ، ومزار؟",39,"ر",1,0],["ماذا نقولُ وقد تنكَّرتِ الوغى","أشلاءُ أطفالٍ تُداسُ وتُقسمُ",40,"م",1,0],["ماذا نقولُ هَجرنا دِيننا عبثاً","طال الضياعُ فأضحى الهجرُ أزمانا",41,"ن",2,0],["ماذا نقولُ وعند الله مَوعدنا","نلقى الحسابَ ونلقى الله غضبانا",41,"ن",2,0],["ماذا نقولُ يا ترى","فالناس تبدو لاهيهْ",42,"ي",2,0],["ماذا نقول لطفل ناح في هلع ؟",". عمر الورود وقد لاحت أزاهره",43,"ر",2,0],["ماذا نقول لثكلى بات سيدها ؟","تحت الثرى جدثا ترجى مآثره",43,"ر",2,0],["ماذا نقولُ لربِّ العرشِ عنْ خَوَرٍ","أصابنا فاستكنَّا حينَ نحتسبُ",44,"ب",1,0],["مَاذا نَقولُ إذا سُئِلنا عَنْهم؟","إنَّا غَداةَ يُقتَّلون نِيامُ",45,"م",1,0],["مَاذا نَقولُ إذا سُئلنا عنهم؟","إنَّا وَهُمْ يَسْتَصْرِخُونَ هَوامُ",45,"م",1,0],["مَاذا نقولُ وفي الجِنَان مَقامُهم؟","إنَّا لَهَتْنا أَنفسٌ وحُطَامُ",45,"م",1,0],["مَاذا نقولُ لِطفلِ غَزّةَ وحدَهُ؟","نَحنُ الصِّغَارُ؛ وأنتَ وَحدَكَ هَامُ!",45,"م",1,0],["مَاذا نَقولُ لِبنتِ غَزَّةَ أُختِنا؟","بِعْنَاكِ !!.. يا للعار! كيفَ نُلامُ؟",45,"م",1,0],["ماذا نَقولُ لأُمِّنَا الثَّكلى الَّتي","ضَاعتْ خُطَاهَا، والدُّموعُ سِجَامُ",45,"م",1,0],["ماذا نُجيبُ إذا ما احتارَ سائلُنَا","إنْ قالَ مالي أرى داراً بلا عَمَدِ",46,"د",1,0],["ماذا نؤمل يا أبي من فاسق","يلهو ومن متدين يتطرف ؟",47,"ف",1,0],["ماذا نعدّ من الأمجادِ في وطنٍ","تكادُ من خجلٍ تجثو له العُصُرُ",48,"ر",1,0],["ماذا نقولُ لليلى حين تسألنُا","كيفَ العراقُ؟ وكيف أرضُهُ الذهَبُ ؟",49,"ب",1,1],["ماذا نقُولُ لها والنفسُ في صعَد ٍ؟","سَقَط َالقناع ُ ، وبان َالحَقّ ُ والسّببُ",49,"ب",1,0],["مَاذا نقولُ لِشعْبٍ غَصَّ في حَدثٍ","أنّ الحُكومة َ تنفي أنّهم نهبُوا",49,"ب",3,0],["ماذا نقول لنيران مُسعرة","والناس من حولها ساخت بها الركب؟",50,"ب",1,0],["ماذا نقول إذا عافت مضاجعنا","تلك الحياة وغاب الأسمُ واللقب؟",50,"ب",1,0],["ماذا؟....نعم قد شاهدوا نُقُمَاً","في نِهمَ واحتشدتْ إليهِ جموعُ",51,"ع",1,0],["مَاذَا نَقُولُ إِذَا مَا جَاءَ يَسْألُنَا","عَنْ شَرْعِ أَحْمَدِنَا إِذْ بَاتَ مُخْتَرَمَا",52,"م",2,0],["ماذا نقول إلهنا لنواظرٍ","يسمو بها نحو السماء رجاءُ",53,"ا",2,0],["ماذا نقول لوالد دانت له","منا القلوب أسيرة لعطائهِ",54,"ا",3,1],["ماذا نقول لمن يُعرّض أهله","للجوعِ والبلوى أجب يا خالُ",55,"ل",1,0],["مَاذا نقولُ إذا المَنصورُ يسألُنا ؟","صارتْ مَدينةَ أشباحِ الضَّلالاتِ",56,"ت",1,0],["ماذا نقولُ وماذا كي تصدقنا","إنّ الهوى فوق ما نبدي وما نصف؟!",57,"ف",1,0],["ماذا نقول لنا دربٌ ستعرفه","\" صنعاء\" ما في دروب الحبِّ منعطف",57,"ف",1,0],["ماذا نقول وإن جادت بلاغتنا","وزخرفت كلمات أو زهت خطب",58,"ب",1,0],["ماذا نريد بحزمة الكلمات كال","غيم الذي بسمائنا لا يمطرُ ؟!",59,"ر",1,0]]}