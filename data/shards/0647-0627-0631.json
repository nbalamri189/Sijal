{"poems":[[53,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[87,"الرشد أجمل سيرة يا أحمد","https://www.aldiwan.net/poem63675.html","الكامل"],[87,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[46,"هارون يا خير من يرجى","https://www.aldiwan.net/poem30390.html","مجزوء البسيط"],[83,"لاموا فلما لاح موضع صبوتي","https://www.aldiwan.net/poem61551.html","الكامل"],[50,"هارون يا خير الخلائف كلهم","https://www.aldiwan.net/poem63358.html","السريع"],[50,"حي الديار إذ الزمان زمان","https://www.aldiwan.net/poem66132.html","الكامل"],[50,"هارون إنك للسادات من مضر","https://www.aldiwan.net/poem66144.html","البسيط"],[48,"الشيب أزهار الشباب فما له","https://www.aldiwan.net/poem22705.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[128,"بالنفس يا شيخ من تقواك أشياء","https://www.aldiwan.net/poem23734.html","البسيط"],[189,"لو كان بالصبر الجميل ملاذه","https://www.aldiwan.net/poem14515.html","الكامل"],[190,"يا غاديا متوسطا","https://www.aldiwan.net/poem43974.html","مجزوء الكامل"],[199,"ليت شعري هل تخبرني الديار","https://www.aldiwan.net/poem54408.html","الخفيف"],[240,"يا صلاح الدين خذ حذ","https://www.aldiwan.net/poem31807.html","مجزوء الرمل"],[261,"هارب مني وقد خاف العمى","https://www.aldiwan.net/poem48415.html","المتقارب"],[275,"ها ردفها يأخذ من صدرها","https://www.aldiwan.net/poem35390.html","السريع"],[287,"يا راكب الناقة الوجناء يزجيها","https://www.aldiwan.net/poem32302.html","البسيط"],[287,"للورد حين به ناهيك من حين","https://www.aldiwan.net/poem32327.html","البسيط"],[287,"دعه فقد جذب الهوى بعنانه","https://www.aldiwan.net/poem32341.html","الكامل"],[287,"أنا بالغزلان وبالغزل","https://www.aldiwan.net/poem32672.html","المتدارك"],[287,"يا عاذلي أقصر فكم تتعب","https://www.aldiwan.net/poem32861.html","السريع"],[287,"أفدي غلاما قط ما قطبا","https://www.aldiwan.net/poem32868.html","السريع"],[289,"ولقد قلت حين أجحرني البرد","https://www.aldiwan.net/poem44308.html","الخفيف"],[358,"وتذكرت عهد الهوى","https://www.aldiwan.net/poem39954.html","مجزوء الكامل"],[384,"هارلها اللحم على عسلاج","https://www.aldiwan.net/poem4538.html","الرجز"],[558,"هات اسقني طال بي الحبس","https://www.aldiwan.net/poem68376.html","السريع"],[632,"","https://poetry.dctabudhabi.ae/diwan/poem/203121","المتدارك"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59255","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59187","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65015","الكامل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35797","السريع"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77766","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77738","الكامل"],[2221,"","https://poetry.dctabudhabi.ae/diwan/poem/34831","المجتث"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45704","الخفيف"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33955","السريع"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100882","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204593","الكامل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71389","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91460","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85220","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135576","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94472","الكامل"],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[5092,"ما أروعك","https://www.poetsgate.com/ViewPoem.aspx?id=190577",""],[5277,"أنا..وليصمت العذول","https://www.poetsgate.com/ViewPoem.aspx?id=189734",""],[5277,"تباريحٌ بغدادية..","https://www.poetsgate.com/ViewPoem.aspx?id=198463",""],[5574,"هارون","https://www.poetsgate.com/ViewPoem.aspx?id=205997",""],[5818,"ماذا عسى","https://www.poetsgate.com/ViewPoem.aspx?id=181337",""],[5937,"لا يُجيدُ الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=211809",""],[5950,"مورقه يا طواريق الطريق الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=139963",""],[6093,"القصيدة الزبيدية في مدح خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=195006",""],[6262,"جُثَّتي تقتفي خُطاي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80124&r=&rc=22",""],[2944,"شكوى العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86015&r=&rc=4",""],[6344,"رجع من شفة الصّمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87978&r=&rc=18",""]],"verses":[["هارباً من مغوثة كم أغاثت","من لهيف ونفَّست مخنوقا",0,"ق",2,0],["هاربُهم لَيسَ يَرى وَجهَ الثَرى","وَلا يَرى مَسجُونُهُم غَير الدُجى",1,"ا",1,0],["هاروتُ شِعرِكَ بَعدَ ماروتِ الصِبا","أَعيا وَفارَقَهُ الخَليلُ المُسعِدُ",2,"د",1,0],["هارِباً مِن ساحَةِ العَيشِ وَما","شارَفَ الغَمرَةَ مِنها وَالغُدُر",3,"ر",1,0],["هارونُ يا خَيرَ مَن يُرَجّى","لَم يُطِع اللَهَ مَن عَصاكا",4,"ك",2,1],["هاروتُ أَودَعَ في لِحاظِكَ سِحرَهُ","فَأَصابَ قَلبي مِنكَ مِثلُ عَذابِهِ",5,"ب",2,0],["هارونُ يا خَيرَ الخَلائِفِ كُلِّهِم","مِمَّن مَضى فيهِم وَهَذا الغابِرُ",6,"ر",1,1],["هارونُ أُلِّفَنا اِئتِلافَ مَوَدَّةٍ","ماتَت لَها الأَحقادُ وَالأَضغانُ",7,"ن",1,0],["هارونُ إِنَّكَ لِلساداتِ مِن مُضَرٍ","وَخَيرُ قَحطانَ عُثمانَ اِبنُ عُثمانِ",8,"ن",1,1],["هارونُ إِنَّكَ لِلساداتِ مِن مُضَرٍ","وَإِنَّ سَيفَكَ مِن أَبناءِ قَحطانِ",8,"ن",1,0],["هارٍ عَلَيهِ مَوقِفٌ مِن خائِفٍ","لِلدَهرِ فَتكَةَ سائِفٍ أَو هاري",9,"ر",2,0],["هاربةٌ أنتِ يا فتاتي","من ثورةِ الشكّ والرِّيَبْ",10,"ب",1,0],["ها رفدكم فخذوا بعداً لنائلكم","فأنه وصمة تاللّه شنعاء",11,"ا",2,0],["هاروتُ يَعْجِز عن مَواقعِ سِحْره","وهو الإمامُ فمن تُرى أستاذه",12,"ذ",2,0],["هاروت في لحظاته","إبلس بعض جنوده",13,"د",2,0],["هارِباتٍ فَما يَرَينَ وَلَكِن","لا يُنَجّي مِنَ المَنايا الفِرارُ",14,"ر",1,0],["هارِباً مِنها نَجاءَ ال","أَعوَجِيّاتِ العِتاقِ",15,"ق",1,0],["هاربٌ مني وقد خاف العمى","بقفا للنعل بادي المقتل",16,"ل",1,1],["ها رِدفُها يأخذُ من صَدرِها","وساقُها يأخذُ من خَصرِها",17,"ر",3,1],["هاروتُ يَنفُثُ سِحراً مِن لَواحِظِهِ ال","وَسنى المِراضِ اللَواتي عِفنَ تَنبيها",18,"ي",3,0],["هاروتُ بابِله أَجفانُهُ وَبِها","تَبارَكَ اللَهُ يُنفى دينُ ذي الدينِ",19,"ن",1,0],["هاروتُ بابِلَ كامِنٌ في طَرفِهِ","مُتَعَلِّمٌ لِلسِّحرِ مِن إِنسانِهِ",20,"ن",2,0],["هاروتُ وَماروتٌ في با","بِلَ مِن جَفنَيهِ عَلى وَجَلِ",21,"ل",1,0],["هاروتُ في بابِلَ مِن نَفثِهِ","لِلسِّحرِ مِن أَجفانِهِ يَعجَبُ",22,"ب",1,0],["هاروتُ في أَجفانِهِ نازِلٌ","سِحراً وَماروتُ بِها طَنَّبا",23,"ب",2,0],["هارِباتٌ مِنهُ إِلى كُلِّ خصبٍ","حينَ لَم يَرتَجينَ مِنهُ بَلالَه",24,"ل",2,0],["هاروت آمن بِالعُيو","نِ وَلِلحَواجب أَسلَما",25,"م",2,0],["هارلها اللحم على عسلاج","لا قفر اللحم ولا حفضاج",26,"ج",1,1],["هارونُ بَدرٌ لِبَني هاشِمٍ","وَأُختُ هارونَ لَهُم شَمسُ",27,"س",1,0],["هاروت يعنعن فيه السح","ر إلى عينيك ويسنده",28,"د",2,0],["هَارُوتُ أجْفَانِهَا ألْقَى حَبَائِلَهُ","فَأوْقَعَ الْقَلْبَ فِي مَهْوَاةِ أشْرَاكِ",29,"ك",1,0],["هَارُوتُ عَيْنَيْهِ قَامَ يَدْعُو","بِسِحْرِ طَرْفٍ لَهُ مُهَنَّدْ",30,"د",1,0],["هاروتُ يَرْوي السِّحْرَ عَنْهُ كَمَا رَوَى","بَهْرامُ شاهَ الفَخْرَ عن فُرُّخْشَهِ",31,"ه",1,0],["هارونُ يَحمي مُلكَ آبائِهِ","وَرَبُّ هارونَ لِهارونَ حامي",32,"م",2,0],["هاروت ماروت البيان محيلة","ما جاء من هاروت أَو ماروت",33,"ت",1,0],["هاروت ماروت البيان مديرة","في الدستكان عَلى سنان الموت",34,"ت",1,0],["هارونُ بَعدَ أَبيهِ","أَعلى البَرِيَّةِ كَفّا",35,"ف",2,0],["هارون كان عالماً بالحسبِ","وكان عارفاً بعلم الأدب",36,"ب",1,0],["هارِباً مِن ظَلام فعلك في نَحو","ضياء الفَتى الأَغَر الهجان",37,"ن",1,0],["هارونُ يا سُؤلي وُقيتُ الرَدى","قَلبي بِعَتبٍ مِنكَ مَشغولُ",38,"ل",1,1],["هارونُ يا خير من ساس الخلافةَ لا","تَقِف عُلاك على حدِّ الخلافاتِ",39,"ت",1,0],["هارون قم وانظر بلادك والذي","قد جر فيها الظلم والازعاج",40,"ج",1,0],["هَارُوتُها أَضْحَى وَمَارُوتُها","عِلْمَهُمَا بِالسِّحْرِ لاَ يُجْحَدُ",41,"د",1,0],["هاروتُ خلِّ السحرَ وَاهجُر بابلا","لا سحرَ إِلا سحرُ لَحظٍ نافثِ",42,"ث",1,1],["هاروت بابل قال ووالهي","من سحر مقلته وواحري",43,"ر",2,0],["هارون في الخامس ثم موسى","في سادس كان به نفيسا",44,"س",2,0],["هارِباً جئِتُ مُذ سَعَيتُ إِلى جا","ريَةٍ رَامَ رَغمَ أُمِّي نُكرا",45,"ا",1,0],["هاروت حار بسحر عينيها كما","قد خَرَّ للأذقان قرَّ وسلما",46,"م",2,0],["هارونَه قد صار يعضِد أمرَه","في كل أمرٍ في الرسالة شايعَه",47,"ع",2,0],["هاربٌ من وحدتي كي أتْبَعَكْ","وانقسمتُ في دمي كي أجْمَعَكْ",48,"ك",1,1],["هارونُ جدِّي لمْ أزلْ","أروي أنا عنهُ الخبرْ",49,"ر",1,0],["هارونُها يشتاقُها فرطَ الهوى","وزبيدةٌ أحرى بشوقٍ ثانِ",50,"ن",1,0],["٥- \"هارونُ\" خذْ بيدي واحلُلْ بها عُقَدي","إن الفصاحةَ لا تسعى بها قدَمي!",51,"م",2,0],["هاروتُ في عينٍ يجفّفُ ثوبَهُ","وينامُ في الأخرى أسىً ماروتُ",52,"ت",1,0],["هاربٌ من أناه أن يتغافى","مهربَ النهر أن يُحِسَ ركودا",53,"د",2,0],["هاربٍ يوقد الظلما وصوته فتيل","شبّي الوجد يشعل لك ضلوعه حطب",54,"ب",1,0],["38.هَارُوْنُ يُوْسِفُ صَالِحٌ مَعْ آَدَمٍ","يَحيَى ، الجَمِيْعُ سَعَى إلِى لُقْيَاكَا",55,"ك",2,0],["هاربًا فيكِ من مماتٍ مُعادٍ","مشعلا جمرةَ السماءِ بفرضي",56,"ض",2,0],["هارونُ قم وانظر بلادك والذي","قد جرَّ فيه الظلم والإزعاج",57,"ج",1,0],["هَارِبًا مِنْكَ صَوْبَ مَنْآكَ تَطْوِي","دَوْرَةَ الأَرْضِ فَاسْتَدَارَتْ حِيَالَكْ",58,"ك",1,0]]}