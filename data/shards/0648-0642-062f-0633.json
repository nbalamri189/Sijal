منسرح"],[393,"أقول وقد رأيت له سحابا","https://www.aldiwan.net/poem53395.html","الوافر"],[396,"هل بالمنازل إن كلمتها خرسُ","https://www.aldiwan.net/poem587.html",""],[400,"مواكب خير ، موكب إثرموكب","https://www.aldiwan.net/poem4595.html","عموديه"],[402,"وفي لي ولم يسمع كلام مفند","https://www.aldiwan.net/poem46741.html","الطويل"],[402,"هي الدنيا وأنت بها خبير","https://www.aldiwan.net/poem47006.html","الوافر"],[403,"طال الوقوف على الأطلال والدمن","https://www.aldiwan.net/poem33399.html","البسيط"],[403,"سلام على رمل الحمى عدد الرمل","https://www.aldiwan.net/poem33608.html","الطويل"],[406,"هل الوجد إلا أن تلوح خيامها","https://www.aldiwan.net/poem50126.html","الطويل"],[409,"يا غافلين عن الأمر الذي خلقوا","https://www.aldiwan.net/poem31937.html","البسيط"],[409,"أبا حسن قد ران بعد بعادكم","https://www.aldiwan.net/poem32256.html","الطويل"],[416,"سقانيها معتقة عقارا","https://www.aldiwan.net/poem54008.html","الوافر"],[416,"لفقدان عبد الواحد الدمع قد جرى","https://www.aldiwan.net/poem54022.html","الطويل"],[416,"وعدتن طرفي بالخيال وصالا","https://www.aldiwan.net/poem54037.html","الطويل"],[416,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[416,"إلى شعبان مولاي المفدى","https://www.aldiwan.net/poem54139.html","الوافر"],[429,"لك العلياء والشرف المفدى","https://www.aldiwan.net/poem41437.html","الوافر"],[432,"بك الإسلام قد لبس الشبابا","https://www.aldiwan.net/poem12461.html","الوافر"],[437,"أمن منزل بالجق أقوت معالمه","https://www.aldiwan.net/poem2537.html","الطويل"],[437,"لهم طلل ما بين يبرين والحمى","https://www.aldiwan.net/poem2616.html","الطويل"],[439,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[439,"لعلك يا شمس عند الأصيل","https://www.aldiwan.net/poem34889.html","المتقارب"],[441,"وحسن جمال ليلى أن ليلى","https://www.aldiwan.net/poem14305.html","الوافر"],[441,"إليك رسول الله سرنا عصابة","https://www.aldiwan.net/poem14334.html","الطويل"],[441,"أريقي الدمع يا مقلي أريقي","https://www.aldiwan.net/poem14467.html","الوافر"],[452,"أتت أسماء ساحبة رداها","https://www.aldiwan.net/poem13950.html","الوافر"],[458,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[458,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[458,"ألا يا خليلي المجتبى من خزيمة","https://www.aldiwan.net/poem56184.html","الطويل"],[458,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[458,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[461,"عجبت لحي لا تحل حباهم","https://www.aldiwan.net/poem16062.html","الطويل"],[464,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[464,"رويدك يا من تدعي شرف العلى","https://www.aldiwan.net/poem3407.html","عموديه"],[464,"نضت يد الشرق سيوف الصباح","https://www.aldiwan.net/poem3576.html","عموديه"],[464,"وقد أخضب الدمع فاكفف رائد النظر","https://www.aldiwan.net/poem3578.html","عموديه"],[468,"لنا بغير نفاجه","https://www.aldiwan.net/poem60316.html","المجتث"],[477,"عشية عجنا بالمطي الرواسم","https://www.aldiwan.net/poem15247.html","الطويل"],[505,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[505,"أقلّوا","https://www.aldiwan.net/poem61087.html","الطويل"],[515,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[515,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[527,"ألست ترى السيف كيف انثلم","https://www.aldiwan.net/poem45972.html","المتقارب"],[529,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[551,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[551,"هل العز إلا في متون السوابق","https://www.aldiwan.net/poem47358.html","الطويل"],[551,"سئمت مقامي في الغبينة مغمدا","https://www.aldiwan.net/poem47869.html","الطويل"],[558,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[558,"تجلت لنا ذات وفعل بدا واسم","https://www.aldiwan.net/poem34074.html","الطويل"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[558,"افتح عيونك في الآيات والسور","https://www.aldiwan.net/poem34549.html","البسيط"],[564,"لشمس مجدك في الآفاق أضواء","https://www.aldiwan.net/poem820.html",""],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[569,"فان يبل الشباب فكل شيء","https://www.aldiwan.net/poem51993.html","الوافر"],[575,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[575,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"],[575,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"],[586,"رشيق القامة النضره","https://www.aldiwan.net/poem17529.html","مجزوء الوافر"],[587,"أرى كل ما قد قدر الله يكتب","https://www.aldiwan.net/poem11510.html","عموديه"]],"verses":[["وَقَد سَقى البَدوَ وَطَبَّقَ الحَضَر","عَسى الَّذي ساءَ قَريباً أَن يَسُرّ",0,"ر",1,0],["وَقَد سَحَبَت ذَوائِبَها ذُكاءٌ","عَلى قِمَمِ الجَنادِلِ وَالصُخورِ",1,"ر",1,0],["وَقَد سَكَنتُ إِلى الأَخبارِ بَعدَهُمُ","وَعِندي المُزعِجانِ الذِّكرُ وَالحَزَنُ",2,"ن",1,0],["وَقَد سَمِعَتْ بي فاِعتَرَتها بَشاشَةٌ","وَمِثلي بِها عندَ الكِرامِ قَمينُ",3,"ن",1,0],["وَقَد سَئِمتُ مُقامِي بَينَ شِرذِمَةٍ","إِذا نَظَرتُ إِلَيهِم قَطَّبَتْ هِمَمي",4,"ي",1,1],["وَقَد سَفرَت عَن وَجهِها فَتَمَزَّقَتْ","دُجاهُ وَلكِن رَدَّ ظُلمتَهُ الشَّعرُ",5,"ر",1,0],["وقد ساءَ قَوْماً مِنْ نِزارٍ ويَعْرُبٍ","فَخاري وهُمْ أرضٌ ونحنُ سَماؤُها",6,"ا",3,0],["وقد ساءَني أن أرى دارَها","تَصوغُ الحمائِمُ فيها لُحونا",7,"ن",2,0],["وقد ساءَني طُولُ الصُّدودِ فلمْ أبُحْ","بِذاكَ وأعناقُ العِدا دونَنا صُعْرُ",8,"ر",1,0],["وَقَد سِرتُ يا بِنتَ الكِرامِ مُبادِر","وَتَحتِيَ مَهرِيٌّ مِنَ الإِبلِ أَهوَجُ",9,"ج",1,0],["وَقَد سَدَّدوا عَقدَ أَذنابِها","فَما يَأتَلونَ وَما يَأتَلينا",10,"ن",2,0],["وَقَدْ سَمِعْنَا بِأَنَّ الطَّيْرَ خَاطَبَهُ","فِي منْطِقٍ مُفْصِحٍ مِنْ غَيْرِ تَلْكِينِ",11,"ن",1,0],["وَقَد سَمِعوا مَقالَتَنا فَهَمّوا","غَداةَ الرَوعِ مِنا بِاِنصِرافِ",12,"ف",1,0],["وَقَد سَرَّحا ذَقنَيهِما وَتَسَربلا","مِنَ الوَشيِ ما اِزدانَت حَواشيه وَالرقمُ",13,"م",1,0],["وقَدْ سَمِعْتُ فلمْ أبْهَجْ به خَبراً","مخبّراً قامَ يَنْمِي رَجْعَ أخبارِ",14,"ر",1,0],["وَقَد سَدَتِ الصُهبُ المَهارى بِأَرجُل","شَديدٍ بِرَضراضِ المِتانِ اِنتِضالُها",15,"ل",3,0],["وَقَد سُمِّيَت بِاِسمِ اِمرِئِ القَيسِ قَريَةٌ","كِرامٌ صَواديها لِئامٌ رِجالُها",15,"ل",3,0],["وقد سقّاه لحظا رقيع","وقد نفى عنّوا الوسن",16,"ن",1,0],["وقد سُلَّ خفَاق الذوائب بارق","كما سُلَّ لمَّاع الصِّقال من الغمدِ",17,"د",1,0],["وقد سجدت لها الأنظار لمّا","أرتنا الحسن يرفل في القباطي",18,"ط",2,0],["وقد سلكوا تَيْهاء من أمر دينهم","فكم مُنجِدٍ في المخزيات ومُتْهِم",19,"م",1,0],["وَقَد سَرَّني أَلّا تَعُدَّ مُجاشِعٌ","مِنَ المَجدِ إِلّا عَقرَ نابٍ بِصَوأَرِ",20,"ر",1,0],["وقد سَخِطَ ائتِلافَهُمُ رِجَالٌ","أَطَالَ الله رَغمَ الساخِطِينَا",21,"ن",2,0],["وَقَد سَمَحتُ غَداةَ البَينِ مُبتَدِئاً","مِنَ الجَوابِ بِوَعدٍ أَنتَ ذاكِرُهُ",22,"ر",2,0],["وَقَد سارَت قَوافٍ باقِياتٌ","تَناشَدَها الرُواةُ بِكُلِّ وادي",23,"د",2,0],["وقد سألوا أهل الكؤس كريقها","مدام فقالت للكؤس الخبائث",24,"ث",1,0],["وقد سكنت في قلبهِ الطهر رحمةٌ","يكادُ بمسرى نشرها الميتُ ينشر",25,"ر",1,0],["وقد سموت لديوان الرسائل في","طي ادّكارك لا كتبي ولا رسلي",26,"ل",2,0],["وقد ساقها من بعد ما قد تغيَّرت","وقد هزلت حتَّى بدا من هزالها",27,"ه",2,0],["وقد ساءني أَنِّي مُحبٌّ مُقرَّبٌ","وأَنْ ليس لي إذنُ المحبّ المقرَّبِ",28,"ب",1,0],["وقد سُئل الحساد عنك بأسرهم","فقالوا وما حابوا بوزن نَقير",29,"ر",1,0],["وقد سُربل بالليلِ","وقد بُرقع بالفجر",30,"ر",1,0],["وقد سار مدحي شرقَ أرض وغربها","وغنَّى به القومُ المقيمون والسفر",31,"ر",1,0],["وقد سبقت كفيكَ كفَّا مُماجدٍ","أتسلو عن المعروفِ أم تتوجَّعُ",32,"ع",1,0],["وقد سار مدحي فيك كلَّ مسيرة","مزحزحةٍ بل سال كلَّ مسيلِ",33,"ل",1,0],["وقد سيرْتُ أنكمُ غيوثٌ","تجودُ ولا تكون لها وُحولُ",34,"ل",1,0],["وقد سر المكارمَ أن أُدِلْتُم","كما سر المجمَّرةَ القفولُ",34,"ل",1,0],["وقد سُئلنَ أفيه ما يُعابُ له","فقلن هيهاتَ تلك العينُ عقيان",35,"ن",1,0],["وَقَد سَرَّني مِن قَيسِ عَيلانَ أَنَّني","رَأَيتُ بَني العَجلانِ سادوا بَني بَدرِ",36,"ر",1,0],["وَقَد سَقَتني رُضاباً غَيرَ ذي أَسَنٍ","كَالمِسكِ ذُرَّ عَلى ماءِ العَناقيدِ",37,"د",1,0],["وَقَد سَبَقَتنا أُمُّ عَمرو بِأَمرِها","وَكَانَت بِأَعناقِ المَطِيَّ أَظَلَّتِ",38,"ت",1,0],["وقد سطع الفجر المضيءُ حذاءه","ولاح بياض للصباح طويل",39,"ل",1,0],["وَقَد سَمِعتُ عَنكَ مِن ثِقاتِ","أَنَّكَ أَنتَ مَلِكُ النَباتِ",40,"ت",1,0],["وَقَد سَبَقَت رَكائِبِيَ القَوافي","مُقَلَّدَةً أَزِمَّتَها طِرابا",41,"ب",2,0],["وَقَد سارَ في مَسراكَ مِنها رَسولُهُ","فَما سارَ إِلّا فَوقَ هامٍ مُفَلَّقِ",42,"ق",1,0],["وقد سَمِعتْ أذنايَ نجوى فِراقِكمْ","فلا أبصرتْ عيني ولا سَمِعتْ أُذنِي",43,"ي",1,0],["وقد سَرَّني أنِّي من المالِ مُقْتِرٌ","ولا الوجهُ مبذولٌ ولا العِرضُ منهوبُ",44,"ب",1,0],["وَقَد سامَ طَعمَ المَنِّ ذَوقاً فَلَم يَجِد","بِهِ المَنَّ مَرضِيَّ المَذاقِ وَلا السَلوى",45,"و",2,0],["وَقَد سارَ في عَمرِو بنِ غَنمِ بنِ تَغلِبٍ","مَسيرَ اِبنِ وَهبٍ في عَجاجَةِ راسِبِ",46,"ب",1,0],["وَقَد سَرَّني أَن قيلَ وُجِّهَ مُسرِعاً","إِلى الشَرقِ تُحدى سُفنُهُ وَرَكائِبُه",47,"ب",2,0],["وَقَد سارَ موسى في جِبالٍ لَوَ اِنَّها","تُرادي الجِبالَ الراسِياتِ لَهُدَّتِ",48,"ت",1,0],["وَقَد سَرَّني أَنَّ الخَليفَةَ جَعفَراً","غَدا زاهِداً في أَهلِها وَبِلادِها",49,"د",3,0],["وَقَد ساءَني أَن لَم يَهِج مِن صَبابَتي","سَنا البَرقِ في جِنحٍ مِنَ اللَيلِ أَخضَرِ",50,"ر",1,0],["وَقَد سَرَّني أَنَّ الخِلافَةَ فيكُمُ","مُخَيِّمَةٌ ما إن يُخافُ اِنتِقالُها",51,"ل",3,0],["وَقَد سَبَقَت أَيادٍ مِنكَ بيضٌ","وَآلاءٌ إِذا حُمِلَت ثِقالُ",52,"ل",1,0],["وَقَد سَأَلتُ فَما أُعطيتُ مَرغَبَةً","وَكانَ حَقِّيَ أَن أُعطى وَلَم أَسَلِ",53,"ل",1,0],["وَقَد سُمِّنَت حَتّى كَأَنَّ مَخاطَها","هِضابُ القَليبِ أَو فَوادِرُ عَضوَرا",54,"ر",2,1],["وَقَد سَخِطَت مِنّي نَوارُ الَّذي اِرتَضَت","بِهِ قَبلَها الأَزواجُ خابَ رَحيلُها",55,"ل",3,0],["وقد سفَرَ الأُفقُ عن شِدَّةٍ","لسانُ السَّماء بها ناطِقُ",56,"ق",1,0],["وقد سَلَّتْ جيوشُ الفِطْرِ فيه","على شَهْرِ الصِّيامِ سيوفَ باسِ",57,"س",1,0],["وَقَد سَتَرَ السَحابُ ذُكا وَفُضَّت","جَلابيبُ الغُيومِ عَلى الفَضاءِ",58,"ا",2,0],["وَقَد سَما قَبلي يَزي","دُ طالِباً شَأوَ العُلى",59,"ا",1,0],["وقد سَكِرَتْ صِعادُ الخطّ حتى","تأوّدَ كلّ لدنٍ مستقيمِ",60,"م",1,0],["وقَد سَفِرت عَن صفرةٍ عَبْرَ الأسى","لعيني بها عن وَجْد قلبٍ مفجَعِ",61,"ع",1,0],["وقد سكّنَتْ حركاتِ الأسى","قيانٌ تُحَرّكُ أوتارها",62,"ر",3,0],["وَقَد سَوَّدَ الديوانُ بَعضَ ثِيابِهِ","وَأَحسَنُ ما تُستَوضَحُ الشَمسُ في الدَجنِ",63,"ن",1,0],["وَقَد سَدَّ مَندوحَةَ القاصِعاءِ","مِنهُم وَأَمسَكَ بِالنافِقاءِ",64,"ا",2,0],["وقَدَّسْتُ ذِكراكَ لم انتحِلْ","ثِيَابَ التُّقَاةِ ولم أَدَّعِ",65,"ع",1,0],["وَقَد سَقَطَ النورُ فَوقَ الغَديرِ","فَأَثبَتَت في دِرعِهِ أَنصُلا",66,"ل",2,0],["وَقَد سَكَتَ الوُشاةُ اليَومَ عَنّي","أَقَرَّ الخَصمُ فاِرتَفَعَ النِزاعُ",67,"ع",1,0],["وقُدِّسَ فِينا بِحبِّ الصَلاة","جَميعاً وعَلّمَ خَطَّ القَلَم",68,"م",1,0],["وَقَد سُدَّ مَجرى البَولِ مِن بَطنِ جِعثِنٍ","بِعَقفاءَ تَسقيها إِذا اِختَلَّ ثيلُها",69,"ل",3,0],["وَقَد سَقى مُفلِحَ كَأسَ القَتلِ","وَشَكَّهُ بِمِخصَفٍ ذي نَصلِ",70,"ل",1,0],["وَقد سَجَدَتْ لهُ أَغصانُ سَرْحٍ","فلِمْ لا يؤْمِنُ الظَّبْيُ الرَّبِيبُ",71,"ب",1,0],["وَقَدْ سَرقُوا الْغِلالَ وما عَلِمْنا","كما سَرَقَتْ بَنُو سَيْفِ الجُرُونا",72,"ن",2,0],["وقد سَلَبَتْه الزّاعبيّةُ ما ادّعى","فأصْبحَ تِنّيناً وأمسَى ذُرَحْرَحا",73,"ح",2,0],["وَقَد سُئِلوا عَن عِباداتِهِم فَما","أَيَّدوها وَلا ثَبَّتوا",74,"ت",3,0],["وَقَد سُمِّيَ المَرءُ الهِزَبرَ تَفاؤُلاً","وَلَيسَ بِباقٍ في اللَيالي هِزَبرُها",75,"ر",3,0],["وَقَد سَقَتهُم غَماماتٌ بَكَت زَمَناً","بِلا اِبتِسامٍ فَما جادوا وَلا دَمِعوا",76,"ع",3,0],["وَقَد سَئِمنا زَمَناً مُؤذِياً","أَروَحُ مِن سالِمِهِ التالِفُ",77,"ف",1,0],["وَقَد سَرَّ المَعاشِرَ باقِياتٌ","مِنَ الأَنباءِ سِرنَ لِيَستَفِضنَه",78,"ن",2,0],["وَقَد سَأَلَت عَنّي الوُشاةُ فَخُبِّرَت","وَقَد نُشِرَت مِنها لَدَيَّ صَحائِفُ",79,"ف",1,0],["وَقَد سائَني أن النوى أَخذت بنا","تشطّ وأن الشمل غير جَميع",80,"ع",1,0],["وَقَد سترت لَيلى الحَقيقة وَجهها","وَللعين حظ منه لَو رفع الستر",81,"ر",1,0],["وقد سارَ ذكْري في البلادِ فمَن لهمْ","بإِخفاءِ شمسٍ ضَوْؤها مُتكامل",82,"ل",1,0],["وقد سَمّاهُ سَيّدُهُ عَلِيّاً","وذلكَ مِن عُلُوّ القَدْرِ فال",83,"ل",1,0],["وَقَد سِرتُ يا بِنتَ الكِرامِ مُبادِراً","وَتَحتِيَ مَهرِيٌّ مِنَ الإِبلِ أَهوَجُ",84,"ج",1,0],["وَقَدْ سَهِرُوا كَمَا بَكَرُوا","بِلاَ وَهَنٍ وَلاَ فَترِ",85,"ر",1,0],["وقد سَفَرَتْ أخلاقُهُ وتوضَّحَتْ","شَمائِلُهُ والصُّبحُ لا يَتَلثَّمُ",86,"م",1,0],["وقد سَمَتْ الزَوراءُ ترفَعُ رأسَها","على الأرض تِيهاً مثلَ نَسر مُحلِّق",87,"ق",1,0],["وقد سدت الأفق العجاجة والتقت","جحافل يحدوها الردى وقطائع",88,"ع",1,0],["وَقَدْ سَرّني أنّ الخَليفَةَ جَعْفراً","غَدا نَاهِداً، في أهلِهَا، وَبِلاَدِهَا",89,"د",3,0],["وقد سُئلنَ: أفيه ما يُعابُ له","فرعاً غذَتْه الغوادي فهو فَينان",90,"ن",1,1],["وقد سجدتْ لها الأنظارُ لما","أرَتنا الحُسر يَرْفُل في القَباطِي",91,"ط",2,0],["وَقَد سَوَّدت مِنهُ وُجوه مَآرب","مِن البين وَأَبيضت يَديهِ مَفارِقُ",92,"ق",1,0],["وَقَد سَقى وَصلَنا مَوصول دَمعي","وَحيّا عَهدِنا عَهد الغَمام",93,"م",1,0],["وقد سلموا من دس خائنة الريا","فما عشقوا البيضا ولا حاولوا الصفرا",94,"ر",2,0],["وقَد سَلَكُوا في المَجدِ شَأوَ أَبِيهِمُ","ولا عَجَبٌ إِن يُشبِهِ الأَسدَ الشِّبلُ",95,"ل",1,0],["وقد سارت بشائره","تبلغ للورى الخبرَا",96,"ر",2,0],["وقد سرتَ بين الناسِ أحسن سيرةَ","ففزتَ بأسنَى المدح معْ أحسن الذكرِ",97,"ر",1,0],["وقد سبق الصعيدُ شمال مصر","ووجها مصر لولاكم سواء",98,"ا",2,0],["وَقَد سَكَنَت ريحُهُم مِن سُطاكَ","وَإِن لَم تَهَب جُرمَهُم لَم تَهُبّ",99,"ب",1,0],["وَقَد سَمِعَ الظُبى فيهِم تُغَنّي","وَلَم تُغنِ المَواثِقُ وَالعُهودُ",100,"د",1,0],["وَقَد سارَ شِبلٌ فيهِمُ وَمُبارَكٌ","بِمالَم يَسِر عَن نَهشَلٍ وَمُجاشِعِ",101,"ع",1,0],["وَقَد سَمِعَ الوَرى في كُلِّ أَرضٍ","وَلَيسَ المَينُ مِن شِيَمي مَقالي",102,"ي",1,0],["وَقَد سَمِعَ اللَهُ فيكَ الدُعا","ءَ مِمَّن دَعا مُخلِصاً وَاِبتَهَل",103,"ل",1,0],["وَقَد سَمِعَ اللَهُ الكَريمُ لِأُمَّةٍ","تَيَمَّمَتِ البَيتَ العَتيقَ المُحَرَّما",104,"م",2,0],["وَقَد سَعى الناسُ في ذا النَهجِ فَاِلتَمَسوا","مَداكَ دَهراً وَلَكِن خابَ سَعيُهُمُ",105,"م",1,0],["وقد سرت فيهم سيرة عمريّة","وأسقيت ظاميها الهداية فارتوى",106,"و",2,0],["وقد سمعنا ونحن نرجو","رؤية ما قيل بالكمال",107,"ل",1,0],["وَقُدِّسَ في أَخلاقِهِ وَصِفاتِهِ","عَلى الرَغمِ مِن أَضدادِهِ وَشُناتِهِ",108,"ه",1,0],["وقد سبق الكتائب فوق طرفٍ","إِذا جاراه لحظُ الطرف كَلاَّ",109,"ل",2,0],["وقد سلكت إِلى الأَرواح فيه","من الضرب الظُبا سبلاً فجاجا",110,"ج",2,0],["وقد سطح العجاج سما وثارت","سحائب قسطل في الجو كدر",111,"ر",1,0],["وَقَد سَما قَبلي يَزيدٌ طالِباً","شَأوَ العُلى فَما وَهى وَلا وَنى",112,"ا",1,0],["وَقَد سَما عَمرٌو إِلى أَوتارِهِ","فَاِحتَطَّ مِنها كُلَّ عالي المُستَمى",112,"ا",1,0],["وَقَد سَدّد الدَّهرُ الخَئُونُ لِمَقتَلي","سِنَانِي هِيَاجٍ فِي زَمَانِ أَمَانِ",113,"ن",1,0],["وَقَد سَعى بَينَنا الواشونَ وَاِختَلَفوا","حَتّى تَجَنَّبتُها مِن غَيرِ هِجرانِ",114,"ن",1,0],["وقد سَبَحتْ فيه الثُّرَيا كَأنها","بَنيقةُ وَشْىٍ في قميصِ حِداد",115,"د",1,0],["وقد سبقاك إصلاحاً ورغلا","متاعا والمتاع له شياعُ",116,"ع",1,0],["وقد سلت سيوف الفت","ك والهيبة وغطوطه",117,"ط",2,0],["وَقَد سَمِعَت أُذنايَ قول اِبن عمّه","مُجيباً بأن لا نِسبة لهمُ تُدرى",118,"ر",2,0],["وَقَد سَبَقت كلَّ الجيادِ خديجةٌ","وَأَلحِق بِها أولادهُ السادةَ الغرّا",119,"ر",2,0],["وَقدَّسوا أذانهُ تَقديسا","فَهو نبيّهم بغيرِ ردِّ",120,"د",1,0],["وَقَد سَفَعتهُ الشَمسُ بَعدَ بَضاضَةٍ","فَصارَ كَسَفّودِ الحَديدِ المُسَحَّمِ",121,"م",1,0],["وقد سدَلتْ غدائرها تريني","تبدلَ بيضَ أيامي بسودِ",122,"د",1,0],["وقد سعتِ اللحاظُ بما أردنا","توكدُ يننا صدقُ العهودِ",122,"د",1,0],["وقد سامحتها خطوبُ الزمانِ","وضنتْ عليها بأكدارها",123,"ر",3,0],["وقد سمت رشاقة","على الرشاق السمر",124,"ر",1,0],["وقد سرت فينا سيرة عمرية","صدعت بها الباغين والحق صادع",125,"ع",1,0],["وقد سفرت صباحا عن شموس","بها تلك المنازل تستنار",126,"ر",1,0],["وقد سَمَّاك أقوام","جواداً ما جداً غَمْرا",127,"ر",2,0],["وقد سبق الوعد المصدّقُ أنه","إذا جاءت الأشراط منها سيرفع",128,"ع",1,0],["وَقَد سَرَّني اليَومَ أَنّي رَأيتُ","نُهوضَ النَعامَةِ في نُصرَتِه",129,"ت",2,0],["وَقَدْ سَعِدَتْ فَكَانَ لَهَا اتِّعَاظٌ","بِمَنْ شَقِيَتْ عَلَى صَعَرٍ بِخَدِّ",130,"د",1,0],["وقد ساءه فتح الأمير محمد","لها و