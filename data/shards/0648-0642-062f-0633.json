",2,0],["وقد سرتْ بين بدور الدجى","نجومُ راحٍ فوق أفلاك راح",203,"ح",1,0],["وقد سمعتُ ولم اسمع كشأنهما","بيضُّ ذاك وذا يسودُّ بالقمر",204,"ر",1,0],["وَقَد سَأَلتُكَ فَاِحضُر","وَخَلِّ عَنكَ اللَجاجَه",205,"ج",2,0],["وقد سِرنَ عن تلكَ الديارِ مُغِذَّةً","نياقهمُ نحوَ النقا فالأناعمِ",206,"م",1,0],["وقدْ سَكنْتُ السَّما اقتناعاً","بأنَّ تحْريرها قريبُ",207,"ب",1,0],["وقد سلَّط اللهُ عليكمْ مُذنَّبا","لنومٍ فجالَ في السّما مُتفرِّدا",208,"د",2,0],["وقد سحبت إلى يحيى ململمة","لها من الحلق الماذي أذيال",209,"ل",1,0],["وقد سن ذاك المصطفى في ابن عمه","فمن شرفيكم حادث وقديم",210,"م",1,0],["وقد ساءني عُطَلُ الدهر منك","وقد كنت حِلياً عليه انتظم",211,"م",1,0],["وقَدْ سارَتْ بِهِ الرُّكْبانُ شَرْقاً","وَغَرْباً لم تَردْ فيه رُدودُ",212,"د",1,0],["وقد ساموك مشكلةً لَموعاً","كما لمع الفضاءُ بلمعِ آلِ",213,"ل",1,0],["وقد ساورته النّائباتُ فأقشعتْ","وَما حَظِيَتْ إلّا بنَهْلَةِ شارقِ",214,"ق",1,0],["وَقَد سَلب الإقدامُ لَونَ جُلودها","وَأَلْبَسها بالطّعن ثوباً مورَّدا",215,"د",2,0],["وقد سرنا على استقلا","لنا بالغير لا نأتمّْ",216,"م",1,0],["وقد سرنا إلى حبرو","نَ وهْي الداءُ والمرهمْ",216,"م",1,0],["وقد سلبت رجا ايجاب كل منى","عمن سواك وثوقا منك بالكرم",217,"م",1,0],["وقد سكرت حاناتها وكؤوسها","بها في تجليها وقد سكر الكرم",218,"م",1,0],["وقد سلموا طوعاً إليه وأسلموا","ومنهم له التسليم للسوء دافع",219,"ع",1,0],["وقد سمعت ومن بعض النداء أنا","صوت المنادي بإيمان على البشر",220,"ر",1,0],["وقد سمى بك فخراً كل ما افتخرت","به ملوك وإقبال وولاء",221,"ا",2,0],["وقد سمعتم ما رأى الأنصار","إذ شوروا فلم يروا ما اختاروا",222,"ر",3,0],["وقد سددت فاعلموا مكانه","برجل ستحمدون شأنه",222,"ه",1,0],["وَقَد سال الفجاج فجاج نجد","بجرد الخليل والاسل النهال",223,"ل",1,0],["وقَدْ سَقَاني حَبي","بي بكَأسه حَميم",224,"م",1,0],["وقد سَارَ ما بين الوَرى ذِكْرُ شِعْره","ولكنَّه من بيتِه غَيْرُ سائر",225,"ر",1,0],["وقد سُحِرْتُ بِتلكَ الْعَيْنِ لاَ قَذِيتْ","كما احْتَرقْتُ بِذَاك الخَدِّ لا خَمَدا",226,"د",2,0],["وَقَدْ سَوَّدْتَ حَظّي مِنْ","كَ يا أَبْهَى الوَرَى غُرَّهْ",227,"ر",2,0],["وقد سفحت بالدم من أجل 