,1,0],["وَقَد سَمِنَت حَتّى كَأَنَّ مَخاضَها","تَفَشَّغَها ظَلعٌ وَلَيسَت بِظُلَّعِ",155,"ع",1,0],["وقد سَنّ من إرسالِ دَمْعٍ لأجله","وإرْسالُ قَولٍ يُسخِطُ الرَّبَّ ما سَنّا",156,"ن",2,0],["وقد سبَقَ البْرقَ المُجاريهِ بَعْدَ ما","تَشكَّلَ منه بالضِّياءِ القَوادم",157,"م",1,0],["وقد سار أفلاكُ المطايا وفوقَها","بُدورٌ تَجلّى والبُروجُ خُدور",158,"ر",1,0],["وقد سَدَّدتْ نحوي اللّيالي سِهامَها","وأَفصحَ لي عمّا يُريدُ نَذير",158,"ر",1,0],["وقد سارتِ الأحداجُ من بطْنِ وَجْرةٍ","وأَدنَى ديارِ الحّيِ منها زَرودها",159,"د",3,0],["وَقَد سَلَبَ اللَهُ عَنهُ القَبولَ","وَيَعلَمُ أَنّي لا أَقبَلُ",160,"ل",1,0],["وَقَد سُيِّبَت أَرزاقُهُم مِن يَمينِهِ","وَهَل يَستَجيرُ القُطرُ يَوماً سِوى القَطرِ",161,"ر",1,0],["وَقَد ساءَ في الجِدِّ تَوسيعُهُ","يُكَرِّرُ أَقوالَهُ ماكِرا",162,"ر",2,0],["وقد سألتُكِ مَعروفاً بمَعرِفَةٍ","أنَّ السُّؤالَ سَيَلقَى منكِ حِرمانا",163,"ن",2,0],["وقد سَلفَ الكرامُ بمِثلِ ماذا","خَلَفتَ بِه فَهَل ظَمِئوا وجاعوا",164,"ع",3,0],["وقدسه قبل الوجود وصانه","له موضعاً من بين كل المواضع",165,"ع",1,0],["وقد سرني ذاك النجيع مضرَّجاً","وأعجبني دمعٌ له وهو جاهش",166,"ش",1,0],["وقد سلَّم القوم اليهود مجيَّه","ولكنهم قالوا بناسوت بشرة",167,"ه",1,0],["وقد سارت الأتراح في الأرض والسما","وقد حل ركب الحزن في كل طغمة",167,"ه",1,0],["وَقَد سوغت لي وَأدَ أَبكار خاطِري","خَطوبٌ وَخِطّابٌ لَهُ مُرَّة المَجنى",168,"ن",2,0],["وَقَد سَرَت مِن دِيارهم سحراً","لِأَنَّ ريا نَسيمِها عُطرُ",169,"ر",1,0],["وَقد سَحَّت عَزاليها بِهطلٍ","حَوالينا الصدود وَلا عَلَينا",170,"ن",2,0],["وقد سَبأتُ لفتيان ذوي كرمٍ","قبل الصباح ولَما تُقرع النُقُسُ",171,"س",1,0],["وقد سرَّنا في مهبط الوحي أنها","تميزنا في الواقع المتغربِ",172,"ب",1,0],["وقد سلَّ أسياف الْبروق لوامِعاً","وأقبلَ يحدو مُرعداً بَعْدَ مُرْعِد",173,"د",1,0],["وقُدِّسَ عَنْ وَزيرٍ أو مُعينٍ","فلا وزَرٌ لَدَيهِ ولاَ وَزيرُ",174,"ر",1,0],["وقد سعيت أنا بالصلح بينهما","أطفأت ناراً لها الإِيقاد بالفتن",175,"ن",1,0],["وقد سامني أهل المقام بذلة","ولست بأهل للذي سامني أهلي",176,"ي",1,0],["وَقَد سَفَرَت عَن وَجهِها فَكأَنَّهُ","تَحسَّرَ ع