{"poems":[[53,"صبرا فما الفايز إلا من صبر","https://www.aldiwan.net/poem30422.html","الرجز"],[53,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[63,"يا عبرتي هذه الأطلال والدمن","https://www.aldiwan.net/poem45695.html","البسيط"],[63,"نظرت وللأدم النوافخ في البرى","https://www.aldiwan.net/poem45783.html","الطويل"],[63,"وقد سئمت مقامي بين شرذمة","https://www.aldiwan.net/poem45815.html","البسيط"],[63,"وسرب عذارى من ربيعة عامر","https://www.aldiwan.net/poem45841.html","الطويل"],[63,"ألا من لنفس لا تزال مشيحة","https://www.aldiwan.net/poem46142.html","الطويل"],[63,"كتمنا الهوى وكففنا الحنينا","https://www.aldiwan.net/poem46144.html","المتقارب"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[3,"أشاقك من عبل الخيال المبهج","https://www.aldiwan.net/poem135.html","الطويل"],[55,"ركبنا وفتيان صدق ثبينا","https://www.aldiwan.net/poem26089.html","المتقارب"],[77,"سل ما لسلمى بنار الهجر تكويني","https://www.aldiwan.net/poem36040.html","البسيط"],[24,"نفى أهل الحبلق يوم وج","https://www.aldiwan.net/poem21871.html","الوافر"],[71,"تجوع لي الشيخ الزكي وجاءني","https://www.aldiwan.net/poem3927.html","الطويل"],[10,"يا عين فيضي بدمع منك مغزار","https://www.aldiwan.net/poem20941.html","عموديه"],[30,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[83,"ما أملح مه فصل الربيع","https://www.aldiwan.net/poem54198.html","مجزوء الرجز"],[83,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[88,"بدت في مسرح رحب البلاط","https://www.aldiwan.net/poem44400.html","الوافر"],[88,"رمت مسمعي ليلا بأنه مؤلم","https://www.aldiwan.net/poem45022.html","الطويل"],[27,"لقد سرني أن لا تعد مجاشع","https://www.aldiwan.net/poem5768.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[47,"كيف السبيل إلى طيف يزاوره","https://www.aldiwan.net/poem25289.html","البسيط"],[23,"إن تصلح فإنك عابدي","https://www.aldiwan.net/poem21390.html","الوافر"],[72,"بروحي من نص الغزال لها الولا","https://www.aldiwan.net/poem18444.html","الطويل"],[72,"نفرت عن الظبي الذي كان ينفر","https://www.aldiwan.net/poem18710.html","الطويل"],[72,"غازلتنا فأعيدي ماضي الغزل","https://www.aldiwan.net/poem19472.html","البسيط"],[72,"أقول لعثمان الأديب وقد صبا","https://www.aldiwan.net/poem19587.html","الطويل"],[51,"صفا لك شرب العيش غير مثرب","https://www.aldiwan.net/poem8338.html","الطويل"],[51,"ولولاك لم تعدم دماء ممارة","https://www.aldiwan.net/poem62942.html","الوافر"],[51,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[51,"أناديك يا من ليس في سمعه وقر","https://www.aldiwan.net/poem64064.html","الطويل"],[51,"توهمت قد سوفت بالغوث راجيا","https://www.aldiwan.net/poem65067.html","الطويل"],[51,"أقاسم لا تسدد سبيلي إلى الرضا","https://www.aldiwan.net/poem65997.html","الطويل"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[29,"ألا يا اسلمي يا هند هند بني بدر","https://www.aldiwan.net/poem6039.html","الطويل"],[29,"يا يومنا عندها عد بالنعيم لنا","https://www.aldiwan.net/poem6117.html","البسيط"],[12,"ألا أم عمرو أجمعت فاستقلت","https://www.aldiwan.net/poem1205.html",""],[89,"لكل طلوع يا ذكاء أفول","https://www.aldiwan.net/poem44942.html","الطويل"],[85,"إلى حسين حاكم القنال","https://www.aldiwan.net/poem63688.html","الرجز"],[85,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[43,"لعينيك ما يلقى الفؤاد وما لقي","https://www.aldiwan.net/poem9733.html","الطويل"],[62,"أجيرتنا بالجزع كيف خلصتم","https://www.aldiwan.net/poem52262.html","الطويل"],[62,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[45,"لنا أبدا بث نعانيه من أروى","https://www.aldiwan.net/poem10213.html","الطويل"],[45,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[45,"يجانبنا في الحب من لا نجانبه","https://www.aldiwan.net/poem10904.html","الطويل"],[45,"رأت وخط شيب في عذاري فصدت","https://www.aldiwan.net/poem62645.html","الطويل"],[45,"أنبيك عن عيني وطول سهادها","https://www.aldiwan.net/poem63499.html","الطويل"],[45,"ليالينا بين اللوى فمحجر","https://www.aldiwan.net/poem63636.html","الطويل"],[45,"قف العيس قد أدنى خطاها كلالها","https://www.aldiwan.net/poem65539.html","الطويل"],[45,"رأيت الانبساط إليك يحظى","https://www.aldiwan.net/poem65585.html","الوافر"],[45,"لئن ثنى الدهر من سهمي فلم يصل","https://www.aldiwan.net/poem65622.html","الخفيف"],[28,"وقد سمنت حتى كأن مخاطها","https://www.aldiwan.net/poem5160.html","الطويل"],[28,"لعمري لقد أردى نوار وساقها","https://www.aldiwan.net/poem5375.html","الطويل"],[61,"طرقنا أبا عامر موهنا","https://www.aldiwan.net/poem51507.html","المتقارب"],[61,"ألا عد لي بباطية وكاس","https://www.aldiwan.net/poem51599.html","الوافر"],[66,"رسائل صدق إخوان الصفاء","https://www.aldiwan.net/poem39063.html","الوافر"],[66,"برق المشيب قد أضا","https://www.aldiwan.net/poem40981.html","مجزوء الرجز"],[80,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[80,"ولما رأت طير الفراق نواعبا","https://www.aldiwan.net/poem31389.html","الطويل"],[80,"قضت في الصبا النفس أوطارها","https://www.aldiwan.net/poem31465.html","المتقارب"],[44,"ومحتكم في الخمص طورا وفي البدن","https://www.aldiwan.net/poem30095.html","الطويل"],[44,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[90,"فداء لمثواك","https://www.aldiwan.net/poem59036.html","عموديه"],[81,"ولما تبرج خضر البطاح","https://www.aldiwan.net/poem61438.html","المتقارب"],[81,"خضعت وأمرك الأمر المطاع","https://www.aldiwan.net/poem61464.html","الوافر"],[21,"لك الحمد والمن رب العباد","https://www.aldiwan.net/poem36163.html","المتقارب"],[39,"نزلت بأعلى تلعة وفرزدق","https://www.aldiwan.net/poem53753.html","الطويل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[75,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[46,"عليكم بإحسانكم إنكم","https://www.aldiwan.net/poem22164.html","المتقارب"],[46,"أرى كل أم عبرها غير مبطئ","https://www.aldiwan.net/poem22528.html","الطويل"],[46,"دولاتكم شمعات يستضاء بها","https://www.aldiwan.net/poem22935.html","البسيط"],[46,"غرك سود الشعرات التي","https://www.aldiwan.net/poem22992.html","السريع"],[46,"لأمواه الشبيبة كيف غضنه","https://www.aldiwan.net/poem23485.html","الوافر"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85314","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85340","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16642","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16638","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9903","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54944","الوافر"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50447","الطويل"],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[45,"أُنَبّيكِ عَن عَيني، وَطُولِ سُهَادِها","https://www.poetsgate.com/ViewPoem.aspx?id=31602",""],[51,"وقد سُئلنَ: أفيه ما يُعابُ له","https://www.poetsgate.com/ViewPoem.aspx?id=25869",""],[88,"بدتْ في مسرح رَحْب البلاطِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19585&r=&rc=88",""]],"verses":[["وَقَد سَقى البَدوَ وَطَبَّقَ الحَضَر","عَسى الَّذي ساءَ قَريباً أَن يَسُرّ",0,"ر",1,0],["وَقَد سَحَبَت ذَوائِبَها ذُكاءٌ","عَلى قِمَمِ الجَنادِلِ وَالصُخورِ",1,"ر",1,0],["وَقَد سَكَنتُ إِلى الأَخبارِ بَعدَهُمُ","وَعِندي المُزعِجانِ الذِّكرُ وَالحَزَنُ",2,"ن",1,0],["وَقَد سَمِعَتْ بي فاِعتَرَتها بَشاشَةٌ","وَمِثلي بِها عندَ الكِرامِ قَمينُ",3,"ن",1,0],["وَقَد سَئِمتُ مُقامِي بَينَ شِرذِمَةٍ","إِذا نَظَرتُ إِلَيهِم قَطَّبَتْ هِمَمي",4,"ي",1,1],["وَقَد سَفرَت عَن وَجهِها فَتَمَزَّقَتْ","دُجاهُ وَلكِن رَدَّ ظُلمتَهُ الشَّعرُ",5,"ر",1,0],["وقد ساءَ قَوْماً مِنْ نِزارٍ ويَعْرُبٍ","فَخاري وهُمْ أرضٌ ونحنُ سَماؤُها",6,"ا",3,0],["وقد ساءَني أن أرى دارَها","تَصوغُ الحمائِمُ فيها لُحونا",7,"ن",2,0],["وقد ساءَني طُولُ الصُّدودِ فلمْ أبُحْ","بِذاكَ وأعناقُ العِدا دونَنا صُعْرُ",8,"ر",1,0],["وَقَد سِرتُ يا بِنتَ الكِرامِ مُبادِر","وَتَحتِيَ مَهرِيٌّ مِنَ الإِبلِ أَهوَجُ",9,"ج",1,0],["وَقَد سَدَّدوا عَقدَ أَذنابِها","فَما يَأتَلونَ وَما يَأتَلينا",10,"ن",2,0],["وَقَدْ سَمِعْنَا بِأَنَّ الطَّيْرَ خَاطَبَهُ","فِي منْطِقٍ مُفْصِحٍ مِنْ غَيْرِ تَلْكِينِ",11,"ن",1,0],["وَقَد سَمِعوا مَقالَتَنا فَهَمّوا","غَداةَ الرَوعِ مِنا بِاِنصِرافِ",12,"ف",1,0],["وَقَد سَرَّحا ذَقنَيهِما وَتَسَربلا","مِنَ الوَشيِ ما اِزدانَت حَواشيه وَالرقمُ",13,"م",1,0],["وقَدْ سَمِعْتُ فلمْ أبْهَجْ به خَبراً","مخبّراً قامَ يَنْمِي رَجْعَ أخبارِ",14,"ر",1,0],["وَقَد سَدَتِ الصُهبُ المَهارى بِأَرجُل","شَديدٍ بِرَضراضِ المِتانِ اِنتِضالُها",15,"ل",3,0],["وَقَد سُمِّيَت بِاِسمِ اِمرِئِ القَيسِ قَريَةٌ","كِرامٌ صَواديها لِئامٌ رِجالُها",15,"ل",3,0],["وقد سقّاه لحظا رقيع","وقد نفى عنّوا الوسن",16,"ن",1,0],["وقد سُلَّ خفَاق الذوائب بارق","كما سُلَّ لمَّاع الصِّقال من الغمدِ",17,"د",1,0],["وقد سجدت لها الأنظار لمّا","أرتنا الحسن يرفل في القباطي",18,"ط",2,0],["وقد سلكوا تَيْهاء من أمر دينهم","فكم مُنجِدٍ في المخزيات ومُتْهِم",19,"م",1,0],["وَقَد سَرَّني أَلّا تَعُدَّ مُجاشِعٌ","مِنَ المَجدِ إِلّا عَقرَ نابٍ بِصَوأَرِ",20,"ر",1,0],["وقد سَخِطَ ائتِلافَهُمُ رِجَالٌ","أَطَالَ الله رَغمَ الساخِطِينَا",21,"ن",2,0],["وَقَد سَمَحتُ غَداةَ البَينِ مُبتَدِئاً","مِنَ الجَوابِ بِوَعدٍ أَنتَ ذاكِرُهُ",22,"ر",2,0],["وَقَد سارَت قَوافٍ باقِياتٌ","تَناشَدَها الرُواةُ بِكُلِّ وادي",23,"د",2,0],["وقد سألوا أهل الكؤس كريقها","مدام فقالت للكؤس الخبائث",24,"ث",1,0],["وقد سكنت في قلبهِ الطهر رحمةٌ","يكادُ بمسرى نشرها الميتُ ينشر",25,"ر",1,0],["وقد سموت لديوان الرسائل في","طي ادّكارك لا كتبي ولا رسلي",26,"ل",2,0],["وقد ساقها من بعد ما قد تغيَّرت","وقد هزلت حتَّى بدا من هزالها",27,"ه",2,0],["وقد ساءني أَنِّي مُحبٌّ مُقرَّبٌ","وأَنْ ليس لي إذنُ المحبّ المقرَّبِ",28,"ب",1,0],["وقد سُئل الحساد عنك بأسرهم","فقالوا وما حابوا بوزن نَقير",29,"ر",1,0],["وقد سُربل بالليلِ","وقد بُرقع بالفجر",30,"ر",1,0],["وقد سار مدحي شرقَ أرض وغربها","وغنَّى به القومُ المقيمون والسفر",31,"ر",1,0],["وقد سبقت كفيكَ كفَّا مُماجدٍ","أتسلو عن المعروفِ أم تتوجَّعُ",32,"ع",1,0],["وقد سار مدحي فيك كلَّ مسيرة","مزحزحةٍ بل سال كلَّ مسيلِ",33,"ل",1,0],["وقد سيرْتُ أنكمُ غيوثٌ","تجودُ ولا تكون لها وُحولُ",34,"ل",1,0],["وقد سر المكارمَ أن أُدِلْتُم","كما سر المجمَّرةَ القفولُ",34,"ل",1,0],["وقد سُئلنَ أفيه ما يُعابُ له","فقلن هيهاتَ تلك العينُ عقيان",35,"ن",1,0],["وَقَد سَرَّني مِن قَيسِ عَيلانَ أَنَّني","رَأَيتُ بَني العَجلانِ سادوا بَني بَدرِ",36,"ر",1,0],["وَقَد سَقَتني رُضاباً غَيرَ ذي أَسَنٍ","كَالمِسكِ ذُرَّ عَلى ماءِ العَناقيدِ",37,"د",1,0],["وَقَد سَبَقَتنا أُمُّ عَمرو بِأَمرِها","وَكَانَت بِأَعناقِ المَطِيَّ أَظَلَّتِ",38,"ت",1,0],["وقد سطع الفجر المضيءُ حذاءه","ولاح بياض للصباح طويل",39,"ل",1,0],["وَقَد سَمِعتُ عَنكَ مِن ثِقاتِ","أَنَّكَ أَنتَ مَلِكُ النَباتِ",40,"ت",1,0],["وَقَد سَبَقَت رَكائِبِيَ القَوافي","مُقَلَّدَةً أَزِمَّتَها طِرابا",41,"ب",2,0],["وَقَد سارَ في مَسراكَ مِنها رَسولُهُ","فَما سارَ إِلّا فَوقَ هامٍ مُفَلَّقِ",42,"ق",1,0],["وقد سَمِعتْ أذنايَ نجوى فِراقِكمْ","فلا أبصرتْ عيني ولا سَمِعتْ أُذنِي",43,"ي",1,0],["وقد سَرَّني أنِّي من المالِ مُقْتِرٌ","ولا الوجهُ مبذولٌ ولا العِرضُ منهوبُ",44,"ب",1,0],["وَقَد سامَ طَعمَ المَنِّ ذَوقاً فَلَم يَجِد","بِهِ المَنَّ مَرضِيَّ المَذاقِ وَلا السَلوى",45,"و",2,0],["وَقَد سارَ في عَمرِو بنِ غَنمِ بنِ تَغلِبٍ","مَسيرَ اِبنِ وَهبٍ في عَجاجَةِ راسِبِ",46,"ب",1,0],["وَقَد سَرَّني أَن قيلَ وُجِّهَ مُسرِعاً","إِلى الشَرقِ تُحدى سُفنُهُ وَرَكائِبُه",47,"ب",2,0],["وَقَد سارَ موسى في جِبالٍ لَوَ اِنَّها","تُرادي الجِبالَ الراسِياتِ لَهُدَّتِ",48,"ت",1,0],["وَقَد سَرَّني أَنَّ الخَليفَةَ جَعفَراً","غَدا زاهِداً في أَهلِها وَبِلادِها",49,"د",3,0],["وَقَد ساءَني أَن لَم يَهِج مِن صَبابَتي","سَنا البَرقِ في جِنحٍ مِنَ اللَيلِ أَخضَرِ",50,"ر",1,0],["وَقَد سَرَّني أَنَّ الخِلافَةَ فيكُمُ","مُخَيِّمَةٌ ما إن يُخافُ اِنتِقالُها",51,"ل",3,0],["وَقَد سَبَقَت أَيادٍ مِنكَ بيضٌ","وَآلاءٌ إِذا حُمِلَت ثِقالُ",52,"ل",1,0],["وَقَد سَأَلتُ فَما أُعطيتُ مَرغَبَةً","وَكانَ حَقِّيَ أَن أُعطى وَلَم أَسَلِ",53,"ل",1,0],["وَقَد سُمِّنَت حَتّى كَأَنَّ مَخاطَها","هِضابُ القَليبِ أَو فَوادِرُ عَضوَرا",54,"ر",2,1],["وَقَد سَخِطَت مِنّي نَوارُ الَّذي اِرتَضَت","بِهِ قَبلَها الأَزواجُ خابَ رَحيلُها",55,"ل",3,0],["وقد سفَرَ الأُفقُ عن شِدَّةٍ","لسانُ السَّماء بها ناطِقُ",56,"ق",1,0],["وقد سَلَّتْ جيوشُ الفِطْرِ فيه","على شَهْرِ الصِّيامِ سيوفَ باسِ",57,"س",1,0],["وَقَد سَتَرَ السَحابُ ذُكا وَفُضَّت","جَلابيبُ الغُيومِ عَلى الفَضاءِ",58,"ا",2,0],["وَقَد سَما قَبلي يَزي","دُ طالِباً شَأوَ العُلى",59,"ا",1,0],["وقد سَكِرَتْ صِعادُ الخطّ حتى","تأوّدَ كلّ لدنٍ مستقيمِ",60,"م",1,0],["وقَد سَفِرت عَن صفرةٍ عَبْرَ الأسى","لعيني بها عن وَجْد قلبٍ مفجَعِ",61,"ع",1,0],["وقد سكّنَتْ حركاتِ الأسى","قيانٌ تُحَرّكُ أوتارها",62,"ر",3,0],["وَقَد سَوَّدَ الديوانُ بَعضَ ثِيابِهِ","وَأَحسَنُ ما تُستَوضَحُ الشَمسُ في الدَجنِ",63,"ن",1,0],["وَقَد سَدَّ مَندوحَةَ القاصِعاءِ","مِنهُم وَأَمسَكَ بِالنافِقاءِ",64,"ا",2,0],["وقَدَّسْتُ ذِكراكَ لم انتحِلْ","ثِيَابَ التُّقَاةِ ولم أَدَّعِ",65,"ع",1,0],["وَقَد سَقَطَ النورُ فَوقَ الغَديرِ","فَأَثبَتَت في دِرعِهِ أَنصُلا",66,"ل",2,0],["وَقَد سَكَتَ الوُشاةُ اليَومَ عَنّي","أَقَرَّ الخَصمُ فاِرتَفَعَ النِزاعُ",67,"ع",1,0],["وقُدِّسَ فِينا بِحبِّ الصَلاة","جَميعاً وعَلّمَ خَطَّ القَلَم",68,"م",1,0],["وَقَد سُدَّ مَجرى البَولِ مِن بَطنِ جِعثِنٍ","بِعَقفاءَ تَسقيها إِذا اِختَلَّ ثيلُها",69,"ل",3,0],["وَقَد سَقى مُفلِحَ كَأسَ القَتلِ","وَشَكَّهُ بِمِخصَفٍ ذي نَصلِ",70,"ل",1,0],["وَقد سَجَدَتْ لهُ أَغصانُ سَرْحٍ","فلِمْ لا يؤْمِنُ الظَّبْيُ الرَّبِيبُ",71,"ب",1,0],["وَقَدْ سَرقُوا الْغِلالَ وما عَلِمْنا","كما سَرَقَتْ بَنُو سَيْفِ الجُرُونا",72,"ن",2,0],["وقد سَلَبَتْه الزّاعبيّةُ ما ادّعى","فأصْبحَ تِنّيناً وأمسَى ذُرَحْرَحا",73,"ح",2,0],["وَقَد سُئِلوا عَن عِباداتِهِم فَما","أَيَّدوها وَلا ثَبَّتوا",74,"ت",3,0],["وَقَد سُمِّيَ المَرءُ الهِزَبرَ تَفاؤُلاً","وَلَيسَ بِباقٍ في اللَيالي هِزَبرُها",75,"ر",3,0],["وَقَد سَقَتهُم غَماماتٌ بَكَت زَمَناً","بِلا اِبتِسامٍ فَما جادوا وَلا دَمِعوا",76,"ع",3,0],["وَقَد سَئِمنا زَمَناً مُؤذِياً","أَروَحُ مِن سالِمِهِ التالِفُ",77,"ف",1,0],["وَقَد سَرَّ المَعاشِرَ باقِياتٌ","مِنَ الأَنباءِ سِرنَ لِيَستَفِضنَه",78,"ن",2,0],["وَقَد سَأَلَت عَنّي الوُشاةُ فَخُبِّرَت","وَقَد نُشِرَت مِنها لَدَيَّ صَحائِفُ",79,"ف",1,0],["وَقَد سائَني أن النوى أَخذت بنا","تشطّ وأن الشمل غير جَميع",80,"ع",1,0],["وَقَد سترت لَيلى الحَقيقة وَجهها","وَللعين حظ منه لَو رفع الستر",81,"ر",1,0],["وقد سارَ ذكْري في البلادِ فمَن لهمْ","بإِخفاءِ شمسٍ ضَوْؤها مُتكامل",82,"ل",1,0],["وقد سَمّاهُ سَيّدُهُ عَلِيّاً","وذلكَ مِن عُلُوّ القَدْرِ فال",83,"ل",1,0],["وَقَد سِرتُ يا بِنتَ الكِرامِ مُبادِراً","وَتَحتِيَ مَهرِيٌّ مِنَ الإِبلِ أَهوَجُ",84,"ج",1,0],["وَقَدْ سَهِرُوا كَمَا بَكَرُوا","بِلاَ وَهَنٍ وَلاَ فَترِ",85,"ر",1,0],["وقد سَفَرَتْ أخلاقُهُ وتوضَّحَتْ","شَمائِلُهُ والصُّبحُ لا يَتَلثَّمُ",86,"م",1,0],["وقد سَمَتْ الزَوراءُ ترفَعُ رأسَها","على الأرض تِيهاً مثلَ نَسر مُحلِّق",87,"ق",1,0],["وقد سدت الأفق العجاجة والتقت","جحافل يحدوها الردى وقطائع",88,"ع",1,0],["وَقَدْ سَرّني أنّ الخَليفَةَ جَعْفراً","غَدا نَاهِداً، في أهلِهَا، وَبِلاَدِهَا",89,"د",3,0],["وقد سُئلنَ: أفيه ما يُعابُ له","فرعاً غذَتْه الغوادي فهو فَينان",90,"ن",1,1],["وقد سجدتْ لها الأنظارُ لما","أرَتنا الحُسر يَرْفُل في القَباطِي",91,"ط",2,0]]}