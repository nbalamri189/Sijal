x?id=128846",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5431,"السيجارة تتكلم ...","https://www.poetsgate.com/ViewPoem.aspx?id=205897",""],[5689,"أظل خيالي أم ضرام جهنم","https://www.poetsgate.com/ViewPoem.aspx?id=143403",""],[5956,"وليمة فكاهية","https://www.poetsgate.com/ViewPoem.aspx?id=184644",""],[5956,"أخاف عليه من جِلْدي","https://www.poetsgate.com/ViewPoem.aspx?id=193083",""],[5956,"إذا استبصرتَ نيّاتي","https://www.poetsgate.com/ViewPoem.aspx?id=194411",""],[5957,"للتسامح ِ ضفافٌ","https://www.poetsgate.com/ViewPoem.aspx?id=183596",""],[5957,"أحبكِ وردة","https://www.poetsgate.com/ViewPoem.aspx?id=183927",""],[6056,"جرح السنين","https://www.poetsgate.com/ViewPoem.aspx?id=130356",""],[6142,"في ذكره الله آخى المسلمين وسا","https://www.poetsgate.com/ViewPoem.aspx?id=155717",""],[6239,"من خلف غبار الوهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75991&r=&rc=39",""]],"verses":[["بهذا الفعلِ سرَّك أن تُسمَّى","جواداً مُفْضِلاً فأبَحْتَ أهلك",0,"ك",1,0],["بِهذَيْنِ فادْعُ اللَّهَ لي ثمّ بالغِنَى","غِنَى القلبِ إنّ المُعْدِمَ القلبِ طائحُ",1,"ح",1,0],["بهذا ألاقي الله يوم لقائه","وهذا هو الحق الذي أنا قائل",2,"ل",1,0],["بِهَذَا تَسَامى كُلُّ مَنْ رَاضَ نَفْسَهُ","وَقَوَّمَ مِنْ أَخْلاَقِهِ مَا تَأَوَّدَا",3,"د",2,0],["بِهذَا اليَوْمِ حُقِّقَ مَا تَمَنَّتْ","نُفُوسُ الْعُرْبِ دَهْراً بعْدَ دَهْرِ",4,"ر",1,1],["بهذه الخطة نشفي غيظنا","ان كان بالسيف أخو الغيظ اشتفى",5,"ا",1,0],["بهذه الخطة نرضي ربنا","ان كان فينا طالب منه الرضا",5,"ا",1,0],["بهذه الخطة نبتاع العلى","في الدين والدنيا ونستوفي المنى",5,"ا",1,0],["بهذه الخطة نرقى سلبا","لغاية حض عليها ودعا",5,"ا",1,0],["بهذا الفعلِ سرَّك أن تُسمَّى","جواداً مُفْصِلاً فأبَحْتَ أهلك",6,"ك",1,0],["بهذا قضى الدهرُ في أهلهِ","تمرُّ فِئامٌ وتأتى فِئامُ",7,"م",1,0],["بهذى حظوا بالحب والشوق والشهود","مع شهد عرفان ومنهاج سنة",8,"ه",1,0],["بهذا أشار الناصحون لعلكم","ترقّون أو تأتي لنا منكم البشرى",9,"ر",2,0],["بهذا جرى قدرٌ سابقٌ","ومن لي بدفع صروف القدر",10,"ر",1,0],["بهذا الخيال الحلو ضاعت حلومكم","لكل خيالٍ كاذب الوهم خيفق",11,"ق",1,0],["بهذا العام يسقط كل حق","يقال له الخراج أو الضريب",12,"ب",1,0],["به ذلك الثغرُ المباركُ لم يزل","مصوناً من الأعداء عَذبَ المقبَّلِ",13,"ل",1,1],["بِهِ ذلّ العزيزُ وتِلكَ سيما","جَلالَتِه كَما عَزَّ الذليلُ",14,"ل",1,0],["بهذا بدا فضل الموجوِّد ماثلاً","كذلكَ فضل الضدِّ من ضده يُدرى",15,"ر",2,0],["بِهَذا قَضى اللَه في خَلقه","وَباب العِناية لَم يغلقِ",16,"ق",1,0],["بِهَذا جَرى حُكم الإِلَه وَإِنَّهُ","عَلى جَمعنا بَعدَ الفِراق قَديرُ",17,"ر",1,0],["بهذا أردتم نصر شرعة أحمد","وإنقاذ أهل الأرض من كل ظالم",18,"م",1,0],["بهذي الشمس أَقسم أَو ضحاها","وبالقمر المنير إِذا تلاها",19,"ا",3,0],["بهذا الحكمُ حين تحالباها","نقائضَ حاز زُبدتَها جريرُ",20,"ر",1,0],["بِهَذِهِ الأُضْحوكهْ","ومِثْلِ هَذي النَّوكهْ",21,"ه",1,0],["بهذا صار أمر الشعب فوضى","منظمة تثير الابتساما",22,"م",2,0],["به ذَوُوه تفخَرُ","وخيرُ ما يُذَّخَرُ",23,"ر",1,0],["بهذا ندين الله جل جلاله","فسل ربك بالتوفيق أي موحد",24,"د",1,0],["بهذا جاءنا في كل ليل","عن المعصوم من صحب وآل",25,"ل",1,0],["بِهِ ذَهَبَ اليَومَ الرَدى كُلَّ مَذهَبِ","كَأَنَّ الرَدى لَم يَدرِ ما هُوَ فاعِلُهُ",26,"ل",2,0],["بهذا وصائف خصت وكم من","زمان لإتمام هذا مضى",27,"ض",2,0],["بهذا أرى واحد السعي مثنى","نتائج فيهن أغنى وأعنى",28,"ن",2,1],["بهذا متاجرة الوزنات","مضعفة حسبما يشتهى",29,"ه",2,0],["بهذي الحقيقة نلفي نظام ال","وجود على الناس طرا قضى",30,"ض",2,0],["بهذا الرواق وهذا الرواء","تألف شملكمُ والْتأم",31,"م",1,0],["بهذا الفوز تبتهج البرايا","ويجمل بي نشيد التهنئات",32,"ت",1,0],["بِهَذا اليَوم جَهّزه بِأَلفٍ","إِلى قرمُونة وافى الصَوابا",33,"ب",2,0],["بهذّبها بالكر كل مجاهر","بسلب حياة القرن غير مخادع",34,"ع",1,0],["بهذا يجازى من يخاصم أميرنا","ومن يسعى طرق البغي لا شك يعثرُ",35,"ر",1,0],["به ذقت من خمر التلاقي عتيقها","فيا لك من خمر لقلبي مخامر",36,"ر",1,0],["بهذه الروح وهذا البدن","تلقى من الناس سهام ضغن",37,"ن",1,0],["بهذين طورا ينعمان وتارةً","بذينك بالأعداء ينتقمانِ",38,"ن",1,0],["بِهَذا يقادُ العِزُّ بَعدَ شِمَاسِهِ","وَلاَ يمكِنُ الإنتَاجُ إلا مِنَ الشكلِ",39,"ل",1,0],["بِهَذا رَأيتُ السَّمكَ أصبَحَ مَنزِلِي","وأنتَ كَمَا عَايَنتَ مَنزِلُكَ الوَهدُ",40,"د",1,0],["بهذا ترى ميمونة ان تركنا","لها لم يكن من اختبارا ولا زهدا",41,"د",2,0],["بهذا تواصى قبلنا قدماؤنا","وتمشي على الآثار فينا الشمائل",42,"ل",1,0],["بهذا تواصوا قبلنا قدماؤنا","ونحن على آثارهم نتناسل",43,"ل",1,0],["بهذا العقد قد حصل السرور","ولاحت للهنا فيه بدور",44,"ر",1,1],["بهذا أَدِينُ الله إِذْ من يَدِينُهُ","به عنده فَوْزٌ له ونَجاةُ",45,"ه",1,0],["بهذا قد أعطى كلُّ من كان خلقُه","كما قاله الرحمن في نصِّ قرآن",46,"ن",1,0],["بهذا يعرفُ الحقُ الذي لم","يزل يهدي الخليلَ إلى الخليلِ",47,"ل",1,0],["بهذا الهدى أضحى وذلك قد طغى","فطال ولولا ذاك ما خص بالجر",48,"ر",1,0],["بِهَذا العيد آيات التَهاني","لِسان سُعودكم لَكُم تَلاها",49,"ه",2,1],["بهذه الفواكه الصيفيه","الخضرة المقبِلة الطريه",50,"ه",1,0],["بهذا النحو صرف العمر جهل","فقم واجهد فما في الوقت مهل",51,"ل",1,0],["بهذا الضريح لقد حل قطب","عليه رحى الكون طرا تدور",52,"ر",1,1],["به ذكروا الاسراء وهو محلق","وقالوا براق العلم جاء به العصر",53,"ر",1,0],["بِهِ ذَرَفَت عَيناكَ لَمّا عَرَفتَهُ","وَكَيفَ طِبابى عَيِّنٍ قَد تَسَرَّبا",54,"ب",2,0],["بهذِي الليالي السود يَا خِلُّ إِذ دَجَتْ","طَفِقتَ بأكمامِ المَشيب تَلثَّم",55,"م",1,0],["بهذي الرِحابِ رِحابِ الكرام","أَنخَتُ رِكابي فَحاشى أُضام",56,"م",1,1],["بهذا العصر فضلك صار ظهراً","وهل يقوى على الشمس الخفاء",57,"ا",2,0],["بهذا وهذا نجاري الزمان","ونسبق في شوطه الأبعدِ",58,"د",1,0],["بهذا قضى بين البدور وأوجه الح","سان لساني والمخالف خطاء",59,"ا",2,0],["بهذا الفضل يكفي كل فضل","فخاراً ان يكون له سميا",60,"ي",2,0],["بهذه الأسماء فاهدِني إلى","أفضل ما تعلمه لي مُسْجَلا",61,"ل",2,0],["بهذه الجياد قربي ظلا","بعاتقي أنفاسها تحلا",62,"ل",2,0],["بِهَذا اليَوم لي عزٌّ","بِأَهلِ العزِّ وَالنَصرِ",63,"ر",1,0],["بِهَذا العيد يَهنؤ مَن تَولى","مَحاكم ثَغرنا وَالحَق يُجري",64,"ر",2,1],["بِهذِهِ الحالُ إِن صَحَّفت أَحرُفِها","رَأَيتُ غَيماً عَلى شَمسٍ بِهِ اِحتُجَبَت",65,"ت",1,0],["بهذا لقد أضحت عروسا حماتنا","وحق لها بالحسن أن تتفردا",66,"د",2,0],["بهذي أرخوني لي شهابٌ","وفي الأخرى مقارن