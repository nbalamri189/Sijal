{"poems":[[93,"طفلان كالأخوين مؤتلفان","https://www.aldiwan.net/poem11268.html","الكامل"],[47,"أتعز أنت على رسوم مغان","https://www.aldiwan.net/poem25112.html","الكامل"],[47,"أقول وقد ناحت بقربي حمامة","https://www.aldiwan.net/poem25173.html","الطويل"],[72,"ما لي إلى السلوان عنك سبيل","https://www.aldiwan.net/poem19478.html","الكامل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[105,"من يسعد الأوطان غير بنيها","https://www.aldiwan.net/poem43401.html","الكامل"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55007","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116966","الوافر"],[130,"الطبول الطبول إِنا انتصرنا","https://www.aldiwan.net/poem67451.html","الخفيف"],[161,"أيضيع مثلي عند اسماعيلا","https://www.aldiwan.net/poem58887.html","الكامل"],[211,"قسما بليل الشعر منك إذا سجا","https://www.aldiwan.net/poem13395.html","الكامل"],[236,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[281,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[306,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[404,"أي ضمير بارز","https://www.aldiwan.net/poem33760.html","مجزوء الرجز"],[404,"لولا الرجا ما انتهضت إرادة","https://www.aldiwan.net/poem34171.html","الرجز"],[438,"دعني أعلل قلبا فيك معمودا","https://www.aldiwan.net/poem2496.html","البسيط"],[465,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[480,"من للثكالى وللجرحى وأيتام","https://www.aldiwan.net/poem37205.html","البسيط"],[562,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[587,"الصب بحبه عليه وله","https://www.aldiwan.net/poem17829.html","الدوبيت"]],"verses":[["أَيُضَاعُ فِي غَيْرِ الهَوَى عَهْدُ الصِّبَا","وَالعُمْرُ مِنْ بَعْدِ الشَّبِيبَةِ فَانِي",0,"ن",2,0],["أَيُضيعُني مَن لَم يَزَل لِيَ حافِظاً","كَرَماً وَيَخفِضُني الَّذي أَعلاني",1,"ن",2,0],["أَيَضحَكُ مَأسورٌ وَتَبكي طَليقَةٌ","وَيَسكُتُ مَحزونٌ وَيَندِبُ سالِ",2,"ل",1,0],["إيضاح رأي قد حوى جمل العلى","فيه لكلِّ عريكةٍ تسهيل",3,"ل",1,0],["أيُّ ضِدٍّ من أجله لم يخالل","هُ وخلٍّ من أجله لم يعادِهْ",4,"د",2,0],["أيَضيمُني خَنِثُ الشمائل لو نضا","عنه غِلالته حَساهُ حاس",5,"س",1,0],["أَيَضنُّ مِنكُم بالمعونة موسرٌ","يلهو ويمرح كلَّ آنٍ فيها",6,"ي",3,0],["أيَضيقُ بِي أمرٌ وبابُ المصطفى","في الأرضِ أوسَعُ للعُفاةِ وَأرْحَبُ",7,"ب",1,0],["أَيَضِنُّ عَنهُ بِمالِهِ وَبِنَفسِهِ","صَبٌّ يَرَى لَهُما الفَواتَ حُصُولا",8,"ل",2,0],["أَيَضِيعُ مَجْدٌ لِلْكِنانة لَمْ يَكُنْ","لَوْلاَ التَّفَرُّقُ بَيْنكُمْ لِيَضِيعَا",9,"ع",2,0],["أَيُضَنُّ عَنْهَا بِالنَّفِيسِ وَدُونَها","يَهَبُ الحُمَاةُ نُفُوسَهُمْ بِسَخاءِ",10,"ا",2,0],["أيضمَنُ لي فتىً تركَ المعاصي","وأرهَنهُ الكفالةَ بالخلاص",11,"ص",1,1],["أَيضحَكُ مَقتول وتبكي طليقةٌ","ويَسكتُ محزونٌ ويندُبُ سالِ",12,"ل",1,0],["أيضيع مثلي عند اسماعيلا","وهو ابن أحمد ابن إسماعيلا",13,"ل",2,1],["ايضلني وانا الذي لم استطع","في الحب عن داك القوام تعوجا",14,"ج",2,0],["أَيَضِلُّ أَو يَصلى لَظىً مَن أَنتُمُ","شَفُعاؤُهُ وَإِلى الصِراطِ هُداتُهُ",15,"ت",2,0],["أَيُضَيِّعُ الْفِتْيانُ عَهْدَكَ إِنَّهُ","ما كنَ عِنْدَكَ عَهْدُهُمْ بِمُضَيَّعِ",16,"ع",1,0],["أَيضيع مجتازٌ بدار ضيافةٍ","زاداً وما يبقيه فيها يجمعُ",17,"ع",1,0],["أيُّ ضمير بارزٍ","ولا يرى مستتراً",18,"ر",2,1],["أيضاً ولا حج ولا صام ولا","أعطى زكاة ماله ولا نوى",19,"ا",1,0],["أيضعف الخصر عن بند القباء وقد","غدا بأعباء قتلي اليوم مجهودا",20,"د",2,0],["إيضاح مشكلة حماة مخوفة","أجواد مسبغة سهام نصال",21,"ل",1,0],["أيضاً وجامعة الإسلام تربطنا","بهم وتحكم ربطا أي إحكام",22,"م",1,0],["إِيضاعُ بَينَ الخِضرِماتِ وَهَجَر","مُعَلِّقينَ في الكَلاليبِ السُفَر",23,"ر",1,0],["إِيضاحُ غَرَامِهِ لَهُ تَكْمِلهُ","إن كانَ مُفصَّل الهَوى مُجْمَلهُ",24,"ه",1,0]]}