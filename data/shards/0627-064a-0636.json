{"poems":[[93,"طفلان كالأخوين مؤتلفان","https://www.aldiwan.net/poem11268.html","الكامل"],[47,"أتعز أنت على رسوم مغان","https://www.aldiwan.net/poem25112.html","الكامل"],[47,"أقول وقد ناحت بقربي حمامة","https://www.aldiwan.net/poem25173.html","الطويل"],[72,"ما لي إلى السلوان عنك سبيل","https://www.aldiwan.net/poem19478.html","الكامل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[105,"من يسعد الأوطان غير بنيها","https://www.aldiwan.net/poem43401.html","الكامل"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55007","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116966","الوافر"]],"verses":[["أَيُضَاعُ فِي غَيْرِ الهَوَى عَهْدُ الصِّبَا","وَالعُمْرُ مِنْ بَعْدِ الشَّبِيبَةِ فَانِي",0,"ي",1,0],["أَيُضيعُني مَن لَم يَزَل لِيَ حافِظاً","كَرَماً وَيَخفِضُني الَّذي أَعلاني",1,"ن",2,0],["أَيَضحَكُ مَأسورٌ وَتَبكي طَليقَةٌ","وَيَسكُتُ مَحزونٌ وَيَندِبُ سالِ",2,"ل",1,0],["إيضاح رأي قد حوى جمل العلى","فيه لكلِّ عريكةٍ تسهيل",3,"ل",1,0],["أيُّ ضِدٍّ من أجله لم يخالل","هُ وخلٍّ من أجله لم يعادِهْ",4,"د",2,0],["أيَضيمُني خَنِثُ الشمائل لو نضا","عنه غِلالته حَساهُ حاس",5,"س",1,0],["أَيَضنُّ مِنكُم بالمعونة موسرٌ","يلهو ويمرح كلَّ آنٍ فيها",6,"ي",3,0],["أيَضيقُ بِي أمرٌ وبابُ المصطفى","في الأرضِ أوسَعُ للعُفاةِ وَأرْحَبُ",7,"ب",1,0],["أَيَضِنُّ عَنهُ بِمالِهِ وَبِنَفسِهِ","صَبٌّ يَرَى لَهُما الفَواتَ حُصُولا",8,"ل",2,0],["أَيَضِيعُ مَجْدٌ لِلْكِنانة لَمْ يَكُنْ","لَوْلاَ التَّفَرُّقُ بَيْنكُمْ لِيَضِيعَا",9,"ع",2,0],["أَيُضَنُّ عَنْهَا بِالنَّفِيسِ وَدُونَها","يَهَبُ الحُمَاةُ نُفُوسَهُمْ بِسَخاءِ",10,"ا",2,0],["أيضمَنُ لي فتىً تركَ المعاصي","وأرهَنهُ الكفالةَ بالخلاص",11,"ص",1,1]]}