tps://poetry.dctabudhabi.ae/diwan/poem/130869","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133115","المجتث"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66163","المتدارك"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57974","المتقارب"],[4682,"هدى غالية","https://www.poetsgate.com/ViewPoem.aspx?id=66202",""],[4759,"أي ضدين؟","https://www.poetsgate.com/ViewPoem.aspx?id=204020",""],[4578,"خطرت لأعطاف المحاسن ثانية","https://www.poetsgate.com/ViewPoem.aspx?id=49618",""],[4859,"نخوة العرب!","https://www.poetsgate.com/ViewPoem.aspx?id=187261",""],[5038,"رحيق الورد","https://www.poetsgate.com/ViewPoem.aspx?id=190110",""],[5038,"حبيس الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=197668",""],[5131,"أَيضحكُ مأسورٌ نعمْ ويكبّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=55360",""],[5198,"طفل الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=135210",""],[5206,"الرد على منكر علم الحِكمة","https://www.poetsgate.com/ViewPoem.aspx?id=187403",""],[5285,"حكايا الأمس والموال","https://www.poetsgate.com/ViewPoem.aspx?id=203200",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5376,"أناختْ على هجرِ المطايا نجائبي........يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=188567",""],[5397,"أجريت قلبي بالدموع مذابا","https://www.poetsgate.com/ViewPoem.aspx?id=157905",""],[5442,"ذاك الفراق وان أصم مسامعي","https://www.poetsgate.com/ViewPoem.aspx?id=114744",""],[470,"لماذا..؟!","https://www.poetsgate.com/ViewPoem.aspx?id=178067",""],[5680,"قريب على بعد أنا منك","https://www.poetsgate.com/ViewPoem.aspx?id=204357",""],[5732,"وناديت من حولي","https://www.poetsgate.com/ViewPoem.aspx?id=177827",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5956,"أ عَلِمتَ كم أفراحنا تنتابُنا؟","https://www.poetsgate.com/ViewPoem.aspx?id=193350",""],[5956,"هي سامِيا العظمى محمدُ سالكٍ","https://www.poetsgate.com/ViewPoem.aspx?id=215550",""],[5961,"والله اليوم عيد","https://www.poetsgate.com/ViewPoem.aspx?id=199808",""],[6323,"يا ساكن الأعماق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82169&r=&rc=0",""]],"verses":[["أَيُضَاعُ فِي غَيْرِ الهَوَى عَهْدُ الصِّبَا","وَالعُمْرُ مِنْ بَعْدِ الشَّبِيبَةِ فَانِي",0,"ن",2,0],["أَيُضيعُني مَن لَم يَزَل لِيَ حافِظاً","كَرَماً وَيَخفِضُني الَّذي أَعلاني",1,"ن",2,0],["أَيَضحَكُ مَأسورٌ وَتَبكي طَليقَةٌ","وَيَسكُتُ مَحزونٌ وَيَندِبُ سالِ",2,"ل",1,0],["إيضاح رأي قد حوى جمل العلى","فيه لكلِّ عريكةٍ تسهيل",3,"ل",1,0],["أيُّ ضِدٍّ من أجله لم يخالل","هُ وخلٍّ من أجله لم يعادِهْ",4,"د",2,0],["أيَضيمُني خَنِثُ الشمائل لو نضا","عنه غِلالته حَساهُ حاس",5,"س",1,0],["أَيَضنُّ مِنكُم بالمعونة موسرٌ","يلهو ويمرح كلَّ آنٍ فيها",6,"ي",3,0],["أيَضيقُ بِي أمرٌ وبابُ المصطفى","في الأرضِ أوسَعُ للعُفاةِ وَأرْحَبُ",7,"ب",1,0],["أَيَضِنُّ عَنهُ بِمالِهِ وَبِنَفسِهِ","صَبٌّ يَرَى لَهُما الفَواتَ حُصُولا",8,"ل",2,0],["أَيَضِيعُ مَجْدٌ لِلْكِنانة لَمْ يَكُنْ","لَوْلاَ التَّفَرُّقُ بَيْنكُمْ لِيَضِيعَا",9,"ع",2,0],["أَيُضَنُّ عَنْهَا بِالنَّفِيسِ وَدُونَها","يَهَبُ الحُمَاةُ نُفُوسَهُمْ بِسَخاءِ",10,"ا",2,0],["أيضمَنُ لي فتىً تركَ المعاصي","وأرهَنهُ الكفالةَ بالخلاص",11,"ص",1,1],["أَيضحَكُ مَقتول وتبكي طليقةٌ","ويَسكتُ محزونٌ ويندُبُ سالِ",12,"ل",1,0],["أيضيع مثلي عند اسماعيلا","وهو ابن أحمد ابن إسماعيلا",13,"ل",2,1],["ايضلني وانا الذي لم استطع","في الحب عن داك القوام تعوجا",14,"ج",2,0],["أَيَضِلُّ أَو يَصلى لَظىً مَن أَنتُمُ","شَفُعاؤُهُ وَإِلى الصِراطِ هُداتُهُ",15,"ت",2,0],["أَيُضَيِّعُ الْفِتْيانُ عَهْدَكَ إِنَّهُ","ما كنَ عِنْدَكَ عَهْدُهُمْ بِمُضَيَّعِ",16,"ع",1,0],["أَيضيع مجتازٌ بدار ضيافةٍ","زاداً وما يبقيه فيها يجمعُ",17,"ع",1,0],["أيُّ ضمير بارزٍ","ولا يرى مستتراً",18,"ر",2,1],["أيضاً ولا حج ولا صام ولا","أعطى زكاة ماله ولا نوى",19,"ا",1,0],["أيضعف الخصر عن بند القباء وقد","غدا بأعباء قتلي اليوم مجهودا",20,"د",2,0],["إيضاح مشكلة حماة مخوفة","أجواد مسبغة سهام نصال",21,"ل",1,0],["أيضاً وجامعة الإسلام تربطنا","بهم وتحكم ربطا أي إحكام",22,"م",1,0],["إِيضاعُ بَينَ الخِضرِماتِ وَهَجَر","مُعَلِّقينَ في الكَلاليبِ السُفَر",23,"ر",1,0],["إِيضاحُ غَرَامِهِ لَهُ تَكْمِلهُ","إن كانَ مُفصَّل الهَوى مُجْمَلهُ",24,"ه",1,0],["أَيَضحك مِن جَهلي أَيَزعَم أَنَّني","بَليد غَليظ الحس غَير مدافع",25,"ع",1,0],["أيّ ضرٍّ تقابلون عليهِ","مدنفاً مضَّهُ ولوعٌ وكربُ",26,"ب",1,0],["أيضن بالغيث السحا","ب وطالما والى بروقه",27,"ق",2,0],["أيضيعه أحد وتلك وصية","لذويه بالحق الذي لا يجحد",28,"د",1,0],["أيضيقُ الإنسانُ يوماً بإنسا","ن وعند السباع مرعى ومأوى",29,"و",2,0],["أيضن بالمال الحلال على بني","واديه من دمُه لهم مبذول",30,"ل",1,0],["أُيُضيعُ اللهوَ مَنْ لي","س لحزمٍ بِمُضيع",31,"ع",1,0],["أيُضيعها الجشمى فيما بيننا","أم هل إذا وصلت إليك تضيع",32,"ع",1,0],["أيضح اجماع وقوم جلهم","ما بين مسحوب وبين قتيل",33,"ل",1,0],["أيضمّ منك القبرُ طودَ نهًى","بعلاه سامت ذروةَ النسرِ",34,"ر",1,0],["أيضيقُ عنَّا جاهُكم ولقد","وَسِعَ الوجودَ وكنتم سببه",35,"ب",2,0],["أيضاً فلا شيء عليه وإن يكن","في الغسل قصر ساعة الذعر",36,"ر",1,0],["أيضا فلا شيء عليه وإن يكن","أمنى وسال الشبرُ بالقطرِ",36,"ر",1,0],["أَيضاً أَزَجُّ الحاجِبَينِ مُفَلَّجُ ال","أسنانِ ثَغرُهُ وَاسِعٌ يُبدى الدُّرَر",37,"ر",1,0],["أَيضاً وَيَقبَلُ مِن صِحَابٍ عُذرَهُم","بَل لا بِمَكرُوهٍ يُقَابِلُ مَن حَضَر",38,"ر",1,0],["أَيضاً وَيَمزَحُ مَع صَحَابَتِهِ وَلا","أَبَداً يَقُولُ سِوَى الذِى يَرضَاهُ بَر",38,"ر",1,0],["أَيضاً خُزَيمَةَ ثُمَّ مُدرِكَةَ الفَتَى","أَيضاًُ وَإِلياسَ الشَّهيرَ كَذَا مُضَر",39,"ر",1,0],["أيضاً وبالآلِ الكِرَامِ أُولِى الكِسا","سُفُنِ النَّجاةِ وصَحبِهِ الصَّيدِ الغُرَر",40,"ر",1,0],["أَيضاً وَحَقِّق رَبٍّ فِيكَ ظُنُونَنَا","حاشا تُخَيّبُ مَن إِلَيكَ قَدِ افتَقَر",40,"ر",1,0],["أيضاً مِنَ الرَّوعاتِ اَمِّنَّا وَمَن","ذَا الخَيرَ أَجرَى هَبهُ أَجراً قَد وَفَر",40,"ر",1,0],["أيضاً وفي جنّات عدن نهيم","صلوا عليه",41,"ل",3,0],["أيضحك شيبي في خدودي ومفرقي","وجفني باك والفؤاد مريض",42,"ض",1,0],["أيضل الركب في الليل البهيم","وأبو المهدي في الركب مقيم",43,"م",1,0],["أيضغى حبيبٌ صحَّ صدق صفائِهِ","لِنَفثِ حُبابٍ بالأكاذيب نضنضا",44,"ض",2,0],["أيضيق بيت علاك بي ولكم به","مثلي وعزك ركنه وعماده",45,"د",2,0],["أَيضيع وَترُكُمُ وَتلك جِيادُكُم","ملَّت عَلى حسن الثواء مقامَها",46,"م",3,0],["أيضا ونصبر على ما قد حصل","واستمها الديوله والمعقله",47,"ه",1,0],["أَيَضيق لُبنان بِمُسلمه","وَيَكون لِلقاصي وَلِلدّاني",48,"ن",2,0],["أيضا ورأسُ الخلَّبِ المعروفِ","بهِ كذاك الجاه ستَّه يُوفي",49,"ي",1,0],["أَيضاً وبرُّ النَّات وصَدرافَتَّن","وأندَمَندُ ثُمَّ فالي فاتقِن",49,"ن",1,0],["أيضاً مُرِاشي طَرَفُ السيلانِ","ثمَّ قَرَايا خدمةُ الرُّبَّانِ",49,"ن",1,0],["أيضاً ولوجانُ والأخوارُ","وقيل سُفالَه أيُّها البيطارُ",49,"ر",1,0],["أيضاً وفي بندر شِعبانٍ وفي","مَنكارَ سِتَّه أيُّها الخِلُّ الوفي",49,"ي",1,0],["أَيضاً ومجرى الباب نَسرُ الطَّائِرِ","ومِن شاطىء العارةِ لا تُكَابِرِ",50,"ر",1,0],["أيضاً إلى الجينِ أَيُّها السُّفَّار","لكن حذَارِ الكبسَ والعوار",50,"ر",1,0],["أيضاً وياتون لبرِّ الزَّنجِ","والهندِ نَقلاً عَن ذوي الإفرَنجِ",50,"ج",1,0],["أيضاُ دُمُوني وكذا مُلاَلي","نعشُ أحد عَشَر بلا محالِ",50,"ل",1,0],["أيضاً وأفشاتٌ مع شعوبِ","وكونها عنه إلى الجنوبِ",50,"ب",1,0],["أيضاً وفي الدَّامَن بِثَلثِ شُقَّه","وداسجٌ في الجوش فآعرِف حقَّه",51,"ه",1,0],["أيضاً إلى مُتبَلَ قُطبُ الجاهِ","أعني لَكَ الجاه ستَّةٌ زواهي",52,"ي",1,0],["أيضاً وتَكوَة أيُّها الرُّبَّان","هُم جُزُرٌ جمٌّ بلا شِعبان",52,"ن",1,0],["أيضاً وفي المُحنِثِ ثمَّ القُطبِ","لأَنَّها كبيرةٌ بالقُربِ",52,"ب",1,0],["أيضاً إلى كَمرَان شَطَّ البَحرِ","خُصُوصَ في الألحَاقِ فآسهَر وآجرِ",53,"ر",1,0],["أَيضاً وهَانُوَه فَلاَ تَعَدَّى","من ذيب الجزيره من يديكَ البَلدا",54,"د",2,0],["أيضاً وشيح ديبُ وكارَديبُ","الجاهُ نصفُ اصبَعِ لا يغيبُ",54,"ب",1,0],["أيضاً وبينَ مَسقَطٍ والسِّندِ","كذاك قد حُقَّ حسابُ رشدي",55,"ي",1,0],["أَيضاً وبرُّ النَّاتِ في السُّهَيلِ","مغيبِهِ فافهَم لذا التَأَويلِ",55,"ل",1,0],["أيضاً وعشرونَ مِنَ الليالي","وفوقَهُم ثلاثُ للكمالِ",56,"ل",1,0],["أَيضاً وسَهمُ القوسِ والفراقِد","في ذلك الموسِم تَرَاهُ واكِد",56,"د",1,0],["أيضاً ويونس لولا تاب مات كما","فرعون في ظلمات البحر شر قانا",57,"ن",2,0],["ايضا وسبقِ حقوقه وخصالهِ","وفعالِه ومقالِه المصداق",58,"ق",1,0],["أيضام وهو قد احتمى","بحبيب مولاه ولاذ",59,"ذ",1,0],["أيضر نور الشمس شيء أن تكن","خفيت على عين الضرير الأرمص",60,"ص",1,0],["أَيضاً وَوالي حَلب الهَزبر","فَكَم لَهُ تِلكَ اللَيالي صَبر",61,"ر",1,0],["أيضاً وقال ظعينة في روضة","تسمى بخاخ تستعد لمكة",62,"ه",1,0],["أيضاً ومن سقر وهاوية ومن","غضب الاله فذاك أعظم حيرة",62,"ه",1,0],["أيضل قلبي عن رشاد ودادكم","وهواكم ديني وعقد ولائي",63,"ي",1,0],["أيضام من هو جار حامي الجا","ر أو يخشى امرؤٌ آباؤه الشفعاء",64,"ا",2,0],["أيضيق بي الوادى كفافا بينما","يجنى الثمار بشاطئيه طغام",65,"م",1,0],["ايضا ويتحفهم جوداً برؤيته","من غير كيف تعالى بارىء النسم",66,"م",1,0],["ايضا وسترا لعورات امرت بها","فكشفها موجب للعن والغمم",66,"م",1,0],["ايضا واربعون زيل العقبه","مقامهم هيبته مرجبّه",67,"ه",1,0],["أيضا إلى شرطيّةٍ متصله","ومثلها شرطيّة منفصله",68,"ه",1,0],["أيضام سائل بره اطلبه لأي","يٍ إنه برٌّ لقوم عناء",69,"ا",2,0],["أيضام مثلي وهو مادح أحمدٍ","وأرى الشقاق وللرشيد وجود",70,"د",1,0],["أيضل ذو عقل وذو","بصر على علم سبيله",71,"ل",2,0],["أيَضِلُّ الرّكْبُ اليمانيُّ قَصْداً","وسَنا البرْق قدْ هَدَى أظْعانَهْ",72,"ن",2,0],["أيضاً وتصحبنا خفي معية","في الظعن والأسفار والآناء",73,"ا",2,0],["أيضاً تجود على الضعيف برحمةٍ","مع عفوك المعدود للخطاء",73,"ا",2,0],["أيضاً من الظلمات تخرجنا إلى","نور اليقين وجملة الأبناء",73,"ا",2,0],["أيضاً وتحيينا حياة سعادةٍ","حتى ننال مراتب السعداء",73,"ا",2,0],["أيضاً وأيقظ من فتور همةً","لجميعنا يا أكرم الكرماء",73,"ا",2,0],["أيضاً وترسل في المهابة منك من","كل العيون مدامعاً كدماء",73,"ا",2,0],["أيضر إشعال الدخان لطمس نو","ر الشمس بل تعشى عيون الشاعل",74,"ل",1,0],["أيضاً وإن الرزق كان بقسمة","بوس اللبيب وطيب عيش الأحمق",75,"ق",1,0],["أيضحن الطفل إيثارا لراحته","ويهمل الرقص وهو القصد والأرب",76,"ب",1,0],["أَيَضِيقُ بي حَرَمُ اصْطِناعِكَ بَعْدَما","قَدْ كانَ مُنْفَرِجاً عَلَيَّ مُوَسَّعا",77,"ع",2,0],["أيضا بما يكون خارجا على","حقيقة وغيرها قد حملا",78,"ل",2,0],["أيضام الخليل من بعد ما كان","إليكم له هوى التجاء",79,"ا",2,0],["أيُّ ضنَىً لمَ تُهدهِ وَعاشقٍ","لَم تَهدهِ وأَدمُعِ لَم تُجرِها",80,"ر",3,0],["أَيُضام من أَلبسته الدرعَ الَّتي","دَلَّت على أَن الرسول به اِعتنى",81,"ن",2,0],["أَيضام المحبُّ في حُبِّ طه","وَمُحبّ الحَبيبِ ليسَ يُضامُ",82,"م",1,0],["أيضلُّ المحبُّ عن نَهج طه","وَيَمين المحبّ لا أَنساهُ",83,"ا",2,0],["أيضاً وفي أولاد من قد أشركا","مع غيرها فنعم ذاك مسلكا",84,"ك",2,0],["أيضاً والجمال","ذي السر مولى الدويله",85,"ه",1,0],["أَيَضُمُّ سُلَيْمَى مَرْقَدُها","وانا مَنْ شُوِّكَ مَرْقَدُهُ",86,"د",2,0],["أيضاً وعمَّتها فافهمَنْ","أخت أبيها لأم وآب",87,"ب",1,0],["ايضا ودنس كتاب الله وحنا في رقاد","وفوق هذا انحى علينا ياهدى بالايمة",88,"م",2,0],["أي ضدين فيهما نتلاقى","غربة في مدائن ﻻتتاح ..!؟",89,"ح",1,1],["ايضاح علياه بإفصاح الثنا","تنوير دهر قد أنار دياجيه",90,"ي",2,0],["أي ضمير سيذكي نخوةَ العربِ","مادام كاهنهم بوتين في طربِ!",91,"ب",1,1],["أيضنُّ الثغْرُ كرْمتَهَ","ولقدْ أذْبلها الْأملُ",92,"ل",1,0],["أَ يَضْحَكُ مَنْ في الْقَيدِ غُلَّ جِناحُهُ","وَيَبْكي طَليقُ الطَّيرِ وَهْوَ يُعالي",93,"ل",2,0],["أَيضحكُ مأسورٌ نعمْ ويكبّرُ","لمستقبلٍ يهوي به متكبرُ؟",94,"ر",1,1],["ايضا واحب الصعب وامشي طريقه","من خلقتي يغريني الصعب واغريه",95,"ي",2,0],["أيضًا وَكَم فِيهَا كِتَابٌ رَاسِخٌ","قَدْ قِيلَ ألفٌ كُلُّهُنَّ شُمُوسُ",96,"س",1,0],["أيضلُّ عن دربِ اللقاءِ شعاعُها","ويضيعُ في وسطِ الزحامِ سؤالُ ؟!",97,"ل",1,0],["أيضاً حنيفه قد صلت لقبلتنا","لكنهم أشركوا الكذاب طغيانا",98,"ن",2,0],["أيضحك محزونٌ ويبكي مفارقٌ","ويصيحُ أرزاءً بعينٍ سواكبِ",99,"ب",1,0],["أيضيع هدراً للعدى دم سيد","لعلاه أبطح مكة قد هابا",100,"ب",2,0],["أيضيق عن ذنبي وان ضاق الفضا","عنه حمى هذا النوال الواسع",101,"ع",1,0],["أيُّ ضلعٍ من أضلعي.. فَرْطَ حبي","لم أُقوِّسهُ وهو يَدمى عليكِ؟!",102,"ك",1,0],["أيضحك مأسور وتبكي طليقة","فصبرا فإن العسر يستصحب اليسرى",103,"ر",2,0],["ايضا وانا من قول من كان ما خاف","ارقد بامان الله ولو ما معي سيف",104,"ف",1,0],["أيضًا، وفي صفِّين طرًّا، ثمَّ في","جمل، وقد كانوا له أحبابا",105,"ب",2,0],["أ يضاف للحرمين طهرٌ ثالث","هو جُودك الأتقى الذي قد صاننا؟",106,"ن",2,0],["أيضاً تشير لبنكنا ولنهجه","في أنه غوثٌ لكل غريق",107,"ق",1,0],["أيضاً علي وفا والمرسي زوي الصفا","العرشي من قفى آثارهم يا زيد",108,"د",1,0],["أيضرُّ هامتك البهية حاقدٌ","يبغي تسلُّقَ قمة الأنجادِ",109,"د",1,0]]}