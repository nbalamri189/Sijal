السعادة قد اظل زمانها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577667",""],[6213,"الناس أسرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76273&r=&rc=30",""],[6225,"حلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80912&r=&rc=181",""],[6234,"ديواني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6528&r=&rc=0",""],[6244,"ربيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=509&r=&rc=2",""],[6260,"نحن المصادر والموارد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68324&r=&rc=16",""]],"verses":[["راجِع أَحَبَّتُكَ الَّذينَ هَجَرتَهُم","إِنَّ المُتَيَّمَ قَلَّ ما يَتَجَنَّبُ",0,"ب",1,0],["راجينَ فيهِ لديْكَ فضْلَ شَفاعةٍ","ومؤمِّلينَ مَقامَكَ المحْمودا",1,"د",2,0],["راجا يَطيرانِ مُعوَجَّينِ في سَرَعٍ","وَلا يَريعان حَتّى يَهبِطا أُنُفا",2,"ف",2,0],["رَاجِعْ ضَمِيرَكَ مَا اسْتَطعْ","تَ وَلاَ تُهَادِنْهُ عَتَابَا",3,"ب",2,0],["رَاجِحَ الفِعْلِ قِيمَةً","عِنْدَ مَا تُوزَنُ الْقِيَمْ",4,"م",1,0],["راجَعتُ بَعدَ سُلُوِّهِنَّ صَبابَةً","وَعَرَفتُ رَسمَ مَنازِلٍ أَبكاني",5,"ن",2,0],["رَاجِحِي الوَزنِ كَامِلِي العَدلِ في","السِيرةِ طَبِيِّن بالأُمورِ الجِشَامِ",6,"م",1,0],["راجعْ يقينكَ في ودِّي ودع عصباً","لرأيهم في اقترابي منك تبعيد",7,"د",1,0],["راجَعَ من بعد سلوةٍ ذِكَرَهْ","وواصَلَ الظبي بعدما هَجَرَهْ",8,"ر",2,1],["راجعتُ بعد الجهل حِجْرا","وأطعتُ زاجرةً وزَجرا",9,"ر",2,1],["راجحة الوزنِ وهْي شائلةٌ","عن قَدْرِك الراجح المثاقيلِ",10,"ل",1,0],["راجعتنا في جلال وسكوت","وتوالت صور الماضي الحزين",11,"ن",1,0],["راجيكَ مُستَشعِرٌ حَربَ الخُطوبِ وَما","غَيرُ الخَطابَةِ وَالأَشعارِ مَفزَعُهُ",12,"ع",2,0],["راجِحٌ بي ميزانُ مُلكٍ وَمَجدٍ","لَيسَ فيهِ مِنَ الأَنامِ كَفِيُّ",13,"ي",1,0],["رَاجِياً أَنْ تعودَ أعمالُه السُّو","ءُ بِغُفْرَانِ اللَّهِ وَهْيَ هَباءُ",14,"ا",2,0],["راجَعتَ دينَكَ أَم عَنَّت لَكَ الذُكَرُ","أَم ما بَدا لَكَ لا تَصحو وَلا تَقِرُ",15,"ر",1,1],["راجَعتُ مِن كَلَفٍ لِعَبدَةَ دَيدَناً","لا أَستَطيعُ بِهِ القِيامَ وَحيدا",16,"د",2,0],["راجِياً حُسنَ حالَةٍ إِن تَخَطَّت","ني فَإِعمالُها لِيَحسُنَ ذِكرُ",17,"ر",1,0],["راجحت أعلامهم في كل ما وَضَعوا","من العلوم فما خفت موازيني",18,"ن",2,0],["راجياتٍ بأنْ تَحُلّ رَجَاها","مَشْرَباً بارِداً ومَرْعًى نَضيرا",19,"ر",2,0],["رَاجَعْتُ فِهْرِسَ آثَارِي فَمَا لَمَحَتْ","بَصِيرَتِي فِيهِ مَا يُزْرِي بِأَعْمَالِي",20,"ل",2,0],["رَاجِحُ الحِلْمِ وَلا يُخْ","طِئْكَ فِيمَا نَابَ حِلْمُ",21,"م",1,0],["رَاجَعَ العَقْلَ فِي الحَقَائِقِ وَاسْتَهْ","دَى بِهِ فِي غَيَاهِبِ المُشْكِلاَتِ",22,"ت",1,0],["رَاجِياً غَيْرَ مَا رَجَا النَّاسُ مِنْهَا","وَارِداً غَيْرَ حَوْضِهَا المَوْروُدِ",23,"د",1,0],["راجح الايمان معصوم الخطى","قوله الفصل وإن قال فعل",24,"ل",1,0],["راجعت من كلف لعبدة يدناً","لا أستطيع به القيام وحيدا",25,"د",2,0],["راجَعتُ نَفسي بما أبقى الشبابُ لها","وما تخلَّف من أسئاره بِيدي",26,"د",2,0],["راجعتُ بعد الجهل حِجْراً","وأطلعتُ زاجرة ً وزَجرا",27,"ر",2,1],["راجَت بِضاعَةُ إِبليسٍ بِكُم فَلَكُم","في قَلبِ إِبليسَ حُبٌّ لَم يَشبِ بِقِلَى",28,"ل",2,0],["راجٍ أَحالَتهُ الظُنونُ عَلى سِوى","نُعماكَ ظَلَّ عَلى المُحالِ مُحالا",29,"ل",2,0],["راجع سلوك تسلى الناس قاطبةً","فقد أقاموا على الأَحزان واعتكفوا",30,"ف",3,0],["راجياً أن أكونَ بالعلمِ يوماً","في بلادي من الرجال العظام",31,"م",1,0],["راجعتُ حِلمي وآثرتُ الوَقَار وَمن","يَحْلُمْ يُوَقَّرْ ومَنْ يَسْتَحْي يُنتضلِ",32,"ل",1,0],["راجحة الأرداف مَمْكورةٍ","طَوْع الصِّبَا مرهَفة الخَصْر",33,"ر",1,0],["راجيهِ لَم يَظفَر بِغَيرِ الياسِ","قَرَبتَني وَزِدتَ في إيناسي",34,"س",2,0],["راجِحُ الحِلمِ رَزينٌ","في المُلِمّاتِ وَقارُه",35,"ر",2,0],["راجيهِ لَم يَظفَر لَدَي","هِ وَمُبتَغيهِ لَم يُزَوَّد",36,"د",1,0],["رَاجِياً مِنْ نَوَالِكُمْ مُذْهِبَ الْفَقْ","رِ وَمُحْيِي الْغِنَى وَمُفْنِي الْبَاسِ",37,"س",1,0],["رَاجِلاً رَاجِياً خَلاَصاً وَقَدْ أَنْ","شَبَ فِيهِ الْعَنَا مَخَالِبَ فَاسِ",37,"س",1,0],["راجيا ًغَوْثَ غريقٍ","غاصَ مثلي في العُبابِ",38,"ب",1,0],["راجلاً أعزباً فرجلي وأيري","بين بطنٍ قد أعوزاني وظهر",39,"ر",1,0],["راجياً منه نوالاً","ورشاداً ليس يُحكَى",40,"ك",2,0],["راجِياً تَنفيس كربي وَالعَنا","وَنَوالي عيشة رَغدا هَنيّه",41,"ي",2,0],["راجيكَ يَسأَمُ مِن تَتابُعِها","ولديكَ لا ضَجَرٌ ولا سَأَم",42,"م",1,0],["راجِياً بالبكاء قطْعَ طريقِ الرْ","رَكْبِ يوماً إن أصبحَ الحَيُّ سَفرا",43,"ر",2,0],["راجٍ ثوابَ الله في إصداره","خاشٍ عقابَ الله في إيراده",44,"د",2,0],["راجيك راجيك لست أرجو سواك حد","راجي وخايف ومن جامر تجي مايرد",45,"د",1,0],["راجي عطاياك في دنياى سيدي وغد","فلا تخيب رجاي ياالكريم الصمد",45,"د",1,0],["راجي الله لا يخيب","والذي ظنه وضح",46,"ح",1,0],["راجع فدتك النفس ما لفقته","واحذر مجازفة لما يرموه",47,"و",2,0],["راجعتم المولى الذي بوجوده","منا استحق زماننا التبجيلا",48,"ل",2,0],["راجي يَديك أَتى مُستَفدياً وَبِهِ","مِمّا يُعانيه مِن أَيامِهِ أَلَمِ",49,"م",1,0],["راجلٌ فارسٌ سَكونٌ حَروكٌ","قائلٌ فاعلٌ قصيرٌ طويلُ",50,"ل",1,0],["راجِحٌ يَرْزُنُ في حَبْوتِهِ","ووشيكُ العَزْمِ عند النَّجَدِ",51,"د",1,0],["راجِعٌ كلُّهُ إلى اللهِ بالل","هِ بنَصِّ البِشارَةِ المَرْوِيِّ",52,"ي",1,0],["راجِعٍ للشُؤُنِ في اللهِ داعٍ","لحِماهُ ناءٍ عن الأَوْطَانِ",53,"ن",1,0],["راجِياً جاهَهُمْ إذا دهَمَ الأَم","رُ بيومِ المُصيبةِ الغَمَّاءِ",54,"ا",2,0],["راجي نَداهُ لَدَيْهِ يَعذُبُ بأسُهُ","فيكادُ في دُرِّ الكَواكِبِ يَطمَعُ",55,"ع",1,0],["راجع جميل الرأي فيَّ بنظرة","تضحى عواطفها تسح وتسجم",56,"م",1,0],["راج يقال الصبر يبذل نفسه","حيث المنية ضيق ميدانها",57,"ن",3,0],["راجياً وعدَه وإنْ أخلف الوع","دَ وأنساك طِيبَه بالمطالِ",58,"ل",1,0],["راجي الصَباحِ بِلا شَم","سٍ بائِتٌ في الضَلالِ",59,"ل",1,0],["راج الجمال به رواجا هائلا","وسواه في كل البلاد كسيد",60,"د",1,0],["راجَعتَ وَصلي بِالصُّدُو","دِ فَبانَ وَصلي مِنكَ طالِق",61,"ق",1,0],["راجيهِ راجي دِرَّةً مِن مسحَقٍ","مُتَجَدِّدٍ وَولادَةٍ مِن عاقِر",62,"ر",1,0],["راجياً نصرتي عَلَيهِ بِعَدل","مِن رَفيع الذُرى سَعيد الوُجود",63,"د",1,0],["راجِياً تَأخير عمرِ","كَم لحزب الزرخ همَّهْ",64,"ه",1,0],["راجياً مِن عُلاه حسنَ شَمولٍ","يَجعَل البائس الفَقير غَنيا",65,"ي",2,0],["راجِعي الوَصلَ وَرُدّي نَظرَةً","لا تَلِجّي في طِماحٍ وَأَثامِ",66,"م",1,0],["راجَت أَباطيلُ التَبَج","جُحِ بَينَنا وَالفَضلُ كاسِدْ",67,"د",1,0],["راجِعٌ لِي حُسنُهُ رَوضَ الهَنَا","وَهَلِ الرُوحُ بِمَيدانِ المُنَى",68,"ن",2,0],["راجيه لا يعرف شخص الياس","وحاكم بالعدل والقسطاس",69,"س",1,0],["راجيه مجدود ومنهجه","أبدا إلى آماله جدد",70,"د",1,0],["رَاجِعَةٌ عَهْداً مِنَ التَأَسُّنِ","أَوْ ناجِزاً بِالدَيْنِ إِنْ لَمْ تُرْهَنِ",71,"ن",1,0],["راجعوه على المضاجع ليلاً","وعليه اندموا لحين النجرِ",72,"ر",1,0],["راجياً منه رحمةً ثم عفواً","ثم لطفاً يعمّ عبداً ذليلا",73,"ل",2,0],["راجعوه وجادلوه ضلالا","فكفاه رجاعهُم والجدالا",74,"ل",2,0],["راجعيه ثمّ قولي","ائتنا في السمراتِ",75,"ت",1,0],["راجيَ التوصيل","دائمَ التفضيل",76,"ل",1,0],["راجيات إهداء رسمي كاسمي","إذ أبى المخدور من نقصانه",77,"ن",2,0],["راجعت منها نُهَّداً رُوِّعْنَ من","بعد غياث الدين بالطلاق",78,"ق",1,0],["راجع به سبل الهدى والطف به","حتى تريه الحق ذا تبيان",79,"ن",1,0],["راجعيني بلفظةٍ وأَعيري","كلَّ ماضيَّ فيك بعض التفات",80,"ت",1,0],["راجعاتٌ مؤيَّداتُ فأبشِِر","أنت مِنّا فى أعيُّنِ وإنتصارِ",81,"ر",1,0],["راجعت قلبي بالسلو على النوى","فرجعت لا قلبي ولا سلواني",82,"ن",2,0],["راجحاً رِدفُهُ وهو متساوٍ","فاعجبوا للتساوي والرَّجحَانِ",83,"ن",1,0],["راجي البَخيلِ وَضيعٌ","كما البَخيلُ وَضيعُ",84,"ع",1,1],["راجياً بالثبات في طلب المجد","بلوغ لني وعيشا يطيب",85,"ب",1,0],["راجع فتاويه تنل كل الهدى","من هاديات هن مهديات",86,"ت",1,0],["راجياً فضل مليك","دونه كسرى وقيصر",87,"ر",1,0],["راجيا عظمى شفاعته","عل تلقى الحبل متصلا",88,"ل",2,0],["راجت من الإعلان أسواق الحصا","حتى اختفى في السوق صافي الجوهر",89,"ر",1,0],["راجَعَ بِالعُتبى فَأَعتَبتُهُ","وَرُبَّما أَعتَبَكَ المُذنِبُ",90,"ب",1,0],["راجعت إذ قال تهواني فقلت نعم","قال اصطلى الحب قلت القلب في ضرم",91,"م",1,0],["راجوك في يومهم قَد اِضطَرَبوا","فَإِن تجب سؤلهم فَقَد هدؤوا",92,"ا",1,0],["راجياً صرفك جيش البؤس عن","ريع مسكين له فيه مغارُ",93,"ر",1,0],["راجَعتُهُ بِلِسانِ طرفٍ ناطِقٍ","يُخفي البَيانَ عَلى الرَقيبِ الجالِسِ",94,"س",1,0],["راجع حساب السنين يا","نجم، فما نحن حاسبينْ",95,"ن",1,0],["راجح الآراء توفيق الندى","من به العرب جميعاً تفتخر",96,"ر",1,0],["راجَعتُه في أزمةٍ فكأنّما","جرَّدتُ منه على الزمان مُهنّدا",97,"د",2,0],["راجع جودها عليها فمهما","يهب الصبح يسترد المساء",98,"ا",2,0],["راج حدا