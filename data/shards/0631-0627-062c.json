{"poems":[[55,"العاشقان كلاهما متغضب","https://www.aldiwan.net/poem26526.html","الكامل"],[77,"يا مصطفى الرحمان والنور الذي","https://www.aldiwan.net/poem36534.html","الكامل"],[24,"بان الشباب وأمسى الشيب قد أزفا","https://www.aldiwan.net/poem21869.html","البسيط"],[93,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[93,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[27,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[72,"في الريق سكر وفي الأصداغ تجعيد","https://www.aldiwan.net/poem18560.html","البسيط"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"راجعت بعد الجهل حجرا","https://www.aldiwan.net/poem64034.html","مجزوء الكامل"],[51,"يا حسن الوجه والشمائل","https://www.aldiwan.net/poem65926.html","المنسرح"],[97,"يا حبيب الروح يا روح الأماني","https://www.aldiwan.net/poem24800.html","الرمل"],[81,"لله سر جمال أنت موضعه","https://www.aldiwan.net/poem61462.html","البسيط"],[52,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"راجعت دينك أم عنت لك الذكر","https://www.aldiwan.net/poem63829.html","البسيط"],[50,"يا حب عبدة قد رجعت جديدا","https://www.aldiwan.net/poem63941.html","الكامل"],[46,"ضحك الدهر في محياك مكر","https://www.aldiwan.net/poem22593.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85455","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42731","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[50,"يَا حُبَّ عَبْدَة َ قَدْ رَجَعْتَ جَدِيدَا","https://www.poetsgate.com/ViewPoem.aspx?id=21700",""],[90,"بنت بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=179192",""],[51,"راجعتُ بعد الجهل حِجْراً","https://www.poetsgate.com/ViewPoem.aspx?id=29175",""],[130,"عوجا العناجيج حتى تسالا الطللا","https://www.aldiwan.net/poem54775.html","البسيط"],[141,"النجم أقرب من مداك منالا","https://www.aldiwan.net/poem11792.html","الكامل"],[158,"في الله سبحانه عمن مضى خلف","https://www.aldiwan.net/poem58711.html","البسيط"],[197,"لكم سادتي أجل احترامي","https://www.aldiwan.net/poem45668.html","الخفيف"],[227,"غيري رمين ذوات الأعين النجل","https://www.aldiwan.net/poem50856.html","البسيط"],[227,"يا رب ليل بته ناعما","https://www.aldiwan.net/poem51036.html","السريع"],[233,"بالقصر من بغداذ لا بطياس","https://www.aldiwan.net/poem31591.html","الرجز"],[233,"بأبي وجه هلال","https://www.aldiwan.net/poem31976.html","مجزوء الرمل"],[233,"ومميل العطفين أغيد","https://www.aldiwan.net/poem32099.html","مجزوء الكامل"],[235,"جئتكم مقترا أبا العباس","https://www.aldiwan.net/poem19711.html","الخفيف"],[252,"سراب","https://www.aldiwan.net/poem24957.html","مجزوء الرمل"],[254,"يا بان بشر يا سيدي يا ابن بشر","https://www.aldiwan.net/poem48484.html","الخفيف"],[257,"أنا الله اعتصامي","https://www.aldiwan.net/poem35814.html","مجزوء الرمل"],[351,"بلغا عني ربوع الصالحيه","https://www.aldiwan.net/poem39576.html","الرمل"],[362,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[362,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[367,"وصل الكتاب المهتدى برشاده","https://www.aldiwan.net/poem4320.html","الكامل"],[388,"يا رب جئناك نطلب منك مالايعد","https://www.aldiwan.net/poem54593.html","عموديه"],[388,"خذ من الوقت ما سمح","https://www.aldiwan.net/poem54594.html","عموديه"],[400,"لا فض من رب القوافي فوه","https://www.aldiwan.net/poem33367.html","الكامل"],[400,"لله درك فارس العلماءكم","https://www.aldiwan.net/poem33490.html","الكامل"],[403,"أمن خيال هداه الشوق والحلم","https://www.aldiwan.net/poem50109.html","البسيط"],[429,"قل لفخر الأئمة العلم العا","https://www.aldiwan.net/poem12363.html","الخفيف"],[459,"جانبا لومي وخافا لددي","https://www.aldiwan.net/poem16116.html","الرمل"],[498,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[498,"كل وقت له من القوم شيخ","https://www.aldiwan.net/poem37749.html","الخفيف"],[498,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[512,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[513,"فاعلم وأنت بما أريد مقاله","https://www.aldiwan.net/poem12268.html","الكامل"],[513,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[549,"صاد قلبي عشية النفر ظبي","https://www.aldiwan.net/poem47278.html","الخفيف"],[561,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"]],"verses":[["راجِع أَحَبَّتُكَ الَّذينَ هَجَرتَهُم","إِنَّ المُتَيَّمَ قَلَّ ما يَتَجَنَّبُ",0,"ب",1,0],["راجينَ فيهِ لديْكَ فضْلَ شَفاعةٍ","ومؤمِّلينَ مَقامَكَ المحْمودا",1,"د",2,0],["راجا يَطيرانِ مُعوَجَّينِ في سَرَعٍ","وَلا يَريعان حَتّى يَهبِطا أُنُفا",2,"ف",2,0],["رَاجِعْ ضَمِيرَكَ مَا اسْتَطعْ","تَ وَلاَ تُهَادِنْهُ عَتَابَا",3,"ب",2,0],["رَاجِحَ الفِعْلِ قِيمَةً","عِنْدَ مَا تُوزَنُ الْقِيَمْ",4,"م",1,0],["راجَعتُ بَعدَ سُلُوِّهِنَّ صَبابَةً","وَعَرَفتُ رَسمَ مَنازِلٍ أَبكاني",5,"ن",2,0],["رَاجِحِي الوَزنِ كَامِلِي العَدلِ في","السِيرةِ طَبِيِّن بالأُمورِ الجِشَامِ",6,"م",1,0],["راجعْ يقينكَ في ودِّي ودع عصباً","لرأيهم في اقترابي منك تبعيد",7,"د",1,0],["راجَعَ من بعد سلوةٍ ذِكَرَهْ","وواصَلَ الظبي بعدما هَجَرَهْ",8,"ر",2,1],["راجعتُ بعد الجهل حِجْرا","وأطعتُ زاجرةً وزَجرا",9,"ر",2,1],["راجحة الوزنِ وهْي شائلةٌ","عن قَدْرِك الراجح المثاقيلِ",10,"ل",1,0],["راجعتنا في جلال وسكوت","وتوالت صور الماضي الحزين",11,"ن",1,0],["راجيكَ مُستَشعِرٌ حَربَ الخُطوبِ وَما","غَيرُ الخَطابَةِ وَالأَشعارِ مَفزَعُهُ",12,"ع",2,0],["راجِحٌ بي ميزانُ مُلكٍ وَمَجدٍ","لَيسَ فيهِ مِنَ الأَنامِ كَفِيُّ",13,"ي",1,0],["رَاجِياً أَنْ تعودَ أعمالُه السُّو","ءُ بِغُفْرَانِ اللَّهِ وَهْيَ هَباءُ",14,"ا",2,0],["راجَعتَ دينَكَ أَم عَنَّت لَكَ الذُكَرُ","أَم ما بَدا لَكَ لا تَصحو وَلا تَقِرُ",15,"ر",1,1],["راجَعتُ مِن كَلَفٍ لِعَبدَةَ دَيدَناً","لا أَستَطيعُ بِهِ القِيامَ وَحيدا",16,"د",2,0],["راجِياً حُسنَ حالَةٍ إِن تَخَطَّت","ني فَإِعمالُها لِيَحسُنَ ذِكرُ",17,"ر",1,0],["راجحت أعلامهم في كل ما وَضَعوا","من العلوم فما خفت موازيني",18,"ي",1,0],["راجياتٍ بأنْ تَحُلّ رَجَاها","مَشْرَباً بارِداً ومَرْعًى نَضيرا",19,"ر",2,0],["رَاجَعْتُ فِهْرِسَ آثَارِي فَمَا لَمَحَتْ","بَصِيرَتِي فِيهِ مَا يُزْرِي بِأَعْمَالِي",20,"ي",1,0],["رَاجِحُ الحِلْمِ وَلا يُخْ","طِئْكَ فِيمَا نَابَ حِلْمُ",21,"م",1,0],["رَاجَعَ العَقْلَ فِي الحَقَائِقِ وَاسْتَهْ","دَى بِهِ فِي غَيَاهِبِ المُشْكِلاَتِ",22,"ت",1,0],["رَاجِياً غَيْرَ مَا رَجَا النَّاسُ مِنْهَا","وَارِداً غَيْرَ حَوْضِهَا المَوْروُدِ",23,"د",1,0],["راجعت من كلف لعبدة يدناً","لا أستطيع به القيام وحيدا",24,"د",2,0],["راجَعتُ نَفسي بما أبقى الشبابُ لها","وما تخلَّف من أسئاره بِيدي",25,"د",2,0],["راجعتُ بعد الجهل حِجْراً","وأطلعتُ زاجرة ً وزَجرا",26,"ر",2,1],["راجَت بِضاعَةُ إِبليسٍ بِكُم فَلَكُم","في قَلبِ إِبليسَ حُبٌّ لَم يَشبِ بِقِلَى",27,"ل",2,0],["راجٍ أَحالَتهُ الظُنونُ عَلى سِوى","نُعماكَ ظَلَّ عَلى المُحالِ مُحالا",28,"ل",2,0],["راجع سلوك تسلى الناس قاطبةً","فقد أقاموا على الأَحزان واعتكفوا",29,"ف",3,0],["راجياً أن أكونَ بالعلمِ يوماً","في بلادي من الرجال العظام",30,"م",1,0],["راجعتُ حِلمي وآثرتُ الوَقَار وَمن","يَحْلُمْ يُوَقَّرْ ومَنْ يَسْتَحْي يُنتضلِ",31,"ل",1,0],["راجحة الأرداف مَمْكورةٍ","طَوْع الصِّبَا مرهَفة الخَصْر",32,"ر",1,0],["راجيهِ لَم يَظفَر بِغَيرِ الياسِ","قَرَبتَني وَزِدتَ في إيناسي",33,"س",2,0],["راجِحُ الحِلمِ رَزينٌ","في المُلِمّاتِ وَقارُه",34,"ر",2,0],["راجيهِ لَم يَظفَر لَدَي","هِ وَمُبتَغيهِ لَم يُزَوَّد",35,"د",1,0],["رَاجِياً مِنْ نَوَالِكُمْ مُذْهِبَ الْفَقْ","رِ وَمُحْيِي الْغِنَى وَمُفْنِي الْبَاسِ",36,"س",1,0],["رَاجِلاً رَاجِياً خَلاَصاً وَقَدْ أَنْ","شَبَ فِيهِ الْعَنَا مَخَالِبَ فَاسِ",36,"س",1,0],["راجيا ًغَوْثَ غريقٍ","غاصَ مثلي في العُبابِ",37,"ب",1,0],["راجلاً أعزباً فرجلي وأيري","بين بطنٍ قد أعوزاني وظهر",38,"ر",1,0],["راجياً منه نوالاً","ورشاداً ليس يُحكَى",39,"ك",2,0],["راجِياً تَنفيس كربي وَالعَنا","وَنَوالي عيشة رَغدا هَنيّه",40,"ي",2,0],["راجيكَ يَسأَمُ مِن تَتابُعِها","ولديكَ لا ضَجَرٌ ولا سَأَم",41,"م",1,0],["راجِياً بالبكاء قطْعَ طريقِ الرْ","رَكْبِ يوماً إن أصبحَ الحَيُّ سَفرا",42,"ر",2,0],["راجٍ ثوابَ الله في إصداره","خاشٍ عقابَ الله في إيراده",43,"د",2,0],["راجيك راجيك لست أرجو سواك حد","راجي وخايف ومن جامر تجي مايرد",44,"د",1,0],["راجي عطاياك في دنياى سيدي وغد","فلا تخيب رجاي ياالكريم الصمد",44,"د",1,0],["راجي الله لا يخيب","والذي ظنه وضح",45,"ح",1,0],["راجع فدتك النفس ما لفقته","واحذر مجازفة لما يرموه",46,"و",2,0],["راجعتم المولى الذي بوجوده","منا استحق زماننا التبجيلا",47,"ل",2,0],["راجي يَديك أَتى مُستَفدياً وَبِهِ","مِمّا يُعانيه مِن أَيامِهِ أَلَمِ",48,"م",1,0],["راجلٌ فارسٌ سَكونٌ حَروكٌ","قائلٌ فاعلٌ قصيرٌ طويلُ",49,"ل",1,0],["راجِحٌ يَرْزُنُ في حَبْوتِهِ","ووشيكُ العَزْمِ عند النَّجَدِ",50,"د",1,0],["راجِعٌ كلُّهُ إلى اللهِ بالل","هِ بنَصِّ البِشارَةِ المَرْوِيِّ",51,"ي",1,0],["راجِعٍ للشُؤُنِ في اللهِ داعٍ","لحِماهُ ناءٍ عن الأَوْطَانِ",52,"ن",1,0],["راجِياً جاهَهُمْ إذا دهَمَ الأَم","رُ بيومِ المُصيبةِ الغَمَّاءِ",53,"ا",2,0],["راجي نَداهُ لَدَيْهِ يَعذُبُ بأسُهُ","فيكادُ في دُرِّ الكَواكِبِ يَطمَعُ",54,"ع",1,0],["راجع جميل الرأي فيَّ بنظرة","تضحى عواطفها تسح وتسجم",55,"م",1,0],["راج يقال الصبر يبذل نفسه","حيث المنية ضيق ميدانها",56,"ن",3,0],["راجياً وعدَه وإنْ أخلف الوع","دَ وأنساك طِيبَه بالمطالِ",57,"ل",1,0],["راجي الصَباحِ بِلا شَم","سٍ بائِتٌ في الضَلالِ",58,"ل",1,0]]}