 اقتبس الهلال النور منه","https://www.aldiwan.net/poem46836.html","الوافر"],[172,"دع الدار بالبحرين تعفو ربوعها","https://www.aldiwan.net/poem1634.html",""],[228,"لا القوم قومي ولا الأعوان أعواني","https://www.aldiwan.net/poem55113.html","البسيط"],[238,"قد أقلعت فاصفحوا عن جرمها الغير","https://www.aldiwan.net/poem31991.html","البسيط"],[283,"لقد جاوزت فيك مقدارها","https://www.aldiwan.net/poem60757.html","المتقارب"],[300,"أفي كل يوم للأماني تكذيب","https://www.aldiwan.net/poem33335.html","الطويل"],[308,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[316,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[351,"وخادعتني عن صاحب الشعرة التي","https://www.aldiwan.net/poem20649.html","الطويل"],[356,"أيا صبح أفراح الملا عمك السعد","https://www.aldiwan.net/poem40397.html","الطويل"],[367,"هم منعوا مني الخيال المسلما","https://www.aldiwan.net/poem60668.html","الطويل"],[367,"شفته تحيات العيون العلائل","https://www.aldiwan.net/poem60810.html","الطويل"],[369,"إذا أقفرت للعمر دار فبعدها","https://www.aldiwan.net/poem17777.html","الطويل"],[374,"دون اعتدالك حكم غير معتدل","https://www.aldiwan.net/poem57199.html","البسيط"],[408,"إذا أقسم الأبطال يوما بسيفهم","https://www.aldiwan.net/poem49464.html","الطويل"],[408,"من كان يبغي علو الذكر والشرفا","https://www.aldiwan.net/poem49526.html","البسيط"],[408,"إذا اقتسمت أقاليم المعالي","https://www.aldiwan.net/poem50121.html","الوافر"],[419,"شجتني وقد تشجي الطلول الهوامد","https://www.aldiwan.net/poem54036.html","الطويل"],[419,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[437,"إذا أقبلت أقعت وإن أدبرت كبت","https://www.aldiwan.net/poem25679.html","الطويل"],[444,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[460,"وما زوجان من ذكرٍ وأنثى","https://www.aldiwan.net/poem55979.html","الوافر"],[460,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[460,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[460,"أشاقك من حسناء وهنا طروقها","https://www.aldiwan.net/poem56101.html","الطويل"],[460,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[470,"ترى جيده بين الغلالة والعقد","https://www.aldiwan.net/poem60184.html","الطويل"],[470,"لنا نديم لمثلنا صلحا","https://www.aldiwan.net/poem60305.html","المنسرح"],[470,"لنا بغير نفاجه","https://www.aldiwan.net/poem60316.html","المجتث"],[485,"هجرت أمامة هجراً طويلا","https://www.aldiwan.net/poem2071.html","المتقارب"],[495,"ما الذل إلا تحمل المنن","https://www.aldiwan.net/poem67312.html","المنسرح"],[497,"لك الخير من طيف على النأي طارق","https://www.aldiwan.net/poem10249.html","الطويل"],[517,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[538,"أشاقك بالمنتصى منزل","https://www.aldiwan.net/poem23851.html","المتقارب"],[555,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[555,"أديري على الراح ساقية الخمر","https://www.aldiwan.net/poem68421.html","الطويل"],[589,"ألا مال نيران الأسى تتضرم","https://www.aldiwan.net/poem11519.html","عموديه"],[717,"","https://poetry.dctabudhabi.ae/diwan/poem/202315","المتقارب"],[511,"","https://poetry.dctabudhabi.ae/diwan/poem/141833","البسيط"],[847,"","https://poetry.dctabudhabi.ae/diwan/poem/31537","المتقارب"],[1032,"","https://poetry.dctabudhabi.ae/diwan/poem/202309","البسيط"]],"verses":[["إِذا اِقتَضَتهُ الأَماني بَعضَ مَوعِدِهِ","غَطّى بِسَترِ العَطايا عَورَةَ العَدَمِ",0,"م",1,0],["إِذا أَقْبَلَتْ أَلْقَتْ عَلى الذَّمِّ بَرْكَها","وَإِنْ أَدْبَرَتْ لَمْ يَتْلُ أَرْبابَها الحَمْدُ",1,"د",1,0],["إذا أقْبَلَتْ بالخيْرِ لمْ تسْتَفزَّهُ","وإنْ كان معْتَدّاً بهِ ضُرَّ مُعْتَدي",2,"د",2,0],["إِذا أَقبَلَت قُلتَ دُبّاءَةٌ","مِنَ الحُضرِ مَغموسَةً في الغُدُر",3,"ر",1,0],["إذا أقللت عن عجز","فمعذرة لا قلالي",4,"ل",2,0],["إِذا أُقحِمَ الرُكبانُ فيها تَبَتَّلوا","فَمُستَغفِرٌ مِن ذَنبِهِ وَمُسَبِّحُ",5,"ح",1,1],["إذا أقمت أقامت وهي من خَدَمي","وأينما سرت سارت تقتفي أثري",6,"ر",2,0],["إِذا أَقولُ تَرَكتُ الجَهلَ هَيَّجَني","رَسمٌ بِذي البَيضِ أَو رَسمٌ بِدُوّارِ",7,"ر",1,0],["إِذا اِقتَصَدوا فَمُقتَصِدٌ أَريبٌ","وَإِن جاروا سَواءَ الحَقِّ جارا",8,"ر",2,0],["إذا اقْتُفِرَتْ آثارُهُ فَعَدُوُّهُ","وموْلاَهُ مَوْعُودٌ هُنَاك ومُوعَدُ",9,"د",1,0],["إِذا أَقولُ تَراضَينا عَلى ثَمَنٍ","ضَنَّت بِها نَفسُ خَبِّ البَيعِ مَكّارِ",10,"ر",1,0],["إِذا أَقبَلَ المالُ السَوامُ وَغَيرَهُ","فَتَثميرُهُ مِن لَحظَةِ العَينِ أَسرَعُ",11,"ع",1,1],["إِذا أَقبَلتَ يا زَمَن البَنينا","وَشَبّوا فيكَ وَاِجتازوا السِنينا",12,"ن",2,0],["إِذا اِقتَصَرتَ عَلى حُكمِ الزَمانِ فَقَد","أَراكَ شاهِدُ أَمرٍ كَيفَ غائِبُهُ",13,"ب",2,0],["إِذا اِقتَسَمَ الناسُ الفَعالَ وَجَدتَنا","لَنا مِقدَحا مَجدٍ وَلِلناسِ مِقدَحُ",14,"ح",1,0],["إِذا أَقلَعَت عَنها سَماءٌ مُلِحَّةٌ","تَبَعَّجَ مِن أُخرى عَلَيكَ غَمامُها",15,"م",3,0],["إِذا اِقتَسَمَ اللُؤمَ اللِئامُ وَجَدتُهُ","يَكونُ أَبا الطائِيِّ دونَ العَماعِمِ",16,"م",1,0],["إِذا أَقبلَت كانَت عَلى المَرءِ حَسرَةً","وَإِن أَدبَرَت كانَت كَثيراً هُمومُها",17,"ه",2,0],["إِذا اِقتَسَمَ العَقائِرَ مَن لَدَيها","جَعَلنا إِسمَهُ الشَحمَ المُذابا",18,"ب",2,0],["إِذا أَقبَل يَخجَلُ الأَراك","وَيَذبُل عِندَما يَراك",19,"ك",1,0],["إذا أَقْصَدَ الموتُ القَتِيلَ فإنَّهُ","كَذَلِكَ مَا يَنْجُو مِنَ الموْتِ قاتلُهْ..",20,"ل",2,0],["إِذا أَقبَلَت حِميَرُ في جَمعِها","وَمَذحِجٌ كَالعارِضِ المُستَحيق",21,"ق",1,0],["إذا أقْبلتْ كانتْ بتقْويمِ خَلْقِها","وَمِشْيَتِها بِالشمسِ تَستَوقِفُ الشَّمسا",22,"س",2,0],["إِذا اقتادَ جَيشاً ساطِعَ النَقعِ أَنذرتْ","طَلائِعُهُ جَيشَ العَدُوِّ المُكابِدِ",23,"د",1,0],["إِذا أَقولُ صَحا عَنها يُعاوِدُهُ","رَدعٌ يَهيجُ عَلَيهِ الشَوقَ وَالطَرَبا",24,"ب",2,0],["إِذا أَقبَلتُهُ سُمرَ العَوالي","فَلَستُ أَرُدُّهُ إِلّا كَليما",25,"م",2,0],["إِذا أَقبَلَت تَمشي تُقارِبُ خَطوَها","إِلى الأَقرَبِ الأَدنى تَقَسَّمَها البُهرُ",26,"ر",1,0],["إِذا أَقدَموا لَم يَثنِهِم عَن مَغارِهِم","غَداةَ الوَغى أَهوالُها وَالمَآزِمُ",27,"م",1,0],["إِذا أَقادَتهُ عادَةٌ طانَ يَرجو","ها فَوافى المَنونَ تَرتَصِدُه",28,"د",2,0],["إِذا أَقبَلَ قالَ النا","سُ ظَبيٌ ريعَ وَسنانُ",29,"ن",1,0],["إِذا اِقتَضاها طَرفي لَها عِدَةً","عَرَفتُ مَردودَها بِفَحواها",30,"ا",3,0],["إِذا أَقبَلوا لِلحَربِ بِالحَربِ أَقبَلَت","وُجوهُ المَنايا بارِقٌ بَعدَ راعِدِ",31,"د",1,0],["إِذا أَقبَلَ الإِنسانُ في الدَهرِ صُدِّقَت","أَحاديثُهُ عَن نَفسِهِ وَهوَ كاذِبُ",32,"ب",1,1],["إِذا اِقتَرَنَت بِجِسمِ الحَيِّ رَوحٌ","فَتِلَكَ وَذاكَ في حالَي جِهادِ",33,"د",1,0],["إذا أقلعت عنهم سحابة فتنةٍ","أظلتهمُ أخرى تدوّى رعودها",34,"د",3,0],["إذا أَقمتم فإن المال منتزع","وإن رحلتم فإن النار في الطلب",35,"ب",1,0],["إِذا اِقتَسَمَ الناسُ فَضلَ الفَخارِ","أَطَلنا عَلى الأَرضِ مَيلَ العَصا",36,"ص",2,1],["إذا أقبلَ الليلُ يا حيرتي","تفقّدت في الشطّ حوريّتي",37,"ي",1,1],["إذا أَقبلتْ في دارِ قومٍ تباشروا","وقالوا لها أهلاً وسهلاً ومرحبا",38,"ب",2,0],["إِذَا أُقْرِضْتَ أَيَّاماً","ولمْ تَسْتثْمِرِ الْقَرْضَا",39,"ض",2,0],["إذا أقبلت بالخير لم تستفزه","وإن هي ضلت لم يقدها بمقود",40,"د",1,0],["إذا أقبلََ \" الشيخُ المُطاعُ \"وخَلْفَهُ","منَ الزارعين الأرضَ مِثْلُ السَّوائم!",41,"م",1,0],["إذا أقْبَلَتْ مِنْ سَمْلَقٍ بِنُفُوسِهَا،","أعَادَ عَلَيْهَا رَائِدُ المَوْتِ سَمْلَقَا",42,"ق",2,0],["إذا أقبلت قالوا تأخر رحلها","وإن أدبرت قالوا تقدم فاشدد",43,"د",1,0],["إذَا اقْلَوَلَيْنَ لِلْقَرَبِ البَطِين","بِأَجْنِحة ٍ يَمُرْنَ بِهِنَّ حُرْدٍ",44,"د",1,0],["إذا أقبلتْ دُنيا تقادُ بشعرةٍ","وإن أدبرتْ لم تَرْتِبط بالسلاسلِ",45,"ل",1,1],["إذا أقبل التوفيق فالخيرِ مقبلٌ","يجىء الفتى من حيث يدري ولا يدري",46,"ي",1,1],["إذا اقتسمته نشوة البأس والندى","تموج موج اللجة المتلاطم",47,"م",1,0],["إذا أقبلت ولت وإن هي أحسنت","اساءت وان صافت فثق بالكدورة",48,"ه",1,0],["إذا اقتبسَ الهلالُ النورَ منْهُ","زَوى عنه الجبينَ وقالَ مَن هُو",49,"و",1,1],["إِذا أَقبَلَت شُعثُ النَواصي تَضُمُّها","عَلَيهِم مَساعيرُ الوَغى وَتَصُوعُها",50,"ع",3,0],["إذا أقامَ عَلَيهم شاهِداً حجرٌ","في هَيكَلٍ قامَتِ الأُخرى بِبُرهانِ",51,"ن",1,0],["إِذا اِقشَعَرَّ الثَرى كانَت وُجوهُهُمُ","لَنا وَأَيديهِمُ الرَوضاتُ وَالغُدُرُ",52,"ر",1,0],["إِذا أَقبَلَتْ بِالْفَتَى عِيشَةٌ","تَوَقَّعَ بِالْمَوْتِ إِدْبارَها",53,"ر",3,0],["إِذا أَقعدَتني الحادِثاتُ أَقامَني","لنيل العُلى عزمٌ وحَزمٌ وتَجريبُ",54,"ب",1,0],["إِذا أَقبلت من آلِ عثمانَ خلعة","بِها منكبُ العلياءِ قَد طاولَ الشّهبا",55,"ب",2,0],["إذا أقبلت أجرامها بأصكاكها","يرجعها في قطعها كل ذروة",56,"ه",1,0],["إذا أَقبَلتْ جَاءَتْ تُقادُ بِشَعْرةٍ","وَإنْ أَدبَرَتْ وَلَّتْ تَقُدُّ السَّلاسِلا",57,"ل",2,0],["إِذا أَقبلت تَسعى تَهلّل وَجهه","وَإِن طالَ مِنها العَهد أَقلقه الوَجدُ",58,"د",1,0],["إذا اقتسمَ الفَضْلَ الرّجالُ بمَشْهدٍ","أصابَ سناماً منه والقومُ مَنْسَما",59,"م",2,0],["إذا اقْتَرنا كانا على الأمنِ والغنى","ونَيْلِ المُنَى واليُمْنِ أقْوَى الدَّلائل",60,"ل",1,0],["إِذا أَقفَرَت لِلعُمرِ دارٌ فَبَعدَها","مِنَ القَبرِ دارٌ حينَ تُسكَنُ تُقفِرُ",61,"ر",1,1],["إذا أَقاما وَراء الصَّدرِ فامتَنَعا","عَلى عليِّ بنِ عبدِ الدائِم بنِ عَلي",62,"ل",2,0],["إذا أقسَمَ الأبطالُ يَوماً بسيفِهِمْ","وعدُّوهُ مِمّا يُكسِبُ المَجدَ والكَرَمْ",63,"م",1,1],["إذا اقشَعرَّ زَمانٌ من جُدوبَتهِ","أغنى الورى وكفى جودٌ له وَكَفا",64,"ف",2,0],["إذا اقْتُسِمت أقاليمُ المَعالي","وفُضَّتُ بينَ أخلالٍ وِضاءِ",65,"ا",2,1],["إذا اقترنا شعري وكوكب سعده","وشوهد منا المشتري وعطارد",66,"د",1,0],["إذا أَقْبَلَتْ من كلِّ عوجاء ضامر","عليها رجال من نزارٍ وعامر",67,"ر",1,0],["إِذا أَقْبَلَتْ أَقْعَتْ وَإِنْ أَدْبَرَتْ كَبَتْ","وَتَعْرِضُ طُولاً في الْعِنَانِ فَتَسْتَوي",68,"ي",1,1],["إذا اقتدت الرجال بذي نهاءٍ","تدل على التكامل في نهاها",69,"ا",3,0],["إذا اقترعا على إحراز حُسن","أغار على سمينهما النحيلُ",70,"ل",1,0],["إذا اقتضت راكبَها تعريسةً","سوّفَها الفجرَ ومنَّاها الطَّفَل",71,"ل",1,0],["إذا أقامت رُشفتْ أو ظعنت","تفُتْ على الأفواه نشراً عبِقا",72,"ق",2,0],["إذا أقصِيتْ في العرب يوماً وأهملت","ففي العجم تُرعَى ليت شعري حقوقُها",73,"ق",3,0],["إذا اقتُضِيَتْ في ذمَّة النجم حاجةٌ","فتلك لديها دعوةٌ لا تخيَّبُ",74,"ب",1,0],["إِذا اِقتَصَّ مِن أَشجارِهِ الغَيثُ عاتِقاً","رَأَيتُ عَلى أَغصانِها غَدرَةَ الوَردِ",75,"د",1,0],["إِذا اِقتَرَحنا عَلَيهِ مَضحَكَةً","أَخرَجَ دولابُ حِفظِهِ المُلَحا",76,"ح",2,0],["إِذا اِقتَرَحنا عَلَيهِ","غِنىً لَنا أَهزاجَه",77,"ج",2,0],["إِذا أَقبَلَت قُلتَ مَذعورَةٌ","مِنَ الرُمدِ تَلحَقُ هَيقاً ذَمولا",78,"ل",2,0],["إِذا أَقتَصَرنا عَلى اليَسيرِ فَما ال","عِلَّة في عَتبِنا عَلى الزَمَنِ",79,"ن",1,0],["إذا اقتضت منه خراسان لفظة","أماطت نساء العرب در المخانق",80,"ق",1,0],["إذا أقامت على ثغر صوارمه","فللنوائب عن سكانها سفر",81,"ر",1,0],["إِذا أَقرَضَت تُربَهُنَّ الجَنوبُ","شَمالاً أَفاءَت بِهِ الشَمأَلُ",82,"ل",1,0],["إِذا أَقولُ يَوماً","قَد أُطفِئَت تَزيدُ",83,"د",1,0],["إِذا أَقبَلَت راعَت بِقُنَّةِ قَرهَبٍ","وَإِن أَدبَرَت راقَت بِقادِمَتَي نَسرِ",84,"ر",1,0],["إذا أقبلت فالشمس من نور وجهها","وإن أدبرت فالفرع كالليل مظلم",85,"م",1,0],["إذا أقبل الفرس نحوي على","خناذيذ تضبر بالقرقر",86,"ر",1,0],["إذا أقولُ تَخَلَّوْا عنْ هزيمتِهِم","كرُّوا علينا حُماةً كُلُّهُمْ حَرِدُ",87,"د",1,0],["إِذا أَقسَموا أَقسَمتُ لا اَنفَكُّ مِنهُمُ","وَلا مِنهُما حَتّي نَفُكَّ السَلاسِلا",88,"ل",2,0],["إذا أقوم عجنت الأرض متكئا","على البراجم حتى يذهب النفر",89,"ر",1,0]]}