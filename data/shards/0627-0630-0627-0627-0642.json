abudhabi.ae/diwan/poem/85272","البسيط"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21493","المتقارب"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32818","المتقارب"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133235","البسيط"],[3882,"","https://poetry.dctabudhabi.ae/diwan/poem/124627","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54416","الطويل"],[4504,"","https://poetry.dctabudhabi.ae/diwan/poem/142722","المتقارب"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136404",""],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22810","الوافر"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101938","الطويل"],[4680,"تعالي نرتوي","https://www.poetsgate.com/ViewPoem.aspx?id=191788",""],[4767,"فداء","https://www.poetsgate.com/ViewPoem.aspx?id=87374",""],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4929,"تطبيق على الجناس في الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=204793",""],[4119,"أمعظمة الصليب وددت أني","https://www.poetsgate.com/ViewPoem.aspx?id=16073",""],[5038,"المربد العجب","https://www.poetsgate.com/ViewPoem.aspx?id=190219",""],[5183,"الِّلثَامُ","https://www.poetsgate.com/ViewPoem.aspx?id=186447",""],[5197,"المعجزة الباقية","https://www.poetsgate.com/ViewPoem.aspx?id=102713",""],[5206,"مَرثاة الصديق الغِشْرِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=187432",""],[5277,"أقاصي الجروح","https://www.poetsgate.com/ViewPoem.aspx?id=198360",""],[5493,"عفوُ المحبِّين","https://www.poetsgate.com/ViewPoem.aspx?id=201343",""],[5582,"بَدَتْ بِالسَّلامِ وَلانَتْ مَقالا","https://www.poetsgate.com/ViewPoem.aspx?id=187239",""],[5609,"المنديل","https://www.poetsgate.com/ViewPoem.aspx?id=215572",""],[5720,"الماحي ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=198864",""],[5725,"حمام الأيك","https://www.poetsgate.com/ViewPoem.aspx?id=213526",""],[5759,"قلادة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=213395",""],[2546,"أقولُ والرَّكبُ قد مالتْ عمائمهمْ","https://www.poetsgate.com/ViewPoem.aspx?id=17532",""],[5858,"الحروف العاثره","https://www.poetsgate.com/ViewPoem.aspx?id=188024",""],[6259,"قفوا جددوا عتباً على من لهُ العتب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59358&r=&rc=6",""]],"verses":[["إِذا اِقتَضَتهُ الأَماني بَعضَ مَوعِدِهِ","غَطّى بِسَترِ العَطايا عَورَةَ العَدَمِ",0,"م",1,0],["إِذا أَقْبَلَتْ أَلْقَتْ عَلى الذَّمِّ بَرْكَها","وَإِنْ أَدْبَرَتْ لَمْ يَتْلُ أَرْبابَها الحَمْدُ",1,"د",1,0],["إذا أقْبَلَتْ بالخيْرِ لمْ تسْتَفزَّهُ","وإنْ كان معْتَدّاً بهِ ضُرَّ مُعْتَدي",2,"د",2,0],["إِذا أَقبَلَت قُلتَ دُبّاءَةٌ","مِنَ الحُضرِ مَغموسَةً في الغُدُر",3,"ر",1,0],["إذا أقللت عن عجز","فمعذرة لا قلالي",4,"ل",2,0],["إِذا أُقحِمَ الرُكبانُ فيها تَبَتَّلوا","فَمُستَغفِرٌ مِن ذَنبِهِ وَمُسَبِّحُ",5,"ح",1,1],["إذا أقمت أقامت وهي من خَدَمي","وأينما سرت سارت تقتفي أثري",6,"ر",2,0],["إِذا أَقولُ تَرَكتُ الجَهلَ هَيَّجَني","رَسمٌ بِذي البَيضِ أَو رَسمٌ بِدُوّارِ",7,"ر",1,0],["إِذا اِقتَصَدوا فَمُقتَصِدٌ أَريبٌ","وَإِن جاروا سَواءَ الحَقِّ جارا",8,"ر",2,0],["إذا اقْتُفِرَتْ آثارُهُ فَعَدُوُّهُ","وموْلاَهُ مَوْعُودٌ هُنَاك ومُوعَدُ",9,"د",1,0],["إِذا أَقولُ تَراضَينا عَلى ثَمَنٍ","ضَنَّت بِها نَفسُ خَبِّ البَيعِ مَكّارِ",10,"ر",1,0],["إِذا أَقبَلَ المالُ السَوامُ وَغَيرَهُ","فَتَثميرُهُ مِن لَحظَةِ العَينِ أَسرَعُ",11,"ع",1,1],["إِذا أَقبَلتَ يا زَمَن البَنينا","وَشَبّوا فيكَ وَاِجتازوا السِنينا",12,"ن",2,0],["إِذا اِقتَصَرتَ عَلى حُكمِ الزَمانِ فَقَد","أَراكَ شاهِدُ أَمرٍ كَيفَ غائِبُهُ",13,"ب",2,0],["إِذا اِقتَسَمَ الناسُ الفَعالَ وَجَدتَنا","لَنا مِقدَحا مَجدٍ وَلِلناسِ مِقدَحُ",14,"ح",1,0],["إِذا أَقلَعَت عَنها سَماءٌ مُلِحَّةٌ","تَبَعَّجَ مِن أُخرى عَلَيكَ غَمامُها",15,"م",3,0],["إِذا اِقتَسَمَ اللُؤمَ اللِئامُ وَجَدتُهُ","يَكونُ أَبا الطائِيِّ دونَ العَماعِمِ",16,"م",1,0],["إِذا أَقبلَت كانَت عَلى المَرءِ حَسرَةً","وَإِن أَدبَرَت كانَت كَثيراً هُمومُها",17,"ه",2,0],["إِذا اِقتَسَمَ العَقائِرَ مَن لَدَيها","جَعَلنا إِسمَهُ الشَحمَ المُذابا",18,"ب",2,0],["إِذا أَقبَل يَخجَلُ الأَراك","وَيَذبُل عِندَما يَراك",19,"ك",1,0],["إذا أَقْصَدَ الموتُ القَتِيلَ فإنَّهُ","كَذَلِكَ مَا يَنْجُو مِنَ الموْتِ قاتلُهْ..",20,"ل",2,0],["إِذا أَقبَلَت حِميَرُ في جَمعِها","وَمَذحِجٌ كَالعارِضِ المُستَحيق",21,"ق",1,0],["إذا أقْبلتْ كانتْ بتقْويمِ خَلْقِها","وَمِشْيَتِها بِالشمسِ تَستَوقِفُ الشَّمسا",22,"س",2,0],["إِذا اقتادَ جَيشاً ساطِعَ النَقعِ أَنذرتْ","طَلائِعُهُ جَيشَ العَدُوِّ المُكابِدِ",23,"د",1,0],["إِذا أَقولُ صَحا عَنها يُعاوِدُهُ","رَدعٌ يَهيجُ عَلَيهِ الشَوقَ وَالطَرَبا",24,"ب",2,0],["إِذا أَقبَلتُهُ سُمرَ العَوالي","فَلَستُ أَرُدُّهُ إِلّا كَليما",25,"م",2,0],["إِذا أَقبَلَت تَمشي تُقارِبُ خَطوَها","إِلى الأَقرَبِ الأَدنى تَقَسَّمَها البُهرُ",26,"ر",1,0],["إِذا أَقدَموا لَم يَثنِهِم عَن مَغارِهِم","غَداةَ الوَغى أَهوالُها وَالمَآزِمُ",27,"م",1,0],["إِذا أَقادَتهُ عادَةٌ طانَ يَرجو","ها فَوافى المَنونَ تَرتَصِدُه",28,"د",2,0],["إِذا أَقبَلَ قالَ النا","سُ ظَبيٌ ريعَ وَسنانُ",29,"ن",1,0],["إِذا اِقتَضاها طَرفي لَها عِدَةً","عَرَفتُ مَردودَها بِفَحواها",30,"ا",3,0],["إِذا أَقبَلوا لِلحَربِ بِالحَربِ أَقبَلَت","وُجوهُ المَنايا بارِقٌ بَعدَ راعِدِ",31,"د",1,0],["إِذا أَقبَلَ الإِنسانُ في الدَهرِ صُدِّقَت","أَحاديثُهُ عَن نَفسِهِ وَهوَ كاذِبُ",32,"ب",1,1],["إِذا اِقتَرَنَت بِجِسمِ الحَيِّ رَوحٌ","فَتِلَكَ وَذاكَ في حالَي جِهادِ",33,"د",1,0],["إذا أقلعت عنهم سحابة فتنةٍ","أظلتهمُ أخرى تدوّى رعودها",34,"د",3,0],["إذا أَقمتم فإن المال منتزع","وإن رحلتم فإن النار في الطلب",35,"ب",1,0],["إِذا اِقتَسَمَ الناسُ فَضلَ الفَخارِ","أَطَلنا عَلى الأَرضِ مَيلَ العَصا",36,"ص",2,1],["إذا أقبلَ الليلُ يا حيرتي","تفقّدت في الشطّ حوريّتي",37,"ي",1,1],["إذا أَقبلتْ في دارِ قومٍ تباشروا","وقالوا لها أهلاً وسهلاً ومرحبا",38,"ب",2,0],["إِذَا أُقْرِضْتَ أَيَّاماً","ولمْ تَسْتثْمِرِ الْقَرْضَا",39,"ض",2,0],["إذا أقبلت بالخير لم تستفزه","وإن هي ضلت لم يقدها بمقود",40,"د",1,0],["إذا أقبلََ \" الشيخُ المُطاعُ \"وخَلْفَهُ","منَ الزارعين الأرضَ مِثْلُ السَّوائم!",41,"م",1,0],["إذا أقْبَلَتْ مِنْ سَمْلَقٍ بِنُفُوسِهَا،","أعَادَ عَلَيْهَا رَائِدُ المَوْتِ سَمْلَقَا",42,"ق",2,0],["إذا أقبلت قالوا تأخر رحلها","وإن أدبرت قالوا تقدم فاشدد",43,"د",1,0],["إذَا اقْلَوَلَيْنَ لِلْقَرَبِ البَطِين","بِأَجْنِحة ٍ يَمُرْنَ بِهِنَّ حُرْدٍ",44,"د",1,0],["إذا أقبلتْ دُنيا تقادُ بشعرةٍ","وإن أدبرتْ لم تَرْتِبط بالسلاسلِ",45,"ل",1,1],["إذا أقبل التوفيق فالخيرِ مقبلٌ","يجىء الفتى من حيث يدري ولا يدري",46,"ي",1,1],["إذا اقتسمته نشوة البأس والندى","تموج موج اللجة المتلاطم",47,"م",1,0],["إذا أقبلت ولت وإن هي أحسنت","اساءت وان صافت فثق بالكدورة",48,"ه",1,0],["إذا اقتبسَ الهلالُ النورَ منْهُ","زَوى عنه الجبينَ وقالَ مَن هُو",49,"و",1,1],["إِذا أَقبَلَت شُعثُ النَواصي تَضُمُّها","عَلَيهِم مَساعيرُ الوَغى وَتَصُوعُها",50,"ع",3,0],["إذا أقامَ عَلَيهم شاهِداً حجرٌ","في هَيكَلٍ قامَتِ الأُخرى بِبُرهانِ",51,"ن",1,0],["إِذا اِقشَعَرَّ الثَرى كانَت وُجوهُهُمُ","لَنا وَأَيديهِمُ الرَوضاتُ وَالغُدُرُ",52,"ر",1,0],["إِذا أَقبَلَتْ بِالْفَتَى عِيشَةٌ","تَوَقَّعَ بِالْمَوْتِ إِدْبارَها",53,"ر",3,0],["إِذا أَقعدَتني الحادِثاتُ أَقامَني","لنيل العُلى عزمٌ وحَزمٌ وتَجريبُ",54,"ب",1,0],["إِذا أَقبلت من آلِ عثمانَ خلعة","بِها منكبُ العلياءِ قَد طاولَ الشّهبا",55,"ب",2,0],["إذا أقبلت أجرامها بأصكاكها","يرجعها في قطعها كل ذروة",56,"ه",1,0],["إذا أَقبَلتْ جَاءَتْ تُقادُ بِشَعْرةٍ","وَإنْ أَدبَرَتْ وَلَّتْ تَقُدُّ السَّلاسِلا",57,"ل",2,0],["إِذا أَقبلت تَسعى تَهلّل وَجهه","وَإِن طالَ مِنها العَهد أَقلقه الوَجدُ",58,"د",1,0],["إذا اقتسمَ الفَضْلَ الرّجالُ بمَشْهدٍ","أصابَ سناماً منه والقومُ مَنْسَما",59,"م",2,0],["إذا اقْتَرنا كانا على الأمنِ والغنى","ونَيْلِ المُنَى واليُمْنِ أقْوَى الدَّلائل",60,"ل",1,0],["إِذا أَقفَرَت لِلعُمرِ دارٌ فَبَعدَها","مِنَ القَبرِ دارٌ حينَ تُسكَنُ تُقفِرُ",61,"ر",1,1],["إذا أَقاما وَراء الصَّدرِ فامتَنَعا","عَلى عليِّ بنِ عبدِ الدائِم بنِ عَلي",62,"ل",2,0],["إذا أقسَمَ الأبطالُ يَوماً بسيفِهِمْ","وعدُّوهُ مِمّا يُكسِبُ المَجدَ والكَرَمْ",63,"م",1,1],["إذا اقشَعرَّ زَمانٌ من جُدوبَتهِ","أغنى الورى وكفى جودٌ له وَكَفا",64,"ف",2,0],["إذا اقْتُسِمت أقاليمُ المَعالي","وفُضَّتُ بينَ أخلالٍ وِضاءِ",65,"ا",2,1],["إذا اقترنا شعري وكوكب سعده","وشوهد منا المشتري وعطارد",66,"د",1,0],["إذا أَقْبَلَتْ من كلِّ عوجاء ضامر","عليها رجال من نزارٍ وعامر",67,"ر",1,0],["إِذا أَقْبَلَتْ أَقْعَتْ وَإِنْ أَدْبَرَتْ كَبَتْ","وَتَعْرِضُ طُولاً في الْعِنَانِ فَتَسْتَوي",68,"ي",1,1],["إذا اقتدت الرجال بذي نهاءٍ","تدل على التكامل في نهاها",69,"ا",3,0],["إذا اقترعا على إحراز حُسن","أغار على سمينهما النحيلُ",70,"ل",1,0],["إذا اقتضت راكبَها تعريسةً","سوّفَها الفجرَ ومنَّاها الطَّفَل",71,"ل",1,0],["إذا أقامت رُشفتْ أو ظعنت","تفُتْ على الأفواه نشراً عبِقا",72,"ق",2,0],["إذا أقصِيتْ في العرب يوماً وأهملت","ففي العجم تُرعَى ليت شعري حقوقُها",73,"ق",3,0],["إذا اقتُضِيَتْ في ذمَّة النجم حاجةٌ","فتلك لديها دعوةٌ لا تخيَّبُ",74,"ب",1,0],["إِذا اِقتَصَّ مِن أَشجارِهِ الغَيثُ عاتِقاً","رَأَيتُ عَلى أَغصانِها غَدرَةَ الوَردِ",75,"د",1,0],["إِذا اِقتَرَحنا عَلَيهِ مَضحَكَةً","أَخرَجَ دولابُ حِفظِهِ المُلَحا",76,"ح",2,0],["إِذا اِقتَرَحنا عَلَيهِ","غِنىً لَنا أَهزاجَه",77,"ج",2,0],["إِذا أَقبَلَت قُلتَ مَذعورَةٌ","مِنَ الرُمدِ تَلحَقُ هَيقاً ذَمولا",78,"ل",2,0],["إِذا أَقتَصَرنا عَلى اليَسيرِ فَما ال","عِلَّة في عَتبِنا عَلى الزَمَنِ",79,"ن",1,0],["إذا اقتضت منه خراسان لفظة","أماطت نساء العرب در المخانق",80,"ق",1,0],["إذا أقامت على ثغر صوارمه","فللنوائب عن سكانها سفر",81,"ر",1,0],["إِذا أَقرَضَت تُربَهُنَّ الجَنوبُ","شَمالاً أَفاءَت بِهِ الشَمأَلُ",82,"ل",1,0],["إِذا أَقولُ يَوماً","قَد أُطفِئَت تَزيدُ",83,"د",1,0],["إِذا أَقبَلَت راعَت بِقُنَّةِ قَرهَبٍ","وَإِن أَدبَرَت راقَت بِقادِمَتَي نَسرِ",84,"ر",1,0],["إذا أقبلت فالشمس من نور وجهها","وإن أدبرت فالفرع كالليل مظلم",85,"م",1,0],["إذا أقبلَت هاتيك تَردَي كأنَّها","جِبالُ شَرورَى أقبَلَت هذه تُردي",86,"د",2,0],["إِذا اِقتعد السرير رأَيت منه","باندية العلا قمر السرير",87,"ر",1,0],["إذا أقول مضى ما كنت أحذره","من الزمان رماني الدهر بالغير",88,"ر",1,0],["إذا أقبلت أدبرت حيةٌ","وإن أدبرت أقبلت عقرب",89,"ب",1,0],["إذا إقْتُصَّتْ على السَّمعِ","سلا عنْ كلِّ مُقْتَصِّ",90,"ص",1,0],["إذا أقبلت تمشي الهوينا تعطفت","كما الغصن من هنا تميل ومن هنا",91,"ن",2,0],["إذا أقبلتْ ولَّى بها الهَمُّ مُدْبِراً","كما أدبر العِفْريتُ من كوكب الرَّجْم",92,"م",1,0],["إذا أقولُ لهم 