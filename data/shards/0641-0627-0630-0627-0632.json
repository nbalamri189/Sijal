الخُلْفُ بينهمْ بالزوالِ",3,"ل",1,0],["فَإِذا زارَ أَدَرنا ال","راحَ جاماً بَعدَ جامِ",4,"م",1,0],["فإذا زحفت بحزب ربك غالبا","قادوا رعاعا نحوه وطغاما",5,"م",2,0],["فإذا زلَّ أقِلْ عثرتَه","لا ترى في الخَلْق شخصاً لم يَزِلْ",6,"ل",1,0],["فَإِذا زحلَةٌ كَمقلَةِ ثَكلى","وَإِذا النَهر ساكِن الماءِ جامِد",7,"د",1,0],["فإذا زكتْ أفعالُه وأُصولُه","كانت له قِممُ الكواكب مَرْبَعا",8,"ع",2,0],["فإذا زرعتُ رأيتُ غَيري حاصداً","وإذا سمحتُ له يصيرُ ضنينا",9,"ن",2,0],["فإذا زنبقةٌ ميّلَها","نفسٌ مرَّ كما مرَّ النحيبُ",10,"ب",1,0],["فإذا زدتُ من جنابك قرباً","زدت عن خطَّة النوائب بعدا",11,"د",2,0],["فإِذا زَجَرتُ القَلبَ زادَ وَجيبُهُ","وَإِذا حَبَستُ الدَمعَ فاضَ هُمولا",12,"ل",2,0],["فإذا زللت فارتجي أن تصفحوا","وتقابلوا الهفوات بالأغضاء",13,"ا",2,0],["فإذا زادت الجسوم الجوابي","قضت النفس بالدخول مناها",14,"ا",3,0],["فإذا زُرتَ لا تَزُر بِجَنيبٍ","لا يكونُ الطاعونُ والحجّاج",15,"ج",1,0],["فإذا زللت وجدت حلمك ضيقا","عن زلتي أبدا لفرط نحوسي",16,"س",2,0],["فإذا زال ما أخاف وأخشى","عدت في سكرة وفي إصرار",17,"ر",1,0],["فإذا زجرت الغيث عاد صواعقاً","وإذا نظرت السمّ عاد زلالا",18,"ل",2,0],["فإذا زهونَ خُرِمْنَ مقعد شمعةٍ","وإذا انطفأنَ فقد خُذِلْنَ جَميعا",19,"ع",2,0],["فإذا زئيرٌ للرضيعِ أصابَ فيهم","مسمعاً قدْ مأمأوا ، ويحَ الخِرافْ",20,"ف",1,0],["فإذا زهور الفأل يورق غصنها","فأحال أشواك التعاسة نرجسا",21,"س",2,0]]}