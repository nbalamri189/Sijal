دمعها خضل","https://www.aldiwan.net/poem1820.html","البسيط"],[481,"من لي بوصفه يوما في محاكمة","https://www.aldiwan.net/poem37040.html","البسيط"],[502,"أبكي وبدري بالجمال توارى","https://www.aldiwan.net/poem37625.html","الكامل"],[502,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[502,"كيف لا أندب الطلول غراما","https://www.aldiwan.net/poem37782.html","الخفيف"],[502,"رقرق الكأس حبيبي","https://www.aldiwan.net/poem37975.html","مجزوء الرمل"],[502,"أيها المستحلف الليل أفق","https://www.aldiwan.net/poem38032.html","الرمل"],[502,"خذ شهودا عن شهود الكائنات","https://www.aldiwan.net/poem38068.html","الرمل"],[516,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[517,"قل لمن يرتجي طنين الرباب","https://www.aldiwan.net/poem12023.html","الخفيف"],[517,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[531,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[540,"إسألوني عما رأيت بعيني","https://www.aldiwan.net/poem47588.html","عموديه"],[540,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"],[540,"هو الطيب الأخلاق والإسم والذكر","https://www.aldiwan.net/poem48174.html","عموديه"],[540,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[540,"يا حسرتي يا حسرتي","https://www.aldiwan.net/poem48262.html","عموديه"],[553,"ضن عني بالنزر إذ أنا يقظا","https://www.aldiwan.net/poem47194.html","الخفيف"],[553,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[553,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[560,"مهجة ناظراك قد فتناها","https://www.aldiwan.net/poem33674.html","الخفيف"],[560,"يا أبا مسلم الفتى الخولاني","https://www.aldiwan.net/poem33705.html","الخفيف"],[560,"أستغفر الله من سري ومن علني","https://www.aldiwan.net/poem33748.html","البسيط"],[560,"ظهر الحق للعيان وبينا","https://www.aldiwan.net/poem33801.html","الخفيف"],[560,"علم عظيم النفع للعالم","https://www.aldiwan.net/poem34181.html","السريع"],[560,"ما تركت الكل إلا ورعا","https://www.aldiwan.net/poem34388.html","الرمل"],[560,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[560,"إن للإحسان نورا","https://www.aldiwan.net/poem34550.html","مجزوء الرمل"],[560,"أنا كل الوجود والكائنات","https://www.aldiwan.net/poem34732.html","الخفيف"],[560,"يا أيها الناس خذوا حذركم","https://www.aldiwan.net/poem34960.html","السريع"],[560,"تفاخر الماء والهواء","https://www.aldiwan.net/poem35076.html","مخلع البسيط"],[561,"مل بنا يا سعد وانزل بالحجون","https://www.aldiwan.net/poem69342.html","الرمل"],[563,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[564,"ويلاه من عرس تحول مأتما","https://www.aldiwan.net/poem52772.html","الكامل"],[577,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[706,"","https://poetry.dctabudhabi.ae/diwan/poem/31552","البسيط"],[814,"","https://poetry.dctabudhabi.ae/diwan/poem/123316","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/20866","البسيط"]],"verses":[["وَالتِفاتٌ إِلى التَصابي وَقَد أَس","رَعَ بي جامِحُ الثَلاثينَ رَكضا",0,"ض",2,0],["وَالتَحتُ مِن كَمِدٍ إِلَيهِ وَوِردُهُ","ناءٍ يُعَذِّبُ غُلَّةَ المُلتاحِ",1,"ح",1,0],["والْتِفاتي إِلى سِنِيَّ يُريني","عَددَاً لَيْسَ يَقْتَضي غَدْرُها بي",2,"ب",2,0],["وَأَلتَقي الطَعنَ تَحتَ النَقعِ مُبتَسِم","وَالخَيلُ عابِسَةٌ قَد بَلَّها العَرَقُ",3,"ق",1,0],["وَالتِبرُ كَالتُربِ مُلقىً في أَماكِنِهِ","وَالعودُ في أَرضِهِ نَوعٌ مِنَ الحَطَبِ",4,"ب",1,0],["والتِّبْرُ لوْلا السّبْكُ والتّمحيصُ لمْ","يُشْتَقّ منْ خبَثِ التّرابِ نُضارُهُ",5,"ر",2,0],["والْتَقى رائِدُ الحِجاز ونَجْرا","نٍ وسعْدُ الإمْحالِ في كلِّ وادي",6,"د",2,0],["والْتَذّ بالباقِي فحَثَّ الخُطَى","ومَرّ بالفانِي فَما عَرَّجا",7,"ج",2,0],["وَالتارِكُ القِرنَ الكَمِي","يِ مُجَدَّلاً رَعِشَ الأَنامِل",8,"ل",1,0],["وَالَّتي تُلبِثُ الرُؤوسَ مِنَ النُع","مى وَيَأتي إِسماعُها الأَقواما",9,"م",2,0],["وَاِلتِفاتٌ كَأَنَّما هُوَ بِالإي","حاءِ مِن فَرطِ لُطفِهِ تَعريضُ",10,"ض",1,0],["وَالتَّاجُ أَشْجَى إِذَا مَا انْفَضَّ عَنْ صَنَمٍ","مِنْهُ إِذَا مَا هَوَى عَنْ رأَْسِ إِنْسَانِ",11,"ن",1,0],["وَالْتَقَى الْيَوْمَ صَوْتُنَا بِصَدَاهُ","أَمْسِ بَيْنَ التَّوْدِيعِ والتَّسْلِيمِ",12,"م",1,0],["وَالتَّكْرِماتُ الحَاشِدَاتُ مَظَاهِرٌ","لِشُعُورِهَا الفَيَّاضِ وَهْوَ عَمِيمُ",13,"م",1,0],["وَالتارِكَ القِرنَ مُصفَرّاً أَنامِلُهُ","في صَدرِهِ قِصدَةٌ مِن عامِل صَرِدِ",14,"د",1,0],["والتمالخ ثم تصطاد","الطيور مع السلالق",15,"ق",1,0],["والتاج تاجُ البدر في أفق العلا","ما زال بالزُّهر النجومُ يُكَلَّلُ",16,"ل",1,0],["والتزمنا الفروع منه فضاعت","بالتزام الفروع منه الأصول",17,"ل",1,0],["وَالتَغلَبِيُّ عَلى الجَوادِ غَنيمَةٌ","بِئسَ الحُماةُ عَشِيَّةَ الإِرنانِ",18,"ن",1,0],["وَالتَغلَبِيُّ مُغَلَّبٌ قَعَدَت بِهِ","مَسعاتُهُ عَبدٌ بِكُلِّ مَكانِ",18,"ن",1,0],["وَالتَغلِبِيُّ لَئيمٌ حينَ تَجهَرُهُ","وَالتَغلِبِيُّ لَئيمٌ حينَ يُختَبَرُ",19,"ر",1,0],["وَالتَغلَبِيُّ إِذا تَمَّت مُروأَتُهُ","عَبدٌ يَسوقُ رِكابَ القَومِ مُؤتَجَرُ",19,"ر",1,0],["وَالتَيمُ عَبدٌ لِأَقوامٍ يَلوذُ بِهِم","يُعطي المَقادَةَ إِن أَوفَوا وَإِن غَدَروا",20,"ر",3,0],["وَالتَيمُ كانَ سَطيحاً ثُمَّ قيلَ لَهُم","شَأنَ السَطيحِ إِلى تَخبيلِهِ العَوَرُ",20,"ر",1,0],["وَالتَغلِبِيَّةُ حينَ غَبَّ غَبيبُها","تَهوي مَشافِرُها لَشَرِّ مَخافِرِ",21,"ر",1,0],["وَالتَيمُ أَلأَمُ مَن يَمشي وَأَلأَمُهُم","أَولادُ ذُهلٍ بَنو السودِ المَدانيسِ",22,"س",1,0],["وَالتَغلِبِيّونَ بِئسَ الفَحلُ فَحلُهُمُ","فَحلاً وَأُمُّهُمُ زَلّاءُ مِنطيقُ",23,"ق",1,0],["وَالتَغلِبِيُّ إِذا تَنَحنَحَ لِلقِرى","حَكَّ اِستَهُ وَتَمَثَّلَ الأَمثالا",24,"ل",2,0],["وَاِلتَفَّ عَيصُكَ في الأَعياصِ فَوقَ رُبىً","تَجري لَهُنَّ سَواقي الأَبطَحِ العُظُمُ",25,"م",1,0],["وَالتَقِيِّ النَقِيِّ باقِرِ عِلمِ ال","لَهِ فينا مُحَمَّدِ بنِ عَلِيِّ",26,"ل",2,0],["وَالتَغلِبِيّونَ اِحتَمَوا عَن مِثلِها","فَعَدَوا عَلى العادينَ بِالسُلّانِ",27,"ن",1,0],["والتاركين لبيتهم فرعاً به","نشأت لهم بعد الدروس أصول",28,"ل",1,0],["وآلت معانينا إلى مسكِ ذكره","فكانت لذكرِ الأكرمين ختاما",29,"م",2,0],["والتكاليف لا تُحَدّ اتساعاً","وكثيرٌ من ينصر البُعَداءَ",30,"ا",2,0],["والتفاتاً نحوي وقد قبضَتني","عنك أيدي النَّوى حِيال الْتِفاتي",31,"ت",2,0],["والتي ما رأيتها قطُّ إلا","عاد عندي الحسان مثلَ السِّماجِ",32,"ج",1,0],["وألتَ جهلاً من المَراح إلى","هَيجاءَ ليست بذات إفراش",33,"ش",1,0],["والتفَّ عيصُ المجدِ فينا واشتبكْ","إيهِ عن الشائمِ أصحابَ فدكْ",34,"ك",1,0],["والتقى عندَك شُكْرٌ","ومزيدٌ ودوامُ",35,"م",1,0],["وَاِلتَقى العاشِق وَالقالي فَما يَفتَرِقانِ","أَفَهَذا مُنتَهى العَدلِ فَقالَت لَستُ أَدري",36,"ي",1,0],["وَاِلتَقى البَحرانِ فيهِ بَعدَما","مَرَّتِ الأَجيالُ لا يَلتَقِيان",37,"ن",1,0],["والتقتْ عندها الشِّفاهُ وغنَّتْ","قُبَلٌ أَجْفَلَتْ لديها همومُهْ",38,"م",2,0],["والتقينا بغتة بعد النوى","فتعانقنا واجهشنا معا",39,"ع",2,0],["والتقى البائس والنعمى به","وسعى المأوى لأبناء السبيل",40,"ل",1,0],["والتقينا ما خطا لي خطوة","لا ولم أنقل إليه قدمى",41,"ا",1,0],["وَالتَقِيّاتُ بَناتُ المُتَّقي","وَالآميناتُ بُنَيّاتُ الأَمين",42,"ن",1,0],["وَالتَناهي فَما تَعَدّى عَزيزاً","فيكِ عِزٌّ وَلا مَهيناً مَهانَه",43,"ن",2,0],["والتحمت منها تراكيبنا","حتى انتهت منها إلى الأفضلِ",44,"ل",1,0],["وَاِلتِفاتي إِلَيكَ مِن جَبَلِ القا","طولِ وَالدَمعُ ساكِبٌ ذو اِندِفاقِ",45,"ق",1,0],["والتُّربُ ظَمآنُ الجَوانحِ ما سَرى","رَكْبُ السَّحابِ عليه وهي جَهَامُ",46,"م",1,0],["والتهَبَت نَارُنَا فمنظرُها","يُغْنيكَ عن كلِّ منظرٍ عَجَبِ",47,"ب",1,0],["وَاِلتِماسي لِما أُطالِبُ مِنها","لَم أَكُن لِاِلتِماسِهِ بِحَقيقِ",48,"ق",1,0],["وَالتَصاريفُ جَمَّةٌ غادِياتٌ","رائِحاتٌ وَالحادِثاتُ فُنونُ",49,"ن",1,0],["وَاِلتَزَمنا شُروطَها وَاِتَّبَعنا","أَدَبَ الإِفتِراقِ وَالإِجتِماعِ",50,"ع",1,0],["وَالتَناجي بِالطورِ إِذ كَلَّمَ الرَح","مَنُ موسى نَبِيَّهُ تَكليما",51,"م",2,0],["وَأَلتَجي بِالتَسَلّي أَن سَتُخلِفُها","أَبناؤُكَ الغُرُّ أَو أَبناؤُكَ الصيدُ",52,"د",1,0],["والتعلات من هوى وشباب","قصة مسدل عليها الستار",53,"ر",1,0],["والتقى السحر عنده والذكاء","وشحوب كظل خمر وللندمان تجلو شحوبها الصهباء",54,"ا",2,0],["والتَظى في اليَمينِ منه يَمانٍ","كاد للأثر منه نَمْلٌ يَثورُ",55,"ر",1,0],["وَآلَت كَما آلَ المُجَرَّبُ بَعدَ ما","صَحَوتُ وَمَلَّ العاذِلاتُ مِنَ العَذلِ",56,"ل",1,0],["وَاِلتَمِس ناصِحاً قَريباً مِنَ الوِر","دِ يُحِسُّ الحَديثَ وَالأَخبارا",57,"ر",2,0],["وَالتَأَمَ الشِعبُ وَما إِن عَدا","رَأيُ أَميرِ المُؤمِنينَ الصَلاح",58,"ح",1,0],["وَاِلتِثامٍ بَينَ مُعتَنِقٍ","وَاِعتِناقٍ بَينَ مُلتَثِمِ",59,"م",1,0],["وَالتارِكُ البيضَ مِن ضَربِ الرُؤوسِ بِها","كَأَنَّما هِيَ فَوقَ إِلهامِ تيجانُ",60,"ن",1,0],["وَالتَماسيحَ وَالسَنادِلَ وَالأَيِّلَ","شَتى وَالرِئمَ وَالعُصفورا",61,"ر",2,0],["وَالتُبَّعِيّونَ وَبُختُ نَصَّرِ","وَحُكَماءُ الرومِ وَالإِسكَندَرِ",62,"ر",1,0],["والتَفَّ عِيدِيٌّ وعِيدِيّةٌ","تَمَايُلَ العِذْقِ على العِذْق",63,"ق",1,0],["وَالَّتي أُمسي وَأَغدو","في عَشِيٍّ وَغَداةِ",64,"ه",1,0],["وَالتُبَّعَينِ وَذا نُؤاسٍ غُدوَةً","وَعلا أُذَينَةَ سالِبَ الأَرواحا",65,"ح",2,0],["وَالتاجُ تَقوى اللَهِ لا ما رَصَّعوا","لِيَكونَ زيناً لِلأَميرِ التائِجِ",66,"ج",1,0],["وَالتُربُ نَقليهِ ظُلماً وَهوَ والِدُنا","وَكَم لَنا فيهِ مِن قُربى وَمِن رَحِمِ",67,"م",1,0],["وَالتُربُ مَثوايَ وَمَثواهُمُ","وَما رَأَينا أَحَداً مِنهُ قام",68,"م",1,0],["والتقتِ الرِّجالُ بالرِّجالِ","وانغمَسوا في غَمْرةِ القتالِ",69,"ل",1,0],["والتي يَعنو لها البدرُ سَبَتْ","عَنْوَةً روحي ومالي وحُمَي",70,"ي",1,0],["والتفتَ الضوءُ للوداع","يهمسُ في رِقّةٍ ووجدِ",71,"د",1,0],["والتقتْ عيناهما فاستروحا","راحةً من قبلها ما عرفاها",72,"ا",3,0],["والتمس في الفراشِ دِفئاً يُنسِّ","يكَ نهارَ الأسى وليلَ الخطوبِ",73,"ب",1,0],["وَأَلتَقي الطَعنَ تَحتَ النَقعِ مُبتَسِماً","وَالخَيلُ عابِسَةٌ قَد بَلَّها العَرَقُ",74,"ق",1,0],["وَالَتْ عَلَى الدُّنْيَا الفُتُوحُ الَّتِي","تَعَاقَبَتْ وَاتَّصَلَتْ كَالسَّبَبْ",75,"ب",1,0],["وَالتَّرَاضِي بَيْنَ القَرِينَيْنِ أَسْمَى","مَا أَرَادَ المُهَيْمَنِ المِيعَالِي",76,"ل",2,0],["وَالتَّهَالِيلُ وَالمَعَازِفُ تُشْجِي","بِضُرُوبِ الإِيقاعِ وَالإِنْشادِ",77,"د",1,0],["وَالْتِمَاسٌ لِوَجْهِ رَبِّكَ فِي","إِسْعَافِ ذِي عِلَّةٍ وَذِي إِمْلاَقِ",78,"ق",1,0],["وَالتَّاجُ لا يَنْفِي الصُّدَا","عَ وَيَفْتَدي رَأْسَ الأَمِيرْ",79,"ر",1,0],["والتارِكُ القِرْنَ الكَميَّ مُجَدَّلاً","يَوْمَ الكَرِيهَةِ والقَنا يَتَقَصَّدُ",80,"د",1,0],["والتقت أجمعها في محفل","وقف الفولاذ فيهم خاطباً",81,"ب",2,0],["والتمتمات على الشف","ه مضرجات بالنسيب",82,"ب",1,0],["وَالتُقاةُ في ظَلَلِ ال","خُلدِ مَع مُبَشِّرِها",83,"ر",3,0],["والتمس رزقكَ من ذي ال","عرش والربّ القديرِ",84,"ر",1,0],["وَالتَّرْجَمَاتُ تَشُنُّ الْحَرْبَ لاَقِحَةً","عَلَى الفَصِيح فَيَا لِلْوَيْلِ وَالْحَرَبِ",85,"ب",1,0],["وَالْتَمِسْ نَفْحَةَ الرَّسُولِ وَطَارِحْ","في أَفَانِينِ مَدْحِهِ حَسَّانَه",86,"ن",2,0],["والتفَّتْ الرَّاياتُ حولَ لِوائِه","ودَعا الغُفَاةَ إِلى المَسِير فَساروا",87,"ر",3,0],["وَالتَهَاليِلُ تَمْلأُ الْمَلأ الأعْلَى","وَتَعْنُو لِقُدْسِهِ تَمْجِيدَا",88,"د",2,0],["والتوتُ والصَّفْصافُ يهتفُ طيرُه","فتردِّدُ الكُثْبانُ والآكامُ",89,"م",1,0],["والتمِسْ فيه نفسه، تلق صفوًا","من لُجَين أذيب في دَنِّ راح",90,"ح",1,0],["والتذ بالباقي فحط الخطا","ومر بالفاني فما عرجا",91,"ج",2,0],["والتقى رائد الحجاز ونجران","وسعد الأمحال في كل واد",92,"د",1,0],["والتظى برق، تضنَّى خلفه","ألف دنيا، من ينابيع السخاءِ",93,"ا",2,0],["والتوى حوله الردى كالأفاعي","وتلوّى كالأفعوان صريعه",94,"ع",2,0],["والتقو ليلة عجوزا توارت","في أخاديدها النجوم الخوامد",95,"د",1,0],["والتقوا يغسلون بالنار دنيانا","ويمحون بالدم الأوحالا",96,"ل",2,0],["والتقى \" النيل \" والسعيدة جسما","صافحت كفّه اليمين الشمالا",96,"ل",2,0],["والتقينا نمدّ للفجر أفقا","من دم التوأمين \" عاد \" و\" هاشم \"",97,"م",1,0],["والتقينا به (بنجران) حينا","والتقينا بقلب (جيزان) حقبّه",98,"ب",2,0],["والتقينا على (الوديعة) يوما","والمنايا على الرؤوس مكبّه",98,"ب",2,0],["والتحفنا الردى ب( ميدي) سليماً","وانتعلناه في ( حريب) طعينا",99,"ن",2,0],["والتاع فيها الشرّ فاهالت على","ذاك الفتى بالضرب والطّعنات",100,"ت",1,0],["والتقينا نريق دمع المآقي","فأبت كبرياؤنا أن نريقه",101,"ق",2,0],["والتماس المساعدات لتفنى","جبهة الشعب تحت نعل التجارة",102,"ر",2,0],["والتقت عيناهما فاستروحا","راحة من فبلها ما عرفاها",103,"ا",3,0],["و\" التاج\" اذ نَقَمت عليه عصابةٌ","قامرتَهُمْ فيهِ فكنت الرابحا",104,"ح",2,0],["والتفَّ عن أطرافه هََمَجٌ","مثل النَّعام يسودُها الذُعر",105,"ر",1,0],["والتي جِئت