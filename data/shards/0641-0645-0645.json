{"poems":[[46,"إذا ما شبت حسن الدي","https://www.aldiwan.net/poem29672.html","مجزوء الوافر"],[92,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[132,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[132,"من لصب تصاعدت حسراته","https://www.aldiwan.net/poem50653.html","الخفيف"],[240,"سقى منزلا بين الشقيقة والضال","https://www.aldiwan.net/poem31772.html","الطويل"],[469,"شف قلبي دلاله","https://www.aldiwan.net/poem3358.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48891","الكامل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2305,"","https://poetry.dctabudhabi.ae/diwan/poem/143181","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137078",""],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140089",""],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130046","الرمل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126918","البسيط"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93256","الكامل"],[5277,"غرور","https://www.poetsgate.com/ViewPoem.aspx?id=185285",""],[6189,"أحزان جديدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83596&r=&rc=63",""]],"verses":[["فَمِمَّن شِئتَ كُن فَلَقَد","فَلَحَت بِأَكرَمِ النَسَبِ",0,"ب",1,0],["فمٌ من الذهب الابريزِ مَنطِقُهُ","جاءتْ تُعزّي به الأشعارَ أفواه",1,"ا",2,0],["فمماتي في صدِّه ونواهُ","وحياتي في وَصْلِه ولقائِهْ",2,"ا",3,0],["فمماتي هجرانُه ونَوَاهُ","وحياتي بعدَ النَّوَى خلواتُه",3,"ت",2,0],["فَمَمزوجَةٌ وَشيٌ بِها مِن ضِيائِها","شِعاعٌ كَبَرقِ الشَمسِ كاشِفَةُ البالِ",4,"ل",1,0],["فمماتي إعراضهُ","وحياتي إقبالهُ",5,"ل",2,0],["فممالك تهتز بعد سكونها","وممالك تعتز بعد هوان",6,"ن",1,0],["فمما قد جهلتم لم تكونوا","لما أعطيتموه آخذينا",7,"ن",2,0],["فمم علو البدر والمال غائب؟","وفيم سفال الكنز والمال حاضر",8,"ر",1,0],["فممدوح الخليل له مثيل","وما للحبر بيوس من مثيل",9,"ل",1,0],["فممثل لعطارد ومديرها","مع مايل ومعدل من خمسة",10,"ه",1,0],["فمماتُ الشعبِ موثوقٌ به","إن هوى في اليأس يوماً أو وقَع",11,"ع",1,0],["فممره قد تقضى وهو في لعب","لاه يخال المنايا لا تقاربه",12,"ب",2,0],["فَممالِكُ السّلْطان ساكنةُ الحَشا","مِنْ بعدِ ما كانتْ فريسةَ طاردِ",13,"د",1,0],["فمّمنْ أنت مخلوقٌ لتدمي","حبيبا ذنبهُ صعبُ المنالِ",14,"ل",1,0],["فمٌ من جراح الناس يغلي ويَغْرف","وللمقام المخبوء يشدو ويعزف",15,"ف",1,1]]}