{"poems":[[44,"إذا ما شبت حسن الدي","https://www.aldiwan.net/poem29672.html","مجزوء الوافر"],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[126,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[126,"من لصب تصاعدت حسراته","https://www.aldiwan.net/poem50653.html","الخفيف"],[233,"سقى منزلا بين الشقيقة والضال","https://www.aldiwan.net/poem31772.html","الطويل"],[462,"شف قلبي دلاله","https://www.aldiwan.net/poem3358.html","عموديه"]],"verses":[["فَمِمَّن شِئتَ كُن فَلَقَد","فَلَحَت بِأَكرَمِ النَسَبِ",0,"ب",1,0],["فمٌ من الذهب الابريزِ مَنطِقُهُ","جاءتْ تُعزّي به الأشعارَ أفواه",1,"ا",2,0],["فمماتي في صدِّه ونواهُ","وحياتي في وَصْلِه ولقائِهْ",2,"ا",3,0],["فمماتي هجرانُه ونَوَاهُ","وحياتي بعدَ النَّوَى خلواتُه",3,"ت",2,0],["فَمَمزوجَةٌ وَشيٌ بِها مِن ضِيائِها","شِعاعٌ كَبَرقِ الشَمسِ كاشِفَةُ البالِ",4,"ل",1,0],["فمماتي إعراضهُ","وحياتي إقبالهُ",5,"ل",2,0]]}