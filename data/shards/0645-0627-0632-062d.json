{"poems":[[53,"هاجرني ظلما أبو حفصل","https://www.aldiwan.net/poem7968.html","السريع"],[47,"اسمع هديت أبا يحيى مقال أخ","https://www.aldiwan.net/poem64548.html","البسيط"],[366,"ومهفهف الاعطاف سيف لحاظه","https://www.aldiwan.net/poem68115.html","الكامل"],[376,"مازحت بالحب ضامر الكشح","https://www.aldiwan.net/poem57512.html","المنسرح"],[473,"لنا أخ يحفظ من خانه","https://www.aldiwan.net/poem59568.html","السريع"],[505,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70774","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120008","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46574",""],[3471,"","https://poetry.dctabudhabi.ae/diwan/poem/56427","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108385",""],[3965,"","https://poetry.dctabudhabi.ae/diwan/poem/147776","المنسرح"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123522","المنسرح"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103282","الكامل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62116","الكامل"],[4767,"صفحة الخير","https://www.poetsgate.com/ViewPoem.aspx?id=125022",""]],"verses":[["مازحتُه في بعض أيامِه","فصار في النُّفخةِ كالحُبْلى",0,"ل",2,0],["مازَحتُهُ غَيرَ ذي عِلمٍ بِخِسَّتِهِ","في نَظمِ مَمدَحَةٍ مِن حُرِّ أَشعارِ",1,"ر",1,0],["مازَحتُه يَوما عَلى شرط الهَوى","فرنا وَهز عَلَيّ عادل قَدّه",2,"د",2,0],["مازحتُ بالحبِّ ضامر الكشحِ","وأوَّلُ الجدِّ آخر المزحِ",3,"ح",1,1],["ما زَحَفَ المَطلُ إِلى وَعدِهِ","قَطُّ وَلا نازَلَ سُلطانَهُ",4,"ن",2,0],["مازِحِ الطِّفلَ عظِّمِ الشَّيْخَ وقِّرْ","رَبَّ دينٍ في طَوْرِهِ اسْتِحْياءُ",5,"ا",2,0],["مازح فيما قد رووه خلقا","ولم يكن يقول إلا حقا",6,"ق",2,0],["ما زحتْه لطافةٌ تشرحُ الصد","ر وتُطفِي وهيجَ حرِّ الأُوام",7,"م",1,0],["مازحته فومقته","والحب أوله مزاحُ",8,"ح",1,0],["مازحِ وطايب ما استطعتَ فما الفتى","ممّن يكون ممازحاً ومطايبا",9,"ب",2,0],["مازَحْتُها فَبَكَتْ واستَعْبَرتْ جَزَعاً","عَنّي فلَمَّا رأتين باكياً ضَحِكَتْ",10,"ت",1,0],["مازحات في رقصهن على الأَر","ض وذا الرقص بات في الارض جدا",11,"د",2,0],["مازحت بالأمس أهيفا حسنا","قد كمل الظرف من بني الأمرا",12,"ر",2,0],["مازحت الروح والمزاج فما","يطرقها بانقضا الزمان فنا",13,"ن",2,0],["مازِحٌ صديقتَكَ ما أحَبَّ مُزاحا","وتَوَقَّ منه في المزاح جماحا",14,"ح",2,1],["مازحته ولم أدر ما جد الهوى","حتى قدحت زناده بمزاح",15,"ح",1,0],["ما زحزحته التي ما كان ما فعلت","بِمثله من عظيم الأمر مُحتملا",16,"ل",2,0]]}