تّى اِنحَطَم",2,"م",1,0],["هَبنِيَ العَضبَ ذَليقاً حَدُّهُ","ثَلَّمَ البيضَ ضِراباً وَاِنثَلَم",2,"م",1,0],["هُبّوا فَقَد تَتَيَقَّظُ ال","أَجدادُ لِلقَومِ النِيامِ",3,"م",1,0],["هَبني خَسَأتُ الخَطبَ عَنّي وَما","قَدَّرتُ إِلّا أَنَّهُ آكِلي",4,"ل",2,0],["هَبني شَبيباً يَومَ طاحَت عُنقُهُ","عَن حَدِّ مَفتوقِ الغِرارِ قاصِلِ",5,"ل",1,0],["هَبَّت لَنا مِن رِياحِ الغَورِ رائِحَةٌ","بَعدَ الرُقادِ عَرَفناها بِرَيّاكِ",6,"ك",1,0],["هَب لَم يَكُن لَكَ بِالوَفاءِ عَوائِدٌ","أَتُراكَ ما أَحسَنتَ أَن تَتَوافى",7,"ف",2,0],["هَبَّ مِن رَقدَةِ الفُتورِ إِليهِ","بَعدَما غَضَّ ناظِرَيهِ وَأَغفى",8,"ف",2,0],["هَبها ضَبابَةَ لَيلٍ أَنتَ خابِطُها","إِنَّ الظَلامَ وَإِن عَنّاكَ مُنكَشِفُ",9,"ف",1,0],["هَب لي وَحَسبي نَظرَةٌ أَرنو بِها","فَمَقَرُّها وَجهُ الحُسَينِ الزاهِرُ",10,"ر",1,0],["هَب لِلدِيارِ بَقِيَّةَ الجَلَدِ","وَدَعِ الدُموعَ وَباعِثَ الكَمَدِ",11,"د",1,1],["هَبوها إِلَيكُم مِن يَديَّ مَنيحَةً","فَقَد آنَ يا لِلقَومِ رَدُّ المَنايِحِ",12,"ح",1,0],["هَبَبنَ وَلَم تُغرِهِنَّ الخُداةُ","فَقامَ الهِبابُ مَقامَ الحُدا",13,"ا",1,0],["هَبِ القُرَشِيَّ اِعتادَهُ لاعِجُ الهَوى","وَمادَ فَما لِلعامِريِّ يَمييدُ",14,"د",1,0],["هَبني أُغَيِّضُها مالَم تُشَبْ بِدَمٍ","فَكَيفَ أَستُرُها مَمزوجَةً بِدَمِ",15,"م",1,0],["هَبِي المَطايَا فَرَّقَتْ بَيْنَنَا","لا فَارَقَتْها أَبَداً أَنْسُعُ",16,"ع",1,0],["هُبّي عَسى وَجدي يَخِفُّ وَتَنطَفي","نيرانُ أَشواقي بِبَردِ هَواكِ",17,"ك",1,0],["هَبي دَمعي لِعَيني إِنَّ دَمعي","مُطيعُكِ يا ظَلومُ وَقَد عَصاني",18,"ن",2,0],["هَبي لي دَمي لا تَقتُليني بِلا دَمٍ","فَما يَستَحِلُّ القَتلَ أَهلُ التَوَرُّعِ",19,"ع",1,0],["هَبوني أَغُضُّ إِذا ما بَدَت","وَأملِكُ طَرفي فَلا أَنظُرُ",20,"ر",1,1],["هَبنيَ قَد مُتُّ بِهَذا الهَوى","فَما الَّذي يُرضيكَ مِن أَن أَموت",21,"ت",1,0],["هَبيني اِمرَأً إِن تُحسِنى فَهوَ شاكِرٌ","لِذاكَ وَإِن لَم تُحسِني فَهوَ صافِحُ",22,"ح",1,1],["هَبْ لي رِضاكَ فإنّني مُسْتَشْفِعٌ","بحُلَى أميرِ المُسْلِمينَ المُرْتَجى",23,"ج",2,0],["هَبّ النّسيمُ معَطَّرَ الأراجِ","فشَفَى لَواعِجَ قَلْبي المُهْتاجِ",24,"ج",1,1],["هَبَطتُ إِذا ما الآلُ آضَ كَأَنَّهُ","عِضاهٌ تَرَدّى بِالمُلاءِ أُطاوِلُه",25,"ل",2,0],["هَبَطتُ بِمَلبونٍ كَأَنَّ جِلالَهُ","نَضَت عَن أَديمٍ لَيلَةَ الطَلِّ أَحمَرا",26,"ر",2,0],["هَبِلَتكِ أُمُّكِ هَل لَدَيكِ فَتُرشِدي","في آخِرِ الأَيّامِ مِن تِبيانِ",27,"ن",1,0],["هَبوا دَنلوبَ أَرحَبَكُم جَناناً","وَأَقدَرَكُم عَلى نَزعِ الحُقودِ",28,"د",1,0],["هَبوا الأَجيرَ أَوِ الحَرّاثَ قَد بَلَغا","حَدَّ القِراءَةِ في صُحفٍ وَفي كُتُبِ",29,"ب",1,0],["هَبوه أخطَأَ في تَأْويلِ مَقصِدِه","وأنّها سَقطَةٌ في عينِ ناعيها",30,"ي",3,0],["هُبوطُها المَوتُ وَالصُعودُ","ضَربٌ مِنَ البُؤسِ وَالبَلاء",31,"ا",2,0],["هَبني أَسَأتُ كَما تقَوَّلَ وَاِفتَرى","وَأَتَيتُ في حُبَّيكَ أَمراً مُنكَرا",32,"ر",2,0],["هَبِ العَزلَ أَضحى لِلوِلايَةِ غايَةً","فَما غايَةُ الموفي مِنَ الظِلِّ أَن يُكري",33,"ي",1,0],["هَبيكِ اِعتَرَرتِ الحَيَّ واشيكِ هاجِعٌ","وَفَرعُكِ غِربيبٌ وَلَيلُكِ أَغضَفُ",34,"ف",1,0],["هَبني جَهِلتُ فَكانَ العِلقُ سَيِّئَةً","لا عُذرَ مِنها سِوى أَنّي مِنَ البَشَرِ",35,"ر",1,0],["هَبيكِ اِغتَرَرتِ الحَيَّ واشيكِ هاجِعٌ","وَفَرعُكِ غِربيبٌ وَلَيلُكِ لائِلُ",36,"ل",1,0],["هب على راكباً مهره","ومر خطفاً حانياً ظهره",37,"ه",1,0],["هَبَّ الغَدَاةَ وَاوَلَى","إِلَى الزَّوَالِ اضْطِرَابَهْ",38,"ب",2,0],["هِبَةٌ مِنَ اللهِ الكَرِيمِ","أَتَتْ عَلَى قَدَرِ التَّمَنِّي",39,"ن",2,0],["هُبُّوا لإِصْلاحِ القُرَى هِبَّةً","تُؤْثَرُ فِي تَارِيخِهَا عَنْكُمُ",40,"م",1,0],["هَبَّت وَقَد عَلِمَت أَن لا هُبوبَ بِهِ","وَقَد تَكونُ حَسيراً إِذ يُباريها",41,"ي",3,0],["هِبِلٍّ أَبي عِشرينَ وَفقاً يَشُلُّهُ","إِلَيهِنَّ هَيجٌ مِن رَذاذٍ وَحاصِبِ",42,"ب",1,0],["هبوا لحكمِكُمُ الرصين فإِنّه","صرف القضاء فما له من واقِ",43,"ق",1,0],["هبَت على قطر الجهاد فروّضت","أرجاءه بالنفحة المعطارِ",44,"ر",1,0],["هبّ النسيم على الرياض مع السَحَرْ","فاستيقظت في الدوح أجفان الزَهَرْ",45,"ر",1,1],["هب اليراعة ردء السيف تأزره","فهل على الناس غير السيف محتكم",46,"م",1,0],["هَبْ منشأ الكونَ يبقى مبهماً أبداً","فهل ترى فيه عقلاً غير مُنبَهِر",47,"ر",1,0],["هَبْه أبدى من العلوم نُجوماً","في ليال من المَشاكل دُهْم",48,"م",1,0],["هَبَّت شَمالاً فَذِكرى ما ذَكَرتُكُمُ","عِندَ الصَفاةِ الَّتي شَرقَيَّ حَورانا",49,"ن",2,0],["هَبَنَّقَةُ الَّذي لا خَيرَ فيهِ","وَما جَعلُ السَقيمِ إِلى الصَحيحِ",50,"ح",1,0],["هَبهُ أَساءَ كَما زَعَمتَ فَهَب لَهُ","وَاِرحَم تَضَرُّعُهُ وَذُلَّ مَقامِهِ",51,"م",2,1],["هَب لِلمُقِرِّ بِذَنبِهِ","وَاِصفَح لَهُ عَن عُظمِ جُرمِه",52,"م",2,0],["هَبَّت لَهُ ريحٌ شَآمِيَّةٌ","مَتَّت إِلى القَلبِ بِأَسبابِ",53,"ب",1,0],["هَبِلتُم عَلَينا تَفخَرونَ وَأَنتُمُ","لَنا خَوَلٌ ما بَينَ ظِئرِ وَخادِمِ",54,"م",1,0],["هَبِلَت أُمُّهُم وَقَد هَبِلَتهُم","يَومَ حَلّوا بِحارِثِ الجَولانِ",55,"ن",1,0],["هبْ أنها الظبي لكن غير ملتفتٍ","فعطفها اللّينُ هلاّ غير ذي عنت",56,"ت",1,1],["هبني رضيت بما ارْتضاهُ فما لمن","يلحي عليه بنفسه قد أبلشا",57,"ش",2,0],["هبطت بمغناك العلوم وإنما","هبطت إليك من المحل الأرفع",58,"ع",1,0],["هَبكم منعتم جفوني من خيالكم","فكيفَ يمنع تذكارٌ وتخييل",59,"ل",1,0],["هبّ في جامه كخمرةِ فيهِ","وسقاني فوهُ كخمرة جامِه",60,"م",2,0],["هبة للعلى من الله ما زا","لَ لدى النسك والعطاء وليَّا",61,"ي",2,0],["هَبني اِدَّعَيتُ بِأَنّي مُدنِفٌ سَقِمُ","فَما لِمَضجَعِ جَنبي كُلُّهُ حَسَكُ",62,"ك",1,0],["هب من مهده ودب غريبَ","الدار في ظل خيمة دكناء",63,"ا",2,0],["هبِ الروضَ لا يُثْني على الغيثِ نشرُهُ","أمنظرُهُ يُخفي مآثرَهُ الحُسنى",64,"ن",2,0],["هَبوني امرأً لا حظَّ فيه لمجتَنٍ","أمَا في اصطناع العُرْف مكرُمةٌ تبنى",65,"ن",2,0],["هَبْ لراجيكَ ما عليه فإِنَّ اس","مَك وهبٌ ووَسْمك والوهّابُ",66,"ب",1,0],["هبالي ما لِقَدْحي يُوري","ألم أقدَحْ بزندٍ غير كابِ",67,"ب",1,0],["هَبُوا أبا يوسفٍ هجاني","فالشاعرُ العالم الأديبُ",68,"ب",1,1],["هَبْهَا تخلَّتْ من فضائلِ نَفْيها","أتخالها مما أعَرْتَ تَخَلَّتَ",69,"ت",1,0],["هبها كإحدى هَناتِ أحمدَ إذ","يضرطُ في كل مجلس عَبَثا",70,"ث",2,0],["هب على رأسك العنا","قيدَ والقارَ والسَّبَجْ",71,"ج",1,1],["هب على رأسك الدُّجَى","ثَبَجاً فوقَه ثبَجْ",71,"ج",1,0],["هَبه سيْفاً أعددْتَه قَلَعِيّاً","للإمام النَّجِيد في إنجادِهْ",72,"د",2,0],["هبني امرءاً ليستْ له بك حرمةٌ","تُرْعَى أما لي زَلَّةٌ تُتَغَمَّدُ",73,"د",1,0],["هَبْنيَ لا حقَّ لي سوى مِقَتي","إياك حسبي 