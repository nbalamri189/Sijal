{"poems":[[55,"أعاد لي عيد الضنى","https://www.aldiwan.net/poem29729.html","مجزوء الرجز"],[95,"لحق اليوم بالرفاق أمين","https://www.aldiwan.net/poem11209.html","الخفيف"],[74,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[53,"حزني منك يا ابنة الأملاك","https://www.aldiwan.net/poem65829.html","الخفيف"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[53,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[53,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[47,"أين تلك الأيمان يا كذاب","https://www.aldiwan.net/poem11479.html","الخفيف"],[47,"أصدود غلا بها أم دلال","https://www.aldiwan.net/poem65596.html","الخفيف"],[47,"يا مغاني الأحباب صرت رسوما","https://www.aldiwan.net/poem65684.html","الخفيف"],[107,"رددوا الذكرى لقوم غافلين","https://www.aldiwan.net/poem42065.html","الرمل"],[107,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[107,"أئن تولت جنود الشرك مدبرة","https://www.aldiwan.net/poem44211.html","البسيط"],[104,"اغفري لي إذا اتهمتك بالغد","https://www.aldiwan.net/poem33102.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54920","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43804","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[102,"حيرة الساري","https://www.poetsgate.com/ViewPoem.aspx?id=50134",""],[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[124,"أين تلك العهود وافقن آمالي","https://www.aldiwan.net/poem49271.html","الخفيف"],[146,"من رأى المجد يثير القلاصا","https://www.aldiwan.net/poem58437.html","الخفيف"],[147,"يطمع الناس في البقاء وتابى","https://www.aldiwan.net/poem11735.html","الخفيف"],[228,"ملي النور قبل عهد البدور","https://www.aldiwan.net/poem39689.html","الخفيف"],[228,"في ليلة حالكة كالهموم","https://www.aldiwan.net/poem39701.html","السريع"],[234,"قسمة الموت قسمة لا تجور","https://www.aldiwan.net/poem51020.html","الخفيف"],[354,"أين تهوي قدمي عن ذي الهوى","https://www.aldiwan.net/poem15815.html","الرمل"],[371,"يا غزالا له السيوف حجاب","https://www.aldiwan.net/poem16947.html","المجتث"],[415,"يا قلب كم يستخفك القلق","https://www.aldiwan.net/poem32421.html","المنسرح"],[458,"قال لي الحب كيف تعزف عني","https://www.aldiwan.net/poem61587.html","الخفيف"],[463,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[463,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37932","السريع"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55884","الرمل"],[1306,"","https://poetry.dctabudhabi.ae/diwan/poem/199417","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78071","المتقارب"],[1470,"","https://poetry.dctabudhabi.ae/diwan/poem/216504","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87834","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126651","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126656","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74991","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53061","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53178","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53030","الخفيف"],[2431,"","https://poetry.dctabudhabi.ae/diwan/poem/139807",""],[2555,"","https://poetry.dctabudhabi.ae/diwan/poem/147067","الطويل"],[2629,"","https://poetry.dctabudhabi.ae/diwan/poem/121124","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205438","الخفيف"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124680","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58360","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201755","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200930","الخفيف"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102357","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89255","الخفيف"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52991","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62963","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108333",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108383",""],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101240","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216832","الخفيف"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/132062","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76446","الرمل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44913","الخفيف"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101395","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86394","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73133","الخفيف"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130601","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33672","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72517","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52131","الرمل"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[5213,"انشقاني من ربع مية طيبا","https://www.poetsgate.com/ViewPoem.aspx?id=170409",""],[5320,"إلى البيت الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=41634",""],[5353,"كن سوى ان تكون نفسك سجنا","https://www.poetsgate.com/ViewPoem.aspx?id=214881",""],[5388,"سوف أمضي","https://www.poetsgate.com/ViewPoem.aspx?id=206913",""],[5409,"طرق الباب حالماً بلقاها","https://www.poetsgate.com/ViewPoem.aspx?id=155363",""],[5431,"وعفريتُ قنديلي يئنُ ويشتكيٍ","https://www.poetsgate.com/ViewPoem.aspx?id=189638",""],[5459,"قصيدة العمر","https://www.poetsgate.com/ViewPoem.aspx?id=208707",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[5621,"كيفَ تمضي","https://www.poetsgate.com/ViewPoem.aspx?id=24563",""],[5823,"ياصديقي","https://www.poetsgate.com/ViewPoem.aspx?id=59800",""],[5982,"يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=152889",""],[6102,"حُداءُ الجَثامِين !!","https://www.poetsgate.com/ViewPoem.aspx?id=183615",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""]],"verses":[["أَينَ تَقولُ صَوبُهُ","فَقالَ لي دونَ قَنى",0,"ن",2,0],["أَيْنَ تِلْكَ الآمَالُ غِبَّ الدِّرَاسَا","تِ وَفِيهَا الحِجَى وَفِيهَا الجُنُونُ",1,"ن",1,0],["أينَ تلك الأوصاف تنفح طيباً","رخصت عنده فنون الغوالي",2,"ل",2,0],["أين تلك العهودُ لما التقينا","يوم شعب الغضا ووادي الأراك",3,"ك",1,0],["أين تغليسك البكورَ لحاجا","تِ نيام عنها ذوي استثقالِ",4,"ل",1,0],["أين تهجيرك الرواحَ على الأيْ","نِ مجدَّاً للاعبٍ بطَّالِ",4,"ل",1,0],["أين تشميرك الذيولَ ومستكْ","فيك في بال فاكهٍ ذيّالِ",4,"ل",1,0],["أيُّ نَتْن وأيُّ مَسْموعِ سوْءٍ","عدِماهُ حاشا الكتابِ الحكيم",5,"م",1,0],["أين تلك القصورُ والدورُ فيها","أين ذاكَ البنيانُ ذو الإحكام",6,"م",1,0],["أَينَ تِلكَ الأَيمانُ يا كَذّابُ","يَومَ صالَحتَني بِأَن لا عِتابُ",7,"ب",1,1],["أَينَ تِلكَ الأَخلاقُ مِنكَ إِذا رُم","تَ مَداها وَأَينَ تِلكَ الخِلالُ",8,"ل",1,0],["أَينَ تِلكَ الظِباءُ أَصبَحنَ في الحُس","نِ بُدوراً وَفي البَعادِ نُجوما",9,"م",2,0],["أين تمضِي عبقريّاتُ الأُلى","خدعوا الحمقى وغَرُّوا الجاهلينْ",10,"ن",1,0],["أين تمضي كلُّ شيءٍ مَصرعٌ","كلُّ فجٍ من فجاجِ الأرضِ سَدّ",11,"د",1,0],["أئِنْ تولّتْ جنودُ الشِّركِ مُدبرةً","خفَّ الرُّماةُ وظنّوا الأمرَ قد وجبا",12,"ب",2,1],["أَينَ تِلكَ السَماء هَل كانَ ذاك","الصرح فيها مشيّداً مِن سَحابِ",13,"ب",1,0],["أين ترى يا أرضُ يُلقي عصاهُ","وأيُّ وادٍ ضلَّ في تيههِ",14,"ه",1,0],["أَيْنَ تِلْكَ الشَّمَائِلُ البَارِعاتُ الظْرفِ","أَيْنَ الحَدِيثُ وَهْوَ الشَّمُولُ",15,"ل",1,0],["أَيْنَ تِلْكَ الأْلطَافُ وَالشِّيَمُ الحُسْنَى","جَلَتْهَا وَسَلْسَلَتْهَا الأُصُولُ",15,"ل",1,0],["أَيْنَ تِلكَ الأَسْمَارُ كَانَتْ بِهَا تَصْفُو","اللَّيَالِي وَأَيْن ذَاكَ السَّمِيرُ",16,"ر",1,0],["أَيْنَ تِلْك الْعِيْنُ هَلْ حَالَتْ إِلى","جِنَّةٍ وَارْتدَّ بَرْدُ المَاءِ سَعْرَا",17,"ر",2,0],["أَينَ تبّاعُ تُبَّعٍ","أَينَ فُرسانُ فارِسِ",18,"س",1,1],["أَينَ تَرتيلهُ الكِتابَ وَمَغدا","هُ إِلَيهِ بِعَزمَةٍ لا بِعَجزِ",19,"ز",1,0],["أَينَ تَرقيقهُ وَتَفخيمُهُ الرا","ءَ وَتَحقيقهُ لِمَدٍّ وَهَمزِ",19,"ز",1,0],["أين تلكَ الهِبَاتُ للعِلْمِ تُزْجَى","كلُّ رِفْدٍ فيها يُزَاحِمُ رِفْدا",20,"د",2,0],["أين تصفيقُه وأين مجالي","ه وأين الرخيمُ من ألحانه",21,"ن",2,0],["أَيْنَ تِلْك الأَيّام بَانَتْ وبنّا","وَتَوَلَّتْ بَشَاشَةُ الأَحْباب",22,"ب",1,0],["أين تمضي ؟ والقضا مرتقب","ومتاح والرجا غير متاح",23,"ح",1,0],["أين تمضي ؟ وإلى أين بنا","جدّت الظلما فدع حمق المزاح",23,"ح",1,0],["أينتقر الأخيار مثنى وموحداً","ويبقى لأشرار العباد محيد",24,"د",1,0],["أين تلك العهود وافقن آمالي","وأخلفن بعد ذاك الظنونا",25,"ن",2,1],["أين تبغى قد زحَمتَ الثريّا","في مَداها وانتعلتَ النَّشاصا",26,"ص",2,0],["أَينَ تِلكَ الأَملاكُ زادوا عَلى الخَل","قِ وَزانوا الأَحسابَ وَالأَنسابا",27,"ب",2,0],["أَينَ تِلكَ الزُهورُ يَنفَرِطُ الصَب","حُ عَلَيها بِاللُؤلُؤِ المَنشورِ",28,"ر",1,0],["أَيَنتَهي الحُبُّ كما تَنتَهين","يا شَمعَتي يا مَثَل العاشِقين",29,"ن",1,0],["أين تلك الحلوم والفضل والأَلْ","باب بل أين ذلك التدبير",30,"ر",1,0],["أين تلك الجيوشُ والعزةُ القَعْ","ساءُ والجمعُ والعديدُ الكثير",30,"ر",1,0],["أين تلك البشاشةُ الغضَّةُ الطلْ","قةُ والنظَرُ البهِيُّ المنير",30,"ر",1,0],["أَينَ تَهوي قَدَمي عَن ذي الهَوى","وَاِبتِغائي حَولاً عَنهُ مُحالُ",31,"ل",1,1],["أَينَ تِلكَ الرُسومُ أَينَ تُراها","تَبِعَت في الرحيلِ إثرَ الركب",32,"ب",1,0],["أينَ تَصُون الأسْرَارَ فيكَ إذَا","تَحكَّمَ الوجدُ فيك والحُرَقُ",33,"ق",1,0],["اين تلك التي ائتمنت على الكن","ز لتبني لك الذي عشت أبني",34,"ن",2,0],["أين تريد يا مثيرَ الظُّعُنِ","أوطنٌ من رامةٍ بوطنِ",35,"ن",1,1],["أين تريد عن حياض حاجر","أن تستجيز الخضمَ والتلسُّسا",36,"س",2,0],["أَيَنتَهي مَنْ طَبعُه مَدحُهُ","وَمَدحُهُ يَدعو إِلَيهِ الهَوى",37,"و",2,0],["أين ترتيب ولاة سلفت","طيب الله ثراها ورحم",38,"م",1,0],["أين تلك العهودُ يا غدَّارة","والكلامُ الرقيقُ تحت المنارهْ",39,"ر",2,1],["أَين تَغدو أَين تَبدو أَين تَعدو أَين","أَنتَ سُكري أَنت بَدري أَنتَ نور العَين",40,"ن",1,0],["أين تلك الذرى أما زال فيها","مهبط للنسور والآساد",41,"د",1,0],["أَينَ تِلكَ الآرامُ مِن فِتيَةِ الآ","رِ وَهَل حالَ عَهدُها عَن حالِه",42,"ل",2,0],["أين تلك القوى أأنهكها الدهر","فظلت فريسة الأطماع",43,"ع",1,0],["أين تلك الرياض فوق السقوف","لك زابوم دانيات القطوف",44,"ف",1,0],["أين تنوي عن دارة حتم الله","علمها إن لم تبارح فناها",45,"ا",3,0],["أَينَ تلك القباب منها اللَواتي","عهدت للنفوس فيها ظلا ظَليلا",46,"ل",2,0],["أين تلك الأخلاق أذكى من ال","روض إذا مرّ عاطر النفحات",47,"ت",1,0],["أينتحيه الردى ولا قضب","تنضى ولا ذبل فَتَعْتَقِل",48,"ل",1,0],["أين تلك القباب دون دُماها","آسلات تسيل منها الدماء",49,"ا",2,0],["أين ترمي بك المنى والغنى نح","وك حيث السَّنّى والسَّنَاء",49,"ا",2,0],["أينتصف المصري حكماً شهوده","خصوم وقاضيه عدو له وتر",50,"ر",1,0],["أينتف عثنون الشريحي في الهوا","لعمركما أم صوف لحييه يندف",51,"ف",1,0],["أين تلك الخيام حولك إن عر","ست والأسد حول تلك الخيام",52,"م",1,0],["أين تلك السماء باهرة الأ","لاء تعشى شواخص الأبصار",53,"ر",1,0],["أين تبغين أيَّ ظمئانَ في","الارض وأيَّ ملوّحٍ في العبابِ",54,"ب",1,0],["أينَ تُرسي وأين دِرعي الحقيني","أمَّ عمروٍ بِصارمي البتّارِ",55,"ر",1,0],["أين تلك الغصون تحنو عليها","أين أثمارها دواني القطوف",56,"ف",1,0],["أين تلك الأخلاقُ أين مضى","كل شيء يدعُونه روحا",57,"ح",2,0],["أين تضرب بنا لعداة تجدنا","نصرف العيس نحوها للتلاقي",58,"ي",1,1],["أين تلك الآداب واللطف والظر","ف وأين التهذيب والتدقيق",59,"ق",1,0],["أينتظرون الحاكم اليوم بعدما","تبين فيما يزعمون محاله",60,"ل",2,0],["أَين تلكَ الاخلاقُ كالماءِ في الرقْ","قَةِ أَو كالنسيمِ أَو م