{"poems":[[53,"مذ صرت همي في النوم واليقظه","https://www.aldiwan.net/poem65036.html","المنسرح"],[147,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[369,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[422,"متى لاح رسم الدار من طلل قفر","https://www.aldiwan.net/poem54144.html","الطويل"],[469,"لقد لج دمعي ليلة السفح بالسفح","https://www.aldiwan.net/poem3581.html","عموديه"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105460","الكامل"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143130","الكامل"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29577","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[556,"","https://poetry.dctabudhabi.ae/diwan/poem/37232","المجتث"],[1976,"","https://poetry.dctabudhabi.ae/diwan/poem/198505","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48261","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53169","الرجز"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21491","المتقارب"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94177","المتقارب"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101392","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72853","الكامل"],[4869,"الاردن","https://www.poetsgate.com/ViewPoem.aspx?id=151652",""],[5370,"الناس","https://www.poetsgate.com/ViewPoem.aspx?id=87408",""],[5608,"فرحانه","https://www.poetsgate.com/ViewPoem.aspx?id=33052",""],[5956,"حُسن المعاملة","https://www.poetsgate.com/ViewPoem.aspx?id=192546",""],[6048,"عبيرُ الروح","https://www.poetsgate.com/ViewPoem.aspx?id=197759",""]],"verses":[["بعطايا موفَّراتٍ هي الإرْ","واء بعد الإشباع لا التلميظُ",0,"ظ",1,0],["بِعطايا تَترى مِئينَ وَآلا","فاً وَتُلفى فيمَن تَرى أَفرادا",1,"د",2,0],["بعِطْفِه عنه زَوَر","حتّى إذا الحادي نَعر",2,"ر",1,0],["بعطّر أرجاء القوافي ثناؤه","وربَّ ثناءٍ كانَ أذكى من العطر",3,"ر",1,0],["بعطفٍ وردفٍ يفضح الغصنَ في النقا","ووجهٍ وفرعٍ يخجل البدر في الجنح",4,"ح",1,0],["بعطائه وسخائه ورجائه","طرف الذي يرجو نداه قرير",5,"ر",1,0],["بعطوِّد الظنبوب محبوك القرا","بين القصير سراته والسمحج",6,"ج",1,0],["بِعطفٍ عَلى وُدِّ العَشيرَةِ صادِقٍ","وَرَفضِ عِداها لا محالٌ وَلا كذبُ",7,"ب",1,0],["بعطف لا إله إلا اللّه","وعطف أسمائك عجل المدد",8,"د",1,0],["بعطيك جزءاً ويأبى","شُحّاً فيأخذ كُلّا",9,"ل",2,0],["بعطفة ذي المجدين أرجو من الردى","خلاصي ولو أُلقيت في شدق أرقم",10,"م",1,0],["بعطْفِكِ عطفاً قد سألْتُكِ زَوْرَةً","كلَيْلَتِنا بالجِزْعِ والدهرُ مُقْبلُ",11,"ل",1,0],["بعطفه وطرفه","إن طعن القلب نهل",12,"ل",1,0],["بِعطفين من عَوهَجٍ عَينُها","إِلى الفرعِ والخَصَلات العُلا",13,"ا",1,0],["بعطر شذاك العلى أصبحت","تمسك والطيب قد يشهد",14,"د",1,0],["بِعِطفِ عَامِلٍ مُزَالٍ قَد بَقِى","مَعمُولُهُ دَفعاً لِوَهمٍ اتُّقِى",15,"ق",2,0],["بعطف تعطف الخرصان عنه","وطرف ردَّ قاطعة الصفاح",16,"ح",1,0],["بعطاردٍ مع زهرةٍ مع شمسِها","قمرُ السعودِ مقارناً يا مشتري",17,"ر",2,0],["بعطيكوا علمٍ مالفاه اي تهميش","الاردني هو والسعودي مخاشير",18,"ر",1,0],["بعطي واسامح للبشر واحسن مع الكل الصنيع","حتى إذا جار الزمن ألقى صديق انادمه",19,"م",2,0],["بعطيك انا يومين . . والثالث اقصاه","ان ما رجعتيلي بقزاز اخذي اشنبي",20,"ب",2,0],["بعطفِ الوالد المُضْفي","على الأبناءِ إيناسا..",21,"س",2,0],["بعطر من الياسمين الطريِّ","تفوح دروبي ولا تحفلُ",22,"ل",1,0]]}