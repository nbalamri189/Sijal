{"poems":[[99,"وطنٌ دعا وفتى أجاب","https://www.aldiwan.net/poem24756.html","مجزوء الكامل"],[71,"لام ولو أنصف ما كان لام","https://www.aldiwan.net/poem28373.html","السريع"],[77,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[108,"بطل الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179585",""],[164,"هذا التأني وهذا الحلم قد فعلا","https://www.aldiwan.net/poem58892.html","البسيط"],[466,"الله جار الوزير الصدر ما طلعت","https://www.aldiwan.net/poem16429.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48764","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48672","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55978","الكامل"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216641",""],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124725","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27333","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106892","البسيط"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70320","الخفيف"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83237","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65975","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58362","السريع"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46018","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91770","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135378","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125805","الكامل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113833","الكامل"],[4778,"العمر ينقص","https://www.poetsgate.com/ViewPoem.aspx?id=202926",""],[4858,"أبكي المروءة","https://www.poetsgate.com/ViewPoem.aspx?id=33887",""],[5377,"شعب متربص","https://www.poetsgate.com/ViewPoem.aspx?id=61901",""],[5861,"نسيج آلامي","https://www.poetsgate.com/ViewPoem.aspx?id=188577",""],[6147,"سوريا..لاءاتنا الحُمْر","https://www.poetsgate.com/ViewPoem.aspx?id=151697",""]],"verses":[["والعهد في القلب المصا","بر والأمانة في الرقاب",0,"ب",1,0],["والعهدُ باقٍ ودعاني لكمْ","وافٍ وودي دائمٌ والسلامْ",1,"م",1,0],["والعَهْدُ من لَمْياءَ إذ لا قومُهَا","خُزْرٌ ولا الحَرْبُ الزَّبونُ زَبون",2,"ن",1,0],["والعهْدُ بالثَّوْرَاتِ ناضحةً دمًا","يحمرُّ وجه الأرض من سيَّالِهِ",3,"ل",2,0],["والعهد وافاك لم تسبقه اخوته","عليك بعد اشتياق قطّع الشَكِلا",4,"ل",2,0],["والعَهْدُ والوِدُّ منهُ لا يُحيِلُهُما","على التَّقادُمِ لا غَدْرٌ ولا مَلَلُ",5,"ل",1,0],["والعهد ليس على اللسان سجلُّه","لكنه ما تحتويه الأضلع",6,"ع",1,0],["والعهد بالبلد الأمين إذا نبا","بلد بقوم أن يكون مآلا",7,"ل",2,0],["والعهد مني فيك إنك خير مَنْ","بين الخلايق زانه التهذيبُ",8,"ب",1,0],["والعهد باقي والولا يتجدّد","لِوْلاة الأمر البيعه الحصريّه",9,"ي",2,0],["والعهد بالله مهما كان من عددٍ","في كلّ عهدٍ يمين يا أخا ثعل",10,"ل",1,0],["والعهدُ ما بيننا أنْ لا تبوح بها","ولا تعرّفُها شخصاً من البَشَر",11,"ر",1,0],["والعهد ما بين قلبي واللحاظَ على","إن لا تخلي به شيئاً من الرمق",12,"ق",1,0],["والعهودَ التي عهدتُ إِليهم","بُدِّلَت منهمُ مَلالاً وغَدْرَا",13,"ر",2,0],["وَالعَهدُ أَن تَرقُبَ الدَيّانَ في عَمَلٍ","حَتّى يُتَوَّجَ مَسعاكُم بِما التَأَما",14,"م",2,0],["والعهد ما من أهله من لم يكن","جلداً إذا حل البلاء الأهول",15,"ل",1,0],["والعهدُ يا عَينيَّ قد غَمّني","صَفْعُكَ للشّيخ وما تابا",16,"ب",2,0],["وَالعهد بينهم لا يُلفى منصرما","فالصدق في الغار وَالصديق لَم يرما",17,"م",2,0],["وَالعَهد في سَفحِ الجوارِ غَداةَ لَم","تَتَهَيَّبي الرَّقباءَ وَالعذالا",18,"ل",2,0],["وَالعهنُ أَصبح بِالحَريق محذِّرَ ال","ياقوت وهيَ بليةٌ عَمياء",19,"ا",2,0],["والعهدُ مَن قد وفى به له عظما","أجرٌ ويؤتاه بارتفاع مرتفعِ",20,"ع",1,0],["والعهد بايعنا عليه وليه","نعم الولي له ونعم الُمولي",21,"ل",2,0],["والعهد هذا عهد تاريخ به","للعرب نصر فيه موت الحُسّد",22,"د",1,0],["والعهد ما عاد مسؤلا بلا حُرم","عند الكثير وجل الناس يطويه",23,"ي",2,0],["والعهدُ منشؤُه في قلب روضتِها","ترويه من غيثِها صفواً غواديها",24,"ي",3,0],["والعهود اللاتي يكررها الطاغي","كأبائه ليشري عبيده",25,"د",2,0],["والعهدُ منك لإسمي سوفَ تكتبُهُ","خطّاً لتشهد ما خطّتْهُ أقلامُ",26,"م",1,0],["والعُهرُ في عُرْفها بالخزْي مفتتِنٌ","في باحَة الرقصِ.. لِلتّقبيل تُبّانُها",27,"ن",3,0]]}