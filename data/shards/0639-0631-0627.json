9779",""],[5431,"حلّوا عن بلادي...","https://www.poetsgate.com/ViewPoem.aspx?id=207644",""],[5431,"ارفق بقلبه .....","https://www.poetsgate.com/ViewPoem.aspx?id=210357",""],[5431,"كذلك أعثرنا عليهم ليعلموا ...(الحسين)","https://www.poetsgate.com/ViewPoem.aspx?id=215785",""],[5449,"هنا القدس","https://www.poetsgate.com/ViewPoem.aspx?id=189162",""],[5452,"منتظر الزايدي","https://www.poetsgate.com/ViewPoem.aspx?id=119180",""],[5545,"فراتيّ المواطن","https://www.poetsgate.com/ViewPoem.aspx?id=184748",""],[5545,"أهواكَ مُلهَمةً","https://www.poetsgate.com/ViewPoem.aspx?id=185001",""],[470,"حشودٌ من الحب والكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=194105",""],[5582,"بِنَفْسِي هَوَىً بِالظَّاعِنِينَ كَوانِسا","https://www.poetsgate.com/ViewPoem.aspx?id=187157",""],[5595,"نعلّمُ جيلنا الكتبا","https://www.poetsgate.com/ViewPoem.aspx?id=158559",""],[5672,"عراقية...","https://www.poetsgate.com/ViewPoem.aspx?id=206513",""],[5725,"رحيق الروح","https://www.poetsgate.com/ViewPoem.aspx?id=180108",""],[5725,"الا أيها الثائرون الصغار","https://www.poetsgate.com/ViewPoem.aspx?id=207899",""],[5781,"غاية بُغيتي..والأمل","https://www.poetsgate.com/ViewPoem.aspx?id=208931",""],[402,"عزيز غروب البكر في بكرة العمر","https://www.poetsgate.com/ViewPoem.aspx?id=35721",""],[402,"يا عائدا برعاية الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=36542",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5861,"عراق الصمود","https://www.poetsgate.com/ViewPoem.aspx?id=188049",""],[5861,"فخر الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=192342",""],[5939,"لصة الأفئدة","https://www.poetsgate.com/ViewPoem.aspx?id=195293",""],[5957,"عراقية النبض تهدي السلام","https://www.poetsgate.com/ViewPoem.aspx?id=177054",""],[5957,"عراقي الملامح","https://www.poetsgate.com/ViewPoem.aspx?id=177087",""],[6075,"الأميرة والفتى العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=213306",""],[6102,"حَبو","https://www.poetsgate.com/ViewPoem.aspx?id=182762",""],[6104,"أريج الصبايا","https://www.poetsgate.com/ViewPoem.aspx?id=25365",""],[6106,"بين نهرين : د . جهاد ، د . سمير","https://www.poetsgate.com/ViewPoem.aspx?id=6314",""],[6147,"حنين إلى الفار المخلوع","https://www.poetsgate.com/ViewPoem.aspx?id=151693",""],[6235,"تراتيل الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77691&r=&rc=6",""],[422,"بوادي الغضا للمالكية أرْبُعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22255&r=&rc=11",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""],[6314,"غزل أحمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88066&r=&rc=1",""],[5567,"لدمشق آيات الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82079&r=&rc=132",""],[572,"عَراني الزّمَانُ بأحداثِهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9201&r=&rc=58",""]],"verses":[["عُراعِرُ يَنزو القَلبُ عِندَ اِدِّكارِهِم","نِزاءَ الدَبى بِالأَمعَزِ المُتَوَقِّدِ",0,"د",1,0],["عَراعُرُ لا يَنطِقونَ الخَنا","وَلا يَحفَظونَّ الكَلامَ المُعيبا",1,"ب",2,0],["عِرابٌ كَما تنْصاعُ فُتْخٌ كَواسِرٌ","إذا اسْتَعْجَلوها منْ مَرابِطِها جَرْيا",2,"ي",2,0],["عَرائِسُ في حُلى الكاساتِ تُجْلى","مورّدَةَ التَّرائِبِ والخُدودِ",3,"د",1,0],["عِراضَ كُلِّ وَغرَةٍ صَيخودِ","وَدَلَج مُخرَوِّطِ العَمودِ",4,"د",1,0],["عِرابٌ إذا استنّت بشاو بلاغة","تُقصّرُ من دون اللحاق لها العُربُ",5,"ب",1,0],["عَرا بَعدَما جَفَّ الثَرى عَن نِقابِهِ","بِعَصماءَ تَدري كَيفَ تَمشي المَنائِحُ",6,"ح",1,0],["عَرانينُ أَبطالٌ لُيوثٌ أَعِزَّةٌ","يَضيقُ بِهِم ما بَينَ سَلعٍ وَفارِعِ",7,"ع",1,0],["عُرَامٌ زَعيمٌ بالهُدَى أوْ فَبِالرَّدَى","إذا ما اعْتَدَى قوْمٌ عن القصْد عُنَّدُ",8,"د",1,0],["عَرارَتَنا وَإِن كَثُروا وَعَزّوا","وَلا يَثنونَ أَيدِيَنا الطِوالا",9,"ل",2,0],["عِراقِيَّةٍ وَسطَها الغَضوَرُ","إِذا خِفنَ هَولَ بُطونِ البِلادِ",10,"د",1,0],["عراه سَقام قبل ستة أشهر","فعهدي به في الدارِ وهو عليل",11,"ل",1,0],["عرابي كيف أوفيك الملاما","جمعت على ملامتك الأناما",12,"م",2,1],["عرابي هل تركت لنا قبورا","يقول الطائفون بها سلاما",12,"م",2,0],["عَرابِدُ يُطرِقُ الجُلَساءُ مِنها","عَلَيَّ كَأَنَّها حَطَبُ الوُقودِ",13,"د",1,0],["عَراعِرُ قَومٍ يَسكُنُ الثَغرُ إِن مَشَوا","عَلى أَرضِهِ وَالثَغرُ جَمُّ اَلزَلازِلِ",14,"ل",1,0],["عَرابِدُهُ أَبَداً جَمَّةٌ","وَأَخلاقُهُ كَزَّةٌ مُظلِمَه",15,"م",2,0],["عُراةٌ في الجنائبِ لا تُبالي","أصُدَّ العارُ عنها أم عَراها",16,"ا",3,0],["عرائس أهملت ولا سيما","أحسنها صنعة وأرشقها",17,"ق",3,0],["عِراقيّةٍ لم يَذُبْ جِسمُها","هُزالاً ولم تَجْسُ فيما جَسا",18,"س",2,0],["عرائسَ ما اجتلاها الطَّرْفُ إلاّ","أباحَتْه السَّوالِفَ والخُدودا",19,"د",2,0],["عُراةً رُبَّما غابوا","وَكانوا طالَما حَضَروا",20,"ر",3,0],["عرائِسُ أَغوالٍ تَهادى وإِنها","لَتُهْدي إذا صَالت مِنَ المَوتِ ما تهدي",21,"د",2,0],["عِراقِيَّةٌ وَتَهامى الهَوى","يَغورُ بِمَكَّةَ أَو يُنجِدُ",22,"د",1,0],["عِراضُ المَطا قُبَّ البَطونِ كَأَنَّما","وَعى السِرَّ مِنهُنَّ الغَمامُ اللَوامِعُ",23,"ع",1,0],["عَراقيبُ ضَمَّ الذُلُّ وَاللُؤمُ بَينَهُم","كَما اِنضَمَّ شَخصُ الخارِئِ المُتَضائِلِ",24,"ل",1,0],["عِراضُ الخُدودِ كِرامُ الجُدودِ","يَمُدّونَ لِلمَجدِ باعاً طَويلا",25,"ل",2,0],["عِراقِيَّةٌ أَهدى لَكَ الشَوقُ ذِكرَها","وَأَنتَ عَلى ظَهرٍ شَآمُ المَوارِدِ",26,"د",1,0],["عَرانا حِفاظٌ وَالحِفاظُ مَهالِكٌ","إِذا لَم يَكُن مِن وِردِهِ مُتَنَكَّبُ",27,"ب",1,0],["عرائس الروض ماست","وَبلبل الروض غرد",28,"د",1,0],["عِراضَ الجاهِ تَجزَعُ كُلَّ وادٍ","مُكَرَّمَةً وَتَفتَحُ كُلَّ بابِ",29,"ب",1,0],["عرائسَ الشعر قد عاد الحبيبُ وفي","عينيه سهدٌ وتعذيبٌ وإِضناءُ",30,"ا",2,0],["عرائس الحسن لاتدعنَ الم","حبّ للهجر والقطيعَه",31,"ع",2,0],["عرائسُ أحلامِكَ المائلاتُ","وما أنا إلَّا مَلاكٌ صديقْ",32,"ق",1,0],["عَرَاكَ النِّيلُ مِنْ بَلَدٍ بَعِيدٍ","فَأَلْبِسْهُ الْكَرَامَةَ فَهْوَ عَارِي",33,"ي",1,0],["عَرَاهَا خَبَالٌ فهْيَ تَرْقُصُ تَرْحَةً","وَتَنْشُدُ أَصْوَاتَ السُّرُورِ وَلا تدْرِي",34,"ر",2,0],["عرائس من عيون الشعر سافرةٌ","حدا بها الرجز أو غنى بها الرمل",35,"ل",1,0],["عِرَاكٌ وأحقادٌ يشبّ أوَارها","جحيماً وكِبرٌ أجْوَفٌ وغَباءُ",36,"ا",2,0],["عرائس بالنشيد سابحة","تلأْلأت في جبينها درره",37,"ر",2,0],["عرابدُ عندَك أُرْمَى بها","بينَ صَبوحٍ دائمٍ واغتباق",38,"ق",1,0],["عرانا من الدنيا خداع مماكر","فنبرح في أنقاض ما هي تهدم",39,"م",1,0],["عراب كما تنصاع قتم كواسر","إذا استعجلوها من مرابطها العليا",40,"ي",2,0],["عرائبُ آداب حباني بحفظها","زماني وصرف الدهر نعم المؤدب",41,"ب",1,0],["عرائسٌ من بنات الفكر حاملةٌ","مِن حافظٍ أثَراً حُلواً كسِيماه",42,"ا",2,0],["عراه سكوت فاسترابت عداته","وما هو إلا شاعر كل خاطره",43,"ر",2,0],["عراقيبُ ضمَّ الذُّلُّ واللُّؤمُ بينهُمْ","كَمَا انْضَمَّ شَخْصُ الخارِىء ِ المُتَضَائِلِ",44,"ل",1,0],["عرائسُ أغنتها الحجولٌ عن الحلى","فلم تبغ خلخالاً ولا التمَسَت وقفا",45,"ف",2,0],["عرامس كلها من فوقها ذهبٌ","لكن ذا ذهبٌ في ثغره شنب",46,"ب",1,0],["عرامسٌ ذهبت بكل ما أربٍ","وكل ذي أرب قبلي له أربُ",46,"ب",1,0],["عرامس حسنت حُسناً لمن حملت","وصادت الأدبا فصادها الأدبُ",46,"ب",1,0],["عرامس حملت ميمون لو طلبت","مني الفداء لها لجاءها الطلب",46,"ب",1,0],["عَرَاني غَرَامٌ شَفني وَبرَاني","وغَادَرَ صَبرِى مُقبِلَ الدَّبَرَانِ",47,"ن",1,1],["عِراباً كَساها النَقعُ مِمّا يَحوكُهُ","جِلالاً وَقَد سَدَّتهُ عارِيَةً جُردا",48,"د",2,0],["عَراني زكامٌ فابتَلاني مُكْرها","بهجرِ بديعٍ في ملاحتِهِ فردِ",49,"د",1,1],["عَراعِرُ لَم تَحلل ديارَ اِبنِ مُنذِرٍ","فَتُلقى إِلى الأَعداءِ مِنها المَقالِدُ",50,"د",1,0],["عرايا في مَهَبِّ الزِّفْتِ نَشْقى","لقمعِ شُعوبنا نبني جُيوشا",51,"ش",2,0],["عرائسُ تَجْتَلى في زَوِّ روضٍ","لها منثوره مثل النُّثار",52,"ر",1,0],["عرائس البحر نادت","صبابتي فأجبت",53,"ت",1,0],["عراقيون في دارات ليلى","لهممن لطف أنفسهم ذنوب",54,"ب",1,0],["عَرائِسُ الدلبِ عَلى الشاطيءِ","يُذَوَّبُ النَومُ بِأَحداقِها",55,"ه",2,1],["عَرائِس الشِعر في برناس باكِيَةٌ","تضمُّ مِن حُزنِها صَخراً وَصُوّانا",56,"ن",2,0],["عَرائِسَ ما كُنتُ في نَظمِها","بِخابِطِ لَيلٍ وَلا مُحتَطِب",57,"ب",1,0],["عَرَانِي مِنَ الْوَجْدِ مَا قَدْ نَفَى","كَرايَ وَأَذْكى حَشايَ سَعِيرَا",58,"ر",2,0],["عرائسُ حسنٍ بالجمال تجلّتِ","بعقد لآلٍ بالكمال تحلّتِ",59,"ت",1,1],["عَرائس لا تَرضى بغيرك ناكِحا","لهن عَزيزات المهور مهوز",60,"ز",1,0],["عَرائس لا ينكحن غير مهذب","كَريم وَلا يعشقن من لم يخاطر