"أُحِبُّ حَدِيثَها","https://www.poetsgate.com/ViewPoem.aspx?id=179990",""],[5667,"أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=214869",""],[5717,"فالقول بالعدل أساس يبتنى","https://www.poetsgate.com/ViewPoem.aspx?id=170603",""],[5770,"إلى صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178681",""],[5829,"أنا إن غفوت","https://www.poetsgate.com/ViewPoem.aspx?id=159199",""],[5848,"احباط","https://www.poetsgate.com/ViewPoem.aspx?id=48817",""],[5910,"تواضعتُ للرحمنِ فيما ينوبُني","https://www.poetsgate.com/ViewPoem.aspx?id=206522",""],[5937,"شبيهةُ صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=211806",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[6034,"الدهر لا يبرح خوانا","https://www.poetsgate.com/ViewPoem.aspx?id=169609",""],[6152,"جائحة كورونا","https://www.poetsgate.com/ViewPoem.aspx?id=213191",""],[6256,"بنغازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65923&r=&rc=11",""],[6300,"إلى مغرورة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82862&r=&rc=33",""],[6318,"رسالة المسجد الأَقصى إلى المسلمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66163&r=&rc=13",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""],[5190,"على بُعدِ شاطئين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85032&r=&rc=107",""]],"verses":[["وَكَم كَتَبتُ كِتاباً","يَبكي لَهُ مَن قَراهُ",0,"ا",2,0],["وكمْ كُرْبَةٍ جلّيْتَ داجٍ ظَلامُها","وَداعٍ لنَصْرِ اللهِ لمْ تولِهِ اللأّيا",1,"ي",2,0],["وكمْ كَذَبَتْ عنْدَ السُرَى عزَماتُهُ","كما أحْدَثَ الإنسانُ منْ بعْدِ ما نَوى",2,"و",2,0],["وكمْ كتَمْتُ وأسْرَرْتُ الهَوى زَمَناً","طَيَّ الجوانِحِ حتّى خانَني جلَدي",3,"د",2,0],["وَكَم كُنتَ تُشعِلُ فَحمَ الدُجى","بِأَنفاسِ صَبٍّ طَويلِ السَهَر",4,"ر",1,0],["وَكَم كُلِّفنَ دونَكَ مِن سُهوبٍ","تَكِلُّ بِهِ المُواشِكَةُ الوَخودُ",5,"د",1,0],["وَكَم كُلِّفنَ دونَكَ مِن سُهوبٍ","وَمِن لَيلٍ يُواصَلُ بِالنَهارِ",6,"ر",1,0],["وكم كسوةٍ لي في دمشقَ أفادها","وقد كانَ ظهري من أذى البردِ أعوجا",7,"ج",2,0],["وكم كنتُ نبَّهتُ من خاملٍ","وكم كنتُ حلَّيتُ من عاطل",8,"ل",1,0],["وَكَم كاشِحٍ غاوٍ أَرادَ بِها الأَذى","ثَنى طَرفَهُ عَنها وَفي نَفسِهِ الضُرُّ",9,"ر",1,0],["وكم كرب كشفت وعظم هول","بفعل منك لم يسبق بقول",10,"ل",1,0],["وَكَم كَسا الأَسواقَ مِن","حُسنٍ وَزانَ البَلَدا",11,"د",2,0],["وكم كرمٍ تنهلّ جدوى يمينه","لأيدي عفاةٍ من مُحِلّ ومحرمِ",12,"م",1,0],["وَكَم كانَ دَهراً لِلحَوادِثِ مُضغَةً","فَأَضحَت جَميعاً وَهيَ عَن لَحمِهِ دُردُ",13,"د",1,0],["وَكَم كُؤوسٍ مِنَ البَأساءِ دائِرَةٍ","عَلى نَديمٍ مِنَ الأَبطالِ مُغتَبِقِ",14,"ق",1,0],["وَكَم كُنّا بِها مِن فَرطِ عامٍ","وَهَذا الدَهرُ مُقتَبَلٌ حَسومُ",15,"م",1,0],["وَكَم كُرَبٍ أَخّاذَةٍ بِحُلوقِهِم","مُصَمِّمَةِ البَلوى كَشَفتُ وَجَلَّيتُ",16,"ت",1,0],["وكمْ كُرْبَةٍ كَشَّفْتُهَا بثَلاثَةٍ","من الصُّحبِ خَيفانٍ وماضٍ ولهذم",17,"م",1,0],["وَكَم كائِدٍ لِيَ مِن أَجلِكُم","وَما كانَ لي قَبلَكُم كائِدا",18,"د",2,0],["وَكَمْ كَرَّةٍ فِي الصُّحْفِ وَالسَّوْطُ مُرْهِقٌ","كَرَرْنَا وَمَا نَرْتَاضُ غَيْرَ صِعَابِ",19,"ب",1,0],["وَكَمْ كَسَاك البَهَاءُ ضَافِيَةً","مِنْ نُورِ شَمْسٍ لَهُ وَمِنْ بَدْرِ",20,"ر",1,0],["وكَمْ كتبَ التاريخُ لابن محمدٍ","خَوالِدَ والتاريخُ أصدَقُ كاتبِ",21,"ب",1,0],["وكم كرومٍ بها سوداءَ فاحمةٍ","سوادُها من سواد الأعين النُّجُل",22,"ل",1,0],["وكم كربة جليت داج ظلامها","وداع لنصر الله لم تره الأيا",23,"ي",2,0],["وكم كلب عقور طاش جهلا","وقد سمى الهدى الاسنى ضلالا",24,"ل",2,0],["وكم كربةٍ نجيّتني من غِمارها","وكانت شجا بين الحشا والتّرايب",25,"ب",1,0],["وكم كرم تزيد على الغوادي","غواديه ويزري بالسيول",26,"ل",1,0],["وكم كتاب وعوذة عقدا","عليه حلا بها قوى أوده",27,"د",2,0],["وكم كيس ذي حيلة ظل طائحا","وكم عاجز يوما تأتّى له الكسب",28,"ب",1,0],["وَكَم كانَ قبلَ اليومِ فينا منافقٌ","على غيِّهِ مِن خوفهِ أسبلَ السترا",29,"ر",2,0],["وَكَم كانَ حكّامُ الممالكِ قبلنا","فراعنةً جاروا على رُسلِهم جورا",30,"ر",2,0],["وكم كان منا ذَوو همةٍ","سمتْ بهم لمعالي الرُّتبْ",31,"ب",1,0],["وَكَمْ كُرْبَةٍ نادَيْتُ جُودَكَ عِنْدها","فَما رامنِي حَتّى تَفَرَّجَ ضِيقُها",32,"ق",3,0],["وكم كنت تشكين مرّ الفرا","ق وتذرينَ أدمعك الهاميه",33,"ي",2,0],["وَكَم كَتَمتُ وُلوعي خوف شُهرته","فَزادَ فيه اِشتهارا وَالهوى عبَرُ",34,"ر",1,0],["وَكَم كاشِحٍ قد راشَ لي سِهم كَيدِهِ","هناك فأَضحى لا يَريشُ ولا يَبري",35,"ر",2,0],["وكم كسب الاملاك في وجه ذى الدنا","ملوك بتسفير الرجال كانقلان",36,"ن",1,0],["وَكَمْ كُسِرَتْ أَسَاطِينٌ عليهِ","وَعِنْدَ النياك كَمْ هَانَتْ شَدائدْ",37,"د",1,0],["وَكَم كَرَّةٍ كَرَّت عَلَيَّ بُكورِها","تُرَدِّدُني في دَورَةِ بَعدِ دَورَةِ",38,"ه",1,0],["وَكَم كَربٍ ألمَّ بِليل خَطبٍ","فَكانَ عِلاج دُمّلهِ بِفَجرِ",39,"ر",1,0],["وَكَم كانَ لي قِدماً قَصيدٌ ومقصدٌ","أَقاما عَلى وَعدٍ بِكُفأَينِ لِلمَجدِ",40,"د",1,1],["وكم كسبت مالاً قريباً منالُه","عليها فما استَغنت فجادت فأغنَتِ",41,"ت",1,0],["وكم كانت بها اليونان تعلو","بحكمتها ارتقاءً واختيالا",42,"ل",2,0],["وكم كان بي فيهم أنيسٌ مفضلٌ","وآلاء فضل اللَه فوقي تسرج",43,"ج",1,0],["وَكَم كسبته جُرد الخَيلِ مَجداً","وَلَيسَ لَهُنَّ مِنهُ سِوى الكَلالِ",44,"ل",1,0],["وكم كبدٍ حرَّى يحرّقها الأَسى","تكادُ على ذكراك أنْ تتَفَطَّرا",45,"ر",2,0],["وكم كَشفا من كُرْبَةٍ بعدَ كُرْبَةٍ","تقولُ لَهَا النِّيرانُ كُفِّي أُوَارَكِ",46,"ك",1,0],["وكم كائدٍ حولي يُرتِّلَ حمدهُ","ويرفع من قدرى على كل قادر",47,"ر",1,0],["وكم كثَّروا من حاسديك وأشرجوا","صدورا على شحنائها وسَقامِها",48,"م",3,0],["وكم كتم الفرعُ الزيارةَ والدُّجى","فنمَّ عدواً طيفها الصبحُ والثغرُ",49,"ر",1,0],["وكم كان في آفل المُلَوِّح من فتى","منادَى مفدًّى حين تبلى سرائره",50,"ر",2,0],["وكم كان في آل الملوّح من فتى","يجيب خطيبا لا تُخاف عوائره",50,"ر",2,0],["وكم كنت توليني النصيحة عندها","لتفرغ من خيرات كنزك في يدي",51,"د",2,0],["وكم كنت أكسب سحرا حلال","وكم كنت أنشر فيها البنود",52,"د",1,0],["وكم كان في أفنائها متشوفا","لثروة ذي قلب بحبّه عالق",53,"ق",1,0],["وكم كفكفت منا الدموع غوادقا","كأنبنا الظوفان من حر هجرتي",54,"ت",2,0],["وكم كأسٍ أمر من المنايا","شربت فلم يضق عنها ذراعي",55,"ع",2,0],["وكم كنْتُ أَجفُوهُ وكان يُحبني","وأُغضبُه لكنَّه يَترضَّاني",56,"ن",2,0],["وكم كوى البين للآنام افئدةً","وكم به عيشهم بعد الصفا كدرا",57,"ر",2,0],["وَكَم كِتابٌ لَهُ غَيرَ النارِ غَداً","فَوقَ الكَتائِبِ في حَشدٍ وَتَكتيبِ",58,"ب",1,0],["وَكَم كَتبَةً أَعقَبَت نَكبَةً","وَكَم مِن كَلامٍ لِقَلبٍ كَلَم",59,"م",1,0],["وَكَم كَرَ بَينَ صُفوف العَدو","فَأَوقَع في القَوم ثُمَ اِنثَنى",60,"ا",1,0],["وَكَم كافِرٍ مُضمِرٍ كُفرَهُ","وَما كانَ يَكفُرُ حَتَّى فَسَق",61,"ق",1,0],["وكَم كليبٍ ورحّالٍ فما مًنيا","مِنَ الرِّجال بجسّاسٍ وبَرّاضٍ",62,"ض",1,0],["وَكَم كزمات أَتقنوا وَضع عقدها","لتحفظ وَجهاً قابلوه بِحدّة",63,"ه",1,0],["وَكَم كرنك مِنهُ البَنادق أَمطَرَت","سَحابَ رَصاصٍ فيهِ تَفريج أَزمة",63,"ه",1,0],["وَكَم كَتمت غرامي خَوف ذي عذل","فَباح دَمعي بأسراري الخفيّات",64,"ت",1,0],["وَكَم كانَ يَرجو سَلوَتي عَن مهفهف","بَنى بالسويدا مِن فُؤادي مَأواه",65,"ا",2,0],["وَكَم كربة فرّجت عَن خَير أَمّة","عَلى رَغم أَنف الجَهل وَهوَ خَصيم",66,"م",1,0],["وكم كبير أصارت صدرَه عَجُزاً","وكم طويلٍ أصارتْ رأسه قدما",67,"م",2,0],["وكمْ كانَ دربُ المنافي طويلاً","وكمْ كانَ بَالُ خطانا طويلا",68,"ل",2,0],["وَكَمْ كَتَمُوا فِي الْقَلْبِ سِرَّ مَحَبَّةٍ","وَكَمْ صَبَرًوا واكُرْهاً عَلى طُولِ غُرْبَةٍ",69,"ه",1,0],["وكم كشفت الخطب يوم الوغى","لما اغتدى ليلا بضرب الحسام",70,"م",1,0],["وكم كفى صائلا حد النصال وكم","أغنى فقيراً له في الأرض تجويل",71,"ل",1,0],["وكم كم سودت من أبيض","بقبح فعل ذمّة كل ذام",72,"م",1,0],["وكم كفى بالنفث من عاهة","وكم شفى بالتفل ضر السقام",72,"م",1,0],["وكم كف ضالا وجاد لمهطع","وخيب محتالا وأبرأ مسقما",73,"م",2,0],["وكم كم له من آية وعلامة","وباهر علم كان يبهتهم بهتا",74,"ت",2,0],["وكم كبير إذا أبصرت لحيته","تقول هذا دقيق الفكر والنظر",75,"ر",1,0],["وكم كابدت في سفري عناءً","وكم فيه دهتني من مصايبْ",76,"ب",1,0],["وكمْ كتائبَ رُعْتَ المارقين بها","فيهنَّ مِنْ أَلِفاتِ الحَظِّ آلافُ",77,"ف",1,0],["وكم كان في هذي النفوس منافس","فلم يبق في هذي النفوس مساوم",78,"م",1,0],["وكم كم قد أغات جناب ربي","وهون بالمكارم ما تقدر",79,"ر",1,0],["وكم كفت به أجناد سوء","عن الاسلام كم قبلت به جنات",80,"ت",1,0],["وكم كُربةٍ كانت وسيلة فَرحةٍ","وضُرٍّ تُرَى في حافَّتَيه المنافعُ",81,"ع",1,0],["وكم كشفنا بدور في جوانبها","من الضرورات عن أهل الضروروات",82,"ت",1,0],["وَكَم كَلِفَت مِصرٌ بِنَشرِ مَآثِرِي","وَقَامَت عَلَى سَاقٍ لِذِكرِيَ بَغدَانُ",83,"ن",1,0],["وكم كان مغوار لدى دار ندوة","له صوته بالحق يرفعه الجهرُ",84,"ر",1,0],["وَكَم كَلَّفَتنا مِن سُرى جَدِّ لَيلَةٍ","حَبيبٌ إِلى الساري المُجِدِّ اِنجِيابُها",85,"ب",3,0],["وَكَم كَتَمتُ هَواهُ عِندَ عاذِلَتي","وَصاحِبُ الدَمعِ لَم يَنفَعُهُ كِتمانُ",86,"ن",1,0],["وكم كذوب إذا أدّى روايته","ظننتها الحقّ من أسلوبه المرن",87,"ن",1,0],["وكم كم أجاشوا من جنودٍ وأوقدوا","اشانيب نيرانٍ سريع خمودها",88,"د",3,0],["وكم كفيت كفاح الاسد يوما وغى","وكم سبيت ملاح الربرب السهوي",89,"و",2,0],["وكم كُربةٍ ملءِ الجوانحِ والقَلبِ","طرَقتُ وقد نامَ المُواسُونَ من صَحبِي",90,"ي",1,0],["وكم كشفت عن الإسلام فادحة","أبدت لتفرس عن أنيابها العصل",91,"ل",1,0],["وكم كربٍ تولى إذ توالى","وكم خطبٍ تجلى حين جلا",92,"ل",2,0],["وكم كشفْت نِقَاباً تحت بُرْقُعِهِ","نورٌ يَشِعُّ وثوبُ الليل سَدَّالُ",93,"ل",1,0],["وكم كذَا رأَيتُ من جَنِيْبِ","جَعَلْتُ مَدْحي فيه مِن نَصِيْبِي",94,"ي",1,0],["وكم كذا أنواعُ مامونِيَّهْ","وكم بها صحن مهلبِيَّهْ",95,"ه",1,0],["وكم كمي بقاني البرد مشتمل","وكم أبي بماضي الحد يعتصب",96,"ب",1,0],["وكم كسرت كِسرى وفضّت جيوشه","فلم تحمِهِ منها كتائبُ رستُم",97,"م",1,0],["وكم كربة فرجتها كريهة","شددت لها أزري إلى أن تجلت",98,"ت",1,0],["وَكَم كُنتُ أَرجو لَو تُفدّى بِمَعشر","مِن الناس لا أَبقاهم اللَه مَعشَرا",99,"ر",2,0],["وكم كرمة ان لاح بارق راحها","تريك شموس البشر من كأسها تبدو",100,"د",2,0],["وكم كونفرس قد اقاموا ودون ما","يتوق اليه الكون قد وقف الصد",100,"د",1,0],["وكَم كابرُوا فيهِ جُحُوداً لِفَضلِهِ","فَلم يُرِهِم إلاّ سَرَارَ المَسَارِبِ",101,"ب",1,0],["وكم كانت الأشياخ أشياخنا الألى","إذا طلبوا نصراً أمدوا بأعوان",102,"ن",1,0],["وكم كنت أتلو الشعر لكن مقطّعاً","بصوت اتومبيلٍ اتاني به تعسي",103,"س",2,0],["وكم كان لفظ الجد يورثني أسىً","يخاطبني طفل به ويعيد",104,"د",1,0],["وكم كنت أبغي حفظها سافكاً دمي","وأرضى بصدع الروح خيفة صدعها",105,"ع",3,0],["وكم كسرت لي الأغلاط وزنا","كأني منه منكسر عليل",106,"ل",1,0],["وَكَم كِتاب إِذا ما فك طابعه","فل الكَتائب مِن بَدو وَمِن حَضَر",107,"ر",1,0],["وَكَم كماة غدوا جزراً لمرهفه","وَجحفل مثل موج أَليم قَد كسرا",108,"ر",2,0],["وكم كان يرثي لأخوانه","وهم يتخطون طرق الظلام",109,"م",1,0],["وكم كان يشكو أمور الرشاد","إلى زهرة السوء بين الطغام",109,"م",1,0],["وَكَم كانَ فيها مِن رَئيسٍ مُعَمَّمٍ","دَؤوبٍ لِصَدعِ الخُطَّةِ المُتَفاقِمِ",110,"م",1,0],["وكم كان للشمس المضيئة مطلعا","وأفق معال لا تغيب كواكبه",111,"ب",2,0],["وَكَمْ كَبِدٍ حَرَّى تُكَابِدُ مَا بِهَا","وَصَفْحَةِ خَدٍّ فِيْهِ للدَّمْعِ كَمْ خَدِّ",112,"د",1,0],["وكم كنت تلوي ذراع المحال","فينهار كالهالك المتداعي",113,"ع",2,0],["وكم كنت تضرب في الأرض حتى","تفيض بما تحت مليون قاعِ",113,"ع",1,0],["وكم كنت تفتح للكون قلباً","تشرّعه عن عظيم اقتناع",113,"ع",1,0],["وكم كبد فتّ النوى لمتيم","به وسقاه النأي سمَّ الأراقم",114,"م",1,0],["وَكَم كوز جرّعتنا الخطو","ب من بعد شربتنا الصافيَه",115,"ي",2,0],["وكم كابدت إذ ألقيت رحلاً","لديه من الهوان وطول ظلم",116,"م",1,0],["وكم كنت تحنو على الفقراء","حنو الرؤم على المرضع",117,"ع",1,0],["وكم كأس على الندماء دارت","على نغم تشق لها الجيوب",118,"ب",1,0],["وكم كلفت بحب الناس لي زمناً","فاليوم بغضُهُمُ من خير آمالي",119,"ل",2,0],["وكم كنت أستجلي ذكاءك ناظرا","إلى شهبٍ في مقلتيك وأنوار",120,"ر",1,0],["وكم كم لهن من متابعة","في فعلها وقولها كرابعة",121,"ه",1,0],["وكم كاعب حسفاء تكشف خدرها","فيسفر عن وجه تحت الجسم",122,"م",1,0],["وكم كاعب حسناء في الخلد نعمت","يزوجها من كان للأجر يكسب",123,"ب",1,0],["وكم كان يغضي والإساآت جمة","ويلتزم الصفح الجميل ويرفق",124,"ق",1,0],["وكم كافحوا الاخطار من اجل دولة","هم ابداً في الحادثات جنودها",125,"د",3,0],["وكَم كسَّرت جَيشاً لِكِسرى وقصّرت","يَدَي قيصرٍ تِلك القِنانُ الشَّناخيبُ",126,"ب",1,0],["وكم كاد زنث أخيل بما","به من خيار الجنود رمى",127,"م",2,0],["وكم كذاك تنشدين بالطرب","من عجب قد أصبح الورد عجب",128,"ب",1,0],["وَكَم كدر أَتى مِن بَعدِ صَفو","وَمد البَحر أَعقَبَهُ بِجَزرِ",129,"ر",1,0],["وكم كُرَبٍ في كربلاء تحكَّمَت","بقلبي فاضحكت مثل أنياب آسادِ",130,"د",1,0],["وكم كتم الاشواق عنه وسقمه","ودمعى همى قاض على حبه وشى",131,"ش",2,0],["وكم كُفيَ الإسلام سوءاً بملككم","كفيتمْ على رغم المعادينَ كلَّ سو",132,"س",2,0],["وَكَم كَبيرٍ خَطيرٍ كان ذا خَطَرٍ","لا يَتَّقي خطراً ما شطَّت الدارُ",133,"ر",1,0],["وَكَم كَريمٍ من الأَلماس في عدمٍ","تَسموهُ من حرَّةٍ دَهماء أحجارُ",133,"ر",1,0],["وكَم كَفانِيَ مِن دَهْرٍ جَوائِحَهُ","وَمُنْذُ أَلْزَمْتُ أَفكارِي مَدائِحَهُ",134,"ه",1,0],["وَكَم كَتبتُ مَقالاتٍ مُدَبَّجة","نشرتُها كُلّ نشرٍ في الخَليقاتِ",135,"ت",1,0],["وكم كروب أطلت وانجلت كرما","تفضلا من معاليه بلا سبب",136,"ب",1,0],["وكم كسرٍ جبرْتَ فكان طوقاً","على نحرِ الدعاء المستجاب",137,"ب",1,0],["وكم كلماتٍ لي بها كَلمُ ضدِّهم","مواضٍ معانيها وهنَّ المغامد",138,"د",1,0],["وكم كبدٍ لهم كالزجاج","بصمِّ صفا الرزء أمسى صديعا",139,"ع",2,0],["وَكَم كانَ صَدري لِلنِبالِ عَريضَةً","وَعِرضي لِسَهمِ الطاعِنينَ مَواقِعُ",140,"ع",1,0],["وَكَم كُنتُ أَيضاً لِلمُرادِ مُجَرّداً","مِنَ الغِمدِ سَيفاً بِالدِما وَهوَ ناشِعُ",140,"ع",1,0],["وكم كابدتُ شوقي فيكِ حتّى","ظللتُ الدرب من كثر اشْتياقي",141,"ي",1,1],["وكم كنت أشكو إليك احتراقي وأحسب قلبك قلبا كريما","فما كان منك سوى أن ملكت قيادي وكنت مَليكا ظلوما",142,"م",2,0],["وكم كان الطوَى يطوي نفوساً","على ما كان في أرض السواد",143,"د",1,0],["وكم كامل يزور عنه بنو الورى","وكم ناقص اضحى به الناس يحدق",144,"ق",1,0],["وكم كذبت رسل وقتلت","وسفه ما جاءت به الكتب والرسل",145,"ل",1,0],["وكم كشفت عنه الحوادث فجأةً","ونم مقالٌ تارةً وفعال",146,"ل",1,0],["وكم كستني من الإفضال أرديةً","كثيرة الوشي في لينٍ وتحبير",147,"ر",1,0],["وكَمْ كانتِ الألعابُ تُضْحكُ جَدَّتي","وكُنْتُ أُخَبّي لُعْبَتي عِندَها سِرّا",148,"ر",2,0],["وكم كتمت نفس الكريم إهانة","أباها الذي بين الحياصة والجل",149,"ل",1,0],["وكم كتمتُومن الأشواقِ ما افتضحتْ","عيناي، من لهفةٍ، يا حلوُ، أسرارا",150,"ر",2,0],["وكم كابرت دمع العين لكن","رميت بناعس طيفا أتاكا",151,"ك",2,0],["3 - وكم كنت أرجو منه يوم ملمتي","وفاء ويسقيني بكأس بها الشفى",152,"ف",2,0],["وَكَمْ كَذَبوا على اللهِ افْتِراءً","وفاقوا ألفَ شَيطانٍ رَجِيمِ",153,"م",1,0],["وكم كشفوا من شبهة وتصدروا","لحل عويص المشكلات البوادر",154,"ر",1,0],["وكَمْ كانَت تُشارِكُنِي اللَّيالِي","وحَرْفِي في الهَوَى كانَ الرَّسُولا",155,"ل",2,0],["وكم كانت الأرواحُ ترخص ُعندها","تهون فداءً حيث في بأسها سيْلُ",156,"ل",1,0],["وكم كتب علم حاز غامض سرها","وحطم في زحف الخميس كتائبا",157,"ب",2,0],["وكم كنتِ دوماً تبرين قلبي","فهل يتأتّى له أن يعُقا ؟",158,"ق",2,0],["وَ كَمْ كَتَبْنَا حُرُوفًا كُلُّهَا أَلَمٌ","وَ لَمْ تَجِدْ قَارِئًا مَا ضَمَّتِ الْكُتُبُ..",159,"ب",1,0],["وكَمْ كانَتْ لأَحْلامي رَبيعاً","وكَمْ نامَتْ عَلَى عَيْنِي رُؤَاها",160,"ا",3,0],["وكمْ كتبتُ قصيداً دونَهُ فمضى","وما استطابَ لسَمعٍ أَو رواهُ فَمُ",161,"م",1,0],["وكم كبير لا يحوم حوله ال","عقل ولا يزوره في حلم",162,"م",1,0],["وكم كان في صفنا من بليد ٍ","ويحمل في يومنا دكتوراه",163,"ا",2,0],["وكم كان فينا عظيم مهاب","وأضحى رفاتاً فصارت عظامْ",164,"م",1,0],["وكم كان رشدي على غيي يوديني","يوهمني إن الكثير من العطا سامي",165,"م",2,0],["وكم كربةٍ طافت عليَّ لقيتُها","بصدرٍ رحيبٍ غير أشأمَ ناكلِ",166,"ل",1,0],["وكم كنتُ للأشعار أنفقُ أحرُفي","وها أنا ذا في حُسنِها أتسوَّلُ",167,"ل",1,0],["وكم كفيفٍ حبيسِ البيتِ نابغةٍ","قد حققوا بعض أمجاد الفراهيدي..",168,"د",2,0],["وكم كمي وأخي نجدة","أردى وكم مزق أردانا",169,"ن",2,0],["وكم كشف الداء لؤم الأنام","وأظهر داء كورونا الكراما!؟",170,"م",2,1],["وكم كابدت من عتاب الصحاب","وقد هجرت فيكم الأقربين",171,"ن",1,0],["وكمْ كنتِ كالإحساس ِطاهرة َالهوى","فيا ليتَ ذاكَ الطهرُ فيكِ يَعودُ",172,"د",1,0],["وَكمْ كنْتُ أَرجو أن تكون دُموعُهمْ","دِماءً تُرَوّى مِن غِناها البَلاقِعُ",173,"ع",1,0],["وكَمْ كَان مِنْ رأي رشيدٍ بَذَلِتِه","فأطْلَقَه ُ قَلْبُ ذَكيُّ وخَاطِرُ",174,"ر",1,0],["وكَم كَانَ للأَقصَى نَصِيبٌ بِخَافِقِي","ويَا كَم ثَوَت فِي عُمقِ أَعمَاقِهِ مِصرُ",175,"ر",1,0]]}