{"poems":[[55,"يا من جعلت فداه","https://www.aldiwan.net/poem26039.html","المجتث"],[77,"وجودك حي الملك والدين والدنيا","https://www.aldiwan.net/poem35717.html","الطويل"],[77,"أبا جعفر إن الثقيل الذي ثوى","https://www.aldiwan.net/poem35835.html","الطويل"],[77,"قلبي وسمعي في شغل عن الفند","https://www.aldiwan.net/poem36613.html","البسيط"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[27,"عفا النسران بعدك والوحيد","https://www.aldiwan.net/poem5726.html","الوافر"],[27,"أهاج الشوق معرفة الديار","https://www.aldiwan.net/poem5744.html","الوافر"],[72,"حلفت بليل الشعر منه إذا سجى","https://www.aldiwan.net/poem18453.html","الطويل"],[51,"إذا كان صبري للعاجل","https://www.aldiwan.net/poem65905.html","الخفيف"],[91,"سلام عليها طفلة وفتية","https://www.aldiwan.net/poem8831.html","عموديه"],[85,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[85,"يا ملكا تعبدا","https://www.aldiwan.net/poem63720.html","مجزوء الرجز"],[80,"رمى الموت في عين التصبر بالدم","https://www.aldiwan.net/poem31279.html","الطويل"],[44,"تجرع أسى قد أقفر الجرع الفرد","https://www.aldiwan.net/poem30542.html","الطويل"],[74,"من موقف أفصحت بيض السيوف به","https://www.aldiwan.net/poem13190.html","البسيط"],[21,"جهنم تلك لا تبقي بغيا","https://www.aldiwan.net/poem36164.html","الوافر"],[52,"ألا عللاني قبل أن يأتي الموت","https://www.aldiwan.net/poem27217.html","الطويل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[50,"ألا قل لعبدة إن جئتها","https://www.aldiwan.net/poem63871.html","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54965","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54197","الطويل"],[106,"جمال طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179605",""],[77,"وجودك حيى الملك والدين والدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=34199",""],[113,"أقول لمطرب يحدو الجمالا","https://www.aldiwan.net/poem40618.html","عموديه"],[148,"عجبا لمن ترك الحقيقة جانبا","https://www.aldiwan.net/poem68457.html","الكامل"],[158,"بليت بكل أمعة جهول","https://www.aldiwan.net/poem59082.html","الوافر"],[184,"رأوه في حالة الجنون فما","https://www.aldiwan.net/poem43927.html","المنسرح"],[184,"رويدا أيا إسحاق واسمع فإنني","https://www.aldiwan.net/poem44118.html","الطويل"],[187,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[187,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[197,"تمايل دهرك حتى اضطرب","https://www.aldiwan.net/poem45666.html","المتقارب"],[278,"يد لك عندي لا تؤدى حقوقها","https://www.aldiwan.net/poem60779.html","الطويل"],[288,"أناشدك الله يا قاسيه","https://www.aldiwan.net/poem11684.html","المتقارب"],[295,"من مستهل دموعي يوم فرقته","https://www.aldiwan.net/poem33249.html","البسيط"],[295,"إذا ما امتطيت الفلك مقتحم البحر","https://www.aldiwan.net/poem33276.html","الطويل"],[302,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[346,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[347,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[351,"أدم خلع العذار بدون عذر","https://www.aldiwan.net/poem40232.html","الوافر"],[364,"وكم كان لي قدما قصيد ومقصد","https://www.aldiwan.net/poem17179.html","الطويل"],[369,"هو اليأس إلا من حديث مقوت","https://www.aldiwan.net/poem57517.html","الطويل"],[374,"حلول حال أفرقنا مجالا","https://www.aldiwan.net/poem59176.html","الوافر"],[374,"أحن إلى الوادي المقدس رغبة","https://www.aldiwan.net/poem66892.html","الطويل"],[403,"ألم بمضجعي بعد الكلال","https://www.aldiwan.net/poem50138.html","الوافر"],[413,"لفقدان عبد الواحد الدمع قد جرى","https://www.aldiwan.net/poem54022.html","الطويل"],[436,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[451,"أخي وجمال الشعر ما أنت ناثر","https://www.aldiwan.net/poem61748.html","الطويل"],[456,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[462,"تثنت من الأعطاف مخطفة سمر","https://www.aldiwan.net/poem3483.html","عموديه"],[472,"وإني لأقري الهم حين يضيفني","https://www.aldiwan.net/poem2167.html","الطويل"],[477,"بنورك يا مولاي لا زلت أهتدي","https://www.aldiwan.net/poem37046.html","الكامل"],[477,"رأيت الهلال ووجه الأمير","https://www.aldiwan.net/poem37056.html","المتقارب"],[477,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[480,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[511,"تمتع من حبيبك بالوداع","https://www.aldiwan.net/poem67725.html","الوافر"],[573,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"]],"verses":[["وَكَم كَتَبتُ كِتاباً","يَبكي لَهُ مَن قَراهُ",0,"ا",2,0],["وكمْ كُرْبَةٍ جلّيْتَ داجٍ ظَلامُها","وَداعٍ لنَصْرِ اللهِ لمْ تولِهِ اللأّيا",1,"ي",2,0],["وكمْ كَذَبَتْ عنْدَ السُرَى عزَماتُهُ","كما أحْدَثَ الإنسانُ منْ بعْدِ ما نَوى",2,"و",2,0],["وكمْ كتَمْتُ وأسْرَرْتُ الهَوى زَمَناً","طَيَّ الجوانِحِ حتّى خانَني جلَدي",3,"د",2,0],["وَكَم كُنتَ تُشعِلُ فَحمَ الدُجى","بِأَنفاسِ صَبٍّ طَويلِ السَهَر",4,"ر",1,0],["وَكَم كُلِّفنَ دونَكَ مِن سُهوبٍ","تَكِلُّ بِهِ المُواشِكَةُ الوَخودُ",5,"د",1,0],["وَكَم كُلِّفنَ دونَكَ مِن سُهوبٍ","وَمِن لَيلٍ يُواصَلُ بِالنَهارِ",6,"ر",1,0],["وكم كسوةٍ لي في دمشقَ أفادها","وقد كانَ ظهري من أذى البردِ أعوجا",7,"ج",2,0],["وكم كنتُ نبَّهتُ من خاملٍ","وكم كنتُ حلَّيتُ من عاطل",8,"ل",1,0],["وَكَم كاشِحٍ غاوٍ أَرادَ بِها الأَذى","ثَنى طَرفَهُ عَنها وَفي نَفسِهِ الضُرُّ",9,"ر",1,0],["وكم كرب كشفت وعظم هول","بفعل منك لم يسبق بقول",10,"ل",1,0],["وَكَم كَسا الأَسواقَ مِن","حُسنٍ وَزانَ البَلَدا",11,"د",2,0],["وكم كرمٍ تنهلّ جدوى يمينه","لأيدي عفاةٍ من مُحِلّ ومحرمِ",12,"م",1,0],["وَكَم كانَ دَهراً لِلحَوادِثِ مُضغَةً","فَأَضحَت جَميعاً وَهيَ عَن لَحمِهِ دُردُ",13,"د",1,0],["وَكَم كُؤوسٍ مِنَ البَأساءِ دائِرَةٍ","عَلى نَديمٍ مِنَ الأَبطالِ مُغتَبِقِ",14,"ق",1,0],["وَكَم كُنّا بِها مِن فَرطِ عامٍ","وَهَذا الدَهرُ مُقتَبَلٌ حَسومُ",15,"م",1,0],["وَكَم كُرَبٍ أَخّاذَةٍ بِحُلوقِهِم","مُصَمِّمَةِ البَلوى كَشَفتُ وَجَلَّيتُ",16,"ت",1,0],["وكمْ كُرْبَةٍ كَشَّفْتُهَا بثَلاثَةٍ","من الصُّحبِ خَيفانٍ وماضٍ ولهذم",17,"م",1,0],["وَكَم كائِدٍ لِيَ مِن أَجلِكُم","وَما كانَ لي قَبلَكُم كائِدا",18,"د",2,0],["وَكَمْ كَرَّةٍ فِي الصُّحْفِ وَالسَّوْطُ مُرْهِقٌ","كَرَرْنَا وَمَا نَرْتَاضُ غَيْرَ صِعَابِ",19,"ب",1,0],["وَكَمْ كَسَاك البَهَاءُ ضَافِيَةً","مِنْ نُورِ شَمْسٍ لَهُ وَمِنْ بَدْرِ",20,"ر",1,0],["وكَمْ كتبَ التاريخُ لابن محمدٍ","خَوالِدَ والتاريخُ أصدَقُ كاتبِ",21,"ب",1,0],["وكم كرومٍ بها سوداءَ فاحمةٍ","سوادُها من سواد الأعين النُّجُل",22,"ل",1,0],["وكم كربة جليت داج ظلامها","وداع لنصر الله لم تره الأيا",23,"ي",2,0],["وكم كلب عقور طاش جهلا","وقد سمى الهدى الاسنى ضلالا",24,"ل",2,0],["وكم كربةٍ نجيّتني من غِمارها","وكانت شجا بين الحشا والتّرايب",25,"ب",1,0],["وكم كرم تزيد على الغوادي","غواديه ويزري بالسيول",26,"ل",1,0],["وكم كتاب وعوذة عقدا","عليه حلا بها قوى أوده",27,"د",2,0],["وكم كيس ذي حيلة ظل طائحا","وكم عاجز يوما تأتّى له الكسب",28,"ب",1,0],["وَكَم كانَ قبلَ اليومِ فينا منافقٌ","على غيِّهِ مِن خوفهِ أسبلَ السترا",29,"ر",2,0],["وَكَم كانَ حكّامُ الممالكِ قبلنا","فراعنةً جاروا على رُسلِهم جورا",30,"ر",2,0],["وكم كان منا ذَوو همةٍ","سمتْ بهم لمعالي الرُّتبْ",31,"ب",1,0],["وَكَمْ كُرْبَةٍ نادَيْتُ جُودَكَ عِنْدها","فَما رامنِي حَتّى تَفَرَّجَ ضِيقُها",32,"ق",3,0],["وكم كنت تشكين مرّ الفرا","ق وتذرينَ أدمعك الهاميه",33,"ي",2,0],["وَكَم كَتَمتُ وُلوعي خوف شُهرته","فَزادَ فيه اِشتهارا وَالهوى عبَرُ",34,"ر",1,0],["وَكَم كاشِحٍ قد راشَ لي سِهم كَيدِهِ","هناك فأَضحى لا يَريشُ ولا يَبري",35,"ر",2,0],["وكم كسب الاملاك في وجه ذى الدنا","ملوك بتسفير الرجال كانقلان",36,"ن",1,0],["وَكَمْ كُسِرَتْ أَسَاطِينٌ عليهِ","وَعِنْدَ النياك كَمْ هَانَتْ شَدائدْ",37,"د",1,0],["وَكَم كَرَّةٍ كَرَّت عَلَيَّ بُكورِها","تُرَدِّدُني في دَورَةِ بَعدِ دَورَةِ",38,"ه",1,0],["وَكَم كَربٍ ألمَّ بِليل خَطبٍ","فَكانَ عِلاج دُمّلهِ بِفَجرِ",39,"ر",1,0],["وَكَم كانَ لي قِدماً قَصيدٌ ومقصدٌ","أَقاما عَلى وَعدٍ بِكُفأَينِ لِلمَجدِ",40,"د",1,1],["وكم كسبت مالاً قريباً منالُه","عليها فما استَغنت فجادت فأغنَتِ",41,"ت",1,0],["وكم كانت بها اليونان تعلو","بحكمتها ارتقاءً واختيالا",42,"ل",2,0],["وكم كان بي فيهم أنيسٌ مفضلٌ","وآلاء فضل اللَه فوقي تسرج",43,"ج",1,0],["وَكَم كسبته جُرد الخَيلِ مَجداً","وَلَيسَ لَهُنَّ مِنهُ سِوى الكَلالِ",44,"ل",1,0],["وكم كبدٍ حرَّى يحرّقها الأَسى","تكادُ على ذكراك أنْ تتَفَطَّرا",45,"ر",2,0],["وكم كَشفا من كُرْبَةٍ بعدَ كُرْبَةٍ","تقولُ لَهَا النِّيرانُ كُفِّي أُوَارَكِ",46,"ك",1,0],["وكم كائدٍ حولي يُرتِّلَ حمدهُ","ويرفع من قدرى على كل قادر",47,"ر",1,0],["وكم كثَّروا من حاسديك وأشرجوا","صدورا على شحنائها وسَقامِها",48,"م",3,0],["وكم كتم الفرعُ الزيارةَ والدُّجى","فنمَّ عدواً طيفها الصبحُ والثغرُ",49,"ر",1,0],["وكم كان في آفل المُلَوِّح من فتى","منادَى مفدًّى حين تبلى سرائره",50,"ر",2,0],["وكم كان في آل الملوّح من فتى","يجيب خطيبا لا تُخاف عوائره",50,"ر",2,0],["وكم كنت توليني النصيحة عندها","لتفرغ من خيرات كنزك في يدي",51,"ي",1,0],["وكم كنت أكسب سحرا حلال","وكم كنت أنشر فيها البنود",52,"د",1,0],["وكم كان في أفنائها متشوفا","لثروة ذي قلب بحبّه عالق",53,"ق",1,0],["وكم كفكفت منا الدموع غوادقا","كأنبنا الظوفان من حر هجرتي",54,"ت",2,0],["وكم كأسٍ أمر من المنايا","شربت فلم يضق عنها ذراعي",55,"ع",2,0],["وكم كنْتُ أَجفُوهُ وكان يُحبني","وأُغضبُه لكنَّه يَترضَّاني",56,"ي",1,0]]}