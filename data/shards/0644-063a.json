.html","الخفيف"],[458,"رعت بين حاجر والنعف شهرا","https://www.aldiwan.net/poem56188.html","المتقارب"],[458,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[461,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[461,"لمن الخيل كأمثال السعالي","https://www.aldiwan.net/poem15101.html","الرمل"],[461,"حي نجدا وأين من مرو نجد","https://www.aldiwan.net/poem15112.html","الخفيف"],[461,"كفي مقالك عن لومي وتفنيدي","https://www.aldiwan.net/poem15135.html","البسيط"],[464,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[464,"وجودك غادر النعمى معينا","https://www.aldiwan.net/poem3274.html","عموديه"],[465,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[468,"لغير طريف من طريفي وتالدي","https://www.aldiwan.net/poem60204.html","الطويل"],[468,"عطايا للندى منها شيات","https://www.aldiwan.net/poem60336.html","الوافر"],[468,"إذا رماك خليل","https://www.aldiwan.net/poem60533.html","المجتث"],[479,"حرستك عين عناية","https://www.aldiwan.net/poem37026.html","مجزوء الكامل"],[482,"تباعد عني الأصل والوطن الذي","https://www.aldiwan.net/poem24439.html","عموديه"],[500,"آمنت بالله الوجود كله","https://www.aldiwan.net/poem37823.html","الرجز"],[504,"سروري وذوقي من جمالك صادر","https://www.aldiwan.net/poem38406.html","الطويل"],[544,"غراب على شجرة الميلاد","https://www.aldiwan.net/poem67243.html","عموديه"],[551,"هي الدار موقوف عليك بكاها","https://www.aldiwan.net/poem47143.html","الطويل"],[551,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[551,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"],[551,"لغير الغواني ما تجن الأضالع","https://www.aldiwan.net/poem47726.html","الطويل"],[553,"بلاءك إني غير مستعب الرضى","https://www.aldiwan.net/poem68395.html","الطويل"]],"verses":[["لَغَدَت مُشَمِّرَةً تَقيكَ مِنَ الرَدى","عُصَبٌ تَجُرُّ قَنا الطِعانِ وَتَدَّعي",0,"ع",2,0],["لِغَيرِ تَقديرٍ ذَرَعنَ الأَرضا","حَتّى عَلِمنَ طولَها وَالعَرضا",1,"ض",2,1],["لِغَيري ضَوءُ نارِكُمُ وَعِندي","دَواخِنُها السَواطِعُ وَالأَوارُ",2,"ر",1,0],["لِغارَةٍ سامِعُ أَنبائِها","يَغَصَّ فيها بِالزَلالِ القَراح",3,"ح",1,0],["لِغَيرِ العُلى مِنّي القِلى وَالتَجَنُّبُ","وَلَولا العُلى ما كُنتُ في الحُبِّ أَرغَبُ",4,"ب",1,1],["لُغامُ المَطايا مِن رُضابِكَ أَعذَبُ","وَنَبتُ الفَيافي مِنكَ أَشهى وَأَطيَبُ",5,"ب",1,1],["لِغَيرِ العُلا مِنّي القِلى وَالتَجَنُّبِ","وَلَولا العُلا ما كُنتُ في العَيشِ أَرغَبُ",6,"ب",1,1],["لغَيْرِ جُفوني قُلْ إذا كُنْتَ قائِلاً","سَحابةُ صيْفٍ عنْ قَريبٍ تقَشّعُ",7,"ع",1,0],["لُغَةُ العُلومِ حَقائِقٌ","هِيَ عَن زَخارِفِنا عَواري",8,"ي",1,0],["لُغزٌ أَتاكَ بِهِ خَليلٌ صادِقٌ","في ودِّهِ بادٍ لِمَن يَتَأَمَّلُ",9,"ل",1,0],["لَغَشيتُ سَجفَكِ في مُلاءَةِ نَثرَةٍ","فُضُلٍ سِوى أَنَّ العِطافَ نِجادُ",10,"د",1,0],["لغَتُهَا فَصِيحَةٌ مُبِينَهْ","حِكْمَتُهَا وَاعِظَةٌ مَتِينَهْ",11,"ن",2,0],["لُغَةُ الضَّادِ لا تَضَنُّ عَلَيْكُمْ","إِنْ جَدَدْتُمْ بِكُلِّ مَا تَبْتَغُونَا",12,"ن",2,0],["لُغَةٌ تُرِيدُ تَضَافُراً مِنْ أَهْلِهَا","فِي حَينِ أَنَّ الْفَوْزَ لِلْمُتَقَحِّمِ",13,"م",1,0],["لغدوت تُنكِرني وتبرحِ قائلاً","بتعجب ما هذه الخَربات",14,"ت",1,0],["لغائبةٍ عني وفي القلب شخصها","كأنيَ من عيني لقلبي نقلتها",15,"ت",3,0],["لغرة الأفق بياضٌ شدَخ","جسمي به من قبل شهري انسلخ",16,"خ",1,1],["لغلمانِ مولانا عليّ مودَّةٌ","ينقصها بعض الأمور يسيرا",17,"ر",2,0],["لغيرك لا لكَ التفسيرُ أنَّى","يُفسَّرُ لابن بجدتها الغريبُ",18,"ب",1,1],["لِغفلةِ المرءِ وصْفٌ غير مُتَّفِقٍ","والذَّمُّ مُجتَنبٌ والحمد مُغْتَنَمُ",19,"م",1,0],["لُغَةُ الفولاذِ هاضَت لُغَتي","لا يَعيشُ الشَدوُ في دُنيا اِصطِخابِ",20,"ب",1,0],["لُغَةُ الفولاذِ هاضَت لُغَتي","لا يَعيشُ الشَدوُ في بَحرِ اِصطِخابِ",21,"ب",1,0],["لغه ليس يفهم العقل ما يسمع","منها وتفهم الارواح",22,"ح",1,0],["لُغَةُ الكامِلِ في اِستِرسالِهِ","وَاِبنُ خَلدونَ إِذا صَحَّ وَصابا",23,"ب",2,0],["لُغَةُ الذِكرِ لِسانُ المُجتَبى","كَيفَ تَعيا بِالمُنادينَ جَوابا",23,"ب",2,0],["لُغَةٌ مِنَ الإِغريقِ قَي","يِمَةٌ وَأُخرى مِن تَميمِ",24,"م",1,0],["لغادرت الثواكل معولاتٍ","بساحتنا وأطولت القتالا",25,"ل",2,0],["لَغِبتَ مَغيبَ البَدرِ عَنّا وَمَن يَبِت","بِلا قَمَرٍ يَذمُم سَوادَ الغَياهِبِ",26,"ب",1,0],["لُغَةٌ تَنفُرُ المَسامِعُ مِنها","حينَ تُروى وَتَشمَئِزُّ النُفوسُ",27,"س",1,0],["لِغِرَارَيْهِ على هاماتِهِم","مِن شِرارِ القَدحِ ما في الزنَدِ",28,"د",1,0],["لِغَزالٍ مِن بَني الأَص","فَرِ فيهِ جَبَروتُ",29,"ت",1,0],["لَغَدَوا وَذاكَ الحَولُ حَولُ عِبادَةٍ","فيهِم وَذاكَ الشَهرُ شَهرُ صِيامِ",30,"م",1,0],["لُغةٌ يُناجي اللهَ قَارِئُها","في فتحهِ وَيُحادثُ الرُّسُلا",31,"ل",2,0],["لغةُ السُّيوفِ تَحُلُّ كلَّ قضيّةٍ","فَدَعِ الكلامَ لجاهلٍ يتشدَّقُ",32,"ق",1,0],["لغيرِكَ سُقيا الماء وهو مُرَوَّقٌ","وغيرِك رفُّ الظلّ وهو مَديد",33,"د",1,0],["لَغَيَّرتُ وَجهي وَاشتَرَيتُ مَكانَهُ","لَعَلَّكِ أَن تَهوَي وِصالِيَ مِن بَعدِ",34,"د",1,0],["لِغَيثِ ثَلاثٍ لا يُفارِقُ ريبَةً","عَفَفنَ وَلا أَربو وَلَستُ بِمُبعَدِ",35,"د",1,0],["لَغَدَت عَلَيهِ مَنِيَّةٌ","وَلَماتَ أَو لاَزدادَ كَربُه",36,"ب",2,0],["لَغَيرُكَ بِالقُرطانِ أَولى مِنَ اِن يَرى","وَشَنَفانِ في الأُذُنَينِ مِنهُ وَقُرطانِ",37,"ن",1,0],["لَغَدَوا وَقَد مَلَأَ البَسيطَةَ بَعضُهُم","وَرَأَيتُ أَكثَرَهُم بِغَيرِ أَماكِنِ",38,"ن",1,0],["لِغَرِيبٍ قَامَ فِيهِم سائِلاً","وَلِجارٍ جُنُبٍ جاءَ فَحَل",39,"ل",1,0],["لغاضَ أَو لكادَ أَن يَغِيضا","ولاسْتَحى من بعدُ أَنْ يَفيضا",40,"ض",2,0],["لَغَدا سُكونُهُما حِجىً وَصِباهُما","حِلماً وَتِلكَ الأَريَحِيَّةُ نائِلا",41,"ل",2,0],["لُغَةٌ وُحِّدَتْ الألسنُ فيها واللغاتُ","نبعها القلب ومجراها الشفاه النضراتُ",42,"ت",1,0],["لغة قرَّ الشتيتُ الشملِ فيها وتواءَمْ","وبها الأعينُ في غير حديثٍ تتفاهمْ",42,"م",1,0],["لِغَدٍ صبرنا للزمانِ وفي غدٍ","نعفو ونغفرُ للزمانِ الجاني",43,"ن",2,0],["لغاسِلِ الكفّ من أعراضِها مئةً","وما يُجاوِزُ سبْعاً غاسِلُ النّجَسِ",44,"س",1,0],["لغَيري زَكاةٌ مِن جَمالٍ فإنْ تَكنْ","زَكاةُ جِمالٍ فاذكُري ابنَ سَبيل",45,"ل",1,0],["لُغَةَ الْفِرِنْسِيسِ الأُولَى","بَلَغُوا بِهَا حَدَّ التَّمَامِ",46,"م",1,0],["لَغَة الضَّادِ كيْفَ تَنسَى جَناهَا","مِن أَفانِينِ فِكرِكَ الخَلاَّقِ",47,"ق",1,0],["لِغَادَةٍ حَلَّتْ مَحَلاًّ سَمَا","مِنْ صِدْقِ إِعْجَابِي وَمِنْ وُدِّي",48,"ي",1,0],["لُغَةُ الضَّادِ أَنْبَتَتْ فِي بُحُورِ","الشِّعرِ دُرّاً حَيّاً بَدِيعَ البَرِيقِ",49,"ق",1,0],["لَغوى دَهرٌ رَماني","بِكَلامِ الناسِ لَغوا",50,"و",2,0],["لِغَريرَةٍ أَدنو وَتَبعُدُ في الهَوى","وَأَجودُ بِالوِدِّ المَصونِ وَتَبخَل",51,"ل",1,0],["لُغَةُ القُرْءَانِ تُزْهَى شَرَفاً","أنَّ حامي الدِّينِ وَالْمُلْكِ حَماها",52,"ا",3,0],["لغةُ الفنِّ أنتِ والسحْرِ والشِّعْرِ","ونُورُ الْحِجَا وَوَحْيُ الْجَنانِ",53,"ن",1,0],["لغة إذا قرَعَت بجندل لفظها","أذنَ السميع، شكت من الآلام",54,"م",1,0],["لغةُ المدافع وحدها","أسلوبُها في الحرب ساحر",55,"ر",1,0],["لغةُ الخصومِ من الرجوم حروفها","فلْيَقْرَءُوا منها الغداةَ فصولا",56,"ل",2,0],["لغةُ التفاهمُ عنده","قَصْفُ المدافع والرجومِ",57,"م",1,0],["لغّموا دربنا : ومدّوا دجانا","واطفئوا الشهب وانتظار الصباح",58,"ح",1,0],["لَغِبٌ فلا الإِمساءُ يُوسِعُهُ","عَطْفاً ، ولا الإِصباحُ يُنجِده",59,"د",2,0],["لغة الضاد في فم الملِك الفذِّ","تباهي بحسنِها الموصوف",60,"ف",1,0],["لغة العواطفِ جلَّ مَنْطِقُها","عن أن يُقاسَ بمنطقِ البشر",61,"ر",1,0],["لغسلتُ جَفْناً راح من ظمأٍ","مُتَلَهباً مُتَطايِرَ الشَّرر",61,"ر",1,0],["لُغَى حَسَّانَ لَم تَكُ لِلنَّبِيهِ","بِلاَئِقَةٍ ولَم تَكُ تَطَّبِيهِ",62,"ي",2,1],["لِغَيرِكَ عِندَ اِحتِيالِ الرِجالِ","يُدَبُّ الضَراءُ وَيُمشى الخَمَر",63,"ر",1,0],["لَغُرّوا بِالسَكينَةِ مِنكَ جَهلاً","وَرُبَّ سَكينَةٍ جَرَّت عُراما",64,"م",2,0],["لَغارُوا عَلى النَظمِ الجَميلِ وَلَم يَكُن","لَهُم في مَعاني لَفظِهِ مِن مُشارِكِ",65,"ك",1,0],["لَغَدَت وَالنَصرُ مُقارِنُها","تَستاقُ الشاءَ مَعَ النَعَمِ",66,"م",1,0],["لغنطوسَ الكَريمَ مَقَرُّ عَفوٍ","لَهُ الرحمنُ بِالرِّضوانِ عَمّا",67,"م",2,1],["لغُرّةِ وجهِك الميمون نورٌ","لعين الشمس تحتَ سَناهُ غَض",68,"ض",1,0],["لغربتي غربةُ النَّوى خُلِقتْ","فلا غرابٌ إلا بها يَنْعِقَ",69,"ق",1,0],["لغةُ النارِ والحديدِ هيَ الفُص","حى وحظّ الضعيفِ مِنها المنيّه",70,"ي",2,0],["لغيري الدهرُ سلمُ","وعندي الدهرُ حربُ",71,"ب",1,1],["لغيرك لم تقصد وما خاب في الورى","لجدواك من وافى ومن قصد البحرا",72,"ر",2,0],["لغرتها البيضاء طرفك لو رأى","وشامتها السوداء فيه مخلّقه",73,"ه",1,1],["لغيري يساق الدوح ذلّت غضونهُ","بما عبثت فيه جنوب وشمأل",74,"ل",1,0],["لغيري هدير الراح أطفأ نارها","مزاجٌ ببرد الماء يحبوه جدول",74,"ل",1,0],["لِغَيري تَدّعي الدُنيا سَراجاً","لَهُ مِنهُ الفَتيلُ وَلي الزُيوتُ",75,"ت",1,0],["لِغُلامِهِم في الروعِ عَزمَةُ شائِبٍ","وَلِكَهلِهِم فيهِ هُجومُ غُلامِ",76,"م",1,0],["لِغُرّتِه النواظِرُ سامِيات","كما شَاءَ السّنى وشَأى السّنَاء",77,"ا",2,0],["لَغَدَوْتَ تَقْتادُ الْمُنى بِزمامِها","وَتَرُوضُ سَهْلَ النِّيْلِ غَيْرِ حَرَونِهِ",78,"ن",2,0],["لَغاضَ لَهُ مَاءُ النَّدَى وَهْوَ سائِحٌ","وضاق بِهِ صَدْرُ الْعُلى وَهْوَ أَفيَحُ",79,"ح",1,0],["لِغَيرِكَ لا لَكَ التَفسيرُ يا مَن","يُعَلِّمُنا البَيانَ وَلا يُعَلَّم",80,"م",1,0],["لغوامض الكافي أبان فكان لي","بختامه طرب وصفق باليد",81,"د",1,0],["لغة الدمع واللحاظ لها أجلى","بيان يقوله الشعراء",82,"ا",2,0],["لِغَيري بَرقُكَ الخَلَّبُ","وَالمُنذِرُ بِالطَلِّ",83,"ل",1,1],["لغَيْرِكَ تَضْمَنُ الأموالُ غَيْري","ولكنّي بحُسْنِ الذَّكرِ ضامن",84,"ن",1,0],["لغادةٍ كمَهاةِ الرَّمْلِ ناظرةٍ","شِفارُ أسيافِها للفَتْكِ أَشفار",85,"ر",1,0],["لغيرِك الدّهرَ قَولي إن مَدحتُ أَصِخْ","وعند مَدحِك قَولي كلُّه اغتَفِر",86,"ر",1,0],["لغَيري رمَى بالطَّرف لكن أصابَني","ولا قَوَدٌ في الحُبِ ما لم يكنْ عَمدا",87,"د",2,0],["لَغادَرتِ بِالعَهدِ الغَوانِيَ أَن وَفَت","رِجالاً وَبِالغَدرِ الرِجالَ غَوانِيا",88,"ي",2,0],["لغاضَ عليها ذاتَ دلٍّ ومِيسمٍ","ووجهٍ كدينار العزيز المشوّفِ",89,"ف",1,0],["لغةُ الفجرِ ذاتُ معنىً صحيحٍ","ولسانٍ طَلْقٍ، ولفظٍ مبينِ",90,"ن",1,0],["لغةٌ تمنح القلوبَ صفاءً","ونقاءً في عصرنا المفتونِ",90,"ن",1,0],["لغة الفجر عذبة غير أنَّا","لم نُمَتَّعْ بلحنها منذ حين",90,"ن",1,0],["لَغدوْت فيه مُفرِّطاً لا مُفْرِطاً","ورجعتُ عنه مُعذِّراً لا مُعذِراً",91,"ر",2,0],["لَغو كَحَرف زيدَ لا مَعنى لَهُ","أَو واوُ عَمروٍ فقدها كَوجودِها",92,"د",3,0],["لَغيرُ مَلُومٍ في الحنينِ إليهمُ","ومَعذُورَةٌ أن تسْتَهِلَّ جُفُونُهُ",93,"ه",1,0],["لغزالةٍ مثلِ الغزالةِ منظراً","حوراءَ تسكنُ في هضابِ يَلمْلمِ",94,"م",1,0],["لغاوٍ سَلَّ سيفَ النَّكْثُ فِيهَا","كما نَعَبَ الغرابُ بيومِ بَيْن