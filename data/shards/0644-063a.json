{"poems":[[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[53,"لغير تقدير ذرعن الأرضا","https://www.aldiwan.net/poem30169.html","الرجز"],[53,"أما لو لم تعاقره العقار","https://www.aldiwan.net/poem30451.html","الوافر"],[53,"نبهتهم مثل عوالي الرماح","https://www.aldiwan.net/poem30651.html","السريع"],[53,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[53,"لغام المطايا من رضابك أعذب","https://www.aldiwan.net/poem30757.html","الطويل"],[3,"لغير العلا مني القلى والتجنب","https://www.aldiwan.net/poem127.html",""],[77,"نووا سفرا عني الغداة وأزمعوا","https://www.aldiwan.net/poem35980.html","الطويل"],[86,"يا كاسي الأخلاق في","https://www.aldiwan.net/poem68899.html","مجزوء الكامل"],[71,"ما اسم حرام للنساء فعاله","https://www.aldiwan.net/poem3884.html","الكامل"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[93,"وحبك يا سيدتي أمينه","https://www.aldiwan.net/poem11115.html","الرجز"],[93,"يفسح الراحلون للقادمينا","https://www.aldiwan.net/poem11170.html","الخفيف"],[93,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[88,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[72,"أقيما فروض الحزن فالوقت وقتها","https://www.aldiwan.net/poem18388.html","الطويل"],[72,"لغرة الأفق بياض شدخ","https://www.aldiwan.net/poem18533.html","السريع"],[72,"تهن به عيدا أجل كبيرا","https://www.aldiwan.net/poem18730.html","الطويل"],[51,"لغيرك لا لك التفسير أنى","https://www.aldiwan.net/poem8330.html","الوافر"],[51,"أعنيك يا من سواه تلحق التهم","https://www.aldiwan.net/poem66299.html","البسيط"],[91,"جعت والخبز وفير في وطابي","https://www.aldiwan.net/poem8748.html","عموديه"],[91,"والسنا حولي وروحي في ضباب","https://www.aldiwan.net/poem8749.html","عموديه"],[89,"هزنا الفن في كمنجة سامي","https://www.aldiwan.net/poem44773.html","الخفيف"],[85,"أنا من بدل بالكتب الصحابا","https://www.aldiwan.net/poem63724.html","الكامل"],[85,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[43,"أرى الشطرنج لو كانت رجالا","https://www.aldiwan.net/poem10610.html","الوافر"],[45,"محمد ما آمالنا بكواذب","https://www.aldiwan.net/poem10648.html","الطويل"],[66,"إنما الحيزبون والدردبيس","https://www.aldiwan.net/poem38647.html","الخفيف"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[44,"أنا ميت ولئن مت","https://www.aldiwan.net/poem30273.html","مجزوء الرمل"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[105,"أعد الرجاء وجدد الأملا","https://www.aldiwan.net/poem42045.html","أحذ الكامل"],[105,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[75,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[48,"وقسرية أبصرتها فهويتها","https://www.aldiwan.net/poem62571.html","الطويل"],[50,"أشاقك مغنى منزل متأبد","https://www.aldiwan.net/poem63906.html","الطويل"],[50,"بلغ المرعث في الرحيل","https://www.aldiwan.net/poem64864.html","مجزوء الكامل"],[46,"مطيتي الوقت الذي ما امتطيته","https://www.aldiwan.net/poem23497.html","الطويل"],[46,"لو هب سكان التراب من الكرى","https://www.aldiwan.net/poem23531.html","الكامل"],[8,"لمن الدار كأنضاء الخلل","https://www.aldiwan.net/poem21814.html","الرمل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1312","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39544","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16620","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16657","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55049","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54773","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55062","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[106,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[106,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[106,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""]],"verses":[["لَغَدَت مُشَمِّرَةً تَقيكَ مِنَ الرَدى","عُصَبٌ تَجُرُّ قَنا الطِعانِ وَتَدَّعي",0,"ع",2,0],["لِغَيرِ تَقديرٍ ذَرَعنَ الأَرضا","حَتّى عَلِمنَ طولَها وَالعَرضا",1,"ض",2,1],["لِغَيري ضَوءُ نارِكُمُ وَعِندي","دَواخِنُها السَواطِعُ وَالأَوارُ",2,"ر",1,0],["لِغارَةٍ سامِعُ أَنبائِها","يَغَصَّ فيها بِالزَلالِ القَراح",3,"ح",1,0],["لِغَيرِ العُلى مِنّي القِلى وَالتَجَنُّبُ","وَلَولا العُلى ما كُنتُ في الحُبِّ أَرغَبُ",4,"ب",1,1],["لُغامُ المَطايا مِن رُضابِكَ أَعذَبُ","وَنَبتُ الفَيافي مِنكَ أَشهى وَأَطيَبُ",5,"ب",1,1],["لِغَيرِ العُلا مِنّي القِلى وَالتَجَنُّبِ","وَلَولا العُلا ما كُنتُ في العَيشِ أَرغَبُ",6,"ب",1,1],["لغَيْرِ جُفوني قُلْ إذا كُنْتَ قائِلاً","سَحابةُ صيْفٍ عنْ قَريبٍ تقَشّعُ",7,"ع",1,0],["لُغَةُ العُلومِ حَقائِقٌ","هِيَ عَن زَخارِفِنا عَواري",8,"ي",1,0],["لُغزٌ أَتاكَ بِهِ خَليلٌ صادِقٌ","في ودِّهِ بادٍ لِمَن يَتَأَمَّلُ",9,"ل",1,0],["لَغَشيتُ سَجفَكِ في مُلاءَةِ نَثرَةٍ","فُضُلٍ سِوى أَنَّ العِطافَ نِجادُ",10,"د",1,0],["لغَتُهَا فَصِيحَةٌ مُبِينَهْ","حِكْمَتُهَا وَاعِظَةٌ مَتِينَهْ",11,"ن",2,0],["لُغَةُ الضَّادِ لا تَضَنُّ عَلَيْكُمْ","إِنْ جَدَدْتُمْ بِكُلِّ مَا تَبْتَغُونَا",12,"ن",2,0],["لُغَةٌ تُرِيدُ تَضَافُراً مِنْ أَهْلِهَا","فِي حَينِ أَنَّ الْفَوْزَ لِلْمُتَقَحِّمِ",13,"م",1,0],["لغدوت تُنكِرني وتبرحِ قائلاً","بتعجب ما هذه الخَربات",14,"ت",1,0],["لغائبةٍ عني وفي القلب شخصها","كأنيَ من عيني لقلبي نقلتها",15,"ت",3,0],["لغرة الأفق بياضٌ شدَخ","جسمي به من قبل شهري انسلخ",16,"خ",1,1],["لغلمانِ مولانا عليّ مودَّةٌ","ينقصها بعض الأمور يسيرا",17,"ر",2,0],["لغيرك لا لكَ التفسيرُ أنَّى","يُفسَّرُ لابن بجدتها الغريبُ",18,"ب",1,1],["لِغفلةِ المرءِ وصْفٌ غير مُتَّفِقٍ","والذَّمُّ مُجتَنبٌ والحمد مُغْتَنَمُ",19,"م",1,0],["لُغَةُ الفولاذِ هاضَت لُغَتي","لا يَعيشُ الشَدوُ في دُنيا اِصطِخابِ",20,"ب",1,0],["لُغَةُ الفولاذِ هاضَت لُغَتي","لا يَعيشُ الشَدوُ في بَحرِ اِصطِخابِ",21,"ب",1,0],["لغه ليس يفهم العقل ما يسمع","منها وتفهم الارواح",22,"ح",1,0],["لُغَةُ الكامِلِ في اِستِرسالِهِ","وَاِبنُ خَلدونَ إِذا صَحَّ وَصابا",23,"ب",2,0],["لُغَةُ الذِكرِ لِسانُ المُجتَبى","كَيفَ تَعيا بِالمُنادينَ جَوابا",23,"ب",2,0],["لُغَةٌ مِنَ الإِغريقِ قَي","يِمَةٌ وَأُخرى مِن تَميمِ",24,"م",1,0],["لغادرت الثواكل معولاتٍ","بساحتنا وأطولت القتالا",25,"ل",2,0],["لَغِبتَ مَغيبَ البَدرِ عَنّا وَمَن يَبِت","بِلا قَمَرٍ يَذمُم سَوادَ الغَياهِبِ",26,"ب",1,0],["لُغَةٌ تَنفُرُ المَسامِعُ مِنها","حينَ تُروى وَتَشمَئِزُّ النُفوسُ",27,"س",1,0],["لِغِرَارَيْهِ على هاماتِهِم","مِن شِرارِ القَدحِ ما في الزنَدِ",28,"د",1,0],["لِغَزالٍ مِن بَني الأَص","فَرِ فيهِ جَبَروتُ",29,"ت",1,0],["لَغَدَوا وَذاكَ الحَولُ حَولُ عِبادَةٍ","فيهِم وَذاكَ الشَهرُ شَهرُ صِيامِ",30,"م",1,0],["لُغةٌ يُناجي اللهَ قَارِئُها","في فتحهِ وَيُحادثُ الرُّسُلا",31,"ل",2,0],["لغةُ السُّيوفِ تَحُلُّ كلَّ قضيّةٍ","فَدَعِ الكلامَ لجاهلٍ يتشدَّقُ",32,"ق",1,0],["لغيرِكَ سُقيا الماء وهو مُرَوَّقٌ","وغيرِك رفُّ الظلّ وهو مَديد",33,"د",1,0],["لَغَيَّرتُ وَجهي وَاشتَرَيتُ مَكانَهُ","لَعَلَّكِ أَن تَهوَي وِصالِيَ مِن بَعدِ",34,"د",1,0],["لِغَيثِ ثَلاثٍ لا يُفارِقُ ريبَةً","عَفَفنَ وَلا أَربو وَلَستُ بِمُبعَدِ",35,"د",1,0],["لَغَدَت عَلَيهِ مَنِيَّةٌ","وَلَماتَ أَو لاَزدادَ كَربُه",36,"ب",2,0],["لَغَيرُكَ بِالقُرطانِ أَولى مِنَ اِن يَرى","وَشَنَفانِ في الأُذُنَينِ مِنهُ وَقُرطانِ",37,"ن",1,0],["لَغَدَوا وَقَد مَلَأَ البَسيطَةَ بَعضُهُم","وَرَأَيتُ أَكثَرَهُم بِغَيرِ أَماكِنِ",38,"ن",1,0],["لِغَرِيبٍ قَامَ فِيهِم سائِلاً","وَلِجارٍ جُنُبٍ جاءَ فَحَل",39,"ل",1,0],["لغاضَ أَو لكادَ أَن يَغِيضا","ولاسْتَحى من بعدُ أَنْ يَفيضا",40,"ض",2,0],["لَغَدا سُكونُهُما حِجىً وَصِباهُما","حِلماً وَتِلكَ الأَريَحِيَّةُ نائِلا",41,"ل",2,0],["لُغَةٌ وُحِّدَتْ الألسنُ فيها واللغاتُ","نبعها القلب ومجراها الشفاه النضراتُ",42,"ت",1,0],["لغة قرَّ الشتيتُ الشملِ فيها وتواءَمْ","وبها الأعينُ في غير حديثٍ تتفاهمْ",42,"م",1,0],["لِغَدٍ صبرنا للزمانِ وفي غدٍ","نعفو ونغفرُ للزمانِ الجاني",43,"ن",2,0],["لغاسِلِ الكفّ من أعراضِها مئةً","وما يُجاوِزُ سبْعاً غاسِلُ النّجَسِ",44,"س",1,0],["لغَيري زَكاةٌ مِن جَمالٍ فإنْ تَكنْ","زَكاةُ جِمالٍ فاذكُري ابنَ سَبيل",45,"ل",1,0],["لُغَةَ الْفِرِنْسِيسِ الأُولَى","بَلَغُوا بِهَا حَدَّ التَّمَامِ",46,"م",1,0],["لَغَة الضَّادِ كيْفَ تَنسَى جَناهَا","مِن أَفانِينِ فِكرِكَ الخَلاَّقِ",47,"ق",1,0],["لِغَادَةٍ حَلَّتْ مَحَلاًّ سَمَا","مِنْ صِدْقِ إِعْجَابِي وَمِنْ وُدِّي",48,"ي",1,0],["لُغَةُ الضَّادِ أَنْبَتَتْ فِي بُحُورِ","الشِّعرِ دُرّاً حَيّاً بَدِيعَ البَرِيقِ",49,"ق",1,0],["لَغوى دَهرٌ رَماني","بِكَلامِ الناسِ لَغوا",50,"و",2,0],["لِغَريرَةٍ أَدنو وَتَبعُدُ في الهَوى","وَأَجودُ بِالوِدِّ المَصونِ وَتَبخَل",51,"ل",1,0],["لُغَةُ القُرْءَانِ تُزْهَى شَرَفاً","أنَّ حامي الدِّينِ وَالْمُلْكِ حَماها",52,"ا",3,0],["لغةُ الفنِّ أنتِ والسحْرِ والشِّعْرِ","ونُورُ الْحِجَا وَوَحْيُ الْجَنانِ",53,"ن",1,0],["لغة إذا قرَعَت بجندل لفظها","أذنَ السميع، شكت من الآلام",54,"م",1,0],["لغةُ المدافع وحدها","أسلوبُها في الحرب ساحر",55,"ر",1,0],["لغةُ الخصومِ من الرجوم حروفها","فلْيَقْرَءُوا منها الغداةَ فصولا",56,"ل",2,0],["لغةُ التفاهمُ عنده","قَصْفُ المدافع والرجومِ",57,"م",1,0],["لَغِبٌ فلا الإِمساءُ يُوسِعُهُ","عَطْفاً ، ولا الإِصباحُ يُنجِده",58,"د",2,0],["لغة الضاد في فم الملِك الفذِّ","تباهي بحسنِها الموصوف",59,"ف",1,0],["لغة العواطفِ جلَّ مَنْطِقُها","عن أن يُقاسَ بمنطقِ البشر",60,"ر",1,0],["لغسلتُ جَفْناً راح من ظمأٍ","مُتَلَهباً مُتَطايِرَ الشَّرر",60,"ر",1,0]]}