{"poems":[[55,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[65,"لك الخير هل في لفتة من متيم","https://www.aldiwan.net/poem46204.html","الطويل"],[32,"خليلي عوجا اليوم حتى تسلما","https://www.aldiwan.net/poem29528.html","الطويل"],[32,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[74,"واحيلتي بظلام الطرة الداجي","https://www.aldiwan.net/poem18450.html","البسيط"],[74,"إن في نائب الشام اعتبارا","https://www.aldiwan.net/poem20493.html","الخفيف"],[26,"وقائلة ما كان حذوة بعلها","https://www.aldiwan.net/poem24095.html","الطويل"],[30,"ألستم عائجين بنا لعنا","https://www.aldiwan.net/poem5607.html","الوافر"],[82,"فؤادي نجيب والجلال نجيب","https://www.aldiwan.net/poem31549.html","الطويل"],[54,"كأن أرواح أهل العشق سائرة","https://www.aldiwan.net/poem26788.html","البسيط"],[77,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[50,"ركب تساقوا على الأكوار بينهم","https://www.aldiwan.net/poem64436.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16634","الوافر"],[90,"قلبي عليك حليف الوجد يا عود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19545&r=&rc=48",""],[118,"إني بدهماء عز ما أجد","https://www.aldiwan.net/poem20955.html","المنسرح"],[228,"ختمت بالصمت آيات وعرفانا","https://www.aldiwan.net/poem41615.html","البسيط"],[244,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[280,"كفاني الحر منتجع الغمام","https://www.aldiwan.net/poem25530.html","الوافر"],[412,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[458,"أهذا هو الفنان نسمعه فنا","https://www.aldiwan.net/poem61703.html","الطويل"],[592,"ألا مال نيران الأسى تتضرم","https://www.aldiwan.net/poem11519.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122713","المنسرح"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19986","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80016","الرمل"],[1718,"","https://poetry.dctabudhabi.ae/diwan/poem/44741","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100967","الطويل"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96181","المتقارب"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53144","الرجز"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46745","البسيط"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100908","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93845","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204905","الوافر"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26114","الوافر"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105765","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91632","الطويل"],[3708,"","https://poetry.dctabudhabi.ae/diwan/poem/123842","البسيط"],[3893,"","https://poetry.dctabudhabi.ae/diwan/poem/114858","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139639",""],[5061,"الوفاء والطيب","https://www.poetsgate.com/ViewPoem.aspx?id=147176",""],[5183,"سباق الأعنة","https://www.poetsgate.com/ViewPoem.aspx?id=180222",""],[592,"أأشجاك أم أبكاك رسم النمازل","https://www.poetsgate.com/ViewPoem.aspx?id=128860",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[5376,"تراهمُ الحقلَ أم ذا القلبَ قد حرقوا","https://www.poetsgate.com/ViewPoem.aspx?id=204773",""],[5410,"أراك عصيّ الصوت","https://www.poetsgate.com/ViewPoem.aspx?id=142117",""]],"verses":[["كانَ اِرتِكاضي في حَشاكِ مُسَبِّباً","رَكضَ الغَليلِ عَلَيكِ في أَحشائي",0,"ي",1,0],["كأنّ ارْتِجازَ السُّحْبِ واهيَةَ الكُلى","جَلا في حواشيهِنَّ عنْ متْنِ أرْقَمِ",1,"م",1,0],["كَأَنَّ اِرتِحالَ الرَكبِ يَرمي بِرَحلِها","عَلى بازِلٍ قَرمٍ جُلالٍ عُلاكِمِ",2,"م",1,0],["كَأَنّا رَمَتنا بِالعُيونِ الَّتي بَدَت","جاذِرُ حَوضى مِن جُيوبِ البَراقِعِ",3,"ع",1,0],["كأنَّ أراءه بينَ الدِّيار بها","كواكبٌ تتجلَّى بين أبراج",4,"ج",1,0],["كانَ أرغون شاه فاجأ الذب","ح فأمسى شاه بلا أرغون",5,"ن",1,0],["كَأَنَّ اِرتِجازَ الجُعثُمِيّاتِ وَسطَهُم","نَوائِحُ يَجمَعنَ البُكا بِالأَزامِلِ",6,"ل",1,0],["كَأَنَّ أَراقِماً عَلِقَت يَداها","مُعَلَّقَةً إِلى عَمَدِ الرُخامِ",7,"م",1,0],["كأنّ ارتفاع الصوت منه تَضَرّعٌ","إذا لذع الأحشاءَ منه لهيبُ",8,"ب",1,0],["كَأَنَّ أَرواحَ أَهلَ العِشقِ سائِرَةٌ","إِلى جَمالِكَ بِالتَقريبِ وَالعَنَقِ",9,"ق",1,1],["كأنّ أرماحَهم تَتْلو إذا هُزِجَتْ","زَبورَ داودَ في محْرابِ داود",10,"د",1,0],["كَأَنَّ أَرؤُسَهُم وَالنَومُ واضِعُها","عَلى المَناكِبِ لَم توصَل بِأَعناقِ",11,"ق",1,0],["كأن أراقماً نفثت سماماً","عليه فعاد مبيضاً نحيلا",12,"ل",2,0],["كأن ارواحنا عند استماعك من","لطف لهن الاجسام تجريد",13,"د",1,0],["كَأَنَّ إِرنانَها إِذا رُدِمَت","هَزمُ بُغاةٍ في إِثرِ ما فَقَدوا",14,"د",3,0],["كَأَنَّ أَرجاءَه بَعد الأُلى ذَهَبوا","أَمسَت عَلَيهِم دياجيراً وَأَكفانا",15,"ن",2,0],["كأن ارتفاع النقع فوق رؤوسهم","سحاب أحم طبق الجو هيدب",16,"ب",1,0],["كَأَنَّ أرِيجَهَا زَهْرُ الرَّوابِي","يُمَزِّقُ ضَاحِكاً جَيْبَ الكمَامِ",17,"م",1,0],["كَأَنَّ أَرضك مَغناطيسُ كل فَمٍ","فَالطَبعُ يَجذِبها بِالطَوعِ وَالرَغمِ",18,"م",1,0],["كأنا رفضنا العيشَ دقاتِ قَلبنا","وأنا اندمجنا في الخلود وما جَّنا",19,"ن",2,0],["كأن أرج المسك نكهة ثغرها","إذا نطقت أو عنبر متقوم",20,"م",1,0],["كَأَنَّ آراءَهُ إذا انبَعَثَت","طَيرٌ عَلى حَربِهِ أبابيلُ",21,"ل",1,0],["كَأَنَّ أَرماحَهُ تُعطى إِذا عَمِلَت","تَحتَ العَجاجَةِ أَسماعاً وَأَبصارا",22,"ر",2,1],["كانَ أرسى زمناً لكن على","مهج الأعداء ثم اقتلعا",23,"ع",2,0],["كَأَنّا رَبطنا بِالخباءِ مُشَهَّراً","مِنَ الخَيلِ مِلواحاً يَسيرُ وَيرمَحُ",24,"ح",1,0],["كأن أريج المجد منه مدامةٌ","تنادوا إليها ثلةً بعد ثلة",25,"ه",1,0],["كان أرجى لك في العقبى من أن","تملأ الدلو إلى عقد الكرب",26,"ب",1,0],["كأن أرض الشرك لما اجتمعت","ملوكها قاع لديك صفصف",27,"ف",1,0],["كَأَنَّ أَردافَها دِعصٌ بِرابيَةٍ","مُستَهدَفٌ نخلتهُ الريحُ مَنضودُ",28,"د",1,0],["كأنَّ أرواحَهم طيرٌ محَلّقة","على الرؤوسِ متَى تسنح لهم زَجَروا",29,"ر",3,0],["كانا رضيعي لبان المجد مذ نشآ","وكان مرباهما في الرشد والحزم",30,"م",1,0],["كأنا راجعون به لرب","بصير في دجى العقل الضرير",31,"ر",1,0],["كَأَنَّ أَرومَها وَالآلُ طافٍ","عَلى أَرجائِها نَبَطٌ قُعودُ",32,"د",1,0],["كأنّ ارتجاسَ الريح في جنباتها","إذاعة شكوى أو سرارُ تعاتُب",33,"ب",1,1],["كَأَنّ أَراضيه سماءُ زبرجدٍ","وَقَد أَطلعت تلك النجومُ نجوما",34,"م",2,0],["كأن أرقعة الجوزاء روشنه","والحركتان كأن الفرقدين هما",35,"م",2,0],["كأنا رابطُونَ به فلُوّاً","شديدَ النُزو قَمَّاصاً رَموحا",36,"ح",2,0],["كأن أرؤس الأبطال يوم نزاله","وقد نظَّمتهُنَّ الرماح قلائد",37,"د",1,0],["كان إرضاء الكل غاية مطلبي","والله إني مَ ارتفع صوب الشموخ",38,"خ",1,0],["كأن أريج الزهر من فوق دوحها","أريج المنى جاءت بنصر وطائل",39,"ل",1,0],["كأن أريج المسك نكهة ثغرها","إذا فتر منها ضاحكاً في المحافل",40,"ل",1,0],["كأن أريج المسك نكهة ثغرها","إذا هي ناجت وامقاً ذا تواجد",41,"د",1,0],["كأن أريج المسك عرف عبيرها","وأذكى أريج إذ تضوع من ند",41,"د",1,0],["كأنَّ أرضاً بما في النفس مُختلِطٌ","بتيه شيخٍ من اللوْعات تختَنِق",42,"ق",1,0],["كأنّ ارتشاح الآه بحرٌ يحاصرنا","وفي لُجِّهِ الآلام والنار والغدر",43,"ر",1,0]]}