{"poems":[[63,"لمحة البارق من حيث لمح","https://www.aldiwan.net/poem51745.html","الرمل"],[147,"ذد بالعزاء الهم عن طلباته","https://www.aldiwan.net/poem11739.html","الكامل"],[369,"بيض طوالع من خيام سود","https://www.aldiwan.net/poem60954.html","الكامل"],[445,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[469,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[534,"يا من له من ذهنه","https://www.aldiwan.net/poem37411.html","مجزوء الكامل"],[556,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121147","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94020","الخفيف"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35874","الرجز"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45824","الكامل"]],"verses":[["وإذا ازدَدْتَ لشيء فَرَحاً","فليَزِد شانيكَ هَمّاً وترَح",0,"ح",1,0],["وَإِذا أَزارَ الطِرسَ نِقسَ دَواتِهِ","أَيقَنتَ أَنَّ الفَضلَ مِن أَدَواتِهِ",1,"ت",2,0],["وإذا أزار الأرضَ جُنْداً أيقنَتْ","أنّ السّماءَ تُمِدُّه بجُنود",2,"د",1,0],["وإِذا ازدَهَتْكَ من المحامِدِ زَهْرَةٌ","فِي رَوْضَةٍ غَنَّاءَ فهو يَرُودُها",3,"د",3,0],["وإذا أزورَّ حاجب النقع ضنَّتْ","وجنة الصبح أن تحطَّ اللثاما",4,"م",2,0],["وإذا أُزيلَتْ عَيْنُهُ","فالقَلْبُ زَلَّ وسَلْ وناظِرْ",5,"ر",1,0],["وإذا اِزوَرَّ جائرٌ عن هداه","قاده نحوه فكان زماما",6,"م",2,0],["وإذا ازدارت الفتاة فحاضت","نفرت ثم لم تخف اعتقالا",7,"ل",2,0],["وإذا ازدرى ملك البلاد بشعبه","خسِر البلاد وأمطر العلق الثرى",8,"ر",2,0],["وإذا أزارها اجتمعنا ولا طر","فة عين إلا علينا رقيب",9,"ب",1,0],["وَإِذا اِزدِواجُ الطَرَفَينِ ثابِتاً","فَاِحكُم بِذا وَقِس عَلَيهِ ما أَتى",10,"ت",2,0],["وَإِذا إِزدَهى ريحانها بِنَباتِهِ","جاءتهُ رَوضة عارضيك بِأَنضر",11,"ر",1,0]]}