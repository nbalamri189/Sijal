,"الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62940","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129376","البسيط"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199026","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111481","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111413","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111503","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28682","المنسرح"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66138","الكامل"],[4898,"يوم عاصف .","https://www.poetsgate.com/ViewPoem.aspx?id=35812",""],[4930,"رضيت بالرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=212904",""],[4119,"الحق مبتهج والسيف مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=16222",""],[5135,"ما أطول الليل !","https://www.poetsgate.com/ViewPoem.aspx?id=202673",""],[778,"مازج بروحك روح الراح تحييها","https://www.poetsgate.com/ViewPoem.aspx?id=89235",""],[5409,"هل مسك الوجد مثلي أيها البان","https://www.poetsgate.com/ViewPoem.aspx?id=155513",""],[5425,"شَوْقٌ ، أَمْ حَسَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=198953",""],[5444,"زيتونة المسرى","https://www.poetsgate.com/ViewPoem.aspx?id=205084",""],[5464,"طاوي الديار","https://www.poetsgate.com/ViewPoem.aspx?id=33886",""],[5689,"باتت اليك يد الأشواق تدفعه","https://www.poetsgate.com/ViewPoem.aspx?id=143392",""],[5721,"أعظم من أسلافي الأول","https://www.poetsgate.com/ViewPoem.aspx?id=215232",""],[5730,"أحصت قصائده أم خانها العدُّ؟","https://www.poetsgate.com/ViewPoem.aspx?id=210350",""],[5790,"قدست من ملكٍ عظيم الشان","https://www.poetsgate.com/ViewPoem.aspx?id=111870",""],[5829,"دعوة الى الستر","https://www.poetsgate.com/ViewPoem.aspx?id=157070",""],[5829,"شاب الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=213964",""],[5853,"زهرة الاشجان","https://www.poetsgate.com/ViewPoem.aspx?id=175718",""],[5906,"بِترا","https://www.poetsgate.com/ViewPoem.aspx?id=188068",""],[5906,"عَدالة","https://www.poetsgate.com/ViewPoem.aspx?id=188215",""],[5906,"في الحكمة / البخل ..... بيت البخيل","https://www.poetsgate.com/ViewPoem.aspx?id=193748",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[6068,"قلق يلازمني... -02-","https://www.poetsgate.com/ViewPoem.aspx?id=175844",""],[6142,"هل أنت معطي العين بعض سناتها","https://www.poetsgate.com/ViewPoem.aspx?id=155761",""],[6277,"ظلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64482&r=&rc=45",""]],"verses":[["حتّى إذا برَقَتْ للرّوعِ بارِقَةٌ","أقْبَلْتَها البِيضَ والعسّالةَ الذُّبُلا",0,"ل",2,0],["حَتّى إِذا بَرَتِ العِظامَ زَجَرتُها","زَجرَ الضَنينِ بِعِرضِهِ الغَضبانِ",1,"ن",1,0],["حَتَّى إِذَا بَانَ المُقَدَّمُ لَمْ يَدُلْ","مِنْ نُورِ مِصْرَ بَعْدَهُ الإِظْلامُ",2,"م",1,0],["حتى اذا بدا حاجب الشمس","والحاجب الشرقي منه منحجب",3,"ب",1,0],["حَتّى إِذا بَرَدَ السِجالُ لُهاثَها","وَجَعَلنَ خَلفَ غُروضِهِنَّ ثَميلا",4,"ل",2,0],["حَتّى إِذا بَلَغَ الفَلَكُ المَدى اِنحَدَرَت","كَأَنَّها في الأَكُفِّ الصارِمُ الفَرِدُ",5,"د",1,0],["حَتّى إِذا بَلَغَت مَواكِبُها المَدى","وَجَرى لِغايَتِهِ القَضاءُ الأَسبَقُ",6,"ق",1,0],["حَتّى إِذا بَلَغَ السُمُوُّ كَمالَهُ","أَذِنَت لِداعي النَقصِ تَهوى القَهقَرى",7,"ر",2,0],["حتى إذا بلغت نهايتها","عادت تحاول في الثرى سربا",8,"ب",2,0],["حتى إذا بلغ البخارات المدى","نزلت وصارت ديمة مدرارا",9,"ر",2,0],["حتَّى إذا بَزَغَتْ شبِيهَتُها","كالتاجِ فوْقَ مفارقِ القيلِ",10,"ل",1,0],["حَتّى إِذا بُعِثَ النَبِيُّ مُحَمَّدٌ","فيهِم غَدَت شَحناؤُهُم تَتَضَرَّمُ",11,"م",1,0],["حَتّى إِذا بَلَغَ البُنيانُ غايَتَهُ","مِن مَوضِعِ الرُّكنِ بَعدَ الكَدِّ وَالجشَمِ",12,"م",1,0],["حتّى إذا بلغ المكروهُ غايتَه","وهال كلَّ غويِّ الرأي ما حملا",13,"ل",2,0],["حَتّى إِذا بُهمى المِتا","نِ جَرَت وَكانَت كَالنَسائِل",14,"ل",1,0],["حتّى إِذا بَعَثَ اللَّهُ العِبادَ إلَى","يَوْمٍ بهِ الحكمُ بينَ الخلقِ مَفصُولُ",15,"ل",1,0],["حَتّى إِذا بَعَثَ الصَباحُ فِراقَنا","وَرَأَينَ مِن وَجهِ الظَلامِ صُدودا",16,"د",2,1],["حَتّى إِذا بَعَثَ الأَذينُ فِراقَنا","وَرَأَيتُ مِن وَجهِ الصَباحِ خُدودا",17,"د",2,0],["حَتَّى إذا بَذَّ السَّوابِقَ في العُلا","وَالعِلْم ضُمِّنَ شِلْوُهُ مَلْحُودا",18,"د",2,0],["حَتَّى إِذَا بَلَغُوا النَّجَاحَ وَصَرَّفُوا","فِي الحُكْمِ كَانُوا الصَّفْوَةَ الأَخْيَارَا",19,"ر",2,0],["حَتّى إِذا بَرَدَ اللَيلُ البَهيمُ لَها","وَبَلَّها سَحَراً مِنهُ بِأَنداءِ",20,"ا",2,0],["حتى إذا بلغَ الجميلُ أشُدَّه","سارَ الكريمُ إلى المكارم فاردا",21,"د",2,0],["حتى إذا بلغت مجهودها فنيت","من بعد جلجلة منها وضوضاء",22,"ا",2,0],["حتى إذا برح الخفاءُ وسفَّهتْ","حِلَم الحليمِ حفيظةُ الغضبانِ",23,"ن",1,0],["حَتَّى إِذا بَذَلَ المَوْعودَ مِنْ صِلَتي","وَخافَ مِنْ مَلَلي إِذْ قَالَ لِي وَلعا",24,"ع",2,0],["حَتّى إِذا بَلَغوا النَبِيَّ مُحَمَّداً","فَرَشوا لِأَوجُهِهِم حَصىً وَصَعيدا",25,"د",2,0],["حتّى إِذا بلغت نهايةَ سَيرها","أَلقَت عَصاها واِستقرَّ نَواها",26,"ا",3,0],["حتى إذا بَلَغَ الأشُدَّ رأتْ به","ذخراً ليومِ كريهةٍ وَجِلاد",27,"د",1,0],["حتى إذا بلغ النكال حدوده","بالمصطفى وصحابه الأطهار",28,"ر",1,0],["حتى إذا بسطَ الشيطان راحته","إليه صاغَ له عذبَ التحيّات",29,"ت",1,0],["حتّى إذا بلَغا الخِصامَ تَراضيَا","للفَصْلِ بينهما بَعقْدِ قبَائه",30,"ا",3,0],["حتّى إذا بِتْنا على أَمَلٍ","نَعِدُ النّفوسَ بكُلِّ ما سَرّا",31,"ر",2,0],["حَتّى إِذا بَلَغت إِلى حيثُ انتَهَت","وَقَفت كَوَقفَةِ سائِلٍ عَن مَنزِلِ",32,"ل",1,0],["حَتّى إِذا برق الصَباحُ لِناظِرٍ","فارَقته كُرهاً عَلى إِرغامي",33,"م",2,0],["حتَّى إذا بلَغَتْ سماوات العُلى","رَفَقَتْكَ حينئذٍ على كيوانها",34,"ن",3,0],["حتى إذا بكت السحا","ب وثجت الأمطار ثجَا",35,"ج",2,0],["حتّى إذا بلغ الميقاتُ غايَتَه","لَم يسلموا ولشيءٍ طالما سلموا",36,"م",3,0],["حَتّى إِذا بَلَغَ المَدى عارَضنَهُ","فَمَسَحنَ غُرَّةَ سابِقٍ لَم يَجهَدِ",37,"د",1,0],["حَتّى إِذا بَلَغَت وَحانَ خِطابُها","ساوَمتُ صاحِبَها البَياعَ فَغالى",38,"ل",2,0],["حتى إذا بلغ عبد الله","أشده حقا بلا اشتباه",39,"ه",1,0],["حتى إذا بهم ضاق الفضا جعلت","سيوفكم لهم في الموت متسعا",40,"ع",2,0],["حتى إذا بلغت مرابعَ أهلها","عادت مزيجا جامعا أخطارا",41,"ر",2,0],["حتى اذا بلغت مجا","ري مائِها امست غريقَه",42,"ه",1,0],["حتّى إذا بلغ المرادَ من العدى","وشفى الهدى من عابدي الأوثان",43,"ن",1,0],["حتى إذا بلغوا المدى جادلتهم","فأعدتهم مستسلمين فوحدوا",44,"د",3,0],["حتى إذا بُسْرها غدا رُطَباً","فازوا بأعذاقها برمّتها",45,"ت",3,0],["حَتّى إِذا بَين يَديهِ أَحضَره","يَنظر في العُذرِ الَّذي قَد أَخَّره",46,"ه",1,0],["حتى إذا بلغت قلوب","المسلمين إلى الحناجر",47,"ر",1,0],["حتى إذا برد الحُليُّ وأسفرتْ","قسماتُ وجه الصبح حين تبسّما",48,"م",2,0],["حتّى إِذا باتَ الحيا يَبكي بها","أَضحى بها النوّار يضحكُ باسما",49,"م",2,0],["حَتّى إِذا بَلَغتَ مَقدورَ غايَتِها","جاءَتكَ تَضحَكُ مِن ظُلَمائِها السَرَج",50,"ج",1,0],["حتى إذا بخلت بالوصل ملت إلى","مديح حبر همام ما له ثاني",51,"ن",2,0],["حتى إذا بصروا بعقد لوائه","عقدت مهابتها به الأسرار",52,"ر",1,0],["حتى إذا باعدت ميلين وانتكثت","ولو يشاءُ نأى منهن فانقضبا",53,"ب",2,0],["حتى إذا بلغَ المدى بهمُ","ورَدوا جمام حياضه ورَدُوا",54,"د",3,0],["حَتَّى إِذَا بَلَغَتْ إِلَى السُّورِ الَّذِي","طَلَعَتْ بِهِ فِي جُنْحِ لَيْلٍ مُدَّجِ",55,"ج",1,0],["حتى إذا بلغوا به ملحودَهُ","قمنا به لو أنَّه الجوزاء",56,"ا",2,0],["حتى إذا بلغ المنى فيما انتوى","عاجت به نجب الركاب فعاجا",57,"ج",2,0],["حتى إذا برز الورى من غيبهم","وتميّزت ببنيهم الأنساب",58,"ب",1,0],["حَتّى إِذا بَلَغَ القَصِيَّ مِنَ المُنى","ولّى وَما وَلّى فَلَيسَ بِعائِدِ",59,"د",1,0],["حتى إذا بَلَغَ الأوَانَ جيِبُهَا","وَوَفَتْ بِقَدرٍ فِي الحِسابِ مُتَممِ",60,"م",1,0],["حَتّى إِذا بَذَّ زَرعَ الماءِ ناهِضُها","وَاِستَتبَعَ الريحُ مِنها مائِلَ الغُصُنِ",61,"ن",1,0],["حتى إذا برزتْ بالكون أعيننا","علمت بالكونِ قطعاً أنه الخالق",62,"ق",1,0],["حتى إذا بلغَ الأشدّ ولم ينط","بشعاره دنسٌ ولا بدثار",63,"ر",1,0],["حتّى إذا باشرتُ أهوالَهُ","وصرتُ مغلوباً على أمري",64,"ر",2,0],["حتى إذا بُعِثَ الرسولُ مُحَمَّدٌ","وبدا لِصُبحِ الحقِّ مِنهُ عَمُودُ",65,"د",1,0],["حَتّى إِذا بَلغ الغَريَّ وَقابل ال","غروية البَيضا أَسرَّ خِطابها",66,"ب",3,0],["حتى إذا بعث اللَه الرؤوف لها","اباً وبعلا فلم تيتم ولم تئم",67,"م",1,0],["حتى إذا بلغت منازلها غدت","بقرار دارتها بغير قرار",68,"ر",1,0],["حتى اذا بصروا بها ذهباً","متلالئاً يحلو به الارب",69,"ب",1,0],["حتى إذا بعث الوزير له","رصداً وعين اللَه بالرصدِ",70,"د",1,0],["حتى اذا بسط الممات جناحه","من فوقها ودنا ينازعها البقا",71,"ا",1,0],["حتى اذا بلغوا القطبين ما وقفوا","ولا أبى عزمهم في السعي إسادا",72,"د",2,0],["حتىّ اذا بلغ الحَضيضَ انساب في","تلك الرياض كأَنَّهُنَّ خِباهُ",73,"ا",2,0],["حتى إذا برأسها الشيب اشتعل","والطير بالنوح على الدوح اشتغل",74,"ل",1,0],["حتى إذا باحتْ بنا شمسُ الضُحى","للعينِ غبْنا في العيانِ الأربدِ",75,"د",1,0],["حَتَّى إِذَا برد النهار وأطرقت","شمسُ الظهيرة للتغيُّب طرقا",76,"ق",2,0],["حتى إذا بخلت علي","ها الأرضُ يمّمَتِ السماء",77,"ا",2,0],["حتى إذا بانَ عن عينيّ موكبها","وعادَ ليلى إِلى الأشجان والأرَقِ",78,"ق",1,0],["حَتّى إِذا بلغ الذرى","دكّ الشمام وَزَعزَعا",79,"ع",2,0],["حتى اذا بهر الاباطحَ والرُّبى","نظرتْ اليكَ بأَعينِ النُّوارِ",80,"ر",1,0],["حتى اذا باللظى قامت قيامته","والبغي يورد من يعتاده سقرا",81,"ر",2,0],["حتى إذا بابن الزبير ظفرا","وكان في مكة يعلو المنبرا",82,"ر",2,0],["حَتَّى إِذا بَرِحَ الحِما والخَيلَ وال","فُرسانَ جَدَّ مَسِيرَهُ يَتسَرَّعُ",83,"ع",1,0],["حتى إِذَا بالجَهدِ قد جَلَسُوا","وَالصَّمتُ يُسمِعُ وَقعَةَ الكَلِمِ",84,"م",1,0],["حتى إذا برحت براح تألقت","نيرانهم من تحت ليل أليل",85,"ل",1,0],["حَتّى إِذا بَلَّ حَرفَ كِسرَتِهِ","مِن دَسَمٍ جامِدٍ وَمُنسابِ",86,"ب",1,0],["حَتَّى اذا بَلَغا الحِمَى دَفعَتْهُما","عنهُ الاسُودُ تَحُومُ حَوْلُ فِنائهِ",87,"ا",3,0],["حتَّى إذا بَلَغوا الذُّهُو","لَ أعادَهُم وقْعُ البَرَدْ",88,"د",1,0],["حتى إذا بكَتِ الخلائقُ حالَها","ونظرتُ في حالي تملَّكني العَجَبْ",89,"ب",1,0],["حتى إذا بدت الأراء ضاحكة","وأقبلت اوجه الإقبال تبتسم",90,"م",1,0],["حتَّى إذا بزغتْ شَمْسُ الصَّباحُ أتَى","طَيْفٌ مِنَ الْأَمَلِ الْمَوْعُوْدِ يُحْيِيْنا",91,"ن",2,0],["حتى اذا بلغتها دونهم وقفت","فاقسمت بالهوى الا تعديها",92,"ي",3,0],["حتى إذا بعدت عن عين قانصها","رمت بطرفٍ كليل وهو حيران",93,"ن",1,0],["حَتَّى إِذا بَعُدَتْ وَاحَاتُ بَسمَتِهِمْ","واسْتَحْكَمَ الحُزْنُ أَعنَاقَ الرَيَاحِينِ",94,"ن",1,0],["حتى إذا بلغَ المدى عدوانُها","ولكلِّ من طلبَ الهدايةَ قامعة",95,"ع",2,0],["حتى إذا بلغَ الفِطامَ من الأسى","وحَبا على دربِ الهيام ِ مُمَتَّعا",96,"ع",2,0],["حتى أذاب الجوى منه العظام هوى","على ثرى بله قبل مدمعه",97,"ع",2,0],["حَتَّى إِذَا بَلَغَتْ رُوحِي مَطَامِعَهَا","دِيناً وَ دُنْيا وَ قَرَّتْ بِالعُلا مُقَلِي",98,"ل",2,0],["حتى إذا بَعُدت قال الفتى شغفا","حبيبتي هجرت فلتبكِ ياوردُ",99,"د",1,0],["حتى إذا بصرت به أبصارهم","خروا لهيبته إلى الأذقان",100,"ن",1,0],["حتى إذا بلغوا لذلك مأربا","سقط الحمى وانهالت الأرزاء",101,"ا",2,0],["حتى إذا بلغَ الزبى من سيلِهِ","فاحملْ عليهِ كحنقِهِ، لا تبخلِ",102,"ل",1,0],["حتى إذا بخلت سحابة ماطرٍ","جادتْ حروفي بالقصيد الأروع",103,"ع",1,0],["حَتْى إذا بَلَغَ الوَطاءَ بِبَاحَةٍ","شَقَّتْ سَماؤُكِ نَحوَ جَوفِكِ مَعْبَرا",104,"ر",2,0],["حتى إذا بلغ الفجور مكانة","منك ؛ استحى من هَمَّ في لقياك",105,"ك",1,0],["حَتّى إذا بَلَغَ الثَّرى فَطَريقُهُ","نَحوَ المُضيفِ يَشوبُها الخِذلانُ",106,"ن",1,0],["حَتّىْ إِذَاْ بَانَتْ بِها سَوْءَاتُهُمْ","أَخَذَاْ بِخَصْفٍ يَطْفُقَاْ بِريَاْدِ",107,"د",1,0],["حتى إذا بدتِ السعادة فجأة","فرأيتُ ميزاب الهموم تفتّحا",108,"ح",2,0],["حتى إذا بلغت محاني كربلا","عكفت معرسة على عرصاتها",109,"ت",3,0],["حتى إذا بلغت ما أريد","وعدت لا تعثر بي الجدود",110,"د",1,0]]}