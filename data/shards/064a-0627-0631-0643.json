{"poems":[[56,"يا ركبتي خزر وساق نعامة","https://www.aldiwan.net/poem29357.html","الكامل"],[47,"يا ثقيلا على القلوب إذا عن","https://www.aldiwan.net/poem63535.html","الوافر"],[56,"يا رُكبَتي خُزَزٍ وَسَاقَ نَعَامة","https://www.poetsgate.com/ViewPoem.aspx?id=14278",""],[438,"بين اللوى فالجزع فالمتثلم","https://www.aldiwan.net/poem12473.html","الكامل"],[447,"أستغفر الله العظيم","https://www.aldiwan.net/poem14398.html","مجزوء الكامل"],[505,"جسمي من الكرب المبرح قد عفا","https://www.aldiwan.net/poem37690.html","الكامل"],[505,"والحواميم وهي أقسام مثلي","https://www.aldiwan.net/poem38024.html","الخفيف"],[567,"طال النوى حتى تقطعت المنى","https://www.aldiwan.net/poem52987.html","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110379","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86852","الكامل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199568","المسحوب"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56215","المتدارك"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118297","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60844","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60830","الكامل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136960",""],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139978","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68026","البسيط"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105568","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73193","البسيط"],[5183,"ركب الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=180181",""],[5434,"خبيث التجاره","https://www.poetsgate.com/ViewPoem.aspx?id=37616",""],[5461,"يوم ميلادي","https://www.poetsgate.com/ViewPoem.aspx?id=5242",""],[5790,"كم في بيوتٍ بسفح الرمل من قمرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=112057",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""]],"verses":[["يا رُكبَتي خَزرٍ وَساقَ نَعامَةٍ","وَزَبيلَ كَنّاسٍ وَرَأسَ بَعيرِ",0,"ر",1,1],["يا رُكوداً في يَومِ غَيمٍ وَصَيفٍ","يا وُجوهَ التِجارِ يَومَ الكَسادِ",1,"د",1,0],["يا رُكبَتي خُزَزٍ وَسَاقَ نَعَامة","ٍ وزَبيلَ كنّاسٍ وَرَأْسَ بِعير",2,"ر",1,1],["يا ركبَ مكةَ ها تحيةَ عاشقٍ","مُضنًى نحيفِ الجسمِ صبٍّ مغرمِ",3,"م",1,0],["يا ركباً بحر المنى","في بطن جارية المنية",4,"ي",2,0],["يا ركبب إن جئت الأحبَّةَ قل لهم","قولي وزده تخضُّعاً وتلطُّفاً",5,"ف",2,0],["يا رِكابَ العُشَّاقِ سيري بحَيِّي","وأَنيخي بزَفْرَتي وبعَدِّي",6,"د",2,0],["يا رُكنَ دَوْلةِ آلَ قيسصٍ قد صَبَت","قَيسٌ على يمنٍ إليكَ تَيَمُّنا",7,"ن",2,0],["يا ركنَ لبنانَ العظيمَ عليكَ قد","كادت رُبضى لبنانَ أن تتفطَّرا",8,"ر",2,0],["يا رُكن بَيت الغيّ هَل مِن تَوبة","تَلقى بِها رَباً رَحيماً يَغفر",9,"ر",1,0],["يا ركب هيّد لي وبندب رساله","جدوى وليفٍ علل الروح تعليل",10,"ل",1,1],["يا ركن بلادٍ عمرت في","نعماك وشاد البنيانُ",11,"ن",1,0],["يا ركب الوجناء في البيداء","تطوى له البيداء بالوجناء",12,"ا",2,0],["يا رَكْبُ بالجَنَد الخصِيبة بارقُ","تهْمي سحائبَهُ صَباحَ مسائي",13,"ا",2,0],["يا ركْبَ خصّوه بألفِ تحِيّةٍ","عني وحيوا ربْعَهُ والمسجدا",14,"د",2,0],["يا ركب حي الحمى عني وقل لهم","هبوا إلى المجد ان النوم قتال",15,"ل",1,0],["يا ركبَ مصرَ رويداً يلتحق بكم","قومٌ مغاربةٌ لحم على وضم",16,"م",1,0],["يا ركبُ مَهْمَا تكن بالحي ذا كَلَفٍ","فنادِه عَلَّه يُبْديك بالكَلِم",17,"م",1,0],["يا ركوباً على سبوح طموح","سيرها الوخد والونى والنسوع",18,"ع",1,0],["يا رَكبُ حَيُّوا على الجَرعاءِ دارَ هَوىً","كَم نِلتُ فيها وَكم قضيَّتُ من وطَرِ",19,"ر",1,0],["يا ركب أنت بما تشاء جدير","هذي الحياة بها لك التأمير",20,"ر",1,0],["يا ركب إن على البخار حقائقا","ظهرت وأنت على البخار قدير",20,"ر",1,0],["ياركب من فوق صاف البلوفي","مقعد امبير الزيت نيم الحراره",21,"ر",2,0],["ياركب الايام معك العمر ينقاد","كم ليلة(ن) وسّدتني فيك تنهيده",22,"د",2,0],["يا ركب حنوا على الجرعاء دار هوى","كم نلت فيها وكم قضيت من وطر",23,"ر",1,0],["ياركب ما خلّفت الا عاشقا","يشكو الجوى من وجده ويزيد",24,"د",1,0]]}