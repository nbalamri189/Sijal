{"poems":[[90,"أنا بالحكومة والسياسة أعرف","https://www.aldiwan.net/poem44808.html","الكامل"],[74,"يا متقنا علم الشريعة والندى","https://www.aldiwan.net/poem19617.html","الكامل"],[53,"الحمد لله لا شريك له","https://www.aldiwan.net/poem64017.html","المنسرح"],[53,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[107,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[52,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[164,"اجعل زكاة سديرك المعمور","https://www.aldiwan.net/poem58827.html","الكامل"],[208,"تطوى المنى عن طلاب غايته","https://www.aldiwan.net/poem53265.html","المنسرح"],[240,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[275,"دعيني أمت حرا يخلده الذكر","https://www.aldiwan.net/poem35633.html","الطويل"],[275,"تذكرت في الحمراء عهد الصبوة","https://www.aldiwan.net/poem35637.html","الطويل"],[458,"إذن مصر عادت تقتفي مجدها الأسمى","https://www.aldiwan.net/poem61386.html","الطويل"],[475,"ملك تدين له الملوك مبارك","https://www.aldiwan.net/poem4789.html","الكامل"],[510,"المُقنَّع","https://www.aldiwan.net/poem27796.html","الطويل"],[593,"","https://poetry.dctabudhabi.ae/diwan/poem/107085","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122613","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54092","الكامل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18504","السريع"],[890,"","https://poetry.dctabudhabi.ae/diwan/poem/98156","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59639","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64591","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64428","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108623","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69422","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69389","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121180","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87324","الرجز"],[2899,"","https://poetry.dctabudhabi.ae/diwan/poem/107119","المتقارب"],[3167,"","https://poetry.dctabudhabi.ae/diwan/poem/136889","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62924","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131038",""],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17777","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/46003","الطويل"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103255","الطويل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/145916","الكامل"],[4337,"","https://poetry.dctabudhabi.ae/diwan/poem/114012","الطويل"],[4385,"","https://poetry.dctabudhabi.ae/diwan/poem/203916","الطويل"],[4859,"كل أنثى حين تشدو شاعرة!","https://www.poetsgate.com/ViewPoem.aspx?id=191086",""],[4984,"سهام الشروق","https://www.poetsgate.com/ViewPoem.aspx?id=175750",""],[585,"يا أيها القلم انهض إن سواك كبا","https://www.poetsgate.com/ViewPoem.aspx?id=161888",""],[5135,"ما بال طرفي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=201788",""],[5183,"مُلْغِزَه رق38م","https://www.poetsgate.com/ViewPoem.aspx?id=186407",""],[5219,"شدوا الرحال","https://www.poetsgate.com/ViewPoem.aspx?id=195038",""],[5573,"ضحايا العيد","https://www.poetsgate.com/ViewPoem.aspx?id=200331",""],[5573,"حاولت عيا الحرح لايلقى دوى والليل بالغربه طويل","https://www.poetsgate.com/ViewPoem.aspx?id=206604",""],[5573,"حاولت عيا الجرح لايلقى دوى/والليل بالغربه طويل","https://www.poetsgate.com/ViewPoem.aspx?id=213725",""]],"verses":[["تُجبى ضرائبها الثقال وإنما","في غير مصلحة الرعيّة تُصرف",0,"ف",1,0],["تجب الزكاة على الذين وعدتهم","وعداً فإنهمُ بذاك تموّلوا",1,"ل",3,0],["تَجبرُ ما تكسِر الحوادثُ فال","كسرُ عليها وأنت لِلجبر",2,"ر",1,0],["تَجبي له مالَ البلادِ وحمدها","إذ لا تضيعُ من الحقوقِ فتيلا",3,"ل",2,0],["تُجبى لِساداتِ البِلادِ وَبَينَها","مُهَجُ الإِماءِ وَأَنفُسُ العِبدانِ",4,"ن",1,0],["تُجبى لَهُ الأَرضُ مِن مِسكٍ وَمِن ذَهَبٍ","وَيُتَّقى غَيرَ فَحّاشٍ عَلى البادي",5,"د",2,0],["تجب الزكاة على بيوتك كلها","غير البيوت لفضلك المشهور",6,"ر",1,0],["تجبر ما تكسر الخطوبُ وما","تكسر آراؤه فلن يجبَرْ",7,"ر",1,0],["تَجَبُّراً لَم يَرمِ أَهلَ القُرى","بِمِثلِهِ آلُ أَبي الجَبرِ",8,"ر",1,0],["تُجبكِ فشا في ذلكَ الشِّعر سرُّنا","فلم يبقَ سرٌّ للجمالِ ولا ستر",9,"ر",1,0],["تُجبكَ ليالي الطيّباتِ قصيرةٌ","كأحلامِها تمضي على حين غفلة",10,"ه",1,0],["تجبّر واشتعلى فرداه صاغرا","وقد كان كالمحموم سكران بالحمى",11,"م",2,0],["تُجبَى لَهُ بَلخٌ وَدِجلَةُ كُلُّها","وَلَهُ الفُراتُ وَما سَقى والنِّيلُ",12,"ل",1,0],["تجبّرْ فقد تجبّرتْ أممٌ خلتْ","فكان المآلُ نيطلا أبديّا",13,"ي",2,0],["تجبى به الأموال إلا أنها","لشرّاب خمر أو بناء قصور",14,"ر",1,0],["تجِبُ الجُنوبُ فتستَوي في عُقرِه","عُوذُ المطافِلِ والكِبارُ العاقِر",15,"ر",1,0],["تجبر به من حالنا","ما اختل محلاً واضطربْ",16,"ب",1,0],["تَجبي سِجِستانَ وَما حَولَها","مُتَّكِئاً في عَيشِكَ الراغِدِ",17,"د",1,0],["تَجبّرت الجبابرُ بعد حجرٍ","وَطابَ لَها الخَوَرنقُ والسديرُ",18,"ر",1,0],["تُجب غُلبٌ تُدير الموتَ أعينهم","لا تعرفُ الدهر إلا حد بتار",19,"ر",1,0],["تجب الصفات له وليست غيره","وثوبتها في نفي سلبياته",20,"ت",2,0],["تجبرت يا جبار في جبريائه","فلاحظ للمقهور في الجبرية",21,"ه",1,1],["تجبرت يا جبار عن نيل حادث","وجدك أعلى أن تنال بوصمة",21,"ه",1,0],["تجبرت جبار السموات غالباً","على كل شيء من صنوف الخليقة",21,"ه",1,0],["تجبرت يا جبار قهراً وسطوة","وعدلاً وتصريفاً وتقدير حكمة",21,"ه",1,0],["تجبرت يا جبار كسر عباده","ومنعش جد العاثر المتشتت",21,"ت",1,0],["تجبرت جبار القلوب بثبتها","على الفطرة الأولى إذا لم تثبت",21,"ت",1,0],["تجبَّر يا بتول علي دائي","وبدد قوتي ومحا حبوري",22,"ر",2,0],["تُجبى لَهُ الأَموال خالِصَةً","لا مَأثَمٌ فِيها ولا وِزرُ",23,"ر",1,0],["تَجِبُ القُلوبُ مَخافَةً مِن بَأسِهِ","وَتُغَضُّ عَنهُ إِذا بَدا الأَبصارُ",24,"ر",1,0],["تجبر ان قوم بغت واذا صفت","وذلت تراه العابد المتبتلا",25,"ل",2,0],["تَجَبَّرُوا عَامينِ كاملينِ","فيها وَمالُوا الهندَ باليقينِ",26,"ن",1,0],["تجبكَ أسودٌ على ضمر","معوّدةٌ ما بغت أن يتم",27,"م",1,0],["تجبك يابن حميد الدين طائعة","وما لها غير نصر الله من أرب",28,"ب",1,0],["تُجبى اِليهم خُرج كلِّ جزيرةٍ","في كفَّةِ البحرِ المحيطِ الزَّاخِرِ",29,"ر",1,0],["تجبي ولكن لمن قد ضل غلّته","وذو الهدى معدم والمال مخزون",30,"ن",1,0],["تَجَبَّرُ مالاً بَعدَ لُؤمٍ وَدِقَّةٍ","كَما شُدَّ بِالشَعبِ الإِناءُ المُكَتَّفُ",31,"ف",1,0],["تَجبّرَ مِنهُ القَلب بَعدَ اِنصِداعِهِ","وَظَلَّ بِأَبياتٍ يُغَرِّدُ مُنشِدا",32,"د",2,0],["تجبر في أوطاننا متغطرس","فأرغم عيسى عنوة لا يقابله",33,"ل",2,0],["تجب الإجابة في الولائم كلها","حتما على ذي فاقة ومن ارتعج",34,"ج",1,0],["تجب على الإنسان عزلة جنسهم","ومن صحب الأرذال صار منازع",35,"ع",1,0],["تجبرت يافضل بن مروان فاعتبر","فقبلك كان الفضل، والفضل والفضلُ",36,"ل",1,1],["تجبر الكسرَ وتمضي قدماً","لاتبالي بالعقولِ الجائرة",37,"ر",2,0],["تجبَّر أهل الردى والمروق","فعاثوا فسادا بدَوْس الحقوق",38,"ق",1,1],["تجبي المكوس وما أغنت جبايتها","عن الحجيج وما ردت لهم سلبا",39,"ب",2,0],["تجبَّرَ الْلَيْلُ واسْودَّتْ حَنَادِسُهُ","وما درى أنَّ جَيْشَ الصُّبْحِ يَقْفُوْهُ",40,"و",2,0],["تُجبي الزكاة إليها وهي تقبلها","لعلها تتزكى فالهوى يَصِم",41,"م",1,0],["٢٣- تجبّرْ تكبّرْ ولكنْ تذكّرْ","بأنّك تمضي لدنيا الزّوال",42,"ل",1,0],["تجبر ثم تكبر ثم جعل لعهودنا تبديد","منع للخير متعدي ونار الاثم ساعرها",43,"ر",3,0],["تجبرني العزه ولو قلبي /ذوى/ ماعاين لكف البخيل","يغنيني الله لو خفوقي /ماروي/ ماعنك ياصبري مجال",44,"ل",1,0],["تجبرني العزه ولو قلبي ذوى","ماعاين لكف البخيل",45,"ل",1,0]]}