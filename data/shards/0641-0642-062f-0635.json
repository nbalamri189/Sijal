{"poems":[[65,"خضاب على فودي للدهر ما نضا","https://www.aldiwan.net/poem46185.html","الطويل"],[57,"بكل طريق لي من الحب راصد","https://www.aldiwan.net/poem26059.html","الطويل"],[9,"ألم تروا إرما وعادا","https://www.aldiwan.net/poem21934.html","مجزوء البسيط"],[29,"عفا قو وكان لنا محلاً","https://www.aldiwan.net/poem4445.html","الوافر"],[39,"فقد صرت عما لها بالمشيب","https://www.aldiwan.net/poem7322.html","المتقارب"],[72,"أرحني منك حتى لا","https://www.aldiwan.net/poem42901.html","مجزوء الوافر"],[80,"تبدلت من عز ظل البنود","https://www.aldiwan.net/poem14213.html","المتقارب"],[91,"وقفت على المستنصرية باكيا","https://www.aldiwan.net/poem44962.html","الطويل"],[64,"إذا استيقظت نائبات الزمان","https://www.aldiwan.net/poem52277.html","المتقارب"],[47,"بقيت مسلما للمسلمينا","https://www.aldiwan.net/poem66692.html","الوافر"],[68,"لعمرك لا يغني الفتى طيب أصله","https://www.aldiwan.net/poem38579.html","الطويل"],[46,"يا من به يفتخر الفخر","https://www.aldiwan.net/poem30514.html","السريع"],[71,"تقول وخالطني الشيب لم","https://www.aldiwan.net/poem28182.html","المتقارب"],[54,"وما زال أخذ الموت أهلي وجيرتي","https://www.aldiwan.net/poem26897.html","الطويل"],[54,"تضمنت لي الحاج","https://www.aldiwan.net/poem27199.html","الهزج"],[77,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[50,"بكل طريق لي من الحب راصد","https://www.aldiwan.net/poem66102.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54928","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[111,"قد اهتزت الأكوان وارتعد الملا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66832&r=&rc=11",""],[139,"عرضت على ذات الدلال صبابتي","https://www.aldiwan.net/poem49193.html","الطويل"],[147,"سل المقادير ما أحببته تجب","https://www.aldiwan.net/poem11725.html","البسيط"],[154,"لعزك ذلت الأمم","https://www.aldiwan.net/poem68499.html","مجزوء الوافر"],[173,"طما بحر الهموم به فمادا","https://www.aldiwan.net/poem1620.html",""],[257,"أبى جلد أن أحمل البين والقلى","https://www.aldiwan.net/poem1415.html",""],[267,"ألم تريا أن الخليفة لزني","https://www.aldiwan.net/poem68211.html","الطويل"],[287,"سترت بياض شيبي بالخضاب","https://www.aldiwan.net/poem32860.html","الوافر"],[310,"على مثلها من أنعم يجب الشكر","https://www.aldiwan.net/poem56549.html","الطويل"],[369,"وصال الشمس يهدي الاحتراقا","https://www.aldiwan.net/poem60836.html","الوافر"],[409,"أجابت دموع العين وامتنع الصبر","https://www.aldiwan.net/poem33930.html","الطويل"],[422,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[443,"إذا شكرت زهر الرياض يد الحيا","https://www.aldiwan.net/poem2534.html","الطويل"],[445,"لتهنئ سلامتك المسلمينا","https://www.aldiwan.net/poem34797.html","المتقارب"],[458,"سواء حول لنكلن المعلى","https://www.aldiwan.net/poem61754.html","الوافر"],[463,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[469,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[543,"بربه في شؤونه ذو اعتصام","https://www.aldiwan.net/poem47985.html","عموديه"],[556,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[556,"عرفت الديار كسحق البرود","https://www.aldiwan.net/poem47805.html","المتقارب"],[556,"بياضك يا لون المشيب سواد","https://www.aldiwan.net/poem47875.html","الطويل"],[568,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[572,"وما زلت أبغي العلم من حيث يبتغى","https://www.aldiwan.net/poem69593.html","الطويل"],[580,"كتاب كريم جاءني بعد فترة","https://www.aldiwan.net/poem2721.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83338","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122621","الطويل"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102039","الطويل"],[724,"","https://poetry.dctabudhabi.ae/diwan/poem/107161","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66970","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67043","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48631","الطويل"],[889,"","https://poetry.dctabudhabi.ae/diwan/poem/205135","الهزج"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62497","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1194,"","https://poetry.dctabudhabi.ae/diwan/poem/206177","الخفيف"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117656","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127953","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49609","السريع"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101919","الطويل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177823","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28502","المتقارب"],[2329,"","https://poetry.dctabudhabi.ae/diwan/poem/32984","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120733","الطويل"],[2341,"","https://poetry.dctabudhabi.ae/diwan/poem/203849","الطويل"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18007","الوافر"],[2397,"","https://poetry.dctabudhabi.ae/diwan/poem/96172","الطويل"],[2753,"","https://poetry.dctabudhabi.ae/diwan/poem/20048","البسيط"],[2868,"","https://poetry.dctabudhabi.ae/diwan/poem/101949","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118791","المتقارب"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74201","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130067","الوافر"],[3272,"","https://poetry.dctabudhabi.ae/diwan/poem/143948","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62832","المتقارب"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86257","البسيط"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20877","الهزج"],[4167,"","https://poetry.dctabudhabi.ae/diwan/poem/202303","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28684","الهزج"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35140","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4578,"لولد لي الأنس بعيش رغيدْ","https://www.poetsgate.com/ViewPoem.aspx?id=49399",""],[4929,"ومن يرض في فقدِ الكرامةِ عِيشةً","https://www.poetsgate.com/ViewPoem.aspx?id=204153",""],[4930,"عيد المواجع","https://www.poetsgate.com/ViewPoem.aspx?id=213691",""],[4984,"يمر بي بعضهم","https://www.poetsgate.com/ViewPoem.aspx?id=176109",""],[5111,"أ..نَيلا","https://www.poetsgate.com/ViewPoem.aspx?id=212593",""],[5312,"الحكمُ للهِ كلٌّ غيرُه فاني","https://www.poetsgate.com/ViewPoem.aspx?id=128473",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[592,"تبصر نور الحق من كان يبصر","https://www.poetsgate.com/ViewPoem.aspx?id=128795",""],[5842,"أيها الساسة \\ محمد حسام الدين دو","https://www.poetsgate.com/ViewPoem.aspx?id=152165",""],[572,"ومازِلْتُ اَبغي العلمَ من حيثُ ينبغي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9391&r=&rc=248",""]],"verses":[["فقَدْ صارَ أمري والأمورُ لها مَدًى","إليكَ على رَغْمِ الأعادي مُفَوّضا",0,"ض",2,0],["فَقَد صِرتُ بَينَ البابِ وَالدارِ لَيسَ لي","مَقامٌ وَلا لي إِن خَرَجتُ أَمانُ",1,"ن",1,0],["فَقَد صَبَرنا وَلَم نُوَلِّ","وَلَيسَ مِن شَأنِنا الفِرارُ",2,"ر",1,0],["فَقَد صارَت حُماتُكُم إِماءً","وَحاميكُم بَني وَقبانَ قَينا",3,"ن",2,0],["فقد صرتُ عماً لها بالمشي","ب زولاً لديها هو الأزولْ",4,"ل",1,1],["فَقَد صِرتُ أَرى بُعدَ","كَ عَنّي الراحَةَ الكُبرى",5,"ر",2,0],["فَقَد صارَ ذاكَ وَذا أَدهَما","يَعُضُّ بِساقيَّ عَضَّ الأُسود",6,"د",1,0],["فقد صيروا للحفم بعضى مخازناً","وبعضي حوانيتاً وبعضي ملاهيا",7,"ي",2,0],["فقد صاحَ ذو الرعثاتِ الصدوح","وبشَّرنا بانحسارِ الظَّلامِ",8,"م",1,0],["فَقَد صَدَرَ الحَجيجُ وَهُم وُفودٌ","بِشُكرِكَ رائِحينَ وَمُغتَدينا",9,"ن",2,0],["فَقَد صَحَّ أَنَّ الخَمرَ رِجسٌ مُحَرَّمٌ","وَما شَكَّ خُلقٌ أَنَّهُ طَيِّبُ الأَصلِ",10,"ل",1,0],["فَقَد صَدَقتَ الظَنَّ في كُلِّ ما","رَجَوتُهُ إِذ كَذَبَ القَطرُ",11,"ر",1,0],["فقد صرتُ أبلق قالتْ أجل","وأبلقُ خيرٌ مِنَ الأسودِ",12,"د",1,0],["فَقَد صِرتُ مَحمولاً عَلى المَوتِ مُكرَهاً","وَإِن حُثَّتِ الكاساتُ طالَ لَها حَبسي",13,"ي",1,0],["فَقَد صِرتَ إِذا ما جِئ","تُ في الأَيّامِ حَجَّرتا",14,"ت",2,0],["فقد صارتِ الدنيا إليكم مصيرَها","وصار له الحمدُ المضاعَفُ والشكر",15,"ر",1,0],["فَقَد صِرتُ بَينَ البابِ وَالدارِ لَيسَ لي","خَلاصٌ وَلا لي إِن خَرَجتُ أَمانُ",16,"ن",1,0],["فقد صرح الأعلام من علمائنا","بما دونوا من كتبهم وتكلموا",17,"م",3,0],["فَقَدْ صَعِدَتْ نَفْسُ الأَمِيرَة فِي الضُّحَى","إِلى اللّه وَاسْتَوْدَعْتُمُ صَدَفَ الدُّرِ",18,"ر",1,0],["فَقَد صَدَقوا وَلكِن هُدَّ رُكني","فَمَن يَحمي وَأَعدائي تبيحُ",19,"ح",1,0],["فقد صدقت فيك الفراسة منهم","فما وقعت الا على الحق والجلا",20,"ل",2,0],["فقد صار خُلف الوعدِ بدعةَ معشرٍ","فإن كنتَ منهم فأخرَجنّ من الخدْرِ",21,"ر",1,0],["فَقَد صَفا لَكَ إِعلاناً وَمُعتَقَداً","مَن لَم يَزَل في طَريقِ الخِبِّ ذا خَبَبِ",22,"ب",1,0],["فقد صنعت له الأقدار","ما لا تصنع البهم",23,"م",1,0],["فَقَد صارَت شُهورُكِ مُذ تَوَلّى","رَبيعاً لا تُمرُّ بهِ جُمادى",24,"د",2,0],["فَقَد صَرَّحت حَولي المرابِعُ كُلُّها","فَلَو أَنَّ لي حَولاً بأن أَتَحوّلا",25,"ل",2,0],["فَقَد صَدَّني عَن مَسجِدٍ أستَلِذُّهُ","أُعَلّلُ فيه بالسَّمَاعِ وبالخَمرِ",26,"ر",1,0],["فَقَد صَدَّت شُموسُ الغيدِ عَني","صُدودَ الشَّمسِ عَن حالِ الشّهابِ",27,"ب",1,0],["فَقَد صارَ هَذا الأبلقُ الفردُ قصرهُ","فَريداً كبانيه البها قصرُ",28,"ر",1,0],["فقد صَدِئتْ قلوبُ النّاسِ غِشّاً","وقد صُقِلَتْ وجوهُهمُ نِفاقا",29,"ق",2,0],["فقد صار تعروني لمثواه عبرة","تسيل بها من مقلتي أدمع حمر",30,"ر",1,0],["فقد صُلْتَ حتَّى خافك الحتف نفسُهُ","وما استعْصمَ المفراق منك بعاصم",31,"م",1,0],["فقد صرت من حسن الضيقة منكمُ","أحبّك حتى كدت أن",32,"ا",2,0],["فقد صَدَّقَ اللهُ مَا يرغبونا","وَقَدْ حقَّقَ الله مَا يأْمَلُونا",33,"ن",2,0],["فقد صارت مجامرَ محرِقاتٍ","ودرباً للسجون وللمجون",34,"ن",1,0],["فقد صار يحبوني الذي ما سألتُهُ","ويَخطبُ منّي المدحَ مَن لا أجيبُهُ",35,"ب",2,0],["فقد صحبتْ بيضُ السيوف أكفَّهم","طويلاً فنابت بالفلول عن الشكر",36,"ر",1,0],["فَقَد صَيَّرتَني بِمَديحِ شِعري","أجُرُّ عليهِمُ فَضلَ الذُّيولِ",37,"ل",1,0],["فَقَد صاحَ قَبل البين لِي بفراقهمْ","غرابٌ على فرعِ الأراكةِ أبقعُ",38,"ع",1,0],["فَقَد صرنَ إمّا طوين السّنين","وإمّا وردن خفافا قصارا",39,"ر",2,0],["فقَد صِرتُ مَكروهاً على الشّيبِ بَعدَما","عَمِرْتُ وما عند المشيبِ أُرادُ",40,"د",1,0],["فَقَد صَحَّ مَوتُ المَكرماتِ بِمَوتِهِ","وَصَرَّحَ ناعيهِ وَلَوَّحَ ناعِبُه",41,"ب",2,0],["فَقَدْ صِرْتُ لا أَلْقَى الَّذِي اسْتَزِيْدُهُ","وَلاَ يُذْكَرُ الشَّيءُ الَّذِي لَسْتُ أَعْرِفُهْ",42,"ه",1,0],["فقد صِرْتُ عَبْدَ المُلْكِ مِنْ تَحْتِ سِرِّه","وإِلاَّ فَرَبّ المُلْكِ فَوْقَ سُرِيره",43,"ر",2,0],["فَقَد صارَ يَأتي عَلَيهِ الَّذي","جَناهُ وَيَعنو لَهُ حاضِرُ",44,"ر",1,0],["فَقد صِرتُمُ لي مَوئِلاً دُونَ مَوئِلي","وأصَبحتُمُ لي مَعشراً دُونَ مَعشري",45,"ر",2,0],["فقد صحبتني في الدجى وصحبتها","لزاماً على نائي وبعد مزار",46,"ر",1,0],["فقَد صارَ صَبّاً في هَواهُ مُوَلَّعاً","وَيَسألُ رَبَّ الناسِ ذا العَرشِ يَرعَاهُ",47,"ا",2,0],["فقد صَاكَ مِنْ فَضْلِ العَوَالِمِ طِيبُهُ","وهل يَكْتُمُ المِسْكَ الذَّكِيَّ نَوَافِجُ",48,"ج",1,0],["فقد صاد ليث الغاب ظبي كنيسة","فأعجب به ليثا وأعجب به ظبيا",49,"ي",2,0],["فقد صار معناها لقلبي آيةً","يذوب لذكراها جوى وتوجُّعا",50,"ع",2,0],["فقد صار بها أشه","ر من رابة بيطار",51,"ر",1,0],["فقد صارت نواحي","مسقط تهتز بالتيه",52,"ي",2,0],["فقد صرت بالإمداح فيك مشخصا","أنادي به في كل ناد وجامع",53,"ع",1,0],["فقد صدق في الأماكن حتى","وصفه اليوم ما عليه دليل",54,"ل",1,0],["فقد صار لما حقق العجز كلما","تراءت له زهرُ النجومِ تلونا",55,"ن",2,0],["فقد صار مدحى فيه سكرى مصجا","ومغتبقالا من كؤس مدامى",56,"م",2,0],["فقد صفا عيشُكَ فانْعَمْ به","فهو متاعٌ لا إلى حين",57,"ن",1,0],["فقد صح أن لخمر والريق واحد","ويرمي الذي ثناهما التوهم",58,"م",1,0],["فقد صديت منا قلوب لبعده","تقاعدها في الحب عن قربه صدا",59,"د",2,0],["فَقَد صارَ لي فيهِما عادَة","تُعَلِّمُ نَومِيَ أَن يَشرُدا",60,"د",2,0],["فَقَد صَيَّقوا الدُنيا عَلَينا بِرُحبِها","وَقَد تَرَكونا لا نَقَرُّ مِنَ الذُعرِ",61,"ر",1,0],["فقد صدَّعت شملي وأصمت مَقاتلي","وقد هَدَّمت رُكنِي الوثيقَ المُؤَسَّسا",62,"س",2,0],["فقد صار قلبي للصباب