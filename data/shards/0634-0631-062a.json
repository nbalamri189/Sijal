{"poems":[[55,"يا مسقط العلمين من رمل الحمى","https://www.aldiwan.net/poem29736.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54244","الكامل"],[92,"سيصدني وأصده","https://www.poetsgate.com/ViewPoem.aspx?id=179085",""],[409,"ما على الصب في الصبابة وصمه","https://www.aldiwan.net/poem33405.html","الخفيف"],[509,"أراك ترى حالي وما تترحم","https://www.aldiwan.net/poem38409.html","الطويل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199620","المسحوب"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216725",""],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216548",""],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216539",""],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132153","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132121","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81252","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72459","الكامل"]],"verses":[["شَرَتِ الفُؤادَ رَخيصَةً أَعلاقُهُ","وَمضى يَعَضُّ بَنانَهُ المَغبونُ",0,"ن",1,0],["شَرَتِ المكارمَ حُلوةً بجهادها","مُرا فكان الحمدُ من أرباحها",1,"ح",3,0],["شرٌ تمادى حَدُّهُ","سيصُدني واصُدُّهُ",2,"د",2,1],["شرت الغي بالهداء وباعت","نور إيمانها ظلم وظلمه",3,"م",2,0],["شرت الديك الهم عدت معانداً","فيا ليتني في معرض الهم ابكم",4,"م",1,0],["شرتاك شلْ حْجابه","والغيم نثرتيه",5,"ي",2,0],["شرتاً مَ اطيَب نشرها","يتخللها كنيفْ",6,"ف",1,1],["شَرْتا الصبا وانْ هَبْ ذَنّانْ","يْذَكِّر القلب مَحْبُوبه",7,"ب",2,1],["شَرْتا الصّبا بْعِطْرَهْ تْذَهَّبْ","بالمسكْ والريحان والهال",8,"ل",1,0],["شرتون شاكية والعين باكية","والدير ثكلى وبيت الدين في كرب",9,"ب",1,0],["شرتون مجلى النابغين تحيةً","لا أنتِ أنت ولا بنوك بنوكِ",10,"ك",1,1],["شَرَتهُ في صِباي مِن وَضح الفَج","ر وَمَن بهرج الضُحى وَخِداعه",11,"ع",2,0],["شرَّتم الحسب الذي","كنتم له نسبا وصهرا",12,"ر",2,0]]}