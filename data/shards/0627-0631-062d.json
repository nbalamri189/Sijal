{"poems":[[53,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[63,"رنت إلي وظل النقع ممدود","https://www.aldiwan.net/poem46194.html","البسيط"],[57,"ارحل بنفسك من أرض تضام بها","https://www.aldiwan.net/poem24664.html","البسيط"],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.aldiwan.net/poem35921.html","البسيط"],[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[86,"ارحمونا بني اليهود كفاكم","https://www.aldiwan.net/poem10952.html","الخفيف"],[93,"ألحب روح أنت معناه","https://www.aldiwan.net/poem11114.html","أحذ الكامل"],[93,"أبقى ويرفض حولي عقد خلاني","https://www.aldiwan.net/poem11271.html","البسيط"],[30,"ألا يا اسلمي يا دار مي على البلي","https://www.aldiwan.net/poem29589.html","الطويل"],[47,"يا حسرة ما أكاد أحملها","https://www.aldiwan.net/poem25170.html","المنسرح"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[70,"أرحني منك حتى لا","https://www.aldiwan.net/poem42901.html","مجزوء الوافر"],[78,"قيدي أما تعلمني مسلما","https://www.aldiwan.net/poem14224.html","السريع"],[32,"ارحميني فقد بليت فحسبي","https://www.aldiwan.net/poem27753.html","الخفيف"],[89,"اذكري إذ كنا صغيرين نلعب","https://www.aldiwan.net/poem44865.html","الخفيف"],[89,"تأن في الظلم تخفيفا وتهوينا","https://www.aldiwan.net/poem44960.html","البسيط"],[89,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[89,"فيك المدائح تحلو","https://www.aldiwan.net/poem44969.html","المجتث"],[85,"يا حماة الطفل خير المحسنين","https://www.aldiwan.net/poem7137.html","الرمل"],[85,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[56,"ألا إسقنيها صاحبي وخليلي","https://www.aldiwan.net/poem58523.html","الطويل"],[56,"ارحم اليوم ذلتي وخضوعي","https://www.aldiwan.net/poem58524.html","الخفيف"],[45,"وقوفك في أطلالهم وسؤالها","https://www.aldiwan.net/poem65564.html","الكامل"],[28,"سما لك شوق من نوار ودونها","https://www.aldiwan.net/poem1233.html",""],[69,"أرح النفس قليلا","https://www.aldiwan.net/poem28876.html","مجزوء الرمل"],[90,"أرح ركابك من أين ومن عثر","https://www.aldiwan.net/poem60154.html","عموديه"],[31,"إرحمينا يا نعم مما لقينا","https://www.aldiwan.net/poem41278.html","الخفيف"],[105,"كذلك يشقى الجامح المتعسف","https://www.aldiwan.net/poem44190.html","الطويل"],[52,"يا غصنا إن هزه مشيه","https://www.aldiwan.net/poem26660.html","السريع"],[52,"يا ناظرا أودع قلبي الهوى","https://www.aldiwan.net/poem27313.html","الرجز"],[48,"وخمار حططت إليه رحلي","https://www.aldiwan.net/poem64502.html","الوافر"],[50,"أبا أحمد طال انتظاري ثلاثة","https://www.aldiwan.net/poem62214.html","الطويل"],[50,"طال انتظاري عهد أباء","https://www.aldiwan.net/poem64889.html","السريع"],[46,"إن كنت ذارع أرض لم ألمك بها","https://www.aldiwan.net/poem23104.html","البسيط"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85563","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85728","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140826",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16658","البسيط"],[71,"","https://poetry.dctabudhabi.ae/diwan/poem/29245","الوافر"],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=34208",""],[11,"أبَى طُولُ لَيلِكَ إلاّ سُهُودا","https://www.poetsgate.com/ViewPoem.aspx?id=16841",""],[45,"وُقُوفُكَ في أطْلاَلِهِمْ، وَسُؤالُهَا","https://www.poetsgate.com/ViewPoem.aspx?id=32197",""],[45,"أفي كُلّ دارٍ مِنكَ عَينٌ تَرَقْرَقُ","https://www.poetsgate.com/ViewPoem.aspx?id=32846",""]],"verses":[["أَرِحنا نُرِح وَتَراتِ المَطِيِّ","فَإِنَّ بِها ما بِنا مِن أَلَم",0,"م",1,0],["أرَحْتُمُ النَّعَمَ المَشلولَ عازِبُهُ","وقَدْ تكنَّفَهُ القَوْمُ الرّعاديدُ",1,"د",1,0],["اِرحَل بِنَفسِكَ مِن أَرضٍ تُضامُ بِها","وَلا تَكُن مِن فِراقِ الأَهلِ في حُرَقِ",2,"ق",1,1],["أرِحْ رِكابَك قد أوْرَدْتَ في نهَلٍ","وقدْ ظفِرْتَ بحبْلِ اللهِ فاعْتلِقِ",3,"ق",1,0],["أَرَحنا نُباكِرُ جِدَّ الصَبو","حِ قَبلَ النُفوسِ وَحَسّادِها",4,"د",3,0],["اِرحَمونا بَني اليَهودِ كَفاكُم","ما جَمَعتُم بِحِذقِكُم مِن نُقودِ",5,"د",1,1],["إِرْحَمْ فؤاداً فِي هَوَاكَ غدا","مَضْنًى وَحُمَّاهُ حُميَّاهُ",6,"ا",2,0],["إِرْحَمْ مُحِبِّيكَ يَا مَنْ كُنْتَ أَرْحَمَهُمْ","لَكِنْ هَجَرْتَ وَلَمْ تَعْمَدْ لِهِجْرَانِ",7,"ن",1,0],["أَرِحمٌ جَرَت بِالودِّ بَينَ نِسائكم","وَبَينَ اِبنِ حَوطٍ يا اِمرَأَ القَيسِ أَم صِهرُ",8,"ر",1,0],["أَرحامُنا مِنكَ لِم تُقَطِّعُها","وَلَم تَزَل دائِباً تُوَصِّلُها",9,"ل",3,0],["أرحْتُ عليه حلمَهُ وهْو عازبٌ","وقوَّمت منه درْأهُ وهو أصعَر",10,"ر",1,0],["أَرِحني مِنكَ حَتّى لا","أَرى مَنظَرَكَ الوَعرا",11,"ر",2,1],["اِرحَم طُفَيلاً طائِشاً لُبّهُ","لَم يَخشَ أَن يأتيكَ مُستَرحِما",12,"م",2,0],["اِرحَميني فَقَد بَليتُ فَحَسبي","بَعضُ ذا الداءِ يا بُثَينَةُ حَسبي",13,"ب",2,1],["ارحميني فانني لست اسطيع","على برح البين ان اتغلب",14,"ب",1,0],["ارحم قلوباً لأقوامٍ إذا عطشت","للعدل يوماً سقاها الظلم غِسلينا",15,"ن",2,0],["أرحها فما أبقيت إلا حُشاشة","بها حكمها عما قريب سيبطل",16,"ل",1,0],["ارحم فديتك فخرى","خصما به زلّ نعل",17,"ل",1,0],["ارحم الحساد واغفر للعدا","أنت عند الله والشعب مكين",18,"ن",1,0],["أَرَحتَ بالَك مِن دُنيا بِلا خُلُقٍ","أَلَيسَ في المَوتِ أَقصى راحَةَ البالِ",19,"ل",1,0],["أَرحْنا نُباكِر شُرْبَها ذَهَبِيّةً","بِذي شَبمٍ نائي المرامِ نَبيلِ",20,"ل",1,0],["اِرْحَمِ اليومَ ذلَّتي وَخُضُوعي","فلَقَدْ صِرْتُ ناحِلاً كالخلالِ",21,"ل",1,1],["أَرِحنا بِتَسيِيرِ المَطايا فَإِنَّها","صَريمَةُ عَزمٍ حُلَّ عَنها عِقالُها",22,"ل",3,0],["أَرِحني أَبا عَبدِ المَليكِ فَما أَرى","شِفاءً مِنَ الحاجاتِ دونَ قَضائِها",23,"ا",3,0],["أرِحِ النفسَ قليلاً","كمْ كذا قالاً وقيلا",24,"ل",2,1],["أرح ركابكَ من أينٍ ومن عثَرِ","كفاك جيلانِ محمولاً على خطر ِ",25,"ر",1,1],["إِرحَمينا يا نُعمُ مِمّا لَقينا","وَصِلينا فَأَنعُمي أَو دَعينا",26,"ن",2,1],["أرِحْنِي أرحني يا ابنَ قيسٍ بضربةٍ","تبيتُ لها نفسي تَرِفُّ وتَنطِفُ",27,"ف",1,0],["إِرحَم مَليكاً صارَ مُستَعبَداً","قَد ذَلَّ في حُبِّكَ سُلطانُه",28,"ه",1,0],["إِرحَم مُحِبّاً عادَ في غَيِّهِ","مِن بَعدِ ما قيلَ صَحا وَاِرعَوى",29,"و",2,0],["أَرِحني قَد تَرَفَّعَتِ الثُرَيّا","وَغالَت جُنحَ لَيلي عَنكَ غولُ",30,"ل",1,0],["أَرِحني بِيَأسٍ أَو بِتَعجيلِ حاجَةٍ","وَأَيتَ بِها لَيسَ النَدى بِمُحَرَّمِ",31,"م",1,0],["أَرُحتِ في الرائِحِ يَومَ اللِوى","لا تَبعُدي يابِنتَ وَرقاءِ",32,"ا",2,0],["أَرِح جَمالَكَ مِن غَرَضٍ وَمِن قَتبٍ","وَاِجعَل ظَلامَكَ في نَيلِ العُلا جَمَلَك",33,"ك",1,0],["أَرَحنَا مَعَدّاً مِن شَرَاحِيلَ بَعدَمَا","أَرَاهُم مَعَ الصُبحِ الكَواكِبَ مُظهِرا",34,"ر",2,0],["أَرَحنا مَعدّاً مِن شَراحيلَ بَعدَما","أَرَاها مَعَ الصُبحِ الكَواكِبَ مُظهِرا",35,"ر",2,0],["ارحل إذا ما اسطعت عَن متوطن","ما إِن به غير العظام عظام",36,"م",1,0],["ارحميني فإنني","لانتحار محاولُ",37,"ل",1,1],["ارحم شباب فتىً أودت بجدته","يد البلى وذوي في السجن ناضره",38,"ر",2,0],["إرحلي الآن لا ينل قدميكِ","دنَسٌ من غبارِ هذا الطريق",39,"ق",1,0],["أرَحْتِني فأرحْتُ الضُّمَّرَ القُودا","والعَجْزَ كان طِلابي عندكِ الجُودا",40,"د",2,1],["أَرِح مِن نَزحِ ماءِ البرجِ يَوماً","فَقَد أَفضى إِلى تَعَبٍ وَعي",41,"ي",1,1],["أرح ركابك فقد أوردت في نهل","وقد ظفرت بحبل الله فاعتلق",42,"ق",1,0],["أرحي فواضلَ ذي بهجة ،","منالناس، يجمع حزماً وجودا",43,"د",2,0],["أرِحْنا بتَيْسِيرِ المَطَايَا، فإنّها","صَرِيمَةُ عَزْمٍ حُلّ عَنْهَا عِقَالُها",44,"ل",3,0],["أرَحْنَ عَلَيْنَا اللّيلَ، وَهوَ مُمسَّكٌ،","وَصَبّحَنَا بالصّبحِ وَهْوَ مُخَلَّقُ",45,"ق",1,0]]}