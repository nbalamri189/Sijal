"وجودك غادر النعمى معينا","https://www.aldiwan.net/poem3274.html","عموديه"],[462,"أرحها فقد ضاقت بها سعة المدى","https://www.aldiwan.net/poem3600.html","عموديه"],[466,"أرحب بالضيف والمجتدي","https://www.aldiwan.net/poem60255.html","المتقارب"],[477,"أطلق الشوق دمعتي","https://www.aldiwan.net/poem37067.html","مجزوء الخفيف"],[498,"آه من نار فؤآده لم يزل","https://www.aldiwan.net/poem37673.html","الرمل"],[498,"أرح فؤادك من هم الوجودات","https://www.aldiwan.net/poem37713.html","البسيط"],[498,"أطلع الحسن من سناك هلالا","https://www.aldiwan.net/poem37730.html","الخفيف"],[498,"لي قلب في الحب مضنى عليل","https://www.aldiwan.net/poem37927.html","الخفيف"],[513,"قل للمنية شوى","https://www.aldiwan.net/poem12003.html","مجزوء الكامل"],[527,"أهوى الذي يهوى فإن عن ما","https://www.aldiwan.net/poem37079.html","السريع"],[527,"رعايا اليمن الميمون","https://www.aldiwan.net/poem37340.html","مجزوء الوافر"],[527,"ألا هكذا من يروم الفخارا","https://www.aldiwan.net/poem37413.html","المتقارب"],[536,"كلما تهت دلالا","https://www.aldiwan.net/poem47979.html","عموديه"],[536,"في بذلة النوم قد تبدى","https://www.aldiwan.net/poem48249.html","عموديه"],[557,"حرك الوجد في هواكم سكوني","https://www.aldiwan.net/poem69337.html","الخفيف"],[573,"أرح مسمعي من ذكر من لا أحبه","https://www.aldiwan.net/poem2694.html","الطويل"],[584,"أرح يمينك مما أنت معتقل","https://www.aldiwan.net/poem17644.html","البسيط"]],"verses":[["أَرِحنا نُرِح وَتَراتِ المَطِيِّ","فَإِنَّ بِها ما بِنا مِن أَلَم",0,"م",1,0],["أرَحْتُمُ النَّعَمَ المَشلولَ عازِبُهُ","وقَدْ تكنَّفَهُ القَوْمُ الرّعاديدُ",1,"د",1,0],["اِرحَل بِنَفسِكَ مِن أَرضٍ تُضامُ بِها","وَلا تَكُن مِن فِراقِ الأَهلِ في حُرَقِ",2,"ق",1,1],["أرِحْ رِكابَك قد أوْرَدْتَ في نهَلٍ","وقدْ ظفِرْتَ بحبْلِ اللهِ فاعْتلِقِ",3,"ق",1,0],["أَرَحنا نُباكِرُ جِدَّ الصَبو","حِ قَبلَ النُفوسِ وَحَسّادِها",4,"د",3,0],["اِرحَمونا بَني اليَهودِ كَفاكُم","ما جَمَعتُم بِحِذقِكُم مِن نُقودِ",5,"د",1,1],["إِرْحَمْ فؤاداً فِي هَوَاكَ غدا","مَضْنًى وَحُمَّاهُ حُميَّاهُ",6,"ا",2,0],["إِرْحَمْ مُحِبِّيكَ يَا مَنْ كُنْتَ أَرْحَمَهُمْ","لَكِنْ هَجَرْتَ وَلَمْ تَعْمَدْ لِهِجْرَانِ",7,"ن",1,0],["أَرِحمٌ جَرَت بِالودِّ بَينَ نِسائكم","وَبَينَ اِبنِ حَوطٍ يا اِمرَأَ القَيسِ أَم صِهرُ",8,"ر",1,0],["أَرحامُنا مِنكَ لِم تُقَطِّعُها","وَلَم تَزَل دائِباً تُوَصِّلُها",9,"ل",3,0],["أرحْتُ عليه حلمَهُ وهْو عازبٌ","وقوَّمت منه درْأهُ وهو أصعَر",10,"ر",1,0],["أَرِحني مِنكَ حَتّى لا","أَرى مَنظَرَكَ الوَعرا",11,"ر",2,1],["اِرحَم طُفَيلاً طائِشاً لُبّهُ","لَم يَخشَ أَن يأتيكَ مُستَرحِما",12,"م",2,0],["اِرحَميني فَقَد بَليتُ فَحَسبي","بَعضُ ذا الداءِ يا بُثَينَةُ حَسبي",13,"ب",2,1],["ارحميني فانني لست اسطيع","على برح البين ان اتغلب",14,"ب",1,0],["ارحم قلوباً لأقوامٍ إذا عطشت","للعدل يوماً سقاها الظلم غِسلينا",15,"ن",2,0],["أرحها فما أبقيت إلا حُشاشة","بها حكمها عما قريب سيبطل",16,"ل",1,0],["ارحم فديتك فخرى","خصما به زلّ نعل",17,"ل",1,0],["ارحم الحساد واغفر للعدا","أنت عند الله والشعب مكين",18,"ن",1,0],["أَرَحتَ بالَك مِن دُنيا بِلا خُلُقٍ","أَلَيسَ في المَوتِ أَقصى راحَةَ البالِ",19,"ل",1,0],["أَرحْنا نُباكِر شُرْبَها ذَهَبِيّةً","بِذي شَبمٍ نائي المرامِ نَبيلِ",20,"ل",1,0],["اِرْحَمِ اليومَ ذلَّتي وَخُضُوعي","فلَقَدْ صِرْتُ ناحِلاً كالخلالِ",21,"ل",1,1],["أَرِحنا بِتَسيِيرِ المَطايا فَإِنَّها","صَريمَةُ عَزمٍ حُلَّ عَنها عِقالُها",22,"ل",3,0],["أَرِحني أَبا عَبدِ المَليكِ فَما أَرى","شِفاءً مِنَ الحاجاتِ دونَ قَضائِها",23,"ا",3,0],["أرِحِ النفسَ قليلاً","كمْ كذا قالاً وقيلا",24,"ل",2,1],["أرح ركابكَ من أينٍ ومن عثَرِ","كفاك جيلانِ محمولاً على خطر ِ",25,"ر",1,1],["إِرحَمينا يا نُعمُ مِمّا لَقينا","وَصِلينا فَأَنعُمي أَو دَعينا",26,"ن",2,1],["أرِحْنِي أرحني يا ابنَ قيسٍ بضربةٍ","تبيتُ لها نفسي تَرِفُّ وتَنطِفُ",27,"ف",1,0],["إِرحَم مَليكاً صارَ مُستَعبَداً","قَد ذَلَّ في حُبِّكَ سُلطانُه",28,"ه",1,0],["إِرحَم مُحِبّاً عادَ في غَيِّهِ","مِن بَعدِ ما قيلَ صَحا وَاِرعَوى",29,"و",2,0],["أَرِحني قَد تَرَفَّعَتِ الثُرَيّا","وَغالَت جُنحَ لَيلي عَنكَ غولُ",30,"ل",1,0],["أَرِحني بِيَأسٍ أَو بِتَعجيلِ حاجَةٍ","وَأَيتَ بِها لَيسَ النَدى بِمُحَرَّمِ",31,"م",1,0],["أَرُحتِ في الرائِحِ يَومَ اللِوى","لا تَبعُدي يابِنتَ وَرقاءِ",32,"ا",2,0],["أَرِح جَمالَكَ مِن غَرَضٍ وَمِن قَتبٍ","وَاِجعَل ظَلامَكَ في نَيلِ العُلا جَمَلَك",33,"ك",1,0],["أَرَحنَا مَعَدّاً مِن شَرَاحِيلَ بَعدَمَا","أَرَاهُم مَعَ الصُبحِ الكَواكِبَ مُظهِرا",34,"ر",2,0],["أَرَحنا مَعدّاً مِن شَراحيلَ بَعدَما","أَرَاها مَعَ الصُبحِ الكَواكِبَ مُظهِرا",35,"ر",2,0],["ارحل إذا ما اسطعت عَن متوطن","ما إِن به غير العظام عظام",36,"م",1,0],["ارحميني فإنني","لانتحار محاولُ",37,"ل",1,1],["ارحم شباب فتىً أودت بجدته","يد البلى وذوي في السجن ناضره",38,"ر",2,0],["إرحلي الآن لا ينل قدميكِ","دنَسٌ من غبارِ هذا الطريق",39,"ق",1,0],["أرَحْتِني فأرحْتُ الضُّمَّرَ القُودا","والعَجْزَ كان طِلابي عندكِ الجُودا",40,"د",2,1],["أَرِح مِن نَزحِ ماءِ البرجِ يَوماً","فَقَد أَفضى إِلى تَعَبٍ وَعي",41,"ي",1,1],["أرح ركابك فقد أوردت في نهل","وقد ظفرت بحبل الله فاعتلق",42,"ق",1,0],["أرحي فواضلَ ذي بهجة ،","منالناس، يجمع حزماً وجودا",43,"د",2,0],["أرِحْنا بتَيْسِيرِ المَطَايَا، فإنّها","صَرِيمَةُ عَزْمٍ حُلّ عَنْهَا عِقَالُها",44,"ل",3,0],["أرَحْنَ عَلَيْنَا اللّيلَ، وَهوَ مُمسَّكٌ،","وَصَبّحَنَا بالصّبحِ وَهْوَ مُخَلَّقُ",45,"ق",1,0],["أَرح مَطايا الأَماني وَاِترُك الطَلَبا","لَم يَبقَ في العُمر شَيءٌ يوجب التَعَبا",46,"ب",2,1],["ارحم قصير رقاد ذا ال","ولهان في الليل الطويل",47,"ل",1,0],["ارحم الدمع الذي","منه اذا ما شئت تغرف",48,"ف",1,0],["ارحم عشيرك يا حبب","با حسنه فتن العشائر",49,"ر",1,0],["ارحم دموعا عندها","خجل السحاب الماطر",50,"ر",1,0],["أرحْ فؤادكَ مما أنتَ لاقيهِ","وباعد القلبَ عن كدٍّ يعانيهِ",51,"ي",2,1],["أرِحْ بنانَك من حُسبانِ سؤدده","إن الكواكبَ لا تُحصَى بأعدادِ",52,"د",1,0],["أَرِحْها قليلاً كي تَقَرَّ فَإِنَّها","من الضَّرب أَمستْ ناحِلاتِ المضاربِ",53,"ب",1,0],["ارحنى ارحني يا عذول فمسمعي","به عن مقالات ترددها وقر",54,"ر",1,0],["ارحم فؤاد محب أنت ساكنه","أمست تقلبه الاهوى على الضرم",55,"م",1,0],["أَرحامُنا مِن يَومِ غُيِّبَ جَدُّكُم","في رَمسِهِ مَقطُوعَةٌ لَم تُوصَلِ",56,"ل",1,0],["أَرَحْتَ ملوكَ المسلمين بعَزْمةٍ","يجاهد كلٌّ حولَها وهْو وادِع",57,"ع",1,0],["ارحم الناس جميعا","فهم أبناء جنسك",58,"ك",1,0],["ارحم فقيراً غريبا أحنفا قعدت","به الزمانة عن كسب ومحترف",59,"ف",1,0],["أرحت قلبي وعشت وحدي","بلا اختلاط ولا مساس",60,"س",1,0],["اِرحَم فَتىً مُدنَفاً ما إِن يُخَلّصُه","مِن غَمرَةِ العِشقِ إِلّا أَنتَ وَاللَهُ",61,"ه",1,0],["ارحم فديتُك عاشقاً","قد صار للبلوى هَدَف",62,"ف",1,0],["ارحم عليلاً أنت أسقمتَه","والوصف عن حالته يقصرْ",63,"ر",1,1],["أَرح قَلبَك الخَفّاقِ من شَقوَةِ الهَوى","فَكُلُّ هوىً بُؤسُ الحَياةِ يراوِحُه",64,"ه",1,1],["إِرحل لمصرَ فَقُلت في","نَفسي لَهُم لِلَّهِ مصرُ",65,"ر",1,0],["إرحم يا سيد الملاح","مغرم ضناه البعاد",66,"د",1,0],["أَرحامَهُمْ قَطَّعوا وَحَدَّهُمُ","فَلُّوا وأَزوارَ قَوْمِهمْ حَمَلوا",67,"ل",3,0],["أَرِحها تُمَتِّع مِن تِهامَةَ طَرفِها","فَقَد حَلَفَت أَلا تَعودَ تَراها",68,"ا",3,0],["أَرحَم فَدَيتُكَ مَن لَهُ","جَسَدٌ بِحُبِّكَ قَد ضَني",69,"ي",1,0],["أَرحَلُ كَالبومِ لَيسَ فيهِ","خَيرٌ كَثيرٌ وَلا قَليلُ",70,"ل",1,0],["إِرْحَمُوا عَبْداً أَتَاكُمْ","يَا مَوَالِينَا",71,"ن",2,1],["أرحني أرحني من تحمّل بأسها","ومن روعها فالخوف عندي مطوّلُ",72,"ل",1,0],["ارحموا ضعفي فقر اثقلتُ","ظهري وتليلي",73,"ي",1,0],["إِرحَم بُكاءَ الراووقِ في الظُلمِ","بِأَدمُعٍ مِثلِ واكِفِ الدّيَمِ",74,"م",1,1],["أَرَحَلتَ مِن سَلمى بِغَيرِ مَتاعِ","قَبلَ العُطاسِ وَرُعتَها بِوَداعِ",75,"ع",1,1],["اِرحَمه من عبرات فيك واكفةٍ","ومهجة بغليل الوَجدِ لاهفة",76,"ه",1,0],["أرحت سرى من هموم امريءِ","ما اضطرني قط له الوقت",77,"ت",1,1],["أرح آكلا أو نائما او مصليا","ومشتغلا أيضا ولو عبدك الجاني",78,"ن",2,0],["أرح الركاب فقد ظفرت بواهب","يعطي عطاء المنعمين فيجزل",79,"ل",1,0],["أرح الركاب ففي الصبا نبأ","يغني عن المستنة الجرد",80,"د",1,0],["أَرحِبُها أَذرُعاً وَأَصبِرُها","صَبراً إِذا القَومُ في الوَغى كَلَحوا",81,"ح",3,0],["أرح طائر السجن من شقوته","فلن تنتهي قبل أن تنتهي",82,"ي",1,0],["أَرَحْتُكَ واستَرَحْتُ مِن المَلامِ","وَمِن عَذْلٍ يُطِيلُ مَدَى الكَلامِ",83,"م",1,1],["اِرحَم عَليل أَسىً كُنت المحكّم في","إِتلاف مُهجَتِهِ طَوعاً وَلا حَرَجا",84,"ج",2,0],["أَرِحِ المنائحَ والمدائحَ ساعةً","من طُولِ مَمضىً في الأنام ومَرْجِع",85,"ع",1,0],["أرحْتُ إلى فِكْري من الشِّعْرِ عازباً","وغَيْري الّذي إنْ يُنْتِج القولَ يُخْدِج",86,"ج",1,0],["أرحتُ القَوافي إلى مَدحِها","لما باتَ يَعشَقُها يوشَعُ",87,"ع",1,0],["أرحنا يا بلالُ بها أرحن","فديتك يا ختام المرسلينا",88,"ن",2,0],["أرح يا صاحبي عقلاً وقلب","فحبل الدين في قلبي وثيق",89,"ق",1,0],["أرحني من كأس بفلس منجر","فما قهوتي عن تناسب إكرامي",90,"ي",1,1],["اِرحَمْ ذَوي النَّقصِ في عُقولِهِم","يَزِدْكَ مِمَّا أفادَكَ اللهُ",91,"ه",1,0],["أَرحَت نَفسي مِن عداة الملاح","لِليأسِ روح مِثلِ روحِ النَجاح",92,"ح",1,1],["ارحم قتيل جفاء","فأنت للَه شاكر",93,"ر",1,0],["أرحِ المطيّةَ برهةً يا حادي","قد كلَّ هاديها من الإسآدِ",94,"د",1,1],["أَرْحليَ مَحمولٌ عَلَى العُتُقِ النُّجْبِ","يَؤْمُّكَ أَم سارٍ عَلَى القُتُمِ النُّكبِ",95,"ب",1,1],["أرِحْها ونَمْ عن كلِّ هَمٍّ بنجْوةٍ","فليلك مُنْجابٌ وصبحكَ باهِرُ",96,"ر",1,0],["أرحها فأرباب العلوم جميعهم","نجومٌ وهذا مصرع القمر التم",97,"م",1,0],["أرحنا في ذراك العيس حيناً","فلا نسعاً حجراً وطينا",98,"ن",2,0],["أرحنا في ذراك العيس حيناً","فلا نسعاً نشد ولا وضينا",98,"ن",2,0],["أرحها فقد ضاقت بها سعةُ المدى","وأيهاً فمن أصواتها نغمُ الحدا",99,"د",2,1],["أُرَحِّبُ بِالضَيفِ وَالمُجتَدي","وَأَضحَكُ في وَجهِ مُستَرفِدي",100,"د",2,1],["ارحمي العاشق ارحمي","عبدك المستهام قط",101,"ط",1,0],["إرحموه فهو والوبل الذي","قد جرى من مقلتي يستبقُ",102,"ق",1,0],["أرح فؤادك من هم الوجودات","وارجع إلى اللَه عن ماضٍ وعن آت",103,"ت",1,1],["ارْحَمِ الخاشِعينَ فالقَلْبُ منهُمْ","طائرٌ والجُسومُ صارتْ خَيالا",104,"ل",2,0],["إرْحَموا يا أَكابِرَ الحيِّ عَبداً","مستَمِرًّا بُكاؤُهُ والعَويلُ",105,"ل",1,0],["ارحم كئيباً هائماً","ثكلان منهد القوى",106,"ا",1,0],["أَرْحَلُ إنْ يَرْحَلُ حَتَّى غَدَا","نِضْوِيَ مِنْ ضَرْبي لَهُ قارِها",107,"ر",3,0],["أَرِحْ خَلْفَكَ مِنْ جَوْرٍ","وَمِنْ خَوْفٍ وإفْزاعِ",108,"ع",1,0],["أَرَحْتَ الْعِبادَ عَمَرْت الْبِلادَ","أَبَدْتَ الْعِنادَ أَزَحْتَ الضّرارا",109,"ر",2,0],["إرحَمِ الصَّبَّ المُعَنَّى","فيكَ وامنَحهُ وِصالا",110,"ل",2,0],["إرحَم مُحِبا لكم وَلُوعا","خافَ على سِرِّه افتِضَاحا",111,"ح",2,0],["ارحموا من قضى جَوى في هَواكم","وقِفوا عند رَوْضتي بالحجونِ",112,"ن",1,0],["أَرحْ مِسْمَعي من ذكرِ مَنْ لاَ أُحِبُّه","ولا تكسبي آثام غَيْبتِه لَعْنا",113,"ن",2,1],["أَرِحْ يَمِينَكَ مِمَّا أَنْتَ مُعْتَقِلُ","أَمْضَى الأَسِنَّةِ ما فُولاذُهُ الكَحَلُ",114,"ل",1,1]]}