{"poems":[[73,"جعل العتاب إلى الصدود توصلا","https://www.aldiwan.net/poem4030.html","الكامل"],[90,"كم قد لبست بها الضحا من روضة","https://www.aldiwan.net/poem44440.html","الكامل"],[99,"ملكي ومحرابي وقد","https://www.aldiwan.net/poem24866.html","مجزوء الكامل"],[46,"أقشيب ربعهم أراك دريسا","https://www.aldiwan.net/poem30481.html","الكامل"],[22,"فلست بمحبو ولا جد مكرم","https://www.aldiwan.net/poem21706.html","الطويل"],[73,"جعل العتاب الى الصدود توصٌّلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=28014&r=&rc=1",""],[154,"يا من له شيم تملكه","https://www.aldiwan.net/poem68473.html","مجزوء الكامل"],[240,"شكري لسيب نوالك الغمر","https://www.aldiwan.net/poem31998.html","الكامل"],[469,"وبمهجتي من سيفه من جفنه","https://www.aldiwan.net/poem3468.html","عموديه"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104463","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77270","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100827","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66560","الكامل"],[6301,"حَنِيْنٌ الى لِقَاءٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80673&r=&rc=37",""]],"verses":[["فَكَأَنَّ طرَّتَهُ وَضَوءَ جَبينِهِ","وَضَحُ الصَباحِ يَقِلُّ لَيلاً أَليَلا",0,"ل",2,0],["فكأنّ طرف الزهر ثمّة ساحر","لمّا رنا وكأنني مسحور",1,"ر",1,0],["فكأن طفل الفجر نا","م على وسادة جدول",2,"ل",1,0],["فَكَأَنَّ طَسماً قَبلُ كانوا جيرَةً","بِكَ وَالعَماليقَ الأُلى وَجَديسا",3,"س",2,0],["فَكانَ طَويلَ الباعِ سَهلاً فِنائُهُ","وَكانَ قَديماً جولُهُ لَم يُهَدَّمِ",4,"م",1,0],["فكأنَّ طرَّته وَضَوْءَ جبينِه","وضحُ الصياح يقلُّ ليلاً أليلا",5,"ل",2,0],["فكأن طبعك رقة","لنسيبهن مناسب",6,"ب",1,0],["فَكَأَنَّ طَلعَتَكَ الهِلالُ تَرا","ءَتهُ النَوَظِرُ لَيلَةَ الفِطرِ",7,"ر",1,0],["فكأنَّ طيبَ نسيمها من نشرهِ","وكأنَّ حمرةَ لونها من خدّهِ",8,"د",2,0],["فكأن طاعتها الرشاد إلى الهدى","وسوى اطاعتها لدي تهور",9,"ر",1,0],["فَكَأَنَّ طينَةَ طيبَةٌ في طُهرِها","وَكَأَنَّ مَنفيسَ الحَطيمُ وَزَمزَمُ",10,"م",1,0],["فكأن طيراً فوقها","تطوى الجناح وتنشر",11,"ر",1,0],["فَكَأَنَّ طائِرَها خَطيبٌ مصْقَعٌ","قَد قامَ فَوْقَ مَنابِرِ الأَغْصانِ",12,"ن",1,0],["فَكانَ طريقي مِنْ هَراسٍ يَنُوشُني","فَأَصْبِرُ مِنْ بَيْنٍ وأرْضَى بِما لِيا",13,"ي",2,0]]}