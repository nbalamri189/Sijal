oetsgate.com/ViewPoem.aspx?id=159737",""],[5877,"سوّد الله قلب جوالي","https://www.poetsgate.com/ViewPoem.aspx?id=37474",""],[5956,"النساء","https://www.poetsgate.com/ViewPoem.aspx?id=181836",""],[5956,"علائق الروح ما بيني وبين أبي","https://www.poetsgate.com/ViewPoem.aspx?id=192096",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[5309,"هي الأخلاق تنبت كالنبات","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573769",""],[6211,"وانتهى الأمرُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79197&r=&rc=16",""],[6268,"عَدُّودَةُ الخُروج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82921&r=&rc=7",""],[6273,"دانة النور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78508&r=&rc=6",""],[6353,"خواطر الوداع الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64578&r=&rc=1",""]],"verses":[["ألْمُنْتَقَى مِنْ طِينَةِ الْمَجْدِ الَّذِي","مَا كَانَ يَوْماً صِرْفُهُ بِمَشُوبِ",0,"ب",1,0],["المنتقى من صميم الفخر جوهره","ما بين نصر وأنصار تهاداهُ",1,"ا",2,0],["المنتقى من جوهر الشرف الذي","في مدحه قد أنزلت آيُ السورْ",2,"ر",1,0],["ألم نرَ في الحسان الغيد قبلاً","أوانس كاتبات شاعرات",3,"ت",1,0],["أَلَم نُعتِق نِساءَ بَني نُمَيرٍ","فَلا شُكراً جَزَينَ وَلا ثَوابا",4,"ب",2,0],["أَلَم نَترُك مَآتِمَ مُعوِلاتٍ","لَهُنَّ عَلى سَراتِكُمُ رَنينُ",5,"ن",1,0],["المنهبات عيوننَا وقلوبَنا","وجناتهنَّ الناهبات الناهِبا",6,"ب",2,0],["المنطِق المخرسُ سَقياً له","رعْياً له من مُنطقٍ مُخرِس",7,"س",1,0],["المُنعمونَ عليَّ أنعُمَهم","والحامِدون لكلّ ما أُبلي",8,"ل",2,0],["المنذر المُضحكِ المُغنِّي","الكاتب الحاسب المعلِّمْ",9,"م",1,0],["المُنعمين وما منُّوا على أحدٍ","يوماً بنعمى ولو منُّوا لما مانوا",10,"ن",3,0],["المُنعِمونَ بَني حَربٍ وَقَد حَدَقَت","بِيَ المَنِيَّةُ وَاِستَبطَأتُ أَنصاري",11,"ر",2,0],["أَلَم نَترُك نِسائَهُمُ جَميعاً","بِأَقبالِ الهِضابِ مُسَنَّدينا",12,"ن",2,0],["أَلَم نَترُك نِساءَ بَني زُهَيرٍ","عَلى الآسي يُحَلِّقنَ القُرونا",12,"ن",2,0],["المنايا تريد منك صحايا","آه من قسوة بقلب المنايا",13,"ي",2,0],["ألم نكن لما قضى","به مثالا حسنا",14,"ن",2,0],["ألم نكف الحجاز عوان حرب","وأنقذناه من حرب وكرب",15,"ب",1,0],["ألم نك خلف إبراهيم لما","رمى بجواده الأبراج شما",15,"م",2,0],["المنعم المجزل عن نفسه","عن جدّه عن جدّه المجزل",16,"ل",1,0],["أَلَم نَكُ مِن قَبلِ المَسيحِ اِبنِ مَريَمٍ","وَموسى وَطَهَ نَعبُدُ النيلَ جارِيا",17,"ي",2,0],["المَنايا نَوازِلُ الشَعَرِ الأَب","يَضِ جاراتُ كُلِّ أَسوَدَ فاحِم",18,"م",1,0],["المَناحاتُ في مَمالِكِ أَبنا","ئِكَ بَدرِيَّةُ العَزاءِ قَوائِم",18,"م",1,0],["المَندَلُ الفَيّاحُ عودُ سَريرِهِ","وَاللُؤلُؤُ اللَمّاحُ وَشيُ ثِيابِهِ",19,"ب",2,0],["المَنهِباتُ قُلوبَنا وَعُقولَنا","وَجَناتِهِنَّ الناهِباتِ الناهِبا",20,"ب",2,0],["ألمنا وأعذرتُمْ فإِن تبلُغوا المَدى","من العتبِ نُعْذَرْ دونكمْ وتُلامُوا",21,"م",3,0],["المُنعِمُ المُفضِلُ المُرَجّى","وَالأَبلَجُ الأَزهَرُ الأَغَرُّ",22,"ر",1,0],["آلَ مِن وائِلٍ إِلى بَيتِ فَخرٍ","باتَ ساري العُلا إِلَيهِ يَأولُ",23,"ل",1,0],["أَلَم نَكُ أَعلى دارِمٍ في دِيارِها","وَأَكثَرَها إِن عُدَّ يَوماً نَفيرُها",24,"ر",3,0],["أَلَم نَترُك هَوازِنَ حَيثُ هَبَّت","عَلَيهِم ريحُنا مِثلَ الهَشيمِ",25,"م",1,0],["المَنايا تَجوسُ كُلَّ البِلادِ","وَالمَنايا تُفني جَميعَ العِبادِ",26,"د",1,1],["أَلَم نَرَ يا دُنيا تَصَرُّفَ حالِكِ","وَغَدرَكِ يا دُنيا بِنا وَانتِقالِكِ",27,"ك",1,1],["المُنعِمونَ وَلَكِن قَبلَما سُئِلوا","وَالصافِحونَ وَلَكِن بَعدَما قَدَروا",28,"ر",3,0],["المُنى فيهِ وَالمَنون","فَهوَ يُغشى وَيُرتَجى",29,"ج",2,0],["المُنفِقونَ بِأَرضِهمْ أعمارَهُمْ","ما بين غزوٍ في العِدى وجِهادِ",30,"د",1,0],["المُنكِرين على الحُماةِ وفاءَهم","المُؤثِرين تقلُّبَ الأهواءِ",31,"ا",2,0],["المُنكِرينَ عَلى المَمالِكِ حَقَّها","الزاعِمينَ شُعوبَهُنَّ ذُبابا",32,"ب",2,0],["المُنجِباتُ حُماةَ المُلكِ يَندُبُهُم","لِلنّائِباتِ فَيَلقى النَصرَ مُنتَدِبا",33,"ب",2,0],["المُنعِمِ النِعَمَ اللاتي سَمِعتَ بِها","في الجاهِلِيَّةِ وَالفَكّاكِ لِلكُرَبِ",34,"ب",1,0],["أَلَم نَتَلَقَّ الحادِثاتِ بِصَبرِنا","وَكَم جازِعٍ لِلحادِثاتِ سِوانا",35,"ن",2,0],["ألمن خابَ حفرةٌ ذات ضيقٍ","ولمن فاز روضةٌ وغديرُ",36,"ر",1,0],["المَنايا يرميننا كل يوم","بسهامٍ فَلا تطيش السهام",37,"م",1,0],["المنايا مصيبةٌ كلّ حيّ","والبِلى غاية الوجوه الوسام",38,"م",1,0],["أَلمُنْشِيءِ اللَّبِقِ الحَفِيلِ نَظيمُهُ","وَنَثِيرُهُ بِرَوَائِعِ الأَبْدَاءِ",39,"ا",2,0],["المنى اليانعاتُ من ثَمرَاته","وجَمَالُ الزمانِ في لحظاتهْ",40,"ت",2,0],["المنكرين ذواتِهم","حتى تراهم بالمجاهر",41,"ر",1,0],["المنتقى من سر هاشم في الذرا","حيث استقر مدى الفخار صعودا",42,"د",2,0],["المنتهى أمسى هو المبتدي ،","والصورة المخلوقة الحالفه",43,"ف",2,0],["ألم نؤجّج نحن بدء الكفاح ؟","فلنتّقد حتّى مداه السحيق",44,"ق",1,0],["المنتقاةَ من الحياة طبيعةً","والمصطفاة من البلاد مكانا",45,"ن",2,0],["آلَ مِنْ وَائِلٍ إلى بَيْتِ فَخْرٍ،","بَاتَ سَارِي العُلا إلَيهِ يُئولُ",46,"ل",1,0],["ألمْ نتركْ نساءهمُ جميعًا","بِأَقْبَالِ الْهِضَابِ مُسَنَّدِينا",47,"ن",2,0],["المنعم الوَهاب جَلَّ جَلالَهُ","يُعطي وَيمنَع مَن يَشاء وَيُرزَقُ",48,"ق",1,0],["المن لله والسلطان أجمعه","علي والنقص والتقصير من شيمي",49,"م",2,0],["أَلَم نَترُكِ الضحيانَ يَكبُو وَبَعدَهُ","كُلَيباً أَذَقنا عِرسَهُ مَضَضَ الثَكلِ",50,"ل",1,0],["المَنزِلُ الواسِعُ يَشقى بِهِ","بانيهِ ثُمَّ السَفَرُ الشاسِعُ",51,"ع",1,0],["المُنْتَضَى من جَمَراتِ الأُلى","على السِّماكينِ لهمْ مَنْصِبُ",52,"ب",1,0],["ألم ندفن بوادينا قروماً","أرادوا الشرب من أمواه حابى",53,"ب",2,0],["ألم نشرق على الشرق المعنّى","فندفع عنه آصار الضباب",53,"ب",1,0],["المُنتَضي صارِماً للهَدْي مُنْتَصراً","والمُرْتَضى قائِماً بِالحَقّ مُنْتصبا",54,"ب",2,0],["المنجهيَّةُ والجفا","ءُ بها يدل عَلَى الشمم",55,"م",1,0],["المُنشئ السهلَ المرام الشاعر ال","قاضي المرامي والخطيب المصقعُ",56,"ع",1,0],["المنتَمين بِذلك النَس","ب الشَريف الى لُؤي",57,"ي",1,0],["المنطقُ يبدو مَوروب","والباطلُ أصبحَ مَرغوبا",58,"ب",2,1],["ألم نَسْكُنْ مُخيَّمَنا جميعاً","تُشارِكُنا طُفُولَتَنا الخُطُوبُ؟!",59,"ب",1,0],["ألم نَشْرَبْ مَوَاجِعَنا صِغَاراً","وَنَرْضَعْهَا كما رُضِعَ الحليبُ؟!",59,"ب",1,0],["ألم نرها مملوءة بملوكها","يضيق بهم منها رحيب فضاها",60,"ا",3,0],["المنجزُ الوعدَ بلا منَّةٍ","ولم أكنْ من وعده بانتظار",61,"ر",1,0],["المُنتَضونَ مهنّداتِ سُط