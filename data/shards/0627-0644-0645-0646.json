{"poems":[[79,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[85,"هذي العوالم لفظ أنت معناه","https://www.aldiwan.net/poem54231.html","البسيط"],[85,"نفسي الفداء لشادن مهما خطر","https://www.aldiwan.net/poem54307.html","الكامل"],[90,"هي الأخلاق تنبت كالنبات","https://www.aldiwan.net/poem44970.html","الوافر"],[29,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[23,"ألا أبلغ أبا قيس رسولا","https://www.aldiwan.net/poem21381.html","الوافر"],[74,"عطفت كأمثال القسي حواجبا","https://www.aldiwan.net/poem18230.html","الكامل"],[53,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[53,"قومي بنو العباس حلمهم","https://www.aldiwan.net/poem65919.html","أحذ الكامل"],[53,"قولا لطوط أبي علي","https://www.aldiwan.net/poem66064.html","مخلع البسيط"],[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[31,"تغير الرسم من سلمى بأحفار","https://www.aldiwan.net/poem6035.html","البسيط"],[40,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[91,"يا روح هذه الدنى","https://www.aldiwan.net/poem44928.html","مجزوء الرجز"],[87,"عرابي كيف أوفيك الملاما","https://www.aldiwan.net/poem7581.html","الوافر"],[87,"بات المعنى والدجى يبتلى","https://www.aldiwan.net/poem7887.html","السريع"],[87,"بني القبط إخوان الدهور رويدكم","https://www.aldiwan.net/poem8093.html","الطويل"],[87,"لك في الأرض والسماء مآتم","https://www.aldiwan.net/poem11330.html","الخفيف"],[87,"في الموت ما أعيا وفي أسبابه","https://www.aldiwan.net/poem63779.html","الكامل"],[45,"بأبي الشموس الجانحات غواربا","https://www.aldiwan.net/poem9466.html","الكامل"],[64,"على أثلات الواديين سلام","https://www.aldiwan.net/poem52296.html","الطويل"],[47,"مني وصل ومنك هجر","https://www.aldiwan.net/poem63631.html","مجزوء البسيط"],[47,"خير نيليك إن أنلت الجزيل","https://www.aldiwan.net/poem65611.html","الطويل"],[30,"ألا ليت شعري ما أرادت مجاشع","https://www.aldiwan.net/poem5103.html","الطويل"],[30,"ألا كيف البقاء لباهلي","https://www.aldiwan.net/poem5530.html","الوافر"],[51,"المنايا تجوس كل البلاد","https://www.aldiwan.net/poem62044.html","الخفيف"],[51,"ألم نر يا دنيا تصرف حالك","https://www.aldiwan.net/poem63042.html","الطويل"],[68,"فطر به كاد قلب الدهر ينفطر","https://www.aldiwan.net/poem40977.html","البسيط"],[68,"خذ من الدهر لي نصيب","https://www.aldiwan.net/poem41371.html","مجزوء الخفيف"],[82,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[107,"قصوا الحديث عن الفريق النائي","https://www.aldiwan.net/poem42116.html","الكامل"],[107,"أأفاق ظالم نفسه فأنابا","https://www.aldiwan.net/poem43091.html","الكامل"],[107,"من يمنع الليث أن يعتز أو يثبا","https://www.aldiwan.net/poem43386.html","البسيط"],[41,"لمن ديار بهذا الجزع من ربب","https://www.aldiwan.net/poem53814.html","البسيط"],[54,"ملكنا الهوى حينا وكان وكانا","https://www.aldiwan.net/poem26662.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85434","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[108,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[79,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[102,"يوم 13 حزيران 1974م","https://www.poetsgate.com/ViewPoem.aspx?id=50461",""],[102,"لنعترف","https://www.poetsgate.com/ViewPoem.aspx?id=50177",""],[92,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[47,"خَيرُ نَيلِكَ، إنْ أنَلتَ، الجِزيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=31800",""],[40,"أبتْ آياتُ حبّى أنْ تبينا","https://www.poetsgate.com/ViewPoem.aspx?id=21235",""],[113,"كبد تذوب وعبرة تترقرق","https://www.aldiwan.net/poem16518.html","الكامل"],[164,"يا من بنعماه لحمي نابت ودمي","https://www.aldiwan.net/poem58990.html","البسيط"],[173,"إليكن عني فانصرفن على مهل","https://www.aldiwan.net/poem1643.html",""],[197,"أمران يعيا بهما ذو الحجى","https://www.aldiwan.net/poem13070.html","السريع"],[202,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[279,"لا أعصر الخمر بل أغرس العنبا","https://www.aldiwan.net/poem25626.html","البسيط"],[302,"إن كان وصلك لم يدم","https://www.aldiwan.net/poem36806.html","عموديه"],[309,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[365,"إن العواذل قد كووا","https://www.aldiwan.net/poem67582.html","مجزوء الكامل"],[366,"سر منقلبًا","https://www.aldiwan.net/poem11643.html","عموديه"],[404,"رجوتك يا حبيب","https://www.aldiwan.net/poem6720.html","عموديه"],[407,"شكت بلسان الحال طول جفاها","https://www.aldiwan.net/poem33365.html","الطويل"],[420,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[436,"سارت مطيهم بهم تمطو","https://www.aldiwan.net/poem12799.html","أحذ الكامل"],[461,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[464,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[467,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[467,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[493,"فسائل جمعنا عنا وعنهُم","https://www.aldiwan.net/poem665.html",""],[503,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[517,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[541,"زارت ضيوف النيل منا المغربا","https://www.aldiwan.net/poem48267.html","عموديه"],[578,"حسبي كما حكم الغرام وحسبها","https://www.aldiwan.net/poem3099.html","الكامل"],[589,"صبا وهزته أيدي شوقه طربا","https://www.aldiwan.net/poem17425.html","البسيط"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216887","الخفيف"],[793,"","https://poetry.dctabudhabi.ae/diwan/poem/29557","الطويل"],[967,"","https://poetry.dctabudhabi.ae/diwan/poem/29446","الوافر"],[1098,"","https://poetry.dctabudhabi.ae/diwan/poem/18398","الوافر"]],"verses":[["ألْمُنْتَقَى مِنْ طِينَةِ الْمَجْدِ الَّذِي","مَا كَانَ يَوْماً صِرْفُهُ بِمَشُوبِ",0,"ب",1,0],["المنتقى من صميم الفخر جوهره","ما بين نصر وأنصار تهاداهُ",1,"ا",2,0],["المنتقى من جوهر الشرف الذي","في مدحه قد أنزلت آيُ السورْ",2,"ر",1,0],["ألم نرَ في الحسان الغيد قبلاً","أوانس كاتبات شاعرات",3,"ت",1,0],["أَلَم نُعتِق نِساءَ بَني نُمَيرٍ","فَلا شُكراً جَزَينَ وَلا ثَوابا",4,"ب",2,0],["أَلَم نَترُك مَآتِمَ مُعوِلاتٍ","لَهُنَّ عَلى سَراتِكُمُ رَنينُ",5,"ن",1,0],["المنهبات عيوننَا وقلوبَنا","وجناتهنَّ الناهبات الناهِبا",6,"ب",2,0],["المنطِق المخرسُ سَقياً له","رعْياً له من مُنطقٍ مُخرِس",7,"س",1,0],["المُنعمونَ عليَّ أنعُمَهم","والحامِدون لكلّ ما أُبلي",8,"ل",2,0],["المنذر المُضحكِ المُغنِّي","الكاتب الحاسب المعلِّمْ",9,"م",1,0],["المُنعمين وما منُّوا على أحدٍ","يوماً بنعمى ولو منُّوا لما مانوا",10,"ن",3,0],["المُنعِمونَ بَني حَربٍ وَقَد حَدَقَت","بِيَ المَنِيَّةُ وَاِستَبطَأتُ أَنصاري",11,"ر",2,0],["أَلَم نَترُك نِسائَهُمُ جَميعاً","بِأَقبالِ الهِضابِ مُسَنَّدينا",12,"ن",2,0],["أَلَم نَترُك نِساءَ بَني زُهَيرٍ","عَلى الآسي يُحَلِّقنَ القُرونا",12,"ن",2,0],["المنايا تريد منك صحايا","آه من قسوة بقلب المنايا",13,"ي",2,0],["ألم نكن لما قضى","به مثالا حسنا",14,"ن",2,0],["ألم نكف الحجاز عوان حرب","وأنقذناه من حرب وكرب",15,"ب",1,0],["ألم نك خلف إبراهيم لما","رمى بجواده الأبراج شما",15,"م",2,0],["المنعم المجزل عن نفسه","عن جدّه عن جدّه المجزل",16,"ل",1,0],["أَلَم نَكُ مِن قَبلِ المَسيحِ اِبنِ مَريَمٍ","وَموسى وَطَهَ نَعبُدُ النيلَ جارِيا",17,"ي",2,0],["المَنايا نَوازِلُ الشَعَرِ الأَب","يَضِ جاراتُ كُلِّ أَسوَدَ فاحِم",18,"م",1,0],["المَناحاتُ في مَمالِكِ أَبنا","ئِكَ بَدرِيَّةُ العَزاءِ قَوائِم",18,"م",1,0],["المَندَلُ الفَيّاحُ عودُ سَريرِهِ","وَاللُؤلُؤُ اللَمّاحُ وَشيُ ثِيابِهِ",19,"ب",2,0],["المَنهِباتُ قُلوبَنا وَعُقولَنا","وَجَناتِهِنَّ الناهِباتِ الناهِبا",20,"ب",2,0],["ألمنا وأعذرتُمْ فإِن تبلُغوا المَدى","من العتبِ نُعْذَرْ دونكمْ وتُلامُوا",21,"م",3,0],["المُنعِمُ المُفضِلُ المُرَجّى","وَالأَبلَجُ الأَزهَرُ الأَغَرُّ",22,"ر",1,0],["آلَ مِن وائِلٍ إِلى بَيتِ فَخرٍ","باتَ ساري العُلا إِلَيهِ يَأولُ",23,"ل",1,0],["أَلَم نَكُ أَعلى دارِمٍ في دِيارِها","وَأَكثَرَها إِن عُدَّ يَوماً نَفيرُها",24,"ر",3,0],["أَلَم نَترُك هَوازِنَ حَيثُ هَبَّت","عَلَيهِم ريحُنا مِثلَ الهَشيمِ",25,"م",1,0],["المَنايا تَجوسُ كُلَّ البِلادِ","وَالمَنايا تُفني جَميعَ العِبادِ",26,"د",1,1],["أَلَم نَرَ يا دُنيا تَصَرُّفَ حالِكِ","وَغَدرَكِ يا دُنيا بِنا وَانتِقالِكِ",27,"ك",1,1],["المُنعِمونَ وَلَكِن قَبلَما سُئِلوا","وَالصافِحونَ وَلَكِن بَعدَما قَدَروا",28,"ر",3,0],["المُنى فيهِ وَالمَنون","فَهوَ يُغشى وَيُرتَجى",29,"ج",2,0],["المُنفِقونَ بِأَرضِهمْ أعمارَهُمْ","ما بين غزوٍ في العِدى وجِهادِ",30,"د",1,0],["المُنكِرين على الحُماةِ وفاءَهم","المُؤثِرين تقلُّبَ الأهواءِ",31,"ا",2,0],["المُنكِرينَ عَلى المَمالِكِ حَقَّها","الزاعِمينَ شُعوبَهُنَّ ذُبابا",32,"ب",2,0],["المُنجِباتُ حُماةَ المُلكِ يَندُبُهُم","لِلنّائِباتِ فَيَلقى النَصرَ مُنتَدِبا",33,"ب",2,0],["المُنعِمِ النِعَمَ اللاتي سَمِعتَ بِها","في الجاهِلِيَّةِ وَالفَكّاكِ لِلكُرَبِ",34,"ب",1,0],["أَلَم نَتَلَقَّ الحادِثاتِ بِصَبرِنا","وَكَم جازِعٍ لِلحادِثاتِ سِوانا",35,"ن",2,0],["ألمن خابَ حفرةٌ ذات ضيقٍ","ولمن فاز روضةٌ وغديرُ",36,"ر",1,0],["المَنايا يرميننا كل يوم","بسهامٍ فَلا تطيش السهام",37,"م",1,0],["المنايا مصيبةٌ كلّ حيّ","والبِلى غاية الوجوه الوسام",38,"م",1,0],["أَلمُنْشِيءِ اللَّبِقِ الحَفِيلِ نَظيمُهُ","وَنَثِيرُهُ بِرَوَائِعِ الأَبْدَاءِ",39,"ا",2,0],["المنى اليانعاتُ من ثَمرَاته","وجَمَالُ الزمانِ في لحظاتهْ",40,"ت",2,0],["المنكرين ذواتِهم","حتى تراهم بالمجاهر",41,"ر",1,0],["المنتقى من سر هاشم في الذرا","حيث استقر مدى الفخار صعودا",42,"د",2,0],["المنتهى أمسى هو المبتدي ،","والصورة المخلوقة الحالفه",43,"ف",2,0],["ألم نؤجّج نحن بدء الكفاح ؟","فلنتّقد حتّى مداه السحيق",44,"ق",1,0],["المنتقاةَ من الحياة طبيعةً","والمصطفاة من البلاد مكانا",45,"ن",2,0],["آلَ مِنْ وَائِلٍ إلى بَيْتِ فَخْرٍ،","بَاتَ سَارِي العُلا إلَيهِ يُئولُ",46,"ل",1,0],["ألمْ نتركْ نساءهمُ جميعًا","بِأَقْبَالِ الْهِضَابِ مُسَنَّدِينا",47,"ن",2,0],["المنعم الوَهاب جَلَّ جَلالَهُ","يُعطي وَيمنَع مَن يَشاء وَيُرزَقُ",48,"ق",1,0],["المن لله والسلطان أجمعه","علي والنقص والتقصير من شيمي",49,"م",2,0],["أَلَم نَترُكِ الضحيانَ يَكبُو وَبَعدَهُ","كُلَيباً أَذَقنا عِرسَهُ مَضَضَ الثَكلِ",50,"ل",1,0],["المَنزِلُ الواسِعُ يَشقى بِهِ","بانيهِ ثُمَّ السَفَرُ الشاسِعُ",51,"ع",1,0],["المُنْتَضَى من جَمَراتِ الأُلى","على السِّماكينِ لهمْ مَنْصِبُ",52,"ب",1,0],["ألم ندفن بوادينا قروماً","أرادوا الشرب من أمواه حابى",53,"ب",2,0],["ألم نشرق على الشرق المعنّى","فندفع عنه آصار الضباب",53,"ب",1,0],["المُنتَضي صارِماً للهَدْي مُنْتَصراً","والمُرْتَضى قائِماً بِالحَقّ مُنْتصبا",54,"ب",2,0],["المنجهيَّةُ والجفا","ءُ بها يدل عَلَى الشمم",55,"م",1,0],["المُنشئ السهلَ المرام الشاعر ال","قاضي المرامي والخطيب المصقعُ",56,"ع",1,0],["المنتَمين بِذلك النَس","ب الشَريف الى لُؤي",57,"ي",1,0],["المنطقُ يبدو مَوروب","والباطلُ أصبحَ مَرغوبا",58,"ب",2,1],["ألم نَسْكُنْ مُخيَّمَنا جميعاً","تُشارِكُنا طُفُولَتَنا الخُطُوبُ؟!",59,"ب",1,0],["ألم نَشْرَبْ مَوَاجِعَنا صِغَاراً","وَنَرْضَعْهَا كما رُضِعَ الحليبُ؟!",59,"ب",1,0],["ألم نرها مملوءة بملوكها","يضيق بهم منها رحيب فضاها",60,"ا",3,0],["المنجزُ الوعدَ بلا منَّةٍ","ولم أكنْ من وعده بانتظار",61,"ر",1,0],["المُنتَضونَ مهنّداتِ سُطاً","من شأنِها الإقساطُ والقِسْطُ",62,"ط",1,0],["المنبرُ الصائح عن","أسمائهم والدرهمُ",63,"م",1,0],["المُنهلين السُّمر من منهج العِدى","حيث السماء بخيلةٌ لم تَهطلِ",64,"ل",1,0],["المنعم الندسَ البليغ المصقع الحب","رَ الكريمَ اللوذعيَّ الأمجدا",65,"د",2,0],["المنجدون بكلِّ أبيضَ صارمٍ","داعي تهائمِ يثرب ونجودها",66,"د",3,0],["أَلَم نَترُك سَراتَهُمُ عَيامى","جُثوماً تَحتَ أَرجاءِ الذُيولِ",67,"ل",1,0],["المُنْتقى من لُبِّ عُنصُرِ هاشمٍ","إِبناً سمتْ بفَخارِهِ الآباءُ",68,"ا",2,0],["المُنْطِقُ الصّخْرَ الأصمَّ بكفّهِ","والمُخْرسُ البُلَغاءَ في تِبيانهِ",69,"ن",2,0],["المُنصِتُونَ إليهمُ في نشوةٍ","والناظرُون إليهِمُ حلَّوا الحُبَى",70,"ب",2,0],["المُنْهِبُ الآلافَ علماً إِنَّه","لا يَحْرسُ العلياءَ إِلاَّ نَهْبُها",71,"ب",3,0],["المُنْجدِينَ أَخا المُوجِدينَ سَخاً","وَالماجِدين أباً والوَاجِدين إِبا",72,"ب",2,0],["آل منه فخفَّ وهو نبيلٌ","في محاني ضُلُوعِهِ إجفارُ",73,"ر",1,0],["أَلَم نَشرِهِم شَفعاً وَيُترَكُ مِنهُمُ","بِجَنبِ العَروضِ رِمَّةٌ وَمَزاحِفُ",74,"ف",1,0],["أَلَم نُطلِقكُم فَكَفَرتُمُونَا","وَلَيسَ لِنِعمَةِ المَكفُورِ جُولُ",75,"ل",1,0],["أَلَم نَفتِقهُمُ بِالبِشرِ طَعناً","وَضَرباً مِثلَ تَشقيقِ الضَروبِ",76,"ب",1,0]]}