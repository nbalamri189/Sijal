87,"أحلى الهوى أن يطول الوجد والسقم","https://www.aldiwan.net/poem17711.html","البسيط"]],"verses":[["لَم يَنقَعوا الظَمآنَ مِن غُلَّةٍ","وَلَم يُبالوا طَرَبَ المُستَهام",0,"م",1,0],["لَم يَنزِعوا البيضَ مُذلاثوا عَمائِمَهُم","إِلّا وَقَد غاضَ مِنها الشَيبُ وَالنَزَعُ",1,"ع",1,0],["لَم يُنسِنا كافي الكُفاةِ مُصابَهُ","حَتّى رَمانا فيكَ خَطبٌ مُظلِعُ",2,"ع",1,0],["لَم يَنتَقِش شَوكَ القَنا مِن جِلدِهِ","في الرَوعِ إِلّا بِالقَنا المُتَقَصِّدِ",3,"د",1,0],["لَم يَنَلكِ الرَجاءُ أَن تَحضُريني","وَتَجافَت أُمنِيَّتي عَن سِواكِ",4,"ك",1,0],["لَمْ يُنَوِّه بِهَا سِوَاكَ وَقَدْ مَرْ","رَ زَمَانٌ وَعَاقِبَ الْحِينُ حِينَا",5,"ن",2,0],["لَم يَنقُصِ الشَيبُ مِنهُ ما يُقالُ لَهُ","وَقَد تَجاوَزَ عَنهُ الجَهلُ فَاِنقَشَعا",6,"ع",2,0],["لَم يَنَم لَيلَةَ التَمامِ لِكَي يُص","بِحَ حَتّى أَضائَهُ الإِشراقُ",7,"ق",1,0],["لَم يَنُح جازِعٌ عَلَيكَ كَما نا","حَت وَلا أَطنَبَ المُحِبُّ وَحابى",8,"ب",2,0],["لَم يُنازِلكَ قارِحُ القَومِ إِلّا","كُنتَ أَقوى يَداً وَأَعلى جَنابا",8,"ب",2,0],["لَم يُنَهنِه مِن عَزمِكَ السِجنُ وَالنَف","سُ وَساجَلتَها بِمِصرَ الضِرابا",8,"ب",2,0],["لَم يَنَل حاسِدوكَ مِنكَ مُناهُم","لا وَلَم يُلصِقوا بِعَلياكَ عابا",8,"ب",2,0],["لَم يَنقَبِض كِبراً بِنا","ديهِ وَلَم يَتَبَذَّلِ",9,"ل",1,0],["لَم يُنسِني مَرُّ الزَمانِ وَلَم يَزَل","حِفظُ الوِدادِ سَجِيَّتي وَشِعاري",10,"ر",2,0],["لَم يُنجِني مِنكَ ما استَشعَرتُ مِن حَذَرٍ","هَيهاتَ كَيدُ الهَوى يَستَهلِكُ الحَذَرا",11,"ر",2,0],["لَمْ يَنْصُرِ الفُصْحَى كَنَصْرِكَ جِهْبَذُ","مُتَضَلِّعٌ مُتَوَسِّعٌ فِي آنِ",12,"ن",1,0],["لَمْ يَنْسَ قَطُّ الشَّعْبِ فِي سُلْطَانِهَا","فَأَقَرَّهُ مُسْتَكْمِلَ السُّلْطَانِ",13,"ن",1,0],["لَمْ يَنْقَطِعْ لَكِ جُهْدٌ","فِي صَالِحِ الأعْمَالِ",14,"ل",1,0],["لَم يُنسِني أَطلالَ ماوِيَّةٍ ناسي","وَلا أَكثَرُ الماضي الَّذي مِثلُهُ يُنسي",15,"ي",1,1],["لَم يَنتَقِصنِيَ بُعدي عَنكَ مِن حُزُنٍ","هِيَ المُواساةُ في قُربٍ وَفي بُعُدِ",16,"د",1,0],["لَم يُنبِتوا فَرعَ خَيرٍ يُذكَرونَ بِهِ","حَتّى يُنَبِّتَ عودَ النَبعَةِ الكَمَرُ",17,"ر",1,0],["لَم يَنسَني بِالشامِ إِذ هُوَ رَبُّها","كَلّا وَلا مُتَنَصِّراً بِالرومِ",18,"م",1,0],["لم ينج منجى حائنٍ مغرور","يحملهُ يوماً على الغرور",19,"ر",1,0],["لم ينتشر قط من يشاهدها","وهْي على العالمين منتشره",20,"ر",2,0],["لم ينل صاحبُ الزنوج من الإس","لام طراً ما نالني من هواك",21,"ك",1,0],["لم ينزعوا الا الى مثلهم","كذلك الجنس الى الجنس",22,"س",1,0],["لم ينتزع من هؤلاء غرورهم","نسب لهم في الهالكين عريق",23,"ق",1,0],["لم ينشرح في الجيش من","قطع الجماجم والأنوف",24,"ف",1,0],["لم ينكشف عنه الحجا","ب ولم تزح عنه الستور",25,"ر",1,0],["لم ينصر الله بالأحلام صاحبها","لكن بكل عوان كان يذكيها",26,"ي",3,0],["لَم يَنَم عَنكَ ساعَةً","في الأَحاديثِ وَالسَمَر",27,"ر",1,0],["لَم يَنجُ مِن كَيدِ العَدُو","وِ لَهُ وَمِن عَبَثِ الحَميمِ",28,"م",1,0],["لَم يُنقِذِ الإِسلامَ أَو يَرفَع لَهُ","رَأساً سِوى النَفَرِ الأُلى رَفَعوكِ",29,"ك",1,0],["لم يُنْسِه الحبُّ قطعَ البِيدِ عن عُرُضٍ","ولا رمَى الخوفُ ذِكراهُ بنسيانِ",30,"ن",1,0],["لَم يَنتَهِض لِلمَكرُماتِ مُشَيَّعٌ","مِثلَ الوَزيرِ إِذا الوَزيرُ اِستَنهِضا",31,"ض",2,0],["لَم يَنكِلوا عَن فِعالِ الخَيرِ أَجمَعُهُ","إِن لَم يُصيبوا عَلى الخَيراتِ أَعوانا",32,"ن",2,0],["لم يَنشُرِ الهجرُ لي هَواجِرَه","حتّى انطوى من وِصالِهِ الأُصُلُ",33,"ل",1,0],["لَم يَنسَهُ المَلَكانِ حينَ نَسيتَهُ","بَل أَثبَتاهُ وَأَنتَ لاهٍ تَلعَبُ",34,"ب",1,0],["لَم يَنهَ نَصُّ الذِكرِ عَنها وَلا","أُجمِعَ في الشَرعِ عَلى ذَمِّها",35,"م",3,0],["لَم يَنجُ بِالبَأسِ مِنها مَع شَراسَتِهِ","لَيثُ العَرينِ وَلا بِالحيلَةِ السيدُ",36,"د",1,0],["لَم يَنتَقِص في حُسنِهِ","فَلَهُ الكَمالَةُ وَالتَمامُ",37,"م",1,0],["لَم يَنأَ عَنّي مَطلَبٌ وَمُحَمَّدٌ","عَونٌ عَلَيهِ أَو إِلَيهِ سُلَّمُ",38,"م",1,0],["لَم يَنتَدِب عُمَرٌ لِلإِبلِ يَجعَلُ مِن","جُلودِها النَقدَ حَتّى عَزَّهُ الذَهَبُ",39,"ب",1,0],["لَم يُنفِقِ الذَهَبَ المُربي بِكَثرَتِهِ","عَلى الحَصى وَبِهِ فَقرٌ إِلى الذَهَبِ",40,"ب",1,0],["لَمْ يَنْظِمِ الْحُوشِيَّ عُجْبَاً بِهِ","وَلَمْ يُسَمِّ الْوَرْدَ بِالْحَوْجَمِ",41,"م",1,0],["لَم يُنسِني طولُ الزَما","نِ وَما يَمُرُّ مِنَ السِنينِ",42,"ن",1,0],["لَم يُنسِني ما قَد لَقيتُ وَنَأيُها","عَنّي وَأَشغالٌ عَدَت وَأُمورُ",43,"ر",1,0],["لَم يَنفَصِم عَن ضَمَّةٍ لِإِقامَةٍ","إِلّا إِلى تَعنيقَةٍ لَزَماعِ",44,"ع",1,0],["لم يُنكرِ المَنْفَى ولم يَعْدَم بهِ","مِن عزمهِ أهلاً ولا جِيرانا",45,"ن",2,0],["لم يُنزِلوكَ على الخُؤولةِ وحدَها","كلُّ المواطنِ للنّبوّةِ مَنزلُ",46,"ل",1,0],["لَم يَنَم هَمّي وَلَم أَنَمِ","نَهبُ كَفَّ الوَجدِ وَالسَقَمِ",47,"م",1,1],["لَم يَنقَطِع غُبارُها","قَبلَ دَمٍ مَصبوبِ",48,"ب",1,0],["لَمْ يَنَلْهَا باكْتِسَابٍ وفضلُ ال","له ما لَيسَ يُنَالُ اكْتِسَابا",49,"ب",2,0],["لَم يَنتَهُوا عَن قَذفِ دَاوُودَ وَلا","لوطٍ فكيفَ بِقذْفِهِمْ رُوبِيلا",50,"ل",2,0],["لَم يَنثَني اللَهوُ عَن غِشيانِ مَورِدِها","وَلَم أَكُن عَن دَواعيها بِصَمّيتِ",51,"ت",1,0],["لَم يَنتَهِ الحُسّادُ حَت","تى شَطَّ بي عَنكِ المَزارُ",52,"ر",1,0],["لَم يُنسِني السَعيُ وَالطَوافُ وَلا ال","داعونَ لِما اِبتَهَلنَ وَاِبتَهَلوا",53,"ل",3,1],["لَم يُنقِصِ الشَيبُ مِن دَعارَتِها","وَلا وَهى عَظمُها مِنَ القِدَمِ",54,"م",1,0],["لَم يُنكِهِ جُرحُ حِياصٍ وَلَم","يَبغِ لَهُ بِالثُفلِ تَسكينا",55,"ن",2,0],["لَم يَنسَ أَيّامَكَ اللاتي وَصَلتِ بِها","وَالصُرمُ يُحصيهِ إِصداراً وَإِيرادا",56,"د",2,0],["لم يُنْصَفوا حتى ببعض حجارةٍ","خرساءَ ماثلةٍ لعين الرائي",57,"ا",2,0],["لم ينتهِ الوحيُ والسحرُ الحلالُ ولمْ","تخْلُ الحياةُ من الرُّوادِ والرُّسلِ",58,"ل",1,0],["لَم ينَهَهُ رَبُّهُ عَن غَيرِ واحِدَةٍ","مِن شَجَرٍ طَيِّبٍ أَن شَمَّ أَو أكَلا",59,"ل",2,0],["لَمْ يَنْصُرِ العِرْفَانَ نُصْرَتَهُ امْرُؤءٌ","بِشَمَائِلٍ خُلِقَتْ لَهَا وَخِلاَلِ",60,"ل",1,0],["لَمْ يَنأَ عَنْ مَرْمَى لَظاهَا ناطِقٌ","بِالضَّادِ بَيْنَ مَغَارِبٍ وَمَشَارِقِ",61,"ق",1,0],["لَمْ يُنَافِسْهُ فِي الوَجَاهَةِ مَمْدُو","دُ طِرَافٍ وَلاَ كَثِيرُ رَمادِ",62,"د",1,0],["لَمْ يَنْجُ مِنْهُ مُعْصِمٌ في مَعْقِلٍ","تَحْمِيهِ رَايَةُ أُمَّةٍ وَجُنُودُ",63,"د",1,0],["لَمْ يَنْسَ نَادِيَكُمُ مَآثِرَهُ وَهَلْ","يُنْسَى وَلِيٌّ مِثْلُهُ وَعَمِيدُ",63,"د",1,0],["لم يَنْتَقِلْ حَتَّى تَفَجَّر نَبْعُهُ","وشَفَى النُّفُوسَ نَميرُهُ بِزُلاَل",64,"ل",1,0],["لم ينقلوا الأقدام إلا بعدما","مهَّدت أنت طريقها تمهيدا",65,"د",2,0],["لم ينتسب شجرٌ إلا إليك أ