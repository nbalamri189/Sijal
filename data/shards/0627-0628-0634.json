064",""],[6117,"فَتَاةُ الْقُدْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=182794",""],[6204,"الدموع في مآقي المآذن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69131&r=&rc=3",""],[6264,"الذكرى العطره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79131&r=&rc=39",""],[6268,"هذيان بائع الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82917&r=&rc=3",""]],"verses":[["أَبْشرْ فقد نِلْتَ مَا تَرْجُو عَلَى عَجَلِ","وَيَسَّر اللهُ مَا تَبْغِيهِ مِنْ أَمَلِ",0,"ل",1,1],["أبْشِرْ فأنتَ مجدِّدُ المُلْكِ الذي","لوْلاكَ أصْبَحَ وهْوَ رسْمٌ داثِرُ",1,"ر",1,0],["أبْشِرْ فإنّكَ بعْدَ ما بعُدَ المَدى","وتولّتِ الدُّنْيا مجَدِّدُ أمْرِهِ",2,"ر",2,0],["أَبشِر فَإِنَّكَ في أُخراكَ أَسعَدُنا","حَظّاً وَإِن كُنتَ في دُنياكَ أَشقانا",3,"ن",2,0],["أَبشِر فَإِنَّكَ ناجٍ","وَاِصبِر مَعَ الصابِرينا",4,"ن",2,0],["أَبشِر حَكَيتَ أَباكَ في أَفعالِهِ","وَأَظُنُّ نَجلَكَ بَعدَها يَحكيكا",5,"ك",2,0],["أبشرْ بصنع عاجلٍ","أعلامُهُ مرتفعَهْ",6,"ع",2,0],["أَبْشِرْ لجيشك بالسعادة كلّها","يَغزو ونصر الله تحت لوائهِ",7,"ه",1,0],["أبشرْ بكرٍّ عاجلٍ إنني","بالثَّأْرِ في أمثالها طالبُ",8,"ب",1,0],["أبشرْ أجارك من زمانك ماجدٌ","حبلُ الجوار لديه حبل مدمجُ",9,"ج",1,0],["أبْشِرْ بفتْح لكَ مَفْتُوحِ","مِنْ نَافح بالخيْر مَنفُوحِ",10,"ح",1,1],["أبشِرْ فما قَارَفْتَه مُسبَّخُ","عنك ونيران الصدورِ بُوَّخُ",11,"خ",1,0],["أبشرْ بكيد اللّه كلَّ كيادْ","عنك وعَمِّرْ كبقاءِ الأطوادْ",12,"د",1,0],["أبشر أبا أحمد بعُقبى","محمودةٍ أيُّها الحميدُ",13,"د",1,0],["أبْشارهنَّ وما ادَّرَعْ","نَ من الحرير معاً حريرُ",14,"ر",1,0],["أبشِرْ فإنك طودُ اللَّه أسَّسهُ","وشاد منه بناء غير منهار",15,"ر",1,0],["أبشرْ بأجرين تُوفَّاهما","غداً من اللَّه لدى الحشر",16,"ر",1,0],["أبشُّ وتعبسين وذاك بخسٌ","وليس يحل في الإسلام بخس",17,"س",1,0],["أبِشْرٌ بلا جدوى وأنت مخيلةٌ","مملَّأةٌ بالماء صادقة البرق",18,"ق",1,0],["أبشرْ به منبرَ العَروبةِ وان","ظُرهُ كأني أراهُ قد صعِدكْ",19,"ك",1,0],["أَبشِرْ بنيلِ المُنَى تهدي عرائسَها","إليك مُصحبةً فيها أمانيكا",20,"ك",2,0],["أبشِرْ فقد جادتْكَ مقبلةً","أيامُ مجدِ المُلْك والخِصْبُ",21,"ب",1,0],["أَبشِر بِعَونِ اللَهِ إِن تَكُ مُحسِناً","فَالمَرءُ يُحسِنُ طَرفَةً فَيُعانُ",22,"ن",1,0],["أبشره فيرقص في ضلوعي","وأنظر سود أيامي فأنعي",23,"ي",1,0],["أَبشِر بِهِ يَومَ فَتحٍ قَد أَضاءَ بِهِ","وَجهُ الزَّمانِ فَأَبدى بِشرَ مُبتَسِمِ",24,"م",1,0],["أَبِشرُكَ أَم ماءٌ يَسُحُّ وَبُستانُ","وَذِكرُكَ أَم راحٌ تُدارُ وَرَيحانُ",25,"ن",1,1],["أبشرِي مصرُ إنّنا الذّادةُ الحا","مونَ ننفِي الأذَى ونشفِي الخبَالا",26,"ل",2,0],["أبْشِرْ بخيرٍ غيرِ مقطوعِ الجنَى","مِن ربّكَ الأعلى ولا مَمْنونِهِ",27,"ه",1,0],["أبشِرْ ضمامُ فأنتَ جاوزتَ المدى","وبلغتَ في الحُسنَى المكان الأبعدا",28,"د",2,0],["أَبشِرْ فذلك ما سألتَ قضاهُ","رَبٌّ هداك فكنتَ عند هداهُ",29,"ا",2,1],["أَبشِر سَتَلقى غَدا سُعدى بِرُؤيَتِها","وَكُلُّ ما في غَدٍ دانٍ وَبَعدَ غَدٍ",30,"د",1,0],["إبشر أبا قاسمٍ إنّ العلى لَثَمَت","ثغرَ القوافي وجاءتها تواسيها",31,"ي",3,0],["أَبشِر بِرضوانٍ مِنَ اللَهِ مَن","قَدَّمَ هذا أَمِنَ السُخطا",32,"ط",2,0],["أبشر الناس بسفر زاهر","كأنه بنوره تجللا",33,"ل",2,0],["ابشر انت بحق الهوى","ام ريم قفر شارد ام ملك",34,"ك",1,0],["أبشر نفسي أن حوتْها عنايةٌ","لكم بالذي تبغي ويا حبذا البشرى",35,"ر",2,0],["أَبشِر بِسَبقِكَ مَن تَقَدَّمَ موقِناً","أَنَّ الفَضائِل لا العُصورَ تُقَدِّمُ",36,"م",1,0],["أبشر بقرب أمير المؤمنين ومن","قد أكمل اللّه فيه الدين إكمالا",37,"ل",2,0],["أبشر بفقرٍ وهتك سترٍ","وقبح ذكرٍ وسوء حال",38,"ل",1,0],["أَبشر ببشرى بابَها قد فتحا","سَعدك والمقدورُ فيها اصطلحا",39,"ح",2,1],["أبشرْ برضوان الإِله ولم يكنْ","يعطى امرأ خيراً من الرضوان",40,"ن",1,0],["أبشراي عادت للديار الحبائب","وبالبدر قد جاءت تحفّ الكواكب",41,"ب",1,1],["ابشر فسعدك وافى بيت عاشره","والعز حل به والنصر والظفر",42,"ر",1,0],["أَبشِر بهِ فَلِسان السَعد أَرَّخَه","صافاكَ عامُ العُلا وَالخيرِ توفيقُ",43,"ق",1,0],["أبشر وبشّر إذا ما أرخوه وطب","فالدهر أشرق والسلطان محمودُ",44,"د",1,0],["أبْشِرْ بِفرْدَوسِ الجِنَانِ فإِنَّها","للنَّاسِكِينَ مَسَاكِنٌ وَمَنازِلُ",45,"ل",1,0],["أَبشِر بِوِردِ الحَوضِ إِذ تَسقيكَهُ","يُمنى أَميرِ المُؤمِنينَ عَتيدا",46,"د",2,0],["أبشري يا دمشقُ بالأبطال","عاد اسد الثرى ليوث القتالِ",47,"ل",1,1],["أبشر بنور وشرح صدر","للحق والحفظ للعهود",48,"د",1,0],["أَبشَروا فَالسَعدُ خَدّامٌ مُطيعُ","لِلَّذي أَولاكُمُ القَدرَ السَني",49,"ي",1,0],["أَبشِر فَدَيتُ أَبا الحُسَينِ بِنِعمَةٍ","لو صادَفتَ يَوماً سِواكَ بِها اِفتَتَنَ",50,"ن",1,1],["أَبشِر بِاِسمي رُتبَةً قَد حَزَّتها","مِن فَضلِ مَولانا الخَليفَةُ مُرتَضيكِ",51,"ك",1,0],["اِبشِر بِعِزٍّ مُخَلَّدِ","وَاِشكُر لِرَبِّكَ أَحمَدِ",52,"د",1,1],["أَبشِر أَبا الخَطّابِ مَجدُكَ دائِمٌ","وَجَليلُ قَدرِكَ باذِخُ الدَرَجاتِ",53,"ت",1,1],["أَبشَرَ بِشَهرِ الصَومِ قَد","وافاكَ يَحمِلُ كُلُّ زَهوِ",54,"و",1,0],["أَبشر بِخَير هناً آت يؤرّخه","مِصباح سَعد وَفي أَوج الهَناء أَضا",55,"ض",2,0],["اِبشِر يِعُمر مَديد لا يُكَدّره","سوء وَدَهر سَعيد لَيسَ فيهِ رَدى",56,"د",2,0],["أبشروا بالخراب بعد الخراب","يا عقولاً مسلوبة الألبابِ",57,"ب",1,1],["أبشروا بالخراب صار شعار","يتعالى على \"كنيس الخرابِ\"",57,"ب",1,0],["أبْشري يا غابةَ الظُّلْمِ بخوفٍ","وارتكاسٍ في الرّزايَا وانكسار",58,"ر",1,0],["أَبْشرْ بُنيَّ فقد سمعتُ بشارةً","نُقلَتْ لنا بوسائل الإعلامِ",59,"م",1,0],["أبشرْ فإن الفجر سوف يُريق من","كأسِ الظلامِ شرابَك المنقوعا",60,"ع",2,0],["أبشر ، فلن يُخزيكَ ربك ،إنه","للأنبياءِ المرسلينَ عضيدُ",61,"د",1,0],["\"أبشِر\" هي الأملُ الكبيرُ منَحْتِه","روحاً فأشرقَ فجرُه الموْؤودُ",61,"د",1,0],["أبشر فإن الإِله بر","أعد للوافد الكرامة",62,"م",2,1],["أُبشِّر بالإِقبال نفسي وبالمنى","إذا وَقَعَتْ من لطفكمْ بقبول",63,"ل",1,0],["أبشر فإنك في الحياةِ مخلَّدٌ","يا من رأى يومَ القليبِ ولم يَمُتْ",64,"ت",1,0],["اِبشرْ بربحٍ حوتهُ فِطْنةٌ ونُهىً","فالخيرُ ما تجلبُ الألبابُ والفِطَن",65,"ن",1,0],["أبشِرْ ، فَعيدٌ ثالِثٌ نَسعى لَهُ","يأتي وَطِيبُكَ مِلأهُ يَتَضَوَّعُ!",66,"ع",1,0],["أَبْشِرْ بِبُشْرَى اللهِ جَلَّ جَلالُهُ","يا شَيْخَ آلِ مُحَمَّدٍ بأَوانِهِ",67,"ن",2,0],["أَبْشِري يا رُبَا أَزا","لَ بِما يُثْلِجُ الْمُهَجْ",68,"ج",1,0],["أبشر فقد نلت المنى يا مرقسُ","وبلغت ما تصبو إليه الانفسُ",69,"س",1,1],["أَبِشُحٍّ يقابل العَبد رَبّاً","أَم بقبح في يَقظة وَمَنام",70,"م",1,0],["أَبشر فَقَد أَنشدت مَصرٌ مؤرخةً","