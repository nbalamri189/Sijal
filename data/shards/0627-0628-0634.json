{"poems":[[77,"أبشر فقد نلت ما ترجو على عجل","https://www.aldiwan.net/poem36369.html","البسيط"],[77,"يا ابن الخلائف يا سمي محمد","https://www.aldiwan.net/poem36507.html","الكامل"],[77,"يا وارث المهدي في الجبل الذي","https://www.aldiwan.net/poem36511.html","الكامل"],[86,"أما أمين فقد ذقنا لمصرعه","https://www.aldiwan.net/poem10377.html","البسيط"],[86,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[71,"بكر الخليط إلى اللعين يعوده","https://www.aldiwan.net/poem3807.html","الكامل"],[83,"مولاي يوم الجمعه","https://www.aldiwan.net/poem54276.html","مجزوء الرجز"],[83,"يا أيها المولى الذي أيامه","https://www.aldiwan.net/poem54342.html","الكامل"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[51,"يا داعيا نحو العلاء مثوبا","https://www.aldiwan.net/poem9252.html","الكامل"],[51,"أبشر بفتح لك مفتوح","https://www.aldiwan.net/poem9415.html","السريع"],[51,"أصغى لما قلت الأصم الأصلخ","https://www.aldiwan.net/poem9439.html","الرجز"],[51,"قل لأمير المؤمنين المعتاد","https://www.aldiwan.net/poem10882.html","الرجز"],[51,"جرى لك الطائر السعيد","https://www.aldiwan.net/poem61859.html","مخلع البسيط"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[51,"أقول إذ قابلني وجهه","https://www.aldiwan.net/poem63994.html","السريع"],[51,"جفتني أن صددت ولي لديها","https://www.aldiwan.net/poem64587.html","الوافر"],[51,"رجت منك نفسي سبقك الغيث بالندى","https://www.aldiwan.net/poem65500.html","الطويل"],[51,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[62,"إن العلى لم تزل تبغي الكفي لها","https://www.aldiwan.net/poem52323.html","البسيط"],[62,"بعض التماسك أيها القلب","https://www.aldiwan.net/poem52504.html","أحذ الكامل"],[49,"كل امرئ فكما يدين يدان","https://www.aldiwan.net/poem63132.html","الكامل"],[97,"أجل أهواك أنت منى حياتي","https://www.aldiwan.net/poem25069.html","الوافر"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[74,"أبشرك أم ماء يسح وبستان","https://www.aldiwan.net/poem13268.html","الطويل"],[105,"أطلقوا قيدها وحلوا العقالا","https://www.aldiwan.net/poem43051.html","الخفيف"],[105,"جاء الرسول كتابه بيمينه","https://www.aldiwan.net/poem44005.html","الكامل"],[105,"أنخ البعير فقد بلغت المسجدا","https://www.aldiwan.net/poem44013.html","الكامل"],[105,"أبشر فذلك ما سألت قضاه","https://www.aldiwan.net/poem44207.html","الكامل"],[50,"يا بنت صقر بن قعقاع على كبدي","https://www.aldiwan.net/poem63874.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43720","السريع"],[113,"وحق من صيغ هذا الحلك","https://www.aldiwan.net/poem40602.html","عموديه"],[133,"لماذا أهاب الضيم أو أرهب الدهرا","https://www.aldiwan.net/poem49089.html","الطويل"],[141,"أما وسيفك في النفوس محكم","https://www.aldiwan.net/poem11810.html","الكامل"],[145,"الحمد لله تعظيما وإجلالا","https://www.aldiwan.net/poem47640.html","البسيط"],[148,"يا مدمن الخمر غير آل","https://www.aldiwan.net/poem68527.html","مخلع البسيط"],[158,"أبشر ببشرى بابها قد فتحا","https://www.aldiwan.net/poem58772.html","الرجز"],[158,"جمع الملا يحيى على القرآن","https://www.aldiwan.net/poem58850.html","الكامل"],[208,"أبشراي عادت للديار الحبائب","https://www.aldiwan.net/poem13467.html","الطويل"],[208,"بك المناصب في العلياء تفتخر","https://www.aldiwan.net/poem13551.html","البسيط"],[223,"مولاي وافاك عام مشرق بهج","https://www.aldiwan.net/poem55239.html","البسيط"],[257,"جلوس سلطاننا المسعود طالعه","https://www.aldiwan.net/poem35799.html","البسيط"],[273,"دنياك للأخرى سبيل سابل","https://www.aldiwan.net/poem25534.html","الكامل"],[280,"لا والمطايا يعتسفن البيدا","https://www.aldiwan.net/poem32795.html","الكامل"],[288,"أبشري يا دمشق بالأبطال","https://www.aldiwan.net/poem11669.html","الخفيف"],[302,"أقول للناظم المجيد","https://www.aldiwan.net/poem16873.html","مخلع البسيط"],[318,"أشرقت بالبشر أنوار التهاني","https://www.aldiwan.net/poem61663.html","الوافر"],[318,"أبشر فديت أبا الحسين بنعمة","https://www.aldiwan.net/poem67116.html","الكامل"],[318,"يا أيها الشهم الجليل ومن له","https://www.aldiwan.net/poem67169.html","الكامل"],[318,"ابشر بعز مخلد","https://www.aldiwan.net/poem67177.html","المجتث"],[318,"أبشر أبا الخطاب مجدك دائم","https://www.aldiwan.net/poem67179.html","الكامل"],[318,"يا أيها الشهم الذي","https://www.aldiwan.net/poem67207.html","الكامل"],[351,"زال العنا بتباشير المنى ومضى","https://www.aldiwan.net/poem40155.html","البسيط"],[359,"يا ابن الاماجد لا تخش الردى أبدا","https://www.aldiwan.net/poem68121.html","البسيط"],[397,"كنيس الخراب","https://www.aldiwan.net/poem6714.html","عموديه"],[397,"غابة الظلم","https://www.aldiwan.net/poem6751.html","عموديه"],[397,"أنا ناطق باسم الشباب","https://www.aldiwan.net/poem6794.html","عموديه"],[397,"رسالة إلى فرعون مصر","https://www.aldiwan.net/poem10305.html","عموديه"],[397,"رسالة اعتذار إلى أم المؤمنين خديجة (رضي الله عنها)","https://www.aldiwan.net/poem10309.html","عموديه"],[400,"أبشر فإن الإِله بر","https://www.aldiwan.net/poem33435.html","مخلع البسيط"],[413,"سقاك الحيا من أربع وطلول","https://www.aldiwan.net/poem54049.html","الطويل"],[456,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[459,"من مبلغ سلف الأجواد إذ سبقوا","https://www.aldiwan.net/poem16058.html","البسيط"],[463,"يا صاحب العيدين","https://www.aldiwan.net/poem36542.html","عموديه"],[527,"قولا لإبراهيم نجل محمد","https://www.aldiwan.net/poem37086.html","الكامل"],[527,"ذهب الظلم والهرج","https://www.aldiwan.net/poem37481.html","مجزوء الخفيف"]],"verses":[["أَبْشرْ فقد نِلْتَ مَا تَرْجُو عَلَى عَجَلِ","وَيَسَّر اللهُ مَا تَبْغِيهِ مِنْ أَمَلِ",0,"ل",1,1],["أبْشِرْ فأنتَ مجدِّدُ المُلْكِ الذي","لوْلاكَ أصْبَحَ وهْوَ رسْمٌ داثِرُ",1,"ر",1,0],["أبْشِرْ فإنّكَ بعْدَ ما بعُدَ المَدى","وتولّتِ الدُّنْيا مجَدِّدُ أمْرِهِ",2,"ر",2,0],["أَبشِر فَإِنَّكَ في أُخراكَ أَسعَدُنا","حَظّاً وَإِن كُنتَ في دُنياكَ أَشقانا",3,"ن",2,0],["أَبشِر فَإِنَّكَ ناجٍ","وَاِصبِر مَعَ الصابِرينا",4,"ن",2,0],["أَبشِر حَكَيتَ أَباكَ في أَفعالِهِ","وَأَظُنُّ نَجلَكَ بَعدَها يَحكيكا",5,"ك",2,0],["أبشرْ بصنع عاجلٍ","أعلامُهُ مرتفعَهْ",6,"ع",2,0],["أَبْشِرْ لجيشك بالسعادة كلّها","يَغزو ونصر الله تحت لوائهِ",7,"ه",1,0],["أبشرْ بكرٍّ عاجلٍ إنني","بالثَّأْرِ في أمثالها طالبُ",8,"ب",1,0],["أبشرْ أجارك من زمانك ماجدٌ","حبلُ الجوار لديه حبل مدمجُ",9,"ج",1,0],["أبْشِرْ بفتْح لكَ مَفْتُوحِ","مِنْ نَافح بالخيْر مَنفُوحِ",10,"ح",1,1],["أبشِرْ فما قَارَفْتَه مُسبَّخُ","عنك ونيران الصدورِ بُوَّخُ",11,"خ",1,0],["أبشرْ بكيد اللّه كلَّ كيادْ","عنك وعَمِّرْ كبقاءِ الأطوادْ",12,"د",1,0],["أبشر أبا أحمد بعُقبى","محمودةٍ أيُّها الحميدُ",13,"د",1,0],["أبْشارهنَّ وما ادَّرَعْ","نَ من الحرير معاً حريرُ",14,"ر",1,0],["أبشِرْ فإنك طودُ اللَّه أسَّسهُ","وشاد منه بناء غير منهار",15,"ر",1,0],["أبشرْ بأجرين تُوفَّاهما","غداً من اللَّه لدى الحشر",16,"ر",1,0],["أبشُّ وتعبسين وذاك بخسٌ","وليس يحل في الإسلام بخس",17,"س",1,0],["أبِشْرٌ بلا جدوى وأنت مخيلةٌ","مملَّأةٌ بالماء صادقة البرق",18,"ق",1,0],["أبشرْ به منبرَ العَروبةِ وان","ظُرهُ كأني أراهُ قد صعِدكْ",19,"ك",1,0],["أَبشِرْ بنيلِ المُنَى تهدي عرائسَها","إليك مُصحبةً فيها أمانيكا",20,"ك",2,0],["أبشِرْ فقد جادتْكَ مقبلةً","أيامُ مجدِ المُلْك والخِصْبُ",21,"ب",1,0],["أَبشِر بِعَونِ اللَهِ إِن تَكُ مُحسِناً","فَالمَرءُ يُحسِنُ طَرفَةً فَيُعانُ",22,"ن",1,0],["أبشره فيرقص في ضلوعي","وأنظر سود أيامي فأنعي",23,"ي",1,0],["أَبشِر بِهِ يَومَ فَتحٍ قَد أَضاءَ بِهِ","وَجهُ الزَّمانِ فَأَبدى بِشرَ مُبتَسِمِ",24,"م",1,0],["أَبِشرُكَ أَم ماءٌ يَسُحُّ وَبُستانُ","وَذِكرُكَ أَم راحٌ تُدارُ وَرَيحانُ",25,"ن",1,1],["أبشرِي مصرُ إنّنا الذّادةُ الحا","مونَ ننفِي الأذَى ونشفِي الخبَالا",26,"ل",2,0],["أبْشِرْ بخيرٍ غيرِ مقطوعِ الجنَى","مِن ربّكَ الأعلى ولا مَمْنونِهِ",27,"ه",1,0],["أبشِرْ ضمامُ فأنتَ جاوزتَ المدى","وبلغتَ في الحُسنَى المكان الأبعدا",28,"د",2,0],["أَبشِرْ فذلك ما سألتَ قضاهُ","رَبٌّ هداك فكنتَ عند هداهُ",29,"ا",2,1],["أَبشِر سَتَلقى غَدا سُعدى بِرُؤيَتِها","وَكُلُّ ما في غَدٍ دانٍ وَبَعدَ غَدٍ",30,"د",1,0],["إبشر أبا قاسمٍ إنّ العلى لَثَمَت","ثغرَ القوافي وجاءتها تواسيها",31,"ي",3,0],["أَبشِر بِرضوانٍ مِنَ اللَهِ مَن","قَدَّمَ هذا أَمِنَ السُخطا",32,"ط",2,0],["ابشر انت بحق الهوى","ام ريم قفر شارد ام ملك",33,"ك",1,0],["أبشر نفسي أن حوتْها عنايةٌ","لكم بالذي تبغي ويا حبذا البشرى",34,"ر",2,0],["أَبشِر بِسَبقِكَ مَن تَقَدَّمَ موقِناً","أَنَّ الفَضائِل لا العُصورَ تُقَدِّمُ",35,"م",1,0],["أبشر بقرب أمير المؤمنين ومن","قد أكمل اللّه فيه الدين إكمالا",36,"ل",2,0],["أبشر بفقرٍ وهتك سترٍ","وقبح ذكرٍ وسوء حال",37,"ل",1,0],["أَبشر ببشرى بابَها قد فتحا","سَعدك والمقدورُ فيها اصطلحا",38,"ح",2,1],["أبشرْ برضوان الإِله ولم يكنْ","يعطى امرأ خيراً من الرضوان",39,"ن",1,0],["أبشراي عادت للديار الحبائب","وبالبدر قد جاءت تحفّ الكواكب",40,"ب",1,1],["ابشر فسعدك وافى بيت عاشره","والعز حل به والنصر والظفر",41,"ر",1,0],["أَبشِر بهِ فَلِسان السَعد أَرَّخَه","صافاكَ عامُ العُلا وَالخيرِ توفيقُ",42,"ق",1,0],["أبشر وبشّر إذا ما أرخوه وطب","فالدهر أشرق والسلطان محمودُ",43,"د",1,0],["أبْشِرْ بِفرْدَوسِ الجِنَانِ فإِنَّها","للنَّاسِكِينَ مَسَاكِنٌ وَمَنازِلُ",44,"ل",1,0],["أَبشِر بِوِردِ الحَوضِ إِذ تَسقيكَهُ","يُمنى أَميرِ المُؤمِنينَ عَتيدا",45,"د",2,0],["أبشري يا دمشقُ بالأبطال","عاد اسد الثرى ليوث القتالِ",46,"ل",1,1],["أبشر بنور وشرح صدر","للحق والحفظ للعهود",47,"د",1,0],["أَبشَروا فَالسَعدُ خَدّامٌ مُطيعُ","لِلَّذي أَولاكُمُ القَدرَ السَني",48,"ي",1,0],["أَبشِر فَدَيتُ أَبا الحُسَينِ بِنِعمَةٍ","لو صادَفتَ يَوماً سِواكَ بِها اِفتَتَنَ",49,"ن",1,1],["أَبشِر بِاِسمي رُتبَةً قَد حَزَّتها","مِن فَضلِ مَولانا الخَليفَةُ مُرتَضيكِ",50,"ك",1,0],["اِبشِر بِعِزٍّ مُخَلَّدِ","وَاِشكُر لِرَبِّكَ أَحمَدِ",51,"د",1,1],["أَبشِر أَبا الخَطّابِ مَجدُكَ دائِمٌ","وَجَليلُ قَدرِكَ باذِخُ الدَرَجاتِ",52,"ت",1,1],["أَبشَرَ بِشَهرِ الصَومِ قَد","وافاكَ يَحمِلُ كُلُّ زَهوِ",53,"و",1,0],["أَبشر بِخَير هناً آت يؤرّخه","مِصباح سَعد وَفي أَوج الهَناء أَضا",54,"ض",2,0],["اِبشِر يِعُمر مَديد لا يُكَدّره","سوء وَدَهر سَعيد لَيسَ فيهِ رَدى",55,"د",2,0],["أبشروا بالخراب بعد الخراب","يا عقولاً مسلوبة الألبابِ",56,"ب",1,1],["أبشروا بالخراب صار شعار","يتعالى على \"كنيس الخرابِ\"",56,"ب",1,0],["أبْشري يا غابةَ الظُّلْمِ بخوفٍ","وارتكاسٍ في الرّزايَا وانكسار",57,"ر",1,0],["أَبْشرْ بُنيَّ فقد سمعتُ بشارةً","نُقلَتْ لنا بوسائل الإعلامِ",58,"م",1,0],["أبشرْ فإن الفجر سوف يُريق من","كأسِ الظلامِ شرابَك المنقوعا",59,"ع",2,0],["أبشر ، فلن يُخزيكَ ربك ،إنه","للأنبياءِ المرسلينَ عضيدُ",60,"د",1,0],["\"أبشِر\" هي الأملُ الكبيرُ منَحْتِه","روحاً فأشرقَ فجرُه الموْؤودُ",60,"د",1,0],["أبشر فإن الإِله بر","أعد للوافد الكرامة",61,"م",2,1],["أُبشِّر بالإِقبال نفسي وبالمنى","إذا وَقَعَتْ من لطفكمْ بقبول",62,"ل",1,0],["أبشر فإنك في الحياةِ مخلَّدٌ","يا من رأى يومَ القليبِ ولم يَمُتْ",63,"ت",1,0],["اِبشرْ بربحٍ حوتهُ فِطْنةٌ ونُهىً","فالخيرُ ما تجلبُ الألبابُ والفِطَن",64,"ن",1,0],["أبشِرْ ، فَعيدٌ ثالِثٌ نَسعى لَهُ","يأتي وَطِيبُكَ مِلأهُ يَتَضَوَّعُ!",65,"ع",1,0],["أَبْشِرْ بِبُشْرَى اللهِ جَلَّ جَلالُهُ","يا شَيْخَ آلِ مُحَمَّدٍ بأَوانِهِ",66,"ن",2,0],["أَبْشِري يا رُبَا أَزا","لَ بِما يُثْلِجُ الْمُهَجْ",67,"ج",1,0]]}