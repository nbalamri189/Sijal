{"poems":[[77,"أبشر فقد نلت ما ترجو على عجل","https://www.aldiwan.net/poem36369.html","البسيط"],[77,"يا ابن الخلائف يا سمي محمد","https://www.aldiwan.net/poem36507.html","الكامل"],[77,"يا وارث المهدي في الجبل الذي","https://www.aldiwan.net/poem36511.html","الكامل"],[86,"أما أمين فقد ذقنا لمصرعه","https://www.aldiwan.net/poem10377.html","البسيط"],[86,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[71,"بكر الخليط إلى اللعين يعوده","https://www.aldiwan.net/poem3807.html","الكامل"],[83,"مولاي يوم الجمعه","https://www.aldiwan.net/poem54276.html","مجزوء الرجز"],[83,"يا أيها المولى الذي أيامه","https://www.aldiwan.net/poem54342.html","الكامل"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[51,"يا داعيا نحو العلاء مثوبا","https://www.aldiwan.net/poem9252.html","الكامل"],[51,"أبشر بفتح لك مفتوح","https://www.aldiwan.net/poem9415.html","السريع"],[51,"أصغى لما قلت الأصم الأصلخ","https://www.aldiwan.net/poem9439.html","الرجز"],[51,"قل لأمير المؤمنين المعتاد","https://www.aldiwan.net/poem10882.html","الرجز"],[51,"جرى لك الطائر السعيد","https://www.aldiwan.net/poem61859.html","مخلع البسيط"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[51,"أقول إذ قابلني وجهه","https://www.aldiwan.net/poem63994.html","السريع"],[51,"جفتني أن صددت ولي لديها","https://www.aldiwan.net/poem64587.html","الوافر"],[51,"رجت منك نفسي سبقك الغيث بالندى","https://www.aldiwan.net/poem65500.html","الطويل"],[51,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[62,"إن العلى لم تزل تبغي الكفي لها","https://www.aldiwan.net/poem52323.html","البسيط"],[62,"بعض التماسك أيها القلب","https://www.aldiwan.net/poem52504.html","أحذ الكامل"],[49,"كل امرئ فكما يدين يدان","https://www.aldiwan.net/poem63132.html","الكامل"],[97,"أجل أهواك أنت منى حياتي","https://www.aldiwan.net/poem25069.html","الوافر"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[74,"أبشرك أم ماء يسح وبستان","https://www.aldiwan.net/poem13268.html","الطويل"],[105,"أطلقوا قيدها وحلوا العقالا","https://www.aldiwan.net/poem43051.html","الخفيف"],[105,"جاء الرسول كتابه بيمينه","https://www.aldiwan.net/poem44005.html","الكامل"],[105,"أنخ البعير فقد بلغت المسجدا","https://www.aldiwan.net/poem44013.html","الكامل"],[105,"أبشر فذلك ما سألت قضاه","https://www.aldiwan.net/poem44207.html","الكامل"],[50,"يا بنت صقر بن قعقاع على كبدي","https://www.aldiwan.net/poem63874.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43720","السريع"]],"verses":[["أَبْشرْ فقد نِلْتَ مَا تَرْجُو عَلَى عَجَلِ","وَيَسَّر اللهُ مَا تَبْغِيهِ مِنْ أَمَلِ",0,"ل",1,1],["أبْشِرْ فأنتَ مجدِّدُ المُلْكِ الذي","لوْلاكَ أصْبَحَ وهْوَ رسْمٌ داثِرُ",1,"ر",1,0],["أبْشِرْ فإنّكَ بعْدَ ما بعُدَ المَدى","وتولّتِ الدُّنْيا مجَدِّدُ أمْرِهِ",2,"ر",2,0],["أَبشِر فَإِنَّكَ في أُخراكَ أَسعَدُنا","حَظّاً وَإِن كُنتَ في دُنياكَ أَشقانا",3,"ن",2,0],["أَبشِر فَإِنَّكَ ناجٍ","وَاِصبِر مَعَ الصابِرينا",4,"ن",2,0],["أَبشِر حَكَيتَ أَباكَ في أَفعالِهِ","وَأَظُنُّ نَجلَكَ بَعدَها يَحكيكا",5,"ك",2,0],["أبشرْ بصنع عاجلٍ","أعلامُهُ مرتفعَهْ",6,"ع",2,0],["أَبْشِرْ لجيشك بالسعادة كلّها","يَغزو ونصر الله تحت لوائهِ",7,"ه",1,0],["أبشرْ بكرٍّ عاجلٍ إنني","بالثَّأْرِ في أمثالها طالبُ",8,"ب",1,0],["أبشرْ أجارك من زمانك ماجدٌ","حبلُ الجوار لديه حبل مدمجُ",9,"ج",1,0],["أبْشِرْ بفتْح لكَ مَفْتُوحِ","مِنْ نَافح بالخيْر مَنفُوحِ",10,"ح",1,1],["أبشِرْ فما قَارَفْتَه مُسبَّخُ","عنك ونيران الصدورِ بُوَّخُ",11,"خ",1,0],["أبشرْ بكيد اللّه كلَّ كيادْ","عنك وعَمِّرْ كبقاءِ الأطوادْ",12,"د",1,0],["أبشر أبا أحمد بعُقبى","محمودةٍ أيُّها الحميدُ",13,"د",1,0],["أبْشارهنَّ وما ادَّرَعْ","نَ من الحرير معاً حريرُ",14,"ر",1,0],["أبشِرْ فإنك طودُ اللَّه أسَّسهُ","وشاد منه بناء غير منهار",15,"ر",1,0],["أبشرْ بأجرين تُوفَّاهما","غداً من اللَّه لدى الحشر",16,"ر",1,0],["أبشُّ وتعبسين وذاك بخسٌ","وليس يحل في الإسلام بخس",17,"س",1,0],["أبِشْرٌ بلا جدوى وأنت مخيلةٌ","مملَّأةٌ بالماء صادقة البرق",18,"ق",1,0],["أبشرْ به منبرَ العَروبةِ وان","ظُرهُ كأني أراهُ قد صعِدكْ",19,"ك",1,0],["أَبشِرْ بنيلِ المُنَى تهدي عرائسَها","إليك مُصحبةً فيها أمانيكا",20,"ك",2,0],["أبشِرْ فقد جادتْكَ مقبلةً","أيامُ مجدِ المُلْك والخِصْبُ",21,"ب",1,0],["أَبشِر بِعَونِ اللَهِ إِن تَكُ مُحسِناً","فَالمَرءُ يُحسِنُ طَرفَةً فَيُعانُ",22,"ن",1,0],["أبشره فيرقص في ضلوعي","وأنظر سود أيامي فأنعي",23,"ي",1,0],["أَبشِر بِهِ يَومَ فَتحٍ قَد أَضاءَ بِهِ","وَجهُ الزَّمانِ فَأَبدى بِشرَ مُبتَسِمِ",24,"م",1,0],["أَبِشرُكَ أَم ماءٌ يَسُحُّ وَبُستانُ","وَذِكرُكَ أَم راحٌ تُدارُ وَرَيحانُ",25,"ن",1,1],["أبشرِي مصرُ إنّنا الذّادةُ الحا","مونَ ننفِي الأذَى ونشفِي الخبَالا",26,"ل",2,0],["أبْشِرْ بخيرٍ غيرِ مقطوعِ الجنَى","مِن ربّكَ الأعلى ولا مَمْنونِهِ",27,"ه",1,0],["أبشِرْ ضمامُ فأنتَ جاوزتَ المدى","وبلغتَ في الحُسنَى المكان الأبعدا",28,"د",2,0],["أَبشِرْ فذلك ما سألتَ قضاهُ","رَبٌّ هداك فكنتَ عند هداهُ",29,"ا",2,1],["أَبشِر سَتَلقى غَدا سُعدى بِرُؤيَتِها","وَكُلُّ ما في غَدٍ دانٍ وَبَعدَ غَدٍ",30,"د",1,0],["إبشر أبا قاسمٍ إنّ العلى لَثَمَت","ثغرَ القوافي وجاءتها تواسيها",31,"ي",3,0],["أَبشِر بِرضوانٍ مِنَ اللَهِ مَن","قَدَّمَ هذا أَمِنَ السُخطا",32,"ط",2,0]]}