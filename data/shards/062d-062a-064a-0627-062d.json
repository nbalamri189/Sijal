{"poems":[[55,"لا ترقدن على الأذى","https://www.aldiwan.net/poem30194.html","مجزوء الكامل"],[68,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[50,"لما طوى الليل حواشي برده","https://www.aldiwan.net/poem63252.html","الرجز"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62279","البسيط"],[102,"بين ذهاب ومعاد","https://www.poetsgate.com/ViewPoem.aspx?id=50188",""],[102,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[164,"ما خيب الله فيه للورى أملا","https://www.aldiwan.net/poem58899.html","البسيط"],[173,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[199,"بانت سعاد وليس الود ينصرم","https://www.aldiwan.net/poem54418.html","البسيط"],[353,"لا تأخذن عنها السروج واللجم","https://www.aldiwan.net/poem20682.html","الرجز"],[415,"أرجأت كتبي إلى حين اللقاء فقد","https://www.aldiwan.net/poem31838.html","البسيط"],[510,"القضيّة","https://www.aldiwan.net/poem27792.html","البسيط"],[566,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96697","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64989","السريع"],[1353,"","https://poetry.dctabudhabi.ae/diwan/poem/124299","البسيط"],[1355,"","https://poetry.dctabudhabi.ae/diwan/poem/31375","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118421","الطويل"],[2852,"","https://poetry.dctabudhabi.ae/diwan/poem/142919","البسيط"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102176","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112648","الرجز"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26115","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85257","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40154","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28725","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139708",""],[4764,"كبوة جواد","https://www.poetsgate.com/ViewPoem.aspx?id=34021",""],[4858,"ففرّوا إلى الله","https://www.poetsgate.com/ViewPoem.aspx?id=142279",""],[4869,"بشار الاسد وحمزه كاشغري وباقي الفئران ...","https://www.poetsgate.com/ViewPoem.aspx?id=151705",""],[4927,"قصيدة لعيني عُروة وعَفْراء","https://www.poetsgate.com/ViewPoem.aspx?id=29954",""],[5092,"بالجرحِ أكتملُ","https://www.poetsgate.com/ViewPoem.aspx?id=163044",""],[5145,"حكم اعتساف قضية الأزمان","https://www.poetsgate.com/ViewPoem.aspx?id=108117",""],[5409,"هدأ الدجى لولا أنين عليل","https://www.poetsgate.com/ViewPoem.aspx?id=155307",""],[5431,"ماأفظعك!","https://www.poetsgate.com/ViewPoem.aspx?id=191352",""],[5842,"حلب 2013 / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=137040",""],[5956,"أدواء بسرعة الأضواء","https://www.poetsgate.com/ViewPoem.aspx?id=202751",""],[6102,"شاخ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=184417",""]],"verses":[["حَتّى أَحَدَّ لَكُم حُسا","ماً قاطِعاً نَغَضَ الرُؤوسا",0,"س",2,0],["حَتّى أَحاطَ بَنو المَمالِكِ كُلِّها","عِلماً بِأَنَّكَ قَد وَفَيتَ بِعَهدِهِ",1,"د",2,0],["حَتّى اِحتَوى العَينَ وَلَمّا يُردِهِ","فَنَحنُ أَضيافُ حُسامَي غِمدِهِ",2,"د",2,0],["حَتَّى احْتَوَى بِكْرَهَا بِالجَوِّ مُطَّرِدٌ","سَمَعْمَعٌ أَهْرَتُ الشِّدْقَيْنِ زُهْلُولُ",3,"ل",1,0],["حتّى احتوى شخصيهما مخدع","غضّ كأفراح الصبا الوارف",4,"ف",1,0],["حتى احتستسها شفاه الباب ، ولا أحد","يومي اليه ، ولا قلب له ، يجف",5,"ف",1,0],["حتى احتجبتَ وقالوا مسّه ألم","فلا تسائل بهذا القولِ ما فعلا",6,"ل",2,0],["حَتّى اِحتَوى ما اِصطَفاهُ مِن عَقائِلَها","غَصباً وَهانَ عَلَيهِ رَغمُ مَن رَغِما",7,"م",2,0],["حَتّى اِحتَبى بِمَكانٍ تَستَقيدُ لَهُ","عَماعِمُ العَرَبِ المَذكورَةِ العُظُمُ",8,"م",1,0],["حتَّى أَحَسَّ الظَّبيُ في بَيْدائهِ","سَوْطَ عَذابٍ صُبَّ مِن سَمائهِ",9,"ه",1,0],["حتّى أحاطت بي الأشواق واشتملت","عليّ واستحوذت من كلّ أرجائي",10,"ا",3,0],["حتى أحاديث صلحِها قد انكفأتْ","عنه وبشهوةِ الكرسيِّ تحترقُ",11,"ق",1,0],["حَتّى اِحتَداهُ سَنَنُ الدَبورِ","وَالظِلُ في جَحرٍ مِنَ الجُحورِ",12,"ر",1,0],["حتى أحلاه وأهدراه","وأطلقا القتل لمن أتاه",13,"ه",1,0],["حتّى اِحتشت أرضُ البغاةِ ضراغماً","وَصَوارماً ولهاذماً وسنابكا",14,"ك",2,0],["حتى أَحالَ الشَّيبُ حالي وما","حالَتْ صَباباتي وأَشْجاني",15,"ن",2,0],["حتّى أحُطّ لدى مغناه أرحُلَنا","فاستطيب ثواءً حيث طاب ثوى",16,"ث",3,0],["حَتّى أَحُلَّ بِوادي مَن يُحاذِرُني","فَيَستَفيدوا وَلَو أَتعَبتُهُم خَبَبا",17,"ب",2,0],["حتى احط لدى مفناه ارحلها","فاستطيب ثواء حيث طاب ثوي",18,"و",2,0],["حتى أُحمَّل همّ الليل مغترباً","وزراً تنوء به أكتاف جبار",19,"ر",1,0],["حتى أحاطت بالحسين ولم تكن","حفضت بذاك نبيها وكتابها",20,"ب",3,0],["حتى أحالوا الجوّ نقعاً أكدَرا","والأرضَ من دمّ الأعادي أبحُرا",21,"ر",2,0],["حَتّى اِحتَمَلنَ وَقَد تَقَدَّمَ سارِحٌ","لِلحيِّ سارَ أَمامهُنَ بَريدا",22,"د",2,0],["حتى احتوى الملك مروان وورثه","لنسله بعده حتى بهم عرفا",23,"ف",2,0],["حتى احتوى بن علي كلما ادخروا","من الكنوز وحاز الملك والتحفا",23,"ف",2,0],["حَتّى أَحَلْن الشّامَ شاماً صَرصَرَت","فيهِ جَنادِبُها وَصَدَّحَ هامُها",24,"م",3,0],["حَتَّى أَحَلَّت بِدارِ الملكِ داهِيَةً","شابَ اِبنُ عِشرينَ مِنها وَاِشتَكى الكِبَرا",25,"ر",2,0],["حتى احتواها والملا لهجت بها","فالكلُّ لاغٍ وهو ليس بلاغي",26,"غ",2,0],["حتى احساسي فقدته والتحدي والعناد","طال فيه الصبر لما ملني والصبر مل",27,"ل",1,0],["حتّى احتوتْك شراكُ الإثمِ مُفْعَمَةً","بكلّ ما يهدمُ الأخلاق والأدبا",28,"ب",2,0],["حتى احصدوآ وآطي ذبحنآ كلآمه","حمزه كآشغري زوّد المر بامرآر",29,"ر",1,0],["حَتَّىْ أُحَلِّقَ، وَالْغَرَاْمُ يَمُدُّ لِيْ","مَدَداً، فَأُشْعِلُ فِي الدُّجَىْ مِصْبَاْحَاْ",30,"ح",2,0],["حتّى أحاديثنا يا بوحُ  مصمصةٌ-","حتّى قصائدنا قد لاكها الغزلُ",31,"ل",1,0],["حتى أحلّ بأرض جاسٍ بأسه","فدحا بذروتها إلى الغيطان",32,"ن",1,0],["حتى أحال الدهر ساحةَ دارها","كهف الخطوب ومسرح التمثيل",33,"ل",1,0],["حتى أحرر مهجتي من سجنها","أحتاج ساطورا يهشم أضلعك!",34,"ك",1,0],["حتى أحالَ بَهاها مَرتَعَاً خَرِباً","تَجني القَوارضُ فيه عيشَها اللََجِبَا",35,"ب",2,0],["حتى أحسَّك رافلاً بهناءةٍ","وبصحةٍ تخلو من الضَّرَّاءِ",36,"ا",2,0],["حَتَّى احْتِبَاسُ الشَّوقِ فِيَّ - بَلَاهَةً -","يَرْنُو لِأَنْ تَجْثُو إِلَيهِ لِيَسْفَعَكْ !",37,"ك",1,0]]}