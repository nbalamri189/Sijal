t/poem22981.html","البسيط"],[46,"الناس مثل الماء تضربه الصبا","https://www.aldiwan.net/poem22989.html","الكامل"],[46,"إلهنا الحق خفف واشف من وصب","https://www.aldiwan.net/poem23395.html","البسيط"],[1,"وإنا إذا ما الغيم أمسى كأنه","https://www.aldiwan.net/poem34005.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85488","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140860",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39577","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16654","الوافر"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21135","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42508","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42566","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42606","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42661","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55080","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55177","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55162","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67317","الطويل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/178136","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54293","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54257","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54254","البسيط"],[98,"سائل العلياء عنا والزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=35379",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[91,"حكاية قديمة","https://www.poetsgate.com/ViewPoem.aspx?id=53010",""],[99,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[51,"أصبحتَ عاديتَ للصبا رشدكْ","https://www.poetsgate.com/ViewPoem.aspx?id=30012",""],[105,"يا منذر السور غض الصوت إن لنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54937&r=&rc=107",""],[18,"كُلَيْبُ لاَ خَيْرَ في الدُّنْيَا وَمَنْ فِيهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26474&r=&rc=40",""]],"verses":[["نَرى الأَيّامَ وَهيَ غَداً سِنونٌ","وَبِالآحادِ يَبلُغنَ المِئينا",0,"ن",2,0],["نَرجو الخُلودَ وَباقينا عَلى ظَعِن","وَالدارُ قاذِفَةٌ بِالزَورِ مِظعانُ",1,"ن",1,0],["نُريهِم صُدورَ السُمرِ بَينَ نُحورِهِم","فَما اِستَيقَظوا إِلّا بِقَرعِ الحَلاقِمِ",2,"م",1,0],["نَرى سَريراً يَحمِلُ الأَناما","وَالسُؤدَدَ القُدامِسَ القُداما",3,"م",2,0],["نَروغُ عَن طَلَبِ الدُنيا وَتَطلُبُنا","مَدى الزَمانِ بِأَرماحٍ مِنَ الأَجَلِ",4,"ل",1,0],["نَرجو البَقاءَ كَأَنَّنا لَم نَختَبِر","عاداتِ هَذا العالَمِ المَجبولِ",5,"ل",1,0],["نَرجو وَبَعضُ رَجاءِ الناسِ مَتعَبَةٌ","قَد ضاعَ دَمعُكَ يا باكٍ عَلى الطَلَلِ",6,"ل",1,0],["نَرجو وَنَخشى حُلوَها وَمُرَّها","كَجَمَّةِ الماءِ نُرَجّي غَمرَها",7,"ر",3,0],["نَرى مَنعَكُم جُوداً وَمَطلَكُمُ جَداً","وَإِذلالُكُم عِزّاً وَإِمرارَكُم شَهدا",8,"د",2,0],["نُراعُ إِذا ما شيكَ أَخمَصُ بَعضِنا","وَأَقدامُنا ما بَينَ شَوكِ العَقارِبِ",9,"ب",1,0],["نَروغُ كَما راغَ الطَرائِدُ دونَها","وَتَجلُبُنا عوداً إِلَيها الجَوالِبُ",10,"ب",1,0],["نَرى الشُمَّ مِن آنافِنا في وُجوهِهِم","وَأَعناقُنا طالَت بِهِنَّ المَناصِبُ",10,"ب",1,0],["نَرى الأَقدارَ جاريَةً بِأَمرٍ","يَريبُ ذَوِي العُقولِ بِما يَريبُ",11,"ب",1,0],["نَرقُبُ الأُفقَ فَلا يَبدو بِهِ","لامِعٌ مِن نورِ هادٍ مُستَثيبِ",12,"ب",1,0],["نَراكَ تَطلُبُ لا هَوناً وَلا كَثَباً","وَلا نَرى لَكَ مِن مالٍ وَلا نَشَبِ",13,"ب",1,0],["نَرجو حَياةً حُرَّةً","مَضمونَةً في ظِلِّ رايَه",14,"ا",3,0],["نَراهُ أَمامَ النورِ وَهوَ إِمامُ","وَأَكرِم بِأَيّامِ العُقابِ السَوالِفِ",15,"ف",1,0],["نرجوك إما ساتراً لرؤوسنا","أو كاشفاً لمظالم الفجار",16,"ر",1,0],["نَرْجُو لَهَا الإِقْبَالَ فِي أَيَّامِهِمْ","وَلَهُمْ دَوامُ السَّعْدِ وَالإِقْبالِ",17,"ل",1,0],["نَرى فيها إِذا اِنتَصَبَت إِلَينا","مَشابِهَ فيكِ مِن كَحَلٍ وَجيدِ",18,"د",1,0],["نَروح ونغدو كل يوم وعندها","رواحٌ علينا دائمٌ وبكورُ",19,"ر",1,0],["نراك على بُعد تُسامين ذِلةً","فيحزُننا أن لم نكن منك بالقُرب",20,"ب",1,0],["نراك بأيديهم على الخلق حجةً","وأنت عليهم حجة لا على الخلق",21,"ق",1,0],["نرى وجهها بدراً محاطاً من السَنى","بصبحَيْن من ثغر وضيءٍ ومن نحر",22,"ر",1,0],["نراك إذا ضممت الطفل لوحاً","يفوق جميع ألواح الحياة",23,"ه",1,0],["نرى جهل الفتاة لها َعفافاً","كأن الجهل ِحصنٌ للفتاة",23,"ه",1,0],["نراعي الحق في سلم وحرب","ونترك في مغارمنا التجازي",24,"ي",1,0],["نروح كما نغدو نجاهد دونها","أموراً دعتنا لارتكاب الجرائم",25,"م",1,0],["نَرمي الغُرابَ إِذا رَأى بِرِكابِنا","جُلَبَ الصِفاحِ وَدامِياتٍ بِالكُلى",26,"ا",1,0],["نَرى شِرباً لَهُ شُرُعٌ عِذابٌ","فَنُمنَعُ وَالقُلوبُ لَهُ صَوادي",27,"ي",1,0],["نَرضى عَنِ اللَهِ أَنَّ الناسَ قَد عَلِموا","أَن لَن يُفاخِرَنا مِن خَلقِهِ بَشَرُ",28,"ر",1,0],["نُرِيهِم مِن مَحَاسِنِهَا وَمِمَّا","نَخَافُ مِنَ المَسَاوِىء ما أُرِينَا",29,"ن",2,0],["نَرعاهُ ما طُرِّقَت بِحَملٍ","أُنثى وَما أَطفَلَت بَغومُ",30,"م",1,0],["نرى الفضل يفنى عن أناسٍ وإنما","لك الفضلُ يحيى يا ابن جعفر خالدا",31,"د",2,0],["نروم من برّه نقوطاً","والحكم للراء أن تنقط",32,"ط",1,0],["نرعى عهودك في حلٍّ ومرتحلٍ","رعيَ ابن أيوب حال اللائذ الشاكي",33,"ك",2,0],["نردّ مجاري الدمع والبشر واضح","كوابل غيثٍ في ضحى الشمس قد همى",34,"م",2,0],["نُرسله لاشتراء فاكهةٍ","فقَصْرُنا أن تجيئَنا كتُبُهْ",35,"ب",2,0],["نُراعُ إذا لاحت نجومُ مشيبنا","كأن نجوم الليل مُنكدراتُ",36,"ت",1,0],["نرحِّلُ آمالاً إلى باب قاسمٍ","فيرجعنَ أموالاً عِراض المبارك",37,"ك",1,0],["نرتاح منه إلى الأذان كما","يرتاح ذو شُقَّةٍ إلى علمِ",38,"م",1,0],["نُراعُ إذا ما الدهرُ صاح فنَرْعوِي","وإن لم يَصِحْ يوماً براتعنا خضمْ",39,"م",1,0],["نَرعاهُ إِن خافَ أَقوامٌ وَإِن أَمِنوا","وَفي القَبائِلِ عَنهُ غَيرَنا كَرَمُ",40,"م",1,0],["نَرجو الخَلاصَ بِغاشِمٍ مِن غاشِمٍ","لا يُنقَذُ النَخّاسَ مِن نَخّاسِ",41,"س",1,0],["نَرشُفُ الماءَ نَميراً","نَلقُطُ الحَبَّ النَثير",42,"ر",1,0],["نَرضى بِحُكمِ الأَكثَرِيَّةِ مِثلَما","يَرضى الوَليدُ الظُلمَ مِن أَبَوَيهِ",43,"ي",2,0],["نَرجو سِجالاً مِنَ المَعروفِ تَنفَحُها","لِسائِليكَ فَلا مَنٌّ وَلا حَسَدُ",44,"د",1,0],["نَرى زُهرَها في مأتمٍ كُلَّ لَيلَةٍ","يُخَمّشنَ لَهَفاً وَسطَهُ صَفحَةَ البَدرِ",45,"ر",1,0],["نريد من الايام مجدا مؤثلا","ولو كان ذاك المجد في مرتقى الشهب",46,"ب",1,0],["نريد ظلا يقينا الحر من شجر","لم يبق اخضر منه اليوم املود",47,"د",1,0],["نرجو من الله في ايامه رشدا","في الدين في العلم في الاخلاق في الادب",48,"ب",1,0],["نريد من الكروب بها خلاصاً","وعن دار الهوان بها ارتحالا",49,"ل",2,0],["نرجو به وبهم لمصرٍ بَعثة","ولرب عصر في المهود تجددا",50,"د",2,0],["نرى الشحناء بينهم عتابا","ونحسب جدهم فيها مزاحا",51,"ح",2,0],["نرتجى منه للديار اعتزازا","وجدير بأن يُعز الديار",52,"ر",1,0],["نرى المجال صعبا","ذئب يعض ذئبا",53,"ب",2,0],["نرحو بحلمي أن سنعلو وأن","تبقى معاليا ليوم القيام",54,"م",1,0],["نَرومُ لِمِصرَ عِزّاً لا يُرامُ","يَرِفُّ عَلى جَوانِبِه السَلامُ",55,"م",1,0],["نُرسِلُ اللَحنَ كُلَّهُ","مُبدِعاً فيهِ مُغرِبا",56,"ب",2,0],["نَرومُ الغايَةَ القُصوى فَنَمضي","وَأَنتَ عَلى الطَريقِ هُوَ الزِمامُ",57,"م",1,0],["نُراوِحُ بِالحَوادِثِ أَو نُغادى","وَنُنكِرُها وَنُعطيها القِيادا",58,"د",2,1],["نَرجو إِذا التَعليمُ حَرَّكَ شَجوَهُ","أَلّا يَكونَ عَلى البِلادِ بَخيلا",59,"ل",2,0],["نَرى بِهِ القَومَ في عِزٍّ وَفي ضَعَةٍ","وَالمُلكَ ما بَينَ إِدبارٍ وَإِقبالِ",60,"ل",1,0],["نُرَوَّعُ ما نُرَوَّعُ ثُمَّ نُرمى","بِسَهمٍ مِن يَدِ المَقدورِ آتي",61,"ي",1,0],["نُريها في الضَميرِ هَوىً وَحُبّاً","وَنُسمِعُها التَبرُّمَ وَالمَلالا",62,"ل",2,0],["نَرى لَكِ في السَماءِ خَضيبَ قَرنٍ","وَلا نُحصي عَلى الأَرضِ الطَعينا",63,"ن",2,0],["نَرى عِظَماً بِالبَينِ وَالصَدُّ أَعظَمُ","وَنَتَّهِمُ الواشينَ وَالدَمعُ مِنهُمُ",64,"م",1,1],["نرشّ عليه من ماء لطيف","يعيش به ويسخنه بلينِ",65,"ن",1,0],["نُرَجّي أَن يُتاحَ لَنا مَسيرٌ","كَما تَرجو المُفاداةَ الأَسارى",66,"ر",2,0],["نَرمُقُها مِن كَثَبٍ حَسرَةً","كَأَنَّنا لَفظٌ بِلا مَعنى",67,"ن",2,0],["نَرجو مُقارَبَةَ الحَبيبِ وَدونُهُ","وَخدٌ يُبَرِّحُ بِالمَهارى القودِ",68,"د",1,0],["نُريهِ كَيفَ نَسيمُ الشُكرِ مُحتَضَراً","أَكنافُهُ وَيُرينا كَيفَ نامُلُهُ",69,"ل",2,0],["نَروضُ أَنفُسَنا أَقصى رِياضَتِها","عَلى مُواتاةِ دَهرٍ لا يُواتينا",70,"ن",2,0],["نَراهُ مُبارَكاً جُمِعَت عَلَيهِ","مَحَبّاتُ البَرِيَّةِ أَجمَعينا",71,"ن",2,0],["نرفض الشعر كيمياءً وسحر","قتلتنا القصيدة الكيمياء",72,"ا",2,0],["نرفض الشعر مسرحاً ملكي","من كراسيه يحرم البسطاء",72,"ا",2,0],["نرفض الشعر أن يكون حصان","يمتطيه الطغاة والأقوياء",72,"ا",2,0],["نرفض الشعر عتمةً ورموز","كيف تسطيع أن ترى الظلماء؟",72,"ا",2,0],["نرفض الشعر أرنباً خشبي","لا طموح له ولا أهواء",72,"ا",2,0],["نرفض الشعر في قهوة الشعر..","دخانٌ أيامهم.. وارتخاء",72,"ا",2,0],["نَراكَ إذا كان النَّدى في قَلِيبهِ","رشاءٌ فإن يَعلُ اتَّخذناك سُلَّما",73,"م",2,0],["نَرى الثُّرَيَّا والبَدْرُ في قَرَنٍ","كما يُحَيَّا بِنَرْجِسٍ مَلِكُ",74,"ك",1,0],["نَروعُ بأسيافِ المُدامِ هُمومَنا","كأنَّا بأسيافِ الوزيرِ نَروعُها",75,"ع",3,0],["نَرى كُلَّ ما ساءَنا دائِباً","عَلى كُلِّ ما سَرَّنا يَغلِبُ",76,"ب",1,0],["نَرى الخَلقَ في طَبَقاتِ البِلى","إِذا ما هُمُ صَعَّدوا صَوَّبوا",76,"ب",3,0],["نُريدُ بَقاءً وَالخُطوبُ تَكيدُ","وَلَيسَ المُنى لِلمَرءِ كَيفَ يُريدُ",77,"د",1,1],["نَرى اللَيالِيَ وَالأَيّامَ مُسرِعَةً","فينا وَفيكِ بِتَفريقٍ وَتَبعيدِ",78,"د",1,0],["نُرَجّي خُلودَ العَيشِ حيناً وَضِلَّةً","وَلَم نَرَ مِن آبائِنا مِن مُخَلَّدِ",79,"د",1,0],["نَرى الأَموالَ أَرباباً عَلَينا","وَما هِيَ بَينَنا إِلّا عِوارِ",80,"ر",1,0],["نَرى الشَهَواتِ غالِبَةً عَلَينا","وَعِندَ المُتَّقينَ لَهُنَّ تَركُ",81,"ك",1,0],["نَرى وَكَأَنّا لا نَرى كُلَّ ما نَرى","كَأَنَّ مُنانا لِلعُيونِ شُجونُ",82,"ن",1,0],["نَرُدُّ حُدودَ المُرهَفاتِ كَلَيلَةً","وَتَفتُكُ فينا أَعيُنٌ وَجُفونُ",83,"ن",1,0],["نَرومُ وُعودَ الجودِ مِنهُ وَقَد غَدَت","لَدى المَلِكِ المَنصورِ وَهيَ دُيونُ",83,"ن",1,0],["نَرشُقُها مِن تَحتِها بِبُندُقٍ","يَعرُجُ كَالشُهبِ إِلَيها واصِلا",84,"ل",2,0],["نرى الشمسَ ذائبةً في المحيط","وننتظر البدرَ في المرتقَى",85,"ق",2,0],["نرى الشمس ذائبة في العباب","وننتظر البدر في المرتقى",86,"ق",2,0],["نردّد تسليماً عليك محبّةً","وإن كنتَ لم تَرْدُدْ سلامَ المسلّمِ",87,"م",1,0],["نريدُ ل