يق","https://www.aldiwan.net/poem34307.html","المنسرح"],[558,"لمتى تموه بالمهاة وبالرشا","https://www.aldiwan.net/poem34430.html","الكامل"],[558,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[560,"قلوب ودروب","https://www.aldiwan.net/poem67273.html","عموديه"],[562,"أتى مثل موسى حينما عاد من مصر","https://www.aldiwan.net/poem52768.html","الطويل"],[562,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[562,"أرى فتنة الدنيا هي الآية الكبرى","https://www.aldiwan.net/poem52811.html","الطويل"],[562,"نادى حمى الملك حسبي عزة وكفى","https://www.aldiwan.net/poem52828.html","البسيط"],[562,"تذكرت صفو زمان عبر","https://www.aldiwan.net/poem52831.html","المتقارب"],[562,"مللت من القريض وقلت يكفي","https://www.aldiwan.net/poem52844.html","البسيط"],[562,"من يقرب النار لا يسلم من الحرق","https://www.aldiwan.net/poem52861.html","البسيط"],[562,"كثير العمر في الدنيا قليل","https://www.aldiwan.net/poem52877.html","الكامل"],[562,"أقول اليوم صار الشرق شرقا","https://www.aldiwan.net/poem52881.html","البسيط"],[562,"من كان منك أميرا أيها الرمم","https://www.aldiwan.net/poem52895.html","البسيط"],[562,"المرء في الدنيا خيال قد سرى","https://www.aldiwan.net/poem52910.html","الكامل"],[562,"رأى أطلالهم دمعي فسالا","https://www.aldiwan.net/poem52925.html","الوافر"],[562,"قفا بين الثنية والمصلى","https://www.aldiwan.net/poem52929.html","الوافر"],[562,"سلام الله أيتها القباب","https://www.aldiwan.net/poem52930.html","الوافر"],[562,"أقول لعطفها عند النهوض","https://www.aldiwan.net/poem52931.html","الوافر"],[562,"مدامع جفن الصب إحدى الفواضح","https://www.aldiwan.net/poem52955.html","الطويل"],[562,"نفارقكم ونضرب في البلاد","https://www.aldiwan.net/poem52988.html","الوافر"],[575,"حمزة كلب يعوي","https://www.aldiwan.net/poem2795.html","مجزوء الرجز"],[575,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"]],"verses":[["نَرى الأَيّامَ وَهيَ غَداً سِنونٌ","وَبِالآحادِ يَبلُغنَ المِئينا",0,"ن",2,0],["نَرجو الخُلودَ وَباقينا عَلى ظَعِن","وَالدارُ قاذِفَةٌ بِالزَورِ مِظعانُ",1,"ن",1,0],["نُريهِم صُدورَ السُمرِ بَينَ نُحورِهِم","فَما اِستَيقَظوا إِلّا بِقَرعِ الحَلاقِمِ",2,"م",1,0],["نَرى سَريراً يَحمِلُ الأَناما","وَالسُؤدَدَ القُدامِسَ القُداما",3,"م",2,0],["نَروغُ عَن طَلَبِ الدُنيا وَتَطلُبُنا","مَدى الزَمانِ بِأَرماحٍ مِنَ الأَجَلِ",4,"ل",1,0],["نَرجو البَقاءَ كَأَنَّنا لَم نَختَبِر","عاداتِ هَذا العالَمِ المَجبولِ",5,"ل",1,0],["نَرجو وَبَعضُ رَجاءِ الناسِ مَتعَبَةٌ","قَد ضاعَ دَمعُكَ يا باكٍ عَلى الطَلَلِ",6,"ل",1,0],["نَرجو وَنَخشى حُلوَها وَمُرَّها","كَجَمَّةِ الماءِ نُرَجّي غَمرَها",7,"ر",3,0],["نَرى مَنعَكُم جُوداً وَمَطلَكُمُ جَداً","وَإِذلالُكُم عِزّاً وَإِمرارَكُم شَهدا",8,"د",2,0],["نُراعُ إِذا ما شيكَ أَخمَصُ بَعضِنا","وَأَقدامُنا ما بَينَ شَوكِ العَقارِبِ",9,"ب",1,0],["نَروغُ كَما راغَ الطَرائِدُ دونَها","وَتَجلُبُنا عوداً إِلَيها الجَوالِبُ",10,"ب",1,0],["نَرى الشُمَّ مِن آنافِنا في وُجوهِهِم","وَأَعناقُنا طالَت بِهِنَّ المَناصِبُ",10,"ب",1,0],["نَرى الأَقدارَ جاريَةً بِأَمرٍ","يَريبُ ذَوِي العُقولِ بِما يَريبُ",11,"ب",1,0],["نَرقُبُ الأُفقَ فَلا يَبدو بِهِ","لامِعٌ مِن نورِ هادٍ مُستَثيبِ",12,"ب",1,0],["نَراكَ تَطلُبُ لا هَوناً وَلا كَثَباً","وَلا نَرى لَكَ مِن مالٍ وَلا نَشَبِ",13,"ب",1,0],["نَرجو حَياةً حُرَّةً","مَضمونَةً في ظِلِّ رايَه",14,"ا",3,0],["نَراهُ أَمامَ النورِ وَهوَ إِمامُ","وَأَكرِم بِأَيّامِ العُقابِ السَوالِفِ",15,"ف",1,0],["نرجوك إما ساتراً لرؤوسنا","أو كاشفاً لمظالم الفجار",16,"ر",1,0],["نَرْجُو لَهَا الإِقْبَالَ فِي أَيَّامِهِمْ","وَلَهُمْ دَوامُ السَّعْدِ وَالإِقْبالِ",17,"ل",1,0],["نَرى فيها إِذا اِنتَصَبَت إِلَينا","مَشابِهَ فيكِ مِن كَحَلٍ وَجيدِ",18,"د",1,0],["نَروح ونغدو كل يوم وعندها","رواحٌ علينا دائمٌ وبكورُ",19,"ر",1,0],["نراك على بُعد تُسامين ذِلةً","فيحزُننا أن لم نكن منك بالقُرب",20,"ب",1,0],["نراك بأيديهم على الخلق حجةً","وأنت عليهم حجة لا على الخلق",21,"ق",1,0],["نرى وجهها بدراً محاطاً من السَنى","بصبحَيْن من ثغر وضيءٍ ومن نحر",22,"ر",1,0],["نراك إذا ضممت الطفل لوحاً","يفوق جميع ألواح الحياة",23,"ه",1,0],["نرى جهل الفتاة لها َعفافاً","كأن الجهل ِحصنٌ للفتاة",23,"ه",1,0],["نراعي الحق في سلم وحرب","ونترك في مغارمنا التجازي",24,"ي",1,0],["نروح كما نغدو نجاهد دونها","أموراً دعتنا لارتكاب الجرائم",25,"م",1,0],["نَرمي الغُرابَ إِذا رَأى بِرِكابِنا","جُلَبَ الصِفاحِ وَدامِياتٍ بِالكُلى",26,"ا",1,0],["نَرى شِرباً لَهُ شُرُعٌ عِذابٌ","فَنُمنَعُ وَالقُلوبُ لَهُ صَوادي",27,"ي",1,0],["نَرضى عَنِ اللَهِ أَنَّ الناسَ قَد عَلِموا","أَن لَن يُفاخِرَنا مِن خَلقِهِ بَشَرُ",28,"ر",1,0],["نُرِيهِم مِن مَحَاسِنِهَا وَمِمَّا","نَخَافُ مِنَ المَسَاوِىء ما أُرِينَا",29,"ن",2,0],["نَرعاهُ ما طُرِّقَت بِحَملٍ","أُنثى وَما أَطفَلَت بَغومُ",30,"م",1,0],["نرى الفضل يفنى عن أناسٍ وإنما","لك الفضلُ يحيى يا ابن جعفر خالدا",31,"د",2,0],["نروم من برّه نقوطاً","والحكم للراء أن تنقط",32,"ط",1,0],["نرعى عهودك في حلٍّ ومرتحلٍ","رعيَ ابن أيوب حال اللائذ الشاكي",33,"ك",2,0],["نردّ مجاري الدمع والبشر واضح","كوابل غيثٍ في ضحى الشمس قد همى",34,"م",2,0],["نُرسله لاشتراء فاكهةٍ","فقَصْرُنا أن تجيئَنا كتُبُهْ",35,"ب",2,0],["نُراعُ إذا لاحت نجومُ مشيبنا","كأن نجوم الليل مُنكدراتُ",36,"ت",1,0],["نرحِّلُ آمالاً إلى باب قاسمٍ","فيرجعنَ أموالاً عِراض المبارك",37,"ك",1,0],["نرتاح منه إلى الأذان كما","يرتاح ذو شُقَّةٍ إلى علمِ",38,"م",1,0],["نُراعُ إذا ما الدهرُ صاح فنَرْعوِي","وإن لم يَصِحْ يوماً براتعنا خضمْ",39,"م",1,0],["نَرعاهُ إِن خافَ أَقوامٌ وَإِن أَمِنوا","وَفي القَبائِلِ عَنهُ غَيرَنا كَرَمُ",40,"م",1,0],["نَرجو الخَلاصَ بِغاشِمٍ مِن غاشِمٍ","لا يُنقَذُ النَخّاسَ مِن نَخّاسِ",41,"س",1,0],["نَرشُفُ الماءَ نَميراً","نَلقُطُ الحَبَّ النَثير",42,"ر",1,0],["نَرضى بِحُكمِ الأَكثَرِيَّةِ مِثلَما","يَرضى الوَليدُ الظُلمَ مِن أَبَوَيهِ",43,"ي",2,0],["نَرجو سِجالاً مِنَ المَعروفِ تَنفَحُها","لِسائِليكَ فَلا مَنٌّ وَلا حَسَدُ",44,"د",1,0],["نَرى زُهرَها في مأتمٍ كُلَّ لَيلَةٍ","يُخَمّشنَ لَهَفاً وَسطَهُ صَفحَةَ البَدرِ",45,"ر",1,0],["نريد من الايام مجدا مؤثلا","ولو كان ذاك المجد في مرتقى الشهب",46,"ب",1,0],["نريد ظلا يقينا الحر من شجر","لم يبق اخضر منه اليوم املود",47,"د",1,0],["نرجو من الله في ايامه رشدا","في الدين في العلم في الاخلاق في الادب",48,"ب",1,0],["نريد من الكروب بها خلاصاً","وعن دار الهوان بها ارتحالا",49,"ل",2,0],["نرجو به وبهم لمصرٍ بَعثة","ولرب عصر في المهود تجددا",50,"د",2,0],["نرى الشحناء بينهم عتابا","ونحسب جدهم فيها مزاحا",51,"ح",2,0],["نرتجى منه للديار اعتزازا","وجدير بأن يُعز الديار",52,"ر",1,0],["نرى المجال صعبا","ذئب يعض ذئبا",53,"ب",2,0],["نرحو بحلمي أن سنعلو وأن","تبقى معاليا ليوم القيام",54,"م",1,0],["نَرومُ لِمِصرَ عِزّاً لا يُرامُ","يَرِفُّ عَلى جَوانِبِه السَلامُ",55,"م",1,0],["نُرسِلُ اللَحنَ كُلَّهُ","مُبدِعاً فيهِ مُغرِبا",56,"ب",2,0],["نَرومُ الغايَةَ القُصوى فَنَمضي","وَأَنتَ عَلى الطَريقِ هُوَ الزِمامُ",57,"م",1,0],["نُراوِحُ بِالحَوادِثِ أَو نُغادى","وَنُنكِرُها وَنُعطيها القِيادا",58,"د",2,1],["نَرجو إِذا التَعليمُ حَرَّكَ شَجوَهُ","أَلّا يَكونَ عَلى البِلادِ بَخيلا",59,"ل",2,0],["نَرى بِهِ القَومَ في عِزٍّ وَفي ضَعَةٍ","وَالمُلكَ ما بَينَ إِدبارٍ وَإِقبالِ",60,"ل",1,0],["نُرَوَّعُ ما نُرَوَّعُ ثُمَّ نُرمى","بِسَهمٍ مِن يَدِ المَقدورِ آتي",61,"ي",1,0],["نُريها في الضَميرِ هَوىً وَحُبّاً","وَنُسمِعُها التَبرُّمَ وَالمَلالا",62,"ل",2,0],["نَرى لَكِ في السَماءِ خَضيبَ قَرنٍ","وَلا نُحصي عَلى الأَرضِ الطَعينا",63,"ن",2,0],["نَرى عِظَماً بِالبَينِ وَالصَدُّ أَعظَمُ","وَنَتَّهِمُ الواشينَ وَالدَمعُ مِنهُمُ",64,"م",1,1],["نرشّ عليه من ماء لطيف","يعيش به ويسخنه بلينِ",65,"ن",1,0],["نُرَجّي أَن يُتاحَ لَنا مَسيرٌ","كَما تَرجو المُفاداةَ الأَسارى",66,"ر",2,0],["نَرمُقُها مِن كَثَبٍ حَسرَةً","كَأَنَّنا لَفظٌ بِلا مَعنى",67,"ن",2,0],["نَرجو مُقارَبَةَ الحَبيبِ وَدونُهُ","وَخدٌ يُبَرِّحُ بِالمَهارى القودِ",68,"د",1,0],["نُريهِ كَيفَ نَسيمُ الشُكرِ مُحتَضَراً","أَكنافُهُ وَيُرينا كَيفَ نامُلُهُ",69,"ل",2,0],["نَروضُ أَنفُسَنا أَقصى رِياضَتِها","عَلى مُواتاةِ دَهرٍ لا يُواتينا",70,"ن",2,0],["نَراهُ مُبارَكاً جُمِعَت عَلَيهِ","مَحَبّاتُ البَرِيَّةِ أَجمَعينا",71,"ن",2,0],["نرفض الشعر كيمياءً وسحر","قتلتنا القصيدة الكيمياء",72,"ا",2,0],["نرفض الشعر مسرحاً ملكي","من كراسيه يحرم البسطاء",72,"ا",2,0],["نرفض الشعر أن يكون حصان","يمتطيه الطغاة والأقوياء",72,"ا",2,0],["نرفض الشعر عتمةً ورموز