[5869,"اعذب الألفاظ","https://www.poetsgate.com/ViewPoem.aspx?id=57075",""],[5906,"أختاه","https://www.poetsgate.com/ViewPoem.aspx?id=188222",""],[5956,"الطائرة المنكوبة","https://www.poetsgate.com/ViewPoem.aspx?id=193917",""],[5961,"قرت عيون الساري","https://www.poetsgate.com/ViewPoem.aspx?id=199773",""],[242,"أزف الرحيل فخانني صبري","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563697",""],[6213,"شفرة الذباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76306&r=&rc=54",""],[5126,"مرفوعة إلى صاحب الجلالة الملك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87829&r=&rc=44",""]],"verses":[["اللهُ حَسْبُكَ يَا أَبَا يَحْيَ فَقَدْ","أَحيَيْتَ رَسْمَ الْمَجْدِ بَعْدَ ذَهَابِ",0,"ب",1,0],["الله حاطك في مسير","ك ثم حاطك في سراك",1,"ك",1,0],["اللهُ حاطَ بِكَ الثُّغورَ وأهلَها","ورَآكَ واقيةَ الهُدى فَوَقاكا",2,"ك",2,0],["أَللَهُ حَيٌّ قَديمٌ قادِرٌ صَمَدُ","فَلَيسَ يَشركهُ في مُلكِهِ أَحَدُ",3,"د",1,1],["اللهُ حَرَّمَها ودَافعَ دُونها","مَن ذا يُدافِعُ ربَّه ويُرادي",4,"د",2,0],["الله حَسْبُكِ إن عَنَتْكِ مَضرَّةٌ","مِمّن يَخونُكِ أو عَرَتْكِ أَذاةُ",5,"ه",1,0],["اللَهُ حافِظُهُ وَهُم أَنصارُهُ","جَعَلوا ذخائرَهُ بأكرمِ موضعِ",6,"ع",1,0],["اللَهُ حَرَّمَ كُلَّ فاحِشَةٍ فَلا","شَعبٌ يُباعُ وَلا بِلادٌ توهَبُ",7,"ب",1,0],["اللَهُ حَسبي أَبَعدَ وَدي","حلفت أَلّا تَكلميني",8,"ي",1,0],["اللَّهُ حَسْبُكُمُ وَحَسْبِي إنني","في كلِّ مُعْضِلَةٍ بِكُمْ أتَحَسَّبُ",9,"ب",1,0],["الله حسبك أي يوم لم تجد","نعما مجددة وأية حين",10,"ن",1,0],["اللَّه حكّمهُ به فتحكّما","اللَّهُ قَد صلّى عليهِ وسلّما",11,"م",2,0],["اللهَ حَادِي الرَّكْبِ فِي خَلَدِي","اللهَ حَادِي الرَّكْبِ فِي أَمْرِي",12,"ر",2,0],["اللَّهُ حَسْبُكَ فِي احْتِسَابِكَ لا","بِيضٌ تَسيلُ دَماً ولا أُسُلُ",13,"ل",1,0],["الله حسبي لقد أشبهت (حيدرة)","يُمنى بكل اضطهاد من تولاك",14,"ك",1,0],["اللَه حسبي الإله الأكرم","ومصطفاه الهادي المقدم",15,"م",1,0],["اللَه حسبي وكفى","قل ما تشا يا ذا الفضول",16,"ل",1,0],["اللَه حسبي وكفى","قال ما تشا يا ذا الفضول",16,"ل",1,0],["اللّه حَسبي فكلّ الناسِ تَحسَبُهم","قولاً وجميعاً وتُلفي فِعلهم فِرقا",17,"ق",2,0],["اللهُ حارسُ ما أَولاكَ من نِعَمٍ","إذا الملوكُ اتَّقَوا يَوماً بحُرّاس",18,"س",1,0],["الله حسبي غياثي خالقي وكفى","علمه بحالي فلست أحتاج أفشيها",19,"ي",3,0],["اللّه حافظه وحافظ أهله","ما حاولت إطفاءه الأعداء",20,"ا",2,0],["اللَهُ حسبُك والسَبعُ الحَوامِيمُ","تحوي بها سبعةً هي الأَقاليمُ",21,"م",1,1],["اللَه حرم قتلي في الهوى سفهاً","وأنت يا قاتلي ظلماً تحلله",22,"ل",2,0],["اللّهُ حَسبُك كيف سِرْتَ إلى العُلا","ما بينَ أنيابِ الحِمامِ وظُفْرِهِ",23,"ر",2,0],["اللّهُ حسبُك كم غفَرْتَ لمُذنِبٍ","منهم وكم أطلَقْتَ من مَصفودِ",24,"د",1,0],["الله حق وأغيارُهْ عدمْ باطلْ","والفاعل الله ربي والسوى عاطلْ",25,"ل",1,1],["الله حدى بك في غزير اليالي","من يوم حامشت البعير وصالي",26,"ل",2,0],["اللّه حي لا يزال ولم يزل","في ذاته وبذاته ولذاته",27,"ت",2,1],["اللّه حي لا بمعنى زائد","فيه قديم غير نفي مماته",27,"ت",2,0],["الله حباه وشرّفه","بالقرب تناط به القرب",28,"ب",1,0],["اللَه حسب سميدع حسناته","نارٌ على حُساده ودخان",29,"ن",1,0],["الله حكّمها فينا وأحكمها","فما لها عن نفوذِ حكمه وزرُ",30,"ر",1,0],["اللهُ حَقًّا فِي السَّمَاءِ وَعِلمُهُ","سُبحَانَهُ حَقًّا بِكُلِّ مَكَانِ",31,"ن",1,0],["الله حسبي لا أريد سواه","هل في الوجود الحق إلا الله",32,"ه",1,1],["اللّه حسبي ثم حسبي عبهل","يسمو إلى العليا أبوه عبهل",33,"ل",1,0],["اللَه حسبك حيث قد أنقذتني","من لوعة الشوق الذي أنا فيه",34,"ي",2,0],["اللَه حارسه من كل نازلةٍ","وفي رعايته باليمن مؤتمن",35,"ن",1,0],["الله حسبي على الدُنيا وما فعلت","في آل عثمان أَو في ملك عثمانِ",36,"ن",1,0],["الله حسبي في حياة صبُحها","ومساؤها الآلام والأحزان",37,"ن",1,0],["اللَهُ حقٌّ وأمر البعث مُعتقدي","يا جاحد البعث غادر عنك إنكارا",38,"ر",2,0],["الله حسيب اللِّي خذوه وسروا به","ياليتهم خلوّه وإلا خذوني",39,"ن",2,0],["الله حسيبه يوم عرض القواوير ..",".. والله حسبي من صواب مكيني",40,"ن",2,0],["اللهُ حبَاكِ بقُدرِتِهِ","حسنًا صاغَتْكِ به يدُهُ",41,"د",2,0],["الله حقق من رجائك مطلبا","سيظل من كل المطالب أكبر",42,"ر",1,0],["الله حبٌّ دائمٌ.. متولّدٌ","ويُحبُّ من بين النفوسِ كبيرَها",43,"ر",3,0],["الله حسيبك كيف قلبك صار","باع المحبه وأشتري فيها",44,"ي",3,0],["اللهُ .. حزبُ اللهِ ..عامٌ واحِدٌ","اللهُ .. نصْرُ اللهِ.. والقرآنُ",45,"ن",1,0],["الله حاميهم والكرب مندثرٌ","والنصر آت فما في بأسهم هزموا",46,"م",3,0],["الله حسيبك قمت أنا أحمل مصايبك","وأنا الغريق وحاملٍ هم ناجي",47,"ج",2,0],["الله حسبك يا ابن عم محمدٍ","فلسمط مدحك ذي اللآلئ تصلح",48,"ح",1,0],["اللهُ حُبٌّ والخليقةُ نفحةٌ","لولاكِ لا لَمْ يخلُقِ الأكوانا",49,"ن",2,0],["الله حيٌّ لايموت تجلجلت","فتجملوا بالصبر ذاك مفيد",50,"د",1,0],["اللهُ حُبِّي وَسُلْوَانِي وَمَا فَتِئَتْ","رُوحِي مَدَىَ العُمْرِ فِي شَوْقٍ تُغَنِّيهَا",51,"ي",3,0],["الله حَسبُك يا أُخْتاهُ في حَلَبِ","شيعيَّةً كُنتِ أَمْ سُنِّيَةَ النَّسَبِ ِ",52,"ب",1,1],["اللهُ حَسبُكِ ما في القَومِ مُعْتَصِمٌ","حَتى يُجيبَ نِداءَ العِرضِ والوَصَبِ",52,"ب",1,0],["الله حَتَّم أن نحاول إنما","كتب المحاولة اليؤوس وفوزها",53,"ه",2,0],["الله حي دائم يعطي المريد القائم","بالذكر ثم الصائم التارك الأوزار",54,"ر",1,0],["اللَهُ حادي الرَكبِ في جَلَدي","اللَهُ حادي الرَكبِ في أَمري",55,"ر",2,0],["الله حذرنا وقال بأنهم","نكثوا العهود بمجمل الإفصاح",56,"ح",1,0],["الله حلاك بالتوفيق، موهبة","منه، فأنت -بلا- ريب موفقه",57,"ق",2,0]]}