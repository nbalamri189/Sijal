{"poems":[[74,"سرت قمرا من مسبل الشعر في جنح","https://www.aldiwan.net/poem18478.html","الطويل"],[53,"يعان المستعين بك البعيد","https://www.aldiwan.net/poem10001.html","الوافر"],[87,"مررنا بالهلال على كريد","https://www.aldiwan.net/poem6830.html","الوافر"],[47,"وقالوا ما الذي يرضيك منه","https://www.aldiwan.net/poem62657.html","الوافر"],[76,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[53,"ُعانُ المُستعينُ بِكَ البعيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=27436",""],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[173,"أفي كل دار لي عدو أصاوله","https://www.aldiwan.net/poem1645.html",""],[275,"أدنتي لماذا قلت شر بلاء","https://www.aldiwan.net/poem35215.html","الطويل"],[275,"ألا تذكرين ضياء القمر","https://www.aldiwan.net/poem35463.html","المتقارب"],[409,"قال حبيبي لم أطلت الجفا","https://www.aldiwan.net/poem33458.html","السريع"],[438,"يقول وأبصر حالي الحسود","https://www.aldiwan.net/poem12621.html","المتقارب"],[466,"ولما تلاقينا وللشوق سورة","https://www.aldiwan.net/poem15931.html","الطويل"],[500,"علي أن لا أريح العيش والقتبا","https://www.aldiwan.net/poem9763.html","البسيط"],[556,"من كلفي أنني مررت به","https://www.aldiwan.net/poem47393.html","المنسرح"],[558,"أيا سرور وأنت يا حزن","https://www.aldiwan.net/poem68412.html","المنسرح"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59627","الوافر"],[1114,"","https://poetry.dctabudhabi.ae/diwan/poem/124083","الطويل"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29577","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53127","المتقارب"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28528","الطويل"],[3089,"","https://poetry.dctabudhabi.ae/diwan/poem/111604","الطويل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46017","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114491","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127122","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83482","البسيط"],[5638,"فلتفخري مصرُ","https://www.poetsgate.com/ViewPoem.aspx?id=198248",""],[5742,"تزوج بأخرى","https://www.poetsgate.com/ViewPoem.aspx?id=206949",""],[6075,"الأميرة والفتى العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=213306",""]],"verses":[["فقلت رأيت السمر أقومَ ما ترى","إذا صبرت عند النفاق من اللقح",0,"ح",1,0],["فقلتُ رأى قَديمي فيه نَقْصٌ","فلست أحبُّه ما عادَ عيدُ",1,"د",1,0],["فقلت رويدكم هلا ذكرتم","شبيها كان أمس هنا فزالا",2,"ل",2,0],["فَقُلتُ رِضايَ في الإِحسانِ عَنهُ","فَقالوا لَيسَ تَرضى أَو تَموتا",3,"ت",2,0],["فَقُلتُ رُوَيداً لاتُراعي فَإِنَّنا","لَنَطوي ضُلوعَ اللَيلِ مِنّا عَلى سِرِّ",4,"ر",1,0],["فقلتُ رأى قديمي فيه نقْضٌ","فلست أحبُّه ما عادَ عيدُ",5,"د",1,0],["فقلت رأيت ابن النبي على يدي","لادفنه حيا ببعض المقابر",6,"ر",1,0],["فَقُلتُ رُوَيداً إِنَّهُ اِبنُ مُحمَّدٍ","وَإِن ساءَني إِعراضُهُ وَتَغافُلُه",7,"ل",2,0],["فقلتُ رُوَيداً ما غريقٌ يهولُهُ","حِمامٌ كمُبتَلٍّ بقطرةِ ماء",8,"ا",2,0],["فقلتِ رُوَيدَكَ إنَّ جمالي","تَقِيهِ الملائكُ شرَّ البشر",9,"ر",1,0],["فقلت رفقاً إنه لم يزل","لي نحوكم في كل حين وصول",10,"ل",1,0],["فقلتُ رويدَك أوردتَني","مواردَ ما دونَها مصدرُ",11,"ر",1,0],["فقلت رئيس لدين أم جونة الضحى","لها بين أسْتارِ البيوتِ ضياءُ",12,"ا",2,0],["فقلت ردي قناع الصبر إن لنا","إليك أوبة مشتاق ومنقلبا",13,"ب",2,0],["فقلت رفقاً فلستَ أوّلُ مَن","لاذ مُسيءٌ بعفوه فعفا",14,"ف",2,0],["فَقُلتُ رَوحي مُكاتِمٌ جَسَدي","حُبِّيَ وَالحُبُّ فيهِ مُختَزَنُ",15,"ن",1,0],["فَقُلت رُبَّما يقضي مِن هُنا","بَعد قَضاء وَطري رُجوعنا",16,"ن",2,0],["فقلتُ رضايَ عنه وفضلُ ربيّ","وسائل لا يخيبُ بها انتصار",17,"ر",1,0],["فقلت رمتني تحت ترس ومغفر","بسهم به برح الهوى في الحشى أرسى",18,"س",2,0],["فَقُلتُ رُوَيداً قَد صَدَقتَ وَذَلِكُم","إِذا لَم يَكُن فيهِ لِحامِلِهِ طِبُّ",19,"ب",1,0],["فقلت رضيت بهذا العذاب","وإتلافك القلب ما دمت تدري",20,"ر",2,0],["فَقُلتُ رَأَيتُ المالَ يَبلى حُطامُهُ","وَتَبقى أَحاديثُ الرِّجالِ مَعَ الدَّهرِ",21,"ر",1,0],["فقلت رأى ذاك الجمال فهابه","فحط خضوعاً مثلما خضع العبد",22,"د",1,0],["فَقُلتُ رُوَيداً يا أَبا الأبرد اِتَّئد","فَلَم يَكُ قوتُ النّمرِ صَمصامَةً مِثلي",23,"ل",2,0],["فَقُلتُ رومٌ فإذ أتت به بَهَرَت","فقُلتُ سبحانَ ربٍّ خالقٌ صانِعُ",24,"ع",1,0],["فقلت رضي الدين تعنين من له","إلى المرتضى قرب سناه منير",25,"ر",1,0],["فَقُلت رُؤياي حقّ حينَ أذكرها","أَروي الحَديثَ بها عن سيّد البَشَرِ",26,"ر",1,0],["فَقُلْتُ: رُوَيْدًا إِنَّ دَمْعَكِ ثَائِرٌ","وَإِنَّ بَنِيكِ الأُسْدَ حَتْمًا لَهُمْ جَمْرُ",27,"ر",1,0],["فقلت رويدا كيف كان نبينا","يعدد فانظر سيرة الزوجة الكبرى",28,"ر",2,0],["فَقُلْتُ رُدِّي فُؤَادِي إِنَّنِي وَلِهٌ","وَإِنَّ فِي قُبْلَةِ الْمُشْتَاقِ إِحْيَاءَه",29,"ا",3,0]]}