{"poems":[[74,"برغمي أن غاض الندى بكماله","https://www.aldiwan.net/poem19530.html","الطويل"],[72,"حتى متى وإلى متى","https://www.aldiwan.net/poem42433.html","مجزوء الكامل"],[7,"يا دار مية بالعلياء فالسند","https://www.aldiwan.net/poem2003.html","البسيط"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116971","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54325","الخفيف"],[435,"الخيل عزوفي صهواتها الشرف","https://www.aldiwan.net/poem40706.html","البسيط"],[543,"لله إخوان بقلبي ذهبوا","https://www.aldiwan.net/poem47541.html","عموديه"],[543,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"],[639,"","https://poetry.dctabudhabi.ae/diwan/poem/144434","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48827","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[2543,"","https://poetry.dctabudhabi.ae/diwan/poem/123749","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97998","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86495","الخفيف"],[4702,"الحرف مايبلش وانا راعي الشان","https://www.poetsgate.com/ViewPoem.aspx?id=156955",""],[4750,"المماشي","https://www.poetsgate.com/ViewPoem.aspx?id=180415",""],[4805,"حكمه","https://www.poetsgate.com/ViewPoem.aspx?id=176602",""],[4869,"مثلي مثل هالناس","https://www.poetsgate.com/ViewPoem.aspx?id=151518",""],[4869,"لا يارفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=151523",""],[5401,"أبو جهل","https://www.poetsgate.com/ViewPoem.aspx?id=85475",""],[5629,"يارب","https://www.poetsgate.com/ViewPoem.aspx?id=184597",""],[5677,"ماطار طير الا ورفرف جناحه","https://www.poetsgate.com/ViewPoem.aspx?id=139672",""],[4442,"ميزانكم حاد عن الصواب","https://www.poetsgate.com/ViewPoem.aspx?id=171207",""],[6102,"خلخال","https://www.poetsgate.com/ViewPoem.aspx?id=182738",""],[6115,"قالو عللامك مع الأيام متغير","https://www.poetsgate.com/ViewPoem.aspx?id=180495",""],[5309,"لا يرتقي بلد ما فيه انتاج","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573906",""],[6257,"بدويّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87175&r=&rc=0",""]],"verses":[["وإلا دموع من جفون كأنها","تردّ على مثواه فيض نواله",0,"ل",2,0],["وَالآدَمِيُّ مُرَوَّعٌ","أَبَداً بِتِلكَ الحَسرَتَينِ",1,"ن",1,0],["وَالأُدمَ قَد خُيِّسَت فُتلاً مَرافِقُها","مَشدودَةً بِرِحالِ الحيرَةِ الجُدُدِ",2,"د",1,0],["والآدَمِيُّ بهذا الكسبِ مرتَهَنٌ","لهُ رقيبٌ على الأسرارِ يطِّلِعُ",3,"ع",1,0],["والأديبُ الذي له فطنة المصر","يّ زانت سليقة البدويّ",4,"ي",1,0],["والأدهم الفرد مثل الطود هيكله","مولىً بثوبٍ من الظلماءِ ملتحفُ",5,"ف",1,0],["والأدبُ الغَضُّ إذا يمَّمتَه","فكُن لأزهَارِه ذَا تَنَشُّق",6,"ق",1,0],["والأديبُ الأديبُ لم يَحتفِل تِل","قاء عزٍّ بِفضَّةٍ أو نُضارِ",7,"ر",1,0],["والأديبَ الذي بأشعاره الآ","دابُ مثلُ الغُصونِ في الأوراق",8,"ق",1,0],["والأدعياء الأنانيون عدتهم","هوج الأراجيف لا صدق البراهين",9,"ن",1,0],["والأدبا تقول علم شهر","وحسرة الإنسان طول الدهر",10,"ر",1,0],["والاد إن افردتها او ركبت","كالثلث في مراتب قد ثلثت",11,"ت",1,0],["والادبُ الذي على البادي وجب","تصديقَ شيخه عموماً في الطلب",11,"ب",1,0],["والأديب الذي به كنت أعت","د غزاني للحين فيمن غزاني",12,"ن",2,0],["وإلّا دراري الأُفقِ ضمنَ سفينةٍ","تسيرُ يلُجٍّ من زخارِفِ أنفاسِ",13,"س",1,0],["والادهان لشعر جاء في خبر","فافعله ان شئت غبا لاعلى الدوم",14,"م",1,0],["والا دموعا يعلم اللَه سرها","لماذا جرت من زاملٍ لزميل",15,"ل",1,0],["والأديب المدعو صريع الغواني","لو رآها لغادرته صريعا",16,"ع",2,0],["والاد شاطر ايضًا لكل عدوان","فرسان فالميدان والدِّين خِيره",17,"ر",2,0],["والأدمي ماهوب يدري بسدات الغيوب","وارد الما مايدلّه ياكود مصّدره",18,"ر",2,0],["والادمي عزه ب فعله ودينه","دام النوايا غيب والظن وسواس",19,"س",1,0],["والآدمي / يولد وتحتاج درّاس","حتى يكمّل ما اخلقت به نصابه",20,"ب",2,0],["والآدمي ماهو لكل شي يشتاق","تكفي حروفه عن مقاريد الارقام",21,"م",1,0],["والآدمي لو كما الموتر يجيله ربَلْ","يمكن تفادى المطبّه دائما لن سهى",22,"ه",2,0],["‎والادمي دنياة صفحة وتدوين،","‎من ينولد حتى يعوُد دراجه",23,"ج",2,0],["والادمي متى نقر بنجاحه","اليا نجح معنا جميع .. ومع الغير",24,"ر",1,0],["والادمي ماطال لولا كفاحه","الطايله مابين جمع المناعير",24,"ر",1,0],["والأدب الفني عندي نسب","تنمى أليه سائر الأحزاب",25,"ب",1,0],["وَالأَدِيمُ الجَدِيبُ يُنبِتُ وَردًا","وَمُرُوجُ الخَيالِ تُصبِحُ أَبهَجْ",26,"ج",1,0],["والادمي تحت حكم الله ومسيّر","كم حالم يرتجي تحقيق الاحلامي",27,"م",2,0],["وَالأَدعياءُ قُضاةٌ في مَجامِعِنا","وَالأَغبِياءُ عَلَى الأَبوابِ اَفواجُ",28,"ج",1,0],["وإلا دون رمحي ألف خطبٍ","متى رضيت عن البشر الخطوبُ ؟",29,"ب",1,0]]}