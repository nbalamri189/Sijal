"https://www.poetsgate.com/ViewPoem.aspx?id=181803",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[3155,"إلى قُمْريَّة الشط","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75612&r=&rc=35",""],[463,"لو كنتُ دانيتُ المودَّة َ قاصيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60285&r=&rc=341",""]],"verses":[["بالضادٍ نحن وبالدماءِ قبيلةٌ","وبوَحدةِ الأهدافِ والأفكار",0,"ر",1,0],["بِالضايِعِ الضابِطِ تَقريبُهُ","إِذ وَنَتِ الخَيلُ وَذو الشاهِدِ",1,"د",1,0],["بِالضَربِ وَالصَلبِ وَحَلقِ اللِحا","وَقَلعِ الأَظفارِ وَشَمّ الأُيام",2,"م",1,0],["بالضَيغم الفتَّاك بَل بالصارم ال","بَتّاك بل بالجوهر الشفّافِ",3,"ف",1,0],["بالضاربين قبابَهم عَرْضَ الفلا","عقل الركائب ذاهبا أو جائيا",4,"ي",2,0],["بالضّربِ في هامٍ هناك وأذرُعٍ","والطّعنِ في ثُغَرٍ هناك وأضلُعَ",5,"ع",1,0],["بالضِّيقِ تَعْقُبُهُ مِنْ بَعْدِه سَعَةٌ","تُبْدِي له مِنْ سَنَا أنْوارِه قَبَسَا",6,"س",2,0],["بالضاحِكينَ على مواجِعِنا","باللاّبسينَ ثِيَابَ مضطهَدِ",7,"د",1,0],["بالضحك تُغرق ما تطويه من شجن","وبالضجيج توارى ما تواريه",8,"ي",2,0],["بالضَّعْفِ حَتَّى اسْتَوْقَرَ المُلاَطِثُ","وحَلَّ شَدَّ العُقَدِ المُحَانِثُ",9,"ث",1,0],["بِالضِّدِّ والأولَى كَذَا بِالإمتِنَا","عِ لِعِلمِنَا بِالنَّفسِ وَالرَّحمَنِ",10,"ن",1,0],["بالضرب فاعذر حالة الجيعان","لحْيَةُ شمْرٍ قاتلِ الحسينِ",11,"ن",1,0],["بالضارِبات عَلى الأُنو","فِ رواق ذلّ مرغمِ",12,"م",1,0],["بالضّربِ يَخْتَطِفُ الذّرى","والطّعْنِ يهتِكُ كلَّ جُنّهْ",13,"ن",2,0],["بالضاد والظاء عظ الحرب أو زمن","تظافرا زد وحظب الفخ والحظظا",14,"ظ",2,0],["بالضم والكسر معاً في الذال","وقد نَذِرت ببني هلال",15,"ل",1,0],["بالضَّحايا الغُرِّ ثِنتَي عَشَرَه","من تِباعٍ بُكَّرٍ مُدَّخَرَه",16,"ه",1,0],["بالضبا يوم تسعر الهيجاء","لا بوصل الضبا تنال العلاء",17,"ا",2,1],["بالضوء ينظمها عطرا يُخضِّبُها","تنساب اغنية في سحر الحان",18,"ن",1,0],["بالضدّ لقّب فهو جدّ مبعدٍ","من رحمة الله العظيم الشان",19,"ن",1,0],["بالضيغم الورد لمّا هاج هائجه","عند المقامة والعافي إذا قدرا",20,"ر",2,0],["بالضّادِ أصدَحُ... لاَ أخشى مَحاسَبةً","مِمّن يلومُ ، وفي ذَا كَسرُ أغلاَلِي",21,"ل",2,0],["بِالضِّفَتَينِ سَلامٌ قَدْ بَدَا أَمَلاً","والشَّطُّ يَحْضُنُ بَعْدَ اليَوْمِ مَنْ وَقَعَا",22,"ع",2,0],["بالضعف خارت خيلُنا ذِلَّةً","وحولنا الكلاب تُعلي النباح",23,"ح",1,0],["بالضحك قلبي جاوبنه محانيه","وغذاه من عقب اللهيب البرادي",24,"د",2,0],["بالضيا غذيتَ عيني","وفؤادي بالدّماءْ",25,"ا",2,0],["بالضد نقدر نفرق الصح والعيب","واهل المدوح وكاسبين الشتيمه",26,"م",2,0],["بالضار بالنافع كاشف الضرر","بالنور بالهادي البديع الباقي",27,"ي",1,0],["بالضوءِ يَرقُصُ عُرْياناً على أَبَدٍ","منَ النخيلِ غريبٍ، ساحرٍ، خَضِلِ",28,"ل",1,0],["بالضاربين قابهم عرضَ الفلا","عقل الركائب ذاهبا أو جائيا",29,"ي",2,0]]}