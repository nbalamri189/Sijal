{"poems":[[53,"لا تحسب الشيخ أبا حفصل","https://www.aldiwan.net/poem65420.html","السريع"],[87,"أمس انقضى واليوم مرقاة الغد","https://www.aldiwan.net/poem8102.html","الكامل"],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[208,"تطوى المنى عن طلاب غايته","https://www.aldiwan.net/poem53265.html","المنسرح"],[256,"درة العشاق","https://www.aldiwan.net/poem65127.html","عموديه"],[266,"منهل دمع المحب من دمه","https://www.aldiwan.net/poem38141.html","المنسرح"],[438,"يا رب ليل أشتهي لباسه","https://www.aldiwan.net/poem12790.html","مشطور الرجز"],[564,"من كسر الطلم عن نفسه","https://www.aldiwan.net/poem69358.html","السريع"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87271","الرمل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89170","البسيط"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125925","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91244","المجتث"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86369","الخفيف"],[5101,"أنثى الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=190634",""],[5102,"دعاء الصباح في هجاء \"نور الفلالح\"","https://www.poetsgate.com/ViewPoem.aspx?id=59818",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5409,"كلما أزمنت على الأمة الفو","https://www.poetsgate.com/ViewPoem.aspx?id=155443",""],[5790,"يا أيها الشامخ في قربه","https://www.poetsgate.com/ViewPoem.aspx?id=111961",""],[6069,"ومحمرةٍ من بنات الغصو","https://www.poetsgate.com/ViewPoem.aspx?id=105656",""],[5724,"رسول العلى والفضل والخير والهدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55159&r=&rc=26",""]],"verses":[["من كسبها عاش أبو حفصل","وطال ما عاش مع الجوَّع",0,"ع",1,0],["مِن كَسرِ بَيتٍ أَو جِدارِ سَقيفَةٍ","رَفَعَ الثَباتُ بِنايَةً كَالفَرقَدِ",1,"د",1,0],["من كسعد وللشباب هواه","قدرة تتعب الخيال وزهدا",2,"د",2,0],["من كسعد الملاحم جنّت","وتلقّى حدّ من الهول حدّا",2,"د",2,0],["من كسعد وللنديّ احتدام","جمرة الحرب عنفوانا ووقدا",2,"د",2,0],["منكّس رأسَه كهاروتَ في","بابل إذ كان مثلَه يسحَرْ",3,"ر",1,0],["من كسّر الأصنام دون تردّد","ضربا بيمناه على الأعناق",4,"ق",1,0],["منكس هامه يقل على","سنامه من علا بمنسمه",5,"م",2,0],["منكِّساً نحو الثريّا راسَهْ","هل تعرفُ العُرْجونَ والكباسَهْ",6,"س",2,0],["مَن كسَّرَ الطّلمْ عن نَفسه","وكان فِي العَالَم ذَا مخَبرَه",7,"ر",2,1],["مَن كَساهُ طيبَ أَصلِهْ","حلَّةَ الفَضل الحَميدهْ",8,"ه",1,0],["من كسبها ألبسته الجوخَ من صغر","حتى على رأسه للآن كشمير",9,"ر",1,0],["منك سعدى وشقائي لا تكن","قاسياً إذ أنت خصمي والحكم",10,"م",1,0],["منكَّسَ الرَأس ساهٍ","يَمشي عَلى استحياء",11,"ا",2,0],["من كسا خدك الشقيق كساني","من بهار الضنا عليك لباسا",12,"س",2,0],["من كسرةِ الخبز الموائدَ عمّرت","طوبى لمن بالصبر علّا وارتقى",13,"ق",2,0],["من كَسَرَ بحضْرتكَ القُلّهْ؟","إن تلقاهُ قَبلي قُلْ لهْ:",14,"ل",2,1],["منكسين رؤوساً عند موقفنا","مستحضرين هناك القدر والشرفا",15,"ف",2,0],["من كسته الحروب أسلاب قتلا","ها رأى الصلح بدعةً لا سلاما",16,"م",2,0],["منكسٌ من خجل رأسه","باسط خديه على تربه",17,"ب",2,0],["منكسة التاج في دستها","تفوق الخدود وتحكي النهودا",18,"د",2,0],["منكسة الرايات مفلولة العرى","جريحة كبر قد طغى فتبددا",19,"د",2,0]]}