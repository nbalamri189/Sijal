{"poems":[[55,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[32,"هل تعرف المنزل بالوحيد","https://www.aldiwan.net/poem29596.html","الرجز"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[170,"تعال نندب مع ورق الغضا","https://www.aldiwan.net/poem47090.html","السريع"],[230,"ألا يا تجار العصر هل فيكم امرؤ","https://www.aldiwan.net/poem55093.html","الكامل"],[240,"أبثك مجد الدين حالا سماعها","https://www.aldiwan.net/poem32199.html","الطويل"],[302,"هذا المصلى وذا النخيل","https://www.aldiwan.net/poem33197.html","مخلع البسيط"],[302,"يا صاح هذا المشهد الأقدس","https://www.aldiwan.net/poem33243.html","السريع"],[463,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[556,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70671","المنسرح"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102047","الطويل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144763","الوافر"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46475","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120729","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91736","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133232","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72769","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76714","البسيط"]],"verses":[["وَقُلِّصَ عَنّا قَميصُ الظَلامِ","فَكانَ بِأَنفِ الدَياجي شَمَم",0,"م",1,0],["وَقُلُص مُقوَرَّةِ الجُلودِ","عوج طَواها طَيَّةُ البُرودِ",1,"د",1,0],["وَقَلَّصَ الجَدبُ عَنها فَهيَ طاعِمَةٌ","مِن خَيرِ ما رَفَدَتها ثَلَّةُ الغَنَمِ",2,"م",1,0],["وقلِّصِ الذيلَ وشمِّرهُ عَن","خَلْفٍ من الخلقِ حَكاهم لَبيدْ",3,"د",1,0],["وَقلَّصَ آمالاً كباراً كَأنَّها","مدى الدَهرِ لم تَعقِد عَليكَ لِواءَ",4,"ا",2,0],["وَقُل صالِحاً تُجزى بِهِ صالِحاً غَداً","فَما هَذِهِ الدُنيا بِدارِ جَزاءِ",5,"ا",2,0],["وَقل صَلاةُ الإله تترى","عَليك يا أَيُّها الرَسولُ",6,"ل",1,0],["وَقل صَلاةٌ وَسَلامٌ عَلى","من طابَ منه الأَصلُ والمَغرِسُ",7,"س",1,0],["وقل صاحبٌ لي ضلَّ بالرمل قلبُهُ","لعلّك أن يلقاك هادٍ فتهتدي",8,"د",2,0],["وَقَلّص عَنها العزّ ما فُدِحتْ به","فتحسبُ مولاها من الذلِّ عبدَها",9,"د",3,0],["وقلْ صلاةٌ ما افْتَرَّ مبْتسِمٌ","على النبي المطهر الناقي",10,"ق",2,0],["وقل صبَّكَ المضني الكئيب مبرحي","بحبك مأسور وبُعدُكَ قاتلي",11,"ل",2,0],["وقلْ صبٌّ لقد لعبت","به الأحداث والعجف",12,"ف",1,0],["وَقَلَصت الظُلماء وَاِرتاع سربها","كَما طارَ عَن بَيضٍ أَكن غراب",13,"ب",1,0],["وقلّص من ظل الرَّجاء فراقه","فضلَّ رجائي بعده غير مَمدودِ",14,"د",1,0],["وَقُلّص عني ظلُّ أَيّ شَبيبةٍ","وَقُلِّص عَنها ظلُّ أَفياءها العلي",15,"ل",2,0],["وقل صريع الهوى من وجده دنف","والنفس في لوعة والقلب أواه",16,"ا",2,0],["وقلص ظل الفضل بعد زواله","وقوض من دار الضيافة بنيان",17,"ن",1,0],["وقلّص الظل في فصل الربيع لنا","فكادت الارض بالرمضاء تستعر",18,"ر",1,0]]}