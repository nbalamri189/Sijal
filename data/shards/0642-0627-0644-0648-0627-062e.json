{"poems":[[57,"قالوا خراسان أقصى ما يراد بنا","https://www.aldiwan.net/poem26042.html","البسيط"],[64,"قالوا خسرت القلب منذ علقته","https://www.aldiwan.net/poem52440.html","الكامل"],[63,"أسمعتما أن الجبال تضام","https://www.aldiwan.net/poem51425.html","الكامل"],[68,"قالوا خلا الوقت فاشربها على حذر","https://www.aldiwan.net/poem39077.html","البسيط"],[68,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[107,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[108,"مداعبة صديق","https://www.poetsgate.com/ViewPoem.aspx?id=179527",""],[128,"قالوا كبا جواده وما كبا","https://www.aldiwan.net/poem23744.html","الرجز"],[190,"وخلية مما خلوت به","https://www.aldiwan.net/poem44123.html","الكامل"],[382,"ثق إنما الأحزان سبك ضيق","https://www.aldiwan.net/poem59318.html","الكامل"],[398,"قالوا خراسان أخرجت رشأ","https://www.aldiwan.net/poem53637.html","المنسرح"],[543,"ما لي أنادي يا عديل فؤادي","https://www.aldiwan.net/poem48211.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48766","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38799","الكامل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83023","البسيط"],[2632,"","https://poetry.dctabudhabi.ae/diwan/poem/216958","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58296","السريع"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140310",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110020","الكامل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67508","البسيط"],[4755,"لَطمَه","https://www.poetsgate.com/ViewPoem.aspx?id=184686",""],[4883,"كأس من بُرتقال","https://www.poetsgate.com/ViewPoem.aspx?id=48401",""],[6093,"قالوا: خرجتَ عن القديم أجابهم (الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=176081",""]],"verses":[["قالوا خُراسانُ أَقصى ما يُرادُ بِنا","ثُمَّ القُفولُ فَقَد جِئنا خُراسانا",0,"ن",2,1],["قالوا خَسِرْتَ القلبَ منذُ عَلِقْتَهُ","ورَبِحْتَ فيهِ شَماتَةَ الحُسَّادِ",1,"د",1,1],["قالُوا خَبَتْ نارٌ على أعلامِها","قُلْنا أجَل وتَهاوَتِ الأَعلامُ",2,"م",1,0],["قالوا خَلا الوَقتُ فَاِشرَبها عَلى حَذَرٍ","فَقُلتُ هَيهاتَ أَمرٌ لَيسَ يَنكَتِمُ",3,"م",1,1],["قالوا خُلِقتَ مُوَفَّقاً لِمَديحِهِ","فَأَجَبتُهُم إِنَّ السَعيدَ مُوَفَّقُ",4,"ق",1,0],["قالوا خُذوهُ نُجوماً فَهوَ مُدَّخَرٌ","في مَخلَبِ اللَيثِ يَحميهِ لِإِبّانِ",5,"ن",1,0],["قالوا: خلتْ يدُه من كل ما ملكت","فقلت: بل رأسُه من عقله خال",6,"ل",1,0],["قالوا خبا سراجه وما خبا","لكنه حر أبى",7,"ب",2,0],["قالوا خلوت بشرب رائقة","وتشويه بالبارد العذب",8,"ب",1,0],["قالوا خُلقتَ معذَّباً فأجبتهم","عندي العذاب مجمَّعٌ ومفرَّق",9,"ق",1,0],["قالوا خَراسانُ أَخرَجَت رشَأً","لَيسَ لَهُ في ملاحها ثاني",10,"ي",1,1],["قالوا خَبَت بينَ الرَّمَاد شَرارةٌ","فاليومَ سل عنها شَتِيتَ رَمَاد",11,"د",1,0],["قالوا خلافة سعد قلت مقدسة","ملء الميادين مني والمحاريب",12,"ب",1,0],["قالوا خَليلُكَ عاتِب","إِذ عَن لِقائِك تَمنَعُ",13,"ع",1,1],["قالوا خُذِ العينَ من كُلّ فقلتُ لهم","في العينِ فضلٌ ولكن ناظِرُ العينِ",14,"ن",1,1],["قالوا: خفيتَ، فقلت: حاشا بل أنا","شمسٌ، وإنّ الشمس ليلاً لا تُرى",15,"ر",2,0],["قالوا خرى الخولي في أَصلها","أَيّامَ جَرْي الماء في العود",16,"د",1,0],["قالوا خطونا المدى قدماً وما ارتفعو","ولا خطوا قدماً إلا عن الدين",17,"ن",1,0],["قالوا خُلِقتَ لِمحنةٍ فأَجَبتُهم","خُلِقَت لي المِحنات قبلاً أُخلَقُ",18,"ق",1,0],["قالوا خليفتنا قد مات قلت لهم","في الكلب منه وفي أمثاله خلفُ",19,"ف",1,1],["قالوا خَلَاصْ ارفَعُوا الخَيمَه","وِحْنَا مَسَاكِينْ نتْوَهَّمْ",20,"م",1,0],["قالوا : خطا،... والإجابه ركضها ركض خيل","بين الضلوع النحيلة .. قلت ممكن : سؤال",21,"ل",1,0],["قالوا: خرجتَ عن القديم أجابهم:","إنَّ الخروجَ على القديمِ قديمُ",22,"م",1,1]]}