{"poems":[[72,"هددتموا بالضنا من ليس يرتدع","https://www.aldiwan.net/poem19165.html","البسيط"],[91,"ذهب الربيع ففي الخمائل وحشة","https://www.aldiwan.net/poem62787.html","عموديه"],[116,"لله لله يا سر الوجود أغث","https://www.aldiwan.net/poem42014.html","البسيط"],[251,"ألقت أشعتها عليك الراح","https://www.aldiwan.net/poem14939.html","الكامل"],[253,"دعني ولا تلحني في دمعي الهتن","https://www.aldiwan.net/poem1423.html",""],[272,"مثل لعينك خدرا في الحمى ضربا","https://www.aldiwan.net/poem52086.html","البسيط"],[298,"يا حادي الظعن إن جزت المواقيتا","https://www.aldiwan.net/poem33317.html","البسيط"],[365,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[410,"قالوا ترشفت الليالي ماءه","https://www.aldiwan.net/poem32170.html","الكامل"],[417,"يا معشر السادة الأشراف لا برحت","https://www.aldiwan.net/poem53851.html","البسيط"],[559,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[559,"كل دين إن فاتك الإسلام","https://www.aldiwan.net/poem34196.html","الخفيف"]],"verses":[["يا أشرفَ الخلق أخلاقاً مطهَّرةً","وأفضل الناس إن طاروا وإن وقعوا",0,"ع",3,0],["يا أَشهُراً مَرَّت سِراعاً كَالمُنى","لَو أَستَطيعُ جَعَلتُكُنَّ سِنينا",1,"ن",2,0],["يا أشرف الرسل أدركني فلي كبد","في باب فضلك ملقاةً حقائقه",2,"ق",2,0],["يا اشعرَهُ وجبينه لولاكُما","لم يعرف الإمساءُ والإصباحُ",3,"ح",1,0],["يا أَشجَعَ الناس مِن عُجم ومن عَرَب","وَأَكرَمَ الناسِ مِن شام ومن يَمَن",4,"ن",1,0],["يا أَشرف الخلق من حاف وَمنتعل","وَمنتقى من مشي منهم ومن ركبا",5,"ب",2,0],["يا أَشرَفَ الرُسلِ والأَملاكِ قاطبةً","ومن به شَرَّف اللَهُ النواسيتا",6,"ت",2,0],["يا أشرف الوزراء دعْوةَ جامعٍ","في الوُدِّ بينَ طريفِهِ والمُتْلد",7,"د",1,0],["يا أشرفَ الوُزراءِ أخْ","لاقاً وأكرَمَهم فَعالا",8,"ل",2,0],["يا أشرف النَّاس بين المنجبين أباً","وأرجحَ النَّاس إنْ رُوجِحْتَ ميزانا",9,"ن",2,0],["يا أشرفَ الرسل يا غوث الخلايق يا","نور الوجود استجب يا سيد الأممِ",10,"م",1,0],["يا إشارات من أحب رويداً","منك في القلب صبوةٌ وغرام",11,"م",1,0]]}