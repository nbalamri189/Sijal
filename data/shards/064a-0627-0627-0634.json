{"poems":[[74,"هددتموا بالضنا من ليس يرتدع","https://www.aldiwan.net/poem19165.html","البسيط"],[93,"ذهب الربيع ففي الخمائل وحشة","https://www.aldiwan.net/poem62787.html","عموديه"],[119,"لله لله يا سر الوجود أغث","https://www.aldiwan.net/poem42014.html","البسيط"],[255,"ألقت أشعتها عليك الراح","https://www.aldiwan.net/poem14939.html","الكامل"],[257,"دعني ولا تلحني في دمعي الهتن","https://www.aldiwan.net/poem1423.html",""],[276,"مثل لعينك خدرا في الحمى ضربا","https://www.aldiwan.net/poem52086.html","البسيط"],[302,"يا حادي الظعن إن جزت المواقيتا","https://www.aldiwan.net/poem33317.html","البسيط"],[369,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[415,"قالوا ترشفت الليالي ماءه","https://www.aldiwan.net/poem32170.html","الكامل"],[422,"يا معشر السادة الأشراف لا برحت","https://www.aldiwan.net/poem53851.html","البسيط"],[563,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[563,"كل دين إن فاتك الإسلام","https://www.aldiwan.net/poem34196.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87280","المتدارك"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38124","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71023","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59418","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59067","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59081","الدوبيت"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111173","الرجز"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136791",""],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26676","البسيط"],[1956,"","https://poetry.dctabudhabi.ae/diwan/poem/121883","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123096","الدوبيت"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27981","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87800","السريع"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147341","البسيط"],[3377,"","https://poetry.dctabudhabi.ae/diwan/poem/206015","البسيط"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99383","المنسرح"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110024","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216808","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216800","المجتث"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122229","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123494","السلسلة"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135132","المجتث"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83643","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133182",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5431,"لانهائي العشقِ منك ابتداءُ..","https://www.poetsgate.com/ViewPoem.aspx?id=197606",""],[5473,"كم قلت إِذْ عذر من","https://www.poetsgate.com/ViewPoem.aspx?id=189608",""],[6256,"تحية أدباء المغرب العربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65918&r=&rc=6",""]],"verses":[["يا أشرفَ الخلق أخلاقاً مطهَّرةً","وأفضل الناس إن طاروا وإن وقعوا",0,"ع",3,0],["يا أَشهُراً مَرَّت سِراعاً كَالمُنى","لَو أَستَطيعُ جَعَلتُكُنَّ سِنينا",1,"ن",2,0],["يا أشرف الرسل أدركني فلي كبد","في باب فضلك ملقاةً حقائقه",2,"ق",2,0],["يا اشعرَهُ وجبينه لولاكُما","لم يعرف الإمساءُ والإصباحُ",3,"ح",1,0],["يا أَشجَعَ الناس مِن عُجم ومن عَرَب","وَأَكرَمَ الناسِ مِن شام ومن يَمَن",4,"ن",1,0],["يا أَشرف الخلق من حاف وَمنتعل","وَمنتقى من مشي منهم ومن ركبا",5,"ب",2,0],["يا أَشرَفَ الرُسلِ والأَملاكِ قاطبةً","ومن به شَرَّف اللَهُ النواسيتا",6,"ت",2,0],["يا أشرف الوزراء دعْوةَ جامعٍ","في الوُدِّ بينَ طريفِهِ والمُتْلد",7,"د",1,0],["يا أشرفَ الوُزراءِ أخْ","لاقاً وأكرَمَهم فَعالا",8,"ل",2,0],["يا أشرف النَّاس بين المنجبين أباً","وأرجحَ النَّاس إنْ رُوجِحْتَ ميزانا",9,"ن",2,0],["يا أشرفَ الرسل يا غوث الخلايق يا","نور الوجود استجب يا سيد الأممِ",10,"م",1,0],["يا إشارات من أحب رويداً","منك في القلب صبوةٌ وغرام",11,"م",1,0],["يا أَشجَعَ قرم طعّانِ","قَد صار لِأَهلِ الإِيمانِ",12,"ن",1,0],["يا اِشتِياقاً مِنَ الصّلاةِ إِلَيهِ","في ظَلامِ اللّيالِ وَالأَسحارِ",13,"ر",1,0],["يا اِشتِياقاً لِجامِعٍ بِدمشق","كانَ يُحييهِ بِالدروسِ وَالأَذكارِ",13,"ر",1,0],["يا اِشتِياقاً مِن جِلَّقٍ حيثُ منها","أَخذَت شَمسُ مَجدِها بِالتواري",13,"ر",2,0],["يا أشرف الشُّرفا يا راحمَ الضُّعَفا","يا سيدَ الخُلفا يا أحكمَ الحُكَما",14,"م",2,0],["يا أشرف داع أتى بأشرف قول","في أشرف وقت دعا لأشرف أعمال",15,"ل",1,0],["يا أشرف الخلق طرا عند خالقه","وأكرم الرسل ممن صال أو رأفا",16,"ف",2,0],["يَا أشْرَفَ الخلق عِنْدَ اللَّهِ مَنْزِلَةً","وَمَنْ عَلَى الرفْرَفِ العَالِي المَقامِ رَقِي",17,"ق",2,0],["يا أشْرَفَ مُرْسَلٍ وَيَا خَيْرَ نَبِي","مَكِّي عَرَبِي",18,"ب",2,1],["يا أشبه الناس بنفس المصطفى","خليقة وخلقا ومنطقا",19,"ق",2,0],["يا أشرف رسل الله أجر","وأجز عبداً بك معتصما",20,"م",2,0],["يا أشبه الناسِ آداباً بما لك من","جمال وجهٍ تحدثني وفضل يد",21,"د",1,0],["يا اشرف الناس من عرب ومن عجم","وافضل الناس في قول وفي عمل",22,"ل",1,0],["يا أشرف مرسل من الخلاق","للعالم رحمة على الإطلاق",23,"ق",1,1],["يا أشجعَ الناسِ في نزالٍ","أنتَ بتثبيته شجعتا",24,"ت",2,0],["يا أَشَقر الشارب ماذا جَنى","شاربك الأَشقَر حَتّى حُلِق",25,"ق",1,1],["يَا أَشْعَثَ الفَجْرِ هَلْ بَعثَرْتَ أَرْوِقَةً","عَلَى الشَّتَاتِ أَمِ اسْتَأنَسْتَ بِالعَمَلِ",26,"ل",1,0],["يا أشرف الناس بيتا حين تنسبه","وأعرف الناس في جود وفي كرم",27,"م",1,1],["يا أشبه الناس بالحبوب ألا","تخبرنا عنك غير مؤتفك",28,"ك",1,0],["يا اشعَريَّةُ هَل شَعَرتُم أَنَّني","رَمَدُ العُيونِ وَحِكَّةُ الأَجفانِ",29,"ن",1,0],["يا اشعَريَّةُ يا أَسافِلَة الوَرى","يا عُميُ يا صُمٌّ بِلا آذانِ",29,"ن",1,0],["يا أَشعَريَّةُ يا جَميعُ مَن أَدعى","بِدَعاً وَأَهواءً بِلا بُرهانِ",29,"ن",1,0],["يا أَشهَبَ اللَون لا هو ناصعٌ يَقَقٌ","بادي النقاءِ ولا هو مُظلِمٌ حَلِكُ",30,"ك",1,0],["يا أشبه الخلق بالمولى وقدرته","لولا جلالته عن كل تشبيه",31,"ي",2,0],["يا أشره الناس حسنا","إلى عبيد وصحب",32,"ب",1,1],["يا أشرف الرسل التي قد أرسلت","يا مصطفى يا سيد الشفعاء",33,"ا",2,0],["يا أشجع الأبطال أنت هنا","ميتٌ نأى عن أرض نشأته",34,"ه",1,0],["يا أشرف سام سما وأعظم نام","يا أمنع حام حمى وأمجد أمجاد",35,"د",1,0],["يا أشعر الخلق طرا","ويا هلال الليالي",36,"ل",2,0],["يا أَشرَف الرُسل يا خَيرَ البَريّة من","بِهَديِهِ لِلبَرايا جَلَّتِ النِعَمُ",37,"م",1,1],["يا أشنب الثغر يا حلو اللما","يا أدعج العين رماني النهود",38,"د",1,0],["يا أشرف الخلق يا محمد يا","أحمد يا نور يا رسول الله",39,"ل",2,0],["يااشتعالي في شهقةٍ من جمالٍ","وانغماسي بلذةٍ لو تشاءُ",40,"ا",2,0],["يَا اشعري خَدّه","أَنِّي من المعتزله",41,"ل",2,0],["يا أشقاءنا حللتم على الرحب","وأنى جئتم ستلقون عيدا",42,"د",2,1],["يا أشقاءنا على دول المغرب","أن تستعيد مجدًا تليدا",42,"د",2,0]]}