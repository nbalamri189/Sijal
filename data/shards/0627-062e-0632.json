{"poems":[[53,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[88,"قد صح عزمك والزمان مريض","https://www.aldiwan.net/poem44822.html","الكامل"],[27,"أهوى أراك برامتين وقودا","https://www.aldiwan.net/poem5732.html","الكامل"],[27,"أمسى فؤادك ذا شجون مقصدا","https://www.aldiwan.net/poem5734.html","الكامل"],[27,"سقيا لنهي حمامة وحفير","https://www.aldiwan.net/poem5737.html","الكامل"],[27,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[27,"هاج الهوى وضمير الحاجة الذكر","https://www.aldiwan.net/poem5773.html","البسيط"],[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[27,"هاج الشجون برهبى ربع أطلال","https://www.aldiwan.net/poem5956.html","البسيط"],[27,"لمن الديار كأنها لم تحلل","https://www.aldiwan.net/poem5967.html","الكامل"],[29,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[85,"أمس انقضى واليوم مرقاة الغد","https://www.aldiwan.net/poem8102.html","الكامل"],[45,"لله عهد سويقة ما أنضرا","https://www.aldiwan.net/poem63603.html","الكامل"],[105,"مضت السيوف وولت الأرباب","https://www.aldiwan.net/poem44194.html","الكامل"],[52,"أي رسم لآل هند ودار","https://www.aldiwan.net/poem27050.html","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42646","البسيط"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10325","الكامل"],[85,"أَمسِ انقضى ، واليومُ مِرْقاة ُ الغدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9642&r=&rc=132",""],[320,"إن الوليد أمير المؤمنين له","https://www.aldiwan.net/poem56352.html","البسيط"],[413,"هنيت هنيت بالإقدام والظفر","https://www.aldiwan.net/poem54155.html","الوافر"],[466,"أخ زاد معناه في صده","https://www.aldiwan.net/poem60234.html","المتقارب"],[512,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"]],"verses":[["أَخزَيتُمُ ذا كِبرَةٍ وَتَكاوُسٍ","وَفَضَلتُمُ ذا وَدعَةٍ وَقُراقِرِ",0,"ر",1,0],["أخزى البلاد مفاسداً بلد به","مُقت الأديب وأكرم العِرِيض",1,"ض",1,0],["أَخزى الإِلَهُ بَني قُفَيرَةَ إِنَّهُم","لا يَتَّقونَ مِنَ الحَرامِ كَؤودا",2,"د",2,0],["أَخزى الَّذي سَمَكَ السَماءَ عَدُوَّكُم","وَوَرى بِغَيظِكُمُ الصُدورَ الحُسَّدا",3,"د",2,0],["أَخزى بَني وَقبانَ عُقرُ فَتاتِهِم","وَاِغتَرَّ جارُهُمُ بِحَبلِ غُرورُ",4,"ر",1,0],["أَخزاكَ رَهطُ اِبنِ الأَشَدِّ فَأَصبَحَت","أَكبادُ قَومِكَ ما لَهُنَّ مَرارُ",5,"ر",1,0],["أَخزَيتَ تَيماً وَما تَحمي مَحارِمها","إِذ أَنتَ نَفّاخَةٌ لِلقَينِ مُؤتَجَرُ",6,"ر",1,0],["أَخزَيتَ قَومَكَ في مَقامٍ قُمتَهُ","وَوَجَدتَ سَيفَ مُجاشِعٍ لا يَقطَعُ",7,"ع",1,0],["أَخزَيتَ قَومَكَ يا ميجاسُ إِذ غَلِقَت","رُهنُ الجِيادِ وَمَدَّ الغايَةَ الغالي",8,"ي",1,0],["أَخزى الَّذي سَمَكَ السَماءَ مُجاشِعاً","وَبَنى بِناءَكَ في الحَضيضِ الأَسفَلِ",9,"ل",1,0],["أَخزاهُمُ الجَهلُ حَتّى طاشَ قَولُهُمُ","عِندَ النِضالِ فَما طاروا وَما وَقَعوا",10,"ع",3,0],["أَخِزانَةَ الوادي عَلَيكِ تَحِيَّةٌ","وَعَلى النَدِيِّ وَكُلِّ أَبلَجَ في النَدي",11,"د",2,0],["أَخزى عَدُوَّكَ مُعلِناً وَمُساتِراً","وَكَفاكَ أَمرَكَ سائِساً وَمُدَبِّرا",12,"ر",2,0],["أخزيتَ أُمَّكَ لا تُحَدِّثْ بَعدَها","عن طِيبِ أُمِّكَ ها هنا الأطيابُ",13,"ب",1,0],["أَخزُنُ الغَيظَ في قُلوبِ الأَعادي","وَأُحِلُّ الجَبّارَ دارَ الصِغارِ",14,"ر",1,0],["أَخْزَى جَرِيرٌ بِهِ حَيَّ النُّمَيْرِ فَمَا","عَادُوا بِغَيْرِ حَدِيثٍ مِنْهُ مَشْهُورِ",15,"ر",1,0],["أَخُزاعَ إِن ذُكِرَ الفَخارُ فَأَمسِكوا","وَضَعوا أَكُفَّكُمُ عَلى الأَفواهِ",16,"ا",2,1],["أَخِزانة َ الوادي، عليكِ تحيَّة ٌ","رَبَضتْ كجُنْحِ الغيهَب المتلبِّدِ",17,"د",1,0],["أَخزى طُرَندَةَ مِنهُ وابِلَ بَرِدٌ","وَعَسكرٌ لَم تَقُدهُ العُزَّلُ الجوفُ",18,"ف",1,0],["أخزاهم الله في الأدبار إذ ذبحوا","قبل الخلائف ذبح الشاة والبقر",19,"ر",1,0],["أَخٌ زادَ مَعناهُ في صَدِّهِ","وَأَخرَجَهُ التيهِ عَن حَدِّهِ",20,"د",2,1],["أخزاهُمُ اللَّهُ أنّى يؤفَكون ولوْ","حازوا الهُدى لطريقِ الإفكِ ما اِرتَكَبوا",21,"ب",3,0]]}