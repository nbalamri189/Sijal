{"poems":[[55,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[90,"قد صح عزمك والزمان مريض","https://www.aldiwan.net/poem44822.html","الكامل"],[29,"أهوى أراك برامتين وقودا","https://www.aldiwan.net/poem5732.html","الكامل"],[29,"أمسى فؤادك ذا شجون مقصدا","https://www.aldiwan.net/poem5734.html","الكامل"],[29,"سقيا لنهي حمامة وحفير","https://www.aldiwan.net/poem5737.html","الكامل"],[29,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[29,"هاج الهوى وضمير الحاجة الذكر","https://www.aldiwan.net/poem5773.html","البسيط"],[29,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[29,"هاج الشجون برهبى ربع أطلال","https://www.aldiwan.net/poem5956.html","البسيط"],[29,"لمن الديار كأنها لم تحلل","https://www.aldiwan.net/poem5967.html","الكامل"],[31,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[87,"أمس انقضى واليوم مرقاة الغد","https://www.aldiwan.net/poem8102.html","الكامل"],[47,"لله عهد سويقة ما أنضرا","https://www.aldiwan.net/poem63603.html","الكامل"],[107,"مضت السيوف وولت الأرباب","https://www.aldiwan.net/poem44194.html","الكامل"],[54,"أي رسم لآل هند ودار","https://www.aldiwan.net/poem27050.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42646","البسيط"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10325","الكامل"],[87,"أَمسِ انقضى ، واليومُ مِرْقاة ُ الغدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9642&r=&rc=132",""],[327,"إن الوليد أمير المؤمنين له","https://www.aldiwan.net/poem56352.html","البسيط"],[422,"هنيت هنيت بالإقدام والظفر","https://www.aldiwan.net/poem54155.html","الوافر"],[473,"أخ زاد معناه في صده","https://www.aldiwan.net/poem60234.html","المتقارب"],[519,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138208",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66800","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108635","المتدارك"],[276,"","https://poetry.dctabudhabi.ae/diwan/poem/80491","الكامل"],[4796,"الى الاستاذ الشاعر يوسف الخطيب","https://www.poetsgate.com/ViewPoem.aspx?id=34722",""],[4929,"هجاء (لصوص النصوص) مع اعتذاري من القارئ","https://www.poetsgate.com/ViewPoem.aspx?id=202433",""],[4935,"شرف الرجال فضائل العرفان","https://www.poetsgate.com/ViewPoem.aspx?id=129366",""],[5343,"بوارق النصر","https://www.poetsgate.com/ViewPoem.aspx?id=132673",""],[5397,"عز الحمى فثوى بالأمن خائفه","https://www.poetsgate.com/ViewPoem.aspx?id=157940",""],[5431,"فلسطين....","https://www.poetsgate.com/ViewPoem.aspx?id=200515",""],[5583,"يا الله يا لي كل خلقه تساله","https://www.poetsgate.com/ViewPoem.aspx?id=25794",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[161,"ربيعَا للأمة زَعَمُوا !","https://www.poetsgate.com/ViewPoem.aspx?id=211185",""],[6117,"سِفْر ُالأحَادِيْثِ وَنَبْعُ الْفَضَائِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=182797",""]],"verses":[["أَخزَيتُمُ ذا كِبرَةٍ وَتَكاوُسٍ","وَفَضَلتُمُ ذا وَدعَةٍ وَقُراقِرِ",0,"ر",1,0],["أخزى البلاد مفاسداً بلد به","مُقت الأديب وأكرم العِرِيض",1,"ض",1,0],["أَخزى الإِلَهُ بَني قُفَيرَةَ إِنَّهُم","لا يَتَّقونَ مِنَ الحَرامِ كَؤودا",2,"د",2,0],["أَخزى الَّذي سَمَكَ السَماءَ عَدُوَّكُم","وَوَرى بِغَيظِكُمُ الصُدورَ الحُسَّدا",3,"د",2,0],["أَخزى بَني وَقبانَ عُقرُ فَتاتِهِم","وَاِغتَرَّ جارُهُمُ بِحَبلِ غُرورُ",4,"ر",1,0],["أَخزاكَ رَهطُ اِبنِ الأَشَدِّ فَأَصبَحَت","أَكبادُ قَومِكَ ما لَهُنَّ مَرارُ",5,"ر",1,0],["أَخزَيتَ تَيماً وَما تَحمي مَحارِمها","إِذ أَنتَ نَفّاخَةٌ لِلقَينِ مُؤتَجَرُ",6,"ر",1,0],["أَخزَيتَ قَومَكَ في مَقامٍ قُمتَهُ","وَوَجَدتَ سَيفَ مُجاشِعٍ لا يَقطَعُ",7,"ع",1,0],["أَخزَيتَ قَومَكَ يا ميجاسُ إِذ غَلِقَت","رُهنُ الجِيادِ وَمَدَّ الغايَةَ الغالي",8,"ل",2,0],["أَخزى الَّذي سَمَكَ السَماءَ مُجاشِعاً","وَبَنى بِناءَكَ في الحَضيضِ الأَسفَلِ",9,"ل",1,0],["أَخزاهُمُ الجَهلُ حَتّى طاشَ قَولُهُمُ","عِندَ النِضالِ فَما طاروا وَما وَقَعوا",10,"ع",3,0],["أَخِزانَةَ الوادي عَلَيكِ تَحِيَّةٌ","وَعَلى النَدِيِّ وَكُلِّ أَبلَجَ في النَدي",11,"د",2,0],["أَخزى عَدُوَّكَ مُعلِناً وَمُساتِراً","وَكَفاكَ أَمرَكَ سائِساً وَمُدَبِّرا",12,"ر",2,0],["أخزيتَ أُمَّكَ لا تُحَدِّثْ بَعدَها","عن طِيبِ أُمِّكَ ها هنا الأطيابُ",13,"ب",1,0],["أَخزُنُ الغَيظَ في قُلوبِ الأَعادي","وَأُحِلُّ الجَبّارَ دارَ الصِغارِ",14,"ر",1,0],["أَخْزَى جَرِيرٌ بِهِ حَيَّ النُّمَيْرِ فَمَا","عَادُوا بِغَيْرِ حَدِيثٍ مِنْهُ مَشْهُورِ",15,"ر",1,0],["أَخُزاعَ إِن ذُكِرَ الفَخارُ فَأَمسِكوا","وَضَعوا أَكُفَّكُمُ عَلى الأَفواهِ",16,"ا",2,1],["أَخِزانة َ الوادي، عليكِ تحيَّة ٌ","رَبَضتْ كجُنْحِ الغيهَب المتلبِّدِ",17,"د",1,0],["أَخزى طُرَندَةَ مِنهُ وابِلَ بَرِدٌ","وَعَسكرٌ لَم تَقُدهُ العُزَّلُ الجوفُ",18,"ف",1,0],["أخزاهم الله في الأدبار إذ ذبحوا","قبل الخلائف ذبح الشاة والبقر",19,"ر",1,0],["أَخٌ زادَ مَعناهُ في صَدِّهِ","وَأَخرَجَهُ التيهِ عَن حَدِّهِ",20,"د",2,1],["أخزاهُمُ اللَّهُ أنّى يؤفَكون ولوْ","حازوا الهُدى لطريقِ الإفكِ ما اِرتَكَبوا",21,"ب",3,0],["أخزانة الأدب النفيس وعيت ما","لم يحوه المطبوع والمكتوب",22,"ب",1,0],["أخزى الإلهُ بني أميّة إنّهم","ظلموا العبادَ بما أتوه وخاموا",23,"م",3,0],["أخزاه اللَه وقاتله","من والٍ أخبث من عبري",24,"ر",2,0],["أخزامة وَبشامة وأراكة","خضر عَلى ما تعهدون وأعهد",25,"د",1,0],["أخزاهمُ الله اذ دانوا لِمُنْسَلِطٍ","على الرَّقابِ زنيمٍ عابدِ الذَّهبِ",26,"ب",1,0],["أخزيتَ نفسَك بادعائِك مِلْكَةً","لسواكَ يالَ الأرعنِ المُتَصَلِّفِ",27,"ف",1,0],["أخزاك ربك من مريد آثم","وصلاك يوم الحشر بالنيران",28,"ن",1,0],["أخزاكم الله، كم تأتون من سُبل","للموت جدت، فما ترقى لها الخُدعُ",29,"ع",1,0],["أخزى وجوه المواضي البيض عارية","وقد حكت نسج داود مطارفه",30,"ف",2,0],["أخزّنُ في قلبي هواك وأحفظُ","وإنْ خانك العشاق عنكِ تحفّظوا",31,"ظ",3,1],["أخزاكم الوالي تعالى جلاله","وابدا الذي تخفون من قيلٍ أو قال",32,"ل",1,0],["أخزاهمُ كُلّما ناحَت مُطوّقةٌ","عند الأصيلِ إذا يغشى وفي السَحَرِ",33,"ر",1,0],["أَخْزَى جَهَالَةَ شِرْكٍ ، فَانتهَى الوَثَنُ","قَدْ كُنْتُ خَيْرَ قَضَاءٍ جَاءَ فِي قَدَرٍ",34,"ر",1,0],["أخزاهمُ الله في الدنيا وأحبطهم","والشرُّ عقبى لهم والخيرُ عقباكِ",35,"ك",1,0]]}