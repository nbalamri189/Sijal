{"poems":[[53,"قل للذي أعجبت محاسنه","https://www.aldiwan.net/poem9406.html","المنسرح"],[30,"اسمع ثنائي فإني لست ممتدحا","https://www.aldiwan.net/poem5095.html","البسيط"],[77,"حلفت بالسابغات البيض واليلب","https://www.aldiwan.net/poem69102.html","البسيط"],[30,"لقد علمت وعلم المرء أصدقه","https://www.poetsgate.com/ViewPoem.aspx?id=21596",""],[132,"يا نهرا سميت بالأصغرين","https://www.aldiwan.net/poem50609.html","السريع"],[173,"أبا الفضائل يا من في مفاضته","https://www.aldiwan.net/poem1653.html",""],[173,"رويداً بعض نوحك يا حمام","https://www.aldiwan.net/poem1677.html",""],[242,"حاولت صبرا على ما ناب من نوب","https://www.aldiwan.net/poem18065.html","البسيط"],[264,"كأس المحبه بمسك الأنس لي مختوم","https://www.aldiwan.net/poem35320.html","المواليا"],[275,"توالت ليالي الحب وهي سراع","https://www.aldiwan.net/poem35221.html","الطويل"],[302,"معصيتي أعظم من طاعتي","https://www.aldiwan.net/poem33160.html","السريع"],[369,"سجعن فأذكرن العهود الخواليا","https://www.aldiwan.net/poem60556.html","الطويل"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[475,"وأوقدت ناري باليفاع فلم تدع","https://www.aldiwan.net/poem4659.html","الطويل"],[505,"أعد ذكر من نهوى فنحن على الهوى","https://www.aldiwan.net/poem38056.html","البسيط"],[518,"ألا تكن في الهوى أرويت من ظماء","https://www.aldiwan.net/poem67749.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138414",""],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122350","المنسرح"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105611","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38951","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120116","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65095","المنسرح"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112718","المجتث"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136778",""],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128696","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48968","المتقارب"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101039","الطويل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131334","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53045","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53034","البسيط"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45593","السريع"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130039","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103977","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48358","البسيط"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118756","المجتث"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91300","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117889","السريع"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135865","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127200","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72347","البسيط"],[4869,"زمان الطفوله","https://www.poetsgate.com/ViewPoem.aspx?id=139692",""],[5064,"ما زِلتُ آدمَ يا تُفّاح حوَائِي","https://www.poetsgate.com/ViewPoem.aspx?id=199159",""],[585,"بلغنا من الآمال ما كان قاصيا","https://www.poetsgate.com/ViewPoem.aspx?id=161842",""],[5194,"أعترافك بالخطا","https://www.poetsgate.com/ViewPoem.aspx?id=30809",""],[5237,"رويدكم فما سمعي بقابل","https://www.poetsgate.com/ViewPoem.aspx?id=113117",""],[5703,"دموع ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=210731",""]],"verses":[["وأنتَ ذاكَ الذي به انْفَسَحَ ال","ضيِّقُ لا مَنْ ضاقَتْ بِهِ الفُسَحُ",0,"ح",1,0],["وَأَنتَ ذاكَ الَّذي تُرجا نَوافِلُهُ","عِندَ الشِتاءِ إِذا ما دوخِلَ الحَجَرُ",1,"ر",1,0],["وأنتَ ذاك الذي يَدوي الصعيدَ كأنْ","لم تَنْأ عن أهْلهِ يوماً ولم تغِبِ",2,"ب",1,0],["وَأنْتَ ذاكَ الذي تُرْجَى نَوَافِلُهُ","عِندَ الشّتاءِ إذا ما دُوخلَ الحُجَرُ",3,"ر",1,0],["وأنتَ ذَا يا أيها الأصغرينِ","بُورِكْتَ من نهرٍ ومنْ جَعْفرِ",4,"ر",1,0],["وَأَنتَ ذاكَ الَّذي نَعني فَلا اِنقَطَعَت","إِلى القِيامَةِ لِلراجيكَ آمالُ",5,"ل",1,0],["وَإِن تَذكُر أَبا جَروانَ غُضَّت","لَهُ الأَبصارُ وَاِنقَطَعَ الكَلامُ",6,"م",1,0],["وَأنْتَ ذَاكَ فَمَا أَعْرِفُ مِثْلَكَ فِي","مَا قلتُ بِالْحقِّ فِي نَبْعٍ وَلا غَرَبِ",7,"ب",1,0],["وإن تذق خمرة الظاهر أو المكتوم","فاطرب وعربد وقل يا حيّ يا قيّوم",8,"م",1,0],["وإن تذكُري بعدي مواقف حبِّنا","تأكَّدتُ أن العهدَ ليس يُضاع",9,"ع",1,0],["وأَنتَ ذو الرحمَة يا سيِّدي","إِن لَم تكن ترحمُ من يَرحَمُ",10,"م",1,0],["وأنت ذُكاءٌ للعُلا وهو ابْنُه","لأعيُنِنا كُلُّ يُضيءُ الدَّياجيا",11,"ي",2,0],["وإن تذكر فولاك","لك ذا كروكم جات",12,"ت",1,0],["وَإِن تُذكَرِ النُّعمَى الَّتِي سَلَفَت لَه","فَأَكرِم بِها عِندِي إِذا ذُكِرَت يَدا",13,"د",2,0],["وإنْ تذكُرِ العُشَّاقَ في طَبقاتِهمْ","بِصنْفِ الفِدائيِّينَ بالله فاثْبِتْنا",14,"ن",2,0],["وأنت ذاك وقلبي ذا الذي ملكت","هواه نفسك إكراهاً وتخييرا",15,"ر",2,0],["وان تذوقت في طهر حلاوته","أبشر فانك في الجنات جذلان",16,"ن",1,0],["وانت ذاك السميدع البطل","يا ذرب يا همام يا رجال",17,"ل",1,0],["وإن تذكرت أقوامي بها وذوي","مودتي هدّ تذكاري قوى جلدي",18,"د",2,0],["وَأَنتَ ذو الصّفحِ بِلا نَكير","تَعفو عَنِ القُصورِ وَالتّقصيرِ",19,"ر",1,0],["وأنت ذو وجه إذا قابلت","حياءه نظرة عين قطر",20,"ر",1,0],["وأَنتَ ذو فِطْنَةٍ لَها حِكَمٌ","عَزيزةٌ لا تَبيدُ بالنَّفَقَهْ",21,"ق",2,0],["وأنت ذخري وربي","وأنت كاشف ضري",22,"ر",2,0],["وأنت ذاك النبي الهاشمي ومن","بجاهه تبرأ الأسقام والعلل",23,"ل",1,0],["وأنت ذخري ومطلوبي ومعتمدي","وأنت جاهي وأنت القصد والسول",24,"ل",1,0],["وإن تذكريني فإني أَخٌ","صحيحُ المحبةِ سامي الوَطر",25,"ر",1,0],["وإن تذكري أيامنا في قديمها","سموت إلى ماض أغر نبيل",26,"ل",1,0],["وإن تَذُقْ مُرَكَّبَ اليَاقُوتِ","يُغنيكَ عَمّا تَشْتَهي يا قُوتي",27,"ي",1,0],["وأنت ذاك السرا الذي كشفت","عنا بأنوار وجهه الكرب",28,"ب",1,0],["وأنت ذاك الذي تبكي الرقاب دماً","لوقع أسيافه في نقع حواء",29,"ا",2,0],["وَأَنتَ ذو القرنين في عَصرِنا","جَعَلتهُ ما بَينَهُم سَدّا",30,"د",2,0],["وإن تذكُروا أبناءَ مصر ومجدهم","فأَولاهمُ بالمكرُمات محمّدُ",31,"د",1,0],["وَإن تُذكَرِ الأشعَأرُ لَم يَكُ خَارِجاً","أمَامِي جَريرٌ فِي الرّهَانِ وَلاَ كَعبُ",32,"ب",1,0],["وَإن تُذكَرِ الأنسَابُ كُنتُ نَقِيبَهَا","وَلم يَخفَ عَن ذِكرَايَ حَيٌّ وَلاَ شِعبُ",32,"ب",1,0],["وإن تذكّرتُ مِلْتُ وجْداً","كأنّني قد شرِبْتُ راحا",33,"ح",2,0],["وإن تذكرتُ ماضي","عيشي وحاضر سجني",34,"ن",2,0],["وَإِن تذكروا بين الندامى صَبابةً","فَلا تجعلوني غَير صدرٍ وَعنوان",35,"ن",1,0],["وأنت ذو الإثبات والمحو في","ما شِئتَ فاهد الكلّ نجد الثبات",36,"ت",1,0],["وأنت ذا تراهُ واعتمدنا","عليك فيه حيثما وجدنا",37,"ن",2,0],["وأنت ذو الفضل الذي توقد في","هام الروابي للضيوف نارك",38,"ك",1,0],["وأنت ذاك البطين الممتلىء حكما","معاشرها فلك الافلاك ما وسعا",39,"ع",2,0],["وأنت ذاك الهزبر الانزع البطل ال","ذي بمخلبه للشركى قد نزعا",39,"ع",2,0],["وأنت ذو منصل صلَّ ينضنض في","غمد كلغد لمكر الكفر قد بلعا",39,"ع",2,0],["وأنت ذو حسب يعزى إلى نسب","قد نيط في سبب أوج العلا قرعا",39,"ع",2,0],["وانتذكر كيف كنا بالزمان اللي فتني","قبل هذا الوقت قبل الضيق مايبدى إلتحافي",40,"ف",2,0],["وأَنْتِ ذاكِرَتِي إِنْ كُنْتِ ناسِيَتِي","وأَنْتِ قاتِلَتِي إِنْ شِئتِ إِحيَائِي",41,"ا",3,0],["وإن تذبحوني أنبتت كل قطرة","لكم من دمي حريةً وتساويا",42,"ي",2,0],["وإن تذكرتك .. تذكرتك بخير","وأن سليتك شفت بعيوني غلاك",43,"ك",1,0],["وأنت ذخيرتي الكبرى وإني","لتحت حماك في الدارين داخل",44,"ل",1,0],["وأنتَ ذو مللٍ عَنَّفتَني عَلَناً","وما انتظرتَ على صبرٍ لقاءاتي",45,"ت",2,0]]}