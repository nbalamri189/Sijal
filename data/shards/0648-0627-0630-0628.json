{"poems":[[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[77,"أإخواننا لا تنسوا الفضل والعطفا","https://www.aldiwan.net/poem35975.html","الطويل"],[86,"من ليوم نحن فيه من لغد","https://www.aldiwan.net/poem10478.html","الرمل"],[93,"يا مصر لو تقدر الأقدار بالكرم","https://www.aldiwan.net/poem11289.html","البسيط"],[88,"مرت تقول ألا يا رب خذ روحي","https://www.aldiwan.net/poem44460.html","البسيط"],[92,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[97,"بي ما تحس وفي فؤادك ما بي","https://www.aldiwan.net/poem24400.html","الكامل"],[97,"لمن الصمت والفؤاد المشرد","https://www.aldiwan.net/poem24604.html","مجزوء الوافر"],[97,"بي ما تحس وفي فؤادك ما بي","https://www.aldiwan.net/poem24781.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[77,"إخواننا لا تنسوا الفضل والعطفا","https://www.poetsgate.com/ViewPoem.aspx?id=34184",""],[90,"في الطيارة أو على أبواب المفاوضات","https://www.poetsgate.com/ViewPoem.aspx?id=179078",""],[99,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""]],"verses":[["وَأَذَبتُ دَمعي يَومَ وَدَّعَني","في صَحنِ خَدٍّ ذابَ رَونَقُهُ",0,"ق",2,0],["وإذْ بلغَ الماءُ الزُّبَى فتدارَكوا","فقدْ بسَطَ الدّينُ الحَنيفُ لكُمْ كَفّا",1,"ف",2,0],["وَاِذبُلي يا زَهرَةَ الرَوضِ وَلا","تَبسِمي لِلطَلِّ فَالعَيشُ نَكِد",2,"د",1,0],["وَإِذْ بَنُوهَا هُمُ الآسَادُ إِنْ وَرَدُوا","مَوَارِدَ الْحَرْبِ وَالأَجْوَادُ فِي السَّلمِ",3,"م",1,0],["وأذبلَتْها هموم النفس ناصبةً","فصَوَّحت وجنتيها أيَ تصويح",4,"ح",1,0],["وأَذبتُ الأَسَى","في جمالِ الوُجُودْ",5,"د",1,0],["وأذبتُ جوهرها فداءَ نواظرٍ","علويةٍ قدسيةِ المحرابِ",6,"ب",1,0],["وإذ بالفجر بساما","إلى إلفين في خدر",7,"ر",1,0],["وأَذبتُ جوهَرهَا فدَاءَ نَوَاظِر","قُدسِيَّةٍ عُلويّةِ المحرابِ",8,"ب",1,0],["وَاذْبَحْ وَدَمَّرْ وَاسْتَبِحْ أَعْراضَهُمْ","وَامْلأَ بِلاَدَهُمُ أَسىً وَنَكَالاَ",9,"ل",2,0],["وإذ بها وصمة يشيح لها","جبين مصر وتنزوي صوره",10,"ر",2,0],["وإذ بلغ الماء الزبا فتداركوا","فقد بسط الدين الحنيف لكم كفا",11,"ف",2,0],["وأذْبتَ نَفْسكَ في رياضةٍ موطنٍ","لولا جهودُك كان صعباً جامحا",12,"ح",2,0],["وأذبح أهلَ الكهف فوق فراشهم","جميعاً ، ومن بوّابة الموت أعبرُ",13,"ر",1,0]]}