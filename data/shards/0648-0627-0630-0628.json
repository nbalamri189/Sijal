{"poems":[[55,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[79,"أإخواننا لا تنسوا الفضل والعطفا","https://www.aldiwan.net/poem35975.html","الطويل"],[88,"من ليوم نحن فيه من لغد","https://www.aldiwan.net/poem10478.html","الرمل"],[95,"يا مصر لو تقدر الأقدار بالكرم","https://www.aldiwan.net/poem11289.html","البسيط"],[90,"مرت تقول ألا يا رب خذ روحي","https://www.aldiwan.net/poem44460.html","البسيط"],[94,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[99,"بي ما تحس وفي فؤادك ما بي","https://www.aldiwan.net/poem24400.html","الكامل"],[99,"لمن الصمت والفؤاد المشرد","https://www.aldiwan.net/poem24604.html","مجزوء الوافر"],[99,"بي ما تحس وفي فؤادك ما بي","https://www.aldiwan.net/poem24781.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[79,"إخواننا لا تنسوا الفضل والعطفا","https://www.poetsgate.com/ViewPoem.aspx?id=34184",""],[92,"في الطيارة أو على أبواب المفاوضات","https://www.poetsgate.com/ViewPoem.aspx?id=179078",""],[101,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""],[173,"بعثت تهدد بالنوى وتوعد","https://www.aldiwan.net/poem1617.html",""],[190,"جئت أشكو إلى الطبيب الذي بي","https://www.aldiwan.net/poem44170.html","الخفيف"],[236,"إن بان من تهوى وأنت مثبط","https://www.aldiwan.net/poem44584.html","الكامل"],[255,"ما لي أراك أضعت ودي","https://www.aldiwan.net/poem14944.html","مجزوء الكامل"],[275,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[347,"صنو الرسول تحية وسلام","https://www.aldiwan.net/poem55338.html","الكامل"],[354,"إليك أنسي بناسي زاد إيحاشي","https://www.aldiwan.net/poem15744.html","البسيط"],[356,"وأعرافه الشم التي لاح دونها","https://www.aldiwan.net/poem68981.html","الطويل"],[382,"يا راهبا يبغي السلوك على وجل","https://www.aldiwan.net/poem59288.html","الكامل"],[422,"إن الأكارم والمكارم","https://www.aldiwan.net/poem54148.html","مجزوء الكامل"],[438,"صدرنا وقد نادى السماح بنا ردوا","https://www.aldiwan.net/poem12450.html","الطويل"],[454,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[469,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[505,"كتب الظلام على الوجود سطورا","https://www.aldiwan.net/poem38003.html","مجزوء الكامل"],[510,"الوصيّة","https://www.aldiwan.net/poem27795.html","الطويل"],[520,"قل للأمير الأكرم الكامل","https://www.aldiwan.net/poem12205.html","السريع"],[568,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[580,"غدا الحسن شورى في الملاح وإنما","https://www.aldiwan.net/poem2922.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83288","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77664","الطويل"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44804","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62685","الرمل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138160",""],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72306","البسيط"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203688","المتقارب"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96463","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56071","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56217","الوافر"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144089","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87831","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108476","الخفيف"],[2163,"","https://poetry.dctabudhabi.ae/diwan/poem/124034","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27947","البسيط"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67865","الوافر"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130807",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94163","المتقارب"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94068","المجتث"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93784","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94097","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93849","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200555","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202921","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202575","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203049","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203011","الوافر"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86272","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86341","المجتث"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86289","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86286","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138563",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111517","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127075","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95045","البسيط"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77692","الطويل"],[4674,"يتيم أنا","https://www.poetsgate.com/ViewPoem.aspx?id=210590",""],[4836,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=205524",""],[4884,"سَبْعٌ يَأْكُلُهُنَّ سَبْعْ","https://www.poetsgate.com/ViewPoem.aspx?id=201761",""],[4977,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=199748",""],[5046,"جاد الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=197944",""],[5064,"قوافل الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=199088",""],[3271,"إني سائر للخلود","https://www.poetsgate.com/ViewPoem.aspx?id=103531",""],[3271,"من مرج عبقر","https://www.poetsgate.com/ViewPoem.aspx?id=104125",""],[5081,"إنْ تَصْمُتْ حَبِيبِي ...","https://www.poetsgate.com/ViewPoem.aspx?id=190537",""],[1043,"المرقص الدائر","https://www.poetsgate.com/ViewPoem.aspx?id=94867",""],[5295,"أنين","https://www.poetsgate.com/ViewPoem.aspx?id=171625",""],[5302,"ولكنه حظ الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=204916",""],[5431,"لقد تعب الجواد من الرُقادِ","https://www.poetsgate.com/ViewPoem.aspx?id=183034",""],[5431,"وأفضل الفعل حب الله والناس","https://www.poetsgate.com/ViewPoem.aspx?id=194507",""],[5736,"أحلام مبتورة","https://www.poetsgate.com/ViewPoem.aspx?id=203206",""],[5736,"محراب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=208492",""],[5804,"لا متواضع ولا متكبر","https://www.poetsgate.com/ViewPoem.aspx?id=195258",""],[5890,"درب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=192584",""],[5956,"تبَقَّتْ ساعة لبلادنا نصلُ","https://www.poetsgate.com/ViewPoem.aspx?id=207169",""],[6131,"ماءُ السَّماءْ","https://www.poetsgate.com/ViewPoem.aspx?id=189238",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[6142,"ما العرب إلا سماء للعلاء وما","https://www.poetsgate.com/ViewPoem.aspx?id=155759",""],[5080,"بلالٌ دونَ مئذنةٍ أنايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88134&r=&rc=4",""],[454,"إن العروبة بالإسلام عزتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82660&r=&rc=24",""]],"verses":[["وَأَذَبتُ دَمعي يَومَ وَدَّعَني","في صَحنِ خَدٍّ ذابَ رَونَقُهُ",0,"ق",2,0],["وإذْ بلغَ الماءُ الزُّبَى فتدارَكوا","فقدْ بسَطَ الدّينُ الحَنيفُ لكُمْ كَفّا",1,"ف",2,0],["وَاِذبُلي يا زَهرَةَ الرَوضِ وَلا","تَبسِمي لِلطَلِّ فَالعَيشُ نَكِد",2,"د",1,0],["وَإِذْ بَنُوهَا هُمُ الآسَادُ إِنْ وَرَدُوا","مَوَارِدَ الْحَرْبِ وَالأَجْوَادُ فِي السَّلمِ",3,"م",1,0],["وأذبلَتْها هموم النفس ناصبةً","فصَوَّحت وجنتيها أيَ تصويح",4,"ح",1,0],["وأَذبتُ الأَسَى","في جمالِ الوُجُودْ",5,"د",1,0],["وأذبتُ جوهرها فداءَ نواظرٍ","علويةٍ قدسيةِ المحرابِ",6,"ب",1,0],["وإذ بالفجر بساما","إلى إلفين في خدر",7,"ر",1,0],["وأَذبتُ جوهَرهَا فدَاءَ نَوَاظِر","قُدسِيَّةٍ عُلويّةِ المحرابِ",8,"ب",1,0],["وَاذْبَحْ وَدَمَّرْ وَاسْتَبِحْ أَعْراضَهُمْ","وَامْلأَ بِلاَدَهُمُ أَسىً وَنَكَالاَ",9,"ل",2,0],["وإذ بها وصمة يشيح لها","جبين مصر وتنزوي صوره",10,"ر",2,0],["وإذ بلغ الماء الزبا فتداركوا","فقد بسط الدين الحنيف لكم كفا",11,"ف",2,0],["وأذْبتَ نَفْسكَ في رياضةٍ موطنٍ","لولا جهودُك كان صعباً جامحا",12,"ح",2,0],["وأذبح أهلَ الكهف فوق فراشهم","جميعاً ، ومن بوّابة الموت أعبرُ",13,"ر",1,0],["وَأَذُبُّ عَن أَحسابِ قَومي جاهِداً","إِن نابَ خَطبٌ أَو عَرى مُستَرفِدُ",14,"د",1,0],["وأذبه ببعض ماء التوافي","فإذا ما فعلت جاد الحبيب",15,"ب",1,0],["وإذ بدا عند الصباح لعينه","قصرٌ بذات النخل أبيض أعيط",16,"ط",1,0],["وأَذَبتَ قلبي في الهوى","ظُلماً بنار جَوىً ووَجد",17,"د",1,0],["وإِذ بُتَّ جمّاحاً فقَدتَ كَرامَةً","لها الطّعنُ أُسٌّ والعَوالي سَلالِم",18,"م",1,0],["وأذبت نفسك في الفضيلة والتقى","وعراك من فرط الذهول سقام",19,"م",1,0],["وَإِذ بِكَ أَضحى اِتِّقائي في لِقائِهِم","لَم أُرمَ مِنهُم بِسَهمٍ غَير طَيّاشِ",20,"ش",1,0],["وإذ بلغ النضرُ المكثرُ فرعها","وصوبَ لم يبلُغ إلى الأرض في شهر",21,"ر",1,0],["واذبح إرادتك اختياراً مثلما","تبغي اختياراً أن تموت بلا زلل",22,"ل",1,0],["وأذَبْتَ دَمعاً كانَ لي","من قبل هذا اليوم جامد",23,"د",1,0],["وإذ بيتُك المشهودُ في كل ساعةٍ","لكثرة زوّارِ النّدى فيه مشهَدُ",24,"د",1,0],["وإذ بتلك البطولات التي جنحو","بها إلى الشر نحو الخير تنقلب",25,"ب",1,0],["وإذ بدأتَ الذنبَ عاد لصفحهِ","ليريك كيف يكون عفوُ القادر",26,"ر",1,0],["وأَذِبْهُ وألْبِسْهُ الخُشوعَ ومِرْطَهُ","وشِّحْهُ ذِكراً غيبَةً وحُضُورَا",27,"ر",2,0],["وإذ بعتُ رُشدي وشريتُ ذهولي","فما عادَ فيْ قولِي شفاءُ غليلِ",28,"ل",1,0],["وإذ بدا وجهك من شغله","فاسمع عتاب الأدب العاقل",29,"ل",1,0],["وَإِذ بَكَرَت عَلى طِسمٍ جَديسٌ","وَإِذ خَرِبَت دِيارُ بَني أَميمِ",30,"م",1,0],["وأُذْبِلُ ورْدَ الخدّ باللَّثْمِ بعْدَمَا","أَحومُ فأُدْمِي ذَلِكَ الفَم بالمَصِّ",31,"ص",1,0],["وَأَذَبتَ في حَسَراتِها كَبِداً بِها","أَودَيتَ تَحرِقُ مِن ذَويكَ كَبودا",32,"د",2,0],["وَإِذ بِغُلام مَرَّ فَاِنسَلَّ عامِدا","إِلى الشِقِّ يَنجو وَالشُقوق كَثير",33,"ر",1,0],["وَإِذ بِأَحلامي الَّتي شِدتُها","تَنهارُ مِن فَوقي وَتَغدو هِباءْ",34,"ا",2,0],["وأذبنا أنفساً في قدّه","إن أحرى ذوبهَا في الأسَل",35,"ل",1,0],["واذ بفؤادي المعنى يرفّ","على نبعك المائج المائر",36,"ر",1,0],["وإذ بحبكم ربي تخير لي","أعلى الأنام فما آسى على السفل",37,"ل",1,0],["وإذ بالجموع قطيع يساق","وخلف الرعاة رعاة الرعاة",38,"ه",1,0],["وَأَذُبُّ عَنهُ المُرقِصِين وَرَاءَهُ","حَذَرَ الفَوَارِسِ وَهُوَ رِيحٌ يُجنَبُ",39,"ب",1,0],["واذبت احشاءي وبالتاريخ كم","خولتني اللوعات يا أنطونُ",40,"ن",1,0],["وإذ بلغوا إليهم سكنوا من","صميم قلوبهم جزعاً وروعا",41,"ع",2,0],["وأذبتُ يوم الجِزعِ جزْعَ مدامعي","جزَعاً ولم أكُ قبلَه بجَزوعِ",42,"ع",1,0],["وَأَذَبتَ يا دَمعَ الحُسَينِ حُشاشَتي","وَأَبَحتَ شَجوى وَاِجتَلَبتَ سَقامي",43,"م",2,0],["واذبلي يا ازاهر الروض حزناً","فهوغصن ذوي وكان رطيبا",44,"ب",2,0],["وإذ بان توفيق العقائد فالذي","يشيعون في بعض المقال من النكر",45,"ر",1,0],["وإذ بدتْ سبحات الوجهِ واتصلت","بالكون أضواؤها في الحال تحرقه",46,"ق",2,0],["وإذ بيتي على رُغمِ المُلاحي","هو البيتُ المُقابلُ للضُّراحِ",47,"ح",1,1],["واذبح لنا بقرةً صفراء فاتحةً","واطعم نساءك ما يبقى من الحمل",48,"ل",1,0],["وإذ بهر الناس منه التجلي","وقالوا عسى أن تحول الستور",49,"ر",1,0],["وإذ بحسن الترضي","تجنى ثمار نضيجه",50,"ج",2,0],["وإذ بوحي أقرا للَه ناظره","جبريل أقرأه ما لم يكن قرأه",51,"ا",2,0],["وإذ بدا يزهو به أرخوا","لوجهه بالحسن زان العذار",52,"ر",1,0],["وإذ بشير التهاني بالقدوم أتى","والبشر قارنه والعين منتظره",53,"ر",2,0],["وإذ بالقبر غطّته قبور","كأنّ القبر مات كمن حواه",54,"ا",2,0],["وإذ بقبر جهمٍ يطالعني","فقلت هذي نهاية المسرح",55,"ح",1,0],["وإذ بغرابتي فنُّ غريب","ولي في ذلك الفن اختصاص",56,"ص",1,0],["وإذ بنار الوغى في الكيس مسعرة","تؤج ما بين أشعار ودينار",57,"ر",1,0],["وإذ ببناتها وبني بنيها","تطالبني بإنفاق وزاد",58,"د",1,0],["وإذ باتت النيران توقد حولها","فآذن بالحرب ابن حرب وقيدها",59,"د",3,0],["وَاذ بِهِ مِصر عَن رُغمِ الخُصومِ غَدَت","فيها طَوالِعَها بِالسَعدِ تُقتَرَن",60,"ن",1,0],["وَاِذ بِطَيفِ رَقبي","يَقولُ ها اِنا شاهِد",61,"د",1,0],["وَاذ بِرِضوان رَب فَاِذ في نِعم","وَحازَ ما كانَ مِن رَبِّ تَمَنّاهُ",62,"ا",2,0],["وَإِذ باتَ في الرِضوان وَهو مُنعِم","لَدى جنَّة يسقيه في الخُلد كَوثَر",63,"ر",1,0],["واذبيحاً دمه طل فيه","لدم صبغ هاتيك التلاعا",64,"ع",2,0],["وإذ بعزم زنده مشتدّاً","رمى بها مرماهما تعدى",65,"د",2,0],["وإذ بدت بالنور في أوج العلى","كوكبة الصبح تبشر الملا",66,"ل",2,0],["وإذ بلغنا متابعةً","إلى العين رابعةً",67,"ه",1,0],["واذبيحا يتلظى عطشا","وأبوه صاحب الحوض غدا",68,"ا",1,0],["وإذ بُكرات الروضِ أَلسنةُ الصبا","تعبرُ في أَنفاسها عن عبيرِهِ",69,"ر",2,0],["وإذ بكى آلُها من قلب ذي شجنٍ","لم يحكهِ حَزَنٌ قبلاً ولا بعدا",70,"د",2,0],["وَإِذ بابُنا مَثوى الغَوادي وَنَحوَنا","تُمدّ رِقاب أَو تُشير عُيونُ",71,"ن",1,0],["وإذ بلغتْ منا القلوبُ حناجرًا","وأظلمت الأرجاءُ- أشرق هيثمُ",72,"م",1,0],["وإذْ بي أعودُ كطفلٍ رضيع","كأولِّ ما كان نضجُ الثمر",73,"ر",1,0],["وإِذْ بِيْ بلا شيءٍ أعودُ مجدّداً","إلى موحشٍ قد غابَ فيه تفاؤلُهْ",74,"ل",2,0],["وإذ بالشعرِ تسبقُني خطاهُ","بلغنا اليومَ من كِبَرٍ عِتيِّا",75,"ي",2,0],["واذبح على روحي الغرامَ ضحيةً","بالسيفِ لا بالسهمِ ذبحَ نعاج",76,"ج",1,0],["وإِذْ بالنُّورِ يُشرِقُ ثُمَّ يَحوِي","ديَاجِيرَ اللّيَالِي فِي سنَاهُ",77,"ا",2,0],["وإذْ بروحٍ من بنيها سرى","مطهرّ القلبِ كرُوح الوَليدْ",78,"د",1,0],["وإذ بعاصفةٍ هوجاء قد صعِقت","لهولها الجنُّ والآطام والبيد",79,"د",1,0],["وَإِذْ بِالنُّورِ يَأْخُذُنَا لِشَطٍّ","بِهَا النَّبَضَاتُ تَبْدُو مُسْتَحِيلَةْ",80,"ل",2,0],["واذ بالقلوب جميعا تدق","على نغم العازف الزامر",81,"ر",1,0],["واذبحوا الأخلاقَ نذراً للعِدا","واخسؤوا مابين سوءاتٍ وعارْ",82,"ر",1,0],["وإذ بالتي قد قيدتني بأضلعي","تحل وتختار السويدا وتربض",83,"ض",1,0],["وإذْ بالبعدِ طيفكمُ تجلى",".فتبتهل الجوارح إذْ تنادي",84,"د",2,0],["واذبح القلب كي أقري وديعته","واسكب الشعر مثل الشهد بالكاس",85,"س",1,0],["وإذ بخريفنا يلقي ظلالا","فيردي نبضةً بدمي شهيدةْ",86,"د",2,0],["وإذ بالشعرِ ينبعُ من يميني","وشمسُ الحرفِ يغريها السطوعُ",87,"ع",1,0],["واذْ بلئيمِ النفسِ تخضعُ نفسُهُ","لدى كلِّ جبّارٍ وتطغى على الحرِّ",88,"ر",1,0],["وأُذبْتُ آهاتي رحيقاً كُلّما","ضَنّت بْطُونُ النَّحْلِ كُنْتُ السّاقِيا",89,"ي",2,0],["وإذْ بها كجنون الجان تنفعلُ","أجيب: لا أرغب الأسفار ما العملُ ؟",90,"ل",1,0],["وَ إذْ بيْ بفَيْضِ الضّياءِ جَناحٌ","يُرفْرِفُ بالحُلمِ أعلَى فَأعلَى",91,"ل",2,0],["وإذ بأرفع جفنيها تقلص من","إنسانها فضحا للعاصف الحصب",92,"ب",1,0],["وإذ به حاضن في صدره قمرا","يزين طلعته البيضاء داميها",93,"ي",3,0],["وأذبحُ في سطورِ الشكّ نفسي","لأن الشكّ سكينُ الهدايا",94,"ا",3,0],["وإذ بتلك البطولات التي جنحوا","بها إلى الشر نحو الخير تنقلب",95,"ب",1,0]]}