{"poems":[[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[77,"أإخواننا لا تنسوا الفضل والعطفا","https://www.aldiwan.net/poem35975.html","الطويل"],[86,"من ليوم نحن فيه من لغد","https://www.aldiwan.net/poem10478.html","الرمل"],[93,"يا مصر لو تقدر الأقدار بالكرم","https://www.aldiwan.net/poem11289.html","البسيط"],[88,"مرت تقول ألا يا رب خذ روحي","https://www.aldiwan.net/poem44460.html","البسيط"],[92,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[97,"بي ما تحس وفي فؤادك ما بي","https://www.aldiwan.net/poem24400.html","الكامل"],[97,"لمن الصمت والفؤاد المشرد","https://www.aldiwan.net/poem24604.html","مجزوء الوافر"],[97,"بي ما تحس وفي فؤادك ما بي","https://www.aldiwan.net/poem24781.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[77,"إخواننا لا تنسوا الفضل والعطفا","https://www.poetsgate.com/ViewPoem.aspx?id=34184",""],[90,"في الطيارة أو على أبواب المفاوضات","https://www.poetsgate.com/ViewPoem.aspx?id=179078",""],[99,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""],[169,"بعثت تهدد بالنوى وتوعد","https://www.aldiwan.net/poem1617.html",""],[186,"جئت أشكو إلى الطبيب الذي بي","https://www.aldiwan.net/poem44170.html","الخفيف"],[231,"إن بان من تهوى وأنت مثبط","https://www.aldiwan.net/poem44584.html","الكامل"],[250,"ما لي أراك أضعت ودي","https://www.aldiwan.net/poem14944.html","مجزوء الكامل"],[270,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[342,"صنو الرسول تحية وسلام","https://www.aldiwan.net/poem55338.html","الكامل"],[349,"إليك أنسي بناسي زاد إيحاشي","https://www.aldiwan.net/poem15744.html","البسيط"],[351,"وأعرافه الشم التي لاح دونها","https://www.aldiwan.net/poem68981.html","الطويل"],[377,"يا راهبا يبغي السلوك على وجل","https://www.aldiwan.net/poem59288.html","الكامل"],[416,"إن الأكارم والمكارم","https://www.aldiwan.net/poem54148.html","مجزوء الكامل"],[432,"صدرنا وقد نادى السماح بنا ردوا","https://www.aldiwan.net/poem12450.html","الطويل"],[449,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[464,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[500,"كتب الظلام على الوجود سطورا","https://www.aldiwan.net/poem38003.html","مجزوء الكامل"],[505,"الوصيّة","https://www.aldiwan.net/poem27795.html","الطويل"],[515,"قل للأمير الأكرم الكامل","https://www.aldiwan.net/poem12205.html","السريع"],[563,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[575,"غدا الحسن شورى في الملاح وإنما","https://www.aldiwan.net/poem2922.html","الطويل"]],"verses":[["وَأَذَبتُ دَمعي يَومَ وَدَّعَني","في صَحنِ خَدٍّ ذابَ رَونَقُهُ",0,"ق",2,0],["وإذْ بلغَ الماءُ الزُّبَى فتدارَكوا","فقدْ بسَطَ الدّينُ الحَنيفُ لكُمْ كَفّا",1,"ف",2,0],["وَاِذبُلي يا زَهرَةَ الرَوضِ وَلا","تَبسِمي لِلطَلِّ فَالعَيشُ نَكِد",2,"د",1,0],["وَإِذْ بَنُوهَا هُمُ الآسَادُ إِنْ وَرَدُوا","مَوَارِدَ الْحَرْبِ وَالأَجْوَادُ فِي السَّلمِ",3,"م",1,0],["وأذبلَتْها هموم النفس ناصبةً","فصَوَّحت وجنتيها أيَ تصويح",4,"ح",1,0],["وأَذبتُ الأَسَى","في جمالِ الوُجُودْ",5,"د",1,0],["وأذبتُ جوهرها فداءَ نواظرٍ","علويةٍ قدسيةِ المحرابِ",6,"ب",1,0],["وإذ بالفجر بساما","إلى إلفين في خدر",7,"ر",1,0],["وأَذبتُ جوهَرهَا فدَاءَ نَوَاظِر","قُدسِيَّةٍ عُلويّةِ المحرابِ",8,"ب",1,0],["وَاذْبَحْ وَدَمَّرْ وَاسْتَبِحْ أَعْراضَهُمْ","وَامْلأَ بِلاَدَهُمُ أَسىً وَنَكَالاَ",9,"ل",2,0],["وإذ بها وصمة يشيح لها","جبين مصر وتنزوي صوره",10,"ر",2,0],["وإذ بلغ الماء الزبا فتداركوا","فقد بسط الدين الحنيف لكم كفا",11,"ف",2,0],["وأذْبتَ نَفْسكَ في رياضةٍ موطنٍ","لولا جهودُك كان صعباً جامحا",12,"ح",2,0],["وأذبح أهلَ الكهف فوق فراشهم","جميعاً ، ومن بوّابة الموت أعبرُ",13,"ر",1,0],["وَأَذُبُّ عَن أَحسابِ قَومي جاهِداً","إِن نابَ خَطبٌ أَو عَرى مُستَرفِدُ",14,"د",1,0],["وأذبه ببعض ماء التوافي","فإذا ما فعلت جاد الحبيب",15,"ب",1,0],["وإذ بدا عند الصباح لعينه","قصرٌ بذات النخل أبيض أعيط",16,"ط",1,0],["وأَذَبتَ قلبي في الهوى","ظُلماً بنار جَوىً ووَجد",17,"د",1,0],["وإِذ بُتَّ جمّاحاً فقَدتَ كَرامَةً","لها الطّعنُ أُسٌّ والعَوالي سَلالِم",18,"م",1,0],["وأذبت نفسك في الفضيلة والتقى","وعراك من فرط الذهول سقام",19,"م",1,0],["وَإِذ بِكَ أَضحى اِتِّقائي في لِقائِهِم","لَم أُرمَ مِنهُم بِسَهمٍ غَير طَيّاشِ",20,"ش",1,0],["وإذ بلغ النضرُ المكثرُ فرعها","وصوبَ لم يبلُغ إلى الأرض في شهر",21,"ر",1,0],["واذبح إرادتك اختياراً مثلما","تبغي اختياراً أن تموت بلا زلل",22,"ل",1,0],["وأذَبْتَ دَمعاً كانَ لي","من قبل هذا اليوم جامد",23,"د",1,0],["وإذ بيتُك المشهودُ في كل ساعةٍ","لكثرة زوّارِ النّدى فيه مشهَدُ",24,"د",1,0],["وإذ بتلك البطولات التي جنحو","بها إلى الشر نحو الخير تنقلب",25,"ب",1,0],["وإذ بدأتَ الذنبَ عاد لصفحهِ","ليريك كيف يكون عفوُ القادر",26,"ر",1,0],["وأَذِبْهُ وألْبِسْهُ الخُشوعَ ومِرْطَهُ","وشِّحْهُ ذِكراً غيبَةً وحُضُورَا",27,"ر",2,0],["وإذ بعتُ رُشدي وشريتُ ذهولي","فما عادَ فيْ قولِي شفاءُ غليلِ",28,"ل",1,0],["وإذ بدا وجهك من شغله","فاسمع عتاب الأدب العاقل",29,"ل",1,0],["وَإِذ بَكَرَت عَلى طِسمٍ جَديسٌ","وَإِذ خَرِبَت دِيارُ بَني أَميمِ",30,"م",1,0],["وأُذْبِلُ ورْدَ الخدّ باللَّثْمِ بعْدَمَا","أَحومُ فأُدْمِي ذَلِكَ الفَم بالمَصِّ",31,"ص",1,0]]}