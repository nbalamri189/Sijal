aspx?id=101597",""],[5956,"أرجو أن تترجِم للغريب","https://www.poetsgate.com/ViewPoem.aspx?id=184257",""],[5014,"عاطفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76221&r=&rc=17",""],[6229,"شواظ جحيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65205&r=&rc=29",""],[2220,"إني أفيق وفي أرضي لها فيق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11577&r=&rc=451",""]],"verses":[["فَإِن تُسلِفِ التَبجيلَ قَبلَ أَوانِهِ","أُعِضكَ بِهِ وَجهاً مِنَ الوُدِّ مونِقا",0,"ق",2,0],["فَإِن تَسمَعوا صَوتَ المُرِنّاتِ تَعلَموا","بِمَن جَعَلَت تَدعو النَواعي وَتَهتُفُ",1,"ف",1,0],["فَأَنتَ سِرٌ في ضَميرِ العُلى","كَالعِقدِ بَينَ الجيدِ وَالنَحرِ",2,"ر",1,0],["فَإِن تَسأَلي عَنّي فَيا رُبَّ سائِلٍ","حَفِيٍّ عَنِ الأَعشى بِهِ حَيثُ أَصعَدا",3,"د",2,0],["فَإِن تَسمَع بِلَأمِهِما","فَإِنَّ الخَطبَ قَد فَقِما",4,"م",2,0],["فَإِن تَسأَلِ الأَقوامَ عَنّي فَإِنَّني","أَنا اِبنُ أَبي سُلمى عَلى رَغمِ مَن زَعَم",5,"م",1,0],["فَإِن تَسلُ النَفسُ أَو تَدَعِ الهَوى","فَبِاليأسِ تَسلو عَنكِ لا بِالتَجَلُّدِ",6,"د",1,0],["فإن تسكت فمن حصرٍ وعيّ","وإن تنطق فعن كذب وهجر",7,"ر",1,0],["فَإِن تَسأَلوا حَيِّي نِزارٍ تُنَبَّأوا","إِذا الحَربُ شالَت مَن يَضُرُّ وَيَنفَعُ",8,"ع",1,0],["فَإِن تَسأَلينا فيمَ نَحنُ فَإِنَّنا","عَصافيرُ مِن هَذا الأَنامِ المُسَحَّرِ",9,"ر",1,0],["فَإِن تَسأَلي الأَقوامَ عَنّي فَإِنَّني","إِلى مَحتِدٍ تَنمي إِلَيهِ المَحاتِدُ",10,"د",1,0],["فإن تسأليني ما الخضابُ فإِنَّني","لَبستُ على فقد الشباب حدادِي",11,"ي",1,1],["فَإِن تَسعَ يا اِبنَ الكَلبِ تَطلُبُ دارِماً","لِتُدرِكَهُ لا تَفتَأِ الدَهرَ عانِيا",12,"ي",2,0],["فَإِن تَسأَلوني بِالنِساءِ فَإِنَّني","بَصيرٌ بِأَدواءِ النِساءِ طَبيبُ",13,"ب",1,0],["فان تَستَلَذّي بَردَ مائِكِ بَعدَنا","فَبَعدَكِ ما نَدري مَتى الماءُ بارِدُ",14,"د",1,0],["فإن تسأل يقل ما الموت إلا","نهاية كل من لهم ابتداءُ",15,"ا",2,0],["فإن تسمع بزهد القوم فيها","فإن الحب يكثر أو يقل",16,"ل",1,0],["فَإِن تَسأَلوا ما مَكانُ الفُنونِ","فَكَم شَرَفٍ فَوقَ هَذا الشَرَف",17,"ف",1,0],["فَإِن تَسأَلوهُ الحَربَ يَسمَح لَكُم بِها","جَوادٌ يَعُدُّ الحَربَ إِحدى المَكاسِبِ",18,"ب",1,0],["فَأَنتَ سَواءٌ وَالسِماكُ إِذا اِلتَقى","عَلى مُمحِلٍ بِالوائِلِ المُتَعَسِّقِ",19,"ق",1,0],["فَإِن تَسأَليني كَيفَ نَومي فَإِنَّني","أَرى الهَمَّ أَجفاني عَنِ النَومَ داخِلُه",20,"ل",2,0],["فإِن تَسأَلَنّي كَيفَ أَنتَ فَإِنَّني","صَبورٌ عَلى رَيبِ الزَمانِ صَعيبُ",21,"ب",1,1],["فإن تُسرِ في ليلٍ وجيشٍ فإنّها","سفائنُ برٍّ بينَ بحرينِ عُوَّمُ",22,"م",1,0],["فَإِن تَسأَليني مَن يَخُطُّ حُروفَهُ","فَأَيدي اللَيالي تَستَمِدُّ بِأَنفاسي",23,"س",2,0],["فَأَنتَ سَنامٌ لِلفَخارِ وَغارِبٌ","وَصِنواكَ مِنهُ مِنكَباهُ وَكاهِلُه",24,"ل",2,0],["فإن تُسْلِمُوا فالله بيني وبينكم","وإن تُعرِضُوا فالسَّيفُ عَضْبُ المجرَّدِ",25,"د",1,0],["فَإِن تَسأَلينا كَيفَ نَحنُ فَإِنَّنا","عَصافيرُ مِن هَذا الأَنامِ المُسَحَّرِ",26,"ر",1,1],["فَإِن تَسأَلاني فيمَ حُزني فَإِنَّهُ","لِشَخصٍ ثَوى بَينَ القُبورِ فَقَيِّدِ",27,"د",1,1],["فأنتَ سَيّرْتَ ما في الجُودِ من مثَلٍ","باقٍ ومن أثَرٍ في النّاسِ محمودِ",28,"د",1,0],["فإنْ تسأليني عن غليلٍ عَهِدتِهِ","فكالجمرِ في خَدّيْكِ لا يتبوّخ",29,"خ",1,0],["فإن تسلموا من سوْرة الحرب مرةً","وتعصمكم شم الأنوف طوال",30,"ل",1,0],["فإن تسلْ ماذا أتى عثمانُ","مما يردّ الدينُ والايمانُ",31,"ن",1,0],["فَإِنْ تَسِيروا إِلى الغَابَاتِ سِيرَتَهُ","إِلَى الكَمَالِ فَقَدْ فُزْتُمْ بِمَنْشُودِ",32,"د",1,0],["فإنْ تَسْألي ثُمّ لا تُكذَبِي","يخبِّرْكِ مَنْ سَألتِ اليَقِينَا",33,"ن",2,0],["فان تسألِ الأقوامَ عنا فانّنا","على حالةٍ خرقاءَ لا تُتَحمَّل",34,"ل",1,0],["فإنْ تسلُ عنكِ النّفسُ أو تدعِ الهوى","فَبِاليأسِ تَسْلُو عَنْكِ لا بِالتَّجَلُّدِ",35,"د",1,0],["فان تسألِ الأقوامَ عني فإنني","أنا ابنُ أبي سُلْمَى على رَغْم مَنْ رَغَمْ",36,"م",1,0],["فإن تسئداني شمِّرا وتقدَّما","وإن كُنْتُما لا تسعداني فأحْجِمَا",37,"م",2,0],["فانت سعيد من نأى عنك هاربا","ثنته الليالي نحو بابك راغما",38,"م",2,0],["فانت سخيٌ والسخآء شجاعةٌ","وأَنت شجاعٌ والشَّجاعةُ جودُ",39,"د",1,0],["فأنتَ سلطانُ أهلِ المجدِ قاطبةً","وركنُهم دامَ ركنُ الدينِ سُلطانا",40,"ن",2,0],["فَاِنتَسى ما مَشى عَلَيهِ وَأَحيا","حُبَّهُ عامِلُ الجَمالِ فَخرّا",41,"ر",2,0],["فإن تُسامِحْني فيا نعمة","يَقْصُر عن حمدي لها جَهْدي",42,"د",2,0],["فأنت سيد أهل الفضل أجمع في","أصل وفرع وتقديم وتأخير",43,"ر",1,0],["فَإِن تَسألي عَنّي صِحابي تُنَبَّئي","إِذا ما اِنفَرى سِرباليالمتَرعبِلُ",44,"ل",1,0],["فان تَسمَع لِشعر أَو لِفَقر","فانّي شاعِرٌ رَجُلٌ فَقيرُ",45,"ر",1,0],["فأنت سترُ الله في وجه من","أصبح ذاك الطفل في ستره",46,"ر",2,0],["فإن تسألوا عن حالتي بعد بُعدكم","فإني ببحر الشوق أكبر سابح",47,"ح",1,0],["فَإِنْ تَسْمَحْ يَداكَ فَلا عَجِيبٌ","وَمَنْ ذا مُنْكِرٌ قَطْرَ السَّماءِ",48,"ا",2,0],["فَإِن تَسمَعوا يَوماً بِمَن ماتَ حَسرَةً","وَشَوقاً إِلى الأَحبابِ إِنّي لذاكُمُ",49,"م",1,0],["فإن تسعداني بالوفاق فإن لي","به بعض أنس وارتياح وقوة",50,"ه",1,0],["فَإنْ تَسْأَلْ بِنَاوَبِهِمْ","وَصلانا هُمْ مِن العَجَبِ",51,"ب",1,0],["فأنتَ سنَنْتَ للنّاسِ المَعالي","وإن لم يَبلُغوا فيهما مَداكا",52,"ك",2,0],["فإن تَسلُبوا القلبَ الّذي في جوانحي","فإنّي إليكم بعدَه لَطَروب",53,"ب",1,0],["فَإِن تَستَنيبي الشَمسَ عَنهُ ضَروَةً","فَإِن طَلَعَت شَمسُ النَهارِ فَسَلِّمي",54,"م",2,0],["فَإِن تَسلَموا مِنّا نَرَ الأَمرَ مُقبِلاً","وَإِن تَعطَبوا نَثأَر بِبيضٍ بَواتِرِ",55,"ر",1,0],["فأنت سددت الباب جهلاً وضلةً","كما صنع الضُّلاَّلُ في باب حِطَّة",56,"ه",1,0],["فَإِن تُسعِفيهِ مَرَّةً بِنوالِكُم","فَقَد طالَما لَم يَنجُ مِنكِ مُسَلَّما",57,"م",2,0],["فإن تَسُدَّ البابَ في وجهِهِ مَن","يَقصِدُه عند تَواتُرِ المِحَن",58,"ن",1,0],["فَإِن تَسيروا إِلَينا تَرفِدوا عَجَلاً","ضَرباً يَظَلُّ عَلى هاماتِكُم يَقِدُ",59,"د",1,1],["فأنتَ سِناني يوم طعنِيَ في الكُلى","وأنت حُسامي إن سلَلْتُ حسامي",60,"م",2,0],["فإِنْ تَسْأَلُوني الحكيم فإِنَّني","خَبيرٌ بأَدْواءِ الحكيمِ عَلِيمُ",61,"م",1,0],["فأَنْتَ سَخِيُّ الْفَضلِ ما خَابَ سائلٌ","دعاكَ، تُثِيبُ الْعَبْدَ في مَحْلِهِ هَطْلَا",62,"ل",2,0],["فإن تسأل بحقك عن محب","فعن مبديه فيه والمعيد",63,"د",1,0],["فإنْ تُسقَ منه غَداً شُربةً","تَفُزْ من نَصيبِكَ بالأوفرِ",64,"ر",1,0],["فإنْ تُسْألا مَن ذا الَّذي تَنْدُبانِهِ","فَقُولا مَشوقٌ خانَهُ في الهَوى الجَدُّ",65,"د",1,0],["فَإِنْ تَسأَلونيَ عَن قَدرِ دَمعي","تُحَدِّثكمُ الأَرضُ عَمّا جَرى",66,"ر",2,0],["فإن تسالمْ تسالمْ منْ تلوذُ به","وتمض عنه بجمع غير مهزوم",67,"م",1,0],["فَإِن تَسأَلوا عَنها فَوارِسَ داحِسٍ","يُنَبِّئكَ عَنها مِن رَواحَةَ عالِمُ",68,"م",1,0],["فَانْتِسَابِي إلَى جَنَابِ عُلاَهُ","كَانْتِسَابِي لِظِلِّهِ المَمْدُودِ",69,"د",1,0],["فَإن تسألن عنها فسلني فإنّني","خبيرٌ بما في اللون خصّت وعمّتِ",70,"ت",1,0],["فَإِن تَسكُنُ الأَرواحُ خِلتَ مُتونَهُ","مُتونَ الصِفاحِ البيضِ حينَ تُجَرَّدُ",71,"د",1,0],["فَإِن تُسالِمهُمُ فَهُم بَنو حَسَنٍ","وَإِن تُحارِبهُمُ فَهُم بَنو أَسَدِ",72,"د",1,0],["فَإِن تَسأل الأَجداث عَنهُم صَبابة","فَحسبك مرآها جَواباً لِسائِل",73,"ل",1,0],["فَإِن تَسأل عَن الأَيام سَلني","فَإِنك قَد سَقَطت عَلى خَبير",74,"ر",1,0],["فإنْ تُساعدْني على صَبْوَتي","أَبِعْكَ أَقْصَى الوُدِّ فيمَنْ يَبيعْ",75,"ع",1,0],["فان تسالوا عني فاني في الهوى","مقيم ومالي غير ذلك من وطنه",76,"ن",2,0],["فإن تسلمي تنسي رزينة هالك","وإن تهلكي لا يهنأ العيش سالم",77,"م",1,0],["فأنت سيد الساحات فضلاً","وفضلك فاق في الوزن الجبالا",78,"ل",2,0],["فإن تسكر فكل العيش نورٌ","وبعد الصحو فالنور الحريق",79,"ق",1,0],["فإن تسألوني بالزّمانِ وصَرفِه","فَعِنديَ مِن ذَمّ الزمانِ عَجَائِب",80,"ب",1,0],["فإن تَسأَلِيني كيف صبري فإنني","صبورٌ على رَيب الزّمانِ صَليبُ",81,"ب",1,0],["فَإِن تَستَرِح مِن طولِ إِدلاجِنا بِها","إِلَيكَ فَقَد كانَت قَليلاً فُتورُها",82,"ر",3,0],["فأنت سؤلي ومأمولي ومعتمدي","وأنت جاهي وأنت القصد والأرب",83,"ب",1,0],["فأنت سراج أفلاك المعالي","وأنت رحيقها وهي الإناء",84,"ا",2,0],["فأنت سيف أمين اللَه لامتُهُ ال","عظمى التي بنضار العدل حلّاها",85,"ا",3,0],["فأنت سرَيت من حرَم بليل","فسبحان الذي أسرى نديم",86,"م",1,0],["فان تُسقَ مِن أَعنابِ وَجٍّ فإِنَّنا","لَنا العَينُ تَجري مِن كَسيسٍ وَمن خَمرِ",87,"ر",1,1],["فإن تسدى لقوم في مناضلة","لم تلف كل كميٍّ غير مخضود",88,"د",1,0],["فأنت سيف غياث الدين أغمدهُ","صوناً وعاد على الأعداء مسلولا",89,"ل",2,0],["فإن تساعد بها هنياً","أو لا فأهنا لها وأمرا",90,"ر",2,0],["فإن تسجنوا القسريّ لا تسجنوا اسمه","ولا تسجنوا معروفهُ في القبائل",91,"ل",1,0],["فَإِن تَسأَليني هَل صَبَرتُ فَإِنَّني","ص