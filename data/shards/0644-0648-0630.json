{"poems":[[55,"وجاهل لم يذق الحبا","https://www.aldiwan.net/poem26489.html","السريع"],[73,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[54,"انظر إليه وإلى ظرفه","https://www.aldiwan.net/poem27401.html","السريع"],[72,"رب راح بت أشربها","https://www.aldiwan.net/poem18445.html","المديد"],[72,"نفس عن الحب ما حادت ولا غفلت","https://www.aldiwan.net/poem19467.html","البسيط"],[72,"أهوى بمرشفه الشهي وقال ها","https://www.aldiwan.net/poem19469.html","الكامل"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[91,"قالت وصفت لنا الرحيق وكوبها","https://www.aldiwan.net/poem8857.html","عموديه"],[70,"وثقيل كأنما","https://www.aldiwan.net/poem43030.html","مجزوء الخفيف"],[45,"كفي الملامة أو دومي على العذل","https://www.aldiwan.net/poem65639.html","البسيط"],[44,"وثناياك إنها إغريض","https://www.aldiwan.net/poem30475.html","الخفيف"],[74,"أي زمان جاد إلا نهب","https://www.aldiwan.net/poem12849.html","السريع"],[105,"لمن دم في مغاني الحي مطلول","https://www.aldiwan.net/poem42135.html","البسيط"],[105,"صفوا المواكب وامشوا حولها مرحا","https://www.aldiwan.net/poem43049.html","البسيط"],[105,"نبئت ما صنع الذين تألفوا","https://www.aldiwan.net/poem43090.html","الكامل"],[105,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[105,"غضب الحماة لدين أحمد غضبة","https://www.aldiwan.net/poem43421.html","الكامل"],[40,"تحمل اليوم أم لم تبرح الأنس","https://www.aldiwan.net/poem42284.html","البسيط"],[50,"يا سلم هل قيمكم ماكث","https://www.aldiwan.net/poem64721.html","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[51,"وفقحة ٍ كالحوت في ابتلاعها","https://www.poetsgate.com/ViewPoem.aspx?id=29509",""],[51,"خلياني عند اصطكاك الخصوم","https://www.poetsgate.com/ViewPoem.aspx?id=25876",""],[107,"يا غزالا يقل مسكا فتيقا","https://www.aldiwan.net/poem16499.html","الخفيف"],[122,"ما أظلم الوجود يا عبود","https://www.aldiwan.net/poem23776.html","الرجز"],[126,"يا زروة قد أورثت","https://www.aldiwan.net/poem50516.html","مخلع الكامل"],[126,"منعت مقلتى لذيذ الرقاد","https://www.aldiwan.net/poem50636.html","الخفيف"],[126,"أوصيكمو يا أيها العقلاء","https://www.aldiwan.net/poem50680.html","الكامل"],[126,"برق أضا من أيمن الجرعاء","https://www.aldiwan.net/poem50683.html","الكامل"],[140,"يا صحابي واين منى صحبى","https://www.aldiwan.net/poem58430.html","البسيط"],[141,"ظن الأراك لدى واديه أظعانا","https://www.aldiwan.net/poem11832.html","عموديه"],[158,"قلب على جمر الغضا يتقلب","https://www.aldiwan.net/poem58807.html","الكامل"],[158,"من سلب الدهر رد أشبابه","https://www.aldiwan.net/poem58893.html","الرجز"],[158,"هموا بحرب ومناهم به الحلم","https://www.aldiwan.net/poem58920.html","البسيط"],[162,"صدغ كقادمة الخطاف منعطف","https://www.aldiwan.net/poem67889.html","البسيط"],[167,"ما شئتما يا صاحبي فقولا","https://www.aldiwan.net/poem1656.html",""],[183,"لو ذقت حين عتبت أيسر حبه","https://www.aldiwan.net/poem14091.html","الكامل"],[209,"عدنا إلى الحب عدنا","https://www.aldiwan.net/poem46249.html","المجتث"],[219,"مولاي زغت عن الصواب","https://www.aldiwan.net/poem55269.html","مجزوء الكامل"],[280,"يا بدر تم ليس لي","https://www.aldiwan.net/poem32446.html","مجزوء الكامل"],[280,"صاد الفؤاد برمل رامة ريم","https://www.aldiwan.net/poem32627.html","الكامل"],[347,"يا راغبا بغناه عن فقرائنا","https://www.aldiwan.net/poem15955.html","الكامل"],[374,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[377,"من للمحب المستهام","https://www.aldiwan.net/poem48802.html","مجزوء الكامل"],[403,"بعثت إليك بطيفها تعليلا","https://www.aldiwan.net/poem50139.html","الطويل"],[426,"من مجيري من قده السمهري","https://www.aldiwan.net/poem40092.html","الخفيف"],[429,"هجر الحب وإن أصبح جارا","https://www.aldiwan.net/poem12474.html","الرمل"],[429,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[434,"راح يخشى في حبه الرقباء","https://www.aldiwan.net/poem2550.html","الخفيف"],[434,"إن كان أضمر قلبي عنك سلوانا","https://www.aldiwan.net/poem2597.html","البسيط"],[450,"هز من قده شبيه الرديني","https://www.aldiwan.net/poem13933.html","الخفيف"],[456,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[456,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[456,"أرأيت أم حبست لحاظك عبرة","https://www.aldiwan.net/poem56150.html","الكامل"],[459,"يا لقومي من تيمي دعوة","https://www.aldiwan.net/poem15136.html","الرمل"],[462,"أهلاً بطيف زار بعد جفائه","https://www.aldiwan.net/poem3611.html","عموديه"],[466,"قد نتج الجو جموحا أشهبا","https://www.aldiwan.net/poem60443.html","الرجز"],[498,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[512,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[513,"طرقتها والليل وحف الجناح","https://www.aldiwan.net/poem12054.html","السريع"],[540,"ردا علي الكأس إنكما","https://www.aldiwan.net/poem34022.html","أحذ الكامل"],[565,"ضرب في ارتشاف ذاك الرضاب","https://www.aldiwan.net/poem69817.html","الخفيف"]],"verses":[["لَو ذاقَ لَوعاتِ الهَوى لَم يَكُن","هَوى ظَلومٍ عِندَهُ ذَنبا",0,"ب",2,0],["لَوذَعِيٌّ إِن يَبلُهُ الخُبرُ يَوماً","أَخجَلَ الوَردَ عَن خَلائِقَ زُهرِ",1,"ر",1,0],["لَو ذُكِرَت طَيٌّ عَلى فَرسَخٍ","أَظلَمَ في ناظِرِكَ النورُ",2,"ر",1,0],["لو ذكرناها لذي جدَثٍ","قام نشواناً من الجدَث",3,"ث",1,0],["لو ذقتَ بردَ رضابٍ في مراشفه","يا حارُ مل لمَّت أعضائي التي ثملت",4,"ت",1,0],["لو ذاق حالة مهجتي ما راعني","دعه يروع ولا يقاسي حالها",5,"ل",3,0],["لَوْذعيٌّ له فؤادٌ ذكيٌّ","ماله في ذكائه من ضَريبِ",6,"ب",1,0],["لوذعيّاً كأنَّ ما بين عطفي","هِ مصابيحُ كُلِّ ليلٍ بهيم",7,"م",1,0],["لَوذَعِيُّ الفُؤادِ يَلعَبُ بِالأَل","بابِ لُعباً إِن شاءَ أَن يَتَسَلّى",8,"ل",2,0],["لَو ذَكَرتَ اِسمَهُ عَلى ال","ماءِ ما ساغَ شُربُهُ",9,"ب",2,0],["لَو ذُقتِ ما ذُقتُهُ مِن حَرِّ بَينِهِمِ","لَكُنتِ في شُغُلٍ عَنّي وَعَن عَذَلي",10,"ل",2,0],["لَوذَعِيٌّ يُهَلِّلُ المَشرَفِيُّ ال","عَضبُ عَنهُ وَالزاعِبيُّ النَحيضُ",11,"ض",1,0],["لَو ذابَ هَذا لَجَرى فِضَّةً","أَو جَمَدَت تِلكَ لَكانَت ذَهَب",12,"ب",1,0],["لوذوا بركنٍ من الأخلاقِ مُمتنِعٍ","تَهوِي الفيالقُ عنهُ والأساطيلُ",13,"ل",1,0],["لُوذي بإيمانكِ العالي إذا عَصفتْ","هُوجُ الخُطوبِ بعاديِّ الذَّرى فطحا",14,"ح",2,0],["لوذوا بِآدابِ الحَياةِ وَراقِبوا","نَزَواتِ قَومٍ ناقِمينَ غِضابِ",15,"ب",1,0],["لَو ذاقَ أَهوالَ الحُروبِ جُناتُها","كَفَّ العَسوفُ وَأَمسَكَ السَفّاحُ",16,"ح",1,0],["لُوذوا بِأروَعَ ما تَخافُ نُفوسُكُم","إِنّ الكِتابَ عَلى النُفوسِ لَأَخوَفُ",17,"ف",1,0],["لَو ذَهَبُوا لَم يَطِب نَجدٌ لِساكِنِهِ","وَقَد يَطِيبُ بِهِم نَجدٌ إِذا جَلَسُوا",18,"س",3,0],["لَو ذُقتُها يَقظانَ أَو نائِماً","عِشتُ وَلَم يَكرِثني الكارِثُ",19,"ث",1,0],["لوذعِيٌّ كُنتُ أَرجو كَونَهُ","خَلفاً مِنّي إِذا المَوتُ طَرق",20,"ق",1,0],["لو ذُرعت شقت على ذُرَّاعها","فهو سخي النفس عن إقطاعها",21,"ع",3,0],["لوذعياً كأن مابين عطفي","لا ابتداعٌ والعلمُ بالتعليم",22,"م",1,0],["لَو ذَكَرنا لماك عِندَ حُضور الرا","ح باتَت فَلَم تَجد مُستَفيقا",23,"ق",2,0],["لو ذاق منه الأغنم البليد","وكان لا يبدي ولا يعيد",24,"د",1,0],["لو ذَاق مَيتٌ طعمه","لا نسلَّ من تحت الرجَامِ",25,"م",1,0],["لَوْذَعِيُّ سَمَيذَعٌ أَرْيَحِيٌّ","هو بحر للجودِ خيرُ جوادِ",26,"د",1,0],["لو ذَمَّ كل الذَّمِّ فهو محبَّبُ","معهم وكان مِدادَهُ الأهواءُ",27,"ا",2,0],["لو ذفت ما قاسيت من ألم الجَوَى","لعذرتني وسميت في استشفائِي",28,"ا",2,0],["لوذعىٌّ تهيج منه الأعادي","قانىءَ الظُّفر من فؤادٍ وخِلْبِ",29,"ب",1,0],["لوذوا بِأَروَعَ يُعطي الأَلفَ مُقتَضِباً","قَبلَ السُؤالِ وَيَلقى الأَلفَ جَذلانا",30,"ن",2,0],["لوذوا بيحيى وادركوا أرواحكم","فعسى بذلك ينمحى ما يكتبُ",31,"ب",1,0],["لوذوا بإسماعيل وادعوه ففي","جوابه ما يذهب الجوى به",32,"ب",2,0],["لوذوا بأحمد واستبقوا به رمقا","إن الهشائم تجنى نبتها الديم",33,"م",1,0],["لَو ذابَ مِن نَظَرٍ خَدٌّ لِرقَّتِهِ","لَذابَ مِن لَحظِ عَيني ذَلِكَ الخَدُّ",34,"د",1,0],["لَو ذُقتُما ما ذُقتُ مِن أَلَمِ الجَوى","لَم تُكثِرا قالاً عَلَيَّ وَقِيلا",35,"ل",2,0],["لو ذُقْتَ حين عَتَبتَ أَيْسرَ حُبِّه","لَعلِمتَ حُلْوَ غرامِه من صابِه",36,"ب",2,1],["لو ذقتم الصفو منها","لما سهرت ونمتم",37,"م",1,0],["لو ذاب من خجل فؤا","د كان هذا القلب ذاب",38,"ب",1,0],["لَو ذُقتُ خَمرَ لَماكَ لَم","أَكُ شاكِياً طولَ الهُمومِ",39,"م",1,0],["لَو ذُقتُ بَردَ رُضابِهِ لَشُفيتُ مِن","سَقَمي لِأَنَّ رُضابَهُ تَسنيمُ",40,"م",1,0],["لَو ذُقتَ طَعمَ طَعامِنا وَشَرابِنا","ما عِشتَ عُمرَكَ جائِعاً ظَمآنا",41,"ن",2,0],["لو ذاق آدم بعد موتٍ طعمَه","ما مات واهتُصرت له الخُرصان",42,"ن",1,0],["لَو ذُقت طَعمك أَنجمت","عَني الهُموم بِفَرد جام",43,"م",1,0],["لَو ذُقتَ مِن طَعمِ النَدى ما ذاقه","لَعَصَيتَ فيهِ لائِماً وَعذولا",44,"ل",2,0],["لوذعيٌّ مهذبٌ ذو خلال","مثل عرف الرياض غب الولي",45,"ي",1,0],["لوذعيّ ألمعيٌّ بارعٌ","من صميم الفُرسِ حَبر لا يُجارى",46,"ر",2,0],["لو ذقتَ ما قد ذقتُه ما لُمْتنا","ولو بُليتَ بالهوى عذَرَنا",47,"ن",2,0],["لو ذعيّ الآراء في كلّ أمر","معضل الوقع أفحم الأراء",48,"ا",2,0],["لو ذاق جفني الكرى حتى بعثت كنا","فيه خيالك أحيانا لأحيانا",49,"ن",2,0],["لوذَعيّ إِنْ رامَ تحصيل معنى","من عميدٍ يبدو له اثنينِ",50,"ن",1,0],["لو ذارعَ الأفقَ غلامٌ منهمُ","ببيته لنالَه وطالَه",51,"ل",2,0],["لو ذلّ ظهري للأيادي لقد","حُبيت منها بالجِسام الثقالْ",52,"ل",1,0],["لو ذُمَّ ما ألِمَ المذمّةَ عرضُه","ما ينقُصُ العوراءَ من أن تُبْخصا",53,"ص",2,0],["لوذعيُّ القلبِ لا تخدعهُ","رِيبُ الشك ولا رجْمُ الظنن",54,"ن",1,0],["لو ذقتَ طعمَ دنوّهِ وبعادهِ","لعرفت سهلَ الشوق من برحائه",55,"ا",3,0],["لَو ذُوِّقَ الشَهدَ لَكانَ أَطيَبا","مُهَروِلاً راحَتُهُ أَن يَتعَبا",56,"ب",2,0],["لو ذكَرْناهُ على مَيْتٍ عَفا","قامَ يسعَى بطِرازٍ مُذَهَّبِ",57,"ب",1,0],["لو ذاقتِ النَحْلُ مَرعى سَوطِ نِقمَتِه","لَمُجَّ منها مَسيلُ الشّهدِ بالصّبرِ",58,"ر",1,0],["لو ذاب وبل النيل يوم الوغى","سقى الروابي وبطون البطاح",59,"ح",1,0],["لو ذقتما ما ذقت ما مزجت","إلا بد معكما منَ الوَجدِ",60,"د",1,0],["لَوْذَعِياً أمضَى من السيفِ في الرَّوْ","ع وأذكى في ظُلْمةٍ من شهابِ",61,"ب",1,0]]}