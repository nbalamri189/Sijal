{"poems":[[55,"وجاهل لم يذق الحبا","https://www.aldiwan.net/poem26489.html","السريع"],[73,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[54,"انظر إليه وإلى ظرفه","https://www.aldiwan.net/poem27401.html","السريع"],[72,"رب راح بت أشربها","https://www.aldiwan.net/poem18445.html","المديد"],[72,"نفس عن الحب ما حادت ولا غفلت","https://www.aldiwan.net/poem19467.html","البسيط"],[72,"أهوى بمرشفه الشهي وقال ها","https://www.aldiwan.net/poem19469.html","الكامل"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[91,"قالت وصفت لنا الرحيق وكوبها","https://www.aldiwan.net/poem8857.html","عموديه"],[70,"وثقيل كأنما","https://www.aldiwan.net/poem43030.html","مجزوء الخفيف"],[45,"كفي الملامة أو دومي على العذل","https://www.aldiwan.net/poem65639.html","البسيط"],[44,"وثناياك إنها إغريض","https://www.aldiwan.net/poem30475.html","الخفيف"],[74,"أي زمان جاد إلا نهب","https://www.aldiwan.net/poem12849.html","السريع"],[105,"لمن دم في مغاني الحي مطلول","https://www.aldiwan.net/poem42135.html","البسيط"],[105,"صفوا المواكب وامشوا حولها مرحا","https://www.aldiwan.net/poem43049.html","البسيط"],[105,"نبئت ما صنع الذين تألفوا","https://www.aldiwan.net/poem43090.html","الكامل"],[105,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[105,"غضب الحماة لدين أحمد غضبة","https://www.aldiwan.net/poem43421.html","الكامل"],[40,"تحمل اليوم أم لم تبرح الأنس","https://www.aldiwan.net/poem42284.html","البسيط"],[50,"يا سلم هل قيمكم ماكث","https://www.aldiwan.net/poem64721.html","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[51,"وفقحة ٍ كالحوت في ابتلاعها","https://www.poetsgate.com/ViewPoem.aspx?id=29509",""],[51,"خلياني عند اصطكاك الخصوم","https://www.poetsgate.com/ViewPoem.aspx?id=25876",""]],"verses":[["لَو ذاقَ لَوعاتِ الهَوى لَم يَكُن","هَوى ظَلومٍ عِندَهُ ذَنبا",0,"ب",2,0],["لَوذَعِيٌّ إِن يَبلُهُ الخُبرُ يَوماً","أَخجَلَ الوَردَ عَن خَلائِقَ زُهرِ",1,"ر",1,0],["لَو ذُكِرَت طَيٌّ عَلى فَرسَخٍ","أَظلَمَ في ناظِرِكَ النورُ",2,"ر",1,0],["لو ذكرناها لذي جدَثٍ","قام نشواناً من الجدَث",3,"ث",1,0],["لو ذقتَ بردَ رضابٍ في مراشفه","يا حارُ مل لمَّت أعضائي التي ثملت",4,"ت",1,0],["لو ذاق حالة مهجتي ما راعني","دعه يروع ولا يقاسي حالها",5,"ل",3,0],["لَوْذعيٌّ له فؤادٌ ذكيٌّ","ماله في ذكائه من ضَريبِ",6,"ب",1,0],["لوذعيّاً كأنَّ ما بين عطفي","هِ مصابيحُ كُلِّ ليلٍ بهيم",7,"م",1,0],["لَوذَعِيُّ الفُؤادِ يَلعَبُ بِالأَل","بابِ لُعباً إِن شاءَ أَن يَتَسَلّى",8,"ل",2,0],["لَو ذَكَرتَ اِسمَهُ عَلى ال","ماءِ ما ساغَ شُربُهُ",9,"ب",2,0],["لَو ذُقتِ ما ذُقتُهُ مِن حَرِّ بَينِهِمِ","لَكُنتِ في شُغُلٍ عَنّي وَعَن عَذَلي",10,"ل",2,0],["لَوذَعِيٌّ يُهَلِّلُ المَشرَفِيُّ ال","عَضبُ عَنهُ وَالزاعِبيُّ النَحيضُ",11,"ض",1,0],["لَو ذابَ هَذا لَجَرى فِضَّةً","أَو جَمَدَت تِلكَ لَكانَت ذَهَب",12,"ب",1,0],["لوذوا بركنٍ من الأخلاقِ مُمتنِعٍ","تَهوِي الفيالقُ عنهُ والأساطيلُ",13,"ل",1,0],["لُوذي بإيمانكِ العالي إذا عَصفتْ","هُوجُ الخُطوبِ بعاديِّ الذَّرى فطحا",14,"ح",2,0],["لوذوا بِآدابِ الحَياةِ وَراقِبوا","نَزَواتِ قَومٍ ناقِمينَ غِضابِ",15,"ب",1,0],["لَو ذاقَ أَهوالَ الحُروبِ جُناتُها","كَفَّ العَسوفُ وَأَمسَكَ السَفّاحُ",16,"ح",1,0],["لُوذوا بِأروَعَ ما تَخافُ نُفوسُكُم","إِنّ الكِتابَ عَلى النُفوسِ لَأَخوَفُ",17,"ف",1,0],["لَو ذَهَبُوا لَم يَطِب نَجدٌ لِساكِنِهِ","وَقَد يَطِيبُ بِهِم نَجدٌ إِذا جَلَسُوا",18,"س",3,0],["لَو ذُقتُها يَقظانَ أَو نائِماً","عِشتُ وَلَم يَكرِثني الكارِثُ",19,"ث",1,0],["لوذعِيٌّ كُنتُ أَرجو كَونَهُ","خَلفاً مِنّي إِذا المَوتُ طَرق",20,"ق",1,0],["لو ذُرعت شقت على ذُرَّاعها","فهو سخي النفس عن إقطاعها",21,"ع",3,0],["لوذعياً كأن مابين عطفي","لا ابتداعٌ والعلمُ بالتعليم",22,"م",1,0]]}