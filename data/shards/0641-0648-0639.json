{"poems":[[75,"هل عهدنا الشمس تعتاد الكلل","https://www.aldiwan.net/poem11918.html","الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43705","المجتث"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9510","المديد"],[113,"تباشر النجح لما","https://www.aldiwan.net/poem16238.html","المجتث"],[119,"أي يوم يا ريم عيني تراكا","https://www.aldiwan.net/poem40860.html","عموديه"],[147,"أرى سفها ولو جاء العذول","https://www.aldiwan.net/poem11804.html","الوافر"],[154,"من عذل العقرب في لسعها","https://www.aldiwan.net/poem68513.html","السريع"],[164,"قالت سليمى ابشر فموعدنا الغد","https://www.aldiwan.net/poem58811.html","الكامل"],[244,"الله ربي والحنيفةُ ديني","https://www.aldiwan.net/poem1095.html","الكامل"],[244,"في ليلة صبغ الظلام أديمها","https://www.aldiwan.net/poem23837.html","الكامل"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[371,"أما فوقها إلا نجود وأنهم","https://www.aldiwan.net/poem17330.html","الطويل"],[463,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59410","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78010","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27600","الهزج"],[2701,"","https://poetry.dctabudhabi.ae/diwan/poem/31448","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205039","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111445","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111490","الكامل"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21553","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33516","الكامل"],[4775,"وخزات","https://www.poetsgate.com/ViewPoem.aspx?id=175338",""],[4927,"رسالة حب","https://www.poetsgate.com/ViewPoem.aspx?id=29840",""],[4955,"رحلت وكنت لي وطنا","https://www.poetsgate.com/ViewPoem.aspx?id=195079",""],[5376,"تُهانُُ القدسُ ما فيكم مروءةْ","https://www.poetsgate.com/ViewPoem.aspx?id=203293",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5703,"لقاء","https://www.poetsgate.com/ViewPoem.aspx?id=213604",""],[6177,"رَجْعُ الغِياَب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79067&r=&rc=14",""]],"verses":[["فَوَعى الحِكمَةَ عَن قائِلِهِم","اِلزَمِ الصِحَّةَ يَلزَمكَ العَمَل",0,"ل",1,0],["فَوَعدكَ اِستَنجَزوهُ","هَل عَودَةٌ فَاِنتِظارُ",1,"ر",1,0],["فَوَعَتنا غَيرَ فاضِلَةٍ","تَزِنُ الأَرضَ بِميزانِ",2,"ن",1,0],["فَوَعد غَيرك كذباً","يَلقى ووَعدَكَ صِدقا",3,"ق",2,0],["فوعينيك لم يزل نصب عيني","اينما كنت بارزا معناكا",4,"ك",2,0],["فَوَعرُ المَكرُماتِ عَلَيهِ سَهلٌ","وَصَعبُ النائِباتِ لَهُ ذَلولُ",5,"ل",1,0],["فَوَعدُها داعٍ إلى خلفِهَا","وَوَصلُهَا عاد إلى قطعها",6,"ع",3,0],["فوعدنهُ عنكَ المنى بمواعد","ما قد وفي منها لديه موعدَ",7,"د",1,0],["فوعيت آياتِ الكتاب مترجما","بقرار صدق من نهاك رزين",8,"ن",1,0],["فوعى يقين الكائنات بلحظة","ما ليس تدرك حصره الآماد",9,"د",1,0],["فوعدك لا تخلف ولو لمقاتل","فصل قبله فورا الى ظهر ميدان",10,"ن",1,0],["فَوَعدٌ بِهِ الراجي عَلى الماءِ قابِضٌ","وَعَقدٌ بشهِ الراضي عَلى الماءِ يَرقُمُ",11,"م",1,0],["فوعى فهبّ يحلّ خيط جفونه","بالكُرهِ من كفّ النعاس العاقد",12,"د",1,0],["فوعزي لأقسمن سواء","جملة اليوم بيننا تفضيلا",13,"ل",2,0],["فوعى ولم يك واعياً","ورأى ولم يك مبصرا",14,"ر",2,0],["فَوَعَظَ الناسَ فَخالَفوهُ","وَنَفروا عَنهُ وَفارَقوهُ",15,"ه",1,0],["فوعدي صادقٌ مني","إذا صدقتَ في وعدك",16,"ك",1,0],["فَوعَدَكَ لا يَشِنهُ المَطلُ إِنّي","رَأَيتُ المَطلَ يُرزي بِالكَريمِ",17,"م",1,0],["فوعدتها بالثوب أحضره لها","قالت وأبغي أن يكون جميلا",18,"ل",2,0],["فوَعى ذِيُومِيذُ المَلامَةَ صَامِتاً","رَعياً لِحُرمَةِ سَيِّدِ الرُّؤَساءِ",19,"ا",2,1],["فَوَعَى ذِيُومِذُ صَوتَها ثُمَّ اعتَلى","عَجَلاً وأُوذِسُ بالحَنِيَّةِ يَقرَعُ",20,"ع",1,0],["فَوَعودهنَّ إِذا وَعَدنَكَ باطلٌ","وَبُروقُهُنَّ كَواذِبُ الإِيماضِ",21,"ض",1,0],["فوعزةٍ سكَنت جوانحَهُ","ما إن سَلاكَ ولا ابتَغى بدلا",22,"ل",2,0],["فوعاء دمعي لا يزال محملا","والكأس من فيض المداد تعاق",23,"ق",1,0],["فَوَعْدِيْ فِي الْمَحَبَّةِ وَعْدُ حُرٍّ","وَلَوْ كَثُرَ التَّوَعُدُº وَالْوَعِيْدُ",24,"د",1,0],["فوعدكَ لي يصبِّرني","يُهدِّئُ قلبَ إنساني",25,"ن",2,0],["فوعد الله صدقٌ وهْو حقٌ","وما وعدٌ بحقٍ من نبوءةْ",26,"ا",2,0],["فوعيت ما أوحي وقد ألقى به","قولا من الذكر الحكيم ثقيلا",27,"ل",2,0],["فَوَعينا من نشوةٍ خوفَ واشٍ","فافترقنا ..وَليتنا ماوَعينا",28,"ن",2,0],["فوعدُ النّصر ، يومُ النّصرِ آتٍ","شِفاءً للصّدور وللغليلِ",29,"ل",1,0]]}