كِ الليلكِ العذبِ",213,"ب",1,0],["وليس معتصمٌ في غزو روميةٍ","\"وقد تقدمه جيشٌ من الرُعُب\"",214,"ب",1,0],["وليس مقام فوق ما قد جلوته","سوى عالم اللهوت منه تجلت",215,"ت",1,0],["وليس من الغباء تكون غيثاً","ولكن حين تستسقي كذوبا",216,"ب",2,0],["وليس من الجبانةِ نشر سلمٍ","ولكنّ الجبانة في الخُتورِ",217,"ر",1,0],["وليس من المذلة فَرْطُ لُطْفٍ","فلطف النفس يذكو كالعبيرِ",217,"ر",1,0],["وليس مصالح الدنيا خِلافٌ","ولكن في توافقها النّضيرِ",217,"ر",1,0],["وَ لَيسَ مَيتًا لِكَي نَنعاهُ فِي كَمَدٍ","لَكِنَّنا نَحنُ مَوتَى الرُّوحِ يا بَشَرُ",218,"ر",1,0],["وليس من آية جاء النبي بها","إلا وجاء علي في مواخيها",219,"ي",3,0],["وَلَيسَ مِن عَيبٍ بِإبداعِهِ","لكِنَّنا نَعيثُ في مَصنَعِه",220,"ع",2,0],["وَلَيسَ مَن يَدَّعي الإِيمانَ مُهتَدِياً","ما دامَ يَغمِطُ قِسطَ البائِسِ التَّعِبِ",221,"ب",1,0],["وليس من العزم أن ينطفي","لهيب الفداء ولم يضرم",222,"م",1,0],["وليس من حرمة أو رحمة لكم","تحنوا عليكم إذا عضتكم النوب",223,"ب",1,0],["وَلَيسَ مِنَ العِلمِ في كَفِّهِ","ِذا ذُكِرَ العِلمُ غَيرُ التُرابِ",224,"ب",1,0],["وليس مملوكٌ ولا مَالِكٌ","بخالدٍ كُلٌّ بموتٍ رَهينْ",225,"ن",1,0]]}