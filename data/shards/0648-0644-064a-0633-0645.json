s://www.poetsgate.com/ViewPoem.aspx?id=26475",""],[4737,"متى الذهاب إلى الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=212154",""],[4755,"مُجتَمَعُ العَناكِب","https://www.poetsgate.com/ViewPoem.aspx?id=205179",""],[4578,"قد زف كأس التهاني بالصفا وسعى","https://www.poetsgate.com/ViewPoem.aspx?id=49470",""],[4929,"دردشة مع ابن زيدون","https://www.poetsgate.com/ViewPoem.aspx?id=202227",""],[4984,"\" ليس الأدل \" 2","https://www.poetsgate.com/ViewPoem.aspx?id=175833",""],[4994,"رحيل رجل يشبهني","https://www.poetsgate.com/ViewPoem.aspx?id=208925",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[585,"مهلاً عليَّ فإني الموجع الدنف","https://www.poetsgate.com/ViewPoem.aspx?id=161915",""],[5150,"المعلم ...!","https://www.poetsgate.com/ViewPoem.aspx?id=202918",""],[5150,"اخوة في سجل العائلة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204652",""],[5183,"الشِّْعرَى","https://www.poetsgate.com/ViewPoem.aspx?id=186427",""],[5205,"غزاة عينيك حاربت كبدي","https://www.poetsgate.com/ViewPoem.aspx?id=120992",""],[5277,"زهرة البيتونيا","https://www.poetsgate.com/ViewPoem.aspx?id=190958",""],[5277,"القصيدةُ الذئبية","https://www.poetsgate.com/ViewPoem.aspx?id=193351",""],[5277,"القدسُ..القدسُ..يا عربُ","https://www.poetsgate.com/ViewPoem.aspx?id=194614",""],[5277,"فطرةُ القدس","https://www.poetsgate.com/ViewPoem.aspx?id=195025",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[592,"إن الأمور التي الأعداء تبديها","https://www.poetsgate.com/ViewPoem.aspx?id=128826",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5409,"تحولت بعدك الأرياف والمدن","https://www.poetsgate.com/ViewPoem.aspx?id=155486",""],[5542,"الباحة اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=10055",""],[5561,"أطلِقْ عنانَكَ","https://www.poetsgate.com/ViewPoem.aspx?id=192746",""],[5582,"لِمَنْ بِسِقْطِ اللِّوَى وَالمُنْحَنَى طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187219",""],[5612,"الوَعْدُ الحَقّْ","https://www.poetsgate.com/ViewPoem.aspx?id=181334",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5691,"شهيد الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=206246",""],[5751,"الذنب أجر المحبين","https://www.poetsgate.com/ViewPoem.aspx?id=214780",""],[5770,"كم في الموت من عجبِ","https://www.poetsgate.com/ViewPoem.aspx?id=178685",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5956,"غبي أنت","https://www.poetsgate.com/ViewPoem.aspx?id=193529",""],[5956,"لحل المشكلات","https://www.poetsgate.com/ViewPoem.aspx?id=194892",""],[6102,"الشهيد ..","https://www.poetsgate.com/ViewPoem.aspx?id=182893",""],[6142,"ما أوتيت أنبياء الله قبل من ال","https://www.poetsgate.com/ViewPoem.aspx?id=155711",""],[5309,"لا تكثروا هذرا على مسمعه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573847",""],[5309,"فرخ من الجن بين المجرمين ربي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573553",""],[5724,"ربيعك للروح كالبلسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55133&r=&rc=0",""],[186,"تنبهوا واستفيقوا أيها العرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55739&r=&rc=2",""],[4247,"لَنا صاحِبٌ مولَعٌ بِالخِلافِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79003&r=&rc=1",""],[572,"أيُّ حِرَاكٍ غالَ منكَ السكونْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9491&r=&rc=348",""]],"verses":[["وَلَيسَ مِنَ الفَراغِ يَثُرنَ عَنّي","نَفاثاتٌ يَجيشُ بِها الجَنانُ",0,"ن",1,1],["وَلَيسَ مَقالٌ حَرَّكَتهُ حَفيظَةٌ","وَعَهدٌ كَقَولِ القَإِلِ المُتَصَنِّعِ",1,"ع",1,0],["وَلَيسَ مِنَ الإِنصافِ أَن حَلَّقَت بِكُم","قَوادِمُ عِزٍّ طاحَ في الجَوِّ قابُها",2,"ب",3,0],["وَلَيسَ مَديحٌ ما قَدَرتُ فَإِن يَكُن","مَديحٌ عَلى رُغمي فَلَيسَ ثَوابُ",3,"ب",1,0],["وَلَيْسَ مَشِيباً مَا تَروْنَ بمَفْرِقِي","وَلَكِن خُطُوبٌ جَمَّةٌ ذَاتُ أَلْوَانِ",4,"ن",1,0],["وَلَيسَ مُجيراً إِن أَتى الحَيَّ خائِفٌ","وَلا قائِلاً إِلّا هُوَ المُتَعَيَّبا",5,"ب",2,0],["وَلَيسَ مُستَنزِلُ الأَوعالِ من يَفَعٍ","كَمَن أَتى نَفَقَ اليَربوعِ فَاِحتَفَرا",6,"ر",2,0],["وليسمي حن جي","صحيح بحمد اللّه",7,"ه",1,0],["وليس من أصبح يمشي الخيزلى","في معرض السبق كما شي الهيذبي",8,"ي",1,0],["وليس مَن عاش في ذُلٍّ بمغتَبَط","ولا الذي مات في عزّ بمغبون",9,"ن",1,0],["ولي سماء لهاة","فهل ترى من فطور",10,"ر",1,0],["وليس مِنِّي ذاك بل منكُمُ","يا نجْلَ صنديد فصنديد",11,"د",1,0],["وليس منكم لمن يرجو منافعكم","في العسر واليسر إلا الرد والحلف",12,"ف",1,0],["وليس مثلي ينامُ عن خَلَلٍ","في مدح ممدوحِه ولا زلَلِ",13,"ل",1,0],["وليس معارضي إلا زهيرٌ","ومن أبكته حَوْمَلُ والدخولُ",14,"ل",1,0],["وليس مثلك بالمخذول آمِلُه","إذا أطاع جميلَ الفعل إمكان",15,"ن",1,0],["وليس ما يأْتي بهِ مُنْكَراً","ولا يقولُ الإفكَ هاجيه",16,"ي",2,0],["وَلَيسَ ما بي يا رَبُّ داءٌ","وَلا اِحتِياجي إِلى دَواء",17,"ا",2,0],["وَلَيس مِن نَقصٍ وَلا مِن كَمال","فَالشَوكُ في الطَهقيقِ مِثلُ الأَقاح",18,"ح",1,0],["وَلَيسَ مَشيباً ما تَرونَ بِعارِضي","فَلا تَمنَعوني أَن أَهيمَ وَأَطرَبا",19,"ب",2,0],["وَلَيسَ مِنَ اللائي يَبيعُ مُخارِقٌ","بِحَجرٍ وَلا اللائي خَضَرنَ المَدارِعا",20,"ع",2,0],["وليس موتي غير تغيير","ي فيك السكنا",21,"ن",2,0],["وليس معي في لآوبتي لا نُهى ولا","عزاءٌ ولا قلب لشخصي يصاحب",22,"ب",1,0],["وليس مرتضياً في دينه جدلاً","إلا الذي هو في شك من الدين",23,"ن",1,0],["وليس من الغريب سواد حظي","وبالسودان قد طال التصاقي",24,"ق",2,0],["وليس من بينهم نزيه","ولا أنا الواحد النزيه",25,"ه",1,0],["وَلَيسَ مَصيرُهُنَّ إِلَيكَ شَيناً","وَلا في صَونِهِنَّ لَدَيكَ عابُ",26,"ب",1,0],["وَلَيسَ مُؤَدِّباً إِلّا بِنَصلِ","كَفى الصَمصامَةُ التَعَبَ القَطيعا",27,"ع",2,0],["وَلَيسَ مَتبِعَ مَعروفٍ تَنولُ بِهِ","يَداهُ مَنّاً إِذا أَعطى وَلا كَدَرا",28,"ر",2,0],["وَلَيسَ مانِعَ ذي قُربى وَذي نَسَبٍ","يَوماً وَلا مُعدِماً مِن خابِطٍ وَرَقا",29,"ق",2,0],["وَلَيسَ مَن مَوضِعٍ يَأتيهِ ذو نَفسٍ","إِلّا وَلِلمَوتِ سَيفٌ فيهِ مَسلولُ",30,"ل",1,0],["وَلَيْسَ مَعْذِرَةٌ فِي الاتِّبَاعِ سِوَى","أَنِّي وَجَدْتُ مِنَ التَّحْنَانِ مَا وَجَدَا",31,"د",2,0],["وَلَيْسَ مَعْذِرَةٌ فِي الاْخْتِلافِ سِوَى","أَنِّي أَرَدْتُ حَدِيثَاً يُثْبِتُ السَّنَدَا",31,"د",2,0],["وَلَيسَ مِنهُمُ سِوى اِبنِ النَبِيِّ","وَأَنا أَفديكَ بِأُمّي وَأَبي",32,"ي",1,0],["وليس من الآنس البهائم إن جرت","مع الإنس في معنى الحياة البهائم",33,"م",1,0],["وليُسْمَعَنّ صَلِيلُها في هامِهِم","إن كان يُسمَعُ للسيوفِ صَليل",34,"ل",1,0],["وَلَيسَ ما يُنقَلُ عَن عاصِمٍ","كَما رَوى عَن شَيخِهِ قُنبُلُ",35,"ل",1,0],["وَلَيسَ مُحَمَّدٌ فيما أَتَتهُ","وَلا اللَهُ القَديرُ بِمُحمِدَيها",36,"ي",3,0],["وليسَ مِن ذِي عزَّة وشدَّه","إلا توافَوا عندَ بابِ السُّدَّه",37,"ه",1,0],["ولَيْسَ مَنْ مَاتَ فَاسْتراحَ بِمَيْتٍ","إنما الميْتُ مَيِّتُ الأحْيَاءِ",38,"ا",2,0],["وليس من الدين الحجاب لو أننا","رجعنا إلى أحكامه نتفهم",39,"م",1,0],["وليس من جهنم","لميت قد انشعب",40,"ب",1,0],["وليس من قد أباد قوماً","لهم على ما أرى يعيد",41,"د",1,0],["وَلَيسَ من قوة في الكون قاهرة","تَسطيع أَن تقعد الأقوام إن نهضوا",42,"ض",3,0],["وَلَيسَ مناص من هويّ يميتني","إذا زلقت رجلي وَلاقيت مهواةَ",43,"ه",1,0],["وَلَيسَ من فئة حيف على فئة","وَلا عَلى هابط ظلم وعدوان",44,"ن",1,0],["وليس منكم حولها هاتفٌ","تسكب موسيقاهُ سِحرَ البيانْ",45,"ن",1,0],["وَلَيسَ مُستَعظَماً فَضلٌ وَلا كَرَمٌ","مِن صاحِبِ السِكَّةِ الكُبرى وَمُنشيها",46,"ي",3,0],["وليس من عرض ولا حريم","تحميه فوق الوطن الكريم",47,"م",1,0],["وَلَيْسَ مَلامِي عَلَى مَنْ وَشَى","وَلَكِنْ مَلامِي عَلَى مَنْ وَعَى",48,"ع",2,0],["وليس مَنْ تَتَبَنَّاه لِتْحميَهُ","إلا يتيمًا له الهَمُّ المُقيم أب",49,"ب",1,0],["وليسمعِ الناسُ شكوىَ من له اجتمعتْ","غضاضةُ العيشِ والأرهاقُ والبِكَم",50,"م",1,0],["وليسَ مجبراً إنْ أتى الحيَّ خائفٌ،","وَلا قَائِلاً إلاّ هُوَ الُمتَعَيَّبَا",51,"ب",2,0],["وليس معى مالٌ أُكافئه به","ولكن سأدعو أن يطالَ له العُمرُ",52,"ر",1,0],["وَلَيسَ مَوتي عَجيباً بَعْدَ بينِكُمُ","وإِنَّما في حياتي بَعدكم عَجَبُ",53,"ب",1,0],["وليس من فاجاه بالشوق الهوى","يوما كمن في قلبه الشوق كمن",54,"ن",1,0],["وليس مقالي هان ما بي مناقضاً","لقولي زاد الوجد والوجد مسقمي",55,"م",2,0],["وَلَيسَ مَن تُكرِمُهُ لِغَيرِهِ","مِثلَ الَّذي تُكرِمُهُ لِنَفسِهِ",56,"س",2,0],["وليسمحَنَّ بصَبْرةٍ من عجدٍ","مُكتالةٍ لكلاميَ الموْزون",57,"ن",1,0],["وَلَيسَ مَناخُ السوءِ حَتماً مُقَدَّراً","عَلَيَّ لِأَن أَضحى مَقَرّاً وَمَولِدا",58,"د",2,0],["وَلَيسَ مِن حُرمةٍ أَو رَحمةٍ لَكُمُ","تَحنو عَلَيكُم إِذا عضتكمُ النُّوَبُ",59,"ب",1,0],["وليس ما قلتُ ولكنّه","آثارُ لَمْسي فيه أو جَسِّى",60,"س",2,0],["وليسَ من الأوطانِ من لم يكن لها","فداء وإن أمسى إليهنَّ ينتمي",61,"م",2,0],["وليس مرادي منك جائزة سوى","خلاص دنانير تزيد على عشر",62,"ر",1,0],["وَلَيسَ مُبيِّنٌ في الدارِ إِلّا","مَبيتُ ظَعائِنٍ وَصَدىً يَصيحُ",63,"ح",1,0],["وليس من عاف خبيث الهوى","يمكنه من ذوقه الطيب",64,"ب",1,0],["وليسَ مَلوماً من تمتَّعَ ساعةً","من الحُسنِ لكنَّ الملومَ أخو الزّهد",65,"د",1,0],["وليسَ مطيتي إِلا زحوفاً","أحَبُّ إِليَّ من ذاتِ الوخيد",66,"د",1,0],["وَلَيسَ مَعي زاد وَلالي وَسيلَة","بَلى هاشمى بالبهاء متوّج",67,"ج",1,0],["وَلَيسَ مَسكٌ أَدفَرٌ","يَصيرُ مِسكاً أَذفَرا",68,"ر",2,0],["وليس معي إلا انكسار وذلة","وفقر وذنب والمهيمن غفار",69,"ر",1,0],["وَلَيسَ مِن أَمَلٍ في قَهرِ سَطوَتِها","فَلا تَرُم بِالمَعاصي كَسرَ شَهوَتِها",70,"ه",2,0],["وَلَيسَ مِمّا قَضاهُ اللَهُ مِن هَرَبِ","وَبَعدَما شاهَدوا في الأَرضِ مِن عَجَبِ",70,"ب",1,0],["وَلَيسَ مِنَ الحُبِّ في عِدَّةِ المُحِبّينَ","قَلبٌ لَهُ فيهِ قَلبُ",71,"ب",1,0],["وَلَيسَ مِنهُم إِلّا عَلى مَن","خالَفَهُ يُبدي الشَناعَه",72,"ع",2,0],["وَلَيسَ مِنَ الزُهدِ في رُتبَةٍ","أَخو رَغبَةٍ في ثَناءٍ عَلَيهِ",73,"ه",1,0],["وَلَيسَ مَوت اِمرىء شاعَت فَضائِلُه","كَمَوت مَن لا لَه فَضل وَعرفان",74,"ن",1,0],["وَلَيسَ مَوت الَّذي ماتَت له أُمَم","كَمَوتِ شَخص من الاوغاد والسفل",75,"ل",1,0],["وليس من البدائعِ حينَ تُمْحَى","بجُودِ يَديْكَ آثارُ الرّزايا",76,"ا",3,0],["وليس منَ العجيبِ وأنتَ بحْرٌ","إذا غاصوا على دُرَرِ المَعاني",77,"ن",2,0],["وَلَيسَ مَع الأَقدار لِلمَرء حيلة","فَلا بُدَّ مِن شَكوى الخَطوب إِلى الرَب",78,"ب",1,0],["وليس مجيئي رحيلاً، وهل","إلى بيته ساكنٌ يَرْحَلُ",79,"ل",1,0],["وليسَ مثلكَ مَنْ بالصَّبر نأمرُه","فأنتَ أنتَ الَّذي يَهْدِي إلى الرشدِ",80,"د",1,0],["وليس مثل الإِله شيء","فلا مثال ولا مَثِيلَ",81,"ل",1,0],["وليس ممنوعاً من الجر بلا"