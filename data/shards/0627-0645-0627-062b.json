{"poems":[[77,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85597","البسيط"],[98,"سمر","https://www.poetsgate.com/ViewPoem.aspx?id=17489",""],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[447,"لما أتى الزير موسى يسأل الباري","https://www.aldiwan.net/poem14407.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138254",""],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53756","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128080","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110255","الكامل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136436",""],[4679,"يجد الفتى كما يعيش مُخلَّدَا","https://www.poetsgate.com/ViewPoem.aspx?id=142735",""],[5190,"الطين والماء","https://www.poetsgate.com/ViewPoem.aspx?id=82169",""],[5334,"إني رأيتُ جريراً يوم فارقنا","https://www.poetsgate.com/ViewPoem.aspx?id=96976",""]],"verses":[["أمّا ثَنائي فهو عنك مُقَصِّرٌ","والعيُّ بالفُصَحاءِ ما لا يَجْمُل",0,"ل",1,0],["أماثل من ذرى بيروت قد لمعوا","في جو ليل من الأحداث معتكر",1,"ر",1,0],["أم أثرت للحقّ الطّريد","، وبالبطولة قد فتنت",2,"ت",1,0],["أَما ثمّ فَرقٌ بين عينٍ وأختها","فَواحدةٌ حورا وواحدةٌ عورا",3,"ر",2,0],["أَما ثبير وثور والاشم حرى","أَم القرى نزلت في خير أَمصار",4,"ر",1,0],["أماثل الناس أموها وقد جذلوا","كأنهم شربوا ماء العناقيد",5,"د",1,0],["إمّا ثويتَ فما أبقيت مكرمةً","إلاّ بكفك منها العين والأثرُ",6,"ر",1,0],["أماثل أنجاد معاقل سؤدد","أفاضل أمجاد صدور مجامع",7,"ع",1,0],["أما ثم غفران ولست بمذنب","ويجبر من بعد الجفا سيدى كسرى",8,"ر",2,0],["أما ثريا فاستقلَّ بامرها","كهلٌ كثير المالِ والاعتابِ",9,"ب",1,0],["أماثل كل الناس تهوى بيانه","وفي مثله الأمثال تتلى وتضرب",10,"ب",1,0],["أماثل لم يدروا سوى العز معقلاً","وما لبسوا غير الكمال لهم ردا",11,"د",2,0],["أَمَا ثُرتَ بَعدَ الصَّمتِ عُمراً عَلَى الأَذَى","وأَظهَرْتَ عَينَ السُّخطِ جَمراً لِمَن رَقَأْ",12,"ا",1,0],["إما ثويتَ مقيماً فوقَ رابيةٍ","فقد مضت لك أيامٌ لها غررُ",13,"ر",1,0]]}