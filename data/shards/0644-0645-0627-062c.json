","https://poetry.dctabudhabi.ae/diwan/poem/123795","الكامل"],[4346,"","https://poetry.dctabudhabi.ae/diwan/poem/100665","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83506","الخفيف"],[4408,"","https://poetry.dctabudhabi.ae/diwan/poem/46040","الرمل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119560","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72440","الرمل"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105192","الرمل"],[4759,"غربتي أنت","https://www.poetsgate.com/ViewPoem.aspx?id=203678",""],[5002,"سحر النَّبضِ","https://www.poetsgate.com/ViewPoem.aspx?id=202637",""],[5050,"خفف العذل عن محب تصامم","https://www.poetsgate.com/ViewPoem.aspx?id=38204",""],[5106,"أيُّ عِيدٍ .، أيُّ سَعدٍ .","https://www.poetsgate.com/ViewPoem.aspx?id=145916",""],[5147,"مخيلتي تطالبني بأمر","https://www.poetsgate.com/ViewPoem.aspx?id=166714",""],[5190,"يا صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=123994",""],[4045,"لو كنت تأخذ مثل ما","https://www.poetsgate.com/ViewPoem.aspx?id=200272",""],[5277,"سيدي العراق","https://www.poetsgate.com/ViewPoem.aspx?id=201721",""],[5302,"قرب الخليل","https://www.poetsgate.com/ViewPoem.aspx?id=200554",""],[5302,"جعلت فداكا","https://www.poetsgate.com/ViewPoem.aspx?id=205728",""],[5550,"سكر القلب","https://www.poetsgate.com/ViewPoem.aspx?id=211901",""],[5550,"كفاني","https://www.poetsgate.com/ViewPoem.aspx?id=214552",""],[5563,"جنون العشق","https://www.poetsgate.com/ViewPoem.aspx?id=211921",""],[5691,"الكوكب الأحمر... الوطن القادم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206733",""],[5956,"نزهة","https://www.poetsgate.com/ViewPoem.aspx?id=182044",""],[5956,"ارحميني","https://www.poetsgate.com/ViewPoem.aspx?id=182191",""],[5956,"لو تكرمتِ أريد الزنجبيلا","https://www.poetsgate.com/ViewPoem.aspx?id=182376",""],[5956,"آهِ جافاني","https://www.poetsgate.com/ViewPoem.aspx?id=192492",""],[5956,"منذ أيام","https://www.poetsgate.com/ViewPoem.aspx?id=192801",""],[5970,"جهل الناس والزمان ومالي","https://www.poetsgate.com/ViewPoem.aspx?id=130595",""],[5980,"لما جفا جفني الكرا لفراقه","https://www.poetsgate.com/ViewPoem.aspx?id=146275",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6067,"بائع العسلية","https://www.poetsgate.com/ViewPoem.aspx?id=177158",""],[6108,"شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=192753",""],[520,"في مثل ذا الموقف المشهود تنتخب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577437",""],[6202,"يا أبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86763&r=&rc=64",""],[5957,"دموع الانتظار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82572&r=&rc=116",""],[6229,"مرآةُ عصرنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65213&r=&rc=36",""],[6355,"موطني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66616&r=&rc=76",""]],"verses":[["لَم أَجِد صانِعاً سِواكَ وَلا أَع","رِفُ في الناسِ مُنعِماً ما سِواكا",0,"ك",2,0],["لَمّا جَرَيتَ جَرَت خَيلٌ سَواسِيَةٌ","وَلَّت وَخافَ عَلى أَنفاسِها البَهَرُ",1,"ر",1,0],["لَم أُجاوِزكَ بِالدُعاءِ فَلَبَي","تَ جَهاراً وَقَد دَعَوتُ سَرارا",2,"ر",2,0],["لَمّا جَفاني أَخِلّائي وَأَسلَمَني","دَهري وَلحمُ عِظامي اليَومَ يُعتَرَقُ",3,"ق",1,1],["لَم أَجِد أَهلاً لِوُدّي","غَيرَ مَن أَصفَيتُ وُدّي",4,"د",2,1],["لم أجِدْ فيهِ لينَ بَثٍّ لقَلْبي","وقَبولاً لحُجّتي واعْتِذاري",5,"ي",1,1],["لمْ أجِدْ مُسْلِماً يقومُ بحقي","ناظِراً لي بمُقلَةِ اسْتعْبارِ",6,"ر",1,0],["لَم أَجِد حُبَّها يُشَاكِلُهُ الحُ","بُّ وَلاَ وَجدَنَا كَوَجدِ الرِجَالِ",7,"ل",1,0],["لَمّا جَمَعتُ غُواةَ الناسِ في قَرَنٍ","غادَرتُهُم بَينَ مَحسورٍ وَمَفروسِ",8,"س",1,0],["لَم أَجزِهِ بِأَحسَنِ البَلاءِ","أَطَعتُ حِرصي وَعَصَيتُ دائي",9,"ي",1,0],["لم أجد عذرك للمح","تال فيه المتلطف",10,"ف",1,0],["لم أجشّمك أن تكون شفيعاً","ليَ إلّا إلى فتىً مفضالِ",11,"ل",1,0],["لم أجنِ ذنباً إليه أعلمُهُ","ولا جناه إلى الذي خدما",12,"م",2,0],["لم أجبْها إذ كنتُ مَيْتاً فلولا","كان حيٌّ أجابها عن عِظامي",13,"م",2,0],["لَم أَجِد في القَصرِ شَيئاً لَيسَ في الكوخِ المَهينِ","أَنا في هَذا وَهَذا عَبدُ شَك وَيَقينِ",14,"ن",1,0],["لَم أَجِد لي مُشبِهاً تَحتَ السَما","في شَقائي لا وَلا فَوقَ الثَرى",15,"ر",2,0],["لم أجد في الوُجُودِ إلاَّ شقاءً","سَرْمَديًّا ولذَّةً مُضْمَحِلَّةْ",16,"ه",1,0],["لمْ أجدْ في الحَيَاةِ لحناً بديعاً","يَسْتَبيني سِوى سَكينَةِ نَفْسي",17,"س",2,0],["لما جهلت من الحقيقة أمرها","وأقمت نفسك في مقام معلل",18,"ل",1,1],["لما جفاك ابن سينا","وهام بالسيارة",19,"ر",2,0],["لما جريت لغايات الندى وجرى","عجبت كيف حوى البحرين واديها",20,"ي",3,0],["لَم أَجزِها بِشِرَّةٍ","عَن غَضَبٍ وَشِرَّةِ",21,"ه",1,0],["لَمّا جَمَعتَ الشامَ مِن أَطرافِهِ","وافى يُعَزّي الشامَ فيكَ المَشرِقُ",22,"ق",1,0],["لَمّا جَلَستَ سَما وَعَزَّ كَأَنَّما","هارونُ وَاِبناهُ عَلَيهِ قِيامُ",23,"م",1,0],["لَمّا جَرى الإِصلاحُ قُمتَ مُهَنِّئاً","بِاِسمِ الحَنيفَةِ بِالمَزيدِ مُبَشِّرا",24,"ر",2,0],["لَم أُجرِ غايَةَ فِكري مِنكَ في صِفَةٍ","إِلّا وَجَدتُ مَداها غايَةَ الأَبَدِ",25,"د",1,0],["لَم أَجعَلِ الذُلَّ لِباسي لِمَن","تاهَ وَلَم أَفزَع إِلى العُذرِ",26,"ر",1,0],["لَمّا جَنَنتَ اليَومَ مِنها أَعظُماً","يَبرُقنَ بَينَ فُصوصِهِنَّ فِقارُ",27,"ر",1,0],["لَم أَجِدهُ مُؤاتِياً فَتَصَدَّق","تُ بِحَظّي مِنهُ عَلى الشَيطانِ",28,"ن",1,0],["لمّا جَرَتْ فيهِ الصَّبا عَليلةً","رقّ الهواءُ فيهِ للنّفسِ وصَح",29,"ح",1,0],["لم أجدْ للملكِ ماءً صافياً","فتيمَّمْتُ صعيداً طيِّبا",30,"ب",2,0],["لمْ أجمعِ المالَ فَخْراً","ولا لحرصٍ وغَفْلَهْ",31,"ه",1,1],["لَمّا جَرى في الأَرضِ طوفانُ الأَذى","أَجرى بِهِ الدَمَ وَالحَديدَ عُبابا",32,"ب",2,0],["لَم أَجنِ ذَنباً وَلَم آتي لَكُم سَخطاً","فَفيمَ تُحجَبُ عَنّي دُونَكِ الطَرُقُ",33,"ق",1,0],["لَمّا جَفاني الحَبيبُ وَاِمتَنَعَت","عَنّي الرِسالاتُ مِنهُ وَالخَبَرُ",34,"ر",1,1],["لمّا جفلْنَ إلى بلاي عشيَّةً","أقْوتْ معاهدُها منَ الأعلاجِ",35,"ج",1,0],["لم أجنِ وقد جَنيتُ وَرْدَ الخَفَر","إلاّ لترى كيفَ انشقاقُ القَمَرْ",36,"ر",1,0],["لمْ أجمعِ المالَ فخراً","ولا لصيتٍ وشهرَهْ",37,"ه",1,1],["لم أجدْ لي في واحة العيش ظِلاً","أو غديراً يَبُلُّ حَرَّ لهاتي",38,"ت",2,0],["لَمْ أَجْنِ فِي الْحُبِّ ذَنْبَاً أَسْتَحِقُّ بِهِ","عَتْبَاً وَلَكِنَّهَا تَحْرِيفُ أَقْوَالِ",39,"ل",1,0],["لَمْ أَجِدْ مِنْهُما بَدِيلاً لِنَفْسِي","غَيْرَ حُزْنِي عَلَيْهِما وَاكْتِئَابِي",40,"ب",2,0],["لَم أَجِد سَخلَةً وَفي كُلِّ عيدٍ","لَم تعرني مَعَ المباركِ بركُ",41,"ك",1,0],["لم أجنِ في الحُبِّ ذنباً أستحق به","عَتْباً ، ولكنها تحريفُ أقوالي",42,"ل",2,0],["لم أجد ما أريد حتّى الخطايا","أحرام عليّ حتّى جهنّم",43,"م",1,0],["لم أجد (( روضة)) ، فأدركت أزهى،","لعبة ، حلوة ولكن خطيره",44,"ر",2,0],["لَم أَجدها مِن بَعد بَعدك إِلّا","ظُلمات مِن الريا وَالنِفاق",45,"ق",1,0],["لما جرى الوصل والايام مسعفة","كانوا وكنا وكانت للزمان يد",46,"د",1,1],["لم أجدْ غيرَ مخلصٍ لكَ وُدّاً","جَوهريّاً يسرني ما قَالا",47,"ل",2,0],["لَمَّا جَنَينَا جَنىَ إجمَاعِهَا ثَمَراً","يُزرِى بِصَافِيةِ الصَّهبَاءِ والصُّبَرِ",48,"ر",1,0],["لَمّا جَعَلتَ صَليلَها عَذلاً لَهُم","إِنَّ المُلامَ بِغَيرِها لا يَنجَعُ",49,"ع",1,0],["لما جئت في معشار عشر حقوقكم","ولو كان ذا شيء يؤدي به شكر",50,"ر",1,0],["لَمْ أَجِدْ مَا بِهِ أَجودُ بِدَمعي","غَيْرَ رُوحي فَجُدْتُ بِالْمَوْجُودِ",51,"د",1,0],["لم أجد في الناس لي سكنا","منصفا في السر والعلن",52,"ن",1,0],["لم أجنِ من غرسي لهُ","غير التنكُّرِ والنفارِ",53,"ر",1,0],["لم أجد في الهوى مُعيناً أميناً","فلذاك استعنتُ بالكتمانِ",54,"ن",1,0],["لم أجعل الفقاع لي حرفة","إلا لمعنى حسنك الشاهد",55,"د",1,1],["لم أجد ما يوجب الشوق إليك","لم أجد ما يوجب العطف عليك",56,"ك",1,0],["لم أجد قبل محنتي فيك ليثا","يأخذ الأمر عن عيون الغزال",57,"ل",1,0],["لم أجد مرأة حميدا جناها","في سبيل الفناء هذه النساء",57,"ا",2,0],["لم أجزلي من التمتع فيها","غير ما جاز وانقضت كالومضه",58,"ض",2,0],["لم أجِد فيكُم فتىً ذا هِمَّةٍ","إن عدا الدَهرُ عدا أَوصالَ صال",59,"ل",1,0],["لَمّا جَفا العِذارُ بِخَدِّهِ","فَتَعَجَّبوا لِسَوادِ وَجهِ الكاذِبِ",60,"ب",1,0],["لَمْ أَجِدْ إِذْ وَرَدْتُهَا سَلْسَبِيلاً","لِمُجَارَاةِ نَظْمِهَا مِنْ سَبِيلِ",61,"ل",1,0],["لم أجد لي فيها صديقاً حميماً","غير أني بالماء فيها حَمِيمُ",62,"م",1,0],["لما جَنَحتَ أمامَ أجنِحةِ الدُّجى","كنّا بلذّاتِ الهوى لاهينا",63,"ن",2,0],["لَمّا جَرَيتُ مَعَ الضِلالِ","غَرِقَت في بَحرِ الشَمَقمَقُ",64,"ق",1,0],["لمّا