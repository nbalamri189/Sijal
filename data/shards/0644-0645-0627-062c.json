{"poems":[[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[53,"لك السوابق والأوضاح والغرر","https://www.aldiwan.net/poem30458.html","البسيط"],[53,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[6,"لما جفاني أخلائي وأسلمني","https://www.aldiwan.net/poem380.html",""],[55,"لم أجد أهلا لودي","https://www.aldiwan.net/poem26394.html","مجزوء الرمل"],[77,"لم أجد فيه لين بث لقلبي","https://www.aldiwan.net/poem36410.html","الخفيف"],[77,"إن تورعت أصبحت حوزة","https://www.aldiwan.net/poem36427.html","الخفيف"],[41,"يا لقومي لكثرة العذال","https://www.aldiwan.net/poem42361.html","الخفيف"],[27,"حي الهدملة من ذات المواعيس","https://www.aldiwan.net/poem5787.html","البسيط"],[47,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[51,"يا أبا إسحاق واقلب","https://www.aldiwan.net/poem65439.html","مجزوء الرمل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[91,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[92,"يا صميم الحياة إني وحيد","https://www.aldiwan.net/poem38927.html","الخفيف"],[92,"ينقضي العيش بين شوق ويأس","https://www.aldiwan.net/poem38933.html","الخفيف"],[89,"لما جهلت من الحقيقة أمرها","https://www.aldiwan.net/poem45123.html","الكامل"],[85,"يا مكس دنياك عاره","https://www.aldiwan.net/poem7115.html","المجتث"],[85,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[85,"لست بناس ليلة","https://www.aldiwan.net/poem8051.html","مجزوء الرجز"],[85,"جرح على جرح حنانك جلق","https://www.aldiwan.net/poem62839.html","الكامل"],[85,"هز اللواء بعزك الإسلام","https://www.aldiwan.net/poem63742.html","الكامل"],[85,"قم في فم الدنيا وحي الأزهرا","https://www.aldiwan.net/poem63764.html","الكامل"],[43,"ما الشوق مقتنعا مني بذا الكمد","https://www.aldiwan.net/poem9538.html","البسيط"],[45,"لولا اعتراض الحب في صدري","https://www.aldiwan.net/poem64520.html","السريع"],[28,"قال الملائكة الذين تخيروا","https://www.aldiwan.net/poem5254.html","الكامل"],[49,"يا خليلي لا أذم زماني","https://www.aldiwan.net/poem63131.html","الخفيف"],[80,"أي نعيم في الصبا والمقترح","https://www.aldiwan.net/poem31521.html","الرجز"],[69,"أحمد الله الذي جنبني","https://www.aldiwan.net/poem28101.html","الرمل"],[69,"لم أجمع المال فخرا","https://www.aldiwan.net/poem28574.html","المجتث"],[105,"أأفاق ظالم نفسه فأنابا","https://www.aldiwan.net/poem43091.html","الكامل"],[40,"يا من لعين قد أجلى نومها الأرق","https://www.aldiwan.net/poem42337.html","البسيط"],[48,"لما جفاني الحبيب وامتنعت","https://www.aldiwan.net/poem63333.html","المنسرح"],[76,"الحق أبلج واضح المنهاج","https://www.aldiwan.net/poem39466.html","الكامل"],[68,"عيني جرحت وجنته بالنظر","https://www.aldiwan.net/poem1499.html",""],[69,"","https://poetry.dctabudhabi.ae/diwan/poem/57407","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42731","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42507","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[87,"الهجران","https://www.poetsgate.com/ViewPoem.aspx?id=14050",""],[107,"ألف سلام عليك من مشتاق","https://www.aldiwan.net/poem16234.html","الخفيف"],[113,"لما جرى الوصل والايام مسعفة","https://www.aldiwan.net/poem41140.html","عموديه"],[126,"وحباك الإله ملكا وإنصالا","https://www.aldiwan.net/poem50531.html","الخفيف"],[130,"هذى نقول بنص الآي والأثر","https://www.aldiwan.net/poem54824.html","البسيط"],[141,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[145,"سلام عليكم دائم متتابع","https://www.aldiwan.net/poem47656.html","الطويل"],[153,"لست أنسى قلبي وقد بات نهبا","https://www.aldiwan.net/poem55722.html","الخفيف"],[184,"قيل لي لم صرت منفردا","https://www.aldiwan.net/poem43239.html","المديد"],[195,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[202,"لي حبيب قد شفني وبراني","https://www.aldiwan.net/poem53169.html","الخفيف"],[208,"لم أجعل الفقاع لي حرفة","https://www.aldiwan.net/poem13526.html","السريع"],[209,"ليلة الأمس إذا شئنا تعود","https://www.aldiwan.net/poem46248.html","الرمل"],[209,"ما على الغادرين نسكب دمعا إن","https://www.aldiwan.net/poem46763.html","الخفيف"],[219,"ذاب قلبي عليه حين تدانى","https://www.aldiwan.net/poem55285.html","الخفيف"],[223,"إنني أستغفر الله لكم","https://www.aldiwan.net/poem55137.html","الرمل"],[230,"مازال يحلف لي بكل آلية","https://www.aldiwan.net/poem14868.html","الكامل"],[235,"يا أخا اللب يا بديع القيل","https://www.aldiwan.net/poem18869.html","الخفيف"],[248,"سار والقلب في يديه مقيم","https://www.aldiwan.net/poem15026.html","الخفيف"],[268,"أنهارنا في غاب كسكاتينا","https://www.aldiwan.net/poem35629.html","الكامل"],[282,"كنت الممزق مرة","https://www.aldiwan.net/poem44325.html","مجزوء الكامل"],[295,"لما جنى الطرف ورد وجنته","https://www.aldiwan.net/poem33137.html","المنسرح"],[295,"من أين يا ريح الصبا هذا الشذا","https://www.aldiwan.net/poem33278.html","الكامل"],[296,"ورقاء ذات تفجع","https://www.aldiwan.net/poem36852.html","عموديه"],[296,"نفخ الصور فهبوا مسرعين","https://www.aldiwan.net/poem36856.html","عموديه"],[351,"كتم الهوى جلدي فليس بذائع","https://www.aldiwan.net/poem40223.html","الكامل"],[351,"لي في الحمى خل خلا عن نية","https://www.aldiwan.net/poem40565.html","الكامل"],[362,"حلفت بالساعين يوم الموقف","https://www.aldiwan.net/poem60837.html","الرجز"],[362,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[362,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[362,"يا معرضا قد آن أن تتلفتا","https://www.aldiwan.net/poem60975.html","الكامل"],[369,"الغيث أبعد منك دارا","https://www.aldiwan.net/poem57259.html","مجزوء الكامل"],[369,"رسم علي لناظري","https://www.aldiwan.net/poem57439.html","مجزوء الكامل"],[397,"أيها الغائب","https://www.aldiwan.net/poem6734.html","عموديه"],[397,"يا ضيف وجداني","https://www.aldiwan.net/poem6759.html","عموديه"],[399,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[413,"جسد أشبه شيء بالخيال","https://www.aldiwan.net/poem53953.html","الطويل"],[434,"ته فلو قستك بالظبي الغرير","https://www.aldiwan.net/poem2516.html","الرمل"],[456,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[456,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[456,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[456,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[456,"أرأيت أم حبست لحاظك عبرة","https://www.aldiwan.net/poem56150.html","الكامل"],[477,"خذ من أبيك وصايا يا سمي أبي","https://www.aldiwan.net/poem36945.html","البسيط"],[480,"نسيم الصبا عنعن وسلسل بنافح الت","https://www.aldiwan.net/poem24378.html","عموديه"],[498,"وحياتكم يا أهل منعرج اللوى","https://www.aldiwan.net/poem37677.html","الكامل"],[513,"في مثل ذا الموقف المشهود تحتلب","https://www.aldiwan.net/poem12012.html","البسيط"],[513,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[513,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[513,"رمى بنا الثغر كما ترمى الثغر","https://www.aldiwan.net/poem12162.html","الرجز"],[536,"دام بقاؤك لنا","https://www.aldiwan.net/poem47918.html","عموديه"],[549,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[556,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[584,"خط العذار إن بدا","https://www.aldiwan.net/poem17582.html","مجزوء الرجز"],[584,"أوحشتموا نظري فكم من عبرة","https://www.aldiwan.net/poem17613.html","الكامل"]],"verses":[["لَم أَجِد صانِعاً سِواكَ وَلا أَع","رِفُ في الناسِ مُنعِماً ما سِواكا",0,"ك",2,0],["لَمّا جَرَيتَ جَرَت خَيلٌ سَواسِيَةٌ","وَلَّت وَخافَ عَلى أَنفاسِها البَهَرُ",1,"ر",1,0],["لَم أُجاوِزكَ بِالدُعاءِ فَلَبَي","تَ جَهاراً وَقَد دَعَوتُ سَرارا",2,"ر",2,0],["لَمّا جَفاني أَخِلّائي وَأَسلَمَني","دَهري وَلحمُ عِظامي اليَومَ يُعتَرَقُ",3,"ق",1,1],["لَم أَجِد أَهلاً لِوُدّي","غَيرَ مَن أَصفَيتُ وُدّي",4,"د",2,1],["لم أجِدْ فيهِ لينَ بَثٍّ لقَلْبي","وقَبولاً لحُجّتي واعْتِذاري",5,"ي",1,1],["لمْ أجِدْ مُسْلِماً يقومُ بحقي","ناظِراً لي بمُقلَةِ اسْتعْبارِ",6,"ر",1,0],["لَم أَجِد حُبَّها يُشَاكِلُهُ الحُ","بُّ وَلاَ وَجدَنَا كَوَجدِ الرِجَالِ",7,"ل",1,0],["لَمّا جَمَعتُ غُواةَ الناسِ في قَرَنٍ","غادَرتُهُم بَينَ مَحسورٍ وَمَفروسِ",8,"س",1,0],["لَم أَجزِهِ بِأَحسَنِ البَلاءِ","أَطَعتُ حِرصي وَعَصَيتُ دائي",9,"ي",1,0],["لم أجد عذرك للمح","تال فيه المتلطف",10,"ف",1,0],["لم أجشّمك أن تكون شفيعاً","ليَ إلّا إلى فتىً مفضالِ",11,"ل",1,0],["لم أجنِ ذنباً إليه أعلمُهُ","ولا جناه إلى الذي خدما",12,"م",2,0],["لم أجبْها إذ كنتُ مَيْتاً فلولا","كان حيٌّ أجابها عن عِظامي",13,"م",2,0],["لَم أَجِد في القَصرِ شَيئاً لَيسَ في الكوخِ المَهينِ","أَنا في هَذا وَهَذا عَبدُ شَك وَيَقينِ",14,"ن",1,0],["لَم أَجِد لي مُشبِهاً تَحتَ السَما","في شَقائي لا وَلا فَوقَ الثَرى",15,"ر",2,0],["لم أجد في الوُجُودِ إلاَّ شقاءً","سَرْمَديًّا ولذَّةً مُضْمَحِلَّةْ",16,"ه",1,0],["لمْ أجدْ في الحَيَاةِ لحناً بديعاً","يَسْتَبيني سِوى سَكينَةِ نَفْسي",17,"ي",1,0],["لما جهلت من الحقيقة أمرها","وأقمت نفسك في مقام معلل",18,"ل",1,1],["لما جفاك ابن سينا","وهام بالسيارة",19,"ر",2,0],["لما جريت لغايات الندى وجرى","عجبت كيف حوى البحرين واديها",20,"ي",3,0],["لَم أَجزِها بِشِرَّةٍ","عَن غَضَبٍ وَشِرَّةِ",21,"ه",1,0],["لَمّا جَمَعتَ الشامَ مِن أَطرافِهِ","وافى يُعَزّي الشامَ فيكَ المَشرِقُ",22,"ق",1,0],["لَمّا جَلَستَ سَما وَعَزَّ كَأَنَّما","هارونُ وَاِبناهُ عَلَيهِ قِيامُ",23,"م",1,0],["لَمّا جَرى الإِصلاحُ قُمتَ مُهَنِّئاً","بِاِسمِ الحَنيفَةِ بِالمَزيدِ مُبَشِّرا",24,"ر",2,0],["لَم أُجرِ غايَةَ فِكري مِنكَ في صِفَةٍ","إِلّا وَجَدتُ مَداها غايَةَ الأَبَدِ",25,"د",1,0],["لَم أَجعَلِ الذُلَّ لِباسي لِمَن","تاهَ وَلَم أَفزَع إِلى العُذرِ",26,"ر",1,0],["لَمّا جَنَنتَ اليَومَ مِنها أَعظُماً","يَبرُقنَ بَينَ فُصوصِهِنَّ فِقارُ",27,"ر",1,0],["لَم أَجِدهُ مُؤاتِياً فَتَصَدَّق","تُ بِحَظّي مِنهُ عَلى الشَيطانِ",28,"ن",1,0],["لمّا جَرَتْ فيهِ الصَّبا عَليلةً","رقّ الهواءُ فيهِ للنّفسِ وصَح",29,"ح",1,0],["لم أجدْ للملكِ ماءً صافياً","فتيمَّمْتُ صعيداً طيِّبا",30,"ب",2,0],["لمْ أجمعِ المالَ فَخْراً","ولا لحرصٍ وغَفْلَهْ",31,"ه",1,1],["لَمّا جَرى في الأَرضِ طوفانُ الأَذى","أَجرى بِهِ الدَمَ وَالحَديدَ عُبابا",32,"ب",2,0],["لَم أَجنِ ذَنباً وَلَم آتي لَكُم سَخطاً","فَفيمَ تُحجَبُ عَنّي دُونَكِ الطَرُقُ",33,"ق",1,0],["لَمّا جَفاني الحَبيبُ وَاِمتَنَعَت","عَنّي الرِسالاتُ مِنهُ وَالخَبَرُ",34,"ر",1,1],["لمّا جفلْنَ إلى بلاي عشيَّةً","أقْوتْ معاهدُها منَ الأعلاجِ",35,"ج",1,0],["لم أجنِ وقد جَنيتُ وَرْدَ الخَفَر","إلاّ لترى كيفَ انشقاقُ القَمَرْ",36,"ر",1,0],["لمْ أجمعِ المالَ فخراً","ولا لصيتٍ وشهرَهْ",37,"ه",1,1],["لم أجدْ لي في واحة العيش ظِلاً","أو غديراً يَبُلُّ حَرَّ لهاتي",38,"ي",1,0],["لَمْ أَجْنِ فِي الْحُبِّ ذَنْبَاً أَسْتَحِقُّ بِهِ","عَتْبَاً وَلَكِنَّهَا تَحْرِيفُ أَقْوَالِ",39,"ل",1,0],["لَمْ أَجِدْ مِنْهُما بَدِيلاً لِنَفْسِي","غَيْرَ حُزْنِي عَلَيْهِما وَاكْتِئَابِي",40,"ي",1,0],["لَم أَجِد سَخلَةً وَفي كُلِّ عيدٍ","لَم تعرني مَعَ المباركِ بركُ",41,"ك",1,0],["لم أجنِ في الحُبِّ ذنباً أستحق به","عَتْباً ، ولكنها تحريفُ أقوالي",42,"ل",2,0],["لَم أَجدها مِن بَعد بَعدك إِلّا","ظُلمات مِن الريا وَالنِفاق",43,"ق",1,0],["لما جرى الوصل والايام مسعفة","كانوا وكنا وكانت للزمان يد",44,"د",1,1],["لم أجدْ غيرَ مخلصٍ لكَ وُدّاً","جَوهريّاً يسرني ما قَالا",45,"ل",2,0],["لَمَّا جَنَينَا جَنىَ إجمَاعِهَا ثَمَراً","يُزرِى بِصَافِيةِ الصَّهبَاءِ والصُّبَرِ",46,"ر",1,0],["لَمّا جَعَلتَ صَليلَها عَذلاً لَهُم","إِنَّ المُلامَ بِغَيرِها لا يَنجَعُ",47,"ع",1,0],["لما جئت في معشار عشر حقوقكم","ولو كان ذا شيء يؤدي به شكر",48,"ر",1,0],["لَمْ أَجِدْ مَا بِهِ أَجودُ بِدَمعي","غَيْرَ رُوحي فَجُدْتُ بِالْمَوْجُودِ",49,"د",1,0],["لم أجد في الناس لي سكنا","منصفا في السر والعلن",50,"ن",1,0],["لم أجنِ من غرسي لهُ","غير التنكُّرِ والنفارِ",51,"ر",1,0],["لم أجد في الهوى مُعيناً أميناً","فلذاك استعنتُ بالكتمانِ",52,"ن",1,0],["لم أجعل الفقاع لي حرفة","إلا لمعنى حسنك الشاهد",53,"د",1,1],["لم أجد ما يوجب الشوق إليك","لم أجد ما يوجب العطف عليك",54,"ك",1,0],["لم أجد قبل محنتي فيك ليثا","يأخذ الأمر عن عيون الغزال",55,"ل",1,0],["لم أجد مرأة حميدا جناها","في سبيل الفناء هذه النساء",55,"ا",2,0],["لم أجزلي من التمتع فيها","غير ما جاز وانقضت كالومضه",56,"ض",2,0],["لم أجِد فيكُم فتىً ذا هِمَّةٍ","إن عدا الدَهرُ عدا أَوصالَ صال",57,"ل",1,0],["لَمّا جَفا العِذارُ بِخَدِّهِ","فَتَعَجَّبوا لِسَوادِ وَجهِ الكاذِبِ",58,"ب",1,0],["لَمْ أَجِدْ إِذْ وَرَدْتُهَا سَلْسَبِيلاً","لِمُجَارَاةِ نَظْمِهَا مِنْ سَبِيلِ",59,"ل",1,0],["لم أجد لي فيها صديقاً حميماً","غير أني بالماء فيها حَمِيمُ",60,"م",1,0],["لما جَنَحتَ أمامَ أجنِحةِ الدُّجى","كنّا بلذّاتِ الهوى لاهينا",61,"ن",2,0],["لَمّا جَرَيتُ مَعَ الضِلالِ","غَرِقَت في بَحرِ الشَمَقمَقُ",62,"ق",1,0],["لمّا جَنى الطرفُ وردَ وجنتِهِ","عذَّب قَلبي بنارِ هجرانِ",63,"ن",1,1],["لَمّا جلا ياقوتَ صفحةِ خَدِّه","أَبدى لنا من عارضَيه زُمرُّذا",64,"ذ",2,0],["لمّا جعلتِ وسادةً","عنقي وَمهداً أَذرعي",65,"ي",1,0],["لم أَجدْ صدرَ فتى قد حملا","قبله فيما مضى نهدَيْ كعابِ",66,"ب",1,0],["لَمّا جَرى كَالسَيل سُرعة سَيرِهِ","أَحبابا لا وَالَّذي سوّاكمُ",67,"م",1,0],["لَمّا جَنى نَزل العذار بِخَدّهِ","فَتَعَجّبوا لِسَوادِ وَجهِ الكاذِبِ",68,"ب",1,0],["لِماجِدٍ طارَ فؤادي أَسَفاً","وفَرَحاً من بَعْدِ ذاكَ الأَسَف",69,"ف",1,0],["لم أَجِدْ من بني الزّمانِ نَجيباً","فلَعْمري قد كِدْتُ أُوهَمُ أَمرا",70,"ر",2,0],["لمّا جلا لي عند تَوديعِه","رِياضَ حُسْنٍ لم تكُنْ لي تُباح",71,"ح",1,0],["لم أجعَلِ الأحبابَ فيكَ أعادياً","حتى تكونَ لكُلِّهم بِي مُشمِتا",72,"ت",2,0],["لمَّا جَمَعتُ المادِحِي","نَ عَليكَ مِن غَربٍ وشَرقِ",73,"ق",1,0],["لم أجتَنبها قادِراً","إلا مَخافَةَ قادِرِ",74,"ر",1,0],["لم أجد في البعد والقرب دواء","أصبح النسيان من مثلي محالا",75,"ل",2,0],["لمَّا جرى بكَ في يدي قلمي","شَدَتِ الحروفُ، وغرَّدَ الحِبْرُ",76,"ر",1,0],["لم أجْرِ في مَدْحِيكَ طِرفَ عبارةٍ","إلاّ كبا مِن عَجزه وتَقَطّرا",77,"ر",2,0],["لم أجد فيك التفاتات إلى","كبدٍ حرَّى ولا دمعٍ مذال",78,"ل",1,0],["لم أجد في الشام من يرجي له","جود كفّ لفتيل أو نقير",79,"ر",1,0],["لما جلا التوديعُ صفحتَهُ","عن وقفةٍ زفراتُها تَغلي",80,"ل",2,0],["لمّا جرى والناسَ في","شوط العلا ففضَلا",81,"ل",2,0],["لم أجد مذ شطّت الدارُ بكم","نشطةً تُفلت جنبي من عِقالي",82,"ي",1,0],["لم أجزِهِ إذ بات يُس","مِنُ لي الحظوظَ وأَعرُقُهْ",83,"ق",2,0],["لما جلستَ وقامَ ينشرُ باعَه","جهدَ التطاولِ لم يجِدْ لك أَخْمَصا",84,"ص",2,0],["لم أجن رغم رهين المحيين على","من كان بي موجدا في أمة العرب",85,"ب",1,0],["لما جن ليل الهجر إذ عسعس النوى","وعرس جند الوهم في غصص الفكر",86,"ر",1,0],["لم اجتذب آها ولم اسكن ولم","يك طوركم متمكناً في بالي",87,"ي",1,0],["لما جلبت إليه الخيل مقربة","لم يحمه منك إلا الشحط والهرب",88,"ب",1,0],["لما جذبتم بخزام أنفه","أذعن بالرغم إلى انقياد",89,"د",1,0],["لم أجالس قط إلا ملكاً","رافعاً لي عن مقام المنشد",90,"د",1,0],["لما جفت أوطاننا سرنا وهل","يجري علينا وطن بلا وطر",91,"ر",1,0],["لم أَجتَرِئ ولم أكُن","لَكَ بِهذا مُعلِنَا",92,"ن",2,0],["لم أجدْ مسعداً عليه ومن ذا","مسعدٌ في الورى الحُسامَ الخَذوما",93,"م",2,0],["لم أجد مثل حسنها","قط أبهى وأبهجا",94,"ج",2,0],["لَمَّا جَلَا الحُسْنَ حَلَا","مِرْشَفُهُ وَلَفْظُهُ",95,"ظ",2,0],["لَمْ أَجْنِ ذَنْباً مُذْ عَرفْتُ هَواكُمُ","فَعلامَ كَاساتِ الصُّدودِ أُذَاقُ",96,"ق",1,0]]}