0.html","الكامل"],[97,"قضيت العمر تذكر لي","https://www.aldiwan.net/poem24803.html","مجزوء الوافر"],[80,"إذا البدر يطوى في ربوع البلى لحدا","https://www.aldiwan.net/poem31479.html","الطويل"],[80,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[44,"خذي عبرات عينك عن زماعي","https://www.aldiwan.net/poem30464.html","الوافر"],[44,"شهدت لقد أقوت مغانيكم بعدي","https://www.aldiwan.net/poem30537.html","الطويل"],[31,"تقول وليدتي لما رأتني","https://www.aldiwan.net/poem41270.html","الوافر"],[31,"وخل كنت عين النصح منه","https://www.aldiwan.net/poem42231.html","الوافر"],[31,"فلا وأبيك ما صوت الغواني","https://www.aldiwan.net/poem42472.html","الوافر"],[33,"أيا شبه ليلى لا تراعي فإنني","https://www.aldiwan.net/poem25862.html","الطويل"],[33,"أجد بأحياء الجميع بكور","https://www.aldiwan.net/poem25929.html","الطويل"],[105,"أصد بوجهي عن كثيرين إنني","https://www.aldiwan.net/poem43371.html","الطويل"],[105,"إن جل غنم المسلمين بخيبر","https://www.aldiwan.net/poem44059.html","الكامل"],[105,"أجيبي أم كلثوم أجيبي","https://www.aldiwan.net/poem44064.html","الوافر"],[105,"بني لحيان لوذوا بالجبال","https://www.aldiwan.net/poem44068.html","الوافر"],[105,"هذا إمام الدين في أعلامه","https://www.aldiwan.net/poem44206.html","الكامل"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[22,"أرسم ديار من حنيدة تعرف","https://www.aldiwan.net/poem22022.html","الطويل"],[52,"أردت الشرب في القمر","https://www.aldiwan.net/poem27001.html","مجزوء الوافر"],[52,"أرد الطرف من حذري عليه","https://www.aldiwan.net/poem27128.html","الوافر"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[48,"يا من تمره عمدا","https://www.aldiwan.net/poem65012.html","المجتث"],[48,"اردد علي المدام بالجام","https://www.aldiwan.net/poem65086.html","المنسرح"],[46,"أردت إهانتي فحماك مني","https://www.aldiwan.net/poem22758.html","الوافر"],[46,"تماطل أمرا دونه أبعد النوى","https://www.aldiwan.net/poem22767.html","الطويل"],[46,"فؤادك خفاق وبرقك خافق","https://www.aldiwan.net/poem23013.html","الطويل"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85649","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85641","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85422","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85374","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85480","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39657","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39566","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16681","السريع"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10689","الطويل"],[77,"أرد ما كان وارض بما قضاه","https://www.poetsgate.com/ViewPoem.aspx?id=33904",""],[90,"يوم الجيش الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179194",""],[45,"كم ليلة ذات أجراس وأروقة","https://www.poetsgate.com/ViewPoem.aspx?id=32946",""],[33,"أجد بأحياء الجميع بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14105&r=&rc=41",""]],"verses":[["أَرَدتِ أَن تَحجُبَ البَيداءُ طَلعَتَهُ","أَلَم يَكُن قَبلُ مَحجوباً عَنِ المُقَلِ",0,"ل",1,0],["أَرِدني مُراداً يَقعُدُ الناسُ دونَهُ","وَيَغبِطُني عَمٌّ عَلَيهِ وَخالُ",1,"ل",1,0],["أَرَدتَ وِقاءَ الرِجلِ وَالنَعلُ عَقرَبٌ","مُراصِدَةٌ وَالأَفعُوانُ شِراكُ",2,"ك",1,0],["أَرُدُّ الشَجا قَبلَ الزَفيرِ تَجَلُّداً","وَأَغلِبُ دَمعي قَبلَ بَلِّ الحَمالِقِ",3,"ق",1,0],["أَرُدَّ عَلى قَومي فُضولَ تَغَمُّدي","وَإِنّي عَلى ما سَاءَ قَومي لَقادِرُ",4,"ر",1,0],["أَرُدُّ نَبلَ الأَداني ما رُميتُ بِها","فَهَل إِلى الرَحِمِ البَلهاءِ لي عُذُرُ",5,"ر",1,0],["أَرُدُّ النَوائِبَ بِالموسَوِيِّ","وَأُعطي الرَغائِبَ بِالناصِرِي",6,"ر",2,0],["أَرُدُّ بِهِ أَيدي الأَعادي وَأَتَّقي","نَوافِذَ شَتّى مِن أَذىً وَبَلاءِ",7,"ا",2,0],["أرُدُّ عَذولي وهْوَ يَمْحَضُني الهَوى","بغَيْظٍ ويَحْظى بالقُبولِ عَذولُها",8,"ل",3,0],["أردِّدُ الظّنَّ بينَ اليأسِ والأملِ","وأعْذِرُ الحبَّ يُفْضي بي إِلى العَذَلِ",9,"ل",1,1],["أُردُد رُقادي ثُمَّ نَم في غِبطَةٍ","إِنّي اُمرُؤٌ سَهَري لِنَومِكَ حاسِدُ",10,"د",1,0],["أَرَدنا رِضاكِ بِإِسخاطِها","وَبُخلُكِ مِن بَذلِها أَطيَبُ",11,"ب",1,0],["أرَدْنا بكَ العُذْرَ الذي أنتَ أهْلُهُ","ومثْلُكَ لا يُرْمى بعِيٍّ ولا حَصَرْ",12,"ر",1,0],["أرِدْ ما كانَ وارْضَ بما قَضاهُ","إلاهُكَ هَذهِ خُلْقُ المُريدِ",13,"د",1,1],["أَرَدْتَ فِي الزَّهْرِ بِكْراً","فَتَّانَةً خَلاَّبَهْ",14,"ب",2,0],["أَرْدَوْا عَسَاكِرَنَا أَخْلَوْا دَسَاكِرَنَا","هَدُّوا مَنَائِرَنَا طَاغِينَ بَاغِينَا",15,"ن",2,0],["أُرْدُدْ إِلَى هَذَا الحِمَى اسْتِقْلالَهُ","يَخْلُصْ طَعَامُكَ يَا أَمِيرُ مِنَ الدَّمِ",16,"م",1,0],["أردّد بين البدر والبحر ناظري","قيصعد طرفي مرة ويصوب",17,"ب",1,0],["أَرَدنا غَداةَ الغِبِّ أَلّا تَلومَنا","تَميمٌ وَحاذَرنا حَديثَ المَواسِمِ",18,"م",1,0],["أَرداكَ حَينُكَ يا فَرَزدَقُ مُحلِباً","ما زادَ قَومَكَ ذاكَ غَيرَ خَبالِ",19,"ل",1,0],["أَرداهُمُ حَمزَةُ في أُسرَةٍ","يَمشونَ تَحتَ الحَلَقِ الذائِلِ",20,"ل",1,0],["أَرَدتَ مِنّي اِختِبارَ سِرّي","وَقَد عَلِمتُ المُرادَ مِنّي",21,"ن",2,0],["أردتِ فنلتِ ما أمَّلتِ","مَن عِزّي ومن مجدي",22,"ي",1,0],["اُرْدُدْ عليَّ قراطيسي ممزقّةً","كيما تكونَ رُؤوساً للدَّساتيجِ",23,"ج",1,1],["أردى كُليباً لجسّاسٍ وكان له","ربّاً وأعدى على بسطام شرخافا",24,"ف",2,0],["أرِدني لذاك الطَّولِ لا لي فإنه","عظيمٌ وزِنْ حمدي وإنْ خَفَّ مثقالي",25,"ل",2,0],["أَرَدتَ تَغييرَ خُلقي","أُفٍّ لِما سُمتَنيهِ",26,"ي",2,0],["أُرَدِّدُ فيكَ طولَ اللَيلِ فِكري","فَأَبني ثُمَّ أَهدِمُ ثُمَّ أَبني",27,"ن",2,0],["أَرَدتُ أَن أُحضِرَها","عَلى سَبيلِ البَرَكَه",28,"ك",2,0],["أُرِدُّ بِرَدِّ البابِ إِن جِئتُ زائِراً","فَيا لَيتَ شِعري أَينَ أَهلٌ وَمَرحَبُ",29,"ب",1,0],["اردتك خلواً من عيوب زرية","فانك عندي ذلك الجوهر الغالي",30,"ي",1,0],["أرد الكوثر إلا أنني","لا أرى الكوثر منه أعذبا",31,"ب",2,0],["أَرَدتُ جِوارَ اللَهِ وَالعُمرُ مُنقَضٍ","وَجاوَرتُهُ في العُمرِ وَهوَ نَضيرُ",32,"ر",1,0],["أُرَدِّدُ وَيلي لَو قَضى الوَيلُ حاجَةً","وَأُكثِرُ لَهفي لَو شَفى غُلَّةً لَهفُ",33,"ف",1,0],["أَرِد لي جَميلاً جُدتَ أَو لَم تَجُد بِهِ","فَإِنَّكَ ما أَحبَبتَ فيَّ أَتاني",34,"ن",2,0],["أُردُد عَلَينا الَّذي اِستَعَرتَ وَقُل","قَولُكَ يُعرَف لِغالِبٍ غَلَبُه",35,"ب",2,0],["أَرَدنا رِضاكُم بِإِسخاطِها","وَبُخلُكَ مِن جودِها أَطيَبُ",36,"ب",1,0],["أَرِدَ البَحرَ لا الثِمادَ فَمِثلي","لا يُرَوّيهِ جَدوَلٌ وَقَليبُ",37,"ب",1,0],["أَرَدتُ غِرَّتَهُ وَالسُكرُ يوهِمُهُ","أَن قَد نَجا وَهوَ مِنّي غَيرُ ما ناجِ",38,"ج",1,0],["أُرَدِّدُ لَيتَ شِعري ما دَهاني","لَدَيكَ لَوِ اِنتَفَعتُ بِلَيتَ شِعري",39,"ي",1,0],["أَرُدُّ دونَكَ يَقظاناً وَيَأذَنُ لي","عَلَيكِ سُكرُ الكَرى إِن جِئتُ وَسنانا",40,"ن",2,0],["أَردَت أَغَرَّ مِنَ المُلوكِ مُتَوَّجاً","وَرِثَ النُبُوَّةَ بَدرَها وَهِلالَها",41,"ل",3,0],["أَرداكَ حَينُكَ إِذ تُعارِضُ دارِماً","بِأَدِقَّةٍ مُتَأَشِّبينَ لِئامِ",42,"م",1,0],["أرُدُّ كؤوسَها بِيضاً خِفاقاً","وقد صافحْتُها حُمراً ثِقالا",43,"ل",2,0],["أُرَدِّدُ لَحْظَ العَيْنِ بينَ شَمامسٍ","مُصَوَّرَةٍ في كأسِها وأساقفِ",44,"ف",1,0],["أردَى مَقاوِلَ تُبَّعٍ","وسَطَا على أحرارِ فارسْ",45,"س",1,0],["اِردُد يَساراً وَلا تَعنُف عَلَيهِ وَلا","تَمعَك بِعِرضِكَ إِنَّ الغادِرَ المَعِكُ",46,"ك",1,0],["أَرَدتُ بِهِ نَصرَ الإِلَهِ تَبَتُّلاً","وَأَضمَرتُهُ حَتّى أَوَسَّدَ في قَبري",47,"ي",1,0],["أَردَيتُ عَمراً إِذ طَغى بِمُهَنَّدٍ","صافي الحَديدِ مُجَرَّبٍ قَصّابِ",48,"ب",1,0],["أردنا الجاه والذهبا","فلم يتلطَّف المولى",49,"ل",2,0],["أَرَدنا لَكَ الدُّنيا القَليلَ بَقاؤُها","وربّكَ في الأخرى أرادَ لك الخلدا",50,"د",2,0],["أردتُ به صَيْدَ الخيالِ ففاتَني","كما فرّ عن وَصْلِ المُتيَّمِ ذو صَدِّ",51,"د",1,0],["أَردى كُلَيباً وَهَمّاماً وَهاجَ بِهِ","يَومُ الذَنائِبِ وَالتَحلاقِ لِلِمَمِ",52,"م",1,0],["أَرَدتِ بِحَيثُ لا تُعصى المَعالي","بِأَن يُعصى النَدى وَبِأَن تُطاعي",53,"ع",2,0],["أَرُدُّ يَدي عَن عِرضِ حُرٍّ وَمَنطِقي","وَأَملَأُها مِن لِبدَةِ الأَسَدِ الوَردِ",54,"د",1,0],["أَرَدتُ فِراقَها وَصَبَرتُ عَنها","وَلَو جُنَّ الفُؤادُ بِها جُنونا",55,"ن",2,0],["أَرَدتُ رَشادَهُ جَهدي فَلَمّا","أَبى وَعَصى أَتيَناها جَميعا",56,"ع",2,0],["أَرَدتُ بِرِحلَتي وَأُريدُ حَظّاً","وَلا أَكلَ الدَجاجِ وَلا الخَبيصِ",57,"ص",1,0],["أَرُدُّ سَواءَ الطَرفِ عَنكِ وَما لَهُ","عَلى أَحَدٍ إِلّا عَلَيكِ طَريقُ",58,"ق",1,0],["أَرَدنَ بَلائي ما قَضَينَ لُبانَةً","فَقَد غارَ أَو كادَ النُجومُ تَعورُ",59,"ر",1,0],["أَرَدتُ لَها عِزَّ الحَياةِ فَأَعرَضَت","تُريدُ حَياةً ما يُفارِقُها الذُلُّ",60,"ل",1,0],["أردَى أباكِ وهَدَّ زوجَكِ بأسُهُ","وأصابَ قومَكِ منه موتٌ أحمرُ",61,"ر",1,0],["أردتِ الدِّينَ مَعمورَ النَّواحِي","فَخُوضِي البِيدَ مُقْفِرَةً وَجُوبي",62,"ب",2,0],["أردتُمْ بَيعَهُ لِيُنالَ وِترٌ","رُوَيْداً إنّ صاحبَكم لَغَالِ",63,"ل",1,0],["أرداه بابنِ الصِّمَّةِ البطلِ الذي","أعيا الرَّدى المحتالَ فضُّ صِمامِهِ",64,"م",2,0],["أرداهُ حَمزةُ عِندَ حوضِ محمّدٍ","فانظر أتُقْدِمُ أم تَحيِدُ وَتَكفَحُ",65,"ح",1,0],["أَرُدُّ المَخاضَ البُزلَ وَالشَمسُ حَيَّةٌ","إِلى الحَيِّ حَتّى يوسَعَ المُتَضَيِّفُ",66,"ف",1,0],["أَرَدتُ الشُربَ في القَمَرِ","وَقَطعَ اللَيلِ بِالسَهَرِ",67,"ر",1,1],["أَرُدُّ الطَرفَ مِن حَذَري عَلَيهِ","وَأَمنَحُهُ التَجَنُّبَ وَالصُدودا",68,"د",2,1],["أرْدَتْ سُيوفُك جيلا من فراعنة","لم يفتأوا لقديم الدهر كالجبل",69,"ل",1,0],["أَرَدتَ أَن تَزدَريكَ ال","عُيونُ هَيهاتَ كَلّا",70,"ل",2,0],["اِردُد عَلَيَّ المُدامَ بِالجامِ","وَسَقِّنيها بِرَغمِ لُوّامي",71,"م",2,1],["أَرَدتَ إِهانَتي فَحَماكَ مِنّي","قَضاءٌ فِيَّ كانَ لَهُ نَجوزُ",72,"ز",1,1],["أَرَدتَ إِلى أَرضِ الحِجازِ تَحَمُّلاً","فَعاقَتكَ عَنهُ عائِقاتُ الحَواجِزِ",73,"ز",1,0],["أَردَت رَفيقاً كَي يَنالَكَ رِفقُهُ","فَدَعهُ إِذا لَم تَأتِ مِنهُ المَرافِقُ",74,"ق",1,0],["أرَدنا أن نَصِيدَ به مَهاةً","فقَطَّعَتِ الحبَائِلَ والحِبالا",75,"ل",2,0],["أَردت اغتيالا لِلَّذي لم تكن رأت","له مصر إلا أَن يرى فوزها إربا",76,"ب",2,0],["أَردتَ لهم خيراً فجازوك بالشر","كَذاك يجازَى الخير في غالب الأمر",77,"ر",1,1],["أَرَدت أَن أكلم ال","بعض فَلَم أستطع",78,"ع",1,0],["أرد النَمير وبعد ما","أَروي غَليلي أَصدر",79,"ر",1,0],["أَردت صيالي فاِحتمل وقع ركلتي","وإنك أَنت البادئ المتعرض",80,"ض",1,0],["أردّ الحقوق لأربابها","وأعفاهمو من طلابٍ سؤالا",81,"ل",2,0],["أردِّدُ فيها للطفولة والصِّبا","أحاديثَ شتَّى كلهن طرائفُ",82,"ف",1,0],["أرْدانُها أمْنٌ غَداةَ الوَغَى","للكَفِّ والسّاعِدِ والمِعْصَم",83,"م",1,0],["أُردِدُ عَنكِ النَفسَ وَالنَفسُ صَبَّةٌ","بِذِكرِكَ وَالمَمشى إِلَيكِ قَريبُ",84,"ب",1,0],["أرد ما كان وارض بما قضاه","إلاهك هذ خلق المريد",85,"د",1,1],["أرد خطةً تَقْدِرْ وتَنْجَحْ فاننا","عَرَفْناك تُمضي ما تُريد وتَقْدِر",86,"ر",1,0],["أردت غرته والسكر يوهمه","أن قد نجا وهو مني غير ما تاج",87,"ج",1,0],["أ ردن بلائي ما قضين لبانة","فَقَدْ غَارَ أوْ كَادَ النُّجُوم تَغُور",88,"ر",1,0]]}