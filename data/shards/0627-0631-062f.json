انا بالثوية راجع","https://www.aldiwan.net/poem47727.html","الطويل"],[554,"أهل الصفاء نأيتم بعد قربكم","https://www.aldiwan.net/poem68285.html","البسيط"],[554,"طيف الخيال حمدنا منك إلماما","https://www.aldiwan.net/poem68427.html","البسيط"],[559,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[559,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[563,"مضى زمن الصبى فدع التصابي","https://www.aldiwan.net/poem52876.html","البسيط"],[563,"يا أيها القلب الخفوق بجانبي","https://www.aldiwan.net/poem52943.html","الكامل"],[564,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[576,"كجسمك جسمي أصبح اليوم بالياً","https://www.aldiwan.net/poem2768.html","الطويل"],[576,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"]],"verses":[["أَرَدتِ أَن تَحجُبَ البَيداءُ طَلعَتَهُ","أَلَم يَكُن قَبلُ مَحجوباً عَنِ المُقَلِ",0,"ل",1,0],["أَرِدني مُراداً يَقعُدُ الناسُ دونَهُ","وَيَغبِطُني عَمٌّ عَلَيهِ وَخالُ",1,"ل",1,0],["أَرَدتَ وِقاءَ الرِجلِ وَالنَعلُ عَقرَبٌ","مُراصِدَةٌ وَالأَفعُوانُ شِراكُ",2,"ك",1,0],["أَرُدُّ الشَجا قَبلَ الزَفيرِ تَجَلُّداً","وَأَغلِبُ دَمعي قَبلَ بَلِّ الحَمالِقِ",3,"ق",1,0],["أَرُدَّ عَلى قَومي فُضولَ تَغَمُّدي","وَإِنّي عَلى ما سَاءَ قَومي لَقادِرُ",4,"ر",1,0],["أَرُدُّ نَبلَ الأَداني ما رُميتُ بِها","فَهَل إِلى الرَحِمِ البَلهاءِ لي عُذُرُ",5,"ر",1,0],["أَرُدُّ النَوائِبَ بِالموسَوِيِّ","وَأُعطي الرَغائِبَ بِالناصِرِي",6,"ر",2,0],["أَرُدُّ بِهِ أَيدي الأَعادي وَأَتَّقي","نَوافِذَ شَتّى مِن أَذىً وَبَلاءِ",7,"ا",2,0],["أرُدُّ عَذولي وهْوَ يَمْحَضُني الهَوى","بغَيْظٍ ويَحْظى بالقُبولِ عَذولُها",8,"ل",3,0],["أردِّدُ الظّنَّ بينَ اليأسِ والأملِ","وأعْذِرُ الحبَّ يُفْضي بي إِلى العَذَلِ",9,"ل",1,1],["أُردُد رُقادي ثُمَّ نَم في غِبطَةٍ","إِنّي اُمرُؤٌ سَهَري لِنَومِكَ حاسِدُ",10,"د",1,0],["أَرَدنا رِضاكِ بِإِسخاطِها","وَبُخلُكِ مِن بَذلِها أَطيَبُ",11,"ب",1,0],["أرَدْنا بكَ العُذْرَ الذي أنتَ أهْلُهُ","ومثْلُكَ لا يُرْمى بعِيٍّ ولا حَصَرْ",12,"ر",1,0],["أرِدْ ما كانَ وارْضَ بما قَضاهُ","إلاهُكَ هَذهِ خُلْقُ المُريدِ",13,"د",1,1],["أَرَدْتَ فِي الزَّهْرِ بِكْراً","فَتَّانَةً خَلاَّبَهْ",14,"ب",2,0],["أَرْدَوْا عَسَاكِرَنَا أَخْلَوْا دَسَاكِرَنَا","هَدُّوا مَنَائِرَنَا طَاغِينَ بَاغِينَا",15,"ن",2,0],["أُرْدُدْ إِلَى هَذَا الحِمَى اسْتِقْلالَهُ","يَخْلُصْ طَعَامُكَ يَا أَمِيرُ مِنَ الدَّمِ",16,"م",1,0],["أردّد بين البدر والبحر ناظري","قيصعد طرفي مرة ويصوب",17,"ب",1,0],["أَرَدنا غَداةَ الغِبِّ أَلّا تَلومَنا","تَميمٌ وَحاذَرنا حَديثَ المَواسِمِ",18,"م",1,0],["أَرداكَ حَينُكَ يا فَرَزدَقُ مُحلِباً","ما زادَ قَومَكَ ذاكَ غَيرَ خَبالِ",19,"ل",1,0],["أَرداهُمُ حَمزَةُ في أُسرَةٍ","يَمشونَ تَحتَ الحَلَقِ الذائِلِ",20,"ل",1,0],["أَرَدتَ مِنّي اِختِبارَ سِرّي","وَقَد عَلِمتُ المُرادَ مِنّي",21,"ن",2,0],["أردتِ فنلتِ ما أمَّلتِ","مَن عِزّي ومن مجدي",22,"د",2,0],["اُرْدُدْ عليَّ قراطيسي ممزقّةً","كيما تكونَ رُؤوساً للدَّساتيجِ",23,"ج",1,1],["أردى كُليباً لجسّاسٍ وكان له","ربّاً وأعدى على بسطام شرخافا",24,"ف",2,0],["أرِدني لذاك الطَّولِ لا لي فإنه","عظيمٌ وزِنْ حمدي وإنْ خَفَّ مثقالي",25,"ل",2,0],["أَرَدتَ تَغييرَ خُلقي","أُفٍّ لِما سُمتَنيهِ",26,"ي",2,0],["أُرَدِّدُ فيكَ طولَ اللَيلِ فِكري","فَأَبني ثُمَّ أَهدِمُ ثُمَّ أَبني",27,"ن",2,0],["أَرَدتُ أَن أُحضِرَها","عَلى سَبيلِ البَرَكَه",28,"ك",2,0],["أُرِدُّ بِرَدِّ البابِ إِن جِئتُ زائِراً","فَيا لَيتَ شِعري أَينَ أَهلٌ وَمَرحَبُ",29,"ب",1,0],["اردتك خلواً من عيوب زرية","فانك عندي ذلك الجوهر الغالي",30,"ل",2,0],["أرد الكوثر إلا أنني","لا أرى الكوثر منه أعذبا",31,"ب",2,0],["أَرَدتُ جِوارَ اللَهِ وَالعُمرُ مُنقَضٍ","وَجاوَرتُهُ في العُمرِ وَهوَ نَضيرُ",32,"ر",1,0],["أُرَدِّدُ وَيلي لَو قَضى الوَيلُ حاجَةً","وَأُكثِرُ لَهفي لَو شَفى غُلَّةً لَهفُ",33,"ف",1,0],["أَرِد لي جَميلاً جُدتَ أَو لَم تَجُد بِهِ","فَإِنَّكَ ما أَحبَبتَ فيَّ أَتاني",34,"ن",2,0],["أُردُد عَلَينا الَّذي اِستَعَرتَ وَقُل","قَولُكَ يُعرَف لِغالِبٍ غَلَبُه",35,"ب",2,0],["أَرَدنا رِضاكُم بِإِسخاطِها","وَبُخلُكَ مِن جودِها أَطيَبُ",36,"ب",1,0],["أَرِدَ البَحرَ لا الثِمادَ فَمِثلي","لا يُرَوّيهِ جَدوَلٌ وَقَليبُ",37,"ب",1,0],["أَرَدتُ غِرَّتَهُ وَالسُكرُ يوهِمُهُ","أَن قَد نَجا وَهوَ مِنّي غَيرُ ما ناجِ",38,"ج",1,0],["أُرَدِّدُ لَيتَ شِعري ما دَهاني","لَدَيكَ لَوِ اِنتَفَعتُ بِلَيتَ شِعري",39,"ر",2,0],["أَرُدُّ دونَكَ يَقظاناً وَيَأذَنُ لي","عَلَيكِ سُكرُ الكَرى إِن جِئتُ وَسنانا",40,"ن",2,0],["أَردَت أَغَرَّ مِنَ المُلوكِ مُتَوَّجاً","وَرِثَ النُبُوَّةَ بَدرَها وَهِلالَها",41,"ل",3,0],["أَرداكَ حَينُكَ إِذ تُعارِضُ دارِماً","بِأَدِقَّةٍ مُتَأَشِّبينَ لِئامِ",42,"م",1,0],["أرُدُّ كؤوسَها بِيضاً خِفاقاً","وقد صافحْتُها حُمراً ثِقالا",43,"ل",2,0],["أُرَدِّدُ لَحْظَ العَيْنِ بينَ شَمامسٍ","مُصَوَّرَةٍ في كأسِها وأساقفِ",44,"ف",1,0],["أردَى مَقاوِلَ تُبَّعٍ","وسَطَا على أحرارِ فارسْ",45,"س",1,0],["اِردُد يَساراً وَلا تَعنُف عَلَيهِ وَلا","تَمعَك بِعِرضِكَ إِنَّ الغادِرَ المَعِكُ",46,"ك",1,0],["أَرَدتُ بِهِ نَصرَ الإِلَهِ تَبَتُّلاً","وَأَضمَرتُهُ حَتّى أَوَسَّدَ في قَبري",47,"ر",2,0],["أَردَيتُ عَمراً إِذ طَغى بِمُهَنَّدٍ","صافي الحَديدِ مُجَرَّبٍ قَصّابِ",48,"ب",1,0],["أردنا الجاه والذهبا","فلم يتلطَّف المولى",49,"ل",2,0],["أَرَدنا لَكَ الدُّنيا القَليلَ بَقاؤُها","وربّكَ في الأخرى أرادَ لك الخلدا",50,"د",2,0],["أردتُ به صَيْدَ الخيالِ ففاتَني","كما فرّ عن وَصْلِ المُتيَّمِ ذو صَدِّ",51,"د",1,0],["أَردى كُلَيباً وَهَمّاماً وَهاجَ بِهِ","يَومُ الذَنائِبِ وَالتَحلاقِ لِلِمَمِ",52,"م",1,0],["أَرَدتِ بِحَيثُ لا تُعصى المَعالي","بِأَن يُعصى النَدى وَبِأَن تُطاعي",53,"ع",2,0],["أَرُدُّ يَدي عَن عِرضِ حُرٍّ وَمَنطِقي","وَأَملَأُها مِن لِبدَةِ الأَسَدِ الوَردِ",54,"د",1,0],["أَرَدتُ فِراقَها وَصَبَرتُ عَنها","وَلَو جُنَّ الفُؤادُ بِها جُنونا",55,"ن",2,0],["أَرَدتُ رَشادَهُ جَهدي فَلَمّا","أَبى وَعَصى أَتيَناها جَميعا",56,"ع",2,0],["أَرَدتُ بِرِحلَتي وَأُريدُ حَظّاً","وَلا أَكلَ الدَجاجِ وَلا الخَبيصِ",57,"ص",1,0],["أَرُدُّ سَواءَ الطَرفِ عَنكِ وَما لَهُ","عَلى أَحَدٍ إِلّا عَلَيكِ طَريقُ",58,"ق",1,0],["أَرَدنَ بَلائي ما قَضَينَ لُبانَةً","فَقَد غارَ أَو كادَ النُجومُ تَعورُ",59,"ر",1,0],["أَرَدتُ لَها عِزَّ الحَياةِ فَأَعرَضَت","تُريدُ حَياةً ما يُفارِقُها الذُلُّ",60,"ل",1,0],["أردَى 