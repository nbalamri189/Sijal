,1],["قالَ لي ما تَقولُ قُلْتُ مُجيباً","لمْ نَخَفْ منْ نكالِهِ أوْ لحَبْسِهْ",5,"س",2,0],["قالَ لي اعتَلَّ مَن هَويتَ حَسودٌ","قُلتُ أَنتَ العَليلُ وَيحَكَ لا هو",6,"و",1,1],["قال لي فيه البرد يخدر","يحتج الإنسان لمجمر",7,"ر",1,0],["قال للباسم البروق نداها","طرقُ الجد غير طرْقِ المزاح",8,"ح",1,0],["قال لي إذا رأى انكساري حبيبي","ما الذي قد دعا لهذي العياده",9,"ه",1,1],["قالَ لي القلبُ عد لمالكنا","فإنه جابرٌ لما كسرا",10,"ر",2,1],["قال لي جفنه استعدّ لحربي","قلت يا خدّهُ دمي في ثيابك",11,"ك",1,0],["قالَ لي الصّحب ما نباتك يا","منتسباً قلت لا تغمُّوني",12,"ي",1,1],["قال لي خلِّي تزوَّج تسترح","من أذى الفقر وتستغني يقينا",13,"ن",2,1],["قال لهُ الشرع امْض ما تحاوله","وأقْض قضاء لا يردّ قائله",14,"ه",1,0],["قال لمَّا اشترى غلاماً كفاهُ","كثرةَ الغُرم واكتراءَ الرجالِ",15,"ل",1,0],["قالَ لِلجُمهورِ ماذا الاِجتِماع","أُخرُجوا أَو زِدتُموهُ خَطَرا",16,"ر",2,0],["قالَ لَو كُنتُ رَفيقَ البَدرِ","أَو بَدرَ السَماء أَو خَيالَه",17,"ه",1,0],["قالَ لا شَوقَ لا صَبابَةَ لَولا","ها فَتَمتَمتُ قائِلاً لَولاها",18,"ا",3,0],["قالَ لي العاذِلُ تَسلو","قُلتُ لِلعاذِلِ تَتعَب",19,"ب",1,1],["قال له القرد طلبت المملكة","تكون لي وحدى بغير شركة",20,"ه",1,0],["قالَ لِلثَعلَبِ يا ذا الاِحتِيال","رَأسُكَ المَحبوبُ أَو ذاكَ الغَزال",21,"ل",1,0],["قال لي : مبسمي وريقة توت","ولقد قال إن صدري ثروة",22,"و",2,0],["قال لي ليسَ إلى ما","رامَه الدَّهرَ سَبيلُ",23,"ل",1,0],["قالَ لي أَحمَدٌ وَلَم يَدرِ ما بي","أَتُحِبُّ الغَداةَ عُتبَةَ حَقّا",24,"ق",2,1],["قالَ لَنا الديكُ حينَ صَوَّت","وَالجَفنُ بِالغُمضِ قَد تَفَوَّت",25,"ت",1,1],["قالَ لي مازِحاً وَقَد طَغَتِ الرا","حُ وَجالَ التَضريجُ في الوَجنَتَينِ",26,"ن",1,0],["قالَ لي السودُ لِلأَسودِ وَذي البي","ضِ لِمَن يَبتَغي بَياضَ اللُجَينِ",26,"ن",1,0],["قالَ لي في العَتبِ وَال","لَيلُ هادي",27,"ي",1,0],["قال لي القلبُ أحقّاً ما بلغنا","كيف نام القَدرُ السَّاهر عنَّا",28,"ن",2,0],["قالَ لي الناصِحونَ وَهوَ مَقالٌ","ذَمَّ مَن كانَ خامِلاً إِطراءُ",29,"ا",2,0],["قالَ لها الشيخُ واصليني","قالتْ أقلني الوصال للهْ",30,"ه",1,1],["قال لا تخفْ واغتبْ","إنَّ حزماتي كبيرهْ",31,"ه",1,0],["قالَ لي أكتبُ ثلثاً","قلتُ والثلثُ كثيرْ",32,"ر",1,0],["قالَ لسانُ الحالِ مِنْ ريقِهِ","اليومَ خمرٌ وغداً أمرُ",33,"ر",1,0],["قالَ لي عاذلي أتسبيكَ عينٌ","منهُ سوداءُ قلتُ بلْ إنسانُ",34,"ن",1,1],["قال لي فاسألْهُ فقلْتُ اسْلُ عَذْلي","قالَ لي هِنْتَ قلتُ هانَ الهوانُ",34,"ن",1,0],["قالَ لحملِ الدواةِ قلتُ له","ما ذاكَ إلا ليحملَ القلما",35,"م",2,0],["قالَ لنا الوردُ وقدْ","أبطأَ عاماً كمُلا",36,"ل",2,1],["قالَ لي معشوقُ قلبي","أيها الصبُّ النحيلُ",37,"ل",1,1],["قالَ لي فيها عَتيقٌ مَقالاً","فَجَرَت مِمّا يَقولُ الدُموعُ",38,"ع",1,0],["قالَ لي وَدَّع سُلَيمى وَدَعها","فَأَجابَ القَلبُ لا أَستَطيعُ",38,"ع",1,0],["قالَ لَم أَعرِف وَقَد أَب","صَرتُ عيساً وَقُطوعا",39,"ع",2,0],["قالَ لي اِنظُر وَلَيتَني لَم أُطِعهُ","وَبَلى لَستُ سابِقاً مِقداري",40,"ي",1,0],["قالَ لي صاحِبي لِيَعلَمَ ما بي","أَتُحِبُّ القَتولَ أُختَ الرَبابِ",41,"ب",1,1],["قال لا تكذبوا عليه وتُوبوا","وَاتْبَعوا الحقَّ مِلَّةً وَاعْتِقادا",42,"د",2,0],["قال لا بد من دمٍ لك نعطي","هِ نقياً ملء العروق عنيفا",43,"ف",2,0],["قال لِلْكُفَّارِ إذْ أَفْحَمَهُمْ","بالتَّحَدِّي مالكمْ لا تَنْطِقُونا",44,"ن",2,0],["قالَ لَهُ وَالعَينُ طَمّاحَةٌ","يَلهو بِهِ وَالصَبرُ مَغلوبُ",45,"ب",1,0],["قالَ لي وَالمُدامُ تَأخُذُ فيهِ","يا أَميري إِن كُنتَ بي مِلهاجا",46,"ج",2,0],["قالَ لي قَد كُنتُ مَولىً","زَمَناً ثُمَّ بَدا لي",47,"ي",1,0],["قالَ لي الناسُ إِذ هَزَزتُكَ لِلحا","جَةِ أَبشِر فَقَد هَزَزتَ كَريما",48,"م",2,0],["قالَ لا تُسكِرَنَّني بِحَياتي","قُلتُ لا بُدَّ أَن تُرى سَكرانا",49,"ن",2,0],["قالَ لي حَرَّكتَ هَذا","أَنتَ يا طالِبَ شَينِ",50,"ن",1,0],["قال لي لما تمدّد","تُ عليه حين ناما",51,"م",2,0],["قالَ لي لا يَحِلُّ حُكمي عَلَيها","أَنتَ أَولى بِالسُقمِ وَالإِحراضِ",52,"ض",1,0],["قالَ لا بَأسَ بِالحَديثِ إِذا ما","لَم يَزيدا عَلى الحَديثِ جِماحا",53,"ح",2,0],["قالَ لَنا إِنَّني أَحِجُّ إِلى اللَ","هِ وَأَنتُم مِن أَقبَحِ الرَفثِ",54,"ث",1,0],["قال لي حُسنُ كلّ شيءٍ تجلّى","بي تَمَلّى فقلتُ قَصدي وراكا",55,"ك",2,0],["قال للناس إنما الأمر شورى","بيننا ثم إنه ما اِستَشارا",56,"ر",2,0],["قال لي العَقل ما تحرك هَذا ال","كَون إلا بدافع الكَهرباء",57,"ا",2,0],["قال لا أذكر إلا حُلُماً","لحظةً ضلَّ بها عقلي وتاها",58,"ا",3,0],["قال لي اتعلم من حبي","قرصان العشق هوايا",59,"ا",3,0],["قال لي يلْعبُ صِدْ لي طائِراً","فترانِي الدَّهْر أَجْرِي بالكُدَى",60,"د",2,0],["قال لي الشعرُ قمْ وسجِّلْ وأرِّخْ","أيُّ بُشْرَى غدا الجميلُ باشا",61,"ش",2,0],["قال: لابد أن تموت شهيدا","مثل كل العشاق قلت عساني",62,"ي",1,0],["قال لي ذاك ارتضى إخلادهُ","قال لي هذا: أرى الآن اتئادي",63,"د",2,0],["قال لي يلعب خذ لي طائرا","فتراني الدهر أجرى بالكدى",64,"د",2,0],["قال: لا أذكر إلا حلما","لحظة ضلّ بها غقلي وتاها",65,"ا",3,0],["قال لو أنصفت ما كنت سوى","سكة أو معول أو منجل",66,"ل",1,0],["قال لم ينكب بهم مثلي ولم","يحتمل منكم بهم محتملي",66,"ل",2,0],["قال لي صاحبي يزهِّدُني فيكِ","بهذي المُغالَطاتِ الرِكاك",67,"ك",1,0],["قال لعبد القوي تبا لعلمٍ","لم يجد غير عالم بغاء",68,"ا",2,1],["قال لهاجيكَ مُطنباً في الهجاء","لا تَبِعْ راحة ً بطولِ عناءِ",69,"ا",2,1],["قال له الحبيب لما انتخبا","في حضرة بالفضل اجرت سحبا",70,"ا",1,0],["قَالَ لِى صَاحبي ولِلدَّمعِ فَوقَ الن","نَحرِ مِن لَوعَةِ النَّوَى جَرَيَانُ",71,"ن",1,0],["قَالَ لَهُم مَبَادَرَةُ الهُوينَا","تَجُرُّ لأهلِهَا المَالَ الثَّمِينَا",72,"ن",2,0],["قَالِ لِى صَاحبي النديم ومَن هِى","وجَدِيرٌ بِأن أُجِيبَ النَّدِيمَا",73,"م",2,0],["قَال لِي صَاحبي وعَيبَةُ سِرِّي","ومَن اخترتُ صَاحِباً ونَدِيمَا",74,"م",2,0],["قَالَ لِى صَاحبي وقد عَلِمَ الحَي","رَةَ مِنِّي وَلجَّ عَذلاً وَعَابَا",75,"ب",2,0],["قال لي فاتني تعجب لثغري","إذ عليه جيش النكات تزاحم",76,"م",1,1],["قال لي كيف ذا وهذي نكات","مع أن النكات لا تتزاحم",76,"م",1,0],["قال ليَ الأحورُ من بينهم","وما به ألأجرُ ولا المأثمُ",77,"م",1,0],["قالَ لي هاتِهِ فقلتُ مُجيباً","عزَّ قلبي فلستُ أَملكُ قلبا",78,"ب",2,0],["قال لهم أمر شريف جاءني","من عند ربي فأطيعوا الربا",79,"ب",2,0],["قال لها أعني صروف الردا","لاحى التي تسكن لا حلتي",80,"ت",2,0],["قالَ لي يَهزَأُ مَن لَم","يَتَوَقَّع مِن ملامَه",81,"م",2,1],["قال لما أنْ شكوتُ له","ما أُقاسيه من الكَمَد",82,"د",1,0],["قال لي أنت فيلسوف خيول