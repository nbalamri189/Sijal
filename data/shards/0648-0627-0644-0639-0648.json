1193","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91146","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91548","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85023","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131057",""],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32941","البسيط"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95343","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69906","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69912","الوافر"],[3998,"","https://poetry.dctabudhabi.ae/diwan/poem/34828","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127314","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45019","الكامل"],[4387,"","https://poetry.dctabudhabi.ae/diwan/poem/124044","الكامل"],[4702,"الحرف مايبلش وانا راعي الشان","https://www.poetsgate.com/ViewPoem.aspx?id=156955",""],[4744,"هذا العقيق وذي ربا أزهاره","https://www.poetsgate.com/ViewPoem.aspx?id=131549",""],[4755,"العُودُ رَنَّ كَأَنَّمَا (يَرْنَا)","https://www.poetsgate.com/ViewPoem.aspx?id=191590",""],[4767,"لا عودة","https://www.poetsgate.com/ViewPoem.aspx?id=190159",""],[4782,"أكفان العزة","https://www.poetsgate.com/ViewPoem.aspx?id=200884",""],[4797,"حن بني مرة","https://www.poetsgate.com/ViewPoem.aspx?id=178127",""],[4578,"يا من بعز علاه يزو الموكب","https://www.poetsgate.com/ViewPoem.aspx?id=49351",""],[4888,"مدرسة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=207751",""],[4918,"يومها الموعود","https://www.poetsgate.com/ViewPoem.aspx?id=31101",""],[4988,"كل جنس الخود إلاكي .,., حدر","https://www.poetsgate.com/ViewPoem.aspx?id=153966",""],[5082,"دمعة في مكتوب محبوبة","https://www.poetsgate.com/ViewPoem.aspx?id=212404",""],[5277,"سيدةُ الخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=192265",""],[5307,"مشغوب","https://www.poetsgate.com/ViewPoem.aspx?id=10543",""],[5398,"عيناك ترنو للبقاء","https://www.poetsgate.com/ViewPoem.aspx?id=37218",""],[5401,"ضابط الإيقاع","https://www.poetsgate.com/ViewPoem.aspx?id=78141",""],[5409,"ما لها قد شفعت أيدي الردى","https://www.poetsgate.com/ViewPoem.aspx?id=155456",""],[5411,"ياعاشِقَ الصَّوْبَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=185594",""],[5518,"في ذكرى المولد النبوي الشريف","https://www.poetsgate.com/ViewPoem.aspx?id=187775",""],[5605,"رحلة عابر","https://www.poetsgate.com/ViewPoem.aspx?id=159458",""],[5725,"الخمر يرقص والكؤوس تصفق","https://www.poetsgate.com/ViewPoem.aspx?id=200695",""],[5821,"يوم السبت - مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=114115",""],[5906,"ماذا بعد","https://www.poetsgate.com/ViewPoem.aspx?id=188226",""],[6056,"مجاريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=130501",""]],"verses":[["وَالعودُ لَو لَم تَطِب مِنهُ رَوائِحُهُ","لَم يَفرِقِ الناسُ بَينَ العودِ وَالحَطَبِ",0,"ب",1,0],["وَالعودُ يُعصَرُ ماؤُهُ","وَلِكُلِّ عيدانٍ عُصارَه",1,"ر",2,0],["وَالعَودَ تُعطي مَعاً وَالنابَ مُكتَنِفاً","وَكُلَّ طِرفٍ إِلى الغاياتِ سَبّاقِ",2,"ق",1,0],["والعودُ في كف النديم بسر ما","تُلقي لنا منه الأنامل قد جَهَرْ",3,"ر",1,1],["والعود ينطق باللحو","ن بلهجتي بمّ وزير",4,"ر",1,0],["وَالعَواطي الأُدمُ السَواكِنُ بِال","سُلّانِ مِنها الآحادُ وَالآجالُ",5,"ل",1,0],["والعود صحَّ نجارهُ فإذا سرى","أرَجُ الثنا فالعود فاح كباؤه",6,"ا",3,0],["والعودُ يصخَبُ كي تُجاوبه","مَوْموقةٌ معشوقةٌ الصَّخَبِ",7,"ب",1,0],["والعَود أحمدُ قولٌ قد جرى مثلاً","وعرف مثلك بالعودات موصوف",8,"ف",1,0],["والعود والناي صامتان معاً","أو مسعدا عبرةٍ ودافقها",9,"ق",3,0],["والعُودُ ليس يُعدُّ تِرْباً مَوْطِناً","إلاّ إذا ما اهتَزَّ فيه وأوْرَقا",10,"ق",2,0],["وَالعَودُ أَحمَدُ في الجَميلِ","فَإِن تَشِب فَالعَودُ أَصبَر",11,"ر",1,0],["وَالعُودُ يَخْفِقُ مَثْناهُ وَمَثْلثُهُ","والصُّبحُ قدْ غَرَّدتْ فِيه عَصافِرُهُ",12,"ر",2,0],["والعُود يهتزّ لمرِّ الصَّبا","والروضُ من سَكرته لا يُفيق",13,"ق",1,0],["والعود ألوى كاليتيم برأسه","وبكى لها فبكت غضاضة شأنه",14,"ن",2,0],["وَالعُودُ دَندَن دَنا لِي","وَالطَبلُ طَبطَب طَبَ لِي",15,"ل",2,0],["والعودُ يبكي كالحنين بحجرها","وتلفُّ أُذنَيه كفعل صِرارِ",16,"ر",1,0],["والعود هزته الصبا والطير قد","غنت عليه باختلاف لغاتها",17,"ت",3,0],["والعودُ طالَ أنينه","والموجُ فوقَ الرّمل ناح",18,"ح",1,0],["وَالعودُ يَخطُبُ إِذ نَحنُ الشُهودُ وَصَو","تُ النايِ مُصطَخِبٌ في زيِّ مُصطَحِبِ",19,"ب",1,0],["وَالعَودُ للعيادَه","بعدَ ثَلاثٍ عادَه",20,"ه",1,0],["وَالعودُ أَحمَدٌ بِالبُشرى نُقابِلُهُ","وَنَشرَبَنَّ المُنى في أُنسِهِ نُخبا",21,"ب",2,0],["وَالعَونُ مِنكَ عَلى شانِيَّ صَيّرَني","مُهاجِراً مَن إِلى حُبّيكَ أَنصارا",22,"ر",2,0],["والعَودُ أحمدُ لي ول","كن عاقَ عنه محمدُ",23,"د",1,0],["والعوائد أحكامها نافذات","فدعونا من قول كل فقيه",24,"ي",2,0],["والعوافي والسلامه من ضرر","في سكوت واعتزال وخمول",25,"ل",1,0],["والعورة استرلها","بثيابك الطاهرات",26,"ت",1,0],["والعُودُ لَولا عَبَقٌ طَيِّبٌ","من عَرْفِهِ ما أُحرِقِ العُودُ",27,"د",1,0],["والعودُ للغيدِ الحسان مجاوبٌ","والطارُ أخفى صوتهُ المزمارُ",28,"ر",1,0],["والعودُ عادات الجميل وكأسُنا","كاسُ الكياسةِ والمقارُ وقارُ",28,"ر",1,0],["والعَوْدُ أَحْمَدُ مَا لأَوَّلِ لَيْلَةٍ","يَبْدُو هِلالُ الأَفْقِ بَدْرَ تَمامِ",29,"م",1,0],["والعود قد صعدت به حرباؤه","مثل الخطيب بمنبر يتنبس",30,"س",1,0],["والعوالي مثلُ الصّلال عطاشا","فهي حرّى وقد أولعتْ بالولع",31,"ع",1,0],["وَالعودُ قَد أَسمَعَ مِن نُطقِهِ","مَلاحَةً لَم يَحوِها نَطقُ",32,"ق",1,0],["وَالعودُ إِنْ طَرَحَ التقادُم قادحاً","فيهِ وَلم تدلكه ظلَّ العودُ",33,"د",1,0],["والعود عاد بصوت في الغناء شجٍ","وقال نحن وأنتم كلنا عبر",34,"ر",1,0],["وَالعُودُ وَالقانونُ وَالرقُّ البَهي","كُلٌّ أَجاب بِأَبدَع الأَوزان",35,"ن",1,0],["والعود احرق نفسا في مجامره","مذ سار ذكرك فياحا بكل فم",36,"م",1,0],["والعود تخطر في حشاه أناملٌ","لم يطو سراً دونهن ضمير",37,"ر",1,0],["والعَوجَانُ الذي كلفتُ به","قد سُوِّيَ الحسنُ فيه مذ عَوَّج",38,"ج",1,0],["والعَوَجانُ الذي تخالسُهُ","لواحظٌ كلُّهُنَّ مخلُوسُ",39,"س",1,0],["وَالعَون بَعد ذا اِنثَنى وَوَلّى","وَراحَ عَن خدمته وَرَحَلا",40,"ل",2,0],["والعودُ يحكى بين ما غادةٍ","وبين ما مِلْغٍ إلى مِلْغ",41,"غ",1,0],["والعَوذ بالله مُذْ حَلَّ","حَلّ للشر عِقدا",42,"د",2,0],["والعود والجدول بها أصبحا","هذاك مخضر وهذا حسام",43,"م",1,0],["والعود مستنطق عن كل معجبة","يضحى بها كل قلب وهو متبولُ",44,"ل",1,0],["والعون والامن الذي تُلغى به","الدرجات والمخصوص بالاسداء",45,"ا",2,0],["والعود صار لمن والاه مكرمة","سيفا وبالسم فاه العضو غير فم",46,"م",1,0],["والعود أصبح مزهراً","ورق الحمام قيانه",47,"ن",2,0],["والعودُ بالإحراق يبدو عرْفُه","والمسكُ أذكى عبَقاً إذا سُحِقْ",48,"ق",1,0],["والعود بالإحراق يبدو عرفه","والمسك أذكى عبقا إذا انسحق",49,"ق",1,0],["وَالعونُ تَنتَجِعُ الفَلاةَ فَأَضمَرَت","مِنها البُطونَ وَأَعرَضَت أَكفالَها",50,"ل",3,0],["والعود يحمد سما","في مثل هذا العيد أحمد",51,"د",1,0],["والعود يطلبه والدف يندبه","والناى يعتبه فيما اليه نجا",52,"ج",2,0],["والعوالي شواجرٌ تَصِفُ المو","تَ بأيمانِ فتيةٍ كالعوالي",53,"ل",2,0],["والعود إن طابت مغارسه سرت","أرواحه أرجاً من الأوراق",54,"ق",1,0],["وَالعودُ وَالقانونُ وَالرِق","قُ الَّذي يُبدي الرَقائِقِ",55,"ق",1,0],["والعود لا تضرب به فيسوؤني","وعلى الطناجر إن نقرت حلالي",56,"ل",2,0],["والعو ليس من الفصيص","جناؤه ومن الشكاع",57,"ع",1,0],["والعود لم يك أحمداً إذ مات عن","كثبٍ وخلف لوعة تنفي الكرا",58,"ر",2,0],["والعُود قد أُطْلِقَ في المَجامرِ","وعَرْفهُ كَمِثْلِ طيبٍ عاطِرِ",59,"ر",1,0],["والعودُ مَعدودٌ لدى الغابا","ت من جِنسِ الشَجَر",60,"ر",1,0],["والعود اطرب منا كل جارحةٍ","وطيب مغناه قد فاحت اطائبه",61,"ب",2,0],["وَالعُود أَحمَد وَالبُشرى مُؤرخة","عادَ الخِديوي فَطابَ الانس يا مَصر",62,"ر",1,0],["والعودُ يُعْرب فرعُه عن أَصله","ويجيء من ثمراته بفوائد",63,"د",1,0],["والعود يختار على من كان كال","مختار أو من كان ذا تزندق",64,"ق",1,0],["والعودُ أَحدبُ وَهْوَ ألهى مطرب","وَلَقَدْ سَمْعتَ بِنَغْمَةِ العيدانِ",65,"ن",1,0],["والعود وهو يراه الناس من خشب","يحيا بكفك حتى يثمر النغما",66,"م",2,0],["والعواميد خلتها في صلاة","ركعا حول معبد وقياما",67,"م",2,0],["والعود ليس له نشر ورائحة","إلا إذا حل فوق الجمر واحترقا",68,"ق",2,0],["والعود في الأفراح فاح شذاه إذ","لاح ارتقاه فأطربت أوتاره",69,"ر",2,0],["والعود كالقلب في تكوين خلقته","أوتاره ونياط القلب أنداء",70,"ا",2,0],["والعود بين محرك ومحرق","في روضة غنا بها شاد أغن",71,"ن",1,0],["والعود خَيَّمْ ظِلَّهْ اظْلال","وِبْجيتْ لا حَيٍّ ولا ميّت",72,"ت",1,0],["والعوهقين قد سمعنا ايضا","عن كل ذي علم يفيض فيضا",73,"ض",2,0],["والعود أخرس والساقي على طرف","والكاس في جانب والزق منتفخ",74,"خ",1,0],["والعودُ يُسْمِعُ صوتُهُ في كفِّه","ما شاءَتِ العُشّاقُ من مرغوبِها",75,"ب",3,0],["والعود دلهّ في انامل ضاربٍ","ولذاك ابدى انةً وتوجعا",76,"ع",2,0],["والعود متبع غناء خريدة","غرداً يقول كما تقول صوابا",77,"ب",2,0],["والعودُ تُسوِيهِ وفيهِ لُدونةٌ","لكنَّهُ ان جفَّ لا يتقوَّمُ",78,"م",1,0],["وَالعود ردَّد عَن لِسانِ سُرورنا","شكراً لَها وَنزيدُه بِدَوام",79,"م",1,0],["وَالعَوالي تميل ميلة دلّ","تركت قامة الغُصون قَصيفه",80,"ف",2,0],["وَالعود يُغرب حينَ يُعرب لحنه","عَن نَغمة القانون ذاكَ الذاكي",81,"ك",2,0],["وَالعُودُ ذلّلَ جيدَه","متفكّراً فيما يَكون",82,"ن",1,0],["وَالعَوالي تَأَمَّنَت بِتَثَنّي","قَدُّهُ وَاِعتَلَت عَنِ الإِشفاقِ",83,"ق",1,0],["والعود بالألحان يظ","هر ما تكتم في الضمير",84,"ر",1,0],["وَالعودُ يَتبَعُهُ نايٌ يَوافِقُهُ","وَالشَدوُ يَحكِمُهُ غُصنٌ مِنَ البانِ",85,"ن",1,0],["والعُود يَبس والمكان يبس","فاحفظه واحدِس فالذكي يحدس",86,"س",1,0],["والعود معروض على الإناءِ","يعرُض بالضم فحسبُ جائي",87,"ي",1,0],["والعود عن مشتجر السيوف","تملصاً من داهم الحتوف",88,"ف",1,0],["وَالعودُ وَالذَهَبُ إِلا بَريز فَضلَهُما","بِالنارِ يَبدو وَلَم يَمسسهما ضَرَرُ",89,"ر",1,0],["وَالعودُ احمدُ في عيدٍ نضجُّ بِهِ","فَليَحيى ارختُ للآبادِ مختارُ",90,"ر",1,0],["وَالعودُ دَندَن دَندَنٌ","وَالطَبلُ طَبطَبطَبَ لي",91,"ل",2,0],["والعود أحمد حيث روض مسرتي","واه وليس سوى لقاك له حيا",92,"ح",3,0],["وَالعودُ يَنفُثُ ما أَقَل جَنانَهُ","مِن نَغمَةٍ الوَرقاء أَيام الشَجَرِ",93,"ر",1,0],["والعوذ تنضح بالنشيل وضمّرا","ما بين ناجية وناج أفتل",94,"ل",1,0],["والعود الازرق فاح بيدين شجعان","لا مرّ واحدهم ينسّيك غيره",95,"ر",2,0],["والعوذ من ظمأ الزحام إذا همى","هول الجحيم وكر كرب أواره",96,"ر",2,0],["والعُودُ رَنَّكأنها خَطَرَت","بِقَوَامِها، وبَهَائِها الأَسنَى",97,"ن",2,0],["والعُودُ رَنَّ وكِدْتُ أَكرَهُهَا","وأَنا الذي مِن أُمِّهَا أَحْنَى",97,"ن",2,0],["والعودة ما قال (نزارٌ)","منا تحتاج إلى مدفع",98,"ع",1,0],["والعون بغيركَ منصرمُ","والذل بدَمِنا مُلتحمُ",99,"م",1,0],["والعوا فالليل ما شد انتباهي","اطرب لصوته واغني ليل ادانه",100,"ن",2,0],["والعود فا أريجه لما غدا","بسماعه لحن الصبابة يعرب",101,"ب",1,0],["والعودُ شلالُ اللآلئِ سِرُّهُ","تحكيهِ سنبلةُ الزمانِ فتصدُقُ",102,"ق",1,0],["والعواطف اشهد اني لارفعت ايدي بصلاتي","امطرت صدق العواطف والخفوق اصبح بخير",103,"ر",1,0],["والعواذل كل ابوهم من وراي","ما تفرقنا أباليس السحر",104,"ر",1,0],["والعودُ والدُّفُ اللذانِ وهبتني","لم يعزِفا غير الصَّبا المتكسِّرِ",105,"ر",1,0],["والعودُ بلا وترٍ عندي","مذ فارق لحني أوتارهْ",106,"ر",2,0],["والعود من شافه يظني","امن الخصر مقسوم نصين",107,"ن",1,0],["والعود يشدو قصتي وقصائدي","والطيرُ والشحرورُ والورقاءُ",108,"ا",2,0],["والعود راهي ممتلي والقَدّ قَدّ","يأخذ من العفري قوامٍ ورقبه",109,"ب",2,0],["والعوادي إن تعاقبن على","الحر شدت منه عضداً فردا",110,"د",2,0],["وَالعودُ أمْحَلَ مُذْ نَأَى عُنْقودُهُ","وَ تَنَهْنَهَ الضّلْعُ الشَّغوفُ مُعانِيا",111,"ن",3,0],["والعودة حتى لو حلما","بقيَت أتُراكَ تبدده",112,"د",2,0],["والعود يصمت والنايات ما عزفت","والطبل سيدنا والرقص والضجر",113,"ر",1,0],["والعود تضربه انامل حسنه","فتسمرت اوتاره لا تنطقُ",114,"ق",1,0],["والعود عقب له حرارن بالاوكار","فيهم على ضرب المعادي حماسه",115,"س",2,0],["والعود يكسر إذ خلا عن عصبة","ومحال تكسر عصبة العيدان",116,"ن",1,0],["والعواطف من غلاها تشتعل في داخلي","واحبس الأنفاس أداري دمعتي لا تستجيب",117,"ب",1,0]]}