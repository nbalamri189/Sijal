{"poems":[[3,"يا عبل أين من المنية مهربي","https://www.aldiwan.net/poem116.html",""],[39,"أغشى المكاره أحيانا ويحملني","https://www.aldiwan.net/poem6862.html","البسيط"],[53,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[47,"أتاركي أنت أم مغرى بتعذيبي","https://www.aldiwan.net/poem10649.html","البسيط"],[47,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[63,"جاءت مولعة الكواهل","https://www.aldiwan.net/poem51489.html","مجزوء الكامل"],[63,"أمحل صبوتنا دعاء مشوق","https://www.aldiwan.net/poem51532.html","السريع"],[82,"أي نعيم في الصبا والمقترح","https://www.aldiwan.net/poem31521.html","الرجز"],[46,"أما الرسوم فقد أذكرن ما سلفا","https://www.aldiwan.net/poem30404.html","البسيط"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9881","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21084","المنسرح"],[108,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[47,"أتَارِكِي أنْتَ أمْ مُغْرًى بتَعْذيبي","https://www.poetsgate.com/ViewPoem.aspx?id=31689",""],[136,"كلف العيس بالسرى فذراها","https://www.aldiwan.net/poem54692.html","الخفيف"],[146,"هل في جنوب اللوى وجد فأطربه","https://www.aldiwan.net/poem58378.html","البسيط"],[276,"لكل خطب مهم حسبي الله","https://www.aldiwan.net/poem52129.html","البسيط"],[415,"إيها بحقك مجد الدين تعلم أن","https://www.aldiwan.net/poem32262.html","البسيط"],[463,"أنشد من عهد ليلى غير موجود","https://www.aldiwan.net/poem56215.html","البسيط"],[463,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[542,"الحمد لله نجاني وخلصني","https://www.aldiwan.net/poem69414.html","البسيط"],[545,"أغشى الطريق بقبتي ورواقها","https://www.aldiwan.net/poem56669.html","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59633","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80241","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64555","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78173","الكامل"],[2842,"","https://poetry.dctabudhabi.ae/diwan/poem/146040","الكامل"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99482","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97889","السريع"],[3361,"","https://poetry.dctabudhabi.ae/diwan/poem/202180","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86339","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138513",""],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18756","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59514","الكامل"],[4068,"","https://poetry.dctabudhabi.ae/diwan/poem/206123",""],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94918","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94535","الكامل"],[4493,"","https://poetry.dctabudhabi.ae/diwan/poem/20657","الكامل"],[4736,"ظلمات","https://www.poetsgate.com/ViewPoem.aspx?id=176156",""],[1043,"خداع العين","https://www.poetsgate.com/ViewPoem.aspx?id=89186",""],[5845,"لكلِّ خطبٍ مهمٍّ حسبيَ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198425",""],[5956,"لله أشكو ذلّتي","https://www.poetsgate.com/ViewPoem.aspx?id=182498",""],[5956,"لما سرحنا في شحيم","https://www.poetsgate.com/ViewPoem.aspx?id=194279",""],[5956,"الواقع شريعتي الشعرية","https://www.poetsgate.com/ViewPoem.aspx?id=201546",""]],"verses":[["أَغشى فَتاةَ الحَيِّ عِندَ حَليلِه","وَإِذا غَزا في الجَيشِ لا أَغشاها",0,"ا",3,0],["أغشى المكاره أحياناً ويحملني","منه على طَأة والدهر ذو نُوَبِ",1,"ب",1,1],["أغَشَّها البحرُ عن إغاضتِه","بالغتِّ فالغتِّ أيّ إغشاش",2,"ش",1,0],["أَغشى الخُطوبَ فَإِمّا جِئنَ مَأرَبَتي","فيما أُسَيِّرُ أَو أَحكَمنَ تَأديبي",3,"ب",2,0],["أَغشاهُمُ خُلساً فَأَذهَبُ راغِباً","تِلقاءَ حَيثُ هُمُ وَأَرجُعُ زاهِدا",4,"د",2,0],["أَغشاهُ طوعَ أكارمِ ال","خُلاَّنِ لا طَوعَ الحَلائِل",5,"ل",1,0],["أغشاهُ بينَ مُنافِقٍ متجَمِّلٍ","ومُناضِلٍ عن كُفْرِهِ زِنْديقِ",6,"ق",1,0],["أغشُّ خلقِ اللَّه عند ذي هوى","من عَرَضَ الرشدَ عليه ونصح",7,"ح",1,0],["أَغشَيتَ بارِقَةَ الأَغمادِ أَرؤُسَهُم","ضَرباً طِلَخفاً يُنَسّي الجانِفَ الجَنَفا",8,"ف",2,0],["أَغشى فَتاةَ الحَيِّ عِندَ حَليلِها","وَإِذا غَزا في الجَيشِ لا أَغشاها",9,"ا",3,0],["أَغشَى دِياراً كأَنَّها حَللٌ","أَفقَرَ مِنها الشُّريَفُ فَالوَشَلُ",10,"ل",1,1],["أغشاك للأَجر، وللثواب","غِشْيَانَ عبدٍ، خاشع، أَوَّاب",11,"ب",1,0],["أغشَى الخُطُوبَ، فإمّا جئنَ مأدَبتي","فيما أُسَيِّرُ، أوْ أحكَمْنَ تأديبي",12,"ب",2,0],["أغشِهَا هَولَ كُلِّ يَهمَاءَ يَعيَا","عَن وُرُودِ المِيَاهِ فِيهَا قَطَاهَا",13,"ا",3,0],["أغشَى الخيامَ بذلٍّ ليس يطرُدُه","لَفتُ الخدودِ وإعراضُ الأرسايرِ",14,"ر",1,0],["أَغشاه خلعة نور فيه أودعها","جبريل وَهُوَ باذن اللَه أَغشاه",15,"ا",2,0],["أَغشى العرابي من أَنوار بهجته","سر العناية منه حين والاه",15,"ا",2,0],["أغشَى الوغى مفرداً من أُسرتي وهمُ","هُمُ إذا الخيلُ خاضت لُجّةَ العَلَقِِ",16,"ق",1,0],["أغشاه غِشيانَ مجلوبٍ يُغَرُّ بما","رأَى وأُصرَف عنه صَرفَ مطرودِ",17,"د",1,0],["أُغَشُّ بآمالي كأنّيَ أُنصحُ","وأبقَى لأشقىَ بالبقاء وأفرحُ",18,"ح",1,1],["أغشى الصِياحَ وتَغشاني مُضاعَفَةٌ","من الحَديدِ إذا ما بَعضُهم خَنَسَا",19,"س",2,0],["أَغشى الطَريقَ بِقُبَّتي وَرواقِها","وَأَحلُّ في قُلَلِ الرُبا وَأُقيمُ",20,"م",1,1],["أغشى الكتيبة لم أبال بسيبها","حتى سبتني أعين ونُحور",21,"ر",1,0],["أَغشى وَغى الحُب لا أَخشى طَوارِقُهُ","أَواه لَو كُنت فيهِ غَير مُنكَسِرِ",22,"ر",1,0],["أغشني يا رحمن بالرحمة التي","رحمت بها أيوب في الضر باليا",23,"ي",2,0],["أَغشى مَنازِلَهُم عَلى بُعد كَما","تَغشى الطُيور مَنازل الأَجواد",24,"د",1,0],["أغشى الملوك كما أري","د ولا أحاشي رد حاجب",25,"ب",1,0],["أغشى أناساً فأغشى في منازلهم","جوعاً علي ولا أغشى لهم نارا",26,"ر",2,0],["أغشى الجماعات على حيرةٍ","من رؤية الضدين إذ أشهد",27,"د",1,0],["أغشى الحروب وسربالي مضاعفة","تغشى البنان وسيفي صارم ذكر",28,"ر",1,0],["اِغشو الاحبَّة وَالآساد رابِضَةٌ","وَلَستُ اِخشى من الاِساد اوجالا",29,"ل",2,0],["أغشى الأبصار من الأنوا","ر فلم تدركه وان أسفر",30,"ر",1,0],["أَغشاكُم عَمرو عُيوباً كَثيرَةً","وَمِن دونِ عَمرو ماءُ دِجلَةَ دائِمُ",31,"م",1,1],["أغشى الوقيعة وهي بكر عابس","واعلُّ والحرب الزَّبون عَوانُ",32,"ن",1,0],["أغش الأمور بحزمِها","حتى تُلاقي الأحزَمَا",33,"م",2,1],["أغشى النوى أرّخ صفاءَ صهابِه","وتلألأَت بسما السما أنوارهُ",34,"ه",1,0],["أغشى الغزالة بالضحى غاراتهُ","وكسى النهار كما الظلام عِكارا",35,"ر",2,0],["أغشى المَهالِكَ بِالرِجالِ وَلا","أُعطِيَ المَقادَةَ سائِمي الحَقرا",36,"ر",2,1],["أَغْشَتْ دِيَارَ القَوْمِ ثُمَّ تَقَزَّعَتْ","وَتَفَرَّقَتْ فِي سَائِرِ الأَرْجَاءِ",37,"ا",2,0],["أغشَيْتَ بالدمع أجفاني لتخدعَني","ياحبُّ كي لا أرى ما تُضمِرُ الحجبُ",38,"ب",1,0],["أغشاهُ خلعة َ نورٍ فيهِ أودعها","جبريلُ وهوَ بإذنِ اللهِ غشاهُ",39,"ا",2,0],["أغشى العرابيَّ منْ أنوارِ بهجتهِ","سرُّ العناية ِ منهُ حينَ ولاهُ",39,"ا",2,0],["أغشَى الفنادق يوم أن لا ترتضي","إعطائيَ المفتاح في الصيفيّةِ",40,"ه",1,0],["أغشى ديارك هائماً متودداً","متعبداً فيه أرى التكريما",41,"م",2,0],["أغْشَى مواضيعَ كلُّ الناسِ تطرقها","لكنْني في النُّوى ركَّزْتُ محترفا",42,"ف",2,0]]}