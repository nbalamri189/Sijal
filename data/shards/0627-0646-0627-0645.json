,169,"ح",1,0],["أَنامَته في أُفحوصِها ثُمَّ قَلَّصَت","تَقَلَّبُ تهوي في قَرائِنَ جُنَّحِ",169,"ح",1,0],["إِنَّ امرَءاً تَعتادُهُ ذِكرٌ","مِنها ثَلاثُ مِنىً لَذُو صَبرِ",170,"ر",1,1],["إِنَّ اِمرَأً رَهطُهُ بِالشامِ مَنزِلُهُ","بِرَملِ يَبرينَ جاراً شَدَّ ما اِغتَرَبا",171,"ب",2,0],["إِنَّ اِمرَأً أَمِنَ الحَوادِثَ جاهِلٌ","يَرجو الخُلودَ كَضارِبٍ بِقِداحِ",172,"ح",1,1],["إِنَّ اِمرِأً أَمِنَ الحَوادِثَ جاهِلاً","وَرَجا الخُلودَ كَضارِبٍ بِقِداحِ",172,"ح",1,0],["أَنا مُذ صارَ لي سَكَن","في ضُروبٍ مِنَ الحَزَن",173,"ن",1,1],["أَنا مَن تَعلَمونَ أَسهَرُ لِلمَج","دِ إِذا غَطَّ في الفِراشِ اللَئيمُ",174,"م",1,0],["أَنا مُذ غِبتَ قَد أَروحُ وَأَغدو","مِن سُرورِ الدُنيا بِوُدٍّ خَلاءِ",175,"ا",2,0],["أنامَ الرَّعايا في أمانٍ وطَرْفُهُ","لما فيه إِصْلاحُ الرَّعِيَّةِ يَسْهَرُ",176,"ر",1,0],["إنَّ امرَأً مُتَبَتِّلاً بِثَنائِهِ","مُتَبَتِّلٌ لِإلهِهِ تَبتِيلا",177,"ل",2,0],["إِنَّ امْرَأً شَمَلَتْهُ مِن شَفَاعَتِهِ","عِنايَةٌ لَامرُؤٌ بالفَوزِ مَشْمُولُ",178,"ل",1,0],["أنا مِن صارِمٍ وطِرْفٍ جَوادٍ","لستُ من قُبّةٍ وقصرٍ منيفِ",179,"ف",1,0],["أَنا مُستَهتِرٌ بِحُبِّكَ صَبٌّ","لَستُ أَشكو هَواكَ إِلّا إِلَيكَ",180,"ك",1,0],["أنا مالي وللربا","ط وللغزو والغزاءِ",181,"ا",2,0],["أنا متقنّصٌ دانٍ قريبٌ","بباب الكرخ مجتمع الطياب",182,"ب",1,0],["أنا مِن عيني وقلبي","ومن أيري في اجتهاد",183,"د",1,1],["أنا من خمسين عاماً","في يديَ أيري أسيرُ",184,"ر",1,0],["إِن أُمسِ مُنقَبِضَ اليَدَينِ عَنِ الغِنى","وَعَنِ العَدُوِّ مُخَيَّسَ الشَيطانِ",185,"ن",1,1],["أَنا مَن يُعطيكَ قُصوى نَفسِهِ","وَإِذا أَولَيتَهُ خَيراً شَكَر",186,"ر",1,0],["إِنَّ أُمَّ الوَليدِ فَاِستَرقِياها","أَفسَدَتني وَعِندَها إِصلاحي",187,"ي",1,0],["أَنا مِمَّن عَذَّبَ اللَ","هُ بِحُبّى وَالوُشاةِ",188,"ه",1,0],["إِن أُمَتَّع بِها فَيا نِعمَةَ اللَ","هِ وَإِن يَنحَرِم فَوَيلي مُحِبّا",189,"ب",2,0],["إِنّا مُلوكٌ لَم نَزَل","في سالِفاتِ الحِقَبِ",190,"ب",1,0],["أَنا مِنهُ وَمِن جَوى الحُبِّ أُمسي","في عَذابٍ قَد ناءَ فَوقَ العَذابِ",191,"ب",1,0],["أَنا مِن حُبِّكِ الضَعيفُ الَّذي لا","أَستَطيعُ السُلُوَّ عَنكِ بِطِبِّ",192,"ب",1,0],["أَنا مَشغوفٌ بِسَلمى","كَالنَصارى بِالصَليبِ",193,"ب",1,0],["أَنا مَن قَد عَلِمتِ لا أَنقُضُ العَه","دَ وَلا تَستَخِفُّني الأَهواءُ",194,"ا",2,0],["أَنا ما حَجَجتُ فَكَم تَحُجُّ نَوائِبٌ","شَخصي وَيَفقِدُ عِندَها الإِحصارُ",195,"ر",1,0],["أَنامُكِ أَيُّها الدُنِّيا ثِمارٌ","فَما تَبَقى عَلى وَمَدٍ وَقَرسِ",196,"س",1,0],["إِنّا مَعاشِرَ هَذا الخَلقِ في سَفَهٍ","حَتّى كَأَنّا عَلى الأَخلاقِ نَختَلِفُ",197,"ف",1,1],["إِنَّ أَمامِيَ أَسَداً فارِساً","لا بازِلاً يوطِئُني فِرسَنَه",198,"ن",2,0],["أَنامٌ لَعَمري لَيسَ فيهِ مُوَفَّقٌ","لِرُشدٍ وَلا يَحظى بِخَيرٍ إِذا جُزي",199,"ز",2,0],["إِنَّ اِمرَأً سَرفَ الفُؤادِ يَرى","عَسَلاً بِماءِ سَحابَةٍ شَتمي",200,"م",2,1],["إِنَّ أَمامَكَ يَوماً أَنتَ مُدرِكُهُ","لا حاضِرٌ مُفلِتٌ مِنهُ وَلا بادي",201,"ي",1,0],["إن أَمُتْ مِيتةَ المُحبِّينَ وجْداً","وفؤادي منَ الهوى حَرِقُ",202,"ق",1,0],["أنام في ظل قبري","إن مت نوماً رَغيدا",203,"د",2,1],["إِنّا مِن الدنيا بمنزل محنة","يَبكي الحكيم به عَلى المتبسم",204,"م",1,0],["أنا من مستقبل النا","سِ على الناس أَخافُ",205,"ف",1,0],["إِنّا من الأرض الفضاء ببقعة","لَيسَ الحَياة بها سوى حدثان",206,"ن",1,0],["إن أمت خائباً فكم حسرات","بقيت في نفوس ناس عظامِ",207,"م",1,0],["إن أمت خائِباً فَكَم من كرام","بقيت في نفوسهم حسرات",208,"ت",1,0],["أَنا مُسلم وَأَخاف بعد الموت في","قَبري مقارع منكر وَنَكير",209,"ر",1,0],["إنّ امرأً أمةٌ حبلى تدبّره","لمستضامٌ سخين العين مفئود",210,"د",1,0],["أنا مذ كنت قبل في حضن أمي","يوم كانت تربّني باهتمام",211,"م",1,0],["إن أمي هي التي خلقتني","بعد ربي فصرت بعض الانام",211,"م",1,0],["أنا من زعمتمْ غيرَ أنِّي شاعرٌ","أرضى البيانَ بما يصوغُ ويرسُمُ",212,"م",1,0],["أنا من يُغَنّي بالمصارع في العُلى","ويَشيدُ بالآلام والأحزانِ",213,"ن",1,0],["أنا مَنْ أقامَ الحَرْفَ وَهْيَ كأنها","نُونٌ بدارِكَ والمعالِمُ أسْطُر",214,"ر",1,0],["أَنَا مِنْهُ بَيْنَ صَبَابَةٍ لا يَنْقَضي","مِيقَاتُهَا وَمَواعِدٍ لا تُثْمِرُ",215,"ر",1,0],["أَنَا مِنْكِ بَيْنَ صَبَابَةٍ لا تَنْقَضِي","أَيَّامُهَا وَغَوايَةٍ لَمْ تُقْلِعِ",216,"ع",1,0],["أَنا مِنْكَ مَطْوِيُّ الْفُؤادِ عَلَى جَوىً","لَوْلا الْدُّمُوعُ ذَكَتْ بِهِ الْحَوْبَاءُ",217,"ا",2,0],["أَنَا مَا بَيْنَ نِعْمَةٍ وحَسُودٍ","والْمَعَالِي كَثِيرَةُ الْحُسَّادِ",218,"د",1,0],["أَنَا مِنْ مَعْشَرٍ كِرامٍ عَلَى الدَّهْ","رِ أَفَادُوهُ عِزَّةً وصَلاحَا",219,"ح",2,0],["أَنَا مَصْدَرُ الْكَلِمِ النَّوَادِي","بَيْنَ الْحَواضِرِ وَالْبَوادِي",220,"ي",1,1],["أَنَا مَنْ إِنْ دَعَتْ إِليْكَ حُقُوقٌ","مَا تَوَانَى وَإِنَّهُ لَعَلِيلُ",221,"ل",1,0],["إِنَّ أَمْناً يَقِي العِبَادَ لَخَيْرٌ","مَنْ جِرَاحٍ وَمِنْ أَساً وَضِمَاد",222,"د",1,0],["أنا، مهما تطردِ الشمسُ الدجى","لا تزلْ نفسي بليلٍ أليل",223,"ل",1,0],["أنا مهما قلت في ويلاتها","كنت ممن قنعزا بالوشل",223,"ل",1,0],["أنا منها وقلبُ لبنان في","قلبي وأهدابهُ على أهدابي",224,"ب",2,0],["أنا من ثراك فهل أضِنُّ بأدمعي","في حالتيك ومن سمائك ألهمُ",225,"م",1,0],["أنا ماض غدا مع الفجر فاسكب","نغمات الخنان في أذنيّا",226,"ي",2,0],["أنا مذ أتيت النهر آخرَ ليلةٍ","كانت لنا ذكرتُهُ إنشادي",227,"ي",1,0],["أَنا مَشغولٌ إِذا ما","كانَ لِلنّاسِ فَراغُ",228,"غ",1,1],["أَنا مَصدورٌ بِقَومٍ","سِمَتهُم حَقّي فَراغوا",228,"غ",3,0],["أَنا مِسكينٌ وَلَو كُنتُ كِسرَى","لا غِنىً إِلّا بِعَبدِ الغَنِيِّ",229,"ي",1,0],["أَنا مِن خَمرَةِ ثُكلي طافِحٌ","وَالهَوى مُصطَبحي وَالمُغتَبَق",230,"ق",1,0],["أَنا مِن تَلفيقِ ما مَزَّقَهُ","مُرتَجوهُم في عَناءٍ وَشُغُل",231,"ل",1,0],["إِنَّ اِمرَأَ القَيسِ أَضحى مِن صَنيعَتِكُم","وَعَبدَ شَمسٍ أَبَيتَ اللَعنِ فَاِصطَنِعِ",232,"ع",1,1],["أنا مَدَّ الدَّهْرِ أَذْكُرُهُ","وَهْوَ مَدَّ الدَّهْرِ يَذْكُرُني",233,"ن",2,0],["إِنَّا مَوْلِدُ المَعَارِفِ في مِصْرَ","دَبِيبُ الْحَياةِ بين الرُّفَاتِ",234,"ت",1,0],["أنا من تُرْبِك النقي وشعري","نفحاتٌ من وَحْيِ قُدْسِك تُهْدى",235,"د",2,0],["أنا من فَيْضِ له مُتّصِلٍ","أنعُمٌ تمضِي فألقَى أنعُمَا",236,"م",2,0],["إنّ أمَّ المجدِ مِقْلاتٌ فكم","سَوَّفَتْ بين جَنينٍ وجَنين",237,"ن",1,0],["أنا ما حقدت على الشفاه","ولا عتبت على الأنامل",238,"ل",1,0],["أنا من محاقك صغتُ -لا","من نورك الزاهي- نشيدي",239,"د",2,0],["إن أمضى السلاح في ساحة الحر","ب سلاحُ الأقْلام والألواح",240,"ح",1,0],["أنا من أُناسٍ يعرفو","ن له جلالة قدره",241,"ر",2,0],["أنا منْ ضاق بالحَوَاضر ذَرْعًا","وأواها؛ فحطَّمَتْ أعصابه!",242,"ب",2,0],["إنّا مشينا وراء الغرب نقتبس من","ضيائه فأصابتنا شظاياه",243,"ا",2,0],["أنا من غزلت انتحار الحياة","هنا شفقا من زفير العذاب",244,"ب",1,0],["أنا مجرم الحبّ يا صاحبي","فلا تعتذر لي فلم تقنع",245,"ع",1,0],["إِنَّ امرأً أَمَةٌ حُبلى تُدَبِّرُهُ","لَمُستَضامٌ سَخينُ العَينِ مَفؤودُ",246,"د",1,0],["أنا ماض غداً مع الفجر فاسكب","نغمات الحنان في أذُنيّا",247,"ي",2,0],["أنا ملء الكون ما فيه سوى","خدمي أو خولي أو رسلي",248,"ل",2,0],["انا مذ كنتُ كنتُ ما بين نفسي","والسخافاتِ هذِه في عِراك",249,"ك",1,0],["أنا مثلُكم أسلمتُ كلِّ عواطفي","لليأسِ يأخذُها بكلِّ مَجال",250,"ل",1,0],["أنا ما بكيت الشعر ذل وإنما","أبكي الشعور يباع في الأسواق",251,"ق",1,0],["أَنا مَنْ بَلَّهُ نَدَالَ ، وأَعلَتْ","مِنْهُ آلاَؤْك العِراضُ الطِّوَالُ",252,"ل",1,0],["أنَا مَنْ أحَبّ مُصَحَّحاً، وكأنّني","فيما أُعاني منكَ مِمّنْ أُبْغِضَا",253,"ض",2,0],["أَنا من إذا سَتَرَ الهَوى خوْفَ العِدى","فَضَحتْهُ مُقلتُهُ لَدىَ الجُلاَّسِ",254,"س",1,0],["أنا منكم في روضة معطارة","من مونق فيها اللحاظ لونق",255,"ق",1,0],["أنا ما وقفت لكي اشبب بالطلا","مالي وللتشبب بالصهباء؟",256,"ا",2,0],["أنا ما وقفت اليوم فيكم موقفي","إلا لأنذب حالة التعساء",256,"ا",2,0],["أنا من ضميري ساكن في معقل","أنا من خلالي سائر موكب",257,"ب",1,0],["إنّ أمامي خَيرَ مَنْ وَطىءَ الحَصَى","لذي هِمّةٍ يَرْجو الغِنى أوْ لِغارِمِ",258,"م",1,1],["أنا ما أنا فلتقبليني مغامرًا","تجارتُهُ الأشباحُ والوهمُ والليلُ",259,"ل",1,0],["أنامل صوتك الزرقاءُ","تمعين فيَّ تمزيقا",260,"ق",2,0],["أنا متعب ... ودفاتري تعبت معي","هل للدفاتر يا ترى أعصاب ؟",261,"ب",1,0],["أنا ما جئتُ كي أكونَ خطيباً","فبلادي أضاعَها الخُطباءُ",262,"ا",2,0],["أنا منهم وهم أَظباءُ داء","بَيْن أحشائكم بطيء السكون",263,"ن",1,0],["أنا من علمتَ مكانه وابنُ الذي","ما زال فيكم بُستعان فيحمدُ",264,"د",1,0],["أنا من عرفتَ وفاءه وصفاءه","وولاءه إياكَ مذ هو أمردُ",264,"د",1,0],["أنا من ينساكمُ خدمتَه","حين لاأجرتُه مُتَّزِنه",265,"ن",2,0],["أنا من بعد ما سأهبط قبري","تتساوى عيشتي وغداتي",266,"ي",1,0],["انامل صوتك الزرقاء","تُمْعِنُ فيَّ تَمزيقا",267,"ق",2,0],["أنا ما دمتِ في عُرُوقيَ هَمْساً","فإذا كُنتِ واقِعاً ، لا أكونُ !",268,"ن",1,0],["أنا مع الحب حتى حين يقتلني","إذا تخليت عن عشقي .. فلست أنا",269,"ن",2,0],["أنا من أجله عصيتُ وعُدِّبْتُ","وأقسمتُ غيرهَ لن أطيعا",270,"ع",2,0]]}