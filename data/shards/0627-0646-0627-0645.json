وَلَيسَ يُطفِىءُ سَطوَتي","غُلَواءُ مَن يَطغى إِلَيَّ وَيَجهَلُ",5,"ل",1,0],["أَنا مَولى العِدى وَإِن","كُنتُ عَبدَ الأَصادِقِ",6,"ق",1,0],["أَنا مِنكَ في كَمَدٍ عَلى كَمَدٍ","يَومي عَلَيَّ أَمَرُّ مِن أَمسي",7,"ي",1,0],["إِن أُمسِ لا يَتَّقي زَجري وَلا غَضَبي","وَلائِدُ الحَيِّ مَملولاً لِيَ العُمُرُ",8,"ر",1,0],["أَنا مَن عَلِمتُنَّ الغَداةَ نَقِيَةً","أُزُري وَضامِنَةَ العَفافِ مَآزِري",9,"ر",2,0],["أَنا مِن صَفوَةِ النَبيِّ وَغَيري","وَلَدٌ لا يُعَدُّ في الأَولادِ",10,"د",1,0],["أَنا مَن عَلِمتَ عَلى المُكاشِحِ مُرهَفٌ","نابي وَشاكٍ في الخِصامِ سِلاحِ",11,"ح",1,0],["إِنّا مَعاشِرُ لا تَبلى مَطارِفُنا","إِلّا وَهُنَّ لِطُلّابِ النَدى سَلَبُ",12,"ب",1,0],["إِنّا مُعاوِيُّونَ نَبْسُطُ أَيْدِياً","في المَكْرُماتِ شِمالُها كَيَمينِها",13,"ن",3,0],["أنا مَنْ عَرَفْتِ وبَعْدَ يَومِهِمُ غَدٌ","وعليَّ بزّةُ أجْدَلٍ غِطْريفِ",14,"ف",1,0],["إِنّا مِنَ الدَربِ أَقبَلنا نَؤُمُّكُمُ","أَنضاءَ شَوقٍ عَلى أَنضاءِ أَسفارِ",15,"ر",1,1],["أَنا مِن أَسخَنِ خَلقِ ال","لَهِ عَيناً مُذ عَرَفتُه",16,"ت",2,0],["أنا مَنْ علِمْتَ وفاءَهُ وثَناءَهُ","عِلْمَ اليَقينِ المحْضِ دونَ مُضاهي",17,"ي",1,0],["إِنْ أَمَّه الْعَافُون يَنْتَجِعُونَهُ","يَلْقَاهُمُ مُتَهَلِّلاً بَسَّامَا",18,"م",2,0],["أَنَا مَا بِي سِوَى لَمَاةِ فَتَاةٍ","خَتَلَتْنِي وَأَدْبَرتْ مُخْتَالَهْ",19,"ل",2,0],["أنا مِنْ عاريَ كاسٍ","أنا منْ كاسيَ عاري",20,"ي",1,0],["أنا ملْعَبُ الوصْلِ الذي يشرَحُ الصّدْرا","وبُرْجُ سَماءٍ يجْمَعُ الشّمْسَ والبَدْرا",21,"ر",2,1],["أنا مِنْ خالِصِ الحَديدِ غَديرٌ","فتَرَى وَسْطَيَّ الرّدَى وهْوَ سابِحْ",22,"ح",1,1],["إِنَّ امرءً نُبِّئتُهُ من صَديقِنا","يُسائِلُ هَل أَسقي من اللَبن الجارا",23,"ر",2,1],["أَنا مُذ بانوا وَوَلّى عَهدُهُم","حاضِرُ اللَوعَةِ مَوصولُ النَحيبِ",24,"ب",1,0],["أَنا مَن عَرَفتِ وَمَن جَهِلتِ وَمَن لَهُ","لَولا عُيونُكِ حُجَّةٌ لا تُفحَمُ",25,"م",1,0],["أَنا مَن عَرَفتَ وَمَن خَبَر","تَ وَمَن مَوَدَّتُهُ تَدومُ",26,"م",1,0],["أَنا مُهدٍ إِلَيكَ مدحَةِ عَبدٍ","مُخلِصٍ وَالمَديحُ أَفضَل مُهدى",27,"د",2,0],["إِنَّ اِمرَءًا كانت مَساوِئُهُ","حُبَّ النَبيِّ لَغَيرُ ذي عَتبِ",28,"ب",1,1],["أنا من أسلفت خيراً وتواني","زد جميلاً واقبل العذر امتنانا",29,"ن",2,1],["إنا معدوك ليومٍ به","تكون ذاك السيد الموئلا",30,"ل",2,0],["إِنَّ آمَالَ بِلادٍ وَمُنَى","أُمَّةٍ مُوحِيَةٌ مَا تَسْمَعِينْ",31,"ن",1,0],["إِنْ أَمْكَنَ الحُبَّ مِنْهُ حِينَ خَلْوَتِهِ","فَأَسْمَعَ النَّاسَ فِيهِ أَشْوَقَ النَّغَمِ",32,"م",1,0],["إِنَّ أَمْراً دَهَى بِمَوْتِكَ أَحْيَا","عَامِلٍ بَيْنَ قَوْمِهِ لَجَسِيمُ",33,"م",1,0],["أَنا مَن عَلِمتَ إِذا دُعيتُ لِغارَةٍ","في طَعنِ أَكبادٍ وَضَربِ رِقابِ",34,"ب",1,1],["أنا منشد ما في وقو","فِكَ ساعةً من باسِ",35,"س",1,0],["إن أموات أمة العلم أحيا","ءٌ حياة الأرواح والأجساد",36,"د",1,0],["إن أم النجوم بنت زمانٍ","لم تزل حادثاته مستمرةّ",37,"ر",2,0],["إِنَّ اِمرَأً كَبَتَ العَدُوَّ وَيَبتَني","فينا المَحامِدَ حَقُّهُ أَن يُحمَدا",38,"د",2,0],["إِنَّ اِمرَأً مَنَعَ الزِيارَةَ مِنكُمُ","حَنَقاً لَعَمرُ أَبيهِ غَيرُ حَليمِ",39,"م",1,0],["أَنامَت غَضيضَ الطَرفِ رَخصاً ظُلوفُهُ","بِذاتِ السُلَيمِ مِن دُحَيضَةَ جادِلا",40,"ل",2,0],["إن أمُت لا أمُت وَنَفسِي نَفسَا","نِ من الشَّكِّ في عَمَىً أو تَعَامِي",41,"م",2,0],["إِنَّ اِمرَأً غودِرَ في أَلَّةٍ","مَطرورَةٍ مارِنَةِ العامِلِ",42,"ل",1,0],["إِنَّ اِمرَأً أَمسى وَأَصبَحَ سالِماً","مِنَ الناسِ إِلّا ما جَنى لِسَعيدُ",43,"د",1,1],["إنَّا من التُّربِ أشباح مخلقة","فلا عجيبٌ مآل التُّربِ للتُّرب",44,"ب",1,0],["أنا ما لي اليومَ إلاَّ","بثُّ حمدي لكَ راتب",45,"ب",1,0],["أنا من رأى ناراً على وجناته","تذكو فآنس من جوانبها هدى",46,"د",2,0],["إن أمطرت ظهره رامي السهام مضى","والسبق حذوا فلولا سبقه عقره",47,"ر",2,0],["أنا مستدل بالسقام على الأسى","فإن استطعتَ بفقه عذلك فامنع",48,"ع",1,0],["أنا من يحول العاشقون وعشقه","كندى بني ريَّان ليس يحول",49,"ل",1,0],["أنا مجنون حبّه","ودموعي سلاسلي",50,"ي",1,0],["إن أمتدحه بشعري أو بكسوته","فسوف تمدحهُ في التربِ أكفاني",51,"ي",1,0],["أناملهم تحت الثرى ربع مائه","وأقدامهم يكفيه أن يتزلزلا",52,"ل",2,0],["أَنا مَن أَهوى وَمَن أَهوى أَنا","نَحنُ روحانِ حَلَنا بَدَنا",53,"ن",2,1],["أنا مولاك أنت أعتقتَ رِقِّي","بعدما خِفتُ حالةً نكراءَ",54,"ا",2,0],["أنا من خَفَّ واستدقَّ فما يُث","قِلُ أرضاً ولا يسدُّ فضاءَ",54,"ا",2,0],["أنا مولاك بالمحبة والمَيْ","ل فحمِّل عواتقي الأعباءَ",54,"ا",2,0],["أنا منْ أصابَتْهُ الصواعقُ بعدما","رجَّى حياً فيه حياةُ جنابِ",55,"ب",1,0],["أنا مَنْ لا يُشكُّ في اليُمْنِ مِنهُ","أَوْ يَمينُ ابنُ فَجْرَةٍ ويَحُوبُ",56,"ب",1,0],["أنا من جرَّب المَشاغيبَ منْ قَبْ","لُ وشَغْبي على الزمان وَثُوبُ",56,"ب",1,0],["أنا مَنْ عرفْتَ صفاءَه ووفاءه","وغناءهُ وثناءهُ غيْرَ الوَتِحْ",57,"ح",1,0],["أنا مِن قاسم أرُوحُ وأغْدُو","بمَرَاد من الرَّجَاء مَرُودِ",58,"د",1,0],["أنا من شيعةِ الوصيِّ عليه","صَلَواتٌ من الحميد المجيدِ",59,"د",1,0],["أنا من علمتَ مكانه وابنُ الذي","ما زال فيكم يُستعان فيُحْمَدُ",60,"د",1,0],["أنا من عرفتَ وفاؤه وصفاؤه","وولاءه إياكَ مذ هو أمردُ",60,"د",1,0],["أنا من كلِّ ناصرٍ غير نُعْما","ك وحيدٌ فلا تُضَيِّعْ وحيدَكْ",61,"ك",1,0],["أنا من فارس كمثلك من قح","طانَ إن لم أدعْك في الناس شُهْره",62,"ه",1,0],["أنا من سؤالك بين ميسور الغنى","لا شكَّ فيه وبين مُلك الياس",63,"س",1,0],["أنا من يرى المكوى أقلَّ هِنائهِ","ويقابلُ الأخلالَ بالأحْماض",64,"ض",1,0],["أنا من سَمِعتَ به وحسْبُك خِبرةً","بأخيك ذاك المُبرمِ النقَّاض",64,"ض",1,0],["أنا من إن عشقته فلِودٍّ","خالصٍ منه لم يكن ممذوقا",65,"ق",2,0],["أنا ممّن يستقرض العرف مفعو","لاً ويقضي أضعافه منطوقا",65,"ق",2,0],["أنا مذْ موقفي لوقتِ وداعٍ","منك بادي النحولِ من جرّاك",66,"ك",1,0],["أنا منهُمُ بقضاءِ مَنْ خُتمت","رسلُ الإله به وهم أهلي",67,"ل",2,0],["أنا من أتبع الولاءَ الموالا","ةَ فلا تنسَ حقَّ مولىً مُوالي",68,"ل",2,0],["أنا من قال مُطنباً فيك قولاً","باقيَ الذكرِ سائرَ الأمثالِ",69,"ل",1,0],["أنا من تحلله الزمانُ بتركه","ولمستجيرك بالأمان تجلّلُ",70,"ل",1,0],["أنا من عراكَ وبابُ داركِ مُوحِشٌ","من كلِّ مُؤتنفٍ عليَّ مُقدَّمِ",71,"م",1,0],["أنا من أذْعَنَتْ له الإنسُ والجنْ","نُ جميعاً بالقَسْرِ والترغيم",72,"م",1,0],["أنا من حاسديه لكنني لس","تُ بباغ نُعماه غيرَ الدَّوام",73,"م",1,0],["أنا مِنْ قد عرفتَهُ يا أبا يح","يى إذا استهدر الهجاءُ قُرومه",74,"م",2,0],["إن امرَأً رفض المكاسب واغتدى","يتعلَّمُ الآدابَ حتَّى أحكما",75,"م",2,1],["أنا من أن