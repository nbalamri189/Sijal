x?id=143395",""],[5809,"البواطن","https://www.poetsgate.com/ViewPoem.aspx?id=205357",""],[5997,"وصايا","https://www.poetsgate.com/ViewPoem.aspx?id=214221",""],[5997,"دمع الورود","https://www.poetsgate.com/ViewPoem.aspx?id=214320",""],[6164,"الثمانون؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66038&r=&rc=48",""],[6164,"مشاوير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66075&r=&rc=84",""],[6190,"على سبيل الأمل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87008&r=&rc=14",""],[463,"حبستُ وأيّامُ الملوكِ كذاكا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60175&r=&rc=231",""],[6259,"فؤادي الفداءُ لها من قببْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59354&r=&rc=2",""],[6305,"وَشَيْطانٍ يُقاسِمُني نَصِيبي !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87329&r=&rc=2",""]],"verses":[["فَقَد يَنهَتِكُ الحَيُّ","وَفيهِ البيضُ وَالذُبلُ",0,"ل",1,0],["فَقَد يَحمِلُ الباغي عَلى المَوتِ نَفسَهُ","إِذَ صَفِرَت مِمّا أَرادَ وِطابُ",1,"ب",1,0],["فَقَد يَجمَعُ اللَهُ الشَتيتَينِ بَعدَما","يَظُنّانِ كُلَّ الظَنِّ أَن لا تَلاقِيا",2,"ي",2,0],["فَقَد يَشتَفي الصَبُّ السَقيمُ بِزَورَةٍ","وَيَنجو بِلَفظٍ عاثِرٌ وَأَسيرُ",3,"ر",1,0],["فَقَد يوجَدُ النَكسُ الدَنِيُّ عَنِ الهَوى","عَزوفاً وَيَصبو المَرءُ وَهوَ كَريمُ",4,"م",1,0],["فَقَد يَعصَوصِبُ الجادونَ مِنهُ","بِأَروَعِ ماجِدِ الأَعراقِ غَمرِ",5,"ر",1,0],["فَقَدْ يُخْطِيءُ الحَقَّ الصَّريحَ إذَا قَضَى","وَيَأْخُذُ بِالإِثْمِ البَرِيءَ مِنَ الإثْمِ",6,"م",1,0],["فَقَد يُصادِفُ باغي الخَيرِ حاجَتَهُ","فيها وَيَأوي إِلَيها الذِكرُ وَالحَسَبُ",7,"ب",1,0],["فقديماً لِواطُ أمّك معرو","فٌ بيحيى بن صالحٍ قد عَلِمتا",8,"ت",2,0],["فقديماً ما جاد بالمال والجا","ه وأنفُ العدو أرغم أنف",9,"ف",1,0],["فقديماً أنكرتما الحظّ والحر","مانَ لم تجرِيا على استئهالِ",10,"ل",1,0],["فقد يُسقى الرجالُ وهم رسومٌ","وقد يُرعى الرجالُ وهم سوامُ",11,"م",1,0],["فَقَد يَرجِعُ جيراني","وَتَبقى غُربَتي عَنّي",12,"ي",1,0],["فَقَد يَرى اللَهُ أَنّي قَد أُحِبُّكُمُ","حُبّاً أَقامَ جَواهُ بَينَ أَضلاعي",13,"ع",2,0],["فَقَديماً عَن وَخدِها ضاقَ وَجهُ ال","أَرضِ وَاِنقادَ بِالشِراعِ الماءُ",14,"ا",2,0],["فَقَد يُظَنُّ شُجاعاً مَن بِهِ خَرَقٌ","وَقَد يُظَنُّ جَباناً مَن بِهِ زَمَعُ",15,"ع",1,0],["فقد يُكرَمُ العِلْقُ الرخيصُ وإن غَلا","وزاد غَلاءً يُسْلَ عنه ويُستغنى",16,"ن",2,0],["فقد يعطفُ الدهرُ الأبيُّ عِنانَهُ","فيُشفَى عليلٌ أو يُبَلُّ غليلُ",17,"ل",1,0],["فَقَد يَتَغابى المَرءُ في عُظمِ مالِهِ","وَمِن تَحتِ بُردَيهِ المُغيرَةُ أَو عَمروُ",18,"ر",2,0],["فَقَديماً تَداوَلَ العُسرُ وَاليُس","رُ وَكُلٌّ قَذىً عَلى الريحِ يَطفو",19,"ف",2,0],["فَقَد يَتَعاشَرُ الأَقوامُ حيناً","بِتَلفيقِ التَصَنُّعِ وَالنِفاقِ",20,"ق",1,0],["فَقَد يَشهَدُ الفِعلُ الجَميلُ لِرَبِّهِ","كَذاكَ مَضاءُ الحَدِّ مِن شاهِدِ النَصلِ",21,"ل",1,0],["فَقَد يُقالُ عِثارُ الرِجلِ إِن عَثَرَت","وَلا يُقالُ عِثارُ الرَأيِ إِن عَثَرا",22,"ر",2,0],["فقَد يُصْمي الرَّدى في الوكدِ فَرخاً","فَيَرْتَعُ منه في لحمٍ غريضِ",23,"ض",1,0],["فَقَد يَأجُرُ اللَهُ الفَتى وَهوَ كارِهٌ","وَما الأَجرُ إِلّا أَجرُهُ وَهوَ طائِعُ",24,"ع",1,0],["فَقَدْ يَبْرَأُ الدَّاءُ الْعُضَالُ وَيَنْجَلِي","ضَبَابُ الرَّزَايَا وَالْمُسَافِرُ يَقْفُلُ",25,"ل",1,0],["فَقَد يَزيدُ السُؤالُ المَرءَ تَجرِبَةً","وَيَستَريحُ إِلى الأَخبارِ مَن يَسَلُ",26,"ل",1,0],["فقد يُضحك الحيُّ سنّ الفقيدِ","فتهتَزُّ أعظُمُه في الثرى",27,"ا",1,0],["فَقَد يُنجِزُ الوَعدَ في خُفيَةٍ","مُحِبٌّ إِذا خَشِيَ الراصِدا",28,"د",2,0],["فَقَد يَسري الغَوِيُّ إِلى مَخازٍ","بِجِنحٍ في سَحائِبَ مُنجَماتِ",29,"ت",1,0],["فَقَد يَرجِعُ القَمَرَ المُستَنيرُ","مُقتَبِلاً بَعدَ أَن يَستَسِر",30,"ر",1,0],["فَقَد يَرى أَنَّهُ باكٍ حَليفُ كَرىً","فَيَستَجِدُّ سُروراً فاقِدَ الأَلَمِ",31,"م",1,0],["فقد يظنّ شجاعاً من به خرقٌ","وقد يعدّ جباناً من به زمع",32,"ع",1,0],["فَقَدْ يَغْدرُ الْخِلُّ الْوَفِيُّ لِهَفْوَةٍ","وَيَحْلُو الرِّضَا بَعْدَ الْعَدَاوَةِ والشَّرِّ",33,"ر",1,0],["فَقَدْ يَعْدَمُ الإِنْسَانُ فِي عُقْرِ دَارِهِ","مُنَاهُ وَيَلْقَى حَظَّهُ فِي التَّطَوُّفِ",34,"ف",1,0],["فَقَدْ يُشْعَبُ الإِلْفَانِ أَدْنَاهُمَا الْهَوَى","وَيَلْتَئِمُ الضِّدَّانِ أَقْصَاهُمَا الْحِقْدُ",35,"د",1,0],["فَقَدْ يَحْسُدُ الْمَرْءُ ابْنَهُ وَهْوَ نَفْسُهُ","وَرُبَّ سِوَارٍ ضَاقَ عَنْ حَمْلِهِ الْعَضْدُ",35,"د",1,0],["فَقَدْ يَسْتَقِيمُ الأَمْرُ بَعْدَ اعْوِجَاجِهِ","وَيَرْجِعُ لِلأَوْطَانِ كُلُّ مُفَارِقِ",36,"ق",1,0],["فَقَدْ يَهْلَكُ الرِّعْدِيدُ في عُقْرِ دارِهِ","ويَنْجُو مِنَ الْحَتفِ الْكَمِيُّ الْمُشايِحُ",37,"ح",1,0],["فَقَدْ يَسْتَحِيلُ الْمَالُ حَتْفاً لِرَبِّهِ","وَتَأْتِي عَلَى أَعْقَابِهِنَّ الْمَطَامِعُ",38,"ع",1,0],["فَقَدْ يَسْتَقِيمُ الأَمْرُ بَعْدَ اعْوِجَاجِهِ","وَتَنْهَضُ بِالْمَرْءِ الْجُدُوُد الْعَوَاثِرُ",39,"ر",1,0],["فَقَدْ يَسْتَجِمُّ الْمَالُ وَالْمَجْدُ غَائِبٌ","وَقَدْ لا يَكُونُ الْمَالُ والْمَجْدُ حاضِرُ",39,"ر",1,0],["فَقَدْ يَكُونُ أَجَلُّ البِرِّ أَبْرَزَهُ","وَقَدْ يَكُونُ أَحَبُّ البِرِّ مَا لَطُفَا",40,"ف",2,0],["فقَدْ يَبْسِمُ الْبَرْقُ البَعِيدُ وَإِنَّهُ","لذُو ضَرَمٍ مُفْنٍ وَرَعْد مُرَوِّعِ",41,"ع",1,0],["فَقَدْ يَرَى الْبَصِيرُ مِنْهَا كَثَبَا","مضا لاَ يَرَاهُ الاَبْصَرُونَ بُعْدَا",42,"د",2,0],["فَقَدْ يُضَامُ قَوِيٌّ عَزَّ مَطْمَعُهُ","وَلاَ يُضَامُ ضَعِيفٌ فِيهَ مَطْمُوعُ",43,"ع",1,0],["فقد يشفى بكاءٌ من بكاءٍ","كما يشفى أليمَ الْجُرْحِ نَصْلُ",44,"ل",1,0],["فقد يتعس الجدب كوخ المقل","وتشقي الرفاهة قصر الأمير",45,"ر",1,0],["فقد يُصْمي الرّدى في الوكر فرخاً","فَيَرْتَعُ منه في لحمٍ غريض",46,"ض",1,0],["فقد يُعجِز التفكيرَ ذكرُ محاسنٍ","وقد يُخجل القرطاسَ ذِكرُ المثالب",47,"ب",1,0],["فقديماً كان غصناً","سحري النسمات",48,"ت",1,0],["فقد يحرق اللحظ المضيء ويخنق ال","ريج وترديك الثغور الدوائر",49,"ر",1,0],["فَقَد يَعدو الحَميمُ عَلى أَخيهِ","فَيَأخُذُ حَقَّهُ مِنهُ اِبنُ عَمِّه",50,"م",2,0],["فَقَد يُرى القاحِلُ مُخضَرّاً وَقَد","تَلقى أَخا الإِقتارِ يَوماً قَد نَما",51,"ا",1,0],["فَقَد يُنكِرُ الضَيمَ الكَريمُ بِسَيفِهِ","إِنِ اِسطاعَ أَو بِالشَدقَمِيَّةِ وَالرَحلِ",52,"ل",1,0],["فَقَد يُدرِكُ البَدرَ الخُسوفُ وَتَنجَلي","غَياهِبُهُ عَن نُورُهِ وَغَياطِلُه",53,"ل",2,0],["فقد ينتهي شَرُّ من لا يُخاف","إلى غايةٍ في الأَذى والعُرام",54,"م",1,0],["فقد يفلل السيف الحسام فيعدتي","كهام الشبا وهو المهنّد والعضب",55,"ب",1,0],["فَقَد يَعلَمُ الحَيُّ عِندَ الصِياحِ","بِأَنَّ العَقيلَةَ بي تُستَرُ",56,"ر",1,0],["فقد يقال هؤلاء الأوليا","بالاحتقار في السلوك أغبيا",57,"ي",2,0],["فقد يستقيم الأمر في غير أهله","وينبو غرار السيف في كف ضارب",58,"ب",1,0],["فَقَد يَجلِسُ القَومُ في أَصلِهِم","إِذا لَم يُضاموا وَإِن أَجدَبوا",59,"ب",3,0],["فقد يسل الشيف من غمده","ويخرج الدر من البحر",60,"ر",1,0],["فقد يجئ الدهر مع قسوةٍ","فيه بيومٍ لين العطفِ",61,"ف",1,0],["فَقَد يُسفرُ الإدلال عَن فجأةِ الجفا","وَيُسفر سهلُ الدعبِ عن وعرٍ صعبِ",62,"ب",1,0],["فقد يتبع الخير الكثير الذي نرى","لنا فيهما شر يسير المضرة",63,"ه",1,0],["فقد يخنقنا الترب","ولم نعشق ولم نصب",64,"ب",1,0],["فقد يكبو براكبه جواد","وليس عليه لومٌ في العثار",65,"ر",1,0],["فَقَد يُصبح الحُر الكَريم مضيعاً","وَقَد تَلعب الأَيام بِالأسد الوَرد",66,"د",1,0],["فَقَديماً رُوي لَنا","عَن ذَوي العِلم بِالأَثَر",67,"ر",1,0],["فقد يكتسي المَرءُ خَزَّ الثِّيابِ","ومِن دُونِها حالَةٌ مضنيَهْ",68,"ي",2,0],["فقد يكسِفُ المَرءَ مَنْ دونَهُ","كما يكسِفُ الشّمسَ جُرْمُ القَمَرْ",69,"ر",1,0],["فقدْ يُفسِدُ المْرءَ بعدَ الصَّلاحِ","فَسادُ الأماكِنِ والشَّرُّ يُعدِي",70,"د",2,0],["فَقَد يَقشَع الغَيمُ بَعدَ الهُطولِ","وَإِن طبَّقَ الأَرض من وَكفه",71,"ف",2,0],["فَقَد يَمنَعُ القَذُّ مِن لا يَشَحُّ","وَقَد يَهَبُ البَدَنُ مَن لا يَهَب",72,"ب",1,0],["فقديمكم يتلوه فضل حديثكم","في المكرمات فتستوى الأقدام",73,"م",1,0],["فقد يُغدق الوادي وأُولاهُ قطرةٌ","ويَجسُمُ فعلُ الرمح وهو نحيلُ",74,"ل",1,0],["فقد يخطىءُ الجَلدُ المصيبُ بغدرةٍ","وكم وألتْ من عثرةٍ قدَماكا",75,"ك",2,0],["فقديرُ زادِ المُتْرفين على الطَّوى","قِدٌّ تَناهبُه الأكُفُّ وحَنْظَلُ",76,"ل",1,0],["فقديماً طرتُ شوقاً إلى ذك","رك حالَ البعاد والانتزاح",77,"ح",1,0],["فقد يحطم الخطيُّ بعد أطرادهِ","ويأخذ عطف السيف مثل الأفاكل",78,"ل",1,0],["فَقَد يُجبَرُ العَظمُ الكَسِيرُ فَيَستَوي","وَيُولَدُ بَعدَ المَرءِ يا سَعدُ ثائِرُ",79,"ر",1,0],["فقديم صانع مصنوعه","حادث كيف يعاني طمعه",80,"ع",2,0],["فَقد يجبُرُ العَظمَ الذي هيضَ جابِرٌ","وقد يَجمَعُ الشَّملَ الذي شَتَّ جامِعُ",81,"ع",1,0],["فَقَد يَلَذُّ بشربِ الماءِ شارِبُهُ",