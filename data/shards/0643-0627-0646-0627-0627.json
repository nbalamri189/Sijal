{"poems":[[55,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[44,"أبو بحر أشد الناس منا","https://www.aldiwan.net/poem50446.html","الوافر"],[88,"أجاد مطران كعاداته","https://www.aldiwan.net/poem10857.html","السريع"],[90,"متى تطلق الأيام حرية الفكر","https://www.aldiwan.net/poem45065.html","الطويل"],[23,"ألا أبلغ أبا قيس رسولا","https://www.aldiwan.net/poem21381.html","الوافر"],[74,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[53,"فتى لم يخلق الله","https://www.aldiwan.net/poem66042.html","الهزج"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[45,"نسيت وما أنسى عتابا على الصد","https://www.aldiwan.net/poem9558.html","الطويل"],[63,"ألا غادها مخطئا أو مصيبا","https://www.aldiwan.net/poem51792.html","المتقارب"],[99,"أهاب بنا فلبينا","https://www.aldiwan.net/poem24768.html","مجزوء الوافر"],[108,"قيس ولبنى","https://www.poetsgate.com/ViewPoem.aspx?id=179551",""],[101,"الرجل الثاني","https://www.poetsgate.com/ViewPoem.aspx?id=190720",""],[124,"أناديك لو رد النداء رميم","https://www.aldiwan.net/poem49281.html","الطويل"],[374,"بما حوت الأجفان نفدي عصابة","https://www.aldiwan.net/poem4300.html","الطويل"],[409,"يسائلني من باهتدائي يستهدي","https://www.aldiwan.net/poem33949.html","الطويل"],[415,"أأحبابنا هلا سبقتم بوصلنا","https://www.aldiwan.net/poem32261.html","الطويل"],[438,"طرحنا فوق غاربها الزمانا","https://www.aldiwan.net/poem12375.html","الوافر"],[463,"تروح من وجرة الظاعنونا","https://www.aldiwan.net/poem55843.html","المتقارب"],[463,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64226","الهزج"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/61001","السريع"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100851","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89154","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91587","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81706","الطويل"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143044","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120433","المتقارب"],[5046,"أنشكو سقاما.. !","https://www.poetsgate.com/ViewPoem.aspx?id=200960",""],[5431,"تسلل ضوئي...","https://www.poetsgate.com/ViewPoem.aspx?id=202580",""],[5444,"سجن وكراسي","https://www.poetsgate.com/ViewPoem.aspx?id=205076",""],[5660,"صَليلُ السَّيفِ لا يُرجى سِواهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32089",""],[463,"قم فانتشطها حسبها أن تعقلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60286&r=&rc=342",""]],"verses":[["كَأَنّا أَنابيبُ القَناةِ يَؤُمُّها","سِنانٌ مَضى قُدماً فَأَمضى كِعابَها",0,"ب",3,0],["كَأَنّا إِذ أَتَيناهُ نَزَلنا","بِجانِبِ رَوضَةٍ رَيّا مَطيرَه",1,"ر",2,0],["كانا إِذا ما ظَهَرا مِنبَراً","حَلّا مِنَ السامِعِ في النَفسِ",2,"س",1,0],["كأنّأ أتينا والمعيشة لجّة","لنعبُرَ والأعمار جسر إلى القبر",3,"ر",1,0],["كَأَنّا إِذ نُساميكُم رِجالاً","جِمالٌ حينَ يَجتَلِدونَ جونُ",4,"ن",1,0],["كأنَّا إذا خضبت غيَّبت","في دمعِي الكفّ إلى زنده",5,"د",2,0],["كأنَّا إذ سألْناهُ","وقفنا سائلي رسْمِ",6,"م",1,0],["كَأَنّا أُسودٌ رابِضاتٌ كَأَنَّهُم","قَطيعٌ بِأَقصى السَهلِ حَيرانَ مُذئِبُ",7,"ب",1,0],["كَأَنّا أَرادَت شُكرَنا الأَرضُ عِندَهُ","فَلَم يُخلِنا جَوٌّ هَبَطناهُ مِن رِفدِ",8,"د",1,0],["كأنَّا ارتَبطنا بهِ نافراً","من الخيلِ يُفرِقُ شخصاً مَهيبا",9,"ب",2,0],["كأنا إذ تصافحنا","تعانقنا بكفينا",10,"ن",2,0],["كانا أحاديثَ للأسماع فاتِنةٍ","فأصبحا فتنةَ الأسماع والمقل",11,"ل",1,0],["كانا أميرينِ .. كانا لُعبتي خزفٍ","تقومُ دنيا .. إذا قاما .. وإنْ قعدا ..",12,"د",2,0],["كأنا الألى متنا وهل يألم الردى","سوى الحي لا الفاني فذاك سليم",13,"م",1,0],["كأنا اجتمعنا منه في ظل طائرٍ","فلا ضمَّ شكوانا ولا ضمَّ شكواهم",14,"م",1,0],["كأنا إذا ما مجلس العلم ضمنا","نكون على التحقيق في جنة الخلد",15,"د",1,0],["كأنّا أخذْنا من صُروف زَمانِنَا","أماناً ومِن جَورِ الحوادِث مَوثِقَا",16,"ق",2,0],["كَأَنَّا إِذْ قطعناهم إِليهِ","تَعَسَّفْنَا إِلى الصُّبْحِ الظَّلاما",17,"م",2,0],["كأنّا إذا أُشرعت للورود","نحطُّ إلى الماء منها سَفينا",18,"ن",2,0],["كأنّا إذ خُلقنا للتصافي","خُلقنا للقطيعة والبعادِ",19,"د",1,0],["كأنا إذ تحلقنا","أناس بزرافين",20,"ن",1,0],["كانا أثنوا ولم يعلموا","عليك عندي بالذي عابوا",21,"ب",3,0],["كأنا أمة هانت فصارت","سواء في الصعود وفي الصبوب",22,"ب",1,0],["كأنا الكل بتنا ضمن قبرٍ","فهذا منكر أم ذا نكير",23,"ر",1,0],["كَأنا استعدنا للصبا غَيرَ عائدٍ","فقوموا لنهبِ العُمرِ حَيثُ صَفا العُمر",24,"ر",1,0],["كأنَّا إذا شِدنا بُنىً لمقِيلِنا","من الخُطِّ قِلنا في بيوتٍ من الخص",25,"ص",1,0],["كانا إذا نطقا في مَشكلٍ فَتَقا","وأوضحا كلّ منطوقٍ ومسكوتِ",26,"ت",1,0],["كانا إذا نَظَما عِقداً بلفظهما","أزرى العُقود بمرجانٍ وياقوتِ",26,"ت",1,0],["كانا إذا ما أفادا أبدعا غُررا","ولم يُلمّا بمنحولٍ ومنحوتِ",26,"ت",1,0],["كانا اذا ما ذكرنا حلاه","ومدح علاه نعاطى الشمولا",27,"ل",2,0],["كأنا إذا ما الوصل يطرق بابنا","يظن حقودُ القلب بُدِّل دينُنا",28,"ن",2,0],["كأنّا ألِفنا طعنَ أشواقنا التي","تفك ثياب الصمت ليلا وتجهشُ",29,"ش",1,0],["كأنَّا اختصرنا نصفَ قرنٍ وعُشره","فعُدنا بلا قَرنٍ ، ولم نَنلِ العُشرا!",30,"ر",2,0],["كَأَنّا إِذ عَمَلنا النَّصلَ فيكُم","بَكَت فَرَحاً دِمائاً مُقلَتاهُ",31,"ا",2,0],["كأنا أقسمَ خبثُ طينها","لا يحمل الإنصافَ فيما حملا",32,"ل",2,0]]}