{"poems":[[37,"ولولا حبكم لتضاعفتني","https://www.aldiwan.net/poem39122.html","الوافر"],[32,"ألا حي المنازل بالسلام","https://www.aldiwan.net/poem29530.html","الوافر"],[82,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[48,"رآني في الكرى رجل كأني","https://www.aldiwan.net/poem22840.html","الوافر"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[197,"هل إلى سلوة وصبر سبيل","https://www.aldiwan.net/poem13106.html","الخفيف"],[2706,"","https://poetry.dctabudhabi.ae/diwan/poem/205633","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93780","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94281","الخفيف"]],"verses":[["كَأَنَّ مَغارِزَ الأَنيابِ مِنها","إِذا ما الصُبحُ نَوّرَ لِاِنفِلاقِ",0,"ق",1,0],["كَأَنَّ مَغانِيَ الأَصرامِ فيها","مُلَمَّعَةٌ مَعالِمُها بِشامِ",1,"م",1,0],["كأنّ مغاصَ الدّرّ في قعرها بَدَتْ","فرائِدُهُ أو مَنْثَراً للدراهمِ",2,"م",1,0],["كَأَنَّ مَغارِسَ اللِثَتَينِ فَجرٌ","يُعَلُّ بِماءِ عالِيَةِ الغِراسِ",3,"س",1,0],["كانَ مَغفورَ كلِّ ذنبٍ ولا ذن","بَ وَلكن بالصفحِ تمّ الصفاءُ",4,"ا",2,0],["كانَ مَغنى الوَفاء وَالبِرّ إِن حا","لَ زَمانٌ فَوُدُّه ما يَحُولُ",5,"ل",1,0],["كان مغناك للعفاة رحيبا","نبتت في رحابه الأيتام",6,"م",1,0],["كأن مغيض الماء كان لأجل أن","به تطفأ النيران حيث تسعر",7,"ر",1,0],["كان مغناطيسا وكنت حديداً","ولهذا طبعا إليه انجذبت",8,"ت",1,0]]}