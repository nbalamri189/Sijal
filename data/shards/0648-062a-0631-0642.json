/ViewPoem.aspx?id=121767",""],[1420,"احذر بني من القران العاشر","https://www.poetsgate.com/ViewPoem.aspx?id=87636",""],[5261,"رمضان الخير","https://www.poetsgate.com/ViewPoem.aspx?id=212889",""],[5277,"سرُّ المصون","https://www.poetsgate.com/ViewPoem.aspx?id=191106",""],[5358,"نطقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=201485",""],[5376,"بأيِّ الذنبِ ذاك الطفلُ يُقْتلْ","https://www.poetsgate.com/ViewPoem.aspx?id=196896",""],[5387,"مجنون ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=53112",""],[5431,"ويُقسم ثغره أن ترشِفا !!","https://www.poetsgate.com/ViewPoem.aspx?id=195229",""],[5431,"ثورة الشعب العربي..كانت وماتزال..","https://www.poetsgate.com/ViewPoem.aspx?id=195277",""],[5431,"كوننا من فجورهم بات يغلي","https://www.poetsgate.com/ViewPoem.aspx?id=196774",""],[5431,"روما وعربي مغترب....","https://www.poetsgate.com/ViewPoem.aspx?id=208557",""],[5442,"ما آذنته بينها أسماء","https://www.poetsgate.com/ViewPoem.aspx?id=114772",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5444,"عروس جرونوبل","https://www.poetsgate.com/ViewPoem.aspx?id=205530",""],[5563,"دعوها فإنَّها مأمورة","https://www.poetsgate.com/ViewPoem.aspx?id=214572",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5616,"إيضاح شعري","https://www.poetsgate.com/ViewPoem.aspx?id=204839",""],[5670,"ما العيد لولا ألفة الأحبابِ","https://www.poetsgate.com/ViewPoem.aspx?id=215241",""],[5703,"هي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=210885",""],[845,"إلى أبي تراب","https://www.poetsgate.com/ViewPoem.aspx?id=159622",""],[5895,"دُمُوع ُالأَقْصَى","https://www.poetsgate.com/ViewPoem.aspx?id=202143",""],[5897,"مساء عيد","https://www.poetsgate.com/ViewPoem.aspx?id=160574",""],[5906,"غبار أمّة","https://www.poetsgate.com/ViewPoem.aspx?id=188911",""],[5975,"إلى مجلس الجامعة العربية بعد جلسته في 16/10/2011","https://www.poetsgate.com/ViewPoem.aspx?id=80892",""],[6225,"إزالة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78009&r=&rc=95",""]],"verses":[["وترقصت ربواتها الفرحى كم","رقصت على الأفلاك أقمار السما",0,"م",2,0],["وترقَبن اسحاره حتى إذا","هبّ النسيم فجسّ نبض عليله",1,"ل",2,0],["وتَرْقُصُ حَولي أَمانٍ طِرابٌ","وأَفراحُ عُمْرٍ خَلِيٍّ سَعيدْ",2,"د",1,0],["وَتَرقُصُ رَقصَ المَواسي الحِدادِ","عَلى الجِلدِ وَالعَلَقِ الأَسحَمِ",3,"م",1,0],["وَتَرَقَّيتُ بِالحِبالِ إِلَيها","بَعدَ هَدءٍ وَغَفلَةِ البَوّابِ",4,"ب",1,0],["وَتَّرَ قَوساً وَحَسَر","إِذا رَمى الصَفَّ اِنتَثَر",5,"ر",1,0],["وترقى به إلى قابِ قَوْسَيْ","نِ وَتِلكَ السيادةُ القَعْساءُ",6,"ا",2,0],["وَتَرَقَّب مِن سَليلٍ صُنعَهُ","فَمِنَ البَيعِ قِياضٌ وَسَلَم",7,"م",1,0],["وَتَرقُبُهُ بعامِلَةٍ قَذُوفٍ","سَرِيعٍ طَرفُها قَلِقٍ قَذاها",8,"ا",3,0],["وَتَرْقَى النُّفُوسُ عَنْ سُوءِ مَا تُوحِي","إِلَيْهَا كَوَامِنُ الأحْقَاد",9,"د",1,0],["وترقوا للسماك الأعزل","وتراموا باللظى واشتعلوا",10,"ل",3,0],["وترقّصت ربواتها الفرحى كما","رقصت على الأفلاك أقمار السما",11,"م",2,0],["وتُرقص أوتار القلوب لحونُه","يُخال بها مسُ الصبَّ او جنونه",12,"ن",2,0],["وترقب فعل السماء فكم من","خائن بعد عزه صار مرغم",13,"م",1,0],["وترقص أدواحُها بهجةً","وتسجع فوق الغصونَ الطيورْ",14,"ر",1,0],["وترقُص في جوانِبه غصونٌ","كرقصٍ الغِيد مادَ بها الشّراب",15,"ب",1,0],["وترقبُ الفجرَ في الدياجي","وهل لليلِ المحبِ فجرُ",16,"ر",1,0],["وَتَرَقرُقِ الماءِ القَراح عَلى حَصى","كَالدُرِّ وَالياقوتِ وَالمَرجانِ",17,"ن",1,0],["وَترقّ مِن مبدا الأمور لغايةٍ","وَمنَ الجليّ إِلى خفيّ يشسعُ",18,"ع",1,0],["وترقُبُني عينُ البَعير كأنَّه","إذا نَظرَت عَيني إليه غَيورُ",19,"ر",1,0],["وترقيت رتبة لابن سينا","حاز فيها القواعد المنطقيه",20,"ي",2,0],["وترقص أَطراف القَنا عن جبينه","إِذا ما اعتَرى يَومَ الهياجِ أَو ادَّعى",21,"ع",2,0],["وترقص احداقا خطفت","من نور البرق أو اللهب",22,"ب",1,0],["وتُرقِلُ نحوكم نفسي وفضلي","وجثُماني ببغدادٍ مُقيمُ",23,"م",1,0],["وترقصُ الأفهام من","طربٍ إليها وارتياح",24,"ح",1,0],["وترقَّبْ من ذَروَةِ الغيبِ إِلها","ماً إلى القلبِ مُسْقِطاً إِلهاما",25,"م",2,0],["وترَقَّبْ آنَ موتي","واجْعَلِ الوصلَ خِتَامَا",26,"م",2,0],["وترقَّيْتَ بشوقٍ صاعِداً","لقِبابٍ هُنَّ خيرُ القُبَبِ",27,"ب",1,0],["وترقت إلى ثبير خطوب","شاخ تحت التراب منها ثبير",28,"ر",1,0],["وترقوا بعلمنا أوج قرب","لا يدانى وحققوا أبحاثه",29,"ث",2,0],["وَترقى كعالية السمهري","متى طاولوك بفضل تطل",30,"ل",1,0],["وَترقى أَميرلايَ بحاءٍ","لامِ راءٍ وَالغينُ عينُ غِناه",31,"ا",2,0],["وَتَرقى في عام دالٍ وَميمٍ","رُتبة لِلِّواء تَحكي صَفاه",31,"ا",2,0],["وَترقبت فُرصة مِن زَمان","طالَما عاقَني عَن المَقصود",32,"د",1,0],["وَتَرقَّى في مَصر وَهُوَ جَدير","بِالتَرقي طَريفُه وَتَليد",33,"د",1,0],["وَتَرقى إِلى أَسمى المَراتب رفعة","فَطالعك السامي بِما شئت يَسعد",34,"د",1,0],["وَتَرقب مني بِالخَديعة غَفلةً","وَإِني لَيَقظان كَثير التَجارُب",35,"ب",1,0],["وَترقَّ أَعظَم غايَة لا تَنتَهي","وَتناول الزُهرَ العليّة من علي",36,"ل",2,0],["وترقَّبَ السلم البهيج دعاته","والصلح عند أباته مقبولا",37,"ل",2,0],["وترقِّي رُتبَةٍ في العِلمِ مِن","دُونِها المِرِّيخُ بالأَعمالِ تُسنى",38,"ن",2,0],["وترّقرقت درر العيون خصْيبةً","وتدحرجت حرّى بلون العندم",39,"م",1,0],["وترقى إلى ما شاء ربك من ذرى","معال تغالي فيك عزاًّ وتفخرُ",40,"ر",1,0],["وتَرْقُدُ في نهارِكَ عن وِصالي","وقد أَفْنَيتُ فيكَ اللَّيلَ سُهْدا",41,"د",2,0],["وترقى للكمال وتعظمى في","ترق السعد في كل الدهور",42,"ر",1,0],["وترقبه العلياء من قبل آدم","إلى أن بدا كالنور من حضرة القدس",43,"س",1,0],["وترقرقت وسط الزُّجاج مدامةٌ","وتروقّت عند المزاجِ عُقارُهُ",44,"ر",2,0],["وترقَّى يبشر الملأ الأعلى","بمولًى عليه خافوا الوقوعا",45,"ع",2,0],["وترقتْ بناتُ حواءَ فيه","فتملكن بالرؤوس الصّدورا",46,"ر",2,0],["وَتَرَقَّلَت بِهِمُ مُزَمِّمَةً","مِثلَ الأَهِلَّةِ جُنَّفٌ خُزرُ",47,"ر",1,0],["وترقُّ الأطيارُ تحسبُكَ الغص","نَ إِذا ما خطرْتَ تحتَ القبابِ",48,"ب",1,0],["وترق في الايام يا ولدي","وتهاب أن تستحدث الأثما",49,"م",2,0],["وترقبوا النصر العزيز وأوبة ال","فرج القريب فربنا علام",50,"م",1,0],["وترقى مَلَكُ العز على","عرش افلاك المعالي وتلا",51,"ل",2,0],["وتَرقَ لحال في بساطِ كرامةٍ","أتاكَ بها الهادي المبين الأدِلّةِ",52,"ه",1,0],["وترقص في مُهود الكأس سكرى","بها الأطفال من قبل الفِطام",53,"م",1,0],["وترقصُ ان غنّتك في الطرق حالتي","عقيباً وقد تؤتي وأنت تهلهل",54,"ل",1,0],["وترقى الى خلافة مارون","والياس قدوة الخلفاء",55,"ا",2,0],["وترقبوا لك طلعة غراء من","قسماتها بدر الهداية يطلع",56,"ع",1,0],["وترقب آخر العمر فإن","جاءك الموت، فقد نلت المرادا",57,"د",2,0],["وترقب الطيف الملم فربما","صح المنام وصحت الأحلام",58,"م",1,0],["وترقى إلى شأو الفلاح مدارجاً","تُبلّغ آمال المجد الميمم",59,"م",1,0],["وترقب عظمى الشفاعات منه","وانتظرها فلن يضيع انتظارك",60,"ك",1,0],["وَتَرَقرَقَت عَبراتُه فَشَغَلنَهُ","عَن شُغلِهِ بِسَنا الوُجوهِ الحُسَّرِ",61,"ر",1,0],["وترقّبنا نجاحا","وهو ما كنا نريد",62,"د",1,0],["وَتَرقى إِلى ذرى الفَضل فاعجب","لِصَغير سَما عَلى الجَوزاء",63,"ا",2,0],["وترقى شأن المعارف وازدا","دت شمولاً بخيرها الفياض",64,"ض",1,0],["وترقد جفن ناظره المنايا","ويطعم ناظري طعم الرقاد",65,"د",1,0],["وترقت تتخطى القضبا","وتغني بشجي مفجع",66,"ع",1,0],["وترقت لمدح خير وزير","ذي عطاء لا يختشي الاءعسارا",67,"ر",2,0],["وترقد النفس في ظلام","يجىء من بعد ظلام",68,"م",1,0],["وَتَرَقِّيهِ فِي المَعَارِفِ أو مَا","رَامِقاً طَرفُهُ السَّمَاءَ ومَرمَى",69,"م",2,0],["وترقص أعطاف الندى طرباً به","كما تتهادى بالخلي العرائس",70,"س",1,0],["وَتَرقُصُ الأَنجُمُ الزَهراءُ رَقصَتَها","في مُطلَقٍ مِن أَثيرِ الجَوِّ مُلتَهِبِ",71,"ب",1,0],["وترقبهُ لكلّ طلوعِ فجرٍ","وترقبهُ إِذا حانَ الغيابُ",72,"ب",1,0],["وترقبهم بما يأتو","ن من خير ومن شر",73,"ر",1,0],["وترقى بسلم العلم أرَّخ","شان عبد الرحمن للجنات",74,"ت",1,0],["وترقى لأوج عرش معالٍ","دون علياه عرش كل علاء",75,"ا",2,0],["وترقى اهل علوم كان يرشدهم","واهل جذب واهل الحاء والباء",76,"ا",2,0],["وترْقصُ أطْيارُ الهوى في جفونِها","فتسْكبَ أعْسالَ اللّمى في الْفناجينِ",77,"ن",1,0],["وترقب أن تغشى المناسك فتنةٌ","تهب عليها الريح والريح صرصر",78,"ر",1,0],["وَتَرْقُصُ فِيْ شَفَتَيَّ الدُّنَى","وَيَسْكُبُ أنْغَامَهُ المُنْشِدُ",79,"د",1,0],["وَتَرْقُصُ الْمُهُجُ السَّكْرَ ى مُدَاعِبَةً","صَحْوِي تَهَادَى رُؤىً يَبْنِي لَهَا مُدُنَا",80,"ن",2,0],["وتر قديم لم يكن أحد له","كفؤاً يداني مجده حاشاه",81,"ه",1,0],["وتر قراها والبلاد تبدلت","بعد الأنيس بكل وحش نافر",82,"ر",1,0],["١٤- وترق بعد جمودها أرواحنا","وتصح بعد كسادها الأبدان",83,"ن",1,0],["وترقبُ وجهَها كلُّ المرايا","وأنظرها وروحي فيكِ سكرى",84,"ر",2,0],["وترقّبَ الوردُ الخدودَ","فبَثَّ فيهِنَّ احْمِرارَه",85,"ر",2,0],["وتَرْقُبُ امَّةٌ بالبابِ نزْفاً","بُعيدَ العرسِ منديلاً مُبَلَّلْ",86,"ل",1,0],["وترقص من سعادتنا نجومٌ","وتحزنُ باكياتٌ إن حزنَّا",87,"ن",2,0],["وترقرقت إثر اشتهائيَ دمعة","شاءت حلاوتها بألا تنشفا",88,"ف",2,0],["وترقرق الوجه الصبوح بدمعه","إذْ راح يهدر في مرابعنا الدمُ",89,"م",1,0],["وترقبْ تمخّض الفجر حتما","بازغا من تصارع الأضداد",90,"د",1,0],["وترقص في هضابٍ موحشاتٍ","ولاتخشى الأفاعيَ أن تمرّا",91,"ر",2,0],["وترقرت سحب وأومض بارق","وشدت على أوراقها ورقاء",92,"ا",2,0],["وترقرت في ساحتيك مدامع العشاق","هامية الشؤون همولا",93,"ل",2,0],["وترقص لي بُنيَّاتٌ بنهرٍ","تُطيِّب بالدنو إليَّ نفسا",94,"س",2,0],["وتَرْقُمُ لي العلومَ على سرابٍ","إذاما جئْتُهُ لم أَلْقَ شيَّا",95,"ي",2,0],["وترقّب سهم (المناخر) واحذر","فهي تصلي الأحباب حرّ جواها",96,"ا",3,0],["وترقصُ حولنا الأمواجُ نشوى","وأمواجُ الغُزاةِ على الطريقِ!",97,"ق",1,0],["وترقرقت نهرًا أضاء صفاؤه","فاعشوشبت في ضفتيهِ روابي",98,"ب",2,0],["وَترقُبُ طفلَها والليلُ يمضي","فيُذهلُ صبرُها قمرَ المساءِ",99,"ا",2,0],["وترق حتى قيل فيك دعابة","وتفح حتى يفزع التنين",100,"ن",1,0],["وَتَرَقْرَقَتْ عَيْنُ الَحبيبِ مُنادِياً","هلا أَجَبْنَا للنداءِ الآتِى",101,"ت",2,1],["وترق للعيد البهي تبثُّهُ","عطر الصفا ونسائم الإيناس",102,"س",1,0],["وَ تَرَقَّبتُ النَواحي وَ البَوادي","قَسوَةُ الأزمانِ أَغْدَتها دِثارا",103,"ر",2,0],["وترقّبوا ناراً ستحرقُ حقدَكم","والنصرُ للشرفاءِ دامَ نصابا",104,"ب",2,0],["وتِرقُّ النسمة ُ , يصفو النو رُ",", يلينُ الصمتُ ويزدهرُ",105,"ر",1,0]]}