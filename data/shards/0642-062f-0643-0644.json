{"poems":[[90,"أصبحت أوسعهم لوما وتثريبا","https://www.aldiwan.net/poem44832.html","البسيط"],[74,"يا طرس قبل راحة شمسية","https://www.aldiwan.net/poem19995.html","الكامل"],[93,"سفرت فقلت لها أهذا كوكب","https://www.aldiwan.net/poem8740.html","عموديه"],[45,"ضيف ألم برأسي غير محتشم","https://www.aldiwan.net/poem10532.html","البسيط"],[63,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[54,"قد كلمت عينه عيني فهنوني","https://www.aldiwan.net/poem26652.html","البسيط"],[52,"يا ليت لي قلبا بقلب يثيب","https://www.aldiwan.net/poem64808.html","الوافر"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140819",""],[93,"الحسن لا يشترى ولا يستجلب","https://www.poetsgate.com/ViewPoem.aspx?id=14220",""],[164,"ارضيت ربك بالعدل الذي انتشرا","https://www.aldiwan.net/poem58894.html","البسيط"],[398,"إن المحبة للوصي فريضة","https://www.aldiwan.net/poem53382.html","الكامل"],[469,"بين حزني وحسنه اليوسفي","https://www.aldiwan.net/poem3166.html","عموديه"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62543","الكامل"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111172","المتدارك"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137874",""],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101569","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109465","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3077,"","https://poetry.dctabudhabi.ae/diwan/poem/113638","المجتث"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110747","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68030","البسيط"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99312","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89109","المتدارك"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138652",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108338",""],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4767,"اضطراب","https://www.poetsgate.com/ViewPoem.aspx?id=175318",""],[5174,"أُمَّ الْبَيَانِ","https://www.poetsgate.com/ViewPoem.aspx?id=188618",""],[5397,"هلا سألت مرابعا وطلولا","https://www.poetsgate.com/ViewPoem.aspx?id=157941",""],[5785,"باهي المحيَّا شمس نصف النهار","https://www.poetsgate.com/ViewPoem.aspx?id=131580",""]],"verses":[["قد كلّفوا شططا فيها حكومتهم","وخالفوا الحزم فيها والتجاريبا",0,"ب",2,0],["قد كلّلته شفاهُ لثمٍ دائرٍ","حتَّى كأنّ اللثم فيه لثام",1,"م",1,0],["قَد كَلَّمَت قَلبي وَلَم تَرفُق بِهِ","وَاللَحظُ لَو دَرَتِ المَليحَةُ مَخلَبُ",2,"ب",1,0],["قَد كَلَّمَتها العَوالي فَهيَ كالِحَةٌ","كَأَنَّما الصابُ مَعصوبٌ عَلى اللُجُمِ",3,"م",1,0],["قد كُلَّلَتْ بنجومٍ للحَبابِ ضُحىً","فإن دَجا الليلُ عَادَتْ أنجُما شُهُبا",4,"ب",2,0],["قَد كَلَّمَت عَينُهُ عَيني فَهَنّوني","وَحَدِّثوني بِحُبٍّ لَيسَ بِالدَونِ",5,"ن",1,1],["قَد كَلَّفاني عَمَلاً خائِباً","وَعامِلُ اللَهِ الَّذي لا يَخيب",6,"ب",1,0],["قد كلمتها العوالي فهي كالحةٌ","كأنما الصاب معصورٌ على اللجم",7,"م",1,0],["قد كلمت قلبي ولم ترفق به","واللّظ لو درت المليحة مخلب",8,"ب",1,0],["قد كلم الناس في الهد المسيح وما","جرت العوائد من رب السما نكرا",9,"ر",2,0],["قَد كلَّفَ اللَهُ البَرِيَّةَ كلَّها","وَاِختارَه لِلمُؤمِنينَ وَلِيّا",10,"ي",2,0],["قدك لا لوم قد عجزت عن القو","ل وان كنت ليس يفرى فري",11,"ي",1,0],["قد كللت أشجارها بجواهر","الأزهار لا بجواهر الأحجارِ",12,"ر",1,0],["قد كلف قلبي من كمد","مالا يسطيع به ينهض",13,"ض",1,0],["قد كللت عفة النساك هامته","وبلغته مقام المجد تقواه",14,"ا",2,0],["قد كلمت أحشاي بالمقل التي","فيها الجمال مسلم ومكلم",15,"م",1,0],["قد كلمتني بعده نوب النوى","وسطت بألسنةٍ عليَّ حداد",16,"د",1,0],["قد كَلَّتِ الأَلسُنُ عَن أَوصَافِهِ","وكَم نرى في البَحرِ مِن ألطافِهِ",17,"ه",1,0],["قد كلَّ بالعذل قلبي","وملَّ سمعي مرامكْ",18,"ك",1,0],["قد كلّ صارم عزمى عن سلوكم","لما سمعتُ حديثا عنكم ونبا",19,"ب",2,0],["قَدْ كَلَّفوني لحاقَ الرَّكْبِ واظَمَئي","وكيف يَلحق إِثْرَ الركب ظمآنُ",20,"ن",1,0],["قد كللت عنبراً بالمسك ممتزجا","وطوقت جلناراً واكتست ذهبا",21,"ب",2,0],["قد كلم موسى تكليماً","عار عن حرف مذكور",22,"ر",1,0],["قد كلت الأبصار عن رتب لهم","شمخت فأصبح كل طرفٍ خاسي",23,"س",2,0],["قد كللتها هيبة فكأنها","ملك على عرش الجمال قد استوى",24,"ا",1,0],["قد كل عنك نظرا الادراك","نامى بجفني فاقصدي مناكى",25,"ك",2,0],["قد كلَّتْ كفٌّ باحثةٌ","عن حق منها يُغتصب",26,"ب",1,0],["قَدْ كَلَّ كُلُّ بَيَانِهِمْ وَغَدَتْ","أَقْلَامُهُمْ بُكْمًا وَتَنْحَسِرُ",27,"ر",1,0],["قد كلمت قلبي بطول سكوتها","فشكا لها داء الغرام دخيلا",28,"ل",2,0],["قد كل صبري منذ طويت القفار","ما في المحبة قلب صابر",29,"ر",1,0]]}