{"poems":[[65,"تجنى علينا طيفها حين أرسلا","https://www.aldiwan.net/poem46150.html","السريع"],[74,"أما ونجوم الحسن أعيى طلوعها","https://www.aldiwan.net/poem19167.html","الطويل"],[80,"أنام وما قلبي عن المجد نائم","https://www.aldiwan.net/poem14267.html","الطويل"],[68,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[54,"وسارية لا تمل البكا","https://www.aldiwan.net/poem27320.html","المتقارب"],[77,"سقتني بما مجت شفاه الأراقم","https://www.aldiwan.net/poem69041.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55093","الكامل"],[113,"سألتك ودا خالصا وترفقا","https://www.aldiwan.net/poem16684.html","الطويل"],[154,"تركنا زهيرا للبقيع فثهمد","https://www.aldiwan.net/poem68579.html","الطويل"],[170,"رعى الله عهد حبيب ظعن","https://www.aldiwan.net/poem46862.html","المتقارب"],[186,"بعزمك لذ إذا عز النصير","https://www.aldiwan.net/poem67071.html","الوافر"],[215,"مازلت أمرح في نعمى وعافية","https://www.aldiwan.net/poem46333.html","البسيط"],[234,"طوى البين عهد الوصل فهو قصير","https://www.aldiwan.net/poem51114.html","الطويل"],[240,"هل لأخي صبوة نزوع","https://www.aldiwan.net/poem31892.html","مجزوء البسيط"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[327,"بان الخليط فقلبي اليوم مختلس","https://www.aldiwan.net/poem56356.html","البسيط"],[347,"ما أنت حتى تسفكي أدمعي","https://www.aldiwan.net/poem55352.html","السريع"],[371,"لقد سالمتنا صروف الزمان","https://www.aldiwan.net/poem17175.html","المتقارب"],[396,"الزم البيت لا تخرج من البيت تندم","https://www.aldiwan.net/poem54507.html","عموديه"],[447,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[463,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[487,"ثوى الحب واستعلى وما قد رثى ليا","https://www.aldiwan.net/poem24500.html","عموديه"],[556,"من ذا الطبيب لأدوائي وأوجاعي","https://www.aldiwan.net/poem47698.html","البسيط"],[580,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54059","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38418","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38390","الرمل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145801","المتقارب"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129555","الطويل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216877","الوافر"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69227","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48947","الطويل"],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206233",""],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131545",""],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89657","الطويل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76793","البسيط"],[2019,"","https://poetry.dctabudhabi.ae/diwan/poem/177967","الطويل"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[2129,"","https://poetry.dctabudhabi.ae/diwan/poem/111094","الطويل"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124178","الوافر"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95138","البسيط"],[2216,"","https://poetry.dctabudhabi.ae/diwan/poem/100482","المتقارب"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/130001","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205841","المتقارب"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126539","السريع"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118832","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126989","الوافر"],[3596,"","https://poetry.dctabudhabi.ae/diwan/poem/98189","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91867","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91480","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216827","الكامل"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99253","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95325","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94678","الوافر"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105499","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136521",""],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35140","الطويل"],[4702,"مشوار عز","https://www.poetsgate.com/ViewPoem.aspx?id=155169",""],[4797,"الفضائيات","https://www.poetsgate.com/ViewPoem.aspx?id=50251",""],[4927,"ضياع الرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=30179",""],[5149,"سَقَتْنِي بِنَارِ الصَّدِّ","https://www.poetsgate.com/ViewPoem.aspx?id=212975",""],[5277,"سارقٌ وما هو بسارقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=215446",""],[5397,"لفرط الجوى مهجتي كامته","https://www.poetsgate.com/ViewPoem.aspx?id=157908",""],[5411,"طَوّف بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=185344",""],[5582,"هذِي مَنازِلُهُمْ هَلْ أَنْتَ تُبصِرُها","https://www.poetsgate.com/ViewPoem.aspx?id=187141",""],[5725,"صبريني","https://www.poetsgate.com/ViewPoem.aspx?id=202933",""],[5732,"لزيت نفسي مير عيت تلزا","https://www.poetsgate.com/ViewPoem.aspx?id=177849",""],[5756,"الأم","https://www.poetsgate.com/ViewPoem.aspx?id=5181",""],[5764,"حبيت أنبّه !","https://www.poetsgate.com/ViewPoem.aspx?id=159090",""],[5879,"من لي بها ..","https://www.poetsgate.com/ViewPoem.aspx?id=215464",""],[5956,"نزهات في سيارة خالية","https://www.poetsgate.com/ViewPoem.aspx?id=182419",""],[5956,"مفاتيح الدخول إلى بلادي العربية","https://www.poetsgate.com/ViewPoem.aspx?id=192786",""],[5956,"الحمد لله حمداً لا يفارقني","https://www.poetsgate.com/ViewPoem.aspx?id=193794",""],[6010,"أستاذة النحو ,,,","https://www.poetsgate.com/ViewPoem.aspx?id=175986",""],[6035,"رسالة إلى الجار ، والآخر هناك !","https://www.poetsgate.com/ViewPoem.aspx?id=176961",""],[6082,"وسط الزحام","https://www.poetsgate.com/ViewPoem.aspx?id=60245",""],[6093,"جيل من ذهب","https://www.poetsgate.com/ViewPoem.aspx?id=205227",""]],"verses":[["وأسهَرُ في مَدْحي لغَيرِكَ ضَلّةً","وأدْعو سِواكَ المُنعِمَ المُتطَوِّلا",0,"ل",2,0],["وأسهرت أجفاني وإن كنت ساهراً","ومحترقاً في الغيد لولا شموعها",1,"ع",3,0],["وَأَسهَرُ لَيلي مُفكراً غَيرَ طاعِمٍ","وَغَيري عَلى العِلّاتِ شَبعانُ نائِمُ",2,"م",1,0],["وَأَسهَرُ في نَظمِ القَوافي وَلَم أَقُل","خَليلَيَّ هَل مِن رَقدَةٍ أَستَعيرُها",3,"ر",3,0],["وَأَسهَرُ لِلمَجدِ وَالمَكرُماتِ","إِذا اِكتَحَلَت أَعيُنٌ بِالكَرى",4,"ا",1,0],["وأسْهَرَهَا جَرُّ الرّماحِ على الثرى","بأيدي فُتُوِّ الأزدِ صُفْرِ العمائم",5,"م",1,0],["وَاسْهَرْ عَلَيْهِ وَلاَ تُحَا","ذِرْ فِي أَذَاهُ مِنْ أَذَاكْ",6,"ك",1,0],["وَأَسهَرت آمالي وَأَبعدَت مَطلَبي","وَقَربت حِيني وَاِستَبحت التَفَرُقا",7,"ق",2,0],["وَأَسهَرَ فيهِ قَلبَهُ وَجفونَهُ","وَقورٌ يَوَدُّ الطَودُ مِنهُ سُكونَهُ",8,"ه",1,0],["وأسهرُ مُنتصباً في الفراش","كما انتصبَ الفِعلُ من بعدِ أَنْ",9,"ن",1,0],["وَأُسهَرُ في ظَلام الخَطب جفناً","لَهُ مِن فكرِهِ قَمَرٌ مُنيرُ",10,"ر",1,0],["وأسهر الليل في علمٍ وفي أدب","أبغى رضاءك عن قصدي وعن سنني",11,"ن",2,0],["وأسهبتَ في حمد الإله بخطبة","تَفَجَّرُ منها للصواب بحور",12,"ر",1,0],["وَأَسهُمُ البَينِ طائِشاتٌ","عَنّا وَتَيرُ النَوى وُقوعُ",13,"ع",1,0],["وآسهم بالقرب منه وبالرضا","حباهم وأسقاهم بكاس المودة",14,"ه",1,0],["وَأَسهَلُ الناسِ أَعطاناً لِمُختَبِطٍ","وَأَكثَرُ الناسِ عِيداناً إِذا حَمِسوا",15,"س",3,0],["واسهر الليل أليف الدجى","حيران دامي القلب في مضجعي",16,"ع",2,0],["وَأَسهَرتَ عَينَكَ لِلمَكرُماتِ","فَأَقرَرتَ أَعيُنَنا الهاجِدَه",17,"د",2,0],["واسهران كنت في خير وإلا فنم نم","واعلم ان الزمان اليوم جهله تحكم",18,"م",1,0],["وأسهر في نظم القوافي ولم أقل","خليلي هل من رقدةٍ أستفيدها",19,"د",3,0],["وأسهمَ ذاوي الشخص خافٍ كأنه","مع الصبح في خدِ السَّماوةِ خالُ",20,"ل",1,0],["وأسهر جفونا في الصلاة مواصلا","معاني الصلا للقلب طبا مداويا",21,"ي",2,0],["وأسهُمٍ من مقالٍ ما يحصّنُ مِن","خدوشهنّ بجلدي نسجُ أدراعي",22,"ع",2,0],["وأَسهمه في صَدِّ كلِّ مُدرّع","فما الدِّرعُ منها غيرُ بُرْدٍ مُسهَّمِ",23,"م",1,0],["وأسهل موت المرء لو صب بأسه","على جبلٍ ضخمٍ لدكدكه رضا",24,"ض",2,0],["وَأَسهر كُلَّ اللّيلِ يكرهُني الكرى","وَأَكرَههُ طَبعاً فَيَجفو كَما يجفى",25,"ف",2,0],["وَاِسهَرِ اللّيلَ وَكُن مِمَّن يَفيق","لا تَنَم وَاِترُك لَذيذَ المَرقَدِ",26,"د",1,0],["وَأسهَل ُما في العيون ِالدموع","وأصعَبُ ما في الكلام ِالرثاءُ",27,"ا",2,0],["واسهر خوفا أن يمر خياله","بعيني فتؤذي اخمصاه بأجفاني",28,"ي",1,0],["وأسهلنا وسهلُ الأرضِ يُخشى","بجُرد الخيل مُشنَقَةِ القيادِ",29,"د",1,0],["وأسهرني طول التفكّر أَنَّني","عَجِبتُ لأمر ما تُقضّى عَجائِبُه",30,"ب",2,0],["وأَسهدُ لا بدرٌ يسامر وَحدتي","ولا طلعةٌ غراءُ تَجني الأَمانيا",31,"ي",2,0],["واسهرت لين اذّن المذّن","كنّي مصوّب بالقذايف",32,"ف",1,0],["واسهره لمع برق لاح","يبدي الوجد ما يعيد",33,"د",1,0],["وَأَسهَرَني طول التَفكر إِنَّني","عَجِبت لِدَهر ما تَقضى عَجائِبُه",34,"ب",2,0],["واسهَر إِذا نامَ سارٍ وامضِ حَيثُ وَنى","وَاسمَح إِذا شَحَّ نَفساً واسرِ إِن يَقُمِ",35,"م",1,0],["وأسهر ليلي إنه عاد شائناً","عدُوُّ أخلائي الذين أُنازلُ",36,"ل",1,0],["واسهمي من حائط الأراك","ليس لمن تغشاه من حراك",37,"ك",1,0],["وأسهم فتك من لحاظ لأعين","فكم قتلت من ذي هوى وهولا يدرى",38,"ر",2,0],["وأسهدني لديك رقيم خدٍّ","فواعجبا أأسهر بالرَّقيم",39,"م",1,0],["وَأسهَرَتنيَ في ليلٍ وَفي شَعَرٍ","في لَيلةٍ من ليالي الحبِّ لَيلاءِ",40,"ا",2,0],["واسهر ليلي أعد النجوم","وخيل همومي على تجول",41,"ل",1,0],["وأسهمت فيما قد حوت جفنَةُ الندى","بني جفنَةٍ أبغي بها منهمُ السلما",42,"م",2,0],["وأسهر ليلى أناجى المنى","على طلعة القمر السافر",43,"ر",1,0],["وأسهُم الفاقه أن صوبت","فافزع له من كلها ان صبت",44,"ت",1,0],["وأسهرتمُ طرفي انتظاراً لوصلكم","وصيرتم كالجهر يا سادتي سري",45,"ي",1,0],["واسهر اعين الباغين خوفا","وقال لأعين الفيحاء قرى",46,"ر",2,0],["وأسهر الليل ذا أنس بوحشته","إذ طيب ذكرك في ظلمائه سمري",47,"ر",2,0],["وَأَسهبت سيرَها الآمالُ طالبةً","أَين القرار وَأَين الفَوز بالوَطَن",48,"ن",1,0],["وَأَسْهُمِ غَمزٍ أَحكمَ الدلُّ رميَها","لقيتُ فما أَشكو لسهمٍ مسدّد",49,"د",1,0],["واسهدْ عليه الليل سهدَ معذب","لا يملك الشكوى من المقدور",50,"ر",1,0],["وأَسهرني لما سَرَى البرقُ مَوْهِناً","حمامٌ بأَفنانِ الغصونِ له سَجْعُ",51,"ع",1,0],["وأَسهل المحفوظ نظم الشعر","لأَنه أحضر عند الذكر",52,"ر",1,0],["وأسهد مقلتي وأطال هجري","يمنّ عليَّ يوماً بالرجوعِ",53,"ع",1,0],["وأسهرت في تدبيرها منك مقلةٌ","وكم ساهر يسعى إلى غير ساهر",54,"ر",1,0],["وأسهُو فاهوى للسُجود ولم اكن","ركعتُ وقبلَ الذكر لله أقنت",55,"ت",1,0],["وَأَسهَرَني فَوقَ القَتادِ تَقَلُّبٌ","مِنَ الدَهرِ بِالأَحرارِ بالَغَ في الهَضمِ",56,"م",1,0],["واسهل من اللي جا يسلم وردّيت","يوم انّها تصعب على عكف الاشناب",57,"ب",1,0],["واسهر وشجع يمكن الي تريده","يفوز ويسمونه العالم استار",58,"ر",1,0],["وَأَسْهَرُ فِي اللَّيْلِ الْبَهِيْمِ مُرَاْقِباً","عَلَى الْمَفْرقِ الْمَعْلُوْمِ، كاَلرُّقَبَاْءِ",59,"ا",2,0],["وَأسْهَرُ لَيْلِي وَالنُّجُومُ شَوَاهِدٌ","وَأَقْضِي اللَّيَالِي بِالسِّقَامِ وَأَكْتُمُ",60,"م",1,0],["وأسهر ليلتي أدعو إلهي","بأن تحظى بأحلامٍ هنيّهْ",61,"ي",2,0],["وأسهرت عيني بستر الدجى","وعين السها تحته نائمه",62,"م",2,0],["وأسْهَبْتُ بُعْدًا في غَياهِب وحْدَتي","وَحُزْنُ المَرايا قَدْ تَطاَيرَ َرشْقا",63,"ق",2,0],["وَأَسْهَرَتْ مُقْلَتِي وَجْداً وَلا عَجَبٌ","لِمُقْلَةٍ لَمْ تَزَلْ بِالوَجْدِ تَسْهَرُها",64,"ر",3,0],["واسهريني بنزر طرفك وجدا","كي اطيق النوى بليلٍ عبوسِ",65,"س",1,0],["واسهر وعندي شنف تقل وزا","وأن لهن مع ضيقة الصدر معتاز",66,"ز",1,0],["واسهر واعذب راحة القلب بالشقا","واعيش اعاني بس يرتاح بالها",67,"ل",3,0],["واسهر انا والشاي حتى اتنبّه","واسرح معاك الين مايبرد الشاي",68,"ا",2,0],["وأسهر الليل دون الخدر معتكفا","أشكو هواي لنجم في السما تاها",69,"ا",3,0],["وأسهو في طريق ليس يسهو","يصحّيني إلى النحوِ السَّواءِ",70,"ا",2,0],["وأسهلُ للمشرّدِ أن يُولّي","لإسرائيلَ من عرَب السُّهادِ",71,"د",1,0],["وأسهر الليل أدعو الله يكلؤه","بالخيرِ عني وعن غيري مدى الزمنِ",72,"ن",1,0],["وَأَسْهِبي في (بنَاءِ الفِعْلِ) وَانْتَظِرِي","أَن (تُعْرِبَ) (الأمرَ ) مَأْسَاةٌ (وَتَبْنِيهِ)",73,"ي",2,0],["وأسهبَ الهَبُّ في إيضاح نِيّتكمْ","ليطمئنّ بأنّ الشرح مُكتملُ !",74,"ل",1,0],["واسهر اكتب الحسرات شعرا","فقد يمحو الاذى عطرُ الكلام",75,"م",1,0],["وأُسْهِبُ القولَ في شعرٍ يُطاوِعُنِي","وإنْ أردتُ اختصاراً قامَ يَخْتزِلُ",76,"ل",1,0]]}