{"poems":[[63,"تجنى علينا طيفها حين أرسلا","https://www.aldiwan.net/poem46150.html","السريع"],[72,"أما ونجوم الحسن أعيى طلوعها","https://www.aldiwan.net/poem19167.html","الطويل"],[78,"أنام وما قلبي عن المجد نائم","https://www.aldiwan.net/poem14267.html","الطويل"],[66,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[52,"وسارية لا تمل البكا","https://www.aldiwan.net/poem27320.html","المتقارب"],[75,"سقتني بما مجت شفاه الأراقم","https://www.aldiwan.net/poem69041.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55093","الكامل"],[107,"سألتك ودا خالصا وترفقا","https://www.aldiwan.net/poem16684.html","الطويل"],[148,"تركنا زهيرا للبقيع فثهمد","https://www.aldiwan.net/poem68579.html","الطويل"],[164,"رعى الله عهد حبيب ظعن","https://www.aldiwan.net/poem46862.html","المتقارب"],[180,"بعزمك لذ إذا عز النصير","https://www.aldiwan.net/poem67071.html","الوافر"],[209,"مازلت أمرح في نعمى وعافية","https://www.aldiwan.net/poem46333.html","البسيط"],[227,"طوى البين عهد الوصل فهو قصير","https://www.aldiwan.net/poem51114.html","الطويل"],[233,"هل لأخي صبوة نزوع","https://www.aldiwan.net/poem31892.html","مجزوء البسيط"],[302,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[320,"بان الخليط فقلبي اليوم مختلس","https://www.aldiwan.net/poem56356.html","البسيط"],[340,"ما أنت حتى تسفكي أدمعي","https://www.aldiwan.net/poem55352.html","السريع"],[364,"لقد سالمتنا صروف الزمان","https://www.aldiwan.net/poem17175.html","المتقارب"],[388,"الزم البيت لا تخرج من البيت تندم","https://www.aldiwan.net/poem54507.html","عموديه"],[438,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[456,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[480,"ثوى الحب واستعلى وما قد رثى ليا","https://www.aldiwan.net/poem24500.html","عموديه"],[549,"من ذا الطبيب لأدوائي وأوجاعي","https://www.aldiwan.net/poem47698.html","البسيط"],[573,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"]],"verses":[["وأسهَرُ في مَدْحي لغَيرِكَ ضَلّةً","وأدْعو سِواكَ المُنعِمَ المُتطَوِّلا",0,"ل",2,0],["وأسهرت أجفاني وإن كنت ساهراً","ومحترقاً في الغيد لولا شموعها",1,"ع",3,0],["وَأَسهَرُ لَيلي مُفكراً غَيرَ طاعِمٍ","وَغَيري عَلى العِلّاتِ شَبعانُ نائِمُ",2,"م",1,0],["وَأَسهَرُ في نَظمِ القَوافي وَلَم أَقُل","خَليلَيَّ هَل مِن رَقدَةٍ أَستَعيرُها",3,"ر",3,0],["وَأَسهَرُ لِلمَجدِ وَالمَكرُماتِ","إِذا اِكتَحَلَت أَعيُنٌ بِالكَرى",4,"ا",1,0],["وأسْهَرَهَا جَرُّ الرّماحِ على الثرى","بأيدي فُتُوِّ الأزدِ صُفْرِ العمائم",5,"م",1,0],["وَاسْهَرْ عَلَيْهِ وَلاَ تُحَا","ذِرْ فِي أَذَاهُ مِنْ أَذَاكْ",6,"ك",1,0],["وَأَسهَرت آمالي وَأَبعدَت مَطلَبي","وَقَربت حِيني وَاِستَبحت التَفَرُقا",7,"ق",2,0],["وَأَسهَرَ فيهِ قَلبَهُ وَجفونَهُ","وَقورٌ يَوَدُّ الطَودُ مِنهُ سُكونَهُ",8,"ه",1,0],["وأسهرُ مُنتصباً في الفراش","كما انتصبَ الفِعلُ من بعدِ أَنْ",9,"ن",1,0],["وَأُسهَرُ في ظَلام الخَطب جفناً","لَهُ مِن فكرِهِ قَمَرٌ مُنيرُ",10,"ر",1,0],["وأسهر الليل في علمٍ وفي أدب","أبغى رضاءك عن قصدي وعن سنني",11,"ي",1,0],["وأسهبتَ في حمد الإله بخطبة","تَفَجَّرُ منها للصواب بحور",12,"ر",1,0],["وَأَسهُمُ البَينِ طائِشاتٌ","عَنّا وَتَيرُ النَوى وُقوعُ",13,"ع",1,0],["وآسهم بالقرب منه وبالرضا","حباهم وأسقاهم بكاس المودة",14,"ه",1,0],["وَأَسهَلُ الناسِ أَعطاناً لِمُختَبِطٍ","وَأَكثَرُ الناسِ عِيداناً إِذا حَمِسوا",15,"س",3,0],["واسهر الليل أليف الدجى","حيران دامي القلب في مضجعي",16,"ي",1,0],["وَأَسهَرتَ عَينَكَ لِلمَكرُماتِ","فَأَقرَرتَ أَعيُنَنا الهاجِدَه",17,"د",2,0],["واسهران كنت في خير وإلا فنم نم","واعلم ان الزمان اليوم جهله تحكم",18,"م",1,0],["وأسهر في نظم القوافي ولم أقل","خليلي هل من رقدةٍ أستفيدها",19,"د",3,0],["وأسهمَ ذاوي الشخص خافٍ كأنه","مع الصبح في خدِ السَّماوةِ خالُ",20,"ل",1,0],["وأسهر جفونا في الصلاة مواصلا","معاني الصلا للقلب طبا مداويا",21,"ي",2,0],["وأسهُمٍ من مقالٍ ما يحصّنُ مِن","خدوشهنّ بجلدي نسجُ أدراعي",22,"ي",1,0],["وأَسهمه في صَدِّ كلِّ مُدرّع","فما الدِّرعُ منها غيرُ بُرْدٍ مُسهَّمِ",23,"م",1,0]]}