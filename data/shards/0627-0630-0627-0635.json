ها",103,"ن",3,0],["إذا صَدَفَتهُ العَينُ أبدَى تَوقَّداً","، كأنّ على متنيهِ نارَ الحباجبِ",104,"ب",1,0],["إذا صَدَّ يَوْماً ماضِغَاهُ بِجِرَّة","ٍ نَزَتْ هَامة ٌ بين اللَّهازِم كالقَبْرِ",105,"ر",1,0],["اذا صِحتُ قلتُم لم يَحنِ بعد مَوعد","تُريدون إشباعَ البُطون لمَوعد",106,"د",1,0],["إذا صدرت عن يوم موت آخر ال","حشاشة منها كان غدواً ورودها",107,"د",3,0],["إذا صَدَعْنا الدّجَى عَنّا بغُرّتِهِ،","خِلْنَا بِها قَبَساً نَجلُوهُ،قََدْ ضَرَمَا",108,"م",2,0],["إذا صار سهبا عاد ظهراً عدوه","وكان الصديق غدوة ذلك السهب",109,"ب",1,0],["إذا صَنَعَ الصَّفّارُ سُوءَاً لنَفْسِهِ،","فَلا تَحْسُدِ الصَّفّارَ سُوءَ صَنيعهِ",110,"ع",2,0],["إذا صَحّ فكرُ المرءِ فيما يَنوبُهُ","من الدّهرِ، لم يَشغَلْ، بحادثةٍ، فكرا",111,"ر",2,0],["إذ أصبحتْ صُماً عن التوبيخ","مشْعُوفة بالبارد المَسيخ",112,"خ",1,0],["إِذا صَالَ ألْقَى الرُّمحَ كُلُّ مُنَازِلٍ","وإِنْ هو دَوّي سَفّ كلُّ مُحَلِّقِ",113,"ق",1,0],["إذا صكَّتِ الحربُ امرأَ القيسِ أخَّروا","عَضَارِيطَ أَوْ كَانُوا رِعَآءَ الْدَّقَائِقِ",114,"ق",1,0],["إذا صالَ ما بأسُ الأسود الخوادر","وإنْ جادَ ما جودُ البحار الزواخرِ",115,"ر",1,0],["إذا صالَ يومَ الروعِ أوردَ قرنَهُ","موارِدَ موتٍ مالَها من مصادِرِ",116,"ر",1,0],["إذا صافَحتْهنَّ النواظرُ عاقها","شُعاعٌ يردُّ الطَّرفَ وهو كليلُ",117,"ل",1,0],["إذا صروفُ الدهر زعزعنه","صادفنَ قلبا غيرَ خفَّاقِ",118,"ق",1,0],["إذا صافحتنى أكفُّ اللئامِ","لطمتُ بهن خَدودَ الرجاءِ",119,"ا",2,0],["إِذا صاغَ مَدحاً خِلتَهُ مِن مُزَينَةٍ","وَتَحسَبُهُ مِن عُذرَةٍ حينَ يَنسُبُ",120,"ب",1,0],["إذا صغتُ مدحاً فيه حَمْحَم صاهلاً","جواديَ إعجاباً بهِ ورَغا بَكْري",121,"ي",1,0],["إِذا صالَ قالُوا هَل لَهُ مِن مُصاوِلٍ","وَإِن قالَ قالوا هَل همامٌ يُخاطِبُهْ",122,"ب",2,0],["إِذا صالَ لَم يُعدَل بِقَيسِ بنِ خالِدٍ","وَإِن قالَ لَم يُعدَل بِسَعدِ بنِ مالِكِ",123,"ك",1,0],["إِذا صَبَّحَت راياتُهُ دارَ مَعشَرٍ","عِدىً كَثُرَت أَيتامُها وَالأَرامِلُ",124,"ل",1,0],["إِذا صَدِئَت مِنهُ المَساعي جَلَوتُها","بِعارِفَةٍ مِنّي وَلِلمَجدِ صَيقَلُ",125,"ل",1,0],["إذا صافحتْ أجفانَه سِنةُ الكَرَى","نَقتْها لذكرى خَطْرةٍ فتَحيد",126,"د",1,0],["إذا صَحَّ فهمُ المرءِ صَحَّ لنفسه","يقينٌ ومِسْبار العقولِ التَّصوُّر",127,"ر",1,0],["إذا صمتَ فَرْضا صام شكرا لأنه","رآك وروضُ الفضلِ عندك يانع",128,"ع",1,0],["إذا صاحبت فاصحب عكبريا","على بذل السلام بلا طعامِ",129,"م",1,1],["إذا صحّ لي قوتي من الناس لم أبل","بما فاتني من طيبات المآكل",130,"ل",1,1],["إذا صاحبت أعمى في طريق","صحبت الشرّ في ثوب الصديق",131,"ق",1,0],["إذا صحّ لي قوتٌ وقوتٌ لعيلتي","وأجرة بيتي والسلامة في نفسي",132,"ي",1,1],["إذا صحّ لي في العقل أنّك مالكي","وأنّيَ مملوك لديك أسير",133,"ر",1,1],["إذا صرّفت مالك مستزيدا","لك الأرباح من وجه التجاره",134,"ر",2,1],["إذا صحّ لي قوت السنانير بكرة","وأجرة بيتي بعد قوتي على يسر",135,"ر",1,1],["إذا صلحا كان الصلاح له هما","وإن فسدا لم يحظ يوم معاده",136,"ه",1,0],["إذا صحّ للإنسان قوت وكسوة","وأمن ومألوف من الناس ناصح",137,"ح",1,1],["إِذا صحّ قولُ المصطفى فهو مذهبي","وَما قلتهُ مِن قبلُ فاِرموا بهِ الجُدرا",138,"ر",2,0],["إذا صرَّتِ الأقلامُ بين بنانِهِ","رأيتَ سِنانَ السَّمْهريِّ لها عبْدا",139,"د",2,0],["إذا صحتَ في شرقنا صيحةً","وقلت أرى الغربَ منا اقتربْ",140,"ب",1,1],["إذا صحّ إيمان المحب بربه","فكل قبيحٍ في الوجود جميل",141,"ل",1,0],["إذا صرخ الوابور قلت لعلني","أفوز بمنضور من الطير سانح",142,"ح",1,0],["إذا صح ما تروى فهاتيك ضرة","لمحبوبة قلبي لها الدهر منزل",143,"ل",1,0],["إذا صرخ الوابور صرخة راحلٍ","يكاد بها باب الحديد يزيزل",143,"ل",1,0],["إذا صلصل الهتاف قلت لعلهم","إلى سمع صوتي بالغرام تشوقوا",144,"ق",3,0],["إذا صحّ رأي الناس يوما فهللوا","هوى رأيهم في القاع ثم علا ظني",145,"ي",1,0],["إذا صرخ الوابور قلت لعله","بشير بوحي من سمائك ينزل",146,"ل",1,0],["إذا صلصل الهتّاف والليل هاجد","تخيلته صوتا لأمرك يصدع",146,"ع",1,0],["إذا صلصل الهتّاف أصبحت عندكم","وإن وسوس الهتاف أمسيتُم عندي",147,"د",2,0],["إذا صُغْتُ فيكَ الشعرَ خِلْتُ كأنَّني","بأعلى الثُّريا للبدورِ مُنَادِمُ",148,"م",1,0],["إذا صار حبُ الصخرِ للظبي هكذا","فكيف ومن حبِّ الشُجاعِ الغضنفرا",149,"ر",2,0],["إذا صادَمَ الأعداءَ يومَ كِفاحِه","بجُردِ المَذاكي في العريكةِ تَمْكُثُ",150,"ث",1,0],["إذا صار قلب العبد للسر معدنا","تلوح على أعطافه