ps://www.aldiwan.net/poem39741.html","الطويل"],[353,"نداماي هيا بي إلى الروضة الغنا","https://www.aldiwan.net/poem39776.html","الطويل"],[357,"أنوماً وقد بان الخليط تذوق","https://www.aldiwan.net/poem4159.html","الطويل"],[361,"أعد ذكر مصران قلبي مولع","https://www.aldiwan.net/poem68106.html","الطويل"],[369,"نهاري في عمر النوى كله جنح","https://www.aldiwan.net/poem4302.html","الطويل"],[400,"عندما يكون العتاب دليلاً على الحب","https://www.aldiwan.net/poem6750.html","عموديه"],[409,"إذا صاحبت عمرا في طريق","https://www.aldiwan.net/poem32232.html","الوافر"],[412,"وحقة مسك مِن نساء لبسته","https://www.aldiwan.net/poem44.html","الطويل"],[416,"بخلت وما طرفي عليك بخيل","https://www.aldiwan.net/poem54017.html","الطويل"],[427,"رحلة النيل","https://www.aldiwan.net/poem42147.html","عموديه"],[429,"إذا صد الحبيب فلا عتاب","https://www.aldiwan.net/poem40044.html","الوافر"],[432,"يقر لغليلم المليك بن غليلم","https://www.aldiwan.net/poem12345.html","الطويل"],[432,"يمينك في النوال وفي الكفاح","https://www.aldiwan.net/poem12349.html","الوافر"],[432,"لأية حال فيض دمعك هتان","https://www.aldiwan.net/poem12754.html","الطويل"],[437,"إذا اهتز للجدوى اهتزاز مهند","https://www.aldiwan.net/poem2498.html","الطويل"],[439,"تتبين شمل الدين أنك ناظمه","https://www.aldiwan.net/poem34869.html","الطويل"],[441,"ألا من لصب دائب المهجات","https://www.aldiwan.net/poem14439.html","الطويل"],[452,"إذا صفت المودة بين قوم","https://www.aldiwan.net/poem13623.html","الوافر"],[458,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[458,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[458,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[458,"رعت من تبالة جعدا لفيفا","https://www.aldiwan.net/poem56111.html","المتقارب"],[458,"إذا رضيت رباك عن الربيع","https://www.aldiwan.net/poem56133.html","الوافر"],[458,"تمناها بجهل الظن سعد","https://www.aldiwan.net/poem56219.html","الوافر"],[458,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[458,"لكِ الغرام وللواشي بكِ التعب","https://www.aldiwan.net/poem56274.html","البسيط"],[461,"لمن جيرة دون اللوى والشقائق","https://www.aldiwan.net/poem15088.html","الطويل"],[461,"أقول لركب كالقداح تعاقروا","https://www.aldiwan.net/poem15095.html","الطويل"],[461,"يرش كثيف الدجن حينا وتارة","https://www.aldiwan.net/poem15371.html","الطويل"],[461,"تقر بفضلك الأيام عينا","https://www.aldiwan.net/poem15403.html","الوافر"],[461,"تضمن منه حبوة المجد راسيا","https://www.aldiwan.net/poem15636.html","الطويل"],[461,"أبى الهم أن يعتاد صدري وناصري","https://www.aldiwan.net/poem15917.html","الطويل"],[461,"هنيئا للمواسم والتهاني","https://www.aldiwan.net/poem15924.html","الوافر"],[461,"ولما تلاقينا وللشوق سورة","https://www.aldiwan.net/poem15931.html","الطويل"],[464,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[464,"أشاقك برق بالشآم يشام","https://www.aldiwan.net/poem3487.html","عموديه"],[468,"قد قلت للقائل لا تنبسط","https://www.aldiwan.net/poem59720.html","السريع"],[477,"أضر بعيني دمعها وانسكابه","https://www.aldiwan.net/poem15358.html","الطويل"],[479,"الموت درس وعزرائيل ملقيه","https://www.aldiwan.net/poem36869.html","البسيط"],[479,"يا علوة ما كان ظني أن أجزى","https://www.aldiwan.net/poem37875.html","الطويل"],[515,"أمالي من عذولكم عذير","https://www.aldiwan.net/poem12131.html","الوافر"],[538,"يا حسرتي يا حسرتي","https://www.aldiwan.net/poem48262.html","عموديه"],[551,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[551,"رأيتكم تجنون ما قد غرستم","https://www.aldiwan.net/poem47392.html","الطويل"],[551,"لغير الغواني ما تجن الأضالع","https://www.aldiwan.net/poem47726.html","الطويل"],[562,"إذا رمت نظم الشعر في مدح ذي الرشد","https://www.aldiwan.net/poem52781.html","الطويل"],[562,"قفا بين الثنية والمصلى","https://www.aldiwan.net/poem52929.html","الوافر"],[562,"إن قلت ويحك فافعل أيها الرجل","https://www.aldiwan.net/poem52932.html","البسيط"],[564,"عيون من السحر المبين تبين","https://www.aldiwan.net/poem899.html",""],[567,"رضا المتجني غاية ليس تدرك","https://www.aldiwan.net/poem69559.html","الطويل"],[569,"إذا صحبتني من أناس ثعالب","https://www.aldiwan.net/poem52020.html","الطويل"],[575,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[575,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[575,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"],[586,"فيا خاتم الرسل الكرام ومن به","https://www.aldiwan.net/poem17570.html","الطويل"]],"verses":[["إِذا صالَ بِالجَهلِ قَلبُ الجَهو","لِ فَاِعذِر فَما كُلُّ جَهلٍ لَمَم",0,"م",1,0],["إِذا صَحِبوا الدَمَ في الباتِراتِ","فَلا صَحِبوا ماءَهُم في الأَدَم",0,"م",1,0],["إِذا صالَ قُلنا أَجمَعَ اللَيثُ وَثبَةً","وَإِن جادَ قُلنا مَدَّ مِن مِصرَ نيلُها",1,"ل",3,0],["إِذا صاحَ في أَعقابِها أَطرَدَت لَهُ","ثَوانِيَ بِالأَعناقِ طَردَ الوَسايِقِ",2,"ق",1,0],["إِذا صَفَحَت عَنكَ اللَيالي وَأُغرِيَت","بِحِفظِكَ فينا هانَ كُلُّ مُضَيَّعِ",3,"ع",1,0],["إِذا صارَعَتهُ الريحُ خِلنا شَعاعَها","يُشيرُ إِلى الوُرّادِ وَالرَكبُ هاجِعُ",4,"ع",1,0],["إِذا صَدِئَ القَومُ لا يَصدَأونَ","كَأَنَّهُمُ الذَهَبُ الأَحمَرُ",5,"ر",1,0],["إِذا صَلصَلَت بَينَ القَنا قَضَتِ القَنا","وَإِن زَفَرَت بِالسَردِ قَطَّعَتِ السَردا",6,"د",2,0],["إِذا صابَ الحَيا بِبِلادِ ضَيمٍ","جَلَوا عَنهُنَّ وَاِنتَجَعوا بِلادا",7,"د",2,0],["إذا صافَحَتْها الرّيحُ طابَتْ لأنّها","بمنزِلةٍ ناجَتْ ثَراها ذُيولُها",8,"ل",3,0],["إذا صلَحَتْ لهُ حالٌ فأهوِنْ","عليهِ بأنْ يعُمَّهُمُ الفَسادُ",9,"د",1,0],["إذا صَفَحَتْ غُدْرانَهُ الرّيحُ خِلْتَها","تُدَرِّجُ أثْراً في غِرارِ حُسامِ",10,"م",1,0],["إذا صيحَ بالأمجادِ أقْمَأَ شَخْصَهُ","وإنْ زَأرَ الضِّرغامُ في غابِهِ ثَغا",11,"غ",2,0],["إذا صَحا عاوَدَتْهُ نَشْوَةٌ فَثَنى","يَداً على أسْحَمِ السِّرْبالِ نَشّاجِ",12,"ج",1,0],["إذا صِيحَ بالشَّعْواءِ في الحَيِّ أُسْرِجَتْ","نَزائِعُ مَعْصوبٌ بأعْرافها النَّصْرُ",13,"ر",1,0],["إذا صرَفْتَ نحْوَ وجْهٍ حسَنٍ","طَرْفَكَ واسْتَهْواكَ للحِينِ الطّمعْ",14,"ع",1,1],["إِذا صاحِبا وَصلٍ بِحَبلٍ تَجاذَبا","فَمُلَّ قُواهُ أُوهِنَ الحَبلُ فَانقَطَع",15,"ع",1,0],["إِذا صاحَ لَبّاهُ القَضاءُ وَأَسرَعَت","إِلى بابِهِ الأَيّامُ وَالناسُ خُشَّعُ",16,"ع",1,0],["إِذا صابَتنِيَ الجُلّى","تَجَلَّت عَن فَتىً أَروَع",17,"ع",1,0],["إِذا صَمَدَت حُمَيّاها أَريب","مِنَ الفِتيانِ خِلتَ بِهِ جُنونا",18,"ن",2,0],["إِذا صَوَّحَ الهَيفُ السَفا لَعِبَت بِهِذ","صَبا الحافَةِ اليُمنى جَنوبٌ شِمالُها",19,"ل",3,0],["إِذا صَكَّها الحادي كَما صَكَّ أَقَدَحٌ","تَقلَقلَنَ في كَفِّ الخَليعِ المُشارِكِ",20,"ك",1,0],["إِذا صَمَحَتنا الشَمسُ كَانَ مَقيلَنا","سَماوَةُ بَيتٍ لَم يُرَوَّق لَهُ سِترُ",21,"ر",1,0],["إذ أصبحوا كبني الأعيان تجمعهم","لله وحدنهم في كل مُطَّلَب",22,"ب",1,0],["إِذا صَدَعَ البَينُ الجَميعَ وَحاوَلَت","بِقُوٍّ شَماليلُ النَوى أَن تَبَدَّدا",23,"د",2,0],["إِذا صُبَّ ما في القَعبِ فَاِعلَم بِأَنَّهُ","دَمُ الشَيخِ فَاِشرَب مِن دَمِ الشَيخِ أَو دَعا",24,"ع",2,0],["إِذا صَقَلوا سَيفاً ضَرَبنا بِنَصلِهِ","وَعادَ إِلَينا جَفنُهُ وَحَمائِلُه",25,"ل",2,0],["إِذا صُفِّقَت يَوماً لِأَربابِ رَبِّها","سَمِعتَ لَها مِن واكِفِ العُطبِ واشِلا",26,"ل",2,0],["إذا صدرت عنها رفاق برزقهم","تعود رفاق بعدهم فتعيدها",27,"د",3,0],["إِذا صُلتُ يَوماً لَم أَجِد لي مُصاوِلاً","وَإِن قُلتُ قَولاً لَم أَجِد مَن يُقاوِلُ",28,"ل",1,0],["إذا صاولته سيوفُ العدى","فما ضرَّه الشانئُ الأبتر",29,"ر",1,0],["إذ أصحبُ الدهرَ مغترّاً بصحبته","إذا أعارَ متاعاً خِلْتُهُ وهَبَا",30,"ب",2,0],["إذا صَبتْ زُهْرتُه صبوةً","قال لها هِرمسُه هَندِس",31,"س",1,0],["إِذا صَخِبَ الحادي عَلَيهِنَّ بَرَّزَت","بَعيدَةُ ما بَينَ المَشافِرِ وَالعَجبِ",32,"ب",1,0],["إِذا صَدَرَت عَنهُ حَمامٌ تَرَكنَهُ","لِوِردِ قَطاً يَسقي فُرادى وَتَوأَما",33,"م",2,0],["إِذا صالَ أَضحى أَفرَسُ القَومِ أَميَلاً","وَإِن قالَ أَضحى أَفصَحُ القَومِ أَخرَسا",34,"س",2,0],["إذْ أَصبحَ النَّبْعُ الجَميعُ","يسيرُ في وادي الأَلَمْ",35,"م",1,0],["إِذا صَغُرَتْ نفسُ الفتى كانَ شوقُهُ","صغيراً فلم يتعبْ ولم يتجشَّمِ",36,"م",1,1],["إِذا صُعِقَ الجبَّارُ تَحْتَ قُيُودِهِ","يُصيخُ لأوجاعِ الحَيَاةِ ويَفْهَمُ",37,"م",1,0],["اذا صح تشبيهي الحياة بدوحة","فما انا الا بعض اغصانها الجرد",38,"د",1,1],["إذا صيحة من بيت جاري تعتلي","وأخرى وأخرى صوتهن يهول",39,"ل",1,0],["إذا صِبا المرء ولى غير مرتجع","فما له بالتصابي لا يودعه",40,"ع",2,0],["إذا صال لاقى ضيغم القوم ضيغما","له في نفوس الشانئين زئير",41,"ر",1,0],["إِذا صُبَّ حاميها عَلى السُفنِ اِنثَنَت","وَغانِمُها الناجي فَكَيفَ المُخَيَّبُ",42,"ب",1,0],["إِذا صَعَدَت فَالسَيفُ أَبيَضُ خاطِفٌ","وَإِن نَزَلَت فَالنارُ حَمراءُ تَلهَبُ",42,"ب",1,0],["إِذا صَعِدتَ إِلى ذا مالَ ذا رَهَباً","وَإِن صَعِدتَ إِلى ذا مالَ ذا رَهَبا",43,"ب",2,0],["إِذا صَرَفَ النَهارُ الضَوءَ عَنهُم","دَجا لَيلانِ لَيلٌ وَالغُبارُ",44,"ر",1,0],["إِذا صَديقٌ نَكِرتُ جانِبَهُ","لَم تُعيِني في فِراقِهِ الحِيَلُ",45,"ل",1,0],["إِذا صُلتُ لَم أَترُك مَصالاً لِصائِلٍ","وَإِن قُلتُ لَم أَترُك مَقالاً لِعالِمِ",46,"م",1,0],["إِذا صالَ روَّى السُّمْرَ غيرَ مراقبٍ","وإنْ قال أمضَى الحُكْمَ غيرَ مُواربِ",47,"ب",1,0],["إِذا صَدَرَت عَن يَومِ مَوتٍ بِآخِرِ ال","حُشاشَةِ مِنها كانَ غَدواً وُرودُها",48,"د",3,0],["إِذا صُبَّ مُسوَدُّهُ في الزُجا","جِ فَكَأسُ النَديمِ بِهِ مَحبَرَه",49,"ر",2,0],["إِذا صَدَعنا الدُجى عَنّا بِغُرَّتِهِ","خِلنا بِها قَبَساً نَجلوهُ أَو ضَرَما",50,"م",2,0],["إِذا صاحَ سالَت لَهُ مَخطَةٌ","عَلى العودِ وَاِنقَلَعَت بَلغَمَه",51,"م",2,0],["إِذا صَنَعَ الصَفّارُ سوءً لِنَفسِهِ","فَلا تَحسُدِ الصَفّارَ سوءَ صَنيعِهِ",52,"ع",2,0],["إِذا صَوَّتَ الحادي بِهِنَّ تَقاذَفَت","تَسامى بِأَعناقٍ وَأَيدٍ خَوانِفِ",53,"ف",1,0],["إِذا صُحبَتي مالَ الكَرى بِرُؤوسِهِم","جَعَلتَ السُرى مِنّي لِأَعيُنِهِم كُحلا",54,"ل",2,0],["إذا صلَّتْ بها أوقاتُ فَرضٍ","جِباهُ الشَّربِ عَطَّرتِ الجِباها",55,"ا",3,0],["إذا صاحبٌ عني تَولَّى تَركُته","على طبعِه في العُذرِ فالعُذرُ أملَكُ",56,"ك",1,0],["إذا صَغُرَتْ يوماً رَزِيَّةُ صاحبٍ","بصاحِبه كانت رَزيَّتُكَ الكُبرى",57,"ر",2,0],["إذا صَدَرَتْ عن الأجسادِ خِيلَتْ","مُضمَّخَةَ الصُّدورِ منَ الجِسادِ",58,"د",1,0],["إِذا صَدَفَتهُ العَينُ أَبدى تَوَقُّداً","كَأَنَّ عَلى مَتنَيهِ نارَ الحُباحِبِ",59,"ب",1,0],["إذا صاحَ بي أمرٌ من اللّه صيحةً","رجعتُ ورائي والحبيبُ أمامي",60,"ي",1,0],["إذا صرْصرُ الأرواحِ أغْشَتْهُ صَرَّها","شَوَى الوجْهَ منها حرُّهُ باحْتدامِهِ",61,"م",2,0],["إذا صُبَّ ماءٌ على صرفها","رأيتَ لهُ غَوْصَةً في اللهيبِ",62,"ب",1,0],["إِذا صَدَرَت عَنهُ الأَعاجِمُ كُلُّها","فَأَوَّلُ مَن يُروى بِهِ بَعدَها الأَزدُ",63,"د",1,0],["إِذَا صُلْتُ فَدَّتْنِي فِرَاسٌ بِشَيْخِهَا","وَإِنْ قُلْتُ حَيَّانِي شَبِيبٌ وَأَكْثَمُ",64,"م",1,0],["إذا صقلَتْ ريحُ الصَّبا متنَهُ أتت","تفرِّكُ ثوباً مُذْهباً ومفضَّضا",65,"ض",2,0],["إذا صدمت صُمَّ الخُطوبِ تَطَايرتْ","لدى الصّدمةِ الأُولى شَعاعاً مُبدَّدا",66,"د",2,0],["إِذا صاحتا بِالجَيشِ تَستَنجِدانهِ","تَنصّلَ مُورِيهِ وَأَجفلَ هارِبُهْ",67,"ب",2,0],["إِذا صاحَ لَم يُخذَل وَجاوَبَ صَوتَهُ","حَماشُ الشَوى يَصدَحنَ مِن كُلِّ مَصدَحِ",68,"ح",1,0],["إِذا صَكَّ وَسطَ القَومِ رَأسَكَ صَكَّةً","يَقولُ لَهُ النادي مَلَكتَ فَأَسجِحِ",68,"ح",1,0],["إِذا صَرَّ يَوماً ماضِغاهُ بِجِرَّةٍ","نَزَت هامَةٌ فَوقَ اللَهازِمِ كَالقَبرِ",69,"ر",1,0],["إذا صُلْتَ لم يَكُرمْ على السيْفِ سيّدٌ","وإن قلتَ لم يُقْدِمْ على النطق مِصْقَع",70,"ع",1,0],["إِذا صَهَلَت أُمّاتُهُ حَنَّ أَيرُهُ","لَهُنَّ فَكانَت مَحجَةٌ وَسِفادُ",71,"د",1,0],["إِذا صَاحَبتَ في أَيّامِ بُؤسٍ","فَلا تَنسَ المَوَدَّةَ في الرَخاءِ",72,"خ",3,1],["إِذا صَغَّرَ اِسماً حاسِدوكَ فَلا تُرَع","لِذَلِكَ وَالدُنيا بِسَعدِكَ تَفغَرُ",73,"ر",1,1],["إِذا صَحَّ فِكرُ المَرءِ فَما يَنوبُهُ","مِنَ الدَهرِ لَم يَشغَل بِحادِثَةٍ فِكرا",74,"ر",2,0],["إِذا صَفَتِ النَفسُ اللَجوجُ فَإِنَّما","تُعاني مِنَ الجُثمانِ شَرَّ المَحابِسِ",75,"س",1,1],["إِذا صَلَّوا فَصَلِّ وَعِفَّ وَاِبذُل","زَكاتَكَ وَاِجتَنِب قالاً وَقيلا",76,"ل",2,0],["إِذا صَقَلَت دُنياكَ مِرآةَ عَقلِها","أَرتكَ جَزيلَ الأَمرِ غَيرَ جَزيلِ",77,"ل",1,1],["إذا صَالَتْ فأنْتَ لها يَمِينٌ","وإنْ نَطَقَتْ فأنتَ لها لِسانُ",78,"ن",1,0],["إِذ أَصعَدَت عامِرٌ لا شَيءَ يَحسِبُهُم","حَتّى يَروا دُونَهُم هَضباً وأَنوالا",79,"ل",2,0],["\"إذا صعدت إلى ذا، مال ذا رهباً","وإن صعدت إلى ذا، مال ذا رغبا\"",80,"ب",2,0],["إذا صلت لم أترك مصالاً لفاتكٍ","وإن قلت لم أترك مقالاً لعالم",81,"م",1,0],["إذا صَدَرَتْ وُرَّادُهم 