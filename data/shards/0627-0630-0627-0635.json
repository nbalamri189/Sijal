ps://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[106,"وطن ينادي أهله!","https://www.poetsgate.com/ViewPoem.aspx?id=179349",""],[66,"لئن ثلمتْ حدّي صُروفُ النّوائبِ","https://www.poetsgate.com/ViewPoem.aspx?id=3074",""],[22,"إذا قُلْتُ أَنِّي آيبٌ أَهْلَ بَلْدَة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19751",""],[90,"سبيل الجَماهير","https://www.poetsgate.com/ViewPoem.aspx?id=178923",""],[45,"سواي مرجي سلوة أو مريدها","https://www.poetsgate.com/ViewPoem.aspx?id=32953",""],[45,"بِالله أَولَى يَمِيناً بَرّةً، قَسَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=32080",""],[45,"قَليلٌ لهَا أنّي بِهَا مُغرَمٌ صَبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=31583",""],[45,"تُرَى اللّيلُ يَقضِي عُقبَةً من هَزِيعِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31215",""],[46,"أيا سارِحاً في الجَوّ، دُنياكَ مَعدِنٌ","https://www.poetsgate.com/ViewPoem.aspx?id=20146",""],[51,"هل لي على الأيام من صَرِيخ","https://www.poetsgate.com/ViewPoem.aspx?id=27431",""],[101,"غداً في سَماءِ الْعبْقَرِيَّة ِ نلتقي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62443&r=&rc=35",""],[30,"أَقُولُ لِنَفْسِي وَاقِفاً عنْدَ مُشْرِفٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20517&r=&rc=11",""]],"verses":[["إِذا صالَ بِالجَهلِ قَلبُ الجَهو","لِ فَاِعذِر فَما كُلُّ جَهلٍ لَمَم",0,"م",1,0],["إِذا صَحِبوا الدَمَ في الباتِراتِ","فَلا صَحِبوا ماءَهُم في الأَدَم",0,"م",1,0],["إِذا صالَ قُلنا أَجمَعَ اللَيثُ وَثبَةً","وَإِن جادَ قُلنا مَدَّ مِن مِصرَ نيلُها",1,"ل",3,0],["إِذا صاحَ في أَعقابِها أَطرَدَت لَهُ","ثَوانِيَ بِالأَعناقِ طَردَ الوَسايِقِ",2,"ق",1,0],["إِذا صَفَحَت عَنكَ اللَيالي وَأُغرِيَت","بِحِفظِكَ فينا هانَ كُلُّ مُضَيَّعِ",3,"ع",1,0],["إِذا صارَعَتهُ الريحُ خِلنا شَعاعَها","يُشيرُ إِلى الوُرّادِ وَالرَكبُ هاجِعُ",4,"ع",1,0],["إِذا صَدِئَ القَومُ لا يَصدَأونَ","كَأَنَّهُمُ الذَهَبُ الأَحمَرُ",5,"ر",1,0],["إِذا صَلصَلَت بَينَ القَنا قَضَتِ القَنا","وَإِن زَفَرَت بِالسَردِ قَطَّعَتِ السَردا",6,"د",2,0],["إِذا صابَ الحَيا بِبِلادِ ضَيمٍ","جَلَوا عَنهُنَّ وَاِنتَجَعوا بِلادا",7,"د",2,0],["إذا صافَحَتْها الرّيحُ طابَتْ لأنّها","بمنزِلةٍ ناجَتْ ثَراها ذُيولُها",8,"ل",3,0],["إذا صلَحَتْ لهُ حالٌ فأهوِنْ","عليهِ بأنْ يعُمَّهُمُ الفَسادُ",9,"د",1,0],["إذا صَفَحَتْ غُدْرانَهُ الرّيحُ خِلْتَها","تُدَرِّجُ أثْراً في غِرارِ حُسامِ",10,"م",1,0],["إذا صيحَ بالأمجادِ أقْمَأَ شَخْصَهُ","وإنْ زَأرَ الضِّرغامُ في غابِهِ ثَغا",11,"غ",2,0],["إذا صَحا عاوَدَتْهُ نَشْوَةٌ فَثَنى","يَداً على أسْحَمِ السِّرْبالِ نَشّاجِ",12,"ج",1,0],["إذا صِيحَ بالشَّعْواءِ في الحَيِّ أُسْرِجَتْ","نَزائِعُ مَعْصوبٌ بأعْرافها النَّصْرُ",13,"ر",1,0],["إذا صرَفْتَ نحْوَ وجْهٍ حسَنٍ","طَرْفَكَ واسْتَهْواكَ للحِينِ الطّمعْ",14,"ع",1,1],["إِذا صاحِبا وَصلٍ بِحَبلٍ تَجاذَبا","فَمُلَّ قُواهُ أُوهِنَ الحَبلُ فَانقَطَع",15,"ع",1,0],["إِذا صاحَ لَبّاهُ القَضاءُ وَأَسرَعَت","إِلى بابِهِ الأَيّامُ وَالناسُ خُشَّعُ",16,"ع",1,0],["إِذا صابَتنِيَ الجُلّى","تَجَلَّت عَن فَتىً أَروَع",17,"ع",1,0],["إِذا صَمَدَت حُمَيّاها أَريب","مِنَ الفِتيانِ خِلتَ بِهِ جُنونا",18,"ن",2,0],["إِذا صَوَّحَ الهَيفُ السَفا لَعِبَت بِهِذ","صَبا الحافَةِ اليُمنى جَنوبٌ شِمالُها",19,"ل",3,0],["إِذا صَكَّها الحادي كَما صَكَّ أَقَدَحٌ","تَقلَقلَنَ في كَفِّ الخَليعِ المُشارِكِ",20,"ك",1,0],["إِذا صَمَحَتنا الشَمسُ كَانَ مَقيلَنا","سَماوَةُ بَيتٍ لَم يُرَوَّق لَهُ سِترُ",21,"ر",1,0],["إذ أصبحوا كبني الأعيان تجمعهم","لله وحدنهم في كل مُطَّلَب",22,"ب",1,0],["إِذا صَدَعَ البَينُ الجَميعَ وَحاوَلَت","بِقُوٍّ شَماليلُ النَوى أَن تَبَدَّدا",23,"د",2,0],["إِذا صُبَّ ما في القَعبِ فَاِعلَم بِأَنَّهُ","دَمُ الشَيخِ فَاِشرَب مِن دَمِ الشَيخِ أَو دَعا",24,"ع",2,0],["إِذا صَقَلوا سَيفاً ضَرَبنا بِنَصلِهِ","وَعادَ إِلَينا جَفنُهُ وَحَمائِلُه",25,"ل",2,0],["إِذا صُفِّقَت يَوماً لِأَربابِ رَبِّها","سَمِعتَ لَها مِن واكِفِ العُطبِ واشِلا",26,"ل",2,0],["إذا صدرت عنها رفاق برزقهم","تعود رفاق بعدهم فتعيدها",27,"د",3,0],["إِذا صُلتُ يَوماً لَم أَجِد لي مُصاوِلاً","وَإِن قُلتُ قَولاً لَم أَجِد مَن يُقاوِلُ",28,"ل",1,0],["إذا صاولته سيوفُ العدى","فما ضرَّه الشانئُ الأبتر",29,"ر",1,0],["إذ أصحبُ الدهرَ مغترّاً بصحبته","إذا أعارَ متاعاً خِلْتُهُ وهَبَا",30,"ب",2,0],["إذا صَبتْ زُهْرتُه صبوةً","قال لها هِرمسُه هَندِس",31,"س",1,0],["إِذا صَخِبَ الحادي عَلَيهِنَّ بَرَّزَت","بَعيدَةُ ما بَينَ المَشافِرِ وَالعَجبِ",32,"ب",1,0],["إِذا صَدَرَت عَنهُ حَمامٌ تَرَكنَهُ","لِوِردِ قَطاً يَسقي فُرادى وَتَوأَما",33,"م",2,0],["إِذا صالَ أَضحى أَفرَسُ القَومِ أَميَلاً","وَإِن قالَ أَضحى أَفصَحُ القَومِ أَخرَسا",34,"س",2,0],["إذْ أَصبحَ النَّبْعُ الجَميعُ","يسيرُ في وادي الأَلَمْ",35,"م",1,0],["إِذا صَغُرَتْ نفسُ الفتى كانَ شوقُهُ","صغيراً فلم يتعبْ ولم يتجشَّمِ",36,"م",1,1],["إِذا صُعِقَ الجبَّارُ تَحْتَ قُيُودِهِ","يُصيخُ لأوجاعِ الحَيَاةِ ويَفْهَمُ",37,"م",1,0],["اذا صح تشبيهي الحياة بدوحة","فما انا الا بعض اغصانها الجرد",38,"د",1,1],["إذا صيحة من بيت جاري تعتلي","وأخرى وأخرى صوتهن يهول",39,"ل",1,0],["إذا صِبا المرء ولى غير مرتجع","فما له بالتصابي لا يودعه",40,"ع",2,0],["إذا صال لاقى ضيغم القوم ضيغما","له في نفوس الشانئين زئير",41,"ر",1,0],["إِذا صُبَّ حاميها عَلى السُفنِ اِنثَنَت","وَغانِمُها الناجي فَكَيفَ المُخَيَّبُ",42,"ب",1,0],["إِذا صَعَدَت فَالسَيفُ أَبيَضُ خاطِفٌ","وَإِن نَزَلَت فَالنارُ حَمراءُ تَلهَبُ",42,"ب",1,0],["إِذا صَعِدتَ إِلى ذا مالَ ذا رَهَباً","وَإِن صَعِدتَ إِلى ذا مالَ ذا رَهَبا",43,"ب",2,0],["إِذا صَرَفَ النَهارُ الضَوءَ عَنهُم","دَجا لَيلانِ لَيلٌ وَالغُبارُ",44,"ر",1,0],["إِذا صَديقٌ نَكِرتُ جانِبَهُ","لَم تُعيِني في فِراقِهِ الحِيَلُ",45,"ل",1,0],["إِذا صُلتُ لَم أَترُك مَصالاً لِصائِلٍ","وَإِن قُلتُ لَم أَترُك مَقالاً لِعالِمِ",46,"م",1,0],["إِذا صالَ روَّى السُّمْرَ غيرَ مراقبٍ","وإنْ قال أمضَى الحُكْمَ غيرَ مُواربِ",47,"ب",1,0],["إِذا صَدَرَت عَن يَومِ مَوتٍ بِآخِرِ ال","حُشاشَةِ مِنها كانَ غَدواً وُرودُها",48,"د",3,0],["إِذا صُبَّ مُسوَدُّهُ في الزُجا","جِ فَكَأسُ النَديمِ بِهِ مَحبَرَه",49,"ر",2,0],["إِذا صَدَعنا الدُجى عَنّا بِغُرَّتِهِ","خِلنا بِها قَبَساً نَجلوهُ أَو ضَرَما",50,"م",2,0],["إِذا صاحَ سالَت لَهُ مَخطَةٌ","عَلى العودِ وَاِنقَلَعَت بَلغَمَه",51,"م",2,0],["إِذا صَنَعَ الصَفّارُ سوءً لِنَفسِهِ","فَلا تَحسُدِ الصَفّارَ سوءَ صَنيعِهِ",52,"ع",2,0],["إِذا صَوَّتَ الحادي بِهِنَّ تَقاذَفَت","تَسامى بِأَعناقٍ وَأَيدٍ خَوانِفِ",53,"ف",1,0],["إِذا صُحبَتي مالَ الكَرى بِرُؤوسِهِم","جَعَلتَ السُرى مِنّي لِأَعيُنِهِم كُحلا",54,"ل",2,0],["إذا صلَّتْ بها أوقاتُ فَرضٍ","جِباهُ الشَّربِ عَطَّرتِ الجِباها",55,"ا",3,0],["إذا صاحبٌ عني تَولَّى تَركُته","على طبعِه في العُذرِ فالعُذرُ أملَكُ",56,"ك",1,0],["إذا صَغُرَتْ يوماً رَزِيَّةُ صاحبٍ","بصاحِبه كانت رَزيَّتُكَ الكُبرى",57,"ر",2,0],["إذا صَدَرَتْ عن الأجسادِ خِيلَتْ","مُضمَّخَةَ الصُّدورِ منَ الجِسادِ",58,"د",1,0],["إِذا صَدَفَتهُ العَينُ أَبدى تَوَقُّداً","كَأَنَّ عَلى مَتنَيهِ نارَ الحُباحِبِ",59,"ب",1,0],["إذا صاحَ بي أمرٌ من اللّه صيحةً","رجعتُ ورائي والحبيبُ أمامي",60,"ي",1,0],["إذا صرْصرُ الأرواحِ أغْشَتْهُ صَرَّها","شَوَى الوجْهَ منها حرُّهُ باحْتدامِهِ",61,"م",2,0],["إذا صُبَّ ماءٌ على صرفها","رأيتَ لهُ غَوْصَةً في اللهيبِ",62,"ب",1,0],["إِذا صَدَرَت عَنهُ الأَعاجِمُ كُلُّها","فَأَوَّلُ مَن يُروى بِهِ بَعدَها الأَزدُ",63,"د",1,0],["إِذَا صُلْتُ فَدَّتْنِي فِرَاسٌ بِشَيْخِهَا","وَإِنْ قُلْتُ حَيَّانِي شَبِيبٌ وَأَكْثَمُ",64,"م",1,0],["إذا صقلَتْ ريحُ الصَّبا متنَهُ أتت","تفرِّكُ ثوباً مُذْهباً ومفضَّضا",65,"ض",2,0],["إذا صدمت صُمَّ الخُطوبِ تَطَايرتْ","لدى الصّدمةِ الأُولى شَعاعاً مُبدَّدا",66,"د",2,0],["إِذا صاحتا بِالجَيشِ تَستَنجِدانهِ","تَنصّلَ مُورِيهِ وَأَجفلَ هارِبُهْ",67,"ب",2,0],["إِذا صاحَ لَم يُخذَل وَجاوَبَ صَوتَهُ","حَماشُ الشَوى يَصدَحنَ مِن كُلِّ مَصدَحِ",68,"ح",1,0],["إِذا صَكَّ وَسطَ القَومِ رَأسَكَ صَكَّةً","يَقولُ لَهُ النادي مَلَكتَ فَأَسجِحِ",68,"ح",1,0],["إِذا صَرَّ يَوماً ماضِغاهُ بِجِرَّةٍ","نَزَت هامَةٌ فَوقَ اللَهازِمِ كَالقَبرِ",69,"ر",1,0],["إذا صُلْتَ لم يَكُرمْ على السيْفِ سيّدٌ","وإن قلتَ لم يُقْدِمْ على النطق مِصْقَع",70,"ع",1,0],["إِذا صَهَلَت أُمّاتُهُ حَنَّ أَيرُهُ","لَهُنَّ فَكانَت مَحجَةٌ وَسِفادُ",71,"د",1,0],["إِذا صَاحَبتَ في أَيّامِ بُؤسٍ","فَلا تَنسَ المَوَدَّةَ في الرَخاءِ",72,"خ",3,1],["إِذا صَغَّرَ اِسماً حاسِدوكَ فَلا تُرَع","لِذَلِكَ وَالدُنيا بِسَعدِكَ تَفغَرُ",73,"ر",1,1],["إِذا صَحَّ فِكرُ المَرءِ فَما يَنوبُهُ","مِنَ الدَهرِ لَم يَشغَل بِحادِثَةٍ فِكرا",74,"ر",2,0],["إِذا صَفَتِ النَفسُ اللَجوجُ فَإِنَّما","تُعاني مِنَ الجُثمانِ شَرَّ المَحابِسِ",75,"س",1,1],["إِذا صَلَّوا فَصَلِّ وَعِفَّ وَاِبذُل","زَكاتَكَ وَاِجتَنِب قالاً وَقيلا",76,"ل",2,0],["إِذا صَقَلَت دُنياكَ مِرآةَ عَقلِها","أَرتكَ جَزيلَ الأَمرِ غَيرَ جَزيلِ",77,"ل",1,1],["إذا صَالَتْ فأنْتَ لها يَمِينٌ","وإنْ نَطَقَتْ فأنتَ لها لِسانُ",78,"ن",1,0],["إِذ أَصعَدَت عامِرٌ لا شَيءَ يَحسِبُهُم","حَتّى يَروا دُونَهُم هَضباً وأَنوالا",79,"ل",2,0],["\"إذا صعدت إلى ذا، مال ذا رهباً","وإن صعدت إلى ذا، مال ذا رغبا\"",80,"ب",2,0],["إذا صلت لم أترك مصالاً لفاتكٍ","وإن قلت لم أترك مقالاً لعالم",81,"م",1,0],["إذا صَدَرَتْ وُرَّادُهم عَنْ حِياضِهِمْ","تُغادِرُ نَهْباً للزكاةِ مُعقَّلا",82,"ل",2,0],["إِذا صَمَدَت حُمَيّاها أَريباً","مِنَ الفِتيانِ خِلتَ بِهِ جُنونا",83,"ن",2,0],["إذا صاحَ ابنُ دأيَةَ بالتّداني","جَعَلْنا خِطْرَ لِمَّتِهِ جِسادا",84,"د",2,0],["إذا صَدَقَ الجَدُّ افترَى العَمُّ للفتى","مكارِمَ لا تُكري وإنْ كذَبَ الخال",85,"ل",1,0],["إِذا صاحَ الغُرابُ بِهِ شَجاني","وَأَجرى أَدمُعي مِثلَ اللَآلي",86,"ي",1,0],["إِذَا صَافَحَتْهَا الرِّيْحُ رَهْواً تَجَعَّدَتْ","حَبَائِكُهَا مِثْلَ الْمُقَدَّرَةِ السَّرْدِ",87,"د",1,0],["إِذَا صُلْتُ كَفَّ الدَّهْرُ مِنْ غُلَوَائِهِ","وَإِن قُلْتُ غَصَّتْ بِالْقُلُوبِ صُدُورُ",88,"ر",1,0],["إِذَا صُلْتُ صَالَ الْمَوْتُ مِنْ وَكَرَاتِهِ","وَإِنْ قُلْتُ أَرْخَى مِنْ أَعِنَّتِهِ الشِّعْرُ",89,"ر",1,0],["إِذَا صَالَ رَوَّى السَّيْفُ حَرَّ غَلِيلِهِ","وَإِنْ قَالَ أَوْرَى زَنْدَهُ الْمَنْطِقُ الْفَصْلُ",90,"ل",1,0],["إِذَا صَاغَهَا بَهْزَارُ فِكْرِي تَصَوَّرَتْ","لِعَيْنِي فِي زِيٍّ مِنَ الْحُسْنِ رَائِقِ",91,"ق",1,0],["إِذَا صَرْصَرَ الْبَازِي تَلَبَّدْنَ بِالثَّرى","مِنَ الرُّعْبِ حَتَّى لا يَبِينُ لَهَا صَرُّ",92,"ر",1,0],["إِذا صَدَّ مَن أَهوى وَأَسلَمَني العَزا","فَفُرقَةُ مَن أَهَوى أَحَرُّ مِنَ الجَمرِ",93,"ر",1,0],["إِذا صَبغ البيضَ العِضابَ دَمُ العِدا","فَدَمعي لِخَدّي في نَعيكَ أَصبَغُ",94,"غ",1,1],["إذا صاحبتَ في الأسفار قوماً","فكن لهم كذي الرحمِ الشفيق",95,"ق",1,1],["إذا صالَ لم يترك مَصالاً لصائلٍ","وإن قَال ألقت سمعَها البُلغَاءُ",96,"ا",2,0],["إذا صحَّ عزمُ المرء فالبحرُ ضَحْضَحٌ","وإنْ خار فالنَّضْحُ اليسيرُ عُباب",97,"ب",1,0],["إذا صاح في جَيْجُونَ يوماً مُؤَذِّنٌ","أجاب على التاميز داعٍ مثَوِّبُ",98,"ب",1,0],["إِذا صالَ عَزْمِي فَهُوَ سَيْفٌ مُهنَّدٌ","لَهُ الْحِلْمُ وَالإِغْضاءُ مِنْ خُلُقِي غِمْدُ",99,"د",1,0],["إذا صال فالدنيا مَجَرُّ رِماحِه","وإنْ قال فالأيامُ عَيْنٌ ومسْمَع",100,"ع",1,0],["إِذا صَالَ ألْقَآ الرُّمحَ كُلُّ مُنَازِلٍ","وإِن هو دَوّى سَفّ كلُّ مُحَلِّقِ",101,"ق",1,0],["إذا صَحَا الجوُّ، طارت في جوانبِهِ","وُرْقًا، وإنْ غامَ طارتْ فيه عِقْبَانا",102,"ن",2,0],["إذا صفَحَاتُ البطولةِ خُطَّتْ","فإِنَّ العروبةَ عُنْوَانُها",103,"ن",3,0],["إذا صَدَفَتهُ العَينُ أبدَى تَوقَّداً","، كأنّ على متنيهِ نارَ الحباجبِ",104,"ب",1,0],["إذا صَدَّ يَوْماً ماضِغَاهُ بِجِرَّة","ٍ نَزَتْ هَامة ٌ بين اللَّهازِم كالقَبْرِ",105,"ر",1,0],["اذا صِحتُ قلتُم لم يَحنِ بعد مَوعد","تُريدون إشباعَ البُطون لمَوعد",106,"د",1,0],["إذا صدرت عن يوم موت آخر ال","حشاشة منها كان غدواً ورودها",107,"د",3,0],["إذا صَدَعْنا الدّجَى عَنّا بغُرّتِهِ،","خِلْنَا بِها قَبَساً نَجلُوهُ،قََدْ ضَرَمَا",108,"م",2,0],["إذا صار سهبا عاد ظهراً عدوه","وكان الصديق غدوة ذلك السهب",109,"ب",1,0],["إذا صَنَعَ الصَّفّارُ سُوءَاً لنَفْسِهِ،","فَلا تَحْسُدِ الصَّفّارَ سُوءَ صَنيعهِ",110,"ع",2,0],["إذا صَحّ فكرُ المرءِ فيما يَنوبُهُ","من الدّهرِ، لم يَشغَلْ، بحادثةٍ، فكرا",111,"ر",2,0],["إذ أصبحتْ صُماً عن التوبيخ","مشْعُوفة بالبارد المَسيخ",112,"خ",1,0],["إِذا صَالَ ألْقَى الرُّمحَ كُلُّ مُنَازِلٍ","وإِنْ هو دَوّي سَفّ كلُّ مُحَلِّقِ",113,"ق",1,0],["إذا صكَّتِ الحربُ امرأَ القيسِ أخَّروا","عَضَارِيطَ أَوْ كَانُوا رِعَآءَ الْدَّقَائِقِ",114,"ق",1,0]]}