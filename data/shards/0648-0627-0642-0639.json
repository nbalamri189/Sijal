{"poems":[[55,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[88,"يحييك من أرض الكنانة شاعر","https://www.aldiwan.net/poem68927.html","الطويل"],[80,"الملك في طي الدفاتر","https://www.aldiwan.net/poem14190.html","مجزوء الكامل"],[47,"رنو ذاك الغزال أو غيده","https://www.aldiwan.net/poem63505.html","المنسرح"],[47,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[47,"بالله يا ربع لما ازددت تبيانا","https://www.aldiwan.net/poem66659.html","البسيط"],[30,"أبى الحزن أن أسلى بني وسورة","https://www.aldiwan.net/poem5648.html","الطويل"],[63,"أنعته معصفر البردين","https://www.aldiwan.net/poem51418.html","الرجز"],[46,"سعدت غربة النوى بسعاد","https://www.aldiwan.net/poem30559.html","الخفيف"],[33,"ألا يا أيها الواشي بهند","https://www.aldiwan.net/poem42238.html","الوافر"],[54,"أأسمع ما قال الحمام السواجع","https://www.aldiwan.net/poem26857.html","الطويل"],[52,"تجهز طال في النصب الثواء","https://www.aldiwan.net/poem64892.html","الوافر"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30448","المتقارب"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[102,"أغنية من خشب","https://www.poetsgate.com/ViewPoem.aspx?id=50378",""],[102,"نهاية حسناء ريفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50449",""],[96,"الكعبة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=12696",""],[119,"الا يا من به يجلى الظلام","https://www.aldiwan.net/poem40599.html","عموديه"],[119,"جانب زمانك ان اردت وواله","https://www.aldiwan.net/poem40616.html","عموديه"],[173,"بالسيف يفتح كل باب مقفل","https://www.aldiwan.net/poem1657.html",""],[201,"سباك الجيد والقد","https://www.aldiwan.net/poem39863.html","مجزوء الوافر"],[303,"إذا الشعر لم ينفث به ربه السحرا","https://www.aldiwan.net/poem36848.html","عموديه"],[333,"واقع أروع من نسج الخيال","https://www.aldiwan.net/poem55008.html","الرمل"],[398,"اذا لم يكن لركوب الشري","https://www.aldiwan.net/poem53639.html","المتقارب"],[409,"أتت وخيول الهم في القلب ترتكض","https://www.aldiwan.net/poem33699.html","الطويل"],[409,"أتسأل عن رحيلي يا بن ودي","https://www.aldiwan.net/poem33966.html","الوافر"],[463,"أنذرتني أم سعد أن سعدا","https://www.aldiwan.net/poem56214.html","الرمل"],[463,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[469,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[494,"خليلي عوجا فانظراني لعلني","https://www.aldiwan.net/poem403.html",""],[505,"لما تقلقلت الركبان سارية","https://www.aldiwan.net/poem37740.html","البسيط"],[545,"صرمت حبائلا من حب سلمى","https://www.aldiwan.net/poem56867.html","الوافر"],[556,"أيا حادي الأظعان لم لا تعرس","https://www.aldiwan.net/poem47754.html","الطويل"],[563,"نزل الحديد فكان سيفا قاضبا","https://www.aldiwan.net/poem34972.html","الكامل"],[580,"لما دعا في الركب داعي الفراق","https://www.aldiwan.net/poem2701.html","السريع"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104576","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119943","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64625","الرجز"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82288","الكامل"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216641",""],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104466","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58440","الخفيف"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26962","البسيط"],[3812,"","https://poetry.dctabudhabi.ae/diwan/poem/142188","الطويل"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143035","الطويل"],[4988,"ريق الفخر يحتاج كفواً يبّله","https://www.poetsgate.com/ViewPoem.aspx?id=180840",""],[5061,"يامهاجر","https://www.poetsgate.com/ViewPoem.aspx?id=147155",""],[5064,"مدُنُ القلب الضّائع","https://www.poetsgate.com/ViewPoem.aspx?id=199173",""],[5187,"ضحايا بين الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29258",""],[5206,"صِرف النصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=187394",""],[5526,"خلف الشبابيك","https://www.poetsgate.com/ViewPoem.aspx?id=209124",""],[5691,"أعشاب ضارة","https://www.poetsgate.com/ViewPoem.aspx?id=206082",""],[5784,"استأنست بالذئاب أمتنا","https://www.poetsgate.com/ViewPoem.aspx?id=190724",""],[5956,"وُلِدْنا في سُجون العمر","https://www.poetsgate.com/ViewPoem.aspx?id=193566",""],[6023,"والصباح استعار من هجر حبِّي","https://www.poetsgate.com/ViewPoem.aspx?id=123863",""],[6189,"بيان للجماهير المحتشدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83593&r=&rc=60",""]],"verses":[["واقِعاً بِالأَضدادِ أَروى وَأَظما","وَقَضى وَاِقتَضى وَساءَ وَسَرّا",0,"ر",2,0],["وَأَقعَدَني عَن وَصفِ هَمليتَ حُسنُها","وَفي مِثلِها تَعيا اليَراعَةُ وَالفَمُ",1,"م",1,0],["واِقعُد فَإِنَّك طاعِمٌ","كاسٍ وَقُل هَل مِن مُفاخِرْ",2,"ر",1,0],["واقَعنَ جَمعَ الشُراةِ مُحتَفِلاً","بِالزابِ وَالصُبحُ ساطِعٌ وَقَدُه",3,"د",2,0],["وَأَقعَدَهُ عَن نَيلِ مَجدِكَ إِنَّهُ","تَضاءَلُ عَن لَألائِهِ الأَنجُمُ الزُهرُ",4,"ر",1,0],["واقِع بِهِ الغَمرَةَ المَغرورَ خائِضُها","وَلا تُكَلِّفهُ فيها حينَ مَن حانا",5,"ن",2,0],["وَأَقعَت عَلى الأَذنابِ كُلُّ قَبيلَةٍ","عَلى مَضَضٍ مِنّي وَذَلَّت رِقابُها",6,"ب",3,0],["واقعةٌ فيه سِهامُ العَيْنِ","بينَ ذِراعَيْنِ مُفَصَّلَيْنِ",7,"ن",1,0],["واقِعاً بِالخُدودِ وَالحِرُّ مِنهُ","واقِعٌ بِالقُلوبِ وَالأَكبادِ",8,"د",1,0],["وَأَقعُدُ بَعدَ قَطعِ الحَبلِ أَدعو","إِلى صِلَةٍ وَقَطعُ الحَبلِ صُنعي",9,"ع",2,0],["وَأَقعَدَني عَنهُ اِنتِظارٌ لِإِذنِهِ","وَما قالَ مِن شَيءٍ فَإِنِّيَ طائِعُ",10,"ع",1,0],["وَأَقعَدَني عَنِ الغُرِّ الغَواني","وَقَد نادَيتُ لَو سُمِعَ النِداءُ",11,"ا",2,0],["وأَقْعَصْنَ كَلْباً على عِزِّهِ","فما اعْتَزَّ بالصّافِناتِ الجيادِ",12,"د",1,0],["واقعد مخشوشا على مبرك الونى","ويحكمني عن غاية القوم حاكم",13,"م",1,0],["وأقعت ، لها قلب فاشيّة","ووجه عليه سمات العرب",14,"ب",1,0],["وأقعى يهزّ الجدار","أكفّا من الشوك خرس النوايا",15,"ا",3,0],["وأقعدني عنك الضّنى فبعثتها","شوارد شعر لم ترع بضريب",16,"ب",1,0],["واقعده كليل العزم حظ","يسير به الى ما لا يرام",17,"م",1,0],["واقعد ولا تبغ الكمال تناهيا","فالبدر آفته بلوغ كماله",18,"ل",2,0],["وَاِقعُد وَأَرضُكَ ظَهرُ أَجرَدَ سابِحٍ","وَسَماؤُكَ الدُنيا غَيابَةُ قَسطَلِ",19,"ل",1,0],["وأقعدك اضطربا","النفس في الظلماء والجهد",20,"د",1,0],["وَأَقعده عجز فأَصبح ساخطاً","كأَنَّ له عند الأُولى سبقوا ثأْرا",21,"ر",2,0],["واقعٌ أروعُ من نسجِ الخيال","ومن الأنباء صدقٌ كالمُحال",22,"ل",1,1],["وَأَقعَدَهُ الدَهرُ مَركوبَهُ","فَاِنَّ عَليَّ اِحتمالَ العَوض",23,"ض",1,0],["وأقعدني عن كل عز أرومه","وعرضني قسراً لما عنه أعرض",24,"ض",1,0],["وأقعدني عن الطاعات ضعفي","فما فيه لنافلة نؤدي",25,"د",2,0],["واقعاً في كلّ مَن كثّرني","بيدٍ خرقاءَ أو أصبحتُ فردا",26,"د",2,0],["وأقعصَ الأقرانَ عنك قَلَمٌ","ممرَّنٌ وخاطرٌ مدرَّبُ",27,"ب",1,0],["واقعاتٌ وطائراتٌ","في كل حي تحوم",28,"م",1,0],["وأقعِ كَما أَقعى أَبوك عَلى استِه","وَكانَ قَصيراً باعُهُ متَهضَّما",29,"م",2,0],["وأقْعَدَ القَوْمَ قَسْراً قَهْرُ حاكِمِها","وقَيَّدَ الكُلَّ منهُمْ في دَعاويها",30,"ي",3,0],["وَأَقعَدَني الزَمانُ فَبِتُّ صِفراً","مِنَ المالِ المُعَزَّبِ وَالمُراحِ",31,"ح",1,0],["وَأقْعى إِزاءَ الرّحلِ يَطلب غِرَّةً","ويُلقِي إليه الحرصُ أنْ سوف أنعسُ",32,"س",1,0],["واقعد وقم وتقاوَ واعجز إن ترم","وصلي وكن بي طالعاً أو غاربا",33,"ب",2,0],["واقعد طليقاً ما نأَت دَارُه","وَدَعْ أَسيراً سائراً في وثَاق",34,"ق",1,0],["واقعتُ فيه كلّ أصيدَ مِن ذوي","رَحِمي عريقٍ في العلاءِ مُسوَّدِ",35,"د",1,0],["وأقعده وفاحت ريح نكهته","وكيف يبقى وذاك الداء قابلة",36,"ل",2,0],["واقعة في خبر أو حال أو","مفعول أو غضافة لها رأوا",37,"ا",3,0],["واقعة خافضة رافعة","تنكس الشرك بها على الشوى",38,"ا",1,0],["وَاِقعُد وَقُم بي ما بَدا","لَكَ في الأَداني وَالأَقاصي",39,"ص",2,0],["واقع نعيشه يا شعوب العالم","الأمن.. الاستقرار.. والحريّه",40,"ي",2,0],["وأقعدن في غد من منهجي","له الذي لم يعد فيه إذ يجي",41,"ي",1,0],["واقعُدَنْ منهُ فوقَ ما شئتَ من ودِّ","مديدٍ والقُرنُ منك طويلُ",42,"ل",1,0],["وَاِقعُد قَليلاً وَعايِن مَن يُقيمُ مَعي","مِمَّن يُشَيُّعُ نَعشي مِن ذَوي وُدّي",43,"د",2,0],["وأقعدني دائي فعِفتُ المعاصيا","سقيتُ الصّبايا ماء حبي وصبوتي",44,"ي",1,0],["وأقعد عن يمناي شمساً منيرةً","وأوقد من يسراي شمعاً منورا",45,"ر",2,0],["واقع ولاجله لجلج وثار هاجوس","والهاجس اليا ثار ماله أخلّه",46,"ل",2,0],["واقعد اكرر وانادي ثم اعيد","لين صوتي صار مايوصل مداه",47,"ا",2,0],["واقِعٌ فِي واقِعٍ أبأسُهُ","أَنَّهُ قَدْ صارَ مِنْ عينيهِ واقِعْ",48,"ع",1,0],["واقعٌ حاولتُ أن أنسى بِهِ","علَّ أقداحي تُداوي عِلّتي",49,"ت",2,0],["وَاقْعُد مَقَاعِدَ صِدقِ كَونٍ فِي الهُدَى","واحْذَرْ بَعَاوِ خَفِيِّ شِركِ كُنُودِهِ",50,"د",2,0],["واقعد اسولف به وانا خاطري فيك","ابغى السوالف كلها تصير قسمك",51,"ك",1,0],["واقِعٌ مُرٌّ مُظْلِمٌ سادَ فيهِ","جاهِلٌ نِيطَ جهْلُهُ بوِسامِ",52,"م",1,0],["واقعنا لا شراع ينقذه","وكلبه للنجوم نباح",53,"ح",1,0],["وأقعى تحت أقدام التناسي","أسَمّي اليأس إيماناً وصبرا",54,"ر",2,0],["واقعاً من ولائها في بُرُودٍ","نَسجُها مُحكمٌ بصنع الأيادي",55,"د",2,0],["واقعيٌّ وهل يطير جريحٌ","دمُه تستحم فيه الصَّحارى",56,"ر",2,0],["واقعيٌّ تندسُّ في الفيافي","فاقرؤوا سِحنتي شجىً وغُبارا",56,"ر",2,0]]}