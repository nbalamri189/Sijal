لمعلق","https://www.poetsgate.com/ViewPoem.aspx?id=215856",""],[4578,"بالصفا نحو كؤوس الأنس ساق","https://www.poetsgate.com/ViewPoem.aspx?id=49492",""],[4926,"كيف يحصى عليك منا ثناء","https://www.poetsgate.com/ViewPoem.aspx?id=171114",""],[4935,"الكوكب القيم أضاء نوره","https://www.poetsgate.com/ViewPoem.aspx?id=129510",""],[4955,"يا شهر خير قد أتى","https://www.poetsgate.com/ViewPoem.aspx?id=188725",""],[5057,"أول النصر","https://www.poetsgate.com/ViewPoem.aspx?id=197174",""],[5111,"روسِيكَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=212161",""],[5213,"بشراك قد انجزت الموعدا","https://www.poetsgate.com/ViewPoem.aspx?id=170454",""],[5277,"قُمريّةُ الحارات","https://www.poetsgate.com/ViewPoem.aspx?id=202106",""],[5277,"حوارُ الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=213696",""],[5277,"جئنى ندىً","https://www.poetsgate.com/ViewPoem.aspx?id=214908",""],[307,"بمن الوذ","https://www.poetsgate.com/ViewPoem.aspx?id=213702",""],[307,"طافَ الوباءُ بقاع الأرضِ","https://www.poetsgate.com/ViewPoem.aspx?id=215607",""],[5459,"مديح نبوي","https://www.poetsgate.com/ViewPoem.aspx?id=190900",""],[5461,"فدوة عيونك","https://www.poetsgate.com/ViewPoem.aspx?id=6232",""],[5463,"أحسب أهلي ناسبوها","https://www.poetsgate.com/ViewPoem.aspx?id=31731",""],[5465,"أصبح الملك ثابت الأثاث","https://www.poetsgate.com/ViewPoem.aspx?id=98432",""],[5518,"في ذكرى المولد النبوي الشريف","https://www.poetsgate.com/ViewPoem.aspx?id=187775",""],[5587,"في القلب حزن","https://www.poetsgate.com/ViewPoem.aspx?id=200142",""],[5717,"فالقول بالعدل أساس يبتنى","https://www.poetsgate.com/ViewPoem.aspx?id=170603",""],[5736,"على دروب انتظاري","https://www.poetsgate.com/ViewPoem.aspx?id=208871",""],[5749,"القوة والجهد والصغر","https://www.poetsgate.com/ViewPoem.aspx?id=140223",""],[5749,"في رثاء فويتح","https://www.poetsgate.com/ViewPoem.aspx?id=203743",""],[402,"باعوا المخلد بالحطام الفاني","https://www.poetsgate.com/ViewPoem.aspx?id=36493",""],[5956,"أنا معجب بك‎ ‎","https://www.poetsgate.com/ViewPoem.aspx?id=182448",""],[5956,"فرحة العمل بالهدى","https://www.poetsgate.com/ViewPoem.aspx?id=192553",""],[5956,"أنت الذي لعيون قلبي الإثمدُ","https://www.poetsgate.com/ViewPoem.aspx?id=192594",""],[6019,"وقوفاً على باب قصيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=174231",""],[6056,"مثل الجبل رآسي","https://www.poetsgate.com/ViewPoem.aspx?id=130339",""],[6089,"عدني","https://www.poetsgate.com/ViewPoem.aspx?id=213979",""],[6115,"اللى بطولاتهم ماغير نفخة هواء","https://www.poetsgate.com/ViewPoem.aspx?id=196483",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["بِالصَحنِ وَالمِصحاةِ وَال","إِبريقِ يَحجُبُها عِلابُه",0,"ب",2,0],["بِالصَّبْرِ وَالأِيمَنِ أُخْلِصَ بَدْوُّهَا","وَخِتَامُهَا بِالصَّبْرِ والإيمانِ",1,"ن",1,0],["بِالصُهبِ ناصِبَةِ الأَعناقِ قَد خَشَعَت","مِن طولِ ما وَجَفَت أَشرافُها الكومُ",2,"م",1,0],["بالصعدة السمرا","والأبيض البتار",3,"ر",1,0],["بِالصَيفِ يُقمَعُ مَثلوثُ المَزادِ لَها","كَأَنَّهُم مِن خَليجَي دِجلَةَ اِغتَرَفوا",4,"ف",3,0],["بالصُّبْحِ من غُرَّتك المُجْتَلى","واللَّيْلُ من طُرَّتِك الحالِكِ",5,"ك",1,0],["بالصبر بالآلامِ هل","حملتكَ إلا أنملي",6,"ل",2,0],["بِالصَريحِ الصَريحِ وَالأَروَعِ الأَر","وَعِ مِنهُم وَبِاللُبابِ اللُبابِ",7,"ب",1,0],["بِالصَمتِ يُدرِكُ طامِرٌ ما رامَهُ","وَتَخيبُ مِنهُ بَعوضَةٌ مِهذارُ",8,"ر",1,0],["بالصدقِ منهُ والولا","أُنسيت أهلي والولدْ",9,"د",1,0],["بالصُّمِّ من صخورك الصِّلاَب","يحكي لنا زئيرَ أُسْدِ غاب",10,"ب",1,0],["بالصّمتِ يُدرِكُ طامرٌ رامَهُ،","وتخيبُ منهُ بعوضةٌ مِهذار",11,"ر",1,0],["بالصبرِ آوِنة ً وبالإقدام","هممُ الرجالِ إذا مضتْ لم يثنها",12,"ه",2,0],["بالصدق والإخلاص ضاعت قلوبهم","وقد عظموا شأناً وقد شرحوا صدرا",13,"ر",2,0],["بالصالحين بأشياخ الطريق كذا","بالأربعين بسادات ذوي الشيم",14,"م",1,0],["بالصدق والاقبال والشرف العلى","بقبولكم والفوز بالآداب",15,"ب",1,0],["بالصمت أعلن سرى","بالصمت تعلن سرّك",16,"ك",1,0],["بِالصاحِبِ اِبنِ الصاحِبِ التَأَمَت وَما","كانَت بِطَبعِ الإِلتِيامِ ضُلوعي",17,"ع",2,0],["بالصوم والإفلاس بِن","تُ عن السُّلافَةِ والسوالف",18,"ف",1,0],["بِالصَدِّ عَنهُ لِحيني رُمتُ تَجرِبَتي","إِنَّ المَصائِبَ أَثمانُ التَجاريبِ",19,"ب",1,0],["بالصّاحبِ العادلِ المَيْمونِ طائرُه","لم يَبْقَ في الأرضِ قُطْرٌ غَيرُ مُعْتَدِل",20,"ل",1,0],["بالصّاحبِ العادلِ المأمولِ أَمطَر لي","أُفْقي وأَثمرَ بالأغراضِ أغراسي",21,"س",2,0],["بالصّبْرِ كما قيلَ مَنالُ النّصْرِ","لكنّ أمامَه فَناءُ العُمْرِ",22,"ر",1,0],["بالصّاحبِ العَدْلِ احتمَى زَمنِي","فلأغفِرنَّ ذنوبَه غَفرا",23,"ر",2,0],["بالصالِح المَلِكِ الذي","جمَعَ المهابَة والجَلالا",24,"ل",2,0],["بالصاحب ابتدأوا المكارمَ وانتَهوْا","فالفخرُ مفتتَحٌ به مختومُ",25,"م",1,0],["بالصاحبِ استذرت إلى ظِلالها","شتائتُ الفضل وشُذَّان الكَلِمْ",26,"م",1,0],["بالصارمَيْن سيفِهِ ورأيِهِ","نال من اشتراطها ما نالَه",27,"ل",2,0],["بالصاحب انفتقتْ لنا ريحُ الصَّبا","خِصباً وغنى الساقُ فوقَ اليكةِ",28,"ه",1,0],["بالصَّبْرِ عندَ المُجْلِباتِ","تكُفُّ منْ ضوْضائها",29,"ا",3,0],["با لصاحب انصاع الزمان مصحبا","حتى لياليه الصعاب ذلل",30,"ل",1,0],["بالصاحب الميمون أصحب مطلبي","ووفت لي الآمال بعد مطال",31,"ل",1,0],["بالصبر كم غلب امروءٌ","من غير جندٍ غالبه",32,"ب",2,0],["بالصالح الهادي سموتم على","كل عظيم قدره يذكر",33,"ر",1,0],["بالصفا عن كدر الحس فغب","واطرح الأغيار واترك خدعك",34,"ك",1,0],["بالصفا والوفا ولا","عنه يصرفه صارف",35,"ف",1,0],["بالصفح إن قصدت يوما ظلما","وبجهاد من به قد عما",36,"م",2,0],["بالصنع من خالقه ثم كفر","بعضهم النعمة لما إن بطر",36,"ر",1,0],["بالصَّدِّ تقتُلُ في الهوى وقتلتَني","بالوَصْلِ فاقْتُلْني بغير جُناح",37,"ح",1,0],["بالصالحات تزودت من قبل أن","وفدت إلى الأخرى بخضر ثياب",38,"ب",1,0],["بالصالحات المرء يستولى على","مهج تردد فضله ترديدا",39,"د",2,0],["بالصوم ادركني الكلال وخانني","عزمي الذي يدع الوضيح مكسرا",40,"ر",2,0],["بالصَّحْنِ والسَّطْحِ والمجالِس وال","رواقِ ما إِنْ أَزالُ مسرورا",41,"ر",2,0],["بِالصّبرِ قلبِ وَعَدتَني","كُن وافِياً قَلبي بِوَعدِك",42,"ك",1,0],["بِالصّادِقِ المَصدوقِ","وَالسّيِّدِ الصدِّيقِ",43,"ق",1,0],["بالصاحب الملك المطاع","طالت يدي وامتدَّ باعي",44,"ع",2,1],["بالصّرمِ من شعثاءَ وال","حبلِ الّذي قطعَتْه بدحا",45,"ح",2,0],["بالصبر والصلاة فاستعينوا","والله وحده هو المعين",46,"ن",1,0],["بالصدر لا بالسن كشط في الورق","لجسم ذاك الخط مع وجه الورق",47,"ق",1,0],["بالصّعاد المُقوَّمات العَوالي","والجيادِ المُسوّماتِ العِتاقِ",48,"ق",1,0],["بِالصالحِ المَلِكِ الأَغَرِّ صَلاحُهُ","لا فارَقَت أَوطارَهُ أَوطانُهُ",49,"ن",2,0],["بالصوب بعد الصوت","فَيَبعَث الإِنسان",50,"ن",1,0],["بالصفو كانت رياضاً","تفوح عطراً وندا",51,"د",2,0],["بالصفر يعقل عنهم","فيما ألم بلا ارتجاع",52,"ع",1,0],["بالصادق الأفعال جعفر فاجعلن","صدقَ العقيدةِ دائماً أركاني",53,"ن",2,0],["بالصحو يأتي ذكره دائماً","والقبضُ والبرد مع الوفر",54,"ر",1,0],["بالصحبة يا صاح اذا جزت بحي","فاشرح كلفي بها وما تمّ علي",55,"ي",1,1],["بِالصَّحوِ تَنظُرهَا وَزَنجِبَارَ","مِنَ الدَّقَلن فَإلزَمِ المَجَارِي",56,"ي",1,0],["بالصالحيه سُميت يا صاحٍ","بل منتدى اللذات والأفراح",57,"ح",1,0],["بالصدور وما بها من رمان","بانكشاف الذوات لا العورات",58,"ت",1,0],["بالصوليان ومعير جبل كذا","يمشي إلى الملبار بالهندية",59,"ه",1,0],["بالصخر يصدم نفسهُ متذمّراً","حتى تكاد الروح منه تزهق",60,"ق",1,0],["بالصبر والصلاة إن اللَه","لم ينش في الخلق له أشباها",61,"ه",2,0],["بالصدقِ والإخلاصِ في القراءة","يلقى من الخير امرؤء جزاءه",62,"ه",1,1],["بالصابرِ المجاهدِ المحامي","والناصرِ الحافِظِ للذمامِ",63,"م",1,0],["بالصفا مُسلسل","عن الوفا بالأذرع",64,"ع",1,0],["بالصوم بالقرآن بال","فتح المبين قد استهل",65,"ل",1,0],["بِالصالِحِ الملكِ المَيمونِ قَد نَظَرت","إِلى بَنيها الليالي وَهيَ تَبتسمُ",66,"م",1,0],["بالصلوات الخمس قم فاستعن","والمرء قد تنجيه أعوانه",67,"ن",2,0],["بالصفع أولى سبعةٌ: من أتى","وليمة لم يك فيها دُعي",68,"ع",2,1],["بالصادق الصديق ما احتج في","صحيحه واحتج بالمرجئة",69,"ا",2,0],["بالصبر يَرْقَى المرءُ أوْجَ العُلَى","إن التَّأنِّي دَرَجٌ للرَّقَا",70,"ق",2,1],["بِالصَّبرِ نَارُوا وَصَارُوا","مِن حَيِّ لَيلَى وَسَارُوا",71,"ر",3,0],["بالصاحبين أتيت اليوم ملتجئا","أرجو رضاك وفي افرضاء إغضاء",72,"ا",2,0],["بِالصَبرِ يُكتَسَبُ المِقدامُ نُصرَتَهُ","وَيَلبَسُ الضِد مِنهُ ثَوبَ مُنذَعِر",73,"ر",1,0],["بِالصُبحِ تَنَفَّرَت عَنِ الخِلّانِ","فاِختَرتُ عِتابَها عَلى الهجرانِ",74,"ن",1,1],["بِالصامِت لا الناطِقَة اِستَدعِ أُجِب","بِالرابِح ذي العيار جُد لا القَلبِ",75,"ب",1,0],["بِالصَدِّ أَلهَبت قَلباً أَنتِ ساكِنَه","هَلّا عَطَفت عَلى سَكناك يا أَملى",76,"ل",2,0],["بالصدّ والبعد ما أفتاك لى أترى","من بالصدود وهذا الهجر أفتاك",77,"ك",1,0],["بالصبر يوسف سر بعد هبوطه","يا آل لمعٍ هل يرى قلبٌ خلي",78,"ل",2,0],["بِالصاحبين الأَكملين وَآلك ال","غُرِّ الّذينَ نجومهم لا تأفلُ",79,"ل",1,0],["بالصدرِ هَمُّ صبابتي","وهيامُ روحيَ مُحدق",80,"ق",1,0],["بالصفا نحو كؤوس الأنس ساق","من على وجنته المراح ساق",81,"ق",1,1],["بالصَّبيِّ المكلوب جاءتك أمٌ","فعلى الله كان منك الثَّناء",82,"ا",2,0],["بالصدق والاخلاص تملى صفحته","فيزدهي بعزة تحريره",83,"ر",2,0],["بالصوم إنَّا نرتجي","عفواً من المولى الغفورْ",84,"ر",1,0],["بالصبرِ لا بالتباكي","يقاوِمُ اليأسَ حُرُّ",85,"ر",1,0],["بِالصَّمْتِ وَحْدِيْ وَرِيحُ النَّارِ تَعْصِفُ بِيْ","وَهْمًا كَجُرْحٍ سَرَى يَجْتَاحُ إيَّانَا",86,"ن",2,0],["بالصدغ تحمي وردة الخد وا","لماء اذا يقطف او يوردا",87,"د",2,0],["بالصمتِ أرسلَ نظرةً مدهوشةً","كالوعلِ يرقبُ ظبيةَ الغاباتِ",88,"ت",1,0],["بالصمتِ تنطقُ كلما حاورتُها","صمتَ الوقورِ المستهامِ الكيّسِ",89,"س",1,0],["بالصمت تعتبُ..!؟ إنَّ صمتكَ قاتلٌ","والصمتُ سطر يستفزّ الكاتبا",90,"ب",2,0],["بالصبر أطفئ داءاً بأسه وجع","لكن ألفاً من الأسقام تشتعلُ",91,"ل",1,0],["بالصبر والطب والإيمان نهزمه","وبالدعاءِ وعند الله نحتسبُ",92,"ب",1,0],["بالصدق تنطق مُلهَما وبحكمةٍ","وَحْياً وليسَ هوًى ولا تضليلا",93,"ل",2,0],["بالصمت أهوجس بك وبالصوت أناديك","والله عليم البينة والسراير",94,"ر",1,0],["بالصبح بزور عمّي وإيدي تصافح أخوها","وبالمسا بعزف حنيني فوق هذيك الربابه",95,"ب",2,0],["بالصدور المقدمين قديماً","والرؤوس القماقم الرؤاس",96,"س",1,0],["بالصخرة قد عقل براقا","قبل المعراج يقيده",97,"د",2,0],["بِالصَّوْتِ أَسْتَسْمِحُ العُمْرَ الَذِي ذَبَلَا","وَمَا عَرَفْتُ لَهُ شَيْبَا وَ لَا سَبَبَا",98,"ب",2,0],["بالصدق والوفاء بالاحسان والا","نصاف بالعطف وحفظ الذمم",99,"م",1,0],["بالصبر قد أكتوي والحرف يصفعني","فالصبر او أحرفي أحلاهما مرُّ",100,"ر",1,0],["بالصغر تغريت وظنيت دوام حليب سناني","ما نلبس توب شيب عمري ولا نعمل خطية",101,"ي",2,0],["بالصبر والسلوان داوي لينا لجراح","خاوي لامتنا لبعيد ولقريب",102,"ب",1,0],["بالصبر والإيمان أخلص بدؤها","وختامها بالصبر والإيمان",103,"ن",1,0],["بالصبر صيّرنا الجحيم فرادساً","ولقد جعلْنا همَّنا نفعَ البشرْ",104,"ر",1,0],["بالصالحاتِ الباقياتِ وصفحنا","عمَّن يسيئ لنا ودفع زكاةِ",105,"ه",1,0],["بالصدقِ والإخلاصِ بالحبِ الذي","تمضي به عَبْرَ الوجود تُوحِّدُ",106,"د",1,0],["بالصمتِ لاذ الهمسُ في أعطافِهِ","خوفاً كلوذ هَجِيرَنا بصعيدِهِ",107,"د",2,0],["بالصاحب اللي ماشترى للمصاليح","عرفي ولاأرخص حبنا عدم الأجناس",108,"س",1,0],["بِالصّبرِ يُفتَحُ كُلُّ بابٍ مُغْلَقٍ","قهرٌ يَطيحُ وَصَفوُ عَيشٍ يَصعَدُ",109,"د",1,0],["بالصدق حبل النجاة لكل رجلٍ فطين","والكذب لاينفعك قوله ولا المحتوى",110,"و",2,0],["بِالصَوت شفتوا مثل حالي وَمحنَتي","وَاللي جَرى لي الصم تَأبى مشالها",111,"ل",3,0],["بالصمد المغيث كل صامد","بالقادر المقتدر المنشي القدر",112,"ر",1,0],["بالصلوات الطيبات أوألُ","بالباقيات الصالحات أسأل",112,"ل",1,0]]}