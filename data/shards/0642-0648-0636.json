{"poems":[[79,"أنا إلى الله وإنا له","https://www.aldiwan.net/poem36021.html","الطويل"],[74,"ما لظبي الحمى إليه التفاته","https://www.aldiwan.net/poem18387.html","الخفيف"],[91,"قوض الحي للرحيل الحياما","https://www.aldiwan.net/poem44948.html","الخفيف"],[63,"أخلت أن جنابا منك يجتنب","https://www.aldiwan.net/poem51814.html","البسيط"],[68,"إني لفضلك بالمديح أجازي","https://www.aldiwan.net/poem38510.html","الكامل"],[71,"قوض إلى قوص الصعيد فبابها","https://www.aldiwan.net/poem29037.html","الكامل"],[48,"بعض الرجال كقبر الميت تمنحه","https://www.aldiwan.net/poem22888.html","البسيط"],[48,"سل سبيل الحياة عن سلسبيل","https://www.aldiwan.net/poem23261.html","الخفيف"],[406,"ابتهل","https://www.aldiwan.net/poem6733.html","عموديه"],[422,"لامني سعد على","https://www.aldiwan.net/poem53873.html","مجزوء الرمل"],[422,"جسد ذاب نحولا وسقاما","https://www.aldiwan.net/poem53951.html","الرمل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138312",""],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59775","المديد"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59707","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109060","الرمل"],[1768,"","https://poetry.dctabudhabi.ae/diwan/poem/101825","الرمل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126656","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53195","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27148","الرمل"],[2465,"","https://poetry.dctabudhabi.ae/diwan/poem/124310","الخفيف"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87766","الكامل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136988",""],[3229,"","https://poetry.dctabudhabi.ae/diwan/poem/202431","البسيط"],[3306,"","https://poetry.dctabudhabi.ae/diwan/poem/147795",""],[3348,"","https://poetry.dctabudhabi.ae/diwan/poem/81380","الخفيف"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132917","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131247",""],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40130","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44688","البسيط"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101350","البسيط"],[4188,"","https://poetry.dctabudhabi.ae/diwan/poem/202436","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54498","الكامل"],[4330,"","https://poetry.dctabudhabi.ae/diwan/poem/122967","البسيط"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113827","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139547",""],[5055,"صفوف الظل","https://www.poetsgate.com/ViewPoem.aspx?id=101655",""],[5129,"خضراء","https://www.poetsgate.com/ViewPoem.aspx?id=125752",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[6031,"عَاطِنيها قبلَ ابتِسَامِ الصَّبَاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=46257",""],[2220,"غادروني بالأثيلِ والنَّقَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19273&r=&rc=815",""]],"verses":[["قَوَّضْ عَنِ الْفَانِي رِحَالَ امْرِىءٍ","مَدَّ إِلَيْهِ عَيْنَ عِرْفَانِهِ",0,"ن",2,0],["قوَّضوا وابْتدى فريد صفات","طال أو تقرع الخطوبُ صفاته",1,"ت",2,0],["قوَّض الحيُّ للرحيل الحياما","ما على الحي لو قليلاً أقاما",2,"م",2,1],["قوِّض خيامَك عن دارٍ ظُلِمتَ بها","وجانبِ الذُّلَّ إنَّ الذُّلَّ يُجتنَبُ",3,"ب",1,0],["قَوَّضتَ عَن أَعلامِها فَتَنَكَّرَت","فَكَأَنَّها ثَوبٌ بِغَيرِ طِرازِ",4,"ز",1,0],["قوِّضْ إلى قوصِ الصعيدِ فبابُها","بابٌ صحيحٌ للقبولِ مجرَّبُ",5,"ب",1,1],["قَوَّض خِياماً عَلى الدُنِّيا فَإِنَّ بِها","خَلائِقاً أَوجَبَت لِلحُرِّ تَقويضا",6,"ض",2,0],["قَوَّضَتهُ وَطالَما قَوَّضَتهُ","مُخبِلاتٌ أَعقَبنَ بِالتَخبيلِ",7,"ل",1,0],["قوَّضوا خيمة الإِباءِ، وباعو","للأعادي الأَوتادَ والأَطنابا",8,"ب",2,0],["قوَّضَ الركبُ صباحاً","وحدا بالركب حادي",9,"د",2,0],["قوَّض الرّكبُ وأبقى لي الأَسى","لا الجوى ولَّى ولا الصَّبر أقاما",10,"م",2,0],["قوضت أركان الهنا فتقوضت","من شاهق حتى عميق أساس",11,"س",1,0],["قُوّضت للموت أرحلهم","فصباحي بعدهن مسا",12,"س",2,0],["قوَّضوا أرحلَ المطي وساروا","كم عيون بكتهم بعيون",13,"ن",1,0],["قوضته عرشُها فاسترجلت","فانقضى الملك وأصبحنا سواء",14,"ا",2,0],["قوض السفر وما نال من ال","نفر الماضين في جمع مناه",15,"ا",2,0],["قوض الدهر دورهم ودعاها","شاخصات ولا أرى من وعاها",16,"ه",2,0],["قوضت خيمة الضلال بضرب","هو أرسى للمكرمات خباها",17,"ا",3,0],["قوضت القيظ يدٌ خيمت","له من السحب علينا خيام",18,"م",1,0],["قَوَّضَ الصَبرُ فَطَنَّبَ الأَسى","وَأَنا ما بَينَ هذَينِ لَقا",19,"ق",2,0],["قوّضوا ثم قربوا كل وجنا","ءأموناً زيافَةً شمالالا",20,"ل",2,0],["قوَّضت مُستَشفى وَمَدرَسَةً","أَكَذا اِقتِصادك أَيُّها الباني",21,"ن",2,0],["قوض الجهل مباني عزكم","وغدوتم عبرة للعالمين",22,"ن",1,0],["قوض خيامك عن أرض تضام بها","وجانب الذل إن الذل مجتنب",23,"ب",1,1],["قوض خباءك، فالتمس بلداً","تنأى، عن الغاشيك بالظلم",24,"م",1,0],["قوضّي للمسير أيّتها النوق","وجوبي مهامهاً وقفارا",25,"ر",2,0],["قوّض خيامَك من أرضٍ تُضَامُ بها","وجَانِبِ الذلَّ إن الذلَّ يُجتَنَبُ",26,"ب",1,1],["قوض العرش وانقضى السلطان","هوى ركن ما بني عثمان",27,"ن",1,1],["قوَّضت فَاِنتَقع الظّهائر ظُلمةً","وَقَفَلت فَاِشتَعل الديّاجر نورا",28,"ر",2,0],["قَوِّض رِحالَك عَن أَرضٍ تُضامُ بِها","فَالضَيمُ إِن دامَ نَفسُ الحُرِّ يَرديها",29,"ي",3,1],["قوضته فتراءى ماله وتد","ترثي له فاعلات أو مفاعيل",30,"ل",1,0],["قوّض خيامك راحلاً عن حوث","حوث الخبيث محلّ كل خبيث",31,"ث",1,1],["قوّضتَ آساسَ الضَّلالِ بعزمكَ ال","ماضي وشُدْتَ مباني الإيمانِ",32,"ن",1,0],["قوضت أطناب عز شامخ فمضى","وصرت لا في علا منه ولا عتب",33,"ب",1,0],["قوض خيامك عن أرض تعافُ بها","وانزل بأرض إليها المجد ينتسب",34,"ب",1,1],["قوَّض الصبر بعده وتولّى","فتوالت في رزئه الأحقابُ",35,"ب",1,0],["قوضّت له وسَنَدّ على نايف العرْب","يبغي السحاب ولا يرد انصياعه",36,"ع",2,0],["قَوَّضْتِ يا خَضْراءُ كُلَّ عُلومِهِمْ","وسَطَرْتِ في السَّاحاتِ أسْفارَ النِّضالْ",37,"ل",1,0],["قوض خيام الطامعين ليسمعوا","ما غاب عن فهر وعن مروان",38,"ن",1,0],["قوَّضتْهُ( بِريستِيرويْكا )الطغاة ِ","الحمرلمّا طغى عليهاالجنونُ",39,"ن",1,0],["قَوَّضَ الصومُ رَاحِلاً وأتَاكَ الْ","فطرُ يُهدِيكَ عِيدَهُ وامتداحِ",40,"ح",1,0],["قوَّضَ الصَّبرَ، وطنَّبَ الأسى","وأنا ما بينَ هذينِ لقا",41,"ق",2,0]]}