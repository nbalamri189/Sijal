{"poems":[[55,"خير الهوى ما نجا من الكمد","https://www.aldiwan.net/poem30628.html","المنسرح"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[469,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[566,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34418","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126182","الكامل"],[4858,"ويلُ الشّجِيّ من الخَلِيّ","https://www.poetsgate.com/ViewPoem.aspx?id=140780",""],[5431,"يا كسولا لست تصحو...نشيد العرب","https://www.poetsgate.com/ViewPoem.aspx?id=196613",""],[566,"أما ورب البيت لو لم اشغل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=507624",""]],"verses":[["كُلَّ أَصَمَّ الكُعوبِ مُعتَدِلٍ","خَلَت أَنابيبُهُ مِنَ الأَودِ",0,"د",1,0],["كلُّ أصحابهِ هُداةٌ فما أخ","سَرَ قوماً بهم لهم إغواءُ",1,"ا",2,0],["كل أصم ناطق له القنا","الصم عبيد والسوف خول",2,"ل",1,0],["كُلَّ أَصَمَّ قَلبُهُ مَهما يَلي","مِمّا يَعافُ الصالِحونَ يَأكُلِ",3,"ل",1,0],["كَلَّ اِصطباري لما كُلِّفتُ منه وَقَد","عدِمتُ صبري وَعَزمي حين كلّفني",4,"ن",2,0],["كلٌ أصيب فذا معزٍ حالمَا","يلقى معزىً فالورى شركاء",5,"ا",2,0],["كلٌّ أصابهمُ السِّنانُ بمقتلٍ","لكنّ غيثَ الصّبر جاد وأمطرا",6,"ر",2,0],["كل أصحابي بحب","عندهم سلْمٌ وصفحُ",7,"ح",1,0],["كُلَّ أَصَمَّ قَلبُهُ مَهما يَلي","رَضائِمٌ أَعيَت عِنِ التَنَقُّلِ",8,"ل",1,0]]}