poem/38202","الرمل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70827","الخفيف"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145640","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96696","الرمل"],[1470,"","https://poetry.dctabudhabi.ae/diwan/poem/216504","الخفيف"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202557",""],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106825","السريع"],[2660,"","https://poetry.dctabudhabi.ae/diwan/poem/203373","الخفيف"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83228","الرمل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127369","الرمل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127379","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201755","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118808","المديد"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112286","الرمل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35627","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77086","الخفيف"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75712","الرمل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45023","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83665","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83578","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83372","الخفيف"],[5225,"أمنياتي","https://www.poetsgate.com/ViewPoem.aspx?id=30818",""],[5232,"كنار الشام","https://www.poetsgate.com/ViewPoem.aspx?id=212657",""],[5582,"شَغَفَ القَلْبَ اشْتِياقاً وَنَهَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=63549",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[6218,"آن للصبر يغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65868&r=&rc=22",""]],"verses":[["كيفَ حاكوا ألحاظه بحسامٍ","وهي تفري حدّ الحسام بجفن",0,"ن",1,0],["كيف حالتْ بك الخلائقُ حتَّى","أصبحتْ بعد حمدِها مَذْمومه",1,"م",2,0],["كَيفَ حالي وَقَد غَدا اِبنُ جُبَيرِ","لِيَ دونَ الجيرانِ جاراً لَصيقا",2,"ق",2,0],["كَيفَ حَلَّلتَ يا عَليُ دَمي في","كَ وَإِنّي مِن شيعَةِ الأَنصارِ",3,"ر",1,1],["كَيفَ حالي إِذا تَكَدَّرتَ مِنّي","أَنتَ صافي وَما يَرومُ اِنتِصافي",4,"ف",2,0],["كَيْفَ حَلَّ السُّقْمُ فِي بَدَنٍ","خُلِقَتْ مِنْ حُسْنِهِ النِّعَمُ",5,"م",1,0],["كَيفَ حازَ الإنسان حذقاً وَنُطقاً","بعد أن كانَ نطفة أَمشاجا",6,"ج",2,0],["كيف حدِّثْ أغالها منك صرفٌ","في أبيدِ الزَّمانِ حيث طواها",7,"ه",2,0],["كَيْفَ حَالُ الإخْوَانِ فِي مِصْرَ يَا حَا","فِظُ مِنْ وَحْشَةٍ لِهَذَا البِعَاد",8,"د",1,0],["كَيْفَ حَالِي وَأَنْتَ أَدْرَى بِمَا خَلَّ","فْتَ لِي مِنْ فَجِيعَةٍ وَسهَاد",8,"د",1,0],["كَيْفَ حَمَّلْتَ وَالأَمَانَةُ وِقْرٌ","هَمَّكَ الضَّخمَ قَلْبَ ذَاكَ الْوَلِيدِ",9,"د",1,0],["كَيْفَ حَالِي أَنَا المَدِينُ وَدَيْنِي","فَوْقَ مَا أَسْتَطِيعُهُ مِنْ وَفَاءِ",10,"ا",2,1],["كَيفَ حَالِي وَفِي دَمِي لهَب","إِذْ أَرَى نَبْتَهَا وَقَدْ رُشَّا",11,"ش",2,0],["كَيْفَ حَالُ السَّجِينَ لَمْ يُعْدَمِ","الْقُوتَ وَلَكِنْ يُدْمَى مِنَ التَّقَيِّيدِ",12,"د",1,1],["كيفَ حاد المؤرِّخون عن القَص","دِ، وجاءوا بالإفكِ والبُهتان؟",13,"ن",1,0],["كَيفَ حالي، وَقد غَدا ابنُ جُبيرٍ","ليَ، دونَ الإخوَانِ، جاراً لَصِيقا",14,"ق",2,0],["كيف حالي وليس لي من صديق","مخلص يعرف القضاء ويحذر",15,"ر",1,0],["كيف حال أمرىء تَشُطُّ تِلمِسَا","نَ عليه وقد أقام بفاس",16,"س",1,0],["كَيفَ حالُ المَريضِ ماذا جَرى لَهُ","كَيفَ أَمسى تُرى وَفي أَيّ حاله",17,"ل",2,1],["كيفَ حَرَّمتَ عَلى جَفني الوَسَن","هَكَذا مِن فَرضِ الحُبِّ وَسَن",18,"ن",1,1],["كيف حالَت بعد الوفاءِ عهودُه","وتَمَارى هِجرانه وصُدُودُه",19,"د",2,1],["كيف حال الذي اخيف وقد","خافته اسد العرين وهو امان",20,"ن",1,0],["كيف حالتْ فارْتمى فوقَ الصَّعيدْ","خائِرَ القوَّةِ واهي الجلدِ",21,"د",1,0],["كَيفَ حالُ الغريبِ مع جار سوءٍ","في مقامِ الثواء لا يبرحانِ",22,"ن",1,0],["كيف حال التراب يا ربّ نوراً","عشيَت أعين الدُنى بسنائه",23,"ا",3,0],["كيف حالي ما بينَ دَهْرٍ وشِعْرٍ","ذاك والى هَدْمي وهذا بنائي",24,"ا",2,0],["كَيفَ حالي حينَما عنّي اِحتَجَبْ","كَيفَ أَسلو كَيفَ عَنهُ أَصبرُ",25,"ر",1,0],["كيف حالُ الأسرار بين دموعٍ","ليس ترقا وحرقةٍ ليس تُطْفَى",26,"ف",2,0],["كَيْفَ حَالُ القُرَى وأَطفال (كابو","لَ) وَسَرْبِ المَها وَذَاتِ الأَجِنّة؟",27,"ن",2,0],["كيفَ حالي وأنا منقبضٌ","وَزَماني في وثاقٍ وشبك",28,"ك",1,0],["كيف حيفا هل خيم الصمت فيها","وتناست ليالي الأعياد",29,"د",1,0],["كيف حال المستهام إذا","ما تخلى عنه خلان",30,"ن",1,0],["كيف حواها القبر في ضيقه","والبحرُ لا تحويه رُحبُ الفلا",31,"ل",2,0],["كيف حالي وهل لصب إليه","من سبيل فقال لي سل سبيلا",32,"ل",2,0],["كَيفَ حالَ الحُبُّ فينا جَفوَةً","وَالرَخاءُ اِرتَدَّ ضيقاً مُعدِما",33,"م",2,0],["كيف حازته أحابيل القفص","وهو يبغى الحب في عرض القفار",34,"ر",1,0],["كيف حالي يوم يد","عوني رحيلي للفراق",35,"ق",1,0],["كيف حطّمتِ للفَراش جناحاً","كان للسمع مُسكِراً بالرفيف",36,"ف",1,0],["كيف حاروا فيك واعجبا","يا منى سمعي ويا بصري",37,"ر",2,0],["كيفَ حال القوم في دار الخلود","يا تُرَى هم في نعيمٍ أم جحيم",38,"م",1,0],["كَيفَ حالُ الشَّيخِ الأَجَلِّ فَقالَ ال","حالُ ما حالَ هَكَذا مُستَقيمه",39,"م",2,0],["كَيفَ حالُ الشَجي حينَ تَبَدّى","وَهُوَ يَثني في مَشيِهِ أَردانَه",40,"ن",2,0],["كَيفَ حال الصب فيه بالسهر","وَهو لَو رام سرى ما ضربه",41,"ه",1,0],["كَيفَ حالي في اِرتِحالي بَعدَما","فارَقَت نَفسي عَديلَ النَفَسِ",42,"س",1,0],["كيفَ حالُ البِلادِ إِن هيَ حَلَّت","بَينَنا هل معاون أَو مُسانِد",43,"د",1,0],["كَيفَ حالي إِذا هرقتم دِماءاً","فَوقَ صَدري كَمَدمَعي المهراقِ",44,"ق",1,0],["كَيفَ حالُ المجدِ الرَفيعِ إذا ما","خَرَّ ميناهُ من رَفيعِ الطِباقِ",44,"ق",1,0],["كَيفَ حالي في يَقظَتي وَمَنامي","وَنَحيبُ العُشّاقِ دونَ نَحيبي",45,"ب",2,0],["كَيفَ حالي في غُربَتي بَينَ قَومي","لَهفَ قَلبي على القَريب الغَريبِ",45,"ب",1,0],["كيف حلّت بالعروبهْ النايباتي","وكيف تتفرّق بنا اليوم الدروب",46,"ب",1,0],["كيفَ حالُ الَّشام ِمنْ بعدِ النَّوى ؟.","لمْ أزلْ أهفو لِعطرِ الياسمينْ",47,"ن",1,0],["كَيْفَ حالِي وَأَنا مُنْقَبِضٌ","مِنْ زَمانِي فِي وِثاقٍ وَشَبَكْ",48,"ك",1,0],["كيف حالَ اليبابُ أسباب عيش","جعل الصخر جنةً فجلاها",49,"ا",3,0],["كيف حُلْمٌ يجفُّ في مُقلتينا","بعدما اليأسُ بالإرادة أعشبْ",50,"ب",1,0]]}