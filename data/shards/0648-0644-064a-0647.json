{"poems":[[63,"تجافيت عن عز ينال بذلة","https://www.aldiwan.net/poem45839.html","الطويل"],[63,"وعاذلة والفجر في حجر أمه","https://www.aldiwan.net/poem45936.html","الطويل"],[63,"مقيل النصر في ظلل القتام","https://www.aldiwan.net/poem46094.html","الوافر"],[63,"أسمراء عهدي بالخطوب قريب","https://www.aldiwan.net/poem46118.html","الطويل"],[63,"حلفت بمرقوع الأظل تشبثت","https://www.aldiwan.net/poem46126.html","الطويل"],[63,"تجنى علينا طيفها حين أرسلا","https://www.aldiwan.net/poem46150.html","السريع"],[63,"سرى البرق والليل يدني خطاه","https://www.aldiwan.net/poem46183.html","المتقارب"],[77,"سرى والدجى قد آن منه رحيل","https://www.aldiwan.net/poem36376.html","الطويل"],[86,"ملك النهى لا تبعدي","https://www.aldiwan.net/poem10479.html","مجزوء الكامل"],[86,"في ساحة البدوي حلت ساحة","https://www.aldiwan.net/poem68926.html","الكامل"],[73,"فز بالنجاح وأحرز الإقبالا","https://www.aldiwan.net/poem11937.html","الكامل"],[72,"لاعب شطرنج بفصل الشتا","https://www.aldiwan.net/poem18403.html","السريع"],[72,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[72,"لحظك في الفتك هو البادي","https://www.aldiwan.net/poem18557.html","السريع"],[72,"ليهن بدر الحسن في حلة","https://www.aldiwan.net/poem19556.html","السريع"],[51,"كثير نوالك في جنب ما","https://www.aldiwan.net/poem62854.html","المتقارب"],[51,"أسوغ لخلاني مساغ شرابهم","https://www.aldiwan.net/poem64944.html","الطويل"],[70,"أعلمتم أن النسيم إذا سرى","https://www.aldiwan.net/poem42922.html","السريع"],[85,"صحوت واستدركتني شيمتي الأدب","https://www.aldiwan.net/poem7890.html","البسيط"],[85,"قصر الأعزة ما أعز حماكا","https://www.aldiwan.net/poem7925.html","الكامل"],[45,"إن ترج طول عبيد الله لا تخب","https://www.aldiwan.net/poem11041.html","البسيط"],[45,"أما وهواك حلفة ذي اجتهاد","https://www.aldiwan.net/poem63502.html","الوافر"],[45,"إلى أي سر في الهوى لم أخالف","https://www.aldiwan.net/poem65154.html","الطويل"],[45,"تقضى الصبا إلا تلوم راحل","https://www.aldiwan.net/poem65618.html","الطويل"],[44,"متى أنت عن ذهلية الحي ذاهل","https://www.aldiwan.net/poem30372.html","الطويل"],[87,"أقلا ملامي في هوى الشادن الأحوى","https://www.aldiwan.net/poem8196.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85319","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54831","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55102","الرمل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[108,"كان يوم","https://www.poetsgate.com/ViewPoem.aspx?id=8396",""],[115,"هل هداك الله ففاضت عيوننا","https://www.aldiwan.net/poem41255.html","عموديه"],[128,"يا زروة قد أورثت","https://www.aldiwan.net/poem50516.html","مخلع الكامل"],[128,"ما زلت في لهو وفي طرب وفي","https://www.aldiwan.net/poem50542.html","الكامل"],[135,"للدهر في مسراه سر غريب","https://www.aldiwan.net/poem49188.html","السريع"],[143,"شرف الملوك عدت معاليك المدى","https://www.aldiwan.net/poem11752.html","الكامل"],[143,"من عف عن ظلم العباد تورعا","https://www.aldiwan.net/poem11773.html","الكامل"],[143,"يا للرجال لنظرة سفكت دما","https://www.aldiwan.net/poem11808.html","الكامل"],[160,"أهلا بما أنسى الذنوب المذنب","https://www.aldiwan.net/poem58813.html","الكامل"],[160,"عاملت ربك وانتدبت خصالا","https://www.aldiwan.net/poem58816.html","الكامل"],[160,"عيد اعاد الله من بركاته","https://www.aldiwan.net/poem58913.html","الكامل"],[160,"عيد حظى بك والأعياد تقتتل","https://www.aldiwan.net/poem58929.html","البسيط"],[160,"لقد أسرفت في بخس حظي وواجبي","https://www.aldiwan.net/poem59002.html","الطويل"],[169,"عني إليك حوادث الأيام","https://www.aldiwan.net/poem1669.html",""],[169,"أبت لك العزة القعساء والكرم","https://www.aldiwan.net/poem1674.html",""],[185,"صحبت بنات الدهر حتى أريننى","https://www.aldiwan.net/poem14566.html","الطويل"],[186,"ولي هر رميت به خبيث","https://www.aldiwan.net/poem43306.html","الوافر"],[198,"طرة ليل فوق صبح مبين","https://www.aldiwan.net/poem51878.html","السريع"],[204,"يقولون صف حرب الرعية والجند","https://www.aldiwan.net/poem53322.html","الطويل"],[261,"كف العتاب فما يمل العاتب","https://www.aldiwan.net/poem38371.html","الكامل"],[270,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[305,"كل امرئ دنياه ذا حدها","https://www.aldiwan.net/poem56557.html","السريع"],[353,"خطبتك بعلا للزواج إمارة","https://www.aldiwan.net/poem39772.html","الكامل"],[353,"أظباء رامة بالظبى آرامها","https://www.aldiwan.net/poem39962.html","الكامل"],[364,"كان المنى إذ تقضى ما عهدناه","https://www.aldiwan.net/poem60577.html","البسيط"],[364,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[364,"بيض طوالع من خيام سود","https://www.aldiwan.net/poem60954.html","الكامل"],[366,"لا زلت يوم الندى خراج غايات","https://www.aldiwan.net/poem17167.html","البسيط"],[366,"تغير من هم قلبي وعيني","https://www.aldiwan.net/poem17339.html","الوافر"],[371,"أبى الدمع إلا أن يسح ويسجما","https://www.aldiwan.net/poem57121.html","الكامل"],[380,"تعفى العقيق وكثبانه","https://www.aldiwan.net/poem49200.html","المتقارب"],[416,"زماني على رغم الحسود مسالمي","https://www.aldiwan.net/poem53996.html","الطويل"],[432,"بقيت في العد موصولا مدى الزمن","https://www.aldiwan.net/poem12338.html","البسيط"],[432,"سائل لوى خبت فذاك لواؤه","https://www.aldiwan.net/poem12550.html","الكامل"],[439,"عمري لقد أعذر الدمع الذي وكفا","https://www.aldiwan.net/poem34796.html","البسيط"],[439,"عادت عليك عوائد الأعوام","https://www.aldiwan.net/poem34806.html","الكامل"],[439,"اقبل ثناء وشكرا","https://www.aldiwan.net/poem34832.html","المجتث"],[439,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[439,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[439,"أنضيت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34916.html","الكامل"],[458,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[514,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[514,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[514,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[514,"عرج على البان وانشد في مجانيه","https://www.aldiwan.net/poem20803.html","البسيط"],[514,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[515,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[515,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[538,"الشبل قد تبع الأسود وقد غدا","https://www.aldiwan.net/poem48220.html","عموديه"],[551,"طريق المعالي عامر لي قيم","https://www.aldiwan.net/poem47237.html","الطويل"],[551,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[551,"إن كنت بالعفو ليس تعذرنا","https://www.aldiwan.net/poem47851.html","المنسرح"],[551,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[575,"نسيم ربعك أفديه بأنفاسي","https://www.aldiwan.net/poem3057.html","البسيط"],[575,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"]],"verses":[["وَلي هِمَّةٌ تَستَصغِرُ الدَّهرَ وَالوَرى","فَأَلئِم بِهِ دَهراً وَأَخسِر بِهِم ناسا",0,"س",2,0],["وَلَي هِممُ لا يُنكِرُ المَجْدُ أَنَّها","بِأَطْرارِ آفَاقِ السَّماءِ نُجُومُ",1,"م",1,0],["وَلي هِممٌ جَثَمْنَ على ضُلوعٍ","تُلَفُّ مِنَ الهُمومِ على كِلامِ",2,"م",1,0],["وَلي هِمَّةٌ تَأْبَى مُقامي على الأَذى","ضَجيعَ الهُوَيْنى ما أَقَامَ عَسيبُ",3,"ب",1,0],["ولي همّةٌ تَهْفو إِلى كلِّ سُؤْدَدٍ","تَفرّعَ آبائي ذُرا هَضَباتِهِ",4,"ت",2,0],["ولي هِمّةٌ تأبى وللحُبِّ لوْعَةٌ","أضُمُّ علَيها القَلبَ أن أتَنصّلا",5,"ل",2,0],["ولي هِمّةٌ بمَناطِ النُّجومِ","وفَضْلٌ تَوَشَّحَ دَهْري حُلاهْ",6,"ا",2,0],["وَلِي هِمَّةٌ مِنْ دُونِهَا كُلّ شَارِقٍ","يُرَجَّعُ عَنْهَا الطَّرْفُ وَهْوَ كَلِيلُ",7,"ل",1,0],["وَليَهنِكِ الخِدرُ الجَدي","دُ فَذاكَ دارُ المُستَقَرّ",8,"ر",1,0],["وَليَهنَئِ البَدَوِيَّ أَنَّ صَديقَهُ","عَن وُدِّهِ المَعهودِ لَيسَ يَحولُ",9,"ل",1,0],["وَليَهنِكَ التَأييدُ وَالظَفَرُ اللَذا","صَدَقاكَ في السِمَةِ العَلِيَّةِ فالا",10,"ل",2,0],["وليهنَ مغنى الشام من حظه","قدوم مولانا ومن تخته",11,"ت",2,0],["وليهنَ مولانا بحيث انتحى","قدر سما الكواكب في سمته",11,"ت",2,0],["وليهنك العام ساعي العامِ منشرحاً","بمجمل اليمن لم يحتج لشراح",12,"ح",1,0],["وليهنه العيد على أنَّ في","لقياهُ أعياداً لأعيادِي",13,"ي",1,0],["وَليهنَ سمعي عند حلو اسمه","ما كرر العذّال من عذلي",14,"ل",2,0],["وليهن شهر الصوم أتقى الورَى","وليبق ما شاء بلا مثل",14,"ل",1,0],["ولي همةٌ زاد في طولها","وفي عرضها أنّ كفيك بحرُ",15,"ر",1,0],["ولي همةٌ تطوي إلى الريّ ظَمْأها","عيوفٌ لطَرْقِ الماء والثَّمدِ البرض",16,"ض",1,0],["وَليَهنِ مَقدَمُكَ الصَعيدَ وَمَن بِهِ","وَمَنِ البَشيرُ لَمَكَّةٍ أُمُّ القُرى",17,"ر",2,0],["ولي همامة نفس حيث أجعلها","لا حيث تجعلها الأحداث والنوب",18,"ب",1,0],["وَليَهنِني بِكَ كُلُّ يَومٍ أَنَّني","في أَلفِ عيدٍ مِن سُعودِ رِضاكا",19,"ك",2,0],["وَليَهنِكَ البُرءُ مِمّا كُنتَ تَألَمُهُ","فَالأَجرُ في عُقبِ ذاكَ الشَكوِ وَالوَصَبِ",20,"ب",1,0],["وَلي هَمّانِ مِن ظَعنٍ وَلَبثٍ","وَكُلٌّ قَد أَخَذتُ لَهُ عَتادي",21,"ي",1,0],["وَلي هَفَواتٌ باعِثاتٌ لِيَ الجَوى","يُعَرِّضنَني مِن بَرحِهِ لِلمَتالِفِ",22,"ف",1,0],["وَلِيُّ هُدى سَفرٍ إِلى المَجدِ سائِرٍ","وَقائِدُ زَحفٍ لِلخُطوبِ مُقاتِلِ",23,"ل",1,0],["وَلي هِمَّةٌ تَمضي العُصورُ وَإِنَّها","كَعَهدِكَ مِن أَيّامِ وَعدِكَ حامِلُ",24,"ل",1,0],["وَلِي هِمَّةٌ لَوْلا الْعَوَائِقُ مَهَّدَتْ","يَدُ الْمَجْدِ فِي أُفْقِ السَّمَاءِ لَهَا مَثْوَى",25,"و",2,0],["وَلي هنالك آراءٌ وأَسئلةٌ","للناس أذكرها طوراً وأكتتم",26,"م",1,0],["وَلْيَهْنَإِ ابْنُ أَخِي بِحُسْنِ خِيَارِهِ","لِعَرُوسِهِ وَالعَقْلُ حُسْنُ خِيَارِ",27,"ر",1,0],["وَلْيَهْنِكُمْ كُلُّ بَيْتٍ فِيهِ بَثُّ أَسَى","وَنَدْبُ مَيْتٍ وَقَلْبٌ شَفَّهُ الكَمَدُ",28,"د",1,0],["وليهيأ للمعالي وليفق","شأنه شأن أبيه باجتهادك",29,"ك",1,0],["وَلِيُّهُمُ صِنوُ النَبِيِّ مُحَمَّدٍ","أَبو الحَسَنِ الفُراجُ لِلغَمَراتِ",30,"ت",1,0],["وليه ذا؟؟ واقف معنّز جسمه بيدّينه","وقفة اللي ربعه اتحبّه .. ولا تختاااره",31,"ر",2,0],["ولي همة شماء عن شيم علت","لقد اخذت الا عن الله جانبا",32,"ب",2,0],["وليهن عيدُ الفطر أنّ","ك عيدُه في كلِّ عامِ",33,"م",1,0],["وليهْن عيدُ الفطر إنك عيدُه","وليهن عيدٌ غيرُه من قابِل",34,"ل",1,0],["وليهنأوا بالعام عام الصفا","وليلبسوا ثوب السرورِ القشيب",35,"ب",1,0],["وَليَهنَكَ الظَفَرُ الَّذي بِحُلولِهِ","رَدَّ الضَلالَ الحَقُّ وَاِنتَصَرَ الهُدى",36,"د",2,0],["وَليَهنِ بَيتاً نِعمَةٌ وَهَبَت لَهُ","شَرَفاً أَعَزَّ مِنَ السِماكَ وَأَمنَعا",37,"ع",2,0],["وَلِيَهنِكَ العيدُ السَعيدُ مُضاعِفاً","لَكَ أَجرَ مَن صَلّى وَصامَ وَأَحرَما",38,"م",2,0],["وليهنه أَجرِ كاجر صلاة من","صلى وصام بشهره وتحزّبا",39,"ب",2,0],["وليهنكم ملكٌ يجمعُ شملكمُ","للصالحِات ويدفع الأثقالا",40,"ل",2,0],["وليهن من ألقى السلاح ولم يبتِ","يخشى الهوى يلقيه في مهواتهِ",41,"ت",2,0],["وليهنِكَ العيد واليوم الذي انتظمتْ","لك المحاسنُ فيه واكتفى الاملُ",42,"ل",1,0],["وليهنهِ منك هذا الاحتفال به","مما يصدِّقُ فيه قولَك العملُ",42,"ل",1,0],["ولي همة يرضى الإله انتسابها","إلى غير أخلاق الذياب الكواسب",43,"ب",1,0],["وَليَهنِكَ المُلكُ الَّذي أَسَّستَهُ","بِالكُرهِ مِن شانيكَ وَالإِرغامِ",44,"م",1,0],["وَليَهنك المُلكُ يا تاجَ المُلوكِ وَلا","زالَت تُباكِرُك السَرّاءُ وَالنِعَمُ",45,"م",1,0],["ولى همةٌ تبِغى النجوم وحالةٌ","تُصحِّفُ ما تَبْغيه فهْي لها ضِد",46,"د",1,0],["ولي هرّ رميت به خبيثٌ","يعاملني بأخلاق اللئام",47,"م",1,1],["وليهنأ النبلُ سماتٍ بدت","عليك من فهمك للسامعين",48,"ن",1,0],["ولي هاجس طَلق على كل لذةٍ","وما هاجسي وقفاً على الأجر والحمد",49,"د",1,0],["وليهنك الرتب التي من دونها","للنيرات منازل ومراتب",50,"ب",1,0],["ولي همّةٌ بينَ الجوانحِ دونها","تحدّرُ سيرٍ واندلاعُ لهيب",51,"ب",1,0],["وَليهنها الفِردوسُ تأوي بهِ","لِغرفٍ قَد شادَها زُهدها",52,"د",3,0],["وَليهنك العيد السَعيد وَبَعدَهُ","بِعُلوّ مَجدك عوده يهنينا",53,"ن",2,0],["وَليهنك العيد السَعيد فَلَم تَزَل","أَمثالُهُ بِكَ تَزدَهي أَعوامُها",54,"م",3,0],["وَلْيَهْنِه العِيدُ أَعني الدّهْرَ أَجمعَهُ","وقد تَساوى به في الحُسْن وَقْتاه",55,"ا",2,0],["ولي هُمومٌ توالَتْ بي طَوارقُها","حتّى حوَى خاطري من قَطْرِها غُدُرا",56,"ر",2,0],["ولْيَهنِكَ المتَجدّدِان تَتابَعَتْ","بُشْراهُما بالنّصْرِ والتّأييد",57,"د",1,0],["وَليَهنَئِ المُلكَ ما أَظهَرتَ مِن هِمَمٍ","لِلجِدِّ وَالجودِ مِن نارٍ وَجَنّاتِ",58,"ت",1,0],["وَلي هَمٌّ بِها وَبِهِم طَويلٌ","فَأَشكُرُها مَن نَواهُ",59,"ه",1,0],["ولي هِمَّةٌ أقصَى العِراقِ محلُّها","وقَلبٌ بأقصَى الشام أضحى مُخَيِّما",60,"م",2,0],["وَلي همة لا تَزال تتو","ق إِلى مَطلب عز إِمكانه",61,"ن",2,0],["ولي همّة فوق السَّماء وعفَّةٌ","تريني الغنى والعزّ عبدي وخادمي",62,"م",2,0],["ولْيَهْنِكَ الشمسُ يا بَدْرَ الكمالِ فَقَدْ","تَأَلَّقَ المجدُ من نُوَرَيْكُما الحَسَنِ",63,"ن",1,0],["وليَهْنَ هذا الدهرُ منك بسيدٍ","أصباحُه تُزهى به ومساؤهُ",64,"ا",3,0],["وليَهْنِكَ الفوزُ والزُّلفى وأَنفسُنا","يلقينَ من دونِكِ التَّبْرِيحَ والأَسَفا",65,"ف",2,0],["وليهنِكَ الفوزُ الَّذِي أَحرزْتَهُ","نُسْكاً بأَزْكى قُرْبَةٍ وصِيامِ",66,"م",1,0],["وليهنِكَ الفِطْرُ الَّذِي استقبلتَهُ","لَهِجاً بخيرِ تحيةٍ وسلامِ",66,"م",1,0],["وليَهْنِكَ المَجْدُ لبساً","والحمدُ كَنْزاً وذُخْرا",67,"ر",2,0],["وليهنِنا هَذَا وتِلْكَ وبعدَها","ورضاكَ فِي الأَيامِ أَهنأُ مَا هَنا",68,"ن",2,0],["ولْيَهْنِنَا وَلْيَهْنِكَ العيدُ الَّذِي","بِسَنَاكَ أَشْرَقَ صُبْحُهُ وأَصِيلُهُ",69,"ل",2,0],["ولْيَهْنِ كُلَّ مليكِ شِرْكٍ عِيدُهُ","يَوْمٌ إِلَيْكَ بُلُوغُهُ وَوُصُولُهُ",69,"ل",2,0],["وليَهْنِكَ الأَضحى الَّذِي أَضحى بِهِ","صُنْعُ الإِلهِ مُفَتَّحَ الأَبوابِ",70,"ب",1,0],["وليهنِكَ الأمرُ الذي ذلَّ به","لك العزيزُ وأقرّ الجاحدُ",71,"د",1,0],["وليهنِنا حجُّ بيتٍ منك دار على","شعائرِ البرِّ والمعروفُ مَشْعَرُهُ",72,"ر",2,0],["ولَيَهْنِكَ الصّومُ المُباركُ فِطرُهُ","واللَّهُ يختِمُه بحُسنِ جزائِهِ",73,"ا",3,0],["وليَهْنِكَ الشّهرُ المباركُ صومُه","وجزاكَ ربُّك عنه أفضلَ أجرِهِ",74,"ر",2,0],["وليَهْنِكَ العيدُ في تجديدِ عودتِه","بل فيكَ يا بهجةَ الدُّنيا نُهنّيهِ",75,"ي",2,0],["وليَهْنِكَ الشّهرُ الشريفُ وصومُه","وثوابُ واجِبه ومندوباتِهِ",76,"ت",2,0],["وليهن عيد الفطر رؤيته التي","إشراقها إشراق غرة فطره",77,"ر",2,0],["وليهنك القادم الميمون من رجب","يحدو ركائبه يمن وإقبال",78,"ل",1,0],["وليهنا الباشا التهامي المُرتَضى","بالعزِّ يبقى في الدهُور مُخلَّدا",79,"د",2,0],["ولي همّةٌ لا تحمل الضّيمَ مرّةً","عزائمها في الخَطْب جيشٌ عَرَمْرَمُ",80,"م",1,0],["وَليُهْنِك العيدُ الّذي عَزَبَتْ","عنه الهمومُ وأطبق الجَذَلُ",81,"ل",1,0],["وَليهنِك المِهْرَجانُ متَّئداً","بما ترجّى وغير متّئِدِ",82,"د",1,0],["وَلِي هِممٌ لمّا طَمحْنَ إلي العُلا","طمحْنَ كثيراتٍ وقلّ صِحابي",83,"ي",1,0],["وليهن خلقا بك الدُّنيا عروسُهمُ","فكُلُّ أَيامِهم أَيَّامُ أَعْراس",84,"س",1,0],["ولْيَهْنِكِ العامُ عامٌ كلُّه جَذَلٌ","أَتى إِليك بعيشٍ كلِّه نَضرِ",85,"ر",1,0]]}