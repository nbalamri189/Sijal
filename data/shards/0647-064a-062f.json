 إلاه راحما قمْ تقرّبْ","https://www.poetsgate.com/ViewPoem.aspx?id=199933",""],[5542,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=10200",""],[5638,"ديمة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=197900",""],[5691,"سفارة فوق الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=206030",""],[5704,"هيداء","https://www.poetsgate.com/ViewPoem.aspx?id=191600",""],[5784,"على الله اتكالي","https://www.poetsgate.com/ViewPoem.aspx?id=190038",""],[5790,"هي دارهم وأنا المحب المغرم","https://www.poetsgate.com/ViewPoem.aspx?id=112128",""],[5829,"موكب الهجرة","https://www.poetsgate.com/ViewPoem.aspx?id=215765",""],[5873,"جنة العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=215306",""],[5897,"من وحي ال21","https://www.poetsgate.com/ViewPoem.aspx?id=158793",""],[1920,"منديل وقطعة قلب","https://www.poetsgate.com/ViewPoem.aspx?id=201574",""],[5952,"مرّتْ","https://www.poetsgate.com/ViewPoem.aspx?id=213001",""],[5956,"مودة ورحمة","https://www.poetsgate.com/ViewPoem.aspx?id=182435",""],[5956,"تبَقَّتْ ساعة لبلادنا نصلُ","https://www.poetsgate.com/ViewPoem.aspx?id=207169",""],[5957,"أنا لست شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=187339",""],[5970,"أيها الراحلون جيلاً فجيلا","https://www.poetsgate.com/ViewPoem.aspx?id=130606",""],[6029,"أسمعتُمُ أنّ الورودَ تُضامُ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=188861",""],[4442,"لك من أبيك تحية وسلام","https://www.poetsgate.com/ViewPoem.aspx?id=171200",""],[6093,"الدُّرَّةُ والعَقِيْق","https://www.poetsgate.com/ViewPoem.aspx?id=190785",""],[6093,"(أوجزتُ كلَّ قضيتي في المطلعِ)*","https://www.poetsgate.com/ViewPoem.aspx?id=205546",""],[6131,"رسولُ الثَّرَى","https://www.poetsgate.com/ViewPoem.aspx?id=189281",""],[6134,"بزغت شموس السعد بالشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=169525",""],[469,"هي دار مية يا طليق العذل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574812",""],[5724,"هتف الزمان مهللا ومكبرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55143&r=&rc=10",""],[6189,"الكون الفسيح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76136&r=&rc=13",""],[6212,"صوت القادم من سواد الأسئلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1628&r=&rc=9",""],[6237,"حيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77869&r=&rc=11",""],[463,"سائلِ الدَّارَ غنْ سألتَ خبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60093&r=&rc=149",""]],"verses":[["هِيَ دُنيا إِن واصَلَت ذا جَفَت ها","ذا مَلالاً كَأَنَّها عُطبولُ",0,"ل",1,0],["هيَ دَيْنُ أيّامي فإنْ سمَحَتْ به","لمْ يبْقَ منْ شيءٍ عليْهِ يوسَى",1,"س",2,0],["هِيَ دَارُ الْهَوَى مُنَى النَّفْسِ فِيهَا","أَبَدَ الدَّهْرِ وَالأَمَانِيُّ جَمَّهْ",2,"م",2,0],["هِيَ دَعْوَةٌ الْحَقِّ التَّي أَوْضاعُهَا","جَمَعَتْ مِنْ الآثَارِ كُلَّ غَرِيبِ",3,"ب",1,0],["هِيَ دولة الْعَدْلِ الَّذِي شَمَلَ الْوَرَى","فَالشَّاةُ لاَ تَخْشَى اعْتِدَاءَ الذِّيبِ",3,"ب",1,0],["هي دائي إذا شكوت من الدا","ء وطبّي إذا أردت طبيبا",4,"ب",2,0],["هي دارٌ يَنْتابها ولُد قوم","جعلوا العلم للحياة مَدرارا",5,"ر",2,0],["هي دنيا بقاؤها مستحيل","فليقف عند حدّه التأميل",6,"ل",1,1],["هيَ دافع همِّي فأنشد بحرها","يا نيل مصر قد أتيتَ بمفرد",7,"د",1,0],["هي دنيا طَفوْا عليها وإن قا","لوا علونا بالظن والحسبانِ",8,"ن",1,0],["هي دنيا كثيرة الامتاع","ودعوها ولات حين وداع",9,"ع",1,0],["هي داءٌ في شَراسي","فِكَ ثاوٍ وغَليلُ",10,"ل",1,0],["هِيَ دُنيا كَحَيَةٍ تَنَفُثُ السُم","مَ وَإِن لانَتِ المَجَسَّةُ لانَت",11,"ت",1,0],["هِيَ دُنيا كَحَيَّةٍ تَنفُثُ السُم","مَ وَإِن كانَتِ المَجَسَّةُ لانَت",12,"ت",1,0],["هيَ دارُ مملكةِ الرضى فلأجلِ ذا","قد أُسْبِلَتْ دونَ الهمومِ ستورُها",13,"ر",3,0],["هِيَ دعوةٌ لك ما بسطتَ بها يداً","حتّى تَقبّلَ واستجابَ اللّهُ",14,"ه",1,0],["هِيَ دعوةُ الهادِي الأمينِ ونفحةٌ","ممَّن يَسوقُ الغيثَ فيما يَنفحُ",15,"ح",1,0],["هِيَ دِيمَةٌ خَرْسَاءُ أَلْقَتْ دَرَّهَا","وَكَأَنَّ مَا أَلْقَتْهُ حُمْرُ صَوَاعِقِ",16,"ق",1,0],["هِيَ دنشوايُ ولا أزيدْ","في السمع أحْرُفُها نَشِيدْ!",17,"د",1,1],["هيَ دارُ العيش العزيز بما ضَمْ","مَتْ قَضيبا لَدْنا وظبيا غَريرا",18,"ر",2,1],["هي دنياك أنت تعشقها","وهي مجبولة على الصد",19,"د",1,0],["هي دوحة نشأَت بمكة أَصلها","وعلى البسيطة ظُلِّلَت بغصون",20,"ن",1,0],["هي دار الحبيب ما هي داري","حلّها بالبها وما أنا داري",21,"ي",1,1],["هي دولة المولى سليمان الزما","ن ومن حوى في عزّه تقديما",22,"م",2,0],["هي دون قدرك في النظام ولو","جرت منها دموع كثير وجرير",23,"ر",1,0],["هي دعوةٌ بعثت لها لا بدّ من","إبلاغها والخيرُ قد يتأخّر",24,"ر",1,0],["هِيَ دَوْلَةٌ عُمَرِيَّةٌ سِيَراً","خَضَعَتْ لِعِزّةِ أمْرِهَا الدُّوَلُ",25,"ل",1,0],["هيَ دَارُك القُصوى أوَتْ لإِيالَةٍ","ضَمِنْتَ لها معَ نصْرِها إيواءَها",26,"ا",3,0],["هي دير النسيان راهبة الدن","صلاة الأرواح في الخلوات",27,"ت",1,0],["هي دَولةٌ أحيَيْتَها فاسلَمْ لها","حتّى تَنالَ بها المُنَى وتُنيلا",28,"ل",2,0],["هي دَولةٌ سَعِدَتْ بأوحدِها","فشَبيهُه في الدَّهْرِ ما رَمقوا",29,"ق",3,0],["هِيَ دَولة الإِحسان وَالعَدل","المُطَهرة المَذاهب",30,"ب",1,0],["هي دولةٌ بنيتْ على إسلامها","وبهِ سيبقى عزُّها وفخارُها",31,"ر",3,0],["هي دولة الإرهاب أهون فعَلةٍ","ممّا جنته جريمةٌ نكراء",32,"ا",2,0],["هي دولةٌ قانونها إرهابه","ودليلها في حكمها الأهواء",32,"ا",2,0],["هي دولةٌ موصولةُ الإقبالِ","محفوظةٌ بترادُفِ الإجلالِ",33,"ل",1,1],["هي دعوةٌ بسيوفِهِمْ تثبيتُها","فِي بَيعَةٍ أَيْمانُهُمْ توكيدُها",34,"د",3,0],["هي دُنيا لأهلنا لو ثوها","باقتناصِ الروؤس دون اعتذار",35,"ر",1,0],["هي دار العيش الغرير بما ضم","مت قضيباً لَدْنا وظبياً غريرا",36,"ر",2,0],["هي دوحةُ المجدِ التي","لا يُخلِفُ استثمارُها",37,"ر",3,0],["هيَ دار ميَّةَ يا طليق العدَّلِ","فقفِ المطايا أن وقفتَ بمنزلِ",38,"ل",1,1],["هي دمعة منّي جرت","أسفا على تلك البقاع",39,"ع",1,0],["هي درة لم يرض عالي قدرها","بحراً سوى كنف الإمام العاضد",40,"د",1,0],["هي دولةٌ بيديك واحدةٌ","لا تجعلنْها عامداً دُوَلا",41,"ل",2,0],["هيَ دولةٌ مازلتَ تَرْأبُ شعبَها","وتذُبُّ عنها كالئاً وتذودُ",42,"د",1,0],["هي ديننا والدين إن يك غيرها","لا زال دينا في البرية مخدشا",43,"ش",2,0],["هِيَ دُنْيَا بِهَا تَفَاءَلْتُ إِلاَّ","أَنَّهَا خِلْوَةٌ مِنَ الأَحْزَانِ",44,"ن",1,0],["هِيَ دونَ ما يُهدي إِلَيكَ وَإِنَّما","مِثلي عَلى ما فاقَ لَيسَ بِقادِرِ",45,"ر",1,0],["هِيَ دَيْنٌ عَلَيه وَهُوَ مَلِيءٌ","مُنْصِفٌ مِنَ العِدَى وَدَهْرِي ظَلُومُ",46,"م",1,0],["هي دلة لكنها","في القد أقمى من ذليلَه",47,"ل",2,0],["هي دولة حَبك السماء نظامها","أمن الضعيف بها ولان السيد",48,"د",1,0],["هي دارُ غيبتهِ فحيِّ قِبابَها","والثم بأجفانِ العيونِ ترابَها",49,"ب",3,1],["هي درة الصدف التي","نيطت بعرش الإستواء",50,"ا",2,0],["هي دولة الأقلام لا عاثت بها","يوماً عوائث دهرك الدوال",51,"ل",1,0],["هيَ دمنةٌ خضراءُ لكنْ قدْ حَوتْ","للناظرينَ عقارباً وأفاعِيا",52,"ي",2,0],["هي دار أحبابي ومسرح أينقي","ومحلُّ إطرابي ومطلع أسعدي",53,"د",2,0],["هي دار ندوتكم ومهبط وحيكم","دون الورى ولكلّ قوم منزل",54,"ل",1,0],["هيَ دولةٌ قامَتْ بكلِّ حَضارةٍ","وسيَاسَةٍ بتوازُنٍ وَحِيادِ",55,"د",1,0],["هِيَ ((دَوْلَةٌ الأُمراءِ)) أَرْسى طَوْدَها","وأقامَها بالعِزِّ في بُنْيانِهِ",56,"ن",2,0],["هي دولة التعمير في آفاقها","مدنٌ تلوحُ بشامخِ الأطوادِ",57,"د",1,0],["هي دولة التعليم في أرجائها","شمس العلومِ مُشعَّة الإمداد",57,"د",1,0],["هي دولة الشّورى بخير شريعةٍ","والرّأي قام لصالح الأفراد",57,"د",1,0],["هي دولة العدل الذي رفعت به","أركانها بحواضرٍ وبوادي",57,"د",2,0],["هي دولة الإسلام فيها عزُّه","وضياؤها من يقظة العبَّادِ",57,"د",1,0],["هي دعوة طنت بآذان العلى","وتناقلت أخبارها السمار",58,"ر",1,0],["هي دِيرَةٌ فلا يُشَكُّ فيهَا","يَقطَع بِهَا الأزوَامَ مَن يَجِيهَا",59,"ه",2,0],["هي درة الخدر المصون تلاعبت","بمجامع الارواح كيف تشاء",60,"ا",2,0],["هي دُميةُ المحراب في تمثالها","التمثيل به هي قبلة العشَّاق",61,"ق",1,0],["هِيَ دار لأَرضِها الغُر جاءَت","إِذ أَتاها محمد وَنَحاها",62,"ا",3,0],["هِيَ دَوحة قرشية مضرية","أَضحت بِأَنواع الفَخار مكلله",63,"ل",2,0],["هي دولة العز المنيعة جانبا","لكيانها شرف على كيوان",64,"ن",1,0],["هيَ دَوحةُ المَجد القَديمةُ وَالَّتي","يَوماً على لبنانَ أَلقَت ظلَّها",65,"ل",3,0],["هيَ دنيا والشقَا فِيها ضروب","لَيسَ للدّنيَا ودادٌ وذِمام",66,"م",1,0],["هيَ دنيا لا تقل ماذا دهاها","مثلما قد نشر الدهر طواها",67,"ه",2,1],["هيَ دارُ أحْبابي وموْضِعُ صبْوَتي","ومحَلُّ جيراني وربْعُ رِفاقي",68,"ق",2,0],["هي دولةٌ حفْصيّةٌ بك حقّقَتْ","مَظنونَها فيما رَجَتْهُ وحَدْسَها",69,"س",3,0],["هي درة في لجة من قسطل","ما كل غواص يغوص القسطلا",70,"ل",2,0],["هي دولة دواد أرسى مجدها","فاشتد ساعدها وعزّ حماها",71,"ا",3,0],["هي درة الغواص قد","كلف البصير بها وهام",72,"م",1,0],["هيَ دونَ مدح اللَّه فيكَ وفوق ما","مدح الورى وعلاكَ منها أكملُ",73,"ل",1,0],["هِيَ درَّةٌ مِن بحرِ علمٍ زاخِرٍ","عزَّت لعزوة من بِفَضل قَد كَفى",74,"ف",2,0],["هي دمعة للدين أسبلها لما","قد نال أهليه من الآماق",75,"ق",1,0],["هيدة الملكِ تجدي كل مفخرةٍ","عزيز لبنان من حازَ المشيريَّه",76,"ي",2,0],["هِيَ دُنيا الصَبي لا جَنَة الشَيخ","تَفيض النَعيم مِن كُل لَون",77,"ن",1,0],["هِيَ دُنيا لِلصالِحات موشا","ة بِما يَرتَضي وَما يستراق",78,"ق",1,0],["هي دنياً أم غادة خلابه","يتغنى بها امرء تلعابه",79,"ب",2,1],["هى دمعي وغنائي ومدامي","وهي فى حلمي جناح الطائر",80,"ر",1,0],["هي دورة الأيام ترجع ما مضى","ويعزّها أبناؤها الأرض التي",81,"ت",2,0],["هي داء لوالهٍ وهي إما","رام من علة شفاءً طبيب",82,"ب",1,0],["هي درّةٌ تُحيي الحياةَ بوبلِها","فتوضأتْ من روحِها السراءُ",83,"ا",2,0],["هي دموعك تجف وترجع تسيل","هو غيابك ب صمت آخر حلولك",84,"ك",1,0],["هي دعوةُ الإسلامِ، دِينُ محمدٍ","فيها حياةُ النّاسِ والتَّسْهيلُ",85,"ل",1,0],["هي دمعة عند اللقاء ذرفتها","فرحا وشوقا بدد الأحزانا",86,"ن",2,0],["هيَ دُرَّةٌ أضْحَتْ تُزَيِّنُ تاجَنا","شَرَفًا وكانتْ للنُّجومِ وِساما",87,"م",2,0],["هي درةُ الآفاقِ مَهبِطُ علمِها","وحضارةٌ شمختْ وفجرٌ يَصْدُقُ",88,"ق",1,0],["هِي دوحة مَلأ العيونَ رُوَاؤها","مخضَرَّةٌ مُمتدَّة الأغصان ِ",89,"ن",1,0],["هي دنيتي والهوى والقوت","وإن غبت عن وجهها كني",90,"ن",2,0],["هي درة الله صاغ جمالها","من نور قدرته بأبدع هيأة",91,"ه",1,0],["هيَ دُرَّةٌ فاقت بجوهرها الدررْ","والوجهُ نورٌ يستحي منهُ القمرْ",92,"ر",1,1],["هي دولة دلفت إليك بموثق","لم يغن عنك وقد عثرت فتيلا",93,"ل",2,0],["هي دُرَّةٌ وقَفتْ أمامَ شواطئي","ومَشتْ تُريقُ عليَّ من إعجابِها",94,"ب",3,0],["هي دوحة ماء النبوة لم تزل","يسقى منا بت اصلها العذب الندى",95,"د",2,0],["هي دعوةٌ عن ظهرِ قلبٍ من أخٍ","قد قال مرحى دونما حسبانْ",96,"ن",1,0],["هي درةُ الأصداف..من وجناتها","قد صغت منها للقلائد درَّها",97,"ر",3,0],