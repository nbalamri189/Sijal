{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39539","الرمل"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[115,"الحمد لله على ما الهما","https://www.aldiwan.net/poem2368.html","الرجز"],[234,"ما ذم يوم الفراق إلا","https://www.aldiwan.net/poem50910.html","مخلع البسيط"],[341,"فسارعوا للعلم أجمعينا","https://www.aldiwan.net/poem67804.html","عموديه"],[369,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[396,"يا صاح فك الناس والزم الدار","https://www.aldiwan.net/poem54577.html","عموديه"],[409,"آه من برق إليكم قد روى","https://www.aldiwan.net/poem33915.html","الرمل"],[500,"أخرجته يا سيدي","https://www.aldiwan.net/poem9810.html","مجزوء الرجز"],[505,"قل لمستصغرنا عن حسد","https://www.aldiwan.net/poem38008.html","الرمل"],[518,"لم يكفك الهجر فأهديت لي","https://www.aldiwan.net/poem67692.html","السريع"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83303","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87113","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86598","الخفيف"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44582","الرجز"],[841,"","https://poetry.dctabudhabi.ae/diwan/poem/199363","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77643","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77644","الرجز"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99981","السريع"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70944","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62507","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216450",""],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105065","الرجز"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105054","الرجز"],[2395,"","https://poetry.dctabudhabi.ae/diwan/poem/101401","الرمل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126229","الرجز"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126195","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87322","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2683,"","https://poetry.dctabudhabi.ae/diwan/poem/132505","الرجز"],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94317","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204589","الرجز"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115822","المنسرح"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115783","السريع"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112649","الرجز"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123881","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74078","المنسرح"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91964","الرمل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199025","الرجز"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59440","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135489","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135578","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111517","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45129","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133083","الرجز"],[5145,"أقبل كالبدر في مدارعه","https://www.poetsgate.com/ViewPoem.aspx?id=108254",""],[6188,"عبد الرحمن بن ملجم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75731&r=&rc=39",""]],"verses":[["أوْلها الدفءَ من الصدرِ الحنونْ","أو فهبْها النورَ من هذي العيونْ",0,"ن",1,0],["أوَّلُها جوامعُ البيانِ","وأصلُها معرفةُ اللِّسانِ",1,"ن",1,0],["أوَّلُهُ واللَّهِ أستعِينُ","أن يُعرفَ التحريكُ والسُّكُونِ",1,"ن",1,0],["أَولها دائرةُ الطويلِ","وهي ثمانٍ لذوي التَّفضيلِ",1,"ل",1,0],["أَوّلُها السَّريعُ ثم المُنسرحْ","ثم الخَفيفُ بعدهُ ثَمَّ وَضَحْ",1,"ح",1,0],["أَوَّلُها في الاصطِلاحِ الجارِي","أَن تَعدِلَ الأموالَ للأجذارِ",2,"ر",1,0],["أَوّلُه أَنّنا وقوفٌ","لِلّثم والضمّ والعِناقِ",3,"ق",1,0],["أولهاالخروج من ضلال","والثان نفع خلق ذي الجلال",4,"ل",1,0],["أولها صبرعلى الجوع الوسط","كأسد والثان حنبت الغلط",4,"ط",1,0],["أَوّلُه كان كَدَر","ثُمّ صفا على الأَثَر",5,"ر",1,0],["أولهن الجهل لا تريده","ولا تجالس من هم عبيده",6,"ه",1,0],["أو له الآداب قيدت فنهى","بالذي يهواه فيها وأمر",7,"ر",1,0],["أو له قلب صبور لا يرى","فارغاً إن مسه سهم القدر",7,"ر",1,0],["أوله كقدهِ","ثم كظهري عوجا",8,"ج",2,0],["أَو له قصرٌ رَفيعٌ شامِخٌ","والمَعاني أَنْتَ منها أَقصَرُ",9,"ر",1,0],["أولها سوءٌ وباقي اسمها","تخبر أن السوء يبقى سنه",10,"ه",1,0],["أولهم طائفة تشيعوا","وسوف أحكي كيف قد تفرعوا",11,"ع",3,0],["أولها السبق إلى الإيمان","والعلم بالسنة والقرآن",11,"ن",1,0],["أولهم وهو النبي الناطق","وبعده الوصي وهو السابق",11,"ق",1,0],["أَوَّلُهُ نَصرُكَ العَزيزُ وَأَيدٌ","وارو مِصراً لَهُ إِلَيكَ أَرامِ",12,"م",1,0],["أَو لَهُ قالَت العِناية أَرّخ","للخديوي في مصر أَبهى قُدوم",13,"م",1,0],["أَو له العز بِالهَنا قال أَرّخ","زِيْوَرٌ زينةُ القُرى لِلمَناصب",14,"ب",1,0],["أَوَّلُهُ فيهِ نَدىً مُبَغِّضُ","كَأَنَّهُ عَلى القُلوبِ يَقبِضُ",15,"ض",1,0],["أو لهفي على اعتدال قوام","عانقته برغمي الحدباء",16,"ا",2,0],["أَولها لا يسخرن مِنكَ أَحَد","وَالثاني تَأبى الظُلم في كُلّ بَلَد",17,"د",1,0],["أَولهم في البَحر عامَ فَغَرق","وَحارب الثاني وَبِالنار حُرِق",18,"ق",1,0],["أَوَّلُهُمْ مَنْتَظِرٌ آخرّاً","فَهُوَ عَلَيْهِ الدَّهْرَ ذُو حَبْسِ",19,"س",1,0],["أولُها الصدقُ وحفظُ الحيا","والعلمُ والإصلاحُ بين الأنام",20,"م",1,0],["أوله من نظرةٍ","تنقدُّ منه الأكْبُدُ",21,"د",1,0],["أولها فرد صحيح منصرف","مجرد أو زائد كما عرف",22,"ف",1,0],["أولهما في اللبس أو كحضرمي","أو فرضي قالي زبيري عبشمي",22,"ي",1,0],["أوّلها سين وسوف قد ولم","والتاء والنون وبا الانثى ختم",22,"م",1,0],["أوّلها التمام مثل الثاني","أبلغ بقصر مردف الإسكان",23,"ن",1,0],["اولها كرأسِ فردٍ يُشترط","وتبتدي الوسطى بثانٍ في الوسط",24,"ط",1,0],["أَوَّلُهُم صاحِبُهُ في الغارِ","أَفضَلُ تِلكَ العِصبَةِ الأَبرارِ",25,"ر",1,0],["أوّلَه قول الغزل","في حسينات الحلاه",26,"ا",2,0],["أوله تراه في آخره","ولم يكرر منه حرف فاعجبوا",27,"ب",3,0],["أوله يزيد عن ثالثه","وهو له عشر إذا ما ينسب",27,"ب",1,0],["أولها بنفسه ثالثها","لا تلح من فيها صبا أو ولها",28,"ل",3,0],["أو له أحرمت النفس هوىً","فاستطعنا نحو مغناه انطلاقا",29,"ق",2,0],["أو له سقنا الحشا مسعرة","نسكا تهفو لواديه اشتياقا",29,"ق",2,0],["أوَّلُهُم جاءَ بِروحٍ وأتى","آخرَهُم يَرعَى جميعاً إذ هَدى",30,"د",2,0],["أوَّلُها أتَى ولكن سُرِقَ","تلك شُرُوحَ شارح تَحَقَّقَا",31,"ق",2,0],["أوَّلُهُم آخر حروفِ الكوكب","عطارد فالدال مَيِّز واحسِبِ",32,"ب",1,0],["أَولُهُ في الشَّرطَينِ وَالعَنَاقِ","قِيَاسُهُم صَحِيحُ في الآفاقِ",33,"ق",1,0],["أولها أصل النهور بردا","كم شوق محرورٍ لديه بردا",34,"د",2,0],["أولها الأنصار نهر طافح","يجري ونشر الزهر منه فايح",34,"ح",1,0],["أولهم يا صاح وادي بردا","واد ترى للأنس فيه مددا",34,"د",2,0],["أوَّلها الأكْلُ عَلَى الخَلاَءِ","وَالصَّبْرُ عَنْ تَنَاوُلِ الغِذَاءِ",35,"ا",2,0],["أولها كيوان وهو الأعلى","والمشتري يليه إذ تدلى",36,"ل",2,0],["او لهب في فحمة الليل سرى","أو هو جيبٌ للدجى قد انخرق",37,"ق",1,0],["أوله في الهجاء مشتبه","بخير فعل مضى لباريه",38,"ي",2,0],["أوّله عشر لما بعده","لكن إذا اسقطت حرفين",39,"ن",1,0],["أولهم سبقاً إلى النِزالِ","وحربِ أهلِ الغَدرِ والضلالِ",40,"ل",1,0],["أولها نجم خفى النور","ليس بذي ضوء ولا كبير",41,"ر",1,0],["اولهن كوكب صغير","ليس له بين النجوم نور",41,"ر",1,0],["اولها كواكب صغيره","هن على راحة هذى الصورة",41,"ه",1,0],["اولها نجم خفى الضوء","يخفى على طالبه في الجو",41,"و",1,0],["اولها الكبش الذي هو الحل","يبدو من الافق اذا اغفر افل",41,"ل",1,0],["اولهن حيوان بحرى","ذو خلقة كخلقة الهزبر",41,"ر",1,0],["أولها لا بد من ثقيل","يكرهه القوم وذي تطفيل",42,"ل",1,0],["أَوّله للعلا وَآخره","وَمنتهى للنَدى وَمبتدأُ",43,"ا",1,0],["أَو له نفسٌ تساوى عِنده","كلَّ قَدرٍ لا يُبالي أَين حل",44,"ل",1,0],["أولهم آدم الصفي","وآخر محمد النبي",45,"ي",1,0],["أو لَهقٍ فردٍ شَبُوبٍ ناشطٍ","مُطرَّد الرّوقين مَدموم الصَّلا",46,"ا",1,0],["أولها من ذهبٍ وهو يرى","معرفة الذي يُرى يرى الورى",47,"ر",2,0],["أولهم هشامٌ بْنُ عمرو","وابنُ أمية زهيرٌ فادرِ",48,"ر",1,0],["أولهم إفيوس ألقى بالكره","فاندفعت وصفاً داروا",49,"ر",3,0],["أَوَّلُهُم كانَ الفَتى آسيُّسُ","فَعَفطَنوسٌ وَكَذا أُوفيتَسُ",50,"س",1,0],["أولِهِ مِنكَ الصَفا","وَوِصالاً مِنكَ داني",51,"ن",2,0],["أولهم يا صاح أبوهم آدم","وأفضلهم المختار من عدنان",52,"ن",1,0],["أوله ربع عشر ثالثه","وربع ثانيه جذر رابعه",53,"ه",1,0],["أوّلهم في أتون ِ الجحيم ِ,","وآخرهم بيننا مايزال ُ يقيم ْ",54,"م",1,0]]}