{"poems":[[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[68,"يا هلالا من سلطة العي حيي","https://www.aldiwan.net/poem38473.html","الخفيف"],[41,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[519,"أشذاء زهر الباقلاء تضوعت","https://www.aldiwan.net/poem20856.html","الكامل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130203","الكامل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119254","الخفيف"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126533","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100804","الكامل"]],"verses":[["يقق اللَّونِ كالمُلاءةِ إلا","لُمعاً في شَواهُ مثلُ الوِشام",0,"م",1,0],["يَقَقٌ مُذ بَدا العِذارُ عَلَيهِ","وَأَنبَتَ الآسَ في اللُجَينِ النَقِيِّ",1,"ي",1,0],["يَقَقُ السَراةِ كَأَنَّ في سَفِلاتِهِ","أَثَرَ النَؤورِ جَرى عَلَيهِ الإِثمِدُ",2,"د",1,0],["يققٌ بهِ نشف السواد تظنّهُ","فوق الغصون نضارة للمنظرِ",3,"ر",1,0],["يقق الجبين إذا بدت أعطافه","للغصن أوما بالركوع لقده",4,"د",2,0],["يققٍ يافعٍ يفاع يفاعٍ","يوح يوحي يتيمة بهماء",5,"ا",2,0],["يققاً كالعمود يستعذب الصف","ع ورأس أصم كالسندان",6,"ن",1,0],["يققيني في وداد بني الرفاعي","وصدقي في محبتهم يقيني",7,"ن",2,0],["يقق يروق وازرق","صافي الاديم واصفر",8,"ر",1,0]]}