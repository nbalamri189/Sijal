{"poems":[[79,"جفاك الحيا من رقعة ظلت عندها","https://www.aldiwan.net/poem36521.html","الطويل"],[88,"سليل الطين كم نلنا شقاء","https://www.aldiwan.net/poem10511.html","الوافر"],[32,"أقول لأطلاح برى هطلانها","https://www.aldiwan.net/poem29552.html","الطويل"],[90,"هلم إلى ذوق طعم الأدب","https://www.aldiwan.net/poem44429.html","المتقارب"],[23,"أعين ألا ابكي سيد الناس واسفحي","https://www.aldiwan.net/poem21352.html","الطويل"],[53,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[87,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[45,"فدا لك من يقصر عن مداكا","https://www.aldiwan.net/poem9756.html","الوافر"],[30,"إذا سقنا الفرائض لم يردها","https://www.aldiwan.net/poem5156.html","الوافر"],[22,"ألا آل ليلى أزمعوا بقفول","https://www.aldiwan.net/poem21653.html","الطويل"],[77,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[52,"ألا يا طيب قد طبت","https://www.aldiwan.net/poem64849.html","الهزج"],[48,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42729","الطويل"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[108,"سُحقًا لها","https://www.poetsgate.com/ViewPoem.aspx?id=179644",""],[34,"يقولون مسحور يجن بذكرها","https://www.poetsgate.com/ViewPoem.aspx?id=112",""],[132,"خليلى هل بعد السنين الغوائر","https://www.aldiwan.net/poem50598.html","الطويل"],[147,"هواكم وإن لم تسعفونا ولم تجدوا","https://www.aldiwan.net/poem11744.html","الطويل"],[147,"أما ومساع لا نحيط لها عدا","https://www.aldiwan.net/poem11755.html","الطويل"],[147,"ليهنك ما شادت لك الهمم العلا","https://www.aldiwan.net/poem11807.html","الطويل"],[147,"دعوا القول فيمن جاد منا ومن ضنا","https://www.aldiwan.net/poem11826.html","الطويل"],[164,"إذا لم يكن للصب من هجركم بد","https://www.aldiwan.net/poem58830.html","الطويل"],[189,"إذا دانت لك الدول","https://www.aldiwan.net/poem14630.html","مجزوء الوافر"],[203,"مكانك يا بدر وإن كنت واشيا","https://www.aldiwan.net/poem45229.html","الطويل"],[215,"أسافر في يوم الثلاثاء ليتني","https://www.aldiwan.net/poem46608.html","الطويل"],[240,"لولاك يا خير من يمشي على قدم","https://www.aldiwan.net/poem31766.html","البسيط"],[240,"أبثك مجد الدين حالا سماعها","https://www.aldiwan.net/poem32199.html","الطويل"],[285,"أما والهوى يوم استقل فريقها","https://www.aldiwan.net/poem60780.html","الطويل"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[369,"خيال زائر مني خيالا","https://www.aldiwan.net/poem60676.html","الوافر"],[369,"قليل لهم أن يحن المشوق","https://www.aldiwan.net/poem60831.html","المتقارب"],[463,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[466,"رويدكم فالفتح يصغره القدر","https://www.aldiwan.net/poem16340.html","الطويل"],[469,"ما بالها لم تجرني في بالها","https://www.aldiwan.net/poem3414.html","عموديه"],[475,"شر الحزاميين ذو السن منهم","https://www.aldiwan.net/poem4628.html","الطويل"],[482,"مغاني الهوى لم يبق إلا رسومها","https://www.aldiwan.net/poem15188.html","الطويل"],[543,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[556,"سلام على العمل الصالح","https://www.aldiwan.net/poem47889.html","المتقارب"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101467","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53884","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48537","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48522","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38924","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38418","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37971","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70924","البسيط"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105455","السريع"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44981","الطويل"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45386","الوافر"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132253","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69316","الرجز"],[2021,"","https://poetry.dctabudhabi.ae/diwan/poem/139357",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53105","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102514","الوافر"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82865","الوافر"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93399","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65954","الطويل"],[3071,"","https://poetry.dctabudhabi.ae/diwan/poem/34880","الرجز"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110770","البسيط"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127912","البسيط"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123894","الطويل"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86275","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109898","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132167","الوافر"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133305","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69975","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123518","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94545","الطويل"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127937","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139589",""],[4767,"دعوة صادقة","https://www.poetsgate.com/ViewPoem.aspx?id=178387",""],[5018,"إلى الله أشكو لا إلى الناس أَنني","https://www.poetsgate.com/ViewPoem.aspx?id=96336",""],[3271,"التائهة","https://www.poetsgate.com/ViewPoem.aspx?id=131013",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5413,"إنه الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=200596",""],[5431,"تُضاء بنا الأكوان حبا ولن نُطفا","https://www.poetsgate.com/ViewPoem.aspx?id=193477",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5809,"حديث الطرف","https://www.poetsgate.com/ViewPoem.aspx?id=205630",""],[5855,"أشارت بعينيها إشارة خائف","https://www.poetsgate.com/ViewPoem.aspx?id=196852",""],[5956,"اللغة العربية الفصحى ولهجاتها العامية","https://www.poetsgate.com/ViewPoem.aspx?id=202206",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[6331,"حلم موت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82023&r=&rc=4",""]],"verses":[["فلوْ سامَتَتْها الشّمسُ أُرْعِدَ قُرْصُها","ولثّتْ فلمْ تستطِعْ حَراكاً منَ البَرْدِ",0,"د",1,0],["فَلَو ساقَ القَضاءُ إِلَيَّ نَفعاً","لَقامَ أَخوهُ مُعتَرِضاً شَحيحا",1,"ح",2,0],["فَلَو سِرتَ حَتَّى تَقطَعَ الأَرضَ لمَ تَجِد","فتَىً كَاِبنِ أَشياخِ البَرِيَّةِ مالِكِ",2,"ك",1,0],["فلو سمع القوم ألحانها","لشقّوا عمائمهم والجبب",3,"ب",1,0],["فَلَو سُئِلَت عَنهُ مَعَدٌّ بِأَسرِها","وَقَحطانُ أَو باقي بَقِيَّةِ جُرهُما",4,"م",2,0],["فلو ساس من ألحاه جَهْلٌ عَذَرْتُه","ولكنّ من ألحاه عالٍ عن الجهلِ",5,"ل",1,0],["فلوس الشغل ما تأخي","ر شغل اليوم من عاداتي",6,"ت",2,1],["فَلَو سِرنا وَفي تَشرينَ خَمسٌ","رَأَوني قَبلَ أَن يَروا السِماكا",7,"ك",2,0],["فَلَو سَمِعَ الخَليفَةُ صَوتَ داعٍ","يُنادي اللَهِ هَل لي مِن مُجيرِ",8,"ر",1,0],["فَلَو سَلَمَت نَفسي لِعَمروِ بنِ عامِرٍ","لَقَد طالَ رَكبٌ نازِلٌ بِأَميلِ",9,"ل",1,0],["فلو سَمِعَ التثويبَ مَن كان رِمَّةً","رُفاتاً ولبّى الصوتَ مَن ضَمَّه قَبر",10,"ر",1,0],["فَلَو ساعَفَنا وَجهُ","كِ وَالدِرياقُ وَالطيبُ",11,"ب",1,0],["فلو سمَحَ الزّمانُ بها لضَنّتْ","ولو سَمَحَتْ لضَنّ بها الزّمانُ",12,"ن",1,0],["فَلَوْ سَامَنِي مَا يُورِدُ النَّفْسَ حَتْفَهَا","لأَوْرَدْتُهَا وَالْحُبُّ لِلنَّفْسِ قَاتِلُ",13,"ل",1,0],["فَلَو سُئِلَ الدُنيا رَآها حَقيرَةً","وَجادَ بِها سِرّاً وَلا يَتَبَجَّحُ",14,"ح",1,0],["فلو سابقتمو نِيرو","نَ نلتُمْ دونه السبقا",15,"ق",2,0],["فلو سألت مني حياتي بذلتها","وجدت بها إن كان ذلك من أمري",16,"ر",2,0],["فلو سمعتها الجاهليةُ قومنا","أضلّت بأبصارٍ لهم وبصائرِ",17,"ر",1,0],["فَلَو سَبَقا لَم تَفتَخِر بِاِبنِ مامَةٍ","إِيادٌ وَلَم تَذكُر مُهَلَّبَها الأَزدُ",18,"د",1,0],["فَلَو سارَ ذو القَرنَينِ في ظُلُماتِهِ","بِرَأيٍ كَذا لَاِبيَضَّ مِنها الَّذي اِسوَدّا",19,"د",2,0],["فَلَو سُطِرَت لِلمُنعِمينَ جَرائِدٌ","لَما ثَبَتَت فيها لِغَيرِكُمُ حِلا",20,"ل",2,0],["فَلَو سيلَ عَن أَمجادِهِم مَن أَعَفُّهُم","لِما في يَدَيهِ قالَ زَيدٌ وَما اِستَثنا",21,"ن",2,0],["فلو سار دون الجيش في طلب العلا","لأدوا بهم من سعده القتل والطردُ",22,"د",1,0],["فلو سَمحتْ بها الأيا","مُ لم يَسْمح بها الأَجَل",23,"ل",1,0],["فلو سألوني عن أمانيَّ لم أزد","على أن تميتني وأخلقُ ثانيا",24,"ي",2,0],["فلو سأل الله العليم كتمتهُ","وأنكرت أنى من هواه مقتّل",25,"ل",1,0],["فَلَو سَكَتُّ وَلَم أَنطِق بِشُكرِكُمُ","أَثنَت عِظامي بِما أَولَيتُمُ وَدَمي",26,"م",2,0],["فَلَو ساعَدَتني بِالبُكاءِ شُؤونُها","بَكَيتُ عَلى أَيّامِها بِدِماءِ",27,"ا",2,0],["فَلَوْ سَأَلَتْ ذاتُ الْوِشاحَيْنِ شِيمَتِي","لَخَبَّرَها عَنِّي الْيَقِينَ صَدُوقُها",28,"ق",3,0],["فَلو ساجَلَتها المذهباتُ لأصبَحت","بِها مذهباتٍ من قلوب ومن كتبِ",29,"ب",1,0],["فلو سلَختْ بنا في الشَّرْقِ شَهْراً","سبَقْتُ بها إلى الغَرْبِ الهلالا",30,"ل",2,0],["فلو سفَر اللّيلُ عن هَوْلها","لَما جَدّ فيه لِطَيْفٍ طُروق",31,"ق",1,0],["فلو سكبتَ خُلْقَك المطرِبَ في ال","كاسات ما غادرتَ إلا ثَمِلا",32,"ل",2,0],["فلو سألَ الرَّحمن طاعة كوكبٍ","لأذْعَنتِ الشِّعْرى ودانَ له البدرُ",33,"ر",1,0],["فلو سرى صبري في ليل الحشى","أخذه الطائف من خيالها",34,"ل",3,0],["فَلَو سَبَّني عَونٌ إِذاً لَسَبَبتُهُ","بِشعريَ أَو بَعضُ الأُلى جَدُّهُم كَعبُ",35,"ب",1,0],["فلو سُقِيَتْ تلكَ البلادُ مدامعي","لأَمْرَعَ مِن تَساكبهنَّ هشيمُها",36,"م",3,0],["فلو ساسَهُم أهلُ السِّياسَةِ والنُّهى","رجالُ فَرنسا ساسةُ العالَمِ الكُبرى",37,"ر",2,0],["فلو سُئِلَتْ عنك لاِستَعجلتْ","إلى منطقِ الشّاكر المادحِ",38,"ح",1,0],["فلو سيزوستريس افاق يوماً","لحار وناله الحسدُ الذميمُ",39,"م",1,0],["فلو سَمِعَ الماضون يوماً بمثلِها","لما هجرت بُشرى الورى لحظةً هندُ",40,"د",1,0],["فلو سقاك أو غذاك حبّا","لم يأمن الإنسان منك حربا",41,"ب",2,0],["فلو سلكت ملوك الشرق يوماً","سلوكك بيننا دنيا ودينا",42,"ن",2,0],["فَلَو سَأَلتَ الدُّنى يُعطيكَها بِرضى","وَلَو سَأَلتَ بِإِلحافٍ وَإِلحاحِ",43,"ح",1,0],["فَلَو سارَ رَكبٌ وَهوَ فيهِ بِظُلمَةٍ","بِغُرَّتِهِ فيها عَنِ الضّوءِ لاِستَكفى",44,"ف",2,0],["فَلَو سُئِلوا عَن فَضلِهِ وَاِتِّساعهِ","يَقولُ لِسانُ امْحالِ حدِّثْ عَنِ امْبحرِ",45,"ر",1,0],["فلو سألتهمُ حستى خلائقهم","لألَّفوا بين طبع الماء واللهب",46,"ب",1,0],["فلو سرت من نشرها نفحةً","لكان للميت منها النشور",47,"ر",1,0],["فَلَو سَمتَنا لَم نُعطِ عِلماً بِثَروَةِ","وَلَم نَرَ لِلتَّمييزِ كَفوا مِنَ المال",48,"ل",1,0],["فَلَو سقت السَماء الشَريَ أَرياً","لَما اِحلَولَت مَراعيهِ لِراعِ",49,"ع",1,0],["فلو سيح تهطال السماء بجوده","لما سح إلا بالجياد وبالتبر",50,"ر",1,0],["فَلَو سَكَتنا لَم تُضَر","وَالصُبحَ يُغنيهِ النَظَر",51,"ر",1,0],["فلو سألنا لِحسُنِ وجهكَ يا","هارون صَوبَ الغما أسقينا",52,"ن",2,0],["فلو سئلت دمياط عنك لأسندت","أحاديث تروى عن حنين وعن بدر",53,"ر",1,0],["فلو سئلوا بمعنى ما","حقيقته فما عرفوا",54,"ف",3,0],["فَلَو سُبِكت خَلائِقُه","لبهرجَ عندَهُ الذَّهبُ",55,"ب",1,0],["فُلُوسَنَبيلَن مَلاَقَه تِسعَه","هُم فَاقصِدِ الجٌزرَ سَريعاً وَآسعَ",56,"ع",1,0],["فَلو ساعَدت قالَت أَمِن قلّةِ الأَسى","تَبَقَّت دُموعي أَم مِن البَحر تَستَقي",57,"ق",2,0],["فلو ساعدت أيامه بحر عزمه","لنال الثريا مدراً للأماجد",58,"د",1,0],["فلو سمعت بشعري","في الدسّ والوترنَّه",59,"ن",2,0],["فلو سلكت سبيلي كنت متبعا","أوفى محب بما يرضيك مبتهج",60,"ج",1,0],["فلو سمعت عويل القوم من بعد","إذ يستغيثوا لهدت منك أركان",61,"ن",1,0],["فلو سمعت أذناك تحتي عواءه","لقلت ابن آوى عج في حندس الظلم",62,"م",1,0],["فلو سلكوا حقا بدا لهم سرها","غاب جميع الفرق في كل وجهة",63,"ه",1,0],["فلو سمحتَ بعنفي لستُ معترضاً","حزتُ النجاة وكم سامحت للندمِ",64,"م",1,0],["فَلَو سَمِعتُهُ الآن اذنُ ابن مَعبد","لَعادَ إِلى رمسٍ لِفَرط الحَيا يَعدو",65,"د",2,0],["فلو سَبَرتَ أُهَيلَ النارِ كُلَّهُمُ","وجدتَ أَكثَرَهم من بالجَمالِ سبِي",66,"ب",2,0],["فلو سلك القضاة على خطاها","لكن