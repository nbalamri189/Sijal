{"poems":[[65,"لحى الله دهرا لا نزال دريئة","https://www.aldiwan.net/poem46103.html","الطويل"],[32,"رأيت غرابا ساقطا فوق قضبة","https://www.aldiwan.net/poem29476.html","الطويل"],[53,"أبا الصقر لست أرى مهديا","https://www.aldiwan.net/poem8301.html","المتقارب"],[53,"أراد الغيث أن يحكيك جودا","https://www.aldiwan.net/poem61943.html","الوافر"],[52,"راحت سليمى تدعوك بالعند","https://www.aldiwan.net/poem63952.html","المنسرح"],[52,"راحَتْ سُلَيْمَى تَدْعُوكَ بِالْعَنَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=21671",""],[119,"قالوا ولعت بشيخون وليس بها","https://www.aldiwan.net/poem40882.html","عموديه"],[435,"قالت وقد رنحت بالتيه قامتها","https://www.aldiwan.net/poem40720.html","البسيط"],[438,"إن ابن عدلان له حيلة","https://www.aldiwan.net/poem12758.html","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202575","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65183","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91315","الطويل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123560","السريع"],[4885,"الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=188723",""],[5183,"إلى الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=180189",""],[5786,"إن رمتَ منّي السلوَّ بالفند","https://www.poetsgate.com/ViewPoem.aspx?id=50657",""]],"verses":[["فَقُلْتُ غُلامٌ مِنْ أُمَيَّةَ شَاحِبٌ","بِأَرْضِكُما نائي المَزارِ غَريبُ",0,"ب",1,0],["فَقُلتُ غُرابٌ لِاِغتِرابٍ وَقَضبَةٍ","لِقُضبِ النَوى تِلكَ العِيافَةُ وَالزَجرُ",1,"ر",1,0],["فقلتُ غبيٌّ كسا جهلُهُ","نواظرَهُ دون شمسي ضبابا",2,"ب",2,0],["فقلتُ غَلْطتَ جودُ أبي عَلّيٍ","يقصِّر عن مداه من أرادا",3,"د",2,0],["فَقُلتُ غَيُّ الشَبابِ يَتبَعُني","وَالحِرصُ عَجلانُ غَيرُ مُتَّئِدِ",4,"د",1,0],["فَقُلْتُ: غَيُّ الشَّبَابِ يَتْبَعُنِي","قُولِي رَضِينَا فَنَمْ وَلاَ تَجِدِ",5,"د",1,0],["فقلت غاية كل البارزات الى","هذا التراب ولي سر هناك بقي",6,"ق",2,0],["فقلتُ غصنٌ فقالت وهي معرضةٌ","قد شبه الغصن بعد الجهد بالغصن",7,"ن",1,0],["فقلتُ غرّتْكُمْ مخاريقُه","وغُيّبَتْ عنكُم مخازيها",8,"ي",3,0],["فقلت غرابتي هي في كياني","بلاءٌ ليس لي منه مناص",9,"ص",1,0],["فقلت غدا فدتك النّفس انجز","بوعدك لي فأسرع ما أجابا",10,"ب",2,0],["فَقُلت غُروبُ البَدر قَد آن وَقتُه","فَقَد فاجأتهُ شَمسُنا بِالأَشعّة",11,"ه",1,0],["فقلتُ غُضُّوا الطَّرْفَ عن وَضْعِهِ","فإنَّه يَمْشِي على الأعْيُنِ",12,"ن",1,0],["فقلت غرك يا أنوارُ مسكنتي","إن المحب قليلُ العزمِ والبأسِ",13,"س",1,0],["فقلت :غريبة ،فطفقت أسعى","رويدا نحوها , ما تزعمينا ؟",14,"ن",2,0],["فقلتُ غيرَ التوحيد باطِنُهُ","بباطني اليوم غير متّحد",15,"د",1,0]]}