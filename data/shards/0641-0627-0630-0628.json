{"poems":[[128,"يا راهب الدير تبنا عن محبتهم","https://www.aldiwan.net/poem23769.html","البسيط"],[347,"قلبي يحدثني","https://www.aldiwan.net/poem55325.html","منهوك البسيط"],[347,"إلى أين في هذه الفانية","https://www.aldiwan.net/poem55382.html","المتقارب"],[385,"إن كان منك الذنب والهجر","https://www.aldiwan.net/poem49219.html","أحذ الكامل"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44781","الرمل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138160",""],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67223","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106853","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106906","البسيط"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/198744","البسيط"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142903","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127206","المتقارب"],[4984,"نذيرُ الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=175528",""],[4984,"\" ليس الأدل \" 3","https://www.poetsgate.com/ViewPoem.aspx?id=175836",""],[5376,"أيها الغاصب ....إنها القدس","https://www.poetsgate.com/ViewPoem.aspx?id=188543",""],[5419,"نقوش","https://www.poetsgate.com/ViewPoem.aspx?id=31470",""],[5419,"معزوفة في عينيّ مصر","https://www.poetsgate.com/ViewPoem.aspx?id=32224",""],[5574,"يا سعد","https://www.poetsgate.com/ViewPoem.aspx?id=205998",""],[5736,"خمر الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=208882",""],[5943,"بهيُّ الشِّعرِ","https://www.poetsgate.com/ViewPoem.aspx?id=34291",""],[6035,"كذبة يوم القدس .. !","https://www.poetsgate.com/ViewPoem.aspx?id=175126",""]],"verses":[["فإذ بي المصطفى ماش على يده","سار كطيف الكرى في عين وسنان",0,"ن",1,0],["فاذ به قلب","مستأنس طرب",1,"ب",1,0],["فاذ بفكري قبس مظلم","واذ بذهني شعلة خابية",2,"ي",2,0],["فَأَذبهُ أَو عَذبهُ كَيفَ تَشا","وَبِما تَشا فَعذابُهُ أَجرُ",3,"ر",1,0],["فَأَذَبتَ الروحَ أَبكيكَ بِها","بَدلَ الدَمعِ فَسالَت في نَشيدي",4,"د",2,0],["فاذ بالعيون جميعا تطل","على عالم فاتن ساحر",5,"ر",1,0],["فأذَبْنَني والعُود يَحسُن خلقُه","بالنار والنفحاتُ منه تطيب",6,"ب",1,0],["فأَذبنَ حباتِ القلوبِ تفجعاً","وسكبنَ من درر الشؤون سحائبا",7,"ب",2,0],["فأذبلت حسراتُ الغصن نضرتَهُ","ولم يزل موجساً في يأسه فزعا",8,"ع",2,0],["فإذْ بنا بين إخوان نحبهم","وهم يحبوننا.. فالكل قد ظفروا",9,"ر",3,0],["فإذ بسطر قد تلا سطرا","حتى جرت قافيتي نهرا",10,"ا",1,0],["فاذبل تلك الورود لبعاد","وسل علينا حساما وصال",11,"ل",1,0],["فإذ بالمآذن تخبو فرارا","كهاربة في الدجى قادحةْ",12,"ح",2,0],["فإذْ بها تصعد فوق الذي","أبني ولا تسألُ عمن سَفًل",13,"ل",1,0],["فأذبْتُ عشقي في رمالِكِ علَّه","تتخضَّبُ الاهواءَ مهجةُ مشغفِ",14,"ف",1,0],["فإذ ببأسِ جميعِ الأهلِ بينهمُ","أضحى شديداً.. فهبَّ الرعبُ طوفانا",15,"ن",2,0],["فإذْ بي دون قصدٍ أو شعورٍ","قرضتُ الشعرَ في عينيكِ قرضا",16,"ض",2,0],["٤- فإذْ بها من قواريرِ السّراب، فما","لقيتُ ساقي سوى تلتفُّ بالسّاقِ",17,"ق",1,0],["فإذ بالسحرِ منبعُهُ قصيدي","وإذ بالحرفِ يسمو للأعالي",18,"ل",2,0],["فأذبحه بأبياتي","وأسلخ جلدَه الأسمرْ",19,"ر",1,0],["فإذ بها كذبة هُرْءٌ وشائجها","وارتدَّ يلعن منْ فاهوا به القَسم",20,"م",1,0]]}