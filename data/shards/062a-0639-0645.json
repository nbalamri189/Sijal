oem.aspx?id=53056",""],[6052,"معالي الخير","https://www.poetsgate.com/ViewPoem.aspx?id=34817",""],[242,"ألا قل لمن يبغي الى العز منفذا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563806",""],[6171,"مدينة الرسول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84675&r=&rc=5",""],[5080,"إلى لحظتيكَ يحجّ السراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88130&r=&rc=0",""]],"verses":[["تَعَمَّدَني بِالضَيمِ حَتّى شَكوتُهُ","وَمَن يَشكُ لا يَعدَم مِنَ الناسِ شاكِيا",0,"ي",2,0],["تَعَمَّدتُ بُعدي عَنهُ مِن غَيرِ سَلوَةٍ","لِيُعلِمَني يَومَ النَوى كَيفَ طَعمُهُ",1,"م",2,0],["تَعَمَّمتُموها سَوأَةً جاهِلِيَّةً","لَقَد فازَ مَن أَمسى بِها غَيرَ لائِثِ",2,"ث",1,0],["تَعَمَّدني بِنُصحِكَ في اِنفِرادي","وَجَنِّبني النَصيحَةَ في الجَماعَه",3,"ع",2,1],["تَعَمَّدَكَ الْمَحْبُوبُ بِالذَّاتِ بَعْدَمَا","جَرَى ضِدُّهُ وَاللهُ يَكْفِيهِ بالعَرَضْ",4,"ض",1,0],["تَعَمَّدتُ قَتلي في الهَوى وَتَعَمَّدا","فَما أَثِمَت عَيني وَلا لَحظُهُ اِعتَدى",5,"د",2,1],["تَعَمَّدَ بِالسَهمِ المُصيبِ مَقاتِلي","أَلا كُلَّ أَعضائي لَدَيهِ مَقاتِلُ",6,"ل",1,0],["تعمر الأبيات حسناً إذ به","وثنا الممدوح قد شيد القصيد",7,"د",1,0],["تَعمرُهُ بالنعيم والنِّعم ال","سُبَّغ ملبوسةً ومنتظره",8,"ر",2,0],["تعمَّمتُ إحصاناً لرأسيَ بُرْهةً","من القرِّ طوراً والحرور إذا سفعْ",9,"ع",1,1],["تعمر الحيات في كل يوم","منه حجراً ليس فيه امتناع",10,"ع",1,0],["تُعملُ في صيدِ كل صائدةٍ","ختلكَ طوراً وتارة طَرَدكْ",11,"ك",1,0],["تعُمُّ ببلواهُ يد منه سَلْطةٌ","يصول بها فظٌّ إذا اقْتَدَرَ اهْتَضَمْ",12,"م",1,0],["تَعُمُّ تَفَضُّلاً وَتَبينُ فَضلاً","وَأَنتَ المَجدُ مَقسومٌ مُشاعُ",13,"ع",1,0],["تَعَمَّدهُ في الأَمرِ الجَليلِ وَلا تَقِف","عَنِ الغَيثِ أَن تَروى بِفَيضِ بَعاعِهِ",14,"ع",2,0],["تعمّ الوفدَ من يده أيادٍ","كَأَنَّ البحرَ من يَدِهِ اختِصارُ",15,"ر",1,0],["تعمُّ المثاني السبعُ ستَّ جهاتِها","وخُصصَ بالتوحيدِ كلْماتُها العشرُ",16,"ر",1,0],["تَعَمَّدهُ يُغنِكَ بِالهَدي أَن","تُدَرِّسَ مُغَنيَّهُم وَالعُمَد",17,"د",1,0],["تعمرُ الكون لكي تهدمه","ليت ذياك البنا لمي كمل",18,"ل",1,0],["تعميرُ إسماعيلَ فيه عرفتُه","وثباتُ إبراهيمَ في وثباته",19,"ت",2,0],["تعمدني بنصحك في انفراد","وجنبني النصيحة في الجماعة",20,"ع",2,1],["تعمُّ أياديهِ ولكن نجارُهُ","تُخَصُّ بهِ دُونَ البريةِ عدنانُ",21,"ن",1,0],["تَعَمَّدَني بِالجَورِ كَي يَستَفِزَّني","فَلا كانَ ما يَرجو لَدَيَّ وَلا اِشتَفا",22,"ف",2,0],["تَعَمَّدتُ الإِطالَةَ عَن يَقينٍ","بِأَنَّ سَماعَ وَصفِكَ لَن يُمَلّا",23,"ل",2,0],["تعمى القلوب إِذا جاء القضاء فلا","ذو الطرف راءٍ ولا ذو مسمعٍ سمعا",24,"ع",2,0],["تَعمَّرتِ الدنيا بشكرِك والْتَهَى","به أهلُها حتى الحمام السَّواجع",25,"ع",1,0],["تَعُمُّ الآلَ وَالأَصْحابَ طُرّاً","وَسَالِكَ نَهْجِهِمْ فِي كُلِّ نَادِ",26,"د",1,0],["تَعَمَّمْ بِعِزٍّ وَهْوَ صَبْرٌ وَعِفَّةٌ","فَأَخْبِثْ بِمَنْ بِالذُّلِّ يَوْماً تَشَوَّذَا",27,"ذ",2,0],["تُعَمَّرُ وَالْمُيَسَّرَ فِيهِ عُمْراً","جَدِيداً ثَوْبُهُ وَالدَّهْرُ بالِ",28,"ل",1,0],["تُعَمَّرُ عُمْرَ الدَّهْرِ حَتّى إِذَا مَضى","أقَامَتْ وَمَا أَرْمَتْ علَى سِنِّ كَاعِبِ",29,"ب",1,0],["تعمم سيد الخلق المفدى","كذا الخلفاء في خير القرون",30,"ن",1,0],["تعمم فاتح البوسفور قهراً","وحاكم مصر ذو العز المصون",30,"ن",1,0],["تعممنا فسُدنا كل قطر","وبعد البر خضنا كل جون",30,"ن",1,0],["تعممنا فأخضعنا عتاة","طغاة طالما قالت ذروني",30,"ن",2,0],["تعممنا فأمنا نفوساً","وراقبنا المعاند بالعيون",30,"ن",1,0],["تعممنا فأرهبنا أسوداً","بتشييد المعاقل والحصون",30,"ن",1,0],["تعممنا فعلمنا أناساً","رأونا اليوم أعداء الفنون",30,"ن",1,0],["تعممنا فنازلنا أوروبا","بمركزها بجيش كالجنون",30,"ن",1,0],["تعممنا فتم الملك فينا","وساد الدين في كل البطون",30,"ن",1,0],["تعممنا فنلنا كل فخر","تطربشنا فهل نلنا أروني",30,"ن",2,0],["تَعمي الأَماني قَلبُهُ","فَيَرى بِعَينِ الأَرمَدِ",31,"د",1,0],["تَعَمَّم لَها إِنَّ العِمامَةُ جُنَّةُ","وَهَل يَنقَع المَصفوعَ أَن يَتَعَمَّما",32,"م",2,0],["تعمَّد إيناسي إِلى أن ألفته","كأني له من ضجعة المهد صاحب",33,"ب",1,0],["تعم الآل والأصحاب جمعا","مهاجرهم وباديهم والأنصار",34,"ر",1,0],["تعم آله مع الأنصار","والصحب ماغرد القمري",35,"ر",2,0],["تعمَّد حَبّات القُلوبِ كَأَنَّما","خَواطِرَها عِندَ القُلوبِ خَواطِرُ",36,"ر",1,0],["تَعُمُّ نُعماه ذا نقصٍ وذا شرَفٍ","كأنَّه البحرُ يحوي الدُّرَّ والصَّدَفَا",37,"ف",2,0],["تعم المشيرُ عليه في آرائه","الصادق العرفات في الثوران",38,"ن",1,0],["تَعَمَّمُوا بإِياةِ الشمسِ واشتملوا","رقراقَ نَهْيِ سرابِ البيدِ والْتَثمُوا",39,"م",3,0],["تعم آلك والأَعمام كلهم","والأَهل أَو من بكم لِلّه يقترب",40,"ب",1,0],["تعمَى على بصر الدليل فِجاجُها","تيهاً فُتخرَتُ بالبروق اللُّمَّعِ",41,"ع",1,0],["تَعمَى النوائبُ عن تأمُّلها","وتُطيلُ فيها نَومةَ السُّكرِ",42,"ر",1,0],["تعمّق فيها مُخلِباً ومُنيِّباً","وأقلعَ والنبعُ الأصمُّ صليبُ",43,"ب",1,0],["تعمُّ الفضا من أدْكن البُرْد قاتمٍ","وتكسو الثَّرى من أحمر اللون ناصع",44,"ع",1,0],["تعم عطاياه على القرب والنوى","وتهمي غواديه على الحر والعبد",45,"د",1,0],["تعمَّدْتُ قتلي فاقْتُلوني بقِتْلَتي","ولا تترُكوا في الحَيِّ مَنْ فِعْلُهُ عَمْدُ",46,"د",1,0],["تعمّدني زماناً ريبُ دهري","فلمّا أنْ تعمّدني رماني",47,"ن",2,0],["تَعَمَّدَ الدَّهرُ لي سُوءاً بُلِيتُ بهِ","والدَّهرُ ليسَ بناجٍ عِندَهُ أحَدُ",48,"د",1,0],["تعمم من لا يعرف العلم واحتبى","ودلس فانقادت إليه السوائم",49,"م",1,0],["تَعَمَّدنا رَيبَ المَنونِ بِضَربَةٍ","أَبى الدَهرُ أَن يَأتي لَها بِضَريبِ",50,"ب",1,0],["تَعمَّدني الزمانُ ولستُ خصما","فكن دُوني لَه خصماً ألَدّا",51,"د",2,0],["تَعَمَّدتها بالضَّمّ حَتَّى تَداخَلَت","ضُلُوعيَ فيما بَينَنا وضُلُوعُها",52,"ع",3,0],["تعم المخازن مثل البيوت","وفي نجز القصد خير معين",53,"ن",1,0],["تَعمَّدَها وأنتَ لها سفيحٌ","وخيرُ أُمورِك المتعمداتُ",54,"ت",1,0],["تعمد الذنب فألق","اه بما منه الحذر",55,"ر",1,0],["تَعمّدتُها بِالضمِّ ليلة زرتها","فَكان شفاء عند ذاك التعمّدِ",56,"د",1,0],["تعمّدته ظمّاً وسقي مضاجعي","فأثَّر منه العطر فوق نجادهِ",57,"د",2,0],["تعمّدني الخطبُ غَمراً وقرعا","وَأَحزَنَني الدهرُ حكماً وشرعا",58,"ع",2,1],["تَعَمُّداً بِالخُلُقِ الغِدَفْلِ","وَأَنْتَ يا ابْنَ العُمَرَيْنِ المُبْلِي",59,"ل",2,0],["تعمل في القاضي الخبيث الرشوة","أشد ما تفعل فيه النشوة",60,"ه",1,0],["تعمّد سلبها مني كثيفٌ","عديمٌ كل إحساس وذوقِ",61,"ق",1,0],["تعمّم بالطرف من طرفه","وقام خطيباً لندمانه",62,"ن",2,1],["تُعُمُّ مُطيعيها بِجَدْواكَ بَعْدَ ما","تُعمِّمُ عاصيها الحُسامَ المُذَلَّقا",63,"ق",2,0],["تعميرها مستلزمٌ","تخريب دار الآخره",64,"ه",1,0],["تعمر الدار بالخلائق غَرَّا","وبسوء الخصال تغدو خرابَا",65,"ب",2,0],["تعم الآل مع صحب","مداما بالهدى جانا",66,"ن",2,0],["تعمدّ الرفق بي يا حبّ محتسبا","فليس يبعد ما تهواه من تلفي",67,"ف",2,0],["تعمهم بغداء ثم تتبعهم","من بعده بعشاءٍ آخر الأصل",68,"ل",1,0],["تَعُمُّ لآلٍ كَذَا صَحبَهُ","وَكُلَّ مُحِبٍّ نَمَا حُبَّهُ",69,"ه",1,0],["تعمد أن يفاجئها بضرب","ينال به على الحلفاءِ نصرا",70,"ر",2,0],["تُعَمُِّ آل المُصطفى وصحابَهُ الأُلى","هُم نجومُ المُهتدينَ الزواهرُ",71,"ر",1,0],["تَعمى المَداري في جَون غَدائِره","وَحفُ النَباتِ لدُهنِ البانِ مجّاجِ",72,"ج",1,0],["تعمداً كان هذا القول منك فتب","وارجع إلى الحق، أين الفضل والكرم",73,"م",1,0],["تعمل في السَّرْد الظُّبا فيالها","جداولاً تحسن شق الغدر",74,"ر",1,0],["تَعُمُّ أتباعَه في الدين قاطبةً","والخلفاءَ الى السلطان محمود",75,"د",1,0],["تعم رأسي بالمشيب فساءني","وما سرني تقبيح نور بياضه",76,"ه",1,1],["تعُم بما تجني العقوبة غيرنا","هنا وغدا يشقى بها كل معتد",77,"د",1,0],["تَعمدت بِالحَسناء بَيت ابن عَمِها","وَإِن هِيَ قَد ذلت فَلا أَتَأَسَف",78,"ف",1,0],["تَعَمَّد لحذفِ فضولِ الكَلامِ","إِذا ما نَأَيتَ وعند التَّداني",79,"ي",1,1],["تعمم لها يا بن اليمين فإنها","عمامة مجد ذكرها غير هالك",80,"ك",1,0],["تعمموا بتريك البيض واتشحوا","بالبيض للحرب والادراع قمصان",81,"ن",1,0],["تعميرنا الأرض أن تبقى بحالتها","أما الخراب فما عدّوه معمورا",82,"ر",2,1],["تعم بنا بأبحر زاخرات","لتقذفنا إلى أعلى المراقي",83,"ق",2,0],["تَعم مَدى الأَيام آلاً بِأسرهم","وَصحباً رحاهم في الكَمال تَدور",84,"ر",1,0],["تعمى نهاراً وطول الليل مبصرة","زمنى بلا أرجل خفت ولا ركب",85,"ب",1,0],["تعملّتُ القَساوةَ من سمَيِّ","وأحرقتُ القلوب بنار هجري",86,"ر",2,0],["تعمل خيلاً طالما نجحت","ما عملت خيلٌ كأعمالها",87,"ل",3,0],["تعمّدَ السبطَ بشَتمٍ وبَسَب","ورأسَهُ الشريفَ بالسيف ضَرَب",88,"ب",1,0],["تعمّدت مقتلي فَقلت له","هناك يا مقتلي تعمّدها",89,"د",3,0],["تعمَّد حلْقي من يدَيه بعصره","محلّجة تنهدُّ منها اللَّهازمُ",90,"م",1,0],["تَعَمم أَياديه أَعاديه رَحمة