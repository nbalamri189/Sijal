{"poems":[[77,"وفدت عقيلتك التي أهديتها","https://www.aldiwan.net/poem35726.html","الكامل"],[74,"أسجايا كما ترق المدامه","https://www.aldiwan.net/poem13256.html","الخفيف"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[162,"ثار شوقي إلى الحمى","https://www.aldiwan.net/poem4116.html","مجزوء الخفيف"],[305,"مرت لنا بالحمى المأنوس أعياد","https://www.aldiwan.net/poem16841.html","البسيط"],[568,"بي إن عززت علي ذل","https://www.aldiwan.net/poem69530.html","الكامل"]],"verses":[["فهَفا لَها النّادي وحلّ لَها الحُبا","أهْلُ الكَلامِ مصاعِباً وقُيولا",0,"ل",2,0],["فَهَفا النَصلُ أَن تُناطَ ظُباهُ","وَتَلا النَصرُ أَن يَسُلَّ حُسامَه",1,"م",2,0],["فَهَفَتْ جَوانِحُه وقال على أسىً","سُبحانَ ربِّي ما لنا نَتجرَّم",2,"م",1,0],["فَهَفت مُهجتي جوىً","وَبَكت مُقلَتي دَما",3,"م",2,0],["فهفي على غرباء الدار حين نووا","ولم يطيفوا بهم أهل وعواد",4,"د",1,0],["فَهَفَوْتُ هَفْوَةَ غَلْطَةٍ","وَالحُرُّ يَهْفُو أَوْ يَزِلُّ",5,"ل",1,0]]}