{"poems":[[79,"وفدت عقيلتك التي أهديتها","https://www.aldiwan.net/poem35726.html","الكامل"],[76,"أسجايا كما ترق المدامه","https://www.aldiwan.net/poem13256.html","الخفيف"],[107,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[165,"ثار شوقي إلى الحمى","https://www.aldiwan.net/poem4116.html","مجزوء الخفيف"],[309,"مرت لنا بالحمى المأنوس أعياد","https://www.aldiwan.net/poem16841.html","البسيط"],[572,"بي إن عززت علي ذل","https://www.aldiwan.net/poem69530.html","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95573","الكامل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21473","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205806","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[5183,"السر الخفي","https://www.poetsgate.com/ViewPoem.aspx?id=180211",""],[5324,"رواء .","https://www.poetsgate.com/ViewPoem.aspx?id=207629",""],[5376,"علا القدسَ في أرجائها الحقُّ والعدلُ","https://www.poetsgate.com/ViewPoem.aspx?id=188562",""],[6147,"لغة الضاد في شهر العسل/الجزء 2 الرحلة الجغرافية","https://www.poetsgate.com/ViewPoem.aspx?id=153630",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[6237,"اليتيم السعيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77872&r=&rc=14",""],[572,"بي إنْ عَزَرْتُ عليكَ ذُلُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9437&r=&rc=294",""]],"verses":[["فهَفا لَها النّادي وحلّ لَها الحُبا","أهْلُ الكَلامِ مصاعِباً وقُيولا",0,"ل",2,0],["فَهَفا النَصلُ أَن تُناطَ ظُباهُ","وَتَلا النَصرُ أَن يَسُلَّ حُسامَه",1,"م",2,0],["فَهَفَتْ جَوانِحُه وقال على أسىً","سُبحانَ ربِّي ما لنا نَتجرَّم",2,"م",1,0],["فَهَفت مُهجتي جوىً","وَبَكت مُقلَتي دَما",3,"م",2,0],["فهفي على غرباء الدار حين نووا","ولم يطيفوا بهم أهل وعواد",4,"د",1,0],["فَهَفَوْتُ هَفْوَةَ غَلْطَةٍ","وَالحُرُّ يَهْفُو أَوْ يَزِلُّ",5,"ل",1,0],["فهفا بها أن تستزيد ولا","تغفو عن التحصيل والدّأبِ",6,"ب",1,0],["فَهفَّ إِلَيها الخِلُّ واجتَمعت لَها","عيونُ العُفاةِ الطامِحينَ إِلى الفَضلِ",7,"ل",1,0],["فهفَتْ كما تهفو الحمائم شفّها","طول المطار إلى ظلال رطيب",8,"ب",1,0],["فهَفَت لك الأَحلامُ وانشَدَهَت بك الأَفهامُ","من باهي نُعوتِكَ والكُنَى",9,"ا",1,0],["فهفا ولكن خلف محتوم القضا","كذبيحة الجزار حول طعامه",10,"م",2,0],["فهفا قلبي...... مفتونا إليها..","ولقد ضجّت بأشواقي الدماءُ",11,"ا",2,0],["فهفَّ له القلبُ الذي فيَّ لوعةً","يرومُ بسلواه اذا ما الهوى يسلو",12,"ل",2,0],["فهفا القصيدُ إلى الرصافة ناغيًا","وعلى جِنان الكرْخ غازَل آسا",13,"س",2,0],["فَهَفا لِصَوتِكَ قَلبُ كُلِّ مُفَكِّرٍ","وَإِذا بِقَومٍ أَنصَتوا وَتَطَلَّعوا",14,"ع",3,0],["فهفت مهجتي إليه حناناً","أبوياً يضمه ويزيدُ",15,"د",1,0],["فهفوتَ هفوة َ غلطة ٍ","والحرُّ يهفو وَيُذلُّ",16,"ل",1,0]]}