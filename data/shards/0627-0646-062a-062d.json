"],[308,"يا رسول الله يا أهل الوفا","https://www.aldiwan.net/poem16816.html","الرمل"],[332,"يا رفيقي وأنت موحى قصيدي","https://www.aldiwan.net/poem54935.html","الخفيف"],[332,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[332,"خطرت كالنسمة السكرى","https://www.aldiwan.net/poem55050.html","مجزوء الرمل"],[346,"يا شهيد الدين والوطن","https://www.aldiwan.net/poem55308.html","المديد"],[365,"أيها الخل قد صحبناك دهرا","https://www.aldiwan.net/poem68109.html","الخفيف"],[368,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[381,"إن تحبسوني وحقكم لن تحبسوا","https://www.aldiwan.net/poem59358.html","الكامل"],[406,"يا من هجاني عامدا","https://www.aldiwan.net/poem46459.html","مجزوء الكامل"],[407,"جاء يهدي نحوي بديع النظام","https://www.aldiwan.net/poem33414.html","الخفيف"],[413,"كيف أنساك يا أبا بكر أم كيغف","https://www.aldiwan.net/poem31853.html","الخفيف"],[413,"فئتي ألتجي إليه من الخطب","https://www.aldiwan.net/poem32208.html","الخفيف"],[420,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[433,"يا من له روض الفؤاد مكان","https://www.aldiwan.net/poem41036.html","الكامل"],[445,"عوجوا رقاب اليعملات الذلل","https://www.aldiwan.net/poem14338.html","الكامل"],[461,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[467,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[471,"يا أيها الحاوي الذي لم تزل","https://www.aldiwan.net/poem59554.html","السريع"],[498,"يا نفس صبرا وإلا فاهلكي جزعا","https://www.aldiwan.net/poem10236.html","البسيط"],[561,"يا نديمي إن غابت الناس عني","https://www.aldiwan.net/poem33759.html","الخفيف"],[561,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[561,"فرحي يا فرحي يا فرحي","https://www.aldiwan.net/poem34662.html","الرمل"],[565,"بين قلب المحب والأحداق","https://www.aldiwan.net/poem52949.html","الخفيف"],[565,"طيف إلي سرى عن غير ميعاد","https://www.aldiwan.net/poem52954.html","البسيط"],[570,"ما اعتاد عيني غمض","https://www.aldiwan.net/poem69625.html","مجزوء الرجز"],[745,"","https://poetry.dctabudhabi.ae/diwan/poem/67397","الخفيف"]],"verses":[["أَنتَ حَسبي وَفيكَ لِلقَلبِ حَسبُ","وَلِحَسبي إِن صَحَّ لِيَ فيكَ حَسبُ",0,"ب",1,1],["أَنتَ حَياتي وَسِرُّ قَلبي","فَحَيثُما كُنتُ كُنتَ أَنتَ",1,"ت",1,0],["أنتَ حلوٌ وأنت مرٌّ وما تُلْ","فَظ كلّا وكلُّ مُرٍّ لفيظُ",2,"ظ",1,0],["أنتِ حلالٌ غيرُ محجورةٍ","حسبي بتشويهك تحليلا",3,"ل",2,0],["إِن تُحرِجوا الرِئبالَ في عَرينِهِ","يَذَرُ السُكوت وَيَركَبُ الأَخطارا",4,"ر",2,0],["إِن تَحفَظوها تَحفَظوا في نَسلِكُم","ذِكراً يُخَلِّدُ في اللَيالي رَونَقا",5,"ق",2,0],["أَنْتَ حقلٌ مُجْدبٌ قَدْ هَزَأتْ منه الرُّعاةْ","أَنْتَ ليلٌ مُعْتِمٌ تَنْدُبُ فيه الباكياتْ",6,"ت",1,0],["أَنتَ حَسبي مِن المُنى","لَيتَني كُنتُ حسبكا",7,"ك",2,0],["أنت حررت مصر إلا قليلا","آه لو تم ذلك التحرير",8,"ر",1,0],["انت حاربت للتحرر اعوا","ماً طوالا فحاربي من جديد",9,"د",1,0],["انت حيّ وانت ميت وهذا","من خصال قد حازها الخالدونا",10,"ن",2,0],["أَنتَ حاتِمٌ","لِلقِرى اِنتَدَب",11,"ب",1,0],["أنتَ حَديثي في النّومِ واليَقَظَهْ","أَتْعَبْتُ مِمّا أَهْذي بِكَ الحَفَظَهْ",12,"ه",1,1],["أَنتَ حَوَّلتَهُ إِلى الحالَةِ الأو","لى وَقَد كانَ حائِراً يَستَديرُ",13,"ر",1,0],["أَنتَ حَسبي مِن كُلِّ مَن وَطِئَ الأَر","ضَ وَحَسبي بِأَنَّ مِثلَكَ حَسبي",14,"ب",2,0],["أَنتَ حُرُّ الأَديمِ لَم تُشرَ في الرِق","قِ بِنَزرِ اللُجَينِ وَالإِبريزِ",15,"ز",1,0],["أنتَ حي برغمِ عادِ الفناءِ","لا يُصاغُ الرثاءُ للأحياءِ",16,"ا",2,1],["أنتِ حسن في ضحاه لم يَزَل","وأنا عنديَ أحزان الطفَل",17,"ل",1,0],["إِنَّ تَحتَ الأَحجارِ حَزماً وَعَزما","وَقَتيلاً مِن الأَراقِمِ كَهلا",18,"ل",2,1],["إِنَّ تَحتَ الأَحجارِ وَالتُربِ مِنهُ","لَدَفينا عَلا عَلاءً وَجَلّا",18,"ل",2,0],["إِنَّ تَحتَ الأَحجارِ جَدّاً وَليناً","وَخَصيماً أَلَدَّ ذا مِعلاقِ",19,"ق",1,0],["إِن تَحوِ خَصلَ المَجدِ في أَنفِ الصِبا","يا اِبنَ الخَليفَةِ يا أَبا العَبّاسِ",20,"س",1,0],["أنت حسابٌ بلا عطاءٍ","وَهْوَ عطاءٌ بلا حسابِ",21,"ب",1,0],["إن تَحرَّيْتَ اللُّبابَ المُنتقَى","فاجعلِ الأخلاقَ ممّا تنتقي",22,"ق",2,0],["إنْ تُحْيِ آثارَهُ مِنْ بَعْدِ ما دَرَسَتْ","فإنَّكَ النِّيلُ تُحْيي الأرضَ والمَطَرُ",23,"ر",1,0],["إنْ تُحْيَ آمالي بِرُؤْيَةِ عيسى","فَلطالما أَنْضَتْ إليه العِيسا",24,"س",2,1],["إِن تَحُلّوا شاماً فَخَمرُ جِبالٍ","أَو عِراقاً فَالشُربُ مِن نَهرِ بيلِ",25,"ل",1,0],["إن تحت الأحجار حزما وعزما","وخصيما ألد ذا مغلاق",26,"ق",1,0],["انتحر واترك الحَيا","ة لِقوم تنعموا",27,"م",3,1],["إن تحت الرماد ناراً لو اَنَّ ال","ساسة اليوم فتشوا في الرماد",28,"د",1,0],["إنَّ تحت الصدورِ جذوةَ مَوْتو","رٍ، وخلف الحدودِ زأْرَة ناقم",29,"م",1,0],["إنتحرتم نحن الذين انتحرنا","بحياةٍ أمواتها الأحياء",30,"ا",2,0],["أَنتَ حَيثُ المُقَرَّبونَ فَأَبشِر","وَسَل اللَهَ أَن أَراكَ قَريبا",31,"ب",2,0],["انتحرتم ؟! نحن الذين انتحرنا","بحياة ٍ امواتها أحياءُ",32,"ا",2,0],["إن تحت القناع والوجه وجها","يخفي تحت ظهره وهو بادي",33,"د",2,0],["إن تحت الأحجار حدا ولينا","وخصيما ألد ذا معلاق",34,"ق",1,0],["إن تحمَدوا او تذُمُّوا أنَّ شافعتي","أنّي رأيتُ ، وما راءٍ كمَن سَمِعا",35,"ع",2,0],["أن تحمِ عن أهل الهوى كأس اللَّمى","فالخمرُ أجود ما يكون عتيقه",36,"ق",2,0],["إنت حسبي وفيك للقلب حسب","وحسبي أن صح لي فيك حسب",37,"ب",1,1],["انت حاز يتنا عن الحب صدا","ولعمري بفعله المرء يجزى",38,"ز",2,0],["انت حاكيت نور من فيه همنا","مذ اعارت انواره انوارك",39,"ك",1,0],["انت حصن الملهوف والباذل المع","روف والعاجزون من احزابك",40,"ك",1,0],["إنْ تحِص أَفعالا لهم وتجازهم","مَقترك واستولوا عليك وأَرْجَفُوا",41,"ف",3,0],["أنتَ حرٌّ ما دام سرُّك في القلب","فإن باحَ صرتَ مثلَ الأسيرِ",42,"ر",1,0],["إن تحيرتَ قِفْ وقوفَ","سؤال لا تُداهِن مخافةَ التغييرِ",42,"ر",1,0],["أَنْ تَحْنِ يَوماً بِعَطفٍ لِلشَجِيِّ فَقَد","أَحَبَت لَها عاشِقاً بِالروحِ يَفديها",43,"ي",3,0],["إن تحملي فلكاًَ قد دارَ دائرهُ","فدونكَ اللجُّ دوَّارٌ بدوَّارِ",44,"ر",1,0],["أنت حياتي وأنت لي تلفٌ","وفيك لي نعمةٌ وفيك بَلا",45,"ل",2,0],["أَنتِ حَسناءُ مِثل حَيَّة عَدنٍ","كَورودِ الشارونِ ذاتِ العُطورِ",46,"ر",1,0],["أَنتَ حَبيبٌ لِكُلِّ نَفسٍ","وَكلِّ حِسٍّ وَكُلِّ طَبعِ",47,"ع",1,0],["أَنتَ حَبلُ اللَهِ الَّذي فازَ مَن أَد","نَتهُ مِنهُ مَوَدَّةٌ وَوَلاءُ",48,"ا",2,0],["أنت حسبي أمّا إليك فلا قل","ت لمن رام في سواك مراما",49,"م",2,0],["أنت حبل اللَه من أمسكه","فاز بالخير وبالعهد وفا",50,"ف",2,0],["إنّ تحت السكون تعودي الأعاصي","ر انتظارا ليومها المعهود",51,"د",1,0],["أنت حيرى بدَت لحيران في القف","ر فزادت شمس الهوى إشراقا",52,"ق",2,0],["أنت حبّبتَ لي المنيّةَ والقب","رَ فأمست لقياهما تأميلي",52,"ي",1,0],["أنت حلم سابح في","مائج من صبواتي",53,"ي",1,0],["انت حي في ضمائرنا","انت لا تفنى مدى الزمن",54,"ن",1,0],["اِن تَحقق رَجاي فيكَ فَأَهلا","أَنَ وَاللَهِ بِالمَكارِم أَحرى",55,"ر",2,0],["أنت حَقّقْتَ ما ادَّعَى ذاك والصّا","دِقُ من فَجْرِيَ الظَّلامُ الثّاني",56,"ن",2,0],["إن تحبسوني وحقِِّكم لن تحبسوا","مني لساني والقريضَ القارضا",57,"ض",2,1],["إنْ تحفظِ الودَّ الأكيدَ","فإِنَّكَ الثقة الأَمينُ",58,"ن",1,0],["إن تحقيق الحق يحتاج فيه","بعض بسط الكلام للأفهام",59,"م",1,0],["أنت حيثُ اتّجهتُ في أَسوَدَي عي","ني وقلبي ممثَّلٌ لا تَزولُ",60,"ل",1,0],["أنتَ حلَّيتَ بالمكارِم أهلَ ال","عصرِ حتّى تعرَّفَ المجهولُ",61,"ل",1,0],["إنْ تحاولْ شَخْصَهُ تَلْقَ علًى","صَحِبَ العِزَّ يميناً وشمالا",62,"ل",2,0],["ان تحسبوه على المحب جناية","فالعفوان العفو منك امان",63,"ن",1,0],["إن تحرموا فهو اللباس لكم وإن","أحللتم فهو الثواب لمحلل",64,"ل",1,0],["أَنتَحِي أعزلَ فيه","وسلاحُ الدهرِ شاكي",65,"ك",2,0],["أنت حسام سجنتَ بالغمد لو","سلَّك سلَّ الحسام وانتصلك",66,"ك",1,0],["إِن تَحوِنا مِصرُ فَكَم مَربَعٍ","فيهِ غُصونٌ وَعَراجينُ",67,"ن",1,0],["إن تحمد اللّه شكراً عند نعمته","فراقب اللّه صبراً عند ما رجعا",68,"ع",2,0],["أنت حق وباطل نحن هذا","جاءنا في تصديق قولِ المغني",69,"ن",2,0],["أنت حق وأنا الباطل لي","جولة والحق بالدولة قاما",70,"م",2,0],["أنت حق واحد لا غيره","غيره أنت فَطِبْ وانشرح",71,"ح",1,0],["إن تَحُلْ بَيننا النَوَى لم تَحُلْ إنْ","شئتَ بين الأقلامِ والأوراقِ",72,"ق",1,0],["إن تُحرَمِ العينُ مرآهُ فقد رُزِقَتْ","حديثَهُ الأُذْنُ مرفوعاً بإسنادِ",73,"د",1,0],["أَنْتَ حَيَاةٌ لِي وَمَا","لِي مِنْ حَيَاةٍ عِوَضُ",74,"ض",1,0],["أنْتَ حُلْوٌ لِمَنْ تَقَرَّبَ بِالْوِدّ","وَلِلشَّانِئِينَ مُرُّ الْمَذَاقِي",75,"ق",2,0]]}