{"poems":[[57,"أنت حسبي وفيك للقلب حسب","https://www.aldiwan.net/poem24726.html","الخفيف"],[64,"رأيت ربي بعنين قلبي","https://www.aldiwan.net/poem67659.html","مخلع البسيط"],[51,"مذ صرت همي في النوم واليقظه","https://www.aldiwan.net/poem65036.html","المنسرح"],[51,"إذا تغنت شنطف مرة","https://www.aldiwan.net/poem65930.html","السريع"],[91,"ما بالهم نقضوا العهود جهارا","https://www.aldiwan.net/poem8862.html","عموديه"],[91,"إني سكت وما عدمت المنطقا","https://www.aldiwan.net/poem9046.html","عموديه"],[92,"ما لآفاقك يا قلبي سودا حالكات","https://www.aldiwan.net/poem38965.html","مجزوء الرمل"],[78,"يا بعيدا وإن دنا","https://www.aldiwan.net/poem14188.html","مجزوء الخفيف"],[89,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[89,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[89,"عاث هذا المنون يسرف فينا","https://www.aldiwan.net/poem44774.html","الخفيف"],[85,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[56,"أنت حديثي في النوم واليقظه","https://www.aldiwan.net/poem58560.html","الطويل"],[45,"لك في المجد أول وأخير","https://www.aldiwan.net/poem63574.html","الخفيف"],[66,"أمر الله أن يطيعك لبي","https://www.aldiwan.net/poem39527.html","الخفيف"],[66,"يا سمي الذي به اتهم الذئ","https://www.aldiwan.net/poem39533.html","الخفيف"],[97,"أنت حي برغمِ عاد الفناء","https://www.aldiwan.net/poem24382.html","الخفيف"],[97,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[44,"ما في وقوفك ساعة من باس","https://www.aldiwan.net/poem30485.html","الكامل"],[69,"إن قال صفني وصف رفيقي","https://www.aldiwan.net/poem28965.html","مخلع البسيط"],[105,"جددوا الذكرى لأهل المشرق","https://www.aldiwan.net/poem42122.html","الرمل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[46,"سل سبيل الحياة عن سلسبيل","https://www.aldiwan.net/poem23261.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85729","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85533","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/142164","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[104,"الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=5113",""],[18,"إن تحت الأحجار حزما وعزما","https://www.poetsgate.com/ViewPoem.aspx?id=27785",""],[18,"طفلة ما ابنة المحلل بيضا","https://www.poetsgate.com/ViewPoem.aspx?id=27761",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[90,"خل النديم","https://www.poetsgate.com/ViewPoem.aspx?id=178950",""],[57,"إنت حسبي وفيك للقلب حسب","https://www.poetsgate.com/ViewPoem.aspx?id=3377",""],[113,"قام معناك للمحاسن رمزا","https://www.aldiwan.net/poem40932.html","عموديه"],[113,"هات يا بارق الحمى اخبارك","https://www.aldiwan.net/poem41102.html","عموديه"],[113,"يا رفاعي وقعت في أبوابك","https://www.aldiwan.net/poem41238.html","عموديه"],[126,"وعليك نفسك لا تعب أحدا ولا","https://www.aldiwan.net/poem50568.html","الكامل"],[126,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[180,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[197,"على السماء وفوق الشمس أشعاري","https://www.aldiwan.net/poem45351.html","البسيط"],[202,"يا شادنا بالفتور مكحتلا","https://www.aldiwan.net/poem53158.html","المنسرح"],[221,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[233,"يا موسعي جفوة وصدا","https://www.aldiwan.net/poem31825.html","مجزوء البسيط"],[233,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[257,"نحن وفد القرى حللنا الخياما","https://www.aldiwan.net/poem35964.html","الخفيف"],[302,"يا رسول الله يا أهل الوفا","https://www.aldiwan.net/poem16816.html","الرمل"],[326,"يا رفيقي وأنت موحى قصيدي","https://www.aldiwan.net/poem54935.html","الخفيف"],[326,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[326,"خطرت كالنسمة السكرى","https://www.aldiwan.net/poem55050.html","مجزوء الرمل"],[340,"يا شهيد الدين والوطن","https://www.aldiwan.net/poem55308.html","المديد"],[359,"أيها الخل قد صحبناك دهرا","https://www.aldiwan.net/poem68109.html","الخفيف"],[362,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[374,"إن تحبسوني وحقكم لن تحبسوا","https://www.aldiwan.net/poem59358.html","الكامل"],[399,"يا من هجاني عامدا","https://www.aldiwan.net/poem46459.html","مجزوء الكامل"],[400,"جاء يهدي نحوي بديع النظام","https://www.aldiwan.net/poem33414.html","الخفيف"],[406,"كيف أنساك يا أبا بكر أم كيغف","https://www.aldiwan.net/poem31853.html","الخفيف"],[406,"فئتي ألتجي إليه من الخطب","https://www.aldiwan.net/poem32208.html","الخفيف"],[413,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[426,"يا من له روض الفؤاد مكان","https://www.aldiwan.net/poem41036.html","الكامل"],[438,"عوجوا رقاب اليعملات الذلل","https://www.aldiwan.net/poem14338.html","الكامل"],[444,"طفلة ما ابنة المجلل بيضاء","https://www.aldiwan.net/poem23940.html","الخفيف"],[456,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[462,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[466,"يا أيها الحاوي الذي لم تزل","https://www.aldiwan.net/poem59554.html","السريع"],[493,"يا نفس صبرا وإلا فاهلكي جزعا","https://www.aldiwan.net/poem10236.html","البسيط"],[556,"يا نديمي إن غابت الناس عني","https://www.aldiwan.net/poem33759.html","الخفيف"],[556,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[556,"فرحي يا فرحي يا فرحي","https://www.aldiwan.net/poem34662.html","الرمل"],[560,"بين قلب المحب والأحداق","https://www.aldiwan.net/poem52949.html","الخفيف"],[560,"طيف إلي سرى عن غير ميعاد","https://www.aldiwan.net/poem52954.html","البسيط"],[565,"ما اعتاد عيني غمض","https://www.aldiwan.net/poem69625.html","مجزوء الرجز"]],"verses":[["أَنتَ حَسبي وَفيكَ لِلقَلبِ حَسبُ","وَلِحَسبي إِن صَحَّ لِيَ فيكَ حَسبُ",0,"ب",1,1],["أَنتَ حَياتي وَسِرُّ قَلبي","فَحَيثُما كُنتُ كُنتَ أَنتَ",1,"ت",1,0],["أنتَ حلوٌ وأنت مرٌّ وما تُلْ","فَظ كلّا وكلُّ مُرٍّ لفيظُ",2,"ظ",1,0],["أنتِ حلالٌ غيرُ محجورةٍ","حسبي بتشويهك تحليلا",3,"ل",2,0],["إِن تُحرِجوا الرِئبالَ في عَرينِهِ","يَذَرُ السُكوت وَيَركَبُ الأَخطارا",4,"ر",2,0],["إِن تَحفَظوها تَحفَظوا في نَسلِكُم","ذِكراً يُخَلِّدُ في اللَيالي رَونَقا",5,"ق",2,0],["أَنْتَ حقلٌ مُجْدبٌ قَدْ هَزَأتْ منه الرُّعاةْ","أَنْتَ ليلٌ مُعْتِمٌ تَنْدُبُ فيه الباكياتْ",6,"ت",1,0],["أَنتَ حَسبي مِن المُنى","لَيتَني كُنتُ حسبكا",7,"ك",2,0],["أنت حررت مصر إلا قليلا","آه لو تم ذلك التحرير",8,"ر",1,0],["انت حاربت للتحرر اعوا","ماً طوالا فحاربي من جديد",9,"د",1,0],["انت حيّ وانت ميت وهذا","من خصال قد حازها الخالدونا",10,"ن",2,0],["أَنتَ حاتِمٌ","لِلقِرى اِنتَدَب",11,"ب",1,0],["أنتَ حَديثي في النّومِ واليَقَظَهْ","أَتْعَبْتُ مِمّا أَهْذي بِكَ الحَفَظَهْ",12,"ه",1,1],["أَنتَ حَوَّلتَهُ إِلى الحالَةِ الأو","لى وَقَد كانَ حائِراً يَستَديرُ",13,"ر",1,0],["أَنتَ حَسبي مِن كُلِّ مَن وَطِئَ الأَر","ضَ وَحَسبي بِأَنَّ مِثلَكَ حَسبي",14,"ب",2,0],["أَنتَ حُرُّ الأَديمِ لَم تُشرَ في الرِق","قِ بِنَزرِ اللُجَينِ وَالإِبريزِ",15,"ز",1,0],["أنتَ حي برغمِ عادِ الفناءِ","لا يُصاغُ الرثاءُ للأحياءِ",16,"ا",2,1],["أنتِ حسن في ضحاه لم يَزَل","وأنا عنديَ أحزان الطفَل",17,"ل",1,0],["إِن تَحوِ خَصلَ المَجدِ في أَنفِ الصِبا","يا اِبنَ الخَليفَةِ يا أَبا العَبّاسِ",18,"س",1,0],["أنت حسابٌ بلا عطاءٍ","وَهْوَ عطاءٌ بلا حسابِ",19,"ب",1,0],["إن تَحرَّيْتَ اللُّبابَ المُنتقَى","فاجعلِ الأخلاقَ ممّا تنتقي",20,"ق",2,0],["إنْ تُحْيِ آثارَهُ مِنْ بَعْدِ ما دَرَسَتْ","فإنَّكَ النِّيلُ تُحْيي الأرضَ والمَطَرُ",21,"ر",1,0],["إنْ تُحْيَ آمالي بِرُؤْيَةِ عيسى","فَلطالما أَنْضَتْ إليه العِيسا",22,"س",2,1],["إِن تَحُلّوا شاماً فَخَمرُ جِبالٍ","أَو عِراقاً فَالشُربُ مِن نَهرِ بيلِ",23,"ل",1,0],["انتحر واترك الحَيا","ة لِقوم تنعموا",24,"م",3,1],["إن تحت الرماد ناراً لو اَنَّ ال","ساسة اليوم فتشوا في الرماد",25,"د",1,0],["إنَّ تحت الصدورِ جذوةَ مَوْتو","رٍ، وخلف الحدودِ زأْرَة ناقم",26,"م",1,0],["إنتحرتم نحن الذين انتحرنا","بحياةٍ أمواتها الأحياء",27,"ا",2,0],["أَنتَ حَيثُ المُقَرَّبونَ فَأَبشِر","وَسَل اللَهَ أَن أَراكَ قَريبا",28,"ب",2,0],["انتحرتم ؟! نحن الذين انتحرنا","بحياة ٍ امواتها أحياءُ",29,"ا",2,0],["إن تحت الأحجار حزما وعزما","وقتيلا من الأراقم كهلا",30,"ل",2,1],["إن تحت الأحجار والترب منه","لدفينا علا علاء وجلا",30,"ل",2,0],["إن تحت الأحجار حدا ولينا","وخصيما ألد ذا معلاق",31,"ق",1,0],["إن تحمَدوا او تذُمُّوا أنَّ شافعتي","أنّي رأيتُ ، وما راءٍ كمَن سَمِعا",32,"ع",2,0],["أن تحمِ عن أهل الهوى كأس اللَّمى","فالخمرُ أجود ما يكون عتيقه",33,"ق",2,0],["إنت حسبي وفيك للقلب حسب","وحسبي أن صح لي فيك حسب",34,"ب",1,1],["انت حاز يتنا عن الحب صدا","ولعمري بفعله المرء يجزى",35,"ز",2,0],["انت حاكيت نور من فيه همنا","مذ اعارت انواره انوارك",36,"ك",1,0],["انت حصن الملهوف والباذل المع","روف والعاجزون من احزابك",37,"ك",1,0],["إنْ تحِص أَفعالا لهم وتجازهم","مَقترك واستولوا عليك وأَرْجَفُوا",38,"ف",3,0],["أنتَ حرٌّ ما دام سرُّك في القلب","فإن باحَ صرتَ مثلَ الأسيرِ",39,"ر",1,0],["إن تحيرتَ قِفْ وقوفَ","سؤال لا تُداهِن مخافةَ التغييرِ",39,"ر",1,0],["أَنْ تَحْنِ يَوماً بِعَطفٍ لِلشَجِيِّ فَقَد","أَحَبَت لَها عاشِقاً بِالروحِ يَفديها",40,"ي",3,0],["إن تحملي فلكاًَ قد دارَ دائرهُ","فدونكَ اللجُّ دوَّارٌ بدوَّارِ",41,"ر",1,0],["أنت حياتي وأنت لي تلفٌ","وفيك لي نعمةٌ وفيك بَلا",42,"ل",2,0],["أَنتِ حَسناءُ مِثل حَيَّة عَدنٍ","كَورودِ الشارونِ ذاتِ العُطورِ",43,"ر",1,0],["أَنتَ حَبيبٌ لِكُلِّ نَفسٍ","وَكلِّ حِسٍّ وَكُلِّ طَبعِ",44,"ع",1,0],["أَنتَ حَبلُ اللَهِ الَّذي فازَ مَن أَد","نَتهُ مِنهُ مَوَدَّةٌ وَوَلاءُ",45,"ا",2,0],["أنت حسبي أمّا إليك فلا قل","ت لمن رام في سواك مراما",46,"م",2,0],["أنت حبل اللَه من أمسكه","فاز بالخير وبالعهد وفا",47,"ف",2,0],["إنّ تحت السكون تعودي الأعاصي","ر انتظارا ليومها المعهود",48,"د",1,0],["أنت حيرى بدَت لحيران في القف","ر فزادت شمس الهوى إشراقا",49,"ق",2,0],["أنت حبّبتَ لي المنيّةَ والقب","رَ فأمست لقياهما تأميلي",49,"ي",1,0],["أنت حلم سابح في","مائج من صبواتي",50,"ي",1,0],["انت حي في ضمائرنا","انت لا تفنى مدى الزمن",51,"ن",1,0],["اِن تَحقق رَجاي فيكَ فَأَهلا","أَنَ وَاللَهِ بِالمَكارِم أَحرى",52,"ر",2,0],["أنت حَقّقْتَ ما ادَّعَى ذاك والصّا","دِقُ من فَجْرِيَ الظَّلامُ الثّاني",53,"ي",1,0],["إن تحبسوني وحقِِّكم لن تحبسوا","مني لساني والقريضَ القارضا",54,"ض",2,1],["إنْ تحفظِ الودَّ الأكيدَ","فإِنَّكَ الثقة الأَمينُ",55,"ن",1,0],["إن تحقيق الحق يحتاج فيه","بعض بسط الكلام للأفهام",56,"م",1,0],["أنت حيثُ اتّجهتُ في أَسوَدَي عي","ني وقلبي ممثَّلٌ لا تَزولُ",57,"ل",1,0],["أنتَ حلَّيتَ بالمكارِم أهلَ ال","عصرِ حتّى تعرَّفَ المجهولُ",58,"ل",1,0],["إنْ تحاولْ شَخْصَهُ تَلْقَ علًى","صَحِبَ العِزَّ يميناً وشمالا",59,"ل",2,0],["ان تحسبوه على المحب جناية","فالعفوان العفو منك امان",60,"ن",1,0],["إن تحرموا فهو اللباس لكم وإن","أحللتم فهو الثواب لمحلل",61,"ل",1,0],["إِنَّ تَحتَ الأَحجارِ جَدّاً وَليناً","وَخَصيماً أَلَدَّ ذا مِعلاقِ",62,"ق",1,0],["أَنتَحِي أعزلَ فيه","وسلاحُ الدهرِ شاكي",63,"ي",1,0],["أنت حسام سجنتَ بالغمد لو","سلَّك سلَّ الحسام وانتصلك",64,"ك",1,0],["إِن تَحوِنا مِصرُ فَكَم مَربَعٍ","فيهِ غُصونٌ وَعَراجينُ",65,"ن",1,0],["إن تحمد اللّه شكراً عند نعمته","فراقب اللّه صبراً عند ما رجعا",66,"ع",2,0],["أنت حق وباطل نحن هذا","جاءنا في تصديق قولِ المغني",67,"ن",2,0],["أنت حق وأنا الباطل لي","جولة والحق بالدولة قاما",68,"م",2,0],["أنت حق واحد لا غيره","غيره أنت فَطِبْ وانشرح",69,"ح",1,0],["إن تَحُلْ بَيننا النَوَى لم تَحُلْ إنْ","شئتَ بين الأقلامِ والأوراقِ",70,"ق",1,0],["إن تُحرَمِ العينُ مرآهُ فقد رُزِقَتْ","حديثَهُ الأُذْنُ مرفوعاً بإسنادِ",71,"د",1,0],["أَنْتَ حَيَاةٌ لِي وَمَا","لِي مِنْ حَيَاةٍ عِوَضُ",72,"ض",1,0]]}