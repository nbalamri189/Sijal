,""],[5443,"واطُولَ صَبرِي!","https://www.poetsgate.com/ViewPoem.aspx?id=185149",""],[5461,"يا صقر","https://www.poetsgate.com/ViewPoem.aspx?id=508",""],[470,"الغيرة القاتلة","https://www.poetsgate.com/ViewPoem.aspx?id=178068",""],[469,"جزتَ في المجد والفعال الشريفِ","https://www.poetsgate.com/ViewPoem.aspx?id=76859",""],[5848,"الرسايل كيف تاصل بلا ارقام","https://www.poetsgate.com/ViewPoem.aspx?id=48952",""],[5848,"اطيب قلب","https://www.poetsgate.com/ViewPoem.aspx?id=53168",""],[5874,"مَوْقفُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=212191",""],[5910,"حيِّ قبرًا بجانبِ الآكامِ","https://www.poetsgate.com/ViewPoem.aspx?id=207124",""],[5956,"إنْ تَحْنِ ظهرك","https://www.poetsgate.com/ViewPoem.aspx?id=184366",""],[5956,"النقود الطائرة","https://www.poetsgate.com/ViewPoem.aspx?id=184581",""],[5956,"الأديان والطوائف المتآزرة","https://www.poetsgate.com/ViewPoem.aspx?id=192650",""],[5957,"ليس حبي من هيام وشغب","https://www.poetsgate.com/ViewPoem.aspx?id=128188",""],[5970,"ما بقائي في العيش بعد الذي بي","https://www.poetsgate.com/ViewPoem.aspx?id=130636",""],[5975,"يا إله الخلق..","https://www.poetsgate.com/ViewPoem.aspx?id=58780",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6052,"روضة الايمان","https://www.poetsgate.com/ViewPoem.aspx?id=35138",""],[4442,"أبت أن تسيغ العيش ألا بما تهوى","https://www.poetsgate.com/ViewPoem.aspx?id=170991",""],[6102,"زيفا الإسرائيلية","https://www.poetsgate.com/ViewPoem.aspx?id=184171",""],[6148,"تنهيدة","https://www.poetsgate.com/ViewPoem.aspx?id=201601",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""],[6211,"شكرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78232&r=&rc=3",""]],"verses":[["أَنتَ حَسبي وَفيكَ لِلقَلبِ حَسبُ","وَلِحَسبي إِن صَحَّ لِيَ فيكَ حَسبُ",0,"ب",1,1],["أَنتَ حَياتي وَسِرُّ قَلبي","فَحَيثُما كُنتُ كُنتَ أَنتَ",1,"ت",1,0],["أنتَ حلوٌ وأنت مرٌّ وما تُلْ","فَظ كلّا وكلُّ مُرٍّ لفيظُ",2,"ظ",1,0],["أنتِ حلالٌ غيرُ محجورةٍ","حسبي بتشويهك تحليلا",3,"ل",2,0],["إِن تُحرِجوا الرِئبالَ في عَرينِهِ","يَذَرُ السُكوت وَيَركَبُ الأَخطارا",4,"ر",2,0],["إِن تَحفَظوها تَحفَظوا في نَسلِكُم","ذِكراً يُخَلِّدُ في اللَيالي رَونَقا",5,"ق",2,0],["أَنْتَ حقلٌ مُجْدبٌ قَدْ هَزَأتْ منه الرُّعاةْ","أَنْتَ ليلٌ مُعْتِمٌ تَنْدُبُ فيه الباكياتْ",6,"ت",1,0],["أَنتَ حَسبي مِن المُنى","لَيتَني كُنتُ حسبكا",7,"ك",2,0],["أنت حررت مصر إلا قليلا","آه لو تم ذلك التحرير",8,"ر",1,0],["انت حاربت للتحرر اعوا","ماً طوالا فحاربي من جديد",9,"د",1,0],["انت حيّ وانت ميت وهذا","من خصال قد حازها الخالدونا",10,"ن",2,0],["أَنتَ حاتِمٌ","لِلقِرى اِنتَدَب",11,"ب",1,0],["أنتَ حَديثي في النّومِ واليَقَظَهْ","أَتْعَبْتُ مِمّا أَهْذي بِكَ الحَفَظَهْ",12,"ه",1,1],["أَنتَ حَوَّلتَهُ إِلى الحالَةِ الأو","لى وَقَد كانَ حائِراً يَستَديرُ",13,"ر",1,0],["أَنتَ حَسبي مِن كُلِّ مَن وَطِئَ الأَر","ضَ وَحَسبي بِأَنَّ مِثلَكَ حَسبي",14,"ب",2,0],["أَنتَ حُرُّ الأَديمِ لَم تُشرَ في الرِق","قِ بِنَزرِ اللُجَينِ وَالإِبريزِ",15,"ز",1,0],["أنتَ حي برغمِ عادِ الفناءِ","لا يُصاغُ الرثاءُ للأحياءِ",16,"ا",2,1],["أنتِ حسن في ضحاه لم يَزَل","وأنا عنديَ أحزان الطفَل",17,"ل",1,0],["إِنَّ تَحتَ الأَحجارِ حَزماً وَعَزما","وَقَتيلاً مِن الأَراقِمِ كَهلا",18,"ل",2,1],["إِنَّ تَحتَ الأَحجارِ وَالتُربِ مِنهُ","لَدَفينا عَلا عَلاءً وَجَلّا",18,"ل",2,0],["إِنَّ تَحتَ الأَحجارِ جَدّاً وَليناً","وَخَصيماً أَلَدَّ ذا مِعلاقِ",19,"ق",1,0],["إِن تَحوِ خَصلَ المَجدِ في أَنفِ الصِبا","يا اِبنَ الخَليفَةِ يا أَبا العَبّاسِ",20,"س",1,0],["أنت حسابٌ بلا عطاءٍ","وَهْوَ عطاءٌ بلا حسابِ",21,"ب",1,0],["إن تَحرَّيْتَ اللُّبابَ المُنتقَى","فاجعلِ الأخلاقَ ممّا تنتقي",22,"ق",2,0],["إنْ تُحْيِ آثارَهُ مِنْ بَعْدِ ما دَرَسَتْ","فإنَّكَ النِّيلُ تُحْيي الأرضَ والمَطَرُ",23,"ر",1,0],["إنْ تُحْيَ آمالي بِرُؤْيَةِ عيسى","فَلطالما أَنْضَتْ إليه العِيسا",24,"س",2,1],["إِن تَحُلّوا شاماً فَخَمرُ جِبالٍ","أَو عِراقاً فَالشُربُ مِن نَهرِ بيلِ",25,"ل",1,0],["إن تحت الأحجار حزما وعزما","وخصيما ألد ذا مغلاق",26,"ق",1,0],["انتحر واترك الحَيا","ة لِقوم تنعموا",27,"م",3,1],["إن تحت الرماد ناراً لو اَنَّ ال","ساسة اليوم فتشوا في الرماد",28,"د",1,0],["إنَّ تحت الصدورِ جذوةَ مَوْتو","رٍ، وخلف الحدودِ زأْرَة ناقم",29,"م",1,0],["إنتحرتم نحن الذين انتحرنا","بحياةٍ أمواتها الأحياء",30,"ا",2,0],["أَنتَ حَيثُ المُقَرَّبونَ فَأَبشِر","وَسَل اللَهَ أَن أَراكَ قَريبا",31,"ب",2,0],["انتحرتم ؟! نحن الذين انتحرنا","بحياة ٍ امواتها أحياءُ",32,"ا",2,0],["إن تحت القناع والوجه وجها","يخفي تحت ظهره وهو بادي",33,"د",2,0],["إن تحت الأحجار حدا ولينا","وخصيما ألد ذا معلاق",34,"ق",1,0],["إن تحمَدوا او تذُمُّوا أنَّ شافعتي","أنّي رأيتُ ، وما راءٍ كمَن سَمِعا",35,"ع",2,0],["أن تحمِ عن أهل الهوى كأس اللَّمى","فالخمرُ أجود ما يكون عتيقه",36,"ق",2,0],["إنت حسبي وفيك للقلب حسب","وحسبي أن صح لي فيك حسب",37,"ب",1,1],["انت حاز يتنا عن الحب صدا","ولعمري بفعله المرء يجزى",38,"ز",2,0],["انت حاكيت نور من فيه همنا","مذ اعارت انواره انوارك",39,"ك",1,0],["انت حصن الملهوف والباذل المع","روف والعاجزون من احزابك",40,"ك",1,0],["إنْ تحِص أَفعالا لهم وتجازهم","مَقترك واستولوا عليك وأَرْجَفُوا",41,"ف",3,0],["أنتَ حرٌّ ما دام سرُّك في القلب","فإن باحَ صرتَ مثلَ الأسيرِ",42,"ر",1,0],["إن تحيرتَ قِفْ وقوفَ","سؤال لا تُداهِن مخافةَ التغييرِ",42,"ر",1,0],["أَنْ تَحْنِ يَوماً بِعَطفٍ لِلشَجِيِّ فَقَد","أَحَبَت لَها عاشِقاً بِالروحِ يَفديها",43,"ي",3,0],["إن تحملي فلكاًَ قد دارَ دائرهُ","فدونكَ اللجُّ دوَّارٌ بدوَّارِ",44,"ر",1,0],["أنت حياتي وأنت لي تلفٌ","وفيك لي نعمةٌ وفيك بَلا",45,"ل",2,0],["أَنتِ حَسناءُ مِثل حَيَّة عَدنٍ","كَورودِ الشارونِ ذاتِ العُطورِ",46,"ر",1,0],["أَنتَ حَبيبٌ لِكُلِّ نَفسٍ","وَكلِّ حِسٍّ وَكُلِّ طَبعِ",47,"ع",1,0],["أَنتَ حَبلُ اللَهِ الَّذي فازَ مَن أَد","نَتهُ مِنهُ مَوَدَّةٌ وَوَلاءُ",48,"ا",2,0],["أنت حسبي أمّا إليك فلا قل","ت لمن رام في سواك مراما",49,"م",2,0],["أنت حبل اللَه من أمسكه","فاز بالخير وبالعهد وفا",50,"ف",2,0],["إنّ تحت السكون تعودي الأعاصي","ر انتظارا ليومها المعهود",51,"د",1,0],["أنت حيرى بدَت لحيران في القف","ر فزادت شمس الهوى إشراقا",52,"ق",2,0],["أنت حبّبتَ لي المنيّةَ والقب","رَ فأمست لقياهما تأميلي",52,"ي",1,0],["أنت حلم سابح في","مائج من صبواتي",53,"ي",1,0],["انت حي في ضمائرنا","انت لا تفنى مدى الزمن",54,"ن",1,0],["اِن تَحقق رَجاي فيكَ فَأَهلا","أَنَ وَاللَهِ بِالمَكارِم أَحرى",55,"ر",2,0],["أنت حَقّقْتَ ما ادَّعَى ذاك والصّا","دِقُ من فَجْرِيَ الظَّلامُ الثّاني",56,"ن",2,0],["إن تحبسوني وحقِِّكم لن تحبسوا","مني لساني والقريضَ القارضا",57,"ض",2,1],["إنْ تحفظِ الودَّ الأكيدَ","فإِنَّكَ الثقة الأَمينُ",58,"ن",1,0],["إن تحقيق الحق يحتاج فيه","بعض بسط الكلام للأفهام",59,"م",1,0],["أنت حيثُ اتّجهتُ في أَسوَدَي عي","ني وقلبي ممثَّلٌ لا تَزولُ",60,"ل",1,0],["أنتَ حلَّيتَ بالمكارِم أهلَ ال","عصرِ حتّى تعرَّفَ المجهولُ",61,"ل",1,0],["إنْ تحاولْ شَخْصَهُ تَلْقَ علًى","صَحِبَ العِزَّ يميناً وشمالا",62,"ل",2,0],["ان تحسبوه على المحب جناية","فالعفوان العفو منك امان",63,"ن",1,0],["إن تحرموا فهو اللباس لكم وإن","أحللتم فهو الثواب لمحلل",64,"ل",1,0],["أَنتَحِي أعزلَ فيه","وسلاحُ الدهرِ شاكي",65,"ك",2,0],["أنت حسام سجنتَ بالغمد لو","سلَّك سلَّ الحسام وانتصلك",66,"ك",1,0],["إِن تَحوِنا مِصرُ فَكَم مَربَعٍ","فيهِ غُصونٌ وَعَراجينُ",67,"ن",1,0],["إن تحمد اللّه شكراً عند نعمته","فراقب اللّه صبراً عند ما رجعا",68,"ع",2,0],["أنت حق وباطل نحن هذا","جاءنا في تصديق قولِ المغني",69,"ن",2,0],["أنت حق وأنا الباطل لي","جولة والحق بالدولة قاما",70,"م",2,0],["أنت حق واحد لا غيره","غيره أنت فَطِبْ وانشرح",71,"ح",1,0],["إن تَحُلْ بَيننا النَوَى لم تَحُلْ إنْ","شئتَ بين الأقلامِ والأوراقِ",72,"ق",1,0],["إن تُحرَمِ العينُ مرآهُ فقد رُزِقَتْ","حديثَهُ الأُذْنُ مرفوعاً بإسنادِ",73,"د",1,0],["أَنْتَ حَيَاةٌ لِي وَمَا","لِي مِنْ حَيَاةٍ عِوَضُ",74,"ض",1,0],["أنت حببت تنفي كلامي","قمت واثبتو بشرحك",75,"ك",1,0],["أنتَ حُلوٌ مرُّ المذاقِ إذ أر","سلتَ ريحَيكَ زَعزعاً ورُخاء",76,"ا",2,0],["أنت حق الحق في تحقيقه","أنت روح الروح في شكل البشر",77,"ر",1,0],["أنت حُلْمُ الصِّبا","في هُدُوءِ السَّحَرْ",78,"ر",1,0],["إن تحجبُونا عن محاسن وجهكم","هل تحجبون القلب عن أضوائه",79,"ا",3,0],["ان تحتصدك المنون حصدا","فكل زرع غدا حصيد",80,"د",1,0],["أنت حسبي ومن تكن حسبه لم","يعد صبرا ولن يخف أغبارا",81,"ر",2,0],["إِن تَحَشمتَني وَإِن كانَ إِلّا","مِثلَ ما يَأنَسُ الفَتى 