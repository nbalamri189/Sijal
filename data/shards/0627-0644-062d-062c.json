{"poems":[[87,"ضج الحجاز وضج البيت والحرم","https://www.aldiwan.net/poem63747.html","البسيط"],[47,"وواعظ منه لولا أنه حجر","https://www.aldiwan.net/poem63596.html","البسيط"],[48,"يا للمفضل تكسوني مدائحه","https://www.aldiwan.net/poem23646.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85543","المقتضب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[121,"بقايا جراح","https://www.aldiwan.net/poem24061.html","السريع"],[276,"يا صاحب القبر المقيم بيثرب","https://www.aldiwan.net/poem52121.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138290",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126789","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126678","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77425","الكامل"],[2543,"","https://poetry.dctabudhabi.ae/diwan/poem/123757","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204642","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100790","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145059","الكامل"],[4234,"","https://poetry.dctabudhabi.ae/diwan/poem/203438","البسيط"],[4441,"","https://poetry.dctabudhabi.ae/diwan/poem/138772",""],[4767,"أسير الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=211260",""],[5956,"يا ناشر الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=192511",""],[6218,"الخزيُ للشعراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65910&r=&rc=63",""]],"verses":[["الحَجُّ رُكنٌ مِنَ الإِسلامِ نُكبِرُهُ","وَاليَومَ يوشِكُ هَذا الرُكنُ يَنهَدِمُ",0,"م",1,0],["أَلَحَّ جوداً وَلَم تَضرُر سَحائِبُهُ","وَرُبَّما ضَرَّ في إِلحاحِهِ المَطَرُ",1,"ر",1,0],["الحِجْلُ للرِّجْلِ والتاجُ المُنيفُ لِما","فوقَ الحِجاجِ وعِقْدُ الدُّرّ للعُنُقِ",2,"ق",1,0],["الحجى أَراد هدى","ما على الحجى عتب",3,"ب",1,0],["الحجر الأول في البناء","وأقرب الصحبِ بلا استثناءِ",4,"ا",2,0],["الحَجُّ والعُمْرَةُ، لم يَثْنِيا","شَيطانَ قَلْبَيْنا، وذاتَ الوِشاحُ",5,"ح",1,0],["الحجب ترفع وَالجهات انيسة","وَالمجتَبي يَغشاه نور المُجتَبي",6,"ب",2,0],["الحج يا أستاذنا مبرورُ","والطوف عند نبينا مشكورُ",7,"ر",1,1],["الحجّة المُقتدى للمسلمين ومن","له المُهيمن جمّ الفضل قد جَمَعا",8,"ع",2,0],["الحجّة العظمى ومن بيمينهِ","أضحت تُدار الشرعة الغرّاءُ",9,"ا",2,0],["الحَجُّ فَخرٌ وَالصَلاةُ هَواجِسٌ","وَالصَومُ هَجرٌ وَالكِتابُ غِناءُ",10,"ا",2,1],["الحج باليمن مبرور مناسكه","لسيد فيه آيات الهدى جمعت",11,"ت",1,0],["الحجى سائر الى الحق لكن","شوشت سيره شيوخ الطريقه",12,"ق",2,0],["الحجى ودين والفضل والتقى","وافضل من زان النهى ويزين",13,"ن",1,0],["الحج عنوان الإخاء مكبرا","الحج منهاج الولاء قويما",14,"م",2,0],["الحج مدرسة التعارف شادها","رب الورى وأدارها تعليما",14,"م",2,0],["الحجر ظل وقد أبدت لنا قمراً","والنمل في كفها للعاشقين سبا",15,"ب",2,0],["الحجة الكبرى على","كل الاعاجم والاعارب",16,"ب",1,0],["الحَجر طال ومهجتي تتفطَّرُ","كالطفل يبكي جائعاً يتضوَّرُ",17,"ر",1,1],["الحج أعمال الوفاء لخالقٍ","يَجزي الوفيَّ بحاضرٍ وبآتِ",18,"ت",1,0],["الحج أعظمُ فرصة لنجاتنا","فهو اغتسالٌ كاملٌ لِلْذاتِ",18,"ت",1,0],["الحج غفرانٌ لراجي توبة","ليعود كالمولودِ من لحظاتِ",18,"ت",1,0],["الحجُ قدسٌ، والعراق شهادةٌ","والموت كرمى عينهنَّ إمامُ",19,"م",1,0]]}