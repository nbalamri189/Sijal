ttps://poetry.dctabudhabi.ae/diwan/poem/178132","الوافر"],[958,"","https://poetry.dctabudhabi.ae/diwan/poem/22544","الوافر"],[1026,"","https://poetry.dctabudhabi.ae/diwan/poem/20535","الطويل"]],"verses":[["يَرجو الفَتى خُلَسَ البَقاءِ وَإِنَّما","جارا حَياةِ العُمرِ مُفتَرِقانِ",0,"ن",1,0],["يُرَجّي عُداتي كُلَّ يَومٍ وَيُتَّقى","شَذاتي وَبَعضي في الجِدالِ لَقيلي",1,"ل",2,0],["يَرجو بُلوغَ نَداكَ وَهوَ مُحَقِّقٌ","مَع حِرصِهِ أَنَّ الجَوادَ عَتيقُ",2,"ق",1,0],["يُرَجّونَ مِنها وَالأَمانِيُّ ضِلَّةٌ","رَجاءَ نِتاجِ الحَملِ مِن غَيرِ لاقَحِ",3,"ح",1,0],["يُرجى عَلى النَظَرِ الحَديدِ تَكَرُّماً","وَيُخافُ في الإِطراقِ وَالإِغضاءِ",4,"ا",2,0],["يَرجو النَجاءَ مِنَ المَظا","لِمِ وَالمَغارِمِ وَالدَمار",5,"ر",1,0],["يُرَجّعُ النَهقَ مَقروناً وَيُطرِبُني","لَحناً كَما يُطرَبُ المَزمومُ وَالرَمَلُ",6,"ل",1,0],["يُرَجِّعُ في حَيزومِهِ غَيرَ باغِمٍ","يَراعاً منَ الأَحشاءِ جوفاً هَنابِقُه",7,"ق",2,0],["يُرَجّوُن من أهل القبور رجاءهم","ومن يحمل الدبوس أو يضرب الدنا",8,"ن",2,0],["يَرجوكَ مِثلَ رَجاءِ الغَيثِ تَجرُهُمُ","بورِكتَ جابِرَ عَظمٍ هيضَ مُنكَسِرِ",9,"ر",1,0],["يَرجونَ مِنكَ وَلا يَخشَونَ مَظلِمَةً","عُرفاً وَتُمطِرُ مِن مَعروفِكَ الدِيَمُ",10,"م",1,0],["يُرَجِّعُ في الصُوى بِمُهَضَّماتٍ","يَجُبنَ الصَدرَ مِن قَصَبِ العَوالي",11,"ل",2,0],["يرجى دوالح من ثجاجة قُطُف","تجلوا البوارق عنه صفح دخدارِ",12,"ر",1,0],["يرجَّى وإن زاد في سخطه","ويخشى وإن لان في مزحه",13,"ح",2,0],["يرَجّيه من بحر القريض سريعه","فيلقاه من بحرِ النوالِ مدِيدُه",14,"د",2,0],["يرجم الفقر من ندا","ك برفد معجّل",15,"ل",1,0],["يرجى فيعطي فوقَ كلّ رغيبة","وتطيش ألباب الرجال فيحلم",16,"م",1,0],["يرجّح ما بين الكواكب فضلهم","ومن أجل هذا للكواكب ميزان",17,"ن",1,0],["يُرْجَى فيُوفِي بالمُؤَمَّلِ عنده","لا بل يَفُتٌّ وفاءه إرجاحُهُ",18,"ح",2,0],["يُرجف القرد بأني","زائل العقل موسوَسْ",19,"س",1,1],["يرجُو لديه غِنىً يحطُّ به","رِحاله عن ظُهورِ أنقاضِه",20,"ض",2,0],["يُرْجَى ويُخْشَى وتُغْشَى داره أبداً","غِشْيانَ بيتٍ لآل الله مسدون",21,"ن",1,0],["يَرجو البَقِيَّةَ بَعدَ ما حَدَقَت بِهِ","فُرُطُ المَنِيَّةِ يَحصِبٌ وَحَجورُ",22,"ر",1,0],["يَرجوكَ أَنَّكَ جابِرٌ كَسرَهُ","فَإِذا فُقِدتَ فَكَسرُهُ لا يُجبَرُ",23,"ر",1,0],["يَرجو الكَمالَ مِنَ الدُنيا وَكَيفَ لَهُ","نَيلُ الكَمالِ مِنَ الدُنيا وَما دانا",24,"ن",2,0],["يَرجو وَيَأمُلُ وَالحَياةُ صَريمَةٌ","تَمضي نَوافِذُها وَعَزمٌ يَدأَبُ",25,"ب",1,0],["يرجون بالدين أنهم إن","ماتوا يعيشون من جديد",26,"د",1,1],["يَرجون بِالزُهد قِيامَ أَمرِهم","وَالزُهدُ مِن بَعد أَبيهم قَد عَفا",27,"ا",1,0],["يَرجو الرَبيعَ بِهِم وَيَأمَلُ دَولَةً","مِن حُسنِهِ وَمِنِ اِعتِدالِ زَمانِهِ",28,"ن",2,0],["يَرجِعُ الناسُ وَالعُصورُ إِلى ما","سَنَّ وَالجاحِدونَ وَالأَعداءُ",29,"ا",2,0],["يَرجو العَواذِلُ إِقصاري وَفي كَبِدي","نارٌ تَزيدُ عَلى الإِطفاءِ إيقادا",30,"د",2,0],["يُرجى مَرَجّيهِ فَيُؤتَنَفُ الغِنى","مِمّا يُنيلُ وَيُستَجارُ بِجارِهِ",31,"ر",2,0],["يَرجو حَسودُهُمُ الكِفايَةَ بَعدَ ما","خَفِيَت نُجومُ اللَيلِ في أَقمارِهِ",31,"ر",2,0],["يَرجو لَها الحُسّادُ نَقلاً وَقَد","أَرسى ثَبيرٌ وَتَأَيّا تَبيع",32,"ع",1,0],["يَرجونَ مِنهُ نَجابَةً شَهِدَت بِها","فيهِ عُدولُ شَواهِدٍ وَدَلائِلِ",33,"ل",1,0],["يُرَجّي الخُلودَ مَعشَرٌ ضَلَّ سَعيُهُم","وَدونَ الَّذي يَرجونَ غَولُ الغَواءِ",34,"ا",2,0],["يَرجو الأَمانَ وَلا أَمانَ لِغادِرٍ","رَشَقَ العَصا وَأَحَلَّ كُلَّ حَآمِ",35,"م",1,0],["يَرجو البَخيلُ اِغتِراري أَو مُخادَعَتي","حَتّى أَسوقَ إِلَيهِ المَدحَ مَجّانا",36,"ن",2,0],["يَرجِفُ الحِلفُ في صُدورِ قَناهُم","وَتَحِنُّ الأَرحامُ فيهِم حَنينا",37,"ن",2,0],["يَرجونَ سَيبَكَ أَن يَكونَ لَهُم","كَالنيلِ فاضَ عَلى قُرى مِصرِ",38,"ر",1,0],["يَرجونَ تَكذيبَ النَبِيِّ وَقَتلِهِ","وَإِن يَفتَروا بُهتاً عَلَيهِ وَمُجحَدا",39,"د",2,0],["يَرجونَ رِفدَكَ كَي يَرَوا","مِمّا لَقوهُ العافِيَه",40,"ي",2,0],["يُرَجَّعُ تَكرارَ الهَديلِ مُغَرِّداً","فَيَصدَعُ قَلبي نَوحُهُ حينَ يَصدَحُ",41,"ح",1,0],["يُرجى وَيَخشى جودُهُ وَنِكالُهُ","في يَومِ مَكرُمَةٍ وَخَطبٍ مُزمِنِ",42,"ن",1,0],["يُرجى وَيُحذَرُ في يَومي نَدىً وَرَدىً","وَالبَحرُ ما بَينَ مَرجُوٍّ وَمَحذورِ",43,"ر",1,0],["يُرْجِعُ الليلَ نهاراً بالظّبا","ويعيدُ الظُّهرَ بالنقع عَتَمْ",44,"م",1,0],["يُرجِعُ حَرّى التِلاعِ مُترَعَةً","رِيّاً وَيَثني الزَمانَ عَن نُوَبِه",45,"ب",2,0],["يَرجونَ رِضوانَ الإِلَهِ لِأَنفُسٍ","يَحمِلنَ أَعباءَ الجِهادِ جِساما",46,"م",2,0],["يرجو مَوَدَّتَهم وَيَبني منهمُ","لِلدّينِ صَرحَ أمانةٍ وَوفاءِ",47,"ا",2,0],["يُرَجِّعونَ الحَنينَ آوِنَةً","وَإِن عَلى ساعَةً بِهِم شَهَقوا",48,"ق",3,0],["يَرجو عَدُوُّكَ منك ما لا يَنْتَهي","ويَنوءُ منك بحملِ ما لا يُحمَل",49,"ل",1,0],["يَرجو وَيَخشى حالَتَيكَ الوَرى","كَأَنَّكَ الجَنَّةُ وَالنارُ",50,"ر",1,0],["يَرجو أُموراً عَنهُ مُغَيَّبَةً","جَهلاً وَمِن دونِ ما رَجا أَجَلُه",51,"ل",2,0],["يَرجو عُبَيدَةَ يَوماً أَن تَجودَ لَهُ","وَإِن تَطاوَلَ ما يَرجو وَيَنتَظِرُ",52,"ر",1,0],["يُرجى مَعَ المُزنِ مَعروفي لِطالِبِهِ","وَيُتَّقى المَوتُ مِن حَيّاتِيَ السودِ",53,"د",1,0],["يُرَجّي مَعاشاً مَن لَهُ بِدَوامِهِ","وَهَل يَترُكُ الدَهرُ الفَقيرَ وَما رَجّى",54,"ج",2,0],["يَرجو الأَبُ الطِفلَ الصَغيرَ وَطالَما","هَلَكَ الوَليدُ وَعاشَ فينا الوالِدُ",55,"د",1,0],["يَرجو السَلامَةَ رَكبُ خَرقٍ مُتلِفٍ","وَمِنَ الخَفيرِ أَتاهُمُ الإِخفارُ",56,"ر",1,0],["يُرَجِّيَ الناسُ كُلُّهُمُ حُظوظاً","وَلِلأَقدارِ فِعلٌ بِاِقتِدارِ",57,"ر",1,0],["يَرجو فَيَمدَحُ غَيرَ مُرتَقَبٍ","رَبّاً وَكُلُّ مَقالِهِ إِزلُ",58,"ل",1,0],["يَرجون عنها سلوّي","لَو أَستَطيع سلوّا",59,"و",2,0],["يرجوا أناس أن ينالوا بعد ما","يعثو الردى فيهم وصال الحور",60,"ر",1,0],["يرجي الفَتى أَن الثراء يعينه","عَلى نائبات الدهر حين تَنوب",61,"ب",1,0],["يرجو بها رتبةً شماءَ راقية","كيما يقال فلان من ذوي الرتب",62,"ب",1,0],["يَرجو بقاء حَياته في موته","وَالمَوت شيء للحياة ينافي",63,"ف",2,0],["يَرجو وصالَ الحور بع","دَ المَوت قوم بالصلاة",64,"ه",1,0],["يرجو لصَدعِ المؤمنين رأْبا","وأمُّهم تدفَعُه وتأبى",65,"ب",2,0],["يَرْجُو زِيَارَةَ مَن يُحِبُّ لِوَعْدِهِ","كَلَفاً فباتَ مُرَاقِباً لم يَهْجَعِ",66,"ع",1,0],["يَرْجُو وَيَخْشَى أُمُورَاً لَوْ تَدَبَّرَهَا","لَزَالَ مِنْ قَلْبِهِ التَّأْمِيلُ وَالْحَذَرُ",67,"ر",1,0],["يَرْجُو الْفَتَى فِي الدَّهْرِ طُولَ حَيَاتِهِ","وَنَعِيمِهِ وَالْمَرْءُ غَيْرُ مُخَلَّدِ",68,"د",1,0],["يَرْجُونَ مِنْ إِخْوَانِهِمْ إِسْعَافَ