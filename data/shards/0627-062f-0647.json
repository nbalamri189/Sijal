{"poems":[[102,"أبو تمام وعروبة اليوم","https://www.aldiwan.net/poem23694.html","عموديه"],[88,"طمع ألقى عن الغرب اللثاما","https://www.aldiwan.net/poem10683.html","الرمل"],[95,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[90,"أدهق الدهر بالمنية كاسه","https://www.aldiwan.net/poem45051.html","الخفيف"],[91,"حملته بين احشائي بلا برم","https://www.aldiwan.net/poem44857.html","البسيط"],[82,"أدهم كالظلام تشرق فيه","https://www.aldiwan.net/poem31265.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85506","الخفيف"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9964","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42731","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54826","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[190,"مشي الثقيل إذا مشى","https://www.aldiwan.net/poem43689.html","مجزوء الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[201,"غادة حطم الفؤاد بكاها","https://www.aldiwan.net/poem39820.html","الخفيف"],[266,"هذي ربى الأثلات من يبرين","https://www.aldiwan.net/poem38165.html","الكامل"],[438,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[469,"ورياضِ محنية دفنت بها الأسى","https://www.aldiwan.net/poem3382.html","عموديه"],[498,"كم منة للظلام في عنقي","https://www.aldiwan.net/poem67351.html","المنسرح"],[543,"آه إذ تعلو على متن جوا","https://www.aldiwan.net/poem48197.html","عموديه"],[558,"أدهرا تولى هل نعيمك مقبل","https://www.aldiwan.net/poem68391.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138396",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122796","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62545","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96715","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96653","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80195","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64737","الرمل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56569","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77938","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100965","الخفيف"],[2038,"","https://poetry.dctabudhabi.ae/diwan/poem/123686","الخفيف"],[2137,"","https://poetry.dctabudhabi.ae/diwan/poem/144578","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53242","الخفيف"],[2362,"","https://poetry.dctabudhabi.ae/diwan/poem/198790","الكامل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45669","المنسرح"],[2853,"","https://poetry.dctabudhabi.ae/diwan/poem/102465","الرمل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115527","السريع"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118801","الخفيف"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22537","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130061","الرمل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121614","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138555",""],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101218","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90922","الكامل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105500","البسيط"],[4749,"فوق الدفاتري دونت أخباري","https://www.poetsgate.com/ViewPoem.aspx?id=155781",""],[4935,"طير الهنا فوق الغصون يغرد","https://www.poetsgate.com/ViewPoem.aspx?id=129326",""],[5409,"لم تنجب الأيام إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155495",""],[5498,"توبة","https://www.poetsgate.com/ViewPoem.aspx?id=216043",""],[5582,"سُلطانُ لا زِلْتَ فِي عَلْياكَ سُلْطانا","https://www.poetsgate.com/ViewPoem.aspx?id=187305",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5596,"السحمية","https://www.poetsgate.com/ViewPoem.aspx?id=206361",""],[5596,"من وحي \"بون\"","https://www.poetsgate.com/ViewPoem.aspx?id=206482",""]],"verses":[["أدهى من الجهل علم يطمئن إلى","أنصاف ناس طغوا بالعلم واغتصبوا",0,"ب",3,0],["أَدهَشَ العالَمَ لَمّا أَن رَأَوا","جَيشَهُ يَسبِقُ في الجَريِ النَعاما",1,"م",2,0],["أدهش الخلق رافئيل لوم يب","لغه منه ما شاءه التصوير",2,"ر",1,0],["أدهق الدهر بالمنيّة كاسه","من قديم وطاف يسقي أناسه",3,"س",2,1],["ادهى الكوارث ما يشقى الجميع به","والحادث الفرد دون الحدث العمم",4,"م",1,0],["أدهمٌ كالظلام تشرقُ فيه","شَعَرَاتٌ منيرةٌ للعيونِ",5,"ن",1,1],["أَدهم عنده من الليل جلد","ومن الصبح غرَّة وحجول",6,"ل",1,0],["أَدهَمٌ يَصدَعُ الدُجى بِسَوادٍ","بَينَ عَينَيهِ غُرَّةٌ كَالهِلالِ",7,"ل",1,0],["أَدْهَى الْمَصَائِبِ غَدْرٌ قَبْلَهُ ثِقَةٌ","وَأَقْبَحُ الظُّلْمِ صَدٌّ بَعْدَ إِقْبَالِ",8,"ل",1,0],["أَدْهَشَ الْخَلْقَ رَافَئِيلُ وَلَمْ","يَبْلُغْهُ مِنْه مَا شَاءَ التَّصْويرُ",9,"ر",1,0],["أدهى النصيحة ما يأتيك مرتديا","ثوب الصداقة تضليلاً وتمويها",10,"ي",3,0],["أدهرى عميد الحب والعود ذابل","فهلا واملود الشباب نضير",11,"ر",1,0],["أدهى وأجهد من وق","وع المرء في أيدي اللصوص",12,"ص",1,0],["أَدهَشتهم أخبارهُ كشياهٍ","راعَها قسورٌ وغاب الرعاءُ",13,"ا",2,0],["أدهاها من الهوى ما دهاني","فقلاها حبيبها واجتواها",14,"ا",3,0],["أدهى لنا من سحر بابل أعيا","ومباسماً من ابنة الزرجون",15,"ن",1,0],["أدهمُ كالليلِ وفي غُرّتِه","لناظرٍ ينظرُه بدرُ دُجى",16,"ا",1,0],["أدهمٌ كالظلامِ تهدى إلى القلب","أياديهِ مثل كفّ الكليم",17,"م",1,0],["أَدهَشَها سُكرُنا فَإِن يَكُن الصَم","تُ حَديثاً فَذاكَ عَن فَرَقِ",18,"ق",1,0],["أدهمَ الجِلبَاِ يَحكي لَونُه","قلبَكَ الدَّاجي الغُدافي المُعتكِر",19,"ر",1,0],["أَدَهراً تَوَلّى هَل نَعيمُكَ مُقبِلُ","وَهَل راجِعٌ مِن عَيشِنا ما نُؤَمِّلُ",20,"ل",1,1],["أَدَهراً تَوَلّى هَل لَنا مِنكَ عَودَةٌ","لَعَلَّكَ يُعدي آخِراً مِنكَ أَوَّلُ",20,"ل",1,0],["أدها كما حتف ولم يك حينه","فد آن ام ذاك القضاء المبرم",21,"م",1,0],["أدهَى وَأعظَمَ لَوعَةً ورَزيَّةً","مِن هَولِ يَومِكَ في بَني عَدنانِ",22,"ن",1,0],["أدهشتها بدائع الحسن فيها","حين أبدت غرائب الافتنانِ",23,"ن",1,0],["أَدهى وأحلم ممّن كان قد قرعت","له العصى حين يحوي المجلس الحشما",24,"م",2,0],["أَدهى وأَحكم مِن قيس بن عاصم في","ما قالَ في كلّ دستٍ منه محضورِ",25,"ر",1,0],["أَدهَشتَ مُقلَتَنا بِفَضلٍ ظاهِرٍ","وَسَلَبتَ مُهجَتِنا بِذا اللُطف الخَفي",26,"ف",2,0],["أَدْهُم اللَّيْلِ بِهذي أَبْلَقٌ","وحُسامُ الصُّبْحِ مِنْ هذا صَدِ",27,"د",1,0],["أدهرك ذا الوادي من الدم مترع","إذا أمسكت بالوبل عنه الغمائم",28,"م",1,0],["أَدهى الشَواهد للعشاق شاهدهم","قرب وَبعد وَتَعزير وَتَذليل",29,"ل",1,0],["أَدِهش الناس يومَ قيل صحت مص","رُ وكانت في غَفلة وسُبات",30,"ت",1,0],["أدهش الناظرين نور سرور","من لقاه وجدّد الأفراحا",31,"ح",2,0],["أدهِقِ الكأسَ من سُلافِ مُدامِ","بقيتْ في الدِّنان من عهد سام",32,"م",1,1],["أدهشته أنوارها فهو ح","يران لدنيا ذهابه كالمجيِّ",33,"ي",1,1],["أدهتك أرض أم رمتك سماء؟!!","الله ماذا يكتب الشعراء؟!",34,"ا",2,1],["أَدهم تَعشي العُيون غرّتُه","تَحسَبُ لَيلاً وَوَجهَهُ شفقُهُ",35,"ق",2,0],["أدهَشَتني تيَّهتني","حيَّرَتني في بهاها",36,"ا",3,0],["أدهبَ عينيها فإنسانُها","في ظلّه لا يهتدي حائِرُ",37,"ر",1,0],["أدهق الكأس لا ترقّ لضعفي","فهي للضعف من أتم العلاج",38,"ج",1,0],["أَدِهقانُ حالَ النَأيُ دونَكِ وَالهَجرُ","وَجَمعُ بَني قَلعٍ فَمَوعِدُكِ الحَشرُ",39,"ر",1,1],["أدهشتهم ذات عزٍّ سرّها","أن تُذِلّ النفس في نيل رِضاك",40,"ك",1,0],["أدْهَمَ قيِّدِ كُلِّ وَحْشٍ شارِدٍ","قبَّلَه الليلُ فكُلُّه لَمَى",41,"ا",1,0],["ادهشها الرعب ولم تلف من","باب نجى للامن مفتوح",42,"ح",1,0],["أدهشت وحش الفلا هيبتها","فانثنى للبيد عنها مسترابا",43,"ب",2,0],["أدهق علي الكأس يا ساقي وزد","من راح من راح الهوى يتزود",44,"د",1,0],["أدهى وأعجب ما لاقيت من زمني","ومنك إني غريب الدار في وطني",45,"ي",1,1],["أدهشتها والحرفُ نورٌ مشرقٌ","في القولِ ليلٌ ضوؤهُ أفكاري",46,"ر",2,0],["أدهشت أرباب النهي بمحاسن","بجلالها أنت الأمير المفرد",47,"د",1,0],["أدهشت أرباب العقو","ل بعظم ما أوتيت عقلا",48,"ل",2,0],["أدُهشتَ لمَّا أنكروكَ مبلجا","وألِمْتَ لمَّا ألبَسوكَ نقابا؟!",49,"ب",2,0],["أَدْهَى وَأَحْلَمُ مِنْ قَيْسِ بنِ عاصِمِ بَلْ","أَذْكَى وَأَفْصَحُ مِنْ قُسٍّ وَسَحْبانا",50,"ن",2,0],["أَدْهَى وَأَحْلَمُ مِمَّنْ كانَ قَدْ قُرِعَتْ","لَهُ العَصا حِينَ يَحْوِي المَجْلِسُ الحَشَمَا",51,"م",2,0],["آدهُ السير موغلاً وحثيثاً","في متاهات أعصر مخفية",52,"ي",2,0],["آده التفاح خوطاً ناعماً","فصبا دلاًّ ولمّا يصب",53,"ب",1,0]]}