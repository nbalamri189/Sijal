{"poems":[[51,"من شرف الفقر ومن فضله","https://www.aldiwan.net/poem64213.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54735","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43874","الخفيف"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/117001","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[113,"الديه نهب النفوس مباح","https://www.aldiwan.net/poem16449.html","الخفيف"],[240,"قل لصديقي أبي علي","https://www.aldiwan.net/poem31802.html","مجزوء البسيط"],[422,"من لصب متيم مستهام","https://www.aldiwan.net/poem53989.html","الخفيف"],[463,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[463,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199569","المسحوب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37861","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100261","البسيط"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107014","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132537","السريع"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146874","المنسرح"],[4874,"القصايد","https://www.poetsgate.com/ViewPoem.aspx?id=176613",""],[4987,"الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=49628",""],[5452,"رسائل حبلى بطيب العيد","https://www.poetsgate.com/ViewPoem.aspx?id=117587",""],[5976,"يا ملكْة الشعْر ..","https://www.poetsgate.com/ViewPoem.aspx?id=31767",""],[6047,"إن كتمت الهوى تزايد سقمي","https://www.poetsgate.com/ViewPoem.aspx?id=182572",""],[6056,"عكّر الله مزاجه","https://www.poetsgate.com/ViewPoem.aspx?id=130324",""],[6113,"لاتخاصمني ولاهم يحزنون","https://www.poetsgate.com/ViewPoem.aspx?id=26373",""],[6115,"هذي الحقيقه وافهم العلم وعفاك","https://www.poetsgate.com/ViewPoem.aspx?id=181734",""]],"verses":[["أَنَّكَ تَعصي اللَهَ تَبغي الغِنى","وَلَستَ تَعصي اللَهَ كَي تَفتَقِر",0,"ر",1,0],["إِنْ كَتَبْتْ أَوْ خَطَبَتْ نَافَسَتْ","أَقْوَالُهَا اللُّؤلُؤَ وَالْعَسْجَدا",1,"د",2,0],["إِنْ كتمتُ الهوى فقَدْ","صارَ سِرّي علانِيَهْ",2,"ه",1,1],["أنكَ تعصي كي تنال الغنى","وليسَ تعصى اللَه كي تفتَقِر",3,"ر",1,0],["إن كتمناهُ قهقه الدهرُ جذلا","نَ ومدّ الخبيثُ طرفَ لسانه",4,"ن",2,0],["إِن كُتُبي إِلَيهِ صَحف الأَماني","وَبِها الرُسُل بِيَنَنا أَرواح",5,"ح",1,0],["أَنَّكَ تَجلو هَمّي بِيَومٍ","يَجمَعُ أَطرافَهُ الفُسوقُ",6,"ق",1,0],["إنْ كتمت الثناء حيناً عليكم","ضاق صدري به عن الاكتتام",7,"م",1,0],["أنك تَبقَى مالكاً خالداً","ما ردّ منه الدهر أو كرّرا",8,"ر",2,0],["إن كتبوا قلتَ اصطلاماً طعنوا","أو طعنوا قلتَ بلاغاً كتبوا",9,"ب",3,0],["أنك توفّقني توافيقٍ خيار","بك نقتدي طرق الجدى والعدالي",10,"ل",2,0],["إِنّ كِتابَكم إِلَينا وَصَلا","فسرَّني ونِلت منه الأمَلا",11,"ل",2,0],["إن كت فردا والناس جمعٌ","فبدر كل الأنام فردُ",12,"د",1,0],["إن كتاباً لم يكن يبتدي","فيه بذكر الآل بع النبي",13,"ي",1,1],["انك تبغي خطة مالها","في الدين والدنيا جميعاً نصيب",14,"ب",1,0],["إن كتم الليل حدث العبق","عنها وبعض الحديث ينتشق",15,"ق",1,1],["ان كتبته يختصم عرضه وطوله","منهو اللي ضيق الكون المديد",16,"د",1,0],["أن كتبنا للوطن صارت الريح الرواه","وأن تحدثنا حكايات وأشجان وشجن",17,"ن",1,0],["أنكتم أنفاس يوم جميل","تفوح بساتينه سوسنا",18,"ن",2,0],["إن كتبتك مرّني طيف السحاب","ثم تزلزل ماطر العشق المجيد",19,"د",1,0],["إن كتمت الهوى تزايد سقمي","وأخاف العيون حين أبوح",20,"ح",1,1],["إنك تبدّل ، كربة الهم ، بإفراج","وتوسّع الضيقة ،، بزود ، إنفراجه",21,"ج",2,0],["ان كتبت احساسي لك يستغربون","ون بكيت الناس تستغرب بكاي",22,"ا",2,0],["أنك تقدينا لتقواك وهداك","ياباسطٍ عرشك على الكون عالي",23,"ل",2,0]]}