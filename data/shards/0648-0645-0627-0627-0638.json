{"poems":[[63,"أردد الظن بين اليأس والأمل","https://www.aldiwan.net/poem46141.html","الطويل"],[82,"أطال ليلى الكمد","https://www.aldiwan.net/poem29417.html","الرجز"],[45,"لأوشك شعب الحي أن يتفرقا","https://www.aldiwan.net/poem65185.html","الطويل"],[61,"أكف تغلب أنواء الحيا الجاري","https://www.aldiwan.net/poem51679.html","البسيط"],[44,"ما اليوم أول توديع ولا الثاني","https://www.aldiwan.net/poem30338.html","البسيط"],[46,"إن يقرب الموت مني","https://www.aldiwan.net/poem22148.html","المجتث"],[46,"حورفت في كل مطلوب هممت به","https://www.aldiwan.net/poem22431.html","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140819",""],[283,"في مدحي الصاحب ماض عزمي","https://www.aldiwan.net/poem32459.html","الرجز"],[417,"دعاه إلى الهوى داعي التصابي","https://www.aldiwan.net/poem54151.html","الوافر"],[433,"أرى الإقامة أضحت في يد الظعن","https://www.aldiwan.net/poem12319.html","البسيط"],[559,"وما أظنك تجد من بعد هذا شي","https://www.aldiwan.net/poem33566.html","المواليا"],[576,"يا منية القلب لولا أن يقال سلا","https://www.aldiwan.net/poem2902.html","البسيط"]],"verses":[["وما أظُنُّ عُهودَ الرّمْلِ باقِيَةً","وأيُّ عَهْدِكِ يا ظَمْياءُ لم يَحُلِ",0,"ل",1,0],["وما أظن أنه","لليلة الهجر غد",1,"د",1,0],["وَما أَظلَمَ الإِسلامُ إِلّا تَأَلَّقَت","نَواحيهِ في ظَلمائِهِ فَتَأَلَّقا",2,"ق",2,0],["وما أَظُنُّ دَعِيَّ الأزدِ يُنْصِفُني","حتى تموجَ به أمواجُ تَيَّاري",3,"ر",2,0],["وَما أَظُنُّ النَوى تَرضى بِما صَنَعَت","حَتّى تُطَوِّحَ بي أَقصى خُراسانِ",4,"ن",1,0],["وَما أَظُنُّ المَنايا","تَخطو كَواكِبَ جَربَه",5,"ب",2,0],["وَما أَظُنُّ جِنانَ الخُلدِ يُدرِكُها","إِلّا مَعاشِرُ كانوا في التُقى جُهدا",6,"د",2,0],["وما أظن بنات الدهر تتركني","حتى تسد عليها طرقها هممي",7,"م",2,0],["وَما أَظُنُّ ذاكَ عِندَ رَبِّنا","يا فُقَهاءُ مِن كَبيرِ الإِثمِ",8,"م",1,0],["وما أظمأك يا كبدي غليلاً","إلى رشف الثنايات العذاب",9,"ب",1,0],["وما أَظُنُّكَ تَنْسَى كّلَّ سائِرَةٍ","مُقِيمَةٍ غَرَّبَتْ لِلْحُسْنِ في الوطَنِ",10,"ن",1,0],["وما أظنكْ تجدْ من بعد هذا شي","لكن تعطلْ وتنفي للإله الحي",11,"ي",1,1],["وما أَظُنُّ ديارَ القلبِ مَسْكَنَكُمْ","بأَنَّني فِيه قَدْ أَكْرَمْتُ مَثْوَاكِ",12,"ك",1,0]]}