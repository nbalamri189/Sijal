{"poems":[[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[95,"مصر تناديكم فمن يحجم","https://www.aldiwan.net/poem11320.html","السريع"],[87,"قل للرجال طغى الأسير","https://www.aldiwan.net/poem62967.html","مجزوء الكامل"],[45,"لكل امرئ من دهره ما تعودا","https://www.aldiwan.net/poem9529.html","الطويل"],[64,"وكرمة أعراقها في الثرى","https://www.aldiwan.net/poem52501.html","السريع"],[33,"طال ليلى واعتادني اليوم سقم","https://www.aldiwan.net/poem41336.html","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141002",""],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16689","الطويل"],[92,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[33,"طَالَ لَيْلي، وَکعْتَادَني اليَوْمَ سُقْمُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19069&r=&rc=332",""],[310,"الدهر حرب بالرزايا الفجع","https://www.aldiwan.net/poem56486.html","الكامل"],[371,"عد العتاب فما أعدت عتابا","https://www.aldiwan.net/poem17313.html","الكامل"],[379,"يا مظهر العقل في ولايته","https://www.aldiwan.net/poem4134.html","المنسرح"],[438,"آيات جدك لم تزل تتلى","https://www.aldiwan.net/poem12379.html","الكامل"],[438,"عارض الصفح في يديك الصفاحا","https://www.aldiwan.net/poem12583.html","الخفيف"],[454,"اللغة العربية","https://www.aldiwan.net/poem969.html","عموديه"],[463,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[466,"يا عاقدا وضن الجمال البزل","https://www.aldiwan.net/poem16248.html","الكامل"],[473,"ووضيع يقاوم الشرفاء","https://www.aldiwan.net/poem60515.html","الخفيف"],[505,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[534,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[563,"أيها البرق اللموع","https://www.aldiwan.net/poem34383.html","مجزوء الرمل"],[592,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138280",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122626","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87067","الخفيف"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199616","المسحوب"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77612","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77493","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70970","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119886","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17078","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64799","المتقارب"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115867","الكامل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82504","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48974","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110255","الكامل"],[2135,"","https://poetry.dctabudhabi.ae/diwan/poem/203566",""],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109467","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106853","الكامل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116519","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100222","المتقارب"],[3328,"","https://poetry.dctabudhabi.ae/diwan/poem/101867","الكامل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3605,"","https://poetry.dctabudhabi.ae/diwan/poem/130569","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110022","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216589","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114506","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95326","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103016","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125857","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119626","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90944","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4578,"","https://poetry.dctabudhabi.ae/diwan/poem/114606","الكامل"],[4690,"تباريحُ روح","https://www.poetsgate.com/ViewPoem.aspx?id=153094",""],[4836,"أمى","https://www.poetsgate.com/ViewPoem.aspx?id=203611",""],[4845,"وللشعر ميزان تسمى عَروضَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=134973",""],[4852,"عشتار","https://www.poetsgate.com/ViewPoem.aspx?id=214386",""],[4858,"سيدي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=34882",""],[4927,"سَهَرُ الْعَاْشِق","https://www.poetsgate.com/ViewPoem.aspx?id=29636",""],[4956,"سلام على العلم","https://www.poetsgate.com/ViewPoem.aspx?id=1394",""],[5186,"رمى النهب عن قوس الهوى رآئش التهم","https://www.poetsgate.com/ViewPoem.aspx?id=156476",""],[5277,"لا تعجبوا","https://www.poetsgate.com/ViewPoem.aspx?id=191253",""],[5431,"كي لا تُداس وتُكسرا","https://www.poetsgate.com/ViewPoem.aspx?id=196669",""],[5431,"إني سخرت اليوم من ألمي!!","https://www.poetsgate.com/ViewPoem.aspx?id=197151",""],[5542,"يا فارس الكرسي","https://www.poetsgate.com/ViewPoem.aspx?id=9679",""],[5689,"حي بدرا بافق مسرتا، تلالا","https://www.poetsgate.com/ViewPoem.aspx?id=143437",""],[5858,"يوم التقينا","https://www.poetsgate.com/ViewPoem.aspx?id=190523",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[5956,"غَنَمٌ هَرَبْنَ من الحظيرة للشارع","https://www.poetsgate.com/ViewPoem.aspx?id=183499",""]],"verses":[["وَوَضعِ سِقاءٍ وَإِحقابِهِ","وَحَلَّ حُلوسٍ وَإِغمادِها",0,"د",3,0],["وَوَضَحَ الفَرْقُ لَهُمْ بَيْنَ مَا","يَحِلُّ مِنْ أَمْرٍ وَمَا يَحْرُمُ",1,"م",1,0],["وَوَضَعتَهُ وَعَلِمتَ أَن","نَ حِسابَ واضِعِهِ عَسير",2,"ر",1,0],["وَوَضعُ النَدى في مَوضِعِ السَيفِ بِالعُلا","مُضِرٌّ كَوَضعِ السَيفِ في مَوضِعِ النَدى",3,"د",2,0],["ووضَعتها نُجُبَاً تنتمِي","إِلى أبٍ أكرِمْ به من أبِ",4,"ب",1,0],["وَوَضيءٌ كَالشَمسِ بَينَ سَحابٍ","رائِحٍ مَقسَرَ العَشيَّةِ فَخمُ",5,"م",1,0],["\"ووضع النّدى في موضع السّيف بالعلا","مضرٌّ، كوضع السّيف في موضع النّدا\"",6,"د",2,0],["وَوضْعي لها حَدَّ الشّتاءِ وسَيْلَها","علَيّ إذا حَثّ الرّبيعُ قِيانَه",7,"ن",2,0],["ووضعٍ أمسِ كُلُهمُ لواهٍ","به واليوم كلُهم لواحي",8,"ح",2,0],["وَوَضِيءٌ كَکلشَّمْسِ بَيْنَ سَحَابٍ","رَائِحٍ، مَقْصَرَ العَشِيَّة ِ، فَخْمُ",9,"م",1,0],["وَوَضعتَ عَن كتفيك أعباءَ الأما","نَةِ غَير مشتطٍّ وغير مضيّعِ",10,"ع",1,0],["وَوَضَعتُ قَدرَكَ أَن يَكونَ سَحابَةً","وَرَفَعتُ قَدري أَن يَكونَ تُرابا",11,"ب",2,0],["وَوَضعُك الشَيءَ غيرَ مَوضعِه","يَشهد عند الأَنامِ بالحُمُق",12,"ق",1,0],["ووضَعْتَ كُلاًّ عند مَوْضِعِه","في حيثُ لا حاشَا ولا كَلاّ",13,"ل",2,0],["ووضعْتَ السّلاحَ حين أراك ال","حزْمُ والرأيُ أن وضعتَ السلاحا",14,"ح",2,0],["ووضعت الاسم والفعل ولم","تتركي الحرف طليقاً سيدا",15,"د",2,0],["ووضَحتْ على ضَلالاتِ السُّرى","طُرْقُ المنى للرائد الملتمسِ",16,"س",1,0],["ووضعت أثْقال المكوس وقد وهَتْ","منها الكَواهِلُ وانْتهتْ للمقْتل",17,"ل",1,0],["وَوَضيعٍ يُقاوِمُ الشَرَفاءَ","وَيُناوي المُلوكَ وَالكُبَراءَ",18,"ا",2,1],["ووَضيعٌ ورَفيعٌ","وأخو ظُلْمٍ وعادلْ",19,"ل",1,0],["وَوَضَعْتُ عَنْ عُنُقِي عَصَا التَّرْحالِ لا","أَخْشَى العَذُولَ ولا قَبيحَ عِتابِهِ",20,"ب",2,0],["ووضوئي وصلاتي","وثنائي والخشوع",21,"ع",1,0],["ووضع المصلى في المساجد بدعة","وليس من الهدى القويم المسدد",22,"د",1,0],["ووضوح رأيك في الصعاب كأنه","صبح بدا بعد الدجى يتفجر",23,"ر",1,0],["ووضعتَ أوزارَ الذُّنُوبِ بوقفَةٍ","ما حَربُها مَوضُوعَةُ الأوزارِ",24,"ر",1,0],["وَوَضعت الزِمام في يَد قَوم","يَحفَظون الذمام إِن صالَ ضَيغم",25,"م",1,0],["ووضحّت في وصفي وفي معنايه","وإذا خلف عنهم بعيد مسيره",26,"ه",1,0],["وَوَضعوا الرايَةَ وَالعمامَه","وَحَمَلوا ريشاً مِن النعامَه",27,"ه",1,0],["وَوَضعت في رجلِهِ القُيود","وَشَمَت العاذل وَالحَسود",28,"د",1,0],["ووضيعٍ كم يدَّعى الفضلَ إفكا","وهْو عن ذاك أبعدتْه المخازى",29,"ز",2,0],["ووضعت عن كتفي السؤال لغيره","والموت أطيب من سؤال وضيعِ",30,"ع",1,0],["وَوَضيعاً في فُؤادٍ","وَرَفيعاً في عَيانِ",31,"ن",1,0],["ووضَّاحُ ثَغْرٍ إِذا ما بَدا","أَنارَ الظَّلامَ بِنوَّارِهِ",32,"ر",2,0],["ووضعه اعلا الحروف المعلمه","مهملةً جاءت به أو معجمه",33,"ه",1,0],["ووضع اعلاه كوضع النصبِ","وعنه دال جُد بجزمٍ ينبي",33,"ي",1,0],["ووضعوا فاصلةً لكل ما","قد انتهى ووضعه قد فهما",33,"م",2,0],["ووضعوا بسطا لذات الوقف","واثلثوا مبسوطها في العرف",33,"ف",1,0],["ووضعه قبل الطلوعِ أردفا","بألفٍ وما به قد وصفا",33,"ف",2,0],["ووضعةا مدغمة عن الوسط","قلت الصحيح وضعها هنا غلط",33,"ط",1,0],["ووضعتُهُ بيدى على","قلبٍ أبَى إلاّ التهابا",34,"ب",2,0],["وَوَضعتَ نَفسَكَ مِن قَديم فَعالِهِم","وَمَناقِبٍ لَكَ حيثُ شِئتَ وَشاءوا",35,"ا",3,0],["ووضعتُهُ في مُقلتي فأَطار لي","دَمعي شُعاعاً واْستطار رُقادي",36,"د",2,0],["ووضعتُهُ بين الضُّلوعِ فطار مِنْ","قَفَصِ الضُّلوعِ كطائرِ الأَعْواد",36,"د",1,0],["وَوَضَعَت إِبناً وَبِنتاً تَوأَما","فَسُرَّ لَمّا سَلِمَت وَسَلِما",37,"م",2,0],["ووضعت قدري واستبحت محرَّ","ماتِ الدين من سُكرٍ ومن ألعاب",38,"ب",1,0],["ووضعته دون الحضي","ض لوَ انه في الفرقدين",39,"ن",1,0],["ووضعت في قلبي مطوَّل سره","والقلب فيه توضع الأسرار",40,"ر",1,0],["وَوَضَعتُمُ لِلجسمِ مَعنًى غَيرَ مَع","رُوفٍ بِهِ فِي وَضعِ كُلِّ لِسَانِ",41,"ن",1,0],["ووضيعةٍ نزل الزمانُ بها فلم","يترك لها إلا الحياةَ متاعبا",42,"ب",2,0],["ووضا جميع القوم من ضيق الوعا","وجاشت بماء الطهر عينان لم تجر",43,"ر",1,0],["ووضاح وجهٍ إذا ما للزما","ن قطب وجهاً وكشر نابا",44,"ب",2,0],["ووضعت خدي تحت وطي نعاله","من حقه ما قمت بالمعشار",45,"ر",1,0],["ووضع الحجر في القبيليّه","كذا سمعنا هذه القضيّه",46,"ه",1,0],["ووضعوه في جدار القبله","يا ليتني انال منه قبله",46,"ه",1,0],["وَوَضُعوا لِبَعضِ الأجنَاسِ عَلَم","كَعَلَمِ الأشخَاصِ لَفظاً وَهوَ عَم",47,"م",1,0],["ووضع الكنوز عند الدول","ذخيرة للزمن المستقبل",48,"ل",1,0],["ووُضِعتَ لمّا إِن رُفِعتَ","ولم تُخيَّب من جَزائِك",49,"ك",1,0],["ووضيع رحت أذروه الى","مطلع النجم كما يُذرى الهشيم",50,"م",1,0],["ووضحَها بمختصرٍ خَليلٌ","لهُ التوضيحُ في فقهٍ يُضافُ",51,"ف",1,0],["ووضع إحسانٍ بغير موضعِهْ","ظلمٌ ولا نفعَ لظلمٍ أجمعِهْ",52,"ه",1,0],["ووضع الإنسان في البيع وقد","وُكستَ إذ بايعتنا فلا تعُد",53,"د",1,0],["ووضعت ثغر السمهري بثغره","فافتر عنه بأشنب بسام",54,"م",1,0],["ووضع العدة فوق العجله","ثم اعتلى منتصباً بالعجله",55,"ه",1,0],["ووضعوا الأساس ثم رفعوا","تلا من التراب ثم رجعوا",56,"ع",3,0],["وَوَضَعَت إِزاءَها كَوكباً أَغَر","كانَ لَدى نَسطورَ مِن قَبلِ السَفَر",57,"ر",1,0],["ووضع أمرُه عجيبُ","له ألماً تفطَّرت القلوبُ",58,"ب",1,1],["ووضحوا لي الطريق في أدب","كانوا بحفظ الملك المُهيمن",59,"ن",1,0],["ووضع كفي عليه جن أوطارا","لو شاب دمعي بحار الأرض أغرقها",60,"ه",2,0],["ووضَعْنا للمستضيء بأمر ال","له عن أوليائه كل إصرِ",61,"ر",1,0],["ووضعت اوزار الوغى بحمية","بحمى علاها لاذت الوزراء",62,"ا",2,0],["ووضعتُ روحي فدوةً لرضائه","وجعلتُه كل الدنا ، عندي",63,"د",2,0],["ووضاءةٌ وخفارةٌ ومهابة","وسماحة وتصوّنٌ وتعففُ",64,"ف",1,0],["ووضع مفاعيلن لخرم وشتره","وللخرب أعلم بالمراتب ما خفى",65,"ا",1,0],["ووضأتَ الحنايا .. بالسجايا","فصلّتْ بعد \"حي على الفلاح\"",66,"ح",1,0],["ووضعتَ في أيمانهم علم الهدى","كيما يرفرف في سما الأحياءِ",67,"ا",2,0],["وَوَضَعْنَ فَوْقَ الْقَبْرِ صَخْراً جَلْمَداً","وَالصَّخْرُ عَنْ حِنْثِ الْغَوَاْنِيْ تَرْجَمَاْ",68,"م",2,0],["ووضعِ اختبارٍ وطَبْعٍ ونسخٍ","ورِقْبَةِ مَن يحسب الغشّ فنّا",69,"ن",2,0],["ووضع الندى في موضع السيف زيفة","وإيقاد نار الحرب في موطن السلم",70,"م",1,0],["ووضوؤُنا ماءُ العفافِ عنِ الَّتي","قدْ حَفَّها طهرٌ بطيبِ تيمُّمِ",71,"م",1,0],["ووضعته اليم البعيدَ","لكي يُردَ وأُجبرا",72,"ر",2,0],["ووضعت طفلي كنه معجزة","فجر الربيع ووافر النعم",73,"م",1,0],["ووضعت جبهتك الكريمةَ ساجداً","إنَّ السجود ليرفع الإنسانا",74,"ن",2,0],["ووضعتم على الرقاب من الجه","ل بأيدي بينكم الأغلالا",75,"ل",2,0],["ووضَعتِ كَفَّكِ فوقَ صَدري فانطفتْ","نارُ اصطباري إذ يُكَوِّيني السَّفَرْ",76,"ر",1,0],["ووضوعها ولد الأخي","ر ضرا الخلاط بما احتجب",77,"ب",1,0],["وَوَضَعْتُهُنَّ أمام ماءٍ رُبما","يَحْيَيْنَ رغم الاحتضار الدامعِ",78,"ع",1,0]]}