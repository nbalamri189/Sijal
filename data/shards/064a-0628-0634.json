abi.ae/diwan/poem/132944","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45784","الطويل"],[3811,"","https://poetry.dctabudhabi.ae/diwan/poem/146446","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69981","الوافر"],[164,"","https://poetry.dctabudhabi.ae/diwan/poem/127644","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94558","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94554","الطويل"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120267","الوافر"],[4830,"وَعْدُ اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=213549",""],[4927,"غربة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=29605",""],[5102,"ميلاد الشرق الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=13808",""],[5136,"أيا ملكا جلا كرب الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=121662",""],[5459,"بعثة الرحمة المهداة","https://www.poetsgate.com/ViewPoem.aspx?id=190905",""],[5790,"تثنى كما هز الرديني حامله","https://www.poetsgate.com/ViewPoem.aspx?id=111888",""]],"verses":[["يُبَشِّرُ وَالقُلوبُ مُفَجَّعاتٌ","كَأَنَّ بَشيرَهُ في الخَلقِ ناعِ",0,"ع",1,0],["يُبَشِّرُها بُعدُ هِمّاتِنا","بِأَنَّ الحِمامَ قَريبُ الخُطا",1,"ا",1,0],["يُبَشِّرُ بالشّمْلِ الجَميع قُدومُها","وتأْتي معَ العيْشِ الخَصيبِ على وعْدِ",2,"د",1,0],["يُبَشِّرُنا بِالنائِلِ الغَمرِ وَجهُهُ","وَقَبلَ الحَيا ما تَستَطيرُ المَخايِلُ",3,"ل",1,0],["يبشر مستعليا بائن","من الحالبْين بان لا غِرارا",4,"ر",2,1],["يبشِّرنا النصرُ الذي قد مُنحْتَهُ","بأنك عند الله خيرُ إمامِ",5,"م",1,0],["يُبَشِّر بالخَيْرِ بعد السرورِ","وبالرُّخْصِ بعد الغلا الدَّائم",6,"م",1,0],["يُبَشِّرُني مِنكَ الرَسولُ بِزَورَةٍ","فَإِن صَحَّ هَذا إِنَّني لَسَعيدُ",7,"د",1,1],["يُبَشِّرُ الناسَ بِهادٍ جاءَهُم","وَأَن مَهدِيَّ الزَمان قَد أَتى",8,"ا",1,0],["يُبَشِّرُني أَن لَن أَموتَ وَأَنَّهُ","سَيُخلِدُني في جَنَّةٍ وَسَلامِ",9,"م",1,0],["يُبَشِّرُني قَومٌ بِرُتبَتِكَ الَّتي","تَمَنَّيتُ فيها السُؤلَ حَتّى لَقيتُهُ",10,"ت",2,1],["يُبَشِّرُهُ بِالنَصرِ إِرهافٌ نَصلِهِ","فَيَهتَزُّ في كَفِّ الكَمِيِّ وَيَضحَكُ",11,"ك",1,0],["يُبَشِّرُ بِالتَّآزُرِ كُلَّ خيْرٍ","وَيدْفَعُ بِالتنَاظُرِ كُلَّ شَرِّ",12,"ر",1,0],["يُبَشرني الظَنّ الجَميل بِنعمةٍ","مِن اللَهِ لا تَنفك في السرّ وَالجَهر",13,"ر",1,0],["يُبَشِّرُ بِالرِضوانِ عَبداً أَطاعَها","وَيُنذِرُ بالنيرانِ خَلفاً أَضاعَها",14,"ه",2,0],["يُبشر ماضٍ قادما عنك بالغنى","ويَلْقى وفودا من نَداك وفود",15,"د",1,0],["يبشّرني عنه بأن قد بدا له","قريباً بآفاق العلا طالعُ السعد",16,"د",1,0],["يُبَشّرُ آمالَ الرّجالِ ببِشْرِهِ","كما بَثَّ أنوارَ الصباح سُطوعها",17,"ع",3,0],["يَبَشُّ مِن هونٍ لِأَقدارِهِم","وَالسَيفُ في الرَوعِ يُرى هَشّا",18,"ش",2,0],["يبشِّرُني بالغِنى عن فتىً","أجارَ على الدهرِ حتَّى استَجارَه",19,"ر",2,0],["يبشرنا بأنَّ يسو","ع منها يأتي يَسترضي",20,"ض",2,0],["يبشران بأن يسوع قام وما","رأى فساداً وهذا موضع المكث",21,"ث",1,0],["يبشرني بك في نظمه","فيا حبذا حبذا حبذا",22,"ا",1,0],["يَبُشُّ بِالوَفد حَتّى خلت وآفده","وَآفي يُهنِّيه بِالتأخير في الأَجَلِ",23,"ل",1,0],["يبشر أهل الشام سعدٌ مؤرخٌ","تزايد ربع الشام عدلاً بكاملِ",24,"ل",1,0],["يُبَشِّرُنا بسناهُ الصباحُ","وتخبرُنا عن نداهُ الغيومُ",25,"م",1,0],["يبشِّرُ عنها أنه عائدٌ بها","عليك مدى الأيام عمراً مطوَّلا",26,"ل",2,0],["يبشّرني هجرانه بوصاله","ولا عجبٌ أن يقدم الصبح غيهب",27,"ب",1,0],["يُبَشّركُمْ بالعَوْدِ مِنّا بِنِعْمَةٍ","وصِحَّةِ جِسْمٍ لَمْ يُضَرَّ بِضَرّاءِ",28,"ا",2,0],["يبشّرنا فيما نرى بإقامةٍ","وفي نعمٍ أُلْبِستَها بدوامِ",29,"م",1,0],["يَبَشّ مُحيّاها إِلى كُلِّ ناقِصٍ","وَتَعبَس في وَجهِ الكَريمِ وَتَصدُفُ",30,"ف",1,0],["يبشّر بالريح العقيمِ وإِنها","كما قال عمّا قَالَهُ بِكَ تعْقُمُ",31,"م",1,0],["يبشرنا بشره بالمنى","ويقضي لآمله بالنجاحِ",32,"ح",1,0],["يبشر ورّاده بشره","بربع فسيح ومرعى مربعِ",33,"ع",1,0],["يبشر أبرارا بتتويج هامة","وينذر فجرا بضرب المقامع",34,"ع",1,0],["يُبشِّر راجيه بنيل طلابه","لديه إذا ما رام نائلَه البشرُ",35,"ر",1,0],["يبشرنا بفرقة كل هم","أبداً ما قد رأينا فيه فرقا",36,"ق",2,0],["يبش إليه والأكياس ملأى","ويطره وما في الكيس باره",37,"ر",2,0],["يبشر بالزلفى كريم مقامه","ويستغرق الأسرار سكر مدامه",38,"ه",1,0],["يبشُّ فَيشفيني من الهمّ بشرُهُ","ويحبو فَيكفيني أذَى الفقر مَا يَحْبُو",39,"ب",2,0],["يبشرني علوك بالوزاره","ودار الملك أولى بالبشاره",40,"ر",2,1],["يبشر أهليها بأن أخا العلا","إليهم مع الألباب من مصرَ أقلعا",41,"ع",2,0],["يبشرُ باللقاءِ واي بشرى","أسر من الهناءِ إلى القلوبِ",42,"ب",1,0],["يبشرن في المهدي صاحب عصرها","ومن حل والشعرى من الأفق قائمه",43,"م",2,0],["يبشر ذا تقوى وينذر من طغا","وعيدا لمن يخشى، ومن يرتجي وعدا",44,"د",2,0],["يبشر من يلقاه بشر بوجهه","بما يرتجيه من سعادته رِفدا",45,"د",2,0],["يبشر جبريل به كل عالم","ويدعوا إلى آثاره خير آثار",46,"ر",1,0],["يبشرهم منهاج الحياة بشرعة","ويحدث من بعد الأمور أمورا",47,"ر",2,0],["يبش حيث تبدى وهو في خجل","من أن تراه كأن قلدته مننا",48,"ن",2,0],["يبشّرُنا بالخير وجهُ أميرنا","فلا زال بالإقبالِ يزهو ويُزهرُ",49,"ر",1,0],["يبش في ذي شبق يشتفي","بفيشةٍ تنفخت في قضيب",50,"ب",1,0],["يُبَشِّرُك النيروزُ باليُمن مُطلعا","عليك نجوماً ما تغيبُ سُعودُها",51,"د",3,0],["يُبَشِرُنا عَقد اللِواء بِنَصرة","بِها ابن لُؤيّ لِلعَدو نَذير",52,"ر",1,0],["يُبَشّرُهُ إبْلِيسُ عِنْدَ قُدُومِهِ","عَلَيْهِ بِأحْمَى بُقْعَةٍ في جَهَنّمِ",53,"م",1,0],["يُبشرنا بِما يَحلو وَيَجلو","غِشاءَ البُعدِ عَن بَصرِ المُبينِ",54,"ن",1,0],["يبشرُ ذا هذا وللقومِ ضجةٌ","وأَصواتهم مرفوعةٌ تتعالى",55,"ل",2,0],["يبشرنا بالأمن واليمن والرضى","ثملنا بمعنىً كلَّ عن فعلهِ الخمرُ",56,"ر",1,0],["يُبشرُ في وفد المفدّى وزيرنا","مشير المعالي حائز المجد والجدا",57,"د",2,0],["يُبَشِّرُ المَرْءَ لَو أَصْغَى وَيُنْذِرُهُ","فِي ما يُرَجِّيهِ في العُقْبَى وَيَحْذَرُهُ",58,"ه",1,0],["يبشرنا بايسار وفوز","ويهدينا المسرة والهدونا",59,"ن",2,0],["يبشُّ ابتهاجاً ترى عارضَيهِ","اذا كان جُرحُ الهوى قد أقاحْ",60,"ح",1,0],["يُبَشِّرُ الشَّرْقَ بِالإِشْرَاْقِ فِيْ زَمَنٍ","أَعَاْرَهُ الْغَرْبُ ثَوْبَ الْخِزْيِº وَالْحُلَلاْ",61,"ل",2,0],["يُبشَّرُ حلفُك أن الزوال","مصيرُه قبل زوال القذى",62,"ذ",2,0],["يبشر بالسلامة ناعم من","غصون القات مياس القوام",63,"م",1,0],["يُبَشِّرُ مُؤْمِنًا بِجِنَانِ خُلْدٍ","وَيُنْذِرُ مُشْرِكًا بِلَظًى وَ شُؤْمِ..",64,"م",1,0],["يبشر مه البشر راجى نواله","كذا الغيث لا تخفى علينا مخايله",65,"ل",2,0]]}