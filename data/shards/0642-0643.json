{"poems":[[164,"لم أستطع أنهى اللتي انهلت","https://www.aldiwan.net/poem59009.html","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62954","الكامل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143856","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52124","الوافر"]],"verses":[["قكل قدح هين ما خلا","قدح التي في القلب قد حلت",0,"ت",1,0],["قكأَننى قلتُ الكواكبُ مثله","أَو قلت انَّ الرزقَ ليسَ بجاهِلِ",1,"ل",1,0],["قكأنَّ الكأس لما جليت","طرب الجوُّ عليها فرقص",2,"ص",1,0],["قكم قد أَنْزَلتْ مَلِكاً بقبرٍ","وكان بعرش مجدٍ فيه عالِ",3,"ل",1,0]]}