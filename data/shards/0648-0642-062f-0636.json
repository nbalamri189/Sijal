{"poems":[[53,"عجبت من الأيام إنجازها وعدي","https://www.aldiwan.net/poem30624.html","الطويل"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[71,"فديت فتى ما زال ثاقب فكره","https://www.aldiwan.net/poem3879.html","الطويل"],[73,"تنشق من عرف الصبا ما تنشقا","https://www.aldiwan.net/poem11855.html","الطويل"],[88,"أمارس دهرا من جديدي داهرا","https://www.aldiwan.net/poem45015.html","الطويل"],[27,"لقد نادى أميرك باحتمال","https://www.aldiwan.net/poem5957.html","الوافر"],[23,"أشاقك من أم الوليد ربوع","https://www.aldiwan.net/poem21439.html","الطويل"],[72,"تأوب كالبدر في جنحه","https://www.aldiwan.net/poem18484.html","المتقارب"],[72,"وناعورة قسمت حسنها","https://www.aldiwan.net/poem19220.html","المتقارب"],[51,"لك الطائر الميمون والطالع السعد","https://www.aldiwan.net/poem10887.html","الطويل"],[51,"بكيت فلم تترك لعينك مدمعا","https://www.aldiwan.net/poem65076.html","الطويل"],[51,"أعوذ بحقويك العزيزين أن أرى","https://www.aldiwan.net/poem65771.html","الطويل"],[51,"نزا بعض المجانين","https://www.aldiwan.net/poem65865.html","الهزج"],[29,"عفا واسط من آل رضوى فنبتل","https://www.aldiwan.net/poem6022.html","الطويل"],[43,"ألا كل ماشية الخيزلى","https://www.aldiwan.net/poem9448.html","المتقارب"],[45,"بودي لو يهوى العذول ويعشق","https://www.aldiwan.net/poem65199.html","الطويل"],[28,"إذا هرت الأحياء حربا مضرة","https://www.aldiwan.net/poem5125.html","الطويل"],[61,"أهون علي بعبد الله إن غضبا","https://www.aldiwan.net/poem51798.html","البسيط"],[80,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[80,"بحكم زمان يا له كيف يحكم","https://www.aldiwan.net/poem31310.html","الطويل"],[52,"ومنطقة شدت بخصر معذبي","https://www.aldiwan.net/poem26965.html","الطويل"],[46,"إذا آمن الإنسان بالله فليكن","https://www.aldiwan.net/poem22603.html","الطويل"],[46,"قد طال في العيش تقييدي وإرسالي","https://www.aldiwan.net/poem23221.html","البسيط"]],"verses":[["وَقَد ضَمَّني مَحضُ الصَفاءِ وَصِدقُه","إِلَيكَ كَما ضُمَّت ذِراعٌ إِلى عَضدِ",0,"د",1,0],["وَقَد ضِقنا بِهِم وَأَبيكَ ذَرعاً","وَضاقَ بِحَملِهِم ذَرعُ البَريدِ",1,"د",1,0],["وَقَد ضاعَ مِن أَنفاسِ نظمِكَ نَفحَةٌ","مِنَ المِسكِ فَاجعَلها فِداماً لِختمِهِ",2,"م",2,0],["وَقَد ضَمَّنا مِن عَينِ شُهدَةَ مَشهَدُ","بَدَأنا وَعُدنا فيهِ وَالعودُ أَحمَدُ",3,"د",1,0],["وقد ضربوا وعداً لتكريم شاعر","تملّك صِيتاً في الأقاليم طائرا",4,"ر",2,0],["وَقَد ضَرَبَ اِبنَ كَبشَةَ إِذ لَحِقنا","حُشَيشٌ حَيثُ تَفرُقُهُ الفَوالي",5,"ل",2,0],["وَقَد ضارَبَت فيهِ بَنو الأَوسِ كُلُّهُم","وَكانَ لَها ذِكرٌ هُناكَ رَفيعُ",6,"ع",1,0],["وقد ضمَّ جَفنِي بزير الكرى","فيعرب في الحال عن فتحه",7,"ح",2,0],["وقد ضاع نشر الربى فاغْتدت","تدور وتبكي على الضائع",8,"ع",1,0],["وقد ضم عَنْزَ الأهل والذئبَ مرتعٌ","وأصبح ظَبْيُ الرَّمْلِ صالحه الفهدُ",9,"د",1,0],["وقد ضربت في خضرة الروض صُفرةٌ","من الشمس فاخضر اخضراراً مشعشعا",10,"ع",2,0],["وقد ضامني فيه لئيمٌ وعزَّني","وها أنا منه مُعْصِمٌ بحبالكا",11,"ك",2,0],["وقد ضمَّهما الحِمَّا","مُ والمجنون صوّالُ",12,"ل",1,0],["وَقَد ضَمَرَت حَتّى كَأَنَّ عُيونَها","بَقايا قِلاتٍ أَو رَكِيٌّ مُمَكَّلُ",13,"ل",1,0],["وَقَد ضَلَّ قَومٌ بِأَصنامِهِم","فَأَمّا بِزِقِّ رِياحٍ فَلا",14,"ا",1,0],["وَقَد ضَمَّنا وَشكُ التَلاقِي وَلَفَّنا","عِناقٌ عَلى أَعناقِنا ثَمَّ ضَيِّقُ",15,"ق",1,0],["وَقَد ضاقَ ذَرعاً مُصطَلوها بِحَرِّها","وَعادَت جَحيماً نارَها تَتَسَعَّرُ",16,"ر",1,0],["وقد ضربْتُ بسيفٍ مُرهَفٍ فنَبا","وقد قدحْتُ بَزْندٍ مُضرَمٍ فَخَبا",17,"ب",2,0],["وقد ضرَّمتَ نارَ الحرب حتى","حَكَتْ زفراتُها قِطَعْ الجحيمِ",18,"م",1,0],["وَقَد ضَرّجتْ ثَوبي لدى عينِ ضارجٍ","عليّ جفونٌ ماؤها بالأَسى دَمُ",19,"م",1,0],["وَقَد ضاعَ مِنّي الخَصرُ مِن فَوقِ رَدفِهِ","وَلا عَجَبٌ أَنّي عَلَيهِ أَدورُ",20,"ر",1,0],["وَقَد ضَفَرَت فَرعاً كَريمَةُ مَعشَرٍ","فَما حَلَّ إِلّا الغاسِلاتُ لَهُ ضَفرا",21,"ر",2,0],["وَقَد ضَنَنتَ بِشاةٍ وَهيَ فارِدَةٌ","عَلى أَزَلِّ فَقيدِ القوتِ عَسّالِ",22,"ل",1,0]]}