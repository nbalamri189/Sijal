انا",136,"ن",2,0],["وقد ضحك المشيب بفود رأسي","وشمس الشيب قد سترت سواده",137,"د",2,0],["وقد ضمن الشفيع لك المعالى","وفوزا مذ حللت بذا المزار",138,"ر",1,0],["وقد ضم من سامي المفاخر ما سما","عن الرسم تعريفا فأنى له حد",139,"د",1,0],["وَقَد ضَحِكَت زُنَيبَةُ مِن شُحوبي","وَشَيبٍ في المَفارِقِ قَد عَلاني",140,"ن",2,0],["وَقَد ضَلَّ كُلُّ الناسِ حَولَكَ وَاِنتَفوا","عَلى كُلِّ ما قَد كانَ مِنكَ لَوائِما",141,"م",2,0],["وَقَد ضمرت حَتّى كأَنَّ عُيونَها","نِطافُ فَلاةٍ ماؤُها مُتَصَبِّبُ",142,"ب",1,0],["وقد ضاءت الأمصار واعتزَّ رأسها","وأضحت كما الأطواد في معظم القدرِ",143,"ر",1,0],["وقد ضمَّها اللحدان فوق ضريحها","كما ضمَّ تُربُ الرمسِ تبرا الترائبِ",144,"ب",1,0],["وقد ضاءَ لبنانٌ لدى وَفد سيِّدٍ","فخيمٍ سما بالمجد فضل الأوائل",145,"ل",1,0],["وقد ضم أبحار العلوم بصدرهِ","ومن غيره الإبحار ما ضمها صدرُ",146,"ر",1,0],["وَقَد ضمنت خمسة كَالأَكُف","وَلَيسَ بِها مِن بِنان عَشر",147,"ر",1,0],["وقد ضحك الشيب في لمتى","فلم لا أبكي ربيع الشباب؟",148,"ب",1,0],["وقد ضرب الغمام لنا خياماً","سرادقها كست تلك البراري",149,"ر",2,0],["وقد ضاعت حقوق الله فيهم","فما منهم لداعيها مجيب",150,"ب",1,0],["وقد ضاق رحبُ الأرضِ بالخلقِ والتقتْ","جموعهُم مرجاً رجالٌ ونسوانُ",151,"ن",1,0],["وقد ضمهم شمل لديك مؤلف","فأرث لذي الشمل الشتيت المفرق",152,"ق",1,0],["وقد ضمن الله الجزاء لمحسن","وحسبك من واف وفى بضمان",153,"ن",1,0],["وقد ضاق صدري يوم جاءت وودعت","تقول لقد حان الرحيل تقول ُ",154,"ل",1,0],["وقد ضاع الحياء بها قديما","فأضحوْا كالجرادِ له دبيبُ",155,"ب",1,0],["وقد ضَاق وُسع الفَضا بعدكم","عليّ وقد ضاق بي الفَدفد",156,"د",1,0],["وقد ضحكت عيوني لهف قلبي","كأنّي في هواها قد شفيتُ",157,"ت",1,0],["وقَدْ ضَاقَ فِيهِ فضَاءُ الصّحَارِي","وأوجَاعُهُ قَدْ تُناهِزُ رَمْلَهْ",158,"ل",2,0],["وقد ضمنت إنجاح حاجاتنا معاً","علاك وما أحرى العلى بضمان",159,"ن",1,0],["وقد ضرب الليل من حولنا","سرادق بالسر لا تسمح",160,"ح",1,0],["وَقَدْ ضَرَّ الفِرَاقُ إذًا بِمَا قَدْ","جَرى وِفقَ الرِّفَاقِ لَنَا مَعِيَّا",161,"ي",2,0],["وَقد ضاقَ فِي عَيْنَيْهِ مَا أوْسَعَ الفَضَا","وَجارَتْ عليهِ مُردِياتُ الْمُصائِبِ",162,"ب",1,0],