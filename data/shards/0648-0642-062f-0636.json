=199111",""],[5145,"خليليّ إن لم تسعدا فدعاني","https://www.poetsgate.com/ViewPoem.aspx?id=108058",""],[5183,"من قصص الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=180277",""],[5206,"حجر الفلاسفة","https://www.poetsgate.com/ViewPoem.aspx?id=187417",""],[5338,"أخادع نفسي بالأماني الكواذب","https://www.poetsgate.com/ViewPoem.aspx?id=187713",""],[5397,"سالمت دهرا لا يريك التهانيا","https://www.poetsgate.com/ViewPoem.aspx?id=157960",""],[5431,"رياض العاشقين ...","https://www.poetsgate.com/ViewPoem.aspx?id=207521",""],[5582,"أَمُوسِعَةً بِمُهْجَتِيَ الصُّدُوعا","https://www.poetsgate.com/ViewPoem.aspx?id=187177",""],[5582,"قِفا بِمُقامٍ لِلأَحِبَّةِ ماصِحِ","https://www.poetsgate.com/ViewPoem.aspx?id=63481",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5842,"أيها الساسة \\ محمد حسام الدين دو","https://www.poetsgate.com/ViewPoem.aspx?id=152165",""],[5931,"أميرة فاتنة !","https://www.poetsgate.com/ViewPoem.aspx?id=175096",""],[6102,"لحظة وداع","https://www.poetsgate.com/ViewPoem.aspx?id=184862",""],[572,"تُرِيكَ مُرورُ الليالي العِبَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9276&r=&rc=133",""]],"verses":[["وَقَد ضَمَّني مَحضُ الصَفاءِ وَصِدقُه","إِلَيكَ كَما ضُمَّت ذِراعٌ إِلى عَضدِ",0,"د",1,0],["وَقَد ضِقنا بِهِم وَأَبيكَ ذَرعاً","وَضاقَ بِحَملِهِم ذَرعُ البَريدِ",1,"د",1,0],["وَقَد ضاعَ مِن أَنفاسِ نظمِكَ نَفحَةٌ","مِنَ المِسكِ فَاجعَلها فِداماً لِختمِهِ",2,"م",2,0],["وَقَد ضَمَّنا مِن عَينِ شُهدَةَ مَشهَدُ","بَدَأنا وَعُدنا فيهِ وَالعودُ أَحمَدُ",3,"د",1,0],["وقد ضربوا وعداً لتكريم شاعر","تملّك صِيتاً في الأقاليم طائرا",4,"ر",2,0],["وَقَد ضَرَبَ اِبنَ كَبشَةَ إِذ لَحِقنا","حُشَيشٌ حَيثُ تَفرُقُهُ الفَوالي",5,"ل",2,0],["وَقَد ضارَبَت فيهِ بَنو الأَوسِ كُلُّهُم","وَكانَ لَها ذِكرٌ هُناكَ رَفيعُ",6,"ع",1,0],["وقد ضمَّ جَفنِي بزير الكرى","فيعرب في الحال عن فتحه",7,"ح",2,0],["وقد ضاع نشر الربى فاغْتدت","تدور وتبكي على الضائع",8,"ع",1,0],["وقد ضم عَنْزَ الأهل والذئبَ مرتعٌ","وأصبح ظَبْيُ الرَّمْلِ صالحه الفهدُ",9,"د",1,0],["وقد ضربت في خضرة الروض صُفرةٌ","من الشمس فاخضر اخضراراً مشعشعا",10,"ع",2,0],["وقد ضامني فيه لئيمٌ وعزَّني","وها أنا منه مُعْصِمٌ بحبالكا",11,"ك",2,0],["وقد ضمَّهما الحِمَّا","مُ والمجنون صوّالُ",12,"ل",1,0],["وَقَد ضَمَرَت حَتّى كَأَنَّ عُيونَها","بَقايا قِلاتٍ أَو رَكِيٌّ مُمَكَّلُ",13,"ل",1,0],["وَقَد ضَلَّ قَومٌ بِأَصنامِهِم","فَأَمّا بِزِقِّ رِياحٍ فَلا",14,"ا",1,0],["وَقَد ضَمَّنا وَشكُ التَلاقِي وَلَفَّنا","عِناقٌ عَلى أَعناقِنا ثَمَّ ضَيِّقُ",15,"ق",1,0],["وَقَد ضاقَ ذَرعاً مُصطَلوها بِحَرِّها","وَعادَت جَحيماً نارَها تَتَسَعَّرُ",16,"ر",1,0],["وقد ضربْتُ بسيفٍ مُرهَفٍ فنَبا","وقد قدحْتُ بَزْندٍ مُضرَمٍ فَخَبا",17,"ب",2,0],["وقد ضرَّمتَ نارَ الحرب حتى","حَكَتْ زفراتُها قِطَعْ الجحيمِ",18,"م",1,0],["وَقَد ضَرّجتْ ثَوبي لدى عينِ ضارجٍ","عليّ جفونٌ ماؤها بالأَسى دَمُ",19,"م",1,0],["وَقَد ضاعَ مِنّي الخَصرُ مِن فَوقِ رَدفِهِ","وَلا عَجَبٌ أَنّي عَلَيهِ أَدورُ",20,"ر",1,0],["وَقَد ضَفَرَت فَرعاً كَريمَةُ مَعشَرٍ","فَما حَلَّ إِلّا الغاسِلاتُ لَهُ ضَفرا",21,"ر",2,0],["وَقَد ضَنَنتَ بِشاةٍ وَهيَ فارِدَةٌ","عَلى أَزَلِّ فَقيدِ القوتِ عَسّالِ",22,"ل",1,0],["وقَدْ ضَمَزَتْ بِجِرَّتِها سُلَيْمٌ","مَخَافَتَنَا كَمَا ضَمَزَ الحِمَارُ",23,"ر",1,0],["وَقَد ضمنا فيها مِن اللَيل سابِغاً","رِداءَ بِأَكناف السَحاب مسجف",24,"ف",1,0],["وقد ضاقت الدنيا بهم فأقلهم","عثاراً وذنباً واعف لازلت عافيا",25,"ي",2,0],["وقد ضمنا تكذيب من حذر الورى","عبادة غير الله كالشمس والبدر",26,"ر",1,0],["وقد ضمَّنا برد النَّدى ونسيمُه","يُجمِّشنا تَجْميشَ راضٍ مُسامِح",27,"ح",1,0],["وقد ضَمَّنا شوقٌ كما ضم ساهِرا","ثَوَى لكَرَى جَفْنيْه عند مَنام",28,"م",1,0],["وَقَد ضلَّ في القرآنِ مع عظم نورهِ","كَما خَبَطت عَشواءُ في الليلةِ القَمرا",29,"ر",2,0],["وَقَد ضَبطوا بالنقلِ والعقل شرعهُ","فَدامَ عَلى أوصافهِ ذهباً نضرا",30,"ر",2,0],["وقد ضمَّ لي الدهرُ الخؤونُ دسيسةً","تُحَطِّم أعضائي وَيَنْفلِقُ الصَّدْرُ",31,"ر",1,0],["وقد ضاقت الدنيا على برحبها","فلا ملجأٌ إلا إليكَ ومهرَبُ",32,"ب",1,0],["وَقَد ضاعَت عُلومٌ طالَ فيها","غُدوّي واستمَر لَها رَواحي",33,"ح",2,0],["وقد ضمّ منها كلَّ أبيضَ مَرهفٍ","وعانقَ فيها كلَّ أسمَرَ عسّال",34,"ل",1,0],["وقد ضَفَرنا لإدلال ذوائبَنا","لما حمينا المغاني من غوانينا",35,"ن",2,0],["وَقَدْ ضَمِنَ المِقْدَارُ نَصْرَ لِوَائِهِ","فَلَوْ شَاءَ لَمْ يَسْتَتْبِع الفَيْلقَ الجَأْوَى",36,"و",2,0],["وَقَد ضَبَثَت فيها مَخالِبُ ساغِبٍ","لَها في حَشاها وَالفُؤادِ صُدوعُ",37,"ع",1,0],["وَقَد ضَجَّ بَطنُ الأَرضِ مِن ثِقلِ وَطئِها","كَما أَنَّ أَعلاها بِهِ الجَوُّ قَد غَصّا",38,"ص",2,0],["وَقَد ضاءَ مُسودُّ الظَلام بشمعَةٍ","من الصُبح لم يعوز ذبالَتَها قطُّ",39,"ط",1,0],["وَقَد ضَمَّنا إذْ ذَاكَ ضِيقُ عِنَاقِنا","وَكَمْ ضَمَّ غُصْنٌ ذَابِلٌ غُصُناً نَضْرا",40,"ر",2,0],["وقد ضمَّهُ والصَّحبَ لمّا تَسايروا","من النَّقْعِ ليلٌ ذو هلال وأنجم",41,"م",1,0],["وقد ضَربَ الأصيلُ بها لصَحْبي","على الآفاقِ من ذهَبٍ رِواقا",42,"ق",2,0],["وَقَد ضامَني لا ضَمَّني فَسَأَلتُهُ","مَتى أَتَأَمَّلْ مِن مَسيرِكَ آيِبُ",43,"ب",1,0],["وَقَد ضَمِنَ اِغتِرامي عَنكَ صَبري","وَكَم مِن ضامِنٍ يُبلى بِكَسرَه",44,"ر",2,0],["وقد ضربت من فوقه وهو فوقهم","سرادقُ نورٍ وهي بالمجد تَرتَع",45,"ع",1,0],["وقد ضَمِنَتْ عَنكَ الأماني قضَاءهُ","فأنجِزْ مواعيدَ الأَماني وأنجِدِ",46,"د",1,0],["وقد ضربت في كل سوق عليهم","صوائح ذل صار ضربة لازب",47,"ب",1,0],["وقد ضرّجت وجنات الشَّقيق","وقبَّلَ بالقطر ثغر الأَقاح",48,"ح",1,0],["وقد ضحكَ الأَقاح الغضُّ منَّا","وأبصرَ من خلاعتنا عجابا",49,"ب",2,0],["وَقَدْ ضَرَّسَتْنِي حُرُوبُ الخُطُوبِ","وأَبْطَأْتِ يَا نُصْرَةَ الأَوْلِياءِ",50,"ا",2,0],["وَقَدْ ضُرِبَتْ قِداحُ الهندِ فِيهِمْ","لأَيسارِ الحياةِ أَوْ الحِمامِ",51,"م",1,0],["وَقَدْ ضربَ الأَسى فِيهَا علينا","رِواقاً يستضيءُ من الظَّلامِ",51,"م",1,0],["وقد ضَمَّهَا فِي نَفْنَفِ الجوِّ مَعْقِلٌ","عَسِيرٌ عَلَى عُصْمِ الوُعُولِ مَرَاقِبُهْ",52,"ب",2,0],["وقد ضربت خدراً عَلَى الشمس وانجلت","بِهَا عن شموس الغانيات خدورُها",53,"ر",3,0],["وقد ضاقت بي الدنيا","وذو الآصار مردود",54,"د",1,0],["وقد ضحكت آمالنا ويجناننا","ولم تك أولانا اعتباراً لأخرانا",55,"ن",2,0],["وقد ضحكت ويك آمالنا","بآمالنا ضحك مغزٍ غزي",56,"ي",1,0],["وقد ضمنوا لأهل الأر","ض عدلا سابغ النعم",57,"م",1,0],["وقد ضاق ذرعا من سلبت نعاسهم","فليلك نور مثل علمك لا يمحى",58,"ح",2,0],["وقد ضمدت لا تغيبي","عني فما لي نهار",59,"ر",1,0],["وقد ضامها قبلُ الولاةُ وقصَّرتْ","قبائلُها عن نصرِها وشُعوبُها",60,"ب",3,0],["وقد ضقتُ ذرعًا بالفراقِ وصُنْعِه","حنانيكَ كم تبكي وكم تتوجَّعُ",61,"ع",1,0],["وقد ضعضعت أركانه حتى دك بما","بدا من نعوت البارقات المراديه",62,"ي",2,0],["وقد ضاقت بنا أعطا","ن دهر ليس ينشرح",63,"ح",1,0],["وقد ضرعت إلى من","أقام سبع طباق",64,"ق",1,0],["وقد ضَاقَت بِىَ الدنيا مَجَالا","وأضحَى العِبءُ عني لا يُزَاحُ",65,"ح",1,0],["وقد ضمّنا موقفٌ للوداع","خلا للمحبّين من زاحِمِ",66,"م",1,0],["وقد ضلَّ فيه الكاشحون وقُطّعتْ","عوائقُ كانت قبل ذاك تعوقُ",67,"ق",1,0],["وقد ضاع بعدك من ذدت عنه","طويلاً وكنتَ له حارسا",68,"س",2,0],["وقد ضاق بي مُذ نأيتَ العراقُ","كما ضاق عِقْدٌ على شابرِ",69,"ر",1,0],["وقد ضِفنا وكيلاً للشْ","شَريف الحاكم الأحكمْ",70,"م",1,0],["وقدَ ضاقَ صدرُ الششتريِّ بكتمهِ","مع الصحوِ بعدَ المحو والوسع في الصدر",71,"ر",1,0],["وَقَد ضَمُرَت حَتَّى التَقى مِن نُسوعِها","عُرى ذِي ثَلاثٍ لَم تَكُن قَبلُ تَلتَقي",72,"ق",2,0],["وقد ضُرِبَتْ فِيْهِ خَيْمَاتُهَا","وعدّل تَشْرِيْنُ حرًّا بِقُرْ",73,"ر",1,0],["وقد ضمَّكما أَصْلٌ","كريمٌ شَابِكٌ شَائِك",74,"ك",1,0],["وقد ضَلَّ من مَسَّ الشُّعاعَ بكَفِّه","إِذا ظَنَّ أَنَّ الكَفَّ لِلشَّمْس تَلْمِسُ",75,"س",1,0],["وَقَد ضَمّوا إِلى ما أَورَثوهُ","تُمَيِّزُهُم بِأَخلاقِ حَسّانِ",76,"ن",1,0],["وقد ضعفت مما تئن وقد عدت","من السقم والشكوى تعد ضلوعها",77,"ه",2,0],["وقد ضمَّنا في نَداهُ جِنانٌ","بهِ احتفَلَ الحُسْنُ حتَّى كملْ",78,"ل",1,0],["وقد ضم تلك الدوارع مرفا","به فمن صفا يتابع صفا",79,"ف",2,1],["وقد ضاق الفضاء به وأعمى","نواظرَهُ دخانُ المرعدات",80,"ت",1,0],["وَقَد ضَمّتا لِلأّرضِ أَنّ مريدَها","يبينُ نَهاراً ثمَّ لَيلاً بِلا إِخفا",81,"ف",2,0],["وَقَد ضَمّتا بَدرَ السّماءِ إِلى السّما","وَأَنجمَها اللّاتي لَقَد حَسُنَت رَصفا",81,"ف",2,0],["وَقَد ضَرَّني جَهلي بِرِفعَةِ قدْرِهِ","وَجَهلُ الفتى لا شكَّ مِن أَكبَر الضُّرِّ",82,"ر",1,0],["وقد ضُربتْ أعناقُهم بمناصلٍ","كما خربتْ دورٌ لهم وديار",83,"ر",1,0],["وقد ضمنت رضاك عنه","فلا أرَد ع