{"poems":[[57,"إني طربت إلى شمس إذا طلعت","https://www.aldiwan.net/poem26368.html","البسيط"],[75,"ودع الصبر محب ودعك","https://www.aldiwan.net/poem11912.html","الرمل"],[90,"كل ما في البلاد من أموال","https://www.aldiwan.net/poem44984.html","الخفيف"],[53,"دابر أوطاره إلى الذكر","https://www.aldiwan.net/poem62983.html","الطويل"],[91,"المجمعون على التوحيد ما عبدوا","https://www.aldiwan.net/poem45098.html","البسيط"],[68,"لمن الشوازب كالنعام الجفل","https://www.aldiwan.net/poem41583.html","الكامل"],[82,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[71,"إن يطش بعض كلامي","https://www.aldiwan.net/poem28849.html","مجزوء الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39568","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[108,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[92,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[53,"دابر أوطاره إلى الذِّكَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=29169",""],[141,"ولقد قضيت وإن تجلل لمتي","https://www.aldiwan.net/poem68028.html","الكامل"],[159,"إني طلبت إلى القرطاس يحمل لي","https://www.aldiwan.net/poem55590.html","البسيط"],[236,"حيتك السنة الحيا من دار","https://www.aldiwan.net/poem44590.html","الكامل"],[240,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[303,"ذر النفس لا يود الأسى بذمائها","https://www.aldiwan.net/poem36289.html","عموديه"],[366,"يا لحبر مضى وأخلى الديارا","https://www.aldiwan.net/poem68103.html","الخفيف"],[369,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[396,"متى متى ياسا كنين سمعون","https://www.aldiwan.net/poem54484.html","عموديه"],[445,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[457,"أجل حديث لا يمل دوامه","https://www.aldiwan.net/poem13898.html","الطويل"],[473,"من حق من كان منا","https://www.aldiwan.net/poem60503.html","المجتث"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[581,"يا آل بكر ألا لله أمكم","https://www.aldiwan.net/poem1798.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83258","الكامل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130199","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48673","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38918","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38026","الخفيف"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129520","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56572","الكامل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102285","المنسرح"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80038","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66265","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27553","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105040","الكامل"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123649","الرمل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65988","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93905","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100317","الكامل"],[3500,"","https://poetry.dctabudhabi.ae/diwan/poem/34905","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62940","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86341","المجتث"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91710","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91716","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205951","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117922","الخفيف"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34679","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75680","البسيط"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105533","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83125","السريع"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66106","البسيط"],[4690,"قطاف","https://www.poetsgate.com/ViewPoem.aspx?id=175471",""],[4755,"مِن بَسمَةٍ _يا حُبُّ_ هذا الدَّمْ","https://www.poetsgate.com/ViewPoem.aspx?id=184809",""],[4755,"الكَفُّ، والجَوَّالُ، والمَبسَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=191248",""],[1663,"ان سيوفاً جلت وجوه بني","https://www.poetsgate.com/ViewPoem.aspx?id=93228",""],[5106,"مِنْ ضَوْءِ أَلْفِ صَبَاْحٍ قَدْ سَرَىْ","https://www.poetsgate.com/ViewPoem.aspx?id=150036",""],[5147,"سر الهوى العذري مودع","https://www.poetsgate.com/ViewPoem.aspx?id=166721",""],[5160,"سَقْفُ البَاصِ","https://www.poetsgate.com/ViewPoem.aspx?id=206161",""],[5273,"الهروب من الصقيع","https://www.poetsgate.com/ViewPoem.aspx?id=144498",""],[5327,"وَصَماتُ الغَدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=144598",""],[5431,"موسيقا ...","https://www.poetsgate.com/ViewPoem.aspx?id=214414",""],[5447,"مطر وموسيقى","https://www.poetsgate.com/ViewPoem.aspx?id=210814",""],[5642,"جهرة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=125040",""],[5781,"نَصْرٌ ووعد","https://www.poetsgate.com/ViewPoem.aspx?id=190950",""],[5809,"ذمم","https://www.poetsgate.com/ViewPoem.aspx?id=205330",""],[5880,"بغداد ودمشق","https://www.poetsgate.com/ViewPoem.aspx?id=208577",""],[5956,"إنْ تَحْنِ ظهرك","https://www.poetsgate.com/ViewPoem.aspx?id=184366",""],[4442,"بالأعالي فتنت لا بالأسافل","https://www.poetsgate.com/ViewPoem.aspx?id=171204",""],[6082,"صديقي والعزوبية","https://www.poetsgate.com/ViewPoem.aspx?id=59117",""],[5014,"حديث الشمس للقمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76223&r=&rc=19",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""],[2220,"إن سيرتْ صمّ الجبالِ سراباً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11189&r=&rc=63",""]],"verses":[["إِنّي طَرِبتُ إِلى شَمسٍ إِذا طَلَعَت","كانَت مَشارِقُها جَوفَ المَقاصيرِ",0,"ر",1,1],["إِن يَطُل بَعدَكَ لَيلي فَلَكَم","بِتُّ أَشكو قِصَرَ اللَيلِ مَعَك",1,"ك",1,0],["أن يطِب في حياتنا الأجتما","عيّة عيش فالفضل للعمّال",2,"ل",1,0],["إن يطوِ لذّاتها المشيبُ فقد","جنيتُ منها مَطايب الثمر",3,"ر",1,0],["إن يطلبوا ويح قومي من عبادتها","ربحاً فقد كان هذا الربح خسرانا",4,"ن",2,0],["إِن يَطلُبوا قَتلي فَلَستُ أَلومُهُم","دَمُ شَيخِهِم في صارِمي لَم يَنصُلِ",5,"ل",1,0],["إِنّي طُرِفْتُ بِأَعينٍ في طَرفِها","سِحْرٌ يَحُلُّ مِنَ العقولِ عِقالا",6,"ل",2,0],["إنْ يطشْ بعضُ كلامي","إنَّ فضلي لا يطيشُ",7,"ش",1,1],["إني طويتُ العيش بعدك ضارباً","في الأرض منفرداً بغير أليفِ",8,"ف",1,0],["أَنَّى طَرَقتَ ذَوي شَجنٍ تَعُودُهُمُ","وكنتُ عَهدي قَطُوفَ الَمشيِ مِحيارا",9,"ر",2,1],["إِنّي طَرَحْتُ مِنَ الشباب رِدَاءَهُ","وثَنَيْتُ عَنْ لَهْوِ الصَّبَابَةِ جِيدِي",10,"د",2,0],["إن يَطْعَموا، وَجَدُوا الطعام مسمَّمًا","أو يشربوا، وجدوا الشراب مُكَدَّرا",11,"ر",2,0],["إن يُطَعْ كان مشفقاً ، واذا ما","أحوجوا كان فاتكا جزارا",12,"ر",2,0],["إن يطوِ لذّاتها المشيبُ فقد","فضضتُ منها خواتم العُذَر",13,"ر",1,0],["إِن يَطلُبوا بِتَراتِهِم يُعطَوا بِها","أَو يُطلَبوا لا يُدرَكوا بِتَراتِ",14,"ت",1,0],["إِنِّي طَلَبْتُ إِلى القِرْطاسِ يَحْمِلُ لي","بَعْضَ الَّذي بي إِلَيْكُمْ زَادَني قَلَقا",15,"ق",2,1],["إني طوت شعب الفلا وديارها","بحمى الحجاز وبالعراق دياري",16,"ر",2,0],["إِن يُطاعِنَّ فَالرِماحُ قُدودٌ","أَو يُناضِلنَ فَالسِهامُ عُيونُ",17,"ن",1,0],["أُنيطتْ به الويلاتُ حتى أَقمننا","عَلَى الخسفِ أَياماً دَجَتْ وَلياليا",18,"ي",2,0],["اِن يطل نوحنا فَما فيهِ لوم","كَيفَ نبدى عَلى المَنوح اِعتِذارا",19,"ر",2,0],["إن يَطْرُقِ الطّيفُ عَيني وهْي باكيةٌ","فالبَدْرُ في الغيم يَسْري وهْو ذو مَطر",20,"ر",1,0],["إني طلبت الله ما طلبتك","يالائمي كلا ولا قصدتك",21,"ك",1,0],["إِن يَطرُقِ الأَوطانَ فهو أَسِيرُها","أَوْ يُشعِرِ الأَعْدَاءَ فهو طريدُها",22,"د",3,0],["أُنيطتْ به بعد الكتابِ وأحكمت","معاقدُ دين الحق دامَ انتظامه",23,"م",2,0],["إِن يُطلَبَ الرِزقَ مِنهُ","بِسَعيِهِ وَاِقتِضائِه",24,"ا",3,0],["أن يطلب الحقوق في التظالم","أهل الخصوم عند غير الحاكم",25,"م",1,0],["أَنَّى طَرِبتِ وَلَم تُلحَي عَلى طَرَبٍ","وَدونَ إِلفِكِ أَمراتٌ أَماليسُ",26,"س",1,0],["إِنّي طَوَيتُ عَنِ النَسيمِ شَغافَةً","أَن جاءَني مِن غَيرِ تِلكَ الأَربَعِ",27,"ع",1,0],["إن يطو برد الثنا أثيابها نسج ال","ربيع جلبابها واستخدم السحبا",28,"ب",2,0],["إن يطو ركبك بيدها متمهلاً","فالمحل يؤثر أن يقيم غمامه",29,"م",2,0],["إِنّي طَبعتُ عَلى الصّبابَةِ وَالهَوى","مِنهُ وَجدت فَغَيرهُ لا أعرفُ",30,"ف",1,0],["إِنْ يُطِرْهُ فَلَيسَ ذا بِعَجيبٍ","فَالنَّدى طارَ مِن شُعاعِ الشّموسِ",31,"س",1,0],["أنيط به حتى لو اختار نزعه","لحن إليه وهو ثكلان نادب",32,"ب",1,0],["إن يطالمو لا فكم أصابك ظلمهم","إن كنت تجحده فما أنا أجحد",33,"د",1,0],["إن يطل الفكر في توردها","فذاك اللَه موضع النظر",34,"ر",1,0],["إنْ يطوِ مصباحَ المكارم ضارح","فلقد أضاءت في علاهُ مصابحُ",35,"ح",1,1],["أنيط على الحظ وشي النظام","وأنت لذاك النظام منيطُ",36,"ط",1,1],["إني طمعت من الشهودِ مطاعما","وشربتُ ماءَ المعصراتِ شرابا",37,"ب",2,0],["إن يطغ فرعون الهموم ببغيه","أرخ بلوغ مناك مولد موسى",38,"س",2,0],["أن يطل هذا المدى يقصر في","أمد العمر واقفو من درج",39,"ج",1,0],["أن يطفؤا ما للهدى من علم","ويهدموا الحق بكل مهدم",40,"م",1,0],["إني طبعت على طوع السكون وإن","شئت التحرك يعصي الطبع ناقله",41,"ل",2,0],["ان يطَّببك الشعر فهي طبيعة","جسَّت انامللإها يدي جساس",42,"س",1,0],["إِن يَطلُبوا بِجَريرَةٍ يَنأَونَها","أَو يُطلَبوا لا يُدرَكوا بِتِراتِ",43,"ت",1,0],["انْ يطمئنَّ الى الحَشَايا قلبُه","وعناقِ جنبِ الطفلةِ المِعْطَارِ",44,"ر",1,0],["إِن يَطلبِ الروحَ ظَبيٌ","وَجادَ بِالوَصلِ فَاِرضا",45,"ض",2,0],["إِن يَطُل بُعدُنا فكم من ليالٍ","طالَ صَفوي بِها وَطافَت كؤوسي",46,"س",2,1],["إِن يَطُل بُعدٌ فكم من وصلةٍ","واقترابٍ بعد يَأسٍ قاطع",47,"ع",1,0],["إن يطل شرح المعاني فاختصر","كل ما فرقت في معنى جميع",48,"ع",1,0],["إن يطوفوا نطف ونستلم ال","ركن ونرمي كما رموها الجمارا",49,"ر",2,0],["اني طربتُ لرهبانٍ مجاوبةٍ","بالقدس بعد هدو الليلِ رهبانا",50,"ن",2,0],["إِن يُطق أَو كانَ مِمّا يُستَجاب","قالَت الرَبَّةُ وَالحيلَةَ قَد",51,"د",1,0],["اني طمحت بآمالي إِلى ملك","إِذا ذكرت اسمه في ممحل خصبا",52,"ب",2,0],["إن يطر جاوز الأثير رقيا","وعلى النهر للمجرة حوم",53,"م",1,0],["إِن يطلبِ الرِفدَ بِها مُتقِنٌ","فرفته أَقرَبُ مِن رِفدِهِ",54,"د",2,0],["إِنْ يَطْوِها خُلْفُكُمْ تَنْشُرْ صَحائِفَها","بِيضُ الصَّفااحِ تَكْشِفْ عن مُخَباها",55,"ا",3,0],["إنّي طَمِعْتُ بفِعْلتي في سُمْعَةٍ","وأصيرَ بينَ العاشقينَ الجِهْبذا",56,"ذ",2,0],["إنِّي طَعِمْتُ الضَّوءَ مِن طَرْفِهَا","مَن قالَ إنَّ الضَّوءَ لا يُطْعَمْ؟!",57,"م",1,0],["إِنِّي طَعِمْتُ الضَّوءَ مِن ثَغرِها","مَن قالَ إِنَّ الضَّوءَ لا يُطعَمُ!",58,"م",1,0],["إن يطلبها لفي عواتقنا","مرتقبات لمن يراقبها",59,"ب",3,0],["إنْ يَطْرَحِ الكَفَّ تَهْمِيْهَاْ جُمَاْنَتُهُ","مُهَذَّبُ القَلْبِ لاْ يَنْسَىْ مُرَاْعِيْهِ",60,"ي",2,0],["إني طويت على الهوى","لما شممت هواك أضلع",61,"ع",1,0],["إنْ يطلق الرّشاشُ ألفَ رصَاصَةٍ","فالنَّسْفُ في سَاح الجهَادِ ترنُّمِي",62,"م",2,0],["إنّي طَرَدْتُكِ مِنْ شِعري ومِنْ أدَبي","كَما طَرَدْتُكِ مِنْ قَلبي ومِنْ هُدُبي",63,"ب",2,1],["أن يَطَأَ الشَّعبَ عِصابَتُهُ","أن يُطعَمَ هذا الشَّعبُ فُتاتْ",64,"ت",1,0],["أنْ يطرقوا الباب ذا يعني توجسّهم","ولذة الحبّ ماءٌ عقَّ تسويقا !!",65,"ق",2,0],["إني طفقتُ أعبُّ دِنَّ مَشاهدٍ","فسكرتُ إبصارًا وخانتني القوى",66,"و",2,0],["إن يُطِل صبرًا فإني موقنٌ","أنَّهُ حَتْمٌ وإِن لَم يُسْرعِ",67,"ع",1,0],["إنِّي طُوِيتُ على الأحْزانِ في وَطَنٍ","بَعْضي شَرَوْهُ ودَقُّوا البَعْضَ بِالحَجَرِ",68,"ر",1,0],["إنْ يُطفِئِ الماءُ مافي النارِ من لهبٍ","فليسَ يُطفئُ مَن في شوقِهِ احترَقا",69,"ق",2,0],["إن يطل عمر ذي الحروب، فصبراً","ليس بعد الحروب إلا السلامُ",70,"م",1,0],["إني طبيبُكَ مرة لا تعْصِني","كيلا تُجَرّعَني ضناك زُعافا",71,"ف",2,0],["أن يطب محتدا فلابن علي","نفحات تنم عنها الخمائل",72,"ل",1,0],["انّي طليق بلا قيد ولا عتب","في حضن نجم وديوان وأغنيّةْ",73,"ي",2,0],["إني طردتك من مدا","راتي فعش بعدي كسيرا",74,"ر",2,0],["إن يطحنوا جسدي على خد الرحى","طلبا لموتى لن تموت الروحُ",75,"ح",1,0],["إني طعمت من الشهودِ مطاعما","وشربتُ ماءَ المعصراتِ شرابا",76,"ب",2,0]]}