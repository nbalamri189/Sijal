{"poems":[[55,"إني طربت إلى شمس إذا طلعت","https://www.aldiwan.net/poem26368.html","البسيط"],[73,"ودع الصبر محب ودعك","https://www.aldiwan.net/poem11912.html","الرمل"],[88,"كل ما في البلاد من أموال","https://www.aldiwan.net/poem44984.html","الخفيف"],[51,"دابر أوطاره إلى الذكر","https://www.aldiwan.net/poem62983.html","الطويل"],[89,"المجمعون على التوحيد ما عبدوا","https://www.aldiwan.net/poem45098.html","البسيط"],[66,"لمن الشوازب كالنعام الجفل","https://www.aldiwan.net/poem41583.html","الكامل"],[80,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[69,"إن يطش بعض كلامي","https://www.aldiwan.net/poem28849.html","مجزوء الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39568","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[90,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[51,"دابر أوطاره إلى الذِّكَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=29169",""],[138,"ولقد قضيت وإن تجلل لمتي","https://www.aldiwan.net/poem68028.html","الكامل"],[156,"إني طلبت إلى القرطاس يحمل لي","https://www.aldiwan.net/poem55590.html","البسيط"],[232,"حيتك السنة الحيا من دار","https://www.aldiwan.net/poem44590.html","الكامل"],[236,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[299,"ذر النفس لا يود الأسى بذمائها","https://www.aldiwan.net/poem36289.html","عموديه"],[362,"يا لحبر مضى وأخلى الديارا","https://www.aldiwan.net/poem68103.html","الخفيف"],[365,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[392,"متى متى ياسا كنين سمعون","https://www.aldiwan.net/poem54484.html","عموديه"],[440,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[453,"أجل حديث لا يمل دوامه","https://www.aldiwan.net/poem13898.html","الطويل"],[469,"من حق من كان منا","https://www.aldiwan.net/poem60503.html","المجتث"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[577,"يا آل بكر ألا لله أمكم","https://www.aldiwan.net/poem1798.html","البسيط"]],"verses":[["إِنّي طَرِبتُ إِلى شَمسٍ إِذا طَلَعَت","كانَت مَشارِقُها جَوفَ المَقاصيرِ",0,"ر",1,1],["إِن يَطُل بَعدَكَ لَيلي فَلَكَم","بِتُّ أَشكو قِصَرَ اللَيلِ مَعَك",1,"ك",1,0],["أن يطِب في حياتنا الأجتما","عيّة عيش فالفضل للعمّال",2,"ل",1,0],["إن يطوِ لذّاتها المشيبُ فقد","جنيتُ منها مَطايب الثمر",3,"ر",1,0],["إن يطلبوا ويح قومي من عبادتها","ربحاً فقد كان هذا الربح خسرانا",4,"ن",2,0],["إِن يَطلُبوا قَتلي فَلَستُ أَلومُهُم","دَمُ شَيخِهِم في صارِمي لَم يَنصُلِ",5,"ل",1,0],["إِنّي طُرِفْتُ بِأَعينٍ في طَرفِها","سِحْرٌ يَحُلُّ مِنَ العقولِ عِقالا",6,"ل",2,0],["إنْ يطشْ بعضُ كلامي","إنَّ فضلي لا يطيشُ",7,"ش",1,1],["إني طويتُ العيش بعدك ضارباً","في الأرض منفرداً بغير أليفِ",8,"ف",1,0],["أَنَّى طَرَقتَ ذَوي شَجنٍ تَعُودُهُمُ","وكنتُ عَهدي قَطُوفَ الَمشيِ مِحيارا",9,"ر",2,1],["إِنّي طَرَحْتُ مِنَ الشباب رِدَاءَهُ","وثَنَيْتُ عَنْ لَهْوِ الصَّبَابَةِ جِيدِي",10,"د",2,0],["إن يَطْعَموا، وَجَدُوا الطعام مسمَّمًا","أو يشربوا، وجدوا الشراب مُكَدَّرا",11,"ر",2,0],["إن يُطَعْ كان مشفقاً ، واذا ما","أحوجوا كان فاتكا جزارا",12,"ر",2,0],["إن يطوِ لذّاتها المشيبُ فقد","فضضتُ منها خواتم العُذَر",13,"ر",1,0],["إِن يَطلُبوا بِتَراتِهِم يُعطَوا بِها","أَو يُطلَبوا لا يُدرَكوا بِتَراتِ",14,"ت",1,0],["إِنِّي طَلَبْتُ إِلى القِرْطاسِ يَحْمِلُ لي","بَعْضَ الَّذي بي إِلَيْكُمْ زَادَني قَلَقا",15,"ق",2,1],["إني طوت شعب الفلا وديارها","بحمى الحجاز وبالعراق دياري",16,"ر",2,0],["إِن يُطاعِنَّ فَالرِماحُ قُدودٌ","أَو يُناضِلنَ فَالسِهامُ عُيونُ",17,"ن",1,0],["أُنيطتْ به الويلاتُ حتى أَقمننا","عَلَى الخسفِ أَياماً دَجَتْ وَلياليا",18,"ي",2,0],["اِن يطل نوحنا فَما فيهِ لوم","كَيفَ نبدى عَلى المَنوح اِعتِذارا",19,"ر",2,0],["إن يَطْرُقِ الطّيفُ عَيني وهْي باكيةٌ","فالبَدْرُ في الغيم يَسْري وهْو ذو مَطر",20,"ر",1,0],["إني طلبت الله ما طلبتك","يالائمي كلا ولا قصدتك",21,"ك",1,0],["إِن يَطرُقِ الأَوطانَ فهو أَسِيرُها","أَوْ يُشعِرِ الأَعْدَاءَ فهو طريدُها",22,"د",3,0],["أُنيطتْ به بعد الكتابِ وأحكمت","معاقدُ دين الحق دامَ انتظامه",23,"م",2,0],["إِن يُطلَبَ الرِزقَ مِنهُ","بِسَعيِهِ وَاِقتِضائِه",24,"ا",3,0],["أن يطلب الحقوق في التظالم","أهل الخصوم عند غير الحاكم",25,"م",1,0],["أَنَّى طَرِبتِ وَلَم تُلحَي عَلى طَرَبٍ","وَدونَ إِلفِكِ أَمراتٌ أَماليسُ",26,"س",1,0]]}