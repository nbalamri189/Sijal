{"poems":[[55,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[95,"يا ابن لبنان عد إلى لبنان","https://www.aldiwan.net/poem11175.html","الخفيف"],[95,"طفت والصبح طالباً في الجنان","https://www.aldiwan.net/poem11230.html","الخفيف"],[53,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[47,"ظلم الدهر فيكم وأساء","https://www.aldiwan.net/poem10207.html","الخفيف"],[50,"قل لمن ساد ثم ساد أبوه","https://www.aldiwan.net/poem62605.html","الخفيف"],[48,"أدنى الفوارس من يغير لمغنم","https://www.aldiwan.net/poem23639.html","الكامل"],[47,"ظَلَمَ الدّهْرُ فيكُمُ، وَأسَاءَ","https://www.poetsgate.com/ViewPoem.aspx?id=32879",""],[136,"لمعان البروق هاج الهموما","https://www.aldiwan.net/poem54745.html","الخفيف"],[147,"يطمع الناس في البقاء وتابى","https://www.aldiwan.net/poem11735.html","الخفيف"],[510,"نحن لا نكذب ولكن نتجمّل","https://www.aldiwan.net/poem27793.html","الخفيف"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49592","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110314","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93932","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40121","الرمل"],[5121,"طير الحقول","https://www.poetsgate.com/ViewPoem.aspx?id=37478",""],[5183,"وقِّر العلم","https://www.poetsgate.com/ViewPoem.aspx?id=186456",""],[5974,"فيالق النور","https://www.poetsgate.com/ViewPoem.aspx?id=200260",""],[5974,"هَنْدَسَةُ الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=200330",""],[6106,"سيدنا الإمام الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=6315",""]],"verses":[["وَاِستَزَدنا ريحَ الزَفيرِ هبوباً","وَسَحابَ الدُموعِ وَبلاً وَقَطرا",0,"ر",2,0],["وَاسْتَزِدْهُمْ مَا تُسْتَزَادُ قُوَاهُمْ","مِنْ تَبَارٍ فِي حُبِّهَا وَتَفَانِ",1,"ن",1,0],["وَاسْتَزَادَ الْحِلَى سِوَاهَا فَجَاءَتْ","حَيْثُ زَادَتْ عَلائِمُ النُّقْصَانِ",2,"ن",1,0],["واستزادتْ قلوبَهم من هواها","بِرُقاها وما لَدَيْهِمْ مَزيدُ",3,"د",1,0],["وَاِستَزَلَّ الشَيطانُ آدَمَ في الجَن","نَةِ لَمّا أَغرى بِهِ حَوّاءَ",4,"ا",2,0],["وَاِستَزِدني إِلى مَكارِمِكَ الغُر","رِ وَمَجدٍ إِلَيكَ خَيَّمَ مَجدُه",5,"د",2,0],["واسْتَزْرِ بالبِيضِ الحِسانِ ولا يكُنْ","لكَ غيرُ هِمّةِ صارمٍ أو لَهْذَمِ",6,"م",1,0],["وَاستَزَلّ الشّيْطانُ آدَمَ في الجنّةِ","لَمّا أغْرَى بِهِ حَوّاءَ",7,"ا",2,0],["واستَزيَدَت فَلَم تَزِد وتَشَكَّت","وَبرَت جَذبَةُ الخَشَاشِ الكُومَا",8,"م",2,0],["وَاِستَزادَت أَبا سَلامَةَ لَمّا","تَمَّ مُلكاً وَقُدرَةً وَشَبابا",9,"ب",2,0],["واستزدنا من عِطرها وارتشَفنا","ريقها منْ كؤوسِ خمرٍ تفورُ",10,"ر",1,0],["واستزيدي منَ الذُّنُوب فإن ال","أَمْرَ فيها إلى غفورٍ رحيم",11,"م",1,0],["واستزد من سلاح برك فالحر","ب عوان والبطل حث الركابا",12,"ب",2,0],["واستزدهم أكلاً وقل إن هذا","طاب نضجاً وصار غضاً طريا",13,"ي",2,0],["وَاِستَزادت بِقَسيمِ الدَّولة ال","قسمُ مِن إدحاضِ كيدِ المارِقينْ",14,"ن",1,0],["وَاسْتَزَادَ الْجَوُّ سِحْراً فِي غِنَاءٍ","رَنَّمَ الأَلْحَانَ كالْنَّاي الصهيلِ",15,"ل",1,0],["واستزه فهو للساري هدى","واركب البرق إليه والإبا",16,"ب",2,0],["وَاسْتَزْرَعَ الْخَيرَ فِي الْكَفَّينِ فَامْبَجَسَتْ","مِنْهُ الْعُيُونُ وَفَاضَ الْمَاءُ يَرْوِي ظَمَا",17,"م",2,0],["واستزرع الإحسان في القلب الذي","يهوى الجميع مسالما مترنما",18,"م",2,0],["وأستزيد به من عزكم شرفا","وأستدر به فيضا من النعم",19,"م",1,0]]}