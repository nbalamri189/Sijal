{"poems":[[53,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[53,"يا صاحب الجدث الذي نفثت به","https://www.aldiwan.net/poem29660.html","الكامل"],[53,"قف موقف الشك لا يأس ولا طمع","https://www.aldiwan.net/poem30134.html","البسيط"],[53,"منابت العشب لا حام ولا راع","https://www.aldiwan.net/poem30149.html","البسيط"],[53,"لمن الديار طلولها وقص","https://www.aldiwan.net/poem30177.html","الكامل"],[53,"رأيت المنى نهزة الثائر","https://www.aldiwan.net/poem30474.html","المتقارب"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[53,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[63,"وظباء من بني أسد","https://www.aldiwan.net/poem45804.html","المديد"],[93,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[93,"انزل المنزل الحسن","https://www.aldiwan.net/poem11260.html","مجزوء الخفيف"],[54,"إن زرته ألفيته متبذلا","https://www.aldiwan.net/poem27530.html","الكامل"],[88,"أ يوسف ما إن أنت من فحل هجمة","https://www.aldiwan.net/poem44392.html","الطويل"],[27,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[47,"وشادن من بني كسرى شغفت به","https://www.aldiwan.net/poem25251.html","البسيط"],[47,"إن زرت خرشنة أسيرا","https://www.aldiwan.net/poem25260.html","مجزوء الكامل"],[23,"عين جودي بدمعك المنزور","https://www.aldiwan.net/poem21412.html","الخفيف"],[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[51,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[89,"طلعت من الافق الجديد عطارد","https://www.aldiwan.net/poem44628.html","الكامل"],[85,"نزل المناهل والربى آذار","https://www.aldiwan.net/poem7051.html","الكامل"],[85,"احفظ لنا يا ربنا","https://www.aldiwan.net/poem7264.html","مجزوء الرجز"],[85,"راية الموت فوق هام العباد","https://www.aldiwan.net/poem7752.html","الخفيف"],[85,"يا قلب ويحك والمودة ذمة","https://www.aldiwan.net/poem8110.html","الكامل"],[85,"سر أبا صالح إلى الله واترك","https://www.aldiwan.net/poem62903.html","الخفيف"],[85,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[85,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[62,"الأرض أم برة","https://www.aldiwan.net/poem52234.html","مجزوء الكامل"],[45,"شط من ساكن الغوير مزاره","https://www.aldiwan.net/poem63580.html","الخفيف"],[45,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[45,"لئن ثنى الدهر من سهمي فلم يصل","https://www.aldiwan.net/poem65622.html","الخفيف"],[45,"أنزاعا في الحب بعد نزوع","https://www.aldiwan.net/poem64684.html","الخفيف"],[99,"إلى رجل","https://www.aldiwan.net/poem6618.html","عموديه"],[61,"غضبان ينساني وأذكره","https://www.aldiwan.net/poem51669.html","أحذ الكامل"],[49,"يا صاحبي رحلي لا تكثرا","https://www.aldiwan.net/poem64297.html","السريع"],[66,"أنظر إلى المجد كيف ينهدم","https://www.aldiwan.net/poem40298.html","المنسرح"],[97,"حان حرماني وناداني النذير","https://www.aldiwan.net/poem24787.html","الرمل"],[44,"ريب دهر أصم دون العتاب","https://www.aldiwan.net/poem30322.html","الخفيف"],[44,"جرت له أسماء حبل الشموس","https://www.aldiwan.net/poem30479.html","السريع"],[69,"خلعت ثوب القضاء طوعا","https://www.aldiwan.net/poem28526.html","مخلع البسيط"],[69,"إذا ما هجاني ناقص لا أجيبه","https://www.aldiwan.net/poem29062.html","الطويل"],[69,"إن زيدا في قيادته","https://www.aldiwan.net/poem29099.html","المديد"],[105,"انبعث في الأرض يا وحي السماء","https://www.aldiwan.net/poem41932.html","الرمل"],[105,"بني الملوح لا حام ولا واق","https://www.aldiwan.net/poem43577.html","البسيط"],[105,"يا بني الحارث بن كعب سلام","https://www.aldiwan.net/poem44004.html","الخفيف"],[105,"وفد نجران إن أردت الرشادا","https://www.aldiwan.net/poem44017.html","الوافر"],[105,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[40,"من لنفس عن الهوى لا تناهى","https://www.aldiwan.net/poem42329.html","الخفيف"],[52,"أنزلت من ليل كظل حصاة","https://www.aldiwan.net/poem27192.html","الكامل"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[48,"أنزف دمعي طول تسكابه","https://www.aldiwan.net/poem10782.html","السريع"],[48,"عيني ألومك لا ألوم","https://www.aldiwan.net/poem10818.html","مجزوء الكامل"],[50,"أنى شبابك قد مضى محمودا","https://www.aldiwan.net/poem63930.html","الكامل"],[50,"طرقتنا بالزابيين الرباب","https://www.aldiwan.net/poem64816.html","الخفيف"],[50,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[46,"رب درفس خلفه ذائب","https://www.aldiwan.net/poem23432.html","السريع"],[46,"أحسن بالواجد من وجده","https://www.aldiwan.net/poem23628.html","السريع"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[68,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85351","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39553","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54755","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54722","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142001","الرمل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12574","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43887","المديد"],[106,"في الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=179557",""],[106,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[106,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[90,"وفى الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179021",""],[99,"إلى رجل","https://www.poetsgate.com/ViewPoem.aspx?id=565",""]],"verses":[["إِن زاغَ قَلبي فَإِنَّ الهَجرَ أَحرَجَني","وَإِن صَبَرتُ فَإِنَّ اليَأسَ صَبَّرَني",0,"ن",2,0],["أُنزِلتَ أَقرَبَ مَنزِلٍ مِنّا فَلِم","بَعُدَ المَدى وَتَعَذَّرَ اللُقيانُ",1,"ن",1,0],["أَنزَفتُ دَمعِيَ حَتّى ما تَرَكتُ لَهُ","غَرباً يَفيضُ عَلى رُزءٍ إِذا يَقَعُ",2,"ع",1,0],["أَنزَلتُهُ حَيثُ لا يَظما إِلى نَهَلٍ","وَلا يُبالي بِإِخصابٍ وَإِمراعِ",3,"ع",1,0],["إِن زِدتَهُم فَلَقَد نَقَصتَهُمُ","إِنَّ الزِيادَةَ بِالشَغا نَقصُ",4,"ص",1,0],["أُنَزِّهُهُ عَن لِقاءِ الرِجالِ","وَأَجعَلُهُ تُحفَةَ الزائِرِ",5,"ر",1,0],["أَنزَعُ عَن صَفحَتِهِ","شَوكَ القَنا مُقَصَّدا",6,"د",2,0],["أَنزَعتُ دَلوي قَبلَكُم","إِلى العِراقِ سُؤدُدا",6,"د",2,0],["إِن زالَ ظِفرٌ فَأَنتَ تُخلِفُهُ","وَاللَيثُ لا يُخلِفُ المَخاليبا",7,"ب",2,0],["إِنَّ زِرَّ اللَيلِ مِن قِصَرٍ","بِبَنانِ الفَجرِ مَحلولُ",8,"ل",1,0],["أنزلتنا داراً من العز تسلى","كل ناءٍ عن داره غير قال",9,"ل",1,0],["انزِلِ المَنْزِلَ الحَسَنْ","فِي حِمَى اللهِ يَا حَسَنْ",10,"ن",1,1],["إِن زُرتَهُ أَلفَيتَهُ مُتَبَذِّلاً","رَطبَ النَدى عَشِبَ الجَنابِ مَريعا",11,"ع",2,1],["أنزّه عنك السيف في قتلك الذي","تحتّم لكن يا مخنّث بالنعل",12,"ل",1,0],["إِن زُرتُ أَهلَكِ لَم يُبالوا حاجَتي","وَإِذا هَجَرتُكِ شَفَّني هِجراني",13,"ن",2,0],["إِن زارَ قَصَّرَ لَيلي في زِيارَتِهِ","وَإِن جَفاني أَطالَ اللَيلَ أَعمارا",14,"ر",2,0],["إِن زُرتُ خَرشَنَةً أَسيرا","فَلَكَم أَحَطتُ بِها مُغيرا",15,"ر",2,1],["إِنَّ زَيداً قَد كانَ مِنّا بِأَمرٍ","لَيسَ أَمرَ المُكَذَّبِ المَغرورِ",16,"ر",1,0],["أنزل اللَّه في التَّنابز بالأل","قاب نهياً فأفحشوا التلقيبا",17,"ب",2,0],["أنزل الدار المُبَنّا","ةَ على سُقْيا القطار",18,"ر",1,0],["انزل بواد للتجدد مزهر","قد صافحت فيه السيول جلامد",19,"د",1,0],["أنزلت في ساحاته شعري كما","نزلت رتاج الكعبة الأشعار",20,"ر",1,0],["أنزل عليه الشيخ رشيد","بالوحى من عند العميد",21,"د",1,0],["أنزليه منازل الصيد منهم","وأبيجيه مرقد الأنداد",22,"د",1,0],["أُنزِلتَ مِنهُ حينَ فاتَكَ جَمعُهُ","في مَنزِلٍ بَهِجٍ بِنورِكَ زاهِ",23,"ا",2,0],["أَنزَلوا في الثَرى الوَزيرَ وَوارَوا","فيهِ تِسعينَ حِجَّةً في صُعودِ",24,"د",1,0],["أَنَزَلتَ حُفرَةَ هالِكٍ","أَم حُجرَةَ المَلِكِ المَكين",25,"ن",1,0],["إِن زَوَّجوكَ بِهِنَّ فَهيَ عَقيدَةٌ","وَمِنَ العَقائِدِ ما يَلَبُّ وَيَحمُقُ",26,"ق",1,0],["أَنزَلَ اللَهُ عَلى أَلسُنِهِم","وَحيَهُ في أَعصُرِ الوَحيِ الوِضاء",27,"ا",2,0],["إن زاد فيها اللطف فال","حيوان منها يطبعُ",28,"ع",1,0],["أَنزَلَتهُم فيهِ دِيارَ إِيادٍ","وَقَعاتُ الصَفيحِ تَدمى شِفارُه",29,"ر",2,0],["أَنزَلتَ بِالإِنجيلِ ثُمَّ بِأَهلِهِ","ذُلّاً أَراهُم عِزَّ أَهلِ المُصحَفِ",30,"ف",1,0],["إِن زادَهُ اللَهُ قَدراً زادَنا حَسَناً","مِن رَأيِهِ فَكَأَنَّ الأَمرَ لَم يَزُلِ",31,"ل",1,0],["أَنِزاعاً في الحُبِّ بَعدَ نُزوعِ","وَذَهاباً في الغَيِّ بَعدَ رُجوعِ",32,"ع",1,1],["إنزل قليلا عن الأهداب يا رجل","ما زال يقتل أحلامي ويحييها",33,"ي",3,0],["إن زادَ عنها ما يُرَوِّعُها","فالغابُ يدفعُ عنه قَسْوَرُه",34,"ر",2,0],["إِن زُرتُموها قالَ حُجّابُها","نَحنُ عَنِ الزوّارِ في شُغلِ",35,"ل",1,0],["إِن زَأَروا في الهِياجِ تَحسِبُهُم","أُسداً عَليها مِنَ القَنا أَجَمُ",36,"م",1,0],["أنزل الربوة ضيفاً عابراً","ثم أمضي عنك كالطير الغريب",37,"ب",1,0],["أَنزَلَتهُ الأَيّامُ عَن ظَهرِها مِن","بَعدِ إِثباتِ رِجلِهِ في الرِكابِ",38,"ب",1,0],["إِن زارَ مَيداناً مَضى سابِقاً","أَو نادِياً قامَ إِلَيهِ الجُلوس",39,"س",1,0],["إنْ زالَ جاهُ القضاءِ عنِّي","يكفيني الجاهُ بالعلومِ",40,"م",1,0],["أُنزِّهُ نفسي عن مساواةِ سفْلةٍ","ومنْ ذا يعضُّ الكلبَ إنْ عضَّهُ الكلبُ",41,"ب",1,0],["إنَّ زيداً في قيادتِهِ","عندَهُ لطفٌ وتسهيلُ",42,"ل",1,1],["أَنْزَلَ القُرآنَ نُوراً وهُدَى","في بيانٍ بالِغٍ أقْصَى المَدى",43,"د",2,0],["انْزَعْهُما ابنَ مكيثٍ لا تَكُنْ جَزِعاً","ولا تُرَعْ لِدَمٍ في اللهِ مُهرَاقِ",44,"ق",1,0],["إنّ زيداً أميركم فَاعْرِفُوه","وَاسْتَقِيموا لكلِّ أمرٍ نظامُ",45,"م",1,0],["أنزل اللهُ آيةً لو وعاها","راحَ بعد اللجاجِ يُلقِي القِيادا",46,"د",2,0],["إنزلْ وَسِرْ في القومِ سِيرةَ ماجدٍ","لا تُشْمِتَنَّ بك العدوَّ ولا بيا",47,"ي",2,0],["أَنزلَ الناسَ بِالظَواهِرِ مِنها","وَتَبَوّا لِنَفسِهِ بَطحاها",48,"ا",3,0],["أُنزِلتُ مِن لَيلٍ كَظِلِّ حَصاةِ","لَيلاً كَظِلِّ الرُمحِ وَهوَ مُؤاتِ",49,"ت",1,1],["إنْ زُرْتُها في العامِ يَوْماً أَنْتَجَتْ","وَأَتَتْ لِسِتَّةِ أَشْهُرُ بالقَوَّامِ",50,"م",1,0],["أَنزَفَ دَمعي طولُ تَسكابِهِ","وَاختَصَّني الحُبُّ بِأَتعابِهِ",51,"ب",2,1],["إِن زارَ رَحَّبنا وَإِن","زُرناهُ لَم نَحلُل بِرَحبِ",52,"ب",1,0],["أَنزَلنَ غَوزَكَ مِن صَياصي عِزِّهِ","ظَهراً وَكانَ غِزِيُّهُ مَجدودا",53,"د",2,0],["أَنزَلَتهُ ذُرى المَكارِمِ نَفسٌ","حُرَّةٌ في بَيانِها إِطنابُ",54,"ب",1,0],["أَنزَلنَ عَبدَ اللَهِ مِن حِصنِهِ","إِذ جِئنَهُ مِن حَيثُ لَم يَرهَبِ",55,"ب",1,0],["إِن زَجَرَ اللَهُ حَديداً نَبا","أَو أَمَرَ اللَهُ حَريراً كَلَم",56,"م",1,0],["إنّ زَماني برَزياهُ لي","صَيّرَني أمْرَحُ في قِدّهِ",57,"د",2,0],["إنْ زارَهُ المَوْتَى كساهُم في البِلى","أكفانَ أبْلَجَ مُكْرِمِ الأضْيافِ",58,"ف",1,0],["إنْ زارَ يوماً يا حشايَ تَقَطَّعِي","كَلَفاً بِه أو سارَ يا عينُ اذرِفي",59,"ي",1,0],["إن زالَ ما في قلوب القوم من حسك","يَوماً تبدَّلت العضّاتُ بالقبل",60,"ل",1,0],["إنَّ زماناً قد عفا","وإن عمراً ذهبا",61,"ب",2,0],["انزعوا الصخرَ من الطودِ المنيعْ","واجعلوه زادَكم عند الكفاحْ",62,"ح",1,0],["إن زال مُلكُ الأرضِ عنك من ملكْ","يا طولَ مُلكٍ في السماءِ تمَّ لك",63,"ك",1,0],["إنْ زالَ هذا كانَ ذا مكانَهُ","فاسمَعْ مقالي وافهمنْ بيانَهُ",64,"ه",1,0],["أَنْزَلَ الرَّوْعَ فِي صِلاَبِ الْعِمَادِ","ذَلِكَ الْخَطْبُ فِي عَمِيدِ الْبِلاَدِ",65,"د",1,1],["أَنْزَلْتِ هَوْلاً فِي قرَاهُ","وَفِي الذَّرَائِرِ أَجْمَعِ",66,"ع",1,0],["إِنْ زَاوَلَ الإِنشَاءَ أَبلَغُ مُنْشِيءٍ","أَوْ زَاوَلَ الإِنْشَادَ أَفصَحُ مُنْشِدِ",67,"د",1,0],["أنزل الوحي على أبنائه","وأتى الناس بأسمى معتقد",68,"د",1,0],["أَنزَلتِ بِالقَلبِ هَمّاً قَد أَضَرَّ بِهِ","صَبراً عَلى الهَمِّ حَتّى يَنزِلَ الفَرَجُ",69,"ج",1,1],["إِنْ زَجَرْتُ الطّيرَ في سَفَري","عن يمينِي مرَّ سانِحُهُ",70,"ح",2,0],["إن زواك الحجابُ عني، لكم في","جنْح ليل شافهتَني بالخطاب",71,"ب",1,0],["إنْ زِيرَ، تَخْرجُ عِرسُهُ من دُوِنِه","للزائرين بثغرها البسام",72,"م",1,0],["انزعوه من فَكَّي الدهر قَسْرًا","كلُّ صعب يراض بالقسرِ لآنا",73,"ن",2,0],["إن زِينَ قومٌ بالقصيد فانني","باسمي يزانُ الشعرُ في تعريفه",74,"ف",2,0],["إنزل قليلا عن الأهداب يا رجلا","ما زال يقتل أحلامي 