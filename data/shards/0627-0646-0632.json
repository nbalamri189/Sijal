17,"من معيد لي من عهد الألى","https://www.aldiwan.net/poem53974.html","الرمل"],[417,"أدار على الندمان كأس عقاره","https://www.aldiwan.net/poem54057.html","الطويل"],[417,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[417,"اليوم أصبح فيك الوقت منتظما","https://www.aldiwan.net/poem54127.html","البسيط"],[433,"إليك من ملك سام ومن ملك","https://www.aldiwan.net/poem12357.html","البسيط"],[433,"انزع لباسك فالآجال حاكمة","https://www.aldiwan.net/poem12489.html","البسيط"],[433,"أظنه حاذر سلوانا","https://www.aldiwan.net/poem12739.html","السريع"],[438,"نصر من الله وافانا به الخبر","https://www.aldiwan.net/poem2611.html","البسيط"],[459,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[459,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[459,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[459,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[459,"قل لها أيها الخيال الطروق","https://www.aldiwan.net/poem56105.html","الخفيف"],[459,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[465,"شف قلبي دلاله","https://www.aldiwan.net/poem3358.html","عموديه"],[469,"أدل بالدل منه","https://www.aldiwan.net/poem59576.html","المجتث"],[471,"إن زين الغدير من كسر الجر","https://www.aldiwan.net/poem4721.html","الخفيف"],[496,"كم حسرات لي وكم وجد","https://www.aldiwan.net/poem9818.html","السريع"],[497,"قرأت مجدك في قلبي وفي الكتب","https://www.aldiwan.net/poem55808.html","عموديه"],[514,"أنزه في روض المحاسن مقلتي","https://www.aldiwan.net/poem67683.html","الطويل"],[515,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[515,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[516,"نبهتني حمامة بسحير","https://www.aldiwan.net/poem12292.html","الخفيف"],[552,"عن الخيال لنا ليالي الأبرق","https://www.aldiwan.net/poem47353.html","الكامل"],[552,"إن كنت ترغب في الثواء","https://www.aldiwan.net/poem47757.html","مجزوء الكامل"],[554,"لم أصح من لذة لا لا ولا طرب","https://www.aldiwan.net/poem68405.html","البسيط"],[559,"إنزل بنابلس برأس العين","https://www.aldiwan.net/poem33493.html","عموديه"],[559,"أجهلت قدرك أيها الإنسان","https://www.aldiwan.net/poem33842.html","الكامل"],[559,"انظر الكل لطيفا","https://www.aldiwan.net/poem34353.html","مجزوء الرمل"],[559,"يا من يقول بأنه يدري الفنا","https://www.aldiwan.net/poem34465.html","الكامل"],[559,"هذه الآيات والسور","https://www.aldiwan.net/poem34487.html","المديد"],[560,"سلوي مكروه وحبك واجب","https://www.aldiwan.net/poem69369.html","الطويل"],[563,"إن زرت قبر ابن نحاس لصبوته","https://www.aldiwan.net/poem52678.html","البسيط"],[576,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"]],"verses":[["إِن زاغَ قَلبي فَإِنَّ الهَجرَ أَحرَجَني","وَإِن صَبَرتُ فَإِنَّ اليَأسَ صَبَّرَني",0,"ن",2,0],["أُنزِلتَ أَقرَبَ مَنزِلٍ مِنّا فَلِم","بَعُدَ المَدى وَتَعَذَّرَ اللُقيانُ",1,"ن",1,0],["أَنزَفتُ دَمعِيَ حَتّى ما تَرَكتُ لَهُ","غَرباً يَفيضُ عَلى رُزءٍ إِذا يَقَعُ",2,"ع",1,0],["أَنزَلتُهُ حَيثُ لا يَظما إِلى نَهَلٍ","وَلا يُبالي بِإِخصابٍ وَإِمراعِ",3,"ع",1,0],["إِن زِدتَهُم فَلَقَد نَقَصتَهُمُ","إِنَّ الزِيادَةَ بِالشَغا نَقصُ",4,"ص",1,0],["أُنَزِّهُهُ عَن لِقاءِ الرِجالِ","وَأَجعَلُهُ تُحفَةَ الزائِرِ",5,"ر",1,0],["أَنزَعُ عَن صَفحَتِهِ","شَوكَ القَنا مُقَصَّدا",6,"د",2,0],["أَنزَعتُ دَلوي قَبلَكُم","إِلى العِراقِ سُؤدُدا",6,"د",2,0],["إِن زالَ ظِفرٌ فَأَنتَ تُخلِفُهُ","وَاللَيثُ لا يُخلِفُ المَخاليبا",7,"ب",2,0],["إِنَّ زِرَّ اللَيلِ مِن قِصَرٍ","بِبَنانِ الفَجرِ مَحلولُ",8,"ل",1,0],["أنزلتنا داراً من العز تسلى","كل ناءٍ عن داره غير قال",9,"ل",1,0],["انزِلِ المَنْزِلَ الحَسَنْ","فِي حِمَى اللهِ يَا حَسَنْ",10,"ن",1,1],["إِن زُرتَهُ أَلفَيتَهُ مُتَبَذِّلاً","رَطبَ النَدى عَشِبَ الجَنابِ مَريعا",11,"ع",2,1],["أنزّه عنك السيف في قتلك الذي","تحتّم لكن يا مخنّث بالنعل",12,"ل",1,0],["إِن زُرتُ أَهلَكِ لَم يُبالوا حاجَتي","وَإِذا هَجَرتُكِ شَفَّني هِجراني",13,"ن",2,0],["إِن زارَ قَصَّرَ لَيلي في زِيارَتِهِ","وَإِن جَفاني أَطالَ اللَيلَ أَعمارا",14,"ر",2,0],["إِن زُرتُ خَرشَنَةً أَسيرا","فَلَكَم أَحَطتُ بِها مُغيرا",15,"ر",2,1],["إِنَّ زَيداً قَد كانَ مِنّا بِأَمرٍ","لَيسَ أَمرَ المُكَذَّبِ المَغرورِ",16,"ر",1,0],["أنزل اللَّه في التَّنابز بالأل","قاب نهياً فأفحشوا التلقيبا",17,"ب",2,0],["أنزل الدار المُبَنّا","ةَ على سُقْيا القطار",18,"ر",1,0],["انزل بواد للتجدد مزهر","قد صافحت فيه السيول جلامد",19,"د",1,0],["أنزلت في ساحاته شعري كما","نزلت رتاج الكعبة الأشعار",20,"ر",1,0],["أنزل عليه الشيخ رشيد","بالوحى من عند العميد",21,"د",1,0],["أنزليه منازل الصيد منهم","وأبيجيه مرقد الأنداد",22,"د",1,0],["أُنزِلتَ مِنهُ حينَ فاتَكَ جَمعُهُ","في مَنزِلٍ بَهِجٍ بِنورِكَ زاهِ",23,"ا",2,0],["أَنزَلوا في الثَرى الوَزيرَ وَوارَوا","فيهِ تِسعينَ حِجَّةً في صُعودِ",24,"د",1,0],["أَنَزَلتَ حُفرَةَ هالِكٍ","أَم حُجرَةَ المَلِكِ المَكين",25,"ن",1,0],["إِن زَوَّجوكَ بِهِنَّ فَهيَ عَقيدَةٌ","وَمِنَ العَقائِدِ ما يَلَبُّ وَيَحمُقُ",26,"ق",1,0],["أَنزَلَ اللَهُ عَلى أَلسُنِهِم","وَحيَهُ في أَعصُرِ الوَحيِ الوِضاء",27,"ا",2,0],["إن زاد فيها اللطف فال","حيوان منها يطبعُ",28,"ع",1,0],["أَنزَلَتهُم فيهِ دِيارَ إِيادٍ","وَقَعاتُ الصَفيحِ تَدمى شِفارُه",29,"ر",2,0],["أَنزَلتَ بِالإِنجيلِ ثُمَّ بِأَهلِهِ","ذُلّاً أَراهُم عِزَّ أَهلِ المُصحَفِ",30,"ف",1,0],["إِن زادَهُ اللَهُ قَدراً زادَنا حَسَناً","مِن رَأيِهِ فَكَأَنَّ الأَمرَ لَم يَزُلِ",31,"ل",1,0],["أَنِزاعاً في الحُبِّ بَعدَ نُزوعِ","وَذَهاباً في الغَيِّ بَعدَ رُجوعِ",32,"ع",1,1],["إنزل قليلا عن الأهداب يا رجل","ما زال يقتل أحلامي ويحييها",33,"ي",3,0],["إن زادَ عنها ما يُرَوِّعُها","فالغابُ يدفعُ عنه قَسْوَرُه",34,"ر",2,0],["إِن زُرتُموها قالَ حُجّابُها","نَحنُ عَنِ الزوّارِ في شُغلِ",35,"ل",1,0],["إِن زَأَروا في الهِياجِ تَحسِبُهُم","أُسداً عَليها مِنَ القَنا أَجَمُ",36,"م",1,0],["أنزل الربوة ضيفاً عابراً","ثم أمضي عنك كالطير الغريب",37,"ب",1,0],["أَنزَلَتهُ الأَيّامُ عَن ظَهرِها مِن","بَعدِ إِثباتِ رِجلِهِ في الرِكابِ",38,"ب",1,0],["إِن زارَ مَيداناً مَضى سابِقاً","أَو نادِياً قامَ إِلَيهِ الجُلوس",39,"س",1,0],["إنْ زالَ جاهُ القضاءِ عنِّي","يكفيني الجاهُ بالعلومِ",40,"م",1,0],["أُنزِّهُ نفسي عن مساواةِ سفْلةٍ","ومنْ ذا يعضُّ الكلبَ إنْ عضَّهُ الكلبُ",41,"ب",1,0],["إنَّ زيداً في قيادتِهِ","عندَهُ لطفٌ وتسهيلُ",42,"ل",1,1],["أَنْزَلَ القُرآنَ نُوراً وهُدَى","في بيانٍ بالِغٍ أقْصَى المَدى",43,"د",2,0],["انْزَعْهُما ابنَ مكيثٍ لا تَكُنْ جَزِعاً","ولا تُرَعْ لِدَمٍ في اللهِ مُهرَاقِ",44,"ق",1,0],["إنّ زيداً أميركم فَاعْرِفُوه","وَاسْتَقِيموا لكلِّ أمرٍ نظامُ",45,"م",1,0],["أنزل اللهُ آيةً لو وعاها","راحَ بعد اللجاجِ يُلقِي القِيادا",46,"د",2,0],["إنزلْ وَسِرْ في القومِ سِيرةَ ماجدٍ","لا تُشْمِتَنَّ بك العدوَّ ولا بيا",47,"ي",2,0],["أَنزلَ الناسَ بِالظَواهِرِ مِنها","وَتَبَوّا لِنَفسِهِ بَطحاها",48,"ا",3,0],["أُنزِلتُ مِن لَيلٍ كَظِلِّ حَصاةِ","لَيلاً كَظِلِّ الرُمحِ وَهوَ مُؤاتِ",49,"ت",1,1],["إنْ زُرْتُها في العامِ يَوْماً أَنْتَجَتْ","وَأَتَتْ لِسِتَّةِ أَشْهُرُ بالقَوَّامِ",50,"م",1,0],["أَنزَفَ دَمعي طولُ تَسكابِهِ","وَاختَصَّني الحُبُّ بِأَتعابِهِ",51,"ب",2,1],["إِن زارَ رَحَّبنا وَإِن","زُرناهُ لَم نَحلُل بِرَحبِ",52,"ب",1,0],["أَنزَلنَ غَوزَكَ مِن صَياصي عِزِّهِ","ظَهراً وَكانَ غِزِيُّهُ مَجدودا",53,"د",2,0],["أَنزَلَتهُ ذُرى المَكارِمِ نَفسٌ","حُرَّةٌ في بَيانِها إِطنابُ",54,"ب",1,0],["أَنزَلنَ عَبدَ اللَهِ مِن حِصنِهِ","إِذ جِئنَهُ مِن حَيثُ لَم يَرهَبِ",55,"ب",1,0],["إِن زَجَرَ اللَهُ حَديداً نَبا","أَو أَمَرَ اللَهُ حَريراً كَلَم",56,"م",1,0],["إنّ زَماني برَزياهُ لي","صَيّرَني أمْرَحُ في قِدّهِ",57,"د",2,0],["إنْ زارَهُ المَوْتَى كساهُم في البِلى","أكفانَ أبْلَجَ مُكْرِمِ الأضْيافِ",58,"ف",1,0],["إنْ زارَ يوماً يا حشايَ تَقَطَّعِي","كَلَفاً بِه أو سارَ يا عينُ اذرِفي",59,"ف",2,0],["إن زالَ ما في قلوب القوم من حسك","يَوماً تبدَّلت العضّاتُ بالقبل",60,"ل",1,0],["إنَّ زماناً قد عفا","وإن عمراً ذهبا",61,"ب",2,0],["انزعوا الصخرَ من الطودِ المنيعْ","واجعلوه زادَكم عند الكفاحْ",62,"ح",1,0],["إن زال مُلكُ الأرضِ عنك من ملكْ","يا طولَ مُلكٍ في السماءِ تمَّ لك",63,"ك",1,0],["إنْ زالَ هذا كانَ ذا مكانَهُ","فاسمَعْ مقالي وافهمنْ بيانَهُ",64,"ه",1,0],["أَنْزَلَ الرَّوْعَ فِي صِلاَبِ الْعِمَادِ","ذَلِكَ الْخَطْبُ فِي عَمِيدِ الْبِلاَدِ",65,"د",1,1],["أَنْزَلْتِ هَوْلاً فِي قرَاهُ","وَفِي الذَّرَائِرِ أَجْمَعِ",66,"ع",1,0],["إِنْ زَاوَلَ الإِنشَاءَ أَبلَغُ مُنْشِيءٍ","أَوْ زَاوَلَ الإِنْشَادَ أَفصَحُ مُنْشِدِ",67,"د",1,0],["أنزل الوحي على أبنائه","وأتى الناس بأسمى معتقد",68,"د",1,0],["أَنزَلتِ بِالقَلبِ هَمّاً قَد أَضَرَّ بِهِ","صَبراً عَلى الهَمِّ حَتّى يَنزِلَ الفَرَجُ",69,"ج",1,1],["إِنْ زَجَرْتُ الطّيرَ في سَفَري","عن يمينِي مرَّ سانِحُهُ",70,"ح",2,0],["إن زواك الحجابُ عني، لكم في","جنْح ليل شافهتَني بالخطاب",71,"ب",1,0],["إنْ زِيرَ، تَخْرجُ عِرسُهُ من دُوِنِه","للزائرين بثغرها البسام",72,"م",1,0],["انزعوه من فَكَّي الدهر قَسْرًا","كلُّ صعب يراض بالقسرِ لآنا",73,"ن",2,0],["أنزلوه زنزانة ، أنت أدرى","يا أبا الضرب ، كيف ترعى النزيلا",74,"ل",2,0],["إن زِينَ قومٌ بالقصيد فانني","باسمي يزانُ الشعرُ في تعريفه",75,"ف",2,0],["ان زان وقتي خذت لذّة فواقه","ولوّه يشين يشين عادي ولوّه",76,"و",2,0],["أنزّه آلامي عن الدّمع والأسى","فتؤنسها منّي الطلاقة والبشر",77,"ر",1,0],["إنزل قليلا عن الأهداب يا رجلا","ما زال يقتل أحلامي ويحييها",78,"ي",3,0],["أنزِلَ الحُبُّ عن العَرشِ","إلى سُوقِ الفُجور",79,"ر",1,0],["انزلتَ لازلتَ أهليه منازلهم","فيه فإِمَّا خُمُولاً بَعدُ أو صِيتاً",80,"ت",2,0],["أنزهُ لحظَيْ المحبوب مِن أن","يكون عليهما أدنى اعتراضِ",81,"ض",1,1],["إنّ زمانا لابن دارستَ قد","قُدِّمَ فيه زمنٌ أبلَهْ",82,"ل",2,0],["أنزِّه قَعْبىَ عن خَلِّها","وآنَفُ من مخِض أوطابها",83,"ب",3,0],["إِن زُرتَ مَملَكَةَ النَصارى زَورَةً","أَعيا عَلى أَصحابِها إِصحابُها",84,"ب",3,0],["اِنزل عَلى الملكِ الَّذي بِفنائِهِ","تُلقى الرِّحالُ وَيَستَريحُ المُتعَبُ",85,"ب",1,0],["اِنزل عَلى البَحرِ الخِضَمِّ فَما بَقى","مَلكٌ سِواهُ بِهِ تُناخُ الأَركُبُ",85,"ب",1,0],["اِنزل عَلى الطَّودِ الأَشَمِّ فَإِنَّهُ","حِصنٌ يُحاذِرُهُ الزَمانُ وَيرهبُ",85,"ب",1,0],["اِنزل عَلى النَدبِ الهُمامِ فَما تَرى","أَحَداً سِواهُ إِلى المَكارِمِ يَرغَبُ",85,"ب",1,0],["اِنزِل لِتَلثِمَ ذا الصَعيدَ مُقَبِّلاً","شَرَفاً وَإِجلالاً لِمَولى ذا المَلا",86,"ل",2,1],["إن زيد بالأمس فضلا في معيشته","فاليوم يسلبه ما الأمس واهبه",87,"ب",2,0],["انزلتَ قومك للجلاد فدافعوا","في ذمة الحق المباح وانجدوا",88,"د",3,0],["إن زُوحِمت في المكرمات فإنها","ما زُحزِحَت عن بأسِها وسخائها",89,"ا",3,0],["إنْ زارَ خَصْماً فيا للهِ من لَجبٍ","لم يُبْقِ منها مُشِيْداً غير مُنْهَدِمِ",90,"م",1,0],["أَنزَلتُهُ في وَهدَةٍ","مِنها هَواهُ ما صَعَد",91,"د",1,0],["إِنزَعوا مِنِّيَ قَلبي","رَحمَةً كَي أَستَريح",92,"ح",1,1],["إِنزَعي الحليَ عَنكِ وَاِستَبدليها","بِقُيودٍ أَحقّ بِالسافِكينا",93,"ن",2,0],["إِنَّ زَيتَ المَجدِ تشعلُهُ","زَفَراتٌ اليَاسِ من صَدرِ الشَباب",94,"ب",1,0],["أَنزَلتَ مَن يَرجوكَ أَرحَبَ مَنزِلٍ","وَبَسَطتَ مَن يَرجوكَ خَيرَ بَساطِ",95,"ط",1,0],["إِنزِل بِهِ تَظَفَر بِقا","صِيَةِ المُنى وَأَنا الزَعيمُ",96,"م",1,0],["إن زليخا لو أبصرتك لما","ملت إلى الحشر لذة النظر",97,"ر",1,0],["أنزه شعري عن دناءة قدره","وأنقى يقيني من دناسة شكه",98,"ك",2,0],["انزل بناديه فإنك آمن","واستسق أديديه فهن سحائب",99,"ب",1,0],["إِنْ زُرْتَهُ فَتَوَقَّ فَيْضَ بَنانِهِ","إِنَّ الْبِحارَ مَلِيَّةٌ أَنْ تُغْرِقا",100,"ق",2,0],["إِنْ زُرْتُ دارَكَ عنْ شَوْقٍ فَمَجْدُكَ بِي","أَوْلى وَما كُلُّ مُشْتاقٍ بِزَوّارِ",101,"ر",1,0],["إن زرته نلت الرضا وكفيته","هذا أحق وما لديك جميل",102,"ل",1,0],["إِن زارَني بفضلِهِ","أَو زرتُه لِفَضله",103,"ه",1,0],["إنْ زلّ بعضُ الشيب من قطّانِه","فلسوف يغسل عارَهم شبانه",104,"ن",2,0],["إن زاحم الشاعر يذكر به","كشاجما في الوقت والرفغا",105,"ف",3,0],["أنزلتها باب الكريم ولم","أخش انقطاعاً بعد إنزالي",106,"ل",2,0],["أَنزلتُ حاجاتي بِبابك واثقاً","بِالنجحِ والتيسير للمتعسّرِ",107,"ر",1,0],["أَنزلت آمالي بهِ فتطاوَلَت","تيهاً وَكانت قبل ذاك قصارا",108,"ر",2,0],["انزعى مئزَرك المحسو","د ألقيه إليّا",109,"ي",2,0],["أُنَزِّهُ العَينَ عَن عِلمٍ يُصَوِّرُهُ","حَدٌّ وَإِن لَحَظَتهُ العَينُ كَالصُوَرِ",110,"ر",1,1],["إِن زادَ شَهراً عَنكَ جمّل اِسمه","فَجَمال وَجهك زاد عَنهُ أَشهُرا",111,"ر",2,0],["أَنزى إِذا نوديتُ مِن كَلبٍ ذَكر","أَكدرَ شَغّارٍ تَعدّى في السَحَر",112,"ر",1,0],["إن زَلَّ نَعْلٌ فيأْبَى أن يَزِلَّ به","جَدٌّ له في المعالي طالما رَقيا",113,"ي",2,0],["إِن زَلَّ عَزمِيَ فَهوَ البَحرُ زَلزَلَةً","وَقَد يَخِفُّ إِذا ما زُلزِلُ الجَبَلُ",114,"ل",1,0],["إِن زِدتَني وَجَحَدتُ ما أَولَيتَني","يَوماً فَإِنَّ زِيادَتي نُقصانُ",115,"ن",1,0],["أُنَزِّهُ عَن وَعدِ الكَريمِ عَطاءَهُ","وَما جَلَّ عَن وَعدٍ فَقَد جَلَّ مَطلِ",116,"ل",1,0],["إن زلت البغلة من تحته","فإن في زلتها عذرا",117,"ر",2,1],["أنزَلتَهُ في جَنابٍ غيرِ مُهتَضمٍ","أبا الحُسينِ ورِزقٍ غيرِ محتبسِ",118,"س",1,0],["إن زاد فَثْمانونَ شوطاً بعده","يكبو جواد العمر في شأو العلل",119,"ل",1,0],["انزه طَبعي إِن أَحمِلُهُ القَذا","وَما خَلقت نَفسي مطيئة ادغال",120,"ل",1,0],["أنزه الطرف فيما قد حوى وطوى","واجتنى من جناه اليانع الداني",121,"ن",2,0],["أُنَزِّه ربَّ الخَلقِ عن حَدِّ خلقِهِ","وَقد زاغَ راوٍ في الصِفاتِ وَمُسنَدُ",122,"د",1,0],["أنزهه عن كل قول يقوله","ذوو الكفر والتعطيل من كل ذي جحد",123,"د",1,0],["أُنزِلْتُ في ساحَةِ الجَفاءِ وما","ساخَتْ سِماتي بجَفوةٍ أبَدا",124,"د",2,0],["أنْزَل الله على جَدّهُمُ","سيّدِ الرسل الكتابَ المنزَّلا",125,"ل",2,0],["أُنزِّه طرفي في محاسن وجهه","وإنْ غابَ عنِّي لم أزلْ بانتظاره",126,"ر",2,0],["أُنْزِلتْ للحسن آيات به","آمن العاشق فيهنَّ وما ارتد",127,"د",1,0],["أنزلَته من منيعات الحصون ولو","تركت تركي رهين الحصن مات ظما",128,"م",2,0],["أَنْزَلْتَ دُونَ مطاهُ كُلَّ مرتكِبٍ","بناهضٍ من مُراعٍ غيرِ مُرْتَبِكِ",129,"ك",1,0],["انزعْ لباسَك فالآجالُ حاكمةٌ","أن لا ترُدَّ سِهامَ الموتِ بالزّرَدِ",130,"د",1,1],["أنزِلْ به في الحي من مازنٍ","ولا تخَفْ ذُهْلَ بن شَيْبانا",131,"ن",2,0],["أنزلت أفدئة منهم رياض ردىً","زرق الأسفّة في أطرافها زهر",132,"ر",1,0],["إن زار دارك عن مراقبةٍ","حَيَّا وإن هو لم يزر حَنَّا",133,"ن",2,0],["أنَّ زعيمَ الدينِ أغراه بال","عزة أو علَّمهُ الاِعتزامْ",134,"م",1,0],["إن زار يومٌ كُسِيَ ال","حسنَ ولم نَحُلَّهْ",135,"ل",2,0],["أنزعتِ العُربَ عن دِينهمُ","أم تفرّدتِ بدِينٍ منتحَلْ",136,"ل",1,0],["أنزلتْني الأيامُ بعدكُمُ حي","ث تضاع العلا وتُلوَى الحقوقُ",137,"ق",1,0],["أنزلني منزلةً بين الغنى","والفقرِ لم يبخلْ بها ولم يَجُدْ",138,"د",1,0],["إن زعمتم أن الهوى","ليس تصمي نبالهُ",139,"ل",2,0],["إِن زارَني كانَ عِندي","عَينٌ وَراءٌ وَسينُ",140,"ن",1,0],["إِنَّ زَينَ الغَديرِ مَن كَسَر الجَر","رَ وَغَنَّى غِناءَ فَحلٍ مُجيدِ",141,"د",1,1],["أنزلني الدّهر على حكمه","من شامخ عالِ إلى وَهْد",142,"د",1,0],["أنزلتُ حُبَّكِ في آهِي فشدَّدَها","طَرِبْتُ آهاً، فكُنتِ المجدَ في طَرَبِي",143,"ب",2,0],["أنزه في روض المحاسن مقلتي","وأمنع نفسي أن تنال محرما",144,"م",2,1],["إنْ زارَهُ سائِلٌ عافٍ يعظّمُه","وإن تآتاهُ جبّارٌ يحقّرُهُ",145,"ر",2,0],["إن زارَهُم خصْمٌ عليه نضوا الظُّبا","أو مُدنفٌ سلّوا عليهِ الأعيُنا",146,"ن",2,0],["أنزلوها في الترب رغماً برغمي","ثم صارت رهينة الأكفان",147,"ن",1,0],["أنزلتها قَسْراً على حكم الظُّبا","وقضيّةِ العالي الأشُمِّ الأزرقِ",148,"ق",1,0],["إنْ زُرْتَهم زرت الأهل","لَةَ في مَطالِعِها بُروزا",149,"ز",2,0],["إِن زِدتَهُ رُتبَةً تَبغي زِيادَتَهُ","في النُصحِ أَعطاكُمُ عَشراً مِنَ الرُتَبِ",150,"ب",1,0],["إنزل بنابُلسٍ برأس العينِ","وانظر خمايِلها برأس العينِ",151,"ن",1,1],["إنزع ثيابك عنك وابق بغيرها","تعرف مقامك أيها الإنسان",152,"ن",1,0],["أنزلت قولاً ثقيلاً","جعل الكون خفيفا",153,"ف",2,0],["إن زاد عن يوم تراه وليلة","مثل الجنون بحكمه المستكره",154,"ر",2,0],["إن زهدي خلقة طبعت","فيه نفس ليس تنحصر",155,"ر",1,0],["أُنَزِّهُ طَرفي في سماء جَمالكمْ","لِثاقب ذِهني نَجمُها هو ثاقبُ",156,"ب",1,0],["إن زُرْتَ قبرَ ابنِ نَحَّاسٍ لصَبوتهِ","فاطلُبْ لقلبِ أبيهِ صبرَ أيُّوبِ",157,"ب",1,1],["أَنزلْتُه في خَاطري","مُجاوراً هُمومِي",158,"م",2,0]]}