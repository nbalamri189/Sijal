{"poems":[[234,"خليلي قد ولى الظلام وهملجا","https://www.aldiwan.net/poem51194.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48731","البسيط"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124771","الطويل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46862","الطويل"]],"verses":[["وقاذفةٍ بالماء في وَسْط بِركةٍ","قد التحفتْ وَحفاً من الشعْر سَجْسَجا",0,"ج",2,0],["وقاذف لو درى المقذوف من قدر","إليه لارتد يشفيه من الضغن",1,"ن",1,0],["وقاذف أم المصطفى اقتله بتّة","ولو كان ذا إسلام أو ذا تهوّد",2,"د",1,0],["وقاذفة أيضاً وذلك ردة","ولا يسقط الإسلام قتلا بأوكد",2,"د",1,0],["وَقاذِفَ دَمْعٍ كالجِمارِ مُورَّداً","إذا ما أفاضَ الناسُ فاضَ عَلى النَّحْرِ",3,"ر",1,0]]}