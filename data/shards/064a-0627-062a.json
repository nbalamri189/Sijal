{"poems":[[53,"نخطو وما خطونا إلا إلى الأجل","https://www.aldiwan.net/poem29884.html","البسيط"],[53,"ألقي السلاح ربيعة بن نزار","https://www.aldiwan.net/poem30445.html","الكامل"],[55,"إن الأحبة آذنوا برحيل","https://www.aldiwan.net/poem26172.html","الكامل"],[55,"أبكي وأستخلي كتابك","https://www.aldiwan.net/poem26287.html","مجزوء الكامل"],[77,"يا واحد الدهر في علم وفي عمل","https://www.aldiwan.net/poem36496.html","البسيط"],[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[71,"يا تاجنا قد أتتك مسألة","https://www.aldiwan.net/poem3801.html","المنسرح"],[73,"هذا الصباح على سراك رقيبا","https://www.aldiwan.net/poem11919.html","الكامل"],[10,"ياعين جودي بالدموع السجول","https://www.aldiwan.net/poem21124.html","السريع"],[93,"يا ترب عصرك بيتي","https://www.aldiwan.net/poem11464.html","المجتث"],[54,"يا تارك البيت على الضيف","https://www.aldiwan.net/poem27523.html","السريع"],[88,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[88,"الشعر بعد مصابه بكبيره","https://www.aldiwan.net/poem45040.html","الطويل"],[27,"أمسى فؤادك عند الحي مرهونا","https://www.aldiwan.net/poem4439.html","البسيط"],[27,"قال الأمير لعبد تيم بئس ما","https://www.aldiwan.net/poem5683.html","الكامل"],[27,"هاج الهوى وضمير الحاجة الذكر","https://www.aldiwan.net/poem5773.html","البسيط"],[27,"يا تيم ما القارون في شدة القرى","https://www.aldiwan.net/poem5937.html","الطويل"],[27,"حي الديار كوحي الكاف والميم","https://www.aldiwan.net/poem5980.html","البسيط"],[27,"حيوا الديار وأهلها بسلام","https://www.aldiwan.net/poem6005.html","الكامل"],[47,"بالكره مني واختيارك","https://www.aldiwan.net/poem25213.html","مجزوء الكامل"],[72,"عوض بكأسك ما أتلفت من نشب","https://www.aldiwan.net/poem18227.html","البسيط"],[72,"دانت لك الدنيا وملت لأرغد","https://www.aldiwan.net/poem18570.html","الكامل"],[72,"يا تاج دين الله كم نعمة","https://www.aldiwan.net/poem19207.html","السريع"],[72,"أبكيك للحسنين الخلق والخلق","https://www.aldiwan.net/poem19356.html","البسيط"],[72,"يا تاركين للمحب أدمعا","https://www.aldiwan.net/poem19361.html","الرجز"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[51,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[51,"يا تناه والتناهي انقطاع","https://www.aldiwan.net/poem65423.html","المديد"],[51,"يا أحمد بن سعيد لا تمت جزعا","https://www.aldiwan.net/poem65873.html","البسيط"],[51,"لا زلت تفخم والثناء ضئيل","https://www.aldiwan.net/poem65988.html","الكامل"],[91,"قالت لجارتها يوما تسائلها","https://www.aldiwan.net/poem62759.html","عموديه"],[70,"غيري على السلوان قادر","https://www.aldiwan.net/poem42882.html","مجزوء الكامل"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[89,"ابناء دجلة والفرات نيام","https://www.aldiwan.net/poem44882.html","الكامل"],[85,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[85,"وإن موليير نجم لا أفول له","https://www.aldiwan.net/poem7042.html","البسيط"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[45,"بالله أولي يمينا برة قسما","https://www.aldiwan.net/poem65683.html","البسيط"],[61,"ما ضر ليلتنا بسفح محجر","https://www.aldiwan.net/poem51682.html","الكامل"],[61,"عفر الظباء لدى الكثيب الأعفر","https://www.aldiwan.net/poem51686.html","الكامل"],[49,"قطعت منك حبائل الآمال","https://www.aldiwan.net/poem63049.html","الكامل"],[97,"يا قاسي البعد كيف تبتعد","https://www.aldiwan.net/poem24916.html","المنسرح"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[80,"يا تاركا راحا تسلي همه","https://www.aldiwan.net/poem31368.html","الكامل"],[69,"يا تاجرا في العلم لا","https://www.aldiwan.net/poem28124.html","مجزوء الكامل"],[69,"يا تاجر الأقباع فرقك دائر","https://www.aldiwan.net/poem28369.html","الكامل"],[69,"مجالس مؤتمن","https://www.aldiwan.net/poem28511.html","مجزوء الرجز"],[69,"يا ترجمانا لي ثمانون في","https://www.aldiwan.net/poem28597.html","السريع"],[69,"ليس الفتى كل الفتى عندنا","https://www.aldiwan.net/poem29263.html","السريع"],[31,"قد أصاب القلب من نعم","https://www.aldiwan.net/poem41325.html","المديد"],[105,"ناد القبور وبشر كل مقبور","https://www.aldiwan.net/poem43053.html","البسيط"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[105,"حل الوفاء الحق عقد ذمامه","https://www.aldiwan.net/poem43101.html","الكامل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"أرى فسادا وشرا ضاع بينهما","https://www.aldiwan.net/poem43139.html","البسيط"],[105,"هل ليم نضو صبابة فأفاقا","https://www.aldiwan.net/poem43377.html","الكامل"],[105,"من يمنع الليث أن يعتز أو يثبا","https://www.aldiwan.net/poem43386.html","البسيط"],[105,"بشراك أم حبيبة بمحمد","https://www.aldiwan.net/poem44057.html","الكامل"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[81,"خذها فصبغ الظلام قد نصلا","https://www.aldiwan.net/poem61437.html","المنسرح"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[75,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[75,"يا رب كل كتيبة شهباء","https://www.aldiwan.net/poem69108.html","الكامل"],[48,"يا تاركي جسدا بغير فؤاد","https://www.aldiwan.net/poem62574.html","الكامل"],[48,"يا تارك الأبرار فجارا","https://www.aldiwan.net/poem63338.html","السريع"],[46,"يأتي على الخلق إصباح وإمساء","https://www.aldiwan.net/poem21995.html","البسيط"],[46,"يأتي الردى ويواري إثلب جسدا","https://www.aldiwan.net/poem22199.html","البسيط"],[46,"شربي على المقلة في مقلت","https://www.aldiwan.net/poem22355.html","السريع"],[46,"يا تاجر المصر ما أنصفت سائمة","https://www.aldiwan.net/poem23053.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85481","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85582","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85415","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39682","المنسرح"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202645","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55156","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54722","الكامل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23960","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54330","الخفيف"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[106,"في ربا الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179685",""],[67,"وكتابُ شعيا مخبرٌ عن ربهِ","https://www.poetsgate.com/ViewPoem.aspx?id=14561",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[90,"بنت بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=179192",""],[46,"شُربي، على المُقلةِ، في مَقْلَتٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=18046",""],[31,"قَدْ أَصَابَ القَلْبَ مِنْ نُعْمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19080&r=&rc=343",""]],"verses":[["يَأتي الحِمامُ فَيَنسى المَرءُ مُنيَتَهُ","وَأَعضَلُ الداءِ ما يُلهي عَنِ الأَمَلِ",0,"ل",1,0],["يا تَغلِبَ اِبنَةَ وائِلٍ ما لي أَرى","نَجمَيكِ قَد أَفَلا عَنِ النُظّارِ",1,"ر",1,0],["يَأتونَ مَكَّةَ عامِدينَ لِحَجِّهِم","وَيُخَلِّفونَكَ مَيِّتاً بِغَليلِ",2,"ل",1,0],["يَأتي الكِتابُ عَنِ الحَبي","بِ مُمَثَّلاً فيهِ ضَميرُه",3,"ر",2,0],["يأتي مع النّجْمِ في تعْديلِ جدْوَلِهِ","حِيناً وإنْ كانَ معْدوداً منَ الشّجَرِ",4,"ر",1,0],["يا تُرى والنّفوسُ أسْرَى الأمانِي","ما لَها عنْ وَثاقِها منْ بَراحِ",5,"ح",1,0],["يا تاجَنا قَد أَتَتكَ مَسأَلَةٌ","فَاِكشِف لَنا ما بِها مِنَ اللَبسِ",6,"س",1,1],["يَأتي رِضاهُ مُعادِياً وَمُوالِياً","وَيَكونُ فيهِ مُعاقِباً وَمُثيبا",7,"ب",2,0],["يَأتينَهُ مُستَعصِماتٍ بِهِ","يُعلِنَّ في الدارِ بِدَعوى الأَليل",8,"ل",1,0],["يَا تِرْبَ عَصْرِكِ بِيتِي","فِي رَحْمَةِ المُتَعَالِي",9,"ي",1,1],["يا تارِكَ البَيتِ عَلى الضَيفِ","وَهارِباً مِنهُ مِنَ الخَوفِ",10,"ف",1,1],["يأتي بكل عجيبة","تدعو اللبيب إلى ارتيابه",11,"ب",2,0],["يأتيك بالمعنى الجميل قد اكتسى","من وشي سندس لفظه وحريره",12,"ر",2,0],["يا تَيمُ إِنَّ تَميماً لَن تَزيدَكُمُ","إِلّا الهَوانَ فَأَيَّ الخَيرِ تَبغونا",13,"ن",2,0],["يا تَيمُ إِنَّ بُيوتَكُم تَيمِيَّةٌ","قُفدُ العِمادِ قَصيرَةُ الأَطنابِ",14,"ب",1,0],["يا تَيمُ دَلوُكُمُ الَّتي يُدلى بِها","خَلَقُ الرِشاءِ ضَعيفَةُ الأَكرابِ",14,"ب",1,0],["يا تَيمُ ما خَطَبَ المُلوكُ بَناتِكُم","ريحُ الخَنافِسِ في مُسوكِ ضِبابِ",14,"ب",1,0],["يا تَيمُ إِنَّ وُجوهَكُم فَتَقَنَّعوا","طُبِعَت بِأَلأَمِ خاتَمٍ وَكِتابِ",14,"ب",1,0],["يا تَيمُ هاتوا مِثلَ أُسرَةِ قَعنَبٍ","أَو مِثلَ بَيتِ الحارِثِ بنِ شِهابِ",14,"ب",1,0],["يا تَيمُ تَيمَ عَدِيٍّ لا أَبا لَكُمُ","لا يوقِعَنَّكُمُ في سَوأَةٍ عُمَرُ",15,"ر",1,0],["يا تَيمُ إِنَّ جَسيمَ الأَمرِ لَيسَ لَكُم","وَلا الجَراثيمُ عِندَ الدَعوَةِ الكُبَرُ",15,"ر",1,0],["يا تَيمُ يا تَيمُ إِنَّ التَيمَ لَم يَرِثوا","بَيتاً كَريماً وَلا يَوماً إِذا اِفتَخَروا",15,"ر",3,0],["يا تَيمُ خالَطَ مَكحولٌ أَبا لَجَإٍ","ذا نُقبَةٍ قَد بَدا في لَونِهِ عَرَرُ",15,"ر",1,0],["يا تيمُ ما القارونَ في شِدَّةِ القِرى","بِتَيمٍ وَلا الحامونَ عِندَ الحَقائِقِ",16,"ق",1,1],["يا تَيمُ قَد طالَ إِنذاري عَلى طُرُقٍ","وَعِندَ زائِدَةَ الكَلبيِّ تَقديمي",17,"م",2,0],["يا تَيمُ وَيحَكَ مِن جَدعٍ لَهُ نَدَبٌ","يَبدو بِأَنفِكَ مِن ذُلٍّ وَتَرغيمِ",17,"م",1,0],["يا تَيمَ تَمضي عَليكُم كُلُّ مَظلِمَةٍ","عادَتِ مُعتَرِفٍ بِالذُلِّ مَظلومِ",17,"م",1,0],["يا تَيمُ إِنَّكَ عَبدٌ مِن بَني كُسعٍ","ما كُنتُ أَوَّلَ عَبدٍ ضَلَّ مَغتومِ",17,"م",1,0],["يا تَيمُ أُمُّكُمُ عَمياءُ مُقعَدَةٌ","جاءَت بِنَسلٍ خَبيثِ الريحِ مَجذومِ",17,"م",1,0],["يا تَيمُ لَو صَدَقَ الفَرَزدَقُ لَم يَعِب","في الجَريِ بُعدَ مَدايَ وَاِستِحدامي",18,"م",2,0],["يا تَيمُ ما أَحَدٌ بِأَلأَمَ مِنكُمُ","إِنَّ اللِئامَ عَلَيَّ غَيرُ كِرامِ",18,"م",1,0],["يا تَيمُ إِنَّ بَني تَميمٍ دافَعَت","عَنّي مَناكِبُهُم وَعَزَّ مَقامي",18,"م",2,0],["يا تَيمُ إِنَّ لِآلِ سَعدٍ عِندَكُم","نِعَماً فَكَيفَ جَزَيتَ بِالإِنعامِ",18,"م",1,0],["يا تارِكي إِنّي لِذِك","رِكَ ما حَيِيتُ لَغَيرُ تارِك",19,"ك",1,0],["يا تاليَ العذَلِ كتباً في لواحظه","السيفُ أصدقُ أنباءً من الكتب",20,"ب",1,0],["يا تاج دين الله والدنيا الذي","لاقت مكانته بفرق الفرقد",21,"د",1,0],["يا تاج دين الله كم نعمةٍ","لنعمةٍ بين الورى تتبع",22,"ع",1,1],["يا ترب كم من فُتورٍ قد نثرت بها","أعضاء حسن كمثل اللؤلؤ النسق",23,"ق",1,0],["يا تاركين للمحب أدمعاً","قد وقع الحزن له إطلاقها",24,"ق",3,1],["يأتي بنقطِ الخال في إعجام","وتارةً يأتي بمعنى اللام",25,"م",1,0],["يأتون من صلبِ فتىً ماجدٍ","لا كذَّب اللّه ولا خيبا",26,"ب",2,0],["يا تناهٍ والتناهي انقطاعُ","كن كما سماك مولىً لكاعُ",27,"ع",1,1],["يأتونَ لم يدعُهُم داعٍ سوى كمرٍ","لها حقائقُ أولاها الأباطيلُ",28,"ل",1,0],["يأتي القليلُ من الضئيلِ بحقّهِ","كيما يكونَ من الجزيل جزيلُ",29,"ل",1,0],["يَأتي المَساءُ عَلَيهِ وَهوَ مُكتَإِبٌ","وَيَرجِعُ اللَيلُ عَنهُ وَهوَ حَيرانُ",30,"ن",1,0],["يا تارِكي في حُبِّهِ","مَثَلاً مِنَ الأَمثالِ سائِر",31,"ر",1,0],["يَأتي بأَجْنِحَةِ السُّكُونِ","كأنَّهُ اللَّيلُ البَهيمْ",32,"م",1,0],["يأتي من العين التي هي كوة","للفكر نور تارة وظلام",33,"م",1,0],["يأتي الشقاء على البلاد وينقضى","وشقاء مصر مؤبد الآباد",34,"د",1,0],["يأتي النفوس فينضُو عن طبائعها","سترا ويهتك عن أهوالها الحجبا",35,"ب",2,0],["يا تارك البلاد","لأفسد الأولاد",36,"د",1,0],["يَأتونَ طيبَةَ بِالهَدِيِّ أَمامَهُم","يَغشى المَدائِنَ وَالقُرى وَيُطَبِّقُ",37,"ق",1,0],["يا تَغلِبَ اِبنَةَ وائِلٍ حَتّى مَتى","تَرِدونَ كُفراً موبِقاً وَمُروِقا",38,"ق",2,0],["يَأتي مُرَجّوهُ أَفواجاً لِنائِلِهِ","يَستَرشِدُ الفَوجُ بِالفَوجِ الَّذي إِقتَحَما",39,"م",2,0],["يا تغلبَ الغلباءِ طُلْتِ بِطَوْله","ونِجارِه قِممَ الكواكبِ فافْخري",40,"ر",2,0],["يأتيك عن فَهْمِ الثَّناء نوالُه","عفواً وتلك سَجِيَّةُ المستبصِرِ",41,"ر",1,0],["يا تاجِرَ الغَيِّ المُضِرَّ بِرُشدِهِ","حَتّى مَتى بِالغِيِّ 