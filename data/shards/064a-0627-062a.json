لكامل"],[451,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[456,"دع بين جِلدي والعظام مكانا","https://www.aldiwan.net/poem55851.html","الكامل"],[456,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[456,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[456,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[459,"من مبلغ سلف الأجواد إذ سبقوا","https://www.aldiwan.net/poem16058.html","البسيط"],[462,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[466,"يا تاركا عجل حالي","https://www.aldiwan.net/poem60048.html","المجتث"],[483,"إني أتتني لسان لا أسر بها","https://www.aldiwan.net/poem1121.html",""],[493,"يا تائها في لجة السكر","https://www.aldiwan.net/poem9882.html","السريع"],[498,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[498,"زر حيش لا تلو النياق لحاسا","https://www.aldiwan.net/poem37995.html","الكامل"],[525,"يا ترجمان الليالي عن معاذرها","https://www.aldiwan.net/poem45986.html","البسيط"],[527,"الله در فتى علا","https://www.aldiwan.net/poem37451.html","مجزوء الكامل"],[536,"يا ابن عبد الله يا من","https://www.aldiwan.net/poem47420.html","عموديه"],[536,"ضمنا مجلس يناديك أقبل","https://www.aldiwan.net/poem47599.html","عموديه"],[536,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[536,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[536,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[536,"آه إذ تعلو على متن جوا","https://www.aldiwan.net/poem48197.html","عموديه"],[536,"إن كان في كل أرض ما تشان به","https://www.aldiwan.net/poem48233.html","عموديه"],[538,"إني امرؤ من رعى عيني رعيت له","https://www.aldiwan.net/poem56645.html","الوافر"],[549,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[551,"استمطر العين أن أحبابه احتملوا","https://www.aldiwan.net/poem68393.html","البسيط"],[556,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"],[558,"من يعرف الشوق ؟","https://www.aldiwan.net/poem67275.html","عموديه"],[560,"قف بالديار وحي القوم عن كثب","https://www.aldiwan.net/poem52914.html","البسيط"],[562,"يأتي على الناس إصباح وامساء","https://www.aldiwan.net/poem822.html",""],[565,"قامر باللهو في هوى قمر","https://www.aldiwan.net/poem69678.html","السريع"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[571,"قف بربع الأسى وقوف الطليح","https://www.aldiwan.net/poem3652.html","الخفيف"],[573,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[573,"أصبحت بعدك في الحياة كفان","https://www.aldiwan.net/poem2773.html","الكامل"],[573,"رحلوا فلست مسائلاً عن دارهم","https://www.aldiwan.net/poem2861.html","الكامل"],[573,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[573,"أما الغرام بها فعاد كما بدا","https://www.aldiwan.net/poem3079.html","الكامل"],[585,"يا تاركاً لمراضي الله أوطاناً","https://www.aldiwan.net/poem11514.html","عموديه"]],"verses":[["يَأتي الحِمامُ فَيَنسى المَرءُ مُنيَتَهُ","وَأَعضَلُ الداءِ ما يُلهي عَنِ الأَمَلِ",0,"ل",1,0],["يا تَغلِبَ اِبنَةَ وائِلٍ ما لي أَرى","نَجمَيكِ قَد أَفَلا عَنِ النُظّارِ",1,"ر",1,0],["يَأتونَ مَكَّةَ عامِدينَ لِحَجِّهِم","وَيُخَلِّفونَكَ مَيِّتاً بِغَليلِ",2,"ل",1,0],["يَأتي الكِتابُ عَنِ الحَبي","بِ مُمَثَّلاً فيهِ ضَميرُه",3,"ر",2,0],["يأتي مع النّجْمِ في تعْديلِ جدْوَلِهِ","حِيناً وإنْ كانَ معْدوداً منَ الشّجَرِ",4,"ر",1,0],["يا تُرى والنّفوسُ أسْرَى الأمانِي","ما لَها عنْ وَثاقِها منْ بَراحِ",5,"ح",1,0],["يا تاجَنا قَد أَتَتكَ مَسأَلَةٌ","فَاِكشِف لَنا ما بِها مِنَ اللَبسِ",6,"س",1,1],["يَأتي رِضاهُ مُعادِياً وَمُوالِياً","وَيَكونُ فيهِ مُعاقِباً وَمُثيبا",7,"ب",2,0],["يَأتينَهُ مُستَعصِماتٍ بِهِ","يُعلِنَّ في الدارِ بِدَعوى الأَليل",8,"ل",1,0],["يَا تِرْبَ عَصْرِكِ بِيتِي","فِي رَحْمَةِ المُتَعَالِي",9,"ي",1,1],["يا تارِكَ البَيتِ عَلى الضَيفِ","وَهارِباً مِنهُ مِنَ الخَوفِ",10,"ف",1,1],["يأتي بكل عجيبة","تدعو اللبيب إلى ارتيابه",11,"ب",2,0],["يأتيك بالمعنى الجميل قد اكتسى","من وشي سندس لفظه وحريره",12,"ر",2,0],["يا تَيمُ إِنَّ تَميماً لَن تَزيدَكُمُ","إِلّا الهَوانَ فَأَيَّ الخَيرِ تَبغونا",13,"ن",2,0],["يا تَيمُ إِنَّ بُيوتَكُم تَيمِيَّةٌ","قُفدُ العِمادِ قَصيرَةُ الأَطنابِ",14,"ب",1,0],["يا تَيمُ دَلوُكُمُ الَّتي يُدلى بِها","خَلَقُ الرِشاءِ ضَعيفَةُ الأَكرابِ",14,"ب",1,0],["يا تَيمُ ما خَطَبَ المُلوكُ بَناتِكُم","ريحُ الخَنافِسِ في مُسوكِ ضِبابِ",14,"ب",1,0],["يا تَيمُ إِنَّ وُجوهَكُم فَتَقَنَّعوا","طُبِعَت بِأَلأَمِ خاتَمٍ وَكِتابِ",14,"ب",1,0],["يا تَيمُ هاتوا مِثلَ أُسرَةِ قَعنَبٍ","أَو مِثلَ بَيتِ الحارِثِ بنِ شِهابِ",14,"ب",1,0],["يا تَيمُ تَيمَ عَدِيٍّ لا أَبا لَكُمُ","لا يوقِعَنَّكُمُ في سَوأَةٍ عُمَرُ",15,"ر",1,0],["يا تَيمُ إِنَّ جَسيمَ الأَمرِ لَيسَ لَكُم","وَلا الجَراثيمُ عِندَ الدَعوَةِ الكُبَرُ",15,"ر",1,0],["يا تَيمُ يا تَيمُ إِنَّ التَيمَ لَم يَرِثوا","بَيتاً كَريماً وَلا يَوماً إِذا اِفتَخَروا",15,"ر",3,0],["يا تَيمُ خالَطَ مَكحولٌ أَبا لَجَإٍ","ذا نُقبَةٍ قَد بَدا في لَونِهِ عَرَرُ",15,"ر",1,0],["يا تيمُ ما القارونَ في شِدَّةِ القِرى","بِتَيمٍ وَلا الحامونَ عِندَ الحَقائِقِ",16,"ق",1,1],["يا تَيمُ قَد طالَ إِنذاري عَلى طُرُقٍ","وَعِندَ زائِدَةَ الكَلبيِّ تَقديمي",17,"م",2,0],["يا تَيمُ وَيحَكَ مِن جَدعٍ لَهُ نَدَبٌ","يَبدو بِأَنفِكَ مِن ذُلٍّ وَتَرغيمِ",17,"م",1,0],["يا تَيمَ تَمضي عَليكُم كُلُّ مَظلِمَةٍ","عادَتِ مُعتَرِفٍ بِالذُلِّ مَظلومِ",17,"م",1,0],["يا تَيمُ إِنَّكَ عَبدٌ مِن بَني كُسعٍ","ما كُنتُ أَوَّلَ عَبدٍ ضَلَّ مَغتومِ",17,"م",1,0],["يا تَيمُ أُمُّكُمُ عَمياءُ مُقعَدَةٌ","جاءَت بِنَسلٍ خَبيثِ الريحِ مَجذومِ",17,"م",1,0],["يا تَيمُ لَو صَدَقَ الفَرَزدَقُ لَم يَعِب","في الجَريِ بُعدَ مَدايَ وَاِستِحدامي",18,"م",2,0],["يا تَيمُ ما أَحَدٌ بِأَلأَمَ مِنكُمُ","إِنَّ اللِئامَ عَلَيَّ غَيرُ كِرامِ",18,"م",1,0],["يا تَيمُ إِنَّ بَني تَميمٍ دافَعَت","عَنّي مَناكِبُهُم وَعَزَّ مَقامي",18,"م",2,0],["يا تَيمُ إِنَّ لِآلِ سَعدٍ عِندَكُم","نِعَماً فَكَيفَ جَزَيتَ بِالإِنعامِ",18,"م",1,0],["يا تارِكي إِنّي لِذِك","رِكَ ما حَيِيتُ لَغَيرُ تارِك",19,"ك",1,0],["يا تاليَ العذَلِ كتباً في لواحظه","السيفُ أصدقُ أنباءً من الكتب",20,"ب",1,0],["يا تاج دين الله والدنيا الذي","لاقت مكانته بفرق الفرقد",21,"د",1,0],["يا تاج دين الله كم نعمةٍ","لنعمةٍ بين الورى تتبع",22,"ع",1,1],["يا ترب كم من فُتورٍ قد نثرت بها","أعضاء حسن كمثل اللؤلؤ النسق",23,"ق",1,0],["يا تاركين للمحب أدمعاً","قد وقع الحزن له إطلاقها",24,"ق",3,1],["يأتي بنقطِ الخال في إعجام","وتارةً يأتي بمعنى اللام",25,"م",1,0],["يأتون من صلبِ فتىً ماجدٍ","لا كذَّب اللّه ولا خيبا",26,"ب",2,0],["يا تناهٍ والتناهي انقطاعُ","كن كما سماك مولىً لكاعُ",27,"ع",1,1],["يأتونَ لم يدعُهُم داعٍ سوى كمرٍ","لها حقائقُ أولاها الأباطيلُ",28,"ل",1,0],["يأتي القليلُ من الضئيلِ بحقّهِ","كيما يكونَ من الجزيل جزيلُ",29,"ل",1,0],["يَأتي المَساءُ عَلَيهِ وَهوَ مُكتَإِبٌ","وَيَرجِعُ اللَيلُ عَنهُ وَهوَ حَيرانُ",30,"ن",1,0],["يا تارِكي في حُبِّهِ","مَثَلاً مِنَ الأَمثالِ سائِر",31,"ر",1,0],["يَأتي بأَجْنِحَةِ السُّكُونِ","كأنَّهُ اللَّيلُ البَهيمْ",32,"م",1,0],["يأتي من العين التي هي كوة","للفكر نور تارة وظلام",33,"م",1,0],["يأتي الشقاء على البلاد وينقضى","وشقاء مصر مؤبد الآباد",34,"د",1,0],["يأتي النفوس فينضُو عن طبائعها","سترا ويهتك عن أهوالها الحجبا",35,"ب",2,0],["يا تارك البلاد","لأفسد الأولاد",36,"د",1,0],["يَأتونَ طيبَةَ بِالهَدِيِّ أَمامَهُم","يَغشى المَدائِنَ وَالقُرى وَيُطَبِّقُ",37,"ق",1,0],["يا تَغلِبَ اِبنَةَ وائِلٍ حَتّى مَتى","تَرِدونَ كُفراً موبِقاً وَمُروِقا",38,"ق",2,0],["يَأتي مُرَجّوهُ أَفواجاً لِنائِلِهِ","يَستَرشِدُ الفَوجُ بِالفَوجِ الَّذي إِقتَحَما",39,"م",2,0],["يا تغلبَ الغلباءِ طُلْتِ بِطَوْله","ونِجارِه قِممَ الكواكبِ فافْخري",40,"ر",2,0],["يأتيك عن فَهْمِ الثَّناء نوالُه","عفواً وتلك سَجِيَّةُ المستبصِرِ",41,"ر",1,0],["يا تاجِرَ الغَيِّ المُضِرَّ بِرُشدِهِ","حَتّى مَتى بِالغِيِّ أَنتَ تُغالي",42,"ل",2,0],["يا تاركي حيثُ كان مجلسُنا","وحيث غنَّاكَ قلبيَ الغَرِدُ",43,"د",1,0],["يا توأما من صدري انتزعا","يا من دعا قلبي له فسعى",44,"ع",2,0],["يا تاركاً راحاً تُسَلّي هَمّهُ","هلّا اتّقَيْتَ السّمَّ بالدُّرياقِ",45,"ق",1,1],["يا تاجراً في العلمِ لا","في الملهياتِ ولا القماشْ",46,"ش",1,1