{"poems":[[74,"بشراك إن السرى والعود مبرور","https://www.aldiwan.net/poem18707.html","البسيط"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[354,"لما دعاني الهوى من ربة الكلل","https://www.aldiwan.net/poem15862.html","البسيط"],[458,"تنادينا بنكهتها فهيا","https://www.aldiwan.net/poem61298.html","الوافر"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79414","المنسرح"],[1893,"","https://poetry.dctabudhabi.ae/diwan/poem/146604","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139247","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120361","الوافر"],[5953,"ألا يا رجال الحق بالحق أبشروا","https://www.poetsgate.com/ViewPoem.aspx?id=93852",""]],"verses":[["وفي اقْتحامِ الوغى رمحٌ يلوحُ له","على عِدا الملك كعب فيه تدوير",0,"ر",1,0],["وَفي اِقتِرابِ ساعَةِ الشَمسِ بِشَخ","صِ سينِها بِقَيسِها اِنشَقَّ القَمَر",1,"ر",1,0],["وَفي اِقتِرابي لَها مِنها سَمِعتُ نِدا","عَن جانِبِيَّ وَمِن خَلفي وَمِن قُبَلي",2,"ي",1,0],["وفي أقداحها حب بريء","كحب الطفل يمرح مستحيا",3,"ي",2,0],["وفي اقترانِ العينِ ما فيه من","إشراقِ وجهِ العُلى ونضْرَتِهِ",4,"ت",2,0],["وفي اقطار همته اتساع","ولكن ضاق من دوني نطاقه",5,"ق",2,0],["وَفي اِقتِسامِ الكَسبِ نيلا أَفرَزا","قَطيعِ أَبقارٍ لَهُ وَأَحرَزا",6,"ز",2,0],["وفي اقتلوا أو اخرجوا شاهدٌ","ساوى خروج المرء مع مقتله",7,"ل",2,0],["وفي اقصى البلاد له ثناء","الذ من الغبوق او الصبوح",8,"ح",1,0],["وفي اقتراب الساعة الوحي ناطق","بتفويض أمر الله والأمر صائر",9,"ر",1,0]]}