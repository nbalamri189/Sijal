{"poems":[[53,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[87,"يا مكس دنياك عاره","https://www.aldiwan.net/poem7115.html","المجتث"],[87,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[107,"من لي بملء المشرقين بيانا","https://www.aldiwan.net/poem41940.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54762","الكامل"],[119,"مهيجة ذات وجد","https://www.aldiwan.net/poem40625.html","عموديه"],[154,"يا مكثرا قاله وقيله","https://www.aldiwan.net/poem68530.html","مخلع البسيط"],[240,"جد بقلبي ومزح","https://www.aldiwan.net/poem32108.html","مجزوء الرجز"],[310,"يا منعما قبل السؤال على الورى","https://www.aldiwan.net/poem56533.html","الكامل"],[358,"يا مكثر الهجر خوفا من مراقبه","https://www.aldiwan.net/poem40564.html","البسيط"],[369,"سل صدور الركاب ماذا الحنين","https://www.aldiwan.net/poem60627.html","الخفيف"],[385,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[563,"أنا الوجود وكل الخلق أفعالي","https://www.aldiwan.net/poem34204.html","المواليا"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138377",""],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130150","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48728","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120078","السريع"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216839",""],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113793","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93850","الكامل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145059","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33719","الخفيف"],[4978,"ها أنت تأتي على خيل من البرقِ","https://www.poetsgate.com/ViewPoem.aspx?id=177190",""],[5411,"وِشِايَةَ الظِّلِّ","https://www.poetsgate.com/ViewPoem.aspx?id=198452",""],[5792,"ابوس راسك يا زمن","https://www.poetsgate.com/ViewPoem.aspx?id=180343",""],[5794,"صباح الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=80279",""],[5956,"حتى ولو نلت التقاعد لم تزل","https://www.poetsgate.com/ViewPoem.aspx?id=194828",""]],"verses":[["يا مكذِباً ليَ في دعواي شكَّكه","أن فتَّر الدمعُ وبلاً منه وكّافا",0,"ف",2,0],["يا مكس دنياك عاره","والموت كأس مداره",1,"ر",2,1],["يا مكس قل لي أحق","قد وسّدوك الحجارة",1,"ر",2,0],["يا مكس عشت نقيا","ومت خِذن طهاره",1,"ر",2,0],["يا مَكتَبي قَبلَ الشَبابِ وَمَلعَبي","وَمَقيلَ أَيّامِ الشَبابِ النوكِ",2,"ك",1,0],["يا مُكرِمَ الأدبِ الرّفيعِ فَجعتَهُ","وتَركتَهُ في خَاطِري أشجانا",3,"ن",2,0],["يَا مُكْرِمِينَ اليَوْمَ ذِكْرَى يُوسُفَ","جَمَعَ الذَّوَائِبَ يَوْمُهُ الْمَشْهُودُ",4,"د",1,0],["يا مكثرا بالتجني","اطغاك هذا الجمال",5,"ل",1,0],["يا مكثراً قاله وقيله","وجاعلاً كأسه فضيله",6,"ل",2,1],["يا مُكرِمَ الشِعرِ وَقَد","كانَ مَهيناً مُطَّرَح",7,"ح",1,0],["يا مُكرماً لِعبادهِ بثوابهِ","يا آمراً للمُبتلى أَن يَصبرا",8,"ر",2,0],["يا مُكثِرَ الهَجر خَوفاً مِن مراقبه","وَراشِقي أَسهُماً عَن قَوس حاجِبهِ",9,"ه",1,1],["يا مَكينَ الملوكِ دَعوةَ مَنْ كا","نَ له عندهُ مَكَانٌ مكين",10,"ن",1,0],["يا مُكثِراً مِن ذَم كُل ذَميم","أَبدأ بِنَفسِكَ قَبل كُل مَلومِ",11,"م",1,1],["يا مكثرَ اللومِ في تقبيح أعمالي","شيطان أرسلَكَ الرحمنُ أعمى لي",12,"ي",1,0],["يا مكرم المفضال كم لك خطبة","رنت مثانيها بأذن تفهم",13,"م",1,0],["يا مكثر الهجر والتجني","ويك حبيبي دعني أشاهد",14,"د",1,0],["يا مكبرين محمداً سيروا على","آثاره إن الطريق ممهد",15,"د",1,0],["يا مكرم الضيف ويا من له","عزيمة كالسيف مرهوفَه",16,"ف",2,0],["يا مكابِر الشِّيخان في ما بِدا له","يا مِشبِع الجايِع وكاسِي العَريان",17,"ن",1,0],["يا مَكَّةَ اللَهِ قد مَكَّنتِ لي حَرَماً","مُؤمَّناً لستُ أشكو فيه من داءِ",18,"د",3,0],["يا مكثر الدوران قف","وأرج الجناب الداوريا",19,"ي",2,1],["يا مك واسمك خير أسماء القرى","عند الندا وألذها ترخيما",20,"م",2,0],["يا مكانَ الهَوى خلوتَ من الصب","رِ فما للسلوِّ فيكَ نصيبُ",21,"ب",1,0],[".يا مكمن الخوف في قلبي وروعته","يا حدّ دنياي من غربٍ إلى شرقِ",22,"ق",1,0],["يا مَكْمَن السِّرِّ مااسْتَخْفَى عَلَى قَمَرٍي","وِشِايَةَ الظِّلِّ لَمَّا اْمْتَدَّ تَغْريضا",23,"ض",2,1],["يا مكثر ذنوبك معي ما كل ذنب لك يباح","لامن زعلت وش تستفيد وش مكسبك من ذا الحزن",24,"ن",1,0],["يامكثره صبره تعلى على الموت","يا قوته والسر ذاته رقيقه",25,"ق",2,0],["يا مَكْسَباً للبنك في تدعيمهِ","بمهارةٍ في الأوج طِبْتَ مدارِكا..",26,"ك",2,1]]}