{"poems":[[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[85,"يا مكس دنياك عاره","https://www.aldiwan.net/poem7115.html","المجتث"],[85,"جهد الصبابة ما أكابد فيك","https://www.aldiwan.net/poem63701.html","الكامل"],[105,"من لي بملء المشرقين بيانا","https://www.aldiwan.net/poem41940.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54762","الكامل"],[115,"مهيجة ذات وجد","https://www.aldiwan.net/poem40625.html","عموديه"],[150,"يا مكثرا قاله وقيله","https://www.aldiwan.net/poem68530.html","مخلع البسيط"],[235,"جد بقلبي ومزح","https://www.aldiwan.net/poem32108.html","مجزوء الرجز"],[305,"يا منعما قبل السؤال على الورى","https://www.aldiwan.net/poem56533.html","الكامل"],[353,"يا مكثر الهجر خوفا من مراقبه","https://www.aldiwan.net/poem40564.html","البسيط"],[364,"سل صدور الركاب ماذا الحنين","https://www.aldiwan.net/poem60627.html","الخفيف"],[380,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[558,"أنا الوجود وكل الخلق أفعالي","https://www.aldiwan.net/poem34204.html","المواليا"]],"verses":[["يا مكذِباً ليَ في دعواي شكَّكه","أن فتَّر الدمعُ وبلاً منه وكّافا",0,"ف",2,0],["يا مكس دنياك عاره","والموت كأس مداره",1,"ر",2,1],["يا مكس قل لي أحق","قد وسّدوك الحجارة",1,"ر",2,0],["يا مكس عشت نقيا","ومت خِذن طهاره",1,"ر",2,0],["يا مَكتَبي قَبلَ الشَبابِ وَمَلعَبي","وَمَقيلَ أَيّامِ الشَبابِ النوكِ",2,"ك",1,0],["يا مُكرِمَ الأدبِ الرّفيعِ فَجعتَهُ","وتَركتَهُ في خَاطِري أشجانا",3,"ن",2,0],["يَا مُكْرِمِينَ اليَوْمَ ذِكْرَى يُوسُفَ","جَمَعَ الذَّوَائِبَ يَوْمُهُ الْمَشْهُودُ",4,"د",1,0],["يا مكثرا بالتجني","اطغاك هذا الجمال",5,"ل",1,0],["يا مكثراً قاله وقيله","وجاعلاً كأسه فضيله",6,"ل",2,1],["يا مُكرِمَ الشِعرِ وَقَد","كانَ مَهيناً مُطَّرَح",7,"ح",1,0],["يا مُكرماً لِعبادهِ بثوابهِ","يا آمراً للمُبتلى أَن يَصبرا",8,"ر",2,0],["يا مُكثِرَ الهَجر خَوفاً مِن مراقبه","وَراشِقي أَسهُماً عَن قَوس حاجِبهِ",9,"ه",1,1],["يا مَكينَ الملوكِ دَعوةَ مَنْ كا","نَ له عندهُ مَكَانٌ مكين",10,"ن",1,0],["يا مُكثِراً مِن ذَم كُل ذَميم","أَبدأ بِنَفسِكَ قَبل كُل مَلومِ",11,"م",1,1],["يا مكثرَ اللومِ في تقبيح أعمالي","شيطان أرسلَكَ الرحمنُ أعمى لي",12,"ي",1,0]]}