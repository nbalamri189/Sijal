{"poems":[[53,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[45,"ضيف ألم برأسي غير محتشم","https://www.aldiwan.net/poem10532.html","البسيط"],[51,"خانك الطرف الطموح","https://www.aldiwan.net/poem62028.html","مجزوء الرمل"],[107,"يهين رجال في الحياة نفوسهم","https://www.aldiwan.net/poem43134.html","الطويل"],[107,"ثقيف اجمعي للات ما شئت من عزم","https://www.aldiwan.net/poem43571.html","الطويل"],[77,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[119,"تعودت يا قلبي هموما ثقيلة","https://www.aldiwan.net/poem41178.html","عموديه"],[164,"سماط ما أراه أم مناخ","https://www.aldiwan.net/poem58912.html","الوافر"],[173,"إلى م أورد عتباً غير مستمع","https://www.aldiwan.net/poem1637.html",""],[228,"لقد بلغت بهم الحده","https://www.aldiwan.net/poem41900.html","المتقارب"],[234,"شرى البرق فالتاع الفؤاد المعذب","https://www.aldiwan.net/poem51254.html","الطويل"],[333,"ابن عمي مات فامضوا","https://www.aldiwan.net/poem54961.html","مجزوء الرمل"],[458,"أين ابتسامك يا حبيبي","https://www.aldiwan.net/poem61716.html","مجزوء الكامل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66969","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48738","الكامل"],[944,"","https://poetry.dctabudhabi.ae/diwan/poem/51569","البسيط"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67846","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69439","الطويل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76803","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93649","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93787","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89208","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120528","الوافر"],[4691,"(ثرثري ثم ثرثري)","https://www.poetsgate.com/ViewPoem.aspx?id=61715",""],[5351,"القادم أولاً وثانياً","https://www.poetsgate.com/ViewPoem.aspx?id=202236",""],[5363,"أتراه يخون","https://www.poetsgate.com/ViewPoem.aspx?id=144149",""],[5449,"موسوعةُ الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=188935",""],[5701,"هنيئا لإبراهيم نادية التي","https://www.poetsgate.com/ViewPoem.aspx?id=164708",""],[5885,"نتقاتل","https://www.poetsgate.com/ViewPoem.aspx?id=194800",""],[5956,"سيمضي شتائي","https://www.poetsgate.com/ViewPoem.aspx?id=183974",""],[5956,"الوسواس الخناس يحطِّم كبارَ الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192093",""],[5956,"الغبي بوش","https://www.poetsgate.com/ViewPoem.aspx?id=192356",""],[6212,"صوت القادم من سواد الأسئلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1628&r=&rc=9",""],[5190,"عودة بلفور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78348&r=&rc=61",""]],"verses":[["سيصنعُ اللَّهُ لنا في غدٍ","إن كان أكْدَى يومُنا الخائبُ",0,"ب",1,0],["سَيَصحَبُ النَصلُ مِنّي مِثلَ مَضرِبِهِ","وَيَنجَلي خَبَري عَن صِمَّةِ الصِمَمِ",1,"م",1,0],["سَيَصيرُ المَرءُ يَوماً","جَسَداً ما فيهِ روحُ",2,"ح",1,0],["سَيُصبِحُ مُلكُ التُركِ بَعدَ هُنَيهَةٍ","رَفيعَ الذُرى ما يُستَباحُ لَهُ حِمى",3,"م",2,0],["سَيُصلِيهِ ناراً يُنضِجُ الجلدَ حَرُّها","ويَذهبُ يومَ الدّينِ باللّحمِ والعظمِ",4,"م",1,0],["سيَصِيرُ بعدَك للأئِمّةِ سُنّةً","في الشكر ليس لمثلها تحويل",5,"ل",1,0],["سيصرف ما عانيت مولاك محسنا","ويتحف بالفضل العظيم ويمنح",6,"ح",1,0],["سيصطرخون والاسياف فيهم","تعاور حين لا يغنى اصطراخ",7,"خ",1,0],["سَيَصحَبُ الدَهرَ مِنّي ماجِدٌ نَجِدٌ","لَو داسَ عِرنِينَ أَنفِ المَوتِ لَم يُرَعِ",8,"ع",1,0],["سَيَصفَحُ عَن كُلِّ أَشواكِكُم","فَشوكَتُكُم عِندَهُ وَردَه",9,"د",2,0],["سَيصْحَبُ نَصْلِي من يُرى مثلَ حَدّه","ويَحْمَد صحبي شيمتي حين أَصْحَب",10,"ب",1,0],["سيصلّوا على روحي","ويبكون فراقي",11,"ي",1,0],["سيصونُه سمعُ الزما","نِ وجائلُ النسَّمِ الرَّطيبِ",12,"ب",1,0],["سَيُصبحُ سِرِّي كالصَّباحِ مُشَهَّراً","ويُمْسِي حَدِيثِي عُرْضَةَ المُتَحَدِّثِ",13,"ث",1,0],["سيصير للتيجان تاجك زينة","ويصير شعبك للشعوب إماما",14,"م",2,0],["سيُصبحُ القومُ من سيفي وضارِبِهِ","مثلَ الهشيم ذَرَته الريحُ بالمطَرِ",15,"ر",1,0],["سَيَصْلى سَعِيراً لاَ يَمُوتُ وَلاَ يَحْيَا","تَرَقى بِهِ جِبْرِيلُ نَحْوَ حَبِيبِهِ",16,"ه",1,0],["سَيَصلى بِنارِ الحُزنِ مَن كانَ آمِناً","بِهِ أَنَّهُ في الحَشرِ بِالنارِ لا يَصلى",17,"ل",2,0],["سيصلح رب العالمين به الورى","على فرقة منهم وعظم تبدد",18,"د",1,0],["سَيصفق كَفيه الَّذي باعَ صحبتي","كَما صفق المَغبون حينَ يَبيع",19,"ع",1,0],["سيصلى بها حر السعير معذباً","بتابوت نار في الحجيم به زجا",20,"ج",2,0],["سيصبح يمشي في الطريق مهرولاً","ولم يخش موسى أن قدامه عيسى",21,"س",2,0],["سيصبح من ذيَّاك يقرع سنه","ومن يرجُ ماءً من يد الآل ينعم",22,"م",1,0],["سيصلى من مدافع جيش مصر","وربك ما يفوق صلى جمر",23,"ر",1,0],["سيصير ُ الصَغِيْرُ","بارا ً كجند ٍ وعسْكَر",24,"ر",1,0],["سيصيرُ القتلى أرتالٌ","والشعب سيتبعهُ المقتل",25,"ل",1,0],["سيصارحها ويقول لها","ماذا يطوي بحقيبتهِ",26,"ت",2,0],["سيصيرُ يوماً تمرُها نارَ اللَّظى","يشوي وجوهَ السَّارقينِ هوائي",27,"ا",2,0],["سيصبح عبد الله جدا مباركا","لخير بنين حوله وبنات",28,"ت",1,0],["سَيَصْبِرُ حَتَّى المَوْتِ لا تَتَحَرَّكُوا","وَرَبِّي لَقَدْ أَوْدَى لَدَيْهِ التَّفَاؤُلُ",29,"ل",1,0],["سيصْدَحُ نهري ويُزْهِرُ شِعري","وأهدي ثماري إلى الغارمينْ",30,"ن",1,0],["سيُصلح أمرَك ربُّ العباد","ويُرجع زوجَك روحاً وديعا",31,"ع",2,0],["سيصدّر بوشٌ أخلاقاً","من أسوإ ما طرْفُكَ لاقى",32,"ق",2,1],["سيصدِّر حمماً ضاربةً","في العمقِ ولا تترك ساقا",32,"ق",2,0],["سيصدِّر صاروخاً ألِقاً","سيحيل الأطفال رِقاقا",32,"ق",2,0],["سيصدّر آلات عظمى","لا تترك شاماً وعراقا",32,"ق",2,0],["سيصول الوقتُ منها ملأهُ","سيردّ الخيل إصباح القتامْ",33,"م",1,0],["سيصبُّ في عينيك جامَ عذابِهِ","ربُّ الورى كلٌ يدينُ لأمرِهِ",34,"ر",2,0]]}