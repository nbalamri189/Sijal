{"poems":[[79,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[226,"قطع الدهر حبال الأمل","https://www.aldiwan.net/poem55298.html","الرمل"],[385,"قلب يحبك مولع","https://www.aldiwan.net/poem48747.html","مجزوء الكامل"],[406,"نقش على جدار الوطن","https://www.aldiwan.net/poem6788.html","عموديه"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38756","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100405","المديد"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71298","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108385",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91298","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85194","الخفيف"],[4859,"لكن قلبي خانني!","https://www.poetsgate.com/ViewPoem.aspx?id=208130",""]],"verses":[["ولظِلّهِ المَوْرودِ غَمْرُ قَليبِه","لا يقْتَضي ورْداً ولا تعْريسا",0,"س",2,0],["ولظى بالقلب لولا أدمعي","صار جسمي منه كالمشتعل",1,"ل",1,0],["وَلِظَرفِهِ وَحَديثِهِ","في كُل قَلب موقع",2,"ع",1,0],["ولظل يرفع صوته متمثلا","بالحكمة الغراء والقول الحسن",3,"ن",1,0],["وَلَظى الغَرامِ بِقَلبِهِ","إِذ شَبَّها إِفراطُ طَردِك",4,"ك",1,0],["ولظني قبل ثالثةٍ","قرَب الانضاء يقترن",5,"ن",1,0],["وَلِظَبْي الحِمَى إشَارَةُ وَجْدِي","حِينَ أُكْنى عَنْ ظَبْيةِ الوَعْسَاءِ",6,"ا",2,0],["ولظى الحسن قد زكت وحشى العشَّ","اق يوقدن بالصبابة وقدا",7,"د",2,0],["وَلظى اشتياقٍ لَم يَزل متحكِّماً","وَشجونَ وَجدٍ بِالفؤاد تَمكّنا",8,"ن",2,0],["ولظى خده حكت نار قلبي","حمرة والجفون تحكي اعتلاله",9,"ل",2,0],["ولظى تناهيدٍ كوتْ","من حرّ مابي الأضلعا",10,"ع",2,0]]}