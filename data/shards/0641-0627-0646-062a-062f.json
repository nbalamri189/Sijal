{"poems":[[59,"وعين الرضا عن كل عيب كليلة","https://www.aldiwan.net/poem24610.html","الطويل"],[0,"تطاول ليلك بالأثمد","https://www.aldiwan.net/poem81.html","المتقارب"],[90,"لا يبلغ المرء منتهى أربه","https://www.aldiwan.net/poem45001.html","المنسرح"],[29,"لجت أمامة في لومي وما علمت","https://www.aldiwan.net/poem5769.html","البسيط"],[29,"أمن عهد ذي عهد تفيض مدامع","https://www.aldiwan.net/poem5971.html","الطويل"],[4,"أتيناك يا خير البرية كلها","https://www.aldiwan.net/poem21192.html","الطويل"],[31,"بنو أسد رجلان رجل تذبذبت","https://www.aldiwan.net/poem6071.html","الطويل"],[31,"ألا يا لقوم للتنائي وللهجر","https://www.aldiwan.net/poem6168.html","الطويل"],[47,"أخا علة سار الإخاء فأوضعا","https://www.aldiwan.net/poem64695.html","الطويل"],[63,"قليل لها أن يتبع الدمع غيرها","https://www.aldiwan.net/poem51683.html","الطويل"],[2,"عفا من آل فاطمة الجواء","https://www.aldiwan.net/poem25055.html","الوافر"],[108,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[124,"ألومك لو أرى لو ميك يجدي","https://www.aldiwan.net/poem49307.html","الوافر"],[135,"يا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem24176.html","الطويل"],[147,"ما نرى للثناء عنك عدولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[208,"للعيد أوعدني من لم يزل عيدا","https://www.aldiwan.net/poem53320.html","البسيط"],[234,"وشادن شرط الصبا مرهف","https://www.aldiwan.net/poem51273.html","السريع"],[358,"لولا العذار ولولا طرفك الساجي","https://www.aldiwan.net/poem40547.html","البسيط"],[382,"فإن تدمن أخي أكلا وشربا","https://www.aldiwan.net/poem59254.html","الوافر"],[382,"أيا أغنياء الروح صونوا كنوزَكم","https://www.aldiwan.net/poem59426.html","الطويل"],[471,"سقى دمنتين ليس لي بهم عهد","https://www.aldiwan.net/poem50453.html","الطويل"],[473,"يا من به عاش ميت ذكرى","https://www.aldiwan.net/poem60089.html","مخلع البسيط"],[509,"سروري وذوقي من جمالك صادر","https://www.aldiwan.net/poem38406.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18519","الطويل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95384","الرمل"],[2149,"","https://poetry.dctabudhabi.ae/diwan/poem/115177","الوافر"],[2395,"","https://poetry.dctabudhabi.ae/diwan/poem/101401","الرمل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[3411,"","https://poetry.dctabudhabi.ae/diwan/poem/79747","الوافر"],[3499,"","https://poetry.dctabudhabi.ae/diwan/poem/26584","الطويل"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130435","الطويل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202341","الطويل"],[4927,"لُجَّةُ الأَحْزَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=29830",""],[4978,"تشطير أغنية حب","https://www.poetsgate.com/ViewPoem.aspx?id=177264",""],[5186,"أي متى كنت مغرما بالملاح؟","https://www.poetsgate.com/ViewPoem.aspx?id=156552",""],[5271,"أُريدكِ سيلا !!","https://www.poetsgate.com/ViewPoem.aspx?id=59743",""],[5302,"ما أعذب العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200599",""]],"verses":[["فَإِن تَدنُ مِنّي تَدنُ مِنكَ مَوَدَّتي","وَإِن تَنأَ عَنّي تَلقَني عَنكَ نائِيا",0,"ي",2,0],["فَإِن تَدفُنوا الداءَ لا نُخفِهِ","وَإِن تَبعَثوا الحَربَ لا نَقعُدِ",1,"د",1,0],["فأنتدِب العلم للخطوب فما","خاب لعمِري رجاء منتدِبه",2,"ب",2,0],["فَإِن تَدَعهُم فَمَن يَرجونَ بَعدَكُمُ","أَو تُنجِ مِنها فَقَد أَنجَيتَ مِن ضَرَرِ",3,"ر",1,0],["فَإِن تَدَّعوا لِلزِبرِقانِ فَإِنَّكُم","بَنو بِنتِ قَينٍ ذي عَلاةٍ وَمِرجَلِ",4,"ل",1,0],["فَإِن تَدعُ بِالسُقيا وَبِالعَفوِ تُرسِلِ ال","سَماءُ لَنا وَالأَمرُ يَبقى عَلى الأَصلِ",5,"ل",1,0],["فَإِن تَدعُ سَعداً لا يُجِبكَ وَدونَها","لُجَيمُ بنُ صَعبٍ وَالحُلولُ الكَراكِرُ",6,"ر",1,0],["فَإِن تَدعُ قَيساً يا دَعِيَّ مُحارِبٍ","فَقَد أَصبَحَت أَفناءُ قَيسٍ عَلى دُبرِ",7,"ر",1,0],["فَإِن تَدعُني لِلشَرِّ أُسرِع وَإِن تُهِب","بِصُلحي فَقَد أَبقَيتُ لِلصُلحِ مَوضِعا",8,"ع",2,0],["فإنْ تُدْعَ دونَ الأولياء لِنُصْرَةٍ","عَليَّ بنَ عبدِ اللهِ تُدْعَ نصيرَها",9,"ر",3,0],["فَإِن تَدعوا السَواءَ فَلَيسَ بَيني","وَبَينَكُمُ بَني حِصنٍ بَقاءُ",10,"ا",2,0],["فإن تدفنا ذنبي معي، فلرُّبما","عفا الله عمّن كان للعَفْو راجيا",11,"ي",2,0],["فإن تدركه لا يهلك ويحيا","وإلّا لا ملام ولا عتابا",12,"ب",2,0],["فَإِن تُدبِروا يَأخُذنَكُم في ظُهورِكُم","وَإِن تُقبِلوا يَأخُذنَكُم بِالتَرائِبِ",13,"ب",1,0],["فَاِنتَدِب لِلرُبدِ الَّتي تُنكِرُ التَه","ليلَ أُسداً لا تَعرِفُ التَهليلا",14,"ل",2,0],["فأنت دهرَك في صوم العفاف لهم","ودهرهم فرح قد صار تعييدا",15,"د",2,0],["فإن تُدَاخِلْكَ بنا ظِنّةٌ","فقد عَلى رغْمِك نِكْناه",16,"ن",3,0],["فَأَنتَ دُرّة عقد الحسن في شَرف","يَزين مَعناك لا بَل دُرّة التاجِ",17,"ج",1,0],["فإن تُدمِنْ أخي أكلاً وشُرباً","فلا تلهجْ بتفسير الكلامِ",18,"م",1,1],["فإن تدعها يوماً يجبك حنوُّها","أنا يُسرُ من يدعو بمريمَ في العسر",19,"ر",1,0],["فَإِن تَدَعي نَجدا نَدَعهُ وَمِن بِهِ","وَإِن تَسكُني نَجدا فَيا حَبَّذا نَجدُ",20,"د",1,0],["فَإِن تَدارَكَتني بِراحٍ","تُريحُني مِن عَذابِ سِرّي",21,"ر",2,0],["فأنت دليل الحايرين فكن له","معينا شفيعاً ان ربك غافر",22,"ر",1,0],["فانتدبت من النساء قائلة","إليه بالحجة وهي طائلة",23,"ه",1,0],["فَإِن تَدعُنا مِن بَعدِها لِكَريهِةٍ","نَدَعكَ فَريداً في الخَلا المُتَوحِّشِ",24,"ش",1,0],["فانتدب للأكل وابرك جاثياً","جانب السفرة واثبت للصدام",25,"م",1,0],["فإن تدعِ العراقَ وساكنيها","فقد تبلى المليحة بالطلاق",26,"ق",1,0],["فانتدب يا ناصر الاسلام لا","سامك البين عن النصر اعتياقا",27,"ق",2,0],["فانتدب الموفق السعيدُ","أخوهُ وهو الفارس الصنديدُ",28,"د",1,0],["فإِنْ تُدْبِرْ عوان فعِيرُ أَرضٍ","فإني في مودَّتِه زهيدُ",29,"د",1,1],["فَإِن تَدَعي نَجداً أَدَعهُ وَمَن بِهِ","وَإِن تَسكُني نَجداً فَيا حَبَّذا نَجدُ",30,"د",1,0],["فإن تدعوا عنا اصطباراً فهكذا","أتانا بلا دعوى كما نشتهي الصبر",31,"ر",1,0],["فإن تدن منهم قاب رمح فإننا","اليك اذا مما جنوه براء",32,"ا",2,0],["فَأَنْتِ دُوْنِ بَنَاْتِ الْحُبِّ لِيْ أَمَلٌ","وَأَنْتِ أَعْشَقُ مِنْ قَيْسٍ، وَمِنْ مُضَرِ",33,"ر",1,0],["فَأَنتِ دَفقُِ حَنَانٍ صَادِقٍٍ وَرِعٍٍ","( ما أخطأ الدرب من قادته تقواك)",34,"ك",1,0],["فانتداح أو انتزاح، وما","أندى خصام الندين قطرا انتصاح",35,"ح",1,0],["فأنتِ دموعي وأنتِ شموعي","وأنتِ عيونٌ لهذي المحاجرْ",36,"ر",1,0],["فأنت دنياي والصدر الحنون إذا","أتيت أعدو بقلب متعب وجف",37,"ف",1,0]]}