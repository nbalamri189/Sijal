{"poems":[[39,"فرهن ما يداي لكم وفاء","https://www.aldiwan.net/poem7476.html","الوافر"],[52,"دعاك الحب بالشعب","https://www.aldiwan.net/poem64830.html","الهزج"],[102,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[201,"أوقديها وذريها في حشايا","https://www.aldiwan.net/poem39942.html","الرمل"],[369,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[369,"حيتك غادية الحيا من مربع","https://www.aldiwan.net/poem60850.html","البسيط"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130605","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101391","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86360","الوافر"],[5072,"هذي الفتاة","https://www.poetsgate.com/ViewPoem.aspx?id=34350",""],[5667,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214837",""],[5939,"لم يكن للورد ذنب","https://www.poetsgate.com/ViewPoem.aspx?id=178580",""]],"verses":[["فرهن ما يداي لكم وفاء","باشناق الديات إلى الكهول",0,"ل",1,1],["فَرَهبي مِنكَ في شَعفي","وَمِن مَوتِ الهَوى رَغبي",1,"ب",2,0],["فرّة واجتلت قناعا يحلّي","جبهات إلى القفى مستديره",2,"ر",2,0],["فَرَهينُ الوجدِ لا توهِنهُ","قسوةُ الدنيا وما يَلقاهُ فيها",3,"ه",2,0],["فرَهْنٌ بالتّفرُّقِ كُلُّ شمْل","ونَصْبٌ للتّحوُّلِ كُلُّ حالِ",4,"ل",1,0],["فرَهينتي معهمْ فؤاديَ دائماً","والطّيفُ من سَلْمَى رَهينتُهْم معي",5,"ع",2,0],["فر هاد شيَّد روضة فزهت","بالنُّور لا بالنور والورد",6,"د",1,0],["فرهطه في التهادي كل جازية","وجنده في التصابي الخرُّد العرب",7,"ب",1,0],["فرهطك خير رهط حيث كانوا","جحاجحة ودورك خير دور",8,"ر",1,0],["فرهنتُ إحساسي وجِئتُكَ مُتعَباً","يا شاطئي لأُريكَ ما بمُصابِها",9,"ب",3,0],["فرهبةُ الكونِ كلِّ الكونِ يحملُها","لو ضجَّ يوماً بهِ الأعماقُ تَستجرُ",10,"ر",1,0],["فرَّ هذا القلبُ منّي سندبادًا في بحارِكْ","طامحًا للحسنِ وحدي ليسَ في عشقي مُشارِكْ",11,"ك",1,0]]}