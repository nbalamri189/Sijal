563,"تحقق فإن الروح في الكل واحد","https://www.aldiwan.net/poem34622.html","الطويل"],[567,"مللت من القريض وقلت يكفي","https://www.aldiwan.net/poem52844.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138441",""],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136259","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46566","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64531","الطويل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101738","الوافر"],[2483,"","https://poetry.dctabudhabi.ae/diwan/poem/144383","الطويل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141214","السريع"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128232","السريع"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126533","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111396","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136397",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[5431,"ولا وأبيك لا أهجو الذبابا","https://www.poetsgate.com/ViewPoem.aspx?id=197167",""],[5720,"النبيُﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=198958",""],[402,"تحقق وعد الله والله أكبر","https://www.poetsgate.com/ViewPoem.aspx?id=35708",""],[5956,"العبّارة المصرية","https://www.poetsgate.com/ViewPoem.aspx?id=192129",""],[5975,"في ولاء آل بيت الرسول1","https://www.poetsgate.com/ViewPoem.aspx?id=53466",""],[186,"عيد به للهنا والبشر تجديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55749&r=&rc=12",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""]],"verses":[["تَحَقَّقَتِ الأَحياءُ أَنَّكَ فَخرُها","وَأَغضَت عَلى عِلمٍ نِزارٌ وَيَعرُبُ",0,"ب",1,0],["تَحَقَّقَ الشَرطُ وَاِستَغنَيتُ عَن طَلَبٍ","وَصارَ في اِستِ نَصيرٍ داءُ عَبّاسِ",1,"س",1,0],["تَحَقَّق بِأَنَّ الحَقَّ بِمُدرَكٍ","فَلا تَدَّعيهِ جَهلاً وَمُرائِيا",2,"ي",2,0],["تحققتْ بالفسق في دارهِ","وزادت التكريعَ تطفيلا",3,"ل",2,0],["تُحَقِّرُ عِندي هِمَّتي كُلَّ مَطلَبٍ","وَيَقصُرُ في عَيني المَدى المُتَطاوِلُ",4,"ل",1,0],["تَحَقَّرتَ يا وَهبُ في ضَرطَةٍ","فَأَضحَت أَحاديثُها شائِعَه",5,"ع",2,1],["تَحَقَّقَ قَولُكَ وَالفَصلُ فيهِ","فَصَحَّ العِيانُ وَصَحَّ الخَبَر",6,"ر",1,0],["تحقر عند همتي كل مطلبٍ","ويقصر في عيني المدى المتطاول",7,"ل",1,0],["تَحقَّقَ وَعْدُ اللّهِ وَاللّهُ أَكْبَرُ","لِيَهْنِئْكُمُ النَّصْرُ العَزِيزُ المُؤَزَّرُ",8,"ر",1,1],["تَحَقَّقَ بَعْدَ لأَيٍ فَهْوَ أَقْوَى","أَدَاةٍ للسَّلاَمِ المُسْتَقِرِّ",9,"ر",1,0],["تَحَقَّقَتِ البُشْرَى لِمَن هُوَ رَاكِع","يُرَجِّي به فضلاً وَمَنْ هُوَ ساجِدُ",10,"د",1,0],["تَحَقَّقَها الأَدنَونَ سَمعاً وَرُؤيَةً","وَأُشعِرَها الأَقصَونَ مِن عَرفِها نَشقا",11,"ق",2,0],["تَحَقَّقتُ أَنَّ الوَردَ يُجنى بِخَدِّهِ","وَلَم أَدرِ أَنَّ المَوتَ مِن صَدِّهِ يُجنا",12,"ن",2,0],["تُحَقّقُ ما تَحْوِيهِ من كلّ سؤددٍ","وكم سؤددٍ بالقولِ لم يَتَحَقّق",13,"ق",1,0],["تحققت مطلوبي فأسرعت نحوه","فدام سروري واضمحل عنائي",14,"ا",3,0],["تحقق أن القلم فيه بأسره","ولم يسترب في مثل هذا أريبنا",15,"ن",2,0],["تحقيره طاعة أو معصيه أو فعال","أو علما أو جنة أو نارا ومن محال",16,"ل",1,0],["تحقّقتْ بالكَلِم الفصْلِ فال","مُلك لها والناسُ نَظَّارَهْ",17,"ر",2,0],["تَحَقَّقَ الدَهرُ أَنَّ المُلكَ مُنذُ نَشا","لَهُ أَبو تَغلِبَ اِسمٌ غَيرُ مُشتَركِ",18,"ك",1,0],["تحقيق كل حقيقة بالحق إذ","هو لا سواه وكل شيء فاني",19,"ن",2,0],["تحقق بما قلناه فيها مجانباً","سواه فما قلناه فيها هو الغنم",20,"م",1,0],["تحقيركم والأذى منكم لهم حسد","بل ذاك بغض وتقبيح بكم ظهرا",21,"ر",2,0],["تحقق بآثار الأواني مجانباً","بروق المعاني فالعظيم بنا أحرى",22,"ر",2,0],["تحقق كلامي وخل السوى","فإن السوى هو أردى الردى",23,"د",2,0],["تحقق فإن الروح في الكل واحدُ","ولا شيء إلا الروح يدريه واجدُ",24,"د",1,1],["تَحِقُّ وِلايةٌ شَرْعاً وعُرفاً","لراعي الحَقِّ في شَرْعٍ وعُرفِ",25,"ف",1,0],["تحققت الطهارة في رجال","يرجون الحياة السرمديه",26,"ي",2,0],["تحققت بالعلم القديم ولم أزل","به قائماً من قبل باللَه في الأزل",27,"ل",1,0],["تحقق وسر بعد التحقق في سوا","سبيل العلى واصعد إلى المقصد الحقي",28,"ق",2,0],["تَحقيقهُ جُنون","وَرَأيهُ مأفون",29,"ن",1,0],["تحق صفات القهر للقاهر الذي","لسلطانه ذلت صنوف الخليقة",30,"ه",1,0],["تحقق في مقام الشكر عجزي","فآثر أن أرى ولدي معيني",31,"ي",1,0],["تحقَّق أبا بكر ودادي وحقّق","وصدّق ظنوني في وفائك وأصدقِ",32,"ق",1,1],["تحقق الآمال مستعطفاً","وتوقع النفس بآماليه",33,"ي",2,0],["تحقيق الآمال مستعطفاً","وتوقع النقص بآماليه",34,"ي",2,0],["تحقق عندكم صدقي وحبي","بنفحتكم فهلا تشملوني",35,"ن",2,0],["تَحقَّقَ مُرتاعاً ثُبُوتَ هُبُوطِها","فبادَرَ يَشكُو شِدَّةَ الأَمرِ والوِزرِ",36,"ر",1,0],["تحققت فيه المعالي فما","يلقى المغالي مدحة لاغيه",37,"ي",2,0],["تحقق تصديق لكل ونصرة","لكل واتباع لكل باذعان",38,"ن",1,0],["تُحقرهم بلا هدفٍ حياة","وتسلبهم على تيهٍ صوابا",39,"ب",2,0],["تحققَ النصرُ يومَ الفتحِ فاعتنقتْ","قبائلُ العُرْبِ دينَ اللهِ أفواجا",40,"ج",2,1],["تحقق وعد الله والله أكبر","ليهنئكم العصر العزيز المؤزر",41,"ر",1,1],["تَحقق في ضُبا ما خفت منه","على شعبي وأصحابي النِّجابِ",42,"ب",1,0],["تحقَّقتِ التقوى بحبِّكَ والتقى","ورقَّ فؤادي في هواكَ وقد لبّى",43,"ب",2,0],["تحققت فيه آمال الألي درجوا","قدماً وقد سعدت فيه المواليد",44,"د",1,0],["تُحَقَّرُ قُرْعَانُ الْكِبَاشِ لِضَعْفِهَا","وَ يُخْشَى مِنَ الْقَرْنَاءِ نَطَّاحُهَا الضَّخْمُ",45,"م",1,0]]}