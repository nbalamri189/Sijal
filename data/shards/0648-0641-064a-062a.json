يل"],[462,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[465,"رأى وقفة البين خطباً فطيعاً","https://www.aldiwan.net/poem3503.html","عموديه"],[478,"وفيت لمن أحبهم فخانوا","https://www.aldiwan.net/poem15198.html","الوافر"],[478,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[480,"الحب داء دفين","https://www.aldiwan.net/poem36935.html","المجتث"],[480,"فتحت بنظمك المنثور بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[480,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[514,"بدأت بموعد ورجعت عنه","https://www.aldiwan.net/poem67712.html","الوافر"],[516,"أوجبت في ذمة الأشعار والخطب","https://www.aldiwan.net/poem12014.html","البسيط"],[516,"بقاؤك يا فارس المسلمينا","https://www.aldiwan.net/poem12283.html","المتقارب"],[559,"أيا أحمد البدوي أنت أين","https://www.aldiwan.net/poem34504.html","المتقارب"],[563,"أطوف الأرض في شرق وغرب","https://www.aldiwan.net/poem52849.html","الوافر"],[565,"ولما رأيت الدل في شرعة الهوى","https://www.aldiwan.net/poem877.html",""],[568,"عادات طيفك أن يعاود","https://www.aldiwan.net/poem69711.html","مجزوء الكامل"],[576,"أقاموا بالمواخير","https://www.aldiwan.net/poem2950.html","الهزج"],[586,"عروس الكأس يجلوها نديمي","https://www.aldiwan.net/poem1566.html",""],[587,"صدودك هل له أمد قريب","https://www.aldiwan.net/poem17409.html","الوافر"],[587,"أحلى الهوى أن يطول الوجد والسقم","https://www.aldiwan.net/poem17711.html","البسيط"],[588,"ألا أيها الغادي مجداً بنجداً","https://www.aldiwan.net/poem11509.html","عموديه"]],"verses":[["وَفي تِلكَ نُنفِقُ أَموالَنا","وَنَشرَبُها أَبَداً ما بَقينا",0,"ن",2,0],["وَفَّيْتَ حَقَّ صِيَامِهِ وَقِيَامِهِ","بِمَقَامِ صِدْقٍ لَمْ يَقُمْهُ سِوَاكَا",1,"ك",2,0],["وَفَيْتَ وَخَانَ الْعَهْدَ فِي غَيْرِ طَائِلٍ","وَصَدَّقَ أَطْمَاعَ الظُّنُونِ الْكَوَاذِبِ",2,"ب",1,0],["وَفي تونُسَ الخَضراءِ يا لَيتَهُ بَنى","لَهُ أَثَراً في لَوحَةِ الدَهرِ يُذكَرُ",3,"ر",1,0],["وَفي تَضَوُّعِ أَنفاسِ الرِياضِ بِها","رَوحٌ لِكُلِّ حَزينِ القَلبِ أَسوانِ",4,"ن",1,0],["وَفي توتَ ما أَعيا اِبتِكارَ مُوَفَّقٍ","وَفي ناشِئٌ في الوَردِ إِلهامُ مُبدِعِ",5,"ع",1,0],["وَفَّيْتِ يُوسُفَ حَقَّهُ فِي قَوْمِهِ","مِنْ لُطْفِ مَنْزِلَةٍ وَرِفْعَةِ شَانِ",6,"ن",1,0],["وَفِي تَقَفِّيهِ مَا يُطَارِدُهُ","وَفِي تَوقِّيهِ زَلَّةِ القَدَمِ",7,"م",1,0],["وَفَّيْتَ قِسْطَكَ فِي الجِهَادِ","وَلَيْسَ بِالقِسْطِ القَلِيلِ",8,"ل",1,0],["وَفي تَميمٍ لَهُ عِزٌّ قُراسِيَةٌ","ذو صَولَةٍ صَلقَمٌ أَنيابُهُ تَمَمُ",9,"م",1,0],["وَفَيتُ وَفي بَعضِ الوَفاءِ مَذَلَّةٌ","لِإِنسانَةٍ في الحَيِّ شيمَتُها الغَدرُ",10,"ر",1,0],["وفي تاج الزمان نظمت درّاً","فيا لله من عقدٍ بديع",11,"ع",1,0],["وفي تعدِّي الحدود مَفسدةٌ","وليس كل الأمور بالقسر",12,"ر",1,0],["وفَّيتَ حق الشرطتين وما","وُفِّيتَ حقك لا ولا ربعه",13,"ع",2,0],["وفي تلهّيه وفي تعلُّلِهْ","وما يريه الحقُّ من تفضُّلِهْ",14,"ل",2,0],["وَفي تَلاميذِكَ أَهلِ الحِجى","وَالأَدَبِ الجَمِّ الجَميلِ السِمات",15,"ت",1,0],["وَفي تِلكَ البَرانيسُ","بُدورٌ في الدَياجيرِ",16,"ر",1,0],["وَفَيتَ لِمَن أَدناكَ في المُلكِ حِقبَةً","فَكانَ عَجيباً أَن يَرى الناسُ وافِيا",17,"ي",2,0],["وَفي تَعَبٍ مَن يَحسُدُ الشَمسَ نورَها","وَيَجهَدُ أَن يَأتي لَها بِضَريبِ",18,"ب",1,0],["وفي تدبيرها سر عظيم","وخير لا انقطاع له عتيدُ",19,"د",1,0],["وفَيْتُ بعهدٍ كان بيني وبينَهُ","وبينَ مَقاماتٍ بمصرَ خطابَا",20,"ب",2,0],["وَفَيتُمُ وَوَفاءُ العَهدِ شيمَتَكُم","وَلَم يُخالِط قَديماً صِدقَكُم كَذِبُ",21,"ب",1,0],["وَفَيتَ لَهُم دوني فَسَوفَ أَكيدُهُم","بِصَبري إِلى أَن أَبلُغَ الغايَةَ القُصوى",22,"و",2,0],["وَفَيتُ بِأَدرُعِ الكِندِيِّ إِنّي","إِذا ما خانَ أَقوامٌ وَفَيتُ",23,"ت",1,0],["وَفي تَواليهِ نُجومٌ كَالسُرَر","بِسَحَقِ الميعَةِ مَيّالِ العُذَر",24,"ر",1,0],["وفَيْتُ وقد جُزِيتُ بِمِثْلِ فِعْلي","فها أنا لا أخُونُ ولا أُخانُ",25,"ن",1,0],["وفيت بوعد في الرجوع إلي يا","أَبا الفضل لكن بعد طولٍ من المطل",26,"ل",1,0],["وَفَيْتُ بِوَعْدِي فِي الثَّنَاءِ وَإِنْ يَكُنْ","مَقَالِي بِهَاتِيكَ الْفَضَائِلِ لا يَفِي",27,"ف",2,0],["وَفَيْتُ بِمَا ظَنَّ الْكِرامُ فِرَاسةً","بِأَمْرِي وَمِثْلِي بِالْوَفَاءِ جَدِيرُ",28,"ر",1,0],["وَفَّيْتَ عَهْداً بِالأُولَى أَعدَدْتَهُمْ","لِلسَّبْقِ مِنْ فُرْسَانِ كُلِّ مَجَالِ",29,"ل",1,0],["وَفَيْتَ لَهَا بِالقِسْطِ لَكِنْ تَنُكَّرَتْ","مَنَازِلُهَا فَابْغِ السَّمَاوَاتِ وَارْتَقِ",30,"ق",1,0],["وَفِي تَناهٍ بِلاَ تَباهٍ","ذَوْداً عَنِ المَبْدَأِ الصَّحِيحِ",31,"ح",1,0],["وَفيتُ بِعَهدي وَاللَيالي غَوادِرٌ","وَجُدتُ بِنَفسي وَالزَمانُ بَخيلُ",32,"ل",1,0],["وفيت وخانوا والوفاء غريزة","وما يستوي في الدهر واف وغادر",33,"ر",1,0],["وفيتان صدق، لا ضغائن بينهمْ،","إذا أرْمَلُوا لم يُولَعُوا بالتّلاوُمِ",34,"م",1,1],["وفيت بعهد الغوطتين وهذه","شهودي القوافي والدموع السواجم",35,"م",1,0],["وفي تلك فازوا بالوصال وفوق ما","يروموا من آلالا وادمان منة",36,"ه",1,0],["وفيت لاحبابي كما وفَّت العلى","لأحمد والمجد المؤثل والفخر",37,"ر",1,0],["وفيت لكم ولا منّ عليكم","فقد عاف الخيانة من يخون",38,"ن",1,0],["وَفي تَعَبِ الأَعضاءِ لِلقلبِ راحَةٌ","وَلا تَصلُحُ الأَعضاءُ وَالقَلبُ رازِحُ",39,"ح",1,0],["وفي تعويجها حظ ورفق","تصون حشاشتي وتضمّ شملي",40,"ل",2,0],["وَفي تابعيهم كلُّ أروعَ علّام","حَوى كلّ فضلٍ باِكتسابٍ وإلهامِ",41,"م",1,0],["وَفي تبوكَ عيونُ الرومِ منه جرَت","جَريَ المذاكي وجيشُ الشرك مخذولُ",42,"ل",1,0],["وفي تشنُّع لُوطِي","وفي تفتُّح زانِ",43,"ن",1,0],["وفيتَ وما لك إلا الوفا","وأنصفتَ والعدلُ أن تُنصِفا",44,"ف",2,1],["وفي تسع لقعد قد وصلنا","إلى عدنٍ ولسنا نازلينا",45,"ن",2,0],["وفي تخته بالسيف ولدت نصرة","وشكلك فيه دل انك غالب",46,"ب",1,0],["وفيتَ بعهدٍ للصديق وما وَفَى","بعهدِ صديقٍ جرولٌ وجَريرُ",47,"ر",1,0],["وفي تعب الأيام للمرء راحة","كمجناك شهداً مع جناية نحله",48,"ل",2,0],["وفي تِلكَ المغاني طارَ قلبي","شُعاعاً للغواني والأغاني",49,"ن",2,0],["وَفَيْتُ بِما استَطَعْتُ مِن امْتِدَاحٍ","فَهَلْ لِلْحُرِّ مَعْذِرَةُ الوَفِيِّ",50,"ي",1,0],["وَفَيْتُ لِحِرْصٍ في هَوَاها فَخَانَنِي","وَقِدْماً أُصِيبَ النَّاسُ مِنْ قِبَلِ الحِرْصِ",51,"ص",1,0],["وفي تونسٍ دام الأمير محمّدٌ","عليّاً ليكفى حزبها السوءَ والخطبا",52,"ب",2,0],["وَفي تَفريقِ الجامِ","عِ عِندي مُجمَعُ الكُلِّ",53,"ل",1,0],["وفي تَوقيعِه الأعلى دليلٌ","كأنّك بالحديثِ إليه ساقا",54,"ق",2,0],["وفي تَ