://www.poetsgate.com/ViewPoem.aspx?id=196655",""],[5106,"في روحه قمر تناثر من قمر","https://www.poetsgate.com/ViewPoem.aspx?id=150037",""],[5277,"العيون البغدادية...","https://www.poetsgate.com/ViewPoem.aspx?id=202087",""],[5281,"وفاءُ التَّاريخِ","https://www.poetsgate.com/ViewPoem.aspx?id=200243",""],[5299,"مكابرةُ امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=210536",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5359,"سأجعل لي النعمان في الفقه قدوةً","https://www.poetsgate.com/ViewPoem.aspx?id=181479",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5376,"قفْ ودِّعِ الكفرَ فالإسلامُ في نهم","https://www.poetsgate.com/ViewPoem.aspx?id=188508",""],[5376,"في الأرضِ جاذرةٌ نفسي وباسقةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=196643",""],[5457,"هي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=213104",""],[5459,"رقصنا","https://www.poetsgate.com/ViewPoem.aspx?id=190907",""],[5587,"أنت الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=202780",""],[5759,"كيف الخلاص","https://www.poetsgate.com/ViewPoem.aspx?id=213994",""],[402,"وأقبل الأمن بآلآئه","https://www.poetsgate.com/ViewPoem.aspx?id=36336",""],[5830,"أَسَاحِرَةَ العُيُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=201193",""],[5847,"حينما بكت عمان .!!","https://www.poetsgate.com/ViewPoem.aspx?id=208953",""],[5894,"وحسنك يا خلي بغيرك لا أهوى","https://www.poetsgate.com/ViewPoem.aspx?id=131436",""],[6046,"فصل لربك وانحر","https://www.poetsgate.com/ViewPoem.aspx?id=36742",""],[6093,"إذا شيبٌ بدا ليَ ذاك وفدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=176440",""],[6093,"قَارِئَا الرِّيْحِ","https://www.poetsgate.com/ViewPoem.aspx?id=205704",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6251,"إلى الشيخ جابر الأحمد الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76467&r=&rc=7",""],[6320,"كِتَابُ الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84340&r=&rc=37",""]],"verses":[["وَفي تِلكَ نُنفِقُ أَموالَنا","وَنَشرَبُها أَبَداً ما بَقينا",0,"ن",2,0],["وَفَّيْتَ حَقَّ صِيَامِهِ وَقِيَامِهِ","بِمَقَامِ صِدْقٍ لَمْ يَقُمْهُ سِوَاكَا",1,"ك",2,0],["وَفَيْتَ وَخَانَ الْعَهْدَ فِي غَيْرِ طَائِلٍ","وَصَدَّقَ أَطْمَاعَ الظُّنُونِ الْكَوَاذِبِ",2,"ب",1,0],["وَفي تونُسَ الخَضراءِ يا لَيتَهُ بَنى","لَهُ أَثَراً في لَوحَةِ الدَهرِ يُذكَرُ",3,"ر",1,0],["وَفي تَضَوُّعِ أَنفاسِ الرِياضِ بِها","رَوحٌ لِكُلِّ حَزينِ القَلبِ أَسوانِ",4,"ن",1,0],["وَفي توتَ ما أَعيا اِبتِكارَ مُوَفَّقٍ","وَفي ناشِئٌ في الوَردِ إِلهامُ مُبدِعِ",5,"ع",1,0],["وَفَّيْتِ يُوسُفَ حَقَّهُ فِي قَوْمِهِ","مِنْ لُطْفِ مَنْزِلَةٍ وَرِفْعَةِ شَانِ",6,"ن",1,0],["وَفِي تَقَفِّيهِ مَا يُطَارِدُهُ","وَفِي تَوقِّيهِ زَلَّةِ القَدَمِ",7,"م",1,0],["وَفَّيْتَ قِسْطَكَ فِي الجِهَادِ","وَلَيْسَ بِالقِسْطِ القَلِيلِ",8,"ل",1,0],["وَفي تَميمٍ لَهُ عِزٌّ قُراسِيَةٌ","ذو صَولَةٍ صَلقَمٌ أَنيابُهُ تَمَمُ",9,"م",1,0],["وَفَيتُ وَفي بَعضِ الوَفاءِ مَذَلَّةٌ","لِإِنسانَةٍ في الحَيِّ شيمَتُها الغَدرُ",10,"ر",1,0],["وفي تاج الزمان نظمت درّاً","فيا لله من عقدٍ بديع",11,"ع",1,0],["وفي تعدِّي الحدود مَفسدةٌ","وليس كل الأمور بالقسر",12,"ر",1,0],["وفَّيتَ حق الشرطتين وما","وُفِّيتَ حقك لا ولا ربعه",13,"ع",2,0],["وفي تلهّيه وفي تعلُّلِهْ","وما يريه الحقُّ من تفضُّلِهْ",14,"ل",2,0],["وَفي تَلاميذِكَ أَهلِ الحِجى","وَالأَدَبِ الجَمِّ الجَميلِ السِمات",15,"ت",1,0],["وَفي تِلكَ البَرانيسُ","بُدورٌ في الدَياجيرِ",16,"ر",1,0],["وَفَيتَ لِمَن أَدناكَ في المُلكِ حِقبَةً","فَكانَ عَجيباً أَن يَرى الناسُ وافِيا",17,"ي",2,0],["وَفي تَعَبٍ مَن يَحسُدُ الشَمسَ نورَها","وَيَجهَدُ أَن يَأتي لَها بِضَريبِ",18,"ب",1,0],["وفي تدبيرها سر عظيم","وخير لا انقطاع له عتيدُ",19,"د",1,0],["وفَيْتُ بعهدٍ كان بيني وبينَهُ","وبينَ مَقاماتٍ بمصرَ خطابَا",20,"ب",2,0],["وَفَيتُمُ وَوَفاءُ العَهدِ شيمَتَكُم","وَلَم يُخالِط قَديماً صِدقَكُم كَذِبُ",21,"ب",1,0],["وَفَيتَ لَهُم دوني فَسَوفَ أَكيدُهُم","بِصَبري إِلى أَن أَبلُغَ الغايَةَ القُصوى",22,"و",2,0],["وَفَيتُ بِأَدرُعِ الكِندِيِّ إِنّي","إِذا ما خانَ أَقوامٌ وَفَيتُ",23,"ت",1,0],["وَفي تَواليهِ نُجومٌ كَالسُرَر","بِسَحَقِ الميعَةِ مَيّالِ العُذَر",24,"ر",1,0],["وفَيْتُ وقد جُزِيتُ بِمِثْلِ فِعْلي","فها أنا لا أخُونُ ولا أُخانُ",25,"ن",1,0],["وفيت بوعد في الرجوع إلي يا","أَبا الفضل لكن بعد طولٍ من المطل",26,"ل",1,0],["وَفَيْتُ بِوَعْدِي فِي الثَّنَاءِ وَإِنْ يَكُنْ","مَقَالِي بِهَاتِيكَ الْفَضَائِلِ لا يَفِي",27,"ف",2,0],["وَفَيْتُ بِمَا ظَنَّ الْكِرامُ فِرَاسةً","بِأَمْرِي وَمِثْلِي بِالْوَفَاءِ جَدِيرُ",28,"ر",1,0],["وَفَّيْتَ عَهْداً بِالأُولَى أَعدَدْتَهُمْ","لِلسَّبْقِ مِنْ فُرْسَانِ كُلِّ مَجَالِ",29,"ل",1,0],["وَفَيْتَ لَهَا بِالقِسْطِ لَكِنْ تَنُكَّرَتْ","مَنَازِلُهَا فَابْغِ السَّمَاوَاتِ وَارْتَقِ",30,"ق",1,0],["وَفِي تَناهٍ بِلاَ تَباهٍ","ذَوْداً عَنِ المَبْدَأِ الصَّحِيحِ",31,"ح",1,0],["وَفيتُ بِعَهدي وَاللَيالي غَوادِرٌ","وَجُدتُ بِنَفسي وَالزَمانُ بَخيلُ",32,"ل",1,0],["وفيت وخانوا والوفاء غريزة","وما يستوي في الدهر واف وغادر",33,"ر",1,0],["وفيتان صدق، لا ضغائن بينهمْ،","إذا أرْمَلُوا لم يُولَعُوا بالتّلاوُمِ",34,"م",1,1],["وفيت بعهد الغوطتين وهذه","شهودي القوافي والدموع السواجم",35,"م",1,0],["وفي تلك فازوا بالوصال وفوق ما","يروموا من آلالا وادمان منة",36,"ه",1,0],["وفيت لاحبابي كما وفَّت العلى","لأحمد والمجد المؤثل والفخر",37,"ر",1,0],["وفيت لكم ولا منّ عليكم","فقد عاف الخيانة من يخون",38,"ن",1,0],["وَفي تَعَبِ الأَعضاءِ لِلقلبِ راحَةٌ","وَلا تَصلُحُ الأَعضاءُ وَالقَلبُ رازِحُ",39,"ح",1,0],["وفي تعويجها حظ ورفق","تصون حشاشتي وتضمّ شملي",40,"ل",2,0],["وَفي تابعيهم كلُّ أروعَ علّام","حَوى كلّ فضلٍ باِكتسابٍ وإلهامِ",41,"م",1,0],["وَفي تبوكَ عيونُ الرومِ منه جرَت","جَريَ المذاكي وجيشُ الشرك مخذولُ",42,"ل",1,0],["وفي تشنُّع لُوطِي","وفي تفتُّح زانِ",43,"ن",1,0],["وفيتَ وما لك إلا الوفا","وأنصفتَ والعدلُ أن تُنصِفا",44,"ف",2,1],["وفي تسع لقعد قد وصلنا","إلى عدنٍ ولسنا نازلينا",45,"ن",2,0],["وفي تخته بالسيف ولدت نصرة","وشكلك فيه دل انك غالب",46,"ب",1,0],["وفيتَ بعهدٍ للصديق وما وَفَى","بعهدِ صديقٍ جرولٌ وجَريرُ",47,"ر",1,0],["وفي تعب الأيام للمرء راحة","كمجناك شهداً مع جناية نحله",48,"ل",2,0],["وفي تِلكَ المغاني طارَ قلبي","شُعاعاً للغواني والأغاني",49,"ن",2,0],["وَفَيْتُ بِما استَطَعْتُ مِن امْتِدَاحٍ","فَهَلْ لِلْحُرِّ مَعْذِرَةُ الوَفِيِّ",50,"ي",1,0],["وَفَيْتُ لِحِرْصٍ في هَوَاها فَخَانَنِي","وَقِدْماً أُصِيبَ النَّاسُ مِنْ قِبَلِ الحِرْصِ",51,"ص",1,0],["وفي تونسٍ دام الأمير محمّدٌ","عليّاً ليكفى حزبها السوءَ والخطبا",52,"ب",2,0],["وَفي تَفريقِ الجامِ","عِ عِندي مُجمَعُ الكُلِّ",53,"ل",1,0],["وفي تَوقيعِه الأعلى دليلٌ","كأنّك بالحديثِ إليه ساقا",54,"ق",2,0],["وفي تَصارِيفِ حالَتَيهِ فَما","أقربَهُ مِن نَدى أبي القاسِم",55,"م",1,0],["وَفَيتُهُ حَق الهَوى","مُضاعِفاً فَما وَفى",56,"ف",2,0],["وفي تَغايُرِ صرفِ الدّهرِ معتَبِرٌ","وأيُّ حالٍ على الأيام لم تَحُلِ",57,"ل",1,0],["وفِي تَميمٍ ومَن والاه موعظةٌ","إنذارُها يُسمع الأمواتَ في الرَّجَمِ",58,"م",1,0],["وَفَيْتم له بالعهد لم تعبَأُوا بمن","أشارَ إلى الغدر الكمين مجمجما",59,"م",2,0],["وفي تلك المنازل لا عداها","حَياً ينهلّ من ذات الرعود",60,"د",1,0],["وفي تلك الشفاه اللُّعس ريٍّ","فوا ظمأ الفؤاد إلى الورود",60,"د",1,0],["وفي تلك المنازل كانَ قلبي","فمذ فقد الأحبة راح فقدا",61,"د",2,0],["وفيتُ بعهد من نقضت عهودي","وما لوفاء ميّ من دوام",62,"م",1,0],["وفيتَ له يا عليّ الرضا","وهل ينفع الغادرين الندم",63,"م",1,0],["وفي تلك القِبابِ شِفاءُ وجدي","ولكنْ ما إليه من سبيلِ",64,"ل",1,0],["وفي تَبوكَ وأَوْطاسٍ ومُصطَلقٍ","ومَنْ عَصى اللهَ من أَبناءِ عَدْنانا",65,"ن",2,0],["وفيت بوده مذ كان حيا","ويأبى أن يكون وفاي فيا",66,"ي",2,0],["وفي تلعاتِ الصخر قد شق نهره","يزيد فصانت ضفتيه هضابُه",67,"ب",2,0],["وفيتَ بما سنُّوا وزدتَ زيادةً","تفوتُ مكاييلٌ لهم ووزُونُ",68,"ن",1,0],["وفيتُ بدهري وأيامِه","ولكن عجزتُ عن الحاسدينا",69,"ن",2,0],["وفيت بعهدِ الصبر فيها حميَّةً","وقد غدرت بالراحتين الأصابعُ",70,"ع",1,0],["وفيتَ لآباءٍ تكلَّفتَ عنهمُ","فضائلَ ما سنّوا الفخارَ وسيَّروا",71,"ر",3,0],["وفَيتَ فكيف رأيتَ الوفاءَ","يُذِلّ العزيزَ ويُضوِي الجليدا",72,"د",2,0],["وفيت لقَيْلٍ من ذؤابة خندفٍ","إذا ما أضاع القوم حق امرئٍ رعى",73,"ع",2,0],["وفيتَ بها والدين قد مالَ روْقهُ","وصدَّقْتها والكُفْرُ بادي الشعائرِ",