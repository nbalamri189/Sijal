m/75682","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101363","الكامل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119404","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123491","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123512","البسيط"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21591","الكامل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93758","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81299","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81255","المجتث"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81272","المتقارب"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83400","الرجز"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62131","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120320","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139726",""],[4791,"مر اهل الهوى حالي","https://www.poetsgate.com/ViewPoem.aspx?id=37119",""],[4830,"آهاتُ شعبي","https://www.poetsgate.com/ViewPoem.aspx?id=198931",""],[4578,"خطرت لأعطاف المحاسن ثانية","https://www.poetsgate.com/ViewPoem.aspx?id=49618",""],[4927,"الجمال والحب","https://www.poetsgate.com/ViewPoem.aspx?id=4576",""],[4927,"كَيْدُ الْعُذَّاْل","https://www.poetsgate.com/ViewPoem.aspx?id=30197",""],[4955,"أفضلُ أن أقلِّلَ من كلامي","https://www.poetsgate.com/ViewPoem.aspx?id=187802",""],[5009,"بنت قنا","https://www.poetsgate.com/ViewPoem.aspx?id=24371",""],[5010,"دموع","https://www.poetsgate.com/ViewPoem.aspx?id=190760",""],[5055,"أختار","https://www.poetsgate.com/ViewPoem.aspx?id=100725",""],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[585,"تحية تملأ الدنيا وتمجيد","https://www.poetsgate.com/ViewPoem.aspx?id=161886",""],[5072,"نجاة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=52564",""],[3591,"إذا كنت لم أبرح من الدهر شاكيا","https://www.poetsgate.com/ViewPoem.aspx?id=149441",""],[5183,"على شعر ابن الدَّمينة","https://www.poetsgate.com/ViewPoem.aspx?id=180216",""],[5185,"الوحدة","https://www.poetsgate.com/ViewPoem.aspx?id=70900",""],[5186,"بمحياك يا هلال العام","https://www.poetsgate.com/ViewPoem.aspx?id=156438",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5500,"صفصاف","https://www.poetsgate.com/ViewPoem.aspx?id=188512",""],[5500,"على سبيل الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=190252",""],[5596,"تقريض كتاب دالية المحقق الخليلي","https://www.poetsgate.com/ViewPoem.aspx?id=206711",""],[5670,"الفقر","https://www.poetsgate.com/ViewPoem.aspx?id=215243",""],[5670,"أُعيذُ ذكراكِ..","https://www.poetsgate.com/ViewPoem.aspx?id=215264",""],[5720,"الطفل","https://www.poetsgate.com/ViewPoem.aspx?id=200156",""],[5848,"أفضل طريقة للحياة","https://www.poetsgate.com/ViewPoem.aspx?id=51941",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""],[5956,"حَيرَة","https://www.poetsgate.com/ViewPoem.aspx?id=183286",""],[5956,"نلملمُ أشلاءنا","https://www.poetsgate.com/ViewPoem.aspx?id=192808",""],[5956,"أخشَى أموتُ ولا أراك بجانبي","https://www.poetsgate.com/ViewPoem.aspx?id=193713",""],[5956,"وقت الشدائد نَطلب الرحماءَ","https://www.poetsgate.com/ViewPoem.aspx?id=194601",""],[5956,"ذهب القطينُ إلى جنازتها","https://www.poetsgate.com/ViewPoem.aspx?id=196839",""],[6019,"مَرُّوا عليَّ طيوفاً","https://www.poetsgate.com/ViewPoem.aspx?id=175400",""],[6056,"العنود","https://www.poetsgate.com/ViewPoem.aspx?id=130505",""],[6117,"متاهةُ حُلم","https://www.poetsgate.com/ViewPoem.aspx?id=182783",""],[6117,"أَفْضَتْ إِلَيْهِ الْمُنَى","https://www.poetsgate.com/ViewPoem.aspx?id=182788",""],[6124,"أين","https://www.poetsgate.com/ViewPoem.aspx?id=109739",""],[6177,"هجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81091&r=&rc=38",""],[6177,"قلق الحُروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79602&r=&rc=0",""],[5567,"أبدو .. ولا أبدو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81749&r=&rc=21",""]],"verses":[["أَفضى كَمُستَمِعِ الهَوانِ تَغَيَّبَت","أَنصارُهُ وَخَلا مِنَ الأَعوانِ",0,"ن",1,0],["أفْضى بهِ الأمَدُ الأقصى إِلى شرَفٍ","ضاحٍ لهُ منْ سَنامِ العِزِّ يافِعُهُ",1,"ع",2,0],["أفْضَتْ إليهِ خِلافَةٌ نَبَويَّةٌ","منْ دونِها للمَشْرَفِيِّ بَريقُ",2,"ق",1,0],["أفِضْ في الرّعايا العَدْلَ تحْظُ بحُبِّها","وحَكِّمْ علَيْها الحَقَّ في الحَلِّ والعَقْدِ",3,"د",1,0],["أَفِض في قاعَةِ الشورى وِئاماً","فَقَد أَودى بِنا وَبِها الخِصامُ",4,"م",1,0],["أَفَضيضُ مِسكٍ أَم بَلَنسِيَةٌ","لِرَيّاها نَميم",5,"م",1,0],["أَفِضُوا عَلَيْهَا مِنْ ابْتِكَارِكُمْ","بِمَا يَنْفَسُ الأَحْسَابَ مِنْ فَاخِرِ الحَسَبْ",6,"ب",1,0],["أفضنا نُهنِّي منك أكرم منعم","أبى لعميم الجود إلاّ تواليا",7,"ي",2,0],["أفضت فيه من النعماء أجزلها","وأشرف البر بالإحسان زَكّاهُ",8,"ا",2,0],["أَفضَت عَلَيهِ الجودَ مِن قَبلِ هَذِهِ","وَأَفضَلُ مِنهُ ما يُؤَمِّلُهُ بَعدُ",9,"د",1,0],["أفضليّ التعت والذَّات فيا","لهما من نسبتيْ سرّ وجهر",10,"ر",1,0],["أفضى لإسماعيل بيت العلى","فشاد منه أيّ أركان",11,"ن",1,0],["أفضل المنعت والذَّات فقل","وانظم الأبيات فيه وأنثني",12,"ن",2,0],["أفضلُ الأمَّةِ نجلُ الأفضلِ","ملكٌ عمَّ الورى بالمننِ",13,"ن",1,0],["أَفِضْتَ فيْضَ البحر حتى إذا","بَلَغْتَني أظمأتني وحدي",14,"د",2,0],["أفضِّلُ الورد على النرجس","لا أجعل الأنجم كالأشمسِ",15,"س",1,1],["أفضِل وأغِضْ جفونَ عينك رأفةً","بذوي العيوبِ يجبْ لك التفضيلُ",16,"ل",1,0],["أَفضى إِلَيهِ المُشتَري بِسُعودِهِ","وَأَعاذَهُ بَهرامُ مِن سَطَواتِهِ",17,"ت",2,0],["أَفضى إِلى خَتمِ الزَمانِ فَفَضَّهُ","وَحَبا إِلى التاريخِ في مِحرابِهِ",18,"ب",2,0],["أَفضى إِلى إيدامِ جِردَ وَدونَها","لَيلٌ يَبيتُ اللَيلُ فيهِ غَريبا",19,"ب",2,0],["أَفضى إِلَيهِ المُسلِمونَ فَصادَفوا","أَدنى البَرِيَّةِ مِن تُقى وَسَدادِ",20,"د",1,0],["أَفضى إِلى شُعثٍ تُطيرُ كَراهُم","رَوحاتُ قودٍ كَالقِسِيِّ ضَوامِرِ",21,"ر",1,0],["إِفضالُ فَتحٍ عَلَيَّ جَمٌّ","وَنَيلُ فَتحٍ لَدَيَّ غَمرُ",22,"ر",1,0],["أفضى به العُدْمُ إلى الفَضاء","فوجهُه للضِّحِّ والهواءِ",23,"ا",2,0],["أَفضَلُ المَعروفِ ما لَم","تُبتَذَل فيهِ الوُجوهُ",24,"و",2,0],["أفَضْتَ طَوْلاً عليهم بالنّدى نِعَماً","من بعد ما واقعَتْهُمْ بالرّدى نقمُ",25,"م",1,0],["أَفضى إِلَيكَ بِسِرِّهِ قَلَمٌ","لَو كانَ يَعقِلُهُ بَكى قَلَمُه",26,"م",2,0],["أَفَضتَ عَلى أَهلِ الجَزيرَةِ نِعمَةً","إِذا شُهِدَت لَم تُخزِهِم في المَشاهِدِ",27,"د",1,0],["أفضى الأُجاجُ إلى الفراتِ بقادمٍ","ساغ الأُجاجُ به فعبّ الشَّاربُ",28,"ب",1,0],["أَفضَى الجِهادُ بهم إلى مكروهةٍ","تَغتالُ بأسَ الفارسِ المِغوارِ",29,"ر",1,0],["أَفْضَى إليكَ بأمرِ قومِكَ فَاضْطَلِعْ","وَاعْزِمْ رِفاعةُ إنّ مثلَكَ يعزِمُ",30,"م",1,0],["أَفضى الرَئيس إِلى ظِلال نَعيمه","وَاِرتاحَ قَلبٌ بِالقَضية يَخفق",31,"ق",1,0],["أَفضى بِها الراوي إِلى خَبرَةٍ","فَاِبتَدَرَت أَفواهُ أَهزامِها",32,"م",3,0],["أفضَى به علْمُ اليَقِينِ لعَيْنِهِ","وَرَآهُ حَاسِدُهُ بعَيْنَيْ أَرْمَدِ",33,"د",1,0],["أفَضْتَ عليه بالنّدى غيرَ سائِلٍ","بحارَكَ حتى ظنَّ أنّك تُغْرِقُه",34,"ق",2,0],["أَفضَلُ ما أَبلُغُ مِن نَعتِهِ","تَحَدُّثي عَن قَلبِهِ القاسي",35,"س",2,0],["أَفَضُّ لِهاماتٍ وَأَرمى بِأَسهُمٍ","وَأَطعَنُ في قَلبِ الخَميسِ وَأَضرَبُ",36,"ب",1,0],["أَفضَلُ مِن أَفضَلِهِم صَخَرَةٌ","لا تَظلِمُ الناسَ وَلا تَكذِبُ",37,"ب",1,0],["أَفضَلُ مِمّا تَضُمُّ أَكؤُسُها","ما ضُمَّنَتهُ العِساسُ وَالعُلَبُ",38,"ب",1,0],["أَفضَلُ مِن أَحمَرِ السُلافِ وَمِن","كُمَيتِها ناصِعٌ مِنَ اللَبَنِ",39,"ن",1,0],["أفضَلُ ما في النّفسِ يَغتالُها","فنَستَعيذُ اللهَ من جُندِهِ",40,"د",2,0],["أفضى إلى الراقدِ فيه وباحْ","بأنَّهُ الملهمُ من فنِّهِ",41,"ه",1,0],["أَفْضَى إِلَى مِصْرَ وَالدُّنْيَا عَلَى خَطَرٍ","فَمَا تَمَثَّلَ حَتَّى أَجْفَلَ الْخَطَرُ",42,"ر",1,0],["أَفْضَى الذَّكَاءُ إِلى صَفِيحٍ هَامِد","وَأَوَى المَضَاءُ إِلى ضَرِيحٍ خَالِي",43,"ل",2,0],["أَفْضَلُ الأُمَّهَاتِ جَفَّ حَشَاهَا","مَنْ يُعَزِّي الْبَنَاتِ وَالأَبْنَأءَ",44,"ا",2,0],["أفِضْ من ندى لو حُمِّل المزنُ بعضَهُ","لراحت روايا المزنِ منه كظائظا",45,"ظ",2,0],["أفِضْها علينا نفحَةً هاشميةً","يُلَمُّ بها جُرحٌ ويبرأُ دَاءُ",46,"ا",2,0],["أفِضْها علينا نَفحةً هاشميةً","تَلُم شتَاتَ المسلمينَ وترأبُ",47,"ب",1,0],["أفضت بحرين من علم ومن كرم","كلاهما زاخر في الفيض