{"poems":[[55,"رأيت شباب المرء ليلا يجنه","https://www.aldiwan.net/poem30214.html","الطويل"],[65,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[95,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[95,"شهدنا زمانا في الكنانة ردنا","https://www.aldiwan.net/poem9798.html","عموديه"],[53,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[53,"أطلع الله وجه شهرِك هذا","https://www.aldiwan.net/poem66377.html","الخفيف"],[83,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[69,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[48,"اعدد لكل زمان ما يشاكله","https://www.aldiwan.net/poem23384.html","البسيط"],[48,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[173,"أبت نوب الأيام إلا تماديا","https://www.aldiwan.net/poem1691.html",""],[190,"إذا خطب الفقير إلى فقير","https://www.aldiwan.net/poem43982.html","الوافر"],[190,"كفى حزنا ما أرى حل بي","https://www.aldiwan.net/poem44102.html","المتقارب"],[240,"عسى قاعد الحظ يوما يثب","https://www.aldiwan.net/poem32180.html","المتقارب"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[333,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[371,"فعالك في العلياء أسمى وأسمح","https://www.aldiwan.net/poem17315.html","الطويل"],[382,"أزل يا شقيق الروح مني بقيتي","https://www.aldiwan.net/poem66906.html","الطويل"],[438,"يروع الذئب حيث سواك راع","https://www.aldiwan.net/poem12377.html","الوافر"],[463,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[484,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[498,"إذا استلك الجانون أغمدك الحلم","https://www.aldiwan.net/poem67329.html","الطويل"],[543,"بحقكم في مهجتي راقبوا الربا","https://www.aldiwan.net/poem48266.html","عموديه"],[556,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[556,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[580,"يصير خنصره عاطلاً","https://www.aldiwan.net/poem2931.html","المتقارب"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107202","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96662","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96681","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202107","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64896","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48927","الطويل"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45402","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/199439","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124737","الطويل"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76906","البسيط"],[190,"","https://poetry.dctabudhabi.ae/diwan/poem/98519","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100885","الوافر"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107172","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204590","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100725","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62815","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138547",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85061","المتقارب"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44692","الوافر"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147295","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139580",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52136","المتقارب"],[4699,"الموت عشقاً","https://www.poetsgate.com/ViewPoem.aspx?id=155947",""],[4955,"حروفُ العز","https://www.poetsgate.com/ViewPoem.aspx?id=188036",""],[4984,"حسن إختيار أو انهيار","https://www.poetsgate.com/ViewPoem.aspx?id=191329",""],[5145,"ردّ المدامة عني أيها الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=108137",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[592,"على قلة الداعي وقلة ذي الفهم","https://www.poetsgate.com/ViewPoem.aspx?id=128814",""],[5447,"هطول","https://www.poetsgate.com/ViewPoem.aspx?id=208328",""],[5582,"أَتَرْدَعُنِي بِاللَّوْمِ وَالدَّهْرُ أَرْدَعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63534",""],[5582,"حَلِيفُ غَرامٍ عَزَّ مِنْهُ اصْطِبارُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=63515",""],[5686,"فإن ضاقت بك الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=203360",""],[5809,"سلوا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=205565",""],[5952,"قدِّيْ قميصي","https://www.poetsgate.com/ViewPoem.aspx?id=213399",""],[6149,"بأرض الحمى لا زال قلبي عاكف","https://www.poetsgate.com/ViewPoem.aspx?id=169625",""],[6152,"يارب خيرة","https://www.poetsgate.com/ViewPoem.aspx?id=202759",""],[5309,"ألم يعلموا ان السيادة بالمال","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573933",""],[5309,"عذابي اليم من مهاة اصابها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573548",""],[2588,"شاخصة ( صفقه)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65617&r=&rc=49",""],[6290,"فَأَيّامُنَا تَغْدُو جَمِيعًا نُفَمْبَرًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85153&r=&rc=18",""]],"verses":[["فَإِنَّ ضَلالي في النَهارِ لَهِجنَةٌ","وَإِنَّ ضَلالي في دُجى اللَيلِ أَعذَرُ",0,"ر",1,0],["فإنّ ضياءَ دينِ اللهِ جاري","عشيّةَ تَلْتَقي حَلَقُ البِطانِ",1,"ن",1,0],["فَإِنْ ضَحَا ظِلُّهُ فَالرُّوحُ مُرْصَدَةٌ","لِلْمَوْقِفِ الفَصْلِ مَنْ يَهْتِفْ بِهَا تُجِبِ",2,"ب",1,0],["فَإِنَّ ضُرُوبَ العِلْمِ جَمٌّ عَدِيدُهَا","وَإِنَّ ضُرُوبَ الْفَنِّ تُعْجِزُ مَنْ حَسَبْ",3,"ب",1,0],["فإن ضنِنت بميم كاسْتِ صاحبها","فبدِّل العينَ غيناً أيها الغَمَر",4,"ر",1,0],["فانضُهُ سالِماً عليه موقَّىً","بنحورِ العدا سهامَ المنون",5,"ن",1,0],["فَإِن ضَمَّهُ مِن مُستَوي الأَرضِ ضَيِّقٌ","فَكَم وَسِعَ الأَرضَ العَريضَةَ نائِلُه",6,"ل",2,0],["فإنْ ضاعَ قَوْلِي في سِوَاكَ ضلالَةً","فما أنَا بالماضي مِنَ القَوْلِ مُعْتَدُّ",7,"د",1,0],["فَإِن ضَرَبتَ بِسَيفِ الهِندِ في وَمَدٍ","فَسَيفُ إِفرِنجَةَ المَخبوءُ لِلشَبَمِ",8,"م",1,0],["فأنْضَى علِيٌّ خيْلَه ورِكابَهُ","ولم يأتِ إلاّ فوْقَ اعْتِزامهِ",9,"م",2,0],["فَإِن ضَيَّعَت حَقّي لُكَيزٌ وَأَنكَرَت","بَنُو عامِرٍ سَعيي لَها وَاِجتِهادِيا",10,"ي",2,0],["فإن ضجرا لخلف أو لبؤس","فبين الضجرتين ترى الوقاحه",11,"ح",2,0],["فإن ضاق صدري بكظم الأذى","على مقبل منه أو فائت",12,"ت",1,0],["فَأَنضَبَ ماءَ الوُجوهِ السُؤالُ","وَوَجهي بِجَمَّتِه ما نَضَب",13,"ب",1,0],["فَأَنضى اللّيالي الدهم غير مُغوّرٍ","وَأَثنى على التعريس أيّامي الشهبا",14,"ب",2,0],["فانضح زمانك بالدموع","فأنت من بلواه خادر",15,"ر",1,0],["فَإِن ضاقَ ذاكَ البِشرُ بَعدَ اِتِّساعِهِ","فَما ضاقَ في الأَرضِ الفَسيحَةِ مَسرَحُ",16,"ح",1,0],["فإن ضاع قدماً من جرى أكل ثمرة","فقد ضاء بعداً من جنى أصل ثمرة",17,"ه",1,0],["فإِنْ ضاعَفْتَ في حقِّي اصطِناعاً","فقَدْ ألْفَيْتَ أَهلَ الإِصْطِناعِ",18,"ع",1,0],["فانضح على ما خيّلتْ لهذه","ببلّةٍ تُنقِع من أُوامِها",19,"م",3,0],["فانضم في سلكنا من أسرة المرا","نبي شعر فأرخناه باللقب",20,"ب",1,0],["فَإِن ضاقَ عَنها العُذرُ عِندَكَ في الَّذي","جَنَتهُ فَما ضاقَ التَفَضُّلُ وَالحِلمُ",21,"م",1,0],["فإنَّ ضَميري ليسَ يَبرَحُ شَاهِرا","لِحَربٍ إذا ما شِبتُ من هَولها شَبَّا",22,"ب",2,0],["فإنْ ضاقت الأرضُ الفضا بعد فقده","فقد وسعته تربةٌ لا تضيقُهُ",23,"ق",2,0],["فإنْ ضَرَبْتَ فماضٍ","قدّ الضّريبة قدّا",24,"د",2,0],["فإِن ضجَّ من رِدْفِهِ خَصْرُهُ","لقد ضَجَّ من خَصْرهِ خِنْصَرُهْ",25,"ر",2,0],["فانضَحَا لِي قميصَها واسقِياني","إِنَّ ليِ فيهِ مِن سِقامي دُويَّا",26,"ي",2,0],["فإنّ ضرامَ النارِ يخرج سقطه","إِلى الزند منه مرخه وغفارهُ",27,"ر",2,0],["فَإِن ضاقتِ الآفاقُ ذرعاً بما جرى","فَحكمكَ منها يا اِبن نبهان أوسعُ",28,"ع",1,0],["فإن ضاق بي يوما خناقي وضاق بي","سبيلُ النجاة ناديت يا آل أحمدا",29,"د",2,0],["فإِنَّ ضَلالاً مِنْكما إنْ رَجَوتُما","لِنَفسٍ دَعاها الحُبُّ إِنِّي عَتيقُها",30,"ق",3,0],["فإن ضميرَ المرء اقدسُ معبدٍ","ففيه إذا شئتِ الصًّلاحَ تعبّدي",31,"د",2,0],["فَأَنضَبَتِ المَنايا مِنهُ بَحراً","جَواريهِ صُفونٌ لا سَفينِ",32,"ن",1,0],["فإن ضاعت لديك فأنت شمس","يشب تعسفي فيها الذبالا",33,"ل",2,0],["فإن ضيعت منهن خودٌ صلاتها","إذا جاء فلتبدل ولا تتجرثم",34,"م",1,0],["فانضاف عِندي إلى رجال","علمي لهم نافذ وَمالي",35,"ل",2,0],["فإن ضاق صدري بالتفرّد والقلى","ذكرت الذي لا قيت فاتسع الصدر",36,"ر",1,0],["فأنضرتَ الفيافَى فاستظلوا","بنعمتِها وعمَّرت الخرابا",37,"ب",2,0],["فإِنَّ ضِعافَ الحلمِ حَطُّوا سَماءهُ","عَلَى الأَرضِ حَتى نالَ مِنهُ قُرُودُها",38,"د",3,0],["فإن ضاق صدرا عن تأجج شوقه","تأوه في أنفاس ماء مبخر",39,"ر",1,0],["فان ضحي ظله أحبت محامدَه","آثارُ ابلج بزّت كلَّ آثار",40,"ر",1,0],["فأنْضِجْها بكَيِّكَ لا تَذرها","مُعرضةً لكيدِ الكَيْذُبانِ",41,"ن",1,0],["فان ضاق عيشي برهةً فلحكمةٍ","ولا عجز يثنيه ولا بخل يحجب",42,"ب",1,0],["فإن ضاق أمر فقل سادتي","أجيبوا فراجيكم ما يخيب",43,"ب",1,0],["فَإِن ضاقَ الخِناقٌ وَلَم تَجِدني","فَعِندَك مُصطَفى عَني يَنوبُ",44,"ب",1,0],["فإن ضاقت زاويا العمر دهرا","فلا جزع فيوما تستطيل",45,"ل",1,0],["فإن ضلَّت العلياء أنت دليلهُا","وإن أُزعِجَت يوماً حماك مَعاجها",46,"ج",3,0],["فإن ضلً بعض البنين الأثرْ","فدعهمُ في جهلهم يعمهونْ",47,"ن",1,0],["فإن ضاع قلبيَّ في منتهاك","فَنِعْماً لقلبي .. ومَن ضَيَّعه",48,"ع",2,0],["فإنْ ضاقت عليَّ بيومِ عسرٍ","دعوتُ اللهَ أن ينزاحَ كربي",49,"ب",2,0],["فإن ضعاف الخلق يلتف حولهم","ذوو الطمع المنبوذ أكثرهم جهلا",50,"ل",2,0],["فإن ضللت فلي ظلّ الدجى عذرٌ","لا غرو أن ضلّ مشاءٌ بإغساق",51,"ق",1,0],["فإن ضرعت فله تضرعي","وإن ذللت فله لا للسوى",52,"ا",1,0],["فإن ضعيف الرأي لا يستطيعه","وليس له ذوق ولم يك ذا شتم",53,"م",1,0],["فإن ضنَّت عيون العقل يومًا","أجَزتُ لها دماءَ القلبِ عينا",54,"ن",2,0],["فإِنْ ضاقَتْ الآفاقُ ذَرْعاً بِما جَرَى","فَحِلْمُكَ مِنْها يا ابْنَ نَبْهانَ أَوْسَعُ",55,"ع",1,0],["فَإِنَّ ضِرامَ النَّارِ يُخْرِجُ سَقْطَهُ","إِلَى الزَّنْدِ مِنْهُ مَرْخُهُ وعَفارُهُ",56,"ر",2,0],["فإن ضاقت بك الأيام يوما","وحمل الدهر أضناك اختناقا",57,"ق",2,1],["فإن ضحكتْ فآخرُها بكاءٌ","وماعمَرَت تحوِّلُهُ خرابا",58,"ب",2,0],["فإن ضُبِطْنا ...وشى الوشاةُ بنا","وأَشْهَدوا .. البوَّابين والخَدَما",59,"م",2,0],["فإن ضعفت عن حق مدحك همتي","فإن فؤادي في الوداد يضاعف",60,"ف",1,0],["فإن ضاقت بنا الأحوال يوما","اقول لعلها يارب خيرة",61,"ر",2,0],["فَإِن ضَمَّهُم لِلبَحثِ في الحَقِّ مَجلِسٌ","فَكَم فَرَّقتهُم سَطوَةُ العِلمِ وَالمالِ",62,"ل",1,0],["فَإِن ضَيَّعَت حُبّي لإِرضاءِ غَيظِها","فَإِنَّ ضَياعَ الحُبِّ كانَ عِقابَها",63,"ب",3,0],["فانضوى متخذاً من","علماء السوء رُفقَهْ",64,"ق",2,0],["فَإِنْ ضَاقَتِ الدُّنْيَا عَلَيْنَا بِعَيْشِهَا","طَلَبْنَا سَوِيًّا عَيْشَنَا بِالتَّنَاهُدِ",65,"د",1,0]]}