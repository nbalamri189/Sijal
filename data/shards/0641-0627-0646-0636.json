{"poems":[[53,"رأيت شباب المرء ليلا يجنه","https://www.aldiwan.net/poem30214.html","الطويل"],[63,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[93,"شهدنا زمانا في الكنانة ردنا","https://www.aldiwan.net/poem9798.html","عموديه"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"أطلع الله وجه شهرِك هذا","https://www.aldiwan.net/poem66377.html","الخفيف"],[81,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[46,"اعدد لكل زمان ما يشاكله","https://www.aldiwan.net/poem23384.html","البسيط"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"]],"verses":[["فَإِنَّ ضَلالي في النَهارِ لَهِجنَةٌ","وَإِنَّ ضَلالي في دُجى اللَيلِ أَعذَرُ",0,"ر",1,0],["فإنّ ضياءَ دينِ اللهِ جاري","عشيّةَ تَلْتَقي حَلَقُ البِطانِ",1,"ن",1,0],["فَإِنْ ضَحَا ظِلُّهُ فَالرُّوحُ مُرْصَدَةٌ","لِلْمَوْقِفِ الفَصْلِ مَنْ يَهْتِفْ بِهَا تُجِبِ",2,"ب",1,0],["فَإِنَّ ضُرُوبَ العِلْمِ جَمٌّ عَدِيدُهَا","وَإِنَّ ضُرُوبَ الْفَنِّ تُعْجِزُ مَنْ حَسَبْ",3,"ب",1,0],["فإن ضنِنت بميم كاسْتِ صاحبها","فبدِّل العينَ غيناً أيها الغَمَر",4,"ر",1,0],["فانضُهُ سالِماً عليه موقَّىً","بنحورِ العدا سهامَ المنون",5,"ن",1,0],["فَإِن ضَمَّهُ مِن مُستَوي الأَرضِ ضَيِّقٌ","فَكَم وَسِعَ الأَرضَ العَريضَةَ نائِلُه",6,"ل",2,0],["فإنْ ضاعَ قَوْلِي في سِوَاكَ ضلالَةً","فما أنَا بالماضي مِنَ القَوْلِ مُعْتَدُّ",7,"د",1,0],["فَإِن ضَرَبتَ بِسَيفِ الهِندِ في وَمَدٍ","فَسَيفُ إِفرِنجَةَ المَخبوءُ لِلشَبَمِ",8,"م",1,0],["فأنْضَى علِيٌّ خيْلَه ورِكابَهُ","ولم يأتِ إلاّ فوْقَ اعْتِزامهِ",9,"م",2,0]]}