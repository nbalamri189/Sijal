{"poems":[[53,"رأيت شباب المرء ليلا يجنه","https://www.aldiwan.net/poem30214.html","الطويل"],[63,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[93,"شهدنا زمانا في الكنانة ردنا","https://www.aldiwan.net/poem9798.html","عموديه"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"أطلع الله وجه شهرِك هذا","https://www.aldiwan.net/poem66377.html","الخفيف"],[81,"يجد الردى فينا ونحن نهازله","https://www.aldiwan.net/poem61497.html","الطويل"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[46,"اعدد لكل زمان ما يشاكله","https://www.aldiwan.net/poem23384.html","البسيط"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[169,"أبت نوب الأيام إلا تماديا","https://www.aldiwan.net/poem1691.html",""],[186,"إذا خطب الفقير إلى فقير","https://www.aldiwan.net/poem43982.html","الوافر"],[186,"كفى حزنا ما أرى حل بي","https://www.aldiwan.net/poem44102.html","المتقارب"],[235,"عسى قاعد الحظ يوما يثب","https://www.aldiwan.net/poem32180.html","المتقارب"],[305,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[328,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[366,"فعالك في العلياء أسمى وأسمح","https://www.aldiwan.net/poem17315.html","الطويل"],[377,"أزل يا شقيق الروح مني بقيتي","https://www.aldiwan.net/poem66906.html","الطويل"],[432,"يروع الذئب حيث سواك راع","https://www.aldiwan.net/poem12377.html","الوافر"],[458,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[479,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[493,"إذا استلك الجانون أغمدك الحلم","https://www.aldiwan.net/poem67329.html","الطويل"],[538,"بحقكم في مهجتي راقبوا الربا","https://www.aldiwan.net/poem48266.html","عموديه"],[551,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[551,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[575,"يصير خنصره عاطلاً","https://www.aldiwan.net/poem2931.html","المتقارب"]],"verses":[["فَإِنَّ ضَلالي في النَهارِ لَهِجنَةٌ","وَإِنَّ ضَلالي في دُجى اللَيلِ أَعذَرُ",0,"ر",1,0],["فإنّ ضياءَ دينِ اللهِ جاري","عشيّةَ تَلْتَقي حَلَقُ البِطانِ",1,"ن",1,0],["فَإِنْ ضَحَا ظِلُّهُ فَالرُّوحُ مُرْصَدَةٌ","لِلْمَوْقِفِ الفَصْلِ مَنْ يَهْتِفْ بِهَا تُجِبِ",2,"ب",1,0],["فَإِنَّ ضُرُوبَ العِلْمِ جَمٌّ عَدِيدُهَا","وَإِنَّ ضُرُوبَ الْفَنِّ تُعْجِزُ مَنْ حَسَبْ",3,"ب",1,0],["فإن ضنِنت بميم كاسْتِ صاحبها","فبدِّل العينَ غيناً أيها الغَمَر",4,"ر",1,0],["فانضُهُ سالِماً عليه موقَّىً","بنحورِ العدا سهامَ المنون",5,"ن",1,0],["فَإِن ضَمَّهُ مِن مُستَوي الأَرضِ ضَيِّقٌ","فَكَم وَسِعَ الأَرضَ العَريضَةَ نائِلُه",6,"ل",2,0],["فإنْ ضاعَ قَوْلِي في سِوَاكَ ضلالَةً","فما أنَا بالماضي مِنَ القَوْلِ مُعْتَدُّ",7,"د",1,0],["فَإِن ضَرَبتَ بِسَيفِ الهِندِ في وَمَدٍ","فَسَيفُ إِفرِنجَةَ المَخبوءُ لِلشَبَمِ",8,"م",1,0],["فأنْضَى علِيٌّ خيْلَه ورِكابَهُ","ولم يأتِ إلاّ فوْقَ اعْتِزامهِ",9,"م",2,0],["فَإِن ضَيَّعَت حَقّي لُكَيزٌ وَأَنكَرَت","بَنُو عامِرٍ سَعيي لَها وَاِجتِهادِيا",10,"ي",2,0],["فإن ضجرا لخلف أو لبؤس","فبين الضجرتين ترى الوقاحه",11,"ح",2,0],["فإن ضاق صدري بكظم الأذى","على مقبل منه أو فائت",12,"ت",1,0],["فَأَنضَبَ ماءَ الوُجوهِ السُؤالُ","وَوَجهي بِجَمَّتِه ما نَضَب",13,"ب",1,0],["فَأَنضى اللّيالي الدهم غير مُغوّرٍ","وَأَثنى على التعريس أيّامي الشهبا",14,"ب",2,0],["فانضح زمانك بالدموع","فأنت من بلواه خادر",15,"ر",1,0],["فَإِن ضاقَ ذاكَ البِشرُ بَعدَ اِتِّساعِهِ","فَما ضاقَ في الأَرضِ الفَسيحَةِ مَسرَحُ",16,"ح",1,0],["فإن ضاع قدماً من جرى أكل ثمرة","فقد ضاء بعداً من جنى أصل ثمرة",17,"ه",1,0],["فإِنْ ضاعَفْتَ في حقِّي اصطِناعاً","فقَدْ ألْفَيْتَ أَهلَ الإِصْطِناعِ",18,"ع",1,0],["فانضح على ما خيّلتْ لهذه","ببلّةٍ تُنقِع من أُوامِها",19,"م",3,0],["فانضم في سلكنا من أسرة المرا","نبي شعر فأرخناه باللقب",20,"ب",1,0],["فَإِن ضاقَ عَنها العُذرُ عِندَكَ في الَّذي","جَنَتهُ فَما ضاقَ التَفَضُّلُ وَالحِلمُ",21,"م",1,0],["فإنَّ ضَميري ليسَ يَبرَحُ شَاهِرا","لِحَربٍ إذا ما شِبتُ من هَولها شَبَّا",22,"ب",2,0],["فإنْ ضاقت الأرضُ الفضا بعد فقده","فقد وسعته تربةٌ لا تضيقُهُ",23,"ق",2,0],["فإنْ ضَرَبْتَ فماضٍ","قدّ الضّريبة قدّا",24,"د",2,0],["فإِن ضجَّ من رِدْفِهِ خَصْرُهُ","لقد ضَجَّ من خَصْرهِ خِنْصَرُهْ",25,"ر",2,0]]}