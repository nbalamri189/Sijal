{"poems":[[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[83,"يا خير من ملك الملوك بجوده","https://www.aldiwan.net/poem54266.html","الكامل"],[27,"بات هلال بالخضارم موجفا","https://www.aldiwan.net/poem5932.html","الطويل"],[27,"أصبح حبل وصلكم رماما","https://www.aldiwan.net/poem5987.html","الوافر"],[91,"سلام عليها طفلة وفتية","https://www.aldiwan.net/poem8831.html","عموديه"],[70,"أمذكري عهد الصبا","https://www.aldiwan.net/poem42826.html","مجزوء الكامل"],[85,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[62,"وسفرجل عني المصيف بحفظه","https://www.aldiwan.net/poem52397.html","الكامل"],[45,"ظلم الدهر فيكم وأساء","https://www.aldiwan.net/poem10207.html","الخفيف"],[45,"شغلان من عذل ومن تفنيد","https://www.aldiwan.net/poem63493.html","الكامل"],[61,"أهجرا كان صدك أم ملالا","https://www.aldiwan.net/poem51492.html","الوافر"],[66,"قال النبي مقال صدق لم يزل","https://www.aldiwan.net/poem38627.html","الكامل"],[66,"أسلبن من فوق النهود ذوائبا","https://www.aldiwan.net/poem41382.html","الكامل"],[31,"يا خليلي سائلا الأطلالا","https://www.aldiwan.net/poem41846.html","الخفيف"],[31,"يا صاحبي قفا نقض لبانة","https://www.aldiwan.net/poem42469.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[46,"سألت منجمها عن الطفل الذي","https://www.aldiwan.net/poem22701.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39594","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142010","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[100,"روح شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50166",""],[100,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[45,"شُغْلانِ مِنْ عَذْلٍ وَمِنْ تَفْنيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31609",""],[31,"يا صاحبيّ، قفا نقضِّ لبانة ً،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18929&r=&rc=192",""],[110,"ذهب الشراع وصلت الملاح","https://www.aldiwan.net/poem16524.html","الكامل"],[121,"لذة العيش في مدام وخد","https://www.aldiwan.net/poem49316.html","الخفيف"],[125,"يا مدعي عام اللواء","https://www.aldiwan.net/poem23712.html","مجزوء الكامل"],[125,"فتنتك تذكارات ميه","https://www.aldiwan.net/poem23746.html","مجزوء الكامل"],[133,"بذات الدخن أدورة بوال","https://www.aldiwan.net/poem54764.html","الوافر"],[136,"بربك يا زيدان هل كنت تعلم","https://www.aldiwan.net/poem49175.html","الطويل"],[143,"وددت التصابى فيك إذ كان عاذرى","https://www.aldiwan.net/poem58434.html","الطويل"],[211,"أطلعن من فلك الجيوب كواكبا","https://www.aldiwan.net/poem13376.html","الكامل"],[230,"شبهتها بالبدر فاستضحكت","https://www.aldiwan.net/poem51092.html","السريع"],[233,"لا نال قلبي منكم ما أملا","https://www.aldiwan.net/poem14722.html","الكامل"],[238,"أبلغهم مألكا عن قلب من ملكوا","https://www.aldiwan.net/poem18848.html","البسيط"],[262,"أفديك مالكتي إلا","https://www.aldiwan.net/poem38219.html","مجزوء الكامل"],[272,"أيرجع لي قرب الحبيب المعاهد","https://www.aldiwan.net/poem52107.html","الطويل"],[283,"رموا الجمار وفي فؤادي منهم","https://www.aldiwan.net/poem32451.html","الكامل"],[283,"ضربت لزينب بالغوير خيام","https://www.aldiwan.net/poem32462.html","الكامل"],[299,"تعالى المبدع القدس","https://www.aldiwan.net/poem36858.html","عموديه"],[305,"كم بقلبي فيك من شجن","https://www.aldiwan.net/poem16838.html","المديد"],[323,"ألا هاج قلبي العام ظعن بواكر","https://www.aldiwan.net/poem56358.html","الطويل"],[354,"رد الجدول الصافي الذي ضم أبحرا","https://www.aldiwan.net/poem39982.html","الطويل"],[364,"عرفت لليلى بين وقط فضلفع","https://www.aldiwan.net/poem1699.html","الطويل"],[365,"أصون سمعك عن شكواي إجلالا","https://www.aldiwan.net/poem60797.html","البسيط"],[404,"كان السفائن سابقا","https://www.aldiwan.net/poem34136.html","مجزوء الكامل"],[407,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[407,"قولا له هل دار في حوبائه","https://www.aldiwan.net/poem50212.html","الكامل"],[433,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[438,"أرأيت ما صنعت لحاظ الغيد","https://www.aldiwan.net/poem2612.html","الكامل"],[459,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[459,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[471,"يبكي لما قلب الزمان جديده","https://www.aldiwan.net/poem4780.html","الكامل"],[478,"رضيت بربقة العشاق حبسا","https://www.aldiwan.net/poem15212.html","الوافر"],[552,"أبا بكر تعرضت المنايا","https://www.aldiwan.net/poem47723.html","الوافر"],[554,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[559,"لا يرى الفقه الإلهي","https://www.aldiwan.net/poem33673.html","مجزوء الرمل"]],"verses":[["وسَفَرْنَ منْ دهَشِ الوَداعِ وقوْمُهُنْ","نَ الى التّرحُّلِ قدْ أناخُوا العِيسا",0,"س",2,0],["وسفائنِ مشحونةٍ ألقى بها","بحرُ السماح يجيش من نُعماكا",1,"ك",2,0],["وَسُفيانُ خَوّاضٌ إِلى حارَةِ الوَغى","وَلوجٌ إِذا ما هيبَ بابُ السُرادِقِ",2,"ق",1,0],["وَسُفعاً في المَنازِلِ خالِداتٍ","وَقَد تَرَكَ الوَقودُ بِهِنَّ شاما",3,"م",2,0],["وَسِفرٌ تَلَذُّ المَرءَ مُحتَوَياتُهُ","إِذا لَم يَكُن في البَيتِ ناس وَلا سَفَرُ",4,"ر",1,0],["وَسَفَرتُ لِلمَلِكِ العَظي","مِ الشَأنِ وَالقَدرِ الرَفيعِ",5,"ع",1,0],["وَسَفينَ آمِرٍ فيها البِلى","طالَما أَوحَت إِلَيهِ فَأتَمَر",6,"ر",1,0],["وَسَفينٌ طَوراً تَلوحُ وَحيناً","يَتَوَلّى أَشباحَهُنَّ الخَفاءُ",7,"ا",2,0],["وسَفرْجَلٍ عُنِيَ المصيفُ بحفظهِ","فكساهُ قبلَ البَرْدِ خَزَّاً أخضرَا",8,"ر",2,1],["وَسَفاهٌ أَن يَجزَعَ المَرءُ مِمّا","كانَ حَتماً عَلى العِبادِ قَضاءَ",9,"ا",2,0],["وَسَفَرنَ فَاِمتَلَأَت عُيونٌ راقَها","وَردانِ وَردُ جَناً وَوَردُ خُدودِ",10,"د",1,0],["وسَفرٍ يحسَبون البَرَّ سَفراً","يُصافحُهم إذا ما السيرُ طَالا",11,"ل",2,0],["وَسَفَرتَ عَن أَفعالِ سوءٍ أَصبَحَت","بَينَ الأَنامِ قَليلَةَ الأَشباهِ",12,"ه",1,0],["وَسَفَرنَ لي فَرَأَينَ شَخصاً حاضِراً","شُدِهَت بَصيرَتُهُ وَقَلباً غائِباً",13,"ب",2,0],["وَسَفاهٌ لَولا الصَبابَةُ حَبسي","في رُسومِ الدِيارِ رَكباً عِجالا",14,"ل",2,0],["وَسَفاهَةً بِالمَرءِ صَرمُ صَديقِهِ","يُرضي بِهِجرَتِهِ العَدوَّ المُبغِضا",15,"ض",2,0],["وسَفيهٌ من ساءَه المنُّ والسَّلْ","وَى وأَرضاهُ الفُومُ وَالقِثَّاءُ",16,"ا",2,0],["وسُفْنٌ إذا ما خاضتِ اليمّ زاخراً","جلَتْ عن بياض النصر وهي غرابيب",17,"ب",1,0],["وَسَفاهَةُ الإِنسانِ مَوهِمَةٌ لَهُ","بَذَّ القَوارِحِ في الرِهانِ بِمُهرِهِ",18,"ر",2,0],["وسفينةٌ مهجورةٌ محطومةٌ","حَمَلتْ لها البشرى طيورُ الماءِ",19,"ا",2,0],["وسفحنا في «دجلةٍ» قلبَ «لبنا","نَ»، وأجفانَه الهوامي الهوائم",20,"م",1,0],["وَسَفِينَتِي نَرْنٌ بِهَا","مَا في فُؤَادِي مِنْ وُقُودِ",21,"د",1,0],["وَسَفِينٌ مَا شَارَفَ الشَّطَّ حَتَّى","مزَّقَ الْيَمُّ دُسْرَهُ بِعُبَابِهْ",22,"ب",2,0],["وسفير تشيّد الوحدة الشما","وتستنهض السنا في البصائر",23,"ر",1,0],["وسفوح تهمي ثغاه وحبا","وحقول تروي نبوغ الحظيره",24,"ر",2,0],["وَسَفَرْنَ، فامتَلأتْ عُيُونٌ رَاقَها","وَرْدانِ وَرْدُ جَنًى وَوَرْدُ خُدُودِ",25,"د",1,0],["وَسفاهَة ٌ بِکلْمَرْءِ صَرْمُ صَديقِهِ","يُرْضِي بِهجْرَتِهِ العَدُوَّ المُبْغِضا:",26,"ض",2,0],["وَسَفينَتي لَم يَبقَ مِنها قطعة","إِلّا وَمَزقها بِلا وَرباح",27,"ح",1,0],["وسفاهاً أرى فراري مما","هو حتمٌ ما إن له من مرد",28,"د",1,0],["وسفوح شيحان الأَغن","بكل يانعة سخية",29,"ي",2,0],["وسفوح شيحان الأغن","بكل مكرمة غنية",30,"ي",2,0],["وَسفعٌ كَالحَمَائِمِ خَالِدَاتٍ","مُنَاخَاتٍ ونُؤىٌ كَالهِلاَلِ",31,"ل",1,0],["وسفْنٍ تبارت في المسير أراقماً","إذا زال منها أرقم صال أرقمُ",32,"م",1,0],["وسُفعِ أئافىٍّ كانّ رَمادَها","حمائمُ لكن هنَّ غيرُ طوائرِ",33,"ر",1,0],["وسفرن من هالاتهن أهلّة","يبدين من فرط الدلال غرائبا",34,"ب",2,0],["وسفَّهتْ قولي وقالت متى","سَمُجْتُ حتى صرتُ كالبدر",35,"ر",1,0],["وَسَفَحتُمُ دَمَ أَدمُعي لَمّا غَدا","سَفحُ الغُوَيرِ لَكُم بَرغمي مَنزِلا",36,"ل",2,0],["وَسُفْ ضَرِيحَ الْبُخَارِي فَإِنَّ بِهِ","بُخُورَ خُلْدٍ بِفِهْرِ الْحَمْدِ مُنْهَمِكُ",37,"ك",1,0],["وسفرت باسمة فراسل","در دمعي دُر برقك",38,"ك",1,0],["وَسفك دمي عَن سفح دمعي مفهم","بان عيون العين سم الاساود",39,"د",1,0],["وَسَفَرنَ عِندَ طَوافِنا عَن أَوجُهٍ","شَمسُ الضُحى حَسَداً لَها تَتَلَثَّمُ",40,"م",1,0],["وَسَفَرنَ لي عَن أَوجُهٍ وَغَدائِرٍ","فَتَعانَقَ الإِصباحُ وَالإِظلامُ",41,"م",1,0],["وسفرٌ فيه آياتٌ","من الإِبداعِ تلتمس",42,"س",1,0],["وسفين للنجاة إذا","خفن من طوفان كل أذى",43,"ذ",2,0],["وَسُفعٌ ضَبَت أَنصافَها النارُ رُكَّدٌ","وَأَورَقُ هابٍ كَالحَمامَةِ دائِرُ",44,"ر",1,0],["وَسفرٌ عَن الإِسعاف أَسفَر مُسعداً","فَكانَ بِهِ التَحصيل لِلفَضل حاصِلا",45,"ل",2,0],["وَسُفعٍ صُلينَ النارَ حَولاً كَأَنَّما","طُلينَ بِقارٍ أَو بِزفتٍ مُلَمَّعِ",46,"ع",1,0],["وسَفرةٌ سَفَرَتْ لي في فِنائِهمُ","عن وجْهِ شَمطاءَ لا حُسْناً ولا مالا",47,"ل",2,0],["وسفينة الولد النج","يب أتت بمرثاة الكلاب",48,"ب",1,0],["وَسفحن لِلبين المَدامِع فاِلتَقى","دُرّانِ درُّ مَدامِعٍ وَجُمانِ",49,"ن",1,0],["وَسَفرنَ في جُنحِ الدُجى فَتَشابَهَت","بِاللَيلِ أَنجُم أَرضِهِ وَسَمائِهِ",50,"ا",3,0],["وسفرْنَ الغداةَ عن أوجُه من","دونِها في بهائها الأقمارُ",51,"ر",1,0],["وسفينة الآمال دونك لجّجت","حتى استوت بالجود فوق الجودي",52,"د",2,0],["وسفرتْ عن الوفاء أوجهٌ","نواعمٌ بالغدرِ كانت تلتثِمْ",53,"م",1,0],["وسفّهني في أن تعلّقتُ مانعاً","فقلت وهل في الغانيات منيلُ",54,"ل",1,0],["وَسَفيهَةٍ هَبَّت عَلَيَّ بِسُحرَةٍ","جَهلاً تَلُومُ عَلى الثَواءِ وَتَعذِلُ",55,"ل",1,0],["وسفْتُ عبيرَ أثوابِ الغواني","ومِن لَعِبِ الحُليِّ سَمِعتُ جَرْسا",56,"س",2,0],["وسَفْرٌ لا يحين لهمْ إيابٌ","ولا يُرجى لغاربهمْ طلوعُ",57,"ع",1,0],["وَسَفَرنَ عَن غُرَرِ الوُجوهِ كَأَنَّها","بِاللَيلِ مِصباحٌ بِبيعَةِ راهِبِ",58,"ب",1,0],["وسفيه كل من قا","س كريما بسفيهِ",59,"ي",2,0]]}