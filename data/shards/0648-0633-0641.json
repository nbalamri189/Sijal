نوافح مسكٍ فتقت أم نوافج","https://www.poetsgate.com/ViewPoem.aspx?id=108237",""],[5168,"ضنيتك ملاك","https://www.poetsgate.com/ViewPoem.aspx?id=33620",""],[5186,"أبدع الله في الورى تجنيسه","https://www.poetsgate.com/ViewPoem.aspx?id=156436",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5358,"فقدان ذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=135",""],[5431,"التعريف الحقيقي للحثالة","https://www.poetsgate.com/ViewPoem.aspx?id=183036",""],[5431,"كيّ الذهب...","https://www.poetsgate.com/ViewPoem.aspx?id=214701",""],[327,"ألا هاج قلبي العام ظعنٌ بواكر","https://www.poetsgate.com/ViewPoem.aspx?id=3814",""],[5616,"عامان","https://www.poetsgate.com/ViewPoem.aspx?id=205247",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5776,"وجوه الأقفية المعطوبة","https://www.poetsgate.com/ViewPoem.aspx?id=199326",""],[5809,"إبحار","https://www.poetsgate.com/ViewPoem.aspx?id=205094",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5975,"قريتي","https://www.poetsgate.com/ViewPoem.aspx?id=52985",""],[5997,"ثَغْرُ الحَنَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=214535",""],[6102,"حطب الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=183654",""],[6102,"طيب","https://www.poetsgate.com/ViewPoem.aspx?id=184439",""],[6209,"كفران","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82547&r=&rc=16",""],[6259,"قولا له هل دارَ في حوبائهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59352&r=&rc=0",""],[6273,"قواف ٍ في ركب السراة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78507&r=&rc=5",""],[6277,"العبودية الكبرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64441&r=&rc=0",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""],[6336,"الدوحة الباكية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73554&r=&rc=15",""]],"verses":[["وسَفَرْنَ منْ دهَشِ الوَداعِ وقوْمُهُنْ","نَ الى التّرحُّلِ قدْ أناخُوا العِيسا",0,"س",2,0],["وسفائنِ مشحونةٍ ألقى بها","بحرُ السماح يجيش من نُعماكا",1,"ك",2,0],["وَسُفيانُ خَوّاضٌ إِلى حارَةِ الوَغى","وَلوجٌ إِذا ما هيبَ بابُ السُرادِقِ",2,"ق",1,0],["وَسُفعاً في المَنازِلِ خالِداتٍ","وَقَد تَرَكَ الوَقودُ بِهِنَّ شاما",3,"م",2,0],["وَسِفرٌ تَلَذُّ المَرءَ مُحتَوَياتُهُ","إِذا لَم يَكُن في البَيتِ ناس وَلا سَفَرُ",4,"ر",1,0],["وَسَفَرتُ لِلمَلِكِ العَظي","مِ الشَأنِ وَالقَدرِ الرَفيعِ",5,"ع",1,0],["وَسَفينَ آمِرٍ فيها البِلى","طالَما أَوحَت إِلَيهِ فَأتَمَر",6,"ر",1,0],["وَسَفينٌ طَوراً تَلوحُ وَحيناً","يَتَوَلّى أَشباحَهُنَّ الخَفاءُ",7,"ا",2,0],["وسَفرْجَلٍ عُنِيَ المصيفُ بحفظهِ","فكساهُ قبلَ البَرْدِ خَزَّاً أخضرَا",8,"ر",2,1],["وَسَفاهٌ أَن يَجزَعَ المَرءُ مِمّا","كانَ حَتماً عَلى العِبادِ قَضاءَ",9,"ا",2,0],["وَسَفَرنَ فَاِمتَلَأَت عُيونٌ راقَها","وَردانِ وَردُ جَناً وَوَردُ خُدودِ",10,"د",1,0],["وسَفرٍ يحسَبون البَرَّ سَفراً","يُصافحُهم إذا ما السيرُ طَالا",11,"ل",2,0],["وَسَفَرتَ عَن أَفعالِ سوءٍ أَصبَحَت","بَينَ الأَنامِ قَليلَةَ الأَشباهِ",12,"ه",1,0],["وَسَفَرنَ لي فَرَأَينَ شَخصاً حاضِراً","شُدِهَت بَصيرَتُهُ وَقَلباً غائِباً",13,"ب",2,0],["وَسَفاهٌ لَولا الصَبابَةُ حَبسي","في رُسومِ الدِيارِ رَكباً عِجالا",14,"ل",2,0],["وَسَفاهَةً بِالمَرءِ صَرمُ صَديقِهِ","يُرضي بِهِجرَتِهِ العَدوَّ المُبغِضا",15,"ض",2,0],["وسَفيهٌ من ساءَه المنُّ والسَّلْ","وَى وأَرضاهُ الفُومُ وَالقِثَّاءُ",16,"ا",2,0],["وسُفْنٌ إذا ما خاضتِ اليمّ زاخراً","جلَتْ عن بياض النصر وهي غرابيب",17,"ب",1,0],["وَسَفاهَةُ الإِنسانِ مَوهِمَةٌ لَهُ","بَذَّ القَوارِحِ في الرِهانِ بِمُهرِهِ",18,"ر",2,0],["وسفينةٌ مهجورةٌ محطومةٌ","حَمَلتْ لها البشرى طيورُ الماءِ",19,"ا",2,0],["وسفحنا في «دجلةٍ» قلبَ «لبنا","نَ»، وأجفانَه الهوامي الهوائم",20,"م",1,0],["وَسَفِينَتِي نَرْنٌ بِهَا","مَا في فُؤَادِي مِنْ وُقُودِ",21,"د",1,0],["وَسَفِينٌ مَا شَارَفَ الشَّطَّ حَتَّى","مزَّقَ الْيَمُّ دُسْرَهُ بِعُبَابِهْ",22,"ب",2,0],["وسفير تشيّد الوحدة الشما","وتستنهض السنا في البصائر",23,"ر",1,0],["وسفوح تهمي ثغاه وحبا","وحقول تروي نبوغ الحظيره",24,"ر",2,0],["وَسَفَرْنَ، فامتَلأتْ عُيُونٌ رَاقَها","وَرْدانِ وَرْدُ جَنًى وَوَرْدُ خُدُودِ",25,"د",1,0],["وَسفاهَة ٌ بِکلْمَرْءِ صَرْمُ صَديقِهِ","يُرْضِي بِهجْرَتِهِ العَدُوَّ المُبْغِضا:",26,"ض",2,0],["وَسَفينَتي لَم يَبقَ مِنها قطعة","إِلّا وَمَزقها بِلا وَرباح",27,"ح",1,0],["وسفاهاً أرى فراري مما","هو حتمٌ ما إن له من مرد",28,"د",1,0],["وسفوح شيحان الأَغن","بكل يانعة سخية",29,"ي",2,0],["وسفوح شيحان الأغن","بكل مكرمة غنية",30,"ي",2,0],["وَسفعٌ كَالحَمَائِمِ خَالِدَاتٍ","مُنَاخَاتٍ ونُؤىٌ كَالهِلاَلِ",31,"ل",1,0],["وسفْنٍ تبارت في المسير أراقماً","إذا زال منها أرقم صال أرقمُ",32,"م",1,0],["وسُفعِ أئافىٍّ كانّ رَمادَها","حمائمُ لكن هنَّ غيرُ طوائرِ",33,"ر",1,0],["وسفرن من هالاتهن أهلّة","يبدين من فرط الدلال غرائبا",34,"ب",2,0],["وسفَّهتْ قولي وقالت متى","سَمُجْتُ حتى صرتُ كالبدر",35,"ر",1,0],["وَسَفَحتُمُ دَمَ أَدمُعي لَمّا غَدا","سَفحُ الغُوَيرِ لَكُم بَرغمي مَنزِلا",36,"ل",2,0],["وَسُفْ ضَرِيحَ الْبُخَارِي فَإِنَّ بِهِ","بُخُورَ خُلْدٍ بِفِهْرِ الْحَمْدِ مُنْهَمِكُ",37,"ك",1,0],["وسفرت باسمة فراسل","در دمعي دُر برقك",38,"ك",1,0],["وَسفك دمي عَن سفح دمعي مفهم","بان عيون العين سم الاساود",39,"د",1,0],["وَسَفَرنَ عِندَ طَوافِنا عَن أَوجُهٍ","شَمسُ الضُحى حَسَداً لَها تَتَلَثَّمُ",40,"م",1,0],["وَسَفَرنَ لي عَن أَوجُهٍ وَغَدائِرٍ","فَتَعانَقَ الإِصباحُ وَالإِظلامُ",41,"م",1,0],["وسفرٌ فيه آياتٌ","من الإِبداعِ تلتمس",42,"س",1,0],["وسفين للنجاة إذا","خفن من طوفان كل أذى",43,"ذ",2,0],["وَسُفعٌ ضَبَت أَنصافَها النارُ رُكَّدٌ","وَأَورَقُ هابٍ كَالحَمامَةِ دائِرُ",44,"ر",1,0],["وَسفرٌ عَن الإِسعاف أَسفَر مُسعداً","فَكانَ بِهِ التَحصيل لِلفَضل حاصِلا",45,"ل",2,0],["وَسُفعٍ صُلينَ النارَ حَولاً كَأَنَّما","طُلينَ بِقارٍ أَو بِزفتٍ مُلَمَّعِ",46,"ع",1,0],["وسَفرةٌ سَفَرَتْ لي في فِنائِهمُ","عن وجْهِ شَمطاءَ لا حُسْناً ولا مالا",47,"ل",2,0],["وسفينة الولد النج","يب أتت بمرثاة الكلاب",48,"ب",1,0],["وَسفحن لِلبين المَدامِع فاِلتَقى","دُرّانِ درُّ مَدامِعٍ وَجُمانِ",49,"ن",1,0],["وَسَفرنَ في جُنحِ الدُجى فَتَشابَهَت","بِاللَيلِ أَنجُم أَرضِهِ وَسَمائِهِ",50,"ا",3,0],["وسفرْنَ الغداةَ عن أوجُه من","دونِها في بهائها الأقمارُ",51,"ر",1,0],["وسفينة الآمال دونك لجّجت","حتى استوت بالجود فوق الجودي",52,"د",2,0],["وسفرتْ عن الوفاء أوجهٌ","نواعمٌ بالغدرِ كانت تلتثِمْ",53,"م",1,0],["وسفّهني في أن تعلّقتُ مانعاً","فقلت وهل في الغانيات منيلُ",54,"ل",1,0],["وَسَفيهَةٍ هَبَّت عَلَيَّ بِسُحرَةٍ","جَهلاً تَلُومُ عَلى الثَواءِ وَتَعذِلُ",55,"ل",1,0],["وسفْتُ عبيرَ أثوابِ الغواني","ومِن لَعِبِ الحُليِّ سَمِعتُ جَرْسا",56,"س",2,0],["وسَفْرٌ لا يحين لهمْ إيابٌ","ولا يُرجى لغاربهمْ طلوعُ",57,"ع",1,0],["وَسَفَرنَ عَن غُرَرِ الوُجوهِ كَأَنَّها","بِاللَيلِ مِصباحٌ بِبيعَةِ راهِبِ",58,"ب",1,0],["وسفيه كل من قا","س كريما بسفيهِ",59,"ي",2,0],["وَسَفَرُ مَراحِلٍ وَذَوي حَياةِ","لَها بِالوَيلِ خَتمٌ وِاِبتِداءُ",60,"ا",2,0],["وَسَفَرنَ مِن دَهشِ النَوى فَكَأنَّما","بَرَزَت بُدُورٌ مِن بُرُوج قِبابِ",61,"ب",1,0],["وَسفهت في جَمع علي مِن الوَرى","وَغلقت باب الصلح خَوف الأَرذل",62,"ل",1,0],["وَسَفحُ مَدامِعٍ مع خَفقِ قَلبٍ","لأهل السَفح شَوقاً وَاللواءِ",63,"ا",2,0],["وسفع ثوين العام والعام قبله","وسحق رماد كالنصيف من العصب",64,"ب",1,1],["وسفائنٍ لم تَعْدُ طي","راً صِيْغَ من خَشَبٍ وقار",65,"ر",1,0],["وَسُفيانُ يَهدِيها كَأَنَّ لِواءَهُ","مِنَ الطَعنِ سِندٌ باتَ بِالصَبغِ مُجسَدا",66,"د",2,0],["وسفه حلمهم هرمُ المعالي","والأمرد والمكَهّل والوليد",67,"د",1,0],["وسفر جواري الفكر في أبحر الهدى","لتري في مرسى الأمان المطلمس",68,"س",1,0],["وسفَحتُ ماءَ العَين إذ فوتَّني","رَوقَ الشَّباب فمنه غِيضَ الماءُ",69,"ا",2,0],["وَسُفّ الرَّاح في روضٍ تثنَّت","به الأغصان من مَرِّ النَّسِيم",70,"م",1,0],["وسفرة قد جمعت حبوبا","الفول والخرطان والكبوبا",71,"ب",2,0],["وسفله كربع طول المنتصب","محققا نسخا ووضاحاً كتب",72,"ب",1,0],["وسفلوا ترويسَ وضعِ الألفِ","من مُردَفٍ كاللام في نقل يفي",72,"ي",1,0],["وسفح نواحيه يضاحك بعضه","غداة بكاه السحب وهو قطوب",73,"ب",1,0],["وسفكت دمعا من قل","وب حائرات من نواه",74,"ا",2,0],["وسفيرا ما بين عبد حبيب","في مقام الرضا ومولى محب",75,"ب",1,0],["وَسَفيرهم وَنَفيرهم وَجَريرهم","والطيرسون لمبهم الأَخبار",76,"ر",1,0],["وسفع عاريات حول هابٍ","شكونَ القُرَّ إن لم يصطلينا",77,"ن",2,0],["وسفيان بن أبرد وابن بحر","ومنا الفتية المتهلِّبونا",77,"ن",2,0],["وسفعاً من مدافعنا غلاظاً","ندك بها المتالع والجبالا",78,"ل",2,0],["وسف تربها تشف الجوى فبجوها","شفاء جو قد شفه شوقها جهدا",79,"د",2,0],["وسفيان العراق وليث مصرٍ","فقدماً كان معدوم المثال",80,"ل",1,0],["وَسُفعا ثَوين العامَ والعامَ قَبلَهُ","عَلى مَوقِدٍ ما بَينَهُنَّ دَقيقُ",81,"ق",1,0],["وَسُفعٍ كَأَكباد العِدا أَو كَأَنَّها","كَتائِبُ زَنجٍ كُلُّهُم فَوقَ أَدهمِ",82,"م",1,1],["وسفير الحظوظ جاء بشيرا","بالأماني وحقق المأمول",83,"ل",1,0],["وسفحت أسراب المدامع من دمي","والدّمع والدم منحة الأحباب",84,"ب",1,0],["وسفح الدموع بسفح العقيق","كلون العقيق وذوب الذهب",85,"ب",1,0],["وسفرجل لما أتى متجعداً","شبهته في الوصف والكيفية",86,"ه",1,0],["وسفينة ممدودة ونجومها","عدد الشهور منيرها في بهجة",87,"ه",1,0],["وسفكت دمي الحرام بماضي","اللحظ عمداً لا ماضيات الحدود",88,"د",1,0],["وسفهت نفسي لما غدوت","أفتش عن ضائع أبتر",89,"ر",1,0],["وسَفْرِ مُنىً جازتْ بعَزْمِي ومالَها","قناطرُ إلاَّ العِيسَ في أبْحُرِ الآلِ",90,"ل",1,1],["وسفى على اعتابها السافي وقد","كانت تقبلها شفاه اللاثم",91,"م",1,0],["وَسفرنَ عَن غررٍ صِباحٍ كَالصَبا","ح حفظنَها في لَيل شعرٍ واقب",92,"ب",1,0],["وَسفْنُ الأَماني وَإِن قَد جرت","ببحر المحال ستلقى اليبس",93,"س",1,0],["وسفرت عن وجهها رداءً","وأسفر اللون إذا أضاء",94,"ا",2,0],["وَسِفُلتَ بِالذُّلِّ والهُونِ عَن","بَني أُورَنُس مِن قَدِيمِ الزَّمَن",95,"ن",1,0],["وَسَفاهَةُ الأَيّامِ تَدفَعُهُم","نَحوَ الشُرورِ فَهَل هُمُ ادَّكَروا",96,"ر",3,0],["وسفَّهتُ رأي بني عامر","وقلت لمجنونها جَنَّتِ",97,"ت",1,0],["وسُفنُ صبري قد سارت على عَجَل","ومُهجتي وحشاشاتي بها ركبوا",98,"ب",3,0],["وَسُفعٌ كَذَودِ الهاجِرِيِّ بِجَعجَعٍ","تُحَفِّرُ في أَعقارِهِنَّ الهَجارِسُ",99,"س",1,0],["وسفت بها هوج الرياح فأصبحت","بعد الأنيس كأنها لم توهل",100,"ل",1,0],["وسفوح ليلي سولنا ومنانا","أحيا قلوب العاشقين بنشرها",101,"ه",2,0],["وسفيني مسافر وشراعي","غربة في مدائن لا تتاح",102,"ح",1,0],["وسفينةً للحبّ تحملني إلى","برّ الأمانِ وشاطئٍ فيه النجاةْ",103,"ه",1,0],["وسفينة الطاغوت غارقة، نعم","فالثقب لن تقوى عليه الأشرعة",104,"ع",2,