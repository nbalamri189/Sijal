{"poems":[[55,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[445,"بقاء الخلائق رهن الفناء","https://www.aldiwan.net/poem34882.html","المتقارب"],[463,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17046","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72460","الرجز"]],"verses":[["يَبُزُّ اللَيثَ جِلدَتَهُ","إِذا أَرداهُ باتِرُه",0,"ر",2,0],["يَبزُّ الحياةَ ببطشٍ شديدٍ","ويَلقى النفوسَ بدَاءٍ عياءِ",1,"ا",2,0],["يُبزلها استنانُها","بين المثاني والحِقَقْ",2,"ق",1,0],["يَبُزُّ مِنَ الأَنجادِ كُلَّ مُساوِرٍ","وَيَعلو مِنَ الأَمجادِ كُلَّ مُكارِمِ",3,"م",1,0],["يبزغ بدر السعد عن طرته","والنجم من غرَّته إذا بدا",4,"ا",1,0]]}