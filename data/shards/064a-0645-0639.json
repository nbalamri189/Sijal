{"poems":[[64,"أنعت نخلا تجتنى","https://www.aldiwan.net/poem52500.html","مجزوء الرجز"],[107,"مكسويني كتبت للناس درسا","https://www.aldiwan.net/poem43079.html","الخفيف"],[242,"أشكر لمندوصة خير الأخايير","https://www.aldiwan.net/poem18831.html","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205045","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139702",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139749",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139689",""],[5168,"شلون اكتب","https://www.poetsgate.com/ViewPoem.aspx?id=33618",""],[5168,"يالعندك جمال من الجمال اكثر","https://www.poetsgate.com/ViewPoem.aspx?id=92218",""],[5183,"الموقف الحق","https://www.poetsgate.com/ViewPoem.aspx?id=180156",""]],"verses":[["يُمعِنُ جُنْدُ الليل من","لقائِها في الهَربِ",0,"ب",1,0],["يُمعِنُ النَهضَةَ الأَبِيَّةَ تَشأى","غايَةَ المَضرحِيِّ في نَهضاتِهْ",1,"ت",2,0],["يَمْعُونَ يَبْغُونَ شَقّاً مِنْ غُبَارِكَ فِي","شَأْوِ الْعُلاَ مَا مُعَاءُ الْهِرِّ مِنْ زِيرِ",2,"ر",1,0],["يمعن الفكر فيه هل من أعادي","أهله أم لهم من الأحباب",3,"ب",1,0],["يمُّ علومٍ ورث العلم من","يمِّ علومٍ بالندى مترع",4,"ع",1,0],["يمُّ علمٍ طما بدرٍّ ومنه","لقطت أهل العلم دراً ثمينا",5,"ن",2,0],["يمُّ علمٍ على العوالم قد فا","ض فضاقت به وعاد وسيعا",6,"ع",2,0],["يمعلم الشعر معنه المعاناة","ومعلمني أظل كل ليلي كاعد",7,"د",1,0],["يمعود دخيلك اني من حبيت","كلت بس انته اريدك ما اريد اكثر",8,"ر",1,0],["يمعج معجاً خلف أهوائه","يدعه الشرق إلى الغرب",9,"ب",1,0]]}