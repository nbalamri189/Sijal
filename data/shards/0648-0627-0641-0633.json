{"poems":[[6,"أعمرو ابن فراشة الأشيم","https://www.aldiwan.net/poem385.html",""],[74,"تجلى فقلت البدر والليل شعره","https://www.aldiwan.net/poem18708.html","الطويل"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[83,"أضاع وقاري من علقت جماله","https://www.aldiwan.net/poem61447.html","الطويل"],[52,"وأفسى من الظربان في ليلة الكرى","https://www.aldiwan.net/poem62216.html","الطويل"],[48,"تراب جسومنا وهي التراب","https://www.aldiwan.net/poem22093.html","الوافر"],[463,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122543","الوافر"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109318","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28602","البسيط"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130782",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94311","الكامل"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142893","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111502","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83492","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133069","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83200","الرجز"],[4929,"سيأتي الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=200127",""],[585,"من ذا المطل يعاني العريَ والسقما","https://www.poetsgate.com/ViewPoem.aspx?id=161923",""]],"verses":[["وَأَفسَدتَ قَومَكَ بَعدَ الصَلاحِ","بَني يَشكُرَ الصَيدَ بِالمَلهَمِ",0,"م",1,0],["وأفسح من بحرِ البلاد وبرّها","ومدحي وآمالي نداه وصدره",1,"ر",2,0],["وأَفْسَح في السّماءِ لكم فكنتم","ملائكةً إليه مُقرَّبينا",2,"ن",2,0],["وَأَفسَدتُ بَينَ النَومِ فيهِ وَناظِري","وَأَكَّدتُ وُدّاً بَينَ فِكري وَوَسواسي",3,"س",2,0],["وَأَفسى مِنَ الظَربانِ في لَيلَةِ الكَرى","وَأَخلَفُ مِن صَقرٍ وَإِن كانَ قَد طَعِم",4,"م",1,1],["وَأَفسَدَ جَوهَرَ الأَحسابِ أَشبٌ","كَما فَسَدَت مِنَ الخَيلِ العِرابُ",5,"ب",1,0],["وأفسدوا الدنيا على أبنائها","فما ترى مثلَهُمُ فيمن تلدْ",6,"د",1,0],["وأفسدُ ما طَلَبَتَ له صَلاحا","هَوىً جَمعَ الشَّبيبةَ والمشيبا",7,"ب",2,0],["وأفسدت الأخلاق في غيبة التقى","ولم يُحترم دين هناك ومذهب",8,"ب",1,0],["وَأَفسَدوا بِجِوارِ الرُّومِ عَيشَهُمُ","إِن حارَبوا أَسَروا أَو سالَموا دَهَنوا",9,"ن",3,0],["وافسدت الطباعُ فلا خلاقٌ","ولا شرف يصان ولا حياءُ",10,"ا",2,0],["وافسح له في قبره","واجعله من أهل المبره",11,"ر",2,0],["وإفساد أذواق الصغار وإنه","هو الهدف المرسوم لو أننا ندري",12,"ر",2,0],["وأفسذيس نميريتيس قلينسا","أما ثيا من بشعر زانها وسموا",13,"م",3,0],["وَاِفسَحِ اللّهمّ في آجالِنا","مِنكَ بِالخَيرِ إذ العَيشُ فَسَح",14,"ح",1,0],["وأفسدوا الدين علن","وجانبوا حزب الرشاد",15,"د",1,0],["وَاِفسَح إِذا قيلَ اِفسَحِ","وَلا تَقُل لَم أَبرَحِ",16,"ح",1,0],["و.أفسدَ برًّا وأفسد َ بحراً","وعاث شمالاً وعاث جنوبا",17,"ب",2,0],["وافسح لكل ضعيف في الوجود مدى","والبس على صرخات القوة الصمما",18,"م",2,0]]}