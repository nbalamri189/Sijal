{"poems":[[93,"خرج الناس يشترون هدايا","https://www.aldiwan.net/poem8746.html","عموديه"],[45,"إثلث فإنا أيها الطلل","https://www.aldiwan.net/poem10138.html","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141035",""],[214,"قسما بحفظ عهودكم وودادي","https://www.aldiwan.net/poem13298.html","الطويل"],[214,"قف قليلاً يا حادي الركب","https://www.aldiwan.net/poem13301.html","الخفيف"],[276,"ودعتها والدمع يقطر بيننا","https://www.aldiwan.net/poem52117.html","الكامل"],[408,"يا واهب الجرد السلاهب","https://www.aldiwan.net/poem46913.html","مجزوء الكامل"],[415,"كيف أنساك يا أبا بكر أم كيغف","https://www.aldiwan.net/poem31853.html","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126149","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136376","الرمل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136372","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95575","الرمل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126273","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117923","الرمل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36725","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""]],"verses":[["وَإِلى حاسِدِيَّ عُمراً طَويلاً","لِيَدومَ الأَسى بِهِم مِمّا بي",0,"ب",2,0],["وَإِلى حَصى أَرضٍ أَقامَ بِها","بِالناسِ مِن تَقبيلِها يَلَلُ",1,"ل",1,0],["وإلى حصى أرضٍ أقام بها","بالنّاس من تقبيله يلل",2,"ل",1,0],["وإلى حياض الموت من شغف بهم","يتسابقون تسابق الوراد",3,"د",1,0],["والى حضرة الكمال دنا","ومن الله فاز بالقرب",4,"ب",1,0],["والى حَبيب الزائرين محمد","طربت حداة العيس بالاعناق",5,"ق",1,0],["وإلى حِماك بعثتُها","غرّاء تهزؤ بالكواكبْ",6,"ب",1,0],["وإلى حيثُ عرَّسَ السَّلفُ الأ","وَلُ ميعادُنا ومنه القُفُولُ",7,"ل",1,0],["وإلى حديث السر كم","أذني تميل وترغب",8,"ب",1,0],["وإلى حضرة مولانا الهما","م الامام القطب انهي ما لدي",9,"ي",1,0],["وإلى حسنها اشتياقي واني","في هواها ركبت صعبا وسهلا",10,"ل",2,0],["وإلى حيث مضى ذاك الجبان","يا أولى الألباب هل من مزدجر",11,"ر",1,0],["والى حماك يقول قلبى ناطقا","أنا شيق أنا شيق أنا شيق",12,"ق",1,0],["وإلى حضرتك الغرّاء من","مخلص الود الثناء العطرا",13,"ر",2,0],["وَإِلى حِماكَ الرَحبِ وافَت غادَةٌ","بَسّامَةٌ تُزهى كَبَدر تَمامِ",14,"م",1,0],["وإلى حيث لا مكان تعالت","فرأت عنده لها أترابا",15,"ب",2,0]]}