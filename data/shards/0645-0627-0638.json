{"poems":[[55,"يا دار فوز لقد أورثتني دنفا","https://www.aldiwan.net/poem26242.html","البسيط"],[30,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[27,"حي المنازل بالأجزاع فالوادي","https://www.aldiwan.net/poem5722.html","البسيط"],[51,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[51,"يا بني السمري لا تجشموني","https://www.aldiwan.net/poem66503.html","الخفيف"],[29,"نبئت كلبا تمنى أن تسافهنا","https://www.aldiwan.net/poem6096.html","البسيط"],[45,"أبكاء في الدار بعد الدار","https://www.aldiwan.net/poem63605.html","الخفيف"],[45,"إذا انبسطنا رددنا عن زيارتنا","https://www.aldiwan.net/poem64631.html","البسيط"],[66,"لو أفادتنا العزائم حالا","https://www.aldiwan.net/poem40128.html","المديد"],[66,"هجرت بعدك القلوب الجسوما","https://www.aldiwan.net/poem40293.html","الخفيف"],[80,"متى ينال لديكم ما يؤمله","https://www.aldiwan.net/poem31341.html","البسيط"],[69,"يا بنات الشرق حاذرن السطا","https://www.aldiwan.net/poem28209.html","الرمل"],[31,"علق النوار فؤاده جهلا","https://www.aldiwan.net/poem41838.html","الكامل"],[105,"هذا إمام الدين في أعلامه","https://www.aldiwan.net/poem44206.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54812","الخفيف"],[72,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[45,"إذا انْبَسَطْنَا رَدَدْنَا عَنْ زِيارَتِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=31131",""],[45,"أبُكَاءً في الدّارِ، بَعْدَ الدّارِ","https://www.poetsgate.com/ViewPoem.aspx?id=31284",""],[51,"يا بني السِّمري لا َجشموني","https://www.poetsgate.com/ViewPoem.aspx?id=30765",""]],"verses":[["ما ظَنُّكُم بِفَتىً طالَت بَلِيَّتُهُ","مُرَوَّعٍ في الهَوى لا يَأمَنُ التَلَفا",0,"ف",2,0],["ما ظَلَّ مُذ وَجَفَت في كُلِّ ظاهِرَةٍ","بِالأَشعَثِ الوَردِ إِلّا وَهوَ مَهمومُ",1,"م",1,0],["ما ظَنُّكُم بِبَني مَيثاءَ أَن فَزِعوا","لَيلاً وَشَدَّ عَلَيهِم حَيَّةُ الوادي",2,"ي",1,0],["ما ظُنَّ يوماً به إتيانُ سيئةٍ","حُقَّتْ ولا ظُنّ فيه صالح بطلا",3,"ل",2,0],["ما ظننتُ الإنسان يجترُّ حتى","كنتَ ذاك الإنسان عينَ اليقن",4,"ن",1,0],["ما ظَنُّهُم لَو لَقونا وَهيَ تَحمِلُنا","صَلادِمُ الخَيلِ لا فانٍ وَلا مُهُرُ",5,"ر",1,0],["ما ظَنَنتُ الأَهواءَ قَبلَكَ تُمحى","مِن صُدورِ العُشّاقِ مَحوَ الدِيارِ",6,"ر",1,0],["ماظَنُّ مُستَوهِبِ الجَدوى إِذا نَظَرَت","عَيناهُ عِندَكُمُ إِخفاقُ مُقتَرِضِ",7,"ض",1,0],["ما ظَنَنّا أَنَّ ريحَ المَنايا","تَنسِفُ الطودَ وَتُردي الجِبالا",8,"ل",2,0],["ما ظَنَنّا المَنونَ تَرقى إِلى البَد","رِ وَأَنَّ الحِمامَ يَغشى النُجوما",9,"م",2,0],["ما ظَنَّ مَن قَبِلَ تَعذيبِ الهوى أسَدٌ","أَنَّ التَّدَلُّلَ من رئمٍ يُذَلّلُهُ",10,"ل",2,0],["ما ظهورُ البدرِ مِنْ مشرقِهِ","كطلوعُ الشمسِ مِنْ مغربِها",11,"ه",2,0],["ما ظَبيَةٌ مِن وَحشِ ذي بَقَرٍ","تَغذو بِسِقطِ صَريمَةٍ طِفلا",12,"ل",2,0],["ما ظَنُّهم باللَّهِ يُؤثِرُ عَبْدَهُ","بالبالغِ الموفورِ من إنعامهِ",13,"م",2,0],["مَا ظَلَلْتُمْ يَداً وَقَلْباً بَلَغْتُمْ","فِي نَواحِي الْحَيَاةِ كُلَّ مُرَادِ",14,"د",1,0],["ما ظمئته الأذهان","لا إنسها ولا الجان",15,"ن",1,0],["ما ظنُّ مُستَوْهِبِ الجَدوَى إذا نظرَتْ","عَيْنَاهُ عِندَكُمُ إخْفَاقَ مُعترِضِ",16,"ض",1,0],["ماظنت الأهواء قبلك تمحى","من صدور العشاق نحو الديار",17,"ر",1,0],["ما ظننتُ الإنسان يجترُّ حتى","كنتَ ذاك الإنسان عينَ اليقين",18,"ن",1,0]]}