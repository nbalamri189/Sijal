{"poems":[[57,"يا دار فوز لقد أورثتني دنفا","https://www.aldiwan.net/poem26242.html","البسيط"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[29,"حي المنازل بالأجزاع فالوادي","https://www.aldiwan.net/poem5722.html","البسيط"],[53,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[53,"يا بني السمري لا تجشموني","https://www.aldiwan.net/poem66503.html","الخفيف"],[31,"نبئت كلبا تمنى أن تسافهنا","https://www.aldiwan.net/poem6096.html","البسيط"],[47,"أبكاء في الدار بعد الدار","https://www.aldiwan.net/poem63605.html","الخفيف"],[47,"إذا انبسطنا رددنا عن زيارتنا","https://www.aldiwan.net/poem64631.html","البسيط"],[68,"لو أفادتنا العزائم حالا","https://www.aldiwan.net/poem40128.html","المديد"],[68,"هجرت بعدك القلوب الجسوما","https://www.aldiwan.net/poem40293.html","الخفيف"],[82,"متى ينال لديكم ما يؤمله","https://www.aldiwan.net/poem31341.html","البسيط"],[71,"يا بنات الشرق حاذرن السطا","https://www.aldiwan.net/poem28209.html","الرمل"],[33,"علق النوار فؤاده جهلا","https://www.aldiwan.net/poem41838.html","الكامل"],[107,"هذا إمام الدين في أعلامه","https://www.aldiwan.net/poem44206.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54812","الخفيف"],[74,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[111,"يا أخا عبس الحماة الأنوف","https://www.poetsgate.com/ViewPoem.aspx?id=529",""],[47,"إذا انْبَسَطْنَا رَدَدْنَا عَنْ زِيارَتِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=31131",""],[47,"أبُكَاءً في الدّارِ، بَعْدَ الدّارِ","https://www.poetsgate.com/ViewPoem.aspx?id=31284",""],[53,"يا بني السِّمري لا َجشموني","https://www.poetsgate.com/ViewPoem.aspx?id=30765",""],[128,"هشت لمقدمه المدينه","https://www.aldiwan.net/poem23748.html","مجزوء الكامل"],[147,"لو لم يقد نحوك العدى الرغب","https://www.aldiwan.net/poem11737.html","المنسرح"],[164,"ما صالحت داعي الهوى مقلتي","https://www.aldiwan.net/poem58927.html","السريع"],[164,"كل الملوك وجملة الخلفاء","https://www.aldiwan.net/poem58968.html","الكامل"],[190,"العيش بين الرذال شوم","https://www.aldiwan.net/poem43297.html","مخلع البسيط"],[263,"أفتاة قلبي رحمة بفتاك","https://www.aldiwan.net/poem35946.html","الكامل"],[274,"من حسنك شعري قد سرقا","https://www.aldiwan.net/poem35437.html","المتدارك"],[286,"جئت أسعى إلى عروبة حتى","https://www.aldiwan.net/poem32296.html","الخفيف"],[286,"بالله ربكما سلاها","https://www.aldiwan.net/poem32308.html","مجزوء الكامل"],[309,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[309,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[365,"أيها الخل قد صحبناك دهرا","https://www.aldiwan.net/poem68109.html","الخفيف"],[413,"وإذا مررت على الديار فقف بها","https://www.aldiwan.net/poem32546.html","الكامل"],[461,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[464,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[467,"رفقاً بعبدك وأعط عهدك حقه","https://www.aldiwan.net/poem3224.html","عموديه"],[508,"إلهٌ من نباح","https://www.aldiwan.net/poem42459.html","مخلع البسيط"],[518,"لو كان ينفع أن تجود بمائها","https://www.aldiwan.net/poem11998.html","الكامل"],[561,"عدم للوجود كالأمواج","https://www.aldiwan.net/poem34687.html","الخفيف"]],"verses":[["ما ظَنُّكُم بِفَتىً طالَت بَلِيَّتُهُ","مُرَوَّعٍ في الهَوى لا يَأمَنُ التَلَفا",0,"ف",2,0],["ما ظَلَّ مُذ وَجَفَت في كُلِّ ظاهِرَةٍ","بِالأَشعَثِ الوَردِ إِلّا وَهوَ مَهمومُ",1,"م",1,0],["ما ظَنُّكُم بِبَني مَيثاءَ أَن فَزِعوا","لَيلاً وَشَدَّ عَلَيهِم حَيَّةُ الوادي",2,"د",2,0],["ما ظُنَّ يوماً به إتيانُ سيئةٍ","حُقَّتْ ولا ظُنّ فيه صالح بطلا",3,"ل",2,0],["ما ظننتُ الإنسان يجترُّ حتى","كنتَ ذاك الإنسان عينَ اليقن",4,"ن",1,0],["ما ظَنُّهُم لَو لَقونا وَهيَ تَحمِلُنا","صَلادِمُ الخَيلِ لا فانٍ وَلا مُهُرُ",5,"ر",1,0],["ما ظَنَنتُ الأَهواءَ قَبلَكَ تُمحى","مِن صُدورِ العُشّاقِ مَحوَ الدِيارِ",6,"ر",1,0],["ماظَنُّ مُستَوهِبِ الجَدوى إِذا نَظَرَت","عَيناهُ عِندَكُمُ إِخفاقُ مُقتَرِضِ",7,"ض",1,0],["ما ظَنَنّا أَنَّ ريحَ المَنايا","تَنسِفُ الطودَ وَتُردي الجِبالا",8,"ل",2,0],["ما ظَنَنّا المَنونَ تَرقى إِلى البَد","رِ وَأَنَّ الحِمامَ يَغشى النُجوما",9,"م",2,0],["ما ظَنَّ مَن قَبِلَ تَعذيبِ الهوى أسَدٌ","أَنَّ التَّدَلُّلَ من رئمٍ يُذَلّلُهُ",10,"ل",2,0],["ما ظهورُ البدرِ مِنْ مشرقِهِ","كطلوعُ الشمسِ مِنْ مغربِها",11,"ه",2,0],["ما ظَبيَةٌ مِن وَحشِ ذي بَقَرٍ","تَغذو بِسِقطِ صَريمَةٍ طِفلا",12,"ل",2,0],["ما ظَنُّهم باللَّهِ يُؤثِرُ عَبْدَهُ","بالبالغِ الموفورِ من إنعامهِ",13,"م",2,0],["مَا ظَلَلْتُمْ يَداً وَقَلْباً بَلَغْتُمْ","فِي نَواحِي الْحَيَاةِ كُلَّ مُرَادِ",14,"د",1,0],["ما ظمئته الأذهان","لا إنسها ولا الجان",15,"ن",1,0],["ما ظننت الزمان يجحد فضلي","غير أن الزمان جم الصروف",16,"ف",1,0],["ما ظنُّ مُستَوْهِبِ الجَدوَى إذا نظرَتْ","عَيْنَاهُ عِندَكُمُ إخْفَاقَ مُعترِضِ",17,"ض",1,0],["ماظنت الأهواء قبلك تمحى","من صدور العشاق نحو الديار",18,"ر",1,0],["ما ظننتُ الإنسان يجترُّ حتى","كنتَ ذاك الإنسان عينَ اليقين",19,"ن",1,0],["ما ظل في وادي الشتا","والسلط للآرام عينه",20,"ن",2,0],["ما ظَفِروا فيكَ بِالَّذي طَلَبوا","فَليَظفَروا مِنكَ بِالَّذي طَلَبوا",21,"ب",3,0],["ما ظنت العلياء أن امرءا","ينيلها من هذه الرتبة",22,"ه",1,0],["ما ظل يخفق وشيها في موكب","إلا خفقن فرائص الأعداء",23,"ا",2,0],["ما ظالم جاهل غبي","ملزمه ملزما ظلوم",24,"م",1,0],["ما ظبية الوادي وما وادي الفلا","منك وقلب أخي الهوى مأواك",25,"ك",1,0],["ما ظبّةُ تلقاها ظبةٌ","أو بَرقٌ في حَلكٍ بَرَقا",26,"ق",2,0],["ما ظَنَنّا بِأَنَّ مَقصورَةَ الجا","مِعِ مَأوىً لِكُلِّ لِصٍّ غَوِيِّ",27,"ي",1,0],["ما ظَبيَةٌ في رَوضَةٍ","بِالحَزنِ ناشِدَةً طَلاها",28,"ا",3,0],["ما ظاهرُ الدنيا لهُ بمولّهٍ","عَن باطنِ الأخرى ولا بموهّمِ",29,"م",1,0],["ما ظنّكم باللّه جلّ جلالهُ","وافاهُ ذو نفسٍ إليهِ لَهوجه",30,"ج",2,0],["ما ظَنناك أَيها الخل من قب","ل عَلَينا من الحُب أَدرى",31,"ر",2,0],["ما ظنُّها بِطَعينِ أغْصانِ النّقا","مَاسَتْ مُنَصَّلَةً بأسهُمِ بَابِلِ",32,"ل",1,0],["ما ظننت الرشفَ محظور اللمى","حظرَه الخمرةَ حتى ذقتُ ريقَهْ",33,"ق",2,0],["ما ظنْنتٌ الموتَ يُمْضي بأسَهُ","وسُطاه في بُحورٍ وجبالِ",34,"ل",1,0],["ما ظل طالب سلوة وفؤاده","ما ضل عنه الوجد والبرحاء",35,"ا",2,0],["ما ظلّ منهُ سوى النّباحِ","يهبُّ ليلاً مع الرّياحِ",36,"ح",1,0],["ما ظن من عقد اللواء بأمرها","أن لا يقود الجيش تحت لوائها",37,"ا",3,0],["ما ظهرنا به سوى بكلام","أزليٍّ يضيء في ظل داجي",38,"ج",2,0]]}