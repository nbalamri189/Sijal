://www.poetsgate.com/ViewPoem.aspx?id=28004",""],[4764,"الليالي العقيمه","https://www.poetsgate.com/ViewPoem.aspx?id=32992",""],[4764,"الحب ميت والبقا براس قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=33865",""],[4767,"الحَجْر","https://www.poetsgate.com/ViewPoem.aspx?id=211043",""],[4797,"ريقك عسل","https://www.poetsgate.com/ViewPoem.aspx?id=71826",""],[4829,"ولاد المضا","https://www.poetsgate.com/ViewPoem.aspx?id=36743",""],[4978,"والمنتدى مما ألم به","https://www.poetsgate.com/ViewPoem.aspx?id=180718",""],[4980,"يَا مُرهِقَ القَلب","https://www.poetsgate.com/ViewPoem.aspx?id=191673",""],[5212,"قبرُ البدور","https://www.poetsgate.com/ViewPoem.aspx?id=212057",""],[5376,"بي لوعة العشاق تهمي خافقي","https://www.poetsgate.com/ViewPoem.aspx?id=188476",""],[5431,"شوق للوطن المعذب","https://www.poetsgate.com/ViewPoem.aspx?id=183035",""],[5431,"وخشية الله نورٌ في مآقينا","https://www.poetsgate.com/ViewPoem.aspx?id=189131",""],[5463,"يوم المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=25224",""],[5495,"بده العام الدراسي (مرثيه لولده حيدر)","https://www.poetsgate.com/ViewPoem.aspx?id=175440",""],[5606,"اصبر لجور الحب","https://www.poetsgate.com/ViewPoem.aspx?id=196599",""],[5652,"ياغايبه عن شوف عيني فقدتك","https://www.poetsgate.com/ViewPoem.aspx?id=135934",""],[5667,"الحياة ظل زائل","https://www.poetsgate.com/ViewPoem.aspx?id=214838",""],[5725,"لا غالب اليوم الا الله ياوطني","https://www.poetsgate.com/ViewPoem.aspx?id=201303",""],[5739,"غدينا بالمتاهه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126427",""],[5840,"فيك برحت بالعذول إباء","https://www.poetsgate.com/ViewPoem.aspx?id=181437",""],[5862,"الفعايل أصيله","https://www.poetsgate.com/ViewPoem.aspx?id=34140",""],[5997,"لواعج","https://www.poetsgate.com/ViewPoem.aspx?id=215904",""],[6088,"اقباس","https://www.poetsgate.com/ViewPoem.aspx?id=207586",""],[6102,"احتياج ..","https://www.poetsgate.com/ViewPoem.aspx?id=182836",""],[6131,"عَينايَ زرقاءُ اليَمامةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189287",""],[415,"بَأبِي شَخصُكَ الذي لا يَغيبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7784&r=&rc=14",""],[6278,"وغادر الطّفل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86867&r=&rc=20",""],[6327,"لامية الهمج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86571&r=&rc=6",""]],"verses":[["ما ظَنُّكُم بِفَتىً طالَت بَلِيَّتُهُ","مُرَوَّعٍ في الهَوى لا يَأمَنُ التَلَفا",0,"ف",2,0],["ما ظَلَّ مُذ وَجَفَت في كُلِّ ظاهِرَةٍ","بِالأَشعَثِ الوَردِ إِلّا وَهوَ مَهمومُ",1,"م",1,0],["ما ظَنُّكُم بِبَني مَيثاءَ أَن فَزِعوا","لَيلاً وَشَدَّ عَلَيهِم حَيَّةُ الوادي",2,"د",2,0],["ما ظُنَّ يوماً به إتيانُ سيئةٍ","حُقَّتْ ولا ظُنّ فيه صالح بطلا",3,"ل",2,0],["ما ظننتُ الإنسان يجترُّ حتى","كنتَ ذاك الإنسان عينَ اليقن",4,"ن",1,0],["ما ظَنُّهُم لَو لَقونا وَهيَ تَحمِلُنا","صَلادِمُ الخَيلِ لا فانٍ وَلا مُهُرُ",5,"ر",1,0],["ما ظَنَنتُ الأَهواءَ قَبلَكَ تُمحى","مِن صُدورِ العُشّاقِ مَحوَ الدِيارِ",6,"ر",1,0],["ماظَنُّ مُستَوهِبِ الجَدوى إِذا نَظَرَت","عَيناهُ عِندَكُمُ إِخفاقُ مُقتَرِضِ",7,"ض",1,0],["ما ظَنَنّا أَنَّ ريحَ المَنايا","تَنسِفُ الطودَ وَتُردي الجِبالا",8,"ل",2,0],["ما ظَنَنّا المَنونَ تَرقى إِلى البَد","رِ وَأَنَّ الحِمامَ يَغشى النُجوما",9,"م",2,0],["ما ظَنَّ مَن قَبِلَ تَعذيبِ الهوى أسَدٌ","أَنَّ التَّدَلُّلَ من رئمٍ يُذَلّلُهُ",10,"ل",2,0],["ما ظهورُ البدرِ مِنْ مشرقِهِ","كطلوعُ الشمسِ مِنْ مغربِها",11,"ه",2,0],["ما ظَبيَةٌ مِن وَحشِ ذي بَقَرٍ","تَغذو بِسِقطِ صَريمَةٍ طِفلا",12,"ل",2,0],["ما ظَنُّهم باللَّهِ يُؤثِرُ عَبْدَهُ","بالبالغِ الموفورِ من إنعامهِ",13,"م",2,0],["مَا ظَلَلْتُمْ يَداً وَقَلْباً بَلَغْتُمْ","فِي نَواحِي الْحَيَاةِ كُلَّ مُرَادِ",14,"د",1,0],["ما ظمئته الأذهان","لا إنسها ولا الجان",15,"ن",1,0],["ما ظننت الزمان يجحد فضلي","غير أن الزمان جم الصروف",16,"ف",1,0],["ما ظنُّ مُستَوْهِبِ الجَدوَى إذا نظرَتْ","عَيْنَاهُ عِندَكُمُ إخْفَاقَ مُعترِضِ",17,"ض",1,0],["ماظنت الأهواء قبلك تمحى","من صدور العشاق نحو الديار",18,"ر",1,0],["ما ظننتُ الإنسان يجترُّ حتى","كنتَ ذاك الإنسان عينَ اليقين",19,"ن",1,0],["ما ظل في وادي الشتا","والسلط للآرام عينه",20,"ن",2,0],["ما ظَفِروا فيكَ بِالَّذي طَلَبوا","فَليَظفَروا مِنكَ بِالَّذي طَلَبوا",21,"ب",3,0],["ما ظنت العلياء أن امرءا","ينيلها من هذه الرتبة",22,"ه",1,0],["ما ظل يخفق وشيها في موكب","إلا خفقن فرائص الأعداء",23,"ا",2,0],["ما ظالم جاهل غبي","ملزمه ملزما ظلوم",24,"م",1,0],["ما ظبية الوادي وما وادي الفلا","منك وقلب أخي الهوى مأواك",25,"ك",1,0],["ما ظبّةُ تلقاها ظبةٌ","أو بَرقٌ في حَلكٍ بَرَقا",26,"ق",2,0],["ما ظَنَنّا بِأَنَّ مَقصورَةَ الجا","مِعِ مَأوىً لِكُلِّ لِصٍّ غَوِيِّ",27,"ي",1,0],["ما ظَبيَةٌ في رَوضَةٍ","بِالحَزنِ ناشِدَةً طَلاها",28,"ا",3,0],["ما ظاهرُ الدنيا لهُ بمولّهٍ","عَن باطنِ الأخرى ولا بموهّمِ",29,"م",1,0],["ما ظنّكم باللّه جلّ جلالهُ","وافاهُ ذو نفسٍ إليهِ لَهوجه",30,"ج",2,0],["ما ظَنناك أَيها الخل من قب","ل عَلَينا من الحُب أَدرى",31,"ر",2,0],["ما ظنُّها بِطَعينِ أغْصانِ النّقا","مَاسَتْ مُنَصَّلَةً بأسهُمِ بَابِلِ",32,"ل",1,0],["ما ظننت الرشفَ محظور اللمى","حظرَه الخمرةَ حتى ذقتُ ريقَهْ",33,"ق",2,0],["ما ظنْنتٌ الموتَ يُمْضي بأسَهُ","وسُطاه في بُحورٍ وجبالِ",34,"ل",1,0],["ما ظل طالب سلوة وفؤاده","ما ضل عنه الوجد والبرحاء",35,"ا",2,0],["ما ظلّ منهُ سوى النّباحِ","يهبُّ ليلاً مع الرّياحِ",36,"ح",1,0],["ما ظن من عقد اللواء بأمرها","أن لا يقود الجيش تحت لوائها",37,"ا",3,0],["ما ظهرنا به سوى بكلام","أزليٍّ يضيء في ظل داجي",38,"ج",2,0],["ما ظلم الباري ولكنه","أراد أن يظهر عجز الحكيم",39,"م",1,0],["ما ظلَّ في غيرِ صدرِ الزحفِ صارمه","وَلا سَطا في سوى الأقران ذابلهُ",40,"ل",2,0],["ما ظن ان العهد الوثيق من","النبي والأمر غير ممتثل",41,"ل",1,0],["ما ظننَّا نفوسهم بانصداع الشمل","يوماً ولا الفراق تطيب",42,"ب",1,0],["ما ظننا بأن حالك في القرب","ولا البعد بالملال تحول",43,"ل",1,0],["ما ظَنُّكُم بأناس خَيرُ كسبهم","مُصرّحُ السُحت سَمَّوه الأَمانات",44,"ت",1,0],["ما ظَلَّ يُعوِزُ منكمُ إلاَّ التفا","تٌ أن يَتِمَّ فلِي يَتِمُّ مَرامُ",45,"م",1,0],["ما ظَنَنَّاكَ أنْ تَمرَّ عَلينا","كمرورِ النَّسيمِ في الأسْحارِ",46,"ر",1,0],["ما ظبية الوادي التي أهوى سوى","وطنيتي وبها حَمِدتُ توجُّدي",47,"د",2,0],["ما ظؤارٌ عجُلٌ حانيَةٌ","تُضمرُ اليَأسَ فيُغريها الأمَل",48,"ل",1,0],["ما ظنكم بمدامعٍ أجريتها","يوم اللقا أتزيلها البرحاء",49,"ا",2,0],["ما ظبيةٌ فارقها ريمها","وراعها في الليل رامٍ لئيم",50,"م",1,0],["ما ظلت الخضراء والغبراء أفضل من","صحب النبي سوى الأنباء في الخبر",51,"ر",1,0],["ما ظنكم بمن اصطفاه الله من","أهل التقرّب سادة الأعصار",52,"ر",1,0],["مَاظنْ تِقْدَرْ كِلْمِتك تلمس شفاك","وانْفَاسْ صدْرَكْ لاهِبَهْ يَوْم تِحْكِيْن",53,"ن",1,0],["مَا ظنّي اخْطِي بِكْ واذَا اخْطِيْت لبيك","امرك عَلَى نفسي ورُوحي تمونين",54,"ن",1,0],["ما ظبية راعها القناص فالتفتت","مذعورة أشعرت أحشاءها فزعا",55,"ع",2,0],["ما ظلَّتِ الخضراءُ أعدلَ حاكمٍ","من مثله أو قلَّتِ الغبراءُ",56,"ا",2,0],["ما ظن سامعه بصوت أطيب ال","أصوات من حور الجنان حسان",57,"ن",1,0],["ما ظبية البان على حسنها","إذا تبَّدى جيدها والطُّلا",58,"ا",1,0],["ما ظنُّهم برسولِ الله لو نَظَرتْ","عدنانُ ما صنعوا لو نهم نظروا",59,"ر",3,0],["ما ظننتُ النهودَ تسرعُ للطعنِ","ولا اللّحظ يُنتضَى للقِراعِ",60,"ع",1,0],["ما ظَنت النَفسُ أَن تَسخو الدُهورُ بِما","ضَنَّت بِهِ إِذ أَلانَت قَلبَها القاسي",61,"س",2,0],["ما ظلام الدجى سوى الفرع منه","مسدلا يوثق الوشاة ظلامه",62,"م",2,0],["ما ظَنّها ليفونُ تُصْحَب بعدَما","كانت على كلِّ الملوك شموسا",63,"س",2,0],["ما ظنَنَّا علَماً يذوقُ حِماما","وبِدَفنِ الإِمام ذَاقَ الحِمَامَا",64,"م",2,0],["ما ظهروا بأساً ولكنه","سيل جرى من كل قاص ودان",65,"ن",1,0],["ما ظنّ ذو بصرٍ أن الجماد لَهُ","نطقٌ بِهِ تَصْدَح الحِيطان بالنَّغم",66,"م",1,0],["ما ظل في حر الوطيس وقالها","لم يلق فيئاً من مقيل ظلال",67,"ل",1,0],["ما ظننّا الزَمان يَسمَح يَوماً","بعدَ طولِ الفراق أَن نَتَلاقى",68,"ق",2,0],["ما ظُلّلتْ لُجَجُ السّوابِغِ في الوَغى","إلا بأدْواحِ القَنا المُتحطّمِ",69,"م",1,0],["مأظ بظا ولغير الوقد صرف حظا","واظلم وظمي أصيل ثم ذو معظا",70,"ظ",2,0],["ما ظننت الزمان أن يبعدني عن","ك الى أن أفارق الأحياء",71,"ا",2,0],["ما ظبية أنت الكنا","س وخشفها طاوي الحشى",72,"ا",1,0],["ما ظبيةٌ من أدم حيرة مُطفلِ","ترنو لأتلَعَ عاطفٍ كالدَّملجِ",73,"ج",1,0],["ما ظبية من ظبا نعاج","مذعورةٌ راعها نئيمُ",74,"م",1,0],["ما ظَننا بِأَن قَبلَك لِلمَج","دِ قَتيلاً وَلا السَماح صَريعا",75,"ع",2,0],["ما ظننا السوابق منها","ملحقات بما اقتناه المراهن",76,"ن",1,0],["ما ظلَّ ركب الدجى وانجاب عن شفقٍ","به يَأمُّ إلى جدواك ركبان",77,"ن",1,0],["ما ظَل / مني / من خفوقي (بقايا)","يا ما منحت الشوق/ ياما تِعنيت",78,"ت",1,0],["ما ظنتي يكمل معه دربٍ بداه","حنا ابتدينا / والقلوب امجرحه",79,"ح",2,0],["ما ظنتي اطلب هضابٍ من التيم","ولا نشدت العشق واقصى جحيمه",80,"م",2,0],["ما ظَل غير انثر ،، بقاياه جَنبي","وادعي يِفَرِج كرب ظامي ومكتوم",81,"م",1,0],["ما ظنَّ يوماً أن يرى","وجهَ الحبيبةِ مدبرا",82,"ر",2,0],["ماظنتي يازين يقبل صيامك","ريقك عسل علمني شلون بتصوم",83,"م",1,0],["ماظلّت العليا شريف ٍ سيّد","أكرم من (أ)قُرَيشيَّ ذا معلومي",84,"م",2,0],["ما ظلّ عندي بعدُ من أملٍ","أيعيش من قد فارق الأملا؟\"",85,"ل",2,0],["مَا ظَنُّكَ الحَقَّ تَرمِي الهَجرَ مِن كَلِفٍ","يَستَبدِلُ الحُبَّ بِالأشوَاقِ إن بِنتَ",86,"ت",1,0],["ما ظَنَّ أنَّ الحَقَّ يَصرَعُ جاهِلاً","كَمْ جاهِلاً لَقيَ الرَّدى كصَريعِ",87,"ع",1,0],["ما ظننت الحب أحياه سنا","فالعشق توديع به وفراق",88,"ق",1,0],["ماظلّ في الروح للأحزان متسعٌ","تشتاقها الحاء ثم الباء والألف",89,"ف",1,0],["ماظن نفس بنور الله تسرجها","إلا النجاح وإلا النصر ,,,,آآآآآمينا",90,"ن",2,0],["ما ظنّي به إنسان بالدنيا يجيد ..!","((فنّ المحبه )) اللي لها تبكي العيان",91,"ن",1,0],["ما ظنيت زرعي يروح فد يوم","وعصافير الحزن تگضي البيادر",92,"ر",1,0],["ماظني أسلى صاحبي لو تسليت","فالقلب حبه لين يوم المنيه",93,"ي",2,0],["ماظنتي ب ألقى بديلٍ يساويك","وماظنتي انساك دآمي عشقتك ..!!",94,"ك",1,0],["ما ظلَّ فيها سوى ما خُطَّ من أَثرٍ","وأكرمُ الناسِ فيها مَنْ لَهُ خَلَفُ",95,"ف",1,0],["ما ظل منها سوى كل الذي طويت","فيك المسافات الا ناءَ اقربها",96,"ب",3,0],["ما ظلمت القلب اصحى لا تعيل.","المشاعر تاكل القلب بْشراهه.!",97,"ا",3,0],["ما ظننت الزمان يبعدني عن","،ك إلى أن أفارق الأحياء",98,"ا",2,0],["ما ظن يبينفع لغيرك وصالك","دام المحبه ماهي للي تجيله",99,"ل",2,0],["ما ظلَّ لي قلبٌ وما أغواني","الإ كحيلُ الطرفِ عن إيماني",100,"ن",2,1],["ما ظلّلت أمّه إلاّ أمومته","حتّى ظننّاه أمّا كثر ما اتنسا",101,"س",2,0],["مَا ظَلَّ لِي - فِي النَّاسِ - مَنْ أَرْجُو أَخًا","لَا وَالِدًا - يَحْنُو - وَ لَا خَالًا , وَ عَمْ",102,"م",1,0],["ما ظلَّ بيْ شوقٌ لأسمعَ شاعِرًا","صبًّا على سَعَفِ الصَّباحِ تقطَّرا",103,"ر",2,0],["ما ظَنَنا نُفوسَهم بانصداع الثَّ","الشّمل يوماً ولا الفراقِ تطيبُ",104,"ب",1,0],["ما ظنّ قلبي أنّكِ قد ترحلي","لو كان صدّق حينها؛ لَتَفَطَّرا",105,"ر",2,0],["ما ظَلَّ مِن أَمْرِنا بَينَ الشُّعوبِ سِوى","بابٍ نُوارِبُهُ للمَوتِ والشَّلَلِ",106,"ل",1,0]]}