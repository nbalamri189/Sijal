{"poems":[[55,"يا دار فوز لقد أورثتني دنفا","https://www.aldiwan.net/poem26242.html","البسيط"],[30,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[27,"حي المنازل بالأجزاع فالوادي","https://www.aldiwan.net/poem5722.html","البسيط"],[51,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[51,"يا بني السمري لا تجشموني","https://www.aldiwan.net/poem66503.html","الخفيف"],[29,"نبئت كلبا تمنى أن تسافهنا","https://www.aldiwan.net/poem6096.html","البسيط"],[45,"أبكاء في الدار بعد الدار","https://www.aldiwan.net/poem63605.html","الخفيف"],[45,"إذا انبسطنا رددنا عن زيارتنا","https://www.aldiwan.net/poem64631.html","البسيط"],[66,"لو أفادتنا العزائم حالا","https://www.aldiwan.net/poem40128.html","المديد"],[66,"هجرت بعدك القلوب الجسوما","https://www.aldiwan.net/poem40293.html","الخفيف"],[80,"متى ينال لديكم ما يؤمله","https://www.aldiwan.net/poem31341.html","البسيط"],[69,"يا بنات الشرق حاذرن السطا","https://www.aldiwan.net/poem28209.html","الرمل"],[31,"علق النوار فؤاده جهلا","https://www.aldiwan.net/poem41838.html","الكامل"],[105,"هذا إمام الدين في أعلامه","https://www.aldiwan.net/poem44206.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54812","الخفيف"],[72,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[45,"إذا انْبَسَطْنَا رَدَدْنَا عَنْ زِيارَتِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=31131",""],[45,"أبُكَاءً في الدّارِ، بَعْدَ الدّارِ","https://www.poetsgate.com/ViewPoem.aspx?id=31284",""],[51,"يا بني السِّمري لا َجشموني","https://www.poetsgate.com/ViewPoem.aspx?id=30765",""],[124,"هشت لمقدمه المدينه","https://www.aldiwan.net/poem23748.html","مجزوء الكامل"],[143,"لو لم يقد نحوك العدى الرغب","https://www.aldiwan.net/poem11737.html","المنسرح"],[160,"ما صالحت داعي الهوى مقلتي","https://www.aldiwan.net/poem58927.html","السريع"],[160,"كل الملوك وجملة الخلفاء","https://www.aldiwan.net/poem58968.html","الكامل"],[186,"العيش بين الرذال شوم","https://www.aldiwan.net/poem43297.html","مخلع البسيط"],[259,"أفتاة قلبي رحمة بفتاك","https://www.aldiwan.net/poem35946.html","الكامل"],[270,"من حسنك شعري قد سرقا","https://www.aldiwan.net/poem35437.html","المتدارك"],[282,"جئت أسعى إلى عروبة حتى","https://www.aldiwan.net/poem32296.html","الخفيف"],[282,"بالله ربكما سلاها","https://www.aldiwan.net/poem32308.html","مجزوء الكامل"],[305,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[305,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[361,"أيها الخل قد صحبناك دهرا","https://www.aldiwan.net/poem68109.html","الخفيف"],[409,"وإذا مررت على الديار فقف بها","https://www.aldiwan.net/poem32546.html","الكامل"],[458,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[461,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[464,"رفقاً بعبدك وأعط عهدك حقه","https://www.aldiwan.net/poem3224.html","عموديه"],[505,"إلهٌ من نباح","https://www.aldiwan.net/poem42459.html","مخلع البسيط"],[515,"لو كان ينفع أن تجود بمائها","https://www.aldiwan.net/poem11998.html","الكامل"],[558,"عدم للوجود كالأمواج","https://www.aldiwan.net/poem34687.html","الخفيف"]],"verses":[["ما ظَنُّكُم بِفَتىً طالَت بَلِيَّتُهُ","مُرَوَّعٍ في الهَوى لا يَأمَنُ التَلَفا",0,"ف",2,0],["ما ظَلَّ مُذ وَجَفَت في كُلِّ ظاهِرَةٍ","بِالأَشعَثِ الوَردِ إِلّا وَهوَ مَهمومُ",1,"م",1,0],["ما ظَنُّكُم بِبَني مَيثاءَ أَن فَزِعوا","لَيلاً وَشَدَّ عَلَيهِم حَيَّةُ الوادي",2,"ي",1,0],["ما ظُنَّ يوماً به إتيانُ سيئةٍ","حُقَّتْ ولا ظُنّ فيه صالح بطلا",3,"ل",2,0],["ما ظننتُ الإنسان يجترُّ حتى","كنتَ ذاك الإنسان عينَ اليقن",4,"ن",1,0],["ما ظَنُّهُم لَو لَقونا وَهيَ تَحمِلُنا","صَلادِمُ الخَيلِ لا فانٍ وَلا مُهُرُ",5,"ر",1,0],["ما ظَنَنتُ الأَهواءَ قَبلَكَ تُمحى","مِن صُدورِ العُشّاقِ مَحوَ الدِيارِ",6,"ر",1,0],["ماظَنُّ مُستَوهِبِ الجَدوى إِذا نَظَرَت","عَيناهُ عِندَكُمُ إِخفاقُ مُقتَرِضِ",7,"ض",1,0],["ما ظَنَنّا أَنَّ ريحَ المَنايا","تَنسِفُ الطودَ وَتُردي الجِبالا",8,"ل",2,0],["ما ظَنَنّا المَنونَ تَرقى إِلى البَد","رِ وَأَنَّ الحِمامَ يَغشى النُجوما",9,"م",2,0],["ما ظَنَّ مَن قَبِلَ تَعذيبِ الهوى أسَدٌ","أَنَّ التَّدَلُّلَ من رئمٍ يُذَلّلُهُ",10,"ل",2,0],["ما ظهورُ البدرِ مِنْ مشرقِهِ","كطلوعُ الشمسِ مِنْ مغربِها",11,"ه",2,0],["ما ظَبيَةٌ مِن وَحشِ ذي بَقَرٍ","تَغذو بِسِقطِ صَريمَةٍ طِفلا",12,"ل",2,0],["ما ظَنُّهم باللَّهِ يُؤثِرُ عَبْدَهُ","بالبالغِ الموفورِ من إنعامهِ",13,"م",2,0],["مَا ظَلَلْتُمْ يَداً وَقَلْباً بَلَغْتُمْ","فِي نَواحِي الْحَيَاةِ كُلَّ مُرَادِ",14,"د",1,0],["ما ظمئته الأذهان","لا إنسها ولا الجان",15,"ن",1,0],["ما ظنُّ مُستَوْهِبِ الجَدوَى إذا نظرَتْ","عَيْنَاهُ عِندَكُمُ إخْفَاقَ مُعترِضِ",16,"ض",1,0],["ماظنت الأهواء قبلك تمحى","من صدور العشاق نحو الديار",17,"ر",1,0],["ما ظننتُ الإنسان يجترُّ حتى","كنتَ ذاك الإنسان عينَ اليقين",18,"ن",1,0],["ما ظل في وادي الشتا","والسلط للآرام عينه",19,"ن",2,0],["ما ظَفِروا فيكَ بِالَّذي طَلَبوا","فَليَظفَروا مِنكَ بِالَّذي طَلَبوا",20,"ب",3,0],["ما ظنت العلياء أن امرءا","ينيلها من هذه الرتبة",21,"ه",1,0],["ما ظل يخفق وشيها في موكب","إلا خفقن فرائص الأعداء",22,"ا",2,0],["ما ظالم جاهل غبي","ملزمه ملزما ظلوم",23,"م",1,0],["ما ظبية الوادي وما وادي الفلا","منك وقلب أخي الهوى مأواك",24,"ك",1,0],["ما ظبّةُ تلقاها ظبةٌ","أو بَرقٌ في حَلكٍ بَرَقا",25,"ق",2,0],["ما ظَنَنّا بِأَنَّ مَقصورَةَ الجا","مِعِ مَأوىً لِكُلِّ لِصٍّ غَوِيِّ",26,"ي",1,0],["ما ظَبيَةٌ في رَوضَةٍ","بِالحَزنِ ناشِدَةً طَلاها",27,"ا",3,0],["ما ظاهرُ الدنيا لهُ بمولّهٍ","عَن باطنِ الأخرى ولا بموهّمِ",28,"م",1,0],["ما ظنّكم باللّه جلّ جلالهُ","وافاهُ ذو نفسٍ إليهِ لَهوجه",29,"ج",2,0],["ما ظَنناك أَيها الخل من قب","ل عَلَينا من الحُب أَدرى",30,"ر",2,0],["ما ظنُّها بِطَعينِ أغْصانِ النّقا","مَاسَتْ مُنَصَّلَةً بأسهُمِ بَابِلِ",31,"ل",1,0],["ما ظننت الرشفَ محظور اللمى","حظرَه الخمرةَ حتى ذقتُ ريقَهْ",32,"ق",2,0],["ما ظنْنتٌ الموتَ يُمْضي بأسَهُ","وسُطاه في بُحورٍ وجبالِ",33,"ل",1,0],["ما ظل طالب سلوة وفؤاده","ما ضل عنه الوجد والبرحاء",34,"ا",2,0],["ما ظلّ منهُ سوى النّباحِ","يهبُّ ليلاً مع الرّياحِ",35,"ح",1,0],["ما ظن من عقد اللواء بأمرها","أن لا يقود الجيش تحت لوائها",36,"ا",3,0],["ما ظهرنا به سوى بكلام","أزليٍّ يضيء في ظل داجي",37,"ي",1,0]]}