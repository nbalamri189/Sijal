{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[55,"يا لائمي في العشق مه","https://www.aldiwan.net/poem26228.html","مجزوء الكامل"],[77,"عجبا لوجد لا يلين شديده","https://www.aldiwan.net/poem36606.html","الكامل"],[77,"سعودك لا ما تدعيه الكواكب","https://www.aldiwan.net/poem36771.html","الطويل"],[77,"تعلقته من دوحة الجود والباس","https://www.aldiwan.net/poem35881.html","الطويل"],[86,"ما لهذا النجم في السحر","https://www.aldiwan.net/poem10504.html","المديد"],[86,"بنادي الجزيرة قف ساعة","https://www.aldiwan.net/poem10950.html","المتقارب"],[73,"كما تشاء فقل لي لست منتقلا","https://www.aldiwan.net/poem11850.html","البسيط"],[10,"إن أبا حسان عرش هوى","https://www.aldiwan.net/poem21125.html","السريع"],[93,"لعينيك من جارة جائره","https://www.aldiwan.net/poem11135.html","المتقارب"],[93,"صدق النعي وردد الهرمان","https://www.aldiwan.net/poem11225.html","الكامل"],[93,"جاء الكتاب وأصدق","https://www.aldiwan.net/poem11242.html","المجتث"],[27,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[95,"أمتي هل لك بين الأمم","https://www.aldiwan.net/poem60148.html","عموديه"],[51,"يا فاصد العرق المبارك فصده","https://www.aldiwan.net/poem62867.html","البسيط"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[51,"أبا العباس ما هذا التواني","https://www.aldiwan.net/poem66343.html","الوافر"],[51,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[91,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[91,"بكيت الصبا من قبل أن يذهب الصبا","https://www.aldiwan.net/poem62665.html","عموديه"],[91,"سيرت في فجر الحياة سفينتي","https://www.aldiwan.net/poem62730.html","عموديه"],[91,"هذه ملفرد قد لاحت رباها","https://www.aldiwan.net/poem62802.html","عموديه"],[89,"تحبهم ثم ارزم ثم سالا","https://www.aldiwan.net/poem44900.html","الوافر"],[43,"عدوك مذموم بكل لسان","https://www.aldiwan.net/poem10593.html","الطويل"],[66,"عزمت يا متلفي على السفر","https://www.aldiwan.net/poem39640.html","المنسرح"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[87,"يا ناصر الحق على الباطل","https://www.aldiwan.net/poem8364.html","السريع"],[33,"أتلحى محبا هائم القلب أن رأى","https://www.aldiwan.net/poem25857.html","الطويل"],[105,"صونوا الذمام فإن الحر من صانا","https://www.aldiwan.net/poem42047.html","البسيط"],[105,"أتسأل مصر ما حمل العميد","https://www.aldiwan.net/poem42123.html","الوافر"],[105,"أغيثوا مصر واستبقوا بنيها","https://www.aldiwan.net/poem43387.html","الوافر"],[105,"أتلك مصارع المستضعفينا","https://www.aldiwan.net/poem43397.html","الوافر"],[105,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[105,"ما الكيد ما الغدر ما هذي الأباطيل","https://www.aldiwan.net/poem44204.html","البسيط"],[81,"نظر جرى قلبي على آثاره","https://www.aldiwan.net/poem61515.html","الكامل"],[46,"كأنما دنياك وحشية","https://www.aldiwan.net/poem23002.html","السريع"],[76,"أتلهو بين باطية وزير","https://www.aldiwan.net/poem39296.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85544","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39652","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42640","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55123","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54852","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8913","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[77,"حديثٌ على رغم العلا غيرُ كاذبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33316",""],[98,"سلمى الكورانية","https://www.poetsgate.com/ViewPoem.aspx?id=53904",""],[91,"الشباب والحب","https://www.poetsgate.com/ViewPoem.aspx?id=53231",""],[126,"جار الحبيب على الكئيب ببعده","https://www.aldiwan.net/poem50638.html","الكامل"],[140,"لست أقضى إذا رأيتك نذرا","https://www.aldiwan.net/poem58427.html","الخفيف"],[165,"واحة الوجه","https://www.aldiwan.net/poem1035.html",""],[167,"أظنك خلت الشوق والنأي أبكاني","https://www.aldiwan.net/poem1684.html",""],[183,"هذا الإمام إمامي حاضر بادي","https://www.aldiwan.net/poem14504.html","البسيط"],[184,"إني امرؤ قد اضر بي حنفي","https://www.aldiwan.net/poem43613.html","المنسرح"],[184,"أتلزمني الذنب من غير ذنب","https://www.aldiwan.net/poem44121.html","المتقارب"],[202,"بيني وبينك يا ظلوم الموقف","https://www.aldiwan.net/poem53234.html","الكامل"],[209,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[209,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[219,"أتنآى ورجلاك فوق الثرى","https://www.aldiwan.net/poem55300.html","المتقارب"],[221,"الشاعران تبارك الغزلان","https://www.aldiwan.net/poem41447.html","الكامل"],[233,"بعلو جدك يسعد الدهر","https://www.aldiwan.net/poem31985.html","الكامل"],[235,"أتلومني يا عاذلي","https://www.aldiwan.net/poem19497.html","مجزوء الكامل"],[248,"ضحك الروض من بكاء السحاب","https://www.aldiwan.net/poem14925.html","الخفيف"],[248,"سر القلوب تذيعه الأجفان","https://www.aldiwan.net/poem15045.html","الكامل"],[269,"يا جيرة الحي في ذا الاثل والبان","https://www.aldiwan.net/poem52066.html","البسيط"],[280,"ومهفهف حلو الملاحة","https://www.aldiwan.net/poem32830.html","مجزوء الكامل"],[302,"يا سائلي عن عبرتي ومدامي","https://www.aldiwan.net/poem16845.html","الخفيف"],[362,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[364,"علمت من الحسن ما يجهل","https://www.aldiwan.net/poem17074.html","المتقارب"],[374,"قلب يقلبه النوى","https://www.aldiwan.net/poem59383.html","مجزوء الكامل"],[374,"الله الله أنت السمع والبصر","https://www.aldiwan.net/poem59432.html","البسيط"],[394,"لعينيك من جارة جائره","https://www.aldiwan.net/poem11010.html","عموديه"],[403,"أحياه بعد الله إذ حياه","https://www.aldiwan.net/poem50091.html","الكامل"],[403,"أتلك حدوج أم نجوم سوائر","https://www.aldiwan.net/poem50170.html","الطويل"],[406,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[413,"من لصب متيم مستهام","https://www.aldiwan.net/poem53989.html","الخفيف"],[414,"ولما تولى الخد وال عذاره","https://www.aldiwan.net/poem4105.html","الطويل"],[426,"لا وعينيك والجبين وجيدك","https://www.aldiwan.net/poem40281.html","الخفيف"],[429,"نعم هو البرق على الأنعم","https://www.aldiwan.net/poem12720.html","السريع"],[429,"تولى سقي دارهم الولي","https://www.aldiwan.net/poem12770.html","الوافر"],[441,"يا ثلج في مصبحي وفي غسقي","https://www.aldiwan.net/poem56012.html","عموديه"],[451,"أهتز قربك كالزمان قصيدة","https://www.aldiwan.net/poem61380.html","الكامل"],[456,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[462,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[512,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[513,"يا صاح لست من الغرام بصاح","https://www.aldiwan.net/poem12056.html","الكامل"],[513,"يا سيداً في أوصافه","https://www.aldiwan.net/poem12111.html","مجزوء الكامل"]],"verses":[["أَتَلَهّى بِها الهَواجِرَ إِذ كُ","لُّ اِبنَ هَمٍّ بَلِيَّةٌ عَمياءُ",0,"ا",2,0],["أَتَلومُني فيمَن أَنا","مِن حُبِّهِ مِثلُ المُعَلَّق",1,"ق",1,0],["إتْلافُ نَفْسي في هَواكِ حَياتُها","وفَناءُ قَلبي في رِضاكِ وُجودُهُ",2,"د",2,0],["أَتِلْكَ شَمُولٌ صِرْفَةٌ أَمْ شَمَائِلٌ","وَهَلْ ضَرَبٌ عَذْبُ الْجَنا أَمْ ضَرَائِبُ",3,"ب",1,0],["أتلْكَ شَمالٌ أمْ شَمولٌ مُدارَةٌ","على كلِّ غُصْنٍ في الحَديقةِ ميّاسِ",4,"س",1,0],["أَتَلاشى في مَحَبَّتِهِ","كَتَلاشي الظِلِّ في القَمَرِ",5,"ر",1,0],["أَتِلكَ الأَماكِنُ لا تُستَرادُ","أَتِلكَ المَناظِرُ لا تُجتَلى",6,"ا",1,0],["أَتلَفتَني كَلَفاً أَبلَيتَني أَسَفاً","قَطَّعتَني شَغَفاً أَورَثتَني عِلَلا",7,"ل",2,0],["أَتلَعُ لا يَغلِبُهُ قِرنُهُ","مُستَجمِعُ الرَأيِ عَظيمٌ طَويل",8,"ل",1,0],["أَتِلْكَ العُيُونُ وَأَنْوَارُهَا","مَراءٍ لأَخْلاقِها البَاهِرَهْ",9,"ر",2,0],["أَتِلْكَ الشِّفَاهُ وَمَا قَبَّلَتْ","هَا سِوَى الأُمِّ وَاللِّدَةِ الزَّائِرَهْ",9,"ر",2,0],["أَتِلْكَ الطُّفُولَةُ وَهْيَ سِيا","جٌ لِرَوْضٍ بِهِ نَفْسُهَا طَائِرَهْ",9,"ر",2,0],["أَتُلِمُّ رُوحُكَ بِالحِمَى إِلمَامَةً","فَيَرَى الهُدَى فِي نُورِهَا الخَصْمَانِ",10,"ن",1,0],["أتِلْكَ سَارَا الَّتِي كَا","نَ حُسْنُهَا يَسْبِينَا",11,"ن",2,0],["أَتَلتَمِسُ السِبابَ بَنو نُمَيرٍ","فَقَد وَأَبيهِمُ لاقوا سِبابا",12,"ب",2,0],["أتلقاك وطرفي ….. مطرق","خجلا من أمسك المنصرم",13,"م",1,0],["أتلفْ به داءً وأخلِفْ صحةً","والبسْ جديد العيش لبسَ معمَّر",14,"ر",1,0],["أتلومهم للنفع أم لتزيدهم","باللوم إقلاقا على إقلاق",15,"ق",1,0],["أتلتمسُ الشفاءَ لديك حالي","فتُمنَى منك بالداء العُضال",16,"ل",1,0],["أتَلْقى وجْهَ مسْبوقٍ بمَسْح","وتلقى وجهَ سبَّاقٍ بلَطْمِ",17,"م",1,0],["أتلقّى بجبيني من رَمَى","وبنحري وبصدري من طَعن",18,"ن",1,0],["أَتلو أَناشيدَ النَبِيِّ ضُحىً","وَأُطالِعُ الإِنجيلَ في العَصرِ",19,"ر",1,0],["أَتَلجُمُ ماءَ النَهرِ عَن جَرَيانِهِ","مَخافَةَ أَن يَفنى إِذَن فَاِشرَبِ الوَحلا",20,"ل",2,0],["أَتَلَقَّفُ اللَذاتِ غَيرَ مُحاذِرٍ","وَأَعُبُّ في الزَلّاتِ وَالآثامِ",21,"م",1,0],["أَتَلَقّى الوَحيَ عَن بُلبُلِها","وَهوَ وَلهانٌ يُغَنّي لِرُباها",22,"ا",3,0],["أتلقى الارض ساعتها ويلقى","عليها كل ذي روح زوالا",23,"ل",2,0],["أَتَلتَمِسُ الأَعداءُ بَعدَ الَّذي رَأَت","قِيامَ دَليلٍ أَو وُضوحَ بَيانِ",24,"ن",1,0],["أَتَلفتَني بِالصُدودِ مُعتَدِياً","فَذَلَّ عِزّي وَعَزَّ مُصطَبَري",25,"ي",1,0],["أَتِلكَ أَم حِينَ نادى سَرحَةً فَأَتَت","إِلَيهِ مَنشُورَةَ الأَغصانِ كَالجُمَمِ",26,"م",1,0],["أَتْلُو بِهِ الْحَقَّ وَأَرْمِي بِهِ","نَحْرَ الْعِدَا فِي الرَّهَجِ السَّاطِلِ",27,"ل",1,0],["أَتَلحى مُحِبّاً هائِمَ القَلبِ أَن رَأى","شَبيهاً لِمَن يَهواهُ في الحَبلِ موثَقا",28,"ق",2,1],["أتِلْكَ للنشءِ دارٌ نحن نشهدها","أم نحن نشهدُ للإِسلام إيوانا",29,"ن",2,0],["أتلك ديارُنا أم نحن مَوْتَى","تُقامُ لنا المقابرُ واللُّحودُ",30,"د",1,0],["أَتَلقى الحَتفَ لا حامٍ فَيَحمي","مَقاتِلَها وَلا واقٍ يَقيها",31,"ي",3,0],["أَتِلكَ مَصارِعُ المُستَضعَفينا","فَما بالُ الهُداةِ المُصلِحينا",32,"ن",2,1],["أَتلك فَتاةٌ يا بَني مِصرَ إِنَّكُم","تَوهّمتُمو هَذا فَخابَ التَوهُّمُ",33,"م",1,0],["أتلك إذ صدقت يا عمرو أم حَجَرٌ","يرمِي به الصادقَ المأمونَ إجفيل",34,"ل",1,0],["أَتلَفتَ قَلبي فَاِستَرَحتُ مِنَ المُنى","كَم مِن رِضىً في طَيِّ كُرهِ الكارِهِ",35,"ر",2,0],["أَتلِف إِذا أَعطَتك أَعراضَها","فَإِنَّها رَهنٌ بِإِتلافِها",36,"ف",3,0],["أتَلهو بَينَ باطِيةٍ وَزيرِ","وأنتَ مِنَ الهلاكِ على شفيرِ",37,"ر",1,1],["أتلفت ما أَبقى أب","فكأَنَّما أَنتَ الوَريث",38,"ث",1,0],["أتلقَّاكِ وكأسي في يديَّا","ونشيدي ضارعٌ في شفتيَّا",39,"ي",2,0],["أتلك بيروتُ أم من بابلٍ صُوَرٌ","معلقاتٌ لها بالسحر إِيحاءُ",40,"ا",2,0],["أَتْلَفْتَ دُنْيَاكَ الَّتِي أُوتِيتَهَا","وَلَسَوْفَ تَهْلِكُ حَسْرَةً فِي الآخِرَهْ",41,"ر",2,0],["أَتَلْتَمِسُ الشَّفَاءَ فَإِنْ يُعَجَّلْ","فَكَيْفَ يَلَذُّهُ القَلْبُ العَلِيلُ",42,"ل",1,0],["أُتْلُ عنَّا مَا أَذَعْنَاهُ شَذاً","وَابْتِساماً فَتَلاَ مُؤْتَمِرَا",43,"ر",2,0],["أَتِلْكَ مِنَ الكَلِمِ الذَّاكِيَا","تِ تَسِيلُ النُّفُوسُ بِهَا أَنْهُرَا",44,"ر",2,0],["أتلمس الأشباح والأ","رواح من خلل الحقوب",45,"ب",1,0],["أَتِلْكَ مَنْ حَدَّثَتْ عَنْها عَجَائِزُنا","وَقُلْنَ إِنَّ مَليكَ الجِنِّ يَهْواها",46,"ا",3,0],["أَتلَفَ المالَ وَما جَمَّعتُهُ","طَلَبُ اللَذّاتِ في ماءِ العِنَب",47,"ب",1,1],["أتلكَ أندَلُسٌ أُخْرى فقد نبشَتْ","من حقدِ ساداتِهمْ ما كان مدفُونَا",48,"ن",2,0],["أتِلْكَ شمولٌ صِرْفة ٌ أم شمائلٌ","وهلْ ضَرَبٌ عَذْبُ الجنى أم ضرائبُ",49,"ب",1,0],["أتلك من حدثت عنها عجائزها","وقلن إن ميلك الجن يهواها",50,"ا",3,0],["أتلجم ماء النهر عن جريانه","مخاقة أن يفنى؟ اذن ، فاشرب الوحلا",51,"ل",2,0],["أتلومُني وأنا حلفت أليَّةً","فوربه لا أَنْثني عن وُده",52,"د",2,0],["أتلقَّى بحسن أخلاقك الغُ","رِّ شبيابهنّ وجهاً أغرَّا",53,"ر",2,0],["أتلفي ما شئتِ أو ما يُشتهى","ليس بي شيءٌ لما شئتِ عصيَّا",54,"ي",2,0],["أَتَلحى عَلى فَيضِ الدُموعِ وَقَد ثَوى","أَخي وَشَقيقي وَاِبنُ عَمّي وَخُلصاني",55,"ن",2,0],["أتلو محاسنَه الغُرَّ التي نَظمتْ","دُرَّ الكلامِ وغيري في أبي جاد"