1082",""],[5275,"مرحبا بالانسان _ جابر الشكرجي","https://www.poetsgate.com/ViewPoem.aspx?id=35814",""],[5307,"يا عويد البان","https://www.poetsgate.com/ViewPoem.aspx?id=10540",""],[5358,"طرقتُ بابَك","https://www.poetsgate.com/ViewPoem.aspx?id=183427",""],[5387,"لغة الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=53821",""],[5419,"أنا وهي والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=32276",""],[5431,"على لسان نازح سوري...","https://www.poetsgate.com/ViewPoem.aspx?id=209152",""],[5431,"من شعر الحكمة ...","https://www.poetsgate.com/ViewPoem.aspx?id=211087",""],[5431,"قصيدة تفكيكية","https://www.poetsgate.com/ViewPoem.aspx?id=215486",""],[5443,"حسرةٌ وعتابٌ","https://www.poetsgate.com/ViewPoem.aspx?id=185146",""],[5461,"من بلاه الله","https://www.poetsgate.com/ViewPoem.aspx?id=5231",""],[5472,"يا أيها المرجوّ للدّهر","https://www.poetsgate.com/ViewPoem.aspx?id=200468",""],[5559,"بيننا شغاف الروح ( محمود أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=60738",""],[5582,"أَنَّى يَكُونُ مِنَ الغَرامِ جُحُودُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186884",""],[5582,"لَمْ أَسْتَمِعْ يا هِنْدُ نَوْحَ حَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=187299",""],[5582,"بِنَفْسِي هَوَىً بِالظَّاعِنِينَ كَوانِسا","https://www.poetsgate.com/ViewPoem.aspx?id=187157",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5633,"عَزْفٌ فِي شَبَابِيكِ الْأَمَانِ","https://www.poetsgate.com/ViewPoem.aspx?id=208629",""],[5638,"عيون.....","https://www.poetsgate.com/ViewPoem.aspx?id=198255",""],[5690,"يا عنترةَ بسولٍ كفوا","https://www.poetsgate.com/ViewPoem.aspx?id=172287",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5729,"ضاعت حروفي","https://www.poetsgate.com/ViewPoem.aspx?id=203997",""],[5732,"ذابت الروح","https://www.poetsgate.com/ViewPoem.aspx?id=177904",""],[5732,"ما من خطا","https://www.poetsgate.com/ViewPoem.aspx?id=177898",""],[5736,"تعاويذ الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=214522",""],[5784,"سفر المجاز","https://www.poetsgate.com/ViewPoem.aspx?id=215226",""],[5848,"العاشق الأكذوبه","https://www.poetsgate.com/ViewPoem.aspx?id=48977",""],[5848,"جتك تكفى","https://www.poetsgate.com/ViewPoem.aspx?id=53101",""],[5861,"شمس الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=188046",""],[5861,"صرخة أم","https://www.poetsgate.com/ViewPoem.aspx?id=188056",""],[5861,"قل لي","https://www.poetsgate.com/ViewPoem.aspx?id=191505",""],[5939,"ليلى وأخواتها","https://www.poetsgate.com/ViewPoem.aspx?id=190078",""],[5943,"ماأنصف الناس إنسانا بما وصفوا","https://www.poetsgate.com/ViewPoem.aspx?id=61957",""],[5952,"هل كمثلي","https://www.poetsgate.com/ViewPoem.aspx?id=202222",""],[5956,"أجثو على قدميك أرجو الأمنا","https://www.poetsgate.com/ViewPoem.aspx?id=182414",""],[5956,"مُكافأة من الله","https://www.poetsgate.com/ViewPoem.aspx?id=194053",""],[5956,"أحنو عليكِ عسى ترين الأمنا","https://www.poetsgate.com/ViewPoem.aspx?id=194818",""],[6046,"إسلامي في عصر الكفر","https://www.poetsgate.com/ViewPoem.aspx?id=37429",""],[6056,"إسمك وعنوانك بجوالي","https://www.poetsgate.com/ViewPoem.aspx?id=130335",""],[6069,"لا تجزعن بقلبك المفتون","https://www.poetsgate.com/ViewPoem.aspx?id=105710",""],[6093,"الكرش","https://www.poetsgate.com/ViewPoem.aspx?id=195239",""],[6102,"موعد","https://www.poetsgate.com/ViewPoem.aspx?id=185070",""],[6149,"يصف النسيم إذا يمر به","https://www.poetsgate.com/ViewPoem.aspx?id=169626",""],[6198,"الجدول المهزوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79240&r=&rc=14",""],[6198,"الموجةُ الطروبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79239&r=&rc=13",""],[6244,"ربيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=509&r=&rc=2",""],[6289,"فَجْر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81676&r=&rc=3",""],[5126,"فكرة مُختلطة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87818&r=&rc=33",""],[6345,"أنشودة للناي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78652&r=&rc=23",""],[6366,"آتٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86672&r=&rc=1",""]],"verses":[["أَتَلَهّى بِها الهَواجِرَ إِذ كُ","لُّ اِبنَ هَمٍّ بَلِيَّةٌ عَمياءُ",0,"ا",2,0],["أَتَلومُني فيمَن أَنا","مِن حُبِّهِ مِثلُ المُعَلَّق",1,"ق",1,0],["إتْلافُ نَفْسي في هَواكِ حَياتُها","وفَناءُ قَلبي في رِضاكِ وُجودُهُ",2,"د",2,0],["أَتِلْكَ شَمُولٌ صِرْفَةٌ أَمْ شَمَائِلٌ","وَهَلْ ضَرَبٌ عَذْبُ الْجَنا أَمْ ضَرَائِبُ",3,"ب",1,0],["أتلْكَ شَمالٌ أمْ شَمولٌ مُدارَةٌ","على كلِّ غُصْنٍ في الحَديقةِ ميّاسِ",4,"س",1,0],["أَتَلاشى في مَحَبَّتِهِ","كَتَلاشي الظِلِّ في القَمَرِ",5,"ر",1,0],["أَتِلكَ الأَماكِنُ لا تُستَرادُ","أَتِلكَ المَناظِرُ لا تُجتَلى",6,"ا",1,0],["أَتلَفتَني كَلَفاً أَبلَيتَني أَسَفاً","قَطَّعتَني شَغَفاً أَورَثتَني عِلَلا",7,"ل",2,0],["أَتلَعُ لا يَغلِبُهُ قِرنُهُ","مُستَجمِعُ الرَأيِ عَظيمٌ طَويل",8,"ل",1,0],["أَتِلْكَ العُيُونُ وَأَنْوَارُهَا","مَراءٍ لأَخْلاقِها البَاهِرَهْ",9,"ر",2,0],["أَتِلْكَ الشِّفَاهُ وَمَا قَبَّلَتْ","هَا سِوَى الأُمِّ وَاللِّدَةِ الزَّائِرَهْ",9,"ر",2,0],["أَتِلْكَ الطُّفُولَةُ وَهْيَ سِيا","جٌ لِرَوْضٍ بِهِ نَفْسُهَا طَائِرَهْ",9,"ر",2,0],["أَتُلِمُّ رُوحُكَ بِالحِمَى إِلمَامَةً","فَيَرَى الهُدَى فِي نُورِهَا الخَصْمَانِ",10,"ن",1,0],["أتِلْكَ سَارَا الَّتِي كَا","نَ حُسْنُهَا يَسْبِينَا",11,"ن",2,0],["أَتَلتَمِسُ السِبابَ بَنو نُمَيرٍ","فَقَد وَأَبيهِمُ لاقوا سِبابا",12,"ب",2,0],["أتلقاك وطرفي ….. مطرق","خجلا من أمسك المنصرم",13,"م",1,0],["أتلفْ به داءً وأخلِفْ صحةً","والبسْ جديد العيش لبسَ معمَّر",14,"ر",1,0],["أتلومهم للنفع أم لتزيدهم","باللوم إقلاقا على إقلاق",15,"ق",1,0],["أتلتمسُ الشفاءَ لديك حالي","فتُمنَى منك بالداء العُضال",16,"ل",1,0],["أتَلْقى وجْهَ مسْبوقٍ بمَسْح","وتلقى وجهَ سبَّاقٍ بلَطْمِ",17,"م",1,0],["أتلقّى بجبيني من رَمَى","وبنحري وبصدري من طَعن",18,"ن",1,0],["أَتلو أَناشيدَ النَبِيِّ ضُحىً","وَأُطالِعُ الإِنجيلَ في العَصرِ",19,"ر",1,0],["أَتَلجُمُ ماءَ النَهرِ عَن جَرَيانِهِ","مَخافَةَ أَن يَفنى إِذَن فَاِشرَبِ الوَحلا",20,"ل",2,0],["أَتَلَقَّفُ اللَذاتِ غَيرَ مُحاذِرٍ","وَأَعُبُّ في الزَلّاتِ وَالآثامِ",21,"م",1,0],["أَتَلَقّى الوَحيَ عَن بُلبُلِها","وَهوَ وَلهانٌ يُغَنّي لِرُباها",22,"ا",3,0],["أتلقى الارض ساعتها ويلقى","عليها كل ذي روح زوالا",23,"ل",2,0],["أَتَلتَمِسُ الأَعداءُ بَعدَ الَّذي رَأَت","قِيامَ دَليلٍ أَو وُضوحَ بَيانِ",24,"ن",1,0],["أَتَلفتَني بِالصُدودِ مُعتَدِياً","فَذَلَّ عِزّي وَعَزَّ مُصطَبَري",25,"ي",1,0],["أَتِلكَ أَم حِينَ نادى سَرحَةً فَأَتَت","إِلَيهِ مَنشُورَةَ الأَغصانِ كَالجُمَمِ",26,"م",1,0],["أَتْلُو بِهِ الْحَقَّ وَأَرْمِي بِهِ","نَحْرَ الْعِدَا فِي الرَّهَجِ السَّاطِلِ",27,"ل",1,0],["أَتَلحى مُحِبّاً هائِمَ القَلبِ أَن رَأى","شَبيهاً لِمَن يَهواهُ في الحَبلِ موثَقا",28,"ق",2,1],["أتِلْكَ للنشءِ دارٌ نحن نشهدها","أم نحن نشهدُ للإِسلام إيوانا",29,"ن",2,0],["أتلك ديارُنا أم نحن مَوْتَى","تُقامُ لنا المقابرُ واللُّحودُ",30,"د",1,0],["أَتَلقى الحَتفَ لا حامٍ فَيَحمي","مَقاتِلَها وَلا واقٍ يَقيها",31,"ي",3,0],["أَتِلكَ مَصارِعُ المُستَضعَفينا","فَما بالُ الهُداةِ المُصلِحينا",32,"ن",2,1],["أَتلك فَتاةٌ يا بَني مِصرَ إِنَّكُم","تَوهّمتُمو هَذا فَخابَ التَوهُّمُ",33,"م",1,0],["أتلك إذ صدقت يا عمرو أم حَجَرٌ","يرمِي به الصادقَ المأمونَ إجفيل",34,"ل",1,0],["أَتلَفتَ قَلبي فَاِستَرَحتُ مِنَ المُنى","كَم مِن رِضىً في طَيِّ كُرهِ الكارِهِ",35,"ر",2,0],["أَتلِف إِذا أَعطَتك أَعراضَها","فَإِنَّها رَهنٌ بِإِتلافِها",36,"ف",3,0],["أتَلهو بَينَ باطِيةٍ وَزيرِ","وأنتَ مِنَ الهلاكِ على شفيرِ",37,"ر",1,1],["أتلفت ما أَبقى أب","فكأَنَّما أَنتَ الوَريث",38,"ث",1,0],["أتلقَّاكِ وكأسي في يديَّا","ونشيدي ضارعٌ في شفتيَّا",39,"ي",2,0],["أتلك بيروتُ أم من بابلٍ صُوَرٌ","معلقاتٌ لها بالسحر إِيحاءُ",40,"ا",2,0],["أَتْلَفْتَ دُنْيَاكَ الَّتِي أُوتِيتَهَا","وَلَسَوْفَ تَهْلِكُ حَسْرَةً فِي الآخِرَهْ",41,"ر",2,0],["أَتَلْتَمِسُ الشَّفَاءَ فَإِنْ يُعَجَّلْ","فَكَيْفَ يَلَذُّهُ القَلْبُ العَلِيلُ",42,"ل",1,0],["أُتْلُ عنَّا مَا أَذَعْنَاهُ شَذاً","وَابْتِساماً فَتَلاَ مُؤْتَمِرَا",43,"ر",2,0],["أَتِلْكَ مِنَ الكَلِمِ الذَّاكِيَا","تِ تَسِيلُ النُّفُوسُ بِهَا أَنْهُرَا",44,"ر",2,0],["أتلمس الأشباح والأ","رواح من خلل الحقوب",45,"ب",1,0],["أَتِ