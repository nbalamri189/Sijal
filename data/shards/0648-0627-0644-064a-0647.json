m/ViewPoem.aspx?id=208678",""],[5790,"الله أكبر أي طرف يطمح","https://www.poetsgate.com/ViewPoem.aspx?id=111868",""],[5848,"محراب صمتك","https://www.poetsgate.com/ViewPoem.aspx?id=53163",""],[5910,"فلطالما حاربتُ ذا سفهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=207125",""],[5953,"قل لمن كان في هموم عظام","https://www.poetsgate.com/ViewPoem.aspx?id=93878",""],[5956,"ساقية","https://www.poetsgate.com/ViewPoem.aspx?id=183161",""],[6073,"شقَّ الدُّجى عن نحره الفجرُ","https://www.poetsgate.com/ViewPoem.aspx?id=18592",""],[496,"ثلاثة اسماءهم تقرع ال","http://www.aldiwanalarabi.com/poemDescription.do?poemId=599158",""],[6225,"شراع وريح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80914&r=&rc=183",""]],"verses":[["وَإِلَيْهِ يَصْبو الرُّواةُ وَفيهِ","مَعَ شِكْل الحِجازِ ظَرْفُ العِراقِ",0,"ق",1,0],["وَإِلَيهِمُ اِستَقبَلتُ كُلَّ وَديقَةٍ","شَهباءَ يَسفُع حَرُّها كَالنارِ",1,"ر",1,0],["وَإِلى هُنا حَبَسَ الحَياءُ لِسانَها","وَجَرى البُكاءُ بِدَمعِها الهَطّالِ",2,"ل",1,0],["والى هذا اليوم لم تتفتح","زهرة لي في روضة الآمال",3,"ل",1,0],["وإليه يفزع من أسى","يطغى ومن ثكل يثور",4,"ر",1,0],["وَإِلَيهِ أَتعَبنا المَطا","يا بِالرَواحِ وَبِالبُكورِ",5,"ر",1,0],["وَإِلَيهِ المُصطَفى لَيلاً سَرى","وَكَذا البَيعة حَيث عمرا",6,"ر",2,0],["وإليها نَجْلاءُ يَرْهَبُها الشّيْ","خُ كما يَرْهَبُ الصّغيرُ الكَبيرا",7,"ر",2,0],["وَإلَيْهِ أَهْدَتْ أَفَانِينَ مِن أَز","هَارِهَا كُلُّ رَوْضَةٍ غَنَّاءِ",8,"ا",2,0],["وإليه امتدت من الفلك ال","أطلس كف افتقاره للسؤال",9,"ل",1,0],["وإليه أشكو لوعة وصبابة","لو كان يعلمها لرّق لحاليهْ",10,"ي",2,0],["وإليه حجّ وصام عمّا دونه","وإليه صلّى بالدعا تسليما",11,"م",2,0],["وإليه خرّت غصون الروابي","حيثما كان للأصول المربي",12,"ب",2,0],["واليه أذعنت العُقول فآمنت","با لغيب تؤثر حبها اياه",13,"ا",2,0],["وَإلَيْهِ خَفَّت وَالرَّجَاحَةُ في الهَوى","أَنْ يَجْعَلَ الآوِي لَهُ وَيَطِيشا",14,"ش",2,0],["وَإِلَيهِ تُنمى بَنوهُ وَطيبُ ال","أَصلِ مُستَأزَرٌ بِطيبِ الجَناءِ",15,"ا",2,0],["وإليهِ أَلقى الفَضلُ صعبَ زِمامِه","وَدَنا له طوعاً وكانَ بَعيدا",16,"د",2,0],["وإِليه يَنتَهي البخلُ ولو","أَنَّه في جوده حاتِمُ طَي",17,"ي",1,0],["وإلى هنا انقطعَ الحديثُ لعارضٍ","بين الكلام وبينه قد حالا",18,"ل",2,0],["وَإلى هنا عَقَلَ البكاءُ لسانَها","والحزنُ حتى ما تسيغ مُجاجها",19,"ج",3,0],["وإليه بعد اللَه مل","جؤُنا ففي يده الأمانه",20,"ه",1,0],["وَإِلَيهِ عِندَ الخِصامِ اِحتِكامي","فَلِذا رُحتُ داحِضاً خُصَمائي",21,"ي",1,0],["وَأَلِيَّةً بِجَميلُكُم قَبلَ الجَفا","وَجَمالِكُم ذاكَ العَزيزِ الغالي",22,"ل",2,0],["وَإِلَيهِ يُرشِدُ الرَكبَ إِذا","شَذَّ عَنهُ النورُ مِنهُ وَالشُذَي",23,"ي",1,0],["وَإِلَيهِ الهِندُ عَن قُبَّتِها","نَهَدَت تَطلُبُهُ عِندَ الخُبَي",23,"ي",1,0],["وإليها حجَجت لكن حجِّي","عِوضٌ عن مَناسكي فيه شِعري",24,"ر",2,0],["وإليه يرجع كُلُّ حَبْرٍ عالم","منهم ويرجوه لحل المشكل",25,"ل",1,0],["وإليه كل شخص شاخص","قلت هذا قبلة للمقل",26,"ل",1,0],["وإليه ملكه منتقل","ومقاليد الهوى قد ألقيت",27,"ت",1,0],["وَإِلَيهمُ لَو أَنصف الناس انتهت","شُعَبُ الفَصاحة وابتَدت في يَعربِ",28,"ب",1,0],["وإليهمُ مِن بَعدِ غَيْ","بَتِهمْ وإن طالتْ نَئُوبُ",29,"ب",1,0],["وإليه وإلى عليائه","أَنيق الرَّاجين أمست تترامى",30,"م",2,0],["وإِليهما قذفَتْ بنا نُوَبٌ","أَغرَتْ بنا أَنيابَها العُصْلا",31,"ل",2,0],["وأليَّةٍ تَرْضى بها","وألِيَّتي رَبُّ الفَلَقْ",32,"ق",1,0],["وألِيَّةٍ لم يُقْصَ عن آرابِهِ","من رامَ من إحْسانِهِ الأنْفاسا",33,"س",2,0],["وإلَيه كلُّ أمرٍ مُوكَل","وبمَا يَرضَى به أنتَ رَضِي",34,"ي",1,0],["وَإليهمْ إِذا تحيّز أقوا","مٌ بقومٍ تحيُّزي واِنضمامي",35,"م",2,0],["وَإِليهنَّ يَشُدُّ ال","قومُ هاتيك الغُروضا",36,"ض",2,0],["وإليه اهتدت ملائكة الل","ه وزادت بأمره إيقانا",37,"ن",2,0],["وإليه ترجعون اللهُ قد","قال في القرآنِ والسبع الطوال",38,"ل",1,0],["وإليها ملنا نهيم فمالت","وقصدنا طلولها حين طالت",39,"ت",1,0],["واليهود الذين قالوا بأنا","نحن أبناء الله والكفر ذاكا",40,"ك",2,0],["وإليه رأس المفاخر وطَّى","يا وحيد الوجود لا زال عنه",41,"ه",1,0],["وإليه مرجع كل شيء في الورى","لا سيما أهل العظام الناخره",42,"ر",2,0],["وإليه فاسمع تقلبو","ن كما أتاك مقررا",43,"ر",2,0],["وإِليْهِمُ أَضْحَتْ مُهاجَرَتي","وإِليهمُ حِلِّي وترْحَالِي",44,"ل",2,0],["وإِلَيْه تَأْتِي حِين تَأْتِي خُشَّعاً","وعلَيْه تَدْخُل حِينَ تَدْخُل سُجَّدا",45,"د",2,0],["وإليه قد سرت المفاخر عن أب","زهت البلاد بنسله المتجدد",46,"د",1,0],["وإليه يرجع ما الكنانة أحرزت","من شهرة عظمت لدى الغرباء",47,"ا",2,0],["وإليهِ مِن فرطِ السرور تسابَقَت","وَلديهِ آيات الثناء تزمّلُ",48,"ل",1,0],["وإليه ضمّت صوتَها","فصَغت إلى خيرِ اِقتراحِ",49,"ح",1,0],["وإليهمُ طَربي وفيهم بُغيَتي","وبهم أؤمِل في الجِنانِ خُلودا",50,"د",2,0],["وَإِلَيهِ مَشى كِبار بَنيها","بَعدَ ما أَيد الجَميع اِنتَقاه",51,"ا",2,0],["وَإِلَيها شَبابها عادَ لَمّا","قامَ فيها عَزيزها بِالأَمر",52,"ر",1,0],["وَإِلَيها اِمتِيازُها عاد لما","جاءَها بامتيازها في كِتاب",53,"ب",1,0],["وَإلَيهِ زف كَريمة الأَصل الَّتي","أَثنى عَلَيها المَجد قَبل فطام",54,"م",1,0],["وَإِلَيهِ قَد صعدت صَواريخٌ لَها","ضوء بَديع اللَون وَهوَ جَديد",55,"د",1,0],["وإليه اهتدت ملائكة الل","ه وطابت بأمره ارواحا",56,"ح",2,0],["وَإِلَيهِ ينظرُ مُقبِلاً","وَيَمنُّ في لينِ الكَلام",57,"م",1,0],["وَإِلَيهِ أَرسَلَ عَسكَراً مِثلَ الأُسو","دِ فَحَلَّ فيهِ ناشِر الراياتِ",58,"ت",1,0],["وَإِلَيهِ سَلِّمْ وَاِتّكِلْ","فَاللَّهُ خَيرٌ حافِظا",59,"ظ",2,0],["وَإِلَيهِ سَلَّمَ أَمرَهُ","بِالاِختِيارِ وَفَوَّضا",60,"ض",2,0],["وإليه تفويضُ الأمور من الورى","وبحبله لِلائذين الإعتصام",61,"م",1,0],["وإليهم في كل خطب فادح","يلجأ فيصدر بالمنى الورّاد",62,"د",1,0],["واليهم حبل وصلي","درة العقد الثمين",63,"ن",1,0],["وإليه أبكي وأضرع خوفا","من ذنوب أو قرن ظهري الهزيلا",64,"ل",2,0],["وإليه مال الفيء إذ لم يترك","الصحب الرفاق له به من موضع",65,"ع",1,0],["وإليه يعزى نورهم وبسرّه","أضحوا مظاهر كل معنى أشمل",66,"ل",1,0],["وَإلَيْهِ عَادَ الأمْرُ بَعْدَ ذَهَابِهِ","عَنْهُ وكَانَ العَوْدُ أحْمَدَ مُنْتَظَرْ",67,"ر",1,0],["وإليه يعزون كل المقام","نولوه ومنه نالوا الفخارا",68,"ر",2,0],["وإليهم انتهت المدائح فهي إن","جازتهم ضرب من الهذيان",69,"ن",1,0],["واليهم في كل خطبٍ موئلي","واليهم في كل صعب مرجعي",70,"ع",2,0],["وإليه تجذب الخلق كما","يجذب المريخ بالمغنطسِ",71,"س",1,0],["وإِليهِ كمْ حَلُّوا الحُبا","وعليه كمْ عَقَدُوا الخناصِرْ",72,"ر",1,0],["وإِليهِ خَفَّتْ بِنا العِيسُ في عُرْ","ضِ الفَيافي قَوادماً وخَوافي",73,"ف",2,0],["وإليها بها توسلت فاعجب","لحبيب به إليه الوسيله",74,"ل",2,0],["وإليها القلوب تشتاق حبا","وعليها الاسباب في الحب قامت",75,"ت",1,0],["وإليها تشير أوصاف علم ال","ذوق من فيض غامر البركات",76,"ت",1,0],["وإليه اشكو غفلتي وبطالتي","وقبيح افعالي وكثر رقادي",77,"د",2,0],["وإليه وجهة وجهتي مصروفة","وهو الذي بالحال مني يعلم",78,"م",1,0],["وإليه يهرعون الخلق إذ","هو محبوب لدى اللَه الصمد",79,"د",1,0],["وَإِلَيهِ ضَراعَتي وَاِبتِهالي","في مُعافاةِ شَيبَتي مِن جَهَنَّم",80,"م",1,0],["وَإِلَيهِ أَضرَعُ في إِنابَةِ مُخلِصٍ","فَهُوَ الَّذي أَرجو لِسَدِّ مَفاقِري",81,"ر",2,0],["وإليه ترتاح النفوس غلُبّة","فيميلها طبعا بغير تطبّع",82,"ع",1,0],["وإليه حينما أف","تي الورى أعزو مقالي",83,"ل",2,0],["وإليه مخَيّمٌ مَن أتاهُ","لم يزل آمناً من الإملاقِ",84,"ق",1,0],["وإليهُم مأوى اللَّهيفِ المُعْتَفي","ولَديهُم مُثْوى الطّريدِ المُزْعَجِ",85,"ج",1,0],["وأليّةً بالرّائحات إلى مِنى","عوجاً يزرنَ محصّبا ومعرَّفا",86,"ف",2,0],["وإليهم كلُّ فضلٍ يستَند","وبتطهيرِهم اللهُ شهد",87,"د",1,0],["وإليه رياسة الدين آبت","وقُصارى انتظارُها أن تؤوبا",88,"ب",2,0],["وإليه يلقي نفسه","عبداً لديه محررا",89,"ر",2,0],["وَإِليهم منكم طلوع","وَإِلَيكم منهم نزول",90,"ل",1,0],["وإلَيهِ تُنسَبُ بعدُ كلَّ فَضِيلَةٍ","لَم يَحوِهَا مَلِكٌ شَدِيدٌ أيِّدُ",91,"د",1,0],["وإليها الرأي والرزق","إن تكن حبلى إلى أن تضعا",92,"ع",2,0],["واليهودي إذا هو فقد","وله في الشرك أزواجٌ وقد",93,"د",1,0],["وإليهم رف قلبي","أبهم ما بي أم لا",94,"ل",2,0],["وَإِلَيهِ أَنجُمُها تَدَلَّت فِى الدُّجى","مِنها السَّناءُ وِهادَ مكَّةَ قَد غَمَر",95,"ر",1,0],["واليها نرى من الشام حتى ال","يومَ تزجى ايانقُ الركبانِ",96,"ن",1,0],["وإليه شكواي من حسراتي","وعنائي ومن بكائي وندبي",97,"ب",2,0],["وإليهم كل فخرٍ ينتمي","أيها المرجي لقاه في الممات",98,"ت",1,0],["وإليه الأشجار مما دعاها","قد أتته تخد خد التراب",99,"ب",1,0],["وإلى هذا فهم ما أمنوا","حال ذكراهم به من مكره",100,"ر",2,0],["وإليه من دمشق الشام قد","ساقها حكم القضا والقدر",101,"ر",1,0],["وإليه الهنا بمجلى عل