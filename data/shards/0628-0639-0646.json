{"poems":[[44,"بعني نسيب ولا تهب لي إنني","https://www.aldiwan.net/poem50457.html","الكامل"],[9,"بانت سعاد وأمسى حبلها رابا","https://www.aldiwan.net/poem21909.html","البسيط"],[9,"أقصر فكل طالب سيمل","https://www.aldiwan.net/poem21976.html","السريع"],[56,"عاذلي لو شئت لم تلم","https://www.aldiwan.net/poem27479.html","المديد"],[45,"يا ديار العباهر الأتراب","https://www.aldiwan.net/poem10613.html","الخفيف"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62240","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[327,"أضحت أميمة لا ينال زمامها","https://www.aldiwan.net/poem56344.html","الكامل"],[382,"عذراء عبرية قد زانها شرف","https://www.aldiwan.net/poem59409.html","البسيط"],[463,"من طالب بي في الظباء العين","https://www.aldiwan.net/poem55833.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1560,"","https://poetry.dctabudhabi.ae/diwan/poem/130734","الطويل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11121","البسيط"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33879","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27799","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109373","الطويل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10483","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93599","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93559","الوافر"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126538","الكامل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102417","الطويل"],[4116,"","https://poetry.dctabudhabi.ae/diwan/poem/177921","السريع"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97106","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72359","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139718",""],[4955,"مات الضمير تبلد الإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=188737",""],[5072,"يا رمزنا أنت قد بعناك","https://www.poetsgate.com/ViewPoem.aspx?id=53759",""],[5277,"فيالقُ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=192284",""],[5277,"بعْني شذاكَ","https://www.poetsgate.com/ViewPoem.aspx?id=206050",""],[5277,"صريخُ القوافي..","https://www.poetsgate.com/ViewPoem.aspx?id=206053",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[5419,"نقوش","https://www.poetsgate.com/ViewPoem.aspx?id=31470",""],[5444,"قصيدة اشتعال اخير باول الياس","https://www.poetsgate.com/ViewPoem.aspx?id=122016",""],[5495,"بده العام الدراسي (مرثيه لولده حيدر)","https://www.poetsgate.com/ViewPoem.aspx?id=175440",""],[5756,"نار وبارود","https://www.poetsgate.com/ViewPoem.aspx?id=5363",""],[5762,"نشيد يا شباب الجيل","https://www.poetsgate.com/ViewPoem.aspx?id=13135",""],[5830,"كل الشرائع في محرابك اجتمعت","https://www.poetsgate.com/ViewPoem.aspx?id=204642",""],[5937,"يا قُدسُ","https://www.poetsgate.com/ViewPoem.aspx?id=211883",""],[6152,"بك اكتفائي","https://www.poetsgate.com/ViewPoem.aspx?id=204526",""],[6233,"موكب ... لحرية الموت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78453&r=&rc=16",""],[6243,"مُوَشَّح خليجيّ ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84443&r=&rc=17",""],[6277,"نَوَرٌ نسميهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64476&r=&rc=39",""],[2220,"ذكرى إلهي ليسَ عنْ نسيانِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11841&r=&rc=710",""],[5190,"فتجملي بالصبر يا بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85048&r=&rc=123",""]],"verses":[["بِعني نُسَيبُ وَلا تَهَب لي إِنَّني","لا أَستَثيبُ وَلا أُثيبُ الواهِبا",0,"ب",2,1],["بِعَنتَريسٍ كَأَنَّ الحُصَّ ليطَ بِها","أَدماءَ لا بَكرَةً تُدعى وَلا نابا",1,"ب",2,0],["بِعَنتَريسٍ كَالمَحالَةِ لَم","يُثنَ عَلَيها لِلضِرابِ جَمَل",2,"ل",1,0],["بِعَناقيدٍ مُعَثكَلَةٍ","كَشُعورِ الزَنجِ في الحَمَمِ",3,"م",1,0],["بعُنَابٍ تسوّدت من حشائي","بسواد ومن دمي بخضاب",4,"ب",1,0],["بِعَنْسَيْنِ تَصْرِفُ أَلْحِيهِمَا","بِمُسَتْنقِعٍ كَصُبَابِ اللَّجِنْ",5,"ن",1,0],["بِعِنَايَةِ اللّهِ الجَدِيدَةِ أَبْشِرِ","وَاهْنَأْ بِطَالِعِهَا السِعيدِ المُسْفِرِ",6,"ر",1,1],["بِعَنَطنَطٍ كَالجِذعِ مِنها أَسطَعٌ","سامٍ يُمَدُّ جَديلُها وَزِمامُها",7,"م",3,0],["بعنفوان صِبا أيامِ سيرته","يعود ذا ألمٍ والعسرُ إيسار",8,"ر",1,0],["بِعنا صلاحَ قلوبنا بفسادها","يوم النقا برضاً من المغبونِ",9,"ن",1,0],["بعنت الأمة غذ خلاها","تجول أخراها على أولاها",10,"ه",2,0],["بعنويّة منه وقد جاس أرضها","بأسياف أجناد له نهش أرقم",11,"م",1,0],["بِعَنتَريسٍ كَأَنَّ الدَبرَ يَلسَعُها","إِذا تَرَنَّمَ حادٍ خَلفَها تَرِبُ",12,"ب",1,0],["بِعنا نَفيساً فَلَم يَحزَن لَهُ أَحَدُ","وَغابَ عَنّا فَغابَ الشُؤمُ وَالنَكَدُ",13,"د",1,1],["بِعناهُ أَخبَثَ مِن ذِئبٍ لَهُ قَدَمٌ","وَساعَدَتهُ عَلى رَأيِ اللُصوصِ يَدُ",13,"د",1,0],["بعناية النبي الكريمِ المصطفى","خيرِ الخلائقِ من بني عدنان",14,"ن",1,0],["بعنصره عِرقُ السيادة ثابتٌ","وفي ذاته نور السعادة مُشرِق",15,"ق",1,0],["بِعناكَ في بَطنِ مُخضَرٍّ عَوارِضُها","تَرى مِنَ اللُؤمِ في عِرنينِها خَنَسا",16,"س",2,1],["بِعُنق العامرية ما جنته","فَفيها عامر ظلمت نِزارا",17,"ر",2,0],["بِعُنق مِن رِقاب العفر أَحلى","وَأَصفى مِن قَوارير الزُجاج",18,"ج",1,0],["بعناية الباري أتى تاريخها","قد تم تسميطي فعاد جميلا",19,"ا",1,0],["بعنين طورا تغرقان من البكا","فاعشى وطورا تحسران فأبصرُ",20,"ر",1,0],["بعني بأغلى ثَمَنٍ نظرةً","أحيا بها يا طلعةَ المشتري",21,"ر",2,0],["بعناق الكعاب لا الكعاب الحس","نا لعمري تجاوز الجوزاء",22,"ا",2,0],["بعنعنة صحت روايتها عندي","وساقت حديث الطفَّ نحو مسامعي",23,"ي",1,0],["بعنق المشترىِّ أمدِّ باعاً","على رَغَبٍ تصافحه اعتناقا",24,"ق",2,0],["بعنا الأخوُّةَ بالرخيصِ من الدُّنا","أيباعُ بالمالِ القليلِ الماسُ",25,"س",1,0],["بعناه ُ إسلامَنا يا سيدي عَلَنا ً","وجُرْمُنا بحقوق ِ الله ِ يُرْتَكَب ُ",26,"ب",1,0],["بعنا الصحيحَ بأثمانٍ مؤجّلةٍ","ثمّ أشترينا رخيصاُ عافهُ ألأجلُ",27,"ل",1,0],["بعْني شذاكَ فقدْ أدمنتُ نسمتَهُ","وقدْ أريقَ على أعتابِهِ نزقي",28,"ق",2,0],["بعني شذاكِ..فريحُ قربكَ عنبرُ","واشفقْ..فقلبي إنْ نبوتَ سيُكسرُ",29,"ر",1,1],["بعني شذاكَ ومن سوايَ سيشتري","عشقاً عتيقاً..قدْ يبورُ ويخسرُ",29,"ر",1,0],["بعني لهُ..والسعرُ شرْبةُ كوثرٍ","من كفّ هادٍ..بالسماحةِ يُؤثَرُ",29,"ر",1,0],["بعنك حياً يا هبينغ بالهوى","وبالبغي والدعوات وجهل تجهما",30,"م",2,0],["بِعْنا النفيسَ بأثوابٍ ممزّقةٍ","باتتْ علينا.. فنام الكلُّ عريانا",31,"ن",2,0],["بعنا من الصفِ رأساً كان يحملُنا","فدُونكَ الآن في كُرسيِّه حمقُ",32,"ق",1,0],["بعنه البيت ، ريت البيت مهجوم","وريت اكثر بعد من هل الخساير",33,"ر",1,0],["بعنا المذلة للضعيف وشرينا","عزة نفوس وجد واخلاص وعهود",34,"د",1,0],["بَعْنَا فِلسطينْ، والهمَّة والدينْ واخْدَعْنَا اليمين، وَاصْبَحْنا آله","واشرَبنا النفاقْ، واشْرِينا الشقاقْ واذْبَحْنا الاَخْلاق، طَوْعَ الضَّلاَله",35,"ل",2,0],["بِعْنَا لِبَارِئِنَا الأَرْوَاحَ نُرْخِصُهَا","مَا شَانَنَا خَوَرٌ مِنْ شَرِّ مُنْتَقِمِ",36,"م",1,0],["بِعناكِ سجناً , لم نشاهد عارنا","حتى وقفتِ وكّلنا مسجونُ",37,"ن",1,0],["بعني من الهجر الطويل قليلا","فلعل قلبي أن يصير ملولا",38,"ل",2,1],["بِْعنا التاريخ ... وقشرته","بِعْنا \"أقصاه\" و\"بغداده\"",39,"د",2,0],["ِبِعْنِي إلى أيِّ الثّغور فحَرْبَتِي","تُؤْذِي وَتَعْرِفُ أيْن تَصْلبُ فاشِلا",40,"ل",2,0],["بِعْنِي إلى الأشعار ..أعْرفُ كُنْهَهَا","فهيَ العَفيفة لا تُحِبّ مَعَاقلا",40,"ل",2,0],["بِعْنِي إلى عَيْنَيْك َيا هذا المَدَى","حتّى أرَى الألَم العميق بَلاَبِلاَ",40,"ل",2,0],["بعنا العروبة بالوظيفة وانبرى","ليبيع \" غور أبي عبيدة \" أزعر",41,"ر",1,0],["بعناية ِ الندبِ الكريمِ المصطفى","خيِ الخلائقِ من بني عدنانِ",42,"ن",1,0],["بعناكِ بالصمت الذي بعنا به","قدسَ العروبةِ ، فاشترى الأوغادُ",43,"د",1,0]]}