{"poems":[[9,"من ديار بالهضب هضب القليب","https://www.aldiwan.net/poem21913.html","الخفيف"],[93,"كم فاض في أثر الهلال العاثر","https://www.aldiwan.net/poem9848.html","الكامل"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[38,"عاد الهموم وما يدري الخلي بها","https://www.aldiwan.net/poem7725.html","البسيط"],[45,"لا أرى بالبراق رسما يجيب","https://www.aldiwan.net/poem10653.html","الخفيف"],[45,"لك عهد لدي غير مضاع","https://www.aldiwan.net/poem64657.html","الخفيف"],[22,"شكت العنتريس نصي وإدلا","https://www.aldiwan.net/poem21677.html","الخفيف"],[52,"عرف الدار فحيا وناحا","https://www.aldiwan.net/poem27159.html","المديد"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55035","الخفيف"],[38,"عادَ الهمومُ وما يدري الخليُّ بها","https://www.poetsgate.com/ViewPoem.aspx?id=21204",""],[113,"نحن بالله عزنا","https://www.aldiwan.net/poem41993.html","مجزوء الخفيف"],[113,"في شمال ومغرب","https://www.aldiwan.net/poem41994.html","مجزوء الخفيف"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[320,"ذرفت عيني دموعا","https://www.aldiwan.net/poem56351.html","مجزوء الرمل"],[362,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[369,"لا مقصر عن هوى ولا سال","https://www.aldiwan.net/poem57226.html","المنسرح"],[369,"خذ حديثي فكم أغططي","https://www.aldiwan.net/poem57293.html","مجزوء الخفيف"],[388,"حصحص الحق يا فلان بالمسير بالرحيل","https://www.aldiwan.net/poem54538.html","عموديه"],[388,"يا حسين انشرح لك واشرح الصدر بالنور","https://www.aldiwan.net/poem54582.html","عموديه"],[459,"راسي الحبى في سلمه ونديه","https://www.aldiwan.net/poem16423.html","الكامل"]],"verses":[["قاصِدٌ وَجهُها تَزورُ بَني الحا","رِثِ أَهلَ الغِناءِ عِندَ الشُروبِ",0,"ب",1,0],["قاصى المباءة والقريب توافداً","لحفاوةٍ فيها بأكرم زائر",1,"ر",1,0],["قاصرة عن طرفِ يداه","مشروطة برجلِهِ أذناه",2,"ه",1,0],["قاصي المَحَلِّ طَباهُ عَن عَشيرَتِهِ","جُرءٌ وَبَينونَةُ الجَرداءِ أَو كَرَعُ",3,"ع",1,0],["قاصِداتٍ مُهَذَّباً لَم يُشَقِّق","في مَعالي فَعالِهِ التَهذيبُ",4,"ب",1,0],["قاصِداً لِلبِحارِ إِذ لَيسَ لِلمُد","نِ دِفاعٌ عَنهُ وَلا لِلقِلاعِ",5,"ع",1,0],["قاصِدٌ سَيرُها تَزورُ بَني العَب","بابِ أَهلَ النَدى وَأَهلَ الفِضالِ",6,"ل",1,0],["قاصِداتٍ كُلَّ شَرقٍ وَغَربٍ","ناطِقاتٍ بِالصَهيلِ فِصاحا",7,"ح",2,0],["قَاصِدٌ فِي سَبِيِلهِ","ما تَعَدَّى وَلاَ انْحَرَفْ",8,"ف",1,0],["قَاصِي الْمَحَلِّ طَبَاهُ عَنْ عَشِيرَتِهِ","جُزْءٌ وَبَيْنُونَة ُ الْجَرْدَاءِ أوْ كَرَعُ",9,"ع",1,0],["قاصداً كشف سترنا","بين خل وأجنبي",10,"ب",2,0],["قاصداً كشف سترنا","خصمه اللَه والنبي",11,"ب",2,0],["قاصرٌ عن بلوغِ فضلكَ مدح","هوَ في كلّ فاضلٍ إطراءُ",12,"ا",2,0],["قاصِراتٌ ناعِماتٌ","في نَعيمٍ وَسُرورِ",13,"ر",1,0],["قاصِدي ماجدٍ إذا قصَدوه","بَلَغوا من نَواله المَقْصودا",14,"د",2,0],["قاصِدُهُم يَبتَغي نَوالَهم","ظَمآنَ حَيثُ السُّرى إِلى آلِ",15,"ل",1,0],["قاصِداً لي فخلِّصوا","مدنفاً مِن يَدَي دَنِف",16,"ف",1,0],["قاصد الله لا يخيب خير من أكرم النزيل","واختم العمر سيدي",17,"ي",1,0],["قاصر الباع مقصوص الجناحين مكسور","رب قل احتيالي ضاع عمري وأنا أدور",18,"ر",1,0],["قاصِي العُلى أمَمٌ على عَزَماتِهِ","فالميلُ فِتْرٌ والنَّحيزَةُ إِصبَعُ",19,"ع",1,0]]}