rses":[["قاصِدٌ وَجهُها تَزورُ بَني الحا","رِثِ أَهلَ الغِناءِ عِندَ الشُروبِ",0,"ب",1,0],["قاصى المباءة والقريب توافداً","لحفاوةٍ فيها بأكرم زائر",1,"ر",1,0],["قاصرة عن طرفِ يداه","مشروطة برجلِهِ أذناه",2,"ه",1,0],["قاصي المَحَلِّ طَباهُ عَن عَشيرَتِهِ","جُرءٌ وَبَينونَةُ الجَرداءِ أَو كَرَعُ",3,"ع",1,0],["قاصِداتٍ مُهَذَّباً لَم يُشَقِّق","في مَعالي فَعالِهِ التَهذيبُ",4,"ب",1,0],["قاصِداً لِلبِحارِ إِذ لَيسَ لِلمُد","نِ دِفاعٌ عَنهُ وَلا لِلقِلاعِ",5,"ع",1,0],["قاصِدٌ سَيرُها تَزورُ بَني العَب","بابِ أَهلَ النَدى وَأَهلَ الفِضالِ",6,"ل",1,0],["قاصِداتٍ كُلَّ شَرقٍ وَغَربٍ","ناطِقاتٍ بِالصَهيلِ فِصاحا",7,"ح",2,0],["قَاصِدٌ فِي سَبِيِلهِ","ما تَعَدَّى وَلاَ انْحَرَفْ",8,"ف",1,0],["قَاصِي الْمَحَلِّ طَبَاهُ عَنْ عَشِيرَتِهِ","جُزْءٌ وَبَيْنُونَة ُ الْجَرْدَاءِ أوْ كَرَعُ",9,"ع",1,0],["قاصداً كشف سترنا","بين خل وأجنبي",10,"ب",2,0],["قاصداً كشف سترنا","خصمه اللَه والنبي",11,"ب",2,0],["قاصرٌ عن بلوغِ فضلكَ مدح","هوَ في كلّ فاضلٍ إطراءُ",12,"ا",2,0],["قاصِراتٌ ناعِماتٌ","في نَعيمٍ وَسُرورِ",13,"ر",1,0],["قاصِدي ماجدٍ إذا قصَدوه","بَلَغوا من نَواله المَقْصودا",14,"د",2,0],["قاصِدُهُم يَبتَغي نَوالَهم","ظَمآنَ حَيثُ السُّرى إِلى آلِ",15,"ل",1,0],["قاصِداً لي فخلِّصوا","مدنفاً مِن يَدَي دَنِف",16,"ف",1,0],["قاصد الله لا يخيب خير من أكرم النزيل","واختم العمر سيدي",17,"ي",1,0],["قاصر الباع مقصوص الجناحين مكسور","رب قل احتيالي ضاع عمري وأنا أدور",18,"ر",1,0],["قاصِي العُلى أمَمٌ على عَزَماتِهِ","فالميلُ فِتْرٌ والنَّحيزَةُ إِصبَعُ",19,"ع",1,0],["قاصِمَةَ الظَهرِ لِلفِرِنجِ غَدَت","وَقعَةَ قَرنى حِطينَ مُذ ظَهَروا",20,"ر",3,0],["قاصر عَن عُلاك مدحي وإنّي","أحسبُ المدح فيك نزراً قليلا",21,"ل",2,0],["قاصماً بالحسام ظَهر عَدوٍّ","كانَ في مَوقف النِزال قَويا",22,"ي",2,0],["قاصداً وجهَ فلاحٍ هادياً","مِن قَريضي كلَّ مدحٍ مطّرف",23,"ف",1,0],["قاصداً نحوَ النبيِّ المُصطفى","خير مأمولٍ وَأزكى مُقتصَد",24,"د",1,0],["قاصداً بالمدحِ والحمدِ أبا ال","عربِ الندبِ ابن سلطان الملك",25,"ك",1,0],["قاِصدًا مِنْ حِمَى معد جنابا","حُفِّ بالرُّشْدِ والمَسَاعِد رَحْبا",26,"ب",2,0],["قاصِراتٍ للطِرقِ يبرُزنَ في الري","ط خِدالٍ ثواقبِ الأحسابِ",27,"ب",1,0],["قاصدٍ رمشٍ بشلاته خطيرٍ مخطرا","وانْ نِظَرْ بالعَيْن يَا عيني عَلَي قَلْبي خطير",28,"ر",1,0],["قاصراتُ الطرفِ الغضيضِ هَواهن","نَ ذكيٌّ يذوبُ منه الضميرُ",29,"ر",1,0],["قاصِدينَ الحِجازَ لِلحَجِ راحُوا","لَهُمُ الذِكرُ وَالقُرآنُ شِعارُ",30,"ر",1,0],["قاصدوه يستصغرون سواه","من رأى الطود يستقل الربوه",31,"و",2,0],["قاصدات وطن الشيخ الشهيد","فارس الهيجا وحاميها عمر",32,"ر",1,0],["قاصِداً رَوضة بِها النور يَعلو","وَمَحلاً عَلى السَموات فاقا",33,"ق",2,0],["قاصِداً أَطهر البِقاع اللَواتي","لَيسَ منها في النجم غير فصولِ",34,"ل",1,0],["قاصِداً كعْبَةَ المكارِمِ منهُ","جاعِلاً حجَّهُ لها واعْتِمارَهْ",35,"ر",2,0],["قاصداً مرقد قدس في العلى","طاولت قبته السبع القبابا",36,"ب",2,0],["قاصرة على الطريق طرفها","مستورة ولا يشم عرفها",37,"ه",2,0],["قاصفاً والجيش بالجيش النصق","ولدى عجهم عج العباب",38,"ب",1,0],["قاص عن الفرسان غير دان","يأتي بألفاظ بلا معان",39,"ن",1,0],["قاصر عنه ما يدبج سحبا","ن وقس وهذّب الشعراء",40,"ا",2,0],["قاصره الفحوى اذا استنطقتها","وغيرها أسمن ضرعا وأدر",41,"ر",1,0],["قاصيَ الآمالِ داني المَصْرَعِ","يَحْفَظُ الوُدَّ فلمْ يُخْفِرْ ذِماما",42,"م",2,0],["قاصمى الظهر ببطن حائر","بها قوام ابن الإمام انقصما",43,"م",2,0],["قاصداً تربةً لمثوى علاه","خطَّها الله منذ خلق التراب",44,"ب",1,0],["قاصدةً حصنَ الذي كم له","في قلبِ من والاه خيرُ الأثر",45,"ر",1,0],["قاص ٍ من الحي ِّ يطوي دربَه ُ الوجل ُ","أشاح َ بالطرف ِ أن َّ السَّعْد َ يُبْتَذَل",46,"ل",1,1],["قاصدا ضره ونفع أخيه","هكذا يفعل الكريم الكريم",47,"م",1,0],["قاصد لزيمي شاعر ٍ شابه الياه","ولاّ الثريا اللي زهى مسحابها",48,"ب",3,0],["ق أصبح الطائيُّ في جلَّقٍ","بدبُرِهِ أَكرَمَ من حاتَم",49,"م",1,1],["قاصرات الطرف حور","مالكات في القصور",50,"ر",1,1],["قاصر الفحوى أذا استنطقها","وغيرها اسمن ضرعا وأدر",51,"ر",1,0],["قاصراتُ الطَّرف في سحرٍلهُن","من نساءٍ ليَّناتِ الكَلِم",52,"م",1,0]]}