://poetry.dctabudhabi.ae/diwan/poem/109962","البسيط"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46035","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117931","المديد"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130436","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59474","الطويل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77126","الوافر"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119391","الرجز"],[4134,"","https://poetry.dctabudhabi.ae/diwan/poem/100557","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90995","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81927","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58162","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33701","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141676","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141679","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120556","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52125","الكامل"],[4764,"حكم الظروف","https://www.poetsgate.com/ViewPoem.aspx?id=34795",""],[4767,"استهداف","https://www.poetsgate.com/ViewPoem.aspx?id=188078",""],[1536,"أَلا قُلْ لَخِيْرِ النَّاسِ نَفْساً وَوَالِداً","https://www.poetsgate.com/ViewPoem.aspx?id=85706",""],[4119,"أنتم كالشمس لولا خدرها","https://www.poetsgate.com/ViewPoem.aspx?id=16224",""],[5136,"ما للعيون لحسنه يتخطف","https://www.poetsgate.com/ViewPoem.aspx?id=121630",""],[5145,"أرأيت من حملوه للتدفين","https://www.poetsgate.com/ViewPoem.aspx?id=108068",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[5314,"رسول الله وانبثقت حياة","https://www.poetsgate.com/ViewPoem.aspx?id=214860",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5376,"تكالبتْ أممٌ والمجْدُ في حَلَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=188444",""],[5790,"بأبي وبي طيفٌ طرق","https://www.poetsgate.com/ViewPoem.aspx?id=111872",""],[6244,"ربيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=509&r=&rc=2",""]],"verses":[["أَو لَو طَغى غَربُ الفُراتِ لَرَدَّهُ","مُتَقَطِّعاً وَأَقامَ مَدَّ النيلِ",0,"ل",1,0],["أولو عَدلٍ يَموتُ اللَيثُ مِنهُ","طَوىً وَبِجَنبِ مَأواهُ الكِناسُ",1,"س",1,0],["أو لوْ علوتَ عُلُوَّ قَرْ","نك كنت شيخاً ماجدا",2,"د",2,0],["أولوا وليكُم حديثاً مثله","يصل القديم وتُسْتَتمُّ به اليدُ",3,"د",1,0],["أَو لَوعَةٍ مَنتوجَةٍ مِن فُرقَةٍ","حَقُّ الدُموعِ عَلَيَّ فيها واجِبُ",4,"ب",1,0],["أَوَّلُوا وَجْدِي بِهِ عَبَثاً","لَيْتَهُمْ قَالُوا بِمَا عَلِمُوا",5,"م",3,0],["أولو الفضل والآدابِ والعلمِ والحجا","لديْهِ إذا جدَّ الجدالِ سُكوتُ",6,"ت",1,0],["أُولُو السُّلطانِ والخَطَرِ","على التِّيجان والسرُرِ",7,"ر",1,0],["أولو بَصَرٍ بِأَبوابِ المَخازي","وَعُميُ الرَأيِ عَن سُبُلِ العفافِ",8,"ف",1,0],["أو لو رأهُ عائِداً أيّوبُ في","سِنَةِ الكَرَى قدماً من البلوى شُفي",9,"ف",2,0],["أولو الاله الكرماء عهدا","النازلو البيت العتيق مهدا",10,"د",2,0],["أوْ لَوْ وَصَلْنَ سَوَادَها","بِسَوَادِ حَبَّاتِ النَواظِرْ",11,"ر",1,0],["أولو وليكُم حديثاً مثله","يصل القديم وتُسْتَتمُّ به اليدُ",12,"د",1,0],["أولوا السلطان والخطر","على التيجان والسرر",13,"ر",1,0],["اولوا الهندوانيات ان ما ذكرتهم","ذكرت الاسود الطاهرين الا طايبا",14,"ب",2,0],["أولو التفقه ليس يبرح عندهم","لأولي التصوف أعظم الشنئان",15,"ن",1,0],["أَو لَو تَحَلّى بِالشَبابِ عُمرَهُ","لَم يَستَلِبهُ الشَيبُ هاتيكَ الحُلى",16,"ا",1,0],["او لو يكررها الفتى ابن نباتة","يوما لقال نعم انا ابن نباتها",17,"ت",3,0],["آو لو يعرف من يظلمني","أنني بالشعر إن شئت ظلمت",18,"ت",1,0],["أُولُو السَعادة لم يضْرِم هِياجَهُم","أولُو الشَقاوة إلا وهيَ تَفْثَؤُهُ",19,"ا",2,0],["أوْلوا الجَزيرَةَ نُصْرَةً إن العدى","تَبْغِي على أقطارها اسْتيلاءَها",20,"ا",3,0],["أو لؤلؤ رطب تشظّى حولَه","صدفٌ أنافَ عَلَى بياضِ المُهْرَقِ",21,"ق",1,0],["أَوَّلُ وَجدي مالَهُ آخِرُ","وَباطِني بَينَ الوَرى ظاهِرُ",22,"ر",1,1],["أَو لَو رَأَى اليَوم العَبوس بَشاشَةً","من وَجهِهِ لَكَ بالسُرور تَبَسَّما",23,"م",2,0],["أوُلوعٌ وغُربَةٌ وَسقَامٌ","إِنَّ مِثلِي لَفِي عَذابٍ شَدِيدِ",24,"د",1,1],["أَو لورعوا نَفا لَم يَرع غَيرهم","أَحبهم وَأَضاعوا حبه هملا",25,"ل",2,0],["أَو لَو نَظَرت إِلى الجَما","د لَجادَ بِالعَذب النَمير",26,"ر",1,0],["أول وقد كنت العزيز وكيف لا","يذلّ فتى قاضيه في الحب ظاله",27,"ه",1,0],["أولوا همم بها وصلوا ونالوا","أولوا كرم به قوي الضعيف",28,"ف",1,0],["أولو صيت كهمهم بعيد","ورأي مثل سؤددهم أصيل",29,"ل",1,0],["أولو العزة القعساء والهمم العلى","ذوو النسب الوضاح والأنف الشم",30,"م",1,0],["أو لو دَعا إبليسَ آدمُ باِسْمهِ","عندَ السُجودِ لديه لم يستكْبِرِ",31,"ر",1,0],["أو لو أُريقَتْ فوقَ يَذبُلَ جرعةٌ","منها لأصبحَ معدِنَ الراهونِ",32,"ن",1,0],["أولوه نزراً فأولاهم مجازفة","ما في الحقائب ما يبقى على الخطب",33,"ب",1,0],["أَوَ لؤلؤٌ سَلسٌ في عِقدِ جاريَةٍ","وَرهاءَ نازَعَها الوِلدانُ فاِنتَثَرا",34,"ر",2,0],["أول وهو آخر لحجى","ظاهر وهو باطن لعمي",35,"م",2,0],["أو لو رأى النمرد نور جماله","عبد الجليل مع الخليل ولا عند",36,"د",1,0],["أَوْ لَوْ سَقَتْنِي السُّمَّ أَشْرَبُهُ","مِنْ كَفِّهَا لَحَسِبْتُهُ عَسَلاَ",37,"ل",2,0],["أولو وفاء بعهد الحب حيث مضت","فيه العقود وحبل الود مبروم",38,"م",1,0],["أو لوذعيّ كان قطب زمانه","لجأت إليه الناس لاستفتاء",39,"ا",2,0],["أو لو حذوا في صلاح حذوه لغدوا","بين البرية أبرارا وأطهارا",40,"ر",2,0],["أَو لَو وَجَدَت بِمِثلِ فَضلِكَ عاذِلاً","كانَ الكَمالُ إِذا سَلَوتُكَ عاذِري",41,"ر",2,0],["أَو لَو دَرَت نارُ إِبراهيمُ مَصرَعَهُ","لِأَصبَحَت مِن جَوى لَفاحَةِ الشَرَر",42,"ر",1,0],["أو لَوْ أشارتْ نَحوَهُ بِبَنانِها","لأَتى إليْها جَيْئَةَ المَفْتُونِ",43,"ن",1,0],["أو لو رأى شعره الطائي لهز له","أعطافه وغدا عبداً بلا ثمن",44,"ن",1,0],["أَوْ لَوْ بَدَا للرُّوْمِ مَعْجَزُ صُنْعِهِ","أَبْدَى السُّجُوْدَ إليه قُسْطَنْطِيْنُ",45,"ن",1,0],["اولو الثنايا البرود سلسلها","والمقل المنتمى لها النجل",46,"ل",1,0],["أُولو الحسنِ في دينِ الهَوى قَتلُ صَبِّهم","لَهُم جازَ فيهِ حِلّه وَحَرامُهُ",47,"م",2,0],["أَولُوا بِظَنةٍ فِي بَاطِلٍ وتَكَذُّبٍ","وَصِدْقُهُمُ يَأْوِي إلَى أَبْطُنٍ خُمْص",48,"ص",1,0],["أولو اني من اللصوص لما جئ","ت بكايتي إلى العرافِ",49,"ف",1,0],["أول واجب على الاطلاق","معرفى الله القديم الباقي",50,"ي",1,1],["أو لو يؤاخذني بها","ربي لدمت أعذب",51,"ب",1,0],["أولوه تبريكاً بأبهى موسمٍ","أبداً عليه بالسرور يعودُ",52,"د",1,0],["أو لو الإنشاء والكتاب جمعاً","وأصحاب المناقشة والادقا",53,"ق",2,0],["أولو الرقم والانشاد من يدعي الحجى","كذا جهابذة الآوان والسلفِ",54,"ف",1,0],["أولو الأقلام تشهد أنه قد","يفوق على المجدّد والقديمِ",55,"م",1,0],["أو لو يكون بعهد الأصمعيّ نشا","ما كان عن ذكر غبراء أتى خبرُ",56,"ر",1,0],["أولوا العلم والأشياخُ بيعك جائزٌ","بكلهم لما انتفى أنكم جنس",57,"س",1,0],["أو لو العوز في الليل بالرّجل والخيل","يدفعن كالسّيل في بطن وادِ",58,"د",1,0],["أَو لَو تُباع حَباكَ الأَولِياءُ بِها","وَرَدّها كُلّ من أَضحى يُناديكا",59,"ك",2,0],["أو لو رأى نفثات الحب كيف غدت","كبرى لآمن بعد الكفر ساحره",60,"ر",2,0],["أولو قضوا حقَّ الوداع فأعلنوا","يوماً قضَوا فيه الرحيلَ وأزمعوا",61,"ع",3,0],["أَو لَو أُعيروا مُقلَتي","وَرَأَوكِ لَاِعتَرَفوا بِمَجدِك",62,"ك",1,0],["أو لوجه الله هذا كله","غير عتقٍ عاش حيا أو نفق",63,"ق",1,0],["أَولوا الحِلمِ إِلّا في الكَريهَةِ إِنَّهُم","إِذا شَهِدوا يَومَ الكَريهَةِ جُهّالُ",64,"ل",1,0],["أو لو رآهُ ناسكٌ سلكَ الرّدى","حذراً عليهِ مخافةً أن يُعبَدا",65,"د",2,0],["أَو لَوْ رآهُ راهبٌ من بيعةٍ","ألقى الصليبَ ولازمَ التَّوحيدا",66,"د",2,0],["أولو الفضل والإفضال لا ظلم عندهم","ولا بغي فاسرد آي سؤددهم سردا",67,"د",2,0],["أولو البَسالة والعليا ضراغِمها","مَعادنُ الحِكم الغرَّا مَظاهرها",68,"ر",3,0],["أَوَلَو أبو بكر أرادَ إِمَامةً","فأبُوه كان إمامَكم من قبْلِه",69,"ل",2,0],["أو لو يقولُ حسامُ الدين ويحك قف","للماء لم يجرِ أوْ للنارِ لم تَقِد",70,"د",1,0],["أو لو أتت كفه في يوم الندى","لم يعتبرها درهما يعطيه",71,"ي",2,0],["أو لو تزوجت الثريا ليله","بالبدر ما حملت له بشبيه",71,"ي",2,0],["أو لو سرى في الليل حادثة يرى","نورا بدا من رأيه يهديه",71,"ي",2,0],["أَوْ لو رأى درهماً فِي كَفِّ خازِنه","مَا قَرَّ فِي كفه من يومه لغد",72,"د",1,0],["أو لو حكى قلبي بحارَ علومها","طرباً لما أخلو من الخفقان",73,"ن",1,0],["أولو العهدِ به تقوّى جأشها","أمناً وقد شِدْتَ عُرى استئناسها",74,"س",3,0],["أو لَوْ رأيتَ جَنابَهم متدفقاً","متوسّعاً لتضايُقِ الرُّوّادِ",75,"د",1,0],["أُولُو وَعَالَمُونَ عِلِّيُّونَا","وَأرَضُونَ شّذَّ والسَِّنُونَا",76,"ن",2,0],["أولوا الجَمعِ المُقَدَّمِ حينَ تابوا","إِلَيكَ وَمَن يُوَزِّعُهُم قَليلُ",77,"ل",1,0],["أولؤ الله يبدي جزعاً","والمحبون يرومون اصطبارا",78,"ر",2,0],["أُولو المَحَبَّةِ قد ذابوا وما جَمَدوا","اذ في حَرارةِ حُبِّ اللَهِ قد سُبِكوا",79,"ك",3,0],["أُولوا الضلالةِ بيعوا من نعيمهمِ","بيعَ السَماجِ ومن حَرِّ الجحيم شُرُوا",80,"ر",3,0],["أَو لَو رَأى يَعقوبُ عَصرِك ما جَرى","لَبَكى دَماً تَحتَ التُّرابِ مُعَربدا",81,"د",2,0],["أولوا نص الدليل بما","جاء في فتيا مدلسهم",82,"م",1,0],["أو لو شفاه بزورة بعد النوى","ليرى الذي فعل البعاد بعبده",83,"د",2,0],["أولو كلِّ معروفٍ ومُلكٍ معظَّم","وتختٍ يَمانّيٍ وتاجٍ مرصّعِ",84,"ع",1,0],["أوَّلُ وَاجِبٍ عَلَى المُكَلَّفِ","إِعمَالهُ لِلنَّظَرِ المؤَلَّفِ",85,"ف",1,0],["أولو هِمَم نَوازِع لِلتَّسامي","عَلى زحل يَلوحُ لَها عَلاء",86,"ا",2,0],["أو لؤلؤ حلى أعلا","ه بماء الذهب",87,"ب",1,0],["أو لؤلؤاً نثروه سجنجل","أو قطر أمطار على خضراء",88,"ا",2,0],["أو لو رنا يوما لفتاك الوغى","القوا السلاح وانصفوا اسراه",89,"ا",2,0],["أو لوِنوا الوجنات واكتحلوا","إنَّ السهاد لمقلتي كحل",90,"ل",1,0],["أولُو العزم والحزمِ الدين تواثبوا","مواقعَ سلطانٍ عَلاَ وتسلْطَنَا",91,"ن",2,0],["أو لو رَثيتَ سألتَهُ","عَمَّا بهِ فَعلمتَهُ",92,"ت",2,0],["أولوا جشَع من دونه جشع الورى","وصيتهم في ذاك كالدهر قدموس",93,"س",1,0],["أو لو تداوى الناس منه بالبكا","لشفيتُ كلّ شجٍ يبيت عليلا",94,"ل",2,0],["او لو تهادى الورى بالعمر عن مقة","لكان يهديه جيل بعده جيل",95,"ل",1,0],["أو لو وَفَت شمس السًّنا بحقوقها","طَلَعت ولم تبغِ الزمانَ نزوحا",96,"ح",2,0],["أو لو رأى قَمرُ السماءِ سرورَنا","لبَغَى بأن يزهو لَنا ويلوحا",96,"ح",2,0],["اول وتالي الزمان اوصى له","بحروف شعره لا بغى ينشدني",97,"ن",2,0],["أو لؤلؤٍ قد بان بين لمًى لها","كم للمُعَنَّى فيه من آراب",98,"ب",1,0],["أُولُوا بِطنةٍ فِي بَاطِلٍ وتَكَذُّبٍ","وَصِدْقُهُمُ يَأْوِي إلَى أَبْطُنٍ خُمْص",99,"ص",1,0],["أو لو أن الحب فضل كان لي","ما لشمس الدين من فضل الكرام",100,"م",1,0],["أو لو أعار الليل مطرف وجهه","ما كان ليل من نهار يعرف",101,"ف",1,0],["أولو أردت حفرت في قلبي له","ملحود قبرٍ بالوفاء ضمين",102,"ن",1,0],["أَوْ لَوحَةٌ مِنْ بَدِيعِ الرَّسْمِ لَوَّنهَا","مِنَ المَشَاعِرِ فَيْضٌ قَدْ يُدَانِيهِ",103,"ي",2,0],["أولِو الأَلْبَابِ مَا خَسِرُوهُ لُبَّا","لَهُمْ بِالنُّورِ أَمْشَاجٌ وَقُرْبَى",104,"ب",2,1],["أولو العلم والتقوى وكل محقق","من العلماء من قد تسامت فضائله",105,"ل",2,0],["أوْلوك أمْرهمْ(و) ما كان ذنْبُهم(و)","وحيث أمسيْتَ في أعدائِهم ذَنَبَا",106,"ب",2,0],["أولو مسحت على عمٍ","لرأي وذي خرس نطق",107,"ق",1,0],["أو لو قبلتَ فداءَه فجعلتَهُ","معنى يحيطُ به الجمال إطارا",108,"ر",2,0]]}