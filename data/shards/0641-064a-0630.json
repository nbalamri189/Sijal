ي ذِمَّةِ المُولَى عَزِيزٌ جَاءَهُ","بَرَّ الطَّويَّةِ طَاهِرَ الأَرْدَانِ",6,"ن",1,0],["فِي ذَلِكَ الزَّمَنِ الكَبِيرِ بِمَا جَرَى","فِيهِ هُوَ قَلَّ فِي الأَزْمَانِ",7,"ن",1,0],["فِي ذِمَّةِ الرَّحْمَنِ خَيْرُ مُجَاهِدٍ","لَمْ يَلْتَمِسْ إلاَّ رِضَا الرَّحْمَنِ",8,"ن",1,0],["في ذِمَّةِ المَوْلَى وَفِي رُضْوَانِهِ","أَوْلَى رِجَالِ اللهِ بِالرُّضْوَانِ",9,"ن",1,0],["فَيَذُوبَ كُلٌّ مِنْهُمَا فِي صِنْوِهِ","وَكَذَاكَ يَحْيَا بِالْهَوَى الصِّنْوَانِ",10,"ن",1,0],["فِي ذِمَّةِ اللهِ يَا فَريقاً","عَاشُوا كِرَاماً وَمَاتُوا كِرَامَا",11,"م",2,0],["فِي ذِمَّةِ اللهِ كَمَالُ التُّقَى","وَعِفَّة النَّفْسِ وَرَعْيِ الذِّمَامْ",12,"م",1,0],["فِي ذِمَّةِ اللهِ الصَّدِيقُ الَّذِي","أَصْفَيْتُهُ وُدِّي وَلَمْ أَنْدَمِ",13,"م",1,0],["فِي ذَرَاكَ العَالِي مَلائِكُ بِرٍّ","فَرَحُ العِيدِ عَاقَهَا أَنْ تَنَامَا",14,"م",2,0],["فِي ذَلِكَ الهَفْهَافِ","أَوْهَى مِنْ نُسَيْمَاتِ الشَّمَالِ",15,"ل",1,0],["في ذمَّةِ الله قلبي ما أعلُلُهُ","بالقرب إلا وعادَ القربُ مُنْتَزَحا",16,"ح",2,0],["في ذروة من يفاع المجد أولهم","زانت عواليها قواعدُها",17,"ه",2,1],["في ذب رأيك عنه للملوك هدى","كأنَّما هو للآراء إكسير",18,"ر",1,0],["في ذا وذا وصفي ومدحي فما","للغير في شعريَ مستمتع",19,"ع",1,0],["في ذمَّة الله قلبٌ يوم بينكمُ","موزع ودم في الحبِّ مطلول",20,"ل",1,0],["فِي ذِمَّةِ اللَهِ مِن أَصبَحَت مَنزلَهُ","وَجادَ غَيثٌ عَلى مَغناكَ يُمرِعُهُ",21,"ع",2,0],["في ذُرا قِبّةٍ غدتْ لبني حم","مادٍ الأكرمين مُرداً وشيبا",22,"ب",2,0],["فيذكُرني فترجيني","كأوَّل وَهْلةِ الطَّلبِ",23,"ب",1,0],["في ذا وذاك كليهما","خيرٌ وشرٌّ مستطيرُ",24,"ر",1,0],["في ذَراهُ يُستبدَلُ العِزُّ والثَّرْ","وة من ذِلةٍ ومن إعدام",25,"م",1,0],["في ذُبَّلٍ كَقِداحِ النَبعِ يَعذِمُها","حَتّى تُنوسِيَتِ الأَضغانُ وَاللَدَدُ",26,"د",1,0],["في ذَلِكَ الرَوضِ الأَغَنِّ بَدى فَتىً","قَد يَبلُغُ العِشرينَ عاماً ذو نُهى",27,"ا",1,1],["فيذوبُ في حَدَقِ المَهَا","سِحرًا لطيفًا ليّنا",28,"ن",2,0],["في ذِمَّةِ الغَربِ مُشتاقٌ يُنازِعُهُ","شَوقٌ إِلى مَهبِطِ الآياتِ وَالحِكَمِ",29,"م",1,0],["في ذلكَ الأُفُقِ الجَميلِ","وذلكَ النَّسَمِ الرُّخا",30,"خ",2,0],["في ذِلَّةِ الوادي","وفي كِبْرِ الجبال الشَّاهقهْ",31,"ه",1,0],["في ذي الجفون مصارع الأكباد","الله في جنب بغير عماد",32,"د",1,1],["في ذمة الوطن الكريم عصابة","لم ينس في جد الجهاد بلاءها",33,"ا",3,0],["في ذمة الشبان ما استودعتهم","من خاطر وقريحة وفؤاد",34,"د",1,0],["في ذي الجفون صوارم الأقدار","راعِى البريةَ يا رعاك الباري",35,"ر",2,1],["في ذِمَّةِ اللَهِ الكَريمِ وَبِرِّهِ","ما ضَمَّ مِن عُرفٍ وَمِن إِحسانِ",36,"ن",1,0],["في ذِمَّةِ اللَهِ الكَريمِ وَحِفظِهِ","جَسَدٌ بِبُرقَةَ وُسِّدَ الصَحراءَ",37,"ا",2,0],["في ذِمَّةِ الفُضلى هُدى","جيلٌ إِلى هادٍ فَقير",38,"ر",1,0],["في ذِمَّةِ اللَهِ أَوفى ذِمَّةٍ نَفَرٌ","عَلى طَرابُلُسٍ يَقضونَ شُجعانا",39,"ن",2,0],["في ذِمَّةِ التاريخِ خَمسَةُ أَشهُرٍ","طالَت عَلَيكِ فَكُلُّ يَومٍ عامُ",40,"م",1,0],["فَيُذكِرُني العَهدَ القَديمَ وَلَيلَةً","لَدى سَمُراتِ الجِزعِ إِذ نامَ سامِرُه",41,"ر",2,0],["فيذهَبُ منها في سَريعٍ ذَهابُها","ويَرجعُ منها في بَطئِ رُجوعُها",42,"ع",3,0],["في ذمة الأجيالِ ما غنَّت به","قيثارةٌ سحريةُ الأوتارِ",43,"ر",1,0],["في ذمة الله ما أضعتم","من مهجٍ أصبحت هباء",44,"ا",2,0],["في ذمة الشيطان فلسفتي","ورزانتي ووقار تفكيري",45,"ي",1,0],["في ذراعيَّ أو ذراعيك أمن وسلام ورحمة ونجاء","وعلى صدرك المعذب أو صدريَ حصن وعصمة واحتماء",46,"ا",2,0],["فيذكِّيهمْ ذكاةً","ويُذَكِّينا ذكاءَ",47,"ا",2,0],["في ذِمَّةِ اللهِ ما ألقَى وما أجِدُ","أهذِهِ صَخرةٌ أمْ هذِه كبِدُ",48,"د",1,1],["في ذاكَ ما قَد قُلتُ إِنّي ماكِثٌ","عَشراً فَقالَت ما بَدا لَكَ فَاِقعُدِ",49,"د",1,0],["في ذِمَّةِ الذّكرِ الحكيمِ رِسَالَتي","وإليكَ رَبِّي مَرْجِعي وَمَعادي",50,"د",2,0],["في ذِمَّةِ التُّركِ دُنيا لا تَضيقُ بها","سُيوفُهم وزَمانٌ غيرُ مَعْسورِ",51,"ر",1,0],["في ذِمَّةِ اللهِ مُنىً موديَهْ","باسقةٌ خضراءُ لُدْنٌ رطابْ",52,"ب",1,0],["في ذكر أمك للزناة دلالةٌ","فأحب من ذكر ابنها من يشتم",53,"م",1,0],["فِي ذِمَّةِ اللهِ العَلِي مُفَارِقٌ","هُوَ خَالِدّ بِالذّكْرِ غَيْرُ مُفَارِقِ",54,"ق",1,0],["فِي ذِكْرِهِ مُتَبَاهِياً آثَارَهَا","وَمَآثِرَ الأَجْدَادِ وَالآباءِ",55,"ا",2,0],["فِي ذِمَّةِ اللهِ خَيْرِ مُعْتَزِمٍ","لِخَيْرِ مَا يَبْتَغِيهِ مُعْتَزِمُ",56,"م",1,0],["فَي ذُرَا مِصْرٍ وَفِي كُلِّ حِمَى","عَرَبِيٍّ حَرَبٌ أَيُّ حَرَبْ",57,"ب",1,0],["فِي ذلِكَ المِيقَاتِ أَقْبَلَ يَافِعٌ","بِوِسَامِ كَشَّافٍ وَبِزَّةِ طَالبِ",58,"ب",1,0],["فِي ذِمَّةِ المَوْلَى شِهَابٌ عَاثِرٌ","تَبْكِيهِ أُمَّتُهُ بِقَلْبٍ ذَائِبِ",58,"ب",1,0],["في ذلك الصمت الرهيب","وذلك الليلِ الجهام",59,"م",1,0],["في ذمة الفن المقدسّ عازف","لقي الحِمام على صدى ألحانه",60,"ن",2,0],["في ذمة الرحمن حُو","رٌ قاصراتُ الطرف عِين!",61,"ن",1,0],["في ذمة الله أحباب لنا ارتحلوا","دانوا محبهم مثل الذي دانا",62,"ن",2,0],["في ذلك اللّيل المخيف مضى فتى","قلق الثياب مروّع الخطوات",63,"ت",1,0],["فى ذلك الحين والفتيان سادرة","فى الغى لم يثنهم لوم ولا عتب",64,"ب",1,0],["في ذمة الوطن المفدّى أن تُرى","مُتغِّرباً وعن المواطن نازحا",65,"ح",2,0],["في ذمةِ اللهِ ما لاقيتَ من نَفَرٍ","من الأجانب عُبّادٍ لأهواء",66,"ا",2,0],["في ذمَّةِ الشِّعْرِ ما ألقى وأعظَمُهُ","أنّي أُغنّي لِأصْنامٍ وأحجار",67,"ر",1,0],["في ذمة الله حزنُ الشعب حينَ رأى","وديعةَ الله عند الشعب تُستَلم",68,"م",1,0],["في ذمة التاريخِ ما جُرِّعتُمُ","من غُصَّةٍ ، في ذمة الأجيال",69,"ل",1,0],["في ذمّة الفتيان رابة مجده","إنّ الشباب وفيّة ذمّاته",70,"ت",2,0],["في ذمّة الذكرى بقايا ليلة","عريانة مجنونة الآراب ...",71,"ب",1,0],["في ذُرا قِبة ٍ غدتْ لبني حم","ادٍ الأكرمين مُرداً وشيبا",72,"ب",2,0],["في ذمة الله الاويقات التي","مرت بروض الغوطة البسام",73,"م",1,0],["فيذودني شوك شرعت","شباته دون الخدود",74,"د",1,0],["في ذكر من تهوى وفي آثاره","أنسٌ ومن عَدِمَ المثال تمثلا",75,"ل",2,0],["في ذمة الله وفي حفظه","سرْ سالماً بل غانما آمنا",76,"ن",2,0],["في ذمة الله محروسا مدى الأبد","أنىّ ترحلت أو خيمت في بلد",77,"د",1,1],["فَيَذهَبُ قَومٌ كَاليَعاليلِ لا يُرى","لَها أَثَرٌ وَالماءُ تغطي جَداوِلُه",78,"ل",2,0],["في ذمةِ اللَهِ الكَريمِ كَريمةٌ","قَد كانَ في ثَوبِ العَفافِ مَسيرُها",79,"ر",3,0],["في ذمَّةِ اللَهِ مَن عِندي لَهُ ذِممٌ","في الحُبِّ لَيسَ يَفيها مَدمَعٌ هَطلا",80,"ل",2,0],["في ذمة اللَه ما ضينا وحاضرنا","بؤس ويأس ألا سحقا لمن خانا",81,"ن",2,0],["في ذمَّةِ الأقدارِ ما","شيَّعتُ في ذا