{"poems":[[53,"ما لذا الداني إلى القلب شحط","https://www.aldiwan.net/poem30161.html","الرمل"],[77,"هات الحديث عن الركب الذي بانا","https://www.aldiwan.net/poem36075.html","البسيط"],[86,"أهلا بأول مسلم","https://www.aldiwan.net/poem10681.html","مجزوء الكامل"],[93,"لم يفقدوا أما وقد فقدوك","https://www.aldiwan.net/poem9851.html","الكامل"],[93,"اسمع شكاتي فهي إن لم تفد","https://www.aldiwan.net/poem11090.html","السريع"],[93,"في ذمة الله وفي عهده","https://www.aldiwan.net/poem11143.html","السريع"],[93,"تمضي وذكرك ملء كل جنان","https://www.aldiwan.net/poem11244.html","الكامل"],[93,"تمضي وأنت مضنة الأوطان","https://www.aldiwan.net/poem11245.html","الكامل"],[93,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[93,"إن ينتقل أغناطيوس الثاني","https://www.aldiwan.net/poem11262.html","الكامل"],[93,"أرأيت صوغ الدر في العقيان","https://www.aldiwan.net/poem11278.html","الكامل"],[93,"يا غرباء الحمى سلاما","https://www.aldiwan.net/poem11291.html","مخلع البسيط"],[93,"ما كان ريب قبل ريب الحمام","https://www.aldiwan.net/poem11325.html","السريع"],[93,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[93,"أيها البالغ الثريا مقاماً","https://www.aldiwan.net/poem11412.html","الخفيف"],[93,"يا حبذا أخت الغزال","https://www.aldiwan.net/poem11463.html","مجزوء الكامل"],[83,"هذا الصباح صباح الشيب قد وضحا","https://www.aldiwan.net/poem54333.html","الكامل"],[37,"في ذروة من يفاع المجد أولهم","https://www.aldiwan.net/poem6897.html","البسيط"],[72,"بشراك إن السرى والعود مبرور","https://www.aldiwan.net/poem18707.html","البسيط"],[72,"تسلسلت في خدي الأدمع","https://www.aldiwan.net/poem19173.html","السريع"],[72,"ما الطرف بعدكم بالنوم مكحول","https://www.aldiwan.net/poem19466.html","البسيط"],[60,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[51,"تذكر بي فترجيني","https://www.aldiwan.net/poem8524.html","مجزوء الوافر"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[29,"حلت صبيرة أمواه العداد وقد","https://www.aldiwan.net/poem6069.html","البسيط"],[91,"في ذلك الروض الأغن بدى فتى","https://www.aldiwan.net/poem8735.html","عموديه"],[91,"أشقى البرية نفسا صاحب الهمم","https://www.aldiwan.net/poem62723.html","عموديه"],[92,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[85,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[85,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[85,"أكذا تقر البيض في الأغماد","https://www.aldiwan.net/poem7131.html","الكامل"],[85,"في ذي الجفون صوارم الأقدار","https://www.aldiwan.net/poem7894.html","الكامل"],[85,"المشرقان عليك ينتحبان","https://www.aldiwan.net/poem8188.html","الكامل"],[85,"ركزوا رفاتك في الرمال لواء","https://www.aldiwan.net/poem62931.html","الكامل"],[85,"قل للرجال طغى الأسير","https://www.aldiwan.net/poem62967.html","مجزوء الكامل"],[85,"يا قوم عثمان والدنيا مداولة","https://www.aldiwan.net/poem63738.html","البسيط"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[45,"له الويل من ليل تطاول آخره","https://www.aldiwan.net/poem63564.html","الطويل"],[61,"أتكتم أسرار الهوى أم تذيعها","https://www.aldiwan.net/poem51571.html","الطويل"],[97,"شَجنٌ على شَجنٍ وحرقةُ نارِ","https://www.aldiwan.net/poem24753.html","الكامل"],[97,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[97,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[97,"السراب الخؤون والصحراء","https://www.aldiwan.net/poem24994.html","الخفيف"],[69,"فستق ساء الأعادي","https://www.aldiwan.net/poem29119.html","مجزوء الرمل"],[90,"في ذمة الله ما ألقى وما أجد","https://www.aldiwan.net/poem47616.html","الكامل"],[31,"نام الخلي وبت غير موسد أ","https://www.aldiwan.net/poem42571.html","الكامل"],[105,"أمنارة الساري وأمن الوادي","https://www.aldiwan.net/poem42087.html","الكامل"],[105,"ناد القبور وبشر كل مقبور","https://www.aldiwan.net/poem43053.html","البسيط"],[102,"افدي بروحي غيد اشبيليه","https://www.aldiwan.net/poem33027.html","السريع"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140932",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55063","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55333","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54629","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141961","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[77,"هات الحديث عن الركب الذي بانا","https://www.poetsgate.com/ViewPoem.aspx?id=34164",""],[103,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[90,"في الطيارة أو على أبواب المفاوضات","https://www.poetsgate.com/ViewPoem.aspx?id=179078",""],[90,"من لندن الى بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179081",""],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[90,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[90,"تأبين الغراف الميت","https://www.poetsgate.com/ViewPoem.aspx?id=179098",""],[51,"أحمدُ اللَّه مُبدِئاً ومُعيد","https://www.poetsgate.com/ViewPoem.aspx?id=27043",""]],"verses":[["في ذُنابى مَعشَرٍ جيرانُهُم","مُضَغٌ لِلخَطبِ يَغدو أَو لُقَط",0,"ط",1,0],["فِي ذِمَّةِ اللَّهِ أَحْبَابٌ لَنَا رَحَلُوا","دَانُوا مُحِبَّهُمُ مِثْلَ الَّذِي دَانَا",1,"ن",2,0],["في ذِمَّةِ الآفاقِ سِر","وَاِرجِع إِلى تِلكَ الدِيار",2,"ر",1,0],["في ذمة اللَه أغنمى نعماءه","أجرا فما غير الخلود يفيك",3,"ك",1,0],["في ذاك العهد وقد صرت في","أترابك الأمكن والأرجلا",4,"ل",2,0],["فِي ذِمَّةِ اللهِ وَفِي عَهْدِهِ","شَبَابُهُ النَّاضِرُ فِي لَحْدِهِ",5,"د",2,1],["فِي ذِمَّةِ المُولَى عَزِيزٌ جَاءَهُ","بَرَّ الطَّويَّةِ طَاهِرَ الأَرْدَانِ",6,"ن",1,0],["فِي ذَلِكَ الزَّمَنِ الكَبِيرِ بِمَا جَرَى","فِيهِ هُوَ قَلَّ فِي الأَزْمَانِ",7,"ن",1,0],["فِي ذِمَّةِ الرَّحْمَنِ خَيْرُ مُجَاهِدٍ","لَمْ يَلْتَمِسْ إلاَّ رِضَا الرَّحْمَنِ",8,"ن",1,0],["في ذِمَّةِ المَوْلَى وَفِي رُضْوَانِهِ","أَوْلَى رِجَالِ اللهِ بِالرُّضْوَانِ",9,"ن",1,0],["فَيَذُوبَ كُلٌّ مِنْهُمَا فِي صِنْوِهِ","وَكَذَاكَ يَحْيَا بِالْهَوَى الصِّنْوَانِ",10,"ن",1,0],["فِي ذِمَّةِ اللهِ يَا فَريقاً","عَاشُوا كِرَاماً وَمَاتُوا كِرَامَا",11,"م",2,0],["فِي ذِمَّةِ اللهِ كَمَالُ التُّقَى","وَعِفَّة النَّفْسِ وَرَعْيِ الذِّمَامْ",12,"م",1,0],["فِي ذِمَّةِ اللهِ الصَّدِيقُ الَّذِي","أَصْفَيْتُهُ وُدِّي وَلَمْ أَنْدَمِ",13,"م",1,0],["فِي ذَرَاكَ العَالِي مَلائِكُ بِرٍّ","فَرَحُ العِيدِ عَاقَهَا أَنْ تَنَامَا",14,"م",2,0],["فِي ذَلِكَ الهَفْهَافِ","أَوْهَى مِنْ نُسَيْمَاتِ الشَّمَالِ",15,"ل",1,0],["في ذمَّةِ الله قلبي ما أعلُلُهُ","بالقرب إلا وعادَ القربُ مُنْتَزَحا",16,"ح",2,0],["في ذروة من يفاع المجد أولهم","زانت عواليها قواعدُها",17,"ه",2,1],["في ذب رأيك عنه للملوك هدى","كأنَّما هو للآراء إكسير",18,"ر",1,0],["في ذا وذا وصفي ومدحي فما","للغير في شعريَ مستمتع",19,"ع",1,0],["في ذمَّة الله قلبٌ يوم بينكمُ","موزع ودم في الحبِّ مطلول",20,"ل",1,0],["فِي ذِمَّةِ اللَهِ مِن أَصبَحَت مَنزلَهُ","وَجادَ غَيثٌ عَلى مَغناكَ يُمرِعُهُ",21,"ع",2,0],["في ذُرا قِبّةٍ غدتْ لبني حم","مادٍ الأكرمين مُرداً وشيبا",22,"ب",2,0],["فيذكُرني فترجيني","كأوَّل وَهْلةِ الطَّلبِ",23,"ب",1,0],["في ذا وذاك كليهما","خيرٌ وشرٌّ مستطيرُ",24,"ر",1,0],["في ذَراهُ يُستبدَلُ العِزُّ والثَّرْ","وة من ذِلةٍ ومن إعدام",25,"م",1,0],["في ذُبَّلٍ كَقِداحِ النَبعِ يَعذِمُها","حَتّى تُنوسِيَتِ الأَضغانُ وَاللَدَدُ",26,"د",1,0],["في ذَلِكَ الرَوضِ الأَغَنِّ بَدى فَتىً","قَد يَبلُغُ العِشرينَ عاماً ذو نُهى",27,"ا",1,1],["في ذِمَّةِ الغَربِ مُشتاقٌ يُنازِعُهُ","شَوقٌ إِلى مَهبِطِ الآياتِ وَالحِكَمِ",28,"م",1,0],["في ذلكَ الأُفُقِ الجَميلِ","وذلكَ النَّسَمِ الرُّخا",29,"خ",2,0],["في ذِلَّةِ الوادي","وفي كِبْرِ الجبال الشَّاهقهْ",30,"ه",1,0],["في ذي الجفون مصارع الأكباد","الله في جنب بغير عماد",31,"د",1,1],["في ذمة الوطن الكريم عصابة","لم ينس في جد الجهاد بلاءها",32,"ا",3,0],["في ذمة الشبان ما استودعتهم","من خاطر وقريحة وفؤاد",33,"د",1,0],["في ذي الجفون صوارم الأقدار","راعِى البريةَ يا رعاك الباري",34,"ي",1,1],["في ذِمَّةِ اللَهِ الكَريمِ وَبِرِّهِ","ما ضَمَّ مِن عُرفٍ وَمِن إِحسانِ",35,"ن",1,0],["في ذِمَّةِ اللَهِ الكَريمِ وَحِفظِهِ","جَسَدٌ بِبُرقَةَ وُسِّدَ الصَحراءَ",36,"ا",2,0],["في ذِمَّةِ الفُضلى هُدى","جيلٌ إِلى هادٍ فَقير",37,"ر",1,0],["في ذِمَّةِ اللَهِ أَوفى ذِمَّةٍ نَفَرٌ","عَلى طَرابُلُسٍ يَقضونَ شُجعانا",38,"ن",2,0],["في ذِمَّةِ التاريخِ خَمسَةُ أَشهُرٍ","طالَت عَلَيكِ فَكُلُّ يَومٍ عامُ",39,"م",1,0],["فَيُذكِرُني العَهدَ القَديمَ وَلَيلَةً","لَدى سَمُراتِ الجِزعِ إِذ نامَ سامِرُه",40,"ر",2,0],["فيذهَبُ منها في سَريعٍ ذَهابُها","ويَرجعُ منها في بَطئِ رُجوعُها",41,"ع",3,0],["في ذمة الأجيالِ ما غنَّت به","قيثارةٌ سحريةُ الأوتارِ",42,"ر",1,0],["في ذمة الله ما أضعتم","من مهجٍ أصبحت هباء",43,"ا",2,0],["في ذمة الشيطان فلسفتي","ورزانتي ووقار تفكيري",44,"ي",1,0],["في ذراعيَّ أو ذراعيك أمن وسلام ورحمة ونجاء","وعلى صدرك المعذب أو صدريَ حصن وعصمة واحتماء",45,"ا",2,0],["فيذكِّيهمْ ذكاةً","ويُذَكِّينا ذكاءَ",46,"ا",2,0],["في ذِمَّةِ اللهِ ما ألقَى وما أجِدُ","أهذِهِ صَخرةٌ أمْ هذِه كبِدُ",47,"د",1,1],["في ذاكَ ما قَد قُلتُ إِنّي ماكِثٌ","عَشراً فَقالَت ما بَدا لَكَ فَاِقعُدِ",48,"د",1,0],["في ذِمَّةِ الذّكرِ الحكيمِ رِسَالَتي","وإليكَ رَبِّي مَرْجِعي وَمَعادي",49,"ي",1,0],["في ذِمَّةِ التُّركِ دُنيا لا تَضيقُ بها","سُيوفُهم وزَمانٌ غيرُ مَعْسورِ",50,"ر",1,0],["في ذِمَّةِ اللهِ مُنىً موديَهْ","باسقةٌ خضراءُ لُدْنٌ رطابْ",51,"ب",1,0],["في ذكر أمك للزناة دلالةٌ","فأحب من ذكر ابنها من يشتم",52,"م",1,0],["فِي ذِمَّةِ اللهِ العَلِي مُفَارِقٌ","هُوَ خَالِدّ بِالذّكْرِ غَيْرُ مُفَارِقِ",53,"ق",1,0],["فِي ذِكْرِهِ مُتَبَاهِياً آثَارَهَا","وَمَآثِرَ الأَجْدَادِ وَالآباءِ",54,"ا",2,0],["فِي ذِمَّةِ اللهِ خَيْرِ مُعْتَزِمٍ","لِخَيْرِ مَا يَبْتَغِيهِ مُعْتَزِمُ",55,"م",1,0],["فَي ذُرَا مِصْرٍ وَفِي كُلِّ حِمَى","عَرَبِيٍّ حَرَبٌ أَيُّ حَرَبْ",56,"ب",1,0],["فِي ذلِكَ المِيقَاتِ أَقْبَلَ يَافِعٌ","بِوِسَامِ كَشَّافٍ وَبِزَّةِ طَالبِ",57,"ب",1,0],["فِي ذِمَّةِ المَوْلَى شِهَابٌ عَاثِرٌ","تَبْكِيهِ أُمَّتُهُ بِقَلْبٍ ذَائِبِ",57,"ب",1,0],["في ذلك الصمت الرهيب","وذلك الليلِ الجهام",58,"م",1,0],["في ذمة الفن المقدسّ عازف","لقي الحِمام على صدى ألحانه",59,"ن",2,0],["في ذمة الرحمن حُو","رٌ قاصراتُ الطرف عِين!",60,"ن",1,0],["في ذمة الله أحباب لنا ارتحلوا","دانوا محبهم مثل الذي دانا",61,"ن",2,0],["فى ذلك الحين والفتيان سادرة","فى الغى لم يثنهم لوم ولا عتب",62,"ب",1,0],["في ذمة الوطن المفدّى أن تُرى","مُتغِّرباً وعن المواطن نازحا",63,"ح",2,0],["في ذمةِ اللهِ ما لاقيتَ من نَفَرٍ","من الأجانب عُبّادٍ لأهواء",64,"ا",2,0],["في ذمَّةِ الشِّعْرِ ما ألقى وأعظَمُهُ","أنّي أُغنّي لِأصْنامٍ وأحجار",65,"ر",1,0],["في ذمة الله حزنُ الشعب حينَ رأى","وديعةَ الله عند الشعب تُستَلم",66,"م",1,0],["في ذمة التاريخِ ما جُرِّعتُمُ","من غُصَّةٍ ، في ذمة الأجيال",67,"ل",1,0],["في ذُرا قِبة ٍ غدتْ لبني حم","ادٍ الأكرمين مُرداً وشيبا",68,"ب",2,0]]}