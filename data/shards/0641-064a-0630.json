لكامل"],[456,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[475,"كم دون مسراك من بيد وأخطار","https://www.aldiwan.net/poem15202.html","البسيط"],[477,"أيان وقفت على الرمم","https://www.aldiwan.net/poem36883.html","المتدارك"],[536,"لله إخوان بقلبي ذهبوا","https://www.aldiwan.net/poem47541.html","عموديه"],[536,"في ذمة المولى العلى الشان","https://www.aldiwan.net/poem47921.html","عموديه"],[536,"أبخير عيد أم بخير إمام","https://www.aldiwan.net/poem47940.html","عموديه"],[556,"فاز الذي شرب الشراب الصافي","https://www.aldiwan.net/poem33540.html","الكامل"],[556,"يامن يحب حبيبه","https://www.aldiwan.net/poem34961.html","المجتث"],[558,"أغنيات الفقد","https://www.aldiwan.net/poem67265.html","عموديه"],[559,"لقد وجدتم مصعبا مستصعبا","https://www.aldiwan.net/poem27829.html","الرجز"],[560,"للموت يولد منا كل مولود","https://www.aldiwan.net/poem52755.html","البسيط"],[560,"ما يرتجيه المرء من مولوده","https://www.aldiwan.net/poem52771.html","الكامل"],[560,"من عاشر الدهر لا يخلو من الهوس","https://www.aldiwan.net/poem52815.html","البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"أرح يمينك مما أنت معتقل","https://www.aldiwan.net/poem17644.html","البسيط"]],"verses":[["في ذُنابى مَعشَرٍ جيرانُهُم","مُضَغٌ لِلخَطبِ يَغدو أَو لُقَط",0,"ط",1,0],["فِي ذِمَّةِ اللَّهِ أَحْبَابٌ لَنَا رَحَلُوا","دَانُوا مُحِبَّهُمُ مِثْلَ الَّذِي دَانَا",1,"ن",2,0],["في ذِمَّةِ الآفاقِ سِر","وَاِرجِع إِلى تِلكَ الدِيار",2,"ر",1,0],["في ذمة اللَه أغنمى نعماءه","أجرا فما غير الخلود يفيك",3,"ك",1,0],["في ذاك العهد وقد صرت في","أترابك الأمكن والأرجلا",4,"ل",2,0],["فِي ذِمَّةِ اللهِ وَفِي عَهْدِهِ","شَبَابُهُ النَّاضِرُ فِي لَحْدِهِ",5,"د",2,1],["فِي ذِمَّةِ المُولَى عَزِيزٌ جَاءَهُ","بَرَّ الطَّويَّةِ طَاهِرَ الأَرْدَانِ",6,"ن",1,0],["فِي ذَلِكَ الزَّمَنِ الكَبِيرِ بِمَا جَرَى","فِيهِ هُوَ قَلَّ فِي الأَزْمَانِ",7,"ن",1,0],["فِي ذِمَّةِ الرَّحْمَنِ خَيْرُ مُجَاهِدٍ","لَمْ يَلْتَمِسْ إلاَّ رِضَا الرَّحْمَنِ",8,"ن",1,0],["في ذِمَّةِ المَوْلَى وَفِي رُضْوَانِهِ","أَوْلَى رِجَالِ اللهِ بِالرُّضْوَانِ",9,"ن",1,0],["فَيَذُوبَ كُلٌّ مِنْهُمَا فِي صِنْوِهِ","وَكَذَاكَ يَحْيَا بِالْهَوَى الصِّنْوَانِ",10,"ن",1,0],["فِي ذِمَّةِ اللهِ يَا فَريقاً","عَاشُوا كِرَاماً وَمَاتُوا كِرَامَا",11,"م",2,0],["فِي ذِمَّةِ اللهِ كَمَالُ التُّقَى","وَعِفَّة النَّفْسِ وَرَعْيِ الذِّمَامْ",12,"م",1,0],["فِي ذِمَّةِ اللهِ الصَّدِيقُ الَّذِي","أَصْفَيْتُهُ وُدِّي وَلَمْ أَنْدَمِ",13,"م",1,0],["فِي ذَرَاكَ العَالِي مَلائِكُ بِرٍّ","فَرَحُ العِيدِ عَاقَهَا أَنْ تَنَامَا",14,"م",2,0],["فِي ذَلِكَ الهَفْهَافِ","أَوْهَى مِنْ نُسَيْمَاتِ الشَّمَالِ",15,"ل",1,0],["في ذمَّةِ الله قلبي ما أعلُلُهُ","بالقرب إلا وعادَ القربُ مُنْتَزَحا",16,"ح",2,0],["في ذروة من يفاع المجد أولهم","زانت عواليها قواعدُها",17,"ه",2,1],["في ذب رأيك عنه للملوك هدى","كأنَّما هو للآراء إكسير",18,"ر",1,0],["في ذا وذا وصفي ومدحي فما","للغير في شعريَ مستمتع",19,"ع",1,0],["في ذمَّة الله قلبٌ يوم بينكمُ","موزع ودم في الحبِّ مطلول",20,"ل",1,0],["فِي ذِمَّةِ اللَهِ مِن أَصبَحَت مَنزلَهُ","وَجادَ غَيثٌ عَلى مَغناكَ يُمرِعُهُ",21,"ع",2,0],["في ذُرا قِبّةٍ غدتْ لبني حم","مادٍ الأكرمين مُرداً وشيبا",22,"ب",2,0],["فيذكُرني فترجيني","كأوَّل وَهْلةِ الطَّلبِ",23,"ب",1,0],["في ذا وذاك كليهما","خيرٌ وشرٌّ مستطيرُ",24,"ر",1,0],["في ذَراهُ يُستبدَلُ العِزُّ والثَّرْ","وة من ذِلةٍ ومن إعدام",25,"م",1,0],["في ذُبَّلٍ كَقِداحِ النَبعِ يَعذِمُها","حَتّى تُنوسِيَتِ الأَضغانُ وَاللَدَدُ",26,"د",1,0],["في ذَلِكَ الرَوضِ الأَغَنِّ بَدى فَتىً","قَد يَبلُغُ العِشرينَ عاماً ذو نُهى",27,"ا",1,1],["في ذِمَّةِ الغَربِ مُشتاقٌ يُنازِعُهُ","شَوقٌ إِلى مَهبِطِ الآياتِ وَالحِكَمِ",28,"م",1,0],["في ذلكَ الأُفُقِ الجَميلِ","وذلكَ النَّسَمِ الرُّخا",29,"خ",2,0],["في ذِلَّةِ الوادي","وفي كِبْرِ الجبال الشَّاهقهْ",30,"ه",1,0],["في ذي الجفون مصارع الأكباد","الله في جنب بغير عماد",31,"د",1,1],["في ذمة الوطن الكريم عصابة","لم ينس في جد الجهاد بلاءها",32,"ا",3,0],["في ذمة الشبان ما استودعتهم","من خاطر وقريحة وفؤاد",33,"د",1,0],["في ذي الجفون صوارم الأقدار","راعِى البريةَ يا رعاك الباري",34,"ي",1,1],["في ذِمَّةِ اللَهِ الكَريمِ وَبِرِّهِ","ما ضَمَّ مِن عُرفٍ وَمِن إِحسانِ",35,"ن",1,0],["في ذِمَّةِ اللَهِ الكَريمِ وَحِفظِهِ","جَسَدٌ بِبُرقَةَ وُسِّدَ الصَحراءَ",36,"ا",2,0],["في ذِمَّةِ الفُضلى هُدى","جيلٌ إِلى هادٍ فَقير",37,"ر",1,0],["في ذِمَّةِ اللَهِ أَوفى ذِمَّةٍ نَفَرٌ","عَلى طَرابُلُسٍ يَقضونَ شُجعانا",38,"ن",2,0],["في ذِمَّةِ التاريخِ خَمسَةُ أَشهُرٍ","طالَت عَلَيكِ فَكُلُّ يَومٍ عامُ",39,"م",1,0],["فَيُذكِرُني العَهدَ القَديمَ وَلَيلَةً","لَدى سَمُراتِ الجِزعِ إِذ نامَ سامِرُه",40,"ر",2,0],["فيذهَبُ منها في سَريعٍ ذَهابُها","ويَرجعُ منها في بَطئِ رُجوعُها",41,"ع",3,0],["في ذمة الأجيالِ ما غنَّت به","قيثارةٌ سحريةُ الأوتارِ",42,"ر",1,0],["في ذمة الله ما أضعتم","من مهجٍ أصبحت هباء",43,"ا",2,0],["في ذمة الشيطان فلسفتي","ورزانتي ووقار تفكيري",44,"ي",1,0],["في ذراعيَّ أو ذراعيك أمن وسلام ورحمة ونجاء","وعلى صدرك المعذب أو صدريَ حصن وعصمة واحتماء",45,"ا",2,0],["فيذكِّيهمْ ذكاةً","ويُذَكِّينا ذكاءَ",46,"ا",2,0],["في ذِمَّةِ اللهِ ما ألقَى وما أجِدُ","أهذِهِ صَخرةٌ أمْ هذِه كبِدُ",47,"د",1,1],["في ذاكَ ما قَد قُلتُ إِنّي ماكِثٌ","عَشراً فَقالَت ما بَدا لَكَ فَاِقعُدِ",48,"د",1,0],["في ذِمَّةِ الذّكرِ الحكيمِ رِسَالَتي","وإليكَ رَبِّي مَرْجِعي وَمَعادي",49,"ي",1,0],["في ذِمَّةِ التُّركِ دُنيا لا تَضيقُ بها","سُيوفُهم وزَمانٌ غيرُ مَعْسورِ",50,"ر",1,0],["في ذِمَّةِ اللهِ مُنىً موديَهْ","باسقةٌ خضراءُ لُدْنٌ رطابْ",51,"ب",1,0],["في ذكر أمك للزناة دلالةٌ","فأحب من ذكر ابنها من يشتم",52,"م",1,0],["فِي ذِمَّةِ اللهِ العَلِي مُفَارِقٌ","هُوَ خَالِدّ بِالذّكْرِ غَيْرُ مُفَارِقِ",53,"ق",1,0],["فِي ذِكْرِهِ مُتَبَاهِياً آثَارَهَا","وَمَآثِرَ الأَجْدَادِ وَالآباءِ",54,"ا",2,0],["فِي ذِمَّةِ اللهِ خَيْرِ مُعْتَزِمٍ","لِخَيْرِ مَا يَبْتَغِيهِ مُعْتَزِمُ",55,"م",1,0],["فَي ذُرَا مِصْرٍ وَفِي كُلِّ حِمَى","عَرَبِيٍّ حَرَبٌ أَيُّ حَرَبْ",56,"ب",1,0],["فِي ذلِكَ المِيقَاتِ أَقْبَلَ يَافِعٌ","بِوِسَامِ كَشَّافٍ وَبِزَّةِ طَالبِ",57,"ب",1,0],["فِي ذِمَّةِ المَوْلَى شِهَابٌ عَاثِرٌ","تَبْكِيهِ أُمَّتُهُ بِقَلْبٍ ذَائِبِ",57,"ب",1,0],["في ذلك الصمت الرهيب","وذلك الليلِ الجهام",58,"م",1,0],["في ذمة الفن المقدسّ عازف","لقي الحِمام على صدى ألحانه",59,"ن",2,0],["في ذمة الرحمن حُو","رٌ قاصراتُ الطرف عِين!",60,"ن",1,0],["في ذمة الله أحباب لنا ارتحلوا","دانوا محبهم مثل الذي دانا",61,"ن",2,0],["فى ذلك الحين والفتيان سادرة","فى الغى لم يثنهم لوم ولا عتب",62,"ب",1,0],["في ذمة الوطن المفدّى أن تُرى","مُتغِّرباً وعن المواطن نازحا",63,"ح",2,0],["في ذمةِ اللهِ ما لاقيتَ من نَفَرٍ","من الأجانب عُبّادٍ لأهواء",64,"ا",2,0],["في ذمَّةِ الشِّعْرِ ما ألقى وأعظَمُهُ","أنّي أُغنّي لِأصْنامٍ وأحجار",65,"ر",1,0],["في ذمة الله حزنُ الشعب حينَ رأى","وديعةَ الله عند الشعب تُستَلم",66,"م",1,0],["في ذمة التاريخِ ما جُرِّعتُمُ","من غُصَّةٍ ، في ذمة الأجيال",67,"ل",1,0],["في ذُرا قِبة ٍ غدتْ لبني حم","ادٍ الأكرمين مُرداً وشيبا",68,"ب",2,0],["في ذمة الله الاويقات التي","مرت بروض الغوطة البسام",69,"م",1,0],["فيذودني شوك شرعت","شباته دون الخدود",70,"د",1,0],["في ذكر من تهوى وفي آثاره","أنسٌ ومن عَدِمَ المثال تمثلا",71,"ل",2,0],["في ذمة الله وفي حفظه","سرْ سالماً بل غانما آمنا",72,"ن",2,0],["في ذمة الله محروسا مدى الأبد","أنىّ ترحلت أو خيمت في بلد",73,"د",1,1],["فَيَذهَبُ قَومٌ كَاليَعاليلِ لا يُرى","لَها أَثَرٌ وَالماءُ تغطي جَداوِلُه",74,"ل",2,0],["في ذمةِ اللَهِ الكَريمِ كَريمةٌ","قَد كانَ في ثَوبِ العَفافِ مَسيرُها",75,"ر",3,0],["في ذمَّةِ اللَهِ مَن عِندي لَهُ ذِممٌ","في الحُبِّ لَيسَ يَفيها مَدمَعٌ هَطلا",76,"ل",2,0],["في ذمة اللَه ما ضينا وحاضرنا","بؤس ويأس ألا سحقا لمن خانا",77,"ن",2,0],["في ذمَّةِ الأقدارِ ما","شيَّعتُ في ذاكَ الحوارِ",78,"ر",1,0],["في ذكر عاصيها يروق اذا جرى","ويزيد في الدولاب فيه تغزلا",79,"ل",2,0],["في ذلك الدوح غصنٌ","لولا العفافُ هصرتُه",80,"ه",1,0],["في ذلك الروض زهرٌ","لولا الحياء قطفتُه",80,"ه",1,0],["في ذلِكَ الزَمَنِ العاتي لَبِستُ فَتىً","أَلَمَّ في خُلقِهِ أَمجادَ غَسّانِ",81,"ن",1,0],["في ذلِك اللَيلِ العَصيبِ الطَويل","تذَكَّرَ الشاعِرُ عَهداً جَميل",82,"ل",1,0],["في ذاتِ لَيلٍ وَقد فاتَ الكَرى عَيني","خَرجتُ أَسرحُ فكري مع صَديقَينِ",83,"ن",1,0],["في ذِمَّةِ الماضي اِنطَوَت","ساعاتُ أَحلامي العِذاب",84,"ب",1,1],["في ذِمَّةِ القَصيّ","حُشاشَةٌ ذابَت هِيا