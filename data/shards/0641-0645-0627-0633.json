 الحَقِّ إِذعانا",2,"ن",2,0],["فَما سادوا بِمُعجِزَةٍ عَلَينا","وَلَكِن في صُفوفِهِمُ اِنضِمامُ",3,"م",1,0],["فَما سَمَونا إِلى نَجدٍ نُحاوِلُهُ","إِلّا هَبَطنا إِلى غَورٍ مِنَ العَطَبِ",4,"ب",1,0],["فَما سَيفُ ذاكَ العَزمِ فيهِم بِمَعضِدٍ","وَلا سَهمُ ذاكَ الرَأيِ أَفوَقُ ناصِلِ",5,"ل",1,0],["فَما سَقِمَت لَحَظاتُ العُيو","نِ إِلّا لِتُغرِيَني بِالسَقَم",6,"م",1,0],["فَماسَ حَتّى زافَ وَهماً أَصيَدا","وَأَردَفَ النابَ السَديسَ قُيِّدا",7,"د",2,0],["فما سال فيض الدمع حتى قرنته","إلى زفرات قد تصاعدن من صدري",8,"ر",2,0],["َفَمَا سَاءَني قَولُ امرىءٍ ذِي عَدَاوةٍ","بِعَوراء فِيهِم يَجتَدِينِي فَيَجدُبُ",9,"ب",1,0],["فما سَاءَنِي تَكفِيرُ هَاتِيكَ مِنهُمُ","ولا عَيبُ هاتِيكَ التي هِيَ أعيَبُ",9,"ب",1,0],["فما سَرَتِ النجومُ سُرَايَ فيهِ","ولا انسابتْ أفاعيهِ انسيابي",10,"ب",2,0],["فَما ساءَني إِلّا شَماتَةُ مَعشَرٍ","رَجَوتُ بِهِم عِندَ الشَدائِدِ مُسعِدا",11,"د",2,0],["فما سِحْرُهُ إنْ غدا واقعاً","يُحَسُّ وأَصبحَ شيئاً شهيدْ",12,"د",1,0],["فَما سِرتُ مِن مَيلٍ وَلا سِرتُ لَيلَةً","مِنَ الدَهرِ إِلّا اِعتادَني مِنكِ طائِفُ",13,"ف",1,1],["فما سمع الهلال ولا الصليب","بغيرك في عقاب المعتدينا",14,"ن",2,0],["فما سَمْعُه للعاذِلاتِ بعُرضةٍ","ولا قلبُه للظاعنينَ جَنِيبُ",15,"ب",1,0],["فَما سَعيُهُ عَن نَيلِهِنَّ مُؤَخَّرٌ","وَلا حَدُّهُ عَن حَوزِهِنَّ كَليلُ",16,"ل",1,0],["فَما سَرَّني إِلّا كَلامٌ أَسيغُهُ","بِمَسمَعِ واعٍ أَو مَعانٍ أَصوغُها",17,"غ",3,0],["فَما سادِرٌ في السُكرِ إِلّا كَحاتِمٍ","وَما باقِلٌ إِلّا إِذا ذاقَها قَسُّ",18,"س",1,0],["فما سَمِعَ الأُسودُ لهم عُواءً","ولا خافَ الذُّبابُ لهم طنينا",19,"ن",2,0],["فَما سَبَأوا الراحَ الكُمَيتَ لِلَذَّةٍ","وَلا كانَ مِنهُم لِلخِرادِ سِباءُ",20,"ب",3,0],["فَما سَئِمَ الساري وَقَد بَلَغَ المَدى","وَلا رَزَمَت في السَيرِ تِلكَ العَرامِسُ",21,"س",1,0],["فَما سُقِيَت دارٌ فَقُلتُ لَها اِنعَمي","وَلا هَبَّ إِيماضٌ فَقُلتُ لَهُ هِجَني",22,"ن",2,0],["فما سكنَتْ والهمَّ يوماً بموضع","كذلك لم يسكُنْ مع النَّغَم الغَم",23,"م",1,0],["فَما ساس سعد مصر حتى تقدمت","وحتى مشت نحو الرقيِّ به وثبا",24,"ب",2,0],["فَمَا سَرَيْتُ قِنَاعَ الْحِلْمِ عَنْ سَفَهٍ","وَلا مَسَحْتُ جَبِينَ الْعِزِّ مِنْ خَجَلِ",25,"ل",1,0],["فما سرت إلا وقد ثارتا","بردفي كالبحر رجراجتينْ",26,"ن",1,0],["فما سجدت الا لذى العرش جبهة","ولم يرتفع الا إليه دعاء",27,"ا",2,0],["فما سرتُ نحو البابِ حتى رأيتُه","تقدَّمَ بسَّامَ الأساريرِ مهتمّا",28,"م",2,0],["فما سمعتِ سوى الأشعارِ باكيةً وما رأيتِ سوى الإنسانِ يرتعدُ","أنا الطموحُ الذي كلّت قوادمهُ أنتِ الطموحُ الذي يسعى له الامدُ",29,"د",1,0],["فما ساءني شماتة معشر","رجوت بهم عند الشدائد مسعدا",30,"د",2,0],["فما سوى الشرع عنده ادب","ولا سوى الحق عنده سبب",31,"ب",1,0],["فما ساءَنا سوءا ولا سامَنا أذَى","من الخلق إلا من نرَى ونؤالفُ",32,"ف",1,0],["فما سجعُ المطوّقِ إذ تغنىّ","وما الأعطافُ حين تميلُ مَيلا",33,"ل",2,0],["فما سباه ملثَّم بضُحىً","ولا شجاه معمَّم بدُجَى",34,"ج",2,0],["فما سكبتم له ذنَوبا من الد","مع ونارُ الأحزان تشتعلُ",35,"ل",1,0],["فَما سَعى نَحوَها أَمامَكَ إِن","سانٌ وَقَد سُدَّ خَلفَكَ الجَدَدُ",36,"د",1,0],["فما سودت وجها ولا فضحت اخا","بإقبالها من شارع في ردائها",37,"ا",3,0],["فما سمعنا مذ نصرت ربنا","طاغ على اللهَ تعالى يفترىِ",38,"ر",2,0],["فما سمعت أذن ولا مقلة رأت","ككرَة يحيى كلما كثر الوفد",39,"د",1,0],["فما سمعت إذن بمعط وفوده","تجافا عن الاعطا فما يقبل العذرا",40,"ر",2,0],["فما سقي بجيرا من رحيق مدامة","واسقي الخفير وطهري أثوابه",41,"ب",2,0],["فَما سالَموا منهم أباً ضلّ واِبنَما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",42,"م",2,0],["فَما سعادُ إِذا قيسَت ببَهجتها","وكلُّ أَمثالها إلّا تماثيلُ",43,"ل",1,0],["فما سره لما رآك فراره","ولم يبق في الحصن المحصن مهرب",44,"ب",1,0],["فَما سُلَّ إِلذا أَهلك الشِركَ حَدُّهُ","وَلا سُئِلَ الاحسان الّا تَهلَّلا",45,"ل",2,0],["فما سلمى وما لبنى","وما ليلى وما جُمل",46,"ل",1,0],["فَما سَخا الْعَزْمُ بِي إِلاّ إِلَيْكَ وَلا","وَقَفْتُ إِلاّ عَلَيْكَ الظَّنَّ مُحْتَسِبا",47,"ب",2,0],["فَما سُدَّ بابٌ مِنَ الْمَكْرُماتِ","إِلاّ وَأَنْتَ لَهُ فاتِحُ",48,"ح",1,0],["فَما سَلّى الهُمومَ كَشُربِ راحٍ","كُمَيتٍ زَندُها في اللَيلِ واري",49,"ر",2,0],["فَما ساءَني شَيءٌ كَما ساءَني أَخي","وَلَم أَرضَ لِلَهِ الَّذي كانَ صانِعا",50,"ع",2,1],["فما سمت أمة يوما لغايتها","وفي الشباب رؤى جبن وخذلان",51,"ن",1,0],["فما سطّر الحزن انمحى بمسرة","فحمداً لمن أسرى عن القلب ما أسرى",52,"ر",2,0],["فما سِوَى أحمدَ بْنِ الفَضْلِ ذو كرمٍ","تَغْدو مَواهبهُ للحَمْدِ أثمانا",53,"ن",2,0],["فما سَبَبٌ يَشُدُّ بمِثْلِ هذا","فَيُمكِنَ أن يَصيرَ إلى انْحِلال",54,"ل",1,0],["فما سمعَ الأقوامُ قبلَ طُروقها","بشمسٍ بدَتْ والصّبحُ لم يَبتلَّج",55,"ج",1,0],["فما سِواهُم أحدٌ","يطلُبُني من أحدِ",56,"د",1,0],["فما سمعت بها أُذنا شغوف","ولابصرت بها عينا رقيب",57,"ب",1,0],["فما سوى طاعته من مطلب","فاحرص عليها فهي خير مكسب",58,"ب",1,0],["فما سألوا عن الأفعال لكن","أتوا في هديهم خير الفعال",59,"ل",1,0],["فَما سلمتَ فقدْ مُلِّكْتَ مملكَةً","بلّغْ أَميري معينَ الدّين مَأْلُكَةً",60,"ه",1,0],["فما ساءني فقرٌ ولا سرّني غِنىً","وعرضي لم يُكْلَمْ إذا هو وافر",61,"ر",1,0],["فما سُئِل النَّدى والجودَ إلاَّ","وأسْرَعَ بالثواب وبالجواب",62,"ب",1,0],["فما ساغ لي إلاَّ بفضلك مشربٌ","ولا لَذّ لي إلاَّ بظلِّك مطعم",63,"م",1,0],["فما سالَ يوماً بعد جدواه أبطحٌ","بسيب ولن تسقى من الغيث أجرعُ",64,"ع",1,0],["فما سلّت ظباه قط إلّا","لتغمد بالحناجر والنحورِ",65,"ر",1,0],["فما سمّاكُما البدرَيْنِ إِلا","سُمُوٌّ فيكما بَلَغَ السَّماءَ",66,"ا",2,0],["فما سالم منه وإن طال عمره","بباق إذا لكن إلى الموت يدفع",67,"ع",1,0],["فما سابق إِلا ويتلوه لاحق","فآخرنا منا بأولاه مقتدي",68,"د",2,0],["فما سواكم للندى","ولا سواي للثنا",69,"ن",2,0],["فما سرَّها تحت ذاك الظلا","م أنّ مصابيحَه تُشعَلُ",70,"ل",1,0],["فما سرّني في الحقّ أنّي مع العدا","ولا عابَ أنّي في المحال على أبي",71,"ب",2,0],["فما سواك لها بعلٌ وقد عطلتْ","فحلِّها بتلافيها من العطل",72,"ل",1,0],["فما سمعتْ أذن الزّمان بمثلها","ولا نظرتْ من قبلُ عينُ النوائب",73,"ب",1,0],["فما سلك الأملاك نهجاً من الندى","بغير دليل منك في البعد والقرب",74,"ب",1,0],["فما ساوَمَت نفسَها في الخَسار","وَلا ساوَمَتْها على المَغنَمِ",75,"م",1,0],["فما سَاكناتُ الدَّوحِ يُشجِى نَحِيبُها","وتأبَى مآقِيها تُسَاعِدُها سَكبَا",76,"ب",2,0],["فَما سَلَوتُ الهَوى جَهلاً بِلَذَّتِهِ","وَلا عَصَيتُ إِلَهَ الحِلمِ عَن خَرَقِ",77,"ق",1,0],["ف