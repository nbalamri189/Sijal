{"poems":[[53,"ردي مر الورود ولا تعافي","https://www.aldiwan.net/poem29969.html","الوافر"],[63,"لعمر أبي وهو ابن من تعرفونه","https://www.aldiwan.net/poem45860.html","الطويل"],[86,"أما أمين فقد ذقنا لمصرعه","https://www.aldiwan.net/poem10377.html","البسيط"],[86,"لقد نصل الدجى فمتى تنام","https://www.aldiwan.net/poem10686.html","الوافر"],[86,"إن كنتم تبذلون المال عن رهب","https://www.aldiwan.net/poem10919.html","البسيط"],[73,"مرادهم حيث السلاح خمائل","https://www.aldiwan.net/poem11930.html","الطويل"],[73,"لبيض الطلى ولسود اللمم","https://www.aldiwan.net/poem11934.html","المتقارب"],[30,"قفا نحيي العرصات الهمدا","https://www.aldiwan.net/poem29604.html","الرجز"],[88,"قرأت وما غير الطبيعة من سفر","https://www.aldiwan.net/poem45075.html","الطويل"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[91,"مرضت فأرواح الصحاب كئيبة","https://www.aldiwan.net/poem8812.html","عموديه"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[32,"فما سرت من ميل ولا سرت ليلة","https://www.aldiwan.net/poem27779.html","الطويل"],[85,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[62,"نصيحكما فيما يقول مريب","https://www.aldiwan.net/poem52505.html","الطويل"],[45,"لها الله عني ضامن وكفيل","https://www.aldiwan.net/poem65604.html","الطويل"],[66,"وإني لمغرى بالقوافي ونظمها","https://www.aldiwan.net/poem38542.html","الطويل"],[66,"تشارك فيها الشم والذوق واللمس","https://www.aldiwan.net/poem39209.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[46,"ألو الفضل في أوطانهم غرباء","https://www.aldiwan.net/poem21990.html","الطويل"],[46,"نراقب ضوء الفجر والليل دامس","https://www.aldiwan.net/poem22783.html","الطويل"],[46,"متى أنا في هذا التراب مغيب","https://www.aldiwan.net/poem23495.html","الطويل"],[68,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85649","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141999","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54193","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[104,"سيدة الاقمار","https://www.poetsgate.com/ViewPoem.aspx?id=16826",""],[91,"في فراش المرض","https://www.poetsgate.com/ViewPoem.aspx?id=53028",""],[115,"شيخي الرفاعي طريقه الأدب","https://www.aldiwan.net/poem41248.html","عموديه"],[128,"وقلت له لقياك خير علالة","https://www.aldiwan.net/poem50574.html","الطويل"],[135,"أتطمع أن تذوق الغمض ليلا","https://www.aldiwan.net/poem49144.html","الوافر"],[142,"فر من الحب قلبه فنجا","https://www.aldiwan.net/poem58352.html","المنسرح"],[142,"لا مرية في الردى ولا جدل","https://www.aldiwan.net/poem58417.html","المنسرح"],[143,"قصر عن سعيك الألى جهدوا","https://www.aldiwan.net/poem11756.html","المنسرح"],[160,"تولت فما من مطمع في لقائها","https://www.aldiwan.net/poem58712.html","الطويل"],[160,"هنيته عيدا فصل وانحر","https://www.aldiwan.net/poem58821.html","الرجز"],[160,"دعوني فما مما يكلفني بد","https://www.aldiwan.net/poem58839.html","الطويل"],[160,"تقضت ليال ضاعفت لكم الأجرا","https://www.aldiwan.net/poem58864.html","الطويل"],[165,"همت عكابة أن تضيم لجيما","https://www.aldiwan.net/poem729.html",""],[189,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[189,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[239,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[252,"أبى جلد أن أحمل البين والقلى","https://www.aldiwan.net/poem1415.html",""],[259,"حمى حي التداني سلوا","https://www.aldiwan.net/poem35559.html","مجزوء الوافر"],[280,"أعطى الشباب من الآراب ما طلبا","https://www.aldiwan.net/poem60775.html","البسيط"],[280,"بنفسي على قربه النازح","https://www.aldiwan.net/poem60778.html","المتقارب"],[282,"أديري في الدجى شمس العقار","https://www.aldiwan.net/poem32778.html","الوافر"],[309,"فما ساءني شيء كما ساءني أخي","https://www.aldiwan.net/poem50281.html","الطويل"],[328,"سر باسم ربك هذا عامك الثاني","https://www.aldiwan.net/poem55065.html","البسيط"],[356,"مضت غرة والحمد للّه في أخرى","https://www.aldiwan.net/poem24533.html","الطويل"],[364,"إذا الحمام على الأغصان غنانا","https://www.aldiwan.net/poem60616.html","البسيط"],[364,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[364,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[371,"ما لطويل الكمد","https://www.aldiwan.net/poem57492.html","مجزوء الرجز"],[400,"أسد الشيشان","https://www.aldiwan.net/poem6792.html","عموديه"],[403,"الحمد لله عظيم الشأن","https://www.aldiwan.net/poem33345.html","الرجز"],[403,"لقد سار الإِمام أبو المعالي","https://www.aldiwan.net/poem33478.html","الوافر"],[409,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[416,"تولت من الظلماء تلك الدياجر","https://www.aldiwan.net/poem54031.html","الطويل"],[416,"ذكرت على النوى عهد التصابي","https://www.aldiwan.net/poem54047.html","الوافر"],[416,"متى يشتفي هذا الفؤاد المتيم","https://www.aldiwan.net/poem54074.html","الطويل"],[416,"بوادي الغضا للمالكية أربع","https://www.aldiwan.net/poem54180.html","الطويل"],[429,"ألا حيي بكاسك واستنيري","https://www.aldiwan.net/poem41439.html","الوافر"],[432,"سعود سنيكما كملت سناء","https://www.aldiwan.net/poem12355.html","الوافر"],[437,"ربوع الندى من بعد فقدك بلقع","https://www.aldiwan.net/poem2548.html","الطويل"],[441,"تروح المنايا في البرايا وتغتدي","https://www.aldiwan.net/poem14444.html","الطويل"],[458,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[458,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[458,"شفى الله نفسا لا تذل لمطلب","https://www.aldiwan.net/poem56303.html","الطويل"],[464,"مابعد لقياك للعافين من أملِ","https://www.aldiwan.net/poem3136.html","عموديه"],[464,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[464,"سمو كما تهدى على العجم والعرب","https://www.aldiwan.net/poem3260.html","عموديه"],[465,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[538,"بحقكم في مهجتي راقبوا الربا","https://www.aldiwan.net/poem48266.html","عموديه"],[553,"يا واشيا حسنت فينا إساءته","https://www.aldiwan.net/poem68281.html","البسيط"],[563,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[563,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"]],"verses":[["فَما سَهمي السَديدُ مِنَ النَوابي","وَلا باعي الطَويلُ مِنَ الضِعافِ",0,"ف",1,0],["فَما سَكَّنَتْنا لِلْهوانِ خَصاصَةٌ","وَلا حَرَّكَتْنا في الغِنى خُيَلاءُ",1,"ا",2,0],["فَما سَعَيتَ لِغَيرِ الحَمدِ تَكسِبُهُ","وَلا رَضيتَ لِغَيرِ الحَقِّ إِذعانا",2,"ن",2,0],["فَما سادوا بِمُعجِزَةٍ عَلَينا","وَلَكِن في صُفوفِهِمُ اِنضِمامُ",3,"م",1,0],["فَما سَمَونا إِلى نَجدٍ نُحاوِلُهُ","إِلّا هَبَطنا إِلى غَورٍ مِنَ العَطَبِ",4,"ب",1,0],["فَما سَيفُ ذاكَ العَزمِ فيهِم بِمَعضِدٍ","وَلا سَهمُ ذاكَ الرَأيِ أَفوَقُ ناصِلِ",5,"ل",1,0],["فَما سَقِمَت لَحَظاتُ العُيو","نِ إِلّا لِتُغرِيَني بِالسَقَم",6,"م",1,0],["فَماسَ حَتّى زافَ وَهماً أَصيَدا","وَأَردَفَ النابَ السَديسَ قُيِّدا",7,"د",2,0],["فما سال فيض الدمع حتى قرنته","إلى زفرات قد تصاعدن من صدري",8,"ر",2,0],["َفَمَا سَاءَني قَولُ امرىءٍ ذِي عَدَاوةٍ","بِعَوراء فِيهِم يَجتَدِينِي فَيَجدُبُ",9,"ب",1,0],["فما سَاءَنِي تَكفِيرُ هَاتِيكَ مِنهُمُ","ولا عَيبُ هاتِيكَ التي هِيَ أعيَبُ",9,"ب",1,0],["فما سَرَتِ النجومُ سُرَايَ فيهِ","ولا انسابتْ أفاعيهِ انسيابي",10,"ب",2,0],["فَما ساءَني إِلّا شَماتَةُ مَعشَرٍ","رَجَوتُ بِهِم عِندَ الشَدائِدِ مُسعِدا",11,"د",2,0],["فما سِحْرُهُ إنْ غدا واقعاً","يُحَسُّ وأَصبحَ شيئاً شهيدْ",12,"د",1,0],["فَما سِرتُ مِن مَيلٍ وَلا سِرتُ لَيلَةً","مِنَ الدَهرِ إِلّا اِعتادَني مِنكِ طائِفُ",13,"ف",1,1],["فما سمع الهلال ولا الصليب","بغيرك في عقاب المعتدينا",14,"ن",2,0],["فما سَمْعُه للعاذِلاتِ بعُرضةٍ","ولا قلبُه للظاعنينَ جَنِيبُ",15,"ب",1,0],["فَما سَعيُهُ عَن نَيلِهِنَّ مُؤَخَّرٌ","وَلا حَدُّهُ عَن حَوزِهِنَّ كَليلُ",16,"ل",1,0],["فَما سَرَّني إِلّا كَلامٌ أَسيغُهُ","بِمَسمَعِ واعٍ أَو مَعانٍ أَصوغُها",17,"غ",3,0],["فَما سادِرٌ في السُكرِ إِلّا كَحاتِمٍ","وَما باقِلٌ إِلّا إِذا ذاقَها قَسُّ",18,"س",1,0],["فما سَمِعَ الأُسودُ لهم عُواءً","ولا خافَ الذُّبابُ لهم طنينا",19,"ن",2,0],["فَما سَبَأوا الراحَ الكُمَيتَ لِلَذَّةٍ","وَلا كانَ مِنهُم لِلخِرادِ سِباءُ",20,"ب",3,0],["فَما سَئِمَ الساري وَقَد بَلَغَ المَدى","وَلا رَزَمَت في السَيرِ تِلكَ العَرامِسُ",21,"س",1,0],["فَما سُقِيَت دارٌ فَقُلتُ لَها اِنعَمي","وَلا هَبَّ إِيماضٌ فَقُلتُ لَهُ هِجَني",22,"ي",1,0],["فما سكنَتْ والهمَّ يوماً بموضع","كذلك لم يسكُنْ مع النَّغَم الغَم",23,"م",1,0],["فَما ساس سعد مصر حتى تقدمت","وحتى مشت نحو الرقيِّ به وثبا",24,"ب",2,0],["فَمَا سَرَيْتُ قِنَاعَ الْحِلْمِ عَنْ سَفَهٍ","وَلا مَسَحْتُ جَبِينَ الْعِزِّ مِنْ خَجَلِ",25,"ل",1,0],["فما سرت إلا وقد ثارتا","بردفي كالبحر رجراجتينْ",26,"ن",1,0],["فما سجدت الا لذى العرش جبهة","ولم يرتفع الا إليه دعاء",27,"ا",2,0],["فما سرتُ نحو البابِ حتى رأيتُه","تقدَّمَ بسَّامَ الأساريرِ مهتمّا",28,"م",2,0],["فما سمعتِ سوى الأشعارِ باكيةً وما رأيتِ سوى الإنسانِ يرتعدُ","أنا الطموحُ الذي كلّت قوادمهُ أنتِ الطموحُ الذي يسعى له الامدُ",29,"د",1,0],["فما ساءني شماتة معشر","رجوت بهم عند الشدائد مسعدا",30,"د",2,0],["فما سوى الشرع عنده ادب","ولا سوى الحق عنده سبب",31,"ب",1,0],["فما ساءَنا سوءا ولا سامَنا أذَى","من الخلق إلا من نرَى ونؤالفُ",32,"ف",1,0],["فما سجعُ المطوّقِ إذ تغنىّ","وما الأعطافُ حين تميلُ مَيلا",33,"ل",2,0],["فما سباه ملثَّم بضُحىً","ولا شجاه معمَّم بدُجَى",34,"ج",2,0],["فما سكبتم له ذنَوبا من الد","مع ونارُ الأحزان تشتعلُ",35,"ل",1,0],["فَما سَعى نَحوَها أَمامَكَ إِن","سانٌ وَقَد سُدَّ خَلفَكَ الجَدَدُ",36,"د",1,0],["فما سودت وجها ولا فضحت اخا","بإقبالها من شارع في ردائها",37,"ا",3,0],["فما سمعنا مذ نصرت ربنا","طاغ على اللهَ تعالى يفترىِ",38,"ر",2,0],["فما سمعت أذن ولا مقلة رأت","ككرَة يحيى كلما كثر الوفد",39,"د",1,0],["فما سمعت إذن بمعط وفوده","تجافا عن الاعطا فما يقبل العذرا",40,"ر",2,0],["فما سقي بجيرا من رحيق مدامة","واسقي الخفير وطهري أثوابه",41,"ب",2,0],["فَما سالَموا منهم أباً ضلّ واِبنَما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",42,"م",2,0],["فَما سعادُ إِذا قيسَت ببَهجتها","وكلُّ أَمثالها إلّا تماثيلُ",43,"ل",1,0],["فما سره لما رآك فراره","ولم يبق في الحصن المحصن مهرب",44,"ب",1,0],["فَما سُلَّ إِلذا أَهلك الشِركَ حَدُّهُ","وَلا سُئِلَ الاحسان الّا تَهلَّلا",45,"ل",2,0],["فما سلمى وما لبنى","وما ليلى وما جُمل",46,"ل",1,0],["فَما سَخا الْعَزْمُ بِي إِلاّ إِلَيْكَ وَلا","وَقَفْتُ إِلاّ عَلَيْكَ الظَّنَّ مُحْتَسِبا",47,"ب",2,0],["فَما سُدَّ بابٌ مِنَ الْمَكْرُماتِ","إِلاّ وَأَنْتَ لَهُ فاتِحُ",48,"ح",1,0],["فَما سَلّى الهُمومَ كَشُربِ راحٍ","كُمَيتٍ زَندُها في اللَيلِ واري",49,"ي",1,0],["فَما ساءَني شَيءٌ كَما ساءَني أَخي","وَلَم أَرضَ لِلَهِ الَّذي كانَ صانِعا",50,"ع",2,1],["فما سمت أمة يوما لغايتها","وفي الشباب رؤى جبن وخذلان",51,"ن",1,0],["فما سطّر الحزن انمحى بمسرة","فحمداً لمن أسرى عن القلب ما أسرى",52,"ر",2,0],["فما سِوَى أحمدَ بْنِ الفَضْلِ ذو كرمٍ","تَغْدو مَواهبهُ للحَمْدِ أثمانا",53,"ن",2,0],["فما سَبَبٌ يَشُدُّ بمِثْلِ هذا","فَيُمكِنَ أن يَصيرَ إلى انْحِلال",54,"ل",1,0],["فما سمعَ الأقوامُ قبلَ طُروقها","بشمسٍ بدَتْ والصّبحُ لم يَبتلَّج",55,"ج",1,0],["فما سِواهُم أحدٌ","يطلُبُني من أحدِ",56,"د",1,0],["فما سمعت بها أُذنا شغوف","ولابصرت بها عينا رقيب",57,"ب",1,0],["فما سوى طاعته من مطلب","فاحرص عليها فهي خير مكسب",58,"ب",1,0],["فما سألوا عن الأفعال لكن","أتوا في هديهم خير الفعال",59,"ل",1,0],["فَما سلمتَ فقدْ مُلِّكْتَ مملكَةً","بلّغْ أَميري معينَ الدّين مَأْلُكَةً",60,"ه",1,0],["فما ساءني فقرٌ ولا سرّني غِنىً","وعرضي لم يُكْلَمْ إذا هو وافر",61,"ر",1,0],["فما سُئِل النَّدى والجودَ إلاَّ","وأسْرَعَ بالثواب وبالجواب",62,"ب",1,0],["فما ساغ لي إلاَّ بفضلك مشربٌ","ولا لَذّ لي إلاَّ بظلِّك مطعم",63,"م",1,0],["فما سالَ يوماً بعد جدواه أبطحٌ","بسيب ولن تسقى من الغيث أجرعُ",64,"ع",1,0],["فما سلّت ظباه قط إلّا","لتغمد بالحناجر والنحورِ",65,"ر",1,0],["فما سمّاكُما البدرَيْنِ إِلا","سُمُوٌّ فيكما بَلَغَ السَّماءَ",66,"ا",2,0],["فما سالم منه وإن طال عمره","بباق إذا لكن إلى الموت يدفع",67,"ع",1,0],["فما سابق إِلا ويتلوه لاحق","فآخرنا منا بأولاه مقتدي",68,"د",2,0],["فما سواكم للندى","ولا سواي للثنا",69,"ن",2,0],["فما سرَّها تحت ذاك الظلا","م أنّ مصابيحَه تُشعَلُ",70,"ل",1,0],["فما سرّني في الحقّ أنّي مع العدا","ولا عابَ أنّي في المحال على أبي",71,"ي",1,0],["فما سواك لها بعلٌ وقد عطلتْ","فحلِّها بتلافيها من العطل",72,"ل",1,0],["فما سمعتْ أذن الزّمان بمثلها","ولا نظرتْ من قبلُ عينُ النوائب",73,"ب",1,0],["فما سلك الأملاك نهجاً من الندى","بغير دليل منك في البعد والقرب",74,"ب",1,0],["فما ساوَمَت نفسَها في الخَسار","وَلا ساوَمَتْها على المَغنَمِ",75,"م",1,0],["فما سَاكناتُ الدَّوحِ يُشجِى نَحِيبُها","وتأبَى مآقِيها تُسَاعِدُها سَكبَا",76,"ب",2,0],["فَما سَلَوتُ الهَوى جَهلاً بِلَذَّتِهِ","وَلا عَصَيتُ إِلَهَ الحِلمِ عَن خَرَقِ",77,"ق",1,0],["فَما ساعٍ إِلى مَجدٍ بِجِدٍّ","كَمُتَّكِلٍ عَلى عَظمٍ رَميمِ",78,"م",1,0],["فَما سَدّهُ مُستَأنِساً ما يُريبُهُ","مُحاكِيهُ السَدُّ الَّذي شادَ مارِبُه",79,"ب",2,0]]}