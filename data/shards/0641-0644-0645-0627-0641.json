{"poems":[[56,"سمت المديح رجالا دون قدرهم","https://www.aldiwan.net/poem27369.html","البسيط"],[2,"وقالت أم كعب لا تزرني","https://www.aldiwan.net/poem25048.html","الوافر"],[33,"أمن آل نعم أنت غاد فمبكر","https://www.aldiwan.net/poem42551.html","الطويل"],[21,"جزى الله الأجل المرء نوحا","https://www.aldiwan.net/poem36245.html","الوافر"],[41,"أهاجك بالملا دمن عوافي","https://www.aldiwan.net/poem53768.html","الوافر"],[54,"أللمنزل بالحنو","https://www.aldiwan.net/poem26584.html","الهزج"],[33,"أَمِنْ آلِ نُعْمِ أَنْتَ غَادٍ فَمُبْكِرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18852&r=&rc=115",""],[164,"إِذا سفك الدماء لديك حلا","https://www.aldiwan.net/poem58931.html","الوافر"],[190,"دعني فلم أر مثلي","https://www.aldiwan.net/poem43365.html","المجتث"],[303,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[325,"تناولت ملبسا","https://www.aldiwan.net/poem61773.html","مجزوء الرجز"],[342,"عفت ذروة من أهلها فجفيرها","https://www.aldiwan.net/poem45429.html","الطويل"],[368,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[475,"وإني لأهواها وأهوى لقاءها","https://www.aldiwan.net/poem4658.html","الطويل"],[735,"","https://poetry.dctabudhabi.ae/diwan/poem/45445","الطويل"],[1078,"","https://poetry.dctabudhabi.ae/diwan/poem/131926","الطويل"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32599","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202937","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202390","البسيط"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/132084","الوافر"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139893","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67980","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69913","البسيط"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[5971,"تنفس صبح الشيب في ليل عارض","https://www.poetsgate.com/ViewPoem.aspx?id=181200",""],[6179,"يصيخُ للنبأة ِ أسماعهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7623&r=&rc=6",""]],"verses":[["فَلَم أَفُر مِنهُمُ إِلّا كَما حَمَلَت","رِجلُ البَعوضَةِ مِن فَخّارَةِ اللَبَنِ",0,"ن",1,0],["فَلَم أُفسِد بَنيكَ وَلَم أُقَرِّب","إِلَيكَ مِنَ المُلِمّاتِ الكِبارِ",1,"ر",1,0],["فَلَمّا فَقَدتُ الصَوتَ مِنهُم وَأُطفِئَت","مَصابيحُ شُبَّت في العِشاءِ وَأَنوُرُ",2,"ر",1,0],["فَلَمّا فَرَّشوا الآياتِ صاغوا","لَها طَوقاً كَما عُقِدَ السِخابُ",3,"ب",1,0],["فَلَمّا فُتَّ عَنها الطينُ فَاحَت","وَصَرَّحَت أَجرَدُ الَجَراتِ صافي",4,"ف",2,0],["فَلَمّا فُلِقَ الرِدفُ","بِنَحضٍ حَسَنِ النَجوِ",5,"و",1,0],["فَلَمَّا فَقَدْتُ الصَّوْتُ مِنْهُمْ وأُطْفِئَتْ","مَصَابِيحُ شُبَّتْ بِکلْعَشاءِ وَأَنْؤُرُ",6,"ر",1,0],["فلما فاتها لقياه أنّت","لحرقة ما تحس أنين ثكلى",7,"ل",2,0],["فلم أفد قطّ شيئا","بحسن رأي وعقل",8,"ل",1,0],["فلم أفهمْ معانيها","وَلكنْ هيَّجتْ شجني",9,"ي",1,0],["فَلَم أَفرِق بَينَهُ","وَبَينَ ذَلِكَ الفَمِ",10,"م",1,0],["فَلَمّا فَنى الأَسمالُ غاضَت وَقَلَّصَت","ثَمائِلُها وَتابَعَ الشَمسَ صورُها",11,"ر",3,0],["فَلَمّا فَنا ما في الكَنائِنِ ضارَبوا","عَلى القُرعِ مِن جِلدِ الهِجانِ المُجَوَّبِ",12,"ب",1,0],["فَلَما فَرجتَ الهَمَّ عَنِّي وَكُربَتي","حَبَوتكَ مِنِّي طائِعاً مُتَعَمّدا",13,"د",2,0],["فَلَمّا فَزِعنا لِلرِمالِ تَضَلَّعَت","طِوالُ القَنا مِنها وَعُلَّت نِهالُها",14,"ل",3,0],["فلما فرغنا من صلاةٍ وبالدُّعا","شرعنا تَسرّى الغيمُ إذ شحّ بالسَّحّ",15,"ح",1,0],["فلما فاح فوه علي فوحا","بمثفل غثيثة الدبر المغد",16,"د",1,0],["فلم أفكر بشعري كيف جاء إذاً","كأنما الله قد أوحاه إيحاء",17,"ا",2,0],["فلم أفكّر بشعري كيف جاء اذن","كأنما الله قد أوحاه إيحاء",18,"ا",2,0],["فلم أفخر به بل قلت حقا","فداني كل مختال فخور",19,"ر",1,0],["فلما فنى صبري وقلَّ تجلّدي","وفارقني نومي وحرمت مضجعي",20,"ع",2,0],["فلما فَشا ضوءُ الصباحِ وَقَدْ بَدتْ","نجومُ السما تَخْبو وألوانُها غُبر",21,"ر",1,0],["فلم أفقه نصيحته وإن","حسنت وسرت على",22,"ل",2,0],["فَلَم افز بِاللقا حَتّى اودّعهُ","في يَوم رحلتِهِ وَالقَلب منكسرُ",23,"ر",1,0],["فَلَمّا فَنى مِنّي وُجودُ هوِيَّتي","وَباعَ البَقا بِالمَوتِ مَن هُوَ بائِعُ",24,"ع",1,0],["فلما فشا عاتبته فأجابني","ألا هل يرى صبح بغير نهار",25,"ر",1,0],["فلماً فنى ما في الكَنائِنِ ضَارَبُوا","ووازَنَّ من شَرقِي سَلمَى بِمَنْكِبِ",26,"ب",1,0]]}