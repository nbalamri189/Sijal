{"poems":[[29,"هاج الهوى وضمير الحاجة الذكر","https://www.aldiwan.net/poem5773.html","البسيط"],[49,"ما لعبيد من الذي","https://www.aldiwan.net/poem25230.html","مجزوء الكامل"],[93,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[35,"ذد الدمع حتى يظعن الحي إنما","https://www.aldiwan.net/poem25847.html","الطويل"],[83,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[147,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[147,"ذد بالعزاء الهم عن طلباته","https://www.aldiwan.net/poem11739.html","الكامل"],[147,"إن لم أقل فيك ما يردي العدى كمدا","https://www.aldiwan.net/poem11753.html","البسيط"],[147,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[147,"دل على المجد من إليه سعى","https://www.aldiwan.net/poem11778.html","المنسرح"],[147,"لله قدرك ما أجل وأشرفا","https://www.aldiwan.net/poem11781.html","الكامل"],[147,"لا تجز في الذي بلغت الأنام","https://www.aldiwan.net/poem11812.html","الخفيف"],[240,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[283,"أما والعيون النجل تصمي نبالها","https://www.aldiwan.net/poem2480.html","الطويل"],[290,"رجب علوت وقد رأى منك العدا","https://www.aldiwan.net/poem39404.html","الكامل"],[463,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[466,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[469,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122648","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64040","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108712","الخفيف"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49581","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53164","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53104","الخفيف"],[240,"","https://poetry.dctabudhabi.ae/diwan/poem/13268","الخفيف"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26117","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140019","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59468","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[4785,"لبنان مل","https://www.poetsgate.com/ViewPoem.aspx?id=129734",""],[5444,"رسالةٌ إلى نجم آفل","https://www.poetsgate.com/ViewPoem.aspx?id=205071",""]],"verses":[["ذُدنا العَدُوَّ وَأَدنَينا مَحَلَّهُمُ","حَتّى اِبتَنوا بِقِبابٍ بَعدَما اِحتَجَزوا",0,"ز",3,0],["ذُدتُ الأُسودَ عَنِ الفَرا","ئِسِ ثُمَّ تَفرِسُني الضِباعُ",1,"ع",1,0],["ذُدتَني عَنه وَالعَواصِفُ تَعدو","في طِلابي وَالجَوُّ أَقتَمَ أَربَد",2,"د",1,0],["ذُدِ الدَمعَ حَتّى يَظعَنَ الحَيُّ إِنَّما","دُموعَكَ إِن فاضَت عَلَيكَ دَليلُ",3,"ل",1,1],["ذُد عَن مَوارِدِ أَدمُعي طَيرَ الكَرى","وَأَعِد بِنارِ الوَجدِ لَيلِيَ نَيِّرا",4,"ر",2,1],["ذُدْتَ عنها وتقدمتَ خُطاها","يوم قالوا خَسرَ الحربَ فتاها",5,"ه",2,0],["ذُدتَ الأُلى قَهَروا الأَملاكَ وَاِنتَزَعوا","ما اِستَحقَبَتهُ بِأَطرافِ القَنا حُقُبا",6,"ب",2,0],["ذُد بِالعَزاءِ الهَمَّ عَن طَلِباتِهِ","لا تُسخِطَنَّ اللَهَ في مَرضاتِهِ",7,"ت",2,1],["ذُدتَ المَطامِعَ عَنهُ بَعدَما شُرِعَت","فيهِ وَجاهَدتَ مَن عاداهُ مُجتَهِدا",8,"د",2,0],["ذُدتَ الحَمِيَّةَ بِالتَقِيَّةِ راغِباً","في الأَجرِ تُغرِبُ في الجَميلِ وَتُبدِعُ",9,"ع",1,0],["ذُدتَ خُطوباً لَوَ اِنَّها نَزَلَت","يَوماً بِطَودٍ أَشَمَّ لَاِنصَدَعا",10,"ع",2,0],["ذُدتَ الخُطوبَ حَديثَها وَقَديمَها","حَتّى لَصارَ حَديثُها مُستَطرَفا",11,"ف",2,0],["ذُدتَهُ وَهوَ عانِسٌ عَن هَواهُ","فَأَتاهُ بَعدَ المَشيبِ الفِطامُ",12,"م",1,0],["ذُدتُّ القَوافي أَن تُذالَ لِباخِلٍ","وَلَها مَرادٌ مِن نَداكَ وَمَنجَعُ",13,"ع",1,0],["ذد الدهر عني من رضاك بعزمة","معودة أن لا يفك رعالها",14,"ل",3,0],["ذد عن حياضك وابشرن فقد دنا","ان صح نيلك كل فخر واهتدا",15,"د",2,0],["ذُدنا فمذ عدِمَ الأنامُ رِعاءَنا","عَدَتِ الذئابُ على السَّوامِ الهاملِ",16,"ل",1,0],["ذُدْتهُ عن لائِذٍ مُسْتعْصِمٍ","بعدما أزْجيْتَه تحتَ العَوالي",17,"ل",2,0],["ذد عن حمى قلبي مغير جفونه","فجفونه نبلٌ لها قلبي هدفْ",18,"ف",1,0],["ذُدتَ الخُطوبَ فأصبَحت أفواهُها","مَغلُولَةَ الأنيابِ والأضراس",19,"س",1,0],["ذدتَ عنيِّ طوارقَ الهمِّ لمّا","حُلْنَ بين الحشا وبين الشِّغاف",20,"ف",1,0],["ذدت عن جلق الهموم فلِم لَم","تنف عنها الفويسق الغدّارا",21,"ر",2,0],["ذُدْ يا ابنَ عيسى الليالي عن موارِدِها","فما تَرَكْنَ لنا علا ولا نَهَلا",22,"ل",2,0],["ذدتم عن الدين الحنيف إذ وَنَى","عن نصرة الإسلام كل خاذل",23,"ل",1,0],["ذدت عن ملكه وقمت بإصلاح أم","ور وراءهن أمور",24,"ر",1,0],["ذُدتَ عَن عَينِيَ الرُقادَ فَلَم تَب","عَث نَشاطاً وَلا شَفَيتَ العَليلا",25,"ل",2,0],["ذُدنا الخَميسَ وَلَم نَفعَل كَفِعلِكُمُ","بِالضَربِ شُذِّبتِ الهاماتُ وَالقَصَرُ",26,"ر",1,0],["ذُدِ النفس أن تصغي إلى قول مُرجئ","فَمنْ لم يكُنْ يهدي إلى سنة يَهذي",27,"ذ",2,0],["ذُدناكم عنه بالأسيافِ مُصْلَتَةً","حتى استمرَّت له في يَثربٍ مِرَرُ",28,"ر",1,0],["ذ درى والأمور باتت صعابا","ولعل المليك يرجي الفكاكا",29,"ك",2,0],["ذُدْ عن حماكَ ونادِ باستقلالهُ","لا ترعَ فيه خواطرَ الحُكّام",30,"م",1,0],["ذُدْ عن حياضِك وانبذ التقبيلا","واسرجْ لنا في الخافقين صَهيلا",31,"ل",2,1]]}