{"poems":[[27,"هاج الهوى وضمير الحاجة الذكر","https://www.aldiwan.net/poem5773.html","البسيط"],[47,"ما لعبيد من الذي","https://www.aldiwan.net/poem25230.html","مجزوء الكامل"],[91,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[33,"ذد الدمع حتى يظعن الحي إنما","https://www.aldiwan.net/poem25847.html","الطويل"],[81,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[144,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[144,"ذد بالعزاء الهم عن طلباته","https://www.aldiwan.net/poem11739.html","الكامل"],[144,"إن لم أقل فيك ما يردي العدى كمدا","https://www.aldiwan.net/poem11753.html","البسيط"],[144,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[144,"دل على المجد من إليه سعى","https://www.aldiwan.net/poem11778.html","المنسرح"],[144,"لله قدرك ما أجل وأشرفا","https://www.aldiwan.net/poem11781.html","الكامل"],[144,"لا تجز في الذي بلغت الأنام","https://www.aldiwan.net/poem11812.html","الخفيف"],[236,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[279,"أما والعيون النجل تصمي نبالها","https://www.aldiwan.net/poem2480.html","الطويل"],[286,"رجب علوت وقد رأى منك العدا","https://www.aldiwan.net/poem39404.html","الكامل"],[459,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[462,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[465,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"]],"verses":[["ذُدنا العَدُوَّ وَأَدنَينا مَحَلَّهُمُ","حَتّى اِبتَنوا بِقِبابٍ بَعدَما اِحتَجَزوا",0,"ز",3,0],["ذُدتُ الأُسودَ عَنِ الفَرا","ئِسِ ثُمَّ تَفرِسُني الضِباعُ",1,"ع",1,0],["ذُدتَني عَنه وَالعَواصِفُ تَعدو","في طِلابي وَالجَوُّ أَقتَمَ أَربَد",2,"د",1,0],["ذُدِ الدَمعَ حَتّى يَظعَنَ الحَيُّ إِنَّما","دُموعَكَ إِن فاضَت عَلَيكَ دَليلُ",3,"ل",1,1],["ذُد عَن مَوارِدِ أَدمُعي طَيرَ الكَرى","وَأَعِد بِنارِ الوَجدِ لَيلِيَ نَيِّرا",4,"ر",2,1],["ذُدْتَ عنها وتقدمتَ خُطاها","يوم قالوا خَسرَ الحربَ فتاها",5,"ه",2,0],["ذُدتَ الأُلى قَهَروا الأَملاكَ وَاِنتَزَعوا","ما اِستَحقَبَتهُ بِأَطرافِ القَنا حُقُبا",6,"ب",2,0],["ذُد بِالعَزاءِ الهَمَّ عَن طَلِباتِهِ","لا تُسخِطَنَّ اللَهَ في مَرضاتِهِ",7,"ت",2,1],["ذُدتَ المَطامِعَ عَنهُ بَعدَما شُرِعَت","فيهِ وَجاهَدتَ مَن عاداهُ مُجتَهِدا",8,"د",2,0],["ذُدتَ الحَمِيَّةَ بِالتَقِيَّةِ راغِباً","في الأَجرِ تُغرِبُ في الجَميلِ وَتُبدِعُ",9,"ع",1,0],["ذُدتَ خُطوباً لَوَ اِنَّها نَزَلَت","يَوماً بِطَودٍ أَشَمَّ لَاِنصَدَعا",10,"ع",2,0],["ذُدتَ الخُطوبَ حَديثَها وَقَديمَها","حَتّى لَصارَ حَديثُها مُستَطرَفا",11,"ف",2,0],["ذُدتَهُ وَهوَ عانِسٌ عَن هَواهُ","فَأَتاهُ بَعدَ المَشيبِ الفِطامُ",12,"م",1,0],["ذُدتُّ القَوافي أَن تُذالَ لِباخِلٍ","وَلَها مَرادٌ مِن نَداكَ وَمَنجَعُ",13,"ع",1,0],["ذد الدهر عني من رضاك بعزمة","معودة أن لا يفك رعالها",14,"ل",3,0],["ذد عن حياضك وابشرن فقد دنا","ان صح نيلك كل فخر واهتدا",15,"د",2,0],["ذُدنا فمذ عدِمَ الأنامُ رِعاءَنا","عَدَتِ الذئابُ على السَّوامِ الهاملِ",16,"ل",1,0],["ذُدْتهُ عن لائِذٍ مُسْتعْصِمٍ","بعدما أزْجيْتَه تحتَ العَوالي",17,"ل",2,0],["ذد عن حمى قلبي مغير جفونه","فجفونه نبلٌ لها قلبي هدفْ",18,"ف",1,0]]}