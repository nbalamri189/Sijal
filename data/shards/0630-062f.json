{"poems":[[27,"هاج الهوى وضمير الحاجة الذكر","https://www.aldiwan.net/poem5773.html","البسيط"],[47,"ما لعبيد من الذي","https://www.aldiwan.net/poem25230.html","مجزوء الكامل"],[91,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[33,"ذد الدمع حتى يظعن الحي إنما","https://www.aldiwan.net/poem25847.html","الطويل"],[81,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"]],"verses":[["ذُدنا العَدُوَّ وَأَدنَينا مَحَلَّهُمُ","حَتّى اِبتَنوا بِقِبابٍ بَعدَما اِحتَجَزوا",0,"ز",3,0],["ذُدتُ الأُسودَ عَنِ الفَرا","ئِسِ ثُمَّ تَفرِسُني الضِباعُ",1,"ع",1,0],["ذُدتَني عَنه وَالعَواصِفُ تَعدو","في طِلابي وَالجَوُّ أَقتَمَ أَربَد",2,"د",1,0],["ذُدِ الدَمعَ حَتّى يَظعَنَ الحَيُّ إِنَّما","دُموعَكَ إِن فاضَت عَلَيكَ دَليلُ",3,"ل",1,1],["ذُد عَن مَوارِدِ أَدمُعي طَيرَ الكَرى","وَأَعِد بِنارِ الوَجدِ لَيلِيَ نَيِّرا",4,"ر",2,1],["ذُدْتَ عنها وتقدمتَ خُطاها","يوم قالوا خَسرَ الحربَ فتاها",5,"ه",2,0]]}