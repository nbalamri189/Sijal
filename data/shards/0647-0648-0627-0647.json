{"poems":[[57,"وحدثتني يا سعد عنها فزدتني","https://www.aldiwan.net/poem26390.html","الطويل"],[87,"آل زغلول حسبكم من عزاء","https://www.aldiwan.net/poem62833.html","الخفيف"],[64,"ألم ترني أبحت حريم مالي","https://www.aldiwan.net/poem52302.html","الوافر"],[47,"هواها على أن الصدود سبيلها","https://www.aldiwan.net/poem65583.html","الطويل"],[71,"أحب لوجنتيه الجمرتين","https://www.aldiwan.net/poem28936.html","الوافر"],[119,"من الهوى آه","https://www.aldiwan.net/poem40430.html","عموديه"],[119,"تمحضني النصيحة يا عذولي","https://www.aldiwan.net/poem40923.html","عموديه"],[139,"كما عاذل في عادل القد لام","https://www.aldiwan.net/poem49130.html","السريع"],[185,"إلى أى حين أنت ضارب غمرة","https://www.aldiwan.net/poem58865.html","الطويل"],[214,"شد المناطق يثني عطف مخمور","https://www.aldiwan.net/poem13307.html","البسيط"],[214,"اذكرني البرق في تبسمه","https://www.aldiwan.net/poem13546.html","المنسرح"],[215,"وفاء بعهدي أو تزولا على وعدي","https://www.aldiwan.net/poem46570.html","الطويل"],[242,"وعيشك والسماء وما بناها","https://www.aldiwan.net/poem19739.html","الوافر"],[275,"بكت لفتى يفني قواه تعمدا","https://www.aldiwan.net/poem35632.html","الطويل"],[276,"كم ذا أراها نحو طيبة ترتمي","https://www.aldiwan.net/poem52047.html","الكامل"],[369,"بدا في فرعك الوخط","https://www.aldiwan.net/poem60858.html","الهزج"],[369,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[409,"يا جيرة في القلب مأواهم","https://www.aldiwan.net/poem33406.html","السريع"],[415,"أجيرة قلبي إن تدانوا وإن شطوا","https://www.aldiwan.net/poem32447.html","الطويل"],[463,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[519,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[519,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[567,"هذا فؤاد الدولة السامي الذي","https://www.aldiwan.net/poem52579.html","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70722","الخفيف"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67838","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67843","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67828","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62559","المجتث"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62555","الوافر"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35355","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112781","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/114005","الوافر"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102153","الطويل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143015","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120967","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93898","الخفيف"],[3142,"","https://poetry.dctabudhabi.ae/diwan/poem/74145","الرجز"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216569",""],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46831","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74066","الخفيف"],[3782,"","https://poetry.dctabudhabi.ae/diwan/poem/124268","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114198","المجتث"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77089","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90798","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83490","البسيط"],[4578,"","https://poetry.dctabudhabi.ae/diwan/poem/114614","الوافر"],[4578,"رنا إلي بعينيه فقلت رشا","https://www.poetsgate.com/ViewPoem.aspx?id=49448",""],[4927,"قصيدة الثورة على الشبيحة","https://www.poetsgate.com/ViewPoem.aspx?id=79601",""],[5122,"يابعد عمري تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=18066",""],[2110,"هلال حسن هل يا من يراه","https://www.poetsgate.com/ViewPoem.aspx?id=156288",""],[5725,"عشق صوفي","https://www.poetsgate.com/ViewPoem.aspx?id=186860",""],[5957,"حبي الكبير","https://www.poetsgate.com/ViewPoem.aspx?id=12485",""],[5997,"ملاذ الهم","https://www.poetsgate.com/ViewPoem.aspx?id=214250",""],[5997,"على مرأى ومسمع","https://www.poetsgate.com/ViewPoem.aspx?id=214462",""],[6045,"مكياج مطر","https://www.poetsgate.com/ViewPoem.aspx?id=125355",""],[6147,"مشروع حلال","https://www.poetsgate.com/ViewPoem.aspx?id=151492",""],[6300,"مصير آخر فارس عربيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82875&r=&rc=46",""],[5190,"إحساس شاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85055&r=&rc=130",""]],"verses":[["هَواها هَوىً لَم يَعلَمِ القَلبُ غَيرَهُ","فَلَيسَ لَهُ قَبلٌ وَلَيسَ لَهُ بَعدُ",0,"د",1,0],["هُوَ أَهلٌ لِأَن يُرَدَّ لِقَومي","أَمرَهُم في حَقيقَةِ اِستِقلالِه",1,"ل",2,0],["هواهُ أقرَّ بالمكروهِ عيني","وعلَّمني التعلُّلَ بالمحالِ",2,"ل",1,0],["هَواها عَلى أَنَّ الصُدودَ سَبيلُها","مُقيمٌ بِأَكنافِ الحَشا ما يَزولُها",3,"ل",3,1],["هواهُ أفادَني شيباً وسهداً","حملْتهما على رأسي وعيني",4,"ن",2,0],["هواه افناني","من الهوى آه",5,"ا",2,0],["هواه اقر في كلي سقامي","وما انا كالسقيم على الفراش",6,"ش",1,0],["هواه مستَولٍ على مهجتي","وحبّه في دارِ قلبي أقامْ",7,"م",1,0],["هَوَاها هَوىً قَد عَادَ مَكنُونُهُ جَوىً","ومَرعىً لِبَاغِى الخَيرِ مِن وَصلِهَا جَدبُ",8,"ب",1,0],["هواه لي مطلب غارت موانعه","لأن من خصرة لي باب تغوير",9,"ر",1,0],["هواه يا صاح كيف استره","والدمع بالخد سال احمره",10,"ه",1,0],["هواه على أجراف دجلة وافدٌ","وأما هوى قلبي فللنيل والوفد",11,"د",1,0],["هَوَاهَا أَنْ تَرَاهُ أَوْثَرَاهُ","فَلاَ يَنْفَكُّ مُنْتَشِقاً ثَرَاهَا",12,"ا",3,0],["هواها هوى بي خاضعاً متذلِّلاً","على أنّني أُدعى الفتى المتمرِّدا",13,"د",2,0],["هو أَهل دين اللَه لما اِختاره","داع إِلى الدين الحَنيف القيم",14,"م",1,0],["هَواهُ الدَهرَ كَالسابِ","قِ دانى خَطوَهُ الرَبطُ",15,"ط",1,0],["هو أَهدَى فِكْراً وأَشرَفُ ألفا","ظاً وأعلَى رأياً وأثقَبُ زَنْدا",16,"د",2,0],["هواهم أخرجني مكرهاً","من بين إخوان ألفناهم",17,"م",1,0],["هَواهُم هَوىً لا البعدُ يُبْلي جَديدَه","لدَيْنا ولا عَالِيهِ بالهجر يَنْحَطُّ",18,"ط",1,0],["هواها وراءٌ والسُرى من أمامها","فهنَّ صحيحاتُ النواظر حُولُ",19,"ل",1,0],["هَواهُ ديني وإيماني ومُعتقَدي","وحبُّ عِترتهِ عَوني ومُعتصمي",20,"م",2,0],["هَواهُ إلى المديحِ كما دعَتْني","كذا التشبيبُ فيها قد دَعاني",21,"ن",2,0],["هُوَ أهلُ ذاكَ وفوقَ ذاكَ إلى مَدَى","ما ليسَ يستوفيهِ ضربُ الحاسبِ",22,"ب",1,0],["هو أهلُ الندى وحَتفُ الأعادي","وهْو ليثُ الوغى وغيث العِطاشِ",23,"ش",1,0],["هَوَاهُ بِقَلْبي قَدْ أقَامَ وَعَرَّسَا","وَشَيَّدَ بُنْيَانَ الْغَرامِ وَأسَّسَا",24,"س",2,0],["هَوَاهُ مُقِيمٌ بَيْنَ أحْشَايَ قَدْ دُفِنَ","وآدَمُ بَيْنَ الطِّينِ وَالْمَاءِ قَدْ عُجِنْ",25,"ن",1,0],["هَوَاهُمْ لِقَلْبي مُتْعِبٌ لاَ يُرِيحُهُ","وَصَبْرِيَ مَيْتٌ وَالْفُؤَادُ ضَرِيحُهُ",26,"ه",1,0],["هواه نيل المعالي","بالبذل يكسب حمدا",27,"د",2,0],["هواه لم يزل في القلب حتى","بعبد القادر اعتُقلت عُراهُ",28,"ا",2,0],["هَواهُنَّ ما بَينَ الحَجونِ مُخَيِّمٌ","وَبينَ أثيلاتِ العَقيقِ دَروجُ",29,"ج",1,0],["هواه من الأهوال في الحشر جنة","وجنة تعجيل هنا سامعي فعى",30,"ع",2,0],["هواها قد غُذيتُ بهِ صغيراً","وهَل للنفسِ عن غِذاها",31,"ا",3,0],["هواهُ لهُ أصمى وأودى بعقلهِ","تخلُّصُهُ بالسيِّدِ الطهر اوفَقُ",32,"ق",1,0],["هواه في حال يعا","ني من وجاع المولد",33,"د",1,0],["هُوَ أهلُهُ سُبحَانَهُ وَبِحَمدِهِ","كُلُّ المَحَامِدِ وَصفُ ذِي الإِحسَانِ",34,"ن",1,0],["هواه هوى ينهاه عن كل ريبة","ويلحقه بالسابقين أولي النّهى",35,"ه",2,0],["هو أهل الثناء والمجد جدا","وأخو الفخر والعلا والسياده",36,"د",2,0],["هَواه قَد تحكم","في وسط جؤجؤي",37,"ي",1,0],["هواه يْقَوّي القَلْب والحَالْ","ومِهواة غيره تَضعِف الحيل",38,"ل",1,0],["هَواها جَل في خَلَدي","فَيَا ما أُودِعَ الخَلَدُ",39,"د",1,0],["هُوَ أَهل لنا وَجار عَزيز","إِن تعدّوا الأَهلين وَالجيرانا",40,"ن",2,0],["هواها من أهواء النساء عوضٌ ولم","يجُز جمعُ تعويضٍ وما منه عوضا",41,"ض",2,0],["هَوَاهُ حَاجَةُ نَفسٍ","تُقضَى بِفَضلٍ وَتُجرَى",42,"ر",2,0],["هَواهُم حَياتي وَهوَ أَقول حُجَّتي","فَلا مَيلَ عَنهُم وَاِصلَونِيَ أَوصَدوا",43,"د",3,0],["هواها هوى بي في الهوان وقادني","على الرغم مني لاقتحام الملاحم",44,"م",1,0],["هواه ديني فَقُل ما شِئتَ من سَفهٍ","يا مدّعي الحبّ قولاً غير مكذوبِ",45,"ب",1,0],["هواها قد غدا لي ذل دنيا","كما امسى سعيد عزَّ دين",46,"ن",1,0],["هواه ران على قلبي فليس لهُ","قبول عذلٍ وقد أمسى عليه غشا",47,"ش",2,0],["هَوَاْهَاْ هَوَاْهَاْ فِي الْعُرُوْقِ مُوَحَّدٌ","فَفِيْهَاْ غَرَاْمُ الشَّاْمِ شَقَّ السَّوَاْقِيَاْ",48,"ي",2,0],["هواه اللي صخرني له وأنا اللي","قبل معروف في كثر انفعالي",49,"ل",2,0],["هواه ديني والثنا مذهبي","وحبه فوزي وسعدي رضاه",50,"ا",2,0],["هواهم في فؤادي غير بالِ","نزيل حيثما رحلوا ببالي",51,"ل",2,1],["هواهُ لقلبي فصول الأغاني","كشدو الطيور بسمعي يسير",52,"ر",1,0],["هواها في دمي يسري","هواها في عروق الدم",53,"م",1,0],["هواها في مساماتي هواها","وفي مجرى دمي بحراً ومنبع",54,"ع",1,0],["هواها رُضابٌ سكِرنا به","حلالٌ ! فلا تعذلوا من سكر",55,"ر",1,0],["هواها لم يُثِر.. فلم الدلالُ","ومن أين الجوابُ ولا سؤال؟",56,"ل",1,1],["هواهُ على دَرْبِ الملذات سائرٌ","يعانقُ ذنْبًا أو يرومُ جهنّما",57,"م",2,0],["هواها مِدادِي ، نيلُها العذبُ في دمِي","وأنسامُها العطرُ الذي فاحَ في المَدى",58,"د",2,0]]}