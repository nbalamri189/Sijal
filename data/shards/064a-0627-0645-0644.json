عموديه"],[464,"شف قلبي دلاله","https://www.aldiwan.net/poem3358.html","عموديه"],[468,"ماذا رميت به من","https://www.aldiwan.net/poem59755.html","المجتث"],[477,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[479,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[495,"حديقة الجو غضي هذه الحدقا","https://www.aldiwan.net/poem10251.html","البسيط"],[495,"يا ملك الشرق عمدة الدول","https://www.aldiwan.net/poem10262.html","المنسرح"],[495,"لو كان بالدهر لحر يدان","https://www.aldiwan.net/poem10281.html","السريع"],[500,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[515,"يا ملكاً ساحة أبوابه","https://www.aldiwan.net/poem12248.html","السريع"],[529,"رب إني مستعين","https://www.aldiwan.net/poem37115.html","مجزوء الرمل"],[551,"يا مليح الوجه لم فعلك","https://www.aldiwan.net/poem47890.html","مجزوء الرمل"],[551,"يا مليك الورى ومن عقد الله","https://www.aldiwan.net/poem48114.html","الطويل"],[575,"يا ملكاً لا يلتقي أمره","https://www.aldiwan.net/poem2717.html","السريع"],[575,"ما ضر من أهدى إلي الخيال","https://www.aldiwan.net/poem3039.html","السريع"],[575,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"],[575,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[586,"كيف يصغي لعاذل أو يميل","https://www.aldiwan.net/poem17641.html","الخفيف"],[586,"ملبسي من هجره ثوب الضنى","https://www.aldiwan.net/poem17787.html","الرمل"]],"verses":[["يا مُلبِسي النُعمى الَّتي أَورَقَت","عودي مِراراً وَكَسَت أَعظُمي",0,"م",2,0],["يا مَليكَ المُلوكِ والى لَكَ النَص","رَ عَلى العالَمِ الَّذي وَلّاكا",1,"ك",2,0],["يا مُلبِسي النِعَمَ القَديمَ لِباسُها","جَدَّد عَلَيَّ نَضارَةَ الأَثوابِ",2,"ب",1,0],["يا مُلْبِسي ثوْبَ السَّقامِ وتارِكي","بيْنَ الأُوامِ وبيْنَ حَرِّ ضُلوعي",3,"ي",1,0],["يَا مُلْبِسِي النُّعْمَى بِأَيِّ عِبَارَةٍ","أَصِلُ الثَّنَاءَ لِمُلْكِكَ الْمُتَفَضِّلِ",4,"ل",1,0],["يا مُلْبِسَ الأوْراقِ منْ نورِ الهُدى","حُلَلَ الجَمالِ تلألقَتْ أنْوارُهُ",5,"ر",2,0],["يا مَليكاً بِرَغمِهِ يُلبَسُ التا","جَ وَيَرقى لِعَرشِهِ مَملوكا",6,"ك",2,1],["يا مَليكَ الدُنيا الَّذي أَعظَمَ الل","هُ بِتَأييدِ عِزِّهِ سُلطانَه",7,"ن",2,1],["يا ملكَ الدُنيا الَّذي سخطُهُ","يُفني وَجَدوى كَفِّهِ تُغني",8,"ن",2,1],["يَا مَلِيكَ القُلُوبِ يَحْفَظُكَ اللهُ","وَيَرْعَاكَ يَا مَلِيكَ القُلُوبِ",9,"ب",1,1],["يَا مُلْهِمَ الشِّعْرِ هَبْ لِي مِنْكَ مُسْعِدَةً","لا تَغْلِبَنِّي عَلَى الإِلْهَامِ أَشْجَانِي",10,"ن",2,0],["يَا مَلِيكَ الكِنَانَةِ اسْلَمْ وَصَرِّفْ","كُلَّ مَاضِي رَأْيٍ وَنَاضِي حُسَامِ",11,"م",1,0],["يَا مَلِيكِي كَيْفَ اقْتَحمْتَ حِمَاهَا","فِي الدَّيَاجِي وَمَا خَشِيتَ انْتِقَامَا",12,"م",2,0],["يَا مَلِيكاً أَجْرَى عَلَى الرِّيفِ أل","طَافاً وَزَكَّى ألطافَهُ إِلمَامَا",12,"م",2,0],["يا مليح يكفاك من التيه","ما طلبت غر كتيّب",13,"ب",1,0],["يا ملجأَ الخلق المشفَّعِ فيهمُ","يا رحمةَ الأمواتِ والأحياءِ",14,"ا",2,0],["يا مليكاً علا على الشمسِ حتَّى","عمَّ إحسانهُ عمومَ الضياء",15,"ا",2,0],["يا مليكاً له صنائع برٍّ","وتقًى يدفعانِ صدرَ الخطوب",16,"ب",1,0],["يا ملكاً تقصرُ عن وصفه","بدائعُ الشعر والكاتب",17,"ب",1,1],["يا ملاذي الغوث من عائلةٍ","ليسَ من تكليفِهم لي مهرب",18,"ب",1,1],["يا مليحاً صدغاه قبلةُ حسن","سجدت نحوها وجوهُ الملاح",19,"ح",1,0],["يا ملاذ العفاة دعوة عبدٍ","مستغيثٍ من الزمان مجَاح",19,"ح",1,0],["يا ملكاً أصبح في الدين والد","نيا سعيدَ الجد والاجتهاد",20,"د",1,0],["يا مليحاً طرفي به في نعيم","وفؤادِي في النارِ ذات الوقود",21,"د",1,0],["يا مليكَ النوالِ والعلم لا زل","تَ سرِيّ الثناء في كلّ قطر",22,"ر",1,0],["يا ملكاً يلقى المنى والعدى","بضعف ما ترضى وما تكره",23,"ر",2,0],["يا مليكاً أحيى الثنا والعطايا","فجلبنا لسوقه الأشعارا",24,"ر",2,0],["يا مليكاً أحمل المدح له","وعجيب حاملٌ دُرَّا لبحر",25,"ر",1,0],["يا مليكاً تنظرُ الشهب له","مثلما تنظر للشهب الورى",26,"ر",2,1],["يا مليكاً به الدهر يرضى","وبآرائهِ الخطوب ترَاض",27,"ض",1,1],["يا مليكاً سقى نداه نباتاً","زاكياً زرع حمده في الزروع",28,"ع",1,0],["يا ملبسي عندَ إحرام الأكابر لي","زهراً كأنَّ لها حجِّي وإحلالي",29,"ي",1,0],["يا ملاذ الأنام هنَّاك الل","ه بعيدٍ مبارك ميمون",30,"ن",1,1],["يا مليحاً كلما زدت خض","وعاً زادَ تيها",31,"ه",2,1],["يا مليكاً خصَّه الل","ه بأوصافٍ سنيَّه",32,"ي",2,0],["يا مليكاً يجبر قصَّادهُ","جبراً له الله مكافٍ عليه",33,"ي",2,1],["يا مُلقي الرُّدن على وجهه","لقد تَخَمَّرْتَ على عار",34,"ر",1,0],["يا مُلبِسي ثَوبَ الضَنا","يَهنيكَ ثَوبُ العافِيَه",35,"ي",2,0],["يا مَليحاً لِيَ مِنهُ","شُهرَةٌ بَينَ البَرايا",36,"ا",3,1],["يا مَليحاً أَنا مِنهُ","بَينَ هِجرانٍ وَبَينِ",37,"ن",1,0],["يا مَلِكا قَد أَصبَحت كَفُّهُ","ساخِرَةً بِالعارِضِ الهاطِلِ",38,"ل",1,1],["يا مليكا شاد فينا","مثل ما شاد الخليل",39,"ل",1,1],["يا ملوك المال فيما زعموا","هل ملكتم خطرات من هواء",40,"ا",2,0],["يا مُلتَقى القَمَرَينِ ما أَبهاكَ بَل","يا مَجمَعَ البَحرَينِ ما أَصفاكا",41,"ك",2,0],["يا مَلاكَ الفُلكِ لي صِن","وُكِ في تِلكَ المَدينَه",42,"ن",2,0],["يا مَلِكاً لَم تَضِق","ساحَتُهُ بِالأُمَم",43,"م",1,0],["يا مَلَكاً تَعَبَّدا","مُصَلِّياً مُوَحِّدا",44,"د",2,1],["يا مُلَقّى النَصرِ في أَحلامِهِ","أَينَ مِن وادي الكَرى سَنتِ هِلين",45,"ن",1,0],["يا مَليكَ الوَرى المُفَرِّقَ مَحياً","وَمَماتاً فيهِم وَعِزّاً وَذُلّا",46,"ل",2,0],["يا مَليكاً لِلمالِ مِنهُ نَفادٌ","وَلِآرائِهِ الشِرافِ نُفوذُ",47,"ذ",1,0],["يا مُلبِسي القَلبِ ثَوبَ الحُزنِ بَعدَهُمُ","حُزني قَشيبٌ وَصَبري بَعدَكُم سَمِلُ",48,"ل",1,0],["يا مَليكاً بِذِكرِهِ يَفخَرُ المَد","حُ وَيَسمو الإيرادُ وَالوُرّادُ",49,"د",1,1],["يا مَليكاً إِذا عُزيتَ لِفَخرٍ","كانَ مِن بِرِّهِ وُجودي وَجودي",50,"د",2,0],["يا مَليكاً قَد طابَ أَصلاً وَفَرعاً","وَزَكَت مِن أُصولِهِ الأَعراقُ",51,"ق",1,1],["يامَلِكاً فاقَ المُلوكَ وَرَعاً","إِن شانَ أَهلَ المُلكِ طَيشٌ وَرَعَن",52,"ن",1,0],["يامَلِكاً يَرى العَدُوَّ قُربَهُ","كَالأَجَلِ المَحتومِ في اِقتِرابِهِ",53,"ب",2,0],["يا مَلِكاً يَعتَذِرُ الدَهرُ لَهُ","وَتَخدُمُ الأَيّامُ في رِكابِهِ",53,"ب",2,0],["يا مَليكاً إِذا بَكى","عَبدُهُ في الهَوى ضَحِك",54,"ك",1,0],["يا ملزمَ الشعرِ أمرَ الشرعِ دونَ ريا","أما تحاذرُ فيمنْ وازنوكَ ربا",55,"ب",2,0],["يا مُلْهَمَاً جَابَ الحياةَ مُسَائِلاً","عَنْها، وعَمَّا أَلْهَمَتْ مَسْؤُولا",56,"ل",2,0],["يامُلتَقى الخ