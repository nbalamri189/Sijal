//poetry.dctabudhabi.ae/diwan/poem/134267","المتقارب"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105179","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104904","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139729",""],[4764,"بنات الموج","https://www.poetsgate.com/ViewPoem.aspx?id=24783",""],[5045,"شعاري المجد","https://www.poetsgate.com/ViewPoem.aspx?id=184874",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5122,"تدلل","https://www.poetsgate.com/ViewPoem.aspx?id=17971",""],[5183,"حفظ الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=180286",""],[5190,"آخر فرصة","https://www.poetsgate.com/ViewPoem.aspx?id=76954",""],[5206,"أرى العدل عن لوم العذول هو العدل","https://www.poetsgate.com/ViewPoem.aspx?id=149039",""],[4045,"أأحزنك الأولى ردّوا","https://www.poetsgate.com/ViewPoem.aspx?id=200274",""],[5288,"الزمان غروب","https://www.poetsgate.com/ViewPoem.aspx?id=1152",""],[5409,"أصقر تهامة والأبطحين","https://www.poetsgate.com/ViewPoem.aspx?id=155485",""],[5582,"أَلا حَيِّ مِنْ دارِ سُعْدَى مُقامَا","https://www.poetsgate.com/ViewPoem.aspx?id=63572",""],[5616,"أغنيةُ صمودٍ للمخيَّمِ الفلسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=205219",""],[5730,"قوي في الحقيقة غير أني","https://www.poetsgate.com/ViewPoem.aspx?id=212809",""],[5956,"يتدفق اليخضور","https://www.poetsgate.com/ViewPoem.aspx?id=182038",""],[5956,"حدْسي قال لي","https://www.poetsgate.com/ViewPoem.aspx?id=182219",""],[5956,"يا كوكب العلم","https://www.poetsgate.com/ViewPoem.aspx?id=194140",""],[5956,"من بعد دعمك حاجتي يا مسلمُ","https://www.poetsgate.com/ViewPoem.aspx?id=194143",""],[5956,"سقطَ الجنينُ من بطنِ آنَ الحنون","https://www.poetsgate.com/ViewPoem.aspx?id=207114",""],[5970,"الليل جن فأسرعا","https://www.poetsgate.com/ViewPoem.aspx?id=130586",""],[231,"سر انتصار الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79164&r=&rc=38",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[2220,"تباركَ الله هل بالدار من أحد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11665&r=&rc=539",""],[6327,"لامية الهمج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86571&r=&rc=6",""]],"verses":[["قَوَّى مَعَاقِلَهَا وَدَرَّبَ نَشْأَهَا","فَبَنَى لَهَا جُدُراً مِنَ الأَرْكَانِ",0,"ن",1,0],["قويمة تمنع الإسلام من خطرٍ","فأعجب لها ألفات وهي لامات",1,"ت",1,0],["قوَّيتَ قوتِي وقوتَ عائلتي","في زمنٍ للضعيفِ ممقوت",2,"ت",1,1],["قَوِيَت بَهجَتُها","وَتُسَمّى مُضعَفَه",3,"ف",2,0],["قَوِيَّةُ العَزمِ في إِتلافِ عاشِقِها","ضَعيفَةُ الخَصرِ وَالأَلحاظِ وَالبَشَرَه",4,"ر",2,0],["قويٌّ غَلُوبٌ كسِحْرِ الجُفُونِ","شجيٌّ لَعوبٌ كزهرٍ حَزينْ",5,"ن",1,0],["قَوِيٌّ أَمينٌ لِاِبنِ يوسُفَ مُجزِئٌ","بِطاعَتِهِ عِندَ الَّذي قَد تَحَمَّلا",6,"ل",2,0],["قَويُّ السَطا لَو خاصَمَ الدَهرُ بَأسَهُ","غَدا خاسِراً في دِرعِهِ المُتَمَزِّقِ",7,"ق",1,0],["قَوِيٌّ إِذا لانوا سَريعٌ إِذا وَنوا","صَؤولٌ إِذا كَرّوا ثَبوتٌ إِذا فَرّوا",8,"ر",3,0],["قُوى البلادِ تُعينُ العاملينَ بها","وما لها من وُلاةِ الأمرِ أعوانُ",9,"ن",1,0],["قُوى أَيديهُمُ وَقُوى نُهاهُم","كِلا الأَمرَينِ عُدَّةُ كُلِّ شانِ",10,"ن",1,0],["قُوىً تَنصبُّ مُمعنةً حِثاثاً","وللدَّمِ في مَواقِعها انصبابُ",11,"ب",1,0],["قُويتُ عَلى الهُجرانِ حَتّى مَلَلتَني","وَلَكِنَّني عَن حَملِ هَجرِكَ أَضعَفُ",12,"ف",1,1],["قَوِيّانِ عَزّاني عَلَيهِ وَأَوقَعا","بِغَيرِيَ ما بي أَوقَعاهُ فَعَزّاني",13,"ن",2,0],["قُوَيْرِحِ أعْوَامٍ رَفِيعٍ قَذَالُهُ","يَظلُّ يَبُزُّ الكَهْلَ والكَهْلُ يَطْمَحُ",14,"ح",1,0],["قَوِيُّ المَشِيئَةِ نَفَّاذُهَا","بِمَاضٍ مِنَ العَزْمِ لا يُثْلَمُ",15,"م",1,0],["قَوِيُّ عَزْمٍ وَلَكِنْ","تَدْرِي المَكَارِمُ ضَعْفَهْ",16,"ف",2,0],["قَوِيٌّ أمِينٌ لابنِ يُوسُفَ مُجزِىءٌ","بطاعَتِهِ عِندَ الّذي قد تَحَمّلا",17,"ل",2,0],["قُويفٍ لِلمُرِّيِّدِ ذُو شَيَيخٍ","دُوَىٍّ في قُبَييِّلِه عُلَيلِ",18,"ل",1,0],["قويٌّ لا يخادع في اعتقادٍ","يدين به الإِله ولا يصدُّ",19,"د",1,0],["قَوِيَ المُصطفى بصحبٍ بلِ الصح","بُ بهِ بل بربّه أقوياءُ",20,"ا",2,0],["قويت فتنة المِلاح على الدِّي","ن فما تصنع القلوب الضِّعافُ",21,"ف",1,0],["قَوِيّ إذا الأبطالُ طالَ كِفاحُها","فلا بَطَلٌ يَوْمَ الكِفاحِ لَهْ يَقْوى",22,"و",2,0],["قوى الأرواح فوقَ قوى سلاحٍ","فرنجيٍّ يُعدُّ لمشرفي",23,"ي",1,0],["قَوِيُّ النُهوضِ بِعِبءِ العَروضِ","وَلَم يَكُ في النَحوِ يَخشى التِباسا",24,"س",2,0],["قُوى جاشِ كَمي في شَجاعَتِهِ","ما مِثلِهِ مِن نَبي في مَهابَتِهِ",25,"ه",1,0],["قُوَيرِحَ أَعوامٍ كَأَنَّ لِسانَهُ","إِذا صاحَ حِلوٌ زَلَّ عَن ظَهرِ مِنسَجِ",26,"ج",1,0],["قوي الميل احياناً","ونضو الضعف في حين",27,"ن",1,0],["قَوِيٌّ بِخَدّي مِن هُمومٍ بِمَفرَقٍ","ضَعيفٌ بِكَفّي مِن دُموعٍ بِسائِلِ",28,"ل",1,0],["قُوَى نفسِه فكرٌ وفهمٌ وبَعدَه ال","إرادةُ في عقلٍ رصينٍ أخي لطف",29,"ف",1,0],["قوي على كسب الذنوب وإنني","على الباقيات الصالحات ضعيف",30,"ف",1,0],["قَويتَ فنصرتَه","وحدُّك المضعَّفُ",31,"ف",1,0],["قويمٍ على عرك الخطوب فما له","وقد زحمته زحمةٌ يتطوَّحُ",32,"ح",1,0],["قويّاً على ظلمي بسيفِ عدوّكم","وعهدي به بالأمس وهو يخيبُ",33,"ب",1,0],["قويَّةُ السُّلْطانِ في مُدْنِها","ضعيفةٌ إنْ ضَمَّها سَمْلَقُ",34,"ق",1,0],["قوى قدومك ضعف كل عزيمة","وسددت ثلماً ليس بالمسدود",35,"د",1,0],["قويهم مغرى باكل ضعيفهم","سجية وحش بالفريسة ضاري",36,"ر",2,0],["قويق لقد غصصتَ بكوزِ ماءٍ","يُبَلُّ الحلقُ منه بل حُلَيْقُ",37,"ق",1,1],["قويقُ إذا شمَّ ريحَ الشتاءِ","تُشَمُّ الخلافةُ من جَيْبِهِ",38,"ه",1,1],["قويقُ إذا شمَّ ريحَ الشتاءِ","أظهرَ تيهاً وكبراً عجيبا",39,"ب",2,1],["قويقٌ له عهدٌ لدينا وميثاقُ","وهذي العهودُ والمواثيقُ أطْواقُ",40,"ق",1,1],["قويقٌ رسيلُ الغيثِ يأتي وينقضي","ويأبى انسياقاً تارة ثم ينساق",40,"ق",1,0],["قويق على الصفراءِ ركِّبَ جسمُهُ","رُباه بهذا شُهَّدٌ وحدائقُهْ",41,"ه",1,1],["قَويّ الجَنانِ فَصيحُ اللّسان","بِسحرِ البيانِ يَزينُ الحِكمْ",42,"م",1,0],["قويٌّ على نَقْلِ الملام للُؤْمِهِ","ضَعيفٌ به عن كلِّ صالحةٍ وَهْطُ",43,"ط",1,0],["قوى عيوني هرشل في سعيه","قصد اجتلاء مجرة وشماك",44,"ك",1,0],["قويُّ عزمٍ إذا خطبٌ ألمَّ على","أملاكها رَدَّه قسراً وثقلَها",45,"ل",3,0],["قويم أخي عشرين لا الطيشُ شأنه","ولا قِصرٌ أزرى به في المُركَّب",46,"ب",1,0],["قَوِيمُ القَدّ هَزَّ العِطْفَ كَيْمَا","يُجِيدَ ال