dules.php?name=Sh3er&doWhat=shqas&qid=60310&r=&rc=366",""],[5190,"شَهد وسُهد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85035&r=&rc=110",""],[6343,"إبتسامات دامعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1970&r=&rc=0",""]],"verses":[["تَحُطُّ رَحائِلَها بِالمُقامِ","وَتُلقي أَزِمَّتَها بِالصَفا",0,"ا",1,0],["تُحَطِّمُهُ تَحتَ الجَليدِ فُؤوسُها","إِذا قَفَّعَ المَشتى أَكُفَّ الحَواطِبِ",1,"ب",1,0],["تُحَطُّ رِحالُ الراغِبينَ إِلى فَتىً","نَوافِلُهُ نَهبٌ لِمَن يَتَطَلَّبُ",2,"ب",1,0],["تَحَطَّمَ عَنها قَيضُها عَن خَراطِمٍ","وَعَن حَدَقٍ كَالنَبخِ لَم يَتَفَتَّقِ",3,"ق",1,0],["تحط كما حط العقاب من الذرى","وتلتهم الأفنان والزغب والوكرا",4,"ر",2,0],["تحطّمُ السمرَ في الأبطال إن طَعنَتْ","وساقَها للمنايا سائقٌ حُطَمُ",5,"م",1,0],["تحطّمُ مُرّانَ الرّماحِ كماتُهُ","طعاناً وأوراقَ الصِفاح ضرابا",6,"ب",2,0],["تَحُطُّ سُطورَ الضَربِ في صَدرِهِ الظُبى","وَيَعجِمُها وَخرُ المُثَقَّفَةِ السُمرِ",7,"ر",1,0],["تَحُطُّ قِناعَها وتخوضُ فيها","فوارسَ بالحديدِ مُقَنَّعينا",8,"ن",2,0],["تَحُطُّ عَنهُ لَآتٍ بَعدَهُ أَبَداً","فَلا تُبيدُ وَلا تَثني خَواليها",9,"ي",3,0],["تحط إن شاءتْ على شَعْرها","أو.. لا.. ففوق البؤبؤ ِ الأخضر ِ.",10,"ر",1,0],["تَحطمنا المَنايا حَيث جاءَت","وَنَحنُ في اِحتِيالهم اِحتِيالي",11,"ل",2,0],["تحطمهم أعرابها بسيوفهم","إذا اخذوا شيئاً على أحد بغيا",12,"ي",2,0],["تَحُطُّ وَتَذْرِي عن مَنَابِرِهَا اسْمَهُ","وسِيمَاهُ صِلاً في عَوَادِيهِ أو لِصَّا",13,"ص",2,0],["تحطّم حتى لو أن الهوان","تجسّم كان مثال الهوان",14,"ن",1,0],["تحطّك رأفةٌ شملَتْ ورقَّتْ","وترْفَعُكَ الأُبوَّة والجلال",15,"ل",1,0],["تَحُطُّ رحالَها فيه الأماني","وتعنيه المدائح من بعيد",16,"د",1,0],["تَحُطُّ به النّعائِمُ مُتْأَقَاتٍ","تَرَجْرَجُ فوقَ أَعناقِ النُّعامى",17,"م",2,0],["تحطمت الأصنام مذ شاع ذكره","وحلت على نسرٍ بمبعثه البلوى",18,"و",2,0],["تحطّ بماءٍ للندى مترقرقٍ","مَعينٍ وواد للسماح مَريعِ",19,"ع",1,0],["تُحطَمُ الذُّبَّلُ الصِّعَادُ ويَسرِي","صدأ السيف وهو ماضٍ طريرُ",20,"ر",1,0],["تُحَطُّ إليه وهي قُلْبٌ من الطَّوَى","وتُركَبُ عنه وهي مُجفَرَةٌ قُبُّ",21,"ب",1,0],["تَحُطُّ أَبا الفَرخِ عَن وَكرِهِ","وَتَستَنزِلُ الطَيرَ مِن لوحِهِ",22,"ح",2,0],["تحطم منها ساعد ومساعد","فأمست وما يرجى لجبر كسيرها",23,"ر",3,0],["تحطو به عيرانة","كالهِقل أو جَرداء شرمح",24,"ح",1,0],["تَحط من رتبته","تَغض مِن حشمته",25,"ه",1,0],["تَحَطَّم عن زُعرِ القوادِمِ خُرَّقِ","كَمِثلِ أُرومٍ من حُلِيٍّ تجَرثَما",26,"م",2,0],["تحطِمَنكُم فتُفُدون رَمايا","بسهام الخطوبِ بالاتفّاقِ",27,"ق",1,0],["تَحُطُّ يا رُبَّانُ بالسلامَه","وَتُدخِلُ المركَبً في أعلامِه",28,"ه",1,0],["تحطمت أجزاؤه كلها","وأوشكت تفضي الى حطمي",29,"م",2,0],["تحط عليها لكي تستريح","من السير رائحة غاديه",30,"ي",2,0],["تحطّمت بالحرمات لولا علالةٌ","تمرغ فقرى في وضيع ثراها",31,"ا",3,0],["تَحُطّ الرّزايا رَحلَهَا عِندَ خَافِقٍ","بِسَفحِ ضُلوعٍ ساكِنَاتٍ شمالِيَا",32,"ي",2,0],["تحطُّ بِقدرِ البيضِ سُمرُ يَراعِهِ","وَتَزري لعمري من رِماحٍ بسُمرِها",33,"ر",3,0],["تحط أَثقال وُزر لا تَقومُ بِها","شَم الرَواسي من راس وَمُنهَدِم",34,"م",1,0],["تحطُّ بها الآمال حين تؤُمُّهُ","وإن هي آبتْ أثقلتها الحقائب",35,"ب",1,0],["تُحطِّم من تلقى وَتطرح جانِباً","نُفوسَ الوَرى يا ويحَ تلك المَقاصِلِ",36,"ل",1,0],["تحطم من ركن الصلاح مشيده","وقوض من بنيانه كل عامر",37,"ر",1,1],["تحطُّ ما فيه توضيحٌ لكل علا","وأن يكن فيه إعجامٌ وتشكيلُ",38,"ل",1,0],["تحُطُّ بها الأسد الضواري خواضِعا","لدَيكَ ولَوْ أنّ الكواكب غَابُهَا",39,"ب",3,0],["تَحَطَّمَ القَيدُ يَا لَيْلايَ فِي وَطَنِي","فَغَرَّدَ الطَّائِرُ المَحزُونُ وانطَلَقَا",40,"ق",2,0],["تحطمت في بحار الموت مركبنا","بحر الدماء فلاشطٌ ولا سفنُ",41,"ن",1,0],["تحط بها أو زار من جاء قاصدا","إليها سواء جاروا الحي ام زاروا",42,"ر",3,0],["٥- تحطُّ رحالَها في كلِّ نادٍ","وترفعُها الأكفُّ على العمامهْ",43,"م",2,0],["تحطم حلمكم بالجنوب","فلا جيشكم بالجنوب يجوب",44,"ب",1,0],["تحط رجالها حتماً","بحسنى سوف ترضيها",45,"ي",3,0],["تَحَطَّمَتْ أُمنِياتُ الشَّدوِ , بَعثَرَهَا","عَزفُ الأسَى , وَ النَّوَى بِالنَّوحِ صَنَّجَها",46,"ج",3,0],["تحطم المرفأ المصنوع من ورقي","وتاه في ضجة الأبعاد باقيها",47,"ي",3,0],["تُحطّمُني حيناً وحيناً تردُّنِي","إلى حيثُ تاهَ ال(كلُّ) في خطوةِ ال(بعضِ)",48,"ض",1,0],["تحطمها بغية ُ إنجازها","ميعادَ شعثٍ وعدوها الحطيم",49,"م",1,0],["تَحُطُّ مِثلَ طُيُورِ الشِّعرِ في لُغَتي","فَتُصبِحَ الرَّوضَةَ الغَنَّاءَ والسَّهْلا",50,"ل",2,0],["تحطمت لغة الآمالِ في شفتي","حتى الأسى دمعه باكٍ لمأساتي",51,"ت",2,0]]}