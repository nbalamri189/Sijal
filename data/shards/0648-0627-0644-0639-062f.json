9578",""],[4767,"الضربة","https://www.poetsgate.com/ViewPoem.aspx?id=179780",""],[4767,"سيف العدل","https://www.poetsgate.com/ViewPoem.aspx?id=180687",""],[4767,"لواء العدل","https://www.poetsgate.com/ViewPoem.aspx?id=180688",""],[4767,"المعيار","https://www.poetsgate.com/ViewPoem.aspx?id=187543",""],[4783,"طاب الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=185452",""],[4791,"الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=35555",""],[4935,"قمر الفخار بمجدكم إلي أنواراً","https://www.poetsgate.com/ViewPoem.aspx?id=129378",""],[5005,"على عين العدل","https://www.poetsgate.com/ViewPoem.aspx?id=198658",""],[5056,"<< شاعر القمر..>>","https://www.poetsgate.com/ViewPoem.aspx?id=33252",""],[5145,"من كان يصبو إلى الأوصاف والغزل","https://www.poetsgate.com/ViewPoem.aspx?id=108227",""],[5150,"ما كل ما يعلم يقال ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=202901",""],[5186,"يا ناثر النظم الأرق الأنفس","https://www.poetsgate.com/ViewPoem.aspx?id=156549",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5237,"إن شئت عيشا هنيا واتباع هدى","https://www.poetsgate.com/ViewPoem.aspx?id=113119",""],[5279,"رَوَّعْتَ قَلْبِي","https://www.poetsgate.com/ViewPoem.aspx?id=183667",""],[5409,"للحر بطن الأرض أجدى","https://www.poetsgate.com/ViewPoem.aspx?id=155492",""],[5533,"لَوْ أنَّكَ تَرْجِعُ يا عُمَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=176462",""],[5561,"المجد","https://www.poetsgate.com/ViewPoem.aspx?id=205111",""],[5606,"العيد الوطني88","https://www.poetsgate.com/ViewPoem.aspx?id=199938",""],[5677,"ماطار طير الا ورفرف جناحه","https://www.poetsgate.com/ViewPoem.aspx?id=139672",""],[5873,"سُبات العرب","https://www.poetsgate.com/ViewPoem.aspx?id=215312",""],[5947,"ممكن؟!!","https://www.poetsgate.com/ViewPoem.aspx?id=23331",""],[5956,"أبواشٌ وشارونيّون","https://www.poetsgate.com/ViewPoem.aspx?id=192363",""],[6068,"يا ظبية عن بعدها لا أقدر -21-","https://www.poetsgate.com/ViewPoem.aspx?id=177395",""],[4442,"أنفت أن تميس إلا دلالا","https://www.poetsgate.com/ViewPoem.aspx?id=171224",""],[6129,"يفدي حذاءَك باعةُ الأبقارِ","https://www.poetsgate.com/ViewPoem.aspx?id=13877",""],[5309,"فرخ من الجن بين المجرمين ربي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573553",""],[5309,"لا تذرفا دمعا على فقدانه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573555",""],[6171,"عُرسُ الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86324&r=&rc=7",""],[5075,"ماذا جنى الأحرار ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82761&r=&rc=7",""],[6277,"العبودية الكبرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64441&r=&rc=0",""]],"verses":[["والعَدلَ لا تتوسَّموا","والظلمَ لا تتجَّهموا",0,"م",3,0],["والعدلُ يردعُ قادراً عن عاجزٍ","فالذئب هاجعةٌ لديهِ الشاء",1,"ا",2,0],["والعدلَ حكماً كادَ أن لا يغتدِي","زيدُ النحاة به لعمرٍو ضارِبا",2,"ب",2,0],["والعدل يغمض جفن السيف في دعةٍ","من بعد ما كانَ جفناً دمعه دامي",3,"م",2,0],["والعدل كم من رايةٍ بيضاء قد","قامت بصبحٍ من سناه مبين",4,"ن",1,0],["والعدلُ مغزرةٌ لكلّ حلوبةٍ","والجَوْرُ يُعقبُ رِسلَها تشويلا",5,"ل",2,0],["وَالعَدلُ يَرفَعُ لِلمَمالِكِ حائِطاً","لا الجَيشُ يَرفَعُهُ وَلا الأُسطولُ",6,"ل",1,0],["وَالعَدلُ في الدُولاتِ أُسٌّ ثابِتٌ","يُفني الزَمانَ وَيُنفِدُ الأَجيالا",7,"ل",2,0],["والعَدلُ فيها والتّقى جُمِعَا","فَكأَنَّ ذا سَمعٌ وذا بَصَرُ",8,"ر",1,0],["والعدلُ أكثر ما يكون حَديثُه","أُنْشُودَةَ الجانِي ودَعْوَى المجرِمِ",9,"م",1,0],["والعدلُ قُوّتُنا التي نرمِي بها","أَعْدَى العِدَى فَنُصيبُ منه المقتلا",10,"ل",2,0],["والعدلُ سارٍ لا يُضيءُ سبيلَه","نورٌ ولا ينجابُ عنه سوادُ",11,"د",1,0],["وَالعُدمُ أَروَحُ مِمّا فيهِ عالَمُهُم","وَهُوَ التَكَلُّفُ إِن هَبّوا وَإِن هَجَدوا",12,"د",3,0],["والعدل حيطة من قد كان ذا سعةٍ","وعون كل فقير الحال محتاج",13,"ج",1,0],["وَالعَدْلُ لَوْ فِي النَّاسِ عَدْلٌ لَمْ يَكُنْ","يَوْماً حَلِيفَ سِيَاسَةٍ اسْتِعْمَارِ",14,"ر",1,0],["والعَدَدُ المُطلَقُ مَا لَم يُنسب","لِلمالِ أَو للجَذرِ فافهَم تُصِب",15,"ب",1,0],["والعدل يقضي ان تعامل","زائريك على السوية",16,"ي",2,0],["والعدلِ والآراءِ والتدبيرِ","والتقديرِ والتشميرِ والأحكامِ",17,"م",1,0],["والعدل صعبٌ على من لا يقين له","لولا كمال يقين فيك ما سهلا",18,"ل",2,0],["وَالعداواتُ كَالمَودات في النا","س تُساوي الأَقدار مِن مُقتَضاها",19,"ا",3,0],["وَالعَدلُ يُعلى المُلكَ فَوقَ السُها","وَيُلبِسُ الدُنيا ثِيابَ الأَمان",20,"ن",1,0],["وَالعَدلُ فِعلُهُما مَعاً فَأَكونُ قَد","أَحرَزتُ في الحالَينِ حَظّي مِنهُما",21,"م",2,0],["وَالعَدلُ أَن يَفدِيَ الجَوادَ ال","بَخيلُ وَالحافِظَ المُضيعُ",22,"ع",1,0],["وَالعَدلُ في حُكمٍ دَليلٌ عَلى","طَهارَةِ المَولِدِ وَالنَجرِ",23,"ر",1,0],["والعدلُ في حفظِ النفوس وما لَها","ببقاء مولانا الإمام كفيل",24,"ل",1,0],["والعدل في الدنيا يراه","المرء في الأخرى نصيره",25,"ر",2,0],["والعدل أمنع جنة من لامةٍ","زغفاء ضاعف سردها دلود",26,"د",1,0],["وَالعَدلِ وَالإِحسانِ وَالمَعروفِ مَم","لوءَ الحِياضِ لِموسِرٍ وَلِمُعسِرِ",27,"ر",1,0],["والعَدلِ والإنصافِ","وقِلَّةِ الخِلافِ",28,"ف",1,0],["وَالعَدلُ إِن عَذَّبوا وَإِن هَتَكوا","وَالفَضلُ إِن رَحَموا وَإِن سَتَروا",29,"ر",3,0],["والعدني البحر الخضم أخي الندى","وكذا الوجيه المتقى الأخشع",30,"ع",1,0],["وَالعدلُ سلطانٌ لكلّ مملّك","يَقضي بِسلطان عليه مبينِ",31,"ن",1,0],["وَالعدلُ كلُّ العدلِ يقصرُ دونهُ","رأيُ اللّبيبِ وَفطنةُ اليقظانِ",32,"ن",1,0],["والعدا نمقوا أحاديث إفك","كلها في طرائق معلوله",33,"ل",2,0],["والعَدْلُ اختلَّ توازنهُ","والحقُّ تَبَدَّدَ مَسْلوبا",34,"ب",2,0],["وَالعَدلُ إِن أَفرَطَ عُدوانُ","وَالماءُ إِن أَفرَطَ طوفانُ",35,"ن",1,0],["والعَدْوَ بَيْنَ المَجْلِسَيْن إذا","ولَّى العَشِيُّ وقَدْ تنادى العَمّ",36,"م",1,0],["والعَدلُ أَولى بأميرِ العُلى","فليَعدِلِ الكأسَ على العَدلِ",37,"ل",1,0],["والعدلُ ليس يُجهَل","في حُبِّ من تيّمني",38,"ي",1,0],["والعدلُ فِي حكمِ المكارِمِ والعُلا","أَن يُشفَعَ الإِنعامُ بالإِنعامِ",39,"م",1,0],["والعدل أس الحاكمين وأمنهم","والأمن دون العدل لا يتحقق",40,"ق",1,0],["والعدل في السبع السماوات التي","خلق المهيمن مثلهن أراض",41,"ض",1,0],["والعدل ينقضها وليس بممكن","نقض العهود وهم من الخفراء",42,"ا",2,0],["والعدل أبلج ساطع","والدين ذو خال وشامه",43,"م",2,0],["والعَدْلَ في الرَّعِيّةِ","والحُكْمَ بالسَّوِيَّةِ",44,"ه",1,0],["والعَدْلَ في عِزَّةٍ والجَوْرَ فاعِلُهُ","في ذلَّةٍ ذاتِ أَخْوافٍ وأَوْجالِ",45,"ل",1,0],["والعِدى مَن هُمُ وأصلهُمُ إل","لا رُعافٌ مِن مُنتِنِ الأجيَافِ",46,"ف",1,0],["والعدل والانصاف ما بين الورى","في كل ملكك عنهما لا تعدل",47,"ل",1,0],["والعدل أول ملهم","للسان شاعرنا المجيد",48,"د",1,0],["والعدل يهوى صرحه رأسا على","عقب إذا وليَ القضاء ظلوم",49,"م",1,0],["والعدل ان شيدت عليه ممالك","قام البناءُ به وطيداً واعتلى",50,"ل",2,0],["والعدل فيها أصبحت منشورة","أعلامه من فوق كل لواء",51,"ا",2,0],["وَالعَدل مَعْك رَبي في المَهد وَاِعتَرَفَت","بِهِ لعلياك أَملاكٌ وَعُمّال",52,"ل",1,0],["وَالعَدل أَصبَح ناشراً أَعلامه","بِكَ فَوقَ هام قصيِّها وَالداني",53,"ن",2,0],["وَالعَدل بَين الأَهل والرحم الَّذي","أَوصى بِهِ المُختار في الأَنباء",54,"ا",2,0],["والعَدْلُ أَلْزَمُ ما تُعْنَى الملوكُ به","فَلْيُزْجَرُوا عن سبيلِ الحَيْفِ ولْيَزَأُوا",55,"ا",1,0],["والعدل منتسرٌ بما يخشى الذي","يغشى المفاسد من وبيل نكاله",56,"ل",2,0],["والعدلُ سيفُ بنُ سلطان الذي مُزجَتْ","بكثرة الجودِ منه شدةُ الباس",57,"س",1,0],["والعِدا يُبدون ما أخفَوْا وكم","من منايا كامناتٍ في الخِبا",58,"ب",2,0],["والعدل يصعد راقياً درج لاعلا","والجور يهبط هاوياً في السَّافلِ",59,"ل",1,0],["والعدل قد انشر في عصره","والجور مقبور وملحودُ",60,"د",1,0],["والعدق جاء لأمره","لما دعاه وما قعد",61,"د",1,0],["والعدق لباه لما إن دعاه كما","عليه صلى الصفا فاعتز واحترما",62,"م",2,0],["والعدة العظمى من العدد التي","تضفو ملابس سردها الموضون",63,"ن",1,0],["والعدل فيك مشرق آفاقه","والتاج منك دائماً اشراقه",64,"ه",1,0],["والعِدَى كالغُثاء يَحْمِلهُ الرِّي","حُ بأدْنى أجْزَائِها حينَ هَبَّا",65,"ب",2,0],["والعدل في أيامه مُؤنسٌ","في قبره بالنور والرحمَهْ",66,"م",2,0],["والعدا كم نكست لي علما","وهيامي ليس بالمنتكسِ",67,"س",1,0],["والعدل والحلم العميم وفي بها","حسن الخلال وفي علو الهمةِ",68,"ه",1,0],["والعدل كم يشدو بقطرك منشداً","مولاي إني طيّ أمرك مرتهنْ",69,"ن",1,0],["والعدل صح مزاجه","بوجوده بعد اعتلال",70,"ل",1,0],["والعدو الكريم يهجع في أم","ن إذا كان في عداه كرام",71,"م",1,0],["والعدلُ أصلٌ من قديمك راسخٌ","إن الحياة بدونكم لا تُفرحٌ",72,"ح",1,0],["والعدل عن معدوله والأعجمي","عن عربي سابق مقدّم",73,"م",1,0],["والعدلُ منبسطٌ والحقُّ مُرْتَجَعٌ","والشِّعْبُ ملتئمٌ والجورُ مُصْطَلَمُ",74,"م",1,0],["والعدلُ ممدود سرادقهُ","والعطف والإحسان والبرُّ",75,"ر",1,0],["والعدلُ خفاقُ البنو","دِ يكاد يلمسُ باليدِ",76,"د",1,0],["والعدلُ يكتبُ آيةً بنجيعهِمْ","سيفُ الجريءِ بحقهِ سيفان",77,"ن",1,0],["والعدلُ والصدقُ الصُراحُ كلاهُما","ما اْعتادَ غيرَهما يراعُك والفَم",78,"م",1,0],["والعدل حلته والفضل حليته","والفصل كلمته والبذل راويه",79,"ي",2,0],["والعدل في الحكم إن كانت دعائمه","على سوى أسس الإخلاص ما عذبا",80,"ب",2,0],["والعدل مدّ رواق الأمن وانتشرت","جنوده من دواهي الشرّ تحميك",81,"ك",1,0],["والعدل أصل بنائه","فسل الممالك والقرون",82,"ن",1,0],["وَالعَدلُ فَوضى لا يقَرُّ قَرارُهُ","حَكَمَ القُضاةُ عَلَيهِ بِالإِعدامِ",83,"م",1,0],["والعدلة الأنثى يرد مقالها","إذ هي نصف العادل الحبر",84,"ر",1,0],["والعدلُ والبِرُّ والتقوى لهُ زادُ","فَحَلَّ من ذروةِ الفِردوسِ في رُتَبِ",85,"ب",1,0],["والعدل نبه طرفه من رقدةٍ","من قال ان العدل ادركه العمى",86,"م",2,0],["والعدوُّ المذعورُ يهربُ منهم","جاعلاً عذرهُ عن الفرِّ ذُعره",87,"ر",2,0],["والعدود الرهيه يمها مانضب","مورد للظوامي بادين للحيام",88,"م",1,0],["وَالعَدلُ مِن أوصَافِهِ فِي فِعلِهِ","وَمَقَالِهِ وَالحُكمِ بِالمِيزَانِ",89,"ن",1,0],["والعَدْل نِبرَاسٌ لهُ وبِهِ","إحقَاقُ حّقٍّ واضحُ النُّصُبِ",90,"ب",1,0],["والعدلُ قد عَمَّ الأنامَ فما","تَخشَى البهائمُ صولةَ الأسدِ",91,"د",1,0],["والعدل منشورٌ على أرجائِنا","ضافٍ علينا ظِلُّهُ الممدود",92,"د",1,1],["والعدل والجور لديه اختلفا","فعاكف هذا وذا مشرد",93,"د",1,0],["والعدل شيد عرشه في يلدز","واليمن قد عم البلاد وكيف لا",94,"ل",2,0],["والعدل عبدالله يفخر حيث انت","مداره دون الورى ومديره",95,"ر",2,0],["والعدل متسع النطاق كأنه","بحر على كل العباد تدفقا",96,"ق",2,0],["والعَدل في كلّ البلاد كما ترى","بين الوراء مُزمَّلاً ومُدثَّرا",97,"ر",2,0],["والعدل أسَّ الحكم والأحكام","والعمران للدنيا وتوفير الثّرى",97,"ر",2,0],["وَالعَدل في الأَرض يُبكي الجنّ لَو سَمِعوا","بِهِ وَيستَض