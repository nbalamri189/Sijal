{"poems":[[55,"خير الهوى ما نجا من الكمد","https://www.aldiwan.net/poem30628.html","المنسرح"],[55,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[53,"يا فاصد العرق المبارك فصده","https://www.aldiwan.net/poem62867.html","البسيط"],[31,"إني أظن نزارا سوف يجمعها","https://www.aldiwan.net/poem6044.html","البسيط"],[46,"إني أظن البلي لو كان يفهمه","https://www.aldiwan.net/poem29681.html","البسيط"],[50,"يا من جفاني وملا","https://www.aldiwan.net/poem65066.html","المجتث"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85557","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[108,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[211,"أصابت العام رعلا غول قومهم","https://www.aldiwan.net/poem27887.html","البسيط"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6751","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117221","الكامل"]],"verses":[["إِنّي أَظُنُّ الظُنونَ صادِقَةً","كَأَنَّ يَومي طَليعَةٌ لِغَدي",0,"د",2,0],["إِنّي أَظمى إِلى المَشيبِ وَمَن","يَنجُ قَليلاً مِنَ الرَدى يَشِبِ",1,"ب",1,0],["إنّي أظن قرارةً حَظيتْ بهِ","ستكون أخرى الدهر معدنَ عنبر",2,"ر",1,0],["إِنّي أَظُنُّ نِزاراً سَوفَ يَجمَعُها","بَعدَ التَفَرُّقِ حَربٌ شَبَّها زُفَرُ",3,"ر",1,1],["إِنّي أَظُنُّ البِليَ لَو كانَ يَفهَمُهُ","صَدَّ البِلى عَن بَقايا وَجهِهِ الحَسَنِ",4,"ن",1,1],["إِنّي أَظُنُّكَ تَحكي","فيما فَعَلتَ القِرِلّى",5,"ل",2,0],["إني أظنك لا ترى بمكانها","من بعد بضع سنين غير رماد",6,"د",1,0],["إني أظنّ الحرص منّىَ القوما","أن سيسودوا بالحجاز يوما",7,"م",2,0],["إنِّي أَظنُّ -وظني ليس يكذِبُني-","أنّ الزمانَ الذي نرجوه واتانا",8,"ن",2,0],["أنّي أظَلُّ مع الرعيَةِ مُرْهَقاً","أنّي أظَلُّ مع الرعيَّةِ لاغبا",9,"ب",2,0],["أَنّي أَظُنُّ رَسولَ اللَهِ صابِحَكُم","جَيشاً لَهُ في فَضاءِ الأَرضِ أَركانُ",10,"ن",1,0],["إنّي أَظنُّ قَلبَكا","يَهوى جلوسي قُربَكا",11,"ك",2,0],["إِنّي أَظُنُّكِ قَد دُهيتِ بِفُرقَةٍ","مِن مُؤنِسٍ لَكِ فَاِرتَمَضتِ لِذاكِ",12,"ك",1,0],["اني أظنك لا تصدق كونه","بالقرب بل ظن بلا ايقان",13,"ن",1,0],["إني أظنك قد نكثت مواثقاً","أرضيت نقض العهد ويحك دينا",14,"ن",2,0]]}