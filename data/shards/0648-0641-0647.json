{"poems":[[86,"أي رجال الدنيا الجديدة مهلاً","https://www.aldiwan.net/poem10706.html","الخفيف"],[70,"خاف الرسول من الملامه","https://www.aldiwan.net/poem42701.html","مجزوء الكامل"],[70,"رد السلام رسول بعض الناس","https://www.aldiwan.net/poem42851.html","السريع"],[49,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[66,"أخبرت شبهة النعاس بعينيك","https://www.aldiwan.net/poem39043.html","الخفيف"],[80,"كملت لي الخمسون والخمس","https://www.aldiwan.net/poem31409.html","أحذ الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30486","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55086","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43806","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[128,"حي المعاليم والرسوما","https://www.aldiwan.net/poem50515.html","مجزوء الكامل"],[150,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[349,"الحق في الخلق خلق","https://www.aldiwan.net/poem15803.html","المجتث"],[403,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[403,"لله درك فارس العلماءكم","https://www.aldiwan.net/poem33490.html","الكامل"],[439,"إن روضا لم تسقه منذ عام","https://www.aldiwan.net/poem34767.html","الخفيف"],[441,"لقد فاز قوم باللباب من العلم","https://www.aldiwan.net/poem14385.html","الطويل"],[529,"أمرهف لحظه سله","https://www.aldiwan.net/poem37272.html","مجزوء الوافر"],[558,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"]],"verses":[["وَفَهِمتُم مَعنى الحَياةِ فَأَرصَد","تُم عَلَيها لِكُلِّ نَقصٍ كَمالا",0,"ل",2,0],["وَفَهِمتُ مِنهُ إِشارَةً","بَعَثَ الحَبيبُ بِها عَلامَه",1,"م",2,0],["وَفَهِمتُ مِن نَفسِ الرَسولِ تَعَتُّباً","قَلبُ الحَبيبِ عَلَيَّ قَلبٌ قاسي",2,"ي",1,0],["وَفَهِمتُ مِن نُوَبِ الزَمانِ عِظاتِها","وَفَطِنتُ لِلأَيّامِ وَالأَحوالِ",3,"ل",1,0],["وَفَهِمنا مِنَ الفُتورِ نَشاطاً","كانَ مِنها في نَهبِ وَردِ الخُدودِ",4,"د",1,0],["وفهمتُ بعد اللَّبسِ ما شَرَحَتْ","والشرحُ يَذْهَبُ عنده اللَّبسُ",5,"س",1,0],["وفَهْمٍ لَوِ البِرْجِيس جِئْتُ بجدِّهِ","إِذاً لَتَلَقَّانِي بنَحْسِ المقَاتِلِ",6,"ل",1,0],["وَفَهِمْتُ مَا مَعنى الإِخاءِ حَقِيقَةً","لَمَّا فَهِمْتُ حَقِيقَةً معْنَاكَا",7,"ك",2,0],["وَفهم سُلَيمانٍ لِفَضلِ قَضائِهِ","لَدى نَفش غَيري يَقولُ لَهُ نَفشُ",8,"ش",1,0],["وفهِمنا لُغَى الطُّيورِ وأصْغَيْنا","لهمسِ الغُصون في الأدْواحِ",9,"ح",1,0],["وفهمت كل دقيقةٍ","منه فصرت بها فهيما",10,"م",2,0],["وفهمت سرَّ الحسن وهو مكتّم","في ليل شعر فوق صبح جبين",11,"ن",1,0],["وَفَهمُ حالي لِغَيري","عَلى العُقولِ يَرِقُّ",12,"ق",1,0],["وفهمت منه عندما خاطبته","أن الكليم مطالب تعجيلا",13,"ل",2,0],["وفهمت من أثناء ما حررتم","ما لا يساعد ذلك التمثيلا",14,"ل",2,0],["وفِّهِ من نَداكَ أوْفى نصيبٍ","فَجَزَاءُ الكِرامِ رَهْنُ التَّمامِ",15,"م",1,0],["وفهمك فاحضره لما أنت طالب","فلا خير في تطلاب علم بلا فهم",16,"م",1,0],["وفَهْمٍ جَلَّ عَنْ وَهْمٍ","إذا حَلَّ الْخَفِي حلّهْ",17,"ل",2,0],["وفهوم جميعها أسرار","وعلوم أتى بها التنزيل",18,"ل",1,0]]}