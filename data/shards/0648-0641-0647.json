{"poems":[[88,"أي رجال الدنيا الجديدة مهلاً","https://www.aldiwan.net/poem10706.html","الخفيف"],[72,"خاف الرسول من الملامه","https://www.aldiwan.net/poem42701.html","مجزوء الكامل"],[72,"رد السلام رسول بعض الناس","https://www.aldiwan.net/poem42851.html","السريع"],[51,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[68,"أخبرت شبهة النعاس بعينيك","https://www.aldiwan.net/poem39043.html","الخفيف"],[82,"كملت لي الخمسون والخمس","https://www.aldiwan.net/poem31409.html","أحذ الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30486","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55086","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43806","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[132,"حي المعاليم والرسوما","https://www.aldiwan.net/poem50515.html","مجزوء الكامل"],[154,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[354,"الحق في الخلق خلق","https://www.aldiwan.net/poem15803.html","المجتث"],[409,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[409,"لله درك فارس العلماءكم","https://www.aldiwan.net/poem33490.html","الكامل"],[445,"إن روضا لم تسقه منذ عام","https://www.aldiwan.net/poem34767.html","الخفيف"],[447,"لقد فاز قوم باللباب من العلم","https://www.aldiwan.net/poem14385.html","الطويل"],[534,"أمرهف لحظه سله","https://www.aldiwan.net/poem37272.html","مجزوء الوافر"],[563,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86613","الوافر"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104570","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59808","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56160","الوافر"],[1194,"","https://poetry.dctabudhabi.ae/diwan/poem/206180","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136289","الوافر"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136352","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136240","الخفيف"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114777","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106865","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205842","المتقارب"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136983",""],[3023,"","https://poetry.dctabudhabi.ae/diwan/poem/31533","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89424","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74045","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74098","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91116","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216422",""],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/90050","الكامل"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127927","الرجز"],[4958,"هكذا تكلم المجنون","https://www.poetsgate.com/ViewPoem.aspx?id=155102",""],[5804,"الشيطان المعقد","https://www.poetsgate.com/ViewPoem.aspx?id=214911",""],[5956,"مونولوج حبيبَيْن ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182051",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""]],"verses":[["وَفَهِمتُم مَعنى الحَياةِ فَأَرصَد","تُم عَلَيها لِكُلِّ نَقصٍ كَمالا",0,"ل",2,0],["وَفَهِمتُ مِنهُ إِشارَةً","بَعَثَ الحَبيبُ بِها عَلامَه",1,"م",2,0],["وَفَهِمتُ مِن نَفسِ الرَسولِ تَعَتُّباً","قَلبُ الحَبيبِ عَلَيَّ قَلبٌ قاسي",2,"س",2,0],["وَفَهِمتُ مِن نُوَبِ الزَمانِ عِظاتِها","وَفَطِنتُ لِلأَيّامِ وَالأَحوالِ",3,"ل",1,0],["وَفَهِمنا مِنَ الفُتورِ نَشاطاً","كانَ مِنها في نَهبِ وَردِ الخُدودِ",4,"د",1,0],["وفهمتُ بعد اللَّبسِ ما شَرَحَتْ","والشرحُ يَذْهَبُ عنده اللَّبسُ",5,"س",1,0],["وفَهْمٍ لَوِ البِرْجِيس جِئْتُ بجدِّهِ","إِذاً لَتَلَقَّانِي بنَحْسِ المقَاتِلِ",6,"ل",1,0],["وَفَهِمْتُ مَا مَعنى الإِخاءِ حَقِيقَةً","لَمَّا فَهِمْتُ حَقِيقَةً معْنَاكَا",7,"ك",2,0],["وَفهم سُلَيمانٍ لِفَضلِ قَضائِهِ","لَدى نَفش غَيري يَقولُ لَهُ نَفشُ",8,"ش",1,0],["وفهِمنا لُغَى الطُّيورِ وأصْغَيْنا","لهمسِ الغُصون في الأدْواحِ",9,"ح",1,0],["وفهمت كل دقيقةٍ","منه فصرت بها فهيما",10,"م",2,0],["وفهمت سرَّ الحسن وهو مكتّم","في ليل شعر فوق صبح جبين",11,"ن",1,0],["وَفَهمُ حالي لِغَيري","عَلى العُقولِ يَرِقُّ",12,"ق",1,0],["وفهمت منه عندما خاطبته","أن الكليم مطالب تعجيلا",13,"ل",2,0],["وفهمت من أثناء ما حررتم","ما لا يساعد ذلك التمثيلا",14,"ل",2,0],["وفِّهِ من نَداكَ أوْفى نصيبٍ","فَجَزَاءُ الكِرامِ رَهْنُ التَّمامِ",15,"م",1,0],["وفهمك فاحضره لما أنت طالب","فلا خير في تطلاب علم بلا فهم",16,"م",1,0],["وفَهْمٍ جَلَّ عَنْ وَهْمٍ","إذا حَلَّ الْخَفِي حلّهْ",17,"ل",2,0],["وفهوم جميعها أسرار","وعلوم أتى بها التنزيل",18,"ل",1,0],["وفهمك بالأهواء والوهم زاهيا","وألفيت إلفا بالتآلف وافيا",19,"ي",2,0],["وَفَهدٌ نائم عَن كُل خَير","سَماجته تَضيق بِها الرِحاب",20,"ب",1,0],["وفهمتُ ايماناً جميلَ جلالهِ","لمّا تبيّنَ لي أماراتُ الهُدى",21,"د",2,0],["وفهم إذا ما العلم أشكل أو دجت","معالمه أو حرَّف الجهلُ ضبطه",22,"ط",2,0],["وفهت بنظم شعرٍ مثل بعرٍ","تدندل من فمٍ كالصرم ناتِنْ",23,"ن",1,0],["وفهمني نوراً وعلمه وحكمة","فشكري له في الشاكرين موازيا",24,"ي",2,0],["وفهمك مستقيم في ازدياد","وجسمك لين والطبع قابل",25,"ل",1,0],["وفهمه في كتاب الله يظهر من","علومه حكما غرا بتبيين",26,"ن",1,0],["وفهمت الدليل بالحق يقضي","فانتهى السعي بي لكشف القناع",27,"ع",1,0],["وَفَهِموا التَوراةَ وَالإِنجيلا","وَأَحكَموا التَنزيلَ وَالتَأويلا",28,"ل",2,0],["وفِهرٌ أَبُو الأحياء جامعُ شَملِها","وكاسِبُها من فخرهِ خَير مَكسَبِ",29,"ب",1,0],["وفهمتُ أن العيش مضحكةٌ","نخفي بها الأدرانَ والوضرا",30,"ر",2,0],["وفهم يدق لوعي الوجود","فلا تختفي عنده خافيه",31,"ي",2,0],["وفهم حقهم من الحمد والش","كر بشعر مثل اللآلي نضيد",32,"د",1,0],["وَفُهمُ بنُ عَمرٍو يَعلِكونَ ضَريسَهُم","كَما صَرفَت فَوقَ الجِذاذِ المَساحِنُ",33,"ن",1,0],["وفهدته لأعلى من قطاةٍ","وفخذ ضلعه لحمٌ قوي",34,"ي",1,0],["وَفِّه حقّه وَحقّ القَوافي","اِحتَفاءاً بقدرهِ واِحتِفالا",35,"ل",2,0],["وَفّه يا عين فَرضاً واجِباً","وَاِحذري أَن تهملي فيه الأداءَ",36,"ا",2,0],["وَفهمت معنى ما يقال وَقلته","مِن قَبل نَفخ الرُوح في اليافوخ",37,"خ",1,0],["وفهمت من نزغات طب","عك، والطبائع تغلب",38,"ب",1,0],["وفهمت مودَعَهُ فرحت بغبطة","جذلان مبتهجاً بما أدّاه",39,"ا",2,0],["وفهمت في تسطير ذا العتابِ","وما بهِ من سفه الخطابِ",40,"ب",1,0],["وَفَهِمْتُ مَعْنى الحَشْرَجاتِ مِنَ العَشيقَةِ","وَهْيَ في حِضْنِ العشيقِ تُقَبَّلُ",41,"ل",1,0],["وفهمتُ مقصدَ خالقي في خلقهِ","فعلمت انّ الخيرِ اجمعُ في الهدى",42,"د",2,0],["وفهْمُك لي مثل فهمي أنا","هوانا التفاهمُ .. مَن مثلُنا !!‏",43,"ا",1,0],["وفهمتُ معنى اللؤمِ أجمعِهِ بما","أجراه في حقّي وما لي قدَّما",44,"م",2,0],["وفهمتُ معنى الخَتْرِ في قَسَماتِهِ","ويئستُ أنْ ألقى لِوَعيهِ سُلّما",44,"م",2,0],["وفهمتُ بعدَ فواتِ أمري أنني","جسدٌ وأن جهادَنَا الروحُ",45,"ح",1,0]]}