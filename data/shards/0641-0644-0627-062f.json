{"poems":[[53,"حططت المكارم عن عاتقي","https://www.aldiwan.net/poem30520.html","المتقارب"],[63,"أرض العذيب أما تنفك بارقة","https://www.aldiwan.net/poem45734.html","البسيط"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[27,"أبت عيناك بالحسن الرقادا","https://www.aldiwan.net/poem5721.html","الوافر"],[51,"أيا فضلا غدا فضلا","https://www.aldiwan.net/poem7986.html","الهزج"],[38,"على الدار بالرمانتين تعوج","https://www.aldiwan.net/poem7693.html","الطويل"],[49,"تولت جدة الدنيا","https://www.aldiwan.net/poem65374.html","الهزج"],[44,"أأطلال هند ساء ما اعتضت من هند","https://www.aldiwan.net/poem30544.html","الطويل"],[118,"قضى غير مأسوف عليك من الورى","https://www.aldiwan.net/poem49272.html","الطويل"],[167,"دع الدار بالبحرين تعفو ربوعها","https://www.aldiwan.net/poem1634.html",""],[268,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[374,"أجد يا راهبا سعيا","https://www.aldiwan.net/poem59169.html","مجزوء الوافر"],[400,"رشأ أباح دمي وأوجب فتنتي","https://www.aldiwan.net/poem33754.html","الكامل"],[413,"أسير وقد جازت بنا غاية السرى","https://www.aldiwan.net/poem54176.html","البسيط"],[434,"صدرت ولم أنقع بكم غلة الصدر","https://www.aldiwan.net/poem2557.html","الطويل"],[456,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[462,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[549,"ألا يا قوم للقدر المتاح","https://www.aldiwan.net/poem47892.html","الوافر"],[549,"ونجلاء لا ترقا لها الدهر دمعة","https://www.aldiwan.net/poem47909.html","الطويل"],[549,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"]],"verses":[["فَلا دَخَلَ البُعدُ ما بَينَنا","ولا فَكَّ مِنّا يَداً عَن يَدِ",0,"د",1,0],["فَلا دُروعَ لَهُم إِلّا جُلودَهُمُ","وَلا عَلَيهِم سِوى الأَحسابِ مِن جُنَنِ",1,"ن",1,0],["فَلاَ دَرَّ إِلاَّ دَرُّ مُكْتَمِلِ النُّهَى","بِغَيْرِ الْمَعَالِي لاَ يُرَى وَهْوَ مُهْتَمُّ",2,"م",1,0],["فَلادِيَةً سُقيتِ وَدَيتِ أَهلي","وَلا قَوَداً بِقَتلي مُستَفادا",3,"د",2,0],["فلا دانيهمُ يُجنَى","ولا نائيهمُ يُدنى",4,"ن",2,0],["فَلا دينَهُ وَاِهتاجَ لِلشَوقِ إِنَّها","عَلى الشَوقِ إِخوانَ العَزاءِ هَيوجُ",5,"ج",1,0],["فلا دين ولا حسبٌ","ولا كرم ولا خلُقُ",6,"ق",1,0],["فَلا دَمعَ ما لَم يَجرِ في إِثرِهِ دَمٌ","وَلا وَجدَ ما لَم تَعيَ عَن صِفَةِ الوَجدِ",7,"د",1,0],["فلا دمع يروى يومٍ ولي ترابه","وكيف يروي تربه غير واجد",8,"د",1,0],["فَلا دارَ إِلّا حَيثُ يُهتَضَمُ العِدَى","وَلا عِزَّ إِلّا حَيثُ يَبدُو خضُوعُها",9,"ع",3,0],["فلا دارَ للإسلامِ إلا تهدمت","ولا قلبَ إلا ذابَ من حرِّ لوعة",10,"ه",1,0],["فلا دنيا ولا أخرى","فما أشقاه في الدنيا",11,"ي",2,0],["فلأدعونَّ أقول يا مَنْ أمرُهُ","كن لا تعذب من صليتُ بناره",12,"ر",2,0],["فلا دونكم للقاصدين مقاصد","ولا بعدكم للطالبين طلاب",13,"ب",1,0],["فلا درّ درّ البين قد ظلت بعده","تقيّض لي الأحزان من حيث لا أدري",14,"ر",2,0],["فلا دارَ إلا أدمعٌ ووكيفُها","ولا هندَ إلا أضلعٌ ووَجيبُها",15,"ب",3,0],["فلا دافعٌ سورٌ متينٌ وخندقٌ","ولا كلّ ممنوع الذّرى والنوائب",16,"ب",1,0],["فلا دَوٌّ تَخُبُّ به رِكابي","ولا جَوٌّ تَهُبُّ به رِياحي",17,"ح",2,0],["فَلا دارُها في ساعةِ النأْي تَنْتَئي","وَلا بُرؤُها فيما يَعوج يعوجُ",18,"ج",1,0],["فَلا دَعوت الحسينَ يُحرز لِي","حُرَّ المَعالي يَومَ الفخارِ أَبا",19,"ب",2,0]]}