{"poems":[[55,"حططت المكارم عن عاتقي","https://www.aldiwan.net/poem30520.html","المتقارب"],[65,"أرض العذيب أما تنفك بارقة","https://www.aldiwan.net/poem45734.html","البسيط"],[79,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[29,"أبت عيناك بالحسن الرقادا","https://www.aldiwan.net/poem5721.html","الوافر"],[53,"أيا فضلا غدا فضلا","https://www.aldiwan.net/poem7986.html","الهزج"],[40,"على الدار بالرمانتين تعوج","https://www.aldiwan.net/poem7693.html","الطويل"],[51,"تولت جدة الدنيا","https://www.aldiwan.net/poem65374.html","الهزج"],[46,"أأطلال هند ساء ما اعتضت من هند","https://www.aldiwan.net/poem30544.html","الطويل"],[124,"قضى غير مأسوف عليك من الورى","https://www.aldiwan.net/poem49272.html","الطويل"],[173,"دع الدار بالبحرين تعفو ربوعها","https://www.aldiwan.net/poem1634.html",""],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[382,"أجد يا راهبا سعيا","https://www.aldiwan.net/poem59169.html","مجزوء الوافر"],[409,"رشأ أباح دمي وأوجب فتنتي","https://www.aldiwan.net/poem33754.html","الكامل"],[422,"أسير وقد جازت بنا غاية السرى","https://www.aldiwan.net/poem54176.html","البسيط"],[443,"صدرت ولم أنقع بكم غلة الصدر","https://www.aldiwan.net/poem2557.html","الطويل"],[463,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[469,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[556,"ألا يا قوم للقدر المتاح","https://www.aldiwan.net/poem47892.html","الوافر"],[556,"ونجلاء لا ترقا لها الدهر دمعة","https://www.aldiwan.net/poem47909.html","الطويل"],[556,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77945","الهزج"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101013","الطويل"],[2136,"","https://poetry.dctabudhabi.ae/diwan/poem/203567","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96027","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28514","الطويل"],[2483,"","https://poetry.dctabudhabi.ae/diwan/poem/144371","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204459","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87405","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62772","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62921","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66503","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92014","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85236","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101373","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102735","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133064","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139640",""],[4767,"وزير الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=178353",""],[4858,"أنين القيد","https://www.poetsgate.com/ViewPoem.aspx?id=152051",""],[5002,"محكمة....","https://www.poetsgate.com/ViewPoem.aspx?id=213792",""],[5121,"تَرَانِيم","https://www.poetsgate.com/ViewPoem.aspx?id=213499",""],[307,"كورونا سيف الردى","https://www.poetsgate.com/ViewPoem.aspx?id=214922",""],[592,"ضلالٌُ ما يؤمله اللئام","https://www.poetsgate.com/ViewPoem.aspx?id=128813",""],[5561,"أطلِقْ عنانَكَ","https://www.poetsgate.com/ViewPoem.aspx?id=192746",""],[5612,"هِيَ العَلْياءْ","https://www.poetsgate.com/ViewPoem.aspx?id=189741",""],[5616,"أبا الطيب عذراً","https://www.poetsgate.com/ViewPoem.aspx?id=203454",""],[5829,"وقلب العاشقين هنا يذوب","https://www.poetsgate.com/ViewPoem.aspx?id=210213",""],[6089,"النبي الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=213039",""],[6177,"الهجير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79065&r=&rc=12",""]],"verses":[["فَلا دَخَلَ البُعدُ ما بَينَنا","ولا فَكَّ مِنّا يَداً عَن يَدِ",0,"د",1,0],["فَلا دُروعَ لَهُم إِلّا جُلودَهُمُ","وَلا عَلَيهِم سِوى الأَحسابِ مِن جُنَنِ",1,"ن",1,0],["فَلاَ دَرَّ إِلاَّ دَرُّ مُكْتَمِلِ النُّهَى","بِغَيْرِ الْمَعَالِي لاَ يُرَى وَهْوَ مُهْتَمُّ",2,"م",1,0],["فَلادِيَةً سُقيتِ وَدَيتِ أَهلي","وَلا قَوَداً بِقَتلي مُستَفادا",3,"د",2,0],["فلا دانيهمُ يُجنَى","ولا نائيهمُ يُدنى",4,"ن",2,0],["فَلا دينَهُ وَاِهتاجَ لِلشَوقِ إِنَّها","عَلى الشَوقِ إِخوانَ العَزاءِ هَيوجُ",5,"ج",1,0],["فلا دين ولا حسبٌ","ولا كرم ولا خلُقُ",6,"ق",1,0],["فَلا دَمعَ ما لَم يَجرِ في إِثرِهِ دَمٌ","وَلا وَجدَ ما لَم تَعيَ عَن صِفَةِ الوَجدِ",7,"د",1,0],["فلا دمع يروى يومٍ ولي ترابه","وكيف يروي تربه غير واجد",8,"د",1,0],["فَلا دارَ إِلّا حَيثُ يُهتَضَمُ العِدَى","وَلا عِزَّ إِلّا حَيثُ يَبدُو خضُوعُها",9,"ع",3,0],["فلا دارَ للإسلامِ إلا تهدمت","ولا قلبَ إلا ذابَ من حرِّ لوعة",10,"ه",1,0],["فلا دنيا ولا أخرى","فما أشقاه في الدنيا",11,"ي",2,0],["فلأدعونَّ أقول يا مَنْ أمرُهُ","كن لا تعذب من صليتُ بناره",12,"ر",2,0],["فلا دونكم للقاصدين مقاصد","ولا بعدكم للطالبين طلاب",13,"ب",1,0],["فلا درّ درّ البين قد ظلت بعده","تقيّض لي الأحزان من حيث لا أدري",14,"ر",2,0],["فلا دارَ إلا أدمعٌ ووكيفُها","ولا هندَ إلا أضلعٌ ووَجيبُها",15,"ب",3,0],["فلا دافعٌ سورٌ متينٌ وخندقٌ","ولا كلّ ممنوع الذّرى والنوائب",16,"ب",1,0],["فلا دَوٌّ تَخُبُّ به رِكابي","ولا جَوٌّ تَهُبُّ به رِياحي",17,"ح",2,0],["فَلا دارُها في ساعةِ النأْي تَنْتَئي","وَلا بُرؤُها فيما يَعوج يعوجُ",18,"ج",1,0],["فَلا دَعوت الحسينَ يُحرز لِي","حُرَّ المَعالي يَومَ الفخارِ أَبا",19,"ب",2,0],["فلا دان وَلا عالِ","وَلا إِنس ولا جان",20,"ن",1,0],["فلا دين دون العقل في الكون قائمٌ","ولا عقل دون الدين للمرء ينفع",21,"ع",1,0],["فلا دجن إلا أن تثور عجاجة","ولا مزن إلا أن تجز جماجم",22,"م",1,0],["فلا دفع ايراد ولا دفع مبهم","ولا كشف اجمال ولا حل مشكل",23,"ل",1,0],["فَلا دارَ إِلَّا دِمنَةٌ وَرُسومُها","وَلا نَفسَ إِلَّا لَوعَةٌ وَزَفيرُها",24,"ر",3,0],["فلا دمع ما لم يجر في إثره دم","ولا وجد ما لم يغن عن صفة الوجد",25,"د",1,0],["فلأدعه فصوته غير صوتي","إذ أغني ولحنه غير لحني",26,"ن",2,0],["فَلا دَلالٌ يَذِلُّ فيهِ","صبٌّ غدا منهُ في عَذابِ",27,"ب",1,0],["فلا دَيْرُزُشْتٌ خانَ مَجْدُكَ مجْدَهُ","ولا فارسٌ شانَتْكَ في سالفِ الحُقْبِ",28,"ب",1,0],["فلا دنستْ أَحسابُ قومٍ سليمةٍ","نَفَوكَ كما يُنفى الشَّرارُ عن الجمْرِ",29,"ر",1,0],["فلا دمع عينيه بالجامد","ولا لهب الشوق بالخامد",30,"د",1,0],["فَلا دهرنا يسدي إِليك بما حَوى","وَلا أَنتَ تَنأى من جنونك في الهَوى",31,"ه",3,0],["فلا دين إلا بالجهاد قوامه","ولا أمن بعد سل القواضب",32,"ب",1,0],["فلا دام يا أهل المقاصير ظلكم","إذا دام تحت الشمس أهل البطايح",33,"ح",1,0],["فلا دينه أبقى ولا الملك دائم","ومن يضلل الرحمن لم يلف مرشدا",34,"د",2,0],["فلا دين لهم بل يمش كل","على محض الهوى لا يستريب",35,"ب",1,0],["فلأدعُوَنَّ لكل مَن فوق الثرى","ببقائها طول المدى وخلودها",36,"د",3,0],["فلا دار ولا بيت","إذا الإنسان ما فكر",37,"ر",1,0],["فلا دِينٌ , ولا وطنٌ سليبٌ","ولا الأقصى ولا حتّى الضَميرُ",38,"ر",1,0],["فلا دانٍ ولا ناءٍ أُرَاعي","وكلٌّ في مناقبهِ تلاَوى",39,"ا",3,0],["فَلَا دَمْعٌ سَيَنْفَعُ مَنْ تَلظَّى","وَلَنْ يَرْوِيكَ إِلّا مَنْ يُحَنِّي",40,"ن",2,0],["فلا دواء بكفّي كي أشافيَهم","ولا سبيلا ولا حولا فأنتشلُ",41,"ل",1,0],["فلا دين ولا علم وعقل","لديهم بل هم القوم الطغام",42,"م",1,0],["فلا ديار بني عبس مغاضبة","ولا صحارى قريش حفها الخجل",43,"ل",1,0],["فلا دينٌ يَصِحُّ وهُمْ كَسالَى","ولا مَجْدٌ وقد خافُوا الحِماما",44,"م",2,0],["فلا دمعة للطفل تبقى حبيسةً","ولا أرض فيها تُستباح المحارمُ",45,"م",1,0],["فلا دفءٌ ولا نور لدينا","وكم من مترف وهو الرقيبُ",46,"ب",1,0],["فلا دروبي بها نجمٌ فأشرقها","ولا لمستُ نجاحاً لا ولا هدفا",47,"ف",2,0],["فلا داءَ مثل القهر والصّمتِ والضّنى","ولا كنشيدِ الانتصار مُداويا",48,"ي",2,0]]}