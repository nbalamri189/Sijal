","https://poetry.dctabudhabi.ae/diwan/poem/17759","الوافر"],[4043,"","https://poetry.dctabudhabi.ae/diwan/poem/92459","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83378","البسيط"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22804","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120497","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120367","الوافر"],[4948,"لبستُ شبيبتي ماذم خلقي","https://www.poetsgate.com/ViewPoem.aspx?id=81274",""],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""],[5005,"حرفٌ في مهبِّ الريح..","https://www.poetsgate.com/ViewPoem.aspx?id=189357",""],[5038,"غنّى الهزار","https://www.poetsgate.com/ViewPoem.aspx?id=189332",""],[5277,"أهل قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=185166",""],[5277,"سرُّ المصون","https://www.poetsgate.com/ViewPoem.aspx?id=191106",""],[5277,"رجعُ الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=210288",""],[5290,"سريتم وطرفي من كرى العزم ما هبا","https://www.poetsgate.com/ViewPoem.aspx?id=113129",""],[592,"ضلالٌُ ما يؤمله اللئام","https://www.poetsgate.com/ViewPoem.aspx?id=128813",""],[5362,"أرى هذي العصا خضراء تزهو","https://www.poetsgate.com/ViewPoem.aspx?id=170348",""],[5431,"تاء الأنوثة !","https://www.poetsgate.com/ViewPoem.aspx?id=207717",""],[5829,"سيمضي بالحبيب الى الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=177496",""],[5881,"لأيهما انتمائي","https://www.poetsgate.com/ViewPoem.aspx?id=184955",""],[5910,"دعاكَ السُّهدُ والأرقُ العتيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=206954",""],[5956,"الكُتَّاب","https://www.poetsgate.com/ViewPoem.aspx?id=185790",""],[6102,"ذِكرى الأَمس !!","https://www.poetsgate.com/ViewPoem.aspx?id=184048",""],[6102,"لا كرامة لنبي في قومه ..","https://www.poetsgate.com/ViewPoem.aspx?id=186289",""],[6355,"سؤال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66607&r=&rc=67",""]],"verses":[["وَما أَدَّعي أَنّي بَريءٌ مِنَ الهَوى","وَلَكِنَّني لا يَعلَمُ القَومُ ما بِيا",0,"ي",2,0],["وَما أَدري أَرُكنُ الجاهِ أَودى","وَقَد أَودَيتَ أَم رُكنُ الشَآمِ",1,"م",1,0],["وَما أَدري وَقَد زَوَّدتُ شِعري","وَظَنّي فيكَ بِالأَمَلِ الوَطيدِ",2,"د",1,0],["وما أدماء ترتع حول رَوض","ويرتع خلفها رشأٌ ربيب",3,"ب",1,0],["وَما أَدَّعي مايَعلَمُ اللَهُ غَيرَهُ","رِحابُ عَلِيٍّ لِلعُفاةِ رِحابُ",4,"ب",1,0],["وما أدري أتوقيعي بمصرٍ","وإلاَّ بالشآمِ فلن أُسامهْ",5,"م",2,0],["وَما آدَمُ إِلّاكَ","وَمَن في البَينِ إِبليسُ",6,"س",1,0],["وما أدراك ما الليثُ","وما غرك بالببْر",7,"ر",1,0],["وما أدراك ما السيلُ","وما غرك بالبحر",7,"ر",1,0],["وما أدراك بالموتِ","وما غرك بالدهر",7,"ر",1,0],["وَما أَدرى غَداةَ سُقيتُموهُ","أَتِرياقاً سُقيتُمُ أَم سِماما",8,"م",2,0],["وَما أَدَبي لِما أَسدَوهُ أَهلٌ","وَلَكِن مَن أَحَبَّ الشَيءَ حابى",9,"ب",2,0],["وَما أَدري أَذا داءٌ حَديثٌ","أَصابَ الناسَ أَم داءٌ قَديمُ",10,"م",1,0],["وَما اِدَّخَرَتها قُدرَةً في مُصَوِّرٍ","سِوى أَنَّها ما أَنطَقَت حَيَوانَها",11,"ن",3,0],["وما أدَّعِي إلا اكتفائي بنظرةٍ","إليك ودعوى العاشقينَ ضُروبُ",12,"ب",1,0],["وَما أَدري وَسَوفَ إِخالُ أَدري","أَقَومٌ آلُ حِصنٍ أَم نِساءُ",13,"ا",2,0],["وَما أَدري إِذا أَمسَيتُ حَيّاً","لَعَلّي لا أَعيشُ إِلى الصَباحِ",14,"ح",1,0],["وَما أَدري وَإِن أَمَّلتُ عُمراً","لَعَلّي حينَ أُصبِحُ لَستُ أُمسي",15,"س",2,0],["وَما أَدري إِذا ما جُنَّ لَيلٌ","أَشَوقاً في فُؤادي أَم حَريقا",16,"ق",2,0],["وَما أَدري وَقَد حَثّوا المَطايا","أَيَحمِلُ شُرَّ بَرقٌ أَم بُراقُ",17,"ق",1,0],["وما أدامَتْ له الأيّامُ حَزمَك أو","عاداتِ نصرك في بَدْءٍ وفي عَقبِ",18,"ب",1,0],["وَما أَدَبَ الأَقوامِ في كُلِّ بَلدَةٍ","إِلى المَينِ إِلّا مَعشَرٌ أُدَباءُ",19,"ب",3,0],["وَما أَدري أَمَن فَوقَ المَهارى","أَلَبُّ إِذا نَظَرتُ أَمِ المَهارى",20,"ر",2,0],["وَما أَدري بِما سَيَكونُ مِنّي","وَلَكِن في البَسيطَةِ أَوسِعوا لي",21,"ي",1,0],["وَما آدَمٌ في مَذهَبِ العَقلِ واحِداً","وَلَكِنَّهُ عِندَ القِياسِ أَوادِمُ",22,"م",1,0],["وَما أَدري أَعِلمُهُما كَعِلمي","بِهَذا الأَمرِ أَم لا يَعلَمانِ",23,"ن",1,0],["وَمَا أَدَّيْتُهُ نَقْلاً","لَقَدْ أَدَّيْتهُ فَرْضَا",24,"ض",2,0],["وَما أَدَّعي أَنَّ الخُطوبَ تُخيفُني","لَقَد خَبَّرَتني بِالفِراقِ النَواعِبُ",25,"ب",1,0],["وما أدري: أُربحٌ مُشْتَرانا","تُرابَك بالجواهرِ، أمْ خَسَار؟",26,"ر",1,0],["وَما أَدَّعي أَنّي عَلى الحُبِّ صَخرَةٌ","وَأَنَّ فُؤادي لايَحِنُّ وَلا يَصبو",27,"ب",2,0],["وَمَا أَدْرِي لَهُ مِن أَيْنَ هذا","بَلَى أَدْرِي وَقَدْ تُعْدِي العَوائِدْ",28,"د",1,0],["وَما أَدراكَ ما أَطلال سَلمى","رُسوم لا طَعام لَها وَلا ما",29,"م",2,0],["وما أدْماءُ أُمُّ طَلاً أطافَتَ","بأبطَحَ تَرتْعي زَهْرَ الخُزامى",30,"م",2,0],["وما أُدِّيَتْ حَقَّ الأداء فَرائِضٌ","إذا لَمْ يُقارِنْها الفتَى بِنَوافل",31,"ل",1,0],["وما أدّعِي أنّي بإسماعِ ظِنّةٍ","أروّجُ لي زَيْفاً ومثْلُكَ يَنقُد",32,"د",1,0],["وما أدّعِي أن الهمومَ اقتَنَصنَني","ببازٍ بَدا من حيثُ طارَ غُراب",33,"ب",1,0],["وَما أَدخَلتُ نارَ الهَجرِ قَلباً","بَقي مِن حُبِّهِ مِثقالُ ذَرَّه",34,"ر",2,0],["وَما أَدري إِذا يَمَّمتُ وَجهاً","أُريدُ الخَيرَ أَيُّهُما يَليني",35,"ن",2,0],["وما ادخروا إلا حساماً وذابلاً","ومهراً يباري الريح عند سراها",36,"ا",3,0],["وما أدري أهاج النّوق منه","غرام حين أَومَضَ أَمْ خيال",37,"ل",1,0],["وما أدري إذا طاشتْ رجال","رجالٌ أمْ جبال من حلوم",38,"م",1,0],["وما أدركوا منها مراماً ولا مُنًى","ولا ظفِروا منها بلبٍّ ولا قشر",39,"ر",1,0],["وما ادَّخرت للدهر مالاً يد امرئٍ","يُعدُّ الثناءَ المحض من أنفس الذخر",40,"ر",1,0],["وما ادّعى الفخر مجدٌ في صنائعه","إلاَّ أقام عل ما قال برهانا",41,"ن",2,0],["وما أدري على أيّ اتكال","وثقنا بالسلامة واعتماد",42,"د",1,0],["وما أُدَاجِيكَ في حَدِيثِ صَباً","أَخْلَقْتُ فيهِ بُرُودَ أَخْلاَقِي",43,"ق",2,0],["وما أدري المشانق ساخرات","أحق بهم أم النطع المحاذى",44,"ذ",2,0],["وما أدَّعيهِ غيرُ خافٍ مكانُهُ","وهل لضياء الصبح من ناظرٍ جَحْد",45,"د",1,0],["وما أدبى إلاّ كتابٌ مكرَّمٌ","تراجعُ حرب الدهر وهي به سلم",46,"م",1,0],["وما أدعي مدحاً يقوم بشكره","علي ولكني مدحت به شعري",47,"ر",2,0],["وَما أَدري أَعارَت أَم أُعيرَت","مَحاجِرها بَناتُ مَهى الصَريمِ",48,"م",1,0],["وَما ادري وان جامعت قوماً","أَفيهم بغيتي أَم في الزيال",49,"ل",1,0],["وَما أدمَت مَناخِرَها بُراها","وَلا عَرفَت خَواصِرُها حِبالا",50,"ل",2,0],["وَما أَدري أنبلاً أر","سَلَت في القلبِ أَم حدقا",51,"ق",2,0],["وما أدعي أني جليدٌ، وإنما","هي النفس ما حملتها تتحمل",52,"ل",1,0],["وما أدْرَكَ الحَصْبَاءَ حَتَّى رَأَيْتَهُ","يُعَفِّرُ وجهَ الذُّلِّ في كلِّ حَصْباءِ",53,"ا",2,0],["وما أدركت غايته بنظمي","ولو أدركت غايةَ ذي القروح",54,"ح",1,0],["وما أدري إذا أولجت فيه","أفتّقه بذلك أم أخيط",55,"ط",1,1],["وما أدَّعي الإحسانَ لكن أظُنُّها","ستعذُبِ في الأفواهِ عند التناشُد",56,"د",1,0],["وَما أَدراهُ بِالشَّكوى وَلكِن","تَدَلُّلُهُ يُؤَيِّدُهُ صِباهُ",57,"ا",2,0],["وَما أَدري بِمَن تَبدَأُ المَنايا","بِأَحمَدَ أَو بِأَشجَعَ أَو يَزيدِ",58,"د",1,0],["وما أدع السفارة بين قومي","ولا أمشي بغش إن مشيت",59,"ت",1,0],["وما أدراك ويحك ما عليٌ","فتكشف عن مناقبه اللثاما",60,"م",2,0],["وَما أَدرَكَ المَنشودَ إِلّا مُواظِبٌ","عَلَيهِ عَنيدٌ ثابِتُ الرَأيِ صائِبُه",61,"ب",2,0],["وما أدري لمن ابدي التهاني","وأنظم في معانيه حلاها",62,"ا",3,0],["وما أَدَّعي شَوْقاً فَسُحْبُ مَدامعي","تُتَرِجمُ عن شوقي إِليكم وتُعْرِب",63,"ب",1,0],["وَما ادّعى دُرَّ الكَلامِ لأَنَّهُ","صِفاتُكَ إِلّا أَنَّني أحسِنُ الرَّصفا",64,"ف",2,0],["وَما أَدَّعي أَنّي أَحِنُّ إِلَيكُمُ","وَيَمنَعُني الأَعداء مِن كُلِّ جانِبِ",65,"ب",1,0],["وما ادَّخروا الكثيرَ ولا أحسُّوا","بحربٍ تملأُ الدنيا عوان",66,"ن",1,0],["وَما اِدَّعيا فيها وَلَكن كِلاهُما","سُقي مِن هَوىً لَيلاً بِراحٍ مُوَرّقِ",67,"ق",1,0],["وَما أَدرَكَ الأَشياءَ غَير منطّقٍ","أخي لُطُفٍ يَمشي عَلى أَرضِهِ هَونا",68,"ن",2,0],["وما أدرى أسأل الدمعُ مني","حنينا أم تحدّر من ولوعي",69,"ع",2,0],["وما أدركت في قيس عيلان وترها","بنو منقرٍ إلاّ بأسياف مذجح",70,"ج",2,0],["وما أدرى علام سكَنت جسمي","وهل لك غايةٌ مما عملت",71,"ت",1,0],["وما أدرك الوهم فحافظة له","مؤخر تجويف أخير به حصل",72,"ل",1,0],["وما أدعي في دعوتي فضل عصمة","ولا استنزلت لي الشاردات من العصم",73,"م",1,0],["وما أدري بذنبٍ كان مني","به أُجزَى العقوبة بانتقام",74,"م",1,0],["وما أدلس نفسي كي أنفقها","جرب تجدني عين الصّارم الخدم",75,"م",1,0],["وَمَا أدَّيتَهَا إِلاَّ وَمُصغٍ","إِلَيكَ مَسَامِعاً غُصنٌ رَطِيبٌ",76,"ب",1,0],["وما أدري أعفو أم جزاء","من المولى وسوف إخال أدري",77,"ر",2,0],["وَما أَدماءُ مُؤَلِفَةٌ سَلاماً","وَسَدراً بَينَ تَنهِيَةٍ وَراحِ",78,"ح",1,0],["وما أدركتهم في هواك هوادة","وما أثتمروا إلا لما أمر البر",79,"ر",1,0],["وَما اِدّخرتُ لِيَوم الحَشرِ من عَمَلٍ","سِوى يَقيني وَحُبّي المُصطَفى الهادي",80,"د",2,0],["وَما أَدماءُ جُؤذَرَها تُراعي","وَتَدنو حينَ يُسمِعُها بُغاما",81,"م",2,0],["وما ادرى اذا ما الليل ولى","اياتي صبحه منه بديلا",82,"ل",2,0],["وما ادرى غريمي منك حتى","احاكمه واشفى منه قلبا",83,"ب",2,0],["وما أدع السفارة بين قومي","ولا أمشي بغشم إن مشيت",84,"ت",1,0],["وما أدركوا أن الليالي تداول","وما كان طول الصبر رهبا ولا رغبا",85,"ب",2,0],["وما ادَّخرتُ سوى الأحزانِ في خَلَدي","ومنزلي قَلِقُ التَّعبيرِ مُوصَدُه",86,"د",2,0],["وَما أَدْري كَأَنَّ الْكَفَّ طارَتْ","مَتى يُبْدينَ في عَطْفِ الْخُصورِ",87,"ر",1,0],["وما أدري أسيرُ الى المنافي","وليلُ البعدِ أقصرهُ طويلُ",88,"ل",1,0],["وما أدراكِ من قلبي بأنّي","غصيْنٌ قد حباكِ اليوم زهرا",89,"ر",2,0],["وما أدراكِ عن وجعِ الذراري","وقد صاحَ العراقُ على الغوالي",90,"ل",2,0],["وما أدلجت تثني إلى العشب ليتها","ولكن في وادي العقيق لها عشبا",91,"ب",2,0],["وما أدري ولكن ليت شعري","أأيقاظ أولئك أم نيام",92,"م",1,0],["وما أدري ولكن جل ظني","قد أخضرت براحته النديه",93,"ه",1,0],["وماأدراك حين يكون كونا","من الخدر المضمّخ بالعبير ؟!",94,"ر",1,0],["وما ادراك كم تبدو فقيرا","الى الدعوات في اليوم الرهيب",95,"ب",1,0],["وما أدري لأيهما انتمائي","فلي أرضٌ هنا وهناك أرض",96,"ض",1,0],["وما أدري أذاك له انقضاءٌ","وما تُجْدي الرماحُ ولا القسِيُّ",97,"ي",1,0],["‏ ‏وما أدبٌ نافع كالعلوم","‏ ‏ وجُلُّ التأدُّبِ ذو سيّئاتِ",98,"ت",1,0],["وَما ادَّارَأتُ إِلَّا خَلفَ عَجزٍ","بِأَعماقِ التَّذَكُّرِ غارَ قاعا",99,"ع",2,0],["وَما أَدري لِمَ الأَسيافُ غَرثى !؟","وَ مِن حَولَيَّ يُنكِرُها الإِزارُ !!",100,"ر",1,0],["وما أدري أيعلمُ بعضُ قومي","بما أشْقى به أم ليْسَ يدري؟",101,"ر",2,0]]}