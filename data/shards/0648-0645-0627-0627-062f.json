{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[86,"أعزي فيك أهلك أم أعزي","https://www.aldiwan.net/poem10368.html","الوافر"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[88,"بدت كالشمس يحضنها الغروب","https://www.aldiwan.net/poem45008.html","الوافر"],[47,"أما لجميل عندكن ثواب","https://www.aldiwan.net/poem25376.html","الطويل"],[72,"قوامك تحت شعرك يا أمامه","https://www.aldiwan.net/poem19681.html","الوافر"],[64,"جحودي لك تقديس","https://www.aldiwan.net/poem67635.html","الهزج"],[51,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[85,"إلام الخلف بينكم إلاما","https://www.aldiwan.net/poem63744.html","الخفيف"],[85,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[43,"أما في هذه الدنيا كريم","https://www.aldiwan.net/poem10573.html","الوافر"],[43,"ثياب كريم ما يصون حسانها","https://www.aldiwan.net/poem10578.html","الطويل"],[62,"لعمرك ما يرجى شفائي والهوى","https://www.aldiwan.net/poem52492.html","الطويل"],[2,"عفا من آل فاطمة الجواء","https://www.aldiwan.net/poem25055.html","الوافر"],[49,"أؤمل أن أخلد والمنايا","https://www.aldiwan.net/poem62029.html","الوافر"],[49,"نسيت منيتي وخدعت نفسي","https://www.aldiwan.net/poem62121.html","الوافر"],[52,"أبى آبي الهوى أن لا تفيقا","https://www.aldiwan.net/poem26799.html","الوافر"],[52,"ألم تعلم بما صنع الفراق","https://www.aldiwan.net/poem26808.html","الوافر"],[75,"حلفت بالسابغات البيض واليلب","https://www.aldiwan.net/poem69102.html","البسيط"],[46,"ألو الفضل في أوطانهم غرباء","https://www.aldiwan.net/poem21990.html","الطويل"],[46,"أقيمي لا أعد الحج فرضا","https://www.aldiwan.net/poem22042.html","الوافر"],[46,"رأيت المرء يهوي في هبوط","https://www.aldiwan.net/poem23243.html","الوافر"],[46,"إذا قيل غال الدهر شيئا فإنما","https://www.aldiwan.net/poem23293.html","الطويل"],[46,"طلبت مكارما فأجدت لفظا","https://www.aldiwan.net/poem23530.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54988","الوافر"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/852","الطويل"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[236,"أبثكم أني مشوق بكم صب","https://www.aldiwan.net/poem32178.html","الطويل"],[349,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[354,"على حكم الهوى أدر المداما","https://www.aldiwan.net/poem39957.html","الوافر"],[365,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[365,"أحن إلى تلك الضحى والأصائل","https://www.aldiwan.net/poem60806.html","الطويل"],[365,"أأحبابنا قد شقتمونا فأسعدوا","https://www.aldiwan.net/poem60942.html","الطويل"],[365,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[367,"لعينيه على العشاق إمره","https://www.aldiwan.net/poem17205.html","الوافر"],[387,"أفاطم قبل بينك متعيني","https://www.aldiwan.net/poem1844.html","الوافر"],[404,"شكت بلسان الحال طول جفاها","https://www.aldiwan.net/poem33365.html","الطويل"],[417,"رآها قد أضر بها الكلال","https://www.aldiwan.net/poem54006.html","الوافر"],[417,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[417,"لقد خفقت في النحر ألوية النصر","https://www.aldiwan.net/poem54141.html","الطويل"],[417,"متى لاح رسم الدار من طلل قفر","https://www.aldiwan.net/poem54144.html","الطويل"],[417,"يا نائبا غاب عني الصبر مذ بانا","https://www.aldiwan.net/poem54149.html","البسيط"],[417,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[433,"قامت حروب الهوى على ساق","https://www.aldiwan.net/poem12314.html","المنسرح"],[454,"لماذا الثورة اشتعلت لماذا","https://www.aldiwan.net/poem61350.html","الوافر"],[462,"ولما أناخ الدهر كلكل بأسه","https://www.aldiwan.net/poem16369.html","الطويل"],[465,"أنجل علي ما برحت محمداً","https://www.aldiwan.net/poem3305.html","عموديه"],[516,"أراجعة لي عيشة الزمن النضر","https://www.aldiwan.net/poem12118.html","الطويل"],[564,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[570,"فان يبل الشباب فكل شيء","https://www.aldiwan.net/poem51993.html","الوافر"]],"verses":[["وَما أَدَّعي أَنّي بَريءٌ مِنَ الهَوى","وَلَكِنَّني لا يَعلَمُ القَومُ ما بِيا",0,"ي",2,0],["وَما أَدري أَرُكنُ الجاهِ أَودى","وَقَد أَودَيتَ أَم رُكنُ الشَآمِ",1,"م",1,0],["وَما أَدري وَقَد زَوَّدتُ شِعري","وَظَنّي فيكَ بِالأَمَلِ الوَطيدِ",2,"د",1,0],["وما أدماء ترتع حول رَوض","ويرتع خلفها رشأٌ ربيب",3,"ب",1,0],["وَما أَدَّعي مايَعلَمُ اللَهُ غَيرَهُ","رِحابُ عَلِيٍّ لِلعُفاةِ رِحابُ",4,"ب",1,0],["وما أدري أتوقيعي بمصرٍ","وإلاَّ بالشآمِ فلن أُسامهْ",5,"م",2,0],["وَما آدَمُ إِلّاكَ","وَمَن في البَينِ إِبليسُ",6,"س",1,0],["وما أدراك ما الليثُ","وما غرك بالببْر",7,"ر",1,0],["وما أدراك ما السيلُ","وما غرك بالبحر",7,"ر",1,0],["وما أدراك بالموتِ","وما غرك بالدهر",7,"ر",1,0],["وَما أَدرى غَداةَ سُقيتُموهُ","أَتِرياقاً سُقيتُمُ أَم سِماما",8,"م",2,0],["وَما أَدَبي لِما أَسدَوهُ أَهلٌ","وَلَكِن مَن أَحَبَّ الشَيءَ حابى",9,"ب",2,0],["وَما أَدري أَذا داءٌ حَديثٌ","أَصابَ الناسَ أَم داءٌ قَديمُ",10,"م",1,0],["وَما اِدَّخَرَتها قُدرَةً في مُصَوِّرٍ","سِوى أَنَّها ما أَنطَقَت حَيَوانَها",11,"ن",3,0],["وما أدَّعِي إلا اكتفائي بنظرةٍ","إليك ودعوى العاشقينَ ضُروبُ",12,"ب",1,0],["وَما أَدري وَسَوفَ إِخالُ أَدري","أَقَومٌ آلُ حِصنٍ أَم نِساءُ",13,"ا",2,0],["وَما أَدري إِذا أَمسَيتُ حَيّاً","لَعَلّي لا أَعيشُ إِلى الصَباحِ",14,"ح",1,0],["وَما أَدري وَإِن أَمَّلتُ عُمراً","لَعَلّي حينَ أُصبِحُ لَستُ أُمسي",15,"س",2,0],["وَما أَدري إِذا ما جُنَّ لَيلٌ","أَشَوقاً في فُؤادي أَم حَريقا",16,"ق",2,0],["وَما أَدري وَقَد حَثّوا المَطايا","أَيَحمِلُ شُرَّ بَرقٌ أَم بُراقُ",17,"ق",1,0],["وما أدامَتْ له الأيّامُ حَزمَك أو","عاداتِ نصرك في بَدْءٍ وفي عَقبِ",18,"ب",1,0],["وَما أَدَبَ الأَقوامِ في كُلِّ بَلدَةٍ","إِلى المَينِ إِلّا مَعشَرٌ أُدَباءُ",19,"ب",3,0],["وَما أَدري أَمَن فَوقَ المَهارى","أَلَبُّ إِذا نَظَرتُ أَمِ المَهارى",20,"ر",2,0],["وَما أَدري بِما سَيَكونُ مِنّي","وَلَكِن في البَسيطَةِ أَوسِعوا لي",21,"ي",1,0],["وَما آدَمٌ في مَذهَبِ العَقلِ واحِداً","وَلَكِنَّهُ عِندَ القِياسِ أَوادِمُ",22,"م",1,0],["وَما أَدري أَعِلمُهُما كَعِلمي","بِهَذا الأَمرِ أَم لا يَعلَمانِ",23,"ن",1,0],["وَمَا أَدَّيْتُهُ نَقْلاً","لَقَدْ أَدَّيْتهُ فَرْضَا",24,"ض",2,0],["وَما أَدَّعي أَنَّ الخُطوبَ تُخيفُني","لَقَد خَبَّرَتني بِالفِراقِ النَواعِبُ",25,"ب",1,0],["وما أدري: أُربحٌ مُشْتَرانا","تُرابَك بالجواهرِ، أمْ خَسَار؟",26,"ر",1,0],["وَما أَدَّعي أَنّي عَلى الحُبِّ صَخرَةٌ","وَأَنَّ فُؤادي لايَحِنُّ وَلا يَصبو",27,"ب",2,0],["وَمَا أَدْرِي لَهُ مِن أَيْنَ هذا","بَلَى أَدْرِي وَقَدْ تُعْدِي العَوائِدْ",28,"د",1,0],["وَما أَدراكَ ما أَطلال سَلمى","رُسوم لا طَعام لَها وَلا ما",29,"م",2,0],["وما أدْماءُ أُمُّ طَلاً أطافَتَ","بأبطَحَ تَرتْعي زَهْرَ الخُزامى",30,"م",2,0],["وما أُدِّيَتْ حَقَّ الأداء فَرائِضٌ","إذا لَمْ يُقارِنْها الفتَى بِنَوافل",31,"ل",1,0],["وما أدّعِي أنّي بإسماعِ ظِنّةٍ","أروّجُ لي زَيْفاً ومثْلُكَ يَنقُد",32,"د",1,0],["وما أدّعِي أن الهمومَ اقتَنَصنَني","ببازٍ بَدا من حيثُ طارَ غُراب",33,"ب",1,0],["وَما أَدخَلتُ نارَ الهَجرِ قَلباً","بَقي مِن حُبِّهِ مِثقالُ ذَرَّه",34,"ر",2,0],["وَما أَدري إِذا يَمَّمتُ وَجهاً","أُريدُ الخَيرَ أَيُّهُما يَليني",35,"ن",2,0],["وما ادخروا إلا حساماً وذابلاً","ومهراً يباري الريح عند سراها",36,"ا",3,0],["وما أدري أهاج النّوق منه","غرام حين أَومَضَ أَمْ خيال",37,"ل",1,0],["وما أدري إذا طاشتْ رجال","رجالٌ أمْ جبال من حلوم",38,"م",1,0],["وما أدركوا منها مراماً ولا مُنًى","ولا ظفِروا منها بلبٍّ ولا قشر",39,"ر",1,0],["وما ادَّخرت للدهر مالاً يد امرئٍ","يُعدُّ الثناءَ المحض من أنفس الذخر",40,"ر",1,0],["وما ادّعى الفخر مجدٌ في صنائعه","إلاَّ أقام عل ما قال برهانا",41,"ن",2,0],["وما أدري على أيّ اتكال","وثقنا بالسلامة واعتماد",42,"د",1,0],["وما أُدَاجِيكَ في حَدِيثِ صَباً","أَخْلَقْتُ فيهِ بُرُودَ أَخْلاَقِي",43,"ق",2,0],["وما أدري المشانق ساخرات","أحق بهم أم النطع المحاذى",44,"ذ",2,0],["وما أدَّعيهِ غيرُ خافٍ مكانُهُ","وهل لضياء الصبح من ناظرٍ جَحْد",45,"د",1,0],["وما أدبى إلاّ كتابٌ مكرَّمٌ","تراجعُ حرب الدهر وهي به سلم",46,"م",1,0],["وما أدعي مدحاً يقوم بشكره","علي ولكني مدحت به شعري",47,"ر",2,0],["وَما أَدري أَعارَت أَم أُعيرَت","مَحاجِرها بَناتُ مَهى الصَريمِ",48,"م",1,0],["وَما ادري وان جامعت قوماً","أَفيهم بغيتي أَم في الزيال",49,"ل",1,0]]}