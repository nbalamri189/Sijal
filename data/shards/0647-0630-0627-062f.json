{"poems":[[74,"مدت إليك المعالي طرف مبتهج","https://www.aldiwan.net/poem18454.html","البسيط"],[74,"عجبت من طرفي وخد المليح","https://www.aldiwan.net/poem18490.html","السريع"],[53,"خل الزمان إذا تقاعس أو نجح","https://www.aldiwan.net/poem9425.html","الكامل"],[72,"أحبابنا حاشاكم","https://www.aldiwan.net/poem42787.html","مجزوء الرجز"],[89,"سل مالك الملك فهو الآمر الناهي","https://www.aldiwan.net/poem8201.html","البسيط"],[107,"نهض الغزاة فأين تمضي العير","https://www.aldiwan.net/poem43998.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54979","البسيط"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/206286","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[108,"الشهيد الأول","https://www.poetsgate.com/ViewPoem.aspx?id=179492",""],[108,"هرم يهوى","https://www.poetsgate.com/ViewPoem.aspx?id=179481",""],[105,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[190,"مناسب الناس تخفى في مغارسهم","https://www.aldiwan.net/poem44157.html","البسيط"],[382,"هذا دم الإبن عن نفسي أقدمه","https://www.aldiwan.net/poem59164.html","البسيط"],[470,"هبها دعاءك","https://www.aldiwan.net/poem36541.html","عموديه"],[482,"أبارقا شمته بالغور لماحا","https://www.aldiwan.net/poem15196.html","الرجز"],[505,"ما أحسن الصباح لما انبلجا","https://www.aldiwan.net/poem37671.html","الرجز"],[510,"ذو الأوتاد","https://www.aldiwan.net/poem27895.html","البسيط"],[520,"قل لابن دخان إذا جئته","https://www.aldiwan.net/poem12181.html","السريع"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"قارنها الدمع فبئس القرين","https://www.aldiwan.net/poem3004.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138363",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138276",""],[357,"","https://poetry.dctabudhabi.ae/diwan/poem/142216","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70865","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59600","الكامل"],[1012,"","https://poetry.dctabudhabi.ae/diwan/poem/132412","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80186","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80248","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136160","الرجز"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123299","البسيط"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108438","المجتث"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89542","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28046","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2254,"","https://poetry.dctabudhabi.ae/diwan/poem/83251","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87727","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102508","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87341","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100841","البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130055","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108233","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108250","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76533","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123518","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94564","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58014","البسيط"],[4755,"عَمَّ يَتَحَدَّثُون ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=184735",""],[4755,"عَن نَكبَةٍ فِي عَامِهَا الثَّالِثِ","https://www.poetsgate.com/ViewPoem.aspx?id=191999",""],[4767,"قد غادرتك","https://www.poetsgate.com/ViewPoem.aspx?id=178914",""],[4926,"يا ربِّ صلِّ على خير البريَّة","https://www.poetsgate.com/ViewPoem.aspx?id=171089",""],[3591,"تذكار حبك ما زال مسافراً","https://www.poetsgate.com/ViewPoem.aspx?id=149419",""],[5121,"أسْتَاذَةُ الدُّنيَا","https://www.poetsgate.com/ViewPoem.aspx?id=186880",""],[5136,"شوقي إلى دست الخلافة شيق","https://www.poetsgate.com/ViewPoem.aspx?id=121631",""],[5160,"صرحت تحن","https://www.poetsgate.com/ViewPoem.aspx?id=189828",""],[5770,"خمسون عاما","https://www.poetsgate.com/ViewPoem.aspx?id=178689",""],[5939,"طوفان لهفة","https://www.poetsgate.com/ViewPoem.aspx?id=178596",""],[6102,"شَظايا خَزَف ..","https://www.poetsgate.com/ViewPoem.aspx?id=184420",""]],"verses":[["هذا دليل الشباب الجون منسدل","فكيف لما يضيء الشيب بالسرج",0,"ج",1,0],["هذا دَمُ الراحِ به واقفٌ","وذا دَمُ الأدمعِ فيه يسيح",1,"ح",1,0],["هذا دواءٌ للهُمُومِ مُجَرَّبٌ","فاسْمَعْ نصيحَةَ حازِمٍ لك قدْ نَصَحْ",2,"ح",1,0],["هَذا دَلالٌ مِنكُمُ","دَعوهُ حَتّى نَلتَقي",3,"ق",2,0],["هذَا دُعَائِي وَحَسْبِي أَنْتَ مِنْ حَكَمٍ","يَعْنُو لَهُ كلُّ شَاهٍ أَوْ شَهِنْشَاهِ",4,"ه",1,0],["هذا دليلُ العِيرِ غُودِرَ وَحْدَهُ","خَلْفَ الأُلَى خَذلُوهُ فَهْوَ أَسِيرُ",5,"ر",1,0],["هَذَا دُعَاءٌ مِنْ فَيْضِ قَلْبِي","أَدْعُوهُ حِينَ احْتِسَاءِ كأْسِي",6,"س",2,0],["هذا دبيقي الثياب ملفف","بملابس صقلت وذا بمناشف",7,"ف",1,0],["هذا دَمِي في وَجْنَتَيْكِ عَرَفْتُهُ","لا تَسْتَطِيعُ جُحُودَهُ عَيْنَاكِ",8,"ك",1,0],["هذا دم -كدم الحسَبْ","نِ- عبيرُه كالمسك فاح",9,"ح",1,0],["هذا دم سال من وجه أغرَّ، ومن","قلب يروع قلوب الأُسْد في الأجم",10,"م",1,0],["هذا دَمِي سَيَسِيلُ يَجْرِي مُطْفِئاً","ما ثارَ في جَنْبَيَّ مِنْ نِيرانِ",11,"ن",1,0],["هذا دليل على ما بتّ أرمزهُ","عن معشر فيهم التشنيع والشعف",12,"ف",1,0],["هذا دم الإبن عن نفسي أقدِّمه","للآب سُفْتَجَةً في هذه الدنيا",13,"ي",2,1],["هذا دَمُ الفُقَراءِ يَنزِفُ مُصطفى","وَفَقيرُهُم يَبكي عليهِ الأفقَرُ!",14,"ر",1,0],["هذا دَمُ العُلَماءِ .. مَن أحْبَبْتَهُم","ذ ُبِحُوا على مَرأى الأنام ِوَسُفِّروا!",14,"ر",3,0],["هذا دواؤكَ كم لبَّيتَ داعيَه","لمّا دعاكَ وما استرشدتَ نُصّاحا",15,"ح",2,0],["هذا دليلٌ قاطعٌ بأَنَّهُ","من المضيقِ اللهُ يبدي الفرجا",16,"ج",2,0],["هذا دعاءٌ دعا به لسانك لَيْ","تهُ دعا قلبك الذي قسا وقلى",17,"ل",2,0],["هذا دخان الشعر أرسلته","إلى دخان المشعل الأسخف",18,"ف",1,0],["هذا دم الخليفة المظلوم","فاجتمعوا لموعد معلوم",19,"م",1,0],["هذا دعائي وجميعُ الورى","تقولُ من بَعْدِ دُعائِي أَمِين",20,"ن",1,0],["هذا دليل محبة روحية","اضحت بصدر رؤوسنا تتأصل",21,"ل",1,0],["هذا دليل أن روح القدس قد","قواك كالآباء والأبرار",22,"ر",1,0],["هذا دم الشهداء قد روى الثرى","يا من تحاول عامدا إنكاره",23,"ر",2,0],["هذا دواؤك يا مسعود فالْتمِسَنْ","هُ من قديرٍ على الأشياء رزّاقِ",24,"ق",1,0],["هذا دعانا بالسعيد لوجهة","طفقت أمانيها تُعين وتُسعد",25,"د",1,0],["هذا دليل علوه وجلاله","والعدل منه في كلا الأمرين",26,"ن",1,1],["هَذا دَمي فَأَروي الثَرى مِن سَفكِهِ","فَعَسى تَخف بِسكبِهِ النيرانُ",27,"ن",1,0],["هَذا دَمي قَد هاجَ يَغلو في الحَشى","وَجداً وَذا دَمعي السَخينُ تَحَدَّرا",28,"ر",2,0],["هذا دليلي بالنهى","ترجمه سر المدد",29,"د",1,0],["هذا دعائي ويا مَن سوف يسمعه","ساعد عليه وقُل ألفين آمين",30,"ن",1,0],["هذا دعاي وحسبي","ان يستجاب دعايا",31,"ا",3,0],["هذا دَليلٌ عَلى أَنَّ الإِمامَ لهُ","أَن يُعمِلَ الظَنَّ في مَن بِالفَسادِ حَري",32,"ر",2,0],["هذا دليلٌ بأنَّ القولَ قولكمُ","لا قوله وهو عندي أوضح السبل",33,"ل",1,0],["هذا دليل الرفع منه وهذه","أعلامه في آخر الأزمان",34,"ن",1,0],["هذا دم جال فينا من أوائِلنا","يهيج ذِكرى لِيَوم الدرجِ في الكَفَن",35,"ن",1,0],["هَذا دَمي الحُرُّ مَبذول إِلَيكَ فِدىً","لَو كانَ بَذل دَمي يُنجيكَ مِن خَطَر",36,"ر",1,0],["هذا دليل على التحقيق أن له","ربا يدبر مهما شاءه فيه",37,"ي",2,0],["هَذَا دليلُ تِرِفَّا الجاهِ فآعترفُوا","بأنَّ ذَلِكَ تَقريبٌ وتَسهيلُ",38,"ل",1,0],["هذا دليل علينا في تسامحنا","ان لا تعصب في الاديان والنحل",39,"ل",1,0],["هذا دمُ الإنصافِ فوقَ ثيابهم","يُبدي فظائعهم لعين الرائي",40,"ي",1,0],["هذا دجى في وجهه قالوا بلى","بل لحيةٌ سفاكةٌ بكربلا",41,"ل",2,0],["هذا دمي أجرَه لا تختشي قوداً","دم المتيم مطلولٌ بلا قودِ",42,"د",1,0],["هذا دلالك لم دلال الغيدِ","فارحم فؤاد متيم معمودِ",43,"د",1,1],["هذا دينارانِ فُندُق بِيعةِ اللَهِ","التي بهما اغتَنَت أَغنَى الغِنَى",44,"ا",1,0],["هذا دَمِي العهدُ الجديدُ وإِنَّهُ","لَيُراقُ عنكم بل جميع بَنِي الوَرَى",44,"ا",1,0],["هَذا دَواء حكومة امست تَرى","في القول نارا وَالكتابة نارا",45,"ر",2,0],["هذا دليل جليل دل أن له","فضلا على من له ميز وتفضيل",46,"ل",1,0],["هذا دعاءٌ من الصعبيّ أمزجه","مدحاً وحمداً وإني لستُ مهذارا",47,"ر",2,0],["هذا دليلٌ على قهرٍ ومقدرةٍ","من ربِّنا وهْو فعَّال لما يَرِدُ",48,"د",1,0],["هذا دَمِي فِي السَّطرِ يا لَيلَتِي","لا (الآنِسِي)عِندِي, ولا (الحارِثِي)",49,"ث",2,0],["هذا دَمِي فِي السَّطرِ يَبكِي مَعِي","لا الآنِسِي هذا، ولا الحارِثِي",50,"ث",2,0],["هذا دعائي والصلاة على الذي","بين الخلائق مثله لَم يُكرَمِ",51,"م",1,0],["هذا دعائي ومأمولي إجابته","وكيف لا وبها قد جاء تنزيل",52,"ل",1,0],["هذا دعاني أن أكون مندداً","ومفنداً ومباعداً ومحاذراً",53,"ر",2,0],["هَذَا دُعَائِي لَهَا بِجَنَّتِهَا","يَلُمُّ أُنْشُودَتِي فَيَنْسَجِمُ",54,"م",1,0],["هذا دليل عناية لك عينها","ترعى وأنك في الأمور موفق",55,"ق",1,0],["هذا دليلُ الحبّ هذا صدقه","من قبلكمْ قدْ ذاقهُ قيسُ الفتي",56,"ت",2,0],["هذا دمي وتقاتل الجلاد حتى مقلتيه","فأنا فلسطين التي لم تحنِ هامتها العليه",57,"ي",2,0],["هذا دلالٌ ممتعٌ، أم قسوةٌ","أم قد أَخذْتِ المَكرَ بالعشاقِ حِرفةْ؟!",58,"ف",2,0],["هَذا دَمِي ؛ مِنْ وَرِيدِ الشِّعرِ أَنزِفُهُ","قَصِيدَةً - بِاضطِرابِ النَّبضِ - تَرتَجِفُ",59,"ف",1,0]]}