{"poems":[[74,"مدت إليك المعالي طرف مبتهج","https://www.aldiwan.net/poem18454.html","البسيط"],[74,"عجبت من طرفي وخد المليح","https://www.aldiwan.net/poem18490.html","السريع"],[53,"خل الزمان إذا تقاعس أو نجح","https://www.aldiwan.net/poem9425.html","الكامل"],[72,"أحبابنا حاشاكم","https://www.aldiwan.net/poem42787.html","مجزوء الرجز"],[89,"سل مالك الملك فهو الآمر الناهي","https://www.aldiwan.net/poem8201.html","البسيط"],[107,"نهض الغزاة فأين تمضي العير","https://www.aldiwan.net/poem43998.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54979","البسيط"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/206286","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[108,"الشهيد الأول","https://www.poetsgate.com/ViewPoem.aspx?id=179492",""],[108,"هرم يهوى","https://www.poetsgate.com/ViewPoem.aspx?id=179481",""],[105,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[190,"مناسب الناس تخفى في مغارسهم","https://www.aldiwan.net/poem44157.html","البسيط"],[381,"هذا دم الإبن عن نفسي أقدمه","https://www.aldiwan.net/poem59164.html","البسيط"],[468,"هبها دعاءك","https://www.aldiwan.net/poem36541.html","عموديه"],[480,"أبارقا شمته بالغور لماحا","https://www.aldiwan.net/poem15196.html","الرجز"],[503,"ما أحسن الصباح لما انبلجا","https://www.aldiwan.net/poem37671.html","الرجز"],[508,"ذو الأوتاد","https://www.aldiwan.net/poem27895.html","البسيط"],[518,"قل لابن دخان إذا جئته","https://www.aldiwan.net/poem12181.html","السريع"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"قارنها الدمع فبئس القرين","https://www.aldiwan.net/poem3004.html","السريع"]],"verses":[["هذا دليل الشباب الجون منسدل","فكيف لما يضيء الشيب بالسرج",0,"ج",1,0],["هذا دَمُ الراحِ به واقفٌ","وذا دَمُ الأدمعِ فيه يسيح",1,"ح",1,0],["هذا دواءٌ للهُمُومِ مُجَرَّبٌ","فاسْمَعْ نصيحَةَ حازِمٍ لك قدْ نَصَحْ",2,"ح",1,0],["هَذا دَلالٌ مِنكُمُ","دَعوهُ حَتّى نَلتَقي",3,"ق",2,0],["هذَا دُعَائِي وَحَسْبِي أَنْتَ مِنْ حَكَمٍ","يَعْنُو لَهُ كلُّ شَاهٍ أَوْ شَهِنْشَاهِ",4,"ه",1,0],["هذا دليلُ العِيرِ غُودِرَ وَحْدَهُ","خَلْفَ الأُلَى خَذلُوهُ فَهْوَ أَسِيرُ",5,"ر",1,0],["هَذَا دُعَاءٌ مِنْ فَيْضِ قَلْبِي","أَدْعُوهُ حِينَ احْتِسَاءِ كأْسِي",6,"س",2,0],["هذا دبيقي الثياب ملفف","بملابس صقلت وذا بمناشف",7,"ف",1,0],["هذا دَمِي في وَجْنَتَيْكِ عَرَفْتُهُ","لا تَسْتَطِيعُ جُحُودَهُ عَيْنَاكِ",8,"ك",1,0],["هذا دم -كدم الحسَبْ","نِ- عبيرُه كالمسك فاح",9,"ح",1,0],["هذا دم سال من وجه أغرَّ، ومن","قلب يروع قلوب الأُسْد في الأجم",10,"م",1,0],["هذا دَمِي سَيَسِيلُ يَجْرِي مُطْفِئاً","ما ثارَ في جَنْبَيَّ مِنْ نِيرانِ",11,"ن",1,0],["هذا دليل على ما بتّ أرمزهُ","عن معشر فيهم التشنيع والشعف",12,"ف",1,0],["هذا دم الإبن عن نفسي أقدِّمه","للآب سُفْتَجَةً في هذه الدنيا",13,"ي",2,1],["هذا دَمُ الفُقَراءِ يَنزِفُ مُصطفى","وَفَقيرُهُم يَبكي عليهِ الأفقَرُ!",14,"ر",1,0],["هذا دَمُ العُلَماءِ .. مَن أحْبَبْتَهُم","ذ ُبِحُوا على مَرأى الأنام ِوَسُفِّروا!",14,"ر",3,0],["هذا دواؤكَ كم لبَّيتَ داعيَه","لمّا دعاكَ وما استرشدتَ نُصّاحا",15,"ح",2,0],["هذا دليلٌ قاطعٌ بأَنَّهُ","من المضيقِ اللهُ يبدي الفرجا",16,"ج",2,0],["هذا دعاءٌ دعا به لسانك لَيْ","تهُ دعا قلبك الذي قسا وقلى",17,"ل",2,0],["هذا دخان الشعر أرسلته","إلى دخان المشعل الأسخف",18,"ف",1,0],["هذا دم الخليفة المظلوم","فاجتمعوا لموعد معلوم",19,"م",1,0],["هذا دعائي وجميعُ الورى","تقولُ من بَعْدِ دُعائِي أَمِين",20,"ن",1,0]]}