{"poems":[[88,"لي كساء أنعم به من كساء","https://www.aldiwan.net/poem68838.html","الخفيف"],[3,"يا دارُ أينَ ترَّحلَ السُّكانُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10766&r=&rc=120",""],[170,"أقول والقلب له وقدة","https://www.aldiwan.net/poem47017.html","السريع"],[556,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[591,"أسير ألحاظ بخد أسيل","https://www.aldiwan.net/poem17692.html","السريع"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101861","البسيط"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101428","السريع"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85080","الكامل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32894","الرجز"],[5064,"ليلٌ حاتِميٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=199087",""],[5732,"يضوي ويسري","https://www.poetsgate.com/ViewPoem.aspx?id=177920",""],[5877,"الكيف","https://www.poetsgate.com/ViewPoem.aspx?id=52287",""],[6115,"من رافق الأنذال لو هومن مطانيخ الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=196476",""],[6243,"سحق الوهم ِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84440&r=&rc=14",""],[6300,"كلمات في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82851&r=&rc=22",""],[6300,"على لسان الكره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82874&r=&rc=45",""]],"verses":[["يا رِدائي وَأَنتَ خَيرُ رِداءٍ","أَرتَجيهِ لِزينَةٍ وَاِزدِهاءِ",0,"ا",2,0],["يا رِدائي جَعَلتَني عِندَ قَومي","فَوقَ ما أَشتَهي وَفَوقَ الرَجاءِ",0,"ا",2,0],["يا رداَ عبلة َ أين خيَّمَ قومها","لمَّا سَرَتْ بهمُ المَطيُّ وبانُوا",1,"ن",3,0],["يا رِدْفَهُ رِقَّ على خَصرِه","فإنّهُ حُمِّلَ ما لا يُطيقْ",2,"ق",1,0],["يا ردَّ ربّكُمُ إليَّ بعيدكمْ","وأَمال قلبكُمُ عليَّ يُميلُهُ",3,"ل",2,0],["يا ردْفَهُ جُرْتَ على خَصْرِهِ","رِفْقاً بِهِ ما أَنْتَ إِلّا ثَقِيلْ",4,"ل",1,0],["ياردفه وعليه الشعر منتثر","كأنه جبل سابت أفاعيه",5,"ي",2,0],["يَا رِدْفَهُ رِفْقاً على خَصْرِهِ","فَقَد تَشكَّى بِلسانِ الضَّنى",6,"ن",2,0],["يا ردفه بغناك كم","أزريت بالخصر الفقير",7,"ر",1,0],["يا رَدَّةَ الحاجِبِ عَن قَسوَةٍ","وَنَكسَةً مِن بَعدِ بُرء العَليل",8,"ل",1,0],["يا رِدَاءَ المسَاءِ مَا عُدْتَ تُجْدِي","فطَرِيقُ الشِّتَاءِ جِدًّا طَوِيلَهْ",9,"ل",2,1],["يَا رِدَاءَ المسَاءِ نَوْحِي وشَجْوِي","رميَانِي إِلَيكَ رُوحًا نَحِيلَهْ",9,"ل",2,0],["يارد على حوض المنايا إلى هيب","ان شاف له جما تباري غزاله",10,"ل",2,0],["يارد على بير المكارم ليا جال","ويشرب قراح العز لا صدّروا له",11,"ل",2,0],["يارد هماج الماء ولا يشرب من العذب الزلال","من خاشر الانذال وجهه بالنذاله يتربه",12,"ب",2,0],["يا ردِّتِي ما جَرَى؟ حتّى طلعْتِ لنا","في صَمْتِ من حرَثوا صدري ومَنْ زرَعُوا",13,"ع",3,0],["يا ردّة الحرفِ هذا الصمتُ يسكنني","أنساه ,أتركه خلفي ,نعودُ معا",14,"ع",2,0],["ياردّة الحرفِ التِي تغتالني","ما عُدْتْ فِي بَحْرِ الغرام ِغريقا",15,"ق",2,0]]}