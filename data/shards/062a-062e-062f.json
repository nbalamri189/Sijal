{"poems":[[79,"يا سراج الجمال يا ابن سراج","https://www.aldiwan.net/poem36668.html","الخفيف"],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[0,"لمن الديار غشيتها بِسحام","https://www.aldiwan.net/poem64.html",""],[95,"هل آية في السلم والحرب","https://www.aldiwan.net/poem9789.html","عموديه"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[29,"بان الخليط ولو طوعت ما بانا","https://www.aldiwan.net/poem4432.html","البسيط"],[29,"هل ينفعنك إن جربت تجريب","https://www.aldiwan.net/poem5665.html","البسيط"],[29,"حي الديار على سفي الأعاصير","https://www.aldiwan.net/poem5763.html","البسيط"],[45,"حتام نحن نساري النجم في الظلم","https://www.aldiwan.net/poem10575.html","البسيط"],[46,"طلل الجميع لقد عفوت حميدا","https://www.aldiwan.net/poem30553.html","الكامل"],[22,"إن الخليط أجدوا البين فانفرقوا","https://www.aldiwan.net/poem22068.html","البسيط"],[52,"راحت رواحا بين كناد","https://www.aldiwan.net/poem63898.html","السريع"],[52,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62279","البسيط"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1926","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[108,"آهة طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=179661",""],[79,"يا سراج الجمالِ يا بن سِراج","https://www.poetsgate.com/ViewPoem.aspx?id=33799",""],[170,"سرنا ومرآة الزمان بحالها","https://www.aldiwan.net/poem46877.html","الكامل"],[230,"تبسمت عن جوهر العقد","https://www.aldiwan.net/poem55243.html","السريع"],[234,"يأيها المعشوق لا فارقت","https://www.aldiwan.net/poem50918.html","السريع"],[240,"حث كؤوس الراح","https://www.aldiwan.net/poem32118.html","مجزوء الرجز"],[280,"أهلا بهن أهلة وكواكبا","https://www.aldiwan.net/poem25628.html","الكامل"],[315,"قدحت يد الأشواق من زندي","https://www.aldiwan.net/poem59518.html","أحذ الكامل"],[327,"بانت سليمى وأقوى بعدها تبل","https://www.aldiwan.net/poem56346.html","البسيط"],[327,"بان الخليط فقلبي اليوم مختلس","https://www.aldiwan.net/poem56356.html","البسيط"],[342,"ماذا يهيجك من ذكر ابنة الراقي","https://www.aldiwan.net/poem45424.html","البسيط"],[369,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[463,"أَصاب أو أخطأني راميا","https://www.aldiwan.net/poem55810.html","السريع"],[463,"لا تلمس الشمس يد","https://www.aldiwan.net/poem56236.html","مجزوء الرجز"],[482,"أشجاك قمري الأراك مغردا","https://www.aldiwan.net/poem15234.html","الكامل"],[482,"ألم الفراق نفى الرقاد ونفرا","https://www.aldiwan.net/poem15259.html","الكامل"],[558,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[564,"من كسر الطلم عن نفسه","https://www.aldiwan.net/poem69358.html","السريع"],[578,"أحق ما كان من قلبي تباريح","https://www.aldiwan.net/poem3654.html","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38156","الوافر"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61108","المتدارك"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130635","الكامل"],[1460,"","https://poetry.dctabudhabi.ae/diwan/poem/1898","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113954","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101023","الكامل"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106709","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118297","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48208","الرمل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106977","الكامل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46745","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112671","الرجز"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138766",""],[3665,"","https://poetry.dctabudhabi.ae/diwan/poem/34711","المنسرح"],[3715,"","https://poetry.dctabudhabi.ae/diwan/poem/17486","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59491","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28725","البسيط"],[5111,"قُدْسَاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=212591",""],[5421,"العام الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=212009",""],[5431,"روما وعربي مغترب....","https://www.poetsgate.com/ViewPoem.aspx?id=208557",""],[5563,"بيروت تثعب","https://www.poetsgate.com/ViewPoem.aspx?id=215318",""],[5956,"بالتجاوب لن أعابا","https://www.poetsgate.com/ViewPoem.aspx?id=192424",""],[327,"بانَ الخليطُ فقلبي اليَوْمَ مُختَلَسُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19144&r=&rc=3",""]],"verses":[["تَخْدَعُ النّاسَ بالفُتورِ فَفيها","نُسْكُ بِشْرٍ وسَطْوةُ الحَجّاجِ",0,"ج",1,0],["تَخدي عَلى يَسَراتٍ وَهيَ لاحِقَةٌ","ذَوابِلٌ وَقعُهُنُّ الأَرضَ تَحليلُ",1,"ل",1,0],["تَخدي عَلى العِلّاتِ سامٍ رَأسُه","رَوعاءَ مَنسِمُها رَثيمٌ دامِ",2,"م",1,0],["تَخْدُمُ كُلاًّ مِنهُمَا خَدْمَةً","رَاضِيَةً لِلْعَبْدِ وَالرَّبِّ",3,"ب",1,0],["تَخدي بِمُنخَرِقِ السِربالِ مُنصَلِتٍ","مِثلِ الحُسامِ إِذا أَصحابُهُ شَحَبوا",4,"ب",3,0],["تَخدي بِنا نُجُبٌ دَمّى مَناسِمَها","نَقلُ الحَزابِيِّ حِزّاناً فَحِزّانا",5,"ن",2,0],["تَخدي بِنا نُجُبٌ أَفنى عَرائِكَها","خِمسٌ وَخِمسٌ وَتَأويبٌ وَتَأويبُ",6,"ب",1,0],["تَخدي بِنا العيسُ وَالحِرباءُ مُنتَصِبٌ","وَالشَمسُ والِجَةٌ ظِلَّ اليَعافيرِ",7,"ر",1,0],["تَخدي الرِكابُ بِنا بيضاً مَشافِرُها","خُضراً فَراسِنُها في الرُغلِ وَاليَنَمِ",8,"م",1,0],["تَخدي بِمُنصَلِتٍ يَظَلُّ إِذا وَنى","ضُرَباؤُهُ حِلساً لَها وَقُتودا",9,"د",2,0],["تَخدي عَلى يَسَراتٍ في فَقارَتِها","كَأَنَّهُنَّ صُقوبُ العَرعَرِ السُحُقُ",10,"ق",1,0],["تَخدُمُ أَقواماً وَخَلَّيتَني","وَقَد تَراني حَيَّةَ الوادي",11,"د",2,0],["تَخدي بِها أُصُلاً بُزلٌ مُخَيَّسَةٌ","مِثلُ القُصورِ عَلَيها البُدَّنُ الخُرُدُ",12,"د",1,0],["تَخْدِي بِهِمْ رُجُفُ الأَلْحِي مُلَيَّثَةٌ","أَظْلاَلُهُنَّ لأَيْدِيهنَّ تَنْعِيلُ",13,"ل",1,0],["تَخدي عَلى العِلّاتِ سامٍ رَأسُها","رَوعاءَ مَنسِمُها رَثيمٌ دامِ",14,"م",1,0],["تَخْدَعُ الْجَامِحَ الشمُوسَ مِنَ الْقَوْ","لِ فَيُلْقِي الْعِنانَ سَهْلاً ذَلُولا",15,"ل",2,0],["تُخِّدُده عَبَراتُ الرضيعِ","ويحنو على الطِّفل وهْوَ جنين",16,"ن",1,0],["تخدَعُ الناس بالفتون ففيها","نسكُ بشر وسَطْوَة ُ الحجاجِ",17,"ج",1,0],["تَخِدُ الركابُ فلا تعوجُ بنا على","طَلَلِ الحبيب ولا تُحيي المنزلا",18,"ل",2,0],["تَخُدُّ بِالخَدِّ حشاصَبها","فكلُّ ما يشكو من الخَدِّ",19,"د",1,0],["تخدمه في السَّقْي ناعورةٌ","مَرْهاء لا يَرْقا لها ماق",20,"ق",1,0],["تَخدِمُ في مَواسِمِ الهَناءِ","وَالأَفراحِ",21,"ح",1,0],["تَخدي الركائِبُ والسّلاهِبُ حَوْلَهَا","تُرْدي كأسْطارِ الكِتابِ كتائبا",22,"ب",2,0],["تخدي على استصعابها ذللاً","وتبيت طوع القن والقد",23,"د",1,0],["تَخدي بِها مُجمَراتٌ ما يُؤَيِّسُها","مَروٌ وَلا أَمعَزٌ حامٍ وَلا جَبَلُ",24,"ل",1,0],["تَخدي بِهِم ضُمَّرٌ حُوصٌ وَسِيرَتُها","تَكادُ مِنها رِقابُ الرَكبِ تَنفَرِسُ",25,"س",1,0],["تَخدي يَداها وَرِجلاها عَلى شَرَكٍ","سَحَّ النَجاءِ بِهِ مِن بارِقٍ باقِ",26,"ق",1,0],["تَخُدُّ حَلْبةَ خَدّي كلّما ذكروا","منها سَوابقُ ما تَنفكُّ في حُضُر",27,"ر",1,0],["تخدعُ بالتأنيس من رامها","صِلُّ صَفاً لا يرهبُ الحاويا",28,"ي",2,0],["تَخدّ في الصخر ملا","طِمَ عليها تَخِدُ",29,"د",1,0],["تَخدي وقد مدَّ الهجيرُ رِواقَه","فاِخالُها تطسُ الاكامَ خَفَيْدَدا",30,"د",2,0],["تَخدي وأُنشِدُ مِن غرامٍ فوقَها","شعري فتجنحُ في الأزمَّةِ والبُرى",31,"ر",2,0],["تَخدي العِرَضنَةَ قَد تَقَسَّمَ طَرفَها","وَضَحُ الطَريقِ وَخَوفُ مَسِّ المُحصَدِ",32,"د",1,0],["تخْدُمُهُ الحسناءُ بل كُلُّهن","أعْنى بهنَّ السبعة النَّيرهْ",33,"ر",2,0],["تَخدي النَجائِبُ حَولاً في نَفائِفِها","لا يَأتيهِنَّ إِعياءٌ وَتَطليحُ",34,"ح",1,0],["تَخدّرُ بِالغَريبِ مِنَ المَعاني","وَتَبرزُ بِالبَديعِ وَبِاللّطيفِ",35,"ف",1,0],["تخدي فيحث ركائبها","لتذكركم سير خبب",36,"ب",1,0],["تخدي المطي بهم ولا أدري السرى","ألمسقط العلمين أم لزرود",37,"د",1,0],["تَخِدُ الفَيافي بِالرِحالِ وَكُلُّها","يَعدو بِمُنخَرِقِ القَميصِ سَمَيدَعِ",38,"ع",1,0],["تخدي بِأزوالٍ كريمٍ نَجعُهُم","لَيسوا بأوباشٍ ولا أشراطِ",39,"ط",1,0],["تخدي بها نجب السرى","بين المتالع والسهول",40,"ل",1,0],["تَخدِي بنَا في كُلِّ مَرتٍ صَحصَحِ","والآلُ يَحفِضُهَا بِهِ ويُقِيمُهَا",41,"م",3,0],["تخدى به في بطن كل تنوفة","دوية مغبرة الارجاء",42,"ا",2,0],["تخدِرُ الألبابُ من أَلحاظه","نظرةَ السحرِ وهل يُغْنِي الحذَرْ",43,"ر",1,0],["تخدي كذئب الدو أصحر هاجراً","أو كالظليم يثور منه الأبطح",44,"ح",1,0],["تَخدي بِهم في الوَغى قُبٌّ مساحِلُها","جُردٌ ضَوامِرُ أَمثالَ القَنا قُودُ",45,"د",1,0],["تَخديرُكَ الإماءَ والبَغايا","وسوق آل المصطفى سبايا",46,"ي",2,0],["تخدمها الأشرافُ طُرَّا وَهُم","يَرَونَ هَذا مِن أتم الكَمَال",47,"ل",1,0],["تَخدِمُهُ طولُ كُلَّ لَيلَتِها","خِدمَةَ عَبدٍ بِالذُلِّ مَأسورِ",48,"ر",1,0],["تَخدي بِهِ قُدُماً طَوراً وَتَرجِعُهُ","فَحَدُّهُ مِن وِلافِ القَبضِ مَفلولُ",49,"ل",1,0],["تخدى برحلي وآةٌ ذات معجمةٍ","وجناءُ ورديةُ العُثنونِ شمليلُ",50,"ل",1,0],["تَخدي عَلى ثَفِنات يَرتَمينَ بِها","إِذا المَطِيُّ وَنى لَم تَعرِف الخَوَرا",51,"ر",2,0],["تَخَدَّرَتْ فِتْيَةُ الأحْلامِ وَانْكَسَرَتْ","هَذِي الْحَقِيْقَةُ ، إنَّ النَّشْءَ أشْلاءُ",52,"ا",2,0],["تخدرت القلوب على الرزايا","وما عادت تدغدغها الوعودُ",53,"د",1,0],["تُخدرني بعطرٍ بربريٍّ","وهل برحيقها الوحشي أبرا ؟!!",54,"ر",2,0],["تخدَّدَ لوعةً صفحاتُ وجهي","‎أيا بغدادُ فَلْتُزْجي النجائبْ",55,"ب",1,0],["تُخَدِّر من صَغَى لك بابتسامٍ","تنير البُطْلَ تُظْهرهُ صوابا",56,"ب",2,0],["تخدي بهم ضمرٌ حوضٌ وسيرتها","تكاد منها رقاب الركب تنفرس",57,"س",1,0]]}