["أصيلُ العُلَى جَمُّ السّيادةِ ذِكْرُهُ","طِرازُ نُضارٍ في بُرودِ المَدائِحِ",1,"ح",1,0],["أُصيبَ بِذي مَضاءٍ أَريَحِيٍّ","بِهِ عِندَ الشَدائِدِ يَستَعينُ",2,"ن",1,0],["أُصيبَ فيهِ المَجدُ يَومَ اِنطَوى","وَالعُرفُ وَالسائِلُ وَالمُعسِرُ",3,"ر",1,0],["أُصِيبَ بهِ فَرْعا سُلْيمٍ كِلاهُما","فَعَزّ عَلَيْنا أنْ يُصابَ ونُرْغَمَا",4,"م",2,0],["أُصِيبَ بِسَهْمٍ جَنْبُهُ فَهْوَ صَابْرٌ","وَآخَرَ أَصْمَى بِكْرَهُ فَهْوَ ثَكْلانُ",5,"ن",1,0],["أَصيدَاءُ هَل قَيظُ الرَمادَةِ راجِعٌ","لَياليهِ أَو أَيّامُهُنَّ الصَوالِحُ",6,"ح",1,0],["أُصَيبَت بِهِ فِهرٌ فَلا اِنجَبَرَت لَها","مَصائِبُ بادٍ حَرُّها وَشَفيفُها",7,"ف",3,0],["أُصيبوا وَفي شَهرِ الصِيامِ بَقِيَّةٌ","لِسَبعِ لَيالٍ تِلكُمُ لَيلَةُ القَدرِ",8,"ر",1,0],["أُصيبَ المُسلِمونَ بِهِ جَميعاً","هُناكَ وَقَد أُصيبَ بِهِ الرَسولُ",9,"ل",1,0],["أصيدها في حبالِ الشعر عاثرة","يا حبَّذا الظبي في إشراك محتبل",10,"ل",1,0],["أصيبُ سَواء مقتله","على أنْ لستُ أعتمدُهْ",11,"د",2,0],["أُصيبَت بِقَتلى آلِ عَمرٍ وَنَوفَلٍ","وَبَعجَةَ فَاِختَلَّت وَراثَ رُجوعُها",12,"ع",3,0],["أَصيلٌ إِذا اِصطَكَّ الجُباهُ كَأَنَّما","يُمِرُّ الثِقالَ الراسِياتِ مِنَ الصَخرِ",13,"ر",1,0],["أَصيخي فَمَا بَيْنَ أَعشارِ قلبي","يرفُّ صَدَى نَوْحِكِ الخافِتِ",14,"ت",1,0],["أُصيبَتِ الدَولَةُ في غِنائِها","وَسَقَط البَنّاءُ مِن بِنائِها",15,"ه",2,0],["أُصيبَ المَجدُ يَومَ أصِبتَ فيهِ","وَلَم تَخلُ الفَضيلَةُ مِن شُكاةِ",16,"ه",1,0],["أُصيبَ مِنَ التُجارِ بِكُلِّ ضارٍ","أَشَدَّ مِنَ الزَمانِ عَلَيهِ نابا",17,"ب",2,0],["أَصيتُ لِمَولاهُ عَلى حُسنِ مَسمَعٍ","خَليقٍ بِشَغلِ السامِعِنَ وَمَنظَرِ",18,"ر",1,0],["أُصيبَت تَميمٌ يَومَ خَلّى مَكانَهُ","وَمَرَّت لَهُم بِالنَحسِ طَيرٌ بَوارِحُ",19,"ح",1,1],["أُصيبَت بِهِ عَمروٌ وَسَعدٌ وَمالِكٌ","وَضَبَّةُ عُمّوا بِالعَظيمِ مِنَ الأَمرِ",20,"ر",1,0],["أُصِيبَ العَيْشُ مِنك بِخَيْرِ حادٍ","يَحُثُّ ركائبَ الصَّهباءِ حَدْوَا",21,"و",2,0],["أَصيفُ وَأَشتو بَينَهُم فَكَأَنَّني","نَزَلتُ عَلى آلِ المُهَلَّبِ شاتِيا",22,"ي",2,0],["أصيّر الدمع لحناً","وأجعل الشعر نايا",23,"ا",3,0],["أُصَيِّرُ أَخفافَ النجيب مفاتحاً","لِهَمٍّ عليه للتنائف أقْفالُ",24,"ل",1,0],["أُصيبوا بالقوارِعِ راجفاتٍ","تَهُدُّ الشِّيبَ منهم والشَّبابا",25,"ب",2,0],["أَصيخوا فَمِن طورِ الهُدى اِنبَعَثَ النَدا","وَشيموا فَإِنَّ النورَ في الشَرقِ قَد بَدا",26,"د",2,1],["أَصَيدَ مَحزومٍ عَلى ظَهرِهِ","غُلبُ الحَمالاتِ وَجُرّامِها",27,"م",3,0],["أصيخوا فما هذا الذي أنا سامعٌ","برَعدٍ ولكن قَعقَعَ الحَلَقُ السَّرد",28,"د",1,0],["أَصيحُ جَهراً لا أَستَسِرُّ بِما","عَنَّفَني فيهِ مَن يُعَنِّفُني",29,"ن",2,0],["أُصيبَ زُناةُ القَومِ لَمّا تَوَجَّهَت","بِهِ أُمُّ حَمّادٍ إِلى مَضجَعِ الرَدي",30,"د",2,0],["أُصيبَ بُنَيّي حينَ أَورَقَ غُصنُهُ","وَأَلقى عَلَيَّ الهَمَّ كُلُّ قَريبِ",31,"ب",1,1],["أَصيغَةُ العالَمِ ذا","أَم طالَ دَهرٌ فَفَسَد",32,"د",1,0],["أصِيلُ الجَدّ سابقهُ تَراه","على الأَيْنِ المُكَرَّرِ مُسْتَريحا",33,"ح",2,0],["أُصيِبَ إِبنُ عَفّانَ الإِمامُ فَلَم يَكُن","لِذِي حَسَبٍ بَعدَ إِبنِ عَفّانَ مَغضَبُ",34,"ب",1,0],["أُصيبَ قصيدٌ فيه كفرٌ فنِيطَ بي","وكم شاعرٍ قيلتْ على فيه أشعارُ",35,"ر",1,1],["أصيد ضاقت به صحراؤه","فأعدته لأفق أرحب",36,"ب",1,0],["أُصيبت، ولم تَدر كيف تُبين","إذا سُئِلَت، فالجواب الأنين!!",37,"ن",1,1],["أصيغ امرؤٌ من نُضارٍ وطيبٍ","وصيغ امرؤ من تراب وماء؟",38,"ا",2,0],["أصيل العلا جم السيادة ذكره","طراز نضار في برود المدائح",39,"ح",1,0],["أصيل حبّ يستعيد الضّحى","وينطوي في الليلة العشوى",40,"و",2,0],["أصيخي إلى قصّتي إنّني","أقصّ هنا الجانب الأنكدا",41,"د",2,0],["أصيبَ بني حين أورق غصنهُ","وألقى عليَّ الهمَّ كلُّ قريبِ",42,"ب",1,1],["أصيبَ بشوقٍ فاستُخفَّتْ حصاتهُ","ولاَ يعرفُ التَّغميضَ إلاَّ تقلُّبا",43,"ب",2,0],["أصيخوا ولَوْ لاهْتزازِ القلوب","فليسِ من العدلِ أنْ تُوحدونا",44,"ن",2,0],["أصيح إذا عثوا في الأرض فيهم","بصوتٍ مثل صوت الليث عالِ",45,"ل",1,0],["أصيلُ العمر أتركه ضياعاً","إذ الأُوقات أَطيَبُها الأَصيل",46,"ل",1,0],["أَصيدُ المَها فيهنّ ثم يَصِدْنَني","فكلٌّ لقلبي بالشباب فَرائس",47,"س",1,0],["أُصيكَ بالبُعْدِ عن الناسِ","فالعِزُّ في الوحدة والياسِ",48,"س",1,1],["أصيخي إلى الحلي إني أرىالسوا","رَ يناجي بأمري السوارا",49,"ر",2,0],["أُصيبَ بِمَسٍّ من جُنونِ مزاولٍ","يُرارىءُ بِالعَينَينِ نَحو الفَراقِد",50,"د",1,0],["أصِيخوا فقد قام العزيز الّذي به","تدين خطوبُ الدهر بعدَ حِرانِ",51,"ن",1,0],["أصيح في نيكي لها","تقدمي تأخري",52,"ر",2,0],["أصيبُوا وكانُوا في العِبَادَةِ أُسْوَةً","شَبَاباً وشيباً بالغَوَاشِي الغَوَاشِمِ",53,"م",1,0],["أَصيخُ لما يوحي الغرامُ لمسمعي","فأَنظُمهُ طَوْراً وَأَنثُرُهُ أُخرى",54,"ر",2,0],["أُصيفر يرعفُ مِن نَحرِهِ","إِذا رَعف المرء مِن أَنفِهِ",55,"ف",2,0],["أصيبَتْ بقوم ما أُصيبَتْ ولم تصب","به مُضَرُ الحمرا ولا آل حميرَ",56,"ر",1,0],["أصيخوا لي فلي مَعَكم حديثٌ","عجيبٌ يوم أَنثوهُ غريبُ",57,"ب",1,0],["اُصيب ببلوى الجسم أيوبُ فاغتدى","به تضرب الأمثال اِذْ يذكرُ الصبرُ",58,"ر",1,1],["أَصيلُ سُطاً كاللَّيث يُردي صِيالُهُ","كريمٌ ضُحاه للَّندى والأصائل",59,"ل",1,0],["أصيحُ : أهلي...وأهلي كلُّهُم جُثَثٌ","مُبَعثَرٌ لََحمُها بينَ السَّكاكين ِ",60,"ن",1,0],["أصيحُ حِينذاكا","يا خَجلَةَ البَيانِ",61,"ن",1,0],["أُصيبتْ مقاتلُ كلّ الرّجال","وما أن أصابوا لِيَ المقتَلا",62,"ل",2,0],["أَصِيْدُ وَتَصْطَادُنِي تَارَةً","ظِبَاءُ القُصُورِ بِسِحْرِ الحَوَرْ",63,"ر",1,0],["أصيلُ طِبَاعٍ أَوْرَثَتْهُ مُرُوءَةٌ","شهامةَ نَفْسٍ والْخُطُوبُ تَنُوبُ",64,"ب",1,0],["أُصيبَ لَعَمرِ اللَهِ لَيسَ تُفيدُهُ","فَتيلاً عَلى دَرءِ المُصابِ جَحافِلُهُ",65,"ل",2,0],["أُصيبَ بِأُمٍّ بَرَّةٍ فَمُصابِها","مُصابٌ يَتيمٌ قَد خَلا مِن مَساعِدِ",66,"د",1,0],["أصيلَ السّيادَةِ سادَ الكُهُولَ","طِفلاً وَأَمِّرَ فيهِم غُلاما",67,"م",2,0],["أصيبو ولكن مقبلين دماؤهم","تسيل على الأقدام دون العراقب",68,"ب",1,0],["أصيخا بي بربكما اسمعاني","فإن نداء ذي الشكوى مريب",69,"ب",1,0],["أصيب في عَقلِهِ بالعَين إِذ لمعَت","فَقال قَد ذهب المَحصول وَالذَهبُ",70,"ب",1,0],["أُصيبَ خدَّاك باحمرارهما","وارتديا بالسَّوادِ والتحفا",71,"ف",2,0],["أَصيلٍ كَريمٍ مُعربٍ ثمَّ مقربٍ","وَسَهبٍ ذَريعٍ سَلهَبٍ لا يُدافَعُ",72,"ع",1,0],["أَصيدُ الحَسانَ وَيَصطَدنَني","وَتُعجِبُني الكاعِبُ المُعصِرُ",73,"ر",1,0],["أصيلُ رأىٍ إذا الأمر الفظيع عنا","للمال والنفس بين القوم بذال",74,"ل",1,0],["أصيحُ بالفأسِ هدِّمْ ما استطعتَ ولا","ترأفْ بأدمعِ هذا الماردِ الخَزَفِ",75,"ف",1,0],["أصيْحُ بهَا ، نَاشِبَا