{"poems":[[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[92,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[47,"إلَيكِ ما أنَا مِنْ لَهو، ولاْ طَرَبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=31582",""],[189,"عسى يجري الزمان على اختياري","https://www.aldiwan.net/poem14534.html","الوافر"],[463,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138323",""],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101495","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38192","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96658","الطويل"],[1552,"","https://poetry.dctabudhabi.ae/diwan/poem/203253","المجتث"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45617","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90848","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28631","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120211","الوافر"],[5219,"حبيبي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=193706",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5582,"أَخُنْسَ مَهاً أَمْ أَنْجُمٌ وَدَرارِ","https://www.poetsgate.com/ViewPoem.aspx?id=187012",""],[5956,"ما جاء لي من أي ضَوءٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193825",""]],"verses":[["مرصوفة السحر خلت حاديها","من أرض حسّان أقبلت عصره",0,"ر",2,0],["مَرصودةٌ ستُّ الجهات لساعةٍ","نكراءَ محسودٌ بها المتطلِّع",1,"ع",1,0],["مَرْصُوفَةٍ باللآلي مِنْ نَوَادِرِهَا،","مَسبُوكَةِ اللّفظِ وَالمَعنَى من الذّهبِ",2,"ب",1,0],["مُرصَّعةَ الزمردِ باللآلى","مُفصَّلة الجَواهر بالنُّضار",3,"ر",1,0],["مرصوعةً باسمك من خيرِ ما","لاثَ على مَفرِقه عاصبُ",4,"ب",1,0],["مرصع باللآلى جاء من ملك","إلى وزير له كل الفخار سعى",5,"ع",2,0],["مُرَصَّفٌ في سموط اليا","قوتِ والكلُّ جَوهَر",6,"ر",1,0],["مُرَصَّنةُ البُنيانِ ينفى زَواله","مُتمَّمَةُ التّشييدِ فيها كَمالُهُ",7,"ه",1,0],["مُرصّعة مِن لؤلؤٍ وزبرجدٍ","وَمِن فضةٍ محليّة ونضارِ",8,"ر",1,0],["مرصع بلآل","مشرف بمثال",9,"ل",1,0],["مُرَصَعة بِالدُر مِن كُلِ جانب","يَزر عَلَيها في الهَواء بِاِزرار",10,"ر",1,0],["مُرَصع لِبَديع النَطق مُحتَشم","مشفع في جَميع الخَلق محتكم",11,"م",1,0],["مرصع تاج الفضل في در منطق","غدا عالي الأنفاس أنفس غالي",12,"ل",2,0],["مُرصَدٌ بِالخُلوفِ وَالمَن","عِ مِن حَيثُ رُمتُه",13,"ت",2,0],["مرصفة مرصصة المرامي","مسدد رومه خلل الحروف",14,"ف",1,0],["مرصعة بياقوت ودر","وراح القلب يلتمس الطبيبا",15,"ب",2,0],["مرصعٌ بنظيم النطق في الحكم","مرقعٌ بعظيم الخلق والحلم",16,"م",1,0],["مُرَصَّعَةٍ مِنْ لُؤْلُؤٍ وَزَبَرْجَدٍ","وَمِنْ فِضَّةٍ مَجْلِيَّةٍ وَنُضارِ",17,"ر",1,0],["مرصودة دررُ اُبنِ أحمدَ للملا","مَا مثلُ سعْرِ كنوزه إغلاءا",18,"ا",3,0]]}