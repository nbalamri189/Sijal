{"poems":[[73,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[93,"أقبل العيد ولكن ليس في الناس المسره","https://www.aldiwan.net/poem8875.html","عموديه"],[46,"سعدت غربة النوى بسعاد","https://www.aldiwan.net/poem30559.html","الخفيف"],[54,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[69,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142017","الخفيف"],[136,"آي أطلال الأوداء","https://www.aldiwan.net/poem54896.html","المديد"],[196,"لا تراني وإن تطاولت عمدا","https://www.aldiwan.net/poem27629.html","الخفيف"],[463,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138245",""],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70970","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205768","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204900","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74247","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74301","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74057","الخفيف"],[4927,"أشواق الْعُشَّاْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=29719",""],[4994,"من قباب الجرح معراجي","https://www.poetsgate.com/ViewPoem.aspx?id=210700",""],[5358,"يا أم سالم","https://www.poetsgate.com/ViewPoem.aspx?id=202449",""],[5431,"كيف تقهر؟","https://www.poetsgate.com/ViewPoem.aspx?id=207618",""],[5628,"المخادعة","https://www.poetsgate.com/ViewPoem.aspx?id=178801",""],[5691,"الحبر والورقة","https://www.poetsgate.com/ViewPoem.aspx?id=206386",""],[5957,"سكت الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=182458",""],[6032,"خلب الغرام جنانا","https://www.poetsgate.com/ViewPoem.aspx?id=181523",""],[5309,"نحن قوم نريد عيشا كريما","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573936",""]],"verses":[["فَإِذا ضاقَ ذَرعُ كُلِّ همامٍ","بِمُهِمٍّ كانَ الأَشَدَّ الأَسَدّا",0,"د",2,0],["فَإِذا ضَيَّعتَها فَالكَونُ لا يَعدِلُ ذَرَّه","أَيُّها الباكي رُوَيداً لا يَسُدُّ الدَمعُ ثَغرَه",1,"ر",2,0],["فَإِذا ضَلَّتِ السُيوفُ غَداةَ الرَو","عِ كانَت هَوادِياً لِلهَوادي",2,"د",2,0],["فَإِذا ضاحَكَتهُ دُرَّةُ شَمسٍ","خِلتَهُ كُسِّرَت عَلَيهِ الحِلِيُّ",3,"ي",1,0],["فإذا ضَمِنْتَ لهُ فليسَ بِخائِفٍ","مِنْ مُبْرِقٍ يَوْماً ولا مِنْ مُرْعِدِ",4,"د",1,0],["فأذا ضمنا مكانْ","ضمً قلبين عاشقينْ",5,"ن",1,0],["فإِذَا ضَيفٌ ألَمَّ بِنَا","نَالَ مِنَّا خَيرَ إيَوَاءِ",6,"ا",2,0],["فَإِذا ضَمنا الحَديثِ وَبيتَ","فَكَأَنّي عَلى الجَميعِ أَميرُ",7,"ر",1,0],["فإذا ضاقت فعلِّقها أَبَا","طاهرٍ تَعلَقْ بفرّاجِ الكروبِ",8,"ب",1,0],["فإذا ضللنا السبل كانوا قادة","وإذا ارتشفنا العلم ساغوا موردا",9,"د",2,0],["فإذا ضاقت البلاد على حرٍّ كريم","فالهندُ غيرُ الحجاز",10,"ز",1,0],["فاذا ضلَّ تلام","أيها المولى الكريمُ",11,"م",1,0],["فاذا ضمني الفراش تقلّب","ت عليه لا أستطيع هجودا",12,"د",2,0],["فإذا ضلّ بالعلوم فريق","جعلوها وسائلاً للفناء",13,"ا",2,0],["فَإِذا ضَرَبت فَكُن بِسَيف ضارِباً","وَإِذا انتَسبت فَفي قَبايل حمير",14,"ر",1,0],["فَإِذا ضَربت فَكُن بِسَيف ضارِبا","وَإِذا اِنتَسَبت فَمِن سلالة حَيدر",15,"ر",1,0],["فَإِذا ضاقَت المَيادين جلا","في المَعالي موسّعاً ما ضاقا",16,"ق",2,0],["فَإِذَاْ ضَمَمْتُ حَبِيْبَةً مَحْبُوْبَةً","وَوَضَعْتُ زَنْدِيَ أَسْفَلَ الأَعْنَاْقِ",17,"ق",1,0],["فإذا ضِعتُ مِنكَ في غَيبِ معنى","لا تَلُمني واستَنطِق التَلميحا",18,"ح",2,0],["فإذا ضَحِكْتُ فضِحْكَتي","مِثْلي على شَفَتِي غريبَةْ",19,"ب",2,0],["فإذا ضمّ ضمها باجتياحٍ","وإذا همّ فالمدى يتسعر!!",20,"ر",1,0],["فإذا ضحكت ِ فكلُّ شئ ٍ ضاحك ٌ","وإذا بكيت ِ فكلُّ شئ ٍ باك ِ",21,"ك",1,0],["فإذا ضَيَّعْتما مقصِدَهُ","يدْلِجُ الناسُ بليلِ النَّفَقِ",22,"ق",1,0],["فإذا ضحكت الحزن يهرب خائفا","ويصير بالأفراح قلبك مفعما",23,"م",2,0],["فإذا ضللت فمن ضميرك أهتدي","فتضمني بين الحشا تحنانا",24,"ن",2,0],["فَإِذا ضَمَّتِ العُروبةُ أَبناءَ","بِلادي نِلنا المَرامَ العَظيما",25,"م",2,0]]}