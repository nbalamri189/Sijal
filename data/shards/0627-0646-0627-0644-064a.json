مس صبحي","https://www.poetsgate.com/ViewPoem.aspx?id=204624",""],[5518,"هو المختار (ﷺ)","https://www.poetsgate.com/ViewPoem.aspx?id=187373",""],[5539,"الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=194073",""],[5542,"هو المختار ( صلى الله عليه وسلم )","https://www.poetsgate.com/ViewPoem.aspx?id=9675",""],[5545,"رفيق الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=184833",""],[5573,"اشوف العلم للغادي مناره","https://www.poetsgate.com/ViewPoem.aspx?id=200316",""],[5614,"الترحال","https://www.poetsgate.com/ViewPoem.aspx?id=1357",""],[5616,"نُقوشٌ إسلاميَّةٌ على الحَجرِ الفِلَسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=205253",""],[5690,"بيمن سلطاننا عبد العزيز","https://www.poetsgate.com/ViewPoem.aspx?id=172150",""],[5694,"من العايدين","https://www.poetsgate.com/ViewPoem.aspx?id=132100",""],[5732,"يازين قلبي راح مني يباريك","https://www.poetsgate.com/ViewPoem.aspx?id=177888",""],[5749,"لوم العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=130035",""],[5829,"هل الهلال فهللوا","https://www.poetsgate.com/ViewPoem.aspx?id=180665",""],[5837,"بعيد الشبح","https://www.poetsgate.com/ViewPoem.aspx?id=179316",""],[5907,"صباح الخير","https://www.poetsgate.com/ViewPoem.aspx?id=176464",""],[5956,"شغلت وجودي","https://www.poetsgate.com/ViewPoem.aspx?id=181883",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[5956,"شكراً لتلفاز الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=193473",""],[5956,"أخلاقُ خالدَ أحمد با عشن كالصحابة","https://www.poetsgate.com/ViewPoem.aspx?id=200540",""],[5956,"أقصوصة بغلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204061",""],[5956,"أودع حُلمي بكل ارتياح","https://www.poetsgate.com/ViewPoem.aspx?id=204375",""],[5956,"إن المهيمن وحده هو قادر","https://www.poetsgate.com/ViewPoem.aspx?id=208056",""],[5957,"أبدعتَ في دور المحب","https://www.poetsgate.com/ViewPoem.aspx?id=53702",""],[6106,"سقوط العاهر : امريكا","https://www.poetsgate.com/ViewPoem.aspx?id=6848",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[6351,"مخطوطة للمتنبي.. لم تُحقَّق بعد!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86051&r=&rc=4",""]],"verses":[["إِنّا لَيَجمَعُنا البُكاءُ وَكُلُّنا","يَبكي عَلى شَجَنٍ مِنَ الأَشجانِ",0,"ن",1,0],["أنا ليثُ الليوثِ نفْساً وإن كن","تُ بجسمي ضئيلةً رَقشاءَ",1,"ا",2,0],["إن اليزيديين قوم أحرزوا","إرث الخلافة ليس فيه خلافُ",2,"ف",1,1],["ان اليقين لفي الشهود جميعه","والشك كل الشك في الاخيار",3,"ر",1,0],["إِنَّ اليَتيمَ هُوَ الَّذي تَلقى لَهُ","أُمّاً تَخَلَّت أَو أَباً مَشغولا",4,"ل",2,0],["إنّا لَيمنعُنا الكتابُ المُنْتَقَى","ويَردُّنا الدّينُ الأَبَرُّ الأَطْهَرُ",5,"ر",1,0],["إِنَّ اليَمامَةَ خَيرُ ساكِنِها","أَهلُ القُرَيَّةِ مِن بَني ذُهلِ",6,"ل",1,1],["إِنَّ اليَمامَةَ شَرُّ ساكِنِها","أَهلُ القُرَيَّةِ مِن بَني ذُهلِ",7,"ل",1,1],["إنّا لَيُنْجِدُنا السّماحُ على الّتي","تَذَرُ الغَمامَ المُستهِلَّ بَخِيلا",8,"ل",2,0],["إِنَّ اليَهودِيَّ خَلّى جَهلُهُ اِمرَأَةً","كانَت عَقيماً وَخَيرُ النُسوَةِ العُقُمُ",9,"م",1,1],["إن اليراع إذا ونى","فالسيف أَحفظ للذمام",10,"م",1,0],["إن اليهود أصابوا","من التجارة مالا",11,"ل",2,1],["أنا لِيَ عمّن كنتُ أطوي ودادَهُ","مقال إلى الشنآن والحقد سائقُ",12,"ق",1,0],["إِنَّ اليَهودَ بِحُبِّها لِنَبِيِّها","أَمِنَت مَعَرَّةَ دَهرِها الخَوّانِ",13,"ن",1,1],["إن اليراعةَ في أنامل طالبٍ","كالسيف في كفِّ المدَرَّع أبْتَرا",14,"ر",2,0],["انا لي دينان : دينٌ جامع ٌ","وعراقي وغَرامي فيه دِين",15,"ن",1,0],["أنا ليس لي عنه غنى فلو ارتضى","دينَ المسيح فانني بِطْريقه",16,"ق",2,0],["أنا ليامنّي تضايقت وأحزنت","من ضيقتي تحزن لحزني جماعه",17,"ع",2,1],["إنَّا ليوثٌ شهدوا أنها","أشبالُ ذاكَ الأسدِ الكاسرِ",18,"ر",1,0],["إِنَّ اليَتيمَ مَنِ اِمَّحى وجدانُهُ","هُوَ مَن يَسوقُ الظُلمَ لا مَن يُظلَمُ",19,"م",1,0],["إِنَّ اليَتامى مَن يَمُجُّهُمُ الوَرى","لَيسَ اليَتامى مَن يَضُمُّ المَيتَمُ",19,"م",1,0],["ان اليغانم سر اللَه في برع","شهب الهدى وَالنَدى وَالعلم وَالعمل",20,"ل",1,0],["إنَّ اليقينَ إِلى البَراءةِ مِن","رَيبٍ يُوَهِّنه ومِن شَكِّ",21,"ك",1,0],["إنَّا لَيَحظى هُنا مَن عََنكَ يَسألُنا","بِسائِل ٍعَنكَ ما غَصَّتْ نَوادينا !",22,"ن",2,0],["أنا ليلَى التُّونِسيَه","خَيرُ حسنَاءٍ صَبِيَه",23,"ه",1,1],["أنا ليس تلهيني الملا","هي بل أنا أُلهي الملاهي",24,"ا",3,0],["أنا ليلة القدر التي","هي خير قل من ألف شهر",25,"ر",1,0],["أنا ليلى وهِيَ قيسٌ فاعجبوا","كيْف مني كان مطلوبي إليّ",26,"ي",1,0],["إِنَّ اليقينَ هو الممَا","تُ وما سِواهُ هُوَ الظُّنُونُ",27,"ن",1,0],["أَنا لي مِنْكَ قَسْوَةٌ وَصُدودٌ","وَلغَيْرِي تَعَطُّفٌ وَوِصَالُ",28,"ل",1,0],["إن اليواقيت من أرض معادنها","والسكر المنتقى نوع من الوشل",29,"ل",1,0],["إن الينور إذا توَّضح نورها","وَّد الضحى منها أحمرار خدود",30,"د",1,0],["إن الينور وقد وردتُ رضابها","مُزج اللمى بالكوثر المورود",30,"د",1,0],["إن الينور وقد أنار جبينها","لمجالُ أفكاري وصُبح هجودي",30,"د",2,0],["أنا ليوسفي الناصر الملك الذي","أبيد ذراريَ العدا وأبيح",31,"ح",1,0],["أنا لي غدُ الآفاق لي","آمالها أنا لي غدي",32,"د",2,0],["أنا لي شتاء من شقائك","غارق بسيول مزن",33,"ن",1,0],["أنا لي ربيع أنور","يختال بالذيل الرفنّ",33,"ن",1,0],["إنا ليرجونا ويخشانا الورى","أبداً لنيل مُنًى ونيلِ منونِ",34,"ن",1,1],["إنّ اليراع بكفّه لا يثني","يروي لك الدّنيا ببضعة أسطر",35,"ر",1,1],["أنا لي أبٌ يحنو عليّ ولي","أمٌ تذوب لفرقتي كمدا",36,"د",2,0],["أنا لي حبيب مدّ لي يده","أأمد طوعاً للمنون يدا",36,"د",2,0],["أنا ليس لي إلا اختبارات غدت","مرسومةً بالنار فوق جبيني",37,"ن",2,0],["أنا ليس لي إلا ولا","ه وسيلةٌ يوم الجزاءِ",38,"ا",2,0],["ان اليتامى فارقتها روحها","بنواك ثم أوت إلى الأجساد",39,"د",1,0],["إن اليسوعي أولى من يقول أنا","أهلي الورى وفسيح الكون أوطاني",40,"ن",2,0],["أنا ليث على عدوك سلم","لك في الحرب فابتذلني وصلني",41,"ن",2,0],["إن اليقين قواطع عقلية","ميزانها هو منطق اليونان",42,"ن",1,0],["أنا ليس لي عقل النبيّ وفيَّ مِن","روح النبيّ محبّة الإصلاح",43,"ح",1,0],["إن اليئايئ اخفُّ الطيرِ أرواحا","نعم وأشرَعُها في السعي إنجاحا",44,"ح",2,1],["أنا لي غضبة ولكن حليم","أنا بي جنة ولكن لبيب",45,"ب",1,0],["أَنا لَئن صَدَّ أَو جَفاني","فَإِني وَلا جُناح",46,"ح",1,0],["أنا لي فؤادٌ في هواك عليلُ","وأرى ودادك ملوءهُ تعليلُ",47,"ل",1,1],["إن اليراعة والبلاغة بيننا","نسبٌ يمت به من الأنسابِ",48,"ب",1,0],["أنا ليل وكل حسناء شمس","فاجتماعي بها من المستحيل",49,"ل",1,0],["أنا ليثُ الليوثِ إذا السَّواعي","تَنَاقلُ فوق أجسامٍ وهامٍ",50,"م",1,0],["إِن اليراعَ هَديةٌ","أَغلى مِنَ الدُرِّ الثَمينْ",51,"ن",1,0],["إِن اليَتامى وَجَرحى الحَربِ كُلَهِمُ","يَدعو لِباذلكم سراً وَإِعلانا",52,"ن",2,0],["إِن اليَتامى إِن تَنَغَّصَ حالُهُم","غَضِبَ الإِلَهُ وَاَجَدَبَت أَقطارُ",53,"ر",1,0],["إن اليهودَ وإن قلُّوا وإن وهنوا","كالصبغ في الماءِ أَو كالسم في الدسم",54,"م",1,0],["إن اليهودَ ملايينٌ تضيقُ بهم","رُبى فلسطينَ من سهل ومن أَكَمَ",54,"م",1,0],["ان اليراع الذي زانت لآلئه","اطواقكنَّ يكاد اليأس يفريه",55,"ي",2,0],["إن اليهود رُمُوا بالخبث فانهدموا","ولذَّةً آدمٌ زلت به القدمُ",56,"م",1,0],["أنا لَيسَ لِي (و اْتَّقُوْا)","ولا (إِنَّ لِلْمُتَّقِيْنْ)",57,"ن",1,0],["أنا ليسَ تُشعِلُ رَغبَتِي امرَأَةٌ","أنا ليسَ يُطفِئُ غُربَتي بَلَدُ",58,"د",1,0],["إن الينابيعَ التي منها جرت","تلك المودةُ لم تزل لك نابعة",59,"ع",2,0],["إنَّ اليهود لهم في دارنا طمع","أم زُبْدَة القول ما قالت به الزعما",60,"م",2,0],["أنا ليث الكتائب بن أبائي","بني خالد أباطرة التراجم",61,"م",1,0],["إن اليراع لهذا الخطب من زمن","لهوله انشق منه الرأس وانصدعا",62,"ع",2,0],["أنا ليلى .. بُعثتُ لأستبيحْ","لواءَ الشِّعر من قيسٍ ذبيحْ",63,"ح",1,1],["أنا ليلةٌ ضمن الليالي وُسّدتْ","أرجائُها بوسادةٍ خجَليه",64,"ي",2,1],["أنا لي عزوه وجمهور يعَزف الود مقطوعه","قصيدة هاجسي تطرب مسامعهم قوافيها",65,"ي",3,0],["أنا لي سنين آتعذب وانت حاديني حدي","على المفارق والتغلي والمجامل والريا",66,"ي",2,0],["أنَا ليْلٌ سَرَى وَالجِّنُ صَحْبِي","بِشِعْرٍ قدْ أنارُوا لِي ظَلامِي",67,"م",2,0],["(إَنَّ الْيَمَاْنِيْنَ مِنْ طَبْعِ الْوَفَاْءِ بِهِمْ)","رَاْمُواْ الْحُتُوْفَ فِدَاْءَ الْأَهْلِ والنَّسَبِ",68,"ب",1,0],["أنا لي با بطال الزمان غرام ُ","ويريبني في الباطل الإبهام ُ",69,"م",1,1],["أنا لي زوجة وعندي بيت","عامر والهنا بولدي وسيم",70,"م",1,0],["أنا ليلى وقيسٌ ما","طَواهُ المَوتُ لولاها",71,"ا",3,0],["انا لي حدّ ما اتعدا على حدّي","حدود الغير ما نطمع بأراضيها",72,"ي",3,0],["أنا ليسَ كَوْني غير حُبِّكَ وَحْدَهُ","بِهِ تُشْرِقُ الدنيا عَلَيَّ وتسطعُ",73,"ع",1,0],["إن اليراع الذي كتبت به","بديع حرف يذوب ما فهما",74,"م",2,0],["أنا لي ثمان سنين متولّعه واغليه","وعلى جملة اهل الحقد والعذل محتجّه",75,"ج",2,1],["إنَّ اليهودَ رسولُ اللهِ تنتظرُ","لمَّا أتاهمْ نبيُّ العرْبِ قد كفروا",76,"ر",3,1],["أنّ اليمانَ نقاوةٌ ومحبةٌ","به حكمةٌ هذي الشعوبُ الأطيبُ",77,"ب",1,0],["أنّ اليمان حفاوةٌ وأصالةٌ","تعزٌ وابٌ والجميلةُ مأربُ",77,"ب",1,0],["انا ليامني نويت افتل البيت","فتلت والشعار ما ينقضونه",78,"ن",2,1],["أنا لي قِبلَتا قلبٍ ، فيمَّمْ","تُ قلبي شطرَ نورِ القِبلتَين",79,"ن",1,0],["إنا ليؤلمنا تطاول كافر","ملأت مشارب نفسه الأقذار",80,"ر",1,0],["انا ليا شفت الوفا اتبع خطاه","ماني اللي الغذر فيهم طييعه",81,"ع",2,1],["انا ليؤلمنا تطاول كل كافر","ملأت مشارب نفسه الأقذار",82,"ر",1,0],["إنّ اليقين يُضيء النفس إن وجدتْ","فيها انعدامات صبرٍ عنك تحجبهُ",83,"ب",2,0],["انالي عين ولقصدي سفاره","ارد النور للعين الضريره",84,"ر",2,0],["انا لي عزة عليا تهز جبال","انا ما اهين لك نفسي لجل عيني",85,"ن",2,0],["إِنَّ الْيَهُودَ بِتَارِيخِ الْوَرَى بُؤَرٌ","أَلَمْ يَحِنْ بَعْدُ أَنْ تُسْتَأْصَلَ الْبُؤَرُ",86,"ر",1,0],["إِنَّ الْيَهُودَ رُؤُوسٌ كُلُّهَا يَبِسَتْ","لَكِنَّهَا تَحْتَ عُنْفِ الطَّرْقِ تَنْكَسِرُ",86,"ر",1,0],["أن اليراعة خدّام أناملهُ","كذا القواضب خدام لراحتهِ",87,"ت",2,0],["أنا ليامني هرجت أهرج صحيح","ماهوب هرجٍ ماوراه إلا الفشل",88,"ل",1,0],["انا لي ضاعت جهود الشبابيك","ارسي على صيد الوحش باحتيالي",89,"ل",2,0],["انا لي بنيت عالنظرة امال","وظنيت الحب فظروفي وتاني",90,"ن",2,0],["إن اليتامى والفقير وصيةٌ","من لم يصنها باء بالخسرانِ",91,"ن",1,0],["أنا لي وليفٍ بالتغلِّي ذبحني ذبح","مثل ذبحة المسلم لطاح بيد الكافر",92,"ر",1,1],["انا لي حظ بالدنيا تعبت اسايسه واعطيه","الى من جيت له عاني نهرني قال وش جابك؟ .",93,"ك",1,0],["أنا ليَ شعب أعيش إليه","فشعري وشغلي إليكم جميعا",94,"ع",2,0],["أنا لي طبْعُك يا حبي تماماً","عاطفيٌّ رغم كَوْني كالحديدِ",95,"د",1,0],["أنا ليس يشبعني اللقا","مهما إلهي أشبعكْ",96,"ك",1,0],["أنا ليس يمكنني الوفاء بذرّةٍ..","مهما أُحاولْ أنتكسْ متخلفا",97,"ف",2,0],["أنا لي نجلٌ موَلّهْ","ما بإنسٍ بلْ ببغلةْ",98,"ل",2,0],["أنا ليس يعشقني أي إنْسٍ","ولا حيوان ولو تك هرَّةْ",99,"ر",2,0],["أنا ليس في وُسْعي أعالج محنة","قد كونتْ عقداً بنا شوهاءا",100,"ا",3,0],["أنا لي فؤادٌ نابضٌ","بالحب دوما ملتهبْ",101,"ب",1,0],["إن اليهود طغوا وأنت نصيرهم","أين العدالة إن ربك جائر !",102,"ر",1,0],["أنا لي كبرياءُ نفس ٍ تضيقُ ال","يوم عنها فسائحُ الآفاقِ",103,"ق",1,0],["أنا لي صوتيَ الذي هو صوتي","وركوبي موجَ الصدى مستحيل",104,"ل",1,0]]}