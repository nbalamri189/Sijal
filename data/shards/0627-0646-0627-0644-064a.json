{"poems":[[47,"أتعز أنت على رسوم مغان","https://www.aldiwan.net/poem25112.html","الكامل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"إن اليزيديين قوم أحرزوا","https://www.aldiwan.net/poem65477.html","الكامل"],[89,"بثوا بألسنة لكم من نار","https://www.aldiwan.net/poem44922.html","الكامل"],[85,"قم للمعلم وفه التبجيلا","https://www.aldiwan.net/poem15422.html","الكامل"],[105,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[22,"إن اليمامة خير ساكنها","https://www.aldiwan.net/poem21701.html","الكامل"],[22,"إن اليمامة شر ساكنها","https://www.aldiwan.net/poem21702.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[46,"إن اليهودي خلى جهله امرأة","https://www.aldiwan.net/poem23303.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85498","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85831","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43917","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10254","الكامل"],[106,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[90,"خل النديم","https://www.poetsgate.com/ViewPoem.aspx?id=178950",""],[108,"كما كنت","https://www.poetsgate.com/ViewPoem.aspx?id=8398",""],[199,"قولوا لهذا الرشا الهاجر","https://www.aldiwan.net/poem45589.html","السريع"],[223,"حرم الجمال على سريرك يحلم","https://www.aldiwan.net/poem39695.html","الكامل"],[271,"لا عين العين فعل البيض والاسل","https://www.aldiwan.net/poem52059.html","البسيط"],[275,"فتح البسيطة عنكم محكي","https://www.aldiwan.net/poem25548.html","أحذ الكامل"],[465,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[538,"أنا ليلى التونسيه","https://www.aldiwan.net/poem48255.html","عموديه"],[558,"أنا صاحب الأمر الإلهي","https://www.aldiwan.net/poem33662.html","مجزوء الكامل"],[558,"الله أنزل حكم أمري","https://www.aldiwan.net/poem34521.html","مجزوء الكامل"],[559,"غير ليلي لم يرى في الحي حي","https://www.aldiwan.net/poem69333.html","الرمل"],[575,"الصبر بعدك لا يكون","https://www.aldiwan.net/poem2774.html","مجزوء الكامل"],[586,"هات قل لي كم الجفا والدلال","https://www.aldiwan.net/poem17650.html","الخفيف"]],"verses":[["إِنّا لَيَجمَعُنا البُكاءُ وَكُلُّنا","يَبكي عَلى شَجَنٍ مِنَ الأَشجانِ",0,"ن",1,0],["أنا ليثُ الليوثِ نفْساً وإن كن","تُ بجسمي ضئيلةً رَقشاءَ",1,"ا",2,0],["إن اليزيديين قوم أحرزوا","إرث الخلافة ليس فيه خلافُ",2,"ف",1,1],["ان اليقين لفي الشهود جميعه","والشك كل الشك في الاخيار",3,"ر",1,0],["إِنَّ اليَتيمَ هُوَ الَّذي تَلقى لَهُ","أُمّاً تَخَلَّت أَو أَباً مَشغولا",4,"ل",2,0],["إنّا لَيمنعُنا الكتابُ المُنْتَقَى","ويَردُّنا الدّينُ الأَبَرُّ الأَطْهَرُ",5,"ر",1,0],["إِنَّ اليَمامَةَ خَيرُ ساكِنِها","أَهلُ القُرَيَّةِ مِن بَني ذُهلِ",6,"ل",1,1],["إِنَّ اليَمامَةَ شَرُّ ساكِنِها","أَهلُ القُرَيَّةِ مِن بَني ذُهلِ",7,"ل",1,1],["إنّا لَيُنْجِدُنا السّماحُ على الّتي","تَذَرُ الغَمامَ المُستهِلَّ بَخِيلا",8,"ل",2,0],["إِنَّ اليَهودِيَّ خَلّى جَهلُهُ اِمرَأَةً","كانَت عَقيماً وَخَيرُ النُسوَةِ العُقُمُ",9,"م",1,1],["إن اليراع إذا ونى","فالسيف أَحفظ للذمام",10,"م",1,0],["إن اليهود أصابوا","من التجارة مالا",11,"ل",2,1],["أنا لِيَ عمّن كنتُ أطوي ودادَهُ","مقال إلى الشنآن والحقد سائقُ",12,"ق",1,0],["إِنَّ اليَهودَ بِحُبِّها لِنَبِيِّها","أَمِنَت مَعَرَّةَ دَهرِها الخَوّانِ",13,"ن",1,1],["إن اليراعةَ في أنامل طالبٍ","كالسيف في كفِّ المدَرَّع أبْتَرا",14,"ر",2,0],["انا لي دينان : دينٌ جامع ٌ","وعراقي وغَرامي فيه دِين",15,"ن",1,0],["أنا ليس لي عنه غنى فلو ارتضى","دينَ المسيح فانني بِطْريقه",16,"ق",2,0],["أنا ليامنّي تضايقت وأحزنت","من ضيقتي تحزن لحزني جماعه",17,"ع",2,1],["إنَّا ليوثٌ شهدوا أنها","أشبالُ ذاكَ الأسدِ الكاسرِ",18,"ر",1,0],["إِنَّ اليَتيمَ مَنِ اِمَّحى وجدانُهُ","هُوَ مَن يَسوقُ الظُلمَ لا مَن يُظلَمُ",19,"م",1,0],["إِنَّ اليَتامى مَن يَمُجُّهُمُ الوَرى","لَيسَ اليَتامى مَن يَضُمُّ المَيتَمُ",19,"م",1,0],["ان اليغانم سر اللَه في برع","شهب الهدى وَالنَدى وَالعلم وَالعمل",20,"ل",1,0],["إنَّ اليقينَ إِلى البَراءةِ مِن","رَيبٍ يُوَهِّنه ومِن شَكِّ",21,"ك",1,0],["إنَّا لَيَحظى هُنا مَن عََنكَ يَسألُنا","بِسائِل ٍعَنكَ ما غَصَّتْ نَوادينا !",22,"ن",2,0],["أنا ليلَى التُّونِسيَه","خَيرُ حسنَاءٍ صَبِيَه",23,"ه",1,1],["أنا ليس تلهيني الملا","هي بل أنا أُلهي الملاهي",24,"ا",3,0],["أنا ليلة القدر التي","هي خير قل من ألف شهر",25,"ر",1,0],["أنا ليلى وهِيَ قيسٌ فاعجبوا","كيْف مني كان مطلوبي إليّ",26,"ي",1,0],["إِنَّ اليقينَ هو الممَا","تُ وما سِواهُ هُوَ الظُّنُونُ",27,"ن",1,0],["أَنا لي مِنْكَ قَسْوَةٌ وَصُدودٌ","وَلغَيْرِي تَعَطُّفٌ وَوِصَالُ",28,"ل",1,0]]}