,"ونبئت والرحمن أكرم دافع","https://www.aldiwan.net/poem16059.html","الطويل"],[459,"ونبئت أن الدهر أحدث نبوة","https://www.aldiwan.net/poem16365.html","الطويل"],[477,"ألا بالتعاضد فلنبتد","https://www.aldiwan.net/poem37579.html","المتقارب"],[480,"نعمل من لهوى كسوى","https://www.aldiwan.net/poem24197.html","عموديه"],[493,"شماسة قلب ليس يألف طائره","https://www.aldiwan.net/poem9854.html","الطويل"],[514,"ونبه شوقي بعدما كنت نائما","https://www.aldiwan.net/poem48605.html","الطويل"],[522,"نبي براه الله من نوره الأسمى","https://www.aldiwan.net/poem13283.html","الطويل"],[536,"تبدت نجوم الفن في أفق الغرب","https://www.aldiwan.net/poem48272.html","عموديه"],[536,"آه بشرى لنا بعودة باشا","https://www.aldiwan.net/poem48295.html","عموديه"],[541,"أيا تملك يا تمل","https://www.aldiwan.net/poem1760.html","الهزج"],[549,"ألا لله ما صنع الحمام","https://www.aldiwan.net/poem47251.html","الوافر"],[549,"من ذا الذي ينجو من الآجال","https://www.aldiwan.net/poem47273.html","الكامل"],[549,"أضنا بالتواصل والتصافي","https://www.aldiwan.net/poem47391.html","الوافر"],[573,"هذا الغرام غرمت آخره","https://www.aldiwan.net/poem2878.html","أحذ الكامل"],[573,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[573,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"]],"verses":[["وَنبَغتُ فِي زمَنٍ أَخيرٍ أهْلُهُ","مَا ضَرَّ أنَّي لَسْتُ مِنْ ذُبْيَانِ",0,"ن",1,0],["وَنَبْلُغُ فِيْكَ الَّذِي نَبْتَغِي","وَذَاكَ عَلَى اللَّهِ سَهْلُ الْمَنَالِ",1,"ل",1,0],["وَنُبِّئتُ قَيساً وَلَم أَبلُهُ","كَما زَعَموا خَيرَ أَهلِ اليَمَن",2,"ن",1,0],["وَنَبَذتَ الثَراءَ تَبذُلُ فيهِ","مِن إِباءٍ في بَذلِهِ شَرُّ عابِ",3,"ب",1,0],["وَنَبَّأَهُ عِلمُ النُجومِ بِحادِثٍ","تَبيتُ لَهُ الأَبراجُ مُضطَرِباتِ",4,"ت",1,0],["وَنُبِّئتُها بَعدِيَ اِستُحمِدَت","بِسِرّي إِلَيكَ لِمَعنىً غَمَض",5,"ض",1,0],["وَنَبَذتُمُ التَقوى وَراءَ ظُهورِكُم","فَغَدا بَغيضَكُمُ التَقِيُّ الأَكرَمُ",6,"م",1,0],["وَنَبعَةٍ ذاتِ إِرنانٍ وَوَلوَلَةٍ","وَمارِنِ العودِ لا كَزٍّ وَلا عادِ",7,"د",1,0],["وَنُبِيحُ السُّيُوفَ أَكْبُدَنَا","إِذْ تَكُونُ الجُفُونُ أَجْفَانَا",8,"ن",2,0],["وَنُبِّئتُ كَلباً مِن كِلابٍ يَسُبُّني","وَمَرُّ كِلابٍ يَقطَعُ الصَلَواتِ",9,"ت",1,1],["ونَبِّهُ سيوفاً ماضيات على العدا","وخَلِّ جفونَ المرهفات تُهَوِّمُ",10,"م",1,0],["ونبع الصفا والقاع فيه كلاهما","من الحسن ملأى بالبدائع كأسه",11,"س",2,0],["وَنُبِّئتُ تَيماً نادِمينَ فَسَرَّني","بِما نَدِمَت تَيمٌ وَساءَت ظُنونُها",12,"ن",3,0],["وَنُبِّئتُ جَوّاباً وَسَكناً يَسُبُّني","وَعَمروَ بنَ عِفرى لا سَلامَ عَلى عَمروِ",13,"ر",2,0],["وَنَباتُ عيصِكُمُ لَهُ طيبُ الثَرى","وَقَديمُ عيصِكَ كانَ خَيرَ قَديمِ",14,"م",1,0],["ونُبِىء منك إلى مواهبَ جزلةٍ","رِفْداً من المعروف غير تَفَرُّقِ",15,"ق",1,1],["وَنُبِّئتُ أَنَّ أَبا مُنذِرٍ","يُساميكَ لِلحَدَثِ الأَكبَرِ",16,"ر",1,1],["ونبعة الملك قد طالت وقد رسخت","فالناس من ظلها في عيشة رغد",17,"د",1,0],["ونبهت عيداني بنوحٍ على الدّجى","وما ناحَ قمريٌّ ولا ماسَ عوده",18,"د",2,0],["ونبهني الحال الذي بأقله","ينبه من سكر الغرام كثَير",19,"ر",1,0],["ونبوَّةٌ شفت القلوب وبينت","إن الكتاب كما رأيت حكيم",20,"م",1,0],["ونبهت من قدري الذي طال واعتلى","وأقدار قوم في التراب رمائم",21,"م",1,0],["ونُبِّئتُ أنك في مَلطمٍ","لحرِّ هجائي وفي مَخمَش",22,"ش",1,0],["ونبخس شكره فله اغتفارٌ","ونظلمُ مالَه فله اظطلامُ",23,"م",1,0],["وَنُبِّئتُ تَيمَ اللاتِ تَنذُرُ مُهجَتي","وَفيها هِلالٌ طالِعٌ وَمُزاحِمُ",24,"م",1,0],["وَنَبيتُ نَفخَر بِالصَوارِمِ وَالقَنا","وَرِقابُنا مَمدودَةٌ لِلفاسِ",25,"س",1,0],["وَنَبَتَّ شَرَّ بَني تَميمٍ مَنصِباً","دَنِسَ المُروءَةِ ظاهِرَ الأَعيارِ",26,"ر",1,0],["ونبيٍّ قَدْ جاءَ للنَّاسِ بالحَقِّ","فكالوا لهُ الشَّتائمَ كَيْلا",27,"ا",1,0],["ونبيلٍ وجدتَهُ في ضياءِ الفَجْ","رِ قلباً مدَبَّساً شرِّيرا",27,"ا",1,0],["ونبت عنها في مجلسيها","نيابة كانت الغناء",28,"ا",2,0],["ونبسط أيدى النجوى كأنا","سراة هزها النجم الدليل",29,"ل",1,0],["وَنَبكي عَلى عِزِّنا المُنقَضي","وَنَندُبُ أَيّامَنا الماضِيَه",30,"ي",2,0],["وَنَبَتَّ بَينَ جَوانِحي","وَالقَلبُ مِن دَمِهِ سَقاك",31,"ك",1,0],["وَنَبذُلُ المالَ لَم نُحمَل عَلَيهِ كَما","يَقضي الكَريمُ حُقوقَ الأَهلِ وَالذِمَما",32,"م",2,0],["وَنَبذَ المُقَوقِسِ عَهدَ الفُجورِ","وَأَخذَ المُقَوقِسِ عَهدَ الفَجِر",33,"ر",1,0],["وَنَبُثُّهُم عَبَثَ الهَوى بِتُراثِهِم","مِن كُلِّ مُلقٍ لِلهَوى بِقِيادِ",34,"د",1,0],["وَنُبينُ كَيفَ تَفَرَّقَ الإِخوانُ في","وَقتِ البَلاءِ تَفَرُّقَ الأَضدادِ",34,"د",1,0],["وَنَبلُغُ المَجدَ عَلى عَينِهِ","وَنَدخُلُ العَصرَ إِلى جَنبِهِ",35,"ب",2,0],["ونبِّهينيَ دون القوم وانتفضي","عليَّ واللّيلُ في شكٍّ من السَّحَرِ",36,"ر",1,0],["وَنَبوَتُها أَن عادَ كَفِّيَ عيدُها","وَأَن هاجَ نَفسي لِلسَماحِ هَياجُها",37,"ج",3,0],["وَنُبِّتُ أَنَّ الخَيلَ أَعطَت رُؤوسَها","مُعاوِدَ حَربٍ لِلطِعانِ يَقودُها",38,"د",3,0],["وَنُبِّئتُهُم تَحتَ العِصِيِّ وَقَد بَدَت","خَزايا مُقِرٍّ مِنهُمُ وَمُقَرِّرِ",39,"ر",1,0],["وَنُبُوَّ ضِدِّهِما وَلَستُ بِواجِدٍ","عِندَ الكِلابِ رَضِيَّ فِعلِ الناسِ",40,"س",1,0],["وَنَبِّيتُكَ اِستَبطَأتَ شُكري لِأَنعُمٍ","تَتابَعُ عِندي سَيبُها وَنَوالُها",41,"ل",3,0],["وَنُبالي أَلّا نَرى ذا تَجَنٍّ","لا يُبالي الزَمانَ أَلّا يَرانا",42,"ن",2,0],["وَنُبِّئتُ ذا الأَهدامِ يَعوي وَدونَهُ","مِنَ الشَأمِ ذَرّاعاتُها وَقُصورُها",43,"ر",3,0],["وَنُبِّئتُ كَلبَ اِبنَي حُمَيضَةَ قَد عَوى","إِلَيَّ وَنارُ الحَربِ تَغلي قُدورُها",43,"ر",3,0],["وَنُبِّئتُ أَشقى جَعفَرٍ هاجَ شِقوَةً","عَلَيها كَما أَشقى ثَمودَ مُبيرُها",44,"ر",3,0],["وَنَبِيُّ عَصرٍ بِالسَماحَةِ مُرسَلٌ","كُلُّ الأَنامِ بِما أَتاهُ تُصَدِّقُ",45,"ق",1,0],["ونبلٌ كنبل الأعْيُنِ النُّجْلِ أُرْسِلَتْ","تطيرُ بريشٍ مُستعار مِنَ النَّسرِ",46,"ر",1,0],["وَنَبَّهنَ مِثلَ السَيفِ لَو لَم تَسُلَّهُ","يَدانِ لَسَلَّتهُ ظَباهُ مِنَ الغِمدِ",47,"د",1,0],["ونبحةٍ من كُليبٍ خِلْتُ نبرتَها","من زُخرفِ القول تَحريكاً وتسكينا",48,"ن",2,0],["وَنَبَذتِهِ كَالعودِ حينَ رَأَيتِهِ","فَاِشتَدَّ ذاكَ عَلَيَّ مِنكِ وَسانا",49,"ن",2,0],["وَنَبيلٌ عَبلُ الرَوادِفِ كَالقَو","رِ مِنَ الرَملِ قَد تَلَبَّدَ فَعمُ",50,"م",1,0],["وَنَبكِ وَهَل يَرجِعَنَّ البُكا","عَلَينا زَمانا لَنا قَد تَوَل",51,"ل",1,0],["ونبَّأهُ مَولاهُ فازدادَ قُوّةً","على قُوّةٍ واختارَ ما يَقمعُ الشَّرّا",52,"ر",2,0],["وَنُبِّئتُ أَنَّ القَينَ زَنّى عَجوزَهُ","قُفَيرَةَ أُمَّ السَوءِ أَن لَم يَكِد وَكدي",53,"د",2,0],["وَنَبِيُّ الهُدى وَحَمزَةُ إِبدأ","بِهِما إِذ نَسَبتَها خالاها",54,"ا",3,0],["وَنِبِّئتُ أَنَّ الجودَ مِنهُم خَليقَةٌ","يَجودونَ في يَبسِ الزَبيبِ وَفي القَطفِ",55,"ف",1,0],["وَنَبعَةٍ لا يَفوتُ هارِبُها","وَقارِحٍ بَعدَ شِدَّةٍ يَعِدُ",56,"د",1,0],["وَنَبَتْ به الأوطان فهْوَ بِغُرْبَةٍ","ما بينَ أعداءٍ يَسيرُ وحُسَّدِ",57,"د",1,0],["ونَبّهَ أقصَى الحيّ أنّي وتَرتُهُم","وقد علّ صَدُر السيفِ من ماجِدٍ عَمَم",58,"م",1,0],["ونَبّهَ الإصباحَ من نَومِهِ","شَدْوُ حَمامِ الأيْكَةِ الوُرْقِ",59,"ق",1,0],["وَنُبِّئتُ قَوماً بِهِم جِنَّةٌ","يَقولونَ مَن ذا وَكُنتُ العَلَم",60,"م",1,1],["وَنُبِّئتُها قالَت جِهاراً لِأُختِها","أَلا إِنَّ نَفسي عِندَ مَن روحُهُ عِندي",61,"د",2,0],["وَنُبِّئتُ نُسواناً كَرِهنَ تَحَلُّمي","ولِلّهِ أَوبي أَكثَرَت أَم أَقَلَّتِ",62,"ت",1,0],["وَنُبِّئتُ فِزراً قَلطَبانَ نِسائِهِ","ضَروباً عَلى أَستاهِهِنَّ بِطيبِ",63,"ب",1,0],["وَنَبلُ الدَهرِ تَنفُذُ كُلَّ تُرسٍ","وَتَسلُكُ بَّينَ أَثناءِ الدِلاصِ",64,"ص",1,0],["وَنَباتُ البِلادِ فيهِ الجَبائِيُّ","وَمِنهُ الوَشيجُ وَالشِريانُ",65,"ن",1,0],["وَنُبِّئَ في بَني يَعقوبَ موسى","بِشَرعٍ ما تَخَلَّصَ مُتعَبوهُ",66,"ب",3,0],["ونبني لهم نُصُباً خالداً","يكون على الدَّهرِ رمزَ العقابْ",67,"ب",1,0],["ونُبدعْ لهذا الكون في الوهم صورةً","تُمثِّلُ منه بَعْضَ ما كنت تزعُمُ",68,"م",1,0],["ونَبّالَةٍ مِن بُحْتُرٍ لو تَعَمّدوا","بِلَيْلٍ أناسِيَّ النواظِرِ لم يُخْطوا",69,"ط",3,0],["ونبذُ رأي الناصح المماحضِ","في قُحُم الأمر وفي المداحضِ",70,"ض",1,0],["وَنُبِّئتُ تَيماً قَد هَجوني لِيُذكَروا","فَهَذا الَّذي لا يَشتَهونَ مِنَ الذِكرِ",71,"ر",1,0],["وَنَبْأَةٌ أَطْلَقَتْ عَيْنَيَّ مِنْ سِنَةٍ","كَانَتْ حِبَالَةَ طَيْفٍ زَارَنِي سَحَرَا",72,"ر",2,1],["وَنَبَّهَنَا وَقْعُ النَّدَى فِي خَمِيلَةٍ","لَهَا مِنْ نُجُومِ الأُقْحُوانِ ثُغُورُ",73,"ر",1,0],["وَنُبِّئتُ أَنَّ أَبا مُنذِرٍ","يُساميكَ لِلحَارثِ الأَكبَرِ",74,"ر",1,1],["وَنَبِّهْتَ ظَنِّي لِلْعِدَى وَهْوَ غَافِلٌ","عَلَى حِينَ عَيْنِي مِنْ جَوىً لَيْسَ تَغْفَلُ",75,"ل",1,0],["وَنَبَا بِالآذَانِ أَشْهَى سَمَاعٍ","بَعْدَ أَلْفَاظِكَ اللِّطَافِ الرِّقَاقِ",76,"ق",1,0],["ونَبّه منهُنّ الظنون سكوتها","فقلن لها ما كنت من قبل جامدَه",77,"د",2,0],["ونبضة الفرحة في الإنسان","وأنت لا تهوي سوى القبور",78,"ر",1,0],["وَنَبِيّي أَحمَدٌ أَرسَلَهُ","بِالهُدى فَاِختارَهُ مِمَّن خَلَق",79,"ق",1,0],["ونباتٌ زَكا بروض فؤادٍ","بين ظلين من ندى وحنان",80,"ن",1,0],["وَنَبَّهْتِ وَسْنَانَ جَفْنِ الصبَاحِ","بِآيٍ مِنَ الْكَلِمِ الْمُنْزَلِ",81,"ل",1,0],["ونبلغ فيك الذي نرتجي","وذاك على الله سهل المنال",82,"ل",1,0],["ونبذت الرواغ والملق المخ","زي وأعباءه الجسام الثقيلة",83,"ل",2,0],["ونُبِّئْتُ نسْواناً عرضْن بحاجتي","عليها فقالت: دون ذاك شعوب",84,"ب",1,0],["ونبوغُ الرجال أرفعُ من أنْ","يحتويه قَصْرٌ رفيعُ الدَعائِم",85,"م",1,0],["ونُبّئتُ أن البعد زنادكُم","فلم تعِرفوا غير الوقيعة في قدحي",86,"ح",2,0],["ونَبُلُّهُ بدمِ القلوبِ ، وإنْ","عزَّتْ ، ونُنعِشُهُ إذا جفا",87,"ف",2,0],["ونبيت أن الخيل أعطت رؤوسها","معاود حرب للطعان يقودها",88,"د",3,0],["وَنَبِيلٌ عَبْلُ الرَّوَادِفِ، كَکلقَو","رِ مِن الرَّمْلِ قَدْ تَبَلَّدَ، فَعْمُ",89,"م",1,0],["ونبت بنفسج او ياسمين","تلوى فوق غابة ارجوان",90,"ن",1,0],["ونبكي اذا الحادي حدا بنعوتهم","فيعجب اذ نبكي ونعجب اذ يحدو",91,"د",2,0],["ونبينا شرف الوجود المصطفى","بحر الكمال وعلة الذرات",92,"ت",1,0],["ونبال الأجفان تلعب منها","في خفايا القلوب لعبا جليا",93,"ي",2,0],["ونَبلُغُ مَرفأ الخُطواتِ","نُحرِقُ بعدَه السُفنا",94,"ن",2,0],["ونبحث يومنا عن كل فن","ونلفي ليلنا نتلو القرآنا",95,"ن",2,0],["ونَبِيتُ في العَرَصَاتِ نَكتُمُ سِرَّنَا","نَخشَى العَوَاذِرَ أن تَكُونَ عَواذِلا",96,"ل",2,0],["ونبتغى البرءَ من يُسرع السُّ","قمُ إليه وتَصرعَ العِللُ",97,"ل",1,0],["وَنَبتُ الوِهادِ كانَ قَبلَكَ ذاوِياً","فَلَمّا أَتَيتَ اِخضَرَّ ما تُنبِتُ الرُبا",98,"ب",2,0],["وَنَبا بِيَ الوَطَنُ القَديمُ وَإِنَّني","في البُعدِ عَمَّن حَلَّهُ لَسَعيدُ",99,"د",1,0],["وَنُبتَ عَمَّن فَشَت شَجاعَتُهُ","نِيابَةَ البيضِ وَالقَنا قِصَدُ",100,"د",1,0],["وَنَبَذتَ آراءَ الأَنامِ وَطالَما","عاصَيتَ في طَلَبِ العُلى العُذّالا",101,"ل",2,0],["وَنُبتَ عَنهُم وَقَد طاحَ الزَمانُ 