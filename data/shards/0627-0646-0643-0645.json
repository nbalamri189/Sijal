{"poems":[[55,"قرت عيون المجد والفخر","https://www.aldiwan.net/poem30478.html","السريع"],[53,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[58,"إن الرسول لم يزل يقول","https://www.aldiwan.net/poem58534.html","الرجز"],[45,"أبعد نأي المليحة البخل","https://www.aldiwan.net/poem10113.html","المنسرح"],[68,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[18,"يا طيرة بين نبات أخضر","https://www.aldiwan.net/poem23918.html","الرجز"],[107,"من ينم عن لهذم أو مخذم","https://www.aldiwan.net/poem44193.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54578","الخفيف"],[102,"الآتون .. من الأزمة","https://www.poetsgate.com/ViewPoem.aspx?id=50340",""],[92,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[92,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[53,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[141,"الحمد لله ولي الحمد","https://www.aldiwan.net/poem67916.html","الرجز"],[141,"أم سلام أيثبي عاشقا","https://www.aldiwan.net/poem68034.html","الرمل"],[164,"هنيته عيدا فصل وانحر","https://www.aldiwan.net/poem58821.html","الرجز"],[190,"معشر المرد لا تصدوا عن العش","https://www.aldiwan.net/poem43752.html","الخفيف"],[190,"إنكم كنتم صغارا فزوروا","https://www.aldiwan.net/poem43775.html","الخفيف"],[234,"معصمها من سوارها اعتقرا","https://www.aldiwan.net/poem51094.html","المنسرح"],[240,"مولاي يامن له أياد","https://www.aldiwan.net/poem31781.html","مجزوء البسيط"],[240,"قد فنيت في هواكم عددي","https://www.aldiwan.net/poem32033.html","المنسرح"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[409,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[409,"يا قرير العين في بلده","https://www.aldiwan.net/poem33965.html","الرمل"],[463,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[463,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[463,"قالوا رضيت قلت ما أجدى الغضب","https://www.aldiwan.net/poem56298.html","الرجز"],[556,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[563,"شمس باء الوجود ذات غروب","https://www.aldiwan.net/poem34937.html","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77659","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77510","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46519","الرجز"],[1582,"","https://poetry.dctabudhabi.ae/diwan/poem/199219","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77980","السريع"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66243","الرجز"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33887","المنسرح"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77200","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93736","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93634","الخفيف"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87765","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201734","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132607","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112635","الرجز"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123944","الخفيف"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20879","المنسرح"],[4181,"","https://poetry.dctabudhabi.ae/diwan/poem/56","الطويل"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205457","الخفيف"],[463,"قالوا رضيتَ قلتُ ما أجدى الغضبْ","https://www.poetsgate.com/ViewPoem.aspx?id=14619",""],[6239,"بَرْزَخٌ من حَجَرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76053&r=&rc=104",""]],"verses":[["إِنَّكَ مِن قَومٍ إِذا اِستَلأَموا","تَقَبَّلوا في البيضِ وَالسُمرِ",0,"ر",1,0],["أنَّك من جيران قُطْرُبُّلٍ","وعندك اللَّقحَةُ والحالبُ",1,"ب",1,0],["أنَّك ممّا يجتني المجتني","ولستَ ممّا يحطِبُ الحاطبُ",1,"ب",1,0],["إنّكَ مِنِّي يا عَلِيُّ الأَبي","بحيثُ مِنْ مُوسَأهُ هَرونُ النّبِي",2,"ي",1,0],["إِنَّكَ مِن مَعشَرٍ إِذا وَهَبوا","ما دونَ أَعمارِهِم فَقَد بَخَلوا",3,"ل",3,0],["إِن كَم دَنَت ظَنَنتَها أَفاعِيا","أَو أَوتَرَت حَسبَتَها عَقارِبا",4,"ب",2,0],["إِنَّكَ مِن حِمى كُلَيبَ الأَزهَرِ","حَمَيتُهُ مِن مَذحِجٍ وَحِميَرِ",5,"ر",1,0],["إنّكم مِمَّن كرهتم دِينَهم","بين نابَيْ كلِّ صِلٍّ أرقمِ",6,"م",1,0],["إِنَّكُمْ يُوْمُ تُكَرِّمُونَ حُسَيْناً","تُكَرِّمُونَ الأَخْلاَقَ وَالآدَابَا",7,"ب",2,0],["إنّكم أجدر بالسّهد الذي","يعد الفجر بوصل الثائرين",8,"ن",1,0],["إنّكم آتون ، في أعينكم","قدر غاف ، وتاريخ جنين",8,"ن",1,0],["أنَّكُمْ باحتقاركُمْ للنساء اليومَ","أوسعتُمُ الرّجالَ احتقارا",9,"ر",2,0],["إنَّكم من نماذجِ العَربِ الساطينَ","ظُلماً عليهم تعريب!",10,"ب",1,0],["إنَّكم تمدحونَ خُبثاً وعدواناً","وغدراً كأنما المرءُ ذيب",10,"ب",1,0],["أنكَ ما راضَ لك الصيامُ","طرْفاً ولافرْجاً له عُرامُ",11,"م",1,0],["إِنَّكُم مِن بَعدُ إِن تَزِلّوا","عَن قَصدِهِ أَو نَهجِهِ تَضِلّوا",12,"ل",3,0],["أَنَّكُم مِن عَيشِهِ في نَفسِهِ","يا سُلَيمى فَاِعلَميهِ حَسبُهُ",13,"ب",2,0],["إنك ملك تنصر الله ومن","ينصره عز وجلِ لا ينصر",14,"ر",1,0],["إنكم كنتم صغار فزوروا","قبل أن تهجروا وأنتم كبار",15,"ر",1,0],["إنّكم كنتم صغارا فزوروا","قبل أن تهجروا وأنتم كبار",16,"ر",1,1],["إنك من معشر همُ جمعوا","شمل المعالي ودوّخوا البشرا",17,"ر",2,0],["إِنَّ كُمَيتي العَتيقَ سِنّاً","لَهُ حَديثٌ مَعي طَويلُ",18,"ل",1,0],["إِنَّكَ مَع قُوَّةٍ عُرِفتَ بِها","أَكثَرُ ثَبتاً مِنّي عَلى جَسَدي",19,"د",2,0],["انكمش قبل أن تمزّقك الريح","وتذروك في الجواء حطاما",20,"م",2,0],["إنك مغلوب الفؤاد يا فتى","متى متى تبلغ ذا أنت متى",21,"ت",2,0],["إنكم إن تأخذوه بيده","لا يَفُتُّ الزند في عضده",22,"د",2,0],["إنكُمُ من معشرٍ عندهُمُ","فيما استفادَ ربُّهم مساهمُ",23,"م",1,0],["إن كمال الملك من","جَور الليالي منصفُ",24,"ف",1,0],["إنك ما أستعففتَ أنتَ المُجْتَبَي","وما نطفت فأنتَ المُجْتَنَبْ",25,"ب",1,0],["إنّكم خيرُ من تكون له الخَض","راءُ سقفاً والعاصفاتُ إزارا",26,"ر",2,0],["إنكم إنكم وإني وإني","وهي وهي التي عفت عن ذنوبي",27,"ب",2,0],["إِنَّك مِن بَين الوَرى تُباهي","بِالمَدح في اللَهِ وَأَهل اللَهِ",28,"ه",1,0],["إِنَك ما أَذنَبت في القفار","ذَنباً يُؤدِّيك إِلى استغفار",29,"ر",1,0],["إِنكَ ما أنصفت في المَقال","وَلا عَدَوت زُخرف المحال",30,"ل",1,0],["إنكما حين تحارباني","ألفيتماني حضرا عِناني",31,"ن",2,0],["إن كمون الليث في خيسه","مكرا يراعي غفلة العابر",32,"ر",1,0],["إنك منّا أين تمضي فاقعدِ","ومن رأى ما أنا فيه يشهدِ",33,"د",1,0],["إِنَّكَ مِنّي بِحَيثُ يَطَّرِدُ الناظِ","رُ مِن تَحتِ ماءِ دَمعَتِيَه",34,"ي",2,1],["إِنَّكُم تُخطِئونَ في طَلَبِ الحُب","بِ جَزاءَ الأَذى فَذاكَ عَسيرُ",35,"ر",1,0],["أنَّكُم تَبقون مَأوى","وَملاذاً للبريّه",36,"ي",2,0],["إنكم أصبح الأَنام وُجوهاً","بَل وَأَعلى قَدرا وَأَزكى نُفوسا",37,"س",2,0],["إِنَّكُم مِنها عَلى الجُلّى يَدٌ","وَلِسانٌ دُونَهُ حَدُّ السِنان",38,"ن",1,0],["ان كمال الشيء من ربه","يحفظه الخالق في قدسه",39,"س",2,0],["انك معذور إذا رمت العلى","لكنما العلياء كيف عذرها",40,"ر",3,0],["إنكمُ سلَلتُمُ علينا","سيفاً لنا وأمرُهُ إلينا",41,"ن",2,0],["انكم والنساء ما لم تذودوا","عن حماها عدوكم سيان",42,"ن",1,0],["إنكم والاوطان فيها الأعادي","تتهادى عار على الاوطان",42,"ن",1,0],["إنكُما صاحبيّ لن تدَعا","لومي ومهما أضق فلن تسعا",43,"ع",2,0],["إنكُما من سفاه رأيكما","لا تجنباني الشكاة والقذعا",43,"ع",2,0],["إِنَّكَ مُستَرعاً وَإِنّا رَعِيَّةٌ","وَإِنَّكَ مَدعُوٌّ بِسيماكَ يا عُمَر",44,"ر",1,1],["إنكم معشر أبي الله إلا","أن تفوزوا بدرها المحشود",45,"د",1,0],["إنك ما استعففتَ أنتَ المجتبيَ","وما ثطفت فأنتَ المجتنبْ",46,"ب",1,0],["أنّكِ مائدةٌ منْزَلَةٌ","في صمتِ نبيٍّ من أحزانْ",47,"ن",1,0],["أنَّكِ مطلَقُ روحي التَّائهِ،","يا أجمل آيات القرآنْ",47,"ن",1,0]]}