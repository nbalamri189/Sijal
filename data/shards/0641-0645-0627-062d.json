,[4929,"نظمتُ على البحرِ الطويلِ لحبِها","https://www.poetsgate.com/ViewPoem.aspx?id=199434",""],[5054,"وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=213891",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5106,"يُقَبِّلُنِيْ بِشَاطِئِهِ نَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=150264",""],[5228,"خِطّيبَتي إسرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=53694",""],[5277,"في عيدها","https://www.poetsgate.com/ViewPoem.aspx?id=205393",""],[5302,"ملهوف","https://www.poetsgate.com/ViewPoem.aspx?id=200778",""],[592,"على الحبر بحر العلم بدر المنابر","https://www.poetsgate.com/ViewPoem.aspx?id=128847",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5363,"إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=144172",""],[5376,"يا زائرَ البيتِ لو حُمِّلت من مُقلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188424",""],[5397,"بدا نجم سعد ما عهدناه غاربا","https://www.poetsgate.com/ViewPoem.aspx?id=157959",""],[5431,"ودفء به طهرٌ جليٌ وملمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=190446",""],[5431,"عجبتُ لمن يرى في الجوع ربّا !!....","https://www.poetsgate.com/ViewPoem.aspx?id=202210",""],[5431,"كذلك أعثرنا عليهم ليعلموا ...(الحسين)","https://www.poetsgate.com/ViewPoem.aspx?id=215785",""],[5458,"تأشيرة سفر إلى الجنة (من مذكرات طفل فلسطيني)","https://www.poetsgate.com/ViewPoem.aspx?id=72161",""],[5467,"َبَلاَءُ الحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=199827",""],[5582,"قِفا صاحِبَيْ نَبْكِ فَقَدْ وَجَبَ البُكا","https://www.poetsgate.com/ViewPoem.aspx?id=187215",""],[5582,"حَلِيفُ جَوَىً ما ناحَ يَوْماً حَمامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187264",""],[5582,"أَلا هَلْ تَوَلَّتْ نَوارٌ نَوارا","https://www.poetsgate.com/ViewPoem.aspx?id=186999",""],[5582,"ألا غَنِّنا بالعامِرِيَّةِ وَاطْرَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186673",""],[5582,"أَلا هَلْ رأَتْ عَيْناكَ لِلْحَيِّ أَظْعانَا","https://www.poetsgate.com/ViewPoem.aspx?id=63594",""],[5660,"فَهَل مِن بَلسَمٍ لِلجُرحِ فينا","https://www.poetsgate.com/ViewPoem.aspx?id=23972",""],[5725,"على جيدك المصقول","https://www.poetsgate.com/ViewPoem.aspx?id=177422",""],[5725,"عشق صوفي","https://www.poetsgate.com/ViewPoem.aspx?id=186860",""],[5953,"أيصحو فؤادي والفراق عظيم","https://www.poetsgate.com/ViewPoem.aspx?id=93865",""],[5956,"بكل جلاله يأتي إلينا","https://www.poetsgate.com/ViewPoem.aspx?id=194012",""],[5956,"المجد الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=194172",""],[3792,"صبا قلبي لليلى ولم تعرف","https://www.poetsgate.com/ViewPoem.aspx?id=129245",""],[6102,"شادن","https://www.poetsgate.com/ViewPoem.aspx?id=184418",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[5309,"وغانية اخفى الجمال خصالها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573546",""],[5957,"فحبكَ عندي فراتٌ ونيلٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82451&r=&rc=90",""],[463,"أدمعكَ أمْ عارضٌ ممطرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60076&r=&rc=132",""],[6346,"جَمْرُ الوَدَاعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84888&r=&rc=13",""]],"verses":[["فَما حَدَثانُ الدَهرِ عِندي بِفاتِكٍ","وَلا جِنَّةُ البَقّارِ عِندي بِجِنَّةِ",0,"ه",1,0],["فَما حَمَلَ الآباءُ مِنّا وَساقَطَت","إِلى الأَرضِ مِنّا المُنجِباتُ النَجائِبُ",1,"ب",1,0],["فَما حُرِمْنَ بهِ والماءُ مُقْتَسَمٌ","رِيّاً ولا مُنعَتْ رُكْبانُها الزّادا",2,"د",2,0],["فَما حَسَنٌ أَن تَأتِيَ الأَمرَ طائِعاً","وَتَجزَعَ أَن داعي الصَبابَةِ أَسمَعا",3,"ع",2,0],["فَما حَسَبي إِن قِستَهُ بِمُقَصِّرٍ","وَلا أَنا إِن جَدَّ الهِجاءُ بِمُفحَمِ",4,"م",1,0],["فَما حَظُّ اِبنِ داوودٍ كَحَظّي","وَلا أوتيتُ مِن عِلمِ العَليمِ",5,"م",1,0],["فَما حَلَّ عَقدَ المُشكِلاتِ بِحِكمَةٍ","سِواكَ وَلا أَربى عَلى كُلِّ حُوَّلِ",6,"ل",1,0],["فَما حُبُّ مَيٍّ بِالَّذي يَكذِبُ الفَتى","وَلا بِالَّذي يُزهي وَلا يَتَمَلَّقُ",7,"ق",1,0],["فما حالة الإخوان فيها فإننا","نرى الناس عنهم يذكرون الغرائبا",8,"ب",2,0],["فَما حُمِدَت يَومَ اللِقاءُ مُجاشِعٌ","وَلا عِندَ عَقدٍ تَمنَعُ الجارَ مُحكَمِ",9,"م",1,0],["فَمَا حَلأتِني عِصِيُّ السُقَاةِ","ولا قِيلَ يا ابعَد ولا يا اغرُبِ",10,"ب",1,0],["فَما حَقُّ حُسنِكَ أَن يُجتَلى","وَلا حَقُّ وَجهِكَ أَن يُبتَذَل",11,"ل",1,0],["فَما حَبلُها بِالرَثِّ عِندي وَلا الَّذي","يُغَيِّرُهُ نَأيٌ وَلَو لَم تَكَلَّمِ",12,"م",1,0],["فما حقُّ من أطراك ألا تثيبه","إياساً ولا يأساً إذا كان أروحا",13,"ح",2,0],["فَمَا حَظُّهُ ممَّا حَوَتْ غير أنه","يُؤَثِّلُ فيها الأجْر أو يَتَحمَّدُ",14,"د",1,0],["فما حَدُّكم عند اللقاء بناكلٍ","ولا خيلكم عن غمرة بنواكص",15,"ص",1,0],["فَما حَرَّكَ الضَيمُ فيها الشِمَم","وَلا رُؤيَةُ الدَمِ فيها الغَضَب",16,"ب",1,0],["فَما حَطَّمَت يَدُ الأَيّامِ روحي","وَإِن حَطَّمَت أَباريقي وَدَنّي",17,"ن",2,0],["فَما حَرَّفَت مِن ذاكَ حَرفاً كَهانَتي","فَلِلَّهِ ظَنّي إِنَّهُ لَصَحيحُ",18,"ح",1,0],["فما حبَّبَ العيشَ إلاَّ الفناءُ","ولا زانَه غيرُ خوفِ اللُّحودْ",19,"د",1,0],["فَما حَلَّ خِلٌّ مِن فُؤادِ خَليلِه","مَحَلَّ اِعتِمادٍ مِن فُؤادِ مُحَمَّدِ",20,"د",1,0],["فما حلّق أو صفق","إلا اصطاد إنسانا",21,"ن",2,0],["فما حكم الليالي في بنينا","وما صنع الأرامل واليتامى",22,"م",2,0],["فَما حَرَمَ المُجِدَّ جَنى يَدَيهِ","وَلا نَسِيَ الشَقِيَّ وَلا المُصابا",23,"ب",2,0],["فَما حَرَموا بِالرَكضِ خَيلَكَ راحَةً","وَلَكِن كَفاها البَرُّ قَطعَ الشَواهِقِ",24,"ق",1,0],["فَما حاوَلتُ في أَرضٍ مُقاماً","وَلا أَزمَعتُ عَن أَرضٍ زَوالا",25,"ل",2,0],["فَما حَرَمَت حَسناءُ بِالهَجرِ غِبطَةً","وَلا بَلَّغَتها مَن شَكى الهَجرَ بِالوَصلِ",26,"ل",1,0],["فما حسبته القَطرُ غيرَ غوالبٍ","ولا ذرعتهُ الهُوجُ غيرَ لواغبِ",27,"ب",1,0],["فَما حامَت بَنو عَبسٍ عَلَيكُم","وَلا قالَت فَزارَةُ لاتُراعوا",28,"ع",3,0],["فَما حيلَةُ المُشتاقِ فيمَن يَشوقُهُ","إِذا حالَ هَذا الهَجرُ دونَ اِحتِيالِهِ",29,"ل",2,0],["فَما حاجِبٌ في بَني دارِمٍ","وَلا أُسرَةُ الأَقرَعِ الأَمجَدِ",30,"د",1,0],["فَما حَسَبٌ مِن نَهشَلٍ تَشهَدونَهُ","إِذا صارَ في أَيديهِمُ بِمُضاعِ",31,"ع",1,0],["فَما حَيَّةٌ يُرقى أَشَدَّ شَكيمَةً","وَلا مِثلَ هَذا مِن شَفيعٍ مُناضِلِ",32,"ل",1,0],["فَما حُرٌّ يَسيغُ الضَيمِ حُرّاً","وَلَو أَصمَت عَزائِمَهُ الرَمايا",33,"ا",3,0],["فَما حِيَلُ الأَريبِ بِمُدرِكاتٍ","عَجائِبَهُ وَلا فِكَرُ الأَصيلِ",34,"ل",1,0],["فَما حادَ عَنكَ بِقَلبٍ غَزا","وَلَكِن بِقَلبٍ وَهى عَن وَهَل",35,"ل",1,0],["فَما حيلَتي إِن لَم تَكُن لَكِ رَحمَةٌ","عَلَيَّ وَلا لي عَنكِ صَبرٌ فَأَصبِرُ",36,"ر",1,0],["فَما حُبُّ لَيلى بِالوَشيكِ اِنقِطاعُهُ","وَلا بِالمُؤَدّى يَومَ رَدِّ المَنائِحِ",37,"ح",1,0],["فَما حَفظُوا العَهدَ الَّذي كانَ بَينَنا","وَلا حِينَ هَمُّوا بِالقَطيعَةِ أَجمَلُوا",38,"ل",3,0],["فَما حَسا ثانِياً أَو بَعضَ ثالِثَةٍ","حَتّى اِستَدارَ وَرَدَّ الراحَ بِالراحِ",39,"ح",1,0],["فَما حَبَسَ النَفسَ المَسيحُ تَعَبُّداً","وَلَكِن مَشى في الأَرضِ مِشيَةَ سائِحِ",40,"ح",1,0],["فَما حَمَتِ السُروجُ ظُبى سُرَيجٍ","وَلا لُجُمُ الجِيادِ بَني لُجَيمِ",41,"م",1,0],["فَما حَمَلَت يَداهُ بِهِ خَؤوناً","وَلا نَبَراتُهُ نَبَراتُ وَنِّ",42,"ن",1,0],["فما حرمت حسناء بالهجر غبطةً","ولا بلّغتها من شكا الهجر بالوصل",43,"ل",1,0],["فَمَا حَدَا الحَادِي إِلاَّ مِنْ قَصَائِدِكُمْ","وَلاَ شَدَا بُلْبُلٌ إِلاَّ بِهَا طَرَبَا",44,"ب",2,0],["فما حِيلتي إِنْ كان بالماء غُصَّتي","ودائي إذا عَزَّ الدواءُ طبيبي",45,"ب",2,0],["فما حديدٌ بباقٍ","ولا حِذارٌ بمُغْني",46,"ن",2,0],["فما حَطّ من قَدْرِ الفَزَاريّ فاقَةٌ","ولا زاد في قدْرِ ابن أيهم مَنْصِب",47,"ب",1,0],["فما حرم الصدار عليك صنعا","وصدرك قد تفضفض بالشجون",48,"ن",1,0],["فما حصروا في موقف الحق لمحة","ولا وسعوا ما ضيقته المحارم",49,"م",1,0],["فما حزُّ في نفسي كغدرةِ غادرٍ","له ظاهرٌ بالمُغرِيات مُغلَّف",50,"ف",1,0],["فما حَظُّ ابنِ داوُدٍ كحَظِّي","ولاَ أُوتيتُ مِنْ عِلْمِ العليمِ",51,"م",1,0],["فما حاصلٌ مَطلَبي","ولو طالَ عُمري الأبد",52,"د",1,0],["فما حوت النطيقة مَا بُحيرٍ","ولم تكن الرويضة كالبقيل",53,"ل",1,0],["فما حالُ مَن كلُّ المساوي جميلةٌ","لديه وحتم السرِّ في قبضة الجهر",54,"ر",1,0],["فما حجتي إِن لا أُبلغك المنى","فتصبح في عرسٍ وأعداك تندبُ",55,"ب",1,0],["فما حاتم الطائي ونحر عشاره","عشاء وما أكل الضيوف الهواجم",56,"م",1,0],["فما حاولت أمرا فيه إلا","تعرض منه لي خصم ألد",57,"د",1,0],["فَما حَلَّ عَقدَ السَيفِ حَتّى أَناخَها","ضُحىً بِعِذارِ الخَطِّ حَدباءَ ناحِلا",58,"ل",2,0],["فما حالُ شخصٍ بين هاوٍ وصاعدٍ","وليس له من واحدِ منهما بُدّ",59,"د",1,0],["فما حَوتْ كفُّه عينا ولا عَرَضا","إلا ليجعله للحمد أثمانا",60,"ن",2,0],["فما حكم نيسان إذا جاء عهده","وفي جوفه نارٌ من الوجد تنهلّ",61,"ل",1,0],["فما حفظ الديار سوى حسام","به ظمأٌ على يوم الضراب",62,"ب",1,0],["فَما حاقِرٌ قَولَ الحَكيمِ وَرَأيهُ","وَما تارِكٌ نُصحَ النَصوحِ وَرا ظَهري",63,"ر",2,0],["فما حقُّك أن تسم","عَ لا ذمّاً ولا شكرا",64,"ر",2,0],["فما حق ذي جرم اذا كان علمها","له موردا ان يبتغي عنه مصدرا",65,"ر",2,0],["فما حاجتي بالجرد أبغى اقتناءها","وما أربى بالزاغبية ولا نصل",66,"ل",1,0],["فما حَطَمَ السلاحَ سوى سلاحٍ","يماثِلُهُ بتدبيرٍ خفي",67,"ي",1,0],["فما حَسَمَ الخيانةَ وهي داءٌ","سِوى سيفٍ أحدّ مهلّبي",67,"ي",1,0],["فَما حاجَتي الا الَّتي قَد عَلِمتها","وان عظمت عِندي فَعندك تسهل",68,"ل",1,0],["فَمَا حِيلَةُ المَطْرودِ مِن بابِ نَيلِكُم","وَمَا عِلة المَشدُودِ مِن فَضلِكُم حَل",69,"ل",1,0],["فَما حيلَةُ المَخْبولِ مِن أَصلِ خلقِهِ","عَلَى الطمَعِ الفَضَّاحِ وَالسفَه الفنْدِي",70,"د",2,0],["فَما حَسَدَ التَّبْريحَ إلا تَلَهُّفٌ","وَلا غَبَطَ التَّوْديعَ إِلا تَنَدُّمُ",71,"م",1,0],["فَما حَلُّهُ مِمّا يَرى الدَهرُ عقدَهُ","وَلا عَقدُهُ مِمّا يَرى الدَهرُ حَلَّهُ",72,"ل",2,0],["فما حال من أمسى استقلتْ ركابُه","إلى حيث ما ينفكُّ وَهو غريب",73,"ب",1,0],["فما حيلتي والعمر ولي ولم أنل","لقاهم وما للعمر إن فات من رد",74,"د",1,0],["فما حقّ ذي ودٍّ عليه بهيّنٍ","وَلا ما اِرتَجى شانيه مِن فضلهِ صعبا",75,"ب",2,0],["فَما حُسنُ الصِبا إِلّا التَهاوي","وَلا حُسنُ الهَوى إِلّا التَصابي",76,"ب",2,0],["فَما حَكَت مَدمَعي الخَنساء حينَ بَكَت","صَخراً وَلَو كانَ صَخراً قَلبها اِنصَدَعا",77,"ع",2,0],["فما حلَّ صَيْدَهُمُ لو غَدوْتَ","تُسايرُهمْ وذُراكَ الحَرَم",78,"م",1,0],["فما حكَى برقُ السّماء عَزْمَهُ","ولا حكتْ أنواءُها سَماحَهُ",79,"ح",2,0],["فما حار من يهدي يهدي محمد","ولست تراه قارعاً سن نادم",80,"م",1,0],["فما حَرَكاتٌ مُتعِباتٌ تُديُمها","تَأَنَّ فأوْجُ الشَّمسِ لا يتحرَّكُ",81,"ك",1,0],["فما حباك الورى وألهمك ال","عدل وأعطاك ما ملكت سدى",82,"د",2,0],["فما حَدَّثتُ إلاَّ عن أشمّ","ولا أخبرت إلاَّ عن همام",83,"م",1,0],["فما حَمَلَتْ خَطْباً إِلَى دارِ خالِعٍ","وإِنْ عَزَّ إِلّا كَانَ أَيْسَرَهُ الفَدْحُ",84,"ح",1,0],["فما حازَ غازٍ مثلَهُ فَيْءَ مَغْنَمٍ","ولا نالَ سابٍ مثلَها سَبْيَ أَنفالِ",85,"ل",1,0],["فما حال بين الضبِّ والنون حائل","بأْطوَلَ مما بين قِرطيْك والعِقْدِ",86,"د",1,1],["فما حدني عقل عتي ولا رؤى","تساورني حتى وإن كن أسلما",87,"م",2,0],["فما حَمَلتْ خبراً يُستطا","بُ إلّا الذي كذَبَ المُخبِرُ",88,"ر",1,0],["فما حالةٌ إلا وتُبْقي بقيَّةً","وما الموت كل الموت إلا صدودها",89,"د",3,0],["فما حباني بحاجتي قدرٌ","ولا اقتضاني بالحظّ دورُ فلك",90,"ك",1,0],["فما حطَّ ذا الدهرُ إلاّ الجليلَ","شأناً ولا هدَّ إلاّ الرفيعا",91,"ع",2,0],["فَما حَسَنٌ أَن تَأتِيَ الأَمرَ طائِعاً","وَتَجزَعُ إِن داعي الصَبابَةِ وَدَّعا",92,"ع",2,0],["فَما حيلَةُ الظَمآنِ في المَورِدِ الَّذي","إِذا ما دَنا مِنهُ تَكَدَّرَ رائِقُه",93,"ق",2,0],["فما حيلتي قد سارَ شكاً اِيابُكمْ","وأمّا النوى والهجرُ فهو يقينُ",94,"ن",1,0],["فما حَمِيَ الجِلادُ بهم إلى أنْ","رأيتَ القومَ في عَلَقٍ تعومُ",95,"م",1,0],["فما حيلتي ما في الأحبَّةِ راحمٌ","ولا في رجالِ الوجدِ غيرُ جهولِ",96,"ل",1,0],["فما حيلَتي والقلبُ ليسَ بِواجِدٍ","عليهِ اصطِباراً حين بانَ وأقسما",97,"م",2,0],["فما حِيلتي إن أقفرت منهُ مُهجَتي","وخَلَّفني أصلي سَعيراً منَ الهَجرِ",98,"ر",1,0],["فما حِيلتي والقلبُ في يَدِ شادِنٍ","إذا ما شَدَا حَنَّ إلى كأسها الخَمرُ",99,"ر",1,0],["فَما حَزَني أَنّي أَموتُ صَبابَةً","وَلَكِن عَلى مَن لا يَحِلُّ لَهُ قَتلي",100,"ل",2,0],["فَما حانَ حَتّى بانَ مِنكَ سَمَيذَعٌ","يُجاريهِ في مَيدانِهِ وَيُجاذِبُه",101,"ب",2,0],["فما حدد المعصوم قدر مسافة","لفطر ولا قصر فهل أنت مقتد",102,"د",1,0],["فما حال الصبايا مع بغايا","بمعولها الفضائل هادمات",103,"ت",1,0],["فَما حيلَتي والحالُ لَو قُمتُمُ بِها","عَلى جِهَةِ الإنصافِ أصعَبُها سَهلُ",104,"ل",1,0],["فَما حَلَتنيَ حَليٌ مِنكَ عارِفَةً","إلاَّ تَعَمَّقُ بي في أُختِها عمَقُ",105,"ق",1,0],["فَما حيلَتي في القُرب مِنها وَإِنَّها","عَلى ما بِها مِن خالص الودّ في حَجز",106,"ز",1,0],["فَ