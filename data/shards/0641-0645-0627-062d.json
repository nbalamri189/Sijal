هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[350,"تمتع في شبابك بالأماني","https://www.aldiwan.net/poem15521.html","الوافر"],[354,"داع من الحق بالحق المبين دعا","https://www.aldiwan.net/poem40142.html","البسيط"],[365,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60658.html","المتقارب"],[403,"ماذا أقول مادحا في مرسل","https://www.aldiwan.net/poem46987.html","الرجز"],[404,"لعلك أهملت الطواف بمعهد","https://www.aldiwan.net/poem33437.html","الطويل"],[406,"ألا أبلغ السلطان عني نصيحة","https://www.aldiwan.net/poem49519.html","الطويل"],[410,"تهن يا أطول الملوك يدا","https://www.aldiwan.net/poem31713.html","عموديه"],[417,"بدا والصبح غار على الظلام","https://www.aldiwan.net/poem54132.html","الوافر"],[440,"تبلج عن إشراق غرتك الصبح","https://www.aldiwan.net/poem34816.html","الطويل"],[440,"سلام على الأيام تسليم إقبال","https://www.aldiwan.net/poem34847.html","الطويل"],[453,"فما حال بين الضب والنون حائل","https://www.aldiwan.net/poem13750.html","الطويل"],[454,"دعوني من الدنيا من الأرض والسما","https://www.aldiwan.net/poem61581.html","الطويل"],[459,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[462,"أحب مطال الوصل لا عن رضى به","https://www.aldiwan.net/poem15162.html","الطويل"],[465,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[465,"رأى وقفة البين خطباً فطيعاً","https://www.aldiwan.net/poem3503.html","عموديه"],[467,"ما وجد علوي الهوى جن واجتوى","https://www.aldiwan.net/poem50418.html","الطويل"],[469,"أبى الدهر تحلو مرارة طعمه","https://www.aldiwan.net/poem59827.html","الطويل"],[478,"هوى بين أحناء الضلوع دفين","https://www.aldiwan.net/poem15260.html","الطويل"],[478,"تعطر من دياركم النسيم","https://www.aldiwan.net/poem15337.html","الوافر"],[478,"أبثك ما بي أم كفاك نحولي","https://www.aldiwan.net/poem15347.html","الطويل"],[539,"دعوني فإني لا أطيق التكلما","https://www.aldiwan.net/poem47949.html","عموديه"],[539,"خضوعا ومثلي بالخضوع أخو فخر","https://www.aldiwan.net/poem48153.html","عموديه"],[539,"ملامكما كفا فقد قضي الأمر","https://www.aldiwan.net/poem48170.html","عموديه"],[554,"أديرا علي الراح لا تشربا قبلي","https://www.aldiwan.net/poem68430.html","الطويل"],[564,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[588,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["فَما حَدَثانُ الدَهرِ عِندي بِفاتِكٍ","وَلا جِنَّةُ البَقّارِ عِندي بِجِنَّةِ",0,"ه",1,0],["فَما حَمَلَ الآباءُ مِنّا وَساقَطَت","إِلى الأَرضِ مِنّا المُنجِباتُ النَجائِبُ",1,"ب",1,0],["فَما حُرِمْنَ بهِ والماءُ مُقْتَسَمٌ","رِيّاً ولا مُنعَتْ رُكْبانُها الزّادا",2,"د",2,0],["فَما حَسَنٌ أَن تَأتِيَ الأَمرَ طائِعاً","وَتَجزَعَ أَن داعي الصَبابَةِ أَسمَعا",3,"ع",2,0],["فَما حَسَبي إِن قِستَهُ بِمُقَصِّرٍ","وَلا أَنا إِن جَدَّ الهِجاءُ بِمُفحَمِ",4,"م",1,0],["فَما حَظُّ اِبنِ داوودٍ كَحَظّي","وَلا أوتيتُ مِن عِلمِ العَليمِ",5,"م",1,0],["فَما حَلَّ عَقدَ المُشكِلاتِ بِحِكمَةٍ","سِواكَ وَلا أَربى عَلى كُلِّ حُوَّلِ",6,"ل",1,0],["فَما حُبُّ مَيٍّ بِالَّذي يَكذِبُ الفَتى","وَلا بِالَّذي يُزهي وَلا يَتَمَلَّقُ",7,"ق",1,0],["فما حالة الإخوان فيها فإننا","نرى الناس عنهم يذكرون الغرائبا",8,"ب",2,0],["فَما حُمِدَت يَومَ اللِقاءُ مُجاشِعٌ","وَلا عِندَ عَقدٍ تَمنَعُ الجارَ مُحكَمِ",9,"م",1,0],["فَمَا حَلأتِني عِصِيُّ السُقَاةِ","ولا قِيلَ يا ابعَد ولا يا اغرُبِ",10,"ب",1,0],["فَما حَقُّ حُسنِكَ أَن يُجتَلى","وَلا حَقُّ وَجهِكَ أَن يُبتَذَل",11,"ل",1,0],["فَما حَبلُها بِالرَثِّ عِندي وَلا الَّذي","يُغَيِّرُهُ نَأيٌ وَلَو لَم تَكَلَّمِ",12,"م",1,0],["فما حقُّ من أطراك ألا تثيبه","إياساً ولا يأساً إذا كان أروحا",13,"ح",2,0],["فَمَا حَظُّهُ ممَّا حَوَتْ غير أنه","يُؤَثِّلُ فيها الأجْر أو يَتَحمَّدُ",14,"د",1,0],["فما حَدُّكم عند اللقاء بناكلٍ","ولا خيلكم عن غمرة بنواكص",15,"ص",1,0],["فَما حَرَّكَ الضَيمُ فيها الشِمَم","وَلا رُؤيَةُ الدَمِ فيها الغَضَب",16,"ب",1,0],["فَما حَطَّمَت يَدُ الأَيّامِ روحي","وَإِن حَطَّمَت أَباريقي وَدَنّي",17,"ن",2,0],["فَما حَرَّفَت مِن ذاكَ حَرفاً كَهانَتي","فَلِلَّهِ ظَنّي إِنَّهُ لَصَحيحُ",18,"ح",1,0],["فما حبَّبَ العيشَ إلاَّ الفناءُ","ولا زانَه غيرُ خوفِ اللُّحودْ",19,"د",1,0],["فَما حَلَّ خِلٌّ مِن فُؤادِ خَليلِه","مَحَلَّ اِعتِمادٍ مِن فُؤادِ مُحَمَّدِ",20,"د",1,0],["فما حلّق أو صفق","إلا اصطاد إنسانا",21,"ن",2,0],["فما حكم الليالي في بنينا","وما صنع الأرامل واليتامى",22,"م",2,0],["فَما حَرَمَ المُجِدَّ جَنى يَدَيهِ","وَلا نَسِيَ الشَقِيَّ وَلا المُصابا",23,"ب",2,0],["فَما حَرَموا بِالرَكضِ خَيلَكَ راحَةً","وَلَكِن كَفاها البَرُّ قَطعَ الشَواهِقِ",24,"ق",1,0],["فَما حاوَلتُ في أَرضٍ مُقاماً","وَلا أَزمَعتُ عَن أَرضٍ زَوالا",25,"ل",2,0],["فَما حَرَمَت حَسناءُ بِالهَجرِ غِبطَةً","وَلا بَلَّغَتها مَن شَكى الهَجرَ بِالوَصلِ",26,"ل",1,0],["فما حسبته القَطرُ غيرَ غوالبٍ","ولا ذرعتهُ الهُوجُ غيرَ لواغبِ",27,"ب",1,0],["فَما حامَت بَنو عَبسٍ عَلَيكُم","وَلا قالَت فَزارَةُ لاتُراعوا",28,"ع",3,0],["فَما حيلَةُ المُشتاقِ فيمَن يَشوقُهُ","إِذا حالَ هَذا الهَجرُ دونَ اِحتِيالِهِ",29,"ل",2,0],["فَما حاجِبٌ في بَني دارِمٍ","وَلا أُسرَةُ الأَقرَعِ الأَمجَدِ",30,"د",1,0],["فَما حَسَبٌ مِن نَهشَلٍ تَشهَدونَهُ","إِذا صارَ في أَيديهِمُ بِمُضاعِ",31,"ع",1,0],["فَما حَيَّةٌ يُرقى أَشَدَّ شَكيمَةً","وَلا مِثلَ هَذا مِن شَفيعٍ مُناضِلِ",32,"ل",1,0],["فَما حُرٌّ يَسيغُ الضَيمِ حُرّاً","وَلَو أَصمَت عَزائِمَهُ الرَمايا",33,"ا",3,0],["فَما حِيَلُ الأَريبِ بِمُدرِكاتٍ","عَجائِبَهُ وَلا فِكَرُ الأَصيلِ",34,"ل",1,0],["فَما حادَ عَنكَ بِقَلبٍ غَزا","وَلَكِن بِقَلبٍ وَهى عَن وَهَل",35,"ل",1,0],["فَما حيلَتي إِن لَم تَكُن لَكِ رَحمَةٌ","عَلَيَّ وَلا لي عَنكِ صَبرٌ فَأَصبِرُ",36,"ر",1,0],["فَما حُبُّ لَيلى بِالوَشيكِ اِنقِطاعُهُ","وَلا بِالمُؤَدّى يَومَ رَدِّ المَنائِحِ",37,"ح",1,0],["فَما حَفظُوا العَهدَ الَّذي كانَ بَينَنا","وَلا حِينَ هَمُّوا بِالقَطيعَةِ أَجمَلُوا",38,"ل",3,0],["فَما حَسا ثانِياً أَو بَعضَ ثالِثَةٍ","حَتّى اِستَدارَ وَرَدَّ الراحَ بِالراحِ",39,"ح",1,0],["فَما حَبَسَ النَفسَ المَسيحُ تَعَبُّداً","وَلَكِن مَشى في الأَرضِ مِشيَةَ سائِحِ",40,"ح",1,0],["فَما حَمَتِ السُروجُ ظُبى سُرَيجٍ","وَلا لُجُمُ الجِيادِ بَني لُجَيمِ",41,"م",1,0],["فَما حَمَلَت يَداهُ بِهِ خَؤوناً","وَلا نَبَراتُهُ نَبَراتُ وَنِّ",42,"ن",1,0],["فما حرمت حسناء بالهجر غبطةً","ولا بلّغتها من شكا الهجر بالوصل",43,"ل",1,0],["فَمَا حَدَا الحَادِي إِلاَّ مِنْ قَصَائِدِكُمْ","وَلاَ شَدَا بُلْبُلٌ إِلاَّ بِهَا طَرَبَا",44,"ب",2,0],["فما حِيلتي إِنْ كان بالماء غُصَّتي","ودائي إذا عَزَّ الدواءُ طبيبي",45,"ب",2,0],["فما حديدٌ بباقٍ","ولا حِذارٌ بمُغْني",46,"ن",2,0],["فما حَطّ من قَدْرِ الفَزَاريّ فاقَةٌ","ولا زاد في قدْرِ ابن أيهم مَنْصِب",47,"ب",1,0],["فما حزُّ في نفسي كغدرةِ غادرٍ","له ظاهرٌ بالمُغرِيات مُغلَّف",48,"ف",1,0],["فما حَظُّ ابنِ داوُدٍ كحَظِّي","ولاَ أُوتيتُ مِنْ عِلْمِ العليمِ",49,"م",1,0],["فما حاصلٌ مَطلَبي","ولو طالَ عُمري الأبد",50,"د",1,0],["فما حوت النطيقة مَا بُحيرٍ","ولم تكن الرويضة كالبقيل",51,"ل",1,0],["فما حالُ مَن كلُّ المساوي جميلةٌ","لديه وحتم السرِّ في قبضة الجهر",52,"ر",1,0],["فما حجتي إِن لا أُبلغك المنى","فتصبح في عرسٍ وأعداك تندبُ",53,"ب",1,0],["فما حاتم الطائي ونحر عشاره","عشاء وما أكل الضيوف الهواجم",54,"م",1,0],["فما حاولت أمرا فيه إلا","تعرض منه لي خصم ألد",55,"د",1,0],["فَما حَلَّ عَقدَ السَيفِ حَتّى أَناخَها","ضُحىً بِعِذارِ الخَطِّ حَدباءَ ناحِلا",56,"ل",2,0],["فما حالُ شخصٍ بين هاوٍ وصاعدٍ","وليس له من واحدِ منهما بُدّ",57,"د",1,0],["فما حَوتْ كفُّه عينا ولا عَرَضا","إلا ليجعله للحمد أثمانا",58,"ن",2,0],["فما حكم نيسان إذا جاء عهده","وفي جوفه نارٌ من الوجد تنهلّ",59,"ل",1,0],["فما حفظ الديار سوى حسام","به ظمأٌ على يوم الضراب",60,"ب",1,0],["فَما حاقِرٌ قَولَ الحَكيمِ وَرَأيهُ","وَما تارِكٌ نُصحَ النَصوحِ وَرا ظَهري",61,"ر",2,0],["فما حقُّك أن تسم","عَ لا ذمّاً ولا شكرا",62,"ر",2,0],["فما حق ذي جرم اذا كان علمها","له موردا ان يبتغي عنه مصدرا",63,"ر",2,0],["فما حاجتي بالجرد أبغى اقتناءها","وما أربى بالزاغبية ولا نصل",64,"ل",1,0],["فما حَطَمَ السلاحَ سوى سلاحٍ","يماثِلُهُ بتدبيرٍ خفي",65,"ي",1,0],["فما حَسَمَ الخيانةَ وهي داءٌ","سِوى سيفٍ أحدّ مهلّبي",65,"ي",1,0],["فَما حاجَتي الا الَّتي قَد عَلِمتها","وان عظمت عِندي فَعندك تسهل",66,"ل",1,0],["فَمَا حِيلَةُ المَطْرودِ مِن بابِ نَيلِكُم","وَمَا عِلة المَشدُودِ مِن فَضلِكُم حَل",67,"ل",1,0],["فَما حيلَةُ المَخْبولِ مِن أَصلِ خلقِهِ","عَلَى الطمَعِ الفَضَّاحِ وَالسفَه الفنْدِي",68,"د",2,0],["فَما حَسَدَ التَّبْريحَ إلا تَلَهُّفٌ","وَلا غَبَطَ التَّوْديعَ إِلا تَنَدُّمُ",69,"م",1,0],["فَما حَلُّهُ مِمّا يَرى الدَهرُ عقدَهُ","وَلا عَقدُهُ مِمّا يَرى الدَهرُ حَلَّهُ",70,"ل",2,0],["فما حال من أمسى استقلتْ ركابُه","إلى حيث ما ينفكُّ وَهو غريب",71,"ب",1,0],["فما حيلتي والعمر ولي ولم أنل","لقاهم وما للعمر إن فات من رد",72,"د",1,0],["فما حقّ ذي ودٍّ عليه بهيّنٍ","وَلا ما اِرتَجى شانيه مِن فضلهِ صعبا",73,"ب",2,0],["فَما حُسنُ الصِبا إِلّا التَهاوي","وَلا حُسنُ الهَوى إِلّا التَصابي",74,"ب",2,0],["فَما حَكَت مَدمَعي الخَنساء حينَ بَكَت","صَخراً وَلَو كانَ صَخراً قَلبها اِنصَدَعا",75,"ع",2,0],["فما حلَّ صَيْدَهُمُ لو غَدوْتَ","تُسايرُهمْ وذُراكَ الحَرَم",76,"م",1,0],["فما حكَى برقُ السّماء عَزْمَهُ","ولا حكتْ أنواءُها سَماحَهُ",77,"ح",2,0],["فما حار من يهدي يهدي محمد","ولست تراه قارعاً سن نادم",78,"م",1,0],["فما حَرَكاتٌ مُتعِباتٌ تُديُمها","تَأَنَّ فأوْجُ الشَّمسِ لا يتحرَّكُ",79,"ك",1,0],["فما حباك الورى وألهمك ال","عدل وأعطاك ما ملكت سدى",80,"د",2,0],["فما حَدَّثتُ إلاَّ عن أشمّ","ولا أخبرت إلاَّ عن همام",81,"م",1,0],["فما حَمَلَتْ خَطْباً إِلَى دارِ خالِعٍ","وإِنْ عَزَّ إِلّا كَانَ أَيْسَرَهُ الفَدْحُ",82,"ح",1,0],["فما حازَ غازٍ مثلَهُ فَيْءَ مَغْنَمٍ","ولا نالَ سابٍ مثلَها سَبْيَ أَنفالِ",83,"ل",1,0],["فما حال بين الضبِّ والنون حائل","بأْطوَلَ مما بين قِرطيْك والعِقْدِ",84,"د",1,1],["فما حدني عقل عتي ولا رؤى","تساورني حتى وإن كن أسلما",85,"م",2,0],["فما حَمَلتْ خبراً يُستطا","بُ إلّا الذي كذَبَ المُخبِرُ",86,"ر",1,0],["فما حالةٌ إلا وتُبْقي بقيَّةً","وما الموت كل الموت إلا صدودها",87,"د",3,0],["فما حباني بحاجتي قدرٌ","ولا اقتضاني بالحظّ دورُ فلك",88,"ك",1,0],["فما حطَّ ذا الدهرُ إلاّ الجليلَ","شأناً ولا هدَّ إلاّ الرفيعا",89,"ع",2,0],["فَما حَسَنٌ أَن تَأتِيَ الأَمرَ طائِعاً","وَتَجزَعُ إِن داعي الصَبابَةِ وَدَّعا",90,"ع",2,0],["فَما حيلَةُ الظَمآنِ في المَورِدِ الَّذي","إِذا ما دَنا مِنهُ تَكَدَّرَ رائِقُه",91,"ق",2,0],["فما حيلتي قد سارَ شكاً اِيابُكمْ","وأمّا النوى والهجرُ فهو يقينُ",92,"ن",1,0],["فما حَمِيَ الجِلادُ بهم إلى أنْ","رأيتَ القومَ في عَلَقٍ تعومُ",93,"م",1,0],["فما حيلتي ما في الأحبَّةِ راحمٌ","ولا في رجالِ الوجدِ غيرُ جهولِ",94,"ل",1,0],["فما حيلَتي والقلبُ ليسَ بِواجِدٍ","عليهِ اصطِباراً حين بانَ وأقسما",95,"م",2,0],["فما حِيلتي إن أقفرت منهُ مُهجَتي","وخَلَّفني أصلي سَعيراً منَ الهَجرِ",96,"ر",1,0],["فما حِيلتي والقلبُ في يَدِ شادِنٍ","إذا ما شَدَا حَنَّ إلى كأسها الخَمرُ",97,"ر",1,0],["فَما حَزَني أَنّي أَموتُ صَبابَةً","وَلَكِن عَلى مَن لا يَحِلُّ لَهُ قَتلي",98,"ل",2,0],["فَما حانَ حَتّى بانَ مِنكَ سَمَيذَعٌ","يُجاريهِ في مَيدانِهِ وَيُجاذِبُه",99,"ب",2,0],["فما حدد المعصوم قدر مسافة","لفطر ولا قصر فهل أنت مقتد",100,"د",1,0]]}