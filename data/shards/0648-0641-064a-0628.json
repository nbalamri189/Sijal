{"poems":[[53,"وفى بمواعيد الخليط وأخلفوا","https://www.aldiwan.net/poem29968.html","الطويل"],[27,"ألا بكرت سلمى فجد بكورها","https://www.aldiwan.net/poem5775.html","الطويل"],[47,"أيا راكبا نحو الجزيرة جسرة","https://www.aldiwan.net/poem25128.html","الطويل"],[72,"إليك ابن عباس سرى حامل الرجا","https://www.aldiwan.net/poem19052.html","الطويل"],[72,"سرى طيفها حيث العواذل هجع","https://www.aldiwan.net/poem19163.html","الطويل"],[51,"لما تؤذن الدنيا به من شرورها","https://www.aldiwan.net/poem65430.html","الطويل"],[51,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[38,"ألم تسأل بعارمة الديارا","https://www.aldiwan.net/poem7721.html","الوافر"],[43,"ليالي بعد الظاعنين شكول","https://www.aldiwan.net/poem9967.html","الطويل"],[45,"وفي بقايا الفؤاد نار","https://www.aldiwan.net/poem66649.html","مجزوء البسيط"],[58,"وفي قبض كف الطفل عند ولاده","https://www.aldiwan.net/poem30784.html","الطويل"],[66,"بكى عليك الحسام والقلم","https://www.aldiwan.net/poem40290.html","المنسرح"],[80,"بجمل حدا الغيران بزل جمائله","https://www.aldiwan.net/poem31331.html","الطويل"],[80,"إذا البدر يطوى في ربوع البلى لحدا","https://www.aldiwan.net/poem31479.html","الطويل"],[69,"وفي بغداد أقوام كرام","https://www.aldiwan.net/poem28901.html","الوافر"],[69,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[48,"إذا خطرت فيك الهموم فداوها","https://www.aldiwan.net/poem65098.html","الطويل"],[46,"فوارس خيلكم تعطى مناها","https://www.aldiwan.net/poem23314.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85572","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/247","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9948","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[48,"فُؤادي صَبورٌ وَاللِسانُ كَتومُ","https://www.poetsgate.com/ViewPoem.aspx?id=11860",""],[100,"نهاية حسناء ريفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50449",""],[43,"ليالي بعد الظاعنين شكول","https://www.poetsgate.com/ViewPoem.aspx?id=136",""],[113,"الى حلب الشهباء ثار بنا الوجد","https://www.aldiwan.net/poem41167.html","عموديه"],[113,"نشر العناية قد هبت نسائمه","https://www.aldiwan.net/poem42180.html","البسيط"],[130,"سبت لبه من بعد كبرته جمل","https://www.aldiwan.net/poem54770.html","الطويل"],[141,"لكم أن تجوروا معرِضين وتغضبوا","https://www.aldiwan.net/poem11720.html","الطويل"],[145,"عن الحب ما لي كلما رمت سلوانا","https://www.aldiwan.net/poem47620.html","الطويل"],[158,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[158,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[187,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[204,"حمدنا الله ربّ العالمينا","https://www.aldiwan.net/poem920.html",""],[210,"ألا فاستمع يا نجل يحيى مقالتي","https://www.aldiwan.net/poem37865.html","الطويل"],[229,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[235,"وفي بدور النهى لديك أرنا","https://www.aldiwan.net/poem19801.html","الدوبيت"],[254,"سقاني كأسه سحرا بوقت","https://www.aldiwan.net/poem48365.html","الوافر"],[269,"ذروني أبكي بعد جيرة ثهمد","https://www.aldiwan.net/poem52052.html","الطويل"],[269,"أفي نيابتي برع تقيم","https://www.aldiwan.net/poem52116.html","الوافر"],[273,"أدرك بخيلك خيل الله أندلسا","https://www.aldiwan.net/poem25469.html","البسيط"],[326,"أفي القمة السكرى بخمر الأداهر","https://www.aldiwan.net/poem55056.html","الطويل"],[340,"وليلة قضيتها في الاسى","https://www.aldiwan.net/poem55332.html","السريع"],[340,"أبا غازي ابا الفضل","https://www.aldiwan.net/poem55349.html","مجزوء الوافر"],[347,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[362,"سبى مني الفؤاد لحاظ فاتن","https://www.aldiwan.net/poem60611.html","الوافر"],[362,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[362,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[364,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[388,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[429,"أرقصها مطرب الأغاريد","https://www.aldiwan.net/poem12414.html","المنسرح"],[436,"أخو ظمأ يمص حشاه سبع","https://www.aldiwan.net/poem34835.html","الوافر"],[438,"هو الحزن حتى ما يماثله حزن","https://www.aldiwan.net/poem14388.html","الطويل"],[456,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[456,"كذا تنقضي الأيام حالا على حال","https://www.aldiwan.net/poem56070.html","الطويل"],[456,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[456,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[456,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[456,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[456,"قضى دين سعدى طيفها المتأوب","https://www.aldiwan.net/poem56292.html","الطويل"],[459,"هنيئا للمواسم والتهاني","https://www.aldiwan.net/poem15924.html","الوافر"],[498,"ما رفرف السعد إلا في محاضرنا","https://www.aldiwan.net/poem37998.html","البسيط"],[513,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[522,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[549,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[556,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[556,"إن كنت نائم","https://www.aldiwan.net/poem34090.html","مخلع البسيط"],[560,"لنا عيد يدوم لنا جديدا","https://www.aldiwan.net/poem52818.html","الوافر"],[560,"رأى قصب السباق بنو الزمان","https://www.aldiwan.net/poem52896.html","الوافر"],[585,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[585,"يا راكباً من رياض المجد مرتحلا","https://www.aldiwan.net/poem11553.html","عموديه"]],"verses":[["وَفى بِمَواعيدِ الخَليطِ وَأَخلَفوا","وَكَم وَعَدوا القَلبَ المُعَنّى وَلَم يَفوا",0,"ف",3,1],["وَفي بِئرِ حِصنٍ أَدرَكَتها حَفيظَةٌ","وَقَد رُدَّ فيها مَرَّتَينِ حَفيرُها",1,"ر",3,0],["وَفي بَعضِ مَن يُلقي إِلَيكَ مَوَدَّةً","عَدُوٌّ إِذا كَشَّفتَ عَنهُ مُبينُ",2,"ن",1,0],["وفي بابك العالي تفسَّرت المنى","ومن أين للتفسيرِ مثل ابن عبَّاس",3,"س",1,0],["وفي بعض ما أسديت قُنعٌ وإنما","فتىً كنت مرمى ظنّه ليس يقنع",4,"ع",1,0],["وفي بعض أحوال النفوس كأنها","ترى خلف ستر الغيب ما تتوقع",5,"ع",1,0],["وفي بغيك البادي عليك شهادةٌ","بأنك مطروقُ الدماغِ مُخبّلُ",6,"ل",1,0],["وَفي بَيتِ الصَفيحِ أَبو عِيالٍ","قَليلُ الوَفرِ يَغتَبِقُ السَمارا",7,"ر",2,0],["وَفي بَطْنِ هِنريطٍ وَسِمْنينَ للظُّبَى","وَصُمِّ القَنَا مِمّنْ أبَدْنَ بَدِيلُ",8,"ل",1,0],["وَفي بَقايا الفُؤادِ نارٌ","توقَدُ في قَلبِ مُستَهامِ",9,"م",1,1],["وَفي بَسطِها عِندَ المَماتِ مَواعِظٌ","أَلا فَاِنظِروني قَد خَرَجتُ بِلا شَيِّ",10,"ي",1,0],["وَفي بَقاءِ السُلطانِ تَسلِيَةٌ","لِكُلِّ قَلبٍ بِالحُزنِ يَضطَرِمُ",11,"م",1,0],["وفي بُرْقُعِ الحسناءِ مقلةُ جؤذَرٍ","بها رُدّ كيدُ السحرِ في نَحرِ بابِلِه",12,"ل",2,0],["وفيّ بِنُصح المَلكِ ما ذُمّ رأيُهُ","ولا حلّ ذو كيدٍ لإبرامهِ عَقْدا",13,"د",2,0],["وفي بغدادَ أقوامٌ كرامٌ","ولكنْ بالسلام بلا طعامِ",14,"م",1,1],["وفي بقياكَ عنْ ماضٍ عزاءٌ","قيامُكَ بعدَهُ نِعْمَ القيامُ",15,"م",1,0],["وَفي بَيتِهِ زِقٌّ وَدَنٌّ وَدَورَقٌ","وَباطِيَةٌ تُروي الفَتى وَتُنيمُ",16,"م",1,0],["وَفي بِيَضِ السُيوفِ عَيشٍ","بِذَلِكَ فَاِعلَموا نَطَقَ الحَكيمُ",17,"م",1,0],["وفي بعض من عاشرت شيء تجله","فذلك لو فتشت عنه هو الخلق",18,"ق",1,0],["وَفي بَطنِ هِنزيطٍ وَسِمنينَ لِلظُبى","وَصُمَّ القَنا مِمَّن أَبَدنَ بَديلُ",19,"ل",1,0],["وَفي باقي النَهارِ ضَعُفتُ حَتّى","أُسِرتُ وَقَد عَيِيَ عَضُدي وَساقي",20,"ي",1,0],["وَفَّى بِمَا أَعْطاهُ حَقَّ بِلاَدِهِ","وَالمَوْهَبَاتُ تُرَدُّ رَدَّ عَوَارِي",21,"ر",2,0],["وفي بيته دن وزق ودورقٌ","وباطية تروى الفتى وتنيم",22,"م",1,0],["وفي بدء (نيسان) حثّ الخريف","اليها من الريح أمضى المطايا",23,"ا",3,0],["وَفي بَطنِ هِنزيطٍ وَسِمنينَ لِلظُبا","وَصُمَّ القَنا مِمَّن أَبَدنَ بَديلُ",24,"ل",1,0],["وفي بانقوساء الحمى كان صدره","عليّ ابن خير الله من طوره الجد",25,"د",1,0],["وفي بطاح الهدى ركن القبول سمت","حتى إلى الرفرف الأسمى قوائمه",26,"م",2,0],["وفي بُعدِهِم بُعد مِنَ الخَيرِ والتُّقَى","وفي قُربِهِم وَصلٌ وفي حُبِّهِم فَضلُ",27,"ل",1,0],["وَفي بَعضِ ذا المَجدِ الَّذي ظَفِرَت بِهِ","يَداكَ غِنىً عَما بَنى الجَدُّ وَالأَبُ",28,"ب",1,0],["وفي بعدنا شوق يقطع مهجتي","كتقطيع بيت الشعر للنظم ميزانا",29,"ن",2,0],["وفي بلد الإسلام تقرأ كتبهم","وقد عقدوا فيها لها مجلساً حفلا",30,"ل",2,0],["وفي بعض ما أمليته من كلامه","غنىً بعضه كاف لأهل البصائر",31,"ر",1,0],["وَفي بدرٍ بقبضتهِ رَماهم","فَشتّت بالحَصى للقومِ شَملا",32,"ل",2,0],["وفي بحر نزلنا بعض يوم","قصدنا بعدها البلد الأمينا",33,"ن",2,0],["وفي بلد الرُستاق ذكرُكَ شائعٌ","شَرَدْتَ وما سيفُ العريكة يلمع",34,"ع",1,0],["وفي بيعة الرضوان فضل لأهلها","وتفضيل أهل البيت ما ليس يُدفع",35,"ع",1,0],["وَفّى بِمَكَّةَ بِضعَ عَشرَةَ حِجَّةً","يَلقى الأَذى في السِرِّ وَالإِعلانِ",36,"ن",1,0],["وَفِي بُدُورِ النُّهَى لَدَيْكَ أَرِنَا","مَا يُكْسِبُنَا سَناً يُسَلِّي الشَّجَنَا",37,"ن",2,1],["وفي باب آسته زغبٌ لطافٌ","ملاحٌ مثل ورد الزاد رخت",38,"ت",1,0],["وَفي بيت رغم اخوَتي واحبتي","مقيمون في ليل من الهم سرمد",39,"د",1,0],["وَفي ببة وَفي كنفي قنوتا","سرت وَاللَيل منعكر بهيم",40,"م",1,0],["وَفِي بَلَنْسِيةٍ مِنْها وَقُرْطُبَةٍ","ما يَنْسِفُ النَّفسَ أَو ما يَنزِفُ النَّفَسا",41,"س",2,0],["وفي بعده أوّاه من نار بعده","تجرّعت يا ذكرى حميم المجامر",42,"ر",1,0],["وفي بكاء الصبح خوف القلى","وفي ابتسام ليلي الاليل",43,"ل",1,0],["وفي بعد عن الشك","وفي بعد عن القول",44,"ل",1,0],["وَفي بِلادِ الفُرسِ مِن","أَولادِهِ مَنو شَهَر",45,"ر",1,0],["وفيَّ بَقيّةٌ بقيَتْ لوَجدٍ","ومَن يَصْحو معَ الحَدَقِ الفَواتن",46,"ن",1,0],["وفي بَدْرٍ بأُفْقِك مُستَنيرٍ","إذا أفْكَرتَ مُسْلٍ عن هِلال",47,"ل",1,0],["وفَى بالنّدى فيهم وأَوفَى عليهمُ","وأَغنَى حُضورٌ منه عن كُلِّ غائب",48,"ب",1,0],["وَفي بِناءِ القَبرِ يا قُربَ ما","يَغدِرُ ديوانٌ وَإِيوان",49,"ن",1,0],["وفي بر وبحر","وأرض والسموات",50,"ت",1,0],["وفي بنِي الدهرِ كُلُّ مُعْضِلَةٍ","مِنَ الذي فاتَ والمواجِيدِ",51,"د",1,0],["وَفِي باكيهِ من بُعدٍ وصدري","وأَجفانِي بِمَنْ أبكي مِلاءُ",52,"ا",2,0],["وفي بحر آمالي إليك فقد جرت","رجاء بأن ترفو لمرضاتك السفن",53,"ن",1,0],["وفي بني الأصفر أوتارٌ لها","نام وليُّ ثأرها وغَفَلا",54,"ل",2,0],["وَفَى بالجوى قلبي وقصَّر منطقي","فأكثرُ قولي فيك أيسرُ أفعالي",55,"ي",1,0],["وَفَى بما سنَّ الكرامُ في الندى","ثم استقلّ فعلَهم فابتدعا",56,"ع",2,0],["وفَى بالسيادة لَدْنَ القضيبِ","ولم تتعاقبْ عليه العصورُ",57,"ر",1,0],["وَفَى بشروطِ المُلك وهو ابن مَهدِهِ","وسُوِّدَ في خيط التميم المعقَّدِ",58,"د",1,0],["وفَى بمجدِ قومِهِ محمدٌ","فبرَّهم وربّما عَقَّ الولَدْ",59,"د",1,0],["وَفَى بالمعالي مستقِلاً بحملها","ميتنٌ إذا خارت قُوَى العزمِ صُلَّبُ",60,"ب",1,0],["وفي بُرْديكَ أغلبُ شمَّريٌّ","وَخِلٌّ في مودَّتهِ حَميمُ",61,"م",1,0],["وفي بَوادي التَّجلِّي عن حقائِقِنا","دقائقٌ هي تُمْلى من حواضِرِنَا",62,"ن",2,0],["وفي بعض ما أولى غناي وإنما ال","ملوك على قدر النفوس تجود",63,"د",1,0],["وَفي بُكائي لحال حالَ مِن عَدَم","لفّقتُ صَبراً فَما أَجدى لِمَنعِ دَمي",64,"م",2,0],["وفي بيتي النبُوّةُ ما عَدَتْنِي","وقانونُ الإمامةِ في نِصابي",65,"ي",1,0],["وفي باب الصغير الكل","لِ زُرناهم كما تَعلمْ",66,"م",1,0],["وفي بحار ال","غرام عائم",67,"م",1,0],["وفي بيروتَ شمسٌ كُلَّ حينٍ","تلوحُ فلا غروبَ ولا قَتامُ",68,"م",1,0],["وفي بيروتَ غُصنٌ ليسَ يُدعى","بغُصنِ البانِ بل غُصنِ البَيانِ",69,"ن",1,0],["وفي بعض ما قد مر مما نظمته","مواقف منهم له في المسائل",70,"ل",1,0],["وفي بنى الشيخ أعني قاسماً درر","غر ميامين من سادات حكام",71,"م",1,0]]}