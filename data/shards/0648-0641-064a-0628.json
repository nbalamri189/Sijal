iewPoem.aspx?id=191391",""],[5953,"أرى ألف الحروف هي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=93806",""],[5956,"في الحقيقة أنت سُوري","https://www.poetsgate.com/ViewPoem.aspx?id=183707",""],[6084,"ومرضعة اولادها بعد ذبحهم","https://www.poetsgate.com/ViewPoem.aspx?id=170827",""],[6093,"أيا إيران","https://www.poetsgate.com/ViewPoem.aspx?id=195089",""],[6148,"أشواق القبة الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=202096",""]],"verses":[["وَفى بِمَواعيدِ الخَليطِ وَأَخلَفوا","وَكَم وَعَدوا القَلبَ المُعَنّى وَلَم يَفوا",0,"ف",3,1],["وَفي بِئرِ حِصنٍ أَدرَكَتها حَفيظَةٌ","وَقَد رُدَّ فيها مَرَّتَينِ حَفيرُها",1,"ر",3,0],["وَفي بَعضِ مَن يُلقي إِلَيكَ مَوَدَّةً","عَدُوٌّ إِذا كَشَّفتَ عَنهُ مُبينُ",2,"ن",1,0],["وفي بابك العالي تفسَّرت المنى","ومن أين للتفسيرِ مثل ابن عبَّاس",3,"س",1,0],["وفي بعض ما أسديت قُنعٌ وإنما","فتىً كنت مرمى ظنّه ليس يقنع",4,"ع",1,0],["وفي بعض أحوال النفوس كأنها","ترى خلف ستر الغيب ما تتوقع",5,"ع",1,0],["وفي بغيك البادي عليك شهادةٌ","بأنك مطروقُ الدماغِ مُخبّلُ",6,"ل",1,0],["وَفي بَيتِ الصَفيحِ أَبو عِيالٍ","قَليلُ الوَفرِ يَغتَبِقُ السَمارا",7,"ر",2,0],["وَفي بَطْنِ هِنريطٍ وَسِمْنينَ للظُّبَى","وَصُمِّ القَنَا مِمّنْ أبَدْنَ بَدِيلُ",8,"ل",1,0],["وَفي بَقايا الفُؤادِ نارٌ","توقَدُ في قَلبِ مُستَهامِ",9,"م",1,1],["وَفي بَسطِها عِندَ المَماتِ مَواعِظٌ","أَلا فَاِنظِروني قَد خَرَجتُ بِلا شَيِّ",10,"ي",1,0],["وَفي بَقاءِ السُلطانِ تَسلِيَةٌ","لِكُلِّ قَلبٍ بِالحُزنِ يَضطَرِمُ",11,"م",1,0],["وفي بُرْقُعِ الحسناءِ مقلةُ جؤذَرٍ","بها رُدّ كيدُ السحرِ في نَحرِ بابِلِه",12,"ل",2,0],["وفيّ بِنُصح المَلكِ ما ذُمّ رأيُهُ","ولا حلّ ذو كيدٍ لإبرامهِ عَقْدا",13,"د",2,0],["وفي بغدادَ أقوامٌ كرامٌ","ولكنْ بالسلام بلا طعامِ",14,"م",1,1],["وفي بقياكَ عنْ ماضٍ عزاءٌ","قيامُكَ بعدَهُ نِعْمَ القيامُ",15,"م",1,0],["وَفي بَيتِهِ زِقٌّ وَدَنٌّ وَدَورَقٌ","وَباطِيَةٌ تُروي الفَتى وَتُنيمُ",16,"م",1,0],["وَفي بِيَضِ السُيوفِ عَيشٍ","بِذَلِكَ فَاِعلَموا نَطَقَ الحَكيمُ",17,"م",1,0],["وفي بعض من عاشرت شيء تجله","فذلك لو فتشت عنه هو الخلق",18,"ق",1,0],["وَفي بَطنِ هِنزيطٍ وَسِمنينَ لِلظُبى","وَصُمَّ القَنا مِمَّن أَبَدنَ بَديلُ",19,"ل",1,0],["وَفي باقي النَهارِ ضَعُفتُ حَتّى","أُسِرتُ وَقَد عَيِيَ عَضُدي وَساقي",20,"ق",2,0],["وَفَّى بِمَا أَعْطاهُ حَقَّ بِلاَدِهِ","وَالمَوْهَبَاتُ تُرَدُّ رَدَّ عَوَارِي",21,"ر",2,0],["وفي بيته دن وزق ودورقٌ","وباطية تروى الفتى وتنيم",22,"م",1,0],["وفي بدء (نيسان) حثّ الخريف","اليها من الريح أمضى المطايا",23,"ا",3,0],["وَفي بَطنِ هِنزيطٍ وَسِمنينَ لِلظُبا","وَصُمَّ القَنا مِمَّن أَبَدنَ بَديلُ",24,"ل",1,0],["وفي بانقوساء الحمى كان صدره","عليّ ابن خير الله من طوره الجد",25,"د",1,0],["وفي بطاح الهدى ركن القبول سمت","حتى إلى الرفرف الأسمى قوائمه",26,"م",2,0],["وفي بُعدِهِم بُعد مِنَ الخَيرِ والتُّقَى","وفي قُربِهِم وَصلٌ وفي حُبِّهِم فَضلُ",27,"ل",1,0],["وَفي بَعضِ ذا المَجدِ الَّذي ظَفِرَت بِهِ","يَداكَ غِنىً عَما بَنى الجَدُّ وَالأَبُ",28,"ب",1,0],["وفي بعدنا شوق يقطع مهجتي","كتقطيع بيت الشعر للنظم ميزانا",29,"ن",2,0],["وفي بلد الإسلام تقرأ كتبهم","وقد عقدوا فيها لها مجلساً حفلا",30,"ل",2,0],["وفي بعض ما أمليته من كلامه","غنىً بعضه كاف لأهل البصائر",31,"ر",1,0],["وَفي بدرٍ بقبضتهِ رَماهم","فَشتّت بالحَصى للقومِ شَملا",32,"ل",2,0],["وفي بحر نزلنا بعض يوم","قصدنا بعدها البلد الأمينا",33,"ن",2,0],["وفي بلد الرُستاق ذكرُكَ شائعٌ","شَرَدْتَ وما سيفُ العريكة يلمع",34,"ع",1,0],["وفي بيعة الرضوان فضل لأهلها","وتفضيل أهل البيت ما ليس يُدفع",35,"ع",1,0],["وَفّى بِمَكَّةَ بِضعَ عَشرَةَ حِجَّةً","يَلقى الأَذى في السِرِّ وَالإِعلانِ",36,"ن",1,0],["وَفِي بُدُورِ النُّهَى لَدَيْكَ أَرِنَا","مَا يُكْسِبُنَا سَناً يُسَلِّي الشَّجَنَا",37,"ن",2,1],["وفي باب آسته زغبٌ لطافٌ","ملاحٌ مثل ورد الزاد رخت",38,"ت",1,0],["وَفي بيت رغم اخوَتي واحبتي","مقيمون في ليل من الهم سرمد",39,"د",1,0],["وَفي ببة وَفي كنفي قنوتا","سرت وَاللَيل منعكر بهيم",40,"م",1,0],["وَفِي بَلَنْسِيةٍ مِنْها وَقُرْطُبَةٍ","ما يَنْسِفُ النَّفسَ أَو ما يَنزِفُ النَّفَسا",41,"س",2,0],["وفي بعده أوّاه من نار بعده","تجرّعت يا ذكرى حميم المجامر",42,"ر",1,0],["وفي بكاء الصبح خوف القلى","وفي ابتسام ليلي الاليل",43,"ل",1,0],["وفي بعد عن الشك","وف