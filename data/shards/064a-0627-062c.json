s://www.poetsgate.com/ViewPoem.aspx?id=179645",""],[106,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[106,"حرب الأعداء الثلاثة","https://www.poetsgate.com/ViewPoem.aspx?id=179643",""],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[59,"يا جاعلَ العلمِ لهُ بازياً","https://www.poetsgate.com/ViewPoem.aspx?id=20458",""],[98,"سائل العلياء عنا والزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=35379",""],[90,"إلى الشباب السوري","https://www.poetsgate.com/ViewPoem.aspx?id=179164",""],[90,"بنت بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=179192",""],[90,"العلم والوطنية","https://www.poetsgate.com/ViewPoem.aspx?id=178949",""],[33,"شُغِفَ الفؤادُ بِجارة","https://www.poetsgate.com/ViewPoem.aspx?id=2571",""],[73,"أضحى التنائي بديلا عن تدانينا","https://www.poetsgate.com/ViewPoem.aspx?id=776",""],[91,"تأملات","https://www.poetsgate.com/ViewPoem.aspx?id=53220",""],[51,"ومن العجائبِ يا أبا الفيَّاض","https://www.poetsgate.com/ViewPoem.aspx?id=29393",""],[51,"لي صديقٌ إذا رأت","https://www.poetsgate.com/ViewPoem.aspx?id=28618",""]],"verses":[["يا جَزَت عَنّي الجَوازي مَعشَراً","مَلَكوا الوِردَ فَأَعطَوني الجُماما",0,"م",2,0],["يا جَواداً أَدمى الجَوادَ مِنَ الطَع","نِ وَوَلّى وَنَحرُهُ مَبلولُ",1,"ل",1,0],["يا جَدِّ لا زالَ لي هَمٌّ يُحَرِّضُني","عَلى الدُموعِ وَوَجدٌ غَيرُ مَقهورِ",2,"ر",1,0],["يا جَدُّ لا زالَت كَتائِبُ حَسرَةٍ","تَغشى الضَميرَ بِكَرِّها وَطِرادِها",3,"د",3,0],["يا جَميلاً جَمالُهُ مِلءُ عَيني","وَعَظيماً إِعظامُهُ مِلءُ قَلبي",4,"ي",1,0],["يا جِبالَ المَجدِ عِزّاً وَعُلى","وَبُدورَ الأَرضِ نوراً وَسَنا",5,"ا",1,0],["يا جُفوني إِن لَم تَجودي بِدَمعٍ","لَجَعَلتُ الكَرى عَلَيكِ حَراما",6,"م",2,0],["يا جَواري فَاِشفَعنَ لي يا جَواري","كَلَّ عَن وَصفِ ما لَقيتُ لِساني",7,"ي",1,0],["يا جَنَّةً لا يَموتُ ساكِنُها","كُلُّ ضَميرٍ إِلَيكِ يَنصَرِفُ",8,"ف",1,0],["يا جَواري حَدِّثنَني بِحاياتي","هَل يُباعُ الحَبيبُ فيمَن يُريدُ",9,"د",1,0],["يَا جَنَّةً فَارَقْتُ مِنْ غُرُفَاتِهَا","دار القرار بما أقتضته ذنوبي",10,"ب",2,0],["يَا جُمْلَةَ الفَضْلِ وَالْوَفَاءِ","مَا بِمَعَالِيكَ مِنْ خَفَاءِ",11,"ف",3,1],["يا جامِعَ العِلمِ نِعمَ الذخرُ تَجمَعُهُ","لا تَعدِلَنَّ بِهِ دُرّاً وَلا ذَهَبا",12,"ب",2,0],["يا جارَتي ما كُنتُ جارَه","بانَت لِتَحزُنَنا عُفارَه",13,"ر",2,1],["يا جارَتي بيني فَإِنَّكِ طالِقَه","كَذاكِ أُمورُ الناسِ غادٍ وَطارِقَه",14,"ق",2,1],["يا جاكُ إِنَّكَ في زَمانِكَ واحِدٌ","وَلِكُلِّ عَصرٍ واحِدٌ لا يُلحَقُ",15,"ق",1,1],["يا جامِعَ الفَضلِ الَّذي قَد غَدا","مُفَرَّقاً ما بَينَ أَندادِهِ",16,"ه",1,1],["يا جَنَّةَ الخُلدِ أُبدِلنا بِسِدرَتِها","وَالكَوثَرِ العَذبِ زَقّوماً وَغِسلينا",17,"ن",2,0],["يا جَواداً بِيَ إِنّي","بِكَ وَاللَهِ ضَنينُ",18,"ن",1,0],["يا جَمالَ المَوكِبِ الغادي إِذا","سارَ فيهِ يا بَهاءَ المَجلِسِ",19,"س",1,0],["يا جَحشُ يا جَحشُ مَنَتكَ الأَسباب","إِن تَكُ وَثّاباً فَإِنّي وَثّاب",20,"ب",1,1],["يا جَعدَ بَكّيهِ وَلا تَسأَمي","بِكاءَ حَقٍّ لَيسَ بِالباطِلِ",21,"ل",1,0],["يَا جَنَّةً أَهْدَتْ إِلَيَّ سَلاما","أَهْدَيْتِ بَرْداً لِلحَشَى وَسَلامَا",22,"م",2,1],["يَا جَلِيسِي وَكُنْتَ أَيَّ جَلِيسٍ","يَا نَدِيمِي وَكُنْتَ أَيَّ نَدِيمِ",23,"م",1,0],["يا جَدُّ قَد مُنَعوا الفُراتَ وَقُتِّلوا","عَطَشاً فَلَيسَ لَهُم هُنالِكَ مَورِدُ",24,"د",1,0],["يا جَدُّ إِنَّ الكَلبَ يَشرَبُ آمِناً","رِيّاً وَنَحنُ عَنِ الفُراتِ نُطَرَّدُ",24,"د",1,0],["يا جَدُّ قَد أَمسَيتُ مِمّا نالَني","وَلِما أُعانيهِ أَقومُ وَأَقعُدُ",24,"د",1,0],["يا جَدُّ لَو أَبصَرتَني وَرَأَيتَني","وَالخَدُّ مِنّي بِالدِماءِ مُخَدَّدُ",24,"د",1,0],["يا جَدُّ ذا نَحرُ الحُسَينِ مُضَرَّجٌ","بِالدَمِ وَالجِسمُ الشَريفُ مُجَرَّدُ",24,"د",1,0],["يا جَدُّ ذا صَدرُ الحُسَينِ مُرَضَّضٌ","وَالخَيلُ تَنزِلُ مِن عَلَيهِ وَتَصعَدُ",24,"د",1,0],["يا جَدُّ ذا نَجلُ الحُسَينِ مُعَلَّلٌ","وَمُغَلَّلٌ في قَيدِهِ وَمُصَفَّدُ",24,"د",1,0],["يا جَدُّ ذا شَمِرٌ يَرومُ بِفَتكِهِ","ذَبحَ الحُسَينِ فَأَيُّ عَينٍ تَجمُدُ",24,"د",1,0],["يا جَوادَ اللِسانِ مِن غَيرِ فِعلٍ","لَيتَ في راحَتَيكَ جودَ اللِسانِ",25,"ن",1,1],["يا جيرةً تعرفُ الأحياءُ جودَهُمُ","ما ضَرَّ من ضنَّ بالإحسان لو سمحا",26,"ح",2,0],["يا جاهِداً في مَساويهِم يُكَتِّمُها","غَدرُ الرَشيدِ بِيَحيى كَيفَ يَنكَتِمُ",27,"م",1,0],["يا جاحِداً فَرطَ غَرامي بِهِ","وَلَستُ بِالناسي وَلا الجاحِدِ",28,"د",1,1],["يا جابرَ القلبِ خذها مدحة سلمتْ","فبيتُ حاسدِها أولى بإقواء",29,"ا",2,0],["يا جائداً رام أن تخفى له مننٌ","هيهات ما المسك مطويّ بإخفاء",30,"ا",2,0],["يا جفنُ لستُ أراكَ تعرفُ ما الكرَى","فعلامَ تشكو منه مرَّ جفاء",31,"ا",2,0],["يا جفنُ أمزجْ أدمعي بدمائي","وأشهدْ بها لملوكنا الشهداء",32,"ا",2,1],["يا جابراً قلبي بنجح مقاصدي","حتى إذا كاتبنه بجواب",33,"ب",1,0],["يا جودَ سلطان العبادِ ومدحنا","طابَ الصبوحُ لنا فهاك وهات",34,"ت",1,0],["يا جامعَ المالِ إنَّ العمر منصرمٌ","فابْخل بمالِكَ مهما شئتَ أو فجدِ",35,"د",1,0],["يا جفنها وكرى عينيّ فطرني","من كانَ منكم مريضاً أو على سفر",36,"ر",1,0],["يا جاعل الجامع المعمور منتظراً","محاسناً منه في الأوصاف مبتدَعه",37,"ه",1,1],["يا جائل الطرف في السادات منتقداً","ها قد وصلت إلى أزكاهُم فقف",38,"ف",1,0],["يا جاعلاً في حمص قلبي لقد","حمَّصت مشتاقكَ حتَّى احْترق",39,"ق",1,0],["يا جود مهديها إذا قلنا انْتهى","ركبت فيها طبقاً عن طبق",40,"ق",1,0],["يا جفوني دعي الكرى بعد مرأى","فاتن الحسن ناصبٍ لشراكِ",41,"ك",1,1],["يا جلالاً عن الزمان تقضَّى","عزّ ربٌّ قضى وجلَّ جلاله",42,"ل",2,0],["يا جنة الخال على خدّه","ما أنت إلا شامة في الشآم",43,"م",1,0],["يا جائل الطرف في السادات قف بحمى","من ليس يحتاج تعريفاً وتبيينا",44,"ن",2,0],["يا جواداً أنشى المدائح معنًى","بنوالٍ يريك معنًى ثاني",45,"ن",2,0],["يا جفنهُ الناصب فيه فكري","ونصبهُ وجرُّه بالكسر",46,"ر",1,0],["يا جُملَةَ الكُلِّ لَستَ غَيري","فَما اِعتِذاري إِذاً إِلَيِّ",47,"ي",1,0],["يا جُملَةَ الكُلِّ الَّتي كُلُّها","أَحَبُّ مِن بَعضي وَمِن سائِري",48,"ي",1,0],["يا جواداً هجا مَديحيه بالحر","مان ما اسطاع لا تكن هجّاءَ",49,"ا",2,0],["يا جبهةً جلحاء مقْبُوبةً","وفَقْحَةً رسحاءَ محلُوجَهْ",50,"ج",2,0],["يا جواداً إذا حمتْ","لِقَحُ المزن دَرَّها",51,"ر",3,0],["يا جَبَل الحِرزِ والثمار ألا","تعصمني من سِباعك النُهُس",52,"س",1,0],["يا جانيَ الثمر اللذيذ مذاقةً","ما لي أراك كآكل الحمّاض",53,"ض",1,0],["يا جمال الدنيا وغيثَ بني الده","رِ وبدرَ الدجى وليثَ الغِياض",54,"ض",1,0],["يا جارتي أودى بياضُ مُسرَّحي","وبريقه بسواده ورفيفه",55,"ف",2,0],["يا جُثَّة التل ويا وجه الهدفْ","يا روثة الفيل ويا لحم الصدَفْ",56,"ف",1,0],["يا جبلَ اللَّهِ في بسيطته","لا هدَّكَ اللَّهُ بعدما وطَدَكْ",57,"ك",1,0],["يا جِبلةً أملاكُها تِرَكٌ","حتَّامَ ذُبُّكُمُ على التِّرَكِ",58,"ك",1,0],["يا جاعلَ الليل لها طُرَّةً","وجاعلَ الصُّبح لها جَبْهَهْ",59,"ه",2,0],["يا جوادٌ إذا تأبَّى قَريضٌ","أسعَدَ المادحين فيه أبيُّهْ",60,"ي",2,0],["يا جَنَّةً عوجِلَت عَن أَثمارِها","وَلَذاذَةً عُرِّيَت مِن سِربالِها",61,"ل",3,0],["يا جَنَّةَ الحُبِّ وَدُنيا المُنى","ما خِلتُني أَلقاكِ في مُقلَتَين",62,"ن",1,0],["يا جَنَّةً قَبلَما حَلَّت بِها قَدَمي","أَحبَبتُها قِصَّةً وَاِشتَقتُ راويها",63,"ي",3,1],["يا جاهِلَ الحُبَّ إِنَّ الحُبَّ لي سَنَدٌ","مَهما أُجَزَ عَنهُ يَوماً سَوفَ أَعتَمِدُ",64,"د",1,1],["يا جو كيف اجزت ان","تصل المنون الى عقابك",65,"ك",1,0],["يا جارة الأيك أيام الهوى ذهبت","كالحلمآها لآيام الهوى آها",66,"ا",3,0],["يا جاهلا معاني الحريه","يا فاقدا حسّ الحياة الحيه",67,"ي",2,0],["يا جاهِلينَ عَلى الهادي وَدَعوَتِهِ","هَل تَجهَلونَ مَكانَ الصادِقِ العَلَمِ",68,"م",1,0],["يا جارةَ الوادي ، طَرِبْتُ وعادني","ما يشبهُ الأَحلامَ من ذكراكِ",69,"ك",1,0],["يا جَزَعَ العِلمِ عَلى","سُكَينَةِ المُوَقَّرَه",70,"ر",2,0],["يا جارَةَ الوادي طَرِبتُ وَعاوَدَني","ما يُشبِهُ الأَحلامَ مِن ذِكراكِ",71,"ك",1,0],["يا جائِبَ الصَحراءِ مِلءُ سَرابِها","غَرَرٌ وَمِلءُ تُرابِها أَخطارُ",72,"ر",1,0],["يا جيرَةَ المَنشِ حَلّاكُم أُبُوَّتُكُم","ما لَم يُطَوِّق بِهِ الأَبناءُ آباءُ",73,"ا",2,0],["يا جَذوَةَ التَوحيدِ هَل لَكَ مُطفِئٌ","وَاللَهُ جَلَّ جَلالُهُ مُذكيكِ",74,"ك",1,0],["يا جَمالَ الدُنيا سَناءَ وَمَجداً","وَثِمالَ الدُنيا عَطاءً وَبَذلا",75,"ل",2,0],["يا جارَ هَمدانَ مَن يَمُت يَرَني","مِن مُؤمِنٍ أَو مُنافِقٍ قَبلا",76,"ل",2,1],["يا جامِعَ المالِ مُنذُ كانَ غَداً","يَأتي عَلى ما جَمَعتَهُ الحَرَبُ",77,"ب",1,0],["يا جامِعَ المالِ الكَثيرِ لِغَيرِهِ","إِنَّ الصَغيرَ مِنَ الذُنوبِ كَبيرُ",78,"ر",1,0],["يا جامِعَ المالِ في الدُنيا لِوارِثِهِ","هَل