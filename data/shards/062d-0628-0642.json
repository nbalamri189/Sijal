{"poems":[[92,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[96,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91755","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141595","الكامل"],[4984,"ويحك ..","https://www.poetsgate.com/ViewPoem.aspx?id=175801",""],[5411,"هُنا نَنْتَهي","https://www.poetsgate.com/ViewPoem.aspx?id=202887",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[6001,"روحي تحبك","https://www.poetsgate.com/ViewPoem.aspx?id=406",""]],"verses":[["حب قلبي ذكركم تعويذةً","وأماناً من صروف القدر",0,"ر",1,0],["حبّ قد انتظم الوجود بأسره","أسد الشرى وحمامة الأدواح",1,"ح",1,0],["حبٌّ قضيت بحبه زَمنَ الصبا","وَهوَ الأَنيس وَقرّةٌ للعين",2,"ن",1,0],["حبق السري اليوم في وقت الضحى","والجو أدكن ليس يسفر عن شرق",3,"ق",1,1],["حب قديم لك أضمرته","لمّا يزل في القلب وشما هنا",4,"ن",2,0],["حُبٌ قَديمٌ بِيْنَنا","وَأنا إليْكَ تَوَجُّهي",5,"ه",2,0],["حبٌّ قديمٌ حيث يمّمَ وجههُ","عرضتْ لهُ ذكراكِ نجماً هاديا",6,"ي",2,0],["حب قديم في الضماير سكنّي","داخل حنايا القلب رسمك وموطاك",7,"ك",1,0]]}