{"poems":[[285,"كم توالت يا سعيد بن علي","https://www.aldiwan.net/poem60569.html","الطويل"],[376,"لمن القلب المعنى وبمن","https://www.aldiwan.net/poem57040.html","الرمل"],[534,"عجبا أين العقول","https://www.aldiwan.net/poem37269.html","مجزوء الرمل"],[534,"ليت شعري والأماني تخطر","https://www.aldiwan.net/poem37390.html","الرمل"],[563,"إنني قد شفني السقم","https://www.aldiwan.net/poem34089.html","المديد"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122627","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64367","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70922","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201742","الخفيف"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147350","الرمل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35510","المديد"],[4750,"الطيب","https://www.poetsgate.com/ViewPoem.aspx?id=180398",""],[4869,"الشوارع في غيابه عرايا","https://www.poetsgate.com/ViewPoem.aspx?id=138051",""],[4869,"زكاة الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=151515",""],[5061,"الاجوديه","https://www.poetsgate.com/ViewPoem.aspx?id=147150",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5461,"لا تملين الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=5023",""],[5461,"الحزن في صوتك","https://www.poetsgate.com/ViewPoem.aspx?id=501",""],[5943,"كلَّما وجَّهتُ وجهي","https://www.poetsgate.com/ViewPoem.aspx?id=11287",""],[6084,"يا سقى صوب الحيا الحي غيثاً","https://www.poetsgate.com/ViewPoem.aspx?id=170876",""]],"verses":[["كُلَّما وافَتْ يَدٌ بَعْدَ يَدٍ","هَوَّنَ الآخِرُ قَدْرَ الأَوَّلِ",0,"ل",1,0],["كلَّما واصَلني عاتَبَني","طالَ ذا العَتبُ وواصَلت فَهَن",1,"ن",1,0],["كُلَّما وَافَاهُ نَصٌّ","قَامَ بالرَّأْي يَصُولُ",2,"ل",1,0],["كُلَّما وَجَّهْتُ فِكْري نَحْوَها","عَارَضَ المْورِدَ فيها المصْدَرُ",3,"ر",1,0],["كلما وليت يقبل بي","وإذا قطَّبتُ يبتسمُ",4,"م",1,0],["كُلَّما ولَوَلَ النَّسيمُ سَرى مِن","ها بأذكى مِن فارَةِ العَطّار",5,"ر",1,0],["كلما ووزنوا به","فهمُ منه أرجح",6,"ح",1,0],["كلما وارت الضمائرُ سرا","أخرجتْه منها يدُ النَّباش",7,"ش",1,0],["كلما ودّع الفؤادُ حبيباً","جاء ثانٍ مجدّداً ليَ حبِّي",8,"ب",2,0],["كُلَّمَا وَجْهُ السَّمَاءِ مُعرْبِدٌ","طَافَ بِالإِشْرَاقِ حَوْلَ البَلْسَمِ",9,"م",1,0],["كُلَّما وَلّى أَوان اِغتِباقٍ","شَفَعوهٌ بِأَوانِ اِصطِباحِ",10,"ح",1,0],["كل ماواجهت لك في الزمن وجه غريب","مثل ما قال المثل دام تمشي مشها",11,"ش",3,0],["كل ماوقفت ادوّره بالمرايا","لقيته معشش بذيّه وذيّه",12,"ي",2,0],["كلما وصلتك .. صاب دربك ثموله","وكلما دفنت اللي مضى .. جيت حافر",13,"ر",1,0],["كل ماوصفته يلحق الوصف نقصان","كني وصفت الرنج بالددسنيه",14,"ي",2,0],["كلما وقر وعظي سمعه","نقص الوصل وبالهجران زادا",15,"د",2,0],["كلّما ونّيت ردّوها نشيده","واسمع جروحي تصيح بصوت ثاني",16,"ن",2,0],["كلما ودعت هم زارني","من عذاب الوجد بياح الكنين",17,"ن",1,0],["كلَّما وليَّتُ وجهي","شطرَ خيرٍ نلتُ خيرا",18,"ر",2,1],["كلما واصلته صد عني","ورماني بالحشى آه سهاما",19,"م",2,0]]}