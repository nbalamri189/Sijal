{"poems":[[65,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[65,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[53,"ذهب الذين تهزهم مداحهم","https://www.aldiwan.net/poem66383.html","البسيط"],[87,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[45,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[47,"لازال محتفل الغمام الباكر","https://www.aldiwan.net/poem63617.html","الكامل"],[46,"الزنج أكرم منكم والروم","https://www.aldiwan.net/poem30003.html","الكامل"],[69,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[77,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[48,"إصبر فمن حيث أهين الحصى","https://www.aldiwan.net/poem22595.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39613","السريع"],[47,"لا زَالَ مُحْتَفِلُ الغَمَامِ الباكِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31295",""],[136,"دمن الأحبة لو عصيت العاذلا","https://www.aldiwan.net/poem54777.html","الكامل"],[146,"يا صحابي واين منى صحبى","https://www.aldiwan.net/poem58430.html","البسيط"],[168,"وله نابه وخطب جليل","https://www.aldiwan.net/poem67814.html","الخفيف"],[311,"صرمت ظليمة خلتي ومراسلي","https://www.aldiwan.net/poem25.html","الكامل"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[371,"والمدن إن رجع المسا","https://www.aldiwan.net/poem17782.html","مجزوء الكامل"],[457,"يا مؤثرا للهو طيب النعمه","https://www.aldiwan.net/poem13927.html","الكامل"],[463,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[469,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[469,"لهفي على غصن النقا المتمايل","https://www.aldiwan.net/poem3200.html","عموديه"],[469,"ولقد نزلت من الجزيرة منزلاً","https://www.aldiwan.net/poem3551.html","عموديه"],[500,"غضي جفونك يا رياض","https://www.aldiwan.net/poem9883.html","مجزوء الكامل"],[505,"ما انبلج الصباح في طالعه","https://www.aldiwan.net/poem37820.html","الرجز"],[519,"حتام أشغل بفكر القلب واعذبه","https://www.aldiwan.net/poem20895.html","المواليا"],[563,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[563,"طرف الذي طلب التحقيق سهران","https://www.aldiwan.net/poem33823.html","البسيط"],[563,"محمد الإسم حمد الرسم معلوم","https://www.aldiwan.net/poem33887.html","البسيط"],[580,"حسبي كما حكم الغرام وحسبها","https://www.aldiwan.net/poem3099.html","الكامل"],[591,"المغرم من ذكراكم يقلقه","https://www.aldiwan.net/poem17624.html","مخلع الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122824","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86977","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87098","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87164","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34399","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62450","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120125","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25318","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56126","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64603","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49948","البسيط"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202556","الكامل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131337","الرجز"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96029","البسيط"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96030","الكامل"],[2372,"","https://poetry.dctabudhabi.ae/diwan/poem/146240","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87398","الكامل"],[3347,"","https://poetry.dctabudhabi.ae/diwan/poem/142288","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62940","الكامل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3725,"","https://poetry.dctabudhabi.ae/diwan/poem/216335",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131110",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90802","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81690","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83357","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120499","الكامل"],[4702,"الصبر شوك","https://www.poetsgate.com/ViewPoem.aspx?id=155106",""],[4759,"ربما أو ربما","https://www.poetsgate.com/ViewPoem.aspx?id=204042",""],[4759,"المساء الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=204144",""],[4767,"لا عودة","https://www.poetsgate.com/ViewPoem.aspx?id=190159",""],[4797,"مدحك يابو خالد","https://www.poetsgate.com/ViewPoem.aspx?id=178139",""],[4963,"يامدعين الشعر خلوه خلوه","https://www.poetsgate.com/ViewPoem.aspx?id=36043",""],[5039,"نجد واهلها","https://www.poetsgate.com/ViewPoem.aspx?id=48112",""],[5131,"نحْنُ هنا إِنْ يحنِ الموعدُ","https://www.poetsgate.com/ViewPoem.aspx?id=58246",""],[5136,"عاد عليك العيد عام فعام","https://www.poetsgate.com/ViewPoem.aspx?id=121722",""],[5186,"لم يبق لي في الساح جولة جائل","https://www.poetsgate.com/ViewPoem.aspx?id=156459",""],[5219,"لكم الله","https://www.poetsgate.com/ViewPoem.aspx?id=194512",""],[5279,"فِي مَدْحِ المُصْطَفَى","https://www.poetsgate.com/ViewPoem.aspx?id=183878",""],[5338,"غالى ولم يبلغ قصيدي","https://www.poetsgate.com/ViewPoem.aspx?id=187759",""],[5377,"صخرة","https://www.poetsgate.com/ViewPoem.aspx?id=61895",""],[5431,"كي لا تُداس وتُكسرا","https://www.poetsgate.com/ViewPoem.aspx?id=196669",""],[5444,"موكب العز","https://www.poetsgate.com/ViewPoem.aspx?id=205068",""],[5466,"يا مَنْ يرومُ تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[5561,"الشاعرُ السجين","https://www.poetsgate.com/ViewPoem.aspx?id=193065",""],[5606,"ردعلى مرثية الشاعرمصلح بن بطحان السحيمي","https://www.poetsgate.com/ViewPoem.aspx?id=199035",""],[5756,"اربع خناجر","https://www.poetsgate.com/ViewPoem.aspx?id=5190",""],[5848,"الشيخ عبدالعزيز بن جامع","https://www.poetsgate.com/ViewPoem.aspx?id=53333",""],[5936,"ثمان وثمان","https://www.poetsgate.com/ViewPoem.aspx?id=184818",""],[6056,"نجاحي بعيد الإحتمال .....!","https://www.poetsgate.com/ViewPoem.aspx?id=130158",""],[6102,"طوبى لغزة","https://www.poetsgate.com/ViewPoem.aspx?id=184438",""],[6142,"ملك ميت بسكتةِ قلبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155688",""],[6189,"بهو الفيروز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83569&r=&rc=36",""],[6257,"المجازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87187&r=&rc=12",""],[5567,"ناسكة الأسرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81812&r=&rc=62",""]],"verses":[["والمَدْحُ والهَجْوُ سَواءٌ عندَهُمْ","فمَنْ هَذى بمَدْحِهِمْ كَمَنْ هَجا",0,"ا",1,0],["والمَدْحُ يَسهُلُ في عُلاكَ مَرامُهُ","فنَداكَ يُمْليهِ عليَّ وأنْظِمُ",1,"م",1,0],["والمدح يَقْرعُ قلبَ من هُوَ أهلُه","قرْعَ المَواعظِ قلب ذي إيمان",2,"ن",1,0],["وَالمُدامُ أَكؤُسُها","ما تَغيضُ وَالعُلَبُ",3,"ب",1,0],["وَالمَدحُ لِاِبنِ أَبي الهَيجاءِ تُنجِدُهُ","بِالجاهِلِيَّةِ عَينُ العِيِّ وَالخَطَلِ",4,"ل",1,0],["وَالمَدحُ لَيسَ يَجوزُ قاصِيَةَ المَدى","حَتّى يَكونَ المَجدُ مَجدَ الشاعِرِ",5,"ر",1,0],["وَالمُدَّعي صورانَ مَنزِلَ جَدِّهِ","قُل لي لِمَن أَهَناسُ وَالفَيّومُ",6,"م",1,0],["والمُدَّعُو التَّثلِيث قَوْمٌ سَوَّغُوا","ما خالف المنقولَ والمَعْقُولا",7,"ل",2,0],["والمدحُ في ملِكٍ سِواك مُضَيَّعٌ","والقَوْلُ في أحَدٍ سِواكَ تَقَوُّل",8,"ل",1,0],["وَالمُدُّ يَكفيكَ وَلَكِنَّ في","طَبعِكَ أَن يُدَّخَرَ الكُرَّ",9,"ر",1,0],["والمدفعُ الصخَّابُ من صنعهِ","والحُمَمُ الحمْرُ كُرَاتُ المنونْ",10,"ن",1,0],["وَالمَدْحُ لَيسَ يَحُوزُ قاصِيَةَ المَدَى","حتى يكُونَ المَجد مجدَ الشّاعِرِ",11,"ر",1,0],["والمُدني السني مِن جَنَباتِهِ","وَالمُنئى البِدَعَ المُمِيتَ البَاطِلا",12,"ل",2,0],["والمديحُ العتيقُ للعِرض واقٍ","والمديحُ الهجينُ بعضُ الثَّلبِ",13,"ب",1,0],["وَالمَداريكُ لِلذُحولِ بَنو قَس","مَل إِن خِفتَ أَن يَفوتَ الذُحولُ",14,"ل",1,0],["والمدركينَ عدوّهم بذُحُولهم","والنازلينَ لضربِ كلّ مُنازلِ",15,"ل",1,0],["وَالمَدِّ في العَيانِ لِلظِلِّ الَّذي","عَلى الصَفاءِ دونَهُ العَقلُ قَصَر",16,"ر",1,0],["وَالمُدنُ إِن رَجَعَ المُسا","فِرُ أَو إِذا خَرَجَ المُسافِر",17,"ر",1,1],["والمدح يأتي قبله النسيبُ","وربّما يُقْتَرحُ التشبيبُ",18,"ب",1,0],["والمدحُ في مِعصَم سوارٌ","وفي أكفٍّ أُخرَى كُبولُ",19,"ل",1,0],["والمدح وقفٌ عليهم منحَ سيبهمِ","والشعر يشرى بأغلى السعر والقيمِ",20,"م",1,0],["والمدحُ تحييهِ الوعودُ حقيقةً","ويميتهُ بُعدُ المدى المتطاول",21,"ل",1,0],["والمدُّ مدُّ النيل ذائبُ عسجدٍ","يغني البلاد فأهلها لاتخشع",22,"ع",1,0],["والمدح طلق ما عنا","ك فإن عداك تجده كزا",23,"ز",2,0],["والمَدَدِ الفَيَّاضِ من يَمينِهِ","وسِبْطهِ جَدِّي شَهيدِ كَرْبَلا",24,"ل",2,0],["والمدح لو لم أجيده فيك وأهذبه","أريد أقول الصدق ويفوتني أعذبه",25,"ه",1,0],["والمدح ترصيعه يخفيه غير كمي","بالصدح ترجيعه يبديه طير فمي",26,"م",2,0],["والمدح والذم فيه الإستواء كذا","تفكرٌ حكمةٌ تنمو وتزدان",27,"ن",1,0],["والمد معناه في العرف الزيادة من","شيء يقال وما قد قيل محتوم",28,"م",1,0],["والمدح فيك يغيظها وعلى القتا","دِ يجرُّها وعلى الوجوهِ يكبُّها",29,"ب",3,0],["وَالمُدنَفُ مَنْ مَدْمَعهُ يَغْرِقُهْ","وَالعَاشِقُ فِيكَ بَلّة تَخْنُقُهْ",30,"ه",1,0],["والمُدهِشُ المُرهِشُ السَّحابُ حينَ بَدا","في رَقمِ راقمِهِ أَو وَشيِ واشيهِ",31,"ي",2,0],["وَالمَدح فيكَ حَقيقة وَطَبيعة","وَلَدى سِواك تَصنُّعٌ وَتكلف",32,"ف",1,0],["وَالمَدح فيهِ مدوّنٌ بِصحائفٍ","لِسطورها قلمُ الصَداقة راقم",33,"م",1,0],["وَالمَدح فيكَ مِن البرية واحدٌ","أَبداً وَفي جلِّ الوَرى مُتباين",34,"ن",1,0],["وَالمَدحُ فيهِ قُصورٌ عَنكُمُ وَعَسى","في الخُلدِ يُبدلُ مِن أَبياتِهِ غُرَفا",35,"ف",2,0],["والمدعي مثلَ اسمِه مُدَّعٍ","ومن يقل بالحق لم يكذبِ",36,"ب",1,0],["والمدح للمولى أبي ال","فضل الكريم المستماحِ",37,"ح",1,0],["وَالمَدْحُ رِبْحٌ لاِمْرِءٍ تَرَبَّحا","مَنَحْتُ عَبْدَ اللَّهِ مِنْهَا مِنَحا",38,"ح",2,0],["والمدعي يقضي الحياة معَثراً","ويراعه ابداً يزلّ ويزهقُ",39,"ق",1,0],["والمدح والذم ومنقول وفي","إضافة لجرّ يا النفس تفي",40,"ي",1,0],["والمد نصفُ طرفه احتوى على","شظيّةٍ من بعد خسفٍ أقبلا",41,"ل",2,0],["والمدّ قبل الياء إن تطرفا","بمنعه في كل خطٍّ وصفا",41,"ف",2,0],["والمدركون لمعناها رأوا أجلاً","ينعى الركون إليها في دواهيها",42,"ي",3,0],["والمَدركون من الباغين ثأرَهم","لا يهجعون على وتر وأَحقادِ",43,"د",1,0],["والمدح من شرف المكارم في العلى","بمكان نور الطرف من إنسانه",44,"ن",2,0],["والمَدْحُ في صفاتِهَا مُخْتَصرُ","فَوصْفُهَا وحَقّكُم لا يُحْصَرُ",45,"ر",1,0],["والمدركون إذا ما أزمة بخلت","بصرفها وتخلت عندها الصحب",46,"ب",1,0],["والمدح في أم الكتاب","وما أتى عن جبرئيل",47,"ل",1,0],["والمدح في غير الوزير محمد","ذي الفضل مأثمة من الآثام",48,"م",1,0],["وَالمَدحُ لَيسَ يَفي عُلاك وَلَو مَلا","صُحُفَ الرَقيع بزُهرِهِ مكتوبا",49,"ب",2,0],["والمدى قلب وعين ويد","والشذا عبق الفداء الطيب",50,"ب",1,0],["والمدحُ ليس خيارُه اِلاَّ لمنْ","كانتْ رئاستُه على الأحرَارِ",51,"ر",1,0],["وَالمَدُّ زِيدَ ثَالِثاً فِى الوَاحِدِ","هَمزاً يُرَى فِى مِثلِ كَالقَلاَئِدِ",52,"د",1,0],["والمدح مني غير مقتصر","ونداك لا قل ولا كثر",53,"ر",1,0],["والمداوي بذاك قلبا كئيبا","كالمداوي بالنار جرح الكليم",54,"م",1,0],["والمدح معتبر بالمستحق له","على الجميل وإلا غير معتبر",55,"ر",1,0],["والمدح ليس يجيء إلاّ قاصراً","عنكم ولو بلغ السها في المعرجِ",56,"ج",1,0],["وَالمَدحُ لا شَكَّ عُنوانُ المَحَبَّةَ بَل","دَليلُ صحَّةِ إيمان بِلا جَدَلِ",57,"ل",1,0],["والمدح ما يهدى إليه لا الى","من ظن ان غناك منه نقير",58,"ر",1,0],["والمدح سيلٍ منحدر ما له غْيوم","والذم نار المصلحة تضرم اضرام",59,"م",1,0],["والمداءات التي تحملني","وضئت بالنور وأشتاقت لما",60,"م",2,0],["والمدارات عطرها وشذاها","والبهاء آت ليس إلا الغرام",61,"م",1,0],["والمِدفع ليس بأيدينا","لكنا كُلفتَه ندفع",62,"ع",1,0],["والمدح للي حط لي فوق الكتوف","جميل وكتوفي مهي بالاخشبين",63,"ن",1,0],["والمدعي لشعر تكفون كبوه","ونغربل الساحه من المدعينا",64,"ن",2,0],["والمده اللي يستحي من بذلها","ماهيب من خير ولا هيب لأخيار",65,"ر",1,0],["والمدفع الهدَّار يبدي لنا","آراءَهُ لا أَلسنٌ تزبد",66,"د",1,0],["والمدح ما سابح طبعي به","يسبح في نثر ولا في نظام",67,"م",1,0],["والمدح لغو في شباب