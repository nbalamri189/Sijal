{"poems":[[74,"مولاي ما متعب يلوح على الس","https://www.aldiwan.net/poem19362.html","المنسرح"],[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[53,"لنا صديق كلا صديق","https://www.aldiwan.net/poem66443.html","مخلع البسيط"],[63,"يا حسن لينوفر شغفت به","https://www.aldiwan.net/poem51768.html","المنسرح"],[50,"نمت إلى الصبح وإبليس لي","https://www.aldiwan.net/poem65112.html","السريع"],[287,"وأهيف القد بالقلوب هفا","https://www.aldiwan.net/poem32705.html","المنسرح"],[358,"أنسمة فاحت بنشر الخزام","https://www.aldiwan.net/poem39801.html","السريع"],[369,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[435,"لله فوار ماء كاللجين بدا","https://www.aldiwan.net/poem40763.html","البسيط"],[466,"موسع المعروف رحب المنزل","https://www.aldiwan.net/poem16430.html","الرجز"],[543,"كما قلتم لن يرتضي السلم مجرم","https://www.aldiwan.net/poem47935.html","عموديه"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53874","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64330","المنسرح"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37718","المنسرح"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1403,"","https://poetry.dctabudhabi.ae/diwan/poem/115357","البسيط"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105844","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53228","البسيط"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45684","البسيط"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93344","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115422","البسيط"],[3153,"","https://poetry.dctabudhabi.ae/diwan/poem/126079","البسيط"],[5596,"العنب","https://www.poetsgate.com/ViewPoem.aspx?id=206378",""],[5724,"قف يا زمان معي بالله وانتحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55151&r=&rc=18",""]],"verses":[["كأنه عاشق تهيج له الأوت","ار شجواً وليس بالعاشق",0,"ق",1,0],["كأنه عاشقٌ دنا شغفاً","حتى قضى من حبيبه وَطره",1,"ر",2,0],["كأنه عندهم غريمٌ","حلَّتْ عليه لهم ديونُ",2,"ن",1,0],["كأنه عاشقٌ به ظمأ","توهَّمَ الماءَ ريقَ محبوبِهْ",3,"ه",1,0],["كَأَنَّهُ عَذراءُ في خِدرِها","وَلَيسَ في لَبَّتِهِ نَظمُ",4,"م",1,0],["كَأَنَّهُ عاشِقٌ لِوَجنَتِهِ","حَتّى إِذا ما تَقابَلا وَقَفا",5,"ف",2,0],["كَأَنَّهُ عقد الثُرَيّا إِذا","حَلّى ثَناه جيد بَدر التَمام",6,"م",1,0],["كأنّه على القَدَر","يومُ السُّرورِ في العُمُر",7,"ر",1,0],["كأنه عابدٌ قد شاب من كبرٍ","واهتز يقرأُ أبيات الصفا سحرا",8,"ر",2,0],["كأنهُ عند التِفافِ العُيَّلِ","والقومُ بين خائِفٍ ومُرْمِلِ",9,"ل",1,0],["كأنَّهُ عن أَنيابِه الوحشُ كاشراً","وقد خَاله شُهداً إذا بهِ عَلقَمُ",10,"م",1,0],["كأنه عندك كان اهتما","بماله ولم يكن مغتما",11,"م",2,0],["كأنه عند الذي قد اقتدى","بجهله وغيذه قد اهتدى",11,"د",2,0],["كأنّه عارِفٌ بالغيبِ يَعْلَمُهُ","إذا غَدَا مُدَّعيهِ يَدَّعِي هَوَسَا",12,"س",2,0],["كأنه عاشق به ظما","بحال في الماء ريق محبوبه",13,"ه",1,0],["كأنّهُ عَنبَرٌ على لَهَبٍ","يَفوحُ طِيباً ولَيْسَ يَحْتَرِقُ",14,"ق",1,0],["كأنه عابد في راس صومعة","لوقع تسبيحه في القلب نزعات",15,"ت",1,0],["كأنه عاشق قد مد صفحته","يوم الفراق إلى توديع مرتحل",16,"ل",1,1],["كأنه عاشق مَشُوقٌ","يشكو هواه الى الهواء",17,"ا",2,0],["كأنه عارض طارت عقائقه","مسحنفر الوقع واهي الذيل والردن",18,"ن",1,0],["كَأَنَّهُ عاشق قَد مَدَّ بسطته","يَوم الفُراق إِلى تَوديع مُرتَحل",19,"ل",1,0],["كَأَنَّهُ عِدَّةً وَلَوناً","أَكُفُّ حُورٍ بِلا سَواعِد",20,"د",1,0],["كأنه عند تحريك النسيم له","فرنذ سيف صقلتهُ كفّ جلاء",21,"ا",2,0],["كانه عزة شهباء لائحة","في وجه دهماء مافي جلدها بلق",22,"ق",1,0],["كأنه عسل قد شابَهُ سَكَرٌ","أو أنه برَد جادت به السحب",23,"ب",1,0],["كأنه عن نداء الله في صمم","حتى اشتكى الصم شعبان إلى رجب",24,"ب",1,0]]}