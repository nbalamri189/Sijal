عاً فقولي","https://www.poetsgate.com/ViewPoem.aspx?id=126439",""],[5281,"مُلهمتي","https://www.poetsgate.com/ViewPoem.aspx?id=199304",""],[5299,"مكابرةُ امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=210536",""],[5351,"خسرتم","https://www.poetsgate.com/ViewPoem.aspx?id=202633",""],[5431,"مزامير العبق....","https://www.poetsgate.com/ViewPoem.aspx?id=202601",""],[5550,"الأعمى","https://www.poetsgate.com/ViewPoem.aspx?id=211617",""],[5587,"في حب الله","https://www.poetsgate.com/ViewPoem.aspx?id=196988",""],[5628,"الى قريتي الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=178470",""],[5804,"لا خيرَ في الخير","https://www.poetsgate.com/ViewPoem.aspx?id=186971",""],[5943,"كَشَفَتْ غطاها","https://www.poetsgate.com/ViewPoem.aspx?id=34277",""],[5956,"ثورة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=182081",""],[5956,"حال البنت قبل الحب وبعده","https://www.poetsgate.com/ViewPoem.aspx?id=197942",""],[5970,"بني مصر هبوا وأجهدوا ما استطعتمو","https://www.poetsgate.com/ViewPoem.aspx?id=130665",""],[6070,"حياةُ المرءِ تحكمُها الثواني","https://www.poetsgate.com/ViewPoem.aspx?id=188425",""],[6102,"قولي: ( ظلمته )","https://www.poetsgate.com/ViewPoem.aspx?id=182747",""],[6152,"خضعت لكم حبا","https://www.poetsgate.com/ViewPoem.aspx?id=205061",""],[6152,"لا تنكأ الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=213175",""],[5724,"رسول العلى والفضل والخير والهدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55159&r=&rc=26",""],[463,"أمنْ أسماءَ والمسرى بعيدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60031&r=&rc=87",""],[6260,"يا لائمي في الحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68357&r=&rc=49",""],[6260,"لقد تهت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68337&r=&rc=29",""],[6300,"الحرف وإمبراطورية العزف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81630&r=&rc=7",""],[6327,"حكاية الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86568&r=&rc=3",""],[572,"وا حرباً مِنْكَ وَمِنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9227&r=&rc=84",""],[5064,"نرجِسَةُ المعَانِي الزُّجاجِيَّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87539&r=&rc=34",""]],"verses":[["تُريدُ اللَيالي أَن تَخِفَّ بِمِقوَدي","وَأَيُّ جَوادٍ لَو أَصابَ مَجالا",0,"ل",2,0],["تُريدُ أَن أَلقى الخَنا لِقاءَها","وَأَن أُنيخَ لِلأَذى جَعجاعَها",1,"ع",3,0],["تُريدونَ أَن نوطي وَأَنتُم أَعِزَّةٌ","بِأَيِّ كِتابٍ أَم بِأَيَّةِ سُنَّةِ",2,"ه",1,0],["تُريدانِ مِنّي أَنْ أُزيرَ مَدائِحي","هَجيناً فَما قَوْمِي إِذاً بِهِجانِ",3,"ن",1,0],["تُريدينَ إِلّا مُشفِقاً ذا نَصيحَةٍ","فَدونَكِ حَبلَ الطائِعِ المُتَطَوِّعِ",4,"ع",1,0],["تريد غلاب جميع الملاح","وتبغي عذاب جميع القلوب",5,"ب",1,0],["تُريدون للعَليا سبيلاً وهل لكم","إليها وأنتم جاهلون سبيل",6,"ل",1,0],["تُريد ليَ الأيام أن أتقيّد","وأطلُب فيها أن أكون المُجِّددا",7,"د",2,1],["تُريدينَ أَن نَرضى وَأَنتِ بَخيلَةٌ","وَمَن ذا الَّذي يُرضي الأَحِبّاءَ بِالبَخلِ",8,"ل",1,0],["ترى درى الدهر مقدار الذي فقدت","من فيضِ أدمعه أحوال أهليه",9,"ي",2,0],["ترى درى الدهر ما معزى سماحته","فجاءَ مهجته في زيِّ عافيه",9,"ي",2,0],["ترى دعاويَ قومٍ فوق حاصلِهِم","وما دعاويه إلا دونَ حاصلِهِ",10,"ل",2,0],["تُريدينَ كَيما تَجمَعيني وَخالِداً","وَهَل يُجمَعُ السَيفانُ وَيحَكِ في غِمدِ",11,"د",1,0],["تريد مصر بما تبدى حوادثها","ليعرف الناس حلمي هل له ثاني",12,"ن",2,0],["تُريدينَ لُقيانَ المَعالي رَخيصَةً","وَلا بُدَّ دونَ الشَهدِ مِن إِبَرِ النَحلِ",13,"ل",1,0],["تُريدون إِخفاءَ الغَرامِ بجَهدكم","وهل يكتُمُ الإنسانُ ما ليس خافيا",14,"ي",2,0],["تُريدينَ مرعى الريفِ والبدوَ أبتغي","وما يستوي الريفُ العراقيُّ والبدوُ",15,"و",1,0],["تُريدُ مهذَّباً لا عَيْبَ فيهِ","وهل عُودٌ يفوحُ بلا دُخَانِ",16,"ن",1,0],["تُريدُ اِبنَ عَبدِ اللَهِ إِيّاهُ يَمَّمَت","يَقولُ إِذا قالَ الصَوابَ وَيَفعَلُ",17,"ل",1,0],["تُريدُ مَعَ الحَجِّ وَاِبنِ لَيلى كِلاهُما","لِصاحِبِهِ خَيرٌ تُرَجّى فَواضِلُه",18,"ل",2,0],["تُريدُ أَميرَ المُؤمِنينَ وَلَيتَها","أَتَتكَ بِأَهلي إِذ تُنادي وَمالِيا",19,"ي",2,0],["تُريدُ مِنَ اللَهِ إِحسانَهُ","فَيُعطيكَ أَكثَرَ مِمّا تُريدُ",20,"د",1,0],["تُريدُ الأَمنَ في دارِ البَلايا","وَما تَنفَكُّ مِن حَدَثٍ يَروعُ",21,"ع",1,0],["تريد الحياةُ لقاءَ المماتِ","ولا يأذن اللهُ بالملتقَى",22,"ق",2,0],["تُريد سرّي إن سرِّي هنا","في مُغلَقٍ أسرارهُ لا تنال",23,"ل",1,0],["تُريدينَ مِنِّي جمع مالي وَمَنْعَهُ","وهل ليَ بعدَ الموتِ ما أنا مالِكُه",24,"ك",2,0],["تُريدُ منَ الأَيّام كَفَّ صُروفِها","أَمُنتَقِلٌ طَبْعُ الأفاعي عنِ اللّسبِ",25,"ب",1,0],["تُريدُ رِضاكَ إِذا ما خَلَونَ","طِلابُ هَواكَ وَعِصيانِكا",26,"ك",2,0],["تُريدُ فتخلقُ الأصباغَ شتَّى","وتَبتدعُ الطرائقَ والفنونا",27,"ن",2,0],["تُريد حِمَى النُّسورِ فتتَّقِيها","وتطلبُ في السَّحابِ لها وكُونا",28,"ن",2,0],["تُريدونها في آلِ عُثمانَ خُطّةً","هيَ الخَسْفُ إلا ما تَزَحْزَحَ كانعُ",29,"ع",1,0],["تُريدينَهُ حُسناً عَلَيكِ وَبَهجَةً","تُغيرُ الغَواني وَالخَمائِلَ وَالزَهرا",30,"ر",2,0],["تُريدُ طَعامَها وَالبَيتُ مُقوٍ","فَتوشِكُ أَن تَميلَ عَلى بَنيها",31,"ي",3,0],["تُريد مُحمداً واللّهُ واقٍ","فَترجعُ وَهْيَ مُحنقةٌ غِضاب",32,"ب",1,0],["تُريدُ مِنَ الدُنيا خِلافاً لِما مَضى","وَأَعياكَ تَدبيرٌ بِهِ سَبَقَ الرَسمُ",33,"م",1,0],["تُريدُ مَقاماً دائِماً وَمَسَرَّةٌ","بِدارِ هُمومٍ لَم تَكُن دارَ قُطّانِ",34,"ن",1,0],["تُريدُ مُحَمّداً وَبَنِي أبيهِ","أُولِي النَّجَدَاتِ والهِمَمِ العَلِيَّهْ",35,"ي",2,0],["تريد بحبو في السباق إلى العلى","لحوقاً بمن يطوي المسافة بالوثب",36,"ب",1,0],["تريد بعزم أن تفارق جسمه","وتلك عليه شقة لا يريدها",37,"د",3,0],["تريد مَع التقليد في الشعر جدة","وما زند أصحاب التقاليد بالواري",38,"ر",2,0],["تريد بظفر منك تمزيق جلده","فهل لك عند الشعر ويحك من ثار",38,"ر",1,0],["تريدين مني الشعر يا ابنة يعرب","وإنك أنت الشعر أو قبلة الشعر",39,"ر",1,0],["تريد بالغصب من حق الضعيف غنىً","وَبالصَلاة إلى الديان قربانا",40,"ن",2,0],["تريد جاهاً وَمالاً","دثراً وَعَيشاً رضيا",41,"ي",2,0],["تريدينه صورةً أم فتىً","تهلّلَ فيه الحِجى وابتسمْ",42,"م",1,0],["تريد حربا ويريد سلما","تزيد جهلا فيزيد حلما",43,"م",2,0],["تُرِيدُ اللَّيَالِي مِنْكَ مَا لاَ تُرِيدُهُ","لَكَ الْحَقُّ وَالآمَالُ وَالْهِمَمُ الْغُرُّ",44,"ر",1,0],["تُرِيدُ مِنَ الأَحْدَاثِ مَا لاَ يُرِدْنَهُ","فَتَنْحَتُ