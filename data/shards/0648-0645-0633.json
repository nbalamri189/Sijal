t/poem21784.html","الطويل"],[8,"أيا دار سلمى بالحرورية اسلمي","https://www.aldiwan.net/poem21840.html","الطويل"],[8,"","https://poetry.dctabudhabi.ae/diwan/poem/17310","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39571","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202638",""],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30458","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42730","الطويل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12962","البسيط"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12696","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43773","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[85,"الله أكبر كم بالفتح من عجب","https://www.poetsgate.com/ViewPoem.aspx?id=485",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"الشباب المر","https://www.poetsgate.com/ViewPoem.aspx?id=178970",""],[90,"وفى الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179021",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[90,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[45,"عَهْدِي بِرَبْعِكَ مُثَّلاً آرَامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32042",""],[45,"ومستضحك من عبراتي وبكائي","https://www.poetsgate.com/ViewPoem.aspx?id=32826",""],[45,"دَنَا السّرْبُ، إلاّ أنّ هَجراً يُباعِدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32954",""],[51,"ومُستقر على كرسيِّه تَعِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=27164",""],[24,"أَبَتْ ذِكْرة ٌ من حُبِّ لَيْلَى تَعُودُنِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10865&r=&rc=6",""],[0,"خليلّي مرّ بي على أم جندب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14326&r=&rc=2",""],[14,"أقِلِّي عَلَيَّ اللِّوْمَ يا ابْنَة َ مُنْذِرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17403&r=&rc=14",""]],"verses":[["وَمُستَهِلّاتٍ كَصَوبِ الحَيا","تَبقى وَأَقوالُ الفَتى تَفنى",0,"ن",2,1],["وَمُستَوصِياتِ بِالذَميلِ كَأَنَّما","يُدارِسُ إِدآبَ الجَديلِ وَشَدقَمِ",1,"م",1,0],["وَمُسَوَّمِ الراياتِ يَخ","فِقُ في الجَماهيرِ العِظامِ",2,"م",1,0],["وَمُستَوقَداتٍ مِن لَظى العارِ أَجَّجَت","لَها حَطَباً لا يَنقَضي الدَهرُ جَزلُهُ",3,"ل",2,0],["وَمُستَغَرّينَ ما زالَت قُلوبُهُمُ","تُبَدَّدُ الرَأيَ بَينَ الرَيثِ وَالعَجَلِ",4,"ل",1,0],["وَمُستَنبِتٍ رَوضاً عَلَيكَ مُنَوَّراً","عَلى صابِحٍ مِن ماءِ مُزنٍ وَغابِقِ",5,"ق",1,0],["وَمُستَعبِرٍ قَد أَتبَعَ الدَمعَ زَفرَةً","تَكادُ لَها عوجُ الضُلوعِ تَثَقَّفُ",6,"ف",1,0],["وَمُسَدِّدونَ أَسِنَّةً يَزَنيَّةً","فَتَلوا بِأَكعُبِها حِبالَ الأَذرُعِ",7,"ع",1,0],["وَمُسرِعٍ أَقلَعَ مِن عَثرَةٍ","رَوعاءَ وَالعَثرَةُ لِلمُسرِعِ",8,"ع",1,0],["وَمُسَقّىً عَلى القَذى يَرِدُ الوِر","دَ جُماماً فَيَشرَبُ الماءَ بَرضا",9,"ض",2,0],["وَمُستَطيلٌ عَلى الأَزمانِ يَقدِرُها","جَنى الزَمانُ عَليها بِالمَقاديرِ",10,"ر",1,0],["وَمُسَوِّدٍ بِالغَدرِ وَجهَ وَفائِهِ","عَصفَرتُهُ بِشَبا الوَشيجِ الأَسمَرِ",11,"ر",1,0],["وَمَسجورٍ عَلى جَدَدٍ","تَمَطّى بي هَواجِرُه",12,"ر",2,0],["وَمَسوقٍ عاثِرٍ يُسعى بِهِ","خَلفَ مَحمولٍ عَلى غَيرِ وَطا",13,"ا",1,0],["وَمُسَنَّدينَ عَلى الجُنوبِ كَأَنَّهُم","شَربٌ تَخاذَلَ بِالطِلا أَعضاؤُهُ",14,"ا",3,0],["ومُسْتَقِلٌّ به دونَ الأنامِ فتًى","تَضْفو على نَغَمِ الرّاوي بدائِعُهُ",15,"ع",2,0],["ومُستَبِدٍّ برأيٍ لا يُتَعْتِعُهُ","خَطْبٌ يُشيرُ على الآراءِ بالزَّلَلِ",16,"ل",1,0],["ومَسْرَحُ المُهْرَةِ الدّهْماءِ مُكْتَهِلٌ","لو كانَ بالرّوضَةِ الغنّاءِ راعيها",17,"ي",3,0],["وَمَسكِنُ أَهلَها مِن بَطنِ جَزعٍ","تَبيضُ بِهِ مَصايِيفُ الحَمامِ",18,"م",1,0],["وَمُسَربَلٍ حَلَقَ الحَديدِ مُدَجَّجٍ","كَاللَيثِ بَينَ عَرينَةِ الأَشبالِ",19,"ل",1,0],["وَمُستَكرِهٍ لِلحُبِّ في لُجَجِ الهَوى","يَموتُ وَيحيا عِندَ كُلِّ أَوانِ",20,"ن",1,1],["وَمُستَوجِبٍ لِلحُبِّ شَتّى غَرائِبُهُ","يُدِلُّ بِحُسنٍ ما تَقَضّى عَجائِبُه",21,"ب",2,1],["ومُسْتَنْجِزٌ فِينا منَ اللهِ وعْدَهُ","فلا نكْثَ في وعْدِ الإلاهِ ولا خُلْفا",22,"ف",2,0],["ومُسْتَنْصَرٍ منْ دَمْعِهِ غيْرُ ناصِرِ","ومُسْتَنْجَدٍ منْ ضُرِّه غيْرُ مُنْجِدِ",23,"د",1,0],["وَمُستَدبِرٍ بِالَّذي عِندَهُ","عَلى العاذِلاتِ وَإِرشادِها",24,"د",3,0],["وَمُسمِعَتانِ وَصَنّاجَةٌ","تُقَلِّبُ بِالكَفِّ أَوتارَها",25,"ر",3,0],["وَمُستَجيبٍ تَخالُ الصَنجَ يَسمَعُهُ","إِذا تُرَجِّعُ فيهِ القَينَةُ الفُضُلُ",26,"ل",1,0],["وَمُستُقُ سينينٍ وَوَنٌّ وَبَربَطٌ","يُجاوِبُهُ صَنجٌ إِذا ما تَرَنَّما",27,"م",2,0],["وَمُستأَسِدٍ يَندى كَأَنَّ ذُبابَهُ","أَخو الجَمرِ هاجَت شَوقَهُ فَتَذَكَّرا",28,"ر",2,0],["وَمُستَهلِكٍ يَهدي الضَلولَ كَأَنَّهُ","حَصيرُ صَناعٍ بَينَ أَيدي الرَوامِلِ",29,"ل",1,0],["وَمُستَعجِمِ الأَلفاظِ يُفصِحُ تارَةً","وَيُرتَجُ عَنهُ تارَةً فَيُجَمجمُ",30,"م",1,0],["وَمُسامِحٌ حُلوُ الحَديثِ مُحَبَّبٌ","فَضحَ الصَباحَ بِحُسنِهِ الوَضّاحِ",31,"ح",1,0],["وَمَسَرّاتُنا طِوالٌ عِراضٌ","وَاللَيالي قَصيرَةُ الأَعمارِ",32,"ر",1,0],["وَمُستَخبِرٍ عَنّا وَما مِن جَهالَةٍ","كَشَفتُ الغِطا عَنهُ فَزالَ اِرتِيابُهُ",33,"ب",2,0],["وَمُستَبطَإِ العُتبى إِذا قُلتُ أَنّى","رِضاهُ تَمادى العَتبُ وَاِتَّصَلَ السَخطُ",34,"ط",1,0],["وَمُسعِفَةٍ بِالوَصلِ إِذ مَربَعُ الحِمى","لَها كُلَّما قِظنا الجَنابَ جَنابُ",35,"ب",1,0],["وَمَسَرَّةٍ يُفضي بِها","زَمَنٌ كَحاشِيَةِ الرِداءِ",36,"ا",2,0],["وَمُستَحمَدٍ بِكَريمِ الفِعا","لِ عَفُوّاً إِذا ما اللَئيمُ اِستَذَم",37,"م",1,0],["وَمُستَشفِعٍ بِيَ بَشَّرتَهُ","عَلى ثِقَةٍ بِالنَجاحِ الأَتَمّ",37,"م",1,0],["وَمُستَفلِكُ الذِفرى كَأَنَّ عِنانَهُ","وَمِثناتَهُ في رَأسِ جِذعٍ مُشَذَّبِ",38,"ب",1,0],["ومسحنا الكرى إلى غانيات","غانيات بكل سحر حلال",39,"ل",1,0],["وَمُسنِفَةٌ فَضلَ الزِمامِ إِذا اِنتَحى","بِهِزَّةِ هاديها عَلى السَومِ بازِلُ",40,"ل",1,0],["وَمُسّا تُرابًا كَانَ قَد مَسَّ جِلدَها","وَبيتا وَظِلاَ حَيثُ باتَت وَظَلَّتِ",41,"ت",1,0],["وَمُستَنَّةٍ كَاِستِنانِ الخَليجِ","فَوّارَةِ الغَمرِ كَالمِرجَلِ",42,"ل",1,0],["وَمُسَلَّحٍ بِالرَّأْيِ لَيْسَ يَفُوتُهُ","فِي كُلِّ مُعْضِلَةٍ جَوابُ سُؤَالِهَا",43,"ل",3,0],["وَمُسْعِفُونَ لَهُمْ فِي كُلِّ مَحْمَدَةٍ","أَنْدَى الأَيَادِي وَأَصْفَاهُنَّ مِنَ المِنَنِ",44,"ن",1,0],["وَمَسَرَّةً بِأَشَقِّ مَا","يُرْضِي الْبِلاَدَ وَإنْ شَجَانِي",45,"ي",1,0],["وَمُسَاهِمٍ فِي الْبِرِّ مُوفٍ قِسْطَهُ","يَرْمِي مَعَاذِيرَ الشَّقَاءِ بِأَسْهُمِ",46,"م",1,0],["وَمُستامَةٍ تَستامُ وَهيَ رَخيصَةٌ","تُباعُ بِساحاتِ الأَيادي وَتَمسَحُ",47,"ح",1,1],["وَمُستَقوِسٍ قَد ثَلَّمَ السَيلُ جُدرَهُ","شَبيهٍ بِأَعضادِ الخَبيطِ المُهَدَّمِ",48,"م",1,0],["وَمُستَخلِفاتٍ مِن بِلادِ تَنوفَةٍ","لِمُصفَرَّةِ الأَشداقِ حُمرِ الحَواصِلِ",49,"ل",1,0],["وَمُستَبشِرٌ تَبدو بَشاشَةُ وَجهِهِ","إِلَينا وَمَعروفُ الكَآبَةِ عابِسُ",50,"س",1,0],["وَمُستَشحِجاتٍ بِالفِراقِ كَأَنَّها","مَثاكيلُ مِن صُيّابَةِ النُوبِ نُوَّحُ",51,"ح",1,0],["وَمُستَنجِدٍ فَرَّجتُ مِن حَيثُ تَلتَقي","تَراقيهِ إِحدى المُفظِعاتِ الكَوارِبِ",52,"ب",1,0],["ومسافرٍ في الجو تحسبُ أنه","يرقى إلى أوج السماء بسلَّمِ",53,"م",1,0],["ومسرى ركاب للصَّبا قد ونَتْ به","نجائب سحب للتراب نزوعُها",54,"ع",3,1],["ومسافرٍ في البحر مِلْء عنانه","وافى مع الفتح المبين على قَدَرْ",55,"ر",1,0],["ومسارح التمثيل أصغر فضلها","جَعْل الكليل من الشعور ذليقا",56,"ق",2,0],["ومسرع يسبقه مبطىءٌ","ومبطىء يسبقه مسرع",57,"ع",1,0],["وَمَسرورٍ بِأَوبَتِنا إِلَيهِ","وَآزِرَ لا يُحِبُّ لَنا إِيابا",58,"ب",2,0],["وَمَسارِبٍ كَالزَوجِ رَشَّحَ بَقلَها","صُهبٌ دَواجِنُ صَوبُهُنَّ مُديمُ",59,"م",1,0],["وَمُستَخبِرٍ عَنّي يَوَدُّ لَوَ أَنَّني","شَرِبتُ بِسَمٍّ ريقَتي فَقَضاني",60,"ي",1,0],["ومستلئمات دارعات تشبهت","بفرسانها في الحرب ليس لها ذُعْرُ",61,"ر",1,1],["ومستطعم يُكنى بغير بناته","جعلت له حظاً من الزاد أوفرا",62,"ر",2,1],["وَمُستَردَفاتٍ مِن نِساءٍ وَصِبيَةٍ","تَثَنّى عَلى أَكتافِهِنَّ الضَفائِرُ",63,"ر",1,0],["وَمُستَرشِداً في الحُكمِ لا مُتَوَجِّهاً","وَلا قابِلاً عِندَ الخُصومَةِ أَخطَلا",64,"ل",2,0],["وَمُستَمطِراً في الأَزلِ أَصبَحَ سَيبُهُ","عَلى مُعتَفيهِ دائِمَ الوَدقِ مُسبِلا",64,"ل",2,0],["وَمُستَرِقِ النُخامَةِ مُستَكينٍ","لِوَقعِ الكَأسِ مُختَلِسِ البَيانِ",65,"ن",1,1],["وَمُسَوَّدٍ يُعطي الجَزيلَ بِكَفِّهِ","حَمّالِ أَثقالِ الدِياتِ مُتَوَّجِ",66,"ج",1,0],["وَمَسجِدُهُ فَالموحِشاتُ لِفَقدِهِ","خَلاءٌ لَهُ فيهِ مَقامٌ وَمَقعَدُ",67,"د",1,0],["ومسهدٍ يشكو القتار دموعه","مما سلكْنَ على هواك محاجرا",68,"ر",2,0],["ومسّ عيونَ من فارقت شرٌّ","فأصبح كلّ إنسانٍ جزوعا",69,"ع",2,0],["ومسائلٌ في العلم أشكل أمرها","حلاًّ وحلَّ لطالبٍ أشكالها",70,"ل",3,0],["ومسدَّد الحركات ينهلّ الندى","وتخيِّم العلياء حيث يخيّم",71,"م",1,0],["ومستجيرٍ أتاه مُضطهَداً","قد أوطأ الناسَ خدَّه تَرَبُهْ",72,"ب",2,0],["ومُستقرٍّ على كرسيِّه تَعِبِ","روحي الفداءُ له من مُنْصَبٍ نَصِبِ",73,"ب",1,1],["ومِسْنَ وكثبانُ المآزر رُجَّحٌ","وقضبانُ ما وُشِّحن مُضْطمِراتُ",74,"ت",1,0],["ومُسَائِلٍ لي عنه قلت فداؤه","في عصرِنا سُمحاؤه وشِحاحُهُ",75,"ح",2,0],["ومُسْتَمْنِحِي مدحاً كمدحيه بعدما","تمكَّن إخلاصي له فَتَمَخَّخَا",76,"خ",2,0],["ومُستصرخي بعد الخليفة صِنْوه","أبو أحمد المحمودُ في البدو والحضرِ",77,"ر",1,1],["ومستخبرٍ بالغيب عنك أجبتهُ","وما منطقٌ زكّاه معناك بالنزرِ",78,"ر",1,0],["ومستخفٍّ بقدر الشعر قلت له","لن ينفُق العطر إلا عند معطار",79,"ر",1,0],["ومستيقن أني لديك بربوة","لها شرف مما تُجِنُّ الأضالع",80,"ع",1,0],["ومسبعة الدهر مشحونة","ومن حل بين سباع سُبِع",81,"ع",1,0],["ومِسنَ في حُللٍ الأفواف عاطرة","فخلتهن لبسن الروض أفوافا",82,"ف",2,0],["ومُسمعٍ لا عدمْتُ فُرقَتَهُ","فإنها نعمةٌ من النعمِ",83,"م",1,1],["ومسوءٌ بدنُوِّي منكُمُ","ألزمَ اللَّه يديه ذَقنَه",84,"ن",2,0],["ومُسائل لي عنك قلتُ نفوسُنا","تَفدي الجميلَ ظهائراً وبطائِنا",85,"ن",2,0],["وَمُسَوِّمٍ خِرَقُ الحُتوفِ تَقودُهُ","لِلطَعنِ يَومَ كَريهَةٍ وَقِتالِ",86,"ل",1,0],["وَمُستَرَقِ النُخامَةِ مُستَكينٍ","لِوَقعِ الكَأسِ يومِئُ بِالبَنانِ",87,"ن",1,1],["وَمُستَقبِلٍ لَفحَ الحَرورِ لِحاجَةٍ","إِلَيكُم أَبا مَروانَ شُدَّت رَواحِلُه",88,"ل",2,0],["وَمُستَنبِحٍ بَعدَ الهُدوءِ دَعَوتَهُ","بِصَوتِيَ فَاِستَعشى بِنِضوٍ تَزَغَّما",89,"م",2,0],["وَمُسَوَّمٍ عَقَدَ الهُمامُ بِرَأسِهِ","تاجَ المُلوكِ رَدَدنَ في الأَغلالِ",90,"ل",1,0],["وَمَسَّ روحي وَاِستَلَّ مِنها","شَوقي إِلى الخَمرِ وَالنِساء",91,"ا",2,0],["وَمَسَّ الضُحى فَاِرفَضَّ تِبراً عَلى الرُبى","وَسالَ عَقيقاً في حَواشي السَباسِبِ",92,"ب",1,0],["وَمَسَّتهُ أَيدي الأَدنِياءِ فَما شَكا","وَمَصَّتهُ أَفواهُ الطَغامِ فَما وَجَف",93,"ف",1,0],["وَمَسارِحٍ فَتَنَ النَسيمُ جَمالُها","فَسَرى يُدَندِنُ تارَةً وَيُهَمهِمُ",94,"م",1,0],["وَمُستَثبِتٌ في مالِكَ العامَ أَنَّني","أَراكَ عَلى أَقتادِ صَرماءَ مُذكِرِ",95,"ر",1,0],["وَمُستَهنِئٍ زَيدٌ أَبوهُ فَلا أَرى","لَهُ مَدفَعاً فَاِقنَي حَياءَكِ وَاِصبِري",95,"ر",2,0],["وَمُسيءٍ كَأَنَّهُ","أَبَداً مُحسِنٌ إِلَيَّ",96,"ي",1,0],["وَمَسَرّاتٌ تَموجُ ال","أَرضُ مِنها وَتَمورُ",97,"ر",1,0],["وَمُستَبسِلٍ ضافي القَميصِ ضَمَمتُهُ","بِأَزرَقَ لا نِكسٍ وَلا مُتَعَوَجِ",98,"ج",1,1],["ومسالكُ الجبلِ الصَّغير","بعُشْبِها وزُهورها",99,"ه",2,0],["وَمُسَربَلاً حُلَلَ الوِزا","رَةِ باتَ غَيرَ مُسَربَلِ",100,"ل",1,0],["وَمُستَقبَلٍ مِن قُيودِ الحَيا","ةِ شَديدٍ عَلى النَفسِ مُستَصعَبِ",101,"ب",1,0],["وَمُسَيطِرونَ عَلى المَمالِكِ سُخِّرَت","لَهُمُ الشُعوبُ كَأَنَّها أَنعامُ",102,"م",1,0],["وَمَسَّحَت بِالمُصَلّى فَاِكتَسَت شَرَفاً","وَبِالمَغارِ المُعَلّى فَاِكتَسَت عِظَما",103,"م",2,0],["وَمَسَّتِ الدارُ أَزكى طيبِها وَأَتَت","بابَ الرَسولِ فَمَسَّت أَشرَفَ العُتُبِ",104,"ب",1,0],["وَمُسلِمو الهِندِ وَالهِندوسُ في جَذَلٍ","وَمُسلِموا مِصرَ وَالأَقباطُ في طَرَبِ",104,"ب",1,0],["وَمَسّى الجُمَيعِيَّ دِئداؤُها","وَغادى الأَضارِعَ ثُمَّ الدَنا",105,"ا",1,0],["وَمُستَكبِرٍ لَم يَعرِفِ اللَهَ ساعَةً","رَأى سَيفَهُ في كَفِّهِ فَتَشَهَّدا",106,"د",2,0],["ومسكن التنين في جوفه","جزيرة في جُرفٍ هارِ",107,"ر",1,0],["ومساحبُ الزقِّ اللجوجِ على الثَّرى","أحرى بنا من مسحبِ الفتيانِ",108,"ن",1,0],["ومستطعمٍ فضلَ العِنَانِ كأنما","يلاعبُ عِطْفيه سَحوقٌ من النخلِ",109,"ل",1,0],["ومُسَدِّدٍ من قوسِ حاجبهِ","نحوَ المَقاتِلِ سهمَ مقلَتِهِ",110,"ت",2,1],["ومسَّنِي من أذاهَا","ما لم يكنْ في حسِابي",111,"ي",1,0],["ومساعدٍ لي في البكاء مُساهرٍ","بالليل يؤنِسُني بطيبِ لقائِهِ",112,"ا",3,1],["وَمُستَضحِكٍ مِن عَبرَتي وَبُكائي","بِكَفَّيهِ دائي في الهَوى وَدَوائي",113,"ا",3,1],["وَمُستَشرِفٌ بَينَ السِماطَينِ مُشرِفٌ","عَلى أَعيُنِ الرائينَ يَعلو فَيَرتَبي",114,"ب",2,0],["وَمُستَسِرّينَ في الخُمولِ بَلَو","ناهُم فَذَمَّ الحَرامَ مُكتَسِبُه",115,"ب",2,0],["وَمَسبَعَةٌ مِن دونِ ذاكَ أُسودُهُ","حَصاها وَمَحواةٌ نَقاها أَساوِدُه",116,"د",2,0],["وَمُستَظهِراً بِالعَفوِ مِن قَبلِ أَن تُرى","لَهُ سَطَواتٌ ما يُنادي وَليدُها",117,"د",3,0],["وَمُستَحصِدِ التَدبيرِ لِلفَيءِ جامِعٍ","وَلِلدّينِ مُحتاطٍ وَلِلمُلكِ حارِسِ",118,"س",1,0],["وَمَساعٍ لَولا المُحاباةُ مِنّي","لَم تُطِقها مَسعاةُ عَنسٍ وَعَبسِ",119,"س",1,0],["وَمَسَّحَت خَدَّها مِن قُبلَتي وَمَشَت","كَأَنَّها ثَمِلٌ أَو مَسَّها خَبَلُ",120,"ل",1,0],["وَمَسراهُ في بَطنِ قَوصَرَّةٍ","مُخَرَّقَةِ الخوصِ مُستَعمَلَه",121,"ل",2,0],["وَمُسَلِّمٍ يَومَ الوَضاعِ شِفاؤُهُ","مِمّا يُعاني أَن يُرَدَّ سَلامُهُ",122,"م",2,0],["وَمُسَهَّدٍ لَو عادَ أَهلُ كَرىً إِلى","مُحتَلِّهِم مِنهُ لَعادَ كَراهُ",123,"ا",2,0],["وَمُستَنبِحٍ أَوقَدتُ ناري لِصَوتِهِ","بِلا قَمَرٍ يَسري وَلا ضَوءِ فَرقَدِ",124,"د",1,0],["وَمُستَلحِمٍ يَدعو كَرَرتَ وَراءَهُ","كَتَكرارِ لَيثِ الغابَتَينِ المُهاصِرِ",125,"ر",1,0],["وَمَسجونَةٍ قالَت وَقَد سَدَّ زَوجُها","عَلَيها خَصاصَ البَيتِ مِن كُلِّ مَنظَرِ",126,"ر",1,1],["وَمُستَنفِزاتٍ لِلقُلوبَ كَأَنَّها","مَهاً حَولَ مَنتوجاتِهِ يَتَصَرَّفُ",127,"ف",1,0],["وَمَسروحَةً مِثلَ الجَرادِ يَسوقُها","مُمَرٌّ قُواهُ وَالسَراءُ المُعَطَّفُ",128,"ف",1,0],["وَمُستَنبِحٍ وَاللَيلُ بَيني وَبَينَهُ","يُراعي بِعَينَيهِ النُجومَ التَوالِيا",129,"ي",2,0],["ومسرَّةٌ قُرِنت بشملٍ جامعٍ","فَسَمَت جَنوبُ رياحِه والشَّمأَلُ",130,"ل",1,0],["ومُستَدير بلا قُطْبٍ يَدورُ بهِ","ولا له وَتَدٌ في الأرضِ مَركوزُ",131,"ز",1,1],["ومستعيرِ النُّضارِ من رَشإِ","لم يُخْطِهِ لحظُه ولا جَيَدُه",132,"د",2,0],["ومُسرِفُ الجُودِ حينَ يَقتَصِدُ ال","غَيْثُ رَفيقُ الفَعالِ مُقتَصِدُه",132,"د",2,0],["ومسترفِدٌ تيَّارَ دِجلةَ رافداً","سواحلَها من نازحٍ ومُقاربِ",133,"ب",1,0],["ومسرعٍ وهو ثاوٍ في مكارمِه","كأنَّ إصعادَه من سُرعةٍ صَبَبُ",134,"ب",1,0],["ومستسلماتٍ هززْنا لها","مَداري القِيانِ لسَفْكِ الدِّماءِ",135,"ا",2,0],["وَمُستَأسِدٍ يَندى كَأَنَّ ذُبابَهُ","أَخو الخَمرِ هاجَت حُزنَهُ فَتَذَكَّرا",136,"ر",2,0],["وَمُستَنبِهٍ مِن نَومِهِ قَد أَجابَني","بِرَجعَينِ مِن ثِنيَي لِسانٍ مُلَجلِجِ",137,"ج",1,0],["وَمُسَوَّدٍ رَحبِ الفِنا","ءِ أَغَرَّ كَالقَمَرِ المُنيرِ",138,"ر",1,0],["وَمَسؤولَةٌ يا نَفسُ أَنتِ فَيَسِّري","جَواباً لِيَومِ الحَشرِ قَبلَ سُؤالِكِ",139,"ك",1,0],["وَمِسكينَةٌ يا نَفسُ أَنتِ فَقيرَةٌ","إِلى خَيرِ ما قَدَّمتِهِ مِن فِعالِكِ",139,"ك",1,0],["وَمَسَرّاتُنا تَمامٌ فَما أَع","وَزَ بَينَ الرِفاقِ إِلّا النَبيذُ",140,"ذ",1,0],["وَمُستَحلى المَراشِفِ سُكَّرِيَّ","أَتى بِغَرائِبِ الحُسنِ الظَريفِ",141,"ف",1,1],["وَمُسافِراً وَلّى فَطَوَّلَ نَأيَهُ","وَنَرى المُسافِرَ فَرضُهُ التَقصيرُ",142,"ر",1,0],["وَمَسَحتُ الجَبينَ مِنكَ بِكَفّي","فَأَعادَ المَسيحُ قَلبي كَليما",143,"م",2,0],["وَمُستَشفِعٍ بي عِندَهُ قُلتُ إِنَّهُ","كَريمٌ نَداهُ عِندَهُ خَيرُ شافِعِ",144,"ع",1,0],["وَمَساعٍ قَد أُشرِكَ المَلِكُ الصا","لِحُ في باقَياتِها الصالِحاتِ",145,"ت",1,0],["وَمُستَقبَحٍ حَتّى خَبَرتُ خِلالَهُ","فَأَيقَنَ قَلبي أَنَّهُ يوسُفُ الحُسنِ",146,"ن",1,0],["وَمَسرودَةٍ مِن نَسجِ داوُدَ نَثرَةٍ","كَلَمعِ غَديرٍ ماؤُهُ غَيرُ ذائِبِ",147,"ب",1,0],["ومسير الرحمة الكب","رى كما في النسمات",148,"ت",1,0],["ومُسافرٌ ماضٍ إلى الخلد","سَبَقَتهُ آلاءٌ بلا عَدِّ",149,"د",1,0],["ومسحت كفي والجبين بمائه","علّي أهدئ ثورة المحمومِ",150,"م",1,0],["ومُستَحسَنٍ في كلّ حالٍ دلالها","كبيرٌ هواها وهيَ في صِغَرِ السنِّ",151,"ن",1,1],["وَمُسْتَوْطنٍ كُورَ النّجيبِ بعزْمهِ","فَرِحْلَتُهُ في ظهرِهِ بمُقامهِ",152,"م",2,0],["ومُسايراً زَمنَينِ في عُمري","مصباحُ ذا قمرٌ وذا شمْسُ",153,"س",1,0],["ومسبلةٍ دَمعاً يَسوغُ عُذوبةً","على أن دمع المقلَتين أُجاجُ",154,"ج",1,1],["ومستعطفاتٍ بالحداء على السرى","إذا رجّعَ الألحانَ فيه طروبُ",155,"ب",1,0],["وَمُسكِنَتي لَحداً لَدى حُفرَةٍ بِها","يَطولُ إِلى أُخرى اللَيالي ثَوائِيا",156,"ي",2,0],["وَمُسمِعُنا طَفلُ الأَنامِلِ عِندَهُ","لَنا كُلُّ نَوعٍ مِن قِرى العَينِ وَالأُذنِ",157,"ن",1,0],["وَمُستَنبِطٌ في كُلِّ يَومٍ مِنَ الغِنى","قَليباً رِشاآها القَنا وَالسَنابِكُ",158,"ك",1,0],["وَمَسافَةً كَمَسافَةِ الهَجرِ اِرتَقى","في صَدرِ باقي الحُبِّ وَالبُرَحاءِ",159,"ا",2,0],["وَمَسْرَحٍ لِسِوَامِ الْعَيْنِ لَيْسَ لَهُ","فِي عَالَمِ الظَّنِّ تَقْدِيرٌ وَلا شَبَهُ",160,"ه",1,1],["ومُسْتَدقُّ صخورٍ من مآبرها","رؤًى تَظَلُّ على الحالينِ تُشجيني",161,"ن",2,0],["ومُسَهَّدينَ جزاهُمُ عن ليلِهِمْ","اللهُ ، والتعليمُ ، والتدريب",162,"ب",1,0],["وَمَسَحتُ مِنها عَن مَعاطِفِ مُهرَةٍ","شَقراءَ تُذعَرُ مِن شَمالٍ صَرصَرِ",163,"ر",1,0],["وَمَسحَبِ ذَيلٍ لِلسَحابِ بِذي الغَضا","بَرودِ رُضابِ الماءِ أَحوى لِمى المَرعى",164,"ع",2,0],["وَمُستَجهِلي بَعدَ التَحَلُّمِ نِسوَةٌ","أَشارَ بِلَيلى نَحوَهُنَّ مُشيرُ",165,"ر",1,0],["وَمُستَوحِشٍ لَم يُمسِ في دارِ غُربَةٍ","وَلَكِنَّهُ مِمَّن يَوَدُّ غَريبُ",166,"ب",1,1],["وَمَسَّحَ أَجفاني بِطَرفِ بَنانِهِ","فَأَلَّفَ بَينَ المُزنِ وَالسَوسَنِ النَدي",167,"ي",1,0],["وَمُسافِراً سَفَراً بَعيداً","لا يَأوبُ بِهِ المُسافِرُ",168,"ر",1,0],["وَمُستَأنِسٍ بِالقَفرِ راحَ تَلُفُّهُ","طَبائِخُ شَمسٍ وَقعُهُنَّ سَفوعُ",169,"ع",1,0],["وَمُستَودِعٍ قَلبي هَوىً فَوقَ ما بَدا","لَوأَنَّ فُؤادي عَن هَواها يُكَشّضفُ",170,"ف",1,0],["وَمَسالِكٍ يَسَّرتُها فَتَرَكتُها","وَمَواعِظٍ عَلِّمتُها فَنَسيتُ",171,"ت",1,0],["وَمُستَبصِرٍ في الغَدرِ مُستَعجِلِ القِلى","بَعيدٍ مِنَ العُتبى قَريبٍ مِنَ الهَجرِ",172,"ر",1,1],["وَمُستَنصِرٍ يُزهى بِخُضرَةِ شارِبٍ","وَفَترَةِ أَجفانٍ وَخَدٍّ مُوَرَّدِ",173,"د",1,1],["ومسير الصَّبا بنصْرِك شَهْرا","فكأَنَّ الصَّبا لَدَيكَ رُخاءُ",174,"ا",2,0],["وَمَسْحَهُمْ للسَّمواتِ العُلى افْتَعَلُوا","فِيها كما يَفْعَلُ المَسَّاحُ لِلطِّينِ",175,"ن",1,0],["ومسكنُها الآطام وهي مشيدةٌ","وملحفها القومي وهو أنيق",176,"ق",1,0],["ومَسقطُ قِدْح من قِداحي على الثّرَى","ومُنْقَدُّ ذَيْلٍ من ذُيولي على الأكَم",177,"م",1,0],["ومسرودَةٍ مثلِ نِسْجِ السّرابِ","تَرَقْرَقُ فوقَ الكَمِيِّ العَمَم",178,"م",1,0],["ومستكبِرٌ لم يُشْعِرِ الذُلَّ نفسَهُ","أبيٌّ بأبْكارِ المَهَاوِلِ فاتِك",179,"ك",1,0],["وَمُسكِنَ الروحِ ظُلماً","حَبسَ الهَوى مِن لَهاتي",180,"ي",1,0],["وَمُسمِعَةٍ إِذا ما شِئتُ غَنَّت","مَتى كانَ الخِيامُ بِذي طُلوحِ",181,"ح",1,0],["وَمَسمَعَةٍ جاءَت بِأَخرَسَ ناطِقٍ","بِغَيرِ لِسانٍ ظَلَّ يَنطُقُ بِالسِحرِ",182,"ر",1,0],["وَمُستَعبِدٍ إِخوانَهُ بِثَرائِهِ","لَبِستُ لَهُ كِبراً أَبَرَّ عَلى الكِبرِ",183,"ر",1,1],["وَمُسمِعٍ يَتَغَنّى وَالكُؤوسُ لَها","حَثٌّ عَلَينا بِأَخماسٍ وَأَسداسِ",184,"س",1,0],["وَمُستَطيلٍ عَلى الصَهباءِ باكِرَها","بِفِتيَةٍ بِاصطِباحِ الراحِ حُذّاقِ",185,"ق",1,1],["وَمُستَحقِرٍ مُعضِلاتِ الأُمورِ","فَلا يَرجِعُ الطَرفَ عَن هائِلِ",186,"ل",1,0],["وَمَسبَحٌ لِلسَمامِ تَعضُدُهُ","يَهماءُ ما في أَديمِها أَثَرُ",187,"ر",1,1],["وَمُستَوقَعٌ عِندَ البَرِيَّةِ أَنَّكُم","مُدَعّونَ في الهَيجا إِلى مَن تَوَرَّدا",188,"د",2,0],["وَمُسَهِّرٍ في العَينِ تَحسَبُهُ","يُبدي نَصيحَتَهُ وَما نَصَحا",189,"ح",2,0],["وَمَسيري إِلَيكِ مِن","بَحرِ لَيلٍ مُلَجَّجِ",190,"ج",1,0],["وَمَسجِدُ شَيخٍ كُنتَ في سَنَنِ الصِبى","تُحيِّيهِ أَحياناً وَفيهِ نُكوبُ",191,"ب",1,0],["وَمَسكَنُ الروحِ في الجُثمانِ أَسقَمَهُ","وَبَينُها عَنهُ سُقمٍ يُعافيهِ",192,"ف",3,0],["وَمُسمِعَةٍ قَد أَصحَلَ الشُربُ صَوتَها","تَأَوّى إِلى أَوتارِ أَجوَفَ مَحنوبِ",193,"ب",1,0],["وَمُستَأذِنٍ يَبتَغِي نائلاً","أَذِنتُ لَهُ ثُمَّ لَم يُحجَبِ",194,"ب",1,0],["وَمَسرُوحةٍ مِثلِ الجَرادِ وَزَعتُها","وَكَلَّفتُها سِيداً أَزَلَّ مُصَدَّرا",195,"ر",2,0],["وَمَسكُنها بَينَ الغُروبِ إِلى اللِوى","إِلى شُعَبٍ تَرعى بِهنَّ فَعَيهَمِ",196,"م",1,0],["وَمُسَلّبٍ لَم يَرمِ جَمعَهُمُ","بِرِياشِ كُتّابٍ وَلا سَهم",197,"م",1,1],["ومسَّ الأرضَ في رفقٍ","يشقُّ رياضها الغَنَّا",198,"ن",2,0],["ومسَّ مزاهرهم روحُها","فرفَّتْ بها خالداتُ اللحونْ",199,"ن",1,0],["ومستحيل نرجّي برق ديمتِهِ","وكل ما نرتجيه منه مختلب",200,"ب",1,0],["ومَسْرَحَها في ظِلّ أحْوَى كأنها","إذا أظْهَرَتْ فيه ذَواتُ حِجال",201,"ل",1,0],["ومسكة العمران بين الناس","على العصور وعلى الاجناس",202,"س",1,0],["ومسير الايام تجمعنا","إن كان في الصبر بقايا",203,"ا",3,0],["ومسالِكُ الأَسْواقِ تشهد أَنَّها","لا يَستَقِلُّ بسالِكِيها المَحْشَرُ",204,"ر",1,0],["وَمُسْتَخْبِرٍ عَنِّي وَمَا كَانَ جَاهِلاً","بِشَأْنِي وَلَكِنْ عَادَةُ الْبُغْضِ لِلْفَضْلِ",205,"ل",1,0],["وَمُسعِدٍ جاءَ مَسروراً بِتَهنِئَةٍ","فَلَم يَرِم أَن بَكى حُزناً وَعَزّاهُ",206,"ا",2,0],["وَمُستَفتِحٍ بابَ البَلاءِ بِنَظرَةٍ","تَزَوَّدَ مِنها حَسرَةً آخِرَ الدَهرِ",207,"ر",1,1],["وَمَسكوبَةً ماءً وَمَمدودَةً ذرى","وَمَخضودَةً سِدراً وَمَنضودَةً طَلعا",208,"ع",2,0],["وَمُستَحسِنٌ ما أَبصَرت مِنكَ أَعيُنٌ","وَأَحسَن مِنهُ ما رَأَتهُ عُقولُ",209,"ل",1,0],["ومسجِدٌ نزلَ المختارُ ساحتَه","نمُوتُ فيه ونحْيَا مُسْتميتينَا",210,"ن",2,0],["وَمُسلِمو الهِندِ وَالهِندوسُ في جَذَلٍ","وَمُسلِمو مِصرَ وَالأَقباطُ في طَرَبِ",211,"ب",1,0],["ومُسلَّطٍ لمُسَلَّطينَ مشتْ به الأهواءُ","مِشيةَ مُثقَلٍ بخُمار",212,"ر",1,0],["ومُستسلمين يَرونَ الكفاحَ","قَوراء مدحوَّةً تُمتطى",213,"ا",1,0],["ومسهدٍ راع الظلامَ بخاطر","لو كان بالجوزاء حَلّ نطاقها",214,"ق",3,0],["ومسجفٌ لو لم يُحَجَّبْ كانَ مِن","زفراتِ أنفاسي بمثل سُجوفه",215,"ف",2,0],["ومَّسحتُ مِن خُصَلٍ تَدَّلي","عليه كما يَفعلُ المُغرم",216,"م",1,0],["ومَسحْتُ دمعَ الحُزنِ في أتراحِه","وجعلتُ مَحْضَ عواطفي مِنديلا",217,"ل",2,0],["ومُسْتَنْكرٍ شَيْباً قُبيلَ أوانهِ","أقولُ له : هذا غبارُ الوقائع",218,"ع",1,0],["ومسَّحتُ من ذيلِ الحَمامِ تملّقاً","وأنزلتُ من عَليا مكانتهِ صقرا",219,"ر",2,0],["ومُسَلِّمٍ يَوْمَ الوَداعِ ، شِفَاؤُهُ","مِمَّا يُعَانِي أَنْ يُرَدَّ سَلاَمُهُ",220,"م",2,0],["ومستضحك من عبراتي وبكائي","بكفيه دائي في الهوى ودوائي",221,"ا",3,1],["ومسبعة من دون ذاك أسوده","حصاها ومحواةٌ نقاهة اساودةٌ",222,"د",2,0],["ومُستقر على كرسيِّه تَعِبِ","روحي الفداءُ له مُنْصَبٍ نَصِبِ",223,"ب",1,1],["ومُسْتأْسِدٍ يَنْدَى كأنّ ذُبابَه","أخو الخمرِ هاجت شوقَه فتذكَّرا",224,"ر",2,0],["ومستفلكُ الذفرى كأن عنانهُ","ومَثْناتَهُ في في رأسِ جِذْعٍ مُشذَّبِ",225,"ب",1,0],["ومستهنيء زيد أبوه فلا أرى","له مدفعاً فاقني حياءك واصبري",226,"ر",2,0]]}