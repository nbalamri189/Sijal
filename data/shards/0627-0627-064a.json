{"poems":[[75,"في جواركم الذليل","https://www.aldiwan.net/poem11933.html","الوافر"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[53,"مرت ماء عيني فاستهل على النحر","https://www.aldiwan.net/poem63003.html","البسيط"],[53,"أأحمد لا والله لا ذقت فيشتي","https://www.aldiwan.net/poem65382.html","الطويل"],[53,"أبا حسنٍ حمدي متى ما بغيته","https://www.aldiwan.net/poem65959.html","البسيط"],[14,"أأي الناس آمن بعد بلج","https://www.aldiwan.net/poem38286.html","الوافر"],[51,"لمن طلل أسائله","https://www.aldiwan.net/poem63087.html","مجزوء الوافر"],[46,"أبا القاسم اسلم في وفود من القسم","https://www.aldiwan.net/poem29704.html","الطويل"],[46,"أأيامنا ما كنت إلا مواهبا","https://www.aldiwan.net/poem30584.html","الطويل"],[77,"سرى وجناح الليل أقتم أفتخ","https://www.aldiwan.net/poem69093.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39628","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39639","الطويل"],[108,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[189,"نهته النهى في خفية وتستر","https://www.aldiwan.net/poem14533.html","الطويل"],[382,"أيا أغنياء الروح صونوا كنوزَكم","https://www.aldiwan.net/poem59426.html","الطويل"],[398,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[443,"ترفّق فذا قلب على العذل لا يقوى","https://www.aldiwan.net/poem2504.html","الطويل"],[482,"عليل الوجد عندك لا يعاد","https://www.aldiwan.net/poem15313.html","الوافر"],[518,"أأيام هذا الدهر كم تعنفين بي","https://www.aldiwan.net/poem67760.html","الطويل"],[534,"جمال الجلال وفرد الكمال","https://www.aldiwan.net/poem37257.html","المتقارب"],[917,"","https://poetry.dctabudhabi.ae/diwan/poem/34519","الوافر"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77982","الوافر"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67860","الهزج"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132780","المتقارب"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132777","الوافر"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115304","الطويل"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115305","الطويل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89599","الطويل"],[4929,"جنون الشر","https://www.poetsgate.com/ViewPoem.aspx?id=199243",""],[5186,"أأيهذا الأمير سمعا رعاك","https://www.poetsgate.com/ViewPoem.aspx?id=156488",""],[5431,"فإن الصبرَ من عزم الأمور","https://www.poetsgate.com/ViewPoem.aspx?id=187730",""],[5722,"أحبابي الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=12692",""],[402,"يا مسهد القوم أطلت السنة","https://www.poetsgate.com/ViewPoem.aspx?id=36826",""],[6102,"شاخ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=184417",""]],"verses":[["أَأَيأَسُ مِن مُساعَفَةِ اللَيالي","وَأَنتَ إِلى نِهايَتِها سَبيلُ",0,"ل",1,0],["أأيَّامَ لَهْوِي هل مَواضيكِ عُوَّدٌ","وهل لشباب ضلَّ بالأمس مُنْشَدُ",1,"د",1,0],["أأيوب جادت كلّ أرضٍ حللتَها","مجلجلةٌ وَطفاء واكفة القطر",2,"ر",1,0],["أإياي تستغوي بما أنت قائل","طمعت لعمر الله في غير مطمع",3,"ع",1,0],["أإيّايَ تستدعي نوائَر شِرَّةٍ","مللتَ صفاءَ العيشِ كلَّ ملالِ",4,"ل",1,0],["أَأَيَّ الناسِ آمَنُ بَعدَ بَلجٍ","وَقَرَّةَ صاحِبَيَّ بِذي طَلالِ",5,"ل",1,1],["أَأَيَّتُها المَقابِرُ في","كِ مَن كُنّا نُنازِلُهُ",6,"ل",2,0],["أَإِيّايَ جارى القَومُ في الشِعرِ ضَلَّةً","وَقَد عايَنوا تِلكَ القَلائِدَ مِن نَظمي",7,"م",2,0],["أَأَيّامَنا ما كُنتِ إِلّا مَواهِبا","وَكُنتِ بِإِسعافِ الحَبيبِ حَبائِبا",8,"ب",2,1],["أآياتُ نَصْرٍ أمْ ملائكُ حُوَّمٌ","وأطرافُ أرضٍ أم سَماءٌ تُدَوَّخ",9,"خ",1,0],["أأيتها النارُ هذا المساءُ","قسى بردُهُ فانهضي واستفيقي",10,"ي",1,1],["أأيتها النارُ ويْكِ اصبري","أجئْكِ بكل الذي أملكُ",10,"ك",1,0],["أأيتها الأرضُ انظري ويكِ واسمعي","توثَّبَ فيكِ الشرُّ حمْراً مخالبُهْ",11,"ب",2,0],["أَأَيئَسُ من عفو السماءِ، وربَّما","وجدت على الأرض ابن حَوَّاءَ عَافيا",12,"ي",2,0],["أأَيامَنا بالثغرِ هل لكِ عودةٌ","إلى حافظٍ للعهدِ لم يتَغيَّر",13,"ر",1,0],["أأيامَنا ما كنتِ إلّا تجارةً","وقد سُرقت بالقصف واللهو والسكر",14,"ر",1,0],["أَأَيحزُّ رَأسُ ابنِ الرَسولِ وَفي الوَرى","حيّ أَمامَ رِكابِهِ لم يُقتَلِ",15,"ل",1,0],["أأيامنا إن عاد عيدك مرّة","فمن منة تحوى ومن منة تقوى",16,"و",2,0],["أأيامَ الشبابِ سقاكِ دمعٌ","تغصُّ به الأهاضبُ والوهادُ",17,"د",1,0],["أأيام هذا الدهر كم تعنفين بي","كأن لم تري قبلي معنىً ولا بعدي",18,"د",2,1],["أَأَيّامُ تَشْريقِنا قَدْ قَضَتْ","بِتَفْريقِنا يا لَقَومِي ويالِي",19,"ل",2,0],["أَأَيّامي بِشاطي البِركَتَينِ","سَقاكِ اللَهُ نَوءَ المِرزَمَينِ",20,"ن",1,1],["أإيمانٌ هنالك أم نفاق","وإقرارٌ هنالك أم جحود",21,"د",1,0],["أأيَّامك تَهتزُّ","اهتزازَ الغُصُنِ الرَّطبِ",22,"ب",1,1],["أإيطاليا ما الذي تأملين","من حربنا هذه الداميه",23,"ي",2,0],["أإيران انعمى بالنصر عينا","ولا تذعر جفونك عن كراها",24,"ا",3,0],["أإيماءُ أطرافش البَنانِ وَوَجههَا","أبانا له كيفَ الضَمير المُغيَّبُ",25,"ب",1,0],["أأيقنَ أنَّ الشيبَ ينعى حياتَه","مُدِرٌّ لأخلافِ الحطيئةِ مُذنِبُ",26,"ب",1,0],["أَإيوانُ قُل لي أَينَ هارونُ إِنَّني","أُريدُهُ أَقضي مِنهُ إِن كانَ قاضِيا",27,"ي",2,0],["اأين الشجاعةُ في اقتناصِك طفلةً","لبنُ الرضاعةِ لم يفارقْ فاها؟",28,"ا",3,0],["أأيهذا الأمير سمعا رعاك","الله ربي ورب كل أمير",29,"ر",1,1],["أأيوبٌ وشعبي قد تباروا","بأحزان تهيج على الصدور",30,"ر",1,0],["أأيامنا لا زلتِ معسولةَ الجنى","كروضٍ شذيٍّ رفَّ في حللٍ خضر",31,"ر",1,0],["ا أيها الناعيه في قومه","نعيت أوفى خادم موطنه",32,"ن",2,0],["ا أَيُّها الكَذَّابُ , صَهْ , لَنْ أَسْمَعَكْ","وَ إِذَا بَكَيتَ فَلَنْ أُصَدِّقَ أَدْمُعَكْ",33,"ك",1,1]]}