{"poems":[[108,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[136,"رسم ربع بجانب الينبوع","https://www.aldiwan.net/poem54803.html","الخفيف"],[275,"أجبني أيها الكون الصموت","https://www.aldiwan.net/poem35178.html","الوافر"],[275,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[473,"أبا الفضل تبدي تمصبطرما","https://www.aldiwan.net/poem59771.html","المتقارب"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77968","الوافر"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116940","السريع"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131258",""],[5687,"حريق الماء","https://www.poetsgate.com/ViewPoem.aspx?id=208075",""]],"verses":[["والأضَابير بين طيّ ونشرٍ","سلَبَت ما بعينهِ من ضياء",0,"ا",2,0],["والأضَيَّانُ في جَوَانِبِهَا دُو","رٌ ودُورٌ بِرِيعَةِ اليَتُّوعِ",1,"ع",1,0],["وإلا ضلَّ كلُّ الناس شكاً","فحتّامَ التَّسَتُّرُ والسكوت",2,"ت",1,0],["وإِلا ضعتَ مِثلي بينَ قومٍ","أُجاوِرُهم ولستُ بمُستفيد",3,"د",1,0],["وَإِلّا ضَرَبتُ قَفا سَيِّدي","وَلَو كانَ أَضرَبَ مِن زَلزَلِ",4,"ل",1,0],["والاضطرار في الذي ذكرتُهُ","بجمعه يأتي بما منعتُهُ",5,"ه",1,0],["والأضعفون وَما يقتات أَجزلهم","إِلّا بِما جرّت المسحاة وَالحجن",6,"ن",1,0],["والأضعفُ الأصغر أحرى بأن","يحتال للأكبر بالفكر",7,"ر",1,0],["والأض ترتكم الجماجم فوقها","حتى تخال وهادها كثبانها",8,"ن",3,0],["والأضاة /البلاد قد ودعوها","بسلام حين. اعتراها النقيق..",9,"ق",1,0]]}