{"poems":[[102,"يقظة الصحراء","https://www.aldiwan.net/poem23696.html","عموديه"],[89,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62225","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16649","الخفيف"],[112,"شوف فوق","https://www.poetsgate.com/ViewPoem.aspx?id=8385",""],[266,"قفي ربة الوقف والدملج","https://www.aldiwan.net/poem38353.html","المتقارب"],[563,"أنا صاحب الأمر الإلهي","https://www.aldiwan.net/poem33662.html","مجزوء الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126724","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133835","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115998","الرمل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82606","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80043","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79855","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79857","الرمل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113966","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113946","الخفيف"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199640","المسحوب"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199630","المسحوب"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2851,"","https://poetry.dctabudhabi.ae/diwan/poem/105597","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100396","الرمل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58353","الخفيف"],[3428,"","https://poetry.dctabudhabi.ae/diwan/poem/124003","الخفيف"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85266","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103008","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102996","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103025","البسيط"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136877",""],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136820",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133083","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133129","البسيط"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101312","الخفيف"],[4829,"غارت الخيل الاصايل","https://www.poetsgate.com/ViewPoem.aspx?id=34422",""],[5009,"جيل الصحوة","https://www.poetsgate.com/ViewPoem.aspx?id=68820",""],[5055,"أحتفا","https://www.poetsgate.com/ViewPoem.aspx?id=104031",""],[5701,"حي مصرا رعى المهيمن مصرا","https://www.poetsgate.com/ViewPoem.aspx?id=164580",""],[402,"يا عيونا تسقي العيون الرحيقا","https://www.poetsgate.com/ViewPoem.aspx?id=36024",""]],"verses":[["حي ميلاد الهدى عاماً فعاما","واملأ الدنيا نشيداً مستهاما",0,"م",2,1],["حَيِّ مَغْنَى الْهَوَى بِوَادِي الشَّآمِ","وَادْعُ بِاسْمِي تُجِبْكَ وُرْقُ الْحَمَامِ",1,"م",1,1],["حَىُّ مَحَاضِرُهُمْ شَتَّى ويَجْمَعُهُمْ","دَوْمُ الإِيَادِ وفَاثورٌ إِذَا انْتَجَعُوا",2,"ع",3,0],["حَيِّ مِن أجْلِ أهْلِهِنّ الدّيارَا","وابْكِ هِنْداً لا النُّؤيَ والأحْجارا",3,"ر",2,1],["حي مني لاذكرته.؟ دريت أني بخير.","صاحبن لاشافني. ضقت منه؟ ضمني",4,"ن",2,1],["حيم تخف هضاب الدنا","وبرجح حلما ولم يحرج",5,"ج",1,0],["حي مميت والأسي","ر المطلق العيّ المباهي",6,"ا",3,0],["حيّ محمّد الرضا حلف الندى","مَن شعّ في أفق الهداية فرقدا",7,"د",2,1],["حي مع الأشواق والآمال","في صدر الشباب",8,"ب",1,0],["حَىِّ من أسماءَ بالخَيفِ خِياما","واقرها عنّى ومَن فيها السَّلاما",9,"م",2,1],["حَيِّ مَن دينُه عَلى دين مانِي","بِزَوال مِن نِعمَة وَعقاب",10,"ب",1,0],["حَيِّ من أَصبَح الغداة وَزيرا","وَهو بِالأَمسِ كاتِب اِبن شهاب",10,"ب",1,0],["حيّ منه مؤرِّخاً عام ردّا","كلّ شطرٍ أبدى فعدَّ الشطورا",11,"ر",2,0],["حيّ من الأتراك بين خدورهم","هيفاءُ تمنح وصلها من زارها",12,"ر",3,0],["حيّ مُستحفظَ العلومِ بعصرٍ","فيه لولاهُ أوشكت أن تضيعا",13,"ع",2,0],["حيِّ ميمونَ قبلَ وشكِ الفِراقِ","خبِّرَنها من الهَوى ما أُلاقي",14,"ق",2,1],["حيِّ ميمونَ إنَّ ميمونَ منها","ليسَ للنَفسِ إن دنا البَينُ راقِ",14,"ق",1,0],["حَيِّ ميمونَ ويكَ تكرورُ واترُك","قولض من لَم يَذُق هوى الإشتياقِ",14,"ق",1,0],["حَيٍّ من ساحَةِ المُبَيدِع دُورا","جَنبَةَ الريِّعِ قد دَثَرنَ دُثورا",15,"ر",2,1],["حيّ من عنّا لي امثالي","لي يزين الطّرس تسجيله",16,"ل",2,1],["حي من أهدى الكتاب ومن ندب","فيه بدع الجيل واستنى الردى",17,"د",2,1],["حَيٌّ مُرِيدٌ قَادِرٌ مُتَكَلِّمٌ","ذُو رَحمَةٍ وَإرَادَةٍ وَحَنَانِ",18,"ن",1,0],["حي منها تلك الثنايا وبلغ","حيها منية المشوق سلامه",19,"م",2,0],["حي مجتازا على ادم الظبا","واضح اللبة مصقول الاديم",20,"م",1,0],["حَيِّ مصراً فَغوطةَ الخشّابِ","فَرُبى الخور مَعْهداً للتّصابي",21,"ب",2,1],["حيّ من أجل من تُحِبذُ الظلولا","طالما قد سحَبتَ فيها الذيولا",22,"ل",2,1],["حي ما حيا في طيب عيش ومذ قضى","بقى ذكره في الناس إذ فقد الجسم",23,"م",1,0],["حيّ من الكرماء لست تخالهم","إلا فرائد في عقود كمال",24,"ل",1,0],["حيّ من العرب لم تذكر صفاتهم","لمسمع الدهر إلا اهتز أو رقصا",25,"ص",2,0],["حي من الشوس معتاد وليدهم","على رضاع دم الأبطال لا اللبن",26,"ن",1,0],["حي من فيه حي الله قراره وعانيه","وأهله الكل حتى ما سرح من سوانيه",27,"ن",3,0],["حي من راك حذيه يا فضيضه إلى هود","حبهم كلهم حي الله البيض والسود",28,"د",1,0],["حي مريدٌ قادرٌ متفردُ","بالملك والتصريف في الأكوان",29,"ن",1,0],["حي مريد عليم قادرٌ أبداً","سبحانه جل ذي سمع وذي بصر",30,"ر",1,0],["حيِّ منا الحشا بطيب شذاكا","واسكن القلب انه مغناكا",31,"ك",2,1],["حي من صوته ينادي من بعيد(ن) للقريب","دامِ صوته وسط جوفي يبشر انه مايظام",32,"م",1,0],["حي مصهال الفرس لاطارت وغز السبيب","كنّها وقت اللقا قصايدي بين الانام",32,"م",1,0],["حي من صام يوم قيظ وحر","اتقاء لحر يوم إذا جا",33,"ج",2,0],["حي من أحيا سنة لرسول","الله ماتت واليوم تلقى رواجا",33,"ج",2,0],["حيّ ميلاد الضيا يشعل شموع","الفرح أسَفْر فوانيس العربْ",34,"ب",1,0],["حي مصرا رعى المهيمن مصرا","وحباها الإله نصرا فنصرا",35,"ر",2,1],["حيمثا وارتني دجاه غروبا","أبصرتني عين الصباح شروقا",36,"ق",2,0]]}