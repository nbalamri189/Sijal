{"poems":[[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[53,"لك ريحان وراح ومجيدات ملاح","https://www.aldiwan.net/poem9410.html","مجزوء الرمل"],[64,"خير أمثاله التي ضربوها","https://www.aldiwan.net/poem52208.html","الوافر"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[107,"يا ابن عوف سر حثيثا باللواء","https://www.aldiwan.net/poem43583.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85549","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[108,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[287,"بالعدل تزدان الملوك وما","https://www.aldiwan.net/poem32660.html","السريع"],[422,"لك بالمعالي رتبة تختارها","https://www.aldiwan.net/poem54015.html","الكامل"],[458,"وحدتي فيلسوفة تمسح الدمع","https://www.aldiwan.net/poem61234.html","الخفيف"],[484,"يا مفخر البيت الحسي","https://www.aldiwan.net/poem37045.html","مجزوء الكامل"],[556,"صد عني كارها قربي","https://www.aldiwan.net/poem48073.html","مجزوء الرمل"],[567,"أي ذنب ترى وأية زله","https://www.aldiwan.net/poem52985.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138418",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138312",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126812","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126831","الخفيف"],[674,"","https://poetry.dctabudhabi.ae/diwan/poem/145908","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110407","الكامل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88610","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86906","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145808","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119868","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109235","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79960","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49050","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1867,"","https://poetry.dctabudhabi.ae/diwan/poem/130677","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[1960,"","https://poetry.dctabudhabi.ae/diwan/poem/145514","الرمل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76795","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110276","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53209","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102661","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93869","الخفيف"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136973",""],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109791","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100854","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108333",""],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128922","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114560","الرمل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29283","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44913","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139470",""],[4929,"دين الله الاسلام","https://www.poetsgate.com/ViewPoem.aspx?id=208716",""],[5092,"تائهان","https://www.poetsgate.com/ViewPoem.aspx?id=178351",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5273,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=176204",""],[5277,"ربيعُ القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=212980",""],[5307,"يا هِبوب الوَرد والفِلّي","https://www.poetsgate.com/ViewPoem.aspx?id=10535",""],[5351,"المتناثر في يد الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=201919",""],[5431,"والشعر بحرٌ طائرٌ في أربعه!!","https://www.poetsgate.com/ViewPoem.aspx?id=197923",""],[5561,"في ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=193375",""],[5628,"لست شاكيا","https://www.poetsgate.com/ViewPoem.aspx?id=178488",""],[5628,"الخروج من القمقم","https://www.poetsgate.com/ViewPoem.aspx?id=178500",""],[5672,"من ادب الاخوانيات","https://www.poetsgate.com/ViewPoem.aspx?id=213893",""],[5720,"الكِتَابَة","https://www.poetsgate.com/ViewPoem.aspx?id=200244",""],[5956,"نجلي وأصحابه وموظفوه","https://www.poetsgate.com/ViewPoem.aspx?id=193289",""],[5956,"شكراً شربنا القهوة الغراءَ","https://www.poetsgate.com/ViewPoem.aspx?id=208050",""],[5956,"رحلةُ أسرة لغابِ المَسَرَّة","https://www.poetsgate.com/ViewPoem.aspx?id=210739",""],[5956,"السيرة الذاتية للدكتور قيسٍ الرِّضواني بالشعر الروحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215553",""],[6127,"خوفُ الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=198260",""],[6229,"ذلك الصوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65179&r=&rc=2",""],[6323,"زلزال الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82178&r=&rc=9",""]],"verses":[["هُوَ دانَ الرَبابَ إِذ كَرِهوا الدي","نَ دِراكاً بِغَزوَةٍ وَصِيالِ",0,"ل",1,0],["هُوَ دِعْصٌ وَهْوَ غُصْنٌ","تَتَهادَاهُ الرياحُ",1,"ح",1,0],["هو دهن للآكلين وصبغ","خارج من بطون ذاك النباتِ",2,"ت",1,0],["هو دِرهمٌ لا نفعَ فيه وإن زها","في العينِ من نَقْشٍ وحُسن صِقالِ",3,"ل",1,0],["هُوَ دِينُ اللهِ حَقّاً ما بِهِ","إن رَضِينَا أو أَبَيْنَا من خَفَاءْ",4,"ا",2,0],["هُوَ داء مبيته في نخاعي","إن داء النخاع داء وبيل",5,"ل",1,0],["هُوَ دَلٌّ رَدَّدَتْهُ قَيْنَةٌ","وَهْوَ وَجْدٌ فاضَ مِنْ نَفْسِ فَتاها",6,"ا",3,0],["هو دولةٌ كبرى، وملكٌ شامخٌ","لا محضُ تكبيرٍ، ومحضُ صيام",7,"م",1,0],["هود عرار فلاح محسن ملكوا","فنبهوا الملك حينا وهو نعسان",8,"ن",1,0],["هُوَ دَلوُ دَولَتِهِ بِلا سَبَبٍ","فَمَتى يُرى ذا الدَّلوُ في حَبلِ",9,"ل",1,0],["هو دِيمةٌ لم تنقطع أنواؤها","وسحابةٌ لم تنقشعْ أمطارها",10,"ر",3,0],["هوديني الذي تسامى على الدين","كما جاوز العبير النسيما",11,"م",2,0],["هو درة في تاجهم","خلابة للناظر",12,"ر",1,0],["هُوَ داءٌ حَلَّ جِسمي","لَم أَجِدْ مِنهُ طَبيبا",13,"ب",2,0],["هُوَ دائِي ولا أقول الدوا من","هُ لئلا يقولَ حُبّي لعلَّهْ",14,"ل",2,0],["هو دوحة غُرست على مجر الميا","ه فأثقلت منها الثمار الأغصنا",15,"ن",2,0],["هو درة في النابغين يتيمة","شتان بين لآلئٍ ونحاس",16,"س",1,0],["هود ويونس مِن بهاك تجمّلا","وَجمال يوسف من ضياءِ سَناكا",17,"ك",2,0],["هو داعٍ لسيّد الرسلِ طهَ","وبنيه الأطهار أَضحى سليلا",18,"ل",2,0],["هو دوحة الملك العلي فروعها","وبراحتيه ترزق الأدواح",19,"ح",1,0],["هودُوقُ ورتمبرجَ ذو الشرف الذي","ملأَ المشارقَ صِيتُهُ والمغربا",20,"ب",2,0],["هو دهر به اِستَقامَت بنوه","بيدى حالتين نعمى وبؤس",21,"س",1,0],["هو ديوان جُند مَصر الَّذي كا","ن لِهَذا الأَمير فيهِ اِنتِباه",22,"ا",2,0],["هُوَ دَوحة مُدَّت وَأَورقَ غُصنُها","وَظِلالُها عَمَّت وَطابَ سَماها",23,"ا",3,0],["هوَ دربُ الفِداءِ نمشيهِ حتى","يَدحرَ الباطِلَ الزهوقَ الفِداءُ",24,"ا",2,0],["هود التجارب باديات","عون نعمله وعود",25,"د",1,0],["هو دولتي هو موطني","هو كل هذه الجعجعه",26,"ع",2,0],["هو دارةُ الشرف التي قد مهَّدتْ","أبد الزمان بعزِّهم تمهيدا",27,"د",2,0],["هو درّةٌ عصماءُ أَذكتْ في الدُّجى","نوراً فنالتها المنونُ بلا ثمَن",28,"ن",1,0],["هو داء في ظاهر الأمر لكن","كان شراً من كل داء دواها",29,"ا",3,0],["هو در منظم في عقود","في نحور الكواعب الابكار",30,"ر",1,0],["هو دين يقضيه من بعده ال","حي رآه أهل العراق حلالا",31,"ل",2,0],["هو دائي ودوائي عندكم","هل لدائي، سادتي، فيكم طبيب؟",32,"ب",1,0],["هودٌ ويوسفُ كم خوفٍ به أمنا","ولن يُروع صوتُ الرعدِ من ذكرَه",33,"ر",2,0],["هو دمع لبنانَ القريرُ ولا ترى","دمعاً سواه يقرُّ في لبنان",34,"ن",1,0],["هو دونك البحر الخضم يحوط ما","أوتيت والطود الأشم الأيهم",35,"م",1,0],["هو ديني وهو كل الأديان","شرع النبيّ المصطفى المكرّم",36,"م",1,0],["هو دوح أفنانه قائمات","بفنون تجني لكل جليس",37,"س",1,0],["هو دين لي على الأستاذ","فليقضني يوم زفافي حق ديني",38,"ن",2,0],["هو دمع لدلال في مقلة الحس","ن يروِّي غلا ويذكي غليلا",39,"ل",2,0],["هو دمية المحراب لولا لينه","فوق الوسادة لا يجيب الداعيا",40,"ي",2,0],["هو دمع المحب يسقي ثراه","غير ان الدموع تسفح حمرا",41,"ر",2,0],["هُوَ دينُ رَبِّ العالَمينَ وَشَرعُهُ","وَهُوَ القَديمُ وَسيِّدُ الأَديانِ",42,"ن",1,0],["هُوَ دينَ آدَمَ وَالمَلائِكِ قَبلَهُ","هُوَ دينُ نوحٍ صاحبِ الطوفانِ",42,"ن",1,0],["هُوَ دينُ إِبراهيمَ وابنَيهِ مَعاً","وَبِهِ نَجا مِن نَفحَةِ النيرانِ",42,"ن",1,0],["هُوَ دينُ يَعقوبَ النَبيِّ وَيُونُسٍ","وَكِلاهُما في اللَهِ مُبتَليانِ",42,"ن",1,0],["هُوَ دينُ داودَ الخَليفَةِ وابنِهِ","وَبِهِ أَذلَّ لَهُ مُلوكَ الجانِ",42,"ن",1,0],["هُوَ دينُ يَحيى مَعَ أَبيهِ وَأُمِّهِ","نِعَمَ الصَبيُّ وَحَبَّذا الشَيخانِ",42,"ن",1,0],["هو دار الخلائف الغر قوم","ملأوا الارض بالهدى والامان",43,"ن",1,0],["هو ديكٌ صائحٌ في وقتهِ","أم غرابٌ ناعِبٌ مُبدٍ عماسَه",44,"س",2,0],["هُوَ دَمعُ الزَمانِ وَهوَ الرَح","يمُ القَلبِ لَم يَلقَ في الحَياةِ اِنحِياشا",45,"ش",2,0],["هُوَ داعي المَنونِ آثر أن نَف","جعض حَتّى في الكَوكَبش الوَضّاءش",46,"ا",2,0],["هو دون السماء صنعاً ولكن","دونه الصنع كله والسماء",47,"ا",2,0],["هو دين واحد ربي اقتضاهْ","اسمه الاسلام لادين سواهْ",48,"ا",2,1],["هوَ دائمًا جعلَ الغرامَ دروبهُ","أوَ كانَ دربيَ للغرامِ مُحَدّدَا ؟",49,"د",2,0],["هو دوح الأقطار طراً وانتهى","غزوا إلى البحر المحيط الأسود",50,"د",1,0],["هُوَ ديْمةٌ عَنْ خَصْبِ روحٍ فَتَّشَتْ","عَنْ رَوضَةٍ .. كَيْ تَستَطيعَ هُطُولا",51,"ل",2,0],["هودٌ ويوسفُ منجلٌ وسقايةُ","وحصادها المبروك بالأيمان",52,"ن",1,0],["هُوْ دِوَا لنَّفْس مِ العِلّي","هَوحِياتي او جَنّتي أو ناري",53,"ر",2,0],["هو دهشة المجهول نحو رجائهِ","سارت إليه ِ بدونه ِ قدماهُ",54,"ا",2,0],["هو دافئ والقلب بحرٌ شاسعٌ","غرقت به سفن الحروب مروعه",55,"ع",2,0],["هُوَ دعوةُ الأوّاهِ عزّ دعاؤُه","بالحلمِ قد عَرفَ الإله تعالى",56,"ل",2,0],["هوَ دربٌ كمْ ضاع َفيهِ دليل ٌ","وخوى كوكبٌ وظلّ هُداةُ",57,"ه",1,0],["هوَ دهْشة تنتابنا في لحظةٍ","فنتيهُ , بل هوَ أدمعٌ وجراحُ",58,"ح",1,0],["هو درةٌ وكنزتُهُ","كنز الندى بفمِ الغيومِ",59,"م",1,0],["هُوَ دَمْعَةٌ سَكَبَتْ هُمُومَاً مُرَّةً","كَمْ عَالَجَتْ فِي القَلْبِ جُرحَاً خَافِيَا!",60,"ف",3,0],["هو ديكٌ بطل يرعى دجاجاً","مشبعاً بالبيضِ أحشاء البشرْ",61,"ر",1,0],["هو دائماً يختصّني برعايةٍ","نفسيّةٍ تستقطب الأضواءَ",62,"ا",2,0],["هو دُرة ما بين أطفال لهم","باعٌ بفنِّ العلم والآدابِ..",63,"ب",1,0],["هو دعوةٌ للعلم والإيمانِ","والارتقاءِ بكل ما هو دانِ",64,"ن",1,0],["هُوَ دوحة الرحمنِ أُشْرِعَ بابُها","للراغبين ومَنْ عسى لا يَرْغَبُ",65,"ب",1,0],["هو دنيا من الشعورِ لقلبي","يا لَدنيا - في وحدتي - من شُعور",66,"ر",1,0],["هو دولة الشعراء ختم جوازها","بندى المشاعر والخواطر يصدرُ",67,"ر",1,0]]}