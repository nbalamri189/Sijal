{"poems":[[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[53,"أغدرا يا زمان ويا شباب","https://www.aldiwan.net/poem30744.html","الوافر"],[9,"غشيت لليلى بليل خدورا","https://www.aldiwan.net/poem21941.html","المتقارب"],[27,"ألا حي أهل الجوف قبل العوائق","https://www.aldiwan.net/poem5928.html","الطويل"],[47,"ألا من مبلغ سروات قومي","https://www.aldiwan.net/poem25151.html","الوافر"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[51,"إن كنت تعطيني عطاءك","https://www.aldiwan.net/poem11445.html","مجزوء الكامل"],[85,"نراوح بالحوادث أو نغادى","https://www.aldiwan.net/poem8105.html","الوافر"],[85,"إلى الله أشكو من عوادي النوى سهما","https://www.aldiwan.net/poem11331.html","الطويل"],[85,"ضربوا القباب على اليباب","https://www.aldiwan.net/poem62925.html","مجزوء الكامل"],[45,"أجز من غلة الصدر العميد","https://www.aldiwan.net/poem62751.html","الوافر"],[45,"محا نور النواظر والعقول","https://www.aldiwan.net/poem65643.html","الوافر"],[61,"إصبر على نوب الليالي","https://www.aldiwan.net/poem51337.html","مجزوء الكامل"],[97,"لعينيك احتملنا ما احتملنا","https://www.aldiwan.net/poem24770.html","الوافر"],[97,"أحبك فوق ما عشقت قلوب","https://www.aldiwan.net/poem24912.html","الوافر"],[74,"ألا ليت لمح البارق المتألق","https://www.aldiwan.net/poem13196.html","الطويل"],[33,"طربت وهاجتك الديار البلاقع","https://www.aldiwan.net/poem25889.html","الطويل"],[48,"أيا من كنت بالبصرة","https://www.aldiwan.net/poem62609.html","الهزج"],[48,"مضى ليل وأخلفت النجوم","https://www.aldiwan.net/poem65101.html","الوافر"],[48,"كلنا يا ابن حديج","https://www.aldiwan.net/poem66235.html","مجزوء الرمل"],[50,"تخليت من صفراء لا بل تخلت","https://www.aldiwan.net/poem64748.html","الطويل"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[76,"نجوم في المفارق ما تغور","https://www.aldiwan.net/poem39312.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39588","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[144,"سما بك دهرك فليفتخر","https://www.aldiwan.net/poem11765.html","المتقارب"],[151,"تزودت من مدح النبي المؤيد","https://www.aldiwan.net/poem68589.html","الطويل"],[161,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[170,"بالسيف يفتح كل باب مقفل","https://www.aldiwan.net/poem1657.html",""],[182,"ولما لحقنا بالحمول ودونها","https://www.aldiwan.net/poem59048.html","الطويل"],[187,"كفى حزنا أن قد مضت لي أربع","https://www.aldiwan.net/poem43237.html","الطويل"],[198,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[200,"في الشفاه اللعس ما يشفي الألم","https://www.aldiwan.net/poem45345.html","الرمل"],[204,"ولما لقيناهم بهندف جمعهم","https://www.aldiwan.net/poem68160.html","الطويل"],[230,"وساقية ترتمي بالحباب","https://www.aldiwan.net/poem51085.html","المتقارب"],[251,"ولم ألق في بيتي دثارا أعده","https://www.aldiwan.net/poem14964.html","الطويل"],[276,"هو الفتح بعد الفتح يأتي مسوغا","https://www.aldiwan.net/poem25482.html","الطويل"],[283,"أريقك أم صهباء في الكأس إسفنط","https://www.aldiwan.net/poem32718.html","الطويل"],[321,"ما لعيني قريره","https://www.aldiwan.net/poem67225.html","مجزوء الرمل"],[343,"يا نفس ما لك تنشرين","https://www.aldiwan.net/poem55350.html","مجزوء الكامل"],[343,"صدق الظن واستبان الخفاء","https://www.aldiwan.net/poem55383.html","الخفيف"],[350,"هم رغبتي فلماذا في قد زهدوا","https://www.aldiwan.net/poem15620.html","البسيط"],[350,"يعن لطالب الدنيا ثلاث","https://www.aldiwan.net/poem15943.html","الوافر"],[365,"سأنشر أوصاف المهدب مادحا","https://www.aldiwan.net/poem60993.html","الطويل"],[367,"إذا ما الغزال سرى زائرا","https://www.aldiwan.net/poem17196.html","المتقارب"],[381,"تباعدت عن ألفي فيا حر أشجاني","https://www.aldiwan.net/poem48777.html","الطويل"],[395,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[406,"مدحتك للضرورة لا لأني","https://www.aldiwan.net/poem49638.html","الوافر"],[407,"أخذن زمام الدمع خوف انسجامه","https://www.aldiwan.net/poem50120.html","الطويل"],[417,"أبى الله إلا إن تعز وتكرما","https://www.aldiwan.net/poem54043.html","الطويل"],[433,"بك الإسلام قد لبس الشبابا","https://www.aldiwan.net/poem12461.html","الوافر"],[454,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[459,"تمنى رجال أن تزل بي النعل","https://www.aldiwan.net/poem55997.html","الطويل"],[459,"أزائرة كما زعم الخيال","https://www.aldiwan.net/poem56081.html","الوافر"],[459,"رعى الله في الحاجات كل نجيب","https://www.aldiwan.net/poem56301.html","الطويل"],[478,"يؤرقني حنين وادكار","https://www.aldiwan.net/poem15306.html","الوافر"],[515,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[516,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[539,"أحن إلى مصر وما أنا من مصر","https://www.aldiwan.net/poem48137.html","عموديه"],[539,"إن يكن غيري تابا","https://www.aldiwan.net/poem48275.html","عموديه"],[552,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[552,"لنا من ثناياك الغريض المرشف","https://www.aldiwan.net/poem47403.html","الطويل"]],"verses":[["وَلَم أَلقَ مُنفَرِداً في الزَمانِ","يُسائِلُ عَن إِلفِهِ أَينَ سارا",0,"ر",2,0],["وَلَمّا لَم يُلاقوا فيَّ عَيباً","كَسوني مِن عُيوبِهِمُ وَعابوا",1,"ب",3,0],["وَلَمّا لُقيتَ مَعَ المُخطِرينَ","وَجَدتَ الإِلَهَ عَلَيهِم قَديرا",2,"ر",2,0],["وَلَمّا لَقينا خَيلَ أَبجَرَ أَعلَنوا","بِدَعوى لُجَيمٍ غَيرَ ميلِ العَواتِقِ",3,"ق",1,0],["وَلَمّا لَم أَجِد إِلّا فِراراً","أَشَدَّ مِنَ المَنِيَّةِ أَو حِماما",4,"م",2,0],["ولم أَلبَسْك إلّا يوم فخرٍ","ويوم زيارة المَلكِ اللُّبابِ",5,"ب",1,0],["ولمَا لعبدِك واجب","لكن لكونك سيدا",6,"د",2,0],["وَلَمّا لَم نَنل لِلسَيفِ رَدّاً","تَنازَعنا الحَمائِلَ وَالنِجادا",7,"د",2,0],["وَلَم آلُ شُبّانَ البَرِيَّةِ رِقَّةً","كَأَنَّ ثِمارَ القَلبِ مِن وَلَدي ثَمّا",8,"م",2,0],["وَلِمَ التَرَحُّلُ عَن حَيا","ةٍ أَنتَ مِنها في رِكابِ",9,"ب",1,0],["وَلَمّا لَم أَجِد لِلسَيفِ حَدّاً","أَصولُ بِهِ نَصَرتُكَ بِالقَصيدِ",10,"د",1,0],["وَلَمّا لَم نَجِد دَرَكاً لِثاوٍ","وَجَلَّ المَوتُ عَن طَلَبِ الذُحولِ",11,"ل",1,0],["ولم السواد فإنه","عراك من حلل الجمال",12,"ل",1,0],["ولمّا لَم تفز بلقاك عيني","لمحتك آتياً بضمير قلبي",13,"ي",1,0],["ولما لم أجد للحب حلا","هتفتُ به كما يرضيك سِر بي",14,"ب",2,0],["وَلَم أَلتَفِت مِن وَجهِهِ لَيلَةَ السُرى","إِلى فَيلَقٍ يَلقى الظَلامَ بِفَيلَقِ",15,"ق",1,0],["وَلَمّا لَحِقنا بِالحُمولِ تَباشَرَت","بِنا مُفصِداتٌ غابَ عَنها الطَلائِعُ",16,"ع",1,0],["وَلَمّا لَم يَكُن بُدٌّ","وَجَدنا مِنكُمُ بُدّا",17,"د",2,0],["وَلَمّا لاحَ ضَوءُ الصُبحِ عَنّا","وَحَرَّكَ عودَهُ بَدرٌ وَسيمُ",18,"م",1,0],["ولمَ الرهزُ لذيذٌ","عند تكرار العمل",19,"ل",1,0],["وَلَمّا لَحِقناهُم كَأَنّا سَحابَةٌ","مِنَ المُلمِعاتِ البَرقَ حينَ اِستَهَلَّتِ",20,"ت",1,0],["ولمّا لم يُسابِقْهُنّ شَيءٌ","مِنَ الحَيَوانِ سابَقْنَ الظّلالا",21,"ل",2,0],["ولَمْ ألقَ المُنَى في ظلِّ لَهْوٍ","بِأَقمارٍ سَحَائِبُها السّتُورُ",22,"ر",1,0],["ولمَ البحيرةُ مثلما سُجِرتْ","أو فُجِّرتْ من عرقِ منذَبحِ",23,"ح",1,0],["ولِمَ الصباحُ كأنما أنداؤُه","كأسٌ تُصفّقُ أو رحيقٌ يسجمُ",24,"م",1,0],["وَلَم آلُ جُهداً كَما قَد تَرى","وَإِنّي بِتَقصيرِ جَريي مُقِرّ",25,"ر",1,0],["وَلَمّا لَواني البُعدُ عَنهُ ضَرورَةً","ظَعَنتُ إِلَيهِ بِالفؤادِ صَرورَةً",26,"ه",1,0],["ولم آل نصحا في دليل أقمته","وفي حجج جدت لسان المناظر",27,"ر",1,0],["وَلِمَ الشَقائِقُ وَالتِلاعُ لِغَيرِنا","وَلنا الخَطائِطُ قسمُ مَن لَم يَعدِلِ",28,"ل",1,0],["وَلِمَ العَدُوُّ يَرُوحُ قِردَ زُبَيدَةٍ","شَبَعاً وَمُصفِي الوُدّ كَلبَةَ حَومَلِ",28,"ل",1,0],["وَلَمّا لَحِقنا بِالحُمولِ وَدونَهَا","خَميصُ الحَشا تُوهِى القَميصَ عواتِقُه",29,"ق",2,1],["ولم ألق فيها صاحبا ذا بصيرة","يكون لنا عونا بهذا الزمان",30,"ن",1,0],["ولم التفاخرُ بالموائدِ والملاب","سِ والأثاثِ وشاهقِ الجُدرانِ",31,"ن",1,0],["ولمَ التعصّبُ بالمذاهبِ يا بَني الأ","وطانِ وهوَ أساسُ كلِّ هوانِ",31,"ن",1,0],["ولمَ الصدُّ أما آنَ لما","شتّتَ الهجرانُ مني أن يُلَمْ",32,"م",1,0],["وَلَمّا لَقيناهُم بَهنَدفَ جَمعِهِم","أَناخوا وَقالوا إِصبِروا آل فارِسِ",33,"س",1,1],["ولم أُلقِ من ناظري نظرة","إلى منظَر غيرِ منظورها",34,"ر",3,0],["ولم ألق في بيتي دثاراً أُعدُّهُ","لبردٍ ولا شيء يردُّ هجيرا",35,"ر",2,1],["وَلَمَّ الوَرَى شَمْلاً وَكانوا كَأَنَّما","رَغَا وسطَهمْ سَقْبُ السَّماءِ وَما رَغَا",36,"غ",2,0],["وَلَم آلُهُ في الدَّهرِ ما عِشتُ داعِياً","يُؤَمِّنُ حَولي مِن تَلامِذَتي رَهطُ",37,"ط",1,0],["وَلِمَ الأَفراحُ عَمَّت","كُلَّ قَومٍ وَعشيرُهُ",38,"ر",2,0],["ولمَ الركون","يا نفس ما لك تصمتين",39,"ن",1,0],["ولم اليأس يا أخي من حياة","كلها باطل وقول هراء",40,"ا",2,0],["وَلَم أُلِمَّ بِمَكروهٍ ثُريبُهُم","هَذا وَقَد قَرُبوا مِنّي فَلَم بَعَدوا",41,"د",3,0],["وَلَمّا لَو تَأَمَّلَها مُناهُ","وَلا يَسقيهِ مِنهُ حينُ حَينِ",42,"ن",1,0],["ولم ألْقه في الدّهرِ إلا ولِمَّتي","على شعَثٍ والصِدْقُ غيرُ مكَذِّب",43,"ب",1,0],["وَلَم أَلحَهُم أَن يَجوروا عَلَيَّ","وَلَو ذاكَ كُنتُ لَهُم عاذِرا",44,"ر",2,0],["وَلَم أَلقَ بُدّاً مِن إِداءِ فَريضة","فَدونَكَ يا مَولايَ قُبة عَجلان",45,"ن",1,0],["ولم الأشقياء يخفون بلوا","هم ويحيون في خداع ووهم",46,"م",1,0],["ولماّ لم أجِدْ ماءً طَهوراً","أبِيحَ لي التَّيَمُّمُ بالتُّرابِ",47,"ب",1,0],["وَلَم أَلتَمِس بِالعَتبِ إِصلاحَ قَلبه","وَهَل يُشتَرى قَلب امرىءٍ بِخِصامِهِ",48,"م",2,0],["ولمَّا لَقِيتُم من أَرَدْتُم لقاءهُ","رَمَيْتم به الأَهوال أبْعَدَ مُرتمى",49,"م",2,0],["ولما لم يجدْ رُزّيكُ عنه","الى غير الملاذِ به ذَهابا",50,"ب",2,0],["ولم أَلقهُ يوماً وكلي حيالَه","خُشوعٌ كحالي اليومَ لا أملكُ النظر",51,"ر",1,0],["ولم آلُ في إفهامهم أين موضعي","ولكنّهم دقّوا عن الفهم أو قلّوا",52,"ل",3,0],["ولّما لم تَخبْ فيك الأماني","رمى بك حيث لم تنبُ النصالُ",53,"ل",1,0],["ولم ألقَ أشراكا فأَثنى حبالَها","على ما أشتهتْ من أعينٍ وقلوبِ",54,"ب",1,0],["ولمّا لاحَ برقُ الكأسِ ليلاً","ومِن سُدَفِ الظلامِ له صِدارُ",55,"ر",1,0],["ولمّا لم تجِدْ للصُّلْحِ وجهاً","ولا للعَفْوِ عنهُم والنّوالِ",56,"ل",1,0],["ولما لم أجد عندي جزاء","لكم غير الثناء المستطاب",57,"ب",1,0],["ولم ألقَ مِن أبنائِها غيرَ سَيِّدٍ","تَألَّقَ وجهاً بِالبَشاشَةِ والبِشرِ",58,"ر",1,0],["وَلِمَ الصهبَاء إِن لا","بُدَّ لِي مِنك عِتَابا",59,"ب",2,0],["وَلَمّا لم تَنَلْ منّي مَراماً","أحالَتْ شامِتيها حاسدينا",60,"ن",2,0],["وَلمّا لحقنا بالحمولِ عشيّةً","وفيهنّ مودودُ الشّمائلِ أهيَفُ",61,"ف",1,0]]}