id=212553",""],[5804,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=184421",""],[5818,"من أجل ذلك ....","https://www.poetsgate.com/ViewPoem.aspx?id=181545",""],[5829,"يا ثغرها","https://www.poetsgate.com/ViewPoem.aspx?id=147423",""],[5956,"الإعجابُ والحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=182655",""],[6031,"سَقَى الوَسْمِيُّ وَجْهَ أبي عَليِّ","https://www.poetsgate.com/ViewPoem.aspx?id=46403",""],[6243,"مُوَشَّح خليجيّ ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84443&r=&rc=17",""],[6251,"إلى الشيخ جابر الأحمد الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76467&r=&rc=7",""],[6259,"أخذن زمام الدَّمع خوف انسجامه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59398&r=&rc=46",""]],"verses":[["وَلَم أَلقَ مُنفَرِداً في الزَمانِ","يُسائِلُ عَن إِلفِهِ أَينَ سارا",0,"ر",2,0],["وَلَمّا لَم يُلاقوا فيَّ عَيباً","كَسوني مِن عُيوبِهِمُ وَعابوا",1,"ب",3,0],["وَلَمّا لُقيتَ مَعَ المُخطِرينَ","وَجَدتَ الإِلَهَ عَلَيهِم قَديرا",2,"ر",2,0],["وَلَمّا لَقينا خَيلَ أَبجَرَ أَعلَنوا","بِدَعوى لُجَيمٍ غَيرَ ميلِ العَواتِقِ",3,"ق",1,0],["وَلَمّا لَم أَجِد إِلّا فِراراً","أَشَدَّ مِنَ المَنِيَّةِ أَو حِماما",4,"م",2,0],["ولم أَلبَسْك إلّا يوم فخرٍ","ويوم زيارة المَلكِ اللُّبابِ",5,"ب",1,0],["ولمَا لعبدِك واجب","لكن لكونك سيدا",6,"د",2,0],["وَلَمّا لَم نَنل لِلسَيفِ رَدّاً","تَنازَعنا الحَمائِلَ وَالنِجادا",7,"د",2,0],["وَلَم آلُ شُبّانَ البَرِيَّةِ رِقَّةً","كَأَنَّ ثِمارَ القَلبِ مِن وَلَدي ثَمّا",8,"م",2,0],["وَلِمَ التَرَحُّلُ عَن حَيا","ةٍ أَنتَ مِنها في رِكابِ",9,"ب",1,0],["وَلَمّا لَم أَجِد لِلسَيفِ حَدّاً","أَصولُ بِهِ نَصَرتُكَ بِالقَصيدِ",10,"د",1,0],["وَلَمّا لَم نَجِد دَرَكاً لِثاوٍ","وَجَلَّ المَوتُ عَن طَلَبِ الذُحولِ",11,"ل",1,0],["ولم السواد فإنه","عراك من حلل الجمال",12,"ل",1,0],["ولمّا لَم تفز بلقاك عيني","لمحتك آتياً بضمير قلبي",13,"ي",1,0],["ولما لم أجد للحب حلا","هتفتُ به كما يرضيك سِر بي",14,"ب",2,0],["وَلَم أَلتَفِت مِن وَجهِهِ لَيلَةَ السُرى","إِلى فَيلَقٍ يَلقى الظَلامَ بِفَيلَقِ",15,"ق",1,0],["وَلَمّا لَحِقنا بِالحُمولِ تَباشَرَت","بِنا مُفصِداتٌ غابَ عَنها الطَلائِعُ",16,"ع",1,0],["وَلَمّا لَم يَكُن بُدٌّ","وَجَدنا مِنكُمُ بُدّا",17,"د",2,0],["وَلَمّا لاحَ ضَوءُ الصُبحِ عَنّا","وَحَرَّكَ عودَهُ بَدرٌ وَسيمُ",18,"م",1,0],["ولمَ الرهزُ لذيذٌ","عند تكرار العمل",19,"ل",1,0],["وَلَمّا لَحِقناهُم كَأَنّا سَحابَةٌ","مِنَ المُلمِعاتِ البَرقَ حينَ اِستَهَلَّتِ",20,"ت",1,0],["ولمّا لم يُسابِقْهُنّ شَيءٌ","مِنَ الحَيَوانِ سابَقْنَ الظّلالا",21,"ل",2,0],["ولَمْ ألقَ المُنَى في ظلِّ لَهْوٍ","بِأَقمارٍ سَحَائِبُها السّتُورُ",22,"ر",1,0],["ولمَ البحيرةُ مثلما سُجِرتْ","أو فُجِّرتْ من عرقِ منذَبحِ",23,"ح",1,0],["ولِمَ الصباحُ كأنما أنداؤُه","كأسٌ تُصفّقُ أو رحيقٌ يسجمُ",24,"م",1,0],["وَلَم آلُ جُهداً كَما قَد تَرى","وَإِنّي بِتَقصيرِ جَريي مُقِرّ",25,"ر",1,0],["وَلَمّا لَواني البُعدُ عَنهُ ضَرورَةً","ظَعَنتُ إِلَيهِ بِالفؤادِ صَرورَةً",26,"ه",1,0],["ولم آل نصحا في دليل أقمته","وفي حجج جدت لسان المناظر",27,"ر",1,0],["وَلِمَ الشَقائِقُ وَالتِلاعُ لِغَيرِنا","وَلنا الخَطائِطُ قسمُ مَن لَم يَعدِلِ",28,"ل",1,0],["وَلِمَ العَدُوُّ يَرُوحُ قِردَ زُبَيدَةٍ","شَبَعاً وَمُصفِي الوُدّ كَلبَةَ حَومَلِ",28,"ل",1,0],["وَلَمّا لَحِقنا بِالحُمولِ وَدونَهَا","خَميصُ الحَشا تُوهِى القَميصَ عواتِقُه",29,"ق",2,1],["ولم ألق فيها صاحبا ذا بصيرة","يكون لنا عونا بهذا الزمان",30,"ن",1,0],["ولم التفاخرُ بالموائدِ والملاب","سِ والأثاثِ وشاهقِ الجُدرانِ",31,"ن",1,0],["ولمَ التعصّبُ بالمذاهبِ يا بَني الأ","وطانِ وهوَ أساسُ كلِّ هوانِ",31,"ن",1,0],["ولمَ الصدُّ أما آنَ لما","شتّتَ الهجرانُ مني أن يُلَمْ",32,"م",1,0],["وَلَمّا لَقيناهُم بَهنَدفَ جَمعِهِم","أَناخوا وَقالوا إِصبِروا آل فارِسِ",33,"س",1,1],["ولم أُلقِ من ناظري نظرة","إلى منظَر غيرِ منظورها",34,"ر",3,0],["ولم ألق في بيتي دثاراً أُعدُّهُ","لبردٍ ولا شيء يردُّ هجيرا",35,"ر",2,1],["وَلَمَّ الوَرَى شَمْلاً وَكانوا كَأَنَّما","رَغَا وسطَهمْ سَقْبُ السَّماءِ وَما رَغَا",36,"غ",2,0],["وَلَم آلُهُ في الدَّهرِ ما عِشتُ داعِياً","يُؤَمِّنُ حَولي مِن تَلامِذَتي رَهطُ",37,"ط",1,0],["وَلِمَ الأَفراحُ عَمَّت","كُلَّ قَومٍ وَعشيرُهُ",38,"ر",2,0],["ولمَ الركون","يا نفس ما لك تصمتين",39,"ن",1,0],["ولم اليأس يا أخي من حياة","كلها باطل وقول هراء",40,"ا",2,0],["وَلَم أُلِمَّ بِمَكروهٍ ثُريبُهُم","هَذا وَقَد قَرُبوا مِنّي فَلَم بَعَدوا",41,"د",3,0],["وَلَمّا لَو تَأَمَّلَها مُناهُ","وَلا يَسقيهِ مِنهُ حينُ حَينِ",42,"ن",1,0],["ولم ألْقه في الدّهرِ إلا ولِمَّتي","على شعَثٍ والصِدْقُ غيرُ مكَذِّب",43,"ب",1,0],["وَلَم أَلحَهُم أَن يَجوروا عَلَيَّ","وَلَو ذاكَ كُنتُ لَهُم عاذِرا",44,"ر",2,0],["وَلَم أَلقَ بُدّاً مِن إِداءِ فَريضة","فَدونَكَ يا مَولايَ قُبة عَجلان",45,"ن",1,0],["ولم الأشقياء يخفون بلوا","هم ويحيون في خداع ووهم",46,"م",1,0],["ولماّ لم أجِدْ ماءً طَهوراً","أبِيحَ لي التَّيَمُّمُ بالتُّرابِ",47,"ب",1,0],["وَلَم أَلتَمِس بِالعَتبِ إِصلاحَ قَلبه","وَهَل يُشتَرى قَلب امرىءٍ بِخِصامِهِ",48,"م",2,0],["ولمَّا لَقِيتُم من أَرَدْتُم لقاءهُ","رَمَيْتم به الأَهوال أبْعَدَ مُرتمى",49,"م",2,0],["ولما لم يجدْ رُزّيكُ عنه","الى غير الملاذِ به ذَهابا",50,"ب",2,0],["ولم أَلقهُ يوماً وكلي حيالَه","خُشوعٌ كحالي اليومَ لا أملكُ النظر",51,"ر",1,0],["ولم آلُ في إفهامهم أين موضعي","ولكنّهم دقّوا عن الفهم أو قلّوا",52,"ل",3,0],["ولّما لم تَخبْ فيك الأماني","رمى بك حيث لم تنبُ النصالُ",53,"ل",1,0],["ولم ألقَ أشراكا فأَثنى حبالَها","على ما أشتهتْ من أعينٍ وقلوبِ",54,"ب",1,0],["ولمّا لاحَ برقُ الكأسِ ليلاً","ومِن سُدَفِ الظلامِ له صِدارُ",55,"ر",1,0],["ولمّا لم تجِدْ للصُّلْحِ وجهاً","ولا للعَفْوِ عنهُم والنّوالِ",56,"ل",1,0],["ولما لم أجد عندي جزاء","لكم غير الثناء المستطاب",57,"ب",1,0],["ولم ألقَ مِن أبنائِها غيرَ سَيِّدٍ","تَألَّقَ وجهاً بِالبَشاشَةِ والبِشرِ",58,"ر",1,0],["وَلِمَ الصهبَاء إِن لا","بُدَّ لِي مِنك عِتَابا",59,"ب",2,0],["وَلَمّا لم تَنَلْ منّي مَراماً","أحالَتْ شامِتيها حاسدينا",60,"ن",2,0],["وَلمّا لحقنا بالحمولِ عشيّةً","وفيهنّ مودودُ الشّمائلِ أهيَفُ",61,"ف",1,0],["ولما لوانا للواء ولاؤنا","تولى بنا في اللى عن ليلة اللأو",62,"و",1,0],["ولما لها بالحدس عن أحكامه","فألهاه وهم النفس عن إلهامه",63,"ه",1,0],["ولما لبست الصبح أوقد ضوؤه","شهاب جوي بين الأضالع واري",64,"ر",2,0],["ولما لفيف الكرام تنظم","ثيودور بين الجميع تكلم",65,"م",1,1],["ولم ألق أُمَّ العَمرِ سراً ولم أقل","لها مَوهِناً والليلُ قد نام هاجعُهُ",66,"ع",2,0],["وَلَمْ أَلْقَ لي مِنْ شِدَّةِ الْبَيْنِ فَارِجَا","خَيَالِي وَشَوْقي صَارَ مَا بِيَ لاَعِجَا",67,"ج",2,0],["ولمَّا لم يروْا قَبِلاً لديهم","مبارزةً أصاروا الحصن ظهرا",68,"ر",2,0],["ولَم آلُ جُهداً في مُناشَدَتِي لَهُم","عَلَى الدَّارِ عُوجُوا أَيُّها العَجَمُ الصُّهبُ",69,"ب",1,0],["ولما لم أجد ظهراً مطيقا","أحمله اشتياقي والغراما",70,"م",2,1],["ولم ألقَ سوى رعدٌ هراء","وكاسات التياع إرتويت",71,"ت",1,0],["ولم النكول من العداة وشكتي","مشهورة وغرار سيفي ماض",72,"ض",1,0],["ولما لم يسَعْكَ الدهرُ ثَوْباً","قطعتَ لشخصِ مجدِكَ منهُ صُدْرَهْ",73,"ر",2,0],["ولمّا لم يُطق يَثني صباه","أحالَ على شمائله اكتهالا",74,"ل",2,0],["ولمّا لَقينَا عُصبَةً تَغلبيّةً","يَقُودُونَ جُرداً ضُمّرا",75,"ر",2,0],["ولما لم يقمْ للعلمِ وَزْنٌ","فأَصْبَحَ جاهُ حامِله خُمُولا",76,"ل",2,0],["ولما لم يروا للنصر باباً","ولا للفتح نهجاً مستبينا",77,"ن",2,0],["ولما لم تنل بالبغي منِّي","مرادك صرتَ في أقسى الكروبِ",78,"ب",1,0],["ولما لم تنل ما كنت تبغى","عمدت إلى مناوأة الكذوبِ",78,"ب",1,0],["ولما لم أجد منه اتصالاً","صبحت عشيرهُ وقصدت داره",79,"ر",2,0],["ولما لم تقم بأداه فورا","وكان لمعسر الغرماء هينا",80,"ن",2,0],["ولمَ اليوم لا تلبي فقيراً","جبرت كسر قلبه بالنوال",81,"ل",1,0],["ولما لم ننل منهم سروراً","رأينا فيهم كل السرور",82,"ر",1,0],["ولما لقيت الجيش بالجيش مقدماً","بأسد السرى في غابة الأسل السمر",83,"ر",1,0],["ولما لحظتُ العلم ينهضُ عنوة","على نجَب الأوراق أيقنتُ بالبقا",84,"ا",1,0],["ولم ألفَ صَمصاماً بقدرِ عزائمي","ولو جمعوا الأسيافَ عزمي أفضل",85,"ل",1,0],["ولم ألبسك ثوب المديح إلا","وجدتك قد خريت على الطراز",86,"ز",1,0],["ولم ألفَ يوماً أَسيفاً لأَني","صحبتُكَ يا دهرُ مستهزئا",87,"ا",1,0],["ولم الم ادباء العصر ان لهجوا","ذما بشعري فقد اودى بهم قدمي",88,"م",2,0],["وَلم أَلف صَدري مِن فُؤادي بلقعا","إِلا وَأَنتَ مِن الأَحبة بلقع",89,"ع",1,0],["وَلَم أُلقَ يَوماً عِندَ أَمرٍ يَهُمُّني","كَئيباً وَلا جَذلانَ إِن كُنتُ راضِيا",90,"ي",2,0],["ولم النوادب قد برزن نوادباً","كل إلى حسن الثناء تسابق",91,"ق",1,0],["ولما لاح في العليا سناه","نظمت له القوافي من زبرجد",92,"د",1,0],["ولما لم أشاهده يقينا","ولم أرقى إلى أوج المعالي",93,"ل",2,0],["ولما لاح يزهو صحت أرخ","بحسن الآس ورد الخد طرز",94,"ز",1,0],["ولما لاح سوسن عارضيه","وحفت بالرياحين الورود",95,"د",1,1],["ولمّا لم تَعِظْهُ من اللَّيالي","قرائنُ، بعد ما خَلَتِ القُرون",96,"ن",1,0],["ولما لاح مبسمه","وعين الصبح لم تلح",97,"ح",1,0],["ولم الزمنَّ الدمع عيناً كليلة","تغالب خيل الدمع وهو غلوب",98,"ب",1,0],["ولما لم أفز بالوصل منه","ولم أر من مودته نصيبا",99,"ب",2,0],["ولم الوجيد العز رغبة ثروة","تدر بجدواها نفوس خسائس",100,"س",1,0],["ولما لم أطق صبرا عليها","ولو كنت اصطبرت لجننتني",101,"ن",2,0],["ولما لم أجد للنفس منجى","توّسدت الممات ونمت رغدا",102,"د",2,0],["ولما لم أجد في الدرس شيئاً","يغذيني رجعت إلى الطبيعه",103,"ه",1,0],["ولما لم تُصخْ كفي لنصحي","وظلّ لها نِدايَ بلا مجيب",104,"ب",1,0],["ولما للقضاء دعاه داع","هوى صعقا ولباه ابتدارا",105,"ر",2,0],["ولمّا لئيمُ القوم قد صار سيّدا","وجاهلُ علم في المجالس عات",106,"ت",1,1],["ولم ألق كالأحداج يوم وداعه","بعينيَّ لولا البين احسن منظرا",107,"ر",2,0],["ولما لكم طيب البلاد ورعيها","ولي الثّماد ورعيهن المجدب",108,"ب",1,0],["وَلَمّا لَقيتَ التيمَ يَومَ بُزاخَةٍ","وَرَهطَ أَبي شَهمٍ وَقَومَ ابنِ أَصهَبا",109,"ب",2,0],["ولما لم أجد في مصر إِنسي","جعلت توحشي في الناس أُنسي",110,"س",2,1],["ولم أُلْفِهِ فيما رجَوْتُ بمُسْعِفِ","ولمْ يُدْنِ أيامَ الرّضى والتّعطُّفِ",111,"ف",1,0],["ولمْ ألهُ بالحِدْثِ الألَفِّ الذي لهُ","غدائرُ لم يُحرمْنَ فارَ اللطائمِ",112,"م",1,0],["ولمَا لم يظنَّنَا المنتقى المخ","تارَ من ذلك الكلام النضيرِ",113,"ر",1,0],["ولمُ الله في جمالك إن كن","تَ تلاقي في عشق حسنك ذاما",114,"م",2,0],["وَلَم أَلفِ فيهُم مُذ أَلفت مَديحَهُم","سِوى أَريحي مِن كِرام ذَوي عَون",115,"ن",1,0],["ولما لم تَجِش نُفوسُ جيوشٍ","لم لا نكست عليهِ البنود",116,"د",1,0],["وَلم أَلقَ شَيأ لَيسَ يَعقب ضدّه","وَإِن فتنت نَفسٌ لما خَفي الأَمر",117,"ر",1,0],["ولم النوم أبرّاً بالنيام","أيها الجبار أم تخشى العيونا",118,"ن",2,0],["ولم التنافر والتباغض بيننا","والحقد وهي مدارك النقصان",119,"ن",1,0],["ولمالج في الخيلاء زهواً","تزعزع ذلك الملك الجسام",120,"م",1,0],["ولمَّا لم يجد إلا حِماماً","أو الهربَ الأمَرَّ من الحمامِ",121,"م",1,0],["ولم ألبسِ الدرعَ الدّلاصَ مخافة","من الموتِ لكن سنة للمحاربِ",122,"ب",1,0],["ولم ألبث برايةَ في نعيمٍ","ووصلٍ ما ظننتُ له انبتارا",123,"ر",2,0],["ولم ألغِ حرف الراء ألا لأنني","إذا فهت بالراوي تفوهت بالغاوي",124,"ي",1,1],["وَلَمَّا لَدى الزَّانَةِ التَقَيا","على الفَورِ بادَرَ مُبتَدِيا",125,"ي",2,0],["وَلَمَّا لَدى هَكطُورَ في الحالِ بُلِّغا","أَطارَ ذِيُومِيذُ السِنَّانَ فَعَنهُ زَل",126,"ل",1,0],["وَلَم أَلف ذا فَهمٍ وَنَفس شَريفَة","فَيَرتاحُ لِلآدابِ عَن طيبِ مَشرَبِ",127,"ب",1,0],["وَلَم الجزيرةُ والبسيطةُ كلُّها","سوداءُ لم أسطِع أنير ظلامها",128,"م",3,0],["ولما لنحو الحقّ درويشُ قد سرى","تسامى عن البازات والنورُ حاجبُه",129,"ب",2,1],["وَلَمّا لطفها للطرف حيّا","فَقَلبي بعد مَوتٍ عاد حيّا",130,"ي",2,0],["ولم ألتفت في القول للكفر أيهم","ولمَّا رأيت الناس في بحر غيهم",131,"م",1,0],["ولم ألقَ في سنجار من يلتقي به","سوى دلو بئرٍ نازلٍ قعر مظلم",132,"م",1,0],["ولما لج في غي وفسق","قصرنا الهجو فيه بمد صدق",133,"ق",1,0],["ولم ألق علواءَ النَّسيمِ مُسائِلاً","بزفرةٍ محزونِ وأنهِ موجعِ",134,"ع",1,0],["ولما لهذي الأرض قدماً ملأتما","بقَتلاكما ظُلماً إلى الله تبتما",135,"م",2,0],["ولما لم ننل منهم سروراً","رأينا عزلهم كل السرور",136,"ر",1,0],["ولم آل اجتهاداً واحتفالاً","ولكنْ أعيت الحيل البخوت",137,"ت",1,0],["ولمَّا لم يروا في القوم فِعلاً","به قد بان حقٌّ أو صواب",138,"ب",1,0],["ولم ألقى َ أشراكا فأثنى حبالها","على ما اشتهتْ من أعينٍ وقلوبِ",139,"ب",1,0],["ولم ألتذ نفس العي","ش لا طعما ولا شرُبا",140,"ب",2,0],["ولم ألتفت للذي صنته","طويلا مدى العمر حتى درس",141,"س",1,0],["ولما لم أجد وجهت وجهي","إلى من عَدّ ناراً للرجيمِ",142,"م",1,0],["ولم التفرق والحتوف تجمعت","ولم التردد والبلاء مشمر",143,"ر",1,0],["ولِمَ الرجوع إلى طريقٍ","منا انحنى يوم انحنينا",144,"ن",2,0],["ولِمَ الإطالة في البكاء","لمْ تعلمي كم قد بكينا",144,"ن",2,0],["ولم الكلام كفى صدى","وقع اللجام على الصفد",145,"د",1,0],["ولِمَ اللَّومُ واْبنُ جِلْدَتِنَا مِثْلَكِ ..","أَضْحَى ، لَنَا عَدُوّاً مُبِينَا",146,"ن",2,0],["ولمَ العيونُ تضلُّ عن لونِ الضُحى","تُرسي سفينتَنا بشطآنِ الغَسقْ",147,"ق",1,0],["ولم ألق إلا ما علاني فغصت في","صراخي وما جلى الفجيعة والكربا",148,"ب",2,0],["ولم العطل كجهم والذين على","منواله نسجوا ممن طغى فهفا",149,"ف",2,0],["ولما لمحْت بكتْ عبراتي","لإثر خيالات رسمٍ فلولا",150,"ل",2,0],["ولما لم أطق صبراً عليه","أتيت بنيه ملتمساً جوارا",151,"ر",2,0],["ولمّا لم أجد حراً معيناً","على دهري ولا كهفاً وجارا",151,"ر",2,0],["ولمَ السكون وفي خِضمِّ تخبطي","تتلاطم الأمواج تُذكِي أبحرَهْ؟!",152,"ر",2,0],["وَلَمَّا لَثَمْتُ الصُّدْغَ مِنْها تَخَجَّلَتْ","لَدَيَّ وَمِنْهاجُ الوِصالِ رَحِيبُ",153,"ب",1,0],["ولما لمْ أجدْ في الناسِ فردا","توارى الفضلُ واستترَ الكمالُ",154,"ل",1,0],["ولِم التأسّفُ إنّهُ الحسدُ الذي","ما زال ينخرُ في النفوسِ تعمَقا",155,"ق",2,0],["ولما لاح في علياك نجمي","وكان الصبح قد كشف الحجابا",156,"ب",2,0],["ولم أُلْقِ سيفي في مضاميرِ سبْقِها","ولم يعْثُرَنْ في المعْمَعانِ جوادي !",157,"د",2,0],["ولمَ الكبيرُ وفاؤهُ سيخونه","وتموتُ فيه براءةٌ وجمالُ؟",158,"ل",1,0],["ولم ألقَهُمْ إلّا على النومِ ساعةً","فعانقتُ طيفًا مرَّ بالروحِ ساريا",159,"ي",2,0],["ولمَ الرُعاةُ يُقَطَّعونَ ب موطني","ترَفٌ هنا أنْ نلبسَ الأكفانا",160,"ن",2,0],["ولما لثمت الجلّنارَ وما به","إلا وزاد تألقا وبريقا",161,"ق",2,0],["ولم ألق يوما لو شبيهة مجدها","ولا اندفعت روحي لمثل عرينها",162,"ن",3,0],["ولَمَّا لَمْ أَزُرْ نَادِيهِ عَجْزاً","بَعَثْتُ لَهُ بِزَهرِ الرَّازِقِيّ",163,"ي",1,0],["ولمَ الطّريق إلى المَدائن شائك ؟","أهيَ القبيلة تسْتَعيدُ مُقاتِلا ؟",164,"ل",2,0],["وَلَمْ أَلْقَ إِلاَّ فِيْكَ نَفْسَاً مُضِيْئَةً","يُتَاحُ لَنَا مِنْهَا الضّيَاءُ وَيُوْهَبُ",165,"ب",1,0],["ولم ألتمس بالعتب إصلاح قلبه","وهل يشترى قلب امرئ بخصامه",166,"م",2,0]]}