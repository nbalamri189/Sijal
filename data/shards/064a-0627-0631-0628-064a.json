تي السائحة النائحة في إيطاليا والمتفضلين على الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=203551",""],[5961,"اضرب عن الناس","https://www.poetsgate.com/ViewPoem.aspx?id=199763",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[5976,"شفته مع الصبيان","https://www.poetsgate.com/ViewPoem.aspx?id=32095",""],[5976,"شياطين الفضا","https://www.poetsgate.com/ViewPoem.aspx?id=32795",""],[5977,"فيروس كورونا","https://www.poetsgate.com/ViewPoem.aspx?id=213293",""],[6004,"في مجون اللهو","https://www.poetsgate.com/ViewPoem.aspx?id=33759",""],[6008,"يالله يلي معتلي في سماكا","https://www.poetsgate.com/ViewPoem.aspx?id=60805",""],[6082,"تأملات","https://www.poetsgate.com/ViewPoem.aspx?id=60244",""],[6089,"النبي الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=213039",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[456,"عروس الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84502&r=&rc=1",""],[6202,"انفض السامر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86710&r=&rc=11",""],[6202,"استبد الهوى عشقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86702&r=&rc=3",""],[6202,"دنيا عجائب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86721&r=&rc=22",""],[6202,"ضمّدْ جراحك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86732&r=&rc=33",""],[6237,"يا ربيع الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77871&r=&rc=13",""],[6237,"عودة إلى الطبيعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77860&r=&rc=2",""]],"verses":[["يا رب يوم للمحاماة احتمت","فيك الحقوق به فكنت وفاءها",0,"ا",3,0],["يا رُبَّ يَومٍ ضاقَ ذَر","عُكَ فيهِ بِالحُسُدِ الغِضابِ",1,"ب",1,0],["يا رَبيعَ العَينِ إِلّا","أَنَّهُ مَرعىً مَنيعُ",2,"ع",1,0],["يا رُبَّ يَومٍ أَتَت بُشراهُ مُقبِلَةً","ثُمَّ اِستَحالَت بِصَوتِ النَعيِ بُشراهُ",3,"ا",2,0],["يا رُبَّ يَومٍ رَأَيتَني مَرِحاً","أَخوصُ في اللَهوِ مُسبِلَ المِئزَر",4,"ر",1,0],["يا ربيعاً جمل الله به","روضة الدنيا ووقاها الخريف",5,"ف",1,1],["يارُبَّ يَومٍ يَكونُ الناسُ في رَهَجٍ","بِهِ تَراني عَلى نَفسي مُكاويها",6,"ي",3,0],["يا رُبَّ يَومٍ تَلوحُ غُرَّتُهُ","ساطِعِ صُبحِ المَعروفِ مُنصَدِعِه",7,"ع",2,0],["يا رَبُّ يَومٍ قَد مَضى","بِالقادِسيَّةِ لَو يَدومُ",8,"م",1,1],["يا رُبَّ يَومِ سُرورِ","بِالمَهدِ زارَ قَصيرِ",9,"ر",1,1],["يا ربي لا تتركي ورداً","ولا تبقي أقاحا",10,"ح",2,1],["يا رَبِّ يا رَبَّ كُلِّ شَيءٍ","خُذ لي مِنَ الظالِمينَ حَقّي",11,"ق",2,0],["يا رب يوم فيه قد وفدتْ على","مصرٍ، ومصرُ كثيرة الوفاد",12,"د",1,0],["يا ربُ يوم مرَّ ما ظفر امرؤٌ","فيه بطيف الزاد أو بفُتاته",13,"ت",2,0],["يا رُبَّ يوم فيه مصرُ وسُوريَا","ردَّا «التَّتَارَ»؛ فكان يومًا أبْلَقَا",14,"ق",2,0],["يا رُبَّ يوم جيشُ مصرَ وسوريا","صدَّا الصَّليبيِّن فيه فوفِّقا",14,"ق",2,0],["يا رُبَّ يومٍ مصرُ فيه قاومَتْ","جيشًا من الدُّول الثلاثِ ملفَّقَا",14,"ق",2,0],["يا رب يوم بَرَّزَتْ بعلومِها","«بغدادُ» فيه؛ فأصْبَحَتْ أم القرى",15,"ر",2,0],["يا ربيع الحبّ لاقتك المنى","تحتسي من جوّك سحرا",16,"ر",2,0],["يا ربيع الحبّ يا فجر الهوى","ما أحيلاك وما أشذاك نشرا",16,"ر",2,0],["يا ربى القدس وما أندى الرّبى","دمنا فيها ربيع ونماء",17,"ا",2,0],["يا ربّ يا ربّ يا ربّ الأنام ومن","إليه مفزعنا سرا وإعلانا",18,"ن",2,1],["يا رب يا ربّ البرايا زدهم","صبرا ونصرا دائما بتكمّل",19,"ل",1,0],["يا رب يا مولاي وابقهم قذي","في عين من هو كافرٌ بالمرسل",19,"ل",1,0],["يَا رُبَّ يَوْمٍ حَجَرْنا في مَحاجِرِنا","مَاءَ العُيُونِ وَأَمْطَرْنا الخُدودَ دَمَا",20,"م",2,0],["يارب يحيى نائب لك في الورى","وخليفة لا ظن فيها فيك يخيّبُ",21,"ب",1,0],["يا رب يحيى إِن يحيى للسخا","أحيا رسوماً قد ذهبنَ زوالا",22,"ل",2,0],["يا رب يحيى قد علمت بأنه","بعطاه وسع كل عيش ضنك",23,"ك",1,0],["يا رب يا ديان يارحمن يا","حنان يا منان يا الله",24,"ه",1,0],["يا ربِّ يا رزّاقُ يا قهّارُ","يا ربِّ يا وهّابُ يا غفّارُ",25,"ر",1,0],["يا رُبَّ يومٍ واضحٍ نضَّرْتُهُ","بمهفهفٍ طاوي الحَشا وَضَّاحِ",26,"ح",1,1],["يا ربيع القلوب يا قرة العي","ن وباب الإحسان والنعماء",27,"ا",2,0],["يَا رَبِّ يَا مَوْلاَيْ","يَا سَامِعاً نَجْوَايْ",28,"ي",1,0],["يا رَبيبَ النَدى وتِربَ المَعالي","وأَديب