","الوافر"],[443,"النصر حزبك في الضلالة فاحتكم","https://www.aldiwan.net/poem34807.html","الكامل"],[443,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[445,"ألا مبلغ عني بشير بن جمعة","https://www.aldiwan.net/poem14425.html","الطويل"],[451,"قد أسمع القلب داعي الحب حين دعا","https://www.aldiwan.net/poem53812.html","البسيط"],[452,"مدى كتابك غابات وأنهار","https://www.aldiwan.net/poem983.html",""],[454,"اهل افغانستان","https://www.aldiwan.net/poem23875.html","الطويل"],[461,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[461,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[461,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[461,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[461,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[461,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[461,"أقريش لا فلم أراك ولا يد","https://www.aldiwan.net/poem56235.html","الكامل"],[461,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[464,"وفتيان صدق من تميم تناثلوا","https://www.aldiwan.net/poem15083.html","الطويل"],[464,"أقرب من قولك يا عمرو","https://www.aldiwan.net/poem15119.html","السريع"],[464,"رعى الله نجرا زينبيا تألقت","https://www.aldiwan.net/poem15164.html","الطويل"],[464,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[464,"حباه إله العرش جودا ونجدة","https://www.aldiwan.net/poem16115.html","الطويل"],[482,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[498,"وفتية كنجوم الليل مسعدة","https://www.aldiwan.net/poem10247.html","البسيط"],[498,"ما للخزامى تعود نسرينا","https://www.aldiwan.net/poem10279.html","المنسرح"],[503,"خذ شهودا عن شهود الكائنات","https://www.aldiwan.net/poem38068.html","الرمل"],[503,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[508,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[517,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[518,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[518,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[543,"فان معشر بخلوا والتووا","https://www.aldiwan.net/poem56907.html","المتقارب"],[554,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[554,"أفي كل وم لي منى أستجدها","https://www.aldiwan.net/poem47870.html","الطويل"],[554,"أضن بنفسي عن هوى البيض كلما","https://www.aldiwan.net/poem48038.html","الطويل"],[556,"إذا التقينا منعنا النوم أعيننا","https://www.aldiwan.net/poem68284.html","البسيط"],[556,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[556,"يا عين جودي بدمع منك مدرار","https://www.aldiwan.net/poem68400.html","البسيط"],[561,"يا من غفلتم وجوهكم سود","https://www.aldiwan.net/poem34568.html","المنسرح"],[562,"تأدب بباب الدير واخلع به النعلا","https://www.aldiwan.net/poem69348.html","الطويل"],[566,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"حتى خيالك لا وفى ولا وافى","https://www.aldiwan.net/poem3051.html","البسيط"],[854,"","https://poetry.dctabudhabi.ae/diwan/poem/29471","الوافر"],[967,"","https://poetry.dctabudhabi.ae/diwan/poem/29446","الوافر"],[1073,"","https://poetry.dctabudhabi.ae/diwan/poem/18746","الوافر"]],"verses":[["أَقرَضوني مِن عِزِّهِم","وازِنَ القَدرِ وافِيا",0,"ي",2,0],["أَقَرُّ عَينِ الفاقِدِ المُرِنِّ","عَسايَ أَنفي الضَيمَ أَو لَعَنّي",1,"ن",2,0],["أَقرِ السَلامَ فَتىً تَخاوَصُ هَيبَةً","عَنهُ عُيونُ تَحِيَّتي وَسَلامي",2,"م",2,0],["أَقَرَّ بِحَقِّ المَجدِ وَهوَ مُضَيَّعٌ","وَعَظَّمَ قَدرَ الدينِ وَهوَ ضَئيلُ",3,"ل",1,0],["أَقرِ عَنّي السَلامَ أَهلَ المُصَلّى","وَبَلاغُ السَلامِ بَعدَ التَلاقي",4,"ق",2,0],["أُقُرُّ بِلُبسِهِ وَلقَد أَراني","أُجاحِدُهُ إِباءً وَاِمتِعاضا",5,"ض",2,0],["أَقرُبُ بِالوُدِّ وَيَنأى بِهِ","وَيلي عَلى بُعدِكَ مِن قُربِ",6,"ب",1,0],["أُقُرِّطُها الأعِنَّةَ في مُلاءٍ","يُنَشِّرُها مُثارُ النَّقْعِ دُكْنِ",7,"ن",1,0],["أَقَرُّ الناسَ كُلِّهِمُ لِعَيني","يَرى قَتلي يَتِمُّ بِهِ السُرورُ",8,"ر",1,1],["أَقَر اللَهُ عَيني أَن أَراني","أَعيشُ وَحُبُّنا مَحضٌ صَريحُ",9,"ح",1,0],["أُقِرُّ لَكَم بِالذَنبِ مِنّي مَخافَةً","مِنَ الهَجرِ لَمّا رُمتِ أَن تُخلِقي الحُبّا",10,"ب",2,0],["أقْرَضْتُ فيكَ اللهَ صِدْقَ محبّتي","أيَكونُ تَجْري فيكَ غيرَ رَبيح",11,"ح",1,0],["أَقَرَّ عَينَيكَ في دُنياكَ أَن رَأَتا","مُحَمَّداً يَتَراءى فَوقَ كيوانِ",12,"ن",1,0],["أَقرِضوا اللَهَ يُضاعِف أَجرَكُم","إِنَّ خَيرَ الأَجرِ أَجرٌ مُدَّخَر",13,"ر",1,0],["أَقَرَّ عَينِيَ أَنّي قُمتُ أُنشِدُكُم","في مَعهَدٍ بِحُلى العِرفانِ مُزدانِ",14,"ن",1,0],["أَقَرَّ حَشا اِمرِئِ القَيسِ بنِ حُجرٍ","بَنو تَيمٍ مَصابيحُ الظَلامِ",15,"م",1,0],["أَقَرَّ اللَهُ عَيني إِذ دَعاني","أَمينُ اللَهِ يَلطُفُ في السُؤالِ",16,"ل",1,1],["إقرار غير جاحد","واللَه خير شاهد",17,"د",1,1],["أَقَرَّ حَاضِرَهُ وَبَادِيَهُ","مَا أَنْفَعَ العَدْلَ مُقْرُوناً بِإِحْسَانِ",18,"ن",1,0],["أَقْرَانُكَ الأَمْجَادُ فِي الشَّيبِ الأُولَى","يَرْعَوْنَهَا وَبَنُوكَ فِي الفِتْيَانِ",19,"ن",1,0],["أَقْرَضَ اللهَ كُلَّ قَرْضٍ جَمِيلٍ","فَجَزَاهُ أَضْعَافَهُ الرَّحْمَنُ",20,"ن",1,0],["أَقَرَّ بِالخُطَّةِ المُثْلَى مَكَانَتهُ","بِحَيْثُ يَرْسَخُ وَالأَطْوَادُ تَنْقَضِمُ",21,"م",1,0],["أَقرَمُ في الإِبلِ تِلادا مُتلَدا","مُقابِلاً في نَجبِها مُرَدَّدا",22,"د",2,0],["أَقري الهُمومَ إِذا سَرَت عيدِيَّةٍ","يُرحَلنَ حَيثُ مَواضِعُ الأَحناءِ",23,"ا",2,0],["أَقرَرتُ في الحُبِّ بِما تَدَّعي","فَلَستُ مُحتاجاً إِلى شاهِدِ",24,"د",1,0],["أُقِرُّ لَهُ بِالذَنبِ وَالذَنبُ ذَنبُهُ","وَيَزعَمُ أَنّي ظالِمٌ فَأَتوبُ",25,"ب",1,1],["أَقَرَّ العَينَ أَن عُصِبَت يَداهُ","وَما إِن تُعصَبانِ عَلى خِضابِ",26,"ب",1,0],["أُقرُّ على نفسي بعيبي لأنني","أرى الصدقَ يمحو بَيّنات المعايبِ",27,"ب",1,0],["أقُرَّةَ عيني قدْ أطَلْت بُكاءها","وغادرْتها أقْذَى من الأعينِ الرُّمدِ",28,"د",1,0],["أقُرَّةَ عيني لو فَدَى الحَيُّ مَيِّتاً","فَدَيْتُك بالحَوْبَاء أَوَّلَ من يَفْدِي",28,"د",2,0],["أقريهما كلَّ من عاداك لا حَرَجاً","من قتلهم بين مضروبٍ وموخوز",29,"ز",1,0],["أقْرضْتُهُ قرض سُوءٍ","فهَمُّه ردُّ قرضي",30,"ض",2,0],["أقر عينيَّ في ليلي وصبَّحني","وجداً أفاضهما بالماء شفّافا",31,"ف",2,0],["أقران ظهرك أو فاب","غ من حذارى نُفيقا",32,"ق",2,0],["أقِرْدٌ مُقعَدٌ وتَعِفُّ أنثى","له كلا وإفكِ مُعَلّليكا",33,"ك",2,0],["أقرْنَ صديقنا الحسن بن موسى","علوْتَ فليس خطْبٌ يرتقيكا",33,"ك",2,0],["أقرضتُه أيراً فردَّ لساناً","وكذاك يفعل من غدا قرنَانا",34,"ن",2,1],["أقْرِنْ إلى حُسْنِ وجهكَ الحسنِ","فعلكَ وانظُرْ بعين ذي فطنِ",35,"ن",1,1],["إِقرَأ سَلامي عَلى مَن لا أُسَمّيهِ","وَمَن بِروحي مِنَ الأَسواءِ أَفديهِ",36,"ي",2,1],["أَقَرَّ بِها جَأشي بِأَوَّلِ آيَةٍ","وَماضٍ حُسامٍ غِمدُهُ مُتَطايِحُ",37,"ح",1,0],["اقرأه واقرأ سجايا اوليه تجد","ما شئت من نسب حمد ومن حسب",38,"ب",1,0],["اقرأه في دولة التجديد منفردا","حيث اسمه لكتاب الشعر عنوان",39,"ن",1,0],["اِقرَإِ التاريخَ إِذ فيهِ العِبَر","ضاعَ قَومٌ لَيسَ يَدرونَ الخَبَر",40,"ر",1,0],["إِقرَأوها يُكشَفُ العَصرُ لَكُم","كُلُّ عَصرٍ بِرِجالٍ وَسِيَر",41,"ر",1,0],["أَقَرَّ جِلدي بِها عَلَيَّ فَلا","أَقدِرُ حَتّى المَماتِ أَجحَدُها",42,"د",3,0],["أَقَراراً أَلَذَّ فَوقَ شَرارٍ","وَمَراماً أَبغي وَظُلمي يُرامُ",43,"م",1,0],["أُقِرُّ بِما لَم أَجنِهِ مُتَنَصِّلاً","إِلَيكَ عَلى أَنّي أَخالُكَ أَلوَما",44,"م",2,0],["أَقَرَّت لَهُ بِالفَضلِ أُمَّةُ أَحمَدٍ","فَدانَ لَهُ مُعوَجُّها وَقَويمُها",45,"م",3,0],["أَقَرَّ عَلى نُزولِ الخَطبِ جَأشاً","وَأَوضَحَ تَحتَ حادِثَةٍ جَبينا",46,"ن",2,0],["أَقرى الحَوادِثَ إِن حَلَلنَ تَجَلُّداً","وَأَعُدُّ شَأنَ عَشيرَتي مِن شاني",47,"ن",2,0],["أقرانُه تَنكِلُ عن بِرازِه","يُبادِرُ الفُرصةَ في انتهازِه",48,"ز",2,0],["أقررتُ في شُكرِكَ بالتَّقصيرِ","إذ زِدْتَ في البِرِّ على التَّكثيرِ",49,"ر",1,1],["إِقرَأ كِتابَكَ وَاِعتَبِرهُ قَريباً","فَكَفى بِنَفسِكَ لي عَليكَ حَسيبا",50,"ب",2,1],["أَقَرَّ بِمُهجَتي لَكُمُ لِساني","وَذاكَ بِصِحَةٍ وَجَوازِ أَمرِ",51,"ر",1,1],["أَقرَّ فيها أُناساً في مَواطِنِهم","لمّا تَنادَوْا لِتَوْديعٍ ومرتحلِ",52,"ل",1,0],["أقرَى الملوك يداً وأرفع ذِمَّةً","وأجلّ منقبةً وأكرمُ عُنْصُرا",53,"ر",2,0],["إِقرَ السَلامَ عَلَيكَ مِنّي كُلَّما","جَرَتِ الرِياحُ فَأَنشَقَتكَ نَسيما",54,"م",2,0],["أَقَرّوا لَعَمري بِحُكمِ السُيوفِ","وَكانَت أَحَقَّ بِفَصلِ القَضاءِ",55,"ا",2,0],["أَقَرمَ بَكرٍ تُباهي أَيُّها الحَفَضُ","وَنَجمَها أَيُّهَذا الهالِكُ الحَرَضُ",56,"ض",1,1],["أَقَرَّ عَمودَ الدينِ في مُستَقَرِّهِ","وَقَد نَهَلَت مِنهُ اللَيالي وَعَلَّتِ",57,"ت",1,0],["أَقري السَلامَ مُعَرَّفاً وَمُحَصِّباً","مِن خالِدِ المَعروفِ وَالهَيجاءِ",58,"ا",2,0],["إِقرَء عَلى أَهلِ البَقيعِ مِنِ اِمرِئٍ","كَمِدٍ عَلى أَهلِ البَقيعِ سَلاما",59,"م",2,0],["أَقَرَّت مَعَدٌّ أَنَّنا خَيرُها جَدّي","لِطالِبِ عُرفٍ أَو لِضَيفٍ مُحَمَّلِ",60,"ل",1,0],["اِقرَأ عَلى الجِزعِ السَلامَ وَقُل لَهُ","سُقّيتَ مِن سَبَلِ الغَمامِ المُمطِرِ",61,"ر",1,0],["اِقرَأ عَلى الوَشلِ السَلامَ وَقُل لَهُ","كُلُّ المَشارِبِ مُذ هَجَرتَ ذَميمُ",62,"م",1,1],["اِقرَ السَلامَ عَلى لَيلى وَحَقَّ لَها","مِنّي التَحيَّةُ إِنَّ المَوتَ قَد نَزَعا",63,"ع",2,0],["أقَرُّوا المُلكَ فاستعلت ذُراه","وهمّوا بالخلافةِ ناهضينا",64,"ن",2,0],["إقرأه مُتَّئِداً عليهم وَادْعُهم","أن يتبَعوكَ إلى التي هِيَ أقْوَمُ",65,"م",1,0],["اقرأ كِتابَ أخيكَ مالك مصرفٌ","عمّا يُريدُ ولن ترى الإحجاما",66,"م",2,0],["إقرأ القرآن وَاتْبَعْ هَدْيَهُ","يا عُميرَ الخيرِ إنْ ذو الغَيِّ حادا",67,"د",2,0],["أَقربي مِن فمي","فَحَديثي شجون",68,"ن",1,0],["أَقَرَّت تَميمٌ لِاِبنِ دَحمَةَ حُكمَهُ","وَكانَت إِذا سيمَت هَواناً أَقَرَّتِ",69,"ت",1,0],["أَقرَرتُ أَنِّيَ مَجنونٌ بِحُبِّكُمُ","وَلَيسَ لي عِندَكُم عُذرُ المَجانينِ",70,"ن",1,0],["أَقَرَّ عُروشَها بِثَرىً وَطَيءٍ","وَأَنهارٍ كَحَيّاتٍ سَوارِ",71,"ر",1,0],["أقرب رحمى إلى البرية من","أنسابها في ذُرى قبائلها",72,"ل",3,0],["أُقِرُّ بِالذَنبِ وَلَم آتِهِ","خَوفاً مِنَ الهَجرِ وَلَوعاتِهِ",73,"ت",2,1],["أَقَرَّ بي كِتابُهُ المَنشورُ","وَأَنا مِن رُؤيَتِهِ مَذعورُ",74,"ر",1,0],["أَقَريبٌ مَزارُهُ","أَم مَعَ النَجمِ قَد طَمَح",75,"ح",1,0],["أَقَرّوا بِالإِلَهِ وَأَثبَتوهُ","وَقالوا لا نَبِيَّ وَلا كِتابُ",76,"ب",1,1],["أَقرَرتُ بِالجَهلِ وَاِدَّعى فَهَمي","قَومٌ فَأَمري وَأَمرُهُم عَجَبُ",77,"ب",1,0],["أُقِرُّ بِأَنَّ لي رَبّاً قَديراً","وَلا أَلقى بَدائِعَهُ بِجَحدِ",78,"د",1,0],["أَقرِضينا في المَحلِ مُدّاً بِصاعٍ","وَاِترُكينا مِن فَرطِ هَذا الشَمّاسِ",79,"س",1,0],["إِقرَأ كَلامي إِذا ضَمَّ الثَرى جَسَدي","فَإِنَّهُ لَكَ مِمَّن قالَهُ خَلَفُ",80,"ف",1,0],["أَقَرَأنا مِنها السَلامَ الكَرى","وَكَم أَبادَ الحَتفُ أَقرانا",81,"ن",2,0],["أَقراني ذاكَ المُضَيِّفُ ما أَك","رَهُ وَاللَهُ غالِبُ الأَقرانِ",82,"ن",1,0],["أقرَّ بالتَّشييدِ والتَّأسيسِ","في الجبَلِ النَّامي إلى عَمروسِ",83,"س",1,0],["أَقَرَّتْ بِهِ نَجْرَانُ ثُمَّ حَبَوْنَنٌ","فَتَثْلِيث فَالأَرْسَانُ فَالقَرَظَانِ",84,"ن",1,0],["أقرضت عمراً فما صنعت به","سوف يرد الأنام ما اقترضوا",85,"ض",3,0],["اقْرَ السَّلامَ على الأَصْحَابِ أَجْمَعهم","وخُصَّ عَمْراً بأَزْكَى نُورِ تَسْلِيمِ",86,"م",1,1],["أَقَرَّ النَّوَاظِرُ تَهْذِيبُهَا","وَتَدْرِيبُهَا المُونِقُ المُحْكَمُ",87,"م",1,0],["أَقْرِرْ مَقَامَكَ حَيْثُ شِئْتَ فَإِنَّه","لَنَتِيجَةٌ مِنْ ذَلِكَ الإِقْرَارِ",88,"ر",1,0],["أَقْرِيءِ الْقَوْمَ سَلاَمِي وَاعْتِذارِي","حَجَبَتْني عِلَّةٌ فِي عُقْرِ دَارِي",89,"ر",2,1],["أقْرَرْتَ عَينَ العَصْرِ حِينَ أَرَيْتَهُ","حِلمَ الكُهُولِ وَأَنْتَ غَضُّ إِهَابِ",90,"ب",1,0],["أَقَرَّ اللهُ عَيْنَيْهِ بِنَجْلٍ","مُرَجَّى لِلْسَعَادَةِ فِي الحَيَاةِ",91,"ه",1,0],["أَقَرَّتْ عُيُونَ الْجَاهِ فِيكَ لُيَيْلَة","مُطَرَّدَةُ الأَشْجَانِ مَوْمُوقَةُ السُّهْدِ",92,"د",1,0],["أَقَرَأْتَ فِي الطَّيَرَانِ آيَاتٍ لَهُ","يَجْدُرْنَ بِالتَّرتِيلِ وَالإِقْرَاءِ",93,"ا",2,0],["أَقْرأُ فِي خَدِّهِ كتابَ هوىً","أَنَّ دمَ العاشِقينَ مَطلولُ",94,"ل",1,0],["أَقُرَّةَ أَعيُنِ الأَشرافِ فهرٍ","وَجَدُّكَ مِنهُمُ المَحض الصَريحُ",95,"ح",1,0],["أقررتُ فيه بعيب لست أعرفهُ","وربما استبطن الإقرارُ إنكارا",96,"ر",2,0],["اقرئيها لا تحجب الخلد عني","انشريها لا تتركيني أموت",97,"ت",1,0],["إِقْرَأْ كِتَابَ اللِه جُهْدَكَ وَاتْلُهُ","فيمَنْ يَقومُ بِهِ هناكَ ويَنْصِبُ",98,"ب",1,0],["إقرأ على \" مصر \" السلامَ وقل لها","حَيَّتْ رباكِ روائحٌ وغوادي",99,"د",2,0],["أقَرَّ حَشا امرِىء القَيسِ بنِ حُجرٍ","بنُو تَيْمٍ مَصَابِيحُ الظّلامِ",100,"م",1,0],["إقرئيني.. كلّما فتّشتِ في الصحراء عن قطرة ماءْ","إقرأيني.. كلّما سدّوا على العشّاق أبوابَ الرجاءْ",101,"ا",2,1],["((أقراص النّوم تبيع له","أهدابا … وهدوءا يقظان ))",102,"ن",1,0],["إقرأ كلامي وابسم حين تقرؤه","وإن يكن لك تحبيري وإنشائي",103,"ا",2,0],["أقرع السن نادماً وأذم الد","دهر ذمّاً ولات حين عزاء",104,"ا",2,0],["أقر الحبيب سلاميه","نفسي فدته وماليه",105,"ل",3,0],["أقرّ لهُ بالغدى شهرةً","وفضلَ المساعِي جميعُ الأنامْ",106,"م",1,0],["أَقَرَّ العَينَ أَن عَصَبَت يَداها","وَما إِن يُعصَبانِ عَلى خِضابِ",107,"ب",1,1],["اقَرَّبِهِ المَولَى عُيونَ أُولِى الهُدَى","وأقذَى بِهِ حِزبَ الضَّلاَلِ عُيونَا",108,"ن",2,0],["أقرّ بما جمعت من المعالي","جميعُ الناس من قاص ودانِ",109,"ن",1,0],["إِقرَ مِنّي عَلى الوَليدِ السَلاما","عَدَدَ النَجمِ قَلَّ ذا لِلوَليدِ",110,"د",1,1],["أَقَرَّ جَداكَ عُيونَ المُنى","وَأَحيا اِرتِياحُكَ مَيتَ الأَدَب",111,"ب",1,0],["أَقرَرتَ عَينَيهِ بِإِقرارِ الهُدى","فَحَباكَ ما قَرَّت بِهِ عَيناكا",112,"ك",2,0],["أَقَرَّت لآياتٍ لَهُ وَدَلائِلِ","بِها الصُبحُ طَلقٌ وَالطَريقُ موطأُ",113,"ط",2,0],["إِقْرارُ دَمْعي بالهَوى مِلءَ الهَوى","فَضَحَ استِتاري في الهَوى وَجُحُودي",114,"د",2,0],["أقر وأرسا من قواعد يذئل","وأقطع حدا من شفار الصوارم",115,"م",1,0],["أقر عيون المجد ربك والعلا","بدولتك الغرا التي مالها حد",116,"د",1,0],["اقرت رؤساً في الطلا هذه الرسل","وهذي الهدايا والتلطف والبذل",117,"ل",1,1],["اقرعيون أهل الأرض فيه","سرور لم يدع في الأرض حزنا",118,"ن",2,0],["اقرا الرسالة وانظر ما زهادتهم","مما لديكم على الدنيا من الكلب",119,"ب",1,0],["أَقَرَّ بِفَضلِ الفَضلِ بادٍ وَحاضِرٌ","وَساقَ إِلَيهِ الشُكرَ حافٍ وَناعلُ",120,"ل",1,0],["أقرّ أهل السجون عن ثقة","بفضله في جميع بلدانه",121,"ن",2,0],["أَقرَّ يعربُ بالسَّبْقِ المبينِ لها","وأَجْمَعَ الرأيَ في تفضيلها العرب",122,"ب",1,0],["أقرَّت نجومُ الحسن أنك بدرُها","وأنك في روض المحاسن زهرُها",123,"ر",3,1],["أقريبٌ أنت مني أم بعيد","أيها الجائدُ بالحب السعيد",124,"د",1,1],["أقرّ ولم ينكر وقال مورياً","صدقتم بعيني قد رأيت سقامه",125,"ه",1,0],["إِقرِبي ما اِستَطَعتِ من كُبِر نَفسي","أَنا صدري رحبٌ وَقَلبي كَبيرُ",126,"ر",1,0],["إِقرَبي إِقرَبي فَآلامُ نَفسي","جمرَةٌ يستَطيرُ مِنها السَعيرُ",126,"ر",1,0],["أَقريبٌ من دَنفٍ غَدهُ","فَاللَيلُ تَمرَّدَ أَسودُهُ",127,"د",2,1],["أقِرّوا لنا يا آل عبّاسَ بالعُلا","فلستمْ لها يا آلَ عبّاسَ أكسَبا",128,"ب",2,1],["أقرّ لوجهكِ القمر المنيرُ","وذلَّ لقدّك الغصن النضيرُ",129,"ر",1,1],["أقرّت لك الأيام بالبأس والندى","وزالت لك الأملاك طرّاً عن الفخر",130,"ر",1,0],["أقرّ بأن الله جلّ ثناؤه آله","قديم قاهر مترفع",131,"ع",1,0],["أَقرّ لَهُ من كُلِّ حُسنٍ جَليلُهُ","وَوافَقَهُ مِن كُلِّ مَعنىً دَقيقُهُ",132,"ق",2,0],["أَقْرَأَنَاهَا بِتَحْقِيقٍ أَخُو ثِقَةٍ","فِي وَجْهِهِ مِنْ سُطُوعِ الْبِشْرِ أَنْوَارُ",133,"ر",1,0],["اقرأ كتاب باسم ربك واجنِ من","آياته وحُلاه كل ثمين",134,"ن",1,0],["أَقَرَّ وِقاعي أَنفُساً لَيسَ بينَها","وَبَينَ حياضِ المَوتِ للشَربِ منهَلُ",135,"ل",1,0],["أَقَرَرتُ عَيني مِن أُلَ","ئِكَ فَوائِحِ بِالعَبيرِ",136,"ر",1,0],["أقررت أني جَزَّارُ كما ذكروا","عَنِّي فهل غَيرُ هذا القول عندَهُمُ",137,"م",1,0],["أَقَرَّ لَه بِالفَضل شانيه راغِماً","مَتّى يسبِقِ الاجماعُ تتحِد الفَتوى",138,"و",2,0],["اقرع سنى ندامة ومتى","ينتفع المرء من تندمه",139,"م",2,0],["أَقَرَّ مهيناً مَنْ تَخَمَّطَ ضِلَّةً","وَقَرَّ علَى الإِذْعانِ والهونِ مَنْ طَغَا",140,"غ",2,0],["أَقَّرَّ ذَوُو الآدابِ طُرّاً لِمَنْطِقِي","وَغَيْرُهُمُ فِيما حَكى كاذِبُ الزَّعْمِ",141,"م",1,0],["أَقْرَضْتَنِي حُسْنَ الصَّنِيعِ تَبَرُّعاً","وَالْقَرْضَ أَفْضَلُ مِنْ جَزاءِ الْمُقْرِضِ",142,"ض",1,0],["أَقَرَّت بِتَفضيلِهِ في الأَنامِ","عَلى الأُمراءِ مُلوكُ الشَآمِ",143,"م",1,0],["أَقرِ نَجداً وَمَن بِنَجدٍ سَلامي","إِنَّ نَجداً مَأوى غَريمِ غَرامي",144,"م",2,1],["أَقررتَ أَعينَ من بها بنزاهَةٍ","حلَّتكَ في سنِّ الصِبا بحُلاها",145,"ا",3,0],["أَقرَّ له بالسَبق سُبّاقُ غايةٍ","وأَعظَمه من كُلِّ حيٍّ أعاظِمُه",146,"م",2,0],["أَقرَّ بدين اللَه ستراً لحكمةٍ","فَقال عدوُّ الحقِّ ما هو قائلُه",147,"ل",2,0],["أَقُريشُ قد ذهبَ الإِلافُ فمن لكم","من بعد أَحمدَ في الورى بإلافِ",148,"ف",1,0],["اقْرِنْ برأيكَ رأْيَ غيرِك واسْتشرْ","فالحقُّ لا يَخفَى على رَأيَيْن",149,"ن",1,0],["اِقْرِ راجيكَ من عُلاكَ نَصيباً","فلَدى الشُّهْبِ للمساكينِ قَصْعه",150,"ع",2,0],["اِقرَا الدَموعَ فَإِنَّها عُنواني","وَأَنا كِتابُ كَتائِبِ الأَشجانِ",151,"ن",1,1],["أَقَرَّ اللَهُ يَومَ فِراقِ وَجهي","بِفُرقَتِهِ سَخينَةَ عَينِ مِصرِ",152,"ر",1,0],["أقرَّ بتصديقها ثالبوه","وما أصدقَ المدحَ من ثالبِ",153,"ب",1,0],["أَقرَا السلامُ عليك اللَهُ معكِ لأن","أبو الورى بك جدَّدْ بعد أن جاءَ",154,"ا",2,0],["إقرعن باب اللَبان","وارتضع صافي اللِبان",155,"ن",1,0],["أَقرينتي أنت الجميلة كلها","لكن جمالك من سناء بهائي",156,"ي",1,0],["أَقرأ في خُدودَهُ","ضَميرُهُ مِن الصَفا",157,"ف",2,0],["أَقَرَّ اللَهُ عَيناً ما أَلحت","عَلى خَديكَ بِالنَظَر المُريب",158,"ب",1,0],["اقرأ كلام الله إن كنت من أهل القراه","واسمع أحاديث طه ذي روتها الرواه",159,"ا",2,0],["إقرا الأحيا يقربك الإله","وترى الحق حقا كالعيان",160,"ن",1,0],["إقرأ الأحيا وصيره الجليس","إنه الناصح الخل الأنيس",160,"س",1,0],["إقرأ فديُتك فالقرآن يمنحن","في لجّة العصر تثبيتاً وإصرارا",161,"ر",2,0],["أقْراهمُ ماضيات الحدِّ تفْعَلُ في","مَوائِد الحرْب ما لاَ يفعلُ النّهمُ",162,"م",1,0],["أقررت في أنه قديم","قلت نعم هكذا نقول",163,"ل",1,0],["أقرَّ بأن القول فيه طلاوةٌ","ويعلو ولا يعلو عليه خطاب",164,"ب",1,0],["أقرَبُ النّاسِ بالكرامِ بعيدٌ","ولِقاءُ الكِرامِ جَدُّ سَعيدُ",165,"د",1,1],["أقرَّ الورَى أن ليس كُفئاً لمُلكِه","سواهُ فقد زال التّنافُسُ والغَبْطُ",166,"ط",1,0],["أقْرَرتُ عينَ المجد فيك مدائحاً","وأغَظْتُ فيك معانداً وحسودا",167,"د",2,0],["أقرُّ به عيناً وأَشرح خاطراً","وأشرك شكر الروض وبل قطاره",168,"ر",2,0],["أَقْرَرْتُ أَنِّي عاجِزٌ عن شكر ما","أَوْليتَني ولوانَّني سَحْبانُ",169,"ن",1,0],["أقررتُ أني عبدُه فتيقّنوا","ثم اشهدوا هو سيّدي هو سيدي",170,"د",2,0],["اقرأ بغُرّةِ وجهِه","صُحْفَ المُنى إن كنتَ تَقْرا",171,"ر",2,0],["أقرّتْ حين صُلْتَ لك الأعادي","وقرّتْ إذا وصلتَ بك العيونُ",172,"ن",1,0],["أَقريرةٌ عيني بعَيْشٍ لا أَرى","فِيهِ سيوفَكَ فِي عُداتِكَ تحتكِمْ",173,"م",1,0],["أُقِرُّ عيونَ الشامِتينَ ولَيتَنِي","أُبَرِّدُ مَا تطوي الضلوع من الغِلِّ",174,"ل",1,0],["أَقُرَّة عيني أَنني باك مشفق","وعن سر قلبي مذودي فيك يفصح",175,"ح",1,0],["أقررت عينى اذا ما زلت أشهد أن","كل المرائى جمالا منك مظبعا",176,"ع",2,0],["اقرأ قليلاً فإن الليل مبتسم","ففي يراعتك المعطاء أسرار",177,"ر",1,0],["أقروا على صلب الشريعة بينهم","أبروا بقصف المفسدين المؤززِ",178,"ز",1,0],["اِقرعْ ظنابيبَ القطيعةِ لي","فلَتقرعَنْ من بعديَ السِّنّا",179,"ن",2,0],["اقرأ على بُعد المسافة بيننا","ولو استطعتُ القربَ قلتُ لك أئذنِ",180,"ن",1,0],["أقرَّها تدبيره في منصبٍ","لو زاله المقدارُ ما أزاله",181,"ل",2,0],["أقربُ ما يكون منّي وصلُها","إذا نأتْ أو بَعُدتْ ديارُها",182,"ر",3,0],["أقرّ بالفضل له حاسدهُ","ولو رأى وجهَ الجحود لجَحَدْ",183,"د",1,0],["أقرّ لك الأعداءُ بالفضل عَنوةً","ومعترِفٌ من لم يسَعْهُ جُحود",184,"د",1,0],["أقريشُ لا فلمٍ أراك ولا يدِ","فتواكلي غاض الندَى وخلا النَّدي",185,"د",2,1],["أقررتَها عَيناً وأع","ينُ الأعادي قَرْحى",186,"ح",2,0],["أُقِرَّ لهُ بالسبقِ غيرَ مُنازعٍ","وأُلْقِي عنانُ الفخرِ غير مُنازعِ",187,"ع",1,0],["أقربُ من قَولكَ يا عَمْرو","حالٌ بها ينكشفُ الضَّرُّ",188,"ر",1,1],["أقرَّ فخاراً في عَليَّينِ لم أزلْ","بمجدهما أُثْني ملياً وأمْدَحُ",189,"ح",1,0],["أقرَّ لها الدَّهر الرحيبُ وأهْلهُ","وفُضِّلت إذ أصبحت خير مفضَّلِ",190,"ل",1,0],["أقرُّوا إذاً طُرَّاً بتفضيلِ سابقٍ","جموحٍ إلى الغايات مُلتهب الحُضر",191,"ر",1,0],["إقرار من ظلموه شاهد حقه","قل فليكم حقا به مجزوما",192,"م",2,0],["أقر السلام وزير الشرق في سحر","نسيمه بذكي المسك مفتوق",193,"ق",1,0],["اقرأ سلامي على الوزير وقل","لا عدم الملك منك تمكينا",194,"ن",2,0],["إِقرإِ اللَّوحَ البَيانِيَّ الأَتَمْ","وافهَمِ المنشورَ في طيِّ الصِّحافْ",195,"ف",1,0],["اقْرَبَ للتَّقوى ترى العفوَ فكنْ","عند بُروزِ قُدرةٍ ممَّن عَفَا",196,"ا",1,0],["أُقِرُّ بأنّني قد عشْ","تُ أزمانا وأزمانا",197,"ن",2,1],["أُقِرُّ بأنني لا زلْ","تُ أبكي القومَ سدْمانا",197,"ن",2,0],["أُقِرُّ بأنّني صاحَبْ","تُ فرعونَ وهامانا",197,"ن",2,0],["أُقِرُّ بأنّني خلف","المسيحِ مشيت جَذْلانا",197,"ن",2,0],["أُقِرُّ بأنّني صاهرْ","تُ عدنانَ وقحْطانا",197,"ن",2,0],["أقرانُ حربٍ كلّما اِقترَنوا لدى ال","هَيجاءِ تحسَبُهم لُيوثَ قِرانِ",198,"ن",1,0],["أقر بالفضل له وبالعلى","معترف لم يغنه إنكاره",199,"ر",2,0],["أقر نصاب العز في آل أحمد","كفيل لهم لا للقضاة زعيم",200,"م",1,0],["أَقرّوا بِلا خُلف حاجَتي","أَلا مِثلُ سائلهم لَم يَخِبْ",201,"ب",1,0],["أقرِي الّذي ذادوه عن باب القِرى","وأعيدُ محرومَ الغِنى مرزوقا",202,"ق",2,0],["أقِرُّ بها رَغماً وليس بنافعِي","وَقَد طويتْ صُحْفُ المعاذير جَحْدُها",203,"د",3,0],["أقَرُّ لعينِي من عناقِ مُهَفْهَفٍ","أَبيتُ سوادَ اللّيل بين ترائِبِهْ",204,"ب",2,0],["أُقِرُّ بِالذَنبِ مِنّي لَستُ أَعرِفُهُ","كَيما أَقولَ كَما قالَت فَنَتَّفِقُ",205,"ق",1,0],["أَقَرَّت عَلَيهِم نِعمَةَ اللَهِ نِعمَةٌ","لَهُم في رِقابِ الناسِ لَيسَ لَها نَقلُ",206,"ل",1,0],["إِقرا السَلامَ عَلى قَبرٍ تَضَمَّنَهُ","ماذا تَضَمَّنَ مِن جودٍ وَأَيسارِ",207,"ر",1,0],["أقرب من حبلنا الوريد كما","قال وقالته سادة قود",208,"د",1,0],["اقر بأنّ اللهَ لا رَبَّ غَيرُهُ","وأنّ رسّول الله أفضلهم رُسلا",209,"ل",2,0],["أَقَرَّ المُلكُ حُسناً في يَدَيها","وَتيرَةَ ذي الأَناةِ المُستَديمِ",210,"م",1,0],["أقربهم من النبي قربا","وطاعة لأمره وحبا",211,"ب",2,0],["أَقرضتَ ربَّك قرضاً سوف يُضْعِفه","يوم القيامة أَضْعافاً وأَضْعَافا",212,"ف",2,0],["أُقِرُّ بِحِكْمِكُمْ ما دُمتُ حيًّا","وألزَمُهُ وإنْ بُلِغَ الفَناءُ",213,"ا",2,0],["أقرَّ العينَ إذ طَارَت عليهم","شَمِيطُ اللَّونِ لَيسَ لها حُجُولُ",214,"ل",1,0],["أُقَرِّبُ مَربَطَ الهَطالِ إِنّي","أَرى حَرباً سَتَلقَحُ عَن حِيالِ",215,"ل",1,0]]}