n.net/poem34807.html","الكامل"],[440,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[442,"ألا مبلغ عني بشير بن جمعة","https://www.aldiwan.net/poem14425.html","الطويل"],[449,"قد أسمع القلب داعي الحب حين دعا","https://www.aldiwan.net/poem53812.html","البسيط"],[450,"مدى كتابك غابات وأنهار","https://www.aldiwan.net/poem983.html",""],[452,"اهل افغانستان","https://www.aldiwan.net/poem23875.html","الطويل"],[459,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[459,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[459,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[459,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[459,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[459,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[459,"أقريش لا فلم أراك ولا يد","https://www.aldiwan.net/poem56235.html","الكامل"],[459,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[462,"وفتيان صدق من تميم تناثلوا","https://www.aldiwan.net/poem15083.html","الطويل"],[462,"أقرب من قولك يا عمرو","https://www.aldiwan.net/poem15119.html","السريع"],[462,"رعى الله نجرا زينبيا تألقت","https://www.aldiwan.net/poem15164.html","الطويل"],[462,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[462,"حباه إله العرش جودا ونجدة","https://www.aldiwan.net/poem16115.html","الطويل"],[480,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[496,"وفتية كنجوم الليل مسعدة","https://www.aldiwan.net/poem10247.html","البسيط"],[496,"ما للخزامى تعود نسرينا","https://www.aldiwan.net/poem10279.html","المنسرح"],[501,"خذ شهودا عن شهود الكائنات","https://www.aldiwan.net/poem38068.html","الرمل"],[501,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[506,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[515,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[516,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[516,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[541,"فان معشر بخلوا والتووا","https://www.aldiwan.net/poem56907.html","المتقارب"],[552,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[552,"أفي كل وم لي منى أستجدها","https://www.aldiwan.net/poem47870.html","الطويل"],[552,"أضن بنفسي عن هوى البيض كلما","https://www.aldiwan.net/poem48038.html","الطويل"],[554,"إذا التقينا منعنا النوم أعيننا","https://www.aldiwan.net/poem68284.html","البسيط"],[554,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[554,"يا عين جودي بدمع منك مدرار","https://www.aldiwan.net/poem68400.html","البسيط"],[559,"يا من غفلتم وجوهكم سود","https://www.aldiwan.net/poem34568.html","المنسرح"],[560,"تأدب بباب الدير واخلع به النعلا","https://www.aldiwan.net/poem69348.html","الطويل"],[564,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"حتى خيالك لا وفى ولا وافى","https://www.aldiwan.net/poem3051.html","البسيط"]],"verses":[["أَقرَضوني مِن عِزِّهِم","وازِنَ القَدرِ وافِيا",0,"ي",2,0],["أَقَرُّ عَينِ الفاقِدِ المُرِنِّ","عَسايَ أَنفي الضَيمَ أَو لَعَنّي",1,"ن",2,0],["أَقرِ السَلامَ فَتىً تَخاوَصُ هَيبَةً","عَنهُ عُيونُ تَحِيَّتي وَسَلامي",2,"م",2,0],["أَقَرَّ بِحَقِّ المَجدِ وَهوَ مُضَيَّعٌ","وَعَظَّمَ قَدرَ الدينِ وَهوَ ضَئيلُ",3,"ل",1,0],["أَقرِ عَنّي السَلامَ أَهلَ المُصَلّى","وَبَلاغُ السَلامِ بَعدَ التَلاقي",4,"ق",2,0],["أُقُرُّ بِلُبسِهِ وَلقَد أَراني","أُجاحِدُهُ إِباءً وَاِمتِعاضا",5,"ض",2,0],["أَقرُبُ بِالوُدِّ وَيَنأى بِهِ","وَيلي عَلى بُعدِكَ مِن قُربِ",6,"ب",1,0],["أُقُرِّطُها الأعِنَّةَ في مُلاءٍ","يُنَشِّرُها مُثارُ النَّقْعِ دُكْنِ",7,"ن",1,0],["أَقَرُّ الناسَ كُلِّهِمُ لِعَيني","يَرى قَتلي يَتِمُّ بِهِ السُرورُ",8,"ر",1,1],["أَقَر اللَهُ عَيني أَن أَراني","أَعيشُ وَحُبُّنا مَحضٌ صَريحُ",9,"ح",1,0],["أُقِرُّ لَكَم بِالذَنبِ مِنّي مَخافَةً","مِنَ الهَجرِ لَمّا رُمتِ أَن تُخلِقي الحُبّا",10,"ب",2,0],["أقْرَضْتُ فيكَ اللهَ صِدْقَ محبّتي","أيَكونُ تَجْري فيكَ غيرَ رَبيح",11,"ح",1,0],["أَقَرَّ عَينَيكَ في دُنياكَ أَن رَأَتا","مُحَمَّداً يَتَراءى فَوقَ كيوانِ",12,"ن",1,0],["أَقرِضوا اللَهَ يُضاعِف أَجرَكُم","إِنَّ خَيرَ الأَجرِ أَجرٌ مُدَّخَر",13,"ر",1,0],["أَقَرَّ عَينِيَ أَنّي قُمتُ أُنشِدُكُم","في مَعهَدٍ بِحُلى العِرفانِ مُزدانِ",14,"ن",1,0],["أَقَرَّ حَشا اِمرِئِ القَيسِ بنِ حُجرٍ","بَنو تَيمٍ مَصابيحُ الظَلامِ",15,"م",1,0],["أَقَرَّ اللَهُ عَيني إِذ دَعاني","أَمينُ اللَهِ يَلطُفُ في السُؤالِ",16,"ل",1,1],["إقرار غير جاحد","واللَه خير شاهد",17,"د",1,1],["أَقَرَّ حَاضِرَهُ وَبَادِيَهُ","مَا أَنْفَعَ العَدْلَ مُقْرُوناً بِإِحْسَانِ",18,"ن",1,0],["أَقْرَانُكَ الأَمْجَادُ فِي الشَّيبِ الأُولَى","يَرْعَوْنَهَا وَبَنُوكَ فِي الفِتْيَانِ",19,"ن",1,0],["أَقْرَضَ اللهَ كُلَّ قَرْضٍ جَمِيلٍ","فَجَزَاهُ أَضْعَافَهُ الرَّحْمَنُ",20,"ن",1,0],["أَقَرَّ بِالخُطَّةِ المُثْلَى مَكَانَتهُ","بِحَيْثُ يَرْسَخُ وَالأَطْوَادُ تَنْقَضِمُ",21,"م",1,0],["أَقرَمُ في الإِبلِ تِلادا مُتلَدا","مُقابِلاً في نَجبِها مُرَدَّدا",22,"د",2,0],["أَقري الهُمومَ إِذا سَرَت عيدِيَّةٍ","يُرحَلنَ حَيثُ مَواضِعُ الأَحناءِ",23,"ا",2,0],["أَقرَرتُ في الحُبِّ بِما تَدَّعي","فَلَستُ مُحتاجاً إِلى شاهِدِ",24,"د",1,0],["أُقِرُّ لَهُ بِالذَنبِ وَالذَنبُ ذَنبُهُ","وَيَزعَمُ أَنّي ظالِمٌ فَأَتوبُ",25,"ب",1,1],["أَقَرَّ العَينَ أَن عُصِبَت يَداهُ","وَما إِن تُعصَبانِ عَلى خِضابِ",26,"ب",1,0],["أُقرُّ على نفسي بعيبي لأنني","أرى الصدقَ يمحو بَيّنات المعايبِ",27,"ب",1,0],["أقُرَّةَ عيني قدْ أطَلْت بُكاءها","وغادرْتها أقْذَى من الأعينِ الرُّمدِ",28,"د",1,0],["أقُرَّةَ عيني لو فَدَى الحَيُّ مَيِّتاً","فَدَيْتُك بالحَوْبَاء أَوَّلَ من يَفْدِي",28,"د",2,0],["أقريهما كلَّ من عاداك لا حَرَجاً","من قتلهم بين مضروبٍ وموخوز",29,"ز",1,0],["أقْرضْتُهُ قرض سُوءٍ","فهَمُّه ردُّ قرضي",30,"ض",2,0],["أقر عينيَّ في ليلي وصبَّحني","وجداً أفاضهما بالماء شفّافا",31,"ف",2,0],["أقران ظهرك أو فاب","غ من حذارى نُفيقا",32,"ق",2,0],["أقِرْدٌ مُقعَدٌ وتَعِفُّ أنثى","له كلا وإفكِ مُعَلّليكا",33,"ك",2,0],["أقرْنَ صديقنا الحسن بن موسى","علوْتَ فليس خطْبٌ يرتقيكا",33,"ك",2,0],["أقرضتُه أيراً فردَّ لساناً","وكذاك يفعل من غدا قرنَانا",34,"ن",2,1],["أقْرِنْ إلى حُسْنِ وجهكَ الحسنِ","فعلكَ وانظُرْ بعين ذي فطنِ",35,"ن",1,1],["إِقرَأ سَلامي عَلى مَن لا أُسَمّيهِ","وَمَن بِروحي مِنَ الأَسواءِ أَفديهِ",36,"ي",2,1],["أَقَرَّ بِها جَأشي بِأَوَّلِ آيَةٍ","وَماضٍ حُسامٍ غِمدُهُ مُتَطايِحُ",37,"ح",1,0],["اقرأه واقرأ سجايا اوليه تجد","ما شئت من نسب حمد ومن حسب",38,"ب",1,0],["اقرأه في دولة التجديد منفردا","حيث اسمه لكتاب الشعر عنوان",39,"ن",1,0],["اِقرَإِ التاريخَ إِذ فيهِ العِبَر","ضاعَ قَومٌ لَيسَ يَدرونَ الخَبَر",40,"ر",1,0],["إِقرَأوها يُكشَفُ العَصرُ لَكُم","كُلُّ عَصرٍ بِرِجالٍ وَسِيَر",41,"ر",1,0],["أَقَرَّ جِلدي بِها عَلَيَّ فَلا","أَقدِرُ حَتّى المَماتِ أَجحَدُها",42,"د",3,0],["أَقَراراً أَلَذَّ فَوقَ شَرارٍ","وَمَراماً أَبغي وَظُلمي يُرامُ",43,"م",1,0],["أُقِرُّ بِما لَم أَجنِهِ مُتَنَصِّلاً","إِلَيكَ عَلى أَنّي أَخالُكَ أَلوَما",44,"م",2,0],["أَقَرَّت لَهُ بِالفَضلِ أُمَّةُ أَحمَدٍ","فَدانَ لَهُ مُعوَجُّها وَقَويمُها",45,"م",3,0],["أَقَرَّ عَلى نُزولِ الخَطبِ جَأشاً","وَأَوضَحَ تَحتَ حادِثَةٍ جَبينا",46,"ن",2,0],["أَقرى الحَوادِثَ إِن حَلَلنَ تَجَلُّداً","وَأَعُدُّ شَأنَ عَشيرَتي مِن شاني",47,"ن",2,0],["أقرانُه تَنكِلُ عن بِرازِه","يُبادِرُ الفُرصةَ في انتهازِه",48,"ز",2,0],["أقررتُ في شُكرِكَ بالتَّقصيرِ","إذ زِدْتَ في البِرِّ على التَّكثيرِ",49,"ر",1,1],["إِقرَأ كِتابَكَ وَاِعتَبِرهُ قَريباً","فَكَفى بِنَفسِكَ لي عَليكَ حَسيبا",50,"ب",2,1],["أَقَرَّ بِمُهجَتي لَكُمُ لِساني","وَذاكَ بِصِحَةٍ وَجَوازِ أَمرِ",51,"ر",1,1],["أَقرَّ فيها أُناساً في مَواطِنِهم","لمّا تَنادَوْا لِتَوْديعٍ ومرتحلِ",52,"ل",1,0],["أقرَى الملوك يداً وأرفع ذِمَّةً","وأجلّ منقبةً وأكرمُ عُنْصُرا",53,"ر",2,0],["إِقرَ السَلامَ عَلَيكَ مِنّي كُلَّما","جَرَتِ الرِياحُ فَأَنشَقَتكَ نَسيما",54,"م",2,0],["أَقَرّوا لَعَمري بِحُكمِ السُيوفِ","وَكانَت أَحَقَّ بِفَصلِ القَضاءِ",55,"ا",2,0],["أَقَرمَ بَكرٍ تُباهي أَيُّها الحَفَضُ","وَنَجمَها أَيُّهَذا الهالِكُ الحَرَضُ",56,"ض",1,1],["أَقَرَّ عَمودَ الدينِ في مُستَقَرِّهِ","وَقَد نَهَلَت مِنهُ اللَيالي وَعَلَّتِ",57,"ت",1,0],["أَقري السَلامَ مُعَرَّفاً وَمُحَصِّباً","مِن خالِدِ المَعروفِ وَالهَيجاءِ",58,"ا",2,0],["إِقرَء عَلى أَهلِ البَقيعِ مِنِ اِمرِئٍ","كَمِدٍ عَلى أَهلِ البَقيعِ سَلاما",59,"م",2,0],["أَقَرَّت مَعَدٌّ أَنَّنا خَيرُها جَدّي","لِطالِبِ عُرفٍ أَو لِضَيفٍ مُحَمَّلِ",60,"ل",1,0],["اِقرَأ عَلى الجِزعِ السَلامَ وَقُل لَهُ","سُقّيتَ مِن سَبَلِ الغَمامِ المُمطِرِ",61,"ر",1,0],["اِقرَأ عَلى الوَشلِ السَلامَ وَقُل لَهُ","كُلُّ المَشارِبِ مُذ هَجَرتَ ذَميمُ",62,"م",1,1],["اِقرَ السَلامَ عَلى لَيلى وَحَقَّ لَها","مِنّي التَحيَّةُ إِنَّ المَوتَ قَد نَزَعا",63,"ع",2,0],["أقَرُّوا المُلكَ فاستعلت ذُراه","وهمّوا بالخلافةِ ناهضينا",64,"ن",2,0],["إقرأه مُتَّئِداً عليهم وَادْعُهم","أن يتبَعوكَ إلى التي هِيَ أقْوَمُ",65,"م",1,0],["اقرأ كِتابَ أخيكَ مالك مصرفٌ","عمّا يُريدُ ولن ترى الإحجاما",66,"م",2,0],["إقرأ القرآن وَاتْبَعْ هَدْيَهُ","يا عُميرَ الخيرِ إنْ ذو الغَيِّ حادا",67,"د",2,0],["أَقربي مِن فمي","فَحَديثي شجون",68,"ن",1,0],["أَقَرَّت تَميمٌ لِاِبنِ دَحمَةَ حُكمَهُ","وَكانَت إِذا سيمَت هَواناً أَقَرَّتِ",69,"ت",1,0],["أَقرَرتُ أَنِّيَ مَجنونٌ بِحُبِّكُمُ","وَلَيسَ لي عِندَكُم عُذرُ المَجانينِ",70,"ن",1,0],["أَقَرَّ عُروشَها بِثَرىً وَطَيءٍ","وَأَنهارٍ كَحَيّاتٍ سَوارِ",71,"ر",1,0],["أقرب رحمى إلى البرية من","أنسابها في ذُرى قبائلها",72,"ل",3,0],["أُقِرُّ بِالذَنبِ وَلَم آتِهِ","خَوفاً مِنَ الهَجرِ وَلَوعاتِهِ",73,"ت",2,1],["أَقَرَّ بي كِتابُهُ المَنشورُ","وَأَنا مِن رُؤيَتِهِ مَذعورُ",74,"ر",1,0],["أَقَريبٌ مَزارُهُ","أَم مَعَ النَجمِ قَد طَمَح",75,"ح",1,0],["أَقَرّوا بِالإِلَهِ وَأَثبَتوهُ","وَقالوا لا نَبِيَّ وَلا كِتابُ",76,"ب",1,1],["أَقرَرتُ بِالجَهلِ وَاِدَّعى فَهَمي","قَومٌ فَأَمري وَأَمرُهُم عَجَبُ",77,"ب",1,0],["أُقِرُّ بِأَنَّ لي رَبّاً قَديراً","وَلا أَلقى بَدائِعَهُ بِجَحدِ",78,"د",1,0],["أَقرِضينا في المَحلِ مُدّاً بِصاعٍ","وَاِترُكينا مِن فَرطِ هَذا الشَمّاسِ",79,"س",1,0],["إِقرَأ كَلامي إِذا ضَمَّ الثَرى جَسَدي","فَإِنَّهُ لَكَ مِمَّن قالَهُ خَلَفُ",80,"ف",1,0],["أَقَرَأنا مِنها السَلامَ الكَرى","وَكَم أَبادَ الحَتفُ أَقرانا",81,"ن",2,0],["أَقراني ذاكَ المُضَيِّفُ ما أَك","رَهُ وَاللَهُ غالِبُ الأَقرانِ",82,"ن",1,0],["أقرَّ بالتَّشييدِ والتَّأسيسِ","في الجبَلِ النَّامي إلى عَمروسِ",83,"س",1,0],["أقرضت عمراً فما صنعت به","سوف يرد الأنام ما اقترضوا",84,"ض",3,0],["اقْرَ السَّلامَ على الأَصْحَابِ أَجْمَعهم","وخُصَّ عَمْراً بأَزْكَى نُورِ تَسْلِيمِ",85,"م",1,1],["أَقَرَّ النَّوَاظِرُ تَهْذِيبُهَا","وَتَدْرِيبُهَا المُونِقُ المُحْكَمُ",86,"م",1,0],["أَقْرِرْ مَقَامَكَ حَيْثُ شِئْتَ فَإِنَّه","لَنَتِيجَةٌ مِنْ ذَلِكَ الإِقْرَارِ",87,"ر",1,0],["أَقْرِيءِ الْقَوْمَ سَلاَمِي وَاعْتِذارِي","حَجَبَتْني عِلَّةٌ فِي عُقْرِ دَارِي",88,"ر",2,1],["أقْرَرْتَ عَينَ العَصْرِ حِينَ أَرَيْتَهُ","حِلمَ الكُهُولِ وَأَنْتَ غَضُّ إِهَابِ",89,"ب",1,0],["أَقَرَّ اللهُ عَيْنَيْهِ بِنَجْلٍ","مُرَجَّى لِلْسَعَادَةِ فِي الحَيَاةِ",90,"ه",1,0],["أَقَرَّتْ عُيُونَ الْجَاهِ فِيكَ لُيَيْلَة","مُطَرَّدَةُ الأَشْجَانِ مَوْمُوقَةُ السُّهْدِ",91,"د",1,0],["أَقَرَأْتَ فِي الطَّيَرَانِ آيَاتٍ لَهُ","يَجْدُرْنَ بِالتَّرتِيلِ وَالإِقْرَاءِ",92,"ا",2,0],["أَقْرأُ فِي خَدِّهِ كتابَ هوىً","أَنَّ دمَ العاشِقينَ مَطلولُ",93,"ل",1,0],["أَقُرَّةَ أَعيُنِ الأَشرافِ فهرٍ","وَجَدُّكَ مِنهُمُ المَحض الصَريحُ",94,"ح",1,0],["أقررتُ فيه بعيب لست أعرفهُ","وربما استبطن الإقرارُ إنكارا",95,"ر",2,0],["اقرئيها لا تحجب الخلد عني","انشريها لا تتركيني أموت",96,"ت",1,0],["إِقْرَأْ كِتَابَ اللِه جُهْدَكَ وَاتْلُهُ","فيمَنْ يَقومُ بِهِ هناكَ ويَنْصِبُ",97,"ب",1,0],["إقرأ على \" مصر \" السلامَ وقل لها","حَيَّتْ رباكِ روائحٌ وغوادي",98,"د",2,0],["أقَرَّ حَشا امرِىء القَيسِ بنِ حُجرٍ","بنُو تَيْمٍ مَصَابِيحُ الظّلامِ",99,"م",1,0],["إقرئيني.. كلّما فتّشتِ في الصحراء عن قطرة ماءْ","إقرأيني.. كلّما سدّوا على العشّاق أبوابَ الرجاءْ",100,"ا",2,1],["((أقراص النّوم تبيع له","أهدابا … وهدوءا يقظان ))",101,"ن",1,0],["إقرأ كلامي وابسم حين تقرؤه","وإن يكن لك تحبيري وإنشائي",102,"ا",2,0],["أقرع السن نادماً وأذم الد","دهر ذمّاً ولات حين عزاء",103,"ا",2,0],["أقر الحبيب سلاميه","نفسي فدته وماليه",104,"ل",3,0],["أقرّ لهُ بالغدى شهرةً","وفضلَ المساعِي جميعُ الأنامْ",105,"م",1,0],["أَقَرَّ العَينَ أَن عَصَبَت يَداها","وَما إِن يُعصَبانِ عَلى خِضابِ",106,"ب",1,1],["اقَرَّبِهِ المَولَى عُيونَ أُولِى الهُدَى","وأقذَى بِهِ حِزبَ الضَّلاَلِ عُيونَا",107,"ن",2,0],["أقرّ بما جمعت من المعالي","جميعُ الناس من قاص ودانِ",108,"ن",1,0],["إِقرَ مِنّي عَلى الوَليدِ السَلاما","عَدَدَ النَجمِ قَلَّ ذا لِلوَليدِ",109,"د",1,1],["أَقَرَّ جَداكَ عُيونَ المُنى","وَأَحيا اِرتِياحُكَ مَيتَ الأَدَب",110,"ب",1,0],["أَقرَرتَ عَينَيهِ بِإِقرارِ الهُدى","فَحَباكَ ما قَرَّت بِهِ عَيناكا",111,"ك",2,0],["أَقَرَّت لآياتٍ لَهُ وَدَلائِلِ","بِها الصُبحُ طَلقٌ وَالطَريقُ موطأُ",112,"ط",2,0],["إِقْرارُ دَمْعي بالهَوى مِلءَ الهَوى","فَضَحَ استِتاري في الهَوى وَجُحُودي",113,"د",2,0],["أقر وأرسا من قواعد يذئل","وأقطع حدا من شفار الصوارم",114,"م",1,0],["أقر عيون المجد ربك والعلا","بدولتك الغرا التي مالها حد",115,"د",1,0],["اقرت رؤساً في الطلا هذه الرسل","وهذي الهدايا والتلطف والبذل",116,"ل",1,1],["اقرعيون أهل الأرض فيه","سرور لم يدع في الأرض حزنا",117,"ن",2,0],["اقرا الرسالة وانظر ما زهادتهم","مما لديكم على الدنيا من الكلب",118,"ب",1,0],["أَقَرَّ بِفَضلِ الفَضلِ بادٍ وَحاضِرٌ","وَساقَ إِلَيهِ الشُكرَ حافٍ وَناعلُ",119,"ل",1,0],["أقرّ أهل السجون عن ثقة","بفضله في جميع بلدانه",120,"ن",2,0],["أَقرَّ يعربُ بالسَّبْقِ المبينِ لها","وأَجْمَعَ الرأيَ في تفضيلها العرب",121,"ب",1,0],["أقرَّت نجومُ الحسن أنك بدرُها","وأنك في روض المحاسن زهرُها",122,"ر",3,1],["أقريبٌ أنت مني أم بعيد","أيها الجائدُ بالحب السعيد",123,"د",1,1],["أقرّ ولم ينكر وقال مورياً","صدقتم بعيني قد رأيت سقامه",124,"ه",1,0],["إِقرِبي ما اِستَطَعتِ من كُبِر نَفسي","أَنا صدري رحبٌ وَقَلبي كَبيرُ",125,"ر",1,0],["إِقرَبي إِقرَبي فَآلامُ نَفسي","جمرَةٌ يستَطيرُ مِنها السَعيرُ",125,"ر",1,0],["أَقريبٌ من دَنفٍ غَدهُ","فَاللَيلُ تَمرَّدَ أَسودُهُ",126,"د",2,1],["أقِرّوا لنا يا آل عبّاسَ بالعُلا","فلستمْ لها يا آلَ عبّاسَ أكسَبا",127,"ب",2,1],["أقرّ لوجهكِ القمر المنيرُ","وذلَّ لقدّك الغصن النضيرُ",128,"ر",1,1],["أقرّت لك الأيام بالبأس والندى","وزالت لك الأملاك طرّاً عن الفخر",129,"ر",1,0],["أقرّ بأن الله جلّ ثناؤه آله","قديم قاهر مترفع",130,"ع",1,0],["أَقرّ لَهُ من كُلِّ حُسنٍ جَليلُهُ","وَوافَقَهُ مِن كُلِّ مَعنىً دَقيقُهُ",131,"ق",2,0],["أَقْرَأَنَاهَا بِتَحْقِيقٍ أَخُو ثِقَةٍ","فِي وَجْهِهِ مِنْ سُطُوعِ الْبِشْرِ أَنْوَارُ",132,"ر",1,0],["اقرأ كتاب باسم ربك واجنِ من","آياته وحُلاه كل ثمين",133,"ن",1,0],["أَقَرَّ وِقاعي أَنفُساً لَيسَ بينَها","وَبَينَ حياضِ المَوتِ للشَربِ منهَلُ",134,"ل",1,0],["أَقَرَرتُ عَيني مِن أُلَ","ئِكَ فَوائِحِ بِالعَبيرِ",135,"ر",1,0],["أقررت أني جَزَّارُ كما ذكروا","عَنِّي فهل غَيرُ هذا القول عندَهُمُ",136,"م",1,0],["أَقَرَّ لَه بِالفَضل شانيه راغِماً","مَتّى يسبِقِ الاجماعُ تتحِد الفَتوى",137,"و",2,0],["اقرع سنى ندامة ومتى","ينتفع المرء من تندمه",138,"م",2,0],["أَقَرَّ مهيناً مَنْ تَخَمَّطَ ضِلَّةً","وَقَرَّ علَى الإِذْعانِ والهونِ مَنْ طَغَا",139,"غ",2,0],["أَقَّرَّ ذَوُو الآدابِ طُرّاً لِمَنْطِقِي","وَغَيْرُهُمُ فِيما حَكى كاذِبُ الزَّعْمِ",140,"م",1,0],["أَقْرَضْتَنِي حُسْنَ الصَّنِيعِ تَبَرُّعاً","وَالْقَرْضَ أَفْضَلُ مِنْ جَزاءِ الْمُقْرِضِ",141,"ض",1,0],["أَقَرَّت بِتَفضيلِهِ في الأَنامِ","عَلى الأُمراءِ مُلوكُ الشَآمِ",142,"م",1,0],["أَقرِ نَجداً وَمَن بِنَجدٍ سَلامي","إِنَّ نَجداً مَأوى غَريمِ غَرامي",143,"م",2,1],["أَقررتَ أَعينَ من بها بنزاهَةٍ","حلَّتكَ في سنِّ الصِبا بحُلاها",144,"ا",3,0],["أَقرَّ له بالسَبق سُبّاقُ غايةٍ","وأَعظَمه من كُلِّ حيٍّ أعاظِمُه",145,"م",2,0],["أَقرَّ بدين اللَه ستراً لحكمةٍ","فَقال عدوُّ الحقِّ ما هو قائلُه",146,"ل",2,0],["أَقُريشُ قد ذهبَ الإِلافُ فمن لكم","من بعد أَحمدَ في الورى بإلافِ",147,"ف",1,0],["اقْرِنْ برأيكَ رأْيَ غيرِك واسْتشرْ","فالحقُّ لا يَخفَى على رَأيَيْن",148,"ن",1,0],["اِقْرِ راجيكَ من عُلاكَ نَصيباً","فلَدى الشُّهْبِ للمساكينِ قَصْعه",149,"ع",2,0],["اِقرَا الدَموعَ فَإِنَّها عُنواني","وَأَنا كِتابُ كَتائِبِ الأَشجانِ",150,"ن",1,1],["أَقَرَّ اللَهُ يَومَ فِراقِ وَجهي","بِفُرقَتِهِ سَخينَةَ عَينِ مِصرِ",151,"ر",1,0],["أقرَّ بتصديقها ثالبوه","وما أصدقَ الم