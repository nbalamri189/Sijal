0,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[90,"إليها !","https://www.poetsgate.com/ViewPoem.aspx?id=179205",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[90,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[90,"عبادة الشر","https://www.poetsgate.com/ViewPoem.aspx?id=179136",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[45,"نُطالِبُ بِشْراً بِسُقْيا المُدَام","https://www.poetsgate.com/ViewPoem.aspx?id=31843",""],[38,"عفتْ بعدنا أجراعُ بكرٍ فتولبِ","https://www.poetsgate.com/ViewPoem.aspx?id=21244",""],[32,"أبت مقلتي كتمان ما بي","https://www.poetsgate.com/ViewPoem.aspx?id=116",""],[17,"وفيتُ بأدرع الكندي إني","https://www.poetsgate.com/ViewPoem.aspx?id=176609",""],[90,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""],[43,"لا يحزن الله الأمير فإنني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=5441&r=&rc=12",""],[33,"ألا حجبت ليلى وآلى أميرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14169&r=&rc=103",""]],"verses":[["وَأَوطَأتُ أَقوالَ الوُشاةِ أَخامِصي","وَقَد كانَ سَمعي مَدرَجاً لِلنَمائِمِ",0,"م",1,0],["وَأَولى بِلادٍ بِالمُقامِ مِنَ الدُنا","بِلادٌ مَتى يَنزِل بِها الحُرُّ يَغنَمِ",1,"م",1,0],["وَأَولى بِمَن يَستَخلِفُ الدَهرَ بَعدَهُ","عَلى صِرمِهِ أَن يودَعَ الأَرضَ صِمُّهُ",2,"م",2,0],["وَأَودِيَةٌ بَينَ العِراقِ وَحاجِرٍ","بِبيضِ المَواضي وَالعَوالي نُسيلُها",3,"ل",3,0],["وَأَوَّلُ لُؤمِ المَرءِ لُؤمُ أُصولِهِ","وَأَوَّلُ غَدرِ المَرءِ غَدرُ خَليلِ",4,"ل",1,0],["وَأَوقاتُهُ اللاتي تَسوءُ قَصيرَةٌ","وَأَيّامُهُ اللاتي تَسُرُّ طِوالُ",5,"ل",1,0],["وَأورِدُها الخِمسَ في لُجمِها","تَبَرَّضُ ما أَلِفَت تَكرَعُ",6,"ع",1,0],["وَأَولى بِالضِيافَةِ لَو عَلِمنا","خَصيبُ الرَحلِ مَطروقُ الرِباعِ",7,"ع",1,0],["وَأَولى بِمَدحي مَن أُعِزُّ بِفَخرِهِ","وَلا يَشكُرُ النَعماءَ إِلّا المُهَذَّبُ",8,"ب",1,0],["وَأَوضَحتَ إِلى المَجدِ","مَنارَ اللَقَمِ اللَجبِ",9,"ب",1,0],["وَأَوانِسٍ تَدنو إِذا اِجتَدِيَتْ","بِحَديثها وَعَن الخَنى شُمْسِ",10,"س",1,1],["وَأَوقَرَ أَجفاني دُموعٌ نَثَرتُها","عَلى مِحمَلي نَثرَ الجُمانِ مِنَ العِقدِ",11,"د",1,0],["وَأَودَعتُها قَلبي وَصَبري كِلَيهِما","وَأَترابُها في رَنَّةٍ وَعَويلِ",12,"ل",1,0],["وَأُولِغُ صَارِمِي وَالمَوْتُ يَتْلُو","شَباهُ مُجاجَةَ العَلَقِ النَّفيثِ",13,"ث",1,0],["وأَوانِسٍ هِيفِ الخُصورِ إِذا مَشَتْ","وَدَّتْ غُصونٌ أَنّهُنَّ قُدودُ",14,"د",1,1],["وأوْمَضَ لي بَرْقا سَحابٍ ومَبْسِمٍ","فلمْ أدْرِ أيَّ البارِقَيْنِ أشيمُ",15,"م",1,0],["وأوْجُهُهُمْ والسُّخْطُ يُبْدي قُطوبَها","كأوْجُهِ أُسْدٍ كلُّهُنَّ شَتيمُ",15,"م",1,0],["وأوْقَدوا نارَيْنِ بأساً وندىً","حيثُ الطُّلى تَشْقى بهِمْ أوِ الشّوى",16,"ا",1,0],["وأوْدى قِوامُ الدّينِ حتى تولّعَتْ","صُروفُ الليالي بي فرَنَّقْنَ مَشْرَبي",17,"ب",2,0],["وأُورِدُها الوَغى والنّقُْ كابٍ","فتَسْحَبُ منْ وشائِعِهِ ذُيولا",18,"ل",2,0],["وأوجُهُهُمْ إذا بَرِقَتْ تجلَّتْ","عَليها هَيْبةٌ حَضَنَتْ جَمالا",19,"ل",2,0],["وَأَورَقَ فيها الآسُ وَالضالُ وَالغَض","وَنَبقٌ وَنِسرينٌ وَوَردٌ وَعَوسَجُ",20,"ج",1,0],["وَأَوَّلُ هَذا الحُبِّ حُزنٌ مُلازِمٌ","وَهَمٌّ يُطيرُ النَومَ وَالمَوتُ آخِرُه",21,"ر",2,0],["وَأَوقَدَ الشَوقُ ناراً","تَمُدُّ دَمعي فَيَجري",22,"ر",2,0],["وَأَوقَدَ الشَوقُ عَلى قَلبِهِ","ناراً فَفي الأَحشاءِ تَلهيبُ",23,"ب",1,0],["وأوْعَدْتُ الزّمانَ بِكَ انتِصاراً","وأرْغَمْتُ الخُطوبَ بكَ اعْتِلاقا",24,"ق",2,0],["وأوْشَكَتْ أنْ تضِلَّ القَصْدَ زائِرَةٌ","لوْلا أتَتْني في باقٍ منَ الرّمَقِ",25,"ق",1,0],["وَأَوْتَرَ الْقَوْسُ فِي آفَاقِهِ قُزَحٌ","يَرْمِي فَدَرَّعَ أَنْهَاراً وَغُدْرَانَا",26,"ن",2,0],["وَأَوْرَثَ إِبْرَاهِيمَ سِرَّ خِلاَفَةٍ","نَمَاهُ مِنَ الْمَجْدِ الصُّرَاحِ صَمِيمُهُ",27,"م",2,0],["وأوْحَشْتَ منْ دارِ الخِلافةِ هالَةً","أقامَتْ زَماناً لا يَلوحُ بها البدْرُ",28,"ر",1,0],["وأوْرثَ حقَّ النّصْرِ لا عنْ كَلالَةٍ","وللسّبْطِ في المشروعِ أن يرثَ الجَدّا",29,"د",2,0],["وأوْجِبْ لأرْبابِ السّوابِقِ حقَّها","ولا تمْنَعِ المعْروفَ مَنْ لكَ منْ جُنْدِ",30,"د",1,0],["وأوْجَفَ خوْفُ الكُفْرِ شُمَّ هِضابِها","تَدارَكْتَ منْها كُلَّ واهٍ ومُنْهَدِّ",31,"د",1,0],["وأوْرَدْتَنا منْ جُودِ كفّيْكَ مَوْرِداً","يبَرِّدُ غُلاّتِ الظِّماءِ بَرودُهُ",32,"د",2,0],["وَأَوْحَتْ عَنْكَ لِي وَصَبَا","تَخَطَّى مَجْدَكَ الْوَصَبُ",33,"ب",1,0],["وَأَوضَحْتَ طُرْقَ الْحَقِّ لِلْخَلْقِ بَعْدَمَا","عَفَتْ مِنْهُ آثَارٌ وَمُحَّتْ مَذَاهِبُ",34,"ب",1,0],["وَأَوْرَثُوا مِنْ بَنِي نَصْرٍ لِنُصْرَتِهِ","خَلاَئِفاً وَصَلُوا مِنْ بَعْدِهِ السَّبَبَا",35,"ب",2,0],["وَأَوعَدَني حَتّى ظَنَنتُ بِأَنَّهُ","مُصيبي بِمِثلِ القَتلِ أَو هوَ قاتِلي",36,"ل",2,0],["وَأَورَثتَنا حُزناً عَلَيكَ وَحَسرَةً","عَلى فَقدِ سَبّاقٍ كَريمِ المَحاضِرِ",37,"ر",1,0],["وَأَوحَشَ الشَرقُ مِن فَضلٍ وَمِن أَدَبٍ","وَأَقفَرَ الرَوضُ مِن شَدوٍ وَتَغريدِ",38,"د",1,0],["وَأَولي ذَلِكَ الفاني بَياناً","يَتيهُ بِهِ عَلى أَهلِ الخُلودِ",39,"د",1,0],["وَأَودَعتَ تَقريرَ الوَداعِ مَغامِزاً","رَأَينا جَفاءَ الطَبعِ فيها مُجَسَّدا",40,"د",2,0],["وَأوتيتَ النُبُوَّةَ في المَعاني","وَما دانَيتَ حَدَّ الأَربَعينا",41,"ن",2,0],["وَأَوطارُ المُنى تُقضى","وَأَسبابُ الهَوى تَشفَع",42,"ع",1,0],["وَأَوتادَهُ ماذَيَّةٌ وَعِمادُهُ","رُدَينِيَّةٌ بِها أَسِنَّةُ قُعضُبِ",43,"ب",1,0],["وَأَوحَشنَ بَعدَ الحَيَّ إِلا مَساكِنًا","يُرَينَ حَديثاتٍ وَهُنَّ دَوَاثِرُ",44,"ر",1,0],["وَأُولَى وَجَاهَاتٍ خَلَتْ","مِنْ كُلِّ شَائِبَةٍ وَعلَّهْ",45,"ل",2,0],["وَأَوْلَيْتِ بِرَّكِ مَنْ يَرْتَجِيهِ","أَبِالبِرِّ أَوَّلُ مَا تَشْعُرين",46,"ن",1,0],["وَأَوْشَكَتْ أَثْبَتُ أَرْكَانِهِ","تَمِيدُ مِمَّا اشْتَدَّ فِيهِ الزَّحَامْ",47,"م",1,0],["وَأَوْرَى زِنَادَ البَرْقِ حُزْناً فَلَجْلَجَتْ","كَمَا لَجْلَجَتْ بِالنُّطْقِ لُسْنُ التَّرَاجِمِ",48,"م",1,0],["وَأَوْضَحَ النَّهْجِ لِلتَّوَقُّلِ مِنْ","سُفُوحِ عَلْيَائِهِ إِلَى القِمَمِ",49,"م",1,0],["وَأَوَّلُ مَن يُجيبُ إِلى بِرازٍ","إِذا زاغَ الكَمِيُّ عَنِ الكَمِيِّ",50,"ي",1,0],["وَأَوجُهٌ جَهمَةٌ غِلاظٌ","عُطلٌ مِنَ الحُسنِ وَالجَمالِ",51,"ل",1,0],["واولدك همت بدورك","مدّها شمس الخليفا",52,"ف",2,0],["وأوردتَ صفحَ السيف أبيضَ ناصعاً","فأصدرتَه في الرَّوْع أحمرَ قانيا",53,"ي",2,0],["وأورثتك جهاداً أنت ناصره","والأجر منك يُرضِّيها ويحظيها",54,"ي",3,0],["وأورثه العلياءَ كلُّ خليفةٍ","نماه إلى الأنصار كلُّ مقدَّسِ",55,"س",1,0],["وأومض خفّاق الذؤاية بارقٌ","فطارت بقلبي أَنَّةٌ وزفيرُ",56,"ر",1,0],["وأوردك الرحمن حوض نَبيِّهِ","وأصدر من خلَّفت عن خير موردِ",57,"د",1,0],["وأودّ لو تمشون مشية واحد","متكاتفين تكاتف الأخوان",58,"ن",1,0],["وأوشكت الأرض أن تُقلبا","وصبح القيامة أن يُفلَقا",59,"ق",2,0],["وأوقد ناراً للخديعة تحتها","تزيد على نار الغضى أو على الرِمث",60,"ث",1,0],["واوْجرهم سّماً من الذلّ ناقعاً","بكأس من العُدوان ليس لها مَذق",61,"ق",1,0],["وأوسعت صدري للكآبة فاغتدت","بأرجائه تحت الضلوع تجول",62,"ل",1,0],["وَأَورَثَكَ القَينُ العَلاةَ وَمِرجَلاً","وَإِصلاحَ أَخراتِ الفُؤوسِ الكَرازِمِ",63,"م",1,0],["وَأَورَثَنا آباؤُنا مَشرَفِيَّةً","تُميتُ بِأَيدينا فُروخَ الجَماجِمِ",63,"م",1,0],["وَأَوفى لِلمُجاوِرِ إِن أَجَرنا","وَأَعطى لِلنَفيساتِ الرِغابِ",64,"ب",1,0],["وَأَوقَدتُ ناري بِالحَديدِ فَأَصبَحَت","يُقَسَّمُ بَينَ الظالِمينَ عَذابُها",65,"ب",3,0],["وَأَوصى جُبَيرٌ إِلى غالِبٍ","وَصِيَّةَ ذي الرَحِمِ المُجهَدِ",66,"د",1,0],["وَأَورَثَكَ المَكارِمَ في قُرَيشٍ","هِشامٌ وَالمُغيرَةُ وَالوَليدُ",67,"د",1,0],["وَأَوقَدتَ بِالسيدانِ ناراً ذَليلَةً","وَعَرَّفتَ مِن سَوآتِ جِعثَنَ مَشهَدا",68,"د",2,0],["وَأَورَثَني الفَرعانِ سَعدٌ وَمالِكٌ","سَناءً وَعِزّاً في الحَياةِ مُخَلَّدا",68,"د",2,0],["وَأَوثَقُ عِندَ المُردَفاتِ عَشِيَّةً","لِحاقاً إِذا ما جَرَّدَ السَيفَ لامِعُ",69,"ع",1,0],["وَأَوقَدتُ ناري بِالحَديدِ فَأَصبَحَت","لَها لَهَبٌ يُصلي بِهِ اللَهُ مَن يُصلي",70,"ي",1,0],["وأُودٌ أَجلَبَت وَأظُنُّ أُوداً","بِمِيسَمِ بَارق سَيُعَلَّطمَا",71,"م",2,0],["وَأَوسَعُ أَيّاً ماحَلَلتُ كَرامَةً","كَأَنِّيَ مِن أَهلي نُقِلتُ إِلى أَهلي",72,"ل",2,0],["وَأَوعَدتَني حَتّى إِذا ما مَلَكتَني","صَفَحتَ وَصَفحُ المالِكينَ جَميلُ",73,"ل",1,0],["وَأَوَّلُ مَن شَدَّ المَجيدُ بِعَينِهِ","وَأَوَّلُ مَن قَدَّ الكَمِيُّ المُظاهِرُ",74,"ر",1,0],["وَأَوطَأَ حِصنَي وَرتَنيسَ خُيولُهُ","وَقَبلَهُما لَم يَقرَعِ النَجمَ حافِرُ",74,"ر",1,0],["وَأَورَدَها أَعلى قَلونِيَّةَ اِمرُؤٌ","بَعيدُ مُغارِ الجَيشِ أَلوى مُخاطِرُ",74,"ر",1,0],["وَأَوقَعَ في جُلباطَ بِالرومِ وَقعَةً","بِها العَمقُ وَاللُكّامُ وَالبُرجُ فاخِرُ",74,"ر",1,0],["وَأَوطَأَها بَطنَ اللُقانِ وَظَهرَهُ","يَطَأنَ بِهِ القَتلى خِفافٌ خَوادِرُ",74,"ر",1,0],["وَأَولى الرِجالِ بِعَتبٍ أَخٌ","يَكُرُّ العِتابَ عَلى مُعتِبِ",75,"ب",1,0],["وَأَورَدوا وَحِياضُ المَجدِ طامِيَةٌ","فَدَلَّ حَوضَهُمُ الوُرّادُ فَاِنهَدَرا",76,"ر",2,0],["وَأَوصَدَ سَدّاً مِن حَديدٍ أَذابَهُ","وَمِن عَينِ قِطرٍ مُفرَغاً لَيسَ يَظهَرُ",77,"ر",1,0],["وَأَوَّلُ مَن آوى النَبِيَّ مُحَمَّداً","نَصَرنا وَآوَينا نَذُبُّ وَنَنصُرُ",77,"ر",1,0],["وأوهمني حرمانِهم ليَ حاجةً","أهبُّ لأشكو حرِّها فأهاب",78,"ب",1,0],["وأوضح الخير في دمشق فتى","كم قامَ في الخيرِ قومةً غضبه",79,"ب",2,0],["وأوْرَثتْ عيني جود كفِّكَ فانْبرت","تسحُّ بأنواءِ الغمام وتَسكُب",80,"ب",1,0],["وأودعتنَى جدوى كفه منناً","كأنها بعدُ من جفنيّ قد رشحت",81,"ت",1,0],["واوحشتي لمقامٍ منك محمود","واحسرتي لودادٍ فيك معهود",82,"د",1,1],["وأوقات أنسٍ بين شادن وشادنٍ","كما اقْترح اللذّات راءٍ وسامع",83,"ع",1,0],["وأودعتها قلبي وصبريَ والكرى","وحكم الهوى أن لا تردُّ الودائع",84,"ع",1,0],["وأوجهاً كخلاص التبر قد جليت","على الحمام عليها لؤلؤ العرق",85,"ق",1,0],["وأوحش الثغر من مرأى محاسنه","فما يكاد بوجه الدهر يبتسم",86,"م",1,0],["وأوحشت صدر محراب بفقد حلاً","كأنها دمعة ممَّا تلازمه",87,"م",2,0],["وأودعت قلبي في ثراها مقبلاً","كأني لهاتيك الودائع أختم",88,"م",1,0],["وأولى الندى حتى اقتنى الحمد مخلصاً","فأكرم بما أولى وأعظم بما اقتنى",89,"ن",2,0],["وأَوْعدتُهَا تَنْكِيرَكَ النُّكْرَ صادقاً","فقلت رُوَيْداً تَنْجَلي الغمراتُ",90,"ت",1,0],["وأوْقَرُ من رَضْوَى ولو شاء نَسْفَهَا","إذن لم يُلِقْها طَرْفَةَ العَيْن مَرْكَدُ",91,"د",1,0],["وأَوْلَى امْرئٍ أنْ تَشمَلُوهُ بفضلكم","نَقِيذُكُمُ والموتُ أسْودُ أربَدُ",91,"د",1,0],["وأولادُنا مثْلُ الجَوارح أيُّها","فقدْناه كان الفاجِعَ البَيِّنَ الفقدِ",92,"د",1,0],["وأوجب الشكرَ على مُنقَذٍ","من سطوة لم يك منها معاذْ",93,"ذ",1,0],["وأُورد حوضاً ظلَّ عقد وروده","يجود بماء النفس والبحر قالسه",94,"س",2,0],["وأوهنْتَ ركني للعدى فتركْتَني","لمن رامني بالضَّيم عظماً مُرضَّضا",95,"ض",2,0],["وأوضح لي المشيبُ سبيلَ رشدٍ","وكنتُ كخابطٍ عَشواءَ ليلِ",96,"ل",1,0],["وأوضاح الأغرّ مفضَّلاتٌ","ولكن دونَ غرِّتهِ الحُجُولُ",97,"ل",1,0],["وأوْدعْتُها حسرةً بالعفافِ","ووفرتُ دِيني فلم أثلمِ",98,"م",1,0],["وَأَولادُ الصَريحِ مُسَوَّماتٍ","عَلَيها الأُزدُ غُضفاً وَالنِمارُ",99,"ر",1,0],["وَأَورى بِزَندَيهِ وَلَو كانَ غَيرُهُ","غَداةَ اِختِلافِ الأَمرِ أَكبى وَأَصلَدا",100,"د",2,0],["وَأَوجُهِ مَوتورينَ فيها كَآبَةٌ","فَرَغماً عَلى رَغمٍ وَوَقراً عَلى وَقرِ",101,"ر",1,0],["وَأَوحَت لَها عَينايَ أَنَّ صَبابَةً","تُلَجلِجُ في صَدري وَأَحذَرُ أَن تَبدو",102,"د",2,0],["وَأَولى بِهِ كَوكَبٌ طالِعٌ","عَلى سُهَّدٍ وَعَلى هُجَّعِ",103,"ع",1,0],["وَآوِنَةً تُناجيها","دَراري الأُفقِ بِالوَصلِ",104,"ل",1,0],["وَأَوشَكَ أَن يَهتَزَّ في كُلِّ ساعِدٍ","لِكُلِّ أَبِيٍّ كُلُّ سَيفٍ وَصارِمِ",105,"م",1,0],["وَأَودَعَت فيكِ الصَبا هَمسُها","وَخَبَّأَ الأَسرارَ فيكِ الظَلام",106,"م",1,0],["وَأَوسَعتُهُ لَمّا أَتاني بَشاشَةً","وَلُطفاً وَتَرحيباً وَخُلقاً وَمَنزِلا",107,"ل",2,0],["وَأَولَيتَني ما لَم أَكُن أَستَحِقُّهُ","وَإِنّي لَداعٍ ما حَيِيتُ وَشاكِرُ",108,"ر",1,0],["وَأَولَيتَني مِن بِرِّ فَضلِكَ أَنعُماً","غَدا كاهِلي عَن حَملِها وَهوَ موقَرُ",109,"ر",1,0],["وَأَورَقَ مُذ عَهدِ اِبنِ عَفّانَ حَولَهُ","حَواضِنُ أُلّافٌ عَلى غَيرِ مَشرَبِ",110,"ب",1,0],["وَأَوسُ بنُ مَغراءَ الهَجينُ يَسُبُّني","وَأَوسُ بنُ مَغراءَ الهَجينُ أُعاقِبُه",111,"ب",2,0],["وأَوْحى إليه مَزامِيرَهُ","فغنَّتْ بها في الظَّلامِ الحُزُونْ",112,"ن",1,0],["وَأَوَدُّ أَنْ أَحيا بفِكْرَةِ شاعرٍ","فأَرى الوُجُودَ يضيقُ عَنْ أَحلامي",113,"ي",1,1],["وَأَوَّلُ ما قادَ المَوَدَّةَ بَينَنا","بِوادي بَغيضٍ يا بُثَينَ سِبابُ",114,"ب",1,1],["وأود إن راموا انتقادي ميتا","أن لا يكون من العداة قضاتي",115,"ي",1,0],["واود لو راموا انتقادي ميتا","ان لا يكون من العداة قضاتي",116,"ي",1,0],["واول شرط ان يكون بمعزل","عن الحنث في الاقسام والكذب في الوعد",117,"د",1,0],["وأوحشت الدنيا كأن بيوتها","بعيني وإن كانت قصوراً خرائب",118,"ب",1,0],["وأُوردت الهوان فلم تُعافى","فأين تحدثي أين الإباءُ",119,"ا",2,0],["وأوعز بالعقال إلى شباب","رجعت بهم إلى عصر النياق",120,"ق",1,0],["وأوفرلَند أدركها كُساح","فليت كساحَها في ركبتيا",121,"ي",2,0],["وَأَومَأَ الحِمارُ بِالعَقيرَة","يُريدُ أَن يُشَرِّفَ العَشيرَه",122,"ه",1,0],["وَأَوَدُّ أَنَّكُمُ رِجا","لٌ مِثلَ والِدِكُم كِبار",123,"ر",1,0],["وَأَوما إِلى ظُلُماتِ القُرونِ","فَشَقَّ عَنِ الفَنِّ أَسدالَها",124,"ل",3,0],["وَآوِنَةً لَدى مَجرىً سَحيقٍ","كَما الشَلّالُ قامَ لَدَيهِ نَهرُ",125,"ر",1,0],["وَأَودَعَ الجُدرانَ مِن نَقشِهِ","بَدائِعاً مِن فَنِّهِ المُفرَدِ",126,"د",1,0],["وَأَوفى حَياةِ الغابِرينَ لِصاحِبٍ","حَياةُ اِمرِئٍ خانَتهُ بَعدَ مَشيبِ",127,"ب",1,0],["وَأَوهِمُ أَنَّ في الشِطرَنجِ هَمّي","وَفيكَ تَأَمُّلي وَلَكَ اِنتِصابي",128,"ي",1,0],["وَأَورِدُ نَفسي وَالمُهَنَّدُ في يَدي","مَوارِدَ لا يُصدِرنَ مَن لا يُجالِدُ",129,"د",1,0],["وَأَوجُهُ فِتيانٍ حَياءً تَلَثَّموا","عَلَيهِنَّ لا خَوفاً مِنَ الحَرِّ وَالبَردِ",130,"د",1,0],["وَأَوحَدَتهُ وَما في قَلبِهِ قَلَقٌ","وَأَغضَبَتهُ وَما في لَفظِهِ قَذَعُ",131,"ع",1,0],["وَأَوَّلُ رَأيَةٍ رَأيا المَعالي","فَقَد عَلِقا بِها قَبلَ الأَوانِ",132,"ن",1,0],["وَأَوَّلُ لَفظَةٍ فَهِما وَقالا","إِغاثَةُ صارِخٍ أَو فَكُّ عانِ",132,"ن",1,0],["وأولي مداراةَ الشَموسِ جماحَكُمْ","وتولونني صَدَّ الجِيادِ العوادمِ",133,"م",1,0],["وأولى امرئٍ بالنُّجْحِ صاحبُ حاجةٍ","تشفَّعْتُ فيها والليالي خصيمُها",134,"م",3,0],["وأودعتُكم قلبي فلما طلبتُهُ","مَطلتمْ وشرُّ الغارمينَ مَطُولُ",135,"ل",1,0],["وآوي إليهِ وهو رَوْضَةُ جَنَّةٍ","بدائِعُها يَخْتَلْنَ في حُلَلٍ خُضْرِ",136,"ر",1,0],["وَأَوطَأَني الأَيّامُ أَعقابَ مَعشَرٍ","لَهُم أَوجُهٌ قَد بَرقَعَتها الجَلامِدُ",137,"د",1,0],["وأوصوا بيَ الأيامَ خيراً فإنها","بكمْ تقتدي فيما تُمِلُّ وتنسَخُ",138,"خ",1,0],["وَأَوقَدتَ ناقوسَها وَالصَلي","بَ تَحتَ عَشائِكَ حَتّى يَضِج",139,"ج",1,0],["وَأَولَيتَ مِن إِحسانِكَ الجَمِّ نائِلاً","يُذَكِّرُني ما قَد نَسيتُ مِنَ الوُدِّ",140,"د",1,0],["وَأوثِرُ عَنسي في المَهامِهِ وَالفَلا","عَلى قُربِ عِرسي في السَواجيرِ أَو أُثري",141,"ر",2,0],["وَأَوقَعتُ حِلفاً بَينَ شِعري وُجودِهِ","إِذا لَم تُناسِب في الثَراءِ فَحالِفِ",142,"ف",1,0],["وَأَوحَشَها مِن يوسُفٍ حَملُ يوسُفٍ","عَلَيها المَعالي جامِعاً وَمُفَرِّقا",143,"ق",2,0],["وَأولِعتُ بِالكِتمانِ حَتّى كَأَنَّني","طُويتُ عَلى ضِغنٍ مِنَ الدَينِ أَو وَغمِ",144,"م",1,0],["وَأَوفِ لَنا الكَيلَ حَتّى نَعُد","دُ قَبيحَكَ في بَيعِناها حَسَن",145,"ن",1,0],["وَأَورَثَكَ الراعي عُبَيدٌ هِراوَةً","وَماطورَةً تَحتَ السَوِيَّةِ مِن جِلدِ",146,"د",1,0],["وَأَوثَقُ مالٍ عِندَ ضَبَّةَ بِالغِنى","إِذا اِحتَرَبَ الناسُ الإِباحَةُ وَالقَسرُ",147,"ر",1,0],["وَأَوصى الفَرَزدَقَ عِندَ المَماتِ","بِأُمِّ جَريرٍ وَأَعيارِها",148,"ر",3,0],["وَأَوقَدَتِ الشِعرى مَعَ اللَيلِ نارَها","وَأَمسَت مُحولاً جِلدُها يَتَوَسَّفُ",149,"ف",1,0],["وَأَوَّلُ ما ذاقا لَدُن فَطَمَتهُما","دَمٌ وَبَنانٌ مِن صَريعٍ وَمِعصَمُ",150,"م",1,0],["وأومضَ ناجِذاك بلا ابتسامٍ","ومُدَّت رَاحتاك بلا نَوال",151,"ل",1,0],["وأواخرٌ شَهِدَت له","بمناقبِ السَّلَفِ الأوائِل",152,"ل",1,0],["وَأَودُّ لو فَعَلَ الحيا بِسهولهِ","وحُزونِه فعلَ الأميرِ بآملِ",153,"ل",1,0],["وأَومَضَ بَرقٌ كما أومَضَتْ","يَدُ البِكْرِ زَيَّنَها البارِقُ",154,"ق",1,0],["وأَومَضَتْ من خِلالِ السِّجْفِ بارِقَةٌ","أطاعَها مَطَرُ الأجفانِ تَذرافا",155,"ف",2,0],["وأومَضَ لي من جُودِ كَفِّكَ لامِعٌ","وما الغَيْثُ إلا حيثُ يُومِضُ لامِعُه",156,"ع",2,0],["وأوجهُ الأيامِ مبيضة","تُخبرُ عن رِقَّةِ أكبادِها",157,"د",3,0],["وأوردْتَ حَدَّ السَّيفِ قِمَّةَ لاوُنٍ","لتمزُجَ فيه سُورةَ البأسِ بالنَّدى",158,"د",2,0],["وأورَدَها الخليجَ وقد تساوَتْ","بجُمَّتِها التَّهائمُ والنُّجودُ",159,"د",1,0],["وَأَوجَبَ لي وِلايَتَهُ عَلَيكُم","رَسولُ اللَهِ يَومَ غَديرِ خَمِّ",160,"م",1,0],["وَأَوصاني النَبيُّ عَلى اِختيارٍ","بِبَيعَتِهِ غَداةَ غَدٍ بِرَحمِ",160,"م",1,0],["وَأَوصى بِي لِأُمَتِهِ لِحُكمي","فَهَل فيكُم لَهُ قدمٌ كَقدمي",160,"ي",1,0],["وَأَوقَدَت نيرانَها تَغويلا","وَقَرَعت مَع عَزفِها الطُبولا",161,"ل",2,0],["وَأَوطَنَتِ المَكارِهُ وَاِطمَأَنَّت","وَأَرسَت في أَماكِنِها الخُطوبُ",162,"ب",1,0],["وَأَوسَطُ بَيتٍ في قُرَيشٍ لَبَيتُهُ","وَأَوَّلُ عِزٍّ في قُرَيشٍ وَآخِرُه",163,"ر",2,0],["وَأَورَدَنا مِن جودِ كَفَّيهِ نِعمَةً","وَصَيَّرَ جَنّاتِ النَعيمِ لَنا مَأوى",164,"و",2,0],["وَأَوضِح لَهُ الأَمرَ إِذا ما اِلتَبَسا","مِن غَيرِ جَعلِ رَأيِهِ مُنعَكِسا",165,"س",2,0],["وَأَوَدُّ فِعلَكَ لِلجَميلِ مَخافَةً","إِنَّ الطَبيعَةَ لِلمُسيءِ تُكافي",166,"ف",2,0],["وَأَوَدُّ أَن أُجري بِبالِكَ بَعضَ ما","يُجري مَديحُكَ وَالثَناءُ بِبالي",167,"ي",1,0],["وَأوثِرُ أَن تَعيشَ قَريرَ عَينٍ","وَأَنّي لا أَراكَ وَلا تَراني",168,"ي",1,0],["وَأَوجَبَ ذاكَ إيجاباً صَحيحاً","مُطيعاً راضِياً مِن غَيرِ قَسرِ",169,"ر",1,0],["وَأُوثِرُ أَن يَنالَ دَمي وَوَفري","وَمَحبوبي عَزيزٌ لا يُنالُ",170,"ل",1,0],["وَأَولَدَ الحُسنُ في أَحداقِهِ حَوَراً","وَضاعَفَ الدَلُّ ما بِالجِسمِ مِن تَرَفِ",171,"ف",1,0],["وأومأ لي باللحظ يسألني به","أتعرفه أومأت باللحظ مسعفا",172,"ف",2,0],["وأولو الشعر المصابيح التي","حطمتهن رياح الصحراء",173,"ا",2,0],["وَاوَحْشَتَا من فِراقِ مُؤنِسَةٍ","يميتني ذكْرُهَا ويحييها",174,"ي",3,0],["وأوانُ الهجرِ لا يُجْنى به","ثَمَرٌ كان لها الوَصْلُ أوان",175,"ن",1,0],["وأوْرَثَ الموتَ سرُّ البين حين فشا","عندي وعند حبيبٍ أورَثَ الصمما",176,"م",2,0],["وأوْدَعَ في كلّ لحظٍ رنا","إليك وفي كلّ لفظٍ سلاما",177,"م",2,0],["وأوردهمْ حياضاً في المواضي","بماءِ الموتِ ساقٍ من جمومِ",178,"م",1,0],["وَأَوجفَ حَولَيها الكماةُ ضوامراً","فَلا سنُنْبُكٌ إلّا يَساريه مِنْسَمُ",179,"م",1,0],["وأولو المكايدِ إنْ رأوا فُرصاً","ركبوا لها العزَماتِ وابتدروا",180,"ر",3,0],["وَأَوباشُها خُزرٌ إِلى العَرَبِ الأُلى","لِكَيما يَكونَ الحُرُّ مِن خَوَلِ العَبدِ",181,"د",1,0],["وَأَومَضَت عَن طَرفِها","يا حُسنَها إِذ تَطرِفُ",182,"ف",1,0],["وَأوصي غُلاماً بِالوُقوفِ بِجانِبِ ال","سِتارِ خَفِيّاً شَخصُهُ يَتَسَمَّعِ",183,"ع",1,0],["وَأَوجَعُ تَوديعِ الأَحِبَّةِ فُرقَةً","شَبابٌ عَلى رُغمِ الأَحِبَّةِ وَدَّعا",184,"ع",2,0],["وَأَولى بِهِ لَو تَدَلّى بِهِ","غُروراً وَأَولى بِهِ لَو أَدَل",185,"ل",1,0],["وَأَوطَأتُ أَحشاءَهُ أَشقَراً","كَأَنّي نَفَختُ بِهِ في ضَرَم",186,"م",1,0],["وَأَورِداها غَديراً لا عَدِمتُكُما","مِن ماءِ مُزنٍ قَريبٍ عِندَ مَرعاها",187,"ا",3,0],["وَأَوقَدَ ناراً في فُؤادِكَ مُحرِقا","غَداتَئِذٍ لِلبَينِ أَسفَعُ نازِعُ",188,"ع",1,0],["وَأَوعَدَني فيها رِجالٌ أَبَرَّهُم","أَبي وَأَبوها خُشِّنَت لي صُدورُها",189,"ر",3,0],["وَأَوفى عَلى رَوضِ الخُزامى نَسيمُها","وَأَنوارُها وَاِخضَوضَلَ الوَرَقُ النَضرُ",190,"ر",1,0],["وأَوْصُوا المسلمينَ بها فإنّي","أَراهُمْ عَن ذَخائِرها نِياما",191,"م",2,0],["وَأَوهى ضُروبِ الحُبِّ حُبٌّ مُلَثَّمٌ","يُصانِعُ خافيهِ وُشاةً وَلُوَّما",192,"م",2,0],["وأوَّبتِ البحارُ مع الرياحِ","وصفَّقَ كلُّ طيرٍ بالجناحِ",193,"ح",1,0],["وأورثَنِي خَمساً سُهَاداً وحَسرةً","ووجداً وسُقماً زائِداً وتَألُّمَا",194,"م",2,0],["وأوطَأنِي نَجم السُّرى مِن بِسَاطِهِ","ثَرًى تَحسِدُ الأقدامَ فِيهِ المَنَاسِمُ",195,"م",1,0],["وَآواهُ جِنحَ اللَيلِ ذَروُ أَلاءَةٍ","وَأَرطاةُ حِقفٍ بَينَ كِسرَي سَنائِنِ",196,"ن",1,0],["وَأَوَت بِلَّةُالكَظومِ إِلى الفَظْ","ظِ وَجالَت مَعاقِدُ الأَرباضِ",197,"ض",1,0],["وَأَوَدَّ بَعدَ حَذارِ أَن لا يَرعَوي","حَتّى يُميتَ وَريدَ كُلِّ حَذارِ",198,"ر",1,0],["وَأَورَدَ أَهلَ الماءِ غِيّاً وَأَفصَحَت","حَمامَةُ أَيكٍ ناضِرٍ بِهَديرِ",199,"ر",1,0],["وَأَوصى عادِيا قِدماً بِأَن لا","تُهَدِّم يا سَمَوأَلُ ما بَنَيتُ",200,"ت",1,0],["وَأولِعوا بِالحَكِّ وَالتَفَرُّكِ","وَعَصَبُ الآباطِ مِثلُ المَرتَكِ",201,"ك",1,0],["وَأَوثِرُ صاحِبَيَّ بِفَضلِ زادي","وَأُحيِي النَفسَ بِالبَلَلِ القَليلِ",202,"ل",1,0],["وَأَوَّلُ مَن ظَلَّ في مَوقِفٍ","يُصَلّي مَعَ الطاهِرِ الطَيِّبِ",203,"ب",1,0],["وأولى بلَوْمٍ من أُمَيّةَ كُلّها","وإن جَلّ أمْرٌ من مَلامٍ ولُوَّم",204,"م",1,0],["وأُوردتْ خيْلُه ماءَ الفُراتِ فما","صَدَرْنَ حتى وَصَلْنَ العَلَّ بالنهَل",205,"ل",1,0],["وأورى بزند الأرقمِ الصِّلّ جعفَرٌ","ولم يُعْيِهِ فَتْقُ من الأرضِ يَرتقُهُ",206,"ق",2,0],["وأوحَتْ إلينا الوَحشُ ما اللّهُ صانِعٌ","بنا وبكم من هوْل ما نتسمّع",207,"ع",1,0],["وأوصيتَهُ فيهم برِفقكَ مُرْدَفاً","بجودكَ معقوداً به عهدُك البَرُّ",208,"ر",1,0],["وَأَورَقَ حالِفَ المَثواةِ هابٍ","كَضاوِيِّ الفِراخِ مِنَ الهُلاسِ",209,"س",1,0],["وَأَودى بَعدَهُم بِاِبنَي مَصادٍ","فَوارِسُ دينُ قُومِهُمُ المُغارُ",210,"ر",1,0],["وَأَوصاهُمُ أَهلُ الأَمانَةِ وَالتُقى","فَما حُفِظَت بَعدَ المَغيبِ وَصاةُ",211,"ص",3,0],["وَأَوصالَ جِسمٍ لِلتُرابِ مَآلُها","وَلَم يَدرِ دارٍ أَينَ تَذهَبُ رَوحُها",212,"ح",3,0],["وَأَوطَنّا الدِيارَ بِكُلِّ وَقتٍ","فَأَلفَينا الرَوابِيَ كَالوِهادِ",213,"د",1,0],["وَأَوادِمُ الزَمَنِ الطَويلِ كَثيرَةٌ","وَأَوادِمُ الطَعمِ الشَهيِّ أَوادِ",214,"د",1,0],["وَأَودَت بَنو وَبَرٍ وَبَبرٍ فَما حَمى","عَزيزٌ وَلا شُمٌّ تَوَقَّلَ وَبرُها",215,"ر",3,0],["وَأَولى بِها مِن بَيتِ مَكَّةَ بَيتُها","إِذا هِيَ قَضَّت حَجَّها وَاِعتِمارَها",216,"ر",3,0],["وَأوثِرُ أَن أَصونَهُمُ بِجُهدي","وَكَيفَ إِثارَتي وَالمَوتُ إِثري",217,"ر",2,0],["وَأَودِعهُم عَلى كُرهٍ ثَراهُم","فَأَرضُ القَومِ خالِيَةُ العِراصِ",218,"ص",1,0],["وَأَوتادُ أَبياتٍ مِنَ الشِعرِ حُزتُهُ","كَأَوتادِ بَيتِ الشَعرِ حينَ تَوَسَّطُ",219,"ط",1,0],["وَأَودى بِظَلمِ الثَغرِ صُبحٌ وَحِندِسٌ","مَتى يَنظُرا في نَيِّرِ العَينِ يُظلِمِ",220,"م",1,0],["وَأَوقَدَ الناسُ فَوقَ أَرضِهِمُ","أَمثالَها مِن مُجَمَّعِ الضَرَمِ",221,"م",1,0],["وَأَوقاتُ الصِبا في كُلِّ عَصرٍ","أَراقِمُ وَالمَنِيَّةُ ما قَلَسنَه",222,"ن",2,0],["وَأَوقَدتِ لي نارَ الظَلامِ فَلَم أَجِد","سَناكِ بِطَرفي بَل سِنانَكِ في ضِبني",223,"ي",1,0],["وَأَوانِسٍ مِثلِ الدُمى","حورِ العُيونِ قَدِ اِستَبَينا",224,"ن",2,0],["وَأَوارِيَّ قَد عَفَونَ وَنُؤياً","وَرُسوماً عُرّينَ مُذ أَحوالِ",225,"ل",1,0],["وَأَوظِفَةٌ أيِّدٌ جَدلُها","كَأَوظِفَةِ الفالِجِ المُصعَبِ",226,"ب",1,0],["وأَوَّلٍ ليس له ابتداءُ","وآخِرٍ ليس له انتهاءُ",227,"ا",2,0],["وأَوثَقَ الإمامَ بالعهودِ","وجَعَلَ اللَّهَ منَ الشُّهودِ",227,"د",1,0],["وأوْرَدَ النَّارَ مِنْ أَرواحِ مارِقَةٍ","كادَتْ تَمَيّزُ مِنْ غَيْظٍ لَها النّارُ",228,"ر",1,0],["وأُوَيْقَاتٍ بِوادٍ سَلَفَتْ","فيهِ كانت راحَتي في رَاحَتَي",229,"ي",1,0],["وأوقاتُ الفتى إما نحوس","تدور على المصائب أو سعود",230,"د",1,0],["وأوسع ما تلقاه صدراً وخلفه","رماءٌ وطعنٌ والأمام ضراب",231,"ب",1,0],["وأوّل دايةٍ رأيا المعالي","فقد علقا بها قبل الأوان",232,"ن",1,0],["وأوّل لفظةٍ فهما وقالا","إغاثة صارخٍ أو فكّ عاني",232,"ن",2,0],["وأوْما إِليها فطاروا بها","مَدى اللمح ثُمَّ تلاشتْ خيالا",233,"ل",2,0],["وأوْلِهِ العطفَ الذي أمَّلا","فإنهُ أولى بعطفِ الإلهْ",234,"ه",1,0],["وأومأتْ بالهوى عاليُّ فاعتنقتْ","من حولنا ثَمَّ أظلالٌ وأضواءُ",235,"ا",2,0],["وأوفتْ على عالَمٍ لم يكنْ","غريباً على أمسِها الدَّابرِ",236,"ر",1,0],["وأورثه جُنَّةً بالرحيقِ","وأحرِمهُ رَشفَاتِ القُبَلْ",236,"ل",1,0],["وأولُ أنمُلةٍ صوَّرَتْ","وخَطَّتْ على اللوحِ قبل القَلمْ",236,"م",1,0],["وأوقدُ ناري كي تراني وأنثني","لأطلقَ ألحاني وأدعوكَ مَوهِنا",237,"ن",2,0],["وأوّلُ ما يَكونُ اللّيْثُ شِبْلٌ","ومَبْدَأُ طَلْعَةِ البَدْرِ الهِلال",238,"ل",1,0],["وأوّل العهد بعزّ الملّه","وبارتداء المشركين الذّله",239,"ه",1,0],["وأَوْجعُ مَظْلُومٍ لقَلْبٍ وذِي حِجىً","فَتى عَربيٌّ تزدريهِ أَعاجِمُ",240,"م",1,0],["وَأَورَقَ فيها الآسُ وَالضالُ وَالغَضا","وَنَبقٌ وَنِسرينٌ وَوَردٌ وَعَوسَجُ",241,"ج",1,0],["وأُوتِيا المُلكَ والأنجيلَ نَقرَؤُهُ","نَشفي بِحِكمتَهِ أَحلامَنا عِلَلا",242,"ل",2,0],["وَأَوَاناً تَأْسَى عَلى الذِّكْرِ حَتَّى","لَيُلِينُ البُكَاءُ صُمَّ الصخُورِ",243,"ر",1,0],["وَأُوتِيَ حَظّاً فِي بَنِيهِ وَزَوْجِهِ","كَرِيماً عَلَى قَدْرِ المُرُوءَةِ وَالعَقْلِ",244,"ل",1,0],["وأُولُو الأَمْرِ فِي العُروبَةِ لَمْ","يُخْطِئْهُمْ فِي الجُمَيّلِ التَّقْديرُ",245,"ر",1,0],["وَأَوْحَى إِلَيهِمْ مِنْ أَفانِينِ بِرِّه","أَفانِينَ ما فِي الْعَالَمِينَ مِنَ الْبِرِّ",246,"ر",1,0],["وَأَوْدَت بِمِلءِ العَينِ أَرْوَعَ بَاذِخٍ","سَمَا كلَّ نِدٍّ هَامَةً وَسمَا قدْرَا",247,"ر",2,0],["وَأَوْلُوهُ نَصْراً عَلَى طارِئٍ","يُبِيدُ الشَّبَابَ إِذَا مَا انْتَصَرْ",248,"ر",1,0],["وَأَولُوْنَا القَلاَئدَ فِي حِلاَهَا","تَنَافَسَ الاِرْتِجَالُ وَالاِحْتِفَالُ",249,"ل",1,0],["وَأَوْدَعَ الشِّعْرُ فِيهِ زِينَتَهُ","مِنْ كلِّ ضَرْبٍ بِحُسْنِهِ أَدْلَى",250,"ل",2,0],["وَأُولِي عِلْمٍ عَلى تَأْدِيبِهِ","أَنْفَقوا مِنْ عِلْمِهِمْ مَا جَلَّ ذُخْرَا",251,"ر",2,0],["وَأَوْرَثُوْكُمْ فَخَاراً بِانْتِسًابِكُمْ","إِلى أُولَئِكُمْ الغُرِّ الأَماجِيدِ",252,"د",1,0],["وَأَولَتْهَا عَوَارِفَ سَابِغَاتٍ","عَدَوْنَ مَدَى رَغَائِبِهَا الرِّغَابِ",253,"ب",1,0],["وَآوَتْ لاَجِئاً وَشَفَتْ عَلِيلاً","وَأَنْجَتْ مُسْتَغيثاً مِنْ عَذَابِ",253,"ب",1,0],["وأَوْرَدَهَا مَوَارِدَ مِنْ صَفَاءٍ","مُحَلاَّةً مُحَلَّلَةَ الكُؤُوسِ",254,"س",1,0],["وَأولى بِهِ مَن كانَ مِثلَكِ حازِماً","يُذَبِّبُ عَن أَطرافِهِ وَيُقارِعُ",255,"ع",1,0],["وا واه لو تبصرين العذاب المكبل","في نظراتي وفي كلماتي",256,"ي",1,0],["وا واه لو تلمحين الخناجر","ترضع من ضحكاتي",256,"ي",1,0],["وَأَورَينَ قَدحاً بالجَوى في جَوانِحي","وَفَرَّقنَ دَمعي أَن وَسَطنَ بِهِ جَمعا",257,"ع",2,0],["وَأَوطَنَها الثَرى لا بَل","رِياضُ الخُلدِ أَوطَنَها",258,"ن",3,0],["وَأَوأَدَها لِمَولودٍ","تَنشب فيهِ برثنها",258,"ن",3,0],["وأوحشَت الدار من بعدهم","أظَلُّ على ذكرهم مستكينا",259,"ن",2,0],["وأَوْلَوْكَ أَلْقَاباً نَواصعَ كالضُّحا","ضِخاماً على آثارِ فَضْلكَ شُهَّدا",260,"د",2,0],["وَأَوْدَى الزَّهاوِي فانْتَهى مَلْعَبُ النُّهَى","وأُطْفِئَتِ الأَنْوارُ وانْفَضّ سَامِرُهْ",261,"ر",2,0],["وأوى السجون كما أواها يوسفٌ","حيًّا، فلما مات مات طريدا",262,"د",2,0],["وأولئك الشُّمُ الأُباةُ أُخَّوتي","والمكرُماتُ شعارُهم وشِعاري",263,"ر",2,0],["وآويْتُ الأرامل واليتامى","ولم أتركْ شريدًا بالعراء",264,"ا",2,0],["وأوتر القوس في آفاقه قزح","يرمي قد راح أنهارا وغدرانا",265,"ن",2,0],["وأوشكت أن تضل القصد زائرة","لولا أني كنت في باق من الرمق",266,"ق",1,0],["وَأَوفَتِ الفُدرُ مِنَ الأَوعالِ","مُرتَدِياتٍ بِقِسِيِّ الضالِ",267,"ل",1,0],["وأوطنت المكارهُ واستقرت","وَأَرْسَتْ فِي أَمَاكِنِهَا الخُطُوْبُ",268,"ب",1,0],["واولاءِ رهطُ الجنَّ بين نديّهم","يُقيمون من سحرٍ رواقا مطنّبا",269,"ب",2,0],["وآوتْ من الأديانِ شتَّى وأطْلَعَتْ","مِن الخطراتِ النيّراتِ بها شُهْبا",270,"ب",2,0],["وأوعدني بعد المماتِ احتفاءةً","يجوِّدُ فيها المُنشدون المراثيا",271,"ي",2,0],["وأوفقُ منه أنظمةٌ تُماشي","حياةَ الناسِ تُبتدَعُ ابتداعا",272,"ع",2,0],["وأوجفتِ الشعوبُ على صداها","وقد عابَ العِيانُ بها السَماعا",273,"ع",2,0],["وأولاْءِ الذينَ لهمْ وجوهٌ","تُحَبِّبُ ، أو تُعَطِّفُ ، أو تخيف",274,"ف",1,0],["وأوشكَ هذا النسيجُ اللصيقُ","بنَهديك من فَرْحةٍ يهتِف",275,"ف",1,0],["واودَعوا لغلاظٍ من \" زَبانيةٍ \"","حَمْقى حراسة قِرطاسٍ لهم وُضِعا",276,"ع",2,0],["وأوجع ما تَلقَى النفوس نكايةً","مَعِزّةُ أفرادٍ بذُلِّ أكاثر",277,"ر",1,0],["وأوصاه شرّاً بالزبيريِّ منذرِا","وأوصاه خيراً بالحسَين فأعذَرا",278,"ر",2,0],["وأوسعَها الرَذاذُ السَحُّ لَثْماً","فَفيها مِنْ تحرُّشِهِ اضطِراب",279,"ب",1,0],["وأوقفتَ نفسك للمدعين","سموّ المقاصدِ بالمرصد",280,"د",1,0],["وأولاءِ \" أغمارٌ \" فلا رأسٌ ولا","كَعبٌ ، ولا خَلفٌ ، ولا قُدام",281,"م",1,0],["وأولاءِ \" أشرارٌ \" لأنّ شعارهم","بين الشُعوب محبَّةٌ وسلام",281,"م",1,0],["وأولاءِ شُغْلُهم بالبطونِ","فهلاّ استعانوا بشدِّ المِعى",282,"ا",1,0],["وَأوْفِ لَنا الكَيْلَ حتّى نَعُدّ","قَبيحَكَ في بَيعِنَاها حَسَنْ",283,"ن",1,0],["وأوراقَ مذْ عهدِ ابنِ عفّانَ حولهُ","حواضنُ ألاّفٌ على غيرِ مشربِ",284,"ب",1,0],["وأومت بجفن العين واحتار دمعها","لتقتلني مملوحة الدّلّ مانع",285,"ع",1,0],["وأوصى عادياً بأن لا","تخرِّب يا سموأل ما بنيتُ",286,"ت",1,0],["وأوجعُ ما يُصمي الغيورَ مقْاصرٌ","أطلَّتْ على مجحورةٍ في الزرائب",287,"ب",1,0],["وَأوْفَى حَيَاةِ الغَابِرِينَ لِصاحِبٍ","حَياةُ امرِىءٍ خَانَتْهُ بَعدَ مَشيبِ",288,"ب",1,0],["وأوعدني فيها رجال أبوهم","أبي وأبوها خُشِّنَتْ لي صُدورُها",289,"ر",3,0]]}