www.aldiwan.net/poem68378.html","الخفيف"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88609","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86992","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59757","الرمل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101582","الرمل"],[1933,"","https://poetry.dctabudhabi.ae/diwan/poem/144319","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202066","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109329","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77318","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93634","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93800","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58413","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74178","الرمل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48310","الخفيف"],[412,"","https://poetry.dctabudhabi.ae/diwan/poem/31277","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120506","الخفيف"],[4916,"معلوق قلبي ياعرب يطلب الثار","https://www.poetsgate.com/ViewPoem.aspx?id=135643",""],[5050,"أسعد الأقوام في الحرب البطل","https://www.poetsgate.com/ViewPoem.aspx?id=38205",""],[3591,"أحبكمَ والشاهداتُ الحواسدُ","https://www.poetsgate.com/ViewPoem.aspx?id=149376",""],[5121,"دولة الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=33514",""],[5136,"أسد غودر في القاع الجدد","https://www.poetsgate.com/ViewPoem.aspx?id=121559",""],[5307,"حيّ جيلٍ يا بِلَمْثَالي","https://www.poetsgate.com/ViewPoem.aspx?id=10538",""],[5358,"يمن أنت يا يمن","https://www.poetsgate.com/ViewPoem.aspx?id=206165",""],[5370,"أخر موعد","https://www.poetsgate.com/ViewPoem.aspx?id=81636",""],[5815,"خَلَجات","https://www.poetsgate.com/ViewPoem.aspx?id=190305",""],[5956,"لو أتى السيّاف","https://www.poetsgate.com/ViewPoem.aspx?id=182114",""],[6093,"ساهرٌ والفجرُ لاحا ( مجزوء الرمل)","https://www.poetsgate.com/ViewPoem.aspx?id=175989",""],[6124,"يشاطر الهدب دمعتي","https://www.poetsgate.com/ViewPoem.aspx?id=121832",""],[6259,"لست في بينها الغداة بلاحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59363&r=&rc=11",""]],"verses":[["لَو أَتَتهُ حَوالَةٌ بِحراهُ","قالَ سدّوا بِلِحيَتي بابَ جُحري",0,"ي",1,0],["لو أتَينا تلك البلاد رأينا ال","يوم منهم جَماجماً وعظاما",1,"م",2,0],["لوْ أتبعَ الناسُ أمري غيرَ معتبرٍ","إذاً لعدُّونيَ المقدامَة البطلا",2,"ل",2,0],["لَو أَتاهُ موجَعاً حاسِدُهُ","سَلَّ مِن جَنَبِ الحَسودِ السَرطانا",3,"ن",2,0],["لَو أَتَت قَبلَ نُضوجِ الطِبِّ ما","وَجَدَ التَنويمُ عَوناً فَاِستَعانا",3,"ن",2,0],["لَو أَتوا بِمَكرُمَةٍ","أَعتَبوا وَما عَتَبوا",4,"ب",3,0],["لو أتوني بالنّيرين لأعرض","ت أُريهم مطالبي والشُّقورا",5,"ر",2,0],["لو أتوْه بالتِبْر وَزْنَ ثراها","لأباهُ وقال أفدي ثراها",6,"ا",3,0],["لو أتاهُ في عرْسِهِ شَطْرُ فَلْسٍ","لرأَى البَيْعَ رَجْلَة وشطَارَهْ",7,"ر",2,0],["لَو اِتَّبَعوني وَيحَهُم لَهَدَيتُهُم","إِلى الحَقِّ أَو نَهجٍ لِذاكَ مُقارِبِ",8,"ب",1,1],["لو أتاهُ نبأٌ عن قتله","قال وهمٌ وأحاديثُ افتراءْ",9,"ا",2,0],["لو أتاها الحُسامُ كالمُقْرَمِ الوا","رِدِ ما أصْدَرَتْهُ إلاّ عَقيرا",10,"ر",2,0],["لَو أُتيحَت لِدارِمِ بنِ تَميمٍ","بِضعَةٌ مِن فَخارِكَ المُتَوالي",11,"ل",2,0],["لَو أُتيحَت لِلأَوَّلينَ لَكانَت","غُرَراً في صِفاتِهِم لا حُجولا",12,"ل",2,0],["لَو أَتاها وَبَينَ أَضلُعُه العَط","فُ للاقى في صَدرِها الصَلبِ صَخرا",13,"ر",2,0],["لو أتى الذنْبُ منك في غيرِ سهوٍ","لقبِلنا الإنصاف والانتصافِ",14,"ف",1,0],["لَوْ أُتِيحَتْ لِلْغانِياتِ لَفَضَّلْ","نَ بِها الْمُنْفِساتِ مِنْ كُلِّ عِقْدِ",15,"د",1,0],["لَو أَتانا بَعدَ الرَّسولِ مِنَ اللَ","هِ رَسولٌ لَكُنتَ لا شَكَّ ذَلِك",16,"ك",1,0],["لو أتي الصب صبره وهو يسعى","ما تصدى له ولو مات صداً",17,"د",2,0],["لَو أتَت بَحراً فَعَزّت سُفُنٌ","أوجَدَت فِيهِ طَرِيقاً يَبَسا",18,"س",2,0],["لو أَتَتْنِي صحيفَتِي في حَياتِي","قلتُ خُذها فانظرْ قبائِح ذَنبِي",19,"ب",2,0],["لو اترشح يا هذا فقلت لهم","لا بل ولكن إنفي صار ميزابا",20,"ب",2,0],["لَو أَتانا كانونُ بِالثَلجِ فيهِ","لَغَنَينا بِها عَنِ الكاتونِ",21,"ن",1,0],["لو أتّقي الرّجْمَ من شُهبِ النِصالِ لَما","في الليلِ نلتُ عِناقَ الشمسِ في الكُلَلِ",22,"ل",1,0],["لَو أَتى معلناً بِيَوم رَداها","لاِنثَنى غانماً من الحِرمانِ",23,"ن",1,0],["لَو أَتَتكَ الدُنيا بِما قَد أَتَتهُ","لاِستُقِلَّت عَلى يَدَيكَ المِئينُ",24,"ن",1,0],["لَو أَتاه أَبو الاطباء لقمان","سقيما لقال صف لي دواء",25,"ا",1,0],["لو اتخذت أَعداؤه النجم ملجأً","غَزاها عَلى شهب مِن الخَيل سُبَّق",26,"ق",1,0],["لو أتى غير الرَّدَى","لحتْ نارُ الوطيس",27,"س",1,0],["لو أتى هذا الزمان القدما","ضرسوا أيديهم بالضرس",28,"س",1,0],["لو أتاه هجوده وشفاه","كان يشتاق سقمه وسهاده",29,"د",2,0],["لو أتاك الحمام شخصا لردته","سيوف العراق وهو قتيل",30,"ل",1,0],["لو أتقنوا فيك العلوم لأدركوا","شأو العلى وعلوا على الأقران",31,"ن",1,0],["لَو أَتانا شِعرُ ريمٍ","لَجَعَلناهُ عِبادَه",32,"د",2,0],["لَو أَتى البَحر وَهُوَ طام لِيَروي","مِنهُ أَظماءه لعاد يَبيسا",33,"س",2,0],["لو أتاها الشيطان يسترق السم","ع رماه شهابنا بانتكاس",34,"س",1,0],["لو أتَوهُ بِخَطِّ قفطِ بن نوحٍ","قالَ هذا خَطي وَهذا مَقالي",35,"ل",2,0],["لَو أتوني حَضرة قَد حسنت","للموافي مُستقراً وَمقاما",36,"م",2,0],["لوْ أتَى قيصَرٌ لقَصّرَ عنْهُ","ولألْقى كِسْرَى لهُ تيجانَهْ",37,"ن",2,0],["لَو أَتَتهُ الرُكبانُ تَمتاحَهُ النَف","س وَحاشاهُ مِنهُ قالَ امتاحي",38,"ح",2,0],["لو اتته بكل ما شاق منها","لم تلته لتلكم الدار ومقا",39,"ق",2,0],["لوّ اتحكّم في تصاريف الاقدار","ماشفتني يوم الوداع اتحاشى",40,"ش",2,1],["لو أتاهم بقروش عابد","صنما لاتبعوه وأضل",41,"ل",1,0],["لو اتصلت تلك الثنايا ببعضها","لما افترقت بالشكل تلك الفرائدُ",42,"د",1,0],["لو أتى طيفُ الكرى حسًّا بروحي","كنتُ أقضي الليلَ سكنَى بالكحيل ِ",43,"ل",1,0],["لو أتى الزهر أتيت المصطفى","آه مما ناله يوم الأحد",44,"د",1,0],["لو اتْجِدّ أوتْبغي اتْنالي","لَغْلِبّيِه إِتْخَسِر شُوْفَه",45,"ف",2,0],["لو أتى طامعٌ لهُ","ردَّ يلتفُّ بالكفَنْ",46,"ن",1,0],["لو اتعلّق فيه ماينفع ابكاي","خلاص فات الوقت واعلن فواته",47,"ت",2,0],["لو‎ ‎أتقنُ‎ ‎الهجران‎ ‎ما‎ ‎عصف‎ ‎النوى","ولما‎ ‎عصرت‎ ‎الكرْمَ‎ ‎قبل‎ ‎أوانِ",48,"ن",1,0],["لو أتى شيخٌ يعاني حالتي","نَبَذَ التشريعَ واختار النُّهى",49,"ه",2,0],["لو أتى السيّافُ يفري رَقْبتي","رفض الأمرَ وأوصى حِفْظَها",49,"ه",2,0],["لو أتى السيّافُ يرنو طيبتي","لَافْتَدى السيَّافُ عني وانتهى",49,"ه",2,0],["لو أتانا الخِلُّ يوماً","ضاحكاً يُبدي مزاحَا",50,"ح",2,0],["لَوْ أَتَانِيْ عَلَىْ شَفَا صَمَدٍ","عَلِيْلُ حَرْفٍ سَجِيْنُ غُرْفَتِهَا",51,"ت",3,0],["لو أتتهُ الركبانُ تمتاحهُ النفس","وحاشاه أن يقول أشاحي",52,"ح",2,0]]}