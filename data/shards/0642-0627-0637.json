{"poems":[[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[93,"مصر تهدي إلى بنيها السلاما","https://www.aldiwan.net/poem11323.html","الخفيف"],[31,"يا قضاة العباد إن عليكم","https://www.aldiwan.net/poem42665.html","الخفيف"],[67,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[67,"أزمعوا البين وشدوا الركابا","https://www.poetsgate.com/ViewPoem.aspx?id=3141",""],[115,"يا غائبا في القلب حاضر","https://www.aldiwan.net/poem41074.html","عموديه"],[381,"هاج رسم دارس طرباً","https://www.aldiwan.net/poem400.html",""],[452,"أحبابنا عودوا علينا عودة","https://www.aldiwan.net/poem13932.html","الكامل"],[453,"شعراء مصر ولا أقول جميعكم","https://www.aldiwan.net/poem61607.html","الكامل"],[458,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[458,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[458,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[461,"يا لقومي من تيمي دعوة","https://www.aldiwan.net/poem15136.html","الرمل"],[461,"يبدل الليل ضحى من بشره","https://www.aldiwan.net/poem16156.html","الرمل"],[464,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"]],"verses":[["قاطِعاً في الغُرورِ بُرْهَةَ عُمْري","خَسِرَتْ صَفْقَتي وخابَتْ قِداحي",0,"ح",2,0],["قَاطِعُوا كُلَّ جَاهِلٍ وَسَفِيهِ","رَاقِبُوا اللهَ فِي الْحِمَى وَبَنِيهِ",1,"ه",1,0],["قاطِناتٌ دورَ البَلاطِ كِرامٌ","لَسنَ مِمَّن يَزورُ في الظُلماءِ",2,"ا",2,0],["قاطعَ الأهلِينَ في اللَّهِ جَهْرَا","لَمْ يَخَفْ لَوْمَاً ولم يَخْشَ عابا",3,"ب",2,0],["قاطعَ الأهلِينَ في الله جَهْراً","لَمْ يَخَفْ لَوْماً ولم يَخْشَ عتابا",4,"ب",2,0],["قاطعتني وانا وحق","ك غير هجرك لا احاذر",5,"ر",1,0],["قاطِعاتٍ بَطنَ مافِقَةٍ","يبَتَدِرنَ الهَجمَ وَالقَرَبا",6,"ب",2,0],["قاطعْتَ من بعدِ التواصلِ بُرْهةً","وصدفتَ عن شتّى من العِرفانِ",7,"ن",1,0],["قاطعتموني واستبحتم سقوَتي","وكأنني ما كنت منَشدَ قَولكم",8,"م",1,0],["قاطعاتٌ أبدا ما قَطعَتْ","أنجمُ الأفقِ سَوارٍ حيثُ سِرْنا",9,"ن",2,0],["قاطعةً بمدحكم عرضَ الفلا","بين مَهاويها إلى آكامِها",10,"م",3,0],["قاطنة تحملُ أبياتُها ال","أمثالَ في المنتسِخ الراحلِ",11,"ل",1,0],["قاطنٌ ما سَدِكَ العزُّ به","فإذا ما آنسَ الضَّيْمَ ضَعنْ",12,"ن",1,0],["قاطِنٌ ما سِدِكَ المَجْدُ بهِ","فإذا آنَسَ عاراً ظَعَنا",13,"ن",2,0],["قاطعات المدى وسمنَ بطيب","الذكر عفر الوهاد والآكاما",14,"م",2,0]]}