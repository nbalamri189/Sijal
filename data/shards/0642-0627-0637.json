نَشدَ قَولكم",8,"م",1,0],["قاطعاتٌ أبدا ما قَطعَتْ","أنجمُ الأفقِ سَوارٍ حيثُ سِرْنا",9,"ن",2,0],["قاطعةً بمدحكم عرضَ الفلا","بين مَهاويها إلى آكامِها",10,"م",3,0],["قاطنة تحملُ أبياتُها ال","أمثالَ في المنتسِخ الراحلِ",11,"ل",1,0],["قاطنٌ ما سَدِكَ العزُّ به","فإذا ما آنسَ الضَّيْمَ ضَعنْ",12,"ن",1,0],["قاطِنٌ ما سِدِكَ المَجْدُ بهِ","فإذا آنَسَ عاراً ظَعَنا",13,"ن",2,0],["قاطعات المدى وسمنَ بطيب","الذكر عفر الوهاد والآكاما",14,"م",2,0],["قاطِعٌ رَأيُكَ المُسَدَّدُ في الدَه","رِ الَّذي لَيسَ يَقطَعُ الصَمصامُ",15,"م",1,0],["قاطَعتَني بُغضاً بِلا ذَنب بَدا","مني وَلم تَرجع لِحُبي الأَوّل",16,"ل",1,0],["قاطَعتَ جارك وَاتبعتَ هَواكا","وَأَضلك الشَيطان بَعدَ هُداكا",17,"ك",2,1],["قاطَعتَني يا اِبنَ وُدّي","بدونِ ذنبٍ عظيمِ",18,"م",1,0],["قاطِناً في الضّوءِ مِن شَمسِ الضّحى","في مُحيّاهُ الجميل الحَسنِ",19,"ن",1,0],["قاطني تونس لهم فلتحيّ","وَلتكبر وَلازِم الإِجلالا",20,"ل",2,0],["قاطعٌ في قِرابه ومَهيبٌ","شيمةٌ للحُسام ليس تَزول",21,"ل",1,0],["قاطعوا لندن في أسواقها","يربح الضفقة فيها الثائرون",22,"ن",1,0],["قاطعٌ عضبُهُ شقاشقَ همَّا","زٍ مناوٍ ونابزٍ غمّازِ",23,"ز",1,0],["قاطِعوا غادِرَ الجَرائِدِ إِذ لا","لا وَلا تَزجُروا بِهادٍ وَهيدِ",24,"د",1,0],["قاطعيني كما تريدين إني","بك صبٌّ حُشرتُ بين الغواة",25,"ه",1,0],["قاطِعِ المَصنوعَ في مَعمَلِهِ","وَاِمتَلِئ بُغضاً لَهُ ما اِحتَكَما",26,"م",2,0],["قاطِعٌ في اِنطِباقِهِ كَانطِباقِ الث","ثغر في العَضِّ مُبطِئاً وَعَجُولا",27,"ل",2,0],["قاطعتمونا حبكم","فإلام أنتم هاجرونا",28,"ن",2,0],["قاطع ربقة الوصال مقيم","حيث شيح الغورين ينفح طيبا",29,"ب",2,0],["قاطعاتٍ جديد حبل وصال","عالقات من الحبال برث",30,"ث",1,0],["قاطِعاً شَأفَ العِدا مُستَأصِلاً","وَعَزيماً ما وَنى فيمَن وَنى",31,"ن",2,0],["قاطعتَنا فتقطَّعَت بصُدورنا","منا قُلوبٌ حُبُّها بك واصلُ",32,"ل",1,0],["قاطعتُ أَترابي","لربعك ثُمَّ بِنتُ عن الرُبوعِ",33,"ع",1,0],["قاطع رفيقك تسلم من حبائله","فطبعه اللؤم لكن طبعك الكرم",34,"م",1,0],["قاطَعتُموني سادَتي ما بالُكُم","وَأَنا الَّذي أَغرى هَواهُ جَمالَكُم",35,"م",1,1],["قاطِناتُ الحَجونِ أَشهى إِلى قَل","بي مِن ساكِناتِ دورِ دِمَشقِ",36,"ق",1,0],["قاطعاً فيه كل ما شجَّرته","من شقاقٍ مشاجرُ الأصلاب",37,"ب",1,0],["قاطعتني لعظيم الجرم وهو لدي","خطير عفوك سهل حين أصنعه",38,"ع",2,0],["قاطعا دابر الفساد بسيف ال","حق يصري من البغاة الوتينا",39,"ن",2,0],["قاطع عرقين مدري وين وينه","قد وصلت الأرض واسمع صوت ثاني",40,"ن",2,0],["قاطع الآل ثم بارح بيتا","لِدَواع قَضَت بِذَلك شَتى",41,"ت",2,0]]}