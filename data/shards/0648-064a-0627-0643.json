px?id=190155",""],[5074,"الحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=175382",""],[5285,"سأشكو إلى الله","https://www.poetsgate.com/ViewPoem.aspx?id=203540",""],[5285,"هدير السواقي","https://www.poetsgate.com/ViewPoem.aspx?id=203583",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[5344,"لا تعجّل بالحُكم ..","https://www.poetsgate.com/ViewPoem.aspx?id=155070",""],[5344,"نواف ما مَثّل ضنا بن وايل.!","https://www.poetsgate.com/ViewPoem.aspx?id=180701",""],[5421,"تعز","https://www.poetsgate.com/ViewPoem.aspx?id=212208",""],[5495,"تغطيت","https://www.poetsgate.com/ViewPoem.aspx?id=175431",""],[5526,"مروى في حياتي وغيمه","https://www.poetsgate.com/ViewPoem.aspx?id=193117",""],[5573,"كاس الهوى ومنادم الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=200178",""],[5616,"أبا الطيب عذراً","https://www.poetsgate.com/ViewPoem.aspx?id=203454",""],[5616,"اعتراف","https://www.poetsgate.com/ViewPoem.aspx?id=205767",""],[5648,"ثاني العيد","https://www.poetsgate.com/ViewPoem.aspx?id=154663",""],[5648,"شموخ ذاتي","https://www.poetsgate.com/ViewPoem.aspx?id=154830",""],[5732,"فات الشباب ولا بقى فيه لذات","https://www.poetsgate.com/ViewPoem.aspx?id=177834",""],[5776,"الشّاعِرُ الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=206108",""],[5809,"استجابة","https://www.poetsgate.com/ViewPoem.aspx?id=205311",""],[5845,"لكَ الحمدُ يا مستوجبَ الحمدِ دائماً","https://www.poetsgate.com/ViewPoem.aspx?id=15456",""],[5912,"تساؤل","https://www.poetsgate.com/ViewPoem.aspx?id=205003",""],[199,"وعون يباكرن البطيمة موقعا","https://www.poetsgate.com/ViewPoem.aspx?id=22420",""],[6115,"بعض البشر يلبس الشرهه على راسه","https://www.poetsgate.com/ViewPoem.aspx?id=180457",""],[6115,"الكذب شين","https://www.poetsgate.com/ViewPoem.aspx?id=180474",""],[6115,"يالله يامن بامره الشر والخير","https://www.poetsgate.com/ViewPoem.aspx?id=180503",""],[469,"فلا خاب ظني في العقيق وأهله","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574818",""],[463,"لمنْ طالعاتٌ في السراب أفولُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60278&r=&rc=334",""],[6305,"حروفي تسكُت في حضرتِك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87352&r=&rc=25",""]],"verses":[["ويا كعْبَةَ الُلْكِ التي برَكاتُها","تفيضُ علَى زُوّارِها وتَوكَّفُ",0,"ف",1,0],["وَيَأكُلنَ بُهمى جَعدَةً حَبَشِيَّةً","وَيَشرَبنَ بَردَ الماءِ في السَبَراتِ",1,"ت",1,0],["وَيَأكُلنَ مِن قُوٍّ لَعاعاً وَرَبَّةً","تُجَبَّرَ بَعدَ الأَكلِ فَهُوَ نَميصُ",2,"ص",1,0],["وَيَا كَرِيمَ الأُصُولِ فَرْعَ","المُؤْثَّلِينَ المُؤَصَّلِينَا",3,"ن",2,0],["ويأكل زاد الورى كلَّه","ولكنها أكلةٌ واحدهْ",4,"د",2,0],["ويا كينبود فم كسرت قلبي","وأمسِ الحادثات كسرن رجلي",5,"ل",2,0],["وَيا كَثيرَ الدَلِّ في عِزِّهِ","لا تَنسَ لي عِزّي قُبَيلَ الهَوان",6,"ن",1,0],["وَيا كَبِدي الحَرّى الَّتي قَد تَصَدَّعَت","مِنَ الوَجدِ ذوبي ما عَلَيكِ مَلامُ",7,"م",1,0],["وَيا كَعبَينِ مِن عاجٍ","وَيا طُنبورَ شُطّارِ",8,"ر",1,0],["وَيا كَعبَةَ بَيتِ اللَ","هِ ذا رُكنٍ وَأَستارِ",8,"ر",1,0],["وَيا كَبِداً لَيسَ مِنها لَنا","نَوالٌ وَلا عِندَها لي يَدُ",9,"د",1,0],["وَيا كَبِداً قَد أَنضَجَ الشَوقُ نِصفَها","وَنِصفٌ عَلى نارِ الصَبابَةِ يُنضَجُ",10,"ج",1,0],["وَيَأكُلانِ وَلَم يَستَوبِلا مِقَراً","مِنَ الطَعامِ وَلا شَهداً يَلَذّانِ",11,"ن",1,0],["ويأكُلنَ ما أَغنَى الوَلِيُّ فلَم يَلِت","كأَنَّ بِحَافَاتِ النَّهاءِ المزارِعا",12,"ع",2,1],["وَيَا كَوْكباً أَمْسَى بِآيَةِ وَجْدِهِ","قَرِينَ الثُّرَيَّا بورِكَتْ آيَةُ الْوَجْدِ",13,"د",1,0],["ويا كل أفراح كل الطيور ..","أنا كل أحزان من قُيّدا..",14,"د",2,0],["ويا كواكبُ آنَ الرَّجْمُ فانطلقي","ما أنتِ إنْ أنتِ لم تَرْمِ الشياطينا",15,"ن",2,0],["ويا كعبة الملك التي بركاتها","تفيض على زوارها وتوكف",16,"ف",1,0],["ويا كوكباً في عالَمٍ غَمَّ جوُّهُ","بلألائه يَسْترشِدُ المتحيّر",17,"ر",1,0],["ويا كثير التجني","احكمت في غرامك",18,"ك",1,0],["ويا كبدي ذوبي أسىً وتحرّقاً","ويا ناظري لا زلت بالدمع غرقانا",19,"ن",2,0],["ويأكلُ من فمي ويطيف حولي","نفاقا باشتياق والتزام",20,"م",1,0],["وَيأكلُ منهم كلّ ما يأكلونهُ","وَيشربُها حَمراءَ إِن شاء أو صفرا",21,"ر",2,0],["وَيأكلُ مَخنوقاً ويُفتي بحلّه","لِئلّا يقولوا إنّه اِرتكبَ الوِزرا",21,"ر",2,0],["وَيَأكُلنَ ما أَغنى الوَلِيُّ فَلَم يَلِث","كَأَنَّ بِحافاتِ النِساءِ المَزارِعا",22,"ع",2,1],["وَيا كافِل الحيتان في لج بحرها","وَمؤنس في الآفاق وَحش البَهائم",23,"م",1,0],["ويا كل أبواب القبول تفتحي","فإن مطايا القصد نحوك أمت",24,"ت",1,0],["ويا كريم يا رب","أحسن له جزاه",25,"ا",2,0],["وَيَأكُلُ التَمرَ وَلا يُلقي النَوى","كَأَنَّهُ غِرارَةٌ مَلأى حَثى",26,"ا",1,0],["وَيَا كَريمَ الفَرْعِ وال","فَرْعُ دَليلُ الشَّجَرَه",27,"ر",2,0],["ويا كريماً حُلْواً شَمائلُه","به كرامُ الأنامِ قد خُتِموا",28,"م",3,0],["ويا كبدي رودي لذاتك مسكناً","يفيك وإلّا ذبت في ظل سكنتي",29,"ي",1,0],["وياكشف الضر يا ذا العلا","ويا من يفرج إذا خطب حل",30,"ل",1,0],["ويا كثر ما نوَّلت بالوعد نائلاً","وإنَّ كثير الغانيات قليل",31,"ل",1,0],["ويا كعبة الوفاد هل أَنت سامع","عوالي إِذا اعولت في خلواتي",32,"ت",2,0],["ويا كبدي بنار الحزن ذوبي","ويا روحي لشوقهم فسوقي",33,"ق",2,0],["ويأكلني فيك العدا وتعودُ لي","فَيُنشَرُ مرمومُ العظامِ أكيلُ",34,"ل",1,0],["ويأكلني بتصاريفه","فها أنا أفنَى ولم يشبعِ",35,"ع",1,0],["ويا كم له من وقفة ظافرية","بها أينعت أغصانهن الذوابل",36,"ل",1,0],["ويا كتائِبَ حزبِ اللهِ عَنِ شيمٍ","شَماءَ قومي ليلوى كيدُ مَن فَجَّروا",37,"ر",3,0],["وَيا كادحاً جامعاً للأُلوفِ","وغيرُك يأخذها من غدِ",38,"د",1,0],["ويا كراماً سواهم زال من بالي","لا تحسبوا أنني عن حبكم سالي",39,"ي",1,0],["ويا كوكباً لن يُخلف الدهر مثلهُ","تولَّى وأبقى بعدهُ في الحشا وغرا",40,"ر",2,0],["ويا كوكباً قد غاب عَني في الثَرَى","وما هكَذَا عهدي غياب الكواكبِ",41,"ب",1,0],["ويا كامل الحسن في نعته","شغلت فؤادي وأسهرت عيني",42,"ن",2,0],["وَيا كَعبةً يَسعى لحجِّك جَمعُنا","لِكسب فُنون كُلّهنَّ حِسان",43,"ن",1,0],["وَيا كَعبة الإِسعاف وَالبِرِّ وَالصَفا","وَيا مُنقذ العافي مِن البَأس وَالضر",44,"ر",1,0],["ويأكل أحشائي سدىً وتجمّلي","ويكرم مفتون ويؤجر شائن",45,"ن",1,0],["ويا كافلَ الاسلامِ في كلِّ موطنٍ","وراعي رعاةِ الدّينِ في كلِّ مجمعِ",46,"ع",1,0],["ويا كوكبَ الدُنيا الذي بِسَنائِهِ","وتيَّارِهِ تُهدى وتَحيَى الرَمائِمُ",47,"م",1,0],["ويأكل باليمنى وأما شماله","تكون لأكل التمر فاحفظّ ورَغِّب",48,"ب",1,0],["ويا كبِدي الحرَّى أمالَك نهَلة","بها فلقد طابت وطاب ثراها",49,"ا",3,0],["وَيَا كَاسَهَا الكَاسِي ظَفَرْتَ لكَ الهَنَا","بِلَثْمِ ثَنَايَا ثَغْرِهَا المُتَنَضِّدِ",50,"د",1,0],["ويا كنز محتاج ويا أمن خائف","ويا بشر محزون ويا أنس مؤنس",51,"س",1,0],["ويا كاسر الأصنام يا شاهد الهدى","بسمر عوال أو بيض صوارم",52,"م",1,0],["ويا كبدا عادت رفاتا كأنما","يلذعها بالكاويات طبيب",53,"ب",1,0],["ويأكل الحر شغاف قلبه","وَلا يَبين جَزعَةً لِصَحبه",54,"ه",1,0],["وَيَأكُلُ غَيرُهُم دِرهَماً","فَيُقصى وَيُدنَونَ إِذ يَأكُلون",55,"ن",1,0],["وَيَا كَاسِراً لِي جُفُونَ الظِّبَاءِ","كَفَى الحَّبَّ كَسْرُ الجُفُونِ احْوِرَارَا",56,"ر",2,0],["ويا كرماء الحي هذا نزيلكم","يناديكم في الحي يا للمروّة",57,"ه",1,0],["وَيأكل الرزق حين يطلبه","وَيشرب الماء حين يذكره",58,"ه",1,0],["ويا كُحْلَ أجفاني وإن غَلَبَ الكرى","عليها وقد تَقَذَى الجفونُ من الكُحْلِ",59,"ل",1,0],["ويا كافي الكُفَاةِ ولو بِحُكْمِي","وقدرِكَ قلتُ يا مَوْلَى الموالي",60,"ل",2,0],["ويا كبدي هلا تفطرتِ حَسرَةً","ويا أدمعي هلا جريتِ له حُمرا",61,"ر",2,0],["وَيا كَريمَ اليَدِ وَاللِسانِ","لَو قيلَ لِلبَأسِ وَلِلإِحسانِ",62,"ن",1,0],["ويا كنافة ما أنت انفشي فلكم","أضحت تحاكيك من عقلي خُبالات",63,"ت",1,0],["وَيَا كَثيرَ التَّجني","قَطعْتَ حتَّى سَلامَكْ",64,"ك",1,0],["ويا كنه المعارف ان قلبى","لديه من غوامضك اطلاع",65,"ع",1,0],["ويأكلون طعاماً ما له صفةٌ","منزَّهُ الطعمِ لا حلوٌ ولا مُرُّ",66,"ر",1,0],["ويا كافِلَ الأيتام يُجري عليهِمُ","جرايةَ نُعمَى بابها غير مَسدودِ",67,"د",1,0],["وَيَأكُلُ لَحمَ الكلابِ المُسلِمُ","ما بَينَهُم فليسَ فيهُم مَحرَمُ",68,"م",1,0],["ويا كبدي الحراء حزنا تفطري","وذوبي فقد مات الامام محمد",69,"د",1,0],["ويا كبدي بالنائبات تفطري","ويا مقلتي جارى السحاب إذا سحا",70,"ح",2,0],["وَيَأكُلُ أَقوام شواءً وَجَردَقاً","وَمَأكولُنا خُبزٌ مَشوبٌ بآلامِ",71,"م",1,0],["ويأكل بطيخا بخبز وسكر","ورطب ولم يجنح الى مطلب وعر",72,"ر",1,0],["ويأكل مع حزب المساكين والذي","له الفضل في اخلاقه فاز بالبر",73,"ر",1,0],["ويا كريماً لو لامَسَتْ يُدهُ","صخراً لألفاهُ أيّ مُنْبَجسِ",74,"س",1,0],["ويا كونا من الهم","ويا دنيا من الياس",75,"س",1,0],["ويأكل عرضى منهم كل حاسد","له همة أخرى وحظ مقدم",76,"م",1,0],["ويا كِرا الدارِ على مُفْلِسٍ","وسَلْحةَ المَطْرودِ في وَعْرَهْ",77,"ر",2,0],["ويا كربةً كربت أن تذوب","لها الراسياتُ بحر الغلل",78,"ل",1,0],["وَيأكلُ الحقّ كَما يَشتَهي","وَيطبخ العذر بإِتقانِ",79,"ن",1,0],["ويا كليماً هوى فوق الثرى صعقا","لكن محياه فوق الرمح ابلجه",80,"ج",2,0],["ويا كاتباً يبدو يراعك نافثاً","خماراً ولو قد كان لوّث بالحبرِ",81,"ر",1,0],["وَيا كَعبةَ الآمال يا حَرمَ الرجا","وَأَكرَم مَن يَسعى لِكَسب المَغانم",82,"م",1,0],["وَيا كم ظَلتُ أَحسو العمر حلواً","وَأَلمحُ زهرةَ اللذات لمحا",83,"ح",2,0],["وَيا كم ليلة والت بأُنسٍ","وَقَد جنحت لسلم الصَفوِ جنحا",83,"ح",2,0],["وَيا كَم غادةٍ هَيفاء خودٍ","تَجوز إِلى النُهى في القَلب صَرحا",83,"ح",2,0],["وَيا كَم لامني في الناس ناسٌ","وَعَهدُ الغيّ يلحظني بطمحا",83,"ح",2,0],["وَيا كَم قيل لي للشيء حدٌّ","ستبلغُه وَتَلقى الفَرحَ تَرحا",83,"ح",2,0],["وَيا كَم ذا نقضّي اللَيلَ سُهداً","وَلا أَجراً وَلا صَبراً مُعينا",84,"ن",2,0],["وَيا كَم شَكاني في الكَريهة سَهلبٌ","تَلفَّتَ مزْوَرّاً وَأَنّ وَحَمْحما",85,"م",2,0],["وَيا كَم لَيلةٍ وافَت وَصافَت","بِنُور مُدامَتي أَجلو الظَلاما",86,"م",2,0],["وَيا كَم نسمع الواشي يُنادي","إِلَيكُم دُون مَن ترجون مهلك",87,"ك",1,0],["وَيا كَم يَجري ماءُ الحُسن لَكَن","لَديهِ كَم دَم العُشاق يُسفَك",87,"ك",1,0],["وَيا كنزَ البلاغةِ دمتَ إني","لفضلك في اعتذارٍ وامتنان",88,"ن",1,0],["ويا كل أصحاب النبي محمد","أغيثوا عبيداً من خطاياه يضلع",89,"ع",1,0],["ويا كم لي أشير بجلنار","عن الخد الشهي وجل نار",90,"ر",1,0],["ويأكل أنواع الطعام بلذة","وان بطون الاكثرين جياع",91,"ع",1,0],["وَيا كِتاباً جاءَ من مُخلِفٍ","لِلوَعدِ مَملوءاً بِعُذرٍ طَويل",92,"ل",1,0],["ويا كريم يا رقيبُ يا مجيبْ","ارزق لي ما أردتُّه منك قريبْ",93,"ب",1,0],["ويا كريم يا سميعُ يا مجيبْ","تولَّني في ذي الأمور يا قريبْ",94,"ب",1,0],["ويا كبدي الحراءُ زيدي الحشا لظىً","ويا أدمعي سحّي بذا البين عندَما",95,"م",2,0],["وَيا كنز جودِ اللَهِ حسبيَ أَنَّني","بِبابِكَ مَطروحٌ لفَضلِكَ ناظِرُ",96,"ر",1,0],["ويأكلُ منه بُكرةً وعَشِيَّةً","فلا تعبأنْ بالنَّائِبات من الزَّمَنء",97,"ن",2,0],["ويا كمداً يذوبُ على التصابي","بداءٍ حادثٍ في كلِّ عامِ",98,"م",1,0],["ويا كبدي ذوبي عليه صبابة","وإن كنت قد أزمعت صرمي فأجملي",99,"ل",2,0],["ويأكلن والراح منهن بالجلد","مستترات ويمضغن سرّا",100,"ر",2,0],["وَيا كَبِدي في الحُبِّ ذوبي صَبابَةً","وَيا كَمَدي دُم إِنَّني بِكَ يانِعُ",101,"ع",1,0],["ويا كهرباء الهوى أنعشيني","أحبُّ انتفاضة قلبي المعذّبْ",102,"ب",1,0],["وْيآكثر من يضحكلك ويخفي ورى الضحكة سموم","ودّه عليك بفرصةٍ ويدسّها بغْلافيه",103,"ف",3,0],["ويأكل (سكرَ) قومٍ أفاضلْ","فيا(سكَّرٌ) تَفْتَدِيك المَقاتلْ",104,"ل",1,0],["ويَأكُلُ الإخوانُ إِخوانَهُم","لِفَرطِ ما بِالغَدرِ قد أَيقَنُوا",105,"ن",3,0],["ويأكل ما لذ مما اشتهى","وتسغب من سوء أحوالِها",106,"ل",3,0],["ويأكل لحم هذا ثم هذا","ولا يدري الحلال من الحرامِ",107,"م",1,0],["ويا كلَّ القصائدِ قد تعبنا","فزولي عن ديارِ الشِّعرِ زولي",108,"ل",2,0],["ويا كُلَّ أَصْحَابِي وأَبنَاءَ جِلدَتِي","اعْشَقُوا ..!!فَمَسَارُ العِشقِ آخِرُهُ القَهْرُ",109,"ر",1,0],["ويا كمْ سعدتُ بقربِّك مني","ويا كمْ سعدتِ كثيراً بقربِي",110,"ب",2,0],["ويا كمْ بذلتُ لهم كلَّ غالٍ","وكنتُ إذا اشتدَّ غيظي حَليما",111,"م",2,0],["ويأكل في القبر الشريف وإنه","يصوم به بل قد يحج ويعتمر",112,"ر",1,0],["ويآ كثر من ينطق بأحبك وثم غاب","ومن هالغياب يحط طعنه بالأعماق",113,"ق",1,0],["وياكم مثله بالقبايل صايل","مع شلة الارهاب في ماكرها..",114,"ر",3,0],["ويا كبرياءً بحجم البلاد","بلادي ظلامٌ وأنت الصباحْ",115,"ح",1,0],["وياك بعشرتي ياليل خسران","مثل عشرة النور وي الكواغد",116,"د",1,0],["وياكبرني في عين نفسي وانا اهديك","شيخة قصيدي بالغزل ياالحشيمه",117,"م",2,0],["وياكم حليم التزم في عفوه الراقي","تجهل به اعداه وتحده يمزقها",118,"ق",3,0],["ويأكل بعض الناس أرزاق بعضهم","ومنها إلى الجوزاء ترقى السلالم!",119,"م",1,0],["وياكل الناس احلى التمر ناضجة","ولست. اصبر حتى ينضج الثمر..¡",120,"ر",1,0],["وياكثر ماكانت حروفي تنوحي","والوصل غير الوصل والله ماريد",121,"د",1,0],["وياكثر ماودي اجيك بمحلك","وانسى البشر لاقمت اناظر شفاياك",122,"ك",1,0],["وياك تنسى بالليالي الشديدات","ربع على القاسين يامير يقسون",123,"ن",1,0],["ويا كل القوافي إنّ وزنا","لنا يأتي لمن لبّى بلادهْ",124,"د",2,0],["وياكلُ منك دودُ الأرضِ وجهاً","جميلاً كان يزعجُهُ الذبابُ",125,"ب",1,0],["ويا كافلَ الحيتانِ في لجِّ بحرها","ويا مؤنساً في الأفقِ وحشَ البهائمِ",126,"م",1,0],["ويا كل الصبابة أين كلي ؟","ألست ترى ضياعي من نزوقي",127,"ق",2,0],["وَيَأْكُلْنَ مَا أَعْنَى الوَلِيُّ فَلَمْ يُلِتْ","كأن بحافات النهاء المزارعا",128,"ع",2,0],["وياكثر غله مع حقده ووسواسه","صفات الانذال في نفسه مجمعها",129,"ع",3,0],["وياكبرها لاصار من يؤمل ويرجى فيه خير","يعمي عيونه ويتنحى من دروب الغانمين",130,"ن",1,0],["وياكم عثرنا وجنبتنا المعاثير","وياكم جهلنا وكل نفس جهوله",131,"ل",2,0],["وياكم مشينا في صفوف الطوابير","والرزق لو ماكتب لك ماتطوله",131,"ل",2,0],["وياكم خسرنا ولاحسبنا المخاسير","وكلن على اهدافه يسير ذلوله",131,"ل",2,0],["وياكم له من قفةٍ ظافريةٍ","بها أينعت أغصانهنَّ الذّوابل",132,"ل",1,0],["ويأكلني فيك العدا وتعودُ لي","فينتشرُ مرمومُ العظامِ أكيلُ",133,"ل",1,0],["ويأكلُ الليلُ من روحي ومن لغتي","فيوغِلُ الصَّمتُ والصيحاتُ تغترب",134,"ب",1,0]]}