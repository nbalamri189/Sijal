0],["بَذَلَ السَّخاءُ بِهَا الأَطايِبَ وَانْتحَى","نحْواً جَمِيلاً فِي طِرَازِ المقْصِفِ",132,"ف",1,0],["بَذْلا قَرَأْتِ الْيَوْمَ أَحْدَثَ آيَةٍ","مِنْهُ رَدَدْتِ بِهَا الْحَيَاةَ لِشَاعِرِ",133,"ر",1,0],["بَذَلتُ العَطاءَ الجَزَل كيما أَصونها","فَباعَتكَ بِالأَوطارِ وَاِدَّعَت المَنعا",134,"ع",2,0],["بذلكم يزهو أبو الأصبغ الذي","أجزت ويدعو الله بالحمد والشكر",135,"ر",1,0],["بَذَلتُ لَهُ الوُدَّ المَصونُ وَأَدمُعي","فَلَم يَقتَنِع حَتّى وَهَبتُ لَهُ القَلبا",136,"ب",2,0],["بَذَذتَ الكُهولَ الغرّ حِلماً وَسُؤدُداً","كَذاكَ عَهدنا فهر لِلنّاسِ بُذَّذا",137,"ذ",2,0],["بَذَلْتِ الثَّقَافَةَ للِظامِئِينَ","وَلَوْلاَ يَمينُكِ لم تُبْذَلِ",138,"ل",1,0],["بذلتَ لها من صحّةٍ ورَفاهةٍ","فأولئك حُبّاً ما أبرَّ وما أسْمَى",139,"م",2,0],["بذلوا النفوسَ فكم شهيدِ جِراحةٍ","منهم وكم منهم شهيدُ كِفاح",140,"ح",1,0],["بذَلتْ مصرُ فوق ما يبذُلُ الطَّوْ","قُ وقد يُسْعِفُ النديدُ النديدا",141,"د",2,0],["بذرت «أثينا» في الحضارة أمةٌ","لم تأوِ غيرَ مضارب وفياف",142,"ف",1,0],["بذلوا لمصرٍ فوق ما في وسعهم","ورضُوا بما دون الكفاف نصيبا",143,"ب",2,0],["بذلنا لها أثمانها قبل ذوقها","لأن شميم المسك أغنى عن الذوق",144,"ق",1,0],["بذي قرقرى إذْ شهَّد الناسُ حولنا","فأسْدَيْتَ إذْ أَعْيَي بِكَفَّيْكَ نائِرُهْ",145,"ر",2,0],["بذاك اوصاني ابي وبمثله","كذلك اوصاه قديما اوائله",146,"ل",2,0],["بذَوب الفكر يفتتح القَضايا","ويختِمها بمهجته اندفاعا",147,"ع",2,0],["بذلت لها حق الوداد رعايةً","وما حفظ الود المقيم سوى الود",148,"د",1,0],["بَذَلْتَ المالَ فِيهمْ، أن يَعُودوا","إلى الأهْلينَ مِنهُمْ، وَالدّيارِ",149,"ر",1,0],["بَذَّ الجِلادُ البذ فَهوَ دَفينُ","ما إِن بِهِ إِلاَّ الوُحوشَ قَطينُ",150,"ن",1,1],["بذلتُ لك التقريظَ غيرَ مماطلٍ","لا تبلُني في حاجتي بمطالها",151,"ل",3,0],["بِذِي ذِئْبٍ يَنُوسُ بِجَانِبَيْهِ","عَثَاكِلُ مِنْ أَكَالِيلِ العُهُونِ",152,"ن",1,0],["بذي ميعة ٍ، لا موضعُ الرمحِ مسلمٌ","لبُطْءٍ ولا ما خلفَ ذلكَ خاذِلُهْ",153,"ل",2,0]]}