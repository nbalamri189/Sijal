ْتُ الحُبّ، لَوْ أغْنى حِذاري","https://www.poetsgate.com/ViewPoem.aspx?id=31337",""],[44,"بَذَّ الجِلادُ البذ فَهوَ دَفينُ","https://www.poetsgate.com/ViewPoem.aspx?id=64133",""],[51,"أبا حسنٍ صِلْ حاجتي بوصالها","https://www.poetsgate.com/ViewPoem.aspx?id=30280",""],[39,"أَمِنْ دِمَنٍ بِشاجِنَة ٍ الحَجُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=4310",""],[2,"صَحا القَلبُ عن سلمى وأقصرَ باطِلُهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19479&r=&rc=5",""]],"verses":[["بِذِكري أَشُمُّ ثَرى أَرضِهِ","عَلى نَأيِهِ وَبِقَلبي أَراهُ",0,"ا",2,0],["بِذَلتُكَ قَلباً كُنتُ أَذخَرُ صَونَهُ","إِذا لاحَ لي بَرقٌ مِنَ العَزمِ لامِعُ",1,"ع",1,0],["بَذَلَ المالَ لي يُساوِمُ عِرضي","إِنَّ عِرضي إِذاً عَلَيَّ رَخيصُ",2,"ص",1,0],["بِذِكرِ جودِكَ يُستَسقى المُحولُ إِذا","لَم يُلهِ فيها نِساءَ الحِلَّةِ السُمُرُ",3,"ر",1,0],["بِذي مَرَحٍ لا يَمْلأُ الهَوْلُ قَلْبَهُ","ولا يَتلَقّى لِمَّةً بِلَبانِ",4,"ن",1,0],["بَذَلْتُ جُهْدِي بِمَا أَلْقَاه فِي جَسَدِي","وَفِي مَعَادِي وَفِي دِينِي وَأَطْفَالِي",5,"ي",1,0],["بِذَوَابِلِ السَّلْبِ التَّي تَرَكَتْ بَنِي","زَيَّأنَ بَيْنَ مُجَدَّلٍ وَسَلِيبِ",6,"ب",1,0],["بِذي هَبَراتٍ أَو بِأَبيَضَ مُرهَفٍ","سَقاهُ السِمامَ الهِندِكيُّ المُخَرَّبُ",7,"ب",1,0],["بَذَلنا لَها حُكمَها عِندَنا","وَجادَت بِحُكمي لِأُلهى بِها",8,"ب",3,0],["بِذاتِ لَوثٍ عَفَرناةٍ إِذا عَثَرَت","فَالتَعسُ أَدنى لَها مِن أَن أَقولَ لَعا",9,"ع",2,0],["بِذاتِ نَفِيٍّ لَها سَورَةٌ","إِذا أُرسِلَت فَهيَ ما تَنتَقِم",10,"م",1,0],["بَذَلتُ لَهُ مِثلاً وَكُلَّ تَحِيَّةٍ","مِنَ المَرءِ مَردودٌ عَلَيهِ مِثالُها",11,"ل",3,0],["بِذي زَهرٍ غَضٍّ كَأَنَّ تِلاعَهُ","إِذا أَشرَفَت حَجراتُهُنَّ النَمارِقُ",12,"ق",1,0],["بِذي هَيدَبٍ جونٍ تُنَجِزُهُ الصِبا","وَتَدفَعُهُ دَفعَ الطِلا وَهوَ حاسِرُ",13,"ر",1,0],["بِذي المَرخِ وَالمَسروحِ غَيّرَ رَسمَها","ضَروبُ النَدى قَد أَعتَقَتها البَوارِحُ",14,"ح",1,0],["بِذي جَدَدٍ مِنَ الجَوزاء موفٍ","كَأَنَّ ضَبابَهُ القُطُنُ النَسيجُ",15,"ج",1,0],["بِذَاكَ الذَّابِلِ الْخَطِّيِّ مِمَّا","تَخُطُّ بِه العَظَائِمَ فِي كِتَابِ",16,"ب",1,0],["بِذَاكَ العَامِلُ الغَلاًّبِ بَأْساً","عَلَى لِينٍ بِهِ عِنْدَ الْغِلاَبِ",16,"ب",1,0],["بَذَلُوا النُّفُوسَ كَمَا بَذَلْتَ وَأَرْخَصُوا","مَا عَزَّ مِنْ جَاهٍ وَمِنْ قُنْيَانِ",17,"ن",1,0],["بِذُؤَابَةِ العَلْيَاءِ فِي أَرْجَائِهِمْ","وَخُلاصَةِ النُّجَبَاءِ وَالأَعْيَانِ",18,"ن",1,0],["بِذَلِكَ الشِّعْرِ صِفْ مِصْراً وَأُمَّتَهَا","صِفْ كُلَّ مَعْنَىً بِهَا كَالنَّافِحِ الشَّبِمِ",19,"م",1,0],["بِذَلِكُمُ أُطالِبُ وَصلَ مَيٍّ","وَأَكسو الرَحلَ ذِعِلبَةً عَسولا",20,"ل",2,0],["بِذي لَجَبٍ تُعارِضُهُ بُروقٌ","شُبوبُ البُلقِ تَشتَعِلُ اِشتِعالا",21,"ل",2,0],["بِذي لَجَبٍ تَدعو عَديّاً كُماتُهُ","إِذا عَثَّنَت فَوقَ القَوانِسِ عِثيَرُ",22,"ر",1,0],["بذوب لجين سال بين جواهرٍ","غدا مثلها في الحسن أبيض صافيا",23,"ي",2,0],["بذلوا لدى الهيجا كرائمَ أنفسٍ","قد أرخصت في الله خير منالِ",24,"ل",1,0],["بذلكم نهضوا للمجد نهضتهم","ودوّخوا الأرض بالهندية القضب",25,"ب",1,0],["بذاك قضى اجتماع الناس لمّا","أن اعتصموا بحبل الاجتماع",26,"ع",1,0],["بِذَلِكَ أَحمَينا البِلادَ عَلَيكُمُ","فَما لَكَ في حافاتِها مُتَزَحزَحُ",27,"ح",1,0],["بِذي نَجَبٍ ذُدنا وَواكَلَ مالِكٌ","أَخاً لَم يَكُن عِندَ الطِعانِ يُواكِلُه",28,"ل",2,0],["بِذيفانِ السِمامِ سَقَيتُ تَيماً","وَتُمطِرُ بِالعَذابِ لَها غُيومي",29,"م",2,0],["بِذي بَهجَةٍ كَنَّ المَقانِبُ صَوبَهُ","وَزَيَّنَهُ أَطرافُ نَبتٍ مُشَرَّبِ",30,"ب",1,0],["بِذي شَطَبٍ أَحداجُها إِذ تَحَمَّلوا","وَحَثَّ الحُداةُ الناعِجاتِ الذَوامِلا",31,"ل",2,0],["بِذي الرِمثِ وَالطَرفاءِ لَمّا تَحَمَّلوا","أَصيلاً وَعالَينَ الحُمولَ الجَوافِلا",31,"ل",2,0],["بِذي حُسَمٍ قَد عُرِّيَت وَيَزينُها","دِماثُ فُلَيجٍ رَهوُها فَالمَحافِلُ",32,"ل",1,0],["بِذَنبِيَ أَورَدتَني","وَمِن فَضلِكَ المَصدَرُ",33,"ر",1,0],["بَذَّت نِساءَ العالَمينَ كَما","بَذَّ الكَواكِبَ مَطلَعُ البَدرِ",34,"ر",1,0],["بَذَلنا لَهُ الأَموالَ مِن جُلِّ مالِنا","وَأَنفُسَنا عِندَ الوَغى وَالتَآسِيا",35,"ي",2,0],["بذكرك طابَ منطقهُ وأغرت","ملامته هوى قلبي اللَّجوج",36,"ج",1,0],["بَذَلَ الوعْدَ للأخلَّاءِ سَمْحاً","وأبى بعد ذاك بذلَ العطاءِ",37,"ا",2,0],["بذلك إن دارت رحَى الحرب مرةً","ثبتُّ ثباتَ القطب في مركز القطبِ",38,"ب",1,0],["بذل الكرائمَ في المكارم تاجِرٌ","جَلَّتْ تجارَتُهُ عن التَّرْقِيحِ",39,"ح",1,0],["بذِي شِيَمٍ يُصبيكَ حُسنُ وُجُوهِهَا","ولِينُ مَثانِيها وجَدْلُ قُدُودها",40,"د",3,0],["بُذُورُكُما فاستصلِحاها لتجْنِيا","صلاحاً إذا ما الرَّيْعُ حصَّلَهُ الحصْدُ",41,"د",1,0],["بذل الدنيا بكفٍّ سمحةٍ","مثلُها ضُمِّن أرزاق العبادِ",42,"د",1,0],["بذلتُم من المعروفِ ما فلّ عِفتي","وقيّدَ تَبْكيري وضعْضعَ من قدري",43,"ر",2,0],["بذلت من القوت لي عصمةً","فأوسع علي من الواسع",44,"ع",1,0],["بذلتُ لك التقريظَ غيرَ مماطلٍ","فلا تبلُني في حاجتي بمطالِها",45,"ل",3,0],["بذلَ المالَ للرعيّة والنف","سَ لراعيه ديدَنَيْ بَذّالِ",46,"ل",1,0],["بذاك قضى قاضي الهوى وهْو ظالمٌ","على الخَدِّ للعين التي هي أظلمُ",47,"م",1,0],["بذلك قد عللتُ نفسي كُلّه","ولكنْ بنو الأيام تُغْذَى وتُفْطَمُ",47,"م",1,0],["بذاك في وجهه ضَمِينٌ","يُقْبَلُ من مِثله الضمان",48,"ن",1,0],["بَذَلتَ لَهُنَّ القَولَ إِنَّكَ واجِدٌ","لِما شِئتَ مِن حُلوِ الكَلامِ مَليحُ",49,"ح",1,0],["بِذي خُصَلٍ سَبطِ العَسيبِ كَأَنَّهُ","عَلى الحاذِ وَالأَنساءِ غُصنُ إِهانِ",50,"ن",1,0],["بِذي شَقٍّ عَلى الضَبَراتِ حَتّى","يَلينَ عَلى التَجَخُّفِ وَالشَخيرِ",51,"ر",1,0],["بَذَلوا دَمعَهُم وَصُنتُ دُموعي","إِنَّما اليائِسونَ أَهلُ البُكاءِ",52,"ا",2,0],["بِذي الرَضمِ سارَ الحَيُّ مِنها فَما تَرى","بِها العَينُ إِلّا مَسجِداً وَأَوارِيا",53,"ي",2,0],["بَذَرَ الحُبُّ بَذْرَهُ","في فُؤادي فَأوْرَقا",54,"ق",2,1],["بَذَلنا جُهدَنا عَزما وَحَزماً","وَوَطَّنّا الكُماةَ عَلى الطِعانِ",55,"ن",1,0],["بِذي أُشَرٍ كَالأُقحُوانِ يُزَينُهُ","نَدى الطَلِّ إِلّا أَنَّهُ هُوَ أَملَحُ",56,"ح",1,0],["بذلت خدّا لنشأت","فجد بخد لكاظم",57,"م",1,0],["بَذَلَ الجُهودَ الصالِحاتِ عِصابَةٌ","لا يَسأَلونَ عَنِ الجُهودِ جَزاءَ",58,"ا",2,0],["بَذَلَت مالاً وَأَمناً وَدَماً","وَعَلى قائِدِها أَلقَت رَجاها",59,"ا",3,0],["بَذَلتَ لَهُ الجَفنَ دونَ الكَرى","وَمَن بِالكَرى لِلشَجِيِ الباذِلِ",60,"ل",1,0],["بِذا اللَفظِ ناداكَ أَهلُ الثُغورِ","فَلَبَّيتَ وَالهامُ تَحتَ القُضُب",61,"ب",1,0],["بِذا قَضَتِ الأَيّامُ مابَينَ أَهلِها","مَصائِبُ قَومٍ عِندَ قَومٍ فَوائِدُ",62,"د",1,0],["بِذي كَرَمٍ ما مَرَّ يَومٌ وَشَمسُهُ","عَلى رَأسِ أَوفى ذِمَّةً مِنهُ تَطلُعُ",63,"ع",1,0],["بِذي الغَباوَةِ مِن إِنشادِها ضَرَرٌ","كَما تُضِرُّ رِياحُ الوَردِ بِالجُعَلِ",64,"ل",1,0],["بَذَلتُ لَها المَطارِفَ وَالحَشايا","فَعافَتها وَباتَت في عِظامي",65,"م",2,0],["بذي صولةٍ نكراءَ لم تُبْقِ مجرماً","وذي راحةٍ وطفاء لم تُبقِ مُعْدِما",66,"م",2,0],["بذلوا الوفاءَ وكان آخرُ عهدِهمْ","غَدْراً وأخلفَ ما رآهُ الباذِلُ",67,"ل",1,0],["بَذَلتُ الرِضا حَتّى تَصَرَّمَ سُخطُها","وَلِلمُتَجَنّي بَعدَ إِرضائِهِ عَتبُ",68,"ب",1,0],["بَذَلَ القَومُ رَهنَهُم خَوفَ لَيثٍ","أَثَّرَت في عُداتِهِ أَظفارُه",69,"ر",2,0],["بَذَلتَ المالَ فيهِم كَي يَعودوا","إِلى الأَهلينَ مِنهُم وَالدِيارِ",70,"ر",1,0],["بَذَّ المُلوكَ تَكَرُّماً وَتَفَضُّلاً","وَأَحانَ مِن نَجمِ السَماحِ طُلوعا",71,"ع",2,0],["بَذَلتُ لَها الوَصلَ الَّذي بَخِلَت بِهِ","وَأَصفَيتُها الوِدَّ الَّذي لَم تَكُن تُصفي",72,"ي",1,0],["بِذي الغافِ مِن وادي عُمانَ فَأَصبَحَت","دِماؤُهُمُ يُجرى بِها حَيثُ تَشخَبُ",73,"ب",1,0],["بَذَلوا نُفوسَهُمُ مُخاطَرَةً","وَهُمُ وَراءَ خَنادِقِ الحَفرِ",74,"ر",1,0],["بِذِعلِبَةٍ ما مَسَّ إِلّا مُناخُها","لِنِصفِ صَلاةٍ وَهيَ دامٍ رَثيمُها",75,"م",3,0],["بِذي نَجَبٍ يَومٌ لِقَيسٍ شَريدُهُ","كَثيرُ اليَتامى في ظِلالِ المَآتِمِ",76,"م",1,0],["بَذَلْتَ ما جادَتِ البيضُ الرِّقاقُ به","فأنتَ سالِبُه قَسْراً وباذِلُه",77,"ل",2,0],["بذلت مصون النفس فيه ولم تزل","لنفسك في يوم الكريهة باذلا",78,"ل",2,0],["بذلتُ وجدي من الثناءِ لِمَنْ","يبذُلُ في المكرماتِ ما وجدا",79,"د",2,0],["بِذَبٍّ عن حريمِ الله أربَى","فلم تُتركْ لذي شُطَبٍ ذُبابا",80,"ب",2,0],["بِذي مَيعَةٍ لا مَوضِعُ الرُمحِ مُسلِمٌ","لِبُطءٍ وَلا ما خَلفَ ذالِكَ خاذِلُه",81,"ل",2,0],["بَذَلتُ عَقلي صَداقاً حينَ بِتُّ بِهِ","أُزوِّجُ اِبنَ سَحابٍ بِاِبنَةِ العِنَبِ",82,"ب",1,0],["بِذي شَنَبٍ بِجَبينٍ يُضي","ءُ تَغنِيَتي فَفَشَت غَيبَتي",83,"ت",2,0],["بَذَلَ النُضارَ مَعَ اللُجَينِ وَعِرضُهُ","في الصَونِ كَاِسمِ أَبيهِ في الأَوصافِ",84,"ف",1,0],["بَذَلتُ لَهُ خُلُقاً كَالرَبيعِ","يَطيبُ وَمَخبَرُهُ أَطيَبُ",85,"ب",1,0],["ب