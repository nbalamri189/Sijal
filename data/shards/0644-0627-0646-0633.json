{"poems":[[94,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[87,"نحن الكشافة في الوادي","https://www.aldiwan.net/poem7926.html","المتدارك"],[107,"أيكف شكوك أن يكون أماما","https://www.aldiwan.net/poem43395.html","الكامل"],[50,"يا طيبنا بقصور القفص مشرفة","https://www.aldiwan.net/poem62551.html","البسيط"],[52,"يا صاحبي أعيناني على طرب","https://www.aldiwan.net/poem64828.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16620","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54320","الرمل"],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[122,"ما بالرزايا وما بالنأي من باس","https://www.aldiwan.net/poem492.html",""],[190,"بعد يأسي من صاحب غدار","https://www.aldiwan.net/poem43828.html","الخفيف"],[290,"لأنس بين زيتون وزرع","https://www.aldiwan.net/poem39384.html","الوافر"],[303,"حق للمخزون أن ترثي له","https://www.aldiwan.net/poem36287.html","عموديه"],[305,"لعمري ما خلفت إلا لما أرى","https://www.aldiwan.net/poem45449.html","الطويل"],[309,"لا نسيم الصبا إذا هب وهنا","https://www.aldiwan.net/poem16876.html","الخفيف"],[369,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[408,"رمنا الفخار فنلنا منه ما شينا","https://www.aldiwan.net/poem46430.html","البسيط"],[463,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[469,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[563,"يا مرحبا يا مرحبا يا","https://www.aldiwan.net/poem34742.html","الكامل"],[580,"أودع منك الصدر والبدر والبحرا","https://www.aldiwan.net/poem2722.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138400",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48676","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119998","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25318","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136253","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48926","السريع"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45414","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110318","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77332","البسيط"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113034","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87325","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2656,"","https://poetry.dctabudhabi.ae/diwan/poem/124602","الكامل"],[2712,"","https://poetry.dctabudhabi.ae/diwan/poem/105722","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65956","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65994","البسيط"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136965",""],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65104","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112691","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91254","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86540","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133250","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103008","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102938","الكامل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111061","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101380","الطويل"],[4133,"","https://poetry.dctabudhabi.ae/diwan/poem/97679","الوافر"],[4360,"","https://poetry.dctabudhabi.ae/diwan/poem/122180","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133097","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72880","الطويل"],[4755,"بِاسمِ البِلادِ أَصالةً، ونِيابةً","https://www.poetsgate.com/ViewPoem.aspx?id=202668",""],[4858,"عريس مسلم وعرس إسلامي","https://www.poetsgate.com/ViewPoem.aspx?id=32792",""],[4858,"نيسان بين أفراح وأشجان","https://www.poetsgate.com/ViewPoem.aspx?id=161813",""],[5187,"هيا نتساقى","https://www.poetsgate.com/ViewPoem.aspx?id=29791",""],[5266,"لُبُّ الأَسَى","https://www.poetsgate.com/ViewPoem.aspx?id=210745",""],[5410,"بَشَرْ","https://www.poetsgate.com/ViewPoem.aspx?id=143854",""],[5561,"شهرزاد","https://www.poetsgate.com/ViewPoem.aspx?id=192903",""],[1638,"رشا من بني الأتراك صاد بصاده","https://www.poetsgate.com/ViewPoem.aspx?id=123935",""],[5764,"الاصدقاء الثلاثه","https://www.poetsgate.com/ViewPoem.aspx?id=175121",""],[5782,"أوزان وشطآن","https://www.poetsgate.com/ViewPoem.aspx?id=185767",""],[5885,"نتقاتل","https://www.poetsgate.com/ViewPoem.aspx?id=194800",""],[5956,"شِباكُ الشِّعر","https://www.poetsgate.com/ViewPoem.aspx?id=183742",""],[5956,"أغذي الناس بالشَّجَنِ","https://www.poetsgate.com/ViewPoem.aspx?id=185732",""],[5956,"الله علّمنا الكثير لنهتدى","https://www.poetsgate.com/ViewPoem.aspx?id=192648",""],[5956,"لا نستحقك يا بنيَّ الأغلى","https://www.poetsgate.com/ViewPoem.aspx?id=193441",""],[5956,"أما أسهمتُ في لُبِّ القضايا؟","https://www.poetsgate.com/ViewPoem.aspx?id=193582",""],[6003,"في حضرة النبي","https://www.poetsgate.com/ViewPoem.aspx?id=188899",""],[6056,"كل عصر له رجال ودولة","https://www.poetsgate.com/ViewPoem.aspx?id=130133",""],[6100,"حصه اللوغان","https://www.poetsgate.com/ViewPoem.aspx?id=52550",""],[6125,"لأنَّ سواكِ لنْ يَحظَىٰ بِقَلبِي","https://www.poetsgate.com/ViewPoem.aspx?id=208755",""],[6125,"وليس يَهمُّني في الناسِ شيءٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212866",""],[6202,"ما غيّروك عن النضال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86751&r=&rc=52",""]],"verses":[["لا نَسْأَمُ اللَّهْوَ الجميلَ","وليس يُدْرِكُنا الفُتُورْ",0,"ر",1,0],["لا نَسأَلُهُ ثَمَنَ المُهَجِ","وَكَفى بِالواجِبِ مِن ثَمَنِ",1,"ن",1,0],["لا نَستَكينُ لَدى الطِلابِ وَلا نَرى","عَنَتَ الزَمانِ إِذا اِستَمَرَّ غَراما",2,"م",2,0],["لا نَستَخِفُّ بِساقينا لِعِزَّتِهِ","وَلا يَرُدُّ عَلَيهِ حُكمَهُ أَحَدُ",3,"د",1,0],["لا نَستَطيعُ وَلا نُسطاعُ مِن سَرَفٍ","فَالصَفحُ أَمثَلُ مِن وَصلٍ عَلى رُقَبِ",4,"ب",1,0],["لأنْسَيَنّكِ إنْ طالَ الزمانُ بنا","وكمْ حَبيبٍ تَمادى عهدُه فنُسي",5,"س",2,0],["لا نسمِّيه فيكفي وصفُه","فيه عن كلِّ تعريفٍ غَناء",6,"ا",2,0],["لا نسل لا أهل لا أصحاب يفرقهم","دينا عن الخلق حكم ما من الصور",7,"ر",1,0],["لا نستطيع خروجا من دويرتنا","كأنما نحن في مسجان حبّاس",8,"س",1,0],["لا نستضيء بنور نستريح به","ولا تروحّنا ريح بنسناس",8,"س",1,0],["لا نسيبي ولا خليطي ولكن","منّة من مهيمن جبّار",9,"ر",1,0],["لأنس بين زيتون وزرع","وماء من غدير في ظروف",10,"ف",1,1],["لا نَسلْ عمّا عراني وَعَراها","ساعةً حيث تراني وأراها",11,"ه",2,0],["لِأُنسَأَ في عُمري قَليلاً وَما أَرى","لِدائِيَ إِن لَم يَشفِهِ اللَهُ شافِيا",12,"ي",2,0],["لا نسيم الصبا إذا هب وهنا","وبريق الحمى إذا الليل جنا",13,"ن",2,1],["لا نِساءُ الحَىّ حيًّتْنا ولا","بخيامِ الحَيّ شَبَّهْنا الخِياما",14,"م",2,0],["لا نسأم الضَّيفَ إن طالَتْ إقَامتُه","ولا نخيّب فينا ظنّ راجينا",15,"ن",2,0],["لا نَسِيَ اللّهُ لكم والعلا","ما زدتُمُ في عُدّتي أو عَتادْ",16,"د",1,0],["لا نسيمُ الصَّبا سيمومٌ ولا الجوّ","جهامُ الحيا ولا الظلّ ضاحي",17,"ح",2,0],["لا نستطيع نراه وهو الشمس في","إشراقه وجميعنا فيه الهبا",18,"ب",2,0],["لأَنْسَيْتَني أَهْلِي وَمَا زِلْتُ نَاسِياً","لِنِسْيَانِهِمْ أَو ذاكراً لهمُ ذِكْرا",19,"ر",2,0],["لا نستقر ونحن في واد وهم","في آخر انِ القرار حرام",20,"م",1,0],["لا نسألنك أن تهيِّئَ عسكراً","لجباً وأسطولاً أشم عظيما",21,"م",2,0],["لأنسيتنا ذكر الكرامِ بنائلٍ","أرانا بحار الجود وهي طوامي",22,"م",2,0],["لأَنْسِجَنَّ مِدَحاً وَمِدَحَا","كَرِيمَةً تَأْتِي امْرَأً مُمَدَّحا",23,"ح",2,0],["لا نستطيع الصبر عن","محبوبنا ولا الجفا",24,"ف",2,0],["لا نسبٌ عندي سوى صالحِ","الأعمال أَحسِنْ عملاً تُرفع",25,"ع",1,0],["لا نَسفِكُ الدَمَ إِلّا أَن يُرادَ بِنا","سَفكُ الدِماءِ طَريقاً واحِداً جُدُدا",26,"د",2,0],["لا نستجيشنه للهيجاء تضرمها","وتستطيل بأسيافٍ ومران",27,"ن",1,0],["لا نَسأَمُ البَغيَ وَالعُدوانَ يَتبَعُنا","حَيثُ اِرتَحَلنا فَما في اللَهِ مِن سَأَمِ",28,"م",1,0],["لا نستفيق من خمار لذَّةٍ","نتبع أبكار الهوى الأصائلا",29,"ل",2,0],["لأنَّ سَيرَ الشِّعرَيَين سريع","أسرضعُ مِن ذا الوَاقِعِ اللَّمُوع",30,"ع",1,0],["لإِنَّ سُكَّان بَرِّهَا أَوَاحِد","وَبَينَهُم خَبتٌ شَدِيدٌ كَايِد",31,"د",1,0],["لا نستحيل عن الاحبة إن جفوا","وطووا قلوبا حشوها الشحناء",32,"ا",2,0],["لأنَّ سباقكُم أبقى علَينا","هموماً لا تزالُ إلى المَماتِ",33,"ت",1,0],["لان سخرت مني الغواة فإنها","كذا دأبها في الأنبياء الأخائر",34,"ر",1,0],["لا نستحل له مالاً ولا ولداً","كالمشركين ولا نكسوه ايمانا",35,"ن",2,0],["لا نستطيع وداعا بعده كمد","لا نستطيع فراقا بعده ألم",36,"م",1,0],["لإنسان عيني مرسلاتُ مدامع","لها نبأ فيمن ثناياه كوثرُ",37,"ر",1,0],["لأن سبط المصطفى من بعده","قد صار بالشرط ولي عهده",38,"ه",1,0],["لأنسك أَشواقي وَفيك محبتي","وَفكرُك فرضي وَادّكارُك سنتي",39,"ي",1,1],["لا نسيل الدماء حتى يسيل ال","حبر من ذلك الخلال النحيف",40,"ف",1,0],["لأن ساحتهم بالجود قد ملئت","من دونها البحر في موج وتيار",41,"ر",1,0],["لا نسأل الدنيا جناح بعوضة","والذل غايته أقل سؤال",42,"ل",1,0],["لا نستحيل عن الآسنة والندى","كالنجم عن أفلاكه لم يخرج",43,"ج",1,0],["لأنسى حاتماً وأبان جوداً","وما أبقى لمعنى الجود معنى",44,"ن",2,0],["لأن سرنا منها مشارع مورث","فقد ساءنا منها تراث مقسم",45,"م",1,0],["لأنّ سِباقكم أَلقى عَلينا","هُموماً لا تزال إلى المماتِ",46,"ت",1,0],["لا نُستَخَفُّ إذا كانَ الصباحُ ولا","نُعطِي السوابغَ إلا أَهلَها فِينَا",47,"ن",2,0],["لأنس الشخص بالمخلوق غم","فلا أنس سوى بالله فاسم",48,"م",1,1],["لأنسان عين العلم قاضي مدينة","السلام شريفُ الذاتِ سامي المراتب",49,"ب",1,1],["لا نَستطيعُ سِوَى المحبَّةِ قَولَةً","رُفِعَ الكَلامُ, وجَفَّتِ الأقلامُ",50,"م",1,0],["لا نستطيعُ أداءَ دَيْنِكَ وافياً","فالله عنّا بالجزاءِ كفيلُ",51,"ل",1,0],["لا نستطيع الخوضَ في ملكوته","يكفيك إطلالٌ على شطآنه",52,"ن",2,0],["لا نُسألُ يوماً عن عملٍ","ممنوعٍ...، أم كان مباحا",53,"ح",2,0],["لِأنَّ سَمَاءَ الحُبّ أَضْحَتْ عَدُوّةً","وَتَرْمِي عَلَى الْعُشّاقِ نَارَ المَدَافِعِ",54,"ع",1,0],["لأنسى يقيني بمسرى حنيني","ويوقظ شوقي مسيل العِبرْ",55,"ر",1,0],["لا نسيبٌ يجيرُها من عدوٍّ","أو حبيبٌ على يديهِ تنام",56,"م",1,0],["لإن سواه لم يمحز رفعة الرقا","إلى الذروة العليا إلى عند عنده",57,"د",2,0],["لانسانه هاذي انا ، مفروض ترجعلي","وان مارجعت لي وش اللي بس في يديني",58,"ن",2,0],["لا نستطيع نقول شعراً رائعاً","ومؤثِّراً من دونما أوزانِ",59,"ن",1,0],["لأن سيوف البغي حزت رقابهم","فمن يبك من؟ والكل من ذاك كائل",60,"ل",1,0],["لإنسانيةٍ في عمق قلبي","تعاند أن تُكيلَ لهم خصاما",61,"م",2,0],["لإنسانيَّة فيها","خلاصُ الكون من فِتَنِ",62,"ن",1,0],["لا نستطيع نحيط من تعليمه","إلا بما هو شاء من إعلانِ",63,"ن",1,0],["لا نستحقك يا بنيَّ الأغلى","يا من رفعت مكاننا للأعلى",64,"ل",2,1],["لإنسانيَّة أدعو البرايا","ويجْري عند ربِّ الناس أجري",65,"ر",2,0],["لأنسج من نور المديح قصيدة","وأقطف من حلو الكلام نوادره",66,"ر",2,0],["لا نساك الرفيق ، اللي بظلمك تبلا ّ","فالهجر بينكم لا طال ، تصعب حلوله",67,"ل",2,0],["لا نستني قلت هالعالم نساني","ولا ذكرتني طاح من هالراس شيب",68,"ب",1,0],["لأنَّ سواكِ لنْ يَحظَىٰ بِقَلبِي","هَجَرْتُ النَّاسَ أو سَكَّرْتُ بَابَهْ",69,"ب",2,1],["لأنَّ سواكِ لو جَادَتْ بحبٍ","علىٰ البَطْحَاءِ ما دَخَلتْ لُبَابَهْ",69,"ب",2,0],["لأنَّ سواكِ لنْ يَحظىٰ بقربي","سوىٰ ما زاغَ منهُ أو سَرَابَهْ",69,"ب",2,0],["لأنَّ سواكِ ما ملَّكْتُ عيني","ولا مُلِئتْ جفوني يا مُرِيدَهْ",70,"د",2,0],["لا نستكين لباطل","أو نرتضي فيه السبب",71,"ب",1,0]]}