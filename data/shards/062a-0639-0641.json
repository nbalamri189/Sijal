{"poems":[[110,"فؤادك أولى بالعتاب","https://www.shoaraa.com/p13816",""],[65,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[32,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[74,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[74,"فطمت ولائي ثم أقبلت عاتبا","https://www.aldiwan.net/poem19477.html","الطويل"],[16,"طحا بك قلب في الحسان طروب","https://www.aldiwan.net/poem27695.html","الطويل"],[64,"لنا أرض نشمسها زمانا","https://www.aldiwan.net/poem52218.html","الوافر"],[64,"أيا بانتي وادي الأراك وقيتما","https://www.aldiwan.net/poem52264.html","الطويل"],[47,"حقا أقول لقد تبلت فؤادي","https://www.aldiwan.net/poem63504.html","الكامل"],[2,"أمن أم أوفى دمنة لم تكلم","https://www.aldiwan.net/poem25065.html","الطويل"],[46,"متى أنت عن ذهلية الحي ذاهل","https://www.aldiwan.net/poem30372.html","الطويل"],[33,"ألم تربع على الطلل","https://www.aldiwan.net/poem42022.html","مجزوء الوافر"],[33,"أفي رسم دار دارس أنت واقف","https://www.aldiwan.net/poem42225.html","الطويل"],[107,"عندي إذا صرع الجنوب سبات","https://www.aldiwan.net/poem42095.html","الكامل"],[77,"أرقت لبرق يستطير له لمع","https://www.aldiwan.net/poem69066.html","الطويل"],[50,"إذا أنت زوجت الكريمة كفوها","https://www.aldiwan.net/poem62614.html","الطويل"],[50,"سماه أحبابه المسكين قد صدقوا","https://www.aldiwan.net/poem65320.html","البسيط"],[52,"ألا يا نفس المسك الذي","https://www.aldiwan.net/poem63800.html","الهزج"],[15,"تعفت رسوم من سليمى دكادكا","https://www.aldiwan.net/poem45257.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54963","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54735","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[92,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[16,"طَحَا بكَ قَلبٌ في الحِسان طروبُ","https://www.poetsgate.com/ViewPoem.aspx?id=4900",""],[135,"غشيت برابغ طللاً محيلا","https://www.aldiwan.net/poem23993.html","الوافر"],[146,"مرض بقلبك ما يعاد","https://www.aldiwan.net/poem58409.html","مجزوء الكامل"],[164,"على الطالع الميمون قد أسس القصر","https://www.aldiwan.net/poem59039.html","الطويل"],[164,"ما خاب من في الله كان رجاه","https://www.aldiwan.net/poem59130.html","الكامل"],[242,"أقول لمن يصيخ إلى اصطراخي","https://www.aldiwan.net/poem18130.html","الوافر"],[242,"سلام مخجل عرف الغوالي","https://www.aldiwan.net/poem18854.html","الوافر"],[285,"أفيض دموع أم سيول تموج","https://www.aldiwan.net/poem60699.html","الطويل"],[310,"يرى بالكس للناس اعتناء","https://www.aldiwan.net/poem56613.html","الوافر"],[385,"تعفى العقيق وكثبانه","https://www.aldiwan.net/poem49200.html","المتقارب"],[447,"يا عارضا بات مثل العرق بارقه","https://www.aldiwan.net/poem14429.html","البسيط"],[463,"إذا لم يقرب منك إلا التذلل","https://www.aldiwan.net/poem56075.html","الوافر"],[463,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[466,"أرادت جوارا بالعراق فلم تطق","https://www.aldiwan.net/poem15094.html","الطويل"],[469,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[475,"زايلت ما صنعوا إليك برحلة","https://www.aldiwan.net/poem4781.html","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133833","السريع"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25341","الرجز"],[1175,"","https://poetry.dctabudhabi.ae/diwan/poem/67747","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21665","الكامل"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45428","الطويل"],[2230,"","https://poetry.dctabudhabi.ae/diwan/poem/101793","الطويل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28084","الطويل"],[2292,"","https://poetry.dctabudhabi.ae/diwan/poem/200315","الوافر"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126233","الكامل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111265","المتدارك"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87752","الطويل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146322","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132675","الكامل"],[3411,"","https://poetry.dctabudhabi.ae/diwan/poem/79759","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108053","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114104","البسيط"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139452",""],[4181,"","https://poetry.dctabudhabi.ae/diwan/poem/58","الوافر"],[4224,"","https://poetry.dctabudhabi.ae/diwan/poem/146101","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81921","الطويل"],[4767,"رب الفضائل","https://www.poetsgate.com/ViewPoem.aspx?id=178735",""],[5046,"خذوها للمصحة ..","https://www.poetsgate.com/ViewPoem.aspx?id=202572",""],[5219,"نصيحتي","https://www.poetsgate.com/ViewPoem.aspx?id=194910",""],[5273,"صهيل القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=162118",""],[5542,"غدا يتحدث الرطب","https://www.poetsgate.com/ViewPoem.aspx?id=10030",""],[5582,"قِفَا بِالرُّسُومِ الخَوالِي القِفارِ","https://www.poetsgate.com/ViewPoem.aspx?id=63523",""],[5829,"فما ظنك برب رحيم","https://www.poetsgate.com/ViewPoem.aspx?id=179542",""],[5860,"فراق","https://www.poetsgate.com/ViewPoem.aspx?id=191882",""],[6056,"المايس المهصور","https://www.poetsgate.com/ViewPoem.aspx?id=156698",""],[6124,"سيدنا","https://www.poetsgate.com/ViewPoem.aspx?id=174759",""],[6183,"أنت المغني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79843&r=&rc=33",""],[406,"غداً يتحدث الرطب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=827&r=&rc=18",""],[6304,"الشمس الجريحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1611&r=&rc=1",""],[5190,"للأرض وجهٌ آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78324&r=&rc=37",""]],"verses":[["تعفت مغانيها ولم أرى قبلها","جديبا تعفت بالرمال سحائبه",0,"ب",2,0],["تَعْفو وتَصْفَحُ عنْ عِزٍّ ومَقدِرَةٍ","ولا نَراكَ وقيذَ الحِلْمِ مُنْتَقِما",1,"م",2,0],["تَعَفَّت لِتهتانِ الشِتاءِ وَهَوَّشَت","بِها نآئِجاتُ الصَيفِ شَرقيَّةً كُدرا",2,"ر",2,0],["تعفو الرسوم من الديارِ وما","تعفو رسوم هواكَ من قلبي",3,"ب",2,0],["تعفي رياح العذر منك رقومها","لما نسجتها من جنوب وشمأل",4,"ل",1,0],["تَعَفَّقَ بِالأَرطى لَها وَأَرادَها","رِجالٌ فَبَذَّت نَبلَهُم وَكَليبُ",5,"ب",1,0],["تعفَّرَ في بطون الأرض منها","وأطلع نبتها زهرا جميلا",6,"ل",2,0],["تعفُّ يدي ما بينَها وسريرتي","ويفسُقُ طرفي دونَها ولساني",7,"ن",2,0],["تَعفو لِعَفوِ اللَهِ عَنكَ تَحَرِّياً","وَالعَفوِ خَيرُ خَلائِقِ الأَمجادِ",8,"د",1,0],["تُعَفّى الكُلومُ بِالمِئينَ فَأَصبَحَت","يُنَجِّمُها مَن لَيسَ فيها بِمُجرِمِ",9,"م",1,0],["تَعَفَّينَ مِن زادِ العُفاةِ إِذا اِنتَحى","عَلى الحَيِّ صَرفُ الأَزمَةِ المُتَماحِلُ",10,"ل",1,0],["تُعَفّي رَسمَهُ الأَروا","حُ مِن صَبَإٍ وَمِن شَمَلِ",11,"ل",1,0],["تُعَفّي عَلى الآثارِ أَن تُعرَفَ الخُطى","ذُيولُ ثِيابٍ يُمنَةٍ وَمَطارِفُ",12,"ف",1,0],["تعفو الممالكُ أو تَبيدُ إذا عَفَتْ","فيها الحقوقُ وبادتِ الحُرُماتُ",13,"ت",1,0],["تعَفّى فما قُلنا سُقِيتَ غمامَةً","ولا انعِمْ صباحاً بعدهم أيها الرَّبْع",14,"ع",1,0],["تِعَفِّفُهُ مادامَ في الحَبسِ ثاوِياً","وَما خالَفَتهُ مُصمِتاتُ الحَدائِدِ",15,"د",1,0],["تَعفو الهَواجِرُ عَن وَجهي مَحاسِنَهُ","وَأَنتَ في غَمرَةِ اللَذّاتِ مَكنونُ",16,"ن",1,0],["تُعَفّي أَثَري عَمداً","بِجَرِّ المَرطِ وَالقَرقَر",17,"ر",1,0],["تَعَفَّت رُسومٌ مِن سُلَيمى دَكادِكا","خَلاءً تُعَفّيها الرِياحُ سَواهِكا",18,"ك",2,1],["تَعْفَو عَنِ المُخْطِيء فِي حقِّهَا","حِلْماً وَتسْتعْفِي مِنَ النكْرِ",19,"ر",1,0],["تَعْفُو الْفُتُوحَاتُ وَأَرْبَابُهَا","وَذِكْرُهَا فِي النَّاسِ قَدْ خُلِّدَا",20,"د",2,0],["تُعَفِّرُ بِالتُّرْبِ الْجَبِينَ الَّذي عنَا","لَهُ الشَّرْقُ وانْقَادَتْ إِلَيْه جَحَافِلُهْ",21,"ل",2,0],["تُعْفي الشدائدُ أقْواماً بلا أدَبٍ","وتبتلي غيرَ مُحتاجٍ لتأديب",22,"ب",1,0],["تَعفَّق بالأرْطى لها وأرادها","رجالٌ فَبَذَّتْ نَبْلَهم وَكَليببُ",23,"ب",1,0],["تَعَفَّت غَيرَ سُفعٍ ماثِلاتٍ","يَطيرُ سَوادُهُ سَمَلاً جَفَولا",24,"ل",2,0],["تعفو المنازلُ إن نأَوا","عنها وتغبرُّ البلادُ",25,"د",1,0],["تعفر ذلا في التراب وجوهها","وتلقى بأيديها إلى من له الأمر",26,"ر",1,0],["تعفو عن الذنب العظيم وتكشف","الخطب الجسيم وقد دجت ظلماه",27,"ا",2,0],["تَعَفَّفْ فَالْعَفَافُ أَجَلُّ حِلْيٍ","إذَا مَا الفَقْرُ عَمَّكَ بِالنِّضاخِ",28,"خ",1,0],["تَعَفَّنَ مِنْ وَدَاعِكَ خِلْطُ صَبْرِي","فَحُمَّ الْبَالُ مِنْ فَرْطِ الْخَبَالِ",29,"ل",1,0],["تَعَفَّتْ رُسُومُ الْمَكْرُماتِ كَما عَفا","عَلَى الدَّهْرِ مَلْحُوبٌ وَأَفْقَرَ مَنْعِجُ",30,"ج",1,0],["تعفّفَ عنهُ كلّ عفيفِ طبعٍ","وَهامَ بهِ الطغامُ الأغبياء",31,"ا",2,0],["تَعفّى العَقيق وَكُثبانُهُ","وَأَوحَشَ إِذ بانَ سُكّانُهُ",32,"ن",2,1],["تعفو وترضى وهذا الغيظ تكظمه","أَولى وَأَجدر مذ بانَت حقائقه",33,"ق",2,0],["تعفَّفتَ فاليومان عندك واحدٌ","وأحظاهما ما كان بالدِّين يُشغَلُ",34,"ل",1,0],["تُعفِّي الخطايا بإقلاعهِ","وتمحو الذنوبَ بإقرارِهِ",35,"ر",2,0],["تعفي فضول الريط سحباً على الخط","ويُخفي فشيب العبقريِّ الناجيا",36,"ي",2,0],["تعفُّ فما في وجهها خجلةُ الخنا","وتسخو فما في عطفها قسوة العضب",37,"ب",1,0],["تَعفو إِذا جَهِلوا بِحِلمِكَ عَنهُمُ","وَتُنِيلُ إِن طَلَبوا النَوالَ فَتُجزِلُ",38,"ل",1,0],["تعفو الأماني فوق أكتافه","وتسمر الأقمار والنيرّات",39,"ت",1,0],["تَعْفُوا عَلَى جرْثُومِهِ العَوَافِي","تَضْرِبُها الأَمْطارُ وَالسَوَافي",40,"ف",2,0],["تَعَفَّفْتُ عَنْهَا فِي العُصُورِ الَّتِي خَلَتْ","فَكَيْفَ التَّصَابِي بَعْدَمَا كَلأَ الْعُمْرُ",41,"ر",1,0],["تَعفو الصَبا ذَيلَ الدَبورِ وَتارَةً","يَدعو لَها نَفسُ الجَنوبِ شَمالَها",42,"ل",3,0],["تَعَفَّفَت عَن شَتمِ العَشيرَةِ إِنَّني","وَجَدتُ أَبي قَد عَفَّ عَن شَتِمها قَبلي",43,"ي",1,1],["تعفيت يا ربع الأحبة بعدهم","فذكرتني قبر البتولة إذ عفي",44,"ف",2,0],["تَعفَّت مَغانيها وَخَفَّ أَنيسُها","مِن أَدهَمَ مَحروسٍ قَديمٍ مَعاهِدُه",45,"د",2,0],["تعفونا الأعاجم عن صعيد","بكل مشوه علج خشان",46,"ن",1,0],["تَعفُو وتصفَحُ عن ذُنُوبٍ ماضِياً","حاشا لمجد أن تَقنُطَ عاصياً",47,"ي",2,0],["تعفو عمن ناواك وعن","كرم تعفو لا عن ضعف",48,"ف",1,0],["تَعفَّف حَتّى لا يَرى الدَهر شاكياً","فَيَحسب مِن أَهل الغِنى وَهُوَ بائس",49,"س",1,0],["تعفو السّطور إِذا تقادَمَ عَهْدُها","والخلق في رِقّ الحياة سُطُور",50,"ر",1,0],["تعفو رسوم دياركم فنزورها","شوقا ونستسقي السحاب الرّضا",51,"ض",2,0],["تعَفَّى من جُلالةَ روْضُ قُبْلى","فأَقْرِيَةُ الأعِنَّةِ فالدخولُ",52,"ل",1,1],["تعفيه مما يلاقي بعد من نكد","في عيشه ويقاسي بعد من كمد",53,"د",1,0],["تَعَفَّفُوا عَن جَميعِ مَا يَشِينُ وَمَا","تَعَفَّفُوا عَن قَبُولٍ لِلهَدِيَّاتِ",54,"ت",1,0],["تعفو بعدلٍ وتسطو إن سطوتَ به","فلا عدمناك من عافٍ ومنتقم",55,"م",1,0],["تَعَفّى رَسمُهُ إِلّا خِياماً","مَجَلَّلَةٌ جَوانِبُها جَليلا",56,"ل",2,0],["تعفر من مس التراب جبينه","وقد عاش دهراً ما تعفر حاجبه",57,"ب",2,0],["تعفّر في عقر الثرى جبهاتها","كأنَّ الثرى تحت الجباه رفارف",58,"ف",1,0],["تعفو وتصفح قادراً في ساحةٍ","ما زال فيها يمتطي ويصول",59,"ل",1,0],["تُعفِّرُ وجهها جذْبًا لبعلٍ","كمثلِ الثَّورِ للميدان يُخرجْ",60,"ج",1,0],["تَعَفّفْ عنِ القَولِ البَذيءِ تَكَرُّما ..","فَعندَ اللُّقَا خزْيٌ وساءَ مهادُ",61,"د",1,0],["تَعْفو وتُهْلِكُ, لا رَبّاً ولا وَثَنَا","تُؤوي وتَطْرُدُ, لا مَنفىً ولا سَكَنَا",62,"ن",2,1],["تعفر وجه خيمتنا","وما شدت لها الطلب",63,"ب",1,0],["[ تَعَفَّتْ وَلَمْ يَبْقَ فِي الرَّسْمِ مِنْها","سِوَى النُّؤْيِ مُدَّعْثِراً وَالأَوارِي ]",64,"ر",2,0],["تعفو وتصفح عن ذنب فتجعله","خيرا يثقّل في الميزان إن حشرا",65,"ر",2,0],["تعفف ليس غير الله يعطي","بلا من ولا شكر يؤدي",66,"د",2,0],["تعفف حياها ** واستحى من طلوع النور","وقبل الشروق أبعد ** كالخيل ملزوزة",67,"ز",2,0],["تعفقُ ألفَ ذراعٍ من ضوءِ","وخلايا الرئةِ عبيرٌ من أرضِ الوردِ.",68,"د",1,0],["تَعَفَّرَ الكِبْرُ فافتَحْ بابَ عِزَّتِنا","وَ اهْدُمْ جِدارَ الأَسَى كَي يَدْخلَ الصُّبْحُ",69,"ح",1,0],["تعفر وجه خيمتنا","وما شدت لها الطنب",70,"ب",1,0],["تُعفرُ خَدّاً في الثرى من تَذَلٌلٍ","وتمسحُ خداً بالدم ِ الحُرَّ يَنزفُ",71,"ف",1,0],["تعفو برغم جحودهم وشرورهم","عنهم ، كما يعفو قويٌّ قادرُ",72,"ر",1,0]]}