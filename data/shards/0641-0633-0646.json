{"poems":[[55,"لمن الحدوج تهزهن الأنيق","https://www.aldiwan.net/poem29959.html","الكامل"],[46,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[76,"إن للجنة في الأندلس","https://www.aldiwan.net/poem12970.html","الرمل"],[125,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[154,"رحلت وقد وجدت العيش مرا","https://www.aldiwan.net/poem68481.html","الوافر"],[275,"بكرت لتسقي زهر جنتها الندي","https://www.aldiwan.net/poem35447.html","الكامل"],[354,"أمرتني بستر كشف غطائي","https://www.aldiwan.net/poem15499.html","الخفيف"],[406,"أيها القانون","https://www.aldiwan.net/poem6781.html","عموديه"],[466,"نحن قوم من تميم بن مر","https://www.aldiwan.net/poem16100.html","المديد"],[469,"سر الحسود بما أساء وارجفا","https://www.aldiwan.net/poem3261.html","عموديه"],[541,"أشاقك بالمنتصى منزل","https://www.aldiwan.net/poem23851.html","المتقارب"],[549,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[592,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86803","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38764","الكامل"],[964,"","https://poetry.dctabudhabi.ae/diwan/poem/140199",""],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72256","الطويل"],[1224,"","https://poetry.dctabudhabi.ae/diwan/poem/130642","الكامل"],[1754,"","https://poetry.dctabudhabi.ae/diwan/poem/107350","الكامل"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104466","الرجز"],[2249,"","https://poetry.dctabudhabi.ae/diwan/poem/202569","الكامل"],[2395,"","https://poetry.dctabudhabi.ae/diwan/poem/101400","الرمل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93869","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58397","الرجز"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71379","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74080","الرمل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46024","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117903","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81722","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120526","الطويل"],[4767,"العلامات المبينة","https://www.poetsgate.com/ViewPoem.aspx?id=94788",""],[5397,"سالمت دهرا لا يريك التهانيا","https://www.poetsgate.com/ViewPoem.aspx?id=157960",""],[5459,"لزمنا الليل","https://www.poetsgate.com/ViewPoem.aspx?id=190906",""],[5542,"صرخة مرصعة بالإخلاص","https://www.poetsgate.com/ViewPoem.aspx?id=10073",""],[6102,"خلخال","https://www.poetsgate.com/ViewPoem.aspx?id=182738",""],[5309,"قفا نحمد الأيام ان كان يحمد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573526",""]],"verses":[["فَسَنامُها لا يُمتَطى وَنَباتُها","لا يُختَلى وَفَناؤُها لا يُطرَقُ",0,"ق",1,0],["فَسَنَنتَ بِالمَعروفِ مِن أَثَرِ النَدى","سُنَناً شَفَت مِن دَهرِنا المَذمومِ",1,"م",1,0],["فَسَنا صُبحَتِها مِن شَنَبٍ","وَدُجى ظُلمَتِها مِن لَعَسِ",2,"س",1,0],["فسناؤه وثناؤه لن يحصرا","ضوءاً ومدحاً تامكاًمتنسما",3,"م",2,0],["فسنّى الله لي براً حديثاً","نسيتُ بطيبه البرّ القديما",4,"م",2,0],["فسناهُ عن ذاكَ النَّسيمُ حميَّةً","فارتَدَّ مثلَ المذنبِ المتردّد",5,"د",1,0],["فَسَناها أَهدى لِعَيني ضِياها","وَهُداها أَسرى إِلَيَّ هُدائي",6,"ي",1,0],["فسنلقاكَ بدرعٍ من يقينٍ","وسهامٍ من دعاءٍ وابتهال",7,"ل",1,0],["فَسَنَّنا الصَّبْرَ والبأسَ حتى","حَسَدَ الفخريْنِ طوْدٌ ونصْلُ",8,"ل",1,0],["فسناك نور الداجيات فلا خبا","وذراك ربع المكرمات فلا عفا",9,"ف",2,0],["فَسَنَّ الصَلاةَ لَنا وَالزَكاةَ","وَبِرّاً بِذي رَحِمٍ يوصَلُ",10,"ل",1,0],["فسنصهر الاُفق البعيد على لظى","عزماتنا حتى يذوب الكوكب",11,"ب",1,0],["فسنة القصر إن كنت مقتد","فراتبة فاعلم بذلك ترشد",12,"د",1,0],["فَسناها قَد قالَ للمجد أَرّخ","فاضلٌ برّه نَما بِحَميده",13,"د",2,0],["فَسِنانهُ يَدري كَلام قُلوبهم","فَلِذا لَها بِسِنانِهِ قَد كَلَّما",14,"م",2,0],["فسنى الألب واللورين والال","زاس ماذا شهدن يوم اللحاق",15,"ق",1,0],["فسنهم إمام الحق حيدرة الذي","أبان غموض المشكلات الغرايب",16,"ب",1,0],["فسناك يجلوه الذي ل","م يعم عن بدر الكمال",17,"ل",1,0],["فسناؤهُ متكرّمٌ وضياؤهُ","متصرمٌ وسخاؤهُ متعظّم",18,"م",1,0],["فسني ما فيه قد أنباني","وبت ليلى ذاك في مكاني",19,"ي",1,0],["فسنانه وبنانه جعلا معا","أجل العدو ونجعة المسترزق",20,"ق",1,0],["فسنسقي كربلا بالعبرات","وكفا من علق القلب الأسوف",21,"ف",1,0],["فسناها كأنَّهُ قد روى عن","شيخنا الشيخِ ما العيون العلاني",22,"ن",2,0],["فسنا الفضل والمعارف أبهى","من سنا البدر كاملاً والشموس",23,"س",1,0],["فَسَنّها الكحّالُ حتّى فَتَكَتْ","بيضُ ظُباها بالسّوادِ الأَعظَمِ",24,"م",1,0],["فَسِنانُ القَنَاة أَضْعَفُ فِعْلاً","مِنْ جُفُونٍ وَسْنَى عَلَوْنَ قُدوُدا",25,"د",2,0],["فَسَناها ملء عَيني","بالتَهاني متلالي",26,"ل",2,0],["فَسناءُ مَجدٍ مِثلُ مَجدِكَ خازِنٌ","لِلنَّجمِ يَحسده السماكُ طليبا",27,"ب",2,0],["فسنام أي الأرض اذهب منزلي","ولي الندامى الغر من أمجادها",28,"د",3,0],["فسنانه آخيل أنفذ في","رئتيه لما بالسنان طعن",29,"ن",1,0],["فسنوهُ مشبهةٌ أنابيبَ القنا","عَدَداً وعدُّ خلالِهِ كالأنجم",30,"م",1,0],["فسنى لها وجه السداد وزانها","كما ازدان جيد المرأة الخود بالعقد",31,"د",1,0],["فسنسقى الغث إن لم نحمِ حقاً","يحرق الدمع من الهم جفونه",32,"ن",2,0],["فسنت لمن سن الهدى غرب قضبها","وقد شرعت تلك الرماح العواليا",33,"ي",2,0],["فَسُنَّةُ خَيْرِ خَلْقِ اللَّهِ بَاتَتْ","تُعَاتِبُنَا وَيَلْعَنُنَا الكِتَابُ..",34,"ب",1,0],["فسننحر الخوف الجبان","بخنجر الحق الصراح",35,"ح",1,0],["فَسَناءُ الفَجرِ المُشَعشِعُ إِلَّم","يَقبِسِ الحُسنَ مِنكِ مَا انشَقَّ أَبلَجْ",36,"ج",1,0],["فَسُنُّوا لَنا ما فيهِ خَيرٌ لأنَّناَ","سَنَمضي وَإِيّاكُم إِلى حَيثُ نَقصِدُ",37,"د",1,0]]}