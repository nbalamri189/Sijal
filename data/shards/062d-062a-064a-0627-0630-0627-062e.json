{"poems":[[57,"يا من يكاتمني تغير قلبه","https://www.aldiwan.net/poem26133.html","الكامل"],[57,"يا من تمادى قلبه في الهوى","https://www.aldiwan.net/poem26347.html","السريع"],[79,"النصر نصك والحسام دليله","https://www.aldiwan.net/poem36377.html","الكامل"],[64,"قد كان حظي في الكتابة ناقصا","https://www.aldiwan.net/poem52389.html","الكامل"],[47,"الآن أيقنت أن الرزق أقسام","https://www.aldiwan.net/poem66656.html","البسيط"],[68,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[68,"أسلبن من فوق النهود ذوائبا","https://www.aldiwan.net/poem41382.html","الكامل"],[99,"راحوا بأرواحٍ ظماء","https://www.aldiwan.net/poem24773.html","مجزوء الكامل"],[82,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[107,"لمن دم في مغاني الحي مطلول","https://www.aldiwan.net/poem42135.html","البسيط"],[52,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[8,"لمن الديار عفون بالتهطال","https://www.aldiwan.net/poem21828.html","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67347","الكامل"],[185,"يا للرجال هوى أميمة قاتلى","https://www.aldiwan.net/poem58883.html","الكامل"],[234,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[327,"أضحت أميمة لا ينال زمامها","https://www.aldiwan.net/poem56344.html","الكامل"],[370,"لمن الديار بروضة السلان","https://www.aldiwan.net/poem44474.html","الكامل"],[398,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[526,"حكاية امرأة مهزومة","https://www.aldiwan.net/poem25135.html","البسيط"],[549,"وراءَ أروقة الخيام","https://www.aldiwan.net/poem67257.html","عموديه"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103083","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48629","البسيط"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117459","الكامل"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26669","الكامل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96486","البسيط"],[2100,"","https://poetry.dctabudhabi.ae/diwan/poem/34962","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53198","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111281","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100896","الكامل"],[2769,"","https://poetry.dctabudhabi.ae/diwan/poem/98163","المنسرح"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67583","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112335","السريع"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74037","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62759","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62817","المنسرح"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86338","البسيط"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/141688","الرجز"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59510","الكامل"],[5183,"السر الخفي","https://www.poetsgate.com/ViewPoem.aspx?id=180211",""],[5464,"القتلى لن يُحييهم الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=125401",""],[5829,"امنت بالله","https://www.poetsgate.com/ViewPoem.aspx?id=155462",""]],"verses":[["حَتّى إِذا خَشِيا الوُشاةَ وَأَشفَقا","جَعَلا الإِشارَةَ بِالأَنامِلِ سُلَّما",0,"م",2,0],["حَتّى إِذا خاطَبتُهُ بِالهَوى","خاطَبَني بِالسَبِّ وَالزَجرِ",1,"ر",1,0],["حَتَّى إِذَا خَطَبَتْكَ أَلْسِنَةُ الْهُدَى","وَحَبَاكَ هَذَا الْعَهْدَ إِسْمَاعِيلُهُ",2,"ل",2,0],["حتَّى إِذا خدمَ اليراعةَ خاطرِي","قعدَ الجُدودُ بها وهن عواثِرُ",3,"ر",1,0],["حَتّى إِذا خَفَّ بِالجُلّاسِ مَجلِسُهُ","وَدارَ فيهِ لَهُم نَقضٌ وَإِبرامُ",4,"م",1,0],["حَتّى إِذا خافَ الأَنامُ بَعدَهُ","تَعَلُّقَ المُلكِ بِغَيرِ مُرشِد",5,"د",1,0],["حَتّى إِذا خَطِفَ المَكافِحُ خَطفَةً","أَتبَعتَهُ مِنها شِهاباً ثاقِبا",6,"ب",2,0],["حتى إذا خلب العقو","لَ وقيل سِحرٌ لا مراء",7,"ا",2,0],["حَتَّى إذا خافَتْ مُرَاقِبَها عَلا","مِنها عَلى الوجهِ المنيرِ عِجارُ",8,"ر",1,0],["حتّى إذا خَرَّ طارتْ حول مَوقعِه","هَلكَى النُّفُوسِ وضَجَّ العصرُ والجيلُ",9,"ل",1,0],["حَتّى إِذا خَيَّمَت بِعاقِبَةٍ","جاراتِ والٍ يُفَرِّجُ الكُرَبا",10,"ب",2,0],["حَتّى إِذا خَفَقَ السِماكُ وَأَسحَرا","وَتَبالَيا في الشَّدِّ أيَّ تَبالِ",11,"ل",1,0],["حَتَّى إذَا خَلَصُوا إلى أبْوَابِهِ","دَخَلُوا عَلَيْهِ صَائماًعَطْشَانَا",12,"ن",2,0],["حتّى إِذا خَشَّعنَها بِأَزِمَّةٍ","مِن صُنعِ ماهِرةِ الأَكفِّ جَوادِلِ",13,"ل",1,0],["حتى إذا خِفتُ عيون الهُجَّد","وانكدرت زُهْرُ النجومِ الوُقَّد",14,"د",1,0],["حَتّى إِذا خَفَّت وَأَقلَعَ غَيمُها","لَبِسَت تَهاويلَ النَباتِ إِكامُها",15,"م",3,0],["حتى إِذا خَفَتَ الدُعاءُ وَصُرِّعَت","قَتلى كمُنقَعِرٍ من الغُلَّانِ",16,"ن",1,0],["حَتّى إِذا خَطَّ المَشيبُ بِعارِضي","خَطَّ الاِنابَةِ رُمتُها بِتبتُّل",17,"ل",1,0],["حتى إذا خلتني في النور مروحةً","أطوي الغمام ولا أخشى من العسسِ",18,"س",1,0],["حتّى إذا خِدرُ العقيلة أجهشت","أستارُه في مسمع الأبطالِ",19,"ل",1,0],["حتى إذا ختم القيام وروده","يطوى وينشر ما طواه وينشر",20,"ر",1,0],["حتى إذا خاف أن يقضي أسىً وجوىً","أمضى إليها كتاباً فيه قد كتبا",21,"ب",2,0],["حتى إذا خافت هجومَ صباحِها","نَشرَت ثلاثَ ذوائبٍ من شعرِها",22,"ه",2,0],["حتى إذا خلصت تعودُ كما بدت","ومن الخلاصِ مشقَّةٌ وعناء",23,"ا",2,0],["حتى اذا خلَّفوا الأهواز واجتمعوا","برامهرمز وافاهم بها الخير",24,"ر",1,0],["حَتّى إِذا خِفتهُ فارَقتُ مَنزِلَهُ","مِن بَعدِ ما قيلِ عِمرانُ بنُ حطّانِ",25,"ن",1,0],["حتى إذا خمتم تبارت خيله","تختال بين مضارب وخيام",26,"م",1,0],["حَتَّى إذَا خَالَفتَ آراءَ الرِّجَا","لِ لِسُنَّةِ المَبعُوثِ بِالقُرآنِ",27,"ن",1,0],["حتىإذا خلق المهيمن حيدراً","قرب المحال به إلى الامكان",28,"ن",1,0],["حتَّى اذا خفَّ الزمان بكفَّتى","لم ألقَ منه غير ما أَتوقَّع",29,"ع",1,0],["حتى اذا خاتلوك واجتهدوا","وساعد النفس كيد مجتهد",30,"د",1,0],["حتى إذا خلَّيتتَ عني نابني","ما نابَني وتنَكَّرت أيَّامي",31,"م",2,0],["حتى إذا خُضتُ الليالي الطوال","أطلقتُ للأحلام فيها العنان",32,"ن",1,0],["حَتّى إِذا خابوا وَأَخفَق سَعيُهم","حقدوا وَمَن يخفق بسعي يحقدِ",33,"د",1,0],["حتى إذا خِفتُ أنْ تُنْسى مكارمُهُ","ويُخْمَدُ الثاقبُ الوقادُ من شُعَلِهْ",34,"ل",2,0],["حتى إذا خِفتَ أنْ تَنالَهُمُ","من عثراتِ الجنودِ أظفارُ",35,"ر",1,0],["حَتّى إِذا خالَني قَد صَدَّ مُبتَعِداً","كَأَنَّما قَلبُهُ في قَسوَةٍ حَجرُ",36,"ر",1,0],["حتّى إِذا خَالَطَ أَو قِيل سَطَا","وشَدّ فَنَّينِ عِرَاضاً وتَلاَ",37,"ا",1,0],["حتى إذا خضخضُنُه","ونسَخن وضعاً للأوامِ",38,"م",1,0],["حتى إذا خار اللجام وعميت","سبل السلام هفا إلى استسلامه",39,"م",2,0],["حتى إذا خَذَلَ الإعصارُ أشرعتي","وفزَّ نزفٌ غفا بالأمس ِ وانقطعا",40,"ع",2,0],["حتى إذا خطرت في الذهن شائبة","دقت تذكرني بالعالم الثاني",41,"ن",2,0]]}