{"poems":[[74,"لو لم تفه برثاء فيك أشعاري","https://www.aldiwan.net/poem18718.html","البسيط"],[53,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[101,"غرناطة","https://www.aldiwan.net/poem6258.html","عموديه"],[51,"رب أمر يسوء ثم يسر","https://www.aldiwan.net/poem62071.html","الخفيف"],[51,"ما أغفل الناس والخطوب بهم","https://www.aldiwan.net/poem62182.html","البسيط"],[51,"الرفق يبلغ ما لا يبلغ الخرق","https://www.aldiwan.net/poem62187.html","الكامل"],[51,"ما أغفل الناس عن بلائي","https://www.aldiwan.net/poem63212.html","مجزوء البسيط"],[82,"نفوسنا بالرجاء ممتسكه","https://www.aldiwan.net/poem31223.html","المنسرح"],[82,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[82,"أيا رشاقة غصن البان ما هصرك","https://www.aldiwan.net/poem31444.html","البسيط"],[48,"لا يحسب الجود من رب النخيل جدا","https://www.aldiwan.net/poem22336.html","البسيط"],[48,"كم آية يؤنسها معشر","https://www.aldiwan.net/poem23548.html","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[102,"يوم العلم","https://www.poetsgate.com/ViewPoem.aspx?id=50183",""],[111,"ماذا تريد من الدنيا تعنيها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66822&r=&rc=1",""],[164,"غبطت جوارحنا عليك الأعينا","https://www.aldiwan.net/poem58876.html","الكامل"],[164,"في لحظ عينيه سكر من رحيق فمه","https://www.aldiwan.net/poem58995.html","البسيط"],[189,"ما أغدر الدنيا وليس لغدرها","https://www.aldiwan.net/poem14102.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[265,"وروضة طاب بها المحل","https://www.aldiwan.net/poem38213.html","الرجز"],[352,"من يحفظ الفيل بعد الشبل والأسد","https://www.aldiwan.net/poem20070.html","البسيط"],[370,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[381,"تبا لمتورط في إثمه ورطا","https://www.aldiwan.net/poem59353.html","البسيط"],[410,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[455,"مر بنا ظبي حريري","https://www.aldiwan.net/poem13971.html","السريع"],[461,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[461,"عاتبت دهري في الجناية لو وعى","https://www.aldiwan.net/poem56132.html","الكامل"],[554,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[554,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[565,"للموت يولد منا كل مولود","https://www.aldiwan.net/poem52755.html","البسيط"],[565,"صدر به سعة وشوق أوسع","https://www.aldiwan.net/poem52989.html","الكامل"],[578,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"]],"verses":[["ما أغفل الناس عن هذا وأذهلهم","عن موردٍ ما له عهدٌ بإصدار",0,"ر",1,0],["ما أغْفَلَ القلمَ الموشَّحَ خصْرُهُ","يُمْنَاكَ عن كَرَمٍ هناكَ توشَّحا",1,"ح",2,0],["ما أغرب التاريخ كيف أعادني","لحفيدة سمراء من أحفادي",2,"د",2,0],["ما أَغَرَّ الدُنيا لِذي الأَمرِ فيها","عَجَباً لِلدُنيا وَكَيفَ تَغُرُّ",3,"ر",1,0],["ما أَغفَلَ الناسَ وَالخُطوبُ بِهِم","في خَبَبٍ مَرَّةً وَفي عَنَقِ",4,"ق",1,1],["ما أَغفَلَ الناسَ عَن يَومِ اِبتِغائِهِمُ","وَيَومِ يُلجِمُهُم في المَوقِفِ العَرَقُ",5,"ق",1,0],["ما أَغفَلَ الناسِ عَن بَلائي","وَعَن عَنائي وَعَن شَقائي",6,"ا",3,1],["ما أغفلَ الفيلسوف عن طُرُقٍ","ليستْ لأهل العقول منسلكه",7,"ك",2,0],["ما أُغْمِدَ العَضْبُ حتّى جُرِّدَ الذكرُ","ولا اختفَى قَمَرٌ حتى بدا قَمَرُ",8,"ر",1,1],["ما أغْفَلَ النائمَ المرموسَ في جدثٍ","عمّا يُلاقي من التَّبريح مَنْ سَهِرك",9,"ك",1,0],["ما أَغدَرَ الإِنسُ كَم خَشفٍ تَرَبَّبَهُم","فَغادَروهُ أَكيلاً بَعدَ تَربيبِ",10,"ب",1,0],["ما أَغدَرَ الدَهرَ وَأَبناءَهُ","لِأَنَّهُم مِن بَحرِهِ يَستَقون",11,"ن",1,0],["ما أَغَرَّ الحَياةَ لِلمَرءِ ما أَب","عَدَ آمالَهُ وَأَدنى شَعوبا",12,"ب",2,0],["ما أغرب الدنيا على أحضانها","عرس يغنّيها ويبكي مأتمُ !",13,"م",1,0],["ما أغفل الناس فيها عن معائبها","وانما راقهم منها ملاهيها",14,"ي",3,0],["ما اغضبتني قطُّ إِلا مرةً","إذ قلت أنا أفديك قالت بل أنا",15,"ن",2,0],["ما أغمد البيض حتى لم يدع عنقا","على اعوجاج ولا انفا على شممه",16,"م",2,0],["ما أَغدرَ الدنيا وليس لغَدْرِها","أَثَرٌ يُقصِّر من لَجاجِة طالبِ",17,"ب",1,1],["ما اِغتراري بمَن تلوّن منهم","وَالأفاعي أشرُّها الرقطاءُ",18,"ا",2,0],["ما اغتال راجيه عنا وغل","يعطي ثقيلا ويخفف الثقل",19,"ل",1,0],["مَا أَغفَلَ النَّاسَ عَن هذا وَكَمْ نَظَرُوا","في وَالدٍ عِبَراً شَتَّى وفي وَلَدِ",20,"د",1,0],["ما أَغرَبَت في صَوابٍ وَهوَ عادَتُها","وَما إِصابَةُ مَرمى سَهمِكَ الغَرَبِ",21,"ب",1,0],["ما أغبطَ التائبَ الراجي بتوبته","قم فاغتبط تائباً قد فاز من غَبَطا",22,"ط",2,0],["ما اِغتابَني حاسِدٌ إِلّا شَرفتُ بِهِ","فَحاسِدي منعم في زيِّ مُنتَقِمِ",23,"م",1,0],["ما أغنج الألحاظ في طَرْفهِ","وخدُّه باللحظِ مجنيُّ",24,"ي",1,0],["ما أغضبَ الناسَ عليّ هل سوى","أني بدنياهم خبير عالمُ",25,"م",1,0],["ما أغمد النعمانُ سيفَ لسانه","حتى ثويتَ فكان يومُكما معا",26,"ع",2,0],["ما أغبَنَ الحبَّ لمنْ","حُمِّلَهُ ما أغبَنَهْ",27,"ن",2,0],["ما أغفلَ العذّالَ عمّا في الحشا","مِن لاذعاتٍ جَمرها يتضرّمُ",28,"م",1,0],["ما أغفَلَ الحيَّ عمَّا ذاقَ ميِّتُهُ","وأغفَلَ المَيْتَ عن نَوْحٍ وتعديدِ",29,"د",1,0],["ما أَغفلَ الإِنسانَ عَن نُصَحائِهِ","وَأَشَدَّ صَبوَتهُ إِلى مَن يَخدَعُ",30,"ع",1,0],["ما اغْتَرَّ قطٌّ بِدُنياه لِفِطْنَتِه","وغَيرُه اغترَّ بالدُّنيا مِن الْغُررِ",31,"ر",1,0]]}