{"poems":[[74,"لو لم تفه برثاء فيك أشعاري","https://www.aldiwan.net/poem18718.html","البسيط"],[53,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[101,"غرناطة","https://www.aldiwan.net/poem6258.html","عموديه"],[51,"رب أمر يسوء ثم يسر","https://www.aldiwan.net/poem62071.html","الخفيف"],[51,"ما أغفل الناس والخطوب بهم","https://www.aldiwan.net/poem62182.html","البسيط"],[51,"الرفق يبلغ ما لا يبلغ الخرق","https://www.aldiwan.net/poem62187.html","الكامل"],[51,"ما أغفل الناس عن بلائي","https://www.aldiwan.net/poem63212.html","مجزوء البسيط"],[82,"نفوسنا بالرجاء ممتسكه","https://www.aldiwan.net/poem31223.html","المنسرح"],[82,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[82,"أيا رشاقة غصن البان ما هصرك","https://www.aldiwan.net/poem31444.html","البسيط"],[48,"لا يحسب الجود من رب النخيل جدا","https://www.aldiwan.net/poem22336.html","البسيط"],[48,"كم آية يؤنسها معشر","https://www.aldiwan.net/poem23548.html","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[102,"يوم العلم","https://www.poetsgate.com/ViewPoem.aspx?id=50183",""],[111,"ماذا تريد من الدنيا تعنيها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66822&r=&rc=1",""],[164,"غبطت جوارحنا عليك الأعينا","https://www.aldiwan.net/poem58876.html","الكامل"],[164,"في لحظ عينيه سكر من رحيق فمه","https://www.aldiwan.net/poem58995.html","البسيط"],[189,"ما أغدر الدنيا وليس لغدرها","https://www.aldiwan.net/poem14102.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[266,"وروضة طاب بها المحل","https://www.aldiwan.net/poem38213.html","الرجز"],[353,"من يحفظ الفيل بعد الشبل والأسد","https://www.aldiwan.net/poem20070.html","البسيط"],[371,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[382,"تبا لمتورط في إثمه ورطا","https://www.aldiwan.net/poem59353.html","البسيط"],[412,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[457,"مر بنا ظبي حريري","https://www.aldiwan.net/poem13971.html","السريع"],[463,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[463,"عاتبت دهري في الجناية لو وعى","https://www.aldiwan.net/poem56132.html","الكامل"],[556,"وزائر ما أجبنه","https://www.aldiwan.net/poem47174.html","مجزوء الرجز"],[556,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[567,"للموت يولد منا كل مولود","https://www.aldiwan.net/poem52755.html","البسيط"],[567,"صدر به سعة وشوق أوسع","https://www.aldiwan.net/poem52989.html","الكامل"],[580,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122694","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122753","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38909","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38070","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38024","البسيط"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101980","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46563","الرجز"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47520","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26448","السريع"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132291","الكامل"],[2995,"","https://poetry.dctabudhabi.ae/diwan/poem/198812","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68020","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68001","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112336","السريع"],[3564,"","https://poetry.dctabudhabi.ae/diwan/poem/127812","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117989","السريع"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35661","الرجز"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36397","الدوبيت"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93257","الكامل"],[4259,"","https://poetry.dctabudhabi.ae/diwan/poem/145349","السريع"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77694","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139644",""],[4755,"قَيِّدْ فَضَائِي.. وهَبْ لِي مِعْطَفًا وعَصَا","https://www.poetsgate.com/ViewPoem.aspx?id=184668",""],[4755,"قَيِّدْ فَضَائِيْ.. وهَبْ لِي مَسلَكًا وعَصَا","https://www.poetsgate.com/ViewPoem.aspx?id=186012",""],[4968,"مرحّل الأوزار","https://www.poetsgate.com/ViewPoem.aspx?id=208096",""],[5026,"بوابة تطل على الأمنيات","https://www.poetsgate.com/ViewPoem.aspx?id=210777",""],[4119,"ما هذه الحدث الفواتن","https://www.poetsgate.com/ViewPoem.aspx?id=16246",""],[5038,"أبحث عن وطن","https://www.poetsgate.com/ViewPoem.aspx?id=189952",""],[5225,"طال الغياب","https://www.poetsgate.com/ViewPoem.aspx?id=36892",""],[5376,"هذي هي الحبُّ والتحنان حواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=189703",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5725,"لنسفعاً بالناصية","https://www.poetsgate.com/ViewPoem.aspx?id=207484",""],[5725,"مقل العيون","https://www.poetsgate.com/ViewPoem.aspx?id=209126",""],[402,"رب البيان وسيدا لقلم","https://www.poetsgate.com/ViewPoem.aspx?id=36326",""],[5956,"عيونٌ تدري مقاصدنا ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182273",""],[5956,"من صفات سيد المرسلين","https://www.poetsgate.com/ViewPoem.aspx?id=192611",""],[6149,"شهدت ليس الشهد غير ريقه","https://www.poetsgate.com/ViewPoem.aspx?id=169627",""],[5051,"قالوا اعتباطا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87706&r=&rc=0",""],[4890,"الشمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72363&r=&rc=53",""]],"verses":[["ما أغفل الناس عن هذا وأذهلهم","عن موردٍ ما له عهدٌ بإصدار",0,"ر",1,0],["ما أغْفَلَ القلمَ الموشَّحَ خصْرُهُ","يُمْنَاكَ عن كَرَمٍ هناكَ توشَّحا",1,"ح",2,0],["ما أغرب التاريخ كيف أعادني","لحفيدة سمراء من أحفادي",2,"د",2,0],["ما أَغَرَّ الدُنيا لِذي الأَمرِ فيها","عَجَباً لِلدُنيا وَكَيفَ تَغُرُّ",3,"ر",1,0],["ما أَغفَلَ الناسَ وَالخُطوبُ بِهِم","في خَبَبٍ مَرَّةً وَفي عَنَقِ",4,"ق",1,1],["ما أَغفَلَ الناسَ عَن يَومِ اِبتِغائِهِمُ","وَيَومِ يُلجِمُهُم في المَوقِفِ العَرَقُ",5,"ق",1,0],["ما أَغفَلَ الناسِ عَن بَلائي","وَعَن عَنائي وَعَن شَقائي",6,"ا",3,1],["ما أغفلَ الفيلسوف عن طُرُقٍ","ليستْ لأهل العقول منسلكه",7,"ك",2,0],["ما أُغْمِدَ العَضْبُ حتّى جُرِّدَ الذكرُ","ولا اختفَى قَمَرٌ حتى بدا قَمَرُ",8,"ر",1,1],["ما أغْفَلَ النائمَ المرموسَ في جدثٍ","عمّا يُلاقي من التَّبريح مَنْ سَهِرك",9,"ك",1,0],["ما أَغدَرَ الإِنسُ كَم خَشفٍ تَرَبَّبَهُم","فَغادَروهُ أَكيلاً بَعدَ تَربيبِ",10,"ب",1,0],["ما أَغدَرَ الدَهرَ وَأَبناءَهُ","لِأَنَّهُم مِن بَحرِهِ يَستَقون",11,"ن",1,0],["ما أَغَرَّ الحَياةَ لِلمَرءِ ما أَب","عَدَ آمالَهُ وَأَدنى شَعوبا",12,"ب",2,0],["ما أغرب الدنيا على أحضانها","عرس يغنّيها ويبكي مأتمُ !",13,"م",1,0],["ما أغفل الناس فيها عن معائبها","وانما راقهم منها ملاهيها",14,"ي",3,0],["ما اغضبتني قطُّ إِلا مرةً","إذ قلت أنا أفديك قالت بل أنا",15,"ن",2,0],["ما أغمد البيض حتى لم يدع عنقا","على اعوجاج ولا انفا على شممه",16,"م",2,0],["ما أَغدرَ الدنيا وليس لغَدْرِها","أَثَرٌ يُقصِّر من لَجاجِة طالبِ",17,"ب",1,1],["ما اِغتراري بمَن تلوّن منهم","وَالأفاعي أشرُّها الرقطاءُ",18,"ا",2,0],["ما اغتال راجيه عنا وغل","يعطي ثقيلا ويخفف الثقل",19,"ل",1,0],["مَا أَغفَلَ النَّاسَ عَن هذا وَكَمْ نَظَرُوا","في وَالدٍ عِبَراً شَتَّى وفي وَلَدِ",20,"د",1,0],["ما أَغرَبَت في صَوابٍ وَهوَ عادَتُها","وَما إِصابَةُ مَرمى سَهمِكَ الغَرَبِ",21,"ب",1,0],["ما أغبطَ التائبَ الراجي بتوبته","قم فاغتبط تائباً قد فاز من غَبَطا",22,"ط",2,0],["ما اِغتابَني حاسِدٌ إِلّا شَرفتُ بِهِ","فَحاسِدي منعم في زيِّ مُنتَقِمِ",23,"م",1,0],["ما أغنج الألحاظ في طَرْفهِ","وخدُّه باللحظِ مجنيُّ",24,"ي",1,0],["ما أغضبَ الناسَ عليّ هل سوى","أني بدنياهم خبير عالمُ",25,"م",1,0],["ما أغمد النعمانُ سيفَ لسانه","حتى ثويتَ فكان يومُكما معا",26,"ع",2,0],["ما أغبَنَ الحبَّ لمنْ","حُمِّلَهُ ما أغبَنَهْ",27,"ن",2,0],["ما أغفلَ العذّالَ عمّا في الحشا","مِن لاذعاتٍ جَمرها يتضرّمُ",28,"م",1,0],["ما أغفَلَ الحيَّ عمَّا ذاقَ ميِّتُهُ","وأغفَلَ المَيْتَ عن نَوْحٍ وتعديدِ",29,"د",1,0],["ما أَغفلَ الإِنسانَ عَن نُصَحائِهِ","وَأَشَدَّ صَبوَتهُ إِلى مَن يَخدَعُ",30,"ع",1,0],["ما اغْتَرَّ قطٌّ بِدُنياه لِفِطْنَتِه","وغَيرُه اغترَّ بالدُّنيا مِن الْغُررِ",31,"ر",1,0],["ما أغفَلَ النّاسَ عَمّا يُحمَدُونَ بِه","دُونَ المَحامِدِ أعواقٌ وأعواقُ",32,"ق",1,0],["ما أغدَرَ الإخوانَ يَضحَكُ حَيُّهُم","عَجَباً وَيَشرَبُ لِلحَياةِ وَيطعَمُ",33,"م",1,0],["ما اِغتِرارُ الوَرى بِدارِ غرورٍ","وَهيَ دارٌ فيها الرّدى وَالبَلاءُ",34,"ا",2,0],["ما أَغرَبَ اليُسْرَ لَدى عُسرَةٍ","خَطَّت بِآذاني حروفَ الطَّرشْ",35,"ش",1,1],["ما أَغربَ الفتكَ مِنهُ وَهوَ نَرجسةٌ","فَهَلْ تَقاوَى عَلى الأرواحِ بِالغنَجِ",36,"ج",1,0],["ما أغلقت في الجدب باب نوالها","حيث المكارم أغلقت أبوابها",37,"ب",3,0],["ما أَغفل الأناما","ما أَنحس الأَياما",38,"م",2,0],["ما أَغرب الأَمانه","ما أَكثر الخِيانه",38,"ه",1,0],["ما أَغْرَبَتْ في زِيِّها","إِلاَّ يَعاقيبُ الْحَجَلْ",39,"ل",1,1],["ما أَغمَضَت عَيني وَلا أَقلَعَت","دَمعَتُها مُذ هُوَ لا يُعتِبُ",40,"ب",1,0],["ما اغفل الرقباء في أيامه","ولكم زها طربا بما أرضان",41,"ن",1,0],["ما أغزر الدمع في كل الجهات وما","أسخي العيون عليه اليوم مذ خبروا",42,"ر",3,0],["ما أغدرَ الدهرَ والإنسانُ يطلبه","لَوْ قيل قِفْ عن هواه قط لَمْ يَقف",43,"ف",1,0],["مَا أُغلِقت طُرق المكارمِ مذ غدا","مفتاحُ مجدهمُ لَهَا مفتاحا",44,"ح",2,0],["ما اغرَورَقت عيني على فائتِ","قد مرّ من عمري مُرورَ الشهاب",45,"ب",1,0],["ما أغفل الناس عن مستقبل الأَجلِ","يجرون مهلاً كما يجري على عجَلِ",46,"ل",1,1],["ما اغتيل إلا ذو غنى إنما","تؤخذ للذبح سمان النعم",47,"م",1,0],["ما أَغفَلَ المَرءَ وَأَلهاهُ","يَعصي وَلا يَذكُرُ مَولاهُ",48,"ا",2,1],["ما أَغبنَني وَقيل لي ذاكَ بِذا","ماذا أُعطيَ الثرى وَماذا أَخَذا",49,"ذ",2,0],["ما أَغمدوا سيفَ ابن ذي يزنٍ به","إِلاّ تقاصر عندها غُمْدانه",50,"ن",2,0],["ما أغتدي إلا ومن عندهم","عارفة عندي بل عارفات",51,"ت",1,0],["ما أَغفل المَرءَ عَمّا قَد أُريد بِهِ","في كُلِّ يَومٍ يُناديه الرَدى اِقتربِ",52,"ب",1,0],["ما اغتدى ضدُّهم بأقصى حضيضِ","ومواليهم بأوج الصعود",53,"د",1,0],["ما أَغزَرَ الشِّعرَ لَولا أنَّ بي وَجَعًا","مِن صَخرَةٍ قَايَضَتْنِي بالدُّمُوعِ حَصَى",54,"ص",2,0],["ما أَغزَرَ الشِّعرَ.. لَولا أَنَّ بي وَجَعًا","مِن غَيمَةٍ كَافَأَتنِي بالدُّمُوعِ حَصَى",55,"ص",2,0],["ماأُغلقتْ فيه المساجد بل أرى","كلّ البيوت الآن وجه المسجد",56,"د",1,0],["ما اغْتال يَعقُوبُ النبيُّ بمَعْزلٍ","ولَدَ الذئاب فَكَيْفَ تَأكُلُ إبْنَهْ",57,"ن",2,0],["ما أغفل الأجسام من","أخذ القلوب بها رهائن",58,"ن",1,0],["ما أَغْرَقَ السُّفُنَ الْجَواريَ بَحْرُنا","قُلْ إِنَّما الْأَجْيالُ مِنْ غَرْقى السَّفَنْ",59,"ن",1,0],["ما اغلى النهار ان الليالي تضدّه","لو كان سرمد ما أظنه بينطاق",60,"ق",1,0],["ما أغمض الوجد عينا في تقلبها","وما أشاحت عن الأشواق غيداءُ",61,"ا",2,0],["ما اغْتَرَّهُ عَرَضٌ عَنْ هَفْوَةٍ طَمَعاً","إِلاَّ تَنَزَّهَ عَنْ مَرْعاهُ وَاحْتَشَما",62,"م",2,0],["ما اغنى عنا جمعنا وجموعنا","هلكت كعاد او ثمود الطاغية",63,"ي",2,0],["ما أغمدت تلك السيوف لغايةٍ","فوق الحواجب كي تزيد حصادا",64,"د",2,0],["ما أغجز اللسن الفصيح لدى عي","الفقيد الخالد البكم",65,"م",1,0],["ما أغدر الدهرَ نهواه على علل","فيه حجابٌ عن الإسعاد يعمينا",66,"ن",2,0],["ما اغترَّ بل ما زاغ يوماً لحظة","وهو التقيُّ الصابر الأوّابُ",67,"ب",1,0],["ما أغلقت مشكلة على الورى","إلا وكان ذهنه فكاكها",68,"ك",3,0],["ما أغْفَلُوا شاعراً مَا أشْبَعُوهُ هِجاً","كأنَّهُمْ رضَعُوا من أمِّهِمْ عَتَبَا",69,"ب",2,0],["ما أغمضتْ عيناي إلا على","حلْمٍ يسيرُ الموتُ في سيرهِ",70,"ه",1,1]]}