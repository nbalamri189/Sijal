{"poems":[[49,"اللوم للعاشقين لوم","https://www.aldiwan.net/poem25159.html","مجزوء البسيط"],[47,"يا أخا الأزد ما حفظت الإخاء","https://www.aldiwan.net/poem10196.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55018","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43833","البسيط"],[228,"أشكو إلى قلبك يا سيدي","https://www.aldiwan.net/poem41616.html","السريع"],[246,"زاحفت أيامي وزاحفنني","https://www.aldiwan.net/poem45756.html","السريع"],[567,"بين ضرب الطلى وطعن الصدور","https://www.aldiwan.net/poem52977.html","الخفيف"],[1448,"","https://poetry.dctabudhabi.ae/diwan/poem/144542","السريع"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33846","الرجز"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121176","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52133","الرمل"],[4791,"صك المحبه","https://www.poetsgate.com/ViewPoem.aspx?id=35901",""],[5183,"الرثاء الباكي","https://www.poetsgate.com/ViewPoem.aspx?id=180250",""],[5198,"بوصلة","https://www.poetsgate.com/ViewPoem.aspx?id=136236",""]],"verses":[["بَينَ ضُلوعي هَوىً مُقيمٌ","لِآلِ وَرقاءَ لايَريمُ",0,"م",1,0],["بَينَ ضَربٍ يُفلِّقُ الهامَ أَنصا","فاً وَطَعنٍ يُفَرِّجُ الغَمّاءَ",1,"ا",2,0],["بَيْنَ ضُلُوعِي نعْشُ حَبِيبٍ","أَذْكَى الأَسى حوْلَهُ الضُّلُوعَا",2,"ع",2,0],["بَينَ ضُلوعي عَلَيكَ نارٌ","يَكادُ مِنها الصَفا يَذوبُ",3,"ب",1,0],["بَينَ ضُلوعي حجرٌ بارِدٌ","رَميتُه في ظُلمَةٍ أَبرَدِ",4,"د",1,0],["بين ضعيفِ الخطوِ لم يَعتَمد","وشاخص في المهد لم يحول",5,"ل",1,0],["بين ضربِ الطُلَى وطعنِ الصدورِ","تَنزِلُ المَكرُماتُ حولَ غديرِ",6,"ر",1,1],["بينَ ضلوعي زَفرةٌ كلَّما","أخفيتُها نَمَّ عليَّ الشَّهيقْ",7,"ق",1,0],["بَينَ ضُلوعي كَبِدٌ","حَرّى وَقَلبٌ يَجِفُ",8,"ف",1,0],["بين ضم الحسين وهو قتيل","واعتناق الوداع أي اعتناق",9,"ق",1,0],["بَينَ ضالِهِ","راحَ وَالسَلم",10,"م",1,0],["بين ضوء الصباح والفرق فرق","اذ به للأنام كل هداء",11,"ا",2,0],["بين ضَمّ مستمّرٍ والقُبَلْ","رُسمت في وجنةٍ أو فوق جيدْ",12,"د",1,0],["بين ضوح السراب وبين نقع الغدير","آتهجا من الذكرى كلامٍ مفيد",13,"د",1,0],["بين ضعف وفاقة ومشيب","قوة لا ينالها الإعياء",14,"ا",2,0],["بين ضفّة وضفّة بالوصال اعبره","والاماني رياح وبوصلة واتجاه",15,"ا",2,0]]}