{"poems":[[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[53,"جزاء أمير المؤمنين ثنائي","https://www.aldiwan.net/poem30783.html","الطويل"],[63,"ألا ليت شعري هل تخب مطيتي","https://www.aldiwan.net/poem45820.html","الطويل"],[3,"برد نسيم الحجاز في السحر","https://www.aldiwan.net/poem166.html",""],[77,"ألما على شط الفرات المقدس","https://www.aldiwan.net/poem35873.html","الطويل"],[35,"خير إخوانك المشارك في الأم","https://www.aldiwan.net/poem38823.html","الخفيف"],[93,"زارني صبحاً وحيى","https://www.aldiwan.net/poem11100.html","مجزوء الرمل"],[93,"إن يقض اسماعيل عاصم","https://www.aldiwan.net/poem11404.html","مجزوء الكامل"],[83,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[27,"عوجي علينا واربعي ربة البغل","https://www.aldiwan.net/poem5972.html","الطويل"],[27,"لمن الديار رسومهن خوالي","https://www.aldiwan.net/poem5974.html","الكامل"],[47,"وكنى الرسول عن الجواب تظرفا","https://www.aldiwan.net/poem25119.html","الكامل"],[72,"قوامك تحت شعرك يا أمامه","https://www.aldiwan.net/poem19681.html","الوافر"],[64,"أنت الموله لي لا الذكر ولهني","https://www.aldiwan.net/poem67647.html","البسيط"],[51,"بعثت ببرني جني كأنه","https://www.aldiwan.net/poem61977.html","الطويل"],[51,"ألذ من فائقة الإبهط","https://www.aldiwan.net/poem65027.html","الرجز"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[91,"ياليتما رجع الزمان الأول","https://www.aldiwan.net/poem9058.html","عموديه"],[91,"سكت خوفا وقلت الصفح من خلقي","https://www.aldiwan.net/poem62725.html","عموديه"],[89,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[89,"تعلموا تعلموا","https://www.aldiwan.net/poem44642.html","مجزوء الرجز"],[89,"أيتها النفس اقترب","https://www.aldiwan.net/poem44672.html","مجزوء الرجز"],[89,"أحس لو ينفعني حسي","https://www.aldiwan.net/poem44856.html","السريع"],[85,"أنت الكبير على المدى","https://www.aldiwan.net/poem7272.html","مجزوء الكامل"],[85,"لم يمت من له أثر","https://www.aldiwan.net/poem62861.html","مجزوء الخفيف"],[85,"الضلوع تتقد","https://www.aldiwan.net/poem62893.html","المقتضب"],[85,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[43,"ألذ من المدام الخندريس","https://www.aldiwan.net/poem9612.html","الوافر"],[43,"مالنا كلنا جو يا رسول","https://www.aldiwan.net/poem9980.html","الخفيف"],[43,"قد سمعنا ما قلت في الأحلام","https://www.aldiwan.net/poem10523.html","الخفيف"],[43,"نرى عظما بالبين والصد أعظم","https://www.aldiwan.net/poem10539.html","الطويل"],[61,"ألذ العيش إتيان الصبيح","https://www.aldiwan.net/poem51310.html","الوافر"],[66,"يا علما لاح لخفض العدى","https://www.aldiwan.net/poem38690.html","السريع"],[66,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[44,"أبا القاسم اسلم في وفود من القسم","https://www.aldiwan.net/poem29704.html","الطويل"],[44,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[69,"الذهبي","https://www.aldiwan.net/poem28293.html","السريع"],[90,"‏كل ما في الكون حب وجمال","https://www.aldiwan.net/poem26553.html","الرمل"],[33,"يا رب إنك ذو من ومغفرة","https://www.aldiwan.net/poem25764.html","البسيط"],[105,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[105,"يا أيها الشعب الذلول أما كفى","https://www.aldiwan.net/poem43103.html","الكامل"],[102,"أرأيت مملكة الربي","https://www.aldiwan.net/poem32947.html","مجزوء الكامل"],[102,"خطر المسا بوشاحه المتلون","https://www.aldiwan.net/poem33130.html","الكامل"],[75,"أمنك اجتياز البرق يلتاح في الدجى","https://www.aldiwan.net/poem69096.html","الطويل"],[48,"أما ونجيبة يهوي","https://www.aldiwan.net/poem62585.html","مجزوء الوافر"],[48,"أحسن من منزل بذي قار","https://www.aldiwan.net/poem63287.html","البسيط"],[48,"لعمري ما تهيج الكأس شوقي","https://www.aldiwan.net/poem65296.html","الوافر"],[48,"أشتهي الساقيين لكن قلبي","https://www.aldiwan.net/poem65300.html","الخفيف"],[48,"ألا حي المنازل بالعقيق","https://www.aldiwan.net/poem66579.html","الوافر"],[48,"خذ العيش الهني من المجوس","https://www.aldiwan.net/poem66598.html","الوافر"],[50,"خير إخوانك المشارك في المرر","https://www.aldiwan.net/poem24514.html","الخفيف"],[50,"أنى شبابك قد مضى محمودا","https://www.aldiwan.net/poem63930.html","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140833",""],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140990",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54573","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142008","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[106,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[106,"جنازة السلام !","https://www.poetsgate.com/ViewPoem.aspx?id=179424",""],[106,"مداعبة صديق","https://www.poetsgate.com/ViewPoem.aspx?id=179527",""],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[106,"تحية الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=179305",""],[50,"خيرُ إخوانكَ المشاركُ في المرِّ","https://www.poetsgate.com/ViewPoem.aspx?id=31053",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[91,"عصر الشبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=53194",""],[51,"ألذُّ من مُعَتَّقِ الرساطونِ","https://www.poetsgate.com/ViewPoem.aspx?id=30601",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""],[33,"يا رب إنك ذو من ومغفرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14163&r=&rc=97",""]],"verses":[["الذَميلَ الذَميلَ يا رَكبُ إِنّي","لَضَمينٌ أَن لا يَخيبَ سُراكا",0,"ك",2,0],["الذَنبُ لي أَنّي جَزِعتُ وَعَنوَنَت","عَنّي دُموعُ العَينِ وَهيَ سَواكِبُ",1,"ب",1,0],["أَلَذُّ بِقَلبي مِن مُنايَ تَقَنُّعي","وَأَحسَنُ عِندي مِن غِنايَ غَنائِيَ",2,"ا",2,0],["أَلَذّ بِهِ مَسَّ الثَّرى وَيروقُني","حواشي رُباً يَغذو أَزاهيرَها الوَبلُ",3,"ل",1,0],["أَلَذُّ عِندي مِمّا حَوَتهُ يَدي","مِنَ اللَآلي وَالمالِ وَالبِدَرِ",4,"ر",1,0],["ألَذّ على الأسْماعِ منْ صوْتِ مِزْهَرٍ","وأعْذَبُ في الأفواهِ من ريقِ ألْعَسِ",5,"س",1,0],["الَّذي إِن حَضَرتَ سَرَّكَ في الحَيْ","يِ وَإِن غِبتَ كانَ أُذناً وَعَينا",6,"ن",2,0],["الَّذِي يَبتَكِرُ الفَخْرَ","ابْتِكَاراً عَبْقَرِيَّا",7,"ي",2,0],["الذِّكْرُ أَبْقَى مَا بِهِ","بَعْدَ الرَّدَى يُجْنِي الأَعَاظِمْ",8,"م",1,0],["ألذْ من النُّعمى على حال فاقةٍ","وأشهى من الوصل الهَنيِّ على صدِّ",9,"د",1,0],["الذائِدونَ فَلا يُهَدَّمُ حَوضُهُم","وَالوارِدونَ فَوِردُهُم لا يُقدَعُ",10,"ع",1,0],["أَلَذَّ وَأَشفى لِلفُؤادِ مِنَ الجَوى","وَأَغيَظَ لِلواشينَ مِنهُ ذَوي المَحلِ",11,"ل",1,0],["الذائِدونَ إِذا النِساءُ تُبُذِّلَت","شَهباءَ ذاتَ قَوانِسٍ وَرِعالِ",12,"ل",1,0],["الذَنبُ لي فيما جَناهُ لِأَنَّني","مَكَّنتُهُ مِن مُهجَتي فَتَمَكَّنا",13,"ن",2,0],["ألذّ بظلمها لي حيث لذّت","به فأفرّ من كشف الظلامهْ",14,"م",2,0],["الذِكرُ واسِطَةٌ تُخفيكَ عَن نَظَري","إِذا تَوَشَّحَهُ مِن خاطِري فِكري",15,"ي",1,0],["ألذَّ من الشكوى وأحلى من المنى","وأعذب من وصل الحبيب على الصدَِ",16,"د",1,0],["ألذُّ من فائقةِ الإبهَطِّ","ومن شِوا سَمْطٍ نظيف السَّمط",17,"ط",1,1],["الذاهِباتُ مَعَ النُهو","دِ الذاهِباتُ مَعَ الصُدورِ",18,"ر",1,0],["الذِكرُ أَثمَنُ ما اِقتَنَيتَ وَتَقتَني","وَالحُبُّ أَنفَسُ ما بَذَلتَ وَتَبذُلُ",19,"ل",1,0],["الذَمُّ عارٌ وَلَكِن ذَمُّ ذي كَرَمٍ","وَالحَمدُ لِلَّهِ لَم نَذمَم أَخا كَرَمِ",20,"م",1,0],["الذي لميقم به الغرنوي","قام مستوفيا به البهلوي",21,"ي",1,0],["الذئب لا يروى غليل","جوفه الا الدم",22,"م",1,0],["الذائدين باليرا","ع عن كرامة العرب",23,"ب",1,0],["الذنب ذنبي انني اخترت من","نفسي رهبانية القس",24,"س",1,0],["الذل عشش في الوزا","رة بعد دولتكم وباض",25,"ض",1,0],["الَّذي يُنفِذُ المُدى","وَالَّذي يَركَبُ الخَطَر",26,"ر",1,0],["الَّذينَ ميلَ بِهِم","في سِفارِهِم بَعُدوا",27,"د",3,0],["الذاهِلاتُ عَنِ الزَما","نِ بِنَشوَةِ العَيشِ النَضير",28,"ر",1,0],["أَلَذُّ مِنَ المُدامِ الخَندَريسِ","وَأَحلى مِن مُعاطاةِ الكُؤوسِ",29,"س",1,1],["الَّذي زُلتَ عَنهُ شَرقاً وَغَرباً","وَنَداهُ مُقابِلي ما يَزولُ",30,"ل",1,0],["الَّذي لَيسَ عَنهُ مُغنٍ وَلا مِن","هُ بَديلٌ وَلا لَما رامَ حامي",31,"م",2,0],["أَلَذُّ مِنَ الصَهباءِ بِالماءِ ذِكرُهُ","وَأَحسَنُ مِن يُسرٍ تَلَقّاهُ مُعدِمُ",32,"م",1,0],["ألذ العيش إتيان الصبيح","وعصيان النصيحة والنصيح",33,"ح",1,1],["الذِئبُ لا يُؤمِنُ لَكِنَّهُ","عَليهِ في يوسُفَ مَكذوبُ",34,"ب",1,0],["أَلَذُّ مِنَ الأَنغامِ رَجعُ بَغامِها","وَأَطيَبُ مِن سَجعِ الهَديلِ هَديرُها",35,"ر",3,0],["أَلَذُّ مُصافاةً مِنَ الظِلِّ وَالضُحى","وَأَكرَمُ في اللَأواءِ عوداً مِنَ الكَرمِ",36,"م",1,0],["أَلَذَّ مِنَ السَلوى وَأَطيَبَ نَفحَةً","مِنَ المِسكِ مَفتوقاً وَأَيسَرَ مَحمَلا",37,"ل",2,0],["الذهبيُّ","وقيمةُ الفضَّةِ دونَ الذهبْ",38,"ب",1,1],["ألذنبٍ تصطلي حَرَّ الجْوى","مهجٌ كانت لها فيكم ظِلال",39,"ل",1,0],["الذاكِرينَ الهَوى مِن بَعدِما رَقَدوا","الساقِطينَ عَلى الأَيدي المُكِبّينا",40,"ن",2,0],["الذِّكرُ محفوظٌ بصالحِ سَعْيِكُمْ","باقٍ على الدُّنيا يُذاعُ ويُنْشَرُ",41,"ر",1,0],["الذِئبُ أَصدَقُ مِن أولَئِكَ مَوثِقاً","وَأَبَرُّ مِنهُم ذِمَّةً وَيَمينا",42,"ن",2,0],["الذئبُ يَرْهبُه ويل","ثُم كفَّه الحمَلُ الوديع",43,"ع",1,0],["الذَنب ذَنبي يَومَ همت بِحبهم","يا مَوطِني هَذا فُؤادي فَاطعَن",44,"ن",1,0],["ألَذُّ بما تَطْويه فيكِ جَوانحي","وأشجى تَباريحاً وأسْتعْذِب الشَّجا",45,"ج",2,0],["أَلَذُّ لِعَينِ مُكتَهِلٍ","أَطافَ بِعَينِهِ رَمَدُ",46,"د",1,0],["أَلَذُّ مِن مَهمَهٍ أَكِدُّ بِهِ","وَمِن سَرابٍ أَجوبُ غَرّارِ",47,"ر",1,0],["أَلَذُّ إِلَيَّ مِن عَيشٍ بِوادٍ","مَعَ الأَعرابِ مَجدوبِ المَكانِ",48,"ن",1,0],["الَّذي بِالجَمالِ زَيَّنَهُ اللَ","هُ وَحُسنِ الجَبينِ وَالحاجِبَينِ",49,"ن",1,0],["ألذُّ من التجالدِ بالعوالي","ومن مشي الفريق إلى الفريق",50,"ق",1,0],["ألذُّ على فم الأحرارِ ذوقاً","وأغلبُ للسعود على النحوس",51,"س",1,0],["الَّذي إِن شَهِدتَ سَرَّكَ في الحَي","يِ وَإِن غِبتَ كانَ أُذناً وَعَينا",52,"ن",2,0],["الذائِدينَ عَنِ الحَريمِ بِجَدِّهِم","وَالمُنعِمينَ أُبُوَّةً وَجُدودا",53,"د",2,0],["ألذ من المدام الخندريس","وأحلى من معاطاة الكئوس",54,"س",1,1],["\"الّذي ليس عنه مغنٍ ولا من","ه بديلٌ، ولا لما رام حام\"",55,"م",1,0],["الذِكرُ آيَةُ رَبِّكَ الكُبرى الَّتي","فيها لِباغي المُعجِزاتِ غَناءُ",56,"ا",2,0],["أَلذِّكرُ يَنْفَعُنَا غَدَاةَ نَشَاطِنَا","لِنُدِيلَ إِصْلاَحاً مِنَ الإِفْسَادِ",57,"د",1,0],["أَلذَّاهِبَاتُ إلى الكِفَا","حِ وَلاَ تَرَدُّدَ في الذَهَابِ",58,"ب",1,0],["الذكريات على مقادسها","الأم والأخوات والسكن",59,"ن",1,0],["الذراعُ الأزَلُّ والساعدُ المفْ","تُولُ ذُخْرُ الشبابِ في أَزماتهْ",60,"ت",2,0],["الذئب ليس على القطيع بحارسٍ","والفأرُ ليس على القِرَى بمُحكَّم",61,"م",1,0],["الذئبُ كالإنسان لو","يتعلم الذئبُ النظام",62,"م",1,0],["الذئبُ لا يشتهي لحم ابنِ جلدتِه","فكيف أوقعَ نشَّالٌ بنشَّال؟",63,"ل",1,0],["الذنبُ ذنبكُمُو، والكلبُ كَلْبُكُمو","مازال يَسْمَن حتى بات مَسْعُورا",64,"ر",2,0],["الذائدين عن الذما","رِ، الصَّادِقين لدى النضال",65,"ل",1,0],["الذي إن شهدت سرَّك في الح","يّ وإِنْ غبْتَ كانَ أذْناً وعيْنَا",66,"ن",2,0],["الذي نال حُظوةً حُرِم الانسانُ","منها خُصَّت الإنسانه",67,"ن",2,0],["ألذكر أثمن ما اقتنيت وتقتني","ولحبّ أنفس ما بذلت وتبذل",68,"ل",1,0],["ألذُّ من مُعَتَّقِ الرساطونِ","وَقَهْوَتِيْ قُطْرُبُّلٍ وكِرْكين",69,"ن",1,1],["ألذُّ من الماءِ الزلالِ مواقعاً","عَلَى كَبِدِ الظَّمْآنِ وَالماءُ باردُ",70,"د",1,0],["الذاكرينَ الهَوَى مِنْ بَعدِها رقدُوا","الساقطين على الأيدي المكبينا",71,"ن",2,0]]}