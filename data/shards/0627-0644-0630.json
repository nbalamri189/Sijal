465,"وأحور في عينيه هاروت بابل","https://www.aldiwan.net/poem3344.html","عموديه"],[465,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[466,"في رحاب النجف الأشرف","https://www.aldiwan.net/poem61432.html","عموديه"],[467,"كأن مدامة من خمر دن","https://www.aldiwan.net/poem50393.html","الوافر"],[469,"ألذ مودات الرجال مذاقة","https://www.aldiwan.net/poem59901.html","الطويل"],[469,"جمالي وزيني إذا ما حضر","https://www.aldiwan.net/poem59983.html","المتقارب"],[480,"الذكر أبقى لكم والمال عارية","https://www.aldiwan.net/poem37207.html","البسيط"],[496,"إن لم يكن هذا الصدود فصالا","https://www.aldiwan.net/poem10260.html","الكامل"],[505,"أباهي بوجد قد تمكن في الحشا","https://www.aldiwan.net/poem38408.html","الطويل"],[505,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[530,"هل إلى وصل من هويت سبيل","https://www.aldiwan.net/poem37274.html","الخفيف"],[530,"يا ناقدا لكلام ليس يفهه","https://www.aldiwan.net/poem37468.html","البسيط"],[530,"الذي لاح وهو فصل الخطاب","https://www.aldiwan.net/poem37532.html","الخفيف"],[552,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[563,"أجارتنا هل للنسيم وصول","https://www.aldiwan.net/poem52906.html","الطويل"],[563,"فدى الجلابيب والأطمار من وبر","https://www.aldiwan.net/poem52941.html","البسيط"],[563,"بين رئم الحمى وآرام رامه","https://www.aldiwan.net/poem52971.html","الخفيف"],[568,"شمس الضحى في الغمام مستتره","https://www.aldiwan.net/poem69650.html","الطويل"],[576,"فرطت فيك فلوعتي لا تنقضي","https://www.aldiwan.net/poem2921.html","الكامل"]],"verses":[["الذَميلَ الذَميلَ يا رَكبُ إِنّي","لَضَمينٌ أَن لا يَخيبَ سُراكا",0,"ك",2,0],["الذَنبُ لي أَنّي جَزِعتُ وَعَنوَنَت","عَنّي دُموعُ العَينِ وَهيَ سَواكِبُ",1,"ب",1,0],["أَلَذُّ بِقَلبي مِن مُنايَ تَقَنُّعي","وَأَحسَنُ عِندي مِن غِنايَ غَنائِيَ",2,"ا",2,0],["أَلَذّ بِهِ مَسَّ الثَّرى وَيروقُني","حواشي رُباً يَغذو أَزاهيرَها الوَبلُ",3,"ل",1,0],["أَلَذُّ عِندي مِمّا حَوَتهُ يَدي","مِنَ اللَآلي وَالمالِ وَالبِدَرِ",4,"ر",1,0],["ألَذّ على الأسْماعِ منْ صوْتِ مِزْهَرٍ","وأعْذَبُ في الأفواهِ من ريقِ ألْعَسِ",5,"س",1,0],["الَّذي إِن حَضَرتَ سَرَّكَ في الحَيْ","يِ وَإِن غِبتَ كانَ أُذناً وَعَينا",6,"ن",2,0],["الَّذِي يَبتَكِرُ الفَخْرَ","ابْتِكَاراً عَبْقَرِيَّا",7,"ي",2,0],["الذِّكْرُ أَبْقَى مَا بِهِ","بَعْدَ الرَّدَى يُجْنِي الأَعَاظِمْ",8,"م",1,0],["ألذْ من النُّعمى على حال فاقةٍ","وأشهى من الوصل الهَنيِّ على صدِّ",9,"د",1,0],["الذائِدونَ فَلا يُهَدَّمُ حَوضُهُم","وَالوارِدونَ فَوِردُهُم لا يُقدَعُ",10,"ع",1,0],["أَلَذَّ وَأَشفى لِلفُؤادِ مِنَ الجَوى","وَأَغيَظَ لِلواشينَ مِنهُ ذَوي المَحلِ",11,"ل",1,0],["الذائِدونَ إِذا النِساءُ تُبُذِّلَت","شَهباءَ ذاتَ قَوانِسٍ وَرِعالِ",12,"ل",1,0],["الذَنبُ لي فيما جَناهُ لِأَنَّني","مَكَّنتُهُ مِن مُهجَتي فَتَمَكَّنا",13,"ن",2,0],["ألذّ بظلمها لي حيث لذّت","به فأفرّ من كشف الظلامهْ",14,"م",2,0],["الذِكرُ واسِطَةٌ تُخفيكَ عَن نَظَري","إِذا تَوَشَّحَهُ مِن خاطِري فِكري",15,"ي",1,0],["ألذَّ من الشكوى وأحلى من المنى","وأعذب من وصل الحبيب على الصدَِ",16,"د",1,0],["ألذُّ من فائقةِ الإبهَطِّ","ومن شِوا سَمْطٍ نظيف السَّمط",17,"ط",1,1],["الذاهِباتُ مَعَ النُهو","دِ الذاهِباتُ مَعَ الصُدورِ",18,"ر",1,0],["الذِكرُ أَثمَنُ ما اِقتَنَيتَ وَتَقتَني","وَالحُبُّ أَنفَسُ ما بَذَلتَ وَتَبذُلُ",19,"ل",1,0],["الذَمُّ عارٌ وَلَكِن ذَمُّ ذي كَرَمٍ","وَالحَمدُ لِلَّهِ لَم نَذمَم أَخا كَرَمِ",20,"م",1,0],["الذي لميقم به الغرنوي","قام مستوفيا به البهلوي",21,"ي",1,0],["الذئب لا يروى غليل","جوفه الا الدم",22,"م",1,0],["الذائدين باليرا","ع عن كرامة العرب",23,"ب",1,0],["الذنب ذنبي انني اخترت من","نفسي رهبانية القس",24,"س",1,0],["الذل عشش في الوزا","رة بعد دولتكم وباض",25,"ض",1,0],["الَّذي يُنفِذُ المُدى","وَالَّذي يَركَبُ الخَطَر",26,"ر",1,0],["الَّذينَ ميلَ بِهِم","في سِفارِهِم بَعُدوا",27,"د",3,0],["الذاهِلاتُ عَنِ الزَما","نِ بِنَشوَةِ العَيشِ النَضير",28,"ر",1,0],["أَلَذُّ مِنَ المُدامِ الخَندَريسِ","وَأَحلى مِن مُعاطاةِ الكُؤوسِ",29,"س",1,1],["الَّذي زُلتَ عَنهُ شَرقاً وَغَرباً","وَنَداهُ مُقابِلي ما يَزولُ",30,"ل",1,0],["الَّذي لَيسَ عَنهُ مُغنٍ وَلا مِن","هُ بَديلٌ وَلا لَما رامَ حامي",31,"م",2,0],["أَلَذُّ مِنَ الصَهباءِ بِالماءِ ذِكرُهُ","وَأَحسَنُ مِن يُسرٍ تَلَقّاهُ مُعدِمُ",32,"م",1,0],["ألذ العيش إتيان الصبيح","وعصيان النصيحة والنصيح",33,"ح",1,1],["الذِئبُ لا يُؤمِنُ لَكِنَّهُ","عَليهِ في يوسُفَ مَكذوبُ",34,"ب",1,0],["أَلَذُّ مِنَ الأَنغامِ رَجعُ بَغامِها","وَأَطيَبُ مِن سَجعِ الهَديلِ هَديرُها",35,"ر",3,0],["أَلَذُّ مُصافاةً مِنَ الظِلِّ وَالضُحى","وَأَكرَمُ في اللَأواءِ عوداً مِنَ الكَرمِ",36,"م",1,0],["أَلَذَّ مِنَ السَلوى وَأَطيَبَ نَفحَةً","مِنَ المِسكِ مَفتوقاً وَأَيسَرَ مَحمَلا",37,"ل",2,0],["الذهبيُّ","وقيمةُ الفضَّةِ دونَ الذهبْ",38,"ب",1,1],["ألذنبٍ تصطلي حَرَّ الجْوى","مهجٌ كانت لها فيكم ظِلال",39,"ل",1,0],["الذاكِرينَ الهَوى مِن بَعدِما رَقَدوا","الساقِطينَ عَلى الأَيدي المُكِبّينا",40,"ن",2,0],["الذِّكرُ محفوظٌ بصالحِ سَعْيِكُمْ","باقٍ على الدُّنيا يُذاعُ ويُنْشَرُ",41,"ر",1,0],["الذِئبُ أَصدَقُ مِن أولَئِكَ مَوثِقاً","وَأَبَرُّ مِنهُم ذِمَّةً وَيَمينا",42,"ن",2,0],["الذئبُ يَرْهبُه ويل","ثُم كفَّه الحمَلُ الوديع",43,"ع",1,0],["الذَنب ذَنبي يَومَ همت بِحبهم","يا مَوطِني هَذا فُؤادي فَاطعَن",44,"ن",1,0],["ألَذُّ بما تَطْويه فيكِ جَوانحي","وأشجى تَباريحاً وأسْتعْذِب الشَّجا",45,"ج",2,0],["أَلَذُّ لِعَينِ مُكتَهِلٍ","أَطافَ بِعَينِهِ رَمَدُ",46,"د",1,0],["أَلَذُّ مِن مَهمَهٍ أَكِدُّ بِهِ","وَمِن سَرابٍ أَجوبُ غَرّارِ",47,"ر",1,0],["أَلَذُّ إِلَيَّ مِن عَيشٍ بِوادٍ","مَعَ الأَعرابِ مَجدوبِ المَكانِ",48,"ن",1,0],["الَّذي بِالجَمالِ زَيَّنَهُ اللَ","هُ وَحُسنِ الجَبينِ وَالحاجِبَينِ",49,"ن",1,0],["ألذُّ من التجالدِ بالعوالي","ومن مشي الفريق إلى الفريق",50,"ق",1,0],["ألذُّ على فم الأحرارِ ذوقاً","وأغلبُ للسعود على النحوس",51,"س",1,0],["الَّذي إِن شَهِدتَ سَرَّكَ في الحَي","يِ وَإِن غِبتَ كانَ أُذناً وَعَينا",52,"ن",2,0],["الذائِدينَ عَنِ الحَريمِ بِجَدِّهِم","وَالمُنعِمينَ أُبُوَّةً وَجُدودا",53,"د",2,0],["ألذ من المدام الخندريس","وأحلى من معاطاة الكئوس",54,"س",1,1],["\"الّذي ليس عنه مغنٍ ولا من","ه بديلٌ، ولا لما رام حام\"",55,"م",1,0],["الذِكرُ آيَةُ رَبِّكَ الكُبرى الَّتي","فيها لِباغي المُعجِزاتِ غَناءُ",56,"ا",2,0],["أَلذِّكرُ يَنْفَعُنَا غَدَاةَ نَشَاطِنَا","لِنُدِيلَ إِصْلاَحاً مِنَ الإِفْسَادِ",57,"د",1,0],["أَلذَّاهِبَاتُ إلى الكِفَا","حِ وَلاَ تَرَدُّدَ في الذَهَابِ",58,"ب",1,0],["الذكريات على مقادسها","الأم والأخوات والسكن",59,"ن",1,0],["الذراعُ الأزَلُّ والساعدُ المفْ","تُولُ ذُخْرُ الشبابِ في أَزماتهْ",60,"ت",2,0],["الذئب ليس على القطيع بحارسٍ","والفأرُ ليس على القِرَى بمُحكَّم",61,"م",1,0],["الذئبُ كالإنسان لو","يتعلم الذئبُ النظام",62,"م",1,0],["الذئبُ لا يشتهي لحم ابنِ جلدتِه","فكيف أوقعَ نشَّالٌ بنشَّال؟",63,"ل",1,0],["الذنبُ ذنبكُمُو، والكلبُ كَلْبُكُمو","مازال يَسْمَن حتى بات مَسْعُورا",64,"ر",2,0],["الذائدين عن الذما","رِ، الصَّادِقين لدى النضال",65,"ل",1,0],["الذي إن شهدت سرَّك في الح","يّ وإِنْ غبْتَ كانَ أذْناً وعيْنَا",66,"ن",2,0],["الذي نال حُظوةً حُرِم الانسانُ","منها خُصَّت الإنسانه",67,"ن",2,0],["ألذكر أثمن ما اقتنيت وتقتني","ولحبّ أنفس ما بذلت وتبذل",68,"ل",1,0],["الذائد الحامي كأنّ بيانه","أي السماء تنزّلت ألواحا",69,"ح",2,0],["ألذي شرّدته عنك المعالي","آب وهو المكفّن المحمول",70,"ل",1,0],["ألذُّ من مُعَتَّقِ الرساطونِ","وَقَهْوَتِيْ قُطْرُبُّلٍ وكِرْكين",71,"ن",1,1],["ألذُّ من الماءِ الزلالِ مواقعاً","عَلَى كَبِدِ الظَّمْآنِ وَالماءُ باردُ",72,"د",1,0],["الذاكرينَ الهَوَى مِنْ بَعدِها رقدُوا","الساقطين على الأيدي المكبينا",73,"ن",2,0],["أَلَذ مِن الماء القِراح عَلى الصَدا","وَأَعذَب مِن عَتب الحَبيب لَدى اللُقيا",74,"ي",2,0],["الذئب لي أني وثقت وأنني","أصفى الوداد وأتب ع الفلواء",75,"ا",2,0],["الذبابة مش نجسة لكنها بتلعي النفس","طول عمرك يا زبيبه بعقبك هالعود",76,"د",1,0],["الذكرَياتُ وقد بَرَزنَ عَلانِية","نادَينَ عنكَ بحَسرةِ المَطرودِ",77,"د",1,0],["أَلذُّ من الورد الجنىّ عَرارُها","وأحلىَ من الشهدِ المصفَّى بَريرُها",78,"ر",3,0],["أَلَذُّ مِنَ الغِناءِ لِسامِعيهِ","وَمِمّا في بُطونِ النَحلِ أَحلا",79,"ل",2,0],["الَّذي لا تَراهُ مُذْ كَان إِلاَّ","وَاقِفاً بَيْنَ نَائلٍ وَعِقابِ",80,"ب",1,0],["أَلَذُّ وَأَشْفَى لَنَا مِنْ طَرَبْ","وَأَطْيَبُ مِنْ رَشْفِ ماءِ العِنَبْ",81,"ب",1,1],["ألذّ وأشهى للفتى من مسيره","إلى أرض قبراثا على فرسٍ يسري",8