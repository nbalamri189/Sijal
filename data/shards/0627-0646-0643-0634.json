{"poems":[[4,"ربيع لا يسقك نحوي سائق","https://www.aldiwan.net/poem21180.html","الرجز"],[53,"إن وهب بن سليما","https://www.aldiwan.net/poem61889.html","مجزوء الرمل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93110","الخفيف"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104279","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133250","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66155","الرجز"],[5829,"ضربة استباقية","https://www.poetsgate.com/ViewPoem.aspx?id=204666",""],[6056,"القناااع","https://www.poetsgate.com/ViewPoem.aspx?id=156703",""]],"verses":[["إِنَّكَ شَيخٌ خائِنٌ مُنافِقُ","بِالمُخزِياتِ ظاهِرٌ مُطابِقُ",0,"ق",1,0],["إنَّ كَشْفَ الخَبَرِ المس","تورِ من شأن البريدِ",1,"د",1,0],["إن كشف الغطا وهتك الستور","قد أذاعا سري الذي في ضميري",2,"ي",1,1],["إن كشف الغطا وهتك الستور","قد أذاع السر المصون ضميري",3,"ي",1,1],["إن كشر الدهر يوما عن نواخذه","فلست أرجو سواهم عند إقتارى",4,"ر",2,0],["إِنْ كَشَّرَ الدَّهْرُ لَهُ عَنْ نابِهِ","أَرْجَعَهُ الجهلُ كما كانَ سُدَى",5,"ا",1,0],["إن كشر الضرغام عن انيابه","تجد الضباع تنافرت تتجنّدل",6,"ل",1,1],["إنكشف عنك القناع وبيّن الوجه الصحيح","وصارعلمك في الحقيقة مايجي له وزن ذر",7,"ر",1,1]]}