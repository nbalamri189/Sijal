لعِلَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=183695",""],[4578,"زفافٌ لبدر العز بالسعد أشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=49491",""],[4578,"تجلَّت فيها شمس النهار على رُمحٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49377",""],[4578,"فؤادي بإيجاب الوصال وسلبه","https://www.poetsgate.com/ViewPoem.aspx?id=49353",""],[4927,"معلقة أمير الشهداء المعاصرين صَدّام يرحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=36731",""],[4929,"مَيَلانُ الموازين. (من بحر المنسرح)","https://www.poetsgate.com/ViewPoem.aspx?id=207997",""],[5009,"يا أمتي وجب الكفاح","https://www.poetsgate.com/ViewPoem.aspx?id=24367",""],[4119,"وفت لك الدنيا بميعادها","https://www.poetsgate.com/ViewPoem.aspx?id=16127",""],[5055,"مآثر","https://www.poetsgate.com/ViewPoem.aspx?id=100739",""],[5112,"إلى الشيخ عبده","https://www.poetsgate.com/ViewPoem.aspx?id=212775",""],[5112,"أفيون","https://www.poetsgate.com/ViewPoem.aspx?id=213352",""],[5127,"مَرَّ الصبا فَتَحَرَّكَ الإلهامُ","https://www.poetsgate.com/ViewPoem.aspx?id=177447",""],[5277,"عناقُ الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=191480",""],[5277,"جنّاتُ عاطفتي","https://www.poetsgate.com/ViewPoem.aspx?id=192112",""],[5277,"عشّاقُ الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=194588",""],[5277,"القدرُ الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=200621",""],[5277,"عيونُ بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=204982",""],[592,"يا طالباً مني جوابا شافيا","https://www.poetsgate.com/ViewPoem.aspx?id=128823",""],[5442,"يامن إليه بعزه اتشفع","https://www.poetsgate.com/ViewPoem.aspx?id=114749",""],[5614,"صرخة القدس","https://www.poetsgate.com/ViewPoem.aspx?id=1356",""],[4623,"ما ثنائي عليك إلا يسير ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146774",""],[5769,"خلْوةُ الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=215971",""],[5794,"قلب جدا ..","https://www.poetsgate.com/ViewPoem.aspx?id=80286",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5873,"سيف العزيمة","https://www.poetsgate.com/ViewPoem.aspx?id=215412",""],[5937,"الثُّقب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=214121",""],[5953,"أيها الزائرون مشهد نور","https://www.poetsgate.com/ViewPoem.aspx?id=93793",""],[6045,"أطياف ودّ","https://www.poetsgate.com/ViewPoem.aspx?id=125353",""],[6068,"هي العروبة إيثارا وتضحية","https://www.poetsgate.com/ViewPoem.aspx?id=180271",""],[6093,"بئرٌ معطلةٌ ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176094",""],[6185,"لنكبة وأخواتها !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87024&r=&rc=10",""],[6268,"كَفاكْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82930&r=&rc=16",""]],"verses":[["مَآثِرُ تَبقى ما رَأى الشَمسَ ناظِرٌ","وَما سَمِعَت مِن سامِعٍ أُذُنانِ",0,"ن",1,0],["مَآثِرُ ثَبَّتَّ أَطنابَها","عَلى النَجمِ وَالقَمَرِ الإِضحِيانِ",1,"ن",1,0],["ما ثَنَت عَنهُمُ المَنونَ يَدٌ شَو","كاءُ أَطرافُها مِنَ المُرّانِ",2,"ن",1,0],["مَا ثَمَّ إِلاَّ مَوْقِفٌ رَاهِنٌ","قَدْ وُكِلِ العَدْلُ بِمِيرَانِهِ",3,"ن",2,0],["مَا ثَمَّ إِلاَّ مَا رَأَيْ","تَ وَرُبَّمَا تُعْيي السَّلاَمَهْ",4,"م",2,1],["مَا ثَمَّ إِلاَّ لُقْمَةٌ قَدْ هُيِّئَتْ","لِلْمَوْتِ وَهْوَ الآكِلُ الْمُسْتَعْجِلُ",5,"ل",1,0],["مآثِرُهُمْ في الدّينِ غيْرُ خَفيّةٍ","فهُمْ كالنّجومِ الزّاهِراتِ لمُهْتَدي",6,"د",2,0],["مآثِرُهُ تلْتاحُ في صُحُفِ العُلَى","وآثارُهُ تسْتَنُّ في سُنَنِ الرُّشْدِ",7,"د",1,0],["مآثِرُهُ تلْتاحُ في أفُقِ العُلى","وآثارُهُ تسْتَنُّ في سُنَنِ الرُّشْدِ",8,"د",1,0],["مَآثِرُكُمْ آلَ الْحَكِيم بَقِيتُمُ","بَلَغْنَ مَدَى الْحَظِّ الْمُوَاصلِ وَالْكَسْبِ",9,"ب",1,0],["ما ثُغورُ الزَهرِ في أَكمامِها","ضاحِكاتٍ مِن بُكاءِ السُحُبِ",10,"ب",1,0],["ما ثَلَّ رَبُّكَ عَرشاً باتَ يَحرُسُهُ","عَدلٌ وَلا مَدَّ في سُلطانِ مَن غَدَرا",11,"ر",2,0],["مَآثِرُ مَجدٍ خَلَّدَتها سُيوفُهُ","لَها نَبَأ يَفنى الزَمانُ وَلا يَفنى",12,"ن",2,0],["مَأْثُرَاتٌ جَلَّتْ وَضَاعَفَهَا","أَنَّهَا مِنْ دَقَائِقِ الفِطَنِ",13,"ن",1,0],["مآثرٌ خلَّد الرّحمن أُثرتها","ينصّها من كتاب الله تاليها",14,"ي",3,0],["ما ثنى الجاهَ عن ذليلٍ ولا أع","طى لذي حاجةٍ عطاء وأكدى",15,"د",2,0],["ماثلاً لا يزايلُ الكفَّ بالشُّرْ","بِ وأنَّى بِشُرْب غَيْرِ الشرابِ",16,"ب",1,0],["ماثَ له المسكَ صدقُ مَخبرِهِ","فأيُّ مسكٍ هناك لم يُمَثِ",17,"ث",1,0],["ما ثَمَّ ذِكرى إِذا خَطَرَت عَلى","قَلبي اِستَراحَ سِوى خَيالِ الوادي",18,"د",2,0],["ما ثَمَّ مِن فَنَنٍ إِلى أَوراقِهِ","يَأوي إِذا اِشتَدَّ الهَجيرُ البُلبُلُ",19,"ل",1,0],["ما ثَمَّ داءٌ يُستَطارُ لَهُ الكَرى","ما ثَمَّ غَيرُ كَآبَةٍ وَمَلالِ",20,"ل",1,0],["ماثلة أمامي","مالئة أيامي",21,"ي",1,0],["ما ثُرنَ مِن كُنُسٍ إِلّا إِلى كُنُسٍ","مِنَ الجَوانِحِ ضَمَّتها حَوانيها",22,"ي",3,0],["ماثِلٌ في أُرومَةِ المَجدِ تَرضى","مُنكَفاهُ إِلى النَدى وَاِنصِبابَه",23,"ب",2,0],["ما ثَنائي بِدَرِكٍ بَعضَ نُعما","كَ وَلَو كانَ مِن صَباً أَو جَنوبِ",24,"ب",1,0],["مَأثُراتٌ عَلِقنَهُ وَمُتاحُ الحَظ","ظِ أَدنى إِلى اِمرِىءٍ مِن وَريدِه",25,"د",2,0],["ما ثُلّمَ السيفُ الذي جَسَدُ الثرى","أمْسَى له جفناً بِغَيرِ نِجادِ",26,"د",1,0],["ما ثَمَّ إلا الأُلَى أَدركتَهم قَنصاً","لم يُغِنهِ إذ هَوَى خَوْفٌ وإحجامُ",27,"م",1,0],["ما ثَوى الصالِفُ الجَمُوحُ وَكانَت","بِنِطافِ العَرجَينِ حُمرُ القُبابِ",28,"ب",1,0],["ما ثَعلَبٌ وَاِبنُ يحيى مُبتَغايَ بِهِ","وَإِن تَفاصَحَ إِلّا ثَعلَبٌ ضَبَحا",29,"ح",2,0],["ما ثناني عنكَ الضّنَى فبماذا","يا مَلِيحُ الدّلالُ عني ثناكا",30,"ك",2,0],["ما ثوائي في مكانٍ ما ثوائي","هو ذا الفجرُ فهبُّوا أصدقائي",31,"ي",1,0],["مَآثرُ مِا دَامَتْ سَتُثْني بمَا بهَا","عَلَى فَضْلهِ الأَوْفَى وَتُزْري المُفَنِّدَا",32,"د",2,0],["ما ثَنى مَدامِعِيَ ال","حُمرَ مِن تَحَدّرِها",33,"ر",3,0],["مآثرهم في الدين غير خفية","فهم كالنجوم الزاهرات لمهتد",34,"د",1,0],["مآثرُكُم آل الحكيمِ بقِيتُم","بَلَغْنَ مَدى الحصرِ المُواصِلِ والحَسْب",35,"ب",1,0],["مآثره تلتاح في صحف العلا","وآثاره تستن في سنن الرشد",36,"د",1,0],["مآثره تلتاح في أفق العلا","وآثاره تستن في سنن الرشد",37,"د",1,0],["مَاثِلٌ بَينَ أرْبُعٍ مَاثِلاتٍ،","يَنْزِعُ الشّوْقَ مِنْ فُؤادٍ عَلوقِ",38,"ق",1,0],["مَأثُرَاتٌ عَلِقْنَهُ وَمُتَاحُ ال","حَظّ أدْنَى إلى امرِىءٍ من وَرِيدِهْ",39,"د",2,0],["مَا ثَنَائي بِمُدْرِكٍ بَعضَ نُعْمَا","كَ وَلوْ كانَ من صَباً أوْ جَنُوبِ",40,"ب",1,0],["ما ثَناها العِتاب يَوماً لِعَطفٍ","وَهِيَ في العَين بانة تَنثني",41,"ن",2,0],["مآثر في الثرى نقشت فخارا","جليلا دون رتبته الاثير",42,"ر",1,0],["مآثر لك في الاكوان باهرة","في جبهة الدين من لألأها غرر",43,"ر",1,0],["مآثِرُ أسلافٍ تلاها بنوهُمُ","بأمثالها ألآكرم بها من مآثرِ",44,"ر",1,0],["ما ثوَّروا الآمال عن صدروهم","إلا أناخت بفِناء بابهِ",45,"ب",2,0],["مَآثِرٌ عُدِمَت أَشباهُها وَعُلىً","حَوَيتَ مُطَّرَفاً مِنها وَمُتَّلَدا",46,"د",2,0],["مَآثِرُ تُخبِرُ عَن أَصلِهِ","وَما نَسَبَ السَيفَ مِثلُ الأَثَر",47,"ر",1,0],["مَأثُراتٌ أَبَينَ أَن يَدخُلَ التَش","بيهَ في وَصفِهِنَّ وَالتَمثيلا",48,"ل",2,0],["ماثَلتَهُم ثُمَّ اِنفَرَدَت بِسُؤدُدٍ","تُلفى إِماماً فيهِ لا مَأموما",49,"م",2,0],["مَآثِرُ أَصبَحَت في كُلِّ تاجٍ","عَلى هامِ العُلى دُرّاً ثَمينا",50,"ن",2,0],["مآثِرُ طابَ الظِلُّ مِنها مَعَ الجَنى","بَناها شَديدا لأَسريحُكُمُ ما بَنى",51,"ن",2,0],["ما ثم إلا غافق وعبيده","وسهب والا اربد وزعول",52,"ل",1,0],["مَآثرُ كَالشُموسِ سَرَتْ فَضاءَت","عَلى الأَقطارِ لَم يَترُكنَ صَقعا",53,"ع",2,0],["مَآثِرٌ في سجلِّ المَجدِ قَد كتَبَت","لَو أَنصِفَتْ خَطَّها الرَّاوونَ بِالذَّهَب",54,"ب",1,0],["مآثرهُ في كُتبهم يأثرونها","وَلَو وجدوا في عصرهِ تَبِعوا الإثرا",55,"ر",2,0],["مآثرٌ شَيَّدَ المأثورُ أكثرَها","خيرُ المآثر ما تَبْنِي المآثير",56,"ر",1,0],["مآثم قد نهلت منها","لأشرب السم في الحساب",57,"ب",1,0],["مَآثِرُ عَلياه التي شاع ذِكرُها","تحلَّت بها مصرٌ وَمن حَلَّ في مصر",58,"ر",1,0],["مآثِرُه في حَلْبة الفخر سُبَّقٌ","وتدبيرهُ في ظُلْمة الليل كوكبُ",59,"ب",1,0],["مَآثِرُ لَو كُنتُ اِبنَ حُجرٍ فَصاحَةً","لَقَصَّرَ عَن إِحصائِهِنَّ بَياني",60,"ن",2,0],["ما ثمّ سوى ننحوه إذاً","إلّاك لنا يا ذا الحجج",61,"ج",1,0],["مآثر خيرتي وَديار أنسى","وَمألف كل عيش مستطاب",62,"ب",1,0],["ما ثَنائِي وَإِنْ تَطاوَلَ إِلاّ","دُونَ آلائِكَ الْحِسانِ الْمَرادِ",63,"د",1,0],["ما ثَمَّ غَيرَكَ وَالحِجابُ عَلى","طَوائِفِ في جُسومِهِم حَصَروا",64,"ر",3,0],["ماثَلوا نَجرهُم بِأرفعِ مجدٍ","أَثمَلوا نجرَ عرفهم بالجدودِ",65,"د",1,0],["مآثرُ همّة عنيت بمجدٍ","وَرأيٌ للهوى لا يستقيدُ",66,"د",1,0],["ما ثَنى عَطفي عَلى أَعطافِهِ","في قُباهُ بِقُبا رَدُّ الرُدَي",67,"ي",1,0],["مَآثر كفرندِ السَيف باهِرَة","وَهمّة مثل حَدّ السَيف إِن عَملا",68,"ل",2,0],["مَآثر تَمنَح السَفهاء حلماً","وَأَرباب الحُلوم عَلى وجاها",69,"ا",3,0],["مَأثُراتٌ ما إن يُرَى حين تَتْلو","لك فيها نِدّاً ولا منك بُدّا",70,"د",2,0],["ما ثَمَّ إِلّا عَينٌ أُنَعِّمُها","وَقَولُ سُبحانَ رَبّيَ الخالِقْ",71,"ق",1,0],["ما ثَمَّ شيء للنصوص معارض","إلا اعتذار وهو شيء بارد",72,"د",1,0],["ما ثنى عِطفَه لحرٍّ مُصانِ","ليتَ شعري ما يرتجى من زمان",73,"ن",1,0],["ما ثناه عن المكارم ثانٍ","وأبى أن يرى الكريم بخيلا",74,"ل",2,0],["ما ثنى عزمي إلى غيركم","بالثنا إلا عليكم كنت أثني",75,"ن",2,0],["مآثِرُ لَمْ يَعطَل بِهَا قَرنُ ناطِحٍ","وكيفَ وقَرنُ الحقِّ عَنهُنَّ نَطَّاحُ",76,"ح",1,0],["مآثِرُ عامِرِيَّينِ اسْتَبَدَّا","لساحاتِ المكارِمِ عامِرَيْنِ",77,"ن",1,0],["مآثِرُ لَمْ يَسْبِقْ إِلَيْهِنَّ سابقٌ","ولا رامَها من قَبْلِ سَعْيِكَ رائِمُ",78,"م",1,0],["ما ثماني السنين إلا ثوان","من حياتي ومن وجودي المعار",79,"ر",1,0],["ما ثروتي غير نفسي إن سموتُ بها","فإن هويتُ ففقري بين أنقاضي",80,"ض",2,0],["ما ثقُلت وإنما","قويتُمُ وضعُفوا",81,"ف",3,0],["ماثقبة ظاهرها أسود","لكنّ في باطنها حُمْره",82,"ر",2,1],["مَأثمُ حُسادِ الكلامِ عَظيمةٌ","مَضرَّتُهم محضُ الضلالةِ في المَلا",83,"ل",2,1],["مآثر في عين العدو بها قذى","وفي أذنيه من وقائعها صخ",84,"خ",1,0],["مآثر لو تركنا شرح جملتها","غنيت فيها عن التفصيل بالجمل",85,"ل",1,1],["ما ثَمَّ خوفٌ دَخَلْنَا في غياهبِهِ","إلا حَسِبْنَاهُ منفًى من منافينا",86,"ن",2,0],["مأثُراتٌ شَقَقَنْ حتّى لقد قم","نَ بعذرِ المقصّرِ المُرتاعِ",87,"ع",1,0],["مأثُرَاتٌ ما نلتُها بوسيلٍ","لِيَ منه ولا دعوتُ شفيعا",88,"ع",2,0],["مآثرُ يُثقلنَ الحسودَ فخامةً","ويُعيين من إشرافهنَّ الغوامطا",89,"ط",2,0],["ما ثَناه عنِّي تَقَضِّي شَبابِي","وهْوَ في وجْنتيه ماءُ الشّبابِ",90,"ب",1,0],["ما ثم غير إحاطة","بالكل من رب ودود",91,"د",1,0],["ما ثم سوى الأحكام فلا","تمدح شيأ فالشيء هجي",92,"ج",2,0],["ما ثغرهُ وَحْدَه جُمَانٌ","بل شخصُه كُلُّه جُمَ