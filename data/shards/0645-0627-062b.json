{"poems":[[53,"ظمائي إلى من لو أراد سقاني","https://www.aldiwan.net/poem29649.html","الطويل"],[53,"ضلالا لسائل هذي المغاني","https://www.aldiwan.net/poem29720.html","المتقارب"],[53,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[77,"أنا إلى الله وإنا له","https://www.aldiwan.net/poem36021.html","الطويل"],[77,"ما ثم إلا ما رأيت","https://www.aldiwan.net/poem36090.html","مجزوء الكامل"],[77,"ما أوبق الأنفس إلا الأمل","https://www.aldiwan.net/poem36351.html","الرجز"],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[77,"دعاها تشم آثار نجد ففي نجد","https://www.aldiwan.net/poem36603.html","الطويل"],[77,"مقامك مرفوع على عمد السعد","https://www.aldiwan.net/poem36604.html","الطويل"],[77,"أنور سناء لاح في مشرق الغرب","https://www.aldiwan.net/poem36773.html","الطويل"],[86,"أعجمي كاد يعلو نجمه","https://www.aldiwan.net/poem68943.html","الرمل"],[86,"لمحت من مصر ذاك التاج والقمرا","https://www.aldiwan.net/poem68954.html","البسيط"],[71,"سلوا صهوات الخيل يوم الوغى عنا","https://www.aldiwan.net/poem4023.html","الطويل"],[93,"بقي الذكر والرغام فني","https://www.aldiwan.net/poem11249.html","الخفيف"],[83,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[72,"عاش وصلا وغيره مات صدا","https://www.aldiwan.net/poem18558.html","الطويل"],[51,"علني أحمد من الدوشاب","https://www.aldiwan.net/poem8651.html","الخفيف"],[51,"يا دهر ما سبك غير ذي الخبث","https://www.aldiwan.net/poem9235.html","المنسرح"],[91,"قل للحمائم في ضفاف الوادي","https://www.aldiwan.net/poem8798.html","عموديه"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[91,"ما للهموم الطارقات ومالي","https://www.aldiwan.net/poem62625.html","عموديه"],[85,"أروى لكم خرافة","https://www.aldiwan.net/poem7773.html","مجزوء الرجز"],[85,"أهل القدود التي صالت عواليها","https://www.aldiwan.net/poem62992.html","البسيط"],[45,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[45,"رقة النور واهتزاز القضيب","https://www.aldiwan.net/poem10892.html","الخفيف"],[45,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[105,"بني سليم أعدوا الخيل واحترسوا","https://www.aldiwan.net/poem43997.html","البسيط"],[40,"يا لقومي لطول هذا العتاب","https://www.aldiwan.net/poem42286.html","الخفيف"],[46,"دعوا وما فيهم زاك ولا أحد","https://www.aldiwan.net/poem22291.html","البسيط"],[68,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.poetsgate.com/ViewPoem.aspx?id=33822",""],[77,"أنورُ سناءَ لاحَ في مشْرِق الغرْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33315",""],[77,"دعاها تشم آثار نجد ففي نجد","https://www.poetsgate.com/ViewPoem.aspx?id=33821",""],[77,"مقامك مرفوع على عمد السعد","https://www.poetsgate.com/ViewPoem.aspx?id=33814",""],[45,"ها هوَ الشّيبُ لائِماً، فأفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=32844",""],[45,"بَاتَ عَهْدُ الصّبَا وَباقي جَديدِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31632",""],[45,"رِقّةُ النَّوْرِ، وَاهتِزَازُ القَضِيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31567",""]],"verses":[["مَآثِرُ تَبقى ما رَأى الشَمسَ ناظِرٌ","وَما سَمِعَت مِن سامِعٍ أُذُنانِ",0,"ن",1,0],["مَآثِرُ ثَبَّتَّ أَطنابَها","عَلى النَجمِ وَالقَمَرِ الإِضحِيانِ",1,"ن",1,0],["ما ثَنَت عَنهُمُ المَنونَ يَدٌ شَو","كاءُ أَطرافُها مِنَ المُرّانِ",2,"ن",1,0],["مَا ثَمَّ إِلاَّ مَوْقِفٌ رَاهِنٌ","قَدْ وُكِلِ العَدْلُ بِمِيرَانِهِ",3,"ن",2,0],["مَا ثَمَّ إِلاَّ مَا رَأَيْ","تَ وَرُبَّمَا تُعْيي السَّلاَمَهْ",4,"م",2,1],["مَا ثَمَّ إِلاَّ لُقْمَةٌ قَدْ هُيِّئَتْ","لِلْمَوْتِ وَهْوَ الآكِلُ الْمُسْتَعْجِلُ",5,"ل",1,0],["مآثِرُهُمْ في الدّينِ غيْرُ خَفيّةٍ","فهُمْ كالنّجومِ الزّاهِراتِ لمُهْتَدي",6,"د",2,0],["مآثِرُهُ تلْتاحُ في صُحُفِ العُلَى","وآثارُهُ تسْتَنُّ في سُنَنِ الرُّشْدِ",7,"د",1,0],["مآثِرُهُ تلْتاحُ في أفُقِ العُلى","وآثارُهُ تسْتَنُّ في سُنَنِ الرُّشْدِ",8,"د",1,0],["مَآثِرُكُمْ آلَ الْحَكِيم بَقِيتُمُ","بَلَغْنَ مَدَى الْحَظِّ الْمُوَاصلِ وَالْكَسْبِ",9,"ب",1,0],["ما ثُغورُ الزَهرِ في أَكمامِها","ضاحِكاتٍ مِن بُكاءِ السُحُبِ",10,"ب",1,0],["ما ثَلَّ رَبُّكَ عَرشاً باتَ يَحرُسُهُ","عَدلٌ وَلا مَدَّ في سُلطانِ مَن غَدَرا",11,"ر",2,0],["مَآثِرُ مَجدٍ خَلَّدَتها سُيوفُهُ","لَها نَبَأ يَفنى الزَمانُ وَلا يَفنى",12,"ن",2,0],["مَأْثُرَاتٌ جَلَّتْ وَضَاعَفَهَا","أَنَّهَا مِنْ دَقَائِقِ الفِطَنِ",13,"ن",1,0],["مآثرٌ خلَّد الرّحمن أُثرتها","ينصّها من كتاب الله تاليها",14,"ي",3,0],["ما ثنى الجاهَ عن ذليلٍ ولا أع","طى لذي حاجةٍ عطاء وأكدى",15,"د",2,0],["ماثلاً لا يزايلُ الكفَّ بالشُّرْ","بِ وأنَّى بِشُرْب غَيْرِ الشرابِ",16,"ب",1,0],["ماثَ له المسكَ صدقُ مَخبرِهِ","فأيُّ مسكٍ هناك لم يُمَثِ",17,"ث",1,0],["ما ثَمَّ ذِكرى إِذا خَطَرَت عَلى","قَلبي اِستَراحَ سِوى خَيالِ الوادي",18,"ي",1,0],["ما ثَمَّ مِن فَنَنٍ إِلى أَوراقِهِ","يَأوي إِذا اِشتَدَّ الهَجيرُ البُلبُلُ",19,"ل",1,0],["ما ثَمَّ داءٌ يُستَطارُ لَهُ الكَرى","ما ثَمَّ غَيرُ كَآبَةٍ وَمَلالِ",20,"ل",1,0],["ماثلة أمامي","مالئة أيامي",21,"ي",1,0],["ما ثُرنَ مِن كُنُسٍ إِلّا إِلى كُنُسٍ","مِنَ الجَوانِحِ ضَمَّتها حَوانيها",22,"ي",3,0],["ماثِلٌ في أُرومَةِ المَجدِ تَرضى","مُنكَفاهُ إِلى النَدى وَاِنصِبابَه",23,"ب",2,0],["ما ثَنائي بِدَرِكٍ بَعضَ نُعما","كَ وَلَو كانَ مِن صَباً أَو جَنوبِ",24,"ب",1,0],["مَأثُراتٌ عَلِقنَهُ وَمُتاحُ الحَظ","ظِ أَدنى إِلى اِمرِىءٍ مِن وَريدِه",25,"د",2,0],["ما ثُلّمَ السيفُ الذي جَسَدُ الثرى","أمْسَى له جفناً بِغَيرِ نِجادِ",26,"د",1,0],["ما ثَمَّ إلا الأُلَى أَدركتَهم قَنصاً","لم يُغِنهِ إذ هَوَى خَوْفٌ وإحجامُ",27,"م",1,0],["ما ثَوى الصالِفُ الجَمُوحُ وَكانَت","بِنِطافِ العَرجَينِ حُمرُ القُبابِ",28,"ب",1,0],["ما ثَعلَبٌ وَاِبنُ يحيى مُبتَغايَ بِهِ","وَإِن تَفاصَحَ إِلّا ثَعلَبٌ ضَبَحا",29,"ح",2,0],["ما ثناني عنكَ الضّنَى فبماذا","يا مَلِيحُ الدّلالُ عني ثناكا",30,"ك",2,0],["ما ثوائي في مكانٍ ما ثوائي","هو ذا الفجرُ فهبُّوا أصدقائي",31,"ي",1,0],["مَآثرُ مِا دَامَتْ سَتُثْني بمَا بهَا","عَلَى فَضْلهِ الأَوْفَى وَتُزْري المُفَنِّدَا",32,"د",2,0],["ما ثَنى مَدامِعِيَ ال","حُمرَ مِن تَحَدّرِها",33,"ر",3,0],["مآثرهم في الدين غير خفية","فهم كالنجوم الزاهرات لمهتد",34,"د",1,0],["مآثرُكُم آل الحكيمِ بقِيتُم","بَلَغْنَ مَدى الحصرِ المُواصِلِ والحَسْب",35,"ب",1,0],["مآثره تلتاح في صحف العلا","وآثاره تستن في سنن الرشد",36,"د",1,0],["مآثره تلتاح في أفق العلا","وآثاره تستن في سنن الرشد",37,"د",1,0],["مَاثِلٌ بَينَ أرْبُعٍ مَاثِلاتٍ،","يَنْزِعُ الشّوْقَ مِنْ فُؤادٍ عَلوقِ",38,"ق",1,0],["مَأثُرَاتٌ عَلِقْنَهُ وَمُتَاحُ ال","حَظّ أدْنَى إلى امرِىءٍ من وَرِيدِهْ",39,"د",2,0],["مَا ثَنَائي بِمُدْرِكٍ بَعضَ نُعْمَا","كَ وَلوْ كانَ من صَباً أوْ جَنُوبِ",40,"ب",1,0]]}