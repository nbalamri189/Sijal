دولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[146,"يا ديمتي نوء الثريا دوما","https://www.aldiwan.net/poem11820.html","الكامل"],[146,"أما وبديع ما تأتي يمينا","https://www.aldiwan.net/poem11835.html","الوافر"],[153,"عن الحب في الهادي استحال سلونا","https://www.aldiwan.net/poem68587.html","الطويل"],[163,"شهود الهوى منى علي عذول","https://www.aldiwan.net/poem58955.html","الطويل"],[185,"إليك ركائب الآمال تسعى","https://www.aldiwan.net/poem67050.html","الوافر"],[185,"رواية قد روت عن أمة العرب","https://www.aldiwan.net/poem67085.html","البسيط"],[192,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[201,"أما وقد شردت تلك اليعافير","https://www.aldiwan.net/poem51940.html","البسيط"],[214,"أسرفت يوما على شبابي","https://www.aldiwan.net/poem46222.html","مخلع البسيط"],[228,"أغرتك الغراء أم طلعة البدر","https://www.aldiwan.net/poem55246.html","الطويل"],[232,"شرى البرق فالتاع الفؤاد المعذب","https://www.aldiwan.net/poem51254.html","الطويل"],[238,"ليهنك أني في حبالك عاني","https://www.aldiwan.net/poem31742.html","الطويل"],[262,"قم واستنشق نفح الفرج","https://www.aldiwan.net/poem35830.html","المتدارك"],[274,"مضى زمن الصبا فدع التصابي","https://www.aldiwan.net/poem52055.html","الوافر"],[283,"قد توالت علي منك أيادي","https://www.aldiwan.net/poem60720.html","الخفيف"],[307,"إن كان هذا الذي أكابده","https://www.aldiwan.net/poem16752.html","المنسرح"],[308,"خير حام مجد مجير العبيد","https://www.aldiwan.net/poem56553.html","الخفيف"],[308,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[352,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[356,"يا راحلين بقلبي والنهى أفلا","https://www.aldiwan.net/poem39587.html","البسيط"],[356,"أدم شرب الأتاي فإن فيها","https://www.aldiwan.net/poem39599.html","الكامل"],[367,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[369,"أحبه والسماء والطارق","https://www.aldiwan.net/poem17045.html","المنسرح"],[406,"يافخر دين الله يا من نظمه","https://www.aldiwan.net/poem33981.html","الكامل"],[419,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[419,"من يحاول في الدهر مجدا أثيلا","https://www.aldiwan.net/poem54123.html","الخفيف"],[440,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[442,"إلى أي ذكر غير ذكرك أرتاح","https://www.aldiwan.net/poem34787.html","الطويل"],[442,"لك البشرى ودمت قرير عين","https://www.aldiwan.net/poem34819.html","الوافر"],[442,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[455,"منبري عالمي وليس بأرض","https://www.aldiwan.net/poem61277.html","الخفيف"],[455,"عزيت نفسي وما عزيتها اسفا","https://www.aldiwan.net/poem61722.html","البسيط"],[460,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[497,"ماثقبة ظاهرها أسود","https://www.aldiwan.net/poem9867.html","السريع"],[506,"مأثم حساد الكلام عظيمة","https://www.aldiwan.net/poem38395.html","عموديه"],[517,"أأحبابنا كم تبخلون وكم نسخو","https://www.aldiwan.net/poem12057.html","الطويل"],[517,"مآثر لو تركنا شرح جملتها","https://www.aldiwan.net/poem12236.html","البسيط"],[546,"حديقة بلا غناء","https://www.aldiwan.net/poem67250.html","عموديه"],[553,"ضمنت مجدك العلا والمساعي","https://www.aldiwan.net/poem47709.html","الخفيف"],[553,"ليت أنا لما فقدنا الهجوعا","https://www.aldiwan.net/poem47716.html","الخفيف"],[553,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[553,"بأبي زائرا أتاني ليلا","https://www.aldiwan.net/poem48068.html","الخفيف"],[560,"إني أنا بك يا ودود","https://www.aldiwan.net/poem34580.html","مجزوء الكامل"],[560,"قد أصبح قلبي في وهج","https://www.aldiwan.net/poem34693.html","المتدارك"],[577,"سلني بالله عن فلان","https://www.aldiwan.net/poem2845.html","مخلع البسيط"],[589,"ألا أيها الغادي مجداً بنجداً","https://www.aldiwan.net/poem11509.html","عموديه"]],"verses":[["مَآثِرُ تَبقى ما رَأى الشَمسَ ناظِرٌ","وَما سَمِعَت مِن سامِعٍ أُذُنانِ",0,"ن",1,0],["مَآثِرُ ثَبَّتَّ أَطنابَها","عَلى النَجمِ وَالقَمَرِ الإِضحِيانِ",1,"ن",1,0],["ما ثَنَت عَنهُمُ المَنونَ يَدٌ شَو","كاءُ أَطرافُها مِنَ المُرّانِ",2,"ن",1,0],["مَا ثَمَّ إِلاَّ مَوْقِفٌ رَاهِنٌ","قَدْ وُكِلِ العَدْلُ بِمِيرَانِهِ",3,"ن",2,0],["مَا ثَمَّ إِلاَّ مَا رَأَيْ","تَ وَرُبَّمَا تُعْيي السَّلاَمَهْ",4,"م",2,1],["مَا ثَمَّ إِلاَّ لُقْمَةٌ قَدْ هُيِّئَتْ","لِلْمَوْتِ وَهْوَ الآكِلُ الْمُسْتَعْجِلُ",5,"ل",1,0],["مآثِرُهُمْ في الدّينِ غيْرُ خَفيّةٍ","فهُمْ كالنّجومِ الزّاهِراتِ لمُهْتَدي",6,"د",2,0],["مآثِرُهُ تلْتاحُ في صُحُفِ العُلَى","وآثارُهُ تسْتَنُّ في سُنَنِ الرُّشْدِ",7,"د",1,0],["مآثِرُهُ تلْتاحُ في أفُقِ العُلى","وآثارُهُ تسْتَنُّ في سُنَنِ الرُّشْدِ",8,"د",1,0],["مَآثِرُكُمْ آلَ الْحَكِيم بَقِيتُمُ","بَلَغْنَ مَدَى الْحَظِّ الْمُوَاصلِ وَالْكَسْبِ",9,"ب",1,0],["ما ثُغورُ الزَهرِ في أَكمامِها","ضاحِكاتٍ مِن بُكاءِ السُحُبِ",10,"ب",1,0],["ما ثَلَّ رَبُّكَ عَرشاً باتَ يَحرُسُهُ","عَدلٌ وَلا مَدَّ في سُلطانِ مَن غَدَرا",11,"ر",2,0],["مَآثِرُ مَجدٍ خَلَّدَتها سُيوفُهُ","لَها نَبَأ يَفنى الزَمانُ وَلا يَفنى",12,"ن",2,0],["مَأْثُرَاتٌ جَلَّتْ وَضَاعَفَهَا","أَنَّهَا مِنْ دَقَائِقِ الفِطَنِ",13,"ن",1,0],["مآثرٌ خلَّد الرّحمن أُثرتها","ينصّها من كتاب الله تاليها",14,"ي",3,0],["ما ثنى الجاهَ عن ذليلٍ ولا أع","طى لذي حاجةٍ عطاء وأكدى",15,"د",2,0],["ماثلاً لا يزايلُ الكفَّ بالشُّرْ","بِ وأنَّى بِشُرْب غَيْرِ الشرابِ",16,"ب",1,0],["ماثَ له المسكَ صدقُ مَخبرِهِ","فأيُّ مسكٍ هناك لم يُمَثِ",17,"ث",1,0],["ما ثَمَّ ذِكرى إِذا خَطَرَت عَلى","قَلبي اِستَراحَ سِوى خَيالِ الوادي",18,"د",2,0],["ما ثَمَّ مِن فَنَنٍ إِلى أَوراقِهِ","يَأوي إِذا اِشتَدَّ الهَجيرُ البُلبُلُ",19,"ل",1,0],["ما ثَمَّ داءٌ يُستَطارُ لَهُ الكَرى","ما ثَمَّ غَيرُ كَآبَةٍ وَمَلالِ",20,"ل",1,0],["ماثلة أمامي","مالئة أيامي",21,"ي",1,0],["ما ثُرنَ مِن كُنُسٍ إِلّا إِلى كُنُسٍ","مِنَ الجَوانِحِ ضَمَّتها حَوانيها",22,"ي",3,0],["ماثِلٌ في أُرومَةِ المَجدِ تَرضى","مُنكَفاهُ إِلى النَدى وَاِنصِبابَه",23,"ب",2,0],["ما ثَنائي بِدَرِكٍ بَعضَ نُعما","كَ وَلَو كانَ مِن صَباً أَو جَنوبِ",24,"ب",1,0],["مَأثُراتٌ عَلِقنَهُ وَمُتاحُ الحَظ","ظِ أَدنى إِلى اِمرِىءٍ مِن وَريدِه",25,"د",2,0],["ما ثُلّمَ السيفُ الذي جَسَدُ الثرى","أمْسَى له جفناً بِغَيرِ نِجادِ",26,"د",1,0],["ما ثَمَّ إلا الأُلَى أَدركتَهم قَنصاً","لم يُغِنهِ إذ هَوَى خَوْفٌ وإحجامُ",27,"م",1,0],["ما ثَوى الصالِفُ الجَمُوحُ وَكانَت","بِنِطافِ العَرجَينِ حُمرُ القُبابِ",28,"ب",1,0],["ما ثَعلَبٌ وَاِبنُ يحيى مُبتَغايَ بِهِ","وَإِن تَفاصَحَ إِلّا ثَعلَبٌ ضَبَحا",29,"ح",2,0],["ما ثناني عنكَ الضّنَى فبماذا","يا مَلِيحُ الدّلالُ عني ثناكا",30,"ك",2,0],["ما ثوائي في مكانٍ ما ثوائي","هو ذا الفجرُ فهبُّوا أصدقائي",31,"ي",1,0],["مَآثرُ مِا دَامَتْ سَتُثْني بمَا بهَا","عَلَى فَضْلهِ الأَوْفَى وَتُزْري المُفَنِّدَا",32,"د",2,0],["ما ثَنى مَدامِعِيَ ال","حُمرَ مِن تَحَدّرِها",33,"ر",3,0],["مآثرهم في الدين غير خفية","فهم كالنجوم الزاهرات لمهتد",34,"د",1,0],["مآثرُكُم آل الحكيمِ بقِيتُم","بَلَغْنَ مَدى الحصرِ المُواصِلِ والحَسْب",35,"ب",1,0],["مآثره تلتاح في صحف العلا","وآثاره تستن في سنن الرشد",36,"د",1,0],["مآثره تلتاح في أفق العلا","وآثاره تستن في سنن الرشد",37,"د",1,0],["مَاثِلٌ بَينَ أرْبُعٍ مَاثِلاتٍ،","يَنْزِعُ الشّوْقَ مِنْ فُؤادٍ عَلوقِ",38,"ق",1,0],["مَأثُرَاتٌ عَلِقْنَهُ وَمُتَاحُ ال","حَظّ أدْنَى إلى امرِىءٍ من وَرِيدِهْ",39,"د",2,0],["مَا ثَنَائي بِمُدْرِكٍ بَعضَ نُعْمَا","كَ وَلوْ كانَ من صَباً أوْ جَنُوبِ",40,"ب",1,0],["ما ثَناها العِتاب يَوماً لِعَطفٍ","وَهِيَ في العَين بانة تَنثني",41,"ن",2,0],["مآثر في الثرى نقشت فخارا","جليلا دون رتبته الاثير",42,"ر",1,0],["مآثر لك في الاكوان باهرة","في جبهة الدين من لألأها غرر",43,"ر",1,0],["مآثِرُ أسلافٍ تلاها بنوهُمُ","بأمثالها ألآكرم بها من مآثرِ",44,"ر",1,0],["ما ثوَّروا الآمال عن صدروهم","إلا أناخت بفِناء بابهِ",45,"ب",2,0],["مَآثِرٌ عُدِمَت أَشباهُها وَعُلىً","حَوَيتَ مُطَّرَفاً مِنها وَمُتَّلَدا",46,"د",2,0],["مَآثِرُ تُخبِرُ عَن أَصلِهِ","وَما نَسَبَ السَيفَ مِثلُ الأَثَر",47,"ر",1,0],["مَأثُراتٌ أَبَينَ أَن يَدخُلَ التَش","بيهَ في وَصفِهِنَّ وَالتَمثيلا",48,"ل",2,0],["ماثَلتَهُم ثُمَّ اِنفَرَدَت بِسُؤدُدٍ","تُلفى إِماماً فيهِ لا مَأموما",49,"م",2,0],["مَآثِرُ أَصبَحَت في كُلِّ تاجٍ","عَلى هامِ العُلى دُرّاً ثَ