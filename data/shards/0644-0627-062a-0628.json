.aldiwan.net/poem33145.html","أحذ الكامل"],[307,"لا تبرز النظم في هجو فإن لمن","https://www.aldiwan.net/poem57649.html","البسيط"],[307,"يا غادة لما انثنت لم يحل لي","https://www.aldiwan.net/poem58063.html","الكامل"],[309,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[309,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[320,"خطب طرقت به أمر طروق","https://www.aldiwan.net/poem69430.html","البسيط"],[324,"لا تقل همت في ضياء الغزال","https://www.aldiwan.net/poem67214.html","الخفيف"],[332,"أقبل على موكب الحيارى","https://www.aldiwan.net/poem54967.html","مخلع البسيط"],[332,"كم ليال سهرتها","https://www.aldiwan.net/poem55072.html","مجزوء الخفيف"],[342,"ما الدر منظوما بأحسن من","https://www.aldiwan.net/poem68705.html","أحذ الكامل"],[352,"تنسيك عرقوبا له قواعد","https://www.aldiwan.net/poem19921.html","الرجز"],[365,"لا تأمن الدهر ان الدهر خوان","https://www.aldiwan.net/poem68052.html","البسيط"],[365,"سيدي بالذي أمدك بالحسن","https://www.aldiwan.net/poem68074.html","الخفيف"],[368,"أشاكر أنا للأيام أم شاك","https://www.aldiwan.net/poem60816.html","البسيط"],[368,"قفا معي في هذه المعاهد","https://www.aldiwan.net/poem60949.html","السريع"],[375,"يرمي فلا أتحيد","https://www.aldiwan.net/poem57507.html","مجزوء الكامل"],[381,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[381,"يسوع أقبل من عرش السماء فقد","https://www.aldiwan.net/poem59452.html","البسيط"],[384,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[395,"خذ من الوقت ما سمح","https://www.aldiwan.net/poem54594.html","عموديه"],[397,"حق العيادة يوم بعد يومين","https://www.aldiwan.net/poem53396.html","البسيط"],[404,"يا مسجد الإسراء","https://www.aldiwan.net/poem6713.html","عموديه"],[404,"بسلامة الصدر الحياة تطيب","https://www.aldiwan.net/poem6747.html","عموديه"],[406,"كم ذا يذوب أسى وكم يتجلد","https://www.aldiwan.net/poem46938.html","الكامل"],[407,"بنت فكر وافت كشمس النهار","https://www.aldiwan.net/poem33921.html","الخفيف"],[413,"حتى متى يا قلب لا تستفيق","https://www.aldiwan.net/poem32561.html","السريع"],[420,"أترى في الوجود مثلك عالم","https://www.aldiwan.net/poem54119.html","الخفيف"],[420,"من يحاول في الدهر مجدا أثيلا","https://www.aldiwan.net/poem54123.html","الخفيف"],[436,"هذا مقام أبيك فاسم بمجده","https://www.aldiwan.net/poem12593.html","الكامل"],[447,"أهي الجنة التي وعد الله","https://www.aldiwan.net/poem55987.html","عموديه"],[456,"الخريف الخريف رددت الأطيار","https://www.aldiwan.net/poem61303.html","الخفيف"],[461,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[461,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[461,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[461,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[461,"بلغت صبرا فقالت ما الخبر","https://www.aldiwan.net/poem56203.html","الرمل"],[461,"من عذيري يوم شرقي الحمى","https://www.aldiwan.net/poem56251.html","الرمل"],[471,"لا تبع المعروف بالمنكر","https://www.aldiwan.net/poem59972.html","السريع"],[471,"رو بالوبل من صلاحك دينا","https://www.aldiwan.net/poem60141.html","الخفيف"],[480,"حالي غدا عاطلا من وصلك الحالي","https://www.aldiwan.net/poem15264.html","البسيط"],[486,"إن الخليط أجد البين فابتكروا","https://www.aldiwan.net/poem2067.html","البسيط"],[508,"التّرِكة","https://www.aldiwan.net/poem42458.html","الرمل"],[518,"هي سلوة حلت عقود وفائها","https://www.aldiwan.net/poem11999.html","الكامل"],[554,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[554,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[554,"مر علينا فكنفنا به","https://www.aldiwan.net/poem47779.html","السريع"],[554,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[565,"لا تبك إن جد بعض القوم في السفر","https://www.aldiwan.net/poem52923.html","البسيط"],[565,"لا تبك ميتا ولا تفرح بمولود","https://www.aldiwan.net/poem52979.html","البسيط"],[567,"لا تبك تُونس يا ياسين أو فدسا","https://www.aldiwan.net/poem857.html",""],[570,"تزداد فيك مصيبتي","https://www.aldiwan.net/poem69633.html","مجزوء الكامل"],[578,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[746,"","https://poetry.dctabudhabi.ae/diwan/poem/31378","الكامل"],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/20465","الكامل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/10470","البسيط"],[1108,"","https://poetry.dctabudhabi.ae/diwan/poem/97814","الكامل"]],"verses":[["لا تَبعَدَنَّ مَطايانا الَّتي حَمَلَت","تِلكَ الظَعائِنَ مُرخاةً لَها الجُدُلُ",0,"ل",1,0],["لا تُبصِرُ الدَهرَ بَعدَ اليَومِ مُبتَسِماً","إِنَّ اللَيالِيَ أَنسَت بَعدَهُ الضَحِكا",1,"ك",2,0],["لا تَبرِ عوداً أَنتَ رَيشَتَهُ","حاشا لِباني المَجدِ أَن يَنقُضا",2,"ض",2,0],["لا تَبعَدَنَّ أَمانِيَّ الَّتي نَشَزَت","عَلى الزَمانِ بِأَيدي الأَينُقِ الصُعُرِ",3,"ر",1,0],["لا تَبعَدَنَّ وَأَينَ قُربُكَ بَعدَها","إِنَّ المَنايا غايَةُ الأَبعادِ",4,"د",1,0],["لاَ تُبدِ هَوْنَاً فِي الشَّدَائِدِ إِنْ عَرَتْ","فَبِقَدْرِ مَا تُبْدِيهِ قَدْرُكَ يحملُ",5,"ل",1,0],["لا تُبدِيَنَّ نَميمَةً حُدِّثتَها","وَتَحَفَّظَنَّ مِن الَّذي أَنباكَها",6,"ك",3,0],["لا تُبالي زُلزِلَت مِن تَحتِها","أَم عَلَيها النَجمُ بِالنَجمِ اِصطَدَم",7,"م",1,0],["لا تُبالي لَعِبَ القَومُ بِها","أَم بِها صَرفُ اللَيالي لَعِبا",8,"ب",2,0],["لا تُبالي أَرُعتَ بِالبَينِ أَحبا","باً وَأَسرَفتَ في أَذي المُستَهامِ",9,"م",1,0],["لا تَبعُدَن تُربَةٌ ضَمَّت شَمائِلَهُ","وَلا عَدا جانِبَيها العارِضُ الهَطِلُ",10,"ل",1,0],["لا تَبْعَدَنَّ فَإِنَّ فِي أَكْبَادِنَا","لَكَ جَانِباً يَنْبُو عَنِ السُّلْوَانِ",11,"ن",1,0],["لا تُبْقِ فِي نَفْسٍ بِهِ اضَّطَلَعَتْ","مِنْ حَاجَةٍ تَعْدُلْ وَتَسْتَقِمِ",12,"م",1,0],["لا تَبِنْ أَيُّهَا المُحَيَّا الْوَسِيمُ","لا تَهُنْ أَيُّهَا الْفُؤَادُ الكَرِيمُ",13,"م",1,1],["لا تبك أربعهم ولا الأطلالا","واربأ بحبّك أن يكون خبالا",14,"ل",2,1],["لا تَبعَدَنَّ وَكُلُّ حَيٍّ هالِكٌ","وَلِكُلِّ مَصرَعِ هالِكٍ مِقدارُ",15,"ر",1,0],["لاتَبخَلَنَّ عَلى قَومٍ إِذا قُتِلوا","أَثنى عَلَيكَ بَنو الهَيجاءِ دونَهُمُ",16,"م",1,0],["لاتَبيعيني بِرُخصٍ","إِنَّ في مِثلي يُغالى",17,"ل",2,0],["لا تبعدَنَّ فكم أبقيت منقبةً","كالغيث ولَّى وأبقى فضل آثار",18,"ر",1,0],["لا تبتغي كلماتي اليوم في غزلٍ","فهنَّ لابن عليّ في الثنا شِيَع",19,"ع",1,0],["لا تبغِ منزلَ فضلٍ بعد منزلهِ","من حلّ طيبةَ لم يحتج إلى النجف",20,"ف",1,0],["لا تبعدنَّ فلا لاقيت مغربةً","ولا سلكت طريقاً ليس مسلوكا",21,"ك",2,0],["لا تَبْخَلَنَّ على منْ لستَ كافِيَهُ","بأنْ تقولَ تَزحْزَحْ غير مطرودِ",22,"د",1,0],["لا تَبْعَدَنَّ أبا العباس من مَلِكٍ","وإنْ نأيْتَ وإن أصْبحتَ في البَعَدِ",23,"د",1,0],["لا تُباعده من أمامك ما اسطَعْ","تَ فليس الصواب في إبعادِهْ",24,"د",2,0],["لا تَبْعدنَّ من الذي تُكْنَى به","وهو الذي تفسيرُه الإبعادُ",25,"د",1,0],["لا تبتروا عندي وعند أبي يداً","بيضاء ما جُحدَتْ وليست تجحدُ",26,"د",1,0],["لا تُبرئوا داءَ الحسود بجفْوةٍ","مسَّتْ أخاً لَكُمُ عليكمْ يُحسَدُ",26,"د",1,0],["لا تَبعَدنَّ قصائدٌ ذهبتْ سُدَى","جَارتْ بها الهفواتُ عن سَنَنِ الهُدى",27,"د",2,1],["لا تبخلنَّ على امرىء خيَّبْتَهُ","بجواب مسألةٍ كبُخلك بالجَدا",27,"د",2,0],["لا تبنينَّ بنيةً قوَّادةً","تُزْني بناتِ أبي البنات بجارِهِ",28,"ر",2,0],["لا تبعُدَن من صاحبي","ن نَفيتما ضعة وَفقرا",29,"ر",2,0],["لا تُبْدِلنّي بما اقتنيتُ من ال","آمال هَجسَ المخاوف الهُجُس",30,"س",1,0],["لا تبكينّ على قتادة خارطٍ","وابكِ الدماء على بنانِ الخارط",31,"ط",1,0],["لا تبلغا الدهر أقصى إربة لكما","فاستبدلا لكما من آخر طرفا",32,"ف",2,0],["لا تبعدنّ كريمةٌ أودعْتَها","صِهراً من الأصهارِ لا يُخزِيكا",33,"ك",2,0],["لا تبخلن بمالٍ لستَ مالكَه","فلا يفُوتَنك تبخيلٌ وتضليلُ",34,"ل",1,0],["لا تُبطلنَّ صنيعةً أوليتها","إن الصنيعةَ حقُّها التتميمُ",35,"م",1,0],["لا تبالي من ناكَ أمَّك جهراً","مِنْ عدُوٍّ ومن وليٍّ حَميم",36,"م",1,0],["لا تَبِيتَنَّ آمِناً من ظَنينٍ","واحترسْ منه أوْ تليك أُمونه",37,"ن",2,0],["لا تبعدَنَّ وإن نزلتَ بمنزل","أمسى بعيداً عن أَوُدِّكَ شاطنا",38,"ن",2,0],["لا تُبصِرُ العَينُ الرِياض وَحَليَها","إِلّا عَلى ضَوءِ الصَباحِ الهادي",39,"د",2,0],["لا تُبالي بِبَناتِ الدَهرِ إِن","أَقبَلَ الدَهرُ بِها أَو أَدبَرا",40,"ر",2,0],["لا تَبتَغوا شُكرَ الأَنامِ وَأَجرَهُم","عَفوُ الإِلَهِ هُوَ الثَناءُ الأَجزَلُ",41,"ل",1,0],["لا تُبالي القَيظَ يَشوي حَرُّهُ","لا وَلا تَحذَرُ بَردَ الشَمأَلِ",42,"ل",1,0],["لا تُبصِرينَ بِهِ الغَدير","وَلا يَلَذُّ لَكِ الحَرير",43,"ر",1,0],["لا تبتغوا من غير انفسكم","لانفسكم ظهارا",44,"ر",2,0],["لا تبنِ يا منيتي عليه","فما لما قاله أساس",45,"س",1,0],["لا تَبذُلوا بُرَدَ النَبِيِّ لِعاجِزٍ","عُزُلٍ يُدافِعُ دونَهُ بِالراحِ",46,"ح",1,0],["لا تَبعُدَنَّ فَهَذِهِ","آمالُ قَومِكَ في اِقتِرابِ",47,"ب",1,0],["لا تَبْعَدُوا يا بَني النّبِيِّ على","أَنْ قَد بَعُدْتُمْ والدُّهْرُ ذُو نُوَبِ",48,"ب",1,0],["لاتَبرَحُ الدَهرَ لَنا مَعقِلاً","يَأمَنُ في أَكنافِهِ اللاجي",49,"ج",2,0],["لا تَبعَثُ العودَ تَستَعينُ بِهِ","وَلا تَبيتُ الأَوتارُ تَخفُرُها",50,"ر",3,0],["لا تَبعُدَنَّ وَكَيفَ يَقرُبُ نازِلٌ","بِالغَيبِ تَفنى دونَهُ الأَعوامُ",51,"م",1,0],["لا تَبعَثَنَّ لَها الهُمومَ قَواصِداً","بَعدَ الهُمومِ فَإِنَّها أَعوانُها",52,"ن",3,0],["لاتُبعِدَنّي مِنكَ نِسبَةُ مَن هُمُ","خُلَفاءُ قَومِكَ مِن بَني شَيبانِ",53,"ن",1,0],["لا تبحثوا عنه هنا بصدري","تركته يجري مع الغروب",54,"ب",1,0],["لا تَبخَلَنَّ بدنيا وَهيَ مُقبِلَةٌ","فَلَن يَنقِّصَها التَبذيرِ وَالسَرَفُ",55,"ف",1,1],["لا تَبدَأَنَّ بِمَنطِقٍ في مَجلِسٍ","قَبلَ السُؤالِ فَإِنَّ ذاكَ يَشنعُ",56,"ع",1,0],["لا تَبتَغي مَهراً سِوى إِجرائِها","مِن قُربِ حَضرَتِكُم عَلى عاداتِها",57,"ت",3,0],["لا تُبقِ أَحزابَ العُداةِ وَاِعتَمِد","ما اِعتَمَدَ النَبِيُّ في أَحزابِهِ",58,"ب",2,0],["لا تَبذُلِ الحِلَ لِغَيرِ شاكِرٍ","فَإِنَّهُ يُفضي إِلى إِعجابِهِ",58,"ب",2,0],["لا تبكها ذَهَبَت ومات هواها","في القلبِ متسعٌ غَداً لِسواها",59,"ا",3,1],["لا تبح مائدةَ النورِ لهم","لا تبحهَا لسوادٍ معتكر",60,"ر",1,0],["لا تُبالي بَوارِقَ البيضِ وَالسُم","رِ وَلَكِن بالَيتَ لَمعَ البُروقِ",61,"ق",1,0],["لا تَبعَدَن أَبَداً وَلا تَبعُد فَما","أَخلاقُكَ الخُضرُ الرُبا بِأَباعِدِ",62,"د",1,0],["لا تبسطَنَّ لتقليدِ القضاءِ يداً","أيرتضي رتبةَ التقليدِ مجتهدُ",63,"د",1,0],["لَأَتبَعتُ طِيَّتَها إِنَّني","أَرى قُربَها العَجَبَ العاجِبا",64,"ب",2,0],["لا تَبخَلَنَّ بِنَفحَةٍ","وَثَراكَ مِن مِسكٍ فَتيقِ",65,"ق",1,0],["لا تَبخلوا بِالمالِ فهوَ لِمجدِكم","عِند البِنايةِ حائطٌ أَو سورُ",66,"ر",1,0],["لا تَبتئِسْ بالجُرحِ أفرط شرُّه","وطغَى أَذاهُ فكلّ جُرْحٍ يُوسى",67,"س",2,0],["لا تَبلُغُ النَفسُ ما تَرضى نَوازِعُها","حَتّى تَكونَ المَنايا مِن مَراضيها",68,"ي",3,0],["لا تَبخلوا يا قَومُ إِن كُنتم ذَوي","كَرَمٍ فَما الدُنيا سِوى كُرمائِها",69,"ا",3,0],["لا تبتئسْ بجرابِ التمرِ يحملُهُ","أولو الحميَّةِ من صَحْبٍ وإخوانِ",70,"ن",1,0],["لا تبالي بألْفِ خَطْبٍ عراها","نفسُ حُرَّ مفجوعَةٌ بحماها",71,"ا",3,1],["لا تَبتئس بِالظُلم إن","ن غَداً لَناظرهِ قَريب",72,"ب",1,0],["لا تَبعَدَنَّ فَكُلُّ حَيٍّ هالِكٌ","لا بُدَّ مِن تَلَفٍ فَبِن بِفَلاحِ",73,"ح",1,0],["لا تَبتَغي مِنّي الَّتي لا أَبتَغي","إِن كُنتَ مَشغولاً بِشَأني فَاِفرَغِ",74,"غ",1,0],["لا تَبكِ لِلظاعِنينَ وَالعيسِ","وَمَنزِلٍ ظَلَّ غَيرَ مَأنوسِ",75,"س",1,1],["لا تَبعَدَنَّ عِصابَةٌ شيعِيّةٌ","ظَفِرُوا ببغيَتِهمْ منَ الرّحمَنِ",76,"ن",1,0],["لا تَبكِ بَعدَ تَفَرُّقِ الخُلَطاءِ","وَاِكسِر بِمائِكَ سَورَةَ الصَهباءِ",77,"ا",2,1],["لا تَبكِ مَيتاً حَلَّ في حُفرَةٍ","وَاِبكِ قَتيلاً لَكَ بِالبابِ",78,"ب",1,0],["لا تَبعَدَنَّ أَبا أُسا","مَةَ فَالمَنِيَّةُ واجِبَه",79,"ب",2,0],["لا تَبكِ لَيلى وَلا تَطرَب إِلى هِندِ","وَاِشرَب عَلى الوَردِ مِن حَمراءَ كَالوَردِ",80,"د",1,1],["لا تَبكِ رَسماً بِجانِبِ السَنَدِ","وَلا تَجُد بِالدُموعِ لِلجَرَدِ",81,"د",1,1],["لا تَبكِ رَبعاً عَفا بِذي سَلَمِ","وَبَزَّ آثارَهُ يَدُ القِدَمِ",82,"م",1,1],["لا تَبكِيَنَّ عَلى رَسمٍ وَلا طَلَلٍ","وَاِقصِد عُقاراً كَعَينِ الديكِ نَدماني",83,"ن",2,0],["لا تَبكِ لِلذاهِبينَ في الظُعُنِ","وَلا تَقِف بِالمَطِيِّ في الدِمَنِ",84,"ن",1,1],["لا تبكِ رسماً ولا تدمع على طلَلِ","ولا تسلّم على خيفٍ ولا قُلَلِ",85,"ل",1,1],["لا تبكينّ لهالكٍ","لا تحنونّ على يتيم",86,"م",1,0],["لا تُبالي إِذا أصَبتَ مِنَ الخُم","رِعَتيقاً أَن لا تَكونَ عَتيقا",87,"ق",2,0],["لا تَبعَدَنَّ وَأَينَ مَن فارَقتُهُ","أَمسى بِمِثلِ سَبيلِها لَم يَبعَدِ",88,"د",1,0],["لا تَبيتُ الكِئاسُ مِنهُ إِذا ما","قابَلَتهُ الكِئاسُ