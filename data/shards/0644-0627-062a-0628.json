47501",""],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30440","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42534","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55013","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55034","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43860","البسيط"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116991","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[106,"إلى القائد المظفر","https://www.poetsgate.com/ViewPoem.aspx?id=179595",""],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[106,"رسل الثقافة","https://www.poetsgate.com/ViewPoem.aspx?id=179609",""],[106,"تجار العقائد","https://www.poetsgate.com/ViewPoem.aspx?id=179441",""],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[106,"تحية وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=179292",""],[50,"لا تَبْغ شَرَّ امْرىء شَرًّا من الدَّاء","https://www.poetsgate.com/ViewPoem.aspx?id=19924",""],[96,"سارية الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=17505",""],[90,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[90,"دمعَة على صديق","https://www.poetsgate.com/ViewPoem.aspx?id=179103",""],[46,"لا تَبدَءوني بالعداوةِ منْكمُ","https://www.poetsgate.com/ViewPoem.aspx?id=18587",""],[94,"وذرني أحيّي الصباحا","https://www.poetsgate.com/ViewPoem.aspx?id=15649",""],[51,"خلياني عند اصطكاك الخصوم","https://www.poetsgate.com/ViewPoem.aspx?id=25876",""],[31,"وما ظبية ٌ من ظباءِ الاراكِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18792&r=&rc=55",""]],"verses":[["لا تَبعَدَنَّ مَطايانا الَّتي حَمَلَت","تِلكَ الظَعائِنَ مُرخاةً لَها الجُدُلُ",0,"ل",1,0],["لا تُبصِرُ الدَهرَ بَعدَ اليَومِ مُبتَسِماً","إِنَّ اللَيالِيَ أَنسَت بَعدَهُ الضَحِكا",1,"ك",2,0],["لا تَبرِ عوداً أَنتَ رَيشَتَهُ","حاشا لِباني المَجدِ أَن يَنقُضا",2,"ض",2,0],["لا تَبعَدَنَّ أَمانِيَّ الَّتي نَشَزَت","عَلى الزَمانِ بِأَيدي الأَينُقِ الصُعُرِ",3,"ر",1,0],["لا تَبعَدَنَّ وَأَينَ قُربُكَ بَعدَها","إِنَّ المَنايا غايَةُ الأَبعادِ",4,"د",1,0],["لاَ تُبدِ هَوْنَاً فِي الشَّدَائِدِ إِنْ عَرَتْ","فَبِقَدْرِ مَا تُبْدِيهِ قَدْرُكَ يحملُ",5,"ل",1,0],["لا تُبدِيَنَّ نَميمَةً حُدِّثتَها","وَتَحَفَّظَنَّ مِن الَّذي أَنباكَها",6,"ك",3,0],["لا تُبالي زُلزِلَت مِن تَحتِها","أَم عَلَيها النَجمُ بِالنَجمِ اِصطَدَم",7,"م",1,0],["لا تُبالي لَعِبَ القَومُ بِها","أَم بِها صَرفُ اللَيالي لَعِبا",8,"ب",2,0],["لا تُبالي أَرُعتَ بِالبَينِ أَحبا","باً وَأَسرَفتَ في أَذي المُستَهامِ",9,"م",1,0],["لا تَبعُدَن تُربَةٌ ضَمَّت شَمائِلَهُ","وَلا عَدا جانِبَيها العارِضُ الهَطِلُ",10,"ل",1,0],["لا تَبْعَدَنَّ فَإِنَّ فِي أَكْبَادِنَا","لَكَ جَانِباً يَنْبُو عَنِ السُّلْوَانِ",11,"ن",1,0],["لا تُبْقِ فِي نَفْسٍ بِهِ اضَّطَلَعَتْ","مِنْ حَاجَةٍ تَعْدُلْ وَتَسْتَقِمِ",12,"م",1,0],["لا تَبِنْ أَيُّهَا المُحَيَّا الْوَسِيمُ","لا تَهُنْ أَيُّهَا الْفُؤَادُ الكَرِيمُ",13,"م",1,1],["لا تبك أربعهم ولا الأطلالا","واربأ بحبّك أن يكون خبالا",14,"ل",2,1],["لا تَبعَدَنَّ وَكُلُّ حَيٍّ هالِكٌ","وَلِكُلِّ مَصرَعِ هالِكٍ مِقدارُ",15,"ر",1,0],["لاتَبخَلَنَّ عَلى قَومٍ إِذا قُتِلوا","أَثنى عَلَيكَ بَنو الهَيجاءِ دونَهُمُ",16,"م",1,0],["لاتَبيعيني بِرُخصٍ","إِنَّ في مِثلي يُغالى",17,"ل",2,0],["لا تبعدَنَّ فكم أبقيت منقبةً","كالغيث ولَّى وأبقى فضل آثار",18,"ر",1,0],["لا تبتغي كلماتي اليوم في غزلٍ","فهنَّ لابن عليّ في الثنا شِيَع",19,"ع",1,0],["لا تبغِ منزلَ فضلٍ بعد منزلهِ","من حلّ طيبةَ لم يحتج إلى النجف",20,"ف",1,0],["لا تبعدنَّ فلا لاقيت مغربةً","ولا سلكت طريقاً ليس مسلوكا",21,"ك",2,0],["لا تَبْخَلَنَّ على منْ لستَ كافِيَهُ","بأنْ تقولَ تَزحْزَحْ غير مطرودِ",22,"د",1,0],["لا تَبْعَدَنَّ أبا العباس من مَلِكٍ","وإنْ نأيْتَ وإن أصْبحتَ في البَعَدِ",23,"د",1,0],["لا تُباعده من أمامك ما اسطَعْ","تَ فليس الصواب في إبعادِهْ",24,"د",2,0],["لا تَبْعدنَّ من الذي تُكْنَى به","وهو الذي تفسيرُه الإبعادُ",25,"د",1,0],["لا تبتروا عندي وعند أبي يداً","بيضاء ما جُحدَتْ وليست تجحدُ",26,"د",1,0],["لا تُبرئوا داءَ الحسود بجفْوةٍ","مسَّتْ أخاً لَكُمُ عليكمْ يُحسَدُ",26,"د",1,0],["لا تَبعَدنَّ قصائدٌ ذهبتْ سُدَى","جَارتْ بها الهفواتُ عن سَنَنِ الهُدى",27,"د",2,1],["لا تبخلنَّ على امرىء خيَّبْتَهُ","بجواب مسألةٍ كبُخلك بالجَدا",27,"د",2,0],["لا تبنينَّ بنيةً قوَّادةً","تُزْني بناتِ أبي البنات بجارِهِ",28,"ر",2,0],["لا تبعُدَن من صاحبي","ن نَفيتما ضعة وَفقرا",29,"ر",2,0],["لا تُبْدِلنّي بما اقتنيتُ من ال","آمال هَجسَ المخاوف الهُجُس",30,"س",1,0],["لا تبكينّ على قتادة خارطٍ","وابكِ الدماء على بنانِ الخارط",31,"ط",1,0],["لا تبلغا الدهر أقصى إربة لكما","فاستبدلا لكما من آخر طرفا",32,"ف",2,0],["لا تبعدنّ كريمةٌ أودعْتَها","صِهراً من الأصهارِ لا يُخزِيكا",33,"ك",2,0],["لا تبخلن بمالٍ لستَ مالكَه","فلا يفُوتَنك تبخيلٌ وتضليلُ",34,"ل",1,0],["لا تُبطلنَّ صنيعةً أوليتها","إن الصنيعةَ حقُّها التتميمُ",35,"م",1,0],["لا تبالي من ناكَ أمَّك جهراً","مِنْ عدُوٍّ ومن وليٍّ حَميم",36,"م",1,0],["لا تَبِيتَنَّ آمِناً من ظَنينٍ","واحترسْ منه أوْ تليك أُمونه",37,"ن",2,0],["لا تبعدَنَّ وإن نزلتَ بمنزل","أمسى بعيداً عن أَوُدِّكَ شاطنا",38,"ن",2,0],["لا تُبصِرُ العَينُ الرِياض وَحَليَها","إِلّا عَلى ضَوءِ الصَباحِ الهادي",39,"ي",1,0],["لا تُبالي بِبَناتِ الدَهرِ إِن","أَقبَلَ الدَهرُ بِها أَو أَدبَرا",40,"ر",2,0],["لا تَبتَغوا شُكرَ الأَنامِ وَأَجرَهُم","عَفوُ الإِلَهِ هُوَ الثَناءُ الأَجزَلُ",41,"ل",1,0],["لا تُبالي القَيظَ يَشوي حَرُّهُ","لا وَلا تَحذَرُ بَردَ الشَمأَلِ",42,"ل",1,0],["لا تُبصِرينَ بِهِ الغَدير","وَلا يَلَذُّ لَكِ الحَرير",43,"ر",1,0],["لا تبتغوا من غير انفسكم","لانفسكم ظهارا",44,"ر",2,0],["لا تبنِ يا منيتي عليه","فما لما قاله أساس",45,"س",1,0],["لا تَبذُلوا بُرَدَ النَبِيِّ لِعاجِزٍ","عُزُلٍ يُدافِعُ دونَهُ بِالراحِ",46,"ح",1,0],["لا تَبعُدَنَّ فَهَذِهِ","آمالُ قَومِكَ في اِقتِرابِ",47,"ب",1,0],["لا تَبْعَدُوا يا بَني النّبِيِّ على","أَنْ قَد بَعُدْتُمْ والدُّهْرُ ذُو نُوَبِ",48,"ب",1,0],["لاتَبرَحُ الدَهرَ لَنا مَعقِلاً","يَأمَنُ في أَكنافِهِ اللاجي",49,"ج",2,0],["لا تَبعَثُ العودَ تَستَعينُ بِهِ","وَلا تَبيتُ الأَوتارُ تَخفُرُها",50,"ر",3,0],["لا تَبعُدَنَّ وَكَيفَ يَقرُبُ نازِلٌ","بِالغَيبِ تَفنى دونَهُ الأَعوامُ",51,"م",1,0],["لا تَبعَثَنَّ لَها الهُمومَ قَواصِداً","بَعدَ الهُمومِ فَإِنَّها أَعوانُها",52,"ن",3,0],["لاتُبعِدَنّي مِنكَ نِسبَةُ مَن هُمُ","خُلَفاءُ قَومِكَ مِن بَني شَيبانِ",53,"ن",1,0],["لا تبحثوا عنه هنا بصدري","تركته يجري مع الغروب",54,"ب",1,0],["لا تَبخَلَنَّ بدنيا وَهيَ مُقبِلَةٌ","فَلَن يَنقِّصَها التَبذيرِ وَالسَرَفُ",55,"ف",1,1],["لا تَبدَأَنَّ بِمَنطِقٍ في مَجلِسٍ","قَبلَ السُؤالِ فَإِنَّ ذاكَ يَشنعُ",56,"ع",1,0],["لا تَبتَغي مَهراً سِوى إِجرائِها","مِن قُربِ حَضرَتِكُم عَلى عاداتِها",57,"ت",3,0],["لا تُبقِ أَحزابَ العُداةِ وَاِعتَمِد","ما اِعتَمَدَ النَبِيُّ في أَحزابِهِ",58,"ب",2,0],["لا تَبذُلِ الحِلَ لِغَيرِ شاكِرٍ","فَإِنَّهُ يُفضي إِلى إِعجابِهِ",58,"ب",2,0],["لا تبكها ذَهَبَت ومات هواها","في القلبِ متسعٌ غَداً لِسواها",59,"ا",3,1],["لا تبح مائدةَ النورِ لهم","لا تبحهَا لسوادٍ معتكر",60,"ر",1,0],["لا تُبالي بَوارِقَ البيضِ وَالسُم","رِ وَلَكِن بالَيتَ لَمعَ البُروقِ",61,"ق",1,0],["لا تَبعَدَن أَبَداً وَلا تَبعُد فَما","أَخلاقُكَ الخُضرُ الرُبا بِأَباعِدِ",62,"د",1,0],["لا تبسطَنَّ لتقليدِ القضاءِ يداً","أيرتضي رتبةَ التقليدِ مجتهدُ",63,"د",1,0],["لَأَتبَعتُ طِيَّتَها إِنَّني","أَرى قُربَها العَجَبَ العاجِبا",64,"ب",2,0],["لا تَبخَلَنَّ بِنَفحَةٍ","وَثَراكَ مِن مِسكٍ فَتيقِ",65,"ق",1,0],["لا تَبخلوا بِالمالِ فهوَ لِمجدِكم","عِند البِنايةِ حائطٌ أَو سورُ",66,"ر",1,0],["لا تَبتئِسْ بالجُرحِ أفرط شرُّه","وطغَى أَذاهُ فكلّ جُرْحٍ يُوسى",67,"س",2,0],["لا تَبلُغُ النَفسُ ما تَرضى نَوازِعُها","حَتّى تَكونَ المَنايا مِن مَراضيها",68,"ي",3,0],["لا تَبخلوا يا قَومُ إِن كُنتم ذَوي","كَرَمٍ فَما الدُنيا سِوى كُرمائِها",69,"ا",3,0],["لا تبتئسْ بجرابِ التمرِ يحملُهُ","أولو الحميَّةِ من صَحْبٍ وإخوانِ",70,"ن",1,0],["لا تبالي بألْفِ خَطْبٍ عراها","نفسُ حُرَّ مفجوعَةٌ بحماها",71,"ا",3,1],["لا تَبتئس بِالظُلم إن","ن غَداً لَناظرهِ قَريب",72,"ب",1,0],["لا تَبعَدَنَّ فَكُلُّ حَيٍّ هالِكٌ","لا بُدَّ مِن تَلَفٍ فَبِن بِفَلاحِ",73,"ح",1,0],["لا تَبتَغي مِنّي الَّتي لا أَبتَغي","إِن كُنتَ مَشغولاً بِشَأني فَاِفرَغِ",74,"غ",1,0],["لا تَبكِ لِلظاعِنينَ وَالعيسِ","وَمَنزِلٍ ظَلَّ غَيرَ مَأنوسِ",75,"س",1,1],["لا تَبعَدَنَّ عِصابَةٌ شيعِيّةٌ","ظَفِرُوا ببغيَتِهمْ منَ الرّحمَنِ",76,"ن",1,0],["لا تَبكِ بَعدَ تَفَرُّقِ الخُلَطاءِ","وَاِكسِر بِمائِكَ سَورَةَ الصَهباءِ",77,"ا",2,1],["لا تَبكِ مَيتاً حَلَّ في حُفرَةٍ","وَاِبكِ قَتيلاً لَكَ بِالبابِ",78,"ب",1,0],["لا تَبعَدَنَّ أَبا أُسا","مَةَ فَالمَنِيَّةُ واجِبَه",79,"ب",2,0],["لا تَبكِ لَيلى وَلا تَطرَب إِلى هِندِ","وَاِشرَب عَلى الوَردِ مِن حَمراءَ كَالوَردِ",80,"د",1,1],["لا تَبكِ رَسماً بِجانِبِ السَنَدِ","وَلا تَجُد بِالدُموعِ لِلجَرَدِ",81,"د",1,1],["لا تَبكِ رَبعاً عَفا بِذي سَلَمِ","وَبَزَّ آثارَهُ يَدُ القِدَمِ",82,"م",1,1],["لا تَبكِيَنَّ عَلى رَسمٍ وَلا طَلَلٍ","وَاِقصِد عُقاراً كَعَينِ الديكِ نَدماني",83,"ن",2,0],["لا تَبكِ لِلذاهِبينَ في الظُعُنِ","وَلا تَقِف بِالمَطِيِّ في الدِمَنِ",84,"ن",1,1],["لا تبكِ رسماً ولا تدمع على طلَلِ","ولا تسلّم على خيفٍ ولا قُلَلِ",85,"ل",1,1],["لا تبكينّ لهالكٍ","لا تحنونّ على يتيم",86,"م",1,0],["لا تُبالي إِذا أصَبتَ مِنَ الخُم","رِعَتيقاً أَن لا تَكونَ عَتيقا",87,"ق",2,0],["لا تَبعَدَنَّ وَأَينَ مَن فارَقتُهُ","أَمسى بِمِثلِ سَبيلِها لَم يَبعَدِ",88,"د",1,0],["لا تَبيتُ الكِئاسُ مِنهُ إِذا ما","قابَلَتهُ الكِئاسُ إِلّا سُجودا",89,"د",2,0],["لا تَبغِ شَرَّ اِمرِئٍ شَرّاً مِنَ الداءِ","وَاِقدَح بِحِلمٍ وَلا تَقدَح بِشَحناءِ",90,"ا",2,1],["لا تَبدَأَوني بِالعَداوَةِ مِنكُمُ","فَمَسيحُكُم عِندي نَظيرُ مُحَمَّدِ",91,"د",1,1],["لا تَبخَلِنَّ عَلى خَليلِكِ إِن بَغى","خِلّاً سِواكِ فَتُبخَلي وَتُغاري",92,"ر",2,0],["لا تَبكِنا سَفَهاً وَلا ساداتِنا","وَاِجعَل بُكاءَكَ لِاِبنِ أُمِّ قَطامِ",93,"م",1,0],["لا تَبكِ ليلى ولا ميَّه","ولا تَندُبَنْ راكباً نِيَّه",94,"ي",2,1],["لا تبخسوهن حقا","فَلَيسَ في البخس عدل",95,"ل",1,0],["لا تبالي بلَلَ الثوبِ ولا","لفحةَ البردِ الشفيفِ الثائرِ",96,"ر",1,0],["لا تبك للميت فكم","مات كريم وهلك",97,"ك",1,0],["لا تَبْكِيَنَّ مِن اللَّيالي أَنَّها","حَرَمَتْكَ نَغْبَةَ شارِب مِن مَشْرَبِ",98,"ب",1,1],["لا تَبْهَتِ الشَّيْطَانَ فِي فِعْلِهِ","فَقَدْ كَفَى أَنَّكَ مِنْ حِزْبِهِ",99,"ب",2,1],["لاَ تَبْعُدِي يَا مَنْ سَمَوْتِ إِلى العُلَى","وَنَزَعْتِ عَنْ دُنْيَاكِ أَشْرَفَ مَنْزَعِ",100,"ع",1,0],["لا تبَالِي دُونَ مَنْ تعْبُدُهُ","جُهْدَ ما تُمْنى بِهِ خسْفاً وَعُسْرَا",101,"ر",2,0],["لاَ تَبْتَغِينَ جَزَاءَ مَا أَسْلَفْتِهِ","إِلاَّ مِنَ اللهِ الكَرِيمِ المُخْلَفِ",102,"ف",1,0],["لا تُبعِدَنّي غَداً وَصِلني","بِقُربِ عَبدَيكَ يا غَنِيُّ",103,"ي",1,1],["لا تبِع الدين بدُنيا كما","يفعَلُ ضلّالُ الرهابين",104,"ن",1,0],["لا تبتغوا غيرَ إتقانِ وتجربةٍ","فقيمةُ الناسِ تجريبٌ وإتقانُ",105,"ن",1,0],["لاَ تَبْكِ إنْ عَزَّ السبيلُ","فَإِنَّ نَوْحَكَ غَيْرُ مُجْدِي",106,"د",2,0],["لا تُبالِ الْقُيُودَ مِنْ فاعِلاَتُنْ","أَنْتَ أَحْرَى بِأَنْ تُذِلَّ الْقُيُودَا",107,"د",2,0],["لا تبكَينَّ على الدُّستور شِرذِمةٌ","جرى على وجنتيها دمعُها كَذِبا",108,"ب",2,0],["لا تبن بامرأة، وتهدم منزلاً","خيرُ الزواج تزاوج الأنداد",109,"د",1,0],["لا تُبْتَنَى الدُّولاتُ حولَ موائدٍ","كموائد النَّدمانِ حولَ عُقَار",110,"ر",1,0],["لا تبعثوا من لحده","هذا الزمانَ المظلما",111,"م",2,0],["لا تبذلوا العلم كل جهودكم","العلم ناحيةٌ، وَثَمَّ نواحِ",112,"ح",1,0],["لا تَبْسُطوا الأَعذارَ؛ ما","في الناسِ للمغلوبِ عاذر",113,"ر",1,0],["لا تَبْسُطوا للغَرْب، يا قومي، يَدًا","للغَرْب طرفٌ في السياسة أحْوَل",114,"ل",1,0],["لا تَبْغ شَرَّ امْرىء شَرًّا من الدَّاء","وَاقْدَحْ بِحِلْمٍ وَلاَ تَقْدَحْ بِشَحْنَاء",115,"ا",2,1],["لا تبالي بلل الثّوب ولا","لفحة الرد الشّفيف الثّائر",116,"ر",1,0],["لا تُبقِ دابِرَ أقوامٍ وتَرْتَهم","فَهم إذا وَجدوها فُرصَةً ثأروا",117,"ر",3,0],["لاتبخَسوا قَدْرَ الدموع فانها","دفعُ الهموم تَفيضُ من يَنْبوع",118,"ع",1,0],["لا تَبدَءوني بالعداوةِ منْكمُ","، فمسيحُكمْ، عندي، نظيرُ محمّدِ",119,"د",1,1],["لا تبادر بها وقد نصل اللّيل","وذرني حتّى أحيّي الصباحا",120,"ح",2,0],["لاتبالي من ... أمَّك جهراً","رب رزء كالمغنم المغنوم",121,"م",1,0],["لأَتْبَعْتُ طِيَّتَها إنَّ