{"poems":[[64,"بالنار صنعتها وفيها","https://www.aldiwan.net/poem52236.html","مجزوء الكامل"],[51,"هل على نفسه امرؤ محزون","https://www.aldiwan.net/poem63134.html","الخفيف"],[128,"إن الزمان ولا أقول زماني","https://www.aldiwan.net/poem23705.html","الكامل"],[259,"أمل","https://www.aldiwan.net/poem24947.html","مجزوء الرمل"],[325,"يا كاتبا نظم الجمان بكتبه","https://www.aldiwan.net/poem67163.html","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79998","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77757","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69368","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123484","الرمل"],[4755,"الغُوْلُ, والعَنْقاءُ, والتِّنِّينُ","https://www.poetsgate.com/ViewPoem.aspx?id=184098",""],[4797,"دكتور العيون","https://www.poetsgate.com/ViewPoem.aspx?id=29433",""],[4852,"أنبائيه","https://www.poetsgate.com/ViewPoem.aspx?id=214301",""],[5190,"انشطار","https://www.poetsgate.com/ViewPoem.aspx?id=160934",""]],"verses":[["وإلى قرارتها يكو","ن لدى السبوك معادُها",0,"د",3,0],["وَاليَقينُ الشِفاءُ مِن كُلِ هَمٍّ","ما يُثيرُ الهُمومَ إِلّا الظُنونُ",1,"ن",1,0],["وإلى قريضي كيف أصبح تافهاً","وإلى بليغ القول كيف عصاني",2,"ن",2,0],["وإلى قصر المُنى، اسْ","تَقْدميني، واسجُنيني",3,"ن",2,0],["وَإِلَيَّ قالَ مُؤَكِّداً أَرخَ وَقُل","عامَ لِباستاوَروسٍ يا بَشيرَ يَهي",4,"ي",1,0],["وإليَّ قد طلعت ذرًى من شاهقٍ","لا ترتقى هضباته بصعود",5,"د",1,0],["وَإِلى قلوب العاشقين فأقبلي","بقميص يوسف يَستَفيق من العنا",6,"ن",2,0],["وَأَليَقُ ما كانَ السَماحُ بِأَهلِهِ","إِذا كانَ طَبعاً فيهِمُ لا تَطَبُّعا",7,"ع",2,0],["والى قاب دنا مخترقا","وحده قبل التدلى حجبا",8,"ب",2,0],["وإلى قُرُونِ الفَحمِ نَحوَ ظَلَامِهِم","قَذَفُوكَ كَي لا يَنفَدَ البنزينُ",9,"ن",1,0],["والى قنصت اثبت مع اللي يثبتون","واشوف طيري كل ما اوميت ودعيت",10,"ت",1,0],["وإلى قميصٍ في الغيابِ","بمشتكى ... يعقوبيهْ",11,"ي",2,0],["وإِلَى قَلبٍ شَبِيهٍ بِالَّذِي","تَحتَ أَضلاعِي .. سَرِيعاً .. دَخَلا",12,"ل",2,0]]}