{"poems":[[55,"سرى طيف فوز آخر الليل بالطف","https://www.aldiwan.net/poem26241.html","الطويل"],[73,"ما جال بعدك لحظي في سنا القمر","https://www.aldiwan.net/poem11928.html","البسيط"],[83,"بشرى كما وضح الزمان وأجمل","https://www.aldiwan.net/poem54256.html","الكامل"],[37,"لاية خصلتين دعوتمانا","https://www.aldiwan.net/poem7440.html","الوافر"],[72,"هن الوجوه الناضره","https://www.aldiwan.net/poem18696.html","مجزوء الكامل"],[51,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[51,"قالوا هجاك أبو المزاق قلت لهم","https://www.aldiwan.net/poem65433.html","البسيط"],[89,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[85,"فيم ابتسامك للدنيا وغايتها","https://www.aldiwan.net/poem7530.html","البسيط"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[45,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[45,"من عذيري من الظباء الغيد","https://www.aldiwan.net/poem63503.html","الخفيف"],[45,"شط من ساكن الغوير مزاره","https://www.aldiwan.net/poem63580.html","الخفيف"],[45,"إذا ما حصلت عليا قريش","https://www.aldiwan.net/poem63627.html","الوافر"],[45,"لأية حال أعلن الوجد كاتمه","https://www.aldiwan.net/poem65658.html","الطويل"],[28,"فاسأل هوازن إن عند سراتهم","https://www.aldiwan.net/poem5242.html","الكامل"],[49,"لا يهنأ الأعداء عزل ابن هاشم","https://www.aldiwan.net/poem64273.html","الطويل"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[66,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[97,"أين شط الرجاء","https://www.aldiwan.net/poem25074.html","مجزوء الخفيف"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[44,"أقرم بكر تباهي أيها الحفض","https://www.aldiwan.net/poem30477.html","البسيط"],[44,"أجفان خوط البانة الأملود","https://www.aldiwan.net/poem30531.html","الكامل"],[105,"لك يا شهيد الحق قام المأتم","https://www.aldiwan.net/poem42059.html","الكامل"],[105,"صاح الحمى ببني الهيجاء فاعتزموا","https://www.aldiwan.net/poem42113.html","البسيط"],[105,"أتنام عينك والعيون سهاد","https://www.aldiwan.net/poem42119.html","الوافر"],[105,"أرى بمصر ولاة لا خلاق لهم","https://www.aldiwan.net/poem43133.html","البسيط"],[75,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[48,"لا تئل العصم في الهضاب ولا","https://www.aldiwan.net/poem64416.html","المنسرح"],[50,"حييا صاحبي أم العلاء","https://www.aldiwan.net/poem64891.html","الخفيف"],[7,"ماذا رزئنا به من حية ذكر","https://www.aldiwan.net/poem1974.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39665","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42694","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42592","البسيط"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12782","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[106,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[100,"يوم العلم","https://www.poetsgate.com/ViewPoem.aspx?id=50183",""],[7,"ماذا رُزِئْنا بهِ من حَيّة ٍ ذكَرٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=17586",""],[80,"هل أقالَ الحِمامُ عثرة حيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=3730",""],[94,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[96,"أندونيسيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66469&r=&rc=145",""],[142,"لا يهن عندك اختلال بجسمى","https://www.aldiwan.net/poem58322.html","الخفيف"],[142,"ليت الهوى يصرفه الراقى","https://www.aldiwan.net/poem58422.html","السريع"],[160,"مقامي تحت ظل الذل عار","https://www.aldiwan.net/poem58760.html","الوافر"],[160,"لو كنت تعلم ما بأهل زبيد","https://www.aldiwan.net/poem58886.html","الكامل"],[186,"بدأت بالفضل في شعر ضرائبه","https://www.aldiwan.net/poem43298.html","البسيط"],[186,"وقالوا نريد أخا فطنة","https://www.aldiwan.net/poem43829.html","المتقارب"],[210,"قف قليلاً يا حادي الركب","https://www.aldiwan.net/poem13301.html","الخفيف"],[229,"صبر المحب أحق بالإحجام","https://www.aldiwan.net/poem50808.html","الكامل"],[270,"أرى حبي شرارا مستطيرا","https://www.aldiwan.net/poem35589.html","الوافر"],[285,"سر بالأمان عبيد الله ممتطيا","https://www.aldiwan.net/poem39342.html","البسيط"],[305,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[328,"قبل أن يبصر الظلام الضياء","https://www.aldiwan.net/poem54981.html","الخفيف"],[349,"ما الحكم في الناس إلا","https://www.aldiwan.net/poem15886.html","المجتث"],[364,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[364,"هل في عتاب الحادثات غناء","https://www.aldiwan.net/poem61013.html","الكامل"],[377,"لا يهمل اللَه إنسانا بتجربة","https://www.aldiwan.net/poem59328.html","الطويل"],[402,"كيف يرضيك على الضيم المقام","https://www.aldiwan.net/poem46920.html","الرمل"],[406,"الآن قد صح لي حقا بلا كذب","https://www.aldiwan.net/poem50209.html","البسيط"],[432,"لأية حال فيض دمعك هتان","https://www.aldiwan.net/poem12754.html","الطويل"],[437,"منازلهم بين اللوى فالدكادك","https://www.aldiwan.net/poem2528.html","الطويل"],[439,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[443,"اشرح الصدر للمحاسن طرا","https://www.aldiwan.net/poem55920.html","عموديه"],[458,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[458,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[458,"لأية لبسة خلع الخلاعه","https://www.aldiwan.net/poem56137.html","الكامل"],[458,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[468,"أيا من تناقص منه الحياء","https://www.aldiwan.net/poem60519.html","المتقارب"],[485,"إني أتتني لسان لا أسر بها","https://www.aldiwan.net/poem1121.html",""],[515,"طرقتها والليل وحف الجناح","https://www.aldiwan.net/poem12054.html","السريع"],[515,"من كان لا يعشق الأجياد والحدقا","https://www.aldiwan.net/poem12182.html","البسيط"],[562,"ما يرتجيه المرء من مولوده","https://www.aldiwan.net/poem52771.html","الكامل"],[564,"لا تبك تُونس يا ياسين أو فدسا","https://www.aldiwan.net/poem857.html",""],[567,"سيدي أنت مم شكواك قل لي","https://www.aldiwan.net/poem69591.html","الخفيف"],[587,"سبحان من كون الأشياء تكوينا","https://www.aldiwan.net/poem11513.html","عموديه"],[587,"يا تاركاً لمراضي الله أوطاناً","https://www.aldiwan.net/poem11514.html","عموديه"]],"verses":[["لِأَيَّةِ حالٍ يَستَحِلُّ الهَوى دَمي","لِأَعذُرَهُ أُفٍ لِهَذا الهَوى أُفِّ",0,"ف",1,0],["لا يُهنَىءِ الشامِتَ المُرتاحَ خاطِرُهُ","أَنّي مُعَنّى الأَماني ضائِعُ الخَطَرِ",1,"ر",1,0],["لا يُهمل اللهُ الذين رعيتَهم","فلأنت أكفى والعناية أكفلُ",2,"ل",1,0],["لاية خصلتين دعوتمانا","فلبيكم إجابة مستطيل",3,"ل",1,1],["لا يهمل الدنيا ولا","ينسى حقوقَ الآخره",4,"ر",2,0],["لا يهلِكنَّ على الخليفة هالكٌ","قد أرْغَبَ الناسَ الإمامُ وأرهَبا",5,"ب",2,0],["لا يهجونِّي فإني لستُ هاجيَه","ولا يرى ذاك مني أو يرى صُدُغَه",6,"غ",2,0],["لا يهيج الإحساس بالنقص شيء","كاحتكاك الأقوام بالأقوام",7,"م",1,0],["لا يهدم الله بيتا أُسه شرف","مدت له يده من فضله طنبا",8,"ب",2,0],["لا يَهدِمُ الدَهرُ رُكناً شادَ عَدلَهُمُ","وَحائِطُ البَغيِ إِن تَلمَسهُ يَنهَدِمِ",9,"م",1,0],["لا يَهضِمُ العُجمَ مِن خُؤولَتِهِ","تَمايُلاً لِلعُمومِ مِن عَرَبِه",10,"ب",2,0],["لا يَهالونَ مِن عَدُوٍّ وَلا يُؤ","تونَ مِن عُدَّةٍ وَلا مِن عَديدِ",11,"د",1,0],["لا يَهِمَّنَّكَ اِلتِماسَكَ مِن رَأ","يِ مُعَنّىً قَصارُهُ إِقصارُه",12,"ر",2,0],["لِأَيَّةِ حالَةٍ تَهجو عَلِيّاً","بِما لَفَّقتَ مِن كَذِبٍ وَزورِ",13,"ر",1,0],["لِأَيَّةِ حالٍ أَعلَنَ الوَجدَ كاتِمُه","وَأَقصَرَ عَن داعي الصَبابَةِ لائِمُه",14,"م",2,1],["لا يَهتَدي أَبَداً وَلَو نُعِتَت لَهُ","بِسَبيلِ وارِدَةٍ وَلا إِصدارِ",15,"ر",1,0],["لا يَهنَأِ الأَعداءَ عَزلُ ابنِ هاشِمٍ","فَكُلُّ مُوَلّى قَصرُهُ الصَرفُ وَالعَزلُ",16,"ل",1,1],["لا يَهدِمُ المَنُّ مِنهُ عُمرَ مَكرُمَةٍ","وَلا يَسوءُ أَذاهُ نَفسَ مُؤتِهِمِ",17,"م",1,0],["لا يَهدِمُ المَنُّ مِنهُ عُمرَ مَكرُمَةٍ","وَلا يُعَمَّدُ بِالمَطلِ المَواعيدُ",18,"د",1,0],["لا يهم الرياح","زورق غضبان",19,"ن",1,0],["لا يهابُ الحِمامُ مَلْكاً عظيماً","يحتبي يَوم جوده بالحبِيِّ",20,"ي",1,0],["لا يَهنِىءِ العُصبَةَ المُحَمَرَّ أَعيُنُها","بِثَغرِ أَرّانَ هَذا الحادِثُ العَرَضُ",21,"ض",1,0],["لا يَهتَدي صَرفُ الزَمانِ إِلى اِمرِىءٍ","مُتَصَرِّفٍ بِفَنائِكَ المَعهودِ",22,"د",1,0],["لا يهتفوا بالعدلِ أو تفسيره","دَمُهُ الزكيُّ مُفَسِّرٌ ومُتَرْجِمُ",23,"م",1,0],["لا يهجعون ولا يفنَى لهم صَخَبٌ","إن جفَّ مُرْتَزَقٌ أو عزَّ مُغْتَنَمُ",24,"م",1,0],["لا يهتفُ الدّاعِي بحقّ بلادهِ","إلا طغى صَلَفٌ ولجَّ عِنادُ",25,"د",1,0],["لا يَهدَأونَ إِذا راموا مَعونَتَهُم","حَتّى تَميدَ القُرى أَو تَرجُفَ المُدُنُ",26,"ن",1,0],["لآيَةِ ما تَسْري إليَّ نَوائبٌ","مُشَذِّبَةٌ عن جانبيَّ سَوادِك",27,"ك",1,0],["لا يَهِمُ الحاءَ في القِراءَةِ بِال","حاءِ وَلا لامَها مَعَ الأَلِفِ",28,"ف",1,0],["لا يَهابُ الوَغى وَلا يَعبُدُ الما","لَ وَلَكِن يُهينُهُ لِلثَناءِ",29,"ا",2,0],["لا يَهنَأِ الناسَ ما يَرعَونَ مِن كَلَإٍ","وَما يَسوقونَ مِن أَهلٍ وَمِن مالِ",30,"ل",1,0],["لأيةِ إِنسانيةٍ ذلك الوغى","وفيم أحلُّوهُ لقوم وحَرّموا",31,"م",3,0],["لا يَهْتَدِي فِيهَا لِرَحْلِيَ طَارِقٌ","إِلَّا بِأَنَّةِ قَلْبِيَ الْمُتَوَجِّعِ",32,"ع",1,0],["لا يَهْدَأُ الدَّهْرُ مِنْ ظُلْمٍ يُحَاوِلُهُ","فَإِنْ قَضَى وَطَراً مِنْ غَدْرَةٍ عَادَا",33,"د",2,0],["لا يَهتَدي قَلبي إِلى غَيرِكُم","كَأَنَّما سُدَّ عَلَيهِ الطَريق",34,"ق",1,0],["لا يهُزُّ النخيلَ إلاّ حَنانُ الن","ايِ في صمتِ ليلةٍ من حنان",35,"ن",1,0],["لا يَهْنهم من لحوم الناس ما أكلُوا","أو يَهنهم من دِماء الناسِ ما شَرِبُوا!!",36,"ب",3,0],["لا يهتدي بالعلم إلاّ نيّر","بهج البصيرة بالعلوم متيّمُ",37,"م",1,0],["لا يهنئِ الناسَ ما يرعونَ من كلاءٍ","، وما يسوقونَ من أهلٍ ومنْ مالِ",38,"ل",1,0],["لا يهابُ الحِمامُ مَلكاً عظيماً","يجتبي يوم جوده بالحبيّ",39,"ي",1,0],["لا يهين الشعوب إلاّ رضاها","رضى النّاس بالهوان فهانوا",40,"ن",3,0],["لأيّة غنسانية ذلك الوغى ؟","وفيم أحلّوه لقوم وحرّموا ؟",41,"م",3,0],["لا يهُنْ عندك اختلالٌ بجسمى","فقِوامُ الأرواحِ بالأجسامِ",42,"م",1,1],["لا يهجُم السخطُ على حِلمهِ","إن عثرَ الأخمَصُ بالساقِ",43,"ق",1,0],["لأيةِ علةٍ أغضي عيوني","على الاقذا وأنت لها منارُ",44,"ر",1,0],["لا يهتدي لقضاء واجب حقها","في الله إلا رأى كل سعيد",45,"د",1,0],["لا يهتدون إلى خير فينطقوا","لفظا وهيمّتهُ إغراؤه بدمي",46,"ي",1,0],["لأيّة حال يحبّ الصغير","ويحتاط سائر أوطاره",47,"ر",2,0],["لا يهابون من يصول ولا","عند سلم يخشون من حرب",48,"ب",1,0],["لا يهتدون إلى السَّبابِ ولا الخَنى","بل للنَّدّى ورواجِحِ الأحلام",49,"م",1,0],["لإيهامٍ يلفُّ بثوبِ وَهمٍ","حقيقتَهُ ويُودعُها العصورا",50,"ر",2,0],["لا يهنأ العيش لا يصفو السر ورولا","يطيب أنس ولا ننجو من النصب",51,"ب",1,0],["لا يَهتدي البرجيسُ مهداه ولا","يَغدو عطاردُ أن يكونَ حجيجه",52,"ج",2,0],["لا يهولنك الحديث عن النار","فإني الرحيم والرحماء",53,"ا",2,0],["لا يَهتَدي في دُجاهُ","لِغَيبِهِ عَن نُجوسِه",54,"ه",1,0],["لا يَهْتدي الفَلَكُ الأعلى لغايتها","فدَوْرُه المُتمادي دَوْرُ حَيران",55,"ن",1,0],["لا يَهنأِ الأعداءَ ما شَهِدوا وهل","لِعداكَ من خَطْبٍ عَداك هَناء",56,"ا",2,0],["لا يُهملُ اللَه إنساناً بتجربةٍ","إلّا ليعلمَ فرطَ الوهن والضعْفِ",57,"ف",1,1],["لا يَهولَنْكَ جَهامٌ مِنهمُ","هل تَرى أمطرتِ السُّحُب الجهَامُ",58,"م",1,0],["لا يَهتَدي الريح فيها من مسالكها","بَينَ الضَحا ضح من وهد ومن كثبِ",59,"ب",1,0],["لأية حالٍ فيْضُ دمعِكَ هتّانُ","وما هذه نعْمٌ ولا تلك نَعمانُ",60,"ن",1,1],["لأيّة حال بالقطيعة والجفا","صرمت حبا لي في الهوى من حبالك",61,"ك",1,0],["لا يَهْتَدِي سَمْتَ النَّجاةِ دَليلُها","دَهَشاً ولا وجه السَّدادِ سديدُها",62,"د",3,0],["لا يهون العناء إلا على من","هام في الفن واتخس الثراء",63,"ا",2,0],["لا يهاب السرَى وراءَ المعالي","واحدا خاضَ ليلَها أو مَثْنى",64,"ن",2,0],["لا يهتدي هُجْرٌ إلى أذنٍ","فيه ولا هَجرٌ إلى وصلِ",65,"ل",1,0],["لأيّةِ لبسة خلعَ الخلاعَهْ","وكان عَصى العذول فلِمْ أطاعَهْ",66,"ع",2,1],["لا يهتدِي الذئبُ إلى رزقِهِ","فيها ولو شَمَّ بها الذيبُ",67,"ب",1,0],["لِأَيَّةِ حالٍ جُفينا وَما","عَهِدناكَ يُثنيكَ عَنّا جَفاءُ",68,"ا",2,0],["لا يهتك الستر عن أنثى يطالعها","ولا يشد إلى جاراته النظر",69,"ر",1,0],["لا يهتدي طيف الكرى إن سرى","فيه ولا تخلص هوج الرياح",70,"ح",1,0],["لا يهجر الرأس جسماً كان يحمله","إلا إذا عانقت أسيافه عنقا",71,"ق",2,0],["لا يَهتدي عِلمُ النُّجومِ برصدهِ","ويضِلُّ عِلمُ الرَّملِ في توليدِهِ",72,"د",2,0],["لا يهجم الذئب إلا والرعى همل","فمن لها يا ابن ودي اليوم حراس",73,"س",1,0],["لاَ يَهُولَنْكَ ذَا فَإِنَّ أَخَاكَ ال","بَدْرَ مَا زَالَ مُولَعَاً بِالْكُسُوفِ",74,"ف",1,0],["لا يهتني بمنام بعدنا أبداً","والله يعلم أن البين مشجينا",75,"ن",2,0],["لا يهتدي لطريق الحق من عمه","بل كان بالجهل ممن نال خسرانا",76,"ن",2,0]]}