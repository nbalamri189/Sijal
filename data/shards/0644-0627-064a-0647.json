px?id=204362",""],[4764,"شفوف الهاويه","https://www.poetsgate.com/ViewPoem.aspx?id=34132",""],[4764,"جرح عادي","https://www.poetsgate.com/ViewPoem.aspx?id=37075",""],[4854,"كَفْكِف دُمُوعَكَ يَا سُودَانُ","https://www.poetsgate.com/ViewPoem.aspx?id=216021",""],[4898,"إنّا هُنا !","https://www.poetsgate.com/ViewPoem.aspx?id=35811",""],[4929,"قوة الإرادة (من وحي صورة )","https://www.poetsgate.com/ViewPoem.aspx?id=201406",""],[4968,"لَحْنُ الحَيَاةِ","https://www.poetsgate.com/ViewPoem.aspx?id=206762",""],[5054,"سيفُ الصدق","https://www.poetsgate.com/ViewPoem.aspx?id=215054",""],[5090,"فتنةُ العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=184263",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5190,"زمن غريب","https://www.poetsgate.com/ViewPoem.aspx?id=153478",""],[5335,"اغراني زمانك","https://www.poetsgate.com/ViewPoem.aspx?id=35557",""],[592,"إن الأمور التي الأعداء تبديها","https://www.poetsgate.com/ViewPoem.aspx?id=128826",""],[5561,"خذني إليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=206453",""],[5608,"الهنوف","https://www.poetsgate.com/ViewPoem.aspx?id=32911",""],[5786,"ما الغيث لمّا جرى بالسَّيل واديه","https://www.poetsgate.com/ViewPoem.aspx?id=50656",""],[5956,"تغريد ساقية","https://www.poetsgate.com/ViewPoem.aspx?id=183347",""],[5956,"صور إيمانية","https://www.poetsgate.com/ViewPoem.aspx?id=192502",""],[5956,"يارا هنالك يا فؤادي فانتبهْ","https://www.poetsgate.com/ViewPoem.aspx?id=193150",""],[6113,"ان بعض الظن اثم","https://www.poetsgate.com/ViewPoem.aspx?id=26374",""],[6199,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66252&r=&rc=5",""],[6210,"قالت لي الريح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7244&r=&rc=16",""],[572,"سيّدي أنتَ مِمَّ سووُّك قُلْ لي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9393&r=&rc=250",""]],"verses":[["لِأَيَّةِ حالٍ يَستَحِلُّ الهَوى دَمي","لِأَعذُرَهُ أُفٍ لِهَذا الهَوى أُفِّ",0,"ف",1,0],["لا يُهنَىءِ الشامِتَ المُرتاحَ خاطِرُهُ","أَنّي مُعَنّى الأَماني ضائِعُ الخَطَرِ",1,"ر",1,0],["لا يُهمل اللهُ الذين رعيتَهم","فلأنت أكفى والعناية أكفلُ",2,"ل",1,0],["لاية خصلتين دعوتمانا","فلبيكم إجابة مستطيل",3,"ل",1,1],["لا يهمل الدنيا ولا","ينسى حقوقَ الآخره",4,"ر",2,0],["لا يهلِكنَّ على الخليفة هالكٌ","قد أرْغَبَ الناسَ الإمامُ وأرهَبا",5,"ب",2,0],["لا يهجونِّي فإني لستُ هاجيَه","ولا يرى ذاك مني أو يرى صُدُغَه",6,"غ",2,0],["لا يهيج الإحساس بالنقص شيء","كاحتكاك الأقوام بالأقوام",7,"م",1,0],["لا يهدم الله بيتا أُسه شرف","مدت له يده من فضله طنبا",8,"ب",2,0],["لا يَهدِمُ الدَهرُ رُكناً شادَ عَدلَهُمُ","وَحائِطُ البَغيِ إِن تَلمَسهُ يَنهَدِمِ",9,"م",1,0],["لا يَهضِمُ العُجمَ مِن خُؤولَتِهِ","تَمايُلاً لِلعُمومِ مِن عَرَبِه",10,"ب",2,0],["لا يَهالونَ مِن عَدُوٍّ وَلا يُؤ","تونَ مِن عُدَّةٍ وَلا مِن عَديدِ",11,"د",1,0],["لا يَهِمَّنَّكَ اِلتِماسَكَ مِن رَأ","يِ مُعَنّىً قَصارُهُ إِقصارُه",12,"ر",2,0],["لِأَيَّةِ حالَةٍ تَهجو عَلِيّاً","بِما لَفَّقتَ مِن كَذِبٍ وَزورِ",13,"ر",1,0],["لِأَيَّةِ حالٍ أَعلَنَ الوَجدَ كاتِمُه","وَأَقصَرَ عَن داعي الصَبابَةِ لائِمُه",14,"م",2,1],["لا يَهتَدي أَبَداً وَلَو نُعِتَت لَهُ","بِسَبيلِ وارِدَةٍ وَلا إِصدارِ",15,"ر",1,0],["لا يَهنَأِ الأَعداءَ عَزلُ ابنِ هاشِمٍ","فَكُلُّ مُوَلّى قَصرُهُ الصَرفُ وَالعَزلُ",16,"ل",1,1],["لا يَهدِمُ المَنُّ مِنهُ عُمرَ مَكرُمَةٍ","وَلا يَسوءُ أَذاهُ نَفسَ مُؤتِهِمِ",17,"م",1,0],["لا يَهدِمُ المَنُّ مِنهُ عُمرَ مَكرُمَةٍ","وَلا يُعَمَّدُ بِالمَطلِ المَواعيدُ",18,"د",1,0],["لا يهم الرياح","زورق غضبان",19,"ن",1,0],["لا يهابُ الحِمامُ مَلْكاً عظيماً","يحتبي يَوم جوده بالحبِيِّ",20,"ي",1,0],["لا يَهنِىءِ العُصبَةَ المُحَمَرَّ أَعيُنُها","بِثَغرِ أَرّانَ هَذا الحادِثُ العَرَضُ",21,"ض",1,0],["لا يَهتَدي صَرفُ الزَمانِ إِلى اِمرِىءٍ","مُتَصَرِّفٍ بِفَنائِكَ المَعهودِ",22,"د",1,0],["لا يهتفوا بالعدلِ أو تفسيره","دَمُهُ الزكيُّ مُفَسِّرٌ ومُتَرْجِمُ",23,"م",1,0],["لا يهجعون ولا يفنَى لهم صَخَبٌ","إن جفَّ مُرْتَزَقٌ أو عزَّ مُغْتَنَمُ",24,"م",1,0],["لا يهتفُ الدّاعِي بحقّ بلادهِ","إلا طغى صَلَفٌ ولجَّ عِنادُ",25,"د",1,0],["لا يَهدَأونَ إِذا راموا مَعونَتَهُم","حَتّى تَميدَ القُرى أَو تَرجُفَ المُدُنُ",26,"ن",1,0],["لآيَةِ ما تَسْري إليَّ نَوائبٌ","مُشَذِّبَةٌ عن جانبيَّ سَوادِك",27,"ك",1,0],["لا يَهِمُ الحاءَ في القِراءَةِ بِال","حاءِ وَلا لامَها مَعَ الأَلِفِ",28,"ف",1,0],["لا يَهابُ الوَغى وَلا يَعبُدُ الما","لَ وَلَكِن يُهينُهُ لِلثَناءِ",29,"ا",2,0],["لا يَهنَأِ الناسَ ما يَرعَونَ مِن كَلَإٍ","وَما يَسوقونَ مِن أَهلٍ وَمِن مالِ",30,"ل",1,0],["لأيةِ إِنسانيةٍ ذلك الوغى","وفيم أحلُّوهُ لقوم وحَرّموا",31,"م",3,0],["لا يَهْتَدِي فِيهَا لِرَحْلِيَ طَارِقٌ","إِلَّا بِأَنَّةِ قَلْبِيَ الْمُتَوَجِّعِ",32,"ع",1,0],["لا يَهْدَأُ الدَّهْرُ مِنْ ظُلْمٍ يُحَاوِلُهُ","فَإِنْ قَضَى وَطَراً مِنْ غَدْرَةٍ عَادَا",33,"د",2,0],["لا يَهتَدي قَلبي إِلى غَيرِكُم","كَأَنَّما سُدَّ عَلَيهِ الطَريق",34,"ق",1,0],["لا يهُزُّ النخيلَ إلاّ حَنانُ الن","ايِ في صمتِ ليلةٍ من حنان",35,"ن",1,0],["لا يَهْنهم من لحوم الناس ما أكلُوا","أو يَهنهم من دِماء الناسِ ما شَرِبُوا!!",36,"ب",3,0],["لا يهيمون بواد مبهم","هم الى التحقيق اهدى من بصر",37,"ر",1,0],["لا يهتدي بالعلم إلاّ نيّر","بهج البصيرة بالعلوم متيّمُ",38,"م",1,0],["لا يهنئِ الناسَ ما يرعونَ من كلاءٍ","، وما يسوقونَ من أهلٍ ومنْ مالِ",39,"ل",1,0],["لا يهابُ الحِمامُ مَلكاً عظيماً","يجتبي يوم جوده بالحبيّ",40,"ي",1,0],["لا يهين الشعوب إلاّ رضاها","رضى النّاس بالهوان فهانوا",41,"ن",3,0],["لأيّة غنسانية ذلك الوغى ؟","وفيم أحلّوه لقوم وحرّموا ؟",42,"م",3,0],["لا يهُنْ عندك اختلالٌ بجسمى","فقِوامُ الأرواحِ بالأجسامِ",43,"م",1,1],["لا يهجُم السخطُ على حِلمهِ","إن عثرَ الأخمَصُ بالساقِ",44,"ق",1,0],["لأيةِ علةٍ أغضي عيوني","على الاقذا وأنت لها منارُ",45,"ر",1,0],["لا يهتدي لقضاء واجب حقها","في الله إلا رأى كل سعيد",46,"د",1,0],["لا يهتدون إلى خير فينطقوا","لفظا وهيمّتهُ إغراؤه بدمي",47,"م",2,0],["لأيّة حال يحبّ الصغير","ويحتاط سائر أوطاره",48,"ر",2,0],["لا يهابون من يصول ولا","عند سلم يخشون من حرب",49,"ب",1,0],["لا يهتدون إلى السَّبابِ ولا الخَنى","بل للنَّدّى ورواجِحِ الأحلام",50,"م",1,0],["لإيهامٍ يلفُّ بثوبِ وَهمٍ","حقيقتَهُ ويُودعُها العصورا",51,"ر",2,0],["لا يهنأ العيش لا يصفو السر ورولا","يطيب أنس ولا ننجو من النصب",52,"ب",1,0],["لا يَهتدي البرجيسُ مهداه ولا","يَغدو عطاردُ أن يكونَ حجيجه",53,"ج",2,0],["لا يهولنك الحديث عن النار","فإني الرحيم والرحماء",54,"ا",2,0],["لا يَهتَدي في دُجاهُ","لِغَيبِهِ عَن نُجوسِه",55,"ه",1,0],["لا يَهْتدي الفَلَكُ الأعلى لغايتها","فدَوْرُه المُتمادي دَوْرُ حَيران",56,"ن",1,0],["لا يَهنأِ الأعداءَ ما شَهِدوا وهل","لِعداكَ من خَطْبٍ عَداك هَناء",57,"ا",2,0],["لا يُهملُ اللَه إنساناً بتجربةٍ","إلّا ليعلمَ فرطَ الوهن والضعْفِ",58,"ف",1,1],["لا يَهولَنْكَ جَهامٌ مِنهمُ","هل تَرى أمطرتِ السُّحُب الجهَامُ",59,"م",1,0],["لا يَهتَدي الريح فيها من مسالكها","بَينَ الضَحا ضح من وهد ومن كثبِ",60,"ب",1,0],["لأية حالٍ فيْضُ دمعِكَ هتّانُ","وما هذه نعْمٌ ولا تلك نَعمانُ",61,"ن",1,1],["لأيّة حال بالقطيعة والجفا","صرمت حبا لي في الهوى من حبالك",62,"ك",1,0],["لا يَهْتَدِي سَمْتَ النَّجاةِ دَليلُها","دَهَشاً ولا وجه السَّدادِ سديدُها",63,"د",3,0],["لا يهون العناء إلا على من","هام في الفن واتخس الثراء",64,"ا",2,0],["لا يهاب السرَى وراءَ المعالي","واحدا خاضَ ليلَها أو مَثْنى",65,"ن",2,0],["لا يهتدي هُجْرٌ إلى أذنٍ","فيه ولا هَجرٌ إلى وصلِ",66,"ل",1,0],["لأيّةِ لبسة خلعَ الخلاعَهْ","وكان عَصى العذول فلِمْ أطاعَهْ",67,"ع",2,1],["لا يهتدِي الذئبُ إلى رزقِهِ","فيها ولو شَمَّ بها الذيبُ",68,"ب",1,0],["لِأَيَّةِ حالٍ جُفينا وَما","عَهِدناكَ يُثنيكَ عَنّا جَفاءُ",69,"ا",2,0],["لا يهتك الستر عن أنثى يطالعها","ولا يشد إلى جاراته النظر",70,"ر",1,0],["لا يهتدي طيف الكرى إن سرى","فيه ولا تخلص هوج الرياح",71,"ح",1,0],["لا يهجر الرأس جسماً كان يحمله","إلا إذا عانقت أسيافه عنقا",72,"ق",2,0],["لا يَهتدي عِلمُ النُّجومِ برصدهِ","ويضِلُّ عِلمُ الرَّملِ في توليدِهِ",73,"د",2,0],["لا يهجم الذئب إلا والرعى همل","فمن لها يا ابن ودي اليوم حراس",74,"س",1,0],["لاَ يَهُولَنْكَ ذَا فَإِنَّ أَخَاكَ ال","بَدْرَ مَا زَالَ مُولَعَاً بِالْكُسُوفِ",75,"ف",1,0],["لا يهتني بمنام بعدنا أبداً","والله يعلم أن البين مشجينا",76,"ن",2,0],["لا يهتدي لطريق الحق من عمه","بل كان بالجهل ممن نال خسرانا",77,"ن",2,0],["لا يهنأ الاحباب فيه لانه","شمل الجموع مبدد ومفرق",78,"ق",1,0],["لا يهمزُ المصَّ إِذا الغرُّ هَمَزْ","أعجِب به من فَوقِ أبيض احتفز",79,"ز",1,0],["لا يَهجَعَن فَوقَ الحَشايا جَنبي","أَما فراش الأَرض فَهوَ حَسبي",80,"ي",1,0],["لا يهتدي الناس إلا فيكما ومتى","أغنى عن النيرين الضوء من زحل",81,"ل",1,0],["لأيَّةِ حَالٍ حُلْتُمُوا عَنْ مَوَدَّتِي","وَدُمْتُمْ عَلىَ هَجْرِي مَلاَلاً لِصُحْبَتي",82,"ي",1,1],["لا يهاب الأسود في حومة","الحرب ويقتاده الغزال الربيب",83,"ب",1,0],["لا يهمل الكتاب منك ما صدر","كل كبير وصغير مستطر",84,"ر",1,0],["لا يَهنأ القَلب يا مَحمود بعدك لا","لَو كانَ قَلبي من بعد الفراق بقي",85,"ق",2,0],["لا يهلك الجاني بما استهواه","بحق لا إله إلا اللّه",86,"ه",1,0],["لا يهدم الأعداء منه وهل","يهدم ما اللَه له باني",87,"ن",2,0],["لأية خصلة تبكيك عيني","ومالي بالحساب لها يدان",88,"ن",1,0],["لا يهولنك بلى الدور فكم","قد أقمنا لك دورا ودعاما",89,"م",2,0],["لا يَهنِ منك قويّ العَزم إن","اصبحَ الجاهِلُ في عَيشٍ رَغَد",90,"د",1,0],["لأية حال أنت عنهم مخلف","أظنك مثلي ويح من كان لي مثلا",91,"ل",2,0],["لِأَيَّةِ حالٍ حُكِّموا فيكَ فَاشتَطُوا","وَما ذاكَ إِلّا حينَ عَمَّمَكَ الوَخطُ",92,"ط",1,1],["لِأَيِّ هِزَبرِ وَغىً هَيَّجُوا","وَأَيِّ سَنا جَذوَةٍ أَشعَلُوا",93,"ل",3,0],["لا يهتدون لما تعطى نواظرهم","وما لهم في الذي يرون برهان",94,"ن",1,0],["لا يهتدون ولا يهدون صاحِبَهم","عمارٌ أنديةٍ كثبانها حمر",95,"ر",1,0],["لا يُهنِئِ الشِركَ كَأسٌ أَنتَ شارِبُها","في اللَهِ مَعسولَةً تَشفي مِنَ السَقَمِ",96,"م",1,0],["لا يَهتَدي فيها وَلَو طَلَعَت","مِن أفقِها أَخلاقُكَ الغُرَرُ",97,"ر",1,0],["لا يهاب الليل مهما اعتكرا","لم يخف تيهاً به أو خطرا",98,"ر",2,0],["لأِيَّة حالٍ دمعُ عينك يذرف","وقلبُك من داء الصبابةِ يرجف",99,"ف",1,1],["لا يَهولنك دينيّتُه","أَعطه مِن رَشوة ما حضرك",100,"ك",1,0],["لا يهوله في الهوى ما منه راح","كيف أصبر والحشا كله جراح",101,"ح",1,0],["لأية حال حالت الحال بيننا","وأنت بأي العذر تغدو وتغتدي؟",102,"د",2,0],["لأية حال يا ابن خيرِ أرومةٍ","أُذاذد عن العذب الزُّلال بلا شربِ",103,"ب",1,0],["لا يهتدي الأنس إلى مجلس","تغيب عنه طلعة المهدي",104,"د",2,0],["لا يهمل الله الصنيع فذكرهم","دان وأن نأت الجسوم قديما",105,"م",2,0],["لا يَهدم الدهر مَهما كانَ مع