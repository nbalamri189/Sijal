{"poems":[[74,"رأينا تواقيع تاج العلوم","https://www.aldiwan.net/poem19625.html","المتقارب"],[74,"رأينا تواقيع تاج الزمان","https://www.aldiwan.net/poem20606.html","المتقارب"],[53,"ولحية لو شاء ذو المعارج","https://www.aldiwan.net/poem9255.html","الرجز"],[91,"خمسة طاروا من عيون الشباب","https://www.aldiwan.net/poem44625.html","الخفيف"],[108,"هل عاد قيس؟","https://www.poetsgate.com/ViewPoem.aspx?id=179386",""],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[303,"إذا الشعر لم ينفث به ربه السحرا","https://www.aldiwan.net/poem36848.html","عموديه"],[369,"أبقيت بالجزع ما أبليت من طلل","https://www.aldiwan.net/poem60678.html","البسيط"],[445,"غرام ولا شكوى وعتب ولا عتبى","https://www.aldiwan.net/poem34828.html","الطويل"],[445,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[449,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[457,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[505,"قل لغزلان بقيعان النقا","https://www.aldiwan.net/poem37937.html","الرمل"],[563,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145632","البسيط"],[1084,"","https://poetry.dctabudhabi.ae/diwan/poem/119098","الكامل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79547","الخفيف"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136896","الرمل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109324","الكامل"],[2226,"","https://poetry.dctabudhabi.ae/diwan/poem/200279","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132793","المتدارك"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138566",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109912","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114067","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135935","الرجز"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78272","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81251","المتقارب"],[4717,"وطني..وياء الهويه","https://www.poetsgate.com/ViewPoem.aspx?id=200582",""],[327,"آذَنَ اليومَ جِيرتي بارتحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=3928",""],[5608,"حرب","https://www.poetsgate.com/ViewPoem.aspx?id=33394",""],[5829,"حدثيني","https://www.poetsgate.com/ViewPoem.aspx?id=204673",""],[5956,"حمداً لرب العالمين كثيرا","https://www.poetsgate.com/ViewPoem.aspx?id=206980",""]],"verses":[["بنسك وجودٍ وخطٍّ أجاد","فقلت الثلاثة خطّ الولي",0,"ي",1,0],["بنسكٍ وجودٍ وحفظ أجاد","فقلتُ الثلاثة حظّ الوليّ",1,"ي",1,0],["بنسج مِسْحين لخان الديْزجِ","وفرَّق الباقي على الكواسِجِ",2,"ج",1,0],["بنسور قد حلقت قبل ان يؤذن","ضوء الصباح بالاسفار",3,"ر",1,0],["بِنَسِيبِ شعركِ، يا عُمَرْ","للغانيات حَلا السَّمَرْ",4,"ر",1,1],["بِنسبةِ بُعدِ الشمسِ يحصلُ نورها","لِقومٍ غَدا قلّاً لقومٍ غَدا كُثرا",5,"ر",2,0],["بنسجٍ كنسجِ (البحتريِّ) وحكمة","تضارعُ ما كان (المعري) به مغرى",6,"ر",2,0],["بنسِجِ داودَ منّي القَلْبُ مُدَّرعٌ","إن كان طَرْفُكِ أضحَى من بني ثُعَل",7,"ل",1,0],["بِنِسْبَتِنا فِي رِقِّ مولىً أَضافَنا","فَبَوَّأَنا الإِكرامَ والمنزِلَ الرَّحْبا",8,"ب",2,0],["بنِسبةٍ من رسولِ اللهِ شدَّ بِهَا","ربُّ العُلا للهدى والدِّين أَرْكانا",9,"ن",2,0],["بنسف غير منفصل","وضرب غير منفصم",10,"م",1,0],["بنسيمٍ يحل في غلس الأس","حار عن جيب نوره أزراره",11,"ر",2,0],["بنَسيمِ الصُّبْحِ وافى نشرُكُمْ","فشَمَمْنا من شَذاهُ عَبَقَا",12,"ق",2,0],["بنسمة قنع المشتاق ينشقها","من نحو أرضك وهنا واكتفى بشم",13,"م",1,0],["بِنَسْمَةٍ من رُبَى صَنْعَاءَ عَابِقَةٍ","أَشُمُّ نَفْحَةَ فِرْدَوْسِي وَعِلِّيني",14,"ن",2,0],["بنساء آل محمد","لما بكين على الحسين",15,"ن",1,0],["بنسيمٍ معقَّدٍ","في هواءٍ مُجَسَّمِ",16,"م",1,0],["بنساء قاصرات الطرف عين","ورجال في المعالي معرقين",17,"ن",1,0],["بنسيمك العطر العلي","ل شفاء علات الصدور",18,"ر",1,0],["بنسيم كأن مجراه في الدو","ح كمجرى الأرواح في الكون سرا",19,"ر",2,0],["بنسيمك ذياك الأرج","نفحات الوصل تبشرنا",20,"ن",2,0],["بنسرها الطائر وهي انجم","مضيئة والبعض منها مظلم",21,"م",1,0],["بنساه طاف طوافهن مودعا","فغدت تطوف به نوادب ثكلا",22,"ل",2,0],["بنسكينهِ الأفراحُ والسِلمُ للورى","وتحريكهِ الأَتراحُ والحُزنُ والحَرَب",23,"ب",1,0],["بِنِسبَتِكُم لَهُمُ قَد رَأستُم","وَإِلا لَكُنتُم مِنَ اذنَابِهَا",24,"ب",3,0],["بنسبةِ النسوبِ ليَ لك معْ","نسبةِ منسوبك ليَ مجتمعْ",25,"ع",1,0],["بِنَسيمِها تَنسى الصَبابَة نَشوَة","ما ناحَ أَيكى وَفاحَ اِقاح",26,"ح",1,0],["بِنَسي مِن هان حَتّى تَوا","ضع في نَفيهٍ كُل مَعنى رفيع",27,"ع",1,0],["بنسفِ الجبالِ ستهوي صخورٌ","بكلِّ اتجاهٍ تراها فتيَّه",28,"ي",2,0],["بِنُسالٍ تطيرُ بعدَ نُسالِ","فرعاها المصيف حتى إذا ما",29,"م",2,0],["بنسف وادمر واحرق اللي تمنيت","يعني بكيفي أعمل اللي بودّي",30,"د",2,0],["بنسال من بين الجفون رحيقه","فإذا به عند الشغاف لهيب",31,"ب",1,0],["بنسيج نوره أبدأ التدبيرا","بعبادتي له أدفع التطويرا",32,"ر",2,0]]}