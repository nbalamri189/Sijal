185,"الوحدة","https://www.poetsgate.com/ViewPoem.aspx?id=70900",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5431,"العسل الشهي","https://www.poetsgate.com/ViewPoem.aspx?id=183001",""],[5442,"سل الركب هل مروا بجرعاء مالك","https://www.poetsgate.com/ViewPoem.aspx?id=114770",""],[5821,"رجل المواقف","https://www.poetsgate.com/ViewPoem.aspx?id=114116",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[5953,"سئمت المقام بأرض الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=93800",""],[2638,"طيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87870&r=&rc=27",""]],"verses":[["وَحَجّارٌ رَأى طَعني فَنادى","تَأَنّى يا اِبنَ شَدّادٍ تَأَنّى",0,"ن",2,0],["وَحَجَّبَ عَنِّي حُبَّهُ غَيْرَ جَاهِلٍ","بِأَنِّي ضَيْفٌ وَالْمَبَرَّةُ مِنْ شَانِي",1,"ن",2,0],["وَحِجَالُهُنَّ مِنَ الْبُنُودِ فَلاَ تَرُمْ","وَصْلاً بِدِينَارٍ لَهُنَّ وَدِرْهَمِ",2,"م",1,0],["وَحَجَّبَ اللَّيْلُ عَنَّا حُسْنَ مَنْظَرهِ","بِسِتْرِ جُنْحٍ مِنَ الظَّلْمَاءِ مُنْسَدِلِ",3,"ل",1,0],["وحَجّبَها عنْ ناظِرِ الشّمْسِ فانْثَنَتْ","تسَتّرُ في ظِلٍّ منَ الغَيْمِ مُمْتَدِّ",4,"د",1,0],["وحَجَجْتُ كَعْبَتَهُ فَما مِنْ مَنْسَكٍ","إلاّ أقَمْتُ شِعارَهُ وقَضَيْتُهُ",5,"ت",2,0],["وحجّبوهنّ خوف العار لَيتهم","خافوا عليهنّ من عار الجهالات",6,"ت",1,0],["وَحُجِبنَ عَنكَ السَيِّئاتُ وَلَم يَزَل","لَكَ صاحِبٌ مِن صالِحِ الأَعمالِ",7,"ل",1,0],["وَحُجَّتُها العُليا عَلى كُلِّ حالَةٍ","فَباطِلُها حَقٌّ وَحَقِّيَ باطِلُ",8,"ل",1,0],["وَحَجَّلَ في الدارِ غِربانُها","وَخَفَّ مِنَ الدارِ سُكّانُها",9,"ن",3,0],["وحُجْنٌ كأنصاف الأهلة لايني","بهن خضاب من دم الجوف أحمرُ",10,"ر",1,0],["وَحُجَّتُنا فيهِما كَالصَباحِ","وَلَيسَ بِمُعييكَ تِبيانُها",11,"ن",3,0],["وَحَجَّبَتِ النَوى الظَبياتِ عَنّي","فَساعَدَتِ البَراقِعَ وَالحِجالا",12,"ل",2,0],["وحجر الصنعة فاع","رفه فقد نلت الأمد",13,"د",1,0],["وَحَجَبتَهُ حَتّى تَوَهَّمَ أَنَّهُ","هاجٍ أَتاكَ بِشَتمِهِ وَسِبابِهِ",14,"ب",2,0],["وحَجَّامٌ يقولُ الشِّعرَ جاءَتْ","غرائبُهُ إليَّ على البَريدِ",15,"د",1,0],["وحُجِّبَت دون رائيها بدائِعُه","وقُيِّدَت دونَ مَسراها غرائبهُ",16,"ب",2,0],["وَحَجَّتِ العيسَ حادٍ صَوتُهُ غَرِدٌ","بِنَغمَةٍ دونَها المَزمومُ وَالرَمَلُ",17,"ل",1,0],["وحجاز راقص أو ها","ت من شط الفرات",18,"ت",1,0],["وحجّ بربعك بيتَ العلى","وطافَ به لا يملّ الزحاما",19,"م",2,0],["وَحُجراً وَاِمرَأَ القَيسِ بنَ حُجرٍ","لَيالي كاهِلٍ وَبَني مُعَينِ",20,"ن",1,0],["وحجَ إذا أردتَ فإنّ حجّي","إلى شُربِ المدامةِ بالبواطي",21,"ط",2,0],["وَحَجَّ كَلمِيَ بَعضُ الناسِ مُعتَمِراً","فَهَل أُلامُ عَلى حَجٍّ وَمُعتَمَرِ",22,"ر",1,0],["وحجابهم فتياتهم","عند الخروج من النظر",23,"ر",1,0],["وحج عنهم قضاءً بعدما ارتحلوا","قوم سيقضون عني بعد ترحالي",24,"ل",2,0],["وَحُجِّبَ مَيْمُونُ النَّقِيبَةِ عَنْ حِمىً","بَكَتْهُ أَدَانِيهِ أَسىً وَالأَبَاعِدُ",25,"د",1,0],["وحجىً يغلبُ الحجي ودهاءٌ","جلَّ فيه عن كل إنس وجن",26,"ن",1,0],["وحجة الله بالتكليف لازمة","سيان في الأمر مفضول وذو الخطر",27,"ر",1,0],["وحجبها عن ناظري الشمس فانثنت","تستر في ظل من الغيم ممتد",28,"د",1,0],["وحجُّوا إلى بيتٍ هو الفنُّ نفسُه","أنارَتْ \" فَنيسٌ \" ساحَه و\" عُطارد\"",29,"د",1,0],["وحُجَّتُهم أن كانَ فيما مضى لنا","أبٌ ، اسمهُ عندَ التواريخِ يَعْرُب",30,"ب",1,0],["وحجَّارٌ رأى طعني فنادى","تأَنى يا بنَ شدَّادِ تأَنى",31,"ن",2,0],["وحجت لعرفاني الرجال فضمخت","من الحال والذوق الشريف بطيب",32,"ب",1,0],["وحجازي الهوى أشواقه","أَصبحت أنى نحا الأردن تنحو",33,"ح",2,0],["وحَجَّ البيتَ مُمتَثِلاً ولبي","وطَافَ وزارَ زَمزَمَ والمُقَامَا",34,"م",2,0],["وَحُجَّتُهُم كانَت لِإِشكالِ طُرقِهِ","فَأَلّا وَقَد أَوضَحتَ لِلسالِكِ الطُرقا",35,"ق",2,0],["وَحَجَّ بعامِ العشرِ أفضلَ حجّةٍ","بِها ودّعَ الأصحابَ وَالبيتَ وَالحِجرا",36,"ر",2,0],["وَحَجَراً وَزَبّاناً وَإِن يَكُ مُلقِطٌ","توفِيَ فَليَغفِر لَهُ سائِرَ الذَنبِ",37,"ب",1,1],["وحُجَّةَ الله التي لَمْ تُرْدَدِ","بعد النبيّ المصطفَى محمّدِ",38,"د",1,0],["وحج إلى البيت المعظم في غنىً","وعافية وأضمم عيالي وأكنف",39,"ف",1,0],["وَحِجىً يُريكَ هِضابَ قُد","سٍ في النَدِيِّ إِذا اِحتَبا",40,"ب",2,0],["وَحَجٌّ تُجِيحُ الذ َّنْبَ بِيضُ ثَوَابِهِ","وَزَوْرَةُ مَنْ أَعْلَى الْوَرَى وَهْيَ أَغْفَالُ",41,"ل",1,0],["وحجب عن عيني اوجه عينها","وكن شموساً لا تغب طلوعا",42,"ع",2,0],["وحَجِّي إلَيْها واعْتِمارِي جَعَلته","وَذاك لَعَمري مُنتَهى شَرَف العُمْرِ",43,"ر",1,0],["وحجَّةُ اللَه الَّتي نورُها","كالصُبح لا يَخفى ولا يبلسُ",44,"س",1,0],["وحجبتها عمن يروم وصالها","وأين الثريا من يد المتناول",45,"ل",1,0],["وحجة محتج بتقدير ربه","تزيد عذاباً كاحتجاج مريضة",46,"ه",1,0],["وحج بيت الإله واترك جميع المناهي","ولا تجى للملاهي وكل خصله رديه",47,"ه",1,0],["وحج البيت طف واسع","واحلق قف بعرفات",48,"ت",1,0],["وحِجاكَ يهنو للندى ولربّما","قربُوا به طوْداً من الأطوادِ",49,"د",1,0],["وحج لبيت الله فرض ولازم","على كل حر بالغ صار قادرا",50,"ر",2,0],["وحجبتها العوالي فهي سارقة","معاني الهيف الموموق والهضمِ",51,"م",1,0],["وحجبتني فيها فما","لي غير أمي مربع",52,"ع",1,0],["وحُجَّتي وقُفولُ القومِ قافِلَةً","بكلِّ خيرٍ مَسيري نحو مَرْغوبي",53,"ب",2,0],["وَحَجّاً إِلى اللَهِ في بَيتِهِ","لِمَن كانَ ذاكَ لَهُ يَسهُلُ",54,"ل",1,0],["وحجتها فينا علينا عظيمة","وبرهانها بالحق للغير دامغ",55,"غ",1,0],["وحجة المحتج منا تلزمه","أن يطلب العلم الذي لا يعلمه",56,"ه",1,0],["وحَجيِّ إِلى حانوت راحٍ وراحَةٍ","وكعبةُ تَهادَى والعُقودُ حَبابُ",57,"ب",1,0],["وَحَجْبُكَ حَتّى لَوْ عَن الحُجْبِ تَتَّقي","حِجاباً ولا تَبْدُو لَهَا كُنْتَ تَفْعَلُ",58,"ل",1,0],["وَحَجْبُكَ حَتّى لَوْ عَنِ الحُجْبِ تَتَّقي","حِجاباً فلا تَبْدُو لَهَا كُنْتَ تَفْعَلُ",59,"ل",1,0],["وحجي به رفع البلاد لمستوى","عدل يساوي سيداً بمسود",60,"د",1,0],["وَحَجَّ مِنها لِقَصادِ الهُدى حَرَما","أَمناً وَجاوَرَ لِأَربابِ النُهى قُدسا",61,"س",2,0],["وَحَجَّ إلَيهِ المُعتَفُونَ فَكاثَرَت","مَواسِمَ أهلِ القِبلَتَينِ مَواسِمُه",62,"م",2,0],["وحجت به كل الحجاج حجاجها","وقامت عليها منه أقوم حجة",63,"ه",1,0],["وحجبتني عن حجاب تنزه","وشهدت ما شهدت به الأشهاد",64,"د",1,0],["وحجم البسيطة قد وجدو","ه مليون بليون متر مكعب",65,"ب",1,0],["وحجيت سنّ الحلم في زمن الصبا","وبصرت فالتاح السبيل الأقصد",66,"د",1,0],["وحجٌّ بلَغتُم فيه كلَّ كرامةٍ","وقضَّيتُم محتومةً مِن شعائر",67,"ر",1,0],["وَحَجْرَتُهُ عَيْني تَرَاهَا قَرِيبَةً","ذَلاَلاً لِمَنْ أَحْيى قُلُوباً مُقِيمَةُ",68,"ه",1,0],["وحجر على عينيّ أن يطعما الكرى","إلى أن يرى حجراً يناغي على حجر",69,"ر",1,1],["وحجب ذاته من حاسديه","بنور النيرين الزاهرين",70,"ن",1,0],["وَحَجَّبَ خَدَّ الوَرْدِ خود ركابَها","فَنَمَّ عَليهَا الطيب والنشر والقسط",71,"ط",1,0],["وَحَجَّبَ وَجْهَ الشَّمْسِ سَيْرُ غَمَامَةٍ","كَمَا حَجَّبَ النَّارَ المُؤَجَّجَةَ النَّدُّ",72,"د",1,0],["وَحُجرٍ وَالمَصانِعِ حَولَ حُجرٍ","وَما هَضَمَت عَلَيهِ مِن لِقاحِ",73,"ح",1,0],["وحجر سبيب ف سبيبة قادهم","إلى اسرهم والعفو منّ به الحرّ",74,"ر",1,0],["وحجاب مشكلة تقاعس دونه","هذا وذلك قد أماط حجابها",75,"ب",3,0],["وحَجَّتْهُمْ سُيوفُكَ حينَ صَلَّتْ","فَأَلْجمَهُمْ جِدالُكَ في الجِلادِ",76,"د",1,0],["وحجاج بيت اللَه بالأمس أصبحوا","حفاة عراة والنساء عواريا",77,"ي",2,0],["وحجب عني الغانيات كأنه","بياضٌ على العينين والفود أجمعا",78,"ع",2,0],["وحجة الإسلام ذاك حجةٌ","بالغةٌ لمن أناب واهتدى",79,"د",2,0],["وحجْلُها فَعْمٌ شَرِق","ونَحْرُها بَضُّ يَققْ",80,"ق",1,0],["وحجرٌ على أجفانِكِ النوم عن دمٍ","شبا السيف يأبى أن يُطلّ ويهدرا",81,"ر",2,0],["وحجة كالصبح مشهورة","قُمْتَ بها تُعلي وَتَسْتَعلي",82,"ل",2,0],["وحجّب في الثلج الربيع وحسنه","كما اكتن في بيضٍ فراخ الطواوس",83,"س",1,0],["وحجتُ إذا في حسن نطقي لم أكن","لأشكر خلاّقي وأحمد أحمدا",84,"د",2,0],["وحجَّبنَ بدراً من سما مجد هاشمٍ","سناه بأعلى دارة المجد ساطع",85,"ع",1,0],["وحج بمال من حلال عرفته","وإياك والمال الحرام وإياه",86,"ه",1,0],["وحَجّ وأَهدى البُدنَ أوّل مُشعرٍ","لها وفُروضُ الحَجّ لم تتَرتَّبِ",87,"ب",1,0],["وَحَجَبتَهُنَّ عَنِ العُيونِ بِغَيرَةٍ","هِيَ دُونَهُنَّ مَعَ الحِجابِ حِجابُ",88,"ب",1,0],["وَحَجَّبنَ السَنا بِالنَقعِ حَتّى","كَأَنَّ الشَمسَ لابِسَةٌ قِناعا",89,"ع",2,0],["وَحَجَّت إِلَيكَ وُفودُ البِلاد","دِ مِن كُلِّ فَجٍ سَحيقِ الحَدَب",90,"ب",1,0],["وَحُجَّتُنا لا تُقبَلُ الدَهرَ عِندَهُ","وَشاهِدُنا عَن عَمدِ عَينٍ مُوَقَّفُ",91,"ف",1,0],["وحجته العصماء من كل وصمة","وآيته الكبرى على اليوم والغد",92,"د",1,0],["وَحِجَابُهُ نُورٌ فَلَو كُشِفَ الحِجَا","بُ لأحرَقَ السُّبُحَاتُ للأكوَانِ",93,"ن",1,0],["وَحَجَب