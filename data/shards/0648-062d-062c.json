{"poems":[[3,"سلي يا عبلة الجبلين عنا","https://www.aldiwan.net/poem219.html","الوافر"],[77,"جفا ابن أبي رمانة وجه مقدمي","https://www.aldiwan.net/poem36042.html","الطويل"],[77,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[77,"أبشر فقد نلت ما ترجو على عجل","https://www.aldiwan.net/poem36369.html","البسيط"],[77,"دعاها تشم آثار نجد ففي نجد","https://www.aldiwan.net/poem36603.html","الطويل"],[77,"لما دعا داعي الهوى لبيته","https://www.aldiwan.net/poem36680.html","الكامل"],[88,"كل ابن آدم مقهور بعادات","https://www.aldiwan.net/poem44993.html","البسيط"],[47,"الفكر فيك مقصر الآمال","https://www.aldiwan.net/poem25188.html","الكامل"],[47,"نعم تلك بين الواديين الخمايل","https://www.aldiwan.net/poem25205.html","الطويل"],[23,"لقد هاج نفسك أشجانها","https://www.aldiwan.net/poem21380.html","المتقارب"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[85,"نجا وتماثل ربانها","https://www.aldiwan.net/poem63734.html","المتقارب"],[43,"بقائي شاء ليس هم ارتحالا","https://www.aldiwan.net/poem10117.html","الوافر"],[62,"اعمل بجد وجلد","https://www.aldiwan.net/poem52155.html","مجزوء الرجز"],[45,"هل للندى عدل فيغدو منصفا","https://www.aldiwan.net/poem10647.html","الكامل"],[61,"أحل بعقوة الشرف التليد","https://www.aldiwan.net/poem51689.html","الوافر"],[61,"لنا من الدهر خصم لا نغالبه","https://www.aldiwan.net/poem51782.html","البسيط"],[66,"في مثل حبكم لا يحسن العذل","https://www.aldiwan.net/poem39928.html","البسيط"],[97,"آه من لحن سماوي","https://www.aldiwan.net/poem24608.html","مجزوء الرمل"],[80,"رعى من أخي الوجد طيف ذماما","https://www.aldiwan.net/poem31291.html","المتقارب"],[44,"خشنت عليه أخت بني خشين","https://www.aldiwan.net/poem30339.html","الوافر"],[48,"إذا ولج البعير فروغ صبري","https://www.aldiwan.net/poem66271.html","الوافر"],[46,"السعد يجعل ذري الدبى نعما","https://www.aldiwan.net/poem22663.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85830","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147462","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[77,"دعاها تشم آثار نجد ففي نجد","https://www.poetsgate.com/ViewPoem.aspx?id=33821",""],[90,"الزهَاوي","https://www.poetsgate.com/ViewPoem.aspx?id=179155",""],[90,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[3,"سلي يا عبلة َ الجبلينِ عنَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10767&r=&rc=121",""],[113,"عتبت على الدنيا عتاب لبيب","https://www.aldiwan.net/poem41243.html","عموديه"],[122,"هاتها واشرب فإن اليوم فصح","https://www.aldiwan.net/poem23717.html","الرمل"],[130,"ألا أبلغ محمدا الإماما","https://www.aldiwan.net/poem54750.html","الوافر"],[141,"بإحرازك الفضل الذي بهر الخلقا","https://www.aldiwan.net/poem11786.html","الطويل"],[187,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[193,"وحجرا وزبانا وإن يك ملقط","https://www.aldiwan.net/poem54388.html","الطويل"],[227,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[229,"إليك رسول الله أشكو تخلفي","https://www.aldiwan.net/poem44580.html","الطويل"],[233,"وبخيلة سمح الرقا","https://www.aldiwan.net/poem32174.html","مجزوء الكامل"],[235,"قصدت أبا يعزى وبالبال بلبال","https://www.aldiwan.net/poem18852.html","الطويل"],[259,"هلما نحييها ربى وربوعا","https://www.aldiwan.net/poem38241.html","الطويل"],[273,"رويد الليالي كم تصر على الغدر","https://www.aldiwan.net/poem25559.html","الطويل"],[295,"يا صاح هذا المشهد الأقدس","https://www.aldiwan.net/poem33243.html","السريع"],[301,"تقنصتها كالظبي جيدا وطالما","https://www.aldiwan.net/poem57589.html","الطويل"],[323,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[388,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[388,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[429,"أرح المطية برهة يا حادي","https://www.aldiwan.net/poem12596.html","الكامل"],[461,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[462,"أضاء ثغر سليمى ليلة العلم","https://www.aldiwan.net/poem3473.html","عموديه"],[477,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[498,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[534,"أشاقك بالمنتصى منزل","https://www.aldiwan.net/poem23851.html","المتقارب"],[556,"شموسك يا سلمى علينا بوازغ","https://www.aldiwan.net/poem34364.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"عسى أن يسر السائرين إياب","https://www.aldiwan.net/poem3102.html","الطويل"],[584,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem17639.html","الطويل"],[584,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem18010.html","الطويل"]],"verses":[["وَحَجّارٌ رَأى طَعني فَنادى","تَأَنّى يا اِبنَ شَدّادٍ تَأَنّى",0,"ن",2,0],["وَحَجَّبَ عَنِّي حُبَّهُ غَيْرَ جَاهِلٍ","بِأَنِّي ضَيْفٌ وَالْمَبَرَّةُ مِنْ شَانِي",1,"ي",1,0],["وَحِجَالُهُنَّ مِنَ الْبُنُودِ فَلاَ تَرُمْ","وَصْلاً بِدِينَارٍ لَهُنَّ وَدِرْهَمِ",2,"م",1,0],["وَحَجَّبَ اللَّيْلُ عَنَّا حُسْنَ مَنْظَرهِ","بِسِتْرِ جُنْحٍ مِنَ الظَّلْمَاءِ مُنْسَدِلِ",3,"ل",1,0],["وحَجّبَها عنْ ناظِرِ الشّمْسِ فانْثَنَتْ","تسَتّرُ في ظِلٍّ منَ الغَيْمِ مُمْتَدِّ",4,"د",1,0],["وحَجَجْتُ كَعْبَتَهُ فَما مِنْ مَنْسَكٍ","إلاّ أقَمْتُ شِعارَهُ وقَضَيْتُهُ",5,"ت",2,0],["وحجّبوهنّ خوف العار لَيتهم","خافوا عليهنّ من عار الجهالات",6,"ت",1,0],["وَحُجِبنَ عَنكَ السَيِّئاتُ وَلَم يَزَل","لَكَ صاحِبٌ مِن صالِحِ الأَعمالِ",7,"ل",1,0],["وَحُجَّتُها العُليا عَلى كُلِّ حالَةٍ","فَباطِلُها حَقٌّ وَحَقِّيَ باطِلُ",8,"ل",1,0],["وَحَجَّلَ في الدارِ غِربانُها","وَخَفَّ مِنَ الدارِ سُكّانُها",9,"ن",3,0],["وحُجْنٌ كأنصاف الأهلة لايني","بهن خضاب من دم الجوف أحمرُ",10,"ر",1,0],["وَحُجَّتُنا فيهِما كَالصَباحِ","وَلَيسَ بِمُعييكَ تِبيانُها",11,"ن",3,0],["وَحَجَّبَتِ النَوى الظَبياتِ عَنّي","فَساعَدَتِ البَراقِعَ وَالحِجالا",12,"ل",2,0],["وحجر الصنعة فاع","رفه فقد نلت الأمد",13,"د",1,0],["وَحَجَبتَهُ حَتّى تَوَهَّمَ أَنَّهُ","هاجٍ أَتاكَ بِشَتمِهِ وَسِبابِهِ",14,"ب",2,0],["وحَجَّامٌ يقولُ الشِّعرَ جاءَتْ","غرائبُهُ إليَّ على البَريدِ",15,"د",1,0],["وحُجِّبَت دون رائيها بدائِعُه","وقُيِّدَت دونَ مَسراها غرائبهُ",16,"ب",2,0],["وَحَجَّتِ العيسَ حادٍ صَوتُهُ غَرِدٌ","بِنَغمَةٍ دونَها المَزمومُ وَالرَمَلُ",17,"ل",1,0],["وحجاز راقص أو ها","ت من شط الفرات",18,"ت",1,0],["وحجّ بربعك بيتَ العلى","وطافَ به لا يملّ الزحاما",19,"م",2,0],["وَحُجراً وَاِمرَأَ القَيسِ بنَ حُجرٍ","لَيالي كاهِلٍ وَبَني مُعَينِ",20,"ن",1,0],["وحجَ إذا أردتَ فإنّ حجّي","إلى شُربِ المدامةِ بالبواطي",21,"ي",1,0],["وَحَجَّ كَلمِيَ بَعضُ الناسِ مُعتَمِراً","فَهَل أُلامُ عَلى حَجٍّ وَمُعتَمَرِ",22,"ر",1,0],["وحجابهم فتياتهم","عند الخروج من النظر",23,"ر",1,0],["وحج عنهم قضاءً بعدما ارتحلوا","قوم سيقضون عني بعد ترحالي",24,"ي",1,0],["وَحُجِّبَ مَيْمُونُ النَّقِيبَةِ عَنْ حِمىً","بَكَتْهُ أَدَانِيهِ أَسىً وَالأَبَاعِدُ",25,"د",1,0],["وحجىً يغلبُ الحجي ودهاءٌ","جلَّ فيه عن كل إنس وجن",26,"ن",1,0],["وحجبها عن ناظري الشمس فانثنت","تستر في ظل من الغيم ممتد",27,"د",1,0],["وحجُّوا إلى بيتٍ هو الفنُّ نفسُه","أنارَتْ \" فَنيسٌ \" ساحَه و\" عُطارد\"",28,"د",1,0],["وحُجَّتُهم أن كانَ فيما مضى لنا","أبٌ ، اسمهُ عندَ التواريخِ يَعْرُب",29,"ب",1,0],["وحجَّارٌ رأى طعني فنادى","تأَنى يا بنَ شدَّادِ تأَنى",30,"ن",2,0],["وحجت لعرفاني الرجال فضمخت","من الحال والذوق الشريف بطيب",31,"ب",1,0],["وحجازي الهوى أشواقه","أَصبحت أنى نحا الأردن تنحو",32,"ح",2,0],["وحَجَّ البيتَ مُمتَثِلاً ولبي","وطَافَ وزارَ زَمزَمَ والمُقَامَا",33,"م",2,0],["وَحُجَّتُهُم كانَت لِإِشكالِ طُرقِهِ","فَأَلّا وَقَد أَوضَحتَ لِلسالِكِ الطُرقا",34,"ق",2,0],["وَحَجَّ بعامِ العشرِ أفضلَ حجّةٍ","بِها ودّعَ الأصحابَ وَالبيتَ وَالحِجرا",35,"ر",2,0],["وَحَجَراً وَزَبّاناً وَإِن يَكُ مُلقِطٌ","توفِيَ فَليَغفِر لَهُ سائِرَ الذَنبِ",36,"ب",1,1],["وحُجَّةَ الله التي لَمْ تُرْدَدِ","بعد النبيّ المصطفَى محمّدِ",37,"د",1,0],["وحج إلى البيت المعظم في غنىً","وعافية وأضمم عيالي وأكنف",38,"ف",1,0],["وَحِجىً يُريكَ هِضابَ قُد","سٍ في النَدِيِّ إِذا اِحتَبا",39,"ب",2,0],["وَحَجٌّ تُجِيحُ الذ َّنْبَ بِيضُ ثَوَابِهِ","وَزَوْرَةُ مَنْ أَعْلَى الْوَرَى وَهْيَ أَغْفَالُ",40,"ل",1,0],["وحجب عن عيني اوجه عينها","وكن شموساً لا تغب طلوعا",41,"ع",2,0],["وحَجِّي إلَيْها واعْتِمارِي جَعَلته","وَذاك لَعَمري مُنتَهى شَرَف العُمْرِ",42,"ر",1,0],["وحجَّةُ اللَه الَّتي نورُها","كالصُبح لا يَخفى ولا يبلسُ",43,"س",1,0],["وحجبتها عمن يروم وصالها","وأين الثريا من يد المتناول",44,"ل",1,0],["وحجة محتج بتقدير ربه","تزيد عذاباً كاحتجاج مريضة",45,"ه",1,0],["وحج بيت الإله واترك جميع المناهي","ولا تجى للملاهي وكل خصله رديه",46,"ه",1,0],["وحج البيت طف واسع","واحلق قف بعرفات",47,"ت",1,0],["وحِجاكَ يهنو للندى ولربّما","قربُوا به طوْداً من الأطوادِ",48,"د",1,0],["وحج لبيت الله فرض ولازم","على كل حر بالغ صار قادرا",49,"ر",2,0],["وحجبتها العوالي فهي سارقة","معاني الهيف الموموق والهضمِ",50,"م",1,0],["وحجبتني فيها فما","لي غير أمي مربع",51,"ع",1,0],["وحُجَّتي وقُفولُ القومِ قافِلَةً","بكلِّ خيرٍ مَسيري نحو مَرْغوبي",52,"ي",1,0],["وَحَجّاً إِلى اللَهِ في بَيتِهِ","لِمَن كانَ ذاكَ لَهُ يَسهُلُ",53,"ل",1,0],["وحجتها فينا علينا عظيمة","وبرهانها بالحق للغير دامغ",54,"غ",1,0],["وحجة المحتج منا تلزمه","أن يطلب العلم الذي لا يعلمه",55,"ه",1,0],["وحَجيِّ إِلى حانوت راحٍ وراحَةٍ","وكعبةُ تَهادَى والعُقودُ حَبابُ",56,"ب",1,0],["وَحَجْبُكَ حَتّى لَوْ عَن الحُجْبِ تَتَّقي","حِجاباً ولا تَبْدُو لَهَا كُنْتَ تَفْعَلُ",57,"ل",1,0],["وَحَجْبُكَ حَتّى لَوْ عَنِ الحُجْبِ تَتَّقي","حِجاباً فلا تَبْدُو لَهَا كُنْتَ تَفْعَلُ",58,"ل",1,0]]}