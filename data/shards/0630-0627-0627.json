بان","https://www.poetsgate.com/ViewPoem.aspx?id=197870",""],[5057,"غاري","https://www.poetsgate.com/ViewPoem.aspx?id=184760",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[5376,"ذا الصبرُ مني يفتُّ الدمعَ في عضدي","https://www.poetsgate.com/ViewPoem.aspx?id=196897",""],[5376,"ذا الطفل في رجل يأبى مفارقة","https://www.poetsgate.com/ViewPoem.aspx?id=197715",""],[5376,"تراهمُ الحقلَ أم ذا القلبَ قد حرقوا","https://www.poetsgate.com/ViewPoem.aspx?id=204773",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5674,"طيف من قصيدة شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=191193",""],[5685,"في مدح الحبيب المصطفى صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=34734",""],[5690,"لهيكل الفضل أهدي النذر ملتمساً","https://www.poetsgate.com/ViewPoem.aspx?id=172220",""],[5804,"ما زلتُ حُرًّا","https://www.poetsgate.com/ViewPoem.aspx?id=184426",""],[5861,"نسيج آلامي","https://www.poetsgate.com/ViewPoem.aspx?id=188577",""],[6075,"النَّصْرُ آتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=190501",""],[6093,"رمضانُ أقبل ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176206",""],[6264,"الذكرى العطره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79131&r=&rc=39",""]],"verses":[["ذا الخُلُقِ الأَعلى فَخُذ نَهجَه","وَاِترُك إِلَيهِ الخُلُقَ الأَدوَنا",0,"ن",2,0],["ذا المَنزِلُ المِظعانُ قَد فارَقتَهُ","وَغَداً تُبَوَّءُ مَنزِلاً مِحلالا",1,"ل",2,0],["ذا الطَودُ بَقّاهُ الزَمانُ ذَخيرَةً","مِن ذَلِكَ الجَبَلِ العَظيمِ الراسي",2,"س",2,0],["ذا العُنُقِ الأَغلَبِ وَالوَجهِ الأَغَرّ","لَولاهُ ما لاقَوا بِعودي مِن خَوَر",3,"ر",1,0],["ذا الرقيب يجري وريّا","مثل قابض ببريا",4,"ي",2,0],["ذا القَدرَ إِن نَضِجَت وَعَج","جِل قَبلَهُ ما يَشتَوينا",5,"ن",2,0],["!ذا اِقتَسَمَ الناسُ فَضلَ الفَخارِ","أَطَلنا عَلى الأَرضِ مَيلَ العَصا",6,"ص",2,1],["ذا الحِجا منهُمُ وذا الحِلمِ والعل","مِ وجهلٌ ملامةُ الجُهَلاءِ",7,"ا",2,0],["ذا الحركاتِ في الحشا وإن سَجا","وصحنَ تلك الوجنة المضرَّجا",8,"ج",2,0],["ذا المستقى الطيب القريب وذا ال","غور الذي لا تناله المَكَره",9,"ر",2,0],["ذا المِرة الشَّزْرِ والمتانة وال","عقدةِ تحت السجية اليَسره",9,"ر",2,0],["ذا اللين سائل به المَلاين وال","شِدّة سائل به من اعْتَسره",9,"ر",2,0],["ذا الكرم العذب والمُناكرة ال","مرّة إن هاج هائجٌ وغَرهْ",9,"ر",2,0],["ذا الَّذي صَيَّرَ الكَدَر","إِكدارا",10,"ا",1,0],["ذا العامُ مَضى وَلَيتَ شِعري","هَل يُرجِعُ لي رِضاكَ قابِل",11,"ل",1,0],["ذا الَّذي كُنتِ تَلتَجينَ إِلَيهِ","لَيسَ مِنهُ إِلى سِواهُ النَجاءُ",12,"ا",2,0],["ذا السِراجُ المُنيرُ هَذا النَقِيُّ ال","جَيبِ هَذا بَقِيَّةُ الأَبدالِ",13,"ل",1,0],["ذا الَّذي أَنتَ جَدُّهُ وَأَبوهُ","دِنيَةً دونَ جَدِّهِ وَأَبيهِ",14,"ه",1,0],["ذا أَسَدُ اللَهِ وَفيهِ مَفخَرٌ","وَفاطِمٌ عُرسي وَفيها مَفخَرُ",15,"ر",1,0],["ذا السَعيُ قَد قَرَّت بِهِ عَينُ الوَرى","فَالمُلكُ يَزهو زِهوَةَ المُتَلَذِّذِ",16,"ذ",1,0],["ذا المجْدُ لا يُبْغَى سِواهُ وذا الذي","يبقى لآلِ محمّدٍ ويُؤثَّل",17,"ل",1,0],["ذا أهرَتٌ كشُدوقِ الأُسد قد رجفتْ","زأراً وهذا غَموسٌ كالأخاديد",18,"د",1,0],["ذا اِقتِناعٍ كَما أَنا اليَومُ فيهِ","أَو أَخلّى فَلا أَريمُ الضَريحا",19,"ح",2,0],["ذا المعاني الغرائب اللائي أسهرن","جفوني دهرا وتيّمن قلبي",20,"ي",1,0],["ذا الأُنسُ بَعدَكَ وَحشٌ","وَذي المَغاني قِفارُ",21,"ر",1,0],["ذا المَوتُ في كَفِّهِ سِهامٌ","لا التُركَ أَخطَت وَلا قُباذا",22,"ذ",2,0],["ذَا أفْزَعُوا أُمَّ الصَّبِيَّيْنِ نَفضُوا","غَفَارِيَّ شُعْثاً صَافَةً لَمْ تُرَجَّلِ",23,"ل",1,1],["ذا القدرَ إنْ نضِجتْ وعجِّ","لْ قبلهُ ما يشتوينا",24,"ن",2,0],["ذَا العطايا الغرِّ السنيَّ المحامِي","والمصافي العذبَ الحسامَ الحميدَا",25,"د",2,0],["ذا اختيارٍ وحكمةٍ واعتبارٍ","وقياسٍ وفطنةٍ ودَهاءِ",26,"ا",2,0],["ذا الغصنُ يَبكي على طُيورٍ","أطرَبَه شَدوُها اللَطيف",27,"ف",1,0],["ذا العَزمُ جَأشُ الدَهرِ مِنهُ مُرَوَّعٌ","وَالجَيشُ يَفتَرِسُ العِدى فُرسانُهُ",28,"ن",2,0],["ذا ألفٌ ليس لوصلٍ وذا","واوٌ ولكن ليس العاطفه",29,"ف",2,0],["ذا الوجه ليس بمغضوبٍ عليه ومَن","يغضب على مثل هذا الوجه قد خسرا",30,"ر",2,0],["ذا إِباءٍ آخِذُ الرِز","قَ بِحَدِّ السَيفِ عُنوه",31,"و",2,0],["ذا الجِذعُ في الماخورِ مَث","واهُ وَذا في المَسجِدُ",32,"د",1,0],["ذا اسفرت بسامةً خلت بارقاً","يقشع عن بدر السماء السحائبا",33,"ب",2,0],["ذا الوجيه الوجه في الدارين ذا","صيدي الشيخ العرابي عمرا",34,"ر",2,0],["ذا البدر ذا القطر ذا البحر المحيط غني","زاكي المناصب سامي القدر والهمم",35,"م",1,0],["ذا الكامل الفاضل الفياض ناثله","غوث العَشائر غيث الخير وَالنعم",35,"م",1,0],["ذا الابلج المتقى من أمة وسط","مخاطبينبكنتم خير في القدم",35,"م",1,0],["ذا البحر علما ذا النجوم طَلائعا","ذا الصخر حلما ذا الغَمامَة جودا",36,"د",2,0],["ذا العالم السنى ذا العلم الَّذي","بالعلم وَالحلم اِستَقام رَشيدا",36,"د",2,0],["ذا ابن الحسين وَذا أَخوه فَتى ابي","بكرهما سر الوجود هما هما",37,"م",2,0],["ذا الدَّهر ما في بَنيهِ","لِفاضِلٍ مِن مُصيخِ",38,"خ",1,0],["ذا أوانُ السرورِ فَاِستوف منه ال","حظّ حثّاً بمترعات الأواني",39,"ن",2,0],["ذا اِذا زدته من اللَثم يردا","د اِحمِرارا وَذاكَ ان زدته جَف",40,"ف",1,0],["ذا امتعاضٍ أُخفي اختلالي عنِ الرَّا","ئي كإخفاءِ واصلٍ للرّاء",41,"ا",2,0],["ذا انصرفت نحو المعالي فعالُه","يؤخِّرها خِزياً وهيْ تتصرف",42,"ف",1,0],["ذا الصهوات البادن الممرا","لا يبوح المنزل الا جرا",43,"ر",2,0],["ذا الحق صدقا يقينا ليس حدسا وظن","كم جات آيات معروفه لأهل الفطن",44,"ن",1,0],["ذا الموحد لا سواه","فافهم القول يا غلام",45,"م",1,0],["ذا السيف ما جرّدْتَ لي بعضَه","إلا ولي في ذاك تحذيرُ",46,"ر",1,0],["ذا الماءُ ذاك وهذي الشمسُ تلك وما","حالا وقد حالت الألوانُ والطُّعُمُ",47,"م",1,0],["ذا الروضُ من ذاك الغمامِ المنجلي","والنُّورُ من ذاك الشهاب الآفلِ",48,"ل",1,0],["ذا الصدر يهزأُ بالقضاءِ إذا بكت","مقلُ الظّبى لتضايق المُرَّان",49,"ن",1,0],["ذا السيف قد جرت الدماء على","صفحاتهِ كمدارج النمل",50,"ل",1,0],["ذا القلبُ شبَّ لظاهُ جفنٌ واكفٌ","ما ذاق طرفُ النجمِ مثلَ سهاده",51,"د",2,0],["ذا المَجدُ يا فاصِداً أعراقَهُ جَذِلا ً","أنْ يَشرَبَ النَّاسُ منها عَلقَماً عَذِبا !",52,"ب",2,0],["ذا المَجْدُ يا مُطعِماً مِن لحْم ِصِبْيَتِهِ","جُوعَ الجياعِ وَهُم أشجى الوَرى سَغَبا !",52,"ب",2,0],["ذا النُصحِ غِشٌّ لا مَحالَةَ مِنكَ لي","إِذا كُنتَ تَعلَمُ أَنَّ فَقدي فَقدُهُ",53,"د",2,0],["ذا الدُرُّ مَن كانَ دُرّاً فَهوَ يَلبَسُهُ","فَكَيفَ يَنفُقُ وَالأَقوامُ مُخشَلَبُ",54,"ب",1,0],["ذا الاِجْتهادِ الْمُطْلَقِ","سَبْاقَ كُلِّ سابِقِ",55,"ق",1,0],["ذا اختلافٌ مَعَهُ فِي","خَيرِ مَوضُوعٍ شَريفِ",56,"ف",1,0],["ذا اليومُ تَحسدُ مجدَه الأيامُ","هو سيِّدٌ وجميعُها خُدَّامُ",57,"م",1,1],["ذا الخُلقُ فاوَحَهُ نَسيمُ الصُّبحِ هَب","بَ على ريَاضِ اليَاسمينَ عَليلا",58,"ل",2,0],["ذا الذي كل من لم يتبعه ولا","يرتاب ذو العقل في نار الجحيم رُمي",59,"م",2,0],["ذا التجافي كم أكابده","آهِ قلَّت في الهوى حيلي",60,"ل",2,0],["ذا القدر ذاك الذي الضمير له","ينزل من غيبه إلى الجمع",61,"ع",1,0],["ذا أَكلُبٍ كَالأَقدُحِ الأَمراطِ","وَاَنصاعَ بَينَ الكَبنِ وَالإِبعاطِ",62,"ط",1,0],["ذا الإحتفا بك يا ابن إسماعيل لم","تره عيون ملوكنا القدماء",63,"ا",2,0],["ذا الحلم قد شق الوداع لاننا","كل الخصال الغر فيك نودع",64,"ع",1,0],["ذا الوصيف وصفوا كمل","من تجنيه يا للا سلام",65,"م",1,0],["ذا ابتداء مع النبي يعاني","حرب أعدائه وذا منتهاه",66,"ا",2,0],["ذا أبو البدر مَن بِفيضِ نداهُ","قَد جرَت أبحرٌ وسال غمامُ",67,"م",1,0],["ذا الخِلالِ المُهذَّباتِ وذا الطَّبعِ","المصفَّى وذا السَّجايا العِتاقِ",68,"ق",1,0],["ذَا النّيلُ مَا يَبْرَحُ في سَعْده","وَحَالَهُ الْمَاشيَ مَا خَالا",69,"ل",2,1],["ذا التجنّي قد كان منكَ ملالاً","ليس وحياً فامدد حبال التنائِي",70,"ي",1,0],["ذا الفنُّ منك بكَ استنار وانني","لَعَلَى كتابكَ في الصبا عُلّمتُهُ",71,"ت",2,0],["ذا الحِلْمِ والصّفحِ والعلمِ الذي بَهَرَتْ","أنوارُ أنواعِه مَنْ ظَلَّ مُقْتَبِسَا",72,"س",2,0],["ذا العَيشُ لا نَعتُ المَهامِهِ وَالفَلا","وَسُؤالُ رَسمِ الدارِ وَالأَحجارِ",73,"ر",1,0],["ذا العَيشُ فَاِفطُن لَهُ وَبادِر","مِن قَبلِ أَن يَفطُنَ الحِمامُ",74,"م",1,0],["ذا أغلب الشعراء شي","طاناً وألطفهم ملكْ",75,"ك",1,0],["ذا إذا جاحمُ الجحيمِ شفى الغي","طَ امتخاخاً أنقاءهم وامتشاشا",76,"ش",2,0],["ذا الشاعر الضبيُّ يَلْقَى بكم","ما ليسَ يَلْقَى بكمُ شاعرُ",77,"ر",1,0],["ذا الحوضُ يا هذا الوزي","ر لا اِرتيابَ خيرُكما",78,"م",2,1],["ذا المَسيري محمّد بَحرُ عِلمٍ","مُفردُ الدّهرِ قَد خَلا عَن نَظيرِ",79,"ر",1,0],["ذا الكَلبُ مِن مشرعِ البُهتانِ قَد وَلَغا","وَأَكث