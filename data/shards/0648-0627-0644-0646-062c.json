َتِيْ .. وَالْبَدْرُ خَاْتَمُهُ","وَالأُفْقُ رَاْحِلَتِيْ لِلنَّاْسِ تَحْكِيْهِ",129,"ي",2,0],["وَالنَّجْمُ مَسْرَجَتِيْ وَالْأُفُقُ صَاْحِبَتِيْ","وَالنُّوْرُ مَرْكَبَتِيْ وَالْغَيْثُ فِِيْ قِرَبِيْ",130,"ب",2,0],["وَالْنَّجْمُ مِنْ نُورِهِ الْبَرَّاقِ مُرْتَحِلٌ","فِي مُقْلَةٍ عَانَقَتْ سِحْراً مِنَ الْعُرْبِ",131,"ب",1,0],["وَالْنَّجْمُ فِي عَيْنِي يُرَاقِبُ نَجْمَهُ","فَانْسَلَّ مِنْهُ الْنُّورُ فِي رُوحِي سَلَكْ",132,"ك",1,0],["وَالنَّجْمُ ذَا الْلَّأْلاءُ فِي عَلْيَائِهِ","شَمْسٌ تَرَاءَتْ مِنْ سَنَا صَلَوَاتِهَا",133,"ت",3,0],["وَالنَّجْمُ مِنْ نُورِهِ الْبَرَّاقِ مُرْتَحِلٌ","فِي مُقْلَةٍ عَانَقَتْ سِحْراً بِذِي الْغَسَقِ",134,"ق",1,0],["والنجم حين هوى على متطفل","للسمع أرداه على أذقانه",135,"ن",2,0],["وألِن جانب راع محسن","لوليٍّ حقه قد وجبا",136,"ب",2,0],["والنجم يشهد للحيارى أنهم","كم ساهروا بدر الدجى بعلاك",137,"ك",1,0],["والنجم يشهد لي والناس إذ رقدت","أني أعاين طيفا من سجاياه",138,"ا",2,0],["والنّجمةُ تُخفي وَمْضَتَها","قلبي الولهانُ تُسَهِّدُهُ",139,"د",2,0],["والنّجمةُ عادتْ ومْضَتُها","والقلبُ يَدُقُّ تَرَدُّدُهُ",139,"د",2,0],["والنجاح يفرّح أصحاب النقى","ويِزعل أصحاب المنافق والمزوح..",140,"ح",1,0],["والنجم يبكي النيرين غياهبا","لم تعطهِ من نور وجهك مسطعا",141,"ع",2,0],["والنجاشي إذا رآه عيناً","وهو من فوق نعشه محمول",142,"ل",1,0],["وَ النَّجْمُ يَشْكِي ظَلَامَ اللَّيْلِ مُرْتَعِبُا","مَا عَادَ يَنْفَعُهُ لَيْلٌ فَيَبْتَسِمُ",143,"م",1,0],["والنَّجْمُ والشّمْسُ والأشْجارُ شادِيةٌ","والزّهْرُ في روْضِهِ للكَوْنِ يُنْشِدُهُ",144,"د",2,0],["والنجم من فلك النحور إذا هوى","ما ضل من يهوى الحسان وما غوى",145,"و",2,1],["والنجم يغفو جماناً في قلادتها","مثل الشموس وعين للدجى سملت",146,"ت",1,0],["والنَّجمُ في سربِه عتيٌّ","له بهذا الجوى بروزُ",147,"ز",1,0],["والنجوم اللامعه حول المكان","ترسم البسمه على ثغر الغدير",148,"ر",1,0],["والنجوم انته مضوِّيها","والليالي وجوّها السحري",149,"ر",2,0],["والنّجومُ الخُضرُ راحتْ في دمكْ","تَرتوي منْ رائقٍ قدْ أوجعكْ",150,"ك",1,0],["والنجومُ الزرقُ راحتْ تحتوي في","غربةِ الأوهامِ لحنًا قد شجاكَ",151,"ك",1,0],["والنجمُ يسرق 