كَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5121,"دوحة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=36288",""],[5121,"كالفلك","https://www.poetsgate.com/ViewPoem.aspx?id=37452",""],[5121,"دُرَّةُ الوَفَاء / أختي إبتهال","https://www.poetsgate.com/ViewPoem.aspx?id=49549",""],[5121,"كُؤُوس","https://www.poetsgate.com/ViewPoem.aspx?id=215873",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5183,"الهمة الوثابة","https://www.poetsgate.com/ViewPoem.aspx?id=185637",""],[5219,"رفقا حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=193790",""],[5219,"يا مدعي الحب","https://www.poetsgate.com/ViewPoem.aspx?id=193970",""],[5277,"ما عُدْتُ أقولُ: متى غدُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=200888",""],[5344,"الفلو والباك (برامج التواصل)..","https://www.poetsgate.com/ViewPoem.aspx?id=180702",""],[5436,"لي فيك شكوى / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177539",""],[5442,"ليس بعد السبعين إلا الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114787",""],[5587,"ماذا أقول","https://www.poetsgate.com/ViewPoem.aspx?id=195385",""],[5612,"صَلُّوا عَليْه","https://www.poetsgate.com/ViewPoem.aspx?id=179970",""],[2110,"والنجم من فلك النحور إذا هوى","https://www.poetsgate.com/ViewPoem.aspx?id=156289",""],[5725,"سلوا عيون المها","https://www.poetsgate.com/ViewPoem.aspx?id=180320",""],[5910,"وهمسةٌ أتبعتْ فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=207788",""],[5974,"حكاية فلّ","https://www.poetsgate.com/ViewPoem.aspx?id=216007",""],[6001,"أبو ظبي","https://www.poetsgate.com/ViewPoem.aspx?id=375",""],[6124,"نكتب الأوتار","https://www.poetsgate.com/ViewPoem.aspx?id=121830",""],[6124,"فسيفساء","https://www.poetsgate.com/ViewPoem.aspx?id=159786",""],[6152,"لا حب بعدك","https://www.poetsgate.com/ViewPoem.aspx?id=201867",""],[6152,"حورية الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=203287",""],[6213,"أرض ونجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76296&r=&rc=44",""],[572,"ياريمُ كمْ أدنو وأنتَ ترِيمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9467&r=&rc=324",""]],"verses":[["وَالنَجمُ وَجهُ مُقَبَّلٍ","وَالبَدرُ مِرآةٌ صَدِيَّه",0,"ي",2,0],["والنُّجْعُ يَضْمَنُهُ لمَنْ يرْتادُها","مِنْكَ الطّلاقَةُ والجَبينُ الأزهَرُ",1,"ر",1,0],["والنَّجْمُ يَعْثُرُ بالظَّلامِ فيَشْتَكي","ظَلَعاً ليَجْذِبَ ضَبْعَهُ العَيُّوقُ",2,"ق",1,0],["وَالنَجمَ في كَبِدِ السَماءِ كَأَنَّهُ","أَعمى تَحَيَّرَ ما لَدَيهِ قائِدُ",3,"د",1,0],["والنّجْمِ الثّاقِبِ حينَ هَوى","رجْماً والصُبْحِ إذا انْفَلَقا",4,"ق",2,0],["وَالنَجمُ يَعجَبُ مِن أَمري وَيَحسَبُني","لَدى السُرى ثامِناً لِلسَبعَةِ الشُهُبِ",5,"ب",1,0],["وَالنَجمَ لا يَزهَرُ في أُفقِهِ","كَأَنَّهُ في غَمرَةٍ يَسبَحُ",6,"ح",1,0],["والنجوم في يده","تغتدي وتنتقل",7,"ل",1,0],["والنجوم التي تلوح وتخفي","ربوات وما يضيق الأثير",8,"ر",1,0],["وَالنَجمُ بَينَ القِمِّ وَالتَعريدِ","تُحَلِّقُ الجَوزاءُ في صُعودِ",9,"د",1,0],["والنجوم ينظم قلادا","بسعود وبمن طائر",10,"ر",1,0],["والنجمُ يسري من دجاه بأدهمٍ","رحب المقلّدِ بالثريا مُلجمِ",11,"م",1,0],["والنجم في القبة الزرقاء تحسبه","فرائداً وهي من فيروزج سفط",12,"ط",1,0],["وَالنُجومُ الَّتي تَتابَعُ بِاللَي","لِ وَفيها ذاتَ اليَمينِ اِزوِرارُ",13,"ر",1,0],["والنجم في الأفق الغربي منحدر","كشعلة سقطت من كف مقتبس",14,"س",1,0],["والنجم من كأس الحبيب وخدِّه","لا زاغ فكري عن هواه ولا لها",15,"ل",3,0],["والنجم مضطرب الخطا","والفلك في الظلمات ماخر",16,"ر",1,0],["وَالنَجمُ لَم يَرَنا إِلّا عَلى قَدَمٍ","قِيامَ لَيلِ الهَوى لِلعَهدِ راعينا",17,"ن",2,0],["وَالنَجمُ يَبعَثُ لِلمِياهِ ضِياءَهُ","وَالكَهرُباءُ تُضيءُ أَثناءَ الثَرى",18,"ر",2,0],["وَالنَجمُ يَلحَظُنا بِعَي","نٍ ما تَحولُ وَلا تَحيد",19,"د",1,0],["والنُّجومَ التي تَظَلُّ نجومُ ال","جَوِّ حُسَّادَها على الإشراقِ",20,"ق",1,0],["وَأَلِن جَناحَكَ تَعتَقِد","في الناسِ مَحمَدَةً بِلينِه",21,"ن",2,0],["وَالنَجمُ لا يَهدي السَبيلَ سارِياً","إِلّا إِذا أَسفَرَ مِن حِجابِهِ",22,"ب",2,0],["والنَّجمِ فِي خَدّ الحَبِيبِ إذا هَوى","مَا ضلَّ قَلبِي عَن هَواهُ ومَا غَوى",23,"و",2,1],["وَالنَجمُ في حَوضِ الغُروبِ وارِدُ","وَالفَجرُ في إِثرِ الظَلامِ طارِدُ",24,"د",1,0],["وَالنَجمُ في اللَيلِ البَهيمِ تَخالُهُ","عَيناً تُخالِسُ غَفلَةَ الرُقَباءِ",25,"ا",2,1],["وَالنَجاشِيُّ صارَ مَلكَ أُناسٍ","بَعدَما هَمَّ أَن يُعِدَّ جَليبا",26,"ب",2,0],["وَالنَجلُ إِن بَرّاً وَإِن فاجِراً","كَالغُصنِ مِن أَصلِ أَبيهِ فُسِخ",27,"خ",1,0],["والنّجْمُ تستصْغِرُ الأبصارُ صورتَه","والذنْبُ للطَّرْفِ لا للنجمِ في الصّغَرِ",28,"ر",1,0],["والنجم أجمل شيء","يبين في الظلمات",29,"ت",1,0],["والنَّجمُ أشواقٌ فمهجة عاشقٍ","وذراعُ مُعتنِقٍ ووجنةُ عاصرِ",30,"ر",1,0],["والنجم لو سرت الحياة به هوى","وانحط عن أوج الهواء إلى الهُوَى",31,"ه",3,0],["والنَّجْمُ تحْسَبُهُ قدّامَ تابِعِهِ","حَمامةً رامَها في الجَوِّ بازِيُّ",32,"ي",1,0],["وَالنُّجْحُ فِي الْعَمَلِ الْ","حُرِّ أَنْ تلائِمَ ظَرْفَهْ",33,"ف",2,0],["والنجومُ التي تُطِلُّ عليه","في دجى الليل تُنْكِرُ السُّكَّانا",34,"ن",2,0],["والنجمُ حارسُها وحارسُه","والظلُّ موعدُها وموعده",35,"د",2,0],["والنجمُ يبعث للمياه ضيائه","والكهرباءُ تضيءُ أثناءَ الثرى",36,"ر",2,0],["والنجم في المركز الاعلى بموقعه","سام وراصده بالوهم يقتات",37,"ت",1,0],["والنجمُ لو لم يسرِ في جُنحِ الدجا","ورأى دليلاً من هُداهُ لما اهتدى",38,"د",2,0],["وَالنَجمُ لَيسَ بِمُعلٍ نَجمَ صاحِبِهِ","ما لَم يُؤَيِّدهُ جِدٌّ يَخرُقُ الحُجُبا",39,"ب",2,0],["والنجمُ في نشوةٍ مما ينادمنا","والحليُ في طربٍ مما يُغنينا",40,"ن",2,0],["والنجمُ يحتثّ الهلالَ كراحة","أومأ إليه بَنانُها بسلام",41,"م",1,0],["والنُّجْلُ لو لم يكن بها نَجَلُ","ما تَمّ في عاشِقٍ لها عَمَلُ",42,"ل",1,0],["وَالنُّجْحُ دَانٍ وَالْوَقَا","رُ يَحُفُّ مِنْهُ أَغَرَّ أَوْحَدْ",43,"د",1,0],["والنجمُ يؤنسُ رعياناً ويهديها","ونجمَتي الغيمةُ السوداءُ تخفيها",44,"ه",2,0],["والنَّجمُ يرجفُ كالقلوبِ وتحتَهُ","بتنا نحنُّ إلى الأحبّةِ هُجَّسا",45,"س",2,0],["والنجمُ أشرقَ عند قُبلتِنا","والموجُ حيّاني وحيّاكِ",46,"ك",1,0],["والنّجْمُ يُسْعِدُه عَلى خلْعِ الكَرى","ومِن الشّقَاوَةِ في الهَوى إِسْعادُهُ",47,"د",2,0],["وَالنّجفُ الأَشرفُ بانَت لَنا","أَعلامُهُ وَالمَعهَدُ الأَنفَسُ",48,"س",1,0],["وَالنَجباءُ عَدُّ أَح","رُفِ الكِتابِ المُستَطَر",49,"ر",1,0],["والنَّجمُ قد أطَبقَ أجفانَه","والنَّومُ قد أطْلَقَ أسْراه",50,"ا",2,0],["والنَّجمُ يَحْكي بُعْدَ غَورِك إن هوَى","وإذا سما يَحكي عُلُوًّ المَنصب",51,"ب",1,0],["وَالنَجمُ مُشفٍ مُدنَفٌ","مِن لَونِهِ الشَفَقيِّ مُشفِق",52,"ق",1,0],["وَالنجم أَحير مِن شَجيّ قَد رَأى","هَول النَوى وَشماتة الحُسّادِ",53,"د",1,0],["وَالنجم يَجنَح لِلغُروب وَقد","قَصَّ الصَباح قَوادم النسر",54,"ر",1,0],["والنجاة إن تردها إنها","في خمول وسكوت واعتزال",55,"ل",1,0],["والنَّجْمُ يرقبه بعين رقيبه","والبَدْر يلحظه بلحظ حسوده",56,"د",2,0],["والنجم يصرف للغروب عنانه","حتَّى بصرت به كليل الناظر",57,"ر",1,0],["والنجوم امتثلت ما قد أمر","أين حال القانع الساكن في",58,"ي",1,0],["والنجم في الأفق المغرّب رايةٌ","بيضاءَ أو خدّ الحصان الملجَمِ",59,"م",1,0],["والنجمُ حيٌّ نبضُه راسبٌ","في لجّة الخضراء لم يغرقِ",60,"ق",1,0],["والنجمُ يحمل كأسها","منها الحبابُ بغير راحِ",61,"ح",1,0],["والنُّجوم الشُّهْب من ولْدِ العُلى","عُدَّةُ الدينِ واعْدادُ المَوالي",62,"ل",2,0],["والنجم في جنح الظلام ضياؤه","ومن السواد اشتق طعم السؤدد",63,"د",1,0],["والنجمُ خفَّاقٌ كمقلةِ خائفٍ","مترقبٍ أو مثل قلبِ مروَّع",64,"ع",1,0],["والنجم يظهر في الدُّجى","وظهور نجم الدين سرمد",65,"د",1,0],["والنجمُ غارَ على جوادٍ أدهمٍ","والفجرُ أقبل فوقَ صهوةِ أشقرِ",66,"ر",1,0],["وَالنُجباءَ عِدَّة سَبعونا","في مِصرَ لِلأَنامِ هُم يَدعونا",67,"ن",2,0],["وَالنَّجْمُ فِي أُفُقِ الغُرُوبِ كَأَنَّهُ","كَأْسٌ عَلَيْهَا لُؤْلُؤٌ مَنْظُومُ",68,"م",1,0],["وَالنَّجْمُ كَالْقُرْط وَهَى","عِنْدَ العِنَاقِ فَسَقَطْ",69,"ط",1,0],["وَالنَّجْمُ أَقْرَبُ مِنْ لِقَاكَ مَنَالُهُ","عِنْدِي وَأَبْعَدُ مِنْ رِضَاكَ مَغِيبُهُ",70,"ب",2,0],["والنجحُ يألف مُن منهُ الخطى سلكت","محجة الرشد عنها الدهر ما انحرفا",71,"ف",2,0],["والنجم يطلع ثم يأفل إنما","أنوار وجهك لازمتك فلم تغب",72,"ب",1,0],["والنَّجمُ أقربُ من سِرِّي إذا اشتَمَلَت","مِنِّى على السِّرِّ أضلاعٌ وأَحشاءُ",73,"ا",2,1],["والنجمُ في أفق السماءِ كأنه","عينٌ تخالسُ أعينَ الرقباء",74,"ا",2,0],["وَالنّجمُ أَزهَرَ بِالأَضواءِ في طربٍ","وَاِزدادَ مِن بشرهِ لَيلاً تزاهيهِ",75,"ي",2,0],["والنجمُ والبازُ والعفريتُ إن لحقتْ","بلاحق الخيرِ وافاها سرورُهم",76,"م",1,0],["وَالنجم سَرَى وللغُروبِ ارْتَحَلاَ","حَتَّى انْتَحَلاَ",77,"ل",2,0],["وَالنَّجم يَخفق فَوقَ أَتلعها وَلا","كَمقلد الجَوزاء في لباتها",78,"ت",3,0],["والنجم في داره هوى","كانشقاق البدر للمصطفى وهالته",79,"ت",2,0],["والنجمُ في أفقٍ يذوب صبابةً","يهفو لبدرٍ إذ يضئ ويَسرحُ",80,"ح",1,0],["وَالنَّجمُ فِي جَبهَتِهِ إِذَا بَدَا","فَالعَضبُ وَالجَبهَةُ لِي مَالٌ قَمن",81,"ن",1,0],["والنَّجم حار فما يطاق لحاقه","والسّيف جار فما يُشقُّ غُبارُهُ",82,"ر",2,0],["وَالنَجمُ مَسلوبُ السَنا وَقَدِ اِنطَفى","طَفَأَ الشَرارِ عَلى ثِقابَةِ مَوئِدِ",83,"د",1,0],["والنجم ينظر دمع عيني وحده","ولليل يسمع وحده أناتي",84,"ت",2,0],["والنجم من فلَلَكِ النحور إذا هوى","ما ضلّ من يهوى الحسان ولا غوى",85,"و",2,1],["والنَجمُ مِنه ساقطٌ","لَمَّا أخَذتَ الإرتِفَاع",86,"ع",1,0],["والنجم يشهد أنه مذ غاب عن","عيني لم ابرح حليفَ سهاد",87,"د",1,0],["وَالنَجمُ يَرحَمُني مِمّا أُكابِدُهُ","وَأَنتَ في غَفلَةٍ عَمّا أُقاسيهِ",88,"ي",2,0],["والنجم في الماء مثل وصفي","عال ودان لمن دعاني",89,"ن",2,0],["وَالنَّجمُ لا شَكَّ على العواري","وَالكَبشِ فَآفهَم هَذهِ المجاري",90,"ي",1,0],["والنجم لي راق والرحمن يرحمني","تبارك الله أصل الواقعة مني",91,"ي",1,0],["والنجم حيران في الدياجي","ليس بخابٍ ولا منير",92,"ر",1,0],["والنجومُ الزهرآءُ في جبهةِ","الشرقِ تمنّت لو أصبحت لك دارا",93,"ر",2,0],["والنجوم الشهب أرخت جفنها","وسناها صار في الكون ضئيلا",94,"ل",2,0],["والنجم ما قصت من المعراج في","آياتها من محكم التبيان",95,"ن",1,0],["والنَّجْمُ كحَّلَه الظلامُ بإثْمِدٍ","مُذْ خالَه في الجَوِّ طَرْفاً أرْمَدَا",96,"د",2,0],["والنجمُ يَرْمُق من وراءِ غمامةٍ","والصبحُ كَرَّ وللظلامِ فرار",97,"ر",1,0],["والنجمةُ الغرّاءُ في أفقها","يحجبها عن العُيونِ الضّباب",98,"ب",1,0],["والنجم قد حاز في أفق السماء فما","يمضي ولا هو للتغوير منصرفا",99,"ف",2,0],["والنجم منهزم أولى كتائبه","والصبح يغسل ثوب الليل من درن",100,"ن",1,0],["وَالنَجمُ يَخبو تارَةً وَيأتلِق","مثلَ عُيونٍ كابَدَت طولَ الأَرَق",101,"ق",1,0],["والنجم من فوقهِ قناديل أو","أقراط ماسٍ تعلقت جهرا",102,"ر",2,0],["والنجومُ سفنٌ قد غرقت"