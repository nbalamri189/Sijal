لخفيف"],[4802,"كيف أصونك","https://www.poetsgate.com/ViewPoem.aspx?id=34414",""],[5045,"شعاري المجد","https://www.poetsgate.com/ViewPoem.aspx?id=184874",""],[5055,"مصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=105167",""],[5281,"مُقلةُ الحُسْنِ..رسولنا محمدٌ صلى الله عليه وسلَّم","https://www.poetsgate.com/ViewPoem.aspx?id=200143",""],[5527,"قصيدة الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180853",""],[5691,"الأماني الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=206740",""],[5792,"ارحم عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=180359",""],[6243,"موحَش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84432&r=&rc=6",""],[463,"هل عند عينيك على غربِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59971&r=&rc=27",""],[6359,"نخلة الوادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69091&r=&rc=5",""]],"verses":[["مُوحِياً مَا يُرَى لِعِزَّةِ مِصْرَ","مِنْ صَلاَحٍ فِي حَالِهَا وَالمَآلِ",0,"ل",1,0],["موحِشاً ما تَرى بِهِ أَحَداً","تَنتَسِجُ الريحُ تُربَ مُعتَدِلِه",1,"ل",2,0],["موحشات لكنما كن ألافي","ومهد الهنيء من أزماني",2,"ي",1,0],["موحِشاً بَعدَما أَراهُ أَنيساً","مِن أُناسٍ يَبنونَ فيهِ القِبابا",3,"ب",2,0],["مُوحِشاتٍ رَأدَ النَهارِ وَلا تُس","طاعَ بَينَ العِشاءِ وَالتَسحيرِ",4,"ر",1,0],["مُوحَشاً فِي مَجَاهِلِ النُّوبِ وَالسُّو","دَانِ بَيْنَ الأغْوَارِ وَالانْجَادِ",5,"د",1,0],["موحشة إلا كناس اعفر","ومجثم الرأل وافحوص القطا",6,"ا",1,0],["موحش يحضن الفراغ على الصمت","كما تحضن الرياح الغبارا",7,"ر",2,0],["موحشات يطوف في صمتها","الدّهر فللدّهر وحشة وذهول",8,"ل",1,0],["موحدون فلا يلوون أعينهم","سِراً وجهراً لغير الله إن رمقوا",9,"ق",3,0],["موحِشَةً في ذلِكَ المَسكَنِ","وَقَد سَطا النَومُ عَلى الأَعيُنِ",10,"ن",1,0],["موحشي رفقاً بحالي","عَلَّ خطباً ما دهاني",11,"ن",2,0],["موحِشاتٍ طامِساتٍ","مِثلِ آياتِ الزَبورِ",12,"ر",1,0],["موحياتي منه ومني له الوحي","وفي نظرتي إلى الحسن غضي",13,"ض",2,0],["موحّدٌ لو نخلَتْ كفّهُ","عن مثليَ الغبراءَ لم تلحَقِ",14,"ق",1,0],["موحّد الملك لا تُدعَى بتثنيةٍ","إلا بنيك وشبلُ الليث تابعُهُ",15,"ع",2,0],["مُوَحَّدُ الرَأيِ تَنشَقُّ الظُنونُ لَهُ","عَن كُلِّ مُلتَبِسٍ مِنها وَمَعقودِ",16,"د",1,0],["موحِشاتٌ إِلى تَعاهِنَ فَالسُق","يا قِفارٌ مِن عَبدِ شَمسٍ خَلاءُ",17,"ا",2,0],["مُوَحَّشَةِ الجَوانِبِ ما ثَناها","مُناوحَةُ الرياح ولا رياحا",18,"ح",2,0],["موحدة في الخلق وهي كثير","بأفعالها فيه وفيه لها الحكم",19,"م",1,0],["موحٍ إلى ناطقٍ نُطْقاً بغير فمٍ","فالعينُ تسمعُ دونَ الأذْنِ منْطِقَه",20,"ق",2,0],["مُوحِشَاتٍ من الأنيسِ بهَا الوَحْ","شُ خنَاظِيلُ موطِنٍ أو بنيّهْ",21,"ي",2,0],["موحشات من الأنيس قفارا","دارسات بالنقف من أملال",22,"ل",1,0],["موحد يرفع فوق القنا","من العدا بالطعن صلبانا",23,"ن",2,0],["مُوَحَّدُ الذاتِ لا تُحصى مَحاسِنُهُ","بالطَرفِ مُبتذلٌ بِالسَيفِ مَحمِي",24,"ي",1,0],["مُوحِشٍ كالثقيل تقذى به الع","ين وتأبى حديثَهُ الأسماع",25,"ع",1,0],["مو حقي أحلم وأرسم لغيري أحلام","الا... بشعرٍ ما... يضلل.... عيونك",26,"ك",1,1],["موحد النبظ متناسق مع الكلمة","وشور واحد يجمعنا ورأي وحيد",27,"د",1,0],["موحشات الدار ف عيونك كسافه","كل شيءٍ فيك مكتوبٍ عليه",28,"ي",2,0],["مُوَحِّدًا وَاحِدًا مَا مِثْلهُ أَحَدٌ","سُبْحَانَ مَنْ قَسَّمَ الإِيْمَانَ وَالنِّعَمَا",29,"م",2,0],["موحَّدونَ كبيتٍ واحدٍ جمعت","شتّى لُباناتِهِ في العيشِ أرحامُ",30,"م",1,0],["موحش ٍقفر ٍكئيبٍ","شوّهَ التغريب ُجيلهْ",31,"ل",2,0],["مو حب هذا اللي تسويه فيني","في فرق بين الحب واللي تسويه",32,"ي",2,0],["مو حب هذا اللي يسويه فيني","في فرق بين الحب واللي يسويه",32,"ي",2,0],["مُوحَش أن يعود وسْطِي الهطول ُ","أو تُريق الشّتاءَ حَوْلي الطّلول ُ",33,"ل",1,1],["موحدٍ لم يشكُ من دهره","وأهلهِ إلا إلى مذنبِ",34,"ب",1,0],["موحشة ، كن ما قد حلّ حولك بشر","ولاتنفس بواديك النسيم العليل",35,"ل",1,0]]}