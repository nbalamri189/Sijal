bi.ae/diwan/poem/203806",""],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107296","الطويل"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107042","المتقارب"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119604","البسيط"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105158","السريع"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66182","الكامل"],[4701,"للقدس هدية عيد الميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=48453",""],[4755,"أَمسَى ولِلإعدام في صَدرهَ","https://www.poetsgate.com/ViewPoem.aspx?id=187416",""],[4767,"الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=179781",""],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4898,"هذا هُو المختارُ !","https://www.poetsgate.com/ViewPoem.aspx?id=180920",""],[4909,"جعل مني خادمة","https://www.poetsgate.com/ViewPoem.aspx?id=197352",""],[4968,"معزوفة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=208095",""],[4978,"همس الشفاه حرير في المناجاةِ","https://www.poetsgate.com/ViewPoem.aspx?id=177204",""],[5106,"مِنْ ضَوْءِ أَلْفِ صَبَاْحٍ قَدْ سَرَىْ","https://www.poetsgate.com/ViewPoem.aspx?id=150036",""],[5397,"هل من ضناي معالج يبريني","https://www.poetsgate.com/ViewPoem.aspx?id=157932",""],[5525,"عز الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=30107",""],[5596,"تقريظ كتاب التاريخ الإباضي","https://www.poetsgate.com/ViewPoem.aspx?id=206483",""],[5882,"رباعيات واوبة 4","https://www.poetsgate.com/ViewPoem.aspx?id=209025",""],[5937,"إلى شاعرٍ في الرُكن","https://www.poetsgate.com/ViewPoem.aspx?id=211897",""],[5939,"زئير الحر","https://www.poetsgate.com/ViewPoem.aspx?id=195327",""],[5943,"ثوبُ العفيفةِ","https://www.poetsgate.com/ViewPoem.aspx?id=46743",""],[6093,"يا عاذلَ الدَّمْعِ إنْ أجراهْ إنسانُ ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176207",""],[6093,"الدِّبْسُ مَهْمَا حَلَا لَنْ يَبْلُغَ العَسَلا","https://www.poetsgate.com/ViewPoem.aspx?id=191372",""],[6152,"حكايا الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=201766",""],[5309,"في السوق الاف من الأدباء","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573900",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""]],"verses":[["في السَلمِ دافِقَةٌ شُؤبوبُها خَضِلٌ","وَالرَوعِ بارِقَةٌ ذو رَعدِها قَصَفُ",0,"ف",1,0],["فيا لَسقوطك من فاجع","به فجع الدهر أم القرى",1,"ر",2,0],["في السرّ والجهر بأحوالنا","كم لكَ يا موسى يدٌ بيضا",2,"ض",2,0],["في السَهلِ نَرِف رَياحينا","وَنَجوبُ الصَخرَ شَياطينا",3,"ن",2,0],["في السوق منصوباً بمدرجة","يجتاز فيها العرب والعجمُ",4,"م",1,0],["في السحر والكون والعزائم وال","طلسم قد رتبوا لها رتبا",5,"ب",2,0],["في السّفحِ من سَلعٍ قضاءٌ رابضٌ","والويلُ حين يَثُورُ أو يَنسابُ",6,"ب",1,0],["في السَماوات ساهِرات الجُفونِ","لا تَخفها فَلَن تَبوح بسرٍّ",7,"ر",1,0],["في السّابِرِيِّ وَفي قَلائِدِها","مُنقادُها عَسِرٌ وَإِن قَرُبا",8,"ب",2,0],["في السر أقول يا تُرى ما صَنَعَتْ","ألحاظُكَ بي وليسَ هَذَا شَكْوَى",9,"ك",3,0],["في السماء الشبان جم غَفير","ثم ما إن بها سوى عذراء",10,"ا",2,0],["في السَّأم الحيِّ الذي لا يَبيد","والأملِ الطاغي بأن ترجعي",11,"ي",1,0],["فَيَا لَسَرَاةِ الْقَومِ دَعْوَةُ عَائِذٍ","أَمَا مِنْ سَمِيعٍ فِيكُمُ فَيُجِيرُ",12,"ر",1,0],["فِي السُّحْبِ هَامَتُهَا وَوَ","طْيءُ رِجْلِهَا فَوْقَ العَلَمْ",13,"م",1,0],["فِي السِّرْبِ أَنَّى سَارَ لاَ","تَخْشيْنَ سُوءَ المَوْقِعِ",14,"ع",1,0],["في السلم إن حكموا كانوا ملائكةً","وفي لَظى الحرب تحتَ النقْعِ جِنَّانُ",15,"ن",1,0],["في السِّلْمِ يرتاد النجومَ، وفي الوغى","يبْرِي الرقابَ بحدِّ سيف باتر",16,"ر",1,0],["في السلم إن عاهدوا، والحرب إن ظفروا","عن شِرْعة العدلِ والإسلامِ ما حادوا",17,"د",3,0],["فيالسراة القوم اين مقركم","معاهدكم قد عمرت بخرابها",18,"ب",3,0],["فيا لسميط ما رضائي بعيشة","خلافكم إلا رضا بذهابها",18,"ب",3,0],["في السجن سبعُ سنين قامَ به وفي","الجبِّ المهولِ أَمِثلُ ذلك يُقْذَفُ",19,"ف",1,0],["في السابقين الأولين كأنهم","أسدٌ تربب في الغيضِ الأشبلا",20,"ل",2,0],["في السيف جور فاجتنب تحكيمه","ما يضع أمر المهيمن أو يهنْ",21,"ن",1,0],["في السَّبعِ وَالعشرينَ غابَ ضِياؤُها","وَكَذا الأَهِلَّةُ في اللَيالي المُقمِرَهْ",22,"ر",2,0],["في الستِّ وَالعشرينَ حلَّ بِتُربةٍ","وَالنَفسُ أَدرَكَتِ النَعيمَ الأَشرَفا",23,"ف",2,0],["في السلمِ أَندى من نسيمِ الصبا","وَفي الوغى أفتكُ فتّاكِ",24,"ك",1,0],["في السلمِ خدُامه في الحربِ أسهمهُ","سُيوفهُ وقناهُ والسرابيلُ",25,"ل",1,0],["في السمع يوما لو بدت لاخى الهوى","لجفا المدام وكان قد عاف القدح",26,"ح",1,0],["في السلمِ للطاعاتِ فهو ملازمٌ","ولدى المعاركِ فهو قُطْبٌ رحاءِ",27,"ا",2,0],["في السرِّ بينهما وبينَكَ عهدةٌ","وصداقةٌ كي يُتَّقى التعكيس",28,"س",1,0],["فَيا لَسَقامِي مِنْ هَوى مُتَجَنِّبٍ","بَكى عاذِلاهُ رَحْمَةً لِمُحِبِّهِ",29,"ب",2,0],["في السما عيدٌ وتلك الشُّ","هبُ قَدْ كانتْ سهامه",30,"م",2,0],["في السِّلْمِ وافيِ القِرى","والرَّوْعِ وارِي الزِّناد",31,"د",1,0],["في السلم تلقاه ذا حلم وذا سعة","عذب الفكاهة يهوى رقة الغزل",32,"ل",1,0],["فيالَسَني أيامَ يعطلُ مِسحلي","وصمتيَ في حَلْي اللجام المفضّضِ",33,"ض",1,0],["في الساحة البيضاءِ مَشْقٌ رائعٌ","لكنَّه في الهامِ ضَرْبٌ أرْعَلُ",34,"ل",1,0],["في السلم ماء وهي نار في الوغى","موت كما تلفى الحياة به لفا",35,"ف",2,0],["في السائلين ذيولها مجرورة","والبيت يرشح سقفه الممطور",36,"ر",1,0],["في السِّتِّ عَشْرَةَ من حياتِك عِفتَهَا","كالبدرِ يَخسِفُ في انتصافِ الأشْهُرِ",37,"ر",1,0],["في السالِفينَ مِنَ الأَفاضِلِ عَبرَةً","تَجلو المَراءَ بِأَقصَرَ الأَمعانِ",38,"ن",1,0],["في الست والخمس سجن ما له طبق","والنفس والعقل يا معهود مولاكا",39,"ك",2,0],["في الساعد الأيمنِ خالٌ له","مثلُ السويداءِ على القلب",40,"ب",1,0],["في السّيِّدِ ذي الجاهِ وَالكمالِ بِعِزٍّ","في الشَّهمِ أَخي المَجدِ في مَهابَةِ إِجلال",41,"ل",1,0],["فيا لسنى الليل تنهار منه","ومن سحره قلل الكبرياء",42,"ا",2,0],["في السلم أوجد هينا مستبشرا","ولدى المروب فمن صلاب الجندل",43,"ل",1,0],["في السر تعصي ربها","بين الورى تتأدب",44,"ب",1,0],["في السابقين من العصاة زواجر","فاصغوا لانذاري فاني اخطب",45,"ب",1,0],["في السعي رعي وكم في الذكر من رتب","عليا بها شاهد الاقبال يتصل",46,"ل",1,0],["في الساعة التي اكون فيها","مرفها في عيشتي ترفيها",47,"ه",2,0],["فيا لسراة القوم أين مقركم","معهادكم قد عمرت بخرابها",48,"ب",3,0],["في السلم وابلُها النُضار وإنَّما","في الحرب وابلُها دمٌ يتدفَّق",49,"ق",1,0],["في السُمر لا السُمر معقودٌ هوايَ ولل","بيضِ الظُبا ليس للبيض الظِبا طرَبي",50,"ب",2,0],["في السِلْمِ طَوْدٌ يالحُرُوبِ عَقيقةٌ","بالعَدْلِ راضٍ لِلْهَضيمَةِ آبي",51,"ب",2,0],["في السِّلم يخدم باللسان وفي الوغى","بالسيف ليس بهائبٍ ما لاقى",52,"ق",2,0],["في السبي تخزرنا العيون كأننا","خزر على عجف النياق وديلم",53,"م",1,0],["في السن قد طَعنت ما ضرّ لو طُعنَت","بالسن من رمح أو سيف قد انبترا",54,"ر",2,0],["في السوق رقي ولكن مفلس","بردته بخيارة العطروز",55,"ز",1,0],["في السلم يثني كل أرض كاسياً","ذي أنعم بَخّلَتِ الغواديا",56,"ي",2,0],["في السلم تبسط في النوال وفي الوغ","ى مقبوضة أبداً على قنواتها",57,"ت",3,0],["في السَهل أَو في قِمَم الرِعان","فَلا أَرى مُعتَدياً أَو جاني",58,"ي",1,0],["في السمع يحلو شعره وبيانه","وبطبه لذوي السقام شفاء",59,"ا",2,0],["في السهل عند سيرها والوعر","أن آنست جرم الغبيط فوقها",60,"ه",2,0],["في الساق والسكان والشراع","والصدر والفبوم ثم النحر",60,"ر",1,0],["في السوق في البيت في نومي وفي","سهري في ثورتي في سكوني في خيالاتي",61,"ت",2,0],["في السما ألف ألف موضوع شعر","فتيقظ للسمع وانظر سماءا",62,"ا",3,0],["في السير وجهك الاله وما اكتفى","فحباك نصحا في الكتاب به الشفا",63,"ف",2,1],["في السبع والسبعين لست أصدِّقُ","روض الصبا غض وغصني مورقُ",64,"ق",1,1],["في السَعانينِ وَإِن لا","قَيتُ في ذاكَ اِفتِضاحا",65,"ح",2,0],["في السلم يحيى بعذب الجود ذا آمل","في الحرب يردي بمر البأس ذا اضم",66,"م",1,0],["في السلف الماضي لنا عبرة","لو نفعتنا العبر السالفات",67,"ت",1,0],["في السماء غيرهن انجم","ما سمعت القابهن عنهم",68,"م",1,0],["في السفح دمعي به استخدمته لرشاً","مأمون عهد عن التوجيه معتصم",69,"م",1,0],["في السيف شبهت شيئين بمثلهما","بَريقُه والدِما كالبرق والديم",70,"م",1,0],["في السوْم ثمنٌ غالِ","في تاريخ الزمن الخالي",71,"ي",1,0],["في السِّلْمِ تختالُ كالخيْلِ العِرابِ وفي","حرْبِ الأعاجِمِ تأتي بالأعاجيبِ",72,"ب",1,0],["في السّلْمِ أو في الحرْبِ مُلْكُك ناصرٌ","يُرْجَى مُفيداً أو يُخافُ مُبيدا",73,"د",2,0],["في الساجدين نوره لم يزل","والله يرعى من له حملا",74,"ل",2,0],["في السجن واليم والقفر أو","فوق بريد بتُّ منذ ربع عام",75,"م",1,1],["في السُّخطِ حِلمٌ وَالجبانةِ شِدَّةٌ","وَالذُّلِّ عِزٌّ وَالقَناعَةِ جودُ",76,"د",1,0],["في السموات وفي الأرض له","أثر ينبئ عن يوم المآب",77,"ب",1,0],["في السين في ريف الكنانة شطرها","في المجدلانة في ربى لبنان",78,"ن",1,0],["في ألسن الفساق لا تزول","ووصفها لديهم يطول",79,"ل",1,0],["في السر شر وإن وافيت مجلسهم","سمعت نصحا وأذكارا وأورادا",80,"د",2,0],["في السمهري مشابه","ممن أحب وأعشق",81,"ق",1,1],["في السياسةِ شِرعَةٌ","ولِلّه مِنهُ في السِيادةِ مشرَعُ",82,"ع",1,0],["فيا لسرور به قد حييت","فأدركت قبل النشور النشورا",83,"ر",2,0],["في السلم خاطرهُ ذو رقة أبداً","وفي الحروب هو الأقسى من الحَجَر",84,"ر",1,0],["فيا لسيف من سيوف الهدى","قد فلة للدهر عضب حسام",85,"م",1,0],["في السَّيْفِ إِنْ رَبَتِ الخُطُوبُ وجَلَّتِ","الجُلَّى مِنَ الداءِ العَياءِ شِفاءُ",86,"ا",2,1],["في الساعة الحمراءبعدَ الواحدةْ","أنتم شهودُ الأرضِ..وهْيَ الشاهِدةْ",87,"د",2,1],["في السّجنِ قاسَى أشهرًا تِسعةً","يا ليتها كانت لِإنجابهِ",88,"ب",2,0],["في السفح تراهم قد نزلوا","والعالم منزله القمم",89,"م",1,0],["في السلم أقدمُهم وأكثرُ منهمُ","علماً لما قد نالَ منه جوامعَه",90,"ع",2,0],["في السِّلْمِ تَدْعُوهُمْ لِدَرْبِ سَعادَةٍ","وَلَهُمْ دَعَوْتَ إِذا مَضَوْا لِقِراعِ",91,"ع",1,0],["في السجّادةِ التي يقفُ عليها مليكي، نُسِجَت جواهرُ،","غير أنّ الأرضَ العاريةَ المتواضعةَ تنتظرُ، صابرةً، أن تلامسَها قدماه.",92,"ه",1,0],["في السّرّ وشوشني والحُبّ صافحني","والثغر أدمى لمًى في حمرة الشّفق",93,"ق",1,0],["في السحر ذوبتني حتى غدا نسَغي","يسري بقلبك، صدّاحا بخفْقاتي",94,"ت",2,0],["فِيْ السُّحْبِ أَكْتُبُهُ وَالْغَيْثُ يُرْسِلُهُ","وَالرَّيْحُ لِيْ وَتَرٌ بِالنُّوْرِ أَذْرِيْهِ",95,"ي",2,0],["في السجن خلده الرشيد ولم يخف","يوم القيامة من لظى سجين",96,"ن",1,0],["في السلم يشهد لنا عمار الأوطاني","وفي الحرب لأرواحنا للموت بياعه",97,"ع",2,0],["في (السيابيين) أضحى","علماً ناف السحابا",98,"ب",2,0],["في السبق يجري وهيمان","ولا يخشي في الجد بلاوي",99,"ي",1,0],["في السوق ، سوق الموت طبلٌ صاخبٌ","وبكل ركن فيه يصرخ بوقُ",100,"ق",1,0],["في (السيركِ) صارتْ للمدِّربِ لُعبةً","بالسوطِ تَرضَى الذلَّ حتى تُطعَما",101,"م",2,0],["في السِّرِّ والجَّهرِ تحيا دونما ملقٍ","تخشى الإلهَ وترضى منه بالقِسَمِ",102,"م",1,0],["20. في السِّلم كمْ أشبعت يُمْناه سائلها","وتَشبعُ اليومَ من قتْلاهُ غِربانُ",103,"ن",1,0],["فِي السِّلْمِ كَالسِّلْمِ مَا أَحْلَى شَمَائِلَهُ","وفِي الحُرُوْبِ تَرَاهُ القَائِدَ البَطَلا",104,"ل",2,0],["في السابحات دلالة وجمال","وعلى الصباح مهابة وجلال",105,"ل",1,1],["في السُّوقِ آلافٌ مِنَ الأُدَباءِ","نَظَموا بِقَصدِ الكَسبِ شِعرَ هُراءِ",106,"ا",2,1],["في السر أو علمته قلباً سليم","أو نزل الوحي به على بشر",107,"ر",1,0],["في السلم والحرب لم تؤمن خيانتهم","إن حالفوا نقضوا أو عاهدوا كذبوا",108,"ب",3,0]]}