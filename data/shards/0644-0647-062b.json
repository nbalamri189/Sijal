{"poems":[[89,"يراع صنانيد الكتابة كالعضب","https://www.aldiwan.net/poem44643.html","الطويل"],[99,"يد","https://www.aldiwan.net/poem5809.html","عموديه"],[40,"لقد أرسلت ليلى رسولا بأن أقم","https://www.aldiwan.net/poem42342.html","الطويل"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[90,"الصَبر الجَميل","https://www.poetsgate.com/ViewPoem.aspx?id=179152",""],[113,"حجاب الخطب أن شدت عراه","https://www.aldiwan.net/poem41998.html","الوافر"],[133,"له ثنايا إن بدت في الدجى","https://www.aldiwan.net/poem49147.html","السريع"],[184,"رأيت مهفهفا كالغصن مالت","https://www.aldiwan.net/poem44136.html","الوافر"],[257,"محمد عند الله حي وجدنا","https://www.aldiwan.net/poem35543.html","الطويل"],[257,"إلام الحشا من لاعج الشوق في سخط","https://www.aldiwan.net/poem35776.html","الطويل"],[456,"حماها أن تشل وأن تراعا","https://www.aldiwan.net/poem56121.html","الوافر"],[562,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""]],"verses":[["له ثروة موفورة من خصاله","وما اكثر الاوراق في الفنن الرطب",0,"ب",1,0],["لهث الخيال على ملاستها","وأنهار عند سوارها المذهب",1,"ب",1,0],["لَهُ ثَرَّةٌ تَنهَلُّ مِن جَوفِ رَأسِهِ","تَكاد لَها مِنهُ العُرُوقُ تَبَزَّلُ",2,"ل",1,0],["له ثِقَلُ الحَدائدِ فهْوَ رَاسٍ","وإصْعادُ التّلَهّبِ فهْو نامِ",3,"م",1,0],["لَهُ ثَأَدٌ يَهتَزُّ جَعدٌ كَأَنَّهُ","مُخالِطُ أَرجاءِ العُيونِ القَراطِفُ",4,"ف",1,0],["له ثِقَةٌ بالنفسِ أنْ ستقودُه","لحالٍ يرجِّي خيرَها أو لمصرع",5,"ع",1,0],["له ثوب النبوة قد تدلى","وآدم في الخفا طين وماء",6,"ا",2,0],["له ثنايا إن بدت في الدجى","يكاد يعشينا سني برقها",7,"ق",3,1],["له ثوب يميل عليه تيها","كما التفّ القضيب على القضيب",8,"ب",1,0],["له ثانياً في الغار كان ولم يزل","أبو بكرٍ الصدّيق عند محمّد",9,"د",1,0],["له ثاقبٌ من فهمه كيفما روى","وعقد الذكا من ذهنه محكم الربط",10,"ط",1,0],["له ثقةٌ بأوبته نجيحاً","يطاولها الهَمَام أو النزاعا",11,"ع",2,0],["له ثاقب الرأي المنير إذا دجى","ظلام مهم منه ذو اللب يوجل",12,"ل",1,0]]}