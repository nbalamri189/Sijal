{"poems":[[91,"يراع صنانيد الكتابة كالعضب","https://www.aldiwan.net/poem44643.html","الطويل"],[101,"يد","https://www.aldiwan.net/poem5809.html","عموديه"],[42,"لقد أرسلت ليلى رسولا بأن أقم","https://www.aldiwan.net/poem42342.html","الطويل"],[48,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[92,"الصَبر الجَميل","https://www.poetsgate.com/ViewPoem.aspx?id=179152",""],[119,"حجاب الخطب أن شدت عراه","https://www.aldiwan.net/poem41998.html","الوافر"],[139,"له ثنايا إن بدت في الدجى","https://www.aldiwan.net/poem49147.html","السريع"],[190,"رأيت مهفهفا كالغصن مالت","https://www.aldiwan.net/poem44136.html","الوافر"],[264,"محمد عند الله حي وجدنا","https://www.aldiwan.net/poem35543.html","الطويل"],[264,"إلام الحشا من لاعج الشوق في سخط","https://www.aldiwan.net/poem35776.html","الطويل"],[463,"حماها أن تشل وأن تراعا","https://www.aldiwan.net/poem56121.html","الوافر"],[569,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83309","الطويل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104001","البسيط"],[738,"","https://poetry.dctabudhabi.ae/diwan/poem/147208","المجتث"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120099","المجتث"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120077","السريع"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110708","الوافر"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216583",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87322","الرجز"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85216","الهزج"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114137","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77060","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94448","البسيط"],[4927,"هالة الخزي وأم العواذل","https://www.poetsgate.com/ViewPoem.aspx?id=29835",""],[5376,"للقلبِ في أحزانِه أنَّاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=193284",""],[5596,"تقريض كتاب دالية المحقق الخليلي","https://www.poetsgate.com/ViewPoem.aspx?id=206711",""],[5704,"أسيل الخد","https://www.poetsgate.com/ViewPoem.aspx?id=195149",""],[5739,"قلبي وكر ...!","https://www.poetsgate.com/ViewPoem.aspx?id=155476",""],[6056,"فخ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=156699",""]],"verses":[["له ثروة موفورة من خصاله","وما اكثر الاوراق في الفنن الرطب",0,"ب",1,0],["لهث الخيال على ملاستها","وأنهار عند سوارها المذهب",1,"ب",1,0],["لَهُ ثَرَّةٌ تَنهَلُّ مِن جَوفِ رَأسِهِ","تَكاد لَها مِنهُ العُرُوقُ تَبَزَّلُ",2,"ل",1,0],["له ثِقَلُ الحَدائدِ فهْوَ رَاسٍ","وإصْعادُ التّلَهّبِ فهْو نامِ",3,"م",1,0],["لَهُ ثَأَدٌ يَهتَزُّ جَعدٌ كَأَنَّهُ","مُخالِطُ أَرجاءِ العُيونِ القَراطِفُ",4,"ف",1,0],["له ثِقَةٌ بالنفسِ أنْ ستقودُه","لحالٍ يرجِّي خيرَها أو لمصرع",5,"ع",1,0],["له ثوب النبوة قد تدلى","وآدم في الخفا طين وماء",6,"ا",2,0],["له ثنايا إن بدت في الدجى","يكاد يعشينا سني برقها",7,"ق",3,1],["له ثوب يميل عليه تيها","كما التفّ القضيب على القضيب",8,"ب",1,0],["له ثانياً في الغار كان ولم يزل","أبو بكرٍ الصدّيق عند محمّد",9,"د",1,0],["له ثاقبٌ من فهمه كيفما روى","وعقد الذكا من ذهنه محكم الربط",10,"ط",1,0],["له ثقةٌ بأوبته نجيحاً","يطاولها الهَمَام أو النزاعا",11,"ع",2,0],["له ثاقب الرأي المنير إذا دجى","ظلام مهم منه ذو اللب يوجل",12,"ل",1,0],["لَهُ ثِقَةُ اللَهِ لَيسَت بِغَيرِهِ","وَمَن يَرجُ غَيرَ اللَهِ فَاللَهُ خاذِلُه",13,"ل",2,0],["لهُ ثلاثةُ ألوانٍ تخالُ بها","زُمرُّدا وعقيقاً جاورا بَردا",14,"د",2,0],["له ثلاثون يوماً","يحبو إلى الضرع حبوا",15,"و",2,0],["له ثراء مصون","ووفرك المستباحُ",16,"ح",1,0],["له ثمار دانيات الجنى","جودا وعفو يسع الجاني",17,"ن",2,0],["له ثغر يضاهي إقحواناً","فتنت بضحكه دون البرايا",18,"ا",3,0],["لِهْ ثلاث حروف بالهجوى","إنْ حييت وعِشْت طَلّيبه",19,"ب",2,0],["له ثمانِيَه وأمَّا العاشرُ","سبعونَ بيتاً عدَّها المُباشِرُ",20,"ر",1,0],["له ثغر شهي الري","ق ما أحلى من عذب",21,"ب",1,0],["لَهُ ثَغرٌ مِثلُ الثُّرَيَّا فَوَاهاً","لِثُرَيَّا الرَّبِيعِ عِندَ الصَّباحِ",22,"ح",1,0],["لَهُ ثُغرَ وَلا أَسنان فيه","يَمج بَريقَهِ لا كَالزلال",23,"ل",1,0],["لَهُ ثناءٌ وذكرٌ طالما بقيت","ودام في الكون بالتاريخ ذكراها",24,"ا",3,0],["لَهَثْتِ خَلْفَ تَفَاْهَاْتٍº وَعَرْبَدَةٍ","وَمَا الْتَفَتِّ إِلَى الآيَاْتِº وَالسُّوَرِ",25,"ر",1,0],["لهثَ الزمانُ وراء خطوي كلَّما","شاءَ المكوثَ تلاحَقَتْ خطواتُ",26,"ت",1,0],["له ثنائي وتقديري أقدمه","في خير مبتدئي منه ومختتمي",27,"م",2,0],["له ثغر كما زهر","رضابًا فاض ينسكبُ",28,"ب",1,0],["له ثمانٍ لو نضى برقه وزال.","الخطر يخطف مراسيل البصر.",29,"ر",1,0],["له ثليل ٍ على الأمتان تجعيده","والعطر دهن عود ، ونفحة الكادي",30,"د",2,0]]}