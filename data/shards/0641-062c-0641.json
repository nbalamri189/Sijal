{"poems":[[47,"أيها العاتب الذي ليس يرضى","https://www.aldiwan.net/poem64637.html","الخفيف"],[63,"ما سره أن ذاع من أسراره","https://www.aldiwan.net/poem51672.html","الكامل"],[82,"وجفنين أوفى بالمنية فيهما","https://www.aldiwan.net/poem31429.html","الطويل"],[46,"قولا لإبراهيم والفضل الذي","https://www.aldiwan.net/poem30402.html","الكامل"],[83,"خذ من حديث شؤونه وشجونه","https://www.aldiwan.net/poem61302.html","الكامل"],[50,"أحمد الله الذي أسكننى","https://www.aldiwan.net/poem66161.html","مجزوء الرمل"],[52,"بلغ المرعث في الرحيل","https://www.aldiwan.net/poem64864.html","مجزوء الكامل"],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[197,"بنفسي غزال صار للحسن كعبة","https://www.aldiwan.net/poem13022.html","الطويل"],[234,"حسنت بك الأيام حتى خلتها","https://www.aldiwan.net/poem51252.html","الكامل"],[240,"أرى الأيام صيغتها تحول","https://www.aldiwan.net/poem31790.html","الوافر"],[295,"قل لمن خاس بعهدي","https://www.aldiwan.net/poem11702.html","مجزوء الرمل"],[333,"أطرق الشاكي ونام الموجع","https://www.aldiwan.net/poem55030.html","الرمل"],[409,"هل ينال القلب ما طلبا","https://www.aldiwan.net/poem34147.html","المديد"],[449,"يا رسولي اذهبا فأبلغاها","https://www.aldiwan.net/poem56061.html","الخفيف"],[469,"سهادي وليلي فيك ما لها حد","https://www.aldiwan.net/poem3629.html","عموديه"],[556,"بأبي وجهك الذي","https://www.aldiwan.net/poem47712.html","مجزوء الخفيف"],[556,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122803","الوافر"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77443","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59655","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59533","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65057","المجتث"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104466","الرجز"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123143","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53045","المنسرح"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75886","المضارع"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104676","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109939","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91830","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91360","الطويل"],[3945,"","https://poetry.dctabudhabi.ae/diwan/poem/130527","الكامل"],[5174,"لغة الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=199065",""],[5660,"سَقَطَ السَريرُ تَكَسَّرَت أَضلاعُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=23782",""],[5956,"أرجو أن يزيد الله وعيي","https://www.poetsgate.com/ViewPoem.aspx?id=185669",""],[6052,"وقفة على البحر الميت","https://www.poetsgate.com/ViewPoem.aspx?id=35193",""],[6178,"مرافي محطمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85529&r=&rc=5",""]],"verses":[["فَجُفوني في عَبرَةٍ لَيسَ تَرقا","وَفُؤادي في لَوعَةٍ ماتَقَضّى",0,"ض",2,0],["فجفَى المَواطِنَ والأحِبَّةَ ناسياً","مَنْ لا يُفيقُ الدَّهْرَ من تَذْكارِه",1,"ر",2,0],["فَجَفنٌ له عَضْبٌ منَ اللَّحظِ مُرْهَفٌ","وَجَفْنٌ به ماضٍ من الهند مُبْتِرُ",2,"ر",1,0],["فَجَفَوتُكُم وَعَلِمتُ في أَمثالِها","أَنَّ الوَصولَ هُوَ القَطوعُ الجافي",3,"ف",2,0],["فَجُفُونُهُ شَركُ القُلُوبِ وإنَّمَا","هُارُوتُ أودَعَهَأ فُنُون فُتُونِهِ",4,"ن",2,0],["فَجَفاني حينَ باهَي","تُ بِهِ رَيبَ الزَمانِ",5,"ن",1,0],["فَجَفَت يَداهُ عَنِ النُسو","عِ وَشَدَّ بِالأَنساعِ صَحبُه",6,"ب",2,0],["فجف نضير الروض واربد جوه","وغاضت بحور طاميات غطمطم",7,"م",1,0],["فَجفنيَ لِلتَّسهيدِ وَالدَمعِ قارِنٌ","وَقَلبي فيهِ بِالصَبابَةِ مُفرِدُ",8,"د",1,0],["فجفونُه في عارِضٍ من دمعه","وفؤادُه في جَاحِمٍ مُتَلاهِب",9,"ب",1,0],["فَجَفني وَالغَمامُ لَها غَزيرٌ","وَقَلبي وَالنَسيمُ لَها عَليلُ",10,"ل",1,0],["فجفاني غير آسٍ","بيد أني ما قليتُه",11,"ه",1,0],["فجفا الأيام فجراً وضحى","وتمنى لو طواه المغربُ",12,"ب",1,0],["فجفوني بعدكم سفحت","عبرة في الخد قد عبرت",13,"ت",1,0],["فجفتني وإنني خير حرّ","من كرام بالمجد تحمي حماها",14,"ا",3,0],["فجفني وجفناها ووجدي وردفها","وقلبي وقرطاها ودمعيَ والعقد",15,"د",1,0],["فَجُفوني عَلى فِرا","قكَ يقطرن أَدمُعا",16,"ع",2,0],["فَجَفْنٌ لَنا سالِمٌ مِن قَذىً","وآخرُ مُمتَلِئٌ مِن قَذى",17,"ا",1,0],["فَجَفنُ الغَيمِ مُرفَضُّ المَآقي","وَيَومُ الدُّجنِ أَحوَى الطَّيلَسانِ",18,"ن",1,0],["فَجُفونُها تُغنيك عَن أَكواسها","وَخُدودُها تُغنيك عَن أَزهارِ",19,"ر",1,0],["فجفنٌ وإنسانُ المحاجر مُغرقٌ","وقلبٌ ونيران الغرام تواصله",20,"ل",2,0],["فجفوني تنهلُّ سحاً وسكباً","وضلوعي قد أشعلت بالتهاب",21,"ب",1,0],["فجَفِّفوا عن جُفوني","مِنْ دَمْعِها الهَطّالِ",22,"ل",1,0],["فجفت إذ دعونني بخبزى","أدامه الكباب وهو مجزي",23,"ي",1,0],["فجفا الكرى جفني وواصله النوى","عند التفكّر فيكم برجوعي",24,"ع",2,0],["فجفن شمس الضحى به رمد","وخد بدر الدجا به ترب",25,"ب",1,0],["فَجَفني إِلى سُهادٍ","وَجَنبي عَلى قَتادِ",26,"د",1,0],["فَجَفاني رُقادي","حينَ جافي مِهادي",27,"ا",3,0],["فجَفنُ عُيوني لا يُلِمُّ غِرارُهُ","وأَنَّي كَرَى عينٍ على حدها حدُّ",28,"د",1,0],["فجف منهلُ صفوٍ كان منهمراً","يَروي وغرّب بدرٌ حيثُ قيل بزغْ",29,"غ",1,0],["فَجفنٌ تهادى في محيط مدامعٍ","وَقَلبٌ تردّى بَين نيرانِ قابس",30,"س",1,0],["فجفانه رذم لمن ينتابه","والصنر منه باللسان وباليد",31,"د",1,0],["فَجَفَاهَا أَهْلُهَا حَتَّى عَمُوا","عَنْ جَمَالٍ فَاتِنٍ لَيْسَ بِفَانِ",32,"ن",1,0],["فَجَفَيتُ هاتيكَ المَضاجِعَ كُلُها","فَالجَنبُ باتَ عَلى سِواكَ مُحَرَّما",33,"م",2,0],["فَجَفّفْ يا إلهي الشعر منِّي","إذا هو غير معدودٍ كَنُعْمَى",34,"م",2,0],["فجف نقيُّ الدمعِ في العين حسرةً","وكسّر أنّات الجروح احتطابا",35,"ب",2,0],["فجف نهر الهوى بالروح ذات مسا","لا لم يعد هيكلي العظمي يحويها",36,"ي",3,0]]}