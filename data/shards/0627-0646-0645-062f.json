{"poems":[[74,"غازلتنا فأعيدي ماضي الغزل","https://www.aldiwan.net/poem19472.html","البسيط"],[47,"جلوت مرآتي فيا ليتني","https://www.aldiwan.net/poem10218.html","السريع"],[48,"بنت عن الدنيا ولا بنت لي","https://www.aldiwan.net/poem22160.html","السريع"],[113,"إن مدح الملوك يقبح فضلا","https://www.aldiwan.net/poem16635.html","الخفيف"],[132,"منعت مقلتى لذيذ الرقاد","https://www.aldiwan.net/poem50636.html","الخفيف"],[264,"إن مدحي لخالد بن الوليد","https://www.aldiwan.net/poem35963.html","الخفيف"],[302,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[358,"ما ترى البدر حين حاز كماله","https://www.aldiwan.net/poem40002.html","الخفيف"],[369,"هل أنت بطولك مسعده","https://www.aldiwan.net/poem60943.html","المتدارك"],[376,"منيتها تفرق من عاذلي","https://www.aldiwan.net/poem57221.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122788","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37952","الخفيف"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123689","المديد"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123694","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62587","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62455","المجتث"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119865","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112870","البسيط"],[353,"","https://poetry.dctabudhabi.ae/diwan/poem/113305","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127963","الخفيف"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104807","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110332","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93555","الخفيف"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110669","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87368","الخفيف"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66590","الخفيف"],[3942,"","https://poetry.dctabudhabi.ae/diwan/poem/205161",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120506","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139665",""],[4816,"العيون","https://www.poetsgate.com/ViewPoem.aspx?id=8503",""],[5205,"غزاة عينيك حاربت كبدي","https://www.poetsgate.com/ViewPoem.aspx?id=120992",""],[5325,"خطب أناخ على الإسلام كلكله","https://www.poetsgate.com/ViewPoem.aspx?id=171970",""],[4623,"لا تلوموني إني أطلت المقالا ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146608",""],[6127,"يا ثورة الآس","https://www.poetsgate.com/ViewPoem.aspx?id=205889",""]],"verses":[["إن مدّ قصديَ في الدنيا لغيركُم","يدَ الرجا فرماها الله بالشلل",0,"ل",1,0],["إِنَّ مَدى العُمرِ قَريبٌ فَما","بَقاءُ نَفسي بَعدَ قُربِ المَدى",1,"د",2,0],["إِن مَدَحوني ساءَني مَدحُهُم","وَخِلتُ أَني في الثَرى سُختُ",2,"ت",1,0],["إِن مَدح المُلوك يقبح فَضلاً","عَن مَديح الرعاع وَالأَوغاد",3,"د",1,1],["إنَّ مَدْحي لكم به أرتجى الفو","زَ غداً والنجاةَ يومَ المعادِ",4,"د",1,0],["إنّ مدحي لخالد بن الوليدِ","مثل مدحٍ لوالدٍ من وليدِ",5,"د",1,1],["إِن مدَّ كفّاً لتقسيم النَوال فهم","ما بين مُعطىً وَمُستجدٍ ومُستَلمِ",6,"م",1,0],["إِنَّ مَدحي بِباب عزّك أَضحى","مَثَلاً يُحسنُ الثَنا إِرساله",7,"ل",2,0],["إن مَدَّ الكَفَّ لها طلَباً","للنّجمِ فما تَستَبْعِده",8,"د",2,0],["إِن مَدَّ باعَ البأسِ في مَعركٍ","طالَ فأَغناهُ عَن الذابِلِ",9,"ل",1,0],["إنَّ مَدحاً يَكُونُ في غَيرِ مُوسَى ب","نِ حُسَينٍ وَآلِهِ هَذَيانُ",10,"ن",1,0],["إِنّ مَدحي غيرَ الكرامِ قَبيحٌ","إِنَّ مَدحَ اللّئامِ غَيرُ سَديدِ",11,"د",1,0],["إن مدح الخلق قاطبة","دون علياً مدحه سفلا",12,"ل",2,0],["إن مدحاً لبعض أوصافه الغرّ لأ","مر يحار فيه اللبيب",13,"ب",1,0],["إنَّ مدحي آل النبي الطهارى","سبب موجب لنيل مفازي",14,"ز",2,0],["إن مدّ لي فيصل من","هباته الجم رفدا",15,"د",2,0],["أنمدحه إذا في الدست منه","وفوق الطرف ضرغام وبدر",16,"ر",1,0],["أن مدت الحادثات الكف أو نظرت","إليه فاكفف ورد الطرف في شغل",17,"ل",1,0],["إنْ مَدَدْتَ الغِطَاءَ لي مَدَّ وَرْشٍ","ليسَ هذا علَيَّ بِالمَقْصُورِ",18,"ر",1,1],["ان مدحى له يقوم بمدحى","فلتمت عذلى عمى وضلاله",19,"ل",2,0],["إِن مَدَّ أَحمَدُ يَوماً رَاحَتَيهِ إِلَى","نَحوِ السَّمَاءِ أتاهُ المُزنُ وَاندَفَقا",20,"ق",2,0],["ان مدحنا فنحن نمدح مولىً","كان عوذ الجاني وغوث الطريد",21,"د",1,0],["إِن مَدحي للسيد ابن حسين","حَسنات تَمحي بِها السَيئات",22,"ت",1,1],["إن مد كفا للمكارم نالها","أو طاول العلياء يوما طالها",23,"ل",3,0],["ان مدحناكَ نالَنا المدحُ ايضاً","كالصَدى راجِعاً الى من نادى",24,"د",2,0],["إِنَّ مَدْحِي لَهُ أَشَدُّ وِطَاءً","وَقَرِيضِي أَقْوَى وَأَقْوَمُ قِيلاَ",25,"ل",2,0],["إن مد الله في عم","رك من كتب الجفا",26,"ا",1,0],["ان مدح الكرام فرض ومن","كان جديرا به فقد نال رزقا",27,"ق",2,0],["إن مدحنا سواهم بامتداح","فإليهم إيابه والقصارى",28,"ر",2,0],["ان مدحت العين شعري ما نصف","مير افضي ما على الخاطر مرق",29,"ق",1,0],["أن مد لي الدهر بالحروب يداً","من عظم بأسي له مدت يدي",30,"د",2,0],["إن مد نحوك كفا تشتكي شللا","أو مدّ نحوك رجلا تشتكي عرجا",31,"ج",2,0],["إن مدح المختار لو نوعته","الناس ما استوفوا حقه إجمالا",32,"ل",2,0],["إنْ مدُّوا أيديهم خِلْتَ الهباء دهى","أو أخرجوا لسنَهُمْ ساختْ بِمَنْ وثقا",33,"ق",2,0]]}