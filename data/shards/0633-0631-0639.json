{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[79,"مر الذباب على فم ابن كماشة","https://www.aldiwan.net/poem36633.html","الكامل"],[95,"طفلان كالأخوين مؤتلفان","https://www.aldiwan.net/poem11268.html","الكامل"],[90,"فعدت بقارعة الطريق تنوح","https://www.aldiwan.net/poem43672.html","الكامل"],[74,"سر على اليمن والهنا حيثما سر","https://www.aldiwan.net/poem18614.html","الخفيف"],[74,"سر على اليمن والسعادة يا من","https://www.aldiwan.net/poem20316.html","الخفيف"],[87,"شكرتك في أجداثها الشهداء","https://www.aldiwan.net/poem7258.html","الكامل"],[87,"يا شراعا وراء دجلة يجري","https://www.aldiwan.net/poem8075.html","الخفيف"],[87,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[92,"في ذمة الله ما ألقى وما أجد","https://www.aldiwan.net/poem47616.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55333","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[79,"تألق نجديا فأذكرني نجدا","https://www.poetsgate.com/ViewPoem.aspx?id=33939",""],[119,"سربدا مجلاه","https://www.aldiwan.net/poem42198.html","منهوك المنسرح"],[275,"أنهارنا في غاب كسكاتينا","https://www.aldiwan.net/poem35629.html","الكامل"],[275,"أبدا أرى والغدر طبع فيك","https://www.aldiwan.net/poem35643.html","الكامل"],[276,"لم يبق في الحي من ربع ولا طلل","https://www.aldiwan.net/poem52078.html","البسيط"],[280,"أدرك بخيلك خيل الله أندلسا","https://www.aldiwan.net/poem25469.html","البسيط"],[280,"عندي نزاع ليس عنه نزوع","https://www.aldiwan.net/poem25487.html","الكامل"],[280,"حسب الوجود على التأييد برهانا","https://www.aldiwan.net/poem25507.html","البسيط"],[310,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[315,"أسرفن في هجري وفي تعذيبي","https://www.aldiwan.net/poem59519.html","الكامل"],[333,"كذبت هند حين قالت لك القل","https://www.aldiwan.net/poem54941.html","الخفيف"],[374,"مات معز الدين من قبل أن","https://www.aldiwan.net/poem4301.html","السريع"],[376,"أطاعك الدمع الذي كان عصى","https://www.aldiwan.net/poem57538.html","الرجز"],[382,"سر عجيب فيه معنى أعجب","https://www.aldiwan.net/poem66932.html","الكامل"],[415,"سر عن بلادهم فقد سئمت بها","https://www.aldiwan.net/poem32083.html","الكامل"],[463,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[466,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[563,"أفعال رب الخلق روضة عطرِهِ","https://www.aldiwan.net/poem34466.html","الكامل"],[580,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83291","الكامل"],[894,"","https://poetry.dctabudhabi.ae/diwan/poem/199360","السريع"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136203","الرمل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144760","الكامل"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131545",""],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125360","الكامل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202067","الرمل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202063","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109285","السريع"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109352","البسيط"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119208","الخفيف"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105008","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88632","الكامل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110630","الكامل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101700","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93540","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93578","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137181",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130796",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93863","البسيط"],[133,"","https://poetry.dctabudhabi.ae/diwan/poem/104647","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89373","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74041","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74102","الكامل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123937","الخفيف"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131998","الكامل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34657","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114560","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102955","الرمل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75680","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117290","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83195","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83201","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83198","الرجز"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77687","الكامل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77696","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139681",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139641",""],[4830,"روايةُ عاشقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=206086",""],[4929,"ازهري كالربيع","https://www.poetsgate.com/ViewPoem.aspx?id=206681",""],[4935,"شبل إسماعيل جرد عزمتك","https://www.poetsgate.com/ViewPoem.aspx?id=129435",""],[4935,"خل عنك الهزل خلي والكسل","https://www.poetsgate.com/ViewPoem.aspx?id=129317",""],[5174,"حُلَُوا مبانيها","https://www.poetsgate.com/ViewPoem.aspx?id=186100",""],[5431,"رحمة الله في لظى العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=196812",""],[5496,"أرسلت روحى","https://www.poetsgate.com/ViewPoem.aspx?id=212781",""],[5518,"إلى متى أنتَ باللذاتِ مشغولُ","https://www.poetsgate.com/ViewPoem.aspx?id=187371",""],[5596,"سر على الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=206714",""],[5956,"الحب السعيد","https://www.poetsgate.com/ViewPoem.aspx?id=181895",""],[5956,"سرعان ما أدركتُ","https://www.poetsgate.com/ViewPoem.aspx?id=192950",""],[5970,"تقود كل فتى في الدهر آمال","https://www.poetsgate.com/ViewPoem.aspx?id=130601",""],[6102,"تعدو دعد","https://www.poetsgate.com/ViewPoem.aspx?id=183318",""],[6115,"سرع ما رحت ياشهر الصيامي","https://www.poetsgate.com/ViewPoem.aspx?id=180970",""],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""]],"verses":[["سُرْعَانَ مَا أَبْدَاهُ ثُمَّ أَعَادَهُ","فِي هَفْوَةِ الْبَلْوَى وَبِئْسَ الْمَنْزِلُ",0,"ل",1,0],["سُرْعانَ حَرْبٍ منْ بَني حَرْب وقدْ","حمَلَ السِّلاحَ علَيْهِم سَفّاحُهُ",1,"ح",2,0],["سَرْعَانَ مَا أَنْمَى الجَوَى عَقْلَيْهِمَا","وَتَعَلَّمَا التَّفْكِيرَ قَبْلَ أَوَانِ",2,"ن",1,0],["سرعان ما تنسون عظم مصابكم","ولو أن شقّة منتهاه طروح",3,"ح",1,0],["سر على اليمن والهنا حيثما سر","تَ ليلقاك فيه وجهٌ سعيد",4,"د",1,1],["سرْ على اليُمن والسعادة يا من","شيَّد الله في المعالي مكانه",5,"ه",1,1],["سُرعان ما ختم الدفاع القول بل","سرعان ما قتلت به البراء",6,"ا",2,0],["سِر عَلى الماءِ كَالمَسيحِ رُوَيداً","وَاِجرِ في اليَمِّ كَالشُعاعِ الهادي",7,"د",2,0],["سُرعانَ ما فَتَحوا الدُنيا لِمِلَّتِهِم","وَأَنهَلوا الناسَ مِن سَلسالِها الشَبِمِ",8,"م",1,0],["سُرعانَ ما حالتِ الرؤيا وما اختلفَتْ","رُؤىً ، ولا طالَ – إلا ساعةٍ – أمَد",9,"د",1,0],["سُرْعَانَ مَا هَدَّهُ الجِهَادُ وَمَا","نَاءَ بِتِلْكَ العَزائِمِ السَّقَمُ",10,"م",1,0],["سَرْعَانَ مَا حَطَمَا الرِّمَا","حَ فَأَعْمَلا بِيضَ الْبَوَاتِرْ",11,"ر",1,0],["سُرْعَانَ مَا أَلْقَى بِوِقْرِ ثِيَابِهِ","عَنْهُ وَخَفَّ بِعَزْمِ فَهْدٍ وَاثِبِ",12,"ب",1,0],["سرعان ما كانت مناسف للصبا","فقد ضحكت زهرا وقد خجلت وردا",13,"د",2,0],["سر عظيم الطرز","لكن خفى الرمز",14,"ز",1,0],["سرعانَ ما مرَّت دقائقُكَ التي","كانت حقائقَ تنجلي ويَقينا",15,"ن",2,0],["سِرعانَ ما تَنسِينَ والألمانُ ما","بَرِحَت سَنابكُ خَيلهم تُدميك",16,"ك",1,0],["سر عليه قلوب الخلق عاكفة","لَدى وليين حازا فضل كل وَلي",17,"ل",2,0],["سُرْعَانَ ما عاثَ جَيْشُ الكُفْرِ واحَرَبا","عَيْثُ الدَّبَى في مَغَانِيهَا التِي كَبَسا",18,"س",2,0],["سُرْعانَ ما فَجَعَ الزّمانُ بِغَصْبِهِ","وَالدَّهْرُ بالعِلْقِ النَّفيسِ فَجوعُ",19,"ع",1,0],["سُرْعانَ مَا أَسْلَمَ الكُفَّارُ فَاقْتُسِمَتْ","حُمُولُ حامِلِهِمْ لِلْحَيْنِ سُمَّانا",20,"ن",2,0],["سُرعانَ ما بانَ وجه الحقّ منسرباً","عَن كلّ لَبسٍ وزاحَ الريب والتهمُ",21,"م",1,0],["سر عجيب لم يحجبه الثرى","ما كان سر الله بالمحجوب",22,"ب",1,0],["سرّ عبد أطاع داعية الحبّ","بقلب معناه فوق المعاني",23,"ن",2,0],["سرعان ما حوَّلنا دهرُنا","من أريه الشافي إِلى صابه",24,"ب",2,0],["سر على أيمن سعدٍ صالح","سار إليه من هدى",25,"ا",1,0],["سرٌّ عجيبٌ فيه معنىً أعجبُ","وحيٌ غريبٌ فيه مرأى أغربُ",26,"ب",1,1],["سِرْ عَن بلادِهِمُ فقد سَئِمَتْ بها","عيسي مُحُولَ مُعرَّسي ومُناخي",27,"خ",2,1],["سرعانَ ما استعروا بجمرةِ بغيهم","ولربَّ باغٍ غرَّه الأنصارُ",28,"ر",1,0],["سرْعانَ ما ظنَّ الإكامَ مَناسراً","دلَفَتْ إليه بشَرِّها الفَيْفاءُ",29,"ا",2,0],["سر عظيم وهو يوسف مصرهم","وبأسر عشقك هم وأنت بأسرهم",30,"م",1,0],["سرْ على اسْم اللهِ محرو","ساً بأَجنادِ الملائِكْ",31,"ك",1,0],["سُرعانَ ما اِختَرتَ الرَحيلَ أَشَدَّ ما","اِحتاجَت لَكَ الأَوطانُ وَالأَوطارُ",32,"ر",1,0],["سرعان ما أُنْسِيْت ذاك الصفا","والأنس في تلك المغاني الحِسَان",33,"ن",1,0],["سر على اسم الله فيما تبتغي","يا محبي سالما من كل شر",34,"ر",1,1],["سرعان وشكان وبطآن وأخ","مضارع به تكرّهت وكخ",35,"خ",1,0],["سرعان ما ذهب الصبا وتقلبت","أفياؤه وأتاح فرط لغوب",36,"ب",1,0],["سر على الخيرِ والفلاح","وعلى الطائر السعيد",37,"د",1,0],["سَرعانَ ما انقطع الخيالُ لأنني","حالاً شُغِلتُ بما استحقَّ هيامي",38,"ي",1,0],["سَرعانَ ما تجري أُوَيقاتُ الهنا","ومن المُحَالِ يدومُ وقتُ تداني",38,"ي",1,0],["سر على اسم الله منصورا به","وارم عن قوس المقادير السهاما",39,"م",2,0],["سر على اسم الله ما من مسلم","ثم الا باسمك العالي استهاما",39,"م",2,0],["سر عمرو بمصر وانظر سنانا","قد أعاراك ثم طرف مراقب",40,"ب",1,0],["سر على اسم القرآن تحميه بالسيف","وتحمي منابرا ومحارب",40,"ب",1,0],["سرعان ما اذبلت من صبوتي","بنارك البيضا فما اضرمك",41,"ك",1,0],["سرعان ما بكيت من بعد ما ابتسمت","فلتشهد الآن ان الدهر غدار",42,"ر",1,0],["سر على السعد تستظل من الايام","ظلي سلامة وحبور",43,"ر",1,0],["سرعان ما قد عاد ربعي بلقعاً","وهتفن فيه نواعب الغربان",44,"ن",1,0],["سرعان ما اختلستك أنياب الردى","مني وأضلاعي عليك حوان",44,"ن",1,0],["سرعان ما اخنت عليك فسل بِها","دارا تجر بها الصبا اذيالها",45,"ل",3,0],["سرعان ما قد حط سفرهم","حتى ترحل ذلك السفر",46,"ر",1,0],["سرع الخطا لا السوط حل بجلدها","يوماً ولا شدّت بها أكوار",47,"ر",1,0],["سُرعان ما سرَّ الشَريعة مَطلعا","حَتّى تَبوَّأ في التُراب مَغيبا",48,"ب",2,0],["سر عَلى الرُشد آمنا كُل مَيل","بِفلاً لَم تَجب بِعيس وَخيل",49,"ل",1,1],["سرعان ما سدل اللثام على هوى","مني له متمكن بصميمي",50,"م",2,0],["سرعان ما ينأى ويهجرها إذا","ذهبا ويطلب غيرها ظمآنا",51,"ن",2,0],["سر على نية يقسو علانية","وإن تناج وجدت السر خير نجي",52,"ج",2,0],["سِر عليها يا ابنَ وِدِّي","سِر بنا نطلُبُ حَقّا",53,"ق",2,0],["سرَّ عليُّ القدرِ راقي الهمَّهْ","مَن بسجاياه افتخارُ الأمَّهْ",54,"ه",1,0],["سرُّ عزِّها","غَيرُ منكَتِم",55,"م",1,0],["سرعان ما اِنبتّ حَصي","د الوَصل منه واِنقضب",56,"ب",1,0],["سرعان ما طرق النعي","ي مطبّقاً وَمصمّما",57,"م",2,0],["سر على اليمن والشرف","ودع النفس والكلف",58,"ف",1,1],["سرعان ما قالت له لا تضطرب","واسلك ثنايا العلم واطلب ودها",59,"د",3,0],["سِر على اسمِ الله يا أش","كَلَ من غُصنِ لجينِ",60,"ن",1,1],["سُرعةً يرجعُ مهزوماً على","عقبيهِ ناكصاً يُبدِي انخناسه",61,"س",2,0],["سر على اسم اللَه ملكا أسعدا","تورد الأعداء كاسات الردى",62,"د",2,1],["سرعان ما عاد فيهم غبطَتي أَسَفاً","وَالنَوم سهداً وَراحاتي بهم تعبا",63,"ب",2,0],["سر عجيب جل عن أفهامنا","لا تستقل بدركه الأعمار",64,"ر",1,0],["سَرعانَ ما يذوي بِها الرَطيبُ","لا بِشرُها باقٍ وَلا التَقطيبُ",65,"ب",1,0],["سَرعانَ ما يَنقَشِعُ الجَهامُ","مِن سُحبِهِ وَيُسفِرُ الإِظلامُ",66,"م",1,0],["سَرعانَ ما تَزُولُ","وَحالُها يَحُولُ",67,"ل",1,0],["سرعان ما عاث الحما","م ونحن أيقاظ هجود",68,"د",1,0],["سُرعان ما رِيع ذاكَ السرب وَاأَسفي","فَاليَوم لا سبع فيهِ وَلا رُبعُ",69,"ع",1,0],["سرعان ما أقوت وأقفر ربعها","وغدت برغم 