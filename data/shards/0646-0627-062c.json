العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6142,"ولادة المرتضى لم يحوها أحد","https://www.poetsgate.com/ViewPoem.aspx?id=155710",""],[6210,"ألق السلام على القباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78228&r=&rc=20",""],[6323,"لغة الشعور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82174&r=&rc=5",""]],"verses":[["ناجِياً مُنقَلَبَ الأَب","غَثِ مِن بازٍ طَلوبِ",0,"ب",1,0],["ناجٍ إِذا زُجِرَ الرَكائِبُ خَلفَهُ","فَلَحِقنَهُ وَثُنينَ بِالحَلحالِ",1,"ل",1,0],["ناجى القولبَ الخافقات كمثله","ووشى بما تخفي الكِمام مع الزهرْ",2,"ر",1,0],["ناجَتْ طليح سُرَى لا يستفيق لها","هدَّت جوارحَهُ واستوهَنَتُ عَصَبَهْ",3,"ب",2,0],["ناجتْ به النَّاسَ أَوهامٌ مُعَرْبِدةً","لمَّا تَغَشَّتْهُمُ الأَحلامُ والظُّلَمُ",4,"م",1,0],["ناجِهِ وَاِذكُر لَهُ وَج","دَ أَبيهِ وَحَنينَه",5,"ن",2,0],["ناجَيتُ مَن أَهوى وَناجاني بِها","بَينَ الرِياضِ وَبَينَ ماءِ سُوَيسِرا",6,"ر",2,0],["ناجَيْتُ فيكَ الصِّفَاتِ حَتى","ناجَيْتَني ما لِذَاكَ نِدُّ",7,"د",1,0],["ناجِيَةٌ كَرَمٌ أَبوها تَبتَني","مِن غالِبٍ قُبَبَ البِناءِ الأَعظَمِ",8,"م",1,0],["ناجيةً تَرجو النَّجاةَ تارةً","بِسيْرِها وتارةً تخشى العَطَبْ",9,"ب",1,0],["ناجِ البحيرة وحدك الآنا","واجلس بهذا الصخر منفردا",10,"د",2,0],["ناج البحيرة والصخور وعد","فاستحلف الأغوار والغابا",10,"ب",2,0],["ناجيتُ قَبرَكِ استوحي غياهِبَهُ","عن ْحالِ ضيفٍ عليهُ مُعجَلا يفد",11,"د",1,0],["ناجَيتُ مِنهُ عُطارِداً وَلَرُبَّما","قَبَّلَتهُ فَلَثمتُ وَجهَ المُشتَري",12,"ر",2,0],["نَاجِ الممالكَ وَهي حَيْرَى تَنظُرُ","أُيراعُ سِربُكِ للسلام ويُذْعَرُ",13,"ر",1,1],["ناجيتَها فترنّمتْ وأجبتَها","فطوى البلادَ رَنينُها المتجاوبُ",14,"ب",1,0],["نَاجَاكِ يَلهجُ بالتحيَّةِ غَضّةً","حَيِّ الشَّهيدَ ورَدِّدي نجواكِ",15,"ك",1,0],["ناج الشّهيدَ وحدّثْ بعده الأثرا","وحَيِّ من نُورهِ ما كان مُدَّخَرا",16,"ر",2,1],["ناجِيَةٌ في عِزِّ أَملاكِها","أَن يُظهِرَ الدَهرُ لَها ما خَبَأ",17,"ب",2,0],["ناجيا الروضَ والبحيرةَ حتَّى","لمسَ الفنُّ فيهما عُنفوانَه",18,"ن",2,0],["ناجيتِ أحلامَ الربيعِ فأقبلتْ","وأشرتِ للصيف الوسيمِ فجاءَ",19,"ا",2,0],["ناجاهمو ببينات ربّه","فآمنتْ بنت خويلدٍ به",20,"ه",1,0],["نَاجُونَ مَهْمَا يُسَامُوا دُونَ مَا اعْتَقَدُوا","مِنْ اضْطِهادٍ وَمِنْ ذُلٍّ وَتَشْرِيدِ",21,"د",1,0],["ناجاكَ شِعري وَكُنتُ أُخرِسُهُ","عَنِ الوَرى قانِعاً بِمُقتَصَدي",22,"د",2,0],["ناجيتُ صورته، فعيَّ لسانها","وأشار نحوي لحظها متكلما",23,"م",2,0],["ناجيْتَه تَحت ظلِّ العرش عن كَثَبٍ","وصاحبُ الطُّور فوق الطُّور ناجاهُ",24,"ا",2,0],["ناجي، ببطن الأرض نَاجِ أحبَّتي","وانقُلْ إليهم -في الثرى- أشواقي",25,"ق",2,0],["ناجي لسانَ النثر قمْ واخطُب بهم","وأعِنْ لسان الشعر يا ميرابو",26,"ب",2,0],["ناجى على الطّور موسى ة الندام لنا","فكيف أغفل موسى حين ناجانا",27,"ن",2,0],["ناجاه بالوادي المقدّس نابذا","كَلِماً تلين لها القلوبُ وتخشعُ",28,"ع",1,0],["ناجى القَنا هاماً ليدروا أمرها","وَاِستَكشَفوا بفمِ الصوارمِ سرّها",29,"ه",2,0],["ناجي رؤاهُ فيا بلابلُ ردّدي","وبكى مُناهُ فيا حمائِمُ رجّعي",30,"ع",2,0],["ناجيت قلبي بذي المقاله","فدمدم الأفق بالشرر",31,"ر",1,0],["ناجيتكم فسكتم","سكت عنكم فقلتم",32,"م",1,0],["ناجوك والليل حلّاه الظلام سناً","كأنّه فود زنجيٍّ به وخط",33,"ط",1,0],["ناجٍ عَلى قَلائِصٍ عُلوِيّات","يَهوي عَلى شَراجِعٍ عَلِيّات",34,"ت",1,0],["ناجيتها في الليل اهفو إلى","حديثها والقلب كالمرجل",35,"ل",1,0],["ناجاه قلبي فوق طور وداده","حتى ثناه فخرَّ منه يُصعَق",36,"ق",1,0],["ناجى فُؤادي بِأَسرار تَأَولها","فَذابَ وَجداً بِمَعناها وَما شَعَرا",37,"ر",2,0],["ناجوكَ والليل حلّاهُ بهاء سنا","كما يحلى سواد اللمّة الشمَطُ",38,"ط",1,0],["ناجي مليك جمالها في طوره","قلب شجي بالغرام كليم",39,"م",1,0],["ناجيةً تأخذ من حظّها","مقبِلةً ما تركَتْ مدْبِرا",40,"ر",2,0],["ناجي الضمير فأوحى بالمهم له","فيما يقصه تذكيرا وتنبيها",41,"ي",3,0],["ناجت عطارد زهرة","شريف دور أفشها يا ماض",42,"ض",1,0],["ناجَتهُ عَنكَ البيضُ مِن بُعُدٍ","نُصحاً وَأَنقذ جَيشَه الرُعُبُ",43,"ب",1,0],["ناجي الإلهَ دائماً بِوَجْههِ","وبِشَريفِ جاههِ الرَّفيعِ",44,"ع",1,0],["ناجَيْتُه فتشرّفَتْ بكلامِه","أُذُنُ الكَليمِ وحُلَّ عَقْدُ لِساني",45,"ن",2,0],["ناجى بها موسى الكليم وقد رقى","عيسى بها روح الدجى ببكورها",46,"ر",3,0],["ناجٍ عَلى قَطَرِيَّةٍ","هادي التَعَسُّفِ ذائِبُ",47,"ب",1,0],["ناجِز بِنَفسِكَ واحتَسِبها واطَّرِح","في الحُبِّ لَومَ فُلانَةٍ وَفُلانِ",48,"ن",1,0],["ناجاك مؤتمن الضمير فلم يدع","سراً لممتلئِ الضمير مصونا",49,"ن",2,0],["نَاجزتَ في صَرْفِ آجَالٍ قَدِ اقْتَرَبَت","إذْ لاَ تُسَلِّمهَا إلاَّ يَداً بيدِ",50,"د",1,0],["ناجُوكَ أَوْ جالَوا بِأَمْرٍ مُعْلَنِ","فُزْتَ بِقِدْحَيْ مُعْرِبٍ لَمْ يَلْحَنِ",51,"ن",1,0],["ناجٍ يُعَنِّيهُنَّ بِالإِبْعاطِ","وَالماءُ نَضّاحٌ عَلَى الآباطِ",52,"ط",1,0],["ناجزت كل أخي غرامٍ فارعوى","أهل الهوى عنِّي ولست بمملقِ",53,"ق",1,0],["ناجِل مَرضْ مِنْ هَيرهم فوق هَمّين","مَ اقدَر أقوم ولا ارفَع الصوت مِحتار",54,"ر",1,0],["ناجيتها وهى تدري من يناجيها","فساءلت تربها من ذا يناديها",55,"ي",3,1],["ناجى الطبِّ والأدب","فُز بعيدٍ به العجب",56,"ب",1,1],["ناجِ بن جَرمٍ فَما أَسبابُ جيرَتِكُم","بني قدامَةَ إِن مولاهُمُ فَسَدا",57,"د",2,1],["ناجَزَهُ بِصارِمٍ صَقيلِ","ضَرباً طِلَحفاً لَيسَ بِالقَليلِ",58,"ل",1,0],["ناجَيتُ حتَّى لمحتُ اللَّحظَ حنَّ إلى","نجواي فيه حينَ الحُلمِ والرَّشَدِ",59,"د",1,0],["ناجيتُ قَبرَك والدّموع سَوافِح","ورأيتُ شَخصَك بالضّمير مُخَيَّلا",60,"ل",2,0],["ناجَ للجليل","أوهبَ التفضيل",61,"ل",1,0],["ناج الحقيقة واهجر كل مختبل","يدق للوهم أبواقاً وأجراسا",62,"س",2,0],["ناجى به موسى المنى وسما إلى","أمد فتمَّ بسعده ميقاته",63,"ت",2,0],["ناجيته أن قد سلاك وما نوى","لك سلوة أفلا تبيت كليما",64,"م",2,0],["ناجَيتُ بِالذِكرِ وَالدُعاءِ لَكَ اللَ","هَ لَدى البَيتِ رافِعاً يَدِيَه",65,"ي",2,0],["ناجٍ تَرى المِرفَقَ عَن زَورِه","كَأَنَّما يَفتِلُه فاتِلُ",66,"ل",1,0],["ناجيتُ بالطرف الحسير","وهويت بالقلب الكسير",67,"ر",1,1],["ناجَيتُها وَالبَدرُ يُشبِهُ صَفحَةً","فَوقَ المِياهِ شَديدَةَ اللَّمَعانِ",68,"ن",1,0],["ناجماتِ النّهودِ مثلَ حقاقِ ال","عاجِ في اللُّطفِ مُدمجاتِ الخصُورِ",69,"ر",1,0],["ناج يحاكي نجا مستانِساً لهقا","طاو يجوب الفلا أو نقنقاً زعِلا",70,"ل",2,0],["ناجيت آمالي وما دار في","وهميَ أني بالغ مأملي",71,"ل",2,0],["ناج بدر السماء بالأسرار","واشكه ما تحس من أكدار",72,"ر",1,1],["ناجت بفيلقه الدنيا فافزعها","كالبحر ماج وفيه الغنم والعطب",73,"ب",1,0],["ناجني نجوى ادّكار","واشد لي ليل نهار",74,"ر",1,1],["ناج القريب بكى العين معتكفاً","فإن عكفت على نجواه نجاك",75,"ك",1,0],["ناجى لنا تلك البقيّة واِنثَرى","تِلكَ الدراري وَالعقود نظاما",76,"م",2,0],["ناجيت أطلال الحضارة باكيا","والنار دمع الحزن يضرم وقدها",77,"د",3,0],["ناجيتُها ولزمتُها","دأباً فصارت ملكَهْ",78,"ه",1,0],["ناجني منك بألفاظ حلت","دون معناها كؤس السلسبيل",79,"ل",1,0],["ناجيته ودعوته اكشف عن عشا","قلبي وعن بصري وأنت النور",80,"ر",1,1],["ناجاهُ مَولاهُ مِن أَوجِ السَعادَةِ في","عامٍ يُؤَرَّخُ خُذ آجار مَن صَبَروا",81,"ر",3,0],["ناجِ الطُيورَ عَلى الغُصون إِذا اِرتَقَت","وَدَعِ الوَرى وَاِسمَع لَها أَلحانا",82,"ن",2,0],["ناجى زَهَرَ الرَوض نَسيمٌ وانِ","يَغشاه وَلا الرِقادُ في الأَجفانِ",83,"ن",1,1],["ناجَيتُ فَما راق مُحبّي النَجوى","ما الحيلَةُ بَعدَما اِستَحال الشَكوى",84,"ك",3,1],["ناجاهُ بِأَسرار غَرامي الفَهمُ","فالوَجنَةُ قَد أَثَّر فيها الوَهمُ",85,"م",1,1],["ناجى نَفسَ الصَباح وَردٌ هاجا","ما لي عَبَثت بي الصَبا اِسِتدراجا",86,"ج",2,1],["ناجيتهُ .. ناديتهُ بمشاعري","ولدىَّ في فصلِ الخطابِ أصولُ",87,"ل",1,0],["ناجيت أنفيَّةً طاب الأريج بها","تاللَهِ قد عطَّر الأكوانَ ريّاك",88,"ك",1,1],["ناجاه داود يا مولاي مرحمةً","لبنانُ باكٍ ومنهُ الدمع في حدرِ",89,"ر",1,0],["ناجيتُ حرصاً على هذين مبتهلا","ليتَ الملاحَ وليتَ الراح لو جُعلا",90,"ل",2,0],["ناجتهمُ البشرى أرَختُ وسُرُّها","قد نال نصراً من سخا الرب الجليل",91,"ل",1,0],["ناجتهُ في طورِ الهَوى فاِنثنت","كليمةً مذ أَمّلَت أَن تَراه",92,"ا",2,0],["ناجيت أقلامي التي أهملت","سرد الحكايات لأنشودتي",93,"ت",2,0],["ناج من النجو مشتق وما العذرة","يوماً بأنجس من أرهاطه القذره",94,"ر",2,1],["ناجيتُ ذكراه وقد أَبلى الردى","ويحَ الرَّدى في التُّربِ غَضُّ إهابِهِ",95,"ب",2,0],["ناج رب الكون ليلا بالذي","سيزيل الرين من فوق القلوب",96,"ب",1,0],["ناجاكَ لحنَ العاشقين بليلةٍ","فيها كسوةَ اللامعات سناكا",97,"ك",2,0],["ناجتك يا روح المنى روحي فلم","يك بيننا حتى النسيم سول",98,"ل",1,0],["ناجيتَ ..مِن خلفِ المنامِ صبابةً","وحضَنْتَ روحًا طىَّ قَدٍّ قَدْ هَلَكْ",99,"ك",1,0],["ناجيت ليلاك في حزن لنائحة","قد ودّعت في هواك الهم والالما",10