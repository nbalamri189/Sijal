{"poems":[[53,"عظيم الأسى في هذه غير مقنع","https://www.aldiwan.net/poem30141.html","الطويل"],[63,"سرت وجنح الليل غربيب","https://www.aldiwan.net/poem46147.html","السريع"],[55,"لقد شامتك يا عباس","https://www.aldiwan.net/poem26197.html","الهزج"],[77,"قل للأشوني ولا تحتشم","https://www.aldiwan.net/poem36657.html","السريع"],[73,"رضاك لنا قبل الطهور مطهر","https://www.aldiwan.net/poem11954.html","الطويل"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[51,"أبا حسن قد قلت لو كان فعال","https://www.aldiwan.net/poem65941.html","الطويل"],[62,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[45,"أجدك ما ينفك يسري لزينبا","https://www.aldiwan.net/poem10897.html","الطويل"],[45,"أنافعي عند ليلى فرط حبيها","https://www.aldiwan.net/poem66850.html","البسيط"],[28,"نظر الدلهمس نظرة ما ردها","https://www.aldiwan.net/poem5252.html","الكامل"],[61,"ثنت لك أعطافها والخصورا","https://www.aldiwan.net/poem51673.html","المتقارب"],[80,"ثلاثة أفلاك عن العين مضمره","https://www.aldiwan.net/poem31435.html","الطويل"],[51,"أبا حسنٍ قد قلتَ لو كان فَعّالٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30293",""],[144,"مساعيك لا تحصى فتدرك بالعد","https://www.aldiwan.net/poem11749.html","الطويل"],[144,"شفاء الهدى يا سيفه العضب أن تشفا","https://www.aldiwan.net/poem11779.html","الطويل"],[144,"تخلف عنه الصبر فيمن تخلفا","https://www.aldiwan.net/poem11783.html","الطويل"],[151,"أرقت لبرق من تهامة مومض","https://www.aldiwan.net/poem68586.html","الطويل"],[151,"دع القول في يوم بدارة جلجل","https://www.aldiwan.net/poem68591.html","الطويل"],[186,"صلى الإله عليك يا بن رسوله","https://www.aldiwan.net/poem14639.html","الكامل"],[187,"تحن إلى الغنى النفس الفقيره","https://www.aldiwan.net/poem43786.html","الوافر"],[187,"شربت بالمكاره في نهاري","https://www.aldiwan.net/poem43265.html","الوافر"],[190,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[200,"يا ويح دهري لم يبقي","https://www.aldiwan.net/poem45655.html","المجتث"],[236,"أيا مولاي مجد الدين يا من","https://www.aldiwan.net/poem32192.html","الوافر"],[238,"أريح الصبا هبت على زهر الربا","https://www.aldiwan.net/poem18041.html","الطويل"],[249,"خلقت امرأ لا أخلط الجد بالهزل","https://www.aldiwan.net/poem1317.html",""],[251,"ودار خراب قد ترلت","https://www.aldiwan.net/poem14994.html","المتقارب"],[271,"أرى علمنا والمدعون بنوه","https://www.aldiwan.net/poem35066.html","الطويل"],[271,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[347,"وقائلة لي حين شبهت وجهها","https://www.aldiwan.net/poem24112.html","الطويل"],[364,"ولم أر هالكا من أهل نجد","https://www.aldiwan.net/poem1710.html","الوافر"],[365,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[365,"أثرها فقد طال الغداة وقوعها","https://www.aldiwan.net/poem60849.html","الطويل"],[367,"سلام على تلك الخلائق إنها","https://www.aldiwan.net/poem17939.html","الطويل"],[372,"نحن يوما وصل ويوما فراق","https://www.aldiwan.net/poem57277.html","الخفيف"],[378,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[378,"رويدا رويدا يا حداة الركائبِ","https://www.aldiwan.net/poem66929.html","الطويل"],[381,"لك الحمد يا من حصل","https://www.aldiwan.net/poem48754.html","مجزوء المتقارب"],[381,"أبرق سرى وهنا فهيج أشجاني","https://www.aldiwan.net/poem48778.html","الطويل"],[407,"محل العلى أني حللت محلها","https://www.aldiwan.net/poem50133.html","الطويل"],[433,"أسف موثق ودمع طليق","https://www.aldiwan.net/poem12681.html","الخفيف"],[433,"ولما بدا ركب السحاب تسوقه","https://www.aldiwan.net/poem12796.html","الطويل"],[438,"أجل قد تمادى الأمر وانصرم العمر","https://www.aldiwan.net/poem2542.html","الطويل"],[438,"عقت دارها إلا ثلاثا بها سحما","https://www.aldiwan.net/poem2592.html","الطويل"],[440,"عادت عليك عوائد الأعوام","https://www.aldiwan.net/poem34806.html","الكامل"],[440,"ولا في سرور العيد نحن مهنوه","https://www.aldiwan.net/poem34860.html","الطويل"],[469,"يا سهل سهلت عيشي","https://www.aldiwan.net/poem60027.html","المجتث"],[480,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[516,"أيا سفح المقطم كم سفحنا","https://www.aldiwan.net/poem12289.html","الكامل"],[517,"كأن القلب ليلة قبل يغدي","https://www.aldiwan.net/poem48707.html","الوافر"]],"verses":[["فَلا فُجِعَت بِالعِزِّ دارُكَ ساعَةً","وَلا غُضَّ مِن بابِ الرَواقِ المُرَفَّعِ",0,"ع",1,0],["فلا فؤادي للنّوى خافِقٌ","وَجْداً ولا دَمْعيَ مَسْكوبُ",1,"ب",1,0],["فَلا فَرَّجَ عَنكَ اللَ","هُ إِن لَم تَأتِ مَثواكا",2,"ك",2,0],["فلا فَمٌ يُعْمِلُ في لَفْظَةٍ","ولا يَدٌ تَدْنو الى فَرْجِ",3,"ج",1,0],["فَلا فارَقَ الدُنيا سَناءٌ مُقَدَّسٌ","بِعَيشِكَ فيها أَو ثَناءٌ مُجَمَّرُ",4,"ر",1,0],["فلا في الهَنات المُحفظات إباؤها","ولا في الحقوق الواجبات بخوعها",5,"ع",3,0],["فلا في تأنّيه المبادئَ إغفالُ","ولا في تلافيه العواقبَ إعجالُ",6,"ل",1,0],["فلأُفردنَّك بالمدائحِ إنَّها","دررٌ وهنَّ على عُلاك نِثَارُ",7,"ر",1,0],["فَلا فُزتُ مِن مَرِّ اللَيالي بِراحَةٍ","إِذا أَنا لَم أُصبِح بِشُكرِكَ مُتعَبا",8,"ب",2,0],["فَلا فَضيلَةَ إِلّا أَنتَ لابِسُها","وَلا رَعِيَّةَ إِلّا أَنتَ راعيها",9,"ي",3,0],["فَلَأَفخَرَنَّ عَلَيكَ فَخراً لي بِهِ","قُحَمٌ عَلَيكَ مِنَ الفَخارِ كِبارُ",10,"ر",1,0],["فلا فَضْلَ للعُودِ حتّى يَحِنَّ","ولا حمْدَ للكأسِ حتّى تَدورا",11,"ر",2,0],["فلا فَلَكٌ إلّا يُخَصُّ بدورةً","موافقةٍ منها الخلافَ مُقَرَّره",12,"ر",2,0],["فلا في تأنّيه المبادىء إِغفالٌ","ولا في تلافيه العواقبَ إعجالُ",13,"ل",1,0],["فَلا فَلَّلَت أَحداثُهُ غَربَ صارِمٍ","وَفي اللَهُ لِلإِسلامِ مُذ سُلَّ بِالوَعدِ",14,"د",1,0],["فَلا فَلَّتِ الأَيّامُ عَزماً مَضاؤُهُ","شَفى الحَقَّ مِن أَدوائِهِ بَعدَ أَن أَشفا",15,"ف",2,0],["فَلا فُلَّ عَزمٌ شَرَّدَ الخَوفَ عَنهُمُ","وَأَسكَنَهُم ظِلّاً مِنَ الأَمنِ قَد ضَفا",16,"ف",2,0],["فَلا فِكرُهُ يَسهو وَلا قَلبُهُ يُغفي","وَكَيفَ وَقَد نَقّى مِنَ الرِجسِ صَدرَهُ",17,"ه",1,0],["فَلا فاضِلٌ إِلّا مُقِرٌّ بِفَضلِهِ","عَمائِمُهُم تَهوي اِنخِفاضاً لِنَعلِهِ",17,"ه",1,0],["فَلا فِكرَ في لَبسٍ وَلا رجلَ في دَحضِ","بِهِ أَوضَحَ اللَهُ السَبيلَ وَقَصدَهُ",18,"ه",1,0],["فلأَفْخَرَنَّ به لأكِمد حاسدي","حتى يموتَ بغيظه وغَليله",19,"ل",2,0],["فلا فقر يهذب قلب حر","ولا شغل بأموال كثيره",20,"ر",2,0],["فلا في الحل لي حظّ يرجّى","ولا متّعت من وجه الحرام",21,"م",1,0],["فَلا فضلَ جلّت فيه حظّاً سهامُهم","على الخلقِ إلّا سهمهُ كان أعظما",22,"م",2,0],["فلا فؤادَ سليمٌ","ولا ودادَ صحيحُ",23,"ح",1,0],["فَلا في جُملَةِ الأَحرارِ أُدعى","وَلا بَينَ العَبيدِ وَلا الإِماءِ",24,"ا",2,0],["فَلا في هَؤُلاءِ إِذا سَمَحتُم","تَعُدُّني وَلا في هَوئلاءِ",24,"ا",2,0],["فلا فارَقتْ منه السَّعَادَةُ قائماً","وَلا فَلَّتَتْ منه الحَوادِثُ مَضْرِبا",25,"ب",2,0],["فلا فضل في ان يصبح المرء عالما","اذا كان يأبى ان يشارك في الفضل",26,"ل",1,0],["فلا فَرّقَ ما بين أني أكو","نُ بها أو أكون على القارِعَه",27,"ع",2,0],["فلا فضلَ إلا للقديمِ لأنه","قديمٌ وهذا مبدأٌ وَرثوه",28,"و",2,0],["فلا فقه إلا ما ارتأى فقهاؤها","وعنهم وعنها يأخذُ الفقهاء",29,"ا",2,0],["فَلا فَخرَ إِن شَبَّهتَ بِالبَدرِ مَبسَمي","وَبِالسِحرِ أَجفاني وَبِاللَيلِ مَدعَجي",30,"ج",2,0],["فَلا فَرِحٌ بِخَيرٍ أَن أَتاهُ","وَلا جَزِعٌ مِنَ الحَدَثانِ لاعِ",31,"ع",1,0],["فلا فاضِلٌ تَلْقاهْ إلاّ وعندَه","يُبدِّلُ عزّاً يَقْتَنيهِ بهُون",32,"ن",1,0],["فلا فَخْرَ في هذا ومن قبلُ قد صفَتْ","بسَعْيكَ للمُلْكِ البلادُ جَميعها",33,"ع",3,0],["فَلا فَلَّ صَرفُ الدَهرِ حَدَّ شَباتِها","وَلا صَحِبَت إلّا السَلامَةَ وَاليُمنا",34,"ن",2,0],["فَلأَفعالِه التمامُ وللأش","عارِ من قَبل وصفِهنَّ المِحاقُ",35,"ق",1,0],["فلا فضل في ابنٍ جاء للَه طائعاً","لك الخير إن الفضل في النفس يُعرَف",36,"ف",1,0],["فلا فوز إلّا في حماك مؤيدي","ولا رشد إلّا في هداك مصاقبي",37,"ب",2,0],["فَلا فاتَ راياتِهِ","بُلوغ المُنى وَالأَمَل",38,"ل",1,0],["فَلا فَضَ فَوه فَهُوَ مَعدَن دره","وَلا بَرَّ مِن يَجفوهُ مِن حاسد شاني",39,"ن",2,0],["فَلا فَضلَ لي بَل فضلها منك كلّه","وَلَكِن كَساني حلَّة الفَخر أَهلُها",40,"ل",3,0],["فلآفاقِه محيّا عَبوسٌ","ولساحاته محيّا طليقُ",41,"ق",1,0],["فلا فرقَ ما بين السحابِ وبينِه","سوى أنّ ذا صافٍ وذاك مكدَّرُ",42,"ر",1,0],["فلا فخر إلا لآمرني شاد مجده","ولا مجد إلا ما يسيره الشعر",43,"ر",1,0],["فلا فتئت تفلي عليّ صدورهُم","بما قد حباني اللّه من فضله علما",44,"م",2,0],["فَلأَفْخَرَنَّ عَلَى الزمانِ وأَهلِهِ","بِصِلاتِ جودٍ من نداكَ كِرامِ",45,"م",1,0],["فلا فَضَّنا دهرٌ وأَنتَ تلُمُّنا","ولا مَضَّنا جُرْحٌ ويمناكَ تَأْسُوهُ",46,"و",2,0],["فَلا فَقَدتُكَ جاها","وَلا عَدِمتُكَ ذُخرا",47,"ر",2,0],["فلا فإنسانية","قمتم ولا بالمذهب",48,"ب",1,0],["فلا فقدت ضلوعي فيك وجداً","عوازبه تثور من الكمين",49,"ن",1,0],["فَلا في اللَيلِ نالَت ما ترجّي","وَلا في الصُبحِ كانَ لَها بَراح",50,"ح",1,0]]}