وعا","https://www.poetsgate.com/ViewPoem.aspx?id=177265",""],[4984,"تعيدك للأمس أيامُنا","https://www.poetsgate.com/ViewPoem.aspx?id=215388",""],[5002,"هدية العام الجديد...","https://www.poetsgate.com/ViewPoem.aspx?id=202150",""],[5072,"رهو ٌ هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=51900",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5431,"زمانٌ لا يكفّ عن الخداع","https://www.poetsgate.com/ViewPoem.aspx?id=215980",""],[5436,"حديثُ الموت والنصر (تركي عبد الغني )","https://www.poetsgate.com/ViewPoem.aspx?id=33447",""],[5442,"سرى والدحى شوق إليه وتذكار","https://www.poetsgate.com/ViewPoem.aspx?id=114746",""],[4480,"لَعَمْرِي وما دَهْرِي بِتَأْبِينِ iiهَالِكٍ","https://www.poetsgate.com/ViewPoem.aspx?id=18228",""],[5582,"أَلا اِحببها وَباشرها هبوبا","https://www.poetsgate.com/ViewPoem.aspx?id=63467",""],[5582,"لِمن مربع بالسفحِ أَقوت ملاعبه","https://www.poetsgate.com/ViewPoem.aspx?id=63464",""],[5605,"الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=161109",""],[5704,"بلاد العرب","https://www.poetsgate.com/ViewPoem.aspx?id=197638",""],[5829,"حبل الله المتين","https://www.poetsgate.com/ViewPoem.aspx?id=202151",""],[5906,"آدمية جائرة","https://www.poetsgate.com/ViewPoem.aspx?id=188520",""],[6136,"عبرة إلى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=36239",""]],"verses":[["فَلا فُجِعَت بِالعِزِّ دارُكَ ساعَةً","وَلا غُضَّ مِن بابِ الرَواقِ المُرَفَّعِ",0,"ع",1,0],["فلا فؤادي للنّوى خافِقٌ","وَجْداً ولا دَمْعيَ مَسْكوبُ",1,"ب",1,0],["فَلا فَرَّجَ عَنكَ اللَ","هُ إِن لَم تَأتِ مَثواكا",2,"ك",2,0],["فلا فَمٌ يُعْمِلُ في لَفْظَةٍ","ولا يَدٌ تَدْنو الى فَرْجِ",3,"ج",1,0],["فَلا فارَقَ الدُنيا سَناءٌ مُقَدَّسٌ","بِعَيشِكَ فيها أَو ثَناءٌ مُجَمَّرُ",4,"ر",1,0],["فلا في الهَنات المُحفظات إباؤها","ولا في الحقوق الواجبات بخوعها",5,"ع",3,0],["فلا في تأنّيه المبادئَ إغفالُ","ولا في تلافيه العواقبَ إعجالُ",6,"ل",1,0],["فلأُفردنَّك بالمدائحِ إنَّها","دررٌ وهنَّ على عُلاك نِثَارُ",7,"ر",1,0],["فَلا فُزتُ مِن مَرِّ اللَيالي بِراحَةٍ","إِذا أَنا لَم أُصبِح بِشُكرِكَ مُتعَبا",8,"ب",2,0],["فَلا فَضيلَةَ إِلّا أَنتَ لابِسُها","وَلا رَعِيَّةَ إِلّا أَنتَ راعيها",9,"ي",3,0],["فَلَأَفخَرَنَّ عَلَيكَ فَخراً لي بِهِ","قُحَمٌ عَلَيكَ مِنَ الفَخارِ كِبارُ",10,"ر",1,0],["فلا فَضْلَ للعُودِ حتّى يَحِنَّ","ولا حمْدَ للكأسِ حتّى تَدورا",11,"ر",2,0],["فلا فَلَكٌ إلّا يُخَصُّ بدورةً","موافقةٍ منها الخلافَ مُقَرَّره",12,"ر",2,0],["فلا في تأنّيه المبادىء إِغفالٌ","ولا في تلافيه العواقبَ إعجالُ",13,"ل",1,0],["فَلا فَلَّلَت أَحداثُهُ غَربَ صارِمٍ","وَفي اللَهُ لِلإِسلامِ مُذ سُلَّ بِالوَعدِ",14,"د",1,0],["فَلا فَلَّتِ الأَيّامُ عَزماً مَضاؤُهُ","شَفى الحَقَّ مِن أَدوائِهِ بَعدَ أَن أَشفا",15,"ف",2,0],["فَلا فُلَّ عَزمٌ شَرَّدَ الخَوفَ عَنهُمُ","وَأَسكَنَهُم ظِلّاً مِنَ الأَمنِ قَد ضَفا",16,"ف",2,0],["فَلا فِكرُهُ يَسهو وَلا قَلبُهُ يُغفي","وَكَيفَ وَقَد نَقّى مِنَ الرِجسِ صَدرَهُ",17,"ه",1,0],["فَلا فاضِلٌ إِلّا مُقِرٌّ بِفَضلِهِ","عَمائِمُهُم تَهوي اِنخِفاضاً لِنَعلِهِ",17,"ه",1,0],["فَلا فِكرَ في لَبسٍ وَلا رجلَ في دَحضِ","بِهِ أَوضَحَ اللَهُ السَبيلَ وَقَصدَهُ",18,"ه",1,0],["فلأَفْخَرَنَّ به لأكِمد حاسدي","حتى يموتَ بغيظه وغَليله",19,"ل",2,0],["فلا فقر يهذب قلب حر","ولا شغل بأموال كثيره",20,"ر",2,0],["فلا في الحل لي حظّ يرجّى","ولا متّعت من وجه الحرام",21,"م",1,0],["فَلا فضلَ جلّت فيه حظّاً سهامُهم","على الخلقِ إلّا سهمهُ كان أعظما",22,"م",2,0],["فلا فؤادَ سليمٌ","ولا ودادَ صحيحُ",23,"ح",1,0],["فَلا في جُملَةِ الأَحرارِ أُدعى","وَلا بَينَ العَبيدِ وَلا الإِماءِ",24,"ا",2,0],["فَلا في هَؤُلاءِ إِذا سَمَحتُم","تَعُدُّني وَلا في هَوئلاءِ",24,"ا",2,0],["فلا فارَقتْ منه السَّعَادَةُ قائماً","وَلا فَلَّتَتْ منه الحَوادِثُ مَضْرِبا",25,"ب",2,0],["فلا فضل في ان يصبح المرء عالما","اذا كان يأبى ان يشارك في الفضل",26,"ل",1,0],["فلا فَرّقَ ما بين أني أكو","نُ بها أو أكون على القارِعَه",27,"ع",2,0],["فلا فضلَ إلا للقديمِ لأنه","قديمٌ وهذا مبدأٌ وَرثوه",28,"و",2,0],["فلا فقه إلا ما ارتأى فقهاؤها","وعنهم وعنها يأخذُ الفقهاء",29,"ا",2,0],["فَلا فَخرَ إِن شَبَّهتَ بِالبَدرِ مَبسَمي","وَبِالسِحرِ أَجفاني وَبِاللَيلِ مَدعَجي",30,"ج",2,0],["فَلا فَرِحٌ بِخَيرٍ أَن أَتاهُ","وَلا جَزِعٌ مِنَ الحَدَثانِ لاعِ",31,"ع",1,0],["فلا فاضِلٌ تَلْقاهْ إلاّ وعندَه","يُبدِّلُ عزّاً يَقْتَنيهِ بهُون",32,"ن",1,0],["فلا فَخْرَ في هذا ومن قبلُ قد صفَتْ","بسَعْيكَ للمُلْكِ البلادُ جَميعها",33,"ع",3,0],["فَلا فَلَّ صَرفُ الدَهرِ حَدَّ شَباتِها","وَلا صَحِبَت إلّا السَلامَةَ وَاليُمنا",34,"ن",2,0],["فَلأَفعالِه التمامُ وللأش","عارِ من قَبل وصفِهنَّ المِحاقُ",35,"ق",1,0],["فلا فضل في ابنٍ جاء للَه طائعاً","لك الخير إن الفضل في النفس يُعرَف",36,"ف",1,0],["فلا فوز إلّا في حماك مؤيدي","ولا رشد إلّا في هداك مصاقبي",37,"ب",2,0],["فَلا فاتَ راياتِهِ","بُلوغ المُنى وَالأَمَل",38,"ل",1,0],["فَلا فَضَ فَوه فَهُوَ مَعدَن دره","وَلا بَرَّ مِن يَجفوهُ مِن حاسد شاني",39,"ن",2,0],["فَلا فَضلَ لي بَل فضلها منك كلّه","وَلَكِن كَساني حلَّة الفَخر أَهلُها",40,"ل",3,0],["فلآفاقِه محيّا عَبوسٌ","ولساحاته محيّا طليقُ",41,"ق",1,0],["فلا فرقَ ما بين السحابِ وبينِه","سوى أنّ ذا صافٍ وذاك مكدَّرُ",42,"ر",1,0],["فلا فخر إلا لآمرني شاد مجده","ولا مجد إلا ما يسيره الشعر",43,"ر",1,0],["فلا فتئت تفلي عليّ صدورهُم","بما قد حباني اللّه من فضله علما",44,"م",2,0],["فَلأَفْخَرَنَّ عَلَى الزمانِ وأَهلِهِ","بِصِلاتِ جودٍ من نداكَ كِرامِ",45,"م",1,0],["فلا فَضَّنا دهرٌ وأَنتَ تلُمُّنا","ولا مَضَّنا جُرْحٌ ويمناكَ تَأْسُوهُ",46,"و",2,0],["فَلا فَقَدتُكَ جاها","وَلا عَدِمتُكَ ذُخرا",47,"ر",2,0],["فلا فإنسانية","قمتم ولا بالمذهب",48,"ب",1,0],["فلا فقدت ضلوعي فيك وجداً","عوازبه تثور من الكمين",49,"ن",1,0],["فَلا في اللَيلِ نالَت ما ترجّي","وَلا في الصُبحِ كانَ لَها بَراح",50,"ح",1,0],["فلا فوقنا فوق ولا تحت تحتنا","ولا قبلنا قبل ولا بعدنا دانى",51,"ن",2,0],["فلا فرق إن هز القناة أو انتضى","يراعاً فعن كلتيهما الخصم ناكب",52,"ب",1,0],["فلا في الجود مصرفُهُنَّ يوماً","ولا في شِبعِ أيتام خِماص",53,"ص",1,0],["فَلا فُضَّ فاها لا ولا خين فِكرة","وَلا عاشَ جافيهِ وَأَكبت بِالبَطحِ",54,"ح",1,0],["فَلا فضّ فاها لا ولا خينَ فكرة","وَإِنّ الّذي يَشنوه في الدَّهرِ تالفُ",55,"ف",1,0],["فَلا فَنَّ إِلّا وَهوَ فيهِ إِمامُه","وَلا مُشكِلَ إِلّا لَهُ هُوَ سابِقُ",56,"ق",1,0],["فلا فِضَّةٌ أنجتْهُ عند انقضاضه","ولا ذَهَبٌ أنجاه عند ذَهابه",57,"ب",2,0],["فلا فُرِّقَ الشملُ الذي أنتَ جامع","ولا كُسِّرَ العظمُ الذي أنتَ جابره",58,"ر",2,0],["فلا فخارٌ ولا مجدٌ ولا شرَفٌ","إلا لمنْ سادنا بالأصلِ والمالِ",59,"ل",1,0],["فلا فوت إلا أن تقادم فضله","ولا موت إلا أن تصادم نصلُهُ",60,"ل",2,0],["فلا فرح يزدهيه الغنى","ولا عند حاثدة بالجزوعِ",61,"ع",1,0],["فلا فاضل الا وأنت امامه","فقد جمعت بالفضل فيك الفضايل",62,"ل",1,0],["فلا في هوىً أَضحى إلى اللهو قائداً","ولا في تُقىً أمسى إلى اللَه يُزلِفُ",63,"ف",1,0],["فلا في علاك قَلبُه جالَ مطعماً","ولا يف سناك طرفُه نالَ مطمحا",64,"ح",2,0],["فَلا فُحُشٌ في دارِنا وَصَديقِنا","وَلا وُرُعُ النُهبى إِذا اِبتُدَرَ المَجدُ",65,"د",1,0],["فلا فضلَ أعظمُ من فضلها","عليكِ سوى نعمةِ المُبدِعِ",66,"ع",1,0],["فلا فرق عندي بين قاض وكاتبٍ","وشى ذا بحق أو قضى ذا بباطل",67,"ل",1,0],["فلا فرج الإله همومَ قوم","بفتح القول كانوا مبتدينا",68,"ن",2,0],["فلا فُطِمَتْ تلك الثنية من حيا","يُبَاكِرُ طِفْلَ النبت فيها فيَرْضَعُ",69,"ع",1,0],["فلا فيها عذول أو لا مبذّر","ولا مبدي سدودٍ داخليّه",70,"ي",2,0],["فلا في البيض من ربت شراته","فمن من شاع في الشيخان مجده",71,"د",2,0],["فلا فضلَ في الأسماء إنْ كنت ذا حجى","وإن كان منها ذو علوٍّ وسافلُ",72,"ل",1,0],["فلا فقدتْك العينُ مَا افترّت الرُّبا","وجادت حيا الوسيمة الهَطِلاتِ",73,"ت",1,0],["فَلأفرجن الهمَّ في عيدية","وَالهمُّ يَفرج في بَناتِ العيد",74,"د",1,0],["فلا في أميمة لي مطمع","يحن ولا مرغب في أمامه",75,"م",2,0],["فَلا فضل إِلا حلّها حينَ حلّها","فقُل لمعاديها عثرت فلا لَعا",76,"ع",2,0],["فلا فتئت اوصافك الغرّ مورداً","يخفُّ اليها للعلى كلُّ ناهلِ",77,"ل",1,0],["فَلا فَرَساً رَكِبْتَ لِدفْعِ ضَيْمٍ","ولاَ غَشَاكَ يومَ الحرب نَقْعُ",78,"ع",1,0],["فَلا فَرق الرَحمن يا قَوم شَملَكُم","وَلا ذكرت ما بَينكُم شقة البُعد",79,"د",1,0],["فَلا فاجِرٌ لِلبَرِّ يَحفَظُ حُرمَةً","وَلا يَستَطيعُ البَرُّ دَفعاً لِفاجِرِ",80,"ر",1,0],["فلا فتئت مروان تجري ملوكها","مجاري الدراري طالعا إثر آفل",81,"ل",1,0],["فلا فيك ذوق لا ولا فيك فطنة","ولا فيك تأديبٌ ولم تدر محسوسا",82,"س",2,0],["فلا فرق الرحمن بيني وبينكم","بطرفة عين من جواركم المرضي",83,"ض",2,0],["فلا فرَّقت أيدي الزمان وجوهكم","وإن فرقتني عن وجوه لكم تسبي",84,"ب",2,0],["فَلا فَضحَت نُظم الجمان قَصائدي","وَلا بَلَغَت بي رقتي كُل مَقصَد",85,"د",1,0],["فَلا في ذا وَلا في ذاكَ يُلفَى","وَلَكن مثله مثل النَعامه",86,"م",2,0],["فَلا فَضلَ إِلّا وَهوَ مِن فَضلِ جودِهِ","وَلا بِرَّ إِلّا دونَهُ ذَلِكَ البِرُّ",87,"ر",1,0],["فلا فتئت بهم أيدي المعالي","مؤيدة وعين اللؤم سخنى",88,"ن",2,0],["فلا فرق بين النيل يوما ودجلة","فدجلة تهواه كما هو يهواها",89,"ا",3,0],["فلا فُزتُ بحظِّي مِن","ك إن ذاع له ذِكرُ",90,"ر",1,0],["فلا فرحٌ يلذُّ ولا انبساطٌ","يطيبُ سوى منادمةِ الحسانِ",91,"ن",1,0],["فلا فرَح إذا نِلنا مَنالاً","ولا جَزَع لأيامِ المثال",92,"ل",1,0],["فلا فارق الحزن المبرح خاطري","لبعدك حتى يجمع الشمل قادر",93,"ر",1,0],["فلا فخر أعلى من فخار محمد","ولا عزّ أسمى ولا مجد أسبقا",94,"ق",2,0],["فلا فض فوك لا رأيت مكدراً","ولا زلت طول الدهر تنفث بالدر",95,"ر",1,0],["فَلاَ فَجْرُهُ يَبْدُو ولا الطُّولُ يَنْقَضِي","وَلا عَنْ فاادي حالُ صَحْبي بِغااب",96,"ب",1,0],["فلا فَرِحاً إن كنتُ يوماً بغبطة","ولا جَزِعاً مما أصابض فأوجعا",97,"ع",2,0],["فَلا فَضلَ إِلّا أَن يَكونَ جَراءَةٌ","ذَوي بَدَنَينِ وَالرؤوسُ حَواسِرُ",98,"ر",1,0],["فلا فرق بين الدون والدون في القضا","وإرّيسهم في اليُسر والرفه أرّيس",99,"س",1,0],["فَلأفطمنّ النفس عن لذَّاتها","وليشجني بعد الغناء عويل",100,"ل",1,0],["فلا فرق بين الصوم والفطر ميزةٌ","سوى طُرَفٍ مِمَّا حَوَتْهُ المَوائدُ",101,"د",1,0],["فَلا في الحَربِ نُدرِكُ ما عَلَينا","ولا في السِّلمِ نَعقِلُ ما يَدُورُ",102,"ر",1,0],["فلا فيروسُ في كرٍّ سيبقَى","إذا صُبَّ الحِمامُ من الزُّحوف",103,"ف",1,0],["فلا فائت من هنا كي أعيش","عليه ولا قادم يقتبل",104,"ل",1,0],["(فلا فيه من نثر الكلام طلاوةٌ)","ولا نغمة الوزن الخليلي تبتهل",105,"ل",1,0],["فلا فرق والعيش في شكله","مزيج من البدو والحظر",106,"ر",1,0],["فلا فيكم رؤًى ليَسُودَ فأل","ولاحلم ٌبكم دفعَ الرَّزَايا",107,"ا",3,0],["فلا فرات َ لنا لا نخل َ لا وطنا ً","نفنى وفي أرضنا يستعمر ُ النّذل",108,"ل",1,0],["فلا فرق بين الأتباع لديكمو","ولا بين ما أوجبتموه تحكما",109,"م",2,0],["فلا فقنا على خطر وشيكٍ","ولا جُبِر التمزّقُ باجتماع",110,"ع",1,0],["فلا في عَيْنِ جالوتَ انْتُهِكْنا","ولا في بَدْرَ نُكِّسَتِ البَيارِقْ",111,"ق",1,0],["فلا فوز إلا في المفاوز نحوكم","ولا شوق إلا والردى دونكم جار",112,"ر",1,0],["فلا فَرِحًا إِنْ كنتُ يومًا iiبِغِبْطَةٍ","ولا جَزِعًا مِمَّا أَصَابَ iiفَأَوْجَعَا",113,"ع",2,0],["فَلا فِيها سِنادُ وَلَيْسَ فِيها","مِنَ التَّضْمِينِ ما يَطَأُ العُيُوبا",114,"ب",2,0],["فَلا فَخْرَ إِلاّ أَنْتَ لابِسُ بُرْدِهِ","وَلا حَمْدَ إِلاّ أَنْتَ فِي النَّاسِ كاسِبُهْ",115,"ب",2,0],["فلا( فرعون) صانع ما صنعتم","ولا من كان يقطع في الرقاب",116,"ب",1,0],["فلا فخرٌ لنا نرْنُو إليهِ","ولا عدنٌ تلوح ولا جنانُ",117,"ن",1,0],["فلا فرج يكون بغير زلفى","ولا وجد يمور ولا حنينُ",118,"ن",1,0],["فَلا فَضلٌٌٌ تَأصَّلَ عِندَ قَومٍ","ولا زَمَنُ الأَصالَةِ نَحنُ نأوْيْ",119,"و",2,0],["فلا فاقتْ بلادُ السّنْدِ حُسْناً","ولا بجمالها فاقَتْكِ هِنْد",120,"د",1,0]]}