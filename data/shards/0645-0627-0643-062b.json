{"poems":[[49,"غيري يغيره الفعال الجافي","https://www.aldiwan.net/poem25226.html","الكامل"],[23,"ما كثرت بنو أسد فتخشى","https://www.aldiwan.net/poem21363.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[509,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126667","الخفيف"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126223","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216573","البسيط"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199652","الرجز"],[4984,"عاشق أنت..","https://www.poetsgate.com/ViewPoem.aspx?id=175559",""],[5431,"لليمن الحبيب /لزوم مالا يلزم","https://www.poetsgate.com/ViewPoem.aspx?id=196908",""],[5431,"سهل حوران متعبٌ وجريحُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=198437",""],[402,"بسم الثغر في محيا الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=35363",""],[5976,"القصايد بناتي","https://www.poetsgate.com/ViewPoem.aspx?id=30295",""]],"verses":[["ماكَثرَةُ الخَيلِ الجِيادِ بِزائِدي","شَرَفاً وَلا عَدَدُ السَوامِ الضافي",0,"ف",2,0],["ما كَثُرَت بَنو أَسَدٍ فَتُخشى","لِكَثرَتِها وَلا طابَ القَليلُ",1,"ل",1,1],["مَا كَثِيرُ الإِحسانِ إِلاَّ قَلِيلٌ","فِي تَفَادِي الأَذَى وَرَدِّ نَآدِ",2,"د",1,0],["ما كثر الرقباء إلا لطفه","ما لي مسى غير حسن خصاله",3,"ل",2,0],["ما كثرة الكلام والمقالة","بعثرة خفيفة مقالة",4,"ه",1,0],["ماكثٌ في التراب والأحجار","أبلت الأرض لحمه وعظامه",5,"ه",1,0],["ماكِثٌ فى وَصفِ ذُلِّ بعد أن","كانَ فى إظهارِ أوصَافٍ عِظَام",6,"م",1,0],["ما كثرة المثبتين الأمر تثبته","ولا بقلتهم للحق إيهان",7,"ن",1,0],["ما كثرت من صيفها والمربع","تصغي إلى الحادي كأنها تعي",8,"ع",2,0],["ماكث الرحلة موصول المدى","بقديم قادم من دون قاف",9,"ف",1,0],["ماكثٌ في براثن الجوع دهرا","منهكٌ من تكالب الأوباء",10,"ب",3,0],["ماكثٌ في براثن الذعر نادى","أين ربعي أين الغدُ المذبوحُ ؟",11,"ح",1,0],["ما كثير الإحسان إلا قليل","في تفادي الأذى ورد نآدا",12,"د",2,0],["ماكْثر بنات الفكْر والوصف اخبره","كل العذارى غارن مْن اغنياتي",13,"ت",2,0]]}