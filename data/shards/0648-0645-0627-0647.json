3,"","https://poetry.dctabudhabi.ae/diwan/poem/10702","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9985","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9980","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20983","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42682","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42607","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42604","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54971","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54584","البسيط"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/852","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43768","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/2612","المتقارب"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/200108","الطويل"],[95,"جبل","https://www.poetsgate.com/ViewPoem.aspx?id=716",""],[106,"غرام يزيد","https://www.poetsgate.com/ViewPoem.aspx?id=179758",""],[77,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[77,"وفعلك للصنع الجميل محالف","https://www.poetsgate.com/ViewPoem.aspx?id=34137",""],[90,"إلى الرّصافي","https://www.poetsgate.com/ViewPoem.aspx?id=179197",""],[90,"الأصيل في لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179198",""],[90,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[90,"لم تُنْصفوا اصوت من النجف","https://www.poetsgate.com/ViewPoem.aspx?id=178980",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"سبيل الجَماهير","https://www.poetsgate.com/ViewPoem.aspx?id=178923",""],[45,"عَزَمْتُ عَلى المَنَازِلِ أنْ تَبينَا","https://www.poetsgate.com/ViewPoem.aspx?id=31886",""],[80,"أغُمْرَ الهوى كم ذا تُقَطّعُني عَذْلا","https://www.poetsgate.com/ViewPoem.aspx?id=3585",""],[91,"كتابي","https://www.poetsgate.com/ViewPoem.aspx?id=53230",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[20,"أرِقت لمكفهِر بات فيه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69759&r=&rc=0",""],[88,"اذا شئت ان تسرى بكافرة الصوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19534&r=&rc=37",""],[87,"لعزة ِ هذي اللاهياتِ النواعمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23774&r=&rc=36",""],[3,"قفا يا خليليَّ الغداة َ وسلما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10758&r=&rc=112",""],[96,"الوحي الخالد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66324&r=&rc=3",""]],"verses":[["وَما هَمَّ إِلّا قَعقَعَ البَيضَ بِالظُبى","وَرَدُّ القَنا يَجري عَلى كُلِّ مِعصَمِ",0,"م",1,0],["وَما هَولُ الفُؤادِ مِنَ التَصافي","بَعيدٌ مِن فُؤادٍ فيهِ خالي",1,"ي",1,0],["وَما هَذِهِ الأَيّامُ إِلّا فَوارِسٌ","تُطارِدُنا وَالنائِباتُ خُيولُ",2,"ل",1,0],["وَما هِيَ إِلّا ساعَةٌ وَهوَ لاحِقٌ","بِعادٍ إِلى يَومِ المَعادِ وَتُبَّعِ",3,"ع",1,0],["وَما هِمَّتي إِلّا المَعالي وَإِنَّني","عَلى المَرءِ بِالعَلياءِ لا المالِ نافِسُ",4,"س",1,0],["وَما هُوَ إِلّا شِهابُ الظَلا","مِ صافَحَ لَحظي بِحُسنِ الرُوا",5,"ا",1,0],["وَما هَذِهِ الأَعيادُ إِلّا كَواكِبٌ","تَغورُ وَتولينا قَليلَ ثَواءِ",6,"ا",2,0],["وما هذه الأيّامُ إلّا مصائدٌ","وأشراكُ مكروهٍ لنا وغُرورُ",7,"ر",1,0],["وما هَزّهُ تِيهُ الإمارَةِ والذي","يُصادِفُها في ثِنْيِ عِطْفَيْهِ يَنْظُرُ",8,"ر",1,0],["وما هُوَ إلا اللّيْثُ يَرْتادُ مَطْمَعاً","على غِرّةٍ أو لا فمَنْ نَفَضَ الغَضى",9,"ض",2,0],["وما هي إلا شِيمَةٌ عربيّةٌ","تَنَقَّلُ من أيْمانِنا في القَواضِبِ",10,"ب",1,0],["وَما هَذِهِ الدُنيا لَنا بِمُطيعَةٍ","وَلَيسَ لِخَلقٍ مِن مُداراتِها بُدُّ",11,"د",1,0],["وَما هالَني يا عَبلَ فيكِ مَهالِكٌ","وَلا راعَني هَولُ الكَمِيِّ المُمارِسِ",12,"س",1,0],["وَما هَزَّ قَومٌ رايَةً لِلِقائِن","مِنَ الناسِ إِلّا دارُهُم مُلِئَت دَما",13,"م",2,0],["وَما هُوَ إِلّا ما تَرَينَ وَذو الهَوى","يُعالِجُ ثِقلاً فَاِصبِري أَو تَقَطَّعي",14,"ي",1,0],["وَما هَذا بِأَعجَبَ مِن خُروجي","وَتَركي بَلدَةً فيها الحَبيبُ",15,"ب",1,0],["وَما هَجَروكَ مِن ذَنبٍ إِلَّيهِم","وَلَكِن قَلَّ في الناسِ الوَفاءُ",16,"ا",2,1],["وَما هُوَ إِلّا أَن أَراها فُجاءَةً","فَأَبهَتُ حَتّى ما أَكادُ أُجيبُ",17,"ب",1,1],["وَماهِيَ إِلّا جِيَفَةٌ مُستَحيلَةٌ","عَلَيها كِلابٌ هَمُّهُنَّ اِجتِذابُها",18,"ب",3,0],["وَمَا هَاجَنِي بِالْغَورِ قَدٌّ مُرَنَّحٌ","وَلاَ شَاقَنِي مِنْ وَحْشِ وَجْرَةَ رِيمُهُ",19,"م",2,0],["وَمَا هُنَّ فِي الَّتحْقِيقِ إِلاَّ صَفَاتُهُ","بِهِنَّ إِلَى إِطْرَائِهِ اسْتَطْرَدَ النَّظْمُ",20,"م",1,0],["وَمَا هِيَ فِي التَّحْقِيقِ إِلاَّ مَوَاهِبٌ","مِنَ اللهِ قَبْلَ الْكَوْنِ عَيَّنهَا الْقَسْمُ",20,"م",1,0],["وما هي إلا زَفْرَةٌ هاجَها الجَوى","وأبْدى بِها تذْكارَ يثْرِبَ ما أبْدى",21,"د",2,0],["وما هوَ إلا الشّوْقُ ثارَ كَمينُهُ","فأذْهَلَ نَفْساً لمْ تبِنْ عنْدَهُ قَصْدا",22,"د",2,0],["وما هيَ إلا أنْفُسٌ مُسْتَعارةٌ","ولابدّ يوْماً للعَواريِّ منْ رَدِّ",23,"د",1,0],["وما هوَ إلا رائِدٌ لبَشائرٍ","فلازالَ يَحْدوها إليْكَ ويَقْتادُ",24,"د",1,0],["وما هيَ إلا نَسْمَةٌ حاجِريّةٌ","رَمى الشّوْقُ منْها كلَّ قَلْبٍ بِجارِحِ",25,"ح",1,0],["وَمَا هَاجَنِي إِلاَّ تَأَلُّقُ بَارِقٍ","يَلُوحُ بِفَوْدِ اللَّيْلِ مِنْهُ مَشِيبُ",26,"ب",1,0],["وَمَا هُوَ إلاَّ قَائِمٌ فَوْقَ رَأَسِه","يُوَفَّى لَهُ مِنْ مَنْصِبِ الْمُلْكِ وَاجِبُهْ",27,"ه",1,0],["وَمَا هُوَ إِلاَّ مِنْ عُفَاتِكَ قَدْ أَتَى","تُرَغِّبُهُ فِيمَا لَدَيْكَ الَّرغَائِبُ",28,"ب",1,0],["وَمَا هِيَ إلاَّ دَعْوَةٌ يُوسُفِيَّةٌ","أَثَارَتْ قَبْولَ اللهِ ضَرْبَةَ لاَزِبِ",29,"ب",1,0],["وَما هالَكُنَّ الرُمحُ وَالسَيفُ مُصلَتاً","وَلا المِدفَعُ الرَشّاشُ في الطُرُقاتِ",30,"ت",1,0],["وَما هَدَمَ التَجريبُ رَأياً بَنَيتَهُ","وَلا زالَتِ الآراءُ تُبنى وَتُهدَمُ",31,"م",1,0],["وَما هَجَوتُ اِبنَ عَصرونٍ أَرومُ لَهُ","فَضلاً وَلا نلتُ مِن فَخرٍ وَلا شَرَفِ",32,"ف",1,1],["وَما هاجَهُ مِن مَنزِلٍ لَعِبَت بِهِ","لِعَوجاء مِرقالِ العَشِيِّ ذُيولُ",33,"ل",1,0],["وَما هَبَّتِ الأَرواحُ تَجري وَما ثَوى","مُقيماً بِنَجدٍ عَوفُها وَتِعارُها",34,"ر",3,0],["وَمَا هَمُّهُ غَيْرُ إِسْعَادِ مَنْ","يَسُوسُ وَإِصْلاحِ دُنْيَا وَدِينْ",35,"ن",1,0],["وَمَا هَمُّهُ إِنْ لَمْ يُوَّفُوهُ حَقَّهُ","إِذَا رُدَّ حَقُّ القَوْمِ وَالبَغْيُ خَزْيَانُ",36,"ن",1,0],["وَما هِيَ إِلّا دَولَةٌ بَعدَ دَولَةٍ","تُخَوِّلُ ذا بَغيٍ وَتُعقِبُ ذا بَلوى",37,"ا",1,0],["وما هو إلا طيرُ سعد بذروةٍ","غدا زاجراً من أشهب الصبح بازيا",38,"ي",2,0],["وما هو إلاّ السعدُ إنْ رُمْتَ مطلعاً","وسدَّدْت سهماً كان ربُّك راميا",39,"ي",2,0],["وما هو إلا مورد لسعادة","تفيض لها منه المنى والفواضلُ",40,"ل",1,0],["وما هو إلا قائم مدَّ فلكه","إلى الله في البقيا لما صَدَّ سائلُ",40,"ل",1,0],["وما هو غلا ذكرُ أوصافِك العلا","فتفعل يا مولايَ والعبدُ قائلُ",40,"ل",1,0],["وما هي إِلاْ أعين قد تسهَّدت","فكحَّلها نجم الظلام بإِثمِدِ",41,"د",1,0],["وما هذا لعمر الحق منكم","ببدع بل لكم فيه استقامه",42,"ه",1,0],["وما هذا التموّج من هواءٍ","ولكن من هوىً فهو الوجيب",43,"ب",1,0],["وما هي إلاّ ضجّة كل صائت","بها مدّ للدنيا حبالة صائد",44,"د",1,0],["وما هي إلاّ غيرة وطنيّة","فإن تجدوا منها فلست بواجد",44,"د",1,0],["وما هي إلاّ عارض من تناكر","به مربَع الآمال أقفر واقَورّا",45,"ر",2,0],["وما هذي الحياة سوى صراعٍ","يتم بفوز مفتول الذراع",46,"ع",1,0],["وما هاج العواطف في فؤادٍ","كحال الطفل في زمن الرَضاع",46,"ع",1,0],["وما هي إلا روضةٌ أنبتت له","أزاهير من تلك الحسان الغرائر",47,"ر",1,0],["وما هذا وأن آذى بدائي","ولا هو أمره أمرٌ عَصيب",48,"ب",1,0],["وما هو إلاّ كوكب في سمائهم","به يهتدي الساري إلى المجد منهم",49,"م",1,0],["وما هذه الأوطان إلاّ حدائق","بها تُنبت الأفكار من أهلها زهرا",50,"ر",2,0],["وما هم بالبكاء جزوَك شيئاً","ولكن الإله هو المجازي",51,"ي",1,0],["وما هو إلا السيف قد كان مصلتاً","على الدهر وهو اليوم قد قرّ في الغمد",52,"د",1,0],["وما هبطت من الخضراء لكن","من الغبراء أنبتها الحكيم",53,"م",1,0],["وَما هَجَمَ الأَقيانُ بَيتاً بِبَيتِهِم","وَلا القَينُ عَن دارِ المَذَلَّةِ ناقِلُه",54,"ل",2,0],["وَما هَذِهِ الأَيّامُ إِلّا صَحائِفٌ","لِأَحرُفِها مِن كَفِّ كاتِبِها بَشرُ",55,"ر",1,0],["وَما هَذِهِ أَدمُعي","وَلا ذا الَّذي أُضمِرُ",56,"ر",1,0],["وَما هِيَ إِلّا نَظرَةٌ ما اِحتَسَبتُها","بِعَدّانَ صارَت بي إِلَيها المَصايِرُ",57,"ر",1,0],["وَما هُوَ إِلّا أَن جَرَت بِفِراقِنا","يَدُ الدَهرِ حَتّى قيلَ مَن هُوَ حارِثُ",58,"ث",1,1],["وما هذهِ الأيَّامُ إلا ركائبٌ","إلى الموتِ في نهجٍ من العمرِ مركوب",59,"ب",1,0],["وما هذه الأيامُ إلاَّ مراحلٌ","وأجْدِرْ بها تقضي قريباً وتقضب",60,"ب",1,0],["وما هو ممن لا أنقح مدحه","فآتي إليه بالمديح مرَوَّجا",61,"ج",2,0],["وما هو إلاَّ بيتُ ملكٍ منظمٍ","فمن أجلِ ذا أيامه تستعيدُه",62,"د",2,0],["وما هيَ إلاَّ مدَّةٌ وقد ارْتوى","رجائِي فأضحى وهو فينان أخضر",63,"ر",1,0],["وما هي إلاَّ جنَّةٌ بدليلِ ما","وصفت وقلبي عاشق قبل أن يرى",64,"ر",2,0],["وما هيَ إلاَّ روعةٌ من رزيةٍ","ولكنْ لها ثبت العزائم أروع",65,"ع",1,0],["وما هي إلا مهجة ذاب شطرها","فسالت بها من فوق خدي أدمع",66,"ع",1,0],["وما هي إلا بيت مالٍ لطالب","ونصرة آمال ونجح طريق",67,"ق",1,0],["وما هي إلا القضب إمَّا موائساً","وإمَّا مواضي الحدّ تحمي حمى الملك",68,"ك",1,0],["وما هو إلاَّ حينَ بادر جيشهم","فقاموا صفوفاً للدعا وتبتَّلوا",69,"ل",3,0],["وما هي إلا همة لك أنفذت","وصاة رسول الله عند بلاله",70,"ل",2,0],["وما هي إلا غابُ مجدٍ توطنت","مساكنه أشبالكم والضراغم",71,"م",1,0],["وما هوَ إلاَّ النجم جاورته فلا","مخافة من كلِّ العداة وكلمها",72,"م",3,0],["وما هيَ إلاَّ همَّةٌ تغلبيَّةٌ","تروم من العلياء كلّ مرام",73,"م",1,0],["وما هي إلا طلعة قرشية","سيشتد من أخبارها كلّ مسلم",74,"م",1,0],["وما هي إلاَّ همَّةٌ ملكيَّةٌ","انْقضى عزمها فرض العلى وتنفَّلا",75,"ل",2,0],["وما هذا المطال وليس عهدي","بنفسك من قرائنك الصعابِ",76,"ب",1,0],["وما هو إلا واقع العَتْبِ منكما","وهل مثلُه حَبْسٌ وهل مثله جَلدُ",77,"د",1,0],["وما هذه الدنيا بدار إقامةٍ","ولكنما الدنيا مجازٌ وَمَعْبر",78,"ر",1,0],["وما هي عن لوم له بمُفيقةٍ","إلى أن تراه حيث يُسدي ويُشكَر",79,"ر",1,0],["وما هذه مني وعيداً بجهلةٍ","ولكنها الإخبارُ عن عزمةٍ بتلِ",80,"ل",1,0],["وَما هاجَها لِلوِردِ حَتّى تَرَكَّزَت","رِياحُ السَفا في صَحصَحٍ وَمِتانِ",81,"ن",1,0],["وَما هِيَ قَهوَةٌ تُطهى وَتُحسى","وَلَكِن نَفحَةٌ مِن روحِ حُرِّ",82,"ر",1,0],["وَما هَمَسَتهُ الريحُ في أُذُنِ الثَرى","وَما ذَرَفَت في اللَيلِ نَجمَتُهُ الثَكلى",83,"ل",2,0],["وَما هَوَيتُ مِنَ الأَزهارِ قُلتُ لَهُم","الحُبُّ عِندي لِناميها وَذاويها",84,"ي",3,0],["وَما هاجَ ذاكَ البَحرُ لَمّا سَرى بِهِ","وَلَكِن غَدا مِن خَوفِهِ وَهوَ حَيرانُ",85,"ن",1,0],["وَما هُنتُ إِلّا لِلصَبابَةِ وَالهَوى","وَما خِفتُ إِلّا سَطوَةَ الهَجرِ وَالقِلى",86,"ل",2,0],["وَما هِيَ إِلّا غَيبَةٌ ثُمَّ نَلتَقي","وَيَذهَبُ هَذا كُلُّهُ وَيَزولُ",87,"ل",1,0],["وما هو إلاَّ كَخَفْقِ الجناحِ","حتَّى نما شوقُها وانتصَرْ",88,"ر",1,0],["وَما هَزَّني إِلّا رَسولُكَ إِذ جَرَت","إِلَيَّ بِهِ صُمُّ الهِضابِ رِكابُ",89,"ب",1,0],["وما هي إلا رقدة الموت إنها","تطول فما منها انتباه لراقد",90,"د",1,0],["وما هي لو تعي إلا شموساً","بها ليدَى منوِّرها اعتناءُ",91,"ا",2,0],["وما هو إلا العين بالعين تلتقى","وإن نوّعوا اسبابه والدواعيا",92,"ي",2,0],["وما هو إلا انقباض اليدين","رجاء الصيان وخوف التلف",93,"ف",1,0],["وَما هُوَ مَيتٌ وَلَكِنَّهُ","بَشاشَةُ دَهرٍ مَحاها الزَمَن",94,"ن",1,0],["وَما هُوَ إِلّا جَمالُ العُقولِ","إِذا هِيَ أَولَتهُ إِجمالَها",95,"ل",3,0],["وَما هُوَ ماءٌ وَلَكِنَّهُ","وَريدُ الحَياةِ وَشِريانُها",96,"ن",3,0],["وَما هِيَ إِلّا دَعوَةٌ وَإِجابَةٌ","أَنِ اِلتَحَمَت وَالحَربُ بَكرٌ وَتَغلِبُ",97,"ب",1,0],["وما هي أَهْلٌ إِذْ أَصَابَتْكَ بالبِلَى","لسُقْيا ولكنْ مَنْ حَوَى ذلكَ القَبْرُ",98,"ر",1,0],["وَما هيَ إلاّ خَطْرَةٌ عَرَضَتْ لَهُ","بحَرّانَ لَبّتْهَا قَناً وَنُصُولُ",99,"ل",1,0],["وَما هِيَ إِلّا لَحظَةٌ بَعدَ لَحظَةٍ","إِذا نَزَلَت في قَلبِهِ رَحَلَ العَقلُ",100,"ل",1,0],["وما هو إِلّا هفوة إِثر نبوة","ألومُ عليها تارةً وأُلامُ",101,"م",1,0],["وما هو إِلّا مثلُ قاطعِ كِفِّهِ","بكفٍّ لهُ أخرَى فأصبحَ أقطعَا",102,"ع",2,0],["وَما هُوَ إِلّا دُرَّةٌ لَم أَجِد لَها","سِوى جودِكَ الأَمسِيَّ إِذ بَرَزَت بَحرا",103,"ر",2,0],["وَما هُوَ إِلّا يوسُفُ بنُ مُحَمَّدٍ","وَأَعداؤُهُ وَالمَوتُ غَرباً وَمَشرِقا",104,"ق",2,0],["وَما هَذهِ الأَيّامُ إِلّا مَنازِلٌ","فَمِن مَنزِلٍ رَحبٍ وَمِن مَنزِلٍ ضَنكِ",105,"ك",1,0],["وَما هَلَّلَ اللَهَ يَنجو بِها","وَلَكِنَّ مِن حُبِّ لا هَلَّلا",106,"ل",2,0],["وَما هَذِهِ الأَخلاقُ إِلّا مَواهِبٌ","وَإِلّا حُظوظٌ في الرِجالِ تُقَسَّمُ",107,"م",1,0],["وَما هَزَّهُ إِلّا تَقَرَّرَ عِندَهُ","قَرارَ اليَقينِ أَيُّ سَيفَيهِ أَصرَمُ",107,"م",1,0],["وَما هُوَ كائِنٌ وَإِنِ اِستَطَلنا","إِلَيهِ النَهجَ يوشِكُ أَن يَكونا",108,"ن",2,0],["وَما هُوَ غَيرُ خَوضِ الشَكِّ يوما","إِلَيهِ حَيثُ لا تَجِدُ اليَقينا",108,"ن",2,0],["وَما هُوَ مِنها غَيرَ أَنَّ نِباحَهُ","لِيونِعَ في أَلبانِها حينَ يُصبِحُ",109,"ح",1,0],["ومأهولةٍ من تَماثِيلِها","إذا هي يوماً غدَت خَاليه",110,"ي",2,0],["وَما هُوَ إِلّا يَومُ بُؤسٍ وَشِدَّةٍ","وَيَومُ سُرورٍ مَرَّةً وَرَخاءِ",111,"ا",2,0],["وَما هِيَ إِلّا أَوبَةٌ بَعدَ غَيبَةٍ","إِلى الغَيبَةِ القُصوى فَثَمَّ قِيامَتي",112,"ي",1,0],["وَما هِيَ إِلّا رَقدَةٌ غَيرَ أَنَّها","تَطولُ عَلى مَن كانَ فيها إِلى الحَشرِ",113,"ر",1,0],["وَماهِيَ إِلّا تَرحَةٌ بَعدَ فَرحَةٍ","كَذالِكَ شُربُ الدَهرِ يَصفو وَيَكدُرُ",114,"ر",1,0],["وَما هُوَ إِلّا النَعشُ لَو قَد دَعَوا بِهِ","تُقَلُّ فَتُلقى فَوقَهُ ثُمَّ تُرفَعُ",115,"ع",1,0],["وَما هُوَ إِلّا حادِثٌ بَعدَ حادِثٍ","عَلَيكَ فَمِن أَيِّ الحَوادِثِ تَجزَعُ",115,"ع",1,0],["وَما هُوَ إِلّا المَوتُ يَأتي لِوَقتِهِ","فَما لَكَ في تَأخيرِهِ عَنكَ مَدفَعُ",115,"ع",1,0],["وما هي إلا لحظة وتغازلا","وقد رفعا بعد السلام التكلفا",116,"ف",2,0],["وما هيَ إلا النفسُ تفني حياتَهَا","مُصَرَّفةً في كلّ سعيٍ مُقَدَّرِ",117,"ر",1,0],["وما هيَ إلا لفحةٌ من هواجرٍ","تخلّصْتُ منها كالنّضار المسجَّرِ",117,"ر",1,0],["وما هي إلا غربةٌ مُسْتمرّةٌ","أرى الشيخَ فيها بَعْدَ سِنّ غلامِ",118,"م",1,0],["وما هي إلّا مشرَعاتٌ أسنّةٌ","عِطاشٌ تُرَوّى في حياضِ المقاتِلِ",119,"ل",1,0],["وما هيَ إِلّا خطةُ الملِكِ الّذي","يَحُطُّ لَدَيهِ كلُّ ذي أملٍ رَحْلا",120,"ل",2,0],["وما هوَ إلا دمْعُ عينٍ كأنّها","لطولِ بكاءٍ دهرَهَا لا تُغمِّضُ",121,"ض",1,0],["وَما هُوَ إلّا حازِمٌ ذو كِفايَةٍ","يُناقِضُ هَزْلَ الرَّوْعِ من بَأسِهِ الجِدُّ",122,"د",1,0],["وَما هُوَ إِلّا القَولُ يَسري فَتَغتَدي","لَهُ غُرَرٌ في أَوجُهٍ وَمَواسِمُ",123,"م",1,0],["وَما هُوَ إِلّا الوَحيُ أَو حَدُّ مُرهَفٍ","تُميلُ ظُباهُ أَخدَعَي كُلِّ مائِلِ",124,"ل",1,0],["وَمَا هُوَ إِلَّا جَوْهَرُ الْفَضْلِ وَالنُّهَى","يُسَرَّدُ فِي سِلْكِ الْمَقَالِ وَيُنْظَمُ",125,"م",1,0],["وَمَا هَاجَنِي إِلَّا عُصَيْفِيرُ رَوْضَةٍ","عَلَى مَلْعَبٍ مِنْ دَوْحَةِ الضَّالِ نَاعِمِ",126,"م",1,0],["وَمَا هُوَ إِلَّا عِقْدُ مَدْحٍ نَظَمْتُهُ","لِجِيدِ عُلاهُ فِي صُدُورِ الْمَوَاسِمِ",126,"م",1,0],["وَما هاجَني إِلّا تَأَلُّقُ بارِقٍ","لَبِستُ بِهِ بُردَ الدُجُنَّةِ مُعلَما",127,"م",2,0],["وَما هَزَّ أَعطافَ الكَريمِ إِلى العُلى","كَأَروَعَ شَيحانٍ يَهُزُّ العَوالِيا",128,"ي",2,0],["وَماهِيَ إِلّا حَسرَةٌ بَعدَ نَظرَةٍ","أَثارَت لَهيباً في الحَشاشَةِ يُضرَمُ",129,"م",1,0],["وَما هَجَرَتكِ النَفسُ أَنَّكِ عِندَها","قَليلٌ وَلَكِن قَلَّ مِنكِ نَصيبُها",130,"ب",3,0],["وَما هَذَّبَت مِن نُفوسِ الكِرامِ","وَما ثَقَّفتَ مِن عُقولِ الهُداةِ",131,"ه",1,0],["وَما هِيَ إِلّا غَضبَةٌ فَاِنطِلاقَةٌ","فَوَثبَةُ ضارٍ تَتَّقيهِ الضَياغِمُ",132,"م",1,0],["وَما هِيَ إلّا حِسانُ الفِعالِ","تُفيدُ البِلادَ وَتُجدي العِبادا",133,"د",2,0],["وَما هوَ إِلّا أَن يَثورَ غُبارُها","فَلا أُفْقَ إِلّا وهوَ أَقتمُ مُسوَدُّ",134,"د",1,0],["وَما هَيَّمَ النَهدِيُّ إِذ طالَ سُقمُهُ","بِهِندِ المَطالي ساعَةً لا أَهيمُها",135,"م",3,0],["وَما هِيَ إِلّا لَيلَةٌ طابَ نَجمُها","أُواقِعُ فيها الذَنبَ ثُمَّ أَتوبُ",136,"ب",1,0],["وَما هِيَ إلا عينُ نَارِ جَهنَّمٍ","تَرَدَّدَ مِنْ أَنفاسِها الحرُّ وَالبَرْدُ",137,"د",1,0],["وَما هَمَمْتَ بِأَمْرٍ غير مَطْلَبِهِ","إِلّا تَيَسَّرَ مِنْ أسبابهِ العَسِرُ",138,"ر",1,0],["وَما هُوَ إِلَّا كِيمياءُ سعادةٍ","وَوَصْفِي لتلكَ الكِيمياء شُذُورُ",139,"ر",1,0],["وما هو إلا شقَّةٌ منكَ إن شكا","شكوتَ على هذا جرى القدرُ الحتمُ",140,"م",1,0],["وما هد أرض الروم منه وقلقلت","بنا ملكهم من خوفه والدعائم",141,"م",1,0],["وما هي إلاّ آيةٌ بعْد آيةٍ","ونُذْرٌ لكم إن كان يغنيكم النُّذر",142,"ر",1,0],["وما هو إلاّ أن يشيرَ بلَحْظِهِ","فتَمخُر فُلكٌ أو تُغِذّ مقانيب",143,"ب",1,0],["وماهِها الكامكارِ","والمهرجان المدارِ",144,"ر",1,0],["وَما هِيَ إِلّا النارُ توقَدُ مَرَّةً","فَتَذكو وَتاراتٍ يَحينُ خُبوتُها",145,"ت",3,0],["وَما هَذِهِ الدُنيا بِأَهلِ وَديعَةٍ","فَلا تَأتَمِنها قَد عَرَفتَ أَمارَها",146,"ر",3,0],["وَما هَذِهِ الساعاتُ إِلّا أَراقِمٌ","وَما شَجُعَت في لَمسِهِنَّ الأَشاجِعُ",147,"ع",1,0],["وَما هِيَ أَهلٌ أَن يُؤَهَّلَ مِثلُها","لِوُدٍّ وَلَكِن اِبنَ آدَمَ أَحمَقُ",148,"ق",1,0],["وَما هَبَّ مِن نَومِ الصِبا يَطلُبُ النُهى","مَعَ الفَجرِ إِلّا وَهِيَ في كَفِّ شارِقِ",149,"ق",1,0],["وَما هِيَ إِلّا قِسمَةٌ بَينَ أَهلِها","لِكُلَّهُمُ فيها نَصيبُ مُشارِكِ",150,"ك",1,0],["وَما هِيَ إِلّا مَنزِلٌ غَيرُ طائِلٍ","فَمُرتَحِلٌ عَنهُ وَآخَرُ قادِمُ",151,"م",1,0],["وَما هاجَ ذِكري بارِقٌ نَحوَ بارِقٍ","وَلا هَزَّني شَوقٌ لِجارَةِ هَزّانِ",152,"ن",1,0],["وَما هِيَ إِلّا شاكَةٌ لَيسَ عِندَها","وَجَدِّك إِرطابٌ لِمُختَرِفيها",153,"ي",3,0],["وما هي حالة الشهداء فيها","أَأَيقاظٌ هنالك أم رقود",154,"د",1,0],["وَما هو إلا بعض ما أَنا واجد","وإلا شعور النفس مني والخلق",155,"ق",1,0],["وَما هوَ كنه الأثير الَّذي","فَسيح الفَضاء به مفعمُ",156,"م",1,0],["وَما هي إِلّا دولة همجية","تسوس بما يقضي هواها وتعمل",157,"ل",1,0],["وَما هي إلا رجفة تعتري الفتى","مفاجأةً وَالرأس منه يميل",158,"ل",1,0],["وَما هذه في الدهر أَول مَرَّة","رأى الحق فيها الظالِمون فأنكروا",159,"ر",3,0],["وما هو من مستعمرٍ جاءَ بالهوى","ولا هُوَ من مستثمرٍ جاءَ بالمالِ",160,"ل",1,0],["وما هي إلا دموعُ الأسى","همت من جراحاتها النازفَه",161,"ف",2,0],["وما هذه رِعشَةٌ في يَدَيكَ","أم الكأسُ ترجفُ من ذكرِها",162,"ر",3,0],["وما هو أسْطُرٌ كُتِبَتْ ولكنْ","معان في القلوب لهنَّ عَلْبُ",163,"ب",1,0],["وما هي إلَّا منكمو رَجْعُ صيحةٍ","على الأمس كانت كالمزامير تُنْغَمُ",164,"م",1,0],["وما هي إلَّا أمَّةٌ عربيَّةٌ","مُوحَّدَةٌ في فكرةٍ ولسانِ",165,"ن",1,0],["وما هيَ إلَّا الصمت والبرد والدُّجى","ودنيا يَشِيع الموتُ في جنباتِها",166,"ت",3,0],["وما هُوَ إلاّ مَيّتٌ زادَ عُمْرُهُ","على نَسْرِ لُقْمانَ الأخيرِ بأحوال",167,"ل",1,0],["وما هيَ إلاّ رَوْضَةٌ سَدِكٌ بها","ذُبابُ حُسامٍ في السّوابِغِ شاد",168,"د",1,0],["وما هاجَ هَذا الشَّوْقَ إلَّا حَمائِمٌ","بَكَيْتُ لها لمّا سَمِعْتُ بُكَاءَهَا",169,"ا",3,0],["وما هِي إِلا هِمَّةٌ أَْشجعِيَّةٌ","ونَفْسٌ أَبتْ لِي مِن طلابِ الرَّذائِلِ",170,"ل",1,0],["وَما هَجَرَتكِ النَفسُ يا لَيلَ عَن قِلىً","قَلَتكِ وَلَكِن قَلَّ مِنكِ نَصيبُها",171,"ب",3,0],["وَما هَجَرَتكِ النَفسُ يا لَيلَ أَنَّها","قَلَتكِ وَلَكِن قَلَّ مِنكِ نَصيبُها",172,"ب",3,0],["وَما هَدَمَت يَدُ الحِدثانِ رُكني","وَلا اِمتَدَّت إِلَيَّ بَنانُ حَيني",173,"ي",1,0],["وَما هَزَّ قَومٌ رايَةً لِلِقائِنا","مِنَ الناسِ إِلّا دارُهُم مُلِئَت دَما",174,"م",2,0],["وما هَذا بأَوَّلِ ما أُلاَقي","مِنَ الحِدثَانش والعَرَضِ القَرِيبِ",175,"ب",1,0],["وَمَا هَذِهِ الأَجْسَامُ إِلَّا هَيَاكِلٌ","مُصَوَّرَةٌ فِيهَا النُّفُوسُ وَدَائِعُ",176,"ع",1,0],["وَمَا هِيَ إِلَّا غَمْرَةٌ ثُمَّ تَنْجَلِي","غَيَابَتُهَا وَاللَّهُ مَنْ شَاءَ نَاصِرُ",177,"ر",1,0],["وَمَا هُوَ إِلَّا الشِّعْرُ سَارَتْ عِيابُهُ","وَفِي طَيِّهَا مِنْ طِيبِ مَا ضُمِّنَتْ نَشْرُ",178,"ر",1,0],["وَمَا هَذِهِ الأَيَّامُ إِلَّا مَنَازِلٌ","يَحُلُّ بِهَا سَفْرٌ وَيَتْرُكُها سَفْرُ",179,"ر",1,0],["وَمَا هِيَ إِلاَ دُمُوعُ المُنَى","وَمَا هِيَ إِلاَ شُعَاعُ النُّفُوسِ",180,"س",1,0],["وَمَا هُلْكُ أَفْرَادٍ وَمِصرُ عَزِيزَةٌ","أَمَا أَجَُ الإِنْسَانِ مِنْهُ بِقَابِ",181,"ب",1,0],["وَمَا هُدى حِينَ تَجْلُو عَنْ أَشِعَّتِهَا","إِلاَّ مُحَيَّا ذُكَاءٍ غَيْرَ مُنْتَقَبِ",182,"ب",1,0],["وَما هَذِهِ في الحُبِّ أَوَّلَ مَرَّةٍ","أَساءَت إِلى قَلبي الظُنونُ الكَواذِبُ",183,"ب",1,0],["وَما هِيَ غَيرُ أَيّامٍ قِصارٍ","إِذا صَعبت عَلى ذي اللُبِّ راضا",184,"ض",2,0],["وَما هَزَزتَ المُنتَضى","وَلا شَهِدتَ المُعتَرَك",185,"ك",1,0],["وَما هَدَّني حَتّى هَدَت حَرَكاتهُ","وَقامَ عَلَيهِ مأتَمٌ وَعَويلُ",186,"ل",1,0],["وَما هُوَ إِلّا عَلى نَقصِهِ","فَيَوماً يَشِبُّ وَيَوماً يَشيبُ",187,"ب",1,0],["وما هذه البلدان إلا نظائر","وذو الفضل محروم بكل مكان",188,"ن",1,0],["وما هان لي في موقف العز موقف","ولا لان لي في جانب الحق جانب",189,"ب",1,0],["وما هي نظمٌ، ولكنَّها","خرائدُ بذَّت عقودَ الجُمان",190,"ن",1,0],["وما هي إلا زفرة هاجها الهوى","وأبدى بها تذكار يثرب ما أبدا",191,"د",2,0],["وما هذه الأبصار تعمى حقيقة","ولكنها تعمى النهى والبصائر",192,"ر",1,0],["وما هو بالحبلِ الذي رُحتَ مرغِماً","\" أوائلَه \" أنْ تلتقي و\" الأواخرا\"",193,"ر",2,0],["وما هذه الأشباحُ تترى ؟ اغيمةٌ","تولّد أظرفا ، ونابا ، ومخلبا",194,"ب",2,0],["وما هي بالشكوى ولكن أثارة","وقد يُحسَب الليثُ المزمجرُ شاكيا",195,"ي",2,0],["وما هو إن خيرٌ تحداهُ طائشٌ","ولا هو إن خيرٌ تعدّاهُ نادم",196,"م",1,0],["وما هو الا واحد في جميعه","وإن رجم الغاوي وساءت ظنونه",197,"ن",2,0],["وما هو إلاَّ احتمالُ الخُطوبِ","وإلاّ الأذى والعَرا والطَّوى",198,"ا",1,0],["وما هكذا كان الكتابُ منزَّلاً","ولا هكذا قالت شريعةُ لَموعد",199,"د",1,0],["وَما هوَ غَيرُ خوْضِ الشّكّ ترْمي","إلَيهِ، حَيثُ لا تَجِدُ اليَقينَا",200,"ن",2,0],["وما هي إلاَّ حطة ُ الملِكِ الذي","يحطّ لديه كل ذي أملٍ رَحلا",201,"ل",2,0],["وما همسته الريح في أذن الثرى","وما ذرفت في الليل نجمته الشكلى",202,"ل",2,0],["وَمَا هِيَ إِلاَّ دِمْنَةٌ لَكِنِ اكْتَسَى","ثَرَاهَا مِنَ النَّبْتِ المُزَوَّرِ مَلْبَسَا",203,"س",2,0],["وَما هَذا بِأَوِّلِ ما أُلاقي","مِنَ الحِدثانِ وَالعَرَضِ القَريبِ",204,"ب",1,0],["وما هي الا غيرة وطنية","فان تجدوا منها فلست بواحد",205,"د",1,0],["وَمَا هُوَ إِلاَّ عِقْدُ مَدْحِ نَظَمْتُهُ","لجيدِ علاهُ في صدرِ المواسمِ",206,"م",1,0],["وما هزَّ قومٌ راية ً للقائنا","من النَّاسِ إلاّ دراهمْ ملئتْ دما",207,"م",2,0],["وماهي إلاّ الصّمت والبرد والّدجى","ودنيا يشيع الموت من جنباتها",208,"ت",3,0]]}