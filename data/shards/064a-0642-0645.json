{"poems":[[11,"صحا القلب من سلمى وعن أم عامر","https://www.aldiwan.net/poem246.html",""],[31,"صحا القلب إلا من ظعائن فاتني","https://www.aldiwan.net/poem6052.html","الطويل"],[45,"الرأي قبل شجاعة الشجعان","https://www.aldiwan.net/poem10580.html","الكامل"],[42,"ما هاج قلبك يوم العرج من ظعن","https://www.aldiwan.net/poem42333.html","البسيط"],[50,"أنعت كلبا جال في رباطه","https://www.aldiwan.net/poem64372.html","البسيط"],[159,"قفوا ما عليكم من وقوف الركائب","https://www.aldiwan.net/poem55796.html","الطويل"],[463,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120059","المنسرح"],[136,"","https://poetry.dctabudhabi.ae/diwan/poem/118523","الطويل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76610","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102119","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93642","الكامل"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9610","الطويل"],[5616,"تعليق هامشي على هامش أحداث هامشية!","https://www.poetsgate.com/ViewPoem.aspx?id=205035",""]],"verses":[["يُقَمِّصُ دَهداقَ البَضيعِ كَأَنَّهُ","رُؤوسُ القَطا الكُدرِ الدِقاقِ الحَناجِرِ",0,"ر",1,0],["يُقَمِّصُ بِالمَلّاحِ حَتّى يَشُفُّهُ ال","حِذارُ وَإِن كانَ المُشيحُ المُعَوِّدا",1,"د",2,0],["يَقمُصنَ في مِثلِ المُدى مِن بارِدٍ","يَذَرُ الفُحولَ وَهُنَّ كَالخِصيانِ",2,"ن",1,0],["يَقُمنَ إِعظامَها يَنظُرنَ ما أَمَرَت","كَما تَقُومُ نصارى الرُومِ لِلوَثَنِ",3,"ن",1,0],["يُقَمِّمُ القائِدُ في حِطاطِهِ","وَقَدِّهِ البَيداءَ في اِعتِباطِهِ",4,"ط",2,0],["يُقِمْنَ لنا برقَ الثغورِ أَدِلَّةً","إِذا ما ضللنا في ظلامِ الذَوائبِ",5,"ب",1,0],["يقْمَحُ الضيمَ ولو أبصرهُ","ليلة العِشرِ على الماءِ الشَّروبِ",6,"ب",1,0],["يقم لمن خلفه إماما","يقيم فيهم بعده الأحكاما",7,"م",2,0],["يقمر عقلي بكأسها قمر","جعلت روحي لراحه مهرا",8,"ر",2,0],["يُقَمِّصُ بالفُلكِ المَوَاخِرِ مَوجُهُ","ويَقذِفُ بِاليَاقُوتِ والدُّرِّ والشَّذرِ",9,"ر",1,0],["يقمح لي قوم مقامي بينهم","وقد رسفت رجل السرى في الأداهم",10,"م",1,0],["يقُم يشمّر لسباق الجد مجتهداً","ويسر نحو العلا يجري على قدم",11,"م",1,0],["يقمعن رَأس الضد منهُ رَسائل","كَصَواعق الأَزمات وَهِيَ رقاع",12,"ع",1,0],["يُقَمِّصُ بِالبوصيِّ فيهِ غَوارِبٌ","مَتى ما يَخُضها ماهِرُ اللُجِّ يَغرَقِ",13,"ق",1,0],["يُقمَع الرأي، فالحوارُ سياطٌ","وإذا قلت فالقرارُ بعيدُ",14,"د",1,0]]}