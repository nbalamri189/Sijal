{"poems":[[53,"رضيت من الأحباب دون الذي يرضي","https://www.aldiwan.net/poem30167.html","الطويل"],[63,"وعدت والخل موفي له زفرا","https://www.aldiwan.net/poem45718.html","البسيط"],[3,"ضحكت عبيلة إذ رأتني عارياَ","https://www.aldiwan.net/poem170.html",""],[77,"من أنكر غيثا منشؤه","https://www.aldiwan.net/poem35925.html","المتدارك"],[93,"ضحاكة كالنور في الزهر","https://www.aldiwan.net/poem9154.html","أحذ الكامل"],[93,"هذا الرثاء الذي تمليه أشجاني","https://www.aldiwan.net/poem11189.html","البسيط"],[54,"وميثاء خضراء زربية","https://www.aldiwan.net/poem27457.html","المتقارب"],[41,"ضحك الناس وقالوا","https://www.aldiwan.net/poem42351.html","مجزوء الرمل"],[88,"فعدت بقارعة الطريق تنوح","https://www.aldiwan.net/poem43672.html","الكامل"],[88,"نزلت تجر إلى الغروب ذيولا","https://www.aldiwan.net/poem44454.html","الكامل"],[88,"ليس من غاية الحياة البقاء","https://www.aldiwan.net/poem45036.html","الخفيف"],[23,"من سره الموت صرفا لا مزاج له","https://www.aldiwan.net/poem21252.html","البسيط"],[64,"إن الحبيب الذي يرضيه سفك دمي","https://www.aldiwan.net/poem67547.html","البسيط"],[51,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[51,"وسميطة صفراء دينارية","https://www.aldiwan.net/poem62853.html","الكامل"],[51,"بينما أنت في احتيال فياشك","https://www.aldiwan.net/poem65818.html","الخفيف"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[91,"كم قبل هذا الجل ولى جيل","https://www.aldiwan.net/poem9063.html","عموديه"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[91,"صبرا على هجرها إن كان يرضيها","https://www.aldiwan.net/poem62813.html","عموديه"],[92,"أظل الوجود المساء الحزين","https://www.aldiwan.net/poem38904.html","المتقارب"],[92,"ضحكنا على الماضي البعيد وفي غد","https://www.aldiwan.net/poem38963.html","الطويل"],[89,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[89,"آثرت حتفك بعد اليأس تنتحر","https://www.aldiwan.net/poem44896.html","البسيط"],[89,"نطقت حشاشة محسن تتبرم","https://www.aldiwan.net/poem44897.html","الكامل"],[85,"حبذا الساحة والظل الظليل","https://www.aldiwan.net/poem7103.html","الرمل"],[85,"قد ود نوح أن يباسط قومه","https://www.aldiwan.net/poem8023.html","الكامل"],[85,"كان للغربان في العصر مليك","https://www.aldiwan.net/poem8044.html","الرمل"],[85,"شيعت احلامي بقلب باك","https://www.aldiwan.net/poem24531.html","الكامل"],[85,"أيها الكاتب المصور صور","https://www.aldiwan.net/poem63704.html","الخفيف"],[85,"رمضان ولى هاتها يا ساقي","https://www.aldiwan.net/poem63705.html","الكامل"],[85,"هنيئا أمير المؤمنين فإنما","https://www.aldiwan.net/poem63777.html","الطويل"],[45,"يضحكن عن برد ونور أقاح","https://www.aldiwan.net/poem62719.html","الكامل"],[45,"عجبا لطيف خيالك المتعاهد","https://www.aldiwan.net/poem62740.html","الكامل"],[45,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[45,"أفي كل دار منك عين ترقرق","https://www.aldiwan.net/poem65183.html","الطويل"],[45,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[61,"على أبن العصب الملحي","https://www.aldiwan.net/poem51279.html","الهزج"],[61,"قضب الهند والقنا أخدانك","https://www.aldiwan.net/poem51496.html","الخفيف"],[61,"مرحبا بالصبوح في الظلماء","https://www.aldiwan.net/poem51824.html","الخفيف"],[2,"بان الخليط ولم يأووا لمن تركوا","https://www.aldiwan.net/poem25061.html","البسيط"],[66,"ضحكت ثغور حدائق الأرض","https://www.aldiwan.net/poem38487.html","الكامل"],[97,"هذه دارها فلا تدعاني","https://www.aldiwan.net/poem24383.html","الخفيف"],[97,"رأيت غصنا صغيرا","https://www.aldiwan.net/poem24933.html","المجتث"],[97,"ضحكت لعيني المصابيح التي","https://www.aldiwan.net/poem24936.html","الكامل"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[80,"واعمر بقصر الملك ناديك الذي","https://www.aldiwan.net/poem31233.html","الكامل"],[80,"وأشم من بيت الرئاسة أكبر","https://www.aldiwan.net/poem31446.html","الكامل"],[80,"قضت في الصبا النفس أوطارها","https://www.aldiwan.net/poem31465.html","المتقارب"],[80,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[44,"أقرم بكر تباهي أيها الحفض","https://www.aldiwan.net/poem30477.html","البسيط"],[44,"داع دعا بلسان هاد مرشد","https://www.aldiwan.net/poem30532.html","الكامل"],[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[31,"ضحكت أم نوفل إذ رأتني","https://www.aldiwan.net/poem41286.html","الخفيف"],[105,"ركدت وهبت لوعة الحزن تدأب","https://www.aldiwan.net/poem42108.html","الطويل"],[52,"ضحك المشرفات في يوم عيد","https://www.aldiwan.net/poem26613.html","الخفيف"],[52,"راض نفسي حتى ترضيت إبلي","https://www.aldiwan.net/poem26911.html","الخفيف"],[52,"ضحك الورد في قفا المنثور","https://www.aldiwan.net/poem26980.html","الخفيف"],[48,"ضحك الشيب في نواحي الظلام","https://www.aldiwan.net/poem65114.html","الخفيف"],[50,"لا تعد لي كليلة بالجماد","https://www.aldiwan.net/poem63953.html","الخفيف"],[46,"ضحك الدهر في محياك مكر","https://www.aldiwan.net/poem22593.html","الخفيف"],[46,"ثمل الكبير فظل يحسب أنه","https://www.aldiwan.net/poem22805.html","الكامل"],[46,"ضحكنا وكان الضحك منا سفاهة","https://www.aldiwan.net/poem23065.html","الطويل"],[46,"لو كان لي أمر يطاوع لم يشن","https://www.aldiwan.net/poem23315.html","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39589","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39607","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42552","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54815","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141987","الرمل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199501","الوافر"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199488","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43644","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43850","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[106,"الطفل الموءود!","https://www.poetsgate.com/ViewPoem.aspx?id=179638",""],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[54,"وَمَيثاءَ خضراءَ زَرِبيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=14508",""],[45,"اللَّوْمُ مِنْكَ وإِنْ نَصَحْتَ غَرَامُ","https://www.poetsgate.com/ViewPoem.aspx?id=32000",""],[80,"أمسكَ الصبا أهدتْ إلي صبا نجدِ","https://www.poetsgate.com/ViewPoem.aspx?id=3155",""],[51,"ضحك الربيعُ إلى بكى الديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13110&r=&rc=0",""],[87,"هنيئاً لريَّا ما تضمُّ الجوانحَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23815&r=&rc=77",""]],"verses":[["ضَحى اليَومَ عَن ظِلِّ الشَبيبَةِ مَفرِقي","وَأَبدَلَ مُسوَدَّ العِذارِ بِمُبيَضِّ",0,"ض",1,0],["ضَحِكتِ ثُمَّ بَكى الإِبريقُ مُنتَحِباً","فالرِّيقُ وَالثَّغرُ مِثلُ الرَّاحِ وَالحَبَبِ",1,"ب",1,0],["ضَحِكَت عُبَيلَةُ إِذ رَأَتني عارِياَ","خَلَقَ القَميصِ وَساعِدي مَخدوشُ",2,"ش",1,1],["ضحِكَتْ بأبِي العبّاسِ","منَ الأيّامِ ثَنايا زُخْرُفِها",3,"ف",3,0],["ضحَّاكةً كالنور في الزهر","رقاصةً كالغصن في الوادي",4,"ي",1,1],["ضَحَّتْ ظِلالَ الرِّجَالِ الكَاسِبِينَ لَهُمْ","وَخَلَّفَتْ بَعْدَهُمْ أَنْضَاءَ حِرمَانِ",5,"ن",1,0],["ضَحوكاً إِذا لاعَبَتهُ الرِياحُ","تَأَوَّدَ كَالشارِبِ المُرجَحِنّ",6,"ن",1,0],["ضَحِكَ النَّاسُ وقَالُوا","شِعرُ وضَّاحِ اليَماني",7,"ي",1,1],["ضحِيَت وقد قلص الظلال فوجهها","للشمس في وجناته تلويح",8,"ح",1,0],["ضحكت مَشارقها بوجهك بكرةً","وبكت مغاربها الدماء أصيلا",9,"ل",2,0],["ضحكوا منه في الحياة ومذ ما","ت تعالى نحيبهم والبكاء",10,"ا",2,0],["ضَحَّوا بِأَشمَطَ عُنوانُ السُجودِ بِهِ","يُقَطِّعُ اللَيلَ تَسبيحاً وَقُرآنا",11,"ن",2,0],["ضحى الحَبيبُ بِنَفسٍ يَومَ عيدِهِمُ","وَالناسُ ضَحّوا بِمِثلِ الشاءِ وَالنِعَمِ",12,"م",1,0],["ضحك الزمان إليه ضحْكَةَ قائلٍ","يا مرحباً بابن الخليفة مرحبا",13,"ب",2,0],["ضُحُكُ الوجوه من الطبرزَد فوقها","دمع العيون من الدِّهان تُعصّر",14,"ر",1,0],["ضحِكَتْ منك محكماتُ القوافي","حين عارَضْتَ وابلي برشاشِك",15,"ك",1,0],["ضحكَ الربيعُ إلى بكا الدِّيمِ","وغدا يُسَوِّي النبت بالقمَمِ",16,"م",1,1],["ضَحِكَ الشَبابُ مِنَ الكُهولِ فَأَغرَقوا","وَاِستَيقَظوا فَإِذا الشَبابُ كُهولُ",17,"ل",1,0],["ضَحِكَ الشعِرُ مِمّا سَمِعَتهُ أُذُناهُ","وَتَمَنّى أَن يُداجي فَعَصَتهُ شَفَتاهُ",18,"ه",1,0],["ضَحوكَةِ الوَجهِ يُغرينا تَبَسُّمُها","إِن نَجتَديها وَيَثنينا تَثَنّيها",19,"ي",3,0],["ضَحوكٌ وقد بلَّلتهُ الدُّموعُ","طَرُوبٌ وقد ظَلَّلَتْهُ الشُّجُونْ",20,"ن",1,0],["ضحِكْنا على الماضي البعيدِ وفي غدٍ","ستجعَلُنا الأَيَّامُ أُضْحُوكَةَ الآتي",21,"ي",1,1],["ضحكوا غرة فاسبلت دمعا","كنت تبكي به على الضاحكينا",22,"ن",2,0],["ضحيت بالنفس والاقدار واجمة","من هول ما جئته والليل معتكر",23,"ر",1,0],["ضحى الرئيس بنفسه لبلاده","لما رأى ان السياسة تغشم",24,"م",1,0],["ضحى باغلى ما لديه لاجلها","والليل مسدول الذوائب اسحم",24,"م",1,0],["ضحك الأيتام في ليلته","ومشى يستروح البرء العليل",25,"ل",1,0],["ضَحِكَ النَبِيُّ وَقالَ إِنَّ سَفينَتي","لَهِيَ الحَياةُ وَأَنتِ كَالإِنسانِ",26,"ن",1,0],["ضَحكَ السُلطانُ في هَذا المَقال","ثُمَّ أَدنى خادِمَ الخَيرِ وَقال",27,"ل",1,0],["ضحِكَتْ إليَّ وجُوهها وعيونُها","ووجدْتُ فِي أَنفاسها ريّاكِ",28,"ك",1,0],["ضَحِكُ الماءِ وَالأَقاحي عَلَيها","قابَلَتهُ الغُصونُ بِالتَصفيقِ",29,"ق",1,0],["ضَحِكَت إِلَيَّ مِنَ السُرورِ وَلَم تَزَل","بِنتُ الكُرومِ كَريمَةَ الأَعراقِ",30,"ق",1,0],["ضَحِكتَ مِنَ الأَهوالِ ثُمَّ بَكَيتَهُم","بِدَمعٍ جَرَت في إِثرِهِ الرَحَماتُ",31,"ت",1,0],["ضَحوكاً وَأَصنافُ المَنايا عَوابِسٌ","وَقوراً وَأَنواعُ الحُتوفِ طُغاةُ",31,"ه",1,0],["ضَحِكاتُهُ بِشرُ النَوالِ وَكَفُّهُ","بَحرٌ لِكَفِّ الطالِبِ المُمتاحِ",32,"ح",1,0],["ضَحِكَت فَأَبكَت عَينَ كُلِّ مُمَوِّهٍ","مُتَحَمِّلٍ تَحتَ الضَريبِ الجامِدِ",33,"د",1,0],["ضَحِكاتٌ في إِثرِهِنَّ العَطايا","وَبُروقُ السَحابِ قَبلَ رَعودِه",34,"د",2,0],["ضَحوكٌ إِلى الأَبطالِ وَهوَ يَروعُهُم","وَلِلسَيفِ حَدٌّ حينَ يَسطو وَرَونَقُ",35,"ق",1,0],["ضَحِكَ البَهارُ بِأَرضِها وَتَشَقَّقَت","فيها عُيونُ شَقائِقِ النُعمانِ",36,"ن",1,0],["ضحينا عنده يوما","شديد الحر فالتحنا",37,"ن",2,0],["ضَحِكَ المجدُ في زَمانِكَ عِلْماً","أنْ سَيُوطِيه ما أحبَّ زمانُك",38,"ك",1,0],["ضحكت أوجهُ اللَّذاذةِ بالفِك","رِ ولاحَتْ طوالعُ السَّرَّاءِ",39,"ا",2,0],["ضَحَّوا قَليلاً قَفا كُثبانِ أَسنُمَةٍ","وَمِنهُمُ بِالقَسومِيّاتِ مُعتَرَكُ",40,"ك",1,0],["ضَحِكَت ثُغورُ حَدائِقِ الأَرضِ","فَسَهَت عُيونُ النَرجِسِ الغَضِّ",41,"ض",1,1],["ضَحِكَ الحَبابُ بِها وَقَد غَضِبَت","لِلشارِبينَ بِسُخطِها تُرضي",41,"ي",1,0],["ضِحكتي ثورتي وقهقهةُ","السخرِ عندي تمرد البركانِ",42,"ن",1,0],["ضحكُ الذي بعد صبر","قد فاز فوزاً أخيرا",43,"ر",2,0],["ضحكت لعينيَّ المصابيح التي","تعلو رؤوس الليل كالتيجان",44,"ن",1,1],["ضحكت لظلينا وقد عجبت","مما يخال فؤاد مذعور",45,"ر",1,0],["ضحكتْ محاسنُهُ إليك كأنّما","جُعلتْ لها زُهرُ النجوم ثغورا",46,"ر",2,0],["ضحكتْ تُقهقِه والكماةُ عوابسٌ","بالضربِ فوق قوانسٍ ومغافِرِ",47,"ر",1,0],["ضَحِكتُ ابنَ عِشرينَ مِن صَبوَةٍ","بَكيتُ ابنَ ستِّينَ أَوزارها",48,"ر",3,0],["ضحوكٌ عبوسٌ في مراحٍ مُنَقَّلٌ","عَنِ الهزلِ في قَطفِ الرُؤوس إِلى الجَدِّ",49,"د",1,0],["ضَحى الشَجا مُستَطيلاً في حُلوقِهِم","مِن بَعدِ ما جاذَبوهُ وَهوَ مُعتَرِضُ",50,"ض",1,0],["ضَحِكَت لَهُ أَكبادُ مَكَّةَ ضِحكَها","في يَومِ بَدرٍ وَالعُتاةِ الشُهَّدِ",51,"د",1,0],["ضحَّاكةُ الثَّغرِ بُهتاناً وحاملةٌ","في الصدرِ للشرِّ أو للبؤس تنِّينا",52,"ن",2,0],["ضَحِكَت أُمُّ نَوفَلٍ إِذ رَأَتني","وَزُهَيراً وَسالِفَ اِبنَ سِنانِ",53,"ن",1,1],["ضحَايا من الأبرارِ ضَجَّتْ قُبورُها","فَضَجَّ المُصلَّى واْقشعرَّ المُحصَّبُ",54,"ب",1,0],["ضَحِكَ المُشرِفاتُ في يَومِ عيدٍ","إِذ رَأَوا جَعفَراً يَحُثُّ العِنانا",55,"ن",2,1],["ضَحِكَت شُرُّ إِذ رَأَتني قَد شِب","تُ وَقالَت قَد فُضَّضَ الآبَنوسُ",56,"س",1,0],["ضَحِكَ الوَردُ في قَفا المَنثورِ","وَاِستَرَحنا مِن رِعدَةِ المَقرورِ",57,"ر",1,1],["ضَحِكَ الشَيبُ في نَواحي الظَلامِ","وَاِرعَوى عَنكَ زاجِرُ اللَوّامِ",58,"م",1,1],["ضَحِكَت لي عَن بارِد