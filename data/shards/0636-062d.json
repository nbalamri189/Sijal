html","الرمل"],[578,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[578,"عوضني بعده بتأريق","https://www.aldiwan.net/poem2906.html","المنسرح"]],"verses":[["ضَحى اليَومَ عَن ظِلِّ الشَبيبَةِ مَفرِقي","وَأَبدَلَ مُسوَدَّ العِذارِ بِمُبيَضِّ",0,"ض",1,0],["ضَحِكتِ ثُمَّ بَكى الإِبريقُ مُنتَحِباً","فالرِّيقُ وَالثَّغرُ مِثلُ الرَّاحِ وَالحَبَبِ",1,"ب",1,0],["ضَحِكَت عُبَيلَةُ إِذ رَأَتني عارِياَ","خَلَقَ القَميصِ وَساعِدي مَخدوشُ",2,"ش",1,1],["ضحِكَتْ بأبِي العبّاسِ","منَ الأيّامِ ثَنايا زُخْرُفِها",3,"ف",3,0],["ضحَّاكةً كالنور في الزهر","رقاصةً كالغصن في الوادي",4,"ي",1,1],["ضَحَّتْ ظِلالَ الرِّجَالِ الكَاسِبِينَ لَهُمْ","وَخَلَّفَتْ بَعْدَهُمْ أَنْضَاءَ حِرمَانِ",5,"ن",1,0],["ضَحوكاً إِذا لاعَبَتهُ الرِياحُ","تَأَوَّدَ كَالشارِبِ المُرجَحِنّ",6,"ن",1,0],["ضَحِكَ النَّاسُ وقَالُوا","شِعرُ وضَّاحِ اليَماني",7,"ي",1,1],["ضحِيَت وقد قلص الظلال فوجهها","للشمس في وجناته تلويح",8,"ح",1,0],["ضحكت مَشارقها بوجهك بكرةً","وبكت مغاربها الدماء أصيلا",9,"ل",2,0],["ضحكوا منه في الحياة ومذ ما","ت تعالى نحيبهم والبكاء",10,"ا",2,0],["ضَحَّوا بِأَشمَطَ عُنوانُ السُجودِ بِهِ","يُقَطِّعُ اللَيلَ تَسبيحاً وَقُرآنا",11,"ن",2,0],["ضحى الحَبيبُ بِنَفسٍ يَومَ عيدِهِمُ","وَالناسُ ضَحّوا بِمِثلِ الشاءِ وَالنِعَمِ",12,"م",1,0],["ضحك الزمان إليه ضحْكَةَ قائلٍ","يا مرحباً بابن الخليفة مرحبا",13,"ب",2,0],["ضُحُكُ الوجوه من الطبرزَد فوقها","دمع العيون من الدِّهان تُعصّر",14,"ر",1,0],["ضحِكَتْ منك محكماتُ القوافي","حين عارَضْتَ وابلي برشاشِك",15,"ك",1,0],["ضحكَ الربيعُ إلى بكا الدِّيمِ","وغدا يُسَوِّي النبت بالقمَمِ",16,"م",1,1],["ضَحِكَ الشَبابُ مِنَ الكُهولِ فَأَغرَقوا","وَاِستَيقَظوا فَإِذا الشَبابُ كُهولُ",17,"ل",1,0],["ضَحِكَ الشعِرُ مِمّا سَمِعَتهُ أُذُناهُ","وَتَمَنّى أَن يُداجي فَعَصَتهُ شَفَتاهُ",18,"ه",1,0],["ضَحوكَةِ الوَجهِ يُغرينا تَبَسُّمُها","إِن نَجتَديها وَيَثنينا تَثَنّيها",19,"ي",3,0],["ضَحوكٌ وقد بلَّلتهُ الدُّموعُ","طَرُوبٌ وقد ظَلَّلَتْهُ الشُّجُونْ",20,"ن",1,0],["ضحِكْنا على الماضي البعيدِ وفي غدٍ","ستجعَلُنا الأَيَّامُ أُضْحُوكَةَ الآتي",21,"ت",2,1],["ضحكوا غرة فاسبلت دمعا","كنت تبكي به على الضاحكينا",22,"ن",2,0],["ضحيت بالنفس والاقدار واجمة","من هول ما جئته والليل معتكر",23,"ر",1,0],["ضحى الرئيس بنفسه لبلاده","لما رأى ان السياسة تغشم",24,"م",1,0],["ضحى باغلى ما لديه لاجلها","والليل مسدول الذوائب اسحم",24,"م",1,0],["ضحك الأيتام في ليلته","ومشى يستروح البرء العليل",25,"ل",1,0],["ضَحِكَ النَبِيُّ وَقالَ إِنَّ سَفينَتي","لَهِيَ الحَياةُ وَأَنتِ كَالإِنسانِ",26,"ن",1,0],["ضَحكَ السُلطانُ في هَذا المَقال","ثُمَّ أَدنى خادِمَ الخَيرِ وَقال",27,"ل",1,0],["ضحِكَتْ إليَّ وجُوهها وعيونُها","ووجدْتُ فِي أَنفاسها ريّاكِ",28,"ك",1,0],["ضَحِكُ الماءِ وَالأَقاحي عَلَيها","قابَلَتهُ الغُصونُ بِالتَصفيقِ",29,"ق",1,0],["ضَحِكَت إِلَيَّ مِنَ السُرورِ وَلَم تَزَل","بِنتُ الكُرومِ كَريمَةَ الأَعراقِ",30,"ق",1,0],["ضَحِكتَ مِنَ الأَهوالِ ثُمَّ بَكَيتَهُم","بِدَمعٍ جَرَت في إِثرِهِ الرَحَماتُ",31,"ت",1,0],["ضَحوكاً وَأَصنافُ المَنايا عَوابِسٌ","وَقوراً وَأَنواعُ الحُتوفِ طُغاةُ",31,"ه",1,0],["ضَحِكاتُهُ بِشرُ النَوالِ وَكَفُّهُ","بَحرٌ لِكَفِّ الطالِبِ المُمتاحِ",32,"ح",1,0],["ضَحِكَت فَأَبكَت عَينَ كُلِّ مُمَوِّهٍ","مُتَحَمِّلٍ تَحتَ الضَريبِ الجامِدِ",33,"د",1,0],["ضَحِكاتٌ في إِثرِهِنَّ العَطايا","وَبُروقُ السَحابِ قَبلَ رَعودِه",34,"د",2,0],["ضَحوكٌ إِلى الأَبطالِ وَهوَ يَروعُهُم","وَلِلسَيفِ حَدٌّ حينَ يَسطو وَرَونَقُ",35,"ق",1,0],["ضَحِكَ البَهارُ بِأَرضِها وَتَشَقَّقَت","فيها عُيونُ شَقائِقِ النُعمانِ",36,"ن",1,0],["ضحينا عنده يوما","شديد الحر فالتحنا",37,"ن",2,0],["ضَحِكَ المجدُ في زَمانِكَ عِلْماً","أنْ سَيُوطِيه ما أحبَّ زمانُك",38,"ك",1,0],["ضحكت أوجهُ اللَّذاذةِ بالفِك","رِ ولاحَتْ طوالعُ السَّرَّاءِ",39,"ا",2,0],["ضَحَّوا قَليلاً قَفا كُثبانِ أَسنُمَةٍ","وَمِنهُمُ بِالقَسومِيّاتِ مُعتَرَكُ",40,"ك",1,0],["ضَحِكَت ثُغورُ حَدائِقِ الأَرضِ","فَسَهَت عُيونُ النَرجِسِ الغَضِّ",41,"ض",1,1],["ضَحِكَ الحَبابُ بِها وَقَد غَضِبَت","لِلشارِبينَ بِسُخطِها تُرضي",41,"ض",2,0],["ضِحكتي ثورتي وقهقهةُ","السخرِ عندي تمرد البركانِ",42,"ن",1,0],["ضحكُ الذي بعد صبر","قد فاز فوزاً أخيرا",43,"ر",2,0],["ضحكت لعينيَّ المصابيح التي","تعلو رؤوس الليل كالتيجان",44,"ن",1,1],["ضحكت لظلينا وقد عجبت","مما يخال فؤاد مذعور",45,"ر",1,0],["ضحكتْ محاسنُهُ إليك كأنّما","جُعلتْ لها زُهرُ النجوم ثغورا",46,"ر",2,0],["ضحكتْ تُقهقِه والكماةُ عوابسٌ","بالضربِ فوق قوانسٍ ومغافِرِ",47,"ر",1,0],["ضَحِكتُ ابنَ عِشرينَ مِن صَبوَةٍ","بَكيتُ ابنَ ستِّينَ أَوزارها",48,"ر",3,0],["ضحوكٌ عبوسٌ في مراحٍ مُنَقَّلٌ","عَنِ الهزلِ في قَطفِ الرُؤوس إِلى الجَدِّ",49,"د",1,0],["ضَحى الشَجا مُستَطيلاً في حُلوقِهِم","مِن بَعدِ ما جاذَبوهُ وَهوَ مُعتَرِضُ",50,"ض",1,0],["ضَحِكَت لَهُ أَكبادُ مَكَّةَ ضِحكَها","في يَومِ بَدرٍ وَالعُتاةِ الشُهَّدِ",51,"د",1,0],["ضحَّاكةُ الثَّغرِ بُهتاناً وحاملةٌ","في الصدرِ للشرِّ أو للبؤس تنِّينا",52,"ن",2,0],["ضَحِكَت أُمُّ نَوفَلٍ إِذ رَأَتني","وَزُهَيراً وَسالِفَ اِبنَ سِنانِ",53,"ن",1,1],["ضحَايا من الأبرارِ ضَجَّتْ قُبورُها","فَضَجَّ المُصلَّى واْقشعرَّ المُحصَّبُ",54,"ب",1,0],["ضَحِكَ المُشرِفاتُ في يَومِ عيدٍ","إِذ رَأَوا جَعفَراً يَحُثُّ العِنانا",55,"ن",2,1],["ضَحِكَت شُرُّ إِذ رَأَتني قَد شِب","تُ وَقالَت قَد فُضَّضَ الآبَنوسُ",56,"س",1,0],["ضَحِكَ الوَردُ في قَفا المَنثورِ","وَاِستَرَحنا مِن رِعدَةِ المَقرورِ",57,"ر",1,1],["ضَحِكَ الشَيبُ في نَواحي الظَلامِ","وَاِرعَوى عَنكَ زاجِرُ اللَوّامِ",58,"م",1,1],["ضَحِكَت لي عَن بارِدِ الطَعمِ عَذبٍ","مُستَنيرٍ كَالكَوكَبِ الوَقّادِ",59,"د",1,0],["ضَحِكُ الدَهرِ في مُحَيّاكَ مَكرُ","ما لَهُ غَيرَ أن يَسوءَكَ فِكرُ",60,"ر",1,1],["ضَحِكَت إِلَيهِ وَهِيَ هازِئَةٌ بِهِ","لَمّا حَساها وَهُوَ أَزوَرُ عابِسُ",61,"س",1,0],["ضَحِكنا وَكانَ الضِحكُ مِنّا سَفاهَةً","وَحُقَّ لِسُكّانِ البَسيطَةِ أَن يَبكوا",62,"ك",3,1],["ضَحِكوا إِلَيكَ وَقَد أَتَيتَ بِباطِلٍ","وَمَتى صَدَقتَ فَهُم غِضابٌ رُجَّمُ",63,"م",1,0],["ضِحكةٌ ساخرةٌ هازلةٌ","وخيالٌ تافِهٌ هذي الحياه",64,"ه",1,0],["ضَحُّوْا قَلَيلاً قَفَا ذَاتِ النِّطَاقِ فَلَمْ","يَجْمَعْ ضَحَاءَهُمُ هَمِّي ولاَ شَجَنِي",65,"ن",2,0],["ضحكتْ بين قصورٍ كأساطيرِ الليالي","هذه الجنةُ فانظرْ أيَّ سحرٍ وجمالِ",66,"ل",1,0],["ضحِكتْ بصفحته المُنى وتراقصتْ","أطيافُ هذي الجنَّةِ الخضراءِ",67,"ا",2,0],["ضَحِكَتْ وأَوْمضَ بارِقٌ","فظَلِلْ