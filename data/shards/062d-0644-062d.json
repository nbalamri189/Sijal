{"poems":[[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83518","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83121","الخفيف"],[4718,"انا عضيدي لابغيته","https://www.poetsgate.com/ViewPoem.aspx?id=137153",""],[5434,"شيب الفلاحي","https://www.poetsgate.com/ViewPoem.aspx?id=37617",""],[5893,"حنا على العهد","https://www.poetsgate.com/ViewPoem.aspx?id=141493",""],[6056,"كل عصر له رجال ودولة","https://www.poetsgate.com/ViewPoem.aspx?id=130133",""],[6056,"كفيّ ، طوّ قت معصمه","https://www.poetsgate.com/ViewPoem.aspx?id=130137",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""]],"verses":[["حلّ حِصناً من دونِهِ كلّ حِصنٍ","أَي وَرَبّي لَم يَخشَ من تَعذيبِ",0,"ب",1,0],["حَلَّ حَيثُ الأَهواءُ تَنزُو إِلى الإِث","مِ وَتَهفو إِلى مَهاوي الشُرورِ",1,"ر",1,0],["حلحيل حلال الصعيب يليّن الراس العنيد","مفتاح قومه يوم بقعى كشرت بانيابها",2,"ب",3,0],["حلحيل حلو مر زراع حصاد","كبد يداويها وكبد لهدها",3,"د",3,0],["حلحيل حل الصعايب دقه وجله","كل العرب تستظل اليوم بظلاله",4,"ل",2,0],["حلحل الحال حل ّالله عظامه وحل ّ","وسط حوضه من الوركين لاسفل رجولة",5,"ل",2,0],["حلّ ، حبل النقاب ، وكرّرالسلهمه","عشت لحظات أحس العمر فيها إنكتب",6,"ب",1,0],["حلْحِلُوا مَا اسْتَطَعْتُمُ، كَيْفَ شِئْتُمْ","مَا لَدَيْكُمْ سِوَى حُلُولِ الذَّليلِ",7,"ل",1,0]]}