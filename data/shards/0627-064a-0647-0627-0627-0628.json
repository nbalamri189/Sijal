{"poems":[[75,"راحت فصح بها السقيم","https://www.aldiwan.net/poem11915.html","مجزوء الكامل"],[53,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[47,"ياراكبا سنن الطريق اللاحب","https://www.aldiwan.net/poem11431.html","الكامل"],[47,"إذا الغمام حداه البارق الساري","https://www.aldiwan.net/poem63559.html","البسيط"],[173,"صدت فجذت حبل وصلك زينب","https://www.aldiwan.net/poem1606.html",""],[412,"إيها أبا حسن حللت من العلى","https://www.aldiwan.net/poem50131.html","الكامل"],[443,"قف إن شاني بهم أن يسفح الشان","https://www.aldiwan.net/poem2574.html","البسيط"],[458,"حاصرتموني وحلتم دون إحساني","https://www.aldiwan.net/poem61606.html","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120023","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120001","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119989","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120086","الكامل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82621","المنسرح"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79863","السريع"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53188","البسيط"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104300","البسيط"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104323","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216630","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216810","الكامل"],[4449,"","https://poetry.dctabudhabi.ae/diwan/poem/143719","البسيط"],[6259,"إيهاً أبا حسنٍ حللتَ من العلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59391&r=&rc=39",""]],"verses":[["أَيها أَبا عَبدِ الإِلَهِ","دُعاءُ مَغلوبِ العَريم",0,"م",1,0],["إيهاً أبا القاسمِ الذي ركب ال","غشم جِهاراً ونفسَه غشما",1,"م",2,0],["إيهاً أَبا العَبّاسِ إِنّي مُلحِقٌ","بِكَ خُلَّتي وَمُلَيِّنٌ لَكَ جانِبي",2,"ب",2,0],["إيهاً أَبا صالِحٍ وَالبَحرُ مُنتَسِبٌ","إِلى نَوالِكَ في سيحٍ وَإِغزارِ",3,"ر",1,0],["إِيهاً أَبا المَنصورِ يَقظَة ثائِرٍ","بَطَلٍ لِعَلياهُ يَغارُ وَيَغضَبُ",4,"ب",1,0],["إِيهاً أَبا حَسَنٍ حللت من العُلى","بَينَ السَنامِ وَبَينَ ذرو الكَاهِلِ",5,"ل",1,1],["إيها أبا طالب إني محضتكم","ودّي فمين لكم سر وإعلان",6,"ن",1,0],["إِيهاً أبالسةَ الطاغوتِ أَرسلهم","رمزاً له لا لشعبٍ ساخطٍ عانِ",7,"ن",1,0],["إِيها أبا الفرج الذي","أضحى مفرج كل ضرِ",8,"ر",1,0],["إيها أبا الفضل الممدح والذي","ميزانه من كل فضل راجحُ",9,"ح",1,0],["إيها أبا الفضل الذي فضلت","يده بأدنى سحها المزنا",10,"ن",2,0],["أيها أبا الفضل استمع مدحا","زهرا ولا زهر البساتينِ",11,"ن",1,0],["إِيهاً أَبا جَعفَر وَلِلدَّهر كَرّا","ت وَعَمّا يَريب مُتَّسَع",12,"ع",1,1],["إيهاً أبا موسى لأنت الذي","قد رشَّح الأُسدَ لأغيالها",13,"ل",3,0],["إيهاً أبا الفتح قد كتبت","لكم براهينه فضلاً على الأمم",14,"م",1,0],["إيها أبا أحمد يامن به هدأت","من عين دهر العلى أجفانها الوطف",15,"ف",1,0],["أيها أبا المهدي يا رجل ال","دنيا وهل في طيها رجل",16,"ل",1,0],["إيهاً أبا النور أطربنا فكم لك من","لحن على البيد لم يطرب له أحد",17,"د",1,0],["إيهاً أبا الأنهار فوقك شادن","يشفي الغليل وأنت لست بشاف",18,"ف",1,0],["أيهاً أبا الأنهار ليس بنافع","خوف التفرق والحبيب مواف",18,"ف",1,0],["إيهاً أبا طاهرٍ هذا مقامُ ندىً","لا خيرَ في الجود ما لم يسبق الطلبا",19,"ب",2,0],["إيهاً أبا حسنٍ حللتَ من العلى","بين السنَّام وبين ذرو الكامل",20,"ل",1,1]]}