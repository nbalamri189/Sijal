{"poems":[[32,"هل تعرف المنزل بالوحيد","https://www.aldiwan.net/poem29596.html","الرجز"],[101,"في المقهى","https://www.aldiwan.net/poem6248.html","عموديه"],[60,"فاطم بنت السيد الكريم","https://www.aldiwan.net/poem30851.html","الرجز"],[41,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[48,"سل سبيل الحياة عن سلسبيل","https://www.aldiwan.net/poem23261.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39577","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55057","البسيط"],[371,"تبا لدنيا ساحره","https://www.aldiwan.net/poem17762.html","مجزوء الرجز"],[1877,"","https://poetry.dctabudhabi.ae/diwan/poem/115264","الرمل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100770","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69955","الرمل"],[4829,"الجابريّة","https://www.poetsgate.com/ViewPoem.aspx?id=35605",""],[4869,"ريح السواليف","https://www.poetsgate.com/ViewPoem.aspx?id=151577",""],[5368,"وجع الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=183851",""],[5573,"أنتِ التي علمتِني هذا الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=213732",""],[5756,"الذهب","https://www.poetsgate.com/ViewPoem.aspx?id=5187",""],[5848,"ما تبيني !!","https://www.poetsgate.com/ViewPoem.aspx?id=49004",""],[5997,"العنابه","https://www.poetsgate.com/ViewPoem.aspx?id=214232",""],[6046,"يا ذات الخمار","https://www.poetsgate.com/ViewPoem.aspx?id=35809",""],[6124,"المحاريث","https://www.poetsgate.com/ViewPoem.aspx?id=159856",""],[6332,"خجل الصّحوُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65172&r=&rc=1",""]],"verses":[["مَوعودِ رَبِّ صادِقِ الوعودِ","هَل أَغدوَن في عيشَةٍ رَغيدِ",0,"د",1,0],["موعدا .. سيدتي! وابتسمت","وأشارت لي إلى عنوانها..",1,"ن",3,0],["مَوعِدُهُ في جَنَّةِ النَعيم","حَرَّمَها اللَهُ عَلى اللَئيم",2,"م",1,0],["موعَبُ ليطِ القَرا بِهِ قُوَبٌ","سودٌ قَليلُ اللِحاءِ مُنجَرِدُه",3,"د",2,0],["مَوعِدٌ بِالإِجرامِ يوعِدُ أُمَّ النَس","لِ فيهِ بِالثُكلِ وَالتَهبيلِ",4,"ل",1,0],["موعِدُنا كانَ في أصائلِهِ","ضِفَّة سُندسيَّةُ العُشُبِ",5,"ب",1,0],["مَوْعِدُنَا صَاقِبٌ وَلَكَنْ","وَاحَرَّ قَلْبَاً مِنَ الْفِرَاقِ",6,"ق",1,0],["مَوعِظَةٌ ما عَدِمَت","إِلّا القُلوبَ الحاضِرَه",7,"ر",2,0],["موعدي بالبين ظنا","انّني بالبين أشقى",8,"ق",2,1],["موعزاً بانعقاد مؤتمر التحك","يم يقضى في المعضلات الجسّام",9,"م",1,0],["موعباً علماً وَفضلاً بالتَمام","حولهُ الاحبارُ يحكون البدور",10,"ر",1,0],["موعدهم الليل القريب الداني","لابان لي من بعد زح اللامي",11,"م",2,0],["موعد يشتتني وانا له ترتبت","وبعثرت له عمري بشنطة مغادرْه",12,"ر",2,0],["مَوْعُودَةٌغَدٍ سَيَجْمَعُنا","والوَصْلُ قَدْ يُخْفِي مَتَى غُدُهُ",13,"د",2,0],["موعد لقانا موقعه جوف الفلك","لهفة هُدى مدري جدى مدري طرب",14,"ب",1,0],["مو عيب أجي مدعو ولا أشوف ترحاب","العيب لو أني رجعت أن دعوني",15,"ن",2,0],["( موعدٍ مهجور) يجرح في سنيني","( والجفا بردٍ) تسلل للمحاني",16,"ن",2,0],["موعدي إنْ شئت بالأخْرى أكيد","ما لنا عذْر إذا أسْطعت صبرا",17,"ر",2,0],["«مَوْعِدُ الفَجْرِ فيهِ دولَةُ نورٍ","تَحْمِلُ البِشْرِ في سَدادِ الدُّيونِ»",18,"ن",1,0],["موعدٌ بيني وبين الطامةِ الكبرى مساءا","نركبُ المحراثَ روَّاحًا إلى أرضي شتاءا",19,"ا",2,1],["موعدي اليومَ مع الصيف فلا","تسألي عني إذا هُدبكِ غار",20,"ر",1,0]]}