"رسالة إلى أمي في ذكرى وفاتها","https://www.poetsgate.com/ViewPoem.aspx?id=175530",""],[5841,"أبحرت في !! بحر الهوى !! ولقيت سناره","https://www.poetsgate.com/ViewPoem.aspx?id=34861",""],[5842,"أعُوذُ باللهِ / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=137108",""],[5853,"صمت الانتظار","https://www.poetsgate.com/ViewPoem.aspx?id=175622",""],[5853,"قطوف الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=175683",""],[5853,"حلم باللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=188363",""],[5873,"سُبات العرب","https://www.poetsgate.com/ViewPoem.aspx?id=215312",""],[5906,"أختاه","https://www.poetsgate.com/ViewPoem.aspx?id=188222",""],[5906,"أودعتك الله","https://www.poetsgate.com/ViewPoem.aspx?id=188828",""],[5913,"الحنين المكتَّمُ المفضوحُ","https://www.poetsgate.com/ViewPoem.aspx?id=183248",""],[5943,"كوني العون","https://www.poetsgate.com/ViewPoem.aspx?id=36077",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""],[5974,"نسائم العشق","https://www.poetsgate.com/ViewPoem.aspx?id=213853",""],[5997,"لِرَبِّ الْعَالَمَيْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=214257",""],[5997,"كهف العبيد","https://www.poetsgate.com/ViewPoem.aspx?id=214282",""],[6075,"النَّصْرُ آتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=190501",""],[6127,"يا ثورة الآس","https://www.poetsgate.com/ViewPoem.aspx?id=205889",""],[6127,"ضاقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=214909",""],[6142,"أنت السناء الذي في العرش قد بزغا","https://www.poetsgate.com/ViewPoem.aspx?id=155730",""],[5309,"ذلك البدر كنت ادري مصيره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573542",""],[6213,"غياب الأحبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76260&r=&rc=17",""],[6278,"جميلتي عمّان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86849&r=&rc=2",""],[6333,"الموت حبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7086&r=&rc=8",""],[6343,"تهويمات في وجهها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1971&r=&rc=1",""],[5567,"عتم الآهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81816&r=&rc=66",""]],"verses":[["تاهَت إِلَيكَ عَلى القَريضِ فَرُدَّها","بِنَداكَ تائِهَةً عَلى الأَزمانِ",0,"ن",1,0],["تاهَ الأُعَيرِجُ وَاِستَعلى بِهِ الخَطَرُ","فَقُل لَهُ خَيرُ ما اِستَعمَلتَهُ الحَذَرُ",1,"ر",1,1],["تَاهَتْ بهِ الْجُرْدُ وَاهْتَزَّتْ بِهِ طَرَباً","مَعَاطِفُ السُّمْرِ والْمَصْقُولَةِ الْحَذَمِ",2,"م",1,0],["تاهَت بِقَبرِ صَلاحِ الدينِ تُربَتُها","وَتاهَ أَحياؤُها تيهاً بِمَطرانِ",3,"ن",1,0],["تاهَت بِعَهدِ مَليكٍ فَوقَ مَفرِقِهِ","لِمُلكِ مِصرٍ وَلِلسودانِ تاجانِ",4,"ن",1,0],["تاهت بكلكلها وأتلع جيدُها","ومشى بها الإعجابُ مشيَ وقارِ",5,"ر",1,0],["تاه أسطوله على اليَمّ عُجباً","حين أضحى لمثله مرؤسا",6,"س",2,0],["تاهت به ايلياء فاخرة","على دمشق الشَآم أو حلبه",7,"ب",2,0],["تاهَ الخَلائِق في عَمياءَ مُظلِمَةٍ","قَصداً وَلَم يَعرِفوا غَيرَ الإِشاراتِ",8,"ت",1,0],["تاهَ وتهنا فسَمَونا بها","وهْي عنِ الذلِّ مصوناتُ",9,"ت",1,0],["تأهَّبوا إنّ أمرَ اللهِ مُنتظَرٌ","وليس ينفعكم أن تأخذوا الأُهَبا",10,"ب",2,0],["تاهَت فُروقُ عَلى العَواصِمِ وَاِزدَهَت","بِجُلوسِ أَصيَدَ باذِخِ المِقدارِ",11,"ر",1,0],["تاهوا عَلى الدُنيا بِأَموالِهِم","وَقَيَّدوا بِالبُخلِ أَقفالَها",12,"ل",3,0],["تاهَت بِهِ الدُنيا وَلولا جودُهُ","كانَ الأَنامُ هَباً بِغَيرِ هِباتِ",13,"ت",1,0],["تاهَ مِن عُجبِهِ فَلان","صَعبُهُ بَعدَما قَسا",14,"س",2,0],["تاهَت عَلى صورَةِ الأَشياءِ صورَتُهُ","حَتّى إِذا كَمَلَت تاهَت عَلى التيهِ",15,"ي",2,0],["تَأَهَّبْ يا خُبَيْبُ أتاكَ غَوْثٌ","يَؤُمُّكَ في رَكائبهِ العِجالِ",16,"ل",1,0],["تأهّبوا إِنَّ ديناً قام قائمُه","يُومِي إليكم بآمالٍ وأوطارِ",17,"ر",1,0],["تاهَ عَلَينا فَتاهَ مِنّا","فَلا نَراهُ وَلا يَرانا",18,"ن",2,0],["تاهَت عَلى غَيرِها أَن أُذنُها سَلِمَت","وَما تَعاوَرَها في مَطبَخٍ خَدَمُ",19,"م",1,0],["تاهت على قدرها إذ إذنُها سلمَت","وما تعاورَها الولدانُ والخدَمُ",20,"م",1,0],["تأهّب يومَ فطرِكَ للمعاصي","وخذ شوّالَ ويحكَ بالقصاصِ",21,"ص",1,1],["تاه بأثواب له قد زهت","مبارياً فيها الطواويسا",22,"س",2,0],["تَاهَتْ بِنُقْطَةِ خَالٍ فَوْقَ وَجْنَتِهَا","زِيدَتْ بِهَا عَشَرَاتُ الْحُسْنِ أَضْعَافَا",23,"ف",2,0],["تَاهَتْ عَلَى الأَمْصَارِ مِصْرُ بِجَاهِهِ","وَالحُقْبُ تَاهَ بِهِ عَلَى الأَحْقَابِ",24,"ب",1,0],["تَاهَ شَطْرٌ مَنَ الْبِلاَدِ عَلَى شَطْرٍ","مُدِلاًّ بِالانْتِسَابِ الْجَدِيدِ",25,"د",1,0],["تَاهَتْ بِعُرْسِهِ سَمَاءُ الخِدْرِ","عَلَى مَطَالِعِ النجُومِ الزهْرِ",26,"ر",1,0],["تَاهَ بِالعِلْيَةِ السَّرَاةِ مِنَ القَوْ","مِ وَبَاهَى بِالنُّخْبَةِ النُّبَلاَءِ",27,"ا",2,0],["تاهَ عَلى آدَمَ في سَجدَةٍ","وَصارَ قَوّاداً لِذُرِّيَّتِه",28,"ت",2,0],["تاهوا فَلَم يُسعدوا بِدَمع","أَينَ المُصافاةُ وَالمَتاتُ",29,"ت",1,0],["تاهت به الجرد واهتزت به طربا","معاطف الشم والمصقولة الخدم",30,"م",1,0],["تاه الأعيرج واستغلى به الخطر","فقل له خير ما استعملته الحذر",31,"ر",1,1],["تاهت عن العنق الهاني فأرشدها","إلى سناه حنين النور للنور",32,"ر",1,0],["تأهبوا إن أمر الله منتظر","وليس بنفعكم أن تأخذوا الأهبا",33,"ب",2,0],["تاهَ الزمانُ بعدلك","المشهور في مصرٍ وشامِ",34,"م",1,0],["تأهب لقد جاشت قريحةُ ماهرٍ","عليك بأمواج تلاطَمُ كالبحرِ",35,"ر",1,0],["تَاهتْ على أخواتها بقرائدٍ","وفوائِدٍ لا دُمْلُجَا وسِوَارَا",36,"ر",2,0],["تَاهَتْ عمانُ به فعدْ","لُ اللَّهِ في الأرض انتشَر",37,"ر",1,0],["تاهَتْ على التيه من حسن يتيهُ بها","ما لاق إلا بها مدحٌ وإطراءُ",38,"ا",2,0],["تَاهَ الزَّمَانُ بِهُم وازدَانَ عَاطِلُهُ","لَولاَهُمُ لَتبَدَّى غَيرَ مُزدَانِ",39,"ن",1,0],["تاهت عقول الناس في حركاتها","ألسكرها أو شكرها تتأود",40,"د",1,0],["تاهَ بِقَدٍّ يُزْهى بِهِ الهَيَفُ","كأَنَّهُ في قَوامِهِ أَلِفُ",41,"ف",1,1],["تاه علينا بنقا خدّه","دهرٌ فتهنا بعد مسوده",42,"د",2,0],["تاهَ بِالتيهِ قَبلهم قومُ موسى","وَهوَ أَرضٌ فسيحةٌ فيحاءُ",43,"ا",2,0],["تاهت على البانِ بأعْطافها","وعَيَّرَتْ بدرَ الدُّجى بالمُحاقْ",44,"ق",1,0],["تاه بك المجد على أهلهِ","كما يتيه الصبح بالشمسِ",45,"س",1,0],["تاهَت وَلَكِن ما رَأت","كَ بِها الخِلافَةُ تائِها",46,"ا",3,0],["تاهوا عَلى أَقرانِهِم يَومَ الوغى","بِرِياضِ حُسنٍ في الخُدودِ نَواضِرِ",47,"ر",1,0],["تَاهَتْ مُلُوكُ الْقَوْلِ فِي أَمْدَاحِهِ","وَالتِّيهُ فِي أَمْدَاحِهِ أَقْصَاهَا",48,"ا",3,0],["تاه دمعي، فوق خدي","جارياً، هَمْساً دعاني",49,"ن",2,0],["تاه عني ورمى بي","حبه ماعاد يجدي",50,"د",2,0],["تأهّب للنوى وأعدّ زاداً","فأسبابُ المتالف لا تكَتّ",51,"ت",1,0],["تاهَت بِوَطأتهِ الغَبرا وأنطَقها","إِجلالهُ بِلسانٍ ليسَ ينعجمُ",52,"م",1,0],["تَأَهَّب لِلمَنِيَّةِ حينَ تَغدو","كَأَنَّكَ لا تَعيشُ إِلى الرَواحِ",53,"ح",1,0],["تاه عقلي فلا أقلّ من النس","يان أجروه كي يطول سباتي",54,"ي",1,0],["تاه عقلي فلا أقل من النسي","ان أرجوه كي يطول سباتي",55,"ت",2,0],["تَأَهَّب مِثلَ أُهبَةِ ذي كِفاحِ","فَإِنَّ الأَمرَ جَلَّ عَنِ التَلاحي",56,"ح",2,1],["تاهَ الفؤادُ هوى وتاهَ تعَظُمّاً","فمتى إفاقةُ تائهٍ في تائه",57,"ا",3,0],["تاهت بها أديان زورٍ شلَّها","عن ربها حتى رماها بالشلل",58,"ل",1,0],["تاهَتْ على الأرض طُرَّاً مُنذ كنتَ بها","كالتّاج للرأس بل كالروحِ للبدنِ",59,"ن",1,0],["تاهَت بِهِم دولة الإِسلامِ واِعتَدَلَت","بِعَزمِهِم كاِعتِدالِ الشَمسِ في الحَمَلِ",60,"ل",1,0],["تاهَ بخالِ خَدِّهِ","كما يَتِيهُ الثَّمِلُ",61,"ل",1,1],["تأهب لا عدمتك في جمادي","إذا ما كنت حلمي للمديد",62,"د",1,0],["تأهب فركبان المنايا تبادرت","إليك وقد ساقوا أمامك ركبانا",63,"ن",2,0],["تاهت بمدحك لما افتر مبسَمها","عن غر أوصافك المسكية العبق",64,"ق",1,0],["تاهت على العام إذ صيرَّتها علَما","فيه وبالنار ليلا يُعرفُ العَلمُ",65,"م",1,0],["تاهَت بِوَجهٍ أَزهَرِ","وَزَهَت بِطَرفٍ أَحوَرِ",66,"ر",1,1],["تاهَ عَلى الوِلدانِ وَالحورِ","مُقَرطِقٌ مِن آلِ سابورِ",67,"ر",1,1],["تاهَت عَلى القاصِراتِ القَيصَرِيّاتِ","رودٌ مِنَ الخَفَراتِ الكِسرَ وَيّاتِ",68,"ت",1,1],["تاهَ الدَّليلُ غَراماً","يا من يُغيثُ غَرامَهْ",69,"م",2,0],["تاه قوم فحاولوا الكشف عنها","بقواها فأثبتوها ثبوتا",70,"ت",2,0],["تاهَتْ بك الإسكندريةُ عِزَّةً","فَبَدَتْ عليها للسُرورِ دلائلُ",71,"ل",1,0],["تاهَتْ بجمعِ صناعتَيْن وأظهرَتْ","كِبْراً بذاك وأُعْجِبَتْ إعجابا",72,"ب",2,0],["تَاهَتْ به الدنيا فَتَ","وّه ظُلْمهَا وظَلامَها",73,"م",3,0],["تاهَت به الأَيَّامُ وازْدَانَت به","وبِه ازْدَهى شَرْقُ البلاد وغَرْبُها",74,"ب",3,0],["تاهت بيوسفٌّ مصرنا والمشرقُ","فغدا وليس يفى ثناه المنطق",75,"ق",1,1],["تاهت بمقدمك المبارك واكتست","يا ابن المليك ب