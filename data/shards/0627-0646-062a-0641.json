ml","المديد"],[556,"أنت في بالك خاطر","https://www.aldiwan.net/poem34552.html","مجزوء الرمل"],[556,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[556,"خلني في محبة المحبوب","https://www.aldiwan.net/poem34963.html","الخفيف"],[560,"طال ميعادنا فخلناه دهرا","https://www.aldiwan.net/poem52935.html","الخفيف"],[560,"لمن الدمع بعد هذا تصون","https://www.aldiwan.net/poem52978.html","الخفيف"],[560,"أفراقا حسبتها أم لقاء","https://www.aldiwan.net/poem52986.html","الخفيف"]],"verses":[["إِن تَفِض عَبرَتي تَجِد","كَمَدَ القَلبِ باقِيا",0,"ي",2,0],["أَنتَ فينا هَضبَةُ اللَهِ الَّتي","زادَها قَرعُ المَقاديرِ اِلتِئاما",1,"م",2,0],["إِن تُفجَأوا بِدُخانِها","فَبِعَقبِ ما شَجَرَ الوَطيسا",2,"س",2,0],["إنْ تَفخَري ببَني أبيكِ فإنّ لي","منْ فَرْعِ خِنْدِفَ ذِرْوَةً وصَميما",3,"م",2,0],["أَنتَ في الحُبِّ رَأسُ كُلِّ مُحِبٍّ","لا شَفاكَ الإِلَهُ مِمّا تُقاسي",4,"ي",1,0],["إِنْ تَفْتَخِر بِمَرِينَ أَرضُ الْعُدْوَة ال","قُصْوَى فَإِنَّكَ أَنْتَ فَخْرُ مَرِين",5,"ن",1,0],["أَنْتَ فَظٌّ وَالْعِطْفُ بالض","ضِدِّ وَالأَمْرُ مُرْتَبِكْ",6,"ك",1,1],["أَنتَ في البَرِّ بَلاءٌ فَإِذا","رَكِبَ البَحرَ غَدا مَوتاً زُؤاما",7,"م",2,0],["أَنتَ في القُربِ وَفي البُعدِ","مِنَ النَفسِ مَكينُ",8,"ن",1,0],["أَنتَ في مَعشَرٍ إِذا غِبتَ عَنهُم","بِدَّلوا كُلَّ ما يَزينُكَ شَينا",9,"ن",2,0],["إِنْ تَفْقَدُوهُ فَفِي السَّمَاءِ شَفِيْعُكُمْ","مُتَبَوِّئاً مِنْهَا أَعَزَّ مَكَانِ",10,"ن",1,0],["إِنْ تُفَارِقْ فَأَيُّ ذَخْرٍ لِقَوْمٍ","صَارَ بَعْدَ الْحَيَاةِ بَعْضَ الرَّمِيمِ",11,"م",1,0],["أَنْتَ فِي جَنَّةٍ وَأَشْهَى إِلَى نَفْ","سِكَ شِيحُ الْوَادِ وَالقَيْصُومُ",12,"م",1,0],["أنت فخَّارٌ بدنياكَ ولا","بدَّ للفخَّار من أن يتكسَّر",13,"ر",1,0],["أنت في جنة النعيم مقيم","وفؤادي عليك بالنار صالي",14,"ل",2,0],["أنت في العَدْل بالمكارم أَوْلى","من وُلاةٍ دُعاتُهم لا تجابُ",15,"ب",1,0],["أنتَ في لَزِّكَ العِتَابَ بمن يك","رهُ شربَ الزَّقُّومِ أهلُ العتابِ",16,"ب",1,0],["أنت في بستان عَيْشٍ","فَتَخَيَّرْ ثمراتِهْ",17,"ت",2,0],["أنت فضلٌ وفضلةُ الشيء لغو","ثم أُردفْتَ ذلّة التصغيرِ",18,"ر",1,1],["إن تَفجعونا بسهمٍ من كِنانتنا","فعندكم من ثَناه أبلغُ الخبرِ",19,"ر",1,0],["أنتِف لنا لهو أيام نعيش بها","فالدهر أجمع إن راعيته نُتَف",20,"ف",1,0],["أَنتِ في حاجَةٍ إِلى مِثلِ موسى","لَستِ في حاجَةٍ إِلى أَرمِياءِ",21,"ا",2,0],["أَنتَ في البُردَةِ المُوَشّاةِ مِثلي","في كِسائي الرَديمِ تَشقى وَتُسعَد",22,"د",1,0],["أَنتَ في شَرعِها دَخيلٌ عَلى الحَق","ل وَلِصٌّ جَنى عَلَيها فَأَفسَد",22,"د",1,0],["إِن تَفخَري يا جارَتي بِالشَرِّ","فَإِنَّ بِالفِعلِ الجَميلِ فَخري",23,"ي",1,0],["أَنتَ في الحُسنِ إِمامٌ","فيكَ قَلبي يَتَوالى",24,"ل",2,0],["أَنتَ في الفَضلِ قُدوَةٌ وَإِمامٌ","فَإِذا قُلتَ قَولُكَ المَسموعُ",25,"ع",1,0],["إِن تَفَضَّلتَ عَلى العا","دَةِ إِنّي لَكَ شاكِر",26,"ر",1,1],["أَنْتَ في الكونِ قوَّةً لو تَسُسْها","فكرةٌ عبقريَّةٌ ذاتُ بأسِ",27,"س",1,0],["أَنْتَ في الكونِ قوَّةً كبَّلتْها","ظُلُماتُ العُصور مِنْ أمس أمسِ",27,"س",1,0],["أَنتِ فوقَ الخيالِ والشِّعرِ والفنِّ","وفوقَ النُّهى وفوقَ الحُدودِ",28,"د",1,0],["انت في الدولتين كنت رسولا","ذا كتاب تدعو الى التوحيد",29,"د",1,0],["انت فرد يا احمدج المتنبي","في قريض نظمته أي وربي",29,"ي",1,0],["انت في بحر كنت تسبح والبا","قون في حوض ماؤه ضحضاح",29,"ح",1,0],["انت في شعر كان فتحاً مبينا","واحدا من اولئك الخالدينا",30,"ن",2,1],["انت في دولة البيان بحق","ملك ذو عرش ونحن الرعايا",30,"ي",2,0],["انت في شعرك البليغ امام","فسلام عليك ثم سلام",30,"م",1,0],["انت في شعرك البليغ نبي","وكتاب الملوك من معجزاتك",30,"ك",1,0],["انت في الدنيا عن الدن","نا على القرب بعيد",31,"د",1,0],["انت فرع له واكرم بفرع","وسليل له ونعم السليل",32,"ل",1,0],["انت في الارض ما تطأطأت حتى","تخضعى في السماء او تستقيدي",33,"د",2,0],["انت فان وخالد في زمان","انت جسم يبلى وذكر باق",34,"ق",1,0],["انت فيها نفخت من روحك الدا","مي فجاءت كالنار ذات الاوار",35,"ر",1,0],["انت في دنياك ما","كنت تشكو ملك",36,"ك",1,0],["أنتِ في هجرنا وهذا الصدود","يا سليمى جاوزتِ كل الحدودِ",37,"د",1,1],["أنت فوق النقيب دخلا وريعا","بعد حين وأنت أكثر مالا",38,"ا",1,1],["أنت في عليا الذرى من أمة","رفعوا مُلكا وشادوا دولا",39,"ل",2,0],["أنت في كل بلدة تتجلى","وأبوك العظيم ملء الزمان",40,"ن",1,0],["أنت في نضرة الثلاثين كسرى","قاتِلُ الدهر أو أجل وقارا",41,"ر",2,0],["أنت في فقر إذا أفتقرت","وإذا أستغنت فأنت غنى",42,"ن",2,0],["أَنتَ في الأَسرِ ما سَلِمتَ فَإن تَم","رَض تُقَطَّع مِن جِسمِكَ الأَوصالُ",43,"ل",1,0],["أَنتَ في القَولِ كُلِّهِ","أَجمَلُ الناسِ مَذهَبا",44,"ب",2,0],["أَنتَ في الكَونِ مَحَلُّ التَكرِمَه","كُلُّ شَيءٍ لَكَ عَبدٌ أَو أَمَه",45,"ه",1,0],["أَنتَ في مَدرَجَةِ السَيلِ وَقَد","ضَلَّ مَن في مَدرَجِ السَيلِ رَقَد",46,"د",1,0],["إِن تَفقِدوا الآسادَ أَو أَشبالَها","فَالغابُ مِن أَمثالِها مَأهولُ",47,"ل",1,0],["أَنتِ في الفُلكِ بَهاءٌ","وَهوَ في حُلوانَ زينَه",48,"ن",2,0],["أَنتَ فيهِ وَكانَ كُلُّ زَمانٍ","يَشتَهي بَعضَ ذا عَلى الخَلّاقِ",49,"ق",1,0],["أَنتِ في مَغناكِ ذا","أَبلَغُ مِن عَبدِ الحَميدِ",50,"د",1,0],["أَنتَ فينا بَقِيَّةُ الدينِ وَالدُن","يا وَظِلُّ النُعمى عَلَينا الظَليلُ",51,"ل",1,0],["أَنتَ فيها الجَوادُ إِن كانَ غُزرٌ","أَو جُمودٌ فَأَنتَ فيها البَخيلُ",52,"ل",1,0],["أَنتَ فَردٌ فُتُوَّةً وَفَتاءً","لَيسَ كُلُّ الفِتيانِ بِالفِتيانِ",53,"ن",1,0],["أَنتَ في دارٍ تَرى المَوتَ فيها","مُستَشيطاً قَد أَذَلَّ الرِقابا",54,"ب",2,0],["أنت فجر من جمال وصبا","كل فجر طالع ذكَّرنيه",55,"ه",1,0],["أنتِ في جنّةٍ وروضِ نعيمٍ","لم يَسِمْ أرْضها السحابُ بوسم",56,"م",1,0],["أنت في الودّ لي شقيقُ وفاءٍ","ومصابي إلى مصابك يَنْمي",56,"ي",1,0],["أَنتِ في العينِ وَاللِّسانِ وَفي القل","بِ فَأَينَ استَقَرَّ قَدريَ مِنكِ",57,"ك",1,0],["أَنتَ في حِلٍّ فَزِدني سَقَما","أَفنِ صَبري وَاِجعَلِ الدَمعَ دَما",58,"م",2,1],["إِن تُفارِق لَحظي فَقَد كانَ مِنها","وَهوَ في كُلِّ ساعَتَينِ عَروسُ",59,"س",1,0],["أَنتَ فينا في ذا الأَوانِ غَريبٌ","وَهوَ فينا في كُلِّ وَقتٍ غَريبُ",60,"ب",1,0],["أَنتِ في الجَوهَرِ المُهَذَّبِ مِن تَي","مٍ ذُرى المَجدِ بَينَ خالٍ وَعَمِّ",61,"م",1,0],["أَنتَ في القَولِ عازِفٌ مِن هَوى النَف","سِ إِلَينا في الطَرفِ حينَ نَراكا",62,"ك",2,0],["أَنتِ في وُدِّ بَينِنا","خَيرُ ما عِندِنا يَدا",63,"د",2,0],["أنتِ في شأنكِ إذ تبغينه","وهي في همٍّ وغمٍّ وأنينْ",64,"ن",1,0],["أَن تَفوقي الشَمس مَجداً وَعُلا","وَعلي العَه