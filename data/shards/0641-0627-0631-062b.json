{"poems":[[50,"لله طيف سرى فأرقني","https://www.aldiwan.net/poem66127.html","المنسرح"],[52,"طرب الحمام فهاج لي طربا","https://www.aldiwan.net/poem64861.html","الكامل"],[295,"يا منية القلب الكسير","https://www.aldiwan.net/poem11708.html","مجزوء الكامل"],[411,"إلى الله أشكو اتصال الخطوب","https://www.aldiwan.net/poem50066.html","المتقارب"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108462","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91855","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73425","الخفيف"],[5309,"سألوه ما انتاجك المشهور","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573909",""]],"verses":[["فَاِرثِ لِمَن قَد تَرَكتَهُ كَمِداً","وَاِمنُن بِوَصلٍ عَلَيهِ يا سَكَني",0,"ن",2,0],["فَاِرثي لَهُ مِمّا تَضَمَّنَهُ","مِن حَرِّ حُبِّكُمُ فَقَد نَشِبا",1,"ب",2,0],["فارثي لقلب مولع","كان الوفاء إليك دينَه",2,"ن",2,0],["فارْثِ لِذي حِكمةٍ وإرْبٍ","فحظُّهُ غُمَّةٌ وكَرْبُ",3,"ب",1,0],["فارثوا لي يا معشر الناس من ض","ري ومن طول عطلتي وامتحاني",4,"ن",2,0],["فارثِ من نابها الحمام اغتيالا","ولها في الحياة خير فعال",5,"ل",1,0],["فَأَرثه بَعد أَيام الهَناء بِهِ","وَاجعل مدادَك ثَوبَ الحزنِ للقلم",6,"م",1,0],["فأرث بالسهل ناراً ذكت","بأشلاءهم أولاً فتكت",7,"ت",1,0],["فارثِ للَعبدِ من مَصيف صِفاعٍ","يا رَبيعَ النَّدى وإِلاَّخَري في",8,"ي",1,0],["فَارثِ البِلادَ إِذا مَجامِعُها خَلَت","مِن مُنتِجينَ جَديدُهُم مَأَثورُ",9,"ر",1,0]]}