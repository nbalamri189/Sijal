"خمسة عشر ماتوا علشان صندق","https://www.poetsgate.com/ViewPoem.aspx?id=53364",""],[5848,"المعقول واللا معقول","https://www.poetsgate.com/ViewPoem.aspx?id=53187",""],[5848,"يادنيا من أنتي له","https://www.poetsgate.com/ViewPoem.aspx?id=51938",""],[5894,"بدت مبرقعة في حسنها العربي","https://www.poetsgate.com/ViewPoem.aspx?id=131411",""],[5908,"لي لا لغيري آلت نوبة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=170970",""],[5952,"غنائي ندائي","https://www.poetsgate.com/ViewPoem.aspx?id=205982",""],[5956,"بديل الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=183217",""],[5956,"رشقتُ الناس بالدمعات عِشْقاً","https://www.poetsgate.com/ViewPoem.aspx?id=183706",""],[5956,"الفرق بين العربي وغيره","https://www.poetsgate.com/ViewPoem.aspx?id=192190",""],[5956,"فاسد يشجع على عقوق الوالدين","https://www.poetsgate.com/ViewPoem.aspx?id=193421",""],[5976,"شياطين الفضا","https://www.poetsgate.com/ViewPoem.aspx?id=32795",""],[6008,"مهداه إلى الإمير نواف بن فواز الشعلان","https://www.poetsgate.com/ViewPoem.aspx?id=60802",""],[6082,"كنّا صغارا","https://www.poetsgate.com/ViewPoem.aspx?id=61277",""],[6142,"بديع كون تحلى بالوجود طلى","https://www.poetsgate.com/ViewPoem.aspx?id=155673",""],[520,"هي البدر بل من سنة البدر املح","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577465",""],[6229,"بين يدي الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65210&r=&rc=33",""],[4035,"تبسٌم كالبرق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1523&r=&rc=6",""],[463,"تموق الليالي فيكمُ ثم تعقلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60290&r=&rc=346",""]],"verses":[["بَديعاً كَرَوضٍ حالَفَتهُ يَدُ الحَيا","فَما أَقلَعَت حَتّى اِستَنارَت كَواكِبُه",0,"ب",2,0],["بديوان عشر الشام هل بالتقى أخ","فقلت ولا تلقى من العشرِ واحدا",1,"د",2,0],["بديهيّ المواهب يوم جود","إذا روَّى الورَى وهَبَ ارْتجالا",2,"ل",2,0],["بديمومةٍ لا صلَّ في صحصحانِها","ولا ماءَ لكنْ قورُها الدهرَ عُوَّمُ",3,"م",1,0],["بِدَيمومَةٍ ما إِن تَكادُ تَرى بِها","مِنَ الظَمَأِ الكَومَ الجِلادَ تُنَوَّلُ",4,"ل",1,0],["بَديعَةُ حُسنٍ رَقَّ مِنها شَمائِلٌ","وَراقَت إِلى أَن كادَ يَشرَبُها الطَرفُ",5,"ف",1,0],["بديعةٌ جِسمُها زَبَرْجدةٌ","خضراءُ يُخْفي جمالَها الحُجُبُ",6,"ب",1,1],["بَديعُ حُسنٍ رَشيقُ قَدٍّ","مَليحُ خَدٍّ نَقِيُّ ثَغرِ",7,"ر",1,0],["بَديعُ الحُسنِ قَد أُلِّفَ","مِن شَمسٍ وَمِن بَدرِ",8,"ر",1,0],["بَديعُ الحُسنِ تَعشَقُهُ حَلاهُ","أَحَتّى الحُسنُ يَعشَقُ أَو يَميلُ",9,"ل",1,0],["بِدَيِنِكَ رَبّاً لَيسَ رَبٌّ كَمِثلِهِ","وَتَركُكَ أَوثانَ الطَواغي كَما هِيا",10,"ي",2,0],["بِدَيرِ المَطيرَةِ نُقرى المُدا","مَ لَدى القَسِّ لَمّا أَتَيناهُ زَورا",11,"ر",2,0],["بَديعُ الخَلقِ مَوفورُ الخُطوطِ","لَطيفُ الخَصرِ كَالفَرَسِ الرَبيطِ",12,"ط",1,1],["بِدَيرِ بَهرَذانَ لي مَجلِسٌ","وَمَلعَبٌ وَسطَ بَساتينِهِ",13,"ن",2,1],["بَديعُ شَكلٍ غَريبُ حُسنٍ","أَعوَزَهُ المِثلُ وَالقَرينُ",14,"ن",1,0],["بَدِيعةٌ أحْكم في تَدْبيرها","بالوَتِد المَفْروق في شطورها",15,"ه",2,0],["بُدِئتْ نَهْضَةُ البِلادِ وَفِيهَا","مِنْ سَمَاءِ الرَّجَاءِ بَرْقٌ يُشَامُ",16,"م",1,0],["بديعٌ أَنْ تَكُونِيَها وتُكْسَى","بما نَسجَتْ وزَانَتْ من ثِيَابِ",17,"ب",1,0],["بِدِيبَاجَةٍ مِنْ خُيوطِ الغَمَامِ","تَخَلَّلَهَا كُلُّ شَيءٍ عَجَبْ",18,"ب",1,1],["بَدِيعُكَ أَزْرَى بعبد الحميد","وبابن العَمِيدِ وبالصاحبِ",19,"ب",1,0],["بديعةُ الحسنِ بالأضحى تهنيني","تزهو بحسن علا من غير تزيين",20,"ن",1,1],["بَديعُ السَجايا فَهوَ بَذلٌ وَلا أَذى","وَمَنُّ وَلا مَنٌّ وَصَفحٌ وَلا عَتبُ",21,"ب",1,0],["بَدِيعٌ ذَابَ مِنْ نَظَرِي إِلَيْهِ","وَذُبْتُ صَبَابَةً أَبَداً عَلَيْهِ",22,"ه",1,1],["بديعةٌ أَوصافها رحيبةٌ","أكنافها نِعَم مقرُّ المستقر",23,"ر",1,0],["بديع مَلاحاتٍ يذوب من اللَّمسِ","تكبَّر أن يُدعى الى صورة الإنسِ",24,"س",1,1],["بديع حُسنٍ غريب وصفٍ","بلا مثالٍ ولا نظيرِ",25,"ر",1,1],["بديع حُسنٍ وخَلقٍ","في شَكل ظَرف القِيانِ",26,"ن",1,0],["بديع مَلاحاتٍ بمقلته حتفي","تكوَّن من نورٍ يجلُّ عن الوَصفِ",27,"ف",1,1],["بديعة حسن راق ماء انسجامها","وقد جل قدرا حسنها ان يمثلا",28,"ل",2,0],["بديع حسن رقيق الخد وجنته","كالروض ما بين تدبيج وتفويف",29,"ف",1,0],["بديعة الحسن ما قد كان اقربها","بعيدة الوصل لا تلوي على احد",30,"د",1,0],["بديرها قهوة بكراً معتقة","في الكاس قد حدثت عن عصرها الحقب",31,"ب",1,0],["بديعة أوصاف عليك ثناؤها","من الزرد المنظوم درع ممنع",32,"ع",1,0],["بِدَير عيسى هل عائد زمنٌ","مَضى بِقَلّابَةِ اشبنِ شَمعونِ",33,"ن",1,0],["بَديعُ التَثَنّي راحَ قَلبي أَسيرُهُ","عَلى أَنَّ دَمعي في الغَرامِ طَليقُهُ",34,"ق",2,0],["بديهتي في الخصام حاضرها","أشهر في الفيلقين من علم",35,"م",1,0],["بَدِيهَتُهُ فيما يُدارُ مُلِمَّةٌ","بِإِبطَالِ مَا أَمْلَى سِواهُ وَمَا رَوَّى",36,"و",2,0],["بَديلٌ في الخلائِق لِلْبَرايا","وَشَأْوُ عُلاهُ ما منْهُ بَديلُ",37,"ل",1,0],["بَدِيهَهُ رَأْيٍ فِي رَوِيَّةِ سُؤْدَدِ","وَإِقْدامُ عَزْمٍ فِي تَأَيُّدِ ذِي حَزْمِ",38,"م",1,0],["بَديعُ الحُسنِ وَالإِحسانُ مِنهُ","بَعيدٌ وَصلُهُ صَعبُ المَنالِ",39,"ل",1,0],["بَديعةُ الأَلفاظِ","تَسهُلُ للحُفّاظِ",40,"ظ",1,0],["بَديعَ خَلقٍ صَوَّرَهُ","نَفيسَ نَفسٍ فَرادى الحُسنَ جُملَتُهُ",41,"ت",2,0],["بَديهَتُهُ وَفِكرَتُهُ سَواءٌ","إِذا ما نابَهُ الخَطبُ الكَبيرُ",42,"ر",1,0],["بُدِئَت بالقبلات وانتهت بالقبلات","بارك اللَه صداها ولها كانت حياتي",43,"ي",1,0],["بديعة هذا الجمال البديع","وهذا الشباب القوي المتين",44,"ن",1,0],["بديعة آه أبنتِ الخفي","فزدهت الهموم وزدت الشجون",44,"ن",1,0],["بديعة جئت لانسى حياتي","حياة الشؤون التي تذرفين",44,"ن",1,0],["بديعة كوني كما اشتهيك","فتاة الخيال فتاة الفنون",44,"ن",1,0],["بديعة انت التي هام فيك","كبار الانام وهام البنون",44,"ن",1,0],["بَديعَةُ حُسنٍ دَقَّ مَعنى جَمالِها","وَعَنها بَدَت كُلُّ المَعاني الدَقيقَةِ",45,"ه",1,0],["بُدّي الَّذي ما عَنهُ لي بُدٌّ وَيَز","داني الَّذي بِنارِهِ قَلبي اِستَعَر",46,"ر",1,0],["بَديع جَمال لَو ضَلَلت عَن الهَوى","أَراني مَتى عاينتُ مِنهُ سَناً سَنَن",47,"ن",1,0],["بَديع قَد تَصرَّف بِالمَعاني","وَسادَ فَشاد أَبنية المَعالي",48,"ل",2,0],["بَديع في البَديع له مَعان","يَكادُ بَيانُها كَالزَنديوري",49,"ر",2,0],["بديعةً تَتلقّاها الرُّواةُ لها","حيثُ انتهَتْ من عِراقٍ أو خُراسان",50,"ن",1,0],["بديعُ أساليبِ الكلامِ مُسلِّمٌ","له بالمعاني والمعالي التَّفرُّد",51,"د",1,0],["بديعِ معاني المشكلات دقيقها","رفيعِ بناء المكرُمات جليله",52,"ل",2,0],["بديار روما كان ما","أمَّلته وبها وضوحه",53,"ح",2,0],["بَديعٌ فَلَم يُطبَع عَلى الدَهر مِثلُهُ","وَلا ضُرِبَت أَضرابُهُ لِسَراتِه",54,"ت",2,0],["بديع السموات العلي خالق الملا","ورازقهم من غير كدِّ ولا جهد",55,"د",1,0],["بدينهم ذلّ اهل الشرك قاطبةً","حقّا وحطّمتِ الصلبان والبيعُ",56,"ع",1,0],["بديهتي قد جرت مجرى دمائهم","بين العروق وبين الجلد والعصب",57,"ب",1,0],["بديار حسنكم أطوف ملبيا","داعى الغرام وعن سواكم يحرم",58,"م",1,0],["بديعة حسناء فكري لها","ظِئرٌ وفي صدري رَبَتْ ناشيا",59,"ي",2,0],["بدينكما هل في فخارٍ سمعتما","به الذكُر يُروَى والأحاديثُ تُنقَلُ",60,"ل",1,0],["بدينك بعد ما انفرق الجميعُ","أتصبر أم يروعك ما يروعُ",61,"ع",1,1],["بدِين الهوى إِن صحَّ عَقدُك في الهوى","أعن ملَلٍ في الهجر أم كاشحٍ أَغرَى",62,"ر",2,1],["بَديعُ الجَمالِ رَخيمُ الدَلالِ","صَوارِمُ أَلحاظِهِ مُرهَفَه",63,"ه",1,1],["بديعية النوع في لطفها","تحاكي النسيم وما عطفا",64,"ف",2,0],["بديع زمان نور لطف جماله","تحجب في سر التعشعشع واغتشا",65,"ش",2,0],["بُدِئَ النّدى منه فأفعالُ السّخا","عن غيرِ مصدرِ ذاته لم تَصْدُرِ",66,"ر",1,0],["بديهته تذري بكل روية","وتبدي عوار المحسنين وتفضح",67,"ح",1,0],["بديعة حسن تنجلي في ملابس","وقد شاقني منها الطلى والنغانغ",68,"غ",1,0],["بديعُ خُلقٍ بديعُ القولِ جاهِرُهُ","بالحقِّ يُوِقعُ جَهْدَ الخصمِ بالبَكَمِ",69,"م",1,0],["بديعةُ النَّظمِ خُطَّتْ بالمِدادِ ولو","أصابَ كاتِبُها أجرَى لها الذَهَبا",70,"ب",2,0],["بَدِيهُ رأيٍ من وَقارٍ بهِ","يأبى ابتِدارَ القولِ بالمُوجَبِ",71,"ب",1,0],["بديعُ لُطفٍ كنسيم الصَبَا","يُهدِي الرُبى عَرْفَ الكِبا الطيّبِ",71,"ب",1,0],["بَدِيْعُ مَلاَحَةٍ يُدْعَى نَجَاحاً","وَلَكِنْ ما لِمَوْعِدِهِ نَجَاحُ",72,"ح",1,0],["بديعةٌ في نَسْجِهَا مِثْلُها","يُفْقَدُ من يُحْسِنُ أَنْ يَنْسِجَهْ",73,"ج",2,0],["بديعُ المقالِ رفيعُ المَقامِ","وما رفعَ اللهُ لَن يُخْفَضَا",74,"ض",2,0],["بديارِي عَشِقْتُ لم أَنْدبُ الرَّب","عَ ذُهولاً ولا سَأَلْتُ الدِّيَارا",75,"ر",2,0],["بَدى طالعاً في سماء العلا","كبدرٍ دجى نوره قد زهَر",76,"ر",1,0],["بدينارٍ وما يَحوي سواهُ","وما كلُّ الأفاضلِ مُؤثِرينا",77,"ن",2,0],["بدينارٍ من الحَبِّ","فلم يَندم ولم يَخسرْ",78,"ر",1,0],["بديعةُ النظمِ قد أبدت لنا غُرَراً","في شعرِها من جميلِ اللطفِ والأدبِ",79,"ب",1,0],["بديعةٌ قد حَوَت حُسن البيان بما","أَبدتهُ من كلّ معنىً رائِقٍ عَدِبِ",80,"ب",1,0],["بديعَ نظمٍ سما من وردةٍ عَبِقَت","فاحت روائحها في العلمِ والأدبِ",81,"ب",1,0],["بديعةُ منظرٍ سلبت فُؤَادي","ومَن لي أَن أطالبها بسلبي",82,"ب",2,0],["بَديع الثَنا يُهدَى إِلى الصَدر شاهينِ","بِنظمٍ تَحلَّى مِنهُ جَيدُ الدواوينِ",83,"ن",1,1],["بَديع صِفات فيهِ قلّ اِجتِماعُها","بِقائد جَيش النَصر في الغَزوات",84,"ت",1,0],["بَديع صِفات فيهِ يَنقلُ بَعضَها","لَنا عَدلُه الشافي بِنَص ثقات",84,"ت",1,0],["بدينوريِّ العارفين محمدٍ","وَبالسالكِ البكريْ سميِّ رَسولِنا",85,"ن",2,0],["بدين الوَفا لا أَبعد اللَه عهده","عِدوا بعد هَذا العتب قَلبي بإعتابِ",86,"ب",1,0],["بدين الهَوى هَل تَذكُرونَ لَيالياً","لَنا سلَفَت لَم نَخشَ سَعي الحَواسدِ",87,"د",1,0],["بديعة حسن ينحني الغصن خجلة","اذا ما انثنت في قامة ألفية",88,"ه",1,0],["بديهتُه تغنيهِ في كلّ مشكلٍ","وإن حنّكتهُ في الأمورِ تجاربُه",89,"ب",2,0],["بديعة حسن قد توشح لفظها","بحلة سحار وحلية ناجم",90,"م",1,0],["بَديعَ الحُسنِ لا تُعرِضْ فَطرفي","إِلَيكَ لِحبّهِ راءٍ وَناظِر",91,"ر",1,1],["بَديعةُ حُسنٍ إِنّما الشّمسُ وَجهها","بِرُمحِ قَوامٍ أَثخَنَ القلبَ بالجرحِ",92,"ح",1,0],["بَديع الخِطابِ سَريع الجَواب","بِسلكِ الصّوابِ تَراهُ اِنتَظمْ",93,"م",1,0],["بَديع الزّمانِ بَليغ الأَوان","لَآلي الجُمانِ بِعقد نظمْ",93,"م",1,0],["بَديعَة حسنٍ فاقَتِ الشّمسَ في الضّحى","فَمَن قاسَها بِالشّمسِ زَلَّ وَقَد أَخطا",94,"ط",2,0],["بَديعة قَدٍّ لا طَويل مُمعَّط","وَلَيسَ قَصيراً بَل هيَ الربعةُ الوُسطى",94,"ط",2,0],["بديوانٍ لقد أزرى","بديوان الفتى البَصْرِي",95,"ر",2,0],["بديعة شكل لم ترَ العين مثلها","لها في مقامات الجمال مشاهدُ",96,"د",1,0],["بديع الفصل كشاف القضايا","سريع العدل ذو نفع وضرِّ",97,"ر",1,0],["بديع فضل عرب","يٍّ قد نَماهُ أحمدُ",98,"د",1,0],["بديع المحاسن قد صاغه","فأبدع ما شاء صواغه",99,"غ",2,0],["بِدينِ أَميرِ المُؤمِنينَ وَرَأيُهُ","نُدينُ وَنَنفي الشَكَّ وَالشُبُهاتِ",100,"ت",1,0],["بديعُ الشيخ جنةُ من يريد","فريدٌ والبديع له فري