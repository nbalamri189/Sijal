حينٍ هِيَ في القَلبِ تَجي",133,"ي",1,0],["وَلَها مَحَلٌّ طَيِّبٌ تَقرو بِهِ","بَقلِ التِلاعِ بِحافَتَي عَمّانِ",134,"ن",1,0],["وَلَهُ الحُكمُ عَلى رَغمِ العِدى","لا نُبالي سُخطَ مَن فيهِ رَغَم",135,"م",1,0],["وَلَها بِأَعلى الخَيفِ مَنزِلَةٌ","هاجَت لَهُ شَوقاً فَما صَبَرا",136,"ر",2,0],["وَلَها أَثيثٌ كَالكُرومِ مُذَيَّلٌ","حَسنُ الغَدائِرِ حالِكٌ مَضفورُ",137,"ر",1,0],["وَلَها عَينانِ في طَرفَيهِما","حَوَرٌ مِنها وَفي الجيدِ غَيَد",138,"د",1,0],["وَلَها حِلَّةٌ مِنَ العَيشِ ما في","ها لِمَن يَبتَغي المَلاحَةَ عَتبُ",139,"ب",1,0],["وَلَهَوتُ فيهِ بِدُرَّةٍ","مَكنونَةٍ في حُقَّ خِدرِك",140,"ك",1,0],["ولهم في كلّ جيلٍ أدبُ","عبقريُّ الذّكرِ رَنّانُ الخَبَرْ",141,"ر",1,0],["وَلهى مِنَ الذُعرِ يَدعو في أَواخِرَها","سَعدٌ وَتَدعو عَلى سَعدٍ أَواليها",142,"ي",3,0],["وَلَهَت أَتَطلُبُ أَم تَموتُ كَريمَةً","ما عابَها طَلَبٌ وَلا اِستِمناحُ",143,"ح",1,0],["وَلِهٌ يَحِنُّ إِلى كَلامِكَ سَمعُهُ","وَلَو أَنَّهُ عَتبٌ تُشَبُّ حُروبُهُ",144,"ب",2,0],["وَلَهُ مُديَةٌ تُخايَلُ في اللَحمِ","حَذامٌ حَنِيَّةٌ كالهِلالِ",145,"ل",1,0],["وَلَهُ الدينُ واصِباً وَلَهُ المُلكُ","وَحَمدٌ لَهُ عَلى كُلِّ حالِ",145,"ل",1,0],["وَلَهُ كُلَّما تَغَلغَلَ في الأَر","ضِ فِراشٌ مِنَ التُرابِ وَطِيُّ",146,"ي",1,0],["وَلَهَوتُ مِن لَهوِ النُفوسِ بِغادَةٍ","تَحكي بِنَغمَتِها الحَمامَ المولَها",147,"ه",2,0],["وَلَهُ إِذا ما قَصَّرَ اللَيلُ الكَرى","لَيلٌ طَويلُ العُمرِ aلَيسَ لَهُ يَدُ",148,"د",1,0],["وَلَها سَهمٌ إِذا","قَرَحَ الصَرحَ قَدَح",149,"ح",1,0],["وَلَهُ مِن رَأيِهِ عَزَماتٌ","وَصَلَ اللَهُ ضِمنَهُنَّ نَجاحا",150,"ح",2,0],["وَلَهُم وِراثَةُ كُلِّ مَكرُمَةٍ","وَبِهِم تُعَلِّقُ دَعوَةُ الكَربِ",151,"ب",1,0],["وَله مِنْ قَابِ قَوْسَينِ ما شَر","رَفَ قَوْسَيْنِ بذكْرٍ وَقابا",152,"ب",2,0],["ولهُ سرائرُ في العُلا خَطَّارَةٌ","خَطَّارُها ورِكابُها لم تُشْدَدِ",153,"د",1,0],["وَلهُمْ أَعْيُنٌ تَغُضُّ عَنْ","العَيْنِ وَأيْدٍ تُمَدُّ عِنْدَ الغِلالِ",154,"ل",1,0],["ولهنّ من ورَق اللجيَنِ تَوَجُّسٌ","ولهنّ من مُقَلِ الظّباء شُفون",155,"ن",1,0],["وَلَها وَلا ذَنبَ لَها","لَحظٌ كَأَطرافِ الرِماحِ",156,"ح",1,0],["وَلَهُ بِدَورِ الكَأسِ كُلَّ عَشِيَّةٍ","حالانِ مَوتٌ تارَةً وَنُشورُ",157,"ر",1,0],["وَلَهوٍ لِتَأنيبِ الإِمامِ تَرَكتُهُ","وَفيهِ لِلاهٍ مَنظَرٌ وَسَماعُ",158,"ع",1,0],["وَلَهُ في الماءِ أَيضاً","عَمَلٌ أَبدَعَ ظَرفا",159,"ف",2,0],["وَلَها دَبيبٌ في العِظامِ كَأَنَّهُ","قَبضُ النُعاسِ وَأَخذُهُ بِالمِفصَلِ",160,"ل",1,0],["وَلَها ثَغرٌ كَأَنَّ ال","لاهَ غَشّاهُ بِكُحلِ",161,"ل",1,0],["وَلَهُم مِن جَناهُ آذَرِيونٌ","وَضَعوهُ مَواضِعَ الأَقلامِ",162,"م",1,0],["وَلَها خَدٌّ أَسيلٌ","مِثلُ خَدِّ الشَيفَراني",163,"ن",2,0],["وَلَها مَضحَكٌ كَغُرِّ الأَقاحي","وَحَديثٌ كَالوَشيِ وَشيِ البُرودِ",164,"د",1,0],["وَلَها عَينٌ وَثَغرٌ","مِن كِبارِ الفَتَناتِ",165,"ت",1,0],["وَلَهُ مِن نَدى قَبيصَةَ بَحرٌ","حَضرَمِيٌّ لِجانِبَيهِ عُبابُ",166,"ب",1,0],["وَلَها وارِدُ الغَدائِرِ كَالكَر","مِ سَواداً قَد حانَ مِنهُ اِنتِهاءُ",167,"ا",2,0],["وَلَهُنَّ بِالتَعظيمِ في خَلَدي","أَولى وَأَجدَرُ مِن بَني فِهرِ",168,"ر",1,0],["وَلِهَذي الراحِ ريحٌ عَصَفَت","بِهَشيمِ اللُبّبِ في ريحٍ وَصِر",169,"ر",1,0],["وَلَها هُمومٌ بِالنُفوسِ لَوابِقٌ","وَسُرورُها بِصُدورِنا لا يَلبَقُ",170,"ق",1,0],["وَلَها كَشحا مَهاةٍ مُطفِلٍ","تَقتَري بِالرَملِ أَفنانَ الزَهَر",171,"ر",1,0],["وَلَهوَةٍ كَرُضابِ المِسكِ طالَ بِها","في دَنِّها كَرُّ حَولٍ بَعدَ أَحوالِ",172,"ل",1,0],["وَلَهُم سِيما إِذا تُبصِرُهُم","بَيَّنَت رِيبَةَ مَن كانَ سَأَل",173,"ل",1,0],["ولهُ اسمٌ حُرُوفُهُ مُبْتَدَاها","مُبْتَدَا أصلِهِ الذي كانَ مأوَى",174,"و",2,0],["ولهم فيها نعمةٌ بعد أخرى","ولهم فيها لذةٌ وسرور",175,"ر",1,0],["ولها من بعد الزفير شهيقٌ","ولها من بعد الشهيق زفير",175,"ر",1,0],["ولهم فيها كل يوم عذابٌ","ولهم فيها كلَّ يوم ثبور",175,"ر",1,0],["ولهم من غيظٍ تأجَّجَ فيهم","نظراتٌ شَرارُها مستطير",175,"ر",1,0],["وَله جراءة فَيلَسو","ف يوسع الأديان جحدا",176,"د",2,0],["وَلَه في جَداول الروض رقص","فوق سطح الماء الزلال الجاري",177,"ر",2,0],["وَلَها في حجابها نظرات","يا لَها في الحجاب من نظرات",178,"ت",1,0],["وَله بمستنّ الطَري","ق لحاجة فيه دَبيب",179,"ب",1,0],["وَلَها حول نفسها دوران","هُوَ داعي صباحها وَالمساء",180,"ا",2,0],["وَلهون بالأزهار إعجاباً بها","وَجهلن ما أَخفت يد الحدثان",181,"ن",1,0],["وَلَها توابع جمَّة","كلّ مغذٌّ في مدار",182,"ر",1,0],["وَلَهُ حَوافِرُ موثَقٌ تَركيبُها","صُمُّ النُسورِ كَأَنَّها مِن جَندَلِ",183,"ل",1,0],["وَلهُ النَّعَجةُ الَمرِيُّ تُجاهَ ال","رَّكبِ عِدلاً بِالنَّابئ الِمخراقِ",184,"ق",1,0],["وَلَهِي عَلَيكِ مُصاحِبٌ لِمَسِيرَتِي","وَالدَّمْعُ فِيكِ مُلازِمٌ لِوِسَادِي",185,"ي",1,0],["وَلَهَا ذَوَائِبُ مُرْسَلا","تٌ لِلْكَرَائِهِ وَالزِّيَمْ",186,"م",1,0],["وَلَهُ فِي تَالِدِ المَجْدِ","وَفِي الطارِفِ سَهْمُ",187,"م",1,0],["وَلَهُ القَدَحُ المُعَلَّى","وَلَهُ الذِّكْرُ الأَعَمُّ",187,"م",1,0],["وَلَهُ فِي بَيَانِهِ","غِرَر كلهَا طُرُفْ",188,"ف",1,0],["وَلَهَا قَوَامٌ إِنْ تَأَوَّدَ خَاطِراً","أَزْرَى بِتَأْوِيدْ الْقنا الخَطَّارِ",189,"ر",1,0],["وَلِهَذَا آثرْتَ أَجْمَلَ مَا يؤْ","ثِرُ أَهْلُ التقى مِنَ الاجْوَادِ",190,"د",1,0],["وَلَهَا إِذَا الْتَبَسَتْ وُجُوهُ","الْرَأْي رَأْيٌ يُسْتَحَدْ",191,"د",1,0],["وَلَهَا أَنَّاتُ نَوْحٍ حَيْثُمَا","بَلَغَتْ سَامِعَةَ الْقَلْبِ أَلاَنَتْ",192,"ت",1,0],["وَلَهُ مَواهِبُهُ العِدَادُ فَجَلَّ مَنْ","أَعْطَاهُ مَا أعْطَى بِغَيْرِ حِسَابِ",193,"ب",1,0],["وَلَهُمْ فِي الذَّوْدِ عَنْ أَوْطَانِهِمْ","وَقَفَاتُ الصَّابرِينَ البُسَلاءْ",194,"ا",2,0],["وَلَهُمْ مَا شَهِدَ الْخَلْقُ بِهِ","مِنْ ذَكَاءٍ وَثَبَاتٍ وَمَضَاءْ",194,"ا",2,0],["وَلَهُ مُروُءَاتٌ تُجَابُ بِذِكْرِهَا","جَوْبَ الرِّياضِ مَجَادِبُ البَيْدَاءِ",195,"ا",2,0],["وَلَهُ فَضَائِلُ إنْ تَحَدَّثَ عَارِفٌ","عَنْهَا عَرَتْهُ نَشْوَةُ الصَّهْبَاءِ",195,"ا",2,0],["وَلَهُ وَقَائِعُ فِي البَسَالَةِ يَزْدَهِي","بِصِغارِهِنَّ أَكَابِرُ البُسَلاَءِ",195,"ا",2,0],["وَلَهُ طَرَائِفُ فِي السَّمَاحَةِ نَقَّحَتْ","مَا أَخْطَأَتْهُ طَرَائِقُ السُّمَحَاءِ",195,"ا",2,0],["وِلْهِلمُ يَا مَنْ رَمَى طَيْشاً بِأُمَّتِهِ","مَرْمَى الْفَنَاءِ وَبِئْسَ الْحَوْضُ مَا تَرِدُ",196,"د",1,0],["وَلَهُ سَامِعَتَا مَنْ لَمْ يَثِقْ","وَلَهُ بَاصِرَتا مَنْ قَلَّ مَكْرَا",197,"ر",2,0],["وَلَهُ فِي التَّجِلَّةِ الرِّتبَةُ العُلْيَا","وَيَزْدَادُ قَدْرُهَا بِالوِدَادِ",198,"د",1,0],["وَلَهُ فِي سِيَاسَةِ النَّاسِ وَحْيٌ","شَفَّ عَنْ رَأْي حَاذِقٍ نَقَّادِ",198,"د",1,0],["وَلَهُ فِي النَّوَالِ مُبْتَكَرَاتٌ","شَمِلَتْ كُلَّ نَاطِقٍ بِالضَّادِ",198,"د",1,0],["وَلَهُ في الذَّمَاءِ أَيُّ رَجَاءٍ","وَلَهُ بالْبَقَاءِ أَيُّ اعْتدَادِ",198,"د",1,0],["وَلِهَذَا عِنَايَةُ الله صَانَتْ","قَلْبَ ذَاكَ المُغَامِرِ الصَّنْديدِ",199,"د",1,0],["وَلَهُ فِي الْنَّدَى وَفِي الرِّفْقِ ما حَبَّ","بَ أَخْلاَقَهُ إِلَى الْخَلْقِ جِدَّا",200,"د",2,0],["وَلَهُ مِنْ بِدَائِعِ الْفِكْ","رِ مَا قَلمَا سَنَحْ",201,"ح",1,0],["وَلَهُ الْحَقُّ إِنَّ فِي النَّفْسِ لا فِي","قَوْلِ مُثْنِ حَقِيقَةَ الْعَلْيَاءِ",202,"ا",2,0],["وَلَها رائِحَةُ المِسكِ فَإِن","شَمَّها الشارِبُ مِن كَأسٍ عَبَس",203,"س",1,0],["وله سلطانه في الملل","حلم القيصر أن يرفعها",204,"ه",2,0],["وله حديث كالدموع اذا جرت","جلبت نظائرها من الأجفان",205,"ن",1,0],["ولها زرقةُ ماء الجدول","والسما الزرقاء",206,"ا",2,0],["وله في المديح ما لم يُداني","ه ابنُ عَبْدانَ في بني حَمْدان",207,"ن",1,0],["ولها في سمائِها خَفَقاتٌ","أسرعتْ في فؤادِه خَفَقاته",208,"ت",2,0],["ولها مَدارٌ من فَضَاءٍ مُبْهَمٍ","ولَكَ العُلاَ والمَكْرُمَاتُ مَدَار",209,"ر",1,0],["ولهم نفوسٌ صافياتٌ صفْوَ ما","بقرارِه من لُؤْلُؤٍ وتُؤَامِ",210,"م",1,0],["وله كانت الملوكُ عبيدا","وبناتُ الملوكِ كانت قِيَانا؟",211,"ن",2,0],["وله من قاب قوسين ما شر","ف قوسين بذكر وقابا",212,"ب",2,0],["ولهم في الغرامِ أَكْثَر ممّّا","لسواهمْ مضايقٌ ودروب",213,"ب",1,0],["ولها في العُروقِ نبضٌ خفيٌ","مثلما يُمسك الطبيبُ المِجَسا",214,"س",2,0],["ولَهَا عَلَيْنَا في مُوافَقَةِ اسْمِها","حَقٌّ جَدِيدٌ رِعْيَةَ اسْمِ شَمَالِ",215,"ل",1,0],["ولهفة الدّين على سيّد","كان يرّجى في الخطوب الجسام",216,"م",1,0],["وله تضحك البروق","ويبكي الحبا السجام",217,"م",1,0],["ولها في كلّ باب وقفة","كأمرىء القيس حيال الطلل",218,"ل",1,0],["وَلهُ عن الباطلِ غيرِ الحاصل","زايلَ عهدُ الظاعن المُزائل",219,"ل",1,0],["ولهَانتْ على امرىء ٍ أخْطأتْه","شكَّة السهم صكَّة المعراض",220,"ض",1,0],["ولهم أُسيى متقدماتٌ جمَّة ٌ","لكن أحبَّ القوْم أن يزدادوا",221,"د",3,0],["وله إخوة شاءهم إلى المَجْ","د وإن هم شاؤوه بالأسنان",222,"ن",1,0],["ولها أن راقبتها من قريب","حسنات ومثلها سيئات",223,"ت",1,0],["ولها مَدارٌ من قضَاءٍ مُبْهَمٍ","ولَكَ العُلاَ والمَكْرُمَاتُ مَدَار",224,"ر",1,0],["وَلَهَ أَثيثٌ كالْكُرومِ مُذَيَّلٌ","حَسَنُ الغَدَائِرِ حَالِكٌ مَضْفُورُ",225,"ر",1,0],["وله فروع أصلهنَّ لشارع الْ","الكبش المجاري منه منتهيات",226,"ت",1,0]]}