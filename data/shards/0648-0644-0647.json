://www.aldiwan.net/poem21814.html","الرمل"],[68,"أي شيء حلو إذا قلبوه","https://www.aldiwan.net/poem1559.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85417","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85578","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85647","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85432","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9873","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21072","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55035","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54831","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54755","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54707","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54655","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54571","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54527","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54511","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54734","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54690","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54522","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/3821","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141992","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54242","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[106,"أسطول معاوية","https://www.poetsgate.com/ViewPoem.aspx?id=179631",""],[106,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[67,"أزمعوا البين وشدوا الركابا","https://www.poetsgate.com/ViewPoem.aspx?id=3141",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[45,"رِيحُ الشَّمَالِ أَتَتْ بِرِيحِ شَمَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=32100",""],[91,"أفاتحة أم ختام","https://www.poetsgate.com/ViewPoem.aspx?id=53303",""],[91,"الشاعر والكأس","https://www.poetsgate.com/ViewPoem.aspx?id=53302",""],[91,"بنت سورية","https://www.poetsgate.com/ViewPoem.aspx?id=53216",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[51,"لهف نفسي على العيون المِراضِ","https://www.poetsgate.com/ViewPoem.aspx?id=29407",""],[51,"يا بْن المدبِّر غرَّنيِ الروَّادُ","https://www.poetsgate.com/ViewPoem.aspx?id=27824",""],[51,"يمَّنَ اللهُ طلعة المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=30807",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[101,"خَشَعَت لفَيْضِ جَلالِكَ الأَبْصارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62434&r=&rc=26",""],[31,"لمن الديارُ كأنهنّ سطورُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18863&r=&rc=126",""],[88,"بغدادُ حسبكِ رقدة وسبات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19515&r=&rc=18",""]],"verses":[["وَلَهُ إِذا خَبُثَت أُصولُ عُداتِهِ","في تُربَةِ العَلياءِ عِرقٌ ضارِبُ",0,"ب",1,0],["وَلَهفي عَلى عَهدِ الشَبابِ وَلِمَّةٍ","أَطَرَّت غَداةَ الخَيفِ عَنّي غُرابَها",1,"ب",3,0],["وَلَها جَدٌّ إِذا اِنتَسَبَتْ","بِلِبانِ العِزِّ مَعلولُ",2,"ل",1,0],["وَلَهُ دَمعٌ إِذا وَقَّرَهُ","طاشَ مِن شَوقِ يَهيجُ الحَزَنا",3,"ن",2,0],["وَلَها مِنْ ذاتِها طَرَبٌ","فَلِهذا يَرْقُصُ الحَبَبُ",4,"ب",1,0],["ولهُ أمائِرُ سؤْدَدٍ أَيِسَ العِدا","منهُ وأمْرَضَ حاسِدِيهِ وأرْمَضا",5,"ض",2,0],["ولهٌ يَبيتُ لهُ المُتَيَّمُ ساهِراً","بحَشىً على ألَمِ الجَوى مَوْقوفِ",6,"ف",1,0],["ولهُ ابتِسامُكِ عنْ ثُغورٍ لمْ يَكُنْ","يُشْفى بهِنَّ منَ المُحِبِّ غَليلُ",7,"ل",1,0],["ولَها اسْتِراقَةُ نَظْرَةٍ نالَتْ بِها","ما لا يُنالُ بصارِمٍ مَسْنونِ",8,"ن",1,0],["وَلَهٌ تَشِفُّ وراءَهُ الأشجانُ","وهَوىً يَضيقُ بسِرِّهِ الكِتْمانُ",9,"ن",1,1],["ولهُ كما اطّرَدَتْ أنابيبُ القَنا","شَرَفٌ وعِرْقٌ بالنُّبُوّةِ يَزْخَرُ",10,"ر",1,0],["ولَهمْ وقائِعُ في العِدا مَذْكورةٌ","تَروي الذِّئابُ حَديثَها والأنسُرُ",10,"ر",1,0],["ولهُ شَمائِلُ أُودِعَتْ مِنْ نَشْرِها","سِراً يَبوحُ بهِ النّسيمُ خَمائِلُ",11,"ل",1,0],["ولهُ ذِمامُ أبيهِ حَزْنٍ إنْ جَرَتْ","ريحُ الشِّتاءِ على السّوامِ عَقيما",12,"م",2,0],["ولهُ بأطرارِ المَغارِبِ وَقْعَةٌ","تُرضي السُّيوفَ وغارَةٌ شَعْواءُ",13,"ا",2,0],["ولَهُ إِلى الغَرْبِ التِفاتَةُ وامِقٍ","يُمْري تَذَكُّرُهُ الدُّموعَ فتَسْجُمُ",14,"م",1,0],["وَلَهُ حَوافِرُ موثَقٌ تَركيبُه","صُمُّ النُسورِ كَأَنَّها مِن جَندَلِ",15,"ل",1,0],["وَلَهُ عَسيبٌ ذو سَبيبٍ سابِغٍ","مِثلِ الرِداءِ عَلى الغَنِيِّ المُفضِلِ",15,"ل",1,0],["وَلَهُ المُقدَمُ في الحَربِ إِذا","ساعَةُ الشِدقِ عَنِ النابِ كَلَح",16,"ح",1,0],["وَلَهُم أَحابيلٌ إِذا أَلقَوا بِها","قَنَصوا النُهى فَأَسيرُهُم مَخبولُ",17,"ل",1,0],["وَلَهُ مِن عَبيدِهِ خَمسَةٌ سو","دٌ كِبارٌ أُيودُهُم أَشباهُ",18,"ا",2,0],["وَلَهُ إِذا اِفتَخَر المُلوكُ مَفاخِرٌ","لا تُعتَلى بِأُبُوَّةٍ وَمَساعِ",19,"ع",1,0],["وَلَهُ البَنون بِكُلِّ أَرضٍ مِنهُمُ","مَلكٌ يَقودُ إِلى الأَعادي عَسكَرا",20,"ر",2,0],["وَلَهوٍ أَثَرناهُ بِتِلكَ المَعاطِفِ","بِسودِ أَثيثِ الشَعرِ بيضِ السَوالِفِ",21,"ف",1,0],["وَلَهُ يَدٌ يَئِسَ الغَما","مُ مِنَ أَن يُعارِضَ صَوبَها",22,"ب",3,0],["وَلَهفي عَلى صَخرٍ لَقَد كانَ عِصمَةً","لِمَولاهُ إِن نَعلٌ بِمَولاهُ زَلَّتِ",23,"ت",1,0],["ولها بتعداد الأشعة في الندى","صورٌ يضيق بحصرها التعداد",24,"د",1,0],["وَلَهَا المَحَاسِنُ وَالحِلَى","وَأَحَبَّهَا الخُلُقُ الأَبِيّ",25,"ي",1,0],["وَلَهُمْ صِنَاعَاتٌ بِهَا الْ","أَوْطَانُ مَا شَاءَتْ مُدِلَّهْ",26,"ل",2,0],["وَلَهَا ذَخائِرُ فِي الحَيَاةِ وَفِي","مَا بَعْدُ يَبْلِي الدَّهْرَ سَرْمَدُهَا",27,"د",3,0],["وَلَهَا حِلٌى مِمَّا تُلاَحِظُهُ النُّهَى","فِي اللَّوْذَعِيِّ العَاطِلِ المُزْدَانِ",28,"ن",1,0],["وَلَهُ فِي القُلُوبِ تَاجٌ سَنِيٌّ","وَلِوَاءٌ عَالٍ وَعَرْشٌ مُقَامُ",29,"م",1,0],["وَلَهُ صَوْلَةُ المُطَا","عِ اخْتِيَاراً إِذَا حَكَمْ",30,"م",1,0],["ولهم في مدى العراق جيوش","كجرادٍ علينا انتشار",31,"ر",1,0],["ولهم أعبُد بها وإماءٌ","ونعيم ورِفعة وجلاله",32,"ل",2,0],["وله فروع أصلهن لشارع ال","كبش المجاري منه مُنتهيات",33,"ت",1,0],["وَلَهُم مَجالِسُ لا مَجالِسَ مِثلُها","حَسَباً يُؤَثِّلُ طارِفاً وَتَليدا",34,"د",2,0],["وَلَّهتِ قَلبي إِذ عَلَتني كَبرَةٌ","وَذَوُو التَمائِمِ مِن بَنيكِ صِغارُ",35,"ر",1,0],["وَلَهُ الفَواضِلُ وَالنَوافِلُ وَالعُلا","وَلَهُ أَثيثُ الخَيرِ وَالمَعدودُ",36,"د",1,0],["وَلَهُم حُلومٌ كَالجِبالِ وَسادَةٌ","نُجُبٌ وَفَرعٌ ماجِدٌ وَأَرومُ",37,"م",1,0],["وَلِهَت نَفسِيَ الطَّرُوبُ إلَيهم","وَلَهَاً حالَ دُونَ طَعمِ الطَّعَامِ",38,"م",1,0],["وله فوق أدهم الليلِ تسرِي","دعواتٌ خفيفة المركوب",39,"ب",1,0],["ولهجت بالأغزالِ أتبع زورها","صدقاً بمدح ابن النبي منابا",40,"ب",2,0],["ولهفي على بيت السيادة والتقى","ولهفي على حي القراءة والقرى",41,"ر",2,0],["ولهفي على حكم تحف بلينه","بوادر تحمي صفوه إن يكدرا",41,"ر",2,0],["ولهفي على رأي يضيء به الهدى","إذا النجم في أفق السماء تحيرا",41,"ر",2,0],["ولهفي على جار من الجود طالما","جرى معه صوب الحيا فتعطرا",41,"ر",2,0],["ولهفي على أقلامه السود أوحشت","إليها السيوف الحمر والنعم الخضر",42,"ر",1,0],["ولها بآثارِ المناسمِ في السرى","شرفٌ على شرف البدور الطلّع",43,"ع",1,0],["ولهذا التأوِيلِ سَماه موزاً","مَنْ أفاد المعانيَ الأسماءَ",44,"ا",2,0],["ولها من ذَوي الأصالة عُشَّا","قٌ وليسوا بتابِعي الأهواءِ",45,"ا",2,0],["ولها محمِلٌ خفيفٌ ولكن","كان حظّي لديك دونَ اللَّفاءِ",45,"ا",2,0],["ولهذين مَطلبٌ عند قوم","لست أُلفَى لرَحْلِهم غَشّاءَ",46,"ا",2,0],["ولهذا اكتفى البليغُ من الإس","هاب فيما يريد بالإيحاءِ",47,"ا",2,0],["وَلَهُ بَعْدُ مِنْ مآثره الزُّهْ","رِ خِلالٌ تُرْبي على الحصباءِ",47,"ا",2,0],["ولهذا الإنسانِ قد سخَّر الرح","منُ ما بين أرضه والسماءِ",47,"ا",2,0],["وله فكرةٌ يعيد بها الأم","وات في مثل صورة الأحياءِ",47,"ا",2,0],["وله حَرْشَفٌ يُديرُ قُداما","هُ زحافاً كالفَيلَق الشهباءِ",47,"ا",2,0],["وله نعاجٌ لا يزا","ل مُخلِّيا فيها ذئابهْ",48,"ب",2,0],["وَلَهُ المحبِّ إلى الحبيبِ","ولَهُ المريضِ إلى الطبيبِ",49,"ب",1,1],["ولها بينهنَّ فيَّ حديثٌ","جُلُّهُ ليتَهُ يرِقُّ لما بي",50,"ي",1,0],["ولهذا المولود تالٍ من الحُر","رِةِ إنَّ الرُّكُوعَ فحْوَى السُّجودِ",51,"د",1,0],["ولهُ بعْدَ نِعْمَة الرِّفْدِ نُعْمَى","فَوْقَ نُعْمَى الرُّقَاد بعد السُّهُودِ",51,"د",1,0],["وله أبياتُ شعرٍ","أُلِّفَتْ زَوْجاً وفردا",52,"د",2,0],["وله حُرمةٌ بخنساء تُغْرِي","كلَّ نفسٍ تودُّها بودادِهْ",53,"د",2,0],["وله حقُّه من الرِّفْد فارفدْ","هُ وكن من مُبادري استرفادِهْ",54,"د",2,0],["وله حلاوة قَدِّه","والحلم منه حين يُغْمَدْ",55,"د",1,0],["ولهم أُسىً متقدماتٌ جمَّةٌ","لكن أحبَّ القوْم أن يزدادوا",56,"د",3,0],["وله كابد الأذى","والأكُفَّ القوافدا",57,"د",2,0],["ولها مغابن قد أبنَّ صُماحها","لا تستطيب بفيض سبعة أبحر",58,"ر",1,0],["وله طوالَ الدهرِ زُمرة ناكةٍ","لا يرجعون إليه حتى المحشر",58,"ر",1,0],["وله بين حُلَّتَيه من البا","ن قضيب حواه دِعْص وَثيرُ",59,"ر",1,0],["وله ثغر شتيت نبتُهُ","وبعينيْه مع السّقم حور",60,"ر",1,0],["ولها غدائرُ حُلَّكٌ","فوق الرَّوادفِ مُيَّسُ",61,"س",1,0],["ولها وشاحٌ جائلٌ","زَجْلٌ وحِجلٌ أخرس",61,"س",1,0],["ولها كَعْثب كَظِلف غزالٍ","فيه صدع كأنما هو خَدشُ",62,"ش",1,0],["ولهفي ربِحتَ وأخسرْتني","نَبلْتَ وطشتُ مع الطيَّش",63,"ش",1,0],["ولهَانتْ على امرئٍ أخْطأتْه","شكَّةُ السهم صكَّةُ المعراض",64,"ض",1,0],["وله بعد ذاك ضربٌ ترى البي","ضةَ تنقاضُ منه أيّ انقياض",64,"ض",1,0],["وله قبْلَ ذا وذاك نضالٌ","بمنايا على الرَّمايا قواضي",64,"ض",2,0],["وله الوطْأةُ التي ما أصابتْ","أقلَعَتْ منه عن رُضاضٍ فُضاض",64,"ض",1,0],["وله إذا ما الرأي حيره","خطبٌ يشنِّع ورده قرعه",65,"ع",2,0],["ولها دجى ليل تجلَّلها","فتظل تدريه وترفعه",66,"ع",2,0],["وله من العز التليد إذا","عدت بنو شيبان أمنعه",66,"ع",2,0],["وله منهم أخوه يغوثٌ","وله منهم يعوق مطاع",67,"ع",1,0],["وله نسرٌ ولات وعزى","ما له لا حط ذاك البعاع",67,"ع",1,0],["ولهذا أدّاهما ذو اليميني","ن تراثاً إليك يا خير خلف",68,"ف",1,0],["وله آنية من فضة","بعدما كانت رواقيد خزف",69,"ف",1,0],["وله في حرمة الجا","رِ محايا الشريك",70,"ك",1,0],["ولهذا تُجيبني حين أدعو","غيرَ معتاصةٍ فأعلو وتَسْفُلْ",71,"ل",1,0],["وله فيك آلتانِ لحربٍ","ولكيدٍ كهمةِ المؤتالِ",72,"ل",1,0],["ولهذا ومثلهِ غير شكٍّ","كان بينَ القوابل استهلالي",73,"ل",2,0],["ولهم إذا نزلوا اليفاعَ تحوّلٌ","عنْه وليس له هناك تحوُّلُ",74,"ل",1,0],["وله نثرٌ من الدُرْ","رِ مليحٌ ونِظامُ",75,"م",1,0],["ولها كعثبٌ رحيبُ النواحي","قلقُ الشِّدقْ ليس بالمَفْطوم",76,"م",1,0],["ولهُ هِمةٌ حَمولٌ عليه","تستقلُّ الكثيرَ من إحسانه",77,"ن",2,0],["ولَهمَّ الوردُ المُظاهَرُ والنَرْ","جِسُ شُحّاً عليك يلتقيان",78,"ن",1,0],["وله إخوة شآهم إلى المَجْ","د وإن هم شَأَوه بالأسنان",78,"ن",1,0],["ولَهُ من العباس مَجْدُ ولاية","عن كُلِّ أَزْهَرَ من بنيه هَجانِ",79,"ن",1,0],["وَلَهُم صَباباتٌ لَنا أَم غودِروا","في بَلقَعٍ ما فيهِ غَيرُ خَرابِ",80,"ب",1,0],["وَلَهِجَت بِاِسمِكَ آفاقُها","وَرَدَّدَتهُ في البَوَدي الحُداة",81,"ه",1,0],["وَلَهُ بِأَرضِكُم طَماعَة أَشعَبٍ","وَرَواغَه وَلِكَيدِهِ اِستِمرارُ",82,"ر",1,0],["وَلَها حَفيفٌ كَالرِيا","ح وَهَدرَةٌ لا كَالهَديرِ",83,"ر",1,0],["وَلَها قَوامٌ لَو أُشَبِّهُهُ","بِالغُصنِ باءَ الغُصنُ بِالفَخرِ",84,"ر",1,0],["وَلَها في كُلِّ بابٍ وَقفَةٌ","كَاِمرِءِ القَيسِ حِيالَ الطَلَلِ",85,"ل",1,0],["وَلَهُ تَضحَكُ البُروقُ","وَيَبكي الحَيا السَجام",86,"م",1,0],["وَلَهُ تَرتَعي الكَواكِبُ","في مَسرَحِ الظَلام",86,"م",1,0],["وَلَهُ تَلبِسُ الرُبى","بُرُدَ النورِ وَالغَمام",86,"م",1,0],["وَلَهُ