{"poems":[[53,"قعد الراضون بالذل فقم","https://www.aldiwan.net/poem29750.html","الرمل"],[63,"وظباء من بني أسد","https://www.aldiwan.net/poem45804.html","المديد"],[3,"قف بالديار وصح إلى بيداه","https://www.aldiwan.net/poem222.html","الكامل"],[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[71,"لا تعرضن لضيق المقل","https://www.aldiwan.net/poem4018.html","أحذ الكامل"],[73,"ألا هل درى الداعي المثوب إذ دعا","https://www.aldiwan.net/poem11947.html","الطويل"],[41,"أراعك طائر بعد الخفوق","https://www.aldiwan.net/poem42367.html","الوافر"],[72,"أيها الكامل قصرا","https://www.aldiwan.net/poem18208.html","مجزوء الرمل"],[72,"خدمتك من فلك الثناء الدائر","https://www.aldiwan.net/poem18714.html","الكامل"],[29,"طرق الكرى بالغانيات وربما","https://www.aldiwan.net/poem6174.html","الكامل"],[16,"ود نفير للمكاور أنهم","https://www.aldiwan.net/poem27690.html","الطويل"],[92,"أي ناس هذا الورى ما رأى","https://www.aldiwan.net/poem38889.html","الخفيف"],[89,"الشمس قد طلعت بوجه اروع","https://www.aldiwan.net/poem44622.html","الكامل"],[89,"قد قلت ان العقل لي","https://www.aldiwan.net/poem44853.html","مجزوء الكامل"],[45,"أحرام أن ينجز الموعود","https://www.aldiwan.net/poem63501.html","الخفيف"],[61,"رفق الزمان بنا وكان عنيفا","https://www.aldiwan.net/poem51543.html","الكامل"],[61,"عفر الظباء لدى الكثيب الأعفر","https://www.aldiwan.net/poem51686.html","الكامل"],[61,"كبوة الهم بين كاس وكوب","https://www.aldiwan.net/poem51764.html","الخفيف"],[58,"إذا كنت في نعمة فارعها","https://www.aldiwan.net/poem30879.html","المتقارب"],[97,"يا حبيب الروح يا روح الأماني","https://www.aldiwan.net/poem24800.html","الرمل"],[80,"إذا البدر يطوى في ربوع البلى لحدا","https://www.aldiwan.net/poem31479.html","الطويل"],[80,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[105,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[102,"روحي فداء عصابة زرقاء","https://www.aldiwan.net/poem33033.html","الكامل"],[21,"لك الحمد والمن رب العباد","https://www.aldiwan.net/poem36163.html","المتقارب"],[39,"نبيت تميما تجتدي حرب طيئ","https://www.aldiwan.net/poem53756.html","الطويل"],[67,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[67,"أمدائح لي فيك أم تسبيح","https://www.aldiwan.net/poem18045.html","الكامل"],[75,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[48,"اسقنيها بسواد","https://www.aldiwan.net/poem62549.html","مجزوء الرمل"],[48,"قل للعذول بحانة الخمار","https://www.aldiwan.net/poem63293.html","الكامل"],[46,"أسيت على الذوائب أن علاها","https://www.aldiwan.net/poem22006.html","الوافر"],[46,"نوائب إن جلت تجلت سريعة","https://www.aldiwan.net/poem22193.html","الطويل"],[46,"تنافس قوم على رتبة","https://www.aldiwan.net/poem22379.html","المتقارب"],[46,"إلى ما أجر قيود الحياة","https://www.aldiwan.net/poem22734.html","المتقارب"],[46,"أرى الشهد يرجع مثل الصبر","https://www.aldiwan.net/poem22754.html","المتقارب"],[46,"نراقب ضوء الفجر والليل دامس","https://www.aldiwan.net/poem22783.html","الطويل"],[46,"لقد جاء قوم يدعون فضيلة","https://www.aldiwan.net/poem22949.html","الطويل"],[46,"أخو سفر قصده لحده","https://www.aldiwan.net/poem22975.html","المتقارب"],[46,"أيعلم نجم طارق برزية","https://www.aldiwan.net/poem23016.html","الطويل"],[46,"أرى كل خير في الزمان مفارقا","https://www.aldiwan.net/poem23080.html","الطويل"],[46,"سأرحل عن وشك ولست بعالم","https://www.aldiwan.net/poem23290.html","الطويل"],[46,"إرمنا يا ظلام في كل فج","https://www.aldiwan.net/poem23618.html","الخفيف"],[15,"سقى الرباب مجلجل الأكناف","https://www.aldiwan.net/poem45260.html","مجزوء الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39539","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[106,"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[100,"أسمار القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50334",""],[100,"الجناح المحطم","https://www.poetsgate.com/ViewPoem.aspx?id=50344",""],[100,"عازف الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=50174",""],[45,"أحَرَامٌ أنْ يُنْجَزَ المَوْعُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=31604",""],[135,"الصفو راق فقم إليه وبادر","https://www.aldiwan.net/poem48884.html","الكامل"],[135,"حيت فأحيت مهجة المشتاق","https://www.aldiwan.net/poem49125.html","الكامل"],[185,"لا غرو أن رحل الشباب وبانا","https://www.aldiwan.net/poem14688.html","الكامل"],[195,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[199,"حيا وسلم ثم صافح تاركا","https://www.aldiwan.net/poem45142.html","الكامل"],[232,"وبمهجتي من زارني","https://www.aldiwan.net/poem14821.html","مجزوء الكامل"],[239,"في ليلة صبغ الظلام أديمها","https://www.aldiwan.net/poem23837.html","الكامل"],[270,"ما جئت ألتزم القوام الناحلا","https://www.aldiwan.net/poem35412.html","الكامل"],[297,"ولقد طرقت الحي من سعد","https://www.aldiwan.net/poem33289.html","أحذ الكامل"],[298,"نفخ الصور فهبوا مسرعين","https://www.aldiwan.net/poem36856.html","عموديه"],[304,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[309,"ودنياك التي غرتك منها","https://www.aldiwan.net/poem50312.html","الوافر"],[309,"تبارك ذو العلا والكبرياء","https://www.aldiwan.net/poem50325.html","الوافر"],[328,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[328,"هتف البحر بالعذارى فلبين","https://www.aldiwan.net/poem54984.html","الخفيف"],[328,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[342,"ومليح جاء صبحا","https://www.aldiwan.net/poem55351.html","مجزوء الرمل"],[342,"ألق الدنيا حباب","https://www.aldiwan.net/poem55384.html","مجزوء الرمل"],[349,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[353,"وتذكرت عهد الهوى","https://www.aldiwan.net/poem39954.html","مجزوء الكامل"],[361,"ومهفهف الاعطاف سيف لحاظه","https://www.aldiwan.net/poem68115.html","الكامل"],[361,"يا لي لا زارني في غفلة","https://www.aldiwan.net/poem68130.html","الكامل"],[366,"نادى الرجال به ونادى سيفه","https://www.aldiwan.net/poem17257.html","الكامل"],[400,"أيها الغائب","https://www.aldiwan.net/poem6734.html","عموديه"],[402,"أتدري من تخرمت المنون","https://www.aldiwan.net/poem46438.html","الوافر"],[403,"قرت العين ببشرى","https://www.aldiwan.net/poem33920.html","مجزوء الرمل"],[429,"جاءت تميس وقدها الخطار","https://www.aldiwan.net/poem40716.html","الكامل"],[439,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[439,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[439,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[439,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[441,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[452,"خفقت نسمة الصبا في الرياض","https://www.aldiwan.net/poem13822.html","الخفيف"],[458,"أشاقك من حسناء وهنا طروقها","https://www.aldiwan.net/poem56101.html","الطويل"],[458,"أري طرفها أن الخضابين واحد","https://www.aldiwan.net/poem56245.html","الطويل"],[468,"يومنا يوم مجون","https://www.aldiwan.net/poem59622.html","مجزوء الرمل"],[500,"حي الربيع بزهره","https://www.aldiwan.net/poem37703.html","مجزوء الكامل"],[506,"بشراي أبصرتك خير إمام","https://www.aldiwan.net/poem2462.html","الكامل"],[514,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[514,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[558,"هي الذات التي فوق البراق","https://www.aldiwan.net/poem34331.html","الوافر"],[567,"قد جاد طيفك لي بوعدك","https://www.aldiwan.net/poem69734.html","مجزوء الكامل"],[567,"عجبي ممن تعالت حاله","https://www.aldiwan.net/poem69813.html","الرمل"],[575,"صفعوه بالعوانيه","https://www.aldiwan.net/poem2794.html","مجزوء الرجز"],[575,"نظر الحبيب إلي من طرف خفى","https://www.aldiwan.net/poem3048.html","الكامل"]],"verses":[["وَدَنيٌّ ضارِعٌ عَن أَمرِهِ","أَخَذَ العُربَ بِتيجانِ العَجَم",0,"م",1,0],["وَدَنا مِنّي فَقُلتُ لَهُ","أَنتَ واري الزِّندِ مأمولُ",1,"ل",1,0],["وَدَنَت كِباشٌ مِن كِباشٍ تَصطَلي","نارَ الكَريهَةِ أَو تَخوضُ لَظاها",2,"ا",3,0],["وَدَنا الشُجاعُ مِنَ الشُجاعِ وَأُشرِعَت","سُمرُ الرِماحِ عَلى اِختِلافِ قَناها",2,"ا",3,0],["وَدَنا تَسَمُّعُهُ إِلى","ما قالَ إِذ أَوصى بِها",3,"ب",3,0],["وَدَنَت كَأَنَّ شُعاعَها قَبسٌ","بادٍ وَإِن جَلَّت عَنِ المَثَلِ",4,"ل",1,0],["وَدُنيا وَجَدنا العَيشَ في غَفَلاتِها","طَريقاً إِلى وِردِ المَنِيَّةِ مَهيَعا",5,"ع",2,0],["وَدنيَاكَ الَّتي أَمسَيتَ فيها","مُزَايلةُ الشَقِيقِ عَنِ الشَّقيقِ",6,"ق",1,0],["ودَنَا وِردُ أيادي","هِ فقصرْت الرِّشاء",7,"ا",2,0],["ودنا بها سهلُ المديح فلم أقلْ","كم بين أكنافِ العذيب وحاجر",8,"ر",1,0],["وَدَنا المُغارُ لَها فَهُنَّ شَوازِبٌ","خَلَلَ المَطِيِّ كَأَنَّهُنَّ مَغالي",9,"ل",2,0],["وَدَّ نُفَيرٌ لِلمَكاوِرِ أَنَّهُم","بِنَجرانَ في شاءِ الحِجازِ المُوَقَّرِ",10,"ر",1,1],["ودنيءٍ تاريخُهُ في سِجِلِّ","الشَّرِّ إِفْكٌ وقِحَّةٌ ودَنَاءهْ",11,"ا",2,0],["ودنا يطوف بها الغمام كمصطل","بالنار يذكي جمرها او مزمع",12,"ع",1,0],["ودنا يهدم ما بنا","ه في الحياة بمعول",13,"ل",1,0],["وَدَنا العيدُ وَهُوَ لِلناسِ حَتّى","بَتَقَضّى وَأَنتَ لِلعيدِ عيدُ",14,"د",1,0],["ودَنَتْ ظِلالُ المَكرُماتِ وذُلِّلَتْ","أثمارُها للطَّالبينَ قُطُوفا",15,"ف",2,0],["وِدَنَوا فلم تَنُبِ القَنا عن جُنَّةٍ","منهم ولا نَبَتِ الظُّبا عن مِغفَرِ",16,"ر",1,0],["ودِنانٍ أُقِمْنَ صفّاً كما قا","مَ غَداةَ اللِّقاءِ رَجْلُ حُروبِ",17,"ب",1,0],["وَدُنياكَ بِالغَمِّ مَقرونَةٌ","فَلا يُقطَع العُمرُ إِلّا بِهَمّ",18,"م",1,0],["ودنا روضٌ وظلٌّ وغمام","بعد فتك النار بالعمر الجديب",19,"ب",1,0],["ودُنياكَ كَالحِرباءِ ذاتُ تَلَوُّنٍ","ومُبْيَضّها في العينِ أصْبَحَ مسوَدّا",20,"د",2,0],["ودَنا مِنكَ بِتَقبيلِ الثرى","كلّ قَرمٍ سَيِّدٍ وهوَ مَسود",21,"د",1,0],["وَدَنا فَحَيّاهُ النَبِيُّ وَكَبَّرَت","شُهَداءُ بَدرٍ حَولَ ذاكَ المَشهَدِ",22,"د",1,0],["وَدُنوّها مِن مُقلة مَكحولة","فَتّانةٍ فَتّاكةٍ حَوراءِ",23,"ا",2,0],["وَدِن دينَ رَبِّكَ حَتّى اليَقِينِ","واجتَنِبَنَّ الهَوى والضَجَم",24,"م",1,0],["وَدِنّا مَعَدّاً مِثلَ ما كانَ تُبَّعٌ","يَدينُهُمُ في كُلِّ حَقٍّ وَباطِلِ",25,"ل",1,0],["ودنا التَّوديع مَمَّنْ وَدِدْنا","أَنَّهم داموا لدينا غِضابا",26,"ب",2,0],["ودَنَا دُنُوّاً لا يُزَاحِمُ مَنْكِباً","فيه كما زَعَمَ المُكَيِّفُ مَنْكِبُ",27,"ب",1,0],["وَدَنَا فلا يَدُ آمِلٍ مُمْتَدَّةٌ","طَمَعَاً وَلا طَرْفٌ إليهِ طَموحُ",28,"ح",1,0],["وَدَنَوْا للوَداعِ حتى ترى الأج","يادَ فوقَ الأجياد كالأطواق",29,"ق",1,0],["ودنَتْ إليه الشمسُ حتى زُوحِمتْ","واخضَرّ منه الأفْقُ حتى أعشبا",30,"ب",2,0],["وَدِنانٍ مُسنَداتٍ","مُعلَماتٍ بِمِدادِ",31,"د",1,0],["وَدَنا إِلَيَّ وَقالَ نُصحُكَ واجِبٌ","زَيِّن خِصالَكَ هَذِهِ بِقِمارِ",32,"ر",1,0],["وَدُنيانا الَّتي عُشِقَت وَأَشقَت","كَذاكَ العِشقُ مَعروفاً شَقاءُ",33,"ق",3,0],["وَدُنياكَ إِن قَلَّت أَقَلَّت وَإِن قَلَت","فَمِن قَلَتٍ في الدينِ نَجَّت وَعَلَّتِ",34,"ت",1,0],["وَدُنياكَ غُرَّ بِها جاهِلٌ","فَتَبَّت عَلى كُلِّ حالٍ وَتَبّ",35,"ب",1,0],["وَدُنيايَ إِن وَهَبَت بِاليَمينِ","يَسارَ الفَتى أَخَذَت بِاليَسار",36,"ر",1,0],["وَدُنيايَ أَلقى بِطولِ الهَوانِ","وَهَل هِيَ إِلّا كَجِسرٍ عُبِر",37,"ر",1,0],["وَدُنياكَ دارٌ مَن يَحُلُّ فِناءَها","فَقَد غَمَسَتهُ في الشُرورِ القَوامِسُ",38,"س",1,0],["وَدُنياكُمُ الدارُ الَّتي ما تَضَمَّنَت","زَكيّاً فَلا تَبكوا أَثافِيَّها السُفعا",39,"ع",2,0],["وَدُنياكَ مِثلُ الإِناءِ الخَبيثِ","وَصاحِبُها مِثلُ كَلبٍ وَلَغ",40,"غ",1,0],["وَدُنياكَ لَيسَت لِلسُرورِ مُعَدَّةً","فَمَن نالَهُ مِن أَهلِها فَهُوَ سارِقُه",41,"ق",2,0],["وَدُنياكَ سارَت بِالأَنامِ مُغِذَّةً","فَلا فَرقَ فيها بَينَ سَيري وَسَيرِكا",42,"ك",2,0],["وَدُنياكَ يَهواها عَلى الهَرَمِ الفَتى","وَيَخدُمُها فيما يَنوبُ المُخَدَّمُ",43,"م",1,0],["وَدُنّا يَعَذولُ أَنّا سَلِمنا","مِن هَوانا وَلَم نُدانِ الدَنايا",44,"ا",3,0],["وَدَنا يُضيءُ صُبابُهُ","غاباً يُضَرِّمُهُ حَريقُه",45,"ق",2,0],["ودنا الليلُ ورنّتْ صدحةٌ","نبّهته حين لا يبغي انتباها",46,"ا",3,0],["ودَنَتْ جَنَّةُ المنى","وحلا عندها المقَرْ",47,"ر",1,0],["ودنا مني وغنَّاني النشيدا","فعرفتُ اللحنَ والصوتَ الوديعا",48,"ع",2,0],["ودنا الموعدُ فاهتجنا غناءَ","وتنظّرناكَ والليلُ عيونْ",48,"ن",1,0],["وَدَنَوْا من خِبَائها فَأَرَتْهم","ثَمَراتِ النُّهَى وَسِرَّ الكِتَاب",49,"ب",1,0],["ودنيا من الذكر الجميل عريضة","وكنزًا من المجد المؤثَّل باقيا",50,"ي",2,0],["ودنت فالتوى على صبح ساقيها","يناغي ويجتدي ويراود",51,"د",1,0],["ودنت من ترى ؟ أبا طفلتيها","وهو جذع من الجراحات هامد",51,"د",1,0],["ودنا من هنا الحريق وأومى","بارق الموت من هناك ولاحا",52,"ح",2,0],["ودنياك عشّ يغنّي ثراه","فتخضرّ أصداؤه في السقوف",53,"ف",1,0],["وَدَنَا العِيدُ، وَهوَ للنّاسِ، حَتّى","يَتَقَضّى، وأنتَ للعيدِ عِيدُ",54,"د",1,0],["ودنا بعثمانَ السرور وبشرت","أوقات مولده بعزٍّ ظاهرِ",55,"ر",1,0],["ودنت فما أزكى الربى بأريجها","ورنت فما أمضى ضبي الأحداقِ",56,"ق",1,0],["ودَنا فكان كقاب قوسَيْ حاجبٍ","في القربِ بل أدنَى هناك قِرانا",57,"ن",2,0],["وَدَنا النَجمُ يَستَقيلُ وَحارَت","كُلَّ يَومٍ ظَهيرَةٌ شَهباءُ",58,"ا",2,0],["ودنا ليغترق الهوى فتهالكت","أسراره فرمت به فرماها",59,"ا",3,0],["وَدَنا يُعاطينا سُلا","فَةَ ريقِهِ أَحلى تَعاطي",60,"ي",1,0],["ودنا إلى الملأ العليّ وقبله","لم يأت هذاك المقام عِباد",61,"د",1,0],["ودَنوتُ مِنها واضعاً إياهُ في","خصرٍ ليُنحلني تَنَطَّقَ ناحِلا",62,"ل",2,0],["وَدَنَوتُ منها وَهي عاتِبَةٌ","أُبدي العتابَ لها كما تُبدي",63,"د",2,0],["ودنا الخدانِ منْ بعضِهما","حينما الجيداِ هّما بالتلاقْ",64,"ق",1,0],["ودنونا من حجرة وضريح","لنبي الهدى ومسك الختام",65,"م",1,0],["وَدُنياكَ الَّتي غَرَّتكَ مِنها","زَخارِفُها تَصيرُ إِلى اِنجِذاذِ",66,"ذ",1,1],["وَدُنيانا وَإِن مِلنا إِلَيها","وَطالَ بِها المَتاعُ إِلى اِنقِضاءِ",67,"ا",2,0],["ودنا الشاطىء البعيد فرفقاً","بسفيني يا آخر العاصفات",68,"ت",1,0],["ودنت من يدي فشبّت لهيبي","وأثارت عواطفي النعسانه",69,"ن",2,0],["ودنيا الملائك فوق السحاب","ونملُ التراب وطير السديم",70,"م",1,0],["ودنا مني فأدنى","وجهه للثمّات",71,"ت",1,0],["ودناه حينما يضع","ف كفران وعاب",72,"ب",1,0],["وَدُنتُ كَما دانَ الدُعاةُ لِحُسنِها","بِخَلعِ التُقى فيها وَلَيسَ التَقِيَّةِ",73,"ه",1,0],["وَدَنَت وَقَد لَعب الهَوى","بِعُقولنا وَتَحَكَّما",74,"م",2,0],["وَدَنا وَأَتحَفَني وَأَطفَأ لَوعَتي","وَشَفى فُؤادي من تلهف بَعده",75,"د",2,0],["وَدنا يَوَدّ عنى فَلا وَأَبيكَ ما","بَقيتَ لَدى التَوديع في حياة",76,"ه",1,0],["وَدِنانُها هامُ الكُماةِ وَإِنَّما","يَنزِلنَ مِن طُرُقِ الشَبابِ بِمَنزِلِ",77,"ل",1,0],["ودنت أحلامنا منا , ولكن","قد كساها الليل أسمالا ثقالا",78,"ل",2,0],["ودِنتَ بدينهِم في كلِّ حالٍ","وذاكَ لعمرك الحقّ اليقين",79,"ن",1,0],["ودنى الوصل فيا للّه","ما أهنا وأمرا",80,"ر",2,0],["ودنت تروم تحية فتسابقت","للقائها الألباب والأفكار",81,"ر",1,0],["ودُنُوُّها دِينٌ لكُمْ وفرائِضٌ","وسناؤها سُنَنٌ لكُمْ وشرائِعُ",82,"ع",1,0],["ودَنَتْ لَهُ الآمالُ حَتَّى خيَّلَتْ","أَنَّ النجومَ لَهُ ثمارٌ تُجْتَنى",83,"ن",2,0],["ودَنَتْ لَكَ الدُّنيا بِقاصِية المُنى","وَتَخَيَّرَتْ لَكَ فَوْقَ مَا تختارُ",84,"ر",1,0],["ودَنا ابنُ رُذْميرٍ يُزَلْزِلُ خَطوَهُ","أملٌ تقسَّم نفسَهُ وحِذارُ",84,"ر",1,0],["ودنا بِهِ أَجَلُ الرَّحِيلِ كَأَنَّهُ","أَجَلُ المماتِ دَنَا بِهِ المقدارُ",84,"ر",1,0],["ودَنَتْ لَهَا فِي آرُ تَحْتَ صَوارِمٍ","وَرِيَتْ بعزِّ المسلمينَ زُنودُها",85,"د",3,0],["ودنتم واعتقدتم أَن هذي","تقيات ويسلم من نواها",86,"ا",3,0],["ودنا النَّرْجِسُ الجَنِيُّ إِلى با","كورة الوَرْدِ بالعيونِ المراضِ",87,"ض",1,0],["ودنيا خداعٍ كالقذاة بمقلتي","وإن ملأتها من جمالٍ يروقُها",88,"ق",3,0],["ودنيا لسانُ الذمّ فيها محكَّمٌ","ولكنها عند الحسين مَحامدُ",89,"د",1,0],["وَدَنانيرِ بَهارٍ","في هَمايينِ غُصونِ",90,"ن",1,0],["ودنوا بنسبة عزمهم","ولكل مجتهندٍ نصيب",91,"ب",1,0],["وَدَنَا الجَميعُ لِلثمِ راحَتِهِ التي","هِيَ مَعدِنُ الأرزاقِ والأقسامِ",92,"م",1,0],["ودنتْ إلى فمِها أراقِمُ فرعِها","فتكلّفتْ بحِفاظِ كَنزِ الجوهري",93,"ر",2,0],["ودنا الفِراقُ وكان يبخلُ قبلَهُ","بلُجَين مدمَعِه فجادَ بتِبرِهِ",94,"ر",2,0],["ودنسناه بالأفهام حيناً","وبالأقوال والبحث المساق",95,"ق",1,0],["ودنا إليَّ مُعانقاً","ومصافِحاً خَدّي بخدِّكْ",96,"ك",1,0],["ودُنُوٍّ من دُمى هنَّ له","حين يشتاق إلى اللهو لُعَبْ",97,"ب",1,0],["ودِنْت من أَمْرِ الهوى","دهتْك مِنْه داهِيه",98,"ي",2,0],["ودنا فسكَّن نارَ قلبي خدُّه","أَسمعتُمُ ناراً بنارٍ تَنْطَفِي",99,"ي",1,0]]}