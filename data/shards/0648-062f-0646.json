""],[709,"خفرت بسيف الغنج ذمّة َ مِغفَري","https://www.poetsgate.com/ViewPoem.aspx?id=2880",""],[5518,"في مدح الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=201599",""],[5525,"لا والذي سواك","https://www.poetsgate.com/ViewPoem.aspx?id=7188",""],[5533,"ذَهَبَ الشَّباب","https://www.poetsgate.com/ViewPoem.aspx?id=177714",""],[5596,"فقيد البِرِّ والسخاء","https://www.poetsgate.com/ViewPoem.aspx?id=206382",""],[5608,"الهنوف","https://www.poetsgate.com/ViewPoem.aspx?id=32911",""],[243,"مأساة الميناء","https://www.poetsgate.com/ViewPoem.aspx?id=50470",""],[5667,"الطبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=214892",""],[5674,"بحة النايات","https://www.poetsgate.com/ViewPoem.aspx?id=191359",""],[5691,"ياقوتة...!","https://www.poetsgate.com/ViewPoem.aspx?id=207971",""],[5694,"اخويي","https://www.poetsgate.com/ViewPoem.aspx?id=129913",""],[5701,"ودنيا الورى فندق للورى","https://www.poetsgate.com/ViewPoem.aspx?id=164636",""],[5701,"مقادير تمحو ما تشاء وتكتب","https://www.poetsgate.com/ViewPoem.aspx?id=164592",""],[5717,"صب تسامره بدور","https://www.poetsgate.com/ViewPoem.aspx?id=170584",""],[5776,"خاتمٌ بلا إصبع","https://www.poetsgate.com/ViewPoem.aspx?id=199329",""],[5790,"وعد الزيارة وعد من لا يخلف","https://www.poetsgate.com/ViewPoem.aspx?id=112077",""],[5790,"ما للجمال بوجنتيك معين","https://www.poetsgate.com/ViewPoem.aspx?id=112147",""],[5804,"لا خيرَ في الخير","https://www.poetsgate.com/ViewPoem.aspx?id=186971",""],[5818,"حطّتْ عليه محبّةً وهياما","https://www.poetsgate.com/ViewPoem.aspx?id=193132",""],[5879,"الوجد لي","https://www.poetsgate.com/ViewPoem.aspx?id=215458",""],[5909,"وذا القلب ولهانٌ عليك وزاهدُ","https://www.poetsgate.com/ViewPoem.aspx?id=209191",""],[5975,"أيا من كلما أدنوهُ حبّاً","https://www.poetsgate.com/ViewPoem.aspx?id=58785",""],[6045,"أملٌ ممتنع !","https://www.poetsgate.com/ViewPoem.aspx?id=125350",""],[6102,"زيشان","https://www.poetsgate.com/ViewPoem.aspx?id=184170",""],[6102,"هيت لك","https://www.poetsgate.com/ViewPoem.aspx?id=185305",""],[6115,"أخذنا من الدنيا العجيبه عبر ودروس!","https://www.poetsgate.com/ViewPoem.aspx?id=185928",""],[6127,"أبى الليل","https://www.poetsgate.com/ViewPoem.aspx?id=190758",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""],[6159,"سبورة الفوضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85855&r=&rc=1",""],[6171,"لا فِتَةٌ عَلى بَوابةِ العَام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84672&r=&rc=2",""],[6237,"رصيد الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77886&r=&rc=28",""],[6345,"ألم المسيح ردائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78632&r=&rc=3",""]],"verses":[["وَدَنيٌّ ضارِعٌ عَن أَمرِهِ","أَخَذَ العُربَ بِتيجانِ العَجَم",0,"م",1,0],["وَدَنا مِنّي فَقُلتُ لَهُ","أَنتَ واري الزِّندِ مأمولُ",1,"ل",1,0],["وَدَنَت كِباشٌ مِن كِباشٍ تَصطَلي","نارَ الكَريهَةِ أَو تَخوضُ لَظاها",2,"ا",3,0],["وَدَنا الشُجاعُ مِنَ الشُجاعِ وَأُشرِعَت","سُمرُ الرِماحِ عَلى اِختِلافِ قَناها",2,"ا",3,0],["وَدَنا تَسَمُّعُهُ إِلى","ما قالَ إِذ أَوصى بِها",3,"ب",3,0],["وَدَنَت كَأَنَّ شُعاعَها قَبسٌ","بادٍ وَإِن جَلَّت عَنِ المَثَلِ",4,"ل",1,0],["وَدُنيا وَجَدنا العَيشَ في غَفَلاتِها","طَريقاً إِلى وِردِ المَنِيَّةِ مَهيَعا",5,"ع",2,0],["وَدنيَاكَ الَّتي أَمسَيتَ فيها","مُزَايلةُ الشَقِيقِ عَنِ الشَّقيقِ",6,"ق",1,0],["ودَنَا وِردُ أيادي","هِ فقصرْت الرِّشاء",7,"ا",2,0],["ودنا بها سهلُ المديح فلم أقلْ","كم بين أكنافِ العذيب وحاجر",8,"ر",1,0],["وَدَنا المُغارُ لَها فَهُنَّ شَوازِبٌ","خَلَلَ المَطِيِّ كَأَنَّهُنَّ مَغالي",9,"ل",2,0],["وَدَّ نُفَيرٌ لِلمَكاوِرِ أَنَّهُم","بِنَجرانَ في شاءِ الحِجازِ المُوَقَّرِ",10,"ر",1,1],["ودنيءٍ تاريخُهُ في سِجِلِّ","الشَّرِّ إِفْكٌ وقِحَّةٌ ودَنَاءهْ",11,"ا",2,0],["ودنا يطوف بها الغمام كمصطل","بالنار يذكي جمرها او مزمع",12,"ع",1,0],["ودنا يهدم ما بنا","ه في الحياة بمعول",13,"ل",1,0],["وَدَنا العيدُ وَهُوَ لِلناسِ حَتّى","بَتَقَضّى وَأَنتَ لِلعيدِ عيدُ",14,"د",1,0],["ودَنَتْ ظِلالُ المَكرُماتِ وذُلِّلَتْ","أثمارُها للطَّالبينَ قُطُوفا",15,"ف",2,0],["وِدَنَوا فلم تَنُبِ القَنا عن جُنَّةٍ","منهم ولا نَبَتِ الظُّبا عن مِغفَرِ",16,"ر",1,0],["ودِنانٍ أُقِمْنَ صفّاً كما قا","مَ غَداةَ اللِّقاءِ رَجْلُ حُروبِ",17,"ب",1,0],["وَدُنياكَ بِالغَمِّ مَقرونَةٌ","فَلا يُقطَع العُمرُ إِلّا بِهَمّ",18,"م",1,0],["ودنا روضٌ وظلٌّ وغمام","بعد فتك النار بالعمر الجديب",19,"ب",1,0],["ودُنياكَ كَالحِرباءِ ذاتُ تَلَوُّنٍ","ومُبْيَضّها في العينِ أصْبَحَ مسوَدّا",20,"د",2,0],["ودَنا مِنكَ بِتَقبيلِ الثرى","كلّ قَرمٍ سَيِّدٍ وهوَ مَسود",21,"د",1,0],["وَدَنا فَحَيّاهُ النَبِيُّ وَكَبَّرَت","شُهَداءُ بَدرٍ حَولَ ذاكَ المَشهَدِ",22,"د",1,0],["وَدُنوّها مِن مُقلة مَكحولة","فَتّانةٍ فَتّاكةٍ حَوراءِ",23,"ا",2,0],["وَدِن دينَ رَبِّكَ حَتّى اليَقِينِ","واجتَنِبَنَّ الهَوى والضَجَم",24,"م",1,0],["وَدِنّا مَعَدّاً مِثلَ ما كانَ تُبَّعٌ","يَدينُهُمُ في كُلِّ حَقٍّ وَباطِلِ",25,"ل",1,0],["ودنا التَّوديع مَمَّنْ وَدِدْنا","أَنَّهم داموا لدينا غِضابا",26,"ب",2,0],["ودَنَا دُنُوّاً لا يُزَاحِمُ مَنْكِباً","فيه كما زَعَمَ المُكَيِّفُ مَنْكِبُ",27,"ب",1,0],["وَدَنَا فلا يَدُ آمِلٍ مُمْتَدَّةٌ","طَمَعَاً وَلا طَرْفٌ إليهِ طَموحُ",28,"ح",1,0],["وَدَنَوْا للوَداعِ حتى ترى الأج","يادَ فوقَ الأجياد كالأطواق",29,"ق",1,0],["ودنَتْ إليه الشمسُ حتى زُوحِمتْ","واخضَرّ منه الأفْقُ حتى أعشبا",30,"ب",2,0],["وَدِنانٍ مُسنَداتٍ","مُعلَماتٍ بِمِدادِ",31,"د",1,0],["وَدَنا إِلَيَّ وَقالَ نُصحُكَ واجِبٌ","زَيِّن خِصالَكَ هَذِهِ بِقِمارِ",32,"ر",1,0],["وَدُنيانا الَّتي عُشِقَت وَأَشقَت","كَذاكَ العِشقُ مَعروفاً شَقاءُ",33,"ق",3,0],["وَدُنياكَ إِن قَلَّت أَقَلَّت وَإِن قَلَت","فَمِن قَلَتٍ في الدينِ نَجَّت وَعَلَّتِ",34,"ت",1,0],["وَدُنياكَ غُرَّ بِها جاهِلٌ","فَتَبَّت عَلى كُلِّ حالٍ وَتَبّ",35,"ب",1,0],["وَدُنيايَ إِن وَهَبَت بِاليَمينِ","يَسارَ الفَتى أَخَذَت بِاليَسار",36,"ر",1,0],["وَدُنيايَ أَلقى بِطولِ الهَوانِ","وَهَل هِيَ إِلّا كَجِسرٍ عُبِر",37,"ر",1,0],["وَدُنياكَ دارٌ مَن يَحُلُّ فِناءَها","فَقَد غَمَسَتهُ في الشُرورِ القَوامِسُ",38,"س",1,0],["وَدُنياكُمُ الدارُ الَّتي ما تَضَمَّنَت","زَكيّاً فَلا تَبكوا أَثافِيَّها السُفعا",39,"ع",2,0],["وَدُنياكَ مِثلُ الإِناءِ الخَبيثِ","وَصاحِبُها مِثلُ كَلبٍ وَلَغ",40,"غ",1,0],["وَدُنياكَ لَيسَت لِلسُرورِ مُعَدَّةً","فَمَن نالَهُ مِن أَهلِها فَهُوَ سارِقُه",41,"ق",2,0],["وَدُنياكَ سارَت بِالأَنامِ مُغِذَّةً","فَلا فَرقَ فيها بَينَ سَيري وَسَيرِكا",42,"ك",2,0],["وَدُنياكَ يَهواها عَلى الهَرَمِ الفَتى","وَيَخدُمُها فيما يَنوبُ المُخَدَّمُ",43,"م",1,0],["وَدُنّا يَعَذولُ أَنّا سَلِمنا","مِن هَوانا وَلَم نُدانِ الدَنايا",44,"ا",3,0],["وَدَنا يُضيءُ صُبابُهُ","غاباً يُضَرِّمُهُ حَريقُه",45,"ق",2,0],["ودنا الليلُ ورنّتْ صدحةٌ","نبّهته حين لا يبغي انتباها",46,"ا",3,0],["ودَنَتْ جَنَّةُ المنى","وحلا عندها المقَرْ",47,"ر",1,0],["ودنا مني وغنَّاني النشيدا","فعرفتُ اللحنَ والصوتَ الوديعا",48,"ع",2,0],["ودنا الموعدُ فاهتجنا غناءَ","وتنظّرناكَ والليلُ عيونْ",48,"ن",1,0],["وَدَنَوْا من خِبَائها فَأَرَتْهم","ثَمَراتِ النُّهَى وَسِرَّ الكِتَاب",49,"ب",1,0],["ودنيا من الذكر الجميل عريضة","وكنزًا من المجد المؤثَّل باقيا",50,"ي",2,0],["ودنت فالتوى على صبح ساقيها","يناغي ويجتدي ويراود",51,"د",1,0],["ودنت من ترى ؟ أبا طفلتيها","وهو جذع من الجراحات هامد",51,"د",1,0],["ودنا من هنا الحريق وأومى","بارق الموت من هناك ولاحا",52,"ح",2,0],["ودنياك عشّ يغنّي ثراه","فتخضرّ أصداؤه في السقوف",53,"ف",1,0],["وَدَنَا العِيدُ، وَهوَ للنّاسِ، حَتّى","يَتَقَضّى، وأنتَ للعيدِ عِيدُ",54,"د",1,0],["ودنا بعثمانَ السرور وبشرت","أوقات مولده بعزٍّ ظاهرِ",55,"ر",1,0],["ودنت فما أزكى الربى بأريجها","ورنت فما أمضى ضبي الأحداقِ",56,"ق",1,0],["ودَنا فكان كقاب قوسَيْ حاجبٍ","في القربِ بل أدنَى هناك قِرانا",57,"ن",2,0],["وَدَنا النَجمُ يَستَقيلُ وَحارَت","كُلَّ يَومٍ ظَهيرَةٌ شَهباءُ",58,"ا",2,0],["ودنا ليغترق الهوى فتهالكت","أسراره فرمت به فرماها",59,"ا",3,0],["وَدَنا يُعاطينا سُلا","فَةَ ريقِهِ أَحلى تَعاطي",60,"ط",2,0],["ودنا إلى الملأ العليّ وقبله","لم يأت هذاك المقام عِباد",61,"د",1,0],["ودَنوتُ مِنها واضعاً إياهُ في","خصرٍ ليُنحلني تَنَطَّقَ ناحِلا",62,"ل",2,0],["وَدَنَوتُ منها وَهي عاتِبَةٌ","أُبدي العتابَ لها كما تُبدي",63,"د",2,0],["ودنا الخدانِ منْ بعضِهما","حينما الجيداِ هّما بالتلاقْ",64,"ق",1,0],["ودنونا من حجرة وضريح","لنبي الهدى ومسك الختام",65,"م",1,0],["وَدُنياكَ الَّتي غَرَّتكَ مِنها","زَخارِفُها تَصيرُ إِلى اِنجِذاذِ",66,"ذ",1,1],["وَدُنيانا وَإِن مِلنا إِلَيها","وَطالَ بِها المَتاعُ إِلى اِنقِضاءِ",67,"ا",2,0],["ودنا الشاطىء البعيد فرفقاً","بسفيني يا آخر العاصفات",68,"ت",1,0],["ودنت من يدي فشبّت لهيبي","وأثارت عواطفي النعسانه",69,"ن",2,0],["ودنيا الملائك فوق السحاب","ونملُ التراب وطير السديم",70,"م",1,0],["ودنا مني فأدنى","وجهه للثمّات",71,"ت",1,0],["ودناه حينما يضع","ف كفران وعاب",72,"ب",1,0],["وَدُنتُ كَما دانَ الدُعاةُ لِحُسنِها","بِخَلعِ التُقى فيها وَلَيسَ التَقِيَّةِ",73,"ه",1,0],["وَدَنَت وَقَد لَعب الهَوى","بِعُقولنا وَتَحَكَّما",74,"م",2,0],["وَدَنا وَأَتحَفَني وَأَطفَأ لَوعَتي","وَشَفى فُؤادي من تلهف بَعده",75,"د",2,0],["وَدنا يَوَدّ عنى فَلا وَأَبيكَ ما","بَقيتَ لَدى التَوديع في حياة",76,"ه",1,0],["وَدِنانُها هامُ الكُماةِ وَإِنَّما","يَنزِلنَ مِن طُرُقِ الشَبابِ بِمَنزِلِ",77,"ل",1,0],["ودنت أحلامنا منا , ولكن","قد كساها الليل أسمالا ثقالا",78,"ل",2,0],["ودِنتَ بدينهِم في كلِّ حالٍ","وذاكَ لعمرك الحقّ اليقين",79,"ن",1,0],["ودنى الوصل فيا للّه","ما أهنا وأمرا",80,"ر",2,0],["ودنت تروم تحية فتسابقت","للقائها الألباب والأفكار",81,"ر",1,0],["ودُنُوُّها دِينٌ لكُمْ وفرائِضٌ","وسناؤها سُنَنٌ لكُمْ وشرائِعُ",82,"ع",1,0],["ودَنَتْ لَهُ الآمالُ حَتَّى خيَّلَتْ","أَنَّ النجومَ لَهُ ثمارٌ تُجْتَنى",83,"ن",2,0],["ودَنَتْ لَكَ الدُّنيا بِقاصِية المُنى","وَتَخَيَّرَتْ لَكَ فَوْقَ مَا تختارُ",84,"ر",1,0],["ودَنا ابنُ رُذْميرٍ يُزَلْزِلُ خَطوَهُ","أملٌ تقسَّم نفسَهُ وحِذارُ",84,"ر",1,0],["ودنا بِهِ أَجَلُ الرَّحِيلِ كَأَنَّهُ","أَجَلُ المماتِ دَنَا بِهِ المقدارُ",84,"ر",1,0],["ودَنَتْ لَهَا فِي آرُ تَحْتَ صَوارِمٍ","وَرِيَتْ بعزِّ المسلمينَ زُنودُها",85,"د",3,0],["ودنتم واعتقدتم أَن هذي","تقيات ويسلم من نواها",86,"ا",3,0],["ودنا النَّرْجِسُ الجَنِيُّ إِلى با","كورة الوَرْدِ بالعيونِ المراضِ",87,"ض",1,0],["ودنيا خداعٍ كالقذاة بمقلتي","وإن ملأتها من جمالٍ يروقُها",88,"ق",3,0],["ودنيا لسانُ الذمّ فيها محكَّمٌ","ولكنها عند الحسين مَحامدُ",89,"د",1,0],["وَدَنانيرِ بَهارٍ","في هَمايينِ غُصونِ",90,"ن",1,0],["ودنوا بنسبة عزمهم","ولكل مجتهندٍ نصيب",91,"ب",1,0],["وَدَنَا الجَميعُ لِلثمِ راحَتِهِ التي","هِيَ مَعدِنُ الأرزاقِ والأقسامِ",92,"م",1,0],["ودنتْ إلى فمِها أراقِمُ فرعِها","فتكلّفتْ بحِفاظِ كَنزِ الجوهري",93,"ر",2,0],["ودنا الفِراقُ وكان يبخلُ قبلَهُ","بلُجَين مدمَعِه فجادَ بتِبرِهِ",94,"ر",2,0],["ودنسناه بالأفهام حيناً","وبالأقوال والبحث المساق",95,"ق",1,0],["ودنا إليَّ مُعانقاً","ومصافِحاً خَدّي بخدِّكْ",96,"ك",1,0],["ودُنُوٍّ من دُمى هنَّ له","حين يشتاق إلى اللهو لُعَبْ",97,"ب",1,0],["ودِنْت من أَمْرِ الهوى","دهتْك مِنْه داهِيه",98,"ي",2,0],["ودنا فسكَّن نارَ قلبي خدُّه","أَسمعتُمُ ناراً بنارٍ تَنْطَفِي",99,"ف",2,0],["ودِنتُ بدينٍ غير ما كنت داينا","به ونَهاني سيّدُ الناسِ جعفرُ",100,"ر",1,0],["ودَنَت في هبُوبها مِشيَةَ النش","وانِ حَيرانَ بالمدامِ الشّمولِ",101,"ل",1,1],["وَدنا مِنهُ في المَجال فَولّى","راجِياً لِلنَجاة مِما اِعتَراه",102,"ا",2,0],["وَدَندَن العُود وَالقانون قامَ لَهُ","كَما أَردا بِما يُبديه مِن أَمر",103,"ر",1,0],["ودنوتمُ والدهر سلمٌ بعد ما","ملأ الحماة الكائنات كفاحا",104,"ح",2,0],["ودنت ساعة الرحيل فهم يغ","نيهمُ للرحيل ما مهدوه",105,"و",2,0],["ودنت تصيح الآن لي","أخلي الطريق بلا تواني",106,"ن",2,0],["ودنا فكان كقاب قوسين أو","كأدنى رتبة بسواه لم تتأهّل",107,"ل",1,0],["وَدَنَوْتُ ألثم كفَّه فَرَأيْت كي","ف تفجَّرُ الخِلْجَانُ والوديَانُ",108,"ن",1,0],["وَدنا اللثامُ فلاحَ من وجناتها","تفّاحها وترَقرقت أجفانُها",109,"ن",3,0],["وَدِن بوصال أكَّدَ الله فرضه","ففي ذاك تأليف الذي كنت فرقتا",110,"ت",2,0],["وَدُنيا قَد وُكِلتَ بِها كَفيلا","وَأَسنَدتُم لِمَولاها وَلاها",111,"ا",3,0],["وَدَنا لِسِدرَتِها فَأَحجَمَ واقِفاً","مِن دونِها الروحُ الأَمينُ زِحاما",112,"م",2,0],["ودنيّها عندي لأغلى قيمةً","من كل كنز فايق وغناءِ",113,"ا",2,0],["ودنا فلوان الرواسي دونه","دكت بعزم منه غير مكهم",114,"م",1,0],["وَدَنا لِيَشكُوَ ما عَنا","هُ فَكَلَّ عَنْ إِفْصاحِهِ",115,"ح",2,0],["ودنوت منه دنو حق أمره","فينا على افكارنا الابهام",116,"م",1,0],["ودنى بالهنا ولا ثم قرب","غير ذكر يبقيه وصف الثبات",117,"ت",1,0],["ودنيء علا به الجد حتى","اوطئت هام