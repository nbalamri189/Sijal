{"poems":[[95,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[49,"أيا قلبي أما تخشع","https://www.aldiwan.net/poem25231.html","الهزج"],[74,"ما ضر من لم يجد في الحب تعذيبي","https://www.aldiwan.net/poem18226.html","البسيط"],[74,"أما حماة فعيش ساكنها","https://www.aldiwan.net/poem18882.html","أحذ الكامل"],[74,"أهوى بمرشفه الشهي وقال ها","https://www.aldiwan.net/poem19469.html","الكامل"],[74,"أما حمى قاضي القضاة فإنني","https://www.aldiwan.net/poem19633.html","الكامل"],[53,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[53,"شكرت مديحي فيك إذ سبق الجدا","https://www.aldiwan.net/poem62981.html","الطويل"],[91,"صبوا على الاسماع نارا","https://www.aldiwan.net/poem44849.html","مجزوء الكامل"],[91,"لم يطمئن القوم في بغداد","https://www.aldiwan.net/poem44851.html","الكامل"],[91,"لقد رقد السمار حتى خلا النادي","https://www.aldiwan.net/poem44864.html","الطويل"],[46,"إما حججت فمقبول ومبرور","https://www.aldiwan.net/poem29981.html","البسيط"],[83,"أضاع وقاري من علقت جماله","https://www.aldiwan.net/poem61447.html","الطويل"],[50,"أيا من وجهه الداح","https://www.aldiwan.net/poem62530.html","الهزج"],[52,"أحبى فيم خليت","https://www.aldiwan.net/poem64745.html","الهزج"],[52,"دعاك الحب بالشعب","https://www.aldiwan.net/poem64830.html","الهزج"],[48,"أما حياتي فما لي عندها فرج","https://www.aldiwan.net/poem23350.html","البسيط"],[19,"عيني لا بد من سكب وتهمال","https://www.aldiwan.net/poem360.html",""],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85310","المجتث"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[53,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[117,"لم يبق من خبر الجعفي باقية","https://www.aldiwan.net/poem1743.html","البسيط"],[136,"أعادك من أسماء عيد مشوق","https://www.aldiwan.net/poem54790.html","الطويل"],[144,"أما حكيم فالتمست دماغه","https://www.aldiwan.net/poem2138.html","الكامل"],[164,"أحسنت في تدبير أمرك يا حسن","https://www.aldiwan.net/poem58795.html","الكامل"],[164,"يا دهر حسبك لا تغررك عاقبة","https://www.aldiwan.net/poem59093.html","البسيط"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[173,"إلى كم مناجاة الهموم العوازب","https://www.aldiwan.net/poem1604.html",""],[173,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[173,"أبت نوب الأيام إلا تماديا","https://www.aldiwan.net/poem1691.html",""],[197,"أما حان أن تشفي المستهام","https://www.aldiwan.net/poem13101.html","المتقارب"],[203,"أما حدثوك بأخبارها","https://www.aldiwan.net/poem45644.html","المتقارب"],[236,"ما بال أنفاس النسيم إذا سرت","https://www.aldiwan.net/poem44597.html","الكامل"],[240,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[275,"على الشاطىء المصري ضل فتى الشام","https://www.aldiwan.net/poem35638.html","الطويل"],[325,"في عالم الرؤيا رأيت ركابكم","https://www.aldiwan.net/poem61696.html","الكامل"],[369,"سواء تدان منهم وتناء","https://www.aldiwan.net/poem61015.html","الطويل"],[385,"ودادي غير منتقل","https://www.aldiwan.net/poem48753.html","مجزوء الوافر"],[411,"أما حان أن يشتفي المستهام","https://www.aldiwan.net/poem49505.html","المتقارب"],[463,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[463,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[484,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[541,"يا عوف ويحك هلا قلت عارفة","https://www.aldiwan.net/poem23858.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138403",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122712","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38926","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107212","الوافر"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133788","السريع"],[1149,"","https://poetry.dctabudhabi.ae/diwan/poem/67696","الطويل"],[1262,"","https://poetry.dctabudhabi.ae/diwan/poem/33026","الطويل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124499",""],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48935","الطويل"],[1970,"","https://poetry.dctabudhabi.ae/diwan/poem/132025","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28598","الوافر"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60868","الكامل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111282","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137284",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137534",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137367",""],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65100","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139890","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139979","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139889","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48436","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108029","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117995","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117845","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111432","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101370","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127122","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133127","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133168","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33716","المتقارب"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52170","الكامل"],[4791,"بيني وبينك","https://www.poetsgate.com/ViewPoem.aspx?id=37023",""],[4830,"يوم السيادة","https://www.poetsgate.com/ViewPoem.aspx?id=208801",""],[4955,"كم من مديح سطرته قصائد","https://www.poetsgate.com/ViewPoem.aspx?id=200985",""],[4984,"الْعَرَبَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=201917",""],[5002,"حورية البحر","https://www.poetsgate.com/ViewPoem.aspx?id=202370",""],[3271,"إني سائر للخلود","https://www.poetsgate.com/ViewPoem.aspx?id=103531",""],[585,"أما حان خوض المأزق المتلاحم","https://www.poetsgate.com/ViewPoem.aspx?id=161924",""],[3591,"أحق من ودعته بالدم المق","https://www.poetsgate.com/ViewPoem.aspx?id=149507",""],[5112,"البدر الراحل","https://www.poetsgate.com/ViewPoem.aspx?id=212708",""],[5187,"شبح الهزيمة","https://www.poetsgate.com/ViewPoem.aspx?id=29249",""],[5189,"أما حانَ","https://www.poetsgate.com/ViewPoem.aspx?id=190830",""],[5189,"طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=208519",""],[5376,"أضمخْ بنا كفنَ الأمواتِ أطيابا","https://www.poetsgate.com/ViewPoem.aspx?id=197585",""],[5431,"لقد تعب الجواد من الرُقادِ","https://www.poetsgate.com/ViewPoem.aspx?id=183034",""],[5431,"إلى شامي أنا راجعْ","https://www.poetsgate.com/ViewPoem.aspx?id=183085",""],[3294,"عجبا لقوم مسلمين بزعمهم","https://www.poetsgate.com/ViewPoem.aspx?id=173277",""],[5717,"حبتك طالعة بحسن المطلع","https://www.poetsgate.com/ViewPoem.aspx?id=170588",""],[5764,"الاصدقاء الثلاثه","https://www.poetsgate.com/ViewPoem.aspx?id=175121",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6192,"نقاط استفهام إلى شاعر صهيوني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63735&r=&rc=5",""]],"verses":[["إِمَّا حَلَفْتَ لَهَا وَوَعْدُكَ صَادِقٌ","فَلِمِثْلِهَا التَّوْكِيدُ بالأقْسَامِ",0,"م",1,0],["أَما حَقّي بِأَن أَنظُ","رَ لِلدُنيا وَما تَصنَع",1,"ع",1,0],["أما حماه فقد أضحى بدولتهِ","ملاذَ كل قصيِّ الدار محروب",2,"ب",1,0],["أما حماة فعيش ساكنها","صفو وكل زمانه سحَر",3,"ر",1,1],["أما حماه فنعم دار سيادة","نصبت بمدرجة الطريق جلالها",4,"ل",3,0],["أما حمى قاضي القضاة فإنني","عن جاهِهِ أروي الصحيح وماله",5,"ه",1,1],["أمَا حقُّ حامي عِرض مثلك أن يُرى","له الرفدُ والترفيهُ أَوْجَبَ واجبِ",6,"ب",1,0],["أما حسبُكم أن تطردوا الفقر وحدهُ","عن الناس حتى تطردوا الجهل والفقرا",7,"ر",2,0],["اما حياتي ف يالعرا","ق فانها ذهبت خسارا",8,"ر",2,0],["اما حقوق الابرياء فانما","عصفت بهن زوابع الاحقاد",9,"د",1,0],["ام احتازه الصياد في شرك له","ام اختطفته برثن الاجدل العادي",10,"د",2,0],["إِمّا حَجَجتَ فَمَقبولٌ وَمَبرورُ","مُوَفَّرُ الحَظِّ مِنكَ الذَنبُ مَغفورُ",11,"ر",1,1],["أَما حيلَةٌ فيهِ فَيَعشَقُ ساعَةً","عَسى رُقَيَّةٌ أُرقي بِها قَلبَهُ القاسي",12,"س",2,0],["أَما حانَ بَلى قَد حا","نَ لَو أَنَّكَ تَرتاحُ",13,"ح",1,0],["أَما حَسبُكِ أَنّي مِن","كِ طولَ اللَيلِ مَسبوتُ",14,"ت",1,0],["أَما حَسبُكِ يا أَسما","ءُ أَنّي مِنكِ في حَسبِ",15,"ب",1,0],["أَما حَياتي فَما لي عِندَها فَرَجٌ","فَلَيتَ شِعرِيَ عَن مَوتي إِذا قَدِما",16,"م",2,1],["أَمّا حَصانُ فَلَم تُحجَب بِكِلَّتِها","قَد طُفتُ في كُلِّ هَذا الناسِ أَحوالي",17,"ل",2,0],["أَما حَياتي فتخزى","مالَم أَجد فيك عزا",18,"ز",2,0],["أَمّا حَديثُكَ في العُقولِ فَمَشرَعٌ","وَالعِلمُ وَالحِكَمُ الغَوالي الماءُ",19,"ا",2,0],["أما حسْبُ امْرىء ٍ مِنْ وَعْدِ غيْثٍ","بصائب ودْقه برْقٌ ورعْدُ",20,"د",1,0],["أَمّا حَليلَة ُذُبيانٍ فَقَد كَرُمَت","في الفِعلِ مِنها فَلَم تَدنَس كَما دَنَسوا",21,"س",3,0],["أم احتَرقَت بالشَّوقِ نَفسُكُ أم بِهَا","جَوَى السُّقمِ في نِيرَانِها تَتَحَرَّقُ",22,"ق",1,0],["أما حكيمٌ فالتمست دماغه","ومقيل هامته بحد المنصل",23,"ل",1,1],["أما حلي فإن خوفك لم يدع","أهلاً بها للزائرين ولا وطن",24,"ن",1,0],["أما حططت رجالي في فنا ملك","لعزه تخضع الأيام إذ عانى",25,"ن",2,0],["أما حسن ان يعلم الله انكم","بريئون من وصف المداجى المخامر",26,"ر",1,0],["أَما حانَ لِلعَضبِ اليَمانيِّ أَن يُرى","بِيُمناكَ كالمِخراقِ في كَفِّ لاعِبِ",27,"ب",1,0],["أَما حانَ يا فَرعَي رَبيعَةَ أَن أَرى","بَناتِ الوَغى يَعلُو الرَوابي قَتامُها",28,"م",3,0],["أَما حانَ مِنكُم يَقظَةٌ وَاِنتِباهَةٌ","فَتُرضِي أَخا سُخطٍ وَتُسخِطُ راضيا",29,"ي",2,0],["أَما حانَ أَن تَشفي المُستَهامَ","بَزَورةِ وَصلٍ وَتَأوي لَهُ",30,"ه",1,1],["أما حدثوكَ بأخبارها","وقد نزلَ البينُ في دارِها",31,"ر",3,1],["إما حللت بذلك المغنى الذي","فيه عيون المكرمات تفجرت",32,"ت",1,0],["إِمّا حَبيبٌ ظاعِنٌ تَشتاقُهُ","أَو هاجِرٌ تَعنو لَديهِ وَتَخضَعُ",33,"ع",1,0],["أما حان أن يصحو السكارى وقد غدوا","أسارى حَيارى جامدينَ كأصنام",34,"م",1,0],["اَمّا حِكِمدارِ الجُنودِ فَلَم أَكُن","مُتَذَكِّراً لِحُضورَةِ بِالحَفلَةِ",35,"ه",1,0],["أما حانَ لي من أَرحُلِ العيسِ رحلةٌ","فقد طال فيها يا أُميمُ ثوائي",36,"ا",2,0],["أَما حَصَلت مِن وَرَع","سِوى عَذل عَلى غَزَل",37,"ل",1,0],["أمَا حانَ أن يَشتفي المُستَهامُ","بزَوْرَةٍ وَصْلٍ وتأوي لَهُ",38,"ه",1,1],["أمّا حماه أسد وصِيدُها","فقد عرفتُ الشمّ من أعلامِها",39,"م",3,0],["إما حضرتَ فجُنَّتي أو بنت عَن","وطني فجودُك خيرُ زادِ مسافرِ",40,"ر",1,0],["إما حياة ترتضى","أو هكذا في صخب",41,"ب",1,0],["أَما حَزِنتَ مِنَ الأَقوامِ إِذ حَسَدوا","مِن أَن تَقولَ وَقَد عايَنتَهُ قَرَعا",42,"ع",2,0],["ام احتفالٌ عجيبٌ لا نظير له","سعى له القومُ مسروراً وجذلانا",43,"ن",2,0],["أمّا حَضُورُ وَيَوماها اللَّذانِ بِها","كانا لَكُم فيهِما صِفّين وَالجَمَلُ",44,"ل",1,0],["أَما حقَّ لِلأَكوانِ رقص قُدودِها","وَقَد ضاءَ في أَكنافِها كَوكَبُ السّعدِ",45,"د",1,0],["أَما حُدِّثتِ عَن نارٍ بِقَلبي","مِنَ الأَشواقِ تَشتَعِلُ اشتِعالا",46,"ل",2,0],["أما حبيبي فهو ذاك الشذا","كأنه طيف الهنا الأزرق",47,"ق",1,0],["أَمَا حَسَنٌ فابنُ الذي كانَ قَبْلَهُ","إذا سَارَ الموتُ حَيْثُ يَسِيرُ",48,"ر",1,0],["أَما حَسبُنا مِن عَبدِ رَبٍّ وَصَحبَهُ","شَجىً ناشِبٌ لَم تَبتَلِعهُ الحَناجِرِ",49,"ر",1,0],["أما حان للدمع المصون انسكابه","وللبين من تهواه زمت ركابه",50,"ب",2,1],["أَما حابسٌ أعضاءه عن نموّها","وثاقٌ شديدٌ أمره وعجيب",51,"ب",1,0],["أما حوانيت عاشور فزينتها","أربت على ما مضى وشيا وتلوينا",52,"ن",2,0],["أَما حَيّاكُمُ عَبقُ النَّسيمِ","فَيُخبِرُ عَن ثَرى تِلكَ الرُّسومِ",53,"م",1,1],["أما حدوجك فالدياجي والضُحى","والكُثبُ فيها والغصونُ الميّلُ",54,"ل",1,0],["أما حرمت لسوء حظي نصركم","بيدي فها أنا بالرثاء لمعتني",55,"ن",2,0],["اما حديث المجد فهو مسلسلٌ","فيهم فلا يوهي ولا يتقضب",56,"ب",1,0],["أم أحرف سطرتها","يا أيها المولى الكريم",57,"م",1,0],["أما حسين فبحر فضل ينتمى","أبدى لنا درر الذكاء جهارا",58,"ر",2,0],["أما حنّ جذعٌ والبعيرُ لهُ اشتكى","أما بلسان الظّبي خُوطب والضّب",59,"ب",1,0],["أما حديثُ الهوى فحقٌ","يصرف بلواه كلُّ حادث",60,"ث",1,0],["أما حسَمَ الكفْرَ الصريحَ ح