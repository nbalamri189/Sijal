{"poems":[[93,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[47,"أيا قلبي أما تخشع","https://www.aldiwan.net/poem25231.html","الهزج"],[72,"ما ضر من لم يجد في الحب تعذيبي","https://www.aldiwan.net/poem18226.html","البسيط"],[72,"أما حماة فعيش ساكنها","https://www.aldiwan.net/poem18882.html","أحذ الكامل"],[72,"أهوى بمرشفه الشهي وقال ها","https://www.aldiwan.net/poem19469.html","الكامل"],[72,"أما حمى قاضي القضاة فإنني","https://www.aldiwan.net/poem19633.html","الكامل"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"شكرت مديحي فيك إذ سبق الجدا","https://www.aldiwan.net/poem62981.html","الطويل"],[89,"صبوا على الاسماع نارا","https://www.aldiwan.net/poem44849.html","مجزوء الكامل"],[89,"لم يطمئن القوم في بغداد","https://www.aldiwan.net/poem44851.html","الكامل"],[89,"لقد رقد السمار حتى خلا النادي","https://www.aldiwan.net/poem44864.html","الطويل"],[44,"إما حججت فمقبول ومبرور","https://www.aldiwan.net/poem29981.html","البسيط"],[81,"أضاع وقاري من علقت جماله","https://www.aldiwan.net/poem61447.html","الطويل"],[48,"أيا من وجهه الداح","https://www.aldiwan.net/poem62530.html","الهزج"],[50,"أحبى فيم خليت","https://www.aldiwan.net/poem64745.html","الهزج"],[50,"دعاك الحب بالشعب","https://www.aldiwan.net/poem64830.html","الهزج"],[46,"أما حياتي فما لي عندها فرج","https://www.aldiwan.net/poem23350.html","البسيط"],[19,"عيني لا بد من سكب وتهمال","https://www.aldiwan.net/poem360.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85310","المجتث"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[111,"لم يبق من خبر الجعفي باقية","https://www.aldiwan.net/poem1743.html","البسيط"],[130,"أعادك من أسماء عيد مشوق","https://www.aldiwan.net/poem54790.html","الطويل"],[138,"أما حكيم فالتمست دماغه","https://www.aldiwan.net/poem2138.html","الكامل"],[158,"أحسنت في تدبير أمرك يا حسن","https://www.aldiwan.net/poem58795.html","الكامل"],[158,"يا دهر حسبك لا تغررك عاقبة","https://www.aldiwan.net/poem59093.html","البسيط"],[158,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[167,"إلى كم مناجاة الهموم العوازب","https://www.aldiwan.net/poem1604.html",""],[167,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[167,"أبت نوب الأيام إلا تماديا","https://www.aldiwan.net/poem1691.html",""],[191,"أما حان أن تشفي المستهام","https://www.aldiwan.net/poem13101.html","المتقارب"],[197,"أما حدثوك بأخبارها","https://www.aldiwan.net/poem45644.html","المتقارب"],[229,"ما بال أنفاس النسيم إذا سرت","https://www.aldiwan.net/poem44597.html","الكامل"],[233,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[268,"على الشاطىء المصري ضل فتى الشام","https://www.aldiwan.net/poem35638.html","الطويل"],[318,"في عالم الرؤيا رأيت ركابكم","https://www.aldiwan.net/poem61696.html","الكامل"],[362,"سواء تدان منهم وتناء","https://www.aldiwan.net/poem61015.html","الطويل"],[377,"ودادي غير منتقل","https://www.aldiwan.net/poem48753.html","مجزوء الوافر"],[402,"أما حان أن يشتفي المستهام","https://www.aldiwan.net/poem49505.html","المتقارب"],[456,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[456,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[477,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[534,"يا عوف ويحك هلا قلت عارفة","https://www.aldiwan.net/poem23858.html","البسيط"]],"verses":[["إِمَّا حَلَفْتَ لَهَا وَوَعْدُكَ صَادِقٌ","فَلِمِثْلِهَا التَّوْكِيدُ بالأقْسَامِ",0,"م",1,0],["أَما حَقّي بِأَن أَنظُ","رَ لِلدُنيا وَما تَصنَع",1,"ع",1,0],["أما حماه فقد أضحى بدولتهِ","ملاذَ كل قصيِّ الدار محروب",2,"ب",1,0],["أما حماة فعيش ساكنها","صفو وكل زمانه سحَر",3,"ر",1,1],["أما حماه فنعم دار سيادة","نصبت بمدرجة الطريق جلالها",4,"ل",3,0],["أما حمى قاضي القضاة فإنني","عن جاهِهِ أروي الصحيح وماله",5,"ه",1,1],["أمَا حقُّ حامي عِرض مثلك أن يُرى","له الرفدُ والترفيهُ أَوْجَبَ واجبِ",6,"ب",1,0],["أما حسبُكم أن تطردوا الفقر وحدهُ","عن الناس حتى تطردوا الجهل والفقرا",7,"ر",2,0],["اما حياتي ف يالعرا","ق فانها ذهبت خسارا",8,"ر",2,0],["اما حقوق الابرياء فانما","عصفت بهن زوابع الاحقاد",9,"د",1,0],["ام احتازه الصياد في شرك له","ام اختطفته برثن الاجدل العادي",10,"ي",1,0],["إِمّا حَجَجتَ فَمَقبولٌ وَمَبرورُ","مُوَفَّرُ الحَظِّ مِنكَ الذَنبُ مَغفورُ",11,"ر",1,1],["أَما حيلَةٌ فيهِ فَيَعشَقُ ساعَةً","عَسى رُقَيَّةٌ أُرقي بِها قَلبَهُ القاسي",12,"ي",1,0],["أَما حانَ بَلى قَد حا","نَ لَو أَنَّكَ تَرتاحُ",13,"ح",1,0],["أَما حَسبُكِ أَنّي مِن","كِ طولَ اللَيلِ مَسبوتُ",14,"ت",1,0],["أَما حَسبُكِ يا أَسما","ءُ أَنّي مِنكِ في حَسبِ",15,"ب",1,0],["أَما حَياتي فَما لي عِندَها فَرَجٌ","فَلَيتَ شِعرِيَ عَن مَوتي إِذا قَدِما",16,"م",2,1],["أَمّا حَصانُ فَلَم تُحجَب بِكِلَّتِها","قَد طُفتُ في كُلِّ هَذا الناسِ أَحوالي",17,"ل",2,0],["أَما حَياتي فتخزى","مالَم أَجد فيك عزا",18,"ز",2,0],["أَمّا حَديثُكَ في العُقولِ فَمَشرَعٌ","وَالعِلمُ وَالحِكَمُ الغَوالي الماءُ",19,"ا",2,0],["أما حسْبُ امْرىء ٍ مِنْ وَعْدِ غيْثٍ","بصائب ودْقه برْقٌ ورعْدُ",20,"د",1,0],["أَمّا حَليلَة ُذُبيانٍ فَقَد كَرُمَت","في الفِعلِ مِنها فَلَم تَدنَس كَما دَنَسوا",21,"س",3,0],["أم احتَرقَت بالشَّوقِ نَفسُكُ أم بِهَا","جَوَى السُّقمِ في نِيرَانِها تَتَحَرَّقُ",22,"ق",1,0],["أما حكيمٌ فالتمست دماغه","ومقيل هامته بحد المنصل",23,"ل",1,1],["أما حلي فإن خوفك لم يدع","أهلاً بها للزائرين ولا وطن",24,"ن",1,0],["أما حططت رجالي في فنا ملك","لعزه تخضع الأيام إذ عانى",25,"ن",2,0],["أما حسن ان يعلم الله انكم","بريئون من وصف المداجى المخامر",26,"ر",1,0],["أَما حانَ لِلعَضبِ اليَمانيِّ أَن يُرى","بِيُمناكَ كالمِخراقِ في كَفِّ لاعِبِ",27,"ب",1,0],["أَما حانَ يا فَرعَي رَبيعَةَ أَن أَرى","بَناتِ الوَغى يَعلُو الرَوابي قَتامُها",28,"م",3,0],["أَما حانَ مِنكُم يَقظَةٌ وَاِنتِباهَةٌ","فَتُرضِي أَخا سُخطٍ وَتُسخِطُ راضيا",29,"ي",2,0],["أَما حانَ أَن تَشفي المُستَهامَ","بَزَورةِ وَصلٍ وَتَأوي لَهُ",30,"ه",1,1],["أما حدثوكَ بأخبارها","وقد نزلَ البينُ في دارِها",31,"ر",3,1],["إما حللت بذلك المغنى الذي","فيه عيون المكرمات تفجرت",32,"ت",1,0],["إِمّا حَبيبٌ ظاعِنٌ تَشتاقُهُ","أَو هاجِرٌ تَعنو لَديهِ وَتَخضَعُ",33,"ع",1,0],["أما حان أن يصحو السكارى وقد غدوا","أسارى حَيارى جامدينَ كأصنام",34,"م",1,0],["اَمّا حِكِمدارِ الجُنودِ فَلَم أَكُن","مُتَذَكِّراً لِحُضورَةِ بِالحَفلَةِ",35,"ه",1,0],["أما حانَ لي من أَرحُلِ العيسِ رحلةٌ","فقد طال فيها يا أُميمُ ثوائي",36,"ا",2,0],["أَما حَصَلت مِن وَرَع","سِوى عَذل عَلى غَزَل",37,"ل",1,0],["أمَا حانَ أن يَشتفي المُستَهامُ","بزَوْرَةٍ وَصْلٍ وتأوي لَهُ",38,"ه",1,1],["أمّا حماه أسد وصِيدُها","فقد عرفتُ الشمّ من أعلامِها",39,"م",3,0],["إما حضرتَ فجُنَّتي أو بنت عَن","وطني فجودُك خيرُ زادِ مسافرِ",40,"ر",1,0],["إما حياة ترتضى","أو هكذا في صخب",41,"ب",1,0],["أَما حَزِنتَ مِنَ الأَقوامِ إِذ حَسَدوا","مِن أَن تَقولَ وَقَد عايَنتَهُ قَرَعا",42,"ع",2,0]]}