{"poems":[[75,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[85,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[53,"إذا عرضت لحية للفتى","https://www.aldiwan.net/poem8715.html","المتقارب"],[91,"متى تحضر تطب يا عذل بالا","https://www.aldiwan.net/poem44966.html","الوافر"],[87,"أحق أنهم دفنوا عليا","https://www.aldiwan.net/poem7117.html","الوافر"],[87,"يا غاب بولون ولي","https://www.aldiwan.net/poem63721.html","مجزوء الكامل"],[33,"أرقت ولم آرق لسقم أصابني","https://www.aldiwan.net/poem41851.html","الطويل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42632","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55227","الكامل"],[154,"لكل نبي عصمة وأمانة","https://www.aldiwan.net/poem68578.html","الطويل"],[185,"سقى الله الدوافع من حفير","https://www.aldiwan.net/poem58835.html","الوافر"],[261,"قولا لمن إحسانه لم يزل","https://www.aldiwan.net/poem48417.html","السريع"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[325,"يا حسن حظ الأرثوذكس وحزبها","https://www.aldiwan.net/poem67197.html","الكامل"],[333,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[369,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[376,"ما يصبح العاذل معذورا","https://www.aldiwan.net/poem57393.html","السريع"],[382,"يا غافلا والإثم حل بأرضه","https://www.aldiwan.net/poem59360.html","الكامل"],[422,"بقيت بقاء الدهر هل أنت عالم","https://www.aldiwan.net/poem53868.html","الطويل"],[438,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[449,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[449,"عفوت حتى لا أريد العتاب","https://www.aldiwan.net/poem56002.html","عموديه"],[463,"لمن دار على إضم","https://www.aldiwan.net/poem55893.html","مجزوء الوافر"],[463,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[567,"هذا ابن إبراهيم فيعاني الذي","https://www.aldiwan.net/poem52546.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"منازل خلق قدرهن نصيب","https://www.aldiwan.net/poem56778.html","الطويل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112439","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53893","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104587","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122310","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70667","المنسرح"],[990,"","https://poetry.dctabudhabi.ae/diwan/poem/202387","الكامل"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96463","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61060","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95390","الطويل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114038","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124741","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47191","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47152","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204735","المتقارب"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82825","الرمل"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89385","الطويل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199029","الرجز"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97074","الطويل"],[585,"أما حان خوض المأزق المتلاحم","https://www.poetsgate.com/ViewPoem.aspx?id=161924",""],[5410,"هواجس على أسوار بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=152248",""],[5431,"دورة الشرّ","https://www.poetsgate.com/ViewPoem.aspx?id=213762",""],[5582,"نَفْسُ المُتَيَّمِ لَوْ ظَلَلْتَ تَلُومُها","https://www.poetsgate.com/ViewPoem.aspx?id=187301",""],[5720,"لَكَ اللَّهُمَّ ..","https://www.poetsgate.com/ViewPoem.aspx?id=199022",""],[5736,"ابتسام","https://www.poetsgate.com/ViewPoem.aspx?id=208410",""]],"verses":[["فَنَقضِيَ أَوطارَ المُنى مِن زِيارَةٍ","لَنا كَلَفٌ مِنها بِما نَتَكَلَّفُ",0,"ف",1,0],["فنقص هلال الأفق ما زال مؤذناً","لمرآه أن يبدو لنا وهو كاملُ",1,"ل",1,0],["فنُقصانُ عقلِ الفتى عندنا","بمقدار ما زاد في لحيتِهْ",2,"ه",1,0],["فنقرأ في ظُلامتنا كتاباً","ونشكو في حضورٍ منك حالا",3,"ل",2,0],["فنقب عن مواضعها علىٌّ","فجدد دارسا وجلا خفيا",4,"ي",2,0],["فَنَقولُ عِندَكَ ما نَقو","لُ وَلَيسَ غَيرُكَ مَن يُعيد",5,"د",1,0],["فَنَقصُرَ عَنّا عَينَ مَن هُوَ كاشِحٌ","وَتَأتي وَلا نَخشى عَلَيكَ دَليلا",6,"ل",2,0],["فَنقَضَ العُهودَ والميثاقا","واستعملَ التَّشْغِيبَ والنِّفاقا",7,"ق",2,0],["فَنَقَّبَتْ وَجْنَتَيْهَا","يَدُ الْحَيَاءِ بِحُمْرَهْ",8,"ر",2,0],["فَنٌّ قَصَرْنَا هَمَّنَا فِيهِ عَلَى","عَتَبٍ وَأَعْتَابٍ وَبَثِّ غَرَامِ",9,"م",1,0],["فَنَقّى مِنَ الأَدناسِ جَوهَرَ قَلبِهِ","وَأَرسَلَهُ مِن بَعدُ خَيرَ مُنَبِّهِ",10,"ه",1,0],["فَنَقضِى حاجةً وَتُلِمُّ أُخرَى","وَلَولا كَرُّهُنَّ لقَد فَنِينَا",11,"ن",2,0],["فنقطةٌ من دم أوداجه","أنفع لي من رطل جلاب",12,"ب",1,0],["فَنقوشهُ علمٌ ضروريٌّ وما","تستنبطَ الأفكار عنها يتبعُ",13,"ع",1,0],["فَنَقولُ عَن مَحمود صِدقي دائِماً","تَسمو وَتَبلُغ ما تَشا مِن رتُبَةِ",14,"ه",1,0],["فنقصت دورك في الخيا","لِ لتكمليه في الحقيقه",15,"ه",1,0],["فنَقِّطْ كيف شئْتَ وذُمَّ عنّي","فأيّاً ما رَميتَ تُصِبْ لئاما",16,"م",2,0],["فنَقلته رحلةً رحلةً","سَعياً لها بالشكرِ مَشكورا",17,"ر",2,0],["فنقَضتَ يا ذا ما بنيتَ وبئسما","عانيتَ من هدم البناء ونقضه",18,"ض",2,0],["فنقّصْتَني شيئاً فشيئاً جوائزي","وأوْقَفْت حَظِّي منك في موقف الذل",19,"ل",1,0],["فنقا مشايتري فصهر يجي دسي","محراب ما ضع وهي كالمعمورةِ",20,"ه",1,0],["فنقيم لمجموع","وتشتيت به تخزى",21,"ا",1,0],["فنقتفيها لا تحس بنا","إلا وايدينا غدت في الرقاب",22,"ب",1,0],["فنقضِي في يدٍ ويدٍ","مآربَ من فم وفمِ",23,"م",1,0],["فنقلتَ بالإحسان تالدَ شيمتي","ونقضتَ شرطَ تقلّلي وتحشمي",24,"م",2,0],["فنقشتُ في اللوحِ المؤرَّخٍ راسِماً","سَكَبَتْ على أنطونَ رحمةُ رَبِّهِ",25,"ب",2,0],["فنقص الفرض وزاد فيه","وأدخل الأمة في التشبيه",26,"ه",1,0],["فنُقْصَانُ نَفْسٍ لا يُعَوَّضُ نَقْصُهُ","بفضلٍ، ولا يُغْنِي اللَّئِيمَ وَهُوبُ",27,"ب",1,0],["فنقتل الليل والأشواق في لهب","والقلب في طرب والناي في صخب",28,"ب",1,0],["فنقطف أَزهار المسرّات غضّةً","وطرفُ الرّدى جيرانُ في سِنَةِ السّهْوِ",29,"و",1,0],["فنقبِضُ أيدينا عليها كرامةً","ونَبسطُها بِشراً بأهلاً ومرحبا",30,"ب",2,0],["فنقول مسكين المتي","م بالنسيم يسيء ظنا",31,"ن",2,0],["فنقِّح الشعر في مدائحه","إنْ كنتَ بالحادثات متعظا",32,"ظ",2,0],["فنقلتها وعلمت أن مقامنا","منها يدمرنا فها هي سبسب",33,"ب",1,0],["فَنَقَلتُهُ تَقلَ البصِيرِ ولَم أَكُن","مِمَّن يُخَادِعُ نَفسَهُ ويُكَذِّبُ",34,"ب",1,0],["فَنقيل في تِلكَ الظلال وَللصبا","عبق العَبير وَللأراك حَفيف",35,"ف",1,0],["فنقطة هذا الحد فيها نهاية","ولا باب إلا أن تكون رعاية",36,"ه",1,0],["فنقبت الأيدي جوانبه إلى","أن اندك من بعد التشامخ والكبر",37,"ر",1,0],["فنقصي عينُ تكميلي لأني","شعارُ الدين أصبح في ختاني",38,"ن",2,0],["فنقص قيمته كسراً لصاحبه","من قده سالماً والعيب مكتنف",39,"ف",1,0],["فنقضتمُ العهدَ الذي قد أَوْثَقَتْ","كفُّ الشّريعة في يد الأسلاف",40,"ف",1,0],["فُنُقٌ صالحٌ رؤوفٌ رحيمٌ","يبتغي من نداك حسن المآل",41,"ل",1,0],["فَنَقُولُ فَرِّق بَينَ مَا أوَّلتَهُ","وَمَنَعتَهُ تَفرِيقَ ذِي بُرهَانش",42,"ن",2,0],["فَنَقُولُ أنتَ وَصَفتَهُ أيضاً بِمَا","يُفضِي إلَى التَّجسِيمِ والحِدثَانِ",42,"ن",1,0],["فَنَقُولُ قُلتَ كَذَا وَقَالَ نَبِيُّنَا","أيضاً كَذَا فَإمَامُنَا الوَحيَانِ",42,"ن",1,0],["فَنَقُولُ نَفيُكُم بِهَذَا الاصطِلاَ","حِ صِفَاتِهِ هُو أبطَلُ البُطلاَنِ",42,"ن",1,0],["فَنُقَدِّمُ المَعقُولَ ثُمَّ نُصَرِّفُ ال","مَنقُولَ بالتَّأويلِ ذِي الألوانِ",42,"ن",1,0],["فَنَقُومَ دُونَ القَبرِ وِقفَةَ خَاضِعٍ","مُتَذَلِّلٍ فِي السِّرِّ وَالإِعلاَنِ",42,"ن",1,0],["فنقموا عليهِ قبح فعلهِ","وبادروا حينئذٍ بقتلهِ",43,"ه",1,0],["فَنُقصَانُهُ في الجاهِ إصبَعُ بآصبَعٍ","تَجِدهُ على النَّتخاتِ كالنَّقشِ في الصَّخرِ",44,"ر",1,0],["فنقلق جيراننا بالصراخ","فخالوا لظى الحرب فينا استعر",45,"ر",1,0],["فَنَقيها كُلَّ عادي","رام بِالأَوطانِ غَدرا",46,"ر",2,0],["فنقطة السر بحر والحرف برها","ومن حرفها الحروف بدت بحكمة",47,"ه",1,0],["فنقّوا من الزمِّير والشوك أشهراً","وما زال فالكتان قشٌّ وقضبان",48,"ن",1,0],["فنقموا استخلاصه للحائك","وزيره فخر أي هالك",49,"ك",1,0],["فنقسم بالهادي عليك وصهره","وسبطيه والغر الميامين والزهرا",50,"ر",2,0],["فنقنع بالجهل الذي فيه راحةٌ","وننعم في غي الظنون الرواجم",51,"م",1,0],["فنقبع في صدى لهوٍ وجهلٍ","ويغوينا التفاخر والنسيبُ",52,"ب",1,0],["فنقاءُ البياض وهمُ المرايا","إنما الذات مَن بها الإحياءُ",53,"ا",2,0],["فُنُقٌ يَغَصُّ بِساقِها خَلْخالُها","وَيَجُولُ مِنْ فَوْقِ النِّطاقِ بَرِيمُها",54,"م",3,0],["فَنَقِّ بِعَفْوِكَ المَرْجُوِّ قَلْبِيْ","وَزِدْهُ طَهَارَةً مِمَّا لَدَيْكَا",55,"ك",2,0],["فنقاءُ قلبِ جميلتي وصفاؤهُ","إن لمْ يَفُقْ فُلّا، لكان شريكهْ",56,"ك",2,0]]}