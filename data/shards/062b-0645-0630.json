{"poems":[[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[91,"أنا لولا الرحمن والعفو منه","https://www.aldiwan.net/poem45102.html","الخفيف"],[396,"يا عمران زرت سيدنا الرسول","https://www.aldiwan.net/poem54519.html","عموديه"],[534,"أكؤوس مترعات من عقار","https://www.aldiwan.net/poem37409.html","الرمل"],[563,"كل تحريك تراه وسكون","https://www.aldiwan.net/poem33843.html","الرمل"],[563,"بدر تم لاح في الغسق","https://www.aldiwan.net/poem34335.html","المديد"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123689","المديد"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46511","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87333","الرجز"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124680","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62923","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62894","الخفيف"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129352","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110060","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111516","الرجز"],[4767,"لا تلمني","https://www.poetsgate.com/ViewPoem.aspx?id=178897",""],[4858,"أيّ نارٍ تصطليها كبدي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=138293",""]],"verses":[["ثُمَّ ذَبَحناها وَخَلَّصناهُما","وَأَمكَنَ الصَيدُ فَأَرسَلناهُما",0,"م",2,0],["ثم ذاك الصراخ يضعف حتى","يختفي في زفيرها المتمادي",1,"د",2,0],["ثم ذكرزين باعلوى بنا","وكذا هاشم ومن ثم حلول",2,"ل",1,0],["ثُمَّ ذَمَ في كلُ فن حائضاً","رَائِضاً جامِحهُ رَوْض اخْتبارِ",3,"ر",1,0],["ثم ذاك الشان في شان إلى","لا إلى مما تراه العارفون",4,"ن",1,0],["ثم ذوقوا ما بقي بفمي","من بقايا خمر كل تقي",5,"ق",2,0],["ثم ذكرت قولنا بجملته","في نقلها من بعد في ذريته",6,"ه",1,0],["ثم ذي النورين خير فتى","بجلابيب الحيا اشتملا",7,"ل",2,0],["ثُم ذَكَرت أَنَّني وَحَيد","بِينَهُم وَأَنَّهُم عَديد",8,"د",1,0],["ثُمَّ ذِراعَا الأسَدِ الضرغَامِ","هَذَا يَمَانيُّ وَهَذَا شَامي",9,"ي",1,0],["ثم ذابت على البحيرةِ امواجاً","وشوقاً وغلغلت في الترابِ",10,"ب",1,0],["ثم ذو قارٍ وقارٌ كاسمِهِ","ذِكره في أَوجهِ الأَعداءِ قَارُ",11,"ر",1,0],["ثم ذو العَبرةِ الذي لَبِسَ الحُز","نَ شعاراً وصيَّرَ الدمعَ كُحْلا",12,"ل",2,0],["ثم ذات الأصار يوم بفيض","غودرت بين طارد وطريد",13,"د",1,0],["ثُمذَ ارتَقى نحو السَماءِ وحُبُّهُ في قلبهم","متملِّكٌ مستحكمُ",14,"م",1,0],["ثم ذا اليَوم وَالصَباح صَباح","وَكَذا اللَيل وَالمَساء المَساء",15,"ا",2,0],["ثم ذيوميذ أجال العاملا","به أياس طالباً مقابلا",16,"ل",2,0],["ثم ذا الصدق جعفراً من إليه","قد أتى للعلوم قومٌ رُقِيا",17,"ي",2,0],["ثمّ ذا الحِبُّ قديماً عثرتْ","قدماهُ بصخور النّكَدِ",18,"د",1,0]]}