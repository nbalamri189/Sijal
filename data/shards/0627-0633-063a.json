{"poems":[[128,"أسغ لي غصتي وخلاك ذام","https://www.aldiwan.net/poem23802.html","الوافر"],[447,"استغفر الله من قولي ومن عملي","https://www.aldiwan.net/poem14291.html","البسيط"],[463,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102722","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53192","الوافر"]],"verses":[["أسغ لي غصتي وخلاك ذام","بكأس من سلافة بيت راس",0,"س",1,1],["اسغفر اللَه من أكلي الحرام ومن","شربه أو لبسه حلياً ومن جلل",1,"ل",1,0],["أسغْتَني الودَّ وهم","بين الغصاص والشرَقْ",2,"ق",1,0],["أسغفرُ اللَه من بعدٍ ومن بِدَع","ومن بلاء ومن بغيٍ ومن بخَلِ",3,"ل",1,0],["أسغت لي الحياة وكنت قدماً","على بقياي أختار الحِماما",4,"م",2,0]]}