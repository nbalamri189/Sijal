{"poems":[[23,"بني أسد ما بال آل خويلد","https://www.aldiwan.net/poem21467.html","الطويل"],[189,"تولى شباب واقتراب فأمعنا","https://www.aldiwan.net/poem14733.html","الطويل"],[190,"وما زالت بنو شيبان تبغي","https://www.aldiwan.net/poem43250.html","الوافر"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[473,"وستر لصاحبه نيقة","https://www.aldiwan.net/poem59806.html","المتقارب"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17042","الطويل"],[1340,"","https://poetry.dctabudhabi.ae/diwan/poem/105890",""],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108719","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100993","الطويل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96499","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102553","الوافر"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122461","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73151","الوافر"],[190,"وما زالت بنو شيبان تبغي","https://www.poetsgate.com/ViewPoem.aspx?id=101396",""]],"verses":[["تَرى ذاكَ في الشُبّانِ وَالمُردِ مِنهُمُ","مُبيناً وَفي الأَطفالِ مِنهُم وَفي الشُمطِ",0,"ط",1,0],["ترى ذا بطُرْز النَّوْر سُفْلا مُخَمَّلا","وذاك برَقْم البرق عُلْوا محسَّنا",1,"ن",2,0],["ترىذكرت بنو شيبان قولي","لهم كفّوا فإنّ الظلم لوم",2,"م",1,0],["تَرى ذنبَ الطاووسِ سهّم طرسه","يُحاكي بها منقاره الندف في العطبِ",3,"ب",1,0],["تَرى ذا عَلى رَأسِهِ خوذَةً","وَهَذا عَلى خَصرِهِ مِنطَقَه",4,"ق",2,0],["تَرى ذَهَباً أَلقَتهُ تَحتَ مَآخِرَ","لَها وَلُجَيناً نُطنَهُ بِالمَقادِمِ",5,"م",1,0],["ترى ذا الهوى جهلا لأحمد مبغضا","وتعرف ذا التقوى بحب ابن حنبل",6,"ل",1,0],["ترى ذكرت ليلى لويلتنا الغرا","فإنا سمعنا في الدجى أنةً حرّى",7,"ر",2,1],["ترى ذكرَ مصرٍ في الهياكل قُربةً","وفي صلوات المسلمين لها ذِكر",8,"ر",1,0],["ترى ذا الغنى والفقر من كل معشر","عصائب شتى ينتوون المفضلا",9,"ل",2,1],["ترى ذا وافدا يسعى إليها","وهذا عازم للانصراف",10,"ف",1,0],["ترى ذوِي العِلمِ عندَ الشَّيخِ خاضَعَةً","مِن ناكِسِ الرأسِ أَو مِن خاشِعِ البَصَرِ",11,"ر",1,0],["ترى ذاكَ الحبيبُ درَى بأنيِّ","يغيبُ الأُنس عنِّي مُذ يغيبُ",12,"ب",1,0],["ترىذكرت بنو شيبان قولي","لهم كفّكوا فإنّ الظلم لوم",13,"م",1,0]]}