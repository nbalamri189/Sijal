{"poems":[[95,"لانت صلاب العزائم","https://www.aldiwan.net/poem11341.html","المجتث"],[29,"عرفت الدار بعد بلى الخيام","https://www.aldiwan.net/poem5986.html","الوافر"],[39,"وأمة كان في أسلاف أولها","https://www.aldiwan.net/poem7334.html","البسيط"],[23,"أبلغ بني عامر عني مغلغلة","https://www.aldiwan.net/poem21503.html","البسيط"],[91,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[64,"الزئبق الأبيض الرقيق إذا","https://www.aldiwan.net/poem52189.html","المنسرح"],[64,"الفضة الرطبة ماء لنا","https://www.aldiwan.net/poem52214.html","الخفيف"],[47,"ميلوا إلى الدار من ليلى نحييها","https://www.aldiwan.net/poem66851.html","البسيط"],[46,"ألا ترى كيف يبلينا الجديدان","https://www.aldiwan.net/poem29999.html","البسيط"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[50,"اصبر لمر حوادث الدهر","https://www.aldiwan.net/poem63402.html","الكامل"],[48,"أكرم بياضك عن خطر يسوده","https://www.aldiwan.net/poem23590.html","البسيط"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85580","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54835","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54635","الرجز"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[106,"برقية عاجلة إلى بلقيس","https://www.poetsgate.com/ViewPoem.aspx?id=5117",""],[113,"ألا فانصحا من رام حمدان شاعرا","https://www.aldiwan.net/poem16304.html","الطويل"],[119,"بدأت ببسم الله في مبدأ الأمر","https://www.aldiwan.net/poem42205.html","الطويل"],[147,"بسعدك دارت في السماء الكواكب","https://www.aldiwan.net/poem11734.html","الطويل"],[276,"مضى زمن الصبا فدع التصابي","https://www.aldiwan.net/poem52055.html","الوافر"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[371,"لعمري لئن أضحى عن الغيد عاديا","https://www.aldiwan.net/poem17304.html","الطويل"],[371,"يعز على محلي مفارقة القطر","https://www.aldiwan.net/poem17317.html","الطويل"],[401,"وأمهم ضبع باتت تجر سلىً","https://www.aldiwan.net/poem571.html",""],[403,"في كفه لدنة مُثقفة","https://www.aldiwan.net/poem699.html",""],[463,"ألا يا خليلي المجتبى من خزيمة","https://www.aldiwan.net/poem56184.html","الطويل"],[466,"تمنى مقامي من تميم كليبها","https://www.aldiwan.net/poem15669.html","الطويل"],[505,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[520,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83305","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48779","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48540","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77632","الرجز"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105451","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59420","الطويل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133833","السريع"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25312","الرجز"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56594","السريع"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112808","الوافر"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109260","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109104","السريع"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64505","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141281","البسيط"],[1936,"","https://poetry.dctabudhabi.ae/diwan/poem/105195","الكامل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76807","الوافر"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123156","البسيط"],[2070,"","https://poetry.dctabudhabi.ae/diwan/poem/31547","الوافر"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109338","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109430","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77307","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137316",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137288",""],[2747,"","https://poetry.dctabudhabi.ae/diwan/poem/31512","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132789","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89416","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62831","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138524",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85199","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131066",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114399","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133303","البسيط"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95342","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95339","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111425","الرجز"],[3958,"","https://poetry.dctabudhabi.ae/diwan/poem/110716","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127078","الرجز"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103261","البسيط"],[4425,"","https://poetry.dctabudhabi.ae/diwan/poem/22586","المنسرح"],[4755,"قَصِيدةٌ أُخرَى وجُرحٌ جَدِيدْ","https://www.poetsgate.com/ViewPoem.aspx?id=184116",""],[4755,"قَصِيدةٌ أُخرَى وجُرحٌ جَدِيدْ","https://www.poetsgate.com/ViewPoem.aspx?id=191250",""],[4888,"معراج عشقي .. (في حب الرسول)","https://www.poetsgate.com/ViewPoem.aspx?id=207773",""],[4927,"هَاْتِفُ الْحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=29732",""],[5010,"أمتنا والفتنة الحمقاء","https://www.poetsgate.com/ViewPoem.aspx?id=190371",""],[5032,"خيال رجائي","https://www.poetsgate.com/ViewPoem.aspx?id=189500",""],[5338,"رمتني في صرفها الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=187598",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5442,"نمت ولم يجف كراك الجفون","https://www.poetsgate.com/ViewPoem.aspx?id=114769",""],[5464,"شبيه الياسمين يدا وخدا","https://www.poetsgate.com/ViewPoem.aspx?id=26637",""],[5512,"الأم ( غفوت )","https://www.poetsgate.com/ViewPoem.aspx?id=204345",""],[5616,"حلب","https://www.poetsgate.com/ViewPoem.aspx?id=203437",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5841,"شهريار وشهرزادي","https://www.poetsgate.com/ViewPoem.aspx?id=34907",""],[5925,"ودعت دارك رغم الشوق للدار","https://www.poetsgate.com/ViewPoem.aspx?id=617",""],[5970,"دعت فؤادي بليل الأمس غانية","https://www.poetsgate.com/ViewPoem.aspx?id=130649",""],[5977,"من يداويها ؟","https://www.poetsgate.com/ViewPoem.aspx?id=213280",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""]],"verses":[["وَأُمَّةٌ مِنْ سَجَايَا","بَادَتْ كَأَحْلامِ حَالِمْ",0,"م",1,0],["وَأُمُّهُمُ خَضافِ تَدارَكَتهُم","بِذَحلٍ في القُلوبِ وَفي العِظامِ",1,"م",1,0],["وأمة كان في أسلاف أولها","قول أصابت به العجماء مرتجلُ",2,"ل",1,1],["وَأُمُّهُ خَربَةُ الأُذنَينِ أَهلَكَها","حُبُّ السَفادِ لَدى الرُكبانِ وَالعارِ",3,"ر",1,0],["وأمها بالعويل صاحت","وبان صبري يُدنى خطاه",4,"ه",1,0],["وأمه في مجسّها حجر","لها جنى طيّب وأزهارُ",5,"ر",1,0],["وأمها في الرمز مكنونة","وهي نحاس يابس باردُ",6,"د",1,0],["وَأُمَّةٍ كانَ قُبحُ الجَورِ يُسخِطُها","دَهراً فَأَصبَحَ حُسنُ العَدلِ يُرضيها",7,"ي",3,0],["وَاِمهَد لِنَفسِكَ مِن قَبلِ المَماتِ وَلا","يَغرُركَ كَثرَةُ أَصحابٍ وَإِخوانِ",8,"ن",1,0],["وَأُمَّةٌ تَعبُدُ الأَوثَانَ قَدْ نُصِبَت","لها التَّصاوِيرُ يَوْماً والتَّماثِيلُ",9,"ل",1,0],["وأُمَّةٌ ذَهَبت لِلعِجلِ عابِدَةً","فَنالَها مِن عَذابِ اللَّهِ تَعجِيلُ",9,"ل",1,0],["وأُمَّةٌ زَعَمَتْ أنَّ المَسِيحَ لها","رَبٌّ غَدا وَهوَ مَصلُوبٌ وَمَقْتُولُ",9,"ل",1,0],["وَاِمهَد لِنَفسِكَ قَبلَ ميتَتِها","وَاِذخَر لِيَومِ تَفاضُلِ الذُخرِ",10,"ر",1,0],["وَأُمُّهُ تَسأَلُ العَرّافَ قاضِيَةً","عَنهُ النُذورَ لَعَلَّ اللَهَ يُبقيهِ",11,"ق",3,0],["وَأَمَهَلتُ أَهلَ الدَارِ حَتّى تَظَاهَرُوا","عَلَيَّ وَقالَ العُريُ مِنهُم فأَهجَرا",12,"ر",2,0],["وأمهات لناس","في الحط منهن تغلو",13,"ل",2,0],["وَأُمَّهَاتٍ تَتَجَلّى بِهَا","مَزِيَّةُ الآتِي عَلَى الْغَابِرْ",14,"ر",1,0],["وَأُمَّةٌ أَنْتَ فَتَاهَا المُرْتَجَى","فِي كُلِّ مَا تَبْغِي وََيَنْأَى مَطْلَبَا",15,"ب",2,0],["وَأُمَّةٌ أنْتَ مَجْرِيهَا وَحَافِزُهَا","في حَلْبَةِ السَّبْقِ لاَ تُبْقي عَلَى القَصَبِ",16,"ب",1,0],["وأمةً عجباً ... ميلادها يمنٌ","كم قطعتْ يمناً ... كم مزقتْ يمنا",17,"ن",2,0],["وَأَمهرها مَن لَيسَ في الناس كُفؤُها","فَضلت لَدى تِلكَ المَنازل عَن رَشد",18,"د",1,0],["وأمهما والتابعين لحزبهم","إلى منتهى الأيام في البر والبحر",19,"ر",1,0],["وَأَمهَلتَهُم حَتّى لَظَنّوكَ عاجِزاً","وَما يَستَوي المَغلوبُ وَالمُتَغالِبُ",20,"ب",1,0],["وأمة امة عملا وَعلما","نَقي العرض عَن عار وَعاب",21,"ب",1,0],["وَأَمهَلَها من ربّها إذ تقاعَست","عَفافٌ يعدّ الحلّ مِن وصلِها ذنبا",22,"ب",2,0],["وَأَمهَرتُمُ الدُنيا سُيوفاً بَواسِماً","نَكَحنَ رِقاباً لِلأَعادي بَواكِيا",23,"ي",2,0],["وَأَمهَلَهُم بَعدي إِلى أَن يُجيزَهُم","بِقَبري فَيَجري مِن حَديثِيَ ما يَجري",24,"ر",2,0],["وأُمُّهُمُ ضُبعٌ باتت تجُرُّ سِلىً","بالجَزعِ بين مُجبراتٍ وهَبُّودِ",25,"د",1,1],["وأُمُّها خَيرَةُ النِّساءِ على","ما خانَ مِنها الدِّحاقُ والأتَمُ",26,"م",1,0],["وأمهرتموها وارتجعتم صداقَها","فهل تستحلّون النكاح بلا مَهرِ",27,"ر",1,0],["وأمهي بنَعماهُ غُروب خواطِرٍ","نبَتْ من وقوع الحادثات الإَواشم",28,"م",1,0],["وأُمُّهُمْ فاطمةٌ","زوجُ أَبي الآلِ عَلي",29,"ل",2,0],["وامهد لهم أكناف هيبتك التي","جعلت تذللهم عليك تدللا",30,"ل",2,0],["وَأُمَّةُ عُثمانٍ أَزالَت بِلَحظَةٍ","بِهِ باللَيالي البيضِ أَيّامَها السَمرا",31,"ر",2,0],["وأمة تتلقى من مصائرها","إليه ما شاءت النجوى وتغتنم",32,"م",1,0],["وأمه تقول يا","نعمان يا معذبي",33,"ب",2,0],["وَأُمُّهُ النَعجَة ذات اللَبنَ","أَنحرها إِن قالَت اترُك اِبني",34,"ي",1,0],["وأمهم منه معقود عليه لواً","عز على قومه الماضين معقود",35,"د",1,0],["وأمهم في صلاة الحرب أعلمهم","بالفتح والنصر في الوقت الذي أزفا",36,"ف",2,0],["وأمهر بكر الأرض در الحيا ومن","يريد افتضاض البكر فليجزل المهرا",37,"ر",2,0],["وأمّة طارت بها ليلها","بأجنح الصقر وعزم البزاة",38,"ه",1,0],["وَأُمَّةٍ تَحَزَّبَت أَحْزَابُها","مِنْ ساسَة النَّاسِ وَمَن أَرْبابُها",39,"ب",3,0],["وأمّة ما اشبهت أمّة","تفردت بالغدر بين الأنام",40,"م",1,0],["وأمهلهم كثيراً والبلا منهم","نحو المكرم في ترام",41,"م",1,0],["وامهليني حيناً فسوف أولِّي","وارحمي فيك ضعفيَ الأبويَّا",42,"ي",2,0],["وأمة ناطت بكم أمرها","ترجو بكل إصلاح ما شانه",43,"ن",2,0],["وإمهالك الأعداء مقت يلفهم","إلى نقمة موعودة مقسطية",44,"ه",1,0],["وأمّهم مزّق الحدثان مهجتها","وقطّع الدّهر منها اليوم أوصالا",45,"ل",2,0],["وامهد لقبرك إنما الحسنى بها","تقضي لمن قد أحسن التمهيدا",46,"د",2,0],["وامهما وعمي خير هادٍ","وسائر صحبه أزكى فريق",47,"ق",1,0],["وأمهلاه رويداً كي يفوز بما","يرجوه من مأكل في نيله طمعا",48,"ع",2,0],["وَأَمهَلَها فَلَمّا وَرَّكَتهُ","شِمالاً وَهِيَ مُعرِضَةٌ تَهيجُ",49,"ج",1,0],["وأمة منهم لقد لعلعت","أصواتها عند رُبى لعلع",50,"ع",1,0],["وأمهرتها عقلي مقابلةً بما","وفتني على رغم العدو المشاغب",51,"ب",1,0],["وَأُمَّةً في رُبوعِ النيلِ جامِدَةً","وَفَوقَها رُكنُ صَرحِ المَجدِ يَنهارُ",52,"ر",1,0],["وامهم بهم غدت الليالي","لها تصفو وقد صفت الورود",53,"د",1,0],["وامه فلتطب نفساً بمولده","قريرة العين في الآصال والبكر",54,"ر",1,0],["وَأَمهَلتُ في إِخوانِهِ فَكَأَنَّما","يُسَمَّعُ بِالنَهيِ النَعامُ الشَوارِدُ",55,"د",1,0],["وامه البضعة الزهراء","ومن لها الرتبة العلياء",56,"ا",2,0],["وأمة كانت على ضلال","هداهم بقوله الجلي",57,"ي",1,0],["وأمهلَ عثرةَ الجاني أناةً","يُقَدّمُ زَجرَهُ قبلَ العِقابِ",58,"ب",1,0],["وأمها خيرة النسوان أول من","لبت ندا أحمدٍ والخلق مدبرة",59,"ر",2,0],["وأمهر أعيني يا قوت دمعي","وزوجها سهاداً ليس يفنى",60,"ن",2,0],["وأمها تارة تقبلها","وتارة بالقضيب توعدها",61,"د",3,0],["وامهر به عرباً في جنةٍ خضلت","وناج ربكَ في جنحٍ من الظلمِ",62,"م",1,0],["وأمة انكلترا تخبو اشعتها","فيرجعون إلى التاميز عميانا",63,"ن",2,0],["وأُمّة جماعة من البَشَر","والأُمّة الحين ومنه وادّكَر",64,"ر",1,0],["وأُمة والأَب بكران ورَد","يا بكر بكرين ويا خلب الكبد",65,"د",1,0],["وَاُمُّهُ الزُّهَرَةُ المَجِيدَه","والَت أَباهُ فَوقَ طُورِ إِيدَه",66,"ه",1,0],["وأمهم الزهراء سيدة النسا","ومدحهم قد جاء في محكم الذكر",67,"ر",1,0],["وأمه الطهر الفرات مهرها","وكفه كم فاض منها جدول",68,"ل",1,0],["وأمة ظل يحدوها ويقدمها","هوى من الحب تغدوه الصبابات",69,"ت",1,0],["وَأُمَّهاتٌ مِنَ الفَواطِمِ أَخلَصَت","كَ بيضُ عَقايِلُ عُرُبُ",70,"ب",1,0],["وأُمَّةٌ عَضَّتْ أَبَاهَا لِكَي","تَقُولَ لِلطاعُونِ: لَستَ الوَحِيدْ!",71,"د",1,0],["وأُمَّةٌ عَضَّتْ أَبَاهَا لِكَي","تَقُولَ لِلشيطانِ: لَستَ الوَحِيدْ!",72,"د",1,0],["وأمةٌ أنجبَتْ يومَ الشدائدِ مَن","كانوا لخيمتِنا كالحبلِ والوتدِ",73,"د",1,0],["وَأُمُّهَاْ أَيَّدَتَ إِصْرَاْرَ وَاْلِدِهَاْ","لِذَاْكَ أَطْلُبُ مِنْ حَاْمِي الْحِمَى الْعِوَضَاْ",74,"ض",2,0],["وَأُمُّهُمْ قَدْ سَقَاهَا الضَّنْكُ كَأْسَ ضَنَى","وَمَزَّقَتْ رُوْحَهَا الأَحْزَانُ وَالسَّقَمُ",75,"م",1,0],["وأمُّهُ وبها خَوْفٌ يُشَتِتُها","عَلِيهِ تَجْمَعُهُ فيها وتأْتَلِفُ",76,"ف",1,0],["وَأُمُّهُ الطُّهْرُ قَدْ رَأَتْ مَا","يَضِيقُ بِالوَصْفِ فِي مَقَالِ",77,"ل",1,0],["وأمة خير العالمين محمد","قد افترقت والنص في ذاك قد نقل",78,"ل",1,0],["وأمه أما على رجله","في سيره أو فوق حرف أمون",79,"ن",1,0],["وأمْهِِِلني البقيّة َ من حياتي","أريح ُ بها فؤادا ً ما استراحا",80,"ح",2,0],["وأمّهاتٌ وفي الأحضانِ مرحمةٌ","أمٌّ لطفلٍ من اللّمساتِ يكتحلُ",81,"ل",1,0],["وأمة العرب لا حيٌّ فأوقظه","ولا ليوث إذا ناديتهم وثبوا",82,"ب",3,0],["وأمهل عبيدا ما العبارة تقتضي","مرادا ولكن في الإشارة فسحة",83,"ه",1,0],["وامها من فزعته ماتت ... يتيمه الوالدين","يومها صارت تبي راس الحكيم وهو المرادي",84,"د",2,0],["وامهرت ارضك الابطال من دمها","تسخو به بين انجاد واغوار",85,"ر",1,0],["وأمة العشق بالأيام ناعمة","تلقي لدى عشقها الدنيا وما فيها",86,"ي",3,0],["وأمةٍ كم تداوي جرح جارتها","وحين تُجرح قل لي من يداويها ؟؟",87,"ي",3,1],["وأمهره نداءاتِ انتمائي","وأشهره، على الدنيا، غلاما",88,"م",2,0]]}