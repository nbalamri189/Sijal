{"poems":[[74,"بأبي مائسة يثني على","https://www.aldiwan.net/poem20158.html","الرمل"],[46,"يا دار دار عليك إرهام الندى","https://www.aldiwan.net/poem30539.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55037","الخفيف"],[119,"أسد الله فتى العزم أبا السا","https://www.aldiwan.net/poem41783.html","الطويل"],[132,"أنت يا مقلتي أسقمت حالي","https://www.aldiwan.net/poem50549.html","الخفيف"],[309,"أمن الموت أجزع","https://www.aldiwan.net/poem16760.html","مجزوء الخفيف"],[369,"سترن المحاسن إلا العيونا","https://www.aldiwan.net/poem60632.html","المتقارب"],[415,"لقد عم جود الأفضل السيد الورى","https://www.aldiwan.net/poem32227.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86646","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64249","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62525","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79906","الخفيف"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95392","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104799","المتقارب"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110271","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53241","الخفيف"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198482","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89117","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77054","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136762",""],[4829,"الجابريّة","https://www.poetsgate.com/ViewPoem.aspx?id=35605",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5277,"أنا لا أبكي","https://www.poetsgate.com/ViewPoem.aspx?id=208524",""],[5401,"هات القلم","https://www.poetsgate.com/ViewPoem.aspx?id=142369",""],[402,"في معاليك قام عذر القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=36007",""],[5866,"لا والله الا وصلوها مواصيل","https://www.poetsgate.com/ViewPoem.aspx?id=182873",""],[6049,"اسمن عذارك","https://www.poetsgate.com/ViewPoem.aspx?id=35631",""],[119,"لك أشكو يا أرحم الرحماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55608&r=&rc=5",""]],"verses":[["وإلى بابك أنهينا الرجا","وهو أوْلى باتِّصال المنن",0,"ن",1,0],["وَإِلى بَني عَبدِ الكَريمِ تَواهَقَت","رَتكَ النَعامِ رَأى الظَلامَ فَخَوَّدا",1,"د",2,0],["وَإلى بابِهِ سَعَى قَبْلَ أَنْ يَسْعَى","إِلى بابِهَا حرِيبٌ وَعَافِ",2,"ف",1,0],["وإلى بنت رسول اللَه من","تميم اللَه بعلياها افتخارها",3,"ه",2,0],["وإلى بهجةِ البساتينِ مَنْ نَخْ","لٍ وأشجارها وبَرْدِ الظلالِ",4,"ل",1,0],["وَإِلى بابِكَ أَلجَأُ","وَهوَ لِكُلِّ مَفزَعُ",5,"ع",1,0],["وآلَى به النَّصرُ لا خانَه","فلم يَخْشَ في موقفٍ أنْ يَخونا",6,"ن",2,0],["وإلى بابِه مآلي وللآ","بِقِ حُسنُ القَبولِ حين يُنِيبُ",7,"ب",1,0],["وَإِلى بَحر فارس حُكمه امتد","دَ سريعاً بحزمه وَنُهاه",8,"ا",2,0],["وَإِلى بدرك المُنير أَشارَت","شَمسُ عَلياك بِالبَنان الخَضيب",9,"ب",1,0],["والى باشّلقيشا","ذو التَّنَاهي يَتَناهى",10,"ا",3,0],["وإلى بابهم تحث المطايا","وإليهم يجاب وعر وسهل",11,"ل",1,0],["وإلى بابِ فضلهِ ينتهي القص","دُ وفي ربعهِ الرجاءُ يريحُ",12,"ح",1,0],["واليبرق الزاكي الجدود فلذ به","قوت سواه لجائع لا يعهد",13,"د",1,0],["وَآلَى بِحَقِّ الإِلهِ لَهُ","أَلاَ تَحسِبَن فِى سِوَاكُم لَهُ",14,"ه",1,0],["وإلى بقس قاف نفخة ريح","حملت من زفير صدر المسيح",15,"ح",1,0],["وإلى بابه تحثُّ بنو الآم","ال نحو النجاح بُزْلَ المَطِيِّ",16,"ي",1,0],["وإلى ((بِرَيطَنْيا)) تجاوَزَ نَهْرُهَا","((للِتِّمْيِز)) بالُبشْرى مع اسْتبْشارِ",17,"ر",1,0],["والي ببحر الشرق والي مصر","ساس العباد رأيه السديدُ",18,"د",1,0],["وَإِلى باذِخَ المَقامِ قَوافِ","عَطرت بِالثَناءِ غوراً وَنَجدا",19,"د",2,0],["وإلى بدرةَ أسري","سيرَ ليثٍ للمغارة",20,"ر",2,0],["والي بوقت اللين يضرب صدره","رمحه بصدري فالنهار الدامي",21,"م",2,0],["وإلى بآلاء كأبى إذا طغى","فآباؤه منه إذا براء",22,"ا",2,0],["وإلى بغدادَ ترنو أُمّةٌ","هالها الرّوعُ ويغزوها التَّتَرْ",23,"ر",1,0],["والي بقى فضلة عراميش ولحاس","ياهني من ياصل لها بإجتياحي",24,"ح",2,0],["وإلى بابه سعى قبل أن يسعى إلى بابها حريب وعاف","ذاك قاضي الحقوق في معنييها بالندى تارة وبالإنصاف",25,"ف",1,0],["والي بعمره ما شكا الهم والويل","وغدر الليالي معترض في سبيله",26,"ل",2,0],["والى بغيتي الرجوع وله تعوزتي","شوفي محله وهذا درب مخراجه",27,"ج",2,0],["وإلى بابك الإلهي ألوي","همة العزم والمنى والرجاء",28,"ا",2,0]]}