{"poems":[[53,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[68,"ليس البلاغة معنى","https://www.aldiwan.net/poem38541.html","المجتث"],[46,"بسطت إلي بنانة أسروعا","https://www.aldiwan.net/poem30022.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[280,"أتجحد قتلي ربة الشنف والخرص","https://www.aldiwan.net/poem25494.html","الطويل"],[458,"أرجال لا ولا شبه رجال","https://www.aldiwan.net/poem61613.html","الرمل"],[563,"إني أنا جسم فنفس فروح","https://www.aldiwan.net/poem34668.html","السريع"],[580,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48505","الكامل"],[1916,"","https://poetry.dctabudhabi.ae/diwan/poem/121548","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27202","البسيط"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124056","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2734,"","https://poetry.dctabudhabi.ae/diwan/poem/101411","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89273","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85248","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102984","الكامل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78192","الكامل"],[4898,"وطني الكبير !","https://www.poetsgate.com/ViewPoem.aspx?id=35778",""],[5212,"نِداءُ الحُسين","https://www.poetsgate.com/ViewPoem.aspx?id=212030",""],[592,"وإذا أردت ترى مصارع من ثوى","https://www.poetsgate.com/ViewPoem.aspx?id=128824",""],[5559,"خنساء القدس / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=178195",""],[5879,"هل بدلت أرقام هاتفها؟","https://www.poetsgate.com/ViewPoem.aspx?id=215457",""],[5957,"يا رفيق كتابي","https://www.poetsgate.com/ViewPoem.aspx?id=187772",""]],"verses":[["بل صَدْفةُ المبغض من حُكمه","في الشيب تتلو نظرة المُبلِس",0,"س",1,0],["بَل صَوغُ مَعنىً كَثيرٍ","يَحويهِ لَفظٌ قَليلُ",1,"ل",1,0],["بَل صَوتُ عاذِلَةٍ عَراني مَوهِناً","عَدلٌ لَعَمرُكَ لَو عَذَلتَ سَميعا",2,"ع",2,0],["بل صنع شيخ مقبل مزاول","أعِيْنَ بابن يافعٍ مناول",3,"ل",1,0],["بِلُصِّ نُيُوبٍ أوْ بِحُجْنِ مَخَالِبٍ","فَيَا لَك مِنْ حُجْنٍ رِوَاءٍ وَمِنْ لُصِّ",4,"ص",1,0],["بل صغارٌ كلهم محتقرٌ","خبزهُ الذل وجدَواه الضلال",5,"ل",1,0],["بل صوروه في خيالاتهم","وعندهم فيما رأوه رجوح",6,"ح",1,0],["بل صيّرته للدِّيا","نَةِ للأَنامِ إِمَامَها",7,"م",3,0],["بل صيرتهم مثل ذرات إذا","هب الهواء تطير مثل هباء",8,"ا",2,0],["بل صانه التاريخ معتدّاً بما","يمتد في الأكوان من أنبائه",9,"ا",3,0],["بل صولتي في راحتي وتفرسي","في حسن ما أسعى لخير مآبه",10,"ب",2,0],["بل صُم وصلِّ وفكِّر وافتقر أبداً","تنل معالم مِن علم الخفيَّات",11,"ت",1,0],["بل صار غنى القوم يغبط معدما","منكم بشيم بوارق الإحسان",12,"ن",1,0],["بَل صَرَّحَ الوحيُ المبينُ بأنهُ","حقًّا عَلى الإِيمانِ والإحسَانِ",13,"ن",1,0],["بَل صَحبُه من بعدِه أو تَابشعٌ","لَهُم عَلى الإِيمانِ والإحسَانِ",13,"ن",1,0],["بَل صَرَّحَ الوحيُ المبينُ بأنهُ","حقًّا مُغَيِّرُ هَذه الأكوَانِ",13,"ن",1,0],["بَل صُورَةُ البُرهَانِ أصبَحَ شَكلُهَا","شَكلاً عَقِيماً لَيسَ ذَا بُرهَانِ",13,"ن",1,0],["بلصوقه الأضراس وهو بمخرجٍ","فردٌ على الجهتين في الأنحاء",14,"ا",2,0],["بل صارت النار مثل ماءٍ","فلا بضوءٍ ولا مسيل",15,"ل",1,0],["بل صابروه بنية وبحسبة","حتى تولى كالجهام المدبر",16,"ر",1,0],["بل صورة الحسن التي مهما بدت","لعيون قوم كبروا تكبيرا",17,"ر",2,0],["بَل صَولَتي في راحَتي وَنفرسى","في حُسنِ ما أَسعى لِخَير مَآب",18,"ب",1,0],["بَلْ صُودِرَتْ أحْلامُهُم بمَدينَةٍ","يَحْيَون تَحْتَ سَمَائها بأمَان ِ",19,"ن",1,0],["بَلْ صادِقُ الأطهارِ قالَ إلى المَلا","للشَّينِ صُدّوا بَلْ وَكونوا لي لزَينْ",20,"ن",1,0],["بل صح عن بعض الملا تسفيههم","أحلام أهل الحق والإيمان",21,"ن",1,0],["بل صاروا في حجر النساء قواعدّ","قد رصّعوا تيجانهم ياقوتا",22,"ت",2,0],["بل صخرها لأرق منك تواضعا","بصلابة في نفعها ما لا تعي",23,"ع",2,0],["بل صرتَ شاعرها وروح بيانها","فعطورها في قولكَ الخلابِ",24,"ب",1,0]]}