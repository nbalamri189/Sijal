tps://www.aldiwan.net/poem28631.html","الوافر"],[33,"أروح ولم أحدث لليلى زيارة","https://www.aldiwan.net/poem25835.html","الطويل"],[33,"ألا هل إلى شم الخزامى ونظرة","https://www.aldiwan.net/poem25849.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"مللنا وما مل العدو المغاضب","https://www.aldiwan.net/poem43099.html","الطويل"],[81,"هو البين يا موسى وقد كنت ثاويا","https://www.aldiwan.net/poem61555.html","الطويل"],[102,"لنا البراق والحرم","https://www.aldiwan.net/poem32912.html","مجزوء الرجز"],[52,"أيا ويحه ما ذنبه إن تذكرا","https://www.aldiwan.net/poem27049.html","الطويل"],[75,"يا رب كل كتيبة شهباء","https://www.aldiwan.net/poem69108.html","الكامل"],[48,"وصاحب زان كل مصطحب","https://www.aldiwan.net/poem65301.html","المنسرح"],[50,"لاح الهوى واستنار العدل والبصر","https://www.aldiwan.net/poem63824.html","البسيط"],[50,"تجهز طال في النصب الثواء","https://www.aldiwan.net/poem64892.html","الوافر"],[46,"أروى دم قلبا وتلك سفاهة","https://www.aldiwan.net/poem22490.html","الكامل"],[46,"لا تكرموا جسدي إذا ما حل بي","https://www.aldiwan.net/poem22495.html","الكامل"],[46,"كيف احتيالك والقضاء مدبر","https://www.aldiwan.net/poem22563.html","الكامل"],[46,"غدا رمضاني ليس عني بمنقض","https://www.aldiwan.net/poem22643.html","الطويل"],[46,"حكم تدل على حكيم قادر","https://www.aldiwan.net/poem23256.html","الكامل"],[46,"هياما يصير الجسم في هامد الثرى","https://www.aldiwan.net/poem23339.html","الطويل"],[46,"رب درفس خلفه ذائب","https://www.aldiwan.net/poem23432.html","السريع"],[68,"هل نار ليلى بدت ليلا بذي سلم","https://www.aldiwan.net/poem1526.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85304","المنسرح"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9981","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54312","البسيط"],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[106,"وقفة على طلل","https://www.poetsgate.com/ViewPoem.aspx?id=151389",""],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[51,"أمامك فانظر أيَّ نهجيك تَنْهُج","https://www.poetsgate.com/ViewPoem.aspx?id=27417",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""]],"verses":[["أَرواحُنا دَينٌ وَما أَنفاسُنا","إِلّا قَضاءٌ وَالزَمانُ غَريمُها",0,"م",3,0],["أَروني مَن يَقومُ لَكُم مَقامي","أَروني مَن يَقولُ لَكُم مَقالي",1,"ي",1,0],["أَروغُ كَأَنّي في الصَباحِ طَريدَةٌ","وَأَسري كَأَنّي في الظَلامِ خَيالُ",2,"ل",1,0],["أَرومُ اِنتِصافي مِن رِجالٍ أَباعِدٍ","وَنَفسِيَ أَعدى لي مِنَ الناسِ أَجمَعا",3,"ع",2,1],["أَروحُ بِفِتيانٍ خِماصٍ مِنَ الجَوى","لَهُم أَنَّهُ في كُلِّ دارٍ وَأَدمُعُ",4,"ع",1,0],["أَرومُ بِحُسنِ رَأيِكَ كُلَّ أَمرٍ","يُؤَلِّفُ فِرقَةَ الأَمَلِ الشَعاعِ",5,"ع",1,0],["أَروعُ بِهِ الظِباءَ وَقَد أَراني","زَميلاً لِلغَزالِ إِلى الكِناسِ",6,"س",1,0],["أَرومُ العُلا وَالسَّيفُ يخضبه دَمٌ","بِأَبيَضَ بَتّارٍ وَأَسمَرَ مارِنِ",7,"ن",1,0],["أَروَعُ لَم يَشرَعْ صَرى مَنهَلٍ","تَغَمُّرَ العَيرِ بِضَحضاحِ",8,"ح",1,0],["أَرومُ العُلا وَالعُدْمُ عَنْهُنَّ حاجِزٌ","فَتِلْكَ لَعَمْري خُطَّةٌ لا أُطيقُها",9,"ق",3,0],["أَرُوحُ بِأَشْجانٍ عَلى مِثْلِها أَغْدو","فَحَتَّى مَتى يُزْري بِيَ الزَّمَنُ الوَغْدُ",10,"د",1,1],["أَرومُ العُلا وَالدَّهْرُ يُزجِي خُطوبَهُ","إِلَيَّ بإِحْدى المُعْضِلاتِ القَواصِم",11,"م",1,1],["أرْوَعُ لا يَقْرَعُ بابَ باخِلٍ","لمْ يتّزِرْ بسُؤْدَدٍ ولا ارْتَدى",12,"ا",1,0],["أرْوَعُ يَنْميهِ أبٌ ماجِدٌ","إلَيْهِما السّؤْدَدُ مَنسوبُ",13,"ب",1,0],["أَروعُ بهِ سِرْبَ القَطا كُلَّ ليلَةٍ","تَمُدُّ جَناحَيْ أقْتَمِ الرّيشِ أفْتَخِ",14,"خ",1,0],["أروَعُ طَلْقُ البُرْدِ لم يحْتَضِنْ","منَ التُّقى حاشِيَتَيْهِ جُناحْ",15,"ح",1,0],["أروحُ على وَصْلٍ وأغدو بمِثْلِهِ","وَوِرْدُ التّصابي لمْ يُكَدِّرْهُ هِجرانُ",16,"ن",1,0],["أَروني وَجهَ نِسرينِ","وَأَنّى لي بِنِسرينِ",17,"ن",1,1],["أَروني مَن يُداويني","مِنَ الداءِ وَيَشفيني",17,"ي",1,0],["أَروني بَينَكُم رَجُلاً","رَكيناً واضِحَ الحَسَبِ",18,"ب",1,0],["أَروني نِصفَ مُختَرِعٍ","أَروني رُبعَ مُحتَسِبِ",18,"ب",1,0],["أَروني نادِياً حَفلاً","بِأَهلِ الفَضلِ وَالأَدَبِ",18,"ب",1,0],["أَروحُ إِلَيهِ بِالسَلامِ وَأَغتَدي","إِلى بابِهِ وَاليَومُ في مَهدِهِ طِفلُ",19,"ل",1,0],["أَروحُ وَأَغدو مِن هَواكِ وَأَستَري","وَفي النَفسِ مِمّا قَد عَلِمتِ عَلاقِمُ",20,"م",1,0],["أَرومٌ ثابِتٌ يَهتَزُّ فيهِ","بِأَكرَمِ مَنبِتٍ فَرعٌ أَصيلُ",21,"ل",1,0],["أَرْوَعٌ وَجْهُهُ أَغَرُّ","وَعِرْنِينُهُ أَشَمْ",22,"م",1,0],["أَرْوِ العُيُونَ بِمَا تُفِيضُ مِنَ السَّنَى","فَلَقَدْ حُجِبْتَ وَبِالعُيُونِ أُوَامُ",23,"م",1,0],["اِروُوا عَلَيَّ وَأَرضوا بي صَديقَكُمُ","وَاِستَسمِعوا يا بَني مَيثاءَ إِنشادي",24,"ي",1,0],["أُرَوِّحُ القَلبَ بِبَعضِ الهَزلِ","تَجاهُلاً مِنّي بِغَيرِ جَهلِ",25,"ل",1,1],["أَروَعُ لِلدَعوَةِ مُستَعجِلٌ","لَم يَثنِهِ الشَأنُ خَفيفُ القِيام",26,"م",1,0],["أَروني سُعوداً كَالسُعودِ الَّتي سَمَت","بِمَكَّةَ مِن أَولادِ عَمرِ اِبنِ عامِرِ",27,"ر",1,1],["أرويتَ أرض نبات لو عنيتَ به","كنتَ المحيّا بزهرٍ منه نفّاح",28,"ح",1,0],["أروي المروءة عنهم عن نافعٍ","والبرّ أرويه عن ابن كثير",29,"ر",1,0],["أروِي نسيم البان من أعطافه","فكراً وأروِي من سناه المدهشا",30,"ش",2,0],["أروي بدمعِي ثرى ملك له شيمٌ","قد كانَ يذكرها الصَّادِي فترويه",31,"ي",2,0],["أروني امرءاً منهم يُزَنّ بأُبْنَةٍ","ولا تنطقوا البهتان فالحق أبلجُ",32,"ج",1,0],["أرويتُ بالإصدار عنك حوائمي","لما أطال غليلَها الإيرادُ",33,"د",1,0],["أروح وأغدو فيه أنصَبَ عاملٍ","وأصفَره كفّاً فكمْ أتَصَبَّر",34,"ر",1,0],["أرْوَض منها للزَنا وأسْوسا","ريَّا بماءٍ غُصنُها حتى عسا",35,"س",2,0],["أرواحُها الأرواحُ تَمَعج بينها","فترى بها منفُوسةً لم تُنفَس",36,"س",1,0],["أرْواحُ فيك سُعوطٌ لا يقامُ له","والوجهُ منكَ ذَرُورٌ فه إمْضاضُ",37,"ض",1,1],["أَروعُهُ عن هَناتهِ وأُخلْ","ليه إذا ما تقحَّم القُحَما",38,"م",2,0],["أروح وأغدو واجما بين معشرٍ","شماتَى بحالي كلُّهم غيْرُ واجمِ",39,"م",1,0],["أَروَحُ لِلنَفس وَأَهنا لَها","أَن تَحسُبَ الماضِيَ لَم يولَدِ",40,"د",1,0],["أَروي لَكُمعَن شاعِرٍ ساحيرٍ","حِكايَةً يُحمَدُ راويها",41,"ي",3,1],["أَروحُ وَأَخلاقي تَذوبُ صَبابَةً","وَأَغدو وَأَعطافي تَسيلُ تَغَزُّلا",42,"ل",2,0],["أَروحُ فَلا يَعوي عَلَيَّ كِلابُها","وَأَغدو فَلا يَرغو هُناكَ بَعيرُها",43,"ر",3,0],["أَروحُ وَلي في نَشوَةِ الحُبِّ هِزَّةٌ","وَلَستُ أُبالي أَن يُقالَ طَروبُ",44,"ب",1,0],["أَروتْ جوانِحَهَا وذلك","حَسْبُها كيما تَؤُوبْ",45,"ب",1,0],["أَرومُ فُؤادي في الغَرامِ لِيَنثَني","وَكَيفَ وَما دونَ الأَبيَّةِ حاجِبُ",46,"ب",1,0],["أُرومٌ ثابِتٌ يَهتَزُّ فيهِ","بِأَكرَمِ مَنبِتٍ فَرعٌ طَويلُ",47,"ل",1,0],["أروى لكم خرافة","في غاية اللطافة",48,"ه",1,1],["أروح في أسر سلطان الهوى وأجى","ولا أبي لي ولا سلطانه فادي",49,"ي",1,0],["أَروتَرُ لا تَدُسَّ السُمَّ دَسّاً","وَمَهلاً في التَهَوُّسِ يا هَوَسا",50,"ا",1,0],["أَروحُ وَقَد خَتَمتَ عَلى فُؤادي","بِحُبِّكَ أَن يَحِلَّ بِهِ سِواكا",51,"ك",2,0],["أَرواحُنا اِنهَمَلَت وَعِشنا بَعدَها","مِن بَعدِ ما قَطَرَت عَلى الأَقدامِ",52,"م",1,0],["أُروضُ الناسِ مِن تُربٍ وَخَوفٍ","وَأَرضُ أَبي شُجاعٍ مِن أَمانِ",53,"ن",1,0],["أروحُ وقلبي بالهموم معذَّبٌ","وأغدو وعيني بالدموع سَفُوحُ",54,"ح",1,0],["أروى بشربِ الضَّبِّ مجتزئَاً به","والماء سَلسالُ المذاقِ شَروبُ",55,"ب",1,0],["أَرومُ اِنتِصاراً ثُمَّ يَثني عَزيمَتي","تُقايَ الَّذي يَعتاقُني وَتَحَرُّجي",56,"ي",1,0],["أَرومُ بِالشِعرِ أَن تَعودَ فَما","أَقطَعُ فيما أَرومُهُ شَعرَه",57,"ر",2,0],["أَروني مَن يَقومُ لَكُم مَقامي","إِذا ما الأَمرُ جَلَّ عَنِ العِتابِ",58,"ب",1,1],["أرومُ مِنك ثِماراً لستُ أجنِيها","وأَرتجي الحالَ قد حُلَّتْ أواخِيها",59,"ي",3,1],["أرواحُها تأكلُ أجسامَها","عَمداً وتَفنَى حينَ تُفنِيها",60,"ي",3,0],["أَرومُ دُنُوَّ كاذبةِ التَّداني","من العُشَّاقِ صادِقَةِ الفِراقِ",61,"ق",1,0],["أَرونا سُنَّةً لا عَيبَ فيها","يُسَوّى بَينَنا فيها السَواءُ",62,"ا",2,0],["أَرومُ إِقامَةَ عُذري بِها","وَأُثني عَلى فَضلِكَ الأَكمَلِ",63,"ل",1,0],["أَروَعُ مَحسودُ العَلاءِ أَمجَدٌ","مِن نَسلِ مَحسودِ العَلاءِ أَمجَدِ",64,"د",1,0],["أروَعُ شيءٍ صامتٍ في العُلى","أفصح مُفضٍ بالبيان الصّريح",65,"ح",1,0],["أروعٌ إن سَخُنَتْ عَيْنُ العلى","كَحَلَتْها مِنْ سَناهُ بِبُرود",66,"د",1,0],["أرْوَعُ وَضّاحُ المحيّا كما","قابَلتَ في الإشراقِ بشرَ الصّباح",67,"ح",1,0],["أرونيَ منكم راجياً رَدّ قاصداً","إلى قصده وجه الرّجاءِ فخابا",68,"ب",2,0],["أَرومُ حِمى العِراقِ فَتَدَّريني","رُماةَ جَوىً لِشَجوٍ ما تُصيبُ",69,"ب",1,0],["أَرواحُنا في مَكانٍ واحِدٍ وَغَدَت","أَبدانُنا في شَآمٍ أَو خُراسانِ",70,"ن",1,0],["أَروَعُ لا مِن رِياحِهِ الحَرجَفُ ال","صِرُّ وَلا مِن نُجومِهِ النَحسُ",71,"س",1,0],["أَروَيتَ ظَمآنَ الصَعيدِ الهامِدِ","وَمَلَأتَ مِن جِزعَيكَ عَينَ الرائِدِ",72,"د",1,1],["أروني مثلَهُ لأنوبَ عنهُ","فإني قَدْ عدمْتُ لهُ القرينا",73,"ن",2,0],["أَروحُ وَلَم أُحدِث لِلَيلى زِيارَةً","لَبِئسَ إِذاً راعي المَوَدَّةِ وَالوَصلِ",74,"ل",1,1],["أَرومُ اِنحِداراً نَحوَها فَيَرُدُّني","وَيَمنَعُني دَينٌ عَلَيَّ ثَقيلُ",75,"ل",1,0],["أروني سيفَ خالدةٍ وعُدُّوا","مناقبَها العُلىَ للمُعْجَبينا",76,"ن",2,0],["أَروهُ ممالكَ الدُّنيا وقُصّوا","على الأممِ الحديثَ مُفاخِرينا",76,"ن",2,0],["أَرونا البطشةَ الكبرى سِراعاً","فإنّ لكم لَبطشُ القادرينا",76,"ن",2,0],["أَرونا بِلاداً فاتَها ما أَصابَكُم","وَتَمَّت لَها حاجاتُها وَالمَطالِبُ",77,"ب",1,0],["أَرَوضَ الصِبا قَد جَفَّ بِالبَينِ مَنبِتي","وَيا شَمسَ أُفقِ الحُسنِ قَد حانَ مَغرِبي",78,"ي",1,0],["أَرواحَنا أَموالنا","فِدى البراق وَالحَرَم",79,"م",1,0],["أَروحُ كَغُصنِ البانِ بَيَّتَهُ النَدى","وَهَزَّ بِأَنفاسٍ ضِعافٍ وَأُمطِرا",80,"ر",2,0],["أرواحُها لكَ والجسومُ وإنّما","أنفاسُها منْ فِطنةٍ وذكاء",81,"ا",2,0],["أَروَعُ مَحمودَةٌ خَلائِقُهُ","يَبذُلُ في الخَمرِ أَفضَلَ الثَمَنِ",82,"ن",1,0],["أَروى مِن العَذبِ هاماتٍ مُصَرَّدَةً","قَد كانَ أَزرى بِهِنَّ المِلحُ وَالكَدَرُ",83,"ر",1,0],["أَروحُ عَلى المَعازِفِ أَربَخيّا","وَتَسقيني بِريقَتِها النِساءُ",84,"ا",2,0],["أَروى دَمٌ قَلباً وَتِلكَ سَفاهَةٌ","وَالدهرُ مِن عَجَلٍ وَمِن إِروادِ",85,"د",1,1],["أَرواحُنا ظُلِمَت فَتِلكَ بُيوتِها","دُرُسٌ خَوَينَ مِنَ الضَغائِنِ وَالحَسَد",86,"د",1,0],["أَرواحُنا مَعَنا وَلَيسَ لَنا بِها","عِلمٌ فَكَيفَ إِذا حَوَتها الأَقبُرُ",87,"ر",1,0],["أَرومُ خَلاصاً مِن قَضاءٍ مُسَلَّطٍ","عَلَيَّ تَوَخّى قاهِرَ الناسِ بِالقَهرِ",88,"ر",1,0],["أَرواحُنا أُلفينَ كَالأَرواحِ في","خَيرٍ وَشَرٍّ مِن صَباً وَشَمالِ",89,"ل",1,0],["أَرُوّامَ أَمرٍ لا يَصِحُّ جَهِلتُمُ","كَأَنَّكُمُ لَستُم عَنِ الأَرضِ رُيّاما",90,"م",2,0],["أَروَحُ مِن عَيشٍ جَنى لي أَذىً","مَوتٌ أَتاني راحَةً وَاِصطَلَم",91,"م",1,0],["أرْواحَ نَعمانَ هَلاّ نَسمةٌ سَحَراً","وماءَ وَجرةَ هَلاَّ نهْلة بفَمِ",92,"م",1,0],["أَرويه للناس عنها","أنا وترويه عنِّي",93,"ي",1,0],["أَروح رافِلاً","في مطرف الهنا",94,"ن",2,0],["أَرُوحُ فلا أخشى المَنايا وأتّقي","تَدَنُّسَ عِرْضٍ أو ذَميمَ فِعال",95,"ل",1,0],["أرْوَى النياقِ كأروَى النِّيقِ يَعصِمُها","ضَرْبٌ يَظَلّ به السِّرحانُ مَبْهوتا",96,"ت",2,0],["أَروحُ مِنَ الصَباحِ إِلى مَغيبٍ","وَأَرقُدُ بَينَ أَطنابِ الخِيامِ",97,"م",1,0],["أروِي ويَرْوِي القوافي","كالدرِّ وزناً بوزن",98,"ن",1,0],["أرْوَاحُنَا في يَدَيْكَ رَهْنُ","وعَهْدُنَا أَصْدَقُ الْعُهُودِ",99,"د",1,0],["أروح إليها كلَّ يومٍ، وأغْتَدي","إلى العلم عطشانا، ومن العلم رَاويا",100,"ي",2,0],["أرواحنا تتلاقى فيه خافقة","كالنحل إذ يتلاقى في خلاياه",101,"ا",2,0],["أروني جديداً يَفْضح الشعرُ أمرَه","ففضحُ مساوي القوم شيءٌ مُحصَّل",102,"ل",1,0],["أَروني امرأ منهم يُزَنّ بأُبْنَة ٍ","ولا تنطقوا البهتانَ فالحق أبلجُ",103,"ج",1,0],["أَرواحٌ مُوَدِّعٌ أَم بُكورُ","لَكَ فَاِعمَد لِأَيِّ حالٍ تَصيرُ",104,"ر",1,1]]}