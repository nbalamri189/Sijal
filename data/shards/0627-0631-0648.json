m15460.html","السريع"],[459,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[462,"يذم الزمان وليس الزمان","https://www.aldiwan.net/poem3145.html","عموديه"],[462,"نسيم الصبا والليل منتظم العقد","https://www.aldiwan.net/poem3176.html","عموديه"],[473,"هل تعرف المنزل بالأهيل","https://www.aldiwan.net/poem1825.html","السريع"],[475,"على البان قمرية تسجع","https://www.aldiwan.net/poem15215.html","المتقارب"],[475,"كم رضت جامح قلبي عنكم فأبى","https://www.aldiwan.net/poem15242.html","البسيط"],[475,"تعطر من دياركم النسيم","https://www.aldiwan.net/poem15337.html","الوافر"],[475,"أغار إذا وصفتك من لساني","https://www.aldiwan.net/poem16190.html","الوافر"],[477,"أرووا قريضي ورووا","https://www.aldiwan.net/poem36992.html","المجتث"],[477,"حمامات أيك عذبة النغمات","https://www.aldiwan.net/poem37913.html","الطويل"],[504,"لا وأعطاف الغصون الميس","https://www.aldiwan.net/poem2456.html","الوافر"],[512,"يلوح فتستدعي الفراش وتبسم","https://www.aldiwan.net/poem20798.html","الطويل"],[512,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[512,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[512,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[512,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[512,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[513,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[513,"لو أمكنتني في مدحي لك الشهب","https://www.aldiwan.net/poem12022.html","البسيط"],[514,"أحب قنا من حب هند ولم أكن","https://www.aldiwan.net/poem48686.html","الطويل"],[527,"إلهي كن يا إلهي معيني","https://www.aldiwan.net/poem37112.html","المتقارب"],[536,"رعى الله أيام الصبا واللياليا","https://www.aldiwan.net/poem47491.html","عموديه"],[538,"يا أيها الشاعر المكارم بالمدح","https://www.aldiwan.net/poem56716.html","المنسرح"],[549,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[549,"لعمرك إنني فارقت نجدا","https://www.aldiwan.net/poem47181.html","الوافر"],[549,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[549,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[549,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[549,"يجد بنا صرف الزمان ونهزل","https://www.aldiwan.net/poem47337.html","الطويل"],[549,"أروني امرءا من قبضة الدهر مارقا","https://www.aldiwan.net/poem47364.html","الطويل"],[549,"عرفت ويا ليتني ما عرفت","https://www.aldiwan.net/poem47382.html","المتقارب"],[549,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[549,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[551,"طيف الخيال حمدنا منك إلماما","https://www.aldiwan.net/poem68427.html","البسيط"],[551,"وساحرة العينين ما تحسن السحرا","https://www.aldiwan.net/poem68429.html","الطويل"],[556,"أهل المحبة في السرور الدائمِ","https://www.aldiwan.net/poem33857.html","الكامل"],[556,"تفاخر الماء والهواء","https://www.aldiwan.net/poem35076.html","مخلع البسيط"],[560,"قامت لهيبتها غصون البان","https://www.aldiwan.net/poem52803.html","الكامل"],[560,"قد عاهد الدهر أهليه فما غدرا","https://www.aldiwan.net/poem52874.html","البسيط"],[573,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"],[584,"تداركه قبل البين فاليوم عهده","https://www.aldiwan.net/poem17487.html","الطويل"],[585,"لقد كسفت شمس العلا والمفاخر","https://www.aldiwan.net/poem11500.html","عموديه"]],"verses":[["أَرواحُنا دَينٌ وَما أَنفاسُنا","إِلّا قَضاءٌ وَالزَمانُ غَريمُها",0,"م",3,0],["أَروني مَن يَقومُ لَكُم مَقامي","أَروني مَن يَقولُ لَكُم مَقالي",1,"ي",1,0],["أَروغُ كَأَنّي في الصَباحِ طَريدَةٌ","وَأَسري كَأَنّي في الظَلامِ خَيالُ",2,"ل",1,0],["أَرومُ اِنتِصافي مِن رِجالٍ أَباعِدٍ","وَنَفسِيَ أَعدى لي مِنَ الناسِ أَجمَعا",3,"ع",2,1],["أَروحُ بِفِتيانٍ خِماصٍ مِنَ الجَوى","لَهُم أَنَّهُ في كُلِّ دارٍ وَأَدمُعُ",4,"ع",1,0],["أَرومُ بِحُسنِ رَأيِكَ كُلَّ أَمرٍ","يُؤَلِّفُ فِرقَةَ الأَمَلِ الشَعاعِ",5,"ع",1,0],["أَروعُ بِهِ الظِباءَ وَقَد أَراني","زَميلاً لِلغَزالِ إِلى الكِناسِ",6,"س",1,0],["أَرومُ العُلا وَالسَّيفُ يخضبه دَمٌ","بِأَبيَضَ بَتّارٍ وَأَسمَرَ مارِنِ",7,"ن",1,0],["أَروَعُ لَم يَشرَعْ صَرى مَنهَلٍ","تَغَمُّرَ العَيرِ بِضَحضاحِ",8,"ح",1,0],["أَرومُ العُلا وَالعُدْمُ عَنْهُنَّ حاجِزٌ","فَتِلْكَ لَعَمْري خُطَّةٌ لا أُطيقُها",9,"ق",3,0],["أَرُوحُ بِأَشْجانٍ عَلى مِثْلِها أَغْدو","فَحَتَّى مَتى يُزْري بِيَ الزَّمَنُ الوَغْدُ",10,"د",1,1],["أَرومُ العُلا وَالدَّهْرُ يُزجِي خُطوبَهُ","إِلَيَّ بإِحْدى المُعْضِلاتِ القَواصِم",11,"م",1,1],["أرْوَعُ لا يَقْرَعُ بابَ باخِلٍ","لمْ يتّزِرْ بسُؤْدَدٍ ولا ارْتَدى",12,"ا",1,0],["أرْوَعُ يَنْميهِ أبٌ ماجِدٌ","إلَيْهِما السّؤْدَدُ مَنسوبُ",13,"ب",1,0],["أَروعُ بهِ سِرْبَ القَطا كُلَّ ليلَةٍ","تَمُدُّ جَناحَيْ أقْتَمِ الرّيشِ أفْتَخِ",14,"خ",1,0],["أروَعُ طَلْقُ البُرْدِ لم يحْتَضِنْ","منَ التُّقى حاشِيَتَيْهِ جُناحْ",15,"ح",1,0],["أروحُ على وَصْلٍ وأغدو بمِثْلِهِ","وَوِرْدُ التّصابي لمْ يُكَدِّرْهُ هِجرانُ",16,"ن",1,0],["أَروني وَجهَ نِسرينِ","وَأَنّى لي بِنِسرينِ",17,"ن",1,1],["أَروني مَن يُداويني","مِنَ الداءِ وَيَشفيني",17,"ي",1,0],["أَروني بَينَكُم رَجُلاً","رَكيناً واضِحَ الحَسَبِ",18,"ب",1,0],["أَروني نِصفَ مُختَرِعٍ","أَروني رُبعَ مُحتَسِبِ",18,"ب",1,0],["أَروني نادِياً حَفلاً","بِأَهلِ الفَضلِ وَالأَدَبِ",18,"ب",1,0],["أَروحُ إِلَيهِ بِالسَلامِ وَأَغتَدي","إِلى بابِهِ وَاليَومُ في مَهدِهِ طِفلُ",19,"ل",1,0],["أَروحُ وَأَغدو مِن هَواكِ وَأَستَري","وَفي النَفسِ مِمّا قَد عَلِمتِ عَلاقِمُ",20,"م",1,0],["أَرومٌ ثابِتٌ يَهتَزُّ فيهِ","بِأَكرَمِ مَنبِتٍ فَرعٌ أَصيلُ",21,"ل",1,0],["أَرْوَعٌ وَجْهُهُ أَغَرُّ","وَعِرْنِينُهُ أَشَمْ",22,"م",1,0],["أَرْوِ العُيُونَ بِمَا تُفِيضُ مِنَ السَّنَى","فَلَقَدْ حُجِبْتَ وَبِالعُيُونِ أُوَامُ",23,"م",1,0],["اِروُوا عَلَيَّ وَأَرضوا بي صَديقَكُمُ","وَاِستَسمِعوا يا بَني مَيثاءَ إِنشادي",24,"ي",1,0],["أُرَوِّحُ القَلبَ بِبَعضِ الهَزلِ","تَجاهُلاً مِنّي بِغَيرِ جَهلِ",25,"ل",1,1],["أَروَعُ لِلدَعوَةِ مُستَعجِلٌ","لَم يَثنِهِ الشَأنُ خَفيفُ القِيام",26,"م",1,0],["أَروني سُعوداً كَالسُعودِ الَّتي سَمَت","بِمَكَّةَ مِن أَولادِ عَمرِ اِبنِ عامِرِ",27,"ر",1,1],["أرويتَ أرض نبات لو عنيتَ به","كنتَ المحيّا بزهرٍ منه نفّاح",28,"ح",1,0],["أروي المروءة عنهم عن نافعٍ","والبرّ أرويه عن ابن كثير",29,"ر",1,0],["أروِي نسيم البان من أعطافه","فكراً وأروِي من سناه المدهشا",30,"ش",2,0],["أروي بدمعِي ثرى ملك له شيمٌ","قد كانَ يذكرها الصَّادِي فترويه",31,"ي",2,0],["أروني امرءاً منهم يُزَنّ بأُبْنَةٍ","ولا تنطقوا البهتان فالحق أبلجُ",32,"ج",1,0],["أرويتُ بالإصدار عنك حوائمي","لما أطال غليلَها الإيرادُ",33,"د",1,0],["أروح وأغدو فيه أنصَبَ عاملٍ","وأصفَره كفّاً فكمْ أتَصَبَّر",34,"ر",1,0],["أرْوَض منها للزَنا وأسْوسا","ريَّا بماءٍ غُصنُها حتى عسا",35,"س",2,0],["أرواحُها الأرواحُ تَمَعج بينها","فترى بها منفُوسةً لم تُنفَس",36,"س",1,0],["أرْواحُ فيك سُعوطٌ لا يقامُ له","والوجهُ منكَ ذَرُورٌ فه إمْضاضُ",37,"ض",1,1],["أَروعُهُ عن هَناتهِ وأُخلْ","ليه إذا ما تقحَّم القُحَما",38,"م",2,0],["أروح وأغدو واجما بين معشرٍ","شماتَى بحالي كلُّهم غيْرُ واجمِ",39,"م",1,0],["أَروَحُ لِلنَفس وَأَهنا لَها","أَن تَحسُبَ الماضِيَ لَم يولَدِ",40,"د",1,0],["أَروي لَكُمعَن شاعِرٍ ساحيرٍ","حِكايَةً يُحمَدُ راويها",41,"ي",3,1],["أَروحُ وَأَخلاقي تَذوبُ صَبابَةً","وَأَغدو وَأَعطافي تَسيلُ تَغَزُّلا",42,"ل",2,0],["أَروحُ فَلا يَعوي عَلَيَّ كِلابُها","وَأَغدو فَلا يَرغو هُناكَ بَعيرُها",43,"ر",3,0],["أَروحُ وَلي في نَشوَةِ الحُبِّ هِزَّةٌ","وَلَستُ أُبالي أَن يُقالَ طَروبُ",44,"ب",1,0],["أَروتْ جوانِحَهَا وذلك","حَسْبُها كيما تَؤُوبْ",45,"ب",1,0],["أَرومُ فُؤادي في الغَرامِ لِيَنثَني","وَكَيفَ وَما دونَ الأَبيَّةِ حاجِبُ",46,"ب",1,0],["أُرومٌ ثابِتٌ يَهتَزُّ فيهِ","بِأَكرَمِ مَنبِتٍ فَرعٌ طَويلُ",47,"ل",1,0],["أروى لكم خرافة","في غاية اللطافة",48,"ه",1,1],["أروح في أسر سلطان الهوى وأجى","ولا أبي لي ولا سلطانه فادي",49,"ي",1,0],["أَروتَرُ لا تَدُسَّ السُمَّ دَسّاً","وَمَهلاً في التَهَوُّسِ يا هَوَسا",50,"ا",1,0],["أَروحُ وَقَد خَتَمتَ عَلى فُؤادي","بِحُبِّكَ أَن يَحِلَّ بِهِ سِواكا",51,"ك",2,0],["أَرواحُنا اِنهَمَلَت وَعِشنا بَعدَها","مِن بَعدِ ما قَطَرَت عَلى الأَقدامِ",52,"م",1,0],["أُروضُ الناسِ مِن تُربٍ وَخَوفٍ","وَأَرضُ أَبي شُجاعٍ مِن أَمانِ",53,"ن",1,0],["أروحُ وقلبي بالهموم معذَّبٌ","وأغدو وعيني بالدموع سَفُوحُ",54,"ح",1,0],["أروى بشربِ الضَّبِّ مجتزئَاً به","والماء سَلسالُ المذاقِ شَروبُ",55,"ب",1,0],["أَرومُ اِنتِصاراً ثُمَّ يَثني عَزيمَتي","تُقايَ الَّذي يَعتاقُني وَتَحَرُّجي",56,"ي",1,0],["أَرومُ بِالشِعرِ أَن تَعودَ فَما","أَقطَعُ فيما أَرومُهُ شَعرَه",57,"ر",2,0],["أَروني مَن يَقومُ لَكُم مَقامي","إِذا ما الأَمرُ جَلَّ عَنِ العِتابِ",58,"ب",1,1],["أرومُ مِنك ثِماراً لستُ أجنِيها","وأَرتجي الحالَ قد حُلَّتْ أواخِيها",59,"ي",3,1],["أرواحُها تأكلُ أجسامَها","عَمداً وتَفنَى حينَ تُفنِيها",60,"ي",3,0],["أَرومُ دُنُوَّ كاذبةِ التَّداني","من العُشَّاقِ صادِقَةِ الفِراقِ",61,"ق",1,0],["أَرونا سُنَّةً لا عَيبَ فيها","يُسَوّى بَينَنا فيها السَواءُ",62,"ا",2,0],["أَرومُ إِقامَةَ عُذري بِها","وَأُثني عَلى فَضلِكَ الأَكمَلِ",63,"ل",1,0],["أَروَعُ مَحسودُ العَلاءِ أَمجَدٌ","مِن نَسلِ مَحسودِ العَلاءِ أَمجَدِ",64,"د",1,0],["أروَعُ شيءٍ صامتٍ في العُلى","أفصح مُفضٍ بالبيان الصّريح",65,"ح",1,0],["أروعٌ إن سَخُنَتْ عَيْنُ العلى","كَحَلَتْها مِنْ سَناهُ بِبُرود",66,"د",1,0],["أرْوَعُ وَضّاحُ المحيّا كما","قابَلتَ في الإشراقِ بشرَ الصّباح",67,"ح",1,0],["أرونيَ منكم راجياً رَدّ قاصداً","إلى قصده وجه الرّجاءِ فخابا",68,"ب",2,0],["أَرومُ حِمى العِراقِ فَتَدَّريني","رُماةَ جَوىً لِشَجوٍ ما تُصيبُ",69,"ب",1,0],["أَرواحُنا في مَكانٍ واحِدٍ وَغَدَت","أَبدانُنا في شَآمٍ أَو خُراسانِ",70,"ن",1,0],["أَروَعُ لا مِن رِياحِهِ الحَرجَفُ ال","صِرُّ وَلا مِن نُجومِهِ النَحسُ",71,"س",1,0],["أَروَيتَ ظَمآنَ الصَعيدِ الهامِدِ","وَمَلَأتَ مِن جِزعَيكَ عَينَ الرائِدِ",72,"د",1,1],["أروني مثلَهُ لأنوبَ عنهُ","فإني قَدْ عدمْتُ لهُ القرينا",73,"ن",2,0],["أَروحُ وَلَم أُحدِث لِلَيلى زِيارَةً","لَبِئسَ إِذاً راعي المَوَدَّةِ وَالوَصلِ",74,"ل",1,1],["أَرومُ اِنحِداراً نَحوَها فَيَرُدُّني","وَيَمنَعُني دَينٌ عَلَيَّ ثَقيلُ",75,"ل",1,0],["أروني سيفَ خالدةٍ وعُدُّوا","مناقبَها العُلىَ للمُعْجَبينا",76,"ن",2,0],["أَروهُ ممالكَ الدّ