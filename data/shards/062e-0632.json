{"poems":[[88,"هذا صبي هائم","https://www.aldiwan.net/poem10861.html","مجزوء الكامل"],[32,"أقول لأطلاح برى هطلانها","https://www.aldiwan.net/poem29552.html","الطويل"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[29,"بكر الأمير لغربة وتنائي","https://www.aldiwan.net/poem5658.html","الكامل"],[29,"سقيا لنهي حمامة وحفير","https://www.aldiwan.net/poem5737.html","الكامل"],[29,"حي الديار بعاقل فالأنعم","https://www.aldiwan.net/poem5982.html","الكامل"],[31,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[80,"خزها أرق من الهوى","https://www.aldiwan.net/poem13992.html","مجزوء الكامل"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[64,"الزئبق الأبيض الرقيق إذا","https://www.aldiwan.net/poem52189.html","المنسرح"],[64,"ملائكة السماء هم أمدوا","https://www.aldiwan.net/poem52206.html","الوافر"],[64,"مضى وزراؤكم موتا وقتلا","https://www.aldiwan.net/poem52298.html","الوافر"],[47,"أما الشباب فقد سبقت بغضه","https://www.aldiwan.net/poem64623.html","الكامل"],[63,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[68,"خيال سرى والنجم في القرب راسخ","https://www.aldiwan.net/poem38495.html","الطويل"],[33,"أأنكرت من بعد عرفانكا","https://www.aldiwan.net/poem42028.html","المتقارب"],[107,"خزاعة أبشري بالعهد سمحا","https://www.aldiwan.net/poem44065.html","الوافر"],[52,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[48,"إذا قيل لك اخش الله","https://www.aldiwan.net/poem22044.html","الهزج"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62254","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67351","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[132,"إذا ما بدا برق بنعمان لامع","https://www.aldiwan.net/poem50583.html","الطويل"],[132,"ألا إنني في نعمة ومسرة","https://www.aldiwan.net/poem50629.html","الطويل"],[173,"ماذا بنا في طلاب العز ننتظر","https://www.aldiwan.net/poem1631.html",""],[207,"يا نبي الهدى إليك لجا حي","https://www.aldiwan.net/poem68171.html","الخفيف"],[215,"دخلت أسيوط والآمال تعصف بي","https://www.aldiwan.net/poem46311.html","البسيط"],[275,"إذا عهدوا فليس لهم وفاء","https://www.aldiwan.net/poem52095.html","البسيط"],[275,"أرى برق الغوير اذا تراءى","https://www.aldiwan.net/poem52103.html","الوافر"],[309,"خزائن فيها راهن للمدافع","https://www.aldiwan.net/poem56478.html","المتقارب"],[310,"صرمت ظليمة خلتي ومراسلي","https://www.aldiwan.net/poem25.html","الكامل"],[353,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[370,"خزنت من دره إذ لم أجد أحدا","https://www.aldiwan.net/poem17288.html","البسيط"],[443,"أهلا بمن نصر الإله وأيدا","https://www.aldiwan.net/poem34795.html","الكامل"],[461,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[464,"أرادت جوارا بالعراق فلم تطق","https://www.aldiwan.net/poem15094.html","الطويل"],[464,"واني على همي بعصري وأهله","https://www.aldiwan.net/poem15938.html","الطويل"],[464,"لله در قبيلة","https://www.aldiwan.net/poem16136.html","مجزوء الكامل"],[471,"خزائن الحمد لا تفنى إذا فنيت","https://www.aldiwan.net/poem59888.html","البسيط"],[471,"يا أيها الخل الذي","https://www.aldiwan.net/poem60128.html","مجزوء الكامل"],[486,"هجرت أمامة هجراً طويلا","https://www.aldiwan.net/poem2071.html","المتقارب"],[556,"ديونك لا يقضى الزمان غريمها","https://www.aldiwan.net/poem68384.html","الطويل"],[561,"لنور عين الوجود أعيان","https://www.aldiwan.net/poem33781.html","المنسرح"],[565,"أجارتنا هل للنسيم وصول","https://www.aldiwan.net/poem52906.html","الطويل"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/17648","المتقارب"],[856,"","https://poetry.dctabudhabi.ae/diwan/poem/18054","الطويل"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/12036","البسيط"],[945,"","https://poetry.dctabudhabi.ae/diwan/poem/198266","الرجز"]],"verses":[["خَزيانَ يَخرُجُ في الظَلا","مِ خُروجَ خُفّاشِ المَغاوِر",0,"ر",1,0],["خُزامى الِلوى هَبَّت لَهُ الريحُ بعَدمَا","عَلا نورَها مجُّ الثَرى المُتَدارِكِ",1,"ك",1,0],["خَزايَةً أَدرَكَتهُ بَعدَ جَولَتِهِ","مِن جانِبِ الحَبلِ مَخلوطاً بِها الغَضَبُ",2,"ب",1,0],["خَزِيَ الفَرَزدَقُ وَالأُخَيطِلُ قَبلَهُ","وَالبارِقِيُّ وَراكِبُ القَصواءِ",3,"ا",2,0],["خَزِيَ الفَرَزدَقُ بَعدَ وَقعَةِ سَبعَةٍ","كَالحِصنِ مِن وَلَدِ الأَشَدِّ ذُكورِ",4,"ر",1,0],["خَزَمَ الأُنوفَ وَقادَ كُلَّ عِمارَةٍ","صَعبُ القِيادِ مَخاطِرٌ لَم يُخزَمِ",5,"م",1,0],["خُزرَ العُيونِ إِلى رِياحٍ بَعدَما","جَعَلَت لِضَبَّةَ بِالرِماحِ ظِلالا",6,"ل",2,0],["خَزَّها أَرقّ مِنَ الهَوى","وَأَرقَّ مِنَ جِسم الهَوا",7,"ه",3,1],["خَزائِنُ المَغرِبِ في رِكابِهِ","تَبارَكَت خَزائِنُ اللَهِ المِلا",8,"ا",1,0],["خزائن الله في دواخلها","تخرج من جوفها وتمتارُ",9,"ر",1,0],["خزائن ربنا اجتمعت إليهم","وملك العالمين بلا قرينِ",10,"ن",1,0],["خزائِنُهُ المصونةُ صِرْنَ نَهْباً","على يدهِ وعُدَّتُه الجزيلَهْ",11,"ل",2,0],["خَزيانَ أَكبَرَ أَن تَظُنَّ خِيانَةً","في بَسطِهِ لِصَديقِهِ أَو قَبضِهِ",12,"ض",2,0],["خُزرِ العُيونِ خَفيَّةٍ أصواتُها","تُكْسي الرؤوسَ شوائلَ الأذنابِ",13,"ب",1,0],["خَزائِنُهُ مَبذولَةٌ وَأَكُفُّهُ","بِحارُ النَدى ما بَينَهُنَّ بَرازِخُ",14,"خ",1,0],["خُزاماكَ مونِقَةٌ ظِلُّها","وَقُريانُهُم دونَ قُريانِكا",15,"ك",2,0],["خَزَاعَةُ أَبشِري بالعهدِ سَمْحا","وَزِيدِي دَولَةَ الإسلامِ فَتْحا",16,"ح",2,1],["خَزَمتَ بِمَخزومٍ أُنوفاً كَثيرَةً","وَهَشَّمتَ أُخرى بِالهَواشِمِ حُشَّدا",17,"د",2,0],["خُزامى وَأَقاحِيُّ","وَصَفراءُ وَشُقّارا",18,"ر",2,0],["خُزَامَى وسَعْدَانٌ كَأَنَّ رِيَاضَهَا","مُهِدْنَ بِذِي البِرْبِيطَياءِ المُهَذَّبِ",19,"ب",1,1],["خَزَايَا لَمْ تَنَالُوا ثَمَّ خَيْراً","وَكِدْتُمْ أَنْ تَكُونُوا دَامِرِينا",20,"ن",2,0],["خَزِيَ الخزُّ وَاِستَشانَ بِقَومٍ","وَبِكَ اِزدانَ كُلُّ وَشيٍ وَخَزِّ",21,"ز",1,0],["خزائنُه مقروغة لِعُفاتِه","وأمواله للعالمين مَنافِعُ",22,"ع",1,0],["خزائنُه مملوءةٌ كرَماً فمن","يَرَى في كراماتِ الرضا كمحمدِ",23,"د",1,0],["خُزرِ العُيونِ إِذا أَبصارُهُم نَظَرَت","شَخصي فَلا زالَ عَنها ذَلِكَ الخَزَرُ",24,"ر",1,0],["خَزرَجِيٌّ لَو يَستَطيعُ مِنَ الغَي","ظِ رَمانا بِالنَسرِ وَالعَوّاءِ",25,"ا",2,0],["خزّان أسيوط ما ليلٌ نعمت به","ليل التقينا بوادي الإنس والجان",26,"ن",1,0],["خزان أسيوط ردّتني إليك يدٌ","ردّ الغريب إلى أهل وأوطان",26,"ن",1,0],["خزان أسيوط هل تدري الذي صنعت","يدُ الفراق بقلب القاطف الجاني",26,"ن",2,0],["خَزائِن رَحمَتي وَنَعيم ملكي","بحكمك فاقض فيها ما تَشاء",27,"ا",2,0],["خَزائن رَحمَتي لك فاقض فيها","بحكمك لست امنعك العَطاء",28,"ا",2,0],["خَزائنُ فيها راهنٌ للمدافع","بَناها لِحامي دينهِ ومنافعِ",29,"ع",1,1],["خُزرٍ عيوُنُهُم الى أعدائِهم","يمشونَ مشي الأُسدِ تحت الوابِلِ",30,"ل",1,0],["خَزّانِ أَسرارِ الغَرامِ مَلجَأَ ال","عُشّاقِ مِن أَهلِ الشِقاقِ وَالجَدَل",31,"ل",1,0],["خَزَنتُ مِن دُرِّهِ إِذ لَم أَجِد أَحَداً","سِواكَ يا مَن نَداهُ غَيرُ مُختَزَنِ",32,"ن",1,1],["خزيانَ قَدْ أَوْسَعْتَ حُرَّ بلادِهِ","وديارِهِ لَهَبَ السعيرِ المُوقَدَا",33,"د",2,0],["خزيانَ يُقسِمُ لا سعَى أبداً","للمجد في وَهْنٍ ولا عَقْرِ",34,"ر",1,0],["خزائنهم أيدي العُفاةِ لأنهم","رأوها على مرِّ الزمان بواقيا",35,"ي",2,0],["خزنْتُ لساني سُؤْدداً ورئاسةً","ولو شئتُ فاقَ المُرْهفاتِ هجائي",36,"ي",1,0],["خُزْرُ العيونِ تَعوَّضَتْ","بِدمِ الطُّلى عنْ مائها",37,"ا",3,0],["خَزائِنُ الحَمدِ لا تَفنى إِذا فَنِيَت","خَزائِنُ المالِ وَاِختَلَّت مَرابِعُهُ",38,"ه",1,1],["خَزُّ الظَلامِ قَدِ انِطَوى","فَاِشرَب عَلى شُربِ النَهارِ",39,"ر",1,0],["خِزيُ الحَياةِ وَحَربُ الصَديقِ","وَكُلّاً أَراهُ طَعاماً وَبيلا",40,"ل",2,0],["خُزَيمَةُ لا بَأسٌ بِهِ غَيرَ أَنَّهُ","لِمَطبَخِهِ قُفلٌ وَبابُ حَديدِ",41,"د",1,0],["خزانة الحرف فتحها شرف","والقفل ربحٌ لها وخسران",42,"ن",1,0],["خَزائنهُ بِيضٌ وسُمْرٌ وأدرُعٌ","ونَبْلٌ وتُرسٌ مانعٌ وخُيولُ",43,"ل",1,0],["خُزاعَةُ قَومي فَإِن أَفتَخِر","بِهِم يَزكُ مُعتَصَري وَالنَسَب",44,"ب",1,0],["خُزَيمَةُ رَدّاني الفَعالَ وَمَعشَرٌ","قَديماً بَنوا لي سورَةَ المَجدِ وَالكَرَم",45,"م",1,0],["خُزراً عُيونُهُمُ كَأَنَّ لَحظَهُمُ","حَريقُ نارٍ تَرى مِنهُ السَنا قِطَعا",46,"ع",2,0],["خَزَعلةَ الضِبعانِ راحَ الهنبَلَةْ","وهَلْ عَلِمتِ فُحَشَاءَ جَهِلَهْ",47,"ل",2,0]]}