العين","https://www.poetsgate.com/ViewPoem.aspx?id=1587",""],[5582,"أَهاجَ لَكَ التَّذْكارَ وَالوَجْدَ بارِقُ","https://www.poetsgate.com/ViewPoem.aspx?id=187213",""],[5739,"الحرف دلاّل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127067",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[5894,"خف الله فالألحاظ منك شوامخ","https://www.poetsgate.com/ViewPoem.aspx?id=131416",""],[5943,"يااسودَ الوجهِ ياقذاف ويلاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=61861",""],[5956,"أرجو اللجوء لأرضكم وحنوِّكم","https://www.poetsgate.com/ViewPoem.aspx?id=194126",""],[5956,"أنهكتَ نفسك لتنفعني وتنفعَ العالم","https://www.poetsgate.com/ViewPoem.aspx?id=206262",""],[5956,"هل يستطيب الفتى إيهابُ فُرقتنا","https://www.poetsgate.com/ViewPoem.aspx?id=210301",""],[5973,"الماس يصبح أغلي حين نفقده","https://www.poetsgate.com/ViewPoem.aspx?id=29237",""],[6038,"اوسط الحلين","https://www.poetsgate.com/ViewPoem.aspx?id=25691",""],[6102,"صراع","https://www.poetsgate.com/ViewPoem.aspx?id=184432",""]],"verses":[["خَزيانَ يَخرُجُ في الظَلا","مِ خُروجَ خُفّاشِ المَغاوِر",0,"ر",1,0],["خُزامى الِلوى هَبَّت لَهُ الريحُ بعَدمَا","عَلا نورَها مجُّ الثَرى المُتَدارِكِ",1,"ك",1,0],["خَزايَةً أَدرَكَتهُ بَعدَ جَولَتِهِ","مِن جانِبِ الحَبلِ مَخلوطاً بِها الغَضَبُ",2,"ب",1,0],["خَزِيَ الفَرَزدَقُ وَالأُخَيطِلُ قَبلَهُ","وَالبارِقِيُّ وَراكِبُ القَصواءِ",3,"ا",2,0],["خَزِيَ الفَرَزدَقُ بَعدَ وَقعَةِ سَبعَةٍ","كَالحِصنِ مِن وَلَدِ الأَشَدِّ ذُكورِ",4,"ر",1,0],["خَزَمَ الأُنوفَ وَقادَ كُلَّ عِمارَةٍ","صَعبُ القِيادِ مَخاطِرٌ لَم يُخزَمِ",5,"م",1,0],["خُزرَ العُيونِ إِلى رِياحٍ بَعدَما","جَعَلَت لِضَبَّةَ بِالرِماحِ ظِلالا",6,"ل",2,0],["خَزَّها أَرقّ مِنَ الهَوى","وَأَرقَّ مِنَ جِسم الهَوا",7,"ه",3,1],["خَزائِنُ المَغرِبِ في رِكابِهِ","تَبارَكَت خَزائِنُ اللَهِ المِلا",8,"ا",1,0],["خزائن الله في دواخلها","تخرج من جوفها وتمتارُ",9,"ر",1,0],["خزائن ربنا اجتمعت إليهم","وملك العالمين بلا قرينِ",10,"ن",1,0],["خزائِنُهُ المصونةُ صِرْنَ نَهْباً","على يدهِ وعُدَّتُه الجزيلَهْ",11,"ل",2,0],["خَزيانَ أَكبَرَ أَن تَظُنَّ خِيانَةً","في بَسطِهِ لِصَديقِهِ أَو قَبضِهِ",12,"ض",2,0],["خُزرِ العُيونِ خَفيَّةٍ أصواتُها","تُكْسي الرؤوسَ شوائلَ الأذنابِ",13,"ب",1,0],["خَزائِنُهُ مَبذولَةٌ وَأَكُفُّهُ","بِحارُ النَدى ما بَينَهُنَّ بَرازِخُ",14,"خ",1,0],["خُزاماكَ مونِقَةٌ ظِلُّها","وَقُريانُهُم دونَ قُريانِكا",15,"ك",2,0],["خَزَاعَةُ أَبشِري بالعهدِ سَمْحا","وَزِيدِي دَولَةَ الإسلامِ فَتْحا",16,"ح",2,1],["خَزَمتَ بِمَخزومٍ أُنوفاً كَثيرَةً","وَهَشَّمتَ أُخرى بِالهَواشِمِ حُشَّدا",17,"د",2,0],["خُزامى وَأَقاحِيُّ","وَصَفراءُ وَشُقّارا",18,"ر",2,0],["خُزَامَى وسَعْدَانٌ كَأَنَّ رِيَاضَهَا","مُهِدْنَ بِذِي البِرْبِيطَياءِ المُهَذَّبِ",19,"ب",1,1],["خَزَايَا لَمْ تَنَالُوا ثَمَّ خَيْراً","وَكِدْتُمْ أَنْ تَكُونُوا دَامِرِينا",20,"ن",2,0],["خَزِيَ الخزُّ وَاِستَشانَ بِقَومٍ","وَبِكَ اِزدانَ كُلُّ وَشيٍ وَخَزِّ",21,"ز",1,0],["خزائنُه مقروغة لِعُفاتِه","وأمواله للعالمين مَنافِعُ",22,"ع",1,0],["خزائنُه مملوءةٌ كرَماً فمن","يَرَى في كراماتِ الرضا كمحمدِ",23,"د",1,0],["خُزرِ العُيونِ إِذا أَبصارُهُم نَظَرَت","شَخصي فَلا زالَ عَنها ذَلِكَ الخَزَرُ",24,"ر",1,0],["خَزرَجِيٌّ لَو يَستَطيعُ مِنَ الغَي","ظِ رَمانا بِالنَسرِ وَالعَوّاءِ",25,"ا",2,0],["خزّان أسيوط ما ليلٌ نعمت به","ليل التقينا بوادي الإنس والجان",26,"ن",1,0],["خزان أسيوط ردّتني إليك يدٌ","ردّ الغريب إلى أهل وأوطان",26,"ن",1,0],["خزان أسيوط هل تدري الذي صنعت","يدُ الفراق بقلب القاطف الجاني",26,"ن",2,0],["خَزائِن رَحمَتي وَنَعيم ملكي","بحكمك فاقض فيها ما تَشاء",27,"ا",2,0],["خَزائن رَحمَتي لك فاقض فيها","بحكمك لست امنعك العَطاء",28,"ا",2,0],["خَزائنُ فيها راهنٌ للمدافع","بَناها لِحامي دينهِ ومنافعِ",29,"ع",1,1],["خُزرٍ عيوُنُهُم الى أعدائِهم","يمشونَ مشي الأُسدِ تحت الوابِلِ",30,"ل",1,0],["خَزّانِ أَسرارِ الغَرامِ مَلجَأَ ال","عُشّاقِ مِن أَهلِ الشِقاقِ وَالجَدَل",31,"ل",1,0],["خَزَنتُ مِن دُرِّهِ إِذ لَم أَجِد أَحَداً","سِواكَ يا مَن نَداهُ غَيرُ مُختَزَنِ",32,"ن",1,1],["خزيانَ قَدْ أَوْسَعْتَ حُرَّ بلادِهِ","وديارِهِ لَهَبَ السعيرِ المُوقَدَا",33,"د",2,0],["خزيانَ يُقسِمُ لا سعَى أبداً","للمجد في وَهْنٍ ولا عَقْرِ",34,"ر",1,0],["خزائنهم أيدي العُفاةِ لأنهم","رأوها على مرِّ الزمان بواقيا",35,"ي",2,0],["خزنْتُ لساني سُؤْدداً ورئاسةً","ولو شئتُ فاقَ المُرْهفاتِ هجائي",36,"ي",1,0],["خُزْرُ العيونِ تَعوَّضَتْ","بِدمِ الطُّلى عنْ مائها",37,"ا",3,0],["خَزائِنُ الحَمدِ لا تَفنى إِذا فَنِيَت","خَزائِنُ المالِ وَاِختَلَّت مَرابِعُهُ",38,"ه",1,1],["خَزُّ الظَلامِ قَدِ انِطَوى","فَاِشرَب عَلى شُربِ النَهارِ",39,"ر",1,0],["خِزيُ الحَياةِ وَحَربُ الصَديقِ","وَكُلّاً أَراهُ طَعاماً وَبيلا",40,"ل",2,0],["خُزَيمَةُ لا بَأسٌ بِهِ غَيرَ أَنَّهُ","لِمَطبَخِهِ قُفلٌ وَبابُ حَديدِ",41,"د",1,0],["خزانة الحرف فتحها شرف","والقفل ربحٌ لها وخسران",42,"ن",1,0],["خَزائنهُ بِيضٌ وسُمْرٌ وأدرُعٌ","ونَبْلٌ وتُرسٌ مانعٌ وخُيولُ",43,"ل",1,0],["خزٌّ وديباجٌ دِمقسٌ اطلسٌ","حَبرٌ كما نسج العناكب طارا",44,"ر",2,0],["خُزيتَ يا شَعرُ فكم أمرداً","أَشقَيتَهُ من بعد تتريف",45,"ف",1,0],["خزٌّ ووشيٌ حكى مُقَمَّعُه","ما حاك هذا الربيعُ من قِطَعه",46,"ع",2,0],["خزان علم اللَه أبوبا الهدى","ركن الولاء معالم الإيمان",47,"ن",1,0],["خزن الأموال وابتا","ع بها كأسا وكُسّبا",48,"س",3,0],["خَزائن الجَبابر العاديه","كانَت بِها متينة قَويه",49,"ه",1,0],["خزلهم طي وإضمار معه","في كامل بنقطة مرتفعه",50,"ه",1,0],["خزمهمُ زد واحدا لأربعه","أوّل كلّ ومن الوزن امنعه",50,"ه",1,0],["خزائنُنَا ملأَى ، ومَا هِي ذُخرُنا ال","معَدُّ، ولكنَّ الثوابَ هو الُّذخْرُ",51,"ر",1,0],["خُزاعَةُ قَومي فَإِن أَفتَخِر","بِهِم يَزكُ مُعتَصَري وَالنَسَب",52,"ب",1,0],["خَزرجِيِّ النِجارِ فَرع بني الن","نجارِ جَمِّ الفَخارِ عالِي المبانِي",53,"ن",2,0],["خُزرِ العُيونِ طَيِّبي النُصولِ","شُعثٌ عَلى شُعثٍ مِن الفُحولِ",54,"ل",1,0],["خزائن اللطف لي من فيضها مدد","بحمد ربي وحسبي ذاك من مدد",55,"د",1,1],["خزانة لكنوز الدرّ قد وسقت","من كل بحر يفيض العلم مُطّرد",56,"د",1,1],["خِزانةُ أسرارِ الإله وغيبُه","ومنبعُ أسرارٍ تراءت لذي حِجى",57,"ا",1,0],["خزائنُ الجودِ ما انسدَّت مغالقُها","لو انتهت لانتهى في العالم الفقر",58,"ر",1,0],["خزائنُ آدابٍ بَعَثتَ بشدُرِّها","إلىّ ولم تمنُهن بخشية إنفاق",59,"ق",1,0],["خزائنُ آداب بعثت بدُرِّها","إليّ ولم تمنن لخشية إنفاق",60,"ق",1,0],["خُزَيمَةُ رَدّاني الفَعالَ وَمَعشَرٌ","قَديماً بَنوا لي سورَةَ المَجدِ وَالكَرَم",61,"م",1,0],["خُزراً عُيونُهُمُ كَأَنَّ لَحظَهُمُ","حَريقُ نارٍ تَرى مِنهُ السَنا قِطَعا",62,"ع",2,0],["خزائنك بالجود لا تنتهي","لكثرة عطاياك للراغبين",63,"ن",1,0],["خزائنُ أرضِ اللّه في يد يوسف","فهل لسواه في الملوك يرى قصدي",64,"د",2,0],["خزنا عليك به حزنا الجوى كمدا","وأنت في فرحة بالبشر مسرور",65,"ر",1,0],["خَزنوي والينا هناكَ اِستشهَدا","مِن بَعدِهِ مَحمود نَجل المُقتَدى",66,"د",2,0],["خزور قل جبل وعمق بعده","وردين مضيان مع القدموسة",67,"ه",1,0],["خُزْرَ العيونِ إذا أردْتَ قتالَهمْ","برزوا سِماحاً كلهُمْ بحِمامِها",68,"م",3,0],["خَزائِنُ رَحمَتي وَنَعيمُ مُلكي","وَدارُ كَرامَةٍ فيها المُناءُ",69,"ا",2,0],["خَزَعلةَ الضِبعانِ راحَ الهنبَلَةْ","وهَلْ عَلِمتِ فُحَشَاءَ جَهِلَهْ",70,"ل",2,0],["خِزَانَةُ الجُرْحِ آفَاقٌ مُسَيَّجَةٌ","تُغَرِّدُ الصُّبْحَ غُدْرَانَاً مِنَ السَّعَفِ",71,"ف",1,0],["خَزائن العلم وَالعرفان قَد بذلوا","لأَهله من خَبايا كنزه دررا",72,"ر",2,0],["خِزيٌ حياتُهُم رِجسٌ وَفاتُهُم","لا تَقبَلُ الأَرضُ مَوتاهُم إِذا قُبِروا",73,"ر",3,0],["خِزيُ البُعولَةِ وَالأَفواهُ مُرِوحَةٌ","إِذا تَفَتَّلَ في أَستاهِها الشَعَرُ",73,"ر",1,0],["خزان علم الله موضع سره","أمناؤه في الجهر والإخفاء",74,"ا",2,0],["خَزائن أَرض اللَه مَصر وَكَم أَتى","حَديث رَوته السادة القُدَماءُ",75,"ا",2,0],["خزائنه ملأى من الحمد والثنا","إذاً فليقل ما شاء فيه المؤرخ",76,"خ",1,0],["خزيمةُ لم يُنكر له مثل هؤه","اذا اضطربت شرقُ البلاد مع الغربِ",77,"ب",1,0],["خَزَائِنُ رَحمَةٍ مِنَ اللهِ فُتِّحَت","وَلَكِن خِتَامُ الكُفرِ مَا كَادَ يُفسَخُ",78,"خ",1,0],["خزائن علمه بالفضل فاضت","ومنه الجود مقرون بعطف",79,"ف",1,0],["خزنتهم فكانوا حيث تهوى","وخير خزائن الدول الرجال",80,"ل",1,0],["خُزرَ العيونِ منكسي أرقابَهم","نظرَ لذليل إلى العزيز القاهر",81,"ر",1,0],["خَزّانة المَجد في الأَحجاءِ مِن قِدَمِ","تَجودُ بِالمالِ وَالأَجسامِ وَالنسمِ",82,"م",1,0],["خَزائِنكَ المَلأى لِكُل مُؤمل","مُفَتَّحَة تَغنيه لَو أَخلَف القَطر",83,"ر",1,0],["خزا وبرفيرا وكل كريمة","فمن العقيق لعسجد وضاءِ",84,"ا",2,0],["خزاماً وقيسوماً تظلَّل تربهُ","عباهرهُ حُفَّت من الشيح والرندِ",85,"د",1,0],["خَزّون لمّا بالصِبا قسراً نأت","وبكَت صِباها أعينٌ وشُؤونُ",86,"ن",1,1],["خزانة سري كم حوَيتِ معارِفاً","بِإِرسالِ فِكري في الوجودِ يفكرُ",87,"ر",1,0],["خزانةُ الرحموتِ","في الملك وَالمَلكوتِ",88,"ت",1,0],["خزائنُ الرحمنِ مملوءةٌ","للقارعِ البابَ وللواصلِ",89,"ل",1,0],["خزائنُهُ مملوءةٌ يعطِ من يشا","تعالى إله آخِرٌ ثم أَوَّلُ",90,"ل",1,0],["خزائنُه مملوءةٌ ما يَبِيدُها","عطاءٌ لهُ عمَّ الشَّكورَ وكافرا",91,"ر",2,0],["خُزَعبِلات صِبى مرّت وَأَهل هَوىً","مَرُّوا فَلا رَجعت يَوماً وَلا رَجعوا",92,"ع",3,0],["خزانة كتب عينُ ناظرها بها","تقر وأبهاها أمالي ابن حاجب",93,"ب",1,0],["خزانةُ فكري كورة وتخيّلي","لتحلِ معانٍ تلفظ الشهدَ يعسوبُ",94,"ب",1,1],["خزانة الأدب القاضي نملّكها","فلأبن حجةَ فيه خير تسجيل",95,"ل",1,1],["خزائن علمٍ علَّم اللوح بعضها","ففي كل شئ لم يزل يستشيرها",96,"ر",3,0],["خزائنهم مما أفاض نواله","عليهم ومنه تاجُها وسريرها",96,"ر",3,0],["خزوم حازم خرم انف(ن)غرورن","حرور كاوي يصطفق في معارمه",97,"م",2,0],["خزنتُ بمالك لحظه وجنانه","أيكون مالك خازن الجنَّات",98,"ت",1,0],["خزمت مخزوم فاه","فادعاها بالإشاره",99,"ر",2,0],["خزائنُ الفكر ِ لمْ تُعلِنْ خسائرَها","وكلُّها منكِ كمْ ذا حقَّقتْ كسبا",100,"ب",2,0],["خزائن غاية في الصنع مذهلة","بكل بيت حوت مااختص بالأسر",101,"ر",1,0],["خزيان مزقت نقاب الحيا","من كل مستورٍ بجثمانِهِ",102,"ن",2,0],["خزر العيون تراهم في ذلة","كم قد أبادوا من مليك قاهر",103,"ر",1,0],["خزنت كنوزاً من ولاكم ثمينة","بقلبي وإني قد حفظت ادخارها",104,"ر",3,0],["خزمت خياشيم الملوك لأحمد","وقد تهم قسرا كقود المصاعب",105,"ب",1,0],["خزنتُ الصبرّ حتّى ملّ مني","وعاتبني فهجريَ مايريدُ",106,"د",1,0],["خزني بالعين والرمش الثليل","من نظرتن باشرتني بالعدام",107,"م",1,1],["خَزايِنُهُ لَمْ يَجْتَمِعْ قَطُّ شَمْلُها","كأَنَّ غُرابَ البَيْنِ فِيهِنَّ ناعِقُ",108,"ق",1,0],["خزاين اهل البث والغث والمال.","محفوظه بْشاشة .. قلوب ٍ غثيثه.",109,"ث",2,0],["خُزاعتا هاكِ ما أسلَفتِ ياسَلَفي","بيتاً مِنَ الشِعرِ مِن بيتٍ مِنَ الشَعَرِ",110,"ر",1,0],["خزائنه للقاصدين تحية","أياديه للأيدي حصون ش