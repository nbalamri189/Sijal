{"poems":[[86,"هذا صبي هائم","https://www.aldiwan.net/poem10861.html","مجزوء الكامل"],[30,"أقول لأطلاح برى هطلانها","https://www.aldiwan.net/poem29552.html","الطويل"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[27,"بكر الأمير لغربة وتنائي","https://www.aldiwan.net/poem5658.html","الكامل"],[27,"سقيا لنهي حمامة وحفير","https://www.aldiwan.net/poem5737.html","الكامل"],[27,"حي الديار بعاقل فالأنعم","https://www.aldiwan.net/poem5982.html","الكامل"],[29,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[78,"خزها أرق من الهوى","https://www.aldiwan.net/poem13992.html","مجزوء الكامل"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[62,"الزئبق الأبيض الرقيق إذا","https://www.aldiwan.net/poem52189.html","المنسرح"],[62,"ملائكة السماء هم أمدوا","https://www.aldiwan.net/poem52206.html","الوافر"],[62,"مضى وزراؤكم موتا وقتلا","https://www.aldiwan.net/poem52298.html","الوافر"],[45,"أما الشباب فقد سبقت بغضه","https://www.aldiwan.net/poem64623.html","الكامل"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[66,"خيال سرى والنجم في القرب راسخ","https://www.aldiwan.net/poem38495.html","الطويل"],[31,"أأنكرت من بعد عرفانكا","https://www.aldiwan.net/poem42028.html","المتقارب"],[105,"خزاعة أبشري بالعهد سمحا","https://www.aldiwan.net/poem44065.html","الوافر"],[50,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[46,"إذا قيل لك اخش الله","https://www.aldiwan.net/poem22044.html","الهزج"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67351","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"]],"verses":[["خَزيانَ يَخرُجُ في الظَلا","مِ خُروجَ خُفّاشِ المَغاوِر",0,"ر",1,0],["خُزامى الِلوى هَبَّت لَهُ الريحُ بعَدمَا","عَلا نورَها مجُّ الثَرى المُتَدارِكِ",1,"ك",1,0],["خَزايَةً أَدرَكَتهُ بَعدَ جَولَتِهِ","مِن جانِبِ الحَبلِ مَخلوطاً بِها الغَضَبُ",2,"ب",1,0],["خَزِيَ الفَرَزدَقُ وَالأُخَيطِلُ قَبلَهُ","وَالبارِقِيُّ وَراكِبُ القَصواءِ",3,"ا",2,0],["خَزِيَ الفَرَزدَقُ بَعدَ وَقعَةِ سَبعَةٍ","كَالحِصنِ مِن وَلَدِ الأَشَدِّ ذُكورِ",4,"ر",1,0],["خَزَمَ الأُنوفَ وَقادَ كُلَّ عِمارَةٍ","صَعبُ القِيادِ مَخاطِرٌ لَم يُخزَمِ",5,"م",1,0],["خُزرَ العُيونِ إِلى رِياحٍ بَعدَما","جَعَلَت لِضَبَّةَ بِالرِماحِ ظِلالا",6,"ل",2,0],["خَزَّها أَرقّ مِنَ الهَوى","وَأَرقَّ مِنَ جِسم الهَوا",7,"ه",3,1],["خَزائِنُ المَغرِبِ في رِكابِهِ","تَبارَكَت خَزائِنُ اللَهِ المِلا",8,"ا",1,0],["خزائن الله في دواخلها","تخرج من جوفها وتمتارُ",9,"ر",1,0],["خزائن ربنا اجتمعت إليهم","وملك العالمين بلا قرينِ",10,"ن",1,0],["خزائِنُهُ المصونةُ صِرْنَ نَهْباً","على يدهِ وعُدَّتُه الجزيلَهْ",11,"ل",2,0],["خَزيانَ أَكبَرَ أَن تَظُنَّ خِيانَةً","في بَسطِهِ لِصَديقِهِ أَو قَبضِهِ",12,"ض",2,0],["خُزرِ العُيونِ خَفيَّةٍ أصواتُها","تُكْسي الرؤوسَ شوائلَ الأذنابِ",13,"ب",1,0],["خَزائِنُهُ مَبذولَةٌ وَأَكُفُّهُ","بِحارُ النَدى ما بَينَهُنَّ بَرازِخُ",14,"خ",1,0],["خُزاماكَ مونِقَةٌ ظِلُّها","وَقُريانُهُم دونَ قُريانِكا",15,"ك",2,0],["خَزَاعَةُ أَبشِري بالعهدِ سَمْحا","وَزِيدِي دَولَةَ الإسلامِ فَتْحا",16,"ح",2,1],["خَزَمتَ بِمَخزومٍ أُنوفاً كَثيرَةً","وَهَشَّمتَ أُخرى بِالهَواشِمِ حُشَّدا",17,"د",2,0],["خُزامى وَأَقاحِيُّ","وَصَفراءُ وَشُقّارا",18,"ر",2,0],["خَزَايَا لَمْ تَنَالُوا ثَمَّ خَيْراً","وَكِدْتُمْ أَنْ تَكُونُوا دَامِرِينا",19,"ن",2,0],["خَزِيَ الخزُّ وَاِستَشانَ بِقَومٍ","وَبِكَ اِزدانَ كُلُّ وَشيٍ وَخَزِّ",20,"ز",1,0]]}