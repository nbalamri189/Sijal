{"poems":[[53,"لهوت عن وصف الطلول الدارسه","https://www.aldiwan.net/poem64573.html","الرجز"],[93,"لمن يضوع العبير لمن تغني الطيور","https://www.aldiwan.net/poem8821.html","عموديه"],[563,"يا شمعة هي في كل الفوانيس","https://www.aldiwan.net/poem34446.html","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77545","الخفيف"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145607","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120137","الرمل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126221","الرجز"],[6052,"كاسات الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=34649",""]],"verses":[["كَيّسة في ذاك لا مُكايسه","ماركَسَتْها في ضلال راكسه",0,"س",2,0],["كيسٌ عَلى غَيرِ شَيءٍ","مِنَ الحِلى مَصرورُ",1,"ر",1,0],["كيس تقدر من شتى الشئون له","والسر أجمعه في ذلك الكيس",2,"س",1,0],["كَيِّساً وابنُ سادة","ذا فُنونٍ تَكمَّلت",3,"ت",1,0],["كيس الفقير كله في طرفه","يا بعد سلطان الهوى من ظرفه",4,"ه",1,0],["كيسا سهلا كتوما","إن رأى في الدار حسا",5,"س",2,0],["كِيسى مَلىٌّ بالقَنَاعَةِ ليس لل","نُورِى ثَمَّةَ حاجةٌ بمَنَالِك",6,"ك",1,0],["كيس الإهانة للرؤوس يلفها","وبعريها تتكور الأجساد",7,"د",1,0]]}