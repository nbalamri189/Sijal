{"poems":[[55,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[79,"أنت للمسلمين خير عماد","https://www.aldiwan.net/poem36396.html","الخفيف"],[53,"كم نسام الأذى كأنا كلاب","https://www.aldiwan.net/poem8534.html","الخفيف"],[63,"حرق تمتري الدموع سجالا","https://www.aldiwan.net/poem51461.html","الخفيف"],[63,"من ذم إدريس في قيادته","https://www.aldiwan.net/poem51594.html","المنسرح"],[77,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42694","الكامل"],[132,"حي المعاليم والرسوما","https://www.aldiwan.net/poem50515.html","مجزوء الكامل"],[147,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[287,"كل مليح عبد عبد الرحيم","https://www.aldiwan.net/poem32443.html","السريع"],[295,"أبشري يا دمشق بالأبطال","https://www.aldiwan.net/poem11669.html","الخفيف"],[520,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[580,"ليل وصل منيرة أقماره","https://www.aldiwan.net/poem3059.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122684","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59565","المديد"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80231","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27401","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93571","الخفيف"],[2465,"","https://poetry.dctabudhabi.ae/diwan/poem/124310","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132676","المنسرح"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32386","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58099","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139693",""],[4861,"من القلب","https://www.poetsgate.com/ViewPoem.aspx?id=33707",""]],"verses":[["كُلُّ مَلمومِ القَرا صَعبِ الذُرى","يَزلَقُ العِقبانُ عَنهُ وَالنِسارا",0,"ر",2,0],["كُلُّ مَلْكٍ يُرَى بِصُحْبَةِ أَهْلِ الْ","عِلْمِ قَدْ بَاءَ بِالْمَحَلِّ الْعَزِيزِ",1,"ز",1,0],["كلُّ مُلك يفنى وتبقى على الدهْ","رِ لأهل المكارم الأحسابُ",2,"ب",1,0],["كلُّ ملمومةٍ متى ظنَّ طاغٍ","أنها مَعقِلٌ رآها عِقالا",3,"ل",2,0],["كَلَّمَ لي عاصياً فكانَ له","أطوعَ من آدمٍ لإبليسِ",4,"س",1,0],["كلُّ مُلْكٍ لملِيكٍ بعدَهُ","فهْوَ لَغْوٌ عندما كان عُهِد",5,"د",1,0],["كَلِمٌ لَهَا فِي السَّمْعِ أَطْرَبُ نَغْمَةٍ","وَبِحُجْرَةِ الأَسْرَارِ أَحْسَنُ مَوْقِعِ",6,"ع",1,0],["كَلِمٌ لهم قد غادرتْ","مِنْ غدرهم قَلْبي كَلِيما",7,"م",2,0],["كُلُّ مَلكٍ قَد حازَ فَضلَ أَبيهِ","مِثلَ حَوزِ البَهاءِ فَضلَ الجَلالِ",8,"ل",1,0],["كُلُّ مَليحٍ عَبدُ عَبدِ الرَحيم","لَكِنَّهُ ما قَلبُهُ بِالرَحيم",9,"م",1,1],["كل ملك يقوم يوماً على الظلم","بناءٌ مصيره للزوال",10,"ل",1,0],["كل ملث لا يزال فوقها","عشية الرائح أو إبكاره",11,"ر",2,0],["كل مَلكٍ منهم فِمِنه غِنَاهُ","وإِليْه في المُعْضِلاتِ انْتِصَارُه",12,"ر",2,0],["كَلِمٌ لا يَزينُها كَلِمُ الشَّع","رِ وَلا تُشبِهُ القَوافي القَوافي",13,"ف",2,0],["كلُّ مَلك في مَدىً","للمعالي جمحا",14,"ح",2,0],["كُلُ مُلكٍ ضائِعٌ أَو ساقِطٌ","إِن مَشى مالِكهُ دونَ اِحتِرازِ",15,"ز",1,0],["كلُّ مَلِكٍ متوَّجٌ","يدري بالأمر يخدمُ",16,"م",1,0],["كُل مَلمومة إِذا ما ارجحنت","جللتها بَوارق وَرعود",17,"د",1,0],["كل ملتجة يصعّدُ فيها","زجَلُ الجنّ بالعقول أهولالا",18,"ل",2,0],["كل ملوك الكلام خاضعة","منك لملك يعدّها سوقا",19,"ق",2,0],["كُلُّ مُلِمّاتِ الأُمورِ وَجَدتُّها","سِوى فُرقَةِ الأَحبابِ هَيِّنَةَ الخَطبِ",20,"ب",1,0],["كلٌّ مُلَبٍّ طائِعٌ أَمرَهُ","من ملأٍ أعلى ومع سافِل",21,"ل",1,0],["كل مليكٍ عنه يعتاق إذ","أعيى لحوقاً من لسبقٍ سعى",22,"ع",2,0],["كل ملفى له عمود وله وتد","راعهم حق يستوي ساسك متين",23,"ن",1,0]]}