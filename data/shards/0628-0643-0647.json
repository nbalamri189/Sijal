{"poems":[[119,"يا غائبا في القلب حاضر","https://www.aldiwan.net/poem41074.html","عموديه"],[242,"بك هذا المكان يا من فراقه","https://www.aldiwan.net/poem19503.html","الخفيف"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76795","البسيط"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108450","الرمل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199638","المسحوب"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112352","المتدارك"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86537","الكامل"],[5225,"بك هلا","https://www.poetsgate.com/ViewPoem.aspx?id=27615",""],[5561,"بلدي","https://www.poetsgate.com/ViewPoem.aspx?id=211443",""]],"verses":[["بك هام طورا سره","واولو الهيام لهم سرائر",0,"ر",1,0],["بِكَِ هَذَا الْمَكَانُ يَا مَنْ فِرَاقُهْ","هَالَنَا زَالَ نَحْسُهُ وَمُحَاقُهْ",1,"ق",2,1],["بكهفِ رُحماهُ قد لاذَ الورى وبه","بُشرى ابن مريمَ في الإنجيلِ مُشتهرَه",2,"ر",2,0],["بك هامت كل نفس حرة","وغدا كل فؤاد مستهام",3,"م",1,0],["بك هلا ما هبّت نسايس","يتّلي م المطلع ابروره",4,"ر",2,1],["بكهفٍ تقادمَ فيه العفاء","وكيفَ اللّقاءُ ولي مُهجَةٌ",5,"ه",1,0],["بك هائم هذا الهلال صبابةً","وأراك ما خطر الهلال ببالك",6,"ك",1,0],["بك هلا يا مرحبا ومنّا","والمرده والتبايينا",7,"ن",2,1],["بكَ هذه الدّنيا تعيدُ شبابَها","والمجدُ ينهلُ ما سقتهُ يداكا",8,"ك",2,0]]}