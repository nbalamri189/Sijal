tps://poetry.dctabudhabi.ae/diwan/poem/67347","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54250","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[36,"لما تَخَايلت الحُمُول حَسِبْتَها","https://www.poetsgate.com/ViewPoem.aspx?id=15894",""],[95,"الأشقياء","https://www.poetsgate.com/ViewPoem.aspx?id=707",""],[106,"قالوا أحيل","https://www.poetsgate.com/ViewPoem.aspx?id=179396",""],[106,"غادة البسفور","https://www.poetsgate.com/ViewPoem.aspx?id=179474",""],[106,"زمزم طليعة الأسطول المصري","https://www.poetsgate.com/ViewPoem.aspx?id=179646",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[77,"باتت نجوم الأفق دون علاكا","https://www.poetsgate.com/ViewPoem.aspx?id=34151",""],[77,"خذها فقد وضح الصباح ولاحا","https://www.poetsgate.com/ViewPoem.aspx?id=33805",""],[77,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[49,"مَنْ يعشْ يكبرْ ومنْ يكبَرْ يمُتْ","https://www.poetsgate.com/ViewPoem.aspx?id=16968",""],[98,"مؤتمر الجماد","https://www.poetsgate.com/ViewPoem.aspx?id=55343",""],[90,"تحت ظل النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=179087",""],[90,"مستهام","https://www.poetsgate.com/ViewPoem.aspx?id=178984",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[45,"عَفّى عَلِيُّ بنُ إسحاقٍ، بِفَتكَتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31810",""],[45,"أعادَ شَكوى منَ الطّيفِ الذي اعتَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=31633",""],[45,"أصَبَا الأصَائِلِ إنّ بُرْقَةَ مُنْشِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=32956",""],[45,"عِنْدَ العَقيقِ، فَماثِلاَتِ دِيَارِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31249",""],[45,"يشكو إليك هواك المدنف الوصب","https://www.poetsgate.com/ViewPoem.aspx?id=33094",""],[91,"ستعود دنيانا أحب وأجملا","https://www.poetsgate.com/ViewPoem.aspx?id=53227",""],[105,"تلك القضية هل لها ميعاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55087&r=&rc=257",""],[85,"جعلتُ حُلاها وتمثالها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9586&r=&rc=76",""],[6,"آذَنَتْنَا بِبَينِهَا أَسْماءُ ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14185&r=&rc=0",""]],"verses":[["أَنسى قَنا مُرّانِها","مَوارِنٌ ذاتُ قَنا",0,"ن",2,0],["أَنسَيتَني الناسَ إِذ أَذكَرتَني بِهِمُ","يا مُهدِياً لِيَ تَذكاراً وَنِسيانا",1,"ن",2,0],["أَنسى بِأَيِّ يَدٍ رَدَدتُ يَدي","لَمّا نَزَعتُ إِليكَ مِن وَطَني",2,"ي",1,0],["آنَسَ وَهناً نَسمَ ريحٍ فَنَسَم","ماضٍ عَلى اللَيلِ إِذا لَم يَرَ شَم",3,"م",1,0],["إِن سارَ سارَ إِلى النِزالِ بِخِفيَةٍ","حَتّى كَأَنَّ سِلاحَهُ مَسروقُ",4,"ق",1,0],["أَنسى اِلتِفاتي لا أَراكَ وَرَجعَتي","أَبكي الدِيارَ وَأَندُبُ الأُلّافا",5,"ف",2,0],["أَنسى اِرتِفاقي وَالعُيونُ هَواجِعٌ","وَجَوانِبي عَن مَضجَعي تَتَجافى",5,"ف",2,0],["أَنسى اِشتِمالي بِالسَقامِ مُقيمَةً","عِندي عَقائِلُهُ وَأَنتَ مُعافى",5,"ف",2,0],["أُنسٌ تَناقَصَ مَع تَكامُلِهِ","لا بَدعَ إِنَّ البَدرَ يَنكَسِفُ",6,"ف",1,0],["إِن ساخَتِ الأَركانُ أَشرَفَ رُكنُهُ","أَو ضُعضِعَ البُنيانُ لا يَتَضَعضَعَ",7,"ع",1,0],["إِن سَرَّ أَمسُك كانَ يَومُكَ فَوقَه","وَيَقِلُّ عِندَ غَدٍ لِما يُتَوَقَّعُ",7,"ع",1,0],["أَنساكَ طولُ نَهارِ الشَيبِ آخِرَهُ","وَكُلُّ لَيلِ شَبابٍ عَيبُهُ القِصَرُ",8,"ر",1,0],["إِن سَوَّموهُ إِلى الرِهانِ فَإِنَّما","مَسَحوا جَبينَ مُقَلَّدٍ لِمُقَلِّدِ",9,"د",1,0],["إِن سَما بِالنِفاقِ غَيرُكَ فَالأَو","عالُ مَلوِيَّةٌ عَلى الأَطوادِ",10,"د",1,0],["أَنِسنا بِأَطرافِ الرِماحِ وَإِنَّنا","لَنَحنُ مُحِلّوها وَنَحنُ سُقاتُها",11,"ت",3,0],["إِن سَفَرَتْ فالعَذولُ يَعذُرُني","أَو نَظَرَتْ فالظِّباءُ تَحسُدُها",12,"د",3,0],["إن ساءَهُ بنُزولِهِ فهوَ الذي","ساءَ الأنامَ مُخَيِّماً ومُغَرِّضا",13,"ض",2,0],["أنِسْنَ بالحَرْبِ حتى كادَ يحْفِزُها","حُبُّ اللّقاءِ إذا ما قَعْقَعَ اللُّجُمُ",14,"م",1,0],["آَنَسَت نَبأةً وَأَفزَعَها القَ","نّاصُ عَصراً وَقَد دَنا الإِمساءُ",15,"ا",2,0],["إِن سَلَّ صارِمَهُ سالَت مَضارِبُهُ","وَأَشرَقَ الجَوُّ وَاِنشَقَّت لَهُ الحُجُبُ",16,"ب",1,0],["آنَستُ مِن قَلبي الغَداةَ تَشَتُّتاً","فَبَكَيتُ قَبلَ تَشَتُّتِ اِستِجماعِها",17,"ع",3,0],["إِنسانَةٌ عَرَضَت عَلَيَّ وِصالَها","دَسَّت إِلَيَّ رَسولَها بِكِتابِ",18,"ب",1,0],["إِن سيلَ لَم يَبذُل وَإِن قالَ لَم","يَفعَل وَإِن عوتِبَ لَم يُعتِبِ",19,"ب",1,0],["إنْ سَلا قَلْبي منْ بعْدِ سَلا","فإلى الغَدْرِ بِلا شكٍّ نزَعْ",20,"ع",1,0],["إِنْ سَارَ فِي الرَّمْل لَمْ يَظَهَر لَهُ أَثَرٌ","وَإِنْ عَلاَ الصَّخْرَ عَادَ الصَّخْرُ كَالطِّينِ",21,"ن",1,0],["إِنْ سُوبِقُوا سَبَقُوا النَّدَى أَوْ كُوثِروا","فَهُمُ النُّجُومُ عُلاً وَعِزُّ مَكَانِ",22,"ن",1,0],["أَنْسَى زَمَانُكَ كُلُّ عَصْرٍ ذَاهِبٍ","حُسْناً وَأَكْسَدَ ذِكْرُكَ الأَمْلاَكَا",23,"ك",2,0],["إنْ سرى في رسالةٍ قُرِنَتْ بالن","نَحْسِ منها الأعْمالُ والأسْفارُ",24,"ر",1,0],["أنْسَى بَني عبّاسِهِمْ بلِوائِه ال","مَنْصورِ أو بحُسامِهِ السّفّاحِ",25,"ح",1,0],["أنْسَيْتَنا بحُسامِكَ الماضي الظُّبى","ولوائكَ المَنْصورَ والسّفّاحا",26,"ح",2,0],["أنِسْتُ بمَسْرَى سَيْبِهِ وتأنّسَتْ","بساحَتِهِ نفْسي وأسْعِدَ ناسِي",27,"ي",1,0],["أنِّسا قلبي بتَذْكارِ الحِمى","فالحِمى منْ أهلِهِ قد أوْحَشا",28,"ش",2,0],["اُنسُجِ الحالِكاتِ مِنكَ نِقاباً","وَاِحبُ شَمسَ النَهارِ ذاكَ النِقابا",29,"ب",2,0],["أُنسِيَ الأَحياءُ ذِكرى عَبدِهِ","وَهيَ لِلمُستافِ مِن مِسكٍ وَطيبِ",30,"ب",1,0],["آنَسَت مِنّا عِطاشاً كَالقَطا","صادَفَت وِرداً بِهِ ماءٌ مَعين",31,"ن",1,0],["آنِسي الدُرَّةَ الَّتي كانَتِ الحِل","يَةَ في تاجِ دَولَةِ الرومانِ",32,"ن",1,0],["أنْساكَ ، حُبُّكَ طه أنّه بَشَرٌ","يُجري عليه شُؤُونَ الكَونِ مُجريها",33,"ي",3,0],["إِنَّ سُلطانَنا الَّذي نَرتَجيهِ","واسِعُ المالِ ضَيِّقُ الإِنفاقِ",34,"ق",1,1],["آنَستُ مِن أَستارِ سُدَّتِهِ سَنا","قَبَسٍ فَسُقتُ نفيسَةً لِنَفيسِ",35,"س",1,0],["إِنسِيَّةٌ بَيضاءُ أَو أَيكِيَّةٌ","وَرقاءُ عاكِفَةٌ عَلى التَرجاعِ",36,"ع",1,0],["إِن ساءَ فِعلُكِ بي فَما ذَنبي أَنا","حَسبُ المُتَيَّمِ أَنَّهُ قَد أَحسَنا",37,"ن",2,1],["أَنَّ سِرَّ الحُسنِ مِمّا","أَضمَرَت تِلكَ الجُيوبُ",38,"ب",1,0],["أَنِسَ الأَنامُ إِلَيكَ فيهِ فَهُم بِهِ","مِن قائِمٍ أَو ساجِدٍ أَو راكِعِ",39,"ع",1,0],["إِنَّ سَحابَ الأُفقِ مِنها الحَيا","وَالحَمدُ في تَأليفِها لِلرِياح",40,"ح",1,0],["أَنسانِيَ التَوبَةَ مِن حُبِّهِ","طُلوعُهُ شَمساً مِنَ المَغرِبِ",41,"ب",1,0],["أنس أحبابي الأولي أو حشوني","هو عندي أشهى من الإبلال",42,"ل",1,0],["آنَسْتُ بِكُمْ وَلَكِنْ تَمَّ أُنْسِي","بِمَوقِعِ هَذِهِ الأَنْغَامِ مِني",43,"ي",1,1],["إِنْسَانُ عَيْنِ الحِمَى أَحْرَى بُنُوَّتِهِ","يَوْمَ المُفَادَاةِ أَنْ يُدْعَى بإِنْسَانِ",44,"ن",1,0],["إِنْ سَرَّهَا العَهْدُ الجَدِيدُ فَقَدْ سَعَتْ","دَهْراً إِلَيْهِ حَلِيفَةَ الآلامِ",45,"م",1,0],["أنَسْتُ فِي حَسَنِ المَحَاسِنَ كُلَّهَا","وَعَدَدْتُ فِي أَعْوَامِهِ أَعْوَامِي",46,"ي",1,0],["إِنسٌ إِذا أَمِنوا جِنٌّ إِذا فَزِعوا","مُرَزَّؤونَ بَهاليلٌ إِذا حَشَدوا",47,"د",3,0],["أَنَسيتَ إِذ صارَت إِلَيهِ كَتائِبٌ","فيها اِبنُ سَعدٍ وَالطُغاةُ الجُحَّدُ",48,"د",1,0],["أَنَسيتَ قَتلَ المُصطَفَينَ بِكَربَلا","حَولَ الحُسَينِ ذَبائِحاً لَم يُلحَدوا",48,"د",3,0],["أَنسى الحُسَينَ وَمَسراهُم لِمَقتَلِهِ","وَهُم يَقولونَ هَذا سَيِّدُ البَشَرِ",49,"ر",1,0],["أنسى سماحة حاتم وكذاك في","يوم اللقاء ربيعةَ بن مكدّمِ",50,"م",1,0],["أَنُسَيْتُ فيه القلبَ عادةَ حِلمهِ","وحَثَثْتُ فيهِ أكؤسَ السرَّاءِ",51,"ا",2,0],["أَنَسيتَ وَيلَ أَبيكَ أَيّامَ الصَفا","قَتلى أُصيبَ بِقَتلِهِم وَأُسارى",52,"ر",2,0],["أَنَسيتَ يَومَكَ بِالجَزيرَةِ بَعدَما","كانَت عَواقِبُهُ عَلَيكَ وَبالا",53,"ل",2,0],["أنسيتنا في الندى أسلاف أولنا","فأنت للجود فيما بعدنا مثلُ",54,"ل",1,0],["إِن سابَقوا الناسَ يَوماً فازَ سَبقُهُمُ","أَو وازَنوا أَهلَ مَجدٍ بِالنَدى مَتَعوا",55,"ع",3,0],["إِن سَرَّكَ الغَدرُ صِرفاً لا مِزاجَ لَهُ","فَأتِ الرَجيعَ وَسَل عَن دارِ لِحيانِ",56,"ن",1,1],["إِن سابَقوا سُبِقوا أَو نافَروا نُفِروا","أَو كاثَروا أَحَداً مِن غَيرِهِم كُثِروا",57,"ر",3,0],["إِنَّ سُمَيراً عَبدٌ طَغى سَفَهاً","أَجدادُهُ أَعبُدٌ لَنا تَلَفُ",58,"ف",1,0],["أَن سَلَّطَ اللَهُ بِهِ كَلبَهُ","يَمشي الهُوَينا مِشيَةَ الخادِعِ",59,"ع",1,0],["إنسان عيني ساهر بك سافح","يا أيُّها الإنسان إنكَ كادح",60,"ح",1,1],["إنسانُ عينيَ أعشتهُ مكابدةٌ","وإنَّما خلِقَ الإنسانُ في كبد",61,"د",1,0],["أنسانيَ الهمَّ حتى","عادات برّ الرَّشيد",62,"د",1,1],["آنستنا يا أخانا","في ديننا المبرور",63,"ر",1,1],["إن ساءَ قوماً مقامي منشداً مدحاً","لساءهم ليَ تشريفٌ وتسريف",64,"ف",1,0],["أنسى المؤيد أخبار الأولى سلفوا","في الملكِ ما بينَ وهَّابٍ وفتَّاك",65,"ك",1,0],["إنسان عيني بتعجيل السهاد بلي","عمري لقد خلق الإنسان من عجل",66,"ل",1,1],["إن سرت لا ألقى مثالك في الورَى","قسماً ولا يلقى ثناك مثالي",67,"ل",2,0],["آنستُ صدراً طالما أوحشْتَه","لا زال يُؤنس رحْلَك العُوَّادُ",68,"د",1,0],["إنْ سيل عن قائل الشع","ر قَرّظ الناس غيري",69,"ي",1,0],["آنسني والدهر لي مُوحشٌ","بمؤنسٍ ناهيكَ من مُؤنِس",70,"س",1,0],["أنسيتنا جود حاتم وحجى","عمرو الدواهي وحلم ذي الحَنف",71,"ف",1,0],["إن سالم استنزل الأرزاق واسعة","أو حارب اتخذ المقدار سيّافا",72,"ف",2,0],["آنَسَتْهُ من مجدهِ مؤنساتٌ","أوحشتهُ بقلةِ الأشكالِ",73,"ل",1,0],["أن سترقى بي المراقيَ حتى","أتعالى في باذِخٍ مُتَعالي",73,"ل",2,0],["أنسى نصيبي من الفتاةِ سوى","نصيب عيني وناظري وفمي",74,"ي",1,0],["إن سألناكم وسألنا بكم","لم تكونوا مثل أطلال الدِّمن",75,"ن",1,0],["آنَسَ صَوتَ قَنيصٍ أَو أَحَسَّ بِهِم","كَالجِنِّ يَهفونَ مِن جَرمٍ وَأَنمارِ",76,"ر",1,0],["إِنَّ سِماكاً بَنى مَجداً لِأُسرَتِهِ","حَتّى المَماتِ وَفِعلُ الخَيرِ يُبتَدَرُ",77,"ر",1,0],["أَنسامُ أَيّارَ تَسري في أَصائِلِها","وَفي عَشياتِها أَنفاسُ تِشرينِ",78,"ن",1,0],["إِن سَهِرَ العاشِقُ مِن لَوعَةٍ","أَو سَهِرَ المَحزونُ مِن كُربَةِ",79,"ه",1,0],["آنَستَ قَلبي في البُعا","دِ بِقَدرِ ما أَوحَشتَ عَيني",80,"ن",2,0],["أُنسي بِهِ إِذا نَأى","وَوَحشَتي إِذا أَتى",81,"ت",2,0],["إنَّ سِحْرَ الضَّبابِ واللَّيلِ والغا","بِ بعيدُ المدى قويُّ الفُتونِ",82,"ن",1,0],["إنَّ سِحْرَ الحَيَاةْ","خَالدٌ لا يزولْ",83,"ل",1,0],["ان سل سيفه الصبا","ح فالدجى ينهزم",84,"م",1,0],["انس ما قد خلفته من قصور","شاهقات توفى ومن اعلاق",85,"ق",1,0],["آنست في طور النهى ناره","والليل يلقى الرعب في النفس",86,"س",1,0],["أنسومها خسفاً ونوسعها قلى","يا للجهالة ثم يا للعار",87,"ر",1,0],["أن سعداً بين المعارف والجه","ل الذي يجرف المعارف سدُّ",88,"د",1,0],["أنسيت دمعك في الحدو","د من المذلة كيف فاض",89,"ض",1,0],["إن سهما أصاب منك حبيبا","وقعه في القلوب والأكباد",90,"د",1,0],["آنست في الترب خير والدة","من حيث أوحشت والدا لاهف",91,"ف",1,0],["آنَسَت خَلقاً ضَعيفاً وَرَأَت","مِن وَراءِ العالَمِ الفاني إِلَها",92,"ا",1,0],["آنَسَت صِحَّةً فَمَرَّت عَلَيها","وَتَخَطَّت شَبابَهُ لَم تُبالِه",93,"ل",2,0],["أَنَسيتِ نارَ الباطِشينَ وَهَزَّةً","عَرَتِ الزَمانَ كَأَنَّ روما تُحرَقُ",94,"ق",1,0],["آنَستَ مُلكاً لَيسَ بِالشا","كي السِلاحِ وَلا الحَصين",95,"ن",1,0],["إِنَّ سِرباً زَحَفَ النَسرُ بِهِ","قَطَعَ الأَرضَ بِطاحاً وَهِضابا",96,"ب",2,0],["آنِساً إِلى","شِبهِهِ اِنجَذَب",97,"ب",1,0],["إِن سالَ جَرحاهُمُ في غُربَةٍ وَوَغىً","باتوا عَلى الجَمرِ أَرواحاً وَأَبدانا",98,"ن",2,0],["أَنْسَاني الدَّهْرُ ولَمْ يَنْسَني","والمَوت قَدْ يُودي بِمَنْ في الرَّضَاعْ",99,"ع",1,0],["أَنْسَى عَليّاً وتَفْنيد الغُواةِ لَهُ","وفي غَدٍ يُعْرَفُ الأفّاكُ والأَشِرُ",100,"ر",1,0],["أَنساعُها مَمغوطَةٌ وَخِفافُها","مَنكوحَةٌ وَطَريقُها عَذراءُ",101,"ا",2,0],["أَنسابُ فَخرِهِمِ إِلَيكَ وَإِنَّما","أَنسابُ أَصلِهِمِ إِلى عَدنانِ",102,"ن",1,0],["إِن ساغَ بعدَكَ لي ماءٌ على ظَمَأٍ","فلا تجرعتُ غيرَ الصابِ والصَّبَرِ",103,"ر",1,1],["أَنِسَت ذا وَذاكَ إِحدى وَعِش","رونَ بِغُضنٍ مِن الشَبابِ رَطيبِ",104,"ب",1,0],["إِن سارَعوا كانَ بَذلُ العُرفِ غايَتَهُ","وَإِن وَنَوا كانَ مِنهُ الجِدُّ وَالطَلَبُ",105,"ب",1,0],["إِن سُدتَ فيها المُنعِمينَ فَإِنَّني","في الشُكرِ عَنها سَيِّدُ المُدّاحِ",106,"ح",1,0],["إِن ساسَهُم حَدَثاً فَساعَةُ رَأيِهِ","كَالدَهرِ جَدَّ الدَهرُ أَو لَم يَجدِدِ",107,"د",1,0],["إِن ساوَقَ المَحلَ أَقوامٌ بِبُخلِهِمِ","جاؤوا مَعَ المَطَرِ الرَبعِيِّ أَجوادا",108,"د",2,0],["إِن ساحَ فَيضُ يَدَيهِ لَم يَكُن عَجَباً","أَن يُسرِفَ الظَنُّ فيهِ وَهوَ مُقتَصِدُ",109,"د",1,0],["إِنَّ سِحرَ العُيونِ ضَلَّلَ لُبّي","وَحَماني الرُقادَ وَردَ الخُدودِ",110,"د",1,0],["أُنسُهُ لِلعِدى وَما لِيَ مِنهُ ال","يَومَ إِلّا اِستيحاشُهُ وَنِفارُه",111,"ر",2,0],["إِن سارَ عادَ النَهارُ مِن رَهَجِ ال","زُحوفِ لَيلاً يَسوَدُّ مُعتَكِرُه",112,"ر",2,0],["إِن سيلَ أَحرَزَ مالَهُ بِوَقايَةٍ","مِن بُخلِهِ وَسُرادِقٍ مِن عِرضِهِ",113,"ه",1,1],["إِن سَرَّكَ اِستيفاءُ سُؤدِدِهِ","بِالرَأيِ تَبحَثُهُ وَتَنتَزِعُه",114,"ع",2,0],["أُنسٌ تَجَمَّعَ ثُمَّ بَدَّدَ شَملَهُ","شَملٌ مِنَ الأُلّافِ غَيرِ مُؤَلَّفِ",115,"ف",1,0],["أَنَسيمُ هَل لِلدَهرِ وَعدٌ صادِقٌ","فيما يُؤَمِّلُهُ المُحِبُّ الوامِقُ",116,"ق",1,1],["أَنسى لَيالينا هُناكَ وَقَد خَلا","مِن لَهوِنا في ظِلِّها ما قَد خَلا",117,"ل",2,0],["إِنَّ سَيرَ الخَليطِ حينَ اِستَقَلّا","كانَ عَوناً لِلدَمعِ حَتّى اِستَهَلّا",118,"ل",2,1],["إِن سيلَ عَيَّ عَنِ الجَوابِ فَلَم يُطِق","رَجعاً فَكَيفَ يَكونُ إِن لَم يُسأَلِ",119,"ل",1,0],["أَنساهُ إِذ أَلقى الزَمانُ بِساحَتي","خَطباً يُخافُ تَمامُهُ وَدَوامُهُ",120,"م",2,0],["أُنسٌ لَوَ أَنّي بِنِصفِ العُمرِ مِن أَمَمٍ","أَشريهِ ما خِلتُني أَغلَيتُ في ثَمَنِه",121,"ن",2,0],["أَنسَتهُ تَفقيعَهُ في اللَفظِ نازِلَةٌ","لَم تُبقِ فيهِ سِوى التَسليمِ لِلزَمَنِ",122,"ن",1,0],["إِن ساءَكَ الدَهرُ بِهِجرانِهِ","فَرُبَّما سَرَّكَ أَحيانا",123,"ن",2,0],["إِن سِرتَ سارَت وَإِن وَقَّفتَها وَقَفَت","صوراً إِلَيكَ بِأَلحاظٍ تُواليها",124,"ي",3,0],["أَنَسيتَ صُحبَتِها وَمَن يَكُ مُقرِفاً","تُخرِج مُغَيَّبَ سِرِّهِ الأَخبارُ",125,"ر",1,1],["آنستُ منها بخَيالٍ آنسٍ","يُسابِقُ الغُمْضَ إذا الغُمْضُ ألَمّ",126,"م",1,0],["أَنِسْنَ بنا أُنسَ الإماءِ تحبَّبَتْ","وَشيمَتُها غدرٌ بنا وإباقُ",127,"ق",1,0],["أنسيت عصر قيادة لك لم تزل","تحذوك أجرة كل زان خاطي",128,"ط",2,0],["أنَسِيتَ غُرَّ مدائحٍ حلَّيتُها","بعُلاكَ باقيةً بَقاءَ الأَدْهُرِ",129,"ر",1,0],["أنساكَ طِيبُ دُخانِها","طِيبَ العبيرِ أو المَلاب",130,"ب",1,0],["إِنسٌ إِذا أَمِنوا جِنٌّ إِذا غَضِبوا","مُرَزَّؤونَ بَهاليلُ إِذا جُهِدوا",131,"د",3,0],["أَنَسيتَ أَن تُدعى وَأَنتَ مُحَشرِج","ما إِن تَفيقُ وَلا تُجيبُ لِمَن دَعا",132,"ا",1,0],["أَنَسيتَ المَوتَ جَهلاً وَالبِلى","فَسَلَت نَفسُكَ عَنهُ وَلَهَت",133,"ت",1,0],["أَنساكَ مَحياكَ المَماتا","فَطَلَبتَ في الدُنيا الثَباتا",134,"ت",2,1],["أَنَسيتَ القُبورَ إِذ أَنتَ فيها","بَينَ ذُلٍّ وَوَحشَةٍ وَاِنفِرادِ",135,"د",1,0],["أَنساهُ عَبّادَةَ ذاتَ الهَوى","وَأَذهَبَ الحُبَّ الَّذي في الضَمير",136,"ر",1,0],["إِن سَطا في الكِفاحِ ثوَّرَ نَقعاً","أَو سَخا في السَماحِ أَثَّرَ نَفعا",137,"ع",2,0],["إِن سارَ عَبدُكَ أَوَّلاً أَو آخِراً","في ظِلِّ مَجدِكَ ما تَعَدى الواجِبا",138,"ب",2,1],["إِنَّ سوءَ المِزاجِ مِنهُ وَمِنّي","موجِبٌ ما شَهِدتَهُ بِالعِيانِ",139,"ن",1,0],["آنَسَهُ فَضلُكُم فَما طَلَبَت","مَسكَنَهُ نَفسُهُ وَلا سَكَنَه",140,"ن",2,0],["أَنِسَت بِمَقدَمِكَ العِراقُ وَأَهلُها","وَاِستَوحَشَت لَكَ حَرزَمٌ وَالجَوسَقُ",141,"ق",1,0],["إن سونيا ذات حسن","ضارب في كل فن",142,"ن",1,0],["أنسيت كيف نسيت يا","دنيا على الدنيا العفاء",143,"ا",2,0],["إنْ سالَمَتْ وهي لا تسالمنا","أيّامُنا حارَبتْ لياليها",144,"ي",3,0],["إنْسيّةٌ ذكرى محبّتها","جنيّةٌ بالشّوقِ تَغْشاني",145,"ن",2,0],["إن سابقَ القُرّحَ أبصَرْتَهُ","أمامها سَبْقاً يثيرُ القتام",146,"م",1,0],["أنسيتنا بأيادٍ منك نذكرها","خصيبَ مصرٍ وما أسداه للحكمي",147,"م",2,0],["أُنسيتَ تَأديبي وَعَهدي بِهِ","مِنكَ عَلى العَينَينِ وَالراسِ",148,"س",1,0],["آنَسَني مِن بَعدِكَ الوَجدُ","وَعَبرَةٌ تَطرُقُ أَو تَغدو",149,"د",2,1],["أَنسى أَبا نَصرٍ نَسيتُ إِذَن يَدي","في حَيثُ يَنتَصِرُ الفَتى وَيُنيلُ",150,"ل",1,0],["أَنسى أَبا الفَضلِ يَعفو التُربُ أَحسَنَهُ","دوني وَدَلوُ الرَدى في مائِهِ يَرِدُ",151,"د",1,0],["إِنسِيَّةٌ وَحشِيَّةٌ كَثُرَت بِها","حَرَكاتُ أَهلِ الأَرضِ وَهيَ سَكونُ",152,"ن",1,0],["أَنسى اِبتِسامَكَ وَالأَلوانُ كاسِفَةٌ","تَبَسُّمَ الصُبحِ في داجٍ مِنَ الظُلَمِ",153,"م",1,0],["آنَستَهُ بِالدَهرِ حَتّى إِنَّهُ","لَيَظُنُّهُ عُرساً مِنَ الأَعراسِ",154,"س",1,0],["إِن سابَقَتهُ الخَيلُ في مَيدانِها","قَذَفَت إِلَيهِ الخَيلُ بِالإِقليدِ",155,"د",1,0],["أَن سَوفَ تُهدى إِلى آثارِهِ بُهُماً","يُمسي الرَدى مُسرِياً فيها وَمُدَّلِجا",156,"ج",2,0],["إِنسِيَّةٌ إِن حُصِّلَت أَنسابُها","جِنِّيَّةُ الأَبَوَينِ ما لَم تُنسَبِ",157,"ب",1,0],["إِنَّ سَرَنْدِيبَ عَلَى حُسْنِهَا","يَسْكُنُهَا قَوْمٌ قِبَاحُ الْوُجُوهْ",158,"و",2,1],["إنْ سألتَ الوصلَ منه صاغراً","قالَ لِمْ تسألُني ما ليسَ لكْ",159,"ك",1,0],["إنسانُ عيني كمْ سهادٍ كم بكا","يا أيها الإنسانُ إنَّكَ كادحُ",160,"ح",1,0],["إنَّ سلمى إنْ تزرني زورةً","وجدَتْ خدِّي لها مفترَشا",161,"ش",2,0],["إنْ سوبقوا سَبَقوا أو حَدَّثوا صدقوا","أو سُولموا رفقوا أو حوربوا غلبوا",162,"ب",3,0],["إن سبَّحَ الربَّ حكى سبَّهُ","فقال سبحانكَ يا باغ",163,"غ",1,0],["أَنَسٌ قادَني إِلى الحَينِ حَتّى","صادَفَتنا عَشِيَّةً بِالجِمارِ",164,"ر",1,1],["آنِساتٍ مِثلَ التَماثيلِ لِعساً","مَعَ خَودٍ خَريدَةٍ مِعطارِ",165,"ر",1,0],["أَن سِر فَشَيِّعنا وَلَيسَ بِنازِعٍ","لَو شَدَّ فَوقَ مَطِيِّهِ الأَكوارا",166,"ر",2,0],["آنِسٌ دَلُّها قَريبٌ فَمَن يَس","مَع يَقُل ما نَوالُها بِبَعيدِ",167,"د",1,0],["آنَستُ ما آنَستُهُ مِن عَتبِهِ","فَأَقامَ تَحتَ غَمامَةٍ لَم تُمطِرِ",168,"ر",1,0],["إن سَاءَكُمْ ألا تَزالَ هُمومُكم","تَتْرَى فتلك همومُنا تَزدادُ",169,"د",1,0],["إِن سامَها في الحادِثاتِ تَفَرُّقاً","عَقَدَت عَلى خِذلانِهِ الإِجماعا",170,"ع",2,0],["إِن سادَ ظُلمٌ فَهوَ مِن أَعوانِهِ","أَو عَزَّ جَهلٌ فَهوَ مِن خُدّامِهِ",171,"م",2,0],["أَنَسيتُمُ الآياتِ بالِغَةً فَما","بِصَحائِفِ التاريخِ مِن نِسيانِ",172,"ن",1,0],["أَنَسكُنُ وَالأَهرامُ مُرتَجَّةُ الذُرى","وَنَرضى وَأَمرُ النيلِ فَوضى مُبَدَّدُ",173,"د",1,0],["أَنُسلِمُها إِلى الأَعداءِ طَوعاً","فَتِلكَ سَجِيَّةُ القَومِ الطغام",174,"م",1,0],["إِن سَرَّ مَطلِعُهُ العُيونَ فَطالَما","نامَت أَماناً في حِماهُ الأَكنَفِ",175,"ف",1,0],["آنِساني وَكَفكِفا دَمعَ عَينَي","بِسِلافٍ كَدَمعَةِ المَحزونِ",176,"ن",1,0],["أَنِسَت بِنارِ الشَوقِ فيكَ جَوانِحي","وَالزَندُ لا يَشكو بِحَرِّ شَرارِهِ",177,"ر",2,0],["إِن سررتم فَفي فلسطين عيد","أَو حَزِنتُم لَم تَعدُها الأَحزان",178,"ن",1,0],["إِنسانَةُ الحَيِّ أَم أُدمانَةُ السَمُرِ","بِالنِهي رَقَّصَها لَحنٌ مِنَ الوَتَرِ",179,"ر",1,1],["أُنُسَ الحَديثِ إِذا أَتَت جارَاتُها","وَصَلَ الحَديثُ لَها الخُطا أَشبارا",180,"ر",2,0],["إن سخطت بالردى لشانئها","ردت نفوس إلى شمائلها",181,"ل",3,0],["أنِسوا بهجرانِ الأنيسِ كأنّهُمْ","في عبقريِّ البِيدِ جِنّةُ عَبْقَر",182,"ر",1,0],["أُنسَ نَفسي كَيفَ اِستَجَزتَ اِطِّراحي","فيمَ ذا بَل عَلامَ ذا أَم لِأَيشِ",183,"ش",1,0],["أَنسى الرَزايا مَيتٌ فُجِعتُ بِهِ","أَمسى رَهينَ التُرابِ في جَدَفِ",184,"ف",1,0],["اِنسَ رَسمَ الدِيارِ ثُمَّ الطُلولا","وَاِهجُرِ الرَبعَ دارِساً وَمَحيلا",185,"ل",2,1],["آنَستُ نَفسي بِالتَوَح","حُدِ لا أُريدُ بِهِ بَديلا",186,"ل",2,1],["أُنسٌ غَرائِرُ ما هَمَمنَ بِريبَةٍ","كَظِباءِ مَكَّةَ صَيدُهُنَّ حَرامُ",187,"م",1,1],["إِنَّ سَلمى خُلِقَت مِن قَصَبٍ","قَصَبِ السُكَّرِ لا عَظمِ الجَمَل",188,"ل",1,1],["إِنَّ سُعدى صَبَّت عَلَيَّ مِنَ الحُب","بِ أَناةً مِن حُسنِها تَوقيرا",189,"ر",2,0],["إِن سَرَّكَ الطَعنُ مِن قُبلٍ وَمِن دُبُرٍ","فَأتِ اِبنَ سيمينَ ذا الرَأسَينِ حَمّادا",190,"د",2,0],["أَنِسٌ أَلوفٌ لِلحِجا","لِ وَدونَهُ قَصرٌ مَشيدُ",191,"د",1,0],["أَنسى عَزائي وَلا أَنسى تَذَكُّرَها","كَأَنَّني مِن فُؤادي بَعدَها حَرِبُ",192,"ب",1,0],["إِن سَرَّكَ المَوتُ لَها عاجِلاً","فَاِستَعجِلِ المَوتَ وَلا تَرقُبِ",193,"ب",1,0],["أُنسِيَت قَرقَرَ العَفافِ وَفي","العَينِ دَواءٌ لِلناظِرينَ وَداءُ",194,"ا",2,0],["إِنسٌ عَلى الأَرضِ تُدمي هامَها إِحَنٌ","مِنها إِذا دَمِيَت لِلوَحشِ أَنساءُ",195,"س",3,0],["إِن سارَ أَو حَلَّ الفَتى لَم يَزَل","يَلحَظُهُ المِقدارُ بِالمَرتَبَأ",196,"ب",2,0],["إِن سَلِمَ المَرءُ مِن عَواقِبِهِ","فَكُلُّ رُزءٍ يُصيبُهُ هَدَرُ",197,"ر",1,0],["أَنَسلُ اِبليسَ أَم حَوّاءَ وَيحَكُمُ","هَذا الأَنامُ فَفي أَفعالِهِم دَلَسُ",198,"س",1,0],["أَنَسيتَ حَقَّ اللَهِ أَم أَهمَلتَهُ","شَرٌّ مِنَ الناسي هُوَ المُتَناسي",199,"س",2,1],["أَنسِل أَوِ اِعقُم فَالتَوَحُّدُ راحَةٌ","سَيّانَ نَجلُكَ وَالخَبيثُ الناسِلُ",200,"ل",1,1],["إِنَّ سُرورَ المُدامِ لَم يَدُمِ","بَل أَعقَبَت بِالهُمومِ وَالسَدمِ",201,"م",1,1],["أَنَسَتكَ هِنداً سُيوفُ الهِندِ ماحِيَةً","ما قالَ عاذِلُها أَو قالَ واشيها",202,"ي",3,0],["إن سلمى شطبة","إن سعدى أَشكلُ",203,"ل",1,1],["أَنسينا أنا عَلى الأرض أَبنا","ءُ أُناسٍ عاشوا قَليلاً وَماتوا",204,"ت",3,0],["أنسَى بها الآتي","من عمريَ المحتومْ",205,"م",1,0],["أنست زمانا بالبيان وأهله","حتى تبدل أنسها أتراحا",206,"ح",2,0],["آنِسوا نَفسَهُ إِذا أَظلَمَ العَي","شُ بِعِلمٍ فَالعِلمُ أُنسُ النُفوسِ",207,"س",1,0],["إنْ سالَمُوكَ فدَعْهُمُ مِنْ هذه","وارْقُدْ كفى لكَ بالرّقادِ نَعيما",208,"م",2,0],["أَنسى المَواعِظَ في رَأدِ الضُحى أُصُلاً","وَما أَتاني بِالرَوحاتِ في البُكَرِ",209,"ر",1,0],["أنساهم الحطامُ ذكر الساعه","فمال نصر الله عنهم ساعه",210,"ه",1,0],["إنس الحديد بشر الفرند","ليس بصنع يمن أو هند",211,"د",1,0],["انساب ملأى من نقيع سمّه","حديدةٌ قد لفّها بكمّه",212,"ه",1,0],["آنِسَاتُ الَحديثِ في غَيرِ فُحشٍ","رافِعاتٌ جَوانِبَ الفِسطاطِ",213,"ط",1,0],["أَنسَلَ الذِّرعَانِ غَربٌ خَذِمٌ","وَعلاَ الرَّبرَبَ أَزمٌ لَم يُدَن",214,"ن",1,0],["إِنْسَانُهَا فِي غَمْرَةٍ","مِنْ أَدْمُعِي يَبْدُو وَيَخْفَى",215,"ف",2,0],["إِنْ سِرْتُ سَارَ النَّاسُ لِي تَبَعاً","وَإِذَا وَقَفْتُ لِحَاجَةٍ وَقَفُوا",216,"ف",3,0],["أَنَسِيمٌ سَرَى بِنَفْحَةِ رَنْدِ","أَمْ رَسُولٌ أَدَّى تَحِيَّةَ هِنْدِ",217,"د",1,1],["إِنْ سِرْتُ سَارُوا وَإِنْ أَصْعَدْ إِلَى نَشَزٍ","كَانُوا صُعُوداً وَإِنْ أَهْبِطْ بِهِمْ هَبَطُوا",218,"ط",3,0],["إِنَّ سَيْفَ الجِهَادِ وَهْوَ عَتَادٌ","لا يُجَلِّي وَقَدْ يُجَلِّي الكَهَامُ",219,"م",1,0],["آنِسَاتُ الشَّواطِئْ","يَا لَها مِنْ خَوَاطِئْ",220,"ط",2,1],["إِنْسِيَّةٌ مِنْ مَلِكَاتِ النَّدَى","كَانَتْ مِثَالَ الرَّحْمَةِ الأمْثَلاَ",221,"ل",2,0],["آنَسْتَ دَاراً كُنْتَ تُوحِشُهَا وَلَمْ","تَتَعَارَفَا فَالْيَوْمَ تُدْرِكُ سُولاَ",222,"ل",2,0],["آنس المحبوب في وحشته","ولينفّر رمسه صوب عهادك",223,"ك",1,0],["إِنَّ سَمْعَانَ شَيْخُنَا وَحَبِيبُ اللَّ","هِ وَالخَلْقِ كُلِّهِمْ بِالسَّواءِ",224,"ا",2,0],["أَنْسِيتُمُ عَهْدَ النّبيّ إليكُمُ","وَلَقَدْ ألَظَّ وَوَكَّدَ الأَيْمانَا",225,"ن",2,0],["إنسدل تحجبْ عن الطّرفِ الشقا","يا لطرفٍ بالشقا مكتحل",226,"ل",1,0],["آنَست مِنهُ سَكينَةً وَتُقىً عَلى","عَقبَيهِ يَنكُصُ مِنهُما إِبليسُ",227,"س",1,0],["إِن سَعْداً غَرَسَ النبْتَ وَقَدْ","شاءَ رَبِّي أنْ يَذُوقَ الثمرَا",228,"ر",2,0],["إِنَّ سيْفاً في يَمِينِ اللَهِ قَدْ","هَزَّهُ بارِئُهُ لَنْ يُكْسَرَا",228,"ر",2,0],["أُنْسِيتُ أَهْلِي بَيْنَهُمْ","وَسَلَوْتُ إِخْوَانِي وَوُلْدِي",229,"د",2,0],["إِنْ سُوئِلَتْ عَنْ سِنِيهَا","قَالَتْ نَسيتُ الْحِسَابَا",230,"ب",2,0],["إنّ سعداً أخضع الريح لكم","والبقيَّاتُ على اللّه المعين",231,"ن",1,0],["إن سالموكَ فدَغهم من هَذِه","وارقد كفى لك بالرقاد نعيمَا",232,"م",2,0],["أنستهم الأيام ما ضحك الحياة وما البكاء","أزرت بدنياهم ولم تترك لهم فيها رجاء",233,"ا",2,0],["أنسيتَ إِذْ كُنَّا معًا","نشتاقُ رائحة الثَّريد؟",234,"د",1,0],["أنسيت إِذ كنا ننا","مُ على سَريرِ من جريد؟",234,"د",1,0],["أنسيت إِذ كنا نُضَحِّ","ي بالفلافل كُلَّ عيد؟",234,"د",1,0],["أنسيةٌ أم تلك بعضُ الحورِ","من عَدْنٍ انطلقتْ إلى البسفورِ؟",235,"ر",1,1],["إِنْ سار وقتَ السِّلم مُتَّجِرًا","ضَمِنَ الرَّخاءَ وعادَ باليُسر",236,"ر",1,0],["إن سعى منهُمْ فوق أرضك ساعٍ","فالفُظيه لفظَ النوى، أو فَمِيدي",237,"د",2,0],["أنسى زمانك كل عصر ذاهب","حسنا وأكسى ذكرك الأملاكا",238,"ك",2,0],["أنسيتنا بحسامك الماضي الظبا","ولوائك المنصور والسفاحا",239,"ح",2,0],["إن سوبقوا سبق المدى أو كوثروا","فهم النجوم علا وعز مكان",240,"ن",1,0],["أنِسِيتَ المْوتَ جَهْلاً والبِلَى","وسَلَتْ نفْسُكَ عَنْهُ ولَهَتْ",241,"ت",1,0],["أنسج الصوف فأكسوه ولا","أشتكي من تعب أو ملل",242,"ل",1,0],["آنست في غربتي حبّاً يُبدِلُني","بلأهل أهلاً وبالجيران جيرانا",243,"ن",2,0],["إن سعى الواشي يُريك الغَيَّ رشدا","لا تكن أهلاً وصُن للود عهدا",244,"د",2,1],["انسُ الجليس وإن نابته نائبةٌ","كأنه – وهو دامي القلب – في طرب",245,"ب",1,0],["أنْسَتْهُ تَفْقيعَهُ، في اللّفْظِ، نازِلةٌ","لم تُبْقِ عنهُ سوَى التّسليمِ للزّمَنِ",246,"ن",1,0],["إنْ ساوَقَ المَحْلَ أقْوَامٌ ببُخلِهِمِ،","جَاءُوا مَعَ المَطَرِ الرِّبْعيّ أجوَادَا",247,"د",2,0],["إنْ ساسَهُمْ حدث، فساعَةُ رَأيِهِ","كالدّهرِ، جَدّ الدّهرُ أوْ لم يَجدُدِ",248,"د",1,0],["أنْسَى صَنَائِعَهُ إليّ، وَمَا يَنِي","أثَرٌ يَلُوحُ عليّ مِنْ آثَارِهِ",249,"ر",2,0],["إن سارعوا كلن بذل العرف غايته","وإن ونوا كان منه الجد والطلب",250,"ب",1,0],["أنس حين مشت إلّي","لما رأتني باسما متهللا",251,"ل",2,1],["إن سائكم ألا تزال همومكم","تترى فتلك همومنا تزداد",252,"د",1,0],["إن سرن في الارض نسنها","ركابَ السماءِ وأَفضالها",253,"ل",3,0],["آنستْ نبأة ً وأفزَعها القُ","عَصْرا وَقَدْ دَنَا الإمْساءُ",254,"ا",2,0]]}