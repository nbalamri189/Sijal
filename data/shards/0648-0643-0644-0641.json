e/diwan/poem/77088","البسيط"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44915","المتقارب"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125816","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199067","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101366","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123518","البسيط"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138733",""],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73203","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136621",""],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115304","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58064","الطويل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28943","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72514","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72454","السريع"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136411",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120267","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139662",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139693",""],[4679,"من لي بإحصاء لآلي البحار","https://www.poetsgate.com/ViewPoem.aspx?id=142758",""],[4689,"دوح المدائح","https://www.poetsgate.com/ViewPoem.aspx?id=152847",""],[4691,"إهداء لزياد بنجر","https://www.poetsgate.com/ViewPoem.aspx?id=170289",""],[4935,"مفاخر مصر بالكذب","https://www.poetsgate.com/ViewPoem.aspx?id=129308",""],[4981,"حروف فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=190491",""],[5005,"حرفٌ في مهبِّ الريح..","https://www.poetsgate.com/ViewPoem.aspx?id=189357",""],[5072,"سيبكي الليل","https://www.poetsgate.com/ViewPoem.aspx?id=52560",""],[3749,"رفاهية الشهم اقتحام العظائم","https://www.poetsgate.com/ViewPoem.aspx?id=134962",""],[5183,"إلى الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=180189",""],[5211,"رَجاءُ القَوْمِ ليْسَ لهُ رَجاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=176160",""],[5213,"وكلفني دهري بنسيان ذكرهم","https://www.poetsgate.com/ViewPoem.aspx?id=170490",""],[5273,"رسالة إلى عمر بن الخطاب","https://www.poetsgate.com/ViewPoem.aspx?id=179801",""],[5277,"إنما الأعمال بالنيات","https://www.poetsgate.com/ViewPoem.aspx?id=198177",""],[5413,"عقيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=200595",""],[5442,"خل دمعي فقد اصاب مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=114777",""],[5442,"تبدت وقد مدت عليها ستورها","https://www.poetsgate.com/ViewPoem.aspx?id=114743",""],[402,"كم بطل أمسى ولم يسمر","https://www.poetsgate.com/ViewPoem.aspx?id=35749",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5790,"خذوا قودي من أسير الكلل","https://www.poetsgate.com/ViewPoem.aspx?id=112120",""],[5970,"حسان المنى من دونهن المصاعب","https://www.poetsgate.com/ViewPoem.aspx?id=130580",""],[6031,"هِيَ الدارُ تَستسقيكَ مَدْمَعَكَ الجاري","https://www.poetsgate.com/ViewPoem.aspx?id=46266",""],[6125,"لَعَلَّ اللهَ أنْ يَرضَىٰ","https://www.poetsgate.com/ViewPoem.aspx?id=210918",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""]],"verses":[["وَكُلِّ فَنيقٍ إِلى ناقَةٍ","يُساقِطُها زَبَداً أَو لُغاما",0,"م",2,0],["وَكُلُّ فَتىً لا يَطلُبُ المَجدَ أَعزَلٌ","وَكُلُّ عَزيزٍ لا يَجودُ ذَليلُ",1,"ل",1,0],["وَكُلُّ فَتىً تَبَطَّنَ بَيتَ نَبعٍ","وَصَيَّرَ غِمدَ قاطِعِهِ إِباطا",2,"ط",2,0],["وَكُلُّ فَتىً باقٍ سَيَتبَعُ مَن مَضى","وَكُلُّ غَدٍ جاءٍ سَيَلحَقُ بِالأَمسِ",3,"س",1,0],["وَكُلُّ فَتاةٍ مِن نِزارٍ تَرَكتَها","تَريعُ إِلى ظِلِّ الرُبوعِ الدَواثِرِ",4,"ر",1,0],["وَكُلُّ فَتىً تَحُفُّ بِجانِبَيهِ","خَواطِرُ بِالقَنا قُبٌّ وَجُردُ",5,"د",1,0],["وَكُلُّ فَتىً لَم يَرضَ عَن عَزمَةِ القَنا","ذَليلاً وَلَو ناجى عُلاهُ الفَراقِدُ",6,"د",1,0],["وَكُلُّ فَتىً إِن آدَ ثِقلُ مُلِمَّةٍ","تَوَرَّكَ حِنوَي عِبئِها غَيرَ لاهِثِ",7,"ث",1,0],["وَكُلُّ فَتىً يَرنو إِلى عَيبِ غَيرِهِ","سَريعاً وَتَعمى عَينُهُ عَن عُيوبِهِ",8,"ب",2,0],["وَكُلُّ فَتىً حَظُّ أَجفانِهِ","مِنَ الضيمِ مَضمَضَةٌ تُستَلَب",9,"ب",1,0],["وكُلُّ فتًى يَرْدي بهِ الطِّرْفُ في الوَغى","مُشيحاً كَما أوفى على المَرْقَبِ الصَّقْرُ",10,"ر",1,0],["وَكُلِّفتُ خَوضَ البَحرَ وَالبَحرُ زاخِرٌ","أَبيتُ عَلى أَثباجِ مَوجٍ مُغَرَّقِ",11,"ق",1,0],["وكَلِفْتَ بالمَمْلوكِ تؤثِرُ أكْلَهُ","أبَداً وتَرْفُضُ صِحّةً ومِزاجا",12,"ج",2,0],["وَكَلَّفِتني مِن سَيرِ ظَلماءَ وَالدُجى","يَصيحُ الصَدى فيها وَيَضبَحُ بُومُها",13,"م",3,0],["وَكُلِّ فَريغَةٍ عَجلى رَموحٍ","كَأَنَّ رَشاشَها لَهَبُ الضِرامِ",14,"م",1,0],["وكلَّفتني في رحلتي وإقامتي","على حسنه المطلوب أن أضرب الرملا",15,"ل",2,0],["وكلٌّ فَلَهُ هَمٌّ","من السوء به يُعْنَى",16,"ن",2,0],["وكلّ فتىً له وجهٌ وثيقٌ","متى ما شاء أمكنه النزولُ",17,"ل",1,0],["وَكُلُّ فُؤادٍ شَديدُ العُرامِ","إِذا رِضتَهُ بَِلهَوى يَسلَسِ",18,"س",1,0],["وَكُلُّ فَتىً يَرضى بِوَجهِ مُنَمِّقٍ","مِنَ الناعِماتِ البيضِ فَهوَ مُغَفَّلُ",19,"ل",1,0],["وَكلُّ فتىً عاشَ في غِبطَةٍ","يَصيرُ إِلى الجَدَثِ الأَسفَعِ",20,"ع",1,0],["وكل فقارة من ظهر مكسى","بصحراء الإمام وعظم ساق",21,"ق",1,0],["وَكُلُّ فَتىً لِلحَربِ فَوقَ جَبينِهِ","مِنَ الضَربِ سَطرٌ بِالأَسِنَّةِ مُعجَمُ",22,"م",1,0],["وَكُلِّ فَضفاضَةٍ كَالثَلجِ مُحكَمَةٍ","ما تَرثَعِنَّ لِدَسِّ النَبلِ بِالقُطَبِ",23,"ب",1,0],["وَكُلُّ فَتىً عاري الأَشاجِعِ لاحَهُ","سَمومُ الثُرَيّا لَونُهُ قَد تَغَيَّرا",24,"ر",2,0],["وَكُلُّ فَطيمٍ يَنتَهي لِفِطامِهِ","وَكُلُّ كُلَيبِيٍّ وَإِن شابَ راضِعُ",25,"ع",1,0],["وكلُّ فتىً أجدَى عليَّ فصاحبي","وكلُّ بلادٍ أخصَبَتْ فبِلادي",26,"د",2,0],["وَكُلُّ فَتىً تُغافِصُهُ المَنايا","وَيُبليهِ الزَمانُ كَما بَليتا",27,"ت",2,0],["وَكَلَّفتَني ما حُلتَ بَيني وَبَينَهُ","وَقُلتُ سَأَبغي ما تُريدُ وَما تَهوى",28,"ه",3,1],["وكلّفت قلبكِ خوض الجحيم","وقلبك كالجنة الناضره",29,"ر",2,0],["وَكَلِفتُ مِنهُنَّ الغَداةَ بِغادَةٍ","مَجدولَةٍ جُدِلَت كَجَدلِ عِنانِ",30,"ن",1,0],["وَكَلَّفتَني مَجدَ اِمرِئٍ لَن تَنالَهُ","وَما قَدَّمَت آباؤُهُ وَمَآثِرُه",31,"ر",2,0],["وكلُّ فَتىً يهوى فإنّي إمَامُهُ","وإني بَريءٌ من فَتىً سامعِ العَذْلِ",32,"ل",1,0],["وكل فأس وقعت في الدار","تنزل بالأس وبالجدار",33,"ر",1,0],["وَكُلَّ فتَاةٍ ذَوَى غُصْنُها","وَكانَ يُرَجَّى لأَحْلَى الثَّمَرْ",34,"ر",1,0],["وَكُلُّ فَصيحٍ أَلكَنٌ في مَديحِهِ","لِأَنَّ لِسانَ الجودِ بِالمَدحِ أَفصَحُ",35,"ح",1,0],["وَكُلُّ فَتىً بِالشِعرِ تَجلو هُمومُهُ","وَيَكتُبُ ما تُملي عَليهِ المَطامِعُ",36,"ع",1,0],["وكَلَّفْتَنِي مَجْدَ امرىء ٍ لن تَنَالَهُ","وما قدّمت آباؤه ومآثره",37,"ر",2,0],["وكلّفْتُ نفسي أنْ تُحَقِقَ سُؤلْها","سِراعاً ، أو الموتَ الزؤامَ سراعا",38,"ع",2,0],["وكلّ فؤاد شديد العرام","إذا رضته بالهوى يسلس",39,"س",1,0],["وكل فتى يهوى فاني امامه","بعلم شريف الشأن يحكم بالعدل",40,"ل",1,0],["وكلفت فيه ضنى وغبت عن السوى","وجداً وأزعجني الرقيب وعذله",41,"ل",2,0],["وكلُّ فضيلةٍ ذُكِرَتْ لقوم","رأَوه بذكرِها أحرَى وأولىَ",42,"ل",2,0],["وَكُلَّ فَتىً كَالخَيزُرانَةِ دِقَّةً","يُراعُ بِهِ لَيثُ الشَرى وَهوَ أَغلَبُ",43,"ب",1,0],["وكلفهم إن يكتب المرء منهم","بما كان أفتى فيه سراً وما أملى",44,"ل",2,0],["وكلَّفتِنى مَن لا أُطِيقُ كَلاَمَهُ","نَهَاراً وَلاَ لَيلاً وَلاَ بينَ ذَلِكِ",45,"ك",1,0],["وكلُّ فضلٍ ففي كفَّيْهِ مَوْرِدُه","جَمْعا ومن راحتَيْه يُقْسَم القِسَم",46,"م",1,0],["وَكلُّ فِعال الفاعلينَ فعالهُ","إِذا فَعلوا خيراً وإن فَعلوا شرّا",47,"ر",2,0],["وَكلُّ فتىً منّا غَدا في غرامِها","زُليخا وكلُّ الأرضِ قد أَصبحت مِصرا",48,"ر",2,0],["وَكلُّ فردٍ منهمُ في فخرهِ","مُنفردٌ قَد سادَ أهل عصرهِ",49,"ه",1,0],["وكل فصيح عند معرب لفظه","تراه اذا ما اعرب النطق اعجما",50,"م",2,0],["وكُلُّ فتىً يأتي لنادِيهِ قاصداً","يرى نفْسَه في لُجّةِ البَحْرِ عائمُ",51,"م",1,0],["وكَلَّفْتُ نفسي الصبرَ وهي تَرُدّهُ","وَنُحت ولو يَشْفِي النفوسَ عويلُها",52,"ل",3,0],["وكل فرد وشعب","صاروا بحال عجيبه",53,"ب",2,0],["وكلّ فجٍّ أرجٍ بالتقى","فإنه من طيبه يعبق",54,"ق",1,0],["وكلّ فتىً يفنى شهود وجوده","يراه بعين الحقّ ذا القدم الثبت",55,"ت",1,0],["وكَلَّفَني الأولى جميعاً وعَصرَها","فَويلي من الأُولى وعَولي مِنَ العَصرِ",56,"ر",1,0],["وَكَلِّفْ رَدَّها إِنْ شِئْتَ قَسْراً","عَزائِمَ تَسْتَرِدُّ الْمُسْتَعارا",57,"ر",2,0],["وكل فاقد شخصٍ يرتجى خلفَا","منه ولا يرتجى ابنٌ من أب خلفا",58,"ف",2,0],["وَكلُّ فنونِ العلمِ للملكِ نافعٌ","وَلا سِيما ما سايرَ الملكَ حكمهُ",59,"م",2,0],["وكل فعال لم أكن متقرباً","إلي به أعظمت فيه خطيتي",60,"ي",1,0],["وَكُلُّ فَخرٍ إِذا فاخَرتَ مُطَّرَحٌ","وَكُلُّ جودٍ إِذا ما جُدتَ مَغمورُ",61,"ر",1,0],["وَكُلُّ فَردٍ مِنهُمُ يُرينا","خِلافَ مَن أَظهَرَ اِتِّباعَه",62,"ع",2,0],["وَكُلُّ فَتىً يَردي إِلى الحَربِ مُعلَماً","إِذا ثَوَّبَ الداعي وَأَجرَدَ صِلدِمِ",63,"م",1,0],["وكُلُّ فتىً للعينِ والسّيفِ إنْ غَزا","يَعِزُّ بجَفْنٍ أنْ يُلِمَّ غِرار",64,"ر",1,0],["وكلّفتُ نفسي عن هواها تَسَلّياً","وكم قد سلا بالمجد عن مثلها مثلي",65,"ل",2,0],["وكلّفنا الجوانحَ عنكَ صبراً","فقالَتْ لا قرار ولا سكونُ",66,"ن",1,0],["وكلّ فؤاد من رفاقي وأنيقي","تطالب من تلك الرسوم حبيبا",67,"ب",2,0],["وكلّ فتًى من بني عمِّها","قريب النوال بعيد المنال",68,"ل",1,0],["وَكَلَّفْتُ حاجاتي شَبيهَةَ طائِرٍ","إِذا انْتَشَرَتْ ظَلَّتْ لَها الأَرْضُ تَنْطَوي",69,"ي",1,0],["وكلِّ فتخاءَ ماضٍ حَدُّ مِنْسَرِها","كَأَنَّهُ نحوَ أَكبادِ العِدى قَرِمُ",70,"م",1,0],["وكَلَّفْتَها رِزقَ الذِّئابِ فأُحشِمَتْ","لذِيبٍ عَوى تَحْتَ الدُّجى وَهْوَ صائِمُ",71,"م",1,0],["وكل فتى يريكم قهقهات","ينال بقربكم مالا وجاها",72,"ا",3,0],["وكلُّ فتىً يُتَبِّعُ حاجتيه","مَقَصَّ الذئبِ يعتقبُ الشِّياها",73,"ا",3,0],["وكُلِّفَ كبرَى المساعي فقا","م يحملها قبلَ أن يستطيعا",74,"ع",2,0],["وكُلفت الجواب فقلت غُنم","لعمر أبيك لم يك في حسابي",75,"ب",2,0],["وكُلِّ فُؤادٍ مَحَّضَ السِّرَّ خالصاً","فَناجى بحالٍ ضِمنَ خَلْوَتهِ مَحْضِ",76,"ض",1,0],["وكلُّ فتىً مثلُ الشِّهابِ إذا اِرتمى","غدا لشياطين العِدا وهْو داحِرُ",77,"ر",1,0],["وكل فاترة الألحاظ فاتنة","إذا رمقن محباً فارق الرمقا",78,"ق",2,0],["وكلَّ فَتى يَسْعَى إلى الْحَرْبِ طالِباً","مُناصَرَةً للحقِّ والحقُّ أقدمُ",79,"م",1,0],["وكُلَّ فَتىً إذا ما حَازَ عِلْماً","وَكانَ لَهُ بَمدْرَجَةٍ صُعُودُ",80,"د",1,0],["وَكَلَّفَ مَن أَطاقَ الحَجَّ قُرباً","فَزادَ لَنا عَلى الحَجَرِ الزِحامُ",81,"م",1,0],["وكلِّ فَضفَاضَةٍ مُضَاعَفَةٍ","من نَسج داودَ غير مؤتشَبِ",82,"ب",1,0],["وكلُّ فتًى لم يَعتكف طولَ عُمرِه","على طَلبٍ لِلعلمِ لا شَكَّ يُحرَمُ",83,"م",1,0],["وكلّفنِي من ثِقْلِ يومِ وداعِهِ","بلابلَ لا يسطيعهنَّ مطيقُ",84,"ق",1,0],["وكلٌّ في قبالتِهِ","له أهلٌ لدى معلمْ",85,"م",1,0],["وكل فتى على مقدار ما قد","سقاه بكفه الساقي يغني",86,"ن",2,0],["وكل فهم وكل وهم","وكل وقت وكل آن",87,"ن",1,0],["وكل فضل للنبي وحده","بجملة القول يصير بعدهُ",88,"ه",1,0],["وكلُّ فَدْمٍ سادَ في عَصْرِه","ما أَقبحَ السُّؤْدُدَ مَعَ العَظْمِ",89,"م",1,0],["وَكُلُّ فَتىً يَوماً وَإِن ضَنَّ رَغبَةً","بِصاحِبِهِ لا بُدَّ يَوماً مُفارِقُهْ",90,"ق",2,0],["وكل في المقابر سوف يلقى","بلا شك هنالك للسؤال",91,"ل",1,0],["وكل فاتنة بيضاء فاتكة","بمهجة وجنتها وردا بتوريد",92,"د",1,0],["وكل فضيلة قرنت حسانا","وحسن الطبع مقرونا بأنس",93,"س",1,0],["وكلّ فُؤاد ملؤهُ البِشر والهنا","وغنّت به في الغصن ورقُ الحمائمِ",94,"م",1,0],["وكَلفتني حُبَّ البَغيضِ ولم أكن","أودُّ لعَمرُ اللهِ غيرَ المُوادد",95,"د",1,0],["وَكَلَّفتِني حُبَّ العُذَيبِ وَبارِقٍ","وَما كُنتُ أدري ما العُذَيبُ وبارِقُ",96,"ق",1,0],["وكل فم فيه كذلك عالم","وكل لسان فيه واضع حكمة",97,"ه",1,0],["وكل فؤاد فيه بيت مُقامه","له حرم تحمى به حرماته",98,"ت",2,0],["وَكُل فَتى لِلغيد يَصبو فَإِنَّني","ظَهير لَهُ في الحالتين وَناصر",99,"ر",1,0],["وَكُلُّ فَتى أَمسى لَهُ في فُنونه","يُشير بِأَطراف البَنان مَع اليَد",100,"د",1,0],["وَكَلَفُ النَفسِ بِتَركِ الأَقرَبِ","وَشِدَّةُ الحِرصِ عَلى المُستَصعَبِ",101,"ب",1,0],["وكلفني خوض الدجى طلب العلى","وكل فتى مقدار مرماه يتعب",102,"ب",1,0],["وكل فريق يطلب الحكم بالهوى","ومن يتَّبع حكم الهوى يتعسف",103,"ف",1,0],["وكل فن نافعٍ","مثقف مهذب",104,"ب",1,0],["وكل فرد ذاهب","في الغيّ كل مذهب",104,"ب",1,0],["وكل فريق راصد في مكانه","فلا الشر متروك ولا متفاقم",105,"م",1,0],["وكلِّ فتىً يلقى المنايا بصدرِهِ","بقلبٍ ثبُوتٍ لا بقلبٍ مُزعزعِ",106,"ع",1,0],["وَكُلُّ فتىً يَخلو مِنَ العِشقِ وَالهَوى","فَذاكَ بَهيمٌ لَيسَ في النَّاسِ يُحسَبُ",107,"ب",1,0],["وَكُلُّ فَرخ كانَ فَوقَ غصن","لَدى الحصار نافِعٌ كَالحصنِ",108,"ن",1,0],["وكلّفني الواشون عنه تسليّاً","وأين لقلبي سلوة يستطيعها",109,"ع",3,0],["وكلِّ فتى أخي ثقةٍ","أَمُونٍ غير مِذْعار",110,"ر",1,0],["وكلفته حمل التفرُّق والهوى","ولَلهجرُ من بعد التفرق أفظع",111,"ع",1,0],["وَكُلُّ فُؤَادٍ لِلأَعَادِي مُجَذَّذُ","تُرى أُدْرِكُ الْمَطْلُوبَ مِنْ نَيْلِ مَقْصِدِي",112,"ي",1,0],["وَكَلَّفْتُ قَلْبي أَنْ يَقُومَ بِصَبْرِهِ","فَزَادَ بِعَاداً وَاسْتَطَالَ بِغَدْرِهِ",113,"ه",1,0],["وكلفت نفسي حمل كل شديدة","وذقت أمور الدهر أرياً وعلقما",114,"م",2,0],["وكل فؤاد ذي لب صحيح","لاسهم وعظ واضعه مصيدُ",115,"د",1,0],["وكل فتى فوق عبل الشّوى","ومحبوكة كالبديل المريرِ",116,"ر",1,0],["وكل فتى مستنجد غير جده","على الدهر لم ينجده جد ووالد",117,"د",1,0],["وكل فكرة مخلوق إذا اجتهدت","بمدحه لم تنل إلا إلى الأبد",118,"د",1,0],["وَكُلّ فَتىً عَن صُورَةِ المَوتِ سَافِرِ","يُزَيِّفُ غَسّاناً وَعَمرَو بنَ عَامِرِ",119,"ر",1,0],["وَكُلُّ فَتىً يَوماً وَإِن طالَ عُمرُهُ","سَيُدعى إِلى ما ساءَهُ فَيُجيبُ",120,"ب",1,0],["وكلّ فتى حَنيت ضلعهُ","على قلب ليث شرًى هاصرِ",121,"ر",1,0],["وكُلِّ فتىً صعبِ الكريهَةِ ماجدٍ","مُجدٍّ مُحِقٍّ ليسَ يَثنيهِ باطِلُ",122,"ل",1,0],["وكل فظٍّ رديِّ الخال منقبضاً","وكل برٍّ حميد الفال منشرحا",123,"ح",2,0],["وكلفتم كُمَيْتَكُمُ هجاءً","ليعربَ بالقصائد معتدينا",124,"ن",2,0],["وَكُلُّ فَتَىً عَلَى قَدَمٍ وَإِنِّي","عَلَى قَدَمِ النَّبِي بَدْرِ الْكَمَالِ",125,"ل",1,0],["وكلّ فتى يميل إلى لقائي","بغير ردا الشّجاعة ما تردّى",126,"د",2,0],["وكل فضل فعنهم قد روى ورؤى","وكل سر فمنهم في الوجود سرى",127,"ر",2,0],["وكل فتىً أخطأته الحتوف","له زمن سوف يختانه",128,"ه",1,1],["وكل فتى علاه ثوب سقم","فذاك الثوب منى مستعار",129,"ر",1,0],["وكل فتى يجرا لذيل تيها","وتفتر الملاح له افترارا",130,"ر",2,0],["وكلفتِ نَفسي قطعَ بيداءَ لوعةً","تكلُّ بها هوجُ المهاري وَقودُها",131,"ه",2,0],["وكلّفه لي أخٌ زورتي","وذاك تقاضٍ لسوء القضاء",132,"ا",2,0],["وكَلفني خوفُ ابنِ عبدونَ رَدَّها","فأَرجأتُها حَولاً كَريتاً ومَربَعا",133,"ع",2,1],["وكُلُّ فتىً قد كانَ للعينِ قُرّةً","سَيَملَؤها حرّاً كما مُلئت قُرّا",134,"ر",2,0],["وَكُلُّ فَضلٍ مِنكَ نَستَفيدُه","فَاسلَم وَلا كادَكَ مَن تَكيدُه",135,"د",2,0],["وكل فخرك هز المنكبين وما","ترخيه من طرف العرض على العقب",136,"ب",1,0],["وكلفتني أخوض البحر مقتحماً","هول الشتاء وهيجاء الرواعيد",137,"د",1,0],["وَكُلِّ فَتىً ضَربٍ خُشاشٍ إِذا سَطا","يَرى المَوتَ أَحلى مِن زُلالِ المَشارِبِ",138,"ب",1,0],["وكلُّ فضل به تُبْنَى العلا فإلى","أبي الفضائل بدر الدين ينتسبُ",139,"ب",1,0],["وكل فصيح فاته حظ مدحهم","يعد وان راض الأوابدَ ألكنا",140,"ن",2,0],["وكلّفه الهوى بأساً شديداً","إلى غَوْلٍ من النّاس الخِسَاسِ",141,"س",1,0],["وكلفتنا الليالي فوق طاقتنا","ذلاً وقتلاً وتشريداً لأهلينا",142,"ن",2,0],["وكل فرار خلت جبنا فربما","يفر أخو بأس ليمكنه الكر",143,"ر",1,0],["وكل فؤادك باللسان وقل له","إن الفؤاد عليكما موزون",144,"ن",1,0],["وكل فتى يرجو اياديك راجع","بسبب ندى من راحتيك جزيل",145,"ل",1,0],["وكل فتاة صيرتها حلى لها","كأن غوالي الدر ما هو جالبه",146,"ب",2,0],["وكلفتني حالا محالا بأنني","أعارض دراً لم يثقبه ثاقب",147,"ب",1,0],["وكل فخار عن معاليك في الورى","تأخره الأيام مهما تقدّما",148,"م",2,0],["وَكَلَّفتَني أَمراً لَو انَّ أَقلَّهُ","يكلَّفُهُ ثَهلانُ كادَ يَميدُ",149,"د",1,1],["وَكُلِّ فاصِمَةٍ للظَهرِ قاصمةٍ","تَرُدُّ مَن كانَ جَذلانا حَليفَ أَسى",150,"س",2,0],["وكل فتيا لها الدينار محتضر","انعم به من مبيح حرمة المُقل",151,"ل",1,0],["وكل فتى يموت على فراش","فمخرج روحه مضض مهيل",152,"ل",1,0],["وكلفني حمل القواضب والقنا","وسفك الدما إسراف أهل الكبائر",153,"ر",1,0],["وكل فضيلة تعزى","إلى قاضي قنا الشرعي",154,"ع",2,0],["وَكل فؤاد في الحمى عَبدُ حُبّها","وَكل طَريق في الغَرام أَسيرُها",155,"ه",2,0],["وَكُل فَتى يَلقى الحمام وَلَو صَفَت","مَوارده دَهراً وَطابَ لَهُ الشُرب",156,"ب",1,0],["وكل فتى عاداته قصر شوقه","وطى الحشى دون الهموم والعوازب",157,"ب",1,0],["وكلَّ فَدمٍ يظنُّ المال مهجتَهُ","فَلا يمدُّ إِلى الانفاق منهُ يدا",158,"د",2,0],["وَكلَّفتُ النَسيم لكم سَلاماً","فضاع وضاع إِهدآءُ السَلامِ",159,"م",1,0],["وكل فاقدة الأتراب ذات خبا","حراسه السمر والهندية القضب",160,"ب",1,0],["وكلّ فِلِزّ من نُحاس وآنُكٍ","ومن زِئبَقٍ حَيّ ونُوَشاذُرٍ يُسْدِيِ",161,"د",2,0],["وكل فتى يسرى اذا هجدَ القَطا","خفيفٌ عليها وطؤُه حينَ أَهدبَا",162,"ب",2,0],["وكلُّ فتىً في الناسِ يُظِهرُ وُدَّهُ","ظنينٌ اذا لم تَختَبره المَخَابِرُ",163,"ر",1,0],["وكلُّ فتىً منهم دَائباً","يَحُدُّ لِخَلقِ أَخيهِ الحديدَا",164,"د",2,0],["وكلٌّ في اِدامتها حريصٌ","إلى الرحمنِ تجتَهدُ اجتهَادا",165,"د",2,0],["وكلُّ فتىً تحتَ العَجاجَةِ وكدُهُ","إذا الخيلُ جالتْ ميتَةً يستجيدُها",166,"د",3,0],["وكل فتى يبغى العلى غير أننا","كمقتنص صيداً يروم ولا يرمي",167,"م",2,0],["وَكل فَخر زَوال العَيشِ يَعقبه","فَاِن مَعناه في التَحقيق فُقدان",168,"ن",1,0],["وَكُلَّ فَتىً لَهُ أَدَبٌ وَحِلمٌ","مَعدِيٍّ كَريمٍ غَيرِ وانِ",169,"ن",1,0],["وكلَّفتُ الوفاءَ لردّ شكرٍ","فكان العذر من عقلي العقيمِ",170,"م",1,0],["وكل فؤَاد ليس يدخله الهوى","حطيماً غدا للنار يصلح والوقد",171,"د",1,0],["وَكَلفتَني مَعانيه المَديح فَلَم","أَبخَل وَأَوسَعت فيهِ كُلَ مَجهود",172,"د",1,0],["وكلُّ فَتىً لا يُرتَجى لِمُلِمَّةٍ","فَذَرهُ وكُن عن فَقدهِ غير سادمِ",173,"م",1,0],["وَكُلُّ فَتى غَيري هَواهُ مقلَّبٌ","فَما بال قَلبي شغله لَيسَ يفرغ",174,"غ",1,0],["وَكلَّفتُها حملَ السلام لعلها","تبلِّغ عني بعضَ حال المتيم",175,"م",1,0],["وَكِّل فؤادَك باللسان، وقل له","إن الكلام عليكما موزون",176,"ن",1,0],["وكل فعاله أعمال برٍّ","وكل خصاله كرمٌ وجودُ",177,"د",1,0],["وَكَلَّفتَني عَنهُ الجَوابَ وَحَبَّذا","سُؤالٌ وَلَكِن أَينَ مِنّي تَجانُسُ",178,"س",1,0],["وكل فرع لكم كزين ال","عباد نعم الفتى الودود",179,"د",1,0],["وَكُلُّ فَقيهٍ في الحَقيقَةِ مُدَّعٍ","وَيَثِبُ بِالوَحيَينِ صِدقَ اِدِّعائِهِ",180,"ا",3,0],["وكل فريقٍ يدعي النصر في الوغى","وما ذل مغلوبٌ ولا عز غالب",181,"ب",1,0],["وكلفني صبراً عليه فلم أطق","كما لم يُطِق موسى اصطباراً على الخضر",182,"ر",1,0],["وكلُّ فتىً داخلٌ رمسَهُ","وكلُّ غدٍ صائرٌ أمسَهُ",183,"س",2,1],["وَكُلُّ فُرسانِهِم أَلقوى عِجالَهُمُ","لِساسَةِ الخَيلِ تُستَبقى حِيالَهُمُ",184,"م",1,0],["وكل فتىً بزهي نطاقه","هنالك أحكم شد وثاقه",185,"ه",1,0],["وَكُلُّ فَرد لَهُ شُكر يَخُصُّ بِهِ","فَالرِفقُ وَالعَدلُ شُكر الحاكِم الحول",186,"ل",1,0],["وَكَلَّفتُها فَوقَ ما تَستَطيع","فَلَم تَألَ جُهداً وَلَم تَنهَزِمْ",187,"م",1,0],["وكلُّ فؤادٍ بالأمانيِّ طافحٌ","ولكنها الأخطار تغلو مهورها",188,"ر",3,0],["وكل فتى في فعله وخلاله","معالي السجايا لا تزال له تسري",189,"ر",2,0],["وكلف الأسير أن يطربه","كم يسجع البلبل وهو في قفص",190,"ص",1,0],["وكل فضل وافضال فمنه سرى","الى الافاضل عن جدواه منقول",191,"ل",1,0],["وكلفت فكري حذف حرف مقدم","على كل حرف عند مدحي لمجده",192,"د",2,0],["وكلُّ فعلٍ غدا إيجابه سلبا","والنفيُ فيه وجوبٌ بعد ليس وما",193,"م",2,0],["وكلُّ فعلٍ بضمٍّ أَنْتَ ترفعُهُ","فبالسكونِ لدى الإعراب قد جُزما",193,"م",2,0],["وكلُّ فؤادٍ فيكمُ وَغرامُهُ","كَمَا كُلُّ طَرفٍ فيكمُ ودُموعُهُ",194,"ع",2,0],["وكلُ فتىً في الحي يَشهد أنني","بحبَّك ميتٌ فهو في الحُب عالم",195,"م",1,0],["وكُلُّ فتىً يَلقى الخطوبَ بعزِمِه","لَهُ مَذهَبٌ عمّن له عَنهُ مذهَبُ",196,"ب",1,0],["وكلُّ فتَى ليسَ يُقِيلُ العثْره","سيُسْلَبُ الإمكانَ ثمَّ القُدْرَهْ",197,"ه",1,0],["وكل فتى يمضي بزادٍ من التُّقَى","فإنَّ غداةَ الحشرِ لا شك ظافرُ",198,"ر",1,0],["وكلٌ فتىً في الناسِ بعد ابنِ امّهِ","كساقطةٍ احدى يديه من الخَبلِ",199,"ل",1,0],["وكل فؤاد بات يغلي من الجوى","إذا جاش فيه غليه إلى مرجل",200,"ل",1,0],["وكل فرد في الوغى منهمو","إذا التقى الجمعان سيف القضا",201,"ض",2,0],["وكل فرع بفرق ضم فيه إلى","مبد اشتقاق وعنه الكتب في عطل",202,"ل",1,0],["وكل فتى كما يسعى يجازى","ويصبح بالذي يجنى رهينا",203,"ن",2,0],["وكل فتىً منهم يُلفَّع بالعلى","وبالعلم والتقوى وبالمجد يرتدى",204,"د",2,0],["وكلُ فردٍ منهمُ بالندى","خصَّ وفي برد العلى لُفِّعا",205,"ع",2,0],["وكل فعلٍ حسنٍ صالحٍ","وكلّ قول باهر ذي اعتبار",206,"ر",1,0],["وكل فضلٍ بأمر الله منه أتى","وكل أمرٍ - يعود إليه- محترم",207,"م",1,0],["وكلّ فواقي الشعر ِ أمّته ُ التي","تحييهُ روضا للبيان َو منهلا",208,"ل",2,0],["وكل في الضلال سرى","بلا خوف ولا رهب",209,"ب",1,0],["وكلُّ فتى سَيَصدَحُ: لن","يَظلَّ العِرضَ مُغتَصَبَا",210,"ب",2,0],["وكلٌّ فاتنةٍ أرختْ ستائرها","وناسك الرُّوح قد وافاه سيِّدُه",211,"د",2,0],["وكلّفني بحبِّك ِ بوح َ ليل ٍ","بجفن ٍ قد تصاحبُه ُ الدماء ُ",212,"ا",2,0],["وكل فمغرور بحب حياتي","ويغريه بالأدنى خفاء الخواتم",213,"م",1,0],["وكل في أخوته صدوق","يصون أخاه أن يلفى مهينا",214,"ن",2,0],["وكُلِّفَ كلُّ موْصُوفٍ بِعَيْبٍ","بِرُكنِ الدَّارِ مِهْنتُهُ البِنَاءُ",215,"ا",2,0],["وكلفني دهري بنسيان ذكرهم","وإني لا أنسى ارادة لا أنسى",216,"س",2,1],["وَكُلُّ فِتْنَةِ عَصْرٍ نَحْنُ نَغزلُها","كأنَّ ألسُنَنَا في غَزْلِها إبَرُ",217,"ر",1,0],["وكلُّ فرضٍ له في الدينِ سنّتُهُ","وسنّةُ القلبِ إيمانٌ بباريهِ",218,"ي",2,0],["وكل فؤادٍ حلَّ فيهِ ودادُهمْ","فذلكَ قلبٌ ليسَ فيهِ الرسولُ",219,"ل",1,0],["وكلفنا به فلم نستطع عنه","إلى أن نلتقي الإله عدولا",220,"ل",2,0],["وكل فؤاد في الحمي عبد حبها","وكل طليق في الغرام أسيرها",221,"ر",3,0],["وكل فدم فيك أو عالم","ما شاء أن يكبر فليكبر",222,"ر",1,0],["وكلُّ فتىً منهمْ حليفُ عزيمةٍ","يفلُّ بها السيفَ الحسامَ المهنّدا",223,"د",2,0],["وكل فتى لا يحب الملاح","ويهوى المدام فما هو بطل",224,"ل",1,0],["وكل فتي لاق من الدهر محنة","رقيق الحواشي بيننا والمشاغب",225,"ب",1,0],["وكَلَّفتَني جَرْياً وَرَاءَكَ بعدما","بلغتَ مَكاناً دونَهُ يقفُ الجاري",226,"ر",2,0],["وكلُّ فَضِيَلةٍ هَجَرَتْ","لِتُمعِنَ في تَجَافِينَا",227,"ن",2,0],["وكلٌّ في عباءته انتظارٌ","يغيمُ الماءُ في يدِه أواما",228,"م",2,0]]}