{"poems":[[55,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[79,"جعسوسكم حسن لولا شميم أذى","https://www.aldiwan.net/poem35730.html","البسيط"],[53,"صبحة النوروز في الأحد","https://www.aldiwan.net/poem61831.html","المديد"],[53,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[64,"الحمد لله الذي خصنا","https://www.aldiwan.net/poem52220.html","السريع"],[47,"طال في هذه السوادات لبثي","https://www.aldiwan.net/poem62666.html","الخفيف"],[47,"أطلب النوم كي يعود غراره","https://www.aldiwan.net/poem63577.html","الخفيف"],[63,"لو سالمته سجايا طرفك الساجي","https://www.aldiwan.net/poem51752.html","البسيط"],[46,"أيها البرق بت بأعلى البراق","https://www.aldiwan.net/poem30394.html","الخفيف"],[33,"من لعين تذري من الدمع غربا","https://www.aldiwan.net/poem42643.html","الخفيف"],[107,"هل الحرب إلا أن تطير الجماجم","https://www.aldiwan.net/poem43156.html","الطويل"],[48,"راعد تحته صلف","https://www.aldiwan.net/poem23007.html","مجزوء الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54702","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[147,"ما نرى للثناء عنك عدولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[208,"إقبال عام بشكر الخير مقبول","https://www.aldiwan.net/poem53187.html","البسيط"],[215,"أعود وحدي أعود","https://www.aldiwan.net/poem46767.html","المجتث"],[240,"قل لجمال الدين يا أكرم ال","https://www.aldiwan.net/poem32037.html","السريع"],[303,"ما له في عظم الشأن قري","https://www.aldiwan.net/poem36860.html","عموديه"],[309,"حييت يا مربع الأحباب","https://www.aldiwan.net/poem16795.html","المديد"],[309,"يا صاحبي إن دمعي اليوم ينهمل","https://www.aldiwan.net/poem16875.html","البسيط"],[310,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[371,"وددت أن لو تراجعنا بألسننا","https://www.aldiwan.net/poem16920.html","البسيط"],[422,"هاتها حمراء تحكي العندما","https://www.aldiwan.net/poem54068.html","الرمل"],[422,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[466,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[473,"لك عندي مينا من الهليون","https://www.aldiwan.net/poem59607.html","الخفيف"],[473,"لا أنس أيامي ولا أطرابي","https://www.aldiwan.net/poem60426.html","الكامل"],[473,"يا من هو الأم لنا والأب","https://www.aldiwan.net/poem60460.html","السريع"],[498,"ومرنان معبسة ضحوك","https://www.aldiwan.net/poem67311.html","الوافر"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87022","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53904","الكامل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44572","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55993","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55994","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112861","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112862","الطويل"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20387","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27775","الرمل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47128","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121016","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129818","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76071","الخفيف"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76168","الرجز"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133951","الرجز"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89297","الكامل"],[3483,"","https://poetry.dctabudhabi.ae/diwan/poem/111137","الرمل"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106811","الرجز"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66481","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91619","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114327","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76444","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54339","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54489","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73268","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73091","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133115","المجتث"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66112","المتدارك"],[4755,"قَلِقٌ.. كَأَوَّلِ قُبلَةٍ تَتَحَاشَى","https://www.poetsgate.com/ViewPoem.aspx?id=184348",""],[4578,"هذي رواية آدابٍ لذي أدبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49350",""],[4852,"كل الكون طوّاف","https://www.poetsgate.com/ViewPoem.aspx?id=215171",""],[4988,"الخوالد تاريخ وبطولات","https://www.poetsgate.com/ViewPoem.aspx?id=182806",""],[5411,"وجَعُ الشِّعْر","https://www.poetsgate.com/ViewPoem.aspx?id=185383",""],[5573,"ياسابح الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=200177",""],[5605,"استراحة فنية","https://www.poetsgate.com/ViewPoem.aspx?id=160695",""],[5747,"رحلة المليون ميل","https://www.poetsgate.com/ViewPoem.aspx?id=61608",""],[5790,"بلغت ريح النعامى","https://www.poetsgate.com/ViewPoem.aspx?id=112133",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""]],"verses":[["مُعمِلاً في الخَميسِ أَقلامَكَ الغُر","رَ إِذا أَعمَلوا القَنا الخَطّارا",0,"ر",2,0],["مُعَمَّمٌ فوْقَ طولٍ مُفْرِطٍ وضَنىً","كَما يعمِّمُ رأسَ الدِّيسَةِ القِنَوي",1,"ي",1,0],["مُعْمِلي كأس يطوف بها","غلمة كالأدْم بالجَرَدَ",2,"د",1,0],["مُعْمِلاً في الورى لُجَيْنَكَ بل عَيْ","نك ما أحسَنوا وطوراً حديدَكْ",3,"ك",1,0],["معمولة من جوهر خالص","داخله من خارج يبصر",4,"ر",1,0],["مُعمِلُ الفِكرِ يَقتُلُ الجَرجَرا","ئِيُّ أَخِلّايَ بِالعِراقِ وَإِرثي",5,"ث",2,0],["مُعمِلُ الحَزمِ وَهُوَ مِن شِدَّةِ الإِق","دامِ يُخشى تَغريرُهُ وَخِطارُه",6,"ر",2,0],["مَعمورةٌ بذزي التِّيجانِ نِسبتُه","فما يُعدِّدُ إلا كلَّ ذي تاجِ",7,"ج",1,0],["مَعَ ما قَد طَوَيتُ مِن سائِرِ النا","سِ وَما قَد نَشَرتُ في الآفاقِ",8,"ق",1,0],["مُعمَلٍ جَفنُها لِذِكرَةِ إِلفٍ","زادَهُ الشَوقُ وَالصَبابَةُ كَربا",9,"ب",2,0],["مُعِمّونَ فيها مُخوِلونَ إِذا اِعتَزَوا","نِمَتهُم قُرَيشٌ في الحِفاظِ وَهاشِمُ",10,"م",1,0],["مُعمِلاً بَسَطَ راحَتَي","كَ إِلى نائِلٍ يُلَفّ",11,"ف",1,0],["مُعَمِّرُ أَحْيَاءِ الْفَضَائِلِ وَالنُّهَى","بِنَسْلٍ مِنَ الآْلاءِ لِيْسَ بِذِي عَدِّ",12,"د",1,0],["معملُ المَصْلِ وهو فتحٌ مبينٌ","بعضُ ما نال مصرَ منَ مَأْثُراته",13,"ت",2,0],["مُعمِلاً كُلَّ بُكرَةٍ وَأَصيلٍ","عَزمَةً صَدقَةً وَرَأياً أَصيلا",14,"ل",2,0],["مُعَمَّمات بوَشيٍ من جواهرها","مرصَّعات وفي الترصيع تفصيلُ",15,"ل",1,0],["مع من سواي تعود","إني أغار أغارُ",16,"ر",1,0],["مُعَمَّرٍ قَد نَقَضَت سِنُّهُ","سَوطاً مِنَ العُمرِ بَعيدَ النَدى",17,"د",2,0],["مع ما في صدرِهِ من سعةٍ","شرسُ الخلقِ أَخو حمْقٍ حرون",18,"ن",1,0],["معموراً بالعلم والآداب","والعدل والبر والشكر",19,"ر",1,0],["معمر الوقت بالأوراد حافظة","بالعلم والذكر لا عجز ولا كسل",20,"ل",1,0],["معمورةٌ بِجوامعٍ وصنائعٍ","وَمزارعٍ وبضائع ألوانِ",21,"ن",1,0],["مُعَمَّرٌ وُدُّهُ فيكُم وَمُغتَبِطٌ","رَجاؤُهُ مِنكُمُ كَالراحِ وَالحَبَبِ",22,"ب",1,0],["معْ مليح قد قضى الحسن له","أن يرى الظلم إذا ما حكما",23,"م",2,0],["مُعَمِّرٌ بغداد في إحسانه","من بعد ما أبادها ريب الوبا",24,"ا",1,0],["مِعْمارِ مرْقدهِ وحافِظ دينهِ","ومُعينِ أمتَّهِ بجودٍ مُسْبل",25,"ل",1,0],["مَع مُغَنٍّ لَهُ سُيوفُ لِحاظٍ","يَنتَضيهِنَّ مِن جُفونِ الجُفونِ",26,"ن",1,0],["مَعَ مَن إِذا حَمَلتَ عَلَيهِم هَفوَةٌ","ثَبَتوا وَلَم يَستَنجِدوا بِعِتابِ",27,"ب",1,0],["مَع مُسمِعٍ في خَدِّهِ وَردَةٌ","تَحرُسُها مِن صُدغِهِ عَقرَبُ",28,"ب",1,0],["مُعَمِّرَةٌ تَزايَدُ كُلَّ يَومٍ","شَبيبِتُها عَلى مَرِّ الزَمانِ",29,"ن",1,0],["مع ما ترى من احتياج الأمة","في غير ما حال إلى الأئم",30,"م",1,0],["مع ما أبان الله من فضائله","وجاء في الكتاب من دلائله",30,"ه",1,0],["مع ما انتهى إليهم وما انتشر","من ذاك عنه واستفاض واشتهر",30,"ر",1,0],["مَع ما علمت بِأَنني لَيث الوَغى","وَشهامَتي فَوقَ السماك الأَعزَلِ",31,"ل",1,0],["مَعْ ما أعانيه ببُعْدِيَ دائماً","عن بسطة المأنوسةِ الأرْجاءِ",32,"ا",2,0],["مَع مُسمِعٍ حَلَفَت لَهُ أَوتارُهُ","أَن لا تُنافِرَ رَنَّةَ المِزمارِ",33,"ر",1,0],["معممه بالطيلسان تغرنا","وكم غر بالناموس شخص معمم",34,"م",1,0],["معمورةٌ حينما التوفيق شيدها","ارّختُ دام بعون الله حافظها",35,"ه",2,0],["معمورةٌ تاريخها جاءَ بها","يا رب أنت لها مجيرٌ حارسُ",36,"س",1,0],["معمر بالهداية كل قلب","له ميل لشرب حلى شهدك",37,"ك",1,0],["معمر ربع الخير مكثر بذله","لقاصده فاجعله يا صاح مقصدا",38,"د",2,0],["مُعمِلِ القِدرِ نابِهُ النار بِاللَي","ل إِذا هَمَّ بَعضُهُم بِخُمودِ",39,"د",1,0],["مع من أنت عبيدي في الهوى","قلت ربي أنا والله معه",40,"ع",2,0],["مع مَا لَهُ من مستلذِّ شمائل","نمّت بطِيبِ نسيمها الأزهارُ",41,"ر",1,0],["مَعَ مِثلِهَا أيضاً تَزيدُ بِوَاحِدٍ","هَا نَحنُ نَسرُدُهَا بِلاَ كِتمَانِ",42,"ن",1,0],["معمَّى كتابٍ فكُّه احذر فهذه","سفينةُ هذا العمرِ قاربتِ الشطا",43,"ط",2,0],["مع من لم يدر يوما ما الجفا","من أراح الصبّ فيه من تعَب",44,"ب",1,0],["معملُ الفِكرِ في مَهامِهِ شَوقٍ","بِمطِيٍّ يَحُثُّهُنَّ الغَرامُ",45,"م",1,0],["معمولَه بضمة أَو كسره","فَتحة تَبلغ ثَماني عَشره",46,"ه",1,0],["مع مراعاة المقامات كما","نقول سل كحاتم أو حاتما",47,"م",2,0],["مع ما به من لبنٍ وتمرِ","تنظرُ عند حملهِ الأطيارا",48,"ر",2,0],["مع من يثير الوجد في لائمي","يا حسنة غصناً بغيط طويل",49,"ل",1,0],["مع من حاز عفافاً","ويبرد المزح رافل",50,"ل",1,0],["مَعمُولُهَا بِغَيرِ رَفعٍ مَا وُصِف","فِي اللَّفظِ وَالخَطِّ بِهَذَا قَد عُرِف",51,"ف",1,0],["مع مليح قوسه الحاجب إذ","راش من أجفانه أشهم راشي",52,"ش",2,0],["مع ماجدٍ كالبحر حيثُ أَردتَه","فيهِ الرَدى وَالرَيّ وَالكُلُّ اتّفق",53,"ق",1,0],["مَعَ مَا يُدَلِّسُ لاَحَ عَنعَنَةٌ لَهُ","مَقبُولَةٌ تُربِي عَلَى ابنِ هِلاَلِ",54,"ل",1,0],["معملا فكرته في شرف","حاسبا أَقوى شَفيع سؤددا",55,"د",2,0],["مَع ما خَوونَ يَنهَبُ الطَريقا","فَعَرَفَ السائِقَ وَالرَفيقا",56,"ق",2,0],["مُعمّرٌ بعمود الصُّبح بيتُهم","له من الشُّهب أَوتادٌ وأَطنابُ",57,"ب",1,0],["مُعْمِلٌ للنَفاذِ في كلِّ قطرٍ","قَلَماً حاكماً على إقليمِ",58,"م",1,0],["مَع مَليحٍ يُخجِلُ البَد","رَ أَرخَى اللِّثامَا",59,"م",2,0],["مُعمِلاً في سِياسَةِ الُملكِ رَأياً","لا يَرى الفِكرُ في شَبَاه فُلولا",60,"ل",2,0],["مع محيي البهيم","أبا حسن ثم جاره",61,"ه",1,0],["مَعْمُودُ العِشْقِ مُسَهَّدُهُ","يَشْكُو والوَجْدُ يُعَبِّدُهُ",62,"د",2,1],["مَعَ مَن سَأُكمِلُ ما بَدَأتُ وفِي دَمِي","شَجَنٌ هَوَاكِ أَمَاتَهُ وأَعَاشَا",63,"ش",2,0],["مع ما حوت من خلاعاتها حسنت","أبدت فوايد آداب لذي طلب",64,"ب",1,0],["‏معمورُ بيتُكَ -يا ربي- فقد طافوا","مَن هُمْ بشوقٍ؛ أما للشوق أصنافُ؟",65,"ف",1,1],["مع مقرْن الجبري كسرنا الأساطيل","والبرتغالي عاد مذلول خسران",66,"ن",1,0],["مَعْمُودَةٌ وَدَوا الجُروحِ مُسَمَّمٌ","وَمَواجِعي ساقَتْ رِياحَ عَذَابي",67,"ب",2,0],["مع مسرحك لاجيت اردد مغانيك","مال الفرح يا مسرح الحزن فاصل",68,"ل",1,0],["(معمع وبعبع) وقل ما شئت في عجب","(صرر وبربر) وقل موال (ماما مامي)",69,"م",2,0],["معمعة فكري [ شرود ] من الحقيقه للخيال","يعني ذي [ فترة نقاهه ] في خِضمّ المستحيل",70,"ل",1,1],["مع مليحٍ يخجل البد","ر إذا أرخى اللثاما",71,"م",2,0],["مُعَمَّيَاتٌ عَلَى الْوَرَى طُرُقِي","أَمْضِي بِجِينَاتِيَ الْمُشَفَّرَةِ",72,"ه",1,0]]}