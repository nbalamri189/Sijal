{"poems":[[36,"فيا قلب صبرا واعترافا لما ترى","https://www.aldiwan.net/poem4903.html","الطويل"],[37,"أبائنة سعدى نعم ستبين","https://www.aldiwan.net/poem38821.html","الطويل"],[37,"لعزة هاج الشوق فالدمع سافح","https://www.aldiwan.net/poem39173.html","الطويل"],[23,"بكت عيني وحق لها بكاها","https://www.aldiwan.net/poem21606.html","الوافر"],[53,"ناشدتك الله في قدري ومنزلتي","https://www.aldiwan.net/poem9222.html","البسيط"],[53,"تعالت قرون أبي يوسف","https://www.aldiwan.net/poem66420.html","المتقارب"],[72,"أبا يحيى وما أعرف","https://www.aldiwan.net/poem42392.html","الهزج"],[87,"قضى أريحي القوم والقوم من همو","https://www.aldiwan.net/poem6832.html","الطويل"],[47,"تظن شجوني لم تعتلج","https://www.aldiwan.net/poem62675.html","المتقارب"],[30,"وأغيد من من النعاس بعظمه","https://www.aldiwan.net/poem5445.html","الطويل"],[71,"أبائع حب القمح في وصل شادن","https://www.aldiwan.net/poem29011.html","الطويل"],[52,"أعادك طيفها وبما يعود","https://www.aldiwan.net/poem63923.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54860","السريع"],[53,"ناشدتُك اللَّه في قَدري ومنزلتي","https://www.poetsgate.com/ViewPoem.aspx?id=27260",""],[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[128,"هواك ظننته لعبة","https://www.aldiwan.net/poem23752.html","مجزوء الوافر"],[177,"أمين الله حبك في فؤادي","https://www.aldiwan.net/poem4400.html","عموديه"],[190,"هويت انفرادي والأخلاء برهة","https://www.aldiwan.net/poem43778.html","الطويل"],[376,"أبايعت أهل البيعة اليوم في دمي","https://www.aldiwan.net/poem57135.html","الطويل"],[398,"أبا يوسف ان العثانين آفة","https://www.aldiwan.net/poem53562.html","الطويل"],[463,"هل بعد مفترق الأظعان مجتمع","https://www.aldiwan.net/poem56135.html","البسيط"],[593,"","https://poetry.dctabudhabi.ae/diwan/poem/107093","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126834","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48759","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64046","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63846","المتقارب"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77449","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80189","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64592","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49602","الوافر"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46470","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71073","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48207","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27425","الوافر"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144171","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103427","الطويل"],[3235,"","https://poetry.dctabudhabi.ae/diwan/poem/111105","الكامل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104304","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62863","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129410","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129365","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131024",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54396","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73099","الوافر"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130867","الطويل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113822","البسيط"],[5102,"شاعر المليون","https://www.poetsgate.com/ViewPoem.aspx?id=14630",""],[5567,"آخر الوصايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81814&r=&rc=64",""]],"verses":[["أَبائِنَةٌ لُبنى وَلَم تَقطَعِ المَدى","بِوَصلٍ وَلا صُرمٍ فَيَيأَسَ طامِعُ",0,"ع",1,0],["أَبائِنَةٌ سُعدى نَعَم سَتَبينُ","كَما اِنبَتَّ مِن حَبلِ القَرينِ قَرينُ",1,"ن",1,1],["أَبائنةٌ يا عَزُّ غَدواً نَواكُمُ","سَقَتكِ الغَوادي خِلفَةً وَالرَوائِحُ",2,"ح",1,0],["أَبا يَعلى لَكَ الأَركانُ هُدَّت","وَأَنتَ الماجِدُ البَرُّ الوَصولُ",3,"ل",1,0],["آبائِيَ الرومُ توفيلٌ وتُوفَلِسٌ","ولم يلدنيَ رِبعيٌّ لا شَبَثُ",4,"ث",1,0],["أبا يوسفٍ كم رَبوخٍ لدي","ك أوطأْت طِرْفيَ مَيْدانَها",5,"ن",3,0],["أَبا يَحيى وَما أَعرِ","فُ مَن أَنتَ أَبا يَحيى",6,"ي",2,1],["أبا يوسف في كل نادٍ مناحة","أرامل تبكى أو عوائل تلطم",7,"م",1,0],["أَبا يوسُفٍ سَمِجٌ ما أَتَي","تَ وَلَم يَكُ مِثلُكَ يَأتي السَمِج",8,"ج",1,0],["أَبا يوسُفٍ راخَيتَ عَنّي مَخانِقي","وَأَتبَعتَ فَضلاً لَستُ ناسِيَهُ فَضلا",9,"ل",2,0],["أبائعَ حَبِّ القمحِ في وصلِ شادنٍ","لعونٍ ضحوكٍ للعقول سلوبِ",10,"ب",1,1],["أَبا يَحيى عَلامَ تَكونُ وَغداً","كَبِرتَ وَفيكَ عَن كَرَمٍ صُدودُ",11,"د",1,0],["آبَ إِيَاباً لَمْ يُتَحْ لامْرِئٍ","أُعْظِمَ فِي الدُّنْيَا لَهُ قدْرُ",12,"ر",1,0],["آبائيَ الرومُ توفيلٌ وتُوفَلِسٌ","ولم يلدنيَ رِبعيٌّ ولا شَبَثُ",13,"ث",1,0],["أبا يوسف انظر نظرة في مصابنا","فإن مصاب العارفين شديد",14,"د",1,0],["أبايع من يساومني","على الترفيه بالنكبة",15,"ب",2,0],["أُبَايِعُكُم بِمَا خَطَّت يَمِيِني","وَمَا لِي بالوَفَاءِ بِهِ يَدَانِ",16,"ن",1,0],["أبايع أصحابي وأهجر جمعهم","إذا لم يكن في مجمع القوم طاهر",17,"ر",1,0],["أبايَعتَ أهلَ البيعَةِ اليومَ في دَمي","غَلبتَ فَخُذ أَخطارَهُم وتَقَدَّمِ",18,"م",1,1],["أَبا يوسُفٍ اِنَّ العَثانين آفةٌ","عَلى حامِليها فَاِتَّخِذ لحيَةً قَصدا",19,"د",2,1],["آبايَ في فارس والدين دينُكُمُ","حقاً لقد طاب لي أُسٌّ ومرتبَعُ",20,"ع",1,0],["آبائي العرب الغطارفة الألى","فتحوا بلاد الترك والأروام",21,"م",1,0],["أبا يوسف فيكَ النيابةُ أصبَحت","ترحّب لمّا كنت حقّاً لها أهلا",22,"ل",2,1],["أبايعك اليوم قبل الشعوب","بشير خلافتك الساميه",23,"ي",2,0],["أبا يوسفٍ يا أبا يوسفِ","دعاءَ صديقٍ شفيقٍ وفي",24,"ف",2,1],["أبا يوسفٍ أنت عينُ الخبيرِ","وعينُ السديدِ الرشيدِ البصيرِ",25,"ر",1,1],["أَبا يوسفٍ أَنتَ الغِياثُ لِدِيننا","أُولو العلم في أَخبارهم بِكَ بَشّروا",26,"ر",3,0],["أَباً يَتيماً عَريساً أَرمَلاً وَلَهاً","شَيخ الخَطوب صَبياً لِلصِبا غَلبا",27,"ب",2,0],["أبآيةِ الانعام أدنى شبهةٍ","أم آية الاعراف ويك محرَّفه",28,"ف",2,0],["أبا يعقوبَ أنتَ ندًى وبأسٌ","وَإبراهيمُ أنتَ وتاشفين",29,"ن",1,0],["أَبا يونس أَجدبتَ معهدَ أَنسنا","وَعَهدي بِهِ بِالأَمس وَهُوَ خَصيب",30,"ب",1,0],["إِبائيَ أَنْ أرضى بسَوْمِ هَوان","أَراني من العِزِّ الذي تَرَيان",31,"ن",1,1],["آباَئيَ الصيدُ الأماجدُ ما سعَوْا","دَدَنا بدهرهمُ إِلى نَبَّاذِ",32,"ذ",1,0],["أبايعه على الإسلام كشفاً","وإيماناً لألحق بالرعيلِ",33,"ل",1,0],["إبائي الذي لم يُبقِ لي الدهرُ غيرَه","أبى لي مُقامي بينهم ضائعَ المجدِ",34,"د",1,0],["أبا يوسفٍ إنّي نظرتُ فلم أجد","على الفحص رأياً صحَّ منكَ ولا عَقدا",35,"د",2,1],["آبائي الغر الذين بدينهم","دان البعيد من الورى والداني",36,"ن",2,1],["أبا يعلي لأنت أبر خلٍ","إذا ولع البرية بالعقوق",37,"ق",1,1],["أُبايعُ في أَقلامهِ كلَّ حَاسِدٍ","يقيس شَبَاهاً بالمَنايا الشَّواعِبِ",38,"ب",1,0],["أبا يوسف أعيت مزاياك واصفا","وان كان يروي عن فصيح ومفلق",39,"ق",1,0],["أبا يوسف تاللّه ما من فضيلة","قد اندرست إلا وفيك نشورها",40,"ر",3,0],["إبائي يأبى ان اكون متيماً","بمن قلبها ما انفك بالعجب مفعما",41,"م",2,0],["أَبا يوسف الإحسان والحسن خير من","حَوى الفضلَ والإفضالَ والنُّهى والأمرا",42,"ر",2,1],["أَبائعَ رُوقِ حَمدٍ نُح عليهِ","فَأَين الُمشتَري وَلمن تَبيعُ",43,"ع",1,0],["أبا يوسف عين الوجود ومن له","تدين البرايا بالهداية والقهر",44,"ر",1,0],["أبايتها اثنان مع تسعين قد حسبت","فكن لها حافظا وابذل دعاءك لي",45,"ل",2,0],["أبايع شاعر المليونِ منكم","وأذْكُرُهُ بِخِصْلتِه النبيلهْ",46,"ل",2,0],["أبايع غيمة لأنام فيها","فتحملني ويحملها الوصولُ",47,"ل",1,0]]}