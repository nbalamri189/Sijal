{"poems":[[234,"قد أغتدي قبل الصباح المسفر","https://www.aldiwan.net/poem51001.html","الرجز"],[309,"ألا يا نفس ويحك كم تواني","https://www.aldiwan.net/poem16755.html","الوافر"],[463,"قفا نضويكما بالغمر نسأل","https://www.aldiwan.net/poem56264.html","الوافر"],[463,"ضمانة يصدق وعد الضنا","https://www.aldiwan.net/poem56285.html","السريع"],[556,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63873","الوافر"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45394","الوافر"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/144614","الطويل"],[2313,"","https://poetry.dctabudhabi.ae/diwan/poem/123318","الطويل"],[2984,"","https://poetry.dctabudhabi.ae/diwan/poem/178130","الطويل"],[3184,"","https://poetry.dctabudhabi.ae/diwan/poem/96523","المتقارب"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35882","المتقارب"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85230","الطويل"],[4201,"","https://poetry.dctabudhabi.ae/diwan/poem/143808","الوافر"]],"verses":[["وأيّ ثور للمَهَا لم يَنْحَرِ","ضرَّجها من دمها المثعنجِرِ",0,"ر",1,0],["وإيثار الثبات على أمور","لصاحبها تقود إلى الضلال",1,"ل",1,0],["وأيُّ ثرىً كريم العرقِ سِيطَتْ","بهِ رِمَمُ المعالي الدارساتِ",2,"ت",1,0],["وأيُّ ثغرٍ ولَمىً صادني","نابلُ قلبي بهما الصائبُ",3,"ب",1,0],["وأيُّ ثِقْلٍ وقد أعيا الرّجالَ على","ظَهري الّذي حَمل الأثقال ما طُرِحا",4,"ح",2,0],["وإيثاري ببرّ كان أحلى","وأعذبَ في النفوسِ منَ النفوس",5,"س",1,0],["وَإيثارِ الغَريبِ عَلى سِواهُ","وَإِن لَم يُثرِ مِن جاهٍ وَمالِ",6,"ل",1,0],["وأي ثناء في الزمان وسؤدد","لكم جلّ حتى ليس يدرك حدّه",7,"د",2,0],["وايثاره بالمال والروح بالرضا","وتفويضه للّه في كل طرفة",8,"ه",1,0],["وأي ثنايا المجد لم نطلع لها","وأنتم غضاب تحرقون علينا",9,"ن",2,0],["وإيثارِه اليومَ أهلَ الذّنوبِ","ورفعِ القِصاصِ عن القاتلينا",10,"ن",2,0],["وَإيثارِيَ العَفوَ عَن قُدرَةٍ","غَدا اِبنُ صَليبا إِذاً قَد صُلِب",11,"ب",1,0],["وَإيثارُهُ هَدى الرَسولِ وَحُكمِهِ","عَلى كُلِّ ما يَقضي الهَوى بِاِقتِضائِهِ",12,"ا",3,0],["وأي ثلاثة أوفى سواداً","أخالك أم عذارك أو فؤادك",13,"ك",1,0]]}