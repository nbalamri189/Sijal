{"poems":[[45,"أرى ذلك القرب صار ازورارا","https://www.aldiwan.net/poem9565.html","المتقارب"],[46,"لأي حبيب يحسن الرأي والود","https://www.aldiwan.net/poem30617.html","الطويل"],[107,"ألا لا أرى في مصر إلا دعاويا","https://www.aldiwan.net/poem43396.html","الطويل"],[48,"أحسن بالواجد من وجده","https://www.aldiwan.net/poem23628.html","السريع"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[203,"دموع الفجر هذي أم دموعي","https://www.aldiwan.net/poem45646.html","الوافر"],[305,"أغدوا واعد الحي الزبالا","https://www.aldiwan.net/poem45471.html","الوافر"],[325,"لما بعثت بداعي الشوق والدله","https://www.aldiwan.net/poem61721.html","البسيط"],[376,"أرى جمرات في مسالك أنفاسي","https://www.aldiwan.net/poem57359.html","الطويل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99984","المنسرح"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82322","الطويل"],[2376,"","https://poetry.dctabudhabi.ae/diwan/poem/115219","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202401","الطويل"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/133012","الوافر"],[4831,"كُنّا وصرنا","https://www.poetsgate.com/ViewPoem.aspx?id=208617",""],[5038,"كيف يغنيك القليل","https://www.poetsgate.com/ViewPoem.aspx?id=190125",""],[5688,"أخ ما أنجبته الأم","https://www.poetsgate.com/ViewPoem.aspx?id=200689",""]],"verses":[["أَرى ذَلِكَ القُربَ صارَ اِزوِرارا","وَصارَ طَويلُ السَلامِ اِختِصارا",0,"ر",2,1],["أَرى ذَمِّيَ الأَيّامَ ما لا يَضِرُّها","فَهَل دافِعٌ عَنّي نَوائِبَها الحَمدُ",1,"د",1,0],["أَرى ذِمَماً يُنسينَ في الدَهرِ مَن وَفى","وَيُولِعنَ بِالغَدرِ الذِئابَ الضَوارِيا",2,"ي",2,0],["أرى ذَوي الفَضل وأضدادَهم","يَجمعُهُمْ سَيْلُكَ في مَدّهِ",3,"د",2,0],["أَرى ذمّهُ فَرضاً إذا ما ذكرتهُ","فَإن قستهُ بِاليومِ أَوليتهُ شُكرا",4,"ر",2,0],["أرى ذا الليلَ قدْ خفقت حشاهُ","وبيَّضَ عينهُ نزفُ الدموعِ",5,"ع",1,0],["أَرى ذا شَيبَةٍ حَمّالٍ ثِقلٍ","وَأَبيَضَ مِثلَ صَدرِ السَيفِ نالا",6,"ل",2,0],["أَرى ذَكاءَكَ مِن عِشقي غَدا بَلَها","فَكَيفَ تَظهَرُ لي يا سَيِّدي وَلَها",7,"ه",2,0],["أرَى ذلَّةَ الشكوى قد اشتغلت بها","فَمن يَشتَكي عنها هَواها إلى الناسِي",8,"س",2,0],["أَرَى ذَكِياً ذَكَتْ خَوَاطِرُهُ","فَلَمْ يَخُنْ فَهْمَهُ مُتَلِّدُهُ",9,"د",2,0],["أَرى ذاكَ مِن غُنمٍ وَلَستُ أَرى الَّذي","يَرى الناسُ مِن غُنمِ المَكاسِبِ مُغنَما",10,"م",2,0],["أرى ذاك حقاً واجباً لمنادمي","إذا قال لي غير الجميل من النكر",11,"ر",1,0],["أرى ذاك رغم الطيش عندي معززاً","وهذا على رغم الوقار محقرا",12,"ر",2,0],["أرى ذا النَّقصِ لا يَعبأ بِذمّ","كذا من يَعم لا يَخشَ الظَّلاما",13,"م",2,1],["أَرى ذلكَ الدهرَ صارَ عِثارا","يُميتُ كِبارًا ويُحيي صِغارا",14,"ر",2,1],["أرى ذا كلّ طاغيةٍ تولّى","أتى يوماً كما يأْتي الذليلُ",15,"ل",1,0],["أرى ذا الشّوق طال إلى صديقي","أما للشّوق يا صحبي دواء",16,"ا",2,0]]}