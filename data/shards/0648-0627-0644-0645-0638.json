{"poems":[[173,"لا عز إلا بحد الصارم الذكر","https://www.aldiwan.net/poem1630.html",""],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105618","الكامل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116499","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117965","الكامل"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111317","الكامل"],[4485,"","https://poetry.dctabudhabi.ae/diwan/poem/132211","الخفيف"],[4942,"رتلتُ حسنَكِ","https://www.poetsgate.com/ViewPoem.aspx?id=188279",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""]],"verses":[["وَالمُظهِرُ الحَقَّ لا يَبغي بِهِ عِوَضاً","إِذ كانَ طالِبُهُ يَغدو علَى خَطَرِ",0,"ر",1,0],["والمظعون إذا المحول تتابعت","والقائلون هلم للأضياف",1,"ف",1,0],["والمظهر الأجلى الذي بظهوره","ظهر الرضا وانجاب كل مخوف",2,"ف",1,0],["والمظهرين البر والتقوى واد","مان التنسك خدعة للجافل",3,"ل",1,0],["والمظهر الأجلى لقدرته","والمنظر الأعلى لمن عقلوا",4,"ل",3,0],["والمظنات والمناظر وال","ظاعن والعظم بعده والشظاظ",5,"ظ",1,0],["والمظلمون أتَوا بكلِّ ظلامهم","كي يُطفِؤوكِ فكنتِ بدراً يُسفِرُ",6,"ر",1,0],["والمظلمون إلى خمس مدرجة","نسخ وفسخ ومسخ مركس لدد",7,"د",1,0]]}