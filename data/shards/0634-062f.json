5,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"],[576,"إن الهوان حمار القوم يعرفه","https://www.aldiwan.net/poem1772.html","البسيط"],[576,"يا آل بكر ألا لله أمكم","https://www.aldiwan.net/poem1798.html","البسيط"],[586,"شدا حالي ليطربهم","https://www.aldiwan.net/poem17452.html","مجزوء الوافر"],[587,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["شَدَدتَ قُواهُ إِلى هَضبَةٍ","أَواخيُّها كُلُّ عَضبٍ يَماني",0,"ي",1,0],["شَدَدنا بِأَيدي العيسِ كُلَّ ثَنِيَّةٍ","وَمِن دونِها جونُ القَرا مُدلَهِمُّهُ",1,"م",2,0],["شَدّا بِها العُترُفُ في جَوِّهِ","وَاِرتاحَ طَيرُ الصُبحِ في الوِكرِ",2,"ر",1,0],["شَدٌّ كَمَعمَعَةِ الحَريقِ وَكَبَّةٌ","كَاللَيلِ أَنجُمُها قَناً وَقَواضِبُ",3,"ب",1,0],["شَديدُ مَجالِزِ الكَتِفَينِ نَهدٌ","بِهِ أَثَرُ الأَسِنَّةِ كَالعُلوبِ",4,"ب",1,0],["شدّوا علَيْهِ يَدَ المُعْتَدِّ فهْوَ لكُمْ","ذُخْرٌ مُقلَّدٌ في نَحْرٍ وفي جِيدِ",5,"د",1,0],["شَدَدْتَ بصِهْرِ المُلْكِ أزْرَ مَجادَةٍ","تَوارَثْتَها عنْ أوْحَدٍ بعْدَ أوْحَدِ",6,"د",1,0],["شَدَدتُ عَلَيها كورَها فَتَشَدَّدَت","تَجورُ عَلى ظَهرِ الطَريقِ وَتَهتَدي",7,"د",2,0],["شَديدُ الشَظى عَبلُ الشَوى شَنِجُ النَسا","كَأَنَّ مَكانَ الرِدفِ مِن ظَهرِهِ وَعى",8,"ا",1,0],["شَدَّ النهارُ ذِراعاً عَيطلٍ نَصَفٍ","قامَت فَجاوَبَها نُكدٌ مَثاكيلُ",9,"ل",1,0],["شُدّوا المَآزِرَ فأَنعَشوا أَموالَكُم","إِنَّ المَكارِمَ نِعمَ رِبحُ الثامِنِ",10,"ن",1,0],["شَدَّ في حَلبَةِ البَلاغَةِ حَتّى","بانَ فيها عَن شَأوِ سَهلٍ وَعَمرِ",11,"ر",1,0],["شُدّوا المَآزِرَ حَتّى يُسْتَدَفّ لكُمْ","وشَمّرُوا إنّها أيّامُ تَشمارِ",12,"ر",1,0],["شَدَدتَ عِصابَ الحَربِ إِذ هِيَ مانِعٌ","فَأَلقَت بِرِجلَيها مَرِيّاً فَدَرَّتِ",13,"ت",1,0],["شَدِيدَ الْبَطْشِ خَشْيَةَ غَيْرِ خَاشٍ","أَيُرْهَبُ انْتِسَابٍ وَاكْتِسَابِ",14,"ب",1,0],["شَدَّ مَا نَحْنُ وَاجِدُونَ مِنَ التَّبْ","رِيحِ هَلْ مِثْلَ وَجْدِنَا تَجِدَانِ",15,"ن",1,0],["شَدَّ فِي السِّيرَةِ الَّتِي سِرْتَ مَا عَا","نَيْتَ مِمَّا تَرْتَاعُ مِنْهُ الظُّنُونُ",16,"ن",1,0],["شَدَتِ الأَطْيَارُ تَتْلُو حَمْدَهَا","بَعْدَ حَمْدِ الله رَبِّ العَالَمِينْ",17,"ن",1,0],["شَدَّ مَا كَابَدَ الْفَقِي","دُ دَؤُوباً بِلا سَأَمْ",18,"م",1,0],["شَدَّ الَّذِي لاقَيْتُمُ دُونَ الْحِمَى","كَمْ شِدَّةٍ لانَتْ بِهَا الأَيَّامُ",19,"م",1,0],["شَدَّ مَا سَامَنَا الْهَوَى كُلَّ يَوْمٍ","مِنْ دِفَاعٍ وَسَامَنَا مِنْ هُجُومِ",20,"م",1,0],["شَديدِ اللَظى حامي الوَديقَةِ ريحُهُ","أَشَدُّ أَذىً مِن شَمسِهِ حينَ تَصمَحُ",21,"ح",1,0],["شَدَدتُم حُباكُم عَلى غَدرَةٍ","بِجَيشانَ وَالسَيفُ لَم يُغمَدِ",22,"د",1,0],["شَدَدتُ الوَطءَ فَوقَ رِقابِ تَيمٍ","عَلى مَضَضٍ فَقَد ضَرَعَ الخُدودُ",23,"د",1,0],["شَديداً مِنَ الأَثآرِ خَولَةَ بَعدَما","دَعَت وَيلَها وَاِستَعجَلَت أَن تَخَمَّرا",24,"ر",2,0],["شَديدٌ مِن وَرائِهِمُ ضَريري","بَطيءٌ بَعدَ مِرَّتِيَ اِنتِقاضي",25,"ي",1,0],["شَدَدتُم حُباكُم لِلخَزيرِ وَأَعيَنٌ","يُقَرِّبُ يَكبو لِليَدَينِ وَلِلفَمِ",26,"م",1,0],["شَدّاً وَمَرفوعاً يُقَرِّبُ مِثلُهُ","لِلوَردِ لا نَفِقٌ وَلا مَسؤومُ",27,"م",1,0],["شَديدٌ عَلى طَيِّ المَنازِلِ صَبرُهُ","إِذا هُوَ لَم يَظفَر بِأَكرَمِ مَنزِلِ",28,"ل",1,0],["شَديدُ تَجَنُّبِ الآثامِ وافٍ","عَلى عِلّاتِهِ عَفُّ الإِزارِ",29,"ر",1,0],["شَدَدتُ عَلى الحَمامَةِ كورَ رَحلٍ","بَعيدٌ حَلُّهُ دونَ اليَسارِ",29,"ر",1,0],["شُدَّت سَحائِبُهُ مِنهُ عَلى نُزَهٍ","تَقَسَّمَ الحُسنُ بَينَ السَمعِ وَالبَصَرِ",30,"ر",1,0],["شَدَّ ماغَيَّرَتكَ بَعدي اللَيالي","يا قَليلَ الوَفا قَليلَ النَظيرِ",31,"ر",1,0],["شُدّوا السُيوفَ بِثِنيٍ في مَناطِقِكُم","حَتّى يَحينَ بِها في المَوتِ مَن حانا",32,"ن",2,0],["شدَّت لساحته الرحالُ ففعلها","يقضي بنصرِ الحرف نحوَ جهاتها",33,"ت",3,0],["شدَّت مناطقه معاطفَ قدّه","فضممت حرفَ اللين منه مشدَّدا",34,"د",2,0],["شديد الظلم حلّ صميم قلبي","كذاك الظلم يوقع في الأسير",35,"ر",1,0],["شدَا شدْوَ الحمام وماسَ غصنا","غني الحسن يطرب إن تغنى",36,"ن",2,1],["شديد القوى عَبْل الشوى مُؤْجَد القرا","مُلاحِك أطباق الفِقار مضبّر",37,"ر",1,0],["شدّ من متنِها هوى بعضها بع","ضاً وقد همّ خصرُها بانخزالِ",38,"ل",1,0],["شُدَّتْ بهم عُقَدُ الخلافةِ فاش","تدَّت وحُلَّت عُقْدةُ الكظمِ",39,"م",1,0],["شَدَّ ما هان عندك الخطُب فيها","لا يكنْ للَّتي أهنْتَ الهَوانُ",40,"ن",1,0],["شَدَدنا عَلَيكُم شَدَّةً فَكَأَنَّما","طَرَدنا بِوَدمٍ وَالنَخابِقَةِ الحُمرا",41,"ر",2,0],["شُدَّت رَحائِلُ خَيلِهِ وَتَكَشَّفَت","عَنهُ الحُروبُ بِفارِسٍ مِغوارِ",42,"ر",1,0],["شَديدَةِ أَنَّ الآخَرينَ كَأَنَّها","إِذا اِبتَدَّها العِلجانِ زُجلَةُ قافِلِ",43,"ل",1,0],["شُدَّتِ الأَمراسُ في ساعِدِها","مَن رَأى الأَمراسَ حَولَ الجَدوَلِ",44,"ل",1,0],["شدوه يطرب النفوس جميعا","ولكل الاسماع منه نصيب",45,"ب",1,0],["شدت في هدوء الليل تدعو اليفها","وفي شدوها شجو لسامعه باد",46,"د",1,0],["شدوت بالشعر للاجيال تطربهم","بسحره قادرا والسحر الحان",47,"ن",1,0],["شديد على حرية الفكر ضغطهم","كأنهم اعداء حرية الفكر",48,"ر",1,0],["شدا الشعر بعد الصمت يطرب امة","فيا شعر قد احسنت فاشدو أطرب",49,"ب",1,0],["شدا الحادى بشعرك في الفيافي","وحركت الرعاة به اليراعا",50,"ع",2,0],["شَديدٌ صُلَّبٌ في الحَقِّ حَتّى","يَقولَ الحَقُّ ليناً وَاِتِّداعا",51,"ع",2,0],["شِدتُمو دُنياهُ في أَحسَنِها","غَزوَةَ السودانِ وَالفَتحِ الأَغَر",52,"ر",1,0],["شَديدُ الخُنزُوانَةِ لا يُبالي","أَصابَ إِذا تَنَمَّرَ أَم أُصيبا",53,"ب",2,0],["شَدَوا بِاِبنِ إِسحاقَ الحُسَينِ فَصافَحَت","ذَفارِيَها كيرانُها وَالنَمارِقُ",54,"ق",1,0],["شَديدُ البُعدِ مِن شُربِ الشُمولِ","تُرُنجُ الهِندِ أَو طَلعُ النَخيلِ",55,"ل",1,1],["شَديدُ ثَباتِ الطَرفِ وَالنَقعُ واصِلٌ","إِلى لَهَواتِ الفارِسِ المُتَلَثِّمِ",56,"م",1,0],["شَدُّوا الرِحالَ وأعملوا أنضاءَهُمْ","ورمَوْا بها جُدَدَ الطريق المَهْيَعِ",57,"ع",1,0],["شَدَدنا عُرى آمالِنا وَظُنونِنا","بِأَجوَدِ مَصحوبٍ وَأَنجَدِ صاحِبِ",58,"ب",1,0],["شَديدُ إِحصادِ فَتلِ الرَأيِ يَنكُلُ عَن","جَريٍ إِلى الغايَةِ القُصوى مُخاطِبُهُ",59,"ب",2,0],["شَدَّ ما فُرِّقَت طَرائِقُ هَذا ال","ناسِ المَذمومُ وَالمَحمودُ",60,"د",1,0],["شَديدُ عَداوَةٍ وَقَديمُ ضِغنٍ","لِأَهلِ المَيلِ مِنهُم وَالعِنادِ",61,"د",1,0],["شَدائِدُ دَهرٍ بَرَّحَت بي صُروفُها","وَأَكثَرُ ما أَرجوكَ حَيثُ الشَدائِدُ",62,"د",1,0],["شَدَّ ما يُمرِضُ الصَحيحَ قُواهُ","مَرَضُ الطَرفِ ساجِياً وَفُتورُه",63,"ر",2,0],["شُدَّ ما أُغرِمَت ظَلومُ بَهَجري","بَعدَ وَجدي بِها وَغُلَّةَ صَدري",64,"ي",1,1],[