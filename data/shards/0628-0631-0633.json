{"poems":[[72,"برسم الغزاة وضرب العداة","https://www.aldiwan.net/poem42708.html","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[201,"يا من صهرت لهم شعوري","https://www.aldiwan.net/poem39818.html","مجزوء الكامل"],[242,"يا ولي الله يا نجل الحسن","https://www.aldiwan.net/poem19093.html","الرمل"],[354,"ومليحة كالشمس رأد الضحى","https://www.aldiwan.net/poem15882.html","الكامل"],[398,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66749","السريع"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112815","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112869","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77744","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109639","الطويل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113865","الكامل"],[2903,"","https://poetry.dctabudhabi.ae/diwan/poem/204529",""],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85235","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114362","الخفيف"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89570","المديد"],[4829,"ملحمة الليث والمهاة وبنات آوى","https://www.poetsgate.com/ViewPoem.aspx?id=34252",""],[5431,"عبدة الشيطان ....","https://www.poetsgate.com/ViewPoem.aspx?id=207545",""],[5618,"وردة في محراب عقبة","https://www.poetsgate.com/ViewPoem.aspx?id=208918",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""]],"verses":[["بِرَسمِ الغُزاةِ وَضَربِ العُداةِ","بِكَفِّ هُمامٍ رَفيعِ الهِمَم",0,"م",1,1],["برَسوبٍ يَهْوي إلى ثَبْرَةِ الما","ءِ ولو أنّهُ أصابَ ثَبيرا",1,"ر",2,0],["برسالة قد جنّحت","قلبي فطار من السرور",2,"ر",1,0],["بِرَسُولِ اللهِ يَنْبُوعِ السَّنَا","خَيْرِ خَلْقِ اللهِ شُؤْبُوبِ الْمِنَنْ",3,"ن",1,0],["بِرِسالَةٍ دَقَّت مَعاني لَفظِها","وَزَهَت لَآلئُ عَقدِها بِنِظامِها",4,"م",3,0],["بِرَسولِ اللَهِ مَن حا","زَ المَعالي وَحَواها",5,"ا",3,0],["برسمِ دارٍ ما بها مؤنِسٌ","إلاّ صِلالٌ في الثَّرى وقَّعُ",6,"ع",1,0],["برسولهم أو دليلهم وحبيبهم","على الهدى ذاك الحبيب محمد",7,"د",1,0],["برسولك الهادي وكل صحابة","وبآله أهل الشراب الصاف",8,"ف",1,0],["بِرَسائِل تدنيه من أَحبابها","تَهوي وَتخطف خطفة الشاهين",9,"ن",1,0],["برستم باشا خاز لبنانُ بهجةً","واحكامه احيا بحكمتها العدلا",10,"ل",2,1],["برسالة تشفي العليل كأنها","ريح القميص أتى به ملقيه",11,"ي",2,0],["برسالة تهدينها","أو زورة تحت الظلم",12,"م",1,0],["برسول اللَه قد نالوا العلى","وبه تم لهم نصر وفتح",13,"ح",1,0],["بِرَسُولِ اللهِ المُمِدِّ لِكُلٍّ","بِالَّذِي يَرتَجِيهِ مِنكَ نَوَالا",14,"ل",2,0],["بِرَسولِ اللَهِ لي ثِقَةٌ","بِها في الدارَينِ لَم أُضَمِ",15,"م",1,0],["برسل استفهام يومي لمن ومالي","وش علام القومي يرمي الناصريّة",16,"ي",2,0],["برسيمه عفنٌ والسوط يجلده","صبرٌ عقيدته ..(قالوا من الدين)!!",17,"ن",1,0],["برسالة التوحيد كنتَ موحِّدا","ومناصرًا ومساندا ومؤيدا",18,"د",2,0],["برسول أكرم به من رسول","من أتانا بالملة السمحاء",19,"ا",2,0]]}