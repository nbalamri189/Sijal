{"poems":[[55,"في كل يوم مودات مطلقة","https://www.aldiwan.net/poem30416.html","البسيط"],[53,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[87,"أسلم محمد سيدى","https://www.aldiwan.net/poem6818.html","مجزوء الكامل"],[87,"كن في التواضع كالمدا","https://www.aldiwan.net/poem7771.html","مجزوء الكامل"],[87,"لك في الأرض والسماء مآتم","https://www.aldiwan.net/poem11330.html","الخفيف"],[87,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[51,"المرء نحو من خدينه","https://www.aldiwan.net/poem63168.html","مجزوء الكامل"],[71,"يا سائلي عن الكلام المنتظم","https://www.aldiwan.net/poem28850.html","الرجز"],[54,"خل الذنوب صغيرها","https://www.aldiwan.net/poem27306.html","مجزوء الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[112,"الظروف السود","https://www.poetsgate.com/ViewPoem.aspx?id=8421",""],[132,"تعلم العلم حقا يا فتى عمر","https://www.aldiwan.net/poem50614.html","البسيط"],[190,"إني رأيت ومثلي من رأى عجبا","https://www.aldiwan.net/poem44119.html","البسيط"],[208,"كن في الجماعات حيث كانوا","https://www.aldiwan.net/poem53031.html","مخلع البسيط"],[208,"كن في أمورك ساعيا","https://www.aldiwan.net/poem53086.html","مجزوء الكامل"],[308,"كن في الخمول آمنا","https://www.aldiwan.net/poem58224.html","مجزوء الرجز"],[382,"عيني لتلك الناحيه","https://www.aldiwan.net/poem59167.html","مجزوء الكامل"],[382,"الله الله أنت السمع والبصر","https://www.aldiwan.net/poem59432.html","البسيط"],[435,"كن في أمورك مثل الماء ممتزجا","https://www.aldiwan.net/poem39882.html","البسيط"],[438,"لو حل عن خديه عقد لثامه","https://www.aldiwan.net/poem12734.html","الكامل"],[469,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[473,"يا من تخصص بالتعجرف طبعه","https://www.aldiwan.net/poem59637.html","الكامل"],[484,"حللت قلبي يا ابني","https://www.aldiwan.net/poem37055.html","المجتث"],[484,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[484,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[484,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[500,"حرج على الأيام إن لم تحرج","https://www.aldiwan.net/poem9803.html","الكامل"],[509,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[520,"ثغر الهدى متبلج بسام","https://www.aldiwan.net/poem12245.html","الكامل"],[563,"نحن المراتب بالوجود مرتبه","https://www.aldiwan.net/poem33526.html","الكامل"],[563,"قف على أيمن الحمى كوقوفي","https://www.aldiwan.net/poem34361.html","الخفيف"],[563,"إني أنا بك يا ودود","https://www.aldiwan.net/poem34580.html","مجزوء الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64249","الرمل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133835","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136170","الكامل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82516","الكامل"],[1544,"","https://poetry.dctabudhabi.ae/diwan/poem/111125","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111814","الرمل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141247","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27789","الطويل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28526","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120734","الكامل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21480","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130751","الرمل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146370","الكامل"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34729","الرمل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65422","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62820","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3685,"","https://poetry.dctabudhabi.ae/diwan/poem/203142","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216618",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133262","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133254","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135584","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35510","المديد"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77127","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44688","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94670","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133108","البسيط"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139242","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89575","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76746","الكامل"],[4778,"رأيت عجبا","https://www.poetsgate.com/ViewPoem.aspx?id=210706",""],[4791,"كبرياك","https://www.poetsgate.com/ViewPoem.aspx?id=37026",""],[4915,"لم يَخلُقِ الرَّحمنُ خَطَّاً أَحمرا","https://www.poetsgate.com/ViewPoem.aspx?id=213591",""],[4981,"موعظة","https://www.poetsgate.com/ViewPoem.aspx?id=191763",""],[5010,"كن بياضا","https://www.poetsgate.com/ViewPoem.aspx?id=189858",""],[5064,"استبصار","https://www.poetsgate.com/ViewPoem.aspx?id=199090",""],[5145,"غسمع هديت وخير القول أنصحه","https://www.poetsgate.com/ViewPoem.aspx?id=108170",""],[5150,"ارحلْ ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203386",""],[5162,"نورٌ بجوف الغار","https://www.poetsgate.com/ViewPoem.aspx?id=196784",""],[5219,"لوعة الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=194342",""],[5225,"بك هلا","https://www.poetsgate.com/ViewPoem.aspx?id=27615",""],[5277,"المرثيّة الكاظميّة","https://www.poetsgate.com/ViewPoem.aspx?id=187574",""],[5320,"البسمة الصفراء","https://www.poetsgate.com/ViewPoem.aspx?id=43257",""],[5431,"الفارس المتلهف","https://www.poetsgate.com/ViewPoem.aspx?id=183026",""],[5431,"قد جئت دهرك ثائرا ووحيدا","https://www.poetsgate.com/ViewPoem.aspx?id=196789",""],[5674,"تغازل مصرعك","https://www.poetsgate.com/ViewPoem.aspx?id=190748",""],[5691,"نجوم وبشر","https://www.poetsgate.com/ViewPoem.aspx?id=206118",""],[5704,"يا سعد من ترك الدنيا بما فيها ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=200013",""],[5725,"كن في غيابة قلب من تهوى","https://www.poetsgate.com/ViewPoem.aspx?id=212011",""],[5753,"كُن أنت","https://www.poetsgate.com/ViewPoem.aspx?id=204600",""],[4623,"أعلى الزمان أخذت عهد أمان (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146772",""],[5756,"الجريمة","https://www.poetsgate.com/ViewPoem.aspx?id=5418",""],[5829,"الصوم عن المفاسد","https://www.poetsgate.com/ViewPoem.aspx?id=212595",""],[5842,"إشراقات الأمل / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=105051",""],[6131,"على سلَّمِ المَوتِ نهْتديْ","https://www.poetsgate.com/ViewPoem.aspx?id=189334",""],[6189,"السابحون في منطقة انعدام الوزن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83549&r=&rc=16",""],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""]],"verses":[["كُن في الأَنامِ بِلا عَينٍ وَلا أُذُنٍ","أَو لا فَعِش أَبَدَ الأَيّامِ مَصدورا",0,"ر",2,0],["كُنْ في مَدى المجدِ للأمجادِ كلِّهمُ","صدراً وكن في مدى أغمارهِم كفَلا",1,"ل",2,0],["كن في الإمارة شبه كسرى","ثم كن في الملك كسرى",2,"ر",2,0],["كن في التواضع كالمدا","مة حين تُجلى في الكؤوس",3,"س",1,1],["كُنِّفَت بِالغُيوبِ فَالأَرضُ أَسرا","رٌ مَدى الدَهرِ وَالسَماءُ طَلاسِم",4,"م",1,0],["كَنَفٌ كَمَعنٍ أَو كَساحَةِ حاتِمٍ","خَلقٌ يُوَدِّعُهُ وَخَلقٌ يَطرُقُ",5,"ق",1,0],["كُن في أُمورِكَ ساكِناً","فَالمَرءُ يُدرِكُ في سُكونِه",6,"ن",2,0],["كنْ فيهِ بالعفافِ مرفوعَ الرتبْ","واضربْ أشدَّ الضربِ مَنْ يغشى الريبْ",7,"ب",1,0],["كُن فَوقَ ماشٍ فَوقَ أَر","ضِ الشَوكِ يَحذُرُ ما يَرى",8,"ا",1,0],["كُنَّ في ظِلِّهَا يُغَنِّينَ لِلشَّرْ","قِ وَيُنْهِضْنَ لِلْعُلاَ شُبَّانَه",9,"ن",2,0],["كُنَّ في ظلِّها يُحَيِّينَ مَجْداً","صَاعِداً ضَلَّتِ النُّجُومُ مَكَانَه",9,"ن",2,0],["كُنَّ في ظِلِّها يُنَاغِينَ آما","لاً ويَبْعَثْنَ هِمَّةً وَهْنَانَهْ",9,"ن",2,0],["كن في عقلي ثمان امية هنوف","وشيخ جن وقوم .؟.. من نقض وفتل",10,"ل",1,0],["كنْ في المساجدِ ذا صمتٍ وذَا فكرٍ","مرتِّلَ الذكرِ والآيات والسورِ",11,"ر",1,0],["كن فيلسوفا وجزّ اليوم مغتنما","طيب الحياة على استعجال مستلب",12,"ب",1,0],["كن في المواخير في صدر النهار ضحى","واشرب على طرب من دمعة العنب",12,"ب",1,0],["كن في الجماعات حيث كانوا","فالموت عرسٌ مع الجميعِ",13,"ع",1,1],["كن في أمورك ساعياً","فالشيءُ يقهره القَدَرْ",14,"ر",1,1],["كن في الخمول آمناً","واخش المعالي واتق",15,"ق",1,1],["كن في سَميِّك أسوةً","وخذ الكرامةَ ثانيه",16,"ي",2,0],["كن فيَّ حيّاً وإني فيك أنت أنا","كالشمس ليس لها في برجها كدر",17,"ر",1,0],["كن في أمورك مثل الماء ممتزجاً","بكل لونٍ تنل عزاً وإيجابا",18,"ب",2,1],["كنف أبو الفرجِ السعيدِ أفادَني","فرجاً وسعداً في عليّ مُقامِه",19,"م",2,0],["كنفتك حادثة الزمانِ بمرها","والتبرُ لولا حكهُ لم يعرف",20,"ف",1,0],["كُن في الخُسونَةِ حينَ تَشعُرُ غايَةً","وَدَعِ الَّذي هُوَ غايَةٌ في اللينِ",21,"ن",1,0],["كن في حماه سعيدا","واسعد به يا صبي",22,"ي",1,0],["كن في البدائع ولاد البديع وجل","بالفكر فيها فما توجيه يرتسم",23,"م",1,0],["كن في ابن شعبان تاريخ ظفرت","به عفوا مساء التقانا غير مرتقب",24,"ب",1,0],["كن في المبادي صادقا وافتح لها","نهج الثبات وأعين الحراس",25,"س",1,0],["كنفي بعيري إن ظعنت ومفرشي","كمي وجنح الليل مطرح هودجي",26,"ج",2,0],["كنفت جوار الاختفا مخافةً","لعلي ينجيني مظاهرة الخفى",27,"ا",1,0],["كنف يبيت العلم في حجراته","يتلى وتخفق حوله الأعلام",28,"م",1,0],["كن في الوجود محققاً واحي به","إن الوجود به الحياة الطيبه",29,"ب",2,0],["كن فتى رقَّ فاسترقَّ المعاني","ثم صافي ذات الستور فصوفي",30,"ف",2,0],["كن فيه يقظاناً له","ودع البرية في رقود",31,"د",1,0],["كَنَفَتْها قُبَّةٌ يضحك","عنها كَنَفَاها",32,"ا",3,0],["كن في السفوح جدى السفوح","وفي الشعاب سنى الشعاب",33,"ب",1,0],["كن في التزود راغبا في فضل من","يغنيك منه به جميل عوايده",34,"د",2,0],["كَنَفَتهُم الآباءُ وَاِكتَنَفَت بِهِم","فَسَعَوا بِأَكرَم أَنفُس وَجدودِ",35,"د",1,0],["كن في السماء فتلك مرتبة","جلت واوجبها لك القدر",36,"ر",1,0],["كن في البلا عوني","فأنتَ لي خيرُ نصير",37,"ر",1,0],["كن في ميادين العلى أسداً","لا ثعلباً يعوي ويمتثل",38,"ل",1,0],["كنفسي وما لي من صفات تنزَّهَتْ","عن الكيفِ والتشبيه فهو مرائي",39,"ي",1,0],["كُن في أمُورِكَ كُلِّها مُتمسِّكاً","بالوحيِ لا بزخارِفِ الهذَيَانِ",40,"ن",1,0],["كُن في الطِّرادِ لبان طَرفكَ مَقدماً","وَإِذا دُعيتَ إِلى الطِّرادِ فَشَمِّرِ",41,"ر",1,0],["كُن في كفالةِ أحمدٍ خيرِ الوَرَى","فَلَنَا به زُلفَى وحُسنُ مآبِ",42,"ب",1,0],["كَنَفضِ عِتاقِ الخَيلِ حينَ تَوَجَّهَت","إِلَيهنَّ أَبصارٌ وأَيقَظنَ نُوَّما",43,"م",2,0],["كنَّ في أرواحهن الطائرات","تنشر الحكمة والنور المبين",44,"ن",1,0],["كن في زمانك جاهلاً لا عالماً","إِنْ كنتَ تطمع في حصول مقاصدِ",45,"د",1,1],["كنّ في الناس وأبدل","تُ غداً جاراً بجارِ",46,"ر",1,0],["كنفيس دُرّ عند من لم يدره","لم تغلُ قطّ لسعره أثمانُ",47,"ن",1,0],["كن في الطّرادِ فَقارَةً في ظهرِه","وإذا دُعيتَ إلى النّزالِ فنازلِ",48,"ل",1,0],["كُن في أُمورِكَ كُلِّها مُتَوَسِّطاً","عَدلاً بِلا نَقصٍ وَلا رُجحانِ",49,"ن",1,0],["كُن فاعِلاً لِلخَيرِ قَوّالاً لَهُ","فالقَولُ مِثلُ الفِعلِ مُقتَرِنانِ",49,"ن",1,0],["كُن في زمانك مودوداً لو اعترضَت","له شكاة بكاه من يُعاديه",50,"ه",1,1],["كن في الملاحة والصبا","لقلوبنا فخّاً ووكرا",51,"ر",2,0],["كن في ضمان رسول الله مرتقيا","أوجا من العز فيما شئت فاحتكم",52,"م",1,0],["كن في رعايتنا دنيا وآخرة","فأنت منا ومنا طاب أعراق",53,"ق",1,0],["كن فانياً إلا فكن ممن بنى","واحذر تكن ممن يكون العانيا",54,"ي",2,0],["كَنَفَتني لَكَ يا اِبن عَليّ","نَظَراتٌ مِنكَ راشَت جَناحي",55,"ح",2,0],["كُن في الأُمورِ إذا ما عَن من أرب","بِحسب ما يَقتَضيهِ الحالُ في الآتي",56,"ت",2,1],["كُن في بَدائعِ صُنعِ اللَهِ مُعتَبِراً","وَلا تَكُن حَيواناً راتِعاً فيها",57,"ي",3,0],["كن في وصالك منقذي","يا أيها الرشأُ الذي",58,"ي",1,0],["كن في العبادات يا صاح أو معاملة","بوفق شرعٍ ففيه النجح موسوم",59,"م",1,0],["كن في زمانك كيف يرضى أهله","لا تعد طورهم ولا تتبدل",60,"ل",1,1],["كَنَفَ الحَبيبِ سُقيتَ مِن قَطرِ النَدى","وَكُسيتَ مُخضَلّاً مِنَ الريحانِ",61,"ن",1,0],["كَنَفَ الحَبيبِ عَلَيكَ كُلُّ تَحِيَّةٍ","وَعَلَيكَ كُلُّ سَلامِ لِلرَحمَنِ",61,"ن",1,0],["كنف برود الغيث خصب جنابه","ويبيت فيه الدهر وهو نزيل",62,"ل",1,0],["كن فيلسوفا تجد حلا