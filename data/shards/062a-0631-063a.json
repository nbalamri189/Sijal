{"poems":[[51,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[45,"سواي مرجي سلوة أو مريدها","https://www.aldiwan.net/poem62760.html","الطويل"],[49,"ليس يرجو الله إلا خائف","https://www.aldiwan.net/poem62021.html","الرمل"],[45,"سواي مرجي سلوة أو مريدها","https://www.poetsgate.com/ViewPoem.aspx?id=32953",""],[134,"الحمد لله الذي قد شرفا","https://www.aldiwan.net/poem21016.html","الرجز"],[256,"تبول من شدق مهزول به عجف","https://www.aldiwan.net/poem48444.html","البسيط"]],"verses":[["ترغبُ في حمدِ حامديك ولا","تحرمُ جدوى يديْكَ من جحدكْ",0,"ك",1,0],["ترغَّم في السير القلاصُ ولا ترى","قلوصاً إذا سارت إليه تُرَغَّمُ",1,"م",1,0],["تَرَغَّبَ عَن صِبغِ المَجاسِدِ قَدُّها","لِيَحلُوَ وَاِستَغنى عَنِ الحَليِ جيدُها",2,"د",3,0],["تَرغَبُ النَفسُ إِذا رَغَّبتَها","وَإِذا زَجَّيتَ بِالشَيءِ زَجا",3,"ج",2,0],["ترغب عن صبغ المجاسد قدح","ليحلو واستغنى عن الحلي جيدها",4,"د",3,0],["تُرغِمُ مِن أَعدائِهِنَّ الأُنُفا","وَتَدفَعُ الدَهرَ الَّذي قَد أَجحَفا",5,"ف",2,0],["ترغي وتزبد شدقاه إذا اختلفا","كأنه شدق مفلوج حسى لبنا",6,"ن",2,0]]}