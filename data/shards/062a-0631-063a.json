{"poems":[[53,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[47,"سواي مرجي سلوة أو مريدها","https://www.aldiwan.net/poem62760.html","الطويل"],[51,"ليس يرجو الله إلا خائف","https://www.aldiwan.net/poem62021.html","الرمل"],[47,"سواي مرجي سلوة أو مريدها","https://www.poetsgate.com/ViewPoem.aspx?id=32953",""],[138,"الحمد لله الذي قد شرفا","https://www.aldiwan.net/poem21016.html","الرجز"],[261,"تبول من شدق مهزول به عجف","https://www.aldiwan.net/poem48444.html","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108709","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202765","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33226","السريع"],[4755,"ذَاتُ اللذيذَين","https://www.poetsgate.com/ViewPoem.aspx?id=184702",""],[5183,"حلبة الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=180215",""],[5897,"على بركات الله","https://www.poetsgate.com/ViewPoem.aspx?id=177077",""]],"verses":[["ترغبُ في حمدِ حامديك ولا","تحرمُ جدوى يديْكَ من جحدكْ",0,"ك",1,0],["ترغَّم في السير القلاصُ ولا ترى","قلوصاً إذا سارت إليه تُرَغَّمُ",1,"م",1,0],["تَرَغَّبَ عَن صِبغِ المَجاسِدِ قَدُّها","لِيَحلُوَ وَاِستَغنى عَنِ الحَليِ جيدُها",2,"د",3,0],["تَرغَبُ النَفسُ إِذا رَغَّبتَها","وَإِذا زَجَّيتَ بِالشَيءِ زَجا",3,"ج",2,0],["ترغب عن صبغ المجاسد قدح","ليحلو واستغنى عن الحلي جيدها",4,"د",3,0],["تُرغِمُ مِن أَعدائِهِنَّ الأُنُفا","وَتَدفَعُ الدَهرَ الَّذي قَد أَجحَفا",5,"ف",2,0],["ترغي وتزبد شدقاه إذا اختلفا","كأنه شدق مفلوج حسى لبنا",6,"ن",2,0],["ترغو وتزبد في الكؤوس كأنها","نارٌ تساقط فوقها كافور",7,"ر",1,0],["ترغم الحاسدين نصرا وعزّا","وسناء وتكبت الأعداء",8,"ا",2,0],["ترغبني في الادخار فلم أطع","ولم أدخر إلا رضى الله والأجرا",9,"ر",2,0],["ترغب في الصدِّ وفي أهلهِ","كأنما تستظرفُ الصدا",10,"د",2,0],["تَرغِيبُها لُفَّ في تَرهِيبها.. وأنا","مَابينَ هَذا وهَذا أرْقُبُ الفَرَجَا",11,"ج",2,0],["ترغب في بضاعتي وسوقها","كاسدة فكيف بي لا أرغب",12,"ب",1,0],["تُرْغِي وَتُزْبِد إِسْفَافًا وَقَدْ جَهِلتْ","أَنَّ الْعَوَاصِفَ لَا تُبْقِي عَلَى الزَّبَدِ",13,"د",1,0]]}