{"poems":[[65,"يا حادي الشدنيات المطاريب","https://www.aldiwan.net/poem46151.html","الرجز"],[73,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[53,"كم جارع جرع المكاره عالما","https://www.aldiwan.net/poem66087.html","الكامل"],[47,"أبى الليل إلا أن يعود بطوله","https://www.aldiwan.net/poem65540.html","الطويل"],[71,"مربع من أنس سلمى أوحشا","https://www.aldiwan.net/poem28911.html","الرمل"],[139,"أكذا آخر الحياة يكون","https://www.aldiwan.net/poem49161.html","الخفيف"],[173,"يا باكياً لدمنة وأربع","https://www.aldiwan.net/poem1635.html",""],[201,"أترعي الأقداح يا حوا","https://www.aldiwan.net/poem39879.html","مجزوء الرمل"],[358,"دعينا من بعادك أو عدينا","https://www.aldiwan.net/poem39771.html","الوافر"],[382,"لنا الحجر المرموز في الكتب سره","https://www.aldiwan.net/poem59333.html","الطويل"],[412,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[415,"هذي منازلهم وأنت","https://www.aldiwan.net/poem31647.html","عموديه"],[445,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[466,"بدا ضوء وليس من الصباح","https://www.aldiwan.net/poem16244.html","الوافر"],[520,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122326","الطويل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101998","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48996","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108954","الوافر"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66313","الطويل"],[2104,"","https://poetry.dctabudhabi.ae/diwan/poem/104430","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89523","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27612","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27933","المجتث"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106898","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93810","المنسرح"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67980","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138557",""],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140268",""],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77069","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101379","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123507","الطويل"],[4261,"","https://poetry.dctabudhabi.ae/diwan/poem/124285","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135100","البسيط"],[4914,"طاف بكأس المدام أغيد","https://www.poetsgate.com/ViewPoem.aspx?id=170939",""],[4929,"ليل أشد من الظلماء","https://www.poetsgate.com/ViewPoem.aspx?id=199471",""],[5333,"إذا جاءتِ الأرسال من عند مُرسِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=9366",""],[5537,"ال( أنا ) وال( هو )","https://www.poetsgate.com/ViewPoem.aspx?id=207858",""],[6152,"ضر اشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=207651",""]],"verses":[["فأسْفَرَتْ عُقَبُ الأيّامِ عنْ مَثَلٍ","بهِ وإنْ رَغِمَ الطّائيُّ مَضْروبِ",0,"ب",1,0],["فَأَسفَرَ الصُبحُ لي عَن رايَةٍ بَلَغَت","أَقصى المَدى وَتَناهَت دونَها الرُتَبُ",1,"ب",1,0],["فاسفُلْ سفالَك ما حييتَ فلم تَكُنْ","لتكونَ أعقابُ الرجالِ جماجما",2,"م",2,0],["فَأَسفَرَ وَجهُ الشَرقِ حَتّى كَأَنَّما","تَبَلَّجَ فيهِ البَدرُ بَعدَ أُفولِهِ",3,"ل",2,0],["فاسفري وجهَكِ إنْ لم تصلي","رؤيةُ الماءِ تزيلُ العطشا",4,"ش",2,0],["فاسفحي الدمع يا محاجر حزناً","وأهجري النومَ والكرىَ يا جفونُ",5,"ن",1,0],["فَاِسفَح بِها دَمعَكَ لا مُستَبقِياً","في غَربِهِ وَبُح غَراماً وَاِجزَعِ",6,"ع",1,0],["فاسفري يا ربّة","الحسن وعنوان الوفاء",7,"ا",2,0],["فَأَسفر وَجهها عَن رَوض حُسنٍ","أَرانا الوَرد توّج ياسمينا",8,"ن",2,0],["فأسفر عن وجهٍ تدبَّغ بالثرى","لحى اللَه وجهاً جاء بالمكر دابغا",9,"غ",2,0],["فاسفح بِنَجدٍ ماء عينك إِنَّما","لِلعامِرِيَّة كل نَجدٍ دارُ",10,"ر",1,0],["فاسفح دموعك في ثرا","ها أو يمازجها الدم",11,"م",1,0],["فأسْفرَ عن وجْهٍ تجلَّى سَناكُما","وصدقٍ تجلَّى بالسلامِ عَلَيْكُما",12,"م",2,0],["فأسْفرتِ المَخيلَةُ عنْ إِمامٍ","طَليق الوَجْهِ فيَّاضِ السَّماحِ",13,"ح",1,0],["فأسفر وجه ملك عاضدي","يشار به إلى عضد الإمام",14,"م",1,0],["فاسفر كل عن أصالة غرسه","وفعل الفتىينبي اذا غاب اصله",15,"ل",2,0],["فأسفر البشر في ديجور أحزاني","فقمت أسحب بالنعماء أرداني",16,"ن",2,0],["فأَسفرَ بالسلامِ عن المُحيَّا","وقد كشفَ الحجابَ ولا ستار",17,"ر",1,0],["فأسفر وجهها بعد انقباضٍ","وقالت وهي تبسم في خباها",18,"ا",3,0],["فأسفل من كانوا مظاهر لطفه","قديماً ومن ثم استطالوا واترفوا",19,"ف",3,0],["فأسفرت قبل المرآة فانطبعت","تلك المحاسن فيها وهي تبتسم",20,"م",1,0],["فَأَسفَرَ صُبحُ المُسلِمينَ وَأَشرَقَت","بِطَلعَتِهِ أَنوارُهُم وَاِنتَفى العُسرُ",21,"ر",1,0],["فأسفله أعلاه والعلو سافلُ","فقل ما تشا واحمله في كلِّ محملِ",22,"ل",1,0],["فأسفلُ الكونِ يعلو","وقتا بربي عليّا",23,"ي",2,0],["فأسَّفني الشبابُ وقد تولى","كما ذبلت أزاهيرُ الربيع",24,"ع",1,0],["فأسفرت عن حلى محاسنها","تزري بعقد من الجمان فريد",25,"د",1,0],["فأَسْفَر ضوءُ الفجرِ والبحرُ مُزْبِدٌ","وَقَدْ غاب عنا الجاه والنَّعسُ والغفر",26,"ر",1,0],["فاسفر الحق لكن ما ارعووا فغدا","دون الهدى للمنايا خائضاً لججا",27,"ج",2,0],["فأسفرت عن لثام بان طالعه","وجه عليه من الأنوار دملاج",28,"ج",1,0],["فَأَسفَرَت بِهِ وُجوهُ الكُتُب","لما نَفى عَنها ظَلامُ الريب",29,"ب",1,0],["فأسفر العصر عصر النور عن زمن","بالعسف متقد بالظلم مضروم",30,"م",1,0],["فأسفر عن لا شيء فازداد حسرة","لما مسه لما لآثاره قصا",31,"ص",2,0],["فأسفله أعلى وأعلاه أسفل","وعصفوره صفر وضرغامِه دُب",32,"ب",1,0],["فأسفرت شعرها عن ليل طرتها","فظل من وجهها في البيت لألاء",33,"ا",2,0],["فأسفر المشرقان أفقا","بالنيرين السلاف والخد",34,"د",1,0],["فأسفرت عن صباح ٍ ملء بسمتهِ","آمالنُا ثورةٌ في الريفِ والمدنِ",35,"ن",1,0],["فأسفله أعلاه والعلو سافلُ","فقل ما تشاء واحمله في كلِّ محملِ",36,"ل",1,0],["فأسفتُ حين وجدتنِي كان ال(أنا)","متمسكاً .. وململماً .. طيَّاتي",37,"ت",2,0],["فأسفار وبُعد وإنشغال","وكم رغمت لوطأتها الأنوف !؟",38,"ف",1,0]]}