oetsgate.com/ViewPoem.aspx?id=179052",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[45,"أبُكَاءً في الدّارِ، بَعْدَ الدّارِ","https://www.poetsgate.com/ViewPoem.aspx?id=31284",""],[51,"أيها الماجدُ الذي بهرَ المُدْ","https://www.poetsgate.com/ViewPoem.aspx?id=29917",""],[51,"خلياني عند اصطكاك الخصوم","https://www.poetsgate.com/ViewPoem.aspx?id=25876",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[31,"عجباً ما عجبتُ مما لوَ ابصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18800&r=&rc=63",""],[88,"بغدادُ حسبكِ رقدة وسبات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19515&r=&rc=18",""],[104,"شهداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=173&r=&rc=0",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""],[92,"«صَوْتُ المُسْتَذِلِّين خَافِتٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14601&r=&rc=46",""]],"verses":[["وَلَعَلَّ حالي أَن يَصيرَ إِلى عُلىً","فَالدَوحُ مَنبِتُها مِنَ القُضبانِ",0,"ن",1,0],["وَلَعُجتُ فيها طارِحاً عَن ناظِري","ثِقلَ الدُموعِ وَثانِياً مِن جيدي",1,"د",2,0],["ولعَبْدِ شَمْسٍ والتّجَلُّدُ خِيمُها","عَيْنٌ مُؤَرّقَةٌ وجَفْنٌ دامِ",2,"م",1,0],["وَلَعَمري لَوِ اِستَطَعتُ تَظَلَّم","تُ وَلَكِن لا أَستَطيعُ الكَلاما",3,"م",2,0],["ولعُثْمانَ ارْوِ عنّي وابْنِه","حُسْنَ عهْدي دَرّةَ الرّعْي رضَعْ",4,"ع",1,0],["ولِعَجْزِ النّفوسِ عنْ دَرَكِ الحقْ","قِ وإيقافِها وُقوفَ افْتِضاحِ",5,"ح",1,0],["وَلِعبٌ هُوَ الجِدُّ لَو أَنَّنا","نَظَرنا إِلَيهِ بِعَينِ النُهى",6,"ا",1,0],["وَلَعَلَّ وِردَ العِلمِ مالَم يَرعَهُ","ساقٍ مِنَ الأَخلاقِ وِردُ سَرابِ",7,"ب",1,0],["وَلَعَلَّ نَكبَتَهُ هُناكَ تَفَرُّقٌ","وَتَعَدُّدٌ قَد كانَ في تيجانِهِ",8,"ن",2,0],["وَلَعَمري لَقَد نَطَقتُ صَريحاً","بِاِسمِهِ فَاِنجَلى كَضَوءِ النَهارِ",9,"ر",1,0],["وَلَعَلَّهُ أَرْعَى عَلَيْكَ مِنَ الْبِلَى","فِي تُرْبَةٍ تَرْبُو وَأَنْفُكَ رَاغِمُ",10,"م",1,0],["وَلَعَلَّ مَا عُوقِبْتَ فِي","هِ هُوَ المَآثِرُ وَالمَكَارِمُ",11,"م",1,0],["وَلَعَمْرِي لأَنْتَ مِنْ قَبْلِ سَامٍ","فِي بُنَاةِ العُلَى وَمِنْ بَعْدِ سَامْ",12,"م",1,0],["وَلَعمري لَقَد تَخَيَّرتُ وَجهاً","ما بِهِ خابَ مَن أَرادَ النَجاحا",13,"ح",2,0],["ولِعَت بك الأحداث حتى أصبحت","أذْواء خَطبِك ما لهنّ أساة",14,"ه",1,0],["وَلَعَلَّ دَهراً يَنثَني","وَلَعَلَّ شَعباً يَلتَئِم",15,"م",1,0],["وَلِعتِ بِعَذلِ المُستَهامِ عَلى الهَوى","وَأَولَعُ شَيءٍ بِالمُحِبِّ العَواذِلُ",16,"ل",1,0],["ولعمري لقد دعته وزيراً","منتهى معشرٍ لعلياهُ مبدا",17,"د",2,0],["ولعمري لو اسْتجار به الوح","ش ثنى بعد ما اسْتقلت نباله",18,"ل",2,0],["ولعت بعشقي فيكُم فتأكدت","معانيه فاستولى فأصبح ديدنا",19,"ن",2,0],["ولعاذلي طمعٌ بصبري عنكم","أنا والعذول إذاً سليما الباطن",20,"ن",1,0],["ولعَمْرِي لقد سعيتَ ولكن","نَك عذّرت بعد طول التواءِ",21,"ا",2,0],["ولَعمري لئن أمنتُ أميناً","إنّ في الحق أن أَهابَ مَهيبا",22,"ب",2,0],["ولعمري إِنَّ الحكيمَ وقورٌ","ولعمري إن الكريم طروبُ",23,"ب",1,0],["ولَعَمْرِي لأُمْجِدَنَّكَ مِنْ مَدْ","حٍ بأسْمَائك العُلى مَعْقُودِ",24,"د",1,0],["ولَعَهْدي قبل هاتيك بها","وهْي زوْراء عن الوصْل حَيُودُ",25,"د",1,0],["ولعلها إن لا تضرَّ عدوهُ","وهو المسلِّف عاجل الإضرارِ",26,"ر",1,0],["ولعمري إن تأملناهمُ","ما علوا لكن طفوا مثل الجيف",27,"ف",1,0],["ولعمري لقد نصرت بأن عو","وِضتَ حمداً وجنة ألفافا",28,"ف",2,0],["ولعمري لقد وردتك عذباً","لا جوىً آجناً ولا مطروقا",29,"ق",2,0],["ولعمري لقد صدقت ولو قد","خِيضَ من دونه أجيج الحريق",30,"ق",1,0],["ولعمري لئنْ قربْتَ لقاءً","ونوالاً لقد بعُدتَ منالا",31,"ل",2,0],["ولعمري ما أنت كالسيف صقلاً","حين نَنْضُوك بل مضاء وصقلا",32,"ل",2,0],["ولعلّهم لو أدركوك لأُرسِلتْ","طيرُ العذابِ عليهمُ السّجِّيلا",33,"ل",2,0],["ولعمرُ جمعِ الزنجِ يومَ لقيتَهم","ما صادفوك يراعةً إجفيلا",33,"ل",2,0],["ولعمري لأنتَ ذاك وما أن","شر عنك المحاسنَ المنحولهْ",34,"ل",2,0],["ولعمري لكانت الإنسُ أحجى","باجتنابِ الأمورِ ذات الوبالِ",35,"ل",1,0],["ولعمرُ القنا الذي استدبرتْه","لو تمتّعْن منه باستقبالِ",35,"ل",1,0],["ولعمري ما ذاك إلا لفضلٍ","عميتْ عنه أعينُ الجُهّالِ",35,"ل",1,0],["ولعلَّ ما تلقي لمجدٍ بانيا","إلا امرءاً أضحى لمالٍ هادما",36,"م",2,0],["ولعوداتُ ريع جودِك للآ","مل أولى من غيرها بالدوامِ",37,"م",1,0],["ولعَمري لقد عميتَ عن الرُّشْ","د وقصدِ المحجَّة المستقيم",38,"م",1,0],["ولعهدي بهنَّ قبلَ مشيبي","ينتظمن القلوبَ أيَّ انتظام",39,"م",1,0],["ولعمري لأمنعنَّك أن تَضْ","حَكَ في رأسِ آسفٍ محزون",40,"ن",1,0],["ولَعمرُ المغَنّياتِك في مَدْ","حكَ ما قلن فيك من بهتان",41,"ن",1,0],["ولعمري وما أقولُ بظنٍّ","فيك لكن بغاية الإيقان",41,"ن",1,0],["ولعل ذا جهل يقول بجهله","إن المُعاتِبَ في الطفيف مَهين",42,"ن",1,0],["ولعمري ما ذاك أعجبُ من أنْ","كان عِلجاً فصار من شيبانا",43,"ن",2,0],["وَلع الزمانُ بأن يحرِّكَ ساكِناً","وبأن يثيرَ من الأوابدِ كامنا",44,"ن",2,1],["وَلعاً للأمير من عثرة الشَّكْ","وِ ونفسي وكلُّ نفسٍ تَقيه",45,"ي",2,0],["وَلَعَمرِيَ إِن تَفَضَّل","تَ فَقَد تَمَّ النَعيمُ",46,"م",1,0],["وَلَعَمري لَقَد تَزايَدَ ما بي","مِن وُلوعٍ وَحُرقَةٍ وَسُهادِ",47,"د",1,0],["وَلَعَلَّ أَمراً ساءَهُ","مِن جانِبي فَتَجَنَّبا",48,"ب",2,0],["وَلَعَمري لَقَد رُزِئتَ أَخاً بَر","راً وَمَولىً نَدباً وَفَرعاً نَجيبا",49,"ب",2,0],["ولَعْلَعَةُ الحقّ الغَضوبِ لها صدًى","ودَمْدَمَةُ الحربِ الضَّروسِ لها فمُ",50,"م",1,0],["ولَعَلَّ جَفْنَ الزهرِ","أَحْفَظُ للدُّمُوعِ الجَاريهْ",51,"ه",1,0],["وَلَعَرفُ الكَلِم العَذ","ب مِنَ العَنبَر أَعطَرْ",52,"ر",1,0],["ولعل الأيام تأمر بالسل","م ولكن هناك من لا يطيع",53,"ع",1,0],["ولعل الحمام ليس كما يز","عم ناس مبالغون يروع",53,"ع",1,0],["ولعلهم قد آمنوا من بعد ما","جحدوا بما للسيف من اعجاز",54,"ز",1,0],["ولعل الصبا تمر رخاء","فوق ملحودتي فتنعش عودي",55,"د",2,0],["ولعلي رجوت ما ليس يرجى","ولعلي حمدت غير حميد",55,"د",1,0],["ولعّل البكاء غير مسل","ولعّل البكاء غير مفيد",55,"د",1,0],["ولعل الزمان في دوره يجمع","بين الآمال والآباد",56,"د",1,0],["ولعل الروح الذي هو يبقى","جوهر في نجاره غير بال",57,"ل",1,0],["ولعل الجسم الذي هو يبلى","مهبط في يوم لروح عال",57,"ل",1,0],["ولعل الأيام تعلن سلما","بعد حرب الأديان والأموال",57,"ل",1,0],["ولعل فتوحا له في دوره","ما يستفز النفس ساعة يكلف",58,"ف",1,0],["ولعله في الصبح يلفى سالما","ولعله قبل السلامة يغرق",59,"ق",1,0],["ولعل الارض التي هي عطشى","اصبحت ريا من دم اهريقا",60,"ق",2,0],["ولعل الحياة بعد بوار","للخلايا منضمة للاثير",61,"ر",1,0],["ولعل الاثير يبصر مالا","تبصر العين من وراء الستور",61,"ر",1,0],["ولعل الاثير يسمع ما لا","تسمع الاذن من مكان شطير",61,"ر",1,0],["ولعل الاثير يعلم مالا","تعلم النفس من خفي الامور",61,"ر",1,0],["ولعل الاثير اصل التروي","ولعل الاثير اصل الشعور",61,"ر",1,0],["ولعل الاثير هذا على الهدم","وبدء الاكوان جد قدير",61,"ر",1,0],["ولعل الاثير في كل ارض","وسماء كاللَه في التأثير",61,"ر",1,0],["ولعل الذاتين واحدة في ال","أصل والخلف جاء في التعبير",61,"ر",1,0],["ولعل من ضل السبيل سيهتدي","يوما ومن قد نام سوف يفيق",62,"ق",1,0],["ولعل ايام السلام قريبة","ولعل ايام السلام تروق",62,"ق",1,0],["ولعل الوجود من بعد حين","يتجلى للعقل من بعد لبس",63,"س",1,0],["وَلَعِبَت عَلى الحِبالِ وَحدَها","وَجَرَّبَت إِرخائَها وَشَدَّها",64,"د",3,0],["ولِعَيْني دَمْعٌ تَسِيلُ مَثَاني","هِ وتَجْرِي رباعُهُ وثلاثُهْ",65,"ه",1,0],["وَلَعَلّي مُؤَمِّلٌ بَعضَ ما أَب","لُغُ بِاللُطفِ مِن عَزيزٍ حَميدِ",66,"د",1,0],["وَلَعَمري لَقَد هُزِزتَ بِما قي","لَ فَأُلفيتَ أَوثَقَ الأَطوادِ",67,"د",1,0],["وَلَعَمري لَقَد شَغَلتَ المَنايا","بِالأَعادي فَكَيفَ يَطلَبنَ شُغلا",68,"ل",2,0],["ولعلَّهُ يوماً يُحِسُّ بقبْحِه","من بعدِه فيُعيدُ فيه جَمالَهُ",69,"ل",2,0],["ولعَ العُداةُ بهم فذادَهُمُ","يَقظانُ في استعجاله مَهَلُ",70,"ل",1,0],["ولعله أن يرعوي من بعدِ أنْ","لم يُبقِ في قوسِ الإِساءة منزَعَا",71,"ع",2,0],["وَلَعَمري ما العَجزُ عِندِيَ إِلّا","أَن تَبيتَ الرِجالُ تَبكي النِساءَ",72,"ا",2,0],["وَلَعَلَّ الزَمانَ يُنجِزُ وَعداً","فيكَ إِنَّ الزَمانَ غَيرُ كَذوبِ",73,"ب",1,0],["وَلَعَمري لَقَد تَدَبَّرتُ مَعرو","فَكَ عِندي فَلَم يَكُن بِعَجيبِ",74,"ب",1,0],["وَلَعَمرُ الحَبيبِ إِنَّ اِقتِراباً","مِنهُ لَو تَستَطيعُهُ لَقَريبُ",75,"ب",1,0],["وَلَعَمري لَئِن دَعَوتُكَ لِلجو","دِ لَقِدماً لَبَيَّتَني بِالنَجاحِ",76,"ح",1,0],["وَلَعَمري لَرُبَّ يَومٍ شَفَعنا","مِنكَ سُقيا النَدى بِسُقيا الراحِ",77,"ح",1,0],["وَلَعَمري يَمينَ بِرٍّ وَحَسبي","في الهَوى أَن أَقولَ فيهِ لَعَمري",78,"ي",1,0],["وَلَعَمري لَلجودُ لِلناسِ بِالنا","سِ سِواهُ بِالثَوبِ وَالدينارِ",79,"ر",1,0],["وَلَعَمري لَئِن أَعَنتَ لَقَد أَل","جا إِلى العَونِ يونِسٌ وَعِفاصُه",80,"ص",2,0],["وَلَعَمري لَولا الأَقاحي لَأَبصَر","تُ أَنيقَ الرِياضِ غَيرَ أَنيقِ",81,"ق",1,0],["وَلَعَمري ما ماءُ زَمزَمَ أَحلى","عِندَهُ مِن دَمِ بِزارِمّينا",82,"ن",2,0],["وَلَعَلَّ مامَلَكَ العَذولُ مَقادَتي","في الحُبِّ أَو حَبَسَ المَشيبُ عِناني",83,"ي",1,0],["وَلَعَمرُ هاتِمِ في قَريبَةَ ظالِماً","ما خافَ صَولَةَ بَعلِها البَربارِ",84,"ر",1,0],["ولَعِبَتْ أَيديهما في القَرقَر","أيُّهما بَعْلُ الغَزالِ الأَحوَرِ",85,"ر",1,0],["وَلَعَمري عَن قَليلٍ","كُلُّ مَن فيها يَموتُ",86,"ت",1,0],["وَلَعَلَّ طَرفَكَ لا يَعو","دُ وَأَنتَ تَجمَعُ لِلدُهورِ",87,"ر",1,0],["وَلَعَمري لَنَمضِيَنَّ وَلا نَم","ضي بِشَيءٍ مِنها اِذا ما مَضَينا",88,"ن",2,0],["وَلَعَمري إِنَّ الطَريقَ إِلى الحَق","قِ مُبينٌ لِلناظِرِ المُستَبينِ",89,"ن",1,0],["وَلَعَلَّ لاحِظَ لَحظَةٍ","سَيَموتُ في أُخرى تَليها",90,"ي",3,0],["وَلَعَمري لَولا أَذى كَفِّها إِذ","ضَرَبَتني بِالسوطِ ما تَرَكَتني",91,"ي",1,0],["وَلِعتُ بِذِكرِ الغانِياتِ تَمَوُّهاً","عَنِ اِسمِكَ كيلا يَعلَمَ الناسُ مَن أَهوى",92,"و",2,0],["وَلَعَمري ما زالَ حُبُّكَ قَي","داً في حالَتَي بُعادي وَقُربي",93,"ب",2,0],["ولعلَّ القضاء يسخر مني","حين أبكي وما عرفتُ البكاءَ",94,"ا",2,0],["وَلَعَلَّ ما يَرجوهُ مِمّا لَم يَكُن","بِكَ عاجِلاً أَو آجِلاً سَيَكونُ",95,"ن",1,0],["وَلَعَمري لَقَد كُفيتُ لَكَ الدَع","وَةَ إِذ كُنتُ شاتِياً بِالشَآمِ",96,"م",1,0],["وَلَعَلّي أُدالُ مِنها بِلا عَه","دٍ وَلا ذِمَّةٍ وَلا ميثاقِ",97,"ق",1,0],["وَلَعَمري أَن لَو أَصَختُ لِأَقدَم","تُ لِحَتفي ضَغينَةَ الحُسّادِ",98,"د",1,0],["وَلَعَمرُ القَنا الشَوارِعِ تَمرى","مِن تِلاعِ الطُلى نَجيعاً صَبيبا",99,"ب",2,0],["وَلَعَمري لَحَينُ عَمروٍ إِلَيها","يَومَ ذي الشَري قادَني وَدَعاني",100,"ي",1,0],["وَلَعَمري لَئِن هَمَمتِ بِقَتلي","لَبِما قَد قَتَلتِ قَبلي الرِجالا",101,"ل",2,0],["وَلَعَمري ماذا بِأَوَّلِ ما عا","هَدتَني يا اِبنَ عَمِّ ثُمَّ غَدَرتا",102,"ت",2,0],["وَلَعَمري لَيَحسُنَنَّ عَزائي","عَنكَ إِذ كُنتَ غَيَّها قَد أَلِفتا",103,"ت",2,0],["وَلَعَمداً رَدَّني فَاِجتَهَدَت","بِيَمينٍ حَلفَةً عِندَ الغَضَب",104,"ب",1,0],["وَلِعَت بِمُضطَرِمِ الإِباءِ ومارسَتْ","جَلْداً على أهوالها صبّارا",105,"ر",2,0],["وَلِعتْ يدُ العادي بها فأرادها","أَخذَ العقيرةَ من سوام المالِ",106,"ل",1,0],["وَلَعُ الغَوِيِّ بِكَأسِهِ وَمُدامِهِ","وَغَرامُهُ بِفَتاتِهِ وَغُلامِهِ",107,"م",2,0],["وَلِع الرُّماةُ بهم فِتلكَ سِهامُهُم","مِلءَ القسيِّ إلى النُّحورِ تُصَوَّبُ",108,"ب",1,0],["ولعقن حذء شرون حتى","صح ..مهل..قطعتموني لحذءُ",109,"ا",1,0],["وَلعمري رَأَيتُ مِنك وَفاءً","لَم يَكُن فيهِ ذَرّة لارتيابي",110,"ي",1,0],["ولعلَّ أشواقي بلَغْن بيَ المدى","فوقعتُ لا أصحو على شفتيْها",111,"ي",3,0],["وَلَعبَةً أَحكَمَتها","عِنايَةُ النَجارِ",112,"ر",1,0],["وَلِعُذرٍ لَهُمُ لَو قَبلَها","لَم يَروا إِلّا قِداحي وَزِنادي",113,"ي",1,0],["وَلَعَمْرِي لَقَدْ تَوَفَّرَ نِصْفُ","الْمالِ مِنها وَراحَ في النِّسْيانِ",114,"ن",1,0],["وَلَعَمْرِي لَوِ اتَّقَى اللهَ في","السِّرِّ اتَّقَتْهُ الأَنامُ في الإعْلانِ",114,"ن",1,0],["وَلَعَمري لَئِن تَماسَكَ غَربي","وَنَهاني عَنها الهُمامُ الرَئيسُ",115,"س",1,0],["وَلِعَمرُ المُدامِ إِن قُلتَ فيها","إِنَّ فيها لَمَوضِعاً لِلمَقالِ",116,"ل",1,0],["وَلَعَلَّ عَكساً في اللَيالي كائِنٌ","فَتَعودَ في الشَرَقاتِ مُتَّضِعاتُها",117,"ت",3,0],["وَلِعُجبِها ما قَرَّبَت مِرآتَها","نَزَّهتُ خِلّي عَن مَقالي عُج بِها",118,"ه",2,0],["وَلَعَلَّ دُنيانا كَرِقدَةِ حالِمٍ","بِالعَكسِ مِمّا نَحنُ فيهِ تُعَبَّرُ",119,"ر",1,0],["وَلَعَلّي كَذاكَ في داري الأُخ","رى إِذا ما اِدَّكَرتُ ريَّقَ عِمري",120,"ي",1,0],["وَلَعَلَّ مَكَّةَ في السَماءِ كَمَكَّةٍ","وَبِها نِضادِ وَيَذبُلٌ وَيَلَملَمُ",121,"م",1,0],["ولعل الذين ضحوا بأكبا","ش عليهم بها يهون المرور",122,"ر",1,0],["وَلعلَّ ما أَنا شاهد","في لَيل إدلاجي طيوف",123,"ف",1,0],["ولعت بها حسناء تزهو كزهرة","نمت فأطلت في الرَبيع على العشب",124,"ب",1,0],["وَلَعَلَّ من قد بانَ عَن","أوطانه يوماً يؤوب",125,"ب",1,0],["وَلعل الحياة في الأصل منها","ثورة في كهيربات الجماد",126,"د",1,0],["ولعل الشموس تسعى إلى المب","دأ في منحنىً من الأبعاد",126,"د",1,0],["وَلعل الحَكيم يقرأ فيها","من مراد الحَقيقة الخرساء",127,"ا",2,0],["وَلِعٌ بتخطيطِ الرمال كأنه","عرَّافةٌ تستطلع الأنباءَ",128,"ا",2,0],["وَلِعاصِمٍ أَثَرٌ بِها","باقٍ وَذِكرٌ مُستَطاب",129,"ب",1,0],["وَلِعَ القَومُ بِالنَظافَةِ حَتّى","جُنَّ فيها غَنِيُّهُم وَالفَقيرُ",130,"ر",1,0],["ولعنهم خلاصة الأكابر","أبا الزّكيين على المنابر",131,"ر",1,0],["ولَعَمرُ الدَّارِ لَو أَنَّ بها","أَهلَها إذ دَمعُ عَينَيك سَجَم",132,"م",1,0],["وَلِعَتْ بِمَنْطِقِهَا النُّفُوسُ غَرَابَةً","وَالنَّفْسُ مُولَعَةٌ بِكُلِّ غَرِيبِ",133,"ب",1,0],["وَلَعَمْرِي لَرِقَّةُ الطَّبْعِ أَوْلَى","مِنْ عِنادٍ يَجُرُّ حَرْبَ الْفَسَادِ",134,"د",1,0],["وَلَعَلَّ مَنْ أَعْقَبْتَ وَالآثَارُ قَدْ","وضَحَتْ لَهُ يَجْرِي عَلى الآثَارِ",135,"ر",1,0],["وَلَعَلَّ غَايَةَ كُلِّ طَالِبِ رِفْعَةٍ","إِرْضَاءُ ذَاتِ سلاَسِلٍ وَعُقودِ",136,"د",1,0],["وَلَعَلَّ أعْطَفَهُمْ عَلَيْهِمْ مَنْ دَنَا","بِالنَّفْعِ مِنْهُمْ وَهْوَ عَنْهُمْ نَاءِ",137,"ا",2,0],["وَلَعَلَّ حُرّاً لاَ يَدِينُ بِهِ انْبَرَى","لِيَذُودَ عَنْهُ خصْمَهُ المُتعَسِّفا",138,"ف",2,0],["وَلَعَلَّ السُّكُوتَ أَبلَغُ فِي الحَمْدِ","وَأَوْفَى وَفِيهِ فَصْلُ الخِطَابِ",139,"ب",1,0],["ولعلّ الهفوة الأخرى له","أنّه لَمْ يَعْتَدِلْ نَقْشاً وَحَفْرَا",140,"ر",2,0],["وَلَعَلَّ مُنْفَرِداً بِجِيدِكِ عَالِقاً","مُتَفَوِّقاً قَدْراً عَلَى النُّظَرَاءِ",141,"ا",2,0],["وَلَعَلَّ أَهْنَأَ رَاقِد","مَنْ لَمْ يُؤَرِّقْهُ الضمِيرْ",142,"ر",1,0],["وَلَعَلَّ فِي مَنْظومِهِ","آيَاتِهِ الْكُبَرَ السَّوَاحِرْ",143,"ر",1,0],["وَلعَبد الغنيّ يخلفُ لَو دا","مَ وَلكِن ما لِلنَجيب دَوامُ",144,"م",1,0],["وَلِعلَّةٍ ما زُرتهُ غِبّاً وَهَل","يَشفي غَليلي حَولَهُ التَعريسُ",145,"س",1,0],["ولعلَّ بلادَكَ لِي وطن","فأَحُطَّ الرَّحْلَ عن الأُجُدِ",146,"د",1,0],["وَلِعْتُ بها عُمْري وأكْبَرْتُ ربها","وإني بأخلاقِ الكرامِ لمُولَع",147,"ع",1,0],["ولعمري، ولو يبعثُ الدمعُ ميْتًا","لبكينا بدمع بنتِ الشريد",148,"د",1,0],["ولعجز النفوس عن درك الحق","وإيقافها وقوف افتضاح",149,"ح",1,0],["ولعمري لو اتقى الله في ال","اتَّقَتْهُ الأَنامُ في الإعْلان",150,"ن",1,0],["ولَعَنت ربَّ الشعر فيما اختار لي","وبما قَضى ، ولَعَنت أحكامَ القَضَا",151,"ض",2,0],["ولعلَّ احسنَ ما به من صالحٍ","عن شرِّ ما فيه يكونُ معوِّضا",151,"ض",2,0],["وَلِعَتْ بها عُشّاقها وبليةٌ","في الشرق إنْ وَلِعَتْ بها العشاق",152,"ق",1,0],["ولعلَّ منقولَ الكلامِ محوَّلٌ","في عالَمٍ آتٍ إلى مَعقوله",153,"ل",2,0],["وَلَعَمْرِي لَلْجُودُ للنّاسِ للنّا","سِ سِوَاهُ بالثّوْبِ وَالدّينَارِ",154,"ر",1,0],["وَلَعمري لقد نُصِرت بأن","عُوِّضتَ حَمْداً وجَنة ً ألفافا",155,"ف",2,0],["ولعمري لقد عميت عن الرشد","د وقصدِ المحجَّة المستقيم",156,"م",1,0],["ولعل الجمال في النفس منا","وبها للخفاء عنه ذهول",157,"ل",1,0],["وَلَعَمْري ماذا بِأَوّلِ ما عا","تني، يا ابنَ عمِّ، ثمّ غدرتا؟",158,"ت",2,0],["وَلعت بك الاحداث حتى اصبحت","ادواء خطبك ما لهن أساة",159,"ه",1,0],["ولعقنا حذاء شارون حتى","صاح ..مهلا..قطعتموني الحذاءُ",160,"ا",2,0],["وَلِعَيْنٍ تَبَادَرَ الدَّمْعُ مِنْها","لِكُلَيْبٍ إذْ فَاقَهَا بِانْهِمَالِ",161,"ل",1,0],["وَلَعَمْرِي لَقَدْ وَطِئْتُ بَنِي بَكْرَ","بما قدْ جنوهُ وطءَ النعالِ",161,"ل",1,0],["ولعلة ُ الحقّ الغضوضِ لها صدى ً","وَدَمْدَمَة ُ الحَربِ الضَّروسِ لَهَا فمُ",162,"م",1,0]]}