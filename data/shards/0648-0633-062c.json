{"poems":[[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[86,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[73,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[35,"تلهو فتختضع المطي أمامها","https://www.aldiwan.net/poem39141.html","الكامل"],[72,"لم يبق شيبي لذة لحياتي","https://www.aldiwan.net/poem18400.html","الكامل"],[72,"لا وعيش اللقاء ما لدموعي","https://www.aldiwan.net/poem19164.html","الخفيف"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[91,"ليت الذي خلق الحياة جميلة","https://www.aldiwan.net/poem62628.html","عموديه"],[43,"ترك مدحيك كالهجاء لنفسي","https://www.aldiwan.net/poem9589.html","الخفيف"],[62,"إن العيون إذا نطقت تخاوصت","https://www.aldiwan.net/poem52341.html","الكامل"],[61,"وجد الحب لي فؤادا علوقا","https://www.aldiwan.net/poem51502.html","الخفيف"],[61,"ألبرق سرى بأعلى البراق","https://www.aldiwan.net/poem51520.html","الخفيف"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"عثا في عرضه قوم سلاط","https://www.aldiwan.net/poem28860.html","الوافر"],[74,"طاف الظلام به فأسرج أدهما","https://www.aldiwan.net/poem13248.html","الكامل"],[105,"مكسويني كتبت للناس درسا","https://www.aldiwan.net/poem43079.html","الخفيف"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[46,"لا يغبطن ماش فوارس شزب","https://www.aldiwan.net/poem23253.html","الكامل"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39549","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54898","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[35,"تلهو فتختضعُ المطيُّ أمامها","https://www.poetsgate.com/ViewPoem.aspx?id=22035",""],[109,"من لإحتراق حشاشة الملهوف","https://www.aldiwan.net/poem16209.html","الكامل"],[124,"رويداً إنه العيد","https://www.aldiwan.net/poem23773.html","الرمل"],[129,"وقفت تعذبني بجاذب جسمها","https://www.aldiwan.net/poem67439.html","الكامل"],[135,"سري إلى الجنة دار النعيم","https://www.aldiwan.net/poem48881.html","السريع"],[197,"قبل فديتك مبسمي دع جيدي","https://www.aldiwan.net/poem39905.html","الكامل"],[199,"لك أن تشا وعلي أن لا أجزعا","https://www.aldiwan.net/poem45648.html","الكامل"],[204,"ريح شوق للبين كانت سموما","https://www.aldiwan.net/poem53185.html","الخفيف"],[229,"ما تقاضت منا ليالي الزمان","https://www.aldiwan.net/poem50777.html","الخفيف"],[262,"أدعوك بالرحم التي هي جمعت","https://www.aldiwan.net/poem68215.html","الكامل"],[271,"دمى طلل بين الطلول بحا جر","https://www.aldiwan.net/poem52110.html","الطويل"],[280,"كم توالت يا سعيد بن علي","https://www.aldiwan.net/poem60569.html","الطويل"],[297,"أما وابتسام الروض عن شنب الزهر","https://www.aldiwan.net/poem33260.html","الطويل"],[364,"كالغيث لكن ذاك من أمواهه","https://www.aldiwan.net/poem60672.html","الكامل"],[364,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[364,"بالكتب طرا كتاب خطه ملك","https://www.aldiwan.net/poem60873.html","البسيط"],[364,"فعلت هذه الجفون الضواري","https://www.aldiwan.net/poem60874.html","الخفيف"],[366,"أيا نازحا أفنى نواظرنا نزحا","https://www.aldiwan.net/poem17168.html","الطويل"],[366,"يا من إذا ولي البلاد فإنما","https://www.aldiwan.net/poem17204.html","الكامل"],[377,"تبا لمتورط في إثمه ورطا","https://www.aldiwan.net/poem59353.html","البسيط"],[416,"راق للأبصار حسنا وجمالا","https://www.aldiwan.net/poem53914.html","الرمل"],[432,"الحيا من غيوثك البارقات","https://www.aldiwan.net/poem12317.html","الخفيف"],[437,"ولى فأسرع في الفراق وما شفى","https://www.aldiwan.net/poem2558.html","الكامل"],[458,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[458,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[470,"أقوت رواوة من أسماء فالسند","https://www.aldiwan.net/poem4666.html","البسيط"],[479,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[493,"جاد ربعا حللته يا همام","https://www.aldiwan.net/poem67324.html","الخفيف"],[505,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[515,"مقامك من فضل وفصل خطاب","https://www.aldiwan.net/poem12011.html","الطويل"],[515,"فقت الملوك مهابة وجلالاً","https://www.aldiwan.net/poem12204.html","الكامل"],[551,"ما أرادت إلا الجفاء ظلوم","https://www.aldiwan.net/poem47245.html","الخفيف"],[551,"إنا نعلل كلنا بمحال","https://www.aldiwan.net/poem47297.html","الكامل"],[558,"تعلم حفظ آفات اللسان","https://www.aldiwan.net/poem33822.html","الوافر"],[567,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"]],"verses":[["وسَجيّةِ الإنسانِ ليسَ بناصِلٍ","منْ صِبْغِها حتّى يُرَى مرْموسا",0,"س",2,0],["وَسَجَّلَ حُكْمَ الْعَدْلِ بَيْنَ بِيُوتِهَا","وُقُوفاً مَعَ الْمَشْهُورِ مِنْ رَأْيِ يُونَانِ",1,"ن",1,0],["وَسَجايا لَهُنَّ في النَفسِ رَوحٌ","يَعدِلُ الفَوزَ وَالدُعاءَ المُجابا",2,"ب",2,0],["وَسَجايا كَأَنَّهُنَّ كُؤوسٌ","أَو رِياضٌ قَد جادَها صَوبُ قَطرِ",3,"ر",1,0],["وَسَجَت دَعائِمُ وَاِستَعجَلَت","مِن وَقعِهِنَّ بِصائِبٍ مُتَبادِرِ",4,"ر",1,0],["وسجعت مدحاً حين طوّقني ندىً","إنّ المطوّق ساجعُ النغمات",5,"ت",1,0],["وسجايا كالرَّوض تبسم كالزَّه","ر وبأس يبلي الظُّبا بالنجيع",6,"ع",1,0],["وَسَجينُ الخالِدَينِ اللَيل وَالصُبحِ المُبينِ","هَل أَنا في القَصرِ أَم في الكوخِ أَرقى لَستُ أَدري",7,"ي",1,0],["وَسَجَدتُ لِلإِلهامِ مَع صَفصافِها","وَضَحِكتُ لِلأَحلامِ مَع وَزّالِها",8,"ل",3,0],["وَسَجاياكَ مادِحاتُكَ لا لَف","ظي وُجودٌ عَلى كَلامي يُغيرُ",9,"ر",1,0],["وسجيَّةٌ مَيْثَاءُ يُعزَلُ عندَها","من بعدِ صولتها الشُّجاعُ الدارعُ",10,"ع",1,0],["وسجايا رَقَّتْ نَسيماً فراحَت","تُخْجِلُ الرَّاحَ والنَّسيمَ الرَّقيقا",11,"ق",2,0],["وسَجايا فَلَّتْ شَبا الدَّهْرِ بأساً","وعَطايا كُفِّلْنَ بالأَرْزاقِ",12,"ق",1,0],["وسجودٌ من نور وجهك طوعاً","ما أطالَ السجودَ وجهُ الظلامِ",13,"م",1,0],["وَسَجفَ العَنكَبُوتُ الغارَ مُحتَفِياً","بِخَيمَةٍ حاكَها مِن أَبدَعِ الخِيَمِ",14,"م",1,0],["وسجنُ الشيخِ لا يرضاهُ مثلي","ففيهِ لقدرٍ مثلكمُ انحطاطُ",15,"ط",1,0],["وَسَجَعتُ أَندُبُ لَوعَةً وَلَرُبَّما","صَدَحَ الحَمامُ يُجيبُني فَتَعَلَّما",16,"م",2,0],["وَسَجيناً لَم يطعَمِ القوتَ حَتّى","طَعمَ المَوتَ مِن أُكُفِّ سُقاتِهْ",17,"ت",2,0],["وسُجودَهُ حتى التقى عَفْرُ الثرى","وجَبينُهُ والنَّظْمُ والإكليل",18,"ل",1,0],["وَسِجِلُّ مَوتٍ راحَ يَكتُبُهُ الرَدى","لِمُساجِلٍ مِنّا وَغَيرِ مُساجِلِ",19,"ل",1,0],["وسَجايا محمّدٍ أعْجَزَتْ في الْ","وَصْفِ لُطْفَ الأفكارِ والأذهانِ",20,"ن",1,0],["وسجَّاهمُ باليمِّ زاخرُ موجهِ","وأنزَلهم منه فسيحَ المقابرِ",21,"ر",1,0],["وسجى بينهما الصمتُ الذي","يتغَشّى الأرضَ إن حان رداها",22,"ا",3,0],["وَسَجَايَا الرِّجَالِ رَانَتْ عَلَيْهَا","لُوثَةٌ مِنْ قَديمِ الاِسْتِعْبَادِ",23,"د",1,0],["وَسَجِيَّتِي رَعْيِ الذِّمَامِ لِمُجْمَلٍ","أَأَقَلَّ مِنْ إِجْمَالِهِ أَوْ أَكْثَرَا",24,"ر",2,0],["وَسجايا أهلِه أنْسامُه","كم نعِمْنا بِشذاها الطيب",25,"ب",1,0],["وسجتْ دعائمُ صلبِها واستعجلتْ","مِنْ وَقْعِهِنَّ بِصَائِبٍ مُتَبَادِرِ",26,"ر",1,0],["وَسَجية حَلفت بِأَنَّكَ لَم تَكُن","لِسوى المَعارف وَالنَدى بِحَليف",27,"ف",1,0],["وسجن بعده منفى","وتعذيب وتبعيد",28,"د",1,0],["وسَجَدتُ يَغمُرُني الخُشوعُ ولا مسَت","نفسي من الاسرار آخرَ تَخمِها",29,"م",3,0],["وسجل الأبرارُ تاريخَه","شعبانُ فيه مات عبدُ الكريمْ",30,"م",1,0],["وسجدتُ إجلالاً وتعظيماً لها","واستعبَرَت روحي وطال سجودي",31,"ي",1,0],["وسجعتَ في مصرٍ وملكُ الشعرِ في","مصرٍ إذا اشتقت العراقَ لتسجعا",32,"ع",2,0],["وسجاياك تقتضي نفسَك الجو","دَ كما يقتضي الغريمُ الغريما",33,"م",2,0],["وسَجايَا كالشَّهْد طَعْماً وخُبراً","مُشْبهات الإسرارِ بالإعلان",34,"ن",1,0],["وَسَجَدتُ حَتَّى جَبهَتي مَشجُوجَةٌ","مِمَّا يُناطِعُنِي الحَصَا في المَسجِدِ",35,"د",1,0],["وَسجدة أَجمال وَسجدة ظبية","وَحنة جذع من هشيم المنابر",36,"ر",1,0],["وَسَجايا لَوْ عَدَتْ أَخْلاقَهُ","لَمْ تَجِدْها فِي الْغَمامِ الْمُسْبِلِ",37,"ل",1,0],["وَسجعِ حمامِ الأيك في عَذَباتِها","تميسُ بها الأَغصانُ في حُلَلٍ خُضرِ",38,"ر",1,0],["وسِجالُه سُحْبُ النَّدى وعَطاؤه","كالوَدْقِ يَخْرُجُ من خِلالِ خِلاله",39,"ل",2,0],["وسَجيّتي قَصْدُ السّدادِ ولن تَرى","مُتطبِّعاً في الشَّيْءِ كالمَطْبوع",40,"ع",1,0],["وسَجدةُ النُّجحِ إن فَتَّشْتَ أكثرُ ما","تَجيءُ والمرءُ يَتْلو آيةَ الياس",41,"س",1,0],["وسجايا لو مسّتِ الماءَ باعوا","منه وَزْنَ القِطْميرِ بالدِّينار",42,"ر",1,0],["وَسَجعٌ هُوَ السَجعُ الحَمامِيُّ هَزَّنا","مَعاطِفَ أَغصانٍ فَدَت سَجعَكَ السَجحا",43,"ح",2,0],["وَسَجَرتَها ناراً فَقَد كانَت لِطو","فانِ العُداةِ لِحَينِهِم تَنّورا",44,"ر",2,0],["وسجَّل المارد الطاغي خطيَّتَه","ولاسمِِه من سجلِّ اللَه قد قشطا",45,"ط",2,0],["وسجاياه الَّتي في ذاته","بَزَغَتْ في أُفقِ المجد خلالا",46,"ل",2,0],["وسجايا من إِخوةٍ سادَةٍ غُرٍّ","وَقَعْنَا منها على أَخوات",47,"ت",1,0],["وسجيّتي حفظ الوداد له كما","أن الوفاء سجيّة لابي الوفا",48,"ف",2,0],["وسجايا تشرَب الصهباءَ منها","كلّما أرعشَ رأساً وعِظاما",49,"م",2,0],["وسجرتموني منصفين مودّةً","ورِفادةً يومَىْ رَخايَ وشدَّتي",50,"ي",1,0],["وَسُجَّدٌ كالحَماماتِ الجُثومِ بِهِ","وَمُلبِدٌ مِن رَمادِ القِدرِ مُلتَبِدُ",51,"د",1,0],["وسجين في الناس يرجو السراحا","وفقير لم يلق ماء قراحا",52,"ح",2,0],["وَسَجايا كَأَنَّها الرَوضُ إِلا","أَنَّها لِلعَدُوِّ مَوتٌ زُؤامُ",53,"م",1,0],["وسجنٍ دونَ قضبانٍ به من","سوى الأشبالِ والطيرِ الكواسرْ",54,"ر",1,0],["وسجلين يأوي الأمر والنهي منهما","إلى مشرب عذب وسوط عذاب",55,"ب",1,0],["وسجاحة ورجاحة وفصاحة","وصباحة وسماحة ونوالا",56,"ل",2,0],["وسجايا مَلَكْنَ كلَّ فؤادٍ","هنّ فيه عند الصَّميمِ صَميمُ",57,"م",1,0],["وسجيّةٌ للدّهر في أبنائِهِ","إِلحاقُ كلِّ مؤثَّلٍ بزوالِ",58,"ل",1,0],["وسجع والفصاحة مع سلام","على الذمِّيْ وذي فسقٍ مهان",59,"ن",1,0],["وَسَجِيحَةٌ لي في المَكا","رِمِ إنّ لي فِيها سَجِيْحَهْ",60,"ح",2,0]]}