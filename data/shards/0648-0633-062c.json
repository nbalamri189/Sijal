https://poetry.dctabudhabi.ae/diwan/poem/142466","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81727","الرمل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83183","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120415","الخفيف"],[4720,"أحبك يا تاج كل النساء","https://www.poetsgate.com/ViewPoem.aspx?id=69122",""],[4755,"صَيَّادُ البُرُوق","https://www.poetsgate.com/ViewPoem.aspx?id=199741",""],[4755,"مأساة سُهَيل اليَمَاني ( 1 )","https://www.poetsgate.com/ViewPoem.aspx?id=209084",""],[4815,"جَفَّ البيان","https://www.poetsgate.com/ViewPoem.aspx?id=210473",""],[4830,"ورديُّ الشفاه","https://www.poetsgate.com/ViewPoem.aspx?id=214992",""],[4578,"عوذ سنا بدري بأي المثانِ","https://www.poetsgate.com/ViewPoem.aspx?id=49597",""],[4984,"عرَّى بريد الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=215655",""],[5000,"كلّ ما قيل عن العشق هنا!!.","https://www.poetsgate.com/ViewPoem.aspx?id=7182",""],[5060,"للشعر أنثى!","https://www.poetsgate.com/ViewPoem.aspx?id=214494",""],[5074,"هذهِ قِصَّتي","https://www.poetsgate.com/ViewPoem.aspx?id=153510",""],[5092,"إلى الفاتنة","https://www.poetsgate.com/ViewPoem.aspx?id=139721",""],[5273,"حب جديد","https://www.poetsgate.com/ViewPoem.aspx?id=28767",""],[5273,"ليلة الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=215885",""],[5277,"الحسيبة","https://www.poetsgate.com/ViewPoem.aspx?id=185418",""],[5376,"عادت قريشُ لتعبدَ الصنما","https://www.poetsgate.com/ViewPoem.aspx?id=194868",""],[5431,"لو أن لي...","https://www.poetsgate.com/ViewPoem.aspx?id=192197",""],[5431,"نحن موتى وإنهم أحياء..","https://www.poetsgate.com/ViewPoem.aspx?id=202730",""],[5442,"اشرفت في السواد ذات الثور","https://www.poetsgate.com/ViewPoem.aspx?id=114768",""],[5455,"الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=213959",""],[5653,"سل البانة الغيناء عن ملعب الجردِ","https://www.poetsgate.com/ViewPoem.aspx?id=26397",""],[5689,"أظل خيالي أم ضرام جهنم","https://www.poetsgate.com/ViewPoem.aspx?id=143403",""],[5704,"رُجُوع","https://www.poetsgate.com/ViewPoem.aspx?id=191319",""],[5725,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=210206",""],[5790,"تملكت من سيد أصيدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=111889",""],[5916,"َلْبَسْتَنِيْ قَيْدَ الْهَوَى","https://www.poetsgate.com/ViewPoem.aspx?id=190589",""]],"verses":[["وسَجيّةِ الإنسانِ ليسَ بناصِلٍ","منْ صِبْغِها حتّى يُرَى مرْموسا",0,"س",2,0],["وَسَجَّلَ حُكْمَ الْعَدْلِ بَيْنَ بِيُوتِهَا","وُقُوفاً مَعَ الْمَشْهُورِ مِنْ رَأْيِ يُونَانِ",1,"ن",1,0],["وَسَجايا لَهُنَّ في النَفسِ رَوحٌ","يَعدِلُ الفَوزَ وَالدُعاءَ المُجابا",2,"ب",2,0],["وَسَجايا كَأَنَّهُنَّ كُؤوسٌ","أَو رِياضٌ قَد جادَها صَوبُ قَطرِ",3,"ر",1,0],["وَسَجَت دَعائِمُ وَاِستَعجَلَت","مِن وَقعِهِنَّ بِصائِبٍ مُتَبادِرِ",4,"ر",1,0],["وسجعت مدحاً حين طوّقني ندىً","إنّ المطوّق ساجعُ النغمات",5,"ت",1,0],["وسجايا كالرَّوض تبسم كالزَّه","ر وبأس يبلي الظُّبا بالنجيع",6,"ع",1,0],["وَسَجينُ الخالِدَينِ اللَيل وَالصُبحِ المُبينِ","هَل أَنا في القَصرِ أَم في الكوخِ أَرقى لَستُ أَدري",7,"ي",1,0],["وَسَجَدتُ لِلإِلهامِ مَع صَفصافِها","وَضَحِكتُ لِلأَحلامِ مَع وَزّالِها",8,"ل",3,0],["وَسَجاياكَ مادِحاتُكَ لا لَف","ظي وُجودٌ عَلى كَلامي يُغيرُ",9,"ر",1,0],["وسجيَّةٌ مَيْثَاءُ يُعزَلُ عندَها","من بعدِ صولتها الشُّجاعُ الدارعُ",10,"ع",1,0],["وسجايا رَقَّتْ نَسيماً فراحَت","تُخْجِلُ الرَّاحَ والنَّسيمَ الرَّقيقا",11,"ق",2,0],["وسَجايا فَلَّتْ شَبا الدَّهْرِ بأساً","وعَطايا كُفِّلْنَ بالأَرْزاقِ",12,"ق",1,0],["وسجودٌ من نور وجهك طوعاً","ما أطالَ السجودَ وجهُ الظلامِ",13,"م",1,0],["وَسَجفَ العَنكَبُوتُ الغارَ مُحتَفِياً","بِخَيمَةٍ حاكَها مِن أَبدَعِ الخِيَمِ",14,"م",1,0],["وسجنُ الشيخِ لا يرضاهُ مثلي","ففيهِ لقدرٍ مثلكمُ انحطاطُ",15,"ط",1,0],["وَسَجَعتُ أَندُبُ لَوعَةً وَلَرُبَّما","صَدَحَ الحَمامُ يُجيبُني فَتَعَلَّما",16,"م",2,0],["وَسَجيناً لَم يطعَمِ القوتَ حَتّى","طَعمَ المَوتَ مِن أُكُفِّ سُقاتِهْ",17,"ت",2,0],["وسُجودَهُ حتى التقى عَفْرُ الثرى","وجَبينُهُ والنَّظْمُ والإكليل",18,"ل",1,0],["وَسِجِلُّ مَوتٍ راحَ يَكتُبُهُ الرَدى","لِمُساجِلٍ مِنّا وَغَيرِ مُساجِلِ",19,"ل",1,0],["وسَجايا محمّدٍ أعْجَزَتْ في الْ","وَصْفِ لُطْفَ الأفكارِ والأذهانِ",20,"ن",1,0],["وسجَّاهمُ باليمِّ زاخرُ موجهِ","وأنزَلهم منه فسيحَ المقابرِ",21,"ر",1,0],["وسجى بينهما الصمتُ الذي","يتغَشّى الأرضَ إن حان رداها",22,"ا",3,0],["وَسَجَايَا الرِّجَالِ رَانَتْ عَلَيْهَا","لُوثَةٌ مِنْ قَديمِ الاِسْتِعْبَادِ",23,"د",1,0],["وَسَجِيَّتِي رَعْيِ الذِّمَامِ لِمُجْمَلٍ","أَأَقَلَّ مِنْ إِجْمَالِهِ أَوْ أَكْثَرَا",24,"ر",2,0],["وَسجايا أهلِه أنْسامُه","كم نعِمْنا بِشذاها الطيب",25,"ب",1,0],["وسجتْ دعائمُ صلبِها واستعجلتْ","مِنْ وَقْعِهِنَّ بِصَائِبٍ مُتَبَادِرِ",26,"ر",1,0],["وَسَجية حَلفت بِأَنَّكَ لَم تَكُن","لِسوى المَعارف وَالنَدى بِحَليف",27,"ف",1,0],["وسجن بعده منفى","وتعذيب وتبعيد",28,"د",1,0],["وسَجَدتُ يَغمُرُني الخُشوعُ ولا مسَت","نفسي من الاسرار آخرَ تَخمِها",29,"م",3,0],["وسجل الأبرارُ تاريخَه","شعبانُ فيه مات عبدُ الكريمْ",30,"م",1,0],["وسجدتُ إجلالاً وتعظيماً لها","واستعبَرَت روحي وطال سجودي",31,"د",2,0],["وسجعتَ في مصرٍ وملكُ الشعرِ في","مصرٍ إذا اشتقت العراقَ لتسجعا",32,"ع",2,0],["وسجاياك تقتضي نفسَك الجو","دَ كما يقتضي الغريمُ الغريما",33,"م",2,0],["وسَجايَا كالشَّهْد طَعْماً وخُبراً","مُشْبهات الإسرارِ بالإعلان",34,"ن",1,0],["وَسَجَدتُ حَتَّى جَبهَتي مَشجُوجَةٌ","مِمَّا يُناطِعُنِي الحَصَا في المَسجِدِ",35,"د",1,0],["وَسجدة أَجمال وَسجدة ظبية","وَحنة جذع من هشيم المنابر",36,"ر",1,0],["وَسَجايا لَوْ عَدَتْ أَخْلاقَهُ","لَمْ تَجِدْها فِي الْغَمامِ الْمُسْبِلِ",37,"ل",1,0],["وَسجعِ حمامِ الأيك في عَذَباتِها","تميسُ بها الأَغصانُ في حُلَلٍ خُضرِ",38,"ر",1,0],["وسِجالُه سُحْبُ النَّدى وعَطاؤه","كالوَدْقِ يَخْرُجُ من خِلالِ خِلاله",39,"ل",2,0],["وسَجيّتي قَصْدُ السّدادِ ولن تَرى","مُتطبِّعاً في الشَّيْءِ كالمَطْبوع",40,"ع",1,0],["وسَجدةُ النُّجحِ إن فَتَّشْتَ أكثرُ ما","تَجيءُ والمرءُ يَتْلو آيةَ الياس",41,"س",1,0],["وسجايا لو مسّتِ الماءَ باعوا","منه وَزْنَ القِطْميرِ بالدِّينار",42,"ر",1,0],["وَسَجعٌ هُوَ السَجعُ الحَمامِيُّ هَزَّنا","مَعاطِفَ أَغصانٍ فَدَت سَجعَكَ السَجحا",43,"ح",2,0],["وَسَجَرتَها ناراً فَقَد كانَت لِطو","فانِ العُداةِ لِحَينِهِم تَنّورا",44,"ر",2,0],["وسجَّل المارد الطاغي خطيَّتَه","ولاسمِِه من سجلِّ اللَه قد قشطا",45,"ط",2,0],["وسجاياه الَّتي في ذاته","بَزَغَتْ في أُفقِ المجد خلالا",46,"ل",2,0],["وسجايا من إِخوةٍ سادَةٍ غُرٍّ","وَقَعْنَا منها على أَخوات",47,"ت",1,0],["وسجيّتي حفظ الوداد له كما","أن الوفاء سجيّة لابي الوفا",48,"ف",2,0],["وسجايا تشرَب الصهباءَ منها","كلّما أرعشَ رأساً وعِظاما",49,"م",2,0],["وسجرتموني منصفين مودّةً","ورِفادةً يومَىْ رَخايَ وشدَّتي",50,"ي",1,0],["وَسُجَّدٌ كالحَماماتِ الجُثومِ بِهِ","وَمُلبِدٌ مِن رَمادِ القِدرِ مُلتَبِدُ",51,"د",1,0],["وسجين في الناس يرجو السراحا","وفقير لم يلق ماء قراحا",52,"ح",2,0],["وَسَجايا كَأَنَّها الرَوضُ إِلا","أَنَّها لِلعَدُوِّ مَوتٌ زُؤامُ",53,"م",1,0],["وسجنٍ دونَ قضبانٍ به من","سوى الأشبالِ والطيرِ الكواسرْ",54,"ر",1,0],["وسجلين يأوي الأمر والنهي منهما","إلى مشرب عذب وسوط عذاب",55,"ب",1,0],["وسجاحة ورجاحة وفصاحة","وصباحة وسماحة ونوالا",56,"ل",2,0],["وسجايا مَلَكْنَ كلَّ فؤادٍ","هنّ فيه عند الصَّميمِ صَميمُ",57,"م",1,0],["وسجيّةٌ للدّهر في أبنائِهِ","إِلحاقُ كلِّ مؤثَّلٍ بزوالِ",58,"ل",1,0],["وسجع والفصاحة مع سلام","على الذمِّيْ وذي فسقٍ مهان",59,"ن",1,0],["وَسَجِيحَةٌ لي في المَكا","رِمِ إنّ لي فِيها سَجِيْحَهْ",60,"ح",2,0],["وسَجْسَجَ ذاكَ الظِّلِّ عن مُلْهِبِ الحَشَا","وسَلْسَلَ ذاكَ الماءِ عن مُضْرِمِ الوَجْدِ",61,"د",1,0],["وسجالٍ من راحتيك كفى الأر","ضَ سجالَ المُجَلْجِلِ الرجَّاس",62,"س",1,0],["وَسَجايا شَريفَة لا تُضاهَى","هِيَ في ذا الإِمامِ فَرد الزّمانِ",63,"ن",1,0],["وَسَجايا كَريمة وَكمَال","وَجَمال بِهيبة مُزدانِ",64,"ن",1,0],["وسجايا متى ادعاها سواه","كذبته الأفعال والأقوال",65,"ل",1,0],["وسجادة الصوفي بيت سكونه","ولا وكر إلا أن يطير عن الوكر",66,"ر",1,0],["وَسَجَّلَ الحُكمَ فيهِ شاهِدانِ لَهُ","وَردُ الخُدودِ وَبَردُ الثَغرِ وَالشَنَبِ",67,"ب",1,0],["وسجادةٍ خضراء للزهدِ والتقى","وللدين فيها والصلاح توسم",68,"م",1,1],["وسجعُ الحمائِمُ فوق الغصون","يجاوبهنَّ لسانُ الوتَرْ",69,"ر",1,0],["وسجايا كأنَّهُنَّ لدى النش","رِ رضابُ الحيا بأريٍ مشورِ",70,"ر",1,0],["وسَجايا عَتكيّاتٌ له","كنسيم الوَرد في بَرْدِ السَّحرْ",71,"ر",1,0],["وسجايا تنفَّس الروضُ منها","عن نسيمٍ تُظلُّه الأنداء",72,"ا",2,0],["وسجاياً كالروضِ باكرَه الطلُّ","نسيمُ الصَبا عليه يمرُّ",73,"ر",1,0],["وسجية طبعت على حب العلى","لم ترض غير الفرقدين جنابا",74,"ب",2,0],["وسجايا تنبيك عن عنصر الطيب","وطيب الآباء بالتدقيق",75,"ق",1,0],["وسجايا بلطفها يتحلى","محتدٌ باذخ وجاه رفيع",76,"ع",1,0],["وَسَجينٍ مِنَ القُيودِ طَليقٍ","وَطَليقٍ مِنَ القُيودِ سَجينِ",77,"ن",1,0],["وسجيَّةُ الأيّام ستر فضائلي","عن عَينِ رامقِها وبثّ مثالبي",78,"ب",2,0],["وسجاياهم كلها ساحراتٌ","وبياني لها بديع المعاني",79,"ن",2,0],["وسجاياك يا أبا الحسن الغرُّ","وأتعابهن شكرُ الشكور",80,"ر",1,0],["وسجايا إذا بدت في ظلام","ما علينا أن يحجب الليل بدره",81,"ر",2,0],["وَسَجِيَّةٌ في الجودِ ما حُمِدَ الحَيا","حَتّى تَعَلَّمَ خَطرَةَ مِن بَذلِها",82,"ل",3,0],["وَسَجِيَّةٍ في الغَدرِ كُنتُ أَعيبُها","حَتّى عَرَفتُ بِها الصَّديقَ الأَكبَرا",83,"ر",2,0],["وَسجَّر النار في قَلبي وَحل بِها","إِن المُشعشع نار لَيسَ تُؤذيه",84,"ي",2,0],["وسجيتي حفظ العهود ولو بها","صيرت ابناء الزمان خصومي",85,"م",2,0],["وسجال كفٍّ قد جعلت لبطنها","وفر الندى ولظهرها التقبيلا",86,"ل",2,0],["وسجيةٌ نبويةٌ ومزيةٌ","علويةٌ وحميةٌ وإناء",87,"ا",2,0],["وسجدةُ وجهي فوق صدرك ِعندما","تخذْتُ به يا ربة الحسن محرابا",88,"ب",2,0],["وَسجية في العالمين سخية","آمالها نجزت بِغَير تسوفِ",89,"ف",1,0],["وسجدة حمٍ وحرمة فضلها","وحم عسق فخر الى فحر",90,"ر",1,0],["وسجادة محبوبة لي حق أن","أعانقها بالراحتين وألثما",91,"م",2,1],["وَسَجَايا كالماءِ رقَّ على الصَّخْ","رِ وَرَقَّتْ عليهِ ريحُ الشَّمَالِ",92,"ل",1,0],["وسجوده للشكر غشيته وعن","تعفير خديه التقلب أبدلا",93,"ل",2,0],["وسجايا تخال من سلسل الماء","وإلا فهن خمر عتيق",94,"ق",1,0],["وسجيّة محمودة دلّت على","كرم الأصول وحسن طيب العنصر",95,"ر",1,0],["وَسَجاياكِ حُلِيٌّ","بِتَراقيهِ عَليقَه",96,"ق",2,0],["وَسجيةٍ رقّت كما رقّ الصبا","وَشمائلٍ أَشهى من التسنيم",97,"م",1,0],["وسجن أعاف وجودي به","أليس كفيلًا ببعض الوجود",98,"د",1,0],["وسجين ثم مُدَّخَر","لرجاء غير مدخرِ",99,"ر",1,0],["وَسَجَّعَت رَجعَ عودٍ بَينَ أَربَعَةٍ","سِرُّ الضَمائِرِ فيما بَينَها عَلَنُ",100,"ن"