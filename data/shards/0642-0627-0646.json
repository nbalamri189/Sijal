{"poems":[[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54317","الرمل"],[124,"إن الزمان ولا أقول زماني","https://www.aldiwan.net/poem23705.html","الكامل"],[185,"بمنازل الفسطاط حل فؤادي","https://www.aldiwan.net/poem14145.html","الكامل"],[225,"لو أن أطلال المنازل تنطق","https://www.aldiwan.net/poem55213.html","الكامل"],[267,"فإن تك حربكم أمست عواناً","https://www.aldiwan.net/poem1143.html",""],[305,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[328,"كذبت هند حين قالت لك القل","https://www.aldiwan.net/poem54941.html","الخفيف"],[328,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[377,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[514,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"]],"verses":[["قَانِتٌ لاَ يَلَذَّهُ الْعَيْشُ مَا لَمْ","يُدْنِهِ مِنْ مَرَامِهِ المَنْشُودِ",0,"د",1,0],["قانتٌ للّه في محرابِهِ","لم يَشُبْ آمالَه في اللّه رَيْنْ",1,"ن",1,0],["قانون هوبر حال بعض جريضه","دون القريض ودون كل بيان",2,"ن",1,0],["قانِي المَسيلِ كأنَّ فيضَ غُروبِه","فوقَ الخدود عُصارة الفِرْصاد",3,"د",1,0],["قانونُ دِنشاوايَ ذاك صحيفةٌ","تُتلى فترتاعُ القلوب وَتَخفِق",4,"ق",1,0],["قاني غيرُ خاذلكم ولكن","سأسعى الآن إذ بلغت مداها",5,"ا",3,0],["قانونُ عدلٍ صادقٍ عالٍ سَمت","آساهُه رَجباً على آسانِ",6,"ن",1,0],["قانعاً بالذي تحبين منى","سابحاً في وجودك الرباني",7,"ي",1,0],["قانع النفس مطمئن الحنايا","قدسي الرضا قرير الرغاب",8,"ب",1,0],["قانعاً بالبُرِّ","في هدو السبسب",9,"ب",1,0],["قاني الصّوارمِ مُسودُّ الملاحمِ مُبْ","يَضُّ المَكارمِ مخضَرُّ الندى الخَضلِ",10,"ل",1,0]]}