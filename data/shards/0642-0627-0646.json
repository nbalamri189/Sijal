{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54317","الرمل"],[128,"إن الزمان ولا أقول زماني","https://www.aldiwan.net/poem23705.html","الكامل"],[189,"بمنازل الفسطاط حل فؤادي","https://www.aldiwan.net/poem14145.html","الكامل"],[230,"لو أن أطلال المنازل تنطق","https://www.aldiwan.net/poem55213.html","الكامل"],[272,"فإن تك حربكم أمست عواناً","https://www.aldiwan.net/poem1143.html",""],[310,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[333,"كذبت هند حين قالت لك القل","https://www.aldiwan.net/poem54941.html","الخفيف"],[333,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[382,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[519,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122798","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103065","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38764","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145790","الكامل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101993","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144037","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128702","الرمل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77821","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100960","الرمل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101065","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94092","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94197","السريع"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205843","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205045","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115419","البسيط"],[3154,"","https://poetry.dctabudhabi.ae/diwan/poem/138930",""],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103917","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91350","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36790","الرمل"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130560","السريع"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105107","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73103","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72351","الخفيف"],[4843,"مسبّحٌ من لهُ في الخلقِ آياتُ","https://www.poetsgate.com/ViewPoem.aspx?id=142689",""],[4927,"ارحل يا بلطجي","https://www.poetsgate.com/ViewPoem.aspx?id=79604",""],[5170,"ضايق الصدر","https://www.poetsgate.com/ViewPoem.aspx?id=175541",""],[5277,"وشمُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=185674",""],[5409,"خرج العاهل للصي","https://www.poetsgate.com/ViewPoem.aspx?id=155367",""],[5455,"الدلوعه","https://www.poetsgate.com/ViewPoem.aspx?id=35554",""],[5464,"قانا","https://www.poetsgate.com/ViewPoem.aspx?id=8311",""],[5690,"قانون عدل بنو عثمان نسبتهُ","https://www.poetsgate.com/ViewPoem.aspx?id=172217",""],[5694,"احذر من الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=132101",""],[469,"جزتَ في المجد والفعال الشريفِ","https://www.poetsgate.com/ViewPoem.aspx?id=76859",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[5980,"قانون عدلك لم يبرح يذكرنا","https://www.poetsgate.com/ViewPoem.aspx?id=146261",""],[6069,"ومضرج الوجنات تحسبها","https://www.poetsgate.com/ViewPoem.aspx?id=105649",""],[6070,"بكيتُ حتى سَكَبْتُ الحِبْرَ مِنْ قلمي","https://www.poetsgate.com/ViewPoem.aspx?id=197536",""]],"verses":[["قَانِتٌ لاَ يَلَذَّهُ الْعَيْشُ مَا لَمْ","يُدْنِهِ مِنْ مَرَامِهِ المَنْشُودِ",0,"د",1,0],["قانتٌ للّه في محرابِهِ","لم يَشُبْ آمالَه في اللّه رَيْنْ",1,"ن",1,0],["قانون هوبر حال بعض جريضه","دون القريض ودون كل بيان",2,"ن",1,0],["قانِي المَسيلِ كأنَّ فيضَ غُروبِه","فوقَ الخدود عُصارة الفِرْصاد",3,"د",1,0],["قانونُ دِنشاوايَ ذاك صحيفةٌ","تُتلى فترتاعُ القلوب وَتَخفِق",4,"ق",1,0],["قاني غيرُ خاذلكم ولكن","سأسعى الآن إذ بلغت مداها",5,"ا",3,0],["قانونُ عدلٍ صادقٍ عالٍ سَمت","آساهُه رَجباً على آسانِ",6,"ن",1,0],["قانعاً بالذي تحبين منى","سابحاً في وجودك الرباني",7,"ن",2,0],["قانع النفس مطمئن الحنايا","قدسي الرضا قرير الرغاب",8,"ب",1,0],["قانعاً بالبُرِّ","في هدو السبسب",9,"ب",1,0],["قاني الصّوارمِ مُسودُّ الملاحمِ مُبْ","يَضُّ المَكارمِ مخضَرُّ الندى الخَضلِ",10,"ل",1,0],["قانِ المُدامَ بِكَأسِ الشّادِنِ الغَنِنِ","واشرَب عَلَى وَردِ خَدَّي وَجهِهِ الحَسَنِ",11,"ن",1,1],["قانونه في أقانيهم يقوم به","قيوم روح حياة العلم فاعتمد",12,"د",1,0],["قاني الخُدودِ تَضَرَّجت بِمَحاسِنٍ","ماءُ المَحاسِنِ سالَ مِنها عَندما",13,"م",2,0],["قانونُ دَولَتِكَ الرَّشيدةِ أدرَدٌ","قرَضَتْ بهِ فِئرَانُكَ الأوتارا",14,"ر",2,0],["قاني الخدود إذا لامست عارضه","ورى بكفك حتى كاد يشتعل",15,"ل",1,0],["قانٍ كخدِّك بين ريْ","حانٍ كعارضِك المسَطّرْ",16,"ر",1,0],["قانتاً للّه شكرا لم يزل","في صلاة وسلام دائمي",17,"ي",1,0],["قانونكم في حجر قينة حبكم","تبدي علينا ذكركم وَتعيد",18,"د",1,0],["قانئاً خطّ على وجنتها","قاتل اللَه الهوى ما أصعبا",19,"ب",2,0],["قانونه القرآن في أحكامه","يرضي بها القرآن والقانونا",20,"ن",2,0],["قاني الخدود زها ريحان عارضه","وحف بالآس منه ورده الجوري",21,"ر",2,1],["قإن رضوان لتاريخه","سكنه فردوس خلد الجنان",22,"ن",1,0],["قانعاً باليسير تحرم نفساً","متّعب في صباك بالعيش نضرا",23,"ر",2,0],["قانعاً بالعظام عن أكل لحمٍ","راضياً عن فراشه بالتراب",24,"ب",1,0],["قانعاً أن يشم ريح أناس","تخذوه لهم من الحجاب",24,"ب",1,0],["قانونهُ المرتضى نجاة","وكلُّ شاراته شفاءُ",25,"ا",2,0],["قانعا بالرجا وحلم الأماني","عائشا بين علها وعساها",26,"ا",3,0],["قانص الفرصة واعلم أنها","كمضي البرق تمضي الفرص",27,"ص",1,1],["قانونُها حاكمٌ في عقلِ شاربِها","وَنشرُها طَيِّبٌ للشرب مَنشور",28,"ر",1,0],["قانِتٌ لِلّهِ فيهِ خِشيَةٌ","يَقطَعُ اللَيلَ قِياماً وَرُكوعا",29,"ع",2,0],["قانية الخدين من لي بأن","يوضح لي عن خدها القاني",30,"ن",2,0],["قاني الخدود كأنما بكؤوسه","من حمرة فيها الخدود تشرّب",31,"ب",1,0],["قانِصَةٌ لِكُلِّ لَيثِ مُخدرٍ","بِطَرفِها مِن خَلفِ سَجفِ خِدرِها",32,"ر",3,0],["قان بالتوراة والانجيل","هل أتى في سواه بالذكر تملى",33,"ل",2,0],["قانونهُ شهدٌ عدلٌ لحكمته","تجدّدت عنهُ في الغربِ النظاماتُ",34,"ت",1,0],["قَانُوْنُهَاْ وَشِعَاْرُهَاْ:","سَفَّاْحُنَاْ لِصٌّ نَشَلْ",35,"ل",1,0],["قانعٍ بالقليله ، قبل راسه يشيب","والقليله بصدره ، شيبت بشعره",36,"ر",2,0],["قانونُ قلبي أنَّ عشقي للتي","أهوى يسنُّ بأنبلِ الأعرافِ",37,"ف",1,0],["قانصاً تشرف عينا","ه على عينٍ رَوِيَّه",38,"ي",2,0],["قانع في حكمة الله ماشي في طوعه","ماحسبت حساب دنيا ناسها طرقيه",39,"ي",2,0],["قانا وهل من نخوةٍ وجموعُنا","يمشي على أضلاعِها \"أفرادُ\"؟",40,"د",1,0],["قانون عدل بنو عثمان نسبتهُ","قد جاء للعصر عدلاً طوق إحسانِ",41,"ن",1,1],["قانونها يغلب جميع القوانين","وهقواتها تغلب جميع الهقاوي",42,"ا",3,0],["قانصٌ عزمهُ لما أرتجيهِ","فشؤوني خفيفة التكليف",43,"ف",1,0],["قانون (لافْوزْييهِ) منطبقٌ على","سعدي يحوّله إلى آلامِ",44,"م",1,0],["قانون عدلك لم يبرح يذكرنا","من الجميل لكم آثار إيسار",45,"ر",1,1],["قانٍ يروقك حسن منظره","فكأنما يسقى دم المهج",46,"ج",1,0],["قانونهُ الهدَمُ والتدميرُ في بَلَدٍ","قدْ كانَ للدِّينِ والدُّنيا كما الحَرَمِ",47,"م",1,0]]}