{"poems":[[79,"فعل الخاطر المصدق فعلا","https://www.aldiwan.net/poem36091.html","الخفيف"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[39,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[39,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[382,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[520,"نبهتني حمامة بسحير","https://www.aldiwan.net/poem12292.html","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66737","البسيط"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/132457","الرمل"],[848,"","https://poetry.dctabudhabi.ae/diwan/poem/49899","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77606","الرجز"],[1084,"","https://poetry.dctabudhabi.ae/diwan/poem/119065","السريع"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56287","الخفيف"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21637","الخفيف"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88924","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138518",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138561",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131201",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76458","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90807","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52131","الرمل"],[5038,"الطاغوت","https://www.poetsgate.com/ViewPoem.aspx?id=190091",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5906,"في الحكمة / الصبر .... واصبر","https://www.poetsgate.com/ViewPoem.aspx?id=193745",""],[6142,"حشدوا كل واحدٍ من قبيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155696",""]],"verses":[["إِذْ دَعَانِي لِكَتْبِ شَيْءٍ تَعَاطَى","غَيْرُهُ مِنِّيَ الْبَنَانُ وَرَامَهْ",0,"م",2,0],["إِذ دَعَتني عامِرٌ أَنصُرُها","فَاِلتَقى الأَلسُنُ كَالنَبلِ الدُوَل",1,"ل",1,0],["إِذ دُونَه للمُرَشَّحِين ذوي ال","غُلَّةِ مِمَّن يَرُومُه لَغَبُ",2,"ب",1,0],["اذ دونه للمرشحين ذوي المسفلّة","ممن يرومه تعب",3,"ب",1,0],["إذ دعا وَحْدَهُ العبادَ وَأَمْسَتْ","مِنه في كلِّ مُقلَةٍ أَقْذاءُ",4,"ا",2,0],["إذ دونَها كابدتُ كلَّ مشقةٍ","حتى الصليبَ فلا تني بوفائي",5,"ي",1,0],["إذ دهتني فيه خطوب الليالي","ورمتني عن قوسها المرنان",6,"ن",1,0],["إذ دعا شبّراً شُبير فقال ال","طُهر للطاهراتِ والأطهارِ",7,"ر",1,0],["إذ دعا الندمان طيباً سقِّني","فضلَة الكأس فقد طال العطش",8,"ش",1,1],["إذ دَخَلوا القرى وأفسدوها","آذوا ومزقوا وَشردوها",9,"ه",2,0],["إِذ دَخَل السَيد رَب المَنزلِ","كَأَنَّهُ يَعلمُ أَمر الأَيِّلِ",10,"ل",1,0],["إذ دنت بيضاء مكروهة","مني نأت بيضاء محبوبه",11,"ه",1,0],["إذ دعوت استجاب لي رب بري","عند حزني فرجت لي ضيق صدري",12,"ر",2,1],["إِذ دَعانا زَوالُهُ فَأَجَبنا","كُلُّ دُنيا وَنِعمَةٍ لِزَوالِ",13,"ل",1,0],["إذ دولة العشاق كانت قبلا","واحدةً فاختلفوا ولولا",14,"ل",2,0],["إذ دعاني لبيته وهو بيتٌ","عامرٌ دونه مطال السحاب",15,"ب",1,0],["إذ دعاهم للقا الأعدا وهم","في رجاء النصر ان ينشر لواه",16,"ا",2,0],["إذ دخلوا الدار ولم يتركوا","بغياً أذاها علنا أو سرار",17,"ر",1,0],["اذ دار بينكم الحديث كأنه","زهر الرياض همى عليه غمام",18,"م",1,0],["إذ دَهَتهُم مَذَلَّةٌ وَصَغَارُ","أخرَجُوهُ مِنهَا وآوَاهُ غَارُ",19,"ر",1,0],["اذ دون قصد وَيا لِلَّه مِن بصري","حركت كامن ما في القَلب فاِختَلجا",20,"ج",2,0],["إذ دعاها للهنا الداعي وكم","من عسير بعده جاء يسير",21,"ر",1,0],["إذ دعاه قولها للإنتباهْ","كلُّ هذا سيدي مني اشتراهْ",22,"ه",1,0],["إذْ داعشُ التّكْفيرِ جاءَتْ تبْتَغي","هَدْمَ الْهُدى والْعقْلِ والْمَلَكوتِ",23,"ت",1,0],["إذْ دَعَا الْهَادِي عَشِيرَتَهُ","قَارَبُوا الْخَمْسِينَ فِي الْعَدَدِ",24,"د",1,0],["إذ دكَّهُ الوَدَقُ المُقعقَعُ رَيثَما","هَجَرَ البُطونَ ليَعْتَلي بَطحاها",25,"ا",3,0],["إذ دوام الأمرين يفضي إلى الجب","رِ على الشرك أو على التوحيد",26,"د",1,0]]}