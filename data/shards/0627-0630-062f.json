{"poems":[[77,"فعل الخاطر المصدق فعلا","https://www.aldiwan.net/poem36091.html","الخفيف"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[37,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[374,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[513,"نبهتني حمامة بسحير","https://www.aldiwan.net/poem12292.html","الخفيف"]],"verses":[["إِذْ دَعَانِي لِكَتْبِ شَيْءٍ تَعَاطَى","غَيْرُهُ مِنِّيَ الْبَنَانُ وَرَامَهْ",0,"م",2,0],["إِذ دَعَتني عامِرٌ أَنصُرُها","فَاِلتَقى الأَلسُنُ كَالنَبلِ الدُوَل",1,"ل",1,0],["إِذ دُونَه للمُرَشَّحِين ذوي ال","غُلَّةِ مِمَّن يَرُومُه لَغَبُ",2,"ب",1,0],["اذ دونه للمرشحين ذوي المسفلّة","ممن يرومه تعب",3,"ب",1,0],["إذ دعا وَحْدَهُ العبادَ وَأَمْسَتْ","مِنه في كلِّ مُقلَةٍ أَقْذاءُ",4,"ا",2,0],["إذ دونَها كابدتُ كلَّ مشقةٍ","حتى الصليبَ فلا تني بوفائي",5,"ي",1,0],["إذ دهتني فيه خطوب الليالي","ورمتني عن قوسها المرنان",6,"ن",1,0]]}