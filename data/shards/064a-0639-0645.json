{"poems":[[65,"خليلي إن ألوى بي الفقر لم أبل","https://www.aldiwan.net/poem45884.html","الطويل"],[29,"عفا النسران بعدك والوحيد","https://www.aldiwan.net/poem5726.html","الوافر"],[53,"يا عجبا من خالد في صبره وجلده","https://www.aldiwan.net/poem9997.html","مجزوء الرجز"],[31,"خليلي قوما للرحيل فإنني","https://www.aldiwan.net/poem6047.html","الطويل"],[31,"ألم تعرض فتسأل آل لهو","https://www.aldiwan.net/poem6055.html","الوافر"],[87,"أنلني يدا خلقت للقبل","https://www.aldiwan.net/poem7351.html","المتقارب"],[47,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[47,"ميلوا إلى الدار من ليلى نحييها","https://www.aldiwan.net/poem66851.html","البسيط"],[51,"يعمر بيت بخراب بيت","https://www.aldiwan.net/poem64137.html","الرجز"],[68,"إذا لم تعني في علاك المدائح","https://www.aldiwan.net/poem41360.html","الطويل"],[82,"أوميض البرق في الليل البهيم","https://www.aldiwan.net/poem31292.html","الرمل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16627","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42732","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54588","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54690","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54313","السريع"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[47,"مِيلُوا إلى الدّارِ مِنْ لَيْلَى نُحَيّيهَا","https://www.poetsgate.com/ViewPoem.aspx?id=31648",""],[128,"علمك بعمان قرية","https://www.aldiwan.net/poem23740.html","البسيط"],[147,"أما ومناقب عزت مراما","https://www.aldiwan.net/poem11818.html","الوافر"],[255,"يمينا لقد نلنا بدين محمد","https://www.aldiwan.net/poem15081.html","الطويل"],[280,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[325,"إن العيون التي في طرفها حور","https://www.aldiwan.net/poem61800.html","الكامل"],[327,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[373,"لمن الظعن بالضحى طافيات","https://www.aldiwan.net/poem1882.html","الخفيف"],[382,"أولى مسيري ذا الأمان","https://www.aldiwan.net/poem59233.html","مجزوء الكامل"],[382,"أقوت عهودهم فأين ذمامي","https://www.aldiwan.net/poem59264.html","الكامل"],[396,"عظيم الفضل يا رب","https://www.aldiwan.net/poem54638.html","عموديه"],[399,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[412,"فؤادي الفداء لها من قبب","https://www.aldiwan.net/poem50210.html","المتقارب"],[469,"كيف السكون من الدنيا إلى سكن","https://www.aldiwan.net/poem3393.html","عموديه"],[505,"الخب ميال مع الشبهات","https://www.aldiwan.net/poem37714.html","الكامل"],[520,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[580,"لقد عفت عيشي بعد العفيف","https://www.aldiwan.net/poem2791.html","المتقارب"],[580,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83266","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86860","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39190","المجتث"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70733","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107187","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120052","الوافر"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202075","الكامل"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73491","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112767","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112864","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112862","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112818","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112794","الطويل"],[1290,"","https://poetry.dctabudhabi.ae/diwan/poem/116786","المتقارب"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50030","السريع"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122030","الطويل"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203659","الطويل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198892","الطويل"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27935","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27682","السريع"],[2234,"","https://poetry.dctabudhabi.ae/diwan/poem/111087","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77200","الخفيف"],[2251,"","https://poetry.dctabudhabi.ae/diwan/poem/82123","البسيط"],[2465,"","https://poetry.dctabudhabi.ae/diwan/poem/124310","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87341","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87325","الرجز"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93415","الطويل"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62830","المتقارب"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129509","الرمل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131975","الوافر"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118765","الخفيف"],[3758,"","https://poetry.dctabudhabi.ae/diwan/poem/143436","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77089","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119485","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86471","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123496","البسيط"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/46002","المتقارب"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123467","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133059","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133112","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120433","المتقارب"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139772",""],[4805,"غياب طيف","https://www.poetsgate.com/ViewPoem.aspx?id=176499",""],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4858,"في ظل الحضارة الزائفة","https://www.poetsgate.com/ViewPoem.aspx?id=33863",""],[4875,"بدون أطناب","https://www.poetsgate.com/ViewPoem.aspx?id=134440",""],[5459,"لزمنا الليل","https://www.poetsgate.com/ViewPoem.aspx?id=190906",""],[5459,"ماذا ادّخرتَ..؟","https://www.poetsgate.com/ViewPoem.aspx?id=208843",""],[5961,"يسير بك المهيمن","https://www.poetsgate.com/ViewPoem.aspx?id=199772",""]],"verses":[["يَعُمُّ الوَرى جَدْواي إِنْ راشَني الغِنى","وَأَسْتُرُ عَنْهُمْ خَلَّتِي حينَ أُعْدِمُ",0,"م",1,0],["يَعُمُّ عَلى البَرِيَّةِ مِنكَ فَضلٌ","وَتُطرِقُ مِن مَخافَتِكَ الأُسودُ",1,"د",1,0],["يُعْملُهُ في عِرْسِهِ","لَيْلَتَهُ إلى غَدِهْ",2,"د",2,0],["يَعُمنَ بِنا عَومَ السَفينِ إِذا اِنجَلَت","سَحابَةُ وَضّاحِ السَرابِ خَبوبِ",3,"ب",1,0],["يَعُمنَ عَلى كَلاكِلِهِنَّ فيهِ","وَلَو يُزجى إِلَيهِ الفيلُ هابا",4,"ب",2,0],["يعم العباد ويغشى البلاد","إذا الغيث في أرض قوم نزل",5,"ل",1,0],["يُعمِلُ الهِندِيَّ مُحمَرَّ الظُبا","فيهِ وَالخَطِّيَّ مُصفَرَّ الخِرَق",6,"ق",1,0],["يَعُمنَ فيها بِأَوساطٍ مُجَنَّحَةٍ","كَالطَيرِ تَنفُضُ في جَوٍّ خَوافيها",7,"ي",3,0],["يَعمُرُ بَيتٌ بِخَرابِ بَيتٍ","يَعيشُ حَيٌّ بِتُراثِ مَيتِ",8,"ت",1,1],["يَعُمُّ الأَقاصي جودُهُ وَهوَ عابِسٌ","وَتَخشى الأَداني بِشرَهُ وَهوَ مازِحُ",9,"ح",1,0],["يَعْمُرُ الحربَ بجيشٍ أرضُهُ","من دمِ الأعداءِ حمراءُ الأديم",10,"م",1,0],["يَعْمَلْنَ فيما دُونَهُنّ بزَعْمِه","ولَهن دونَكَ مَطْلَعٌ وأفولُ",11,"ل",1,0],["يَعُمُّ الرِّضَا مَا قَامَ بِالْحَقِّ صَادِعٌ","وَتَبْقَى الْعُلا مَا دَامَ لِلسَّيْفِ حَامِلُ",12,"ل",1,0],["يَعْمَلُ الفِكْرُ سَالِكاً كُلَّ نَهْجٍ","لِلْمَرَاقِي وَفَاتِحاً كُلَّ بَابِ",13,"ب",1,0],["يُعَمرُ الْعُمْرُ بِالعُلَى","ذَلِكَ المَذْهَبُ الأَصَحُّ",14,"ح",1,0],["يعْمَلُ كالنحْلةِ لا يَنْثَني","وَكَمْ جَنَيْنَا الْحُلْوَ مِنْ شَهْدِهِ",15,"د",2,0],["يعملة قد أخذت سلاحها","من حقب يزينها على الونى",16,"ا",1,0],["يَعُمْنَ فيهَا بِأوْسَاطٍ مُجَنَّحَةٍ","كالطّيرِ تَنقَضُّ في جَوٍّ خَوَافيهَا",17,"ي",3,0],["يعمي دخانك إن أوقدت نار قرى","والخير لا فيك يا هذا ولا فيه",18,"ه",1,0],["يَعُمُّ بِهِ الأَدانِيَ وَالأَقاصي","إِذا لَم يَعدُ رِفدُهُمُ النَداما",19,"م",2,0],["يعمُّ الورَى بالعدلِ والأمنِ شرعَهُ","فليس يخافُ الليثَ في ملكه الظَّبيُ",20,"ي",1,0],["يَعُمُّ الذي خُصتْ به منْ تهانِئ","فَلا بَشرٌ إلا ازْدَهَتْهُ البَشائِرُ",21,"ر",1,0],["يَعمَلَنَّ أَضعافَها فينا إِذا سَهِرَت","وَهُنَّ أَضعَفُ خَلقِ اللَهِ إِنسانا",22,"ن",2,0],["يُعَمَّرُ ذو الزَمانَةِ وَهُوَ كَلٌّ","عَلى الأَدنى وَلَيسَ لَهُ غَناءُ",23,"ا",2,0],["يُعْمِلُ البازِلَ المُجِدَّة بالرَّحْ","لِ تَشَكَّى النِّجادَ بَعْدَ الحُزُونِ",24,"ن",1,0],["يُعمي بصائرَ حُسَّدٍ","فكأنه سهمُ البنان",25,"ن",1,0],["يُعميهمُ الحقُّ الصراحُ بشمسه","هذا جزاء المبصر المتعامي",26,"م",2,0],["يعم الآل والأزوا","ج والانصار والصحب",27,"ب",1,0],["يعمه الآخرون في ليلها الدا","جي وأنتم تحيون تحت سناها",28,"ه",2,0],["يَعُمنَ مِنَ الآلِ في لُجَّةٍ","إِذا ما علا الشَخصُ فيها رَسب",29,"ب",1,0],["يعمى عن الشيء يبدو وهو ذو بصرٍ","حيناً ويسمع أحياناً بلا أذن",30,"ن",1,0],["يعمى إذا برزت حقائق ذاته","ولغيره يحتاط بالهفوات",31,"ت",1,0],["يعمهم اسم الملك ثم يخصه","فيبطل من بعد الخصوص عموم",32,"م",1,0],["يَعُم أَذَاهَا فلا الأَغنياءُ","نَجَوْا من أَذَاها ولا الأَنْبِياءُ",33,"ا",2,0],["يعمُّهمُ حلمُه المطمئنُّ","ويشملُهم بِرُّهُ العاجِلُ",34,"ل",1,0],["يُعَمِّرونَ الأَرضَ الَّتي أَورَثَ اللَهُ عَبا","داً لَهُ هُمُ الصُلَحاءُ",35,"ا",2,0],["يَعمّ عَلَينا مِنكَ طيّبُ نَفحها","وَنَقصر عَن إِدراك زاهر عطرها",36,"ر",3,0],["يُعْمي البَصِيْرَ ويُدْني","مِنَ الأُمورِ الدَّنِيَّهْ",37,"ي",2,0],["يُعْمِلُ الضربةَ المُرِشَّةَ إِذ يُعْ","ملُ فيهم والطعنةَ المِرْشاشا",38,"ش",2,0],["يعُمُّ الورى جوداً وبأساً وهيْبةً","وعدلا ويعفو عنهمُ عفوَ قادر",39,"ر",1,0],["يَعُمُّ الضِّياءُ الأُفقَ وَالليلُ عاكِرٌ","إِذا حانَ مِن تِلكَ الوُجُوهِ سُفُورُ",40,"ر",1,0],["يعم النازحين ندى يديه","ويعلي المادحين بلا تواني",41,"ن",2,0],["يَعْمي عُدَاة بني علىٍّ مَنْظَري","ويصمهم في كل صُقْع مَخْبري",42,"ر",2,0],["يَعمُرُكَ الناسُ في سُجودٍ","وَفي رُكوعٍ وَفي قُنوتِ",43,"ت",1,1],["يعمان الذي ترضى وينمى","مزيدهما فهب حسن التحيه",44,"ي",2,0],["يعمان أصحابا وآلا ومن قفى","طريقته والمنتمى بمحبة",45,"ه",1,0],["يعمان آلا مع صحاب أماجد","وكل مجد للسبيل قد اهتدى",46,"د",2,0],["يعمان آل الخير والصحب والذي","تصبب فيه من جميع الخليقة",47,"ه",1,0],["يعمان للاصحاب والآل ما نحا الجناب","محبر أو أتى خائف يشكى",48,"ك",2,0],["يعمر عدو لأهل النفا","ق وأهل المعاصي وأهل الريب",49,"ب",1,0],["يعمل مع فعل اليه أسندا","نصبا لمفعول لو تعدّدا",50,"د",2,0],["يعم وحبّذا هما للمدح","وبئس أو ساء هما للقدح",50,"ح",1,0],["يعمل في إصلاح شأَن العُلى","بحسن تدبير وحسن اهتمامْ",51,"م",1,0],["يَعِمُّ الْوَرَى مِنْ كَوْمِهِ وَعُلُومِهِ","فَهَذِي لِمَنْ يَقْرَا وَهَذِي لَمَنْ يَقْرِي",52,"ر",2,0],["يعم بعف\"و خص بال\"ذنب مطقه","و\"تهدى إلى الرشد\" المبين ألدُّه",53,"د",2,0],["يعملات ما عانقت من مقيل","كل أرض تقلها أدحاها",54,"ا",3,0],["يعملُ النملُ دائباً وصبوراً","فوقَ إدراكِ فطنةِ الحيوانِ",55,"ن",1,0],["يعم جميع العالمين بجاهه","له العز والإكرام والرتبه العليا",56,"ي",2,0],["يعملون الليل حتى ينجلي","عن صباح ويرى الروح الأمين",57,"ن",1,0],["يعم علمهمُ أحوالَ كونهمُ","الماض وآلات بالتصريف والآنُ",58,"ن",1,0],["يعم بالقطع لهذا يرى","يحكم في الرفع وفي الخفض",59,"ض",1,0],["يعملات ما جرت في حلبة","والصبا إلا الصبا ظل وراها",60,"ا",3,0],["يَعمَلُ الزارِعُ الخَزينُ وَيَشقى","وَالجَزاءُ الفَتيلُ وَالقِطميرُ",61,"ر",1,0],["يَعملن مُعملةً زُهراً مفدَّمَةً","صُفراً مقوَّمة من تِبر عقبانِ",62,"ن",1,0],["يعملات من دين أحمد نجبٌ","لا بنات الجديل تزهي الرحالا",63,"ل",2,0],["يَعمَلنَ كالواقِعِ المَشهُورِ يا أمَلي","لأنَّه بَينَهُم في الأصلِ مَكفُولُ",64,"ل",1,0],["يَعمَلنَ في تُوري وفي كَفِّيني","فآنتَخ لها فأنتَ ذو تمكينِ",65,