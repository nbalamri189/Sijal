92.html","عموديه"],[484,"يا مال والسيد المعمم","https://www.aldiwan.net/poem480.html",""],[488,"إما ترى رأسي أزرى به","https://www.aldiwan.net/poem658.html",""],[491,"ذو قصر أحدب من غير كبر","https://www.aldiwan.net/poem67295.html","عموديه"],[491,"يا غازيا أتت الأحزان غازية","https://www.aldiwan.net/poem67363.html","البسيط"],[498,"كل وقت له من القوم شيخ","https://www.aldiwan.net/poem37749.html","الخفيف"],[498,"دار الولي إذا ما مات عامرة","https://www.aldiwan.net/poem37758.html","البسيط"],[513,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[513,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[513,"لا تندبن ليلى ولا أطلالها","https://www.aldiwan.net/poem12239.html","الكامل"],[513,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[527,"قالوا يعاديك جميع الورى","https://www.aldiwan.net/poem37327.html","السريع"],[536,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[536,"نظرت بلحظ بالقلوب لعوب","https://www.aldiwan.net/poem48277.html","عموديه"],[542,"بايعت ذكراك","https://www.aldiwan.net/poem67252.html","عموديه"],[549,"مرت بنا بمصلى الخيف سانحة","https://www.aldiwan.net/poem47343.html","البسيط"],[549,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[556,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[556,"بلغوا الحي من عريب كنانه","https://www.aldiwan.net/poem33686.html","الخفيف"],[556,"عين حق إنسانها الإنسان","https://www.aldiwan.net/poem33815.html","الخفيف"],[556,"هذه الأثواب والخلع","https://www.aldiwan.net/poem34397.html","المديد"],[556,"اسقني من مدامة القدوس","https://www.aldiwan.net/poem34435.html","الخفيف"],[556,"حوضي الذي فيه أنبوبان من كوثر","https://www.aldiwan.net/poem34502.html","المواليا"],[556,"إن بين الوجود والموجود","https://www.aldiwan.net/poem34628.html","الخفيف"],[556,"لي رتبة العلامة الشهم الأَسد","https://www.aldiwan.net/poem34635.html","الكامل"],[556,"إن بحر الوجود بالإختلاج","https://www.aldiwan.net/poem34690.html","الخفيف"],[562,"لشمس مجدك في الآفاق أضواء","https://www.aldiwan.net/poem820.html",""],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[573,"ليل وصل منيرة أقماره","https://www.aldiwan.net/poem3059.html","الخفيف"],[573,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[582,"إن بني من رجال الحمس","https://www.aldiwan.net/poem69378.html","الرجز"],[582,"إن بني معرق كريم","https://www.aldiwan.net/poem69380.html","الرجز"]],"verses":[["أَنبَطتُ مِن حُسنِها ماءً بِلا نَصَبٍ","وَحُزتُ مِن نَظمِها دُرّاً بِلا ثَمَنِ",0,"ن",1,0],["إِنَّ بَينَ الحِمى إِلى جانِبِ الرَم","لِ مَعاناً مِنَ الظِباءِ الهيفِ",1,"ف",1,0],["اِنبَتَّ بَعدَكَ حَبلُنا وَحَدَت","كُلّاً لِطيَّتِهِ نَوىً قُذُفُ",2,"ف",1,0],["إِنَّ بَهاءَ المُلكِ إِن أَدعُهُ","وَالخَطبُ قَد نازَلَني يَمنَعِ",3,"ع",1,0],["إِنَّ بَنو الدُنيا تَسيرُ رِكابُنا","وَتُغالِطُ الإِدلاجَ وَالإِسراءَ",4,"ا",2,0],["إِنَّ بَرْحَ الغَرامِ يَنْزِفُ دَمْعاً","راضَ شَوْقي إِباءَهُ في التَّصابِي",5,"ي",1,0],["أَنبَتَ اللَهُ رَوضَةَ الحُبَّ في قَل","بي تَرودُ الهُمومُ فيهِ رِتاعا",6,"ع",2,0],["أُنبِئتُها صَرَخَت لَمّا رَأَت أَسَداً","في خاتَمٍ صَوَّروهُ أَيَّ تَصويرِ",7,"ر",1,0],["إِنَّ بِالشَطِّ نَحوَ دارِ المُعَلّى","لَغَزالاً إِلى القُلوبِ حَبيبا",8,"ب",2,1],["أُنبِئتُ أَنَّ لِخالي هَجمَةً حُبسا","كَأَنَّهُنَّ بِجَنبِ المَشعَرِ النُصُلُ",9,"ل",1,1],["إنْ بَطَشَ الدّهْرُ بقوْمٍ حمَوْا","أو تعْثُرِ الأيّامُ قالوا لَعا",10,"ع",2,0],["إنْ بانَ منْزِلُهُ وشطّتْ دارُهُ","قامتْ مَقامَ عِيانِهِ أخْبارُهُ",11,"ر",2,1],["إن بِنْتَ فاسْمَحْ لي برَجعِ تحيّةٍ","أو غِبْتَ فابْعَثْ بالخَيالِ يَعودُ",12,"د",1,0],["إِنَّ بَني قَميئةَ بنِ سَعدِ","كُلُّهُمُ لِمِلصَقٍ وَعَبدِ",13,"د",1,1],["أُنبِئتُ أَنَّ رَسولَ اللَهِ أَوعَدَني","وَالعَفُوُ عِندَ رَسولِ اللَهِ مَأمولُ",14,"ل",1,0],["إِن بَكَت غَيرَكَ النِساءُ وَأَذرَف","نَ عَلَيهِ الدُموعَ مِثلَ اللَآلي",15,"ل",2,0],["إِن بَريئاً وَإِن أَثيماً سَتُجزى","يَومَ تُجزى أَمامَ رَبٍّ شَهيدِ",16,"د",1,0],["إِنَّ بي شَوقاً إِلى ذي غُنَّةٍ","يُؤنِسُ النَفسَ وَقَد نامَ السَمَر",17,"ر",1,0],["إِن بَدَّلوا أَوَّلَهُ آخِراً","وَبَدَّلوا الثاني بِالآخِرِ",18,"ر",1,1],["إِنْ بَعَثَتْهَا الأَوْتَارُ رَدَّتْ","تِلْكَ الأَغَارِيدَ فِي حَنَانِ",19,"ن",1,0],["إِنْ بَاتَ فِي حُجُبٍ بَاءَتْ إِلَى نُصُبٍ","يَلُوخُ مِنْهُ لَهَا مَعْبُودُهَا الجَانِي",20,"ن",2,0],["إِنَّ بِالشَّرْقِ بَعْدَ سَرْكِيسَ شَجْواً","شَرقَتْ بِالدِّمَاءِ مِنْهُ الجُفُونُ",21,"ن",1,0],["إِنْ بَانَ شَاعِرُهُمْ فَغُرُّ فِعَالِهِمْ","شِعْرٌ وَمَا الأَبْحَارُ وَالأَوْزَانُ",22,"ن",1,0],["أَنْبِتْهُمُ اللَّهُمَّ نَبْتاً صَالِحاً","وَتَوَلَّهُمْ بِالْفَضْلِ وَالإحْسَانِ",23,"ن",1,0],["إِنْ بَكَى الشَّرْقُ فَالمُصَابُ أَلِيمُ","وَقَلِيلٌ فِيهِ الأَدِيبُ العَلِيمُ",24,"م",1,1],["إِن بَدَت حاجَةٌ لَهُ ذَكَرَ الضَي","فَ وَيَنساهُ عِندَ وَقتِ الغَداءِ",25,"ا",2,0],["إِنَّ بَني طَوقٍ لَأُعجوبَةٌ","تَحارُ في وَصفِهِمُ الفِكرَه",26,"ر",2,1],["أن بليلاً من نسيم السحر","لمّا جرى في المربع المخمل",27,"ل",1,1],["إن بصدري للقريض لفَوْرةً","يزيد بها من طول غفلتكم نفثي",28,"ي",1,0],["أن بقينا هكذا فأحتجبي","عن بني الغبراء أو فانكسفي",29,"ي",1,0],["إن بكاه الدين الحنيفي شجواً","فلأن كان ركنه وأساسه",30,"س",2,0],["أُنبِئتُ تَغلِبَ بَعدَما جَدَّعتُهُم","يَتَعَذَّرونَ وَما لَهُم مِن عاذِرِ",31,"ر",1,0],["إِنَّ بِلالاً لَم تَشِنهُ أُمُّهُ","لَم يَتَناسَب خالُهُ وَعَمُّهُ",32,"م",2,1],["أُنبِئتُ أَنَّكَ يا اِبنَ وَردَةَ آلِفٌ","لِبَني حُدَيَّةَ مُقعَداً وَمُقاما",33,"م",2,0],["أُنبِئتُ أَنَّ أَبا حَنيفٍ","لامَني في اللائِمينا",34,"ن",2,1],["إِنَّ بَني عَبدِ وُدٍّ كُلَّما وَقَعَت","إِحدى الهَناتِ أَتَوها غَيرَ أَغمارِ",35,"ر",1,0],["إِنَّ بَني العَمِّ لَستَ تَخلُفُهُم","إِن عادَتِ الأُسدُ عادَ أَشبُلُها",36,"ل",3,0],["إِنَّ بِها كُلَّ عَميمِ النَدى","يَداهُ لِلجودِ يَنابيعُ",37,"ع",1,0],["أَنَّ بَني عَمّي وَحاشاهُمُ","شَعبُهُم بِالخُلفِ مَصدوعُ",37,"ع",1,0],["أَنَبذِلُ الوُدَّ لِأَعدائِنا","وَهوَ عَنِ الإِخَوَةِ مَمنوعُ",37,"ع",1,0],["أنبتته نعمى الصفيّ وأحيت","ذكرَ أسلافه فسرت نباته",38,"ت",2,0],["إن بتُّ في مزْج ذكراه فإنيَ من","همِّ التباعد في هرْجٍ وفي مرْج",39,"ج",1,0],["أنبت أزهارها ودللها قطفا","من بعد ما كادَ أن يزلزلها خسفا",40,"ف",2,0],["إِنَّ بَيتاً أَنتَ ساكِنُهُ","غَيرُ مُحتاجٍ إِلى السُرُجِ",41,"ج",1,0],["إن بَحْثَ الطَّبيبِ عنْ داءِ ذي الدَّا","ءِ لَأُسُّ الشِّفاءِ قبل الشفاءِ",42,"ا",2,0],["إنَّ بخس الثواب إن دام ظلماً","قَلَب المدحَ ذاتَ يومٍ هجاءَ",43,"ا",2,0],["إن بحراً يُمِدُّ بحراً بشعْبٍ","فيه أدنى صُبابةٍ لَعُجابُ",44,"ب",1,0],["إن بيتَ الفتاة بيتُ سِفاحٍ","كلما شئتَ فيه نيكاً وجدتا",45,"ت",2,0],["إن بَعُدت كان العمى حاضراً","وإن دنت بان طريق الهدى",46,"د",2,0],["إن برزت للهواء غيرها","أو قُرِعَتْ بالمزاج كدَّرها",47,"ر",3,0],["أنبئتُ أنك يا يعقوب مبترِكٌ","تُقصِّد الشعرَ في سبي وترتجز",48,"ز",1,0],["أنِبْ إلى قاسمٍ وإلا","فالله عَوْنٌ على الغشومِ",49,"م",1,0],["إِنَّ بَني زَيدٍ مَليحو الشَكلِ","كَم فيهِمِ مِن فَعلَةٍ وَفَعلِ",50,"ل",1,1],["أَنبَتَت حَولَكَ الزُهورُ الغَوادي","وَاللَيالي أَنبَتنَ حَولي القَتادا",51,"ا",1,0],["إِن بُحتُ بِالشَكوى فَغايَةُ مُجهَدٍ","لَم تُبقي لي كَبِداً فَأَستَبقيكِ",52,"ك",1,0],["إِن بُدِّلَت مِنها التُخومُ فَإِنَّها","ما بَدَّلَت وَاللَهِ غَيرَ تُخومِها",53,"م",3,0],["إِن باحَ لَم تَسلَم كَرامَتُهُ","وَالإِثمُ كُلُّ الإِثمِ إِن كَتَما",54,"م",2,0],["إِن بُنتُمُ عَنهُ فَما زالَ الهَوى","يُدنيكُمُ مِنهُ كَما يُدنيني",55,"ي",1,0],["إِنَّ بَعضَ الظَنِّ إِثمٌ","صَدَقَ اللَهُ تَعالى",56,"ل",2,0],["إِنَّ بِالشّعبِ الذي دونَ سلعٍ","لَقتيلاً دَمُه ما يُطَلُّ",57,"ل",1,1],["أَنباءُ أَسرك قَد طَبّقن آفاقا","بَل قَد عَمَّمن جِهاتِ الأَرضِ إِقلاقا",58,"ق",2,1],["ان بين العقول حربا عوانا","نارها لا تزال ذات اشتعال",59,"ل",1,0],["ان بين الذين يحيون فوق","الارض حربا على البقاء طحونا",60,"ن",2,0],["ان بحرا لا تبتغي فيه خوضا","ليس في ضير ان يكون عميقا",61,"ق",2,0],["إن بصيصي كله","من بعض ذلك السنى",62,"ن",2,0],["أُنبِئتُ أَنَّ سُلَيمانَ الزَمانِ وَمَن","أَصبى الطُيورَ فَناجَتهُ وَناجاها",63,"ا",3,1],["إِنْ بُحْتُ يوماً طُلَّ فيه دَمي","ولَئِنْ كَتَمْتُ يَضِقْ بهِ صَدْرِي",64,"ر",2,0],["إِنَّ بَرقي إِذا بَرَقتَ فَعالي","وَصَليلي إِذا صَلَلتَ اِرتِجازي",65,"ي",1,0],["إِن بَرَقوا فَالحُتوفُ حاضِرَةٌ","أَو نَطَقوا فَالصَوابُ وَالحِكَمُ",66,"م",1,0],["إِنَّ بَعضاً مِنَ القَريضِ هُذاءٌ","لَيسَ شَيئاً وَبَعضَهُ أَحكامُ",67,"م",1,0],["أُنبئت أن سخيف العقل قال لكم","إن الذي شاء خلقي شاء سفك دمي",68,"ي",1,1],["إنَّ بني الحكمة الشريفة قد","أتاهم الله قدرة عجبا",69,"ب",2,0],["أُنَبّيكِ عَن عَيني وَطولِ سُهادِها","وَحَرقَةِ قَلبي بِالجَوى وَاِتِّقادِها",70,"د",3,1],["أَنبِل بِوَهبٍ أَنبِل بِضَرطَتِهِ","إِذ صَيَّرَ الناسُ ذِكرَها سَمَرا",71,"ر",2,1],["أَنبَوتُ عَنكَ بِزَعمِهِم وَمَتى نَبا","في حالَةٍ بَعضُ اِمرِئٍ عَن بَعضِهِ",72,"ض",2,0],["إِن بَلَوناكَ كُنتَ واحِدَ آحا","دٍ لَهُم كَثرَةٌ عَلى الآلافِ",73,"ف",1,0],["إِنَّ بَينَ الكَثيبِ فَالجَزعِ فَالآ","رامِ رَبعاً لِآلِ هِندٍ مُحيلا",74,"ل",2,0],["أُنَبِّهُها وَهناً وَفي فَضلِ مِرطِها","مُصابٌ قُواهُ بِالنُعاسِ قَتيلُ",75,"ل",1,0],["إِن بَذَلنا لَهُ اِقتِصاراً عَلَيها","جازَ عَنها إِلى جَزيلِ نَوالِه",76,"ل",2,0],["أُنبيكَ عَن طَولِ الأَميرِ وَفَضلِهِ","وَعَن جَدِّهِ في المَكرُماتِ وَهَزلِهِ",77,"ل",2,1],["أُنبِئتُها بِالغَيبِ ثُمَّ رَأَيتُها","تَدنو مَسافَتُها وَيَصغُرُ شانُها",78,"ن",3,0],["إِنَّ بِلالاً إِن تُلاقيهِ سالِماً","كَفاكِ الَّذي تَخشَينَ مِن كُلِّ جانِبِ",79,"ب",1,1],["إِنَّ بُغائي لِلَّذي إِن أَرادَني","مَكانَ الثُرَيّا إِن تَأَمَّلَها البَصَر",80,"ر",1,1],["أُنبِئتُ أَنَّ العَبدَ أَمسِ اِبنَ زَهدَمٍ","يَطوفُ وَلِلغيني لَهُ كُلُّ تِنبالِ",81,"ل",1,1],["أُنَبِّئكَ ما قَد يَعلَمُ الناسُ كُلُّهُم","وَما جاهِلٌ شَيئاً كَمَن هُوَ عالِمُه",82,"م",2,0],["أُنبِئكَ عَنهُم غَيرَ ما تَكذابِ","بِأَنَّهُم أَوعِيَةُ الكِتابِ",83,"ب",1,0],["أَنَ بِاللَهِ وَحدَهُ وَإِلَيهِ","إِنَّما الخَيرُ كُلُّهُ في يَدَيهِ",84,"ي",2,1],["إِنَّ بَذلي لَها لَبَذلُ جَوادٍ","وَاِقتِنائي لَها اِقتِناءُ شَحيحِ",85,"ح",1,0],["أَنبَأَتنا الأَنباءَ عَن سالِفي الدَه","رِ وَعَدَّت لَنا القُرونَ القُروما",86,"م",2,0],["إِن بَكى يُحَقُّ لَهُ","لَيسَ ما بِهِ لَعِبُ",87,"ب",1,0],["إِن بِاشَرَتها أَقارِبي بِيَدٍ","يَوماً فَلي دونَهُم يَدٌ وَفَمُ",88,"م",1,0],["أنْبَتَ الدهرُ في المفارقِ شيباً","بِهُمومٍ في مُضْمَرِالقلبِ يُزْرَع",89,"ع",1,0],["إنَّ بَحرَيْك عَلى عَظمِهِما","حَسَدا كفَّيك في فيضِ السّماح",90,"ح",1,0],["أُنبِئتُ عَبدُ اللَهِ أَصبَحَ يُعوِلُ","إِنَّ الزَمانَ بِأَهلِهِ مُتَنَقِّلُ",91,"ل",1,1],["إِنَّ بَقاءَ الجَوادِ أَحمَدَ في","أَعناقِنا مِنَّةٌ مِنَ المِنَنِ",92,"ن",1,0],["إِنَّ بُكاءً في الدارِ مِن أَرَبِه","فَشايِعا مُغرَماً عَلى طَرَبِه",93,"ب",2,1],["أَنبَطتُ في قَلبي لِوَأيِكَ مَشرَعاً","ظَلَّت تَحومُ عَلَيهِ طَيرُ رَجائي",94,"ا",2,0],["أَنْبَتَ الْحُسْنُ فَوْقَ خَدَّيْهِ وَرْدَاً","لَيْسَ إِلَّا بِغَمْزَةِ اللَّحْظِ يُجْنَى",95,"ن",2,0],["إِنَّ بَيْتَ الْوَزَّانِ لَمْ يَزِنُوا شَيْ","ئاً وَلَكِنَّ فِيهِمْ عَلَى ذَاكَ ثِقْلُ",96,"ل",1,0],["إنَّ بالشامِ لبرْداً يابساً","عابساً يخشاهُ مَنْ فيهِ أقاما",97,"م",2,1],["إِنَّ بي داخِلاً مِنَ الحُبِّ قَد أَب","لى عِظامي مَكنونُهُ وَبَراني",98,"ي",1,0],["أُنبِئتُ أَنَّكِ إِذ أَتاكِ كِتابُنا","أَعرَضتِ عِندَ قِراتِكِ العُنوانا",99,"ن",2,0],["أَن بِت لَدينا لَيلَةً","نُحي بِها وَنُلطِفُ",100,"ف",1,0],["انْبعِثْ في الأرضِ يا وَحْيَ السَّماءْ","واسْرِ يا نُورَ الهُدَى مِلءَ الفَضاءْ",101,"ا",2,1],["انْبَعِثْ كالرُّوحِ يا رُوحَ الرَّجاءْ","وامْلأ الأكوانَ مِثلَ الكهرباءْ",101,"ا",2,0],["إنّ بالخزّانِ مِن أصحابِها","ما بِمصرٍ مِن هُمومٍ ثائرهْ",102,"ر",2,0],["إِنَّ بِالنيلِ غَمرَةً تَتَمادى","وَأَرى كُلَّ غَمرَةٍ تَتَجَلّى",103,"ل",2,0],["إِن بَلَوتُم مِنهُم فَريقاً فإنا","قَد رَمانا باثنين هَذا الزَمان",104,"ن",1,0],["أَنبَتوا مِن مَعاشرٍ شَعرَ","الرَأسِ وَهُم أَلحَقوهُمُ المَنَعَه",105,"ع",2,0],["إِنَّ بِمَعنٍ إِن فَخَرتَ لَمَفخَراً","وَفي غَيرِها تُبنى بُيوتُ المَكارِمِ",106,"م",1,1],["أَنَبا بِحاجَتِكَ الأَميرُ وَمَدَّهُ","في ذاكَ قَومٌ كاشِحونَ فَأَجهَدوا",107,"د",3,0],["أَنبَتَ الدَهرُ لَنا","كُلَّ شَيءٍ فَرَطا",108,"ط",2,0],["إِن بُحتَ بِاِسمِكَ فَهوَ يَقتُلُني","وَهُناكَ تُثكَلُ مِنِّيَ الثَكلى",109,"ا",1,0],["إنْ بدا شمساً وصاروا نجوما","وطَمَى بحراً وفرُّوا ثِغابا",110,"ب",2,0],["إِنَّ بَيْتِي يقول قد طالَ عَهْدِي","بِدُخُولِ التَلِّيسِ لِي وَالشِّكَارَهْ",111,"ر",2,0],["إنَّ بَيْتَاً يغْشَاهُ كلُّ فقِيرٍ","مِنْ عَلِيٍّ في ذِمَّةٍ وَخِفَارَهْ",111,"ر",2,0],["أَنْبَا سَطِيحٌ وشِقٌّ وَابْنُ ذِي يَزَنٍ","عنه وقُسٌّ وَأَحبارٌ مَقاوِيلُ",112,"ل",1,0],["أنْبَتَ العِزُّ منكَ في بَيْتِ نَفْسِي","وَالغِنَى مِنْ يَدَيْكَ في بيتِ مالِي",113,"ل",2,0],["أُنبِئتُ أَنَّ أَبا جَدّي تَخَيَّرَها","مِن ذُخرِ آدَمَ أَو مِن ذُخرِ حَوّاءِ",114,"ا",2,0],["أَنبَأتُهُ أَنّي مُحِبٌّ لَهُ","فَكانَ هِجراني مُجازاتُه",115,"ت",2,0],["إِنَّ بَيني وَبَينَهُنَّ أَبا عَم","روٍ كَفاني عِزّاً وَكَهفاً وَطَودا",116,"د",2,0],["إِنَّ بِشَطِّ الفُراتِ لي سَكَناً","يَبلُغُ غَيظي بِكُلِّ ما وَسِعا",117,"ع",2,0],["إن باركَ اللَه في الأنام فلا","باركَ ربّ الأنام في سلمَه",118,"م",2,1],["إن بازي بازُّ جوٍّ","يصرعُ الطيرَ العظاما",119,"م",2,0],["إن بان إلفٌ فواصلُ سواهُ","ودع عنكَ كلّ فتىً ميلَع",120,"ع",1,0],["أَنبَتَ الريشَ في جَناحَيهِ حَتّى","عادَ وَحفا وَطارَ كُلَّ مَطيرِ",121,"ر",1,0],["إِن بَرَدَت عَن كَبِدي لَوعَةٌ","طالَت عَلى القَلبِ فَلَم تَبرُدِ",122,"د",1,0],["أُنبِئتُ أَنَّ أَبا قابوسَ أَوعَدَني","وَلا قَرارَ عَلى زَأرٍ مِنَ الأَسَدِ",123,"د",1,0],["أَنبَأَنا اللُبُّ بِلُقيا الرَدى","فَالغَوثُ مِن صِحَّةِ ذاكَ النَبَأ",124,"ب",2,0],["إِن بَشَّرَتَ بِدُموعٍ فَهيَ صادِقَةٌ","أَو خَبَّرَت بِسُرورٍ قُلتَ لا يَلِجُ",125,"ج",1,0],["إِنبَه وَسُد فَهُما هَمٌّ تُكابِدُهُ","وَاِخمُل إِذا شِئتَ أَن تَحظى وَلا تَسدِ",126,"د",1,0],["أُنبِئتُ أَنَّ بَني جَديلَةَ أَوعَبوا","نُفراءَ مِن سَلمى لَنا وَتَكَتَّبوا",127,"ب",3,1],["إِن بُدِّلَت أَهلُها وُحوشاً","وَغَيَّرَت حالَها الخُطوبُ",128,"ب",1,0],["إِنَّ بحث الحَياة وَالمَرء إن ما","ت جماد من أغمض الأبحاث",129,"ث",1,1],["إن بعضاً من الظنو","ن لكالفجر صادق",130,"ق",1,1],["إن بين النهرين والأرض تشقى","لجناناً تبدَّلت فلَوات",131,"ت",1,0],["إن بين المَريخ وَالمُشتَري مِن","ها نجيماتٌ هنَّ غير بطاء",132,"ا",2,0],["أَنبت الغيث في المهابط منها","شجرات مَع الرياح تَميل",133,"ل",1,0],["إن بَعُدَ الشطُّ فقد","آن له أن يَقرُبا",134,"ب",2,0],["أُنَبّئُكمْ أنّي على العَهْدِ سالمٌ","ووَجهِيَ لَمّا يُبْتَذَلْ بسُؤال",135,"ل",1,0],["إِنَّ بُقْيَا الفَتَى عَلَى الجِسْمِ وَالبُقْيَا","عَلَى المَالِ فِي الخِلالِ تُؤَامُ",136,"م",1,0],["إِنَّ بَغْدَادَ فِي حِلىً قَشْبٍ مِنْهُ","أُضِيفَتْ إِلى حَلاَهَا العِتَاقِ",137,"ق",1,0],["إِنَّ بَكَتْهُ وَأَجْمَعَتْ أُممُ الضا","دِ فَمَنْ مِثْلُهُ بِذَاك جَديرُ",138,"ر",1,0],["إِنَّ بُعْداً عَنْ كُل حَشْدٍ مُقِيمِينَ","لتَقْوَى وَرَاحَةٌ وَسُرُورُ",139,"ر",1,0],["إِنْ بَسَطَتْ لِلْبَذْلِ كَفّاً فَقَدْ","رَأَيْتَ ثَمَّ المُعْجِبَ المُذْهِلاَ",140,"ل",2,0],["إِنْ بِالشَّرْقِ رَوْضَةً مِنْ بَيَانٍ","بَرَزَتْ مِنْ حِلاَهُ فِي أَبْرَادِ",141,"د",1,0],["إِنَّ بِي لوْعةً مبَرِّحَةً","سِرُّهَا ما حَيِيْتُ لنْ يُفْشى",142,"ش",2,0],["أنبأتنا أنه لم يعقل","أيها العصر",143,"ر",1,0],["إِنَّ بَعضَ العِتابِ يَدعو إِلى العَت","بِ وَيُؤذي بِهِ المُحِبُّ الحَبيبا",144,"ب",2,0],["إِنَّ بَينَ الحَبيبِ قَد","عاقَكَ اليَومَ وَشكُه",145,"ه",1,0],["إِنَّ بَني عَوفَ اِبتَنوا حَسَباً","ضَيَّعَهُ الدُخلُلونَ إِذ غَدَروا",146,"ر",3,1],["إنّ بغدادَ للملوكِ محل","ومناخٌ للقارىءٍ الصيّاد",147,"د",1,0],["إنّ بعضَ السكوتِ خير من النط","ق وإن كنتَ بالكلام فصيحا",148,"ح",2,0],["أَنبتَّه خيرَ النباتِ يزَيِنُه","خُلُقٌ كأمواهِ السحابِ مُطَهَّرُ",149,"ر",1,0],["أنبَتَّ للأدب المهيض جناحُه","ريشًا، وشِدتَ جداره المتهدما",150,"م",2,0],["إنّ باب الرقيِّ فيه انخفاضٌ","ينحني فيه رأسُ من يَترقَّى",151,"ق",2,0],["إن بَكتْه العبقريات دَمًا","فَهْي من أوصافه منتزعه",152,"ع",2,0],["إنَّ بيتي يقول قد طال عهدي","بدخولِ التَلِّليس لي والشكاره",153,"ر",2,0],["إنَّ بتاً يغشاهُ كلُّ فقيرٍ","من عليٍّ في ذمة ٍ وخفاره",153,"ر",2,0],["أُنَبّيكَ أنَّ \" الرافدينِ \" تطلَّعتْ","ضِفافُهما واستَنْهضَ الشَّجرُ الزرعا",154,"ع",2,0],["ان بينَ الضُلوعِ ، مما استغلوه","بتضليلهم ، قلوباً حِرارا",155,"ر",2,0],["أُنّبِيكَ عن أطيبِ الأخبثينَ","فقُلْ أنتَ بالأخبثِ المُزدرى",156,"ا",1,0],["إنّ بعضَ الرجال يبدو أمامَ الحبِّ","صُلباً والأكثرون يذوب",157,"ب",1,0],["أُنبيكَ عن شرِّ الطّغامِ مَفاجراً","ومَفاخراً ، ومساعياً ومكاسبا",158,"ب",2,0],["أُنبِّيكَ أنّ الحِمى مُلْهَبٌ","وواديه من ألمٍ مُفعَم",159,"م",1,0],["إنّ بَينَ الكَثيبِ فالجِزْعِ فَال","رَامِ رَبْعاً لآلِ هِنْدٍ مُحيلا",160,"ل",2,0],["أنَبَوْتُ عَنْكَ بزَعْمِهِمْ؟ وَمَتى نَبا","في حَالَةٍ بَعضُ امرِىءٍ عَنْ بَعْضِهِ",161,"ض",2,0],["إن باح لم تسلم كرامته","والإثم كلّ إن كتما",162,"م",2,0],["إِنَّ بَيرُوتَ هِيَ الأُنثَى الَتِي","تَمنَحُ الخَصبَ وَتُعطِينَا الفُصُولاَ",163,"ل",2,0],["أُنْبِئْتُ أَنَّكِ، إذا أَتَاكِ كِتابُنا،","وَأَشَعْتِ عِنْدَ قِراتِهِ عِصْيانا",164,"ن",2,0],["أَنْبَضُوا مَعْجِسَ الْقِسِيِّ وَأَبْرَقْ","نا كما توعدُ الفحولُ الفحولاَ",165,"ل",2,0],["إنْ بتَّ في صحةٍ ناعمَا","فإننا في لذةٍ صافِيَه",166,"ي",2,0],["إِنَّ بِالكَأسِ لَمِسكاً","أَو بِكَفّي مَن سَقاني",167,"ي",1,0],["أُنبئْتُ رَيْبا فىَّ جَمْجَمْتَهُ","ويبلُغُ التصريحَ مَن عَرَّضا",168,"ض",2,0],["إِن بانَ بانَ المَوتُ في نَظَراتِهِ","أَو غابَ فَالسُمرُ الشَواجِرُ غابُ",169,"ب",1,0],["أنبطتها مستعجلاً من خاطر","يشكو لفقدك صحبه ومحله",170,"ل",2,0],["إن بنتم فَوِدَادُكُم","حسنُ الوسامة والقَسامه",171,"م",2,0],["أنبياءُ الله أنوار الهدى","من رأى نورهم نال هداه",172,"ا",2,0],["أَنَبنا وَوَلَّينا إِلى اللَهِ وِجهَةً","وَمَن لَم يُصاحِبُنا شَدَهناهُ شَدهَةً",173,"ه",1,0],["أَنباك شاهدُ أَمري عَن مغيَّبهِ","وجدَّ جِدُّ الهَوى بي في تلعُّبهِ",174,"ب",2,0],["إن بنى معيبد لا تدعهم","إلا لخطب من خطوب الدهر",175,"ر",1,0],["أَنبيت عنه وقالوا منذ فارقني","ما فارقا مقلتيه الدمعَ والسهرُ",176,"ر",1,0],["إِنَّ برد الجبال زادٍ فدعْهُ","فالذي فيه في العذاب المهين",177,"ن",1,0],["أنبيت عنها أنها قد أفسدت","لكن غير حياتها لم تفسد",178,"د",1,0],["أنبه حظاً نام نومة مدنف","متى ما أقمه خر من قامة وهنا",179,"ن",2,0],["أنبأتموني عنه أن نصفه","في العدات جرا تموه عشره",180,"ر",2,0],["إِنَّ بَعضَ الخُطوبِ أَهوَنُ مِن بَع","ضٍ وَدونَ البُكا يَكونُ النَحيطُ",181,"ط",1,0],["إِنَّ بِالقاعِ مِن تَنوفٍ مَحَلّاً","لَيسَ لِلمَكرُماتِ عَنهُ حَويلُ",182,"ل",1,0],["إِنَّ بِالرَوضَتَينِ هاماً نِزافاً","لَم يُقَل مَن ثَوى هُناكَ قَتيلُ",182,"ل",1,0],["إِنَّ بِالرَوضَةِ عِصوادَ حَربٍ","قَطَّعَت فيهِ السُيوفُ السُيوفا",183,"ف",2,0],["إِنَّ بَيتي في ذُرى قَح","طانَ لَلبَيتُ المُنيفُ",184,"ف",1,0],["إن بَدا قارعٌ فرأسيَ صَخرٌ","أو بَدا فاجِعٌ فَصخري راسي",185,"ي",1,0],["إِنَّ بَغِيّاً غَذَتكَ طِفلاً","فَيما أَتَتهُ لَمُستَلِيمَه",186,"م",2,0],["أنبت السوسن المنير مع الور","د بخدّيه للمحبّ العضاض",187,"ض",1,0],["أنبّه قوما والكرى في عيونهم","مكان محال النور في طبقاتها",188,"ت",3,0],["أَنبا بهِ تلكَ القرون خبيرُهم","تَوراتهُم إِنجيلُهم وزبورُهم",189,"م",1,0],["أَنَبيعُ والِدَنا الَّذي نُدعى لهُ","بِأَبي مَعاشِرَ غائِبٍ مُتواري",190,"ر",2,0],["أنبكيكَ أم نبكي أباك لغارةٍ","تُشَنُّ لقد ضاقت علينا المذاهب",191,"ب",1,0],["أنبتها فينا نباتاً حسناً","ومن أماني النفوسِ تشربُ",192,"ب",1,0],["أنبتكَ اللهُ مثمراً شغفاً","وهذهِ أضلعي لهُ طبقُ",193,"ق",1,0],["إنب امرؤٌ في نفسهِ عزةٌ","تجلُّهُ عن شيمةِ الغادرِ",194,"ر",1,0],["أُنبيتُ أَنَّ غَواةً مِن بَني حَجَرٍ","وَمِن حُجَيرٍ بِلا ذَنبٍ أَراغوني",195,"ي",1,1],["أُنبيكَ أَنّي قَد رَأَيتُ مَكَرَّهُ","تَحتَ العَجاجَةِ يَدمَغُ الإِشراكا",196,"ك",2,0],["إن بخل الجمال بالقرب مني","هو رأى أراه غير جميل",197,"ل",1,0],["إن بختى عرفته يا فتاتي","منذ أصبحت مغرما بالعيون",198,"ن",1,0],["إن بشعري سأطويكم وأنشركم","يا جاهلين بإيماني وتبياني",199,"ي",1,0],["إن بعض الألحان والنغمات","قد أرتني الأكوان متسعات",200,"ت",1,0],["ان بعضا من البرية أدنى","من هوام تعيش في الأقذار",201,"ر",1,0],["إِنَّ بَيتاً عَلى الجَمالِ بَنينا","هُ لِتَأبى السَماءُ أَن يَنهارا",202,"ر",2,0],["إِن بَينَ السَماءِ وَالأَرضِ حرباً","قُلتِ حَتّى يَصيرَ لِلنّاسِ قَلبُ",203,"ب",1,0],["إنَّ بناءَ الخَزّانِ أَنهَكَني","وَهدَّ جسمي وَزادَ في سَقَمي",204,"ي",1,1],["أنبأك الله في المنام بما","تبصره مقلتاك في السهر",205,"ر",1,0],["إن بان من تهوى وأنت مثبط","وصبرت لا تبكي فأنت مفرّط",206,"ط",1,1],["إِن بَغداذَ الَّتي لِل","بُخلِ أَمسَت دارَ دَعوَة",207,"و",2,0],["إِن بَخِلَت فَالسَماحُ لي خُلُقٌ","أَو غَدَرَت فَالوَفاءُ مِن شِيَمي",208,"م",2,0],["إِنْ بَرَزَتْ مِنْ لَطَافَةٍ يَدُهَا","صَارِخَةً فَالوَزِيرُ يُسْعِدُهَا",209,"د",3,1],["أَنْبِئْهُ بَعْدَ سَلاَمٍ نَافِحٍ عَبِقٍ","تَأَرَّجَ مِنْ طِيبِ مَا ضُمِّنَهُ السِّكَكُ",210,"ك",1,0],["إن بينَ المدادِ والحظِّ عَهداً","وذماماً لا يلتوى وجوارا",211,"ر",2,0],["إن بأس القضاءِ في الناس بأسٌ","لا يُبالي ببأس تلك الدوع",212,"ع",1,0],["أنب مثل التيس فوق استها","وهي بحال النيك تيسيه",213,"ه",1,0],["إن بني برمك لو شاهدوا","فعلك بالغائب والشاهدِ",214,"د",1,1],["إنّ بدر السماء لو لم يغب لم","تترقّبه عينُ كلّ الأنام",215,"م",1,0],["ان بين الاراك فالبان فالريان","للظاعنين رسما محيلا",216,"ل",2,0],["أَنبيّ دونك عبرتي وَتنهدي","كمدا عليك فَكَم أَعيد وأَبتَدي",217,"ي",1,1],["إنْ باتَ لِلرَّحْمَانِ يَعْنُو وَجْهُهُ","فإِلَيْهِ ظَلَّتْ تَخْضَعُ الأَعْنَاقُ",218,"ق",1,0],["أَنْبَاؤُهُ في العُلى والمَجْدِ سائِرَةٌ","كأَنَّهَا لانْعِدامِ المِثْلِ أمثَالُ",219,"ل",1,0],["اُنبُذ مَلامي يا عَذولُ فَإِنَّني","لِلعَذلِ فيهِ وَراءَ ظَهري أَنبُذُ",220,"ذ",1,0],["إِنَّ بَني التُركِ لَدى حَربِهِم","وَسِلمِهِم لَم يَبرَحوا في كِفاح",221,"ح",1,0],["إن بشار بن برد","تيس أعمى في سفينه",222,"ه",1,0],["إِن بذلتُ الروحَ في حبّي لها","فَلَها المنَّةُ في البذل عَلي",223,"ي",1,0],["إِنَّ بَينَ النَقا وَبَينَ المصلّى","ظبياتٍ لها الأسودُ غيارى",224,"ر",2,0],["إنَّ برقَها وَمضٌ","كالسعيرِ يلتهب",225,"ب",1,0],["أَنبتتْ في كل خدٍ وردة","ورمتْ في كلِّ عينٍ بالنُعاس",226,"س",1,0],["إن بليت بالخطوب صبرها","أو سألت ما يريد أعطاها",227,"ا",3,0],["إن بؤساً أنى ولدت وبُؤسٌ","أن أبَقّى وأن أموت عذاب",228,"ب",1,0],["إن براني الهوى وذا","ب فؤادي فلن ألين",229,"ن",1,0],["إِنَّ بَني ضَبَّة قَومي فَلَن","أَشرِبَهُم ما حَنَّتِ النيبُ",230,"ب",1,0],["إِنَّ بَعض الأَنام أَقرى ضُيوفاً","فَرَماهُم مِن الأَكول بِمقتِ",231,"ت",1,0],["اِن بابَ الحسين في مِصر أَضحى","خَير باب سعت لَهُ الاِقدام",232,"م",1,1],["إنّ بينَ الإزارِ خَصْراً حكاني","فكأنّ الزُّنّارَ في الزُّنّار",233,"ر",1,0],["أَنَّبتَ ظُلماً وَلَستُ أَسمَحُ أَن","تَقولَ هَذا فَلَستُ بِالسَمحِ",234,"ح",1,0],["أُنبيكُمُ عَن يَقينٍ أَنَّ قَلبِيَ لَو","أَضحى مَكانَ جَناحَي طائِرٍ نَهَضا",235,"ض",2,0],["أُنَبِّيكَ أنِّي فارِغ الكَفِّ مُترعُ ال","جَوارِحِ فاعجَب مِن فَراغي ومِن شُغلي",236,"ل",2,0],["إنَّ بَكراً تكونُ عَذرا وحُبلى","بوَليدٍ يكون فيهِ النجاءُ",237,"ا",2,0],["أَنبأتكَ الطَيرُ إِذ سَنَحَت","وَالغُرابُ الوَحفُ إِذ نَعَبا",238,"ب",2,0],["اِنَّ بَني النّصب كَاليَهودِ وَقَد","يُخلَطُ تَهويدُهُم بِتَمجيس",239,"س",1,0],["إِنّ بُنيّ شبه النبي","لَيس شبيهاً بعلي",240,"ي",1,1],["إن بكيناكَ فإنّا لم نزل","بقضاء الله فينا مُوقنين",241,"ن",1,0],["أنبأ عن ضم فهل","كشفت ما قد سترا",242,"ر",2,0],["إن بحث العموم باق ولا تخ","تصيص فيه فالحكم للتقييد",243,"د",1,0],["إِنَّ بِالشامِ بِالمُوَقَّر عِزّاً","وَمُلوكاً مُبارَكينَ شُهودا",244,"د",2,1],["إنْ بزغَت شمس الحميا وإنْ","طافَتْ بكاسات المدام البدور",245,"ر",1,0],["إنْ بكيتُ الإِلْف أثناه النوى","فابكي يا أيّتها الوُرق معي",246,"ي",1,0],["إنَّ برقاً شِمتُه من جانب العا","رض الوسميّ أبكاني ابتساما",247,"م",2,0],["إنَّ بالشِّعب سقى الشّعبَ الحيا","زمناً مرَّ بوصل الغيد حالي",248,"ي",1,0],["أنبأت عنه وكنت أصدق لهجة","ويسرّني أني أقول فأصدق",249,"ق",1,0],["إنَّ بَني الحِصنِ استَحلَّت دِماءَهُم","بَنو أَسَدٍ حارِبُها ثُمَّ واِلبَه",250,"ب",2,1],["إن بعدي يا ميُّ انحل جسمي","وفؤادي بنار هجرك يصلي",251,"ل",2,0],["إن بلّغتك العيسُ نَجْدا","فازدَد بها كلفاً ووجْدا",252,"د",2,1],["أنبيتني عن مَنْ عَميمُ نوالِه","يستغرقُ المحرومُ والمرْزوقا",253,"ق",2,0],["ان بدا وجهك ليلا ينجلي","أو نهارا فهو نور فوق نور",254,"ر",1,0],["أنبلغ النجح والأقوام يجمعها","شمل وصحبك بالتفكيك قد نادوا",255,"د",3,0],["أنبتت اجامها أهرامها","وجرى الماء إليها واندفع",256,"ع",1,0],["إنّ بيروت روضة العلم لكن","أنت بدرٌ حللت منها سماها",257,"ا",3,0],["إِن بان ثانيه فأمر لما","يعصيك فيه الرشأ الهاجر",258,"ر",1,0],["أنبلتْها وهي لا سهمَ لها","إنما ألحاظُها يَكفينها",259,"ن",3,0],["أنِّبه طَرفي وهو يُخدَع بالحُلْمِ","وأصدُقُ نفسي وهي تقنَع بالرَّجْمِ",260,"م",1,1],["أن بني أيَوبَ من","غَشْم الخطوب عِصمُ",261,"م",1,0],["إن بُزَّ منها المهرجانُ الذي","ودَّعَ أو عُطِّلَ فالعيدُ حالْ",262,"ل",1,0],["أنبت الدهرُ غلاماً منهمُ","عاقلَ الجود إذا قال فعلْ",263,"ل",1,0],["أَنبطْتُها من ثَغَبٍ ماؤُه","شريعةٌ قبليَ لم تُطرقِ",264,"ق",1,0],["إن باح بالسرّ لأهجرنَّهُ","عاقبْ بغير الهجر فالهجرُ سَرَفْ",265,"ف",1,0],["إن بَلِيَتْ أعراضُ قومٍ أو خبتْ","يوماً فغطّت صحّةً بلَبْسِ",266,"س",1,0],["أن بني عبد الرحي","م نِعْمَ كنزُ المدَّخرْ",267,"ر",1,0],["إن بدأا تمّم أو نَقصُوا","أنعمَ أو حطُّوا عُلاً شيَّدا",268,"د",2,0],["أن بري جسمي سقامٌ عارقٌ","فبحب المجد لا حُبِّ سُعاد",269,"د",1,0],["إنَّ بني الصَّاحِبِ قد فاتَهُمْ","أرْوَعُ مِثلُ العَلَمِ الزَّاهِرِ",270,"ر",1,0],["أ ُنْبيكَ أنَّا بِعَين ٍنِصْفِ مُغمَضَة ٍ","نَغفو،وبالكَفِّ فَوقَ الكَفِّ تَطمينا",271,"ن",2,0],["أ ُنْبيكَ أنَّا ، وَإنْ قُصَّتْ قَوادِمُنا","لم نَألُ نَشهَقُ ما اسْطاعَتْ خَوافينا",271,"ن",2,0],["إِن بَدا مِنهُ خُروجٌ","خَرَجَت نَفسُ النَشاطِ",272,"ط",1,0],["إِن بَدَتِ الصَحراءُ مِن وَجهِهِ","فاحَ لَها مِن وَجهِهِ قَبرُ",273,"ر",1,0],["أنبل الأسياف... حرفٌ من فمك","عن أناشيد الغجر !",274,"ر",1,0],["إِنَّ بُحَيراً عَبدٌ لِغَيرِكُمُ","يا مالُ وَالحَقُّ عِندَهُ فَقِفوا",275,"ف",3,0],["إِنَّ بَني أَودٍ هُمُ ماهُمُ","لِلحَربِ أَو لِلجَدبِ عامَ الشَموس",276,"س",1,0],["ان بني الدنيا جميعاً في غرر","وأمل النفع ولم يخش الضرر",277,"ر",1,0],["إِن بارَزتَكَ كَماةُ الرومُ فَاِرمِهِم","بِسَهمِ عَينَيكَ تَقتُل كُلَّ مَن برَزا",278,"ز",2,0],["إن بَدا ظاهِراً أَقامَ ظُهوراً","منه يُجْلى مَقامُهُ للعَيَانِ",279,"ن",1,0],["إنْ باعَدوا منزِلاً يَزهو برَوْنَقِهِمْ","كأنَّهُمْ فيه باتوا أيْنَما كانُوا",280,"ن",3,0],["إن بني رزيك حلوا ذروة ال","عز وحل الناس في وهاده",281,"د",2,0],["إن بني رزيك لما أن سطت","أيمانهم منك بعضب باتر",282,"ر",1,0],["أنبا علي في الورى مشهورة","بالبأس والتقوى وبذل نوالها",283,"ل",3,0],["إن بات من عدد الملوك فإنه","لا يستوي نار الغضا ودخانها",284,"ن",3,0],["إن بَزّهُمْ شَيْئاً ذُبابٌ فَما","في وُسْعِهِمْ إرْجاعُ ما يَنْزِعُ",285,"ع",1,0],["إن بالمُختَلِّ مَسّاً","غَرَّهُ حِلمُ فرَنسا",286,"س",2,0],["انبِض بعِيد العرشِ عرشِ مسَرَّةٍ","للشعبِ من شُبَّانه والشِّيبِ",287,"ب",1,0],["أُنْبِيكَ : ما زال هذا الكونُ محكمةً","تقضي بتقطيعِ أيدي غير مَنْ سَرَقوا !",288,"ق",3,0],["إنْ بتِّ آمنةً مِنّا عليك كما","شاء العَفافُ فإنّا ما أمِنّاكِ",289,"ك",1,0],["إنّ بالزَّوْراءِ دارَ أُناسٍ","أُنْشَقُ الشّرَّ بها وأُساقى",290,"ق",2,0],["إن بدا فيه فنينا وإذا","ما اختفى عنا بقينا يا أُخَيّ",291,"ي",1,0],["إن بالرقمتين لي قربَ عهد","تحت ظل الأراكة الفينانه",292,"ن",2,0],["إن بدت أفنت الجميع بوجه","مشرق زان حسنه الإحسان",293,"ن",1,0],["إن بدت صلى الأنام لها","وإذا ما أومأت ركعوا",294,"ع",3,0],["إن بشرٍّ قد مُسَّ كان يؤوساً","وبخير إن مُسَّ غير يؤوس",295,"س",1,0],["أنبوب روحي وأنبوب الجسد كوثرْ","يسن موسى الهوى للخلق يا كوثرْ",296,"ر",1,0],["إن بين الوجود والموجودِ","حرف ميم بها مدار الشهودِ",297,"د",1,1],["إن بعت ما تلقاه أنت هو الثمن","أنت الحفيظ على الجميع المؤتمن",298,"ن",1,0],["إن بحر الوجود بالإختلاجِ","لم يزل مكثراً من الأمواجِ",299,"ج",1,1],["أنبئت ان يا ذا الفضل تذكرني","ولي بذلك تشريف وإعلاء",300,"ا",2,0],["إن بني العم على المقاربة","كذاك يدعون على المناسبة",301,"ه",1,0],["أَنْبَتَ لي الحَبُّ به","أَلف جَرِيبٍ جَرَابا",302,"ب",2,0],["إِن بَدا وجهُه فأَبْعَدُ شَيءٍ","من مُعَنَّاه غفلُه واختِيارُه",303,"ر",2,0],["إِنْ بَدا شَخْصُه فَشَمْسٌ وبَدْرٌ","أَوْ جَرَى ذِكْرُه فَمِسْكٌ وَعَنْبَر",304,"ر",1,0],["إن بُني من رجال الحمس","كريم أصل وكريم نفس",305,"س",1,1],["إن بني معرقٌ كريم","محببٌ في أهله حليم",306,"م",1,1]]}