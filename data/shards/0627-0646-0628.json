,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[67,"حَيَّ بُلْبَيْسَ مَنْزِلاً في العِمارهْ","https://www.poetsgate.com/ViewPoem.aspx?id=14533",""],[90,"أحيِّيك طه","https://www.poetsgate.com/ViewPoem.aspx?id=179200",""],[90,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[45,"ذاكَ وَادي الأرَاكِ فاحبِسْ قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=32098",""],[45,"أمّا الشّبَابُ فَقَدْ سُبِقْتَ بغَضّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31122",""],[91,"الى الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=53275",""],[99,"إلى بيروت الأنثى مع الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=215333",""],[31,"يا ربِّ، إنكَ قد علمتَ بأنها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19098&r=&rc=360",""],[18,"بَاتَ لَيْلِي بِالأَنْعَمَيْنِ طَوِيلاَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26456&r=&rc=22",""]],"verses":[["أَنبَطتُ مِن حُسنِها ماءً بِلا نَصَبٍ","وَحُزتُ مِن نَظمِها دُرّاً بِلا ثَمَنِ",0,"ن",1,0],["إِنَّ بَينَ الحِمى إِلى جانِبِ الرَم","لِ مَعاناً مِنَ الظِباءِ الهيفِ",1,"ف",1,0],["اِنبَتَّ بَعدَكَ حَبلُنا وَحَدَت","كُلّاً لِطيَّتِهِ نَوىً قُذُفُ",2,"ف",1,0],["إِنَّ بَهاءَ المُلكِ إِن أَدعُهُ","وَالخَطبُ قَد نازَلَني يَمنَعِ",3,"ع",1,0],["إِنَّ بَنو الدُنيا تَسيرُ رِكابُنا","وَتُغالِطُ الإِدلاجَ وَالإِسراءَ",4,"ا",2,0],["إِنَّ بَرْحَ الغَرامِ يَنْزِفُ دَمْعاً","راضَ شَوْقي إِباءَهُ في التَّصابِي",5,"ي",1,0],["أَنبَتَ اللَهُ رَوضَةَ الحُبَّ في قَل","بي تَرودُ الهُمومُ فيهِ رِتاعا",6,"ع",2,0],["أُنبِئتُها صَرَخَت لَمّا رَأَت أَسَداً","في خاتَمٍ صَوَّروهُ أَيَّ تَصويرِ",7,"ر",1,0],["إِنَّ بِالشَطِّ نَحوَ دارِ المُعَلّى","لَغَزالاً إِلى القُلوبِ حَبيبا",8,"ب",2,1],["أُنبِئتُ أَنَّ لِخالي هَجمَةً حُبسا","كَأَنَّهُنَّ بِجَنبِ المَشعَرِ النُصُلُ",9,"ل",1,1],["إنْ بَطَشَ الدّهْرُ بقوْمٍ حمَوْا","أو تعْثُرِ الأيّامُ قالوا لَعا",10,"ع",2,0],["إنْ بانَ منْزِلُهُ وشطّتْ دارُهُ","قامتْ مَقامَ عِيانِهِ أخْبارُهُ",11,"ر",2,1],["إن بِنْتَ فاسْمَحْ لي برَجعِ تحيّةٍ","أو غِبْتَ فابْعَثْ بالخَيالِ يَعودُ",12,"د",1,0],["إِنَّ بَني قَميئةَ بنِ سَعدِ","كُلُّهُمُ لِمِلصَقٍ وَعَبدِ",13,"د",1,1],["أُنبِئتُ أَنَّ رَسولَ اللَهِ أَوعَدَني","وَالعَفُوُ عِندَ رَسولِ اللَهِ مَأمولُ",14,"ل",1,0],["إِن بَكَت غَيرَكَ النِساءُ وَأَذرَف","نَ عَلَيهِ الدُموعَ مِثلَ اللَآلي",15,"ل",2,0],["إِن بَريئاً وَإِن أَثيماً سَتُجزى","يَومَ تُجزى أَمامَ رَبٍّ شَهيدِ",16,"د",1,0],["إِنَّ بي شَوقاً إِلى ذي غُنَّةٍ","يُؤنِسُ النَفسَ وَقَد نامَ السَمَر",17,"ر",1,0],["إِن بَدَّلوا أَوَّلَهُ آخِراً","وَبَدَّلوا الثاني بِالآخِرِ",18,"ر",1,1],["إِنْ بَعَثَتْهَا الأَوْتَارُ رَدَّتْ","تِلْكَ الأَغَارِيدَ فِي حَنَانِ",19,"ن",1,0],["إِنْ بَاتَ فِي حُجُبٍ بَاءَتْ إِلَى نُصُبٍ","يَلُوخُ مِنْهُ لَهَا مَعْبُودُهَا الجَانِي",20,"ن",2,0],["إِنَّ بِالشَّرْقِ بَعْدَ سَرْكِيسَ شَجْواً","شَرقَتْ بِالدِّمَاءِ مِنْهُ الجُفُونُ",21,"ن",1,0],["إِنْ بَانَ شَاعِرُهُمْ فَغُرُّ فِعَالِهِمْ","شِعْرٌ وَمَا الأَبْحَارُ وَالأَوْزَانُ",22,"ن",1,0],["أَنْبِتْهُمُ اللَّهُمَّ نَبْتاً صَالِحاً","وَتَوَلَّهُمْ بِالْفَضْلِ وَالإحْسَانِ",23,"ن",1,0],["إِنْ بَكَى الشَّرْقُ فَالمُصَابُ أَلِيمُ","وَقَلِيلٌ فِيهِ الأَدِيبُ العَلِيمُ",24,"م",1,1],["إِن بَدَت حاجَةٌ لَهُ ذَكَرَ الضَي","فَ وَيَنساهُ عِندَ وَقتِ الغَداءِ",25,"ا",2,0],["إِنَّ بَني طَوقٍ لَأُعجوبَةٌ","تَحارُ في وَصفِهِمُ الفِكرَه",26,"ر",2,1],["أن بليلاً من نسيم السحر","لمّا جرى في المربع المخمل",27,"ل",1,1],["إن بصدري للقريض لفَوْرةً","يزيد بها من طول غفلتكم نفثي",28,"ي",1,0],["أن بقينا هكذا فأحتجبي","عن بني الغبراء أو فانكسفي",29,"ي",1,0],["إن بكاه الدين الحنيفي شجواً","فلأن كان ركنه وأساسه",30,"س",2,0],["أُنبِئتُ تَغلِبَ بَعدَما جَدَّعتُهُم","يَتَعَذَّرونَ وَما لَهُم مِن عاذِرِ",31,"ر",1,0],["إِنَّ بِلالاً لَم تَشِنهُ أُمُّهُ","لَم يَتَناسَب خالُهُ وَعَمُّهُ",32,"م",2,1],["أُنبِئتُ أَنَّكَ يا اِبنَ وَردَةَ آلِفٌ","لِبَني حُدَيَّةَ مُقعَداً وَمُقاما",33,"م",2,0],["أُنبِئتُ أَنَّ أَبا حَنيفٍ","لامَني في اللائِمينا",34,"ن",2,1],["إِنَّ بَني عَبدِ وُدٍّ كُلَّما وَقَعَت","إِحدى الهَناتِ أَتَوها غَيرَ أَغمارِ",35,"ر",1,0],["إِنَّ بَني العَمِّ لَستَ تَخلُفُهُم","إِن عادَتِ الأُسدُ عادَ أَشبُلُها",36,"ل",3,0],["إِنَّ بِها كُلَّ عَميمِ النَدى","يَداهُ لِلجودِ يَنابيعُ",37,"ع",1,0],["أَنَّ بَني عَمّي وَحاشاهُمُ","شَعبُهُم بِالخُلفِ مَصدوعُ",37,"ع",1,0],["أَنَبذِلُ الوُدَّ لِأَعدائِنا","وَهوَ عَنِ الإِخَوَةِ مَمنوعُ",37,"ع",1,0],["أنبتته نعمى الصفيّ وأحيت","ذكرَ أسلافه فسرت نباته",38,"ت",2,0],["إن بتُّ في مزْج ذكراه فإنيَ من","همِّ التباعد في هرْجٍ وفي مرْج",39,"ج",1,0],["أنبت أزهارها ودللها قطفا","من بعد ما كادَ أن يزلزلها خسفا",40,"ف",2,0],["إِنَّ بَيتاً أَنتَ ساكِنُهُ","غَيرُ مُحتاجٍ إِلى السُرُجِ",41,"ج",1,0],["إن بَحْثَ الطَّبيبِ عنْ داءِ ذي الدَّا","ءِ لَأُسُّ الشِّفاءِ قبل الشفاءِ",42,"ا",2,0],["إنَّ بخس الثواب إن دام ظلماً","قَلَب المدحَ ذاتَ يومٍ هجاءَ",43,"ا",2,0],["إن بحراً يُمِدُّ بحراً بشعْبٍ","فيه أدنى صُبابةٍ لَعُجابُ",44,"ب",1,0],["إن بيتَ الفتاة بيتُ سِفاحٍ","كلما شئتَ فيه نيكاً وجدتا",45,"ت",2,0],["إن بَعُدت كان العمى حاضراً","وإن دنت بان طريق الهدى",46,"د",2,0],["إن برزت للهواء غيرها","أو قُرِعَتْ بالمزاج كدَّرها",47,"ر",3,0],["أنبئتُ أنك يا يعقوب مبترِكٌ","تُقصِّد الشعرَ في سبي وترتجز",48,"ز",1,0],["أنِبْ إلى قاسمٍ وإلا","فالله عَوْنٌ على الغشومِ",49,"م",1,0],["إِنَّ بَني زَيدٍ مَليحو الشَكلِ","كَم فيهِمِ مِن فَعلَةٍ وَفَعلِ",50,"ل",1,1],["أَنبَتَت حَولَكَ الزُهورُ الغَوادي","وَاللَيالي أَنبَتنَ حَولي القَتادا",51,"ا",1,0],["إِن بُحتُ بِالشَكوى فَغايَةُ مُجهَدٍ","لَم تُبقي لي كَبِداً فَأَستَبقيكِ",52,"ك",1,0],["إِن بُدِّلَت مِنها التُخومُ فَإِنَّها","ما بَدَّلَت وَاللَهِ غَيرَ تُخومِها",53,"م",3,0],["إِن باحَ لَم تَسلَم كَرامَتُهُ","وَالإِثمُ كُلُّ الإِثمِ إِن كَتَما",54,"م",2,0],["إِن بُنتُمُ عَنهُ فَما زالَ الهَوى","يُدنيكُمُ مِنهُ كَما يُدنيني",55,"ي",1,0],["إِنَّ بَعضَ الظَنِّ إِثمٌ","صَدَقَ اللَهُ تَعالى",56,"ل",2,0],["إِنَّ بِالشّعبِ الذي دونَ سلعٍ","لَقتيلاً دَمُه ما يُطَلُّ",57,"ل",1,1],["أَنباءُ أَسرك قَد طَبّقن آفاقا","بَل قَد عَمَّمن جِهاتِ الأَرضِ إِقلاقا",58,"ق",2,1],["ان بين العقول حربا عوانا","نارها لا تزال ذات اشتعال",59,"ل",1,0],["ان بين الذين يحيون فوق","الارض حربا على البقاء طحونا",60,"ن",2,0],["ان بحرا لا تبتغي فيه خوضا","ليس في ضير ان يكون عميقا",61,"ق",2,0],["إن بصيصي كله","من بعض ذلك السنى",62,"ن",2,0],["أُنبِئتُ أَنَّ سُلَيمانَ الزَمانِ وَمَن","أَصبى الطُيورَ فَناجَتهُ وَناجاها",63,"ا",3,1],["إِنْ بُحْتُ يوماً طُلَّ فيه دَمي","ولَئِنْ كَتَمْتُ يَضِقْ بهِ صَدْرِي",64,"ر",2,0],["إِنَّ بَرقي إِذا بَرَقتَ فَعالي","وَصَليلي إِذا صَلَلتَ اِرتِجازي",65,"ي",1,0],["إِن بَرَقوا فَالحُتوفُ حاضِرَةٌ","أَو نَطَقوا فَالصَوابُ وَالحِكَمُ",66,"م",1,0],["إِنَّ بَعضاً مِنَ القَريضِ هُذاءٌ","لَيسَ شَيئاً وَبَعضَهُ أَحكامُ",67,"م",1,0],["أُنبئت أن سخيف العقل قال لكم","إن الذي شاء خلقي شاء سفك دمي",68,"ي",1,1],["إنَّ بني الحكمة الشريفة قد","أتاهم الله قدرة عجبا",69,"ب",2,0],["أُنَبّيكِ عَن عَيني وَطولِ سُهادِها","وَحَرقَةِ قَلبي بِالجَوى وَاِتِّقادِها",70,"د",3,1],["أَنبِل بِوَهبٍ أَنبِل بِضَرطَتِهِ","إِذ صَيَّرَ الناسُ ذِكرَها سَمَرا",71,"ر",2,1],["أَنبَوتُ عَنكَ بِزَعمِهِم وَمَتى نَبا","في حالَةٍ بَعضُ اِمرِئٍ عَن بَعضِهِ",72,"ض",2,0],["إِن بَلَوناكَ كُنتَ واحِدَ آحا","دٍ لَهُم كَثرَةٌ عَلى الآلافِ",73,"ف",1,0],["إِنَّ بَينَ الكَثيبِ فَالجَزعِ فَالآ","رامِ رَبعاً لِآلِ هِندٍ مُحيلا",74,"ل",2,0],["أُنَبِّهُها وَهناً وَفي فَضلِ مِرطِها","مُصابٌ قُواهُ بِالنُعاسِ قَتيلُ",75,"ل",1,0],["إِن بَذَلنا لَهُ اِقتِصاراً عَلَيها","جازَ عَنها إِلى جَزيلِ نَوالِه",76,"ل",2,0],["أُنبيكَ عَن طَولِ الأَميرِ وَفَضلِهِ","وَعَن جَدِّهِ في المَكرُماتِ وَهَزلِهِ",77,"ل",2,1],["أُنبِئتُها بِالغَيبِ ثُمَّ رَأَيتُها","تَدنو مَسافَتُها وَيَصغُرُ شانُها",78,"ن",3,0],["إِنَّ بِلالاً إِن تُلاقيهِ سالِماً","كَفاكِ الَّذي تَخشَينَ مِن كُلِّ جانِبِ",79,"ب",1,1],["إِنَّ بُغائي لِلَّذي إِن أَرادَني","مَكانَ الثُرَيّا إِن تَأَمَّلَها البَصَر",80,"ر",1,1],["أُنبِئتُ أَنَّ العَبدَ أَمسِ اِبنَ زَهدَمٍ","يَطوفُ وَلِلغيني لَهُ كُلُّ تِنبالِ",81,"ل",1,1],["أُنَبِّئكَ ما قَد يَعلَمُ الناسُ كُلُّهُم","وَما جاهِلٌ شَيئاً كَمَن هُوَ عالِمُه",82,"م",2,0],["أُنبِئكَ عَنهُم غَيرَ ما تَكذابِ","بِأَنَّهُم أَوعِيَةُ الكِتابِ",83,"ب",1,0],["أَنَ بِاللَهِ وَحدَهُ وَإِلَيهِ","إِنَّما الخَيرُ كُلُّهُ في يَدَيهِ",84,"ي",2,1],["إِنَّ بَذلي لَها لَبَذلُ جَوادٍ","وَاِقتِنائي لَها اِقتِناءُ شَحيحِ",85,"ح",1,0],["أَنبَأَتنا الأَنباءَ عَن سالِفي الدَه","رِ وَعَدَّت لَنا القُرونَ القُروما",86,"م",2,0],["إِن بَكى يُحَقُّ لَهُ","لَيسَ ما بِهِ لَعِبُ",87,"ب",1,0],["إِن بِاشَرَتها أَقارِبي بِيَدٍ","يَوماً فَلي دونَهُم يَدٌ وَفَمُ",88,"م",1,0],["أنْبَتَ الدهرُ في المفارقِ شيباً","بِهُمومٍ في مُضْمَرِالقلبِ يُزْرَع",89,"ع",1,0],["إنَّ بَحرَيْك عَلى عَظمِهِما","حَسَدا كفَّيك في فيضِ السّماح",90,"ح",1,0],["أُنبِئتُ عَبدُ اللَهِ أَصبَحَ يُعوِلُ","إِنَّ الزَمانَ بِأَهلِهِ مُتَنَقِّلُ",91,"ل",1,1],["إِنَّ بَقاءَ الجَوادِ أَحمَدَ في","أَعناقِنا مِنَّةٌ مِنَ المِنَنِ",92,"ن",1,0],["إِنَّ بُكاءً في الدارِ مِن أَرَبِه","فَشايِعا مُغرَماً عَلى طَرَبِه",93,"ب",2,1],["أَنبَطتُ في قَلبي لِوَأيِكَ مَشرَعاً","ظَلَّت تَحومُ عَلَيهِ طَيرُ رَجائي",94,"ا",2,0],["أَنْبَتَ الْحُسْنُ فَوْقَ خَدَّيْهِ وَرْدَاً","لَيْسَ إِلَّا بِغَمْزَةِ اللَّحْظِ يُجْنَى",95,"ن",2,0],["إِنَّ بَيْتَ الْوَزَّانِ لَمْ يَزِنُوا شَيْ","ئاً وَلَكِنَّ فِيهِمْ عَلَى ذَاكَ ثِقْلُ",96,"ل",1,0],["إنَّ بالشامِ لبرْداً يابساً","عابساً يخشاهُ مَنْ فيهِ أقاما",97,"م",2,1],["إِنَّ بي داخِلاً مِنَ الحُبِّ قَد أَب","لى عِظامي مَكنونُهُ وَبَراني",98,"ي",1,0],["أُنبِئتُ أَنَّكِ إِذ أَتاكِ كِتابُنا","أَعرَضتِ عِندَ قِراتِكِ العُنوانا",99,"ن",2,0],["أَن بِت لَدينا لَيلَةً","نُحي بِها وَنُلطِفُ",100,"ف",1,0],["انْبعِثْ في الأرضِ يا وَحْيَ السَّماءْ","واسْرِ يا نُورَ الهُدَى مِلءَ الفَضاءْ",101,"ا",2,1],["انْبَعِثْ كالرُّوحِ يا رُوحَ الرَّجاءْ","وامْلأ الأكوانَ مِثلَ الكهرباءْ",101,"ا",2,0],["إنّ بالخزّانِ مِن أصحابِها","ما بِمصرٍ مِن هُمومٍ ثائرهْ",102,"ر",2,0],["إِنَّ بِالنيلِ غَمرَةً تَتَمادى","وَأَرى كُلَّ غَمرَةٍ تَتَجَلّى",103,"ل",2,0],["إِن بَلَوتُم مِنهُم فَريقاً فإنا","قَد رَمانا باثنين هَذا الزَمان",104,"ن",1,0],["أَنبَتوا مِن مَعاشرٍ شَعرَ","الرَأسِ وَهُم أَلحَقوهُمُ المَنَعَه",105,"ع",2,0],["إِنَّ بِمَعنٍ إِن فَخَرتَ لَمَفخَراً","وَفي غَيرِها تُبنى بُيوتُ المَكارِمِ",106,"م",1,1],["أَنَبا بِحاجَتِكَ الأَميرُ وَمَدَّهُ","في ذاكَ قَومٌ كاشِحونَ فَأَجهَدوا",107,"د",3,0],["أَنبَتَ الدَهرُ لَنا","كُلَّ شَيءٍ فَرَطا",108,"ط",2,0],["إِن بُحتَ بِاِسمِكَ فَهوَ يَقتُلُني","وَهُناكَ تُثكَلُ مِنِّيَ الثَكلى",109,"ا",1,0],["إنْ بدا شمساً وصاروا نجوما","وطَمَى بحراً وفرُّوا ثِغابا",110,"ب",2,0],["إِنَّ بَيْتِي يقول قد طالَ عَهْدِي","بِدُخُولِ التَلِّيسِ لِي وَالشِّكَارَهْ",111,"ر",2,0],["إنَّ بَيْتَاً يغْشَاهُ كلُّ فقِيرٍ","مِنْ عَلِيٍّ في ذِمَّةٍ وَخِفَارَهْ",111,"ر",2,0],["أَنْبَا سَطِيحٌ وشِقٌّ وَابْنُ ذِي يَزَنٍ","عنه وقُسٌّ وَأَحبارٌ مَقاوِيلُ",112,"ل",1,0],["أنْبَتَ العِزُّ منكَ في بَيْتِ نَفْسِي","وَالغِنَى مِنْ يَدَيْكَ في بيتِ مالِي",113,"ل",2,0],["أُنبِئتُ أَنَّ أَبا جَدّي تَخَيَّرَها","مِن ذُخرِ آدَمَ أَو مِن ذُخرِ حَوّاءِ",114,"ا",2,0],["أَنبَأتُهُ أَنّي مُحِبٌّ لَهُ","فَكانَ هِجراني مُجازاتُه",115,"ت",2,0],["إِنَّ بَيني وَبَينَهُنَّ أَبا عَم","روٍ كَفاني عِزّاً وَكَهفاً وَطَودا",116,"د",2,0],["إِنَّ بِشَطِّ الفُراتِ لي سَكَناً","يَبلُغُ غَيظي بِكُلِّ ما وَسِعا",117,"ع",2,0],["إن باركَ اللَه في الأنام فلا","باركَ ربّ الأنام في سلمَه",118,"م",2,1],["إن بازي بازُّ جوٍّ","يصرعُ الطيرَ العظاما",119,"م",2,0],["إن بان إلفٌ فواصلُ سواهُ","ودع عنكَ كلّ فتىً ميلَع",120,"ع",1,0],["أَنبَتَ الريشَ في جَناحَيهِ حَتّى","عادَ وَحفا وَطارَ كُلَّ مَطيرِ",121,"ر",1,0],["إِن بَرَدَت عَن كَبِدي لَوعَةٌ","طالَت عَلى القَلبِ فَلَم تَبرُدِ",122,"د",1,0],["أُنبِئتُ أَنَّ أَبا قابوسَ أَوعَدَني","وَلا قَرارَ عَلى زَأرٍ مِنَ الأَسَدِ",123,"د",1,0],["أَنبَأَنا اللُبُّ بِلُقيا الرَدى","فَالغَوثُ مِن صِحَّةِ ذاكَ النَبَأ",124,"ب",2,0],["إِن بَشَّرَتَ بِدُموعٍ فَهيَ صادِقَةٌ","أَو خَبَّرَت بِسُرورٍ قُلتَ لا يَلِجُ",125,"ج",1,0],["إِنبَه وَسُد فَهُما هَمٌّ تُكابِدُهُ","وَاِخمُل إِذا شِئتَ أَن تَحظى وَلا تَسدِ",126,"د",1,0],["أُنبِئتُ أَنَّ بَني جَديلَةَ أَوعَبوا","نُفراءَ مِن سَلمى لَنا وَتَكَتَّبوا",127,"ب",3,1],["إِن بُدِّلَت أَهلُها وُحوشاً","وَغَيَّرَت حالَها الخُطوبُ",128,"ب",1,0],["إِنَّ بحث الحَياة وَالمَرء إن ما","ت جماد من أغمض الأبحاث",129,"ث",1,1],["إن بعضاً من الظنو","ن لكالفجر صادق",130,"ق",1,1],["إن بين النهرين والأرض تشقى","لجناناً تبدَّلت فلَوات",131,"ت",1,0],["إن بين المَريخ وَالمُشتَري مِن","ها نجيماتٌ هنَّ غير بطاء",132,"ا",2,0],["أَنبت الغيث في المهابط منها","شجرات مَع الرياح تَميل",133,"ل",1,0],["إن بَعُدَ الشطُّ فقد","آن له أن يَقرُبا",134,"ب",2,0],["أُنَبّئُكمْ أنّي على العَهْدِ سالمٌ","ووَجهِيَ لَمّا يُبْتَذَلْ بسُؤال",135,"ل",1,0],["إِنَّ بُقْيَا الفَتَى عَلَى الجِسْمِ وَالبُقْيَا","عَلَى المَالِ فِي الخِلالِ تُؤَامُ",136,"م",1,0],["إِنَّ بَغْدَادَ فِي حِلىً قَشْبٍ مِنْهُ","أُضِيفَتْ إِلى حَلاَهَا العِتَاقِ",137,"ق",1,0],["إِنَّ بَكَتْهُ وَأَجْمَعَتْ أُممُ الضا","دِ فَمَنْ مِثْلُهُ بِذَاك جَديرُ",138,"ر",1,0],["إِنَّ بُعْداً عَنْ كُل حَشْدٍ مُقِيمِينَ","لتَقْوَى وَرَاحَةٌ وَسُرُورُ",139,"ر",1,0],["إِنْ بَسَطَتْ لِلْبَذْلِ كَفّاً فَقَدْ","رَأَيْتَ ثَمَّ المُعْجِبَ المُذْهِلاَ",140,"ل",2,0],["إِنْ بِالشَّرْقِ رَوْضَةً مِنْ بَيَانٍ","بَرَزَتْ مِنْ حِلاَهُ فِي أَبْرَادِ",141,"د",1,0],["إِنَّ بِي لوْعةً مبَرِّحَةً","سِرُّهَا ما حَيِيْتُ لنْ يُفْشى",142,"ش",2,0],["أنبأتنا أنه لم يعقل","أيها العصر",143,"ر",1,0],["إِنَّ بَعضَ العِتابِ يَدعو إِلى العَت","بِ وَيُؤذي بِهِ المُحِبُّ الحَبيبا",144,"ب",2,0],["إِنَّ بَينَ الحَبيبِ قَد","عاقَكَ اليَومَ وَشكُه",145,"ه",1,0],["إِنَّ بَني عَوفَ اِبتَنوا حَسَباً","ضَيَّعَهُ الدُخلُلونَ إِذ غَدَروا",146,"ر",3,1],["إنّ بغدادَ للملوكِ محل","ومناخٌ للقارىءٍ الصيّاد",147,"د",1,0],["إنّ بعضَ السكوتِ خير من النط","ق وإن كنتَ بالكلام فصيحا",148,"ح",2,0],["أَنبتَّه خيرَ النباتِ يزَيِنُه","خُلُقٌ كأمواهِ السحابِ مُطَهَّرُ",149,"ر",1,0],["أنبَتَّ للأدب المهيض جناحُه","ريشًا، وشِدتَ جداره المتهدما",150,"م",2,0],["إنّ باب الرقيِّ فيه انخفاضٌ","ينحني فيه رأسُ من يَترقَّى",151,"ق",2,0],["إن بَكتْه العبقريات دَمًا","فَهْي من أوصافه منتزعه",152,"ع",2,0],["إنَّ بيتي يقول قد طال عهدي","بدخولِ التَلِّليس لي والشكاره",153,"ر",2,0],["إنَّ بتاً يغشاهُ كلُّ فقيرٍ","من عليٍّ في ذمة ٍ وخفاره",153,"ر",2,0],["أُنَبّيكَ أنَّ \" الرافدينِ \" تطلَّعتْ","ضِفافُهما واستَنْهضَ الشَّجرُ الزرعا",154,"ع",2,0],["ان بينَ الضُلوعِ ، مما استغلوه","بتضليلهم ، قلوباً حِرارا",155,"ر",2,0],["أُنّبِيكَ عن أطيبِ الأخبثينَ","فقُلْ أنتَ بالأخبثِ المُزدرى",156,"ا",1,0],["إنّ بعضَ الرجال يبدو أمامَ الحبِّ","صُلباً والأكثرون يذوب",157,"ب",1,0],["أُنبيكَ عن شرِّ الطّغامِ مَفاجراً","ومَفاخراً ، ومساعياً ومكاسبا",158,"ب",2,0],["أُنبِّيكَ أنّ الحِمى مُلْهَبٌ","وواديه من ألمٍ مُفعَم",159,"م",1,0],["إنّ بَينَ الكَثيبِ فالجِزْعِ فَال","رَامِ رَبْعاً لآلِ هِنْدٍ مُحيلا",160,"ل",2,0],["أنَبَوْتُ عَنْكَ بزَعْمِهِمْ؟ وَمَتى نَبا","في حَالَةٍ بَعضُ امرِىءٍ عَنْ بَعْضِهِ",161,"ض",2,0],["إن باح لم تسلم كرامته","والإثم كلّ إن كتما",162,"م",2,0],["إِنَّ بَيرُوتَ هِيَ الأُنثَى الَتِي","تَمنَحُ الخَصبَ وَتُعطِينَا الفُصُولاَ",163,"ل",2,0],["أُنْبِئْتُ أَنَّكِ، إذا أَتَاكِ كِتابُنا،","وَأَشَعْتِ عِنْدَ قِراتِهِ عِصْيانا",164,"ن",2,0],["أَنْبَضُوا مَعْجِسَ الْقِسِيِّ وَأَبْرَقْ","نا كما توعدُ الفحولُ الفحولاَ",165,"ل",2,0]]}