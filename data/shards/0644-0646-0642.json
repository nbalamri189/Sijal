{"poems":[[9,"أثوى وقصر ليلة ليزودا","https://www.aldiwan.net/poem21927.html","الكامل"],[95,"شارفت مصر وفيها كل ناضرة","https://www.aldiwan.net/poem11107.html","البسيط"],[95,"يا عائدون من الجهاد سلام","https://www.aldiwan.net/poem11295.html","الكامل"],[56,"لنقل الرمال وقطع الجبال","https://www.aldiwan.net/poem27413.html","المتقارب"],[60,"لنقل الصخر من قلل الجبال","https://www.aldiwan.net/poem30908.html","الوافر"],[186,"بعزمك لذ إذا عز النصير","https://www.aldiwan.net/poem67071.html","الوافر"],[422,"فؤاد كطرفك أمسى عليلا","https://www.aldiwan.net/poem54167.html","المتقارب"],[422,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39214","الكامل"],[900,"","https://poetry.dctabudhabi.ae/diwan/poem/131382","البسيط"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82358","السريع"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76120","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83246","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201547","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128881","المجتث"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125810","الكامل"],[4777,"الامر لله","https://www.poetsgate.com/ViewPoem.aspx?id=135260",""],[4778,"أضعنا القدس","https://www.poetsgate.com/ViewPoem.aspx?id=199872",""],[1663,"لن قرع الناعي قلوباً فصدعا","https://www.poetsgate.com/ViewPoem.aspx?id=93226",""],[4927,"معاقيل الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=79608",""],[5121,"لِلْكَرَوَانِ فُلَّة","https://www.poetsgate.com/ViewPoem.aspx?id=179415",""],[5185,"المزار ( إلى إيما )","https://www.poetsgate.com/ViewPoem.aspx?id=118746",""],[5314,"زورة للمغرب","https://www.poetsgate.com/ViewPoem.aspx?id=214748",""],[5897,"بشائر على أبواب المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=157555",""]],"verses":[["لَنُقاتِلَنَّكُمُ عَلى ما خَيَّلَت","وَلَنَجعَلَنَّ لِمَن بَغى وَتَمَرَّدا",0,"د",2,0],["لِنُقْلَةٍ يَبْدأُ العَيْشُ الجَدِيدُ بِهَا","وَيَكْلأُ اللهُ مَجرَاهَا وَمُرْسَاهَا",1,"ا",3,0],["لِنِقَابَةِ الزُّرَاعِ فَخْرٌ أَنَّهَا","تَرْعَى مَصَالِحِهُمْ وَذَاكَ ذِمَامِ",2,"م",1,0],["لَنَقلُ الرِمالِ وَقَطعُ الجِبالِ","وَشُربُ البِحارِ الَّتي تَصطَخِب",3,"ب",1,1],["لَنَقلُ الصَخرِ مِن قُلَلِ الجِبالِ","أَحَبُّ إِلَيَّ مِن مِنَنِ الرِجالِ",4,"ل",1,1],["لِنَقْفُ سَبيلَهم وَنجدُّ دَهراً","بِعَزمٍ لا يَملُّ وَلا يَخورُ",5,"ر",1,0],["لنقضي حقوق ديار عفت","ونبكي الديار فنسقي الطلولا",6,"ل",2,0],["لنقضي يا هُذَيْمُ بها حقوقاً","عَلينا واجباتٍ أن تؤدَّى",7,"د",2,0],["لنَقَعْتُ غُلَّةَ لَوْعَتي بِرُضابِها","ونَضَحْتُ وَرْدَ خُدودِها بِبُكائي",8,"ي",1,0],["لنقض حكم كما نصوا وأنت فتىً","من حدّث العصر لا من سالف الامم",9,"م",1,0],["لِنَقصُفِ اليَومَ وَنَلهو غَداً","طَوراً أُغَنّي وَتُغَنّوني",10,"ن",2,0],["لِنقضي بِها ما فاتَ مِن طِيبِ أُنسِنا","بِها وَنَنالَ الجَمع بَعدَ شَتاتِ",11,"ت",1,0],["لِنُقيمَ أَصلاباً وَنَحفَظَ أُسرَةً","وَنُهَيِّئَ الأَقواتَ لِلأَبناءِ",12,"ا",2,0],["لنقدك يهفو كلُّ وانٍ وعاجز","فنقدك يشفي كل عيٍّ وناقص",13,"ص",1,0],["لنقل ما ادخروه","من حنطة وشعير",14,"ر",1,0],["لنقلِ الثقاتِ عنهُ وهو كتابهُ","أعزُّ كتابٍ في الحديثِ وأحكمُ",15,"م",1,0],["لنقومَ في الوطن العزيز بنهضة","مع فتية هي روحه ونَواته",16,"ت",2,0],["لن قلت ربي قسَّم العمر عمرين","والعمر بالدنيا قريبٍ محانه",17,"ن",2,0],["لنقطع سرمد الأيام لهوا","كما في الأمس كنا الملتهينا",18,"ن",2,0],["لن قرع الناعي قلوباً فصدعا","وغار عيوناً بالبكاء وأدمعا",19,"ع",2,1],["لِنَقْرَأَ فِي السِّفْرِ مَأْسَاْةَ شَعْبٍ","عَظِيْمِ النَّفِيْرِ إِذَاْ مَاْ نَفَرْ",20,"ر",1,0],["لِنَقُولَ لِلْكَرَوَانِ فِي بُسْتَانِنَا","يَا حَيَّهَلَّا قَدْ حَطَطْتَ نَمِيِرَا",21,"ر",2,0],["لنقولَ إنكِ قد أضأتِ طريقنا","أنتِ الدليل ، وأنتِ أنتِ الدار",22,"ر",1,0],["لنقولَ إنكِ قد زرعتِ قلوبنا","وبذاك تشهد جنة وثمار",22,"ر",1,0],["لنقتضي مثلا دكت مضاربه","كل البقاع بديعا وحيه الساري",23,"ر",2,0],["لنقيمَ من أرضِ المدينةِ للهدى","مُلكاً أطاحَ بسامقِ الشرُفَاتِ",24,"ت",1,0]]}