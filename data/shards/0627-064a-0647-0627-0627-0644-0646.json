ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=142772",""],[4767,"ساعات الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=129785",""],[4785,"وقفة على الشاطئ","https://www.poetsgate.com/ViewPoem.aspx?id=12037",""],[4578,"قلَ الريحان في الورد أجاد","https://www.poetsgate.com/ViewPoem.aspx?id=49392",""],[4888,"مطر يغسل النفوس","https://www.poetsgate.com/ViewPoem.aspx?id=207677",""],[3591,"يا أمير البلاد أهدي سلاماً","https://www.poetsgate.com/ViewPoem.aspx?id=149442",""],[5111,"أيُّها النّسيانُ","https://www.poetsgate.com/ViewPoem.aspx?id=212366",""],[5183,"لن تراني","https://www.poetsgate.com/ViewPoem.aspx?id=180161",""],[5190,"الناعقون","https://www.poetsgate.com/ViewPoem.aspx?id=153357",""],[5213,"أيها النوري طأطىء","https://www.poetsgate.com/ViewPoem.aspx?id=170508",""],[5246,"أيها الناس هل علي ملام","https://www.poetsgate.com/ViewPoem.aspx?id=187027",""],[5277,"كان قلبي نازحاً","https://www.poetsgate.com/ViewPoem.aspx?id=208599",""],[5358,"الأعْراف","https://www.poetsgate.com/ViewPoem.aspx?id=28586",""],[5409,"يا رواق المجلس الحا","https://www.poetsgate.com/ViewPoem.aspx?id=155291",""],[5542,"شاهد التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=10069",""],[5561,"ضفاف دجلة","https://www.poetsgate.com/ViewPoem.aspx?id=197385",""],[5582,"شَرَعَ الحُبُّ لَهُ ما شَرَعا","https://www.poetsgate.com/ViewPoem.aspx?id=63529",""],[243,"دجلة الغضبى","https://www.poetsgate.com/ViewPoem.aspx?id=50472",""],[5725,"طرفك","https://www.poetsgate.com/ViewPoem.aspx?id=177418",""],[5725,"ايها الناظم المخانق عقدا","https://www.poetsgate.com/ViewPoem.aspx?id=213048",""],[402,"أيها النائمون في الشرق من خفض","https://www.poetsgate.com/ViewPoem.aspx?id=36256",""],[5944,"أيها الناي","https://www.poetsgate.com/ViewPoem.aspx?id=212711",""],[5970,"عيل صبري من تباريح أسي","https://www.poetsgate.com/ViewPoem.aspx?id=130609",""],[5970,"أيها النائحون خلوا نواحا","https://www.poetsgate.com/ViewPoem.aspx?id=130607",""],[6055,"إلى الحداثة....مع التحية","https://www.poetsgate.com/ViewPoem.aspx?id=30577",""],[6102,"بَراءَةُ الذِّئب !!","https://www.poetsgate.com/ViewPoem.aspx?id=183166",""],[6102,"ذَبح !!","https://www.poetsgate.com/ViewPoem.aspx?id=183996",""],[6102,"فُرات !!","https://www.poetsgate.com/ViewPoem.aspx?id=184551",""],[6102,"مِزَعُ الشَّرِّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=185056",""],[6152,"زمان الطيبين","https://www.poetsgate.com/ViewPoem.aspx?id=203747",""],[5309,"أيها الناس نحن كالذرات","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573796",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""]],"verses":[["أَيُّها الناطِقُ المُرَقِّشُ عَنّا","عِندَ عَمرَوٍ وَهَل لِذاكَ بَقَاءُ",0,"ا",2,0],["أَيُّها النادِبُ قَوماً هَلَكوا","صارَتِ الأَرضُ عَلَيهِم طَبَقا",1,"ق",2,0],["أَيُّها النيلُ لَقَد جَلَّ الأَسى","كُن مِداداً لي إِذا الدَمعُ نَفِد",2,"د",1,0],["أَيُّها النيلُ كَيفَ نُمسي عِطاشاً","في بِلادٍ رَوَّيتَ فيها الأَناما",3,"م",2,0],["أَيُّها الناسُ إِن يَكُن ذاكَ سُخطُ ال","أَرضِ ماذا يَكونُ سُخطُ السَماءِ",4,"ا",2,0],["أيها النائمون في الشرق ما شا","ؤا وفي الغرب أعين لا تنام",5,"م",1,0],["أَيُّهَا النَّاصِرُونَ لِلعِلْمِ أَحْسَنْ","تُمْ لَعَمْرِي نِهَايَةَ الإِحْسَانِ",6,"ن",1,1],["أَيُّهَا النَّاعِمُونَ إِنْ تَشْكُرُوا اللهَ","كَمَا يَنْبَغِي لَهُ لَمْ تُضَامُوا",7,"م",3,0],["أَيُّهَا النَّائِمُونَ فِي الشَّرْقِ مِنْ","خِفْضٍ وَفِي الغَرْبِ أَعْيُنٌ لا تَنَامُ",8,"م",1,0],["أَيُّهَا النِّيلُ مَا جَنَيْتَ عَلَيْهِمْ","بَلْ جَنَى جَهْلُهُمْ وَلَسْتَ مُلِيمَا",9,"م",2,0],["أَيُّهَا النَّاحِيَانِ مِنْ عَنَتِ الدَّهْ","رِ وَمِنْ شَرِّهِ العَمِيمِ الطَّامِي",10,"م",2,0],["أيُّها النَّاعِبُ مَاذَا تَقُولُ","فَكِلاَنا سَائِلٌ وَمَسُولُ",11,"ل",1,1],["أيها النادبون غيريَ غرّوا","برح اليوم للبيب الخفاء",12,"ا",2,0],["أيها الناس إن ذا العصر عصر ال","علم والجد في العلا والجهاد",13,"د",1,0],["أيها الناظر ذا الفق","ر بعين الازدراء",14,"ا",2,1],["أيها الناكثُ العهودَ ستَجْني","ندماً من عُهودِك المنكوثهْ",15,"ث",2,1],["أيها الناس وَيْحَكُمْ","طالبوهُ بمنْ فلَجْ",16,"ج",1,0],["أيها الناس ويحكم هل مُغيثٌ","لِشَجٍ يستغيث من ظلم شاجي",17,"ج",2,0],["أيها الناسُ خَبِّرونا وأدُّوا","حقَّ مُستشهدٍ لدى شُهَّادِهْ",18,"د",2,0],["أَيُّها الناسُ بَعضَ هَذا النُواحِ","فَأَمينٌ ما زالَ في الأَرضِ حَيّا",19,"ي",2,0],["أَيُّها النائِمُ عَن أَنجُمِها","خَلَقَ اللَهُ لِعَينَيكِ سَناها",20,"ا",3,0],["أَيُّها النَفسُ الشَريفَه","إِنَّما دُنياكِ جيفَه",21,"ف",2,1],["أَيُّها الناعي إِلَينا مجدَنا","هَل يَضُرُّ المَجدَ أَن خَطبٌ طَرقْ",22,"ق",1,0],["أيها النفس إن أردت رحيلا","فارحلي عن سقيفتي بسلام",23,"م",1,0],["ايها النسر ما دهاك وقد كنت","اذا طرت لم يخنك الثبات",24,"ت",1,0],["ايها الناقد المهين لشعري","انت ما بالنزيه في النقاد",25,"د",1,0],["أيها النفس تجدَّين سدى","هل رأيت العيش إلا لعبا",26,"ب",2,0],["أَيُّها الناسُ اِسمَعوا أَصغوا لَهُ","أَخرِجوا المالَ إِلى البِرِّ يَعُد",27,"د",1,0],["أَيُّها النَفسُ اِصبِري وَاِستَرجِعي","هَتفَ الناعي بِعَبدِ المُطَّلِب",28,"ب",1,0],["أَيُّها النافِرونَ عودوا إِلَينا","وَلِجوا البابَ إِنَّهُ الإِسلامُ",29,"م",1,0],["أَيُّها الناسِ ما حَلَّ بِكُم","عَجَباً مِن سَهوِكُم كُلَّ العَجَب",30,"ب",1,0],["أَيُّها النازِحُ الَّذي مَلَأَ القَل","بَ بِأَحزانِهِ وَأَخلى الدِيارا",31,"ر",2,0],["أيها النورُ سَلاماً وخشوعا","أيها المعبَدُ صَمتاً ورُكُوعَا",32,"ع",2,0],["أيها النعمة لا حدّ لها","نحن من نعماك في ظل وريف",33,"ف",1,0],["أيها الناعمُ في لذاته","لذةُ النفس على الروح وَبال",34,"ل",1,0],["أَيُّها الناصِحُ قَبلي","فُتِنَت شُمطُ الرِجالِ",35,"ل",1,0],["أَيُّها الناصِحُ الأَمينُ رَسولي","قُل لِهِندٍ مِنّي إِذا جِئتَ هِندا",36,"د",2,0],["أَيُّها الناسُ اِرحَموني","وَتَمَشّوا بي إِلَيهِ",37,"ي",2,1],["أَيُّها النُوّامُ هُبّوا وَيحَكُم","وَاِسأَلوني اليَومَ ما طَعمُ السَهر",38,"ر",1,0],["أَيُّها الناصِبُ في تَطلابِها","بَعدَ هَذا ما تُبالي ما نَصَب",39,"ب",1,0],["أَيُّها الناصِحُ الرَسولُ إِلَيها","قُل لَها عَن مُتَيَّمِ القَلبِ صَبِّ",40,"ب",1,0],["أَيُّها الناظِرونَ هَذا قَضاءٌ","هَل عَلِمتُم إِلى ما أَصبَحَ يُفضي",41,"ض",2,0],["أيها الناس دافعوا عن حقوقٍ","غصبوها والكاثرُ المنصور",42,"ر",1,0],["أَيُّها الناس مرَّ وقت المَلاهي","أَيُّها الناس إنما أنا ناهي",43,"ي",1,1],["أَيُّها الناس قد دهتكم دواهي","أَيُّها الناس سارعوا لانتباه",43,"ه",1,0],["أَيُّها الناس أنتم في رقادِ","إنما العلم للممالك صونُ",43,"ن",1,0],["أَيُّها الناس إنما الناس في الغر","بِ جنوا من رقيِّهم أَثمارا",44,"ر",2,0],["أيّها الناعمان في الغفوة النشوى","أفيقا على الصّباح أفيقا",45,"ق",2,0],["أَيُّهَا النَّائِمُ الُمغَفَّلُ أَبِصر","أن تَكُونَ المُضَلَّلَ الَمغرورا",46,"ر",2,0],["أَيُّهَا النَّازِحُ الَّذِي خَلَّفَ اسْماً","أَكْبَرَتْهُ فِي المَشْرِقَيْنِ الأَنَامُ",47,"م",1,0],["أَيُّهَا النَّائِمُونَ يَهْنِيكُمُ النَّوْ","مَ وَلاَ زَالَ حَظيَ التَّأْرِيقَا",48,"ق",2,0],["أَيُّهَا النَّاقِدُ الشَّفِيقُ وَلَكِنْ","مَا بِهِ فِي الصَّوَابِ مِنْ إِشْفَاقِ",49,"ق",1,0],["أَيُّهَا النَّاثرُ الَّذِي لاَ يُبَاهى","لَفْظُهُ بِالجَلاَءِ وَالإِشْرَاقِ",49,"ق",1,0],["أَيُّهَا النَّابِغَةُ الشَّهْمُ الَّذِي","بِالرَّزَايَا صُقِلَتْ مِنْهُ الحَصَاةُ",50,"ه",1,0],["أيها النيلُ يا حبيبَ الرياحين","عيونُ الأزهارِ نسجُ عيونك",51,"ك",1,1],["أيها النَّجد خانني فيك مدحٌ","كان أذكى الأشياء لو لم يخُنِّي",52,"ن",2,0],["أيها النسر هل أعود كم عدت","أم السفح قد أمات شعوري",53,"ر",2,0],["أيُّها النيلُ، كم عمرت يبابًا","وبعثتَ الحياة في الأبدان",54,"ن",1,0],["أيها النيلُ، كم لبثتَ؟ ومن أي","نَ تفَجَّرت؟ وما درى الثقلان!",55,"ن",1,0],["أيها النيل، إنَّ شطك رمز الخُل","د في ذلك الوجودِ الفاني",55,"ن",2,0],["أيها النِّيل، حول شطك شعبٌ","يتحلَّى بسمرة الأبدان",55,"ن",1,0],["أيها النيل، كم شَقَقَتْ طَرِيقًا","في جبال، ومهيعا في فلاة",56,"ه",1,0],["أيها النيل -صانك الله- عُذْرًا","إن تَضَعْ في طريقك العقبات",56,"ت",1,0],["أيها النفس علم معناك بحر","في عميقات غمره العقل تاها",57,"ا",3,0],["أيها الناطق المبلغ عنا","عند عمروٍ وهل لذاك انتهاء",58,"ا",2,0],["أيها الناس أنتم الأمراء","بكم الأرض والسماء سواء",59,"ا",2,1],["أيها الناس ويحكم هل مُغيثٌ","لِشَيخٍ يستغيث من ظلم شاجي",60,"ج",2,0],["أَيُّها النّاعي إِلَينا مجدَنا","هَل يَضيرُ المَجدَ أَن خَطبٌ طَرقْ",61,"ق",1,0],["أيهَا النِّيلُ كيفَ نُمسِي عِطاشاً","في بلادٍ روِّيتَ فيهَا الأوامَا",62,"م",2,0],["أيها 