{"poems":[[55,"أهلا بهن على التنويل والبخل","https://www.aldiwan.net/poem29905.html","البسيط"],[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[73,"سلوا صهوات الخيل يوم الوغى عنا","https://www.aldiwan.net/poem4023.html","الطويل"],[37,"ألما على سلمى نسلم ونسأل","https://www.aldiwan.net/poem39099.html","الطويل"],[95,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[29,"أجد رواح القوم أم لا تروح","https://www.aldiwan.net/poem5704.html","الطويل"],[29,"ذكرت وصال البيض والشيب شائع","https://www.aldiwan.net/poem5921.html","الطويل"],[74,"فديتك أيها الرامي بقوس","https://www.aldiwan.net/poem20611.html","الوافر"],[53,"لقوله نحن قسم","https://www.aldiwan.net/poem64094.html","مجزوء الرجز"],[31,"هنيء أجيبي دعوة إن سمعتها","https://www.aldiwan.net/poem6046.html","الطويل"],[45,"أحاد أم سداس في أحاد","https://www.aldiwan.net/poem9539.html","الوافر"],[45,"مبيتي من دمشق على فراش","https://www.aldiwan.net/poem9714.html","الوافر"],[47,"أبا حسن إن حسن العزاء","https://www.aldiwan.net/poem62653.html","المتقارب"],[30,"تقول كليب حين مثت سبالها","https://www.aldiwan.net/poem1306.html","الطويل"],[30,"ليبك وكيعا خيل حرب مغيرة","https://www.aldiwan.net/poem5071.html","الطويل"],[30,"دعاهم مزوني فجاؤوا كأنهم","https://www.aldiwan.net/poem5352.html","الطويل"],[30,"رأيت بني حنيفة يوم لاقوا","https://www.aldiwan.net/poem5362.html","الوافر"],[41,"طربت وشاقك البرق اليماني","https://www.aldiwan.net/poem53730.html","الوافر"],[41,"أصاح ألا هل من سبيل إلى هند","https://www.aldiwan.net/poem53784.html","الطويل"],[77,"هنالك عهدي بالخليط المزايل","https://www.aldiwan.net/poem69044.html","الطويل"],[19,"أجاعلة أم الحصين خزاية","https://www.aldiwan.net/poem346.html",""],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140940",""],[29,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54740","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55161","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67330","الطويل"],[30,"تظل بعينيها إلى الجبل الذي","https://www.poetsgate.com/ViewPoem.aspx?id=22098",""],[154,"قضى القلب من عهد الشباب ديونه","https://www.aldiwan.net/poem68583.html","الطويل"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[275,"أيا ذات المكارم والمعالي","https://www.aldiwan.net/poem35010.html","الوافر"],[280,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[342,"أتعرف رسما دارسا قد تغيرا","https://www.aldiwan.net/poem45431.html","الطويل"],[370,"أجاعلة أم الثوير خزاية","https://www.aldiwan.net/poem44501.html","الطويل"],[376,"يستوجب العفو الفتى إذا اعترف","https://www.aldiwan.net/poem56930.html","الرجز"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[463,"نعم من جميلة إحدى النعم","https://www.aldiwan.net/poem55877.html","المتقارب"],[466,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[519,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[534,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[543,"لقوس المنايا نحونا الدهر واتر","https://www.aldiwan.net/poem47485.html","عموديه"],[545,"أتتك الرواحل والملجمات","https://www.aldiwan.net/poem56704.html","الكامل"],[548,"عجلا اليوم صاحبي رواحا","https://www.aldiwan.net/poem1764.html","الخفيف"],[563,"أنا المعروف لي بالله ألوان","https://www.aldiwan.net/poem33827.html","الهزج"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96305","الطويل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17570","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126124","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126173","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93091","الوافر"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101894","الرجز"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96489","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124716","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124717","السريع"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45459","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27477","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77304","الطويل"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17738","الطويل"],[2448,"","https://poetry.dctabudhabi.ae/diwan/poem/33022","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65985","الطويل"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9617","الطويل"],[3358,"","https://poetry.dctabudhabi.ae/diwan/poem/203169","السريع"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140025","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68073","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62739","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102391","الطويل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199023","الرجز"],[3842,"","https://poetry.dctabudhabi.ae/diwan/poem/20036","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86535","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40148","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45949","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28618","الرجز"],[308,"","https://poetry.dctabudhabi.ae/diwan/poem/199766","المتقارب"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89586","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72471","الطويل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116040","الطويل"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/147090","السريع"],[5092,"لهُ الحبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=179342",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5561,"أُحُبّكِ","https://www.poetsgate.com/ViewPoem.aspx?id=197377",""],[5770,"الفجر موعده اقترب","https://www.poetsgate.com/ViewPoem.aspx?id=178700",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[1907,"تأوبني داء دخيل فلم ان","http://www.aldiwanalarabi.com/poemDescription.do?poemId=605639",""]],"verses":[["لَقوا الخُطوبَ بِلا خَوفٍ وَلا ضَعَفٍ","وَالرائِعاتِ بِلا ميلٍ وَلا عَزَلِ",0,"ل",1,0],["لِقَومٍ فَكانوا هُمُ المُنفِدينَ","شَرابَهُمُ قَبلَ إِنفادِها",1,"د",3,0],["لَقوا المَوتَ مِن زُرقِ الأَسِنَّةِ أَحمَراً","فَأَلقَوا بِأَيديهِم إِلَينا فَأَحسَنّا",2,"ن",2,0],["لَقوكَ بِقَولٍ مِن ثَنائِيَ صادِقٍ","تَخَيَّرتُهُ حُرَّ القَصيدِ المُنَخَّلِ",3,"ل",1,0],["لَقُوا كَيْفَ أَغْنَتْنَا الشَّجَاعَةُ فِي الوَغَى","مِنَ العُدَدِ الصُّمِّ الَّتي لَيْسَ تَرْحَمُ",4,"م",1,0],["لَقُوا حِينَ أَعْيَانَا التَّفَاهُمُ بِاللُّغَى","مَقَابِضَنَا فِي الْهَامِ كيف تُتَرْجِمُ",4,"م",1,0],["لَقُوا فَوْقَ مَا ظَنُّوا مِنَ البَأْسِ مُفْضِياً","إلَى رَحْمَةٍ تَرْبُو عَلَى مَا تَوَهَّمُوا",4,"م",3,0],["لَقَومِيَ أَوفى ذِمَّةً مِن مُجاشِعٍ","وَخَيرٌ إِذا شَلَّ السَوامَ المُصَبِّحُ",5,"ح",1,0],["لَقَومِيَ أَحمى لِلحَقيقَةِ مِنكُمُ","وَأَضرَبُ لِلجَبّارِ وَالنَقعُ ساطِعُ",6,"ع",1,0],["لقوسكَ نحو حاجبكَ انْجذاب","وشبه الشيء منْجذبٌ إليه",7,"ه",1,0],["لقوله نحن قَسَمْ","نا بينهم زال المِرا",8,"ر",2,1],["لِقَومٍ أَلَظّوكُم بِبُؤسى كَأَنَّكُم","نَشاوى وَلَم تُسقَوا طِلاءً وَلا خَمرا",9,"ر",2,0],["لَقوكَ بِأَكبُدِ الإِبلِ الأَبايا","فَسُقتَهُمُ وَحَدُّ السَيفِ حادِ",10,"د",1,0],["لَقوهُ حاسِراً في دِرعِ صَربٍ","دَقيقِ النَسجِ مُلتَهِبِ الحَواشي",11,"ش",2,0],["لِقَولِ النَبِيِّ عَلَيهِ السَلا","مُ دَفنُ البَناتِ مِنَ المَكرُماتِ",12,"ت",1,0],["لَقوا اِبنَي جِعالٍ وَالجِحاشُ كَأَنَّها","لَهُم ثُكَنَ وَالقَومُ ميلُ العَصائِبِ",13,"ب",1,0],["لَقوا مِثلَهُم فَاِستَهزَموهُم بِدَعوَةٍ","دَعوها وَكيعاً وَالجِيادُ بِهِم تَجري",14,"ر",2,0],["لَقوا يَومَ عَقرِ بابِلٍ حينَ أَقبَلوا","سُيوفاً تُشَظّي جُمجُماتِ المَفارِقِ",15,"ق",1,0],["لَقوا مَن سارَ مِن هَجَرٍ إِلَيهِم","بِنَحسِ النَجمِ وَالقَمَرِ المُحاقِ",16,"ق",1,0],["لَقَومٍ ظاهَروا وَالحَربُ عَنهُم","كَهامُ الضِرسِ ضارِبَةُ الجِرانِ",17,"ن",1,0],["لَقوا عِندَ رَأسِ الخَطِّ مِنّي اِبنَ حُرَّةٍ","بُعَيدَ النَدى يَأوي إِلى سَنَدٍ نَهدٍ",18,"د",1,0],["لقوْمٍ نَمَوْا مثْلَ الأميرِ محمّدٍ","ففاؤوا كما فاءتْ شموسُ الأصائل",19,"ل",1,0],["لَقونا فَضَمّوا جانِبَينا بِصادِقٍ","مِنَ الطَعنِ حَشَّ النارِ في الحَطَبِ اليَبسِ",20,"س",1,0],["لقوه حاسراً في درع ضربٍ","دقيق النسج ملتهب الحواشي",21,"ش",2,0],["لَقوا وابِلاً فيهِ الصَواعِقُ تَرتَمي","أَواذِيُّهُ تَرمي الجَناحَينِ بِالصَخرِ",22,"ر",1,0],["لقوةِ الأَوتادِ في أَجزائها","وأنَّها تَبرأ من أَدْوائها",23,"ه",2,0],["لقَوْمكَ ممَّنْ دَنَا أَوْ نَأَى","سيَامَتُكَ الْيَوْمَ عيدٌ سَعيدُ",24,"د",1,0],["لَقُونِي زَائِراً وَلَقُوا صَدِيقِي","بِأُنْسٍ فَاقَ مَا كُنْا نَخَالُ",25,"ل",1,0],["لَقَوْا سَرَعاناً يملأُ السَّربَ رَوْعُهُ","أمامَ طَحُونٍ كالمجرَّة فَيْلَقِ",26,"ق",1,0],["لَقُوا يَوْمَ عَقْرِ بابِلٍ حِينع أقْبَلُوا","سُيُوفاً تُشَظّي جُمجَماتِ المَفارِقِ",27,"ق",1,0],["لَقوهُ بِآفاقِ السَمواتِ صاعِداً","إِلى مُستَوىً ما حَلَّهُ بَشَرٌ قَبلُ",28,"ل",1,0],["لقولك إن الله غير الذي عنى","وان الذي يعنيه رب مؤلب",29,"ب",1,0],["لقومكِ ذلَّ قيصرُ ثم كِسرى","وذلَّوا للعبيدِ وللموالي",30,"ل",2,0],["لَقُوها بِسَطوٍ فَضَّ أَغَلاقَها لَهُمْ","وَمَلَّكَهُم أَعْلاقَهَا الجدَّ والدِّقَّا",31,"ق",2,0],["لقول أَهل النارِ","وعصبةِ الكفّارِ",32,"ر",1,0],["لَقَومٌ تَصابَبتُ المَعيشَةَ بَعدَهُم","أَعَزُّ عَلَيَّ مِن عِفاءٍ تَغَيَّرا",33,"ر",2,0],["لَقُونا فَضمُّوا جانبَينا بصادقٍ","من الطَعنِ مِثلِ النارِ في الحَطبِ اليَبسِ",34,"س",1,0],["لقَولِهِ قُل لِلَّذينَ كفَرُوا","إن يَنتَهوا يُغفَر لهم ما قَد سَلَف",35,"ف",1,0],["لقومٍ لئامٍ هل لديك قبولها","صحائف ذي غيظ على الدهر واجب",36,"ب",1,0],["لقُوه بسعدِهُم المستنيرِ","فكان الهزبرَ وكان الخِضمّْ",37,"م",1,0],["لقولهم عندي أشد مهانة","من الفقح منجول المنابت بالعرا",38,"ر",2,0],["لَقوهُ كأمثال البُزاةِ جَوارِحاً","وولّوْا كما تمضي البُزاةُ عن الصّقْرِ",39,"ر",1,0],["لِقَوْلِ ذَاكَ الْمَوْلَى","أُولوُ النُّهَى أَوْ لاَ",40,"ل",2,0],["لِقَوسِ المنَايا نحَونا الدهرُ واتِرُ","وأسيافُه فينا سُيوفٌ بواترُ",41,"ر",1,1],["لِقَولِ الوَصيِّ وَأَنتَ ابنُهُ","وَصيِّ نَبيِّ الهُدى المرسَلي",42,"ل",2,0],["لَقوا أُسدَ غابَةٍ وَكُهولاً","وَقَناً تَصرَعُ الكُماةَ سِفاحا",43,"ح",2,0],["لقوم ذا وقوم ذا وقوم ذا","على مقدار ما تنويه إخوان",44,"ن",1,0],["لقوداء شملال السُّرى قَاعَ فَوقها","به من قُرُوم الناعجات فنيقُ",45,"ق",1,0],["لَقُوهُ وَفيهِم حِيلَةُ الكودِ فانطَوَوا","عَلَى قَتلِ أَحرارٍ لَهُم وَثِقَاتِ",46,"ت",1,0],["لقوله من رآني كأن ما شهدت","عيناه حقا وقول الحق مقبول",47,"ل",1,0],["لقولكم من رآني كان ما شهدت","عيناه حقا كما قد أخبر العلما",48,"م",2,0],["لقوله خير القرون قرني","واقرأ على من كذبوا فذرني",49,"ي",1,0],["لقوته وقوت من يمونه","أو ملبس من لاأذى يصونه",50,"ه",1,0],["لقوم طلقوا الدنيا وسارت","بهم من يثرب للطف ركب",51,"ب",1,0],["لقوله أرضعنه في الآية","وتلك للعارف أي آية",52,"ه",1,0],["لقومي الأزد في الغمرات أمضى","وأوفى ذمَّةً وأعز جارا",53,"ر",2,0],["لقولهم لله جل ثناؤُهُ","يد مثلُ أيديهم تعالى ومبسم",54,"م",1,0],["لقوله شيءٌ وما لم يكن","شيئاً فمعدومٌ من الأصل",55,"ل",1,0],["لقوه بنثاراتٍ","من البندق والبسر",56,"ر",1,0],["لِقَومِيَ إِذ قَومي جَميعٌ نَواهُمُ","وَإِذ أَنا في حَيٍّ كَثيرِ الوَضائِحِ",57,"ح",1,0],["لقوّةِ إيماني بما قال خالقي","وصدقي الذي قد قرّر الله في صدري",58,"ر",2,0],["لَقوا ما لَقوا في حُبِّ مِصرَ وَنيلُها","وَسَنّوا المَساعي لِلمُجِدِّ وَلِلواني",59,"ن",2,0],["لِقَومي عَلَيَّ الطَولُ وَالفَضلُ إِنَّني","إِذا جَمَعَتني وَالخُطوبُ المَجامِعُ",60,"ع",1,0],["لَقونِيَ بِالأَمرِ الَّذي في نُفوسِهِم","وَلا يَقتُلُ الفُجّارَ إِلّا فُجورُها",61,"ر",3,0],["لِقُوَّةِ المَاءِ وَسَهوِ المَجرِى","إن كُنتَ مِن فُرسَانِ هَذا البَحرِ",62,"ر",1,0],["لقول إلهي جلّ كاد عذابنا","يمسكم لولا كتاب تقدما",63,"م",2,0],["لَقوا مِثلَ ما لاقى اللُجَيمِيُّ قَبلَهُ","قَتادَةُ لَمّا جاءَنا وَهوَ يَطلُبُ",64,"ب",1,0],["لقوسه في جوشني أسهم","والقصد عين التل من ردفه",65,"ه",1,0],["لقوه بنخلِ فاستعدّ لحربهم","وصلّى صلاةَ الخوف لم يتعجل",66,"ل",1,0],["لقولِ عَذولٍ ل لقَصْد جفاءِ","عَلَى الحِبِّ مني مَا حييتُ تحيةٌ",67,"ه",1,0],["لقُوا نَبْلَها مُردَ العَوارِضِ وانثنوا","لأوجُههِم منها لحىً وشَوارِبُ",68,"ب",1,0],["لَقُونا بدُفّاعٍ كأنَّ أتِيَّهُ","أتِيُّ فُراتيٍّ يدُقُّ الصواريا",69,"ي",2,0],["لقوة العقل الذي يحملها","فهو إلى اختياره ينقلها",70,"ه",2,0],["لِقَومِيَ أَرعى للعلىمِن عِصابَة","مِنَ الناسِ يا حارِبنَ عَمرٍو تَسودُها",71,"د",3,1],["لقومك هاتيك الخلافة نعمةٌ","وليس لها فيما نراه زوال",72,"ل",1,0],["لَقُوك كأنّ ما سَلّوهُ سَيحٌ","وَما اِعتَقلوهُ مِن خورٍ ثمامُ",73,"م",1,0],["لقومك بالفلك تحملهن","افاتك طعن ذوابلنا",74,"ن",2,0],["لِقَولِهِ قَد قالوا وَتِلكَ حِكايَةٌ","وَما حاكيٌ قَولَ الإِثمِ بِالمُتَأَثِّمِ",75,"م",1,0],["لقومٍ بكت منهم ملائكة السما","خلعت عذاري في هواهم تقحما",76,"م",2,0],["لَقَولُكَ القَولُ الَّذي يشفي العَمى","وَرأيُكَ الرَّأيُ بِهِ قامَ المَيَلْ",77,"ل",1,0],["لقول ابن تيمية زخرف","أتى في زيارة خير الأنام",78,"م",1,1],["لِقَولي صَغا لِلشَرقِ وَالغَربِ مَسمَعٌ","لِقَولي زَئيرُ اللَيثِ مَخمودُ وَالرَعدِ",79,"د",1,0],["لقول وفعل كل عضو مؤيد","كواكب مجد نحن والكل فرقد",80,"د",1,0],["لِقول رسولِ اللهِ تلقون عِترتِى","معاً وكتابَ اللهِ فى مورِدِ الحشرِ",81,"ر",1,0],["لقومه في كرم المنصب","يرفعها أبلح من طيء",82,"ي",2,0],["لقويمنا لا فضلَ في أزماننا","لقبيحنا في أمرنا تفضيلُ !",83,"ل",1,0],["لقولك في مزبور مينك ضلة","فما جهة بالله من جهة أحرا",84,"ر",2,0],["لقومٌ في ضمائرِهمْ تراخ ٍ","مبادئهم تنامُ على (حصيرهْ)",85,"ر",2,0],["لقوافل الشهداء غا","صت في دماها للرُكَب",86,"ب",1,0],["لَقونا أَهل الفَيحا يهوشوا وَينتخوا","عَلَينا وَحنا باردين ذفال",87,"ل",1,0],["لقولهم لله جل ثناؤُهُ","يد مثلُ أيديهم تعالى ومبتسم",88,"م",1,0]]}