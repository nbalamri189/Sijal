{"poems":[[53,"أهلا بهن على التنويل والبخل","https://www.aldiwan.net/poem29905.html","البسيط"],[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[71,"سلوا صهوات الخيل يوم الوغى عنا","https://www.aldiwan.net/poem4023.html","الطويل"],[35,"ألما على سلمى نسلم ونسأل","https://www.aldiwan.net/poem39099.html","الطويل"],[93,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[27,"أجد رواح القوم أم لا تروح","https://www.aldiwan.net/poem5704.html","الطويل"],[27,"ذكرت وصال البيض والشيب شائع","https://www.aldiwan.net/poem5921.html","الطويل"],[72,"فديتك أيها الرامي بقوس","https://www.aldiwan.net/poem20611.html","الوافر"],[51,"لقوله نحن قسم","https://www.aldiwan.net/poem64094.html","مجزوء الرجز"],[29,"هنيء أجيبي دعوة إن سمعتها","https://www.aldiwan.net/poem6046.html","الطويل"],[43,"أحاد أم سداس في أحاد","https://www.aldiwan.net/poem9539.html","الوافر"],[43,"مبيتي من دمشق على فراش","https://www.aldiwan.net/poem9714.html","الوافر"],[45,"أبا حسن إن حسن العزاء","https://www.aldiwan.net/poem62653.html","المتقارب"],[28,"تقول كليب حين مثت سبالها","https://www.aldiwan.net/poem1306.html","الطويل"],[28,"ليبك وكيعا خيل حرب مغيرة","https://www.aldiwan.net/poem5071.html","الطويل"],[28,"دعاهم مزوني فجاؤوا كأنهم","https://www.aldiwan.net/poem5352.html","الطويل"],[28,"رأيت بني حنيفة يوم لاقوا","https://www.aldiwan.net/poem5362.html","الوافر"],[39,"طربت وشاقك البرق اليماني","https://www.aldiwan.net/poem53730.html","الوافر"],[39,"أصاح ألا هل من سبيل إلى هند","https://www.aldiwan.net/poem53784.html","الطويل"],[75,"هنالك عهدي بالخليط المزايل","https://www.aldiwan.net/poem69044.html","الطويل"],[19,"أجاعلة أم الحصين خزاية","https://www.aldiwan.net/poem346.html",""],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140940",""],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54740","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55161","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67330","الطويل"],[28,"تظل بعينيها إلى الجبل الذي","https://www.poetsgate.com/ViewPoem.aspx?id=22098",""],[150,"قضى القلب من عهد الشباب ديونه","https://www.aldiwan.net/poem68583.html","الطويل"],[160,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[270,"أيا ذات المكارم والمعالي","https://www.aldiwan.net/poem35010.html","الوافر"],[275,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[337,"أتعرف رسما دارسا قد تغيرا","https://www.aldiwan.net/poem45431.html","الطويل"],[365,"أجاعلة أم الثوير خزاية","https://www.aldiwan.net/poem44501.html","الطويل"],[371,"يستوجب العفو الفتى إذا اعترف","https://www.aldiwan.net/poem56930.html","الرجز"],[416,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[458,"نعم من جميلة إحدى النعم","https://www.aldiwan.net/poem55877.html","المتقارب"],[461,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[514,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[529,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[538,"لقوس المنايا نحونا الدهر واتر","https://www.aldiwan.net/poem47485.html","عموديه"],[540,"أتتك الرواحل والملجمات","https://www.aldiwan.net/poem56704.html","الكامل"],[543,"عجلا اليوم صاحبي رواحا","https://www.aldiwan.net/poem1764.html","الخفيف"],[558,"أنا المعروف لي بالله ألوان","https://www.aldiwan.net/poem33827.html","الهزج"]],"verses":[["لَقوا الخُطوبَ بِلا خَوفٍ وَلا ضَعَفٍ","وَالرائِعاتِ بِلا ميلٍ وَلا عَزَلِ",0,"ل",1,0],["لِقَومٍ فَكانوا هُمُ المُنفِدينَ","شَرابَهُمُ قَبلَ إِنفادِها",1,"د",3,0],["لَقوا المَوتَ مِن زُرقِ الأَسِنَّةِ أَحمَراً","فَأَلقَوا بِأَيديهِم إِلَينا فَأَحسَنّا",2,"ن",2,0],["لَقوكَ بِقَولٍ مِن ثَنائِيَ صادِقٍ","تَخَيَّرتُهُ حُرَّ القَصيدِ المُنَخَّلِ",3,"ل",1,0],["لَقُوا كَيْفَ أَغْنَتْنَا الشَّجَاعَةُ فِي الوَغَى","مِنَ العُدَدِ الصُّمِّ الَّتي لَيْسَ تَرْحَمُ",4,"م",1,0],["لَقُوا حِينَ أَعْيَانَا التَّفَاهُمُ بِاللُّغَى","مَقَابِضَنَا فِي الْهَامِ كيف تُتَرْجِمُ",4,"م",1,0],["لَقُوا فَوْقَ مَا ظَنُّوا مِنَ البَأْسِ مُفْضِياً","إلَى رَحْمَةٍ تَرْبُو عَلَى مَا تَوَهَّمُوا",4,"م",3,0],["لَقَومِيَ أَوفى ذِمَّةً مِن مُجاشِعٍ","وَخَيرٌ إِذا شَلَّ السَوامَ المُصَبِّحُ",5,"ح",1,0],["لَقَومِيَ أَحمى لِلحَقيقَةِ مِنكُمُ","وَأَضرَبُ لِلجَبّارِ وَالنَقعُ ساطِعُ",6,"ع",1,0],["لقوسكَ نحو حاجبكَ انْجذاب","وشبه الشيء منْجذبٌ إليه",7,"ه",1,0],["لقوله نحن قَسَمْ","نا بينهم زال المِرا",8,"ر",2,1],["لِقَومٍ أَلَظّوكُم بِبُؤسى كَأَنَّكُم","نَشاوى وَلَم تُسقَوا طِلاءً وَلا خَمرا",9,"ر",2,0],["لَقوكَ بِأَكبُدِ الإِبلِ الأَبايا","فَسُقتَهُمُ وَحَدُّ السَيفِ حادِ",10,"د",1,0],["لَقوهُ حاسِراً في دِرعِ صَربٍ","دَقيقِ النَسجِ مُلتَهِبِ الحَواشي",11,"ش",2,0],["لِقَولِ النَبِيِّ عَلَيهِ السَلا","مُ دَفنُ البَناتِ مِنَ المَكرُماتِ",12,"ت",1,0],["لَقوا اِبنَي جِعالٍ وَالجِحاشُ كَأَنَّها","لَهُم ثُكَنَ وَالقَومُ ميلُ العَصائِبِ",13,"ب",1,0],["لَقوا مِثلَهُم فَاِستَهزَموهُم بِدَعوَةٍ","دَعوها وَكيعاً وَالجِيادُ بِهِم تَجري",14,"ر",2,0],["لَقوا يَومَ عَقرِ بابِلٍ حينَ أَقبَلوا","سُيوفاً تُشَظّي جُمجُماتِ المَفارِقِ",15,"ق",1,0],["لَقوا مَن سارَ مِن هَجَرٍ إِلَيهِم","بِنَحسِ النَجمِ وَالقَمَرِ المُحاقِ",16,"ق",1,0],["لَقَومٍ ظاهَروا وَالحَربُ عَنهُم","كَهامُ الضِرسِ ضارِبَةُ الجِرانِ",17,"ن",1,0],["لَقوا عِندَ رَأسِ الخَطِّ مِنّي اِبنَ حُرَّةٍ","بُعَيدَ النَدى يَأوي إِلى سَنَدٍ نَهدٍ",18,"د",1,0],["لقوْمٍ نَمَوْا مثْلَ الأميرِ محمّدٍ","ففاؤوا كما فاءتْ شموسُ الأصائل",19,"ل",1,0],["لَقونا فَضَمّوا جانِبَينا بِصادِقٍ","مِنَ الطَعنِ حَشَّ النارِ في الحَطَبِ اليَبسِ",20,"س",1,0],["لقوه حاسراً في درع ضربٍ","دقيق النسج ملتهب الحواشي",21,"ش",2,0],["لَقوا وابِلاً فيهِ الصَواعِقُ تَرتَمي","أَواذِيُّهُ تَرمي الجَناحَينِ بِالصَخرِ",22,"ر",1,0],["لقوةِ الأَوتادِ في أَجزائها","وأنَّها تَبرأ من أَدْوائها",23,"ه",2,0],["لقَوْمكَ ممَّنْ دَنَا أَوْ نَأَى","سيَامَتُكَ الْيَوْمَ عيدٌ سَعيدُ",24,"د",1,0],["لَقُونِي زَائِراً وَلَقُوا صَدِيقِي","بِأُنْسٍ فَاقَ مَا كُنْا نَخَالُ",25,"ل",1,0],["لَقَوْا سَرَعاناً يملأُ السَّربَ رَوْعُهُ","أمامَ طَحُونٍ كالمجرَّة فَيْلَقِ",26,"ق",1,0],["لَقُوا يَوْمَ عَقْرِ بابِلٍ حِينع أقْبَلُوا","سُيُوفاً تُشَظّي جُمجَماتِ المَفارِقِ",27,"ق",1,0],["لَقوهُ بِآفاقِ السَمواتِ صاعِداً","إِلى مُستَوىً ما حَلَّهُ بَشَرٌ قَبلُ",28,"ل",1,0],["لقولك إن الله غير الذي عنى","وان الذي يعنيه رب مؤلب",29,"ب",1,0],["لقومكِ ذلَّ قيصرُ ثم كِسرى","وذلَّوا للعبيدِ وللموالي",30,"ي",1,0],["لَقُوها بِسَطوٍ فَضَّ أَغَلاقَها لَهُمْ","وَمَلَّكَهُم أَعْلاقَهَا الجدَّ والدِّقَّا",31,"ق",2,0],["لقول أَهل النارِ","وعصبةِ الكفّارِ",32,"ر",1,0],["لَقَومٌ تَصابَبتُ المَعيشَةَ بَعدَهُم","أَعَزُّ عَلَيَّ مِن عِفاءٍ تَغَيَّرا",33,"ر",2,0],["لَقُونا فَضمُّوا جانبَينا بصادقٍ","من الطَعنِ مِثلِ النارِ في الحَطبِ اليَبسِ",34,"س",1,0],["لقَولِهِ قُل لِلَّذينَ كفَرُوا","إن يَنتَهوا يُغفَر لهم ما قَد سَلَف",35,"ف",1,0],["لقومٍ لئامٍ هل لديك قبولها","صحائف ذي غيظ على الدهر واجب",36,"ب",1,0],["لقُوه بسعدِهُم المستنيرِ","فكان الهزبرَ وكان الخِضمّْ",37,"م",1,0],["لقولهم عندي أشد مهانة","من الفقح منجول المنابت بالعرا",38,"ر",2,0],["لَقوهُ كأمثال البُزاةِ جَوارِحاً","وولّوْا كما تمضي البُزاةُ عن الصّقْرِ",39,"ر",1,0],["لِقَوْلِ ذَاكَ الْمَوْلَى","أُولوُ النُّهَى أَوْ لاَ",40,"ل",2,0],["لِقَوسِ المنَايا نحَونا الدهرُ واتِرُ","وأسيافُه فينا سُيوفٌ بواترُ",41,"ر",1,1],["لِقَولِ الوَصيِّ وَأَنتَ ابنُهُ","وَصيِّ نَبيِّ الهُدى المرسَلي",42,"ل",2,0],["لَقوا أُسدَ غابَةٍ وَكُهولاً","وَقَناً تَصرَعُ الكُماةَ سِفاحا",43,"ح",2,0],["لقوم ذا وقوم ذا وقوم ذا","على مقدار ما تنويه إخوان",44,"ن",1,0]]}