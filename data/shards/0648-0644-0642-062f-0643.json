 الحَمامُ عَلَى الفُنُونِ وَناحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186829",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[4623,"على من باح بالحب ملام (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146605",""],[5758,"عزفٌ أخْضر","https://www.poetsgate.com/ViewPoem.aspx?id=200586",""],[6102,"خرف أنا","https://www.poetsgate.com/ViewPoem.aspx?id=183985",""],[6102,"منة","https://www.poetsgate.com/ViewPoem.aspx?id=185063",""],[520,"يا دار عليك سعد المشتري","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577539",""],[6164,"بطرت .. فزلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66039&r=&rc=49",""],[186,"دع عنك ذكر المنحنى وزرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55750&r=&rc=13",""],[5126,"الطائر الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87826&r=&rc=41",""],[572,"وَلَقدْ كَتَمْتُ هَوَاكَ أصدقَ صاحبٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9498&r=&rc=355",""]],"verses":[["وَلَقَد كَبا طَرفُ الرُقادِ بِناظِري","أَسَفاً عَليكَ فَلا لَعاً لِرُقادِ",0,"د",1,0],["وَلَقَد كانَ خِصاصُ الخِدرِ بي","يَسأَلُ البيضَ رِقاعاً مِن مُقَلْ",1,"ل",1,0],["وَلَقَد كَتَبتُ مَعَ الرَسولِ وَإِنَّني","لَأَراهُ أَنجَحَ مِن كِتابِ الهُدهُدِ",2,"د",1,0],["ولقدْ كُنْتُ صَبوراً إنّما","صدَعَ البيْنُ فؤادي وكَواهُ",3,"ا",2,0],["وَلَقَدْ كَفَاهَا شَاهِداً مَهْمَا ادَّعَتْ","قَصَبَ السِّبَاقِ الْقُربُ مِنْ زَرْهُون",4,"ن",1,0],["وَلَقَد كَتَمتُ اِسمَ الَّذي أَحبَبتُهُ","وَدَفَنتُ سِرَّ حَديثِهِ بَينَ الحَشا",5,"ش",2,1],["ولقد كان في العلوم إماماً","حيث فيها انتهت إليه الرياسه",6,"س",2,0],["وَلَقَد كَسَرتَ سِنانَ كُلَّ مُنافِقٍ","وَلَقَد مَنَعتَ حَقائِبَ الحُجّاجِ",7,"ج",1,0],["وَلَقَد كانَت تَكونُ بِهِ","طَفلَةٌ مَمكورَةٌ كاعِبُ",8,"ب",1,0],["ولقدْ كوَى قلبي المشيبُ فما","تهفو العوَائدُ بي إلى الحبّ",9,"ب",1,0],["ولقد كافأ بالنعمى امْرُؤٌ","كافأ النعمى بإخلاص الودادِ",10,"د",1,0],["ولقد كنتَ من أمانيَّ مُذ كنْ","تُ وإن كان مذهبي أن أكيدَكْ",11,"ك",1,0],["ولقد كُنِّيَها من بعده","معشرٌ لم يلبسوا تلك الخلع",12,"ع",1,0],["ولقد كان في عِداتك عفوٌ","واغتفارٌ يستنطقاني بحمدك",13,"ك",1,0],["ولقد كادَ ما استطاعَ ولكنْ","جُعل الكيدُ منهُ في تضليل",14,"ل",1,0],["ولقد كان أهلُه ضيعوه","وأحلُّوه منزلَ الهِجرانِ",15,"ن",1,0],["ولقد كنت رُمتكم بهناتٍ","هُنَّ ما هُنَّ قاطعاتُ الوتين",16,"ن",1,0],["ولقد كان قبلَ ذلك يَنْفي","هِ فأضحى لرُشْدِهِ يجتبيه",17,"ي",2,0],["وَلَقَد كَتَمتُ هَواكُمُ","لَو كانَ مِمّا يُكتَمُ",18,"م",1,0],["ولقد كانتْ صَباحَ الأمْس بَيْنَ النَّسَماتْ","كعذارى الغابِ لا تعرِفُ غيرَ البَسَماتْ",19,"ت",1,0],["ولقد كان كاتبا عبقريا","وأديبا مصرحا لا يهاب",20,"ب",1,0],["ولقد كان الحق في كل جيل","ضائعاً بين سائد فذودي",21,"د",2,0],["ولقد كنت في قريضك ترجو","ما لحق اهين من احقاق",22,"ق",1,0],["ولقد كان صوتك العذب قبلا","في الفتغراف مالئا كل دار",23,"ر",1,0],["ولقد كشفنا للصروف صدورنا","اما الصروف فلا تطيش نبالهال",24,"ل",1,0],["ولقد كرهت العقل فهو","بما يشير مكبلي",25,"ل",2,0],["ولقد كنا في وفاق معاً نر","ضى عن الشيء او معاً نتغضب",26,"ب",1,0],["ولقد كادت بها ترني","لي الصم الصلاب",27,"ب",1,0],["ولقد كان قبل ذلك يأتي","حاملا للسلام في اردانه",28,"ن",2,0],["ولقد كنت بالطبيعة أشدو","يوم ما كان ذكرها غير همس",29,"س",1,0],["وَلَقَد كَفاكَ المَكرُماتِ مُهَذَّبٌ","يُرضيكَ مِنهُ النَقضُ وَالإِبرامُ",30,"م",1,0],["وَلَقَد كُلِّفتُ أَمراً عَجَباً","أَسأَلُ التَفريحَ مِن بَيتِ الحَزَن",31,"ن",1,0],["وَلَقَد كُلِّفَ شَيئاً عَجَباً","زادَ في النَكبَةِ وَاستَوفى المِحَن",31,"ن",1,0],["وَلَقَد كُنتُ إِذ أُرَجِّلُ رَأسي","ما أُبالي الإِفسادَ وَالإِصلاحا",32,"ح",2,0],["ولقد كادَتْ تعاطَى لَقْطَهُ","رغبةً فيه كريماتُ الخُرُد",33,"د",1,0],["وَلَقَد كُنتُ قَد عَرَفتُ وَأَبصَر","تُ أُموراً لَو أَنَّها نَفَعَتني",34,"ن",2,0],["وَلَقَد كانَ آهِلاً","فيهِ ظَبيٌ مُبَتَّلُ",35,"ل",1,0],["وَلَقَد كَتَمتُ الحُبَّ بَينَ جَوانِحي","حَتّى تَكَلَّمَ في دُموعِ شُؤوني",36,"ن",2,0],["وَلَقَد كانَ في عَن تَبَعِ اللَه","وِ وَإِذا أَعرَضَ المُحِبُ اِعتِراضُ",37,"ض",1,0],["وَلَقَد كانَ إِلَيكَ فَقيراً","لا يَرى مِثلَكَ في اللابِسينا",38,"ن",2,0],["وَلَقَد كُنتُ أَراها آهِلا","تٍ كَذاكَ الدَهرُ يَعصي وَيُطيعُ",39,"ع",1,0],["ولقد كفيتَ فكنتَ سيفاً ليس بال","نابي ورُكْناً ليسَ بالمهدود",40,"د",1,0],["وَلَقَد كُنّا عَرَتنا جَفوَةٌ","أَكَلَت مِنّا السُلامى وَالقُصَر",41,"ر",1,0],["وَلَقَد كُنتُ ذا مُزاحٍ فَأَصبَح","تُ عَلى حُبِّها قَليلَ المُزاحِ",42,"ح",1,0],["وَلَقَد كَلِفتُ بِها وَعَيَّرَني الهَوى","بادي النَصيحَةِ ساكِنُ الأَرواحِ",43,"ح",1,0],["وَلَقَد كُنتُ عَلَيكُم عاتِباً","فَعَقَبتُم بِذُنوبٍ غَيرِ مُر",44,"ر",1,0],["ولقد كنتُ في البداءة أشحى","مثلما يشحى للخشاة الذعورُ",45,"ر",1,0],["ولقد كانت الوجوهُ من الصا","لينَ سوداً كأنهن القير",45,"ر",1,0],["ولقد كانت الملامح تخفى","ولقد كانت العيونُ تغور",45,"ر",1,0],["ولقد كان آخرون حوالَي","هم جثوماً وكلهم موتور",45,"ر",1,0],["ولقد كاد يخنقُ الغيظُ بشا","راً وفي وجهه الدميم بثور",45,"ر",1,0],["ولقد كان لامرئ القيس بين ال","قوم صدرٌ وللملوك الصدور",45,"ر",1,0],["ولقد كانوا يفتكون ولا يب","صر منهم مهاجمٌ أو مغير",45,"ر",1,0],["ولقد كانت البطونُ تَفَرَّى","ولقد كانت الرؤوس تطير",45,"ر",1,0],["ولقد كادت السموات تهوي","ولقد كادت النجوم تغور",45,"ر",1,0],["وَلَقَد كنت قد بنيت بجهد","ليَ عشاً في مجمع الأوراق",46,"ق",1,0],["وَلَقَد كالَ لي الأعادي هواناً","وَلهم قد أَكيلُ صاعاً بصاع",47,"ع",1,0],["وَلَقَد كانَت الملاوم منها","كَسِهام يصبن إِثر سهام",48,"م",1,0],["وَلَقَد كانَت الشموس قَديماً","تابعات لغيرها في السماء",49,"ا",2,0],["ولقَد كانَ ذا جُنُودٍ وتاجٍ","تَرهَبُ الأُسدُ صَولَهُ والزَّئيرا",50,"ر",2,0],["ولقد كنا وما كنا سوى","مثلما يستجمع العينين خد",51,"د",1,0],["وَلَقَد كُنتُ أَطّبي كُلَّ طبّ","وَأواخي وَللإخاءِ ذِمامُ",52,"م",1,0],["وَلَقَد كانَ عَلى أَوصابِهِ","رُبَّما نامَ ثَلاثاً في نَسَق",53,"ق",1,0],["ولقد كان قبله الليل يدجو","قابضاً للقلوب والأرواح",54,"ح",1,0],["ولقد كتمت غرامها","إذا تلك تغضبها الإشاعه",55,"ع",2,0],["وَلَقَد كُنتُ زَماناً","خالي الذَرعِ لِشاني",56,"ن",2,0],["ولقد كسوتَ الملك ثوب مهابةٍ","سلبت عيونَ عداك أبوابُ الكرا",57,"ر",2,0],["ولقد كفيتَ من الخطوب أجلّها","ولقد حميت فكنت خير محامي",58,"م",2,0],["وَلَقَد كَتَبتُ مؤرِّخاً مِن فَوقِهِ","يا تُربةَ الرَيحانِ يَسقيكِ النَّدَى",59,"د",2,0],["ولقد كانَ في هواكَ عزيزاً","يتأبى على الظباءِ الحورِ",60,"ر",1,0],["ولقد كتمت عن الورى كلفي","دفعا لسهم القيل والقالي",61,"ل",2,0],["وَلَقَد كُنتِ تَبسَمينَ بِحَظٍّ","فَلِماذا أَمسَيتِ لا تَبسَمينا",62,"ن",2,0],["وَلَقَد كانَ لائِقاً بِكَ أَن تَح","مِلَ ضِعفَيهِ عِندَ عَزلِ الوَزيرِ",63,"ر",1,0],["ولقد كنتُ بالشباب جَمُوحاً","غير أن المَشِيبَ ممَّا يَرُوضُ",64,"ض",1,0],["ولقد كسوتكَ من قريضٍ حُلَّةً","جَلَّت عن التلفيقِ والترقيعِ",65,"ع",1,0],["ولقد كَدت أن أهيم بِحَملِ","الهم لولا تَعَلِلُّي بالأماني",66,"ن",2,0],["وَلَقَدْ كَسَا حَتَّى الصحَائِف جدَّةً","مِن جُودِهِ وَأَفادَها تَنبِيها",67,"ي",3,0],["وَلَقَد كانَ آهِلاً غَيرَ قَفرِ","مُخصِباً خَيرُهُ كَثيرُ العِمارَةِ",68,"ر",2,0],["ولقد كنت آملاً لسواها","وسواها بوعده أن ينيله",69,"ل",2,0],["وَلَقَد كَلفت بشيشة ما نالَها","كِسرى وَلا ماء السَماء لَها حوى",70,"و",2,1],["وَلَقَد كَتَمت صَبابَتي","وَأَظُّنُها لا تَكتُم",71,"م",1,0],["ولقد كفَلْتَ بها ورأْيُك وَحْدَه","حَسْبي لها سَبباً وإن لم تَكْفُل",72,"ل",1,0],["ولقد كَتَمتُ عنِ العَذول صَبابتي","لكنّ دَمْعيَ لَجَّ في الإفشاءِ",73,"ا",2,0],["وَلَقَد كُفيتُ العَذلَ فيكَ لِشيمَةٍ","غَضَّت لِحاظَ الأَشوَسِ المُتَخايِلِ",74,"ل",1,0],["ولقد كان في المكارم قومٌ","أخذوها بيضاً وجاؤا بسودِ",75,"د",1,0],["ولقد كِدْتَ أن ترى ما وراء الغَ","يْبِ عُلوماً أُلهِمتَها إلهاما",76,"م",2,0],["ولقد كفاني الله فيه عصابة","لا أرتجيهم أبرقوا أم أرعدوا",77,"د",3,0],["ولقد كَمُلْتَ فما يقالُ لقد","نلْتَ السكمالَ جميعَه إِلاَّ",78,"ل",2,0],["ولقد كسوتُ القلبَ لأْمةَ سَلْوَةٍ","وعلِمْتُ أَنَّ الحُسْنَ أَولُ سالبِ",79,"ب",1,0],["ولقد كان ومن آرابِه","غُصُنٌ ماسَ وبدر كُمِّلا",80,"ل",2,0],["ولَقَدْ كَرَرْتُ عَلَى الملامِ بِزَفْرَةٍ","ذَهَلَ العِتَابُ بِهَا عَنِ الإِعْتَابِ",81,"ب",1,0],["ولقد كفاني في العفافِ بصيرةً","ذلُّ الحريصِ ورزقُه مقسومُ",82,"م",1,0],["ولقد كنَّ متى استبطأنني","قمن يسألن أخونا ما فعلْ",83,"ل",1,0],["ولقد كنتُ عالماً أن إقبا","لي بمدحي عليكُمُ إقبالُ",84,"ل",1,0],["ولقد كفاني شيبُ رأسي عَبرةً","وعلى الفَناء دلالة أن نُقِّصا",85,"ص",2,0],["ولقد كنزتُ فهل علمتَ مكانهُ","من صفوِ أيّامي ومن خيراتها",86,"ت",3,0],["ولقد كرمت عن الإجابة فليكن","منك التَّغَمُّدُ للأغَرِّ الأجْهَلِ",87,"ل",1,0],["ولقد كشفت بسيف رأيك غَيْهَباً","نسخَ النَّهارَ بليلِ نقْعٍ ألْيَلِ",88,"ل",1,0],["ولقد كدتُ فيك أجهزُ بالت","تفضيل لولا إشارةُ النُصَّاح",89,"ح",1,0],["ولقد كتمت الحب عن عذَّاله","لكن لسان الدمع ليس بألكنِ",90,"ن",1,0],["ولقد كتمتُ بأنَّ ريقك خمرة","ما حيلتي بنميمة المسواك",91,"ك",1,0],["وَلَقَد كُنتُم حَديثاً زَمَعاً","وَذُنابى حَيثُ يَحتَلُّ الصَغارُ",92,"ر",1,0],["ولقد كشفت لها قناع قناعة","خلعت رداء العجز والإملاق",93,"ق",1,0],["وَلَقَد كادَ مُغنى دار سُعدى باظلُما","يُكلمنا لَو ان ربعا تَكلما",94,"م",2,1],["وَلَقَد كانَ ما عَلِمتِ وَصولاً","وَلَقَد كانَ رَحمَةً في سَناءِ",95,"ا",2,0],["وَلَقَد كانَ بَعدَ ذلِكَ نوراً","وَسِراجاً يُضيءُ في الظَلماءِ",95,"ا",2,0],["وَلَقَد كانَ كارِهاً لِلَّذي كا","نَ رَجاءً بِأَن يَكونَ الرباحا",96,"ح",2,0],["ولقد كنتِ برهةً لِي يميناً","ما توقّعتُ أن تكوني يَسارا",97,"ر",2,0],["وَلَقد كُنتُمُ لِدين رَسولِ ال","له فينا الأسماعَ والأبصارا",97,"ر",2,0],["وَلَقد كَفيتُهُمْ وما شَعروا","كيْدَ العِدا وَلِكَيدِهمْ وقْدُ",98,"د",1,0],["وَلَقَد كانَ طَويلُ ال","باعِ طَعّاناً ضَروبا",99,"ب",2,0],["وَلَقَد كَتمتُهمُ هَوايَ بِهم","وَالحبُّ داءٌ كَظمهُ صَعْبُ",100,"ب",1,0],["ولقد كان عارفاً بالتجلي","فيه لكن دهاه قطع الرقيقه",101,"ق",2,0],["ولقد كان مطلقاً","فبدا كالمقيد",102,"د",1,0],["ولقد كتبتُ مُؤرِّخاً في بابهِ","يا حَيُّ كُنْ بخلاصِنا مُتشَفِّعا",103,"ع",2,0],["ولقد كتبتُ لهُ على صَفَحاتهِ","يا لَوْعتي مِن ذلكَ المكتوبِ",104,"ب",1,0],["ولَقد كَتَبتُ إلى الحبيبِ رسالةً","تَشتاقُ صَفْحتُها اغتِنامَ صِفاحِهِ",105,"ح",2,0],["وَلَقَدْ كَتَمْتُ هَوَاكَ أَوْثَقَ صَاحِبْ","عِنْدِي مَخَافَةَ أَنْ يَكُونَ عَدُوَّا",106,"و",2,1],["ولقد كَفَفْتُ عِنان عيني جاهداً","حتَّى إِذا أَعْيَيتُ أَطلَقْتُ العَنا",107,"ن",2,0],["وَلَقدْ كَفاكَ الله تع","بئةَ الْميَامِنِ وَالميَاسِر",108,"ر",1,0],["ولقد كُسيتُ من النُّح","ولِ كمَا عَرِيتُ من الثِّيابِ",109,"ب",1,0],["وَلَقَدْ كَتَبْتُ إِلَيْكَ لَمَّا جَدَّ بي","وَجْدِي عَلَيْكَ وَزَادَتِ الأَشْوَاقُ",110,"ق",1,1],["وَلَقد كَسى الإيوانَ تِبراً بعدما","بالسعيِ جاد له بكلّ ثمينِ",111,"ن",1,0],["وَلَقَد كَتَمتُ هَواكِ لَولا عَبرَةٌ","نَمَّت عَلَيَّ بِلَوعَتي وَهَواكِ",112,"ك",1,0],["ولقد كدت أن أنال الثريا","وعيوني من السمرة تهمي",113,"م",2,0],["وَلَقَد كانَ قَبلُ بَين يَديهِ","فَرَمانٌ في طَيِّهِ مُشتَهاه",114,"ا",2,0],["وَلَقَد كانَ عَدلُه سارَ في الأق","طار وَاِمتدّ في جَميع قُراه",114,"ا",2,0],["وَلَقَد كَفت عَن الشَكوى إِلى","أَن رَأَت وَجهك يا نعم الإِمام",115,"م",1,0],["وَلَقَد كُنتَ لِلمنافق خَصماً","فَغَدا الآن أَوّل الأَصدقاء",116,"ا",2,0],["وَلَقَد كَتَمتُ هَواكَ لَكِن مُقلَتي","شَوقاً إِلى مَغناكَ لَيسَت تكتمُ",117,"م",1,0],["ولقد كان لي ضحيّةَ عيدٍ","ذاتَ قرنينِ رائقيْنِ وصُوفِ",118,"ف",1,0],["ولقد كان لي محيّاكَ بدْراً","نورُه للجفونِ أفضلُ كُحْلِ",119,"ل",1,0],["ولقد كان ما عملتُ ظريفاً","باذلاً ما وراءَه للظراف",120,"ف",1,0],["ولقَدْ كَسا جيدَ الزّمانِ وجودهُ","عقْدَ المَفاخرِ والجَمالِ مُنضَّدا",121,"د",2,0],["ولقد كان عاشقاً للقوافي","حافظاً منه أروع الأبياتِ",122,"ت",1,0],["ولقد كانت عروساً شَوّهت","نوبُ الدهر محيَّاها الحسن",123,"ن",1,0],["ولقد كانوا ملوكاً بسَبا","وبصنعاءَ وطالوا في سَمَدْ",124,"د",1,0],["ولقد كنَّا بهمٍّ","مُسْهِرٍ قلباً وجفناً",125,"ن",2,0],["وَلَقَد كُنتُ لِلحُتوفِ عَلَيهِ","مُشفِقاً لَو أَعاذَهُ إِشفاقي",126,"ق",2,0],["ولقدْ كَانَ فِي كَتَائِبَ خُضْرٍ","وبَلاطٍ يُلاطُ بالآجِرُونِ",127,"ن",1,0],["وَلَقد كتمتُ وِدادها","منّي فباحَ وما اِنكتَم",128,"م",1,0],["وَلَقد كلفتُ بها ولا عجباً لمن","أَضحى بِها أبداً يهيمُ ويكلفُ",129,"ف",1,0],["ولقد كنت شموسا ولكن","ربما راض لجام شموسا",130,"س",2,0],["ولقد كان شفاءً","من جوى القلب السقيم",131,"م",1,0],["وَلَقَدْ كَانَ بِالرَّجَاءِ اعْتِصَامِي","فَاعْتِصَاماً رَجَوْتُ أَنْأَ اعْتِصَامَا",132,"م",2,0],["ولقد كان للتكبر أهلاً","لو أُجِيزت لدى العلا كبرياءُ",133,"ا",2,0],["ولَقد كُنتُ في الخطوبِ المُفَدّى","حينَ إذ تُستطارُ خورُ الرجالِ",134,"ل",1,0],["ولقد كتبت أشواقى ولم","أجعل اليك سوى النسيم رسولا",135,"ل",2,0],["ولقد كفاني أنّني لكَ مُنتم","أم أنّني من جملةِ الضيفان",136,"ن",1,0],["وَلَقَد كَشَفتُ وَإِنَّني لَكَ ناصِحٌ","فَكَشَفتُ محضَ هَوىً وَصِدقَ وِدادِ",137,"د",1,0],["ولقد كنت للآلئ سمطا","فوهى سمط عقدها المأمول",138,"ل",1,0],["ولقد كانت لعمري قفصا","لفؤاد طار في اجو الهوى",139,"ا",1,0],["ولقد كسوت القلب جُنة سلوة","سلبت وقد برز الغرام مُقاتلا",140,"ل",2,0],["وَلَقَد كُنتُ أستضِي بِسرَاجٍ","قَبلُ لكِن عُوِّضتُ عَنه ثُرَيَّا",141,"ي",2,0],["وَلَقَد كَتبت وَفكرتي مَشغولة","عَنكُم بنقل الجصّ وَالأحجار",142,"ر",1,0],["وَلَقد كذبته أَبناء حَرب","مِثلَما كذَّب المَسيح اليَهود",143,"د",1,0],["وَلَقَد كُنّيتُ عَنِ اِسمِها","عَمداً لِكَي لا تَغضَبا",144,"ب",2,0],["وَلَقَد كانَ قَبلَ إِظهارِهِ النُس","كَ قَديماً مِن أَظرَفِ الفِتيانِ",145,"ن",1,0],["وَلَقَد كانَ ذا قَوائِمَ مُلسٍ","يُؤكَلُ اللَّحمُ فَوقَهُ وَالخَبيصُ",146,"ص",1,0],["وَلَقَد كُنتُ مُنعِظاً","أَبَداً قائِمَ الذَكَر",147,"ر",1,0],["ولقد كسبتُ بكُم علاء لكنّما","صارت بأقوال الوشاة هباء",148,"ا",2,1],["وَلَقد كانَ أَنيسي بَصَريِ","فَعَدمتُ الأُنسَ مِنهُ وَالوَسَن",149,"ن",1,0],["ولقد كان منه ما كان بدعا","في المهمات إذ تحرى وحرر",150,"ر",1,0],["ولقد كتمت صبابتي وبنو الهوى","ما بين كاتم صبوة او معلن",151,"ن",1,0],["ولقد كفانا الله في أعدائنا","فضلا فبعد صعوبة قد هانوا",152,"ن",3,0],["ولقد كلفت بحيبكم وجمالكم","قدما وإنى بالجمال مولع",153,"ع",1,0],["وَلَقَد كانَ السُرور به","يَزدَهي في بُرده القشبِ",154,"ب",1,0],["وَلَقَد كنت أَحسب الودّ منهم","نيَّةً حرَّة فَكانَ رياءَ",155,"ا",2,0],["وَلَقَد كادَ يَنقَضي نصف قرن","لم نكد فيه ندرك الأقرانا",156,"ن",2,0],["ولقد كانت ترجى أنها","تكمد الأعداء في طول بقاه",157,"ا",2,0],["ولقد كان له بعض اصطبار","خان فيه هجر ذيّاك المليح",158,"ح",1,0],["ولقد كتبت وبي من الأشواق ما","لو كان بالجبل الأشمّ لهدّه",159,"ه",1,1],["وَلَقَد كَتبتُ وَلو أَصبتُ لَكان من","دَمعي المِداد وَمحبري آماقي",160,"ق",2,0],["وَلَقد كَفته تجاربٌ في طيها","عبرٌ تحذِّر ما دَهى الإِغراء",161,"ا",2,0],["وَلَقد كَتبت براحَتي","ما فيهِ أَرجو راحَتي",162,"ت",2,1],["وَلَقَدْ كانَ لِنَفْسي جَلَدٌ","وَأراها اليَوْمَ فِيهِ دُهِيَتْ",163,"ت",1,0],["ولقد كتمت الحب حتى خانني","دمعي الهتون وباح بالكتماني",164,"ن",2,0],["ولقد كرهتُ العيشَ بعدَ بِعادكمِ","ما في الحياةِ إذا بعُدتُم رَونَقُ",165,"ق",1,0],["وَلَقد كِلفتُ بِحُبِّ سُكانِ الحِمَى","كلفاً أَقَامِ بِأَعظُمي ومَفاصِلي",166,"ل",2,0],["ولقد كدرتّ وداً","صافي المنهل عَذبا",167,"ب",2,0],["وَلَقَد كُنتُ أَنطِقُ الشِّعرَ دَهراً","ثُمَّ حالَ الجَريضُ دونَ القَريضِ",168,"ض",1,0],["وَلَقَد كَسَرتَ نَشاطَهُ","وَأَذَقتَهُ ما أَسهرُه",169,"ر",2,0],["ولقد كُنَّا نُعزِّى النفسَ لو","كنتمُ قبلَ التّنائى مثلَنا",170,"ن",2,0],["ولقد كنت لنا حصناً به","نحتمي من كل شيطان قبيح",171,"ح",1,0],["ولقد كنتُ للهوَى مستجيباً","ليتها للهوَى بقلبي استجابت",172,"ت",1,0],["ولقد كنتَ والشباب عقيدي","أعشَقَ الناس من شبابِ وشيبِ",173,"ب",1,0],["ولقد كنتِ بعتِ نَوْ","مَ لياليه بالسَّهَر",174,"ر",1,0],["ولَقد كُنتُ قبلَ ذا في لُجاجٍ","حالِماً واهِماً يُنسّم ريحا",175,"ح",2,0],["ولقد كنت إن هممت إليها","من غرام وما وجدت اصطبارا",176,"ر",2,0],["ولقد كانوا جميعاً قبل ذا","في عقابيل من الداء العقام",177,"م",1,0],["ولقد كان بلا روحٍ كما","كان منكسراً يحاصره أساه",178,"ا",2,0],["ولقدْ كنا اشتريْنا مثلَها","بالمَلاليمِ فما عزَّ الأجيرْ",179,"ر",1,0],["ولقدْ كَسَبْتُ مِنَ المُسيءِ بأنّني","حتى النِّهايةِ مُحْسِنٌ ومُؤَدَّبُ",180,"ب",1,0],["ولقد كتبتُ على الندى أسرارها","حتى بدا بين الشفاه مولّه",181,"ل",2,0],["وَلَقَدْ كَتَمْتُ الحُبَّ حَتَّى إِنَّما","أَفْشاهُ مُنْسَكِبُ الدُّمُوعِ فَباحَا",182,"ح",2,0],["ولقد كلت الفهوم فلم","تدركه طبق الذي له من صفات",183,"ت",1,0],["ولقد كان نبيا مجتبى","لم يزل يعلو على بدر التمام",184,"م",1,0],["وَلقَدْ كَتَبنَا لِلْخُلُودِ جِهَادَهُمْ","فِي الخالِدَاتِ مَنَارة كَيْ نُبْصَرَا",185,"ر",2,0],["وَ لَقَدْ كَتَمْتُ الحُبَّ حَتَّى شَلَّنِي","وَ رَشَحْتُهُ - قَسْرًا - فَلَجَّ وَ أَفْصَحا",186,"ح",2,0],["وَ لَقَدْ كَنتِ مِنَّةً مِنْ إِلاهي","جَلَّ مَنْ مَنَّ . فاسمُكِ اليَومَ : \" مِنَّهْ \"",187,"ن",2,0],["ولقد كسيت من الرخام غلائلاً","نسجت ولكن من نقى المرمر",188,"ر",1,0],["ولقد كنْتِ سُهاداً قاتِلاً..","لِعُيُونٍ كابَدتْ هَوْلَ اللَّيالْ!",189,"ل",1,0],["ولقد كساني حسن رأيك حلة","غضت محاسنها عيون حسودي",190,"د",2,0],["ولقد كنتُ طائراً يألف الضو","ءَ ولا يألف الدجى الغربيبَا",191,"ب",2,0],["وَلَقدْ كَتَمْتُ هَوَاكَ أصدقَ صاحبٍ","عندي مخافة َ أنْ يعودَ عدوَّا",192,"و",2,1]]}