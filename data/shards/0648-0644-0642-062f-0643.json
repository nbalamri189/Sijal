لوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[551,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[551,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[558,"كان فرعون قاصدا تحقيقه","https://www.aldiwan.net/poem34290.html","الخفيف"],[558,"أمسك الحق باليد","https://www.aldiwan.net/poem34647.html","مجزوء الخفيف"],[562,"بيت لإيليا بني بعناية","https://www.aldiwan.net/poem52558.html","الكامل"],[562,"ذهب الحبيب فيا حشاشة ذوبي","https://www.aldiwan.net/poem52735.html","الكامل"],[562,"قف بالعقيق وسل نسيم رياحه","https://www.aldiwan.net/poem52903.html","الكامل"],[567,"ولقد كتمت هواك أوثق صاحب","https://www.aldiwan.net/poem69474.html","الكامل"],[575,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[575,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"],[575,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[586,"ولقد كتبت إليك لما جد بي","https://www.aldiwan.net/poem17617.html","الكامل"]],"verses":[["وَلَقَد كَبا طَرفُ الرُقادِ بِناظِري","أَسَفاً عَليكَ فَلا لَعاً لِرُقادِ",0,"د",1,0],["وَلَقَد كانَ خِصاصُ الخِدرِ بي","يَسأَلُ البيضَ رِقاعاً مِن مُقَلْ",1,"ل",1,0],["وَلَقَد كَتَبتُ مَعَ الرَسولِ وَإِنَّني","لَأَراهُ أَنجَحَ مِن كِتابِ الهُدهُدِ",2,"د",1,0],["ولقدْ كُنْتُ صَبوراً إنّما","صدَعَ البيْنُ فؤادي وكَواهُ",3,"ا",2,0],["وَلَقَدْ كَفَاهَا شَاهِداً مَهْمَا ادَّعَتْ","قَصَبَ السِّبَاقِ الْقُربُ مِنْ زَرْهُون",4,"ن",1,0],["وَلَقَد كَتَمتُ اِسمَ الَّذي أَحبَبتُهُ","وَدَفَنتُ سِرَّ حَديثِهِ بَينَ الحَشا",5,"ش",2,1],["ولقد كان في العلوم إماماً","حيث فيها انتهت إليه الرياسه",6,"س",2,0],["وَلَقَد كَسَرتَ سِنانَ كُلَّ مُنافِقٍ","وَلَقَد مَنَعتَ حَقائِبَ الحُجّاجِ",7,"ج",1,0],["وَلَقَد كانَت تَكونُ بِهِ","طَفلَةٌ مَمكورَةٌ كاعِبُ",8,"ب",1,0],["ولقدْ كوَى قلبي المشيبُ فما","تهفو العوَائدُ بي إلى الحبّ",9,"ب",1,0],["ولقد كافأ بالنعمى امْرُؤٌ","كافأ النعمى بإخلاص الودادِ",10,"د",1,0],["ولقد كنتَ من أمانيَّ مُذ كنْ","تُ وإن كان مذهبي أن أكيدَكْ",11,"ك",1,0],["ولقد كُنِّيَها من بعده","معشرٌ لم يلبسوا تلك الخلع",12,"ع",1,0],["ولقد كان في عِداتك عفوٌ","واغتفارٌ يستنطقاني بحمدك",13,"ك",1,0],["ولقد كادَ ما استطاعَ ولكنْ","جُعل الكيدُ منهُ في تضليل",14,"ل",1,0],["ولقد كان أهلُه ضيعوه","وأحلُّوه منزلَ الهِجرانِ",15,"ن",1,0],["ولقد كنت رُمتكم بهناتٍ","هُنَّ ما هُنَّ قاطعاتُ الوتين",16,"ن",1,0],["ولقد كان قبلَ ذلك يَنْفي","هِ فأضحى لرُشْدِهِ يجتبيه",17,"ي",2,0],["وَلَقَد كَتَمتُ هَواكُمُ","لَو كانَ مِمّا يُكتَمُ",18,"م",1,0],["ولقد كانتْ صَباحَ الأمْس بَيْنَ النَّسَماتْ","كعذارى الغابِ لا تعرِفُ غيرَ البَسَماتْ",19,"ت",1,0],["ولقد كان كاتبا عبقريا","وأديبا مصرحا لا يهاب",20,"ب",1,0],["ولقد كان الحق في كل جيل","ضائعاً بين سائد فذودي",21,"د",2,0],["ولقد كنت في قريضك ترجو","ما لحق اهين من احقاق",22,"ق",1,0],["ولقد كان صوتك العذب قبلا","في الفتغراف مالئا كل دار",23,"ر",1,0],["ولقد كشفنا للصروف صدورنا","اما الصروف فلا تطيش نبالهال",24,"ل",1,0],["ولقد كرهت العقل فهو","بما يشير مكبلي",25,"ل",2,0],["ولقد كنا في وفاق معاً نر","ضى عن الشيء او معاً نتغضب",26,"ب",1,0],["ولقد كادت بها ترني","لي الصم الصلاب",27,"ب",1,0],["ولقد كان قبل ذلك يأتي","حاملا للسلام في اردانه",28,"ن",2,0],["ولقد كنت بالطبيعة أشدو","يوم ما كان ذكرها غير همس",29,"س",1,0],["وَلَقَد كَفاكَ المَكرُماتِ مُهَذَّبٌ","يُرضيكَ مِنهُ النَقضُ وَالإِبرامُ",30,"م",1,0],["وَلَقَد كُلِّفتُ أَمراً عَجَباً","أَسأَلُ التَفريحَ مِن بَيتِ الحَزَن",31,"ن",1,0],["وَلَقَد كُلِّفَ شَيئاً عَجَباً","زادَ في النَكبَةِ وَاستَوفى المِحَن",31,"ن",1,0],["ولقد كادَتْ تعاطَى لَقْطَهُ","رغبةً فيه كريماتُ الخُرُد",32,"د",1,0],["وَلَقَد كُنتُ قَد عَرَفتُ وَأَبصَر","تُ أُموراً لَو أَنَّها نَفَعَتني",33,"ن",2,0],["وَلَقَد كانَ آهِلاً","فيهِ ظَبيٌ مُبَتَّلُ",34,"ل",1,0],["وَلَقَد كَتَمتُ الحُبَّ بَينَ جَوانِحي","حَتّى تَكَلَّمَ في دُموعِ شُؤوني",35,"ي",1,0],["وَلَقَد كانَ في عَن تَبَعِ اللَه","وِ وَإِذا أَعرَضَ المُحِبُ اِعتِراضُ",36,"ض",1,0],["وَلَقَد كانَ إِلَيكَ فَقيراً","لا يَرى مِثلَكَ في اللابِسينا",37,"ن",2,0],["وَلَقَد كُنتُ أَراها آهِلا","تٍ كَذاكَ الدَهرُ يَعصي وَيُطيعُ",38,"ع",1,0],["ولقد كفيتَ فكنتَ سيفاً ليس بال","نابي ورُكْناً ليسَ بالمهدود",39,"د",1,0],["وَلَقَد كُنّا عَرَتنا جَفوَةٌ","أَكَلَت مِنّا السُلامى وَالقُصَر",40,"ر",1,0],["وَلَقَد كُنتُ ذا مُزاحٍ فَأَصبَح","تُ عَلى حُبِّها قَليلَ المُزاحِ",41,"ح",1,0],["وَلَقَد كَلِفتُ بِها وَعَيَّرَني الهَوى","بادي النَصيحَةِ ساكِنُ الأَرواحِ",42,"ح",1,0],["وَلَقَد كُنتُ عَلَيكُم عاتِباً","فَعَقَبتُم بِذُنوبٍ غَيرِ مُر",43,"ر",1,0],["ولقد كنتُ في البداءة أشحى","مثلما يشحى للخشاة الذعورُ",44,"ر",1,0],["ولقد كانت الوجوهُ من الصا","لينَ سوداً كأنهن القير",44,"ر",1,0],["ولقد كانت الملامح تخفى","ولقد كانت العيونُ تغور",44,"ر",1,0],["ولقد كان آخرون حوالَي","هم جثوماً وكلهم موتور",44,"ر",1,0],["ولقد كاد يخنقُ الغيظُ بشا","راً وفي وجهه الدميم بثور",44,"ر",1,0],["ولقد كان لامرئ القيس بين ال","قوم صدرٌ وللملوك الصدور",44,"ر",1,0],["ولقد كانوا يفتكون ولا يب","صر منهم مهاجمٌ أو مغير",44,"ر",1,0],["ولقد كانت البطونُ تَفَرَّى","ولقد كانت الرؤوس تطير",44,"ر",1,0],["ولقد كادت السموات تهوي","ولقد كادت النجوم تغور",44,"ر",1,0],["وَلَقَد كنت قد بنيت بجهد","ليَ عشاً في مجمع الأوراق",45,"ق",1,0],["وَلَقَد كالَ لي الأعادي هواناً","وَلهم قد أَكيلُ صاعاً بصاع",46,"ع",1,0],["وَلَقَد كانَت الملاوم منها","كَسِهام يصبن إِثر سهام",47,"م",1,0],["وَلَقَد كانَت الشموس قَديماً","تابعات لغيرها في السماء",48,"ا",2,0],["ولقَد كانَ ذا جُنُودٍ وتاجٍ","تَرهَبُ الأُسدُ صَولَهُ والزَّئيرا",49,"ر",2,0],["ولقد كنا وما كنا سوى","مثلما يستجمع العينين خد",50,"د",1,0],["وَلَقَد كُنتُ أَطّبي كُلَّ طبّ","وَأواخي وَللإخاءِ ذِمامُ",51,"م",1,0],["وَلَقَد كانَ عَلى أَوصابِهِ","رُبَّما نامَ ثَلاثاً في نَسَق",52,"ق",1,0],["ولقد كان قبله الليل يدجو","قابضاً للقلوب والأرواح",53,"ح",1,0],["وَلَقَدْ كُنْتُ إِذْ أُرَجِلُ رَأْسِي","ما أبالي الإفسادَ وَ الإصلاحا",54,"ح",2,0],["ولقد كتمت غرامها","إذا تلك تغضبها الإشاعه",55,"ع",2,0],["وَلَقَد كُنتُ زَماناً","خالي الذَرعِ لِشاني",56,"ن",2,0],["ولقد كسوتَ الملك ثوب مهابةٍ","سلبت عيونَ عداك أبوابُ الكرا",57,"ر",2,0],["ولقد كفيتَ من الخطوب أجلّها","ولقد حميت فكنت خير محامي",58,"م",2,0],["وَلَقَد كَتَبتُ مؤرِّخاً مِن فَوقِهِ","يا تُربةَ الرَيحانِ يَسقيكِ النَّدَى",59,"د",2,0],["ولقد كانَ في هواكَ عزيزاً","يتأبى على الظباءِ الحورِ",60,"ر",1,0],["ولقد كتمت عن الورى كلفي","دفعا لسهم القيل والقالي",61,"ل",2,0],["وَلَقَد كُنتِ تَبسَمينَ بِحَظٍّ","فَلِماذا أَمسَيتِ لا تَبسَمينا",62,"ن",2,0],["وَلَقَد كانَ لائِقاً بِكَ أَن تَح","مِلَ ضِعفَيهِ عِندَ عَزلِ الوَزيرِ",63,"ر",1,0],["ولقد كنتُ بالشباب جَمُوحاً","غير أن المَشِيبَ ممَّا يَرُوضُ",64,"ض",1,0],["ولقد كسوتكَ من قريضٍ حُلَّةً","جَلَّت عن التلفيقِ والترقيعِ",65,"ع",1,0],["ولقد كَدت أن أهيم بِحَملِ","الهم لولا تَعَلِلُّي بالأماني",66,"ي",1,0],["وَلَقَدْ كَسَا حَتَّى الصحَائِف جدَّةً","مِن جُودِهِ وَأَفادَها تَنبِيها",67,"ي",3,0],["وَلَقَد كانَ آهِلاً غَيرَ قَفرِ","مُخصِباً خَيرُهُ كَثيرُ العِمارَةِ",68,"ر",2,0],["ولقد كنت آملاً لسواها","وسواها بوعده أن ينيله",69,"ل",2,0],["وَلَقَد كَلفت بشيشة ما نالَها","كِسرى وَلا ماء السَماء لَها حوى",70,"و",2,1],["وَلَقَد كَتَمت صَبابَتي","وَأَظُّنُها لا تَكتُم",71,"م",1,0],["ولقد كفَلْتَ بها ورأْيُك وَحْدَه","حَسْبي لها سَبباً وإن لم تَكْفُل",72,"ل",1,0],["ولقد كَتَمتُ عنِ العَذول صَبابتي","لكنّ دَمْعيَ لَجَّ في الإفشاءِ",73,"ا",2,0],["وَلَقَد كُفيتُ العَذلَ فيكَ لِشيمَةٍ","غَضَّت لِحاظَ الأَشوَسِ المُتَخايِلِ",74,"ل",1,0],["ولقد كان في المكارم قومٌ","أخذوها بيضاً وجاؤا بسودِ",75,"د",1,0],["ولقد كِدْتَ أن ترى ما وراء الغَ","يْبِ عُلوماً أُلهِمتَها إلهاما",76,"م",2,0],["ولقد كفاني الله فيه عصابة","لا أرتجيهم أبرقوا أم أرعدوا",77,"د",3,0],["ولقد كَمُلْتَ فما يقالُ لقد","نلْتَ السكمالَ جميعَه إِلاَّ",78,"ل",2,0],["ولقد كسوتُ القلبَ لأْمةَ سَلْوَةٍ","وعلِمْتُ أَنَّ الحُسْنَ أَولُ سالبِ",79,"ب",1,0],["ولقد كان ومن آرابِه","غُصُنٌ ماسَ وبدر كُمِّلا",80,"ل",2,0],["ولَقَدْ كَرَرْتُ عَلَى الملامِ بِزَفْرَةٍ","ذَهَلَ العِتَابُ بِهَا عَنِ الإِعْتَابِ",81,"ب",1,0],["ولقد كفاني في العفافِ بصيرةً","ذلُّ الحريصِ ورزقُه مقسومُ",82,"م",1,0],["ولقد كنَّ متى استبطأنني","قمن يسألن أخونا ما فعلْ",83,"ل",1,0],["ولقد كنتُ عالماً أن إقبا","لي بمدحي عليكُمُ إقبالُ",84,"ل",1,0],["ولقد كفاني شيبُ رأسي عَبرةً","وعلى الفَناء دلالة أن نُقِّصا",85,"ص",2,0],["ولقد كنزتُ فهل علمتَ مكانهُ","من صفوِ أيّامي ومن خيراتها",86,"ت",3,0],["ولقد كرمت عن الإجابة فليكن","منك التَّغَمُّدُ للأغَرِّ الأجْهَلِ",87,"ل",1,0],["ولقد كشفت بسيف رأيك غَيْهَباً","نسخَ النَّهارَ بليلِ نقْعٍ ألْيَلِ",88,"ل",1,0],["ولقد كدتُ فيك أجهزُ بالت","تفضيل لولا إشارةُ النُصَّاح",89,"ح",1,0],["ولقد كتمت الحب عن عذَّاله","لكن لسان الدمع ليس بألكنِ",90,"ن",1,0],["ولقد كتمتُ بأنَّ ريقك خمرة","ما حيلتي بنميمة المسواك",91,"ك",1,0],["وَلَقَد كُنتُم حَديثاً زَمَعاً","وَذُنابى حَيثُ يَحتَلُّ الصَغارُ",92,"ر",1,0],["ولقد كشفت لها قناع قناعة","خلعت رداء العجز والإملاق",93,"ق",1,0],["وَلَقَد كادَ مُغنى دار سُعدى باظلُما","يُكلمنا لَو ان ربعا تَكلما",94,"م",2,1],["وَلَقَد كانَ ما عَلِمتِ وَصولاً","وَلَقَد كانَ رَحمَةً في سَناءِ",95,"ا",2,0],["وَلَقَد كانَ بَعدَ ذلِكَ نوراً","وَسِراجاً يُضيءُ في الظَلماءِ",95,"ا",2,0],["وَلَقَد كانَ كارِهاً لِلَّذي كا","نَ رَجاءً بِأَن يَكونَ الرباحا",96,"ح",2,0],["ولقد كنتِ برهةً لِي يميناً","ما توقّعتُ أن تكوني يَسارا",97,"ر",2,0],["وَلَقد كُنتُمُ لِدين رَسولِ ال","له فينا الأسماعَ والأبصارا",97,"ر",2,0],["وَلَقد كَفيتُهُمْ وما شَعروا","كيْدَ العِدا وَلِكَيدِهمْ وقْدُ",98,"د",1,0],["وَلَقَد كانَ طَويلُ ال","باعِ طَعّاناً ضَروبا",99,"ب",2,0],["وَلَقَد كَتمتُهمُ هَوايَ بِهم","وَالحبُّ داءٌ كَظمهُ صَعْبُ",100,"ب",1,0],["ولقد كان عارفاً بالتجلي","فيه لكن دهاه قطع الرقيقه",101,"ق",2,0],["ولقد كان مطلقاً","فبدا كالمقيد",102,"د",1,0],["ولقد كتبتُ مُؤرِّخاً في بابهِ","يا حَيُّ كُنْ بخلاصِنا مُتشَفِّعا",103,"ع",2,0],["ولقد كتبتُ لهُ على صَفَحاتهِ","يا لَوْعتي مِن ذلكَ المكتوبِ",104,"ب",1,0],["ولَقد كَتَبتُ إلى الحبيبِ رسالةً","تَشتاقُ صَفْحتُها اغتِنامَ صِفاحِهِ",105,"ح",2,0],["وَلَقَدْ كَتَمْتُ هَوَاكَ أَوْثَقَ صَاحِبْ","عِنْدِي مَخَافَةَ أَنْ يَكُونَ عَدُوَّا",106,"و",2,1],["ولقد كَفَفْتُ عِنان عيني جاهداً","حتَّى إِذا أَعْيَيتُ أَطلَقْتُ العَنا",107,"ن",2,0],["وَلَقدْ كَفاكَ الله تع","بئةَ الْميَامِنِ وَالميَاسِر",108,"ر",1,0],["ولقد كُسيتُ من النُّح","ولِ كمَا عَرِيتُ من الثِّيابِ",109,"ب",1,0],["وَلَقَدْ كَتَبْتُ إِلَيْكَ لَمَّا جَدَّ بي","وَجْدِي عَلَيْكَ وَزَادَتِ الأَشْوَاقُ",110,"ق",1,1]]}