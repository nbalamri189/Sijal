{"poems":[[53,"أتذهل بعد إنذار المنايا","https://www.aldiwan.net/poem29623.html","الوافر"],[77,"غشيان مثواك مثوى الجود يوم ندى","https://www.aldiwan.net/poem36562.html","البسيط"],[9,"غشيت لليلى بليل خدورا","https://www.aldiwan.net/poem21941.html","المتقارب"],[86,"سائلوا الليل عنهم والنهارا","https://www.aldiwan.net/poem10926.html","الخفيف"],[73,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[0,"غشيت ديار الحي بالبكرات","https://www.aldiwan.net/poem55.html","الطويل"],[35,"يا لقومي لحبلك المصروم","https://www.aldiwan.net/poem38826.html","الخفيف"],[35,"غشيت لليلى بالبرود مساكنا","https://www.aldiwan.net/poem39153.html","الطويل"],[93,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[93,"أتموت حتف الأنف يا ضرغام","https://www.aldiwan.net/poem11396.html","الكامل"],[93,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[54,"أبا مخلد كنا حليفي مودة","https://www.aldiwan.net/poem27531.html","الطويل"],[88,"أنا بالحكومة والسياسة أعرف","https://www.aldiwan.net/poem44808.html","الكامل"],[27,"ألا زارت وأهل منى هجود","https://www.aldiwan.net/poem5731.html","الوافر"],[4,"غشيت ديار الحي بالسبعان","https://www.aldiwan.net/poem21207.html","الطويل"],[51,"عقيد الندى أطلق مدائح جمة حبائس","https://www.aldiwan.net/poem9394.html","الطويل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"لما استقل بك الطريق إلى العدا","https://www.aldiwan.net/poem65767.html","الكامل"],[51,"تمادى الصبا بي في غيه","https://www.aldiwan.net/poem66334.html","المتقارب"],[29,"عفا ممن عهدت به حفير","https://www.aldiwan.net/poem6048.html","الوافر"],[29,"ألا لا تلوميني على الخمر عاذلا","https://www.aldiwan.net/poem6175.html","الطويل"],[85,"يمد الدجى في لوعتي ويزيد","https://www.aldiwan.net/poem63672.html","الطويل"],[85,"تحية شاعر يا ماء جكسو","https://www.aldiwan.net/poem63712.html","الوافر"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[45,"أيها العاتب الذي ليس يرضى","https://www.aldiwan.net/poem64637.html","الخفيف"],[45,"أحرى الخطوب بأن يكون عظيما","https://www.aldiwan.net/poem65661.html","الكامل"],[45,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[61,"أؤنب الشوق فيهم وهو يضطرم","https://www.aldiwan.net/poem51449.html","البسيط"],[61,"قل لابن فهد وإن شطت منازله","https://www.aldiwan.net/poem51713.html","البسيط"],[2,"غشيت ديارا بالنقيع فثهمد","https://www.aldiwan.net/poem25047.html","الطويل"],[66,"غير مجد مع صحة وفراغ","https://www.aldiwan.net/poem38483.html","الخفيف"],[80,"غشيت حجرها دموعي حمرا","https://www.aldiwan.net/poem31463.html","الخفيف"],[69,"يا حامل النائب في حكمه","https://www.aldiwan.net/poem29203.html","السريع"],[31,"غشيت بأذناب المغمس منزلا","https://www.aldiwan.net/poem42465.html","الطويل"],[74,"سجعت وقد غنى الحمام فرجعا","https://www.aldiwan.net/poem13173.html","الطويل"],[74,"وعاذر قد كان لي عاذلا","https://www.aldiwan.net/poem13215.html","السريع"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"غشيت ديارها من بعد عشر","https://www.aldiwan.net/poem43399.html","الوافر"],[105,"يا بني سعد بن بكر مرحبا","https://www.aldiwan.net/poem43987.html","الرمل"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[102,"أغمدان ما يبكيك يا كعبة الهدى","https://www.aldiwan.net/poem33035.html","الطويل"],[102,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[39,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[52,"ضمن اللقاء رواح ناجية","https://www.aldiwan.net/poem26664.html","الكامل"],[7,"غشيت منازلاً بعريتنات","https://www.aldiwan.net/poem1959.html","الوافر"],[46,"وصل الهجير إلى الهجير لعله","https://www.aldiwan.net/poem22265.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16646","الكامل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50447","الطويل"],[45,"جُمِعَتْ أُمُورُ الدّينِ بَعدَ تَزَيُّلِ","https://www.poetsgate.com/ViewPoem.aspx?id=31869",""],[51,"ومُنْزل الوحْي علي نبيِّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30760",""],[51,"عقيدَ النَّدى أطلِقْ مدائح جمّة","https://www.poetsgate.com/ViewPoem.aspx?id=27413",""],[2,"غَشِيتُ دِياراً بالبَقيعِ فثَهْمَدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19485&r=&rc=11",""]],"verses":[["غَشومُ النابِ تَصرِفُ ناجِذاهُ","إِذا أَبقى أَحالَ عَلى البَقايا",0,"ا",3,0],["غِشْيانُ مَثْواكَ مثْوى الجودِ يوْمَ ندىً","ممّا يُنافِسُ فيهِ الوالِدُ الوَلَدا",1,"د",2,1],["غَشيتَ لِلَيلى بِلَيلٍ خُدورا","وَطالَبتَها وَنَذَرتَ النُذورا",2,"ر",2,1],["غَشِيَتهُم وَالنَحسُ يَجري يَميناً","وَرَمَتهُم وَالبُؤسُ يَجري يَسارا",3,"ر",2,0],["غُشيتَ فَلَم تَغشَ الطِرادَ سَوابِحٌ","وَلا جُرِّدَت بيضٌ وَلا أُشرِعَت سُمرُ",4,"ر",1,0],["غَشيتُ دِيارَ الحَيِّ بِالبَكَراتِ","فَعارِمَةٍ فَبَرقَةِ العِيَراتِ",5,"ت",1,1],["غَشِيَ الركبُ رَبعَها فَعَجِبنا","مِن بَلاهُ وَما المَدى بِمُقيمِ",6,"م",1,0],["غَشِيتُ لِلَيلى بِالبَرودِ مَساكِنًا","تَقادَمنَ فَاِستَنَّت عَليها الأَعاصِرُ",7,"ر",1,1],["غَشِيَتْ ثَبِيراً مِنْ أَسَاهُ غَمَامَةٌ","جَرَّتْ كَلاَكِلَهَا عَلَى لُبْنَانِ",8,"ن",1,0],["غَشِيَتْ مَكَانَ النَّابِ مِنْكَ وَدُونَهُ","لَوْ صَالَ أَوْصَالَ تُهَاضُ وِهَامُ",9,"م",1,0],["غَشُوا بِكَ فِي بُرْدِينَ دَاراً تَنَكَّرَتْ","فَعَامِرُهَا بِالأَمْسِ كَالرَّسْمِ طَاسِمُ",10,"م",1,0],["غَشَشتَ الهَوى حَتّى تَداعَت أُصولُه","بِنا وَاِبتَذَلتَ الوَصلَ حَتّى تَقَطَّعا",11,"ع",2,0],["غُشَّت مظاهرها ومُوِّه وجهها","فجميع ما فيها بهارج زُيَّف",12,"ف",1,0],["غَشوا ناري فَقُلتُ هَوانَ تَيمٌ","تَصَلّوها فَقَد حَمِيَ الوَقودُ",13,"د",1,0],["غَشيتُ دِيارَ الحَيِّ بِالسَبُعانِ","كَما البَدرُ فَالعَينانِ تَبتَدِرانِ",14,"ن",1,1],["غششتُك إن أنشدتُ مدحِيك عاطلاً","وعرَّضْتُك اللُّوَّام مُمْسىً ومُصْبَحا",15,"ح",2,0],["غَشَّ من أخَّرَ النصيحة عمْداً","عن إمام عليه جُلُّ اعتمادِهْ",16,"د",2,0],["غشِيتْكَ مِنْ نصرِ الإلهِ سحابةٌ","نالت حواشِيها وليَّك زيرُكا",17,"ك",2,0],["غشيتُ المنازلَ بالأنْعُمِ","كَمُنْعرجِ الوشي في المِعْصمِ",18,"م",1,0],["غَشَمتُم بِالسُيوفِ الصيدَ حَتّى","خَبا مِنها القَباقِبُ وَالهَديرُ",19,"ر",1,0],["غِشاشاً وُقوعَ الطَيرِ ثُمَّ تَصَدَّعَت","وَقَد أَشخَصَ الماءُ الكُلى وَالشَواكِلا",20,"ل",2,0],["غَشَيناهُ وَالأَيّامُ تَندى شَبيبَةً","وَيَقطُرُ مِنها العَيشُ وَهوَ رَغيدُ",21,"د",1,0],["غَشيتُكَ وَالأَصيلُ يَفيضُ تِبراً","وَيَنسُجُ لِلرُبى حُلَلاً وَيَكسو",22,"س",2,0],["غَشِيَت ساحِلَ المُحيطِ وَغَطَّت","لُجَّةَ الرومِ مِن شِراعٍ وَقَلسِ",23,"س",1,0],["غَشِيَ الدارِعينَ ضَرباً هَذاذي","كَ وَطَعناً يُوَرِّعُ الخَيلَ وَخضا",24,"ض",2,0],["غَشَمَ العَدُوَّ وَلَن يُقالَ غَشَمشَمٌ","لِلَّيثِ إِلّا أَن يَكونَ غَشوما",25,"م",2,0],["غَشِيَت قَناةُ النِمرِ حَتّى أَوجَفوا","عَنَقاً عَلى عُنُقِ الطَريقِ الأَقوَمِ",26,"م",1,0],["غَشِيتَهُم برماحٍ ليسَ بينَهُمُ","وبينَ أطرافِها إلٌّ ولا ذِمَمُ",27,"م",1,0],["غَشِيتُ بعدَك منسوباً إلى أدبٍ","يجفو الأديبَ ويُطفي نُورَه حسدَا",28,"د",2,0],["غَشيتُ دِياراً بِالنَقيعِ فَثَهمَدِ","دَوارِسَ قَد أَقوَينَ مِن أُمِّ مَعبَدِ",29,"د",1,1],["غَشِيَ الحَربَ يَهتَدي بِحُسامٍ","عارِفٍ بِالنُحورِ وَالأَصداغِ",30,"غ",1,0],["غَشِيَتْ حِجْرَهَا دُموعيَ حُمْراً","وَهْيَ مِنْ لوعةِ الهوى تَتَحَدّرْ",31,"ر",1,1],["غششتَهُ واللهِ في دينِهِ","بُشْراكَ بالنارِ التي أُضْرِمَتْ",32,"ت",1,0],["غَشيتُ بِأَذنابِ المُغَمَّسِ مَنزِلاً","بِهِ لِلَّتي نَهوى مَصيفٌ وَمَربَعُ",33,"ع",1,1],["غَشيتُ بِهِ أَندى مِنَ المُزنِ راحَةً","وَأَطيَبَ أَفياءً وَأَمرَعَ مَربَعا",34,"ع",2,0],["غَشيتُ مِن مُقلَتِهِ بابِلاً","سِحراً وَمِن لَحظَتِهِ نابِلا",35,"ل",2,0],["غَشّى عَلى أَبصارِكُم وَقُلوبِكُم","كَاللَيلِ مِن حُجُبٍ وَمِن أَكنانِ",36,"ن",1,0],["غَشيتُ دِيارَها مِن بَعدِ عَشرِ","فَهَيَّجَتِ الرُسومُ غَليلَ صَدري",37,"ر",2,1],["غَشِيَتْكُم من يَهودٍ فِتنةٌ","كالحَبِيِّ الجَوْنِ يُرخِي الهيدبا",38,"ب",2,0],["غَشَّاهُ سَعدٌ رَوعةً ما بعدها","لِذَوي المخافةِ في السّلامةِ مَطمحُ",39,"ح",1,0],["غَشيتك في دارٍ بِبَيروت لِلنَدى","وَلِلأَدب العالي فِناءً وَمُنتَدى",40,"د",2,0],["غَشِيَتْهُ الطيور مختلفات","رائعات الأَلوان والأشكال",41,"ل",1,0],["غَشومٌ إِذا طَلَبَت حاجَةً","مَعَ الغَشمِ آسِيَةٌ جارِحَه",42,"ح",2,0],["غِشَّ المَغيبِ فَإِن لَقَيتُهُمُ","سَجَنوا العَداوَةَ أَيَّما سَجنِ",43,"ن",1,0],["غَشيتُ مَنازِلاً بِعُرَيتِناتٍ","فَأَعلى الجِزعِ لِلحَيّ المُبِنِّ",44,"ن",1,1],["غَشّاهُ مُصفَرُّ الأَنامِلِ خافِياً","فَكَأَنَّهُ لِبَنانِهِ لَم يَنسُجِ",45,"ج",1,0],["غشيَ العينَ ظلُّهُ وتمشت","في دمي منه رعشةُ المقرورِ",46,"ر",1,0],["غَشِيَ الطيورَ غوافِلاً فَتَحَيّرَتْ","منه فلم تَبْرَحْ ولم تَتَنَفّض",47,"ض",1,0],["غَشَمْتَ العِدا واللَّيثُ لو قَلَّ غَشمُهُ","لأعدائِهِ ما قيلَ ليثٌ غَشَمْشَمُ",48,"م",1,0],["غَشّى الرّبيعُ دِيَارَهُمْ، وغَشِيتَهَا،","وَكِلاَكُما ذُو بَارقٍ مُتَهَلِّلِ",49,"ل",1,0],["غَشَمْشَمِّي السَّيلِ مأربيِّه","سِلْميِّه أسعدَ من حربيه",50,"ب",3,0],["غششتُك إن أنشدتُ مدحِيك عاطلاً","وعرَّضْتُك اللُّوَّم مُمْسى ً ومُصْبَحا",51,"ح",2,0],["غَشِيتُ دِياراً بالبَقيعِ فثَهْمَدِ","دوارسَ، قد أقوينَ من أمِّ معبدِ",52,"د",1,1]]}