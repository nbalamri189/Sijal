{"poems":[[203,"أجث خضوعا واحتراما لمن","https://www.aldiwan.net/poem45369.html","السريع"],[382,"الله الله أنت السمع والبصر","https://www.aldiwan.net/poem59432.html","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56288","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48942","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204652",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62762","الكامل"],[5219,"إليك يا سيدي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=193700",""],[5219,"أيام الله","https://www.poetsgate.com/ViewPoem.aspx?id=194555",""],[5781,"طُيوفكَ المنى ...وحبق","https://www.poetsgate.com/ViewPoem.aspx?id=208930",""],[5843,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=51282",""],[5956,"أجثو على قدميك أرجو الأمنا","https://www.poetsgate.com/ViewPoem.aspx?id=182414",""]],"verses":[["أُجثُ خضوعاً واحتراماً لمنْ","أمك في حواءَ من أمها",0,"ه",2,1],["أجثوا انكساراً إذا كررتُ ذكرَكمُ","كأنما قد علاني الصارم الذكر",1,"ر",1,0],["أجثو أمامك بالغداة مصلياً","وتراني قبل تبادر الهفواتِ",2,"ت",1,0],["أَجثو بهيكلِها أقدّسُ سرَّها","وأَظلُّ فيه حائرَ الأَفكار",3,"ر",1,0],["أجثم فوق خدها","أرنو الى رضابها",4,"ب",3,0],["أَجثوم طيرٍ طرنَ عن هاماتِهِم","أمْ هامُهم طارتْ عن الأجْسادِ",5,"د",1,0],["أجثو على عتبات رحت أنشده","منك الشفاعة لن أصغي لواشيها",6,"ي",3,0],["أجثو على الأعتاب أرجو وصله","أدنو من البحر الخضم وأغرف",7,"ف",1,0],["أَجْثو على جُرْحٍ شَقَقتُ بهِ الدُّجى","والحُزنُ هطّالٌ فمنْ غيري خَسِرْ!",8,"ر",1,0],["أجثيله من الظلوع العوج صبر وجمر وقاد","لن زاد برده وجا بينه وبين الحلم هوه",9,"و",2,0],["أجثو على قدميك أرجو الأمنا","أمَّ الفراس أيا ذراعي اليُمْنَى",10,"ن",2,1]]}