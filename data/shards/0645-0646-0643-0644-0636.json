{"poems":[[55,"لله ثم لك المحل الأعظم","https://www.aldiwan.net/poem29795.html","الكامل"],[93,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[87,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[63,"وهي الشموس فإن رأين طوالعا","https://www.aldiwan.net/poem51459.html","الكامل"],[46,"ما في وقوفك ساعة من باس","https://www.aldiwan.net/poem30485.html","الكامل"],[240,"لو بات من يلحي عليك مسهدا","https://www.aldiwan.net/poem32100.html","الكامل"],[257,"ظبى المواضي وأطراف القنا الذبل","https://www.aldiwan.net/poem1419.html",""],[422,"أنظر إلى هذه الدار التي كملت","https://www.aldiwan.net/poem53870.html","البسيط"],[469,"حي الديار برامتين ونادها","https://www.aldiwan.net/poem3435.html","عموديه"],[519,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[667,"","https://poetry.dctabudhabi.ae/diwan/poem/105538","الرجز"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104020","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63938","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79834","الكامل"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21551","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33383","المجتث"],[5790,"ما للجمال بوجنتيك معين","https://www.poetsgate.com/ViewPoem.aspx?id=112147",""]],"verses":[["مِن كُلِّ ضاحِكَةِ القَتيرِ كَأَنَّها","بُردٌ أَعارَكَهُ الشُجاعُ الأَرقَمُ",0,"م",1,0],["مِن كُلِّ ضاحِكَةٍ","كَأَنَّ بِوَجهِها وَجهَ البَشيرِ",1,"ر",1,0],["مِن كُلِّ ضاحِيَةٍ تَرمي بِمُكتَحَلٍ","إِلى مَكانِكَ أَو تَرمي بِمُختَضَبِ",2,"ب",1,0],["من كلِّ ضافي البُردِ ينطِقُ راكباً","بلسانِ حامِله ويَصمُتُ رَاجِلا",3,"ل",2,0],["مِن كُلِّ ضاحِكَةِ التَرائِبِ أُرهِفَت","إِرهافَ خوطِ البانَةِ المَيّاسِ",4,"س",1,0],["مِن كُلِّ ضَرّابِ الفَوارِسِ مِحرَبٍ","يَجِدُ الدِماءَ مِنَ المَلابِسِ مِجسَدا",5,"د",2,0],["مِن كُلِّ ضافيَةِ السِربالِ صافيَة القِذاف","بالنَبل فيها الخَذف بالنبلِ",6,"ل",1,0],["من كلّ ضيفٍ من الأمجاد يقصدها","وفي الأماجد أنواعٌ وأصناف",7,"ف",1,0],["من كل ضاحكة البروق إذا انبرت","ردعتْ حواشي دجنها بجسادها",8,"د",3,0],["من كُلّ ضِرغامٍ بظهرِ نعامةٍ","للطّعن يُمسِك في الأناملِ أرقُما",9,"م",2,0],["من كل ضمياء شهية اللمى","ما أظمأ القلب إلى تقبيلها",10,"ل",3,0],["من كُلّ ضافيةِ الغدير ترى لها","طُرُقاً تصيرُ على المتُونِ غدائرا",11,"ر",2,1],["من كلِّ ضاحكةٍ إلى بيضٍ بها","زَهَرُ الرياضِ الضاحكُ الوبَّاص",12,"ص",1,0],["من كلّ ضامية الوشاحِ","رويّة الخلخال رودِ",13,"د",1,0],["مِن كُلِّ ضامِرة الحَشا مَهضومَة","لِحبالِها بِحبالِنا تَلبيسُ",14,"س",1,0],["مِن كُلِّ ضافي هَيدَبٍ كَأَنَّهُ","مُجَللٌ أدهم يَمشي الهَيدبي",15,"ي",1,0],["من كل ضري إلى لَح","ظِ مقلتيهِ ونفعي",16,"ع",2,0],["من كل ضاربة اللثام وإنما","تحت اللثام محاسن وفنون",17,"ن",1,0]]}