{"poems":[[102,"لعيني أم بلقيس","https://www.poetsgate.com/ViewPoem.aspx?id=50431",""],[128,"دراك يا شيخ فان حيدرا","https://www.aldiwan.net/poem23762.html","الرجز"],[203,"إلى البيض سورة هذا الجماح","https://www.aldiwan.net/poem45517.html","المتقارب"],[275,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[309,"تفيض عيون بالدموع السواكب","https://www.aldiwan.net/poem16819.html","الطويل"],[347,"شباب العرب بوركتم شبابا","https://www.aldiwan.net/poem55363.html","الوافر"],[409,"إلى الأشراف أعيان الأنام","https://www.aldiwan.net/poem33410.html","الوافر"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77452","الوافر"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72301","الطويل"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138063","الرجز"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45013","الطويل"],[5232,"المعلقة السينية الحديثة","https://www.poetsgate.com/ViewPoem.aspx?id=212771",""],[6291,"ألستم خير من ركب المطايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87688&r=&rc=19",""]],"verses":[["على أشواق أشواقي","علي ذرات ذراتي",0,"ت",2,0],["علي أشفقت إذن مما ترى","يا شيخ إن حيدراً تنمرا",1,"ر",2,0],["على أشقرٍ كوميضِ البروقِ","تحفزهُ غلواء المراحِ",2,"ح",1,0],["على أشرَفِ الميتاتِ وطَّنَ نفسهُ","فشدّ لِكي يلقى الرّدى لا لِيُنصَرا",3,"ر",2,0],["على أشرف الأوقات لما غبنتها","بأسواق غبن بين لاه ولاعب",4,"ب",1,0],["على أشلائكم نبني صروحاً","ومن هاماتكم نعلي القبابا",5,"ب",2,0],["على أشياء تنكرها عقول","لتحرير من العلما وعامي",6,"م",2,0],["عَلى أَشبيليةٍ أَجرى خُيُولا","فَأَوسَع مَن بِساحتها اِنتِهابا",7,"ب",2,0],["على أشقر شبه اللهيب توقداً","ولونا فقلنا البدر قد ركب البرقا",8,"ق",2,0],["عَلى اشْتِراطِهِمْ إمامَ الاََصْلِ","أو الَّذِيْ يَأْمُرُهُ بِالْفِعْلِ",9,"ل",1,0],["عَلى أَشرَفِ الرُسل الكِرام أَولي القَدر","صَلاةٌ وَتَسليمٌ يُصانان عَن حَصر",10,"ر",1,1],["على أشلائنا رقصوا وغنوا","فنامتْ فوق طرحتها العروسُ",11,"س",1,0],["على أشلائنا نبتتْ أمانٍ","وكانت قبل ثورتنا شظايا",12,"ا",3,0]]}