{"poems":[[85,"صداح يا ملك الكنار","https://www.aldiwan.net/poem7144.html","مجزوء الكامل"],[113,"هذا الولي المرتضى","https://www.aldiwan.net/poem40452.html","عموديه"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[362,"من كان فوق سراة المجد معتليا","https://www.aldiwan.net/poem60558.html","البسيط"],[400,"حتام أنت على الغرام معنفي","https://www.aldiwan.net/poem33645.html","الكامل"],[477,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[498,"ليل المحب إذا تطاول بالسهر","https://www.aldiwan.net/poem38019.html","الكامل"],[527,"قل راعي الإخا وراعي القرابه","https://www.aldiwan.net/poem37524.html","الخفيف"]],"verses":[["قل ربنا افتح رحمة","والخير منك فأرسل",0,"ل",1,0],["قل رحمة الله على","قطب الزمان حسن",1,"ن",1,0],["قُل رَبِّ صِل يَحيى بنَ يوسُف عبدكَ ال","مَقطوع مِنكَ أُضَيعَفُ العبدانِ",2,"ن",1,0],["قُلْ رام في دَرَجٍ للقَصْرِ مُنحَدِراً","وكانَ في درَجٍ للمجد مُرْتَقيا",3,"ي",2,0],["قل رب نجح محمداً بمحمد","وذويه من أهوال يوم الموقف",4,"ف",1,0],["قل رحمة اله على","خدوجة لا تقلع",5,"ع",1,0],["قُلْ رَبَّنا يا رَبَّنا يا ربَّنا","يا من إذا المَكْسورُ ناجاهُ جَبَرْ",6,"ر",1,0],["قلَّ رَاعِي الإخَا وَرَاعِي الْقَرَابَهْ","عِنْدَ أَنْ يَفْتَحَ الْخِطامُ جِرَابَه",7,"ه",1,1]]}