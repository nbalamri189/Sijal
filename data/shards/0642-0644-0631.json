{"poems":[[87,"صداح يا ملك الكنار","https://www.aldiwan.net/poem7144.html","مجزوء الكامل"],[119,"هذا الولي المرتضى","https://www.aldiwan.net/poem40452.html","عموديه"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[369,"من كان فوق سراة المجد معتليا","https://www.aldiwan.net/poem60558.html","البسيط"],[409,"حتام أنت على الغرام معنفي","https://www.aldiwan.net/poem33645.html","الكامل"],[484,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[505,"ليل المحب إذا تطاول بالسهر","https://www.aldiwan.net/poem38019.html","الكامل"],[534,"قل راعي الإخا وراعي القرابه","https://www.aldiwan.net/poem37524.html","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89234","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77064","الكامل"]],"verses":[["قل ربنا افتح رحمة","والخير منك فأرسل",0,"ل",1,0],["قل رحمة الله على","قطب الزمان حسن",1,"ن",1,0],["قُل رَبِّ صِل يَحيى بنَ يوسُف عبدكَ ال","مَقطوع مِنكَ أُضَيعَفُ العبدانِ",2,"ن",1,0],["قُلْ رام في دَرَجٍ للقَصْرِ مُنحَدِراً","وكانَ في درَجٍ للمجد مُرْتَقيا",3,"ي",2,0],["قل رب نجح محمداً بمحمد","وذويه من أهوال يوم الموقف",4,"ف",1,0],["قل رحمة اله على","خدوجة لا تقلع",5,"ع",1,0],["قُلْ رَبَّنا يا رَبَّنا يا ربَّنا","يا من إذا المَكْسورُ ناجاهُ جَبَرْ",6,"ر",1,0],["قلَّ رَاعِي الإخَا وَرَاعِي الْقَرَابَهْ","عِنْدَ أَنْ يَفْتَحَ الْخِطامُ جِرَابَه",7,"ه",1,1],["قل روضة فيها النسيم المنعش","أو حفرة فيها الأفاعي تنهش",8,"ش",1,0],["قل رحلت لخبنه وليس في","قطع وفي ازمّت بالاثنين يفي",9,"ي",1,0],["قل رب يقبل حجتي وبفضله","أرخ ويقبل لي زيارة شافعي",10,"ي",1,1],["قُل رَبّي اللّهُ المُهَيْ","مِنُ وَاِستَقِم فيما أحبْ",11,"ب",1,1]]}