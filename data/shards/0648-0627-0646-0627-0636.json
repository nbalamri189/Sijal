{"poems":[[65,"لله قومي فكم ندى خضل","https://www.aldiwan.net/poem45864.html","المنسرح"],[65,"يا طرة الشيح بسفح عاقل","https://www.aldiwan.net/poem46162.html","الرجز"],[57,"يدل على ما بالمحب من الهوى","https://www.aldiwan.net/poem26554.html","الطويل"],[79,"مولاي يا خير ملوك الورى","https://www.aldiwan.net/poem36766.html","السريع"],[66,"متى سهرت عيني لغيرك أو بكت","https://www.aldiwan.net/poem67574.html","الطويل"],[303,"أيصحو عاشق أم يستفيق","https://www.aldiwan.net/poem36284.html","عموديه"],[369,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[445,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53882","البسيط"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67025","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48688","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48568","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62646","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46511","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48917","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66259","الطويل"],[2007,"","https://poetry.dctabudhabi.ae/diwan/poem/157812","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134000","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141889","البسيط"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36056","البسيط"],[5220,"تحياتي لمن دمر حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=25568",""],[5431,"كذلك أعثرنا عليهم ليعلموا ...(الحسين)","https://www.poetsgate.com/ViewPoem.aspx?id=215785",""],[5573,"برد وسلام","https://www.poetsgate.com/ViewPoem.aspx?id=200218",""],[6093,"حبس ذات ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176243",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""]],"verses":[["وَإِنْ أَضاءَتْ فِي اللَّيْلِ غُرَّتُهُ","أَرَتْكَ صُبْحاً في حِنْدِسِ الظُّلَمِ",0,"م",1,0],["وإنْ أضاءَ الصُّبْحُ زَرَّ صَدْرُهُ","على الجَوى مُرْتَعِدَ الخَصائِلِ",1,"ل",1,0],["وَإِن أَضمَرَ الحُبَّ الَّذي في فُؤَادِهِ","فَإِنَّ الَّذي في العَينِ وَالوَجهِ لا يَخفى",2,"ف",2,0],["وَإِنْ أَضَعْتَ الْحَزْمَ لَمْ تَنْفَلِتْ","مِنْ ظُفُر الْحَيْنِ وَمِنْ نَابِهِ",3,"ب",2,0],["وَإِن أَضمَرَت يَوماً سَواكَ فَلا رَعَت","رِياضَ المُنى مِن وَجنَتَيكَ وَجِنَّةِ",4,"ه",1,0],["وإِنْ أَضحى وما عهدي مشوباً","فوُدّي لا مشوب ولا مذيق",5,"ق",1,0],["وإن أضحَتْ ومَنظرُها جَميلٌ","فقد أمسَتْ وخاطِبُها كَفيّ",6,"ي",1,0],["وإِنْ أَضْرَمُوا قَلْبِي فَجَمْرِي لَهُمْ نَدٍ","وإِنْ غَيَّضُوا شِرْبِي فَرَوْضِي لَهُمْ مُثْرِ",7,"ر",1,0],["وإنْ أضَفْتَ إليها ما ذَكَرْتُ فقد","شَفَعْتَ عزِّي بعزٍّ ليس ينقرضُ",8,"ض",1,0],["وإن أضفت إلى ذي الجذر رابعة","رأيت ثالثة زهراً معانيه",9,"ي",2,0],["وإن أضاعوا حقوقاً لا تكلفهم","غير التقاضي فما ذكرى الفتوحات",10,"ت",1,0],["وإن أضأتم مصابيح احتفالكم","ففي قلوبهمُ للغيظ مستعر",11,"ر",1,0],["وإن أضمرت في النفس ثم ذكرت ما","يدل عليها فاستعِنْ بالكنايةِ",12,"ه",1,0],["وَإِن أَضَعت مُهجَتي لَم أَحفَظ","عرضي وَكَيف بعدَها تيقظي",13,"ي",1,0],["وإن أضفته لما به رفع","معنى أجزه واسم فاعل منع",14,"ع",1,0],["وأنا ضعيفٌ لو سمحتُ لخاطري","لأَطلتُ فيك ولم أُطِل تائيتي",15,"ي",1,0],["وأنَّ اضطرابي كيف يصرعك القضا","وأن القضا انفاذ ما أنت آمر",16,"ر",1,0],["وإن أضع أدبا فالصفح ملتمس","إني بقلب من الإعظام ملآن",17,"ن",1,1],["وان اضرمتها في ظهورك اجمة","فكم اضرمتها في بطونك آجام",18,"م",1,0],["وَإن أضِيفَ عَدَدٌ مُرَكَّبُ","يَبقَ البِنَا وَعَجزٌ قَد يُعرَبُ",19,"ب",1,0],["وإن أضحت إلى صقع وجدت به","أيكاً ترنم فيه طائرٌ غرد",20,"د",1,0],["وَإِن أَضاءَت لَنا أَنوارُ غُرَّتِهِ","تَضاءَلَ النَيِّرانِ الشَمسُ وَالقَمَرُ",21,"ر",1,0],["واناضر صورتٍ فيها حبيبي","وابرمجها على فكري وذاتي",22,"ت",2,0],["وإنّ اضطراب الكون مازال ساريا","ضبابا فلا ندري متى العدل يلمعُ !!؟",23,"ع",1,0],["وأنا ضعيف الحال أحايل قدرتي ماتستديم","راضي ولاكن رحمتك تاسع ولي فيها مرام",24,"م",1,0],["وإنْ أضرَّ بنفسٍ بعضُ علّتها","على صحيحٍ مِنَ الأبدانِ كَمْ تقسو",25,"س",2,0],["وأنا ضميرُ الخيلِ في ساحِ الوَغى","أرأيتَ خيلاً في الوَغى تَتَجَنَّبُ",26,"ب",1,0]]}