{"poems":[[95,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[53,"لي زرع أتى عليه الجراد","https://www.aldiwan.net/poem11440.html","الخفيف"],[34,"أبثين إنك قد ملكت فأسجحي","https://www.aldiwan.net/poem27808.html","الكامل"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[46,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[22,"شهد الحطيأة يوم يلقى ربه","https://www.aldiwan.net/poem21694.html","الكامل"],[52,"أخداش أنت ابن الثلاثة","https://www.aldiwan.net/poem64722.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[92,"إلى الوفد الرياضي الإيراني","https://www.poetsgate.com/ViewPoem.aspx?id=179210",""],[287,"هل دهرنا الماضي يعود","https://www.aldiwan.net/poem32804.html","مجزوء الكامل"],[382,"لأعجب شيء ما تجل عزائمه","https://www.aldiwan.net/poem59266.html","الطويل"],[445,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[445,"لك الله بالنصر العزيز كفيل","https://www.aldiwan.net/poem34919.html","الطويل"],[447,"لا طارف عاد عندي لا ولا تلد","https://www.aldiwan.net/poem14301.html","البسيط"],[556,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86661","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48511","الكامل"],[998,"","https://poetry.dctabudhabi.ae/diwan/poem/205359",""],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124736","الرمل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96034","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93690","السريع"],[4025,"","https://poetry.dctabudhabi.ae/diwan/poem/122153","الكامل"],[4717,"عجبا لأمرك يا زمان","https://www.poetsgate.com/ViewPoem.aspx?id=199559",""],[4859,"يدللني!","https://www.poetsgate.com/ViewPoem.aspx?id=205801",""],[4898,"إنّا هُنا !","https://www.poetsgate.com/ViewPoem.aspx?id=35811",""],[5232,"جذوة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=212801",""],[5458,"ملكة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=72162",""],[5691,"الحليب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=205883",""],[5694,"مطار الرياض","https://www.poetsgate.com/ViewPoem.aspx?id=132104",""],[5736,"لملم جراحك","https://www.poetsgate.com/ViewPoem.aspx?id=203889",""],[402,"لله قوم بالثبات تدرعوا","https://www.poetsgate.com/ViewPoem.aspx?id=36222",""],[5830,"سَلامٌ لِعَيْنَيْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=201123",""],[5956,"لي زوجة من حور عِين","https://www.poetsgate.com/ViewPoem.aspx?id=182347",""],[5956,"قممُ الوعي","https://www.poetsgate.com/ViewPoem.aspx?id=185610",""],[5956,"مع العيد","https://www.poetsgate.com/ViewPoem.aspx?id=193701",""],[6102,"سَهِيرُ الأَحزان !!","https://www.poetsgate.com/ViewPoem.aspx?id=184416",""],[5355,"العلا أمنيتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87124&r=&rc=19",""],[6338,"لك الله بالنصر العزيز كفيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52538&r=&rc=0",""]],"verses":[["لَيزُولَنَّ كُلُّ مَنْ ظَنَّ بِالمَالِ","خُلُوداً وَأَنْتَ حَيٌّ مُقِيمُ",0,"م",1,0],["ليَ زرع أتى عليه الجرادُ","عادني مذ رُزئتُه العُوّادُ",1,"د",1,1],["لِيُزِلنَ عَنكِ هَوايَ ثُمَّ يَصِلنَني","وَإِذا هَويتُ فَما هَوايَ بِزائِلِ",2,"ل",1,0],["لِيُزيحوا عَنها العِدا فَأَزاحوا","وَأُزيحَت عَن جَفنِها الأَقذاءُ",3,"ا",2,0],["لِيَزِد بَنو الحَسَنِ الشِرافُ تَواضُعاً","هَيهاتَ تُكتَمُ في الظَلامِ مَشاعِلُ",4,"ل",1,0],["لِيَزُدكَ وَجداً بِالسَماحَةِ ما تَرى","مِن كيمِياءِ المَجدِ تَغنَ وَتَغنَمِ",5,"م",1,0],["لِيَزيدَهُم خَيراً وَلَو قَبِلوا","لَقَرَنتَ بَينَ الشَفعِ وَالوِترِ",6,"ر",1,0],["لِيَزيدٍ بنِ مُخَلَّدٍ","ثُمَّ المُهَلَّبِ ذي النَباثَه",7,"ث",2,0],["لِيَزُلْ زَوَالَ المَحْلِ لاَ يُؤْسَى لَهُ","وَلْيَزدَهِرْ بِمَكَانهِ مَا نَزْرَعُ",8,"ع",1,0],["لَيَزيدنا الألمُ الدفينُ تماسكاً","ليزيدُنا صَهرُ الخطوبِ تَصَلُّبا",9,"ب",2,0],["لي زَفرَةٌ كَالنارِ يَن","فُثُ حَرَّها قَلبي العَميدُ",10,"د",1,0],["ليزرعَ في ليل الفواحش زرعَه","ويسقيه من ماء الهلاك سمائمُه",11,"م",2,0],["لِيزيدَ عزَّاً بالجهادِ عزيزُها","ويزيدَ سَعداً باليقِينِ سَعيدُها",12,"د",3,0],["لِيَزْهُ بِهِ بحرٌ كَأَنَّ مُدُودَدُ","نوافلُ من معروفه وفضُولُ",13,"ل",1,0],["لي زفرة في هواها غير ساكنة","وفي خد ودي لمجرى أدمعي خدد",14,"د",1,0],["لِي زمانٌ ظامٍ إِلى ماءِ وجهي","يَمْتَرِيهِ بكلِّ ما إملاقِ",15,"ق",1,0],["لِيَزداد مني حُسن شُكري لِدَولة","تَدوم بِها في نعمة وَكرامة",16,"ه",1,0],["ليزيد أنفسهم بحكمك ضنةً","وتمسكاً بولائك المتمكن",17,"ن",1,0],["ليزهر النور في ذراه","كأنه لفظك البرود",18,"د",1,0],["ليزول الشك عن أمرهما","أثرا عن جابرٍ إذ ودعا",19,"ع",2,0],["ليزيد تلحو بعد كوفته","بلا ستر شآمه",20,"م",2,0],["ليزول منه أذى الكساد فينفق ال","كلب العقور على ذكور الضان",21,"ن",1,0],["لي زَوجة كانَ أَخو أُمها","يحسن في حالي وَفي حالِها",22,"ل",3,1],["ليزورَ يثربَ بالجمُوعِ وإنَّما","يحمي على الحسب الكريم الأروَعُ",23,"ع",1,0],["ليزيدَ من وهني وتلك صلابتي","والدهرُ مندهشٌ لقوةِ حاليا",24,"ي",2,0],["ليزهو بالضياءِ على نجومٍ","تود خسوفَه بعد احتلالِه",25,"ل",2,0],["لِيُزَوِّرُوا الوَجْهَ الأَصِيْلَ تَعَسُّفاً","بِتَغَيُّرِ السُّكَّانِ وَالعُنْوَانِ",26,"ن",1,0],["لي زورقٌ في البحرِ يقذفهُ","موجُ الحياة ِ فليتهُ يرسي",27,"س",2,0],["ليزا جمالك آية فوق الجمال","يا لوحة خطتها أيدي ذي الجلال",28,"ل",1,1],["ليزا أطلت والضياء بوجهها","شمس الضحى تختال تمعن في الدلال",28,"ل",1,0],["ليَزورَ حاكِمَهُ المُضيفَ على البِساطِ الأحْمَدي","قدْ حُطِّمَتْ عنْهُ القُيودُ فليْسَ بالمُسْتَعْبَدِ",29,"د",1,0],["ليزر عيونه ضرب في خافقي وإنتشر","في ناقلات الدما مثل إنتشار الوقود",30,"د",1,0],["ليزهر الشعرُ في بيداءِ قافيتي","مذْ أقبلَ الحبُّ مجتاحًا وأشياءُ",31,"ا",2,0],["ليزل زوال المحل لا يؤسى له","ولزدهر بمكانه ما نزرع",32,"ع",1,0],["لِيُزْهِرَ رَوْضِي وَ يُطْوَى خَرِيفِي","وَ يَعْلُو رَبِيعِي عَلَى كُلِّ دَاءْ",33,"ا",2,0],["‏لي زوجة من حور عِين رتَّبتْ","‏ ‏ بيتاً لها بلباقة وتفنن",34,"ن",1,0],["ليَ زوجٌ جَعَلَتْني خيرَ زوجٍ","وعشقتُ الكلَّ من فردٍ عَشِقْتُ",35,"ت",1,0],["ليزداد شأوهما في الجنانِ","فكم عاملانا ببِرٍّ وحدْبِ",36,"ب",1,0],["لِيَزحَفَ الوَقتُ فِي أَشواكِ حَيرَتِهِ","وَ يَستَطِيلَ عَلَى سُهدِ الكَرَى خَطَرُ",37,"ر",1,0],["لي زأرة الأسد في أوقات غضبتها","لي صعقة الرعد للأجواء والسحُبِ",38,"ب",1,0],["ليزه به بحر كأن مدوده","نوافل من معروفه وفصول",39,"ل",1,0]]}