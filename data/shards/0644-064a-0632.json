{"poems":[[93,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[51,"لي زرع أتى عليه الجراد","https://www.aldiwan.net/poem11440.html","الخفيف"],[32,"أبثين إنك قد ملكت فأسجحي","https://www.aldiwan.net/poem27808.html","الكامل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[44,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[22,"شهد الحطيأة يوم يلقى ربه","https://www.aldiwan.net/poem21694.html","الكامل"],[50,"أخداش أنت ابن الثلاثة","https://www.aldiwan.net/poem64722.html","مجزوء الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[90,"إلى الوفد الرياضي الإيراني","https://www.poetsgate.com/ViewPoem.aspx?id=179210",""],[282,"هل دهرنا الماضي يعود","https://www.aldiwan.net/poem32804.html","مجزوء الكامل"],[377,"لأعجب شيء ما تجل عزائمه","https://www.aldiwan.net/poem59266.html","الطويل"],[439,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[439,"لك الله بالنصر العزيز كفيل","https://www.aldiwan.net/poem34919.html","الطويل"],[441,"لا طارف عاد عندي لا ولا تلد","https://www.aldiwan.net/poem14301.html","البسيط"],[551,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"]],"verses":[["لَيزُولَنَّ كُلُّ مَنْ ظَنَّ بِالمَالِ","خُلُوداً وَأَنْتَ حَيٌّ مُقِيمُ",0,"م",1,0],["ليَ زرع أتى عليه الجرادُ","عادني مذ رُزئتُه العُوّادُ",1,"د",1,1],["لِيُزِلنَ عَنكِ هَوايَ ثُمَّ يَصِلنَني","وَإِذا هَويتُ فَما هَوايَ بِزائِلِ",2,"ل",1,0],["لِيُزيحوا عَنها العِدا فَأَزاحوا","وَأُزيحَت عَن جَفنِها الأَقذاءُ",3,"ا",2,0],["لِيَزِد بَنو الحَسَنِ الشِرافُ تَواضُعاً","هَيهاتَ تُكتَمُ في الظَلامِ مَشاعِلُ",4,"ل",1,0],["لِيَزُدكَ وَجداً بِالسَماحَةِ ما تَرى","مِن كيمِياءِ المَجدِ تَغنَ وَتَغنَمِ",5,"م",1,0],["لِيَزيدَهُم خَيراً وَلَو قَبِلوا","لَقَرَنتَ بَينَ الشَفعِ وَالوِترِ",6,"ر",1,0],["لِيَزيدٍ بنِ مُخَلَّدٍ","ثُمَّ المُهَلَّبِ ذي النَباثَه",7,"ث",2,0],["لِيَزُلْ زَوَالَ المَحْلِ لاَ يُؤْسَى لَهُ","وَلْيَزدَهِرْ بِمَكَانهِ مَا نَزْرَعُ",8,"ع",1,0],["لَيَزيدنا الألمُ الدفينُ تماسكاً","ليزيدُنا صَهرُ الخطوبِ تَصَلُّبا",9,"ب",2,0],["لي زَفرَةٌ كَالنارِ يَن","فُثُ حَرَّها قَلبي العَميدُ",10,"د",1,0],["ليزرعَ في ليل الفواحش زرعَه","ويسقيه من ماء الهلاك سمائمُه",11,"م",2,0],["لِيزيدَ عزَّاً بالجهادِ عزيزُها","ويزيدَ سَعداً باليقِينِ سَعيدُها",12,"د",3,0],["لِيَزْهُ بِهِ بحرٌ كَأَنَّ مُدُودَدُ","نوافلُ من معروفه وفضُولُ",13,"ل",1,0],["لي زفرة في هواها غير ساكنة","وفي خد ودي لمجرى أدمعي خدد",14,"د",1,0],["لِي زمانٌ ظامٍ إِلى ماءِ وجهي","يَمْتَرِيهِ بكلِّ ما إملاقِ",15,"ق",1,0]]}