{"poems":[[86,"علمونا الصبر يطفي ما استعر","https://www.aldiwan.net/poem10353.html","الرمل"],[26,"أصبح من أم عمرو بطن مر فأج","https://www.aldiwan.net/poem24101.html","البسيط"],[89,"خمسة طاروا من عيون الشباب","https://www.aldiwan.net/poem44625.html","الخفيف"],[85,"قم ناد أنقرة وقل يهنيك","https://www.aldiwan.net/poem63757.html","الكامل"],[62,"صنوان ضدان أب واحد","https://www.aldiwan.net/poem52181.html","السريع"],[61,"قصد الدهر فيك من بعد جور","https://www.aldiwan.net/poem51695.html","الخفيف"],[66,"لا زال ظلك للعفاة ظليلا","https://www.aldiwan.net/poem38745.html","الكامل"],[66,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[52,"لي في التصابي واللهو حاجات","https://www.aldiwan.net/poem27187.html","المنسرح"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[46,"إن سرور المدام لم يدم","https://www.aldiwan.net/poem23417.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39601","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54949","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[106,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[107,"قد ظن أنه عظيم","https://www.aldiwan.net/poem16560.html","مخلع البسيط"],[118,"من عذيري من الذي يبكيني","https://www.aldiwan.net/poem49349.html","الخفيف"],[127,"الطبول الطبول إِنا انتصرنا","https://www.aldiwan.net/poem67451.html","الخفيف"],[141,"من عف عن ظلم العباد تورعا","https://www.aldiwan.net/poem11773.html","الكامل"],[141,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[184,"قد ظهر الجور من الوالي","https://www.aldiwan.net/poem43468.html","السريع"],[202,"حسن تكامل في المحاسن فاغتدى","https://www.aldiwan.net/poem53272.html","الكامل"],[227,"قد ظلموا إذ نسبوا ثغره","https://www.aldiwan.net/poem51143.html","السريع"],[311,"ما بال نفس تطيل شكواها","https://www.aldiwan.net/poem59508.html","المنسرح"],[318,"لو ان والدك الذي عرضته","https://www.aldiwan.net/poem61677.html","الكامل"],[346,"يا ساعة البين قد نسيت بما","https://www.aldiwan.net/poem20731.html","المنسرح"],[374,"قلبي بمدحك يربأ","https://www.aldiwan.net/poem66974.html","مجزوء الكامل"],[390,"قد ظل يجرح صدري","https://www.aldiwan.net/poem53660.html","المجتث"],[456,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[477,"وذات محيا يخلق الله ما يشا","https://www.aldiwan.net/poem36913.html","الطويل"],[504,"قد ظهرت في عصرنا فرقة","https://www.aldiwan.net/poem2429.html","السريع"],[512,"خلط الغرام الشجو في أمشاجه","https://www.aldiwan.net/poem20829.html","الكامل"]],"verses":[["قَد ظَلَمتُم مَجدَهُم في نَقلِهِم","إِنَّما نَقلَتُهُم إِحدى الكُبَر",0,"ر",1,0],["قَد ظَلتُ فيها مَعي شُعثٌ كَأَنَّهُمُ","إِذا يُشَبُّ سَعيرُ الحَربِ أَرماحُ",1,"ح",1,0],["قد ظننت الذي ثوى يسكن القبر","قريبا مني فكان بعيدا",2,"د",2,0],["قَد ظَنَّني اللاحي نَطَقتُ عَنِ الهَوى","وَرَكِبتُ مَتنَ الجَهلِ إِذ أَطريكِ",3,"ك",1,0],["قد ظفر الطالب بالهارب","وتمّ منه بغية الطالبِ",4,"ب",1,0],["قد ظَمِئْنا فكان ريقُكَ وِرْداً","وثَمِلْنا فكان خدُّكَ وَرْدَا",5,"د",2,0],["قَد ظَلَّ يَفتَخِرُ القَريضُ بأَنَّني","صَيَّرتُهُ طَوراً إِلَيكَ رَسولا",6,"ل",2,0],["قَد ظَلَّلَتهُ سَحابَةٌ مِن خَيرِهِ","تَسري وَآيَتُهُ السَماحُ المُطلَقُ",7,"ق",1,0],["قَد ظَهَرَ الجِنُّ بِالنَهارِ لَنا","مِنهُم صُنوفٌ مُردٌ عَتِيّاتُ",8,"ت",1,0],["قد ظاهَرُوا لِبَدَ الدّرُوعِ عليهِمُ","وتأجّمُوا أجَماً منَ الخِرْصانِ",9,"ن",1,0],["قَد ظَهَرَ السِرُّ بَعدَ خُفيَتِهِ","مِن قائِلٍ بِالزَمانِ وَالقِدَمِ",10,"م",1,0],["قد ظنه أَولاً يَسيرا","ثم رآه صعباً عَسيرا",11,"ر",2,0],["قد ظلمتم دعوتي يا أصدقائي","وجهلتم ما حياةُ الشعراءِ",12,"ا",2,0],["قد ظنَّها والسحر قالبُها","شِيدَت من الياقوت والذهبِ",13,"ب",1,0],["قد ظَنَّ باللهِ مَن يَبغي به بَدَلاً","ومَن يُرجّي لِريَبِ الدَّهرِ إظهارا",14,"ر",2,0],["قَدْ ظَفِرَتْ بِالخَاطِبِ الأَبَرِّ","بِطَيِّبِ النَّفْسِ رَحِيبِ الصَّدرِ",15,"ر",1,0],["قد ظنناه في الشتاءٍ وِقاءً","فجمعنا الشتاءَ في طَيّاتهْ",16,"ت",2,0],["قد ظل الثغرَ الوجو","مُ ولف شاطئَه رداؤه",17,"ا",3,0],["قَد ظَنَ أَنَّهُ عَظيم","صارَ كَما تَرىعِظاما",18,"م",2,1],["قد ظفرنا من اللقاء بحظٍّ","فاقض حظي من الفراق الشطون",19,"ن",1,0],["قد ظَفِرنا دُقُّوا الطُبولَ وسيروا","مَوكِباً ناظراً اليه الزَمانُ",20,"ن",1,0],["قَد ظَلَّ قَصرُكَ مُشبِلاً مِنهُ فَعِش","حَتّى تَراهُ مِن بَنيهِ مُسبِعا",21,"ع",2,0],["قَد ظَلَّ في الآفاقِ ذِكرُكَ نافِذاً","فَمَواقِعُ الأَقدارِ حينَ تُوَقِّعُ",22,"ع",1,0],["قد ظهر الجور من الوالي","فطاب لبس الخلق البالي",23,"ل",2,1],["قد ظَنَّ بي ظنّاً ولا وحياته","ما كان بل قد ظنَّه في سكرِهِ",24,"ر",2,0],["قد ظلموا إذ نسبوا ثغرَهُ","في حسنه للدّرّ أو للبَرَدْ",25,"د",1,1],["قد ظلَمتني بسوء عثرتها","ولم تدع لي تقوى ولا جاها",26,"ا",3,0],["قَد ظَنَّ أَنَّكَ نُطفَةً في ظَهرِهِ","لِأَبي مُضاجَعَةَ النِسا وَتَطوشا",27,"ش",2,0],["قَدْ ظَعَنَ الرَّكْبُ بِالجَمالِ وَبِال","حُسْنِ وَعُدْنا بالشَّوْقِ والحَزَنِ",28,"ن",1,0],["قد ظَلَّ حَرسُكِ حارساً","بَينَ النَوائب يَكلَأُ",29,"ا",1,0],["قَد ظلَّ يَجرحُ صَدري","مَن لَيسَ يَعدوهُ فِكري",30,"ر",2,1],["قد ظَهرتْ رايةُ أيّامكم","وطبَّق الأرضَ بها الجائبُ",31,"ب",1,0],["قد ظعنت سيارة الكهربا بنا","فما كان أجراها انطلاقا وأدهشا",32,"ش",2,0],["قد ظهرت في عصرنا فرقة","ظهورها شؤم على العصر",33,"ر",1,1],["قد ظنّ سكْبَ الدّمْعِ يُخمِدُ نارَه","سَفَهاً به فتأجّجَتْ بأُجاجِهِ",34,"ج",2,0]]}