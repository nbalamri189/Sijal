{"poems":[[86,"علمونا الصبر يطفي ما استعر","https://www.aldiwan.net/poem10353.html","الرمل"],[26,"أصبح من أم عمرو بطن مر فأج","https://www.aldiwan.net/poem24101.html","البسيط"],[89,"خمسة طاروا من عيون الشباب","https://www.aldiwan.net/poem44625.html","الخفيف"],[85,"قم ناد أنقرة وقل يهنيك","https://www.aldiwan.net/poem63757.html","الكامل"],[62,"صنوان ضدان أب واحد","https://www.aldiwan.net/poem52181.html","السريع"],[61,"قصد الدهر فيك من بعد جور","https://www.aldiwan.net/poem51695.html","الخفيف"],[66,"لا زال ظلك للعفاة ظليلا","https://www.aldiwan.net/poem38745.html","الكامل"],[66,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[52,"لي في التصابي واللهو حاجات","https://www.aldiwan.net/poem27187.html","المنسرح"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[46,"إن سرور المدام لم يدم","https://www.aldiwan.net/poem23417.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39601","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54949","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[106,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""]],"verses":[["قَد ظَلَمتُم مَجدَهُم في نَقلِهِم","إِنَّما نَقلَتُهُم إِحدى الكُبَر",0,"ر",1,0],["قَد ظَلتُ فيها مَعي شُعثٌ كَأَنَّهُمُ","إِذا يُشَبُّ سَعيرُ الحَربِ أَرماحُ",1,"ح",1,0],["قد ظننت الذي ثوى يسكن القبر","قريبا مني فكان بعيدا",2,"د",2,0],["قَد ظَنَّني اللاحي نَطَقتُ عَنِ الهَوى","وَرَكِبتُ مَتنَ الجَهلِ إِذ أَطريكِ",3,"ك",1,0],["قد ظفر الطالب بالهارب","وتمّ منه بغية الطالبِ",4,"ب",1,0],["قد ظَمِئْنا فكان ريقُكَ وِرْداً","وثَمِلْنا فكان خدُّكَ وَرْدَا",5,"د",2,0],["قَد ظَلَّ يَفتَخِرُ القَريضُ بأَنَّني","صَيَّرتُهُ طَوراً إِلَيكَ رَسولا",6,"ل",2,0],["قَد ظَلَّلَتهُ سَحابَةٌ مِن خَيرِهِ","تَسري وَآيَتُهُ السَماحُ المُطلَقُ",7,"ق",1,0],["قَد ظَهَرَ الجِنُّ بِالنَهارِ لَنا","مِنهُم صُنوفٌ مُردٌ عَتِيّاتُ",8,"ت",1,0],["قد ظاهَرُوا لِبَدَ الدّرُوعِ عليهِمُ","وتأجّمُوا أجَماً منَ الخِرْصانِ",9,"ن",1,0],["قَد ظَهَرَ السِرُّ بَعدَ خُفيَتِهِ","مِن قائِلٍ بِالزَمانِ وَالقِدَمِ",10,"م",1,0],["قد ظنه أَولاً يَسيرا","ثم رآه صعباً عَسيرا",11,"ر",2,0],["قد ظلمتم دعوتي يا أصدقائي","وجهلتم ما حياةُ الشعراءِ",12,"ا",2,0],["قد ظنَّها والسحر قالبُها","شِيدَت من الياقوت والذهبِ",13,"ب",1,0],["قد ظَنَّ باللهِ مَن يَبغي به بَدَلاً","ومَن يُرجّي لِريَبِ الدَّهرِ إظهارا",14,"ر",2,0],["قَدْ ظَفِرَتْ بِالخَاطِبِ الأَبَرِّ","بِطَيِّبِ النَّفْسِ رَحِيبِ الصَّدرِ",15,"ر",1,0],["قد ظنناه في الشتاءٍ وِقاءً","فجمعنا الشتاءَ في طَيّاتهْ",16,"ت",2,0],["قد ظل الثغرَ الوجو","مُ ولف شاطئَه رداؤه",17,"ا",3,0]]}