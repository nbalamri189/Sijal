{"poems":[[88,"علمونا الصبر يطفي ما استعر","https://www.aldiwan.net/poem10353.html","الرمل"],[26,"أصبح من أم عمرو بطن مر فأج","https://www.aldiwan.net/poem24101.html","البسيط"],[91,"خمسة طاروا من عيون الشباب","https://www.aldiwan.net/poem44625.html","الخفيف"],[87,"قم ناد أنقرة وقل يهنيك","https://www.aldiwan.net/poem63757.html","الكامل"],[64,"صنوان ضدان أب واحد","https://www.aldiwan.net/poem52181.html","السريع"],[63,"قصد الدهر فيك من بعد جور","https://www.aldiwan.net/poem51695.html","الخفيف"],[68,"لا زال ظلك للعفاة ظليلا","https://www.aldiwan.net/poem38745.html","الكامل"],[68,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[54,"لي في التصابي واللهو حاجات","https://www.aldiwan.net/poem27187.html","المنسرح"],[77,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[48,"إن سرور المدام لم يدم","https://www.aldiwan.net/poem23417.html","المنسرح"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39601","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54949","الرجز"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[108,"فاجعة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=179419",""],[113,"قد ظن أنه عظيم","https://www.aldiwan.net/poem16560.html","مخلع البسيط"],[124,"من عذيري من الذي يبكيني","https://www.aldiwan.net/poem49349.html","الخفيف"],[133,"الطبول الطبول إِنا انتصرنا","https://www.aldiwan.net/poem67451.html","الخفيف"],[147,"من عف عن ظلم العباد تورعا","https://www.aldiwan.net/poem11773.html","الكامل"],[147,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[190,"قد ظهر الجور من الوالي","https://www.aldiwan.net/poem43468.html","السريع"],[208,"حسن تكامل في المحاسن فاغتدى","https://www.aldiwan.net/poem53272.html","الكامل"],[234,"قد ظلموا إذ نسبوا ثغره","https://www.aldiwan.net/poem51143.html","السريع"],[318,"ما بال نفس تطيل شكواها","https://www.aldiwan.net/poem59508.html","المنسرح"],[325,"لو ان والدك الذي عرضته","https://www.aldiwan.net/poem61677.html","الكامل"],[353,"يا ساعة البين قد نسيت بما","https://www.aldiwan.net/poem20731.html","المنسرح"],[382,"قلبي بمدحك يربأ","https://www.aldiwan.net/poem66974.html","مجزوء الكامل"],[398,"قد ظل يجرح صدري","https://www.aldiwan.net/poem53660.html","المجتث"],[463,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[484,"وذات محيا يخلق الله ما يشا","https://www.aldiwan.net/poem36913.html","الطويل"],[511,"قد ظهرت في عصرنا فرقة","https://www.aldiwan.net/poem2429.html","السريع"],[519,"خلط الغرام الشجو في أمشاجه","https://www.aldiwan.net/poem20829.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138312",""],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82794","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39097","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39031","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48813","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37826","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145810","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62456","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62478","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62603","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59418","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59114","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35358","البسيط"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136791",""],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124020","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123058","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123151","البسيط"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108425","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88666","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93637","الرجز"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87684","المتدارك"],[2853,"","https://poetry.dctabudhabi.ae/diwan/poem/102462","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199999",""],[3109,"","https://poetry.dctabudhabi.ae/diwan/poem/102834","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132794","الرجز"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100188","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62799","الخفيف"],[3675,"","https://poetry.dctabudhabi.ae/diwan/poem/37475","المتدارك"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131039",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133226","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133248","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29329","البسيط"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32426","المنسرح"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136949",""],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94784","الكامل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83570","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139470",""],[4778,"بسمت","https://www.poetsgate.com/ViewPoem.aspx?id=200415",""],[4858,"الى تلميذي محمود رشيد سلامة","https://www.poetsgate.com/ViewPoem.aspx?id=156003",""],[4980,"لا تشك ظلما لغير الله","https://www.poetsgate.com/ViewPoem.aspx?id=199033",""],[3591,"خطرت فقلتُ البان ليست عاكباً","https://www.poetsgate.com/ViewPoem.aspx?id=149407",""],[5121,"مارد الحب","https://www.poetsgate.com/ViewPoem.aspx?id=33705",""],[5186,"يا رعى الله ما رعت بكفيا","https://www.poetsgate.com/ViewPoem.aspx?id=156509",""],[5216,"جاحدة","https://www.poetsgate.com/ViewPoem.aspx?id=187019",""],[5376,"دُسْ عليها واهْرسِ الجسْمَ النحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=188451",""],[5376,"هل أنشدُ الدارَ قحطاناً وعدنانا.","https://www.poetsgate.com/ViewPoem.aspx?id=188463",""],[5431,"حشد الرعاع ...","https://www.poetsgate.com/ViewPoem.aspx?id=202871",""],[5459,"صبابة ..","https://www.poetsgate.com/ViewPoem.aspx?id=196539",""],[5725,"جحر ضب","https://www.poetsgate.com/ViewPoem.aspx?id=187234",""],[4623,"من يعذر المشتاق في شطحاته ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146691",""],[5765,"لوحةٌ للمشهد الأول","https://www.poetsgate.com/ViewPoem.aspx?id=212676",""],[5956,"شاعر يدافع عن صديقه","https://www.poetsgate.com/ViewPoem.aspx?id=192463",""],[6031,"يا سيد الشهداء جعفر وافدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=46418",""],[6093,"شيطان صعدة","https://www.poetsgate.com/ViewPoem.aspx?id=198391",""],[6093,"أدعياء الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=198902",""],[6102,"فوائد الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=182744",""],[5190,"فتجملي بالصبر يا بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85048&r=&rc=123",""]],"verses":[["قَد ظَلَمتُم مَجدَهُم في نَقلِهِم","إِنَّما نَقلَتُهُم إِحدى الكُبَر",0,"ر",1,0],["قَد ظَلتُ فيها مَعي شُعثٌ كَأَنَّهُمُ","إِذا يُشَبُّ سَعيرُ الحَربِ أَرماحُ",1,"ح",1,0],["قد ظننت الذي ثوى يسكن القبر","قريبا مني فكان بعيدا",2,"د",2,0],["قَد ظَنَّني اللاحي نَطَقتُ عَنِ الهَوى","وَرَكِبتُ مَتنَ الجَهلِ إِذ أَطريكِ",3,"ك",1,0],["قد ظفر الطالب بالهارب","وتمّ منه بغية الطالبِ",4,"ب",1,0],["قد ظَمِئْنا فكان ريقُكَ وِرْداً","وثَمِلْنا فكان خدُّكَ وَرْدَا",5,"د",2,0],["قَد ظَلَّ يَفتَخِرُ القَريضُ بأَنَّني","صَيَّرتُهُ طَوراً إِلَيكَ رَسولا",6,"ل",2,0],["قَد ظَلَّلَتهُ سَحابَةٌ مِن خَيرِهِ","تَسري وَآيَتُهُ السَماحُ المُطلَقُ",7,"ق",1,0],["قَد ظَهَرَ الجِنُّ بِالنَهارِ لَنا","مِنهُم صُنوفٌ مُردٌ عَتِيّاتُ",8,"ت",1,0],["قد ظاهَرُوا لِبَدَ الدّرُوعِ عليهِمُ","وتأجّمُوا أجَماً منَ الخِرْصانِ",9,"ن",1,0],["قَد ظَهَرَ السِرُّ بَعدَ خُفيَتِهِ","مِن قائِلٍ بِالزَمانِ وَالقِدَمِ",10,"م",1,0],["قد ظنه أَولاً يَسيرا","ثم رآه صعباً عَسيرا",11,"ر",2,0],["قد ظلمتم دعوتي يا أصدقائي","وجهلتم ما حياةُ الشعراءِ",12,"ا",2,0],["قد ظنَّها والسحر قالبُها","شِيدَت من الياقوت والذهبِ",13,"ب",1,0],["قد ظَنَّ باللهِ مَن يَبغي به بَدَلاً","ومَن يُرجّي لِريَبِ الدَّهرِ إظهارا",14,"ر",2,0],["قَدْ ظَفِرَتْ بِالخَاطِبِ الأَبَرِّ","بِطَيِّبِ النَّفْسِ رَحِيبِ الصَّدرِ",15,"ر",1,0],["قد ظنناه في الشتاءٍ وِقاءً","فجمعنا الشتاءَ في طَيّاتهْ",16,"ت",2,0],["قد ظل الثغرَ الوجو","مُ ولف شاطئَه رداؤه",17,"ا",3,0],["قَد ظَنَ أَنَّهُ عَظيم","صارَ كَما تَرىعِظاما",18,"م",2,1],["قد ظفرنا من اللقاء بحظٍّ","فاقض حظي من الفراق الشطون",19,"ن",1,0],["قد ظَفِرنا دُقُّوا الطُبولَ وسيروا","مَوكِباً ناظراً اليه الزَمانُ",20,"ن",1,0],["قَد ظَلَّ قَصرُكَ مُشبِلاً مِنهُ فَعِش","حَتّى تَراهُ مِن بَنيهِ مُسبِعا",21,"ع",2,0],["قَد ظَلَّ في الآفاقِ ذِكرُكَ نافِذاً","فَمَواقِعُ الأَقدارِ حينَ تُوَقِّعُ",22,"ع",1,0],["قد ظهر الجور من الوالي","فطاب لبس الخلق البالي",23,"ل",2,1],["قد ظَنَّ بي ظنّاً ولا وحياته","ما كان بل قد ظنَّه في سكرِهِ",24,"ر",2,0],["قد ظلموا إذ نسبوا ثغرَهُ","في حسنه للدّرّ أو للبَرَدْ",25,"د",1,1],["قد ظلَمتني بسوء عثرتها","ولم تدع لي تقوى ولا جاها",26,"ا",3,0],["قَد ظَنَّ أَنَّكَ نُطفَةً في ظَهرِهِ","لِأَبي مُضاجَعَةَ النِسا وَتَطوشا",27,"ش",2,0],["قَدْ ظَعَنَ الرَّكْبُ بِالجَمالِ وَبِال","حُسْنِ وَعُدْنا بالشَّوْقِ والحَزَنِ",28,"ن",1,0],["قد ظَلَّ حَرسُكِ حارساً","بَينَ النَوائب يَكلَأُ",29,"ا",1,0],["قَد ظلَّ يَجرحُ صَدري","مَن لَيسَ يَعدوهُ فِكري",30,"ر",2,1],["قد ظَهرتْ رايةُ أيّامكم","وطبَّق الأرضَ بها الجائبُ",31,"ب",1,0],["قد ظعنت سيارة الكهربا بنا","فما كان أجراها انطلاقا وأدهشا",32,"ش",2,0],["قد ظهرت في عصرنا فرقة","ظهورها شؤم على العصر",33,"ر",1,1],["قد ظنّ سكْبَ الدّمْعِ يُخمِدُ نارَه","سَفَهاً به فتأجّجَتْ بأُجاجِهِ",34,"ج",2,0],["قد ظلَّ مقولنا لآخر لحظة","هل ذا اللسان يصاب بالاخراس",35,"س",1,0],["قَد ظَلَ مُلتَحفاً بِالدجن محتجباً","حسن الطَبيعة طُول العام وَسنانا",36,"ن",2,0],["قَدْ ظَلَّ يُطْرِقُ لَمَّا شِمْتُهُ غَضَباً","تَعْنُوا لِعِزَّتِهِ الضَّراغِمُ الوُرْدُ",37,"د",1,0],["قد ظلَّ فيها النَّجمُ رَهْنَ مَضِلَّةٍ","وغدا يتيه الذيبُ في تيهائِها",38,"ا",3,0],["قد ظفرتم قبل الحساب بأجر","والكثير المزيد بعد الحسابِ",39,"ب",1,0],["قَد ظَنَّ أَنّ عُلوَّ الدار فيه له","مع العُلى شَرفٌ بالسعدِ مكتملُ",40,"ل",1,1],["قدْ ظنّ َمَنْ ظنَّ أنَّ الفأسَ في جَسَدِي","يَلقى بلحميَ ما يرجو ويلتقِفُ",41,"ف",1,0],["قد ظل طول نهار ذاك اليوم في","فرحٍ وبات وضمَّ كلا مرقدُ",42,"د",1,0],["قد ظنناك وهل تط","لع بالليل ذُكاءَ",43,"ا",2,0],["قد ظهر الحق وأبدى صحوَهْ","والوقت وقت غَدوةٍ وضحوهْ",44,"و",2,0],["قد ظل محاك بنور وجهك بدرا","ما الكامل للناقص التمام بتمثال",45,"ل",1,0],["قَدْ ظن أنَّ السمر قندني جلا","افعَالهَا البرني والصيحَانَا",46,"ن",2,0],["قَد ظَلَّلَتها غَماماتٌ نَواشِئُ مِن","دُخّانِ ندٍّ بِأَوجِ الجَوِّ مُنعَقِدِ",47,"د",1,0],["قد ظل بظلك محتمياً","وغدا يرجو منك الكرما",48,"م",2,0],["قد ظل يشحجُ فاهتاج الفؤاد له","للّه ما هاج شحّاج لمهتاج",49,"ج",1,0],["قد ظلّ في شمس الهواجر سائراً","شوقاً لبدر ظللته غمامه",50,"م",2,0],["قد ظل يسهر في ليل تبيت به","جفونكم بلذيذ النوم تكتحل",51,"ل",1,0],["قد ظننت الوصال صعباً ولكن","بجنوني كذبت تلك الظنونا",52,"ن",2,0],["قد ظهر الحق في نادينا","بل اِنزوى طائف الشيطان",53,"ن",1,0],["قَد ظفر الهر بِهِ","وَنال مِنهُ ما يَشا",54,"ش",2,0],["قَد ظَلَّ يُراوح بَينَهُما","لا يَدري أَيُّهما الأَروَح",55,"ح",1,0],["قد ظهرَ بالتفريق","لكنَّ الناسَ نيام",56,"م",1,0],["قد ظلمتم لا تضربوا بقراً","واضربوا من يشابه البقرا",57,"ر",2,0],["قد ظل يسركنا بخمر لحاظه","أو ما تراه يصفف الأقداحا",58,"ح",2,0],["قد ظلم الدهر الكرام وجفا","فحاول الوضيع شاؤ الشرفا",59,"ف",2,0],["قد ظل بعدك أهل الدين في فرق","والدين بعدك أضحى خائفاً فزعا",60,"ع",2,0],["قد ظلمناهُ في السّؤالِ لأنّا","ما سألْناهُ ردَّ شَرخِ الشّبابِ",61,"ب",1,0],["قد ظَلّ ليُمْنِ نَقييتِه","للمُلْكِ طَوالِعَ أَسعُده",62,"د",2,0],["قد ظل لبنان محسودا على دعة","وظل أبناؤه للخير ملاكا",63,"ك",2,0],["قد ظللته من الهجير سحابة","وبكفّه قد سبّح الحصباء",64,"ا",2,0],["قد ظللته في الهجير سحابة","والجزع حن لبعده وتأثرا",65,"ر",2,0],["قَد ظَلَّ نَجمُ الدُجى سَهمانُ يَقذِفُهُ","بَأَسهُمٍ تَتَهادى مِنهُ وَضاءِ",66,"ا",2,0],["قَد ظَفِرِ الحُزنُ بِالسُرورِ وَقَد","أُديِلَ 