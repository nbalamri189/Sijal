{"poems":[[9,"ميثاء دار عفا رسمها","https://www.aldiwan.net/poem21942.html","المتقارب"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[32,"أقول لأطلاح برى هطلانها","https://www.aldiwan.net/poem29552.html","الطويل"],[91,"البحر يغلى كان البحر بركان","https://www.aldiwan.net/poem44779.html","البسيط"],[58,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[47,"مني وصل ومنك هجر","https://www.aldiwan.net/poem63631.html","مجزوء البسيط"],[82,"أقول لبرق شمته في غمامه","https://www.aldiwan.net/poem31298.html","الطويل"],[107,"على ذكرها فليعرف الحق جاهله","https://www.aldiwan.net/poem41937.html","الطويل"],[107,"هو الحكم أمضته السيوف القواطع","https://www.aldiwan.net/poem43054.html","الطويل"],[107,"أتنقم ما يريبك من خلالي","https://www.aldiwan.net/poem43165.html","الوافر"],[107,"أكان يزيد بأسك إذ تصاب","https://www.aldiwan.net/poem44210.html","الوافر"],[48,"تمزن من مزن السحاب معاشر","https://www.aldiwan.net/poem23500.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62239","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39558","المتقارب"],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[101,"ورقة إلى القارىء","https://www.poetsgate.com/ViewPoem.aspx?id=17760",""],[101,"دونا ماريا","https://www.poetsgate.com/ViewPoem.aspx?id=16918",""],[101,"دونيا ماريا","https://www.poetsgate.com/ViewPoem.aspx?id=36620",""],[240,"بأبي من ذبت في الح","https://www.aldiwan.net/poem31630.html","مجزوء الرمل"],[264,"دعوت وجودي حيث ما ثم داعيا","https://www.aldiwan.net/poem35965.html","الطويل"],[292,"وصهباء يستوشي بذي اللب مثلها","https://www.aldiwan.net/poem1909.html","الطويل"],[333,"أراقت عليها معاني الفناء","https://www.aldiwan.net/poem54979.html","المتقارب"],[333,"ذكرتك والذكرى تضاعف من كربى","https://www.aldiwan.net/poem55064.html","الطويل"],[369,"هم منعوا مني الخيال المسلما","https://www.aldiwan.net/poem60668.html","الطويل"],[422,"إلى العز خوري يا نياقي وأنجدي","https://www.aldiwan.net/poem54159.html","الطويل"],[435,"للمرء في حادثات الدهر آمال","https://www.aldiwan.net/poem40075.html","البسيط"],[556,"رأيتك لا ترعى حقوقي ولم تصخ","https://www.aldiwan.net/poem47898.html","الطويل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101499","الرمل"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145629","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62528","الطويل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64428","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93090","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69315","الطويل"],[1996,"","https://poetry.dctabudhabi.ae/diwan/poem/82849","المتقارب"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75946","الطويل"],[2920,"","https://poetry.dctabudhabi.ae/diwan/poem/147229","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109805","الطويل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126297","الطويل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71342","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62817","المنسرح"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86309","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36774","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83179","الطويل"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130601","الطويل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147292","الوافر"],[4680,"مجازر الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=185033",""],[4908,"وللأحْزَانِ في مَهْدِ الخَيَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=211480",""],[4978,"رفح والأمة المشبورة","https://www.poetsgate.com/ViewPoem.aspx?id=177177",""],[5111,"سَوَسَنُ","https://www.poetsgate.com/ViewPoem.aspx?id=212148",""],[5111,"رِيشَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=212588",""],[5281,"احتراقُ الفَراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199734",""],[5281,"يمانيون بلا يمن","https://www.poetsgate.com/ViewPoem.aspx?id=203068",""],[5365,"عصف روح","https://www.poetsgate.com/ViewPoem.aspx?id=190405",""],[5616,"الجوع.. الجوع!","https://www.poetsgate.com/ViewPoem.aspx?id=205221",""],[5691,"بيادق","https://www.poetsgate.com/ViewPoem.aspx?id=206042",""],[5704,"على قدر الِْبِغَا يأتي العذابُ...","https://www.poetsgate.com/ViewPoem.aspx?id=204266",""],[5718,"قدس أقصانا","https://www.poetsgate.com/ViewPoem.aspx?id=213783",""],[5895,"عُيُونُكِ قالَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=202651",""],[6125,"تُمَزِّقُني الحَيَاةُ فَمَا أُبَالِي","https://www.poetsgate.com/ViewPoem.aspx?id=210568",""],[6152,"صبا نجد","https://www.poetsgate.com/ViewPoem.aspx?id=201750",""],[6318,"رسالة المسجد الأَقصى إلى المسلمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66163&r=&rc=13",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""],[6318,"صِدْقُ الوَفَاءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66153&r=&rc=3",""],[6320,"مَهَاوِي اليَأْس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84354&r=&rc=51",""]],"verses":[["تَمَزَّزتُها في بَني قابِيا","وَكُنتُ عَلى العِلمِ مُختارَها",0,"ر",3,0],["تَمَزَّزتُها غَيرَ مُستَدبِرٍ","عَنِ الشَربِ أَو مُنكِرٍ ما عُلِم",1,"م",1,0],["تَمَزَّقُ عنَ ديباجِ لَونٍ كَأَنَّهُ","شَريجٌ بِأنَيارِ الثِيابِ البَرانِكِ",2,"ك",1,0],["تمزق البحر من هوجاء عاصفة","كقلب ثكلى لها في الليل ارنان",3,"ن",1,0],["تَمَزَّقَ عنها الدَّهْرُ مِنْ طولِ لَبْثِها","ولَمْ يتمزَّقْ في بلاءِ جلاببِ",4,"ب",1,0],["تَمزُجُ لي ريقَةً بِخَمرٍ","كِلا الرُضابَينِ مِنكَ خَمرُ",5,"ر",1,0],["تُمزِّقُ عنه الكفُّ جلبابَ عَرْمَضٍ","فيبدو كنورِ الصّبْح تحتَ ظلامِهِ",6,"م",2,0],["تمزّقَ جيشُ الكُفرِ وانْحلَّ عِقْدُهُ","فخابت أَمانيهِ وأَعْيَتْ وسائلُهْ",7,"ل",2,0],["تُمزِّقُ مِن مُلكِ العِدَى ما تُصيبُهُ","ومهما تُمزِّقْ لا يُصبْ منه رَاقِعُ",8,"ع",1,0],["تُمَزِّقُهُ السِهامُ فَلا يَراها","وَتَأخُذُهُ السُيوفُ فَلا يُبالي",9,"ل",2,0],["تَمزّقتِ الصّحائفُ من كتابٍ","طواه في صحائفهِ الكتاب",10,"ب",1,0],["تَمَزَّنَ مِن مُزنِ السَحابِ مَعاشِرٌ","وَمِن مازِنٍ بَيضِ النَمالِ تَمَزُّني",11,"ن",2,1],["تَمَزَّزْتُهَا صِرْفاً وقَارَعْتُ دَنَّهَا","بِعُودِ أَرَاكٍ هَزَّهُ فَتَرَنَّمَا",12,"م",2,0],["تَمَزَّقُ في جانبيه الرياحُ","وتنفطرُ السُّحُبُ الواكفَه",13,"ف",2,0],["تمزقنا الغارات من أم قشعم","وما حدث تبقي عليه وقشعم",14,"م",1,0],["تمزقُ أحشاءَ الرباب نصاله","وقلبي بهاتيك النصال فطيرُ",15,"ر",1,0],["تَمَزُّقهُ قبلَ أن يُولَدَا ..","أنا لبلادي .. لنجْماتِها",16,"ا",1,0],["تمزقني...دونا ماريا","بعينين اوسع من بادية",17,"ي",2,1],["تُمزَّقني .. دونيا ماريَهْ","بعينينِ أوسعَ من باديَهْ",18,"ي",2,1],["تَمزُجُ القَهوَةَ لي مِن","ريقِكَ العَذبِ بِقَهوَه",19,"و",2,0],["تَمَزّقَ ثَوبُ الصَبرِ أَيَّ تَمَزُّقٍ","وَضاقَت رقاعي حَيثُ لَم أُلفِ رافِيا",20,"ي",2,0],["تَمَزَّزتُها صِرفاً وَقارَعتُ دَنَّها","بِعودِ أَراكٍ بَعدَهُ فَتَرَنَّما",21,"م",2,0],["تُمزّقني عاصفات الشجون","وتخنقني الغرفة الهامده",22,"ه",1,0],["تمزق كف البين آمال خافقي","فترثى لها عيني بلؤلئها الرطب",23,"ب",1,0],["تَمزَّقتِ الظّلماءُ عن نُورِ غادةٍ","أضاءَ من الآفاقِ ما كان مُظْلِما",24,"م",2,0],["تمزّق أعراض اللِّئام كأنَّها","تصول عليها بالحسام المهنَّد",25,"د",1,0],["تمزق الريح فوق الماء جارية","فكل ريحٍ أتتها فهي مكسالُ",26,"ل",1,0],["تُمزّقني عَمْداً كأنّكَ مخطئ","وَتَقذِفني جِدّاً كأنّكَ مازحُ",27,"ح",1,0],["تمزج الحبَّ بوهمٍ","زادني فيها هياما",28,"م",2,0],["تُمَزِّقْنَا مَطَامِعُ كلِّ وغدٍ","جَهُولٍ مستبدِّ الطَّبعِ فاجرْ",29,"ر",1,0],["تمزِّق من أنوارها كل ظلمة","تعطِّر من أعطارها كلَّ مرقد",30,"د",1,0],["تمزيقك الفراء والأعراضا","يورثك الجفاء والإعراضا",31,"ض",2,0],["تمزق يا جبار شملي وعزني ان","جبار انكساري في قيود بليتي",32,"ي",1,0],["تمزق سربال الظلام بعدوها","وتعلو بخفيها رؤوس الأهاضب",33,"ب",1,0],["تُمَزَّقُ بِالتَقبِيلِ وَاللَثمِ سَبطَةٌ","فَتَبلى وَما تَبلى مِنَ القِدَمِ السُبطِ",34,"ط",1,0],["تمزّق أَكبادنا فَجأة","بِأَنباء حُزن تشب اللَّهَب",35,"ب",1,0],["تمزقت تشتَّتت وافترقت","أمَا كفى ما قد جرى أما كفى",36,"ا",1,0],["تَمَزَّزتُها صِرفا فَعاثَت بِنهيتي","تُريني مُليكاً كِسرَوِيّاً أفاعِسُه",37,"س",2,0],["تمزق ثوب المجد عن كل لابس","وثوب سعيد الأريحي جديد",38,"د",1,0],["تمزقها الارياح حنقاً كأنها","تحاول في تمزيقها الاخذ بالثار",39,"ر",1,0],["تمزق ليل الجهل مذلاح بدره","وأضحت به طرق الضلال عوافيا",40,"ي",2,0],["تَمَزَّزْتُهَا صِرْفاً فَلَمَّا تَصَرَّفَتْ","تَحَكَّمَ سُكْرٌ بِالتَّرَائِبِ عَابِثُ",41,"ث",1,0],["تمزُجُ أنفاسَها إذا حَمِيَتْ","شَمالُ لُبنانَ وهو هَرّارُ",42,"ر",1,0],["تمزقها الاِرياحُ غيظاً كَأَنَّها","شُجاعٌ عَلى خَصم تَغلب بِالقَهرِ",43,"ر",1,0],["تَمَزَّق مِنهُ العُمر كُلّ مَمَزَّقٍ","وَيَنتاشه مِنها يَدٌ وَذِراعُ",44,"ع",1,0],["تمزق فوق الذرى إيلا","وأفواهها داميات الصفاح",45,"ح",1,0],["تمزق عن صدر هكطور درعاً","كستها الدماء خضيب الكسا",45,"س",2,0],["تمزق الذباب مني جلدي","وبعد فالكتاب في الكتاب",46,"ب",1,0],["تُمزِّقُ مِن أَعراضهم لا جُسومِهم","فَما القَتلُ أَن تُعنى بِحَشوِ الجَلابِبِ",47,"ب",1,0],["تمزق ضربا بالسيوف جسومها","وتسلبب عنها ببعد ذاك برودها",48,"د",3,0],["تمزقت الربى كمدا","فلا شوق ولا طرب",49,"ب",1,0],["تمزّقت الأرواح واختنق السنا","وهُدَّتْ عواليها وشيدتْ معاقلُ",50,"ل",1,0],["تمزِّقْنا حروبٌ، ويحَ قومي","أضاعوا العُمْرَ في تيهِ الجِدالِ",51,"ل",1,0],["تمزيقنا، إذ حرّموا توحيدنا","يا ربّ خذهم لا تذرْ ديّارا",52,"ر",2,0],["تُمْزِجُ البوح بِصَمْتٍ","يَتَبَاهَى بِالْمَعَانِيْ",53,"ن",2,0],["تُمْزِجُ الْحَرْفَ بِلَونٍ","يَتَبَاهَى بِالْمَعَانِيْ",54,"ن",2,0],["تُمزِّقُنا الدُّروبُ بِلا دَلِيلٍ","تفرِّقُنا ومَا فينا فَريقُ",55,"ق",1,0],["تَمزَّقْنا كَمَا الأَسلَافِ دَهرًا","ومِن مَنفىً إِلى مَنفىً نُقادُ",56,"د",1,0],["تُمزّقُني رياحُ البعدِ غدراً","وتغزوني غباراً في الصفوفِ",57,"ف",1,0],["تُمزِّقُهمْ نُيُوبُ الجُوعِ حتَّى","يَكادُ الشَّيخُ يَعثُرُ بِالعِيالِ",58,"ل",1,0],["تُمَزِّقُهُ الأحْزابُ وهْوَ رَهينَةٌ","بأيْدي العِدى والطّائِفِيَّةُ تسْحَقُهْ",59,"ق",2,0],["تمزقت القلوب بما أصبنا","ألا والله قد جلَّ المصابُ",60,"ب",1,0],["تَمَزَّقَ جَمْعُ دَوْلَتِهِمْ فَتَاهُوا","وحَلَّ بِأَرْضِ عِزَّتِهِمْ بَوَارُ",61,"ر",1,0],["تَمَزَّقَ مِنِّى فُؤادٌ وَصَبْرٌ","فَمَاذَا تَبَقَّى لِعَصْفِ اللَّهِيبْ؟",62,"ب",1,0],["تُمَزِّقُني الحَيَاةُ فَمَا أُبَالِي","لأنِّي فيكِ أبصَرتُ اكتِمَالِي",63,"ي",1,1],["تمزقني الذكرى لصبح حديثها","فمنطقها مسك وانفاسها ورد",64,"د",1,0],["تُمزَّقَ أَوصَالي وتُنْزَعُ مُهْجتي","ويُطلَبُ نَصْرٌ والنُّفوس خَواضِعُ",65,"ع",1,0],["تُمزِّقُ أرضاً أَو تُمزِّقُ أُمَّةً","وأَشلاؤُها في الخافقين تَنَاثَرُ",66,"ر",1,0],["تمزَّقوا فِرَقاً شتّى يَدور بِهمْ","مرُّ الصِّراع وهوْلُ الشرِّ والحَرَبُ",67,"ب",1,0],["تمزَّقت رِحمٌ مَوْصُولةٌ بِهِمِ","فَبَاتَ لحْمُهُمُ مَيْتاً ومأكولا",68,"ل",2,0],["تُمَزِّقُنَا رِيَاحُ الرَّسْفِ عَسْفاً","فَتَوَّهْنَا فَيَافِينَا كِبَارا",69,"ر",2,0]]}