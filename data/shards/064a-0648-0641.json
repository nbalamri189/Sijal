{"poems":[[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[41,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[69,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[50,"يا رب غيث آمن السروب","https://www.aldiwan.net/poem62457.html","الرجز"],[48,"عبر الشباب لأمه العبر","https://www.aldiwan.net/poem22589.html","الكامل"],[48,"إن التجارب طير تألف الخمرا","https://www.aldiwan.net/poem22614.html","البسيط"],[111,"الشكر لله شكرا ليس ينصرم","https://www.poetsgate.com/ViewPoem.aspx?id=534",""],[27,"سَلِ المنَازِلَ كَيْفَ صَرْمُ الوَاصِل","https://www.poetsgate.com/ViewPoem.aspx?id=17327",""],[173,"على م وفي م ظلماً تلحياني","https://www.aldiwan.net/poem1688.html",""],[240,"مدحك لا يستطيعه البشر","https://www.aldiwan.net/poem32019.html","المنسرح"],[266,"يعاودني لذكراك الحنين","https://www.aldiwan.net/poem38166.html","الوافر"],[302,"وحياتكم يا ساكني أم القرى","https://www.aldiwan.net/poem33252.html","الكامل"],[309,"ألا يا نفس ويحك كم تواني","https://www.aldiwan.net/poem16755.html","الوافر"],[384,"إنا إذا قلت طخارير القزع","https://www.aldiwan.net/poem4565.html","الرجز"],[396,"عظيم الفضل يا رب","https://www.aldiwan.net/poem54638.html","عموديه"],[412,"أبان لنا من دره يوم ودعا","https://www.aldiwan.net/poem50150.html","الطويل"],[412,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[422,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[806,"","https://poetry.dctabudhabi.ae/diwan/poem/110734","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50023","المتقارب"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143779","البسيط"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96025","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28495","الكامل"],[402,"عز المعالي مات يوسف سابا","https://www.poetsgate.com/ViewPoem.aspx?id=35358",""],[5975,"في ولاء آل بيت الرسول2","https://www.poetsgate.com/ViewPoem.aspx?id=53467",""],[6259,"أبان لنا من دره يوم ودّعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59387&r=&rc=35",""]],"verses":[["يُوفي وَيَرتَقِبُ النِجادَ كَأَنَّهُ","ذو إِربَةٍ كُلَّ المَرامِ يَرومُ",0,"م",1,0],["يوفي عَلى جِذمِ الجُذولِ كَأَنَّهُ","خَصمٌ أَبَرَّ عَلى الخُصومِ يَلَندَدُ",1,"د",1,0],["يُوفُون ما وعَدُوا كَأَنَّ وُعُودَهم","كانَتْ يَمِيناً بالوفاء غَمُوسا",2,"س",2,0],["يوفي عَلى قَفّازِهِ المَجوبِ","مِنهُ بِكَفِّ سَبطَةِ التَرحيبِ",3,"ب",1,0],["يوفي عَلى شُرُفاتِ مِنبَرِهِ","مَن هَمُّهُ التَحقيقُ وَالنَبرُ",4,"ر",1,0],["يوفي عَلى المِنبَرِ العالي خَطيبُهُمُ","وَإِنَّما يَعِظُ الآسادَ وَالنُمُرا",5,"ر",2,0],["يوفِّر الأجر في حسن البلاء لنا","وكل صالحة من كسبنا عدم",6,"م",1,0],["يُوفيِ اليَفَاعَ إِذَا تَقَاصَرَ ظِلُّهُ","فَيَظَلُّ فِيهِ كَالرَّبِيِّ المَاثِلِ",7,"ل",1,0],["يُوَفَّرُ ما عَنى هَيُّ بنُ بَيٍّ","عِناداً لِي وَيُؤكَلُ ما عَناني",8,"ن",2,0],["يوفونَ بِالعَهدِ وَالذِمامِ وَلِلدَه","رِ لَيالٍ بِأَهلِهِ غُدُرُ",9,"ر",1,0],["يوفي كل ذي امل مناه","كأن المكرمات عليه دين",10,"ن",1,0],["يوفي على الشمس المنيرة في الضحى","حُسناً إِذا حَسرَ اللثامَ وأَسفرا",11,"ر",2,0],["يوفقنا لما يرضيه عنا","ويثبتنا بديوان الرجال",12,"ل",1,0],["يوفي على الأصواء ايفاء الفزع","تحسبه مشايحا ولم يرع",13,"ع",1,0],["يوفقني يسددني","ويحفظني ويلطف بي",14,"ب",2,0],["يُوفّي هَواها حَقَّهُ فَيَصونَهُ","وَلَيسَ يَطيب الحُبُّ إِلّا مُمَنَّعا",15,"ع",2,0],["يُوَفِّر الأَمر أَلا إِنَّما","رَأسان في تاج خِلاف الصَلاح",16,"ح",1,0],["يُوفُونَ بالعَهد ويَرْعَوْنَهُ","في زمنٍ لم يُرْعَ فيه الذمار",17,"ر",1,0],["يوفي العهود بأسرها","وبفي بما فيه وعد",18,"د",1,0],["يُوَفي الرّعيةَ ما أمَّلوه","وَيكفي العشيرة ماقد أظلاّ",19,"ل",2,0],["يوفى على القمر الموفى إذا اتصلت","يسراه بالكأس أو يمناه بالكوز",20,"ز",1,0],["يوفى على الغمرات لا يلوى به","فقد الظهير وقلة الأنصار",21,"ر",1,0],["يوفِي عَلَى طَلَبِ العُفاةِ نَوالُهُ","كَالبَحرِ يَغرَقُ فيهِ قَعبُ المانِحِ",22,"ح",1,0],["يوفي جزاء المستحق ويصطفي","أدعى الأمور إلى الصلاح عقابا",23,"ب",2,0],["يوفقني لمعناهم يقينٌ","ويدنيني لبابهمُ سؤالي",24,"ل",2,0],["يوفّي هواها حقّهُ فتصونه","وليس يطيب الحبُّ إلا ممنّعا",25,"ع",2,0]]}