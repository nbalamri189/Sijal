{"poems":[[95,"يا لسان الدفاع عن خير دار","https://www.aldiwan.net/poem11461.html","الخفيف"],[71,"مربع من أنس سلمى أوحشا","https://www.aldiwan.net/poem28911.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85468","الخفيف"],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[228,"ما لسلمى التي استبدت وما لي","https://www.aldiwan.net/poem41624.html","الخفيف"],[237,"إن كنت تضمر لي في الحب إشفاقا","https://www.aldiwan.net/poem14746.html","البسيط"],[280,"عبر البحر يؤم الأبحرا","https://www.aldiwan.net/poem25568.html","الرمل"],[457,"يا لساق ناشر للأدب","https://www.aldiwan.net/poem13660.html","الرمل"],[463,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[473,"يا لساق مهفهف","https://www.aldiwan.net/poem59848.html","مجزوء الخفيف"],[563,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[563,"إن جسمي هنا وقلبي هناكا","https://www.aldiwan.net/poem34259.html","الخفيف"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103095","الرمل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101487","الرمل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203794","الخفيف"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47208","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93894","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205023","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74330","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110006","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91291","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85011","الرمل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97087","المتدارك"],[4259,"","https://poetry.dctabudhabi.ae/diwan/poem/145293","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83147","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83123","الرمل"],[5121,"سَكْرَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=213505",""],[5131,"انتهينا لا الهوى يحنو علينا","https://www.poetsgate.com/ViewPoem.aspx?id=54821",""],[5307,"الامطار","https://www.poetsgate.com/ViewPoem.aspx?id=10541",""],[5409,"ضمني الحلم ومن أه","https://www.poetsgate.com/ViewPoem.aspx?id=155515",""],[5409,"نحن في كل غدوةٍ ورواح","https://www.poetsgate.com/ViewPoem.aspx?id=155258",""],[5409,"أضحكتنا ورب ضحكٍ بكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155244",""],[5606,"ردعلى مرثية الشاعرمصلح بن بطحان السحيمي","https://www.poetsgate.com/ViewPoem.aspx?id=199035",""],[5638,"حسن البيان","https://www.poetsgate.com/ViewPoem.aspx?id=199067",""],[5794,"بغداد ..","https://www.poetsgate.com/ViewPoem.aspx?id=80290",""],[5956,"أنا سكرانٌ بحبي لحفيدي","https://www.poetsgate.com/ViewPoem.aspx?id=193151",""],[5309,"أعرضت نور الهدى عن حبها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573687",""]],"verses":[["يَا لِسَانَ الدِّفَاعِ عَنْ خَيْرِ دَارٍ","تُفْتَدَى بِالنُّفُوسِ وَالأَمْوَالِ",0,"ل",1,1],["يا لَسلمى أنتِ أولى مَنْ رعى","ودّيَ الأقدمَ مِنْ يومِ نشا",1,"ش",2,0],["يا لَسلمى بأبي أنت وبي","أنتِ عندي اليومَ أحلى مَنْ مشى",1,"ش",2,0],["يا لَسلمى سالميني وأسلمي","لا تطيعي واشياً فيما وشى",1,"ش",2,0],["يا لَسلمى دهشتي فيك حجا","لا يعابُ الصبُّ مهما دُهشا",1,"ش",2,0],["يا لسان الشكاة لا تَتَكَلَّم","جهرة إِن في الكلام هَلاكي",2,"ك",2,0],["يا لستّين في الكفاح طوال","حاليات وكلّ جلّى تطول",3,"ل",1,0],["يا لسلمى كَيفَ اِستَبَدَّت وَأَذرَت","بِحَياتي وَمَدمَعي الهَطّالِ",4,"ل",1,0],["يا لَسعَةً في فُؤادي لا أَرى أَبَداً","لَها سِوى القُربِ مِن لَمياءَ دِرياقا",5,"ق",2,0],["يَا لَسَاحاتٍ ثَواهُنّ العِدى","فَبَدا المَعْرُوفُ مِنْها مُنكِرا",6,"ر",2,0],["يا لساق ناشر للأدبِ","دار مع طيِّ بساط الكربِ",7,"ب",1,1],["يا لَسَقامِ آملٍ","بَرَاً به وصَحَّا",8,"ح",2,0],["يا لِساقٍ مُهَفهَفِ","قامَ يَسعى بِقَرقَفِ",9,"ف",1,1],["يا لسلمى تُعز قوماً وتحقرْ","وأسير الهوى يرى الحر في القرْ",10,"ر",1,0],["يا لسلمى ويا لأحباب سلمى","هل لكم وقفة هنا نتشاكى",11,"ك",2,0],["يا لسان السمع يا نور البصر","أنت غيب اللَه في عين الخير",12,"ر",1,1],["يا لسهلٍ بيد الحذق استدَار","اكسَبت اطرافُهُ الدَوحَ اخضرار",13,"ر",1,1],["يا لسخريّة الزمان، رعاةٌ","وذئابٌ في أرضنا حلفاءُ",14,"ا",2,0],["يا لساني أَدِمِ المدحَ لهم","دائمَ الدّهر ويا فكري تَهَيّ",15,"ي",1,0],["يا لساداتنا بني الصديق","لمعنى في قبضة التضييق",16,"ق",1,1],["يا لست من العواميد هاجت","في فؤادي ذكرى تؤج ضراما",17,"م",2,0],["يا لست من العواميد تلقي","لجميع الورى دروسا جساما",17,"م",2,0],["يا لست من العواميد كم قد","رفعت ثم نكست أعلاما",17,"م",2,0],["يا لست من العواميد ظلت","كشموع للدهر تجلو الظلاما",17,"م",2,0],["يا لست من العواميد تبكي","أخوات لها قضين انهداما",17,"م",2,0],["يا لِساني صرح بِمَدح النَبي","وَأَبي بَكر التقي النَقي",18,"ي",1,1],["يا لِسربٍ مُنِي بقُولَنجِ فِسقٍ","فأَتاهُ الدَمارُ كالتِرياقِ",19,"ق",1,0],["يا لسانَ الحَق يا سرَّ النُهى","حَيث ما قالَ وَفيما قَد فهم",20,"م",1,0],["يا لِساني كَيفَ تَخفى عِشقَتي","وَلِسانَ الدَمعِ عَنّي يَعرُب",21,"ب",1,0],["يا لسيفٍ برى منه نحرا","سود اليوم وجه السيوف",22,"ف",1,0],["يا لسوداء حامل الظهر والبط","ن بحمر الحلى وبيض البنات",23,"ت",1,0],["يا لسُلطانِهِ القَويِّ وَلا شَي","ءَ عَلَيهِ في الأَرضِ ذُو سُلطانِ",24,"ن",1,0],["يا لِسانَ الحَقِّ لا تَنطلِق","فازَ بِالخُطوَةِ أَهلُ الملقِ",25,"ق",1,1],["يَا لِسَوَّاحٍ بِزَهْرِي","سَحَّ أَنْدَاءً بِعِطْرِي",26,"ر",2,1],["يا لسرِّ القلب هل يُظهره","ليس مثل القلب إِشفاقًا علينا",27,"ن",2,0],["يالسيد اثره العيد عيدين","وثالث اعياد الدر لمطار",28,"ر",1,1],["يا لسوءِ الحظ حتى","بالرؤى لا نتهنا",29,"ن",2,0],["يا لسرب أودى به الصبح لما","طار عند انبلاجه وهوضاحي",30,"ح",2,0],["يا لسخرية المقادير فينا","لست أدري أما إليها انتهاء",31,"ا",2,0],["يالسحيمي والنعم وانتم ثقات","يالرجال اللي يشيلون الثقال",32,"ل",1,0],["يَا لِسَانَ الْعُرْبِ هَلَّا","جُدْتَ مَنًّا بِالْبَيَانِ",33,"ن",1,1],["يالسامعين اصواتنا .. يا الملبين","فاحت على ذل المهانه .. جثثنا",34,"ن",2,0],["يا لَسَعدِ الروح يأتيني حفيدٌ","بدل الثاوي بجناتِ الخلودِ",35,"د",1,0],["يا لَسُكرٍ لَيسَ يَشفيهِ دَوا","وَكَأَنَّ الشِّعرَ عَن قَلبي رَوى",36,"ا",1,0]]}