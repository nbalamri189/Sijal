ً أُطيلَ غَليلُهُ","زَماناً فَكانَت لَيلَةً بِلَيالي",2,"ي",1,0],["شَفَعتُ عَلى نَفسي بِنَفسي فَكَفكَفَت","مِنَ الغَيظِ وَاِستَعطَفتُ بَعضي عَلى بَعضي",3,"ي",1,0],["شَفافَةٌ مِنْ غِنىً في الأَمنِ مُجْزِيَةٌ","والحِرْصُ لَيْسَ على عِرْضٍ بِمَأْمُونِ",4,"ن",1,1],["شَفى النَفسَ مِنّي أَو دَنا مِن شِفائِه","تَرَدّيهُمُ مِن حالِقٍ مُتَصَوِّبِ",5,"ب",1,0],["شَفَّهُ ما شَفَّني فَبَكى","كُلُّنا يَبكي عَلى سَكَنِه",6,"ن",2,0],["شَفَّني الشَوقُ يا سَعيدُ بِن عُثما","نَ فَبِاللَهِ مَنِّني يا سَعيدُ",7,"د",1,0],["شَفَيتُ غَليلَ نَفسي مِن فِعالي","وَلَم أَغبُر بِلا عَقلٍ أَجولُ",8,"ل",1,0],["شَفّني حُبُّ جَوْهَريّ الثَّنايا","كَوْثَريُّ اللّما لَطيفُ المِزاجِ",9,"ج",1,0],["شِفَاءُ عِيَاضٍ لِلنُّفُوسِ شِفَاءُ","فَلَيْسَ بِفَضْلٍ قَدْ حَوَاهُ خَفَاءُ",10,"ف",3,1],["شِفاءً وَتنجيزاً مَتى يَلتَبِس بِهِ","يُعالِجُ بَرءً لا يُريبكَ أَو ياسِ",11,"س",1,0],["شَفى النَفسَ قَتلى لَم تُوَسَّد خُدودُها","وِساداً وَلَم تُعضَض عَلَيها الأَنامِلُ",12,"ل",1,0],["شَفَيتُ نَفسي لَوَ اَنّي","لَمّا رُميتُ رَمَيتُ",13,"ت",1,0],["شَفَعَ الدَمعُ فيكَ عِندَ البَرايا","لَيسَ ذاكَ الشَفيعُ بِالمَردودِ",14,"د",1,0],["شَفَّت لِأَعيُنِنا سِوى","ما شابَهُ مِنها الأَديمُ",15,"م",1,0],["شَفَّهُ الحُبُّ فَأَمسى","سَقَماً لا يَستَبينُ",16,"ن",1,0],["شَفيعي إِلَيهِ هَوى مُخلِصٍ","كَما أَخلَصَ السابِكُ العَسجَدا",17,"د",2,0],["شَفَاهُ اللهُ أَوْ يَقْضِي قَضَاءً","لإِحْيَاءِ الْقُشُورِ عَلَى اللُّبَابِ",18,"ب",1,0],["شَفَّافَةٍ بِسَنَاهَا عَنْ سَرَائِرِهِمْ","وَمَا أكَنَّتْهُ مِنْ وُدِّ وَشُكْرَانِ",19,"ن",1,0],["شَفيعي في القِيامَةِ عِندَ رَبّي","مُحَمَّدُ وَالوَصِيُّ مَعَ البَتولِ",20,"ل",1,1],["شَفيعَكَ فَاِشكُر في الحَوائِجِ إِنَّهُ","يَصونُكَ عَن مَكروهِها وَهوَ يَخلُقُ",21,"ق",1,0],["شِفاءُ ما لَيسَ لَهُ شِفاءُ","عَذراءُ تَختالُ بِها عَذراءُ",22,"ا",2,1],["شَفَيتُ وَلَم أَترُك لِنَفسِيَ غُصَّةً","وَرَوَّيتُ مِنهُم مُنصُلي وَقَناتي",23,"ت",2,0],["شَفناً إِلى مُستَرحَلٍ مَضبورِ","هَيقِ الهِبابِ سَحبَلِ الجُفورِ",24,"ر",1,0],["شفق يروع القلب شاحب لونه","كالسيف ضمّخ بالدما مسلولا",25,"ل",2,0],["شفق كأن الشمس قد رفعت به","ردناً بذوب ضيائها مبلولا",25,"ل",2,0],["شَفاهُم بِرِفقٍ خالَطَ الحِلمَ وَالتُقى","وَسيرَةِ مَهدِيٍّ إِلى الحَقِّ قاسِدِ",26,"د",1,0],["شَفى الوَقَعاتِ لَيسَ لِتَغلِبِيٍّ","مَحارٌ بَعدَهُنَّ وَلا خِصامُ",27,"م",1,0],["شَفى النَفسَ ما خُبِّرتُ مَرّانُ أُزهِفَت","وَما لَقِيَت يَومَ النُخَيلِ حَريمُ",28,"م",1,0],["شَفيعُ النِزارِيّاتِ غَيرُ مُخَيِّبٍ","وَداعي النِزارِيّاتِ غَيرُ مُخَذَّلِ",29,"ل",1,0],["شَفَت مِن عُقَيلٍ أَنفُساً شَفَّها السُرى","فَهَوَّمَ عَجلانٌ وَنَوَّمَ ساهِرُ",30,"ر",1,0],["شَفى النَفسَ يَومَ الخالِدِيَّةِ بَعدَما","حَلَلنَ بِإِحدى جانِبَيهِ البَواتِرُ",30,"ر",1,0],["شَفى دائَها يَومَ الشُراةِ بِوَقعَةٍ","جُدودُ بَني شَيبانَ فيها العَواثِرُ",30,"ر",1,0],["شَفَت فيها بَنو بَكرٍ حُقوداً","وَغادَرَتِ الضَبابَ بِها ضَبابا",31,"ب",2,0],["شفعت إليهم في عُمْي","رَة فانتهوْا عن جَلْدِها",32,"د",3,0],["شفيق على الأعراض يعلمُ أنها","إذا دُنِّسَتْ لم يُنقِها موصُ مائص",33,"ص",1,0],["شفيعكِ من قلبي مكين مشفَّعُ","وحظك من ودي حريز ممنَّعُ",34,"ع",1,1],["شفعَ يومٍ من الحجى ذي حجاج","تدع الشبهة الثبوت زَلوقا",35,"ق",2,0],["شفيتَ من الحرمان قوماً وإنه","لأدْوَى من الداء العَياء وأعْقَمُ",36,"م",1,0],["شفقاً من أذى الأميرِ المُرَجَّى","وحذاراً من مَجَّة الآذان",37,"ن",1,0],["شفعَ السماحُ إليه في سُؤَّاله","فَمرى جداهُ لهم عريضُ الجاه",38,"ه",1,0],["شَفَعْتُ إليكُمُ بالطَّوْلِ منكم","وكمْ من شافع فيكم وجيه",39,"ي",2,0],["شَفى النَفسَ قَتلى مِن سُلَيمٍ وَعامِرٍ","وَلَم تَشفِها قَتلى غَنِيٍّ وَلا جَسرِ",40,"ر",1,0],["شَفى النَفسَ قَتلى مِن سُلَيمٍ وَعامِرٍ","بِيَومٍ بَدَت فيهِ نُحوسُ الكَواكِبِ",41,"ب",1,0],["شَفَيتُ النَفسَ مِن أَبناءِ قَيسٍ","وَذَلِكَ عَنكَ مِن قَيسٍ جُبارُ",42,"ر",1,0],["شَفى النَفسَ قَتلى مِن كُلَيبٍ وَعامِرٍ","بِيَومٍ بَدَت فيهِ نُحوسُ الكَواكِبِ",43,"ب",1,1],["شَفى اللَهُ نَفسي لا شَفى اللَهُ نَفسَها","وَلا غابَ عَن أَجفانِها الدَمع وَالسُهدُ",44,"د",1,0],["شَفَينا بِعَبدِ اللَهِ بَعضَ غَليلِنا","وَعَوفٍ لَدى المَعدى أَوانَ اِستَهَلَّتِ",45,"ت",1,0],["شِفائِيَ أَن تَختَصَّني بِكَراهَةٍ","وَتَدرَأَ عَنّي الكاشِحينَ الأَعادِيا",46,"ي",2,0],["شفيعا فيه يوم يلو","ذ بالشفعاء مجرمه",47,"م",2,0],["شفيت غليلنا ودفعت عنا","وقمت بمنتهى فرض الكفاية",48,"ا",3,0],["شَفاكَ الَّذي يَشفي بِجودِكَ خَلقَهُ","لِأَنَّكَ بَحرٌ كُلُّ بَحرٍ لَهُ بَعضُ",49,"ض",1,0],["شَفَنَّ لِخَمسٍ إِلى مَن طَلَبنَ","قُبَيلَ الشُفونِ إِلى نازِلِ",50,"ل",1,0],["شَفى كُلَّ شاكٍ سَيفُهُ وَنَوالُهُ","مِنَ الداءِ حَتّى الثاكِلاتِ مِنَ الثُكلِ",51,"ل",1,0],["شَفيعُ المُسلِمينَ إِلَيكَ فيما","تُنيلُ مِنَ الصَنائِعِ وَالأَيادي",52,"ي",1,0],["شَفَعَت خُراسانُ العِراقِ بِزَورَةٍ","مِن زائِرٍ طَرِفِ اللِقاءِ جَديدِ",53,"د",1,0],["شَفَعتُ إِلَيهِ بِالإِمامِ وَإِنَّما","تَشَفَّعتُ بِالشَمسِ اِقتِضاءً إِلى البَدرِ",54,"ر",1,0],["شَفَقاً عَلى خَيرِ البَرِيَّةِ كُلِّها","نَفساً وَأَفضَلِ سَيِّدٍ وَإِمامِ",55,"م",1,0],["شَفيعي أَميرُ المُؤمِنينَ وَعُمدَتي","سُلَيمانُ أَحبوهُ القَريضَ المُنَمنَما",56,"م",2,0],["شَفَيتَ سُقمَهُمُ لَمّا لَقيتَهُمُ","بِسُقمِ مَلحَمَةٍ تَشفي مِنَ السَقَمِ",57,"م",1,0],["شَفى بُرَحَ الأَكبادِ أَنَّ اِبنَ طاهِرٍ","هَوَت أُمُّ عاصيهِ بِسَيفِ مُطيعِهِ",58,"ع",2,0],["شَفَوا ثائِرَ المَظلومِ وَاِستَمسَكَت بِهِم","أَكُفُّ رِجالٍ رُدَّ قَسراً شَغوبُها",59,"ب",3,0],["شَفَوا مِنهُما ما في النُفوسِ وَشَذَّبوا","بِوَقعِ العَوالي كُلَّ مَن يَتَكَتَّبُ",60,"ب",1,0],["شَفيتَ مِنَ الداءِ العِراقَ كَما شَفَت","يَدُ اللَهِ بِالفُرقانِ مِن مَرَضِ القَلبِ",61,"ب",1,0],["شَفَيتَ مِنَ الداءِ العِراقَ فَلَم تَدَع","بِهِ رَيبَةً بَعدَ اِصطِفاقِ الزَلازِلِ",62,"ل",1,0],["شفَا كَمَدي أُنْسُ الظِّباءِ وإنَّما","عَرَتْ فرقةٌ شتَّى الظِّباءِ نَفُورَها",63,"ر",3,0],["شفَعَ النَّدى لعُفاتِه بنَدىً كما","شفَعَ الرَّبيعُ سَحابةً بسَحابِ",64,"ب",1,0],["شَفاه قُرباً وقد أشفَى على العطَبِ","خَيالُ نائيةٍ حيَّاهُ من كَثَبِ",65,"ب",1,1],["شُفاةٌ كُفاةٌ لا المَواثيقُ عِندَهُم","تُضاعُ وَلا الأَسرارُ مِن بَينِهِم تَفشو",66,"ش",2,0],["شِفارُ مَواضيهِ إِذا هِيَ جُرِّدَت","فَأَيسَرُ مَقتولٍ بِها اللَومُ وَالفُحشُ",66,"ش",1,0],["شَفيعاً فَلَم تُشفِعي","صَرَمتِ حِبالَ الوَفا",67,"ف",2,0],["شَفَيتُ غُلَّةَ قَلبي وَالغَليلَ بِها","فَاليَومَ لا غُلَّتي تَشفى وَلا الغَلَلُ"