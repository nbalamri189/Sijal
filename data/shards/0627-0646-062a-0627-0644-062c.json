{"poems":[[55,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[90,"يا إمام الهدى ورب المعالي","https://www.aldiwan.net/poem44433.html","الخفيف"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[45,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[30,"يرضى الجواد إذا كفاه وازنتا","https://www.aldiwan.net/poem5207.html","البسيط"],[68,"يا ليت شعري وقد أودى بك القدر","https://www.aldiwan.net/poem40138.html","البسيط"],[107,"برق بأنباء الأحبة سار","https://www.aldiwan.net/poem42118.html","الكامل"],[21,"علم ابن جدعان بن عمرو","https://www.aldiwan.net/poem36215.html","مجزوء الكامل"],[48,"أنسل أو اعقم فالتوحد راحة","https://www.aldiwan.net/poem23146.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[45,"أَجابَ دَمعي وَما الداعي سِوى طَلَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=137",""],[128,"أنازح أنت لم تمنن علي بما","https://www.aldiwan.net/poem23808.html","البسيط"],[164,"ما زلن في طاعاتك الأقدار","https://www.aldiwan.net/poem59066.html","الكامل"],[215,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[280,"دنياك للأخرى سبيل سابل","https://www.aldiwan.net/poem25534.html","الكامل"],[325,"شكرا بالنصر عين العز ترقبكم","https://www.aldiwan.net/poem67182.html","البسيط"],[447,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[545,"ياذا المنوه تدعوني لتسمعني","https://www.aldiwan.net/poem56644.html","البسيط"],[567,"لمن الخيام ومن هنالك نازل","https://www.aldiwan.net/poem52901.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138272",""],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101547","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48754","الكامل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104542","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122310","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120091","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112856","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50016","الكامل"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26676","البسيط"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141341","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69384","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47154","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105004","البسيط"],[2371,"","https://poetry.dctabudhabi.ae/diwan/poem/142608","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106829","الكامل"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100117","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93538","البسيط"],[2562,"","https://poetry.dctabudhabi.ae/diwan/poem/141693","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137272",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93852","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132600","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74063","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74043","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138640",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135218","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70148","البسيط"],[4006,"","https://poetry.dctabudhabi.ae/diwan/poem/146817","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94792","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94330","الكامل"],[4679,"الصحف تنطق والمنابر تشهدُ","https://www.poetsgate.com/ViewPoem.aspx?id=142755",""],[4699,"عذبة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=154301",""],[4767,"رب الفضائل","https://www.poetsgate.com/ViewPoem.aspx?id=178735",""],[4929,"إبقي وثاقي مُحكماً","https://www.poetsgate.com/ViewPoem.aspx?id=200429",""],[5057,"الداعشيّ .","https://www.poetsgate.com/ViewPoem.aspx?id=184237",""],[5129,"خضراء","https://www.poetsgate.com/ViewPoem.aspx?id=125752",""],[5183,"مصر","https://www.poetsgate.com/ViewPoem.aspx?id=180185",""],[5183,"إلى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=180188",""],[5211,"بيْضاءُ يا أخْتَ الجِنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=176157",""],[5232,"حبيبتي وملاكي","https://www.poetsgate.com/ViewPoem.aspx?id=212508",""],[5277,"يا جيرةَ الطفّ","https://www.poetsgate.com/ViewPoem.aspx?id=185982",""],[5277,"ترَفُ الخوالج","https://www.poetsgate.com/ViewPoem.aspx?id=191056",""],[5277,"أعِرْ شفاهي","https://www.poetsgate.com/ViewPoem.aspx?id=197751",""],[5281,"ربَّةُ الشِّعر","https://www.poetsgate.com/ViewPoem.aspx?id=199301",""],[5307,"حبك ملك قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=10542",""],[5376,"للقدس عين من الاشواق لم تنم","https://www.poetsgate.com/ViewPoem.aspx?id=188549",""],[5431,"فيك الحسُ يُختزلُ...","https://www.poetsgate.com/ViewPoem.aspx?id=198568",""],[5491,"أنت الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=197208",""],[5574,"غادة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205988",""],[5628,"ماذا جرى","https://www.poetsgate.com/ViewPoem.aspx?id=178673",""],[5660,"لا تَبتَئِس يا عَمرو لا تَعبَأ لَها","https://www.poetsgate.com/ViewPoem.aspx?id=33111",""],[5720,"جنة الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=198792",""],[5910,"ما زال طيفُكِ بالسَّحَرْ","https://www.poetsgate.com/ViewPoem.aspx?id=206869",""],[5943,"كفكف دموعكَ","https://www.poetsgate.com/ViewPoem.aspx?id=11276",""],[5956,"أدي الرسالة يا مولات واجتهدي","https://www.poetsgate.com/ViewPoem.aspx?id=182382",""],[5956,"مارستُ حُبك بالقصائد","https://www.poetsgate.com/ViewPoem.aspx?id=182610",""],[5956,"شكراً لتلفاز الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=193473",""],[5989,"خلي فؤادي ...","https://www.poetsgate.com/ViewPoem.aspx?id=181564",""],[5991,"بكماله ما في الوجو مظاهر","https://www.poetsgate.com/ViewPoem.aspx?id=116384",""],[5991,"يا قانعاً بصفاته عن ذاته","https://www.poetsgate.com/ViewPoem.aspx?id=116387",""],[6070,"قولي بربكِ ما الذي أبكاكِ","https://www.poetsgate.com/ViewPoem.aspx?id=189501",""],[6202,"يا مصر لا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86769&r=&rc=70",""],[6202,"يا بنت عشرين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86765&r=&rc=66",""],[5190,"أبهَى قصائدِ شِعرِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78287&r=&rc=1",""]],"verses":[["أَنتَ الجَوادُ إِذا غَلا أَمَلٌ","وَالمُستَجارُ إِذا طَغى وَجَلُ",0,"ل",1,0],["أنت الجيش مذ زحفت إليهم","علناً جئتهم وجاءوك خترا",1,"ر",2,0],["أنتَ ألجأتني إلى ما تراهُ","بالذي فيك من فنون المعاني",2,"ن",2,0],["أَنتَ الجَوادُ بِلا مَنٍّ وَلا كَدَرٍ","وَلا مِطالٍ وَلا وَعدٍ وَلا مَذَلِ",3,"ل",1,0],["أَنتَ الجَوادُ الَّذي تَرجى نَوافُلُهُ","وَأَبعَدَ الناسِ كُلِّ الناسِ مِن عارِ",4,"ر",1,0],["أَنتَ الجَوادُ الَّذي لَولا مَكارِمُهُ","لَأَصبَحَ الجودُ عَيناً ما بِها بَصَرُ",5,"ر",1,0],["أنت الجديرُ بأن تُفارقَ أُمّةً","وقع الرعاةُ بها على الجزَّارِ",6,"ر",1,0],["أَنتَ الجَوادُ إبنُ الجَوادِ","بِكُم يُنافِرُ مَن يُنافِر",7,"ر",1,0],["أَنتَ الجَبانُ إِذا المَنِيَّةُ أَعرَضَت","وَعَلى ثَنِيَّتِكَ الشُجاعُ الباسِلُ",8,"ل",1,0],["أَنتَ الجَمالُ بِها وَأَنتَ المُجتَلى","وَالكَفُّ وَالمِرآةُ وَالحَسناءُ",9,"ا",2,0],["أَنتَ الجَوادُ بِلا مَنٍّ وَلا كَذِبٍ","وَلا مِطالٍ وَلا وَعدٍ وَلا مَذَلِ",10,"ل",1,0],["أنت الجميل على بعد وإن قربت","منك الخطا كنت للإنسان فتانا",11,"ن",2,0],["أنت الجواد فلا تقاس بماجد","خطو الخيول مع السيول قصار",12,"ر",1,0],["أنت الجمال وروح الحسن خالدة","ما في الحدائق زهرٌ ذاهبٌ فان",13,"ن",1,0],["أنْتَ الجَليلُ مِن الجَزاء نَصِيبُه","ونَوافِلُ الذِّكْرِ الحَكيمِ جَلائِلُ",14,"ل",1,0],["أَنتَ الجَديرُ إِذا العَليا لَكَ أَتبَعَت","وَبَيتُ مَجدِكَ لا تَخفى مَبانيهِ",15,"ي",2,0],["أنت الجليل بل الغني النور يا","وهاب أنت اللطيف الطف بنا",16,"ن",2,0],["أَنتَ الجوادُ الَّذي نَدعو فيلحُقنا","إِذا تَراخى المَدى بالقرَّحِ الحُصُنِ",17,"ن",1,0],["أنتِ الجميلةُ فوقَ كلِّ جميلةٍ","فالحَقُّ أنتِ وكُلُّهنَّ الباطلُ",18,"ل",1,0],["أنت الجدير بما بلغت من العلا","فمكان علمك كالكواكب ظاهر",19,"ر",1,0],["أنتَ الجوادُ بلا مَنٍّ ولا سأمٍ","تعطي النضارَ عطاءَ الناس للجددِ",20,"د",1,0],["أنت الجميل الفخم للوادي فما","لك غير ميعاد الجلاء مثيل",21,"ل",1,0],["أَنتَ الجوادُ فما يُقلِّلُ جودَهُ","ذنبٌ ولا الحسناتُ فيه تكثرُ",22,"ر",1,0],["أنت الجواد فلا تبا","رى والوحيد فلا تثنى",23,"ن",2,0],["أنت الجواد الأربحي","ي الماجد الملك الحلاحل",24,"ل",1,0],["أنت الجميل الخلق والاخلاق","محمود السجايا أنت خير مسدد",25,"د",1,0],["أنت الجواد وفي يمينك بسطةٌ","ونَدىً إذا انقبضت يمينُ الباخلِ",26,"ل",1,0],["أنت الجميع وأنت الفرد قد علموا","سريرة لم تكن في واحد العدد",27,"د",1,0],["أنت الجديرة بالحياة وهذا","العبد بين يديك قد سجدا",28,"د",2,0],["أَنتَ الجَليلُ فَنَل جَليلاً إِنَّما","يَحوي الجَليلُ مِنَ الأُمورِ جَليلا",29,"ل",2,0],["أنت الجديرُ بكلّ ما أُوليتَه","وخطرتَ يا ذا المجد في سِرْبَالِه",30,"ل",2,0],["أنت الجواد الذي لم تبق سابقة","في حلبة المجد إلا كنت سابقها",31,"ق",3,0],["انت الجناب المصون","وانا أحبك أنا",32,"ن",2,0],["أنتِ الجميلةُ تفخرين عليهم","تيهاً كما فَخَرَ الشقيقُ العصفرا",33,"ر",2,0],["أنت الجليل الذي أرجوه معتمدي","في النشأتين لدفع الحادث الجلل",34,"ل",1,0],["أَنتَ الجَواد سباقا وَالجَواد نَدى","وَعَن مَجاريك قَد جزت المَدى وَكَبا",35,"ب",2,0],["أنت الجمال لجيش الله فارمِ به","جيش العدو لدى استحكامه تصبِ",36,"ب",1,0],["انت الجميلة في خلق وفي خلق","وعنك كل الصفات الغر نرويها",37,"ي",3,0],["أنت الجدير برشف ريقتها وإن","ختمت بأذكى المسك فافضض ختمه",38,"م",2,0],["أنت الجواد ودمعي سائل فأنل","عيني مناما فأقصى سؤلها نظر",39,"ر",1,0],["أَنتَ الجِبالُ ثَوابِتاً","إن قيلَ أَهلُ الرأي زلّوا",40,"ل",3,0],["أَنتَ الجَلاءُ لِناظِري","يَ فَما النُضارُ وَما الذَهب",41,"ب",1,0],["أنت الجواد فهل تخيب آملا","حاشا الجواد بأن يرد السائلا",42,"ل",2,1],["أنتَ الجنان لو يرى رِجالُهَا","منك المحيَّا لنُسِي جَمَالها",43,"ه",2,1],["أَنتَ الجديرُ بِهِ ما لاقَ صاح بِهِ","إِلّا عَلاكم وَمن مِن فَضلكم حَشدا",44,"د",2,0],["أنت الجميل وكل ما","تأتي به حسن جميل",45,"ل",1,0],["أنت الجواد البرُّ ذو اللطف الخفي","وبحار جودك سرمداً لا تُحصرُ",46,"ر",1,0],["أنت الجليُّ الطرف إن نزل القضا","وَبعكس أفعال الرجال خَبيرُ",47,"ر",1,0],["أنت الجدير بما بلغت من العلى","وبقبة الإفضال أنت الفرقد",48,"د",1,0],["أنتِ الجمال وجوده وعبيره","الله صاغك حلوتي وحباكِ",49,"ك",1,0],["أنت الجميل ولا سواك جميلُ","كل القلوب إلى هواك تميلُ",50,"ل",1,1],["أنت الجمال وأنت نصُّ كتابه","للقارئين بكلُّ ما يحويه",51,"ي",2,0],["أنتَ الجهادُ وأنتَ الحقّ يا رجُلاً","بقتلِهِ الناسَ دينُ اللهِ ينتصِرُ .",52,"ر",1,0],["أنتِ الجَلِيَّةُ ما قَرأتُ شَبيهَها","نَظَرِيَّةً سَادَتْ بِلا حَرْفٍ يُقالْ",53,"ل",1,0],["أنت الجمال بل الكمال وفي","معنى جمالك للعلى سر",54,"ر",1,0],["أنت الجنان وريفها","وأنا الفتى الفاني قديما",55,"م",2,0],["أنتِ الجَليلَةُ والخَلِيلةُ والجَوَى","والمُجْرمُون كَشَاردِ القطْعانِ",56,"ن",1,0],["أنتِ الجمالُ وفيكِ آمالُ الصِّبا","أنت الحياةُ عشقتها برؤاكِ",57,"ك",1,0],["أنت الجمال وكلُّ الحسن أعرفه","وفيك للطيب معنىً وسطه الترفُ",58,"ف",1,0],["أنتِ الجِوارُ وأنتِ أهلي كلّهم","تشْتاقُكَ الاعذاقُ والجمّارُ",59,"ر",1,0],["أنتِ الجمالُ وكلُّ الحسنُ في نظري","وفيكِ للطيبِ معنىً ملؤُهُ الترفُ",60,"ف",1,0],["أنتِ الجَمالُ تَحَّركتْ نَسَمَاتُهُ","وضياءُ رُوحِكِ للمُحِبِّ سَنَاءُ",61,"ا",2,0],["انت الجميل المميز لي به تعنيت","اللي أسرني بطيب اخلاق عاداته",62,"ت",2,0],["أنت الجمال وبيت الله من قدم","علياؤها قد سمت بالعز والعلم",63,"م",1,0],["أنت الجوارحُ في موجٍ وفي لُججٍ","في برزخ القلب أنت الطفلُ والرجلُ",64,"ل",1,0],["أنت الجنائن والأجفان مطبقةٌ","تعانق الشوق حلما ليس ينسدلُ",64,"ل",1,0],["أنتَ الجمالُ وأنتَ نبضُ وجودِنا","بل أنتَ نحنُ...وأنتَ فينا تُبْحِرُ",65,"ر",1,0],["٨- أنتِ الجِناسُ أمانةٌ منْ شيْخِنا","من صاغَ دِيباجَ الشّعورِ المُزْهِرِ",66,"ر",1,0],["أنت الجحيمُ بكلِّ قسوته ِ","وظننتُ أنّك جنّة الخُلد ِ",67,"د",1,0],["أَنتَ الجَوادُ فَما هَتَكتَ سِتارَهُم","حَتّى وَ إِن هَتَكوا سِتاراً يُؤمَلُ",68,"ل",1,0],["أنتِ الجمالُ تناثرتْ ألوانُهُ","فيْ لوحةٍ كستِ الحياةَ تناغُمَا",69,"م",2,0],["أنتِ الجمالُ وأنتِ لي","شمسُ المحبَّةِ والقمرْ",70,"ر",1,0],["أنتِ الجليلة ُوالهدى خصمٌ لهمْ","مهما تَعالُوْا بالضَّلالِ سيَسقطونْ",71,"ن",1,0],["‏أنت الجميلة في التطوير أجمَعِهِ","‏ ‏ أنت المفيدة للأحفاد والولد"