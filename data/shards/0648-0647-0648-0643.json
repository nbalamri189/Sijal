{"poems":[[55,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[95,"يوسف يا سبط الندى والعلى","https://www.aldiwan.net/poem9776.html","عموديه"],[74,"يا من له في طريق زهد","https://www.aldiwan.net/poem19262.html","مخلع البسيط"],[53,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[87,"لله أنت مؤلفا ومدونا","https://www.aldiwan.net/poem7136.html","الكامل"],[64,"بالزوابيق زال ظل النحاس","https://www.aldiwan.net/poem52173.html","الخفيف"],[82,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[104,"لا تبالي بألف خطب عراها","https://www.aldiwan.net/poem32997.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[108,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[119,"لذ بباب الغوث الجليل الرفاعي","https://www.aldiwan.net/poem41778.html","الخفيف"],[139,"إلى متى الإنسان لا يرعوي","https://www.aldiwan.net/poem48952.html","السريع"],[190,"زهد الناس في العلوم","https://www.aldiwan.net/poem44141.html","مجزوء الخفيف"],[193,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[333,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[353,"رأيت أنف ابن خنفر وقد","https://www.aldiwan.net/poem20730.html","السريع"],[475,"ما ضر جيراننا إذ انتجعوا","https://www.aldiwan.net/poem4742.html","المنسرح"],[484,"راحة النهى الطرب","https://www.aldiwan.net/poem37059.html","المقتضب"],[556,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[563,"لا تخلط الواجب بالممكن","https://www.aldiwan.net/poem33716.html","السريع"],[563,"إن جسمي هنا وقلبي هناكا","https://www.aldiwan.net/poem34259.html","الخفيف"],[580,"لك وجه وفيه قطعة أنف","https://www.aldiwan.net/poem2807.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87174","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87127","الخفيف"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77562","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62573","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59124","الخفيف"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61170","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46507","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49919","الكامل"],[1683,"","https://poetry.dctabudhabi.ae/diwan/poem/123962","الرمل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130862",""],[2870,"","https://poetry.dctabudhabi.ae/diwan/poem/142166","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74157","الرجز"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118740","الرجز"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36115","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114310","الرمل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95338","الرجز"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29273","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111408","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[5183,"الشيء المعقد","https://www.poetsgate.com/ViewPoem.aspx?id=180177",""],[4623,"سائلاتي عن ادمع سائلات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146690",""],[5396,"لمعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65505&r=&rc=4",""]],"verses":[["وَهوَ كَما ساءَ العِدا","ماضي الغِرارِ قاصِلُ",0,"ل",1,0],["وهو كتاب ليس لي إنما","وجدته كنزاً ثميناً يصاب",1,"ب",1,0],["وهو كما قد ترى خفيف","وفيه لطف وفيه ظرف",2,"ف",1,0],["وهو كالدهر حين يجري ونجري","فَتَقَضَّى الأعمارُ في أمدادِهْ",3,"د",2,0],["وهو كالكَعْبَةِ المُصلِّي إليها ال","ناسُ من بين مُنْجِدٍ وتَهامي",4,"م",2,0],["وهو كالندىِّ وأنت بين سطوره","ملك الحديث تنقلا وتفننا",5,"ن",2,0],["وهو كالحوت لا يزال الما","ء ومأواه في قرار السعيرِ",6,"ر",1,0],["وهو كالفكر بين غشّ عَدُوٍّ","لبنيه وبين نُصْحِ وليِّ",7,"ي",1,0],["وهو كالدَّوْحَةِ العقيمِ ظلالٌ","واخضرارٌ ولا يُرجَّى جناها",8,"ا",3,0],["وهو كالماء غاسل للجهالا","ت وكالنور ماحقُ الظلمات",9,"ت",1,0],["وهْو كم من نَابه أخْمَلَهُ","وأديبٍ من حضيض رفعه",10,"ع",2,0],["وهو كنز تضمن العلم والعر","فان خلقاً وطال بالارتفاع",11,"ع",1,0],["وهو كليل العزم أوهَى القوى","مستضعف الهمة في ذاتهِ",12,"ت",2,0],["وهو كالكلب دون ما","في يديه إذا كلب",13,"ب",1,0],["وَهوَ كلُّ الورى إليه تؤولُ","وَلهُ مِن إلههِ التعميمُ",14,"م",1,0],["وهوَ كثيرُ الصمتِ والمكلّمُ","وَأفصحُ العُربِ البليغُ الشذقمُ",15,"م",1,0],["وهو كاس فيه للصه","باء مغدىً ومراح",16,"ح",1,0],["وَهْوَ كَسَبْعِ الحَوْضِ في فَتحهِ","فَاهُ وفي إعلانِ أَجْفانهِ",17,"ن",2,0],["وَهوَ كأَنَّ الهيامَ خالَطَهُ","وَما بِهِ غَير حُبِّها رَدَعُ",18,"ع",1,0],["وهو كالثعالة إن","راغ عنك فالهرب",19,"ب",1,0],["وَهوَ كَما شاء له","ذاك النِّجارُ والكَرَمْ",20,"م",1,0],["وهو كثير في ظهوراته","وواحد في ذاته الأبين",21,"ن",1,0],["وهو كفر منزه عنه ربي","قد نهاهم عن مثله ونهاكا",22,"ك",2,0],["وهو كالْقبر في المنازِل لكن","جعلوا نَصْبَه عَلى غير قِبْلهْ",23,"ه",1,0],["وَهوَ كالحصن في الرصانة وَالوَض","ع معينٌ عَلى مَزيد اِحتَماه",24,"ا",2,0],["وَهوَ كَالريح في أُمورٍ وَإِن شئ","ت فَذاكَ اللجين إنا كشفنا",25,"ن",2,0],["وَهوَ كنز الوَفا وَكَهف العَطايا","وَسَمير الندى وَمحيي الرُسوم",26,"م",1,0],["وَهوَ كَما حكاه مينانوسُ","حينَ اِشمَأَزَّت يَوماً النُفوسُ",27,"س",1,0],["وهو كالسيل ولكن","هو بالتبر يجود",28,"د",1,0],["وَهْوَ كَنْزُ الغِنَى وَأفْقُ المَعَالِي","وَهْوَ نَجْمُ العُلَى وَصُبْحُ السُّعُودِ",29,"د",1,0],["وَهوَ كَثير النسل مَعدومه","فَناكح مِنهُ وَمَنكوح",30,"ح",1,0],["وَهوَ كِتاب حَسَن خَطير","لَيسَ لَهُ في فَنِهِ نَظير",31,"ر",1,0],["وهو كماء الغَمام تمزُجهُ","بالراحِ أو كاللجين في الذَّهبِ",32,"ب",1,0],["وهو كالليث إذا ما","عد أصحاب الدروع",33,"ع",1,0],["وهو كلام ظاهرٌ لا شكَّ في","صحتِه وسرّهُ غيرُ خفي",34,"ي",1,0],["وهو كونٌ مطهرٌ مستقلٌّ","عن دنايا مجامع الاهواء",35,"ا",2,0],["وهْو كالورد زاهيًا وجميلاً","لو قطفتُ الورودَ من وجنتَيْها",36,"ي",3,0],["وَهوَ كَجار اللَه في التَفسير","فاسمع لما أَقول مِن تفسيري",37,"ي",1,0],["وهو كما قد حققوه الشيخ كليب","ليس الكليماتي فذا شكٌ وريب",38,"ب",1,0],["وهو كاشجار خلت من ثمر","وشبه ماءٍ كان مرّ الطعم",39,"م",1,0],["وَهوَ كَالخَمرِ رِقَّةً وَصَفاءً","وَكَما اِلتَذَّ عَيشَهُ النَشوانُ",40,"ن",1,0],["وَهْوَ كَالعُنَّابِ فِيهِ مُشْتَهًى","مُسْتَطَابٌ مَعَ شَوْكٍ يُعْتَزَلْ",41,"ل",1,0],["وهو كِسرى وسداد من عَوَز","وهي إِوزَّة وفي الجمع إوز",42,"ز",1,0],["وَهوَ كَالحُبِّ كَوثَرٌ وَنَماءٌ","وَهوَ مَرعىً لِلرّوحِ جَمُ السوحِ",43,"ح",1,0],["وهوَ كُفؤٌ لِهَدّ كُلّ قُوَانا","بعُرُوشٍ قد أَعظَمَتنَأ جَلاَلا",44,"ل",2,0],["وهو كالبرق وإن كان ونى","فهو كالهوج سرت في مدرج",45,"ج",1,0],["وهو كالسلطان فيهم","يدعي والكل يشهد",46,"د",1,0],["وهو كنز مطلسم عن عقول","الناس طرا سيان ماض وات",47,"ت",1,0],["وهو كالطائر الرضيع وقد أصبح","فوق الغصون غير رضيع",48,"ع",1,0]]}