{"poems":[[88,"رحم الله صاحب النظرات","https://www.aldiwan.net/poem10351.html","الخفيف"],[93,"جاء الشتاء جيأة المفاجي","https://www.aldiwan.net/poem8787.html","عموديه"],[102,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[93,"لارفعن للسما احتجاجي","https://www.poetsgate.com/ViewPoem.aspx?id=52995",""],[333,"بعد حين ستواريني كما","https://www.aldiwan.net/poem55021.html","مجزوء الرمل"],[591,"للمنطقيين أشتكي أبدا","https://www.aldiwan.net/poem17589.html","المنسرح"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122540","الخفيف"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110446","الخفيف"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39034","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112300","المنسرح"],[4083,"","https://poetry.dctabudhabi.ae/diwan/poem/147650","الخفيف"],[4984,"الجرْس ( وحي العيد )","https://www.poetsgate.com/ViewPoem.aspx?id=180973",""],[5121,"روايتي الشقية","https://www.poetsgate.com/ViewPoem.aspx?id=37466",""],[5376,"هل أنشدُ الدارَ قحطاناً وعدنانا.","https://www.poetsgate.com/ViewPoem.aspx?id=188463",""],[5533,"نُكْران","https://www.poetsgate.com/ViewPoem.aspx?id=214447",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""]],"verses":[["كَيفَ غادَرتَنا سَريعاً وَعَهدي","بِكَ يا مُصطَفى كَثيرِ الأَناةِ",0,"ه",1,0],["كيَفَ غَدَوتَ مَوطِئَ الأَحداجِ","وَمَعبَرَ الخَلقِ إِلى الخَراجِ",1,"ج",1,0],["كيفَ غالَبتَ الطَّوامِي؟ قال لِي","أَخطَرُ الإبحارِ : ما أعظَمَ سَبحَك",2,"ك",1,0],["كيف غدوت موطىء الأحداج","ومعبر الخلق إلى الخراج",3,"ج",1,0],["كيفَ غابَت أن","جمُ الآمال من آفاقِ عمري",4,"ي",1,0],["كَيْفَ غَدَتْ في الهَوَى وَمَا انْفَصَلَتْ","مانِعةُ الجَمْعِ والخُلوِّ مَعَا",5,"ع",2,0],["كَيفَ غرَّتكُم عَقارِبُ للسّل","مِ لها نَحو ما كَرهتَ دبيب",6,"ب",1,0],["كيف غادَرتَني بقلبٍ جريحٍ","يتلظَّى في مثلِ جمر القتادِ",7,"د",1,0],["كَيْفَ غَرْناطَةٌ ومَنْ حَلَّ فِيْها","حَبَّذا السَّاكنونَ تِلْكَ الدِّيارا",8,"ر",2,0],["كيفَ غدَت تنثَني عزَائمهُ","وَصَارَ أمضى سلاحهِ الهرَبُ",9,"ب",1,0],["كيف غيرت بانتزاحك حالي","وتغيرت لي وليست بحارث",10,"ث",1,0],["كيف غادرت عالم الشعر طوعا","هل قديم من المنازل ينسى",11,"س",2,0],["كَيْفَ غَصَّتْ حَنَاظِلٌ فِي شِغَافِي؟","وَارْتَوَتْهَا بِذِي الْحَنَايَا دِمَاءُ!!",12,"ا",2,0],["كيف غدونا ودينُ اللهِ يجْمعُنا","بعد النبوةِ بالتوحيدِ فرقانا",13,"ن",2,0],["كيفَ غابوا؟ كيفَ ناؤُوا؟ اسألو","هُمْ، فَقَدْ أَمْسَى جُحُودُ الفَضْلِ عادَةْ",14,"د",2,0],["كيف غابتْ (دنْيا الْهوى عنْ وجودي؟!","يا نعيمًا عنْه الْورى في عناء",15,"ا",2,0]]}