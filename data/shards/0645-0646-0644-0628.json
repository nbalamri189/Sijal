{"poems":[[55,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[53,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[45,"إنما التهنئات للأكفاء ولمن يدني من البعداء","https://www.aldiwan.net/poem9447.html","الخفيف"],[111,"نكس العلام يا خير الملل","https://www.poetsgate.com/ViewPoem.aspx?id=67046",""],[469,"بين حزني وحسنه اليوسفي","https://www.aldiwan.net/poem3166.html","عموديه"],[563,"أول منامك هذا","https://www.aldiwan.net/poem34557.html","المجتث"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63943","السريع"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77940","الخفيف"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101894","الرجز"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125437","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125377","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124736","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27148","الرمل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100495","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109855","الخفيف"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103513","المديد"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70155","الكامل"],[4802,"أبعاد","https://www.poetsgate.com/ViewPoem.aspx?id=32337",""],[5055,"الأمير","https://www.poetsgate.com/ViewPoem.aspx?id=104034",""],[5145,"من لبرقٍ على البراق أنارا","https://www.poetsgate.com/ViewPoem.aspx?id=108062",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""]],"verses":[["مَن لِبَرقٍ هَبَّ وَهناً","مِن أَبانَينِ وَسوقَه",0,"ق",2,0],["من لَبِسَ الكِبرَ عند ثروتِه","على أخيه فنفسَه هضما",1,"م",2,0],["مَن لِبيضِ المُلوكِ أَن تُبدِلَ اللَو","نَ بِلَونِ الأُستاذِ وَالسَحناءِ",2,"ا",2,0],["من لبذل العدل والاحسان من","يحمل الكل ومن يعطي النفل",3,"ل",1,0],["من لباكٍ من ضاحكٍ وشج","يٍ بخليٍ ومحسنٍ بمسي",4,"ي",1,0],["من لبسه فهو حق","أرضاك أو ذاك آذى",5,"ذ",2,0],["مَنْ لبسَ الشَّعْرَ عِذاراً فقد","ألبسك الشَّعْرُ لجاماً دِلاص",6,"ص",1,0],["من لبال من التَبلبل بالِ","سره الوجد وَالغَرام يسالي",7,"ل",2,1],["من لبن عن الوقاع الحل","منبعث مع ولد أو حمل",8,"ل",1,0],["من لِبَدرِ الدُّجى بأَنوارِ وجهٍ","كل عُشَّاقه ضحايا غرامِك",9,"ك",1,0],["من لِبَدرِ الدُّجى بِحُسنِ مُحيا","كِ إذا ما أرَخت عفواً لثامِك",10,"ك",1,0],["من لبرقٍ في عارضٍ","كاقتداء الطير لما لمعا",11,"ع",2,0],["مَن لِبَثّي مَن لِوَجدي دُلَّني","مَن لِحُزني مِن لِصَبٍّ عَشِقا",12,"ق",2,0],["من لبدر أضحى له اللحد برجا","من للشمس قد كورت تكويرا",13,"ر",2,0],["من لبدر الدجى بحسن محيا","ك اذا ما ازحت فضل لثامك",14,"ك",1,0],["من لباس الشاء موثقه","وظهيرُ الشيح ملتئمه",15,"م",2,0],["من لبهج الاحجار منظرا حجر","مسند ظهر مظهر العدل عمر",16,"ر",1,0],["مِن لبِّ لُبنانٍ اتتكَ خَريدةٌ","عَذراء وَقاها الوشاةَ اسودُهُ",17,"د",2,0],["من لبّس عيونه ظلام المدينه؟","وهو الفضول بنظرته مالها أبعاد",18,"د",1,1],["من لباسٍ لك أنا بْ ثوبي لبسته","ولي لبس ثوبك ترى عقله بصير",19,"ر",1,0],["من لبرقٍ على البراق أنارا","ملأ الخافقين نوراً ونارا",20,"ر",2,1],["من لبس الدهر على أخلاقه","شف له باطنه عما انطوى",21,"ا",1,0]]}