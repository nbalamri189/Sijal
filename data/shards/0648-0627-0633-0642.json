{"poems":[[55,"أذن مجتازا بنا بالصلاة","https://www.aldiwan.net/poem26442.html","السريع"],[86,"أوشك الديك أن يصيح ونفسي","https://www.aldiwan.net/poem10941.html","الخفيف"],[30,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[88,"ابنوا المدارس واستقصوا بها الأملا","https://www.aldiwan.net/poem45004.html","البسيط"],[72,"يوم صحو فاجعله لي يوم سكر","https://www.aldiwan.net/poem18694.html","الخفيف"],[72,"يا عذولي خلني أغنم عمري","https://www.aldiwan.net/poem18701.html","الرمل"],[72,"من عذيري من الطلا والأغاني","https://www.aldiwan.net/poem20180.html","الخفيف"],[85,"قام من علته الشاكي الوصب","https://www.aldiwan.net/poem62920.html","الرمل"],[56,"خل بيني وبين حب المدام","https://www.aldiwan.net/poem58497.html","الخفيف"],[43,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[43,"يا ديار العباهر الأتراب","https://www.aldiwan.net/poem10613.html","الخفيف"],[66,"روني من سلافة الصهباء","https://www.aldiwan.net/poem39083.html","الخفيف"],[44,"وأبي المنازل إنها لشجون","https://www.aldiwan.net/poem30334.html","الكامل"],[74,"أما ومسيل ماثل الغيث كالسطر","https://www.aldiwan.net/poem12949.html","الطويل"],[102,"أنشدي يا صبا","https://www.aldiwan.net/poem32974.html","المتدارك"],[52,"وأنت الذي ذللت للناس جانبي","https://www.aldiwan.net/poem26860.html","الطويل"],[48,"باكر اليوم الصبوحا","https://www.aldiwan.net/poem62517.html","مجزوء الرمل"],[48,"أحي لي يا صاح روحي","https://www.aldiwan.net/poem62519.html","مجزوء الرمل"],[48,"غرد الديك الصدوح","https://www.aldiwan.net/poem62532.html","مجزوء الرمل"],[48,"بادر الكأس نهارا","https://www.aldiwan.net/poem63275.html","مجزوء الرمل"],[48,"اسقني واسق ذفافه","https://www.aldiwan.net/poem64391.html","مجزوء الرمل"],[48,"عاذلي في المدام لا أرضيكما","https://www.aldiwan.net/poem64463.html","الخفيف"],[48,"أعاذل ما غنيت عن المدام","https://www.aldiwan.net/poem65243.html","الوافر"],[48,"بحقّ دينِ النصارى","https://www.aldiwan.net/poem66575.html","المجتث"],[46,"أرى جزء شهد بين أجزاء علقم","https://www.aldiwan.net/poem23365.html","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30514","الطويل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42649","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141934","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8913","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[112,"الحمد لله على ما الهما","https://www.aldiwan.net/poem2368.html","الرجز"],[116,"ألا يا لقومي للهوى المتقسم","https://www.aldiwan.net/poem41825.html","الطويل"],[129,"بموتِ المرتضى الواكي الرضى","https://www.aldiwan.net/poem50216.html","الوافر"],[133,"أرى العذال في الهيمان لاموا","https://www.aldiwan.net/poem54654.html","الوافر"],[133,"أبان اصطباري بين أم أبان","https://www.aldiwan.net/poem54702.html","الطويل"],[136,"في ربا الأنس تعبق الأرواح","https://www.aldiwan.net/poem49124.html","الخفيف"],[138,"أدر الكأس يمينا","https://www.aldiwan.net/poem67988.html","مجزوء الرمل"],[143,"لجاجة قلب ما يفيق غرورها","https://www.aldiwan.net/poem58440.html","الطويل"],[156,"لجنون الهوى وهبت جناني","https://www.aldiwan.net/poem55511.html","الطويل"],[167,"بعدت وما حكم البعاد بعادل","https://www.aldiwan.net/poem46895.html","الطويل"],[179,"ذهاب أضاع إيابه","https://www.aldiwan.net/poem50692.html","المتقارب"],[179,"هيتا","https://www.aldiwan.net/poem50719.html","الوافر"],[187,"جزى الله من أقصى وصار مخالفي","https://www.aldiwan.net/poem43799.html","الطويل"],[187,"خذ من الدنيا فإن الموت","https://www.aldiwan.net/poem44098.html","مجزوء الرمل"],[190,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[190,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[200,"ذهبا هات وإلا فلجين","https://www.aldiwan.net/poem45363.html","الرمل"],[223,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[233,"ما كنت في عشقي لذاك القوام","https://www.aldiwan.net/poem14789.html","السريع"],[236,"يا صلاح الدين خذ حذ","https://www.aldiwan.net/poem31807.html","مجزوء الرمل"],[236,"من عذيري فيه وهل من عذير","https://www.aldiwan.net/poem32017.html","الخفيف"],[238,"نحن قوم إن غاب عنا الساقي","https://www.aldiwan.net/poem19520.html","الخفيف"],[238,"أعضلت علتي فجئت رئيسا","https://www.aldiwan.net/poem19700.html","الخفيف"],[238,"إيه فالعز قدك من تدليس","https://www.aldiwan.net/poem19702.html","الخفيف"],[238,"بشرى لفاس وقد طمت دياجيها","https://www.aldiwan.net/poem19728.html","البسيط"],[242,"زاحفت أيامي وزاحفنني","https://www.aldiwan.net/poem45756.html","السريع"],[251,"أين فعل المدام بالجلاس","https://www.aldiwan.net/poem14984.html","الخفيف"],[255,"اُعف عني","https://www.aldiwan.net/poem24945.html","مجزوء الرمل"],[260,"ربنا إننا لهجنا بذكرك","https://www.aldiwan.net/poem35973.html","الخفيف"],[272,"قف بذات الاراك واندب طلولا","https://www.aldiwan.net/poem52065.html","الخفيف"],[283,"إن تغن الورقاء في الأوراق","https://www.aldiwan.net/poem32690.html","الخفيف"],[304,"يا نديمي انتبه فإن المثاني","https://www.aldiwan.net/poem57798.html","الخفيف"],[314,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[329,"قبل أن يبصر الظلام الضياء","https://www.aldiwan.net/poem54981.html","الخفيف"],[329,"يا نديمي هات الأباريق هات","https://www.aldiwan.net/poem55034.html","الخفيف"],[350,"متى ينشق عن جسدي الضريح","https://www.aldiwan.net/poem15562.html","الوافر"],[372,"غنني يا أعز ذا الخلق عندي","https://www.aldiwan.net/poem56940.html","الخفيف"],[372,"نعم الله يا ابن عبد الله","https://www.aldiwan.net/poem56984.html","الخفيف"],[372,"لحن حتى أمرن طرفا بقلبي","https://www.aldiwan.net/poem57526.html","الكامل"],[381,"لو يكون اللقاء باستحقاق","https://www.aldiwan.net/poem49203.html","الخفيف"],[401,"دعيني وخيل الشعر","https://www.aldiwan.net/poem10299.html","عموديه"],[403,"أتدري من تخرمت المنون","https://www.aldiwan.net/poem46438.html","الوافر"],[404,"هات واسق الذهن من خمر العلوم","https://www.aldiwan.net/poem33343.html","مجزوء الرمل"],[404,"سرى طيفها والطرف مني مسهد","https://www.aldiwan.net/poem33967.html","الطويل"],[407,"صب نأى فأفاعي البين تلسعه","https://www.aldiwan.net/poem50148.html","البسيط"],[417,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[417,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[417,"قدحت في مزجها بالماء نارا","https://www.aldiwan.net/poem54186.html","الرمل"],[430,"أيها الساقي أدرها","https://www.aldiwan.net/poem40085.html","مجزوء الرمل"],[430,"لا وعينيك والجبين وجيدك","https://www.aldiwan.net/poem40281.html","الخفيف"],[438,"لولا تذكر عهد بالحمى سلفا","https://www.aldiwan.net/poem2503.html","البسيط"],[440,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[453,"اعمل لنفسك ما استطعت","https://www.aldiwan.net/poem13666.html","مجزوء الكامل"],[506,"الحظّ","https://www.aldiwan.net/poem42462.html","الطويل"],[514,"إلى الله أشكو عبرة قد أظلت","https://www.aldiwan.net/poem67776.html","الطويل"],[515,"نصال من جفونك أم سهام","https://www.aldiwan.net/poem20794.html","الوافر"],[515,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[530,"أدكرى حبيب أبرزت دمية القصر","https://www.aldiwan.net/poem37419.html","الطويل"],[552,"أبت زفرات الحب إلا تصعدا","https://www.aldiwan.net/poem47866.html","الطويل"],[559,"ليس طيب الحياة غير وفاتك","https://www.aldiwan.net/poem34275.html","الخفيف"],[559,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وَاِسقِ سَعيداً وَاِبنَ بِشرٍ أَخا","شَيبانَ مِن أَكؤُسِكَ المُترَعات",0,"ت",1,0],["وَاِسقِ خَليلي خَلَفاً إِنَّهُ","لي ثِقَةٌ دونَ جَميعِ الثِقات",0,"ت",1,0],["وَاِسقِنا يا غُلامُ حَتّى تَرانا","لا نُطيقُ الكَلامَ إِلّا بِهَمسِ",1,"س",1,0],["وَأَسقيهِ حَتّى كادَ مِمّا أَبُثُّهُ","تُكَلِّمُني أَحجارُهُ وَمَلاعِبُه",2,"ب",2,0],["واسقوا المُتلمَذ فيها خمر مَكرُمة","عن خمرة الكرم تُمسي عنده بدلا",3,"ل",2,0],["واسْقني في منازل مثل خلقي","بيدَي هاجر يغني بشعري",4,"ر",2,0],["واسقياني مثل خلقي قهوة","بيديْ بدر يغنّيني بشعري",5,"ر",2,0],["واسْقياني فإن اشْتكيت داءً","فاسْقياني إن شئتما تشفياني",6,"ن",2,0],["وَاِسقِ بِالمَعنى إِلَهِيّاً كَما","تَتَساقَونَ الرَحيقَ المُنسَكِب",7,"ب",1,0],["واسْقِني يا أَخَا المدامةِ كَأْساً","منكَ مَمْزوجَةً بماءِ الغَمامِ",8,"م",1,0],["وَأُسقِطَتِ الأَجِنَّةُ في الوَلايا","وَأُجهِضَتِ الحَوائِلُ وَالسِقابُ",9,"ب",1,0],["واسقِ أطلالها وإن هجرتنا","يا إله السماء نوءَ السحاب",10,"ب",1,0],["وَاِسقِياني بَلِ اِشفِياني فَحِفظُ ال","نَفسِ خَيرٌ مِن أَن أَموتَ بِدائي",11,"ا",2,0],["وَاِسقِ الأَثافِيَّ مِن شُؤوني رِيَّها","إِنَّ الضَنينَ بِدَمعِهِ لَضَنينُ",12,"ن",1,0],["وَأَسقَيتُها مِن ديمَةٍ إِثرَ ديمَةٍ","فَمالَت بِها الجُدرانُ سَطراً عَلى سَطرِ",13,"ر",1,0],["وَاسقني يا نَدى","بَين لَحظ العُيون",14,"ن",1,0],["وَأَسقَيتَ عَيني رَيَّها مِن دُموعِها","وَعَلَّمتَها لَحظَ المُريبِ المُفَزَّعِ",15,"ع",1,0],["وَاِسقِنيها مِن عُقارٍ","عَهِدَت في الفُلكِ نوحا",16,"ح",2,0],["وَاِسقِني حَتّى تَراني","رادِعاً رَدعَ الجَموحِ",17,"ح",1,0],["وَاِسقِني حَتّى تَراني","حَسَناً عِندي القَبيحُ",18,"ح",1,0],["وَاِسقِنيها مِثلَما تَش","رَبُها كَيلاً عِيارا",19,"ر",2,0],["وَاِسقِ رَأسَ اللَهوِ وَالظُر","فِ عَلى يُمنِ العِيافَه",20,"ف",2,0],["وَاِسقِيانا يا ساقِيَينا عُقاراً","بِنتَ عَشرٍ تَخالُ فيها السَبيكا",21,"ك",2,0],["وَأَسقيها مِنَ الفِتيانِ مِثلي","فَتَختالُ الكَريمَةُ بِالكِرامِ",22,"م",1,0],["وأسقفٍ عنده","السجود للمطرانِ",23,"ن",1,0],["وَأَسقامَ دينٍ إِن يُرَجِّ شِفائَها","صَحيحٌ يَطُل مِنهُ العَناءُ وَيَسقُمُ",24,"م",1,0],["وأَسقَيتَه مِن جَمَّة الأَمن صافِياً","إِذا ذاقَه من ذاقه يَتَمَطَّقُ",25,"ق",1,0],["وأُسقطَ السابعُ وهو يسكنُ","فذلكَ المنقوصُ ليسَ يحسنُ",26,"ن",1,0],["وَاسْقِيَانِي وَغَنِّيَانِي بِلَحْنٍ","يَبْعَثُ النَّفْسَ مِنْ إِسَارِ الْوَقَارِ",27,"ر",1,0],["واسقني الشهد المذاب","فإذا ولّى الشباب",28,"ب",1,0],["وَاِسقِني الماءَ يَومَ تروى وأصدى","نَصباً مِن خَطيئَتي وَلُغوبا",29,"ب",2,0],["وَاِسقِني عَلى ظَمأ","مِن مَعينِ كَوثَرِها",30,"ر",3,0],["وَاِسقِيا بِالزِقِّ مِن حانوتِها","شائِلِ الرِجلَينِ مَعصوبِ الذَنَب",31,"ب",1,0],["واسقِنا من سُلافِك العَذْبِ إِنّا","قد سئمنا مرارةَ الأقداح",32,"ح",1,0],["واسقِط مِن التَّربيع في الأخرى العدد","وجَذرُ ما يَبقى عَلَيهِ يُعتَمَد",33,"د",1,0],["وَأُسقى بِعَذبٍ بارِدِ الريقِ واضِحٍ","لَذيذِ الثَنايا طَيِّبِ المُتَنَسَّمِ",34,"م",1,0],["وأسقيت الورَى كاسَاتِ حُزنٍ","بموتك من فصيحٍ أو عَيِىّ",35,"ا",1,0],["وأسقى منزلا بالجُلَّه عافٍ","يُذَكِّرني بقاياه الوشام",36,"م",1,0],["وأُسقِطُهُ مِن أعيُنِ النَّاسِ بَعدَمَا","تَلَقَّوهُ إِجلاَلاَ بِكُلِّ مَكَانِ",37,"ن",1,0],["واسقنيها صرفاً فليس علينا","معشر العاشقين قط جُناحُ",38,"ح",1,0],["وَاِسقِياني وَاِبنَ حَربٍ","وَاِستُرانا بِالإِزارِ",39,"ر",1,0],["وأسقَى جيادا سِرنَ بالبأس والندى","من الساريات الغاديات غزيرُها",40,"ر",3,0],["وَاسْقِنِي القَهْوَةَ الَّتي تُنْبِتُ الوَرْ","دَ إِذا شِئْتَ في خُدُودِ الغَواني",41,"ن",2,0],["وأسقطْتَني لمّا ظننتُكَ واصلاُ","كأنِّيَ حرفُ الراءِ في لفظِ واصلِ",42,"ل",1,0],["وأسْقيتُ شعري ذؤافَ جِراحي","ولمّا تَعَنَّى شَرِبتُ عذابَهْ",43,"ب",2,0],["وأسقتك الحياةُ ذؤاف سمٍّ","بِميْسمِ جمرها يا ما اكتويتا",44,"ت",2,0],["وأسقط عني خدمة الوصل طالبا","رضا مهجتيّ من خليط وزائر",45,"ر",1,0],["واسقنيها بين ناول","ني وخذها ثم هات",46,"ت",1,0],["وَاِسق سَلعاً وَقُباً خيرَ رحيق","مِن سُلافِ الغيثِ موصول الهنا",47,"ن",2,0],["وَاِسق الحِمى نهَلاً من بعده عللٌ","قد كنتُ أَسقيهِ لولا الدمع معلولُ",48,"ل",1,0],["واسقني حتى أرى الناسَ على","أربعٍ يمشونَ لا على اثنتينْ",49,"ن",1,0],["واسقطوا الذي يكون كدئل","وعكسه وقيل أنه يقل",50,"ل",1,0],["واسَقَمي وَالبُرءُ في ريقِهِ","وَيا ضَلالي وَهوَ بَدرُ التَمام",51,"م",1,0],["وَاِسقِهِ مِن سُخطِكَ المُر","رِ بِكَأساتٍ دِهاقِ",52,"ق",1,0],["وَاِسقِني بِالصَغيرِ مِنها فَما أَب","قى الهَوى فِيَّ فُضلَةً لِلكَبيرِ",53,"ر",1,0],["وَاسْقِنَا خَمْرَةً نَظَلُّ بِهَا نَجْ","نِي جَنَى الْمَلَكُوتِ فَوْقَ الطِّبَاقِ",54,"ق",1,0],["وَاسْقِنَا مِنْ كُؤُوسِ بِرِّكَ وَاخْلَعْ","مِنْ نَسِيجِ الرِّضَى عَلَيْنَا لَبُوسَا",55,"س",