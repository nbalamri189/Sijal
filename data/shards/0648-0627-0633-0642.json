=199342",""],[5776,"بحّار السماء","https://www.poetsgate.com/ViewPoem.aspx?id=199412",""],[5829,"يا حبيب العمر","https://www.poetsgate.com/ViewPoem.aspx?id=152234",""],[5908,"أسفر الحي حين زارت نوار","https://www.poetsgate.com/ViewPoem.aspx?id=170973",""],[5939,"ظامئٌ لارتشافِكِ شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=178620",""],[5943,"شفاء","https://www.poetsgate.com/ViewPoem.aspx?id=61781",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6031,"عَاطِنيها قبلَ ابتِسَامِ الصَّبَاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=46257",""],[6032,"شوق ولهيب","https://www.poetsgate.com/ViewPoem.aspx?id=181504",""],[6035,"النداء الأخير ! .","https://www.poetsgate.com/ViewPoem.aspx?id=151965",""],[6043,"مرثيّة الأرض العالقة","https://www.poetsgate.com/ViewPoem.aspx?id=215591",""],[6084,"زارني ليلا وقد نام الرقيب","https://www.poetsgate.com/ViewPoem.aspx?id=170819",""],[6093,"أسارةُ إنَّ الهّجْرَ للحبِّ قاتل","https://www.poetsgate.com/ViewPoem.aspx?id=176430",""],[6093,"واسِ قصيدي أبا بدرٍ وأسرتَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=176507",""],[6102,"بين كلابها وحجاجها ..","https://www.poetsgate.com/ViewPoem.aspx?id=182808",""],[6152,"سقى الله الحجاز","https://www.poetsgate.com/ViewPoem.aspx?id=203295",""],[6152,"وهبت لمن أحب عروق قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=205862",""],[6277,"خمدي بالسلاف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64481&r=&rc=44",""],[6345,"بلادي الإمارات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78677&r=&rc=48",""]],"verses":[["وَاِسقِ سَعيداً وَاِبنَ بِشرٍ أَخا","شَيبانَ مِن أَكؤُسِكَ المُترَعات",0,"ت",1,0],["وَاِسقِ خَليلي خَلَفاً إِنَّهُ","لي ثِقَةٌ دونَ جَميعِ الثِقات",0,"ت",1,0],["وَاِسقِنا يا غُلامُ حَتّى تَرانا","لا نُطيقُ الكَلامَ إِلّا بِهَمسِ",1,"س",1,0],["وَأَسقيهِ حَتّى كادَ مِمّا أَبُثُّهُ","تُكَلِّمُني أَحجارُهُ وَمَلاعِبُه",2,"ب",2,0],["واسقوا المُتلمَذ فيها خمر مَكرُمة","عن خمرة الكرم تُمسي عنده بدلا",3,"ل",2,0],["واسْقني في منازل مثل خلقي","بيدَي هاجر يغني بشعري",4,"ر",2,0],["واسقياني مثل خلقي قهوة","بيديْ بدر يغنّيني بشعري",5,"ر",2,0],["واسْقياني فإن اشْتكيت داءً","فاسْقياني إن شئتما تشفياني",6,"ن",2,0],["وَاِسقِ بِالمَعنى إِلَهِيّاً كَما","تَتَساقَونَ الرَحيقَ المُنسَكِب",7,"ب",1,0],["واسْقِني يا أَخَا المدامةِ كَأْساً","منكَ مَمْزوجَةً بماءِ الغَمامِ",8,"م",1,0],["وَأُسقِطَتِ الأَجِنَّةُ في الوَلايا","وَأُجهِضَتِ الحَوائِلُ وَالسِقابُ",9,"ب",1,0],["واسقِ أطلالها وإن هجرتنا","يا إله السماء نوءَ السحاب",10,"ب",1,0],["وَاِسقِياني بَلِ اِشفِياني فَحِفظُ ال","نَفسِ خَيرٌ مِن أَن أَموتَ بِدائي",11,"ا",2,0],["وَاِسقِ الأَثافِيَّ مِن شُؤوني رِيَّها","إِنَّ الضَنينَ بِدَمعِهِ لَضَنينُ",12,"ن",1,0],["وَأَسقَيتُها مِن ديمَةٍ إِثرَ ديمَةٍ","فَمالَت بِها الجُدرانُ سَطراً عَلى سَطرِ",13,"ر",1,0],["وَاسقني يا نَدى","بَين لَحظ العُيون",14,"ن",1,0],["وَأَسقَيتَ عَيني رَيَّها مِن دُموعِها","وَعَلَّمتَها لَحظَ المُريبِ المُفَزَّعِ",15,"ع",1,0],["وَاِسقِنيها مِن عُقارٍ","عَهِدَت في الفُلكِ نوحا",16,"ح",2,0],["وَاِسقِني حَتّى تَراني","رادِعاً رَدعَ الجَموحِ",17,"ح",1,0],["وَاِسقِني حَتّى تَراني","حَسَناً عِندي القَبيحُ",18,"ح",1,0],["وَاِسقِنيها مِثلَما تَش","رَبُها كَيلاً عِيارا",19,"ر",2,0],["وَاِسقِ رَأسَ اللَهوِ وَالظُر","فِ عَلى يُمنِ العِيافَه",20,"ف",2,0],["وَاِسقِيانا يا ساقِيَينا عُقاراً","بِنتَ عَشرٍ تَخالُ فيها السَبيكا",21,"ك",2,0],["وَأَسقيها مِنَ الفِتيانِ مِثلي","فَتَختالُ الكَريمَةُ بِالكِرامِ",22,"م",1,0],["وأسقفٍ عنده","السجود للمطرانِ",23,"ن",1,0],["وَأَسقامَ دينٍ إِن يُرَجِّ شِفائَها","صَحيحٌ يَطُل مِنهُ العَناءُ وَيَسقُمُ",24,"م",1,0],["وأَسقَيتَه مِن جَمَّة الأَمن صافِياً","إِذا ذاقَه من ذاقه يَتَمَطَّقُ",25,"ق",1,0],["وأُسقطَ السابعُ وهو يسكنُ","فذلكَ المنقوصُ ليسَ يحسنُ",26,"ن",1,0],["وَاسْقِيَانِي وَغَنِّيَانِي بِلَحْنٍ","يَبْعَثُ النَّفْسَ مِنْ إِسَارِ الْوَقَارِ",27,"ر",1,0],["واسقني الشهد المذاب","فإذا ولّى الشباب",28,"ب",1,0],["وَاِسقِني الماءَ يَومَ تروى وأصدى","نَصباً مِن خَطيئَتي وَلُغوبا",29,"ب",2,0],["وَاِسقِني عَلى ظَمأ","مِن مَعينِ كَوثَرِها",30,"ر",3,0],["وَاِسقِيا بِالزِقِّ مِن حانوتِها","شائِلِ الرِجلَينِ مَعصوبِ الذَنَب",31,"ب",1,0],["واسقِنا من سُلافِك العَذْبِ إِنّا","قد سئمنا مرارةَ الأقداح",32,"ح",1,0],["واسقِط مِن التَّربيع في الأخرى العدد","وجَذرُ ما يَبقى عَلَيهِ يُعتَمَد",33,"د",1,0],["وَأُسقى بِعَذبٍ بارِدِ الريقِ واضِحٍ","لَذيذِ الثَنايا طَيِّبِ المُتَنَسَّمِ",34,"م",1,0],["وأسقيت الورَى كاسَاتِ حُزنٍ","بموتك من فصيحٍ أو عَيِىّ",35,"ا",1,0],["وأسقى منزلا بالجُلَّه عافٍ","يُذَكِّرني بقاياه الوشام",36,"م",1,0],["وأُسقِطُهُ مِن أعيُنِ النَّاسِ بَعدَمَا","تَلَقَّوهُ إِجلاَلاَ بِكُلِّ مَكَانِ",37,"ن",1,0],["واسقنيها صرفاً فليس علينا","معشر العاشقين قط جُناحُ",38,"ح",1,0],["وَاِسقِياني وَاِبنَ حَربٍ","وَاِستُرانا بِالإِزارِ",39,"ر",1,0],["وأسقَى جيادا سِرنَ بالبأس والندى","من الساريات الغاديات غزيرُها",40,"ر",3,0],["وَاسْقِنِي القَهْوَةَ الَّتي تُنْبِتُ الوَرْ","دَ إِذا شِئْتَ في خُدُودِ الغَواني",41,"ن",2,0],["وأسقطْتَني لمّا ظننتُكَ واصلاُ","كأنِّيَ حرفُ الراءِ في لفظِ واصلِ",42,"ل",1,0],["وأسْقيتُ شعري ذؤافَ جِراحي","ولمّا تَعَنَّى شَرِبتُ عذابَهْ",43,"ب",2,0],["وأسقتك الحياةُ ذؤاف سمٍّ","بِميْسمِ جمرها يا ما اكتويتا",44,"ت",2,0],["وأسقط عني خدمة الوصل طالبا","رضا مهجتيّ من خليط وزائر",45,"ر",1,0],["واسقنيها بين ناول","ني وخذها ثم هات",46,"ت",1,0],["وَاِسق سَلعاً وَقُباً خيرَ رحيق","مِن سُلافِ الغيثِ موصول الهنا",47,"ن",2,0],["وَاِسق الحِمى نهَلاً من بعده عللٌ","قد كنتُ أَسقيهِ لولا الدمع معلولُ",48,"ل",1,0],["واسقني حتى أرى الناسَ على","أربعٍ يمشونَ لا على اثنتينْ",49,"ن",1,0],["واسقطوا الذي يكون كدئل","وعكسه وقيل أنه يقل",50,"ل",1,0],["واسَقَمي وَالبُرءُ في ريقِهِ","وَيا ضَلالي وَهوَ بَدرُ التَمام",51,"م",1,0],["وَاِسقِهِ مِن سُخطِكَ المُر","رِ بِكَأساتٍ دِهاقِ",52,"ق",1,0],["وَاِسقِني بِالصَغيرِ مِنها فَما أَب","قى الهَوى فِيَّ فُضلَةً لِلكَبيرِ",53,"ر",1,0],["وَاسْقِنَا خَمْرَةً نَظَلُّ بِهَا نَجْ","نِي جَنَى الْمَلَكُوتِ فَوْقَ الطِّبَاقِ",54,"ق",1,0],["وَاسْقِنَا مِنْ كُؤُوسِ بِرِّكَ وَاخْلَعْ","مِنْ نَسِيجِ الرِّضَى عَلَيْنَا لَبُوسَا",55,"س",2,0],["وَاسْقِنَا مِنْ سَكَنْجَبِينِ الْمَعَانِي","مَا يُلِينُ احْتِبَاسَ بُؤْسِ النُّفُوسِ",56,"س",1,0],["وَاسْقِ ضَرِيحَ السَّنُوسِي وَلْتُؤَدِّ لَهُ","بِشَارَةً مَا نَسِيمُ الرَّوْضِ يَحْكِيهَا",57,"ي",3,0],["واسقِ مواتي قطرةً فَذَّةً","من بينِ ذاك العارضِ المُسبلِ",58,"ل",1,0],["واسقنيها حتى أقوم ولا أع","رف سكرا عمامتي من مدَاسي",59,"س",2,0],["واسقني من فيض حب","يحتويني، ثم زدني",60,"ن",2,0],["وَاِسقِنا في الحِمى كُؤوسَ التَداني","بِيَدِ الفَيضِ مِن مَدامَةِ ذِكرِك",61,"ك",1,0],["واسقها من عَريض دمع غَزير","دائم السكب لا يغب مسيلا",62,"ل",2,0],["وَاِسقِنيها وَردِيَّةً في زَمانِ ال","وَردِ تَحكي وَردَ الخُدودِ الرِقاقِ",63,"ق",1,0],["واسقني خمرةً حكت عين ديكٍ","في ظلام حكى جناح غراب",64,"ب",1,0],["وأسقيتني من خمر حبك شربة","خماري بها باق إلى يوم بعثتي",65,"ي",1,0],["واسقه خمر المقدّس حتى","تتناسى كيانَها الأعضاء",66,"ا",2,0],["واسقنيها أنا الشباب المولى","شاد دنياي هادم اللذات",67,"ت",1,0],["وَأُسقى مِن حَميمِ الظِلِّ ماءً","بِهِ لِمَزاجِ أَتراحي يُزيحُ",68,"ح",1,0],["واسقِني ما يَصيرُ ذُو البُخلِ منه","حاتِماً والجَبانُ عَمرَو بنَ مَعدِ",69,"د",1,0],["واسقنيها حَمراءَ إن وَصَفُوها","وتَناهَوا فَحظُّهم في التَّناهي",70,"ي",1,0],["واسِقياني حمراءَ كالنار في أب","يضَ كالنوّر من جمادٍ وسكبِ",71,"ب",1,0],["وَاسق يا سُحب عَن جُفوني بِعَدي","عَهد أَلفي بَدَمعِكِ الدَفاق",72,"ق",1,0],["وأسقيتُ منه الرَّملَ في بيدِ حسرتي","فأنْبتها زَهْراً ، وأفعَمَها عِطْرا",73,"ر",2,0],["وأسقي تُربَ قبركَ غيثَ دمعٍ","يقصّر دونَه الغيث الهتونُ",74,"ن",1,0],["واسقني التحقيق لانبت الكروم","واترك التلفيق",75,"ق",1,0],["وأسقتهمُ كأساً من الذل مُتْرَعاً","وكان لهم فوق السِّماكيْنِ مقعد",76,"د",1,0],["وَأَسقِهِ من حَيا التَقريب ساريَة","فَإِنَّهُ داثِر قَد مُجَّ مَوضِعُهُ",77,"ع",2,0],["واسقها من مَعين وجرةَ نهلا","فعَساها تطفي لهيب الغليل",78,"ل",1,0],["واسقنيها قهوةً عاديَّةً","أخبرت عمَّا مضى في ذلك العهد",79,"د",1,0],["واسقني من فيك عذباً سائغاً","إنَّ بي منك ومالسكر خمارا",80,"ر",2,0],["واسقني بالطفل صرفاً","إنما الطفل مبارك",81,"ك",1,0],["واسقني الصرف من سلافةِ ثغرٍ","باسم عن مثال در عقودك",82,"ك",1,0],["واسقل بعب لو تحمله","رضوى لأوهاه حتى كل أوضعفا",83,"ف",2,0],["وأَسْقِي الوَرى عَنْكَ ماءَ الحياةِ","وأَرشُفُ منك حِميءَ الثِّمَادِ",84,"د",1,0],["واسقط ذنوبك وامحُها","أبداً بتضعيف الثواب",85,"ب",1,0],["وأسقطُ في بحرٍ أحاطَ ببرِّها","كأنّي بموجه الفناءُ المحتّمُ",86,"م",1,0],["وأسقي لوى جبلي زرود ومربخاً","سحائب لا يلقي الظما ما أظلت",87,"ت",1,0],["وأسقَمَني اِجْتِنابُكِ لي فجسْمي","كطَرْفِكِ لا يُفارقُه السّقامُ",88,"م",1,0],["واِسقِياها من صَفا ذِكرِ الصّفا","وصِفا الخَيْفَ لها كي تُسكِراها",89,"ا",3,0],["وأسْقطَ سَقْطَ البَرْهَمِيّ وَصَرّعَ ال","صَّريعَ وأَزْرَى بالنّباتي والعُذْري",90,"ر",2,0],["وَأُسقى بكَ العذبَ النّميرَ وينثني","فراقُك يسقيني الأُجاجَ المصرّدا",91,"د",2,0],["واسقنا ربنا شراباً طهوراً","مثل ما جاء عنك في آياتك",92,"ك",1,0],["واسقياني عتيقة","يا خليلي وامزجا",93,"ج",2,0],["واسقطوا الفرائض الموجوبة","مع سنة الصلاة والمكتوبة",94,"ه",1,0],["واسقطوا الفرض وكل نافلة","وأقنوعوا من امرهم بالعاجلة",94,"ه",1,0],["واسقِنِيها كالتَّبرِ أُفرغَ في الفِضَّ","ةِ ذا جامِدٌ وهذا مُذاب",95,"ب",1,0],["وَاسقنيها مَمزوجة برضاب","طابَ لي مِنهُ في الصَبابة مرشف",96,"ف",1,0],["واسقم ومت من هواهم غير مكترثٍ","بالسقم والموتِ ترجو الأجر محتسبا",97,"ب",2,0],["وأسقمني فنفيت السّقا","م عنِّي بآلائك الشافيه",98,"ف",3,0],["واسق ندمانك راحاً قرقفا","بكؤوس ملؤها روح ولطف",99,"ف",1,0],["واسقوا ثراها الطهر دمع سروركم","تشفوا غليلاً للثرى وأواما",100,"م",2,0],["واسقنيها فقد بدا زَهرُ النّو","رِ على نُورِ صُبحِها الأزهريِّ",101,"ي",1,0],["واسقنيها كجنى المع","شوقِ أو دمْعِ المشوق",102,"ق",1,0],["واسقني الراحَ على الرا","ح وأوتارٍ صدوق",102,"ق",1,0],["وَأُسقِيَ ماءَ المَجدِ مِن مَنبَعِ العُلى","فَكانَ بِهِ ذا الغرس أَحلى مِنَ الشّهدِ",103,"د",1,0],["وَاسْقِهِ مِنْ سُلاَفِ جَودِكَ بَذْلاً","فَاقَ طِيباً سُلاَفَةَ الْخَنْدَرِيسِ",104,"س",1,0],["وأسقيتُه شهدَ الصداقة صافيا","إلى أن سقاني من عداوته سما",105,"م",2,0],["واسْقها منه دائما فهْو نهر","خيرُ نهر أزرى على الأنهارِ",106,"ر",1,0],["وَأسْقَيْتُهُ دَمْعِي لِبُعْدِ الْمَفَاوِزِ","إذَا ظَهَرَ الْمَخْفِيُّ عَنْ كُلِّ سَالِكِ",107,"ك",1,0],["وأسقيت فيه الحب صرفا لذا انبرى","يمازجه لحمي وعظمي وال