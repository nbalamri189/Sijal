{"poems":[[24,"أمن دمنة الدار أقوت سنينا","https://www.aldiwan.net/poem21884.html","المتقارب"],[87,"قد حملت إحدى نسا الأرانب","https://www.aldiwan.net/poem8018.html","الرجز"],[45,"قفا تريا ودقي فهاتا المخايل","https://www.aldiwan.net/poem9986.html","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60840","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100360","الطويل"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139447",""],[4220,"","https://poetry.dctabudhabi.ae/diwan/poem/104423","الطويل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123453","الطويل"],[5273,"رسالة إلى عمر بن الخطاب","https://www.poetsgate.com/ViewPoem.aspx?id=179801",""]],"verses":[["فَقَلقَلَهُنَّ سَراةَ العِشاءِ","أَسرَعَ مِن صَدَرِ المُصدِرينا",0,"ن",2,0],["فَقَلقَ الرُكّابُ مِن بُكائِها","وَبَينَما الفَتاةُ في عَنائِها",1,"ه",2,0],["فَقَلقَلتُ بِالهَمِّ الَّذي قَلقَلَ الحَشا","قَلاقِلَ عيسٍ كُلُّهُنَّ قَلاقِلُ",2,"ل",1,0],["فقل قد أمنتَ النائبات جميعها","وقد صرت منّا لا تخافَ من الردى",3,"د",2,0],["فقل قول من يرضي الرضيَّ فيعتلي","ودع قول من يصفي الصفيَّ فيسفل",4,"ل",1,0],["فقل قولَ يوسفَ لا تثربن","فقد يغفرُ الغافرُ الراحمُ",5,"م",1,0],["فقلقلت للسير الركاب وحبذا","لقاء كريم للمساوىء ساتر",6,"ر",1,0],["فَقُلْ قولَ غريطٍ أديب زمانهِ","وإلا فَدعْ ما ليس عشَّك واقعُدا",7,"د",2,0],["فَقُلْ قُبَيْلَ رَحيلٍ كيفَ نقتلهُ؟","وكيفَ ينفعُ في مِحْرابِنا الحَذَرُ؟",8,"ر",1,0]]}