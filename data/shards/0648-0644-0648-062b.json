{"poems":[[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"أبا حسن طال المطال ولم يكن","https://www.aldiwan.net/poem64051.html","الطويل"],[45,"عست دمن بالأبرقين خوال","https://www.aldiwan.net/poem65567.html","الكامل"],[75,"حلفت بالسابغات البيض واليلب","https://www.aldiwan.net/poem69102.html","البسيط"],[143,"لقد أدنت لك البلد السحيقا","https://www.aldiwan.net/poem11785.html","الوافر"],[186,"تظلم شرطي وغماز بابه","https://www.aldiwan.net/poem43261.html","الطويل"],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[337,"عفا بطن قو من سليمى فعالز","https://www.aldiwan.net/poem45428.html","الطويل"],[377,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[377,"هو الدهر إن تأمنه يخدعك صاحبه","https://www.aldiwan.net/poem66945.html","الطويل"],[453,"أجل ضربت لكم في غربتي المثلا","https://www.aldiwan.net/poem61603.html","البسيط"],[461,"أبا عمارة أن شطت منازلنا","https://www.aldiwan.net/poem15114.html","البسيط"]],"verses":[["ولو ثاب عقلي لم أدعْ ذكرَ بعضهِ","ولكنه من هولِهِ غيرُ ثائبِ",0,"ب",1,0],["ولو ثوِّبتْ تلك المدائحُ ألحِقتْ","بها أخريات للثواب شواكر",1,"ر",1,0],["وَلَو ثابَ لَي رَأيٌ لَكانَت صَريمَةٌ","أُوامِقُ مُختاراً بِها وَأُقالي",2,"ل",2,0],["ولوْ ثنَيْتَ إلى أرضِ الشآمِ يَداً","ألقَتْ إليك بأيدي الذل من كثَبِ",3,"ب",1,0],["وَلَو ثَبَتوا فُواقاً لِلمَواضي","وَلَم يَتَيَقَّنوا الخَبَرَ الصَدوقا",4,"ق",2,0],["ولو ثبت التقوى لبات مكرّما","وأصبح في عزّ مصانا مكرّما",5,"م",2,0],["وَلَو ثمَّ مِرآةٌ يرونَ نُفوسهم","بَها لَرأوها بينَ أهل النُهى ذرّا",6,"ر",2,0],["وَلَو ثبتَت فُرسانهُ عند أمرهِ","لتمّت لهُ لكنّهم خالَفوا الأمرا",7,"ر",2,0],["وَلَو ثَقِفاها ضُرِّجَت مِن دِمائِها","كَما جُلِّلَت فيها القِرامَ الرَجائِزُ",8,"ز",1,0],["ولو ثملوا من مائها ورحيقها","لما نكثوا باللَه يوماً وأخلفوا",9,"ف",3,0],["ولو ثاخ في يوم الكريهة والوغى","قنا ظُلمِه في لُبَّتي أو قواضبه",10,"ب",2,0],["ولوَّثتها من الأدرانِ أقذرها","وضاعَ في الوحلِ من خلنا به البطلاَ",11,"ل",2,0],["ولو ثنتْ عن وداد الشيء غَيبتهُ","لما أَضَرَّ بفرط الشوقِ يعقوبُ",12,"ب",1,0]]}