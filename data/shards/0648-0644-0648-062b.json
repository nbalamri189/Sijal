{"poems":[[53,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[53,"أبا حسن طال المطال ولم يكن","https://www.aldiwan.net/poem64051.html","الطويل"],[47,"عست دمن بالأبرقين خوال","https://www.aldiwan.net/poem65567.html","الكامل"],[77,"حلفت بالسابغات البيض واليلب","https://www.aldiwan.net/poem69102.html","البسيط"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[147,"لقد أدنت لك البلد السحيقا","https://www.aldiwan.net/poem11785.html","الوافر"],[190,"تظلم شرطي وغماز بابه","https://www.aldiwan.net/poem43261.html","الطويل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[342,"عفا بطن قو من سليمى فعالز","https://www.aldiwan.net/poem45428.html","الطويل"],[382,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[382,"هو الدهر إن تأمنه يخدعك صاحبه","https://www.aldiwan.net/poem66945.html","الطويل"],[458,"أجل ضربت لكم في غربتي المثلا","https://www.aldiwan.net/poem61603.html","البسيط"],[466,"أبا عمارة أن شطت منازلنا","https://www.aldiwan.net/poem15114.html","البسيط"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96370","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109337","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121621","الوافر"],[3411,"","https://poetry.dctabudhabi.ae/diwan/poem/79744","الطويل"],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5456,"ضجّة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=198751",""],[6239,"من خلف غبار الوهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75991&r=&rc=39",""]],"verses":[["ولو ثاب عقلي لم أدعْ ذكرَ بعضهِ","ولكنه من هولِهِ غيرُ ثائبِ",0,"ب",1,0],["ولو ثوِّبتْ تلك المدائحُ ألحِقتْ","بها أخريات للثواب شواكر",1,"ر",1,0],["وَلَو ثابَ لَي رَأيٌ لَكانَت صَريمَةٌ","أُوامِقُ مُختاراً بِها وَأُقالي",2,"ل",2,0],["ولوْ ثنَيْتَ إلى أرضِ الشآمِ يَداً","ألقَتْ إليك بأيدي الذل من كثَبِ",3,"ب",1,0],["ولو ثبتت رجلاك دون حدوده","لما كان عن رضوانه لك قاطع",4,"ع",1,0],["وَلَو ثَبَتوا فُواقاً لِلمَواضي","وَلَم يَتَيَقَّنوا الخَبَرَ الصَدوقا",5,"ق",2,0],["ولو ثبت التقوى لبات مكرّما","وأصبح في عزّ مصانا مكرّما",6,"م",2,0],["وَلَو ثمَّ مِرآةٌ يرونَ نُفوسهم","بَها لَرأوها بينَ أهل النُهى ذرّا",7,"ر",2,0],["وَلَو ثبتَت فُرسانهُ عند أمرهِ","لتمّت لهُ لكنّهم خالَفوا الأمرا",8,"ر",2,0],["وَلَو ثَقِفاها ضُرِّجَت مِن دِمائِها","كَما جُلِّلَت فيها القِرامَ الرَجائِزُ",9,"ز",1,0],["ولو ثملوا من مائها ورحيقها","لما نكثوا باللَه يوماً وأخلفوا",10,"ف",3,0],["ولو ثاخ في يوم الكريهة والوغى","قنا ظُلمِه في لُبَّتي أو قواضبه",11,"ب",2,0],["ولوَّثتها من الأدرانِ أقذرها","وضاعَ في الوحلِ من خلنا به البطلاَ",12,"ل",2,0],["ولو ثنتْ عن وداد الشيء غَيبتهُ","لما أَضَرَّ بفرط الشوقِ يعقوبُ",13,"ب",1,0],["ولو ثَوَّبَ الدّاعي بشَيبانَ زَعزَعَت","رماحٌ وجَاشَت من جوانِبِها القِدرُ",14,"ر",1,0],["ولو ثوى في غيابات اللحود وقد","حييتموه لأحيته التحيات",15,"ت",1,0],["ولوثة تغريب على غير ريبة","ولست بذي ذنب ولا سوء مخبر",16,"ر",1,0],["ولو ثَبَتُوا لَفَرَّ الْهامُ منهمْ","وأرْوَاحٌ لهم كانتْ كَمِينَا",17,"ن",2,0],["ولو ثَقِفَتْهُ بالكثيبِ خيولُهم","لأَوْدى كما أودى سُمَيْرٌ وحاطِبُ",18,"ب",1,0],["ولو ثلب الأعلام لم نحترم له","مقاماً ولول كان الحبيب المقدما",19,"م",2,0],["ولوثة في سماء البيت قاتمة","يخالط المسك فيها ريح كمبودي",20,"د",2,0],["ولوَّثَ الوطنُ المائيُّ كعبته","وماتزال جموعي رَهْنَ كعبتِها",21,"ت",3,0]]}