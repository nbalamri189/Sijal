"الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66149","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33465","البسيط"],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66879","البسيط"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99121","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120357","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141666","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120556","البسيط"],[4750,"ياوليفي دمعكم في غيابي ردّ لي","https://www.poetsgate.com/ViewPoem.aspx?id=180434",""],[4929,"إكمال على بيت ابي العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=202428",""],[4984,"التَّحَدِّي","https://www.poetsgate.com/ViewPoem.aspx?id=201089",""],[5052,"أتلفتُ حَوبائي","https://www.poetsgate.com/ViewPoem.aspx?id=205347",""],[5187,"تشرين","https://www.poetsgate.com/ViewPoem.aspx?id=29703",""],[5187,"وجيه في التسعين","https://www.poetsgate.com/ViewPoem.aspx?id=29067",""],[2365,"ذكرت شيب العذارين نوار","https://www.poetsgate.com/ViewPoem.aspx?id=200648",""],[5408,"ظلان أنت","https://www.poetsgate.com/ViewPoem.aspx?id=190583",""],[5431,"حول المذابح كم يطيب المرقصُ","https://www.poetsgate.com/ViewPoem.aspx?id=185558",""],[5463,"خل من راح يرحل بكره شوقه يجيبه","https://www.poetsgate.com/ViewPoem.aspx?id=27213",""],[5582,"أَسْيانُ نارُ غَرامِهِ تَتَسَعَّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187103",""],[5608,"الهنوف","https://www.poetsgate.com/ViewPoem.aspx?id=32911",""],[5634,"ما بعد جلق للمرتاد منزلة","https://www.poetsgate.com/ViewPoem.aspx?id=181465",""],[5715,"مَا بَعْدَ غُرْبَتِنَا . .","https://www.poetsgate.com/ViewPoem.aspx?id=187907",""],[5756,"الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=5184",""],[5790,"ما بعد بعدكم تصان دموع","https://www.poetsgate.com/ViewPoem.aspx?id=112069",""],[5908,"يا دار علوة حياك الحيا الهطل","https://www.poetsgate.com/ViewPoem.aspx?id=170977",""],[5956,"ما درَّ شعري هكذا لسواكما","https://www.poetsgate.com/ViewPoem.aspx?id=193703",""],[6093,"ما بَعدَ مكة َ والمدينةِ والتي","https://www.poetsgate.com/ViewPoem.aspx?id=179793",""],[6185,"يانفس !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87023&r=&rc=9",""],[6243,"بَرَدُ الشمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84435&r=&rc=9",""]],"verses":[["ما بَعدَ يَومِكَ ما يَسلو بِهِ السالي","وَمِثلُ يَومِكَ لَم يَخطُر عَلى بالي",0,"ل",2,1],["ما بعْدَ جنّاتِ العُلى منْ منْزِلٍ","إلاّ حِمَى عُمَرَ بنِ عبدِ اللهِ",1,"ه",1,0],["ما بَعد بُعدِك وَالصُدودِ عُقوبَةٌ","يا هاجِري قَد آنَ لي أَن تَغفِرا",2,"ر",2,0],["ما بعد يومك في المواسم بعدما","أَتْبَعْتَ عيد الفطر أكرمَ موسمِ",3,"م",1,0],["ما بعبد المحسن السعدون إذ","رام قتل النفس مسّ وخبال",4,"ل",1,0],["ما بعد غيثك غيثٌ يستفادُ ولا","من بعدِ إثبات قولِي فيكَ إثبات",5,"ت",1,0],["ما بعد علياه ركنٌ أسْتجير بهِ","من الخطوبِ ولا بحرٌ أجاوره",6,"ر",2,0],["ما بعد دُرّ معانيها وصنعته","برسمِ جودك عند الفكرِ مدخور",7,"ر",1,0],["ما بعد ديمتك الرويّة ديمة","يشكو لها ظمأً ذوو الإقلال",8,"ل",1,0],["ما بعد علياك يحيي واصفٌ كَلِماً","وليت لو وسعت أوصافك الكلم",9,"م",1,0],["ما بعد وعظيَ ما تُوعَى العِظاتُ له","ولا مواقعُ صَوْلاتي بتدريبِ",10,"ب",1,0],["ما بعدكم من يزيد في عداوته","آلَ النبي وقتل السادة الغرر",11,"ر",1,0],["ما بعد بيضاءَ أو صهباءَ صافيةٍ","فَرْعٌ يُرَبُّ ولا صفراء تكتنز",12,"ز",1,0],["ما بعدَ يومِكَ للحزينِ الموجَعِ","غيرُ العويل وأنَّةُ المتفَجِّعِ",13,"ع",1,1],["ما بِعَيني هَذا الغَزالِ الغَريرِ","مِن فُتونٍ مُستَجلَبٍ مِن فُتورِ",14,"ر",1,1],["ما بَعدَ جودِكَ لَولا ما يُجاوِرُهُ","بِسُرَّ مَن راءَ مِن جَهلٍ وَمِن بَخَلِ",15,"ل",1,0],["ما بَعُدَتْ للعَلاءِ مَنزِلَةٌ","إلاَّ أرتْهُ بُعادَها صُعُدا",16,"د",2,0],["ما بَعدَ بَغدادَ لِلنُفوسِ هَوىً","رَقَّ هَواها وَراقَ مَنظَرُها",17,"ه",2,1],["ما بَعد غَمّك غَير يو","م تطمئن بِهِ القُلوب",18,"ب",1,0],["ما بَعْدَ آياتِهِ حَقٌّ لِمُتَّبِعٍ","والحَقُّ ما بَعدَهُ إِلَّا الأباطِيلُ",19,"ل",1,0],["ما بَعْدَ ذَيْنٍ سِوى الحِمامِ وإنّني","لإخالُ أنّ الهَجْرَ فيه طَويل",20,"ل",1,0],["ما بعدَ صَنعاءَ كانَ يَعمُرُها","ساداُ مُلكٍ جَزلٌ مَواهِبُها",21,"ب",3,0],["مابَعدَ فَقدِكَ في أَهلٍ وَلا وَلَدٍ","وَلا حَياةٍ وَلا دُنيا لَنا أَمَلُ",22,"ل",1,0],["ما بَعْدَ تَقويمِ النُفوسِ سَعادةٌ","أو بعد مَحْوِ جَهالةِ الجُهَّالِ",23,"ل",1,0],["ما بعدَ يومك غيرُ عينٍ ثَرّة","ومدامعٍ سُحٍّ وحِلْمٍ تائه",24,"ا",3,0],["ما بَعدَ صَنعاءَ كانَ يَعمُرُها","وُلاةُ مُلكٍ جَزلٌ مَواهِبُها",25,"ب",3,0],["ما بعد جنات النخيل","مسرة للناظرين",26,"ن",1,0],["ما بَعدَ قَولِ مَليكِ الأَرضِ كَيفَ أَخي","مِن مَطلَبٍ دونَهُ مَطلٌ وَلا عِلَلُ",27,"ل",1,0],["ما بعد امريكا واقيانوسها","في البر أو في البحر هول يشهدُ",28,"د",1,0],["ما بعيني بكيت بل بفؤادي","ليس دمع القلوب مما يعاب",29,"ب",1,0],["ما بَعدَ ما بِيَ مِن بُؤسٍ وَمَسكَنَةٍ","ضُرٌّ يَحارُ لَهُ الأَجراحُ وَالنَقَمُ",30,"م",1,0],["ما بِعتُكُم مُرخِصاً ما عَنَّ مِن عُمُري","إِلّا لِأَنِّيَ مُحتاجٌ إِلى الثَمَنِ",31,"ن",1,1],["مَا بَعْدَ مَدْحِ اللهِ جَلَّ جَلاَلُهُ","مَدْحٌ لِمَنْ خَفَضَ الْعُلاُ وَعَلاَهَا",32,"ا",3,0],["ما بَعد كونكَ قد خُلقت لأجلهِ","في أحسنِ التقويمِ خلقٌ أبدعُ",33,"ع",1,0],["ما بَعد ما يُثني بهِ عَن نفسهِ","بِفعاله إلّا فعالُ مقصّرِ",34,"ر",1,0],["مَا بَعْدَ قُرْبِكَ لِلآمَالِ مُنْتَزَحُ","ولا علَى الدَّهْرِ بَعْدَ اليَوْمِ مُقْتَرَحُ",35,"ح",1,1],["مَا بَعْدَهُ غَايَةٌ يَاموْتُ تَطْلُبُها","وَصَلْتَ لِلشُّهْبِ فى تَرْقَاكَ فاتئِدِ",36,"د",1,0],["ما بَعد مَبسَمِكَ الَّذي","قَد همت فيهِ مَبسَم",37,"م",1,0],["ما بِعتُكم مهجَتي إلا بِوصلِكُم","ولا أُسلِّمُها إلا يداً بيَدِ",38,"د",1,0],["ما بعَّدَ الموتَ قِلُّ وجْدٍ","عنّي ولَمْ يَنْقُصِ الغرامُ",39,"م",1,1],["ما بَعدَ يَومِكَ من لقاءٍ يُرتَجى","أو يَلتقي جُنحُ الدّجَى ونَهارُهُ",40,"ر",2,0],["ما بعد صاحب هذا القبر من أحَدٍ","يُرجى الخيرُ أو يُدْعى إلى الجود",41,"د",1,0],["ما بعد رامة للمشتاق من إرب","فاحبس بها فإليها منتهى طلبي",42,"ب",2,1],["ما بعدَ يومِك سلوةٌ لمعلَّلِ","منّي ولا ظفرتْ بسمعِ معذَّلِ",43,"ل",1,1],["مابعد لقياك للعافين من أملِ","ملك الملوكِ وهذي دولةُ الدولِ",44,"ل",1,1],["ما بَعد ذَلِكَ مَطلب لِمحقق","مِنهُ اِستَمَد فَكانَ مِن خلفائِهِ",45,"ا",3,0],["ما بَعْدَ ذَا التَّصِريحِ في","كَشْفِ الْمُرادِ قَفُلْ وبَادِرْ",46,"ر",1,0],["ما بعث الواشي إلى","ما نحن فيه ظِنَنَهْ",47,"ن",2,0],["ما بَعدَهُ جَوادٌ","لِجودِهِ يُرتادُ",48,"د",1,0],["ما بَعدَ أَنّي مُرهَقٌ مَبهوتُ","لا آخُذُ النِصفَ وَلا أَفوتُ",49,"ت",1,0],["ما بعد هذا غير شيء معدم","فيه جميع السالكين تحير",50,"ر",1,0],["ما بَعدهم غايَة يا موت تطلبها","بلغتَ في الأُفق المرَقى فَلا تَطِرِ",51,"ر",1,0],["مابَعَّد الرَّاحَ عَن عَلياءِ حَضْرتهِ","شَيءٌ سوى أنَّها قَدْ خانَها الأدبُ",52,"ب",1,0],["ما بعته إلا المودة حرة","ولك الجزاء بها وربح الشاري",53,"ر",2,0],["ما بعد الرزق على مقتر","ناداك إلا ودنا واقترب",54,"ب",1,0],["مَا بَعْدَ دِيمَتِكَ الرَّوِيَّةِ دِيمَةٌ","بَشْكُو لَهَا ظَمَأ لِسَانُ المُقْتِرِ",55,"ر",1,0],["ما بَعَثَ المَرءُ في حَوائِجِهِ","أَنجَحَ مِن دِرهَمٍ وَدينارِ",56,"ر",1,1],["ما بِعَيني قروح إِنَّما","طَرفي الباكي عَلَيكُم رعفا",57,"ا",1,0],["ما بعد مجدك للآمال مطرح","وليس بعدك في الأمجاد منتظر",58,"ر",1,0],["ما بعد فرقة بيننا أبداً","في لذة درك لملتمس",59,"س",1,0],["ما بَعدَ ظِلِّكِ لِي مَقِيلٌ فَاِعلَمي","كَلّا وَلا لي بَعدَ مائِكِ مَشرَبُ",60,"ب",1,0],["ما بعد دمعي دمعٌ يُراقُ ولا","فوقَ عذابي لدَيْك تَعْذيبُ",61,"ب",1,0],["ما بعد فُرقتنا لقاءٌ يُرتجى","هيهات ليس ليوم فرقتنا غدُ",62,"د",1,0],["ما بعد بعدك للنهار وضوحٌ","فيطوف ساقٍ أو يطيب صبوح",63,"ح",1,1],["ما بعدهم يا جنة الد","نيا جنانك خاويه",64,"ي",2,0],["مَا بَعدَ عِلمِكَ بالخصُومَةِ فَيصَلٌ","إنْ خِيفَ في الإشْهادِ زُورُ المُشْهَدِ",65,"د",1,0],["ما بعد شيبك لو عقلت سوى الفنا","والموتُ مالك عنه من ملجاءِ",66,"ا",2,0],["ما بعدَ منطقِهِ وَشيءٌ ولا زَهَرٌ","ولا لأَعلاقِ ذاكَ الدُّرِّ من ثَمنِ",67,"ن",1,0],["ما بَعدَ جِلَّقَ لِلغَرامِ مَرَامُ","وَغَيرُها وَطَنٌ عليَّ حَرَامُ",68,"م",1,1],["ما بعد جودك للراجين من أمل","ولا ورائك للاجين من حرم",69,"م",1,0],["ما بعد يوم ابن النبي","سوى المدامع والسهاد",70,"د",1,0],["ما بعد هتكك يا بنات محمد","في الدهر هتك مصونة من عار",71,"ر",1,0],["ما بعد كاظمة وبرقة ثَهْمَد","مرمىً تروح له المطيّ وتغتدي",72,"د",2,1],["ما بعدكم يا بني أيوب منتَجَعٌ","لطالب الرزق يستعدى على الزمن",73,"ن",1,0],["ما بعدَه شيء سوى مطلوبِنا","ربُّ الأنام مع اسمِه الغفَّار",74,"ر",1,0],["مَا بَعدَ تِبيَانِ الرَّسُولِ لنَاظِرٍ","إلاَّ العَمَى وَالعيبُ فِي العُميَانِ",75,"ن",1,0],["ما بعد ذا والله للايمان حب","ة خردل يا ناصر الايمان",75,"ن",1,0],["ما بعد وخط الشيب من غزل","فانبذ عهود الوصل والصدّ",76,"د",1,0],["ما بعتكَ الروحَ لاّ كي تُواصلني","فكيفَ تملكها في حال هُجراني",77,"ن",2,0],["ما بَعدَ سوحِكَ للاجينَ مُعْتمداً","يا ابن الحسين للاجين مُعْتصَمُ",78,"م",1,0],["ما بَعدهُ بغية يَرجى لذي أَمل","يَوماً وَلا نجعة تَبقى وَمستمع",79,"ع",1,0],["ما بَعد وضع أَبي الهادي بحفرته","وجه نقول به يا أَزمة ارتفعي",79,"ع",2,0],["ما بعت نفسك لما لم تجد ثمناً","إلا بظل جوار الواحد الأحد",80,"د",1,0],["ما بَعدَهُم سافلُ يا فطينا","إلاَّ أزاديوا وَقندَرِينَا",81,"ن",2,0],["ما بَعدَها جزائرٌ مَعموره","أمَّا الخراباتُ فَهي كَثيرَه",82,"ه",1,0],["مَا بَعدَهُم سِوى جَزيرَة وَازَه","وَلاَ جَنُوبِيهَا أحَد قَد جَازَا",83,"ز",2,0],["ما بعد طيف خيال ظل خيالها","يوما ولا نوما يراد سهاد",84,"د",1,0],["ما بعد إذ نزلوا إلاَّ التي رجفت","منها قلوب أولي الطغيان والسرف",85,"ف",1,0],["ما بعد هذا العار من عار ولا","يغضي عليه غير نكس صاغر",86,"ر",1,0],["ما بِعْتُ فيك الخلْق حتى زُرْتُهم","فعلمتُ أضنك فوقهم متيقنا",87,"ن",2,0],["ما بعد محياك للمهدي محبرة","لمن ينير ويسدي بعك الحبرا",88,"ر",2,0],["ما بعد موقفنا بذات الضال","الا العُلالة بادّكار خيال",89,"ل",1,1],["ما بعت روحي في هواه رخيصةً","إلّا يكون عذاره من غاليه",90,"ي",2,0],["ما بعد أوصاف الأكرادي من صفة","لها من الحال في التشبيه تمثيل",91,"ل",1,0],["ما بعد اخلاقه في الخلق من خلق","اجماله لنسيم الروض تفصيل",91,"ل",1,0],["ما بعد آلائه للناس من منح","فيها شمول به للكل تظليل",91,"ل",1,0],["ما بعد أفكاره للرشد ملتجاء","لكل علم به في النفع تسهيل",91,"ل",1,0],["ما بعد آرائه في العلم معجزة","مصداقها لدليل الحق موكول",91,"ل",1,0],["ما بعد يومك في صرف الردى خطر","قضى الندى والتقى والعلم والخطر",92,"ر",1,1],["ما بعته روحي سوى بوصاله","وأراه يمنعني المثمن والثمن",93,"ن",1,0],["ما بعدَ أَهلكَ ينحرونَ بها","كالبُدنِ يومَ صبيحةِ النحْرِ",94,"ر",1,0],["ما بعدَ شيبِ المرءِ تج