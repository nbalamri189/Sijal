{"poems":[[93,"شهور العام أجملها ربيع","https://www.aldiwan.net/poem8810.html","عموديه"],[91,"فيك المدائح تحلو","https://www.aldiwan.net/poem44969.html","المجتث"],[63,"لهفي على القمر الذي","https://www.aldiwan.net/poem51338.html","مجزوء الكامل"],[82,"صب يذوب إلى لقاء مذيبه","https://www.aldiwan.net/poem31568.html","الكامل"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20985","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54639","الكامل"],[93,"يّها الراعي","https://www.poetsgate.com/ViewPoem.aspx?id=53026",""],[20,"لم أر مثل الفتيان في غبن ال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69760&r=&rc=1",""],[190,"عابوه إذ نبت العذار بخده","https://www.aldiwan.net/poem43960.html","الكامل"],[202,"سفرت وريعان التبلج مسفر","https://www.aldiwan.net/poem51949.html","الكامل"],[275,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[276,"خطرت كغصن البانة المتأود","https://www.aldiwan.net/poem52072.html","الكامل"],[287,"تظلموا وهم عقوا وهم ظلموا","https://www.aldiwan.net/poem32460.html","البسيط"],[287,"في خد من أهواه خير طراز","https://www.aldiwan.net/poem32740.html","الكامل"],[287,"لئن نأت بعد قرب منكم الدار","https://www.aldiwan.net/poem32761.html","البسيط"],[333,"ملأت بالدمع كأسي","https://www.aldiwan.net/poem54927.html","المجتث"],[358,"عذار سعد الدين لما بدا","https://www.aldiwan.net/poem39984.html","السريع"],[373,"ما قلت هيج عينه لبكائها","https://www.aldiwan.net/poem1884.html","الكامل"],[382,"أيدري الدهر أيم الله أني","https://www.aldiwan.net/poem59430.html","الكامل"],[416,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[422,"هاج القرام وهيجا بلبالي","https://www.aldiwan.net/poem54163.html","الكامل"],[466,"لمعت كتلويح الرداء المسبل","https://www.aldiwan.net/poem15089.html","الكامل"],[556,"هي الدار موقوف عليك بكاها","https://www.aldiwan.net/poem47143.html","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137629",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64178","الكامل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202069","الرجز"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80212","الكامل"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28337","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109052","المجتث"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110291","المجتث"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109458","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77334","البسيط"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82177","الكامل"],[445,"","https://poetry.dctabudhabi.ae/diwan/poem/48099","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205725","الكامل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18811","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120450","الطويل"],[382,"","https://poetry.dctabudhabi.ae/diwan/poem/112010","الوافر"],[4478,"يا أحسنَ النّاس لولا أنّ نائلها","https://www.poetsgate.com/ViewPoem.aspx?id=15117",""],[4442,"فتح الله للحقيقة بابا","https://www.poetsgate.com/ViewPoem.aspx?id=170992",""]],"verses":[["فَكانَ حَزَأُنا أَن قُمتَ فينا","تُعَلِّمُنا القَطيعَة وَالبُعادا",0,"د",2,0],["فكان حينئذٍ في","كبر له عنك شغل",1,"ل",1,0],["فكأن حسنك لم يكن","وكأن قبحك لم يزل",2,"ل",1,0],["فكأنّ حِدّةَ طَرْفِهِ وفؤادِهِ","من أُذْنِهِ نُقلتْ إلى عرقوبهِ",3,"ب",2,0],["فكان حُماتُهم حرباً عليهم","وكانوا الفاتحين الكاذبينا",4,"ن",2,0],["فكانَ حشداً يا لهُ من حَشدِ","من كل حُرٍّ عندنا وعبدِ",5,"د",1,0],["فكانَ حَظُّ العَروسِ إذ بَرقَ أل","صُّبحُ دِماءً تَجري سَبائبُها",6,"ب",3,0],["فَكَأَنَّ حَوْلَ النَّعْشِ بَحْراً مَائِجاً","وَكَأَنَّهُ فُلْكٌ يَشُقُّ عُبَابَا",7,"ب",2,0],["فكان حزاؤنا أن قمت فينا","لاتعلّمنا القطيعة والبعادا",8,"د",2,0],["فَكانَ حَظُّ العَروسِ إِذ جَشَر الْ","صُبحُ دِماءً تَجري سَبائِبُها",9,"ب",3,0],["فكأن حمرة خدّه وبياضه","وسواد شعر عذاره في خدّه",10,"د",2,0],["فكأن حبركَ أحمرٌ لا أسودٌ","ويراعُ كفِّكَ أسمرٌ لا أصفر",11,"ر",1,0],["فكان حِداداً في الرّزايا سَوادُها","وخِضرتُها فيها الرّجاء المفاغِم",12,"م",1,0],["فكأن حالية المحاسن صوّرت","من فضة عجنت بماء العسجد",13,"د",1,0],["فَكانَ حَظُّهُمُ مِن حَربِهِ نِقَماً","وَحَظُّهُ أَبَداً مِن رَبِّهِ نِعَمُ",14,"م",1,0],["فَكَأَنَّ حاجِبَهُ الَّذي مِنهُ رَمى","قَوسٌ بَرَتهُ يَدُ المُجاهِدِ غازي",15,"ز",2,0],["فَكانَ حَبراً وَبَحراً في السُؤالِ وَفي ال","جَوابِ وَالأُنمُلاتُ الخَمسُ أَنهارُ",16,"ر",1,0],["فكان حبّك أقوى","من كل ما أبتغيه",17,"ه",1,0],["فَكانَ حرزاً وَوقاءً مِن ال","عين وَلَو جاءت بسحر حَلال",18,"ل",1,0],["فكأَنَّ حَبَّةَ فُلْفُلٍ في عينِهِ","ما بَيْنَ مُصْبَحِها إلى إِمْسائِها",19,"ا",3,0],["فكان حِلاؤه زوراً ومكراً","وكان رِداؤه خُبثاً وغَدرا",20,"ر",2,0],["فَكَأَنَّ حَشوَ ثِيابِهِم هِندِيَّةٌ","نَحَلَت وَأَغفَلَتِ العُيونُ صَقالَها",21,"ل",3,0],["فكأنَّ حدَّة عزمه صمصامه ال","ماضي وفيصل عضبه الفصَّال",22,"ل",1,0],["فكأن حربهم أوارُ ضريمةٍ","بالقاع أو بأس الوزير أبي علي",23,"ل",2,0],["فكان حنينَ المُهْجَساتِ رُعودُها","وصوبَ دموعِ النّاشجين حَياها",24,"ا",3,0],["فكان حدوث التزلزل حتما","فلا عجب من حدوث الأذى",25,"ذ",2,0],["فكأن حمرةَ ورده من راحه","وكأن نكهة راحِهِ من ورده",26,"د",2,0],["فَكأن حيناً لم يكن مَسْتوْلِيا","يا منْ غَداَ عن الهُدى مُوَليِّا",27,"ي",2,0],["فَكَأنَّ حَر الوَجد لاعب زَهرَها","عِندَ الصَبوح فَهبَّ فيهِ مَحيلا",28,"ل",2,0],["فَكانَ حِبائي إِذ أَنَختُ بِبابِهِ","حجولٌ وَأَحراسٌ وَصَعبٌ مَراتِبُه",29,"ب",2,0],["فكانَ حظ دواتي","والحبر كسراً وصبَّا",30,"ب",2,0],["فَكانَ حَتفاً بِمِقدارٍ وَأَدرَكَها","طولُ النَهارِ وَلَيلٌ غَيرُ مُنصَرِمِ",31,"م",1,0],["فكان حظي سعيداً","نظير حظ سعيد",32,"د",1,0],["فكان حقاً علينا أن يصاغ له","من الهناء بهذا العرس واجبه",33,"ب",2,0],["فَكانَ حاميِمُ يَتلوها فَتَجرِفُهُم","كَالسَيلِ طَبَّقَ مِن مُستَشرفِ الأَكَمِ",34,"م",1,0],["فكأن حل المال عندهم","حجر وحب مصونه بغض",35,"ض",1,0],["فكأَنَّ حَدَّ سنانِهِ من بَأْسِهِ","وكأَنَّ صَفْحَةَ سيفِهِ من حِلْمِهِ",36,"م",2,0],["فكأنَّ حبِّي كان عندي كله","رهنًا بحسنك مبدأ ومآلا",37,"ل",2,0],["فَكانَ حَظُّكَ مِنها نَظرَةً طَرَفَت","إِنسانَ عَينِكَ حَتّى ما بِها نَظَرُ",38,"ر",1,0],["فكان حييا منهم ان يراهم","فيطرق عند الخطو خطو المكبل",39,"ل",1,0],["فكان حلولُ مولانا ثراها","لأمرٍ يُعقبُ الخوفَ القرار",40,"ر",1,0],["فكان حظّكَ منها نظرة ً طرفت","إنسان عينك حتّى ما بها نضرُ",41,"ر",1,0],["فكان حين ساورته الرزايا","كان بوابه الأمام الرازي",42,"ز",2,0]]}