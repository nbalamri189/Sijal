3",""],[5431,"أحب الذقن...","https://www.poetsgate.com/ViewPoem.aspx?id=200144",""],[5431,"هكذا تكلمت ريمادشت...","https://www.poetsgate.com/ViewPoem.aspx?id=202692",""],[5455,"سالفة عشاق","https://www.poetsgate.com/ViewPoem.aspx?id=34372",""],[709,"إِلَى اللهِ نَشْكُو فَادِحَاتِ النَّوَائِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=2959",""],[5582,"أَفْراحُ أَهْلِ الهَوَى فِي الهَجْرِ أَحْزانُ","https://www.poetsgate.com/ViewPoem.aspx?id=187308",""],[243,"العش المهجور","https://www.poetsgate.com/ViewPoem.aspx?id=50479",""],[5660,"كان قلبي يوم مجروح * موال*","https://www.poetsgate.com/ViewPoem.aspx?id=24828",""],[5691,"بوم وغربان","https://www.poetsgate.com/ViewPoem.aspx?id=205929",""],[5809,"غرابيل","https://www.poetsgate.com/ViewPoem.aspx?id=205578",""],[5851,"عودة الهزار","https://www.poetsgate.com/ViewPoem.aspx?id=175281",""],[5866,"قال من لا يعجزه نظم الحروف الابجدية","https://www.poetsgate.com/ViewPoem.aspx?id=182872",""],[5956,"التوازن","https://www.poetsgate.com/ViewPoem.aspx?id=182166",""],[5992,"كأنَّ قبابَ القطر من فوق مائِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=41838",""],[6024,"قوس الحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=186344",""],[6031,"أَمَا لفراقِنا هذا اجتماعُ","https://www.poetsgate.com/ViewPoem.aspx?id=46298",""],[6056,"شمس حبي","https://www.poetsgate.com/ViewPoem.aspx?id=130140",""],[6093,"يا جاثياً في رسُوم الحيِّ معتكفا (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176186",""],[6125,"مَتَىٰ يَا لَيلُ تَشرَعُ بالفِرَاقِ","https://www.poetsgate.com/ViewPoem.aspx?id=207932",""],[6125,"بكل نقيصةٍ في الحب جاؤوا","https://www.poetsgate.com/ViewPoem.aspx?id=209069",""],[6223,"أعتقيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1205&r=&rc=12",""],[6260,"ذكرى الهجرة النبوية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68351&r=&rc=43",""],[6279,"هِيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78807&r=&rc=25",""]],"verses":[["كَأَنَّ قَواني أَنماطِها","قُطوعُ رِياضٍ مِنَ الطَلِّ تَنَدى",0,"د",2,0],["كانَ قَلبي إِلَيهِ رائِدَ عَيني","فَعَلى العَينِ مِنَّةٌ لِلقَلبِ",1,"ب",1,0],["كانَ قَضاءُ الإِلَهِ مَكتوباً","لَولاكَ كانَ العَزاءُ مَغلوبا",2,"ب",2,1],["كَأَنَّ قَلبِيَ يَومَ البَينِ طارَ بِهِ","مِنَ الرِفاعِ نَجيبُ الساقِ عَدّاءُ",3,"ا",2,0],["كَأَنْ قَدْ صَحَّ لِلَّهِ انْقِطَاعِي","بِتَأمِيلِي جَنَابَك وَارْتِحَالِي",4,"ل",2,0],["كَأَنَّ قُتودَها بِعُنَيبِساتٍ","تَعَطَّفَهُنَّ ذو جُدَدٍ فَريدِ",5,"د",1,0],["كَأَنَّ قَرارَ الكَهرَباءِ بِشِقِّهِ","يُريكَ سَناهُ أَيسَرُ اللَمَساتِ",6,"ت",1,0],["كَأَنَّ قَضاءَ الواجِباتِ مُحَرَّجٌ","تَقَبُّلُهُ إِلّا بِأَن تَتَطَوَّعا",7,"ع",2,0],["كَأَنَّ قُلوبَ الطَيرِ رَطباً وَيابِس","لَدى وَكرِها العُنّابُ وَالحَشَفُ البالي",8,"ل",2,0],["كأَنَّ قَطِيرَ البَانِ في عُكنَاتِهَ","عَلَى مُنثَنىً والمَنكِبينِ عَطَى رَطِل",9,"ل",1,0],["كَأَنَّ قُتودَ الرَحلِ مِنها تُبينُها","قُرونٌ تَحَنَّت في جَماجِمِ أَبدُنِ",10,"ن",1,0],["كَأَنَّ قَد بَدا لَكَ بَعدَ مُكثٍ","وَطولِ إِقامَةٍ فينا رَحيلُ",11,"ل",1,0],["كَأَنَّ قَنا المِرّانِ تَحتَ خُدورِها","ظِباءُ المُلا نِيطَت عَليها الوَشائِحُ",12,"ح",1,0],["كَانَ قَوْمُ أَحَبَّهُمْ وَأَحَبُّوهُ","وَصَانَ العَهْدَ الوَثِيقَ وَصانُوا",13,"ن",3,0],["كَأَنَّ قَرا جَرعائِها رَجَّعَت بِهِ","يَهودِيَّةُ الأَقلامِ وَحيَ الرَسائِلِ",14,"ل",1,0],["كَأَنَّ قُلوبَ القَومِ مِن وَجَلٍ بِها","هَوَت في خَوافي مُطعِماتٍ لَوامِعِ",15,"ع",1,0],["كَأَنَّ قُتودي فَوقَها عُشُّ طائِرٍ","عَلى لينَة سَوقَاءَ تَهفو جُنوبُها",16,"ب",3,0],["كأنْ قد رأت نهر المجرّة ناضباً","فرامت بأن تُجري إليه السَّواقيا",17,"ي",2,0],["كَأَنَّ قَتودي فَوقَ جَأبٍ مُطَرَّدٍ","يُفِزُّ نَحوصاً بِالبَراعيمِ حائِلا",18,"ل",2,0],["كأن قوائمَ العرشِ استحالتْ","قوائمها بمعترك الأيور",19,"ر",1,0],["كأن قراها والفروز التي به","وإن لم تجدها العين إلا تتبعا",20,"ع",2,0],["كأن قد دسعتم بالخبيث ولم تزل","لكم دَسَعاتٌ لا يُسقَّى دسوعها",21,"ع",3,0],["كأن قسطلها والزرقُ ناجمةٌ","ليلٌ عليه سماءٌ ذاتُ إنجامِ",22,"م",1,0],["كان قِدْماً يَمُصُّ أيْرَ أبيه","ويُطيل الصدودَ عن ثدْي أُمِّهْ",23,"ه",1,0],["كَأَنَّ قَلبي غَداةَ البَينِ مُقتَسَمٌ","طارَت بِهِ عُصَبٌ شَتّى لِأَمصارِ",24,"ر",1,0],["كَأَنَّ قُتودَ الرَحلِ فَوقَ مُصَدَّرٍ","تَرعى قِفافَ الأَنعَمَينِ فَعاقِلا",25,"ل",2,0],["كَأَنَّ قَوسَ السَحابِ باتَ عَلى","جِسمي رِداءً وَما أَنا الأُفُقُ",26,"ق",1,0],["كانَ قَلبي مُستَريحاً","مِن هَواكُم ما أَرَحتُهُ",27,"ت",2,0],["كأن قلبي بركان به انحبست","نيرانه مع ما فيه من الحمم",28,"م",1,0],["كَأَنَّ قُدّامِيَ أَلفَ ديكِ","تَسأَلُني عَن دَمِها المَسفوكِ",29,"ك",1,0],["كأنَّ قَلْبي إِذا تَذَكّرَها","فَريسةٌ بَيْنَ ساعِدَيْ أَسَدِ",30,"د",1,1],["كأنَّ قافاً أُدِيرَتْ فوقَ وَجْنَتِهِ","واخْتَطَّ كاتِبُهَا مِنْ فَوْقِها أَلِفَا",31,"ف",2,0],["كانَ قُبحُ الوَجهِ يُجزينا فَقَد","زادَنا مَلعوناً قُبحَ الخُلُق",32,"ق",1,0],["كَأَنَّ قُطامِيّاً عَلى الرَحلِ طاوِياً","إِذا غَمرَةُ الظَلماءِ عَنهُ تَجَلَّتِ",33,"ت",1,0],["كأن قواريره أفرخ","طوال المناقير خضر الجسوم",34,"م",1,0],["كأنَّ قَوافيها سهامُ مثقِّفٍ","تصعَّدَ فيها لحظُه وتصوَّبا",35,"ب",2,0],["كَأَن قَد عَجَّلَ الأَقوامُ غَسلَك","وَقامَ الناسُ يَبتَدِرونَ حَملَك",36,"ك",1,1],["كَأَن قَد صِرتُ مُنفَرِداً وَحيداً","وَمُرتَهَناً هُناكَ بِما لَدَيّا",37,"ي",2,0],["كأن قلوبَنَا خُلِقَت لأمرٍ","فمذ أبصرنَ من نهوى نسينَا",38,"ن",2,0],["كأنّ قطافَ اللثم من ثَغْرِ رَوْضِهِ","تَكَسّبَ من طَلّ الغمامِ رضابا",39,"ب",2,0],["كأنّ قذالي بالقتير مُعَوَّضٌ","قبيلةَ سامٍ منْ قبيلةِ حامِ",40,"م",1,0],["كأنّ قسيّاً في مواخرها الّتي","يُفَوَّقُ منها في المقادم أَسهُمُ",41,"م",1,0],["كانَ قَصدي عِندَها في قَولِهِم","أَن أَكونَ المُكرَمَ المُتَّبَعا",42,"ع",2,0],["كَأَنَّ قُرُنفُلاً وَسَحيقَ مِسكٍ","وَصَوبَ الغادِياتِ شَمِلنَ فاها",43,"ا",3,0],["كَأَنَّ قَوادِمَ القُمرِيِّ فيهِ","عَلى رَجَوَي مَراكِضِها الأُجونِ",44,"ن",1,0],["كأنّ قَنَاهَا المُلْدَ وهي خَوافِقٌ","قُدُودُ المَها في كلّ رَيْطٍ مُسَهَّم",45,"م",1,0],["كأنْ قد كشَفْتَ الأمرَ عن شُبُهاتِهِ","فلم يُضْطَهَدْ حَقٌّ ولم يُتَهَضّم",45,"م",1,0],["كأنّ قُدامَى النَّسرِ والنَّسرُ واقعٌ","قُصِصْنَ فلم تَسْمُ الخَوافي به ضعفا",46,"ف",2,0],["كأنّ قَطا فوق أكفالها","إذا ما سَرَينَ يُثِرْنَ القَطا",47,"ا",1,0],["كَأَنَّ قَرقَرَةَ الإِبريقِ بَينَهُمُ","رَجعُ المَزاميرِ أَو تَرجيعُ فَأفاءِ",48,"ا",2,0],["كَأَنَّ قُلوبَهُنَّ بِكُلِّ شَخصٍ","مُنَفَّرَةٌ وَلَيسَ بِها نِفارُ",49,"ر",1,0],["كَأَنَّ قَولي لَهُ تَنَحَّ فَإِنّي","رَجُلٌ مِن صَلاةِ أَهلِ السَوادِ",50,"د",1,0],["كَأَنَّ قَلبي إِذا ذِكراكُمُ عَرَضَت","مِن سِحرِ هاروتَ أَو ماروتَ في عُقَدِ",51,"د",1,0],["كَأَنَّ قُصوى أُكمِها تُسَدّي","لا بَل تُصَلّي تارَةً وَتَردي",52,"د",2,0],["كانَ قَد نامَ عَن أَذاكَ فَآدَي","تَ عَلى رَأسِهِ فَذُق ما صَنَعتا",53,"ت",2,0],["كَأَن قَد فِقتُ مِن وَجدٍ","بِها يَوماً فَقَضَّيتُ",54,"ت",1,0],["كَأَنَّ قَلبي بِبَقايا الهَوى","مُعَلَّقٌ بَينَ خَوافي عُقاب",55,"ب",1,0],["كَأَنَّ قَرقَرَةَ الإِبريقِ بَينَهُمُ","صَوتُ المَزاميرِ أَو تَرجيعُ فَأفاءِ",56,"ا",2,1],["كَأَنَّ قُتودي وَالنُسوعُ جَرى بِها","مِصَكٌ يُباري الجَونَ جَأبٌ مُعَقرَبُ",57,"ب",1,1],["كَأَنَّ قُلوبَ القَومِ مِنّا جَنادِلٌ","فَلَيسَ لَها عِندَ الأُمورِ حَصاةُ",58,"ص",3,1],["كَأَن قَد حَوَتهُم لَعنَةٌ مِن مَليكِهِم","وَمَن لَم يُطِع مَولاهُ فَهوَ لَعينُ",59,"ن",1,0],["كأنّ قَطاةَ أعْجَزِهَا قَطاةٌ","أُديفَ بمَحْجِرَيها الزّعْفرانُ",60,"ن",1,0],["كَأَنَّ قُرونَ الشَمسِ عِندَ اِرتِفاعِها","وَقَد صادَفَت طَلقاً مِنَ النَجمِ أَعزَلا",61,"ل",2,0],["كَأَنَّ قُتودي فَوقَ جَأبٍ مُطَرَّدٍ","رَأى عانَةً تَهوي فَوَلّى مُواشِكا",62,"ك",2,0],["كَأَنَّ قَطا العَينِ الذَّي خَلفَ ضارِحٍ","جِلابُ لَغاً أَصواتُها حينَ تَقرَبُ",63,"ب",1,1],["كَأَنَّ قَطاتَها كَردُوسُ فَحلٍ","مُقلَّصَةٌ عَلى سَاقي ظلِيمِ",64,"م",1,1],["كَأَنَّ قَذىً بالعَينِ قَد مَرِحَت بِهِ","وَما حاجَةُ الأُخرى إِلى المَرَحانِ",65,"ن",1,0],["كأَنَّ قومي عَن","نَهج الهدى حادوا",66,"د",3,0],["كأنّ قرطاجةً ثارت ملاحِمُها","تنازعُ الغربَ أقواما وأمصارا",67,"ر",2,0],["كان قبيل البعث ربّ مال","وتاجراً ميسر الأعمال",68,"ل",1,0],["كَأَن قَد فَلا يَغرُرك مِنّي تَمَكُّثي","سَلَكتُ طَريقاً بَينَ يَربَغَ فَالسَردِ",69,"د",1,1],["كَأَنَّ قَوْسَ الْغَمَامِ الْغُرِّ قَنْطَرَةٌ","مَعْقُودَةٌ فَوْقَ طَامِي الْمَاءِ سَيَّالِ",70,"ل",1,0],["كَانَ قَلْبِي وَدِيعَةً عِنْدَ عَيْنَيْ","هِ فَآلَى بِالسِّحْرِ أَلَّا يُرَدَّا",71,"د",2,0],["كَأَنَّ قَلْبِي إِذَا هَاجَ الْغَرَامُ بِهِ","بَيْنَ الْحَشَا طَائِرٌ فِي الْفَخِّ يَضْطَرِبُ",72,"ب",1,0],["كانَ قَضيباً لَهُ اِنثِناءُ","وَكانَ بَدراً لَهُ ضِياءُ",73,"ا",2,1],["كانقذاف النيزك المشتعل","يتجارون على الأفق كما",74,"م",2,0],["كأنّ قلبَ المَنّى في أنامِله","إن نام وكَلَهُ بالوجد والسهَر",75,"ر",1,0],["كانَ قَرّا يُرى حينَ يَقرا","أَفصَح القُرّاء كَالأَعجَمِيِّ",76,"ي",1,0],["كَأَنَّ قُلوبَ الطَيرِ رَطباً وَيابِساً","لَدى وَكرِها العُنّابُ وَالحَشَفُ البالي",77,"ل",2,0],["كأَنَّ قَطِيرَ البَانِ في عُكنَاتِهَا","عَلَى مُنثَنىً والمَنكِبينِ عَطَى رَطِل",78,"ل",1,0],["كأَنَّ قطيرَ البانِ فى عُكُناتِها","على مُنْثَنًى والمنكبيْن على رَطَلْ",79,"ل",1,0],["كانَ قُبْحُ الوَجْهِ يَجزِينَا، فَقَدْ","زَادَنَا مَلْعُونُنَا قُبْحَ الخُلُقْ",80,"ق",1,0],["كَأَنَّ قُلوبَ الطَيرِ في جَوفِ وَكرِها","نَوى القَسبِ يُلقى عِندَ بَعضِ المَآدِبِ",81,"ب",1,0],["كأن قريضي لم تكهن أنت سره","وموحي معانيه العذاب البواقيا",82,"ي",2,0],["كأنّ قِبابَ الخَزِّ فيها عَرائِسٌ","على سُرُرٍ مفروشةٍ بحَرير",83,"ر",1,0],["كأن قتامهم سُحُبٌ","وفيها الشُّهب تنكدر",84,"ر",1,0],["كأَنَّ قلبَكَ سُقمي في قَساوَتِهِ","وَوَردَ خدَّيْك قلبي في تَلَهُّبِهِ",85,"ب",2,0],["كَأَنَّ قرنَ الشَمسِ في ذُرورِها","بِفِعلِها في الصَحنِ وَالكَأسِ اِقتَدى",86,"ا",1,0],["كَأَنَّ قَطاةً عُلِّقَتْ بِجَناحِها","على كَبِدي من شِدَّةِ الخَفَقانِ",87,"ن",1,0],["كَأَنَّ قَرَى السِّيدانِ فِى الآلِ غُدوَةً","قَرَى حَبَشِىٍّ فِى رَكابَينِ واقِفُ",88,"ف",1,1],["كأنّ قوس الغمامِ حاشيةٌ","من سَفَط الخَزِّ بعدَ ما طَبَّق",89,"ق",1,0],["كانَ قَد يركبُ الحمارَ عُفَيراً","وَمَشى حافياً وغاب الرداءُ",90,"ا",2,0],["كَأَنَّ قُرادَي نَحرِهِ طَبَعَتهُما","بَطينٍ مِنَ الجولانَ كُتّابُ أَعجَمِ",91,"م",1,0],["كأنَّ قلوباً في غرامكِ أُحرقتْ","فذَوَّبها الصيَّاغُ بينَ السبائكِ",92,"ك",1,0],["كأنْ قدْ غدا الإنسانُ وحشاً فلا أرى","يعززُ إلا المرءِ واديهِ مسبعُ",93,"ع",1,0],["كأنَّ قوامهُ غصنُ ولكنْ","تفتحَ فوقَ عروتهِ الزهورُ",94,"ر",1,0],["كَأَنَّ قَذىً فيها وَلَيسَ بِها قَذىً","سِوى عَبرَةٍ مِن جائِلِ الدَمعِ تَنسَجِم",95,"م",1,0],["