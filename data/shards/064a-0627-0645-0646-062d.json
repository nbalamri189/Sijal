://www.poetsgate.com/ViewPoem.aspx?id=201487",""],[5956,"أراكِ لم تسافري","https://www.poetsgate.com/ViewPoem.aspx?id=182152",""],[5956,"لله درُّك يا بنيَّ كمالُ","https://www.poetsgate.com/ViewPoem.aspx?id=194392",""],[5956,"في قاع نفسي حبكم مرصودُ","https://www.poetsgate.com/ViewPoem.aspx?id=194626",""],[5977,"يأتي إلهي بالجميل","https://www.poetsgate.com/ViewPoem.aspx?id=213260",""],[6018,"يا من حكى الورد الطرئ بعرفه","https://www.poetsgate.com/ViewPoem.aspx?id=181193",""],[6032,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=181511",""],[6115,"يالله يامن بامره الشر والخير","https://www.poetsgate.com/ViewPoem.aspx?id=180503",""],[6345,"جور الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78653&r=&rc=24",""]],"verses":[["يَا مَنْ حَفَلْنَا لَهُ","نَقْضِيهِ حَقّاً وَجَبْ",0,"ب",1,0],["يا من حمدت من الكتابة إنَّني","تملى مَعَاليها عليَّ وأكتب",1,"ب",1,0],["يا من حمدت إلى حماه محاجراً","سُلكت ولو أني سلكت محاجري",2,"ر",2,0],["يا من حبانا به الل","ه كَيْ نكثِّرَ حمْدَهْ",3,"د",2,0],["يا من حكى في المعالي","أباه طُرّاً وجَدَّه",3,"د",2,0],["يا من حلا في الفؤاد منظره ال","حلوُ فما مجَّهُ ولا لفظه",4,"ظ",2,0],["يا من حسبناه بدءاً","علقاً فكان عُليقا",5,"ق",2,0],["يا من حكى حاتماً في كل مكرُمة","ومن يُعنْ ذا فعالٍ صالح يُعَن",6,"ن",1,0],["يا مَنْ حَلاَ ثُمَّ طابَ رِيحاً","فَفِيهِ شَهْدٌ وفيهِ وَرْدُ",7,"د",1,1],["يا مَن حَكَت عَيناهُ سَيفَ سَمِيِّهِ","هَلّا اِقتَدَيتَ بَعَدلِهِ إِذ يَحكُمُ",8,"م",1,0],["يا مَن حَكى في اِحتِراماتِ النُفوسِ بِهِ","سَميَّهُ عِندَ وَقعِ البيضِ وَالأَسَلِ",9,"ل",1,0],["يا مَن حَكى الظَبيَ في تَلَفُّتِهِ","وَفاقَهُ بِالدَلالِ وَالخَفَرِ",10,"ر",1,0],["يا مَن حَكى يوسُفاً وَلَكِن","قَد زينَ في عَينِ مُشتَريهِ",11,"ه",1,0],["يا مَن حَكَت شَمسَ النَهارِ بِحُسنِها","وَبُعادِ مَنزِلِها وَبَهجَةِ نورِها",12,"ه",2,1],["يا مَن حَمَت عَنّا مَذاقَةَ ريقِها","رِفقاً بِقَلبٍ لَيسَ فيهِ سِواكِ",13,"ك",1,1],["يا مَن حَباني مِن جَميلِ رَأيِهِ","بِبِشرِهِ وَالبِرِّ وَالتَوَدُّدِ",14,"د",1,0],["يا من حسدتم صبيا بالهوى فرحا","رفقا به فهو مقتول وما علم",15,"م",1,0],["يا منْ حوى مِنْ فهمِهِ","وعلمِهِ ما قدْ حوى",16,"ح",3,1],["يا مَنْ حاجى","وُقِّيتَ أذى",17,"ذ",2,1],["يا مَنْ حكى الدرعَ صوناً والمجنَّ تقى","والسمهريَّ أخاً والمشرفيَّ أبا",18,"ب",2,0],["يا مَن حَلَفتُ أَن أَرى","عانٍ فَبَرَّ الحَلِفا",19,"ف",2,0],["يا مَنْ حملْتتَ الفأْسَ ته","دِمها على أنْقاضِها",20,"ه",2,0],["يا مَن حَوى الحُسنَ مَحضا","وَاِهتَزَّ كَالغُصنِ غَضّا",21,"ض",2,1],["يا مَن حَديثي حَيثُ كُن","تُ بِوَصفِهِ أَبَداً يَكونُ",22,"ن",1,0],["يَا مَنْ حَمِدْتُ بِهِ اخْتِيَا","رِي في اَخْتِبَارِي للِصِّحَابِ",23,"ب",1,1],["يَا مَنْ حَبَا بِفَرِيدِهِ","لُغَةً تُرَدُّ لِغَيْرِ سَامِ",24,"م",1,0],["يا من حباني هناءً بالشفاء لقد","صار الهناء شفاءً وانجلى السقم",25,"م",1,0],["يا من حمدت فلم أذمم مودته","والناس وُدُّهم يُطوَى على دخن",26,"ن",1,0],["يَا مَنْ حَوَتْ كلَّ المَحاسِنِ في الوَرى","وَالحُسْنُ فِيها عَاكِفٌ فِي بادِ",27,"د",1,0],["يا مَن حَلا حِينَ ذاقَهُ نَظَري","لَوْ لَمْ يَبِنْ مِنْهُ مُرُّ إِعْراضِ",28,"ض",1,1],["يا مَنْ حياتي رضاهُ في تعتُّبهِ","ومَنْ مماتي جَفاهُ في تَغضُّبِهِ",29,"ب",2,1],["يا من حُسِدتُ على أُولى عَزائمِه","جَدِّدْ علي حاسِدي أمرِي فقد خَانا",30,"ن",2,0],["يا من حفظت عهودهُ واضاع عه","دي واستجبت نداءهُ وعصاني",31,"ن",2,0],["يا من حياتك بعد مَو","تك وصلُه من بعد صدِّهْ",32,"د",2,0],["يا من حكَى الشمسَ وجْهاً والدّجى طُرَراً","وأشبَه الماء لِينا والهوا تَرَفا",33,"ف",2,0],["يا من حكى النرجِس لي نَشْره","ماذا تقلَّدت من الأنفسِ",34,"س",1,0],["يا من حوى الفضل وحاز الفخرا","وكسف الشمسَ وفاق البدرا",35,"ر",2,1],["يا من حباء يديه محلول الحُبا","لسناء سارٍ أو لفك إساري",36,"ر",2,0],["يامَن حَبَستُ عَلَيهِ أَشعاري وَما","اِحتُبِسَت مَواهِبُهُ وَلا أَرفادُهُ",37,"د",2,0],["يا من حقوق النيروز تلزمهُ","رسمك يوم النيروز مشهورُ",38,"ر",1,1],["يا من حوى من كل شيء أحسنه","ومن تداعت بثناه الألسنه",39,"ن",2,1],["يا مَن حَوى كُلَّ الجَمالِ باسِرَهُ","وَرَضيتَ مِن حُكمِ الغَرامِ بِأَسرِهِ",40,"ه",1,0],["يا مَن حَبا يَعقوب بالبُشرى وَقَد","شَفى بِها عَينيه إِذ قال عَسى",41,"ا",1,0],["يا مَن حَبا يوسف عزّاً وَغِنىً","وَعِصمةً بَعدَ العَنا مِمّا جَرى",41,"ا",1,0],["يا مَن حَبا الملك سليمان وَقَد","دانَ لَهُ الطائر مَع وَحش الفَلا",41,"ا",1,0],["يا مَن حَمى أَحمد بالغار كما","قَد رَدَّ مَسعى مَن تَغشّاه سُدى",41,"ا",1,0],["يا مَن حُسِدْتُ عليه من شَرفى به","قولُ الحسودِ على الفَتى مَردود",42,"د",1,0],["يا مَن حَكَمتَ عَلَيَّ فيهِ لِحِكمَةٍ","قُل لي فَما أَنتَ الَّذي يَتَقَوَّلُ",43,"ل",1,0],["يا من حملتِ إلهَ العاملين ومن","منها تجسَّد ذا من غير ما رجلِ",44,"ل",1,1],["يا مَن حَوى كُلَّ مَجدٍ","بِجودِهِ وَبِجَدِّه",45,"ه",1,1],["يا مَن حَوَى قصَباتِ السّبقِ أجمعَها","فما يُرى اُثْنانِ في تفضيلِهِ اُختلَفَا",46,"ف",2,0],["يا من حوى فضلاً ونبلاً ومَنْ","إِليه فيما قُلْتُهُ قصدي",47,"د",2,0],["يا من حديث شعاره","فوق المواعظ والقلم",48,"م",1,0],["يا من حبته التضحيات","بكل مجد يغتنم",48,"م",1,0],["يا مَن حَوى مِن عَرَقِ الوَردِ الطَري","أَزهُ عَلى المِسكِ الفَتيقِ الأَذفَرِ",49,"ر",1,0],["يا منحنى الجِزعِ لي قلبٌ يطالِبُني","بما تقضَّى لنا في عصرِكَ الخالي",50,"ل",2,0],["يا من حواه الدين في عصره","صدراً يحلّ العِلم منه فؤاد",51,"د",1,1],["يا مَن حَزِنتَ لفَقْدِ المالِ إنَّكَ قد","خُلِقتَ عارٍ وما في ذاكَ من عارِ",52,"ر",1,0],["يا من حَوَاهُ في الدُّنا لَحدهُ","والقبر مسرورٌ بما قدْ حَوَى",53,"و",2,0],["يا مَنْ حَكَى لَوْنَ الدُّجَى فَرْعُهُ","قُلْ لِي هِجْرانُكَ ما أَصْلُهُ",54,"ل",2,0],["يَا مَنْ حَكَى بِقَوامِهِ","قَدَّ القَضِيب مُذُ الْتَوى",55,"و",2,0],["يا من حويت من المناقب كل ما","أعيا من الشعراء كل مجيد",56,"د",1,0],["يا مَن حَوى شرفاً فحا","زَ الفضلَ بالنوع البديعِ",57,"ع",1,0],["يا من حللتِ من المعالي ذروةً","ورَقيتِ بين الناس ارفع مُرتَقَى",58,"ق",2,0],["يَا مَن حباني منَّةً","بوفائِها بَاعي قَصير",59,"ر",1,0],["يا مَنْ حَصَلْتَ على الكمالِ بِما رَأَتْ","عَيْنايَ منهُ مِنَ الجَمال الرَّائعِ",60,"ع",1,1],["يا مُنحِلي حتّى فَنيتُ","وَضَعتَني في نصفِ مُدّك",61,"ك",1,0],["يا من حواها وهْو ذو صحةٍ","اجعل صديقاً كاتباً للحروز",62,"ز",1,0],["يا من حوى برده الغمامة وال","غيث سماحا واللّيث والبحرا",63,"ر",2,0],["يا من حمدنا به عي","شنا وكان مذمم",64,"م",1,0],["يا من حملت له الهوى","طوعا وفيه العدل مكره",65,"ر",2,0],["يا من حلت أخلاقه","وغدت على الأعداء مرة",65,"ر",2,0],["يَا مَنْ حَكَتْ سمرَ القَنَا اعطَافُهُ","وَحَكَتْ فَواترُ طرفه الخرصَانَا",66,"ن",2,0],["يا من حمى في الغار أحمد","من عدو قد مرد",67,"د",1,0],["يا مَن حكاه بإنسانٍ يماثلهُ","اِقصر فَلا تجعلنّ الجدّ كالهزلِ",68,"ل",1,0],["يا مَن حَباهُ اللهُ نصراً دائِماً","خَفَقت به الرَّاياتُ والأَعلامُ",69,"م",1,0],["يا مَنْ حُرِمْتُ على الغَرامِ بِهمْ","دونَ الأنامِ وحِرتُ في أَمْري",70,"ر",2,0],["يا مَن حكى يُوسُفاً فى حسن صورته","جُد لى بوصلٍ فإنّى فيك يعقوبُ",71,"ب",1,0],["يا مَن حَفِظتُ عهودَهُ","ما لَكَ قد أضَعتَنى",72,"ن",2,0],["يا من حديث غرامي في محبتهم","مسلسل وفؤادي منه معلول",73,"ل",1,0],["يا مَن حَنيني إِلَيهِ","وَمن فُؤادي لَدَيهِ",74,"ي",2,1],["يا من حكى شجر الصنوبر قده","حقاً لقد علقتك أفئدة الورى",75,"ر",2,0],["يا من حرمت وصاله أو ما ترى","هذي النوى قد صعرت لي خدها؟",76,"ه",2,1],["يا مَن حكى ثغرُه الدرَّ النَّظيم ومن","تَخال أصداغَهُ السودَ العَناقيدا",77,"د",2,1],["يا مَن حَوى الشُكرَ الجَزِيلَ لِأَنَّهُ","أَعطى جَزيلاً وَاستَعادَ جَزيلا",78,"ل",2,0],["يا من حوى ثغره بَرَد","ها حرّ قلبي ما بَرَد",79,"د",1,1],["يا مَن حبانا بفُنونٍ أنعشت","حتى انثَنى الجهلُ طريداً واختفى",80,"ا",1,0],["يا مَن حمى دين النَبي بِفكرة","تَمضي مضاء الصارم المَصقول",81,"ل",1,0],["يا من حبوت بودّهِ حوباءِ","وهي الفداءُ له من الأسواءِ",82,"ا",2,1],["يا مَن حَكى الماء فَرط رقته","وَقَلبه في قَساوة الحَجَر",83,"ر",1,0],["يا من حلا في مدحه مسلكي","عجل باذهاب الذي اشتكي",84,"ي",1,0],["يا من حكى هاروت في سحره","بمقلة كحلاء ذات احورار",85,"ر",1,0],["يا من حشاه معدن للدود","يجمع بين بيضها والسود",86,"د",1,0],["يا من حكت نَسَمُ الرياض خلالَهُ","لطفاً وما تحكي طهارةَ قَلبهِ",87,"ب",2,0],["يا من حوى جد القتال وهزله","وسبى الورى بحسام طرف سله",88,"ه",1,1],["يا من حرمناه فحرمنا الهنا","أسفاً رغادر كل يوم اسودا",89,"د",2,0],["يا من حلفتُ بفضله من قبلما","حاضرته في منتدى ومزار",90,"ر",1,0],["يا من حلالا دمي الحرام رأوا","ندبا فؤادي عليكم وجبا",91,"ب",2,0],["يا مَن حِماهم مَعقلٌ","حاشا نزيلِكُم يُضام",92,"م",1,0],["يا مَن حِجاهُ لم 