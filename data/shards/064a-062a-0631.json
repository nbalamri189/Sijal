9361&r=&rc=9",""],[6261,"تباريحُ الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82137&r=&rc=9",""]],"verses":[["يَتَرادَفونَ عَلى الرِماحِ كَأَنَّهُم","سَيلٌ يَعُبُّ وَعارِضٌ يَسري",0,"ر",2,0],["يَتَراغَينَ وَبَينَ ال","وَحشِ وَالعِقبانِ ذَبحُ",1,"ح",1,0],["يَترُكُ ما رَقَّحَ مِن عَيشِهِ","يَعيثُ فيهِ هَمَجٌ هامِجُ",2,"ج",1,0],["يُتَرْجِمُ عَنْ عَذْبِ الشَّرَابِ مَذَاقُهُ","وَيُعْرِبُ عَنْ عِتْقِ الْجِيَادِ صَهِيلُهَا",3,"ل",3,0],["يتراكضون وراءها في ساحة","للسوق معترك بها وصدام",4,"م",1,0],["يَتَراهَنونَ عَلى التُيوسِ كَأَنَّما","قَبَضوا بِقُصَّةِ أَعوَجِيٍّ مُقرَبِ",5,"ب",1,0],["يَتَرادَفُ الوِلدانُ فَوقَ فَقارِها","بِنِها الرَدافِ إِلى أَسِنَّةِ مَحضَرِ",6,"ر",1,0],["يتركُ تقبيلُها مُقَبِّلَها","وهو إلى العود غيرُ منحاش",7,"ش",1,0],["يترك بالحول حول حُوَّلِها","وهو سواء وموق مائقها",8,"ق",3,0],["يَتَراءى كَوكَباً ذا ذَنَبٍ","فَإِذا جَدَّ فَسَهماً ذا مَضاء",9,"ا",2,0],["يَتَرَشَّفنَ مِن فَمي رَشَفاتٍ","هُنَّ فيهِ أَحلى مِنَ التَوحيدِ",10,"د",1,0],["يَتَراكَمونَ عَلى الأَسِنَّةِ في الوَغى","كَالصُبحِ فاضَ عَلى نُجومِ الغَيهَبِ",11,"ب",1,0],["يَتَرَقرَقنَ كَالسَرابِ وَقَد خُض","نَ غِماراً مِنَ السَرابِ الجاري",12,"ر",2,0],["يَتَرَقّى عَلى شَباةِ الأَعادي","دَرَجَ المَجدِ طَيِّعاً مُعتاصُه",13,"ص",2,0],["يَتَرقّى إِلى المَعالي مِنَ الأَم","رِ بِنَفسٍ عَنِ الدَنايا عَزوفِ",14,"ف",1,0],["يَتَراءى وَالكَرى في مُقلَتي","فَإِذا فارَقَها النَومُ بَطَل",15,"ل",1,0],["يَتَراهَنونَ عَلى جِيادِ حَميرِهِم","مِن غايَةِ الغَذَوانِ وَالصَلصالِ",16,"ل",1,0],["يتركُ النقمةَ في جانبهِ","وإذا عاقبَ في اللّه انتقم",17,"م",1,0],["يُتَرجِمُ طَرفي عَن لِساني بِسِرِّهِ","فَيُظهِرُ مِن وَجدي الَّذي كُنتُ أَكتُمُ",18,"م",1,1],["يَترُكُ ما مَرَّ مُذ قُبَيلُ بِهِ","كَأَنَّ أَدنى عَهدٍ بِهِ الأَمسُ",19,"س",1,0],["يَترامَى في عُبابٍ زاخِرِ","من جَلالٍ عبقريٍّ فاخِرِ",20,"ر",1,0],["يَتَرَنَّمُ الباكي وإن بَلَغَ الأَسى","مِنه ويبكِي النَّاعِمُ المُتَرَنِّمُ",21,"م",1,0],["يترامى القائدُ الأعلى بهم","في عُبابٍ للمنايا مُغرِق",22,"ق",1,0],["يَتْرَى علينا نَدَى يديكَ كما","تَدافَعَ الموْج