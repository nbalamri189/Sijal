{"poems":[[65,"خليلي إن العمر ودعت شرخه","https://www.aldiwan.net/poem46097.html","الطويل"],[29,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[29,"سيخزى إذا ضنت حلائب مالك","https://www.aldiwan.net/poem5917.html","الطويل"],[23,"أبوك أبوك وأنت ابنه","https://www.aldiwan.net/poem21458.html","المتقارب"],[31,"لقد جاريت يا ابن أبي جرير","https://www.aldiwan.net/poem6032.html","الوافر"],[64,"ألا أيها الركب اليمانون ما لكم","https://www.aldiwan.net/poem52244.html","الطويل"],[68,"تنزه عتبي عن خطاك صواب","https://www.aldiwan.net/poem39643.html","الطويل"],[21,"جهنم تلك لا تبقي بغيا","https://www.aldiwan.net/poem36164.html","الوافر"],[69,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[48,"سرينا وطالبنا هاجع","https://www.aldiwan.net/poem22047.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42682","الطويل"],[108,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[164,"من عونه ربه في أمره غلبا","https://www.aldiwan.net/poem58896.html","البسيط"],[208,"أخي لا تؤاخذني وإن كان لي","https://www.aldiwan.net/poem53356.html","الطويل"],[228,"لقد بلغت بهم الحده","https://www.aldiwan.net/poem41900.html","المتقارب"],[275,"لقد هاج الهوى هذا الحرير","https://www.aldiwan.net/poem35446.html","الوافر"],[275,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[285,"متى ارتجعت مواهبها الكرام","https://www.aldiwan.net/poem60717.html","الوافر"],[369,"أأحبابنا قد شقتمونا فأسعدوا","https://www.aldiwan.net/poem60942.html","الطويل"],[376,"سهرت اهتماما بالعيون السواهر","https://www.aldiwan.net/poem57388.html","الطويل"],[382,"أجد يا راهبا سعيا","https://www.aldiwan.net/poem59169.html","مجزوء الوافر"],[408,"أيغنيك دمع أنت في الربع ساكبه","https://www.aldiwan.net/poem46983.html","الكامل"],[409,"نعم قد قضى ربي بما هو كائن","https://www.aldiwan.net/poem34099.html","الطويل"],[447,"وقيت ببردي ظهر جلدي على البرد","https://www.aldiwan.net/poem14365.html","الطويل"],[473,"يا من تغيب عنا","https://www.aldiwan.net/poem59616.html","مجزوء الرمل"],[484,"فتحت بنظمك المنثور بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[518,"يا مانعا مقلتي من لذة الوسن","https://www.aldiwan.net/poem67699.html","البسيط"],[543,"دام بقاؤك لنا","https://www.aldiwan.net/poem47918.html","عموديه"],[556,"ما ارتبت منكم على مر الزمان فلم","https://www.aldiwan.net/poem48042.html","البسيط"],[556,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[569,"اهجر معنى القلب عندك جائز","https://www.aldiwan.net/poem856.html",""],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112462","المجتث"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48735","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64021","الهزج"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145607","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119936","السريع"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61039","المتقارب"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56683","الطويل"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47402","المتقارب"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78123","الكامل"],[1638,"","https://poetry.dctabudhabi.ae/diwan/poem/205527","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101070","الطويل"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103225","الطويل"],[2031,"","https://poetry.dctabudhabi.ae/diwan/poem/140123",""],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27149","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27860","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124779","الطويل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110663","الرجز"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17683","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129843","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100885","الوافر"],[2714,"","https://poetry.dctabudhabi.ae/diwan/poem/199884","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65993","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204653","الرجز"],[3166,"","https://poetry.dctabudhabi.ae/diwan/poem/206019","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112679","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68034","الوافر"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68076","الوافر"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131993","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91878","المجتث"],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18553","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114399","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135513","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54399","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83385","الوافر"],[4984,"وقع الإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=180120",""],[3591,"أحنُّ على شطِ المزار إلى مصرا","https://www.poetsgate.com/ViewPoem.aspx?id=149379",""],[5189,"ويغفر للجناةِ التائبينا","https://www.poetsgate.com/ViewPoem.aspx?id=216020",""],[5725,"غنى النفس","https://www.poetsgate.com/ViewPoem.aspx?id=183491",""],[5725,"وماعجبي بوجهك من صفاء","https://www.poetsgate.com/ViewPoem.aspx?id=185402",""],[2220,"حَمَلنَ على اليَعْمَلاَتِ الخُدورا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19274&r=&rc=816",""]],"verses":[["فَلا تَدْعُوانِي لِلْكِتابَةِ إِنَّها","طَماعَةُ راجٍ في مَخِيلَةِ قانِطِ",0,"ط",1,0],["فَلا تَدعُ جاراً مِن عِقالٍ تَرى لَهُ","ضَواغِطَ يُلثِقنَ الإِزارَ وَأَضرُعا",1,"ع",2,0],["فَلا تُدنِيا رَحلَ الدَلَهمَسِ إِنَّهُ","بَصيرٌ بِما يَأتي اللِئامِ سَميعُ",2,"ع",1,0],["فَلا تَدعُهُم لِقِراعِ الكُماةِ","وَنادِ إِلى سَوأَةٍ يَركَبوا",3,"ب",3,0],["فَلا تَدخُل بُيوتَ بَني كُلَيبٍ","وَلا تَقرَب لَهُم أَبَداً رِحالا",4,"ل",2,0],["فلا تدنُ من ذاك الغُزَيِّلِ إنِّه","يفوتُكَ مرمياً ويُصميكَ راميا",5,"ي",2,0],["فَلا تَدعُني لِلقُربِ مِنكَ جَهالَةً","فَما كُلُّ داعٍ في الأَنامِ يُجابُ",6,"ب",1,0],["فَلا تَدنو جَهَنَّمُ مِن بَريءٍ","وَلا عَدنٌ يَحِلُّ بِها الأَثيمُ",7,"م",1,0],["فلا تُدْنِ منهم واحِداً منكَ ساعةً","ولو فاحَ مِنْ بُرْدَيْهِ مِسْكٌ وَعَنْبَرُ",8,"ر",1,0],["فَلا تَدنُ مِن جاهِلٍ آهِلٍ","لَو اِنتُزِعَت خُمسُهُ ما دَرى",9,"ر",2,0],["فَلا تَدَعُوا هَذِي الْقُلُوبَ فَإِنَّهَا","قَوَارِيرُ مَحْنِيّ عَلَيْهَا الأَضَالِعُ",10,"ع",1,0],["فلا تدفنا ذنبي بقبريَ، وادفنا","صلاتي مَعِي جَوْفِه، وصياميا",11,"ي",2,0],["فلا تدعْ لَهم ما يذكرون به","فالشمسُ حين تجلّى تطمِس الشُّهبا",12,"ب",2,0],["فلا تُدْنِسَنْ أخلاقَك الغرَّ بالقلى","فحيث يكون الجور لا يحمد الخصبُ",13,"ب",1,0],["فَلا تَدعوا ظُفُرَ المستَبِدِّ","يحكُّ لِلبنانِكُم جِلدَه",14,"د",2,0],["فلا تدَعي النسيمَ يسرُّ شيئاً","إليك فإنني صبٌّ غيور",15,"ر",1,0],["فلا تدري وقد نزلوا حماها","أتبكي الأهلَ أم تبكي الديارا",16,"ر",2,0],["فَلا تَدَعِ الْعِراقَ وَأَرْضَ مَصْرٍ","تَفُوزُ بِها وَيُحْرَمُها الشَّآمُ",17,"م",1,0],["فلا تَدَّعوا صِدْقَ الوفاء وإنّنا","لأيقاظُ لَيْلٍ أنتمُ فيهِ هُجَّد",18,"د",1,0],["فلا تَدعوا من بَعد ما قد عَلِمتُما","خليلَكما إلا عدوَّ السرائِرِ",19,"ر",1,0],["فلا تدري أَسَخْلاً كن","تَ في الحالين أم ظبيا",20,"ي",2,0],["فلا تدَعوا إجماعَ أمّةِ أَحْمدٍ","فأكثرُ مِمّن شاهَد الأّمْرَ غائبُهْ",21,"ب",2,0],["فلا تدعهم جبرية بعد هذه","وأنصف وجانب كل ذي عصبية",22,"ه",1,0],["فلا تدرك الأخرى بحول وقوةٍ","إذا لم يكن توفيقك اللَه في الجهد",23,"د",1,0],["فَلا تَدَعنا لِكَسبٍ","فَالكَسبُ يَفنى وَنَفنى",24,"ن",2,0],["فلا تدري خفيفا من ثقيل","ولا خيبا دريت ولا اقتضابا",25,"ب",2,0],["فلا تدع رعي ما قد كنت تعلمه","مني يقيناً وتهجرني على الظنن",26,"ن",1,0],["فلا تَدَعهُ سَيِّدي","يَفتكُ بي وقَد دَنا",27,"ن",2,0],["فلا تُدِلّوا بإثراءٍ أُتيحَ لكمْ","لا خَيرَ بعدَ اِفتِقارِ العِرْضِ بالنَّشَبِ",28,"ب",1,0],["فلا تُدنِنِي يوماً دِيار مَسّرةٍ","وَلا تغشَ بِي إلّا بيوتَ المنادِبِ",29,"ب",1,0],["فلا تدعي حبي وأنت مصادمي","ولا تعذلني إنني عنك ناكز",30,"ز",1,0],["فلا تديرا كؤوساً","فيها زعاف السموم",31,"م",1,0],["فلا تدوم حزازات المعادينا","ولا تدوم مودات الموالينا",32,"ن",2,0],["فلا تدفعُ عن حقٍّ","وهل للحقِّ من دَفْع",33,"ع",1,0],["فلا تدعني غرضاً للقر","فقد كفاني عدمي للبر",34,"ر",1,0],["فلا تدعني اليوم في خجلة","يا سيّدي مع ستِّ يا قوتِ",35,"ت",1,0],["فَلا تَدَع سَقياً لِبَطن الثرى","فَقَد أَودَع المَطَر المثجما",36,"م",2,0],["فلا تدعيني حائراً فيك والهاً","فعندك قلب في الغرام لطيف",37,"ف",1,0],["فَلا تَدَّخِرْ دُونَهُ لَعْنَةً","لأَنَّ رِضَى اللهِ في لَعْنَتِهْ",38,"ت",2,0],["فَلا تَدَعني في فكر","أَقضي اللَيالي بِالسَهَر",39,"ر",1,0],["فلا تدوم على حال تكون به","تروغ في قولها والوعد ممطول",40,"ل",1,0],["فلا تدعني في معرض القول شاعرا","ولكنني باكٍ قليلٌ عزائيا",41,"ي",2,0],["فلا تَدعُوَنَّ القيلَ إلّا لِمَشرَبٍ","رواءٍ ولكنَّ الفَرَزدَقُ",42,"ق",1,0],["فلا تدعنه رغبة وتهاونا","ولا تك تأتي بالخلاف على أمر",43,"ر",1,0],["فَلا تَدعُوَنَّ بِها واحِداً","وَلكِنَّما اِدعُ ثُبوراً كَثيرا",44,"ر",2,0],["فلا تدعني إلا إذا كنت قاطعاً","فإني مجيبٌ ما دعوتَ وإن خنتا",45,"ت",2,0],["فلا تدعن بابا من البر مغلقا","تلاق غدا باب الرضى غير مؤصد",46,"د",1,0],["فلا تدعني منشداً","في كل صبح ومسا",47,"س",2,0],["فَلا تُدخِلَنَّ الدَهرَ قَبرَكَ حَوبَةً","يَقومُ بِها يَوماً عَلَيكَ حَسيبُ",48,"ب",1,0],["فلا تدع التبريز في كثرة الهوى","فلولاي كانت فيه إحدى العجائبِ",49,"ب",1,0],["فلا تُدمِ العيونَ الى الأعادى","فتصبح فى أكفهم خِضابا",50,"ب",2,0],["فلا تدعوه وانتفوا منه تسلموا","بنفيكموه من مقام ومأثم",51,"م",1,0],["فلا تدفعاني يا هداد بجفوة","ويا حسن إني أخ منكما دان",52,"ن",1,0],["فلا تدع قتل الهموم بالطلا","لنصح زاهد يصيد السذَّجا",53,"ج",2,0],["فلا تدخر زاداً فتصحب ملجأً","إليه وكله اليوم يخلفه الغد",54,"د",1,0],["فلا تدبر مع المولى تنازعه","في ملكه فدع التدبير تغتنم",55,"م",1,0],["فلا تدعها عجَزاً أو كسَلا","ولا تهاوناً بها أو بُخلا",56,"ل",2,0],["فلا تدري بليلٍ أَوْ نهارٍ","وصوءُ الفجرِ مثلُ النهر جار",57,"ر",1,0],["فلا تدعِ الأعادي فِي هُدُوِّ","فزَعزِعهم ولا تكُ ذا حُنُوِّ",58,"و",1,0],["فلا تدري علام الطرف باك","لهول الخطب أم حسن الفتاة",59,"ه",1,0],["فلا تَدع صفو دانٍ","أَو تَرتجي صَفوَ غائب",60,"ب",1,0],["فَلا تَدنُوَنْ مِنهُم وَلا تُقصِيَنَّهُم","وَلَكِنَّ أَمراً بَينَ ذاك مُقارِبا",61,"ب",2,0],["فلا تدع نفساً منها يضيعُ سُدىً","بلا اكتسابٍ بهِ بقيتَ ذا هِمَمِ",62,"م",1,0],["فلا تدعو مع الله الكريمِ","بذي الأعضا سواه هي المساجدْ",63,"د",1,0],["فلا تدعْ يهدمُ شيطانَهُ","ما أَحكمَ التقوى من الأُسِّ",64,"س",1,0],["فَلا تَدع العِدى يَصلوا إِليهِ","وَقد أَصلَيتَهم نيرانَ حربك",65,"ك",1,0],["فلا تدع الإحساس يغزو مضاربا","بها لقديم الحزن من دربها سمت",66,"ت",1,0],["فلا تدهشوا إني قتيل جمالكم","ومن لم يمت بحبكم لم يجد عذرا",67,"ر",2,0],["فلا تدعِ الهوان يكن معيقًا","فتبقى غافلاً وهِمًا حزينا",68,"ن",2,0],["فلا تدني معاشرة اللئامِ","وعش عيش الكريم بلا ازدراءِ",69,"ا",2,0],["فلا تدنيه من ورد نضير","مخافة انْ يجفّ من البكاء",70,"ا",2,0],["فلا تدعونَّ بها واحداً","ولكنّما ادعُ تُبوراً كثيرا",71,"ر",2,0]]}