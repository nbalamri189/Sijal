{"poems":[[90,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[29,"أرق العيون فنومهن غرار","https://www.aldiwan.net/poem5743.html","الكامل"],[80,"لو زرتنا لرأيت ما لم تعهد","https://www.aldiwan.net/poem14051.html","الكامل"],[87,"في الموت ما أعيا وفي أسبابه","https://www.aldiwan.net/poem63779.html","الكامل"],[47,"طيف الحبيب ألم من عدوائه","https://www.aldiwan.net/poem10198.html","الكامل"],[68,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[99,"قدم لبسيوني قريضك واعتذر","https://www.aldiwan.net/poem24384.html","الكامل"],[71,"قف وقفة المتألم المتأمل","https://www.aldiwan.net/poem28749.html","الكامل"],[107,"هتف النعي فما ملكت بياني","https://www.aldiwan.net/poem42093.html","الكامل"],[107,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[52,"قاس الهموم تنل بها نجحا","https://www.aldiwan.net/poem63980.html","الكامل"],[48,"لو زعمت نفسي الرشاد لها","https://www.aldiwan.net/poem23419.html","المنسرح"],[119,"من الهوى آه","https://www.aldiwan.net/poem40430.html","عموديه"],[146,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[164,"قالت سليمى ابشر فموعدنا الغد","https://www.aldiwan.net/poem58811.html","الكامل"],[208,"انظر إلى غنج هذا الفاتن الغنج","https://www.aldiwan.net/poem53348.html","البسيط"],[287,"أنا بالغزلان وبالغزل","https://www.aldiwan.net/poem32672.html","المتدارك"],[287,"تعطفا قد فؤادي الأسف","https://www.aldiwan.net/poem32701.html","الرجز"],[290,"الناصر المحمود أنت","https://www.aldiwan.net/poem39401.html","مجزوء الكامل"],[358,"لوزي جلق شيء","https://www.aldiwan.net/poem39987.html","المجتث"],[435,"لك الهناء بنيل المجد والنعم","https://www.aldiwan.net/poem40798.html","البسيط"],[438,"أهلا بطيف في الدجنة أوبا","https://www.aldiwan.net/poem12551.html","الكامل"],[438,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[443,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[443,"أضر بي إذا جد في كعبه","https://www.aldiwan.net/poem2591.html","المنسرح"],[447,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[469,"ومدع تكذبه نفسه","https://www.aldiwan.net/poem3434.html","عموديه"],[543,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[556,"ما ضر من زار وجنح الدجى","https://www.aldiwan.net/poem47837.html","السريع"],[561,"لو زارني منكم خيال","https://www.aldiwan.net/poem2485.html","مخلع البسيط"],[591,"أتراك بالهجران حين فتكت في","https://www.aldiwan.net/poem17606.html","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59418","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96665","الكامل"],[1204,"","https://poetry.dctabudhabi.ae/diwan/poem/123657","البسيط"],[1358,"","https://poetry.dctabudhabi.ae/diwan/poem/143801","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108740","الكامل"],[1664,"","https://poetry.dctabudhabi.ae/diwan/poem/123777","الكامل"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101912","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202133","الخفيف"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42446","الكامل"],[2371,"","https://poetry.dctabudhabi.ae/diwan/poem/142601","المجتث"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137252",""],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74272","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65107","المنسرح"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62791","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216802",""],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130436","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114088","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94893","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73191","الكامل"],[4804,"نفسي تحدثني بانك غادرُ","https://www.poetsgate.com/ViewPoem.aspx?id=92092",""],[4908,"سَمَرٌ شِتائيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=207420",""],[4978,"يمشي الجمال إذا تمشي وإياها","https://www.poetsgate.com/ViewPoem.aspx?id=177634",""],[4987,"وضح النياق","https://www.poetsgate.com/ViewPoem.aspx?id=49592",""],[5002,"ياسيّدي","https://www.poetsgate.com/ViewPoem.aspx?id=205193",""],[5092,"تائهان","https://www.poetsgate.com/ViewPoem.aspx?id=178351",""],[5151,"سكب الزُلالُ بثغرها فِنجانا","https://www.poetsgate.com/ViewPoem.aspx?id=186002",""],[5246,"بين الربى وعلى ضفاف الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=187024",""],[5271,"آميس","https://www.poetsgate.com/ViewPoem.aspx?id=60775",""],[5277,"عبق وشوق","https://www.poetsgate.com/ViewPoem.aspx?id=184923",""],[5277,"أنتِ..يا أجملَ الأزهار","https://www.poetsgate.com/ViewPoem.aspx?id=187783",""],[5277,"عليه ألف صلاة","https://www.poetsgate.com/ViewPoem.aspx?id=190823",""],[5376,"قولوا لها .....يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=188269",""],[5431,"حشد الرعاع ...","https://www.poetsgate.com/ViewPoem.aspx?id=202871",""],[5573,"ياسعود لاصكت علي الغلايب","https://www.poetsgate.com/ViewPoem.aspx?id=200079",""],[5616,"أين النخوة العرباء؟","https://www.poetsgate.com/ViewPoem.aspx?id=204849",""],[5672,"حنين عين لتلك القبور","https://www.poetsgate.com/ViewPoem.aspx?id=206545",""],[5674,"يعيد لي العطار وجه زماني","https://www.poetsgate.com/ViewPoem.aspx?id=185902",""],[5736,"لوزية العينين","https://www.poetsgate.com/ViewPoem.aspx?id=203158",""],[5736,"طواف","https://www.poetsgate.com/ViewPoem.aspx?id=213790",""],[5770,"ذكرت لوزان","https://www.poetsgate.com/ViewPoem.aspx?id=178266",""],[5817,"فاتنة العيون","https://www.poetsgate.com/ViewPoem.aspx?id=191046",""],[5837,"عبدالعزيز القنيدي","https://www.poetsgate.com/ViewPoem.aspx?id=181088",""],[5956,"نعم لقول رب العالمين \"وخلقنا الإنسان في كبَد.\"","https://www.poetsgate.com/ViewPoem.aspx?id=183506",""],[5956,"اللغة العربية الفصحى ولهجاتها العامية","https://www.poetsgate.com/ViewPoem.aspx?id=202206",""],[5978,"تجليات من وحي الأنوثة","https://www.poetsgate.com/ViewPoem.aspx?id=191711",""],[3792,"حلت ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=129244",""],[6056,"موت اإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=130361",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""]],"verses":[["لو زرعنا بك البقاع حبوباً","لحصدنا النضار يوم الحصاد",0,"د",1,0],["لَو زُرتِنا لَرَأَيتِ حَولَ رِحالِنا","مِثلَ الحَنِيِّ أَمَلَّها الأَسفارُ",1,"ر",1,0],["لو زُرتَنا لَرَأيتَ ما لَم تَعهَدِ","ذَوبَ اللجَينِ خَليطَ ذَوبِ العَسجَدِ",2,"د",1,1],["لَو زايَلَ المَوتى مَحاجِرَهُم بِهِ","وَتَلَفَّتوا لَتَحَيَّروا كَضَبابِهِ",3,"ب",2,0],["لَو زارَ في غَيرِ الكَرى لَشَفاكَ مِن","خَبَلِ الغَرامِ وَمِن جَوى بُرَحائِهِ",4,"ا",3,0],["لَو زينَ عَصرُ آلِ عُبّادٍ بِهِ","لَم يَصِلِ المُلكُ إِلى المُعتَضِدِ",5,"د",1,0],["لو زعَّمُوكَ على الشباب جعلتَه","كالسيلِ يزخر في قويِّ عبابِهِ",6,"ب",2,0],["لو زرْتُها لفتحْتُ بابَ جنانِها","وأقولُ يا نفسُ اطمئني وادخلي",7,"ل",2,0],["لو زِيد ركنٌ في الصلاةِ على يدي","لجعلتُه من أَوثق الأركانِ",8,"ن",1,0],["لو زالتِ الأرضُ أو حَالتْ جَوانِبُها","بِمَنْ عليها مِنَ الأقوامِ لم نَحُلِ",9,"ل",1,0],["لَو زادَهُ رَبّي لِخُلَّتِهِ","حُبّاً كَعَينِ الذَرَّةِ اِفتَضَحا",10,"ح",2,0],["لَو زَعَمَت نَفسِيَ الرَشادَ لَها","حِلفاً لَكَذَّبتُها بِمَزعَمِها",11,"م",3,1],["لو زار في ليل","بالنوم مولاه",12,"ا",2,0],["لو زرانى طيفُهمُ ما درى","من الضنا أنىَ في مضجعى",13,"ع",2,0],["لو زارني فيها محا الصبح الدجا","عجلاً كما يمحو خطا الخطِّ اليدُ",14,"د",1,0],["لو زُلزل القلب زلزالاً لما انزعجت","مودَّتي لك فاثبت غير مُنزعجِ",15,"ج",1,0],["لَو زادَ البَحرُ فَغَطّى السَّه","لَ مِنَ الأَرضين مَعَ الجَبَلِ",16,"ل",1,0],["لَو زُرتُكُم أَسعى عَلى جَمرِ الغَضا","لَم يَهَبِ الحَريقَ قَلبي المُدنَفُ",17,"ف",1,0],["لو زرت نلت من الملي","ك عناية تحيي الاثر",18,"ر",1,0],["لوزيّ جلّق شَيء","لَهُ يَعزّ الوُصولُ",19,"ل",1,1],["لو زرت بحراً غدا عذباً لشاربهِ","وفاز راكبهُ بالأمن والسلمِ",20,"م",1,0],["لو زارَني مستيقِظاً لشفى جوًى","بين الجوانح قد غدا متلهِّبا",21,"ب",2,0],["لو زارني الخيالُ في المنامِ","لم يرَني من شدّةِ السَّقامِ",22,"م",1,0],["لو زارني الطيف سلّيت الهموم به","ولو تغشى رقادي كان يغشاني",23,"ن",2,0],["لو زال بؤسي حظيت منه بما","أملّ قلبي من منتهى طلبه",24,"ب",2,0],["لو زهده نور يكون لكورت","شمس النهار به وسد المطلع",25,"ع",1,0],["لو زلزلت ناحيةٌ حلَّها","ما حرَّكت منزله الزلزله",26,"ل",2,0],["لَو زَارَني الحَبيبُ","شَهِدتُ بِالعيانِ",27,"ن",1,0],["لو زارنِي والصّبحُ في شمسِه","بلونها الفاقع في مِجْسَدِ",28,"د",1,0],["لَو زارَني مِنكُمُ خَيالٌ","أَبصَرَ مِنّي الخَيالَ الأَصغَر",29,"ر",1,1],["لَوْ زُرْتَنِي يا مُنْيَتي وَمَنِيَّتي","وَرَحمْتَ فَرْطَ تَلهُّبي وَتَلَهُّفي",30,"ف",2,0],["لو زين جنات وجنتيك بصدغ","كالعقرب في اللسع للعزائم حلال",31,"ل",1,0],["لو زانَت منه البرايا خنصراً","في القدرِ منهُ ما وفت عن خنصرِ",32,"ر",1,0],["لَوْ زِدْتَ قلبي فَوقَ ذا مِن أَذًى","ما كُنتَ عِندِي غَيرَ عَيني اليَمِينْ",33,"ن",1,0],["لو زيدت الشمس في ابراجها مائة","ما ذاد ذلك شيئاً في فضائلها",34,"ه",2,0],["لو زرتني لرأيت في الليل الضحى","يا ورد أيناسي الذكيّ وآسي",35,"ي",1,0],["لو زَجَّهُ الخيّاطُ في سَمٍّ الخيا","طِ من النحولِ جرى ولم يتوَقَّفِ",36,"ف",1,0],["لو زففنا إليك شمس المعالي","وجعلنا شهب السماء نثارا",37,"ر",2,0],["لو زرعنا الغباء فيك حصدنا","هُ، ذكاءً فأين ذاك الذكاء",38,"ا",2,0],["لو زارَني منه خيالٌ في الدجى","حذرَ التَّداني ظالماً عقرَ الكَرى",39,"ر",2,0],["لو زار طرف العقيلي","ما راح يندب طلوله",40,"ل",2,0],["لو زارنا يوماً لكنا كلنا","للقاه نسعى نسوة ورجالا",41,"ل",2,0],["لَو زُرتُموني في ظَلام الدُجى","لَكانَ ذا مِن عُمري حَسبي",42,"ب",2,0],["لو زُجر الدّهرُ عن إسائته","بسطوة منهُ راح ينزجرُ",43,"ر",1,0],["لو زيدَ عندكَ عُمرُ الدّهْرِ في عُمُري","ما كان إلاّ كلمْحِ الطَرفِ في القِصَرِ",44,"ر",1,0],["لو زحزحوا بابه قليلاً","حواك من كردفان عقر",45,"ر",1,0],["لو زارني لفضضت ختم رضابه","ما بغيتي في ورده أو ورده",46,"د",2,0],["لَو زُرتَنِيي وَوَصَلتَنِي لَحَيِيتُ مِن","نَفَحَاتِ وَصلِكَ وَامتَطَيتُ ذُرَى الطَّرَب",47,"ب",1,1],["لوزيرنا المولى فرنكو طالعٌ","يسمو السحاب بسعدهِ الميمونِ",48,"ن",1,1],["لو زارَ طيفُ خيالِهِ","للمُستهامِ الوالِهِ",49,"ل",2,1],["لو زار بيتك كل يومٍ عسكرٌ","أرضاهم لحظُ بعينك فاترُ",50,"ر",1,0],["لو زارني حلمُ اللقاءِ بغفوةٍ","لوجدتني في بحرِ حبِّك أغْرقُ",51,"ق",1,0],["لو زيد في الظل أو في النور بعضهما","مهما تضاءل بالتشويه غشّاها",52,"ا",3,0],["لو زعل لو شال غيضه واستضاق","ما يخرّبها وجرحه بالصميم",53,"م",1,0],["لو زِنْتها ذهَبًا وزدتَ لآلئًا","للغدرِ لاتنْسى ويَبْقىَ جَذْوهْ",54,"و",2,0],["لو زهرةٌ قبل الربيع تفتّحتْ","عصفورهُ سيكونُ أوّلُ مَنْ شَدَا",55,"د",2,0],["لوزيةُ الخَدَّين حين تنسَمت","عَبقَ العَبير تفجرت ريحانا",56,"ن",2,0],["لو زرت مقبرة الميسر عندها","لظننت عادا قوم هود الباني",57,"ن",2,0],["لوزية العينين هاكِ مواسمي","فأنا مجيرك والصديق مجيرُ",58,"ر",1,0],["لوزية العينين هاكِ محبتي","بيني وبينكِ أنهرٌ وبحورُ",58,"ر",1,0],["لوزية العينين وصلكِ عاصفٌ","إن الوصولَ مزلزلٌ وخطيرُ",58,"ر",1,0],["لوزية العينين لا تتهربي","(فالعشق أجملُ ما به التدميرُ)",58,"ر",1,0],["لو زارني طيفُهُ ما كنتُ أحسبهُ","إلا كضيفٍ نبت عن أهلهِ مزقُهُ",59,"ق",2,0],["لو زرتني طيفا لكنت محسّداً","أنتِ التى زارت منايَ بيقظتي",60,"ت",2,0],["لو زارني طيفُهُ ما كنتُ أحسبهُ","إلا كضيفٍ نبت عن أهلهِ حِقبهْ",61,"ق",3,0],["لو زُرْتَ أرضا في الوجودِ وجدْتَها","شاما وغنَّت للدنا اطرابَها",62,"ب",3,0],["لوزارة التقنين","من مال الفساد على الجياع!",63,"ع",1,0],["لو زان لي طرد الخشوف اللعايب","رديت لولا الشيب راعية يسحا",64,"ح",2,0],["لو زحزحَ الدولارُ سَنْ","تِيمَاً لكانَ بكم غِضابُ",65,"ب",1,0],["لو زرتم طيفا بليل في الكرى","لوجدتموه يئن من احبابه",66,"ب",2,0],["لو زارَ طيفكَ غافياتِ قَصائدي","أحيا بقلبي رائعاتِ جُماني",67,"ن",2,0],["لوزيةَ العينين لحظك ساحرٌ","يسبي قلوبًا في الهوى وعقولا",68,"ل",2,1],["لوزيةَ العينين أشكو لوعتي","أضحى فؤادي في الهوى متبولا",68,"ل",2,0],["لوزية العينين هل من رحمةٍ","تهدي السماء إلى العيون سيولا؟",68,"ل",2,0],["لو زيدَ قلبانِ فوقَ القلبِ نجمعها","لاخترتٌ أبقى طوالَ العمرِ هيمانا",69,"ن",2,1],["لوزانُ لا مثلها عينٌ قد اكتحلت","ولا رأت من صنوف الحُسنِ ألوانا",70,"ن",2,0],["لوزيَّة العينينِ فوقَ جفونها","رمشٌ يشدُّ به الفؤاد ويصلبُ",71,"ب",1,0],["لو زل مرة تحمّل وادمح الزلّة","لو ثقلها مثل متن طويق وصخورة",72,"ر",2,0],["لو زاد حجم السعد عن حجم الأسى","أيضا رجونا الحزن أن لا يَغْرِبا",73,"ب",2,0],["لو زُلْتِ يا أمُّ عنّا قد تفارقنا","روحُ الكفاءة بل قد نفقد النبضا",74,"ض",2,0],["لوزيةُ العينينِ ساهٍ جفنُها","ما إن يداني الصحوَ حتى يَنعَسا",75,"س",2,0],["لو زارت يوماً كسرى","أضحى في الهوى قسر",76,"ر",1,0],["لوزعل أورضا ، حبه لقلبي غناته","السعادة لعمره والشقاء لي ، أنا",77,"ن",2,0],["لَو زَمَها تَمتخ جديلة زمامها","لِأَن الهَوا أَصلو هيام وَغَرام",78,"م",1,0]]}