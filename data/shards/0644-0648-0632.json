{"poems":[[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[27,"أرق العيون فنومهن غرار","https://www.aldiwan.net/poem5743.html","الكامل"],[78,"لو زرتنا لرأيت ما لم تعهد","https://www.aldiwan.net/poem14051.html","الكامل"],[85,"في الموت ما أعيا وفي أسبابه","https://www.aldiwan.net/poem63779.html","الكامل"],[45,"طيف الحبيب ألم من عدوائه","https://www.aldiwan.net/poem10198.html","الكامل"],[66,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[97,"قدم لبسيوني قريضك واعتذر","https://www.aldiwan.net/poem24384.html","الكامل"],[69,"قف وقفة المتألم المتأمل","https://www.aldiwan.net/poem28749.html","الكامل"],[105,"هتف النعي فما ملكت بياني","https://www.aldiwan.net/poem42093.html","الكامل"],[105,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[50,"قاس الهموم تنل بها نجحا","https://www.aldiwan.net/poem63980.html","الكامل"],[46,"لو زعمت نفسي الرشاد لها","https://www.aldiwan.net/poem23419.html","المنسرح"]],"verses":[["لو زرعنا بك البقاع حبوباً","لحصدنا النضار يوم الحصاد",0,"د",1,0],["لَو زُرتِنا لَرَأَيتِ حَولَ رِحالِنا","مِثلَ الحَنِيِّ أَمَلَّها الأَسفارُ",1,"ر",1,0],["لو زُرتَنا لَرَأيتَ ما لَم تَعهَدِ","ذَوبَ اللجَينِ خَليطَ ذَوبِ العَسجَدِ",2,"د",1,1],["لَو زايَلَ المَوتى مَحاجِرَهُم بِهِ","وَتَلَفَّتوا لَتَحَيَّروا كَضَبابِهِ",3,"ب",2,0],["لَو زارَ في غَيرِ الكَرى لَشَفاكَ مِن","خَبَلِ الغَرامِ وَمِن جَوى بُرَحائِهِ",4,"ا",3,0],["لَو زينَ عَصرُ آلِ عُبّادٍ بِهِ","لَم يَصِلِ المُلكُ إِلى المُعتَضِدِ",5,"د",1,0],["لو زعَّمُوكَ على الشباب جعلتَه","كالسيلِ يزخر في قويِّ عبابِهِ",6,"ب",2,0],["لو زرْتُها لفتحْتُ بابَ جنانِها","وأقولُ يا نفسُ اطمئني وادخلي",7,"ي",1,0],["لو زِيد ركنٌ في الصلاةِ على يدي","لجعلتُه من أَوثق الأركانِ",8,"ن",1,0],["لو زالتِ الأرضُ أو حَالتْ جَوانِبُها","بِمَنْ عليها مِنَ الأقوامِ لم نَحُلِ",9,"ل",1,0],["لَو زادَهُ رَبّي لِخُلَّتِهِ","حُبّاً كَعَينِ الذَرَّةِ اِفتَضَحا",10,"ح",2,0],["لَو زَعَمَت نَفسِيَ الرَشادَ لَها","حِلفاً لَكَذَّبتُها بِمَزعَمِها",11,"م",3,1]]}