{"poems":[[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[27,"أرق العيون فنومهن غرار","https://www.aldiwan.net/poem5743.html","الكامل"],[78,"لو زرتنا لرأيت ما لم تعهد","https://www.aldiwan.net/poem14051.html","الكامل"],[85,"في الموت ما أعيا وفي أسبابه","https://www.aldiwan.net/poem63779.html","الكامل"],[45,"طيف الحبيب ألم من عدوائه","https://www.aldiwan.net/poem10198.html","الكامل"],[66,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[97,"قدم لبسيوني قريضك واعتذر","https://www.aldiwan.net/poem24384.html","الكامل"],[69,"قف وقفة المتألم المتأمل","https://www.aldiwan.net/poem28749.html","الكامل"],[105,"هتف النعي فما ملكت بياني","https://www.aldiwan.net/poem42093.html","الكامل"],[105,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[50,"قاس الهموم تنل بها نجحا","https://www.aldiwan.net/poem63980.html","الكامل"],[46,"لو زعمت نفسي الرشاد لها","https://www.aldiwan.net/poem23419.html","المنسرح"],[116,"من الهوى آه","https://www.aldiwan.net/poem40430.html","عموديه"],[143,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[161,"قالت سليمى ابشر فموعدنا الغد","https://www.aldiwan.net/poem58811.html","الكامل"],[205,"انظر إلى غنج هذا الفاتن الغنج","https://www.aldiwan.net/poem53348.html","البسيط"],[283,"أنا بالغزلان وبالغزل","https://www.aldiwan.net/poem32672.html","المتدارك"],[283,"تعطفا قد فؤادي الأسف","https://www.aldiwan.net/poem32701.html","الرجز"],[286,"الناصر المحمود أنت","https://www.aldiwan.net/poem39401.html","مجزوء الكامل"],[354,"لوزي جلق شيء","https://www.aldiwan.net/poem39987.html","المجتث"],[430,"لك الهناء بنيل المجد والنعم","https://www.aldiwan.net/poem40798.html","البسيط"],[433,"أهلا بطيف في الدجنة أوبا","https://www.aldiwan.net/poem12551.html","الكامل"],[433,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[438,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[438,"أضر بي إذا جد في كعبه","https://www.aldiwan.net/poem2591.html","المنسرح"],[442,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[465,"ومدع تكذبه نفسه","https://www.aldiwan.net/poem3434.html","عموديه"],[539,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[552,"ما ضر من زار وجنح الدجى","https://www.aldiwan.net/poem47837.html","السريع"],[557,"لو زارني منكم خيال","https://www.aldiwan.net/poem2485.html","مخلع البسيط"],[587,"أتراك بالهجران حين فتكت في","https://www.aldiwan.net/poem17606.html","الكامل"]],"verses":[["لو زرعنا بك البقاع حبوباً","لحصدنا النضار يوم الحصاد",0,"د",1,0],["لَو زُرتِنا لَرَأَيتِ حَولَ رِحالِنا","مِثلَ الحَنِيِّ أَمَلَّها الأَسفارُ",1,"ر",1,0],["لو زُرتَنا لَرَأيتَ ما لَم تَعهَدِ","ذَوبَ اللجَينِ خَليطَ ذَوبِ العَسجَدِ",2,"د",1,1],["لَو زايَلَ المَوتى مَحاجِرَهُم بِهِ","وَتَلَفَّتوا لَتَحَيَّروا كَضَبابِهِ",3,"ب",2,0],["لَو زارَ في غَيرِ الكَرى لَشَفاكَ مِن","خَبَلِ الغَرامِ وَمِن جَوى بُرَحائِهِ",4,"ا",3,0],["لَو زينَ عَصرُ آلِ عُبّادٍ بِهِ","لَم يَصِلِ المُلكُ إِلى المُعتَضِدِ",5,"د",1,0],["لو زعَّمُوكَ على الشباب جعلتَه","كالسيلِ يزخر في قويِّ عبابِهِ",6,"ب",2,0],["لو زرْتُها لفتحْتُ بابَ جنانِها","وأقولُ يا نفسُ اطمئني وادخلي",7,"ل",2,0],["لو زِيد ركنٌ في الصلاةِ على يدي","لجعلتُه من أَوثق الأركانِ",8,"ن",1,0],["لو زالتِ الأرضُ أو حَالتْ جَوانِبُها","بِمَنْ عليها مِنَ الأقوامِ لم نَحُلِ",9,"ل",1,0],["لَو زادَهُ رَبّي لِخُلَّتِهِ","حُبّاً كَعَينِ الذَرَّةِ اِفتَضَحا",10,"ح",2,0],["لَو زَعَمَت نَفسِيَ الرَشادَ لَها","حِلفاً لَكَذَّبتُها بِمَزعَمِها",11,"م",3,1],["لو زار في ليل","بالنوم مولاه",12,"ا",2,0],["لو زرانى طيفُهمُ ما درى","من الضنا أنىَ في مضجعى",13,"ع",2,0],["لو زارني فيها محا الصبح الدجا","عجلاً كما يمحو خطا الخطِّ اليدُ",14,"د",1,0],["لو زُلزل القلب زلزالاً لما انزعجت","مودَّتي لك فاثبت غير مُنزعجِ",15,"ج",1,0],["لَو زادَ البَحرُ فَغَطّى السَّه","لَ مِنَ الأَرضين مَعَ الجَبَلِ",16,"ل",1,0],["لَو زُرتُكُم أَسعى عَلى جَمرِ الغَضا","لَم يَهَبِ الحَريقَ قَلبي المُدنَفُ",17,"ف",1,0],["لو زرت نلت من الملي","ك عناية تحيي الاثر",18,"ر",1,0],["لوزيّ جلّق شَيء","لَهُ يَعزّ الوُصولُ",19,"ل",1,1],["لو زرت بحراً غدا عذباً لشاربهِ","وفاز راكبهُ بالأمن والسلمِ",20,"م",1,0],["لو زارَني مستيقِظاً لشفى جوًى","بين الجوانح قد غدا متلهِّبا",21,"ب",2,0],["لو زارني الخيالُ في المنامِ","لم يرَني من شدّةِ السَّقامِ",22,"م",1,0],["لو زارني الطيف سلّيت الهموم به","ولو تغشى رقادي كان يغشاني",23,"ن",2,0],["لو زال بؤسي حظيت منه بما","أملّ قلبي من منتهى طلبه",24,"ب",2,0],["لو زهده نور يكون لكورت","شمس النهار به وسد المطلع",25,"ع",1,0],["لو زلزلت ناحيةٌ حلَّها","ما حرَّكت منزله الزلزله",26,"ل",2,0],["لَو زَارَني الحَبيبُ","شَهِدتُ بِالعيانِ",27,"ن",1,0],["لو زارنِي والصّبحُ في شمسِه","بلونها الفاقع في مِجْسَدِ",28,"د",1,0],["لَو زارَني مِنكُمُ خَيالٌ","أَبصَرَ مِنّي الخَيالَ الأَصغَر",29,"ر",1,1],["لَوْ زُرْتَنِي يا مُنْيَتي وَمَنِيَّتي","وَرَحمْتَ فَرْطَ تَلهُّبي وَتَلَهُّفي",30,"ف",2,0]]}