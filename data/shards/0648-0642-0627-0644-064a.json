{"poems":[[90,"رأيت إبليس عدو البشر","https://www.aldiwan.net/poem44468.html","السريع"],[93,"أروي لكمعن شاعر ساحير","https://www.aldiwan.net/poem62815.html","عموديه"],[87,"تم لبعض الناس فيما قد سلف","https://www.aldiwan.net/poem7764.html","الرجز"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[87,"كان لبعض الناس ببغاء","https://www.aldiwan.net/poem8011.html","الرجز"],[87,"ظبي رأى صورته في الماء","https://www.aldiwan.net/poem8043.html","الرجز"],[68,"رأيت في النوم أبا مرة","https://www.aldiwan.net/poem38645.html","السريع"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[93,"هي","https://www.poetsgate.com/ViewPoem.aspx?id=53394",""],[113,"قد ظن أنه عظيم","https://www.aldiwan.net/poem16560.html","مخلع البسيط"],[164,"أيرجو أن يزور وأن يزارا","https://www.aldiwan.net/poem58952.html","الوافر"],[164,"وقفت على بيتين من أثقل الشعر","https://www.aldiwan.net/poem59177.html","الطويل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[190,"صديق لي ينفس عن عليل","https://www.aldiwan.net/poem43220.html","الوافر"],[376,"وقال يوما لعوادي وأضحكه","https://www.aldiwan.net/poem56974.html","البسيط"],[438,"ما ضر ذاك الريم ألا يريم","https://www.aldiwan.net/poem12725.html","السريع"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126877","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86862","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86850","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86655","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48630","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77631","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77539","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77535","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77531","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77483","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77475","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77660","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77588","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77584","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77536","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77532","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77524","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77520","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77653","المنسرح"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77561","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77622","الرجز"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1198,"","https://poetry.dctabudhabi.ae/diwan/poem/96404","المتقارب"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27981","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60906","الطويل"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58398","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200530","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112487","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132794","الرجز"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138766",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62743","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83173","المجتث"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136428",""],[4755,"وطن على السرير","https://www.poetsgate.com/ViewPoem.aspx?id=204338",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5488,"يابارق من جدا الشرق سناي","https://www.poetsgate.com/ViewPoem.aspx?id=100728",""],[5605,"ستُونَ عَامًا","https://www.poetsgate.com/ViewPoem.aspx?id=160307",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""]],"verses":[["وقال يا خُنزُب بادر إلى","رومة وأدخلها قبيل السَحَر",0,"ر",1,0],["وَقالَ يا صَحبُ عَلى ذِكرُكُم","أَملَءُها حُبّاً وَأَحسوها",1,"ه",2,0],["وقال يا صاحب هذه الليلة","سألتك الموت ولا ذى الدوله",2,"ه",1,0],["وَقالَ يا قَوم اِتَبِعوا واليكُم","هَذا الخَليفَةُ اِبنُ بِنت المُصطَفى",3,"ا",1,0],["وَقالَ يا مَليكَةَ الطُيورِ","وَيا حَياةَ الأُنسِ وَالسُرورِ",4,"ر",1,0],["وَقالَ يا خالِقَ هَذا الجيدِ","زِنهُ بِعِقدِ اللُؤلُؤِ النَضيدِ",5,"د",1,0],["وَقالَ يا بُشراكُمُ بِالَّذي","غَيَّبتُمُ عَن ذِكرِهِ بِالعَيانِ",6,"ن",1,0],["وَقالَ يا قَومُ اِسمَعوا كَلامي","لا تُسرِعوا ظُلماً إِلى مَلامي",7,"ي",1,0],["وقال : يا صحب على ذكركم","أملأها حبّا وأحسوها",8,"ه",2,0],["وَقالَ يَفقد بَعدَ حين","في عام أَرختهُ غُلاما",9,"م",2,0],["وقال يعيش بعدي وهو يدري","بأَن عليَّ في بقياه عارا",10,"ر",2,0],["وقال يقين الكفر يغشاه من نهى","وحذر منها وهي موهومة الكفر",11,"ر",1,0],["وقال يحل الحق في كل صورة","تجلى عليها فهي إحدى المظاهر",12,"ر",1,0],["وقال يموت الكافرون جميعهم","وقد آمنوا غير المفاجا المعاذر",12,"ر",1,0],["وقال يموت قلت نعم لأني","ارى معنى الحراك هو السكون",13,"ن",1,0],["وقالَ يَوماً لِعُوَّادِي وأضحَكهُ","ما بِي وقَد كادَ لَولا الحُبُّ يُبكِيهِ",14,"ه",1,1],["وقال يا عبدَ الحميدِ ادّرِعْ","من بعدِ هذا اليومِ ثوبَ الذَميمْ",15,"م",1,0],["وقال يوما وحميرا قائمة","سوف تقاتلين هذا ظالمة",16,"ه",1,0],["وقال يوما لابن عباس وقد","خلا به لا يسمعن منك أحد",16,"د",1,0],["وقال يا نور عيني للمخيّم عُد","فأنتَ لي اليوم مثل الروح في البدنِ",17,"ن",1,0],["وَقالَ يا أَيُّها الصَدر الهمام وَمَن","أَضحى بِهِ العَدل في الآفاق مُنتَشِرا",18,"ر",2,0],["وَقال يا وَيح مَغرور بِمنصبه","أَما له في قبيل العَزل إِنذار",19,"ر",1,0],["وَقال يا لَيت قَومي يَعلَمون بِما","أوتيت مِن رَفع مِقدار وَخَيرات",20,"ت",1,0],["وقال يا عقد أنَّى فرّ قاتلها","بل كيف فارقت ذاك الجيد والنحَرا",21,"ر",2,0],["وَقالَ يا خرفان ذا المراحِ","إِستَمعوا قَولي بِلا مِزاحِ",22,"ح",1,0],["وَقالَ يا ذئب عَرَفنا الحَقّا","وَالحَيوان قَد أَرانا صدقا",23,"ق",2,0],["وَقالَ يا قَوم أَعينوني عَلى","خَطبٍ جَسيم بينَنا قَد نَزَلا",24,"ل",2,0],["وَقالَ يا تِلكَ الجُسُوم الباليه","وَمن خلوا مِن السِنين الخاليه",24,"ه",1,0],["وَقالَ يا تمثال ذا الغُلام","أَعطاك فَخراً قلم الرَسام",25,"م",1,0],["وَقالَ يا حصانُ لي تَعالَ","لا قَيدَ في الرجل وَلا شكالا",26,"ل",2,0],["وَقالَ يا غراب يا ابن قَيصَر","وَجهك هَذا أَم ضِياءُ القَمرِ",27,"ر",1,0],["وَقالَ يا لَيل بدون القيمة","فسقطت مِن فَمه الغَنيمة",27,"ه",1,0],["وَقالَ يا مَوتُ تَعالى عِندي","وَاِذهب بِروحي خارِجاً مِن جَسَدي",28,"ي",1,0],["وَقالَ يا موت عَلامَ تفجَأُ","أَلَيسَ لي في الناس مِنكَ مَلجَأُ",29,"ج",2,0],["وَقالَ يا أَبناء جنسي إِنَّني","بِالستر مِن رَب العِماد مُغتَني",30,"ي",1,0],["وَقالَ يا قَوم انظرو ما وَقَعا","إِن الَّذي نَصَّبتموه وَقَعا",31,"ع",2,0],["وَقالَ يا بلبلُ ماذا تَصنَع","وَفي بِلاد الناس لم لا تَطلع",32,"ع",1,0],["وَقالَ يا ذا المال وَالخَزينه","وَمَن حَوى في البَيتِ كُلَّ زينه",33,"ه",1,0],["وَقالَ يا ضَيغم لم لا تَستَحي","أَنتَ كَبير في الوحوش ملتحي",34,"ي",1,0],["وَقالَ يا عشق قُم تَأَمَّل","ما تَلعَبُ الريحُ وَالغُصونُ",35,"ن",1,0],["وَقالَ يا ديك أَتيتُ بخبر","أَحلى مِن الرِياض في وَقت المَطَر",36,"ر",1,0],["وَقالَ يا كَلب الديار اُخرج لي","فَإِنَّني جئتُ هُنا بِرجلي",37,"ي",1,0],["وقال يا مولاى لست أدري","لأنّ ساعتى لدى الساعاتى",38,"ت",2,0],["وقال يجوز التداوي بها","وكلّ عليل بأشجانه",39,"ن",2,0],["وَقالَ يا جاهل عَمّ تَسأَل","ألست تَدري أَي شَيء أفعل",40,"ل",1,0],["وقال يا عبدُ كُن حفيظاً","لكلِّ ما أنت قد جمعتا",41,"ت",2,0],["وقال يزيد الفخر شمس ابن مالك","أبا اللهُ ألقى داهناً أتكحل",42,"ل",1,0],["وَقالَ يَأتي نَحو شهرَزور","بِفِعلِهِ الضال وَقَول الزورِ",43,"ر",1,0],["وَقالَ يا ناسُ فَما التَدبيرُ","ما الفِعل ما القَول وَما التَقريرُ",43,"ر",1,0],["وَقالَ يا ناسُ أَلا أُخبِركُم","فَشَيخ الاِسلامِ بذا يُنبئكُم",43,"م",1,0],["وَقالَ يا ناسُ أَلا فَاِجتَمِعوا","وَحال كَركوك وَأربل اِسمَعوا",43,"ع",3,0],["وقالَ يا بأبي أَفديكَ مِن وَلَدٍ","لغيرِ ما سُمعتُه في الفِسقِ ما صَلُحا",44,"ح",2,0],["وقال يباهي إنّ ذا شعر والدي","أروم له نشراً على الأُدباء",45,"ا",2,0],["وقال يدارى ظلمه أيّ ضامن","لسكنى تعرّت عن سرير وعن كرسي",46,"س",2,0],["وقال يا بطيخ قد جزت المدى","ان المسود لا يباهي السيدا",47,"د",2,0],["وقال يا رقي يا رقي","يا بارد اللهجة يا خلي",47,"ي",1,0],["وَقَالَ يَا نُسكُ تَرحَّل فَقَد","بُعتُ رَشَادي عِندَهَا بِالضَّلال",48,"ل",1,0],["وقال يا ليتني من بعضِهم بَدَلٌ","فهلْ تَراكَ قَويَّ العزْمِ في البَدَلِ",49,"ل",1,0],["وقال يا أنياس يا عضيدي","أنظر فقد أبصرت من بعيد",50,"د",1,0],["وقال يا أماه ليست سوى","تحفة ربٍّ جاد فيما أجاد",51,"د",1,0],["وَقالَ يا قَومُ حَسبي","بِنَثر أَنطُونَ عِقدا",52,"د",2,0],["وقال يوسف في شطر يؤرخه","لله جامعنا المشهور بالعمري",53,"ر",2,0],["وقَالَ يَرثِي نَفسَهُ، مُتعَبَا:","ما أَسهَلَ الشَّكوى، وما أَصعَبَا",54,"ب",2,1],["وقال يا ابن سلام سر اليّ ودع","عرش العراق وإن قد كنت واليها",55,"ي",3,0],["وقال يا بنت إسحاق الفتية من","فاقت جمالا وإجلالا وتنزيها",55,"ي",3,0],["وقال يقول الله جل ثناؤه","وقال رسول الله نصاص محتما",56,"م",2,0],["وقالي مقيد مسنسل ومحزاي","في سناسل الود في ود خله",57,"ل",2,0],["وقال يا قومُ لا أفق سيجمعنا","(إذا استوت عندنا الأنوارُ بالظُّلَمِ )",58,"م",1,0],["وقال يا على أنت وارثي","وأنت قاضي عدتي ومغرمي",59,"م",2,0]]}