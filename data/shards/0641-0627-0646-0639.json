www.aldiwan.net/poem60180.html","الكامل"],[468,"الفجر بين الليل والصبح","https://www.aldiwan.net/poem60306.html","البسيط"],[468,"عرائس القضب تجلى","https://www.aldiwan.net/poem60417.html","المجتث"],[468,"نور الصباح مسبل الأطناب","https://www.aldiwan.net/poem60429.html","الرجز"],[468,"ماء عناقيد العنب","https://www.aldiwan.net/poem60483.html","مجزوء الرجز"],[468,"لا تغفلن عن اللذات والطرب","https://www.aldiwan.net/poem60491.html","البسيط"],[468,"قد شمرت أطنابها الظلماء","https://www.aldiwan.net/poem60531.html","البسيط"],[493,"فمن نظر يسارع في صلاحي","https://www.aldiwan.net/poem67350.html","الوافر"],[504,"أباهي بوجد قد تمكن في الحشا","https://www.aldiwan.net/poem38408.html","الطويل"],[505,"الحسد","https://www.aldiwan.net/poem61088.html","البسيط"],[514,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[515,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[515,"قليل لك المدح الذي بك فخره","https://www.aldiwan.net/poem12151.html","الطويل"],[515,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[515,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[538,"بعودتك الحمراء تم لها القصد","https://www.aldiwan.net/poem48240.html","عموديه"],[551,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[551,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[551,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[551,"لو شئت يوم البين أسعفتني","https://www.aldiwan.net/poem47328.html","السريع"],[551,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[551,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[551,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[551,"سقى دارها حيث استقرت بها النوى","https://www.aldiwan.net/poem47910.html","الطويل"],[551,"زعازع ثم نكب","https://www.aldiwan.net/poem48102.html","الطويل"],[558,"إن الوجود بموجوداته امتزجا","https://www.aldiwan.net/poem34689.html","البسيط"],[562,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[567,"أناس أعرضوا عنا","https://www.aldiwan.net/poem69485.html","الهزج"],[567,"رضا المتجني غاية ليس تدرك","https://www.aldiwan.net/poem69559.html","الطويل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"أيا بصري لا تنظرن إلى بصرى","https://www.aldiwan.net/poem2725.html","الطويل"],[575,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"],[586,"لا غرو إن هز عطفي نحوك الطرب","https://www.aldiwan.net/poem17413.html","البسيط"]],"verses":[["فَإِن عاوَدوا رَجمي بِغَيبٍ فَإِنَّها","جَنادِلُ عِندي مِلءُ كَفِّ المُراجِمِ",0,"م",1,0],["فَاِنعَق بِضَأنِكَ عَن أَناطِحِهِ","وَدَعِ الغَميرَ تَلُسُّهُ الإِبِلُ",1,"ل",1,0],["فَإِن عِشتُ أَو إِن مُتُّ فَاِذكُر بِشارَتي","وَأَوجِب بِها حَقّاً عَلَيكَ مُحَقَّقا",2,"ق",2,0],["فَإِنَّ عَصا الدَهرِ لَمّا تَدَع","سِياقَ الأُمورِ لِغاياتِها",3,"ت",3,0],["فَإِنَّ عِناني في يَمينِ مُعَوَّدٍ","عَلى عُقَبِ الأَيّامِ قَودَ الأَعِنَّةُ",4,"ه",1,0],["فانعم هُذَيمُ بِعَيشٍ طابَ مَشرَعُهُ","وابلُغ بِهِ بَعضَ ما تَهوى وَتَلتَمِسُ",5,"س",1,0],["فَإِنَّ عَناءَ المُسْتَنيمِ إِلى الأذى","بِحيْثُ يَذِلُّ الأكْرَمونَ طَويلُ",6,"ل",1,0],["فَإنَّ على الله نَيْلَ الَّذي","سَعَيْنا لَهُ وَعَلَيْنا الطَّلَبْ",7,"ب",1,0],["فَاِنعَم بِجَدٍّ لا يَضِر","كَ النُوكُ ما أُعطيتَ جَدّا",8,"د",2,0],["فَإِنَّ عَيني عَلى فَوزٍ لَباكِيَةٌ","وَإِنَّ قَلبي إِلى فَوزٍ بِأَشواقِ",9,"ق",1,0],["فَإِنْ عَرَفَ الأَقْوَامُ حَقَّكَ وُفِّقُوا","وَإِنْ جَهِلُوا بَاءُوا بِصَفْقَةِ خُسْرَانِ",10,"ن",1,0],["فَإِنْ عَدَّ تَسْكَاباً مَعَالِمَ أُنْسِهَا","وَحَيَّى بِمَسْرَاهَا هِضَابا وَغِيطَانَا",11,"ن",2,0],["فإنْ عشْتُ أُبْلِغْ فيكَ نفْسي عُذْرَها","وإنْ لمْ أعِشْ فاللهُ يجْزيكَ منْ بَعْدي",12,"ي",1,0],["فانْعَمْ بعادَتِكَ الحُسْنى فمِثْلُكَ مَنْ","أجْرى العَوائِدَ حتّى في الهَدِيّاتِ",13,"ت",1,0],["فَإِنَّ عِتابي كُلَّ يَومٍ لسَوءةٍ","وَإِنّي لمَتروكٌ إِذا لا أُعاتِبُ",14,"ب",1,0],["فَإِن عاقَتِ الأَقدارُ فَالنَفسُ حُرَّةٌ","وَإِن تَكُنِ العُتبى فَأَحرِ بِها أَحرِ",15,"ر",1,0],["فَأَنعِم بِالقَبولِ فَرُبَّ نُعمى","أَعَدتَ بِها دُجى لَيلي نَهارا",16,"ر",2,0],["فانعم صباحاً واغتنم","أوقاتَه المجتمعَهْ",17,"ع",2,0],["فإن عماد بيت المجد خُلْق","حكى في أنف ناشفه العبيرا",18,"ر",2,0],["فَإِنَّ عِقالاً وَالحُتاتَ كِلاهُما","تَرَدّى بِثَوبَي غادِرٍ وَتَأَزَّرا",19,"ر",2,0],["فَإِن عَفَوتَ فَضَلتَ الناسَ عافِيَةً","وَإِن وَقَعتَ فَما وَقعٌ كَما تَقَعُ",20,"ع",1,0],["فَإِن عِشنا ذَخَرناها لِأُخرى","وَإِن مُتنا فَمَوتاتُ الرِجالِ",21,"ل",1,0],["فَإِن عِشتُ فَالطَعنُ الَّذي يَعرِفونَهُ","وَتِلكَ القَنا وَالبيضُ وَالضُمَّرُ الشُقرُ",22,"ر",1,0],["فَإِن عُدتُ يَوماً عادَ لِلحَربِ وَالعُلا","وَبَذلِ النَدى وَالجودِ أَكرَمُ عائِدِ",23,"د",1,0],["فانعم بما شادَتْ يداك ودُمْ على","مرِّ الزمان ممدَّحَ الآلاء",24,"ا",2,0],["فإن علقت كفي بنعماك عروة","فقد هانَ من عيشي بيمنك مصعب",25,"ب",1,0],["فإن عذلت أبا ذرّ الثناء فقد","عذرت من خاطر العليا أبا لهب",26,"ب",1,0],["فانعم به وبأمداح مشعشعة","مديرها في صباح الفطر مبرور",27,"ر",1,0],["فانعم به واسق الضحايا والعدى","نحراً فإن جميعهم أنعام",28,"م",1,0],["فإن عَصَتْ بَدَهاتِ الرأي مُعْضِلةٌ","أذكى لها فِكَراً أذكى من اللّهبِ",29,"ب",1,0],["فإنْ عَفَوْتَ فما تنْفَكُّ مُرْتَهناً","شكْراً بتقليد نُعْمَى بعْدَ تقليدِ",30,"د",1,0],["فإن عدا والريح في وجهه","لم ينبعث في وجهه إصبعا",31,"ع",2,0],["فانعمْ بحُبلاكَ واعلمْ أنها جَزَرٌ","للنيكِ قد فُعلتْ فيها الأفاعيلُ",32,"ل",1,0],["فإن عيّرتَهم بالنتن قالوا","كذا نكهاتُ أفواه القُرومِ",33,"م",1,0],["فَاِنعَق بِضَأنِكَ يا جَريرُ فَإِنَّما","مَنَّتكَ نَفسُكَ في الخَلاءِ ضَلالا",34,"ل",2,0],["فَإِنَّ عَواقِبَ الأَيّامِ تُخشى","دَوائِرُها وَتَنتَقِلُ الدِيارُ",35,"ر",1,0],["فَإِن عاشَ هَمّامٌ لَنا فَهوَ رَحمَةٌ","مِنَ اللَهِ لَم تُنفَس عَلَينا فُضولُها",36,"ل",3,0],["فَإِنَّ عُرىً شَدَدناها وِثاقاً","نَموتُ وَلا نَطيقُ لَها اِنفِصاما",37,"م",2,0],["فَإِن عاقَبتَني فَجَزاءُ مِثلي","وَإِن تَصفَح فَلَيسَ مِن الغَريبِ",38,"ب",1,0],["فإنْ عُدْتُمُ عُدْنَا وإن تُظهروا الغِنى","عن الودِّ كنَّا عن وِدادكمُ أغنَى",39,"ن",2,0],["فإنْ عشتُ أحوِ المُلكَ لم يحوِ مثلَهُ","يدا ملكٍ في العالمينَ هُمامِ",40,"م",1,0],["فإنْ عُدْتمُ يوماً تُريدونَ مُهْجَتِي","تمنَّعتُ إلا أنْ يُقامَ كفيلُ",41,"ل",1,0],["فإنْ عِشتُ لم أبرَحْ بلادي وإن أمُتْ","فلا ماتَ بعدي في الزمانِ غريبُ",42,"ب",1,0],["فَإِنَّ عَلى بَغدادَ ظِلَّ غَمامَةٍ","بِجودِ أَبي إِسحاقَ يَهمي انثِجاجُها",43,"ج",3,0],["فَاِنعَم سَليمَ الأَقطارِ تَغتَبِقُ ال","صَهباءَ مِن دَنِّها وَتَصطَبِحُ",44,"ح",1,0],["فَإِن عِشتَ مَحموداً فَمِثلي بَغى الغِنى","لِيَكسِبَ مالاً أَو يُنَث لَهُ حَمدُ",45,"د",1,0],["فَاِنعَم بِيَومِ الفِطرِ عَيناً إِنَّهُ","يَومٌ أَغَرُّ مِنَ الزَمانِ مُشَهَّرُ",46,"ر",1,0],["فإن عدُّوا الأكابرَ من عَدِيٍّ","حَسِبتُهُمُ يعُدُّون الجِبالا",47,"ل",2,0],["فإن عَجِزَ الأقوامُ أو بانَ نقصُهم","فليس لمن بانَتْ فضيلتُه ذَنبُ",48,"ب",1,0],["فَإِن عَذَّبَتني فَالذَنبُ مِنّي","وَإِن تَغفِر فَأَنتَ بِهِ جَديرُ",49,"ر",1,0],["فَإِنَّ عِندي فَضلَةً","مِن جودِ آلِ أُرتُقِ",50,"ق",1,0],["فَإِن عَتَبتُم عَلى بُعدِ المَزارِ أَقُل","نِظامَ مَن قالَ قَبلي قَولَ مُعتَذِرِ",51,"ر",1,0],["فإِن عَرضت له الذكرُ الخوالي","رأيتَ الكونَ في عينيه غاما",52,"م",2,0],["فإن عدتُ وحدي بعد رحلتنا معاً","شريداً على الدنيا ذليلاً على الدهر",53,"ر",1,0],["فانعمْ بعيدٍ سعيدٍ قد بَسَطْتَ له","للمعتفين يميناً تَبْسُطُ النعما",54,"م",2,0],["فانْعمْ بعيدٍ قد أتى ناظماً","كلُّ لسانٍ لك فيه امتداح",55,"ح",1,0],["فَإِن عَلَتنِيَ مِن أَزمانِهِ ظُلَمٌ","صَبَرتُ نَفسِيَ حَتّى تُكشَفَ الظُلَمُ",56,"م",1,0],["فَاِنعَم فَكُنيَتُكَ الَّتي كُنّيتَها","فَألٌ جَرى لَكَ بِالسَعادَةِ فَاِسعَدِ",57,"د",1,0],["فانعدمَتْ صورتُهُ","مِنْ شؤمِ تلكَ الصورِ",58,"ر",1,0],["فَإِنَّ عَهدي بِهِ وَاللَهُ يَحفَظُهُ","وَإِن أَتى الذَنبَ مِمَّن يَكرَهُ العَذلا",59,"ل",2,0],["فانعِمي نَعمَةً تُجزَي بِأَحسَنِها","فَرُبَّما مَسَّنى مِن أَهلِكِ النِعَمُ",60,"م",1,0],["فَإِن عُدَّ مَجدٌ فاضِلٌ عَدَّ مِثلَهُ","وَإِن أَثَّلوا أَدرَكتُهُم بِأَثيلِ",61,"ل",1,0],["فَإِن عَدا ذاكَ فَبازٌ أَبيَضُ","وَفَرَسٌ حافِرُهُ مُفَضفَضُ",62,"ض",1,0],["فإِنَّ عِنْدَكُمُ تَوْراتُهُمْ صَدَقَتْ","ولمْ تُصَدَّقْ لكمْ منهمْ أناجِيلُ",63,"ل",1,0],["فَإِن عَدَلتُ يَميناً","خَشيتُ وَقعَ وُعودِه",64,"د",2,0],["فَاِنعَم بِها قَبلَ رائِعاتٍ","لا خَمرَ فيها وَلا خُمارُ",65,"ر",1,0],["فَإِن عاتَبتُها فيهِ","أَحالَتني عَلى القَدَرِ",66,"ر",1,0],["فَإِن عَذَّبتَني فَبِسوءِ فِعلي","وَإِن تَغفِر فَأَنتَ بِهِ جَديرُ",67,"ر",1,0],["فإن عدمَ استراحَ براحتيهِ","ولم يخشَ الأثامَ ولا الشنار",68,"ر",1,0],["فَإِنَّ عَبيداً وَاِبنَ هِندٍ وَتُبَّعاً","وَأُسرَةَ كِسرى لِلمَليكِ عَبيدُ",69,"د",1,0],["فَإِنَّ عِلباءً المَدعوَّ في أَسَدٍ","ساقَ الحِمامَ فَأَسقى ماءَهُ حُجُرا",70,"ر",2,0],["فَإِنَّ عُطارِداً في الجَوِّ أَولى","بِأَن يَزِنَ الكَلامَ وَأَن يُقَفّي",71,"ي",1,0],["فَإِنَّ عَدِيّاً فَرَّ مِن خَوفَِ نَكبَةٍ","وَآضَت سَبِيّاً أُختُهُ بِنتُ حاتِمِ",72,"م",1,0],["فإنْ عَشِقَتْ صَوارِمُكَ الهَوادي","فلا عَدِمَتْ بمنْ تَهَوى اتّصَالا",73,"ل",2,0],["فإنْ عُدتَ فالمجرُوحُ تُؤسَى جراحُه","وإنْ لم تَعُدْ مُتْنا ونحنُ كِرامُ",74,"م",1,0],["فإنْ عُدّ ضَحضاح الحِمامِ صَوارِمٌ","عُدِدْنَ بُحُوراً للرّدى وغِمارا",75,"ر",2,0],["فإن عذرتْ شمسُ الضُّحى في نجومِها","على الجوَّ كان القصرُ في الشمس أعذرا",76,"ر",2,0],["فإنَّ عَيني بَعدُ مِن","رؤيتها لَم تَشبَع",77,"ع",1,0],["فانْعَمْ أَبا عامِرٍ بنِعْمَتِهِ","واعْجَبْ لأَمْرَيْنِ فيه قد جُمِعَا",78,"ع",2,0],["فَإِن عايَنَت عَيني المَطايا وَرَكبُها","فَرَشتُ لَدى أَخفافِها صَفحَةَ الخَدِّ",79,"د",1,0],["فَانْعَمْ بِخَيْرِ وِلايَةٍ وَلّاكَها","رَبُّ الْعِبادِ بِرَغْمِ كُلِّ رَقِيبِ",80,"ب",1,0],["فَانعَم وَطِب وَالهُ وَاطرَب وَاسعَ وَاعلُ وَسُد","وَاشْرَبْ وَغَنِّ وَتِهْ وَالْعَبْ وَهِمْ وَطِرِ",81,"ر",1,0],["فَإِنْ عَادَ لِي بالْوُدِّ عُدْتُ وَإِنْ أَبَى","صَبَرْتُ لأَرْعَى ذِمَّةَ الْوُدِّ بِالصَّبْرِ",82,"ر",1,0],["فَإِنْ عاشَ فَالْبِيدُ الدَّيَامِيمُ دَارُهُ","وإِنْ مَاتَ فَالطَّيْرُ الأَضَامِيمُ لَحْدُهُ",83,"د",2,0],["فَإِنْ عِشْتُ صافَحْتُ الثُّرَيَّا وإِنْ أَمُتْ","فَإِنَّ كَرِيماً مَنْ تَضُمُّ الصَّفَائِحُ",84,"ح",1,0],["فانْعَمْ بِعِزِّكَ يا ملِيكُ ولا تَزَلْ","تَحْوِي يَدَاكَ مَقالِدَ الْعَلْياء ِ",85,"