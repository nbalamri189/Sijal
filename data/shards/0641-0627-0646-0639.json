هو لنا حرب","https://www.aldiwan.net/poem51800.html","الطويل"],[58,"أيا من ليس لي منه مجير","https://www.aldiwan.net/poem31021.html","الوافر"],[66,"رو عظامي بسلا","https://www.aldiwan.net/poem38502.html","مجزوء الرجز"],[66,"ما عشت لا زاركم إلا ثناي وإن","https://www.aldiwan.net/poem40956.html","البسيط"],[97,"تعال نزف للثغرِ السلاما","https://www.aldiwan.net/poem24357.html","الوافر"],[97,"نقلت حياتي والحياة بنا تجري","https://www.aldiwan.net/poem24902.html","الطويل"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[80,"قم هاتها من كف ذات الوشاح","https://www.aldiwan.net/poem31520.html","السريع"],[44,"إن كان غيرك الإثراء والنعم","https://www.aldiwan.net/poem29673.html","المجتث"],[44,"داع دعا بلسان هاد مرشد","https://www.aldiwan.net/poem30532.html","الكامل"],[69,"ما حل فيها زحل","https://www.aldiwan.net/poem28048.html","مجزوء الرجز"],[31,"يا صاحبي قفا نستخبر الطللا","https://www.aldiwan.net/poem41850.html","البسيط"],[40,"حور بعثن رسولا في ملاطفة","https://www.aldiwan.net/poem42344.html","البسيط"],[22,"ألا آل ليلى أزمعوا بقفول","https://www.aldiwan.net/poem21653.html","الطويل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[48,"طاب الهوى لعميده","https://www.aldiwan.net/poem62606.html","مجزوء الكامل"],[48,"أعطتك ريحانها العقار","https://www.aldiwan.net/poem63265.html","مجزوء البسيط"],[48,"أراح الله من بصري","https://www.aldiwan.net/poem63327.html","مجزوء الوافر"],[48,"أيا من ليس لي منه مجير","https://www.aldiwan.net/poem63403.html","الوافر"],[48,"دع الأمطار تعتور الديارا","https://www.aldiwan.net/poem66573.html","الوافر"],[46,"أبيدة قالت للوعول مسرة","https://www.aldiwan.net/poem22328.html","الطويل"],[46,"إذا وفت لتجار الهند فائدة","https://www.aldiwan.net/poem22616.html","البسيط"],[46,"أيا شجر العرا أوسعت ريا","https://www.aldiwan.net/poem22995.html","الوافر"],[46,"مناطق غلمان وأحجال أنس","https://www.aldiwan.net/poem23366.html","الطويل"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[46,"لقد آن أن يثني الجموح لجام","https://www.aldiwan.net/poem23643.html","الطويل"],[46,"تخيرت جهدي لو وجدت خيارا","https://www.aldiwan.net/poem23644.html","الطويل"],[76,"ألما على قصر الخليفة فانظرا","https://www.aldiwan.net/poem39323.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85308","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30471","المنسرح"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9921","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42634","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42563","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42552","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42493","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50449","الرجز"],[106,"وطن ينادي أهله!","https://www.poetsgate.com/ViewPoem.aspx?id=179349",""],[77,"سقى علم الجنتين فالجزع فالبانا","https://www.poetsgate.com/ViewPoem.aspx?id=34162",""],[77,"سميى رسول الله أحييت مهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=33792",""],[77,"يا واحدَ الدّهرِ في خَلْقِ وفي خُلُقِ","https://www.poetsgate.com/ViewPoem.aspx?id=33563",""],[90,"الوطن والشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179071",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[90,"شباب يذوي !","https://www.poetsgate.com/ViewPoem.aspx?id=179111",""],[45,"وكان البعد عن ملح","https://www.poetsgate.com/ViewPoem.aspx?id=32918",""],[91,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=53276",""],[58,"أَيَا مَنْ لَيْسَ لِي مِنْهُ مُجيْرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15547&r=&rc=73",""],[31,"يا صاحبيّ، قفا نستخبرِ الطللا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19020&r=&rc=283",""]],"verses":[["فَإِن عاوَدوا رَجمي بِغَيبٍ فَإِنَّها","جَنادِلُ عِندي مِلءُ كَفِّ المُراجِمِ",0,"م",1,0],["فَاِنعَق بِضَأنِكَ عَن أَناطِحِهِ","وَدَعِ الغَميرَ تَلُسُّهُ الإِبِلُ",1,"ل",1,0],["فَإِن عِشتُ أَو إِن مُتُّ فَاِذكُر بِشارَتي","وَأَوجِب بِها حَقّاً عَلَيكَ مُحَقَّقا",2,"ق",2,0],["فَإِنَّ عَصا الدَهرِ لَمّا تَدَع","سِياقَ الأُمورِ لِغاياتِها",3,"ت",3,0],["فَإِنَّ عِناني في يَمينِ مُعَوَّدٍ","عَلى عُقَبِ الأَيّامِ قَودَ الأَعِنَّةُ",4,"ه",1,0],["فانعم هُذَيمُ بِعَيشٍ طابَ مَشرَعُهُ","وابلُغ بِهِ بَعضَ ما تَهوى وَتَلتَمِسُ",5,"س",1,0],["فَإِنَّ عَناءَ المُسْتَنيمِ إِلى الأذى","بِحيْثُ يَذِلُّ الأكْرَمونَ طَويلُ",6,"ل",1,0],["فَإنَّ على الله نَيْلَ الَّذي","سَعَيْنا لَهُ وَعَلَيْنا الطَّلَبْ",7,"ب",1,0],["فَاِنعَم بِجَدٍّ لا يَضِر","كَ النُوكُ ما أُعطيتَ جَدّا",8,"د",2,0],["فَإِنَّ عَيني عَلى فَوزٍ لَباكِيَةٌ","وَإِنَّ قَلبي إِلى فَوزٍ بِأَشواقِ",9,"ق",1,0],["فَإِنْ عَرَفَ الأَقْوَامُ حَقَّكَ وُفِّقُوا","وَإِنْ جَهِلُوا بَاءُوا بِصَفْقَةِ خُسْرَانِ",10,"ن",1,0],["فَإِنْ عَدَّ تَسْكَاباً مَعَالِمَ أُنْسِهَا","وَحَيَّى بِمَسْرَاهَا هِضَابا وَغِيطَانَا",11,"ن",2,0],["فإنْ عشْتُ أُبْلِغْ فيكَ نفْسي عُذْرَها","وإنْ لمْ أعِشْ فاللهُ يجْزيكَ منْ بَعْدي",12,"ي",1,0],["فانْعَمْ بعادَتِكَ الحُسْنى فمِثْلُكَ مَنْ","أجْرى العَوائِدَ حتّى في الهَدِيّاتِ",13,"ت",1,0],["فَإِنَّ عِتابي كُلَّ يَومٍ لسَوءةٍ","وَإِنّي لمَتروكٌ إِذا لا أُعاتِبُ",14,"ب",1,0],["فَإِن عاقَتِ الأَقدارُ فَالنَفسُ حُرَّةٌ","وَإِن تَكُنِ العُتبى فَأَحرِ بِها أَحرِ",15,"ر",1,0],["فَأَنعِم بِالقَبولِ فَرُبَّ نُعمى","أَعَدتَ بِها دُجى لَيلي نَهارا",16,"ر",2,0],["فانعم صباحاً واغتنم","أوقاتَه المجتمعَهْ",17,"ع",2,0],["فإن عماد بيت المجد خُلْق","حكى في أنف ناشفه العبيرا",18,"ر",2,0],["فَإِنَّ عِقالاً وَالحُتاتَ كِلاهُما","تَرَدّى بِثَوبَي غادِرٍ وَتَأَزَّرا",19,"ر",2,0],["فَإِن عَفَوتَ فَضَلتَ الناسَ عافِيَةً","وَإِن وَقَعتَ فَما وَقعٌ كَما تَقَعُ",20,"ع",1,0],["فَإِن عِشنا ذَخَرناها لِأُخرى","وَإِن مُتنا فَمَوتاتُ الرِجالِ",21,"ل",1,0],["فَإِن عِشتُ فَالطَعنُ الَّذي يَعرِفونَهُ","وَتِلكَ القَنا وَالبيضُ وَالضُمَّرُ الشُقرُ",22,"ر",1,0],["فَإِن عُدتُ يَوماً عادَ لِلحَربِ وَالعُلا","وَبَذلِ النَدى وَالجودِ أَكرَمُ عائِدِ",23,"د",1,0],["فانعم بما شادَتْ يداك ودُمْ على","مرِّ الزمان ممدَّحَ الآلاء",24,"ا",2,0],["فإن علقت كفي بنعماك عروة","فقد هانَ من عيشي بيمنك مصعب",25,"ب",1,0],["فإن عذلت أبا ذرّ الثناء فقد","عذرت من خاطر العليا أبا لهب",26,"ب",1,0],["فانعم به وبأمداح مشعشعة","مديرها في صباح الفطر مبرور",27,"ر",1,0],["فانعم به واسق الضحايا والعدى","نحراً فإن جميعهم أنعام",28,"م",1,0],["فإن عَصَتْ بَدَهاتِ الرأي مُعْضِلةٌ","أذكى لها فِكَراً أذكى من اللّهبِ",29,"ب",1,0],["فإنْ عَفَوْتَ فما تنْفَكُّ مُرْتَهناً","شكْراً بتقليد نُعْمَى بعْدَ تقليدِ",30,"د",1,0],["فإن عدا والريح في وجهه","لم ينبعث في وجهه إصبعا",31,"ع",2,0],["فانعمْ بحُبلاكَ واعلمْ أنها جَزَرٌ","للنيكِ قد فُعلتْ فيها الأفاعيلُ",32,"ل",1,0],["فإن عيّرتَهم بالنتن قالوا","كذا نكهاتُ أفواه القُرومِ",33,"م",1,0],["فَاِنعَق بِضَأنِكَ يا جَريرُ فَإِنَّما","مَنَّتكَ نَفسُكَ في الخَلاءِ ضَلالا",34,"ل",2,0],["فَإِنَّ عَواقِبَ الأَيّامِ تُخشى","دَوائِرُها وَتَنتَقِلُ الدِيارُ",35,"ر",1,0],["فَإِن عاشَ هَمّامٌ لَنا فَهوَ رَحمَةٌ","مِنَ اللَهِ لَم تُنفَس عَلَينا فُضولُها",36,"ل",3,0],["فَإِنَّ عُرىً شَدَدناها وِثاقاً","نَموتُ وَلا نَطيقُ لَها اِنفِصاما",37,"م",2,0],["فَإِن عاقَبتَني فَجَزاءُ مِثلي","وَإِن تَصفَح فَلَيسَ مِن الغَريبِ",38,"ب",1,0],["فإنْ عُدْتُمُ عُدْنَا وإن تُظهروا الغِنى","عن الودِّ كنَّا عن وِدادكمُ أغنَى",39,"ن",2,0],["فإنْ عشتُ أحوِ المُلكَ لم يحوِ مثلَهُ","يدا ملكٍ في العالمينَ هُمامِ",40,"م",1,0],["فإنْ عُدْتمُ يوماً تُريدونَ مُهْجَتِي","تمنَّعتُ إلا أنْ يُقامَ كفيلُ",41,"ل",1,0],["فإنْ عِشتُ لم أبرَحْ بلادي وإن أمُتْ","فلا ماتَ بعدي في الزمانِ غريبُ",42,"ب",1,0],["فَإِنَّ عَلى بَغدادَ ظِلَّ غَمامَةٍ","بِجودِ أَبي إِسحاقَ يَهمي انثِجاجُها",43,"ج",3,0],["فَاِنعَم سَليمَ الأَقطارِ تَغتَبِقُ ال","صَهباءَ مِن دَنِّها وَتَصطَبِحُ",44,"ح",1,0],["فَإِن عِشتَ مَحموداً فَمِثلي بَغى الغِنى","لِيَكسِبَ مالاً أَو يُنَث لَهُ حَمدُ",45,"د",1,0],["فَاِنعَم بِيَومِ الفِطرِ عَيناً إِنَّهُ","يَومٌ أَغَرُّ مِنَ الزَمانِ مُشَهَّرُ",46,"ر",1,0],["فإن عدُّوا الأكابرَ من عَدِيٍّ","حَسِبتُهُمُ يعُدُّون الجِبالا",47,"ل",2,0],["فإن عَجِزَ الأقوامُ أو بانَ نقصُهم","فليس لمن بانَتْ فضيلتُه ذَنبُ",48,"ب",1,0],["فَإِن عَذَّبَتني فَالذَنبُ مِنّي","وَإِن تَغفِر فَأَنتَ بِهِ جَديرُ",49,"ر",1,0],["فَإِنَّ عِندي فَضلَةً","مِن جودِ آلِ أُرتُقِ",50,"ق",1,0],["فَإِن عَتَبتُم عَلى بُعدِ المَزارِ أَقُل","نِظامَ مَن قالَ قَبلي قَولَ مُعتَذِرِ",51,"ر",1,0],["فإِن عَرضت له الذكرُ الخوالي","رأيتَ الكونَ في عينيه غاما",52,"م",2,0],["فإن عدتُ وحدي بعد رحلتنا معاً","شريداً على الدنيا ذليلاً على الدهر",53,"ر",1,0],["فانعمْ بعيدٍ سعيدٍ قد بَسَطْتَ له","للمعتفين يميناً تَبْسُطُ النعما",54,"م",2,0],["فانْعمْ بعيدٍ قد أتى ناظماً","كلُّ لسانٍ لك فيه امتداح",55,"ح",1,0],["فَإِن عَلَتنِيَ مِن أَزمانِهِ ظُلَمٌ","صَبَرتُ نَفسِيَ حَتّى تُكشَفَ الظُلَمُ",56,"م",1,0],["فَاِنعَم فَكُنيَتُكَ الَّتي كُنّيتَها","فَألٌ جَرى لَكَ بِالسَعادَةِ فَاِسعَدِ",57,"د",1,0],["فانعدمَتْ صورتُهُ","مِنْ شؤمِ تلكَ الصورِ",58,"ر",1,0],["فَإِنَّ عَهدي بِهِ وَاللَهُ يَحفَظُهُ","وَإِن أَتى الذَنبَ مِمَّن يَكرَهُ العَذلا",59,"ل",2,0],["فانعِمي نَعمَةً تُجزَي بِأَحسَنِها","فَرُبَّما مَسَّنى مِن أَهلِكِ النِعَمُ",60,"م",1,0],["فَإِن عُدَّ مَجدٌ فاضِلٌ عَدَّ مِثلَهُ","وَإِن أَثَّلوا أَدرَكتُهُم بِأَثيلِ",61,"ل",1,0],["فَإِن عَدا ذاكَ فَبازٌ أَبيَضُ","وَفَرَسٌ حافِرُهُ مُفَضفَضُ",62,"ض",1,0],["فإِنَّ عِنْدَكُمُ تَوْراتُهُمْ صَدَقَتْ","ولمْ تُصَدَّقْ لكمْ منهمْ أناجِيلُ",63,"ل",1,0],["فَإِن عَدَلتُ يَميناً","خَشيتُ وَقعَ وُعودِه",64,"د",2,0],["فَاِنعَم بِها قَبلَ رائِعاتٍ","لا خَمرَ فيها وَلا خُمارُ",65,"ر",1,0],["فَإِن عاتَبتُها فيهِ","أَحالَتني عَلى القَدَرِ",66,"ر",1,0],["فَإِن عَذَّبتَني فَبِسوءِ فِعلي","وَإِن تَغفِر فَأَنتَ بِهِ جَديرُ",67,"ر",1,0],["فإن عدمَ استراحَ براحتيهِ","ولم يخشَ الأثامَ ولا الشنار",68,"ر",1,0],["فَإِنَّ عَبيداً وَاِبنَ هِندٍ وَتُبَّعاً","وَأُسرَةَ كِسرى لِلمَليكِ عَبيدُ",69,"د",1,0],["فَإِنَّ عِلباءً المَدعوَّ في أَسَدٍ","ساقَ الحِمامَ فَأَسقى ماءَهُ حُجُرا",70,"ر",2,0],["فَإِنَّ عُطارِداً في الجَوِّ أَولى","بِأَن يَزِنَ الكَلامَ وَأَن يُقَفّي",71,"ي",1,0],["فَإِنَّ عَدِيّاً فَرَّ مِن خَوفَِ نَكبَةٍ","وَآضَت سَبِيّاً أُختُهُ بِنتُ حاتِمِ",72,"م",1,0],["فإنْ عَشِقَتْ صَوارِمُكَ الهَوادي","فلا عَدِمَتْ بمنْ تَهَوى اتّصَالا",73,"ل",2,0],["فإنْ عُدتَ فالمجرُوحُ تُؤسَى جراحُه","وإنْ لم تَعُدْ مُتْنا ونحنُ كِرامُ",74,"م",1,0],["فإنْ عُدّ ضَحضاح الحِمامِ صَوارِمٌ","عُدِدْنَ بُحُوراً للرّدى وغِمارا",75,"ر",2,0],["فإن عذرتْ شمسُ الضُّحى في نجومِها","على الجوَّ كان القصرُ في الشمس أعذرا",76,"ر",2,0],["فإنَّ عَيني بَعدُ مِن","رؤيتها لَم تَشبَع",77,"ع",1,0],["فانْعَمْ أَبا عامِرٍ بنِعْمَتِهِ","واعْجَبْ لأَمْرَيْنِ فيه قد جُمِعَا",78,"ع",2,0],["فَإِن عايَنَت عَيني المَطايا وَرَكبُها","فَرَشتُ لَدى أَخفافِها صَفحَةَ الخَدِّ",79,"د",1,0],["فَانْعَمْ بِخَيْرِ وِلايَةٍ وَلّاكَها","رَبُّ الْعِبادِ بِرَغْمِ كُلِّ رَقِيبِ",80,"ب",1,0],["فَانعَم وَطِب وَالهُ وَاطرَب وَاسعَ وَاعلُ وَسُد","وَاشْرَبْ وَغَنِّ وَتِهْ وَالْعَبْ وَهِمْ وَطِرِ",81,"ر",1,0],["فَإِنْ عَادَ لِي بالْوُدِّ عُدْتُ وَإِنْ أَبَى","صَبَرْتُ لأَرْعَى ذِمَّةَ الْوُدِّ بِالصَّبْرِ",82,"ر",1,0],["فَإِنْ عاشَ فَالْبِيدُ الدَّيَامِيمُ دَارُهُ","وإِنْ مَاتَ فَالطَّيْرُ الأَضَامِيمُ لَحْدُهُ",83,"د",2,0],["فَإِنْ عِشْتُ صافَحْتُ الثُّرَيَّا وإِنْ أَمُتْ","فَإِنَّ كَرِيماً مَنْ تَضُمُّ الصَّفَائِحُ",84,"ح",1,0],["فانْعَمْ بِعِزِّكَ يا ملِيكُ ولا تَزَلْ","تَحْوِي يَدَاكَ مَقالِدَ الْعَلْياء ِ",85,"ا",2,0],["فانْعَم بما أُوِتيتَ واهْنَأْ شاكِراً","نِعَمَ الإِلهِ فإِنَهنّ غِزَار",86,"ر",1,0],["فانعَمْ بفِطْرٍ حَسُنَتْ أيامُه","حتى لَخِلْناها من الحُسْنِ نِعَمْ",87,"م",1,0],["فإن عشت، تخْمُدْ بقلبي حقودٌ","تَسَعَّرُ في القلب نيرانُها",88,"ن",3,0],["فإن عد تسكابا معالم أنسها","وحيا بمسراها هضابا وغيطانا",89,"ن",2,0],["فإن عشت أبلغ فيك نفسي عذرها","وإن لم أعش فالله يجزيك من بعد",90,"د",1,0],["فانْعَمْ بعادتِكَ الحُسْنى فمثلُكَ مِنْ","أجْرى العوائِدَ في الهديَّاتِ",91,"ت",1,0],["فانَّ على الوجوه سماتِ خيرٍ","حساناً تكشف الكُرَبَ الشدادا",92,"د",2,0],["فإن عظيماً أن يخلِّدَ شاعرٌ","مخازيَ جيل بالقوافي السوائر",93,"ر",1,0],["فإنْ عجِبتَ لشكوى شاعرٍ طرِبٍ","طولَ الليالي يُرى في زِيِّ بّكاء",94,"ا",2,0],["فإن عنيت لنا دار","بجمع الشمل لم أعد",95,"د",1,0],["فإنّ عرى سددناها وثاقا","نموت ولا نطيق لها انفصاما",96,"م",2,0],["فَإِنْ عَذَّبْتني فالذَّنْبُ ذَنْبي","وإِنْ تَغْفِرْ فَأَنْتَ به جَدِيْرُ",97,"ر",1,0],["فَإنَّ عَهْدي بِهِ، وَکللَّهُ يَحْفَظُهُ،","وَإنْ أَتَى الذَّنْبَ مِمَّنْ يَكْرَهُ العَذَلا",98,"ل",2,0]]}