ViewPoem.aspx?id=180818",""],[90,"الشهيد قيس","https://www.poetsgate.com/ViewPoem.aspx?id=179228",""],[90,"اندونيسيا المجاهدة","https://www.poetsgate.com/ViewPoem.aspx?id=179216",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[31,"ما عَلَى الرَّسْمِ بالبُلَيَّيْن لَوْ بَيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18767&r=&rc=30",""]],"verses":[["وَبِما تَرُدُّ عَلى المُغيرَةِ دَهيَهُ","نَزعَ النَوارِ بِطيئَةَ الإِذعانِ",0,"ن",1,0],["وَبِمَجدِ النَفسِ فَخري سابِقاً","فَضلَةِ الفَخرِ بِمَجدِ الوالِدَينِ",1,"ن",1,0],["وَبِمُهْجَتِي رَشَأٌ كَأَنَّ بِهِ","ثَمَلاً يَميلُ بِهِ وَيَعْتَدِلُ",2,"ل",1,0],["وبمُهْجَتي هَيْفاءُ يَرْفَعُ جِيدَها","رَشَأٌ ويَخْفِضُ ناظِرَيْها جُؤْذَرُ",3,"ر",1,0],["وبمَنْشِطِ الحَوْذانِ خَمسَةُ أرْسُمٍ","تَبدو فأحْسَبُهُنَّ خَمسَةَ أسْطُرِ",4,"ر",1,0],["وَبِمِسواكِها الَّذي اِختارَهُ اللَ","هُ لِفيها مِن أَطيَبِ الأَغصانِ",5,"ن",1,0],["وَبِمَن شَوقي إِلَيهِ","شَفَّ جَهري وَضَميري",6,"ي",1,0],["وَبِمَن أَذهَلَني عَن","حُبِّ مِطواعٍ غَريرِ",6,"ر",1,0],["وَبِمَن يَذهَبُ بِالهَ","مِّ وَيَأتي بِالسُرورِ",6,"ر",1,0],["وبمُسْتَعينِ اللهِ يصْلُحُ منْكَ ما","قدْ كان غيّرَهُ الزّمانُ الفاسِدُ",7,"د",1,0],["وبِمَهْبِطِ الرّوحِ الأمينِ أمانةٌ","واليُمْنُ فيها والأمانُ لِروحي",8,"ح",2,0],["وَبِما اِحتَوَت رَدَّ الحَصي","فُ الرَأيِ غارَةَ مَن أَغار",9,"ر",1,0],["وَبِمُسْرِجِيَها الْفَاتِحِي","نَ أَضَاقَتِ الدُّنْيَا رِحَابَا",10,"ب",2,0],["وبِمَا أبْلَى لِنُصْرَتِها","عُدَّ فِي أَبْطَالِهَا الغُلْبِ",11,"ب",1,0],["وبملتقى الأرواح دوحة أيكة","جاذبتها عند الغروب مميلا",12,"ل",2,0],["وبمنتهى نظري دخان صاعد","يعلو كثيراً تارة وقليلا",13,"ل",2,0],["وَبِمَنطِقٍ شَعَفَ الفُؤادَ كَأَنَّهُ","عَسَلٌ يَجُدنَ بِهِ بِغَيرِ مِزاجِ",14,"ج",1,0],["وبملكهم رفعَ الهدى أعلامهُ","وحمى سرادِقَ بيتهِ المنصوب",15,"ب",1,0],["وبمهجتي رشأ يميس قوامه","فكأنَّه نشوان من شفتيهِ",16,"ه",1,1],["وبما يُولي مَسُوداً سَيّدٌ","أمَرَ السيدُ فانقادَ المسُودُ",17,"د",1,0],["وبما أعداكَهُ من فضله","وتوالي برّهِ صافيتنا",18,"ن",2,0],["وبما لا تزال تُقْذى إلى أن","تتجلَّى خَصاصةُ الإخوان",19,"ن",1,0],["وبما لا يزالُ يقْرعها في ال","حرب وقعُ السيوف والمُرَّان",19,"ن",1,0],["وبمُشْرِقٍ صافي الأديم كأنما","فيه ائتلاقٌ من صفيح يمان",20,"ن",1,0],["وبما أَمُدُّ يدي إلى ثمر الصِّبى","فأنوشُ منها فَوْتَ كف الجاني",20,"ن",2,0],["وَبِمِثلِ لَمحِ الطَرفِ أَسرَعَ هابِطاً","نَحوَ الجَحيمِ يَقولُ ذاكَ مَكاني",21,"ن",2,0],["وَبِمَن أَذابَ الحُبَّ مُهجَتَهُ","وَبِمَن تَأَكَّلَ قَلبَهُ الحَسَدُ",22,"د",1,0],["وَبِمُهجَتي مَن لا أُسَمّي","هِ وَأَكتُمُهُ لِئَلّا",23,"ل",2,0],["وَبِمَن في الأَنامِ تَعتاضُ عَمَّن","عَنكَ وَاللَهِ لَيسَ بِالمُعتاضِ",24,"ض",1,0],["وَبِمُهجَتي وَسنانَ لاسِنَةَ الكَرى","أَوما رَأَيتَ الظَبِيَ أَحوى أَحوَرا",25,"ر",2,0],["وَبِما أَبركَهُم في مُناخٍ","جَعجَعٍ يَنقُبُ فِيه الأَظَلُّ",26,"ل",1,0],["وَبِما صَبَّحَها في ذُراها","مِنهُ بَعد القَتلِ نَهلٌ وَشَلُّ",26,"ل",1,0],["وبمجدِ الحياةِ والشوقِ غنَّيْتُ","فلم تفهمِ الأعاصيرُ قَصْدي",27,"د",2,0],["وبما للحياة من حركات","والسكون الملم بالحركات",28,"ت",1,0],["وَبِمِصرٍ لِلعِلمِ دارٌ وَلِلضَي","فانِ نارٌ عَظيمَةٌ حَمراءُ",29,"ا",2,0],["وَبِمُهجَتي يا عاذِلي المَلِكُ الَّذي","أَسخَطتُ كُلَّ الناسِ في إِرضائِهِ",30,"ا",3,0],["وَبِما أَثَّرَت صَوارِمُهُ البي","ضُ لَهُ في جَماجِمِ الأَعداءِ",31,"ا",2,0],["وَبِمِسكٍ يُكنى بِهِ لَيسَ بِالمِس","كِ وَلَكِنَّهُ أَريجُ الثَناءِ",31,"ا",2,0],["وبمهجتي مَنْ لا أريدُ لمهجتِي","طِيْبَ الحياةِ وَروْحَهَا من بَعْدِهِ",32,"د",2,1],["وَبِمَسقِطِ العَلَمَينِ ناعِمَةُ الصِبا","حَيرى الشَبابِ تَبينُ إِن لَم تَصرِمِ",33,"م",1,0],["وبما تساقطَ من زِنادِ مَشيبِه","في حالِك الفَوْدَيْنِ أن يَتضرَّما",34,"م",2,0],["وَبِمَن خَلَت مِنهُ أَسِرَّتُهُ","وَبِمَن خَلَت مِنهُ مَنابِرُهُ",35,"ر",2,0],["وَبِمَن خَلَت مِنهُ مَدائِنُهُ","وَتَفَرَّقَت عَنهُ عَساكِرُهُ",35,"ر",2,0],["وَبِمَن أَذَلَّ الدَهرُ مَصرَعُهُ","فَتَبَرَّأَت مِنهُ عَشائِرُهُ",35,"ر",2,0],["وَبِمِثلِ وِدّي لا يُقا","سُ وَلا يُقالُ وَلا يُقامُ",36,"م",1,0],["وَبِماذا تَجَنَّبَت نارُ نُمرو","دٍ خَليلَ الإِلَهِ إِبراهيما",37,"م",2,0],["وَبِماذا بُسَرَّ قَلبي إِذا غِب","تَ إِذا كُنتَ لِلقُلوبِ مَسَرَّه",38,"ر",2,0],["وبمهجتي عُرُبٌ كأنّ قدودها","قُضُبٌ تقومُ بميلهنّ رياحُ",39,"ح",1,0],["وبم السلوّ إذا بدا ليَ مُثْمِراً","خُوطٌ يميسُ على ارتجاجِ كثيبهِ",40,"ب",2,0],["وَبِمَسْقَطِ الْعَلَمَيْنِ جُؤْذُرُ كِلَّةٍ","يُصْمِي بِنَظْرَتِهِ الأُسُودَ إِذَا رَنَا",41,"ن",2,0],["وبمالئ الدنيا وشاغل أهلها","وبأيما فلك لها دوّار",42,"ر",1,0],["وَبِما أَهَلَّ بِهِ الحَجيجُ وَكَبَّروا","عِندَ المَقامِ وَرُكنِ بَيتِ المَحرَمِ",43,"م",1,0],["وَبِمُقلَتَي ريمٍ غَضيضٍ طَرفُهُ","أَضحى لَهُ بِرِياضِ مَرٍّ مَرتَعُ",44,"ع",1,0],["وَبِما قَد أَرى بِهِ حَيَّ صِدقٍ","كامِلِ العَيشِ نِعمَةً وَشَبابَ",45,"ب",1,0],["وَبِمَعطِفَيهِ لِلشَبيبَةِ مَنهَلٌ","قَد شَفَّ عَنهُ مِنَ القَميصِ سَرابُ",46,"ب",1,0],["وَبِمُهجَتي أَلحاظُ ظَبيَةِ وَجرَةٍ","حُرّاسُ مَسكِنِها أُسودُ عَرينِ",47,"ن",1,0],["وَبِما صَبَّحَها في ذُراها","مِنهُ بَعدَ القَتلِ نَهبٌ وَشَلُّ",48,"ل",1,0],["وَبما أَرى شَخصاً بِهِ حَسَناً","في القَومِ إِذ حَيَّتكُمُ نُعمُ",49,"م",1,0],["وَبِمَن قَد بُليتَ لَيتَكَ يا مِس","كينُ أَحبَبتَ واصِلاً طَو تَرَكتا",50,"ت",2,0],["وبما رفَّعْتُما لي عَلَماً","ينظُرُ النّجمُ إليه من بُعاد",51,"د",1,0],["وَبِما في بُيوتِها مِن رُخامٍ","وَبِما تَحتِ سَقفِها مِن عَمودِ",52,"د",1,0],["وَبِما تُواكِبُهُنَّ ما","بَينَ الرُصافَةِ وَالجُسورِ",53,"ر",1,0],["وَبِميمٍ بَعدُهُ أَقلَقَني","وَبِدالٍ سَلَّ روحي مِن بَدَن",54,"ن",1,0],["وبما جرَى في موقفِ التوديعِ مِنْ","ألمِ النّوَى شاهدتُ هَولَ الموقفِ",55,"ف",1,0],["وبِمَا شِئْتَ في هَواكَ اختَبِرْنِي","فاختياري ما كان فيِه رِضَاكَا",56,"ك",2,0],["وبمهجتي يا عاذلي الملك الّذي","أسخطت أعذل منك في إرضائه",57,"ا",3,0],["وبمثلِ ما قدَّمتمو وبذَلْتُمُو","تغلو الدِّيارُ وترخُصُ الأعمارُ",58,"ر",1,0],["وبِمصرَ والدنيا عيونُ أحِبةٍ","السُّهدُ والألم الممِضُّ حبيبها",59,"ب",3,0],["وبمنف كهان لكُنهك سبحوا","والروم غرقى في المحبة سبح",60,"ح",1,0],["وبِمُهْجَتِي رَشَئِيَّةٌ مِنْ دُونِها","أُسُدٌ لَهَا قَصَبُ الرِّمَاحِ أَبَاءُ",61,"ا",2,0],["وَبِمَاذَا كَانَتْ تُعَالِجُ أَسْقَا","مٌ ثِقَالٌ تَمُدُّهَا أسْقَامُ",62,"م",1,0],["وَبِمَا قدْ كَشَفْتَ لِلنَّاسِ عَنْهُ","مِنْ خَبَايَا الأَعْمَاقِ وَالأَغْوَارِ",63,"ر",1,0],["وَبِمَا قَدْ بَذَلْتَ مِنْ صَادِقِ النُّصْحِ","لأَهْلِ الْحُلُومِ وَالأَبْصَارِ",63,"ر",1,0],["وَبِمَدْحِ طه والصَحا","بَةِ تجْعَلُ الحُسْنَى مَعَادَك",64,"ك",1,0],["وَبِمَا جَلَبْنَ مِنَ الأَشِعَّة وَالنَّدَى","نَمَتِ الْجُذُوعُ وَشَمْلُهَا مُتَجَمِّعُ",65,"ع",1,0],["وَبِمُنْجِبٍ لِكَ كَانَ","مَحْمُودُ المَوَارِدِ وَالمَصَادِرْ",66,"ر",1,0],["وَبِمَا يَجِيدُ بَيَانَهُ لَمْ يَشْؤهُ","فِي حَلْبَةِ الأدَبِ الرَّفِيعِ مُجِيد",67,"د",1,0],["وَبِمُنْشِيءٍ مَا صَاغَ إِلاَّ الْمُنْتَقَى","وَبِمُفْصِحٍ مَا قَالَ غَيْرَ الْجيِّد",68,"د",1,0],["وَبِمُحْكَمِ التَّدْبِيرِ يَرْعَى مَا رَعَى","قَصْداً وَيُسْرِفُ فِي الْعنَاءِ الْمُجْهَد",68,"د",1,0],["وَبِمَا مَزَجْتَ مِنْ الكِيَا","سَةِ بِالسِّيَاسَةِ ظَلْتَ فَرْدَا",69,"د",2,0],["وَبِمَشْهَدٍ مِنْ قَادَةٍ فِي أهْبَةٍ","وَذَوِي سُيوفٍ تُنْتَفَى وَحِرَابِ",70,"ب",1,0],["وبمطر الضيم في أرضي وأشربه","وكنت لا أرتضي أن أشرب السحبا",71,"ب",2,0],["وَبِمِقْوَلٍ يَفْرِي الْحَدِي","د وَيَصْرَعُ الْخصْمَ الْمُكابِرْ",72,"ر",1,0],["وبموشَى أرَادَ حَصْرَكَ بِالْجُنْدِ","وَهَلْ تَحْصُرُ الْجُنُودُ السُيولاَ",73,"ل",2,0],["وبمنْ أتاحَ لجُنْدِهِ","في خيْبَرَ النصرَ المبين",74,"ن",1,0],["وبمدّ خطوته قيركض ((عنتر))","في صدره ويكرّ ، ((عبد مناف))",75,"ف",1,0],["وَبِمَا أَبْرَكَهَا في مُنَاخٍ","جَعْجَعٍ يَنْقَبُ فِيهِ الأَظَلُّ",76,"ل",1,0],["وبما غَمَرْتَ البيتَ من","فَيْض الصَّبابة والوَجيب",77,"ب",1,0],["وبما جَلَبْتَ ل \" ثاكلٍ \"","حَرّى ومُحتَسِب حرَيب",77,"ب",1,0],["وبما تسيلُ ظهورُها وبطونُها","بالتِبْرِ من متذوِّبٍ وسَبيك",78,"ك",1,0],["وبمِن يقودُ الزاحفيينَ أخالدٌ","ومحمدٌ ، ام أحمدٌ وهِشام ؟",79,"م",1,0],["وبما قد أرى به حيَّ صدقٍ","كاملي العيش نعمة ً وشبابا",80,"ب",2,0]]}