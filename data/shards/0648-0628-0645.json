oem3549.html","عموديه"],[462,"لا والقدود الهيف حلفة وامق","https://www.aldiwan.net/poem3590.html","عموديه"],[462,"حكمت بلوعتك الظباء الغيد","https://www.aldiwan.net/poem3597.html","عموديه"],[462,"زحف الصباح وهذه راياته","https://www.aldiwan.net/poem3624.html","عموديه"],[462,"اصمى بسهم المقلة النجلاء","https://www.aldiwan.net/poem3631.html","عموديه"],[477,"يا راكب الرتل السريع","https://www.aldiwan.net/poem37043.html","مجزوء الكامل"],[480,"أطلعن في قمر الأفوق شموسنا","https://www.aldiwan.net/poem24426.html","عموديه"],[498,"أسكرت أهل الوحا خمرتنا","https://www.aldiwan.net/poem37672.html","الرمل"],[498,"القلب يفزع في المهمة ضارعا","https://www.aldiwan.net/poem37696.html","الكامل"],[498,"قسما بثائرة الغرام المذهل","https://www.aldiwan.net/poem37925.html","الكامل"],[498,"خذ شهودا عن شهود الكائنات","https://www.aldiwan.net/poem38068.html","الرمل"],[512,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[512,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[512,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[512,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[512,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[512,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[513,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[527,"لا تنكروني إن ثملت فللهوى","https://www.aldiwan.net/poem37301.html","الكامل"],[549,"ليس دار الزوراء دار مقام","https://www.aldiwan.net/poem47209.html","الخفيف"],[549,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[549,"لو لم يعاجله النوى لتحيرا","https://www.aldiwan.net/poem47806.html","الكامل"],[556,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[556,"عشق ذات الخال عشقي","https://www.aldiwan.net/poem34325.html","مجزوء الرمل"],[556,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[556,"وجه تعدد في المرائي","https://www.aldiwan.net/poem35086.html","مجزوء الكامل"],[560,"أعلمت ما بالقلب من نار الجوى","https://www.aldiwan.net/poem52852.html","الكامل"],[560,"قف بالعقيق وسل نسيم رياحه","https://www.aldiwan.net/poem52903.html","الكامل"],[560,"أي ذنب ترى وأية زله","https://www.aldiwan.net/poem52985.html","الخفيف"],[560,"أفراقا حسبتها أم لقاء","https://www.aldiwan.net/poem52986.html","الخفيف"],[565,"اكفنا ياعذول شر لسانك","https://www.aldiwan.net/poem69496.html","الخفيف"],[584,"وافى الحبيب بطلعة غراء","https://www.aldiwan.net/poem17399.html","الكامل"],[584,"وافى بوجه قد زهى بالطلعة ال","https://www.aldiwan.net/poem17403.html","الكامل"],[584,"وافى بوجه كالهلال مركب","https://www.aldiwan.net/poem17404.html","الكامل"],[584,"من شاء بعد رضى الأحبة يغضب","https://www.aldiwan.net/poem17412.html","الكامل"],[584,"بتثني قوامك الممشوق","https://www.aldiwan.net/poem17628.html","الخفيف"],[584,"وحياتكم في عزكم وهواني","https://www.aldiwan.net/poem17795.html","الكامل"],[584,"قمر يجلو دجى الغلس","https://www.aldiwan.net/poem17971.html","المديد"],[584,"يا ثغره المحمي منه بنابل","https://www.aldiwan.net/poem17984.html","الكامل"]],"verses":[["وَبِما تَرُدُّ عَلى المُغيرَةِ دَهيَهُ","نَزعَ النَوارِ بِطيئَةَ الإِذعانِ",0,"ن",1,0],["وَبِمَجدِ النَفسِ فَخري سابِقاً","فَضلَةِ الفَخرِ بِمَجدِ الوالِدَينِ",1,"ن",1,0],["وَبِمُهْجَتِي رَشَأٌ كَأَنَّ بِهِ","ثَمَلاً يَميلُ بِهِ وَيَعْتَدِلُ",2,"ل",1,0],["وبمُهْجَتي هَيْفاءُ يَرْفَعُ جِيدَها","رَشَأٌ ويَخْفِضُ ناظِرَيْها جُؤْذَرُ",3,"ر",1,0],["وبمَنْشِطِ الحَوْذانِ خَمسَةُ أرْسُمٍ","تَبدو فأحْسَبُهُنَّ خَمسَةَ أسْطُرِ",4,"ر",1,0],["وَبِمِسواكِها الَّذي اِختارَهُ اللَ","هُ لِفيها مِن أَطيَبِ الأَغصانِ",5,"ن",1,0],["وَبِمَن شَوقي إِلَيهِ","شَفَّ جَهري وَضَميري",6,"ي",1,0],["وَبِمَن أَذهَلَني عَن","حُبِّ مِطواعٍ غَريرِ",6,"ر",1,0],["وَبِمَن يَذهَبُ بِالهَ","مِّ وَيَأتي بِالسُرورِ",6,"ر",1,0],["وبمُسْتَعينِ اللهِ يصْلُحُ منْكَ ما","قدْ كان غيّرَهُ الزّمانُ الفاسِدُ",7,"د",1,0],["وبِمَهْبِطِ الرّوحِ الأمينِ أمانةٌ","واليُمْنُ فيها والأمانُ لِروحي",8,"ح",2,0],["وَبِما اِحتَوَت رَدَّ الحَصي","فُ الرَأيِ غارَةَ مَن أَغار",9,"ر",1,0],["وَبِمُسْرِجِيَها الْفَاتِحِي","نَ أَضَاقَتِ الدُّنْيَا رِحَابَا",10,"ب",2,0],["وبِمَا أبْلَى لِنُصْرَتِها","عُدَّ فِي أَبْطَالِهَا الغُلْبِ",11,"ب",1,0],["وبملتقى الأرواح دوحة أيكة","جاذبتها عند الغروب مميلا",12,"ل",2,0],["وبمنتهى نظري دخان صاعد","يعلو كثيراً تارة وقليلا",13,"ل",2,0],["وَبِمَنطِقٍ شَعَفَ الفُؤادَ كَأَنَّهُ","عَسَلٌ يَجُدنَ بِهِ بِغَيرِ مِزاجِ",14,"ج",1,0],["وبملكهم رفعَ الهدى أعلامهُ","وحمى سرادِقَ بيتهِ المنصوب",15,"ب",1,0],["وبمهجتي رشأ يميس قوامه","فكأنَّه نشوان من شفتيهِ",16,"ه",1,1],["وبما يُولي مَسُوداً سَيّدٌ","أمَرَ السيدُ فانقادَ المسُودُ",17,"د",1,0],["وبما أعداكَهُ من فضله","وتوالي برّهِ صافيتنا",18,"ن",2,0],["وبما لا تزال تُقْذى إلى أن","تتجلَّى خَصاصةُ الإخوان",19,"ن",1,0],["وبما لا يزالُ يقْرعها في ال","حرب وقعُ السيوف والمُرَّان",19,"ن",1,0],["وبمُشْرِقٍ صافي الأديم كأنما","فيه ائتلاقٌ من صفيح يمان",20,"ن",1,0],["وبما أَمُدُّ يدي إلى ثمر الصِّبى","فأنوشُ منها فَوْتَ كف الجاني",20,"ن",2,0],["وَبِمِثلِ لَمحِ الطَرفِ أَسرَعَ هابِطاً","نَحوَ الجَحيمِ يَقولُ ذاكَ مَكاني",21,"ن",2,0],["وَبِمَن أَذابَ الحُبَّ مُهجَتَهُ","وَبِمَن تَأَكَّلَ قَلبَهُ الحَسَدُ",22,"د",1,0],["وَبِمُهجَتي مَن لا أُسَمّي","هِ وَأَكتُمُهُ لِئَلّا",23,"ل",2,0],["وَبِمَن في الأَنامِ تَعتاضُ عَمَّن","عَنكَ وَاللَهِ لَيسَ بِالمُعتاضِ",24,"ض",1,0],["وَبِمُهجَتي وَسنانَ لاسِنَةَ الكَرى","أَوما رَأَيتَ الظَبِيَ أَحوى أَحوَرا",25,"ر",2,0],["وَبِما أَبركَهُم في مُناخٍ","جَعجَعٍ يَنقُبُ فِيه الأَظَلُّ",26,"ل",1,0],["وَبِما صَبَّحَها في ذُراها","مِنهُ بَعد القَتلِ نَهلٌ وَشَلُّ",26,"ل",1,0],["وبمجدِ الحياةِ والشوقِ غنَّيْتُ","فلم تفهمِ الأعاصيرُ قَصْدي",27,"د",2,0],["وبما للحياة من حركات","والسكون الملم بالحركات",28,"ت",1,0],["وَبِمِصرٍ لِلعِلمِ دارٌ وَلِلضَي","فانِ نارٌ عَظيمَةٌ حَمراءُ",29,"ا",2,0],["وَبِمُهجَتي يا عاذِلي المَلِكُ الَّذي","أَسخَطتُ كُلَّ الناسِ في إِرضائِهِ",30,"ا",3,0],["وَبِما أَثَّرَت صَوارِمُهُ البي","ضُ لَهُ في جَماجِمِ الأَعداءِ",31,"ا",2,0],["وَبِمِسكٍ يُكنى بِهِ لَيسَ بِالمِس","كِ وَلَكِنَّهُ أَريجُ الثَناءِ",31,"ا",2,0],["وبمهجتي مَنْ لا أريدُ لمهجتِي","طِيْبَ الحياةِ وَروْحَهَا من بَعْدِهِ",32,"د",2,1],["وَبِمَسقِطِ العَلَمَينِ ناعِمَةُ الصِبا","حَيرى الشَبابِ تَبينُ إِن لَم تَصرِمِ",33,"م",1,0],["وبما تساقطَ من زِنادِ مَشيبِه","في حالِك الفَوْدَيْنِ أن يَتضرَّما",34,"م",2,0],["وَبِمَن خَلَت مِنهُ أَسِرَّتُهُ","وَبِمَن خَلَت مِنهُ مَنابِرُهُ",35,"ر",2,0],["وَبِمَن خَلَت مِنهُ مَدائِنُهُ","وَتَفَرَّقَت عَنهُ عَساكِرُهُ",35,"ر",2,0],["وَبِمَن أَذَلَّ الدَهرُ مَصرَعُهُ","فَتَبَرَّأَت مِنهُ عَشائِرُهُ",35,"ر",2,0],["وَبِمِثلِ وِدّي لا يُقا","سُ وَلا يُقالُ وَلا يُقامُ",36,"م",1,0],["وَبِماذا تَجَنَّبَت نارُ نُمرو","دٍ خَليلَ الإِلَهِ إِبراهيما",37,"م",2,0],["وَبِماذا بُسَرَّ قَلبي إِذا غِب","تَ إِذا كُنتَ لِلقُلوبِ مَسَرَّه",38,"ر",2,0],["وبمهجتي عُرُبٌ كأنّ قدودها","قُضُبٌ تقومُ بميلهنّ رياحُ",39,"ح",1,0],["وبم السلوّ إذا بدا ليَ مُثْمِراً","خُوطٌ يميسُ على ارتجاجِ كثيبهِ",40,"ب",2,0],["وَبِمَسْقَطِ الْعَلَمَيْنِ جُؤْذُرُ كِلَّةٍ","يُصْمِي بِنَظْرَتِهِ الأُسُودَ إِذَا رَنَا",41,"ن",2,0],["وبمالئ الدنيا وشاغل أهلها","وبأيما فلك لها دوّار",42,"ر",1,0],["وَبِما أَهَلَّ بِهِ الحَجيجُ وَكَبَّروا","عِندَ المَقامِ وَرُكنِ بَيتِ المَحرَمِ",43,"م",1,0],["وَبِمُقلَتَي ريمٍ غَضيضٍ طَرفُهُ","أَضحى لَهُ بِرِياضِ مَرٍّ مَرتَعُ",44,"ع",1,0],["وَبِما قَد أَرى بِهِ حَيَّ صِدقٍ","كامِلِ العَيشِ نِعمَةً وَشَبابَ",45,"ب",1,0],["وَبِمَعطِفَيهِ لِلشَبيبَةِ مَنهَلٌ","قَد شَفَّ عَنهُ مِنَ القَميصِ سَرابُ",46,"ب",1,0],["وَبِمُهجَتي أَلحاظُ ظَبيَةِ وَجرَةٍ","حُرّاسُ مَسكِنِها أُسودُ عَرينِ",47,"ن",1,0],["وَبِما صَبَّحَها في ذُراها","مِنهُ بَعدَ القَتلِ نَهبٌ وَشَلُّ",48,"ل",1,0],["وَبما أَرى شَخصاً بِهِ حَسَناً","في القَومِ إِذ حَيَّتكُمُ نُعمُ",49,"م",1,0],["وَبِمَن قَد بُليتَ لَيتَكَ يا مِس","كينُ أَحبَبتَ واصِلاً طَو تَرَكتا",50,"ت",2,0],["وبما رفَّعْتُما لي عَلَماً","ينظُرُ النّجمُ إليه من بُعاد",51,"د",1,0],["وَبِما في بُيوتِها مِن رُخامٍ","وَبِما تَحتِ سَقفِها مِن عَمودِ",52,"د",1,0],["وَبِما تُواكِبُهُنَّ ما","بَينَ الرُصافَةِ وَالجُسورِ",53,"ر",1,0],["وَبِميمٍ بَعدُهُ أَقلَقَني","وَبِدالٍ سَلَّ روحي مِن بَدَن",54,"ن",1,0],["وبما جرَى في موقفِ التوديعِ مِنْ","ألمِ النّوَى شاهدتُ هَولَ الموقفِ",55,"ف",1,0],["وبِمَا شِئْتَ في هَواكَ اختَبِرْنِي","فاختياري ما كان فيِه رِضَاكَا",56,"ك",2,0],["وبمهجتي يا عاذلي الملك الّذي","أسخطت أعذل منك في إرضائه",57,"ا",3,0],["وبمثلِ ما قدَّمتمو وبذَلْتُمُو","تغلو الدِّيارُ وترخُصُ الأعمارُ",58,"ر",1,0],["وبِمصرَ والدنيا عيونُ أحِبةٍ","السُّهدُ والألم الممِضُّ حبيبها",59,"ب",3,0],["وبمنف كهان لكُنهك سبحوا","والروم غرقى في المحبة سبح",60,"ح",1,0],["وبِمُهْجَتِي رَشَئِيَّةٌ مِنْ دُونِها","أُسُدٌ لَهَا قَصَبُ الرِّمَاحِ أَبَاءُ",61,"ا",2,0],["وَبِمَاذَا كَانَتْ تُعَالِجُ أَسْقَا","مٌ ثِقَالٌ تَمُدُّهَا أسْقَامُ",62,"م",1,0],["وَبِمَا قدْ كَشَفْتَ لِلنَّاسِ عَنْهُ","مِنْ خَبَايَا الأَعْمَاقِ وَالأَغْوَارِ",63,"ر",1,0],["وَبِمَا قَدْ بَذَلْتَ مِنْ صَادِقِ النُّصْحِ","لأَهْلِ الْحُلُومِ وَالأَبْصَارِ",63,"ر",1,0],["وَبِمَدْحِ طه والصَحا","بَةِ تجْعَلُ الحُسْنَى مَعَادَك",64,"ك",1,0],["وَبِمَا جَلَبْنَ مِنَ الأَشِعَّة وَالنَّدَى","نَمَتِ الْجُذُوعُ وَشَمْلُهَا مُتَجَمِّعُ",65,"ع",1,0],["وَبِمُنْجِبٍ لِكَ كَانَ","مَحْمُودُ المَوَارِدِ وَالمَصَادِرْ",66,"ر",1,0],["وَبِمَا يَجِيدُ بَيَانَهُ لَمْ يَشْؤهُ","فِي حَلْبَةِ الأدَبِ الرَّفِيعِ مُجِيد",67,"د",1,0],["وَبِمُنْشِيءٍ مَا صَاغَ إِلاَّ الْمُنْتَقَى","وَبِمُفْصِحٍ مَا قَالَ غَيْرَ الْجيِّد",68,"د",1,0],["وَبِمُحْكَمِ التَّدْبِيرِ يَرْعَى مَا رَعَى","قَصْداً وَيُسْرِفُ فِي الْعنَاءِ الْمُجْهَد",68,"د",1,0],["وَبِمَا مَزَجْتَ مِنْ الكِيَا","سَةِ بِالسِّيَاسَةِ ظَلْتَ فَرْدَا",69,"د",2,0],["وَبِمَشْهَدٍ مِنْ قَادَةٍ فِي أهْبَةٍ","وَذَوِي سُيوفٍ تُنْتَفَى وَحِرَابِ",70,"ب",1,0],["وبمطر الضيم في أرضي وأشربه","وكنت لا أرتضي أن أشرب السحبا",71,"ب",2,0],["وَبِمِقْوَلٍ يَفْرِي الْحَدِي","د وَيَصْرَعُ الْخصْمَ الْمُكابِرْ",72,"ر",1,0],["وبموشَى أرَادَ حَصْرَكَ بِالْجُنْدِ","وَهَلْ تَحْصُرُ الْجُنُودُ السُيولاَ",73,"ل",2,0],["وبمنْ أتاحَ لجُنْدِهِ","في خيْبَرَ النصرَ المبين",74,"ن",1,0],["وبمدّ خطوته قيركض ((عن