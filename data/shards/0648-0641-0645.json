{"poems":[[72,"مدمع سائل لغير رحيم","https://www.aldiwan.net/poem19679.html","الخفيف"],[44,"ظبي يتيه بورده في خده","https://www.aldiwan.net/poem30258.html","الكامل"],[102,"جئت تتلو علي صفحة ماض","https://www.aldiwan.net/poem33091.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39541","الخفيف"],[204,"أنا أفديك من ملول أَلوف","https://www.aldiwan.net/poem53242.html","الخفيف"],[221,"جاء للقصر يخطر","https://www.aldiwan.net/poem55281.html","مجزوء الخفيف"],[270,"لما وردت الماء صار لهيبا","https://www.aldiwan.net/poem35420.html","الكامل"],[452,"فديه في الحمام من متجرد","https://www.aldiwan.net/poem13856.html","الكامل"],[558,"إن عين الوجود ليس تنام","https://www.aldiwan.net/poem34186.html","الخفيف"],[558,"لا تلمني إن السماع يقيت","https://www.aldiwan.net/poem34714.html","الخفيف"],[558,"لي في الإله عقيدة غراء","https://www.aldiwan.net/poem35090.html","الكامل"],[575,"أعملوا في هجوه الفكرا","https://www.aldiwan.net/poem2814.html","المديد"]],"verses":[["وفمٌ بارد المراشف لكن","كبدي منه في سواءِ الجحيم",0,"م",1,0],["وَفَمي عَلى فَمِهِ يُسامِرُ ريقَهُ","وَيَدي تَنَزَّهُ في حَدائِقِ جِلدِهِ",1,"د",2,0],["وَفَمٍ كُلَما شَكا أَلم الوج","د تَعَلّقتُهُ بِقَطفٍ وَرَشفِ",2,"ف",1,0],["وفمٌ مهروتٌ يضاهي فم اللي","ث يريني ناباً هي العنقفيرُ",3,"ر",1,0],["وفمٌ ناضبٌ به حَرُّ أنفا","سكَ يطغى على ضعيفِ أنينِكْ",4,"ك",1,0],["وفم مثل خاتم الحسن يُزهى","بابتسام عذبٍ ونطقٍ ظَريفِ",5,"ف",1,0],["وفم مثل حسنه","الفرد في الناس يندر",6,"ر",1,0],["وفمي بفيها لاصقٌ وأضالعي","كادت تشقُّ ضلوعَها تقريبا",7,"ب",2,0],["وفمٌ أقاحيُّ البسَامة مُسْكر","حلو المذاق يعلني بسلافِه",8,"ف",2,0],["وفم الكائنات ينطق لكن","نحن قومٌ أسماعُنا الأفهامُ",9,"م",1,0],["وفم الناي نافخ بثنايا","منه لاح المحيى بنا المميت",10,"ت",1,0],["وفم يحدث بالمثاني الغض لا","زالت تجول بغيثه الأنواء",11,"ا",2,0],["وفمٌ كالحشِّ يَنفحُنا","بحديثٍ مثلِ أَلْفِ خَرا",12,"ر",2,0]]}