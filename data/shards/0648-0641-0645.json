{"poems":[[74,"مدمع سائل لغير رحيم","https://www.aldiwan.net/poem19679.html","الخفيف"],[46,"ظبي يتيه بورده في خده","https://www.aldiwan.net/poem30258.html","الكامل"],[104,"جئت تتلو علي صفحة ماض","https://www.aldiwan.net/poem33091.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39541","الخفيف"],[208,"أنا أفديك من ملول أَلوف","https://www.aldiwan.net/poem53242.html","الخفيف"],[226,"جاء للقصر يخطر","https://www.aldiwan.net/poem55281.html","مجزوء الخفيف"],[275,"لما وردت الماء صار لهيبا","https://www.aldiwan.net/poem35420.html","الكامل"],[457,"فديه في الحمام من متجرد","https://www.aldiwan.net/poem13856.html","الكامل"],[563,"إن عين الوجود ليس تنام","https://www.aldiwan.net/poem34186.html","الخفيف"],[563,"لا تلمني إن السماع يقيت","https://www.aldiwan.net/poem34714.html","الخفيف"],[563,"لي في الإله عقيدة غراء","https://www.aldiwan.net/poem35090.html","الكامل"],[580,"أعملوا في هجوه الفكرا","https://www.aldiwan.net/poem2814.html","المديد"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77609","الرجز"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129532","الخفيف"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79479","الخفيف"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118101","الكامل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102302","الرمل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49934","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108870","الكامل"],[2175,"","https://poetry.dctabudhabi.ae/diwan/poem/101276","الكامل"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123655","الرمل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103767","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94267","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205845","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205829","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101631","الكامل"],[3447,"","https://poetry.dctabudhabi.ae/diwan/poem/32739","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74044","الخفيف"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45736","الكامل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46020","الرمل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125843","الرمل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93259","الكامل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67450","الكامل"],[4755,"الشاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=183567",""],[4888,"مدرسة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=207751",""],[5032,"حق الوقوف","https://www.poetsgate.com/ViewPoem.aspx?id=189849",""],[4119,"حسبي من البرحاء أني مولع","https://www.poetsgate.com/ViewPoem.aspx?id=16185",""],[585,"أنا في الطائف أستوحي الشعور","https://www.poetsgate.com/ViewPoem.aspx?id=161867",""],[5186,"رب خير يولى ولا من بشير","https://www.poetsgate.com/ViewPoem.aspx?id=156485",""],[5198,"ذوق","https://www.poetsgate.com/ViewPoem.aspx?id=135069",""],[5351,"آخر الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=202029",""],[5351,"وجع الجبال","https://www.poetsgate.com/ViewPoem.aspx?id=202145",""],[5408,"دمعة حزن","https://www.poetsgate.com/ViewPoem.aspx?id=190864",""],[5628,"المخادعة","https://www.poetsgate.com/ViewPoem.aspx?id=178801",""],[5691,"بحر عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=207064",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[313,"أمل المحروم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66512&r=&rc=34",""],[6305,"رؤى في أخريات الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87346&r=&rc=19",""],[5190,"لا تسألي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85040&r=&rc=115",""],[6355,"وجه جارتنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66685&r=&rc=145",""]],"verses":[["وفمٌ بارد المراشف لكن","كبدي منه في سواءِ الجحيم",0,"م",1,0],["وَفَمي عَلى فَمِهِ يُسامِرُ ريقَهُ","وَيَدي تَنَزَّهُ في حَدائِقِ جِلدِهِ",1,"د",2,0],["وَفَمٍ كُلَما شَكا أَلم الوج","د تَعَلّقتُهُ بِقَطفٍ وَرَشفِ",2,"ف",1,0],["وفمٌ مهروتٌ يضاهي فم اللي","ث يريني ناباً هي العنقفيرُ",3,"ر",1,0],["وفمٌ ناضبٌ به حَرُّ أنفا","سكَ يطغى على ضعيفِ أنينِكْ",4,"ك",1,0],["وفم مثل خاتم الحسن يُزهى","بابتسام عذبٍ ونطقٍ ظَريفِ",5,"ف",1,0],["وفم مثل حسنه","الفرد في الناس يندر",6,"ر",1,0],["وفمي بفيها لاصقٌ وأضالعي","كادت تشقُّ ضلوعَها تقريبا",7,"ب",2,0],["وفمٌ أقاحيُّ البسَامة مُسْكر","حلو المذاق يعلني بسلافِه",8,"ف",2,0],["وفم الكائنات ينطق لكن","نحن قومٌ أسماعُنا الأفهامُ",9,"م",1,0],["وفم الناي نافخ بثنايا","منه لاح المحيى بنا المميت",10,"ت",1,0],["وفم يحدث بالمثاني الغض لا","زالت تجول بغيثه الأنواء",11,"ا",2,0],["وفمٌ كالحشِّ يَنفحُنا","بحديثٍ مثلِ أَلْفِ خَرا",12,"ر",2,0],["وَفمها يَصلح لِلمنقار","وَرُبَما يدخل ذَيلَ الفار",13,"ر",1,0],["وفم طيب المقبل والنكهة","يبدي عن مثل حب الغمام",14,"م",1,0],["وفمٌ قد أتى ببرهانِ عيسى","فهو بالطيبِ منهُ يُحيي النُّفُوسا",15,"س",2,0],["وفمٌ يحاكي الميم إلا أنه","كم حولهُ عينٌ تحومُ كصادِ",16,"د",1,0],["وفم عذب وثغر أشنب","خصر من برده يشفي الغليل",17,"ل",1,0],["وفمٌ كأَن على مُجاجة ريقه","من ريقة العنقود صَفوَ مزاجِ",18,"ج",1,0],["وفمي يقبل كاسها ويعبُّها","ويدي تمسِّحُ دنَّها بهدومي",19,"م",2,0],["وفم تبسم بالسيوف مخذم","ويد تصافح في البرية تقطع",20,"ع",1,0],["وفم عذب حلا مرشفه","لو سقى المنعوش منه لانتعش",21,"ش",1,0],["وفم فاه به قد أقسمت","شفتي باللَه أن تلثمه",22,"ه",1,0],["وفم الأِقاحي افتر باسم ثغره","ونوافج الأزهار طاب عبيرُها",23,"ر",3,0],["وفمٍ حلو اللّمى مبتسم","فرّ عن درّ تواري واستكن",24,"ن",1,0],["وفمٌ تبسم الملاحة فيه","ببريق اللمى وظَلم اللآلي",25,"ل",2,0],["وفم الكمام","رطبٌ تشعٌ به الدرر",26,"ر",1,0],["وَفَمٍ مُشرِقِ الثَنايا وَأَلحا","ظٍ مِراضٍ خِلالَ طَرفٍ كَحيلِ",27,"ل",1,0],["وَفماً كَمّه الذُهول فَأوما","من بَعيدٍ إِلى المُنى وَأَشارا",28,"ر",2,0],["وَفَمي هُوَ القَوس الأَرنّ وَمقولي","الوتر الشَديد وَأَسهُمي الانشاءُ",29,"ا",2,0],["وَفَمٌ كَالبَحرِ يَزهو","في ثَناياهُ النَّسيقَه",30,"ق",2,0],["وفم كالكهف فيه","غُرزت أنيابُ غولِ",31,"ل",1,0],["وفمي يُقَبّلُ خاتِماً في كفه","قُبَلاً تغالط عن فمٍ كالخاتم",32,"م",1,0],["وفم عقيقي تضمن لؤلؤاً","رطباً ونظم فوق ذاك زمرّدا",33,"د",2,0],["وفَمِي \"صَبَاحُ الخيرِ\" عالِقةٌ","بضِفافِهِ, ونَهَارُهُ انتَصَفا",34,"ف",2,0],["وفمٌ كمثلِ الوردةِ الحمراءِ فو","قَ وسادةٍ خجلى وبدر يصدُقُ",35,"ق",1,0],["وفَمُ النِّضال اليَوْمَ يَصْرُخُ باسْمِنا","وسِلاحُهُ في جِسْمِنا فَعَّالُ",36,"ل",1,0],["وفم تخال غديره مترقرقا","في نوره حوضا وروضا ممرعا",37,"ع",2,0],["وفمٌ فوق فمٍ تسمع من","وقعه اللثمة تترى فتثور",38,"ر",1,0],["وفم المرء ليس يخمد إلا","برجام الرغام طي القبور",39,"ر",1,0],["وفّ مابينك وبينه من حقوق","وفي سراديب الجفا المر اطرحه",40,"ح",2,0],["وفم القصيدة في دجاه ُ قوافلٌ","تمضي إلى شره الحنين السوسني",41,"ن",2,0],["وفم المقابر يغتلي","من أين؟ من فعل الكمين؟",42,"ن",1,0],["وفم النحيب يلوك ناي بكائه","والعاديات بها العوادي تمرعُ",43,"ع",1,0],["وفمي الذي سوّاك ِ لحْنا ً ساحرا ً","في كلِّ مقهى ً عامر ٍ غنّاك ِ",44,"ك",1,0],["وفمٌ عذبٌ يقطرُ الشُّهْدُ منْهُ","نغَماتٍ يذوبُ فيها الكَمانُ",45,"ن",1,0],["وفَمٌ كاستدارةِ الميمِ يُبديْ","لَكَ دُرّاً مُفَصَّلاً وعَقِيقا",46,"ق",2,0],["وفم لو قال من ينعته","هو كالعناب ما عرفه",47,"ف",2,0],["وفمي وأوراقي وما حملَتْ يدي","صمتٌ طويلٌ عمرُه يتكلَّم!",48,"م",1,0],["وفَمٌ ، لُماهُ الكَرْزِ يَقطُرُ شَهدُه","إمَّا تَرنَّمَ شَادياً أو جَوَّدا",49,"د",2,0],["وفم ينتحرُ النُّورُ بهِ","ينفثُ الأضغان ما بين القلوب",50,"ب",1,0]]}