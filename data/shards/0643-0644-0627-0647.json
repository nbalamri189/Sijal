"الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94775","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83119","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83145","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33612","المنسرح"],[4578,"سهم النوائب لا يبقى ولا يذرُ","https://www.poetsgate.com/ViewPoem.aspx?id=49427",""],[585,"خلا المجال وأودى الشاعر العلم","https://www.poetsgate.com/ViewPoem.aspx?id=161942",""],[5324,"الطامة الكبرى.","https://www.poetsgate.com/ViewPoem.aspx?id=211616",""],[5324,"بين على وعمر.","https://www.poetsgate.com/ViewPoem.aspx?id=216068",""],[5491,"قهوة العطر","https://www.poetsgate.com/ViewPoem.aspx?id=215173",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5701,"كل الورى يبغي خلودا له","https://www.poetsgate.com/ViewPoem.aspx?id=164637",""],[5771,"وجهٌ ثُلاثيُّ الأوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=189540",""],[402,"يا شاعر النيل جار النيل بالشيم","https://www.poetsgate.com/ViewPoem.aspx?id=36422",""],[5956,"عيونٌ تدري مقاصدنا ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182273",""],[6142,"يا أول الناس للإسلام مرتبة","https://www.poetsgate.com/ViewPoem.aspx?id=155742",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[6142,"ما أوتيت أنبياء الله قبل من ال","https://www.poetsgate.com/ViewPoem.aspx?id=155711",""]],"verses":[["كلاهُما في سَبيلِ الحَقِّ عَزْمَتُه","لا تَنْثَني أو يكونَ الحَقُّ ثانيها",0,"ي",3,0],["كِلاهُمَا مُخْصِبٌ قَحْلاً فَمُخْرِجُهُ","حَقْلاً وَمُؤْنِسُهُ فِي وَحْشَةِ الدِّيَمِ",1,"م",1,0],["كلاهما ضامن للناس حُرمتهم","هذا له ال",2,"ل",1,0],["كلاهما حُمُق يَفتّر عن ضرر","يَسُمّ من دمنا تلك الكُرَيّات",3,"ت",1,0],["كلاهما انسجما حتى كأنهما","تسابقا في انسجام عندما انهمرا",4,"ر",2,0],["كلاهما قد فدى بالنفس أمته","لكنّ سعدون لا سعداً قد انتحرا",4,"ر",2,0],["كلاهما في وصفهِ واحدٌ","ما أشبهَ الليلةَ بالبارحه",5,"ه",1,0],["كلاهما في طلاب القرب مستبقٌ","يتلو الثناء فنعم السابق التالي",6,"ل",2,0],["كلاهما قد علا في العالمين فلا","عدمتُ من ذا وذا جاه الإمام علي",7,"ي",1,0],["كلاهما مسكٌ إذا تأرَّجا","أبلغ سِراجَ الحُسْن ذاك المُسْرجا",8,"ج",2,0],["كلاهما لا يزال قاطعُهُ","يدعو بسقياه كلَّ ما ادَّكره",9,"ر",2,0],["كِلاهُما أجراهُ مِقدارهُ","كرهاً وهل تُعصَى المقادير",10,"ر",1,0],["كلاهما إن قيستا فلتةٌ","حانتْ وللَّهِ تدابير",10,"ر",1,0],["كِلا هذا وذاك حَياً","تبيت بُروقُه عمِلَهْ",11,"ل",2,0],["كِلاهُما صَبٌّ إِلى إِلفِهِ","حَرّانُ ظَمآنُ إِلى وَصلِهِ",12,"ل",2,0],["كلاهما يبتغي قلبا ليملكه","والقلب بينهما في المرء منقسم",13,"م",1,0],["كلاهما معدته","تأخذ شكل الشبكه",14,"ك",2,0],["كلاهما بودّه حبانا","من بعد شر غارة أصلانا",15,"ن",2,0],["كلاهما حداد","عَبَده العباد",16,"د",1,0],["كِلاهُما آخِذٌ لِلمَجدِ أُهبَتَهُ","وَباعِثٌ إِثرَ نُجحَ اليَومِ نُجحَ غَدِ",17,"د",1,0],["كِلاهُما عِبءُ مَكروهٍ إِذا اِفتَرَقا","فَكَيفَ ثِقلُهُما الموهي إِذا اِجتَمَعا",18,"ع",2,0],["كِلاهُما مُشبَعٌ رَيّانُ وارِدُهُ","الأَيِّبونَ إِلَيها وَالَّذي بَكَرا",19,"ر",2,0],["كُلُّ أَهلِ الدُنيا يَعومُ عَلى الغَف","لَةِ مِنها في غَمرِ بَحرٍ عَميقِ",20,"ق",1,0],["كلاهما ناظرٌ في عين صاحبه","موجاً من الحب والأشواق ملتطما",21,"م",2,0],["كِلاهُما رائِحٌ غادٍ يَدُلُّ عَلى","مَعروفِهِ وَعَلى حَوبائِهِ اِئتَلَفا",22,"ف",2,0],["كِلاهُما فِي العُلا كُفءٌ لِصاحِبِهِ","وَالكُفءُ في المَجدِ لا يُستامُ بِالقِيَمِ",23,"م",1,0],["كِلاهُما دَيدَبانٌ فَوقَ مَربأَةٍ","يَرعَى المَسالِكَ مِن بُعدٍ وَلَم يَنَمِ",23,"م",1,0],["كلُّ أهلِ العصرِ غمرٌ وأنا","منهمُ فاتركْ تفاصيلَ الجملْ",24,"ل",1,0],["كِلاهُما نَحوَها سامٍ بِهِمَّتِهِ","عَلى اِختِلافِهِما في مَوضِعِ العَمَلِ",25,"ل",1,0],["كِلاهُما لَم يَكُن وُدّي لَهُم صَلَفاً","لَكِن صَفاءً كَماءِ المُزنِ للعودِ",26,"د",1,0],["كِلاهُما يَتَوَقى وَالحَياةُ لَهُ","حَبيبَةٌ وَيَرومُ العَيشَ مُهتاجا",27,"ج",2,0],["كِلاهُما لَيسَ بِالمُؤَدّي","إِلَيكَ في المودَعِ الأَمانَه",28,"ن",2,0],["كلاهما يَنظُرُ حيناً خَلفَهُ","فهو يَرى في كُلِّ وَجْهٍ حتْفَهُ",29,"ه",1,0],["كلاهُما من مَرْكبِ الخَلائفِ","في حِلْيةٍ تُعْجِزُ وصفَ الواصفِ",29,"ف",1,0],["كِلاَهُمَا حَسَنٌ عندي أُسَرُّ به","لكنَّ أحلاهُما ما وافَقَ النّظرا",30,"ر",2,0],["كلاهما قَد سَقاني","ريّاً كريّ النبات",31,"ت",1,0],["كلاهما خالطت صف","وَ مائه عبراتي",31,"ي",1,0],["كلاهما عرب عن","دما يَكون انتماء",32,"ا",2,0],["كلاهما وطن للقوم مشترك","كلاهما بلد بالفضل مزدان",33,"ن",1,0],["كلاهما في حبّهِ الآثمِ","لم يصْحُ من سُكراهُ وهو الملومْ",34,"م",1,0],["كلاهما لم يَعْدُ تصويرَهُ","ما كان إلَّا مِثلما كُوِّنا",34,"ن",2,0],["كَلاهِمٍ شيئاً أبَى وَشْكُهُ","إخبارَهُ بالصّدْقِ في المَطْعَم",35,"م",1,0],["كلاهما كان رضى النبوّة","لم تشكُ كلّهُ ولانُبُوّهْ",36,"ه",1,0],["كِلاهُمَا طِبٌّ لداءِ الشِّعرِ","والفَّظِ من لَحنٍ بهِ وكسْرِ",37,"ر",1,0],["كلاهما أملت السمحاء حرمته","على أخيه فما ابتزّا ولا حقدا",38,"د",2,0],["كِلاَهُمَا خاطَ إذ بُزَّا لُبُوسَهُمضا","مِن وَرَقِ التِّينِ ثَوباً لَم يَكُن غُزِلا",39,"ل",2,0],["كِلاهُمَا فَازَ وَهْوَ أَهْلٌ","بِمَا تَمَنَّاهُ مِنْ نَصيبِ",40,"ب",1,0],["كِلاَهُمَا كَان كُفْءَ صَاحِبِهِ","بِنَبْعَتَيْهِ وَرِفْعَةِ القَدْرِ",41,"ر",1,0],["كلاهما انسكبت فيه سرائرنا","وما شهدناه لكنّا عبدناه",42,"ا",2,0],["كلاهما أذْعنَ مِنْ سَبيِّه","بلَمْلَمِيِّ الحكم كَبكبيهِ",43,"ب",3,0],["كلاهما أبداً ربحٌ لصاحبه","لاغنم فيه وبعض الربح خسران",44,"ن",1,0],["كلا هو البحرُ الغزيرُ عَنَت له","فصحاء هذا الدهرِ بالإذْعَانِ",45,"ن",1,0],["كِلاهُما منهُ في شُغْلٍ يُديرُهما","بينَ البنَانِ رضىً يَختارُ أم غَضبَا",46,"ب",2,0],["كِلاهُما قَد حَشا أشعارهُ سَفهاً","عليهِ زوراً وَأبدى حشوَ مذهبهِ",47,"ب",2,0],["كِلاهُما خَلَفٌ من بعد صاحبهِ","كِلاهما مُتعدٍّ في تصحّبهِ",47,"ب",2,0],["كلاهما رجلٌ في الناسِ وامرأةٌ","ولا مميزَ إلا ذلكَ الجسدُ",48,"د",1,0],["كلاهما في علاك طالعهُ","وفي جبينِ السعودِ سيماهُ",49,"ا",2,0],["كَلاَّ هَوَاكَ بِهَا الْخَلِيلُ فَنارُهُ","بَرْدٌ سَلاَمٌ حَرُّهَا وَلَظَاهَا",50,"ا",3,0],["كلاهما طالبٌ بالدين صاحبَه","ملحاحة تقتضي من عند ملحاح",51,"ح",1,0],["كلاهما قال أتينا إلى","إبليس في زمرة أهل العقوق",52,"ق",1,0],["كِلاهُما تبعٌ لي لا يعارضني","إِلّا الّذي خاضَ في الأطماع دون هُدى",53,"د",2,0],["كلاهُما يلعن الدنيا إذا حرمَت","يداهُ ما يشتهيه من لذاذات",54,"ت",1,0],["كِلاهُما مَوتٌ وَلَكِنَّ ذا","أَشَدُّ مِن ذاكَ لِذُلِّ السُؤال",55,"ل",1,0],["كلاهما في شرعتي منزل","ما اشبه المنزل بالمنزل",56,"ل",1,0],["كلاهما غابَ هذا في حِجابِ ضنىً","عنِ العيونِ وهذا في حِجابِ كَرى",57,"ر",2,0],["كِلاهُما صاحبُه عِندَه","طَوعاً إِلى ما شاءَ يَشتاقُهُ",58,"ق",2,0],["كلاهُما في فِعله كاسِب","والفضلُ ما يَبقى على الكاسبِ",59,"ب",1,0],["كلاهم اللَه من أحداث دهرهمو","وكلكمو من وقوع المهلكات كلي",60,"ل",2,0],["كلاهما في سرور","ورحمة الله تترى",61,"ر",2,0],["كلاهما آلة للفتك صالحة","وما سلاحك إلا في يد وفم",62,"م",1,0],["كلاهما ابدا إن أزمة عرضت","تجده للوطن المستبسل الحامي",63,"م",2,0],["كلاهما مستحدث","من عدم ومن فنا",64,"ن",2,0],["كلاهما من حيث نفساهما","تساويا فانعطفا عطفا",65,"ف",2,0],["كلاهما كلمع برق ظاهر","لعارف محقق له الشهود",66,"د",1,0],["كِلاهُما مُقتَمِسٌ مَغتوتُ","وَاللَيلُ فَوقَ الماءِ مُستَميتُ",67,"ت",1,0],["كلاهما قائِمٌ باللهِ معتَصِمٌ","بحولِهِ ناصِرٌ للحقِّ مُعْتَضِدُ",68,"د",1,0],["كلاهما مع ابنه لعلمه","بأنه يأخذ فوق سهمه",69,"ه",1,0],["كلاهما في خيله والرجل","في عدد مثل الحصى والرمل",69,"ل",1,0],["كلاهما بدر فضل لاح مكتملا","وكان يخجل منه كل نبراس",70,"س",1,0],["كلاهما كنت أفنيه على نشوا","ت الراح نهباً ووصل الخرّد العين",71,"ن",1,0],["كلاهما منبع فضل وهدى","يكرع منه حاضر وبادي",72,"د",2,0],["كِلاهُما في أَخيهِ يَجري","فَكانَ كلٌّ أَجلَّ جارِ",73,"ر",1,0],["كِلاهُما القوسُ موتورٌ بأسهمهِ","والواتِرُونَ لهُمْ أجسَادُنَا هَدَفُ",74,"ف",1,0],["كلاهي الآرام من شأنها","تُطمع في الألف ولا تألف",75,"ف",1,0],["كلاهما رقَّ أوصافاً وأفئدةً","لكن إذا رمقا لم يتركا رمقا",76,"ق",2,0],["كِلاهُما مُغْتَمِسٌ مَغْتُوتُ","وَكَلْكَلُ الماءِ لَهُ مَبِيتُ",77,"ت",1,0],["كلاهما ضربه له نفذ","فلا يقي مغفر ولا يلب",78,"ب",1,0],["كلاهما قد معا في الفاصلة","لأنها على الشمول جاصله",79,"ه",1,0],["كلاهما سيدٌ صَلتُ الجبين له","وجهُ كريمٌ بيُمن الله قدْ غَرَسا",80,"س",2,0],["كلاهما جاشَ بحراً بالنّدى لجباً","لنا وجاد غماماً بالحَيا غدقا",81,"ق",2,0],["كلاهما جرت الأفلاك فيه وقد","حفّت بحافته الأملاك فأتلفا",82,"ف",2,0],["كلاهُما جامِعٌ ديناً إلى أَدَبٍ","ما أَحسنَ الدينَ والدنيا إذا اْجتمعنا",83,"ن",2,0],["كُلُّ أهلي ومَن أُفَدّي ونَفسي","والمُفَدّيَّ للنَبيِّ الفِداءُ",84,"ا",2,0],["كلاهما قمرا هذي الكنيسة لا","زالت تصونهما من كل محذور",85,"ر",1,0],["كلّ أهل الحمى يذوبون حزناً","وبكاءً وحرقةً لنواها",86,"ا",3,0],["كِلاهُما أُكرِمَ بِالشَهادَهْ","فَسَعِدا وَأَيَّما سَعادَهْ",87,"ه",1,0],["كلاهما وسع في جهل ما","فعالهُ عندهما كفرُ",88,"ر",1,0],["كلاهما كان تزينا لصاحبه","وازدان شاد ومصغ والطوامير",89,"ر",1,0],["كَلاهُ اللَهُ مِن نُوَبِ اللَيالي","وَبَلَّغني الَّذي أَنا مِنهُ راجي",90,"ج",2,0],["كلاهما كانا لايطاليا","دريئة عاصمة مانعه",91,"ع",2,0],["كلاهما يبتغي المثوى بساحته","واللَه يحكم فيما بينهم شجرا",92,"ر",2,0],["كلاهما علم في رأسه لهب","لا يعقلُ الحكمَ فيه غيرُ مُعتبر",93,"ر",1,0],["كلاهما بدلٌ من ذات صاحبه","عند الوجود فلا تنظر إلى العدم",94,"م",1,0],["كلاهما فاق حتى صار ليس له","ثان بما عنه تستجلي ولا بمن",95,"ن",1,0],["كلاهما طفل بلا دايةٍ","عُلل باللوز وبالسكر",96,"ر",1,0],["كلاهما قد جرى في الدين مقتفياً","اباءه الصيد اشياخاً وشبانا",97,"ن",2,0],["كلاهُمَا ثلاثُ في قِيَاسِي","وَفَوقَهُنَّ نَصفُ في القياسِ",98,"س",1,0],["كلاهُمَا ثلاثةٌ مَع نِصفِ","فَحَكَّمِ النتخاتِ وآسمَع وَصفَي",98,"ي",1,0],["كلاهُمَا أربَعَةٌ تَنقَاس","أنَا الملومُ إن خَطِيتَ الراس",98,"س",1,0],["كلاهُمَا خَمسُ أصابع وَصفَا","دَرِّجهُمُ لكُلِّ راسٍ نَصفَا",98,"ف",2,0],["كلاهُم ثمانٍ في القياسِ مَحرَّرٌ","على كُلِّ راس نِصفَ ينقصُ فَآعلَمِ",99,"م",1,0],["كِلاَهُم كَمِثلِ الجاهِ أحدَ عَشَر هُمَا","على زَجَدٍ والحدِّ لا شَكَّ وَافِر",100,"ر",1,0],["كلاهما ساخرٌ من وجه صاحبه","والناس بينهما حالوا وما عدلو",101,"ل",2,0],["كلاهما اليوم ذكرى","تعيش تحت الرجام",102,"م",1,0],["كلاهما رهن شكٍّ","في الكفر والإسلام",102,"م",1,0],["كلاهما من خالق مبدعٍ","فكيف تلقيه بأرماس",103,"س",1,0],["كلاهما خادم لصاحبه","متخذ للأنام كالخدم",104,"م",1,0],["كلاهما لاجئٌ في قلب صاحبه","من عالم الناس أو من عالم الشين",105,"ن",1,0],["كلاهما في سجل جلَّ حاسبه","إِذ قلداني ما تُخشى عواقبه",106,"ه",1,0],["كلاهما فرق