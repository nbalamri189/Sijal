ماس وغصونه مواريجي","https://www.poetsgate.com/ViewPoem.aspx?id=25792",""],[4755,"صَدِّقُونِي لَن تَفقِدَ الأَرضُ شَيئًا","https://www.poetsgate.com/ViewPoem.aspx?id=200571",""],[4767,"أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=210693",""],[4830,"سُهادُ الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=210983",""],[4916,"ياعذابي","https://www.poetsgate.com/ViewPoem.aspx?id=135388",""],[4916,"مشتاقه","https://www.poetsgate.com/ViewPoem.aspx?id=136241",""],[5055,"أذكريني","https://www.poetsgate.com/ViewPoem.aspx?id=104032",""],[5081,"لَسْتَ وَهْمَاً","https://www.poetsgate.com/ViewPoem.aspx?id=187885",""],[5082,"دفءٌ وندى/ إلى أمّي","https://www.poetsgate.com/ViewPoem.aspx?id=212473",""],[5121,"طُيُورُ","https://www.poetsgate.com/ViewPoem.aspx?id=214545",""],[5136,"لاموه للبخل وقالوا درهمه","https://www.poetsgate.com/ViewPoem.aspx?id=121776",""],[5152,"من أجل من","https://www.poetsgate.com/ViewPoem.aspx?id=184525",""],[5213,"سل الأثيلات وأرمالها","https://www.poetsgate.com/ViewPoem.aspx?id=170530",""],[5213,"أرح قلوصك من كد ومن تعب","https://www.poetsgate.com/ViewPoem.aspx?id=170412",""],[5278,"يا نذير الشؤمِ...","https://www.poetsgate.com/ViewPoem.aspx?id=202542",""],[5351,"نرجسية","https://www.poetsgate.com/ViewPoem.aspx?id=202600",""],[5409,"وغادةٍ صورها ربها","https://www.poetsgate.com/ViewPoem.aspx?id=155512",""],[5413,"أضغاث أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=208591",""],[5425,"أَوفَيتَ عَهْدَكَ ، يا حَقٌّ بِمَقْتَلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=207514",""],[5452,"هواجس","https://www.poetsgate.com/ViewPoem.aspx?id=112743",""],[5488,"تجنّب رذال الناس يا نسل الأجواد","https://www.poetsgate.com/ViewPoem.aspx?id=100729",""],[5542,"حوار في ساحة المطاف","https://www.poetsgate.com/ViewPoem.aspx?id=10068",""],[5573,"عبرتك فعل البليد ومكسبه وإفلاسه","https://www.poetsgate.com/ViewPoem.aspx?id=206490",""],[5628,"خمرة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=178482",""],[5690,"بيمن سلطاننا عبد العزيز","https://www.poetsgate.com/ViewPoem.aspx?id=172150",""],[5739,"قلبي وكر ...!","https://www.poetsgate.com/ViewPoem.aspx?id=155476",""],[5756,"اربع خناجر","https://www.poetsgate.com/ViewPoem.aspx?id=5190",""],[5797,"فقيد الدين والوطن","https://www.poetsgate.com/ViewPoem.aspx?id=187796",""],[5842,"سُرَّاق النسب/ محمد الرحمون","https://www.poetsgate.com/ViewPoem.aspx?id=117029",""],[5848,"البرتقاله","https://www.poetsgate.com/ViewPoem.aspx?id=53334",""],[5939,"اللغز السهل","https://www.poetsgate.com/ViewPoem.aspx?id=185490",""],[5956,"الأستاذ حشيش","https://www.poetsgate.com/ViewPoem.aspx?id=182528",""],[6031,"يا فَتْحَ مَنْ أُغْلِقَتْ أبْوَابُ مَطْلَبِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=46357",""],[6031,"عَاثَ الحِمامُ فما أبقَى وما تَرَكَا","https://www.poetsgate.com/ViewPoem.aspx?id=46283",""],[6031,"يا طِرْسُ قُلْ لخَليلَيَّ اللذَينِ هُمَا","https://www.poetsgate.com/ViewPoem.aspx?id=46349",""],[6031,"يا سَاكِنِيْ الخَطِّ في قَلْبي لَكُمْ خِطَطٌ","https://www.poetsgate.com/ViewPoem.aspx?id=46308",""],[6068,"عيناك من عين المها -13-","https://www.poetsgate.com/ViewPoem.aspx?id=175846",""],[6070,"القاضي والذئب","https://www.poetsgate.com/ViewPoem.aspx?id=188079",""],[6093,"لو تراه سيدي خضر ( المديد)","https://www.poetsgate.com/ViewPoem.aspx?id=176023",""],[6113,"منال .........!!!","https://www.poetsgate.com/ViewPoem.aspx?id=26380",""],[6124,"ما لدمعي","https://www.poetsgate.com/ViewPoem.aspx?id=159897",""],[6256,"يا حلو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65920&r=&rc=8",""],[564,"زَارني من أُحب قبل الصباحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76805&r=&rc=42",""],[523,"الممكن والمستحيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1684&r=&rc=48",""]],"verses":[["لَو سابَقَتني المَنايا وَهيَ طالِبَةٌ","قَبضَ النُفوسِ أَتاني قَبلَها السَبَقُ",0,"ق",1,0],["لوْ ساوَمَتْهُ الأرضُ فيكَ بِما حوَتْ","لرآكَ مُسْتاماً بِها مبْخوسا",1,"س",2,0],["لوْ سارَ عدْلُك في السّنين لما اشْتَكَتْ","بَخْساً ولمْ يكُ بعضُهُنّ كَبيسا",1,"س",2,0],["لوْ سَما للبُدورِ حالَ كَمالٍ","نالَها الخَسْفُ عاجِلاً والسِّرارُ",2,"ر",1,0],["لَو سابَقَتكَ سَوابِقُ ال","أَفكارِ أَدرَكَها العِثار",3,"ر",1,0],["لو سلا القلب كُنت من أسعد النا","س ولكنَّه المشوم ألوفُ",4,"ف",1,0],["لو سار في شدق الهزَبر","بها لأمكن أن يجوزه",5,"ز",2,0],["لو سار في يبس لأبدي","من مواطئه نزيزه",5,"ز",2,0],["لَو سِرتَ تَبغي ثَرى قَومٍ ذَوي حَسَبٍ","لَم تَلقَ لِلتَيمِ أَحساباً وَلا دينا",6,"ن",2,0],["لو سكتْنا عن مدحِه مدحته","بصهيل من حوله ورُغاء",7,"ا",2,0],["لو سكتنا عن ثناءٍ لغدا","فضلكم بين البرايا غير ساكت",8,"ت",1,0],["لو سرتُ ميلاً عنك لم تتَّخذْ","عيني سوى إحسانكم مكحله",9,"ه",1,0],["لو ساعدتني حالة كانَ لي","ببعض من لاقكمُ اُسوه",10,"ه",1,1],["لو سوايَ استمال مال إليه","وَلأَلْقى لناره حَلْفاءَ",11,"ا",2,0],["لو سَبَّ غيرَ بني ثوا","بةَ ما جَشِمتُ لهم سِبابهْ",12,"ب",2,0],["لو سطَوْنا على الهريسة وافى","سيفُك الهامَ سابقاً لسنانِك",13,"ك",1,0],["لو سلكتْ فيه بعيراً لانْسلكْ","أو سبكتْ فيه حديداً لانسبكْ",14,"ك",1,0],["لو ساهم الأكرمين كلَّهمُ","في المجد والخير وحده سَهُما",15,"م",2,0],["لو سكتَ المادحونَ لاجتلبَ ال","مدحُ له نفسه ولانتظما",15,"م",2,0],["لو سألتَ القضيبَ قال ولم يك","ذبْكَ منها استعرتُ حسنَ القوام",16,"م",1,0],["لَو ساوَمَ الخَلقَ الَّذي وافى بِها","بَذَلوا لَهُ الأَرواحَ وَالأَموالا",17,"ل",2,0],["لو سألت البلاد ايكم الثا","كل قال الجميع اني التكول",18,"ل",1,0],["لَو سامَحَتنا في السَلامِ النَوى","لَطالَ حَتّى الحَشرِ ذاكَ السَلام",19,"م",1,0],["لَو سارَ ذاكَ الحَبيبُ عَن فَلَكٍ","ما رَضِيَ الشَمسَ بُرجُهُ بَدَلَه",20,"ل",2,0],["لِوَسائلِ الآداب فيما بينَنا","ذِمَمٌ وصلنَ جناحَهُ بجَنَاحِي",21,"ح",2,0],["لَو سَعى قَبلَ رِفدِهِ رِفدُ كَفٍّ","لَسَعى رِفدُهُ إِلى المَّرفودِ",22,"د",1,0],["لَو سِرتُمُ في نَواحي الأَرضِ عَدَّ لَكُم","آثارَهُ الباقِياتِ السَهلُ وَالجَبَلُ",23,"ل",1,0],["لَو سارَتِ الأَيّامُ في مَسعاتِهِم","لِتَنالَها لَتَقَطَّعَت في طولِها",24,"ل",3,0],["لو سألت الريش من أجفانه","أتقي البرد به .. لاقتلعه",25,"ع",2,0],["لو ساعَدَتْكَ اللَّيالي لم تَدع وَزَراً","للمكرُماتِ ولم تترُكْ لها عَضُدا",26,"د",2,0],["لو سَالَمَتْهُ سجايا طَرفِكَ السَّاجي","لكان أوَّلَ صبٍّ في الهَوى نَاجِي",27,"ج",2,1],["لَو سِرتُ في قُدسِ المَحَبَّةِ حافِياً","لَعَلِمتَ كَيفَ يَكونُ بِشرُ الحافي",28,"ف",2,0],["لَو سَعَت بُقعَةٌ لِإِعظامِ نُعمى","لَسَعى نَحوَها المَكانُ الجَديبُ",29,"ب",1,0],["لَو سِرتَ لَاِلتَقَتِ الضُلوعُ عَلى أَسىً","كَلِفٍ قَليلِ السِلمِ لِلأَحشاءِ",30,"ا",2,0],["لو سِيمَ نفساً شرى بهْ","مَنْ ذاقَ طعمُ شرابهْ",31,"ب",2,0],["لو سألتَ الأرضَ عنهمْ أنشدَتْ","أصبحَ الملعبُ قفراً والطللْ",32,"ل",1,0],["لَو سَعى مَن فَوقَها مِن خَلقِهِ","بَينَنا بِالصَرمِ شَتَّى وَمَعا",33,"ع",2,0],["لَو سُقي الأَمواتُ ريقَتَها","بَعدَ كَأسِ المَوتِ لَاِنتَشَروا",34,"ر",3,0],["لَو سيلَ أَهلُ الهَوى مِن بَعدِ مَوتِهِمُ","هَل فُرِّجَت عَنكُمُ مُذ مِتُّمُ الكُرَبُ",35,"ب",1,1],["لَو سيمَ يَوماً أَن يَبيعَ بِلادَهُ","بِمَمالِكِ الدُنيا مَعاً ما باعا",36,"ع",2,0],["لوْ سارَ فيهِ الشَّنْفَرَى فِتراً لَمَا","حَمَلَتْهُ في وَعْسائِهِ قَدَمانِ",37,"ن",1,0],["لوْ سِرْتُ أطلبُ هل أرَى لك مشبهاً","لطَلَبتُ شيئاً ليسَ في الإمكانِ",37,"ن",1,0],["لَو سُمتَني قَبضَ روحي","لَشِئتُ حَقّاً وَفاتي",38,"ت",2,0],["لَو سَأَلوهُ عَن وَجهِ حُجَّتِهِ","في سَبِّهِ لي لَقالَ يَعشَقُني",39,"ن",2,0],["لَو سَقَتني سُمّاً لَقُلتُ دَعوها","لا يَضُرُّ الحُوارَ وَطأَةُ أُمِّ",40,"م",1,0],["لَو ساعَفَتنا وَصَدَّ الناسُ كُلُّهُمو","لَما وَجَدتُ لِفَقدِ الناسِ مُفتَقَدا",41,"د",2,0],["لَو سَأَلتَ العُلّامَ عَنّي لَقالوا","تُب إِلى اللَهِ مِن جَفاءِ الحَبيبِ",42,"ب",1,0],["لَو سارَ ذاكَ الخَيالُ في مَطَرٍ","لَم يَخشَ فيهِ مِن بَلَّةِ النُقَطِ",43,"ط",1,0],["لَو ساعدتني صحتي","لاخترتُ عَن بغداد بعدا",44,"د",2,0],["لَو سألت الرفات ما ذا دهاه","لاشتَكى من ظلم الولاة الرفات",45,"ت",1,0],["لو ساعدتني الليالي سرت من وطني","إلى مكان بعيد منه منشعب",46,"ب",1,0],["لَوْ سَاوَفَتْنَا بِسَوْفٍٍ مِنْ تَحِيَّتَها","سَوْفَ العَيُوفِ لرَاحَ الرَّكْبُ قَدْ قنِعُوا",47,"ع",3,0],["لو سَلَكَتْ أمُّ حُبَيْنٍ بها","لاسْتُهْلِكَتْ فيها ولم تَسْلَم",48,"م",1,0],["لَوْ سِوَى الدَّهْرِ رَامَ غَبْنِي لأَصْحَرْ","تُ مُشِيحاً بِالنَّصْلِ فَوْقَ سَمَنْدِ",49,"د",1,0],["لَو ساءَني فيكَ