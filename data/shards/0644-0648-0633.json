{"poems":[[3,"لقد وجدنا زبيداَ غير صابرة","https://www.aldiwan.net/poem177.html",""],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[77,"هدم السد وهو ما هو فار","https://www.aldiwan.net/poem36415.html","الخفيف"],[86,"أهلا بأول مسلم","https://www.aldiwan.net/poem10681.html","مجزوء الكامل"],[41,"يا خليلي قد صفا كدر العيش","https://www.aldiwan.net/poem42369.html","الخفيف"],[88,"أهلاً بأضياف العراق","https://www.aldiwan.net/poem44398.html","مجزوء الكامل"],[27,"أمسى فؤادك عند الحي مرهونا","https://www.aldiwan.net/poem4439.html","البسيط"],[72,"قام يرنو بمقلة كحلاء","https://www.aldiwan.net/poem18165.html","الخفيف"],[72,"رب ليل زار فيه قمر","https://www.aldiwan.net/poem18404.html","الرمل"],[72,"إمام دين الله سمعا لمن","https://www.aldiwan.net/poem19588.html","السريع"],[72,"لو ساعدتني حالة كان لي","https://www.aldiwan.net/poem20532.html","السريع"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"قد لعمري اقتصصت من كل ضرس","https://www.aldiwan.net/poem65806.html","الخفيف"],[51,"إني إذا ما الخصم في الغي ابترك","https://www.aldiwan.net/poem65823.html","الرجز"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[51,"كان هزلا فعاد جدا غرامي","https://www.aldiwan.net/poem66364.html","الخفيف"],[91,"لله ما أحلى البشير وقوله","https://www.aldiwan.net/poem62655.html","عموديه"],[89,"فجع المشرقين خطب جليل","https://www.aldiwan.net/poem44704.html","الخفيف"],[85,"هل تيم البان فؤاد الحمام","https://www.aldiwan.net/poem63018.html","السريع"],[43,"لا تحسبوا ربعكم ولا طلله","https://www.aldiwan.net/poem10134.html","المنسرح"],[62,"مولاي أكرم من ألوذ بظله","https://www.aldiwan.net/poem52461.html","الكامل"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[45,"لا دمنة بلوى خبت ولا طلل","https://www.aldiwan.net/poem65579.html","البسيط"],[45,"تلك الديار ودارسات طلولها","https://www.aldiwan.net/poem65581.html","الكامل"],[99,"الشقيقتان","https://www.aldiwan.net/poem6547.html","عموديه"],[61,"صنائع الله لا نحصي لها عددا","https://www.aldiwan.net/poem51725.html","البسيط"],[61,"لو سالمته سجايا طرفك الساجي","https://www.aldiwan.net/poem51752.html","البسيط"],[66,"حذرا عليك من الفعال الجافي","https://www.aldiwan.net/poem38689.html","الكامل"],[44,"ديمة سمحة القياد سكوب","https://www.aldiwan.net/poem30571.html","الخفيف"],[44,"يا موضع الشدنية الوجناء","https://www.aldiwan.net/poem30593.html","الكامل"],[69,"فضل لديك اكتسى به","https://www.aldiwan.net/poem28908.html","المجتث"],[69,"ذهب الصدق وإخلاص العمل","https://www.aldiwan.net/poem29305.html","الرمل"],[31,"يا خليلي إذا لم تنفعا","https://www.aldiwan.net/poem42236.html","الرمل"],[31,"يا خليلي هاجني الذكر","https://www.aldiwan.net/poem42511.html","المديد"],[33,"لو سيل أهل الهوى من بعد موتهم","https://www.aldiwan.net/poem26021.html","البسيط"],[105,"يا سوء ما حمل البريد ويا لها","https://www.aldiwan.net/poem43092.html","الكامل"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[48,"ما لي وللعاذلات","https://www.aldiwan.net/poem62464.html","المجتث"],[48,"وابأبي من إذا ذكرت له","https://www.aldiwan.net/poem66099.html","المنسرح"],[50,"طرقتنا ذات البنان الأحم","https://www.aldiwan.net/poem62229.html","الطويل"],[50,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[50,"يا خليلا نبا بنا في المشيب","https://www.aldiwan.net/poem64853.html","الخفيف"],[46,"يا ربة الصمت أنت آمنة","https://www.aldiwan.net/poem22918.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85556","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16681","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42575","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[106,"حرب الرذيلة","https://www.poetsgate.com/ViewPoem.aspx?id=179641",""],[106,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179448",""],[43,"ما أجدر الأيام والليالي","https://www.poetsgate.com/ViewPoem.aspx?id=77",""],[90,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""],[91,"فتح اورشليم","https://www.poetsgate.com/ViewPoem.aspx?id=53229",""],[110,"فضح الشمس بالضياء بهاؤه","https://www.aldiwan.net/poem16202.html","الخفيف"],[136,"من بعد حمزة يحمي حوزة الأدب","https://www.aldiwan.net/poem49177.html","البسيط"],[170,"العز ما خضعت لهيبته العدى","https://www.aldiwan.net/poem1618.html",""],[186,"وثقيل في القلب والعين والسم","https://www.aldiwan.net/poem14124.html","الخفيف"],[189,"سيف الملهم","https://www.aldiwan.net/poem35677.html","الكامل"],[200,"عثرت في مدارها الأيام","https://www.aldiwan.net/poem45167.html","الخفيف"],[200,"علم الله أنني بك صب","https://www.aldiwan.net/poem45556.html","الخفيف"],[200,"يا صاح من للقلب من نائم","https://www.aldiwan.net/poem45596.html","السريع"],[212,"شادن قد وفى فأسكر روحا","https://www.aldiwan.net/poem46593.html","الخفيف"],[230,"قد أغتدي قبل الصباح المسفر","https://www.aldiwan.net/poem51001.html","الرجز"],[230,"لهفي على من أقمت عذره","https://www.aldiwan.net/poem51055.html","مخلع البسيط"],[233,"ما حلت عن عهدهم يوما فلم جالوا","https://www.aldiwan.net/poem14837.html","البسيط"],[272,"عاهدوا الربع ولوعا وغراما","https://www.aldiwan.net/poem52089.html","الرمل"],[283,"صاد الفؤاد برمل رامة ريم","https://www.aldiwan.net/poem32627.html","الكامل"],[283,"مه لا تلم يا لائمي صبا هلك","https://www.aldiwan.net/poem32684.html","الرجز"],[283,"جيب الربيع على الإحسان مزرور","https://www.aldiwan.net/poem32762.html","البسيط"],[350,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[365,"إن قصرت بي عن الأغراض أيامي","https://www.aldiwan.net/poem60648.html","البسيط"],[365,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[381,"لا يخدعنك جمال صوره","https://www.aldiwan.net/poem48759.html","مجزوء الكامل"],[404,"إطلاق أغلوطة عليه كما","https://www.aldiwan.net/poem33901.html","المنسرح"],[410,"لو سرت في عرض البسيطة طالبا","https://www.aldiwan.net/poem31835.html","عموديه"],[417,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[433,"أطاع ما يأمره الناهي","https://www.aldiwan.net/poem12344.html","السريع"],[438,"سفها بكيت بدمع عين هام","https://www.aldiwan.net/poem2585.html","الكامل"],[453,"حفت بوادي الغوطة ال","https://www.aldiwan.net/poem13752.html","مجزوء الكامل"],[459,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[459,"هب من زمانك بعض الجد للعب","https://www.aldiwan.net/poem56302.html","البسيط"],[462,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[465,"طاعة الدمع وعصيان المنام","https://www.aldiwan.net/poem3436.html","عموديه"],[465,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[480,"نبأ الصلح طن فينا صداه","https://www.aldiwan.net/poem37196.html","الخفيف"],[496,"وكلني بالهم والكآبة","https://www.aldiwan.net/poem10290.html","الرجز"],[514,"لو سامح الدهر أو لو ساعد العمر","https://www.aldiwan.net/poem67676.html","عموديه"],[516,"هي سلوة حلت عقود وفائها","https://www.aldiwan.net/poem11999.html","الكامل"],[516,"من كان لا يعشق الأجياد والحدقا","https://www.aldiwan.net/poem12182.html","البسيط"],[530,"لو سمعتم أصوات ظفران في","https://www.aldiwan.net/poem37518.html","الخفيف"],[554,"أغرى به الشوق ليل الساهر الرمد","https://www.aldiwan.net/poem68425.html","البسيط"],[560,"زارني من أحب قبل الصباح","https://www.aldiwan.net/poem69365.html","الخفيف"],[565,"لو سلمنا من العمائم طراً","https://www.aldiwan.net/poem870.html",""],[568,"استبعد العهد القريب لها","https://www.aldiwan.net/poem69537.html","السريع"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["لَو سابَقَتني المَنايا وَهيَ طالِبَةٌ","قَبضَ النُفوسِ أَتاني قَبلَها السَبَقُ",0,"ق",1,0],["لوْ ساوَمَتْهُ الأرضُ فيكَ بِما حوَتْ","لرآكَ مُسْتاماً بِها مبْخوسا",1,"س",2,0],["لوْ سارَ عدْلُك في السّنين لما اشْتَكَتْ","بَخْساً ولمْ يكُ بعضُهُنّ كَبيسا",1,"س",2,0],["لوْ سَما للبُدورِ حالَ كَمالٍ","نالَها الخَسْفُ عاجِلاً والسِّرارُ",2,"ر",1,0],["لَو سابَقَتكَ سَوابِقُ ال","أَفكارِ أَدرَكَها العِثار",3,"ر",1,0],["لو سلا القلب كُنت من أسعد النا","س ولكنَّه المشوم ألوفُ",4,"ف",1,0],["لو سار في شدق الهزَبر","بها لأمكن أن يجوزه",5,"ز",2,0],["لو سار في يبس لأبدي","من مواطئه نزيزه",5,"ز",2,0],["لَو سِرتَ تَبغي ثَرى قَومٍ ذَوي حَسَبٍ","لَم تَلقَ لِلتَيمِ أَحساباً وَلا دينا",6,"ن",2,0],["لو سكتْنا عن مدحِه مدحته","بصهيل من حوله ورُغاء",7,"ا",2,0],["لو سكتنا عن ثناءٍ لغدا","فضلكم بين البرايا غير ساكت",8,"ت",1,0],["لو سرتُ ميلاً عنك لم تتَّخذْ","عيني سوى إحسانكم مكحله",9,"ه",1,0],["لو ساعدتني حالة كانَ لي","ببعض من لاقكمُ اُسوه",10,"ه",1,1],["لو سوايَ استمال مال إليه","وَلأَلْقى لناره حَلْفاءَ",11,"ا",2,0],["لو سَبَّ غيرَ بني ثوا","بةَ ما جَشِمتُ لهم سِبابهْ",12,"ب",2,0],["لو سطَوْنا على الهريسة وافى","سيفُك الهامَ سابقاً لسنانِك",13,"ك",1,0],["لو سلكتْ فيه بعيراً لانْسلكْ","أو سبكتْ فيه حديداً لانسبكْ",14,"ك",1,0],["لو ساهم الأكرمين كلَّهمُ","في المجد والخير وحده سَهُما",15,"م",2,0],["لو سكتَ المادحونَ لاجتلبَ ال","مدحُ له نفسه ولانتظما",15,"م",2,0],["لو سألتَ القضيبَ قال ولم يك","ذبْكَ منها استعرتُ حسنَ القوام",16,"م",1,0],["لَو ساوَمَ الخَلقَ الَّذي وافى بِها","بَذَلوا لَهُ الأَرواحَ وَالأَموالا",17,"ل",2,0],["لو سألت البلاد ايكم الثا","كل قال الجميع اني التكول",18,"ل",1,0],["لَو سامَحَتنا في السَلامِ النَوى","لَطالَ حَتّى الحَشرِ ذاكَ السَلام",19,"م",1,0],["لَو سارَ ذاكَ الحَبيبُ عَن فَلَكٍ","ما رَضِيَ الشَمسَ بُرجُهُ بَدَلَه",20,"ل",2,0],["لِوَسائلِ الآداب فيما بينَنا","ذِمَمٌ وصلنَ جناحَهُ بجَنَاحِي",21,"ح",2,0],["لَو سَعى قَبلَ رِفدِهِ رِفدُ كَفٍّ","لَسَعى رِفدُهُ إِلى المَّرفودِ",22,"د",1,0],["لَو سِرتُمُ في نَواحي الأَرضِ عَدَّ لَكُم","آثارَهُ الباقِياتِ السَهلُ وَالجَبَلُ",23,"ل",1,0],["لَو سارَتِ الأَيّامُ في مَسعاتِهِم","لِتَنالَها لَتَقَطَّعَت في طولِها",24,"ل",3,0],["لو سألت الريش من أجفانه","أتقي البرد به .. لاقتلعه",25,"ع",2,0],["لو ساعَدَتْكَ اللَّيالي لم تَدع وَزَراً","للمكرُماتِ ولم تترُكْ لها عَضُدا",26,"د",2,0],["لو سَالَمَتْهُ سجايا طَرفِكَ السَّاجي","لكان أوَّلَ صبٍّ في الهَوى نَاجِي",27,"ج",2,1],["لَو سِرتُ في قُدسِ المَحَبَّةِ حافِياً","لَعَلِمتَ كَيفَ يَكونُ بِشرُ الحافي",28,"ف",2,0],["لَو سَعَت بُقعَةٌ لِإِعظامِ نُعمى","لَسَعى نَحوَها المَكانُ الجَديبُ",29,"ب",1,0],["لَو سِرتَ لَاِلتَقَتِ الضُلوعُ عَلى أَسىً","كَلِفٍ قَليلِ السِلمِ لِلأَحشاءِ",30,"ا",2,0],["لو سِيمَ نفساً شرى بهْ","مَنْ ذاقَ طعمُ شرابهْ",31,"ب",2,0],["لو سألتَ الأرضَ عنهمْ أنشدَتْ","أصبحَ الملعبُ قفراً والطللْ",32,"ل",1,0],["لَو سَعى مَن فَوقَها مِن خَلقِهِ","بَينَنا بِالصَرمِ شَتَّى وَمَعا",33,"ع",2,0],["لَو سُقي الأَمواتُ ريقَتَها","بَعدَ كَأسِ المَوتِ لَاِنتَشَروا",34,"ر",3,0],["لَو سيلَ أَهلُ الهَوى مِن بَعدِ مَوتِهِمُ","هَل فُرِّجَت عَنكُمُ مُذ مِتُّمُ الكُرَبُ",35,"ب",1,1],["لَو سيمَ يَوماً أَن يَبيعَ بِلادَهُ","بِمَمالِكِ الدُنيا مَعاً ما باعا",36,"ع",2,0],["لوْ سارَ فيهِ الشَّنْفَرَى فِتراً لَمَا","حَمَلَتْهُ في وَعْسائِهِ قَدَمانِ",37,"ن",1,0],["لوْ سِرْتُ أطلبُ هل أرَى لك مشبهاً","لطَلَبتُ شيئاً ليسَ في الإمكانِ",37,"ن",1,0],["لَو سُمتَني قَبضَ روحي","لَشِئتُ حَقّاً وَفاتي",38,"ت",2,0],["لَو سَأَلوهُ عَن وَجهِ حُجَّتِهِ","في سَبِّهِ لي لَقالَ يَعشَقُني",39,"ن",2,0],["لَو سَقَتني سُمّاً لَقُلتُ دَعوها","لا يَضُرُّ الحُوارَ وَطأَةُ أُمِّ",40,"م",1,0],["لَو ساعَفَتنا وَصَدَّ الناسُ كُلُّهُمو","لَما وَجَدتُ لِفَقدِ الناسِ مُفتَقَدا",41,"د",2,0],["لَو سَأَلتَ العُلّامَ عَنّي لَقالوا","تُب إِلى اللَهِ مِن جَفاءِ الحَبيبِ",42,"ب",1,0],["لَو سارَ ذاكَ الخَيالُ في مَطَرٍ","لَم يَخشَ فيهِ مِن بَلَّةِ النُقَطِ",43,"ط",1,0],["لَو ساعدتني صحتي","لاخترتُ عَن بغداد بعدا",44,"د",2,0],["لَو سألت الرفات ما ذا دهاه","لاشتَكى من ظلم الولاة الرفات",45,"ت",1,0],["لو ساعدتني الليالي سرت من وطني","إلى مكان بعيد منه منشعب",46,"ب",1,0],["لو سَلَكَتْ أمُّ حُبَيْنٍ بها","لاسْتُهْلِكَتْ فيها ولم تَسْلَم",47,"م",1,0],["لَوْ سِوَى الدَّهْرِ رَامَ غَبْنِي لأَصْحَرْ","تُ مُشِيحاً بِالنَّصْلِ فَ