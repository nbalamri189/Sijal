{"poems":[[85,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[74,"حلفت بليل الشعر منه إذا سجى","https://www.aldiwan.net/poem18453.html","الطويل"],[53,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[53,"لا تبعدن قصائد ذهبت سدى","https://www.aldiwan.net/poem61937.html","الكامل"],[16,"وشامت بي لا تخفى عداوته","https://www.aldiwan.net/poem27687.html","البسيط"],[47,"أبر على الألواء نائلك الغمر","https://www.aldiwan.net/poem63606.html","الطويل"],[69,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[48,"أم الكتاب إذا قومت محكمها","https://www.aldiwan.net/poem23089.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62250","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141010",""],[139,"لماذا أهاب الضيم أو أرهب الدهرا","https://www.aldiwan.net/poem49089.html","الطويل"],[154,"صن النفس واصرفها عن اللهو","https://www.aldiwan.net/poem68584.html","الطويل"],[190,"ولما صح لي تدقيق فكر","https://www.aldiwan.net/poem43243.html","الوافر"],[208,"حبيبي ذاك البدر إذ وافق النصفا","https://www.aldiwan.net/poem53243.html","الطويل"],[215,"ولما صار ود الناس ختلا","https://www.aldiwan.net/poem46611.html","الوافر"],[265,"لقد آن إعراضي عن الغي جانبا","https://www.aldiwan.net/poem38364.html","الطويل"],[346,"أنا أهواك يا ليلى","https://www.aldiwan.net/poem55339.html","الهزج"],[353,"لغيري برقك الخلب","https://www.aldiwan.net/poem15835.html","الهزج"],[368,"عداك الحادثات إلى عداكا","https://www.aldiwan.net/poem60815.html","الوافر"],[370,"وصل كتاب مولا ي بعدما","https://www.aldiwan.net/poem17899.html","الطويل"],[410,"ليهن كلاك مداها القصي","https://www.aldiwan.net/poem50088.html","المتقارب"],[436,"طليعة جيشك النصر المبين","https://www.aldiwan.net/poem12744.html","الوافر"],[578,"مدحت السرى وهي الحقيقة بالم","https://www.aldiwan.net/poem3019.html","الطويل"]],"verses":[["ولم أَصحُ من خمر اللحاظ وقد غدا","به الجوُّ وضّاح الأسِرَّةِ صاحبا",0,"ب",2,0],["ولم أصبُ من لهوٍ بنقطة خاله","إلى كرةٍ من حولها الصدغ صولجا",1,"ج",2,0],["ولما صداك إذا نُبِشْتَ لثالثٍ","من مُلْحَدٍ وضجيعُك الإلحادُ",2,"د",1,0],["ولَمَا صداك يسيل منه صديدُهُ","يوماً بأنتَن منك حيّاً تُجتَدى",3,"د",2,0],["وَلَم أُصَبِّح جِمامَ الماءِ طاوِيَةً","بِالقَوم وِردُهمُ لِلخِمسِ تَبكيرُ",4,"ر",1,0],["وَلَمّا صَعَدتَ المِنبَرَ اِهتَزَّ وَاِكتَسى","ضِياءً وَإِشراقاً كَما سَطَعَ الفَجرُ",5,"ر",1,0],["ولَما صار ذاك الغَيْثُ سَيْلاً","علاهُ مِنَ الثَّرَى الزَّبَدُ الغَرِيبُ",6,"ب",1,0],["وَلَم أُصاحِبكَ في تَيهاءَ مُقفَرَةٍ","بِها يُصافِنُ ماءً مَن يُصافيكَ",7,"ك",1,0],["وَلَمْ أَصْطِبحْ صَهْباء صافِيَةَ القَذَى","بِأَكْدَرَ مِنْ ماءِ اللَّهابَةِ والعَجْبِ",8,"ب",1,1],["ولمّا صار ودّ النّاس خبّاً","جزيت على ابتسامٍ بابتسام",9,"م",1,0],["ولما صَبت نفسي لأن تدرك العلى","وظنت بهذا الدهر من شوقها خيراً",10,"ر",2,0],["وَلَمّا صَرَفنا نَحوَهُ كُلَّ وِجهَةٍ","كَشَفنا بِهِ عَنّا دُجى كُلِّ شُبهَةٍ",11,"ه",1,0],["ولمّا صحّ لي تدقيق فكر","ومعرفةٌ وإثبات العيان",12,"ن",1,1],["ولمّا صرفتَ الوجهَ عنه تكبُّراً","رأينا لذاك اللون عن وجهه صرفا",13,"ف",2,0],["ولما صار ود الناس ختلاً","وأوحش ربعهم من بعد أنس",14,"س",1,1],["ولم اصطحبها غارة اثر غارة","وان كنت فيها للمحامد كاسبا",15,"ب",2,0],["ولم أصبر على الهجر","وذاك الصد اشقاني",16,"ي",1,0],["وَلَمّا صِرتَ لي عَيناً","رَأَيتُ العَينَ في الكُلِّ",17,"ل",1,0],["ولمّا صارَ حَمدُ النّاسِ وحْشاً","نَصبتَ من الجميلِ له شِباكا",18,"ك",2,0],["وَلَم أُصَدِّقُهُ","وَلَكِنَّهُ قَد خالَطَ اللَحمَ وَالدَما",19,"م",2,0],["وَلما صَفا لي ريق الحَياةِ","وَساغ لي العَذب مِنهُ المَريّ",20,"ي",1,0],["ولما صحّ أنّ الله راضٍ","بفعلِك سحّ عارضُه الهَتونُ",21,"ن",1,0],["ولم أَصرع العذَّالَ في مَعْركَ الهوى","ومن قدِّه رُمْحِي ومِنْ لَحْظِه سَهْمِي",22,"م",2,0]]}