{"poems":[[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[72,"حلفت بليل الشعر منه إذا سجى","https://www.aldiwan.net/poem18453.html","الطويل"],[51,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[51,"لا تبعدن قصائد ذهبت سدى","https://www.aldiwan.net/poem61937.html","الكامل"],[16,"وشامت بي لا تخفى عداوته","https://www.aldiwan.net/poem27687.html","البسيط"],[45,"أبر على الألواء نائلك الغمر","https://www.aldiwan.net/poem63606.html","الطويل"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[46,"أم الكتاب إذا قومت محكمها","https://www.aldiwan.net/poem23089.html","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141010",""],[133,"لماذا أهاب الضيم أو أرهب الدهرا","https://www.aldiwan.net/poem49089.html","الطويل"],[148,"صن النفس واصرفها عن اللهو","https://www.aldiwan.net/poem68584.html","الطويل"],[184,"ولما صح لي تدقيق فكر","https://www.aldiwan.net/poem43243.html","الوافر"],[202,"حبيبي ذاك البدر إذ وافق النصفا","https://www.aldiwan.net/poem53243.html","الطويل"],[209,"ولما صار ود الناس ختلا","https://www.aldiwan.net/poem46611.html","الوافر"],[259,"لقد آن إعراضي عن الغي جانبا","https://www.aldiwan.net/poem38364.html","الطويل"],[340,"أنا أهواك يا ليلى","https://www.aldiwan.net/poem55339.html","الهزج"],[347,"لغيري برقك الخلب","https://www.aldiwan.net/poem15835.html","الهزج"],[362,"عداك الحادثات إلى عداكا","https://www.aldiwan.net/poem60815.html","الوافر"],[364,"وصل كتاب مولا ي بعدما","https://www.aldiwan.net/poem17899.html","الطويل"],[403,"ليهن كلاك مداها القصي","https://www.aldiwan.net/poem50088.html","المتقارب"],[429,"طليعة جيشك النصر المبين","https://www.aldiwan.net/poem12744.html","الوافر"],[573,"مدحت السرى وهي الحقيقة بالم","https://www.aldiwan.net/poem3019.html","الطويل"]],"verses":[["ولم أَصحُ من خمر اللحاظ وقد غدا","به الجوُّ وضّاح الأسِرَّةِ صاحبا",0,"ب",2,0],["ولم أصبُ من لهوٍ بنقطة خاله","إلى كرةٍ من حولها الصدغ صولجا",1,"ج",2,0],["ولما صداك إذا نُبِشْتَ لثالثٍ","من مُلْحَدٍ وضجيعُك الإلحادُ",2,"د",1,0],["ولَمَا صداك يسيل منه صديدُهُ","يوماً بأنتَن منك حيّاً تُجتَدى",3,"د",2,0],["وَلَم أُصَبِّح جِمامَ الماءِ طاوِيَةً","بِالقَوم وِردُهمُ لِلخِمسِ تَبكيرُ",4,"ر",1,0],["وَلَمّا صَعَدتَ المِنبَرَ اِهتَزَّ وَاِكتَسى","ضِياءً وَإِشراقاً كَما سَطَعَ الفَجرُ",5,"ر",1,0],["ولَما صار ذاك الغَيْثُ سَيْلاً","علاهُ مِنَ الثَّرَى الزَّبَدُ الغَرِيبُ",6,"ب",1,0],["وَلَم أُصاحِبكَ في تَيهاءَ مُقفَرَةٍ","بِها يُصافِنُ ماءً مَن يُصافيكَ",7,"ك",1,0],["ولمّا صار ودّ النّاس خبّاً","جزيت على ابتسامٍ بابتسام",8,"م",1,0],["ولما صَبت نفسي لأن تدرك العلى","وظنت بهذا الدهر من شوقها خيراً",9,"ر",2,0],["وَلَمّا صَرَفنا نَحوَهُ كُلَّ وِجهَةٍ","كَشَفنا بِهِ عَنّا دُجى كُلِّ شُبهَةٍ",10,"ه",1,0],["ولمّا صحّ لي تدقيق فكر","ومعرفةٌ وإثبات العيان",11,"ن",1,1],["ولمّا صرفتَ الوجهَ عنه تكبُّراً","رأينا لذاك اللون عن وجهه صرفا",12,"ف",2,0],["ولما صار ود الناس ختلاً","وأوحش ربعهم من بعد أنس",13,"س",1,1],["ولم اصطحبها غارة اثر غارة","وان كنت فيها للمحامد كاسبا",14,"ب",2,0],["ولم أصبر على الهجر","وذاك الصد اشقاني",15,"ي",1,0],["وَلَمّا صِرتَ لي عَيناً","رَأَيتُ العَينَ في الكُلِّ",16,"ل",1,0],["ولمّا صارَ حَمدُ النّاسِ وحْشاً","نَصبتَ من الجميلِ له شِباكا",17,"ك",2,0],["وَلَم أُصَدِّقُهُ","وَلَكِنَّهُ قَد خالَطَ اللَحمَ وَالدَما",18,"م",2,0],["وَلما صَفا لي ريق الحَياةِ","وَساغ لي العَذب مِنهُ المَريّ",19,"ي",1,0],["ولما صحّ أنّ الله راضٍ","بفعلِك سحّ عارضُه الهَتونُ",20,"ن",1,0],["ولم أَصرع العذَّالَ في مَعْركَ الهوى","ومن قدِّه رُمْحِي ومِنْ لَحْظِه سَهْمِي",21,"ي",1,0]]}