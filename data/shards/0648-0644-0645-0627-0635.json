{"poems":[[85,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[74,"حلفت بليل الشعر منه إذا سجى","https://www.aldiwan.net/poem18453.html","الطويل"],[53,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[53,"لا تبعدن قصائد ذهبت سدى","https://www.aldiwan.net/poem61937.html","الكامل"],[16,"وشامت بي لا تخفى عداوته","https://www.aldiwan.net/poem27687.html","البسيط"],[47,"أبر على الألواء نائلك الغمر","https://www.aldiwan.net/poem63606.html","الطويل"],[69,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[48,"أم الكتاب إذا قومت محكمها","https://www.aldiwan.net/poem23089.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62250","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141010",""],[139,"لماذا أهاب الضيم أو أرهب الدهرا","https://www.aldiwan.net/poem49089.html","الطويل"],[154,"صن النفس واصرفها عن اللهو","https://www.aldiwan.net/poem68584.html","الطويل"],[190,"ولما صح لي تدقيق فكر","https://www.aldiwan.net/poem43243.html","الوافر"],[208,"حبيبي ذاك البدر إذ وافق النصفا","https://www.aldiwan.net/poem53243.html","الطويل"],[215,"ولما صار ود الناس ختلا","https://www.aldiwan.net/poem46611.html","الوافر"],[266,"لقد آن إعراضي عن الغي جانبا","https://www.aldiwan.net/poem38364.html","الطويل"],[347,"أنا أهواك يا ليلى","https://www.aldiwan.net/poem55339.html","الهزج"],[354,"لغيري برقك الخلب","https://www.aldiwan.net/poem15835.html","الهزج"],[369,"عداك الحادثات إلى عداكا","https://www.aldiwan.net/poem60815.html","الوافر"],[371,"وصل كتاب مولا ي بعدما","https://www.aldiwan.net/poem17899.html","الطويل"],[412,"ليهن كلاك مداها القصي","https://www.aldiwan.net/poem50088.html","المتقارب"],[438,"طليعة جيشك النصر المبين","https://www.aldiwan.net/poem12744.html","الوافر"],[580,"مدحت السرى وهي الحقيقة بالم","https://www.aldiwan.net/poem3019.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103072","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86852","الكامل"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143291","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48791","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59287","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72255","الوافر"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6752","الكامل"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81892","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118416","الوافر"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46471","الوافر"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26207","الوافر"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129823","السريع"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83235","المتقارب"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140052",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100280","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58503","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91315","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117922","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131218",""],[4142,"","https://poetry.dctabudhabi.ae/diwan/poem/101326","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54396","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94988","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94579","الطويل"],[4929,"نص حروفه بغير نقط (بحر الخفيف)","https://www.poetsgate.com/ViewPoem.aspx?id=208724",""],[5708,"ولما صفا وقتي مع الحبّ ساعةً","https://www.poetsgate.com/ViewPoem.aspx?id=158081",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5956,"الفخر الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=181850",""],[6127,"فداءٌ وإباء","https://www.poetsgate.com/ViewPoem.aspx?id=215939",""],[6211,"تفاهات،تفاهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78242&r=&rc=11",""]],"verses":[["ولم أَصحُ من خمر اللحاظ وقد غدا","به الجوُّ وضّاح الأسِرَّةِ صاحبا",0,"ب",2,0],["ولم أصبُ من لهوٍ بنقطة خاله","إلى كرةٍ من حولها الصدغ صولجا",1,"ج",2,0],["ولما صداك إذا نُبِشْتَ لثالثٍ","من مُلْحَدٍ وضجيعُك الإلحادُ",2,"د",1,0],["ولَمَا صداك يسيل منه صديدُهُ","يوماً بأنتَن منك حيّاً تُجتَدى",3,"د",2,0],["وَلَم أُصَبِّح جِمامَ الماءِ طاوِيَةً","بِالقَوم وِردُهمُ لِلخِمسِ تَبكيرُ",4,"ر",1,0],["وَلَمّا صَعَدتَ المِنبَرَ اِهتَزَّ وَاِكتَسى","ضِياءً وَإِشراقاً كَما سَطَعَ الفَجرُ",5,"ر",1,0],["ولَما صار ذاك الغَيْثُ سَيْلاً","علاهُ مِنَ الثَّرَى الزَّبَدُ الغَرِيبُ",6,"ب",1,0],["وَلَم أُصاحِبكَ في تَيهاءَ مُقفَرَةٍ","بِها يُصافِنُ ماءً مَن يُصافيكَ",7,"ك",1,0],["وَلَمْ أَصْطِبحْ صَهْباء صافِيَةَ القَذَى","بِأَكْدَرَ مِنْ ماءِ اللَّهابَةِ والعَجْبِ",8,"ب",1,1],["ولمّا صار ودّ النّاس خبّاً","جزيت على ابتسامٍ بابتسام",9,"م",1,0],["ولما صَبت نفسي لأن تدرك العلى","وظنت بهذا الدهر من شوقها خيراً",10,"ر",2,0],["وَلَمّا صَرَفنا نَحوَهُ كُلَّ وِجهَةٍ","كَشَفنا بِهِ عَنّا دُجى كُلِّ شُبهَةٍ",11,"ه",1,0],["ولمّا صحّ لي تدقيق فكر","ومعرفةٌ وإثبات العيان",12,"ن",1,1],["ولمّا صرفتَ الوجهَ عنه تكبُّراً","رأينا لذاك اللون عن وجهه صرفا",13,"ف",2,0],["ولما صار ود الناس ختلاً","وأوحش ربعهم من بعد أنس",14,"س",1,1],["ولم اصطحبها غارة اثر غارة","وان كنت فيها للمحامد كاسبا",15,"ب",2,0],["ولم أصبر على الهجر","وذاك الصد اشقاني",16,"ي",1,0],["وَلَمّا صِرتَ لي عَيناً","رَأَيتُ العَينَ في الكُلِّ",17,"ل",1,0],["ولمّا صارَ حَمدُ النّاسِ وحْشاً","نَصبتَ من الجميلِ له شِباكا",18,"ك",2,0],["وَلَم أُصَدِّقُهُ","وَلَكِنَّهُ قَد خالَطَ اللَحمَ وَالدَما",19,"م",2,0],["وَلما صَفا لي ريق الحَياةِ","وَساغ لي العَذب مِنهُ المَريّ",20,"ي",1,0],["ولما صحّ أنّ الله راضٍ","بفعلِك سحّ عارضُه الهَتونُ",21,"ن",1,0],["ولم أَصرع العذَّالَ في مَعْركَ الهوى","ومن قدِّه رُمْحِي ومِنْ لَحْظِه سَهْمِي",22,"م",2,0],["ولما صلحنا للعناية والعنا","فتحنا بها الفتح المبين لها عُنوى",23,"و",2,0],["وَلما صُفعتَ عَلى قَفاك بصرمة","مِن كَفِّ حافظة لودّك تهجر",24,"ر",1,0],["ولما صرت عبدك صار يرضى","أنوشروان لو أرضاه عبدي",25,"د",2,0],["ولما صبرت على شيبها","مضوا بك يغرون شبانها",26,"ن",3,0],["وَلَمْ أصَدّقْ بِدَعْوَى سحرِ نَاظِرِهِ","حَتى أرَانِيَ حَبْلَ الشَّعْرِ ثُعْبَانَا",27,"ن",2,0],["ولما صحَّ لي بهم اعتقادي","بنور هداهمُ استوفقت رائي",28,"ي",1,0],["وَلَمّا صَفا عِندَ الإِلَهِ وَلا دَنا","منهُ اِمرُؤٌ صافاكِ أَو داناكِ",29,"ك",1,0],["وَلَما صَفَا قَلْبي وَطَاَبتْ سَرِيرَتِي","وَنَادَمَنِي صَحْويِ بِفَتْحِ الْبَصِيرة",30,"ه",1,1],["ولما صاح من فودي نذير","وصرح ثانيا بالعارضين",31,"ن",1,0],["وَلَما صارَ أَهل الأَرض طُرا","ذِئاباً صُرتُ مُفتَرِساً ذِئابه",32,"ب",2,0],["وَلَم أَصحَبُهُم وُدّاً وَلَكِن","كَما جَمَعَ العَدُوَّينِ الطَريقُ",33,"ق",1,0],["ولم أصن عرضيَ في حبّه","ولم أطع فيه الذي أنّبا",34,"ب",2,0],["وَلَمّا صَحَوتُ رَكِبتُ اِجتِهادي","وَلازَمتُهُ مَصبَحي مَغبَقي",35,"ق",2,0],["ولما صر نعلك يا منآئي","حسبت بمسمعي نغمات حادي",36,"د",2,0],["ولم أصطحب إلا رماحاً شوارعاً","ومرهفة قضباً وملمومةً جردا",37,"د",2,0],["وَلَما صِرتُ بينَ الناسِ أُلحى","تَعَلَمتُ الفُجورَ مَعَ المحالِ",38,"ل",1,0],["وَلما صَفا دَهري كَخمري شربتها","وَجانبت نُسكي في اتباع صبوتي",39,"ي",1,0],["ولما صح من حديث أبي القا","سم انقاد راضياً مختارا",40,"ر",2,0],["ولما صدمتم ظالميكم تفرقوا","ولم يبق منهم في المجال رعيل",41,"ل",1,0],["ولما صحا وجه الزمان واقبلت","سحائب هتان من المزن ماطر",42,"ر",1,1],["ولما صَبَتْ مصرٌ إلى عصرِ يوسف","أَعادَ إليها اللهُ يوسفَ والعصرا",43,"ر",2,0],["ولما صفا ناءت وخلت شهابها","فقلت فلا حزنٌ لها المصطفى اصطفى",44,"ف",2,1],["ولما صفت بِالسُرِّ كاسات نشوةٍ","فصاح الصفا حيّوا صفا كوثرُ الوِردِ",45,"د",1,0],["ولمَا صار داركُم وحماكم","موطئاً للعدوِّ ، صالَ وساحا",46,"ح",2,0],["ولَمَا صادر العدو دماكم","كحماكم وأهلك الأرواحا",46,"ح",2,0],["ولما صفا وقتي مع الحبّ ساعةً","حنانيك لو شاهدتني وخضوعي",47,"ي",1,1],["ولم أصحب القومَ الغُواةَ ولم أكُنْ","بحسن اختياري في أخي الجهل أرغبُ",48,"ب",1,0],["ولم أصبرْ على حيضٍ ومَضٍّ","وأقتحم الأواخرَ والأوائِلْ",49,"ل",1,0],["ولمّا صمَّ سامِعُهُمْ أذاناً","صليلُ السّيفِ أيقظهُ وكرُّ",50,"ر",1,0],["ولم أَصِرْ بائساً بعد الفراقِ ولا","تغيرتْ بانصرام الوصْلِ عاداتي",51,"ت",2,0]]}