{"poems":[[95,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[74,"سيج ورد الخدود بالآس","https://www.aldiwan.net/poem19018.html","المنسرح"],[71,"اسأل الفوعة الشديدة حزنا","https://www.aldiwan.net/poem28977.html","الخفيف"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[463,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77643","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55884","الرمل"],[1685,"","https://poetry.dctabudhabi.ae/diwan/poem/145241","الخفيف"],[1938,"","https://poetry.dctabudhabi.ae/diwan/poem/111210","الطويل"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142744","السريع"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124187","البسيط"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58320","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91080","المديد"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83663","الخفيف"],[4691,"بدر يسكن في بدر","https://www.poetsgate.com/ViewPoem.aspx?id=94080",""],[4785,"وقفة على الشاطئ","https://www.poetsgate.com/ViewPoem.aspx?id=12037",""],[5285,"هو وطني","https://www.poetsgate.com/ViewPoem.aspx?id=203189",""],[402,"رأوا به المثل الأعلى بأبعدما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54032&r=&rc=884",""]],"verses":[["أَيَنْزَعُونَ مِنَ الأُمِّ ابْنَهَا جَنَفاً","وَلا يُؤَاخَذُ بِالإِجْرَامِ مُجْتَرِمُ",0,"م",1,0],["أين زمان الشباب أقطعه","وأين ميدانه وأفراسي",1,"س",2,0],["أينَ زينُ البلادِ عينُ البرايا","شيخُ أهلِ الزمانِ لفظاً ومعنى",2,"ن",2,0],["أين زمانٌ مُكتسٍ يومُه","بالحبِّ مَوشِيٌّ بحُلم الغد",3,"د",1,0],["أَيْنَ زَيْنُ النَّدِيِّ مِنْهُمْ وَهمْ فِي ال","ظَّرْفِ مَا همْ وَأَيْنَ أُنْسُ النَّادِي",4,"د",2,0],["أين زماني الرطبُ فيكم ترِبتْ","يدُ زمان قلَّصتْ ظِلالَه",5,"ل",2,0],["أَين زَنامٌ مِنكَ أَين مَعبد","قالَ لَهُ وَأَنتَ منّي أَجوَد",6,"د",1,0],["أين زاهي انس أيام الوفا","ولياله إذا ما النيل عم",7,"م",1,0],["أين زين الوجوه واريته في ال","قبر، والقبر مكرم محفوظ؟",8,"ظ",1,0],["اينزل ربعي الذل والرمح ساعدي","وزرق الظبا والسمر ناي واظفار",9,"ر",1,0],["أَيْنَ زمانٌ فيكِ قَضَيْتُه","وأين سُكّانُكِ يا دارُ",10,"ر",1,0],["أين زماني الذي تقضّى","وأين جاهي وأين مالي",11,"ل",2,0],["أينَ زامَرْ دازَ عقّي لي بَرَامَزْ","دَ والأحمَدونَ يا طاووسُ",12,"س",1,0],["أَين زَيد صاحِبي خالد","ذُو وَفائي عَمرو حب وَدودْ",13,"د",1,0],["أَينَ زالَ الولِيُّ طابَ ثَراهُ","أَينَ أبناؤُه بنو الأَعمامِ",14,"م",1,0],["أينزو الظبيُ أم يعدو ويغزو","فيأسرني بطرف فيه فترُ",15,"ر",1,0],["أينَ زَهرُ النُّجومِ فيكِ وأينَ الشَّمسُ،","أينَ الهِلالُ، أين التَّمامُ؟",16,"م",1,0],["أيُنزعُ من صِبا الأيامِ","حُلمٌ كنتُ أحياه ؟!",17,"ا",2,0],["أينزعون من الم ابنها جنفا","ولا يؤاخذ بالإجرام مجترم",18,"م",1,0]]}