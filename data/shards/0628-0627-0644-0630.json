لرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125482","الرمل"],[2093,"","https://poetry.dctabudhabi.ae/diwan/poem/122176","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27383","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28014","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27636","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27591","الخفيف"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32589","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126233","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137083",""],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141206","الرجز"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104676","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115795","الخفيف"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76543","المديد"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70399","الرمل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100172","الرمل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74049","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66456","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117922","الخفيف"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36792","الرمل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/132062","الخفيف"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122231","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114459","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114560","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114052","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135496","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77149","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86359","الرمل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36400","الدوبيت"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73142","المديد"],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33817","الرمل"],[4767,"على أبواب الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=180506",""],[4859,"مصابيح الثبات","https://www.poetsgate.com/ViewPoem.aspx?id=197164",""],[4929,"خير الشهور","https://www.poetsgate.com/ViewPoem.aspx?id=211958",""],[4955,"أرقٌ على أرقٍ فما هذا الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=191895",""],[5225,"بك هلا","https://www.poetsgate.com/ViewPoem.aspx?id=27615",""],[5397,"تعجب الدهر من صبري ومن جلدي","https://www.poetsgate.com/ViewPoem.aspx?id=157958",""],[5493,"بركانُ الشرْق","https://www.poetsgate.com/ViewPoem.aspx?id=196985",""],[5518,"في ذكرى المولد النبوي الشريف","https://www.poetsgate.com/ViewPoem.aspx?id=187775",""],[5612,"بالبابِ باتَ العائدونْ","https://www.poetsgate.com/ViewPoem.aspx?id=179613",""],[4623,"على من باح بالحب ملام (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146605",""],[5756,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=5431",""],[5777,"قم فَقد لاح بريق الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=157258",""],[5829,"الفجر آتٍ والحساب عسير","https://www.poetsgate.com/ViewPoem.aspx?id=157213",""],[5953,"قال لي في المنام أبو شفيق","https://www.poetsgate.com/ViewPoem.aspx?id=93866",""],[5956,"الصديقُ المريض","https://www.poetsgate.com/ViewPoem.aspx?id=194746",""],[6093,"مشوار قصير","https://www.poetsgate.com/ViewPoem.aspx?id=181567",""],[6124,"فتنة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=194524",""],[6142,"حبذا المصطفى مدينة علم","https://www.poetsgate.com/ViewPoem.aspx?id=155699",""],[5309,"يا ابنة الشعر مبهج الأكوان","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573859",""]],"verses":[["بِالَّذي أَجراكِ يا ريحَ الخُزامى","بَلِّغي البُسفورَ عَن مِصرَ السَلاما",0,"م",2,1],["بِأَلَذَّ مِن خُلُقٍ كَريمٍ طاهِرٍ","قَد مازَجَتهُ سَلامَةُ الأَذواقِ",1,"ق",1,0],["بالذي أدْرَكَ المؤيّدَ منكم","وابنَ سعدانَ تضربُ الأمثالُ",2,"ل",1,0],["بالذي لو فاخر الخلقَ اعتلى","والذي لو وازنَ الخلقَ وَزن",3,"ن",1,0],["بِالذِكرِ يَحيا المَرءُ بَعدَ مَماتِهِ","فَاِنهَض إِلى الذِكرِ الجَميل وَخَلَّدِ",4,"د",1,0],["بالذل لا ارضى وان سلمت به","روحي وارضى بالحمام زؤاما",5,"م",2,0],["بالذي قد جوّزته يا سليمى","قد لعمري أشمتّ قلب الحسود",6,"د",1,0],["بالذي صُنتُ عهده لم أخُنه","ومتى خانت الأكفُّ المعاصم",7,"م",1,0],["بالذي فيك من سنا لا تدعني","فيم هذا المطال والإبطاء",8,"ا",2,0],["بألذَّ طعماً مِنْ مَراشفهنَّ إذ","تَبْسَمْنَ عَن دُرٍّ يضيءُ بدورُها",9,"ر",3,0],["بِأَلَذَّ مِنها إِذ تَقولُ لَنا","وَأَرَدتُ كَشفَ قِناعِها مَهلا",10,"ل",2,0],["بِالَّذي أُخفي وَأَكتُمُهُ","مِن جَميعِ الناسِ لَم أَقبَل",11,"ل",1,0],["بِأَلَذَّ مِنكِ وَإِن نَأَيتُ وَقَلَّما","تَرعى النِساءُ أَمانَةَ الغُيّابِ",12,"ب",1,0],["بِأَلَذَّ مِنها إِذ تَقولُ لَنا","سِرّاً أَسِلمٌ ذاكَ أَم حَربُ",13,"ب",1,0],["بالذي شاع بينهم","من حديث الخوارق",14,"ق",1,1],["بِالَّذِي لَمْ يَجِئْهُ وَحْيٌ وَلَكِنْ","لَمْ تَفُتْهُ خَلائقُ الأَنبياءِ",15,"ا",2,0],["بالذي لم يُغنِني عن","كِ وقد أغناك عَنّي",16,"ن",2,0],["بالذّكر تحيي كلّ قلب غافل","يا فوز من للذكر في إجهار",17,"ر",1,0],["بِالذي زانَكم وَميَّزَكُم بِال","عِلمِ وَالحِلمِ وَالهُدى وَالرَشادِ",18,"د",1,0],["بِالذُلِّ رَفَعتُ قِصَّةَ الهَجرِ إِلَيهِ","وَالأَرضُ لَثَمتُ خاضِعاً بَينَ يَدَيهِ",19,"ه",1,1],["بِالذِي تَقْتَضِيهِ مِنْكَ الْمَزَايَا","وَالسَّجَايَا الْكَرِيمَةُ الأَعْرَاقِ",20,"ق",1,0],["بألذَّ وَقعا في حَشا","ي من الكنافة والقَطَائف",21,"ف",1,0],["بالذي عافاك من وَجدٍ بهِ","لم يكن للصبر في صَدري مجالُ",22,"ل",1,0],["بالذي قد أعطاك جاها وقد م","دَّ على الخافقين بالأمن ظلَّه",23,"ل",2,0],["بالذات بسرّ السرّ بمن","أفضالك ربّي منك رَجِ",24,"ج",1,0],["بِالذَوقُ وَالسَمعِ وَالأَبصارِ نَعشَقُهُ","وَالشَمُّ وَاللَمسُ فَالأَلبابُ دارَتُهُ",25,"ت",2,0],["بالذي أحويه من ألم","والذي ألقاه من محن",26,"ن",1,0],["بِالَّذي بَينَنا وَبَينَك لا نُص","غِ لِواش فَقَد بَغى وَتَعَدّى",27,"د",2,0],["بالَّذي ألهَمَ تَعذِيبي","ثَنَاياكَ العِذابا",28,"ب",2,1],["بِالَّذي أَسكر مِن عُرف اللَما","كُل كَأس تَحتَسيها وَحَبب",29,"ب",1,1],["بِالَّذي قَدرَّ أَن تُؤدي بِنا","فرقة الأَحباب لَما إِن قَضاها",30,"ا",3,0],["بالذي لمْ يكنْ لعَمري مَعاذا","أو يكونُ الدنيُّ فينا ملاذا",31,"ذ",2,0],["بالذكا والحلم قل وبما","شئت عنه يصدق السندُ",32,"د",1,0],["بالذي صاغ وجنتيك وروداً","داوِ قلبي بشم طيب ورودك",33,"ك",1,0],["بالذي يرجع المنى","واثبات من الحفر",34,"ر",1,0],["بِالَّذي إِن بَدَت ثَناياكَ فيهِ","كانَ كَالوَردِ حُفَّ بِالأُقحُوانِ",35,"ن",1,0],["بِالَّذي مَكَّنَ أَلحا","ظَكَ مِن نَهبِ القُلوبِ",36,"ب",1,0],["بِالَّذي بَينَنا مِنَ الوُدِّ إِلّا","ما تَرَحَّلَت عَن جَموحِ الجَفاءِ",37,"ا",2,0],["بألذ من تلك الدهور مضت لنا","طيبا وليس أريجها كالأبيد",38,"د",1,0],["بالذكر وبالكتاب والأملاك ال","عمال بكل موقع كوني",39,"ي",1,0],["بالذَّاهِلينَ الخاشِعينَ تَلَهُّفاً","بالحائِرينَ الذَّائِبينَ تَمَكُّنا",40,"ن",2,0],["بالذَّاهلينَ الخائفي","نَ ذوي التَّملمُلِ في فِنائِكْ",41,"ك",1,0],["بالّذِي صَيَّرَ قَلْبِي","لِلْهَوى فِيكَ مُعانِي",42,"ن",2,0],["بالذي زادَكَ حُسناً","وجَمالا وجَلالا",43,"ل",2,0],["بالذات في ليل الجهالة لا يُرى","وبوصفه لم يخف بالتبيان",44,"ن",1,0],["بِالذّاتِ بِالصفاتِ","وَالكتبِ وَالآياتِ",45,"ت",1,0],["بالذي قد كتموا","من هواهم أفصحا",46,"ح",2,0],["بِالذَكا وَالرُشد أَهَديتَ الهُدى","لِلبَرايا ذَلِكَ الفَضل الكَبير",47,"ر",1,0],["بالذات للذات معلوماته انكشف","ماثم واسطة في الذات تعتبر",48,"ر",1,0],["بالذي جادك الملاحة حلَّه","عاطني من رحيق ثغرك نهله",49,"ه",1,0],["بالَّذي صَيَّرَ عَينَي","كَ مَحلَّ المَلَكَينِ",50,"ن",1,1],["بالذي أعطاك قل لي","كيف ينسى الأغنياءُ",51,"ا",2,0],["بألذَّ مِنها إذ تَقُولُ لنا","سَيراً قليلاً يَلحَقِ الرَّكبُ",52,"ب",1,0],["بالذاتِ يعلم لا بأمرٍ زائد","إن كنتَ علاَّماً وكنتَ حليما",53,"م",2,0],["بالذوقِ خصصنا بالشرب كرَّمنا","بالريِّ قال لنا الكل من قبلي",54,"ل",2,0],["بالذي قلت إنه عين ما بي","من سؤالٍ ومنطقٍ وجوابِ",55,"ب",1,1],["بالذي يقتضي النظر","والذي يرتضي القدر",56,"ر",1,0],["بالذُلِّ والأسْرِ والتشريد إنهمُ","على البريّة حَتْفٌ أينما نزلوا",57,"ل",3,0],["بالذُلّ قد واقيبُ بابَكَ عالماً","إن التَذَلُلَ عندَ بابِكض يَنفَعُ",58,"ع",1,0],["بالذي فيك من كريم خلال","بلغ النجم قدرك ال