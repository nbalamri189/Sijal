{"poems":[[77,"سقتني بما مجت شفاه الأراقم","https://www.aldiwan.net/poem69041.html","الطويل"],[48,"أرادوا الشر وانتظروا إماما","https://www.aldiwan.net/poem23606.html","الوافر"],[138,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[325,"وبعد فإني لا عدمتك لم يزل","https://www.aldiwan.net/poem61697.html","الكامل"],[327,"أرقت وشر الداء هم مؤرق","https://www.aldiwan.net/poem56359.html","الطويل"],[412,"صب نأى فأفاعي البين تلسعه","https://www.aldiwan.net/poem50148.html","البسيط"],[435,"سرى النسيم بعرف من ربي الطلل","https://www.aldiwan.net/poem41399.html","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53875","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38276","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120137","الرمل"],[1320,"","https://poetry.dctabudhabi.ae/diwan/poem/198192","الوافر"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115934","المنسرح"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77945","الهزج"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102059","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134039","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87382","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89043","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62847","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129398","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69937","الوافر"],[4493,"","https://poetry.dctabudhabi.ae/diwan/poem/20656","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72445","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120512","الطويل"],[4728,"اليعربيّة","https://www.poetsgate.com/ViewPoem.aspx?id=176947",""],[4748,"وداع","https://www.poetsgate.com/ViewPoem.aspx?id=4193",""],[4829,"الصمصامة (ملحمة بدر الكبرى)","https://www.poetsgate.com/ViewPoem.aspx?id=34259",""],[4829,"تتبّعني البلاوي","https://www.poetsgate.com/ViewPoem.aspx?id=34263",""],[4883,"صورة با الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=48361",""],[4899,"تاصلك في روما","https://www.poetsgate.com/ViewPoem.aspx?id=176820",""],[5084,"هلّ الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=177785",""],[5122,"لله","https://www.poetsgate.com/ViewPoem.aspx?id=27776",""],[5431,"بحبي هل أشفعه؟","https://www.poetsgate.com/ViewPoem.aspx?id=190400",""],[5461,"أجاذبك الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=30030",""],[5463,"بعزّة منهو سوّاها","https://www.poetsgate.com/ViewPoem.aspx?id=34325",""],[5463,"يا ليت بإيديني القدر وأكتبها للخافق نصيب","https://www.poetsgate.com/ViewPoem.aspx?id=34691",""],[5573,"اشوف العلم للغادي مناره","https://www.poetsgate.com/ViewPoem.aspx?id=200316",""],[5648,"سقينا العشق من كاسه","https://www.poetsgate.com/ViewPoem.aspx?id=163570",""],[5664,"الزبرجد","https://www.poetsgate.com/ViewPoem.aspx?id=176688",""],[5756,"الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=5179",""],[5837,"غيث الجهام (هلالية)","https://www.poetsgate.com/ViewPoem.aspx?id=181595",""],[5848,"خيوط الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=50585",""],[5848,"معجبك هالحال","https://www.poetsgate.com/ViewPoem.aspx?id=52023",""],[5848,"فستان عيدك","https://www.poetsgate.com/ViewPoem.aspx?id=53181",""],[5848,"اهوا دا اللي مش معقول","https://www.poetsgate.com/ViewPoem.aspx?id=53357",""],[5848,"طعنتينك","https://www.poetsgate.com/ViewPoem.aspx?id=49222",""],[5848,"أجمل تفاصيلها","https://www.poetsgate.com/ViewPoem.aspx?id=48837",""],[6056,"شيخة القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=130570",""],[6177,"شرايين التراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79077&r=&rc=20",""]],"verses":[["وأشْوَسُ غَيرانٌ عليها حُلاحِلٌ","طويلُ نجاد السيْفِ ماضي العزائم",0,"م",1,0],["وَأَشوى الحَقَّ رامَ مَشرِقِيٌّ","وَلَم يُرزَقهُ آخَرُ مَغرِبِيُّ",1,"ب",2,0],["وَأَشواط بَينَ المَروَتَينِ إِلى الصَفا","وَما فيهِما مِن صورَةٍ وَتَماثِلِ",2,"ل",1,0],["وَأَشوي الفِكرَ الكارِهينَ عَدِمَهُم","وَاِسلُق أَعراضَ العِدى وَالحَواسِدِ",3,"د",1,0],["وَأَشوَسَ ذي ضِغنٍ تَراهُ كَأَنَّهُ","إِذا أَنشَدَت يَوماً رَواتي مُخَنَّقُ",4,"ق",1,0],["وآشٍ وَشا في أَذائي جهدَ طاقته","فَلا تَهنّا بحلو العيشِ يَجرَعُهُ",5,"ع",2,0],["وأشوق قلبي لذياك الحمى وإلى","أغصانه السالبات اللب بالميل",6,"ل",1,0],["وأشواقُ قلبي بالوصال تَضَرَّمتْ","وما غُمِّضَتْ عيني ولا ملَّتِ السُّهْدَا",7,"د",2,0],["وَأَشواقٌ يُكابدُها مَشوقٌ","حَبَتهُ عَنِ الكرى قلقاً وسُهدا",8,"د",2,0],["واشوه بالضرب حتى","يتقيا ما تحسى",9,"س",2,0],["وأشواقٌ تقاذف بي كأني","عَلَوْتُ بها على طِرْفٍ جَموح",10,"ح",1,0],["واشُومَ بختى يَضُمُّنَا وطنٌ","وليس يُقضَى فيه لنا وَطَرُ",11,"ر",1,1],["وأَشواق وَأَشجان","وَشأن تحته شأن",12,"ن",1,0],["وأشواقي التي شاعت وبانت","بمن أهواه صار اليوم عاذر",13,"ر",1,0],["واشواق تمادت في هيام","على الحالين في قرب وبعد",14,"د",1,0],["وأَشواكُهُ اشواقُنا لجمالِهِ","وَحاشاهُ من شوكٍ على ذلك القدِّ",15,"د",1,0],["وا شوق قلباه إن يحيى به كلفي","والشكر لله إن يقضي به أمدي",16,"د",2,0],["وأَشوَشَ لو أَلانَ الطَّرفَ يوماً","إلى طمعٍ لما عَدِمَ الكِرامَا",17,"م",2,0],["وأشوس إن عرا الزوراء خطب","به حفت بهاليل وشوس",18,"س",1,0],["وَاشواق القُلوب اليك تَحكي","جُيوشاً لا تصدُّ مِن الجِبالِ",19,"ل",1,0],["وَأَشوَسَ سامٍ قَد عَلوتُ وَعُصبَةٍ","غِضابٍ حِناقٍ صَدَّ عَنّي نُحورُها",20,"ر",3,0],["وأشواق تؤجج نار وجد","بمدية حرها تفرى الأديما",21,"م",2,0],["واشوق ما فيها مديح عزيزها","فذاك الذي كل امرء نطق يصبى",22,"ب",2,0],["وأشوف رجلي لوصلك دون ما اشعر تسير","إذا خيالك طرى والا بعد ما طرى",23,"ر",2,0],["واشوفك في المعابر والزوايا","وافز ولن خافي السد باحي",24,"ح",2,0],["واشوف اليوم في ساح الخوالد","وقع في زرعنا بعض الجوارس",25,"س",1,0],["واشوم عن الهزايل في قصيدي","واجيب من الحكي خير المقالي",26,"ل",2,0],["وأشوفها جملة ٍ مابين قوسين","تفسيرها الدمع والحيرة والأحزان",27,"ن",1,0],["واشوف راسك في معالي معاليك","بارض الكويت بوسط ربعك بحلياك",28,"ك",1,0],["وأشوف دايه دن ًبخمسة عشر نوع","ضيم الدهر كله مع اخلاف ظنيّ",29,"ن",2,0],["وأشواق راع الحب دايم مهابيل","على الصعيب الصلف لازم تحده",30,"د",2,0],["وأشواق إذا اجتمعت","إلى عدمٍ سترجعه",31,"ع",2,0],["واشوف الودّ في عيونك ولكن","يردّ الودّ خوفٍ فيك منّي",32,"ن",2,0],["وأشوف الحب يتهدّم وأشوف بأم أعياني","كيف الله يردّ الدين يوم الدين ما جاها",33,"ا",3,0],["وأشوفها ديره ووطن وأنا بموطنها غريب","وأستاهل اللي صار لي دامي بلحظه بعتها",34,"ت",3,0],["وأشوف الصمت بالمنطق وقاره","وأشوف القول ماينفع كثيره",35,"ر",2,0],["وأشوف الصبر بالشده جساره","وأشوف الظلم مايقطع وتيره",35,"ر",2,0],["واشوفه لاصفا جوي .. بصدق الحرف والمنطوق","ولايشمله عفو ان كان .. ماوفى الكيل ميزانه",36,"ن",2,0],["وأشوف الليل يترامى تحت عمري ويصير رماد","وأشوف الضوء يغتال الظلام اللي يسودها",37,"د",3,0],["وأشوف بدمعتك حكيكوأعرفه قبل تحكينه","واجيب أحلى من اللي بتحكينه،وأتركك تحكين",38,"ن",1,0],["واشوف المهازل والسبب قلّة الفهم","عقولٍ بها عقل الحكيم يحير",39,"ر",1,0],["واشوف النجوم تطير بي يوم اتابعها","واحس بمواجع قلبي لفوق ترفعني",40,"ن",2,0],["واشوف الأحزان تاخذني وتكتبني","على الورق .. وانت في غيبتك تقراني",41,"ن",2,0],["واشوفك...... في نهار العيد...... طفله...... تنبش اسراري","تصبين الغلا..... في داخل عروقي......... عبير ازهار",42,"ر",1,0],["واشوف الزمن يرجع عليّه ويقراني","كأنه يدوّر عن سبب قسوته تبرير",43,"ر",1,0],["واشوفك في عيون الغير والعن كثرة التفكير","وامرّر بيني وبيني حكاية أخر المشوار",44,"ر",1,0],["واشوفني واقفٍ في منتصف عمري","أزفر سنيني من الضيقة وتشهقني",45,"ن",2,0],["وأشوف الحرف يتهادى وفيني حرّك الأشواق","على روض المشاعر هلّ وبل ٍ من سحاباته",46,"ت",2,0],["وأشواقٌ تأجج في الحنايا","وألوان ومعراج رحيبُ",47,"ب",1,0]]}