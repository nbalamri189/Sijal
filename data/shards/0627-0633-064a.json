,"دع العذل إني أكره العذل والغدرا","https://www.aldiwan.net/poem12480.html","الطويل"],[434,"إذا اهتز للجدوى اهتزاز مهند","https://www.aldiwan.net/poem2498.html","الطويل"],[436,"تناضل عنك أقدار السماء","https://www.aldiwan.net/poem34803.html","الوافر"],[438,"ألا شغف الفؤاد بحب ليلى","https://www.aldiwan.net/poem14328.html","الوافر"],[438,"عذاب الهوى في قلب من رامه عذب","https://www.aldiwan.net/poem14329.html","الطويل"],[438,"أسير الهوى قل لي فما أنت صانع","https://www.aldiwan.net/poem14332.html","الطويل"],[438,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[438,"وقفت ببابك اللهم","https://www.aldiwan.net/poem14363.html","الهزج"],[451,"عمر ينقضي برشد وغى","https://www.aldiwan.net/poem61787.html","الخفيف"],[456,"وذي جسدين ألقى الصبح منه","https://www.aldiwan.net/poem55880.html","الوافر"],[456,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[456,"على أي لائمة أربع","https://www.aldiwan.net/poem56136.html","المتقارب"],[456,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[456,"لكِ الغرام وللواشي بكِ التعب","https://www.aldiwan.net/poem56274.html","البسيط"],[459,"أسى وسرور ناصر ومخذل","https://www.aldiwan.net/poem15268.html","الطويل"],[459,"أسيف سل أم ذرب نطوق","https://www.aldiwan.net/poem16020.html","الوافر"],[462,"أطاع فما إلى صبر سبيل","https://www.aldiwan.net/poem3168.html","عموديه"],[462,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[462,"ليهن الورى برء العلى والفضائل","https://www.aldiwan.net/poem3265.html","عموديه"],[466,"أسير لزام من غريم غرامه","https://www.aldiwan.net/poem59693.html","الطويل"],[466,"أسير القطر قد أضحى طليقا","https://www.aldiwan.net/poem59803.html","الوافر"],[480,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[513,"فؤاد بجمر الشوق والوجد يحرق","https://www.aldiwan.net/poem12190.html","الطويل"],[527,"تهدم من ربع المعارف جانبه","https://www.aldiwan.net/poem37537.html","الطويل"],[536,"أتينا على البشا التهامي على شوق","https://www.aldiwan.net/poem47543.html","عموديه"],[544,"أمن رسم دار ماء عينيك يسفح","https://www.aldiwan.net/poem1860.html","الطويل"],[549,"أسيف الدين قد حملت ظهري","https://www.aldiwan.net/poem47308.html","الوافر"],[549,"أسيدنا الشريف علوت عن أن","https://www.aldiwan.net/poem47315.html","الوافر"],[560,"آسين بنت الأرقش اندرجت هنا","https://www.aldiwan.net/poem52670.html","الكامل"],[560,"أقول لعطفها عند النهوض","https://www.aldiwan.net/poem52931.html","الوافر"],[561,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[568,"أسير الى بني بدر بأمر","https://www.aldiwan.net/poem59466.html","الطويل"],[573,"أسير عنك بقلب عن هواك سلا","https://www.aldiwan.net/poem3033.html","البسيط"],[584,"أسير لحاظ كيف ينجو من الأسر","https://www.aldiwan.net/poem17537.html","الطويل"],[584,"أسير ألحاظ بخد أسيل","https://www.aldiwan.net/poem17692.html","السريع"]],"verses":[["أَسَيتُ عَلى آلِ المُسَيَّبِ أَنَّهُمُ","بُدورُ المَعالي غارِباتٍ وَطُلَّعا",0,"ع",2,0],["أُسيغُ الغَيظَ مِن نُوَبِ اللَيالي","وَما يَشعُرنَ بِالحَنَقِ المَغيظِ",1,"ظ",1,1],["أَسيرُ وَسَرجي بِالنِجادِ مُقَلَّدٌ","وَأَثوي وَبَيتي بِالعَوالي مُطَنَّبُ",2,"ب",1,0],["أسيرُ وأسْري للمَعالي وما بِها","لطالِبِها إلا لَدَيْكَ لُحوقُ",3,"ق",1,0],["أَسَيِّدَتي هَل مِن سَبيلٍ لِنَظرةٍ","كَنَظرَتي الأولى وَإِن هِيَ لَم تُغنِ",4,"ن",1,0],["أَسَيِّدَتي بِاللَهِ أَلا رَحِمتِني","وَفَرَّقتِ أَحزاني وَقَرَّبتِ في الوَعدِ",5,"د",1,0],["أَسيئي بِنا أَو أَحسِني لا مَلومَةً","لَدَينا وَلا مَقلِيَّةً إِن تَقَلَّتِ",6,"ت",1,0],["أسَى النّفْسِ لا يَقْوى على ردِّ فائِتٍ","فإنْ شِئْتَ فلْتُقْلِلْ وإنْ شِئْتَ فازْدَدِ",7,"د",1,0],["أَسيرُ خِلالَ الرَكبِ نَحوَ حَظيرَةٍ","عَلى رَبِّها صَلّى الإِلَهُ وَسَلَّما",8,"م",2,0],["أُسَيمِرُ موشِيُّ العِذارِ كَأَنَّما","يُناطُ بِهِ مِن ساعِديهِ جَداوِلُ",9,"ل",1,0],["أَسيلَةُ مَجرى الدَمعِ هَيفاءٌ طَفَلةٌ","شَموسٌ كَإِيماضِ الغَمامِ اِبتِسامُها",10,"م",3,0],["أَسيلَةِ مُستَنِّ الوِشاحَينِ قانِئُ","بِأَطرافِها الحِنّاءُ في سَبطٍ طَفلِ",11,"ل",1,0],["أَسيلَةُ مُستَنِّ الدُموعِ وَما جَرى","عَليهِ المِجَنُّ الجائِلُ المُتَوِشَّحُ",12,"ح",1,0],["أَسيلَةُ مَعقِدِ السِمطَينِ مِنها","وَرَيّا حَيثُ تَعتَقِدُ الحِقابا",13,"ب",2,0],["أَسَيفَ الدَولَةِ المَأمولَ إِنّي","عَنِ الدُنيا إِذا ماعِشتَ سالِ",14,"ل",1,0],["أَسيرُ عَنها وَقَلبي في المَقامِ بِها","كَأَنَّ مُهري لِثُقلِ السَيرِ مُحتَبَسُ",15,"س",1,0],["أَسَيفَ الدَولَةِ الحَكَمَ المُرَجّى","أَفي مَدحي لِقَومي مِن جُناحِ",16,"ح",1,0],["أَسَيفَ الهُدى وَقَريعَ العَرَب","عَلامَ الجَفاءُ وَفيمَ الغَضَب",17,"ب",1,1],["أسيرُك فاقْرِهِ واعددْهُ ضيفاً","فما ضيفٌ بأضعف من أسير",18,"ر",1,0],["أُسَيْوِدُ جاءَت به قردةٌ","سُوَيداءُ غاويةُ المفْرَش",19,"ش",1,0],["أسير قتل وإن أضحى طليق يد","قد أزهفت نفسه الآجال إزهافا",20,"ف",2,0],["آسى هناتٍ مستشارُ خليفة","كافي شآمٍ مستماحُ عراق",21,"ق",1,0],["أَسيلَةُ مَجرى الدَمعِ أَمّا وِشاحُها","فَيَجري وَأَمّا الحِجلُ مِنها فَلا يَجري",22,"ر",2,0],["أَسيلَةُ مَجرى الدَمعِ خَفّاقَةُ الحَشا","مِنَ الهيفِ مِبراقُ التَرائِبِ وَالنَحرِ",23,"ر",1,0],["أَسيرُ في الرَوضَةِ عِندَ الضُحى","حَيرانَ كَالمُدلِجِ في فَدفَدِ",24,"د",1,0],["أسى الشرق للفجيعة لما","غار برهان الشرق عنه يزول",25,"ل",1,0],["اسير بليل من الشك داج","على ضوء عقلي وهو ضئيل",26,"ل",1,0],["أَسيرُكِ لَو يُفدى فَدَتهُ بِجَمعِها","جَوانِحُ في شَوقٍ إِلَيهِ وَأَضلُعُ",27,"ع",1,0],["أَسَئِمتِ مِن ديباجِهِ فَنَزَعتِهِ","وَالخَزُّ أَكفانٌ إِذا لَم يُنزَعِ",28,"ع",1,0],["أَسَيفَ الدَولَةِ اِستَنجِد بِصَبرٍ","وَكَيفَ بِمِثلِ صَبرِكَ لِلجِبالِ",29,"ل",1,0],["أَسيرُ إِلى إِقطاعِهِ في ثِيابِهِ","عَلى طِرفِهِ مِن دارِهِ بِحُسامِهِ",30,"م",2,0],["أُسيرُها بَينَ أَصنامٍ أُشاهِدُها","وَلا أُشاهِدُ فيها عِفَّةَ الصَنَمِ",31,"م",1,0],["أُسَيِّرُ في أيامِكمْ من شَواردي","عُلالةَ سيرٍ حين يمتدُ سَرْبَخُ",32,"خ",1,0],["أَسيرٌ بِأَرضِ الشامِ ما حَفِظوا لَهُ","ذِمامَ الهَوى فيهِ وَلا حُرمَةَ الحُبِّ",33,"ب",1,0],["أَسيتَ لِأَقوامٍ مَلَكتَ أُمورَهُم","وَكانَت دَجَت أَيّامُهُم فَاِسوَأَدَّتِ",34,"ت",1,0],["أَسىً مُبرِحٌ بَزَّ العُيونَ دُموعَها","لِمَثوى مُقيمٍ في الثَرى غَيرُ بارِحِ",35,"ح",1,0],["أُسىً كَثُرَت حَتّى اِطمَأَنَّ لَها الجَوى","وَأَرزاءُ فَجعٍ قَدحُها في الضَمائِرِ",36,"ر",1,0],["أَسيافُهُم خَشَبٌ وَحِلفُ نِسائِهِم","إِمّا صَدَقنَ بِفَيشَةِ القِسّيسِ",37,"س",1,0],["أَسيانَ أَثرى مِن جَوىً وَصَبابَةٍ","وَأَسافَ مِن وَصلِ الحِسانِ وَأَنفَضا",38,"ض",2,0],["أَسيرُ بِطيبِ النَفسِ مِنكَ عَلى الَّتي","تُجَرِّبُ مِن سوءِ المُجازاةِ أَو تَبلو",39,"و",1,0],["أَسيتُ فَأَعطَيتُ الصَبابَةَ حَقَّها","غَداةَ اِستَقَلَّت لِلفِراقِ حُمولُها",40,"ل",3,0],["أَسىً في نُفوسِ الحاسِدينَ وَحَسرَةٌ","وَغَيظٌ عَلى أَكبادِهِم وَغَليلُ",41,"ل",1,0],["آسى عَلى فائِتِ الشَبابِ وَما","أَنفَقتُ مِنهُ في الأَعصُرِ الأُوَلِ",42,"ل",1,0],["أَسيرُ إِذ كُنتُ في طولِ المُقامِ بِها","أُكدي لَعَلِّيَ أُجدي عِندَ مُرتَحَلي",43,"ل",2,0],["أَسيتُ لِأَخوالي رَبيعَةَ إِذ عَفَت","مَصانِعُها مِنها وَأَقوَت رُبوعُها",44,"ع",3,0],["أُسَيِّدُ ذو خُرَيِّطَةٍ نَهاراً","مِنَ المُتَلَقِّطي قَرَدَ القُسامِ",45,"م",1,0],["أَسْيَانُ يَكسِرُ للسَّلامِ جُفونَه","ولو استطاعَ شَفَى الغَليلَ سَلامُه",46,"م",2,0],["أسَيفَ اللهِ أنتَ الناسُ طُرّاً","لِراجي العُرْفِ والدّنيا شآمُ",47,"م",1,0],["أسيرٌ في يدِ الأيامِ راضٍ","بما يجري به الفلَكُ المُدارُ",48,"ر",1,0],["أَسيرُكَ سِرُّكَ إِن صُنتَهُ","وَأَنتَ أَسيرٌ لَهُ إِن ظَهَر",49,"ر",1,0],["أَسَيِّدَتي هاتي فَدَيتُكِ ما جُرمي","فَأَنزِلَ فيما تَشتَهينَ مِنَ الحُكمِ",50,"م",1,1],["أَسيافُهُ نِقَمٌ عَلى أَعدائِهِ","وَأَكَفُّهُ نِعَمٌ عَلى الفُقَراءِ",51,"ا",2,0],["أَسيرُ وَمَن فَوقي وَتَحتي وَوُجهَتي","وَخَلفي وَيُمنايَ الهَوى وَشِمالِيا",52,"ي",2,0],["أَسيرَةُ حِجلٍ مُطلَقاتٌ لِحاظُها","قَضى حُسنُها أَن يُفَكَّ أَسيرُها",53,"ر",3,0],["أسيرُ إِلى لقائكِ نِضوَ شوقٍ","وأرجعُ عن ربوعكِ مستهاما",54,"م",2,0],["أسَيْرَ جبالٍ وانْتشارَ كواكبٍ","دنا من شرُوطِ الحشرِ ما كان آتيا",55,"ي",2,0],["أُسيءُ عَلى الدَهرِ الثَناءَ فَقَد قَضى","عَلَيَّ بِجَورٍ صَرفُهُ المُتَتابِعُ",56,"ع",1,0],["آسَيتَهُ في المَكرُماتِ وَلَم تَزَل","رُكناً لِمَن هُوَ مُمسِكٌ بِحِبالِهِ",57,"ل",2,0],["أَسِيرُ وَأَنْفَاسُ الْعَوَاصِفِ رُكَّدٌ","وَأَسْرِي وَأَلْحَاظُ الْكَوَاكِبِ نُوَّمُ",58,"م",1,0],["أسيدنا قاضي القضاةِ الذي لهُ","تقى وعلومٌ جمةٌ وتعفُّفُ",59,"ف",1,0],["أَسْيانَةً كَم تَلَقَّتْ بينَ أَذْرُعِها","نَجْماً هَوى إثْرَ نَجْمٍِ صاعِدٍ خَفَقا",60,"ق",2,0],["أَسيلاً لَيسَ فيهِ لِنا","ظِرٍ عَيبٌ وَلا كَلمُ",61,"م",1,0],["أَسيلاتُ أَبدانٍ دِقاقٌ خُصورُها","وَثيراتُ ما التَفَّت عَلَيهِ المَلاحِفُ",62,"ف",1,0],["أَسِيلَ المُحَيّا هَضيمَ الحَشا","كَشَمسِ الضُحى واضِحاً أَزهَرا",63,"ر",2,0],["أَسيرُ فَيغشى بِيَ دُجى اللَيلِ هِمَّةٌ","تَهُمُّ فَأَعرَوري ظُهورَ العَزائِمِ",64,"م",1,0],["أَسَيْتُ له وما بالموتِ نُكرٌ","إذا نشرَ الأسَى وطوى العِتابا",65,"ب",2,0],["أَسيتُ لِأَوطانٍ أَباحوا ذِمارَها","فَأَيدي العِدى فيها تَعيثُ وَتُفسِدُ",66,"د",1,0],["أَسيِّرُهُ فيكُم حَديثاً مُردَّداً","لَنا مَجدُهُ الأَعلى وَفيكُم مَثالبُهْ",67,"ب",2,0],["أسَيفَ الوَزَارَةِ بُورِكتَ مِن","حُسَامٍ وَأيَّدتَ مِن حَامِلِ",68,"ل",1,1],["أَسِيلَةِ مَجرى الدَمع مَهضُومَةِ الحَشا","إِذا ما مَشَت لَم تَمشِ إِلّا تَمَيُّلا",69,"ل",2,0],["أَسيرُ إِذا بُليتُ وَذابَ جِسمي","لَعَلَّ الريحَ تَسعى بي إِلَيهِ",70,"ه",1,0],["أُسيءُ ظُنوني بالثّناءِ وأنتَحي","لِذَمّ ثنائي وهو غيرُ مذمّم",71,"م",1,0],["أسيرُ خطيباً بآلائه","فأُنْضي المَطايا وأُنْضي الفَلا",72,"ا",1,0],["أَسيرُ الهَمِّ نائي الصَبرِ عانِ","تُحَدِّثُ عَن جَواهُ المُقلَتانِ",73,"ن",1,1],["أَسِيّانَ مَن لَم يَنَم لَيلَةً","لَدَيكِ وَمَن باتَها راقِدا",74,"د",2,0],["أَسيرٌ مُسلَمٌ بِدِماءِ قَومٍ","إِلى ذي غُلَّةٍ حَرّانَ صادي",75,"ي",1,0],["أَسيلَةُ مَجرى الدَمعِ مَهضومَةُ الحَشا","كَشَمسِ الضُحى حَلَّت بِبُرجٍ وَأَسعَدِ",76,"د",1,0],["أَسَيتُ عَلى الذَوائِبِ أَن عَلاها","نَهارِيُّ القَميصِ لَهُ اِرتِقاءُ",77,"ق",3,1],["أَسيتُ إِذا غابَتِ الأَحجالُ وَالغُرَرُ","وَإِنَّما الناسُ في أَيّامِهِم عُرَرُ",78,"ر",1,1],["أَسيرُ عَنِ الدُنَيا وَما أَنا ذاكِرٌ","لَها بِسَلامٍ إِنَّ أَحداثَها حُمسُ",79,"س",1,0],["أَسَيفُكَ سَيفٌ أَم حُسامُكَ مِشرَطٌ","وَرُمحُكَ رُمحٌ أَم قَناتُكَ مِغزَلُ",80,"ل",1,0],["أَسيرُ فَلا أَعودُ وَما رُجوعي","وَقَد كانَ الرَحيلُ رَحيلَ قالِ",81,"ل",1,0],["أَسيئي في فِعالٍ أَو كَلامٍ","فَقَد جَرَّبتِ صَبري وَاِحتِمالي",82,"ل",2,0],[