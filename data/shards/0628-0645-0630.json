{"poems":[[47,"يفندون وهم أدنى إلى الفند","https://www.aldiwan.net/poem63480.html","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67303","الكامل"],[580,"رقدت ولواحظ مسهري","https://www.aldiwan.net/poem2946.html","مجزوء الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49968","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46467","الرمل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87613","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74037","الكامل"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[5956,"حمداً لرب العالمين كثيرا","https://www.poetsgate.com/ViewPoem.aspx?id=206980",""]],"verses":[["بِمَذهَبٍ غَيرِ مَدخولٍ وَلا طَبِعٍ","وَنائِلٍ غَيرِ مَنزورٍ وَلا ثَمَدِ",0,"د",1,0],["بِمُذَرَّباتٍ بالأَكُفِّ نَوَاهلٍ","وبِكلِّ أبيضَ كالغَدِيرِ مُهنَّدِ",1,"د",1,1],["بمُذكرٍ كمؤنثٍ","ومؤنَّثٍ كمذكَّرِ",2,"ر",1,0],["بمذللاتِ اليعملات","المُرقلات مع الهواجرْ",3,"ر",1,0],["بِمَ ذا تُكثر مِن قو","لك لَستُم بكفاء",4,"ا",2,0],["بمذاكرات العلم احيآءٌ لَهُ","وَقيامُها يَستلزم الجمعيَّه",5,"ه",1,1],["بِمذرّب من حدّه ماضي الشبا","وَمصوّب من رأيه المستحصدِ",6,"د",1,0],["بمذهب من كلام الله ينسخ شر","ع الأولين ببشرى من كلامهم",7,"م",1,0],["بمذلتي له عزتي وكرامتي","بعبادتي له أنفع الجمهورا",8,"ر",2,0]]}