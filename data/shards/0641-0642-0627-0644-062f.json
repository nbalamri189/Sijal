{"poems":[[53,"لنا صديق مارد","https://www.aldiwan.net/poem65827.html","مجزوء الرجز"],[93,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[107,"يا ناقض العهد لا شكوى ولا أسف","https://www.aldiwan.net/poem43988.html","البسيط"],[107,"ترامى الجيش واندفع الرعيل","https://www.aldiwan.net/poem44191.html","الوافر"],[358,"بليت بأزرق العينين أحوى","https://www.aldiwan.net/poem39997.html","الوافر"],[471,"لو أنك شاهدت الصبا يا ابن بوزل","https://www.aldiwan.net/poem50389.html","الطويل"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107255","السريع"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139031",""],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121181","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74029","المتقارب"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20535","الطويل"],[3509,"","https://poetry.dctabudhabi.ae/diwan/poem/124131","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86340","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111452","البسيط"],[3955,"","https://poetry.dctabudhabi.ae/diwan/poem/198343","المجتث"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136699",""],[5136,"واعجبي قلبي اللجوج الطموح","https://www.poetsgate.com/ViewPoem.aspx?id=121541",""],[5213,"حتام أسأل من سفر ومن حضر","https://www.poetsgate.com/ViewPoem.aspx?id=170456",""],[6225,"معركة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80894&r=&rc=163",""]],"verses":[["فقال دعني إنني","خرقتُ تلك الشَّبكهْ",0,"ك",2,0],["فَقالَ دَحرِج رَأسَ هَذا الغُلام","فَرَأسُهُ عِبءٌ عَلى مَنكِبَيه",1,"ه",1,0],["فقال دُونكَ سعداً إن هممتَ بها","شَاوِرْهُ فيها فَنِعمَ الحاذقُ الثَّقِفُ",2,"ف",1,0],["فقال دِماؤُكم لا بُدَّ منها","وذلك حُكمُهُ فمتى القُبولُ",3,"ل",1,0],["فقال دعوا اللَّجاجَ فإنّ سعداً","بِنُصرةِ ربِّهِ الأعلى كَفيلُ",3,"ل",1,0],["فَقال دَليله قَد صحّ عِندي","بِأَنّك في مَحبّته قَتيلُ",4,"ل",1,0],["فَقالَ دَعوني سَجدَتَينِ وَأَرعَدَت","حَذارَ الرَدى أَحشاؤُهُ وَمَفاصِلُه",5,"ل",2,0],["فَقالَ دَع عَنكَ نُحاةَ الوَرى","وَقولَهُم لا تجرِ يَوماً علَيه",6,"ي",2,0],["فقال دعاني منيتي لكريه راح","ورشف الثغر منه عقيب سكر",7,"ر",1,1],["فقال دعيني عزم احمد سابق","كجلمود صخر حطه السيل من عل",8,"ل",1,0],["فَقالَ دلالاً أَما وَالَّذي","عَلى مهج الخلق وَلّانيَه",9,"ي",2,0],["فقال دواء الحب أن تلصق الحشا","بأحشاء من تهوىإذا كان خاليا",10,"ي",2,0],["فقال دع حب من تهوى وجد بنا","في حب من حسنه والله يزريها",11,"ي",3,0],["فَقالَ دلالهُ باسان حالٍ","أَلا صَبراً فَاِن الصَبرَ اولى",12,"ل",2,0],["فقالَ دُونَكِ أَفراسي وَمَركَبَتي","حَلَّت بِها بِفُؤَادٍ خارَ مُكتَئبِ",13,"ب",1,0],["فقال دعني فهذا","تعرّضٌ للفضول",14,"ل",1,0],["فقالَ دعه قلتُ دعني قال قد","شابَ فقلت القلبُ مني قد صبا",15,"ب",2,0],["فقال دعني إنما سامني","سفح دمى طرفك هذا السفوح",16,"ح",1,0],["فقال دع ذكر من تهوى فقد ذهبت","به المنون وابلته يد الغير",17,"ر",1,0],["فقال : دافعتُ عن نفسي إذ انفلتتْ","يداهُ ، قلتُ : يدٌ مجنونة ٌ بيَدِ",18,"د",1,0]]}