/poem5150.html","الطويل"],[28,"نابي الفراش طري اللحم مطعمه","https://www.aldiwan.net/poem5497.html","البسيط"],[61,"حلفت عنك يمينا غيرصادقة","https://www.aldiwan.net/poem51516.html","البسيط"],[2,"غشيت ديارا بالنقيع فثهمد","https://www.aldiwan.net/poem25047.html","الطويل"],[2,"عفا من آل فاطمة الجواء","https://www.aldiwan.net/poem25055.html","الوافر"],[58,"تغرب عن الأوطان في طلب العلى","https://www.aldiwan.net/poem31102.html","الطويل"],[66,"وعدتم وأعطيتم مدى المطل حقه","https://www.aldiwan.net/poem38735.html","الطويل"],[66,"عجبت لها تمسي العقول لها نهبا","https://www.aldiwan.net/poem39205.html","الطويل"],[66,"أدرها بلطف واجعل الرفق مذهبا","https://www.aldiwan.net/poem39207.html","الطويل"],[66,"كذا فليصبر الرجل النجيب","https://www.aldiwan.net/poem40117.html","الوافر"],[80,"كل يوم مودع أو مودع","https://www.aldiwan.net/poem31388.html","الخفيف"],[87,"ألا من معيني على صاحب","https://www.aldiwan.net/poem8261.html","المتقارب"],[74,"ألا ليت أنفاس الرياح النواسم","https://www.aldiwan.net/poem13258.html","الطويل"],[81,"ضمان على عينيك أني عان","https://www.aldiwan.net/poem61478.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[75,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[48,"يا رب غيث آمن السروب","https://www.aldiwan.net/poem62457.html","الرجز"],[48,"لنا هجمة لا يدرك الذئب سخلها","https://www.aldiwan.net/poem63273.html","الطويل"],[48,"إذا أنت لم يدع الهوى فتجيبه","https://www.aldiwan.net/poem63351.html","الطويل"],[48,"لم تدر جارتنا ولا تدري","https://www.aldiwan.net/poem63376.html","الكامل"],[48,"يا رب ساق كأنه شبه البدر","https://www.aldiwan.net/poem64402.html","المنسرح"],[48,"لقد جن من يبكي على رسم منزل","https://www.aldiwan.net/poem64510.html","الطويل"],[48,"لقد نام عما قد عناك أبو الفضل","https://www.aldiwan.net/poem65056.html","الطويل"],[50,"في الفتى الزنجي منه شبه","https://www.aldiwan.net/poem62316.html","البسيط"],[50,"يا لقوم للحبيب المذكر","https://www.aldiwan.net/poem63802.html","الرمل"],[50,"تنح لحاك الله لست من العدد","https://www.aldiwan.net/poem63887.html","الطويل"],[50,"يا خليلا نبا بنا في المشيب","https://www.aldiwan.net/poem64853.html","الخفيف"],[50,"يا دار بين الفرع والجناب","https://www.aldiwan.net/poem64871.html","الرجز"],[46,"إذا كف صل أفعوان فما له","https://www.aldiwan.net/poem22114.html","الطويل"],[46,"إذا شئت أن يرضى سجاياك ربها","https://www.aldiwan.net/poem22116.html","الطويل"],[46,"دعوا وما فيهم زاك ولا أحد","https://www.aldiwan.net/poem22291.html","البسيط"],[46,"لقد مات جني الصبا منذ برهة","https://www.aldiwan.net/poem22450.html","الطويل"],[46,"أعاذل إن ظلمتنا الملوك","https://www.aldiwan.net/poem23330.html","المتقارب"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[46,"لقد آن أن يثني الجموح لجام","https://www.aldiwan.net/poem23643.html","الطويل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39629","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72210","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42672","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42589","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42673","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54724","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55161","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67357","المتقارب"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116999","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[36,"جَزَى اللُه خَيْراً وَالجزاءُ بكفِه","https://www.poetsgate.com/ViewPoem.aspx?id=15877",""],[106,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[45,"لأوْشَكَ شعَبُ الحَيّ أنْ يَتَفَرّقا","https://www.poetsgate.com/ViewPoem.aspx?id=32847",""],[28,"ألا كيف البقاء لباهلي","https://www.poetsgate.com/ViewPoem.aspx?id=21966",""],[51,"أقاسمُ لا تسددْ سبيلي إلى الرضا","https://www.poetsgate.com/ViewPoem.aspx?id=30328",""],[51,"نَذيري من عسى ولعلَّ نسي","https://www.poetsgate.com/ViewPoem.aspx?id=30774",""],[51,"لعمري لقد سهَّلْتَ ما ليس بالسهل","https://www.poetsgate.com/ViewPoem.aspx?id=30292",""]],"verses":[["فَإِن قَعَدَت بي السِنُّ يَوماً فَإِنَّهُ","سَيَنهَضُ بي مَجدي إِلَيها مُحَقَّقا",0,"ق",2,0],["فَإِنَّ قَناتي يَتَّقِي دَرْءَها العِدا","وَما كانَ قَومي يَتَّقونَ الأَعاديا",1,"ي",2,0],["فَإِن قالَ أَهلي ما الَّذي جِئتُمُ بِهِ","وَقَد يُحسِنُ التَعليلَ كُلُّ أَريبِ",2,"ب",1,0],["فإنْ قيلَ مالٌ مالُكَ الدّهْر وافِرٌ","وإنْ قيلَ جيْشٌ عنْدَكَ العسْكَرُ المَجْرُ",3,"ر",1,0],["فَاِنقَع أُواري بِها صَهباءَ صافِيَةً","صِرفاً لَها قَبسٌ مِن دَنِّها وارِ",4,"ر",1,0],["فَإِنَّ قُصارَكَ الدِهلي","زُ حينَ سِواكَ في المَضجَع",5,"ع",1,0],["فَإِنَّ قَناتَنا يا عَمرُو أَعيَت","عَلى الأَعداءِ قَبلَكَ أَن تَلينا",6,"ن",2,0],["فَإِنَّ قَلْبِي فِي الغِيَ","ابِ أَبَداً يُحْضِرُهْ",7,"ر",2,0],["فَإِن قُلتُم رَسولُ اللَهِ مِنّا","فَإِنَّ مُحَمَّداً لِلمُسلِمينا",8,"ن",2,0],["فَإِن قَبِلَ اللَهُ قُربانَها","فَسُبحانَ رَبِّكَ ما أَعدَلا",9,"ل",2,0],["فَإِن قَرَّبَ الرَحمَنُ مِن تِلكَ مُدَّتي","وَأَخَّرَ مِن عُمري لِيَومِ وَفاتي",10,"ت",2,0],["فأنقطعت في العيش أسبابها","وأصبحت للبُؤس مستسلمه",11,"م",2,0],["فَإِنَّ قُرَيشَ الحَقَّ لَن تَتبَعَ الهَوى","وَلَن يَقبَلوا في اللَهِ لَومَةَ لائِمِ",12,"م",1,0],["فَإِنَّ قُرَيشاً سَتَنفيكُمُ","إِلى نَسَبٍ غَيرُهُ أَثقَبُ",13,"ب",1,0],["فإن قصرَتْ منه صحيفةُ مدْحتي","فما قصرَتْ والله صحفُ ثوابي",14,"ي",1,0],["فإن قُلْتَ لي قد يُركَبُ اليمُّ طامياً","ودجلةُ عند اليمِّ بعضُ المَذانبِ",15,"ب",1,0],["فإن قلتَ مكروهٌ ألمت فُجاءةً","فما فوجئت نفسٌ مع الخطراتِ",16,"ت",1,0],["فإن قلت سَمْجٌ ما أتيتَ فصادقٌ","وبخسُك حقّي كان من قبلُ أسمجا",17,"ج",2,0],["فإن قَصْرك أن تلقى بعَقْوته","بحراً من العُرف لا كَدْراً ولا نزحا",18,"ح",2,0],["فإن قالها في نابهٍ حُمِلَتْ له","وإن قالها في خاملٍ فهي رُزَّحُ",19,"ح",1,0],["فإنْ قَدَحْتَ النارَ من فِكْرِهِ","في ليلِ خَطْبٍ أثْقَبَ القَدْحُ",20,"ح",1,0],["فانقدْ لخيرك لا لشرك واتبِعْ","أولاهما بالقادرِ الغفّارِ",21,"ر",1,0],["فإن قَضى اللَهُ للحوافِظ رز","قاً قَضَاهُ للسُّلُس",22,"س",1,0],["فإن قدمت خوفاً جرَّ أمناً","وإن قدمت أمناً جر خوفا",23,"ف",2,0],["فانقضى ذلك التشا","جي وزال التصلُّف",24,"ف",1,0],["فإن قلْتَ قصّر فيما علَي","هِ فهْو المُقَصِّرُ وهو المُخِلُّ",25,"ل",1,0],["فانقدْتَ طوعَ الحزمِ لا مستقتلاً","خَرِقاً ولا سلسَ القيادِ ذليلا",26,"ل",2,0],["فإن قلتُم للحكم بالحق فضلُه","فما للديغِ النحلِ من عسل النحلِ",27,"ل",1,0],["فإن قلت قد صحَّ الذي أنت جاحدٌ","فهبْ ذنبَ جانٍ لاعتذارِ ذليلِ",28,"ل",1,0],["فإنْ قلتَ لي دَعْ وَصْلَ من أنت واصلٌ","صدَدْتُ بطَرْفِ العينِ والقلبُ دائمُ",29,"م",1,0],["فأنقعَ مِنْ قُربهِ غُلَّةً","بقلبيَ من حُبِّهِ الأقدم",30,"م",1,0],["فإن قُلْتُم نراكَ أخا سفاهٍ","فقد يقعُ السفيهُ على السفيه",31,"ي",2,0],["فَأَنقَذَهُنَّ الضَربُ وَالطَعنُ بِالقَنا","وَأَيدٍ بِأَبطالِ الكَتيبَةِ تَجرَحُ",32,"ح",1,0],["فَاِنقَطَعنا عَنِ الكَلامِ وَبِتنا","كُلُّ نَفسٍ لِذاتِها نَجواها",33,"ا",3,0],["فَأَنقَذَ عَيناً في الدُموعِ غَريقَةً","وَخَلَّصَ قَلباً بِالجَفاءِ مُعَذَّبا",34,"ب",2,0],["فإنْ قَضَى اليومُ وما قَبْلَهُ","ففي الغدِ الحيِّ صَبَاحُ الحَياهْ",35,"ا",2,0],["فإنَّ قلبيَ قبرٌ مُظلمٌ قُبِرَتْ","فيهِ الأَماني فما عادتْ تناغيني",36,"ي",1,0],["فَأَنقذَ المُدنَ وَخَلَّص القرى","وَطَهَّرَ الأَرضَ مِن الَّذي طَغى",37,"ا",1,0],["فَإِنَّ قَومِيَ قالوا","وَجهُ الغُرابِ مَشومُ",38,"م",1,0],["فَإِن قُرِنَت مَكارِمُها بِعِلمٍ","تَذَلَّلَتِ العُلا بِهِما صِعابا",39,"ب",2,0],["فَإِنَّ قَليلَ الحُبِّ بِالعَقلِ صالِحٌ","وَإِنَّ كَثيرَ الحُبِّ بِالجَهلِ فاسِدُ",40,"د",1,0],["فإن قُلتما والحقُّ ما تَريانهِ","تداوَ بصبرٍ فاذهبا ودَعاني",41,"ي",1,0],["فَإِن قُلتَ بي كِبرٌ فَمِثلِ الَّذي أَرى","عَلى الناسِ مِن نُعماكَ يَملَأُني كِبرا",42,"ر",2,0],["فَإِن قَصَّرَت تِلكَ الوُلاةُ فَقَد رَمى","إِلى المَجدِ والي سُؤدَدٍ لَم يُقَصِّرِ",43,"ر",1,0],["فَإِن قُلتَ نَذرٌ أَو يَمينٌ تَقَدَّمَت","فَأَيُّ جَوادٍ حَلَّ في مالِهِ نَذرُ",44,"ر",1,0],["فَإِن قالَ بِالإِكثارِ قالَ مُقَلِّلاً","وَإِن قالَ بِالإِفراطِ قالَ مُصَدِّقا",45,"ق",2,0],["فَإِن قُلتَ هَذي سُنَّةٌ كُنتَ حاتِماً","وَإِن قُلتَ فَرضٌ لازِمٌ كُنتَ مَصدَقا",45,"ق",2,0],["فَإِن قَصَّرَت أَكفاؤُهُ عَن مَحَلِّهِ","فَإِنَّ يَمينَ المَرءِ فَوقَ شِمالِهِ",46,"ل",2,0],["فَاِنقَضَّ مِثلَ عَتيقِ الطَيرِ تَتبَعُهُ","مَساعِرُ الحَربِ مِن مُردٍ وَمِن شَيبِ",47,"ب",1,0],["فَأَنقَذَني مِنها وَقَد خِفتُ أَن أَرى","رَهينَةَ أَمرٍ ما تُرامُ تَراتِرُه",48,"ر",2,0],["فَاِنقَعَرَت في سَوادِ اللَيلِ يَغصِبُها","بِوابِلٍ مِن عَمودِ الشَدِّ مَشهومِ",49,"م",1,0],["فإنْ قرَفْتُ يميناً بعدَها أبداً","فلا وُقِيتُ صُروفَ الدَّهْرِ والغَرَقَا",50,"ق",2,0],["فَأَنقَذَها مِن غَمرَةِ المَوتِ أَنَّها","رَأَت أَنَّها إِن تَنظُرِ النَبلَ تُقصَدِ",51,"د",1,0],["فَإِن قالوا النِساءُ مُخَبَّآتٍ","فَحُقَّ لِكُلِّ مُحصَنَةٍ هِداءُ",52,"ا",2,0],["فَإِن قيلَ في الأَسفارِ ذُلٌّ وَمِحنَةٌ","وَقَطعُ الفَيافي وَاِرتِكابِ الشَدائِدِ",53,"د",1,0],["فَإِن قُلتُمُ إِنّا ظَلَمنا فَلَم نَكُن","ظَلَمنا وَلَكِنّا أَسَأنا التَقاضِيا",54,"ي",2,0],["فَإِنَّ قَتيلَ الراحِ يوشِكُ بَعثُهُ","إِذا أَنتَ أَترَعتَ الكُؤوسَ لَهُ سَكبا",55,"ب",2,0],["فَإِنَّ قَليلَ الراحِ لِلروحِ راحَةٌ","فَإِن زادَ مِقداراً عَنِ العَدلِ أَتعَبا",56,"ب",2,0],["فَإِنَّ قَريبَ ما تَخشى بَعيدٌ","وَإِنَّ بَعيدَ ما تَرجو قَريبُ",57,"ب",1,0],["فانقطاعُ الوصال كم يتمادى","وحصاةُ الفؤادِ كم تَتَصَدّع",58,"ع",1,0],["فَإِنْ قُلْتُ مَهْلاً لَوَى شِدْقَهُ","وَإِنْ لَمْ أُجِبْ قَوْلَهُ بَرْطَمَا",59,"م",2,0],["فَإِن قَذَفَت يَوماً إِلَيكَ بِهِ النَوى","وَأَدَّتكَ أَيدي الناجِياتِ الرَواسِمِ",60,"م",1,0],["فَإِن قالَ شَخصٌ أَينَ أَعشَقُ عاشِقٍ","تَخَيَّلتُهُ دونَ الأَنامِ عَناني",61,"ي",1,0],["فانْقَضَتْ آيُ الَانبياءُ وَآيا","تُكَ في الناس ما لَهُنَّ انْقضاءُ",62,"ا",2,0],["فانْقُلْ ولوْ قَدَماً عَلَى آثارِهِ","فإذَا فَعَلْتَ فَذاكَ آخَذُ بالْيَدِ",63,"د",1,0],["فإنَّ قَطائِعَ العُرْبانِ صَارَتْ","لِعُمَّالِ لها ومُشَارِفِينا",64,"ن",2,0],["فأنْقَذَهَا من بُرْثُنِ الدّهرِ بعدما","تَواكَلَها القِرْسُ المُنَيَّب والهصرُ",65,"ر",1,0],["فَانقَضَّ مِثلَ الحَجَرِ المَندوبِ","مُنكَفِتاً تَكَفُّتَ الحَنيبِ",66,"ب",1,0],["فَإِن قامَ فيها الحالِبونَ اتَّقَتهُمُ","بِنَجلاءِ ثُقبِ الجَوفِ دِرَّتُها الخَمرُ",67,"ر",1,0],["فَإِن قُلتَ في الحُبِّ الشَقاوَةُ وَالبَلا","وَفيهِ مُقاساةُ المَكارِهِ وَالعِبَر",68,"ر",1,0],["فَاِنقَع بِسَيبِكَ غُلَّةً نَزَحَت","بي عَن بِلادي وَاِرتَهِن شُكري",69,"ر",2,0],["فَاِنقادَ حَتّى رَأَيتُ أَنَّ فَمي","أَدنى لِأُذنَيهِ مِن عُرى شَنَفِه",70,"ف",2,0],["فَإِن قيلَ ما يُبكيكَ قالَ حَمامَةٌ","تَنوحُ عَلى فَرخٍ بِأَصواتِ مُعوِلِ",71,"ل",1,0],["فَإِن قُلتَ قَد قَصَّرتَ فيها وَلَيسَ مَن","بَغى حاجَةً إِلّا كَما قالَ ذو الفَضلِ",72,"ل",1,0],["فَاِنقَضى ذاكَ وَكانَت شِرَّتي","مِثلَ ما كانَ ذُبالٌ فَاِحتَرَق",73,"ق",1,0],["فَاِنقَضى ذاكَ حَميداً عَهدُهُ","وَحَسَرتُ اللَهوَ عَنّي فَاِنحَسَر",74,"ر",1,0],["فَإِن قُلتَ إِنّي ماجِدٌ وَاِبنُ ماجِدٍ","فَقَد قالَ خِنزيرُ السَوادِ أَنا الأَسَد",75,"د",1,0],["فَاِنقَضى ذَلِكَ الزَمانُ وَأَبقى","زَمَناً راعَنا بِأَمرٍ عَجيبِ",76,"ب",1,0],["فَاِنقَلَبَت وَالدَهرُ ذو اِنقِلابِ","ما أَقرَبَ العامِرَ مِن خَرابِ",77,"ب",1,0],["فَإِنَّ قَبيحاً بِالمُسَوَّدِ ضِجعَةٌ","عَلى فَرشِهِ يَشكو إِلى النَفَرِ الكَربا",78,"ب",2,0],["فَإِنَّ قُرونَ الخَيلِ أَولَتكَ ناطِحاً","وَإِنَّ الحُسامَ العَضبَ لَقّاكَ أَعضَبا",79,"ب",2,0],["فَإِن قَدَرتَ فَلا تَفعَل سِوى حَسَنٍ","بينَ الأَنامِ وَجانِب كُلَّ ما قُبِحا",80,"ح",2,0],["فَإِنَ قتَيرَ الشَيبِ لَم يَحمِ جانِباً","فَكانَ بِعَكسٍ مِن قَتيرٍ سَرودِ",81,"د",1,0],["فَإِن قُلتَ ثانيهِ لاوَقفَ في","هِ قُلنا وَثالِثُهُ أَصلَمُ",82,"م",1,0],["فأنْقَذْتَ منها مَعقِلاً هَضَبَاتُه","تَلَفّعُ من نسْجِ السّحابِ وترْتَدي",83,"د",2,0],["فإنْ قَعَدَتْ عنه الحوادثُ حِقْبةً","فها هيَ فيما لا تشاء قِيامُ",84,"م",1,0],["فانقضَّتِ العقبانُ والسَّلالقهْ","زَعْقاً على مُقدَّم الجلالِقهْ",85,"ه",1,0],["فإنْ قال ضَيَّعتِهِ أسرعتْ","إلى النار تُوقِظُ فيها الضرامْ",86,"م",1,0],["فإِن قيل هذا مجلسُ الأمنِ فاسألوا","علام تضجُّ الأرض بالشّنآنِ",87,"ن",1,0],["فأنْقَذْتَهُ والمَوْت يَحْرقُ نابَهُ","عَلَيْهِ ولَمْ يُطْعَنْ ولَمْ يُتَنَسَّفِ",88,"ف",1,0],["فانقلب الحق بهذا فَرْددا","وعاد هذا بالهدى مسدّدا",89,"د",2,0],["فَإِنَّ قُلُوبَ النَّاسِ تَمْتَازُ فِطْرَةً","فَمِنْهَا لِبَعْضٍ آلِفٌ وَنَقِيضُ",90,"ض",1,0],["فَإِنْ قَالَ حَقَّاً كَذَّبُوهُ وَإِنْ أَبى","مُجَارَاتَهُمْ في الْغَيِّ قَالُوا مُعَانِدُ",91,"د",1,0],["فَإِنَّ قَرِينَ السُّوءِ مَا لَمْ تُجَازِهِ","بِأَفْعَالِهِ وَافَاكَ بِالْعُذْرِ يَرْكُضُ",92,"ض",1,0],["فَإِنْ قَلبَ المَحْزُون فِي الأُفْقِ طَرْفَهُ","فَلَيْسَ يَرَى إِلاَّ ذَكَاءَكَ فَرْقَدَا",93,"د",2,0],["فَإِنْ قَرِنَتْ شَجَاعَتُهُمْ بِقَصْدٍ","وَتَثْقِيفٍ فَقَدْ ضمِنَ المَآلُ",94,"ل",1,0],["فأنْقَذَنا اللهُ في نُورِهِ","وَنَجَّى بِرَحْمَتِهِ مِنْ لَظَى",95,"ا",1,0],["فإن قلتَ أحياءٌ فلست بكاذبٍ","وإن قلتَ أمواتٌ فلستَ مُفَنّدا",96,"د",2,0],["فَإِن قُلتُ عُرفاً أَنكَروهُ بِمُنكَرٍ","وَغَطَّوا عَلى التَحقيقِ بِالشُبُهاتِ",97,"ت",1,0],["فأنقذتَه والموْتُ يَحرقُ نابَهُ","عليه ولم يطعن ولم يتسيفِ",98,"ف",1,0],["فانقُدْ علومَك كالدراهم، إنني","ألفْيتُ منها خالصًا ومُزَوَّرا",99,"ر",2,0],["فإنْ قَالَ بالإكْثَارِ، قالَ مُقَلِّلاً،","ولَوْ قَالَ بالإفْرَاطِ، قالَ مُصَدَّقَا",100,"ق",2,0],["فإنْ قُلْتَ هَذي سُنّةٌ كُنْتَ حاتماً،","وإنْ قُلتَ فَرْضاً لازِمٌ كنتَ مَصْدَقَا",100,"ق",2,0],["فَإن قَدْ ضَمنْتُ على المَنَايَا","نَوَائِبَ كُلِّ ذي حَدَثٍ عَظِيمِ",101,"م",1,0],["فإن قلت قد صحَّ الذي أتت جاحدٌ","فهبْ ذنبَ جانٍ لاعتذارٍ ذليل",102,"ل",1,0],["فإن قدّمت خوفاً جرَّ مناً","وإن قدمتَ أمناً جرَّ خوفا",103,"ف",2,0],["فإن قلتُم للحكم بالحق فضلُه","فما للدبغِ النحلِ من عسلِ النحلِ",104,"ل",1,0]]}