w.aldiwan.net/poem12378.html","الطويل"],[433,"أقول رياض إذ ترصعها زهرا","https://www.aldiwan.net/poem12435.html","الطويل"],[433,"أبا بكر العبدي عاداك ذو الفتك","https://www.aldiwan.net/poem12452.html","الطويل"],[433,"لا تثن جيدك إن الروض قد جيدا","https://www.aldiwan.net/poem12586.html","البسيط"],[440,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[442,"وداعا وحسبي الله يا عرفات","https://www.aldiwan.net/poem14298.html","الطويل"],[444,"لله ما أسعدني سيدتي","https://www.aldiwan.net/poem55922.html","عموديه"],[444,"في بعلبك جنة الخوام","https://www.aldiwan.net/poem55930.html","عموديه"],[459,"يقولون يوم البين عينك تدمع","https://www.aldiwan.net/poem56134.html","الطويل"],[459,"أصبت لو أحمدت أن أصيبا","https://www.aldiwan.net/poem56297.html","الرجز"],[462,"اذا افتخرت عليا ربيعة بالذي","https://www.aldiwan.net/poem15413.html","الطويل"],[465,"يا من تلون عهده وتغيرا","https://www.aldiwan.net/poem3198.html","عموديه"],[469,"إذا ما كان في بيتي رغيف","https://www.aldiwan.net/poem59931.html","الوافر"],[469,"يا من أرى نصحه فرضا لعزته","https://www.aldiwan.net/poem60147.html","البسيط"],[469,"من باع هما بلذة ربحا","https://www.aldiwan.net/poem60296.html","المنسرح"],[483,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[483,"فنحن شراب مذ حللن بقيعة","https://www.aldiwan.net/poem24491.html","عموديه"],[501,"بين طي الحبيب والنشر معنى","https://www.aldiwan.net/poem37750.html","الخفيف"],[501,"أصاحب بيتي كل ما قام في الورى","https://www.aldiwan.net/poem37812.html","الطويل"],[501,"هنيئا لعبد طيب الحب قلبه","https://www.aldiwan.net/poem37822.html","الطويل"],[506,"الوصيّة","https://www.aldiwan.net/poem27795.html","الطويل"],[506,"النسيان","https://www.aldiwan.net/poem42457.html","السريع"],[530,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[530,"نظام من الدر الثمين فرائده","https://www.aldiwan.net/poem37466.html","الطويل"],[530,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[537,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[541,"هيهات أوتي في سراتهم","https://www.aldiwan.net/poem56647.html","البسيط"],[552,"متى يبدي الكثيب لنا غزاله","https://www.aldiwan.net/poem47314.html","الوافر"],[552,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[554,"دعوت أمير المؤمنين ولم تكن","https://www.aldiwan.net/poem68253.html","الطويل"],[559,"قلت للعارف النبيل النبيه","https://www.aldiwan.net/poem33631.html","الخفيف"],[559,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[559,"انهض بربك لا بنفسك","https://www.aldiwan.net/poem34286.html","مجزوء الكامل"],[559,"يا أيها البارق الذي برقا","https://www.aldiwan.net/poem34294.html","المنسرح"],[559,"ومن أعجب الأمر هذا الخفا","https://www.aldiwan.net/poem34360.html","المتقارب"],[559,"نحن عن شمس أمره كالشعاع","https://www.aldiwan.net/poem34395.html","الخفيف"],[559,"شمعتي أشرقت بنورك ربي","https://www.aldiwan.net/poem34431.html","الخفيف"],[559,"ما هذه عندنا الأجسام والصور","https://www.aldiwan.net/poem34482.html","البسيط"],[559,"دللناك يا من أنت ذمي ديننا","https://www.aldiwan.net/poem34710.html","الطويل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[571,"أسير الى بني بدر بأمر","https://www.aldiwan.net/poem59466.html","الطويل"],[576,"أيدفعني الدهر عن مطلبي","https://www.aldiwan.net/poem2750.html","المتقارب"],[576,"بحقك حدث عن هواي ولا حرج","https://www.aldiwan.net/poem2976.html","الطويل"],[576,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"],[588,"لك الحمد اللهم يا ذا الحامد","https://www.aldiwan.net/poem11497.html","عموديه"]],"verses":[["فَإِن قَعَدَت بي السِنُّ يَوماً فَإِنَّهُ","سَيَنهَضُ بي مَجدي إِلَيها مُحَقَّقا",0,"ق",2,0],["فَإِنَّ قَناتي يَتَّقِي دَرْءَها العِدا","وَما كانَ قَومي يَتَّقونَ الأَعاديا",1,"ي",2,0],["فَإِن قالَ أَهلي ما الَّذي جِئتُمُ بِهِ","وَقَد يُحسِنُ التَعليلَ كُلُّ أَريبِ",2,"ب",1,0],["فإنْ قيلَ مالٌ مالُكَ الدّهْر وافِرٌ","وإنْ قيلَ جيْشٌ عنْدَكَ العسْكَرُ المَجْرُ",3,"ر",1,0],["فَاِنقَع أُواري بِها صَهباءَ صافِيَةً","صِرفاً لَها قَبسٌ مِن دَنِّها وارِ",4,"ر",1,0],["فَإِنَّ قُصارَكَ الدِهلي","زُ حينَ سِواكَ في المَضجَع",5,"ع",1,0],["فَإِنَّ قَناتَنا يا عَمرُو أَعيَت","عَلى الأَعداءِ قَبلَكَ أَن تَلينا",6,"ن",2,0],["فَإِنَّ قَلْبِي فِي الغِيَ","ابِ أَبَداً يُحْضِرُهْ",7,"ر",2,0],["فَإِن قُلتُم رَسولُ اللَهِ مِنّا","فَإِنَّ مُحَمَّداً لِلمُسلِمينا",8,"ن",2,0],["فَإِن قَبِلَ اللَهُ قُربانَها","فَسُبحانَ رَبِّكَ ما أَعدَلا",9,"ل",2,0],["فَإِن قَرَّبَ الرَحمَنُ مِن تِلكَ مُدَّتي","وَأَخَّرَ مِن عُمري لِيَومِ وَفاتي",10,"ت",2,0],["فأنقطعت في العيش أسبابها","وأصبحت للبُؤس مستسلمه",11,"م",2,0],["فَإِنَّ قُرَيشَ الحَقَّ لَن تَتبَعَ الهَوى","وَلَن يَقبَلوا في اللَهِ لَومَةَ لائِمِ",12,"م",1,0],["فَإِنَّ قُرَيشاً سَتَنفيكُمُ","إِلى نَسَبٍ غَيرُهُ أَثقَبُ",13,"ب",1,0],["فإن قصرَتْ منه صحيفةُ مدْحتي","فما قصرَتْ والله صحفُ ثوابي",14,"ب",2,0],["فإن قُلْتَ لي قد يُركَبُ اليمُّ طامياً","ودجلةُ عند اليمِّ بعضُ المَذانبِ",15,"ب",1,0],["فإن قلتَ مكروهٌ ألمت فُجاءةً","فما فوجئت نفسٌ مع الخطراتِ",16,"ت",1,0],["فإن قلت سَمْجٌ ما أتيتَ فصادقٌ","وبخسُك حقّي كان من قبلُ أسمجا",17,"ج",2,0],["فإن قَصْرك أن تلقى بعَقْوته","بحراً من العُرف لا كَدْراً ولا نزحا",18,"ح",2,0],["فإن قالها في نابهٍ حُمِلَتْ له","وإن قالها في خاملٍ فهي رُزَّحُ",19,"ح",1,0],["فإنْ قَدَحْتَ النارَ من فِكْرِهِ","في ليلِ خَطْبٍ أثْقَبَ القَدْحُ",20,"ح",1,0],["فانقدْ لخيرك لا لشرك واتبِعْ","أولاهما بالقادرِ الغفّارِ",21,"ر",1,0],["فإن قَضى اللَهُ للحوافِظ رز","قاً قَضَاهُ للسُّلُس",22,"س",1,0],["فإن قدمت خوفاً جرَّ أمناً","وإن قدمت أمناً جر خوفا",23,"ف",2,0],["فانقضى ذلك التشا","جي وزال التصلُّف",24,"ف",1,0],["فإن قلْتَ قصّر فيما علَي","هِ فهْو المُقَصِّرُ وهو المُخِلُّ",25,"ل",1,0],["فانقدْتَ طوعَ الحزمِ لا مستقتلاً","خَرِقاً ولا سلسَ القيادِ ذليلا",26,"ل",2,0],["فإن قلتُم للحكم بالحق فضلُه","فما للديغِ النحلِ من عسل النحلِ",27,"ل",1,0],["فإن قلت قد صحَّ الذي أنت جاحدٌ","فهبْ ذنبَ جانٍ لاعتذارِ ذليلِ",28,"ل",1,0],["فإنْ قلتَ لي دَعْ وَصْلَ من أنت واصلٌ","صدَدْتُ بطَرْفِ العينِ والقلبُ دائمُ",29,"م",1,0],["فأنقعَ مِنْ قُربهِ غُلَّةً","بقلبيَ من حُبِّهِ الأقدم",30,"م",1,0],["فإن قُلْتُم نراكَ أخا سفاهٍ","فقد يقعُ السفيهُ على السفيه",31,"ي",2,0],["فَأَنقَذَهُنَّ الضَربُ وَالطَعنُ بِالقَنا","وَأَيدٍ بِأَبطالِ الكَتيبَةِ تَجرَحُ",32,"ح",1,0],["فَاِنقَطَعنا عَنِ الكَلامِ وَبِتنا","كُلُّ نَفسٍ لِذاتِها نَجواها",33,"ا",3,0],["فَأَنقَذَ عَيناً في الدُموعِ غَريقَةً","وَخَلَّصَ قَلباً بِالجَفاءِ مُعَذَّبا",34,"ب",2,0],["فإنْ قَضَى اليومُ وما قَبْلَهُ","ففي الغدِ الحيِّ صَبَاحُ الحَياهْ",35,"ا",2,0],["فإنَّ قلبيَ قبرٌ مُظلمٌ قُبِرَتْ","فيهِ الأَماني فما عادتْ تناغيني",36,"ن",2,0],["فَأَنقذَ المُدنَ وَخَلَّص القرى","وَطَهَّرَ الأَرضَ مِن الَّذي طَغى",37,"ا",1,0],["فَإِنَّ قَومِيَ قالوا","وَجهُ الغُرابِ مَشومُ",38,"م",1,0],["فَإِن قُرِنَت مَكارِمُها بِعِلمٍ","تَذَلَّلَتِ العُلا بِهِما صِعابا",39,"ب",2,0],["فَإِنَّ قَليلَ الحُبِّ بِالعَقلِ صالِحٌ","وَإِنَّ كَثيرَ الحُبِّ بِالجَهلِ فاسِدُ",40,"د",1,0],["فإن قُلتما والحقُّ ما تَريانهِ","تداوَ بصبرٍ فاذهبا ودَعاني",41,"ن",2,0],["فَإِن قُلتَ بي كِبرٌ فَمِثلِ الَّذي أَرى","عَلى الناسِ مِن نُعماكَ يَملَأُني كِبرا",42,"ر",2,0],["فَإِن قَصَّرَت تِلكَ الوُلاةُ فَقَد رَمى","إِلى المَجدِ والي سُؤدَدٍ لَم يُقَصِّرِ",43,"ر",1,0],["فَإِن قُلتَ نَذرٌ أَو يَمينٌ تَقَدَّمَت","فَأَيُّ جَوادٍ حَلَّ في مالِهِ نَذرُ",44,"ر",1,0],["فَإِن قالَ بِالإِكثارِ قالَ مُقَلِّلاً","وَإِن قالَ بِالإِفراطِ قالَ مُصَدِّقا",45,"ق",2,0],["فَإِن قُلتَ هَذي سُنَّةٌ كُنتَ حاتِماً","وَإِن قُلتَ فَرضٌ لازِمٌ كُنتَ مَصدَقا",45,"ق",2,0],["فَإِن قَصَّرَت أَكفاؤُهُ عَن مَحَلِّهِ","فَإِنَّ يَمينَ المَرءِ فَوقَ شِمالِهِ",46,"ل",2,0],["فَاِنقَضَّ مِثلَ عَتيقِ الطَيرِ تَتبَعُهُ","مَساعِرُ الحَربِ مِن مُردٍ وَمِن شَيبِ",47,"ب",1,0],["فَأَنقَذَني مِنها وَقَد خِفتُ أَن أَرى","رَهينَةَ أَمرٍ ما تُرامُ تَراتِرُه",48,"ر",2,0],["فَاِنقَعَرَت في سَوادِ اللَيلِ يَغصِبُها","بِوابِلٍ مِن عَمودِ الشَدِّ مَشهومِ",49,"م",1,0],["فإنْ قرَفْتُ يميناً بعدَها أبداً","فلا وُقِيتُ صُروفَ الدَّهْرِ والغَرَقَا",50,"ق",2,0],["فَأَنقَذَها مِن غَمرَةِ المَوتِ أَنَّها","رَأَت أَنَّها إِن تَنظُرِ النَبلَ تُقصَدِ",51,"د",1,0],["فَإِن قالوا النِساءُ مُخَبَّآتٍ","فَحُقَّ لِكُلِّ مُحصَنَةٍ هِداءُ",52,"ا",2,0],["فَإِن قيلَ في الأَسفارِ ذُلٌّ وَمِحنَةٌ","وَقَطعُ الفَيافي وَاِرتِكابِ الشَدائِدِ",53,"د",1,0],["فَإِن قُلتُمُ إِنّا ظَلَمنا فَلَم نَكُن","ظَلَمنا وَلَكِنّا أَسَأنا التَقاضِيا",54,"ي",2,0],["فَإِنَّ قَتيلَ الراحِ يوشِكُ بَعثُهُ","إِذا أَنتَ أَترَعتَ الكُؤوسَ لَهُ سَكبا",55,"ب",2,0],["فَإِنَّ قَليلَ الراحِ لِلروحِ راحَةٌ","فَإِن زادَ مِقداراً عَنِ العَدلِ أَتعَبا",56,"ب",2,0],["فَإِنَّ قَريبَ ما تَخشى بَعيدٌ","وَإِنَّ بَعيدَ ما تَرجو قَريبُ",57,"ب",1,0],["فانقطاعُ الوصال كم يتمادى","وحصاةُ الفؤادِ كم تَتَصَدّع",58,"ع",1,0],["فَإِنْ قُلْتُ مَهْلاً لَوَى شِدْقَهُ","وَإِنْ لَمْ أُجِبْ قَوْلَهُ بَرْطَمَا",59,"م",2,0],["فَإِن قَذَفَت يَوماً إِلَيكَ بِهِ النَوى","وَأَدَّتكَ أَيدي الناجِياتِ الرَواسِمِ",60,"م",1,0],["فَإِن قالَ شَخصٌ أَينَ أَعشَقُ عاشِقٍ","تَخَيَّلتُهُ دونَ الأَنامِ عَناني",61,"ن",2,0],["فانْقَضَتْ آيُ الَانبياءُ وَآيا","تُكَ في الناس ما لَهُنَّ انْقضاءُ",62,"ا",2,0],["فانْقُلْ ولوْ قَدَماً عَلَى آثارِهِ","فإذَا فَعَلْتَ فَذاكَ آخَذُ بالْيَدِ",63,"د",1,0],["فإنَّ قَطائِعَ العُرْبانِ صَارَتْ","لِعُمَّالِ لها ومُشَارِفِينا",64,"ن",2,0],["فأنْقَذَهَا من بُرْثُنِ الدّهرِ بعدما","تَواكَلَها القِرْسُ المُنَيَّب والهصرُ",65,"ر",1,0],["فَانقَضَّ مِثلَ الحَجَرِ المَندوبِ","مُنكَفِتاً تَكَفُّتَ الحَنيبِ",66,"ب",1,0],["فَإِن قامَ فيها الحالِبونَ اتَّقَتهُمُ","بِنَجلاءِ ثُقبِ الجَوفِ دِرَّتُها الخَمرُ",67,"ر",1,0],["فَإِن قُلتَ في الحُبِّ الشَقاوَةُ وَالبَلا","وَفيهِ مُقاساةُ المَكارِهِ وَالعِبَر",68,"ر",1,0],["فَاِنقَع بِسَيبِكَ غُلَّةً نَزَحَت","بي عَن بِلادي وَاِرتَهِن شُكري",69,"ر",2,0],["فَاِنقادَ حَتّى رَأَيتُ أَنَّ فَمي","أَدنى لِأُذنَيهِ مِن عُرى شَنَفِه",70,"ف",2,0],["فَإِن قيلَ ما يُبكيكَ قالَ حَمامَةٌ","تَنوحُ عَلى فَرخٍ بِأَصواتِ مُعوِلِ",71,"ل",1,0],["فَإِن قُلتَ قَد قَصَّرتَ فيها وَلَيسَ مَن","بَغى حاجَةً إِلّا كَما قالَ ذو الفَضلِ",72,"ل",1,0],["فَاِنقَضى ذاكَ وَكانَت شِرَّتي","مِثلَ ما كانَ ذُبالٌ فَاِحتَرَق",73,"ق",1,0],["فَاِنقَضى ذاكَ حَميداً عَهدُهُ","وَحَسَرتُ اللَهوَ عَنّي فَاِنحَسَر",74,"ر",1,0],["فَإِن قُلتَ إِنّي ماجِدٌ وَاِبنُ ماجِدٍ","فَقَد قالَ خِنزيرُ السَوادِ أَنا الأَسَد",75,"د",1,0],["فَاِنقَضى ذَلِكَ الزَمانُ وَأَبقى","زَمَناً راعَنا بِأَمرٍ عَجيبِ",76,"ب",1,0],["فَاِنقَلَبَت وَالدَهرُ ذو اِنقِلابِ","ما أَقرَبَ العامِرَ مِن خَرابِ",77,"ب",1,0],["فَإِنَّ قَبيحاً بِالمُسَوَّدِ ضِجعَةٌ","عَلى فَرشِهِ يَشكو إِلى النَفَرِ الكَربا",78,"ب",2,0],["فَإِنَّ قُرونَ الخَيلِ أَولَتكَ ناطِحاً","وَإِنَّ الحُسامَ العَضبَ لَقّاكَ أَعضَبا",79,"ب",2,0],["فَإِن قَدَرتَ فَلا تَفعَل سِوى حَسَنٍ","بينَ الأَنامِ وَجانِب كُلَّ ما قُبِحا",80,"ح",2,0],["فَإِنَ قتَيرَ الشَيبِ لَم يَحمِ جانِباً","فَكانَ بِعَكسٍ مِن قَتيرٍ سَرودِ",81,"د",1,0],["فَإِن قُلتَ ثانيهِ لاوَقفَ في","هِ قُلنا وَثالِثُهُ أَصلَمُ",82,"م",1,0],["فأنْقَذْتَ منها مَعقِلاً هَضَبَاتُه","تَلَفّعُ من نسْجِ السّحابِ وترْتَدي",83,"د",2,0],["فإنْ قَعَدَتْ عنه الحوادثُ حِقْبةً","فها هيَ فيما لا تشاء قِيامُ",84,"م",1,0],["فانقضَّتِ العقبانُ والسَّلالقهْ","زَعْقاً على مُقدَّم الجلالِقهْ",85,"ه",1,0],["فإنْ قال ضَيَّعتِهِ أسرعتْ","إلى النار تُوقِظُ فيها الضرامْ",86,"م",1,0],["فإِن قيل هذا مجلسُ الأمنِ فاسألوا","علام تضجُّ الأرض بالشّنآنِ",87,"ن",1,0],["فأنْقَذْتَهُ والمَوْت يَحْرقُ نابَهُ","عَلَيْهِ ولَمْ يُطْعَنْ ولَمْ يُتَنَسَّفِ",88,"ف",1,0],["فانقلب الحق بهذا فَرْددا","وعاد هذا بالهدى مسدّدا",89,"د",2,0],["فَإِنَّ قُلُوبَ النَّاسِ تَمْتَازُ فِطْرَةً","فَمِنْهَا لِبَعْضٍ آلِفٌ وَنَقِيضُ",90,"ض",1,0],["فَإِنْ قَالَ حَقَّاً كَذَّبُوهُ وَإِنْ أَبى","مُجَارَاتَهُمْ في الْغَيِّ قَالُوا مُعَانِدُ",91,"د",1,0],["فَإِنَّ قَرِينَ السُّوءِ مَا لَمْ تُجَازِهِ","بِأَفْعَالِهِ وَافَاكَ بِالْعُذْرِ يَرْكُضُ",92,"ض",1,0],["فَإِنْ قَلبَ المَحْزُون فِي الأُفْقِ طَرْفَهُ","فَلَيْسَ يَرَى إِلاَّ ذَكَاءَكَ فَرْقَدَا",93,"د",2,0],["فَإِنْ قَرِنَتْ شَجَاعَتُهُمْ بِقَصْدٍ","وَتَثْقِيفٍ فَقَدْ ضمِنَ المَآلُ",94,"ل",1,0],["فأنْقَذَنا اللهُ في نُورِهِ","وَنَجَّى بِرَحْمَتِهِ مِنْ لَظَى",95,"ا",1,0],["فإن قلتَ أحياءٌ فلست بكاذبٍ","وإن قلتَ أمواتٌ فلستَ مُفَنّدا",96,"د",2,0],["فَإِن قُلتُ عُرفاً أَنكَروهُ بِمُنكَرٍ","وَغَطَّوا عَلى التَحقيقِ بِالشُبُهاتِ",97,"ت",1,0],["فأنقذتَه والموْتُ يَحرقُ نابَهُ","عليه ولم يطعن ولم يتسيفِ",98,"ف",1,0],["فانقُدْ علومَك كالدراهم، إنني","ألفْيتُ منها خالصًا ومُزَوَّرا",99,"ر",2,0],["فانقسمنا برغمنا وسألنا","أين أين القربى ؟ وأين المراحم ؟",100,"م",1,0],["فإنْ قَالَ بالإكْثَارِ، قالَ مُقَلِّلاً،","ولَوْ قَالَ بالإفْرَاطِ، قالَ مُصَدَّقَا",101,"ق",2,0],["فإنْ قُلْتَ هَذي سُنّةٌ كُنْتَ حاتماً،","وإنْ قُلتَ فَرْضاً لازِمٌ كنتَ مَصْدَقَا",101,"ق",2,0],["فَإن قَدْ ضَمنْتُ على المَنَايَا","نَوَائِبَ كُلِّ ذي حَدَثٍ عَظِيمِ",102,"م",1,0],["فإن قلت قد صحَّ الذي أتت جاحدٌ","فهبْ ذنبَ جانٍ لاعتذارٍ ذليل",103,"ل",1,0],["فإن قدّمت خوفاً جرَّ مناً","وإن قدمتَ أمناً جرَّ خوفا",104,"ف",2,0],["فإن قلتُم للحكم بالحق فضلُه","فما للدبغِ النحلِ من عسلِ النحلِ",105,"ل",1,0],["فانقِصه من تَنصيفِك الأجذارا","وإن تَشَأ جَمَعتَهُ اختيارا",106,"ر",2,0],["فان قلت لا ابكي يسح مدامعي","غرام على كتمانه لست اقدر",107,"ر",1,0],["فإنْ قويتُ فبالإِحسان يغرقُني","وإن بعدتُ فعرفٌ مِنه يأتينِي",108,"ن",2,0],["فَإِنَّ قَناتِى لَم تَلِن إِن غَمَزتَهَا","ولَم تَتَكَّسَر فَهىَ مِثلُ سِنَانِ",109,"ن",1,0],["فإِن قُلتَ قَد شاهدتُ فِيه كرامةً","وألفَيتُه بينَ العَشِيرِ مُسَوَّدَا",110,"د",2,0],["فإن قال مالم يعرفوا قدرَ لفظهِ","ولا قيمةَ المعنَى فما هو قائلُ",111,"ل",1,0],["فَإِن قَتَلَتهُ فَلَم آلُهُ","وَإِن يَنجُ مِنها فَجُرحٌ رَغيب",112,"ب",1,0],["فأَنقَذَهُم نورٌ يَدُلُّ وَيَكلأُ","مَحوطٌ بِحِفظِ اللَهِ في كُلِّ هَيئَةٍ",113,"ه",1,0],["فإن قلت لم أعلم نفاقا بشيخنا","ولكنه عندي ولي مقرب",114,"ب",1,0],["فإن قلت ما هذا أراد امامنا","نقل لك بين عل فهمك اثقب",114,"ب",1,0],["فإن قلت لا أنتم ولا أنا عارف","بما قاله بل مقصد الشيخ أغرب",114,"ب",1,0],["فإن قلتم أصحابنا فهو مقتضى","حديث رسول الله من لا يكذب",114,"ب",1,0],["فإن قلتم لم تنه فيها علومها","فها أنا قد أنهيت هل من مبادر",115,"ر",1,0],["فإن قلت دين ابن العريبي ديننا","وتكفيره تكفيرنا فلتحاذر",115,"ر",1,0],["فَإِن قَرَنتَ إِلَيهِ العَزمَ أَيَّدَهُ","حَتّى يَعودَ لَدَيهِ الحُزنُ مَغلوبا",116,"ب",2,0],["فَإِن قُلتُ اِعلمُوهُ بِغَيرِ إِذنٍ","مَقالَةَ مَن لَهُ أَدَبٌ وَعَقلُ",117,"ل",1,0],["فإن قَبَروا جُثْمانَه فثَناؤُه","معَ الدهرِ في ألأفواهِ ما ليس يُقْبَر",118,"ر",1,0],["فإن قلت إن الشمرب العذب شابه","أجاج فها قد أج مشربك العذب",119,"ب",1,0],["فإن قلت لا صلح وقد طار رائش","فلا سلمَ إلا وهو يقدمها حرب",119,"ب",1,0],["فَإن قالَ ذو عقلٍ لهم إنّ قولهُ","مَجازٌ بِمَعنى أَن يُديموا له الذِكرى",120,"ر",2,0],["فانقدَّ قدُّ القضيبِ من دَهَشٍ","واحمرَّ خدُّ الشقيقِ من خجل",121,"ل",1,0],["فإن قيلَ عني أنهُ ماتَ عاشقاً","فقلْ لهم ما رحمةُ الميتِ من شاني",122,"ن",2,0],["فإن قلتَ لي أين القيام بحقِّنا","فإنَّ جوابي أين أخذُكَ بالفضلِ",123,"ل",1,0],["فإن قلت هل يُجفَى الصديق لأمرد","فلا عجب إذ كان يعصى به الربُّ",124,"ب",1,0],["فأن قلت بدر فهو من بعض نوره","وان قلت شمس فهي منه استمدت",125,"ت",1,0],["فإن قيل بدرٌ فقل عبده","وإن قيل شمس الضحى قل أجل",126,"ل",1,0],["فَاِنقُد كلامَكَ قبلَ الناقِدينَ تحُط","ثاني النَفيسَين من لَغوٍ ومن هَذَر",127,"ر",1,0],["فإن قلتُم إنا جميعاً لهاشم","فما يستوي في الجثّة العَضُدان",128,"ن",1,0],["فإن قال ما هذا الحرَورُ فقل له","تنفُّسُ مشتاقٍ لوجهِك موجَعِ",129,"ع",1,0],["فإنْ قَضَى بالتلاقي اللهُ ثانيةً","فالشكرُ أعظمُ ما صيَّرتُه زادي",130,"د",2,0],["فإنّ قلبيَ لم أملِكْه دونَكُم","يوماً فأَحْمِلَه فيكم على رائي",131,"ا",3,0],["فَإِن قَتَلتَ فَعَبدٌ أَنتَ مالِكُه","وَإِن مَنَنتَ فَتِلكَ العادُ وَالشِيَمُ",132,"م",1,0],["فَإِنْ قَالَ مَا حَالُ الْمُحِبِّفَقُلْ لَهُ","بِعَادُكَ أَضْنَى قَلْبَهُ فَهْوَ مُوجَعُ",133,"ع",1,0],["فَأَنْقِذْ نُهَانَا مِنْ هَوَانَا فَإِنَّهُ","شَجَاهَا كَمَا يَشْجُو الْفَتَى وَرَمُ الرَّفْغِ",134,"غ",1,0],["فانَّ قَليلَ الحُبِّ في العقل صالحٌ","وإنَّ كثير الحُبِّ بالجهل فاسِدُ",135,"د",1,0],["فَإِنَّ قَصرَكُما مِن ذاكَ أَن تَرَيا","وَجهاً يَكادُ سَناهُ يَلمِسُ البَصَرا",136,"ر",2,0],["فإن قد ظفرنا بمطلوبنا","ففضل من اللَه رب العباد",137,"د",1,0],["فَاِنقَع صَداه بكأسِ عفوٍ سائغٍ","قَد مازَجت صفوَ الرّضا وَفريجه",138,"ج",2,0],["فإن قهرت فيه قوى الجسم ألحقت","بعالمها مملوء