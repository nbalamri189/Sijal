{"poems":[[35,"إلى ظعن يتبعن في قتر الضحى","https://www.aldiwan.net/poem39091.html","الطويل"],[35,"أهاجتك سلمى أم أجد بكورها","https://www.aldiwan.net/poem39144.html","الطويل"],[30,"ألم تسأل اليوم الرسوم الدوارس","https://www.aldiwan.net/poem29577.html","الطويل"],[26,"صبا صبوة بل لج وهو لجوج","https://www.aldiwan.net/poem24100.html","الطويل"],[45,"لعمري لئن أخلقت ثوب التغزل","https://www.aldiwan.net/poem65650.html","الطويل"],[33,"أيا ويح من أمسى يخلس عقله","https://www.aldiwan.net/poem25988.html","الطويل"],[52,"رعين كما شئن الربيع سوارحا","https://www.aldiwan.net/poem27302.html","الطويل"],[15,"أمن منزل عاف ومن رسم أطلال","https://www.aldiwan.net/poem45252.html","الطويل"],[33,"أيَا وَيْحَ مَنْ أمسَى يُخَلَّسُ عَقْلُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=2588",""],[259,"إلام اصطباري لا يرى غير خائب","https://www.aldiwan.net/poem38372.html","الطويل"],[296,"أحس بشيء في الحشا يشبه الجمرا","https://www.aldiwan.net/poem36281.html","عموديه"],[298,"فمثلك ألوى بالفؤاد وزار بالعداد","https://www.aldiwan.net/poem45486.html","الطويل"],[335,"نظرت وسهب من بوانة بيننا","https://www.aldiwan.net/poem45425.html","الطويل"],[362,"من القاتلات الصب بالهجر في الهوى","https://www.aldiwan.net/poem60956.html","الطويل"],[456,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"]],"verses":[["إِلى ظُعنٍ يَتبَعنَ في قَتَرِ الضُحى","بِعُدوَةِ وَدّانَ المَطِيَّ الرَواسِما",0,"م",2,1],["إِلى ظُعنٍ بِالنَعفِ نَعفِ مَياسِرٍ","حَدَتها تَواليها وَمارَت صُدورُها",1,"ر",3,0],["إِلى ظُعُنٍ يَقرِضنَ أَجوازَ مُشرِفٍ","شِمالاً وَعَن أَيمانِهِنَّ الفَوارِسُ",2,"س",1,0],["إِلى ظُعُنٍ كَالدَومِ فيها تَزايُلٌ","وَهِزَّةُ أَجمالٍ لَهُنَّ وَسيجُ",3,"ج",1,0],["إِلى ظِلِّ مَمروجٍ بُرودٍ مَقيلُهُ","طَليلِ السَواري بِالقِبابِ مُعَزَّلِ",4,"ل",1,0],["إِلى ظُعُنٍ تَخذي كَأَنَّ زُهائَها","نَواعِمَ أَثلٍ أَو سَعِيّاتِ أَثلَبِ",5,"ب",1,0],["إِلى ظَبيَةٍ باتَت تُرى في مَنامِها","خَيالي فَأَدناني وَما كانَ كَذّابا",6,"ب",2,0],["إِلى ظُعُنٍ يَسلُكنَ بَينَ تَبالَةٍ","وَبَينَ أَعالي الخَلِّ لاحِقَةِ التالي",7,"ي",1,0],["إلى ظعن تحدى كأن زهاءها","نَوَاعِمُ أثْلٍ أوْ سَعِيَّاتُ أثْلَبِ",8,"ب",1,0],["إلى ظل ممنوع الجناب مهذب ال","خلايق مبذول اللهى والرغائب",9,"ب",1,0],["إلى ظِلِّكَ العالي زَففتُ خريدةً","إِجازة شِعرٍ مِنكُمُ أَبتغي مهْرا",10,"ر",2,0],["إِلى ظُعُنٍ ظَلَّت بِجَوِّ أُشاهِمٍ","فَلَمّا مَضى حَدُّ النارِ وَقَصَّرا",11,"ر",2,0],["إِلى ظُعُنٍ هاجَت عَلَيَّ صَبابَةً","لَهُنَّ بِأَعلى القُرنَتَينِ حَريقُ",12,"ق",1,0],["إلى ظِلِّ مَلْكٍ بالمعالي مُتَوَّجٍ","له الأرضُ دارٌ والأنامُ عبِيد",13,"د",1,0],["إلى ظليلِ البيت رَطْبِ الثرى","عالي الأثافِي حافلِ المَحلْبِ",14,"ب",1,0]]}