{"poems":[[37,"إلى ظعن يتبعن في قتر الضحى","https://www.aldiwan.net/poem39091.html","الطويل"],[37,"أهاجتك سلمى أم أجد بكورها","https://www.aldiwan.net/poem39144.html","الطويل"],[32,"ألم تسأل اليوم الرسوم الدوارس","https://www.aldiwan.net/poem29577.html","الطويل"],[26,"صبا صبوة بل لج وهو لجوج","https://www.aldiwan.net/poem24100.html","الطويل"],[47,"لعمري لئن أخلقت ثوب التغزل","https://www.aldiwan.net/poem65650.html","الطويل"],[35,"أيا ويح من أمسى يخلس عقله","https://www.aldiwan.net/poem25988.html","الطويل"],[54,"رعين كما شئن الربيع سوارحا","https://www.aldiwan.net/poem27302.html","الطويل"],[15,"أمن منزل عاف ومن رسم أطلال","https://www.aldiwan.net/poem45252.html","الطويل"],[35,"أيَا وَيْحَ مَنْ أمسَى يُخَلَّسُ عَقْلُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=2588",""],[266,"إلام اصطباري لا يرى غير خائب","https://www.aldiwan.net/poem38372.html","الطويل"],[303,"أحس بشيء في الحشا يشبه الجمرا","https://www.aldiwan.net/poem36281.html","عموديه"],[305,"فمثلك ألوى بالفؤاد وزار بالعداد","https://www.aldiwan.net/poem45486.html","الطويل"],[342,"نظرت وسهب من بوانة بيننا","https://www.aldiwan.net/poem45425.html","الطويل"],[369,"من القاتلات الصب بالهجر في الهوى","https://www.aldiwan.net/poem60956.html","الطويل"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206030","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96561","الوافر"],[1418,"","https://poetry.dctabudhabi.ae/diwan/poem/114822","الطويل"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126381","الطويل"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34902","الهزج"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22544","الوافر"],[3544,"","https://poetry.dctabudhabi.ae/diwan/poem/116839","الطويل"],[3619,"","https://poetry.dctabudhabi.ae/diwan/poem/33115","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36794","الطويل"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18998","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81946","الطويل"],[5431,"إلى حبيب الروح...","https://www.poetsgate.com/ViewPoem.aspx?id=214054",""],[5850,"نظرتُ وسهبٌ من بوانة َ بيننا","https://www.poetsgate.com/ViewPoem.aspx?id=19710",""],[5969,"ذُنوبُ العَيش","https://www.poetsgate.com/ViewPoem.aspx?id=200147",""]],"verses":[["إِلى ظُعنٍ يَتبَعنَ في قَتَرِ الضُحى","بِعُدوَةِ وَدّانَ المَطِيَّ الرَواسِما",0,"م",2,1],["إِلى ظُعنٍ بِالنَعفِ نَعفِ مَياسِرٍ","حَدَتها تَواليها وَمارَت صُدورُها",1,"ر",3,0],["إِلى ظُعُنٍ يَقرِضنَ أَجوازَ مُشرِفٍ","شِمالاً وَعَن أَيمانِهِنَّ الفَوارِسُ",2,"س",1,0],["إِلى ظُعُنٍ كَالدَومِ فيها تَزايُلٌ","وَهِزَّةُ أَجمالٍ لَهُنَّ وَسيجُ",3,"ج",1,0],["إِلى ظِلِّ مَمروجٍ بُرودٍ مَقيلُهُ","طَليلِ السَواري بِالقِبابِ مُعَزَّلِ",4,"ل",1,0],["إِلى ظُعُنٍ تَخذي كَأَنَّ زُهائَها","نَواعِمَ أَثلٍ أَو سَعِيّاتِ أَثلَبِ",5,"ب",1,0],["إِلى ظَبيَةٍ باتَت تُرى في مَنامِها","خَيالي فَأَدناني وَما كانَ كَذّابا",6,"ب",2,0],["إِلى ظُعُنٍ يَسلُكنَ بَينَ تَبالَةٍ","وَبَينَ أَعالي الخَلِّ لاحِقَةِ التالي",7,"ل",2,0],["إلى ظعن تحدى كأن زهاءها","نَوَاعِمُ أثْلٍ أوْ سَعِيَّاتُ أثْلَبِ",8,"ب",1,0],["إلى ظل ممنوع الجناب مهذب ال","خلايق مبذول اللهى والرغائب",9,"ب",1,0],["إلى ظِلِّكَ العالي زَففتُ خريدةً","إِجازة شِعرٍ مِنكُمُ أَبتغي مهْرا",10,"ر",2,0],["إِلى ظُعُنٍ ظَلَّت بِجَوِّ أُشاهِمٍ","فَلَمّا مَضى حَدُّ النارِ وَقَصَّرا",11,"ر",2,0],["إِلى ظُعُنٍ هاجَت عَلَيَّ صَبابَةً","لَهُنَّ بِأَعلى القُرنَتَينِ حَريقُ",12,"ق",1,0],["إلى ظِلِّ مَلْكٍ بالمعالي مُتَوَّجٍ","له الأرضُ دارٌ والأنامُ عبِيد",13,"د",1,0],["إلى ظليلِ البيت رَطْبِ الثرى","عالي الأثافِي حافلِ المَحلْبِ",14,"ب",1,0],["إلى ظعن بالصلب صلب قصيدة","إلى الخرج يحدوها القيان الصوادح",15,"ح",1,1],["إِلى ظُعُنِ الفضيلةِ طالعاتٍ","خُصورَ الرَّملِ واردةَ الهماجِ",16,"ج",1,0],["الى ظُعُنٍ للمالكياتِ بالضُّحى","فيالك مرأى ما أشاقَ وأبعدا",17,"د",2,0],["الى ظلّ سلطان لعزٍ جلاله","وسطوته تعنو الملوك الجبابر",18,"ر",1,0],["إِلى ظَبيٍ مِن الإِنسِ","يَصيدُ الإِنسَ وَالجِنّا",19,"ن",2,0],["إِلى ظُعُنٍ لَأُختِ بَني غِفارٍ","بِكابَةَ حَيثُ زاحَمَها العَقارُ",20,"ر",1,0],["إلى ظُعُنٍ قد يَمَّمَت نحو حائلٍ","وقد عَزَّ أرواحَ المصيف جنوبُها",21,"ب",3,0],["إِلى ظُعُنٍ بِالعاقِرينَ كَأَنَّها","قَرائِنُ مِن دَوحِ الكَثيبِ ثَمانِ",22,"ن",1,0],["إِلى ظلِّ أَحوى مِنهُ مُنبَجِس غَدَت","تُعَلُّ بِهِ الأَرواحُ وَهوَ صَحيحُ",23,"ح",1,0],["إِلى ظُعُنٍ بَينَ الرَسيسِ فَعاقِلٍ","عَوامِدَ لِشيقَينِ لَم يَتَرَجَّلِ",24,"ل",1,0],["إلى ظاهرٍ ماء الحياة بدعوة","لإدراكها هذا الورى غير ضامن",25,"ن",1,0],["إلى ظللِ السكينة في عروقٍ","زهتْ بردا وزاد الحرقُ عمقا",26,"ق",2,0],["إلى ظعنٍ هاجت عليَّ صبابة","ً لهنَّ بأعلى القرنتينِ طريقُ",27,"ق",1,0],["إلى ظِلٍ أُشكِّلُهُ بنوري","وَنورٍ حَلَّ في روضٍ ظَليلِ",28,"ل",1,0]]}