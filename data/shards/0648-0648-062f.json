sgate.com/ViewPoem.aspx?id=190484",""],[5042,"أخفيت حبك عن جميع جوانحي","https://www.poetsgate.com/ViewPoem.aspx?id=211635",""],[5042,"أخفيت حبك عن جميع جوارحي","https://www.poetsgate.com/ViewPoem.aspx?id=211624",""],[5101,"قَبّةُ القميص","https://www.poetsgate.com/ViewPoem.aspx?id=189480",""],[5237,"يا صاح من رزق التقى وقلى الدني","https://www.poetsgate.com/ViewPoem.aspx?id=113111",""],[5284,"هرمنا","https://www.poetsgate.com/ViewPoem.aspx?id=191799",""],[5302,"بلغوا هندا سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=200950",""],[5397,"عن الدار نأيا أزمع الركب ترحالا","https://www.poetsgate.com/ViewPoem.aspx?id=157967",""],[5409,"فنُّ البيان رثاك قبل لساني","https://www.poetsgate.com/ViewPoem.aspx?id=155483",""],[5431,"قبلةٌ مبتلهْ!","https://www.poetsgate.com/ViewPoem.aspx?id=195177",""],[5431,"أحلى الحب أعنفه...","https://www.poetsgate.com/ViewPoem.aspx?id=199676",""],[5458,"العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=72384",""],[5539,"القصه","https://www.poetsgate.com/ViewPoem.aspx?id=196882",""],[5587,"من يشعل عظامي","https://www.poetsgate.com/ViewPoem.aspx?id=188585",""],[5616,"سيف على لغتي","https://www.poetsgate.com/ViewPoem.aspx?id=205036",""],[5628,"عيناك مرفئي","https://www.poetsgate.com/ViewPoem.aspx?id=179812",""],[2110,"والنجم من فلك النحور إذا هوى","https://www.poetsgate.com/ViewPoem.aspx?id=156289",""],[5638,"حوار بين ليفني ومبارك بشأن غزة","https://www.poetsgate.com/ViewPoem.aspx?id=198245",""],[5644,"حديث آسر","https://www.poetsgate.com/ViewPoem.aspx?id=198639",""],[5690,"حياة المرءِ في الدنيا منامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172186",""],[5790,"أنظرت أم فوقت سهما","https://www.poetsgate.com/ViewPoem.aspx?id=112135",""],[5818,"بثامن آيةٍ في العادياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=199689",""],[5956,"مصادر السعادة","https://www.poetsgate.com/ViewPoem.aspx?id=182405",""],[5956,"محمدُ وفقي الأعزُّ عَليّا","https://www.poetsgate.com/ViewPoem.aspx?id=194739",""],[5973,"ولماذا الخصام؟","https://www.poetsgate.com/ViewPoem.aspx?id=15893",""],[5975,"الوفاء لمن أحب","https://www.poetsgate.com/ViewPoem.aspx?id=52984",""],[6034,"الدهر لا يبرح خوانا","https://www.poetsgate.com/ViewPoem.aspx?id=169609",""],[3304,"حواء أم جنية البحر","https://www.poetsgate.com/ViewPoem.aspx?id=135617",""],[6093,"صمت يكتب الجهرا","https://www.poetsgate.com/ViewPoem.aspx?id=192123",""],[6093,"جنجفير","https://www.poetsgate.com/ViewPoem.aspx?id=205322",""],[6102,"أُمِّي وَأُمِّي","https://www.poetsgate.com/ViewPoem.aspx?id=182734",""],[6102,"فارسية","https://www.poetsgate.com/ViewPoem.aspx?id=184546",""],[2575,"يا ناعس الطرف","https://www.poetsgate.com/ViewPoem.aspx?id=10276",""],[6136,"عبرة إلى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=36239",""],[6211,"شكرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78232&r=&rc=3",""],[6261,"الهجرة الخامسة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82138&r=&rc=10",""]],"verses":[["وَوَدَّ أَن يَتَلافى ما جَنَت يَدُهُ","وَكانَ ذَلِكَ كَسراً غَيرَ مَجبورِ",0,"ر",1,0],["وَوَدَّعَتْنِي سُلَيمَى وَالرَّقيبُ يَرى","بِقِّدِها ما بِعَينَيها مِنَ الثَّمَلِ",1,"ل",1,0],["وَوِدِّيَ لاَ يُحْتَاجُ فِيهِ لِشَاهِدٍ","وَتَقْرِيرِيَ الْمَعْلُومَ ضَرْبٌ مِنَ الْجَهْلِ",2,"ل",1,0],["وودَّعَ يَثْني بالذي أنْتَ أهْلُهُ","وقدْ جلّتِ الزُّلْفى وقد عظُمَ الأجْرُ",3,"ر",1,0],["وودّعْتُهُ كرْهاً وداعَ ضَرورةٍ","وحُكْمُ النّوى يجْري على غيْرِ واحِدِ",4,"د",1,0],["وَوَديقَةٍ شَهباءَ رُدِّ","يَ أَكمُها بِسَرابِها",5,"ب",3,0],["وَوَدَّتِ الريحُ لَو كانَت مُسَخَّرَةً","لِحَملِ نَعشِكَ عَن هامِ الأَماجيدِ",6,"د",1,0],["وَوِدادي لَكَ نَصٌّ","لَم يُخالِفهُ قِياسُ",7,"س",1,0],["وَوِدادٌ يُغَيِّرُ الدَهرُ ما شاءَ","وَيَبقى بَقاءَ عَهدِ الكَريمِ",8,"م",1,0],["وودّت الشمس في أشعّتها","لو كنّ يُحْسَبْن من قوى طُنُبه",9,"ب",2,0],["وَوَدَّعا الحَفايِرَ مِن فُلَيجٍ","وَحَيّاً يَسكُنونَ رَحا الثِمادِ",10,"د",1,0],["وَوَدَّعَنا بِالجَلهَتَينِ مُساحِقٌ","وَصاحَبَ سَيّارٌ حِماراً وَهَيثَما",11,"م",2,0],["ووداداً إذا جفا الصحب يدنو","وإذا كدّر الزمان يروق",12,"ق",1,0],["وَوُدٍّ بين شَيْخَيْنَا قَديم","على الأيام مَعْقدُهُ وَكيدُ",13,"د",1,0],["وودَّعت الدنيا لتقضي نحبَها","وشَوَّل باقي عمرها فتشعشعا",14,"ع",2,0],["ووَددْتَ أنك منه أوَّلُ لاحقٍ","أو كنتَ مضموناً إليه مُقارنا",15,"ن",2,0],["وَوَدَّ أُناسٌ لَو يُعاجِلُني الرَدى","كَأَنِّيَ أَرجو فيهِم أَن أُخَلَّدا",16,"د",2,0],["وَوَدِدتُ مِن شَجوي عَلَيك وَحَسرَتي","لَو اِنَّ لَحدَكَ في فُؤادي يُحفَرُ",17,"ر",1,0],["وَوَدَّعَتني وَمِن مَحاجِرِها","فَوقَ العَقيقِ الجُمانُ يَنحَدِرُ",18,"ر",1,0],["وَوَدِدتُ لَو دامَ الخَلي","عُ فَهَل إِلَيهِ مِن شَفيعِ",19,"ع",1,0],["وَوَداعَةُ العُصفورِ بَيْنَ","جداولِ الماءِ النَّميرْ",20,"ر",1,0],["وَوُدّي عَلى حسب ما تَعلَمينَ","تَزولُ الجِبالُ وَما إِن يَزولُ",21,"ل",1,0],["ووددت لو اني اعود الى الصبا","ولكل احلامي به استأنف",22,"ف",1,0],["ووددت لو اسطيع قبل","منيتي عنه فرارا",23,"ر",2,0],["وودت لو اصبحت اكرع","في الشراب السلسل",24,"ل",1,0],["ووددت لو اضحى شتاتك وحدة","او كان لا يتفرق المتفرق",25,"ق",1,0],["وودادا على الزمان كريما","سبكت تبره الليالي السوابك",26,"ك",1,0],["وَوَدَّ القَيصَرانِ لَوَ أَنَّ روما","عَلَيها مِن حَضارَتِهِ سِماتُ",27,"ت",1,0],["وَوَدائِعُ الفاروقِ عِندَكَ دينَهُ","وَلِواؤُهُ وَبَيانُهُ وَالمَنطِقُ",28,"ق",1,0],["وودار أعلاها على سفلها","فتمّ تمزيج وتعديلُ",29,"ل",1,0],["وودٌّ مثلُ ماءِ الكرم صافٍ","يرقُّ غَيايَةَ الطبع الرُكامِ",30,"م",1,0],["وَوَدَّت مَكانَ الأَنفِ لَو كانَ نافِعٌ","لَها حَيضَةٌ أَو أَعجَلَتها شُهورُها",31,"ر",3,0],["وَوُدٍّ شَبَّهَتهُ لَهُم بِنُصحٍ","إِذا شورِكتُ في فَصلِ القَضايا",32,"ا",3,0],["ووددت لو أنَّ الحياةَ تحولت","ماءً وإني ماءها أسقيكِ",33,"ك",1,0],["وَوَدَّأَ سَيبَها ما وَدَّأَتهُ","يَحابِرُ في المُقَطَّمِ بَل تُجيبُ",34,"ب",1,0],["وَوَداعُها يَومَ الرَحيلِ وَقَد","زُمَّ المَطيُّ لِبَينِهِم تَخدي",35,"د",2,0],["ووِدّي لَهُ بَاقٍ ولَستُ بِسَامِعٍ","لِقَولِ حَسُودٍ والعَواذِلِ إن عَووا",36,"و",3,0],["وودّعتْ بالنظرة المغريه","تصحب لُبّي معها في الرّكاب",37,"ب",1,0],["وَوُدُّكَ إِن نَحنُ فُزنا بِهِ","لَنا وَلَكُم رِحلَةٌ رابِحَه",38,"ح",2,0],["وَوَداعي الصِبا وَقَلبٌ إِذا لَ","جَّ لِجُوجٌ فَما يَكادُ يُصار",39,"ر",1,0],["وَوَدَّ العَذارَى لوْ يُعَجِّلُ نِحْلةً","إليهنَّ مِنْ تلكَ الحُروفِ مُهُورُ",40,"ر",1,0],["وودادي مؤكَّدٌ لك والله","يميناً من أفضل الأقسَام",41,"م",1,0],["وَوَدَّتْ مهاةُ الرَّمل لو تُركتْ لهُ","فأعطَتْ بأدنَى نظرةٍ منه جُؤذَرا",42,"ر",2,0],["وَوَدَّعتُها صُبحاً وَلَم أَنسَ صَدَّها","وَقَد بادَلَتني خاتَماً بِسِوارِ",43,"ر",1,0],["وَوَدَّعَني الصِبا وَعَريتُ مِنهُ","كَما مِن غِمدِهِ خَرَجَ الحُسامُ",44,"م",1,0],["وَوَدَّ اللَيلَ زيدَ إِلَيهِ لَيلٌ","وَلَم يُخلَق لَهُ أَبداً نَهارُ",45,"ر",1,0],["وَوَدّوا العَيشَ في زَمَنٍ خَؤونٍ","وَقَد عَرَفوا أَذاهُ وَجَرَّبوهُ",46,"ب",3,0],["وَوَدَّعَ إِخوانَ الصَفاءِ بِقُرزُلٍ","يَمُرُّ كَمِرّيخِ الوَليدِ المُقَزَّعِ",47,"ع",1,0],["ووددتُ أني في مَكانك للردى","غرض وأنك عنه كنت مكاني",48,"ن",2,0],["وَوَددتُ لو غال الخلائقَ غائلٌ","مُفنٍ أو اشتعَل الصباحُ حريقا",49,"ق",2,0],["ووديعةٌ رَجَعت فما خطبي إذا","رُدَّ الذي كان الزمانُ أعارا",49,"ر",2,0],["وودِدْتَ لو حُكِّمتَ في القَدَرِ","لتعيدَ سيرتَها من الرَّمْسِ",50,"س",1,0],["وَوَدَّعَني فَأَودَعَني لَهيباً","أُسَتِّرُهُ وَيَشعُلُ في عِظامي",51,"م",2,0],["وودّ لو أنهُ وترٌ حنونٌ","يسيل على بنانكَ أو صداكا",52,"ك",2,0],["ووَدِدْنا لو استقرَّ التَّمَنِّي","واستراح الرَجاءُ بعدَ كَلال",53,"ل",1,0],["وودّتِ الشمسُ لو تبدو أَشعتُها","ليلاً؛ لتنعَمَ عن قربٍ بمرآهُ",54,"ا",2,0],["وودت قوما حددوا","لك قبلها القضب الصفاح",55,"ح",1,0],["وودع معاهدك الزهراء إن بها","غما لو احتل غمر البحر لم يسل",56,"ل",1,0],["وودع يثني بالذي أنت أهله","وقد حلت الزلفى وقد عظم الأمر",57,"ر",1,0],["ووديانه ، في ضياع الضيّاع ... وموعده ، رحلة (السّندباد)","يغازل خلف امتداد الخيال ... مدى للفنون ، عليه احتشاد",58,"د",1,0],["ووداعا يا فتية اليمن الخض","را وداعا بحرقة الصدر باحا",59,"ح",2,0],["وودَّعنَ مشتاقاً أصبنَ فؤادهُ","هواهنَّ إنْ لمْ يصرهِ اللهُ قاتلهْ",60,"ل",2,0],["وودَّعَ الزارعون الزرعَ وانصرفوا","للماء ما زَرَعوا منه وما بَذَروا",61,"ر",3,0],["ووداعته.؟ شرهة رفيقي الاوّلي","وقصيدتين .. وشمعتين .. ومايعه",62,"ع",2,0],["وودَّ من جزَعٍ ما كنتُ أعرفُها","ورامَ تكليمَها لو تنطقُ الأبلُ",63,"ل",1,0],["وودَّعتْ تاريخَ تاريخِها","وضيَّعتْ زمانَها من زمانِ",64,"ن",1,0],["ووَدْتَ أنك منه أولُ لاحق","أو كنتَ مضموناً إليه مُقارنا",65,"ن",2,0],["وودت على حبّي الحياة لو أنّها","يزاد لها في عمرها من حياتيا",66,"ي",2,0],["ووداً، ولو نطقَ الكاشحو","ن فيها وَلَوْ أَكْثَرَ المْكْثِرُ",67,"ر",1,0],["ووديانه ، في ضياع الضيّاع","وموعده ، رحلة (السّندباد)",68,"د",1,0],["ووددت حين هوى جناح حمامة","لو حلّقت من خافقي بجناح",69,"ح",1,0],["وودني لحبي","يا سائق الجمال",70,"ل",1,0],["وَوُدَّا كالسِّواكِ ورِمَّةً في","مُقَلَّدِ ذَلِكَ الوَتِدِ الرَّمِيمِ",71,"م",1,0],["وَوَدَّعتُ قَلْبي والحَبيبَ كليْهِما","فَفَارَقَنا سَعْدٌ وقَابَلَنا نَحْسُ",72,"س",1,0],["وودّ طول مُقام حين طاب له","ما أنت فيه من الخيرات تفعلهُ",73,"ل",2,0],["وود يفدى من الاسوا بمهجته","نعليه دع غير نعليه إذا قبلا",74,"ل",2,0],["وود الفتى من حادد الله سالب","من المؤمن الإيمان في صحفكم يتلى",75,"ل",2,0],["وَودّتِ الصُحْفُ إِذ وَلَّى لَو اِتَخَذَت","لَون المِدادِ لَها مِن لَونِها بَدَلا",76,"ل",2,0],["ووداعا يا سؤل قلبي وداعا","من فتاة لم ترو منك ظماها",77,"ا",3,0],["ووِدادِي ليس يسكن في","مهجةِ الهيّابة الوكِلِ",78,"ل",1,0],["وودّ غيريَ مكسوب ومصطنَع","والوسم في الجِلْد غير الوسم في الشَعَر",79,"ر",1,0],["وَوِدادٌ مِنِّي بِمَن","زِلَةِ الروحِ في البَدَن",80,"ن",1,0],["وَوَدَّ لَوْ آلَفَتْ لِمَا اِئْتَلَفَتْ","بِهِ مَسَرَّتُهَا وَمُنْشِدُهَا",81,"د",3,0],["وودّعتُها والحزنُ يَغلِبُ صبرَنا","وأحشاؤُنا من حَسرةِ تَتَقطَّعُ",82,"ع",1,0],["وودعني خوف الرقيب فقلت في","حراسة أمن اللَه سرت وحفظه",83,"ظ",2,0],["وودعتهم والدمع ينزو جمامه","فلما تفرقنا تأجن ورده",84,"د",2,0],["وودت يومي أن أموت مكرما","من دونهن ولا أعيش مذمما",85,"م",2,0],["وودّعتُها يوماً وِداعي لموطِني","وجدتُ لها بالدَّمعِ والزَّفَرات",86,"ت",1,0],["وودَّع البيتَ يَرجو العَودَ ثانيَةً","وليتَه عنه طولَ الدَهرِ ما ليتا",87,"ت",2,0],["ووداد القلوب فيها مقيم","في مزيد والوجد والشوق نام",88,"م",1,0],["ووددنا طول الإقامة فيها","بين تلك الربيوع والآكام",88,"م",1,0],["وود واخلاص كذاك تواضع","وصبر وحلم واجتهاد بكتمان",89,"ن",1,0],["وَوُدُّ عَرجونِهِ يَنح