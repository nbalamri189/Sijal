["مَرَرنَ بِمَيّاسِ الثُمامِ وَحَزنِهِ","خِفافاً كَأَطرافِ العَوالي نَواجِيا",0,"ي",2,0],["مَرَرنا بِهِ فَاِستَشرَفَتنا رُسومُهُ","كَما اِستَشرَفَ الرَوضُ الظِباءَ الجَوازِيا",1,"ي",2,0],["مَرَرتُ عَلى تِلكَ الدِيارِ وَوَحشُها","دَوانٍ وَمَن يَحكينَ غَيرُ دَواني",2,"ن",2,0],["مَرَرتُ بِغِزلانٍ عَلى جَنَباتِهِ","فَأَطلَقنَ دَمعي وَاِختَبَلنَ جَناني",3,"ن",2,0],["مَرَرنَ غُدوّاً بِرَوضِ الصَري","مِ راقَ مِنَ النَورِ ظُهرانُهُ",4,"ن",2,0],["مَرَرتُ عَلى ذاتِ الأَبارِقِ مَوهِناً","فَعارَضَني بيضُ التَّرائِبِ غيدُ",5,"د",1,1],["مَرَرْنَ بالقارَةِ اليُمْنى فعارَضَها","أُسْدٌ تُسارِقُها الألحاظَ غِزْلانُ",6,"ن",1,0],["مَرَرْتُ بِوَادِي النَّمْلِ مِنْ فَوْقِ خَدِّهِ","وَقَدْ خَافَ سُلْطَانَ الْهَوَى وَتَكَلَّمَا",7,"م",2,1],["مَرَرْتُ بِالْعُشَّاقِ قَدْ كَبَّرُوا","وَكَانَ بِالْقُرْبِ صَبِيُّ كَرِيمْ",8,"م",1,1],["مَرَرْتُ على وعْدٍ معَ الغَيْثِ بعْدَها","فمَنْظَرُها بعْدَ العُبوسِ بَهيجُ",9,"ج",1,0],["مَرَرنَ عَلى العَجالِزِ نِصفَ يَومٍ","وَأَدَّينَ الأَواصِرَ وَالجَلالا",10,"ل",2,1],["مَرَرنَ فَقُلنا إيهِ سِلمٌ فَسَلَّمَت","كَما اِكتَلَّ بِالبَرقِ الغَمامُ اللَوائِحُ",11,"ح",1,1],["مَرَرنا عَلى دارٍ لِمَيَّةَ مَرَّةً","وَجاراتِها قَد كادَ يَعفو مَقامُها",12,"م",3,1],["مررنا بالمنازل موحشاتٍ","لهوج الرامسات بها اختراق",13,"ق",1,0],["مررنَ وقد أقصرت خطوي تأدّباً","وأجمعت أمري في محافظة الصبر",14,"ر",1,0],["مَرَرتُ بِالحانِقينَ فَاِبتَسَموا","لَمّا رَأَوني وَكُلُّهُم قَلِقُ",15,"ق",1,0],["مَرَرتُ بكَرمَةٍ جَذبَت رِدائي","فَقُلتُ لَها عَزمتِ عَلى أذائي",16,"ي",1,1],["مررتَ بها فهبَّت من بِلاها","كعيسى يوم مرّ على الرميم",17,"م",1,0],["مررنا بالهلال على كريد","وقد ملأ الفضاء بها جمالا",18,"ل",2,1],["مَرَرتُ بِالمَسجِدِ المَحزونِ أَسأَلَهُ","هَل في المُصَلّى أَوِ المِحرابِ مَروانُ",19,"ن",1,0],["مَرَرتُ عَلى دارِ الحَبيبِ فَحَمحَمَت","جَوادي وَهَل تَشجو الجِيادَ المَعاهِدُ",20,"د",1,0],["مَرَرنا مِنهُ في حِسمى بِعَبدٍ","يَمُجُّ اللُؤمَ مَنخِرُهُ وَفوهُ",21,"و",2,0],["مَرَرنا عَلى بِطياسَ وَهيَ كَأَنَّها","سَبائِبُ عَصبٍ أَو زَرابيُّ عَبقَرِ",22,"ر",1,0],["مرَرْنا بالعقيقِ فكم عقيقٍ","ترقرقَ في محاجرِنا فذابا",23,"ب",2,0],["مَرَرنا حُفاةً في مَقادِسِ رَبعِهِ","كَأَنّا مُشاةٌ فَوقَ هامِ النَعائِمِ",24,"م",1,0],["مررتُ بالحَورِ والأعراسُ تملؤهُ","وعُدتُ وهو كمثوى الجانِ يَرْتَعِد",25,"د",1,0],["مَرَرتُ عَلى أَطلالِ زَينَبَ بَعدَها","فَأَعوَلتُها لَو كانَ إِعوالُها يُغني",26,"ن",2,0],["مررتِ وقيلَ مرَّ النا","سُ هل أبصرتُ إلاَّك",27,"ك",1,0],["مررتُ على أسرابِ طيركَ وقفاً","فأرسلتُ عقباني إليها تصيدُها",28,"د",3,1],["مَرَرتُ بِهَيثَمَ بنِ عَدِيِّ يَوماً","وَقِدماً كُنتُ أَمنَحُهُ الصَفاءَ",29,"ا",2,1],["مرَرْتُ بالبُلدانِ مُستعبرا","أبكي الحضاراتِ وأرثي الفنونْ",30,"ن",1,0],["مَررْتُ بَيْتَ غَيْرِكِ بَيْنَ كَرٍّ","وَفَرٍّ وَسْطَ أَنْوَاء وَصَرِّ",31,"ر",1,0],["مررتَ على الشباب مرورَ قال","وصادقت البطولة والعراكا",32,"ك",2,0],["مررتُ على الديار.. فضعتُ فيها","غريباً حائراً بين الرجال",33,"ل",1,0],["مررتُ بحدْأةٍ خارت قواها","وهاضَ جناحَها بعضُ النسورِ",34,"ر",1,1],["مررت على وعد مع الغيث بعدها","فمنظرها يعد العبوس بهيج",35,"ج",1,0],["مررتَ باللغو مرّ الهازئين به","بأُذْنِ حُرٍّ عن الفحشاء صمّاء",36,"ا",2,0],["مررت بالقوم \" شُذّاذاً \" فما وقعت","عيني على مُستمنٍّ غيره ضَرعا",37,"ع",2,0],["مَرَرْتُ بالحَوْر ِ والأعراسُ تملأهُ","وعُدْتُ وهو كمَثْوَى الجانِّ ِ يَرْتَعِدُ",38,"د",1,0],["مررت على الرياض منمنامت","فهل هيمت مذ شمت الغزالا",39,"ل",2,0],["مررت على الخمسين امضيت نصفها","غريبا ولي شأن من الفجر انور",40,"ر",1,0],["مررت باطراف الاجارع طيبا","نشدتك هل سرب الحمى ذلك السرب",41,"ب",1,0],["مَرَرتُ بِدَارِهِ فشَدوتُ لَمَّا","مَرَرت بِهَا حَنَانَك ذَا الحنَانِ",42,"ن",1,0],["مَرَرتُ بِهِ مُستَعجِلاً لا لِحاجَةٍ","كَما مَرَّ مَخمورٌ بِدُكّانِ هَرّاسِ",43,"س",1,0],["مَرَّرَ أخلاقَه فزاد بها","حلاوةً في القلوب إذ مَرَّر",44,"ر",1,0],["مَرَرْنا بروضٍ والركائبُ وُقَّفُ","فقالوا لمَنْ هذا المَحَلُّ المُزَخْرَفُ",45,"ف",1,1],["مَرَرتُ بِأَلوانِ الكَلامِ وَوَهجِهِ","فَما جازَ عَيني ثُمَّ ماتَ عَلى الحَدَق",46,"ق",1,0],["مررتُ على الدّار التي خَفَّ أَهلُها","وطالَ بِلاها فهي بَيداءُ بَلقَعُ",47,"ع",1,0],["مَرَرتَ ومرَّت كالخيالاتِ في الكرى","وما أقصرَ اللذَّاتِ والمرءُ هاجع",48,"ع",1,0],["مَرَرنَ وقد مرَرنَ على فؤادي","رشيقاتِ القدودِ على الجيادِ",49,"د",1,1],["مَررت بها والقلبُ ولهانُ شيّقٌ","يطيرُ على أنفاسها العطِرات",50,"ت",1,0],["مَررتِ على حِمَى النُّعمَى نُعامى","تزيدُ النّشرَ في الرَّوضِ انتِشارا",51,"ر",2,0],["مررت عَلى بقية ربع لَيلى","فَساعد لَوعَتي دمع يحود",52,"د",1,0],["مَرَرْتُ بِأَطْلالِ الأَحِبَّة باكِياً","فَدَهْدَهَ مَطْلُولُ الدُّمُوعِ بِها المَرْوَا",53,"و",2,0],["مَرَرنَ عَلى الشِرافِ فَذاتِ رَجلٍ","وَنَكَّبنَ الذَرانِحَ بِاليَمينِ",54,"ن",1,1],["مررتُ كما مرَّ الكريمُ بلغوةٍ","وعذت بحلمي أَن أُساجل لاغيا",55,"ي",2,0],["مرَرْنَ بنَعْمانٍ فما زلتُ واجِداً","إلى الحول نشْرَ المسْك من بطنِ نَعمان",56,"ن",1,0],["مَرَرتُ عَلى حُطامٍ مِن حُطامٍ","وَيَملِكُني الصَديقُ بِحُسنِ عِشرَه",57,"ر",2,0],["مَرَرنَ عَلى شَرافٍ فَذاتِ هَجلٍ","وَنَكَّبنَ الذَرانِحَ بِاليَمينِ",58,"ن",1,0],["مَرَرْتُ بأَمْرَدَيْنِ فقلْتُ زُورا","محِبَّكُما فقالَ الأمْرَدانِ",59,"ن",1,1],["مررتُ فلم أُلْمِمْ بِه ليَ شائِقُ","يُراجِعُ قلبي عندَ رُؤْياه جَهْلَهُ",60,"ه",1,0],["مَرَرْن بغِزْلانِ الصريمةِ فالتقى","أنيسٌ على حافاتِها ونَفورُ",61,"ر",1,0],["مررنا بوادي محسر ومحصب","إلى عرفات يسمع اللَه عجنا",62,"ن",2,0],["مررنابوادي محسر ثم مشعر","وجمع وحادي العيس يزجر فضلها",63,"ل",3,0],["مررت بنا مرور الطيف حيا","محييه وما أهنى اضطجاعا",64,"ع",2,0],["مررتُ بها فأستوقفتني عِراصُها","وقد أصبحتْ صَفْراً خِلاءَ المرابعِ",65,"ع",1,0],["مررت حمى الوراد كيما أرى وسا","لأن به الأطلال والصبح قد عما",66,"م",2,0],["مررتُ بأحلامِ الطّفولةِ والصّبا","فما أذِنتْ ولا قضتْ بدُخُولي",67,"ل",2,0],["مررت بالربع والوادي فأوحشني","وقيل لي مات أنس الربع والوادي",68,"د",2,0],["مررت بالقصر والأركان خالية","من الوفود وكانت قبلة القبل",69,"ل",1,0],["مرَرتُ على الأنصار وَسطَ رِحالهم","فقلت لهم هل منكُم اليومَ قافِلُ",70,"ل",1,0],["مَررْن بنا ونحن بغيرِ بَلْوى","فما جاوَزْنَنا حتّى بُلينا",71,"ن",2,0],["مررنا عليه منشئين لقبره","غمامَ دموعٍ والحنينُ يسوقُهُ",72,"ق",2,0],["مررناهنّ نَعتَسِفُ المطايا","نريد مِنىً فما رمنا وقوفا",73,"ف",2,0],["مَرَرنا عَلى سِربِ ال