{"poems":[[5,"ألا من مبلغ عمرو بن هند","https://www.aldiwan.net/poem285.html",""],[90,"أطربتهم بلحنها الأنغام","https://www.aldiwan.net/poem44463.html","الخفيف"],[29,"أربت بعينيك الدموع السوافح","https://www.aldiwan.net/poem5699.html","الطويل"],[29,"متى ما التوى بالظاعنين نزيع","https://www.aldiwan.net/poem5805.html","الطويل"],[53,"تناسيت أمري واطرحت حقوقي","https://www.aldiwan.net/poem65504.html","الطويل"],[31,"أتغضب قيس أن هجوت ابن مسمع","https://www.aldiwan.net/poem6036.html","الطويل"],[94,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[80,"لقد بسط الله المكارم من كفي","https://www.aldiwan.net/poem14264.html","الطويل"],[91,"بعد اني اردى فاهبط رمسي","https://www.aldiwan.net/poem44926.html","الخفيف"],[87,"أتغلبني ذات الدلال على صبري","https://www.aldiwan.net/poem63662.html","الطويل"],[47,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[30,"تحن بزوراء المدينة ناقتي","https://www.aldiwan.net/poem5618.html","الطويل"],[63,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[99,"أجر غربتي أيها العائد","https://www.aldiwan.net/poem24928.html","المتقارب"],[18,"أهاج قذاء عيني الإذكار","https://www.aldiwan.net/poem23953.html","الوافر"],[46,"جعلت فداك أنت من لا ندله","https://www.aldiwan.net/poem30370.html","الطويل"],[107,"أقول للقوم إذ طاح اللجاج بهم","https://www.aldiwan.net/poem42141.html","البسيط"],[107,"دعوا استقلال مصر فقد عرفنا","https://www.aldiwan.net/poem43068.html","الوافر"],[107,"تأن ابن حرب لست في مثلها جلدا","https://www.aldiwan.net/poem44214.html","الطويل"],[22,"عرفت منازلا من آل هند","https://www.aldiwan.net/poem21670.html","الوافر"],[50,"أتأذن لي فديتك بالسلام","https://www.aldiwan.net/poem65238.html","الوافر"],[48,"تلقب ملك قاهرا من سفاهة","https://www.aldiwan.net/poem22521.html","الطويل"],[48,"سلاسل برق تقل البلاد","https://www.aldiwan.net/poem23192.html","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39657","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[29,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54663","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54888","الطويل"],[97,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=721",""],[18,"أَهَاجَ قَذَاءَ عَيْنِي الإِذِّكَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=22981",""],[53,"تناسيتَ أمري واطّرحتَ حقوقي","https://www.poetsgate.com/ViewPoem.aspx?id=29859",""],[163,"لا تأخذنك رأفة أو رحمة","https://www.aldiwan.net/poem58804.html","الكامل"],[172,"ألم يأن أن تنسى عسى ولعلما","https://www.aldiwan.net/poem1665.html",""],[232,"أأظهر أم أخفي الذي بي من السقم","https://www.aldiwan.net/poem50791.html","الطويل"],[238,"غاداك من بحر الرواعد مسبل","https://www.aldiwan.net/poem31795.html","الكامل"],[273,"أتغريها بسفك دمي سديف","https://www.aldiwan.net/poem35013.html","الوافر"],[283,"متى ارتجعت مواهبها الكرام","https://www.aldiwan.net/poem60717.html","الوافر"],[308,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[331,"طار يطوى مجاهل الأفق والنار","https://www.aldiwan.net/poem55059.html","الخفيف"],[396,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[397,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[455,"لم يفجع الدهر أحلامي ويرهقها","https://www.aldiwan.net/poem61567.html","البسيط"],[481,"أنا فرد لا اثنان ما دمت حيا","https://www.aldiwan.net/poem36876.html","الخفيف"],[540,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[540,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[560,"إن من بعض ما هي الأطوار","https://www.aldiwan.net/poem35092.html","الخفيف"]],"verses":[["أَتَغصِبُ مالِكاً بِذُنوبِ تَيمٍ","لَقَد جِئتَ المَحارِمَ وَاِعتَدَيتا",0,"ت",2,0],["أتغنّيكم القيان بيوم","قام في مأتم به الإسلام",1,"م",1,0],["أَتَغلِبُ ما حُكمُ الأُخَيطَلِ إِذ قَضى","بِعَدلٍ وَلا بَيعُ الأُخَيطَلِ رابِحُ",2,"ح",1,0],["أَتَغضَبُ لَمّا ضَيَّعَ القَينُ عِرضَهُ","وَأَنتَ لِأُمٍّ دونَ ذاكَ مُضيعُ",3,"ع",1,0],["أَتُغفل ريي بعدما قد غرستَني","قديماً وساخت في ثراك عروقي",4,"ق",2,0],["أَتَغضَبُ قَيسٌ أَن هَجَوتُ اِبنَ مِسمَعٍ","وَما قَطَعوا بِالعِزِّ باطِنَ وادي",5,"د",2,1],["أَتغنَّى عليهْ","في رِحابِ الزَّمانْ",6,"ن",1,0],["أَتُغري يَميني بِالسَماحِ فَتَنهَمي","وَلا تَرتَضي خِلّا يَقولُ لَها يَكفي",7,"ف",2,0],["أتغاضى عن وجهها ثم ألقي","من حذار عليه نظرة خلس",8,"س",1,0],["أَتَغلِبُني ذاتُ الدَلالِ عَلى صَبري","إِذَن أَنا أَولى بِالقِناعِ وَبِالخِدرِ",9,"ر",1,1],["أَتَغلِبُ ما أَنتُم لَنا مِثلَنا لَكُم","وَلا الأَمرُ فيما بَينَنا بِمُقارِبِ",10,"ب",1,0],["أَتَغضَبُ أَن أُذنا قُتَيبَةَ حُزَّتا","جِهارَن وَلَم تَغضَب لِيَومِ اِبنِ خازِمِ",11,"م",1,0],["أَتغِلبُ قد حَلَلْتِ به مكاناً","يُريكِ النَّجمَ مُنْخَفِضَ المَكانِ",12,"ن",1,0],["أتغدو إلى عتبات النعيم","بلفح الجحيم وإعصاره",13,"ه",1,0],["أَتَغدوا يا كُلَيبُ مَعي إِذا ما","جَبانُ القَومِ أَنجاهُ الفِرارُ",14,"ر",1,0],["أَتَغدوا يا كُلَيبُ مَعي إِذا ما","حُلوقُ القَومِ يَشحَذُها الشِفارُ",14,"ر",1,0],["أَتَغدو بِهِ في الحَربِ قَبلَ اِتِّغارِهِ","وَفي الخَطبِ قَد أَعيا الأَولى مُصمَئِلُّهُ",15,"ل",2,0],["أَتغضبون إذا لم يَرْضَ باطلَكم","قاضٍ من الحقِّ تَرضَى حكمه الأُمَمُ",16,"م",1,0],["أَتُغضِبُكُم حَمِيَّةُ كُلِّ حُرٍّ","تُهَيِّجُهُ المُروءَةُ وَالوَفاءُ",17,"ا",2,0],["أتغزو رسولَ الله أن هدَّ بأسُه","من الكفر سدّاً ما رأى مثله سدّا",18,"د",2,0],["أَتَغضَبُ أَن يُساقَ القَهدُ فيكُم","فَمَن يَبكي لِأَهلِ الساجِسِيِّ",19,"ي",1,0],["أَتَغدو لِلحَديثِ إِلى فَقيهٍ","وَتَنظُرُ في الحَلالِ وَفي الحَرامِ",20,"م",1,0],["أَتَغضَبُ أَن تُدعى لَئيماً مُذَمَّماً","وَحَسبُكَ لُؤماً أَنَّ والِدَكَ الدَهرُ",21,"ر",1,0],["أَتَغسِلُ جِسمِيَ مِمّا بِهِ","وَقَلبِيَ أَحوَجُ أَن تَغسِلَه",22,"ل",2,0],["أتُغصَبُ من أهلها أرضهُم","وتُسْلمُ للغير نهباً حلالا",23,"ل",2,0],["أتُغوين بالشعر شيطانَه","خياليةٌ أنتِ أم شاعرهْ",24,"ه",1,0],["أَتَغتَرُّ تَيمٌ بِالرَجيمَةِ وَاِبنِها","كَما اِغتَرَّ كَعبٌ بِالمُلَمَّعَةِ القَفرِ",25,"ر",1,0],["أَتَغْنِ فَتِيلاً مِنْ عَزِيزٍ وَقَدْ ثَوَى","دُمُوعٌ بِهَا الأَرْوَاحُ مُنْسَفِكَاتُ",26,"ت",1,0],["أَتَغْدَو مَقَرّاً لِلضَّبَابِ سَمَاؤُهُمْ","وَقَدْماً هِيَ الْمِرْآةُ لِلشَّمْسِ وَالبَدْرِ",27,"ر",1,0],["أتغنين ذكرياتي وكانت","كوثرا في فم الزمان شهيا",28,"ي",2,0],["أتغدُوا يا كليب معي إذا ما","خلوق القوم يشحذُها الشفار",29,"ر",1,0],["أَتُغفِلَ ريِي بعدما قد غرسْتي","قديماً وساختْ في ثراكَ عروقي",30,"ق",2,0],["اتغيظ ربك باتباع عدوه","وتقول مثلي منه تأتي الزلة",31,"ه",1,0],["أَتُغني غِنانا عَنكُمُ خُرَّمِيَّةٌ","سَواسِيَةٌ تَدعُو عَتُوداً مُزَنَّما",32,"م",2,0],["أتغدو ظُنوني في معاليك ظُلَّما","وتصبِحُ آمالي مبدَّدة النَّظْم",33,"م",1,0],["أَتَغَزُّلاً بَعدَ المَشيبِ وَصَبوَةً","سَفَهاً لِرإيِكَ شائِباً يَتَغَزَّلُ",34,"ل",1,0],["أتُغريها بسفكِ دمي سديفُ","وديني في الهوى الدينُ الحنيفُ",35,"ف",1,1],["أَتُغْرِقُنِي وَلَيْسَ الْماءُ مِنِّي","وَتَحْرُقُنِي وَمِنْ غَيْرِي الضِّرامُ",36,"م",1,0],["أَتغمر أكفائي فيوضُ نوالكم","ويرجع كفّي دونهم مصفرا وقبا",37,"ب",2,0],["أتغنى بآيها كل حين","فهي إعجاز مبدع وهاب",38,"ب",1,0],["أَتَغنيكَ عَن اِبداعِ بِدعَةِ حُسنِ ما","وُصِلَت طَرائِقُهُ بِفنِّ المَوصِلي",39,"ل",2,0],["أتغّنى حينا فتصغي إلى لح","ني مياه الوادي ومرتفعاته",40,"ه",1,0],["أتغفلون عقولا من مواهبها","شعت وعزت وسادت قبل أزمان",41,"ن",1,0],["أتغاضى عن الصديق اجتنابا","حيث لولا الإغضاء عشت خليا",42,"ي",2,0],["أتَغنى بِمديحي","له مُمساىَ وصُبحي",43,"ي",1,0],["أتَغَذَّى بِقَريضٍ","لِفُلانٍ وفُلانِ",44,"ن",1,0],["أتغنَّى وتارة أتعنى","ونظامٌ طوراً وطوراً نثار",45,"ر",1,0]]}