","https://poetry.dctabudhabi.ae/diwan/poem/124653","الكامل"],[4755,"بفَمِي سُؤالٌ شاخَ دُونَ مُبَلِّغٍ","https://www.poetsgate.com/ViewPoem.aspx?id=188571",""],[4809,"هل في القوم من عمر ؟","https://www.poetsgate.com/ViewPoem.aspx?id=201476",""],[4869,"تامرني على شي","https://www.poetsgate.com/ViewPoem.aspx?id=151531",""],[4929,"مجارة لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=199244",""],[4942,"يا طفلتي","https://www.poetsgate.com/ViewPoem.aspx?id=188682",""],[5061,"غريب الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=147175",""],[5100,"بسطة في الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=207704",""],[5122,"الحبيبه","https://www.poetsgate.com/ViewPoem.aspx?id=29716",""],[5183,"نكبات الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=186413",""],[5183,"الحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=186492",""],[5183,"إلى الحسنى","https://www.poetsgate.com/ViewPoem.aspx?id=180186",""],[5205,"أمبكي عيون الصد لا أبكي","https://www.poetsgate.com/ViewPoem.aspx?id=120996",""],[5410,"هواجس على أسوار بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=152248",""],[5447,"غياب","https://www.poetsgate.com/ViewPoem.aspx?id=208361",""],[5464,"طرقنا بابكم فأجاب صمت","https://www.poetsgate.com/ViewPoem.aspx?id=6677",""],[5668,"لم أعشق سواه","https://www.poetsgate.com/ViewPoem.aspx?id=179114",""],[5739,"زوايا الحبر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126878",""],[5753,"كتابي مثقلٌ..","https://www.poetsgate.com/ViewPoem.aspx?id=198538",""],[402,"سلام على الإغريق في أول الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=35730",""],[402,"أسى أن تولى نعمة الله موحشا","https://www.poetsgate.com/ViewPoem.aspx?id=35356",""],[5943,"لوما اعتصامي","https://www.poetsgate.com/ViewPoem.aspx?id=92974",""],[5956,"دعاء","https://www.poetsgate.com/ViewPoem.aspx?id=192541",""],[5956,"هذه الدعابة","https://www.poetsgate.com/ViewPoem.aspx?id=193426",""],[5957,"زارني حرفٌ جميلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=37427",""],[6228,"هي لا تغيب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85979&r=&rc=16",""],[4792,"جَمالٌ ينحتُ القصيدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86320&r=&rc=2",""],[406,"وشم على ذراع الذكرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1120&r=&rc=64",""],[5490,"العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81965&r=&rc=52",""]],"verses":[["أَتَغصِبُ مالِكاً بِذُنوبِ تَيمٍ","لَقَد جِئتَ المَحارِمَ وَاِعتَدَيتا",0,"ت",2,0],["أتغنّيكم القيان بيوم","قام في مأتم به الإسلام",1,"م",1,0],["أَتَغلِبُ ما حُكمُ الأُخَيطَلِ إِذ قَضى","بِعَدلٍ وَلا بَيعُ الأُخَيطَلِ رابِحُ",2,"ح",1,0],["أَتَغضَبُ لَمّا ضَيَّعَ القَينُ عِرضَهُ","وَأَنتَ لِأُمٍّ دونَ ذاكَ مُضيعُ",3,"ع",1,0],["أَتُغفل ريي بعدما قد غرستَني","قديماً وساخت في ثراك عروقي",4,"ق",2,0],["أَتَغضَبُ قَيسٌ أَن هَجَوتُ اِبنَ مِسمَعٍ","وَما قَطَعوا بِالعِزِّ باطِنَ وادي",5,"د",2,1],["أَتغنَّى عليهْ","في رِحابِ الزَّمانْ",6,"ن",1,0],["أَتُغري يَميني بِالسَماحِ فَتَنهَمي","وَلا تَرتَضي خِلّا يَقولُ لَها يَكفي",7,"ف",2,0],["أتغاضى عن وجهها ثم ألقي","من حذار عليه نظرة خلس",8,"س",1,0],["أَتَغلِبُني ذاتُ الدَلالِ عَلى صَبري","إِذَن أَنا أَولى بِالقِناعِ وَبِالخِدرِ",9,"ر",1,1],["أَتَغلِبُ ما أَنتُم لَنا مِثلَنا لَكُم","وَلا الأَمرُ فيما بَينَنا بِمُقارِبِ",10,"ب",1,0],["أَتَغضَبُ أَن أُذنا قُتَيبَةَ حُزَّتا","جِهارَن وَلَم تَغضَب لِيَومِ اِبنِ خازِمِ",11,"م",1,0],["أَتغِلبُ قد حَلَلْتِ به مكاناً","يُريكِ النَّجمَ مُنْخَفِضَ المَكانِ",12,"ن",1,0],["أتغدو إلى عتبات النعيم","بلفح الجحيم وإعصاره",13,"ه",1,0],["أَتَغدوا يا كُلَيبُ مَعي إِذا ما","جَبانُ القَومِ أَنجاهُ الفِرارُ",14,"ر",1,0],["أَتَغدوا يا كُلَيبُ مَعي إِذا ما","حُلوقُ القَومِ يَشحَذُها الشِفارُ",14,"ر",1,0],["أَتَغدو بِهِ في الحَربِ قَبلَ اِتِّغارِهِ","وَفي الخَطبِ قَد أَعيا الأَولى مُصمَئِلُّهُ",15,"ل",2,0],["أَتغضبون إذا لم يَرْضَ باطلَكم","قاضٍ من الحقِّ تَرضَى حكمه الأُمَمُ",16,"م",1,0],["أَتُغضِبُكُم حَمِيَّةُ كُلِّ حُرٍّ","تُهَيِّجُهُ المُروءَةُ وَالوَفاءُ",17,"ا",2,0],["أتغزو رسولَ الله أن هدَّ بأسُه","من الكفر سدّاً ما رأى مثله سدّا",18,"د",2,0],["أَتَغضَبُ أَن يُساقَ القَهدُ فيكُم","فَمَن يَبكي لِأَهلِ الساجِسِيِّ",19,"ي",1,0],["أَتَغدو لِلحَديثِ إِلى فَقيهٍ","وَتَنظُرُ في الحَلالِ وَفي الحَرامِ",20,"م",1,0],["أَتَغضَبُ أَن تُدعى لَئيماً مُذَمَّماً","وَحَسبُكَ لُؤماً أَنَّ والِدَكَ الدَهرُ",21,"ر",1,0],["أَتَغسِلُ جِسمِيَ مِمّا بِهِ","وَقَلبِيَ أَحوَجُ أَن تَغسِلَه",22,"ل",2,0],["أتُغصَبُ من أهلها أرضهُم","وتُسْلمُ للغير نهباً حلالا",23,"ل",2,0],["أتُغوين بالشعر شيطانَه","خياليةٌ أنتِ أم شاعرهْ",24,"ه",1,0],["أَتَغتَرُّ تَيمٌ بِالرَجيمَةِ وَاِبنِها","كَما اِغتَرَّ كَعبٌ بِالمُلَمَّعَةِ القَفرِ",25,"ر",1,0],["أَتَغْنِ فَتِيلاً مِنْ عَزِيزٍ وَقَدْ ثَوَى","دُمُوعٌ بِهَا الأَرْوَاحُ مُنْسَفِكَاتُ",26,"ت",1,0],["أَتَغْدَو مَقَرّاً لِلضَّبَابِ سَمَاؤُهُمْ","وَقَدْماً هِيَ الْمِرْآةُ لِلشَّمْسِ وَالبَدْرِ",27,"ر",1,0],["أتغنين ذكرياتي وكانت","كوثرا في فم الزمان شهيا",28,"ي",2,0],["أتغمده عن عبد شمس وحزبها","ويلفح حزب الله منه سعير",29,"ر",1,0],["أتغدُوا يا كليب معي إذا ما","خلوق القوم يشحذُها الشفار",30,"ر",1,0],["أَتُغفِلَ ريِي بعدما قد غرسْتي","قديماً وساختْ في ثراكَ عروقي",31,"ق",2,0],["اتغيظ ربك باتباع عدوه","وتقول مثلي منه تأتي الزلة",32,"ه",1,0],["أَتُغني غِنانا عَنكُمُ خُرَّمِيَّةٌ","سَواسِيَةٌ تَدعُو عَتُوداً مُزَنَّما",33,"م",2,0],["أتغدو ظُنوني في معاليك ظُلَّما","وتصبِحُ آمالي مبدَّدة النَّظْم",34,"م",1,0],["أَتَغَزُّلاً بَعدَ المَشيبِ وَصَبوَةً","سَفَهاً لِرإيِكَ شائِباً يَتَغَزَّلُ",35,"ل",1,0],["أتُغريها بسفكِ دمي سديفُ","وديني في الهوى الدينُ الحنيفُ",36,"ف",1,1],["أَتُغْرِقُنِي وَلَيْسَ الْماءُ مِنِّي","وَتَحْرُقُنِي وَمِنْ غَيْرِي الضِّرامُ",37,"م",1,0],["أَتغمر أكفائي فيوضُ نوالكم","ويرجع كفّي دونهم مصفرا وقبا",38,"ب",2,0],["أتغنى بآيها كل حين","فهي إعجاز مبدع وهاب",39,"ب",1,0],["أَتَغنيكَ عَن اِبداعِ بِدعَةِ حُسنِ ما","وُصِلَت طَرائِقُهُ بِفنِّ المَوصِلي",40,"ل",2,0],["أتغّنى حينا فتصغي إلى لح","ني مياه الوادي ومرتفعاته",41,"ه",1,0],["أتغفلون عقولا من مواهبها","شعت وعزت وسادت قبل أزمان",42,"ن",1,0],["أتغاضى عن الصديق اجتنابا","حيث لولا الإغضاء عشت خليا",43,"ي",2,0],["أتَغنى بِمديحي","له مُمساىَ وصُبحي",44,"ي",1,0],["أتَغَذَّى بِقَريضٍ","لِفُلانٍ وفُلانِ",45,"ن",1,0],["أتغنَّى وتارة أتعنى","ونظامٌ طوراً وطوراً نثار",46,"ر",1,0],["أتغنّى فيستجيب ليَ الحُسْ","نُ، ويشدو بصبوتي أترابي",47,"ب",2,0],["أَتَغدو بِمُستَنِّ العُيونِ مُخَيِّماً","وَأَنتَ بِعَينِ العالَمينَ مُوَكَّلُ",48,"ل",1,1],["أتغابي عن معشري وسيبدو","لهم في الغداة منا الغبي",49,"ي",1,0],["أَتَغْفُل والذَّرُّ يُحْصى عَلَيْكَ","فَلَيْتَكَ في الدرِّ لا كنْتَ كُنْتا",50,"ت",2,0],["أتغدو مقاصير النبي حواسراً","وآكلة الأكباد يحجبها قصر",51,"ر",1,0],["أتغنّى مع الطيور وأنساب","عبيراً مع النسيم الحنون",52,"ن",1,0],["أتغضبُ أن يُقال أبوك عفٌ","وتَرْضى أن يُقال أبوك زانِ",53,"ن",1,1],["أتغضي وقد عز أنف الضلال","وأنف الرشاد له مذعن",54,"ن",1,0],["أتَغَافَلَ البَوَّابُ أمْ سَبِقَتْ لَهُ","قَبلَ الهُجُومِ يَدٌ مَعَ العَسَّاسِ",55,"س",1,0],["أتغضي وفي الطف ساداتها","يجرعها الصاب انذالها",56,"ل",3,0],["اتغضي وفي كربلا قد غدت","ضحايا على الترب أبطالها",56,"ل",3,0],["أتغضي وعين عقيلاتها","مذاب الحشاشة ارسالها",56,"ل",3,0],["اتغضي ةمن سجفت خدرها ال","سيوف المواضي وعسالها",56,"ل",3,0],["أتغضبين لقولٍ قلته عرضاً","ما كنتُ فيه مسيءَ الظن والفكر",57,"ر",1,1],["أَتغضي فِداك الخَلق عَن أَعين عبرى","تود بِأَن تَحظى بطلعتك الغَرا",58,"ر",2,1],["أَتغضي وَأَجفان النَواصب قَد غَفَت","وَلَم يَرقَبوا أَمناً وَأَجفاننا سَهرا",58,"ر",2,0],["أَتغضي وَذي أَرزاؤكُم قَد تَتابَعَت","فَجايعها في كُل آن لَنا تَتَرى",58,"ر",2,0],["أَتغضي وَذاك المَجتَبى سَبط أَحمَد","سَقَتهُ الأَعادي السم حَتّى قَضى قَهرا",58,"ر",2,0],["أَتغضي وَقَد حامَت عَن الدين عُصبة","قَضَت في عراص الطف أَكبادها حرا",58,"ر",2,0],["أَتغضي وَقَد أَضحى الحسين بكربلا","وَحيداً وفي خيل العِدى غَصَت الغَبرا",58,"ر",2,0],["أَتغضي وَقَد نادى الحسين أُمية","يذكرها الأُخرى فَلَم تَنفَع الذِكرى",58,"ر",2,0],["أَتغضي وَقَد أَضحى لِفهر بكربلا","عَميد بسيف الشمر أَو داجه تَفرى",58,"ر",2,0],["أَتغضي وَقَد أَضحى الحسين مجدلا","وَمِنهُ عَوادي الخَيل هشمت الصَدرا",58,"ر",2,0],["أَتغضي وَشمر حزَّ نحر ابن فاطم","وَكان يَشمُّ المُصطَفى ذَلِكَ النَحرا",58,"ر",2,0],["أَتغضي وَهاتيك الب