{"poems":[[93,"جلست إليها والترام يعدو","https://www.aldiwan.net/poem8793.html","عموديه"],[47,"لوت بالسلام بنانا خضيبا","https://www.aldiwan.net/poem10668.html","المتقارب"],[92,"تحية العيد أو الملك والإنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=178948",""],[170,"بعدت وما حكم البعاد بعادل","https://www.aldiwan.net/poem46895.html","الطويل"],[280,"تلك الجزيرة أقبلت تنويها","https://www.aldiwan.net/poem25414.html","الكامل"],[422,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[435,"ساقي المدام فزند الشوق قد قدحا","https://www.aldiwan.net/poem40532.html","البسيط"],[438,"زهرن فاعجب لروض ماله زهر","https://www.aldiwan.net/poem12341.html","البسيط"],[447,"هذا الفراق وهكذا التوديع","https://www.aldiwan.net/poem14378.html","الكامل"],[463,"أَصاب أو أخطأني راميا","https://www.aldiwan.net/poem55810.html","السريع"],[520,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[592,"على دارس الأطلال بالمتحلب","https://www.aldiwan.net/poem11503.html","عموديه"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66798","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38232","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38227","الطويل"],[865,"","https://poetry.dctabudhabi.ae/diwan/poem/100580","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77495","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77569","المجتث"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59126","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124723","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201690","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110071","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110024","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110085","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95321","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77089","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117296","الكامل"],[4518,"","https://poetry.dctabudhabi.ae/diwan/poem/81222","الطويل"],[5573,"سالفة وجد","https://www.poetsgate.com/ViewPoem.aspx?id=200346",""],[5894,"في الجفن كسر تحته تضعيفي","https://www.poetsgate.com/ViewPoem.aspx?id=131429",""]],"verses":[["فَكَالطَودِ إِلّا أَنَّ ذَيّاكَ ثابِتٌ","وَكَالريحِ إِلّا أَنَّ هاتيكَ لا تَبدو",0,"د",2,0],["فَكَالسَيفِ إِن جِئتَهُ صارِخاً","وَكَالبَحرِ إِن جِئتَهُ مَستَثيبا",1,"ب",2,0],["فكَّ العراق من الحماية تحيه","وامداد لسورّيا يد الإسعاد",2,"د",1,0],["فكالبحرِ إلاّ أنّهُ غيرُ آسنٍ","وكالبدرِ إلا أنَّهُ غيرُ آفِلِ",3,"ل",1,0],["فَكَّ الرقابَ صَنائِعا مذْ قامَ لَمْ","يَنْفَكَّ يأْنِيها كَمَا يُؤنِيها",4,"ي",3,0],["فكالمسجد الأَقصى وأيّ تشبّه","تطوفُ من الأَملاك طائفة به",5,"ه",1,0],["فكال خمارها من دنه ذهباً","وكلته فضةً تاللَه ما ربحا",6,"ح",2,0],["فكالمواعِظِ سَهْلٌ صَوْغُها زُبُرٌ","وكالحديدِ ثقيلٌ وَزْنُهُ زُبَر",7,"ر",1,0],["فكألف شهرٍ يا لها من ليلةٍ","ولها أتيح الفائز المسموع",8,"ع",1,0],["فكالشجا قافية في اللَّها","تماكسُ الحاذِرَ والراقيا",9,"ي",2,0],["فك النفاق عن النعماء أيديهم","من بعد ما نشبت في عروة النشب",10,"ب",1,0],["فكالعلم السفار جادله الصبا","أو الهيف مذعور بغضفاء سبسب",11,"ب",1,0],["فكال له حبّاً به ثمّ ردَّه","إليه وأرزاق العباد تقسَّمُ",12,"م",1,0],["فَكَالشَّمسِ إِن يطلُعْ على الطّرفِ ضَوؤها","فَمِنهُ يكلُّ الطرفُ قَطعاً ويضعفُ",13,"ف",1,0],["فَكالشَّمسِ تَحبو النّاسَ كلَّ ضِيائِها","وَتَحجبُه عَنهم بِوقتِ الغروبِ",14,"ب",1,0],["فكالغيث أو كالليث تحتشي وترتجي","أبى اللَه إلا أن تضر وتنفعا",15,"ع",2,0],["فَكّ الحِمارُ قَيده وَجاء","فَظَنه المَولى يُريدُ الماء",16,"ا",2,0],["فُك الشرك وَافتح الباب","وَاعمل مَعايه جَميله",17,"ه",1,0],["فَكَالْوَرْدِ إنْ يَفْتَرَّ وَالوُرْقِ إنْ شَدَا","وكَاللَّيْثِ إن يَشْتَطَّ والظَّبْي إنْ يَعْطُ",18,"ط",1,0],["فك البسيط من مديد يخلف","عن وضعه مستفلعن ويوصف",19,"ف",1,0],["فك المديد من بسيط قد عرف","من فاعلن مس فاعلاتن عنه صفا",19,"ف",2,0],["فكالرباع الحقُّ في سنه","عن كل خمسين إذا تربعُ",20,"ع",1,0],["فكُّ الكهارب من دنياك محكمةً","أخفّ من فك ما في النفس من جشع",21,"ع",1,0],["فكالحيَّات كُن فَطِناً حكيماً","وكن أبداً وديعاً كالحَمامِ",22,"م",1,0],["فكالبهائِم يرعى في الثرى عُشباً","وفي البِحارِ مع الأَسماك يشتركُ",23,"ك",1,0],["فكالليثِ لكن دونَ نشبِ اظافرٍ","وكالغيثِ لكن دونَ بَسر الغمائِمِ",24,"م",1,0],["فكّ الحبيس فعفِّروا","في الترب تعفير الحبس",25,"س",1,0],["فَكالَ لِأَهلِ الدينِ مِنهُ حُقوقُهُم","وَزادَ بِأَوساق عَلَيها أَتى العَد",26,"د",1,0],["فك الشباب رموزها فتصعدت","زفرات ملتهب الضلوع تلهفا",27,"ف",2,0],["فَكَالبَدر اِشرافا وَكَالرَوض نَفحَة","وَكَالشَمس اِن لاحَت وَكَالظَبى اِن رَنا",28,"ن",2,0],["فك القلم عاني شكا ضيق ملهوف","بين الحروف وبين شكواه ميثاق",29,"ق",1,1],["فك العويص بفكره وبحزمه","عار من التفنيد والتعنيف",30,"ف",1,0]]}