{"poems":[[51,"يا رب شوهاء لجوج الزنا","https://www.aldiwan.net/poem63995.html","السريع"],[89,"اني افكر في الطبيعة فاحصا","https://www.aldiwan.net/poem44850.html","الكامل"],[66,"لا تجزعن إذا ارتاعوا لرائحة","https://www.aldiwan.net/poem39213.html","البسيط"],[105,"سائلوا الأبطال هل ملوا الكفاحا","https://www.aldiwan.net/poem42054.html","الرمل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85372","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142048","الرمل"],[270,"هذا البنفسج فيه قد لمع الندى","https://www.aldiwan.net/poem35297.html","الكامل"],[270,"أبكي على الصيف كالباكي على الطلل","https://www.aldiwan.net/poem35661.html","البسيط"],[364,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[432,"للكاتب الشيخ عين مسها عمش","https://www.aldiwan.net/poem12705.html","البسيط"],[458,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[461,"أسدي البأس عذري الوفا","https://www.aldiwan.net/poem16229.html","الرمل"],[465,"من لي ببغداد","https://www.aldiwan.net/poem36225.html","عموديه"]],"verses":[["للكحل والغُمرة في وجهها","والجُلَّجوناتِ شهادات زورْ",0,"ر",1,0],["للكون ابعاد ولست بعارف","ماذا تكون نهاية الابعاد",1,"د",1,0],["لِلكَلبِ وَالضَبِّ أَفواهٌ مُعَطَّرَةٌ","وَاللَيثُ وَالصَقرُ مَوصوفانِ بِالبَخَرِ",2,"ر",1,0],["للِكريمِ الحُرِّ من أخلاقهِ","معقلٌ لا يبتغي عنه بَراحا",3,"ح",2,0],["لِلكيمياءِ مِنَ العَجائِبِ عِندَهُم","سِرٌّ يُريكَ تَفَوُّقَ الإِنسانِ",4,"ن",1,0],["لِلكَلبِ عَن عَرَقِهِ هَريرُ","وَأَنا عَن طِلابِها مَثبورُ",5,"ر",1,0],["لِلكَون فيما بدا لي","ظواهر وَخَفايا",6,"ي",2,0],["للكَون أزمان تدو","ر عليه من ماضٍ وآت",7,"ت",1,0],["للكرام الصيد سالت أنفسٌ","في مغانيها فهل تجمدُ نفسي",8,"س",2,0],["للكأسِ مثلُ الثَّدي عهدُ رضاعةٍ","فأنا أخوكَ بها وأنتَ المُفتدَى",9,"د",2,0],["للكلّ نعمتُهُ تُرجى ورحمتُه","وعَرفُه ناعشٌ كالبرءِ في العِلل",10,"ل",1,0],["لِلكَسرِ نِعمَ الجابِرُ اِستِرفادُهُ","فَلا وَهيَ مِن ناصِرٍ مُسَدِّدِ",11,"د",1,0],["للكاتبِ الشيخِ عينٌ مسّها عمشٌ","كأنّها كوّةٌ دارتْ بها النحْلُ",12,"ل",1,1],["للكَلمِ المعتاصِ من سلطانهم","عليه ما للجحفل المنقادِ",13,"د",1,0],["للكُماةِ الصِّيدِ والكُومِ ضُحىً","ودُجىً إِن عَنَّ مَحْلٌ وَوهَلْ",14,"ل",1,0],["لِلكِبرياءِ..لأفعال ِالرِّجال ِبِها","إلا الرَّمادي .. هَنيئا ًلِلمَيامين ِ!",15,"ن",1,0]]}