{"poems":[[53,"يا رب شوهاء لجوج الزنا","https://www.aldiwan.net/poem63995.html","السريع"],[91,"اني افكر في الطبيعة فاحصا","https://www.aldiwan.net/poem44850.html","الكامل"],[68,"لا تجزعن إذا ارتاعوا لرائحة","https://www.aldiwan.net/poem39213.html","البسيط"],[107,"سائلوا الأبطال هل ملوا الكفاحا","https://www.aldiwan.net/poem42054.html","الرمل"],[107,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[52,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85372","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142048","الرمل"],[275,"هذا البنفسج فيه قد لمع الندى","https://www.aldiwan.net/poem35297.html","الكامل"],[275,"أبكي على الصيف كالباكي على الطلل","https://www.aldiwan.net/poem35661.html","البسيط"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[438,"للكاتب الشيخ عين مسها عمش","https://www.aldiwan.net/poem12705.html","البسيط"],[463,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[466,"أسدي البأس عذري الوفا","https://www.aldiwan.net/poem16229.html","الرمل"],[470,"من لي ببغداد","https://www.aldiwan.net/poem36225.html","عموديه"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38371","الخفيف"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145612","السريع"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25317","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79844","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79985","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128000","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123187","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96025","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94317","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200584","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204734","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68022","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89210","الكامل"],[3471,"","https://poetry.dctabudhabi.ae/diwan/poem/56425","الرجز"],[3598,"","https://poetry.dctabudhabi.ae/diwan/poem/198749","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125833","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73332","الدوبيت"],[4752,"هَٰذي البُلَاد كَأَهْلهَا السُّخَفَا...","https://www.poetsgate.com/ViewPoem.aspx?id=208566",""],[4799,"دعوة إلى الفرح ( لا للأحزان )","https://www.poetsgate.com/ViewPoem.aspx?id=12265",""],[4916,"للذاكره روح وامسحني","https://www.poetsgate.com/ViewPoem.aspx?id=157794",""],[5038,"هذي بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=189564",""],[5186,"\"أو هل عرفت \"\"أبا الركب\"\"\"","https://www.poetsgate.com/ViewPoem.aspx?id=156544",""],[5187,"تشرين","https://www.poetsgate.com/ViewPoem.aspx?id=29703",""],[5397,"أبسفح حاجر منك يسفح محجر","https://www.poetsgate.com/ViewPoem.aspx?id=157963",""],[5431,"نرجو الخلاص وبالعدالة نحلم","https://www.poetsgate.com/ViewPoem.aspx?id=186898",""],[5436,"للكرامات دربنا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177708",""],[5573,"بشت الزفاف","https://www.poetsgate.com/ViewPoem.aspx?id=200323",""],[5574,"مشاهداتٌ من روضةِ الباري","https://www.poetsgate.com/ViewPoem.aspx?id=206021",""],[5732,"انادم اللي رفقته ترفع الراس","https://www.poetsgate.com/ViewPoem.aspx?id=177830",""],[5818,"للكونِ ربٌّ سميعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=193174",""],[192,"ما أظن","https://www.poetsgate.com/ViewPoem.aspx?id=16325",""],[5956,"الأديان والطوائف المتآزرة","https://www.poetsgate.com/ViewPoem.aspx?id=192650",""],[161,"قصيدة شكر وعرفان لآل العروض الرقمي","https://www.poetsgate.com/ViewPoem.aspx?id=166365",""],[6053,"تِلْكَ الرِّسَالَةُ ... !","https://www.poetsgate.com/ViewPoem.aspx?id=197035",""],[6100,"الصمان","https://www.poetsgate.com/ViewPoem.aspx?id=52551",""],[6142,"طيفٌ لوصلك يقصيه تحلقه","https://www.poetsgate.com/ViewPoem.aspx?id=155676",""],[2220,"الحكمُ حكمُ الجبرِ والاضطرارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11469&r=&rc=343",""]],"verses":[["للكحل والغُمرة في وجهها","والجُلَّجوناتِ شهادات زورْ",0,"ر",1,0],["للكون ابعاد ولست بعارف","ماذا تكون نهاية الابعاد",1,"د",1,0],["لِلكَلبِ وَالضَبِّ أَفواهٌ مُعَطَّرَةٌ","وَاللَيثُ وَالصَقرُ مَوصوفانِ بِالبَخَرِ",2,"ر",1,0],["للِكريمِ الحُرِّ من أخلاقهِ","معقلٌ لا يبتغي عنه بَراحا",3,"ح",2,0],["لِلكيمياءِ مِنَ العَجائِبِ عِندَهُم","سِرٌّ يُريكَ تَفَوُّقَ الإِنسانِ",4,"ن",1,0],["لِلكَلبِ عَن عَرَقِهِ هَريرُ","وَأَنا عَن طِلابِها مَثبورُ",5,"ر",1,0],["لِلكَون فيما بدا لي","ظواهر وَخَفايا",6,"ي",2,0],["للكَون أزمان تدو","ر عليه من ماضٍ وآت",7,"ت",1,0],["للكرام الصيد سالت أنفسٌ","في مغانيها فهل تجمدُ نفسي",8,"س",2,0],["للكأسِ مثلُ الثَّدي عهدُ رضاعةٍ","فأنا أخوكَ بها وأنتَ المُفتدَى",9,"د",2,0],["للكلّ نعمتُهُ تُرجى ورحمتُه","وعَرفُه ناعشٌ كالبرءِ في العِلل",10,"ل",1,0],["لِلكَسرِ نِعمَ الجابِرُ اِستِرفادُهُ","فَلا وَهيَ مِن ناصِرٍ مُسَدِّدِ",11,"د",1,0],["للكاتبِ الشيخِ عينٌ مسّها عمشٌ","كأنّها كوّةٌ دارتْ بها النحْلُ",12,"ل",1,1],["للكَلمِ المعتاصِ من سلطانهم","عليه ما للجحفل المنقادِ",13,"د",1,0],["للكُماةِ الصِّيدِ والكُومِ ضُحىً","ودُجىً إِن عَنَّ مَحْلٌ وَوهَلْ",14,"ل",1,0],["لِلكِبرياءِ..لأفعال ِالرِّجال ِبِها","إلا الرَّمادي .. هَنيئا ًلِلمَيامين ِ!",15,"ن",1,0],["لِلكَريمِ اِبنِ الأَسعدِ الشّهمِ صيتٌ","مَلَأ الدّنيا وَهوَ صيتٌ حميدُ",16,"د",1,1],["للكبد الظمآن وقت الخرّ","نظمتها عقدا بالازدواج",17,"ج",1,0],["للكحل والغمرة في وجهها","والطيب والزين شهادات زور",18,"ر",1,0],["لِلْكَرْبِ فِي يَوْمِ الوَغَى المَوَّاجِ","أَحْسَابُكُمْ فِي اليُسْرِ وَالإِلْفاجِ",19,"ج",1,0],["للكشط سكينٌ عريضُ الصدرِ","قوِّر به مقدارَ دون الحِبرِ",20,"ر",1,0],["للكرخ ناعمةَ الهبوب تحمّلي","منّي سلاماً من نسيمك أطيبا",21,"ب",2,0],["للكرام الأكفّ تحسب فيهنَّ","يذوبُ الغمامُ يوم السخاء",22,"ا",2,0],["للكاس رقص وللابريق قهقهة","منها جرى الدمع من عينيه وانسفحا",23,"ح",2,0],["للكرم أوراق تروق وعنب","يُرمَى نُوَاه إذ غدا مأكولا",24,"ل",2,0],["للكون من أنفاسهم طيب الشذا","ارجا كجيب الغادة المعطار",25,"ر",1,0],["للكاتب العذارء ثم التوأمان","وللزبرقان وحيد السرطان",26,"ن",1,0],["للكتب يحتاج من لا","يعي كتابَ الوجود",27,"د",1,0],["للكون كنت أقول شعري كله","فحصرته بهواك يا مستأثر",28,"ر",1,0],["للكونِ من بحرِ السرورِ تَدفُّقُ","منه تُعَلُّ الكائناتُ وتُغْبَقُ",29,"ق",1,1],["للكتخدى الجاه الخديوي نزهت","بالمدح فيه فكرتي وحواسي",30,"س",2,0],["لَلْكَلبُ خَيْرٌ أدباً","من بَعْضِ أَهْلِ الأَدَبِ",31,"ب",1,0],["للكل آجال، فإن أجل أتى","لا نستطيع تأخرا وتقدما",32,"م",2,0],["للكلب يفري اللحم والعظاما","والنار إذ تذكو لك اضطراما",33,"م",2,0],["للكلب يفري اللحم والعظاما","لكنما الكلاب لم تدن إلى",33,"ل",2,0],["للكر لا زادٌ قبيل القفول","نؤجل الأدبة حتى المغيب",34,"ب",1,0],["للكل يبدون وجهاً من وجوههم","كأَوجه صففت بالهند في صنم",35,"م",1,0],["لِلكَرمِ يَدٌ صَنيعُها مَشكورٌ","عِندي أَبداً وَفَضلُها مَشهورُ",36,"ر",1,1],["لِلْكَادِحِينَ شَقَاءَهَا وَلِمَن","يَجتَزُّ لَحمَ نُهُودهَا التَّرَفَا",37,"ف",2,0],["للكذب لو حطوا ملايين الألوان","ما فيه أجمل من كلام الصراحه",38,"ح",2,0],["للكون ...جهاته... الاربع","وللذاكره...( روح )...وامسحني",39,"ن",2,0],["لِلْكائِناتِ حقوقٌ في مَناهِجِنا","لكنّها هُدرَتْ في عُرْفِ مَنْ ساسُوا",40,"س",3,0],["للكرش يحرق دهنه","والشحم، يذهب في لهب",41,"ب",1,0],["للكفرِ صولةُ عاجزٍ في ساحها","والنّصرُ جاء من السماء مغرِّدا",42,"د",2,0],["للكوكب الساري تقول مشيرة","والطرف منها شاخص متحير",43,"ر",1,0],["للكُرْد آياتٌ أضاعت سفْرها","ليلٌ جريحٌ والشتات..مخيمُ",44,"م",1,1],["للكرد أحزانٌ ينوء بها الفضا","ء كأنهم في الهم بئرٌ مظلم",44,"م",1,0],["للكرامات دربنا أنْ تموتا","فأحمل العمر فوقه تابوتا",45,"ت",2,1],["للكواكيب دري دليل المسافر قبل لايضيع","مثل هادي دليل اللبيب اللذي لجل يامن يخاف",46,"ف",1,0],["١٠- للكعبةِ الغرّاء أهدى قُبلةً","في ثغْرِها الزّاهي بِوَمْضٍ سرْمدِ",47,"د",1,0],["للكبر والله ما توشحت بلباس","بكتب التواضع ناجح بتعليمي",48,"م",2,0],["للكونِ ربٌّ سميعٌ شاهدٌ صمد","ووعده الحقّ فليهزء بما يعِد",49,"د",1,1],["للكسر غصنك وانا يمضيبي iiحالي ولضمى اورقي خلق ربي قراح","بسبقك للصبح مليت iiالليالي واتركك في ليل ناسيه iiالصباح",50,"ح",1,0],["للكل نرجو الخير كيف لبعضنا؟","والكون جسمٌ واحدٌ لن يُقْطعا",51,"ع",2,0],["15- للِكُلِّ اِسْمٍ ذِكْرُهُ لاَ يَنْمَحِي","أنوارُ مَبْنًى كَيْفَ لِي أَنْسَاهُ ؟!",52,"ا",2,0],["لِلْكِلْمَةِ الحَسْنَاءِ فِتْنَتُهَا","سِحْرٌ يُزَيِّنُ لَذَّةَ الفَتْكِ",53,"ك",1,0],["للكمبري به تيش للدفن للسير ..","مراحلٍ عدة تلتها مباني ..",54,"ن",2,0],["للكون من نوره قنديل تبصرةٍ","يضيء مغربه منه ومشرقه",55,"ق",2,0],["للكلِّ هذا ثابتٌ لا تقل","بأنه خاص بنا مُستعار",56,"ر",1,0]]}