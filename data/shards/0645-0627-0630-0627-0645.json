{"poems":[[74,"ماذا من الشوق جناي والأرق","https://www.aldiwan.net/poem19358.html","السريع"],[52,"ماذا منيت بغزال له عنق","https://www.aldiwan.net/poem62281.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85594","المجتث"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85374","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85596","الكامل"],[447,"دع الخمول وخل المقت والكبلا","https://www.aldiwan.net/poem14430.html","البسيط"],[534,"إن رضى كل الورى لا مرا","https://www.aldiwan.net/poem37240.html","السريع"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80236","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52993","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110166","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81703","البسيط"],[4691,"هيفاء ردّي لمن أنحلته ِ عُمُرا ً !!","https://www.poetsgate.com/ViewPoem.aspx?id=60737",""],[5005,"ساحة الظلم..","https://www.poetsgate.com/ViewPoem.aspx?id=189344",""],[5956,"شاعر يدافع عن صديقه","https://www.poetsgate.com/ViewPoem.aspx?id=192463",""]],"verses":[["ماذا من الشوق جناي والأرق","برقٌ على حمص كقلبٍ خفق",0,"ق",1,1],["ماذا مُنيتُ بَغَزّالٍ لَهُ عُنُقٌ","كَنِقنِقِ الدَوِّ إِن وَلّى وَإِن مَثَلا",1,"ل",2,1],["ماذا مَقامي بأرض","لي ما وفت فاجتويت",2,"ت",1,0],["ماذا من التَكريم ير","جو ميت لا يشعر",3,"ر",1,0],["ماذا مقامك يا جميل ببقعة","فيها الحقيقة هزأة الأوهام",4,"م",1,0],["ماذا مقامك في دار تُعَزُّ بها","أَهل الخَنا وتذلّ القادة الفضلا",5,"ل",2,0],["ماذا مَجازُ يُرْتَجى نَيْلُهُ","هَذَا إذا حَقَّقْتَ عَيْنُ الْمُحالْ",6,"ل",1,0],["ماذا مَرادَكِ بِالتَجَنُبِ وَالجَفا","عَطفاً عَلَيَّ فَأَنتِ أَنتِ مُرادي",7,"د",2,0],["ماذا مديحي وهو بدرٌ طالعٌ","يرقى من الجوزاء ذروةَ راسها",8,"س",3,0],["ماذا مِثالُ القولِ من","كُمهٍ لقد حانَ البَصَر",9,"ر",1,0],["ماذا من الحسن في حلٍّ ومُرْتَحَلٍ","حَوَتْهُ تلك الحوايا والمقاصير",10,"ر",1,0],["ماذا من الوعد والإخلاف ِ قد نتجا؟","أرى شقاءً مع الآهات ِ ممتزجا !",11,"ج",2,1],["ماذا من الكلمات ييقى لائقا؟!","سقطت عن الأقوال كل الأقنعة",12,"ع",2,0],["ماذا منحتَ من التبرع بالدِّما","أو بالنقودِ لأيّ شعب يَسْغَبُ؟",13,"ب",1,0]]}