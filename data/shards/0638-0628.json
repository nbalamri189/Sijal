ttps://www.aldiwan.net/poem12482.html","الرجز"],[429,"أهلا بطيف في الدجنة أوبا","https://www.aldiwan.net/poem12551.html","الكامل"],[429,"لولا ظبى تنسل من لحظاته","https://www.aldiwan.net/poem12779.html","الكامل"],[434,"ظبي الصريم حبالي في الهوى صرما","https://www.aldiwan.net/poem2586.html","البسيط"],[436,"لك الله بالنصر العزيز كفيل","https://www.aldiwan.net/poem34919.html","الطويل"],[438,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[441,"ظبي تهاب الأسد موقف طعنه","https://www.aldiwan.net/poem56062.html","عموديه"],[456,"لا لنوازي كبد هاجها","https://www.aldiwan.net/poem56080.html","السريع"],[456,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[456,"لعلك بالشعب تعلو اليفاعا","https://www.aldiwan.net/poem56128.html","المتقارب"],[459,"رعى الله مجدا صاحبيا تنقلت","https://www.aldiwan.net/poem16031.html","الطويل"],[462,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[462,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[462,"أجنها الفكر وأبداها العبق","https://www.aldiwan.net/poem3442.html","عموديه"],[462,"ظباء الحمى حين تعتادها","https://www.aldiwan.net/poem3457.html","عموديه"],[462,"وصل السقام فصد عن لوامه","https://www.aldiwan.net/poem3475.html","عموديه"],[462,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[462,"زحف الصباح وهذه راياته","https://www.aldiwan.net/poem3624.html","عموديه"],[466,"أعطافه فتنة الفتون","https://www.aldiwan.net/poem59629.html","مخلع البسيط"],[466,"أعطى يد الإعجاب منه غنانا","https://www.aldiwan.net/poem59630.html","المتقارب"],[466,"يا قوم لا تأخذوا بثأري","https://www.aldiwan.net/poem60000.html","مخلع البسيط"],[466,"يا لقومي أما لقتلي ثار","https://www.aldiwan.net/poem60033.html","الخفيف"],[466,"زها بصدغ وخد","https://www.aldiwan.net/poem60197.html","المجتث"],[466,"ظبي رقيق حواشي نعمة الجسد","https://www.aldiwan.net/poem60198.html","البسيط"],[466,"أنا في الغدو وفي الرواح","https://www.aldiwan.net/poem60283.html","مجزوء الكامل"],[466,"شاربه فيروزج","https://www.aldiwan.net/poem60318.html","مجزوء الرجز"],[466,"عانقني والدجى كطرته","https://www.aldiwan.net/poem60355.html","الطويل"],[466,"أذهبت فضة خده بعتابي","https://www.aldiwan.net/poem60438.html","الكامل"],[475,"بعد المزار فأنة وتذكر","https://www.aldiwan.net/poem15285.html","الكامل"],[480,"أدر المدامة يا نديم إلى الصباح","https://www.aldiwan.net/poem24333.html","عموديه"],[480,"ظبي خزّ بلحاظه","https://www.aldiwan.net/poem24369.html","عموديه"],[480,"أرقني سقم النوى","https://www.aldiwan.net/poem24549.html","عموديه"],[512,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[512,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[512,"ظبي إذا ما رنا منه الأسود ترتهب","https://www.aldiwan.net/poem20918.html","المواليا"],[512,"ظبي قبض بالهوى مني الحواس رهون","https://www.aldiwan.net/poem20920.html","المواليا"],[513,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[513,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[513,"أفدي معذب مهجتي أفديه","https://www.aldiwan.net/poem12303.html","الكامل"],[536,"مقلة عيني نظرت","https://www.aldiwan.net/poem48128.html","عموديه"],[549,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[556,"ظن الجهول بأنه مستيقظ","https://www.aldiwan.net/poem33543.html","الكامل"],[565,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[565,"وروضة مسبغة الأصداغ","https://www.aldiwan.net/poem69598.html","الرجز"],[565,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[565,"طلعت كالقمر التم بدر","https://www.aldiwan.net/poem69676.html","الرمل"],[573,"من ذا الذي من مقلتيه يقيني","https://www.aldiwan.net/poem2839.html","الكامل"],[573,"ظبي بحسمي حالي الجيد بالعطل","https://www.aldiwan.net/poem2890.html","البسيط"],[573,"ظبي بمصر نسيت منه","https://www.aldiwan.net/poem2908.html","مجزوء الكامل"],[573,"يا ويح نفس عشقت","https://www.aldiwan.net/poem2982.html","مجزوء الرجز"],[573,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"],[573,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[584,"لحاظ الظبا تحكى الظبي في المضارب","https://www.aldiwan.net/poem17435.html","الطويل"],[584,"لا أسهر الله طرفا نام عن سهري","https://www.aldiwan.net/poem17535.html","البسيط"],[584,"أسير ألحاظ بخد أسيل","https://www.aldiwan.net/poem17692.html","السريع"],[584,"ظبي له في كل قلب هوى","https://www.aldiwan.net/poem17985.html","السريع"],[584,"قمر رأيت الكون ضاء ببشره","https://www.aldiwan.net/poem17995.html","الكامل"],[584,"أتراه لما جار في أخلاقه","https://www.aldiwan.net/poem18007.html","الكامل"]],"verses":[["ظَبيٌ بِرامَةَ كُحلُهُ مِن طَرفِهِ","يَرمي القُلوبَ وَحَليُهُ مِن جيدِهِ",0,"ه",1,1],["ظَبيٍ غَريرٍ يَزينُهُ شَنَفٌ","لا بَل بِهِ قَد تَزَيَّنَ الشَنَفُ",1,"ف",1,0],["ظَبيَةٌ مِن ظِباءِ بَطنِ خُسافٍ","أُمُّ طِفلٍ بِالجَوِّ غَيرِ رَبيبِ",2,"ب",1,0],["ظَبيَةٌ مِن ظِباءِ وَجرَةَ أَدما","ءُ تَسَفُّ الكَباثَ تَحتَ الهَدالِ",3,"ل",1,0],["ظَبيَ الحِمى بِاللَهِ ما ضَرَّكا","إِذا رَأَينا في الكَرى طَيفَكا",4,"ك",2,1],["ظَبيَةٌ تُخجِلُ الغَزالَةَ وَجهاً","وَبَهاءً وَتَفضَحُ الغُصنَ قَدّا",5,"د",2,0],["ظَبيٌ مِنَ الأَتراكِ تَثني قَدَّهُ","ريحُ الصَبا وَيُعيدُهُ لينُ الصِبى",6,"ب",2,0],["ظِباءُ خَريفٍ حَشَّت السَدرَ خُضَّع","ثَنى سِربَها أَطفالُهُنَّ العَوالِكُ",7,"ك",1,0],["ظبي إذا شمت خدَّيه ومقلته","أذابَ لاهبهُ قلبي وفاتره",8,"ر",2,0],["ظباء بشطّي نيل مصر لأجلها","يقولُ حنين الشوق آهاً على مصر",9,"ر",1,0],["ظبيٌ إلى القاني له نسبةٌ","واحرباً من خدِّه القاني",10,"ي",1,0],["ظبيٌ تبسم عن درٍّ ومرجان","وكان يكفي على الخدَّين مرجاني",11,"ي",1,0],["ظبيٌ كأنَّ اللَّه كمَّل حسنَهُ","ليغيظ سِرْباً أوْ يُكايدَ رَبْرَبَا",12,"ب",2,0],["ظَبْيُكَ يا ذا حَسَنٌ وجهُهُ","وما سِوى ذاك جميعاً يُعابْ",13,"ب",1,1],["ظبي دعتْنيَ عيناهُ ومنطقُهُ","بِنيَّةٍ صدقتْ عن ظاهرٍ عبِثِ",14,"ث",1,0],["ظَبْيٌ أُصِحَّ وأُمرضتْ ألحاظُه","والحسن حيث مِراضه وصحاحُه",15,"ح",2,0],["ظبْيةٌ تَصطاد من طافتْ به","ربَّما طاف بك الظبْيُ الصَّيُودُ",16,"د",1,0],["ظبيةٌ تسكن القلوب وترعا","ها وُقمْرِيَّةٌ لها تغريدُ",17,"د",1,0],["ظبيٌ غريرٌ كأنَّ ريقَتَهُ","نكْهَةُ خمْر نُزِّلَ في بَرَد",18,"د",1,0],["ظبيٌ دعا قلبَ هائمٍ كلفٍ","مؤتمِرٍ قلبُهُ بما أمره",19,"ر",2,0],["ظبيٌ وما الظبي بالشبيه به","في الحسن إلا استراقَه حَوره",19,"ر",2,0],["ظبي يصيد ولا يُصاد مُحاذرٌ","نَبْلَ الهوى وحبَائل الإيناس",20,"س",1,0],["ظبيٌ كأن بخصره","من ضُمره ظمأً وجوعا",21,"ع",2,0],["ظبيٌ يرى كُلَّ وجهٍ من مَخاتلنا","ونَدَّريه فنعْمى عن مَخاتِلِهِ",22,"ل",2,0],["ظبيةٌ إن عطتْ جنتْ ثمراتٍ","من قلوبٍ ولم تنُشْ غصنَ ضالِ",23,"ل",1,0],["ظبيٌ كأن كناسه مما ترى","فيه دماءَ العاشقين عَرينُ",24,"ن",1,0],["ظَبيٌ رَأى صورَتَهُ في الماءِ","فَرَفَعَ الرَأسَ إِلى السَماءِ",25,"ا",2,1],["ظِباؤُهُ المُنكَسِراتُ الظُبا","يَغلِبنَ ذا اللُبِّ عَلى لُبِّهِ",26,"ب",2,0],["ظَبْيُ أُنْسٍ قَلبي مَقِيلُ ضُحاهُ","وفُؤَادِي بَرِيرُهُ وكَبَائُهْ",27,"ه",1,0],["ظبيٌ غريرٌ إِذا حاولتُ غِرَّتَهُ","أرسلتُ طرفيَ سَهْماً وانثَنى غَرَضا",28,"ض",2,0],["ظِباءٌ ثَناها الشَيبُ وَحشاً وَقَد تُرى","لِرَيعِ الشَبابِ وَهيَ جِدُّ أَوانِسِ",29,"س",1,0],["ظَبياتُ أُنسٍ صَيدُهُنَّ مُحَرَّمٌ","يَرتَعنَ ما بَينَ الصَفا فَعُكاظِ",30,"ظ",1,0],["ظَبظابُها أَلَمُ المَسيرِ وَوَقعُها","بِيَدَي حُداةٍ في المَسيرِ غِلاظِ",30,"ظ",1,0],["ظَبيٌ نَبا سَيفُ صَبري في مَحَبَّتِهِ","وَطِرفُ عَزمي بِمَيدانِ السُلُوِّ كَبا",31,"ب",2,0],["ظِباءٌ سَوانِحٌ وَوُرقٌ صَوادِحٌ","وَقُضبٌ نَوافِحٌ وَغُدرٌ طَوافِحُ",32,"ح",1,0],["ظَبيٌ مِنَ الأَتراكِ لَيسَ بِتارِكٍ","حُسناً لِمَخلوقٍ أَتى مِن بَعدِهِ",33,"د",2,0],["ظَبيٌ مِنَ الأَتراكِ فَوقَ خُدودِهِ","نارٌ يَخُرُّ لَها الكَليمُ وَيُصعَقُ",34,"ق",1,0],["ظُباكَ بالردّ عن دين الهُدى انفرَدَتْ","وأنتَ ما زلتَ بالإنعامِ مُنْفَرِدا",35,"د",2,0],["ظبيةٌ في العقد إمّا التفتَتْ","ومهاة حين ترنو في النقاب",36,"ب",1,0],["ظَبيٌ يَتيهُ بِوِردِهِ في خَدِّهِ","خَدٌّ عَلَيهِ غَلائِلٌ مِن وَردِهِ",37,"د",2,1],["ظَبيٌ تَقَنَّصتُهُ لَمّا نَصَبتُ لَهُ","في آخِرِ اللَيلِ أَشراكاً مِنَ الحُلُمِ",38,"م",1,0],["ظَبيٌ تُزَيِّنُهُ عَوارِضُهُ","وَالعَينُ زَيَّنَ لَحظَها كُحُلُه",39,"ل",2,0],["ظَبيَةٍ مِن وَحشِ ذي بَقَرٍ","شَأنُها الغَيطانُ وَالغُدُرُ",40,"ر",1,0],["ظُبىً طَرَقَتْ جَماجِمَهم بَياتاً","وما خِيفَ الطُّروقُ ولا البَياتُ",41,"ت",1,0],["ظَبيٌ مِن العربِ سَبَا مُهجَتِي","بِوفرةٍ تُشرِقُ فَوق الجَبِين",42,"ن",1,1],["ظَبيٌ يَصِيدُ بِألحَاظٍ بِهَا مَرضٌ","قَلب الكَمِيّ ولا يُصطَادُ بِالحِيَلِ",43,"ل",1,0],["ظَبيٌ إذَا مَا رَنَا أو هَزَّ عُودَ نَقَا","أجرَى قَنَاةَ الدّمَا بِالبِيضِ وَالسُّمُرِ",44,"ر",1,0],["ظَبيٌ لَهُ صورَةٌ في الحُسنِ قَد قُسِمَت","بَينَ الكَثيبِ وَبَينَ الغُصنِ وَالقَمَرِ",45,"ر",1,0],["ظَبيٌ يُجاهِرُ بِالقِلى","تيهاً عَلى ذُلّي وَقَسوا",46,"و",2,0],["ظَبيُ إِنسٍ فاتِرِ الأَل","حاظِ ذي جَفنٍ كَحيلِ",47,"ل",1,0],["ظَبيٌ مُخَلّى مِنَ الأَحزانِ أَوقَرَهُ","ما يَعلَمُ اللَهُ مِن حُزنٍ وَمِن قَلَقِ",48,"ق",1,0],["ظَبيٌ يَرى طَرفَهُ فَيَرجُمُهُ","وَهوَ سِوى ذاكَ لَيثُ عِرّيسِ",49,"س",1,0],["ظَبيَةٌ فَرَّغَت خَيالَكَ مِنها","لَم يَدُم عَهدُها كَما عَهِدتا",50,"ت",2,0],["ظَبيٌ بِمَبكاهُ وَمَضحَكِهِ","فينا تُنيرُ وَتُظلِمُ الدُنيا",51,"ا",1,0],["ظَبياً يَميلُ التَصابي","عَلَيهِ مِن كُلِّ جانِب",52,"ب",1,0],["ظَبيٌ كَأَنَّ الثُرَيّا فَوقَ جَبهَتِهِ","وَالمُشتَري في بُيوتِ السَعدِ وَالسُرُجا",53,"ج",2,0],["ظَبيٌ كَأَنَّ اللَهَ أَل","بَسَهُ قُشورَ الدُرِّ جِلدا",54,"د",2,0],["ظَبيٌ لَهُ مِن قُلوبِ الناسِ نابِتَةٌ","مِنَ المَوَدَّةِ تُجني أَطيَبَ الثَمَرِ",55,"ر",1,0],["ظَبيٌ عَلَيهِ مَلاحَةٌ","عُنِيَت بِطَلعَتِهِ العُيونُ",56,"ن",1,0],["ظبيٌ أعارَ الزمانَ مقلتَهُ","كأنّهُ في جمالهِ وثَنُ",57,"ن",1,0],["ظَبيٌ لَهُ وَجْنَةٌ مِنْ رِقَّةٍ","تَجْرَحُها مُقْلَتي إذ تَلْحَظُ",58,"ظ",1,0],["ظَبْية دُونَ الصَّبايا قُصِّصَتْ","فأَتَتْ غَيْداءَ في شَكْل الصَّبي",59,"ب",2,0],["ظبي قضى كل زيدٍ في محبته","وما قضى من ليالي وصله وطره",60,"ر",2,0],["ظَبْيُ حِمىً مُذْ غَرَبَتْ شَمْسُهُ","عَنْ نَاظِرِي بِالْبَيْنِ مَا غَمَّضَا",61,"ض",2,0],["ظَبَيَات فِي نُمْرَقٍ رَائِعَاتٌ","وَرِيَاضٌ نُضْرٌ مِنْ السَّجَّادِ",62,"د",1,0],["ظباءٌ يخافُ الشرك فيها أخو الهوى","وقد خُلِقَت نفسُ المحبين عابده",63,"د",2,1],["ظُبى المَنايا مغلباتٍ","عَلى ظبىً سَلَّها الكِظاظُ",64,"ظ",1,0],["ظبي كِناسٍ وَلَيثُ غابٍ","سيّان هَل يَنفَعُ اِحتِفاظُ",64,"ظ",1,0],["ظُباتُ الهَوى وَالهَجر وَالعَذل وَالنَوى","وَواشٍ وَغَيران عَلَيَّ حَفيظُ",65,"ظ",1,0],["ظَبيات وَادي النيربين وَسفحِهِ","المُشبهات بِهِ الغُصون المَيسا",66,"س",2,0],["ظبي على مسكينه حاكم","وجأر في كل أفعاله",67,"ل",2,0],["ظبية تجعل الملوك أسارى","وكفى بالجمال جيشاً جريا",68,"ي",2,0],["ظبية تجعل الأسود أساري","والأمير الخطير عبداً مطيعا",69,"ع",2,0],["ظبيٌ غريرُ الحُسنِ طُرَّزَ خدَّهُ","بالجلنار وغضَّ نورَ السوسنِ",70,"ن",1,0],["ظبيات وادي السير هل نفرت","من سربكن الظبية السمرا",71,"ر",2,0],["ظبْيٌ مراعيه الحشا عجباً له","ردَّ الشموس بنوره وبِسَعده",72,"د",2,0],["ظِباءُ البطاح لها مَصَرعٌ","وعُصْمٌ لها بالجبالِ اعتصامُ",73,"م",1,0],["ظُبىً تَقُدُّ الطُلى تُؤَيِّدُها","عَزائِمٌ في دُجى الوَغى تَقِدُ",74,"د",1,0],["ظُباكَ لا شَكَّ مِن آرائِهِ طُبِعَت","فَما أَراقَت دَماً إِلّا مَضى هَدَرا",75,"ر",2,0],["ظبي حكى الآس المنضَّد وفرةً","والورد خدا والأقاح مقبّلا",76,"ل",2,0],["ظُبَا الحُبِّ قد سَلَّت عَلَى القَلبِ بِيضَها","وَحُكمُ الهَوى مُذ كانَ حُكمٌ مُغَلَّظُ",77,"ظ",1,0],["ظَبْيٌ مِنَ الإِنْسِ ولَكِنَّهُ","قَدْ فاقَ في الحُسنِ عَلى البَدْرِ",78,"ر",1,0],["ظَبْيٌ غَدا طَرْفي لهُ ناظِراً","لَمَّا رأى قَلْبيَ مِنْ جُنْدِهِ",79,"د",2,0],["ظبي من الإِنس تعلقته","ومرّ ما يلوى على من رما",80,"م",2,0],["ظبي ملا قلبي هموما وشجا","وما قضى لي أربا ولا شجن",81,"ن",1,0],["ظَبيَةٌ يَكنَفُها في ال","أَلمَجِيّاتِ الرَفيفُ",82,"ف",1,0],["ظبيٌ غَريرٌ غرَّني حُسنُهُ","أخافُ منهُ وعليهِ أخافُ",83,"ف",1,0],["ظباءٌ لَها في النَّفْس أَمْرٌ مُحَكَّمٌ","وَغَمٌّ جِريُّ الْجَوْرِ في الْبِسْط وَالْقَبْضِ",84,"ض",1,0],["ظَبْيَةٌ حَفّتْ بِروحي كالرّؤى","وَسَبَتْني نَحْوَ هامِ الأكَمِ",85,"م",1,0],["ظبيتي رُحماكِ قلبي ما سلا","خافقٌ في خيفةٍ قد أوجسا",86,"س",2,0],["ظبيٌ تناسبَ في الملاحةِ شَخْصُه","فالوصفُ حتى يطول فيه وجيز",87,"ز",1,0],["ظَبيٌ كَسا رَأسي المُشبَّبَ بِعارِضٍ","نَمّ العِذارُ بِحافَتَيهِ وَلاحا",88,"ح",2,1],["ظَبيٌ يَحارُ البَرقُ عَن بَريقِهِ