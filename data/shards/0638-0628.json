{"poems":[[53,"ظبي برامة كحله من طرفه","https://www.aldiwan.net/poem30497.html","الكامل"],[55,"يا شمس بغداد إنني دنف","https://www.aldiwan.net/poem26231.html","المنسرح"],[9,"من ديار بالهضب هضب القليب","https://www.aldiwan.net/poem21913.html","الخفيف"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[86,"ظبي الحمى بالله ما ضركا","https://www.aldiwan.net/poem10930.html","السريع"],[71,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[71,"يا ظالماً جعل القطيعة مذهبا","https://www.aldiwan.net/poem4020.html","الكامل"],[35,"شجا قلبه أظعان سعدى السوالك","https://www.aldiwan.net/poem39121.html","الطويل"],[72,"سقى حماك من الوسمي باكره","https://www.aldiwan.net/poem18704.html","البسيط"],[72,"وقائع حب حار في كرها فكري","https://www.aldiwan.net/poem18705.html","الطويل"],[72,"لا تسألوا في الحب عن شاني","https://www.aldiwan.net/poem20152.html","السريع"],[72,"تناسبت المحاسن يا لبينا","https://www.aldiwan.net/poem20200.html","الوافر"],[51,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[51,"ظبيك يا ذا حسن وجهه","https://www.aldiwan.net/poem8673.html","السريع"],[51,"استغفر الله من تركي علانية","https://www.aldiwan.net/poem9216.html","البسيط"],[51,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[51,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[51,"ألف بين الفؤاد والكمد","https://www.aldiwan.net/poem61956.html","المنسرح"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"وهبت له عيني الهجوعا","https://www.aldiwan.net/poem65049.html","مجزوء الكامل"],[51,"يا من أغار عليه من غلائله","https://www.aldiwan.net/poem65939.html","البسيط"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"يا من هواه من القلوب مكين","https://www.aldiwan.net/poem66463.html","الكامل"],[85,"ظبي رأى صورته في الماء","https://www.aldiwan.net/poem8043.html","الرجز"],[85,"إثن عنان القلب واسلم به","https://www.aldiwan.net/poem63782.html","السريع"],[56,"إن ريب الزمان طال انتكائه","https://www.aldiwan.net/poem58624.html","الخفيف"],[62,"يا صاحبي أعيناني على سكن","https://www.aldiwan.net/poem52364.html","البسيط"],[45,"يشوقك توخيد الجمال القناعس","https://www.aldiwan.net/poem64574.html","الطويل"],[66,"ظفرت سهام فواتر الألحاظ","https://www.aldiwan.net/poem38485.html","الكامل"],[66,"ما ماس منعطفا في قرطق وقبا","https://www.aldiwan.net/poem39203.html","البسيط"],[66,"إذا لم تعني في علاك المدائح","https://www.aldiwan.net/poem41360.html","الطويل"],[66,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[66,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[80,"جلا محياك عن أبصارنا الرمدا","https://www.aldiwan.net/poem31474.html","البسيط"],[80,"غيرته غير الدهر فشاب","https://www.aldiwan.net/poem31541.html","الرمل"],[44,"ظبي يتيه بورده في خده","https://www.aldiwan.net/poem30258.html","الكامل"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[31,"يا نعم قد طالت مماطلتي","https://www.aldiwan.net/poem41843.html","الكامل"],[31,"يا خليلي هاجني الذكر","https://www.aldiwan.net/poem42511.html","المديد"],[105,"أمنك فزارة انبعث الغزاة","https://www.aldiwan.net/poem43992.html","الوافر"],[81,"ظبي من العرب سبا مهجتي","https://www.aldiwan.net/poem61304.html","السريع"],[81,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[81,"وافى وفي جيده عقد من الدرر","https://www.aldiwan.net/poem61359.html","البسيط"],[81,"من منصفي من سقيم الطرف ذي حور","https://www.aldiwan.net/poem61520.html","البسيط"],[52,"يا صاحبي شيبت عفوا","https://www.aldiwan.net/poem26585.html","مجزوء الكامل"],[52,"من لأذني بعذول","https://www.aldiwan.net/poem26728.html","مجزوء الرمل"],[52,"أباح عيني لطول الليل والأرق","https://www.aldiwan.net/poem26794.html","البسيط"],[52,"إشرب بكأس من كف طاووس","https://www.aldiwan.net/poem26915.html","المنسرح"],[52,"يا غزال الوادي بنفسي أنتا","https://www.aldiwan.net/poem27216.html","الخفيف"],[48,"أفنيت فيك معاني الشكوى","https://www.aldiwan.net/poem10422.html","الكامل"],[48,"إن البلية سدت علي طرق المذاهب","https://www.aldiwan.net/poem10824.html","المجتث"],[48,"سماه مولاه لاستملاحه السمجا","https://www.aldiwan.net/poem62489.html","البسيط"],[48,"غاد الهوى بالكأس بردا","https://www.aldiwan.net/poem62591.html","مجزوء الكامل"],[48,"لا كان أحسن ممن قال ملتفتا","https://www.aldiwan.net/poem63328.html","البسيط"],[48,"مولاي عز فلا يهون","https://www.aldiwan.net/poem66121.html","مجزوء الكامل"],[48,"أحسن مما تضمن العطن","https://www.aldiwan.net/poem66595.html","المنسرح"],[76,"يا ساحرا طرفه إذ يلحظ","https://www.aldiwan.net/poem39275.html","مجزوء البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30442","الرمل"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/40678","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42669","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142055","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43844","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43646","الطويل"]],"verses":[["ظَبيٌ بِرامَةَ كُحلُهُ مِن طَرفِهِ","يَرمي القُلوبَ وَحَليُهُ مِن جيدِهِ",0,"ه",1,1],["ظَبيٍ غَريرٍ يَزينُهُ شَنَفٌ","لا بَل بِهِ قَد تَزَيَّنَ الشَنَفُ",1,"ف",1,0],["ظَبيَةٌ مِن ظِباءِ بَطنِ خُسافٍ","أُمُّ طِفلٍ بِالجَوِّ غَيرِ رَبيبِ",2,"ب",1,0],["ظَبيَةٌ مِن ظِباءِ وَجرَةَ أَدما","ءُ تَسَفُّ الكَباثَ تَحتَ الهَدالِ",3,"ل",1,0],["ظَبيَ الحِمى بِاللَهِ ما ضَرَّكا","إِذا رَأَينا في الكَرى طَيفَكا",4,"ك",2,1],["ظَبيَةٌ تُخجِلُ الغَزالَةَ وَجهاً","وَبَهاءً وَتَفضَحُ الغُصنَ قَدّا",5,"د",2,0],["ظَبيٌ مِنَ الأَتراكِ تَثني قَدَّهُ","ريحُ الصَبا وَيُعيدُهُ لينُ الصِبى",6,"ب",2,0],["ظِباءُ خَريفٍ حَشَّت السَدرَ خُضَّع","ثَنى سِربَها أَطفالُهُنَّ العَوالِكُ",7,"ك",1,0],["ظبي إذا شمت خدَّيه ومقلته","أذابَ لاهبهُ قلبي وفاتره",8,"ر",2,0],["ظباء بشطّي نيل مصر لأجلها","يقولُ حنين الشوق آهاً على مصر",9,"ر",1,0],["ظبيٌ إلى القاني له نسبةٌ","واحرباً من خدِّه القاني",10,"ي",1,0],["ظبيٌ تبسم عن درٍّ ومرجان","وكان يكفي على الخدَّين مرجاني",11,"ي",1,0],["ظبيٌ كأنَّ اللَّه كمَّل حسنَهُ","ليغيظ سِرْباً أوْ يُكايدَ رَبْرَبَا",12,"ب",2,0],["ظَبْيُكَ يا ذا حَسَنٌ وجهُهُ","وما سِوى ذاك جميعاً يُعابْ",13,"ب",1,1],["ظبي دعتْنيَ عيناهُ ومنطقُهُ","بِنيَّةٍ صدقتْ عن ظاهرٍ عبِثِ",14,"ث",1,0],["ظَبْيٌ أُصِحَّ وأُمرضتْ ألحاظُه","والحسن حيث مِراضه وصحاحُه",15,"ح",2,0],["ظبْيةٌ تَصطاد من طافتْ به","ربَّما طاف بك الظبْيُ الصَّيُودُ",16,"د",1,0],["ظبيةٌ تسكن القلوب وترعا","ها وُقمْرِيَّةٌ لها تغريدُ",17,"د",1,0],["ظبيٌ غريرٌ كأنَّ ريقَتَهُ","نكْهَةُ خمْر نُزِّلَ في بَرَد",18,"د",1,0],["ظبيٌ دعا قلبَ هائمٍ كلفٍ","مؤتمِرٍ قلبُهُ بما أمره",19,"ر",2,0],["ظبيٌ وما الظبي بالشبيه به","في الحسن إلا استراقَه حَوره",19,"ر",2,0],["ظبي يصيد ولا يُصاد مُحاذرٌ","نَبْلَ الهوى وحبَائل الإيناس",20,"س",1,0],["ظبيٌ كأن بخصره","من ضُمره ظمأً وجوعا",21,"ع",2,0],["ظبيٌ يرى كُلَّ وجهٍ من مَخاتلنا","ونَدَّريه فنعْمى عن مَخاتِلِهِ",22,"ل",2,0],["ظبيةٌ إن عطتْ جنتْ ثمراتٍ","من قلوبٍ ولم تنُشْ غصنَ ضالِ",23,"ل",1,0],["ظبيٌ كأن كناسه مما ترى","فيه دماءَ العاشقين عَرينُ",24,"ن",1,0],["ظَبيٌ رَأى صورَتَهُ في الماءِ","فَرَفَعَ الرَأسَ إِلى السَماءِ",25,"ا",2,1],["ظِباؤُهُ المُنكَسِراتُ الظُبا","يَغلِبنَ ذا اللُبِّ عَلى لُبِّهِ",26,"ب",2,0],["ظَبْيُ أُنْسٍ قَلبي مَقِيلُ ضُحاهُ","وفُؤَادِي بَرِيرُهُ وكَبَائُهْ",27,"ه",1,0],["ظبيٌ غريرٌ إِذا حاولتُ غِرَّتَهُ","أرسلتُ طرفيَ سَهْماً وانثَنى غَرَضا",28,"ض",2,0],["ظِباءٌ ثَناها الشَيبُ وَحشاً وَقَد تُرى","لِرَيعِ الشَبابِ وَهيَ جِدُّ أَوانِسِ",29,"س",1,0],["ظَبياتُ أُنسٍ صَيدُهُنَّ مُحَرَّمٌ","يَرتَعنَ ما بَينَ الصَفا فَعُكاظِ",30,"ظ",1,0],["ظَبظابُها أَلَمُ المَسيرِ وَوَقعُها","بِيَدَي حُداةٍ في المَسيرِ غِلاظِ",30,"ظ",1,0],["ظَبيٌ نَبا سَيفُ صَبري في مَحَبَّتِهِ","وَطِرفُ عَزمي بِمَيدانِ السُلُوِّ كَبا",31,"ب",2,0],["ظِباءٌ سَوانِحٌ وَوُرقٌ صَوادِحٌ","وَقُضبٌ نَوافِحٌ وَغُدرٌ طَوافِحُ",32,"ح",1,0],["ظَبيٌ مِنَ الأَتراكِ لَيسَ بِتارِكٍ","حُسناً لِمَخلوقٍ أَتى مِن بَعدِهِ",33,"د",2,0],["ظَبيٌ مِنَ الأَتراكِ فَوقَ خُدودِهِ","نارٌ يَخُرُّ لَها الكَليمُ وَيُصعَقُ",34,"ق",1,0],["ظُباكَ بالردّ عن دين الهُدى انفرَدَتْ","وأنتَ ما زلتَ بالإنعامِ مُنْفَرِدا",35,"د",2,0],["ظبيةٌ في العقد إمّا التفتَتْ","ومهاة حين ترنو في النقاب",36,"ب",1,0],["ظَبيٌ يَتيهُ بِوِردِهِ في خَدِّهِ","خَدٌّ عَلَيهِ غَلائِلٌ مِن وَردِهِ",37,"د",2,1],["ظَبيٌ تَقَنَّصتُهُ لَمّا نَصَبتُ لَهُ","في آخِرِ اللَيلِ أَشراكاً مِنَ الحُلُمِ",38,"م",1,0],["ظَبيٌ تُزَيِّنُهُ عَوارِضُهُ","وَالعَينُ زَيَّنَ لَحظَها كُحُلُه",39,"ل",2,0],["ظَبيَةٍ مِن وَحشِ ذي بَقَرٍ","شَأنُها الغَيطانُ وَالغُدُرُ",40,"ر",1,0],["ظُبىً طَرَقَتْ جَماجِمَهم بَياتاً","وما خِيفَ الطُّروقُ ولا البَياتُ",41,"ت",1,0],["ظَبيٌ مِن العربِ سَبَا مُهجَتِي","بِوفرةٍ تُشرِقُ فَوق الجَبِين",42,"ن",1,1],["ظَبيٌ يَصِيدُ بِألحَاظٍ بِهَا مَرضٌ","قَلب الكَمِيّ ولا يُصطَادُ بِالحِيَلِ",43,"ل",1,0],["ظَبيٌ إذَا مَا رَنَا أو هَزَّ عُودَ نَقَا","أجرَى قَنَاةَ الدّمَا بِالبِيضِ وَالسُّمُرِ",44,"ر",1,0],["ظَبيٌ لَهُ صورَةٌ في الحُسنِ قَد قُسِمَت","بَينَ الكَثيبِ وَبَينَ الغُصنِ وَالقَمَرِ",45,"ر",1,0],["ظَبيٌ يُجاهِرُ بِالقِلى","تيهاً عَلى ذُلّي وَقَسوا",46,"و",2,0],["ظَبيُ إِنسٍ فاتِرِ الأَل","حاظِ ذي جَفنٍ كَحيلِ",47,"ل",1,0],["ظَبيٌ مُخَلّى مِنَ الأَحزانِ أَوقَرَهُ","ما يَعلَمُ اللَهُ مِن حُزنٍ وَمِن قَلَقِ",48,"ق",1,0],["ظَبيٌ يَرى طَرفَهُ فَيَرجُمُهُ","وَهوَ سِوى ذاكَ لَيثُ عِرّيسِ",49,"س",1,0],["ظَبيَةٌ فَرَّغَت خَيالَكَ مِنها","لَم يَدُم عَهدُها كَما عَهِدتا",50,"ت",2,0],["ظَبيٌ بِمَبكاهُ وَمَضحَكِهِ","فينا تُنيرُ وَتُظلِمُ الدُنيا",51,"ا",1,0],["ظَبياً يَميلُ التَصابي","عَلَيهِ مِن كُلِّ جانِب",52,"ب",1,0],["ظَبيٌ كَأَنَّ الثُرَيّا فَوقَ جَبهَتِهِ","وَالمُشتَري في بُيوتِ السَعدِ وَالسُرُجا",53,"ج",2,0],["ظَبيٌ كَأَنَّ اللَهَ أَل","بَسَهُ قُشورَ الدُرِّ جِلدا",54,"د",2,0],["ظَبيٌ لَهُ مِن قُلوبِ الناسِ نابِتَةٌ","مِنَ المَوَدَّةِ تُجني أَطيَبَ الثَمَرِ",55,"ر",1,0],["ظَبيٌ عَلَيهِ مَلاحَةٌ","عُنِيَت بِطَلعَتِهِ العُيونُ",56,"ن",1,0],["ظبيٌ أعارَ الزمانَ مقلتَهُ","كأنّهُ في جمالهِ وثَنُ",57,"ن",1,0],["ظَبيٌ لَهُ وَجْنَةٌ مِنْ رِقَّةٍ","تَجْرَحُها مُقْلَتي إذ تَلْحَظُ",58,"ظ",1,0],["ظَبْية دُونَ الصَّبايا قُصِّصَتْ","فأَتَتْ غَيْداءَ في شَكْل الصَّبي",59,"ب",2,0],["ظبي قضى كل زيدٍ في محبته","وما قضى من ليالي وصله وطره",60,"ر",2,0],["ظَبْيُ حِمىً مُذْ غَرَبَتْ شَمْسُهُ","عَنْ نَاظِرِي بِالْبَيْنِ مَا غَمَّضَا",61,"ض",2,0],["ظَبَيَات فِي نُمْرَقٍ رَائِعَاتٌ","وَرِيَاضٌ نُضْرٌ مِنْ السَّجَّادِ",62,"د",1,0],["ظباءٌ يخافُ الشرك فيها أخو الهوى","وقد خُلِقَت نفسُ المحبين عابده",63,"د",2,1],["ظُبى المَنايا مغلباتٍ","عَلى ظبىً سَلَّها الكِظاظُ",64,"ظ",1,0],["ظبي كِناسٍ وَلَيثُ غابٍ","سيّان هَل يَنفَعُ اِحتِفاظُ",64,"ظ",1,0],["ظُباتُ الهَوى وَالهَجر وَالعَذل وَالنَوى","وَواشٍ وَغَيران عَلَيَّ حَفيظُ",65,"ظ",1,0]]}