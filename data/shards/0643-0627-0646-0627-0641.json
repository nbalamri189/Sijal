{"poems":[[79,"السعد جندك والقضاء دليل","https://www.aldiwan.net/poem36373.html","الكامل"],[87,"أفي هذا الشباب تعف نفس","https://www.aldiwan.net/poem7776.html","الوافر"],[46,"أألله إني خالد بعد خالد","https://www.aldiwan.net/poem30315.html","الطويل"],[76,"وسرحة خاض منها ظلها نهرا","https://www.aldiwan.net/poem12897.html","البسيط"],[77,"قد أكمل الله في ذا السيف حليته","https://www.aldiwan.net/poem69069.html","البسيط"],[48,"أقاتلي الزمان قصاص عمد","https://www.aldiwan.net/poem22628.html","الوافر"],[48,"أمذهبة التراس لرد كيد","https://www.aldiwan.net/poem22839.html","الوافر"],[48,"إذا ما ألحدت أمم بجهل","https://www.aldiwan.net/poem23000.html","الوافر"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[113,"كغصني بانة بتنا اعتناقا","https://www.aldiwan.net/poem16573.html","الوافر"],[199,"لمن رسم دار كالكتاب المنمنم","https://www.aldiwan.net/poem54416.html","الطويل"],[203,"رويدا إنما الأيام سفر","https://www.aldiwan.net/poem45665.html","الوافر"],[266,"أراحمة قلبي وقد شفني الصبر","https://www.aldiwan.net/poem38281.html","الطويل"],[327,"بان الخليط فشطوا بالرعابيب","https://www.aldiwan.net/poem56349.html","البسيط"],[422,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[445,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[463,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[469,"دعينا إلى سبت اليهود فلم نجد","https://www.aldiwan.net/poem3320.html","عموديه"],[558,"قد اطلعت على سري وإعلاني","https://www.aldiwan.net/poem68419.html","البسيط"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90629","الكامل"],[1656,"","https://poetry.dctabudhabi.ae/diwan/poem/131360","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48221","الطويل"],[2136,"","https://poetry.dctabudhabi.ae/diwan/poem/203567","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28557","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100362","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200559","البسيط"],[3239,"","https://poetry.dctabudhabi.ae/diwan/poem/145264","المنسرح"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74048","الطويل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75686","البسيط"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[5431,"بُلينا في منافينا بُلينا","https://www.poetsgate.com/ViewPoem.aspx?id=196450",""],[5561,"رحيلُ الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=192742",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[6124,"يشاطر الهدب دمعتي","https://www.poetsgate.com/ViewPoem.aspx?id=121832",""],[6142,"القسط والعدل هزا يوم بيعته","https://www.poetsgate.com/ViewPoem.aspx?id=155720",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[5355,"حنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87213&r=&rc=38",""]],"verses":[["كَانَ افْتتَاحُ بَنِي بَشِيرٍ مَبْدَأً","سَبَبُ الْبِشَارَةِ بَعْدَهُ مَوْصُولُ",0,"ل",1,0],["كأنا في التلون قوم موسى","وأنت بنا كما شقى الكليم",1,"م",1,0],["كَأَنّا فَقَدنا أَلفَ أَلفِ مُدَجَّجٍ","عَلى أَلفِ أَلفٍ مُقرَبٍ لا مُباعَدِ",2,"د",1,0],["كَأَنَّ أَفنانَها طيباً حِمى مَلِكٍ","أَغضى وَأَعطى فَلَم يوعِد وَلَم يَعِدِ",3,"د",1,0],["كأنّ أفعى سَقَتْ فولاذَه حُمَةً","وألبَسَتْ جلْدَهُ من وَشيِها نَمَشَا",4,"ش",2,0],["كَأَنّا في بِحارٍ مِن خُطوبٍ","وَلَيسَ يَرى لَها الراؤونَ عِبرا",5,"ر",2,0],["كَأَنّا في السَفائِنِ عائِماتٍ","وَعِندَ المَوتِ أُلقِيَتِ المَراسي",6,"س",2,0],["كَأَنّا في سَجايانا نُقودٌ","كَثيراتُ البَهارِجِ وَالزُيوفِ",7,"ف",1,0],["كأن أفعى نهشت حشاشتي","من لازب الهم وتلهاب الحشا",8,"ا",1,0],["كَأَنا في ضَمير اللَيل سرٌّ","وَلَيسَ سِوى فَتيق المسك فاشي",9,"ي",1,0],["كَأَنَّ أَفاحيصَ القَطا حَيثُ عاجَها","مُعَرَّسُ مَثوىً مِن كَرى اللَيلِ نُيَّمِ",10,"م",1,0],["كأنا في الجحيمِ من تفرى","له جلدٌ تبدل منه جلدُ",11,"د",1,0],["كأن افتراقاً في بنيات نعشها","وقد ضلهن السير في مهمهٍ سفر",12,"ر",1,0],["كَأَنَّ أَفواهَها الإِغريضُ إِذ بَسَمَت","أَو أُقحُوانُ رَبيعٍ ذي أَهاضيبِ",13,"ب",1,0],["كأنَّا في رياض الحزن","لا كُنَّا ولا كانوا",14,"ن",3,0],["كَأَنَّا فِي المَنَازِلِ طَلْعُ نخلٍ","يُوَافِي أَهْلَهُ أَمَدُ الصِّرامِ",15,"م",1,0],["كان افتراقُهما تجمعُّنا","حتى إذا اجتمعا تفرَّقنا",16,"ن",2,0],["كأنَّا في تيه موسى ضلالةٌ","نشرقُ أحياناً وحيناً نغرّبُ",17,"ب",1,0],["كَأَنَّ إِفلاتَها وَالفَجرُ يَأخُذُها","إِفلاتُ صادِرَةٍ عَن قَوسِ حُسبانٍ",18,"ن",1,0],["كان افتتاحُ بلائيَ النَّظرُ","فالحَينُ سبَّبَ ذاكَ والقَدَرُ",19,"ر",1,1],["كان أفاحيص القطا بكديدها","حوافر جرد نهبها قد توقّعا",20,"ع",2,0],["كأنَّ افترارَ الأقحوانِ كواعبٌ","قد ابتسمتْ في وَجْهِ نسوانَ شَيِّقِ",21,"ق",1,0],["كأنا فويق البر أمواج لجةٍ","وكالريح فيهن العتاق الصلادم",22,"م",1,0],["كَأَنَّ أفولَ النَّسرِ طَرف تَعَلَّقَت","بِهِ سِنَةٌ ما هَبَّ مِنها وَلا أَغفى",23,"ف",2,0],["كأن افلتتني ظبية مشرئبةٌ","تلوع وودعت الغزال المغازلا",24,"ل",2,0],["كأن أفكاري اللاّتي تساورني","أراقمٌ نافثاتٌ فيّ وسواسا",25,"س",2,0],["كأن أفواهها إذا انفجرت","أراقم الرمل تلتوي فيها",26,"ي",3,0],["كأنّ أَفاويق الدماء جَداول","تسيل وَأَشلاء الكماة جَواسِقُ",27,"ق",1,0],["كأن أَفلاكها من طول ما تقلبت","ألقَت عَصاها لما لاقَت من التعب",28,"ب",1,0],["كان افتتاني بثغر راق مبسمه","صار افتتاني بثغر فيه سفك دمي",29,"م",2,0],["كأنّا في أيادي الريح دينٌ","وكادَ العصف أن يقضي الديونا",30,"ن",2,0],["كأنّ افتراضا أضاع افتراضا","وصار الزمانُ غبارَ قبور",31,"ر",1,0],["كأن أفعالك الحسناء عندهمُ","أفعى لهم لدغتهم في قلوبهمِ",32,"م",1,0],["كَأَنَّ أَفْنَانَ عِشْقِهَا سَتَشِيْ","غّداً بِوَعْدٍ لِوَصْلِ مُهْجَتِهَا",33,"ت",3,0],["كانا فماتا وهذا اليوم نشرهما","لا تسأل الأرض كم عاما ثووا فيها",34,"ي",3,0],["كَأنَّ أَفكارَهُم مِن طولِ ما شَقِيَت","أَلقَت بأَرواحِهِم في وَهدَةِ الحُطَمِ",35,"م",1,0],["كأنّا في ظلالِ الشوقِ نبقى","يُقيِّدُنا الحَنينُ فلا نسيرُ",36,"ر",1,0]]}