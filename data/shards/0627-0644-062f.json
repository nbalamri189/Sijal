78,"كم دون مسراك من بيد وأخطار","https://www.aldiwan.net/poem15202.html","البسيط"],[480,"وقفوا هناك وحسبهم","https://www.aldiwan.net/poem36960.html","مجزوء الكامل"],[480,"راحة النهى الطرب","https://www.aldiwan.net/poem37059.html","المقتضب"],[480,"حب الحياة من الجنون","https://www.aldiwan.net/poem37178.html","مجزوء الكامل"],[480,"الله أكبر أيها ال","https://www.aldiwan.net/poem37198.html","مجزوء الكامل"],[480,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[480,"قف بالديار ولا تحفل بذي عذل","https://www.aldiwan.net/poem37619.html","البسيط"],[480,"الدهر دهر والرجال رجال","https://www.aldiwan.net/poem37622.html","الكامل"],[480,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[483,"الدهر أعلى بالتنفيس قد سجعت","https://www.aldiwan.net/poem24291.html","البسيط"],[499,"فؤاده بضياء العلم منشرح","https://www.aldiwan.net/poem3697.html","البسيط"],[501,"أي ورد قد شممناه ضحى","https://www.aldiwan.net/poem37781.html","الرمل"],[507,"الدين يشكو بليه","https://www.aldiwan.net/poem2390.html","المجتث"],[516,"بصعود منزلة وجد صاعد","https://www.aldiwan.net/poem12058.html","الكامل"],[516,"الدمع يهمل والفؤاد عليل","https://www.aldiwan.net/poem12226.html","الكامل"],[530,"الدر أهداه لي في المنظر البهج","https://www.aldiwan.net/poem37487.html","البسيط"],[539,"بإيابك الميمون أشرق نور","https://www.aldiwan.net/poem47426.html","عموديه"],[539,"ألم به الوشي فأعرض هازئا","https://www.aldiwan.net/poem47505.html","عموديه"],[539,"دام بقاؤك لنا","https://www.aldiwan.net/poem47918.html","عموديه"],[552,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[552,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[563,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[568,"يا رب نهر مدفإ ملآن","https://www.aldiwan.net/poem69449.html","الرجز"],[587,"أضحى له في اكتئابه سبب","https://www.aldiwan.net/poem17411.html","المنسرح"],[587,"الدمع هام والحشا هائم","https://www.aldiwan.net/poem17702.html","السريع"]],"verses":[["الدارُ عِندي سَكَنٌ","إِذا عَدِمتُ السَكَنا",0,"ن",2,0],["الداخِلينَ البَيتَ باباهُ القَنا","عَلى الخَناذيذِ الطَوالِ وَالحُصُن",1,"ن",1,0],["الدَمعُ أَعظَمُ مَن تُحارِبُ جُرأَةً","فَاِنظُر لِعَينٍ ما أُبيحَ حَريمُها",2,"م",3,0],["الدَمعُ مُذ بَعُدَ الخَليطُ قَريبُ","وَالشَوقُ يَدعو وَالزَفيرُ يُجيبُ",3,"ب",1,1],["الدّجى يهمي … وهذا الحزن يهمي","مطرا من سهده ، يظمى ويظمي",4,"م",2,1],["الدَمعُ يَشهَدُ أنّني لَكِ عاشِقٌ","وَالناسُ قَد عَلِموا وَإِن لَم يَشهدِ",5,"د",1,0],["الدَهرُ يَومانِ ذا أَمنٌ وَذا خَطَرُ","وَالعَيشُ عَيشانِ ذا صَفوٌ وذا كَدَرُ",6,"ر",1,1],["الدّهْرُ أضيقُ فُسحةً في أنْ يُرى","بالحُزْنِ والكَمَدِ المُضاعَفِ يُقطَعُ",7,"ع",1,1],["الدَهرُ عَبدِيَ لَمّا","أَصبَحتُ في الحُبِّ عَبدَك",8,"ك",1,0],["الدينُ وَجهٌ أَنتَ فيهِ غُرَّةٌ","وَالمُلكُ جَفنٌ أَنتَ فيهِ سَوادُ",9,"د",1,0],["الدَهرُ إِن أَملى فَصيحٌ أَعجَمُ","يُعطي اِعتِباري ما جَهِلتُ فَأَعلَمُ",10,"م",1,1],["ألدِّينُ وَالدُّنْيَا أَعَارَهُمْ سَنًى","لَمْ يُزْهَ فِي حَفْلٍ أَجَلَّ وَأَكْرَمِ",11,"م",1,0],["الدَّاخِلِيَّةُ دَوْحَةٌ هَرُمت","وَذَوَتْ نَضَارَتُهَا عَلَى الهَرَمِ",12,"م",1,0],["أَلدينُ لا يَأْبَى الْحَضَارَةَ إِنْ دَعَتْ","فَأَجَابَهَا فِي الرَّاشِدِينَ إِمَامُ",13,"م",1,0],["أَلدَّارُ عَامِرَةٌ كَالْعَهْدِ زَاهِرةٌ","وَالْقَوْمٌ عِنْدَ جَمِيلِ الظَّنِّ بِالْهِمَمِ",14,"م",1,0],["الدنى فإول الشباب","والروض يزهر بالزهر",15,"ر",1,0],["الداء أذهب نفسه تلفا","بذل الدواء له فما نجعا",16,"ع",2,0],["الدينُ مُختَرَمٌ وَالحَقُّ مُهتَضَمُ","وَفَيءُ آلِ رَسولِ اللَهِ مُقتَسَمُ",17,"م",1,1],["الدَهرُ يَومانِ ذا ثَبتٌ وَذا زَلَلُ","وَالعَيشُ طَعمانِ ذا صابٌ وَذا عَسَلُ",18,"ل",1,1],["الدارُ واسِطَةٌ وَالنَخلُ شارِعَةٌ","وَالبيضُ يَرفُلنَ في القَسِّيِّ كَالبَرَدِ",19,"د",1,0],["الدهر نحوي كما ينبغي","يدري الذي يخفض أو يرفع",20,"ع",1,0],["الدهْرُ يُفْسِدُ ما استطاع وأحمدٌ","يتَتَبَّعُ الإفسادَ بالإصلاحِ",21,"ح",1,0],["الدائم العهْدِ ولكنَّه","يصْعد من عهْد إلى عهْدِ",22,"د",1,0],["الدين والعلم والنعماء والشرفُ","تأبى لجارك أن يُمنى له التلفُ",23,"ف",1,1],["الدمع في العين لا نوم ولا نظرٌ","ولا محالة من معنىً له خُلِقا",24,"ق",2,1],["الدقاقُ الخصورِ في هَيَف القدْ","دِ عِراضُ الأعجازِ والأوراك",25,"ك",1,0],["الدَهرَ ماتَنفَكُّ تَندُبُ وُجنَةً","دَرَسَت وَخَدّا مُنهَجَ العِرفانِ",26,"ن",1,0],["الدَهرُ يُفنينا وَنَحسَبُ أَنَّهُ","يُفني بِنا أَيّامَهُ وَلَيالِيَه",27,"ي",2,0],["الدارُ مِن بَعدِكَ قَد أَصبَحَت","في وَحشَةٍ يا مُؤنِسَ الدارِ",28,"ر",1,0],["الديلُ أَذنابُ بَكرٍ حينَ تَنسِبُهُم","وَكُلُّ قَومٍ لَهُم مِن قَومِهِم ذَنَبُ",29,"ب",1,1],["الدهر يقضي ما يشاء قضاءه","من غير ما عدل ولا إجحاف",30,"ف",1,0],["الدهر جار على الآداب يزهقها","وما على الدهر إما جار من عتب",31,"ب",1,0],["الدهر يلقى الامر ممن فوقه","والدهر يقتل من يشاء ولا يدى",32,"د",2,0],["الدهر يعطى سروراً يمنعه","وذلكم منه لا بخل ولا جود",33,"د",1,0],["الدهر قد اوجعنا","بسيفه لما ضرب",34,"ب",1,0],["الدهر قد عاكسنا","وما على الدهر عتب",34,"ب",1,0],["الدين في كل عصر للحياة مضى","قد كان خير صراط للذي نهجا",35,"ج",2,0],["الدين سمح فما ان فيه من عقد","والدين ما كان يستهدى به السلف",35,"ف",1,0],["الدين اسوة من ضيموا ومن حزنوا","والدين سلوة من في عيشهم شظف",35,"ف",1,0],["الدهر فرق شمل جمع ناهض","والدهر يجمع تارة ويفرق",36,"ق",1,0],["الدهر قطب يوم شابت لمتي","وجهاً له قد كان غير مقطب",37,"ب",1,0],["الدين معقل اهله","والدين امنع معقل",38,"ل",1,0],["الدائرات وان حبت","مهلا على الباغي تدور",39,"ر",1,0],["الدين ليس بمحتاج إلى حجج","إذا تمكن من قلب بتلقين",40,"ن",1,1],["الدين والدنيا له","فضل من الله القدير",41,"ر",1,0],["الدُبُّ مَعروفٌ بِسوءِ الظَنِّ","فَاِسمَع حَديثَهُ العَجيبَ عَنّي",42,"ي",1,1],["الدينُ لِلدَيّانِ جَلَّ جَلالُهُ","لَو شاءَ رَبُّكَ وَحَّدَ الأَقواما",43,"م",2,0],["الدينُ وَالوَحيُ وَالأَخلاقُ طائِفَةٌ","مِنهُ وَسائِرُهُ دُنيا وَبُهتانُ",44,"ن",1,0],["الدُرُّ في لَبّاتِهِنَّ مُنَظَّمٌ","وَالطيبُ في حَبراتِهِنَّ مُرَقرَقُ",45,"ق",1,0],["الدَهرُ يَقظانُ وَالأَحداثُ لَم تَنَمِ","فَما رُقادُكُمُ يا أَشرَفَ الأُمَمِ",46,"م",1,1],["الدَهرُ فَرَّقَ شَملَهُنَّ فَمُر بِهِ","يا رَبِّ تَجمَعُهُ يَدُ المِقدارِ",47,"ر",1,0],["الدَهرُ مُعتَذِرٌ وَالسَيفُ مُنتَظِرٌ","وَأَرضُهُم لَكَ مُصطافٌ وَمُرتَبَعُ",48,"ع",1,0],["الدَهرُ يَعجَبُ مِن حَملي نَوائِبَهُ","وَصَبرِ جِسمي عَلى أَحداثِهِ الحُطُمِ",49,"م",1,0],["الدَهرُ أَنصَفُ مِنكَ في أَحكامِهِ","إِذ كانَ يَأخُذُ بَعضَ ما يُعطيكا",50,"ك",2,0],["الدواوين في يدينا طروحٌ","والتعابير كلها إنشاء",51,"ا",2,0],["الدّهرُ يعلَمُ أنني زاحمتُه","بأشدَّ منه في الشّدائد كاهلا",52,"ل",2,0],["الدَهرُ أَدَّبَني وَاليَأَسُ أَغناني","وَالقوتُ أَقنَعَني وَالصَبرُ رَبانّي",53,"ي",1,1],["الدَهرُ يَخنُقُ أَحياناً قِلادَتَهُ","عَلَيكَ لا تَضطَرِب فيهِ وَلا تَثِبِ",54,"ب",1,1],["الدارُ جَنَّةُ خُلدٍ إِن عَمِلتَ بِما","يُرضي الإِلَهَ وَإِن قَصَّرتَ فَالنارُ",55,"ر",1,0],["الدَهرُ يُبرِمُني طَوراً وَيَنقُضُني","فَما بَقائي عَلى الإِبرامِ وَالنَقضِ",56,"ض",1,0],["الدَهرُ يوعِدُ فُرقَةً وَزَوالا","وَخُطوبُهُ لَكَ تَضرِبُ الأَمثالا",57,"ل",2,1],["الدارُ لَو كُنتَ تَدري يا أَخا مَرَحٍ","دارٌ أَمامَكَ فيها قُرَّةُ العَينِ",58,"ن",1,0],["الدَهرُ ذو دُوَلٍ وَالمَوتُ ذو عِلَلٍ","وَالمَرءُ ذو أَمَلٍ وَالناسُ أَشباهُ",59,"ا",2,1],["الدُرُّ لِكَأسِها نِطاقٌ","وَالمِسكُ لِدَنِّها خِتامُ",60,"م",1,0],["الدُموعُ هاطِلَةٌ","وَالضُلوعُ تَلتَهِبُ",61,"ب",1,0],["الدهر دفاق فكي","فَ نعبّ من ماءٍ أسن",62,"ن",1,0],["الدَّهر يحمي ركنَه","والفنُّ في روح البناء",63,"ا",2,0],["الدمار الرهيب والعدم الشام","ل واللفح والضنى والأوار",64,"ر",1,0],["الدّمعُ يَنطقُ واللّسانُ صَموتُ","فانظرْ إلى الحركاتِ كيف تموتُ",65,"ت",1,1],["الدارُ ناطِقَةٌ وَلَيسَت تَنطِقُ","بِدُثورِها أَنَّ الجَديدَ سَيُخلِقُ",66,"ق",1,1],["الدَهرُ يَومٌ وَيَومُ","وَالعَيشُ عُذرٌ وَلَومُ",67,"م",1,1],["الدَهرُ يَسمَحُ بِالَّتي تَهَبُ الغِنى","لِمُؤَمَّلٍ مِن صادِرٍ أَو وارِدِ",68,"د",1,0],["الدينُ شينُ الدينِ قالَ نبينا","فتوقَّهُ واصبرْ على الإقتارِ",69,"ر",1,0],["الداخِلِ البَيتَ الشَديدَ حِجابُهُ","في غَيرِ ميعادٍ أَما يَخشى الرَدى",70,"ا",1,0],["الدّهرُ لا يُعطيك إلا كارهاً","فإذا أبيتَ فإِنَّ رأيك عازبُ",71,"ب",1,0],["الدَّمُ المسفوحُ في آثارهم","يملأ الدُّنيا أنيناً ونُواحا",72,"ح",2,0],["الدّينُ من دُنيا الهَوى وخَبالهِا","للنّفسِ حِرزٌ مانعٌ وعِصامُ",73,"م",1,0],["الدّينُ والدُّنيا وَراءَ ضجيجِه","يستشرفان أيسمعان حَسيسا",74,"س",2,0],["الدّهرُ شاغَبَهُ فأوهنَ عَظمَهُ","وطغَى عليهِ فَزادَ في أعبائِه",75,"ا",3,0],["الدَهرُ نَشوانُ ما ينفكُّ يَقْرَعُنا","بالحادثِ النُّكرِ قَرْعَ الكاس ِبالكاسِ",76,"س",1,0],["الدّهرُ أخرسُ والبلادُ صوامتٌ","والنّاسُ بين تفجُّعٍ وبُكاءِ",77,"ا",2,0],["الدّهرُ يومُ مَذلَّةٍ ومَهانَةٍ","والدَّهرُ يومُ حميَّةٍ وإباءِ",77,"ا",2,0],["الدّينُ والعقلُ لا يُعطِي مَقادَتَهُ","سِواهما كلُّ منهيٍّ ومَأمُورِ",78,"ر",1,0],["الدَهرُ يَنظُرُ وَالأَجيالُ شاهِدَةٌ","وَالحُكمُ لِلَهِ لا خَوفٌ وَلا فَرَقُ",79,"ق",1,0],["الدَهرُ عَينٌ وَالمَمالِكُ أَلسُنٌ","وَالنيلُ قَلبٌ دائِمُ الخَفَقانِ",80,"ن",1,0],["الدَهرُ يَشهَدُ وَالحَوادِثُ أَنَّنا","لِسِوى الوَفاءِ لِقَومِنا لا نُؤثِرُ",81,"ر",1,0],["الدينُ لِلَهِ لا الإِسلامُ يَصرِفُها","عَنِ الحَياةِ وَلا الأَوثانُ وَالصُلُبُ",82,"ب",1,0],["الدَهرُ كَأسُكِ وَالمَمالِكُ كُلُّها","ظَمآى إِلَيكِ وَأَنتِ بِنتُ الحانِ",83,"ن",1,0],["الدَهرُ أَندَلُسٌ وَكُلٌّ ذِكرُها","وَعُهودُ سُكّانٍ لَها وَمَغاني",83,"ن",2,0],["الدَهرُ مُغتَسِلٌ مِن ذَنبِهِ بِدَمٍ","وَالأَرضُ بِالنارِ ذاتِ الهَولِ تَحتَرِقُ",84,"ق",1,0],["الدينُ في أَمرٍ وَنَهيٍ واحِدٌ","وَاللَهُ جَلَّ جَلالُهُ المَعبودُ",85,"د",1,0],["الدينُ لِلَهِ العَلِيِّ وَإِنَّما","دينُ الحَياةِ تَوَدُّدٌ وَوِئامُ",86,"م",1,0],["الدامِياتِ مَناسِماً وَغَوارِباً","المُدمِياتِ جَوانِحاً وَمَآقِيا",87,"ي",2,0],["الدّينُ مختلفٌ وليس لنا سِوَى","ما كان أورثَنا الزمانُ الأقدم",88,"م",1,0],["الدهرُ معمورٌ بذكرِكَ آهلٌ","ما في جوانبِهِ مكانٌ بلقعُ",89,"ع",1,0],["الدين يجمعُ ليس منّا من يرى","في أهله عَرَباً ويعرفُ روما",90,"م",2,0],["الدّينُ دينُ الهدى تبدو شرائعُهُ","بِيضاً تَكشَّفُ عن أنوارها الظلمُ",91,"م",1,0],["الدينُ يعطفُ والسماحةُ تحتفِي","والحبُّ يرعَى والمروءةُ تكفلُ",92,"ل",1,0],["الدينُ ناداكُم وَفَوقَ سُروجِكُم","غَوثُ الصَريخِ وَبُغيَةُ المُستَنصِرِ",93,"ر",1,0],["الدارُ أَعرِفُها رُبىً وَرُبوعا","لَكِن أَساءَ بِها الزَمانِ صَنيعا",94,"ع",2,1],["الدارُ أَطبَقَ إِخراسٌ عَلى فيها","وَاِعتاقَها صَمَمٌ عَن صَوتِ داعي