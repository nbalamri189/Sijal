["الدول العظمى","دولة الماء ولا تجري إذا",125,"ذ",2,0],["الدَهرُ بِالرَزايا","غَدراً عَلى أَنَّني وَفِيُّ",126,"ي",1,0],["الدِينُ سَمْحٌ إِنْ سَلَكْتَ سَبيلَه","لِلْخَيْرِ لا للشَّرِّ والإِفْسَادِ",127,"د",1,0],["الدِّينُ والأَخلاقُ مِلءُ جَنانِه","وجَلالَةُ الأَمْلاكِ مِلءُ رِدَائه",128,"ا",3,0],["الدِّينُ طِبُّ النَّفْسِ مِنْ آلامِها","وهِدَايَةُ الْحَيْرَانِ في بَيْدَائه",128,"ا",3,0],["الدَّهْرُ يُسرِعُ وَالأَيَّامُ مُعْجِلَةٌ","وَنَحْنُ لَمْ نَدْرِ غَيْرَ الوَخْدِ والْخَببِ",129,"ب",1,0],["الدِينُ سَلْوَى النفْسِ في آلامِها","وطَبيبُها مِنْ أَدْمُع وَجِراحِ",130,"ح",1,0],["الدهرُ يَرْوِي فضلَه","والدهرُ راويةُ الرُّواة",131,"ه",1,0],["الدينُ والْخُلُقُ المَتِينُ أَساسُه","وحِياطَةُ المَوْلَى له أَسوَار",132,"ر",1,0],["الدِّينُ نُورُ النَّفْسِ في ظُلُماتِها","والعَقْلُ يَعْثُرُ والظُّنُونُ تَحَارُ",132,"ر",1,0],["الدِّين زاهٍ وَوَجْهُ المُلْكِ مُؤْتَلِقٌ","كالرَّوْضِ جادَ ثَراهُ صَوْرُ هَتَّانِ",133,"ن",1,0],["الدِّرْعُ تُصْبِحُ حينَ تَبْطِشُ كَفُّه","دِرْعاً ولاَ السَّيْفُ الْحُسَامُ حُسَاما",134,"م",2,0],["ألديك منجم عسَجْدٍ","أم بِئْرُ بترول سعودي",135,"د",2,0],["الدِّينُ أقوَمُ ما سُسْتَ الأمورَ به","والعلمُ أفضلُ ما أعدَدْتَ من عُدَدِ",136,"د",1,0],["الدهرُ أفسد شيئًا أنت تعرفُه","ما عاد ينفعهُ إصلاحُ عطار",137,"ر",1,0],["الدينُ مثلُ العرض، لا","نرضى له أن يُثلما",138,"م",2,0],["الدينُ ما ضمن الهدا","ية كان دينًا قيِّما",138,"م",2,0],["الدر في طيِّ البحور مخبأ","والتبرُ -إن تنشدْهُ- تَحْت رغام",139,"م",1,0],["الدْفءُ والضَّوءُ أين راحا؟","لِينكشفْ عنهما السِّتار",140,"ر",1,0],["الدهرُ يعرفها للكون عاصمةً","تقودُه، كيفما شاءتْ؛ فينقاد",141,"د",1,0],["ألدّهرُ يَضْحَكُ عَن بَشاشةِ بِشرِه،","وَالعَيشُ يَرْطَبُ من نَضَارَةِ عُودِه",142,"د",2,0],["الداميات مناسماً وغوارياً","المدميات جوانحاً ومآقيا",143,"ي",2,0],["الدين دين الهدى تبدوا شرائعه","بيضا تكشف عن أنوارها الظلم",144,"م",1,0],["الدهرُ بيَّن في كتابِ شهادة ٍ","بالنورِ فوق جبينهِ مكتوبِ",145,"ب",1,1]]}