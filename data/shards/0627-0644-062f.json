َّرارِي أَطَاعَتْهُ مِنَ الأَوَجِ",253,"ج",1,1],["ألدرَّةُ الوُسطى من العقدِ الثَّمي","ن بني التُّهامي شبلُه الهَيصورُ",254,"ر",1,0],["ألَدَّ بِنا الدهرُ الخؤُونُ شَماتَةً","وما الدهرُ إلاَّ صرفُ أهلِه لآسِوى",255,"و",2,0],["ألدَّهرُ وهوَ عَبدكُم","شزراً إلَىَّ قَدرنَا",256,"ن",2,0],["الدَّهرُ سالبُ ما أعطى ومانِعُهُ","فما الصّنيعُ بدينارٍ وقِنطارِ",257,"ر",1,0],["الدّارساتِ الفانيا","ت شبيهةً بالباقياتِ",258,"ت",1,0],["ألدَّهرُ أغرَبُ ما في الدَّهرِ من بِدَعٍ","يَبينُ فيهِ الصِّبَى في قَبضةِ الهَرَمِ",259,"م",1,0],["الدُّحْرُ والشُّبُوطُ والبَنَانُ","كَالطَّلْعِ مَجْنِيَّاً مِنَ الجِنَانِ",260,"ن",1,0],["الدَّهْرُ دَوْحٌ وأَنْتَ فِيهِ قَضِي","بُ البَانِ غُصْناً وَغَيْرُكَ الحَطَبُ",261,"ب",1,0],["الدَّمْعُ هَامٍ وَالحَشا هَائِمْ","وَالجفنُ دَام وَالجوىَ دَائمْ",262,"م",1,1]]}