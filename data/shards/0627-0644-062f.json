,3,"ب",1,1],["الدَمعُ يَشهَدُ أنّني لَكِ عاشِقٌ","وَالناسُ قَد عَلِموا وَإِن لَم يَشهدِ",4,"د",1,0],["الدَهرُ يَومانِ ذا أَمنٌ وَذا خَطَرُ","وَالعَيشُ عَيشانِ ذا صَفوٌ وذا كَدَرُ",5,"ر",1,1],["الدّهْرُ أضيقُ فُسحةً في أنْ يُرى","بالحُزْنِ والكَمَدِ المُضاعَفِ يُقطَعُ",6,"ع",1,1],["الدَهرُ عَبدِيَ لَمّا","أَصبَحتُ في الحُبِّ عَبدَك",7,"ك",1,0],["الدينُ وَجهٌ أَنتَ فيهِ غُرَّةٌ","وَالمُلكُ جَفنٌ أَنتَ فيهِ سَوادُ",8,"د",1,0],["الدَهرُ إِن أَملى فَصيحٌ أَعجَمُ","يُعطي اِعتِباري ما جَهِلتُ فَأَعلَمُ",9,"م",1,1],["ألدِّينُ وَالدُّنْيَا أَعَارَهُمْ سَنًى","لَمْ يُزْهَ فِي حَفْلٍ أَجَلَّ وَأَكْرَمِ",10,"م",1,0],["الدَّاخِلِيَّةُ دَوْحَةٌ هَرُمت","وَذَوَتْ نَضَارَتُهَا عَلَى الهَرَمِ",11,"م",1,0],["أَلدينُ لا يَأْبَى الْحَضَارَةَ إِنْ دَعَتْ","فَأَجَابَهَا فِي الرَّاشِدِينَ إِمَامُ",12,"م",1,0],["أَلدَّارُ عَامِرَةٌ كَالْعَهْدِ زَاهِرةٌ","وَالْقَوْمٌ عِنْدَ جَمِيلِ الظَّنِّ بِالْهِمَمِ",13,"م",1,0],["الدنى فإول الشباب","والروض يزهر بالزهر",14,"ر",1,0],["الداء أذهب نفسه تلفا","بذل الدواء له فما نجعا",15,"ع",2,0],["الدينُ مُختَرَمٌ وَالحَقُّ مُهتَضَمُ","وَفَيءُ آلِ رَسولِ اللَهِ مُقتَسَمُ",16,"م",1,1],["الدَهرُ يَومانِ ذا ثَبتٌ وَذا زَلَلُ","وَالعَيشُ طَعمانِ ذا صابٌ وَذا عَسَلُ",17,"ل",1,1],["الدارُ واسِطَةٌ وَالنَخلُ شارِعَةٌ","وَالبيضُ يَرفُلنَ في القَسِّيِّ كَالبَرَدِ",18,"د",1,0],["الدهر نحوي كما ينبغي","يدري الذي يخفض أو يرفع",19,"ع",1,0],["الدهْرُ يُفْسِدُ ما استطاع وأحمدٌ","يتَتَبَّعُ الإفسادَ بالإصلاحِ",20,"ح",1,0],["الدائم العهْدِ ولكنَّه","يصْعد من عهْد إلى عهْدِ",21,"د",1,0],["الدين والعلم والنعماء والشرفُ","تأبى لجارك أن يُمنى له التلفُ",22,"ف",1,1],["الدمع في العين لا نوم ولا نظرٌ","ولا محالة من معنىً له خُلِقا",23,"ق",2,1],["الدقاقُ الخصورِ في هَيَف القدْ","دِ عِراضُ الأعجازِ والأوراك",24,"ك",1,0],["الدَهرَ ماتَنفَكُّ تَندُبُ وُجنَةً","دَرَسَت وَخَدّا مُنهَجَ العِرفانِ",25,"ن",1,0],["الدَهرُ يُفنينا وَنَحسَبُ أَنَّهُ","يُفني بِنا أَيّامَهُ وَلَيالِيَه",26,"ي",2,0],["الدارُ مِن بَعدِكَ قَد أَصبَحَت","في وَحشَةٍ يا مُؤنِسَ الدارِ",27,"ر",1,0],["الديلُ أَذنابُ بَكرٍ حينَ تَنسِبُهُم","وَكُلُّ قَومٍ لَهُم مِن قَومِهِم ذَنَبُ",28,"ب",1,1],["الدهر يقضي ما يشاء قضاءه","من غير ما عدل ولا إجحاف",29,"ف",1,0],["الدهر جار على الآداب يزهقها","وما على الدهر إما جار من عتب",30,"ب",1,0],["الدهر يلقى الامر ممن فوقه","والدهر يقتل من يشاء ولا يدى",31,"د",2,0],["الدهر يعطى سروراً يمنعه","وذلكم منه لا بخل ولا جود",32,"د",1,0],["الدهر قد اوجعنا","بسيفه لما ضرب",33,"ب",1,0],["الدهر قد عاكسنا","وما على الدهر عتب",33,"ب",1,0],["الدين في كل عصر للحياة مضى","قد كان خير صراط للذي نهجا",34,"ج",2,0],["الدين سمح فما ان فيه من عقد","والدين ما كان يستهدى به السلف",34,"ف",1,0],["الدين اسوة من ضيموا ومن حزنوا","والدين سلوة من في عيشهم شظف",34,"ف",1,0],["الدهر فرق شمل جمع ناهض","والدهر يجمع تارة ويفرق",35,"ق",1,0],["الدهر قطب يوم شابت لمتي","وجهاً له قد كان غير مقطب",36,"ب",1,0],["الدين معقل اهله","والدين امنع معقل",37,"ل",1,0],["الدائرات وان حبت","مهلا على الباغي تدور",38,"ر",1,0],["الدين ليس بمحتاج إلى حجج","إذا تمكن من قلب بتلقين",39,"ن",1,1],["الدين والدنيا له","فضل من الله القدير",40,"ر",1,0],["الدُبُّ مَعروفٌ بِسوءِ الظَنِّ","فَاِسمَع حَديثَهُ العَجيبَ عَنّي",41,"ي",1,1],["الدينُ لِلدَيّانِ جَلَّ جَلالُهُ","لَو شاءَ رَبُّكَ وَحَّدَ الأَقواما",42,"م",2,0],["الدينُ وَالوَحيُ وَالأَخلاقُ طائِفَةٌ","مِنهُ وَسائِرُهُ دُنيا وَبُهتانُ",43,"ن",1,0],["الدُرُّ في لَبّاتِهِنَّ مُنَظَّمٌ","وَالطيبُ في حَبراتِهِنَّ مُرَقرَقُ",44,"ق",1,0],["الدَهرُ يَقظانُ وَالأَحداثُ لَم تَنَمِ","فَما رُقادُكُمُ يا أَشرَفَ الأُمَمِ",45,"م",1,1],["الدَهرُ فَرَّقَ شَملَهُنَّ فَمُر بِهِ","يا رَبِّ تَجمَعُهُ يَدُ المِقدارِ",46,"ر",1,0],["الدَهرُ مُعتَذِرٌ وَالسَيفُ مُنتَظِرٌ","وَأَرضُهُم لَكَ مُصطافٌ وَمُرتَبَعُ",47,"ع",1,0],["الدَهرُ يَعجَبُ مِن حَملي نَوائِبَهُ","وَصَبرِ جِسمي عَلى أَحداثِهِ الحُطُمِ",48,"م",1,0],["الدَهرُ أَنصَفُ مِنكَ في أَحكامِهِ","إِذ كانَ يَأخُذُ بَعضَ ما يُعطيكا",49,"ك",2,0],["الدواوين في يدينا طروحٌ","والتعابير كلها إنشاء",50,"ا",2,0],["الدّهرُ يعلَمُ أنني زاحمتُه","بأشدَّ منه في الشّدائد كاهلا",51,"ل",2,0],["الدَهرُ أَدَّبَني وَاليَأَسُ أَغناني","وَالقوتُ أَقنَعَني وَالصَبرُ رَبانّي",52,"ي",1,1],["الدَهرُ يَخنُقُ أَحياناً قِلادَتَهُ","عَلَيكَ لا تَضطَرِب فيهِ وَلا تَثِبِ",53,"ب",1,1],["الدارُ جَنَّةُ خُلدٍ إِن عَمِلتَ بِما","يُرضي الإِلَهَ وَإِن قَصَّرتَ فَالنارُ",54,"ر",1,0],["الدَهرُ يُبرِمُني طَوراً وَيَنقُضُني","فَما بَقائي عَلى الإِبرامِ وَالنَقضِ",55,"ض",1,0],["الدَهرُ يوعِدُ فُرقَةً وَزَوالا","وَخُطوبُهُ لَكَ تَضرِبُ الأَمثالا",56,"ل",2,1],["الدارُ لَو كُنتَ تَدري يا أَخا مَرَحٍ","دارٌ أَمامَكَ فيها قُرَّةُ العَينِ",57,"ن",1,0],["الدَهرُ ذو دُوَلٍ وَالمَوتُ ذو عِلَلٍ","وَالمَرءُ ذو أَمَلٍ وَالناسُ أَشباهُ",58,"ا",2,1],["الدُرُّ لِكَأسِها نِطاقٌ","وَالمِسكُ لِدَنِّها خِتامُ",59,"م",1,0],["الدُموعُ هاطِلَةٌ","وَالضُلوعُ تَلتَهِبُ",60,"ب",1,0],["الدهر دفاق فكي","فَ نعبّ من ماءٍ أسن",61,"ن",1,0],["الدَّهر يحمي ركنَه","والفنُّ في روح البناء",62,"ا",2,0],["الدمار الرهيب والعدم الشام","ل واللفح والضنى والأوار",63,"ر",1,0],["الدّمعُ يَنطقُ واللّسانُ صَموتُ","فانظرْ إلى الحركاتِ كيف تموتُ",64,"ت",1,1],["الدارُ ناطِقَةٌ وَلَيسَت تَنطِقُ","بِدُثورِها أَنَّ الجَديدَ سَيُخلِقُ",65,"ق",1,1],["الدَهرُ يَومٌ وَيَومُ","وَالعَيشُ عُذرٌ وَلَومُ",66,"م",1,1],["الدَهرُ يَسمَحُ بِالَّتي تَهَبُ الغِنى","لِمُؤَمَّلٍ مِن صادِرٍ أَو وارِدِ",67,"د",1,0],["الدينُ شينُ الدينِ قالَ نبينا","فتوقَّهُ واصبرْ على الإقتارِ",68,"ر",1,0],["الداخِلِ البَيتَ الشَديدَ حِجابُهُ","في غَيرِ ميعادٍ أَما يَخشى الرَدى",69,"ا",1,0],["الدّهرُ لا يُعطيك إلا كارهاً","فإذا أبيتَ فإِنَّ رأيك عازبُ",70,"ب",1,0],["الدَّمُ المسفوحُ في آثارهم","يملأ الدُّنيا أنيناً ونُواحا",71,"ح",2,0],["الدّينُ من دُنيا الهَوى وخَبالهِا","للنّفسِ حِرزٌ مانعٌ وعِصامُ",72,"م",1,0],["الدّينُ والدُّنيا وَراءَ ضجيجِه","يستشرفان أيسمعان حَسيسا",73,"س",2,0],["الدّهرُ شاغَبَهُ فأوهنَ عَظمَهُ","وطغَى عليهِ فَزادَ في أعبائِه",74,"ا",3,0],["الدَهرُ نَشوانُ ما ينفكُّ يَقْرَعُنا","بالحادثِ النُّكرِ قَرْعَ الكاس ِبالكاسِ",75,"س",1,0],["الدّهرُ أخرسُ والبلادُ صوامتٌ","والنّاسُ بين تفجُّعٍ وبُكاءِ",76,"ا",2,0],["الدّهرُ يومُ مَذلَّةٍ ومَهانَةٍ","والدَّهرُ يومُ حميَّةٍ وإباءِ",76,"ا",2,0],["الدّينُ و