","الرمل"],[305,"جزى الله خيرا سيدا وابن سيد","https://www.aldiwan.net/poem16831.html","الطويل"],[305,"يا قل لأحبابنا يا قل لجيران","https://www.aldiwan.net/poem16882.html","البسيط"],[354,"حلي العذار الغوالي","https://www.aldiwan.net/poem39985.html","المجتث"],[367,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[367,"كمثل يعقوب ضل يوسفه","https://www.aldiwan.net/poem17858.html","المنسرح"],[392,"شر المذاهب مذهب القبائل","https://www.aldiwan.net/poem54516.html","عموديه"],[404,"لعل زمانا بالوصال يجود","https://www.aldiwan.net/poem33976.html","الطويل"],[438,"لك ذروة المجد الذي لا يرتقى","https://www.aldiwan.net/poem2535.html","الكامل"],[459,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[462,"هنا رجب الشهور وما يليه","https://www.aldiwan.net/poem15668.html","الوافر"],[462,"يسر العلى والمجد والحلم والنهى","https://www.aldiwan.net/poem16219.html","الطويل"],[462,"أقول وقد ضاقت قوافي مدائحي","https://www.aldiwan.net/poem16433.html","الطويل"],[465,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[480,"صبرا لحكمك صبرا","https://www.aldiwan.net/poem37050.html","المجتث"],[480,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[515,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[528,"أيدري السيف أي فتى يبيد","https://www.aldiwan.net/poem45970.html","الوافر"],[530,"تعاضدتم بغيا لنشر المظالم","https://www.aldiwan.net/poem37211.html","الطويل"],[530,"يا قدس الله أسرارا لأخيار","https://www.aldiwan.net/poem37375.html","البسيط"],[535,"أزف لك التحية والسلاما","https://www.aldiwan.net/poem23815.html","الوافر"],[539,"عليك من الخل الوفي سلامه","https://www.aldiwan.net/poem47939.html","عموديه"],[539,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[552,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[552,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[559,"إن القناعة في الدنيا هي الشرف","https://www.aldiwan.net/poem34345.html","البسيط"],[559,"كم من حقير له سر تضمنه","https://www.aldiwan.net/poem34464.html","البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[574,"وخبرني الناعون ما صنع الردى","https://www.aldiwan.net/poem3657.html","الطويل"],[576,"من يشتري لي أشجان","https://www.aldiwan.net/poem2842.html","منهوك المنسرح"],[576,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[588,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[588,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["كَمِثلِ ما الذَهَبِ الإِبريزِ يَشرَكُهُ","في لَونِهِ الصُفرُ وَالتَفضيلُ لِلذَهَبِ",0,"ب",1,0],["كَمِثلِ اللَيثِ مُفتَرِشٍ يَدَيهِ","جَريءِ الصَدرِ رِئبالٍ سِبَطرِ",1,"ر",1,0],["كمثل الذي لا تصرف الفلس كفُّه","ولو كان دون الفلس يقلع ضِرسه",2,"س",2,0],["كمثل ما لامت بها في التقى","في الجودِ بعض النيَّة الراغمهْ",3,"م",2,0],["كم ثناءً والى لعلياه مدحاً","حسناً في الورَى وقدراً عليّا",4,"ي",2,0],["كم ثواب أَثَبْتَنيه عليها","كنتَ أولى به من المستثيبِ",5,"ب",1,0],["كمثل أبي العباس إنَّ نوالَهُ","نوال الحيا يسعى إلى كلِّ طالبِ",6,"ب",1,0],["كمثل أبي العباس إن كان مثلُهُ","وهل مثلُه دامت له الخيَراتُ",7,"ت",1,0],["كمثل النار في النُّور","ومثل المسك في النَّشر",8,"ر",1,0],["كمثل السحاب نأى شخصُهُ","ولم ينأ منه صبيبٌ هَمِع",9,"ع",1,0],["كمثل البحر يغرق فيه حيٌّ","ولا ينفك تطفو فيه جيفَهْ",10,"ف",2,0],["كمثل البحر يخشى في","ه هول المد والغرق",11,"ق",1,0],["كَم ثارَ مِنهُم في القُرون ثائِرٌ","بِالأَمويين وَبِالآل الرِضى",12,"ا",1,0],["كَم ثَراءٍ فَرَّجتَ بِالرُمحِ عَنهُ","كانَ مِن بُخلِ أَهلِهِ في وَثاقِ",13,"ق",1,0],["كَم ثَمَّ مِن وَصفٍ يَسُرُّكَ حاضِراً","وَمَعَ المَغيبِ فَلَيسَ بِالمَأمونِ",14,"ن",1,0],["كَمِثْلِ أَرْضِكِ تَمْتَدُّ السَّماءُ بها","مَهْمومَةً تَرْقُبُ الفَجْرَ الذي انْطَلَقا",15,"ق",2,0],["كَمِثلِ أَقاحي الرَملِ يَجلو مُتونَهُ","سُقوطُ نَداً مِن أَخِرِ اللَيلِ مُخضِلِ",16,"ل",1,0],["كمثلِ الوِرْدِ أوّلُه أُجاجٌ","وآخرُ مائهِ عَذْبٌ فُراتُ",17,"ت",1,0],["كَمِثل الغُصنِ إِن قامَ","مِنَ البابِ تُكَفِّيهِ",18,"ي",2,0],["كمثل شِهابِ النار في كَفِّ قابِسٍ","إِذا الريح هَبَّت وَهوَ كابٍ تَضَرَّما",19,"م",2,0],["كَمِثلِ دينارٍ جَديدِ النَقشِ","وَاِستَبدَلَ السَرجَ بِلينِ الفُرشِ",20,"ش",1,0],["كم ثار نوء وتدجَّى ظلامْ","وهذه أنتِ وهذا أنا",21,"ن",2,0],["كم ثار منهم في القرون ثائرٌ","بالأمويين وبالآل الرضا",22,"ا",1,0],["كمِثْلِ ملالِ الفَتَى للنَّعِيمِ","إِذا دام فيه وحال السُّرُورِ",23,"ر",1,0],["كمِثلِ ما يدخلُ في شَطرِ الهَزجْ","وهو يُسمَّى باسمِهِ بلا حَرجْ",24,"ج",1,0],["كَمْ ثَقَّفَتْ عَقْلاً أَفَا","دَ الْعَالَمِينَ بِمَا أَفَادَ",25,"د",1,0],["كَمِثلِ رِشاءِ الغَربِ مُرتَهِنُ الطَوى","وَطولِ السُرى فَالبَطنُ مِنهُ قَبيبُ",26,"ب",1,0],["كم ثملنا برَشْفةٍ منكَ يا شعْرُ","فصرْنا رُوحاً بلا أشباح",27,"ح",1,0],["كم ثلَّ الاستبدادُ عرشًا بعدما","أجرى حواليْه الدماءَ سيولا",28,"ل",2,0],["كم ثاكلٍ لم تَدْرِ أين ترى ابنِها","فتعيرَهُ من دمعها شؤبوبا",29,"ب",2,0],["كَمُثْمِرَةِ الأَغْصَانِ والصَّقْعُ طَيِّبُ","يُبشِّرْنَ فِي فَصْلٍ وَيَعْقِدْنَ فِي فَصْلِ",30,"ل",1,0],["كمثل والى الإمام سيدنا","ذِى الفضلِ والجودِ والتقى جُمعَهْ",31,"ع",2,0],["كمثل رجالات الفصوص فإنهم","رموه وهم عند الورى جنده الأقوى",32,"و",2,0],["كمثل بن نور الدين حياه ربه","ومثل الحرازي والرجال الأواخر",33,"ر",1,0],["كَمِثلِ اِبنِ مَسعودٍ وَهَيهاتَ مِثلُهُ","إِلى حَيثُ يَدعو الخَلقَ داعي حِسابِهِ",34,"ب",2,0],["كَم ثائِرٍ أَردى بِطَعنَةِ ثائِرٍ","وَالبيضُ تَطفو في العَجاجِ وَتَركُدُ",35,"د",1,0],["كم ثَوَى تحتَ قبةِ الفَلَك الأع","لى منَ الْخَلْق بين ترْب وماء",36,"ا",2,0],["كم ثعلب لا يفوته طلبٌ","اثقله عند عدوه ذنبه",37,"ب",2,0],["كَمِثلِ مَهاةِ ما تَحِنُّ قِلادَةً","وَلا مُعقِداً في ساقِها مُتَخَذَّما",38,"م",2,0],["كمثل بلقيس التي لم يَبِن","إهداؤها عند سليمانا",39,"ن",2,0],["كمثل يعقوب بعد يوسف إذ","حنَّ إلى شَمِّ بعض أثوابِهْ",40,"ب",2,0],["كمثل ما سمعت اذنى وما شهدت","عيني من السحر في شجراء غنّاء",41,"ا",2,0],["كَمِثْلِ ابْنِ حَسُّونِ الرِّضَى وَابْنِ عَاشِرِ","فَنَاهِيكَ مِنْ قَرْمٍ وَنَاهِيكَ مِنْ حَبْرِ",42,"ر",1,0],["كَمِثْلِ أَبِي الْيُمْنِ فِي الْعالَمِينَ","وَهَلْ مِثْلُ نائِلِهِ فِي السُّحُبْ",43,"ب",1,0],["كَمِثْلِ الْكِنانَةِ يَوْمَ النَّضا","لِ أَوْدَعَها نابِلٌ أَسْهُمَهْ",44,"م",2,0],["كَمِثْلِ زَعِيمِ الْجُيُوشِ الْمَلِيِّ","بِعَزْمٍ يَبيتُ لَهُ الْحَزْمُ رِدّا",45,"د",2,0],["كَم ثَمَّ لِلرُّوّادِ وَالوُرّادِ مِن","صُدَّى إِذا اِنتَجَعوا وَمِن سَعدانِ",46,"ن",1,0],["كَم ثَوى في لَحدِهِ مِن سُؤدَدٍ","وَصِفاتٍ كاثَرَت عَدَّ الرِمالِ",47,"ل",1,0],["كمثلكم يحيون سنة جدهم","على العلم والتقوى وحفظ المراتب",48,"ب",1,0],["كمثل حالتها من قبل مهبطها","بهيكل الجسم في حس وإخراس",49,"س",1,0],["كَمثل سُنّةِ طَه","بِها تزان المَعالي",50,"ل",2,0],["كَمِثلِ الوَقيعَةِ فيها الزُلالُ","يُسيغُ الوَقيعَةَ لي في الزُلالِ",51,"ل",1,0],["كَمِثلِ يَعقوبَ ضَلَّ يوسُفَهُ","فَاِعتاضَ عَنهُ بِشَمِّ أَثوابِه",52,"ه",1,1],["كمثل من قد قال شيخ عاقل","حلق الذقون في ذا الزمان حاصل",53,"ل",1,0],["كمثل صلاح الدين أحيا رياضها","فأورق من روض المعارف عود",54,"د",1,0],["كم ثلّ عرشا للعدى ولكم بنى","مجداً به ولكم أجد وأخلقا",55,"ق",2,0],["كمثلِ أبي الذوّادِ لا متعلِّلٍ","إذا سُئل الجدوَى ولا بمُنكِّدِ",56,"د",1,0],["كمِثلِ المءِ مَحْيا كُلِّ شيءٍ","وموْردهُ رَخيصٌ غيرُ غالِ",57,"ل",1,0],["كمثل السَّحاب الجون غيثٌ وصاعقٌ","وماءِ الفرات العذْبِ مُرْوٍ وقاتل",58,"ل",1,0],["كمِثْلِ الحُسامِ العَضبِ زيْنٌ فِرِندُهُ","وللمَوْتِ صَدْرٌ قاطِعٌ وذُبابُ",59,"ب",1,0],["كم ثمَّ نت بئرٍ معط","لةٍ ومن قصر مشيدّ",60,"د",1,0],["كمثل من قد بكينا","وسوف نبكيه دهرا",61,"ر",2,0],["كمثل الصخر لم يفهم","ولو أصبحت علاما",62,"م",2,0],["كم ثَنايا في ثناياها دُجىً","مَبعَثُ الفجرِ إلَينا من كواها",63,"ا",3,0],["كمثل الدرع إن خفّت أجنَّت","وإنَّ ثقلت فحاملها جهيدُ",64,"د",1,0],["كَمِثْلِ سِياسَاتٍ وتِلْكَ هي الّتي","غَدَتْ في زَمانِ الْجَوْرِ إحْدَى الْعَظائِمِ",65,"م",1,0],["كَمِثْلِ سُفْيانَ أوْ مِثْلِ الجُنَيْد أو ال","سَرِيِّ أو مثل ذي الفَضْلِ ابن دينارِ",66,"ر",1,0],["كمثل الفاطمي بأرض مصر","تأله فاستحل بها الحراما",67,"م",2,0],["كَمِثلكَ ياخِدنَ المَزايا شريفةٌ","ومثلُك قَرمٌ لا يُفَلُّ حُسامُهُ",68,"م",2,0],["كم ثَكالَى لن تَنَاما","ويتَامَى تَتَرَامَى",69,"م",2,0],["كم ثَمَّ من مُهجةٍ تقضِي بلا قَوَدٍ","ومن دمٍ طُلَّ من وجدٍ على طَلَلِ",70,"ل",1,0],["كمْ ثَمَّ من مُهَجٍ سَقي","نَ الحتفَ للقومِ السَّراةِ",71,"ه",1,0],["كمثل كسرى أنوشروان من ملكت","يمينه الفرس يرعاها فتنتصف",72,"ف",1,0],["كمثل موسى عصاه حين أرسلها","تلقفت كل ما جاءت به السحره",73,"ر",2,0],["كمثل ما أحب مخلصينا","له على الإذعان منا الدينا",74,"ن",2,0],["كمثل ما قد قيل بالسوية","لكل من كان نفى الوصية",74,"ه",1,0],["كمثل ما يكون كل نافلة","في الليل والنهار بالمشاكلة",74,"ه",1,0],["كمثل ما عوده من قبل","وآفة المرء الهوى والجهل",74,"ل",1,0],["كمثل ما منعهم فيما فشا","من أمره أن يقتلوه عطشا",74,"ش",2,0],["كَمِثلِ أَبي بَكرٍ وَمِثلِ سَليلِهِ","خَليلي أَبي إِسحاقٍ خَيرِ لِداتي",75,"ت",2,0],["كمثل ذاك الخفقان","ما كان ليت لا كانْ",76,"ن",1,0],["كم ثائرٍ صَار إَلى حِزْبه","فَأَدْرَكَ الثَّأْر مِنَ الثَّائِر",77,"ر",1,0],["كمثل سؤال والعطاس تثاؤب","بكاء وتأويله أنين المجود",78,"د",1,0],["كمثيل وإرجأنا ليال قليلة","لينتظر البرء الذي هو يطلب",79,"ب",1,0]]}