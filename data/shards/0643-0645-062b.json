e.com/ViewPoem.aspx?id=182261",""],[5956,"لأسقي طيوري","https://www.poetsgate.com/ViewPoem.aspx?id=183889",""],[5956,"دربُ العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=184173",""],[5956,"العواطف أساس الصالحات وأساس الفن الشريف","https://www.poetsgate.com/ViewPoem.aspx?id=192122",""],[5956,"رشادٌ مستديم","https://www.poetsgate.com/ViewPoem.aspx?id=192321",""],[5956,"الحنوُّ الغزير","https://www.poetsgate.com/ViewPoem.aspx?id=192936",""],[5956,"أرفرفُ كالطير في رمضانِ","https://www.poetsgate.com/ViewPoem.aspx?id=204409",""],[5956,"لا تستحقك لا أرضٌ ولا شهبُ","https://www.poetsgate.com/ViewPoem.aspx?id=208505",""],[5957,"كأن الحب ديدنهُ الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=208526",""],[6031,"يَا لَيتَ أرْوَاحَنَا الثَّلاثَ تَجمْ","https://www.poetsgate.com/ViewPoem.aspx?id=46344",""],[6048,"كمثل الرعد صوت الله في السحب","https://www.poetsgate.com/ViewPoem.aspx?id=201219",""],[6093,"مِيْراثُ الجَمِيعِ","https://www.poetsgate.com/ViewPoem.aspx?id=185309",""],[6093,"أتدري متى","https://www.poetsgate.com/ViewPoem.aspx?id=192264",""],[6093,"على قدر اهتمامك سوف تزهر","https://www.poetsgate.com/ViewPoem.aspx?id=213345",""],[6228,"فيض الوجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85976&r=&rc=13",""],[2220,"من كانَ وجهَ الحقِّ لا يهلكُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11614&r=&rc=488",""],[2220,"الحكمُ حكمُ الجبرِ والاضطرارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11469&r=&rc=343",""],[2220,"إنَّ الحروفَ التي في الرقمِ تشهدُها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11406&r=&rc=280",""],[5190,"انتفاضة الأقصى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78346&r=&rc=59",""]],"verses":[["كَمِثلِ ما الذَهَبِ الإِبريزِ يَشرَكُهُ","في لَونِهِ الصُفرُ وَالتَفضيلُ لِلذَهَبِ",0,"ب",1,0],["كَمِثلِ اللَيثِ مُفتَرِشٍ يَدَيهِ","جَريءِ الصَدرِ رِئبالٍ سِبَطرِ",1,"ر",1,0],["كمثل الذي لا تصرف الفلس كفُّه","ولو كان دون الفلس يقلع ضِرسه",2,"س",2,0],["كمثل ما لامت بها في التقى","في الجودِ بعض النيَّة الراغمهْ",3,"م",2,0],["كم ثناءً والى لعلياه مدحاً","حسناً في الورَى وقدراً عليّا",4,"ي",2,0],["كم ثواب أَثَبْتَنيه عليها","كنتَ أولى به من المستثيبِ",5,"ب",1,0],["كمثل أبي العباس إنَّ نوالَهُ","نوال الحيا يسعى إلى كلِّ طالبِ",6,"ب",1,0],["كمثل أبي العباس إن كان مثلُهُ","وهل مثلُه دامت له الخيَراتُ",7,"ت",1,0],["كمثل النار في النُّور","ومثل المسك في النَّشر",8,"ر",1,0],["كمثل السحاب نأى شخصُهُ","ولم ينأ منه صبيبٌ هَمِع",9,"ع",1,0],["كمثل البحر يغرق فيه حيٌّ","ولا ينفك تطفو فيه جيفَهْ",10,"ف",2,0],["كمثل البحر يخشى في","ه هول المد والغرق",11,"ق",1,0],["كَم ثارَ مِنهُم في القُرون ثائِرٌ","بِالأَمويين وَبِالآل الرِضى",12,"ا",1,0],["كَم ثَراءٍ فَرَّجتَ بِالرُمحِ عَنهُ","كانَ مِن بُخلِ أَهلِهِ في وَثاقِ",13,"ق",1,0],["كَم ثَمَّ مِن وَصفٍ يَسُرُّكَ حاضِراً","وَمَعَ المَغيبِ فَلَيسَ بِالمَأمونِ",14,"ن",1,0],["كَمِثْلِ أَرْضِكِ تَمْتَدُّ السَّماءُ بها","مَهْمومَةً تَرْقُبُ الفَجْرَ الذي انْطَلَقا",15,"ق",2,0],["كَمِثلِ أَقاحي الرَملِ يَجلو مُتونَهُ","سُقوطُ نَداً مِن أَخِرِ اللَيلِ مُخضِلِ",16,"ل",1,0],["كمثلِ الوِرْدِ أوّلُه أُجاجٌ","وآخرُ مائهِ عَذْبٌ فُراتُ",17,"ت",1,0],["كَمِثل الغُصنِ إِن قامَ","مِنَ البابِ تُكَفِّيهِ",18,"ي",2,0],["كمثل شِهابِ النار في كَفِّ قابِسٍ","إِذا الريح هَبَّت وَهوَ كابٍ تَضَرَّما",19,"م",2,0],["كَمِثلِ دينارٍ جَديدِ النَقشِ","وَاِستَبدَلَ السَرجَ بِلينِ الفُرشِ",20,"ش",1,0],["كم ثار نوء وتدجَّى ظلامْ","وهذه أنتِ وهذا أنا",21,"ن",2,0],["كم ثار منهم في القرون ثائرٌ","بالأمويين وبالآل الرضا",22,"ا",1,0],["كمِثْلِ ملالِ الفَتَى للنَّعِيمِ","إِذا دام فيه وحال السُّرُورِ",23,"ر",1,0],["كمِثلِ ما يدخلُ في شَطرِ الهَزجْ","وهو يُسمَّى باسمِهِ بلا حَرجْ",24,"ج",1,0],["كَمْ ثَقَّفَتْ عَقْلاً أَفَا","دَ الْعَالَمِينَ بِمَا أَفَادَ",25,"د",1,0],["كَمِثلِ رِشاءِ الغَربِ مُرتَهِنُ الطَوى","وَطولِ السُرى فَالبَطنُ مِنهُ قَبيبُ",26,"ب",1,0],["كم ثملنا برَشْفةٍ منكَ يا شعْرُ","فصرْنا رُوحاً بلا أشباح",27,"ح",1,0],["كم ثلَّ الاستبدادُ عرشًا بعدما","أجرى حواليْه الدماءَ سيولا",28,"ل",2,0],["كم ثاكلٍ لم تَدْرِ أين ترى ابنِها","فتعيرَهُ من دمعها شؤبوبا",29,"ب",2,0],["كَمُثْمِرَةِ الأَغْصَانِ والصَّقْعُ طَيِّبُ","يُبشِّرْنَ فِي فَصْلٍ وَيَعْقِدْنَ فِي فَصْلِ",30,"ل",1,0],["كمثل والى الإمام سيدنا","ذِى الفضلِ والجودِ والتقى جُمعَهْ",31,"ع",2,0],["كمثل رجالات الفصوص فإنهم","رموه وهم عند الورى جنده الأقوى",32,"و",2,0],["كمثل بن نور الدين حياه ربه","ومثل الحرازي والرجال الأواخر",33,"ر",1,0],["كَمِثلِ اِبنِ مَسعودٍ وَهَيهاتَ مِثلُهُ","إِلى حَيثُ يَدعو الخَلقَ داعي حِسابِهِ",34,"ب",2,0],["كَم ثائِرٍ أَردى بِطَعنَةِ ثائِرٍ","وَالبيضُ تَطفو في العَجاجِ وَتَركُدُ",35,"د",1,0],["كم ثَوَى تحتَ قبةِ الفَلَك الأع","لى منَ الْخَلْق بين ترْب وماء",36,"ا",2,0],["كم ثعلب لا يفوته طلبٌ","اثقله عند عدوه ذنبه",37,"ب",2,0],["كَمِثلِ مَهاةِ ما تَحِنُّ قِلادَةً","وَلا مُعقِداً في ساقِها مُتَخَذَّما",38,"م",2,0],["كمثل بلقيس التي لم يَبِن","إهداؤها عند سليمانا",39,"ن",2,0],["كمثل يعقوب بعد يوسف إذ","حنَّ إلى شَمِّ بعض أثوابِهْ",40,"ب",2,0],["كمثل ما سمعت اذنى وما شهدت","عيني من السحر في شجراء غنّاء",41,"ا",2,0],["كَمِثْلِ ابْنِ حَسُّونِ الرِّضَى وَابْنِ عَاشِرِ","فَنَاهِيكَ مِنْ قَرْمٍ وَنَاهِيكَ مِنْ حَبْرِ",42,"ر",1,0],["كَمِثْلِ أَبِي الْيُمْنِ فِي الْعالَمِينَ","وَهَلْ مِثْلُ نائِلِهِ فِي السُّحُبْ",43,"ب",1,0],["كَمِثْلِ الْكِنانَةِ يَوْمَ النَّضا","لِ أَوْدَعَها نابِلٌ أَسْهُمَهْ",44,"م",2,0],["كَمِثْلِ زَعِيمِ الْجُيُوشِ الْمَلِيِّ","بِعَزْمٍ يَبيتُ لَهُ الْحَزْمُ رِدّا",45,"د",2,0],["كَم ثَمَّ لِلرُّوّادِ وَالوُرّادِ مِن","صُدَّى إِذا اِنتَجَعوا وَمِن سَعدانِ",46,"ن",1,0],["كَم ثَوى في لَحدِهِ مِن سُؤدَدٍ","وَصِفاتٍ كاثَرَت عَدَّ الرِمالِ",47,"ل",1,0],["كمثلكم يحيون سنة جدهم","على العلم والتقوى وحفظ المراتب",48,"ب",1,0],["كمثل حالتها من قبل مهبطها","بهيكل الجسم في حس وإخراس",49,"س",1,0],["كَمثل سُنّةِ طَه","بِها تزان المَعالي",50,"ل",2,0],["كَمِثلِ الوَقيعَةِ فيها الزُلالُ","يُسيغُ الوَقيعَةَ لي في الزُلالِ",51,"ل",1,0],["كَمِثلِ يَعقوبَ ضَلَّ يوسُفَهُ","فَاِعتاضَ عَنهُ بِشَمِّ أَثوابِه",52,"ه",1,1],["كمثل من قد قال شيخ عاقل","حلق الذقون في ذا الزمان حاصل",53,"ل",1,0],["كمثل صلاح الدين أحيا رياضها","فأورق من روض المعارف عود",54,"د",1,0],["كم ثلّ عرشا للعدى ولكم بنى","مجداً به ولكم أجد وأخلقا",55,"ق",2,0],["كمثلِ أبي الذوّادِ لا متعلِّلٍ","إذا سُئل الجدوَى ولا بمُنكِّدِ",56,"د",1,0],["كمِثلِ المءِ مَحْيا كُلِّ شيءٍ","وموْردهُ رَخيصٌ غيرُ غالِ",57,"ل",1,0],["كمثل السَّحاب الجون غيثٌ وصاعقٌ","وماءِ الفرات العذْبِ مُرْوٍ وقاتل",58,"ل",1,0],["كمِثْلِ الحُسامِ العَضبِ زيْنٌ فِرِندُهُ","وللمَوْتِ صَدْرٌ قاطِعٌ وذُبابُ",59,"ب",1,0],["كم ثمَّ نت بئرٍ معط","لةٍ ومن قصر مشيدّ",60,"د",1,0],["كمثل من قد بكينا","وسوف نبكيه دهرا",61,"ر",2,0],["كمثل الصخر لم يفهم","ولو أصبحت علاما",62,"م",2,0],["كم ثَنايا في ثناياها دُجىً","مَبعَثُ الفجرِ إلَينا من كواها",63,"ا",3,0],["كمثل الدرع إن خفّت أجنَّت","وإنَّ ثقلت فحاملها جهيدُ",64,"د",1,0],["كَمِثْلِ سِياسَاتٍ وتِلْكَ هي الّتي","غَدَتْ في زَمانِ الْجَوْرِ إحْدَى الْعَظائِمِ",65,"م",1,0],["كَمِثْلِ سُفْيانَ أوْ مِثْلِ الجُنَيْد أو ال","سَرِيِّ أو مثل ذي الفَضْلِ ابن دينارِ",66,"ر",1,0],["كمثل الفاطمي بأرض مصر","تأله فاستحل بها الحراما",67,"م",2,0],["كَمِثلكَ ياخِدنَ المَزايا شريفةٌ","ومثلُك قَرمٌ لا يُفَلُّ حُسامُهُ",68,"م",2,0],["كم ثَكالَى لن تَنَاما","ويتَامَى تَتَرَامَى",69,"م",2,0],["كم ثَمَّ من مُهجةٍ تقضِي بلا قَوَدٍ","ومن دمٍ طُلَّ من وجدٍ على طَلَلِ",70,"ل",1,0],["كمْ ثَمَّ من مُهَجٍ سَقي","نَ الحتفَ للقومِ السَّراةِ",71,"ه",1,0],["كمثل كسرى أنوشروان من ملكت","يمينه الفرس يرعاها فتنتصف",72,"ف",1,0],["كمثل موسى عصاه حين أرسلها","تلقفت كل ما جاءت به السحره",73,"ر",2,0],["كمثل ما أحب مخلصينا","له على الإذعان منا الدينا",74,"ن",2,0],["كمثل ما قد قيل بالسوية","لكل من كان نفى الوصية",74,"ه",1,0],["كمثل ما يكون كل نافلة","في الليل والنهار بالمشاكلة",74,"ه",1,0],["كمثل ما عوده من قبل","وآفة المرء الهوى والجهل",74,"ل",1,0],["كمثل ما منعهم فيما فشا","من أمره أن يقتلوه عطشا",74,"ش",2,0],["كَمِثلِ أَبي بَكرٍ وَمِثلِ سَليلِهِ","خَليلي أَبي إِسحاقٍ خَيرِ لِداتي",75,"ت",2,0],["كمثل ذاك الخفقان","ما كان ليت لا كانْ",76,"ن",1,0],["كم ثائرٍ صَار إَلى حِزْبه","فَأَدْرَكَ الثَّأْر مِنَ الثَّائِر",77,"ر",1,0],["كمثل سؤال والعطاس تثاؤب","بكاء وتأويله أنين المجود",78,"د",1,0],["كمثيل وإرجأنا ليال قليلة","لينتظر البرء الذي هو يطلب",79,"ب",1,0],["كَم ثَمَّ مِن بِئرِ مُعَطَّلَةٍ ومِن","قَصرٍ يُطَحطَحُ بالخَرابِ مَشيد",80,"د",1,0],["كمثل الحيا يحيى النبات بصوبه","فتخر من تحت التراب حدائقه",81,"ق",2,0],["كَمِثلِ أَلحاظِ اليَعافيرِ إِذا","رَوَّعَها مِن قانِصٍ فَرطُ الحَذَرْ",82,"ر",1,0],["كمثل أنيابِ الأفاعي وأحدّ","ذوات طعمٍ نكدٍ كلِّ النكد",83,"د",1,0],["كم ثنايا وكم عيونٍ مراضِ","من أقاحٍ ونَرجسٍ في الرياض",84,"ض",1,1],["كَمثل ما قَد دَخل الملثّمون","مِن قَبل ذا وَهُم لَهُ مُيمّمُون",85,"ن",1,0],["كمثل سليمان الرضي بن محمد","أخي المجد ذوربِّ البريه ساتره",86,"ر",2,0],["كمثل السيِّدِ القاضي","حليفِ العَقْدِ والحَل",87,"ل",1,0],["كمثلِ كريم الأصلِ نجلِ ابنِ عامرٍ","وإن كانَ لم نعلمْ له في الورى شكلا",88,"ل",2,0],["كمثل أسياف بني","ياسِ بكل كافِر",89,"ر",1,0],["كمثل جود سالمٍ","لم يخلُ منه أحد",90,"د",1,0],["كمثلِ البدرِ إلّا أن","نها لم تَخش نُقصانا",91,"ن",2,0],["كَمثلِ المزنِ يرسلُ ما لديهِ","إِلى الأرضين من ماءٍ ونارِ",92,"ر",1,0],["كَمِثلِ اللَيلِ في صُبحٍ صَديعٍ","وَمِثلَ الصَدغِ في وَجهٍ صَبيحِ",93,"ح",1,0],["كمثل من قال وجوهٌ ناضرهْ","قال إلى ثواب ربى ناظرهْ",94,"ه",1,0],["كمثل الفتى المشهور أحمدَ فارسٍ","سراجٍ لأهل العصر نجمِ الغياهب",95,"ب",1,0],["كمثل تاج العلى فرد الندى واخ ال","عرفان من سادة الخلق قد سادوا",96,"د",3,0],["كمثل الامام الخبر شمس سمائهم","ومقدام أهل الكشف يالك من حبر",97,"ر",1,0],["كمثل الذي صغت المديح لاجله","ولست مبال بالعذول وبالشاني",98,"ن",2,0],["كَمثلما رَكبت الأَلحان","وَوضعت للحكمة العيدانُ",99,"ن",1,0],["كمثل من تسعده الفُصوص","وَفعله مُزيف مغموص",99,"ص",1,0],["كَمثل الحِمار وَالضرغام","فيما مَضى مِن سالف الأَيّام",100,"م",1,0],["كمثل أن مفيدة الامهال","وكافة نافية الأمثال",101,"ل",1,0],["كمثل أصحابي أزالوا خلفا","والهاء حينها بسكون يلفى",102,"ف",2,0],["كمثل ما جاء الورق والمخترق","مع العتق ففي الثلاث ما اتفق",102,"ق",1,0],["كمثل كل لا مثل دع فقد أتى","تركيبهُ كمفردين اثبتا",103,"ت",2,0],["كَمِثْلِ وَجْهِكَ حُسْناً","وَمِثْلِ ديني رِقَّهْ",104,"ه",1,0],["كمثل البدور لطاف الخصُورِ","حسان النُّحورِ ملاح الهَوادي",105,"د",2,0],["كمث