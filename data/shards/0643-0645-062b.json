{"poems":[[57,"أصبحت مطرحا في معشر جهلوا","https://www.aldiwan.net/poem24734.html","البسيط"],[10,"دعوتم عامرا فنبذتموه","https://www.aldiwan.net/poem21092.html","الوافر"],[88,"أرى الحسن في لبنان أينع غرسه","https://www.aldiwan.net/poem44445.html","الطويل"],[72,"إلى م العشق واللائمة","https://www.aldiwan.net/poem19678.html","السريع"],[72,"جاءت العاذلات شيئا فريا","https://www.aldiwan.net/poem20564.html","الخفيف"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"أكف الغواني بالخنا خضرات","https://www.aldiwan.net/poem9201.html","الطويل"],[51,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[51,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[51,"رأيت الدهر يرفع كل وغد","https://www.aldiwan.net/poem65461.html","الوافر"],[51,"لشنطف كعثب خلق","https://www.aldiwan.net/poem65727.html","مجزوء الوافر"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[43,"أتراها لكثرة العشاق","https://www.aldiwan.net/poem9745.html","الخفيف"],[45,"ما في معاشرة ابن أكثم ساعة","https://www.aldiwan.net/poem66831.html","البسيط"],[90,"شممت تربك لا زلفى ولا ملقا","https://www.aldiwan.net/poem60156.html","عموديه"],[31,"خليلي مرا بي على رسم منزل","https://www.aldiwan.net/poem41841.html","الطويل"],[105,"أمنك فزارة انبعث الغزاة","https://www.aldiwan.net/poem43992.html","الوافر"],[40,"إني زائر ظبيا","https://www.aldiwan.net/poem42304.html","الهزج"],[40,"أقول عشاء للطويل تعجبا","https://www.aldiwan.net/poem42335.html","الطويل"],[52,"قم صاحبي نغدو لجيش الوحش","https://www.aldiwan.net/poem26891.html","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202552","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30454","المتقارب"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54719","الكامل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8871","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[106,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"]],"verses":[["كَمِثلِ ما الذَهَبِ الإِبريزِ يَشرَكُهُ","في لَونِهِ الصُفرُ وَالتَفضيلُ لِلذَهَبِ",0,"ب",1,0],["كَمِثلِ اللَيثِ مُفتَرِشٍ يَدَيهِ","جَريءِ الصَدرِ رِئبالٍ سِبَطرِ",1,"ر",1,0],["كمثل الذي لا تصرف الفلس كفُّه","ولو كان دون الفلس يقلع ضِرسه",2,"س",2,0],["كمثل ما لامت بها في التقى","في الجودِ بعض النيَّة الراغمهْ",3,"م",2,0],["كم ثناءً والى لعلياه مدحاً","حسناً في الورَى وقدراً عليّا",4,"ي",2,0],["كم ثواب أَثَبْتَنيه عليها","كنتَ أولى به من المستثيبِ",5,"ب",1,0],["كمثل أبي العباس إنَّ نوالَهُ","نوال الحيا يسعى إلى كلِّ طالبِ",6,"ب",1,0],["كمثل أبي العباس إن كان مثلُهُ","وهل مثلُه دامت له الخيَراتُ",7,"ت",1,0],["كمثل النار في النُّور","ومثل المسك في النَّشر",8,"ر",1,0],["كمثل السحاب نأى شخصُهُ","ولم ينأ منه صبيبٌ هَمِع",9,"ع",1,0],["كمثل البحر يغرق فيه حيٌّ","ولا ينفك تطفو فيه جيفَهْ",10,"ف",2,0],["كمثل البحر يخشى في","ه هول المد والغرق",11,"ق",1,0],["كَم ثارَ مِنهُم في القُرون ثائِرٌ","بِالأَمويين وَبِالآل الرِضى",12,"ا",1,0],["كَم ثَراءٍ فَرَّجتَ بِالرُمحِ عَنهُ","كانَ مِن بُخلِ أَهلِهِ في وَثاقِ",13,"ق",1,0],["كَم ثَمَّ مِن وَصفٍ يَسُرُّكَ حاضِراً","وَمَعَ المَغيبِ فَلَيسَ بِالمَأمونِ",14,"ن",1,0],["كَمِثْلِ أَرْضِكِ تَمْتَدُّ السَّماءُ بها","مَهْمومَةً تَرْقُبُ الفَجْرَ الذي انْطَلَقا",15,"ق",2,0],["كَمِثلِ أَقاحي الرَملِ يَجلو مُتونَهُ","سُقوطُ نَداً مِن أَخِرِ اللَيلِ مُخضِلِ",16,"ل",1,0],["كمثلِ الوِرْدِ أوّلُه أُجاجٌ","وآخرُ مائهِ عَذْبٌ فُراتُ",17,"ت",1,0],["كَمِثل الغُصنِ إِن قامَ","مِنَ البابِ تُكَفِّيهِ",18,"ي",2,0],["كمثل شِهابِ النار في كَفِّ قابِسٍ","إِذا الريح هَبَّت وَهوَ كابٍ تَضَرَّما",19,"م",2,0],["كَمِثلِ دينارٍ جَديدِ النَقشِ","وَاِستَبدَلَ السَرجَ بِلينِ الفُرشِ",20,"ش",1,0],["كم ثار نوء وتدجَّى ظلامْ","وهذه أنتِ وهذا أنا",21,"ن",2,0],["كم ثار منهم في القرون ثائرٌ","بالأمويين وبالآل الرضا",22,"ا",1,0],["كمِثْلِ ملالِ الفَتَى للنَّعِيمِ","إِذا دام فيه وحال السُّرُورِ",23,"ر",1,0],["كمِثلِ ما يدخلُ في شَطرِ الهَزجْ","وهو يُسمَّى باسمِهِ بلا حَرجْ",24,"ج",1,0],["كَمْ ثَقَّفَتْ عَقْلاً أَفَا","دَ الْعَالَمِينَ بِمَا أَفَادَ",25,"د",1,0],["كَمِثلِ رِشاءِ الغَربِ مُرتَهِنُ الطَوى","وَطولِ السُرى فَالبَطنُ مِنهُ قَبيبُ",26,"ب",1,0],["كم ثملنا برَشْفةٍ منكَ يا شعْرُ","فصرْنا رُوحاً بلا أشباح",27,"ح",1,0],["كم ثلَّ الاستبدادُ عرشًا بعدما","أجرى حواليْه الدماءَ سيولا",28,"ل",2,0],["كم ثاكلٍ لم تَدْرِ أين ترى ابنِها","فتعيرَهُ من دمعها شؤبوبا",29,"ب",2,0],["كَمُثْمِرَةِ الأَغْصَانِ والصَّقْعُ طَيِّبُ","يُبشِّرْنَ فِي فَصْلٍ وَيَعْقِدْنَ فِي فَصْلِ",30,"ل",1,0]]}